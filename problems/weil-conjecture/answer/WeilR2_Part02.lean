            E i ⊓ E j ⊓ E l ≤ E i ⊓ E l)).op (z (i, l)) := hz
    have hw : ∀ k : Fin n, ∃ w : ∀ i : Fin r, Γ(M, D k ⊓ E i), ∀ i j : Fin r,
        M.presheaf.map (homOfLE (inf_le_inf inf_le_right inf_le_right :
          D k ⊓ E i ⊓ (D k ⊓ E j) ≤ E i ⊓ E j)).op (z (i, j)) =
        M.presheaf.map (homOfLE (inf_le_right : D k ⊓ E i ⊓ (D k ⊓ E j) ≤ D k ⊓ E j)).op (w j) -
        M.presheaf.map (homOfLE (inf_le_left : D k ⊓ E i ⊓ (D k ⊓ E j) ≤ D k ⊓ E i)).op (w i) := by
      intro k
      exact wc_qcoh_affine_cech_h1_vanish Y M hM (D k) (hDaff k) r (fun i => D k ⊓ E i)
        (fun i => inf_le_left)
        (fun y hy => by
          obtain ⟨i, hi⟩ := hEcov y
          exact ⟨i, TopologicalSpace.Opens.mem_inf.mpr ⟨hy, hi⟩⟩)
        (fun p => M.presheaf.map (homOfLE (inf_le_inf inf_le_right inf_le_right :
          D k ⊓ E p.1 ⊓ (D k ⊓ E p.2) ≤ E p.1 ⊓ E p.2)).op (z p))
        (fun i j l => by
          have h := congrArg (fun x => M.presheaf.map (homOfLE
            (inf_le_inf (inf_le_inf inf_le_right inf_le_right) inf_le_right :
              D k ⊓ E i ⊓ (D k ⊓ E j) ⊓ (D k ⊓ E l) ≤ E i ⊓ E j ⊓ E l)).op x) (hz' i j l)
          simp only [map_add, hcomp] at h ⊢
          exact h)
    choose w hw using hw
    obtain ⟨y, hy⟩ := wc_cech_compare_glue Y M n D r E hEcov z w hw
    exact ⟨⟨(z, w, y), And.intro hw hy⟩, rfl⟩

  have hB1 : ∀ t, β t ∈ Submodule.span B (Set.range c1) ⊔ LinearMap.range d0D := by
    rintro ⟨⟨z, w, y⟩, h1, h2⟩
    have hyc := wc_cech_compare_cocycle Y M n D r E hEcov w y h2
    obtain ⟨b, w0, hb⟩ := H1 y hyc
    have hy' : (∑ l, b l • c1 l + d0D w0) = y := by
      rw [hb]
      funext p
      rw [Pi.add_apply, Finset.sum_apply]
      rfl
    show y ∈ Submodule.span B (Set.range c1) ⊔ LinearMap.range d0D
    rw [← hy']
    exact Submodule.add_mem_sup ((Submodule.mem_span_range_iff_exists_fun B).mpr ⟨b, rfl⟩)
      (LinearMap.mem_range_self d0D w0)

  have hC1 : ∀ t, β t ∈ LinearMap.range d0D → α t ∈ LinearMap.range d0E := by
    rintro ⟨⟨z, w, y⟩, h1, h2⟩ hy
    obtain ⟨v, hv⟩ := LinearMap.mem_range.mp hy
    have hv' : d0D v = y := hv
    obtain ⟨e, he⟩ := wc_cech_compare_inj Y M n D hDcov r E z w y v h1 h2 (by rw [← hv']; rfl)
    refine LinearMap.mem_range.mpr ⟨e, ?_⟩
    show d0E e = z
    rw [he]
    rfl
  obtain ⟨m, es, hes⟩ := L T _ _ α β Z1 (LinearMap.range d0E) (LinearMap.range d0D) k1 c1
    hA1 hB1 hC1
  refine ⟨hE0, m, es, fun z hz => ?_⟩
  obtain ⟨γ, hγ⟩ := hes z hz
  obtain ⟨w, hw⟩ := LinearMap.mem_range.mp hγ
  refine ⟨γ, w, ?_⟩
  have hz' : z = ∑ s, γ s • es s + d0E w := by rw [hw]; abel
  rw [hz']
  funext p
  rw [Pi.add_apply, Finset.sum_apply]
  rfl

theorem wc_proper_projective_gamma_finite : ∀ (X Z : Scheme.{u}) [IsLocallyNoetherian X] (p : Z ⟶ X) (m : ℕ) (g : Z ⟶ wcPm.{u} m), IsClosedImmersion (Limits.prod.lift p g) → (∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (Y : Scheme.{u}) (hY : Y ⟶ Spec (.of A)) (g' : Y ⟶ wcPm.{u} m), IsClosedImmersion (Limits.prod.lift hY g') → wcCechH01FG A Y hY (wcStructMod Y) (m + 1) (fun k => g' ⁻¹ᵁ wcPmChart m k)) → ∀ U : X.Opens, IsAffineOpen U → ∃ (k : ℕ) (c : Fin k → Γ(Z, p ⁻¹ᵁ U)), ∀ s : Γ(Z, p ⁻¹ᵁ U), ∃ a : Fin k → Γ(X, U), s = ∑ l, p.app U (a l) * c l :=
by
  intro X Z _ p m g hL H U hU

  have hcl : IsClosedImmersion
      (Limits.prod.lift ((p ∣_ U) ≫ hU.isoSpec.hom) ((p ⁻¹ᵁ U).ι ≫ g)) := by
    have hbot : IsPullback (Limits.prod.map U.ι (𝟙 (wcPm.{u} m))) Limits.prod.fst
        Limits.prod.fst U.ι :=
      (IsPullback.of_prod_fst_with_id U.ι (wcPm.{u} m)).flip
    have hout : IsPullback (p ⁻¹ᵁ U).ι
        (Limits.prod.lift (p ∣_ U) ((p ⁻¹ᵁ U).ι ≫ g) ≫ Limits.prod.fst)
        (Limits.prod.lift p g ≫ Limits.prod.fst) U.ι := by
      rw [Limits.prod.lift_fst, Limits.prod.lift_fst]
      exact (isPullback_morphismRestrict p U).flip
    have hcomm : (p ⁻¹ᵁ U).ι ≫ Limits.prod.lift p g =
        Limits.prod.lift (p ∣_ U) ((p ⁻¹ᵁ U).ι ≫ g) ≫
          Limits.prod.map U.ι (𝟙 (wcPm.{u} m)) := by
      apply Limits.prod.hom_ext <;> simp [morphismRestrict_ι]
    have htop := IsPullback.of_bot hout hcomm hbot
    have hl : IsClosedImmersion (Limits.prod.lift (p ∣_ U) ((p ⁻¹ᵁ U).ι ≫ g)) :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) htop hL
    have e : Limits.prod.lift ((p ∣_ U) ≫ hU.isoSpec.hom) ((p ⁻¹ᵁ U).ι ≫ g) =
        Limits.prod.lift (p ∣_ U) ((p ⁻¹ᵁ U).ι ≫ g) ≫
          Limits.prod.map hU.isoSpec.hom (𝟙 (wcPm.{u} m)) := by
      simp
    rw [e]
    infer_instance

  have s2hom : U.topIso.inv ≫ (p ∣_ U).appTop ≫ (p ⁻¹ᵁ U).topIso.hom = p.app U := by
    have gen : ∀ (W : X.Opens) (e1 : W = U) (V : Z.Opens) (e2 : V = p ⁻¹ᵁ W)
        (e3 : p ⁻¹ᵁ U = V),
        X.presheaf.map (eqToHom e1).op ≫ (p.app W ≫ Z.presheaf.map (eqToHom e2).op) ≫
          Z.presheaf.map (eqToHom e3).op = p.app U := by
      intro W e1 V e2 e3
      subst e1
      subst e2
      simp
    rw [morphismRestrict_appTop]
    simp only [Scheme.Opens.topIso_hom, Scheme.Opens.topIso_inv]
    exact gen _ _ _ _ _
  have hcompat : ∀ b : Γ(X, U), (p ⁻¹ᵁ U).topIso.hom (((p ∣_ U) ≫ hU.isoSpec.hom).appTop
      ((Scheme.ΓSpecIso (CommRingCat.of Γ(X, U))).inv b)) = p.app U b := by
    intro b
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, IsAffineOpen.isoSpec_hom,
      Scheme.Opens.toSpecΓ_appTop, CommRingCat.comp_apply]
    have e1 : (Scheme.ΓSpecIso Γ(X, U)).hom
        ((Scheme.ΓSpecIso (CommRingCat.of Γ(X, U))).inv b) = b :=
      Iso.inv_hom_id_apply (Scheme.ΓSpecIso Γ(X, U)) b
    rw [e1, ← s2hom]
    rfl

  have s3 : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (Y : Scheme.{u})
      (hY : Y ⟶ Spec (.of A)) (n : ℕ) (V : Fin n → Y.Opens), (∀ y : Y, ∃ i, y ∈ V i) →
      wcCechH01FG A Y hY (wcStructMod Y) n V →
      ∃ (k : ℕ) (c : Fin k → Γ(Y, ⊤)), ∀ t : Γ(Y, ⊤), ∃ a : Fin k → A,
        t = ∑ l, hY.appTop ((Scheme.ΓSpecIso (.of A)).inv (a l)) * c l := by
    intro A _ _ Y hY n V hcov hC
    obtain ⟨k₀, c₀, H0⟩ := hC.1
    let σ : ∀ i : Fin n, A →+* Γ(Y, V i) := fun i =>
      (Y.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op).hom.comp
        (hY.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)
    let χ : A →+* (∀ i : Fin n, Γ(Y, V i)) := RingHom.pi σ
    let F : Γ(Y, ⊤) → (∀ i : Fin n, Γ(Y, V i)) := fun t i =>
      Y.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op t
    let c₀' : Fin k₀ → (∀ i : Fin n, Γ(Y, V i)) := fun l => c₀ l
    have hF : ∀ t, ∃ (b : Fin k₀ → A) (w : ∀ i : Fin n, Γ(Y, V i)),
        w ∈ (⊥ : AddSubgroup (∀ i : Fin n, Γ(Y, V i))) ∧ F t = ∑ l, χ (b l) * c₀' l + w := by
      intro t
      obtain ⟨b, hb⟩ := H0 (F t) (by
        intro i j
        change Y.presheaf.map (homOfLE (inf_le_right : V i ⊓ V j ≤ V j)).op
            (Y.presheaf.map (homOfLE (le_top : V j ≤ ⊤)).op t) =
          Y.presheaf.map (homOfLE (inf_le_left : V i ⊓ V j ≤ V i)).op
            (Y.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op t)
        rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, ← Functor.map_comp,
          ← Functor.map_comp]
        rfl)
      refine ⟨b, 0, AddSubgroup.zero_mem _, ?_⟩
      rw [add_zero]
      funext i
      have := congrFun hb i
      simp only [Finset.sum_apply, Pi.mul_apply]
      exact this
    have hclos : ∀ (b : A) (w : ∀ i : Fin n, Γ(Y, V i)),
        w ∈ (⊥ : AddSubgroup (∀ i : Fin n, Γ(Y, V i))) →
        χ b * w ∈ (⊥ : AddSubgroup (∀ i : Fin n, Γ(Y, V i))) := by
      intro b w hw
      rw [AddSubgroup.mem_bot] at hw ⊢
      rw [hw, mul_zero]
    obtain ⟨m', s, hs⟩ := wc_noeth_span_finite_subfamily A (∀ i : Fin n, Γ(Y, V i)) χ ⊥ hclos F
      k₀ c₀' hF
    refine ⟨m', s, fun t => ?_⟩
    obtain ⟨b, w, hw, ht⟩ := hs t
    rw [AddSubgroup.mem_bot] at hw
    rw [hw, add_zero] at ht
    refine ⟨b, ?_⟩
    have hcov' : (⊤ : Y.Opens) ≤ iSup V := by
      intro x _
      rw [TopologicalSpace.Opens.mem_iSup]
      exact hcov x
    apply TopCat.Sheaf.eq_of_locally_eq' Y.sheaf V ⊤ (fun i => homOfLE le_top) hcov'
    intro i
    have h1 := congrFun ht i
    simp only [F, Finset.sum_apply, Pi.mul_apply, RingHom.pi_apply, χ, σ,
      RingHom.comp_apply] at h1
    change Y.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op t =
      Y.presheaf.map (homOfLE (le_top : V i ≤ ⊤)).op _
    rw [map_sum]
    simp only [map_mul]
    exact h1

  haveI : IsNoetherianRing Γ(X, U) := IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
  have hC := H Γ(X, U) (p ⁻¹ᵁ U) ((p ∣_ U) ≫ hU.isoSpec.hom) ((p ⁻¹ᵁ U).ι ≫ g) hcl
  have hcov := (wc_pm_chart_cover Γ(X, U) (p ⁻¹ᵁ U) ((p ∣_ U) ≫ hU.isoSpec.hom) m
    ((p ⁻¹ᵁ U).ι ≫ g) hcl).2
  obtain ⟨k, c, hc⟩ := s3 Γ(X, U) (p ⁻¹ᵁ U) ((p ∣_ U) ≫ hU.isoSpec.hom) (m + 1) _ hcov hC
  refine ⟨k, fun l => (p ⁻¹ᵁ U).topIso.hom (c l), fun s => ?_⟩
  obtain ⟨a, ha⟩ := hc ((p ⁻¹ᵁ U).topIso.inv s)
  refine ⟨a, ?_⟩
  have e := congrArg (p ⁻¹ᵁ U).topIso.hom ha
  rw [Iso.inv_hom_id_apply, map_sum] at e
  simp only [map_mul, hcompat] at e
  exact e

theorem wc_proper_good_sheaf_exists : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (X : Scheme.{u}) (h : X ⟶ Spec (.of B)) [IsProper h] (r : ℕ) (V : Fin r → X.Opens), (∀ i, IsAffineOpen (V i)) → (∀ x : X, ∃ i, x ∈ V i) → (∀ i j, IsAffineOpen (V i ⊓ V j)) → ∀ T : TopologicalSpace.Closeds X, IsIrreducible (T : Set X) → ∃ G : X.Modules, wcCoherentMod G ∧ wcGenRankOne G T ∧ wcCechH01FG B X h G r V :=
by
  intro B _ _ X h _ r V hV hcov hV2 T hT

  have c4 : ∀ (Z : Scheme.{u}) (p : Z ⟶ X) (L : Z.Modules),
      wcCechH01FG B Z (p ≫ h) L r (fun i => p ⁻¹ᵁ V i) →
      wcCechH01FG B X h ((Scheme.Modules.pushforward p).obj L) r V := by
    intro Z p L hL
    obtain ⟨⟨k0, c0, H0⟩, ⟨k1, c1, H1⟩⟩ := hL
    have key : ∀ (W : X.Opens) (b : B),
        p.app W (((X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom.comp
          (h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) b) =
        ((Z.presheaf.map (homOfLE (le_top : p ⁻¹ᵁ W ≤ ⊤)).op).hom.comp
          ((p ≫ h).appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) b := by
      intro W b
      simp only [RingHom.comp_apply]
      rw [← CommRingCat.comp_apply, Scheme.Hom.naturality, CommRingCat.comp_apply,
        Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
      rfl
    refine ⟨⟨k0, c0, fun z hz => ?_⟩, ⟨k1, c1, fun z hz => ?_⟩⟩
    · obtain ⟨b, hb⟩ := H0 z hz
      refine ⟨b, hb.trans (funext fun i => Finset.sum_congr rfl fun l _ => ?_)⟩
      change _ = p.app (V i) _ • c0 l i
      rw [key]
    · obtain ⟨b, w, hb⟩ := H1 z hz
      refine ⟨b, w, hb.trans (funext fun q => ?_)⟩
      congr 1
      refine Finset.sum_congr rfl fun l _ => ?_
      have e := key (V q.1 ⊓ V q.2) (b l)
      exact congrArg (fun t : Γ(Z, p ⁻¹ᵁ V q.1 ⊓ p ⁻¹ᵁ V q.2) => t • c1 l q) e.symm

  have c6 : ∀ (Z : Scheme.{u}) (p : Z ⟶ X), Set.range p ⊆ (T : Set X) → ∀ U₀ : X.Opens,
      IsAffineOpen U₀ → ((U₀ : Set X) ∩ T).Nonempty → Function.Surjective (p.app U₀) →
      (∀ a : Γ(X, U₀), p.app U₀ a = 0 ↔ ∀ x ∈ U₀, x ∈ T → x ∉ X.basicOpen a) →
      wcGenRankOne ((Scheme.Modules.pushforward p).obj (wcStructMod Z)) T := by
    intro Z p hrange U₀ hU₀ hne hsurj hker
    refine ⟨fun U hU s => ?_, U₀, LinearMap.toSpanSingleton Γ(X, U₀) _
      (show Γ((Scheme.Modules.pushforward p).obj (wcStructMod Z), U₀) from (1 : Γ(Z, p ⁻¹ᵁ U₀))),
      hU₀, hne, ?_, ?_⟩
    · have hbot : p ⁻¹ᵁ U = ⊥ := by
        apply eq_bot_iff.mpr
        intro z hz
        exfalso
        exact Set.disjoint_left.mp hU (show p z ∈ (U : Set X) from hz) (hrange ⟨z, rfl⟩)
      have hs : ∀ t : Γ(Z, p ⁻¹ᵁ U), t = 0 := fun t =>
        @Subsingleton.elim _
          (CommRingCat.subsingleton_of_isTerminal (TopCat.Sheaf.isTerminalOfEqEmpty Z.sheaf hbot)) t 0
      exact hs s
    · intro t
      obtain ⟨a, ha⟩ := hsurj t
      refine ⟨a, ?_⟩
      change p.app U₀ a * 1 = t
      rw [mul_one, ha]
    · intro a
      rw [← hker]
      change p.app U₀ a * 1 = 0 ↔ _
      rw [mul_one]

  have c5 : ∀ (Z : Scheme.{u}) (p : Z ⟶ X) [QuasiCompact p] [QuasiSeparated p],
      (∀ U : X.Opens, IsAffineOpen U → ∃ (k : ℕ) (c : Fin k → Γ(Z, p ⁻¹ᵁ U)),
        ∀ s : Γ(Z, p ⁻¹ᵁ U), ∃ a : Fin k → Γ(X, U), s = ∑ l, p.app U (a l) * c l) →
      wcCoherentMod ((Scheme.Modules.pushforward p).obj (wcStructMod Z)) := by
    intro Z p _ _ hfin
    have hloc1 : ∀ (W : Z.Opens), IsCompact (W : Set Z) → IsQuasiSeparated (W : Set Z) →
        ∀ (g : Γ(Z, W)) (O : Z.Opens) (hO : O = Z.basicOpen g) (hle : O ≤ W) (s : Γ(Z, O)),
        ∃ (n : ℕ) (t : Γ(Z, W)), (Z.presheaf.map (homOfLE hle).op g) ^ n * s =
          Z.presheaf.map (homOfLE hle).op t := by
      intro W hc hq g O hO hle s
      subst hO
      haveI := isLocalization_basicOpen_of_qcqs hc hq g
      obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj g s
      refine ⟨n, a, ?_⟩
      rw [mul_comm]
      exact ha
    have hloc2 : ∀ (W : Z.Opens), IsCompact (W : Set Z) → IsQuasiSeparated (W : Set Z) →
        ∀ (g : Γ(Z, W)) (O : Z.Opens) (hO : O = Z.basicOpen g) (hle : O ≤ W) (t : Γ(Z, W)),
        Z.presheaf.map (homOfLE hle).op t = 0 → ∃ n : ℕ, g ^ n * t = 0 := by
      intro W hc hq g O hO hle t ht
      subst hO
      haveI := isLocalization_basicOpen_of_qcqs hc hq g
      obtain ⟨⟨m, hm⟩, hmt⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers g) _ t).mp ht
      obtain ⟨n, rfl⟩ := hm
      exact ⟨n, hmt⟩
    refine ⟨fun U hU f => ?_, fun U hU => ?_⟩
    · have hc : IsCompact ((p ⁻¹ᵁ U : Z.Opens) : Set Z) :=
        QuasiCompact.isCompact_preimage _ U.isOpen hU.isCompact
      have hq : IsQuasiSeparated ((p ⁻¹ᵁ U : Z.Opens) : Set Z) :=
        Scheme.Hom.isQuasiSeparated_preimage p hU.isQuasiSeparated
      have hO : p ⁻¹ᵁ X.basicOpen f = Z.basicOpen (p.app U f) := Scheme.preimage_basicOpen p f
      have hle : p ⁻¹ᵁ X.basicOpen f ≤ p ⁻¹ᵁ U := fun z hz => X.basicOpen_le f hz
      have hnat : p.app (X.basicOpen f) (X.presheaf.map (homOfLE (X.basicOpen_le f)).op f) =
          Z.presheaf.map (homOfLE hle).op (p.app U f) := by
        rw [← CommRingCat.comp_apply, Scheme.Hom.naturality]
        rfl
      refine ⟨fun s => ?_, fun t ht => ?_⟩
      · obtain ⟨n, t, ht⟩ := hloc1 _ hc hq (p.app U f) _ hO hle s
        refine ⟨n, t, ?_⟩
        have e : p.app (X.basicOpen f) ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op f) ^ n) *
            (show Γ(Z, p ⁻¹ᵁ X.basicOpen f) from s) = Z.presheaf.map (homOfLE hle).op t := by
          rw [map_pow, hnat]; exact ht
        exact e
      · obtain ⟨n, hn⟩ := hloc2 _ hc hq (p.app U f) _ hO hle t ht
        refine ⟨n, ?_⟩
        have e : p.app U (f ^ n) * (show Γ(Z, p ⁻¹ᵁ U) from t) = 0 := by
          rw [map_pow]; exact hn
        exact e
    · classical
      obtain ⟨k, c, hc⟩ := hfin U hU
      let c' : Fin k → Γ((Scheme.Modules.pushforward p).obj (wcStructMod Z), U) := fun l => c l
      refine ⟨⟨Finset.univ.image c', ?_⟩⟩
      rw [eq_top_iff]
      intro s _
      obtain ⟨a, ha⟩ := hc s
      have hs : s = ∑ l, a l • c' l := ha
      rw [hs]
      refine Submodule.sum_mem _ fun l _ => Submodule.smul_mem _ _ (Submodule.subset_span ?_)
      exact Finset.mem_coe.mpr (Finset.mem_image_of_mem c' (Finset.mem_univ l))
  haveI : IsLocallyNoetherian (Spec (.of B)) :=
    (isLocallyNoetherian_Spec (R := CommRingCat.of B)).mpr ‹IsNoetherianRing B›
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian h
  obtain ⟨Z, p, m, g, hp, hrange, hι, hι', U₀, hU₀, hne, hsurj, hker⟩ :=
    wc_chow_projective_model B X h T hT
  haveI := hp
  have hc8 := wc_pm_chart_cover B Z (p ≫ h) m g hι
  refine ⟨(Scheme.Modules.pushforward p).obj (wcStructMod Z), ?_, ?_, ?_⟩
  · exact c5 Z p
      (wc_proper_projective_gamma_finite X Z p m g hι'
        (fun A _ _ Y hY g' hg' => wc_serre_pm_cech_fg A Y hY m g' hg'))
  · exact c6 Z p hrange U₀ hU₀ hne hsurj hker
  · exact c4 Z p (wcStructMod Z)
      (wc_cech_fg_change_cover B Z (p ≫ h) (wcStructMod Z) (wc_struct_mod_coh Z).1 (m + 1)
        (fun k => g ⁻¹ᵁ wcPmChart m k) hc8.1 hc8.2 r (fun i => p ⁻¹ᵁ V i)
        (fun z => hcov (p z)) (wc_serre_pm_cech_fg B Z (p ≫ h) m g hι))

theorem wc_cech_h1_struct_unfold : ∀ (B : Type u) [CommRing B] (X : Scheme.{u}) (h : X ⟶ Spec (.of B)) (r : ℕ) (V : Fin r → X.Opens), wcCechH01FG B X h (wcStructMod X) r V → ∃ (k : ℕ) (c : Fin k → ∀ p : Fin r × Fin r, Γ(X, V p.1 ⊓ V p.2)), ∀ z : (∀ p : Fin r × Fin r, Γ(X, V p.1 ⊓ V p.2)), (∀ i j l : Fin r, X.presheaf.map (homOfLE (inf_le_left : V i ⊓ V j ⊓ V l ≤ V i ⊓ V j)).op (z (i, j)) + X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right : V i ⊓ V j ⊓ V l ≤ V j ⊓ V l)).op (z (j, l)) = X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right : V i ⊓ V j ⊓ V l ≤ V i ⊓ V l)).op (z (i, l))) → ∃ (b : Fin k → B) (w : ∀ i : Fin r, Γ(X, V i)), z = ∑ l, RingHom.pi (fun p : Fin r × Fin r => (X.presheaf.map (homOfLE (le_top : V p.1 ⊓ V p.2 ≤ ⊤)).op).hom.comp (h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) (b l) * c l + (fun p : Fin r × Fin r => X.presheaf.map (homOfLE (inf_le_right : V p.1 ⊓ V p.2 ≤ V p.2)).op (w p.2) - X.presheaf.map (homOfLE (inf_le_left : V p.1 ⊓ V p.2 ≤ V p.1)).op (w p.1)) :=
by
  intro B _ X h r V hP
  obtain ⟨k, c, H⟩ := hP.2
  refine ⟨k, c, fun z hz => ?_⟩
  obtain ⟨b, w, hw⟩ := H z hz
  refine ⟨b, w, ?_⟩
  funext p
  have hp := congrFun hw p
  simp only [Finset.sum_apply, Pi.add_apply, Pi.mul_apply, RingHom.pi_apply]
  exact hp

theorem wc_proper_cech_h1_fg : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (X : Scheme.{u}) (h : X ⟶ Spec (.of B)) [IsProper h] (r : ℕ) (V : Fin r → X.Opens), (∀ i, IsAffineOpen (V i)) → (∀ x : X, ∃ i, x ∈ V i) → (∀ i j, IsAffineOpen (V i ⊓ V j)) → ∃ (k : ℕ) (c : Fin k → ∀ p : Fin r × Fin r, Γ(X, V p.1 ⊓ V p.2)), ∀ z : (∀ p : Fin r × Fin r, Γ(X, V p.1 ⊓ V p.2)), (∀ i j l : Fin r, X.presheaf.map (homOfLE (inf_le_left : V i ⊓ V j ⊓ V l ≤ V i ⊓ V j)).op (z (i, j)) + X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right : V i ⊓ V j ⊓ V l ≤ V j ⊓ V l)).op (z (j, l)) = X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right : V i ⊓ V j ⊓ V l ≤ V i ⊓ V l)).op (z (i, l))) → ∃ (b : Fin k → B) (w : ∀ i : Fin r, Γ(X, V i)), z = ∑ l, RingHom.pi (fun p : Fin r × Fin r => (X.presheaf.map (homOfLE (le_top : V p.1 ⊓ V p.2 ≤ ⊤)).op).hom.comp (h.appTop.hom.comp (Scheme.ΓSpecIso (.of B)).inv.hom)) (b l) * c l + (fun p : Fin r × Fin r => X.presheaf.map (homOfLE (inf_le_right : V p.1 ⊓ V p.2 ≤ V p.2)).op (w p.2) - X.presheaf.map (homOfLE (inf_le_left : V p.1 ⊓ V p.2 ≤ V p.1)).op (w p.1)) :=
by
  intro B _ _ X h _ r V hV hcov hV2
  haveI : IsLocallyNoetherian (Spec (.of B)) :=
    (isLocallyNoetherian_Spec (R := CommRingCat.of B)).mpr ‹IsNoetherianRing B›
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian h
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace h
  haveI : AlgebraicGeometry.IsNoetherian X := AlgebraicGeometry.IsNoetherian.mk
  have hzero : ∀ M : X.Modules, Limits.IsZero M → wcCechH01FG B X h M r V := by
    intro M hM
    have hs : ∀ (U : X.Opens) (s : Γ(M, U)), s = 0 := by
      intro U s
      have h1 : (𝟙 M : M ⟶ M) = 0 := hM.eq_of_src _ _
      have h2 : Scheme.Modules.Hom.app (𝟙 M) U s = Scheme.Modules.Hom.app (0 : M ⟶ M) U s := by
        rw [h1]
      simpa using h2
    refine ⟨⟨0, fun l => l.elim0, fun z _ => ⟨fun l => l.elim0, ?_⟩⟩,
      ⟨0, fun l => l.elim0, fun z _ => ⟨fun l => l.elim0, 0, ?_⟩⟩⟩
    · funext i
      exact (hs _ _).trans (hs _ _).symm
    · funext p
      exact (hs _ _).trans (hs _ _).symm
  have hA : ∀ S : ShortComplex X.Modules, S.ShortExact → wcCoherentMod S.X₁ →
      wcCoherentMod S.X₂ → wcCoherentMod S.X₃ → wcCechH01FG B X h S.X₁ r V →
      wcCechH01FG B X h S.X₃ r V → wcCechH01FG B X h S.X₂ r V := by
    intro S hS h1 _ _
    obtain ⟨hinj, hex⟩ := wc_modules_ses_left_exact X S hS
    exact (wc_cech_h01_two_of_three B X h r V S hinj hex
      (fun i => wc_modules_ses_affine_surj X S hS h1.1 (V i) (hV i))).1
  have hB : ∀ S : ShortComplex X.Modules, S.ShortExact → wcCoherentMod S.X₁ →
      wcCoherentMod S.X₂ → wcCoherentMod S.X₃ → wcCechH01FG B X h S.X₂ r V →
      wcCechH01FG B X h S.X₃ r V → wcCechH01FG B X h S.X₁ r V := by
    intro S hS h1 _ _
    obtain ⟨hinj, hex⟩ := wc_modules_ses_left_exact X S hS
    exact (wc_cech_h01_two_of_three B X h r V S hinj hex
      (fun i => wc_modules_ses_affine_surj X S hS h1.1 (V i) (hV i))).2
  have hP := wc_coherent_devissage X (fun M => wcCechH01FG B X h M r V) hzero hA hB
    (fun T hT => wc_proper_good_sheaf_exists B X h r V hV hcov hV2 T hT)
    (wcStructMod X) (wc_struct_mod_coh X)
  exact wc_cech_h1_struct_unfold B X h r V hP

theorem wc_rees_chart_model : ∀ (A : Type u) [CommRing A] (I : Ideal A) (R : Scheme.{u}) (g : R ⟶ Spec (.of A)) [IsProper g], ∃ (X : Scheme.{u}) (h : X ⟶ Spec (.of (reesAlgebra I))) (pr : X ⟶ R), IsProper h ∧ IsAffineHom pr ∧ ∀ W : R.Opens, IsAffineOpen W → ∃ θ : Γ(X, pr ⁻¹ᵁ W) →+* Polynomial Γ(R, W), Function.Injective θ ∧ (∀ s : Γ(R, W), θ (pr.app W s) = Polynomial.C s) ∧ (∀ b : reesAlgebra I, θ (((X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ W ≤ ⊤)).op).hom.comp (h.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom)) b) = Polynomial.map ((R.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (b : Polynomial A)) ∧ ∀ z : Γ(X, pr ⁻¹ᵁ W), z ∈ Subring.closure (Set.range (pr.app W).hom ∪ Set.range ((X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ W ≤ ⊤)).op).hom.comp (h.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom))) :=
by

  have s1 : ∀ (A C : Type u) [CommRing A] [CommRing C] [Algebra A C] (R : Scheme.{u}) (g : R ⟶ Spec (.of A)) (W : R.Opens), IsAffineOpen W → IsPushout (CommRingCat.ofHom ((R.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom))) (CommRingCat.ofHom (algebraMap A C)) ((Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap A C)))).app W) (CommRingCat.ofHom (((Limits.pullback g (Spec.map (CommRingCat.ofHom (algebraMap A C)))).presheaf.map (homOfLE (le_top : (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap A C)))) ⁻¹ᵁ W ≤ ⊤)).op).hom.comp ((Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap A C)))).appTop.hom.comp (Scheme.ΓSpecIso (.of C)).inv.hom))) := by
    intro A C _ _ _ R g W hW
    set α' := Spec.map (CommRingCat.ofHom (algebraMap A C)) with hα'
    set P := Limits.pullback g α'
    set fst := Limits.pullback.fst g α'
    set snd := Limits.pullback.snd g α'
    have : IsAffine W := hW
    have Sq : IsPullback (fst ∣_ W) ((fst ⁻¹ᵁ W).ι ≫ snd) (W.ι ≫ g) α' :=
      IsPullback.paste_vert (isPullback_morphismRestrict fst W) (IsPullback.of_hasPullback g α')
    have Po := isPushout_appTop_of_isPullback Sq
    refine IsPushout.of_iso Po (Scheme.ΓSpecIso (.of A)) W.topIso (Scheme.ΓSpecIso (.of C))
      (fst ⁻¹ᵁ W).topIso ?_ ?_ ?_ ?_
    · have e : CommRingCat.ofHom ((R.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) = (Scheme.ΓSpecIso (.of A)).inv ≫ g.appTop ≫ R.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op := rfl
      rw [e, Iso.hom_inv_id_assoc, Scheme.Hom.comp_appTop, Category.assoc]
      congr 1
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
      exact (R.presheaf.map_comp _ _).symm
    · exact Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (algebraMap A C))
    · rw [morphismRestrict_appTop, Scheme.Opens.topIso_hom, Scheme.Opens.topIso_hom]
      show (fst.app (W.ι ''ᵁ ⊤) ≫ P.presheaf.map (homOfLE (by rw [Scheme.Opens.ι_image_top, Scheme.Opens.ι_image_top]) : (fst ⁻¹ᵁ W).ι ''ᵁ ⊤ ⟶ fst ⁻¹ᵁ (W.ι ''ᵁ ⊤)).op) ≫ P.presheaf.map (homOfLE (by rw [Scheme.Opens.ι_image_top]) : fst ⁻¹ᵁ W ⟶ (fst ⁻¹ᵁ W).ι ''ᵁ ⊤).op = R.presheaf.map (homOfLE (by rw [Scheme.Opens.ι_image_top]) : W ⟶ W.ι ''ᵁ ⊤).op ≫ fst.app W
      rw [Category.assoc, ← Functor.map_comp, Scheme.Hom.naturality]
      rfl
    · have e : CommRingCat.ofHom ((P.presheaf.map (homOfLE (le_top : fst ⁻¹ᵁ W ≤ ⊤)).op).hom.comp (snd.appTop.hom.comp (Scheme.ΓSpecIso (.of C)).inv.hom)) = (Scheme.ΓSpecIso (.of C)).inv ≫ snd.appTop ≫ P.presheaf.map (homOfLE (le_top : fst ⁻¹ᵁ W ≤ ⊤)).op := rfl
      rw [e, Iso.hom_inv_id_assoc, Scheme.Hom.comp_appTop, Category.assoc]
      congr 1
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
      exact (P.presheaf.map_comp _ _).symm

  have s2 : ∀ (A S C : Type u) [CommRing A] [CommRing S] [CommRing C] [Algebra A S] [Algebra A C] (P : CommRingCat.{u}) (inl : CommRingCat.of S ⟶ P) (inr : CommRingCat.of C ⟶ P), IsPushout (CommRingCat.ofHom (algebraMap A S)) (CommRingCat.ofHom (algebraMap A C)) inl inr → ∃ e : TensorProduct A S C ≃+* P, (∀ s : S, e (s ⊗ₜ[A] (1 : C)) = inl s) ∧ (∀ c : C, e ((1 : S) ⊗ₜ[A] c) = inr c) := by
    intro A S C _ _ _ _ _ P inl inr hP
    have H₀ := CommRingCat.isPushout_tensorProduct A S C
    refine ⟨(IsPushout.isoIsPushout _ _ H₀ hP).commRingCatIsoToRingEquiv, fun s => ?_, fun c => ?_⟩
    · exact Eq.trans rfl (ConcreteCategory.congr_hom (IsPushout.inl_isoIsPushout_hom _ _ H₀ hP) s)
    · exact Eq.trans rfl (ConcreteCategory.congr_hom (IsPushout.inr_isoIsPushout_hom _ _ H₀ hP) c)

  have s3 : ∀ (Y Z : Scheme.{u}) (f : Z ⟶ Y) [QuasiCompact f] (W' : Y.Opens), IsAffineOpen W' → ∀ (O : Z.Opens) (hO : O ≤ f.toImage ⁻¹ᵁ (f.imageι ⁻¹ᵁ W')) (hOf : O = f ⁻¹ᵁ W'), Function.Injective (f.toImage.appLE (f.imageι ⁻¹ᵁ W') O hO) ∧ (∀ x : Γ(f.image, f.imageι ⁻¹ᵁ W'), ∃ y : Γ(Y, W'), f.imageι.app W' y = x) ∧ (∀ y : Γ(Y, W'), f.toImage.appLE (f.imageι ⁻¹ᵁ W') O hO (f.imageι.app W' y) = f.appLE W' O hOf.le y) := by
    intro Y Z f _ W' hW' O hO hOf
    refine ⟨?_, fun x => Scheme.Hom.app_surjective f.imageι W' hW' x, fun y => ?_⟩
    · have hO' : O = f.toImage ⁻¹ᵁ (f.imageι ⁻¹ᵁ W') := by
        rw [hOf, ← Scheme.Hom.comp_preimage, Scheme.Hom.toImage_imageι]
      subst hO'
      rw [Scheme.Hom.appLE_eq_app]
      exact Scheme.Hom.toImage_app_injective f ⟨W', hW'⟩
    · have key : ∀ (k : Z ⟶ Y) (e : O ≤ k ⁻¹ᵁ W'), k = f → k.appLE W' O e y = f.appLE W' O hOf.le y := by
        rintro k e rfl; rfl
      have e := Scheme.Hom.comp_appLE f.toImage f.imageι W' O hO
      rw [← CommRingCat.comp_apply, ← e]
      exact key _ _ (Scheme.Hom.toImage_imageι f)

  have s4 : ∀ (A : Type u) [CommRing A] (I : Ideal A) (S TY TX TZ : Type u) [CommRing S] [Algebra A S] [CommRing TY] [CommRing TX] [CommRing TZ] (eY : TensorProduct A S (reesAlgebra I) ≃+* TY) (eZ : TensorProduct A S (Polynomial A) ≃+* TZ) (ι : TY →+* TX) (τ : TX →+* TZ) (ρ : S →+* TX) (χ : reesAlgebra I →+* TX), Function.Surjective ι → Function.Injective τ → (∀ s : S, ρ s = ι (eY (s ⊗ₜ[A] (1 : reesAlgebra I)))) → (∀ b : reesAlgebra I, χ b = ι (eY ((1 : S) ⊗ₜ[A] b))) → (∀ s : S, τ (ρ s) = eZ (s ⊗ₜ[A] (1 : Polynomial A))) → (∀ b : reesAlgebra I, τ (χ b) = eZ ((1 : S) ⊗ₜ[A] (b : Polynomial A))) → ∃ θ : TX →+* Polynomial S, Function.Injective θ ∧ (∀ s : S, θ (ρ s) = Polynomial.C s) ∧ (∀ b : reesAlgebra I, θ (χ b) = Polynomial.map (algebraMap A S) (b : Polynomial A)) ∧ ∀ x : TX, x ∈ Subring.closure (Set.range ρ ∪ Set.range χ) := by
    intro A _ I S TY TX TZ _ _ _ _ _ eY eZ ι τ ρ χ hι hτ hρ hχ hτρ hτχ
    let PE : TensorProduct A S (Polynomial A) ≃+* Polynomial S := (polyEquivTensor A S).symm.toRingEquiv
    have hPE : ∀ t, PE t = (polyEquivTensor A S).symm t := fun _ => rfl
    refine ⟨PE.toRingHom.comp (eZ.symm.toRingHom.comp τ), ?_, ?_, ?_, ?_⟩
    · exact PE.injective.comp (eZ.symm.injective.comp hτ)
    · intro s
      change PE (eZ.symm (τ (ρ s))) = _
      rw [hτρ, RingEquiv.symm_apply_apply, hPE, polyEquivTensor_symm_apply_tmul, ← Polynomial.C_1,
        Polynomial.sum_C_index]
      · simp
      · simp
    · intro b
      change PE (eZ.symm (τ (χ b))) = _
      rw [hτχ, RingEquiv.symm_apply_apply, hPE, polyEquivTensor_symm_apply_tmul]
      generalize (b : Polynomial A) = p
      induction p using Polynomial.induction_on' with
      | add p q hp hq =>
        rw [Polynomial.sum_add_index, hp, hq, Polynomial.map_add]
        · intro i; simp
        · intro i a₁ a₂; simp [map_add, mul_add]
      | monomial n a =>
        rw [Polynomial.sum_monomial_index]
        · simp [Polynomial.map_monomial]
        · simp
    · intro x
      obtain ⟨y, rfl⟩ := hι x
      obtain ⟨t, rfl⟩ := eY.surjective y
      induction t using TensorProduct.induction_on with
      | zero => rw [map_zero, map_zero]; exact Subring.zero_mem _
      | tmul s b =>
        have e : s ⊗ₜ[A] b = (s ⊗ₜ[A] (1 : reesAlgebra I)) * ((1 : S) ⊗ₜ[A] b) := by
          rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rw [e, map_mul, map_mul, ← hρ, ← hχ]
        exact Subring.mul_mem _ (Subring.subset_closure (Or.inl ⟨s, rfl⟩))
          (Subring.subset_closure (Or.inr ⟨b, rfl⟩))
      | add a b ha hb => rw [map_add, map_add]; exact Subring.add_mem _ ha hb

  have s5 : ∀ (Z Y R S S' : Scheme.{u}) (f : Z ⟶ Y) (p : Y ⟶ R) (p' : Z ⟶ R) (q : Y ⟶ S) (q' : Z ⟶ S') (β : S' ⟶ S), f ≫ p = p' → f ≫ q = q' ≫ β → ∀ (W : R.Opens) (hW : p' ⁻¹ᵁ W ≤ f ⁻¹ᵁ (p ⁻¹ᵁ W)), (∀ s : Γ(R, W), f.appLE (p ⁻¹ᵁ W) (p' ⁻¹ᵁ W) hW (p.app W s) = p'.app W s) ∧ (∀ v : Γ(S, ⊤), f.appLE (p ⁻¹ᵁ W) (p' ⁻¹ᵁ W) hW (Y.presheaf.map (homOfLE (le_top : p ⁻¹ᵁ W ≤ ⊤)).op (q.appTop v)) = Z.presheaf.map (homOfLE (le_top : p' ⁻¹ᵁ W ≤ ⊤)).op (q'.appTop (β.appTop v))) := by
    intro Z Y R S S' f p p' q q' β hp hq W hW
    subst hp
    refine ⟨fun s => ?_, fun v => ?_⟩
    · have e := Scheme.Hom.comp_appLE f p W ((f ≫ p) ⁻¹ᵁ W) hW
      rw [← CommRingCat.comp_apply, ← e, Scheme.Hom.appLE_eq_app]
    · have e1 : f.appLE (p ⁻¹ᵁ W) ((f ≫ p) ⁻¹ᵁ W) hW (Y.presheaf.map (homOfLE (le_top : p ⁻¹ᵁ W ≤ ⊤)).op (q.appTop v)) = Z.presheaf.map (homOfLE (le_top : (f ≫ p) ⁻¹ᵁ W ≤ ⊤)).op (f.appTop (q.appTop v)) := by
        rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
        rfl
      rw [e1]
      have e2 : f.appTop (q.appTop v) = (f ≫ q).appTop v := rfl
      rw [e2, hq]
      rfl

  have s6 : ∀ (X Y T : Scheme.{u}) (ι : X ⟶ Y) (q : Y ⟶ T) (V : Y.Opens) (v : Γ(T, ⊤)), X.presheaf.map (homOfLE (le_top : ι ⁻¹ᵁ V ≤ ⊤)).op ((ι ≫ q).appTop v) = ι.app V (Y.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (q.appTop v)) := by
    intro X Y T ι q V v
    have h := Scheme.Hom.naturality ι (homOfLE (le_top : V ≤ ⊤)).op
    have h2 := congrArg (fun φ => (CommRingCat.Hom.hom φ) (q.appTop v)) h
    exact h2.symm

  intro A _ I R g _
  let α := Spec.map (CommRingCat.ofHom (algebraMap A (reesAlgebra I)))
  let β := Spec.map (CommRingCat.ofHom (reesAlgebra I).val.toRingHom)
  let γ := Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))
  have hγ : γ = β ≫ α := by
    simp only [γ, β, α, ← Spec.map_comp]; rfl
  let f : Limits.pullback g γ ⟶ Limits.pullback g α :=
    Limits.pullback.lift (Limits.pullback.fst g γ) (Limits.pullback.snd g γ ≫ β)
      (by rw [Category.assoc, ← hγ]; exact Limits.pullback.condition)
  have F1 : f ≫ Limits.pullback.fst g α = Limits.pullback.fst g γ := Limits.pullback.lift_fst _ _ _
  have F2 : f ≫ Limits.pullback.snd g α = Limits.pullback.snd g γ ≫ β :=
    Limits.pullback.lift_snd _ _ _
  haveI hAY : IsAffineHom (Limits.pullback.fst g α) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback g α).flip
      inferInstance
  haveI hAZ : IsAffineHom (Limits.pullback.fst g γ) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback g γ).flip
      inferInstance
  haveI : QuasiCompact (f ≫ Limits.pullback.fst g α) := by rw [F1]; infer_instance
  haveI : QuasiCompact f := QuasiCompact.of_comp f (Limits.pullback.fst g α)
  refine ⟨f.image, f.imageι ≫ Limits.pullback.snd g α, f.imageι ≫ Limits.pullback.fst g α,
    inferInstance, inferInstance, ?_⟩
  intro W hW
  letI : Algebra A Γ(R, W) := ((R.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom.comp
    (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)).toAlgebra
  obtain ⟨eY, heY1, heY2⟩ := s2 A Γ(R, W) (reesAlgebra I) _ _ _ (s1 A (reesAlgebra I) R g W hW)
  obtain ⟨eZ, heZ1, heZ2⟩ := s2 A Γ(R, W) (Polynomial A) _ _ _ (s1 A (Polynomial A) R g W hW)
  have hOf : Limits.pullback.fst g γ ⁻¹ᵁ W = f ⁻¹ᵁ (Limits.pullback.fst g α ⁻¹ᵁ W) := by
    rw [← F1]; rfl
  have hO : Limits.pullback.fst g γ ⁻¹ᵁ W ≤
      f.toImage ⁻¹ᵁ (f.imageι ⁻¹ᵁ (Limits.pullback.fst g α ⁻¹ᵁ W)) := by
    have key : ∀ k : Limits.pullback g γ ⟶ Limits.pullback g α, k = f →
        f ⁻¹ᵁ (Limits.pullback.fst g α ⁻¹ᵁ W) ≤ k ⁻¹ᵁ (Limits.pullback.fst g α ⁻¹ᵁ W) := by
      rintro k rfl; exact le_rfl
    exact hOf.le.trans (key (f.toImage ≫ f.imageι) (Scheme.Hom.toImage_imageι f))
  obtain ⟨hinj, hsurj, hcomp⟩ := s3 _ _ f (Limits.pullback.fst g α ⁻¹ᵁ W)
    (hW.preimage (Limits.pullback.fst g α)) _ hO hOf
  obtain ⟨hs5a, hs5b⟩ := s5 _ _ _ _ _ f (Limits.pullback.fst g α) (Limits.pullback.fst g γ)
    (Limits.pullback.snd g α) (Limits.pullback.snd g γ) β F1 F2 W hOf.le
  have hβ : ∀ b : reesAlgebra I, β.appTop ((Scheme.ΓSpecIso (.of (reesAlgebra I))).inv b) =
      (Scheme.ΓSpecIso (.of (Polynomial A))).inv (b : Polynomial A) := by
    intro b
    have := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (reesAlgebra I).val.toRingHom)
    exact (ConcreteCategory.congr_hom this b).symm
  have hρ : ∀ s : Γ(R, W), ((f.imageι ≫ Limits.pullback.fst g α).app W).hom s =
      (f.imageι.app (Limits.pullback.fst g α ⁻¹ᵁ W)).hom (eY (s ⊗ₜ[A] (1 : reesAlgebra I))) := by
    intro s
    rw [heY1]; rfl
  have hχ : ∀ b : reesAlgebra I, ((f.image.presheaf.map (homOfLE (le_top : (f.imageι ≫ Limits.pullback.fst g α) ⁻¹ᵁ W ≤ ⊤)).op).hom.comp (((f.imageι ≫ Limits.pullback.snd g α)).appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom)) b =
      (f.imageι.app (Limits.pullback.fst g α ⁻¹ᵁ W)).hom (eY ((1 : Γ(R, W)) ⊗ₜ[A] b)) := by
    intro b
    rw [heY2]
    exact s6 _ _ _ f.imageι (Limits.pullback.snd g α) (Limits.pullback.fst g α ⁻¹ᵁ W) _
  refine s4 A I Γ(R, W) _ _ _ eY eZ (f.imageι.app (Limits.pullback.fst g α ⁻¹ᵁ W)).hom
    (f.toImage.appLE _ _ hO).hom _ _ hsurj hinj hρ hχ ?_ ?_
  · intro s
    calc _ = (f.toImage.appLE _ _ hO).hom ((f.imageι.app (Limits.pullback.fst g α ⁻¹ᵁ W)).hom
          (eY (s ⊗ₜ[A] (1 : reesAlgebra I)))) := congrArg _ (hρ s)
      _ = _ := by rw [heY1, hcomp, hs5a, heZ1]
  · intro b
    calc _ = (f.toImage.appLE _ _ hO).hom ((f.imageι.app (Limits.pullback.fst g α ⁻¹ᵁ W)).hom
          (eY ((1 : Γ(R, W)) ⊗ₜ[A] b))) := congrArg _ (hχ b)
      _ = (f.appLE _ _ hOf.le).hom (((Limits.pullback g α).presheaf.map (homOfLE (le_top : Limits.pullback.fst g α ⁻¹ᵁ W ≤ ⊤)).op).hom ((Limits.pullback.snd g α).appTop.hom ((Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom b))) := by
          rw [heY2, hcomp]; rfl
      _ = ((Limits.pullback g γ).presheaf.map (homOfLE (le_top : Limits.pullback.fst g γ ⁻¹ᵁ W ≤ ⊤)).op).hom ((Limits.pullback.snd g γ).appTop.hom (β.appTop.hom ((Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom b))) := hs5b _
      _ = _ := by rw [hβ, heZ2]; rfl

theorem wc_rees_scheme_model : ∀ (A : Type u) [CommRing A] (I : Ideal A) (R : Scheme.{u}) (g : R ⟶ Spec (.of A)) [IsProper g] (r : ℕ) (U : Fin r → R.Opens), (∀ i, IsAffineOpen (U i)) → (∀ x : R, ∃ i, x ∈ U i) → (∀ i j, IsAffineOpen (U i ⊓ U j)) → ∃ (X : Scheme.{u}) (h : X ⟶ Spec (.of (reesAlgebra I))) (V : Fin r → X.Opens) (θ₁ : ∀ i, Γ(X, V i) →+* Polynomial Γ(R, U i)) (θ₂ : ∀ i j, Γ(X, V i ⊓ V j) →+* Polynomial Γ(R, U i ⊓ U j)) (θ₃ : ∀ i j l, Γ(X, V i ⊓ V j ⊓ V l) →+* Polynomial Γ(R, U i ⊓ U j ⊓ U l)), IsProper h ∧ (∀ i, IsAffineOpen (V i)) ∧ (∀ x : X, ∃ i, x ∈ V i) ∧ (∀ i j, IsAffineOpen (V i ⊓ V j)) ∧ (∀ i j l, Function.Injective (θ₃ i j l)) ∧ (∀ i (z : Γ(X, V i)) (n : ℕ), (θ₁ i z).coeff n ∈ Ideal.map ((R.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (I ^ n)) ∧ (∀ i j (f : Polynomial Γ(R, U i ⊓ U j)), (∀ n, f.coeff n ∈ Ideal.map ((R.presheaf.map (homOfLE (le_top : U i ⊓ U j ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (I ^ n)) → ∃ z, θ₂ i j z = f) ∧ (∀ i j (z : Γ(X, V i)), θ₂ i j (X.presheaf.map (homOfLE (inf_le_left : V i ⊓ V j ≤ V i)).op z) = Polynomial.map (R.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op).hom (θ₁ i z)) ∧ (∀ i j (z : Γ(X, V j)), θ₂ i j (X.presheaf.map (homOfLE (inf_le_right : V i ⊓ V j ≤ V j)).op z) = Polynomial.map (R.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op).hom (θ₁ j z)) ∧ (∀ i j l (z : Γ(X, V i ⊓ V j)), θ₃ i j l (X.presheaf.map (homOfLE (inf_le_left : V i ⊓ V j ⊓ V l ≤ V i ⊓ V j)).op z) = Polynomial.map (R.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ⊓ U l ≤ U i ⊓ U j)).op).hom (θ₂ i j z)) ∧ (∀ i j l (z : Γ(X, V j ⊓ V l)), θ₃ i j l (X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right : V i ⊓ V j ⊓ V l ≤ V j ⊓ V l)).op z) = Polynomial.map (R.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right : U i ⊓ U j ⊓ U l ≤ U j ⊓ U l)).op).hom (θ₂ j l z)) ∧ (∀ i j l (z : Γ(X, V i ⊓ V l)), θ₃ i j l (X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right : V i ⊓ V j ⊓ V l ≤ V i ⊓ V l)).op z) = Polynomial.map (R.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right : U i ⊓ U j ⊓ U l ≤ U i ⊓ U l)).op).hom (θ₂ i l z)) ∧ (∀ i j (b : reesAlgebra I), θ₂ i j (((X.presheaf.map (homOfLE (le_top : V i ⊓ V j ≤ ⊤)).op).hom.comp (h.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom)) b) = Polynomial.map ((R.presheaf.map (homOfLE (le_top : U i ⊓ U j ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (b : Polynomial A)) :=
by
  have s2 : ∀ (A S T : Type u) [CommRing A] [CommRing S] [CommRing T] (I : Ideal A) (φ : A →+* S) (θ : T →+* Polynomial S) (ρ : S →+* T) (χ : reesAlgebra I →+* T), (∀ t : T, t ∈ Subring.closure (Set.range ρ ∪ Set.range χ)) → (∀ s, θ (ρ s) = Polynomial.C s) → (∀ b : reesAlgebra I, θ (χ b) = Polynomial.map φ (b : Polynomial A)) → (∀ (t : T) (n : ℕ), (θ t).coeff n ∈ Ideal.map φ (I ^ n)) ∧ (∀ P : Polynomial S, (∀ n, P.coeff n ∈ Ideal.map φ (I ^ n)) → ∃ t, θ t = P) := by
    intro A S T _ _ _ I φ θ ρ χ hgen hC hB
    let Rees : Subring (Polynomial S) :=
      { carrier := {P | ∀ n, P.coeff n ∈ Ideal.map φ (I ^ n)}
        zero_mem' := fun n => by simp
        one_mem' := fun n => by
          rw [Polynomial.coeff_one]
          split_ifs with h
          · subst h; simp only [pow_zero, Ideal.one_eq_top, Ideal.map_top]; exact Submodule.mem_top
          · exact Ideal.zero_mem _
        add_mem' := fun {P Q} hP hQ n => by
          rw [Polynomial.coeff_add]; exact Ideal.add_mem _ (hP n) (hQ n)
        neg_mem' := fun {P} hP n => by
          rw [Polynomial.coeff_neg]; exact neg_mem (hP n)
        mul_mem' := fun {P Q} hP hQ n => by
          rw [Polynomial.coeff_mul]
          refine Ideal.sum_mem _ (fun x hx => ?_)
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
          have := Ideal.mul_mem_mul (hP x.1) (hQ x.2)
          rw [← Ideal.map_mul, ← pow_add, hx] at this
          exact this }
    have hmem : ∀ t : T, θ t ∈ Rees := by
      intro t
      have hle : Subring.closure (Set.range ρ ∪ Set.range χ) ≤ Rees.comap θ := by
        rw [Subring.closure_le]
        rintro _ (⟨s, rfl⟩ | ⟨b, rfl⟩)
        · intro n
          change (θ (ρ s)).coeff n ∈ _
          rw [hC, Polynomial.coeff_C]
          split_ifs with h
          · subst h; simp only [pow_zero, Ideal.one_eq_top, Ideal.map_top]; exact Submodule.mem_top
          · exact Ideal.zero_mem _
        · intro n
          change (θ (χ b)).coeff n ∈ _
          rw [hB, Polynomial.coeff_map]
          exact Ideal.mem_map_of_mem _ ((mem_reesAlgebra_iff I _).mp b.2 n)
      exact hle (hgen t)
    refine ⟨fun t n => hmem t n, ?_⟩
    intro P hP
    have hmono : ∀ n (c : S), c ∈ Ideal.map φ (I ^ n) → Polynomial.monomial n c ∈ θ.range := by
      intro n
      let J : Ideal S :=
        { carrier := {c | Polynomial.monomial n c ∈ θ.range}
          zero_mem' := by simp only [Set.mem_setOf_eq, map_zero]; exact Subring.zero_mem _
          add_mem' := fun {a b} ha hb => by
            simp only [Set.mem_setOf_eq, map_add] at *; exact Subring.add_mem _ ha hb
          smul_mem' := fun s {c} hc => by
            simp only [Set.mem_setOf_eq, smul_eq_mul] at *
            rw [← Polynomial.C_mul_monomial]
            refine Subring.mul_mem _ ?_ hc
            exact ⟨ρ s, hC s⟩ }
      have hle : Ideal.map φ (I ^ n) ≤ J := by
        rw [Ideal.map_le_iff_le_comap]
        intro a ha
        change Polynomial.monomial n (φ a) ∈ θ.range
        refine ⟨χ ⟨Polynomial.monomial n a, reesAlgebra.monomial_mem.mpr ha⟩, ?_⟩
        rw [hB]
        exact Polynomial.map_monomial φ
      intro c hc
      exact hle hc
    have hPr : P ∈ θ.range := by
      rw [Polynomial.as_sum_support P]
      exact Subring.sum_mem _ (fun n _ => hmono n _ (hP n))
    obtain ⟨t, ht⟩ := hPr
    exact ⟨t, ht⟩
  have s3 : ∀ (A : Type u) [CommRing A] (I : Ideal A) (R : Scheme.{u}) (g : R ⟶ Spec (.of A)) (X : Scheme.{u}) (h : X ⟶ Spec (.of (reesAlgebra I))) (pr : X ⟶ R) (W W' : R.Opens) (hle : W' ≤ W) (hle' : pr ⁻¹ᵁ W' ≤ pr ⁻¹ᵁ W) (θ : Γ(X, pr ⁻¹ᵁ W) →+* Polynomial Γ(R, W)) (θ' : Γ(X, pr ⁻¹ᵁ W') →+* Polynomial Γ(R, W')), (∀ z : Γ(X, pr ⁻¹ᵁ W), z ∈ Subring.closure (Set.range (pr.app W).hom ∪ Set.range ((X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ W ≤ ⊤)).op).hom.comp (h.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom)))) → (∀ s : Γ(R, W), θ (pr.app W s) = Polynomial.C s) → (∀ b : reesAlgebra I, θ (((X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ W ≤ ⊤)).op).hom.comp (h.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom)) b) = Polynomial.map ((R.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (b : Polynomial A)) → (∀ s : Γ(R, W'), θ' (pr.app W' s) = Polynomial.C s) → (∀ b : reesAlgebra I, θ' (((X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ W' ≤ ⊤)).op).hom.comp (h.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom)) b) = Polynomial.map ((R.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (b : Polynomial A)) → ∀ z : Γ(X, pr ⁻¹ᵁ W), θ' (X.presheaf.map (homOfLE hle').op z) = Polynomial.map (R.presheaf.map (homOfLE hle).op).hom (θ z) := by
    intro A _ I R g X h pr W W' hle hle' θ θ' hgen hC hB hC' hB' z
    let F₁ : Γ(X, pr ⁻¹ᵁ W) →+* Polynomial Γ(R, W') := θ'.comp (X.presheaf.map (homOfLE hle').op).hom
    let F₂ : Γ(X, pr ⁻¹ᵁ W) →+* Polynomial Γ(R, W') :=
      (Polynomial.mapRingHom (R.presheaf.map (homOfLE hle).op).hom).comp θ
    have hle2 : Subring.closure (Set.range (pr.app W).hom ∪ Set.range ((X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ W ≤ ⊤)).op).hom.comp (h.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom))) ≤ F₁.eqLocus F₂ := by
      rw [Subring.closure_le]
      rintro _ (⟨s, rfl⟩ | ⟨b, rfl⟩)
      · change θ' (X.presheaf.map (homOfLE hle').op (pr.app W s)) =
          Polynomial.map (R.presheaf.map (homOfLE hle).op).hom (θ (pr.app W s))
        have hnat : X.presheaf.map (homOfLE hle').op (pr.app W s) =
            pr.app W' (R.presheaf.map (homOfLE hle).op s) := by
          rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, Scheme.Hom.naturality]
          rfl
        rw [hnat, hC', hC, Polynomial.map_C]
      · change θ' (X.presheaf.map (homOfLE hle').op ((X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ W ≤ ⊤)).op) ((h.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom) b))) =
          Polynomial.map (R.presheaf.map (homOfLE hle).op).hom (θ (((X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ W ≤ ⊤)).op).hom.comp (h.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom)) b))
        have e1 : X.presheaf.map (homOfLE hle').op ((X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ W ≤ ⊤)).op) ((h.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom) b)) =
            ((X.presheaf.map (homOfLE (le_top : pr ⁻¹ᵁ W' ≤ ⊤)).op).hom.comp (h.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom)) b := by
          rw [← CommRingCat.comp_apply, ← Functor.map_comp]
          rfl
        rw [e1, hB', hB, Polynomial.map_map]
        congr 1
        ext c
        change _ = (R.presheaf.map (homOfLE hle).op) ((R.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op) ((g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) c))
        rw [← CommRingCat.comp_apply, ← Functor.map_comp]
        rfl
    exact hle2 (hgen z)
  intro A _ I R g _ r U hU hcov hint
  obtain ⟨X, h, pr, hP, hpr, chart⟩ := wc_rees_chart_model A I R g
  choose θ hθinj hθC hθB hθgen using chart
  haveI := hpr
  have hsep : IsSeparated (Limits.terminal.from R) := by
    have e : Limits.terminal.from R = g ≫ Limits.terminal.from (Spec (.of A)) :=
      Limits.terminal.hom_ext _ _
    rw [e]
    infer_instance
  haveI : R.IsSeparated := Scheme.IsSeparated.mk hsep
  have hT : ∀ i j l, IsAffineOpen (U i ⊓ U j ⊓ U l) := fun i j l => (hint i j).inf (hU l)
  have hm : ∀ {W W' : R.Opens}, W' ≤ W → pr ⁻¹ᵁ W' ≤ pr ⁻¹ᵁ W := fun hWW x hx => hWW hx
  refine ⟨X, h, fun i => pr ⁻¹ᵁ U i, fun i => θ (U i) (hU i), fun i j => θ (U i ⊓ U j) (hint i j),
    fun i j l => θ (U i ⊓ U j ⊓ U l) (hT i j l), hP, fun i => (hU i).preimage pr, ?_,
    fun i j => (hint i j).preimage pr, fun i j l => hθinj _ (hT i j l), ?_, ?_, ?_, ?_, ?_, ?_, ?_,
    fun i j b => hθB _ (hint i j) b⟩
  · intro x
    obtain ⟨i, hi⟩ := hcov (pr x)
    exact ⟨i, hi⟩
  · intro i z n
    exact (s2 A _ _ I _ (θ (U i) (hU i)) (pr.app (U i)).hom _ (hθgen _ (hU i)) (hθC _ _)
      (hθB _ _)).1 z n
  · intro i j f hf
    exact (s2 A _ _ I _ (θ (U i ⊓ U j) (hint i j)) (pr.app (U i ⊓ U j)).hom _ (hθgen _ (hint i j))
      (hθC _ _) (hθB _ _)).2 f hf
  · intro i j z
    exact s3 A I R g X h pr (U i) (U i ⊓ U j) inf_le_left (hm inf_le_left) (θ _ (hU i))
      (θ _ (hint i j)) (hθgen _ (hU i)) (hθC _ _) (hθB _ _) (hθC _ _) (hθB _ _) z
  · intro i j z
    exact s3 A I R g X h pr (U j) (U i ⊓ U j) inf_le_right (hm inf_le_right) (θ _ (hU j))
      (θ _ (hint i j)) (hθgen _ (hU j)) (hθC _ _) (hθB _ _) (hθC _ _) (hθB _ _) z
  · intro i j l z
    exact s3 A I R g X h pr (U i ⊓ U j) (U i ⊓ U j ⊓ U l) inf_le_left (hm inf_le_left)
      (θ _ (hint i j)) (θ _ (hT i j l)) (hθgen _ (hint i j)) (hθC _ _) (hθB _ _) (hθC _ _)
      (hθB _ _) z
  · intro i j l z
    exact s3 A I R g X h pr (U j ⊓ U l) (U i ⊓ U j ⊓ U l)
      (le_inf (le_trans inf_le_left inf_le_right) inf_le_right)
      (hm (le_inf (le_trans inf_le_left inf_le_right) inf_le_right))
      (θ _ (hint j l)) (θ _ (hT i j l)) (hθgen _ (hint j l)) (hθC _ _) (hθB _ _) (hθC _ _)
      (hθB _ _) z
  · intro i j l z
    exact s3 A I R g X h pr (U i ⊓ U l) (U i ⊓ U j ⊓ U l)
      (le_inf (le_trans inf_le_left inf_le_left) inf_le_right)
      (hm (le_inf (le_trans inf_le_left inf_le_left) inf_le_right))
      (θ _ (hint i l)) (θ _ (hT i j l)) (hθgen _ (hint i l)) (hθC _ _) (hθB _ _) (hθC _ _)
      (hθB _ _) z

theorem wc_rees_cocycle_lift : ∀ (A : Type u) [CommRing A] (I : Ideal A) (R : Scheme.{u}) (g : R ⟶ Spec (.of A)) (r : ℕ) (U : Fin r → R.Opens) (X : Scheme.{u}) (V : Fin r → X.Opens) (θ₂ : ∀ i j, Γ(X, V i ⊓ V j) →+* Polynomial Γ(R, U i ⊓ U j)) (θ₃ : ∀ i j l, Γ(X, V i ⊓ V j ⊓ V l) →+* Polynomial Γ(R, U i ⊓ U j ⊓ U l)), (∀ i j l, Function.Injective (θ₃ i j l)) → (∀ i j (f : Polynomial Γ(R, U i ⊓ U j)), (∀ n, f.coeff n ∈ Ideal.map ((R.presheaf.map (homOfLE (le_top : U i ⊓ U j ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (I ^ n)) → ∃ z, θ₂ i j z = f) → (∀ i j l (z : Γ(X, V i ⊓ V j)), θ₃ i j l (X.presheaf.map (homOfLE (inf_le_left : V i ⊓ V j ⊓ V l ≤ V i ⊓ V j)).op z) = Polynomial.map (R.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ⊓ U l ≤ U i ⊓ U j)).op).hom (θ₂ i j z)) → (∀ i j l (z : Γ(X, V j ⊓ V l)), θ₃ i j l (X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right : V i ⊓ V j ⊓ V l ≤ V j ⊓ V l)).op z) = Polynomial.map (R.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right : U i ⊓ U j ⊓ U l ≤ U j ⊓ U l)).op).hom (θ₂ j l z)) → (∀ i j l (z : Γ(X, V i ⊓ V l)), θ₃ i j l (X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right : V i ⊓ V j ⊓ V l ≤ V i ⊓ V l)).op z) = Polynomial.map (R.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right : U i ⊓ U j ⊓ U l ≤ U i ⊓ U l)).op).hom (θ₂ i l z)) → ∀ (n : ℕ) (x : ∀ i : Fin r, Γ(R, U i)), (fun p : Fin r × Fin r => R.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) - R.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1)) ∈ Ideal.map (RingHom.pi (fun p : Fin r × Fin r => (R.presheaf.map (homOfLE (le_top : U p.1 ⊓ U p.2 ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom))) (I ^ n) → ∃ z : (∀ p : Fin r × Fin r, Γ(X, V p.1 ⊓ V p.2)), (∀ i j l : Fin r, X.presheaf.map (homOfLE (inf_le_left : V i ⊓ V j ⊓ V l ≤ V i ⊓ V j)).op (z (i, j)) + X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_right) inf_le_right : V i ⊓ V j ⊓ V l ≤ V j ⊓ V l)).op (z (j, l)) = X.presheaf.map (homOfLE (le_inf (le_trans inf_le_left inf_le_left) inf_le_right : V i ⊓ V j ⊓ V l ≤ V i ⊓ V l)).op (z (i, l))) ∧ ∀ p : Fin r × Fin r, θ₂ p.1 p.2 (z p) = Polynomial.C (R.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) - R.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1)) * Polynomial.X ^ n :=
by
  intro A _ I R g r U X V θ₂ θ₃ hinj hsurj h1 h2 h3 n x hx
  have s2 : ∀ p : Fin r × Fin r, R.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) - R.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1) ∈ Ideal.map ((R.presheaf.map (homOfLE (le_top : U p.1 ⊓ U p.2 ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (I ^ n) := by
    intro p
    have e : (Pi.evalRingHom (fun p : Fin r × Fin r => Γ(R, U p.1 ⊓ U p.2)) p).comp
        (RingHom.pi (fun p : Fin r × Fin r => (R.presheaf.map (homOfLE (le_top : U p.1 ⊓ U p.2 ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom))) =
        (R.presheaf.map (homOfLE (le_top : U p.1 ⊓ U p.2 ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) :=
      RingHom.ext fun _ => rfl
    have h := Ideal.mem_map_of_mem (Pi.evalRingHom (fun p : Fin r × Fin r => Γ(R, U p.1 ⊓ U p.2)) p) hx
    rw [Ideal.map_map, e] at h
    exact h
  have s3 : ∀ p : Fin r × Fin r, ∀ e, (Polynomial.C (R.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) - R.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1)) * Polynomial.X ^ n).coeff e ∈ Ideal.map ((R.presheaf.map (homOfLE (le_top : U p.1 ⊓ U p.2 ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (I ^ e) := by
    intro p e
    rw [Polynomial.coeff_C_mul_X_pow]
    split_ifs with he
    · rw [he]; exact s2 p
    · exact Ideal.zero_mem _
  choose z hz using fun p : Fin r × Fin r => hsurj p.1 p.2 _ (s3 p)
  refine ⟨z, ?_, hz⟩
  have hz' : ∀ a b : Fin r, θ₂ a b (z (a, b)) = Polynomial.C (R.presheaf.map (homOfLE (inf_le_right : U a ⊓ U b ≤ U b)).op (x b) - R.presheaf.map (homOfLE (inf_le_left : U a ⊓ U b ≤ U a)).op (x a)) * Polynomial.X ^ n :=
    fun a b => hz (a, b)
  have hcomp : ∀ (V W T : R.Opens) (k₁ : W ≤ V) (k₂ : T ≤ W) (y : Γ(R, V)),
      (R.presheaf.map (homOfLE k₂).op).hom ((R.presheaf.map (homOfLE k₁).op).hom y) =
        (R.presheaf.map (homOfLE (k₂.trans k₁)).op).hom y := by
    intro V W T k₁ k₂ y
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  intro i j l
  apply hinj i j l
  rw [map_add, h1, h2, h3, hz' i j, hz' j l, hz' i l]
  simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_pow, Polynomial.map_X]
  rw [← add_mul, ← Polynomial.C_add]
  congr 2
  simp only [map_sub]
  simp only [hcomp]
  abel

theorem wc_rees_coeff_extract : ∀ (A : Type u) [CommRing A] (I : Ideal A) (R : Scheme.{u}) (g : R ⟶ Spec (.of A)) (r : ℕ) (U : Fin r → R.Opens) (X : Scheme.{u}) (h : X ⟶ Spec (.of (reesAlgebra I))) (V : Fin r → X.Opens) (θ₁ : ∀ i, Γ(X, V i) →+* Polynomial Γ(R, U i)) (θ₂ : ∀ i j, Γ(X, V i ⊓ V j) →+* Polynomial Γ(R, U i ⊓ U j)), (∀ i (z : Γ(X, V i)) (n : ℕ), (θ₁ i z).coeff n ∈ Ideal.map ((R.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (I ^ n)) → (∀ i j (z : Γ(X, V i)), θ₂ i j (X.presheaf.map (homOfLE (inf_le_left : V i ⊓ V j ≤ V i)).op z) = Polynomial.map (R.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op).hom (θ₁ i z)) → (∀ i j (z : Γ(X, V j)), θ₂ i j (X.presheaf.map (homOfLE (inf_le_right : V i ⊓ V j ≤ V j)).op z) = Polynomial.map (R.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op).hom (θ₁ j z)) → (∀ i j (b : reesAlgebra I), θ₂ i j (((X.presheaf.map (homOfLE (le_top : V i ⊓ V j ≤ ⊤)).op).hom.comp (h.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom)) b) = Polynomial.map ((R.presheaf.map (homOfLE (le_top : U i ⊓ U j ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (b : Polynomial A)) → ∀ (m : ℕ) (sel : Fin m → ℕ) (xs : Fin m → ∀ i : Fin r, Γ(R, U i)) (zs : Fin m → ∀ p : Fin r × Fin r, Γ(X, V p.1 ⊓ V p.2)) (n : ℕ) (x : ∀ i : Fin r, Γ(R, U i)) (z : ∀ p : Fin r × Fin r, Γ(X, V p.1 ⊓ V p.2)) (b : Fin m → reesAlgebra I) (w : ∀ i : Fin r, Γ(X, V i)), (∀ p : Fin r × Fin r, θ₂ p.1 p.2 (z p) = Polynomial.C (R.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) - R.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1)) * Polynomial.X ^ n) → (∀ (j : Fin m) (p : Fin r × Fin r), θ₂ p.1 p.2 (zs j p) = Polynomial.C (R.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (xs j p.2) - R.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (xs j p.1)) * Polynomial.X ^ sel j) → z = ∑ j, RingHom.pi (fun p : Fin r × Fin r => (X.presheaf.map (homOfLE (le_top : V p.1 ⊓ V p.2 ≤ ⊤)).op).hom.comp (h.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom)) (b j) * zs j + (fun p : Fin r × Fin r => X.presheaf.map (homOfLE (inf_le_right : V p.1 ⊓ V p.2 ≤ V p.2)).op (w p.2) - X.presheaf.map (homOfLE (inf_le_left : V p.1 ⊓ V p.2 ≤ V p.1)).op (w p.1)) → ∃ (a : Fin m → A) (w' : ∀ i : Fin r, Γ(R, U i)), (∀ j, a j ∈ I ^ (n - sel j)) ∧ (∀ j, n < sel j → a j = 0) ∧ w' ∈ Ideal.map (RingHom.pi (fun i : Fin r => (R.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom))) (I ^ n) ∧ (fun p : Fin r × Fin r => R.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) - R.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1)) = ∑ j, RingHom.pi (fun p : Fin r × Fin r => (R.presheaf.map (homOfLE (le_top : U p.1 ⊓ U p.2 ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (a j) * (fun p : Fin r × Fin r => R.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (xs j p.2) - R.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (xs j p.1)) + (fun p : Fin r × Fin r => R.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (w' p.2) - R.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (w' p.1)) :=
by
  classical
  intro A _ I R g r U X h V θ₁ θ₂ hP5 hP7l hP7r hP9 m sel xs zs n x z b w hz hzs hrel
  have hpi : ∀ {ι : Type} [Fintype ι] {S : ι → Type u} [∀ i, CommRing (S i)]
      (ψ : ∀ i, A →+* S i) (J : Ideal A) (x : ∀ i, S i),
      x ∈ Ideal.map (RingHom.pi ψ) J ↔ ∀ i, x i ∈ Ideal.map (ψ i) J := by
    intro ι _ S _ ψ J x
    have e : ∀ i, (Pi.evalRingHom S i).comp (RingHom.pi ψ) = ψ i :=
      fun i => RingHom.ext fun _ => rfl
    constructor
    · intro hx i
      have h1 := Ideal.mem_map_of_mem (Pi.evalRingHom S i) hx
      rw [Ideal.map_map, e] at h1
      exact h1
    · intro hx
      rw [← Finset.univ_sum_single x]
      refine Ideal.sum_mem _ (fun i _ => ?_)
      have hsurj : Function.Surjective (Pi.evalRingHom S i) :=
        fun c => ⟨Pi.single i c, Pi.single_eq_same i c⟩
      have h1 : x i ∈ Ideal.map (Pi.evalRingHom S i) (Ideal.map (RingHom.pi ψ) J) := by
        rw [Ideal.map_map, e]; exact hx i
      obtain ⟨y, hy, hyi⟩ := (Ideal.mem_map_iff_of_surjective _ hsurj).mp h1
      have hyi' : y i = x i := hyi
      have h2 : Pi.single i (x i) = Pi.single i 1 * y := by
        rw [← Pi.single_mul_left, one_mul, hyi']
      rw [h2]
      exact Ideal.mul_mem_left _ _ hy
  refine ⟨fun j => if sel j ≤ n then (b j : Polynomial A).coeff (n - sel j) else 0,
    fun i => (θ₁ i (w i)).coeff n, ?_, ?_, ?_, ?_⟩
  · intro j
    by_cases hs : sel j ≤ n
    · simp only [if_pos hs]
      exact (mem_reesAlgebra_iff I _).mp (b j).2 (n - sel j)
    · simp only [if_neg hs]
      exact Ideal.zero_mem _
  · intro j hj
    simp only [if_neg (Nat.not_le.mpr hj)]
  · refine (hpi _ (I ^ n) _).mpr (fun i => ?_)
    exact hP5 i (w i) n
  · funext p
    have e1 := congrArg (θ₂ p.1 p.2) (congrFun hrel p)
    simp only [Finset.sum_apply, Pi.add_apply, Pi.mul_apply, RingHom.pi_apply, map_add,
      map_sum, map_mul, map_sub] at e1
    rw [hz p, hP7l, hP7r] at e1
    simp only [hP9, hzs] at e1
    have e2 := congrArg (fun q => Polynomial.coeff q n) e1
    simp only [Polynomial.coeff_C_mul_X_pow, if_pos rfl, Polynomial.coeff_add, if_true,
      ↓reduceIte, Polynomial.coeff_sub, Polynomial.finset_sum_coeff, Polynomial.coeff_map] at e2
    simp only [Finset.sum_apply, Pi.add_apply, Pi.mul_apply, RingHom.pi_apply]
    rw [e2]
    refine congrArg₂ (· + ·) (Finset.sum_congr rfl (fun j _ => ?_)) rfl
    rw [← mul_assoc, Polynomial.coeff_mul_X_pow']
    by_cases hs : sel j ≤ n
    · rw [if_pos hs, if_pos hs, Polynomial.coeff_mul_C, Polynomial.coeff_map]
    · rw [if_neg hs, if_neg hs, map_zero, zero_mul]

theorem wc_proper_cech_artin_rees : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (I : Ideal A) (R : Scheme.{u}) (g : R ⟶ Spec (.of A)) [IsProper g] (r : ℕ) (U : Fin r → R.Opens), (∀ i, IsAffineOpen (U i)) → (∀ x : R, ∃ i, x ∈ U i) → (∀ i j, IsAffineOpen (U i ⊓ U j)) → ∃ (q : ℕ) (deg : Fin q → ℕ) (y : Fin q → ∀ i : Fin r, Γ(R, U i)), ∀ (n : ℕ) (x : ∀ i : Fin r, Γ(R, U i)), (fun p : Fin r × Fin r => R.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) - R.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1)) ∈ Ideal.map (RingHom.pi (fun p : Fin r × Fin r => (R.presheaf.map (homOfLE (le_top : U p.1 ⊓ U p.2 ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom))) (I ^ n) → ∃ (a : Fin q → A) (w : ∀ i : Fin r, Γ(R, U i)), (∀ l, a l ∈ I ^ (n - deg l)) ∧ (∀ l, n < deg l → a l = 0) ∧ w ∈ Ideal.map (RingHom.pi (fun i : Fin r => (R.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom))) (I ^ n) ∧ (fun p : Fin r × Fin r => R.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) - R.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1)) = ∑ l, RingHom.pi (fun p : Fin r × Fin r => (R.presheaf.map (homOfLE (le_top : U p.1 ⊓ U p.2 ≤ ⊤)).op).hom.comp (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)) (a l) * (fun p : Fin r × Fin r => R.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (y l p.2) - R.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (y l p.1)) + (fun p : Fin r × Fin r => R.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (w p.2) - R.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (w p.1)) :=
by
  classical
  intro A _ _ I R g _ r U hUaff hcov hint

  haveI hBn : IsNoetherianRing (reesAlgebra I) :=
    @Algebra.FiniteType.isNoetherianRing A (reesAlgebra I) _ _ _
      ((Subalgebra.fg_iff_finiteType _).mp (reesAlgebra.fg (IsNoetherian.noetherian I))) _

  obtain ⟨X, h, V, θ₁, θ₂, θ₃, hP1, hP2, hP3, hP2', hP4, hP5, hP6, hP7l, hP7r, hP8a, hP8b,
    hP8c, hP9⟩ := wc_rees_scheme_model A I R g r U hUaff hcov hint
  haveI := hP1

  obtain ⟨k, c, H2⟩ := wc_proper_cech_h1_fg (reesAlgebra I) X h r V hP2 hP3 hP2'

  let φX : ∀ W : X.Opens, reesAlgebra I →+* Γ(X, W) := fun W =>
    (X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom.comp
      (h.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom)
  let χ : reesAlgebra I →+* (∀ p : Fin r × Fin r, Γ(X, V p.1 ⊓ V p.2)) :=
    RingHom.pi (fun p => φX (V p.1 ⊓ V p.2))
  let χ₀ : reesAlgebra I →+* (∀ i : Fin r, Γ(X, V i)) := RingHom.pi (fun i => φX (V i))
  let dX : (∀ i : Fin r, Γ(X, V i)) → (∀ p : Fin r × Fin r, Γ(X, V p.1 ⊓ V p.2)) := fun w p =>
    X.presheaf.map (homOfLE (inf_le_right : V p.1 ⊓ V p.2 ≤ V p.2)).op (w p.2) -
      X.presheaf.map (homOfLE (inf_le_left : V p.1 ⊓ V p.2 ≤ V p.1)).op (w p.1)
  have hres' : ∀ (W W' : X.Opens) (hle : W' ≤ W) (e : reesAlgebra I),
      X.presheaf.map (homOfLE hle).op (φX W e) = φX W' e := by
    intro W W' hle e
    show (X.presheaf.map (homOfLE hle).op) ((X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op)
      ((h.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom) e)) =
      (X.presheaf.map (homOfLE (le_top : W' ≤ ⊤)).op)
      ((h.appTop.hom.comp (Scheme.ΓSpecIso (.of (reesAlgebra I))).inv.hom) e)
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  let N₀ : AddSubgroup (∀ p : Fin r × Fin r, Γ(X, V p.1 ⊓ V p.2)) :=
    { carrier := {z | ∃ w, z = dX w}
      add_mem' := by
        rintro _ _ ⟨w, rfl⟩ ⟨w', rfl⟩
        refine ⟨w + w', ?_⟩
        funext p
        simp only [dX, Pi.add_apply, map_add]
        ring
      zero_mem' := ⟨0, by funext p; simp only [dX, Pi.zero_apply, map_zero, sub_self]⟩
      neg_mem' := by
        rintro _ ⟨w, rfl⟩
        refine ⟨-w, ?_⟩
        funext p
        simp only [dX, Pi.neg_apply, map_neg]
        ring }
  have hclos : ∀ (b : reesAlgebra I) (w : ∀ p : Fin r × Fin r, Γ(X, V p.1 ⊓ V p.2)),
      w ∈ N₀ → χ b * w ∈ N₀ := by
    rintro b _ ⟨w, rfl⟩
    refine ⟨χ₀ b * w, ?_⟩
    funext p
    simp only [dX, χ, χ₀, Pi.mul_apply, RingHom.pi_apply, map_mul]
    rw [hres' _ _ _ b, hres' _ _ _ b]
    ring

  let φ₁ := RingHom.pi (fun p : Fin r × Fin r =>
    (R.presheaf.map (homOfLE (le_top : U p.1 ⊓ U p.2 ≤ ⊤)).op).hom.comp
      (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom))
  let dR : (∀ i : Fin r, Γ(R, U i)) → (∀ p : Fin r × Fin r, Γ(R, U p.1 ⊓ U p.2)) := fun x p =>
    R.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) -
      R.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1)
  let ι := Σ n : ℕ, {x : ∀ i : Fin r, Γ(R, U i) // dR x ∈ Ideal.map φ₁ (I ^ n)}
  have hlift := fun (i : ι) =>
    wc_rees_cocycle_lift A I R g r U X V θ₂ θ₃ hP4 hP6 hP8a hP8b hP8c i.1 i.2.1 i.2.2
  choose F hFcoc hFθ using hlift

  have hFspan : ∀ i : ι, ∃ (b : Fin k → reesAlgebra I)
      (w : ∀ p : Fin r × Fin r, Γ(X, V p.1 ⊓ V p.2)), w ∈ N₀ ∧ F i = ∑ l, χ (b l) * c l + w := by
    intro i
    obtain ⟨b, w, hw⟩ := H2 (F i) (hFcoc i)
    exact ⟨b, dX w, ⟨w, rfl⟩, hw⟩
  obtain ⟨m, s, hs⟩ := wc_noeth_span_finite_subfamily (reesAlgebra I) _ χ N₀ hclos F k c hFspan

  refine ⟨m, fun j => (s j).1, fun j => (s j).2.1, ?_⟩
  intro n x hx
  obtain ⟨b, w₁, ⟨w₀, rfl⟩, hrel⟩ := hs ⟨n, ⟨x, hx⟩⟩
  exact wc_rees_coeff_extract A I R g r U X h V θ₁ θ₂ hP5 hP7l hP7r hP9 m (fun j => (s j).1)
    (fun j => (s j).2.1) (fun j => F (s j)) n x (F ⟨n, ⟨x, hx⟩⟩) b w₀ (hFθ ⟨n, ⟨x, hx⟩⟩)
    (fun j => hFθ (s j)) hrel

theorem wc_proper_noetherian_local_ml_lift : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (R : Scheme.{u}) (g : R ⟶ Spec (.of A)) [IsProper g], ∃ N : ℕ, ∀ s : Γ(Limits.pullback g (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ (N + 1))))), ⊤), ∃ b : Γ(R, ⊤), ∀ z : ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ (N + 1)))))), z ∉ (Limits.pullback g (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ (N + 1)))))).basicOpen ((Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ (N + 1)))))).appTop b - s) :=
by
  classical
  intro A _ _ _ R g _

  have hpi : ∀ {ι : Type} [Fintype ι] {S : ι → Type u} [∀ i, CommRing (S i)]
      (ψ : ∀ i, A →+* S i) (J : Ideal A) (x : ∀ i, S i),
      x ∈ Ideal.map (RingHom.pi ψ) J ↔ ∀ i, x i ∈ Ideal.map (ψ i) J := by
    intro ι _ S _ ψ J x
    have e : ∀ i, (Pi.evalRingHom S i).comp (RingHom.pi ψ) = ψ i := fun i => RingHom.ext fun _ => rfl
    constructor
    · intro hx i
      have h1 := Ideal.mem_map_of_mem (Pi.evalRingHom S i) hx
      rw [Ideal.map_map, e] at h1
      exact h1
    · intro hx
      rw [← Finset.univ_sum_single x]
      refine Ideal.sum_mem _ (fun i _ => ?_)
      have hsurj : Function.Surjective (Pi.evalRingHom S i) :=
        fun c => ⟨Pi.single i c, Pi.single_eq_same i c⟩
      have h1 : x i ∈ Ideal.map (Pi.evalRingHom S i) (Ideal.map (RingHom.pi ψ) J) := by
        rw [Ideal.map_map, e]; exact hx i
      obtain ⟨y, hy, hyi⟩ := (Ideal.mem_map_iff_of_surjective _ hsurj).mp h1
      have hyi' : y i = x i := hyi
      have h2 : Pi.single i (x i) = Pi.single i 1 * y := by
        rw [← Pi.single_mul_left, one_mul, hyi']
      rw [h2]
      exact Ideal.mul_mem_left _ _ hy

  have hML : ∀ (S₀ S₁ : Type u) [CommRing S₀] [CommRing S₁] (φ₀ : A →+* S₀) (φ₁ : A →+* S₁)
      (d : S₀ → S₁), (∀ x y, d (x + y) = d x + d y) → (∀ (a : A) (x : S₀), d (φ₀ a * x) = φ₁ a * d x) →
      ∀ (q : ℕ) (deg : Fin q → ℕ) (y : Fin q → S₀) (N : ℕ), (∀ l, deg l ≤ N) →
      (∀ x : S₀, d x ∈ Ideal.map φ₁ (IsLocalRing.maximalIdeal A ^ (N + 1)) →
        ∃ (a : Fin q → A) (w : S₀), (∀ l, a l ∈ IsLocalRing.maximalIdeal A ^ (N + 1 - deg l)) ∧
          w ∈ Ideal.map φ₀ (IsLocalRing.maximalIdeal A ^ (N + 1)) ∧
          d x = ∑ l, φ₁ (a l) * d (y l) + d w) →
      ∀ σ : S₀, d σ ∈ Ideal.map φ₁ (IsLocalRing.maximalIdeal A ^ (N + 1)) →
        ∃ b : S₀, d b = 0 ∧ σ - b ∈ Ideal.map φ₀ (IsLocalRing.maximalIdeal A) := by
    intro S₀ S₁ _ _ φ₀ φ₁ d hadd hlin q deg y N hdeg H σ hσ
    obtain ⟨a, w, ha, hw, hdx⟩ := H σ hσ
    let D : S₀ →+ S₁ := AddMonoidHom.mk' d hadd
    refine ⟨σ - ∑ l, φ₀ (a l) * y l - w, ?_, ?_⟩
    · have h1 : d (σ - ∑ l, φ₀ (a l) * y l - w) = d σ - ∑ l, φ₁ (a l) * d (y l) - d w := by
        change D _ = _
        rw [map_sub, map_sub, map_sum]
        simp only [D, AddMonoidHom.mk'_apply, hlin]
      rw [h1, hdx]
      abel
    · have h2 : σ - (σ - ∑ l, φ₀ (a l) * y l - w) = ∑ l, φ₀ (a l) * y l + w := by ring
      rw [h2]
      refine Ideal.add_mem _ (Ideal.sum_mem _ (fun l _ => ?_))
        (Ideal.map_mono (Ideal.pow_le_self (Nat.succ_ne_zero N)) hw)
      apply Ideal.mul_mem_right
      apply Ideal.mem_map_of_mem
      exact Ideal.pow_le_self (by have := hdeg l; omega) (ha l)

  obtain ⟨r, U, hUaff, hcov, hint⟩ : ∃ (r : ℕ) (U : Fin r → R.Opens), (∀ i, IsAffineOpen (U i)) ∧
      (∀ x : R, ∃ i, x ∈ U i) ∧ ∀ i j, IsAffineOpen (U i ⊓ U j) := by
    haveI : CompactSpace R := QuasiCompact.compactSpace_of_compactSpace g
    have hsep : IsSeparated (Limits.terminal.from R) := by
      have e : Limits.terminal.from R = g ≫ Limits.terminal.from (Spec (.of A)) :=
        Limits.terminal.hom_ext _ _
      rw [e]
      infer_instance
    haveI : R.IsSeparated := Scheme.IsSeparated.mk hsep
    have hW : ∀ x : R, ∃ W : R.Opens, IsAffineOpen W ∧ x ∈ W := by
      intro x
      obtain ⟨U', hU', hxU', -⟩ :=
        (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (R.isBasis_affineOpens))
          (show x ∈ (⊤ : R.Opens) from trivial)
      exact ⟨U', hU', hxU'⟩
    choose W hWaff hWmem using hW
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun x => (W x : Set R))
      (fun x => (W x).isOpen) (fun y _ => Set.mem_iUnion.mpr ⟨y, hWmem y⟩)
    let e := t.equivFin
    refine ⟨t.card, fun i => W (e.symm i).1, fun i => hWaff _, ?_,
      fun i j => (hWaff _).inf (hWaff _)⟩
    intro x
    have hx := ht (Set.mem_univ x)
    simp only [Set.mem_iUnion] at hx
    obtain ⟨y, hy, hxy⟩ := hx
    refine ⟨e ⟨y, hy⟩, ?_⟩
    simp only [Equiv.symm_apply_apply]
    exact hxy

  let φV : ∀ V : R.Opens, A →+* Γ(R, V) := fun V =>
    (R.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.comp
      (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)
  have hres' : ∀ (V W : R.Opens) (h : W ≤ V) (c : A),
      R.presheaf.map (homOfLE h).op (φV V c) = φV W c := by
    intro V W h c
    show (R.presheaf.map (homOfLE h).op) ((R.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op)
      ((g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) c)) =
      (R.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op)
      ((g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom) c)
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  let φ₀ : A →+* (∀ i : Fin r, Γ(R, U i)) := RingHom.pi (fun i => φV (U i))
  let φ₁ : A →+* (∀ p : Fin r × Fin r, Γ(R, U p.1 ⊓ U p.2)) :=
    RingHom.pi (fun p => φV (U p.1 ⊓ U p.2))
  let d : (∀ i : Fin r, Γ(R, U i)) → (∀ p : Fin r × Fin r, Γ(R, U p.1 ⊓ U p.2)) := fun x p =>
    R.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (x p.2) -
      R.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (x p.1)
  have hadd : ∀ x y, d (x + y) = d x + d y := by
    intro x y
    funext p
    simp only [d, Pi.add_apply, map_add]
    ring
  have hlin : ∀ (a : A) (x : ∀ i : Fin r, Γ(R, U i)), d (φ₀ a * x) = φ₁ a * d x := by
    intro a x
    funext p
    simp only [d, φ₀, φ₁, Pi.mul_apply, RingHom.pi_apply, map_mul]
    rw [hres' _ _ _ a, hres' _ _ _ a]
    ring

  obtain ⟨q, deg, y, H⟩ := wc_proper_cech_artin_rees A (IsLocalRing.maximalIdeal A) R g r U
    hUaff hcov hint
  have hdeg : ∀ l, deg l ≤ Finset.univ.sup deg := fun l => Finset.le_sup (Finset.mem_univ l)
  refine ⟨Finset.univ.sup deg, ?_⟩
  generalize Finset.univ.sup deg = N at hdeg ⊢
  have hs2 : ∀ V : R.Opens, IsAffineOpen V → Function.Surjective ((Limits.pullback.fst g
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ (N + 1)))))).app V).hom ∧
      ∀ x : Γ(R, V), ((Limits.pullback.fst g (Spec.map (CommRingCat.ofHom
        (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ (N + 1)))))).app V).hom x = 0 ↔
        x ∈ Ideal.map (φV V) (IsLocalRing.maximalIdeal A ^ (N + 1)) :=
    fun V hV => wc_pullback_quot_affine_sections A R g _ V hV
  generalize Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ (N + 1))))
    = qq at hs2 ⊢
  intro s

  choose σ hσ using fun i => (hs2 (U i) (hUaff i)).1
    ((Limits.pullback g qq).presheaf.map
      (homOfLE (le_top : (Limits.pullback.fst g qq) ⁻¹ᵁ U i ≤ ⊤)).op s)
  have hσ' : ∀ i, (Limits.pullback.fst g qq).app (U i) (σ i) =
      (Limits.pullback g qq).presheaf.map
        (homOfLE (le_top : (Limits.pullback.fst g qq) ⁻¹ᵁ U i ≤ ⊤)).op s := hσ
  have hloc : ∀ (V W : R.Opens) (h : W ≤ V) (x : Γ(R, V)),
      (Limits.pullback.fst g qq).app V x = (Limits.pullback g qq).presheaf.map
        (homOfLE (le_top : (Limits.pullback.fst g qq) ⁻¹ᵁ V ≤ ⊤)).op s →
      (Limits.pullback.fst g qq).app W (R.presheaf.map (homOfLE h).op x) =
        (Limits.pullback g qq).presheaf.map
          (homOfLE (le_top : (Limits.pullback.fst g qq) ⁻¹ᵁ W ≤ ⊤)).op s := by
    intro V W h x hx
    rw [← CommRingCat.comp_apply, Scheme.Hom.naturality, CommRingCat.comp_apply, hx,
      ← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have hdσ : d σ ∈ Ideal.map φ₁ (IsLocalRing.maximalIdeal A ^ (N + 1)) := by
    refine (hpi _ _ _).mpr (fun p => ?_)
    refine ((hs2 _ (hint p.1 p.2)).2 (d σ p)).mp ?_
    change (Limits.pullback.fst g qq).app (U p.1 ⊓ U p.2)
      (R.presheaf.map (homOfLE (inf_le_right : U p.1 ⊓ U p.2 ≤ U p.2)).op (σ p.2) -
        R.presheaf.map (homOfLE (inf_le_left : U p.1 ⊓ U p.2 ≤ U p.1)).op (σ p.1)) = 0
    rw [map_sub, hloc _ _ _ _ (hσ' p.2), hloc _ _ _ _ (hσ' p.1), sub_self]

  obtain ⟨b, hdb, hsb⟩ := hML (∀ i : Fin r, Γ(R, U i)) (∀ p : Fin r × Fin r, Γ(R, U p.1 ⊓ U p.2))
    φ₀ φ₁ d hadd hlin q deg y N hdeg
    (fun x hx => by
      obtain ⟨a, w, ha, -, hw, hdx⟩ := H (N + 1) x hx
      exact ⟨a, w, ha, hw, hdx⟩) σ hdσ

  have hcompat : TopCat.Presheaf.IsCompatible R.sheaf.obj U b := by
    intro i j
    have h : R.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (b j) -
        R.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (b i) = 0 :=
      congrFun hdb (i, j)
    exact (sub_eq_zero.mp h).symm
  have hcov' : (⊤ : R.Opens) ≤ iSup U := by
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    exact hcov x
  obtain ⟨bb, hbb, -⟩ := TopCat.Sheaf.existsUnique_gluing' R.sheaf U ⊤
    (fun i => homOfLE le_top) hcov' b hcompat
  have hbb' : ∀ i, R.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op bb = b i := hbb
  refine ⟨bb, ?_⟩

  intro z hz
  obtain ⟨i, hi⟩ := hcov ((Limits.pullback.fst g qq) z)
  have hzW : z ∈ (Limits.pullback.fst g qq) ⁻¹ᵁ U i := hi
  have hnatTop : ∀ x : Γ(R, ⊤), (Limits.pullback g qq).presheaf.map
      (homOfLE (le_top : (Limits.pullback.fst g qq) ⁻¹ᵁ U i ≤ ⊤)).op
        ((Limits.pullback.fst g qq).appTop x) =
      (Limits.pullback.fst g qq).app (U i) (R.presheaf.map (homOfLE (le_top : U i ≤ ⊤)).op x) := by
    intro x
    rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, Scheme.Hom.naturality]
    rfl
  have htop : (Limits.pullback g qq).presheaf.map
      (homOfLE (le_top : (Limits.pullback.fst g qq) ⁻¹ᵁ U i ≤ ⊤)).op
        ((Limits.pullback.fst g qq).appTop bb) = (Limits.pullback.fst g qq).app (U i) (b i) := by
    rw [hnatTop bb, hbb' i]
  have hres_t : (Limits.pullback g qq).presheaf.map
      (homOfLE (le_top : (Limits.pullback.fst g qq) ⁻¹ᵁ U i ≤ ⊤)).op
        ((Limits.pullback.fst g qq).appTop bb - s) =
      (Limits.pullback.fst g qq).app (U i) (b i - σ i) := by
    rw [map_sub, map_sub, htop, hσ' i]
  have hy0 : b i - σ i ∈ Ideal.map (φV (U i)) (IsLocalRing.maximalIdeal A) := by
    have h1 : (σ - b) i ∈ Ideal.map (φV (U i)) (IsLocalRing.maximalIdeal A) :=
      (hpi (fun i => φV (U i)) _ (σ - b)).mp hsb i
    have h2 : b i - σ i = -((σ - b) i) := by simp
    rw [h2]
    exact neg_mem h1
  have hpow0 : (Limits.pullback.fst g qq).app (U i) ((b i - σ i) ^ (N + 1)) = 0 := by
    have hmem : (b i - σ i) ^ (N + 1) ∈ Ideal.map (φV (U i)) (IsLocalRing.maximalIdeal A ^ (N + 1)) := by
      rw [Ideal.map_pow]
      exact Ideal.pow_mem_pow hy0 _
    exact ((hs2 (U i) (hUaff i)).2 _).mpr hmem
  have hbo : (Limits.pullback g qq).basicOpen ((Limits.pullback g qq).presheaf.map
      (homOfLE (le_top : (Limits.pullback.fst g qq) ⁻¹ᵁ U i ≤ ⊤)).op
        ((Limits.pullback.fst g qq).appTop bb - s)) = ⊥ := by
    rw [← Scheme.basicOpen_pow _ _ (Nat.succ_pos N), hres_t, ← map_pow, hpow0,
      Scheme.basicOpen_zero]
  rw [Scheme.basicOpen_res] at hbo
  have hmem : z ∈ (Limits.pullback.fst g qq) ⁻¹ᵁ U i ⊓
      (Limits.pullback g qq).basicOpen ((Limits.pullback.fst g qq).appTop bb - s) := ⟨hzW, hz⟩
  rw [hbo] at hmem
  exact hmem

theorem wc_idealSheaf_fg_extension : ∀ (Y : Scheme.{u}) [QuasiSeparatedSpace Y] (K : Y.IdealSheafData) (O : Set Y), IsOpen O → IsCompact O → (∀ x ∈ O, ∃ U : Y.affineOpens, x ∈ (U : Set Y) ∧ (K.ideal U).FG) → ∀ (V : Y.affineOpens) (N₀ : Ideal Γ(Y, (V : Y.Opens))), N₀.FG → N₀ ≤ K.ideal V → ∃ K' : Y.IdealSheafData, K' ≤ K ∧ (∀ W : Y.affineOpens, (W : Set Y) ⊆ O → K'.ideal W = K.ideal W) ∧ N₀ ≤ K'.ideal V ∧ ∀ x ∈ O ∪ (V : Set Y), ∃ U : Y.affineOpens, x ∈ (U : Set Y) ∧ (K'.ideal U).FG :=
by
  intro Y _ K O hO hOc hK V N₀ hN₀ hN₀K
  classical

  have c1 : ∀ (S : Type u) [CommRing S] (f : Γ(Y, (V : Y.Opens)) →+* S)
      (M : Ideal Γ(Y, (V : Y.Opens))), (Ideal.map f M).FG →
      ∃ G : Finset Γ(Y, (V : Y.Opens)), (↑G : Set Γ(Y, (V : Y.Opens))) ⊆ M ∧
        Ideal.map f M ≤ Ideal.map f (Ideal.span (↑G : Set Γ(Y, (V : Y.Opens)))) := by
    intro S _ f M h
    obtain ⟨s, hs, hspan⟩ :=
      (Submodule.fg_span_iff_fg_span_finset_subset (f '' (M : Set Γ(Y, (V : Y.Opens))))).mp h
    obtain ⟨G, hGM, hGs⟩ := Finset.subset_set_image_iff.mp hs
    refine ⟨G, hGM, le_of_eq ?_⟩
    rw [Ideal.map_span, ← Finset.coe_image, hGs]
    exact hspan

  have c2 : IsCompact (O ∩ (V : Set Y)) →
      ∃ (m : ℕ) (b : Fin m → Γ(Y, (V : Y.Opens))),
        (O ∩ (V : Set Y) ⊆ ⋃ i, (Y.basicOpen (b i) : Set Y)) ∧
        ∀ i, (Ideal.map (Y.presheaf.map (homOfLE (Y.basicOpen_le (b i))).op).hom
          (K.ideal V)).FG := by
    intro hc
    have hpt : ∀ x : (O ∩ (V : Set Y) : Set Y), ∃ f : Γ(Y, (V : Y.Opens)),
        (x : Y) ∈ Y.basicOpen f ∧
        (Ideal.map (Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom (K.ideal V)).FG := by
      rintro ⟨x, hxO, hxV⟩
      obtain ⟨U, hxU, hU⟩ := hK x hxO
      obtain ⟨f, g, hfg, hxf⟩ := exists_basicOpen_le_affine_inter V.2 U.2 x ⟨hxV, hxU⟩
      refine ⟨f, hxf, ?_⟩
      have hA : Y.affineBasicOpen g = Y.affineBasicOpen f := Subtype.ext hfg.symm
      have hT : ∀ A B : Y.affineOpens, A = B → (K.ideal A).FG → (K.ideal B).FG := by
        rintro _ _ rfl h; exact h
      have h2 : (K.ideal (Y.affineBasicOpen g)).FG := by
        rw [← K.map_ideal_basicOpen U g]; exact hU.map _
      rw [K.map_ideal_basicOpen V f]
      exact hT _ _ hA h2
    choose f hxf hfFG using hpt
    obtain ⟨t, ht⟩ := hc.elim_finite_subcover (fun x => (Y.basicOpen (f x) : Set Y))
      (fun x => (Y.basicOpen (f x)).isOpen) (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hxf _⟩)
    refine ⟨t.card, fun i => f (t.equivFin.symm i), ?_, fun i => hfFG _⟩
    intro x hx
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp (ht hx)
    exact Set.mem_iUnion.mpr ⟨t.equivFin ⟨y, hy⟩, by simpa using hxy⟩

  have c3 : ∀ (N : Ideal Γ(Y, (V : Y.Opens))) (m : ℕ) (b : Fin m → Γ(Y, (V : Y.Opens)))
      (k : Γ(Y, (V : Y.Opens))),
      (∀ i, (Y.presheaf.map (homOfLE (Y.basicOpen_le (b i))).op).hom k ∈
        Ideal.map (Y.presheaf.map (homOfLE (Y.basicOpen_le (b i))).op).hom N) →
      ∀ (a : Γ(Y, (V : Y.Opens))), (Y.basicOpen a : Set Y) ⊆ ⋃ i, (Y.basicOpen (b i) : Set Y) →
      (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op).hom k ∈
        Ideal.map (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op).hom N := by
    intro N m b k hk a ha
    have hpow : ∀ i, ∃ n : ℕ, b i ^ n * k ∈ N := by
      intro i
      have := V.2.isLocalization_basicOpen (b i)
      obtain ⟨s, hs, hsk⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff
        (Submonoid.powers (b i)) Γ(Y, Y.basicOpen (b i)) N k).mp (hk i)
      obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hs
      exact ⟨n, hsk⟩
    choose n hn using hpow
    have hspan : Ideal.span (Set.range fun i =>
        (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op).hom (b i)) = ⊤ := by
      rw [← (V.2.basicOpen a).self_le_iSup_basicOpen_iff]
      intro y hy
      obtain ⟨i, hyi⟩ := Set.mem_iUnion.mp (ha hy)
      rw [TopologicalSpace.Opens.mem_iSup]
      refine ⟨⟨_, ⟨i, rfl⟩⟩, ?_⟩
      have := Scheme.basicOpen_res Y (b i) (homOfLE (Y.basicOpen_le a)).op
      change y ∈ Y.basicOpen
        ((ConcreteCategory.hom (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op)) (b i))
      rw [this]
      exact ⟨hy, hyi⟩
    apply Submodule.mem_of_span_eq_top_of_smul_pow_mem _ _ hspan
    rintro ⟨_, ⟨i, rfl⟩⟩
    refine ⟨n i, ?_⟩
    rw [smul_eq_mul, ← map_pow, ← map_mul]
    exact Ideal.mem_map_of_mem _ (hn i)

  have L4 : ∀ (N : Ideal Γ(Y, (V : Y.Opens))),
      (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk N)) ≫ V.2.fromSpec)).ideal V
        = N := by
    intro N
    set q := CommRingCat.ofHom (Ideal.Quotient.mk N)
    rw [Scheme.Hom.ker_apply]
    have hpre : (Spec.map q ≫ V.2.fromSpec) ⁻¹ᵁ (V : Y.Opens) = ⊤ := by
      refine eq_top_iff.mpr fun x _ => ?_
      show (Spec.map q ≫ V.2.fromSpec) x ∈ (V : Set Y)
      rw [Scheme.Hom.comp_apply, ← V.2.range_fromSpec]
      exact ⟨_, rfl⟩
    have he : (Spec.map q ≫ V.2.fromSpec).app V = q ≫ (Scheme.ΓSpecIso _).inv ≫
        (Spec (CommRingCat.of (Γ(Y, (V : Y.Opens)) ⧸ N))).presheaf.map (eqToHom hpre).op := by
      rw [Scheme.Hom.comp_app, IsAffineOpen.fromSpec_app_self (U := (V : Y.Opens)) V.2,
        Scheme.Hom.app_eq (Spec.map q)
          (IsAffineOpen.fromSpec_preimage_self (U := (V : Y.Opens)) V.2)]
      rw [Scheme.ΓSpecIso_inv_naturality_assoc]
      simp only [Category.assoc, eqToHom_op, eqToHom_map, eqToHom_trans_assoc, eqToHom_refl,
        Category.id_comp]
      rfl
    rw [he, CommRingCat.hom_comp,
      RingHom.ker_comp_of_injective _ (ConcreteCategory.bijective_of_isIso _).1]
    exact Ideal.mk_ker

  have L5 : ∀ (N : Ideal Γ(Y, (V : Y.Opens))),
      N ≤ (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk N)) ≫
        V.2.fromSpec)).ideal V →
      ∀ (U : Y.affineOpens) (g : Γ(Y, (U : Y.Opens))),
      (∀ (a : Γ(Y, (V : Y.Opens))) (hle : Y.basicOpen a ≤ (U : Y.Opens)),
        (Y.presheaf.map (homOfLE hle).op).hom g ∈
          Ideal.map (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op).hom N) →
      g ∈ (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk N)) ≫
        V.2.fromSpec)).ideal U := by
    intro N hN U g hg
    rw [Scheme.Hom.ker_apply] at hN ⊢
    set T := Spec (CommRingCat.of (Γ(Y, (V : Y.Opens)) ⧸ N))
    set φ : T ⟶ Y := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk N)) ≫ V.2.fromSpec with hφ
    have nat : ∀ (U₁ U₂ : Y.Opens) (h : U₁ ≤ U₂) (x : Γ(Y, U₂)),
        (φ.app U₁).hom ((Y.presheaf.map (homOfLE h).op).hom x) =
          (T.presheaf.map (homOfLE (fun z hz => h hz : φ ⁻¹ᵁ U₁ ≤ φ ⁻¹ᵁ U₂)).op).hom
            ((φ.app U₂).hom x) :=
      fun U₁ U₂ h x => congrArg (fun k => k.hom x) (Scheme.Hom.naturality φ (homOfLE h).op)
    have step1 : ∀ a : Γ(Y, (V : Y.Opens)),
        Ideal.map (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op).hom N ≤
          RingHom.ker (φ.app (Y.basicOpen a)).hom := by
      intro a
      rw [Ideal.map_le_iff_le_comap]
      intro n hn
      rw [Ideal.mem_comap, RingHom.mem_ker, nat _ _ (Y.basicOpen_le a),
        RingHom.mem_ker.mp (hN hn), map_zero]
    let W : {a : Γ(Y, (V : Y.Opens)) // Y.basicOpen a ≤ (U : Y.Opens)} → T.Opens :=
      fun a => φ ⁻¹ᵁ (Y.basicOpen a.1)
    have hcov : φ ⁻¹ᵁ (U : Y.Opens) ≤ iSup W := by
      intro z hz
      have hzU : φ z ∈ (U : Set Y) := hz
      have hzV : φ z ∈ (V : Y.Opens) := by
        rw [hφ, Scheme.Hom.comp_apply]
        show _ ∈ (V : Set Y)
        rw [← V.2.range_fromSpec]
        exact ⟨_, rfl⟩
      obtain ⟨f, hfU, hzf⟩ := V.2.exists_basicOpen_le (V := (U : Y.Opens)) ⟨φ z, hzU⟩ hzV
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨f, hfU⟩, hzf⟩
    rw [RingHom.mem_ker]
    refine TopCat.Sheaf.eq_of_locally_eq' T.sheaf W (φ ⁻¹ᵁ (U : Y.Opens))
      (fun a => homOfLE (fun z hz => a.2 hz)) hcov _ 0 ?_
    intro a
    have h1 := (nat _ _ a.2 g).symm.trans (RingHom.mem_ker.mp (step1 a.1 (hg a.1 a.2)))
    exact h1.trans (map_zero _).symm

  have hA : IsCompact (O ∩ (V : Set Y)) :=
    QuasiSeparatedSpace.inter_isCompact O _ hO hOc (V : Y.Opens).isOpen V.2.isCompact
  obtain ⟨m, b, hcov, hFG⟩ := c2 hA
  have hG := fun i => c1 _ _ (K.ideal V) (hFG i)
  choose G hGsub hGgen using hG
  set G' := Finset.univ.biUnion G with hG'
  set N' : Ideal Γ(Y, (V : Y.Opens)) := N₀ ⊔ Ideal.span (↑G' : Set Γ(Y, (V : Y.Opens))) with hN'
  have hN'FG : N'.FG := Submodule.FG.sup hN₀ (Submodule.fg_span G'.finite_toSet)
  have hN₀N' : N₀ ≤ N' := le_sup_left
  have hN'K : N' ≤ K.ideal V := by
    refine sup_le hN₀K (Ideal.span_le.mpr (fun x hx => ?_))
    obtain ⟨i, -, hi⟩ := Finset.mem_biUnion.mp (Finset.mem_coe.mp hx)
    exact hGsub i (Finset.mem_coe.mpr hi)
  have hGN' : ∀ i, Ideal.span (↑(G i) : Set Γ(Y, (V : Y.Opens))) ≤ N' := fun i =>
    (Ideal.span_mono (Finset.coe_subset.mpr
      (Finset.subset_biUnion_of_mem G (Finset.mem_univ i)))).trans le_sup_right
  have hP : ∀ a : Γ(Y, (V : Y.Opens)), (Y.basicOpen a : Set Y) ⊆ O →
      Ideal.map (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op).hom (K.ideal V) ≤
        Ideal.map (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op).hom N' := by
    intro a ha
    rw [Ideal.map_le_iff_le_comap]
    intro k hk
    rw [Ideal.mem_comap]
    refine c3 N' m b k (fun i => ?_) a (fun y hy => hcov ⟨ha hy, Y.basicOpen_le a hy⟩)
    exact Ideal.map_mono (hGN' i) (hGgen i (Ideal.mem_map_of_mem _ hk))
  set J := Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk N')) ≫ V.2.fromSpec)
    with hJ
  have hJV : J.ideal V = N' := L4 N'
  have hKJ : ∀ W : Y.affineOpens, (W : Set Y) ⊆ O → K.ideal W ≤ J.ideal W := by
    intro W hW g hg
    refine L5 N' hJV.ge W g (fun a hle => ?_)
    have hAW : Y.affineBasicOpen a ≤ W := hle
    have h1 : (Y.presheaf.map (homOfLE hAW).op).hom g ∈ K.ideal (Y.affineBasicOpen a) := by
      rw [← K.map_ideal hAW]; exact Ideal.mem_map_of_mem _ hg
    rw [← K.map_ideal_basicOpen V a] at h1
    exact hP a (fun y hy => hW (hle hy)) h1
  refine ⟨K ⊓ J, inf_le_left, fun W hW => ?_, ?_, ?_⟩
  · rw [Scheme.IdealSheafData.ideal_inf, Pi.inf_apply]
    exact inf_eq_left.mpr (hKJ W hW)
  · rw [Scheme.IdealSheafData.ideal_inf, Pi.inf_apply, hJV]
    exact le_inf hN₀K hN₀N'
  · rintro x (hxO | hxV)
    · obtain ⟨U, hxU, hU⟩ := hK x hxO
      obtain ⟨f, hfO, hxf⟩ := U.2.exists_basicOpen_le (V := ⟨O, hO⟩) ⟨x, hxO⟩ hxU
      refine ⟨Y.affineBasicOpen f, hxf, ?_⟩
      have hWO : ((Y.affineBasicOpen f : Y.affineOpens) : Set Y) ⊆ O := fun y hy => hfO hy
      rw [Scheme.IdealSheafData.ideal_inf, Pi.inf_apply, inf_eq_left.mpr (hKJ _ hWO),
        ← K.map_ideal_basicOpen U f]
      exact hU.map _
    · refine ⟨V, hxV, ?_⟩
      rw [Scheme.IdealSheafData.ideal_inf, Pi.inf_apply, hJV, inf_eq_right.mpr hN'K]
      exact hN'FG

theorem wc_idealSheaf_fg_of_locally_fg : ∀ (Y : Scheme.{u}) (K : Y.IdealSheafData) (U : Y.affineOpens), (∀ x ∈ (U : Set Y), ∃ U' : Y.affineOpens, x ∈ (U' : Set Y) ∧ (K.ideal U').FG) → (K.ideal U).FG :=
by
  intro Y K U hloc
  classical
  let t : Set Γ(Y, U) := {f | (K.ideal (Y.affineBasicOpen f)).FG}
  have hspan : Ideal.span t = ⊤ := by
    rw [← U.2.self_le_iSup_basicOpen_iff]
    intro x hx
    obtain ⟨U', hxU', hFG⟩ := hloc x hx
    obtain ⟨f, g, hfg, hxf⟩ := exists_basicOpen_le_affine_inter U.2 U'.2 x ⟨hx, hxU'⟩
    have hg : (K.ideal (Y.affineBasicOpen g)).FG := by
      rw [← K.map_ideal_basicOpen U' g]
      exact hFG.map _
    have hA : Y.affineBasicOpen f = Y.affineBasicOpen g := Subtype.ext (by simpa using hfg)
    have hf : f ∈ t := by
      show (K.ideal (Y.affineBasicOpen f)).FG
      rw [hA]; exact hg
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨f, hf⟩, hxf⟩
  refine Ideal.fg_of_localizationSpan t hspan ?_
  rintro ⟨g, hg⟩
  haveI := U.2.isLocalization_basicOpen g
  let e := IsLocalization.algEquiv (Submonoid.powers g) Γ(Y, Y.basicOpen g) (Localization.Away g)
  have hcomp : algebraMap Γ(Y, U) (Localization.Away g) =
      (e : Γ(Y, Y.basicOpen g) →+* Localization.Away g).comp
        (algebraMap Γ(Y, U) Γ(Y, Y.basicOpen g)) := by
    ext r
    exact (e.commutes r).symm
  have h2 : Ideal.map (algebraMap Γ(Y, U) Γ(Y, Y.basicOpen g)) (K.ideal U) =
      K.ideal (Y.affineBasicOpen g) := K.map_ideal_basicOpen U g
  rw [hcomp, ← Ideal.map_map, h2]
  exact Ideal.FG.map hg _

theorem wc_subschemeι_lfp_of_fg : ∀ (Y : Scheme.{u}) (K : Y.IdealSheafData), (∀ U : Y.affineOpens, (K.ideal U).FG) → LocallyOfFinitePresentation K.subschemeι :=
by
  intro Y K hK
  have hstab : RingHom.StableUnderCompositionWithLocalizationAwaySource
      RingHom.FinitePresentation :=
    (RingHom.finitePresentation_stableUnderComposition.stableUnderCompositionWithLocalizationAway
      RingHom.finitePresentation_holdsForLocalizationAway).left
  rw [HasRingHomProperty.iff_exists_appLE (P := @LocallyOfFinitePresentation) hstab]
  intro x
  obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset
    (U := (⊤ : Y.Opens)) (x := K.subschemeι x) trivial
  let U₀ : Y.affineOpens := ⟨W, hW⟩
  let V₀ : K.subscheme.affineOpens := ⟨K.subschemeι ⁻¹ᵁ W, hW.preimage K.subschemeι⟩
  refine ⟨U₀, V₀, hxW, le_rfl, ?_⟩
  have hker : RingHom.ker (K.subschemeι.app W).hom = K.ideal U₀ := by
    rw [← Scheme.Hom.ker_apply K.subschemeι U₀, Scheme.IdealSheafData.ker_subschemeι]
  show RingHom.FinitePresentation (K.subschemeι.appLE W (K.subschemeι ⁻¹ᵁ W) le_rfl).hom
  rw [Scheme.Hom.appLE_eq_app]
  exact RingHom.FinitePresentation.of_surjective _ (K.subschemeι_app_surjective U₀)
    (hker ▸ hK U₀)

theorem wc_ap_two_fp_closed_hulls_immersion : ∀ (A : Type u) [CommRing A] (V O₁ O₂ : Scheme.{u}) (h₁ : O₁ ⟶ Spec (.of A)) (h₂ : O₂ ⟶ Spec (.of A)) [QuasiCompact h₁] [QuasiSeparated h₁] [LocallyOfFinitePresentation h₁] [QuasiCompact h₂] [QuasiSeparated h₂] [LocallyOfFinitePresentation h₂] (j₁ : V ⟶ O₁) (j₂ : V ⟶ O₂) [IsClosedImmersion j₁] [IsClosedImmersion j₂], j₁ ≫ h₁ = j₂ ≫ h₂ → ∃ (X : Scheme.{u}) (x₁ : X ⟶ O₁) (v : V ⟶ X) (g : X ⟶ O₂), IsClosedImmersion x₁ ∧ LocallyOfFinitePresentation x₁ ∧ IsImmersion g ∧ v ≫ x₁ = j₁ ∧ v ≫ g = j₂ ∧ g ≫ h₂ = x₁ ≫ h₁ :=
by
  intro A _ V O₁ O₂ h₁ h₂ _ _ _ _ _ _ j₁ j₂ _ _ hj
  classical

  have s1 : ∀ (Y : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y] (K : Y.IdealSheafData)
      (U : Y.affineOpens) (f : Γ(Y, U)), f ∈ K.ideal U → ∃ J : Y.IdealSheafData, J ≤ K ∧
      (∀ U' : Y.affineOpens, (J.ideal U').FG) ∧ f ∈ J.ideal U := by
    intro Y _ _ K U f hf
    have hQ : ∀ s : Finset Y.affineOpens, ∃ K' : Y.IdealSheafData, K' ≤ K ∧ f ∈ K'.ideal U ∧
        ∀ x ∈ (U : Set Y) ∪ ⋃ W ∈ s, (W : Set Y), ∃ U' : Y.affineOpens, x ∈ (U' : Set Y) ∧
          (K'.ideal U').FG := by
      intro s
      induction s using Finset.induction_on with
      | empty =>
        obtain ⟨K₀, hK₀, -, hN, hfg⟩ := wc_idealSheaf_fg_extension Y K ∅ isOpen_empty
          isCompact_empty (fun x hx => by simp at hx) U (Ideal.span {f})
          (Submodule.fg_span_singleton f) ((Ideal.span_singleton_le_iff_mem _).mpr hf)
        refine ⟨K₀, hK₀, hN (Ideal.mem_span_singleton_self f), fun x hx => hfg x ?_⟩
        simpa using hx
      | insert W s hWs ih =>
        obtain ⟨Ks, hKs, hfs, hfgs⟩ := ih
        have hOo : IsOpen ((U : Set Y) ∪ ⋃ W' ∈ s, (W' : Set Y)) :=
          U.1.isOpen.union (isOpen_biUnion fun W' _ => W'.1.isOpen)
        have hOc : IsCompact ((U : Set Y) ∪ ⋃ W' ∈ s, (W' : Set Y)) :=
          (IsAffineOpen.isCompact U.2).union
            (s.isCompact_biUnion fun W' _ => IsAffineOpen.isCompact W'.2)
        obtain ⟨K'', hK'', hpres, -, hfg''⟩ :=
          wc_idealSheaf_fg_extension Y Ks _ hOo hOc hfgs W ⊥ Submodule.fg_bot bot_le
        refine ⟨K'', hK''.trans hKs, ?_, ?_⟩
        · rw [hpres U Set.subset_union_left]; exact hfs
        · intro x hx
          apply hfg'' x
          rcases hx with hx | hx
          · exact Or.inl (Or.inl hx)
          · obtain ⟨W', hW', hxW'⟩ := Set.mem_iUnion₂.mp hx
            rcases Finset.mem_insert.mp hW' with rfl | hW's
            · exact Or.inr hxW'
            · exact Or.inl (Or.inr (Set.mem_iUnion₂.mpr ⟨W', hW's, hxW'⟩))
    have hcov : ∀ x : Y, ∃ W : Y.affineOpens, x ∈ (W : Set Y) := fun x => by
      obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := ⊤) trivial
      exact ⟨⟨W, hW⟩, hxW⟩
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun W : Y.affineOpens => (W : Set Y))
      (fun W => W.1.isOpen) (fun x _ => Set.mem_iUnion.mpr (hcov x))
    obtain ⟨K', hK', hfK', hfg⟩ := hQ t
    exact ⟨K', hK', fun U' => wc_idealSheaf_fg_of_locally_fg Y K' U'
      (fun x _ => hfg x (Or.inr (ht (Set.mem_univ x)))), hfK'⟩

  have s2 : ∀ (Y W : Scheme.{u}) (ι : W ⟶ Y) [IsClosedImmersion ι],
      (∀ (U : Y.affineOpens) (f : Γ(Y, U)), f ∈ (Scheme.Hom.ker ι).ideal U →
        ∃ J : Y.IdealSheafData, J ≤ Scheme.Hom.ker ι ∧ (∀ U' : Y.affineOpens, (J.ideal U').FG) ∧
          f ∈ J.ideal U) →
      ∃ (I : Type u) (_ : SmallCategory I) (_ : IsCofiltered I) (D : I ⥤ Scheme.{u})
        (c : Limits.Cone D) (_ : Limits.IsLimit c) (z : ∀ i, D.obj i ⟶ Y) (e : c.pt ≅ W),
        (∀ {i j : I} (f : i ⟶ j), IsClosedImmersion (D.map f)) ∧
        (∀ i, IsClosedImmersion (z i)) ∧ (∀ i, LocallyOfFinitePresentation (z i)) ∧
        (∀ {i j : I} (f : i ⟶ j), D.map f ≫ z j = z i) ∧ ∀ i, c.π.app i ≫ z i = e.hom ≫ ι := by
    intro Y W ι _ H
    let P := {J : Y.IdealSheafData // J ≤ Scheme.Hom.ker ι ∧ ∀ U : Y.affineOpens, (J.ideal U).FG}
    let b0 : P := ⟨⊥, bot_le, fun U => by
      rw [Scheme.IdealSheafData.ideal_bot]; exact Submodule.fg_bot⟩
    haveI : Nonempty P := ⟨b0⟩
    haveI : IsDirectedOrder P := ⟨fun a b => ⟨⟨a.1 ⊔ b.1, sup_le a.2.1 b.2.1, fun U => by
      rw [Scheme.IdealSheafData.ideal_sup]; exact Submodule.FG.sup (a.2.2 U) (b.2.2 U)⟩,
      (le_sup_left : a.1 ≤ a.1 ⊔ b.1), (le_sup_right : b.1 ≤ a.1 ⊔ b.1)⟩⟩
    haveI : IsFiltered P := isFiltered_of_directed_le_nonempty P
    haveI : IsCofiltered Pᵒᵖ := isCofiltered_op_of_isFiltered P
    let D : Pᵒᵖ ⥤ Scheme.{u} :=
      { obj := fun a => a.unop.1.subscheme
        map := fun {a b} f => Scheme.IdealSheafData.inclusion (leOfHom f.unop)
        map_id := fun a => Scheme.IdealSheafData.inclusion_id _
        map_comp := fun f g => (Scheme.IdealSheafData.inclusion_comp _ _).symm }
    let z : ∀ a : Pᵒᵖ, D.obj a ⟶ Y := fun a => a.unop.1.subschemeι
    have hzD : ∀ {a b : Pᵒᵖ} (f : a ⟶ b), D.map f ≫ z b = z a := fun f =>
      Scheme.IdealSheafData.inclusion_subschemeι _
    have hker : ∀ a : Pᵒᵖ, Scheme.Hom.ker (z a) ≤ Scheme.Hom.ker ι := fun a => by
      show Scheme.Hom.ker a.unop.1.subschemeι ≤ _
      rw [Scheme.IdealSheafData.ker_subschemeι]; exact a.unop.2.1
    let π : ∀ a : Pᵒᵖ, W ⟶ D.obj a := fun a => IsClosedImmersion.lift (z a) ι (hker a)
    have hπ : ∀ a, π a ≫ z a = ι := fun a => IsClosedImmersion.lift_fac _ _ _
    let c : Limits.Cone D :=
      { pt := W
        π := { app := π
               naturality := fun a b f => by
                 rw [← cancel_mono (z b)]
                 simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.id_comp,
                   Category.assoc]
                 rw [hzD, hπ, hπ] } }
    let gS : ∀ s : Limits.Cone D, s.pt ⟶ Y := fun s =>
      s.π.app (Opposite.op b0) ≫ z (Opposite.op b0)
    have hs : ∀ (s : Limits.Cone D) (a : Pᵒᵖ), s.π.app a ≫ z a = gS s := by
      intro s a
      have hle : b0 ≤ a.unop := show (⊥ : Y.IdealSheafData) ≤ a.unop.1 from bot_le
      let f : a ⟶ Opposite.op b0 := (homOfLE hle).op
      rw [← hzD f, ← Category.assoc, s.w f]
    have hkerg : ∀ s : Limits.Cone D, Scheme.Hom.ker ι ≤ Scheme.Hom.ker (gS s) := by
      intro s
      rw [Scheme.IdealSheafData.le_def]
      intro U f hf
      obtain ⟨J, hJ, hJfg, hfJ⟩ := H U f hf
      let a : P := ⟨J, hJ, hJfg⟩
      have hle : J ≤ Scheme.Hom.ker (gS s) := by
        rw [← hs s (Opposite.op a)]
        calc J = Scheme.Hom.ker (z (Opposite.op a)) :=
              (Scheme.IdealSheafData.ker_subschemeι J).symm
          _ ≤ _ := Scheme.Hom.le_ker_comp _ _
      exact Scheme.IdealSheafData.le_def.mp hle U hfJ
    have hc : Limits.IsLimit c :=
      { lift := fun s => IsClosedImmersion.lift ι (gS s) (hkerg s)
        fac := fun s a => by
          rw [← cancel_mono (z a)]
          show (IsClosedImmersion.lift ι (gS s) (hkerg s) ≫ π a) ≫ z a = _
          rw [Category.assoc, hπ, IsClosedImmersion.lift_fac, hs]
        uniq := fun s m hm => by
          rw [← cancel_mono ι, IsClosedImmersion.lift_fac]
          have h0 := hm (Opposite.op b0)
          show m ≫ ι = s.π.app (Opposite.op b0) ≫ z (Opposite.op b0)
          rw [← h0, Category.assoc]
          show m ≫ ι = m ≫ (π _ ≫ z _)
          rw [hπ] }
    refine ⟨Pᵒᵖ, inferInstance, inferInstance, D, c, hc, z, Iso.refl W, fun f => ?_, fun a => ?_,
      fun a => ?_, fun f => hzD f, fun a => ?_⟩
    · show IsClosedImmersion (Scheme.IdealSheafData.inclusion _); infer_instance
    · show IsClosedImmersion a.unop.1.subschemeι; infer_instance
    · exact wc_subschemeι_lfp_of_fg Y a.unop.1 a.unop.2.2
    · show π a ≫ z a = 𝟙 W ≫ ι
      rw [hπ, Category.id_comp]
  haveI : CompactSpace O₁ := QuasiCompact.compactSpace_of_compactSpace h₁
  haveI : QuasiSeparatedSpace O₁ := quasiSeparatedSpace_of_quasiSeparated h₁
  haveI : CompactSpace O₂ := QuasiCompact.compactSpace_of_compactSpace h₂
  haveI : QuasiSeparatedSpace O₂ := quasiSeparatedSpace_of_quasiSeparated h₂

  have s3 : ∀ (I₁ : Type u) [SmallCategory I₁] [IsCofiltered I₁] (D₁ : I₁ ⥤ Scheme.{u})
      (c₁ : Limits.Cone D₁) (hc₁ : Limits.IsLimit c₁) (z₁ : ∀ i, D₁.obj i ⟶ O₁) (e₁ : c₁.pt ≅ V)
      (I₂ : Type u) [SmallCategory I₂] [IsCofiltered I₂] (D₂ : I₂ ⥤ Scheme.{u})
      (c₂ : Limits.Cone D₂) (hc₂ : Limits.IsLimit c₂) (z₂ : ∀ i, D₂.obj i ⟶ O₂) (e₂ : c₂.pt ≅ V),
      (∀ {i j : I₁} (f : i ⟶ j), IsClosedImmersion (D₁.map f)) →
      (∀ {i j : I₂} (f : i ⟶ j), IsClosedImmersion (D₂.map f)) →
      (∀ i, IsClosedImmersion (z₁ i)) → (∀ i, LocallyOfFinitePresentation (z₁ i)) →
      (∀ i, IsClosedImmersion (z₂ i)) → (∀ i, LocallyOfFinitePresentation (z₂ i)) →
      (∀ {i j : I₁} (f : i ⟶ j), D₁.map f ≫ z₁ j = z₁ i) →
      (∀ {i j : I₂} (f : i ⟶ j), D₂.map f ≫ z₂ j = z₂ i) →
      (∀ i, c₁.π.app i ≫ z₁ i = e₁.hom ≫ j₁) → (∀ i, c₂.π.app i ≫ z₂ i = e₂.hom ≫ j₂) →
      ∃ (X : Scheme.{u}) (x₁ : X ⟶ O₁) (v : V ⟶ X) (g : X ⟶ O₂), IsClosedImmersion x₁ ∧
        LocallyOfFinitePresentation x₁ ∧ IsImmersion g ∧ v ≫ x₁ = j₁ ∧ v ≫ g = j₂ ∧
        g ≫ h₂ = x₁ ≫ h₁ := by
    intro I₁ _ _ D₁ c₁ hc₁ z₁ e₁ I₂ _ _ D₂ c₂ hc₂ z₂ e₂ hD₁ hD₂ hzc₁ hzl₁ hzc₂ hzl₂ hcmp₁ hcmp₂
      hcone₁ hcone₂
    haveI : ∀ i, CompactSpace (D₁.obj i) := fun i => by
      haveI := hzc₁ i; exact QuasiCompact.compactSpace_of_compactSpace (z₁ i)
    haveI : ∀ i, QuasiSeparatedSpace (D₁.obj i) := fun i => by
      haveI := hzc₁ i; exact quasiSeparatedSpace_of_quasiSeparated (z₁ i)
    haveI : ∀ i, CompactSpace (D₂.obj i) := fun i => by
      haveI := hzc₂ i; exact QuasiCompact.compactSpace_of_compactSpace (z₂ i)
    haveI : ∀ i, QuasiSeparatedSpace (D₂.obj i) := fun i => by
      haveI := hzc₂ i; exact quasiSeparatedSpace_of_quasiSeparated (z₂ i)
    haveI : ∀ {i j : I₁} (f : i ⟶ j), IsAffineHom (D₁.map f) := fun f => by
      haveI := hD₁ f; infer_instance
    haveI : ∀ {i j : I₂} (f : i ⟶ j), IsAffineHom (D₂.map f) := fun f => by
      haveI := hD₂ f; infer_instance
    have lfp1 : ∀ i, LocallyOfFinitePresentation (z₁ i ≫ h₁) := fun i => by
      haveI := hzl₁ i; infer_instance
    have lfp2 : ∀ i, LocallyOfFinitePresentation (z₂ i ≫ h₂) := fun i => by
      haveI := hzl₂ i; infer_instance
    let t₁ : D₁ ⟶ (Functor.const I₁).obj (Spec (.of A)) :=
      { app := fun i => z₁ i ≫ h₁
        naturality := fun i j f => by
          simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id]
          rw [← Category.assoc, hcmp₁] }
    let t₂ : D₂ ⟶ (Functor.const I₂).obj (Spec (.of A)) :=
      { app := fun i => z₂ i ≫ h₂
        naturality := fun i j f => by
          simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.comp_id]
          rw [← Category.assoc, hcmp₂] }

    obtain ⟨i₀⟩ := IsCofiltered.nonempty (C := I₁)
    haveI := lfp1 i₀
    obtain ⟨k₁, φ, hA1, hA2⟩ := Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation D₂ t₂
      (z₁ i₀ ≫ h₁) c₂ hc₂ (e₂.hom ≫ e₁.inv ≫ c₁.π.app i₀) (by
        ext k
        simp only [NatTrans.comp_app, Functor.const_obj_obj, Functor.const_map_app]
        show c₂.π.app k ≫ z₂ k ≫ h₂ = (e₂.hom ≫ e₁.inv ≫ c₁.π.app i₀) ≫ z₁ i₀ ≫ h₁
        rw [← Category.assoc, hcone₂]
        simp only [Category.assoc]
        rw [← Category.assoc (c₁.π.app i₀), hcone₁]
        simp only [Category.assoc, Iso.inv_hom_id_assoc]
        rw [hj])

    haveI := lfp2 k₁
    obtain ⟨i₁, ψ, hB1, hB2⟩ := Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation D₁ t₁
      (z₂ k₁ ≫ h₂) c₁ hc₁ (e₁.hom ≫ e₂.inv ≫ c₂.π.app k₁) (by
        ext i
        simp only [NatTrans.comp_app, Functor.const_obj_obj, Functor.const_map_app]
        show c₁.π.app i ≫ z₁ i ≫ h₁ = (e₁.hom ≫ e₂.inv ≫ c₂.π.app k₁) ≫ z₂ k₁ ≫ h₂
        rw [← Category.assoc, hcone₁]
        simp only [Category.assoc]
        rw [← Category.assoc (c₂.π.app k₁), hcone₂]
        simp only [Category.assoc, Iso.inv_hom_id_assoc]
        rw [hj])

    let i₃ := IsCofiltered.min i₁ i₀
    let p : i₃ ⟶ i₁ := IsCofiltered.minToLeft i₁ i₀
    let q : i₃ ⟶ i₀ := IsCofiltered.minToRight i₁ i₀
    have hC2 : (D₁.map p ≫ ψ) ≫ z₂ k₁ ≫ h₂ = z₁ i₃ ≫ h₁ := by
      rw [Category.assoc, hB2]
      show D₁.map p ≫ z₁ i₁ ≫ h₁ = _
      rw [← Category.assoc, hcmp₁]

    obtain ⟨i₂, r, hD⟩ := Scheme.exists_hom_comp_eq_comp_of_locallyOfFiniteType D₁ t₁
      (z₁ i₀ ≫ h₁) c₁ hc₁ (i := i₃) ((D₁.map p ≫ ψ) ≫ φ) (D₁.map q)
      (by
        show z₁ i₃ ≫ h₁ = ((D₁.map p ≫ ψ) ≫ φ) ≫ z₁ i₀ ≫ h₁
        rw [Category.assoc, hA2]; exact hC2.symm)
      (by
        show z₁ i₃ ≫ h₁ = D₁.map q ≫ z₁ i₀ ≫ h₁
        rw [← Category.assoc, hcmp₁])
      (by
        rw [c₁.w q]
        simp only [Category.assoc]
        rw [c₁.w_assoc p, ← Category.assoc (c₁.π.app i₁), hB1]
        simp only [Category.assoc]
        rw [hA1, Iso.inv_hom_id_assoc, Iso.hom_inv_id_assoc])

    haveI := hzc₁ i₂
    haveI := hzl₁ i₂
    haveI := hzc₂ k₁
    have hround : (D₁.map r ≫ D₁.map p ≫ ψ) ≫ φ = D₁.map (r ≫ q) := by
      rw [Category.assoc, hD, Functor.map_comp]
    haveI : IsClosedImmersion (D₁.map (r ≫ q)) := hD₁ _
    haveI : IsImmersion ((D₁.map r ≫ D₁.map p ≫ ψ) ≫ φ) := by rw [hround]; infer_instance
    haveI : IsImmersion (D₁.map r ≫ D₁.map p ≫ ψ) := IsImmersion.of_comp _ φ
    refine ⟨D₁.obj i₂, z₁ i₂, e₁.inv ≫ c₁.π.app i₂, (D₁.map r ≫ D₁.map p ≫ ψ) ≫ z₂ k₁,
      inferInstance, inferInstance, inferInstance, ?_, ?_, ?_⟩
    · rw [Category.assoc, hcone₁, Iso.inv_hom_id_assoc]
    · simp only [Category.assoc]
      rw [c₁.w_assoc r, c₁.w_assoc p, ← Category.assoc (c₁.π.app i₁) ψ, hB1]
      simp only [Category.assoc]
      rw [hcone₂, Iso.inv_hom_id_assoc, Iso.inv_hom_id_assoc]
    · simp only [Category.assoc]
      rw [hB2]
      show D₁.map r ≫ D₁.map p ≫ z₁ i₁ ≫ h₁ = z₁ i₂ ≫ h₁
      rw [← Category.assoc (D₁.map p), hcmp₁, ← Category.assoc, hcmp₁]

  obtain ⟨I₁, _, _, D₁, c₁, hc₁, z₁, e₁, hD₁, hzc₁, hzl₁, hcmp₁, hcone₁⟩ :=
    s2 O₁ V j₁ (fun U f hf => s1 O₁ _ U f hf)
  obtain ⟨I₂, _, _, D₂, c₂, hc₂, z₂, e₂, hD₂, hzc₂, hzl₂, hcmp₂, hcone₂⟩ :=
    s2 O₂ V j₂ (fun U f hf => s1 O₂ _ U f hf)
  exact s3 I₁ D₁ c₁ hc₁ z₁ e₁ I₂ D₂ c₂ hc₂ z₂ e₂ hD₁ hD₂ hzc₁ hzl₁ hzc₂ hzl₂ hcmp₁ hcmp₂
    hcone₁ hcone₂

theorem wc_ap_fp_closed_extend_from_compact_open : ∀ (Y W : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y] (ι : W ⟶ Y) [IsClosedImmersion ι] (O : Y.Opens), IsCompact (O : Set Y) → ∀ (Z : Scheme.{u}) (z : Z ⟶ (O : Scheme.{u})) [IsClosedImmersion z] [LocallyOfFinitePresentation z] (V : Scheme.{u}) (jV : V ⟶ W) [IsOpenImmersion jV] (a : V ⟶ Z), Set.range jV = ι ⁻¹' (O : Set Y) → a ≫ z ≫ O.ι = jV ≫ ι → ∃ (Z' : Scheme.{u}) (z' : Z' ⟶ Y) (κ : W ⟶ Z') (e : (z' ⁻¹ᵁ O : Scheme.{u}) ≅ Z), IsClosedImmersion z' ∧ LocallyOfFinitePresentation z' ∧ κ ≫ z' = ι ∧ e.hom ≫ z ≫ O.ι = (z' ⁻¹ᵁ O).ι ≫ z' :=
by
  intro Y W _ _ ι _ O hOc Z z _ _ V jV _ a hrange hcomm
  classical
  haveI : CompactSpace (O : Scheme.{u}) := isCompact_iff_compactSpace.mp hOc
  haveI : QuasiCompact O.ι := quasiCompact_of_compactSpace O.ι

  have s1 : ∀ (X' X Y' : Scheme.{u}) (j : X' ⟶ X) [IsOpenImmersion j] (g : X ⟶ Y')
      [QuasiCompact g] [QuasiCompact (j ≫ g)] (U : Y'.affineOpens),
      g ⁻¹ᵁ (U : Y'.Opens) ≤ j.opensRange → (j ≫ g).ker.ideal U = g.ker.ideal U := by
    intro X' X Y' j _ g _ _ U hU
    rw [Scheme.Hom.ker_apply, Scheme.Hom.ker_apply]
    change RingHom.ker ((j.app (g ⁻¹ᵁ (U : Y'.Opens))).hom.comp (g.app (U : Y'.Opens)).hom) = _
    haveI := Scheme.Hom.isIso_app j _ hU
    exact RingHom.ker_comp_of_injective _
      (ConcreteCategory.bijective_of_isIso (j.app (g ⁻¹ᵁ (U : Y'.Opens)))).1

  have s2 : ∀ (X₁ X₂ : Scheme.{u}) (g₁ : X₁ ⟶ (O : Scheme.{u})) (g₂ : X₂ ⟶ (O : Scheme.{u}))
      [QuasiCompact g₁] [QuasiCompact g₂] [QuasiCompact (g₁ ≫ O.ι)] [QuasiCompact (g₂ ≫ O.ι)],
      (∀ U : Y.affineOpens, (U : Set Y) ⊆ (O : Set Y) →
        (g₁ ≫ O.ι).ker.ideal U = (g₂ ≫ O.ι).ker.ideal U) → g₁.ker = g₂.ker := by
    intro X₁ X₂ g₁ g₂ _ _ _ _ H
    have key : ∀ (U : Y.affineOpens) (V' : (O : Scheme.{u}).Opens) (hV' : IsAffineOpen V'),
        V' = O.ι ⁻¹ᵁ (U : Y.Opens) → (U : Set Y) ⊆ (O : Set Y) →
        g₁.ker.ideal ⟨V', hV'⟩ = g₂.ker.ideal ⟨V', hV'⟩ := by
      intro U V' hV' hE hUO
      have h := H U hUO
      rw [Scheme.Hom.ker_apply, Scheme.Hom.ker_apply] at h
      change RingHom.ker ((g₁.app (O.ι ⁻¹ᵁ (U : Y.Opens))).hom.comp (O.ι.app (U : Y.Opens)).hom) =
        RingHom.ker ((g₂.app (O.ι ⁻¹ᵁ (U : Y.Opens))).hom.comp (O.ι.app (U : Y.Opens)).hom) at h
      rw [← RingHom.comap_ker, ← RingHom.comap_ker] at h
      have hUO' : (U : Y.Opens) ≤ O.ι.opensRange := by
        rw [Scheme.Opens.opensRange_ι]; exact fun x hx => hUO hx
      haveI := Scheme.Hom.isIso_app O.ι _ hUO'
      have hsurj := (ConcreteCategory.bijective_of_isIso (O.ι.app (U : Y.Opens))).2
      rw [Scheme.Hom.ker_apply, Scheme.Hom.ker_apply]
      subst hE
      exact Ideal.comap_injective_of_surjective _ hsurj h
    apply Scheme.IdealSheafData.ext
    funext U'
    obtain ⟨U', hU'⟩ := U'
    exact key ⟨O.ι ''ᵁ U', hU'.image_of_isOpenImmersion O.ι⟩ U' hU'
      (Scheme.Hom.preimage_image_eq _ _).symm (fun x hx => Scheme.Opens.ι_image_le O U' hx)

  have s3 : ∀ U : Y.affineOpens, (U : Set Y) ⊆ (O : Set Y) → ((z ≫ O.ι).ker.ideal U).FG := by
    intro U hUO
    have hUO' : (U : Y.Opens) ≤ O.ι.opensRange := by
      rw [Scheme.Opens.opensRange_ι]; exact fun x hx => hUO hx
    have hU' : IsAffineOpen (O.ι ⁻¹ᵁ (U : Y.Opens)) := U.2.preimage_of_isOpenImmersion O.ι hUO'
    rw [Scheme.Hom.ker_apply]
    change (RingHom.ker ((z.app (O.ι ⁻¹ᵁ (U : Y.Opens))).hom.comp (O.ι.app (U : Y.Opens)).hom)).FG
    rw [← RingHom.comap_ker]
    haveI := Scheme.Hom.isIso_app O.ι _ hUO'
    have hsurj : Function.Surjective (z.app (O.ι ⁻¹ᵁ (U : Y.Opens))).hom :=
      Scheme.Hom.app_surjective z _ hU'
    have hfp : (z.app (O.ι ⁻¹ᵁ (U : Y.Opens))).hom.FinitePresentation := by
      have := HasRingHomProperty.appLE (P := @LocallyOfFinitePresentation) z inferInstance
        ⟨_, hU'⟩ ⟨z ⁻¹ᵁ (O.ι ⁻¹ᵁ (U : Y.Opens)), hU'.preimage z⟩ le_rfl
      rw [Scheme.Hom.app_eq_appLE]; exact this
    have hker : (RingHom.ker (z.app (O.ι ⁻¹ᵁ (U : Y.Opens))).hom).FG := by
      letI := (z.app (O.ι ⁻¹ᵁ (U : Y.Opens))).hom.toAlgebra
      haveI : Algebra.FinitePresentation Γ((O : Scheme.{u}), O.ι ⁻¹ᵁ (U : Y.Opens))
          Γ(Z, z ⁻¹ᵁ (O.ι ⁻¹ᵁ (U : Y.Opens))) := hfp
      exact Algebra.FinitePresentation.ker_fG_of_surjective (Algebra.ofId _ _) hsurj
    let e : Γ(Y, (U : Y.Opens)) ≃+* Γ((O : Scheme.{u}), O.ι ⁻¹ᵁ (U : Y.Opens)) :=
      (asIso (O.ι.app (U : Y.Opens))).commRingCatIsoToRingEquiv
    have h1 : Ideal.comap e.symm.symm (RingHom.ker (z.app (O.ι ⁻¹ᵁ (U : Y.Opens))).hom) =
        Ideal.map e.symm (RingHom.ker (z.app (O.ι ⁻¹ᵁ (U : Y.Opens))).hom) :=
      Ideal.comap_symm e.symm
    have h2 : Ideal.comap (O.ι.app (U : Y.Opens)).hom
        (RingHom.ker (z.app (O.ι ⁻¹ᵁ (U : Y.Opens))).hom) =
        Ideal.comap e.symm.symm (RingHom.ker (z.app (O.ι ⁻¹ᵁ (U : Y.Opens))).hom) := rfl
    rw [h2, h1]
    exact hker.map (e.symm : Γ((O : Scheme.{u}), O.ι ⁻¹ᵁ (U : Y.Opens)) →+* Γ(Y, (U : Y.Opens)))

  have s4 : ∀ (K : Y.IdealSheafData), (∀ x ∈ (O : Set Y), ∃ U : Y.affineOpens,
      x ∈ (U : Set Y) ∧ (K.ideal U).FG) → ∃ K' : Y.IdealSheafData, K' ≤ K ∧
      (∀ W₀ : Y.affineOpens, (W₀ : Set Y) ⊆ (O : Set Y) → K'.ideal W₀ = K.ideal W₀) ∧
      ∀ U : Y.affineOpens, (K'.ideal U).FG := by
    intro K hK
    obtain ⟨S₀, hS₀⟩ := isCompact_univ.elim_finite_subcover
      (fun W' : Y.affineOpens => ((W' : Y.Opens) : Set Y)) (fun W' => (W' : Y.Opens).isOpen) (by
        intro x _
        obtain ⟨W', hW', hxW', -⟩ :=
          exists_isAffineOpen_mem_and_subset (X := Y) (U := ⊤) (x := x) trivial
        exact Set.mem_iUnion.mpr ⟨⟨W', hW'⟩, hxW'⟩)
    have key : ∀ S : Finset Y.affineOpens, ∃ K' : Y.IdealSheafData, K' ≤ K ∧
        (∀ W₀ : Y.affineOpens, (W₀ : Set Y) ⊆ (O : Set Y) → K'.ideal W₀ = K.ideal W₀) ∧
        ∀ x ∈ (O : Set Y) ∪ ⋃ W' ∈ S, ((W' : Y.Opens) : Set Y),
          ∃ U : Y.affineOpens, x ∈ (U : Set Y) ∧ (K'.ideal U).FG := by
      intro S
      induction S using Finset.induction_on with
      | empty =>
        refine ⟨K, le_rfl, fun _ _ => rfl, ?_⟩
        intro x hx
        apply hK x
        simp only [Finset.notMem_empty, Set.iUnion_of_empty, Set.iUnion_empty,
          Set.union_empty] at hx
        exact hx
      | insert W' S hWS ih =>
        obtain ⟨KS, hKS, hagS, hloc⟩ := ih
        obtain ⟨K', hK'K, hagree, -, hloc'⟩ := wc_idealSheaf_fg_extension Y KS
          ((O : Set Y) ∪ ⋃ W'' ∈ S, ((W'' : Y.Opens) : Set Y))
          (O.isOpen.union (isOpen_biUnion fun W'' _ => (W'' : Y.Opens).isOpen))
          (hOc.union (S.isCompact_biUnion fun W'' _ => W''.2.isCompact)) hloc W' ⊥
          Submodule.fg_bot bot_le
        refine ⟨K', le_trans hK'K hKS, fun W₀ hW₀ =>
          (hagree W₀ (hW₀.trans Set.subset_union_left)).trans (hagS W₀ hW₀), ?_⟩
        intro x hx
        apply hloc' x
        rw [Finset.set_biUnion_insert] at hx
        rcases hx with h | h | h
        · exact Or.inl (Or.inl h)
        · exact Or.inr h
        · exact Or.inl (Or.inr h)
    obtain ⟨K', hK'K, hag, hloc⟩ := key S₀
    exact ⟨K', hK'K, hag, fun U => wc_idealSheaf_fg_of_locally_fg Y K' U
      (fun x _ => hloc x (Or.inr (hS₀ (Set.mem_univ x))))⟩

  have hVc : IsCompact (Set.range jV) := by
    rw [hrange]; exact QuasiCompact.isCompact_preimage _ O.isOpen hOc
  haveI : CompactSpace V := by
    rw [← isCompact_univ_iff]
    exact (jV.isOpenEmbedding.isInducing.isCompact_iff).mpr (by rw [Set.image_univ]; exact hVc)
  haveI : QuasiCompact (jV ≫ ι) := quasiCompact_of_compactSpace _

  have b1 : ∀ U : Y.affineOpens, (U : Set Y) ⊆ (O : Set Y) →
      (z ≫ O.ι).ker.ideal U ≤ ι.ker.ideal U := by
    intro U hUO
    have h1 := Scheme.Hom.le_ker_comp a (z ≫ O.ι)
    rw [hcomm] at h1
    have h2 : (jV ≫ ι).ker.ideal U = ι.ker.ideal U := s1 V W Y jV ι U (by
      intro x hx
      show x ∈ (jV.opensRange : Set W)
      rw [Scheme.Hom.coe_opensRange, hrange]
      show ι x ∈ (O : Set Y)
      exact hUO hx)
    rw [← h2]
    exact Scheme.IdealSheafData.le_def.mp h1 U
  have b2 : ∀ U : Y.affineOpens, (U : Set Y) ⊆ (O : Set Y) →
      (ι.ker ⊓ (z ≫ O.ι).ker).ideal U = (z ≫ O.ι).ker.ideal U := by
    intro U hUO
    rw [Scheme.IdealSheafData.ideal_inf, Pi.inf_apply]
    exact inf_eq_right.mpr (b1 U hUO)

  obtain ⟨K'', hK''J, hag, hfg⟩ := s4 (ι.ker ⊓ (z ≫ O.ι).ker) (by
    intro x hx
    obtain ⟨U₀, hU₀, hxU₀, hU₀O⟩ := exists_isAffineOpen_mem_and_subset (U := O) hx
    refine ⟨⟨U₀, hU₀⟩, hxU₀, ?_⟩
    rw [b2 ⟨U₀, hU₀⟩ hU₀O]
    exact s3 ⟨U₀, hU₀⟩ hU₀O)

  have hlfp : LocallyOfFinitePresentation K''.subschemeι := wc_subschemeι_lfp_of_fg Y K'' hfg
  have hker' : K''.subschemeι.ker = K'' := Scheme.IdealSheafData.ker_subschemeι K''
  have hle : K''.subschemeι.ker ≤ ι.ker := by
    rw [hker']; exact le_trans hK''J inf_le_left
  set z' := K''.subschemeι with hz'
  haveI : QuasiCompact ((z' ⁻¹ᵁ O).ι ≫ z') := by rw [← morphismRestrict_ι]; infer_instance

  have hker : (z' ∣_ O).ker = z.ker := by
    apply s2 _ _ (z' ∣_ O) z
    intro U hUO
    have hUO' : (U : Y.Opens) ≤ O := fun x hx => hUO hx
    rw [morphismRestrict_ι, s1 _ _ _ (z' ⁻¹ᵁ O).ι z' U (by
        rw [Scheme.Opens.opensRange_ι]; exact Scheme.Hom.preimage_mono z' hUO'),
      hker', hag U hUO, b2 U hUO]

  let e : (z' ⁻¹ᵁ O : Scheme.{u}) ≅ Z :=
    { hom := IsClosedImmersion.lift z (z' ∣_ O) (le_of_eq hker.symm)
      inv := IsClosedImmersion.lift (z' ∣_ O) z (le_of_eq hker)
      hom_inv_id := by
        rw [← cancel_mono (z' ∣_ O), Category.assoc, IsClosedImmersion.lift_fac,
          IsClosedImmersion.lift_fac, Category.id_comp]
      inv_hom_id := by
        rw [← cancel_mono z, Category.assoc, IsClosedImmersion.lift_fac,
          IsClosedImmersion.lift_fac, Category.id_comp] }
  have he : e.hom ≫ z = z' ∣_ O := IsClosedImmersion.lift_fac _ _ _
  refine ⟨K''.subscheme, z', IsClosedImmersion.lift z' ι hle, e, inferInstance, hlfp,
    IsClosedImmersion.lift_fac _ _ _, ?_⟩
  rw [← Category.assoc, he, morphismRestrict_ι]

theorem wc_ap_glue_closed_immersions_pushout : ∀ (A : Type u) [CommRing A] (R : Scheme.{u}) (g : R ⟶ Spec (.of A)) (W U : R.Opens) (Y₁ Y₂ M : Scheme.{u}) (h₁ : Y₁ ⟶ Spec (.of A)) (h₂ : Y₂ ⟶ Spec (.of A)) (p : M ⟶ Y₁) (q : M ⟶ Y₂) [IsOpenImmersion p] [IsOpenImmersion q] (i₁ : (W : Scheme.{u}) ⟶ Y₁) (i₂ : (U : Scheme.{u}) ⟶ Y₂) [IsClosedImmersion i₁] [IsClosedImmersion i₂] (n : ((W ⊓ U : R.Opens) : Scheme.{u}) ⟶ M) (w : p ≫ h₁ = q ≫ h₂), i₁ ≫ h₁ = W.ι ≫ g → i₂ ≫ h₂ = U.ι ≫ g → n ≫ p = R.homOfLE inf_le_left ≫ i₁ → n ≫ q = R.homOfLE inf_le_right ≫ i₂ → (∀ a : (W : Scheme.{u}), i₁ a ∈ Set.range p → W.ι a ∈ U) → (∀ b : (U : Scheme.{u}), i₂ b ∈ Set.range q → U.ι b ∈ W) → ∃ i : ((W ⊔ U : R.Opens) : Scheme.{u}) ⟶ Limits.pushout p q, IsClosedImmersion i ∧ i ≫ Limits.pushout.desc h₁ h₂ w = (W ⊔ U).ι ≫ g :=
by
  intro A _ R g W U Y₁ Y₂ M h₁ h₂ p q _ _ i₁ i₂ _ _ n w H1 H2 Hn1 Hn2 P1 P2

  have hι0 : Limits.colimit.ι (Limits.span p q) Limits.WalkingSpan.zero =
      p ≫ Limits.pushout.inl p q := by
    rw [← Limits.colimit.w (Limits.span p q) Limits.WalkingSpan.Hom.fst, Limits.span_map_fst]
  have hcover : ∀ x : ↥(Limits.pushout p q),
      x ∈ Set.range (Limits.pushout.inl p q) ∨ x ∈ Set.range (Limits.pushout.inr p q) := by
    intro x
    obtain ⟨i, xi, hx⟩ := Scheme.IsLocallyDirected.ι_jointly_surjective (Limits.span p q) x
    rcases i with _ | ⟨_ | _⟩
    · left
      refine ⟨p xi, ?_⟩
      rw [← hx]
      change _ = (Limits.colimit.ι (Limits.span p q) Limits.WalkingSpan.zero) xi
      rw [hι0, Scheme.Hom.comp_apply]
    · left
      exact ⟨xi, hx⟩
    · right
      exact ⟨xi, hx⟩
  have hover : ∀ (a : Y₁) (b : Y₂), Limits.pushout.inl p q a = Limits.pushout.inr p q b →
      ∃ z : M, p z = a ∧ q z = b := by
    intro a b hab
    obtain ⟨k, fi, fj, z, hz1, hz2⟩ :=
      (Scheme.IsLocallyDirected.ι_eq_ι_iff (Limits.span p q) (i := Limits.WalkingSpan.left)
        (j := Limits.WalkingSpan.right)).mp hab
    rcases k with _ | ⟨_ | _⟩
    · have hfi : fi = Limits.WalkingSpan.Hom.fst := Subsingleton.elim _ _
      have hfj : fj = Limits.WalkingSpan.Hom.snd := Subsingleton.elim _ _
      subst hfi hfj
      rw [Limits.span_map_fst] at hz1
      rw [Limits.span_map_snd] at hz2
      exact ⟨z, hz1, hz2⟩
    · obtain ⟨⟩ : Limits.WidePushoutShape.Hom (some Limits.WalkingPair.left)
        (some Limits.WalkingPair.right) := fj
    · obtain ⟨⟩ : Limits.WidePushoutShape.Hom (some Limits.WalkingPair.right)
        (some Limits.WalkingPair.left) := fi

  let jW : (W : Scheme.{u}) ⟶ ((W ⊔ U : R.Opens) : Scheme.{u}) := R.homOfLE le_sup_left
  let jU : (U : Scheme.{u}) ⟶ ((W ⊔ U : R.Opens) : Scheme.{u}) := R.homOfLE le_sup_right
  haveI hjWo : IsOpenImmersion jW := inferInstanceAs (IsOpenImmersion (R.homOfLE _))
  haveI hjUo : IsOpenImmersion jU := inferInstanceAs (IsOpenImmersion (R.homOfLE _))
  have hjWι : jW ≫ (W ⊔ U).ι = W.ι := Scheme.homOfLE_ι _ _
  have hjUι : jU ≫ (W ⊔ U).ι = U.ι := Scheme.homOfLE_ι _ _
  let obj : Bool → Scheme.{u} := fun b => cond b (W : Scheme.{u}) (U : Scheme.{u})
  let mp : (b : Bool) → obj b ⟶ ((W ⊔ U : R.Opens) : Scheme.{u}) := fun b =>
    match b with
    | true => jW
    | false => jU
  have hmp : ∀ b, IsOpenImmersion (mp b) := by
    intro b
    cases b
    · exact hjUo
    · exact hjWo
  have hsurj : ∀ x : ((W ⊔ U : R.Opens) : Scheme.{u}), ∃ (b : Bool) (y : obj b), mp b y = x := by
    intro x
    rcases TopologicalSpace.Opens.mem_sup.mp x.2 with h | h
    · exact ⟨true, ⟨x.1, h⟩, Subtype.ext (Scheme.homOfLE_apply _ _)⟩
    · exact ⟨false, ⟨x.1, h⟩, Subtype.ext (Scheme.homOfLE_apply _ _)⟩
  let 𝒰 : ((W ⊔ U : R.Opens) : Scheme.{u}).OpenCover :=
    Scheme.Cover.mkOfCovers Bool obj mp hsurj hmp

  have hc : R.homOfLE (inf_le_left : W ⊓ U ≤ W) ≫ i₁ ≫ Limits.pushout.inl p q =
      R.homOfLE (inf_le_right : W ⊓ U ≤ U) ≫ i₂ ≫ Limits.pushout.inr p q := by
    rw [← Category.assoc, ← Hn1, Category.assoc, Limits.pushout.condition, ← Category.assoc, Hn2,
      Category.assoc]
  have sq : IsPullback (R.homOfLE (inf_le_left : W ⊓ U ≤ W)) (R.homOfLE (inf_le_right : W ⊓ U ≤ U))
      jW jU := isPullback_opens_inf_le le_sup_left le_sup_right
  let F : (b : Bool) → 𝒰.X b ⟶ Limits.pushout p q := fun b =>
    match b with
    | true => i₁ ≫ Limits.pushout.inl p q
    | false => i₂ ≫ Limits.pushout.inr p q
  have hcompat : ∀ x y : 𝒰.I₀, Limits.pullback.fst (𝒰.f x) (𝒰.f y) ≫ F x =
      Limits.pullback.snd (𝒰.f x) (𝒰.f y) ≫ F y := by
    intro x y
    cases x <;> cases y
    · show Limits.pullback.fst jU jU ≫ i₂ ≫ Limits.pushout.inr p q =
        Limits.pullback.snd jU jU ≫ i₂ ≫ Limits.pushout.inr p q
      rw [Limits.fst_eq_snd_of_mono_eq]
    · show Limits.pullback.fst jU jW ≫ i₂ ≫ Limits.pushout.inr p q =
        Limits.pullback.snd jU jW ≫ i₁ ≫ Limits.pushout.inl p q
      rw [← cancel_epi sq.flip.isoPullback.hom]
      simp only [← Category.assoc, IsPullback.isoPullback_hom_fst, IsPullback.isoPullback_hom_snd]
      simpa only [Category.assoc] using hc.symm
    · show Limits.pullback.fst jW jU ≫ i₁ ≫ Limits.pushout.inl p q =
        Limits.pullback.snd jW jU ≫ i₂ ≫ Limits.pushout.inr p q
      rw [← cancel_epi sq.isoPullback.hom]
      simp only [← Category.assoc, IsPullback.isoPullback_hom_fst, IsPullback.isoPullback_hom_snd]
      simpa only [Category.assoc] using hc
    · show Limits.pullback.fst jW jW ≫ i₁ ≫ Limits.pushout.inl p q =
        Limits.pullback.snd jW jW ≫ i₁ ≫ Limits.pushout.inl p q
      rw [Limits.fst_eq_snd_of_mono_eq]
  let i : ((W ⊔ U : R.Opens) : Scheme.{u}) ⟶ Limits.pushout p q := 𝒰.glueMorphisms F hcompat
  have hW : jW ≫ i = i₁ ≫ Limits.pushout.inl p q := 𝒰.ι_glueMorphisms F hcompat true
  have hU : jU ≫ i = i₂ ≫ Limits.pushout.inr p q := 𝒰.ι_glueMorphisms F hcompat false

  have heq : i ≫ Limits.pushout.desc h₁ h₂ w = (W ⊔ U).ι ≫ g := by
    refine Scheme.Cover.hom_ext 𝒰 _ _ (fun b => ?_)
    cases b
    · show jU ≫ i ≫ Limits.pushout.desc h₁ h₂ w = jU ≫ (W ⊔ U).ι ≫ g
      rw [← Category.assoc, hU, Category.assoc, Limits.pushout.inr_desc, H2, ← Category.assoc,
        hjUι]
    · show jW ≫ i ≫ Limits.pushout.desc h₁ h₂ w = jW ≫ (W ⊔ U).ι ≫ g
      rw [← Category.assoc, hW, Category.assoc, Limits.pushout.inl_desc, H1, ← Category.assoc,
        hjWι]

  have crit : ∀ (Aₛ C : Scheme.{u}) (a : Aₛ ⟶ ((W ⊔ U : R.Opens) : Scheme.{u}))
      (c : C ⟶ Limits.pushout p q) [IsOpenImmersion a] [IsOpenImmersion c] (α : Aₛ ⟶ C)
      [IsClosedImmersion α], a ≫ i = α ≫ c → i ⁻¹' Set.range c ⊆ Set.range a →
      IsClosedImmersion (i ∣_ c.opensRange) := by
    intro Aₛ C a c _ _ α _ hfac hpre
    have hrange : Set.range a = Set.range (i ⁻¹ᵁ c.opensRange).ι := by
      rw [Scheme.Opens.range_ι, Scheme.Hom.coe_preimage, Scheme.Hom.coe_opensRange]
      apply Set.Subset.antisymm
      · rintro _ ⟨t, rfl⟩
        refine ⟨α t, ?_⟩
        rw [← Scheme.Hom.comp_apply, ← hfac, Scheme.Hom.comp_apply]
      · exact hpre
    let e := IsOpenImmersion.isoOfRangeEq a (i ⁻¹ᵁ c.opensRange).ι hrange
    have he : e.hom ≫ (i ⁻¹ᵁ c.opensRange).ι = a := IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _
    have key : i ∣_ c.opensRange = e.inv ≫ α ≫ c.isoOpensRange.hom := by
      rw [← cancel_mono c.opensRange.ι, morphismRestrict_ι, Category.assoc, Category.assoc,
        Scheme.Hom.isoOpensRange_hom_ι, ← hfac, ← he]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
    rw [key]
    infer_instance

  have hsplit : ∀ t : ((W ⊔ U : R.Opens) : Scheme.{u}), (∃ a, jW a = t) ∨ (∃ b, jU b = t) := by
    intro t
    obtain ⟨b, y, hy⟩ := hsurj t
    cases b
    · exact Or.inr ⟨y, hy⟩
    · exact Or.inl ⟨y, hy⟩
  have hUW : ∀ b : (U : Scheme.{u}), U.ι b ∈ W → ∃ a, jW a = jU b := by
    intro b hb
    refine ⟨⟨U.ι b, hb⟩, Subtype.ext ?_⟩
    exact (Scheme.homOfLE_apply _ _).trans
      ((Scheme.Opens.ι_apply U b).trans (Scheme.homOfLE_apply _ b).symm)
  have hWU : ∀ a : (W : Scheme.{u}), W.ι a ∈ U → ∃ b, jU b = jW a := by
    intro a ha
    refine ⟨⟨W.ι a, ha⟩, Subtype.ext ?_⟩
    exact (Scheme.homOfLE_apply _ _).trans
      ((Scheme.Opens.ι_apply W a).trans (Scheme.homOfLE_apply _ a).symm)
  have hpreW : i ⁻¹' Set.range (Limits.pushout.inl p q) ⊆ Set.range jW := by
    intro t ht
    obtain ⟨y, hy⟩ := ht
    rcases hsplit t with ⟨a, rfl⟩ | ⟨b, rfl⟩
    · exact ⟨a, rfl⟩
    · have h2 : i (jU b) = Limits.pushout.inr p q (i₂ b) := by
        rw [← Scheme.Hom.comp_apply, hU, Scheme.Hom.comp_apply]
      obtain ⟨z, -, hz⟩ := hover y _ (hy.trans h2)
      exact hUW b (P2 b ⟨z, hz⟩)
  have hpreU : i ⁻¹' Set.range (Limits.pushout.inr p q) ⊆ Set.range jU := by
    intro t ht
    obtain ⟨y, hy⟩ := ht
    rcases hsplit t with ⟨a, rfl⟩ | ⟨b, rfl⟩
    · have h2 : i (jW a) = Limits.pushout.inl p q (i₁ a) := by
        rw [← Scheme.Hom.comp_apply, hW, Scheme.Hom.comp_apply]
      obtain ⟨z, hz, -⟩ := hover _ y (h2.symm.trans hy.symm)
      exact hWU a (P1 a ⟨z, hz⟩)
    · exact ⟨b, rfl⟩
  refine ⟨i, ?_, heq⟩
  apply IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion)
    (fun b : Bool => cond b (Limits.pushout.inl p q).opensRange
      (Limits.pushout.inr p q).opensRange)
  · rw [iSup_bool_eq]
    show (Limits.pushout.inl p q).opensRange ⊔ (Limits.pushout.inr p q).opensRange = ⊤
    rw [eq_top_iff]
    intro x _
    rcases hcover x with h | h
    · exact TopologicalSpace.Opens.mem_sup.mpr (Or.inl (Scheme.Hom.mem_opensRange.mpr h))
    · exact TopologicalSpace.Opens.mem_sup.mpr (Or.inr (Scheme.Hom.mem_opensRange.mpr h))
  · intro b
    cases b
    · exact crit _ _ jU (Limits.pushout.inr p q) i₂ hU hpreU
    · exact crit _ _ jW (Limits.pushout.inl p q) i₁ hW hpreW

theorem wc_ap_pushout_open_immersion_qcqs_lfp : ∀ (R : Type u) [CommRing R] (V₀ U₀ W₀ : Scheme.{u}) (hV : V₀ ⟶ Spec (.of R)) (hU : U₀ ⟶ Spec (.of R)) (p : W₀ ⟶ V₀) (q : W₀ ⟶ U₀) [IsOpenImmersion p] [IsOpenImmersion q] (w : p ≫ hV = q ≫ hU), CompactSpace W₀ → QuasiCompact hV → QuasiSeparated hV → LocallyOfFinitePresentation hV → QuasiCompact hU → QuasiSeparated hU → LocallyOfFinitePresentation hU → QuasiCompact (Limits.pushout.desc hV hU w) ∧ QuasiSeparated (Limits.pushout.desc hV hU w) ∧ LocallyOfFinitePresentation (Limits.pushout.desc hV hU w) :=
by
  intro R _ V₀ U₀ W₀ hV hU p q _ _ w hW hVqc hVqs hVlfp hUqc hUqs hUlfp
  haveI := hVqc
  haveI := hVqs
  haveI := hVlfp
  haveI := hUqc
  haveI := hUqs
  haveI := hUlfp
  haveI : CompactSpace V₀ := QuasiCompact.compactSpace_of_compactSpace hV
  haveI : CompactSpace U₀ := QuasiCompact.compactSpace_of_compactSpace hU
  haveI : QuasiSeparatedSpace V₀ := quasiSeparatedSpace_of_quasiSeparated hV
  haveI : QuasiSeparatedSpace U₀ := quasiSeparatedSpace_of_quasiSeparated hU

  have hι0 : Limits.colimit.ι (Limits.span p q) Limits.WalkingSpan.zero =
      p ≫ Limits.pushout.inl p q := by
    rw [← Limits.colimit.w (Limits.span p q) Limits.WalkingSpan.Hom.fst, Limits.span_map_fst]

  have hcover : ∀ x : ↥(Limits.pushout p q),
      x ∈ Set.range (Limits.pushout.inl p q) ∨ x ∈ Set.range (Limits.pushout.inr p q) := by
    intro x
    obtain ⟨i, xi, hx⟩ := Scheme.IsLocallyDirected.ι_jointly_surjective (Limits.span p q) x
    rcases i with _ | ⟨_ | _⟩
    · left
      refine ⟨p xi, ?_⟩
      rw [← hx]
      change _ = (Limits.colimit.ι (Limits.span p q) Limits.WalkingSpan.zero) xi
      rw [hι0, Scheme.Hom.comp_apply]
    · left
      exact ⟨xi, hx⟩
    · right
      exact ⟨xi, hx⟩

  have hinter : Set.range (Limits.pushout.inl p q) ∩ Set.range (Limits.pushout.inr p q) =
      Set.range (p ≫ Limits.pushout.inl p q) := by
    ext x
    constructor
    · rintro ⟨⟨a, rfl⟩, ⟨b, hb⟩⟩
      obtain ⟨k, fi, fj, z, hz1, hz2⟩ :=
        (Scheme.IsLocallyDirected.ι_eq_ι_iff (Limits.span p q) (i := Limits.WalkingSpan.left)
          (j := Limits.WalkingSpan.right)).mp hb.symm
      rcases k with _ | ⟨_ | _⟩
      · have hfi : fi = Limits.WalkingSpan.Hom.fst := Subsingleton.elim _ _
        subst hfi
        rw [Limits.span_map_fst] at hz1
        exact ⟨z, by rw [Scheme.Hom.comp_apply, hz1]⟩
      · obtain ⟨⟩ : Limits.WidePushoutShape.Hom (some Limits.WalkingPair.left)
          (some Limits.WalkingPair.right) := fj
      · obtain ⟨⟩ : Limits.WidePushoutShape.Hom (some Limits.WalkingPair.right)
          (some Limits.WalkingPair.left) := fi
    · rintro ⟨z, rfl⟩
      refine ⟨⟨p z, by rw [Scheme.Hom.comp_apply]⟩, ⟨q z, ?_⟩⟩
      show _ = (p ≫ Limits.pushout.inl p q) z
      rw [Limits.pushout.condition, Scheme.Hom.comp_apply]
  have hL : IsOpen (Set.range (Limits.pushout.inl p q)) :=
    (Limits.pushout.inl p q).isOpenEmbedding.isOpen_range
  have hR : IsOpen (Set.range (Limits.pushout.inr p q)) :=
    (Limits.pushout.inr p q).isOpenEmbedding.isOpen_range
  have huniv : Set.range (Limits.pushout.inl p q) ∪ Set.range (Limits.pushout.inr p q) =
      Set.univ := Set.eq_univ_of_forall (fun x => hcover x)

  have hcG : CompactSpace ↥(Limits.pushout p q) := by
    rw [← isCompact_univ_iff, ← huniv]
    exact (isCompact_range (Limits.pushout.inl p q).continuous).union
      (isCompact_range (Limits.pushout.inr p q).continuous)
  have hqc : QuasiCompact (Limits.pushout.desc hV hU w) :=
    (quasiCompact_iff_compactSpace _).mpr hcG

  have key : ∀ (S T : Set ↥(Limits.pushout p q)), IsOpen S → IsOpen T → S ∪ T = Set.univ →
      IsQuasiSeparated T → IsCompact (S ∩ T) → IsRetrocompact S := by
    intro S T hS hT hST hTqs hSTc K hKc hKo
    have hb : ∀ {U : (Limits.pushout p q).Opens} {x : ↥(Limits.pushout p q)}, x ∈ U →
        ∃ U' ∈ (Limits.pushout p q).affineOpens, x ∈ U' ∧ U' ≤ U :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens (Limits.pushout p q))
    have hA : ∀ x ∈ K, ∃ A : (Limits.pushout p q).Opens, IsAffineOpen A ∧ x ∈ A ∧
        (A : Set ↥(Limits.pushout p q)) ⊆ K ∧
        ((A : Set ↥(Limits.pushout p q)) ⊆ S ∨ (A : Set ↥(Limits.pushout p q)) ⊆ T) := by
      intro x hx
      have hxu : x ∈ S ∪ T := by rw [hST]; trivial
      rcases hxu with hxS | hxT
      · obtain ⟨A, hA, hxA, hAle⟩ := hb (U := ⟨K ∩ S, hKo.inter hS⟩) (x := x)
          (show x ∈ K ∩ S from ⟨hx, hxS⟩)
        exact ⟨A, hA, hxA, fun y hy => (hAle hy).1, Or.inl (fun y hy => (hAle hy).2)⟩
      · obtain ⟨A, hA, hxA, hAle⟩ := hb (U := ⟨K ∩ T, hKo.inter hT⟩) (x := x)
          (show x ∈ K ∩ T from ⟨hx, hxT⟩)
        exact ⟨A, hA, hxA, fun y hy => (hAle hy).1, Or.inr (fun y hy => (hAle hy).2)⟩
    choose! A hAaff hxA hAK hAST using hA
    obtain ⟨t, htK, hcov⟩ := hKc.elim_nhds_subcover (fun x => (A x : Set ↥(Limits.pushout p q)))
      (fun x hx => (A x).isOpen.mem_nhds (hxA x hx))
    have heq : S ∩ K = ⋃ x ∈ t, (S ∩ (A x : Set ↥(Limits.pushout p q))) := by
      ext y
      simp only [Set.mem_inter_iff, Set.mem_iUnion]
      constructor
      · rintro ⟨hyS, hyK⟩
        obtain ⟨x, hx, hyA⟩ := Set.mem_iUnion₂.mp (hcov hyK)
        exact ⟨x, hx, hyS, hyA⟩
      · rintro ⟨x, hx, hyS, hyA⟩
        exact ⟨hyS, hAK x (htK x hx) hyA⟩
    rw [heq]
    apply Finset.isCompact_biUnion
    intro x hx
    have hxK := htK x hx
    rcases hAST x hxK with hS' | hT'
    · rw [Set.inter_eq_right.mpr hS']
      exact (hAaff x hxK).isCompact
    · have h2 : S ∩ (A x : Set ↥(Limits.pushout p q)) = (S ∩ T) ∩ (A x : Set ↥(Limits.pushout p q)) := by
        ext y
        constructor
        · rintro ⟨h1, h2⟩
          exact ⟨⟨h1, hT' h2⟩, h2⟩
        · rintro ⟨⟨h1, _⟩, h2⟩
          exact ⟨h1, h2⟩
      rw [h2]
      exact hTqs _ _ Set.inter_subset_right (hS.inter hT) hSTc hT' (A x).isOpen
        (hAaff x hxK).isCompact
  have hLqs : IsQuasiSeparated (Set.range (Limits.pushout.inl p q)) := by
    rw [← Set.image_univ]
    exact ((isQuasiSeparated_univ_iff (α := V₀)).mpr inferInstance).image_of_isEmbedding
      (Limits.pushout.inl p q).isOpenEmbedding.isEmbedding
  have hRqs : IsQuasiSeparated (Set.range (Limits.pushout.inr p q)) := by
    rw [← Set.image_univ]
    exact ((isQuasiSeparated_univ_iff (α := U₀)).mpr inferInstance).image_of_isEmbedding
      (Limits.pushout.inr p q).isOpenEmbedding.isEmbedding
  have hcompI : IsCompact (Set.range (Limits.pushout.inl p q) ∩
      Set.range (Limits.pushout.inr p q)) := by
    rw [hinter]
    exact isCompact_range (p ≫ Limits.pushout.inl p q).continuous
  let Uf : Bool → (Limits.pushout p q).Opens := fun b => cond b ⟨_, hL⟩ ⟨_, hR⟩
  have hcov' : TopologicalSpace.IsOpenCover Uf := by
    show iSup Uf = ⊤
    rw [eq_top_iff]
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    rcases hcover x with h | h
    · exact ⟨true, h⟩
    · exact ⟨false, h⟩
  have hqsG : QuasiSeparatedSpace ↥(Limits.pushout p q) := by
    refine QuasiSeparatedSpace.of_isOpenCover (U := Uf) hcov' ?_ ?_
    · intro b
      cases b
      · exact key _ _ hR hL (by rw [Set.union_comm]; exact huniv) hLqs
          (by rw [Set.inter_comm]; exact hcompI)
      · exact key _ _ hL hR huniv hRqs hcompI
    · intro b
      cases b
      · exact hRqs
      · exact hLqs
  have hqs : QuasiSeparated (Limits.pushout.desc hV hU w) :=
    (quasiSeparated_iff_quasiSeparatedSpace _).mpr hqsG

  haveI : IsZariskiLocalAtSource @LocallyOfFinitePresentation :=
    HasRingHomProperty.instIsZariskiLocalAtSource
  have hlfp : LocallyOfFinitePresentation (Limits.pushout.desc hV hU w) := by
    refine IsZariskiLocalAtSource.of_openCover
      (Scheme.IsLocallyDirected.openCover (Limits.span p q)) ?_
    intro (i : Limits.WalkingSpan)
    rcases i with _ | ⟨_ | _⟩
    · change LocallyOfFinitePresentation
        (Limits.colimit.ι (Limits.span p q) Limits.WalkingSpan.zero ≫ Limits.pushout.desc hV hU w)
      rw [hι0, Category.assoc, Limits.pushout.inl_desc]
      infer_instance
    · change LocallyOfFinitePresentation (Limits.pushout.inl p q ≫ Limits.pushout.desc hV hU w)
      rw [Limits.pushout.inl_desc]
      exact hVlfp
    · change LocallyOfFinitePresentation (Limits.pushout.inr p q ≫ Limits.pushout.desc hV hU w)
      rw [Limits.pushout.inr_desc]
      exact hUlfp
  exact ⟨hqc, hqs, hlfp⟩

theorem wc_ap_immersion_into_fp_quasiSeparated : ∀ (A : Type u) [CommRing A] (R : Scheme.{u}) (g : R ⟶ Spec (.of A)) [IsSeparated g] [LocallyOfFiniteType g] [QuasiCompact g], ∃ (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)) (_ : LocallyOfFinitePresentation h) (_ : QuasiSeparated h) (i : R ⟶ Y), IsImmersion i ∧ i ≫ h = g :=
by
  intro A _ R g _ _ _
  classical
  haveI : CompactSpace R := QuasiCompact.compactSpace_of_compactSpace g
  haveI : QuasiSeparatedSpace R := quasiSeparatedSpace_of_quasiSeparated g
  have hLFT : ∀ W : R.Opens, LocallyOfFiniteType (W.ι ≫ g) := by
    intro W
    have h2 : LocallyOfFiniteType W.ι := inferInstance
    exact MorphismProperty.comp_mem @LocallyOfFiniteType _ _ h2 inferInstance
  have cLFP : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z), LocallyOfFinitePresentation f →
      LocallyOfFinitePresentation g → LocallyOfFinitePresentation (f ≫ g) :=
    fun f g hf hg => MorphismProperty.comp_mem @LocallyOfFinitePresentation f g hf hg
  have cLFT : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z), LocallyOfFiniteType f →
      LocallyOfFiniteType g → LocallyOfFiniteType (f ≫ g) :=
    fun f g hf hg => MorphismProperty.comp_mem @LocallyOfFiniteType f g hf hg
  have cQC : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z), QuasiCompact f →
      QuasiCompact g → QuasiCompact (f ≫ g) :=
    fun f g hf hg => MorphismProperty.comp_mem @QuasiCompact f g hf hg
  have cQS : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z), QuasiSeparated f →
      QuasiSeparated g → QuasiSeparated (f ≫ g) :=
    fun f g hf hg => MorphismProperty.comp_mem @QuasiSeparated f g hf hg
  have oLFT : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f], LocallyOfFiniteType f :=
    fun f _ => inferInstance

  have H1 : ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) [IsAffine X] [LocallyOfFiniteType f],
      ∃ (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)) (i : X ⟶ Y), QuasiCompact h ∧ QuasiSeparated h ∧
        LocallyOfFinitePresentation h ∧ IsClosedImmersion i ∧ i ≫ h = f := by
    intro X f _ _
    let φ : A →+* Γ(X, ⊤) := f.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom
    have hφ : φ.FiniteType := by
      have h1 : f.appTop.hom.FiniteType :=
        (HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFiniteType)).mp inferInstance
      exact h1.comp (RingHom.FiniteType.of_surjective _
        (Scheme.ΓSpecIso (.of A)).commRingCatIsoToRingEquiv.symm.surjective)
    letI : Algebra A Γ(X, ⊤) := φ.toAlgebra
    have hft : Algebra.FiniteType A Γ(X, ⊤) := hφ
    obtain ⟨n, ψ, hψ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hft
    haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom ψ.toRingHom)) :=
      IsClosedImmersion.spec_of_surjective _ hψ
    refine ⟨Spec (.of (MvPolynomial (Fin n) A)), Spec.map (CommRingCat.ofHom (algebraMap A _)),
      X.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom ψ.toRingHom), inferInstance, inferInstance, ?_,
      inferInstance, ?_⟩
    · rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation)]
      exact RingHom.finitePresentation_algebraMap.mpr inferInstance
    · have hcomp : ψ.toRingHom.comp (algebraMap A (MvPolynomial (Fin n) A)) = φ :=
        RingHom.ext fun a => ψ.commutes a
      rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hcomp]
      have e : CommRingCat.ofHom φ = (Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop := rfl
      rw [e, Spec.map_comp, ← Category.assoc, Scheme.isoSpec_hom_naturality, Category.assoc,
        Scheme.isoSpec_Spec_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]

  have H8 : ∀ (X Y S : Scheme.{u}) (f₀ : X ⟶ Y) (g₀ : Y ⟶ S) [LocallyOfFinitePresentation (f₀ ≫ g₀)]
      [LocallyOfFiniteType g₀], LocallyOfFinitePresentation f₀ := by
    intro X Y S f g _ _
    have hst : RingHom.StableUnderCompositionWithLocalizationAway RingHom.FinitePresentation :=
      RingHom.finitePresentation_stableUnderComposition.stableUnderCompositionWithLocalizationAway
        RingHom.finitePresentation_holdsForLocalizationAway
    rw [HasRingHomProperty.iff_exists_appLE (P := @LocallyOfFinitePresentation) hst.left]
    intro x
    obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (x := g (f x)) (U := ⊤) trivial
    obtain ⟨U, hU, hxU, hUW⟩ := exists_isAffineOpen_mem_and_subset (x := f x) (U := g ⁻¹ᵁ W) hxW
    obtain ⟨V, hV, hxV, hVU⟩ := exists_isAffineOpen_mem_and_subset (x := x) (U := f ⁻¹ᵁ U) hxU
    have hUW' : U ≤ g ⁻¹ᵁ W := hUW
    have hVU' : V ≤ f ⁻¹ᵁ U := hVU
    refine ⟨⟨U, hU⟩, ⟨V, hV⟩, hxV, hVU', ?_⟩
    have h1 : (g.appLE W U hUW').hom.FiniteType :=
      HasRingHomProperty.appLE (P := @LocallyOfFiniteType) g inferInstance ⟨W, hW⟩ ⟨U, hU⟩ hUW'
    have h2 := HasRingHomProperty.appLE (P := @LocallyOfFinitePresentation) (f ≫ g) inferInstance
      ⟨W, hW⟩ ⟨V, hV⟩ (hVU'.trans (Scheme.Hom.preimage_mono f hUW'))
    rw [← Scheme.Hom.appLE_comp_appLE f g W U V hUW' hVU', CommRingCat.hom_comp] at h2
    exact RingHom.FinitePresentation.of_comp_finiteType _ h2 h1


  have H6 : ∀ (T W Y : Scheme.{u}) (l : T ⟶ W) [IsOpenImmersion l] [CompactSpace T]
      (i : W ⟶ Y) [IsClosedImmersion i], ∃ (O : Y.Opens) (j : T ⟶ (O : Scheme.{u})),
        IsCompact (O : Set Y) ∧ i ⁻¹' (O : Set Y) = Set.range l ∧ IsClosedImmersion j ∧
        j ≫ O.ι = l ≫ i := by
    intro T W Y l _ _ i _
    have hKo : IsOpen (Set.range l) := l.isOpenEmbedding.isOpen_range
    obtain ⟨O', hO'o, hO'⟩ := (i.isEmbedding.isInducing.isOpen_iff).mp hKo
    have hK : IsCompact (i '' Set.range l) := (isCompact_range l.continuous).image i.continuous
    obtain ⟨t, ht⟩ := hK.elim_finite_subcover
      (fun j : {V : Set Y // IsOpen V ∧ IsCompact V ∧ V ⊆ O'} => j.1) (fun j => j.2.1) (by
        intro x hx
        obtain ⟨w, hw, rfl⟩ := hx
        have hxO : i w ∈ O' := by
          have : w ∈ i ⁻¹' O' := by rw [hO']; exact hw
          exact this
        obtain ⟨v, ⟨hvo, hvc⟩, hxv, hvsub⟩ :=
          PrespectralSpace.isTopologicalBasis.exists_subset_of_mem_open hxO hO'o
        exact Set.mem_iUnion.mpr ⟨⟨v, hvo, hvc, hvsub⟩, hxv⟩)
    have hOo : IsOpen (⋃ j ∈ t, j.1) := isOpen_biUnion fun j _ => j.2.1
    have hOc : IsCompact (⋃ j ∈ t, j.1) := t.isCompact_biUnion fun j _ => j.2.2.1
    have hOO' : (⋃ j ∈ t, j.1) ⊆ O' := by
      intro x hx
      obtain ⟨j, _, hxj⟩ := Set.mem_iUnion₂.mp hx
      exact j.2.2.2 hxj
    let O : Y.Opens := ⟨⋃ j ∈ t, j.1, hOo⟩
    have hpre : i ⁻¹' (O : Set Y) = Set.range l := by
      apply Set.Subset.antisymm
      · rw [← hO']; exact Set.preimage_mono hOO'
      · intro w hw; exact ht ⟨w, hw, rfl⟩
    have hsub : Set.range (l ≫ i) ⊆ Set.range O.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      have : l x ∈ i ⁻¹' (O : Set Y) := by rw [hpre]; exact ⟨x, rfl⟩
      rw [Scheme.Hom.comp_apply]
      exact this
    let j : T ⟶ (O : Scheme.{u}) := IsOpenImmersion.lift O.ι (l ≫ i) hsub
    have hj : j ≫ O.ι = l ≫ i := IsOpenImmersion.lift_fac _ _ _
    haveI : IsPreimmersion (j ≫ O.ι) := by rw [hj]; infer_instance
    haveI : IsPreimmersion j := IsPreimmersion.of_comp j O.ι
    have hrange : Set.range j = O.ι ⁻¹' Set.range i := by
      ext y
      constructor
      · rintro ⟨x, rfl⟩
        show O.ι (j x) ∈ Set.range i
        rw [← Scheme.Hom.comp_apply, hj, Scheme.Hom.comp_apply]
        exact ⟨_, rfl⟩
      · rintro ⟨w, hw⟩
        have hwO : w ∈ i ⁻¹' (O : Set Y) := by
          show i w ∈ (O : Set Y)
          rw [hw]
          have := Set.mem_range_self (f := O.ι) y
          rwa [Scheme.Opens.range_ι] at this
        rw [hpre] at hwO
        obtain ⟨x, rfl⟩ := hwO
        refine ⟨x, O.ι.isEmbedding.injective ?_⟩
        rw [← Scheme.Hom.comp_apply, hj, Scheme.Hom.comp_apply, hw]
    haveI : IsClosedImmersion j := IsClosedImmersion.of_isPreimmersion j (by
      rw [hrange]; exact i.isClosedEmbedding.isClosed_range.preimage O.ι.continuous)
    exact ⟨O, j, hOc, hpre, inferInstance, hj⟩

  have H7 : ∀ (Y T : Scheme.{u}) (i : T ⟶ Y) [IsImmersion i] [CompactSpace T] (O : Y.Opens),
      Set.range i ⊆ (O : Set Y) → ∃ (N : Y.Opens) (i' : T ⟶ (N : Scheme.{u})), N ≤ O ∧
        IsCompact (N : Set Y) ∧ IsClosedImmersion i' ∧ i' ≫ N.ι = i := by
    intro Y T i _ _ O hiO
    have hK : IsCompact (Set.range i) := isCompact_range i.continuous
    have hKlc : IsLocallyClosed (Set.range i) := Scheme.Hom.isLocallyClosed_range i
    have hW : IsOpen (coborder (Set.range i) ∩ (O : Set Y)) :=
      hKlc.isOpen_coborder.inter O.isOpen
    obtain ⟨t, ht⟩ := hK.elim_finite_subcover
      (fun j : {V : Set Y // IsOpen V ∧ IsCompact V ∧
        V ⊆ coborder (Set.range i) ∩ (O : Set Y)} => j.1)
      (fun j => j.2.1) (by
        intro x hx
        obtain ⟨v, ⟨hvo, hvc⟩, hxv, hvsub⟩ :=
          PrespectralSpace.isTopologicalBasis.exists_subset_of_mem_open
            (show x ∈ coborder (Set.range i) ∩ (O : Set Y) from ⟨subset_coborder hx, hiO hx⟩) hW
        exact Set.mem_iUnion.mpr ⟨⟨v, hvo, hvc, hvsub⟩, hxv⟩)
    have hNo : IsOpen (⋃ j ∈ t, j.1) := isOpen_biUnion fun j _ => j.2.1
    have hNc : IsCompact (⋃ j ∈ t, j.1) := t.isCompact_biUnion fun j _ => j.2.2.1
    have hNW : (⋃ j ∈ t, j.1) ⊆ coborder (Set.range i) ∩ (O : Set Y) := by
      intro x hx
      obtain ⟨j, _, hxj⟩ := Set.mem_iUnion₂.mp hx
      exact j.2.2.2 hxj
    let N : Y.Opens := ⟨⋃ j ∈ t, j.1, hNo⟩
    have hiN : Set.range i ⊆ Set.range N.ι := by
      rw [Scheme.Opens.range_ι]; exact ht
    let i' : T ⟶ (N : Scheme.{u}) := IsOpenImmersion.lift N.ι i hiN
    have hi' : i' ≫ N.ι = i := IsOpenImmersion.lift_fac _ _ _
    haveI : IsPreimmersion (i' ≫ N.ι) := by rw [hi']; infer_instance
    haveI : IsPreimmersion i' := IsPreimmersion.of_comp i' N.ι
    have hrange : Set.range i' = N.ι ⁻¹' closure (Set.range i) := by
      ext x
      constructor
      · rintro ⟨r, rfl⟩
        show N.ι (i' r) ∈ closure (Set.range i)
        rw [← Scheme.Hom.comp_apply, hi']
        exact subset_closure ⟨r, rfl⟩
      · intro hx
        have hxU : N.ι x ∈ Set.range N.ι := ⟨x, rfl⟩
        rw [Scheme.Opens.range_ι] at hxU
        have hxW : N.ι x ∈ coborder (Set.range i) := (hNW hxU).1
        have hxK : N.ι x ∈ Set.range i := by
          rw [← closure_inter_coborder (s := Set.range i)]; exact ⟨hx, hxW⟩
        obtain ⟨r, hr⟩ := hxK
        refine ⟨r, N.ι.isEmbedding.injective ?_⟩
        rw [← Scheme.Hom.comp_apply, hi', hr]
    haveI : IsClosedImmersion i' := IsClosedImmersion.of_isPreimmersion i' (by
      rw [hrange]; exact isClosed_closure.preimage N.ι.continuous)
    exact ⟨N, i', fun x hx => (hNW hx).2, hNc, inferInstance, hi'⟩

  have key : ∃ (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A))
      (i : ((⊤ : R.Opens) : Scheme.{u}) ⟶ Y), QuasiCompact h ∧ QuasiSeparated h ∧
      LocallyOfFinitePresentation h ∧ IsClosedImmersion i ∧ i ≫ h = (⊤ : R.Opens).ι ≫ g := by
    refine compact_open_induction_on (P := fun W : R.Opens => ∃ (Y : Scheme.{u})
      (h : Y ⟶ Spec (.of A)) (i : (W : Scheme.{u}) ⟶ Y), QuasiCompact h ∧ QuasiSeparated h ∧
      LocallyOfFinitePresentation h ∧ IsClosedImmersion i ∧ i ≫ h = W.ι ≫ g) ⊤ ?_ ?_ ?_
    · rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ
    · haveI : IsAffine ((⊥ : R.Opens) : Scheme.{u}) := isAffineOpen_bot R
      exact @H1 _ ((⊥ : R.Opens).ι ≫ g) _ (hLFT ⊥)
    · intro S hS U hP
      obtain ⟨U', hU'⟩ := U
      obtain ⟨Y₁, h₁, i₁, hqc₁, hqs₁, hlfp₁, hi₁, hih₁⟩ := hP
      haveI := hqc₁
      haveI := hqs₁
      haveI := hlfp₁
      haveI := hi₁
      haveI : IsAffine (U' : Scheme.{u}) := hU'
      obtain ⟨Y₂, h₂, i₂, hqc₂, hqs₂, hlfp₂, hi₂, hih₂⟩ := @H1 (U' : Scheme.{u}) (U'.ι ≫ g) _ (hLFT U')
      haveI := hqc₂
      haveI := hqs₂
      haveI := hlfp₂
      haveI := hi₂
      haveI : CompactSpace Y₁ := QuasiCompact.compactSpace_of_compactSpace h₁
      haveI : QuasiSeparatedSpace Y₁ := quasiSeparatedSpace_of_quasiSeparated h₁
      haveI : CompactSpace Y₂ := QuasiCompact.compactSpace_of_compactSpace h₂
      haveI : QuasiSeparatedSpace Y₂ := quasiSeparatedSpace_of_quasiSeparated h₂
      have hVc : IsCompact ((S ⊓ U' : R.Opens) : Set R) := by
        rw [TopologicalSpace.Opens.coe_inf]
        exact QuasiSeparatedSpace.inter_isCompact _ _ S.isOpen hS U'.isOpen
          (IsAffineOpen.isCompact hU')
      haveI : CompactSpace ((S ⊓ U' : R.Opens) : Scheme.{u}) := isCompact_iff_compactSpace.mp hVc
      let lS : ((S ⊓ U' : R.Opens) : Scheme.{u}) ⟶ (S : Scheme.{u}) :=
        R.homOfLE (inf_le_left : S ⊓ U' ≤ S)
      let lU : ((S ⊓ U' : R.Opens) : Scheme.{u}) ⟶ (U' : Scheme.{u}) :=
        R.homOfLE (inf_le_right : S ⊓ U' ≤ U')
      haveI : IsOpenImmersion lS := inferInstanceAs (IsOpenImmersion (R.homOfLE _))
      haveI : IsOpenImmersion lU := inferInstanceAs (IsOpenImmersion (R.homOfLE _))
      have hlSι : lS ≫ S.ι = (S ⊓ U').ι := Scheme.homOfLE_ι _ _
      have hlUι : lU ≫ U'.ι = (S ⊓ U').ι := Scheme.homOfLE_ι _ _

      obtain ⟨O₁, j₁, hO₁c, hO₁pre, hj₁, hj₁f⟩ := H6 _ _ _ lS i₁
      obtain ⟨O₂, j₂, hO₂c, hO₂pre, hj₂, hj₂f⟩ := H6 _ _ _ lU i₂
      haveI := hj₁
      haveI := hj₂
      haveI : CompactSpace (O₁ : Scheme.{u}) := isCompact_iff_compactSpace.mp hO₁c
      haveI : CompactSpace (O₂ : Scheme.{u}) := isCompact_iff_compactSpace.mp hO₂c
      haveI : QuasiCompact (O₁.ι ≫ h₁) := (quasiCompact_iff_compactSpace _).mpr inferInstance
      haveI : QuasiCompact (O₂.ι ≫ h₂) := (quasiCompact_iff_compactSpace _).mpr inferInstance
      haveI : LocallyOfFinitePresentation (O₁.ι ≫ h₁) :=
        cLFP _ _ (locallyOfFinitePresentation_of_isOpenImmersion _) inferInstance
      haveI : LocallyOfFinitePresentation (O₂.ι ≫ h₂) :=
        cLFP _ _ (locallyOfFinitePresentation_of_isOpenImmersion _) inferInstance
      haveI : QuasiSeparated (O₁.ι ≫ h₁) := cQS _ _ inferInstance inferInstance
      haveI : QuasiSeparated (O₂.ι ≫ h₂) := cQS _ _ inferInstance inferInstance
      have e1 : j₁ ≫ O₁.ι ≫ h₁ = (S ⊓ U').ι ≫ g := by
        rw [← Category.assoc, hj₁f, Category.assoc, hih₁, ← Category.assoc, hlSι]
      have e2 : j₂ ≫ O₂.ι ≫ h₂ = (S ⊓ U').ι ≫ g := by
        rw [← Category.assoc, hj₂f, Category.assoc, hih₂, ← Category.assoc, hlUι]
      have hjj : j₂ ≫ O₂.ι ≫ h₂ = j₁ ≫ O₁.ι ≫ h₁ := e2.trans e1.symm

      obtain ⟨X, x₂, v, G, hx₂c, hx₂l, hG, hvx, hvG, hGh⟩ :=
        wc_ap_two_fp_closed_hulls_immersion A _ O₂ O₁ (O₂.ι ≫ h₂) (O₁.ι ≫ h₁) j₂ j₁ hjj
      haveI := hx₂c
      haveI := hx₂l
      haveI := hG
      haveI : QuasiCompact (x₂ ≫ O₂.ι ≫ h₂) := cQC _ _ inferInstance inferInstance
      haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace (x₂ ≫ O₂.ι ≫ h₂)

      have hGO : Set.range (G ≫ O₁.ι) ⊆ (O₁ : Set Y₁) := by
        rintro _ ⟨x, rfl⟩
        rw [Scheme.Hom.comp_apply]
        have := Set.mem_range_self (f := O₁.ι) (G x)
        rwa [Scheme.Opens.range_ι] at this
      haveI : IsImmersion (G ≫ O₁.ι) := inferInstance
      obtain ⟨N, g', hNO, hNc, hg'c, hg'f⟩ := H7 Y₁ X (G ≫ O₁.ι) O₁ hGO
      haveI := hg'c

      haveI : LocallyOfFinitePresentation (x₂ ≫ O₂.ι ≫ h₂) := cLFP _ _ inferInstance inferInstance
      haveI : LocallyOfFinitePresentation (g' ≫ N.ι ≫ h₁) := by
        rw [← Category.assoc, hg'f, Category.assoc, hGh]; infer_instance
      haveI : LocallyOfFiniteType (N.ι ≫ h₁) := cLFT _ _ (oLFT N.ι) inferInstance
      haveI : LocallyOfFinitePresentation g' := H8 X N (Spec (.of A)) g' (N.ι ≫ h₁)

      have hcomp1 : v ≫ g' ≫ N.ι = lS ≫ i₁ := by
        rw [hg'f, ← Category.assoc, hvG, hj₁f]
      have hrange1 : Set.range lS = i₁ ⁻¹' (N : Set Y₁) := by
        apply Set.Subset.antisymm
        · rintro _ ⟨t, rfl⟩
          show i₁ (lS t) ∈ (N : Set Y₁)
          rw [← Scheme.Hom.comp_apply, ← hcomp1, ← Category.assoc, Scheme.Hom.comp_apply]
          have := Set.mem_range_self (f := N.ι) ((v ≫ g') t)
          rwa [Scheme.Opens.range_ι] at this
        · intro x hx
          have hx' : x ∈ i₁ ⁻¹' (O₁ : Set Y₁) := hNO hx
          rwa [hO₁pre] at hx'
      have hcomp2 : v ≫ x₂ ≫ O₂.ι = lU ≫ i₂ := by
        rw [← Category.assoc, hvx, hj₂f]
      obtain ⟨Z₁, z₁, κ₁, e₁, hz₁c, hz₁l, hκ₁, he₁⟩ :=
        wc_ap_fp_closed_extend_from_compact_open Y₁ S i₁ N hNc X g' _ lS v hrange1 hcomp1
      obtain ⟨Z₂, z₂, κ₂, e₂, hz₂c, hz₂l, hκ₂, he₂⟩ :=
        wc_ap_fp_closed_extend_from_compact_open Y₂ U' i₂ O₂ hO₂c X x₂ _ lU v hO₂pre.symm hcomp2
      haveI := hz₁c
      haveI := hz₁l
      haveI := hz₂c
      haveI := hz₂l
      haveI : IsClosedImmersion (κ₁ ≫ z₁) := by rw [hκ₁]; infer_instance
      haveI : IsClosedImmersion κ₁ := IsClosedImmersion.of_comp κ₁ z₁
      haveI : IsClosedImmersion (κ₂ ≫ z₂) := by rw [hκ₂]; infer_instance
      haveI : IsClosedImmersion κ₂ := IsClosedImmersion.of_comp κ₂ z₂

      have hw : (z₁ ⁻¹ᵁ N).ι ≫ z₁ ≫ h₁ = (e₁.hom ≫ e₂.inv ≫ (z₂ ⁻¹ᵁ O₂).ι) ≫ z₂ ≫ h₂ := by
        have l1 : (z₁ ⁻¹ᵁ N).ι ≫ z₁ ≫ h₁ = e₁.hom ≫ g' ≫ N.ι ≫ h₁ := by
          rw [← Category.assoc, ← he₁]; simp only [Category.assoc]
        have l2 : (e₁.hom ≫ e₂.inv ≫ (z₂ ⁻¹ᵁ O₂).ι) ≫ z₂ ≫ h₂ = e₁.hom ≫ x₂ ≫ O₂.ι ≫ h₂ := by
          have : e₂.inv ≫ (z₂ ⁻¹ᵁ O₂).ι ≫ z₂ = x₂ ≫ O₂.ι := by
            rw [← he₂, Iso.inv_hom_id_assoc]
          simp only [Category.assoc]
          rw [← Category.assoc (z₂ ⁻¹ᵁ O₂).ι z₂ h₂, ← Category.assoc e₂.inv, this, Category.assoc]
        have l3 : g' ≫ N.ι ≫ h₁ = x₂ ≫ O₂.ι ≫ h₂ := by
          rw [← Category.assoc, hg'f, Category.assoc, hGh]
        rw [l1, l2, l3]
      have hκ₁g : κ₁ ≫ z₁ ≫ h₁ = S.ι ≫ g := by rw [← Category.assoc, hκ₁, hih₁]
      have hκ₂g : κ₂ ≫ z₂ ≫ h₂ = U'.ι ≫ g := by rw [← Category.assoc, hκ₂, hih₂]
      have hsubn : Set.range (lS ≫ κ₁) ⊆ Set.range (z₁ ⁻¹ᵁ N).ι := by
        rw [Scheme.Opens.range_ι]
        rintro _ ⟨t, rfl⟩
        show z₁ ((lS ≫ κ₁) t) ∈ (N : Set Y₁)
        rw [← Scheme.Hom.comp_apply, Category.assoc, hκ₁]
        exact hrange1.subset ⟨t, rfl⟩
      let n : ((S ⊓ U' : R.Opens) : Scheme.{u}) ⟶ (z₁ ⁻¹ᵁ N : Scheme.{u}) :=
        IsOpenImmersion.lift (z₁ ⁻¹ᵁ N).ι (lS ≫ κ₁) hsubn
      have hn1 : n ≫ (z₁ ⁻¹ᵁ N).ι = lS ≫ κ₁ := IsOpenImmersion.lift_fac _ _ _
      have hnv : n ≫ e₁.hom = v := by
        rw [← cancel_mono (g' ≫ N.ι)]
        rw [Category.assoc, he₁, ← Category.assoc, hn1, Category.assoc, hκ₁, hcomp1]
      have hn2 : n ≫ (e₁.hom ≫ e₂.inv ≫ (z₂ ⁻¹ᵁ O₂).ι) = lU ≫ κ₂ := by
        rw [← cancel_mono z₂]
        have : e₂.inv ≫ (z₂ ⁻¹ᵁ O₂).ι ≫ z₂ = x₂ ≫ O₂.ι := by
          rw [← he₂, Iso.inv_hom_id_assoc]
        rw [← Category.assoc n e₁.hom, hnv]
        simp only [Category.assoc]
        rw [this, hκ₂, hcomp2]
      have hpre1 : ∀ a : (S : Scheme.{u}), κ₁ a ∈ Set.range (z₁ ⁻¹ᵁ N).ι → S.ι a ∈ U' := by
        intro a ha
        rw [Scheme.Opens.range_ι] at ha
        have h1 : i₁ a ∈ (N : Set Y₁) := by
          rw [← hκ₁, Scheme.Hom.comp_apply]; exact ha
        have h2 : a ∈ i₁ ⁻¹' (O₁ : Set Y₁) := hNO h1
        rw [hO₁pre] at h2
        obtain ⟨t, rfl⟩ := h2
        rw [← Scheme.Hom.comp_apply, hlSι]
        have := Set.mem_range_self (f := (S ⊓ U').ι) t
        rw [Scheme.Opens.range_ι, TopologicalSpace.Opens.coe_inf] at this
        exact this.2
      have hpre2 : ∀ b : (U' : Scheme.{u}),
          κ₂ b ∈ Set.range (e₁.hom ≫ e₂.inv ≫ (z₂ ⁻¹ᵁ O₂).ι) → U'.ι b ∈ S := by
        rintro b ⟨m, hm⟩
        have h0 : κ₂ b ∈ ((z₂ ⁻¹ᵁ O₂ : Z₂.Opens) : Set Z₂) := by
          rw [← hm, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
          have := Set.mem_range_self (f := (z₂ ⁻¹ᵁ O₂).ι) (e₂.inv (e₁.hom m))
          rwa [Scheme.Opens.range_ι] at this
        have h1 : i₂ b ∈ (O₂ : Set Y₂) := by
          rw [← hκ₂, Scheme.Hom.comp_apply]; exact h0
        have h2 : b ∈ i₂ ⁻¹' (O₂ : Set Y₂) := h1
        rw [hO₂pre] at h2
        obtain ⟨t, rfl⟩ := h2
        rw [← Scheme.Hom.comp_apply, hlUι]
        have := Set.mem_range_self (f := (S ⊓ U').ι) t
        rw [Scheme.Opens.range_ι, TopologicalSpace.Opens.coe_inf] at this
        exact this.1

      obtain ⟨iG, hiG, hiGeq⟩ := wc_ap_glue_closed_immersions_pushout A R g S U' Z₁ Z₂
        (z₁ ⁻¹ᵁ N : Scheme.{u}) (z₁ ≫ h₁) (z₂ ≫ h₂) (z₁ ⁻¹ᵁ N).ι
        (e₁.hom ≫ e₂.inv ≫ (z₂ ⁻¹ᵁ O₂).ι) κ₁ κ₂ n hw hκ₁g hκ₂g hn1 hn2 hpre1 hpre2

      haveI : CompactSpace (z₁ ⁻¹ᵁ N : Scheme.{u}) :=
        QuasiCompact.compactSpace_of_compactSpace e₁.hom
      obtain ⟨hdqc, hdqs, hdlfp⟩ := wc_ap_pushout_open_immersion_qcqs_lfp A Z₁ Z₂
        (z₁ ⁻¹ᵁ N : Scheme.{u}) (z₁ ≫ h₁) (z₂ ≫ h₂) (z₁ ⁻¹ᵁ N).ι
        (e₁.hom ≫ e₂.inv ≫ (z₂ ⁻¹ᵁ O₂).ι) hw inferInstance
        (cQC _ _ inferInstance inferInstance) (cQS _ _ inferInstance inferInstance)
        (cLFP _ _ inferInstance inferInstance)
        (cQC _ _ inferInstance inferInstance) (cQS _ _ inferInstance inferInstance)
        (cLFP _ _ inferInstance inferInstance)
      exact ⟨_, _, iG, hdqc, hdqs, hdlfp, hiG, hiGeq⟩
  obtain ⟨Y, h, i, hqc, hqs, hlfp, hi, hih⟩ := key
  haveI := hi
  refine ⟨Y, h, hlfp, hqs, R.topIso.inv ≫ i, inferInstance, ?_⟩
  rw [Category.assoc, hih, ← Scheme.topIso_hom, Iso.inv_hom_id_assoc]

theorem wc_ap_fp_closed_approx_avoiding : ∀ (Y R : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y] (ι : R ⟶ Y) [IsClosedImmersion ι] (Q : Set Y), IsCompact Q → Disjoint Q (Set.range ι) → ∃ (Z : Scheme.{u}) (z : Z ⟶ Y) (κ : R ⟶ Z), IsClosedImmersion z ∧ LocallyOfFinitePresentation z ∧ κ ≫ z = ι ∧ Disjoint Q (Set.range z) :=
by
  intro Y R _ _ ι _ Q hQ hQι
  classical

  have E : ∀ (Y : Scheme.{u}) [QuasiSeparatedSpace Y] (K : Y.IdealSheafData) (O : Set Y), IsOpen O → IsCompact O → (∀ x ∈ O, ∃ U : Y.affineOpens, x ∈ (U : Set Y) ∧ (K.ideal U).FG) → ∀ (V : Y.affineOpens) (N₀ : Ideal Γ(Y, (V : Y.Opens))), N₀.FG → N₀ ≤ K.ideal V → ∃ K' : Y.IdealSheafData, K' ≤ K ∧ (∀ W : Y.affineOpens, (W : Set Y) ⊆ O → K'.ideal W = K.ideal W) ∧ N₀ ≤ K'.ideal V ∧ ∀ x ∈ O ∪ (V : Set Y), ∃ U : Y.affineOpens, x ∈ (U : Set Y) ∧ (K'.ideal U).FG := by
    intro Y _ K O hO hOc hK V N₀ hN₀ hN₀K

    have c1 : ∀ (S : Type u) [CommRing S] (f : Γ(Y, (V : Y.Opens)) →+* S)
        (M : Ideal Γ(Y, (V : Y.Opens))), (Ideal.map f M).FG →
        ∃ G : Finset Γ(Y, (V : Y.Opens)), (↑G : Set Γ(Y, (V : Y.Opens))) ⊆ M ∧
          Ideal.map f M ≤ Ideal.map f (Ideal.span (↑G : Set Γ(Y, (V : Y.Opens)))) := by
      intro S _ f M h
      obtain ⟨s, hs, hspan⟩ :=
        (Submodule.fg_span_iff_fg_span_finset_subset (f '' (M : Set Γ(Y, (V : Y.Opens))))).mp h
      obtain ⟨G, hGM, hGs⟩ := Finset.subset_set_image_iff.mp hs
      refine ⟨G, hGM, le_of_eq ?_⟩
      rw [Ideal.map_span, ← Finset.coe_image, hGs]
      exact hspan

    have c2 : IsCompact (O ∩ (V : Set Y)) →
        ∃ (m : ℕ) (b : Fin m → Γ(Y, (V : Y.Opens))),
          (O ∩ (V : Set Y) ⊆ ⋃ i, (Y.basicOpen (b i) : Set Y)) ∧
          ∀ i, (Ideal.map (Y.presheaf.map (homOfLE (Y.basicOpen_le (b i))).op).hom
            (K.ideal V)).FG := by
      intro hc
      have hpt : ∀ x : (O ∩ (V : Set Y) : Set Y), ∃ f : Γ(Y, (V : Y.Opens)),
          (x : Y) ∈ Y.basicOpen f ∧
          (Ideal.map (Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom (K.ideal V)).FG := by
        rintro ⟨x, hxO, hxV⟩
        obtain ⟨U, hxU, hU⟩ := hK x hxO
        obtain ⟨f, g, hfg, hxf⟩ := exists_basicOpen_le_affine_inter V.2 U.2 x ⟨hxV, hxU⟩
        refine ⟨f, hxf, ?_⟩
        have hA : Y.affineBasicOpen g = Y.affineBasicOpen f := Subtype.ext hfg.symm
        have hT : ∀ A B : Y.affineOpens, A = B → (K.ideal A).FG → (K.ideal B).FG := by
          rintro _ _ rfl h; exact h
        have h2 : (K.ideal (Y.affineBasicOpen g)).FG := by
          rw [← K.map_ideal_basicOpen U g]; exact hU.map _
        rw [K.map_ideal_basicOpen V f]
        exact hT _ _ hA h2
      choose f hxf hfFG using hpt
      obtain ⟨t, ht⟩ := hc.elim_finite_subcover (fun x => (Y.basicOpen (f x) : Set Y))
        (fun x => (Y.basicOpen (f x)).isOpen) (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hxf _⟩)
      refine ⟨t.card, fun i => f (t.equivFin.symm i), ?_, fun i => hfFG _⟩
      intro x hx
      obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp (ht hx)
      exact Set.mem_iUnion.mpr ⟨t.equivFin ⟨y, hy⟩, by simpa using hxy⟩

    have c3 : ∀ (N : Ideal Γ(Y, (V : Y.Opens))) (m : ℕ) (b : Fin m → Γ(Y, (V : Y.Opens)))
        (k : Γ(Y, (V : Y.Opens))),
        (∀ i, (Y.presheaf.map (homOfLE (Y.basicOpen_le (b i))).op).hom k ∈
          Ideal.map (Y.presheaf.map (homOfLE (Y.basicOpen_le (b i))).op).hom N) →
        ∀ (a : Γ(Y, (V : Y.Opens))), (Y.basicOpen a : Set Y) ⊆ ⋃ i, (Y.basicOpen (b i) : Set Y) →
        (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op).hom k ∈
          Ideal.map (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op).hom N := by
      intro N m b k hk a ha
      have hpow : ∀ i, ∃ n : ℕ, b i ^ n * k ∈ N := by
        intro i
        have := V.2.isLocalization_basicOpen (b i)
        obtain ⟨s, hs, hsk⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff
          (Submonoid.powers (b i)) Γ(Y, Y.basicOpen (b i)) N k).mp (hk i)
        obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hs
        exact ⟨n, hsk⟩
      choose n hn using hpow
      have hspan : Ideal.span (Set.range fun i =>
          (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op).hom (b i)) = ⊤ := by
        rw [← (V.2.basicOpen a).self_le_iSup_basicOpen_iff]
        intro y hy
        obtain ⟨i, hyi⟩ := Set.mem_iUnion.mp (ha hy)
        rw [TopologicalSpace.Opens.mem_iSup]
        refine ⟨⟨_, ⟨i, rfl⟩⟩, ?_⟩
        have := Scheme.basicOpen_res Y (b i) (homOfLE (Y.basicOpen_le a)).op
        change y ∈ Y.basicOpen
          ((ConcreteCategory.hom (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op)) (b i))
        rw [this]
        exact ⟨hy, hyi⟩
      apply Submodule.mem_of_span_eq_top_of_smul_pow_mem _ _ hspan
      rintro ⟨_, ⟨i, rfl⟩⟩
      refine ⟨n i, ?_⟩
      rw [smul_eq_mul, ← map_pow, ← map_mul]
      exact Ideal.mem_map_of_mem _ (hn i)

    have L4 : ∀ (N : Ideal Γ(Y, (V : Y.Opens))),
        (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk N)) ≫ V.2.fromSpec)).ideal V
          = N := by
      intro N
      set q := CommRingCat.ofHom (Ideal.Quotient.mk N)
      rw [Scheme.Hom.ker_apply]
      have hpre : (Spec.map q ≫ V.2.fromSpec) ⁻¹ᵁ (V : Y.Opens) = ⊤ := by
        refine eq_top_iff.mpr fun x _ => ?_
        show (Spec.map q ≫ V.2.fromSpec) x ∈ (V : Set Y)
        rw [Scheme.Hom.comp_apply, ← V.2.range_fromSpec]
        exact ⟨_, rfl⟩
      have he : (Spec.map q ≫ V.2.fromSpec).app V = q ≫ (Scheme.ΓSpecIso _).inv ≫
          (Spec (CommRingCat.of (Γ(Y, (V : Y.Opens)) ⧸ N))).presheaf.map (eqToHom hpre).op := by
        rw [Scheme.Hom.comp_app, IsAffineOpen.fromSpec_app_self (U := (V : Y.Opens)) V.2,
          Scheme.Hom.app_eq (Spec.map q)
            (IsAffineOpen.fromSpec_preimage_self (U := (V : Y.Opens)) V.2)]
        rw [Scheme.ΓSpecIso_inv_naturality_assoc]
        simp only [Category.assoc, eqToHom_op, eqToHom_map, eqToHom_trans_assoc, eqToHom_refl,
          Category.id_comp]
        rfl
      rw [he, CommRingCat.hom_comp,
        RingHom.ker_comp_of_injective _ (ConcreteCategory.bijective_of_isIso _).1]
      exact Ideal.mk_ker

    have L5 : ∀ (N : Ideal Γ(Y, (V : Y.Opens))),
        N ≤ (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk N)) ≫
          V.2.fromSpec)).ideal V →
        ∀ (U : Y.affineOpens) (g : Γ(Y, (U : Y.Opens))),
        (∀ (a : Γ(Y, (V : Y.Opens))) (hle : Y.basicOpen a ≤ (U : Y.Opens)),
          (Y.presheaf.map (homOfLE hle).op).hom g ∈
            Ideal.map (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op).hom N) →
        g ∈ (Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk N)) ≫
          V.2.fromSpec)).ideal U := by
      intro N hN U g hg
      rw [Scheme.Hom.ker_apply] at hN ⊢
      set T := Spec (CommRingCat.of (Γ(Y, (V : Y.Opens)) ⧸ N))
      set φ : T ⟶ Y := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk N)) ≫ V.2.fromSpec with hφ
      have nat : ∀ (U₁ U₂ : Y.Opens) (h : U₁ ≤ U₂) (x : Γ(Y, U₂)),
          (φ.app U₁).hom ((Y.presheaf.map (homOfLE h).op).hom x) =
            (T.presheaf.map (homOfLE (fun z hz => h hz : φ ⁻¹ᵁ U₁ ≤ φ ⁻¹ᵁ U₂)).op).hom
              ((φ.app U₂).hom x) :=
        fun U₁ U₂ h x => congrArg (fun k => k.hom x) (Scheme.Hom.naturality φ (homOfLE h).op)
      have step1 : ∀ a : Γ(Y, (V : Y.Opens)),
          Ideal.map (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op).hom N ≤
            RingHom.ker (φ.app (Y.basicOpen a)).hom := by
        intro a
        rw [Ideal.map_le_iff_le_comap]
        intro n hn
        rw [Ideal.mem_comap, RingHom.mem_ker, nat _ _ (Y.basicOpen_le a),
          RingHom.mem_ker.mp (hN hn), map_zero]
      let W : {a : Γ(Y, (V : Y.Opens)) // Y.basicOpen a ≤ (U : Y.Opens)} → T.Opens :=
        fun a => φ ⁻¹ᵁ (Y.basicOpen a.1)
      have hcov : φ ⁻¹ᵁ (U : Y.Opens) ≤ iSup W := by
        intro z hz
        have hzU : φ z ∈ (U : Set Y) := hz
        have hzV : φ z ∈ (V : Y.Opens) := by
          rw [hφ, Scheme.Hom.comp_apply]
          show _ ∈ (V : Set Y)
          rw [← V.2.range_fromSpec]
          exact ⟨_, rfl⟩
        obtain ⟨f, hfU, hzf⟩ := V.2.exists_basicOpen_le (V := (U : Y.Opens)) ⟨φ z, hzU⟩ hzV
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨f, hfU⟩, hzf⟩
      rw [RingHom.mem_ker]
      refine TopCat.Sheaf.eq_of_locally_eq' T.sheaf W (φ ⁻¹ᵁ (U : Y.Opens))
        (fun a => homOfLE (fun z hz => a.2 hz)) hcov _ 0 ?_
      intro a
      have h1 := (nat _ _ a.2 g).symm.trans (RingHom.mem_ker.mp (step1 a.1 (hg a.1 a.2)))
      exact h1.trans (map_zero _).symm

    have hA : IsCompact (O ∩ (V : Set Y)) :=
      QuasiSeparatedSpace.inter_isCompact O _ hO hOc (V : Y.Opens).isOpen V.2.isCompact
    obtain ⟨m, b, hcov, hFG⟩ := c2 hA
    have hG := fun i => c1 _ _ (K.ideal V) (hFG i)
    choose G hGsub hGgen using hG
    set G' := Finset.univ.biUnion G with hG'
    set N' : Ideal Γ(Y, (V : Y.Opens)) := N₀ ⊔ Ideal.span (↑G' : Set Γ(Y, (V : Y.Opens))) with hN'
    have hN'FG : N'.FG := Submodule.FG.sup hN₀ (Submodule.fg_span G'.finite_toSet)
    have hN₀N' : N₀ ≤ N' := le_sup_left
    have hN'K : N' ≤ K.ideal V := by
      refine sup_le hN₀K (Ideal.span_le.mpr (fun x hx => ?_))
      obtain ⟨i, -, hi⟩ := Finset.mem_biUnion.mp (Finset.mem_coe.mp hx)
      exact hGsub i (Finset.mem_coe.mpr hi)
    have hGN' : ∀ i, Ideal.span (↑(G i) : Set Γ(Y, (V : Y.Opens))) ≤ N' := fun i =>
      (Ideal.span_mono (Finset.coe_subset.mpr
        (Finset.subset_biUnion_of_mem G (Finset.mem_univ i)))).trans le_sup_right
    have hP : ∀ a : Γ(Y, (V : Y.Opens)), (Y.basicOpen a : Set Y) ⊆ O →
        Ideal.map (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op).hom (K.ideal V) ≤
          Ideal.map (Y.presheaf.map (homOfLE (Y.basicOpen_le a)).op).hom N' := by
      intro a ha
      rw [Ideal.map_le_iff_le_comap]
      intro k hk
      rw [Ideal.mem_comap]
      refine c3 N' m b k (fun i => ?_) a (fun y hy => hcov ⟨ha hy, Y.basicOpen_le a hy⟩)
      exact Ideal.map_mono (hGN' i) (hGgen i (Ideal.mem_map_of_mem _ hk))
    set J := Scheme.Hom.ker (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk N')) ≫ V.2.fromSpec)
      with hJ
    have hJV : J.ideal V = N' := L4 N'
    have hKJ : ∀ W : Y.affineOpens, (W : Set Y) ⊆ O → K.ideal W ≤ J.ideal W := by
      intro W hW g hg
      refine L5 N' hJV.ge W g (fun a hle => ?_)
      have hAW : Y.affineBasicOpen a ≤ W := hle
      have h1 : (Y.presheaf.map (homOfLE hAW).op).hom g ∈ K.ideal (Y.affineBasicOpen a) := by
        rw [← K.map_ideal hAW]; exact Ideal.mem_map_of_mem _ hg
      rw [← K.map_ideal_basicOpen V a] at h1
      exact hP a (fun y hy => hW (hle hy)) h1
    refine ⟨K ⊓ J, inf_le_left, fun W hW => ?_, ?_, ?_⟩
    · rw [Scheme.IdealSheafData.ideal_inf, Pi.inf_apply]
      exact inf_eq_left.mpr (hKJ W hW)
    · rw [Scheme.IdealSheafData.ideal_inf, Pi.inf_apply, hJV]
      exact le_inf hN₀K hN₀N'
    · rintro x (hxO | hxV)
      · obtain ⟨U, hxU, hU⟩ := hK x hxO
        obtain ⟨f, hfO, hxf⟩ := U.2.exists_basicOpen_le (V := ⟨O, hO⟩) ⟨x, hxO⟩ hxU
        refine ⟨Y.affineBasicOpen f, hxf, ?_⟩
        have hWO : ((Y.affineBasicOpen f : Y.affineOpens) : Set Y) ⊆ O := fun y hy => hfO hy
        rw [Scheme.IdealSheafData.ideal_inf, Pi.inf_apply, inf_eq_left.mpr (hKJ _ hWO),
          ← K.map_ideal_basicOpen U f]
        exact hU.map _
      · refine ⟨V, hxV, ?_⟩
        rw [Scheme.IdealSheafData.ideal_inf, Pi.inf_apply, hJV, inf_eq_right.mpr hN'K]
        exact hN'FG

  have fgLoc : ∀ (K : Y.IdealSheafData) (U : Y.affineOpens), (∀ x ∈ (U : Set Y), ∃ U' : Y.affineOpens, x ∈ (U' : Set Y) ∧ (K.ideal U').FG) → (K.ideal U).FG := by
    intro K U hloc
    let t : Set Γ(Y, U) := {f | (K.ideal (Y.affineBasicOpen f)).FG}
    have hspan : Ideal.span t = ⊤ := by
      rw [← U.2.self_le_iSup_basicOpen_iff]
      intro x hx
      obtain ⟨U', hxU', hFG⟩ := hloc x hx
      obtain ⟨f, g, hfg, hxf⟩ := exists_basicOpen_le_affine_inter U.2 U'.2 x ⟨hx, hxU'⟩
      have hg : (K.ideal (Y.affineBasicOpen g)).FG := by
        rw [← K.map_ideal_basicOpen U' g]
        exact hFG.map _
      have hA : Y.affineBasicOpen f = Y.affineBasicOpen g := Subtype.ext (by simpa using hfg)
      have hf : f ∈ t := by
        show (K.ideal (Y.affineBasicOpen f)).FG
        rw [hA]; exact hg
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨f, hf⟩, hxf⟩
    refine Ideal.fg_of_localizationSpan t hspan ?_
    rintro ⟨g, hg⟩
    haveI := U.2.isLocalization_basicOpen g
    let e := IsLocalization.algEquiv (Submonoid.powers g) Γ(Y, Y.basicOpen g) (Localization.Away g)
    have hcomp : algebraMap Γ(Y, U) (Localization.Away g) =
        (e : Γ(Y, Y.basicOpen g) →+* Localization.Away g).comp
          (algebraMap Γ(Y, U) Γ(Y, Y.basicOpen g)) := by
      ext r
      exact (e.commutes r).symm
    have h2 : Ideal.map (algebraMap Γ(Y, U) Γ(Y, Y.basicOpen g)) (K.ideal U) =
        K.ideal (Y.affineBasicOpen g) := K.map_ideal_basicOpen U g
    rw [hcomp, ← Ideal.map_map, h2]
    exact Ideal.FG.map hg _

  have lfpOf : ∀ (K : Y.IdealSheafData), (∀ U : Y.affineOpens, (K.ideal U).FG) → LocallyOfFinitePresentation K.subschemeι := by
    intro K hK
    have hstab : RingHom.StableUnderCompositionWithLocalizationAwaySource
        RingHom.FinitePresentation :=
      (RingHom.finitePresentation_stableUnderComposition.stableUnderCompositionWithLocalizationAway
        RingHom.finitePresentation_holdsForLocalizationAway).left
    rw [HasRingHomProperty.iff_exists_appLE (P := @LocallyOfFinitePresentation) hstab]
    intro x
    obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset
      (U := (⊤ : Y.Opens)) (x := K.subschemeι x) trivial
    let U₀ : Y.affineOpens := ⟨W, hW⟩
    let V₀ : K.subscheme.affineOpens := ⟨K.subschemeι ⁻¹ᵁ W, hW.preimage K.subschemeι⟩
    refine ⟨U₀, V₀, hxW, le_rfl, ?_⟩
    have hker : RingHom.ker (K.subschemeι.app W).hom = K.ideal U₀ := by
      rw [← Scheme.Hom.ker_apply K.subschemeι U₀, Scheme.IdealSheafData.ker_subschemeι]
    show RingHom.FinitePresentation (K.subschemeι.appLE W (K.subschemeι ⁻¹ᵁ W) le_rfl).hom
    rw [Scheme.Hom.appLE_eq_app]
    exact RingHom.FinitePresentation.of_surjective _ (K.subschemeι_app_surjective U₀)
      (hker ▸ hK U₀)

  have hpt : ∀ (I : Y.IdealSheafData) (y : Y), y ∉ I.support → ∃ K : Y.IdealSheafData, K ≤ I ∧ (∀ x : Y, ∃ U : Y.affineOpens, x ∈ (U : Set Y) ∧ (K.ideal U).FG) ∧ y ∉ K.support := by
    have H6 := E Y
    intro I y hy
    have hs1 : ∃ (V₀ : Y.affineOpens) (g : Γ(Y, (V₀ : Y.Opens))), g ∈ I.ideal V₀ ∧
        y ∈ Y.basicOpen g := by
      rw [Scheme.IdealSheafData.mem_support_iff] at hy
      push_neg at hy
      obtain ⟨V₀, hV₀⟩ := hy
      rw [Scheme.mem_zeroLocus_iff] at hV₀
      push_neg at hV₀
      obtain ⟨g, hg, hyg⟩ := hV₀
      exact ⟨V₀, g, hg, hyg⟩
    obtain ⟨V₀, g, hg, hyg⟩ := hs1
    have hyV₀ : y ∈ ((V₀ : Y.Opens) : Set Y) := Y.basicOpen_le g hyg
    obtain ⟨S₀, hS₀⟩ := isCompact_univ.elim_finite_subcover
      (fun W : Y.affineOpens => ((W : Y.Opens) : Set Y)) (fun W => (W : Y.Opens).isOpen) (by
        intro x _
        obtain ⟨W', hW', hxW', -⟩ :=
          exists_isAffineOpen_mem_and_subset (X := Y) (U := ⊤) (x := x) trivial
        exact Set.mem_iUnion.mpr ⟨⟨W', hW'⟩, hxW'⟩)
    have key : ∀ S : Finset Y.affineOpens, ∃ K : Y.IdealSheafData, K ≤ I ∧ g ∈ K.ideal V₀ ∧
        ∀ x ∈ ((V₀ : Y.Opens) : Set Y) ∪ ⋃ W ∈ S, ((W : Y.Opens) : Set Y),
          ∃ U : Y.affineOpens, x ∈ (U : Set Y) ∧ (K.ideal U).FG := by
      intro S
      induction S using Finset.induction_on with
      | empty =>
        obtain ⟨K₁, hK₁, -, hN, hloc⟩ := H6 I ∅ isOpen_empty isCompact_empty
          (fun x hx => absurd hx (Set.notMem_empty x)) V₀ (Ideal.span {g})
          (Submodule.fg_span_singleton g) ((Ideal.span_singleton_le_iff_mem _).mpr hg)
        refine ⟨K₁, hK₁, hN (Ideal.mem_span_singleton_self g), ?_⟩
        intro x hx
        apply hloc x
        simp only [Finset.notMem_empty, Set.iUnion_of_empty, Set.iUnion_empty,
          Set.union_empty] at hx
        exact Or.inr hx
      | insert W S hWS ih =>
        obtain ⟨KS, hKI, hgK, hloc⟩ := ih
        obtain ⟨K', hK'K, hagree, -, hloc'⟩ := H6 KS
          (((V₀ : Y.Opens) : Set Y) ∪ ⋃ W' ∈ S, ((W' : Y.Opens) : Set Y))
          ((V₀ : Y.Opens).isOpen.union (isOpen_biUnion fun W' _ => (W' : Y.Opens).isOpen))
          (V₀.2.isCompact.union (S.isCompact_biUnion fun W' _ => W'.2.isCompact)) hloc W ⊥
          Submodule.fg_bot bot_le
        refine ⟨K', le_trans hK'K hKI, ?_, ?_⟩
        · rw [hagree V₀ Set.subset_union_left]; exact hgK
        · intro x hx
          apply hloc' x
          rw [Finset.set_biUnion_insert] at hx
          rcases hx with h | h | h
          · exact Or.inl (Or.inl h)
          · exact Or.inr h
          · exact Or.inl (Or.inr h)
    obtain ⟨K, hKI, hgK, hloc⟩ := key S₀
    refine ⟨K, hKI, fun x => hloc x (Or.inr (hS₀ (Set.mem_univ x))), ?_⟩
    intro hyK
    rw [Scheme.IdealSheafData.mem_support_iff_of_mem hyV₀, Scheme.mem_zeroLocus_iff] at hyK
    exact hyK g hgK hyg
  set I := Scheme.Hom.ker ι with hI
  have hsupp : (I.support : Set Y) = Set.range ι := by
    rw [hI, Scheme.Hom.support_ker, ι.isClosedEmbedding.isClosed_range.closure_eq]
  have hK : ∀ y : Q, ∃ K : Y.IdealSheafData, K ≤ I ∧
      (∀ x : Y, ∃ U : Y.affineOpens, x ∈ (U : Set Y) ∧ (K.ideal U).FG) ∧
      (y : Y) ∉ K.support := by
    intro y
    apply hpt I y
    intro hy
    have hy' : (y : Y) ∈ (I.support : Set Y) := hy
    rw [hsupp] at hy'
    exact Set.disjoint_left.mp hQι y.2 hy'
  choose K hKI hKfg hKy using hK
  obtain ⟨t, ht⟩ := hQ.elim_finite_subcover (fun y : Q => ((K y).support : Set Y)ᶜ)
    (fun y => (K y).support.isClosed.isOpen_compl)
    (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hKy ⟨x, hx⟩⟩)
  set J : Y.IdealSheafData := ⨆ i : t, K i with hJ
  have hJI : J ≤ I := iSup_le fun i => hKI i
  have hJfg : ∀ U : Y.affineOpens, (J.ideal U).FG := by
    intro U
    rw [hJ, Scheme.IdealSheafData.ideal_iSup, iSup_apply]
    exact Submodule.fg_iSup _ fun i =>
      fgLoc (K i) U (fun x _ => hKfg i x)
  haveI hlfp := lfpOf J hJfg
  refine ⟨J.subscheme, J.subschemeι, IsClosedImmersion.lift J.subschemeι ι
    (by rw [Scheme.IdealSheafData.ker_subschemeι]; exact hJI), inferInstance, hlfp,
    IsClosedImmersion.lift_fac _ _ _, ?_⟩
  rw [Set.disjoint_left]
  intro x hx hxJ
  rw [Scheme.IdealSheafData.range_subschemeι, hJ, Scheme.IdealSheafData.support_iSup,
    TopologicalSpace.Closeds.coe_iInf, Set.mem_iInter] at hxJ
  obtain ⟨i, hi, hxi⟩ := Set.mem_iUnion₂.mp (ht hx)
  exact hxi (hxJ ⟨i, hi⟩)

theorem wc_ap_embed_into_fp_separated : ∀ (A : Type u) [CommRing A] (R : Scheme.{u}) (g : R ⟶ Spec (.of A)) [IsSeparated g] [LocallyOfFiniteType g] [QuasiCompact g], ∃ (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)) (_ : IsSeparated h) (_ : LocallyOfFinitePresentation h) (_ : QuasiCompact h) (ι : R ⟶ Y), IsClosedImmersion ι ∧ ι ≫ h = g :=
by
  intro A _ R g _ _ _

  obtain ⟨Y₀, h₀, hlfp₀, hqs₀, i, hi, hih⟩ := wc_ap_immersion_into_fp_quasiSeparated A R g
  haveI := hlfp₀
  haveI := hqs₀
  haveI := hi
  haveI : CompactSpace R := QuasiCompact.compactSpace_of_compactSpace g

  have hK : IsCompact (Set.range i) := isCompact_range i.continuous
  have hKlc : IsLocallyClosed (Set.range i) := Scheme.Hom.isLocallyClosed_range i
  have hW : IsOpen (coborder (Set.range i)) := hKlc.isOpen_coborder
  obtain ⟨t, ht⟩ := hK.elim_finite_subcover
    (fun j : {V : Set Y₀ // IsOpen V ∧ IsCompact V ∧ V ⊆ coborder (Set.range i)} => j.1)
    (fun j => j.2.1) (by
      intro x hx
      obtain ⟨v, ⟨hvo, hvc⟩, hxv, hvsub⟩ :=
        PrespectralSpace.isTopologicalBasis.exists_subset_of_mem_open (subset_coborder hx) hW
      exact Set.mem_iUnion.mpr ⟨⟨v, hvo, hvc, hvsub⟩, hxv⟩)
  have hU₀o : IsOpen (⋃ j ∈ t, j.1) := isOpen_biUnion fun j _ => j.2.1
  have hU₀c : IsCompact (⋃ j ∈ t, j.1) := t.isCompact_biUnion fun j _ => j.2.2.1
  have hU₀W : (⋃ j ∈ t, j.1) ⊆ coborder (Set.range i) := by
    intro x hx
    obtain ⟨j, _, hxj⟩ := Set.mem_iUnion₂.mp hx
    exact j.2.2.2 hxj
  let U : Y₀.Opens := ⟨⋃ j ∈ t, j.1, hU₀o⟩
  have hiU : Set.range i ⊆ Set.range U.ι := by
    rw [Scheme.Opens.range_ι]; exact ht
  let ι₁ : R ⟶ U := IsOpenImmersion.lift U.ι i hiU
  have hι₁ : ι₁ ≫ U.ι = i := IsOpenImmersion.lift_fac _ _ _
  haveI : IsPreimmersion (ι₁ ≫ U.ι) := by rw [hι₁]; infer_instance
  haveI : IsPreimmersion ι₁ := IsPreimmersion.of_comp ι₁ U.ι
  have hrangeι₁ : Set.range ι₁ = U.ι ⁻¹' closure (Set.range i) := by
    ext x
    constructor
    · rintro ⟨r, rfl⟩
      show U.ι (ι₁ r) ∈ closure (Set.range i)
      rw [← Scheme.Hom.comp_apply, hι₁]
      exact subset_closure ⟨r, rfl⟩
    · intro hx
      have hxU : U.ι x ∈ Set.range U.ι := ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι] at hxU
      have hxW : U.ι x ∈ coborder (Set.range i) := hU₀W hxU
      have hxK : U.ι x ∈ Set.range i := by
        rw [← closure_inter_coborder (s := Set.range i)]; exact ⟨hx, hxW⟩
      obtain ⟨r, hr⟩ := hxK
      refine ⟨r, U.ι.isEmbedding.injective ?_⟩
      rw [← Scheme.Hom.comp_apply, hι₁, hr]
  haveI hι₁c : IsClosedImmersion ι₁ := IsClosedImmersion.of_isPreimmersion ι₁ (by
    rw [hrangeι₁]; exact isClosed_closure.preimage U.ι.continuous)

  obtain ⟨h₁, hh₁⟩ : ∃ h₁ : (U : Scheme.{u}) ⟶ Spec (.of A), h₁ = U.ι ≫ h₀ := ⟨_, rfl⟩
  haveI hh₁lfp : LocallyOfFinitePresentation h₁ := by rw [hh₁]; infer_instance
  haveI hh₁qs : QuasiSeparated h₁ := by rw [hh₁]; infer_instance
  have hgh : ι₁ ≫ h₁ = g := by rw [hh₁, ← Category.assoc, hι₁, hih]
  haveI : CompactSpace (U : Scheme.{u}) := isCompact_iff_compactSpace.mp hU₀c
  haveI : QuasiCompact h₁ := (quasiCompact_iff_compactSpace h₁).mpr inferInstance
  haveI : QuasiSeparatedSpace (U : Scheme.{u}) := quasiSeparatedSpace_of_quasiSeparated h₁

  have hcomp : MorphismProperty.IsStableUnderComposition (@IsClosedImmersion) :=
    ⟨fun f g hf hg => by have := hf; have := hg; exact IsClosedImmersion.comp f g⟩
  have s5 : ∀ (Z : Scheme.{u}) (z : Z ⟶ U) [IsClosedImmersion z],
      IsSeparated (z ≫ h₁) ↔ IsClosed (Set.range (z ≫ Limits.pullback.diagonal h₁)) := by
    intro Z z _
    obtain ⟨M, hMdef⟩ : ∃ M, M = Limits.pullback.map (z ≫ h₁) (z ≫ h₁) h₁ h₁ z z
        (𝟙 (Spec (.of A))) (by simp) (by simp) := ⟨_, rfl⟩
    have hM : IsClosedImmersion M := by
      rw [hMdef]
      exact MorphismProperty.pullbackMap (P := @IsClosedImmersion)
        (inferInstanceAs (IsClosedImmersion z)) (inferInstanceAs (IsClosedImmersion z)) rfl rfl
    have hnat : Limits.pullback.diagonal (z ≫ h₁) ≫ M = z ≫ Limits.pullback.diagonal h₁ := by
      rw [hMdef]
      apply Limits.pullback.hom_ext <;>
        simp [Limits.pullback.map, Limits.pullback.lift_fst, Limits.pullback.lift_snd]
    haveI := hM
    constructor
    · intro hsep
      haveI : IsClosedImmersion (Limits.pullback.diagonal (z ≫ h₁) ≫ M) := inferInstance
      rw [← hnat]
      exact (Scheme.Hom.isClosedEmbedding _).isClosed_range
    · intro hcl
      haveI : IsClosedImmersion (z ≫ Limits.pullback.diagonal h₁) :=
        IsClosedImmersion.of_isPreimmersion _ hcl
      haveI : IsClosedImmersion (Limits.pullback.diagonal (z ≫ h₁) ≫ M) := by
        rw [hnat]; infer_instance
      exact IsSeparated.mk (IsClosedImmersion.of_comp _ M)

  have hgsep : IsSeparated (ι₁ ≫ h₁) := by rw [hgh]; infer_instance
  have hT : IsClosed (Set.range (ι₁ ≫ Limits.pullback.diagonal h₁)) := (s5 R ι₁).mp hgsep
  haveI : CompactSpace (Limits.pullback h₁ h₁ : Scheme.{u}) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst h₁ h₁ ≫ h₁)
  have hL : IsLocallyClosed (Set.range (Limits.pullback.diagonal h₁)) :=
    Scheme.Hom.isLocallyClosed_range _
  have hTL : Set.range (ι₁ ≫ Limits.pullback.diagonal h₁) ⊆
      Set.range (Limits.pullback.diagonal h₁) := by
    rintro _ ⟨r, rfl⟩
    exact ⟨ι₁ r, (Scheme.Hom.comp_apply _ _ _).symm⟩

  have hFcl : IsClosed (closure (Set.range (Limits.pullback.diagonal h₁)) \
      Set.range (Limits.pullback.diagonal h₁)) := by
    have he : closure (Set.range (Limits.pullback.diagonal h₁)) \
        Set.range (Limits.pullback.diagonal h₁) =
        (coborder (Set.range (Limits.pullback.diagonal h₁)))ᶜ := by
      unfold coborder; rw [compl_compl]
    rw [he]
    exact hL.isOpen_coborder.isClosed_compl
  obtain ⟨t', ht'⟩ := hFcl.isCompact.elim_finite_subcover
    (fun j : {V : Set ↥(Limits.pullback h₁ h₁ : Scheme.{u}) // IsOpen V ∧ IsCompact V ∧
      Disjoint V (Set.range (ι₁ ≫ Limits.pullback.diagonal h₁))} => j.1) (fun j => j.2.1) (by
      intro x hx
      have hxT : x ∈ (Set.range (ι₁ ≫ Limits.pullback.diagonal h₁))ᶜ := fun h => hx.2 (hTL h)
      obtain ⟨v, ⟨hvo, hvc⟩, hxv, hvsub⟩ :=
        PrespectralSpace.isTopologicalBasis.exists_subset_of_mem_open hxT hT.isOpen_compl
      exact Set.mem_iUnion.mpr ⟨⟨v, hvo, hvc, Set.disjoint_left.mpr fun a ha hb => hvsub ha hb⟩,
        hxv⟩)
  set O := ⋃ j ∈ t', j.1 with hO
  have hOo : IsOpen O := isOpen_biUnion fun j _ => j.2.1
  have hOc : IsCompact O := t'.isCompact_biUnion fun j _ => j.2.2.1
  have hOT : Disjoint O (Set.range (ι₁ ≫ Limits.pullback.diagonal h₁)) := by
    rw [Set.disjoint_left]
    intro a ha haT
    obtain ⟨j, _, haj⟩ := Set.mem_iUnion₂.mp ha
    exact Set.disjoint_left.mp j.2.2.2 haj haT
  have hguard : ∀ C : Set ↥(Limits.pullback h₁ h₁ : Scheme.{u}), IsClosed C →
      Disjoint O (Set.range (Limits.pullback.diagonal h₁) ∩ C) →
      IsClosed (Set.range (Limits.pullback.diagonal h₁) ∩ C) := by
    intro C hC hdisj
    apply isClosed_of_closure_subset
    intro p hp
    have hpC : p ∈ C := by
      have := closure_mono Set.inter_subset_right hp
      rwa [hC.closure_eq] at this
    have hpL : p ∈ closure (Set.range (Limits.pullback.diagonal h₁)) :=
      closure_mono Set.inter_subset_left hp
    by_cases hpL' : p ∈ Set.range (Limits.pullback.diagonal h₁)
    · exact ⟨hpL', hpC⟩
    · exfalso
      have hpO : p ∈ O := ht' ⟨hpL, hpL'⟩
      obtain ⟨w, hwO, hw⟩ := mem_closure_iff.mp hp O hOo hpO
      exact Set.disjoint_left.mp hdisj hwO hw

  have hQc : IsCompact (Limits.pullback.diagonal h₁ ⁻¹' O) :=
    QuasiCompact.isCompact_preimage O hOo hOc
  have hQι : Disjoint (Limits.pullback.diagonal h₁ ⁻¹' O) (Set.range ι₁) := by
    rw [Set.disjoint_left]
    rintro _ hyO ⟨r, rfl⟩
    exact Set.disjoint_left.mp hOT hyO ⟨r, Scheme.Hom.comp_apply _ _ _⟩

  obtain ⟨Z, z, κ, hz, hzl, hκ, hQz⟩ :=
    wc_ap_fp_closed_approx_avoiding (U : Scheme.{u}) R ι₁ _ hQc hQι
  haveI := hz
  haveI := hzl

  have hdiag : ∀ y : (U : Scheme.{u}),
      Limits.pullback.fst h₁ h₁ (Limits.pullback.diagonal h₁ y) = y := by
    intro y
    rw [← Scheme.Hom.comp_apply, Limits.pullback.diagonal_fst]
    rfl
  have hC : IsClosed (Limits.pullback.fst h₁ h₁ ⁻¹' Set.range z) :=
    z.isClosedEmbedding.isClosed_range.preimage (Limits.pullback.fst h₁ h₁).continuous
  have himg : Set.range (z ≫ Limits.pullback.diagonal h₁) =
      Set.range (Limits.pullback.diagonal h₁) ∩ Limits.pullback.fst h₁ h₁ ⁻¹' Set.range z := by
    ext p
    constructor
    · rintro ⟨w, rfl⟩
      refine ⟨⟨z w, (Scheme.Hom.comp_apply _ _ _).symm⟩, ?_⟩
      show Limits.pullback.fst h₁ h₁ ((z ≫ Limits.pullback.diagonal h₁) w) ∈ Set.range z
      rw [Scheme.Hom.comp_apply, hdiag]
      exact ⟨w, rfl⟩
    · rintro ⟨⟨y, rfl⟩, ⟨w, hw⟩⟩
      refine ⟨w, ?_⟩
      rw [Scheme.Hom.comp_apply, hw, hdiag]
  have hdisj : Disjoint O (Set.range (Limits.pullback.diagonal h₁) ∩
      Limits.pullback.fst h₁ h₁ ⁻¹' Set.range z) := by
    rw [Set.disjoint_left]
    rintro p hpO ⟨⟨y, rfl⟩, hpC⟩
    have hyz : y ∈ Set.range z := by
      have := hpC
      rw [Set.mem_preimage, hdiag] at this
      exact this
    exact Set.disjoint_left.mp hQz hpO hyz
  have hZcl : IsClosed (Set.range (z ≫ Limits.pullback.diagonal h₁)) := by
    rw [himg]; exact hguard _ hC hdisj

  haveI hzsep : IsSeparated (z ≫ h₁) := (s5 Z z).mpr hZcl

  haveI : IsClosedImmersion (κ ≫ z) := by rw [hκ]; infer_instance
  haveI : IsClosedImmersion κ := IsClosedImmersion.of_comp κ z
  refine ⟨Z, z ≫ h₁, hzsep, inferInstance, inferInstance, κ, inferInstance, ?_⟩
  rw [← Category.assoc, hκ, hgh]

theorem wc_ap_chow_finite_proper_cover : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)) (r : ℕ) (Z : Fin r → Scheme.{u}) (z : ∀ k, Z k ⟶ Y), (∀ k, IsProper (z k)) → (∀ y : Y, ∃ k, y ∈ Set.range (z k)) → (∀ k, ∃ (Y' P : Scheme.{u}) (π : Y' ⟶ Z k) (q : P ⟶ Spec (.of A)) (j : Y' ⟶ P), IsProper π ∧ Surjective π ∧ IsProper q ∧ IsImmersion j ∧ j ≫ q = π ≫ (z k ≫ h)) → ∃ (Y' P : Scheme.{u}) (π : Y' ⟶ Y) (q : P ⟶ Spec (.of A)) (j : Y' ⟶ P), IsProper π ∧ Surjective π ∧ IsProper q ∧ IsImmersion j ∧ j ≫ q = π ≫ h :=
by
  intro A _ Y h r Z z hz hcov hdata
  classical
  have hdesc : ∀ {X₁ X₂ T : Scheme.{u}} (f : X₁ ⟶ T) (g : X₂ ⟶ T), IsProper f → IsProper g →
      IsProper (Limits.coprod.desc f g) := by
    intro X₁ X₂ T f g hf hg
    have e : Limits.coprod.desc f g =
        Limits.coprod.map f g ≫ Limits.coprod.desc (𝟙 T) (𝟙 T) := by
      ext <;> simp
    haveI : IsProper (Limits.coprod.map f g) := IsZariskiLocalAtTarget.coprodMap f g hf hg
    rw [e]
    infer_instance
  have step : ∀ (Y₁ P₁ Y₂ P₂ : Scheme.{u}) (π₁ : Y₁ ⟶ Y) (q₁ : P₁ ⟶ Spec (.of A)) (j₁ : Y₁ ⟶ P₁)
      (π₂ : Y₂ ⟶ Y) (q₂ : P₂ ⟶ Spec (.of A)) (j₂ : Y₂ ⟶ P₂), IsProper π₁ → IsProper q₁ →
      IsImmersion j₁ → j₁ ≫ q₁ = π₁ ≫ h → IsProper π₂ → IsProper q₂ → IsImmersion j₂ →
      j₂ ≫ q₂ = π₂ ≫ h → ∃ (Y' P : Scheme.{u}) (π : Y' ⟶ Y) (q : P ⟶ Spec (.of A)) (j : Y' ⟶ P),
        IsProper π ∧ IsProper q ∧ IsImmersion j ∧ j ≫ q = π ≫ h ∧
        Set.range π = Set.range π₁ ∪ Set.range π₂ := by
    intro Y₁ P₁ Y₂ P₂ π₁ q₁ j₁ π₂ q₂ j₂ hπ₁ hq₁ hj₁ hs₁ hπ₂ hq₂ hj₂ hs₂
    refine ⟨Limits.coprod Y₁ Y₂, Limits.coprod P₁ P₂, Limits.coprod.desc π₁ π₂,
      Limits.coprod.desc q₁ q₂, Limits.coprod.map j₁ j₂,
      hdesc π₁ π₂ hπ₁ hπ₂, hdesc q₁ q₂ hq₁ hq₂,
      IsZariskiLocalAtTarget.coprodMap j₁ j₂ hj₁ hj₂, ?_, ?_⟩
    · ext <;> simp [hs₁, hs₂]
    · ext y
      constructor
      · rintro ⟨w, rfl⟩
        have hw : w ∈ Set.range (Limits.coprod.inl : Y₁ ⟶ Limits.coprod Y₁ Y₂) ∪
            Set.range (Limits.coprod.inr : Y₂ ⟶ Limits.coprod Y₁ Y₂) := by
          have hc := (isCompl_range_inl_inr Y₁ Y₂).sup_eq_top
          have hw' : w ∈ Set.range (Limits.coprod.inl : Y₁ ⟶ Limits.coprod Y₁ Y₂) ⊔
              Set.range (Limits.coprod.inr : Y₂ ⟶ Limits.coprod Y₁ Y₂) := by
            rw [hc]; trivial
          exact hw'
        rcases hw with ⟨a, rfl⟩ | ⟨a, rfl⟩
        · left; exact ⟨a, by rw [← Scheme.Hom.comp_apply, Limits.coprod.inl_desc]⟩
        · right; exact ⟨a, by rw [← Scheme.Hom.comp_apply, Limits.coprod.inr_desc]⟩
      · rintro (⟨a, rfl⟩ | ⟨a, rfl⟩)
        · exact ⟨(Limits.coprod.inl : Y₁ ⟶ Limits.coprod Y₁ Y₂) a,
            by rw [← Scheme.Hom.comp_apply, Limits.coprod.inl_desc]⟩
        · exact ⟨(Limits.coprod.inr : Y₂ ⟶ Limits.coprod Y₁ Y₂) a,
            by rw [← Scheme.Hom.comp_apply, Limits.coprod.inr_desc]⟩
  choose Yk Pk πk qk jk hπk hsk hqk hjk hsqk using hdata
  have claim : ∀ n, n ≤ r → ∃ (Y' P : Scheme.{u}) (π : Y' ⟶ Y) (q : P ⟶ Spec (.of A))
      (j : Y' ⟶ P), IsProper π ∧ IsProper q ∧ IsImmersion j ∧ j ≫ q = π ≫ h ∧
      Set.range π = {y | ∃ k : Fin r, k.val < n ∧ y ∈ Set.range (z k)} := by
    intro n
    induction n with
    | zero =>
      intro _
      refine ⟨Limits.initial Scheme.{u}, Limits.initial Scheme.{u}, Limits.initial.to Y,
        Limits.initial.to _, 𝟙 _,
        inferInstance, inferInstance, inferInstance, Limits.initial.hom_ext _ _, ?_⟩
      ext y
      simp
    | succ n ih =>
      intro hn
      obtain ⟨Y₁, P₁, π₁, q₁, j₁, hπ₁, hq₁, hj₁, hs₁, hr₁⟩ := ih (Nat.le_of_succ_le hn)
      let k₀ : Fin r := ⟨n, hn⟩
      haveI := hπk k₀
      haveI := hz k₀
      obtain ⟨Y', P, π, q, j, hπ, hq, hj, hs, hr⟩ := step Y₁ P₁ (Yk k₀) (Pk k₀) π₁ q₁ j₁
        (πk k₀ ≫ z k₀) (qk k₀) (jk k₀) hπ₁ hq₁ hj₁ hs₁ inferInstance (hqk k₀) (hjk k₀)
        (by rw [hsqk k₀, Category.assoc])
      refine ⟨Y', P, π, q, j, hπ, hq, hj, hs, ?_⟩
      have hrk : Set.range (πk k₀ ≫ z k₀) = Set.range (z k₀) := by
        ext y; constructor
        · rintro ⟨w, rfl⟩; exact ⟨πk k₀ w, (Scheme.Hom.comp_apply _ _ _).symm⟩
        · rintro ⟨w, rfl⟩
          obtain ⟨v, rfl⟩ := (hsk k₀).surj w
          exact ⟨v, Scheme.Hom.comp_apply _ _ _⟩
      rw [hr, hr₁, hrk]
      ext y
      constructor
      · rintro (⟨k, hk, hy⟩ | hy)
        · exact ⟨k, by omega, hy⟩
        · exact ⟨k₀, by simp [k₀], hy⟩
      · rintro ⟨k, hk, hy⟩
        rcases Nat.lt_succ_iff_lt_or_eq.mp hk with hk' | hk'
        · exact Or.inl ⟨k, hk', hy⟩
        · right
          have : k = k₀ := Fin.ext hk'
          rw [← this]; exact hy
  obtain ⟨Y', P, π, q, j, hπ, hq, hj, hs, hr⟩ := claim r le_rfl
  refine ⟨Y', P, π, q, j, hπ, ⟨fun y => ?_⟩, hq, hj, hs⟩
  obtain ⟨k, hk⟩ := hcov y
  have : y ∈ Set.range π := by rw [hr]; exact ⟨k, k.isLt, hk⟩
  exact this

theorem wc_ap_affine_ft_immersion_proper : ∀ (A : Type u) [CommRing A] (U : Scheme.{u}) (f : U ⟶ Spec (.of A)) [IsAffine U] [LocallyOfFiniteType f], ∃ (P : Scheme.{u}) (q : P ⟶ Spec (.of A)) (e : U ⟶ P), IsProper q ∧ IsImmersion e ∧ e ≫ q = f :=
by
  intro A _ U f _ _

  have s1 : ∀ (B : Type u) [CommRing B] (ψ : A →+* B), ψ.FiniteType →
      ∃ (n : ℕ) (s : Fin n → B), Function.Surjective (MvPolynomial.eval₂Hom ψ s) := by
    intro B _ ψ hψ
    letI := ψ.toAlgebra
    obtain ⟨n, g, hg⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp hψ
    refine ⟨n, fun k => g (MvPolynomial.X k), ?_⟩
    have key : MvPolynomial.eval₂Hom ψ (fun k => g (MvPolynomial.X k)) =
        (g : MvPolynomial (Fin n) A →+* B) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [MvPolynomial.eval₂Hom_C, RingHom.coe_coe]
        rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, RingHom.algebraMap_toAlgebra]
      · intro i
        simp [MvPolynomial.eval₂Hom_X']
    rw [key]
    exact hg

  have s2 : ∀ (B : Type u) [CommRing B] (ψ : A →+* B) (n : ℕ) (s : Fin n → B),
      Function.Surjective (MvPolynomial.eval₂Hom ψ s) →
      letI := @MvPolynomial.gradedAlgebra (Fin (n+1)) A _
      ∃ φ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n+1)) A)
          (MvPolynomial.X 0) →+* B,
        Function.Surjective φ ∧ ∀ a : A, φ (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (n+1)) A) (Submonoid.powers (MvPolynomial.X 0))
          (algebraMap A _ a)) = ψ a := by
    intro B _ ψ n s hsurj
    letI := @MvPolynomial.gradedAlgebra (Fin (n+1)) A _
    have hX₀ : (MvPolynomial.X 0 : MvPolynomial (Fin (n+1)) A) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n+1)) A 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X A 0)
    let ev := MvPolynomial.eval₂Hom ψ (Fin.cons 1 s : Fin (n+1) → B)
    have hev0 : ev (MvPolynomial.X 0) = 1 := by simp [ev]
    have hevS : ∀ k, ev (MvPolynomial.X k.succ) = s k := by intro k; simp [ev]
    have hevC : ∀ a, ev (MvPolynomial.C a) = ψ a := by intro a; simp [ev]
    have hu : IsUnit (ev (MvPolynomial.X 0)) := hev0 ▸ isUnit_one
    let φ₁ : Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (n+1)) A) →+* B :=
      Localization.awayLift ev _ hu
    let φ := φ₁.comp (algebraMap (HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (n+1)) A) (MvPolynomial.X 0))
      (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (n+1)) A)))
    have hφ : ∀ y, φ y = φ₁ y.val := fun y => rfl
    have hv : ev (MvPolynomial.X 0) * 1 = 1 := by rw [hev0, mul_one]
    have hA : ∀ a : A, φ (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (n+1)) A) (Submonoid.powers (MvPolynomial.X 0))
        (algebraMap A _ a)) = ψ a := by
      intro a
      rw [hφ]
      have h1 := Localization.awayLift_mk ev (MvPolynomial.X 0) (MvPolynomial.C a) 1 hv 0
      simp only [pow_zero, mul_one, hevC] at h1
      rw [← h1]
      congr 1
    have hS : ∀ k : Fin n, s k ∈ φ.range := by
      intro k
      have hk : (MvPolynomial.X k.succ : MvPolynomial (Fin (n+1)) A) ∈
          MvPolynomial.homogeneousSubmodule (Fin (n+1)) A (1 • 1) := by
        rw [smul_eq_mul, mul_one]
        exact (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X A _)
      refine ⟨HomogeneousLocalization.Away.mk _ hX₀ 1 (MvPolynomial.X k.succ) hk, ?_⟩
      rw [hφ, HomogeneousLocalization.Away.val_mk]
      have h1 := Localization.awayLift_mk ev (MvPolynomial.X 0) (MvPolynomial.X k.succ) 1 hv 1
      rw [one_pow, mul_one, hevS] at h1
      exact h1
    have hR : ∀ p : MvPolynomial (Fin n) A, MvPolynomial.eval₂Hom ψ s p ∈ φ.range := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a => rw [MvPolynomial.eval₂Hom_C]; exact ⟨_, hA a⟩
      | add p q hp hq => rw [map_add]; exact Subring.add_mem _ hp hq
      | mul_X p k hp => rw [map_mul, MvPolynomial.eval₂Hom_X']; exact Subring.mul_mem _ hp (hS k)
    refine ⟨φ, fun b => ?_, hA⟩
    obtain ⟨p, rfl⟩ := hsurj b
    exact hR p

  have s3 : ∀ n : ℕ, letI := @MvPolynomial.gradedAlgebra (Fin (n+1)) A _
      IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n+1)) A) ≫
        Spec.map (CommRingCat.ofHom
          (algebraMap A ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) A) 0)))) := by
    intro n
    letI := @MvPolynomial.gradedAlgebra (Fin (n+1)) A _
    letI : IsScalarTower A ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) A) 0)
        (MvPolynomial (Fin (n+1)) A) :=
      IsScalarTower.of_algebraMap_eq (R := A)
        (S := (MvPolynomial.homogeneousSubmodule (Fin (n+1)) A) 0)
        (A := MvPolynomial (Fin (n+1)) A) (fun r => rfl)
    haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) A) 0)
        (MvPolynomial (Fin (n+1)) A) :=
      Algebra.FiniteType.of_restrictScalars_finiteType A _ _
    haveI : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n+1)) A)) :=
      inferInstance
    have hbij : Function.Bijective
        (algebraMap A ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) A) 0)) := by
      constructor
      · intro a b hab
        have h := congrArg (fun x : (MvPolynomial.homogeneousSubmodule (Fin (n+1)) A) 0 =>
          (x : MvPolynomial (Fin (n+1)) A)) hab
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq] at h
        exact MvPolynomial.C_injective _ _ h
      · intro x
        have hx : (x : MvPolynomial (Fin (n+1)) A).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
        have ht : (x : MvPolynomial (Fin (n+1)) A).totalDegree = 0 :=
          Nat.le_zero.mp hx.totalDegree_le
        refine ⟨(x : MvPolynomial (Fin (n+1)) A).coeff 0, Subtype.ext ?_⟩
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp ht).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap A ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) A) 0))) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      exact hbij
    infer_instance

  let ψ : A →+* Γ(U, ⊤) := f.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom
  have hψ : ψ.FiniteType := by
    have h1 : (f.appTop.hom).FiniteType :=
      (HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFiniteType) (f := f)).mp inferInstance
    have h2 : ((Scheme.ΓSpecIso (.of A)).inv.hom).FiniteType :=
      RingHom.FiniteType.of_surjective _ (fun x =>
        ⟨(Scheme.ΓSpecIso (.of A)).hom.hom x, by
          rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]⟩)
    exact h1.comp h2
  obtain ⟨n, s, hs⟩ := s1 Γ(U, ⊤) ψ hψ
  letI := @MvPolynomial.gradedAlgebra (Fin (n+1)) A _
  obtain ⟨φ, hφs, hφ⟩ := s2 Γ(U, ⊤) ψ n s hs
  have hX₀ : (MvPolynomial.X 0 : MvPolynomial (Fin (n+1)) A) ∈
      MvPolynomial.homogeneousSubmodule (Fin (n+1)) A 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X A 0)
  refine ⟨Proj (MvPolynomial.homogeneousSubmodule (Fin (n+1)) A),
    Proj.toSpecZero _ ≫ Spec.map (CommRingCat.ofHom (algebraMap A _)),
    U.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom φ) ≫
      Proj.awayι _ (MvPolynomial.X 0) hX₀ Nat.one_pos, s3 n, ?_, ?_⟩
  · haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom φ)) :=
      IsClosedImmersion.spec_of_surjective _ hφs
    rw [← Category.assoc]
    infer_instance
  · simp only [Category.assoc, Proj.awayι_toSpecZero_assoc]
    rw [← Spec.map_comp, ← Spec.map_comp]
    have key : (CommRingCat.ofHom (algebraMap A ((MvPolynomial.homogeneousSubmodule (Fin (n+1)) A) 0)) ≫
        CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (n+1)) A) (Submonoid.powers (MvPolynomial.X 0)))) ≫
        CommRingCat.ofHom φ = (Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      exact hφ a
    rw [key, Spec.map_comp, ← Category.assoc, Scheme.isoSpec_hom_naturality, Category.assoc,
      Scheme.isoSpec_Spec_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]

theorem wc_ap_finite_fibre_product_proper : ∀ (S : Scheme.{u}) (m : ℕ) (P : Fin m → Scheme.{u}) (q : ∀ i, P i ⟶ S), (∀ i, IsProper (q i)) → ∃ (Q : Scheme.{u}) (qQ : Q ⟶ S) (pr : ∀ i, Q ⟶ P i), IsProper qQ ∧ (∀ i, pr i ≫ q i = qQ) ∧ ∀ (T : Scheme.{u}) (t : T ⟶ S) (a : ∀ i, T ⟶ P i), (∀ i, a i ≫ q i = t) → ∃ l : T ⟶ Q, (∀ i, l ≫ pr i = a i) ∧ l ≫ qQ = t :=
by
  intro S m
  induction m with
  | zero =>
    intro P q hq
    refine ⟨S, 𝟙 S, fun i => i.elim0, inferInstance, fun i => i.elim0, ?_⟩
    intro T t a ha
    exact ⟨t, fun i => i.elim0, Category.comp_id t⟩
  | succ m ih =>
    intro P q hq
    obtain ⟨Q', qQ', pr', hqQ', hpr', huniv'⟩ :=
      ih (fun j => P j.succ) (fun j => q j.succ) (fun j => hq j.succ)
    haveI := hq 0
    haveI := hqQ'
    refine ⟨Limits.pullback (q 0) qQ', Limits.pullback.snd (q 0) qQ' ≫ qQ',
      fun i => Fin.cases (motive := fun i => Limits.pullback (q 0) qQ' ⟶ P i)
        (Limits.pullback.fst (q 0) qQ') (fun j => Limits.pullback.snd (q 0) qQ' ≫ pr' j) i,
      inferInstance, ?_, ?_⟩
    · intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · simp only [Fin.cases_zero]
        exact Limits.pullback.condition
      · simp only [Fin.cases_succ, Category.assoc]
        rw [hpr' j]
    · intro T t a ha
      obtain ⟨l', hl'1, hl'2⟩ := huniv' T t (fun j => a j.succ) (fun j => ha j.succ)
      have w : a 0 ≫ q 0 = l' ≫ qQ' := (ha 0).trans hl'2.symm
      refine ⟨Limits.pullback.lift (a 0) l' w, ?_, ?_⟩
      · intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · simp only [Fin.cases_zero]
          exact Limits.pullback.lift_fst _ _ _
        · simp only [Fin.cases_succ]
          rw [Limits.pullback.lift_snd_assoc]
          exact hl'1 j
      · rw [Limits.pullback.lift_snd_assoc]
        exact hl'2

theorem wc_ap_reduced_factor_closed_immersion : ∀ (W X Y : Scheme.{u}) (g : W ⟶ Y) (z : X ⟶ Y) [IsClosedImmersion z] [IsReduced W], Set.range g ⊆ Set.range z → ∃ g' : W ⟶ X, g' ≫ z = g :=
by
  intro W X Y g z _ _ hrange
  have H : z.ker ≤ g.ker := by
    show z.ker ≤ Scheme.IdealSheafData.ofIdeals (fun U : Y.affineOpens => RingHom.ker (g.app U).hom)
    rw [Scheme.IdealSheafData.le_ofIdeals_iff]
    intro U s hs
    have hz : (z.app U).hom s = 0 :=
      Scheme.IdealSheafData.ideal_ofIdeals_le
        (I := fun U : Y.affineOpens => RingHom.ker (z.app U).hom) U hs
    have hX : z ⁻¹ᵁ Y.basicOpen s = ⊥ := by
      rw [Scheme.Hom.preimage_basicOpen]
      erw [hz]
      exact Scheme.basicOpen_zero _ _
    have hW : W.basicOpen ((g.app U).hom s) = ⊥ := by
      rw [← Scheme.Hom.preimage_basicOpen, eq_bot_iff]
      intro w hw
      obtain ⟨x, hx⟩ := hrange ⟨w, rfl⟩
      have hx' : x ∈ z ⁻¹ᵁ Y.basicOpen s := by
        show z x ∈ Y.basicOpen s
        rw [hx]; exact hw
      rw [hX] at hx'
      exact hx'.elim
    exact eq_zero_of_basicOpen_eq_bot _ hW
  exact ⟨IsClosedImmersion.lift z g H, IsClosedImmersion.lift_fac z g H⟩

theorem wc_ap_proper_preimage_immersion_restrict : ∀ (U P Z : Scheme.{u}) [IsReduced Z] (e : U ⟶ P) (p : Z ⟶ P) [IsImmersion e] [IsProper p] (D : Set Z), Dense D → p '' D ⊆ Set.range e → ∃ (V : Z.Opens) (πV : (V : Scheme.{u}) ⟶ U), D ⊆ (V : Set Z) ∧ IsProper πV ∧ πV ≫ e = V.ι ≫ p :=
by
  intro U P Z _ e p _ _ D hD hpD

  have hfac : ∀ (W X Y : Scheme.{u}) (g : W ⟶ Y) (z : X ⟶ Y) [IsClosedImmersion z] [IsReduced W],
      Set.range g ⊆ Set.range z → ∃ g' : W ⟶ X, g' ≫ z = g := by
    intro W X Y g z _ _ hrange
    have H : z.ker ≤ g.ker := by
      show z.ker ≤ Scheme.IdealSheafData.ofIdeals
        (fun V' : Y.affineOpens => RingHom.ker (g.app V').hom)
      rw [Scheme.IdealSheafData.le_ofIdeals_iff]
      intro U s hs
      have hz : (z.app U).hom s = 0 := by
        rw [Scheme.Hom.ker_apply] at hs
        exact hs
      have hX : z ⁻¹ᵁ Y.basicOpen s = ⊥ := by
        rw [Scheme.Hom.preimage_basicOpen]
        erw [hz]
        exact Scheme.basicOpen_zero _ _
      have hW : W.basicOpen ((g.app U).hom s) = ⊥ := by
        rw [← Scheme.Hom.preimage_basicOpen, eq_bot_iff]
        intro w hw
        obtain ⟨x, hx⟩ := hrange ⟨w, rfl⟩
        have hx' : x ∈ z ⁻¹ᵁ Y.basicOpen s := by
          show z x ∈ Y.basicOpen s
          rw [hx]; exact hw
        rw [hX] at hx'
        exact hx'.elim
      exact eq_zero_of_basicOpen_eq_bot _ hW
    exact ⟨IsClosedImmersion.lift z g H, IsClosedImmersion.lift_fac z g H⟩
  set C : P.Opens := e.coborderRange with hC
  have hCset : (C : Set P) = coborder (Set.range e) := rfl
  set V : Z.Opens := p ⁻¹ᵁ C with hV
  have hDV : D ⊆ (V : Set Z) := by
    intro z hz
    show p z ∈ (C : Set P)
    rw [hCset]
    exact subset_coborder (hpD ⟨z, hz, rfl⟩)
  have hVe : ∀ z : Z, z ∈ V → p z ∈ Set.range e := by
    intro z hz
    have hzc : z ∈ closure D := by rw [hD.closure_eq]; trivial
    have h1 : p z ∈ closure (p '' D) :=
      image_closure_subset_closure_image p.continuous ⟨z, hzc, rfl⟩
    have h2 : p z ∈ closure (Set.range e) := closure_mono hpD h1
    have h3 : p z ∈ coborder (Set.range e) := by
      rw [← hCset]; exact hz
    rw [← closure_inter_coborder (s := Set.range e)]
    exact ⟨h2, h3⟩
  let r : (V : Scheme.{u}) ⟶ (C : Scheme.{u}) := p ∣_ C
  let c : U ⟶ (C : Scheme.{u}) := e.liftCoborder
  have hcι : c ≫ C.ι = e := Scheme.Hom.liftCoborder_ι e
  have hrι : r ≫ C.ι = V.ι ≫ p := morphismRestrict_ι p C
  have hrange : Set.range r ⊆ Set.range c := by
    rintro _ ⟨v, rfl⟩
    have hv : V.ι v ∈ V := by
      have : V.ι v ∈ Set.range V.ι := ⟨v, rfl⟩
      rwa [Scheme.Opens.range_ι] at this
    obtain ⟨x, hx⟩ := hVe _ hv
    refine ⟨x, ?_⟩
    apply C.ι.isOpenEmbedding.isEmbedding.injective
    rw [← Scheme.Hom.comp_apply, hcι, hx, ← Scheme.Hom.comp_apply, ← hrι, Scheme.Hom.comp_apply]
  obtain ⟨πV, hπV⟩ := hfac (V : Scheme.{u}) U (C : Scheme.{u}) r c hrange
  haveI : IsProper (πV ≫ c) := by rw [hπV]; infer_instance
  haveI : IsProper πV := IsProper.of_comp πV c
  refine ⟨V, πV, hDV, inferInstance, ?_⟩
  rw [← hcι, ← Category.assoc, hπV, hrι]

theorem wc_ap_glue_dense_compatible : ∀ (S Y Z W : Scheme.{u}) [IsReduced Z] (h : Y ⟶ S) [IsSeparated h] (qZ : Z ⟶ S) (m : ℕ) (V : Fin m → Z.Opens) (f : ∀ i, (V i : Scheme.{u}) ⟶ Y) (g' : W ⟶ Z) (w : W ⟶ Y), DenseRange g' → (∀ i, f i ≫ h = (V i).ι ≫ qZ) → (∀ i, ∃ gi : W ⟶ (V i : Scheme.{u}), gi ≫ (V i).ι = g' ∧ gi ≫ f i = w) → ∃ π : ((⨆ i, V i : Z.Opens) : Scheme.{u}) ⟶ Y, (∀ i, Z.homOfLE (le_iSup V i) ≫ π = f i) ∧ π ≫ h = (⨆ i, V i).ι ≫ qZ :=
by
  intro S Y Z W _ h _ qZ m V f g' w hdense hf hgi
  choose gi hgi1 hgi2 using hgi
  have he : ∀ i, Z.homOfLE (le_iSup V i) ≫ (⨆ i, V i).ι = (V i).ι := fun i =>
    Scheme.homOfLE_ι Z (le_iSup V i)
  let 𝒰 := Scheme.Opens.iSupOpenCover V
  have hcompat : ∀ (i j : 𝒰.I₀), Limits.pullback.fst (𝒰.f i) (𝒰.f j) ≫ f i =
      Limits.pullback.snd (𝒰.f i) (𝒰.f j) ≫ f j := by
    intro i j
    change Limits.pullback.fst (Z.homOfLE (le_iSup V i)) (Z.homOfLE (le_iSup V j)) ≫ f i =
      Limits.pullback.snd (Z.homOfLE (le_iSup V i)) (Z.homOfLE (le_iSup V j)) ≫ f j
    have hc : gi i ≫ Z.homOfLE (le_iSup V i) = gi j ≫ Z.homOfLE (le_iSup V j) := by
      rw [← cancel_mono (⨆ i, V i).ι, Category.assoc, Category.assoc, he i, he j, hgi1 i,
        hgi1 j]
    let ι : W ⟶ Limits.pullback (Z.homOfLE (le_iSup V i)) (Z.homOfLE (le_iSup V j)) :=
      Limits.pullback.lift (gi i) (gi j) hc
    have hι1 : ι ≫ Limits.pullback.fst _ _ = gi i := Limits.pullback.lift_fst _ _ _
    have hι2 : ι ≫ Limits.pullback.snd _ _ = gi j := Limits.pullback.lift_snd _ _ _
    let k := Limits.pullback.fst (Z.homOfLE (le_iSup V i)) (Z.homOfLE (le_iSup V j)) ≫ (V i).ι
    haveI : IsOpenImmersion k := inferInstance
    have hk : ι ≫ k = g' := by
      simp only [k]
      rw [← Category.assoc, hι1, hgi1 i]
    haveI : IsDominant ι := by
      refine ⟨?_⟩
      apply dense_iff_closure_eq.mpr
      rw [k.isOpenEmbedding.isInducing.closure_eq_preimage_closure_image, ← Set.range_comp]
      have hc' : ⇑k ∘ ⇑ι = ⇑g' := by
        funext x
        rw [Function.comp_apply, ← Scheme.Hom.comp_apply, hk]
      rw [hc', hdense.closure_range, Set.preimage_univ]
    haveI : IsReduced (Limits.pullback (Z.homOfLE (le_iSup V i)) (Z.homOfLE (le_iSup V j))) :=
      isReduced_of_isOpenImmersion
        (Limits.pullback.fst (Z.homOfLE (le_iSup V i)) (Z.homOfLE (le_iSup V j)))
    refine ext_of_isDominant_of_isSeparated h ?_ ι ?_
    · rw [Category.assoc, Category.assoc, hf i, hf j, ← he i, ← he j]
      simp only [← Category.assoc]
      rw [Limits.pullback.condition]
    · rw [← Category.assoc, ← Category.assoc, hι1, hι2, hgi2 i, hgi2 j]
  let π := 𝒰.glueMorphisms (fun i => f i) hcompat
  have hπ : ∀ i, Z.homOfLE (le_iSup V i) ≫ π = f i := fun i =>
    Scheme.Cover.ι_glueMorphisms 𝒰 (fun i => f i) hcompat i
  refine ⟨π, hπ, ?_⟩
  refine Scheme.Cover.hom_ext 𝒰 _ _ (fun i => ?_)
  change Z.homOfLE (le_iSup V i) ≫ π ≫ h = Z.homOfLE (le_iSup V i) ≫ (⨆ i, V i).ι ≫ qZ
  rw [← Category.assoc, hπ i, hf i, ← Category.assoc, he i]

theorem wc_ap_proper_of_local_proper_dense : ∀ (O Y : Scheme.{u}) (π : O ⟶ Y) [IsSeparated π] (m : ℕ) (U : Fin m → Y.Opens) (Vs : Fin m → Scheme.{u}) (v : ∀ i, Vs i ⟶ O) (ρ : ∀ i, Vs i ⟶ (U i : Scheme.{u})) (D : Set O), iSup U = ⊤ → Dense D → (∀ i, IsOpenImmersion (v i)) → (∀ i, D ⊆ Set.range (v i)) → (∀ i, IsProper (ρ i)) → (∀ i, ρ i ≫ (U i).ι = v i ≫ π) → IsProper π :=
by
  intro O Y π _ m U Vs v ρ D hsup hD hv hDv hρ hcomm
  refine (IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := @IsProper) U hsup).mpr ?_
  intro i
  haveI := hv i
  haveI := hρ i
  set N : O.Opens := π ⁻¹ᵁ U i with hN
  have h2 : Set.range (v i) ⊆ Set.range N.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨y, rfl⟩
    show π (v i y) ∈ U i
    have e : π (v i y) = (U i).ι (ρ i y) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hcomm i]
    rw [e]
    have : (U i).ι (ρ i y) ∈ Set.range (U i).ι := ⟨_, rfl⟩
    rwa [Scheme.Opens.range_ι] at this
  set v' : Vs i ⟶ (N : Scheme.{u}) := IsOpenImmersion.lift N.ι (v i) h2 with hv'
  have hfac : v' ≫ N.ι = v i := IsOpenImmersion.lift_fac _ _ _
  haveI : IsOpenImmersion (v' ≫ N.ι) := by rw [hfac]; infer_instance
  haveI : IsOpenImmersion v' := IsOpenImmersion.of_comp v' N.ι
  have heq : v' ≫ (π ∣_ U i) = ρ i := by
    rw [← cancel_mono (U i).ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, hfac,
      hcomm i]
  haveI : UniversallyClosed (v' ≫ (π ∣_ U i)) := by rw [heq]; infer_instance
  haveI : UniversallyClosed v' := UniversallyClosed.of_comp_of_isSeparated v' (π ∣_ U i)
  have hcl : IsClosed (Set.range v') := (Scheme.Hom.isClosedMap v').isClosed_range
  have hsub : N.ι ⁻¹' D ⊆ Set.range v' := by
    intro x hx
    obtain ⟨y, hy⟩ := hDv i hx
    refine ⟨y, ?_⟩
    apply N.ι.isOpenEmbedding.isEmbedding.injective
    rw [← Scheme.Hom.comp_apply, hfac, hy]
  have hdense : Dense (N.ι ⁻¹' D) := hD.preimage N.ι.isOpenEmbedding.isOpenMap
  have huniv : Set.range v' = Set.univ := by
    apply Set.eq_univ_of_univ_subset
    rw [← hdense.closure_eq]
    exact closure_minimal hsub hcl
  haveI : IsIso v' := (isIso_iff_isOpenImmersion_and_surjective v').mpr
    ⟨inferInstance, ⟨Set.range_eq_univ.mp huniv⟩⟩
  rw [← IsIso.inv_hom_id_assoc v' (π ∣_ U i), heq]
  infer_instance

theorem wc_ap_chow_dense_affine_cover : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)) [IsSeparated h] [LocallyOfFiniteType h] [IsReduced Y] (m : ℕ) (U : Fin m → Y.Opens), (∀ i, IsAffineOpen (U i)) → iSup U = ⊤ → Dense (⋂ i, (U i : Set Y)) → ∃ (Y' P : Scheme.{u}) (π : Y' ⟶ Y) (q : P ⟶ Spec (.of A)) (j : Y' ⟶ P), IsProper π ∧ Surjective π ∧ IsProper q ∧ IsImmersion j ∧ j ≫ q = π ≫ h :=
by
  intro A _ Y h _ _ _ m U hU hsup hdense

  set W : Y.Opens := ⨅ i, U i with hWdef
  have hWcoe : (W : Set Y) = ⋂ i, (U i : Set Y) := TopologicalSpace.Opens.coe_iInf U
  have hW : Dense (W : Set Y) := by rw [hWcoe]; exact hdense
  have hWle : ∀ i, W ≤ U i := fun i => iInf_le U i
  have hchart : ∀ i, ∃ (P : Scheme.{u}) (q : P ⟶ Spec (.of A)) (e : (U i : Scheme.{u}) ⟶ P),
      IsProper q ∧ IsImmersion e ∧ e ≫ q = (U i).ι ≫ h := by
    intro i
    haveI : IsAffine (U i : Scheme.{u}) := hU i
    exact wc_ap_affine_ft_immersion_proper A (U i) ((U i).ι ≫ h)
  choose P q e hq he heq using hchart

  obtain ⟨Q, qQ, pr, hqQ, hpr, huniv⟩ :=
    wc_ap_finite_fibre_product_proper (Spec (.of A)) m P q hq
  haveI := hqQ
  have hprP : ∀ i, IsProper (pr i) := by
    intro i
    haveI := hq i
    haveI : IsProper (pr i ≫ q i) := by rw [hpr i]; exact hqQ
    exact IsProper.of_comp (pr i) (q i)
  have ha : ∀ i, (Y.homOfLE (hWle i) ≫ e i) ≫ q i = W.ι ≫ h := by
    intro i
    simp only [Category.assoc, heq i, Scheme.homOfLE_ι_assoc]
  obtain ⟨g, hg, -⟩ := huniv (W : Scheme.{u}) (W.ι ≫ h) (fun i => Y.homOfLE (hWle i) ≫ e i) ha

  have hT : IsClosed (closure (Set.range g)) := isClosed_closure
  let I := Scheme.IdealSheafData.vanishingIdeal
    (⟨closure (Set.range g), hT⟩ : TopologicalSpace.Closeds Q)
  obtain ⟨R, r, hr, hrsurj, hred⟩ := wc_reduced_subscheme_exists I.subscheme
  haveI := hr
  haveI := hred
  obtain ⟨zQ, hzQ, hzQr⟩ : ∃ zQ : R ⟶ Q, zQ = r ≫ I.subschemeι ∧ True := ⟨_, rfl, trivial⟩
  haveI : IsClosedImmersion zQ := by rw [hzQ]; infer_instance
  have hzQrange : Set.range zQ = closure (Set.range g) := by
    have h1 : Set.range I.subschemeι = closure (Set.range g) := by
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    rw [← h1, hzQ]
    ext x
    constructor
    · rintro ⟨w, rfl⟩
      exact ⟨r w, by simp [Scheme.Hom.comp_apply]⟩
    · rintro ⟨v, rfl⟩
      have hv : v ∈ Set.range r := hrsurj ▸ Set.mem_univ v
      obtain ⟨w, rfl⟩ := hv
      exact ⟨w, by simp [Scheme.Hom.comp_apply]⟩
  obtain ⟨g', hg'⟩ := wc_ap_reduced_factor_closed_immersion (W : Scheme.{u}) R Q g zQ
    (by rw [hzQrange]; exact subset_closure)
  have hg'dense : DenseRange g' := by
    apply dense_iff_closure_eq.mpr
    rw [zQ.isClosedEmbedding.isInducing.closure_eq_preimage_closure_image, ← Set.range_comp]
    have hc : ⇑zQ ∘ ⇑g' = ⇑g := by
      funext x
      rw [Function.comp_apply, ← Scheme.Hom.comp_apply, hg']
    rw [hc, ← hzQrange, Set.preimage_range]

  have hrestr : ∀ i, ∃ (V : R.Opens) (πV : (V : Scheme.{u}) ⟶ (U i : Scheme.{u})),
      Set.range g' ⊆ (V : Set R) ∧ IsProper πV ∧ πV ≫ e i = V.ι ≫ (zQ ≫ pr i) := by
    intro i
    haveI := he i
    haveI := hprP i
    refine wc_ap_proper_preimage_immersion_restrict (U i) (P i) R (e i) (zQ ≫ pr i)
      (Set.range g') hg'dense ?_
    rintro _ ⟨_, ⟨x, rfl⟩, rfl⟩
    refine ⟨Y.homOfLE (hWle i) x, ?_⟩
    have hx : (g' ≫ zQ ≫ pr i) x = (Y.homOfLE (hWle i) ≫ e i) x := by
      rw [← Category.assoc, hg', hg i]
    simpa only [Scheme.Hom.comp_apply] using hx.symm
  choose V πV hVg hπV hπVeq using hrestr

  have hf : ∀ i, (πV i ≫ (U i).ι) ≫ h = (V i).ι ≫ (zQ ≫ qQ) := by
    intro i
    calc (πV i ≫ (U i).ι) ≫ h = (πV i ≫ e i) ≫ q i := by
          simp only [Category.assoc, heq i]
      _ = ((V i).ι ≫ (zQ ≫ pr i)) ≫ q i := by rw [hπVeq i]
      _ = (V i).ι ≫ (zQ ≫ qQ) := by simp only [Category.assoc, hpr i]
  have hgiex : ∀ i, ∃ gi : (W : Scheme.{u}) ⟶ (V i : Scheme.{u}), gi ≫ (V i).ι = g' := by
    intro i
    exact ⟨IsOpenImmersion.lift (V i).ι g' (by rw [Scheme.Opens.range_ι]; exact hVg i),
      IsOpenImmersion.lift_fac _ _ _⟩
  choose gi hgi1 using hgiex
  have hgi2 : ∀ i, gi i ≫ πV i = Y.homOfLE (hWle i) := by
    intro i
    haveI := he i
    rw [← cancel_mono (e i)]
    calc (gi i ≫ πV i) ≫ e i = gi i ≫ (V i).ι ≫ zQ ≫ pr i := by
          rw [Category.assoc, hπVeq i]
      _ = ((gi i ≫ (V i).ι) ≫ zQ) ≫ pr i := by simp only [Category.assoc]
      _ = Y.homOfLE (hWle i) ≫ e i := by rw [hgi1 i, hg', hg i]
  have hgi : ∀ i, ∃ gi' : (W : Scheme.{u}) ⟶ (V i : Scheme.{u}),
      gi' ≫ (V i).ι = g' ∧ gi' ≫ (πV i ≫ (U i).ι) = W.ι := by
    intro i
    refine ⟨gi i, hgi1 i, ?_⟩
    rw [← Category.assoc, hgi2 i, Scheme.homOfLE_ι]
  obtain ⟨π, hπ1, hπ2⟩ := wc_ap_glue_dense_compatible (Spec (.of A)) Y R (W : Scheme.{u}) h
    (zQ ≫ qQ) m V (fun i => πV i ≫ (U i).ι) g' W.ι hg'dense hf hgi

  haveI : IsSeparated (π ≫ h) := by rw [hπ2]; infer_instance
  haveI : IsSeparated π := IsSeparated.of_comp π h

  have hmemU : ∀ x : (W : Scheme.{u}), ∃ i, W.ι x ∈ U i := by
    intro x
    have hx : W.ι x ∈ iSup U := by rw [hsup]; trivial
    exact TopologicalSpace.Opens.mem_iSup.mp hx
  have hO : Set.range g' ⊆ Set.range (⨆ i, V i).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨x, rfl⟩
    obtain ⟨i, -⟩ := hmemU x
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨i, hVg i ⟨x, rfl⟩⟩
  obtain ⟨g'', hg''⟩ : ∃ g'' : (W : Scheme.{u}) ⟶ ((⨆ i, V i : R.Opens) : Scheme.{u}),
      g'' ≫ (⨆ i, V i).ι = g' :=
    ⟨IsOpenImmersion.lift (⨆ i, V i).ι g' hO, IsOpenImmersion.lift_fac _ _ _⟩
  have hg''i : ∀ i, g'' = gi i ≫ R.homOfLE (le_iSup V i) := by
    intro i
    rw [← cancel_mono (⨆ i, V i).ι, hg'', Category.assoc, Scheme.homOfLE_ι, hgi1 i]
  have hDdense : Dense (Set.range g'') := by
    apply dense_iff_closure_eq.mpr
    rw [(⨆ i, V i).ι.isOpenEmbedding.isInducing.closure_eq_preimage_closure_image,
      ← Set.range_comp]
    have hc : ⇑(⨆ i, V i).ι ∘ ⇑g'' = ⇑g' := by
      funext x
      rw [Function.comp_apply, ← Scheme.Hom.comp_apply, hg'']
    rw [hc, hg'dense.closure_range, Set.preimage_univ]
  have hDsub : ∀ i, Set.range g'' ⊆ Set.range (R.homOfLE (le_iSup V i)) := by
    intro i
    rintro _ ⟨x, rfl⟩
    refine ⟨gi i x, ?_⟩
    rw [hg''i i, Scheme.Hom.comp_apply]

  have hπproper : IsProper π :=
    wc_ap_proper_of_local_proper_dense ((⨆ i, V i : R.Opens) : Scheme.{u}) Y π m U
      (fun i => (V i : Scheme.{u}))
      (fun i => R.homOfLE (le_iSup V i)) πV (Set.range g'') hsup hDdense
      (fun i => inferInstance) hDsub hπV (fun i => (hπ1 i).symm)

  have hπsurj : Surjective π := by
    refine ⟨fun y => ?_⟩
    have hcl : IsClosed (Set.range π) := π.isClosedMap.isClosed_range
    have hWsub : (W : Set Y) ⊆ Set.range π := by
      intro y hy
      have hy' : y ∈ Set.range W.ι := by rw [Scheme.Opens.range_ι]; exact hy
      obtain ⟨x, rfl⟩ := hy'
      obtain ⟨i, -⟩ := hmemU x
      have e1 : g'' ≫ π = W.ι := by
        rw [hg''i i, Category.assoc, hπ1 i, ← Category.assoc, hgi2 i, Scheme.homOfLE_ι]
      exact ⟨g'' x, by rw [← Scheme.Hom.comp_apply, e1]⟩
    have hy : y ∈ closure (W : Set Y) := by rw [hW.closure_eq]; trivial
    exact closure_minimal hWsub hcl hy
  exact ⟨_, R, π, zQ ≫ qQ, (⨆ i, V i).ι, hπproper, hπsurj, inferInstance, inferInstance,
    hπ2.symm⟩

theorem wc_ap_chow_cover_induction : ∀ (A : Type u) [CommRing A], (∀ (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)) [IsSeparated h] [LocallyOfFiniteType h] [IsReduced Y] (m : ℕ) (U : Fin m → Y.Opens), (∀ i, IsAffineOpen (U i)) → iSup U = ⊤ → Dense (⋂ i, (U i : Set Y)) → ∃ (Y' P : Scheme.{u}) (π : Y' ⟶ Y) (q : P ⟶ Spec (.of A)) (j : Y' ⟶ P), IsProper π ∧ Surjective π ∧ IsProper q ∧ IsImmersion j ∧ j ≫ q = π ≫ h) → (∀ (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)) (r : ℕ) (Z : Fin r → Scheme.{u}) (z : ∀ k, Z k ⟶ Y), (∀ k, IsProper (z k)) → (∀ y : Y, ∃ k, y ∈ Set.range (z k)) → (∀ k, ∃ (Y' P : Scheme.{u}) (π : Y' ⟶ Z k) (q : P ⟶ Spec (.of A)) (j : Y' ⟶ P), IsProper π ∧ Surjective π ∧ IsProper q ∧ IsImmersion j ∧ j ≫ q = π ≫ (z k ≫ h)) → ∃ (Y' P : Scheme.{u}) (π : Y' ⟶ Y) (q : P ⟶ Spec (.of A)) (j : Y' ⟶ P), IsProper π ∧ Surjective π ∧ IsProper q ∧ IsImmersion j ∧ j ≫ q = π ≫ h) → ∀ (m : ℕ) (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)) [IsSeparated h] [LocallyOfFiniteType h] (U : Fin m → Y.Opens), (∀ i, IsAffineOpen (U i)) → iSup U = ⊤ → ∃ (Y' P : Scheme.{u}) (π : Y' ⟶ Y) (q : P ⟶ Spec (.of A)) (j : Y' ⟶ P), IsProper π ∧ Surjective π ∧ IsProper q ∧ IsImmersion j ∧ j ≫ q = π ≫ h :=
by
  have s0 : ∀ (C : Scheme.{u}), ∃ (R : Scheme.{u}) (r : R ⟶ C),
      IsClosedImmersion r ∧ Set.range r = Set.univ ∧ IsReduced R := by
    intro C
    let J : C.IdealSheafData := (⊥ : C.IdealSheafData).radical
    have h2 : Set.range J.subschemeι = Set.univ := by
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_radical,
        Scheme.IdealSheafData.support_bot, TopologicalSpace.Closeds.coe_top]
    have hring : ∀ U : C.affineOpens, _root_.IsReduced (Γ(C, U) ⧸ J.ideal U) := fun U =>
      (Ideal.isRadical_iff_quotient_reduced _).mp
        (by
          show ((⊥ : C.IdealSheafData).radical.ideal U).IsRadical
          rw [Scheme.IdealSheafData.radical_ideal]
          exact Ideal.radical_isRadical _)
    have hpieces : ∀ i, IsReduced (J.subschemeCover.openCover.X i) := fun (U : C.affineOpens) => by
      haveI := hring U
      exact (inferInstance : IsReduced (Spec (CommRingCat.of (Γ(C, (U : C.Opens)) ⧸ J.ideal U))))
    have h3 : IsReduced J.subscheme := IsReduced.of_openCover _ J.subschemeCover.openCover
    exact ⟨J.subscheme, J.subschemeι, inferInstance, h2, h3⟩
  have s1 : ∀ (Y : Scheme.{u}) (T : Set Y), IsClosed T → ∃ (Z : Scheme.{u}) (z : Z ⟶ Y),
      IsClosedImmersion z ∧ Set.range z = T ∧ IsReduced Z := by
    intro Y T hT
    let I := Scheme.IdealSheafData.vanishingIdeal (⟨T, hT⟩ : TopologicalSpace.Closeds Y)
    obtain ⟨R, r, hr, hrr, hred⟩ := s0 I.subscheme
    haveI := hr
    refine ⟨R, r ≫ I.subschemeι, inferInstance, ?_, hred⟩
    have hrange : Set.range I.subschemeι = T := by
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    rw [← hrange]
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      exact ⟨r x, (Scheme.Hom.comp_apply _ _ _).symm⟩
    · rintro ⟨w, rfl⟩
      have hw : w ∈ Set.range r := by rw [hrr]; trivial
      obtain ⟨x, rfl⟩ := hw
      exact ⟨x, Scheme.Hom.comp_apply _ _ _⟩
  have s2 : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] (f : X → Y),
      Topology.IsInducing f → ∀ (W : Set Y), Set.range f = closure W → Dense (f ⁻¹' W) := by
    intro X Y _ _ f hf W hW
    rw [hf.dense_iff]
    intro x
    rw [Set.image_preimage_eq_inter_range, hW, Set.inter_eq_left.mpr subset_closure, ← hW]
    exact ⟨x, rfl⟩
  intro A _ hc6 hc1 m
  induction m with
  | zero =>
    intro Y h _ _ U hU hsup
    refine hc1 Y h 0 (fun k => k.elim0) (fun k => k.elim0) (fun k => k.elim0) ?_
      (fun k => k.elim0)
    intro y
    have hy : y ∈ iSup U := by rw [hsup]; trivial
    obtain ⟨i, _⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
    exact i.elim0
  | succ n ih =>
    intro Y h _ _ U hU hsup
    set W : Set Y := ⋂ i, (U i : Set Y) with hW
    let T : Fin (n + 2) → Set Y := Fin.cases (closure W) (fun i => ((U i : Set Y))ᶜ)
    have hT : ∀ k, IsClosed (T k) := by
      intro k
      refine Fin.cases ?_ (fun i => ?_) k
      · exact isClosed_closure
      · exact (U i).isOpen.isClosed_compl
    choose Z z hzi hzr hzred using fun k => s1 Y (T k) (hT k)
    refine hc1 Y h (n + 2) Z z (fun k => ?_) ?_ (fun k => ?_)
    · haveI := hzi k; infer_instance
    · intro y
      by_cases hy : y ∈ W
      · exact ⟨0, by rw [hzr 0]; exact subset_closure hy⟩
      · have hex : ∃ i, y ∉ (U i : Set Y) := by
          by_contra hc
          push_neg at hc
          exact hy (Set.mem_iInter.mpr hc)
        obtain ⟨i, hi⟩ := hex
        exact ⟨i.succ, by rw [hzr i.succ]; exact hi⟩
    · rcases Fin.eq_zero_or_eq_succ k with rfl | ⟨i, rfl⟩
      · haveI := hzi 0
        haveI := hzred 0
        have hU' : ∀ i, IsAffineOpen (z 0 ⁻¹ᵁ U i) := fun i => (hU i).preimage (z 0)
        have hsup' : iSup (fun i => z 0 ⁻¹ᵁ U i) = ⊤ := by
          rw [← Scheme.Hom.preimage_iSup, hsup, Scheme.Hom.preimage_top]
        have hdense : Dense (⋂ i, ((z 0 ⁻¹ᵁ U i : (Z 0).Opens) : Set (Z 0))) := by
          have he : (⋂ i, ((z 0 ⁻¹ᵁ U i : (Z 0).Opens) : Set (Z 0))) = z 0 ⁻¹' W := by
            rw [hW, Set.preimage_iInter]
            rfl
          rw [he]
          exact s2 (z 0) (z 0).isClosedEmbedding.isInducing W (hzr 0)
        exact hc6 (Z 0) (z 0 ≫ h) (n + 1) (fun i => z 0 ⁻¹ᵁ U i) hU' hsup' hdense
      · haveI := hzi i.succ
        haveI := hzred i.succ
        have hU'' : ∀ l, IsAffineOpen (z i.succ ⁻¹ᵁ U (i.succAbove l)) :=
          fun l => (hU _).preimage _
        have hsup'' : iSup (fun l : Fin n => z i.succ ⁻¹ᵁ U (i.succAbove l)) = ⊤ := by
          rw [eq_top_iff]
          intro x _
          have hx : z i.succ x ∈ iSup U := by rw [hsup]; trivial
          obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
          have hxi : z i.succ x ∉ (U i : Set Y) := by
            have hm : z i.succ x ∈ T i.succ := by rw [← hzr i.succ]; exact ⟨x, rfl⟩
            exact hm
          have hji : j ≠ i := by
            rintro rfl
            exact hxi hj
          obtain ⟨l, hl⟩ := Fin.exists_succAbove_eq hji
          rw [TopologicalSpace.Opens.mem_iSup]
          refine ⟨l, ?_⟩
          show z i.succ x ∈ U (i.succAbove l)
          rw [hl]
          exact hj
        exact ih (Z i.succ) (z i.succ ≫ h) (fun l => z i.succ ⁻¹ᵁ U (i.succAbove l)) hU'' hsup''

theorem wc_ap_chow_lemma_affine : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)) [IsSeparated h] [LocallyOfFiniteType h] [QuasiCompact h], ∃ (Y' P : Scheme.{u}) (π : Y' ⟶ Y) (q : P ⟶ Spec (.of A)) (j : Y' ⟶ P), IsProper π ∧ Surjective π ∧ IsProper q ∧ IsImmersion j ∧ j ≫ q = π ≫ h :=
by
  intro A _ Y h _ _ _
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace h
  have hcov : ∀ y : Y, ∃ V : Y.affineOpens, y ∈ (V : Set Y) := by
    intro y
    obtain ⟨V, hV, hyV, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens Y)) (show y ∈ (⊤ : Y.Opens) from trivial)
    exact ⟨⟨V, hV⟩, hyV⟩
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover
    (fun V : Y.affineOpens => ((V : Y.Opens) : Set Y)) (fun V => (V : Y.Opens).isOpen)
    (fun y _ => Set.mem_iUnion.mpr (hcov y))
  let U : Fin t.card → Y.Opens := fun k => ((t.equivFin.symm k : t) : Y.affineOpens)
  have hU : ∀ k, IsAffineOpen (U k) := fun k => ((t.equivFin.symm k : t) : Y.affineOpens).2
  have hsup : iSup U = ⊤ := by
    rw [eq_top_iff]
    intro y _
    obtain ⟨V, hVt, hyV⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ y))
    rw [TopologicalSpace.Opens.mem_iSup]
    refine ⟨t.equivFin ⟨V, hVt⟩, ?_⟩
    simp only [U, Equiv.symm_apply_apply]
    exact hyV
  exact wc_ap_chow_cover_induction A (wc_ap_chow_dense_affine_cover A)
    (wc_ap_chow_finite_proper_cover A) t.card Y h U hU hsup

theorem wc_ap_closed_immersion_into_fp_proper : ∀ (A : Type u) [CommRing A] (R : Scheme.{u}) (g : R ⟶ Spec (.of A)) [IsProper g], ∃ (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)) (_ : IsProper h) (_ : LocallyOfFinitePresentation h) (ι : R ⟶ Y), IsClosedImmersion ι ∧ ι ≫ h = g :=
by
  intro A _ R g _

  obtain ⟨Y', h', hsep, hlfp, hqc, ι, hι, hιh⟩ := wc_ap_embed_into_fp_separated A R g
  haveI := hsep
  haveI := hlfp
  haveI := hqc
  haveI := hι

  obtain ⟨Y'', P, π, q, jj, hπ, hπs, hq, hjj, hjq⟩ := wc_ap_chow_lemma_affine A Y' h'
  haveI := hπ
  haveI := hπs
  haveI := hq
  haveI := hjj

  haveI : CompactSpace P := QuasiCompact.compactSpace_of_compactSpace q
  haveI : CompactSpace Y' := QuasiCompact.compactSpace_of_compactSpace h'
  haveI : QuasiSeparatedSpace Y' := quasiSeparatedSpace_of_quasiSeparated h'
  haveI : QuasiCompact (jj ≫ q) := by rw [hjq]; infer_instance
  haveI : QuasiCompact jj := QuasiCompact.of_comp jj q

  have hrange : ∀ (Z : Scheme.{u}) (z : Z ⟶ Y'),
      Set.range (Limits.pullback.snd z π ≫ jj) = jj '' (π ⁻¹' Set.range z) := by
    intro Z z
    ext p
    constructor
    · rintro ⟨w, rfl⟩
      refine ⟨Limits.pullback.snd z π w, ⟨Limits.pullback.fst z π w, ?_⟩, ?_⟩
      · rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
      · exact (Scheme.Hom.comp_apply _ _ _).symm
    · rintro ⟨y, ⟨x, hx⟩, rfl⟩
      obtain ⟨w, _, hw2⟩ := Scheme.Pullback.exists_preimage_pullback x y hx
      exact ⟨w, by rw [Scheme.Hom.comp_apply, hw2]⟩
  have hsq : ∀ (Z : Scheme.{u}) (z : Z ⟶ Y'),
      (Limits.pullback.snd z π ≫ jj) ≫ q = Limits.pullback.fst z π ≫ (z ≫ h') := by
    intro Z z
    rw [Category.assoc, hjq, ← Category.assoc, ← Limits.pullback.condition, Category.assoc]

  have hT : IsClosed (jj '' (π ⁻¹' Set.range ι)) := by
    haveI : IsProper (ι ≫ h') := by rw [hιh]; infer_instance
    haveI : UniversallyClosed ((Limits.pullback.snd ι π ≫ jj) ≫ q) := by
      rw [hsq]; infer_instance
    haveI : UniversallyClosed (Limits.pullback.snd ι π ≫ jj) :=
      UniversallyClosed.of_comp_of_isSeparated _ q
    rw [← hrange]
    exact (Scheme.Hom.isClosedMap _).isClosed_range

  have hTL : jj '' (π ⁻¹' Set.range ι) ⊆ Set.range jj := Set.image_subset_range _ _
  have hLlc : IsLocallyClosed (Set.range jj) := Scheme.Hom.isLocallyClosed_range jj
  have hFcl : IsClosed (closure (Set.range jj) \ Set.range jj) := by
    have he : closure (Set.range jj) \ Set.range jj = (coborder (Set.range jj))ᶜ := by
      unfold coborder; rw [compl_compl]
    rw [he]
    exact hLlc.isOpen_coborder.isClosed_compl
  obtain ⟨t, ht⟩ := hFcl.isCompact.elim_finite_subcover
    (fun i : {U : Set P // IsOpen U ∧ IsCompact U ∧
      Disjoint U (jj '' (π ⁻¹' Set.range ι))} => i.1) (fun i => i.2.1) (by
      intro x hx
      have hxT : x ∈ (jj '' (π ⁻¹' Set.range ι))ᶜ := fun h => hx.2 (hTL h)
      obtain ⟨v, ⟨hvo, hvc⟩, hxv, hvsub⟩ :=
        PrespectralSpace.isTopologicalBasis.exists_subset_of_mem_open hxT hT.isOpen_compl
      exact Set.mem_iUnion.mpr ⟨⟨v, hvo, hvc, Set.disjoint_left.mpr fun a ha hb => hvsub ha hb⟩,
        hxv⟩)
  set O : Set P := ⋃ i ∈ t, i.1 with hO
  have hOo : IsOpen O := isOpen_biUnion fun i _ => i.2.1
  have hOc : IsCompact O := t.isCompact_biUnion fun i _ => i.2.2.1
  have hOT : Disjoint O (jj '' (π ⁻¹' Set.range ι)) := by
    rw [Set.disjoint_left]
    intro a ha haT
    obtain ⟨i, _, hai⟩ := Set.mem_iUnion₂.mp ha
    exact Set.disjoint_left.mp i.2.2.2 hai haT
  have hguard : ∀ C : Set P, IsClosed C → Disjoint O (Set.range jj ∩ C) →
      IsClosed (Set.range jj ∩ C) := by
    intro C hC hdisj
    apply isClosed_of_closure_subset
    intro p hp
    have hpC : p ∈ C := by
      have := closure_mono Set.inter_subset_right hp
      rwa [hC.closure_eq] at this
    have hpL : p ∈ closure (Set.range jj) := closure_mono Set.inter_subset_left hp
    by_cases hpL' : p ∈ Set.range jj
    · exact ⟨hpL', hpC⟩
    · exfalso
      have hpO : p ∈ O := ht ⟨hpL, hpL'⟩
      obtain ⟨w, hwO, hw⟩ := mem_closure_iff.mp hp O hOo hpO
      exact Set.disjoint_left.mp hdisj hwO hw

  have hQc : IsCompact (π '' (jj ⁻¹' O)) :=
    (QuasiCompact.isCompact_preimage O hOo hOc).image π.continuous
  have hQι : Disjoint (π '' (jj ⁻¹' O)) (Set.range ι) := by
    rw [Set.disjoint_left]
    rintro _ ⟨y, hyO, rfl⟩ ⟨r, hr⟩
    exact Set.disjoint_left.mp hOT hyO ⟨y, ⟨r, hr⟩, rfl⟩

  obtain ⟨Z, z, κ, hz, hzl, hκ, hQz⟩ :=
    wc_ap_fp_closed_approx_avoiding Y' R ι (π '' (jj ⁻¹' O)) hQc hQι
  haveI := hz
  haveI := hzl

  have hM : IsClosed (π ⁻¹' Set.range z) :=
    z.isClosedEmbedding.isClosed_range.preimage π.continuous
  obtain ⟨C, hC, hCM⟩ := (jj.isEmbedding.isInducing.isClosed_iff).mp hM
  have himg : jj '' (π ⁻¹' Set.range z) = Set.range jj ∩ C := by
    rw [← hCM, Set.image_preimage_eq_range_inter]
  have hdisj : Disjoint O (Set.range jj ∩ C) := by
    rw [Set.disjoint_left]
    rintro p hpO ⟨⟨y, rfl⟩, hpC⟩
    have hy : y ∈ jj ⁻¹' C := hpC
    rw [hCM] at hy
    exact Set.disjoint_left.mp hQz ⟨y, hpO, rfl⟩ hy
  have hZcl : IsClosed (jj '' (π ⁻¹' Set.range z)) := by
    rw [himg]; exact hguard C hC hdisj

  haveI : IsClosedImmersion (Limits.pullback.snd z π ≫ jj) :=
    IsClosedImmersion.of_isPreimmersion _ (by rw [hrange]; exact hZcl)
  haveI : UniversallyClosed (Limits.pullback.fst z π ≫ (z ≫ h')) := by
    rw [← hsq]; infer_instance
  haveI : UniversallyClosed (z ≫ h') := UniversallyClosed.of_comp_surjective (Limits.pullback.fst z π) _
  haveI : IsProper (z ≫ h') := IsProper.mk

  haveI : IsClosedImmersion (κ ≫ z) := by rw [hκ]; infer_instance
  haveI : IsClosedImmersion κ := IsClosedImmersion.of_comp κ z
  refine ⟨Z, z ≫ h', inferInstance, inferInstance, κ, inferInstance, ?_⟩
  rw [← Category.assoc, hκ, hιh]

theorem wc_idealSheaf_fg_approx_point : ∀ (Y : Scheme.{u}) [CompactSpace Y], (∀ (K : Y.IdealSheafData) (O : Set Y), IsOpen O → IsCompact O → (∀ x ∈ O, ∃ U : Y.affineOpens, x ∈ (U : Set Y) ∧ (K.ideal U).FG) → ∀ (V : Y.affineOpens) (N₀ : Ideal Γ(Y, (V : Y.Opens))), N₀.FG → N₀ ≤ K.ideal V → ∃ K' : Y.IdealSheafData, K' ≤ K ∧ (∀ W : Y.affineOpens, (W : Set Y) ⊆ O → K'.ideal W = K.ideal W) ∧ N₀ ≤ K'.ideal V ∧ ∀ x ∈ O ∪ (V : Set Y), ∃ U : Y.affineOpens, x ∈ (U : Set Y) ∧ (K'.ideal U).FG) → ∀ (I : Y.IdealSheafData) (y : Y), y ∉ I.support → ∃ K : Y.IdealSheafData, K ≤ I ∧ (∀ x : Y, ∃ U : Y.affineOpens, x ∈ (U : Set Y) ∧ (K.ideal U).FG) ∧ y ∉ K.support :=
by
  classical
  intro Y _ H6 I y hy
  have hs1 : ∃ (V₀ : Y.affineOpens) (g : Γ(Y, (V₀ : Y.Opens))), g ∈ I.ideal V₀ ∧
      y ∈ Y.basicOpen g := by
    rw [Scheme.IdealSheafData.mem_support_iff] at hy
    push_neg at hy
    obtain ⟨V₀, hV₀⟩ := hy
    rw [Scheme.mem_zeroLocus_iff] at hV₀
    push_neg at hV₀
    obtain ⟨g, hg, hyg⟩ := hV₀
    exact ⟨V₀, g, hg, hyg⟩
  obtain ⟨V₀, g, hg, hyg⟩ := hs1
  have hyV₀ : y ∈ ((V₀ : Y.Opens) : Set Y) := Y.basicOpen_le g hyg
  obtain ⟨S₀, hS₀⟩ := isCompact_univ.elim_finite_subcover
    (fun W : Y.affineOpens => ((W : Y.Opens) : Set Y)) (fun W => (W : Y.Opens).isOpen) (by
      intro x _
      obtain ⟨W', hW', hxW', -⟩ :=
        exists_isAffineOpen_mem_and_subset (X := Y) (U := ⊤) (x := x) trivial
      exact Set.mem_iUnion.mpr ⟨⟨W', hW'⟩, hxW'⟩)
  have key : ∀ S : Finset Y.affineOpens, ∃ K : Y.IdealSheafData, K ≤ I ∧ g ∈ K.ideal V₀ ∧
      ∀ x ∈ ((V₀ : Y.Opens) : Set Y) ∪ ⋃ W ∈ S, ((W : Y.Opens) : Set Y),
        ∃ U : Y.affineOpens, x ∈ (U : Set Y) ∧ (K.ideal U).FG := by
    intro S
    induction S using Finset.induction_on with
    | empty =>
      obtain ⟨K₁, hK₁, -, hN, hloc⟩ := H6 I ∅ isOpen_empty isCompact_empty
        (fun x hx => absurd hx (Set.notMem_empty x)) V₀ (Ideal.span {g})
        (Submodule.fg_span_singleton g) ((Ideal.span_singleton_le_iff_mem _).mpr hg)
      refine ⟨K₁, hK₁, hN (Ideal.mem_span_singleton_self g), ?_⟩
      intro x hx
      apply hloc x
      simp only [Finset.notMem_empty, Set.iUnion_of_empty, Set.iUnion_empty,
        Set.union_empty] at hx
      exact Or.inr hx
    | insert W S hWS ih =>
      obtain ⟨KS, hKI, hgK, hloc⟩ := ih
      obtain ⟨K', hK'K, hagree, -, hloc'⟩ := H6 KS
        (((V₀ : Y.Opens) : Set Y) ∪ ⋃ W' ∈ S, ((W' : Y.Opens) : Set Y))
        ((V₀ : Y.Opens).isOpen.union (isOpen_biUnion fun W' _ => (W' : Y.Opens).isOpen))
        (V₀.2.isCompact.union (S.isCompact_biUnion fun W' _ => W'.2.isCompact)) hloc W ⊥
        Submodule.fg_bot bot_le
      refine ⟨K', le_trans hK'K hKI, ?_, ?_⟩
      · rw [hagree V₀ Set.subset_union_left]; exact hgK
      · intro x hx
        apply hloc' x
        rw [Finset.set_biUnion_insert] at hx
        rcases hx with h | h | h
        · exact Or.inl (Or.inl h)
        · exact Or.inr h
        · exact Or.inl (Or.inr h)
  obtain ⟨K, hKI, hgK, hloc⟩ := key S₀
  refine ⟨K, hKI, fun x => hloc x (Or.inr (hS₀ (Set.mem_univ x))), ?_⟩
  intro hyK
  rw [Scheme.IdealSheafData.mem_support_iff_of_mem hyV₀, Scheme.mem_zeroLocus_iff] at hyK
  exact hyK g hgK hyg

theorem wc_ap_fp_proper_shrink_closed_fibre : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (R Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)) [IsProper h] [LocallyOfFinitePresentation h] (ι : R ⟶ Y) [IsClosedImmersion ι], ∃ (Z : Scheme.{u}) (hZ : Z ⟶ Spec (.of A)) (_ : IsProper hZ) (_ : LocallyOfFinitePresentation hZ) (κ : R ⟶ Z), IsClosedImmersion κ ∧ κ ≫ hZ = ι ≫ h ∧ hZ ⁻¹' {IsLocalRing.closedPoint A} ⊆ Set.range κ :=
by
  classical
  intro A _ _ R Y h _ _ ι _
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace h
  haveI : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated h
  set s₀ := IsLocalRing.closedPoint A with hs₀

  let I : Y.IdealSheafData := Scheme.Hom.ker ι
  have hIsupp : (I.support : Set Y) = Set.range ι := by
    show ((Scheme.Hom.ker ι).support : Set Y) = Set.range ι
    rw [Scheme.Hom.support_ker ι]
    exact ι.isClosedEmbedding.isClosed_range.closure_eq

  let W : Set Y := h ⁻¹' {s₀} ∩ (I.support : Set Y)ᶜ
  have hW : IsCompact W := by
    haveI hlft : LocallyOfFiniteType (h.fiberToSpecResidueField s₀) :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) (IsPullback.of_hasPullback _ _)
        (inferInstance : LocallyOfFiniteType h)
    haveI hqc : QuasiCompact (h.fiberToSpecResidueField s₀) :=
      MorphismProperty.of_isPullback (P := @QuasiCompact) (IsPullback.of_hasPullback _ _)
        (inferInstance : QuasiCompact h)
    haveI : CompactSpace (h.fiber s₀) :=
      QuasiCompact.compactSpace_of_compactSpace (h.fiberToSpecResidueField s₀)
    have key : ∀ (X : Scheme.{u}) (x : X), IsLocallyNoetherian (Spec (X.residueField x)) := by
      intro X x
      haveI : IsNoetherianRing (X.residueField x) := by
        letI : Field (X.residueField x) := inferInstance
        exact inferInstance
      infer_instance
    haveI := key (Spec (.of A)) s₀
    haveI : IsLocallyNoetherian (h.fiber s₀) :=
      LocallyOfFiniteType.isLocallyNoetherian (h.fiberToSpecResidueField s₀)
    haveI : AlgebraicGeometry.IsNoetherian (h.fiber s₀) := AlgebraicGeometry.IsNoetherian.mk
    haveI : TopologicalSpace.NoetherianSpace (h ⁻¹' {s₀}) :=
      TopologicalSpace.noetherianSpace_of_surjective (h.fiberHomeo s₀) (h.fiberHomeo s₀).continuous
        (h.fiberHomeo s₀).surjective
    have hc := TopologicalSpace.NoetherianSpace.isCompact ((Subtype.val : h ⁻¹' {s₀} → Y) ⁻¹' W)
    have hc2 := hc.image continuous_subtype_val
    rwa [Subtype.image_preimage_coe, Set.inter_eq_right.mpr Set.inter_subset_left] at hc2

  have hpt : ∀ y ∈ W, ∃ K : Y.IdealSheafData, K ≤ I ∧ (∀ U : Y.affineOpens, (K.ideal U).FG) ∧
      y ∉ K.support := by
    intro y hy
    obtain ⟨K, hKI, hKloc, hyK⟩ := wc_idealSheaf_fg_approx_point Y
      (fun K O hO hOc hK V N₀ hN₀ hN₀K => wc_idealSheaf_fg_extension Y K O hO hOc hK V N₀ hN₀ hN₀K)
      I y hy.2
    exact ⟨K, hKI, fun U => wc_idealSheaf_fg_of_locally_fg Y K U (fun x _ => hKloc x), hyK⟩

  choose! Kf hKfI hKfFG hKfy using hpt
  obtain ⟨t, htW, htfin, hcov⟩ := hW.elim_finite_subcover_image (b := W)
    (c := fun y => ((Kf y).support : Set Y)ᶜ) (fun y _ => (Kf y).support.isClosed.isOpen_compl)
    (fun z hz => Set.mem_biUnion hz (hKfy z hz))
  let K : Y.IdealSheafData := htfin.toFinset.sup Kf
  have hKI : K ≤ I := Finset.sup_le (fun y hy => hKfI y (htW (htfin.mem_toFinset.mp hy)))
  have hKFG : ∀ U : Y.affineOpens, (K.ideal U).FG := by
    intro U
    apply Finset.sup_induction (p := fun J : Y.IdealSheafData => (J.ideal U).FG)
    · rw [Scheme.IdealSheafData.ideal_bot]; exact Submodule.fg_bot
    · intro a ha b hb; rw [Scheme.IdealSheafData.ideal_sup]; exact Submodule.FG.sup ha hb
    · intro y hy; exact hKfFG y (htW (htfin.mem_toFinset.mp hy)) U
  have hKW : ∀ z ∈ W, z ∉ K.support := by
    intro z hz hzK
    obtain ⟨y, hyt, hzy⟩ := Set.mem_iUnion₂.mp (hcov hz)
    have hle : Kf y ≤ K := Finset.le_sup (f := Kf) (htfin.mem_toFinset.mpr hyt)
    exact hzy (Scheme.IdealSheafData.support_antitone hle hzK)

  haveI hKlfp : LocallyOfFinitePresentation K.subschemeι := wc_subschemeι_lfp_of_fg Y K hKFG
  have hker : Scheme.Hom.ker K.subschemeι ≤ Scheme.Hom.ker ι := by
    rw [Scheme.IdealSheafData.ker_subschemeι]; exact hKI
  let κ : R ⟶ K.subscheme := IsClosedImmersion.lift K.subschemeι ι hker
  have hκfac : κ ≫ K.subschemeι = ι := IsClosedImmersion.lift_fac _ _ _
  haveI : IsClosedImmersion (κ ≫ K.subschemeι) := by rw [hκfac]; infer_instance
  haveI hκ : IsClosedImmersion κ := IsClosedImmersion.of_comp κ K.subschemeι
  refine ⟨K.subscheme, K.subschemeι ≫ h, inferInstance, inferInstance, κ, hκ,
    by rw [← Category.assoc, hκfac], ?_⟩
  intro z hz
  have hz' : h (K.subschemeι z) = s₀ := by
    rw [← Scheme.Hom.comp_apply]; exact hz
  have hyK : K.subschemeι z ∈ (K.support : Set Y) := by
    rw [← Scheme.IdealSheafData.range_subschemeι]; exact ⟨z, rfl⟩
  have hyI : K.subschemeι z ∈ (I.support : Set Y) := by
    by_contra hn
    exact hKW _ ⟨hz', hn⟩ hyK
  rw [hIsupp] at hyI
  obtain ⟨r, hr⟩ := hyI
  refine ⟨r, K.subschemeι.isClosedEmbedding.injective ?_⟩
  rw [← Scheme.Hom.comp_apply, hκfac, hr]

theorem wc_ap_fp_affine_model_over_finset : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) (hX : X ⟶ Spec (.of A)) [IsAffine X] [LocallyOfFinitePresentation hX], ∃ (S : Finset A) (X₀ : Scheme.{u}) (h₀ : X₀ ⟶ Spec (.of ↥(Subring.closure (S : Set A)))) (π : X ⟶ X₀), QuasiCompact h₀ ∧ QuasiSeparated h₀ ∧ LocallyOfFinitePresentation h₀ ∧ IsPullback π hX h₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype)) :=
by
  intro A _ X hX _ _
  classical
  let φ : A →+* Γ(X, ⊤) := hX.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom
  have hφ : φ.FinitePresentation := by
    have h1 : (hX.appTop).hom.FinitePresentation :=
      (HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFinitePresentation)).mp inferInstance
    exact h1.comp (RingHom.FinitePresentation.of_bijective
      (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of A)).inv))
  letI : Algebra A Γ(X, ⊤) := φ.toAlgebra
  haveI : Algebra.FinitePresentation A Γ(X, ⊤) := hφ
  let P := Algebra.Presentation.ofFinitePresentation A Γ(X, ⊤)
  let S : Finset A := P.finite_coeffs.toFinset
  let B := Subring.closure (S : Set A)
  haveI : P.HasCoeffs B := ⟨by
    intro x hx
    refine ⟨⟨x, Subring.subset_closure ?_⟩, rfl⟩
    simpa [S] using hx⟩
  let C₀ := P.ModelOfHasCoeffs B
  have hfp : Algebra.FinitePresentation B C₀ :=
    Algebra.FinitePresentation.quotient (Submodule.fg_span (Set.finite_range _))
  let T := TensorProduct B A C₀
  let e' : T ≃ₐ[A] Γ(X, ⊤) := P.tensorModelOfHasCoeffsEquiv B
  have Q₀ := (isPullback_SpecMap_of_isPushout _ _ _ _
    (CommRingCat.isPushout_tensorProduct B A C₀)).flip
  let E : CommRingCat.of T ≅ Γ(X, ⊤) := e'.toRingEquiv.toCommRingCatIso
  let incL : CommRingCat.of A ⟶ CommRingCat.of T :=
    CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom
  let incR : CommRingCat.of C₀ ⟶ CommRingCat.of T :=
    CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom
  let ψ : X ⟶ Spec (.of T) := X.isoSpec.hom ≫ Spec.map E.hom
  haveI : IsIso ψ := inferInstance
  let π : X ⟶ Spec (.of C₀) := ψ ≫ Spec.map incR
  have hring : incL ≫ E.hom = (Scheme.ΓSpecIso (.of A)).inv ≫ hX.appTop := by
    ext a
    change e' (a ⊗ₜ 1) = φ a
    have := e'.commutes a
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply] at this
    exact this
  have hkey : ψ ≫ Spec.map incL = hX := by
    calc ψ ≫ Spec.map incL
        = X.isoSpec.hom ≫ Spec.map (incL ≫ E.hom) := by
          simp only [ψ, Category.assoc, Spec.map_comp]
      _ = X.isoSpec.hom ≫ Spec.map ((Scheme.ΓSpecIso (.of A)).inv ≫ hX.appTop) := by rw [hring]
      _ = X.isoSpec.hom ≫ Spec.map hX.appTop ≫ Spec.map (Scheme.ΓSpecIso (.of A)).inv := by
          rw [Spec.map_comp]
      _ = hX ≫ (Spec (.of A)).isoSpec.hom ≫ Spec.map (Scheme.ΓSpecIso (.of A)).inv := by
          rw [← Category.assoc, Scheme.isoSpec_hom_naturality, Category.assoc]
      _ = hX := by
          rw [Scheme.isoSpec_Spec_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id,
            Category.comp_id]
  have hpb : IsPullback π hX (Spec.map (CommRingCat.ofHom (algebraMap B C₀)))
      (Spec.map (CommRingCat.ofHom B.subtype)) := by
    refine IsPullback.of_iso Q₀ (asIso ψ).symm (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
    · simp [π, incR]
    · rw [← hkey]
      simp [incL]
    · simp
    · simp
      rfl
  refine ⟨S, Spec (.of C₀), Spec.map (CommRingCat.ofHom (algebraMap B C₀)), π,
    inferInstance, inferInstance, ?_, hpb⟩
  exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation)).mpr
    (RingHom.finitePresentation_algebraMap.mpr hfp)

theorem wc_ap_fp_model_limit_presentation : ∀ (A : Type u) [CommRing A] [DecidableEq A] (Z : Scheme.{u}) (f : Z ⟶ Spec (.of A)) (S : Finset A) (X : Scheme.{u}) (h₀ : X ⟶ Spec (.of ↥(Subring.closure (S : Set A)))) (π : Z ⟶ X), QuasiCompact h₀ → QuasiSeparated h₀ → LocallyOfFinitePresentation h₀ → IsPullback π f h₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype)) → ∃ (E : (Finset A)ᵒᵖ ⥤ Scheme.{u}) (ρ : (Functor.const (Finset A)ᵒᵖ).obj Z ⟶ E) (hE : ∀ T : Finset A, E.obj (Opposite.op T) ⟶ Spec (.of ↥(Subring.closure ((S ∪ T : Finset A) : Set A)))) (sE : ∀ T : Finset A, E.obj (Opposite.op T) ⟶ X), Nonempty (Limits.IsLimit (Limits.Cone.mk Z ρ)) ∧ (∀ {i j : (Finset A)ᵒᵖ} (g : i ⟶ j), IsAffineHom (E.map g)) ∧ (∀ i, CompactSpace (E.obj i)) ∧ (∀ i, QuasiSeparatedSpace (E.obj i)) ∧ (∀ T, QuasiCompact (hE T)) ∧ (∀ T, QuasiSeparated (hE T)) ∧ (∀ T, LocallyOfFinitePresentation (hE T)) ∧ (∀ T, IsPullback (ρ.app (Opposite.op T)) f (hE T) (Spec.map (CommRingCat.ofHom (Subring.closure ((S ∪ T : Finset A) : Set A)).subtype))) ∧ (∀ T, IsPullback (sE T) (hE T) h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr (Finset.subset_union_left : S ⊆ S ∪ T))))))) ∧ (∀ T, ρ.app (Opposite.op T) ≫ sE T = π) ∧ (∀ {T T' : Finset A} (g : T ⟶ T'), E.map g.op ≫ hE T = hE T' ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr (Finset.union_subset_union_right (leOfHom g) : S ∪ T ⊆ S ∪ T')))))) ∧ (∀ {T T' : Finset A} (g : T ⟶ T'), E.map g.op ≫ sE T = sE T') :=
by
  intro A _ _ Z f S X h₀ π hqc hqs hlfp hpb

  have s1 : ∀ (J : Type u) [SmallCategory J] [IsFiltered J] (G : J ⥤ CommRingCat.{u}) (κ : Limits.Cocone G), (∀ j, Function.Injective (κ.ι.app j)) → (∀ x : κ.pt, ∃ (j : J) (y : G.obj j), κ.ι.app j y = x) → Nonempty (Limits.IsColimit κ) := by
    intro J _ _ G κ hinj hsurj
    have ht : Limits.IsColimit ((forget CommRingCat.{u}).mapCocone κ) := by
      apply Limits.Types.FilteredColimit.isColimitOf
      · intro x
        obtain ⟨j, y, hy⟩ := hsurj x
        exact ⟨j, y, hy.symm⟩
      · intro i j xi xj h
        refine ⟨IsFiltered.max i j, IsFiltered.leftToMax i j, IsFiltered.rightToMax i j, ?_⟩
        apply hinj (IsFiltered.max i j)
        have e1 : κ.ι.app (IsFiltered.max i j) (G.map (IsFiltered.leftToMax i j) xi) = κ.ι.app i xi := by
          rw [← κ.w (IsFiltered.leftToMax i j)]; rfl
        have e2 : κ.ι.app (IsFiltered.max i j) (G.map (IsFiltered.rightToMax i j) xj) = κ.ι.app j xj := by
          rw [← κ.w (IsFiltered.rightToMax i j)]; rfl
        change κ.ι.app (IsFiltered.max i j) (G.map (IsFiltered.leftToMax i j) xi) =
          κ.ι.app (IsFiltered.max i j) (G.map (IsFiltered.rightToMax i j) xj)
        rw [e1, e2]
        exact h
    have : Limits.ReflectsColimitsOfShape J (forget CommRingCat.{u}) :=
      Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
    exact ⟨Limits.isColimitOfReflects (forget CommRingCat.{u}) ht⟩

  have s3 : ∀ (I : Type u) [SmallCategory I] (D : I ⥤ Scheme.{u}) (c : Limits.Cone D) (X Y₀ : Scheme.{u}) (h₀ : Y₀ ⟶ X) (q : ∀ i, D.obj i ⟶ X), (∀ {i j : I} (f : i ⟶ j), D.map f ≫ q j = q i) → ∀ (q₀ : c.pt ⟶ X), (∀ i, c.π.app i ≫ q i = q₀) → ∀ (Z : Scheme.{u}) (sZ : Z ⟶ Y₀) (fZ : Z ⟶ c.pt), IsPullback sZ fZ h₀ q₀ → ∃ (E : I ⥤ Scheme.{u}) (ρ : (Functor.const I).obj Z ⟶ E) (sE : ∀ i, E.obj i ⟶ Y₀) (fE : ∀ i, E.obj i ⟶ D.obj i), (∀ i, IsPullback (sE i) (fE i) h₀ (q i)) ∧ (∀ i, ρ.app i ≫ sE i = sZ) ∧ (∀ i, ρ.app i ≫ fE i = fZ ≫ c.π.app i) ∧ (∀ {i j : I} (f : i ⟶ j), E.map f ≫ sE j = sE i) ∧ (∀ {i j : I} (f : i ⟶ j), E.map f ≫ fE j = fE i ≫ D.map f) ∧ (∀ i, IsPullback (ρ.app i) fZ (fE i) (c.π.app i)) ∧ (∀ {i j : I} (f : i ⟶ j), IsPullback (E.map f) (fE i) (fE j) (D.map f)) := by
    intro I _ D c X Y₀ h₀ q hq q₀ hq₀ Z sZ fZ hpb
    have hw : ∀ {i j : I} (f : i ⟶ j), Limits.pullback.fst h₀ (q i) ≫ h₀ =
        (Limits.pullback.snd h₀ (q i) ≫ D.map f) ≫ q j := fun f => by
      rw [Category.assoc, hq f]; exact Limits.pullback.condition
    let E : I ⥤ Scheme.{u} :=
      { obj := fun i => Limits.pullback h₀ (q i)
        map := fun {i j} f => Limits.pullback.lift (Limits.pullback.fst h₀ (q i))
          (Limits.pullback.snd h₀ (q i) ≫ D.map f) (hw f)
        map_id := fun i => by
          apply Limits.pullback.hom_ext
          · rw [Limits.pullback.lift_fst, Category.id_comp]
          · rw [Limits.pullback.lift_snd, D.map_id, Category.comp_id, Category.id_comp]
        map_comp := fun {i j k} f g => by
          apply Limits.pullback.hom_ext
          · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst,
              Limits.pullback.lift_fst]
          · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd,
              ← Category.assoc, Limits.pullback.lift_snd, D.map_comp, Category.assoc] }
    have hEmap : ∀ {i j : I} (f : i ⟶ j), E.map f = Limits.pullback.lift (Limits.pullback.fst h₀ (q i))
        (Limits.pullback.snd h₀ (q i) ≫ D.map f) (hw f) := fun f => rfl
    have hv : ∀ i, sZ ≫ h₀ = (fZ ≫ c.π.app i) ≫ q i := fun i => by
      rw [hpb.w, Category.assoc, hq₀ i]
    let ρ : (Functor.const I).obj Z ⟶ E :=
      { app := fun i => Limits.pullback.lift sZ (fZ ≫ c.π.app i) (hv i)
        naturality := fun i j f => by
          change 𝟙 Z ≫ Limits.pullback.lift sZ (fZ ≫ c.π.app j) (hv j) =
            Limits.pullback.lift sZ (fZ ≫ c.π.app i) (hv i) ≫ E.map f
          rw [hEmap, Category.id_comp]
          apply Limits.pullback.hom_ext
          · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst,
              Limits.pullback.lift_fst]
          · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd,
              ← Category.assoc, Limits.pullback.lift_snd, Category.assoc, c.w f] }
    have C1 : ∀ i, IsPullback (Limits.pullback.fst h₀ (q i)) (Limits.pullback.snd h₀ (q i)) h₀ (q i) :=
      fun i => IsPullback.of_hasPullback h₀ (q i)
    have C2 : ∀ i, ρ.app i ≫ Limits.pullback.fst h₀ (q i) = sZ := fun i => Limits.pullback.lift_fst _ _ _
    have C3 : ∀ i, ρ.app i ≫ Limits.pullback.snd h₀ (q i) = fZ ≫ c.π.app i :=
      fun i => Limits.pullback.lift_snd _ _ _
    have C4 : ∀ {i j : I} (f : i ⟶ j), E.map f ≫ Limits.pullback.fst h₀ (q j) =
        Limits.pullback.fst h₀ (q i) := fun f => by rw [hEmap]; exact Limits.pullback.lift_fst _ _ _
    have C5 : ∀ {i j : I} (f : i ⟶ j), E.map f ≫ Limits.pullback.snd h₀ (q j) =
        Limits.pullback.snd h₀ (q i) ≫ D.map f := fun f => by
      rw [hEmap]; exact Limits.pullback.lift_snd _ _ _
    refine ⟨E, ρ, fun i => Limits.pullback.fst h₀ (q i), fun i => Limits.pullback.snd h₀ (q i),
      C1, C2, C3, C4, C5, fun i => ?_, fun {i j} f => ?_⟩
    · refine IsPullback.of_right ?_ (C3 i) (C1 i)
      rw [C2 i, hq₀ i]
      exact hpb
    · refine IsPullback.of_right ?_ (C5 f) (C1 j)
      rw [C4 f, hq f]
      exact C1 i

  have s4 : ∀ (I : Type u) [SmallCategory I] [IsCofiltered I] (D : I ⥤ Scheme.{u}) (c : Limits.Cone D), Limits.IsLimit c → ∀ (X Y₀ : Scheme.{u}) (h₀ : Y₀ ⟶ X) (q : ∀ i, D.obj i ⟶ X) (q₀ : c.pt ⟶ X), (∀ i, c.π.app i ≫ q i = q₀) → ∀ (Z : Scheme.{u}) (sZ : Z ⟶ Y₀) (fZ : Z ⟶ c.pt), IsPullback sZ fZ h₀ q₀ → ∀ (E : I ⥤ Scheme.{u}) (ρ : (Functor.const I).obj Z ⟶ E) (sE : ∀ i, E.obj i ⟶ Y₀) (fE : ∀ i, E.obj i ⟶ D.obj i), (∀ i, IsPullback (sE i) (fE i) h₀ (q i)) → (∀ i, ρ.app i ≫ sE i = sZ) → (∀ i, ρ.app i ≫ fE i = fZ ≫ c.π.app i) → (∀ {i j : I} (f : i ⟶ j), E.map f ≫ sE j = sE i) → (∀ {i j : I} (f : i ⟶ j), E.map f ≫ fE j = fE i ≫ D.map f) → Nonempty (Limits.IsLimit (Limits.Cone.mk Z ρ)) := by
    intro I _ _ D c hc X Y₀ h₀ q q₀ hq₀ Z sZ fZ hpb E ρ sE fE hE hρs hρf hEs hEf
    obtain ⟨i₀⟩ := IsCofiltered.nonempty (C := I)
    have key1 : ∀ (s : Limits.Cone E) (i j : I), s.π.app i ≫ sE i = s.π.app j ≫ sE j := by
      intro s i j
      rw [← s.w (IsCofiltered.minToLeft i j), ← s.w (IsCofiltered.minToRight i j), Category.assoc,
        Category.assoc, hEs, hEs]
    let t : Limits.Cone E → Limits.Cone D := fun s =>
      { pt := s.pt
        π := { app := fun i => s.π.app i ≫ fE i
               naturality := fun i j f => by
                 change 𝟙 s.pt ≫ s.π.app j ≫ fE j = (s.π.app i ≫ fE i) ≫ D.map f
                 rw [Category.id_comp, Category.assoc, ← hEf f, ← Category.assoc, s.w f] } }
    have ht : ∀ s i, (t s).π.app i = s.π.app i ≫ fE i := fun s i => rfl
    have hw : ∀ s : Limits.Cone E, (s.π.app i₀ ≫ sE i₀) ≫ h₀ = hc.lift (t s) ≫ q₀ := by
      intro s
      rw [Category.assoc, (hE i₀).w, ← hq₀ i₀, ← Category.assoc (hc.lift (t s)), hc.fac, ht,
        Category.assoc]
    refine ⟨Limits.IsLimit.mk (fun s => hpb.lift (s.π.app i₀ ≫ sE i₀) (hc.lift (t s)) (hw s))
      (fun s i => ?_) (fun s m hm => ?_)⟩
    · change hpb.lift (s.π.app i₀ ≫ sE i₀) (hc.lift (t s)) (hw s) ≫ ρ.app i = s.π.app i
      apply (hE i).hom_ext
      · rw [Category.assoc, hρs, hpb.lift_fst]
        exact key1 s i₀ i
      · rw [Category.assoc, hρf, ← Category.assoc, hpb.lift_snd, hc.fac, ht]
    · have hm' : ∀ j, m ≫ ρ.app j = s.π.app j := hm
      apply hpb.hom_ext
      · rw [hpb.lift_fst, ← hρs i₀, ← Category.assoc, hm' i₀]
      · rw [hpb.lift_snd]
        apply hc.hom_ext
        intro j
        rw [hc.fac, ht, Category.assoc, ← hρf j, ← Category.assoc, hm' j]


  have gen : ∀ (B₀ : Subring A) (Λ : Finset A → Subring A) (hΛ : Monotone Λ) (hB : ∀ T, B₀ ≤ Λ T),
      (∀ x : A, ∃ T, x ∈ Λ T) →
      ∀ (Z : Scheme.{u}) (f : Z ⟶ Spec (.of A)) (X : Scheme.{u}) (h₀ : X ⟶ Spec (.of ↥B₀))
        (π : Z ⟶ X), QuasiCompact h₀ → QuasiSeparated h₀ → LocallyOfFinitePresentation h₀ →
      IsPullback π f h₀ (Spec.map (CommRingCat.ofHom B₀.subtype)) →
      ∃ (E : (Finset A)ᵒᵖ ⥤ Scheme.{u}) (ρ : (Functor.const (Finset A)ᵒᵖ).obj Z ⟶ E)
        (hE : ∀ T : Finset A, E.obj (Opposite.op T) ⟶ Spec (.of ↥(Λ T)))
        (sE : ∀ T : Finset A, E.obj (Opposite.op T) ⟶ X),
        Nonempty (Limits.IsLimit (Limits.Cone.mk Z ρ)) ∧
        (∀ {i j : (Finset A)ᵒᵖ} (g : i ⟶ j), IsAffineHom (E.map g)) ∧
        (∀ i, CompactSpace (E.obj i)) ∧ (∀ i, QuasiSeparatedSpace (E.obj i)) ∧
        (∀ T, QuasiCompact (hE T)) ∧ (∀ T, QuasiSeparated (hE T)) ∧
        (∀ T, LocallyOfFinitePresentation (hE T)) ∧
        (∀ T, IsPullback (ρ.app (Opposite.op T)) f (hE T)
          (Spec.map (CommRingCat.ofHom (Λ T).subtype))) ∧
        (∀ T, IsPullback (sE T) (hE T) h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion (hB T))))) ∧
        (∀ T, ρ.app (Opposite.op T) ≫ sE T = π) ∧
        (∀ {T T' : Finset A} (g : T ⟶ T'), E.map g.op ≫ hE T =
          hE T' ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hΛ (leOfHom g))))) ∧
        (∀ {T T' : Finset A} (g : T ⟶ T'), E.map g.op ≫ sE T = sE T') := by
    intro B₀ Λ hΛ hB hcov Z f X h₀ π hqc hqs hlfp hpb
    let G : Finset A ⥤ CommRingCat.{u} :=
      { obj := fun T => CommRingCat.of ↥(Λ T)
        map := fun {T T'} g => CommRingCat.ofHom (Subring.inclusion (hΛ (leOfHom g)))
        map_id := fun _ => rfl
        map_comp := fun _ _ => rfl }
    let κ : Limits.Cocone G :=
      { pt := CommRingCat.of A
        ι := { app := fun T => CommRingCat.ofHom (Λ T).subtype
               naturality := fun _ _ _ => rfl } }
    have hinj : ∀ T, Function.Injective (κ.ι.app T) := fun T a b hab => Subtype.ext hab
    have hsurj : ∀ x : κ.pt, ∃ (j : Finset A) (y : G.obj j), κ.ι.app j y = x := fun x => by
      obtain ⟨T, hT⟩ := hcov x
      exact ⟨T, ⟨x, hT⟩, rfl⟩
    obtain ⟨hκ⟩ := s1 (Finset A) G κ hinj hsurj
    have hlim : Limits.IsLimit (Scheme.Spec.mapCone κ.op) :=
      Limits.isLimitOfPreserves Scheme.Spec hκ.op
    let D : (Finset A)ᵒᵖ ⥤ Scheme.{u} := G.op ⋙ Scheme.Spec
    let πD : (Functor.const (Finset A)ᵒᵖ).obj (Spec (.of A)) ⟶ D := (Scheme.Spec.mapCone κ.op).π
    have hlimD : Limits.IsLimit (Limits.Cone.mk (Spec (.of A)) πD) := hlim
    let q : ∀ i : (Finset A)ᵒᵖ, D.obj i ⟶ Spec (.of ↥B₀) := fun i =>
      Spec.map (CommRingCat.ofHom (Subring.inclusion (hB i.unop)))
    have hq : ∀ {i j : (Finset A)ᵒᵖ} (g : i ⟶ j), D.map g ≫ q j = q i := by
      intro i j g
      change Spec.map (G.map g.unop) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hB j.unop))) =
        Spec.map (CommRingCat.ofHom (Subring.inclusion (hB i.unop)))
      rw [← Spec.map_comp]
      rfl
    have hq₀ : ∀ i, (Limits.Cone.mk (Spec (.of A)) πD).π.app i ≫ q i =
        Spec.map (CommRingCat.ofHom B₀.subtype) := by
      intro i
      change Spec.map (κ.ι.app i.unop) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion (hB i.unop))) =
        Spec.map (CommRingCat.ofHom B₀.subtype)
      rw [← Spec.map_comp]
      rfl
    obtain ⟨E, ρ, sE', fE', C1, C2, C3, C4, C5, C6, C7⟩ :=
      s3 (Finset A)ᵒᵖ D (Limits.Cone.mk (Spec (.of A)) πD) (Spec (.of ↥B₀)) X h₀ q hq _ hq₀ Z π f hpb
    have hL := s4 (Finset A)ᵒᵖ D _ hlimD (Spec (.of ↥B₀)) X h₀ q _ hq₀ Z π f hpb E ρ sE' fE'
      C1 C2 C3 C4 C5
    have hDaff : ∀ i, IsAffine (D.obj i) := fun i => by
      change IsAffine (Spec (G.obj i.unop))
      infer_instance
    refine ⟨E, ρ, fun T => fE' (Opposite.op T), fun T => sE' (Opposite.op T), hL,
      fun {i j} g => ?_, fun i => ?_, fun i => ?_, fun T => ?_, fun T => ?_, fun T => ?_,
      fun T => C6 (Opposite.op T), fun T => C1 (Opposite.op T), fun T => C2 (Opposite.op T),
      fun {T T'} g => C5 g.op, fun {T T'} g => C4 g.op⟩
    · haveI := hDaff i
      haveI := hDaff j
      haveI : IsAffineHom (D.map g) := isAffineHom_of_isAffine _
      exact MorphismProperty.of_isPullback (P := @IsAffineHom) (C7 g).flip inferInstance
    · haveI : QuasiCompact (fE' i) :=
        MorphismProperty.of_isPullback (P := @QuasiCompact) (C1 i) hqc
      haveI := hDaff i
      exact QuasiCompact.compactSpace_of_compactSpace (fE' i)
    · haveI : QuasiSeparated (fE' i) :=
        MorphismProperty.of_isPullback (P := @QuasiSeparated) (C1 i) hqs
      haveI := hDaff i
      exact quasiSeparatedSpace_of_quasiSeparated (fE' i)
    · exact MorphismProperty.of_isPullback (P := @QuasiCompact) (C1 (Opposite.op T)) hqc
    · exact MorphismProperty.of_isPullback (P := @QuasiSeparated) (C1 (Opposite.op T)) hqs
    · exact MorphismProperty.of_isPullback (P := @LocallyOfFinitePresentation) (C1 (Opposite.op T)) hlfp
  exact gen (Subring.closure (S : Set A)) (fun T => Subring.closure ((S ∪ T : Finset A) : Set A))
    (fun T T' h => Subring.closure_mono (Finset.coe_subset.mpr (Finset.union_subset_union_right h)))
    (fun T => Subring.closure_mono (Finset.coe_subset.mpr (Finset.subset_union_left : S ⊆ S ∪ T)))
    (fun x => ⟨{x}, Subring.subset_closure
      (Finset.mem_coe.mpr (Finset.mem_union_right S (Finset.mem_singleton_self x)))⟩)
    Z f X h₀ π hqc hqs hlfp hpb

theorem wc_ap_fp_models_unique : ∀ (A : Type u) [CommRing A] (Z : Scheme.{u}) (f : Z ⟶ Spec (.of A)) (S : Finset A) (X₁ X₂ : Scheme.{u}) (h₁ : X₁ ⟶ Spec (.of ↥(Subring.closure (S : Set A)))) (h₂ : X₂ ⟶ Spec (.of ↥(Subring.closure (S : Set A)))) (π₁ : Z ⟶ X₁) (π₂ : Z ⟶ X₂), QuasiCompact h₁ → QuasiSeparated h₁ → LocallyOfFinitePresentation h₁ → QuasiCompact h₂ → QuasiSeparated h₂ → LocallyOfFinitePresentation h₂ → IsPullback π₁ f h₁ (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype)) → IsPullback π₂ f h₂ (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype)) → ∃ (S' : Finset A) (hSS' : S ⊆ S') (X₁' X₂' : Scheme.{u}) (h₁' : X₁' ⟶ Spec (.of ↥(Subring.closure (S' : Set A)))) (h₂' : X₂' ⟶ Spec (.of ↥(Subring.closure (S' : Set A)))) (π₁' : Z ⟶ X₁') (r₁ : X₁' ⟶ X₁) (r₂ : X₂' ⟶ X₂) (e : X₁' ≅ X₂'), QuasiCompact h₁' ∧ IsPullback π₁' f h₁' (Spec.map (CommRingCat.ofHom (Subring.closure (S' : Set A)).subtype)) ∧ IsPullback r₁ h₁' h₁ (Spec.map (CommRingCat.ofHom (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr hSS'))))) ∧ IsPullback r₂ h₂' h₂ (Spec.map (CommRingCat.ofHom (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr hSS'))))) ∧ π₁' ≫ r₁ = π₁ ∧ π₁' ≫ e.hom ≫ r₂ = π₂ ∧ e.hom ≫ h₂' = h₁' :=
by
  intro A _ Z f S X₁ X₂ h₁ h₂ π₁ π₂ hqc₁ hqs₁ hlfp₁ hqc₂ hqs₂ hlfp₂ hpb₁ hpb₂
  classical

  have hcomp' : ∀ (E : (Finset A)ᵒᵖ ⥤ Scheme.{u}) {i j l : (Finset A)ᵒᵖ} (f : i ⟶ j) (g : j ⟶ l)
      (h : i ⟶ l) {W : Scheme.{u}} (x : E.obj l ⟶ W), E.map f ≫ E.map g ≫ x = E.map h ≫ x := by
    intro E i j l f g h W x
    rw [← Category.assoc, ← E.map_comp,
      show f ≫ g = h from Quiver.Hom.unop_inj (Subsingleton.elim _ _)]

  have hcone : ∀ {E : (Finset A)ᵒᵖ ⥤ Scheme.{u}} (ρ : (Functor.const (Finset A)ᵒᵖ).obj Z ⟶ E)
      {i j : (Finset A)ᵒᵖ} (g : i ⟶ j) {W : Scheme.{u}} (x : E.obj j ⟶ W),
      ρ.app i ≫ E.map g ≫ x = ρ.app j ≫ x := by
    intro E ρ i j g W x
    rw [← Category.assoc, ← ρ.naturality g]
    simp

  have mkt : ∀ (B Y : Scheme.{u}) (k : Y ⟶ B) (E : (Finset A)ᵒᵖ ⥤ Scheme.{u})
      (s : ∀ T, E.obj (Opposite.op T) ⟶ Y), (∀ T T' (g : T ⟶ T'), E.map g.op ≫ s T = s T') →
      ∃ t : E ⟶ (Functor.const (Finset A)ᵒᵖ).obj B, ∀ i, t.app i = s i.unop ≫ k := by
    intro B Y k E s hs
    refine ⟨{ app := fun i => s i.unop ≫ k, naturality := ?_ }, fun i => rfl⟩
    intro i j g
    simp only [Functor.const_obj_map]
    rw [← Category.assoc]
    exact congrArg (· ≫ k) (hs _ _ g.unop)

  have mkG : ∀ (B : Scheme.{u}) (Bt : Finset A → Scheme.{u}) (gS : ∀ T, Bt T ⟶ B)
      (Y₁ Y₂ : Scheme.{u}) (k₁ : Y₁ ⟶ B) (k₂ : Y₂ ⟶ B) (p₂ : Z ⟶ Y₂)
      (E₁ E₂ : (Finset A)ᵒᵖ ⥤ Scheme.{u}) (ρ₁ : (Functor.const (Finset A)ᵒᵖ).obj Z ⟶ E₁)
      (ρ₂ : (Functor.const (Finset A)ᵒᵖ).obj Z ⟶ E₂)
      (hE₁ : ∀ T, E₁.obj (Opposite.op T) ⟶ Bt T) (hE₂ : ∀ T, E₂.obj (Opposite.op T) ⟶ Bt T)
      (s₁ : ∀ T, E₁.obj (Opposite.op T) ⟶ Y₁) (s₂ : ∀ T, E₂.obj (Opposite.op T) ⟶ Y₂),
      (∀ T, IsPullback (s₁ T) (hE₁ T) k₁ (gS T)) → (∀ T, IsPullback (s₂ T) (hE₂ T) k₂ (gS T)) →
      (∀ T T' (g : T ⟶ T'), E₁.map g.op ≫ s₁ T = s₁ T') →
      (∀ T, ρ₁.app (Opposite.op T) ≫ hE₁ T = ρ₂.app (Opposite.op T) ≫ hE₂ T) →
      (∀ T, ρ₂.app (Opposite.op T) ≫ s₂ T = p₂) →
      ∀ (T₁ : Finset A) (γ : E₁.obj (Opposite.op T₁) ⟶ Y₂), ρ₁.app (Opposite.op T₁) ≫ γ = p₂ →
      γ ≫ k₂ = s₁ T₁ ≫ k₁ → ∀ (T : Finset A) (hT : T₁ ⊆ T),
      ∃ G : E₁.obj (Opposite.op T) ⟶ E₂.obj (Opposite.op T),
        G ≫ s₂ T = E₁.map (homOfLE hT).op ≫ γ ∧ G ≫ hE₂ T = hE₁ T ∧
        ρ₁.app (Opposite.op T) ≫ G = ρ₂.app (Opposite.op T) := by
    intro B Bt gS Y₁ Y₂ k₁ k₂ p₂ E₁ E₂ ρ₁ ρ₂ hE₁ hE₂ s₁ s₂ sq₁ sq₂ st₁ hρh hρs₂ T₁ γ hγ1 hγ2 T hT
    have w : (E₁.map (homOfLE hT).op ≫ γ) ≫ k₂ = hE₁ T ≫ gS T := by
      rw [Category.assoc, hγ2, reassoc_of% (st₁ _ _ (homOfLE hT)), (sq₁ T).w]
    refine ⟨(sq₂ T).lift _ _ w, (sq₂ T).lift_fst _ _ w, (sq₂ T).lift_snd _ _ w, ?_⟩
    apply (sq₂ T).hom_ext
    · rw [Category.assoc, (sq₂ T).lift_fst, hcone ρ₁ (homOfLE hT).op γ, hγ1, hρs₂]
    · rw [Category.assoc, (sq₂ T).lift_snd, hρh]

  have desc : ∀ (B Y₁ Y₂ : Scheme.{u}) (k₁ : Y₁ ⟶ B) (k₂ : Y₂ ⟶ B) (p₂ : Z ⟶ Y₂)
      (E : (Finset A)ᵒᵖ ⥤ Scheme.{u}) (ρ : (Functor.const (Finset A)ᵒᵖ).obj Z ⟶ E)
      (s : ∀ T, E.obj (Opposite.op T) ⟶ Y₁),
      Nonempty (Limits.IsLimit (Limits.Cone.mk Z ρ)) →
      (∀ {i j : (Finset A)ᵒᵖ} (g : i ⟶ j), IsAffineHom (E.map g)) →
      (∀ i, CompactSpace (E.obj i)) → (∀ i, QuasiSeparatedSpace (E.obj i)) →
      LocallyOfFinitePresentation k₂ → (∀ T T' (g : T ⟶ T'), E.map g.op ≫ s T = s T') →
      (∀ T, ρ.app (Opposite.op T) ≫ s T ≫ k₁ = p₂ ≫ k₂) →
      ∃ (T₁ : Finset A) (γ : E.obj (Opposite.op T₁) ⟶ Y₂),
        ρ.app (Opposite.op T₁) ≫ γ = p₂ ∧ γ ≫ k₂ = s T₁ ≫ k₁ := by
    intro B Y₁ Y₂ k₁ k₂ p₂ E ρ s ⟨hc⟩ hA hC hQ hL hs hρ
    obtain ⟨t, ht⟩ := mkt B Y₁ k₁ E s hs
    have hcond : (Limits.Cone.mk Z ρ).π ≫ t = (Functor.const (Finset A)ᵒᵖ).map (p₂ ≫ k₂) := by
      refine NatTrans.ext (funext fun i => ?_)
      show ρ.app i ≫ t.app i = p₂ ≫ k₂
      rw [ht]
      exact hρ i.unop
    obtain ⟨i, γ, h1, h2⟩ := @Scheme.exists_π_app_comp_eq_of_locallyOfFinitePresentation _ _ _ _
      E t k₂ (Limits.Cone.mk Z ρ) hc _ hL hA hC hQ p₂ hcond
    exact ⟨i.unop, γ, h1, h2.trans (ht i)⟩

  have key : ∀ (B : Scheme.{u}) (Bt : Finset A → Scheme.{u}) (gS : ∀ T, Bt T ⟶ B)
      (gT : ∀ T T' : Finset A, (T ⟶ T') → (Bt T' ⟶ Bt T))
      (Y₁ Y₂ : Scheme.{u}) (k₁ : Y₁ ⟶ B) (k₂ : Y₂ ⟶ B) (p₁ : Z ⟶ Y₁) (p₂ : Z ⟶ Y₂)
      (E₁ E₂ : (Finset A)ᵒᵖ ⥤ Scheme.{u}) (ρ₁ : (Functor.const (Finset A)ᵒᵖ).obj Z ⟶ E₁)
      (ρ₂ : (Functor.const (Finset A)ᵒᵖ).obj Z ⟶ E₂)
      (hE₁ : ∀ T, E₁.obj (Opposite.op T) ⟶ Bt T) (hE₂ : ∀ T, E₂.obj (Opposite.op T) ⟶ Bt T)
      (s₁ : ∀ T, E₁.obj (Opposite.op T) ⟶ Y₁) (s₂ : ∀ T, E₂.obj (Opposite.op T) ⟶ Y₂),
      Nonempty (Limits.IsLimit (Limits.Cone.mk Z ρ₁)) →
      (∀ {i j : (Finset A)ᵒᵖ} (g : i ⟶ j), IsAffineHom (E₁.map g)) →
      (∀ i, CompactSpace (E₁.obj i)) → LocallyOfFiniteType k₁ →
      (∀ T, IsPullback (s₁ T) (hE₁ T) k₁ (gS T)) → (∀ T, IsPullback (s₂ T) (hE₂ T) k₂ (gS T)) →
      (∀ T T' (g : T ⟶ T'), E₁.map g.op ≫ hE₁ T = hE₁ T' ≫ gT T T' g) →
      (∀ T T' (g : T ⟶ T'), E₂.map g.op ≫ hE₂ T = hE₂ T' ≫ gT T T' g) →
      (∀ T T' (g : T ⟶ T'), E₁.map g.op ≫ s₁ T = s₁ T') →
      (∀ T T' (g : T ⟶ T'), E₂.map g.op ≫ s₂ T = s₂ T') →
      (∀ T, ρ₁.app (Opposite.op T) ≫ hE₁ T = ρ₂.app (Opposite.op T) ≫ hE₂ T) →
      (∀ T, ρ₁.app (Opposite.op T) ≫ s₁ T = p₁) → (∀ T, ρ₂.app (Opposite.op T) ≫ s₂ T = p₂) →
      ∀ (T₁ : Finset A) (γ : E₁.obj (Opposite.op T₁) ⟶ Y₂) (T₂ : Finset A)
        (δ : E₂.obj (Opposite.op T₂) ⟶ Y₁),
      ρ₁.app (Opposite.op T₁) ≫ γ = p₂ → γ ≫ k₂ = s₁ T₁ ≫ k₁ →
      ρ₂.app (Opposite.op T₂) ≫ δ = p₁ → δ ≫ k₁ = s₂ T₂ ≫ k₂ →
      ∃ K : Finset A, ∀ (T : Finset A) (_ : K ⊆ T) (hT₁ : T₁ ⊆ T) (hT₂ : T₂ ⊆ T)
        (G : E₁.obj (Opposite.op T) ⟶ E₂.obj (Opposite.op T))
        (H : E₂.obj (Opposite.op T) ⟶ E₁.obj (Opposite.op T)),
        G ≫ s₂ T = E₁.map (homOfLE hT₁).op ≫ γ → G ≫ hE₂ T = hE₁ T →
        H ≫ s₁ T = E₂.map (homOfLE hT₂).op ≫ δ → H ≫ hE₁ T = hE₂ T → G ≫ H = 𝟙 _ := by
    intro B Bt gS gT Y₁ Y₂ k₁ k₂ p₁ p₂ E₁ E₂ ρ₁ ρ₂ hE₁ hE₂ s₁ s₂ ⟨hc⟩ hA hC hL sq₁ sq₂ ht₁ ht₂
      st₁ st₂ hρh hρs₁ hρs₂ T₁ γ T₂ δ hγ1 hγ2 hδ1 hδ2
    have h10 : T₁ ⊆ T₁ ∪ T₂ := Finset.subset_union_left
    have h20 : T₂ ⊆ T₁ ∪ T₂ := Finset.subset_union_right
    obtain ⟨G₀, hG₀s, hG₀h, hG₀ρ⟩ := mkG B Bt gS Y₁ Y₂ k₁ k₂ p₂ E₁ E₂ ρ₁ ρ₂ hE₁ hE₂ s₁ s₂ sq₁ sq₂
      st₁ hρh hρs₂ T₁ γ hγ1 hγ2 (T₁ ∪ T₂) h10
    obtain ⟨t, htt⟩ := mkt B Y₁ k₁ E₁ s₁ st₁
    have e1 : t.app (Opposite.op (T₁ ∪ T₂)) = (G₀ ≫ E₂.map (homOfLE h20).op ≫ δ) ≫ k₁ := by
      rw [htt]
      simp only [Category.assoc, hδ2]
      rw [reassoc_of% (st₂ _ _ (homOfLE h20)), reassoc_of% hG₀s, hγ2,
        reassoc_of% (st₁ _ _ (homOfLE h10))]
    have e2 : t.app (Opposite.op (T₁ ∪ T₂)) = s₁ (T₁ ∪ T₂) ≫ k₁ := htt _
    have e3 : (Limits.Cone.mk Z ρ₁).π.app (Opposite.op (T₁ ∪ T₂)) ≫
        (G₀ ≫ E₂.map (homOfLE h20).op ≫ δ) =
        (Limits.Cone.mk Z ρ₁).π.app (Opposite.op (T₁ ∪ T₂)) ≫ s₁ (T₁ ∪ T₂) := by
      show ρ₁.app _ ≫ G₀ ≫ E₂.map (homOfLE h20).op ≫ δ = ρ₁.app _ ≫ s₁ (T₁ ∪ T₂)
      rw [reassoc_of% hG₀ρ, hcone ρ₂ (homOfLE h20).op δ, hδ1, hρs₁]
    obtain ⟨k, hik, hab⟩ := @Scheme.exists_hom_comp_eq_comp_of_locallyOfFiniteType _ _ _ _
      E₁ t k₁ (Limits.Cone.mk Z ρ₁) hc hC hL _ hA (Opposite.op (T₁ ∪ T₂))
      (G₀ ≫ E₂.map (homOfLE h20).op ≫ δ) (s₁ (T₁ ∪ T₂)) e1 e2 e3
    refine ⟨k.unop, ?_⟩
    intro T hK hT₁ hT₂ G H hGs hGh hHs hHh
    have h0T : T₁ ∪ T₂ ⊆ T := Finset.union_subset hT₁ hT₂
    have hnat : G ≫ E₂.map (homOfLE h0T).op = E₁.map (homOfLE h0T).op ≫ G₀ := by
      apply (sq₂ (T₁ ∪ T₂)).hom_ext
      · simp only [Category.assoc]
        rw [st₂, hGs, hG₀s]
        exact (hcomp' E₁ _ _ _ γ).symm
      · simp only [Category.assoc]
        rw [ht₂, reassoc_of% hGh, hG₀h, ht₁]
    apply (sq₁ T).hom_ext
    · rw [Category.assoc, hHs, Category.id_comp,
        ← hcomp' E₂ (homOfLE h0T).op (homOfLE h20).op, reassoc_of% hnat,
        ← hcomp' E₁ (homOfLE hK).op hik, hab]
      exact (hcomp' E₁ (homOfLE hK).op hik (homOfLE h0T).op (s₁ _)).trans (st₁ _ _ (homOfLE h0T))
    · rw [Category.assoc, hHh, hGh, Category.id_comp]

  obtain ⟨E₁, ρ₁, hE₁, s₁, hlim₁, hA₁, hC₁, hQ₁, hqcE₁, -, -, hL8₁, hL9₁, hL10₁, hL11₁, hL12₁⟩ :=
    wc_ap_fp_model_limit_presentation A Z f S X₁ h₁ π₁ hqc₁ hqs₁ hlfp₁ hpb₁
  obtain ⟨E₂, ρ₂, hE₂, s₂, hlim₂, hA₂, hC₂, hQ₂, -, -, -, hL8₂, hL9₂, hL10₂, hL11₂, hL12₂⟩ :=
    wc_ap_fp_model_limit_presentation A Z f S X₂ h₂ π₂ hqc₂ hqs₂ hlfp₂ hpb₂
  let Bt : Finset A → Scheme.{u} := fun T => Spec (.of ↥(Subring.closure ((S ∪ T : Finset A) : Set A)))
  let gS : ∀ T : Finset A, Bt T ⟶ Spec (.of ↥(Subring.closure (S : Set A))) := fun T =>
    Spec.map (CommRingCat.ofHom (Subring.inclusion (Subring.closure_mono
      (Finset.coe_subset.mpr (Finset.subset_union_left : S ⊆ S ∪ T)))))
  let gT : ∀ T T' : Finset A, (T ⟶ T') → (Bt T' ⟶ Bt T) := fun T T' g =>
    Spec.map (CommRingCat.ofHom (Subring.inclusion (Subring.closure_mono (Finset.coe_subset.mpr
      (Finset.union_subset_union_right (leOfHom g) : S ∪ T ⊆ S ∪ T')))))
  have hρh : ∀ T, ρ₁.app (Opposite.op T) ≫ hE₁ T = ρ₂.app (Opposite.op T) ≫ hE₂ T :=
    fun T => (hL8₁ T).w.trans (hL8₂ T).w.symm
  have hcond₁ : ∀ T, ρ₁.app (Opposite.op T) ≫ s₁ T ≫ h₁ = π₂ ≫ h₂ := fun T => by
    rw [reassoc_of% (hL10₁ T), hpb₁.w, hpb₂.w]
  have hcond₂ : ∀ T, ρ₂.app (Opposite.op T) ≫ s₂ T ≫ h₂ = π₁ ≫ h₁ := fun T => by
    rw [reassoc_of% (hL10₂ T), hpb₂.w, hpb₁.w]
  obtain ⟨T₁, γ, hγ1, hγ2⟩ := desc _ X₁ X₂ h₁ h₂ π₂ E₁ ρ₁ s₁ hlim₁ hA₁ hC₁ hQ₁ hlfp₂
    (fun _ _ g => hL12₁ g) hcond₁
  obtain ⟨T₂, δ, hδ1, hδ2⟩ := desc _ X₂ X₁ h₂ h₁ π₁ E₂ ρ₂ s₂ hlim₂ hA₂ hC₂ hQ₂ hlfp₁
    (fun _ _ g => hL12₂ g) hcond₂
  have := hlfp₁
  have := hlfp₂
  obtain ⟨K₁, hK₁⟩ := key _ Bt gS gT X₁ X₂ h₁ h₂ π₁ π₂ E₁ E₂ ρ₁ ρ₂ hE₁ hE₂ s₁ s₂ hlim₁ hA₁ hC₁
    inferInstance hL9₁ hL9₂ (fun _ _ g => hL11₁ g) (fun _ _ g => hL11₂ g) (fun _ _ g => hL12₁ g)
    (fun _ _ g => hL12₂ g) hρh hL10₁ hL10₂ T₁ γ T₂ δ hγ1 hγ2 hδ1 hδ2
  obtain ⟨K₂, hK₂⟩ := key _ Bt gS gT X₂ X₁ h₂ h₁ π₂ π₁ E₂ E₁ ρ₂ ρ₁ hE₂ hE₁ s₂ s₁ hlim₂ hA₂ hC₂
    inferInstance hL9₂ hL9₁ (fun _ _ g => hL11₂ g) (fun _ _ g => hL11₁ g) (fun _ _ g => hL12₂ g)
    (fun _ _ g => hL12₁ g) (fun T => (hρh T).symm) hL10₂ hL10₁ T₂ δ T₁ γ hδ1 hδ2 hγ1 hγ2
  obtain ⟨T₅, hK₁T, hK₂T, hT₁, hT₂⟩ : ∃ T₅ : Finset A, K₁ ⊆ T₅ ∧ K₂ ⊆ T₅ ∧ T₁ ⊆ T₅ ∧ T₂ ⊆ T₅ :=
    ⟨K₁ ∪ K₂ ∪ (T₁ ∪ T₂), fun x hx => by simp [hx], fun x hx => by simp [hx],
      fun x hx => by simp [hx], fun x hx => by simp [hx]⟩
  obtain ⟨G, hGs, hGh, hGρ⟩ := mkG _ Bt gS X₁ X₂ h₁ h₂ π₂ E₁ E₂ ρ₁ ρ₂ hE₁ hE₂ s₁ s₂ hL9₁ hL9₂
    (fun _ _ g => hL12₁ g) hρh hL10₂ T₁ γ hγ1 hγ2 T₅ hT₁
  obtain ⟨H, hHs, hHh, hHρ⟩ := mkG _ Bt gS X₂ X₁ h₂ h₁ π₁ E₂ E₁ ρ₂ ρ₁ hE₂ hE₁ s₂ s₁ hL9₂ hL9₁
    (fun _ _ g => hL12₂ g) (fun T => (hρh T).symm) hL10₁ T₂ δ hδ1 hδ2 T₅ hT₂
  have i1 := hK₁ T₅ hK₁T hT₁ hT₂ G H hGs hGh hHs hHh
  have i2 := hK₂ T₅ hK₂T hT₂ hT₁ H G hHs hHh hGs hGh
  refine ⟨S ∪ T₅, Finset.subset_union_left, E₁.obj (Opposite.op T₅), E₂.obj (Opposite.op T₅),
    hE₁ T₅, hE₂ T₅, ρ₁.app (Opposite.op T₅), s₁ T₅, s₂ T₅, ⟨G, H, i1, i2⟩, hqcE₁ T₅, hL8₁ T₅,
    hL9₁ T₅, hL9₂ T₅, hL10₁ T₅, ?_, hGh⟩
  show ρ₁.app _ ≫ G ≫ s₂ T₅ = π₂
  rw [reassoc_of% hGρ, hL10₂]

theorem wc_ap_fp_two_chart_compatible_models : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)) (V U : Y.Opens), IsCompact ((V ⊓ U : Y.Opens) : Set Y) → ∀ (S₁ S₂ : Finset A) (V₁ U₁ : Scheme.{u}) (hV₁ : V₁ ⟶ Spec (.of ↥(Subring.closure (S₁ : Set A)))) (hU₁ : U₁ ⟶ Spec (.of ↥(Subring.closure (S₂ : Set A)))) (πV₁ : (V : Scheme.{u}) ⟶ V₁) (πU₁ : (U : Scheme.{u}) ⟶ U₁), QuasiCompact hV₁ → QuasiSeparated hV₁ → LocallyOfFinitePresentation hV₁ → QuasiCompact hU₁ → QuasiSeparated hU₁ → LocallyOfFinitePresentation hU₁ → IsPullback πV₁ (V.ι ≫ h) hV₁ (Spec.map (CommRingCat.ofHom (Subring.closure (S₁ : Set A)).subtype)) → IsPullback πU₁ (U.ι ≫ h) hU₁ (Spec.map (CommRingCat.ofHom (Subring.closure (S₂ : Set A)).subtype)) → ∃ (S : Finset A) (V₀ U₀ W₀ : Scheme.{u}) (hV : V₀ ⟶ Spec (.of ↥(Subring.closure (S : Set A)))) (hU : U₀ ⟶ Spec (.of ↥(Subring.closure (S : Set A)))) (p : W₀ ⟶ V₀) (q : W₀ ⟶ U₀) (πV : (V : Scheme.{u}) ⟶ V₀) (πU : (U : Scheme.{u}) ⟶ U₀) (πW : ((V ⊓ U : Y.Opens) : Scheme.{u}) ⟶ W₀), IsOpenImmersion p ∧ IsOpenImmersion q ∧ CompactSpace W₀ ∧ QuasiCompact hV ∧ QuasiSeparated hV ∧ LocallyOfFinitePresentation hV ∧ QuasiCompact hU ∧ QuasiSeparated hU ∧ LocallyOfFinitePresentation hU ∧ p ≫ hV = q ≫ hU ∧ IsPullback πV (V.ι ≫ h) hV (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype)) ∧ IsPullback πU (U.ι ≫ h) hU (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype)) ∧ IsPullback πW ((V ⊓ U).ι ≫ h) (p ≫ hV) (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype)) ∧ πW ≫ p = Y.homOfLE inf_le_left ≫ πV ∧ πW ≫ q = Y.homOfLE inf_le_right ≫ πU :=
by
  intro A _ Y h V U hW S₁ S₂ V₁ U₁ hV₁ hU₁ πV₁ πU₁ hV₁qc hV₁qs hV₁lfp hU₁qc hU₁qs hU₁lfp
    hV₁pb hU₁pb
  classical

  have H1 : ∀ (Z : Scheme.{u}) (f : Z ⟶ Spec (.of A)) (S S' : Finset A) (hSS' : S ⊆ S')
      (X : Scheme.{u}) (h₀ : X ⟶ Spec (.of ↥(Subring.closure (S : Set A)))) (π : Z ⟶ X),
      QuasiCompact h₀ → QuasiSeparated h₀ → LocallyOfFinitePresentation h₀ →
      IsPullback π f h₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype)) →
      ∃ (X' : Scheme.{u}) (h' : X' ⟶ Spec (.of ↥(Subring.closure (S' : Set A)))) (π' : Z ⟶ X')
        (r : X' ⟶ X), QuasiCompact h' ∧ QuasiSeparated h' ∧ LocallyOfFinitePresentation h' ∧
        IsPullback π' f h' (Spec.map (CommRingCat.ofHom (Subring.closure (S' : Set A)).subtype)) ∧
        IsPullback r h' h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion
          (Subring.closure_mono (Finset.coe_subset.mpr hSS'))))) ∧ π' ≫ r = π := by
    intro Z f S S' hSS' X h₀ π _ _ _ hpb
    have hR2 : Spec.map (CommRingCat.ofHom (Subring.closure (S' : Set A)).subtype) ≫
        Spec.map (CommRingCat.ofHom (Subring.inclusion
          (Subring.closure_mono (Finset.coe_subset.mpr hSS')))) =
        Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      rfl
    have hw : π ≫ h₀ = (f ≫ Spec.map (CommRingCat.ofHom (Subring.closure (S' : Set A)).subtype)) ≫
        Spec.map (CommRingCat.ofHom (Subring.inclusion
          (Subring.closure_mono (Finset.coe_subset.mpr hSS')))) := by
      rw [Category.assoc, hR2]; exact hpb.w
    refine ⟨_, Limits.pullback.snd _ _, Limits.pullback.lift π _ hw, Limits.pullback.fst _ _,
      inferInstance, inferInstance, inferInstance, ?_, IsPullback.of_hasPullback _ _,
      Limits.pullback.lift_fst _ _ _⟩
    refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _) (IsPullback.of_hasPullback _ _)
    rw [Limits.pullback.lift_fst, hR2]
    exact hpb

  have H3 : ∀ (V W : Y.Opens) (hWV : W ≤ V) (S : Finset A) (X : Scheme.{u})
      (h₀ : X ⟶ Spec (.of ↥(Subring.closure (S : Set A)))) (π : (V : Scheme.{u}) ⟶ X)
      (O : X.Opens),
      IsPullback π (V.ι ≫ h) h₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype)) →
      π ⁻¹ᵁ O = V.ι ⁻¹ᵁ W →
      ∃ πW : (W : Scheme.{u}) ⟶ (O : Scheme.{u}),
        IsPullback πW (W.ι ≫ h) (O.ι ≫ h₀)
          (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype)) ∧
        πW ≫ O.ι = Y.homOfLE hWV ≫ π := by
    intro V W hWV S X h₀ π O hpb hO
    have Q := (isPullback_morphismRestrict π O).paste_vert hpb
    let φ : (W : Scheme.{u}) ≅ (π ⁻¹ᵁ O : Scheme.{u}) :=
      (Scheme.Opens.isoOfLE hWV).symm ≪≫ Scheme.isoOfEq _ hO.symm
    have hstar : φ.hom ≫ (π ⁻¹ᵁ O).ι ≫ V.ι = W.ι := by
      simp only [φ, Iso.trans_hom, Iso.symm_hom, Category.assoc]
      rw [Scheme.isoOfEq_hom_ι_assoc, Scheme.Opens.isoOfLE_inv_ι]
    have hstar' : φ.hom ≫ (π ⁻¹ᵁ O).ι = Y.homOfLE hWV := by
      rw [← cancel_mono V.ι, Category.assoc, hstar, Scheme.homOfLE_ι]
    refine ⟨φ.hom ≫ π ∣_ O, ?_, ?_⟩
    · refine IsPullback.of_iso Q φ.symm (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
      · simp
      · rw [← hstar]; simp
      · simp
      · simp
    · rw [Category.assoc, morphismRestrict_ι, ← Category.assoc, hstar']

  have H5 : ∀ (T T' X O X' X₁' : Scheme.{u}) (g : T' ⟶ T) (hX : X ⟶ T) (j : O ⟶ X)
      [IsOpenImmersion j] (h' : X' ⟶ T') (r : X' ⟶ X) (h₁' : X₁' ⟶ T') (r₁ : X₁' ⟶ O),
      IsPullback r h' hX g → IsPullback r₁ h₁' (j ≫ hX) g →
      ∃ p : X₁' ⟶ X', IsOpenImmersion p ∧ p ≫ h' = h₁' ∧ p ≫ r = r₁ ≫ j := by
    intro T T' X O X' X₁' g hX j _ h' r h₁' r₁ hV hO
    have hw : (r₁ ≫ j) ≫ hX = h₁' ≫ g := by rw [Category.assoc]; exact hO.w
    have hsq : IsPullback r₁ (hV.lift (r₁ ≫ j) h₁' hw) j r := by
      refine IsPullback.of_bot ?_ (hV.lift_fst _ _ hw).symm hV
      rw [hV.lift_snd]
      exact hO
    exact ⟨hV.lift (r₁ ≫ j) h₁' hw,
      MorphismProperty.of_isPullback (P := @IsOpenImmersion) hsq inferInstance,
      hV.lift_snd _ _ hw, hV.lift_fst _ _ hw⟩

  have Hmove : ∀ (Z : Scheme.{u}) (f : Z ⟶ Spec (.of A)) (S S' : Finset A) (hSS' : S ⊆ S')
      (X : Scheme.{u}) (h₀ : X ⟶ Spec (.of ↥(Subring.closure (S : Set A)))) (π : Z ⟶ X)
      (O : X.Opens),
      QuasiCompact h₀ → QuasiSeparated h₀ → LocallyOfFinitePresentation h₀ →
      IsPullback π f h₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype)) →
      IsCompact (O : Set X) →
      ∃ (X' : Scheme.{u}) (h' : X' ⟶ Spec (.of ↥(Subring.closure (S' : Set A)))) (π' : Z ⟶ X')
        (O' : X'.Opens), QuasiCompact h' ∧ QuasiSeparated h' ∧ LocallyOfFinitePresentation h' ∧
        IsPullback π' f h' (Spec.map (CommRingCat.ofHom (Subring.closure (S' : Set A)).subtype)) ∧
        IsCompact (O' : Set X') ∧ π' ⁻¹ᵁ O' = π ⁻¹ᵁ O := by
    intro Z f S S' hSS' X h₀ π O h1 h2 h3 hpb hO
    obtain ⟨X', h', π', r, h1', h2', h3', hpb', hr, hπr⟩ := H1 Z f S S' hSS' X h₀ π h1 h2 h3 hpb
    haveI : QuasiCompact r :=
      MorphismProperty.of_isPullback (P := @QuasiCompact) hr.flip inferInstance
    refine ⟨X', h', π', r ⁻¹ᵁ O, h1', h2', h3', hpb', r.isCompact_preimage hO, ?_⟩
    rw [← Scheme.Hom.comp_preimage, hπr]

  have hpre_cpt : ∀ (V W : Y.Opens), W ≤ V → IsCompact (W : Set Y) →
      IsCompact ((V.ι ⁻¹ᵁ W : (V : Scheme.{u}).Opens) : Set (V : Scheme.{u})) := by
    intro V W hWV hW'
    rw [V.ι.isOpenEmbedding.isInducing.isCompact_iff]
    change IsCompact (V.ι '' (V.ι ⁻¹' (W : Set Y)))
    rw [Set.image_preimage_eq_of_subset]
    · exact hW'
    · rw [Scheme.Opens.range_ι]; exact hWV

  obtain ⟨EV, ρV, hEV, sEV, ⟨hlimV⟩, hAffV, -, -, hqcV, hqsV, hlfpV, hpbV, -, -, -, -⟩ :=
    wc_ap_fp_model_limit_presentation A (V : Scheme.{u}) (V.ι ≫ h) S₁ V₁ hV₁ πV₁ hV₁qc hV₁qs
      hV₁lfp hV₁pb
  obtain ⟨⟨Ta⟩, OV, hOVc, hOV⟩ := @exists_preimage_eq _ _ EV (Limits.Cone.mk _ ρV) hlimV _
    hAffV _ (hpre_cpt V (V ⊓ U) inf_le_left hW)

  obtain ⟨EU, ρU, hEU, sEU, ⟨hlimU⟩, hAffU, -, -, hqcU, hqsU, hlfpU, hpbU, -, -, -, -⟩ :=
    wc_ap_fp_model_limit_presentation A (U : Scheme.{u}) (U.ι ≫ h) S₂ U₁ hU₁ πU₁ hU₁qc hU₁qs
      hU₁lfp hU₁pb
  obtain ⟨⟨Tb⟩, OU, hOUc, hOU⟩ := @exists_preimage_eq _ _ EU (Limits.Cone.mk _ ρU) hlimU _
    hAffU _ (hpre_cpt U (V ⊓ U) inf_le_right hW)

  obtain ⟨V₃, hV₃, πV₃, OV₃, hV₃qc, hV₃qs, hV₃lfp, hV₃pb, hOV₃c, hOV₃⟩ :=
    Hmove (V : Scheme.{u}) (V.ι ≫ h) (S₁ ∪ Ta) ((S₁ ∪ Ta) ∪ (S₂ ∪ Tb)) Finset.subset_union_left
      _ (hEV Ta) (ρV.app (Opposite.op Ta)) OV (hqcV Ta) (hqsV Ta) (hlfpV Ta) (hpbV Ta) hOVc
  obtain ⟨U₃, hU₃, πU₃, OU₃, hU₃qc, hU₃qs, hU₃lfp, hU₃pb, hOU₃c, hOU₃⟩ :=
    Hmove (U : Scheme.{u}) (U.ι ≫ h) (S₂ ∪ Tb) ((S₁ ∪ Ta) ∪ (S₂ ∪ Tb)) Finset.subset_union_right
      _ (hEU Tb) (ρU.app (Opposite.op Tb)) OU (hqcU Tb) (hqsU Tb) (hlfpU Tb) (hpbU Tb) hOUc

  obtain ⟨πWV, hWVpb, hWVc⟩ := H3 V (V ⊓ U) inf_le_left _ V₃ hV₃ πV₃ OV₃ hV₃pb (hOV₃.trans hOV)
  obtain ⟨πWU, hWUpb, hWUc⟩ := H3 U (V ⊓ U) inf_le_right _ U₃ hU₃ πU₃ OU₃ hU₃pb (hOU₃.trans hOU)
  haveI : CompactSpace (OV₃ : Scheme.{u}) := isCompact_iff_compactSpace.mp hOV₃c
  haveI : CompactSpace (OU₃ : Scheme.{u}) := isCompact_iff_compactSpace.mp hOU₃c
  have hqc1 : QuasiCompact (OV₃.ι ≫ hV₃) := (quasiCompact_iff_compactSpace _).mpr inferInstance
  have hqc2 : QuasiCompact (OU₃.ι ≫ hU₃) := (quasiCompact_iff_compactSpace _).mpr inferInstance

  obtain ⟨S', hSS', X₁', X₂', h₁', h₂', π₁', r₁, r₂, e, hqc₁', hpb₁', hr₁, hr₂, hπr₁, hπr₂, he⟩ :=
    wc_ap_fp_models_unique A ((V ⊓ U : Y.Opens) : Scheme.{u}) ((V ⊓ U).ι ≫ h) _ (OV₃ : Scheme.{u})
      (OU₃ : Scheme.{u}) (OV₃.ι ≫ hV₃) (OU₃.ι ≫ hU₃) πWV πWU hqc1 inferInstance inferInstance
      hqc2 inferInstance inferInstance hWVpb hWUpb

  obtain ⟨V₄, hV₄, πV₄, rV, hV₄qc, hV₄qs, hV₄lfp, hV₄pb, hrV, hπrV⟩ :=
    H1 (V : Scheme.{u}) (V.ι ≫ h) _ S' hSS' V₃ hV₃ πV₃ hV₃qc hV₃qs hV₃lfp hV₃pb
  obtain ⟨U₄, hU₄, πU₄, rU, hU₄qc, hU₄qs, hU₄lfp, hU₄pb, hrU, hπrU⟩ :=
    H1 (U : Scheme.{u}) (U.ι ≫ h) _ S' hSS' U₃ hU₃ πU₃ hU₃qc hU₃qs hU₃lfp hU₃pb

  obtain ⟨p, hp, hph, hpr⟩ := H5 _ _ V₃ (OV₃ : Scheme.{u}) V₄ X₁' _ hV₃ OV₃.ι hV₄ rV h₁' r₁ hrV hr₁
  obtain ⟨pU, hpU, hpUh, hpUr⟩ :=
    H5 _ _ U₃ (OU₃ : Scheme.{u}) U₄ X₂' _ hU₃ OU₃.ι hU₄ rU h₂' r₂ hrU hr₂
  haveI := hp
  haveI := hpU
  haveI := hqc₁'

  refine ⟨S', V₄, U₄, X₁', hV₄, hU₄, p, e.hom ≫ pU, πV₄, πU₄, π₁', hp, inferInstance,
    QuasiCompact.compactSpace_of_compactSpace h₁', hV₄qc, hV₄qs, hV₄lfp, hU₄qc, hU₄qs, hU₄lfp,
    ?_, hV₄pb, hU₄pb, ?_, ?_, ?_⟩
  · rw [hph, Category.assoc, hpUh, he]
  · rw [hph]; exact hpb₁'
  · apply hrV.hom_ext
    · simp only [Category.assoc]
      rw [hpr, reassoc_of% hπr₁, hWVc, hπrV]
    · simp only [Category.assoc]
      rw [hph, hpb₁'.w, hV₄pb.w]
      simp only [Category.assoc, Scheme.homOfLE_ι_assoc]
  · apply hrU.hom_ext
    · simp only [Category.assoc]
      rw [hpUr, reassoc_of% hπr₂, hWUc, hπrU]
    · simp only [Category.assoc]
      rw [hpUh, he, hpb₁'.w, hU₄pb.w]
      simp only [Category.assoc, Scheme.homOfLE_ι_assoc]

theorem wc_ap_pushout_open_immersion_base_change : ∀ (R : Type u) [CommRing R] (T : Scheme.{u}) (g : T ⟶ Spec (.of R)) (Y : Scheme.{u}) (h : Y ⟶ T) (V U : Y.Opens) (V₀ U₀ W₀ : Scheme.{u}) (hV : V₀ ⟶ Spec (.of R)) (hU : U₀ ⟶ Spec (.of R)) (p : W₀ ⟶ V₀) (q : W₀ ⟶ U₀) [IsOpenImmersion p] [IsOpenImmersion q] (w : p ≫ hV = q ≫ hU) (πV : (V : Scheme.{u}) ⟶ V₀) (πU : (U : Scheme.{u}) ⟶ U₀) (πW : ((V ⊓ U : Y.Opens) : Scheme.{u}) ⟶ W₀), IsPullback πV (V.ι ≫ h) hV g → IsPullback πU (U.ι ≫ h) hU g → IsPullback πW ((V ⊓ U).ι ≫ h) (p ≫ hV) g → πW ≫ p = Y.homOfLE inf_le_left ≫ πV → πW ≫ q = Y.homOfLE inf_le_right ≫ πU → ∃ π : ((V ⊔ U : Y.Opens) : Scheme.{u}) ⟶ Limits.pushout p q, IsPullback π ((V ⊔ U).ι ≫ h) (Limits.pushout.desc hV hU w) g :=
by
  intro R _ T g Y h V U V₀ U₀ W₀ hV hU p q _ _ w πV πU πW HV HU HW hpW hqW

  have s4 : ∀ {P X Y' Z : Scheme.{u}} {fst : P ⟶ X} {snd : P ⟶ Y'} {f : X ⟶ Z} {g' : Y' ⟶ Z},
      IsPullback fst snd f g' → Set.range fst = f ⁻¹' Set.range g' := by
    intro P X Y' Z fst snd f g' H
    rw [← Scheme.Pullback.range_fst]
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      exact ⟨H.isoPullback.hom y, by rw [← Scheme.Hom.comp_apply, H.isoPullback_hom_fst]⟩
    · rintro ⟨t, rfl⟩
      exact ⟨H.isoPullback.inv t, by rw [← Scheme.Hom.comp_apply, H.isoPullback_inv_fst]⟩

  have s5 : ∀ {X P A B : Scheme.{u}} (κ : X ⟶ P) (a : A ⟶ X) (b : B ⟶ X) [IsOpenImmersion a]
      [IsOpenImmersion b] [IsOpenImmersion (a ≫ κ)] [IsOpenImmersion (b ≫ κ)],
      (∀ x, x ∈ Set.range (a ≫ κ) ∨ x ∈ Set.range (b ≫ κ)) →
      κ ⁻¹' Set.range (a ≫ κ) ⊆ Set.range a → κ ⁻¹' Set.range (b ≫ κ) ⊆ Set.range b →
      IsIso κ := by
    intro X P A B κ a b _ _ _ _ hcov ha hb
    have key : ∀ {C : Scheme.{u}} (c : C ⟶ X) [IsOpenImmersion c] [IsOpenImmersion (c ≫ κ)],
        κ ⁻¹' Set.range (c ≫ κ) ⊆ Set.range c → IsOpenImmersion (κ ∣_ (c ≫ κ).opensRange) := by
      intro C c _ _ hc
      have hsub : Set.range (κ ⁻¹ᵁ (c ≫ κ).opensRange).ι ⊆ Set.range c := by
        rw [Scheme.Opens.range_ι]
        intro x hx
        exact hc hx
      have hl := IsOpenImmersion.lift_fac c (κ ⁻¹ᵁ (c ≫ κ).opensRange).ι hsub
      haveI : IsOpenImmersion (IsOpenImmersion.lift c (κ ⁻¹ᵁ (c ≫ κ).opensRange).ι hsub ≫ c) := by
        rw [hl]; infer_instance
      haveI : IsOpenImmersion (IsOpenImmersion.lift c (κ ⁻¹ᵁ (c ≫ κ).opensRange).ι hsub) :=
        IsOpenImmersion.of_comp _ c
      haveI : IsOpenImmersion (κ ∣_ (c ≫ κ).opensRange ≫ ((c ≫ κ).opensRange).ι) := by
        rw [morphismRestrict_ι, ← hl, Category.assoc]; infer_instance
      exact IsOpenImmersion.of_comp _ ((c ≫ κ).opensRange).ι
    rw [isIso_iff_isOpenImmersion_and_surjective]
    refine ⟨?_, ⟨fun x => ?_⟩⟩
    · refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsOpenImmersion)
        (fun i : Bool => cond i (a ≫ κ).opensRange (b ≫ κ).opensRange) ?_ ?_
      · rw [eq_top_iff]
        intro x _
        rw [TopologicalSpace.Opens.mem_iSup]
        rcases hcov x with hx | hx
        · exact ⟨true, hx⟩
        · exact ⟨false, hx⟩
      · intro i
        cases i
        · exact key b hb
        · exact key a ha
    · rcases hcov x with ⟨t, ht⟩ | ⟨t, ht⟩
      · exact ⟨a t, (Scheme.Hom.comp_apply a κ t).symm.trans ht⟩
      · exact ⟨b t, (Scheme.Hom.comp_apply b κ t).symm.trans ht⟩

  have s3a : ∀ x : ↥(Limits.pushout p q),
      (∃ a, Limits.pushout.inl p q a = x) ∨ (∃ b, Limits.pushout.inr p q b = x) := by
    intro x
    obtain ⟨i, xi, hxi⟩ := Scheme.IsLocallyDirected.ι_jointly_surjective (Limits.span p q) x
    have hz : Limits.colimit.ι (Limits.span p q) Limits.WalkingSpan.zero =
        p ≫ Limits.pushout.inl p q :=
      Limits.PushoutCocone.condition_zero (Limits.colimit.cocone (Limits.span p q))
    rcases i with _ | ⟨_ | _⟩
    · left
      refine ⟨p xi, ?_⟩
      rw [← hxi]
      change _ = Limits.colimit.ι (Limits.span p q) Limits.WalkingSpan.zero xi
      rw [hz, Scheme.Hom.comp_apply]
    · exact Or.inl ⟨xi, hxi⟩
    · exact Or.inr ⟨xi, hxi⟩
  have s3b : ∀ (a : V₀) (b : U₀), Limits.pushout.inl p q a = Limits.pushout.inr p q b →
      ∃ z, p z = a ∧ q z = b := by
    intro a b hab
    obtain ⟨k, fi, fj, z, hz1, hz2⟩ := (Scheme.IsLocallyDirected.ι_eq_ι_iff (Limits.span p q)
      (i := Limits.WalkingSpan.left) (j := Limits.WalkingSpan.right) (xi := a) (xj := b)).mp hab
    rcases k with _ | ⟨_ | _⟩
    · change Limits.WidePushoutShape.Hom _ _ at fi fj
      cases fi
      cases fj
      exact ⟨z, hz1, hz2⟩
    · change Limits.WidePushoutShape.Hom _ _ at fj
      cases fj
    · change Limits.WidePushoutShape.Hom _ _ at fi
      cases fi

  have hsurj : ∀ x : ((V ⊔ U : Y.Opens) : Scheme.{u}),
      (∃ v : (V : Scheme.{u}), Y.homOfLE (le_sup_left : V ≤ V ⊔ U) v = x) ∨
      (∃ u' : (U : Scheme.{u}), Y.homOfLE (le_sup_right : U ≤ V ⊔ U) u' = x) := by
    intro x
    rcases TopologicalSpace.Opens.mem_sup.mp x.2 with hx | hx
    · exact Or.inl ⟨⟨x.1, hx⟩, Subtype.ext (Scheme.homOfLE_apply _ _)⟩
    · exact Or.inr ⟨⟨x.1, hx⟩, Subtype.ext (Scheme.homOfLE_apply _ _)⟩
  let 𝒰 : ((V ⊔ U : Y.Opens) : Scheme.{u}).OpenCover :=
    Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) Bool
      (fun b => cond b (V : Scheme.{u}) (U : Scheme.{u}))
      (fun b => match b with
        | true => Y.homOfLE (le_sup_left : V ≤ V ⊔ U)
        | false => Y.homOfLE (le_sup_right : U ≤ V ⊔ U))
      (fun x => by
        rcases hsurj x with ⟨v, hv⟩ | ⟨u', hu⟩
        · exact ⟨true, v, hv⟩
        · exact ⟨false, u', hu⟩)
      (fun b => by cases b <;> infer_instance)

  have hext : ∀ {Z : Scheme.{u}} (f₁ f₂ : ((V ⊔ U : Y.Opens) : Scheme.{u}) ⟶ Z),
      Y.homOfLE (le_sup_left : V ≤ V ⊔ U) ≫ f₁ = Y.homOfLE (le_sup_left : V ≤ V ⊔ U) ≫ f₂ →
      Y.homOfLE (le_sup_right : U ≤ V ⊔ U) ≫ f₁ = Y.homOfLE (le_sup_right : U ≤ V ⊔ U) ≫ f₂ →
      f₁ = f₂ := by
    intro Z f₁ f₂ h1 h2
    refine Scheme.Cover.hom_ext 𝒰 f₁ f₂ (fun (b : Bool) => ?_)
    cases b
    · exact h2
    · exact h1

  have hcompat : Y.homOfLE (inf_le_left : V ⊓ U ≤ V) ≫ πV ≫ Limits.pushout.inl p q =
      Y.homOfLE (inf_le_right : V ⊓ U ≤ U) ≫ πU ≫ Limits.pushout.inr p q := by
    calc _ = (πW ≫ p) ≫ Limits.pushout.inl p q := by rw [hpW, Category.assoc]
      _ = (πW ≫ q) ≫ Limits.pushout.inr p q := by
        rw [Category.assoc, Category.assoc, Limits.pushout.condition]
      _ = _ := by rw [hqW, Category.assoc]
  obtain ⟨π, hjV, hjU⟩ : ∃ π : ((V ⊔ U : Y.Opens) : Scheme.{u}) ⟶ Limits.pushout p q,
      Y.homOfLE (le_sup_left : V ≤ V ⊔ U) ≫ π = πV ≫ Limits.pushout.inl p q ∧
      Y.homOfLE (le_sup_right : U ≤ V ⊔ U) ≫ π = πU ≫ Limits.pushout.inr p q := by
    let Fm : ∀ b : 𝒰.I₀, 𝒰.X b ⟶ Limits.pushout p q := fun (b : Bool) => match b with
      | true => πV ≫ Limits.pushout.inl p q
      | false => πU ≫ Limits.pushout.inr p q
    have sq := isPullback_opens_inf_le (le_sup_left : V ≤ V ⊔ U) (le_sup_right : U ≤ V ⊔ U)
    have hglue : ∀ x y : 𝒰.I₀, Limits.pullback.fst (𝒰.f x) (𝒰.f y) ≫ Fm x =
        Limits.pullback.snd (𝒰.f x) (𝒰.f y) ≫ Fm y := by
      refine fun (x : Bool) (y : Bool) => ?_
      cases x <;> cases y
      · have : Mono (𝒰.f false) := by
          change Mono (Y.homOfLE (le_sup_right : U ≤ V ⊔ U)); infer_instance
        rw [Limits.fst_eq_snd_of_mono_eq]
      · have e1 : Limits.pullback.fst (𝒰.f false) (𝒰.f true) =
            sq.flip.isoPullback.inv ≫ Y.homOfLE (inf_le_right : V ⊓ U ≤ U) :=
          sq.flip.isoPullback_inv_fst.symm
        have e2 : Limits.pullback.snd (𝒰.f false) (𝒰.f true) =
            sq.flip.isoPullback.inv ≫ Y.homOfLE (inf_le_left : V ⊓ U ≤ V) :=
          sq.flip.isoPullback_inv_snd.symm
        rw [e1, e2]
        exact (Category.assoc _ _ _).trans
          ((congrArg (fun k => sq.flip.isoPullback.inv ≫ k) hcompat.symm).trans
            (Category.assoc _ _ _).symm)
      · have e1 : Limits.pullback.fst (𝒰.f true) (𝒰.f false) =
            sq.isoPullback.inv ≫ Y.homOfLE (inf_le_left : V ⊓ U ≤ V) :=
          sq.isoPullback_inv_fst.symm
        have e2 : Limits.pullback.snd (𝒰.f true) (𝒰.f false) =
            sq.isoPullback.inv ≫ Y.homOfLE (inf_le_right : V ⊓ U ≤ U) :=
          sq.isoPullback_inv_snd.symm
        rw [e1, e2]
        exact (Category.assoc _ _ _).trans
          ((congrArg (fun k => sq.isoPullback.inv ≫ k) hcompat).trans
            (Category.assoc _ _ _).symm)
      · have : Mono (𝒰.f true) := by
          change Mono (Y.homOfLE (le_sup_left : V ≤ V ⊔ U)); infer_instance
        rw [Limits.fst_eq_snd_of_mono_eq]
    exact ⟨Scheme.Cover.glueMorphisms 𝒰 Fm hglue, Scheme.Cover.ι_glueMorphisms 𝒰 Fm hglue true,
      Scheme.Cover.ι_glueMorphisms 𝒰 Fm hglue false⟩

  have comm : π ≫ Limits.pushout.desc hV hU w = ((V ⊔ U).ι ≫ h) ≫ g := by
    apply hext
    · calc _ = πV ≫ hV := by rw [reassoc_of% hjV, Limits.pushout.inl_desc]
        _ = (V.ι ≫ h) ≫ g := HV.w
        _ = _ := by
          rw [← Scheme.homOfLE_ι Y (le_sup_left : V ≤ V ⊔ U)]; simp only [Category.assoc]
    · calc _ = πU ≫ hU := by rw [reassoc_of% hjU, Limits.pushout.inr_desc]
        _ = (U.ι ≫ h) ≫ g := HU.w
        _ = _ := by
          rw [← Scheme.homOfLE_ι Y (le_sup_right : U ≤ V ⊔ U)]; simp only [Category.assoc]

  obtain ⟨κ, hκ1, hκ2⟩ : ∃ κ : ((V ⊔ U : Y.Opens) : Scheme.{u}) ⟶
      Limits.pullback (Limits.pushout.desc hV hU w) g,
      κ ≫ Limits.pullback.fst _ _ = π ∧ κ ≫ Limits.pullback.snd _ _ = (V ⊔ U).ι ≫ h :=
    ⟨Limits.pullback.lift π _ comm, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  suffices hiso : IsIso κ from ⟨π, IsPullback.of_iso_pullback ⟨comm⟩ (asIso κ) hκ1 hκ2⟩

  have SqV : IsPullback (Y.homOfLE (le_sup_left : V ≤ V ⊔ U) ≫ κ) πV
      (Limits.pullback.fst (Limits.pushout.desc hV hU w) g) (Limits.pushout.inl p q) := by
    refine IsPullback.of_right ?_ ?_
      (IsPullback.of_hasPullback (Limits.pushout.desc hV hU w) g).flip
    · rw [Category.assoc, hκ2, ← Category.assoc, Scheme.homOfLE_ι, Limits.pushout.inl_desc]
      exact HV.flip
    · rw [Category.assoc, hκ1, hjV]
  have SqU : IsPullback (Y.homOfLE (le_sup_right : U ≤ V ⊔ U) ≫ κ) πU
      (Limits.pullback.fst (Limits.pushout.desc hV hU w) g) (Limits.pushout.inr p q) := by
    refine IsPullback.of_right ?_ ?_
      (IsPullback.of_hasPullback (Limits.pushout.desc hV hU w) g).flip
    · rw [Category.assoc, hκ2, ← Category.assoc, Scheme.homOfLE_ι, Limits.pushout.inr_desc]
      exact HU.flip
    · rw [Category.assoc, hκ1, hjU]
  haveI hoV : IsOpenImmersion (Y.homOfLE (le_sup_left : V ≤ V ⊔ U) ≫ κ) :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) SqV.flip inferInstance
  haveI hoU : IsOpenImmersion (Y.homOfLE (le_sup_right : U ≤ V ⊔ U) ≫ κ) :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) SqU.flip inferInstance
  have RV := s4 SqV
  have RU := s4 SqU

  have SqOU : IsPullback (Y.homOfLE (inf_le_right : V ⊓ U ≤ U)) πW πU q := by
    refine IsPullback.of_right ?_ hqW.symm HU.flip
    rw [← Category.assoc, Scheme.homOfLE_ι, ← w]
    exact HW.flip
  have SqOV : IsPullback (Y.homOfLE (inf_le_left : V ⊓ U ≤ V)) πW πV p := by
    refine IsPullback.of_right ?_ hpW.symm HV.flip
    rw [← Category.assoc, Scheme.homOfLE_ι]
    exact HW.flip
  have OU := s4 SqOU
  have OV := s4 SqOV

  refine s5 κ (Y.homOfLE (le_sup_left : V ≤ V ⊔ U)) (Y.homOfLE (le_sup_right : U ≤ V ⊔ U))
    ?_ ?_ ?_
  · intro x
    rw [RV, RU]
    rcases s3a (Limits.pullback.fst (Limits.pushout.desc hV hU w) g x) with ⟨a, ha⟩ | ⟨b, hb⟩
    · exact Or.inl ⟨a, ha⟩
    · exact Or.inr ⟨b, hb⟩
  · intro y hy
    rw [Set.mem_preimage, RV, Set.mem_preimage] at hy
    obtain ⟨a, ha⟩ := hy
    have hF4 : Limits.pullback.fst (Limits.pushout.desc hV hU w) g (κ y) = π y := by
      rw [← Scheme.Hom.comp_apply, hκ1]
    rw [hF4] at ha
    rcases hsurj y with ⟨v, rfl⟩ | ⟨u', rfl⟩
    · exact ⟨v, rfl⟩
    · rw [← Scheme.Hom.comp_apply, hjU, Scheme.Hom.comp_apply] at ha
      obtain ⟨z, -, hz⟩ := s3b a (πU u') ha
      have hu : u' ∈ Set.range (Y.homOfLE (inf_le_right : V ⊓ U ≤ U)) := by
        rw [OU]; exact ⟨z, hz⟩
      obtain ⟨t, rfl⟩ := hu
      refine ⟨Y.homOfLE (inf_le_left : V ⊓ U ≤ V) t, ?_⟩
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Scheme.homOfLE_homOfLE,
        Scheme.homOfLE_homOfLE]
  · intro y hy
    rw [Set.mem_preimage, RU, Set.mem_preimage] at hy
    obtain ⟨b, hb⟩ := hy
    have hF4 : Limits.pullback.fst (Limits.pushout.desc hV hU w) g (κ y) = π y := by
      rw [← Scheme.Hom.comp_apply, hκ1]
    rw [hF4] at hb
    rcases hsurj y with ⟨v, rfl⟩ | ⟨u', rfl⟩
    · rw [← Scheme.Hom.comp_apply, hjV, Scheme.Hom.comp_apply] at hb
      obtain ⟨z, hz, -⟩ := s3b (πV v) b hb.symm
      have hv : v ∈ Set.range (Y.homOfLE (inf_le_left : V ⊓ U ≤ V)) := by
        rw [OV]; exact ⟨z, hz⟩
      obtain ⟨t, rfl⟩ := hv
      refine ⟨Y.homOfLE (inf_le_right : V ⊓ U ≤ U) t, ?_⟩
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Scheme.homOfLE_homOfLE,
        Scheme.homOfLE_homOfLE]
    · exact ⟨u', rfl⟩

theorem wc_ap_fp_scheme_descends_to_finset : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)) [QuasiCompact h] [QuasiSeparated h] [LocallyOfFinitePresentation h], ∃ (S₀ : Finset A) (Y₀ : Scheme.{u}) (h₀ : Y₀ ⟶ Spec (.of ↥(Subring.closure (S₀ : Set A)))) (_ : QuasiCompact h₀) (_ : QuasiSeparated h₀) (_ : LocallyOfFinitePresentation h₀) (e : Y ⟶ Limits.pullback h₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype))), IsIso e ∧ e ≫ Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype)) = h :=
by
  intro A _ Y h _ _ _
  classical
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace h
  haveI : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated h
  let P : Y.Opens → Prop := fun W => ∃ (S : Finset A) (X₀ : Scheme.{u})
    (h₀ : X₀ ⟶ Spec (.of ↥(Subring.closure (S : Set A)))) (π : (W : Scheme.{u}) ⟶ X₀),
    QuasiCompact h₀ ∧ QuasiSeparated h₀ ∧ LocallyOfFinitePresentation h₀ ∧
      IsPullback π (W.ι ≫ h) h₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype))
  have hP : P ⊤ := by
    refine compact_open_induction_on (P := P) ⊤ (by simpa using isCompact_univ) ?_ ?_
    · haveI : IsAffine (⊥ : Y.Opens) := isAffineOpen_bot Y
      exact wc_ap_fp_affine_model_over_finset A (⊥ : Y.Opens) ((⊥ : Y.Opens).ι ≫ h)
    · intro S hSc U hS
      haveI : IsAffine (U : Y.Opens) := U.2
      obtain ⟨S₂, U₁, hU₁, πU₁, hU₁qc, hU₁qs, hU₁lfp, hU₁pb⟩ :=
        wc_ap_fp_affine_model_over_finset A (U : Y.Opens) ((U : Y.Opens).ι ≫ h)
      obtain ⟨S₁, V₁, hV₁, πV₁, hV₁qc, hV₁qs, hV₁lfp, hV₁pb⟩ := hS
      have hcomp : IsCompact ((S ⊓ (U : Y.Opens) : Y.Opens) : Set Y) :=
        QuasiSeparatedSpace.inter_isCompact _ _ S.isOpen hSc (U : Y.Opens).isOpen U.2.isCompact
      obtain ⟨S', V₀, U₀, W₀, hV, hU, p, q, πV, πU, πW, hp, hq, hW₀, hVqc, hVqs, hVlfp, hUqc,
          hUqs, hUlfp, w, hVpb, hUpb, hWpb, hpW, hqW⟩ :=
        wc_ap_fp_two_chart_compatible_models A Y h S U hcomp S₁ S₂ V₁ U₁ hV₁ hU₁ πV₁ πU₁
          hV₁qc hV₁qs hV₁lfp hU₁qc hU₁qs hU₁lfp hV₁pb hU₁pb
      haveI := hp
      haveI := hq
      obtain ⟨hGqc, hGqs, hGlfp⟩ := wc_ap_pushout_open_immersion_qcqs_lfp _ V₀ U₀ W₀ hV hU p q w
        hW₀ hVqc hVqs hVlfp hUqc hUqs hUlfp
      obtain ⟨π, hπ⟩ := wc_ap_pushout_open_immersion_base_change _ (Spec (.of A))
        (Spec.map (CommRingCat.ofHom (Subring.closure (S' : Set A)).subtype)) Y h S U V₀ U₀ W₀
        hV hU p q w πV πU πW hVpb hUpb hWpb hpW hqW
      exact ⟨S', _, _, π, hGqc, hGqs, hGlfp, hπ⟩
  obtain ⟨S₀, X₀, h₀, π, hqc, hqs, hlfp, hpb⟩ := hP
  refine ⟨S₀, X₀, h₀, hqc, hqs, hlfp, (Scheme.topIso Y).inv ≫ hpb.isoPullback.hom,
    inferInstance, ?_⟩
  rw [Category.assoc, IsPullback.isoPullback_hom_snd, ← Scheme.topIso_hom, Iso.inv_hom_id_assoc]

theorem wc_ap_separated_descends_to_finset : ∀ (A : Type u) [CommRing A] (S₀ : Finset A) (Y₀ : Scheme.{u}) (h₀ : Y₀ ⟶ Spec (.of ↥(Subring.closure (S₀ : Set A)))) [QuasiCompact h₀] [QuasiSeparated h₀] [LocallyOfFinitePresentation h₀], IsSeparated (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype))) → ∃ (S : Finset A) (hS : Subring.closure (S₀ : Set A) ≤ Subring.closure (S : Set A)), IsSeparated (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS)))) :=
by
  intro A _ S₀ Y₀ h₀ _ _ _ hsep
  classical


  have s3 : ∀ (Y₀ X X' : Scheme.{u}) (h₀ : Y₀ ⟶ X) (g : X' ⟶ X), IsPullback (Limits.pullback.map (Limits.pullback.snd h₀ g) (Limits.pullback.snd h₀ g) h₀ h₀ (Limits.pullback.fst h₀ g) (Limits.pullback.fst h₀ g) g (Limits.pullback.condition).symm (Limits.pullback.condition).symm) (Limits.pullback.fst (Limits.pullback.snd h₀ g) (Limits.pullback.snd h₀ g) ≫ Limits.pullback.snd h₀ g) (Limits.pullback.fst h₀ h₀ ≫ h₀) g := by
    intro Y₀ X X' h₀ g
    have hw : Limits.pullback.map (Limits.pullback.snd h₀ g) (Limits.pullback.snd h₀ g) h₀ h₀ (Limits.pullback.fst h₀ g) (Limits.pullback.fst h₀ g) g (Limits.pullback.condition).symm (Limits.pullback.condition).symm ≫ (Limits.pullback.fst h₀ h₀ ≫ h₀) = (Limits.pullback.fst (Limits.pullback.snd h₀ g) (Limits.pullback.snd h₀ g) ≫ Limits.pullback.snd h₀ g) ≫ g := by
      simp only [Limits.pullback.map, Limits.pullback.lift_fst_assoc, Category.assoc]
      rw [Limits.pullback.condition]
    refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ hw) ?_
    refine Limits.PullbackCone.IsLimit.mk hw
      (fun s => (Limits.pullback.lift
        (Limits.pullback.lift (s.fst ≫ Limits.pullback.fst h₀ h₀) s.snd
          (by rw [Category.assoc]; exact s.condition))
        (Limits.pullback.lift (s.fst ≫ Limits.pullback.snd h₀ h₀) s.snd
          (by rw [Category.assoc, ← Limits.pullback.condition]; exact s.condition))
        (by rw [Limits.pullback.lift_snd, Limits.pullback.lift_snd]) :
          s.pt ⟶ Limits.pullback (Limits.pullback.snd h₀ g) (Limits.pullback.snd h₀ g))) ?_ ?_ ?_
    · intro s
      apply Limits.pullback.hom_ext
      · simp only [Limits.pullback.map, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc, Category.assoc]
      · simp only [Limits.pullback.map, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc, Category.assoc, Limits.pullback.lift_fst]
    · intro s
      simp only [Limits.pullback.lift_fst_assoc, Limits.pullback.lift_snd]
    · intro s l hl1 hl2
      have e1 := congrArg (· ≫ Limits.pullback.fst h₀ h₀) hl1
      have e2 := congrArg (· ≫ Limits.pullback.snd h₀ h₀) hl1
      simp only [Limits.pullback.map, Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_snd] at e1 e2
      try simp only [Category.assoc] at hl2
      apply Limits.pullback.hom_ext
      · apply Limits.pullback.hom_ext
        · simp only [Category.assoc, Limits.pullback.lift_fst]
          exact e1
        · simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_snd]
          exact hl2
      · apply Limits.pullback.hom_ext
        · simp only [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_snd]
          exact e2
        · simp only [Category.assoc, Limits.pullback.lift_snd]
          rw [← Limits.pullback.condition]
          exact hl2


  have s4 : ∀ (Y₀ X X' : Scheme.{u}) (h₀ : Y₀ ⟶ X) (g : X' ⟶ X), Set.range (Limits.pullback.diagonal (Limits.pullback.snd h₀ g)) = (Limits.pullback.map (Limits.pullback.snd h₀ g) (Limits.pullback.snd h₀ g) h₀ h₀ (Limits.pullback.fst h₀ g) (Limits.pullback.fst h₀ g) g (Limits.pullback.condition).symm (Limits.pullback.condition).symm) ⁻¹' Set.range (Limits.pullback.diagonal h₀) := by
    intro Y₀ X X' h₀ g
    set m := Limits.pullback.map (Limits.pullback.snd h₀ g) (Limits.pullback.snd h₀ g) h₀ h₀ (Limits.pullback.fst h₀ g) (Limits.pullback.fst h₀ g) g (Limits.pullback.condition).symm (Limits.pullback.condition).symm with hm
    have hw : Limits.pullback.diagonal (Limits.pullback.snd h₀ g) ≫ m = Limits.pullback.fst h₀ g ≫ Limits.pullback.diagonal h₀ := by
      apply Limits.pullback.hom_ext
      · rw [hm, Category.assoc, Limits.pullback.map, Limits.pullback.lift_fst, ← Category.assoc,
          Limits.pullback.diagonal_fst, Category.id_comp, Category.assoc,
          Limits.pullback.diagonal_fst, Category.comp_id]
      · rw [hm, Category.assoc, Limits.pullback.map, Limits.pullback.lift_snd, ← Category.assoc,
          Limits.pullback.diagonal_snd, Category.id_comp, Category.assoc,
          Limits.pullback.diagonal_snd, Category.comp_id]
    have hpb : IsPullback (Limits.pullback.diagonal (Limits.pullback.snd h₀ g)) (Limits.pullback.fst h₀ g) m (Limits.pullback.diagonal h₀) := by
