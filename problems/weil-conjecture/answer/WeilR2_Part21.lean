    have hmono : ∀ e : Fin n →₀ ℕ, (∏ i ∈ e.support, α i ^ e i) ∈ J ^ (Finsupp.degree e) := by
      intro e
      rw [Finsupp.degree_apply, ← Finset.prod_pow_eq_pow_sum]
      exact Ideal.prod_mem_prod (fun i _ => Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self i)) _)
    choose c hc using hres

    have step : ∀ (k : ℕ) (y : S), y ∈ J ^ k → ∃ H : MvPolynomial (Fin n) K,
        H.IsHomogeneous k ∧ y - MvPolynomial.aeval α H ∈ J ^ (k + 1) := by
      intro k y hy
      obtain ⟨p, hp, hpy⟩ := (Ideal.mem_span_pow_iff_exists_isHomogeneous α y).1 hy
      have hdeg : ∀ e ∈ p.support, Finsupp.degree e = k := by
        intro e he
        by_contra h
        exact (MvPolynomial.mem_support_iff.1 he) (hp.coeff_eq_zero h)
      refine ⟨∑ e ∈ p.support, MvPolynomial.monomial e (c (p.coeff e)), ?_, ?_⟩
      · exact MvPolynomial.IsHomogeneous.sum _ _ _
          (fun e he => MvPolynomial.isHomogeneous_monomial _ (hdeg e he))
      · rw [← hpy, MvPolynomial.eval_eq, map_sum, ← Finset.sum_sub_distrib]
        refine Ideal.sum_mem _ (fun e he => ?_)
        rw [MvPolynomial.aeval_monomial, Finsupp.prod, ← sub_mul, pow_succ', ← hdeg e he]
        exact Ideal.mul_mem_mul (hc _) (hmono e)
