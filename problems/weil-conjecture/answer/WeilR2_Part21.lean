          (Limits.pullback.snd pr1.left pr1.left ≫ pr2.left) hl0 w) ∘ₗ π₀.symm.toLinearMap) *
        ρ (β (Limits.pullback.fst pr1.left pr1.left w)) := by
    intro w
    have hTβ : β (Limits.pullback.snd pr1.left pr1.left w) =
        (π₀.toLinearMap ∘ₗ G₀ (Limits.pullback.lift
          (Limits.pullback.fst pr1.left pr1.left ≫ pr2.left)
          (Limits.pullback.snd pr1.left pr1.left ≫ pr2.left) hl0 w) ∘ₗ π₀.symm.toLinearMap) ∘ₗ
          β (Limits.pullback.fst pr1.left pr1.left w) := by
      apply LinearMap.ext
      intro y
      show β (Limits.pullback.snd pr1.left pr1.left w) y =
        π₀ (G₀ (Limits.pullback.lift
          (Limits.pullback.fst pr1.left pr1.left ≫ pr2.left)
          (Limits.pullback.snd pr1.left pr1.left ≫ pr2.left) hl0 w)
          (π₀.symm (β (Limits.pullback.fst pr1.left pr1.left w) y)))
      rw [hβapp, hβapp, hKapp, hKapp, LinearEquiv.symm_apply_apply, hTr]
    rw [hTβ]
    exact hρm _ (hβGL _) _ (hGLG _)
  have hβ₂ : IsLocallyConstant (fun w : ↥(Limits.pullback pr1.left pr1.left) =>
      (ρ (β (Limits.pullback.fst pr1.left pr1.left w)),
        ρ (β (Limits.pullback.snd pr1.left pr1.left w)))) :=
    (hρβ.comp_continuous (Limits.pullback.fst pr1.left pr1.left).continuous).prodMk
      (hρβ.comp_continuous (Limits.pullback.snd pr1.left pr1.left).continuous)
  have hDesc : Limits.pullback.fst pr1.left pr1.left ≫ eZ =
      Limits.pullback.snd pr1.left pr1.left ≫ eZ := by
    refine L_ext _ hβ₂ _ _ ?_
    rintro T a ⟨γ₁, γ₂⟩ ha
    have ha1 : ∀ t, ρ (β ((a ≫ Limits.pullback.fst pr1.left pr1.left) t)) = γ₁ := fun t => by
      rw [Scheme.Hom.comp_apply]; exact congrArg Prod.fst (ha t)
    have ha2 : ∀ t, ρ (β ((a ≫ Limits.pullback.snd pr1.left pr1.left) t)) = γ₂ := fun t => by
      rw [Scheme.Hom.comp_apply]; exact congrArg Prod.snd (ha t)
    have p1 := hP T (a ≫ Limits.pullback.fst pr1.left pr1.left) γ₁ ha1
    have p2 := hP T (a ≫ Limits.pullback.snd pr1.left pr1.left) γ₂ ha2
    have hab : (a ≫ Limits.pullback.fst pr1.left pr1.left ≫ pr2.left) ≫ Ω₀.w'.left =
        (a ≫ Limits.pullback.snd pr1.left pr1.left ≫ pr2.left) ≫ Ω₀.w'.left := by
      have := congrArg (fun k => a ≫ k) hl0
      simp only [Category.assoc] at this ⊢
      exact this
    have hlift' : Limits.pullback.lift (a ≫ Limits.pullback.fst pr1.left pr1.left ≫ pr2.left)
        (a ≫ Limits.pullback.snd pr1.left pr1.left ≫ pr2.left) hab =
        a ≫ Limits.pullback.lift (Limits.pullback.fst pr1.left pr1.left ≫ pr2.left)
          (Limits.pullback.snd pr1.left pr1.left ≫ pr2.left) hl0 := by
      apply Limits.pullback.hom_ext
      · refine (Limits.pullback.lift_fst _ _ _).trans ?_
        rw [Category.assoc, Limits.pullback.lift_fst]
      · refine (Limits.pullback.lift_snd _ _ _).trans ?_
        rw [Category.assoc, Limits.pullback.lift_snd]
    have hm := (hMR T (a ≫ Limits.pullback.fst pr1.left pr1.left ≫ pr2.left)
      (a ≫ Limits.pullback.snd pr1.left pr1.left ≫ pr2.left) hab γ₁⁻¹ γ₂⁻¹).2 (by
        intro t
        rw [hlift', Scheme.Hom.comp_apply]
        have h1 := ha1 t
        have h2 := ha2 t
        rw [Scheme.Hom.comp_apply] at h1 h2
        rw [← h1, ← h2, hTρ, mul_inv_rev])
    calc a ≫ Limits.pullback.fst pr1.left pr1.left ≫ eZ
        = (a ≫ Limits.pullback.fst pr1.left pr1.left) ≫ eZ := (Category.assoc _ _ _).symm
      _ = (a ≫ Limits.pullback.fst pr1.left pr1.left) ≫ pr2.left ≫ s₀ γ₁⁻¹ := p1
      _ = (a ≫ Limits.pullback.fst pr1.left pr1.left ≫ pr2.left) ≫ s₀ γ₁⁻¹ := by
          simp only [Category.assoc]
      _ = (a ≫ Limits.pullback.snd pr1.left pr1.left ≫ pr2.left) ≫ s₀ γ₂⁻¹ := hm
      _ = (a ≫ Limits.pullback.snd pr1.left pr1.left) ≫ pr2.left ≫ s₀ γ₂⁻¹ := by
          simp only [Category.assoc]
      _ = (a ≫ Limits.pullback.snd pr1.left pr1.left) ≫ eZ := p2.symm
      _ = a ≫ Limits.pullback.snd pr1.left pr1.left ≫ eZ := Category.assoc _ _ _

  obtain ⟨e, heZ⟩ := L_desc pr1.left inferInstance inferInstance inferInstance eZ
    (fun T a b hab => by
      calc a ≫ eZ
          = (Limits.pullback.lift a b hab ≫ Limits.pullback.fst pr1.left pr1.left) ≫ eZ := by
            rw [Limits.pullback.lift_fst]
        _ = (Limits.pullback.lift a b hab ≫ Limits.pullback.snd pr1.left pr1.left) ≫ eZ := by
            rw [Category.assoc, Category.assoc, hDesc]
        _ = b ≫ eZ := by rw [Limits.pullback.lift_snd])
  have hEZ : eZ ≫ πE₀ ≫ Ub.ι = pr2.left ≫ Ω₀.w'.left := by
    refine L_ext _ hρβ _ _ (fun T a γ ha => ?_)
    rw [← Category.assoc a eZ, hP T a γ ha]
    simp only [Category.assoc, hSh]
  haveI : Epi pr1.left := Flat.epi_of_flat_of_surjective _
  have he : e ≫ πE₀ ≫ Ub.ι = Ω.w'.left := by
    rw [← cancel_epi pr1.left, ← Category.assoc pr1.left e, heZ, hEZ, hsq]
  refine ⟨e, he, ?_⟩



  intro σ₁ σ₂ g₁ g₂ h1 h2 f1 f2 Zs t hZ heq
  obtain ⟨τ₁, hτ11, hτ12, hEβ1, hG1⟩ := hdeck σ₁ g₁ h1 f1
  obtain ⟨τ₂, hτ21, hτ22, hEβ2, hG2⟩ := hdeck σ₂ g₂ h2 f2
  obtain ⟨P, y', f, y, hPne, hy'p, hy'c⟩ := L_point t pr1.left hsur.surj hZ
  have key : ∀ (τ : Z ⟶ Z) (σ : Ω.W' ⟶ Ω.W'), τ ≫ pr1 = pr1 ≫ σ → τ ≫ pr2 = pr2 →
      y' ≫ τ.left ≫ eZ = f ≫ t ≫ σ.left ≫ e ∧
      y' ≫ τ.left ≫ eZ = y' ≫ pr2.left ≫ s₀ (ρ (β (τ.left y)))⁻¹ := by
    intro τ σ hτ1 hτ2
    have k1 : τ.left ≫ pr1.left = pr1.left ≫ σ.left := congrArg (fun k => k.left) hτ1
    have k2 : τ.left ≫ pr2.left = pr2.left := congrArg (fun k => k.left) hτ2
    constructor
    · rw [← heZ, ← Category.assoc τ.left pr1.left e, k1, Category.assoc pr1.left σ.left e,
        ← Category.assoc y' pr1.left, hy'p, Category.assoc f t]
    · have hp := hP P (y' ≫ τ.left) (ρ (β (τ.left y)))
        (fun s => by rw [Scheme.Hom.comp_apply, hy'c])
      rw [← Category.assoc y' τ.left eZ, hp, Category.assoc y' τ.left,
        ← Category.assoc τ.left pr2.left, k2]
  have e1 := key τ₁ σ₁ hτ11 hτ12
  have e2 := key τ₂ σ₂ hτ21 hτ22
  have hsame : (y' ≫ pr2.left) ≫ s₀ (ρ (β (τ₁.left y)))⁻¹ =
      (y' ≫ pr2.left) ≫ s₀ (ρ (β (τ₂.left y)))⁻¹ := by
    rw [Category.assoc, Category.assoc, ← e1.2, ← e2.2, e1.1, e2.1, heq]
  have hm := (hMR P (y' ≫ pr2.left) (y' ≫ pr2.left) rfl (ρ (β (τ₁.left y)))⁻¹
    (ρ (β (τ₂.left y)))⁻¹).1 hsame
  obtain ⟨s⟩ := hPne
  have hm' := hm s
  rw [hDg P (y' ≫ pr2.left) s] at hm'
  have hid : π₀.toLinearMap ∘ₗ LinearMap.id ∘ₗ π₀.symm.toLinearMap = LinearMap.id :=
    LinearMap.ext fun x => by simp
  rw [hid, hρ1, inv_one, mul_one] at hm'
  have hγ : ρ (β (τ₁.left y)) = ρ (β (τ₂.left y)) := (inv_injective hm').symm
  have r1 : ρ (β y) = ρ (β (τ₁.left y)) * ρ ((K z₀).toLinearMap ∘ₗ g₁ ∘ₗ (K z₀).symm.toLinearMap) := by
    rw [← hρm _ hG1 (β (τ₁.left y)) (hβGL _), hEβ1 y]
  have r2 : ρ (β y) = ρ (β (τ₂.left y)) * ρ ((K z₀).toLinearMap ∘ₗ g₂ ∘ₗ (K z₀).symm.toLinearMap) := by
    rw [← hρm _ hG2 (β (τ₂.left y)) (hβGL _), hEβ2 y]
  apply mul_left_cancel (a := ρ (β (τ₁.left y)))
  rw [← r1, hγ, ← r2]

theorem wc_padic_conj_close (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r q : ℕ)
    (K₀ : (Fin r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin q → ℚ_[ℓ])) (ε : ℝ) (hε : 0 < ε) :
    ∃ k : ℕ, ∀ g₁ g₂ : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]),
      (∀ x : Fin q → ℚ_[ℓ], (∀ i, ‖x i‖ ≤ 1) →
        ∀ i, ‖K₀ (g₁ (K₀.symm x)) i - K₀ (g₂ (K₀.symm x)) i‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ))) →
      ∀ i j : Fin r, ‖g₁ (Pi.single j 1) i - g₂ (Pi.single j 1) i‖ < ε :=
by
  classical
  have hL : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
  have hL0 : (0 : ℝ) < ℓ := by linarith

  have s1 : ∃ C : ℝ, 0 ≤ C ∧ ∀ (u : Fin q → ℚ_[ℓ]) (δ : ℝ), 0 ≤ δ → (∀ t, ‖u t‖ ≤ δ) →
      ∀ i, ‖K₀.symm u i‖ ≤ C * δ := by
    refine ⟨∑ i', ∑ t, ‖K₀.symm (Pi.single t 1) i'‖, by positivity, ?_⟩
    intro u δ hδ hu i
    have hdecomp : u = ∑ t, u t • (Pi.single t (1 : ℚ_[ℓ]) : Fin q → ℚ_[ℓ]) := by
      ext s
      simp [Finset.sum_apply, Pi.single_apply]
    have h1 : K₀.symm u i = ∑ t, u t * K₀.symm (Pi.single t 1) i := by
      conv_lhs => rw [hdecomp]
      simp [map_sum, map_smul, Finset.sum_apply]
    rw [h1]
    calc ‖∑ t, u t * K₀.symm (Pi.single t 1) i‖
        ≤ ∑ t, ‖u t * K₀.symm (Pi.single t 1) i‖ := norm_sum_le _ _
      _ ≤ ∑ t, δ * ‖K₀.symm (Pi.single t 1) i‖ := by
          apply Finset.sum_le_sum
          intro t _
          rw [norm_mul]
          exact mul_le_mul_of_nonneg_right (hu t) (norm_nonneg _)
      _ = δ * ∑ t, ‖K₀.symm (Pi.single t 1) i‖ := by rw [Finset.mul_sum]
      _ ≤ δ * ∑ i', ∑ t, ‖K₀.symm (Pi.single t 1) i'‖ := by
          apply mul_le_mul_of_nonneg_left _ hδ
          exact Finset.single_le_sum (f := fun i' => ∑ t, ‖K₀.symm (Pi.single t 1) i'‖)
            (fun _ _ => by positivity) (Finset.mem_univ i)
      _ = _ := mul_comm _ _
  obtain ⟨C, hC0, hC⟩ := s1

  obtain ⟨N, hN⟩ := pow_unbounded_of_one_lt (∑ j, ∑ t, ‖K₀ (Pi.single j 1) t‖) hL
  have hP : (0 : ℝ) < (ℓ : ℝ) ^ N := pow_pos hL0 N
  have hnormc : ‖(ℓ : ℚ_[ℓ]) ^ N‖ = ((ℓ : ℝ) ^ N)⁻¹ := by
    rw [Padic.norm_p_pow, zpow_neg, zpow_natCast]
  have s2 : ∀ j t, ‖((ℓ : ℚ_[ℓ]) ^ N • K₀ (Pi.single j 1)) t‖ ≤ 1 := by
    intro j t
    rw [Pi.smul_apply, smul_eq_mul, norm_mul, hnormc]
    have hle : ‖K₀ (Pi.single j 1) t‖ ≤ ∑ j, ∑ t, ‖K₀ (Pi.single j 1) t‖ := by
      calc ‖K₀ (Pi.single j 1) t‖ ≤ ∑ t', ‖K₀ (Pi.single j 1) t'‖ :=
            Finset.single_le_sum (f := fun t' => ‖K₀ (Pi.single j 1) t'‖)
              (fun _ _ => norm_nonneg _) (Finset.mem_univ t)
        _ ≤ ∑ j, ∑ t, ‖K₀ (Pi.single j 1) t‖ :=
            Finset.single_le_sum (f := fun j' => ∑ t', ‖K₀ (Pi.single j' 1) t'‖)
              (fun _ _ => by positivity) (Finset.mem_univ j)
    rw [inv_mul_le_iff₀ hP]
    linarith

  obtain ⟨k, hk⟩ := pow_unbounded_of_one_lt ((ℓ : ℝ) ^ N * (C + 1) / ε) hL
  have hK : (0 : ℝ) < (ℓ : ℝ) ^ k := pow_pos hL0 k
  have hk' : (ℓ : ℝ) ^ N * (C + 1) < ε * (ℓ : ℝ) ^ k := by
    rw [div_lt_iff₀ hε] at hk
    linarith
  refine ⟨k, ?_⟩

  intro g₁ g₂ H i j
  have hy : K₀.symm ((ℓ : ℚ_[ℓ]) ^ N • K₀ (Pi.single j 1)) = (ℓ : ℚ_[ℓ]) ^ N • Pi.single j 1 := by
    rw [map_smul, LinearEquiv.symm_apply_apply]
  have hδ : (0 : ℝ) ≤ (ℓ : ℝ) ^ (-(k : ℤ)) := by positivity
  have hut : ∀ t, ‖(K₀ (g₁ (K₀.symm ((ℓ : ℚ_[ℓ]) ^ N • K₀ (Pi.single j 1)))) -
      K₀ (g₂ (K₀.symm ((ℓ : ℚ_[ℓ]) ^ N • K₀ (Pi.single j 1))))) t‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) := by
    intro t
    rw [Pi.sub_apply]
    exact H _ (s2 j) t
  have h2 := hC _ _ hδ hut i
  have hsu : K₀.symm (K₀ (g₁ (K₀.symm ((ℓ : ℚ_[ℓ]) ^ N • K₀ (Pi.single j 1)))) -
      K₀ (g₂ (K₀.symm ((ℓ : ℚ_[ℓ]) ^ N • K₀ (Pi.single j 1))))) i =
      (ℓ : ℚ_[ℓ]) ^ N * (g₁ (Pi.single j 1) i - g₂ (Pi.single j 1) i) := by
    rw [map_sub, LinearEquiv.symm_apply_apply, LinearEquiv.symm_apply_apply, hy, map_smul,
      map_smul, Pi.sub_apply, Pi.smul_apply, Pi.smul_apply, smul_eq_mul, smul_eq_mul, mul_sub]
  rw [hsu, norm_mul, hnormc, zpow_neg, zpow_natCast] at h2
  have ha : 0 ≤ ‖g₁ (Pi.single j 1) i - g₂ (Pi.single j 1) i‖ := norm_nonneg _
  rw [inv_mul_le_iff₀ hP] at h2
  have h3 : ‖g₁ (Pi.single j 1) i - g₂ (Pi.single j 1) i‖ * (ℓ : ℝ) ^ k ≤ (ℓ : ℝ) ^ N * C := by
    have := mul_le_mul_of_nonneg_right h2 hK.le
    calc ‖g₁ (Pi.single j 1) i - g₂ (Pi.single j 1) i‖ * (ℓ : ℝ) ^ k
        ≤ (ℓ : ℝ) ^ N * (C * ((ℓ : ℝ) ^ k)⁻¹) * (ℓ : ℝ) ^ k := this
      _ = (ℓ : ℝ) ^ N * C := by field_simp
  have h4 : ‖g₁ (Pi.single j 1) i - g₂ (Pi.single j 1) i‖ * (ℓ : ℝ) ^ k < ε * (ℓ : ℝ) ^ k := by
    nlinarith
  exact lt_of_mul_lt_mul_right h4 hK.le

theorem wc_noetherian_connectedComponent_isOpen {α : Type*} [TopologicalSpace α]
    [TopologicalSpace.NoetherianSpace α] (x : α) : IsOpen (connectedComponent x) :=
by
  classical
  have hfin : {Z ∈ irreducibleComponents α | Disjoint Z (connectedComponent x)}.Finite :=
    (TopologicalSpace.NoetherianSpace.finite_irreducibleComponents).subset (Set.sep_subset _ _)
  have hcl : IsClosed
      (⋃ Z ∈ {Z ∈ irreducibleComponents α | Disjoint Z (connectedComponent x)}, Z) :=
    hfin.isClosed_biUnion (fun Z hZ => isClosed_of_mem_irreducibleComponents Z hZ.1)
  have heq : (connectedComponent x)ᶜ =
      ⋃ Z ∈ {Z ∈ irreducibleComponents α | Disjoint Z (connectedComponent x)}, Z := by
    ext y
    simp only [Set.mem_compl_iff, Set.mem_iUnion, Set.mem_setOf_eq, exists_prop]
    constructor
    · intro hy
      refine ⟨irreducibleComponent y,
        ⟨irreducibleComponent_mem_irreducibleComponents y, ?_⟩, mem_irreducibleComponent⟩
      have hne : connectedComponent x ≠ connectedComponent y := by
        intro h
        apply hy
        rw [h]
        exact mem_connectedComponent
      exact (connectedComponent_disjoint hne).symm.mono_left
        irreducibleComponent_subset_connectedComponent
    · rintro ⟨Z, ⟨_, hd⟩, hyZ⟩ hyC
      exact Set.disjoint_left.mp hd hyZ hyC
  rw [← isClosed_compl_iff, heq]
  exact hcl

theorem wc_pfam_lfl_finite_monodromy_cover (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP)
    (A : (Fin Ω.r' → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]))
    (hA : ∀ (σ : Ω.W' ⟶ Ω.W') (g : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
        σ ≫ Ω.w' = Ω.w' → wcPfamFrame Ω σ g →
        ∀ x : Fin Ω.r' → ℚ_[ℓ], (∀ i, ‖x i‖ ≤ 1) → ∀ i, ‖A (g (A.symm x)) i‖ ≤ 1)
    (hU : ∀ (Vξ Tξ : (wcProjK F'' M').ProEt) (uξ : Tξ ⟶ Vξ) (cξ : Tξ ⟶ Ω.W'),
      wcPfamXiPt Ω uξ cξ → ∀ g ∈ wcPfamInertFr Ω uξ cξ,
        (g - LinearMap.id) ∘ₗ (g - LinearMap.id) = 0)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ (Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens) (E : Scheme.{u})
      (πE : E ⟶ Ub.toScheme) (e : Ω.W'.left ⟶ E),
      (∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
        y ∈ Ub ↔ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∉ Δ) ∧
      IsFinite πE ∧ Etale πE ∧ ConnectedSpace E ∧ wcPfamEllTame M' Δ ℓ hPP Ub πE ∧
      e ≫ πE ≫ Ub.ι = Ω.w'.left ∧
      ∀ (σ₁ σ₂ : Ω.W' ⟶ Ω.W') (g₁ g₂ : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
        σ₁ ≫ Ω.w' = Ω.w' → σ₂ ≫ Ω.w' = Ω.w' → wcPfamFrame Ω σ₁ g₁ → wcPfamFrame Ω σ₂ g₂ →
        ∀ (Z : Scheme.{u}) (t : Z ⟶ Ω.W'.left), Nonempty Z →
          t ≫ σ₁.left ≫ e = t ≫ σ₂.left ≫ e →
          ∀ i j : Fin Ω.r', ‖g₁ (Pi.single j 1) i - g₂ (Pi.single j 1) i‖ < ε :=
by
  classical
  have hΔ : IsClosed Δ := hH.2.2.2.2.1

  haveI hpr : IsProper (Over.mk (wcProjKStr F'' M')).hom := wc_proj_space_isProper F'' M'
  haveI : IsLocallyNoetherian (Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd _ _)
  haveI : CompactSpace ↥(Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd _ _)
  haveI : AlgebraicGeometry.IsNoetherian (Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    AlgebraicGeometry.IsNoetherian.mk
  haveI hN : TopologicalSpace.NoetherianSpace
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left :=
    (inferInstance : TopologicalSpace.NoetherianSpace ↥(Limits.pullback
      (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
  haveI hLN : IsLocallyNoetherian (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left :=
    (inferInstance : IsLocallyNoetherian (Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
  obtain ⟨Ub, hUb⟩ : ∃ Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens,
      ∀ y, y ∈ Ub ↔ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∉ Δ :=
    ⟨(wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom ⁻¹ᵁ ⟨Δᶜ, hΔ.isOpen_compl⟩,
      fun y => Iff.rfl⟩
  haveI hNU : TopologicalSpace.NoetherianSpace Ub.toScheme :=
    TopologicalSpace.NoetherianSpace.set
      (Ub : Set (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left)
  haveI hcpt : CompactSpace Ub.toScheme := inferInstance
  have hqs : QuasiSeparatedSpace Ub.toScheme := inferInstance

  obtain ⟨Ω₀, hcpt₀, hqc₀⟩ :=
    wc_pfam_cover_exists_qc F' F'' Y n D ℓ hℓ M' Xu h Δ lam p hH hPP (n - 1)
  obtain ⟨q', π₀, hco⟩ := wc_pfam_qc_integral_coords Ω₀ hcpt₀ hqc₀
  obtain ⟨GLs, hGLs⟩ : ∃ GLs : Set ((Fin q' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ])),
      ∀ g, g ∈ GLs ↔ ∃ g' : (Fin q' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ]),
        g' ∘ₗ g = LinearMap.id ∧ g ∘ₗ g' = LinearMap.id ∧
        ∀ y : Fin q' → ℚ_[ℓ], (∀ i, ‖y i‖ ≤ 1) → (∀ i, ‖g y i‖ ≤ 1) ∧ ∀ i, ‖g' y i‖ ≤ 1 :=
    ⟨_, fun g => Iff.rfl⟩
  have hfr : ∀ (σ₀ : Ω₀.W' ⟶ Ω₀.W') (g₀ : (Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ])),
      σ₀ ≫ Ω₀.w' = Ω₀.w' → wcPfamFrame Ω₀ σ₀ g₀ →
      π₀.toLinearMap ∘ₗ g₀ ∘ₗ π₀.symm.toLinearMap ∈ GLs :=
    fun σ₀ g₀ hσ hf => (hGLs _).2 (hco σ₀ g₀ hσ hf)
  have hGLinv : ∀ g ∈ GLs, ∃ g' ∈ GLs, g' ∘ₗ g = LinearMap.id ∧ g ∘ₗ g' = LinearMap.id := by
    intro g hg
    obtain ⟨a, ha1, ha2, ha3⟩ := (hGLs g).1 hg
    exact ⟨a, (hGLs a).2 ⟨g, ha2, ha1, fun y hy => ⟨(ha3 y hy).2, (ha3 y hy).1⟩⟩, ha1, ha2⟩
  have hGLmul : ∀ g ∈ GLs, ∀ g' ∈ GLs, g' ∘ₗ g ∈ GLs := by
    intro g hg g' hg'
    obtain ⟨a, ha1, ha2, ha3⟩ := (hGLs g).1 hg
    obtain ⟨b, hb1, hb2, hb3⟩ := (hGLs g').1 hg'
    refine (hGLs _).2 ⟨a ∘ₗ b, LinearMap.ext fun x => ?_, LinearMap.ext fun x => ?_,
      fun y hy => ⟨fun i => (hb3 (g y) (ha3 y hy).1).1 i, fun i => (ha3 (b y) (hb3 y hy).2).2 i⟩⟩
    · show a (b (g' (g x))) = x
      rw [show b (g' (g x)) = g x from LinearMap.congr_fun hb1 (g x)]
      exact LinearMap.congr_fun ha1 x
    · show g' (g (a (b x))) = x
      rw [show g (a (b x)) = b x from LinearMap.congr_fun ha2 (b x)]
      exact LinearMap.congr_fun hb2 x

  obtain ⟨K₀, hKGL, htrans⟩ := wc_pfam_level_transport Ω Ω₀ hqc₀ Ub hUb q' π₀ GLs hGLs hfr

  obtain ⟨k, hk⟩ := wc_padic_conj_close ℓ Ω.r' q' K₀ ε hε

  obtain ⟨ρ, hρ1, hρm, hρ3, -, hρc⟩ := wc_hmg_lattice_reduction ℓ q' q' k ⊤ LinearMap.id
    (fun y => ⟨y, Submodule.mem_top, rfl⟩) GLs
    (fun g hg x _ => ⟨Submodule.mem_top, fun hx => ((hGLs g).1 hg).choose_spec.2.2 x hx |>.1⟩)
    (fun g hg => by
      obtain ⟨g', hg', h1, -⟩ := hGLinv g hg
      exact ⟨g', hg', fun x _ => LinearMap.congr_fun h1 x⟩)
  have hρ3' : ∀ g ∈ GLs, ρ g = 1 ↔ ∀ x : Fin q' → ℚ_[ℓ], (∀ j, ‖x j‖ ≤ 1) →
      ∀ j, ‖g x j - x j‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) :=
    fun g hg => (hρ3 g hg).trans ⟨fun H x hx => H x Submodule.mem_top hx,
      fun H x _ hx => H x hx⟩

  obtain ⟨E₀, πE₀, s₀, G₀, hfin, het, hSh, hLOC, hGLG, hTb, hMR, hDg, hDk⟩ :=
    wc_pfam_qc_level_cover Ω₀ hqc₀ Ub hUb hcpt hqs k q' π₀ GLs hGLs hfr ρ hρ1 hρm hρc
  haveI := hfin
  haveI := het

  obtain ⟨e, he, hρeq⟩ := htrans _ ρ hρ1 hρm hρc E₀ πE₀ s₀ G₀ hSh hGLG hTb hMR hDg

  haveI : IsLocallyNoetherian E₀ := LocallyOfFiniteType.isLocallyNoetherian πE₀
  haveI : CompactSpace E₀ := QuasiCompact.compactSpace_of_compactSpace πE₀
  haveI : AlgebraicGeometry.IsNoetherian E₀ := AlgebraicGeometry.IsNoetherian.mk
  haveI : TopologicalSpace.NoetherianSpace E₀ := inferInstance
  haveI := Ω.hconn'
  obtain ⟨w₁⟩ := (inferInstance : ConnectedSpace Ω.W'.left).toNonempty
  let O : E₀.Opens := ⟨connectedComponent (e w₁), wc_noetherian_connectedComponent_isOpen (e w₁)⟩
  have hrange : Set.range e ⊆ connectedComponent (e w₁) :=
    (isConnected_range e.continuous).isPreconnected.subset_connectedComponent ⟨w₁, rfl⟩
  have hrange' : Set.range e ⊆ Set.range O.ι := by
    rw [Scheme.Opens.range_ι]; exact hrange
  haveI : IsClosedImmersion O.ι := IsClosedImmersion.of_isPreimmersion O.ι
    (by rw [Scheme.Opens.range_ι]; exact isClosed_connectedComponent)
  have hconnE : ConnectedSpace O.toScheme :=
    isConnected_iff_connectedSpace.mp
      (show _root_.IsConnected (O : Set E₀) from isConnected_connectedComponent)
  let e' : Ω.W'.left ⟶ O.toScheme := IsOpenImmersion.lift O.ι e hrange'
  have he' : e' ≫ O.ι = e := IsOpenImmersion.lift_fac O.ι e hrange'

  have hU₀ := wc_pfam_lfl_inertia_unipotent F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ lam p hH hPP Ω₀
  have htame := wc_pfam_level_cover_tame Ω₀ hU₀ Ub hUb k q' π₀ GLs hGLs hfr _ ρ hρm hρ3'
    E₀ πE₀ s₀ hSh hLOC hDk O
  refine ⟨Ub, O.toScheme, O.ι ≫ πE₀, e', hUb, inferInstance, inferInstance, hconnE, htame,
    ?_, ?_⟩
  · rw [← Category.assoc, ← Category.assoc, he', Category.assoc]
    exact he

  · intro σ₁ σ₂ g₁ g₂ h1 h2 f1 f2 Z t hZ heq
    have heq' : t ≫ σ₁.left ≫ e = t ≫ σ₂.left ≫ e := by
      rw [← he']
      simp only [← Category.assoc] at heq ⊢
      rw [heq]
    have hρ12 := hρeq σ₁ σ₂ g₁ g₂ h1 h2 f1 f2 Z t hZ heq'
    apply hk g₁ g₂
    intro x hx i
    have hG1 := hKGL σ₁ g₁ h1 f1
    have hG2 := hKGL σ₂ g₂ h2 f2
    set G1 := K₀.toLinearMap ∘ₗ g₁ ∘ₗ K₀.symm.toLinearMap with hG1d
    set G2 := K₀.toLinearMap ∘ₗ g₂ ∘ₗ K₀.symm.toLinearMap with hG2d
    obtain ⟨G1', hG1'm, hG1'1, hG1'2⟩ := hGLinv G1 hG1
    have hmem : G2 ∘ₗ G1' ∈ GLs := hGLmul G1' hG1'm G2 hG2
    have hD : ρ (G2 ∘ₗ G1') = 1 := by
      rw [hρm G1' hG1'm G2 hG2, ← hρ12, ← hρm G1' hG1'm G1 hG1, hG1'2, hρ1]
    have hy : ∀ j, ‖G1 x j‖ ≤ 1 := ((hGLs G1).1 hG1).choose_spec.2.2 x hx |>.1
    have e1 : G1' (G1 x) = x := LinearMap.congr_fun hG1'1 x
    have h4 := (hρ3' _ hmem).1 hD (G1 x) hy i
    have h5 : (G2 ∘ₗ G1') (G1 x) = G2 x := by
      rw [LinearMap.comp_apply, e1]
    rw [h5] at h4
    rw [norm_sub_rev]
    exact h4

theorem wc_plt_galois_of_line_connected (F'' : Type u) [Field F''] [Finite F''] (M' : ℕ)
    (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (hlamstr : lam ≫ wcProjKStr F'' M' = (wcP1Over F'').hom)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens)
    (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme) [IsFinite πE] [Etale πE]
    (lb : Limits.pullback (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ⟶
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left)
    (hlb1 : lb ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
      Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ lam)
    (hlb2 : lb ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
      Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
    (hC : _root_.IsPreconnected (Set.univ : Set ↥(Limits.pullback πE (Limits.pullback.snd lb Ub.ι))))
    (T : (wcP1Over F'').left.ProEt) (L : Type u) [Field L] [IsSepClosed L]
    (eL : T.left ≅ Spec (.of L)) (e₁ e₂ : T.left ⟶ E)
    (h12 : e₁ ≫ πE ≫ Ub.ι = e₂ ≫ πE ≫ Ub.ι)
    (hlam : e₁ ≫ πE ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
      T.hom ≫ lam) :
    ∃ τ : T ⟶ T, τ.left ≫ e₁ = e₂ :=
by
  classical

  have key : ∀ (X : Scheme.{u}) [IrreducibleSpace X] (f₁ f₂ : Spec (.of L) ⟶ X),
      WeaklyEtale f₁ → WeaklyEtale f₂ →
      ∃ τ₀ : CommRingCat.of L ⟶ CommRingCat.of L, Spec.map τ₀ ≫ f₁ = f₂ := by
    intro X _ f₁ f₂ hW₁ hW₂

    have hgen : ∀ f : Spec (.of L) ⟶ X, WeaklyEtale f →
        f (IsLocalRing.closedPoint (CommRingCat.of L)) = genericPoint X := by
      intro f hf
      have hsp : genericPoint X ⤳ f (IsLocalRing.closedPoint (CommRingCat.of L)) :=
        (genericPoint_spec X).specializes (Set.mem_univ _)
      obtain ⟨a, -, ha⟩ := Flat.generalizingMap f hsp
      have ha' : a = IsLocalRing.closedPoint (CommRingCat.of L) := Subsingleton.elim _ _
      rw [← ha']
      exact ha
    have hx : f₁ (IsLocalRing.closedPoint (CommRingCat.of L)) =
        f₂ (IsLocalRing.closedPoint (CommRingCat.of L)) :=
      (hgen f₁ hW₁).trans (hgen f₂ hW₂).symm

    have hfac1 := Scheme.Spec_stalkClosedPointTo_fromSpecStalk f₁
    have hWφ : WeaklyEtale (Spec.map (Scheme.stalkClosedPointTo f₁)) := by
      have h := hW₁
      rw [← hfac1] at h
      exact @WeaklyEtale.of_comp _ _ _ _ _ h (wc_fromSpecStalk_weaklyEtale _ _)
    letI algO : Algebra (X.presheaf.stalk (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) L :=
      (Scheme.stalkClosedPointTo f₁).hom.toAlgebra
    have hWa : Algebra.WeaklyEtale
        (X.presheaf.stalk (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) L :=
      wc_lpkt_specMap_weaklyEtale_ring _ _ (Scheme.stalkClosedPointTo f₁).hom hWφ
    haveI : Module.Flat (X.presheaf.stalk (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) L :=
      hWa.flat
    haveI : IsLocalHom (algebraMap
        (X.presheaf.stalk (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) L) :=
      (inferInstance : IsLocalHom (Scheme.stalkClosedPointTo f₁).hom)
    haveI : Module.FaithfullyFlat
        (X.presheaf.stalk (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) L :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hinj : Function.Injective (algebraMap
        (X.presheaf.stalk (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) L) :=
      @FaithfulSMul.algebraMap_injective _ _ _ _ _ Module.FaithfullyFlat.faithfulSMul
    have hmax : IsLocalRing.maximalIdeal
        (X.presheaf.stalk (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) = ⊥ := by
      rw [eq_bot_iff]
      intro m hm
      rw [Ideal.mem_bot]
      by_contra hne
      have h1 : algebraMap (X.presheaf.stalk (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) L m
          ≠ 0 := fun h => hne (hinj (h.trans (map_zero _).symm))
      exact (IsLocalRing.notMem_maximalIdeal.mpr (isUnit_of_map_unit (algebraMap
        (X.presheaf.stalk (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) L) m
          (isUnit_iff_ne_zero.mpr h1))) hm
    have hres_inj : Function.Injective
        (ConcreteCategory.hom (X.residue (f₁ (IsLocalRing.closedPoint (CommRingCat.of L))))) := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      have h3 : a ∈ IsLocalRing.maximalIdeal
          (X.presheaf.stalk (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) :=
        (IsLocalRing.residue_eq_zero_iff a).mp ha
      rw [hmax] at h3
      exact (Ideal.mem_bot).mp h3
    haveI : IsIso (X.residue (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr ⟨hres_inj, Scheme.residue_surjective X _⟩
    have hWσ : WeaklyEtale (Spec.map (Scheme.descResidueField (Scheme.stalkClosedPointTo f₁))) := by
      have e : Spec.map (Scheme.stalkClosedPointTo f₁) =
          Spec.map (Scheme.descResidueField (Scheme.stalkClosedPointTo f₁)) ≫
            Spec.map (X.residue (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) := by
        rw [← Spec.map_comp, Scheme.residue_descResidueField]
      have h := hWφ
      rw [e] at h
      exact @WeaklyEtale.of_comp _ _ _ _ _ h inferInstance
    letI algK : Algebra (X.residueField (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) L :=
      (Scheme.descResidueField (Scheme.stalkClosedPointTo f₁)).hom.toAlgebra
    have hWa' : Algebra.WeaklyEtale
        (X.residueField (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) L :=
      wc_lpkt_specMap_weaklyEtale_ring _ _ _ hWσ
    have halg : Algebra.IsAlgebraic
        (X.residueField (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) L := by
      constructor
      intro b
      obtain ⟨p, hp0, hpe⟩ := wc_weaklyEtale_point_algebraic _ L L hWa' (RingHom.id L) b
      refine ⟨p, fun h => hp0 (by rw [h, Polynomial.map_zero]), ?_⟩
      rw [RingHom.id_comp, RingHom.id_apply] at hpe
      rw [Polynomial.aeval_def]
      exact hpe
    haveI hsep : Algebra.IsSeparable
        (X.residueField (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) L :=
      wc_mnt_weaklyEtale_field_isSeparable _ _ hWa' halg

    let σ₂' : X.residueField (f₁ (IsLocalRing.closedPoint (CommRingCat.of L))) ⟶ CommRingCat.of L :=
      (Scheme.residueFieldCongr hx).hom ≫ Scheme.descResidueField (Scheme.stalkClosedPointTo f₂)
    have gen : ∀ (K M : Type u) [Field K] [Field M] [IsSepClosed M] (s : K →+* L) (t : K →+* M),
        @Algebra.IsSeparable K L _ _ s.toAlgebra → ∃ θ : L →+* M, θ.comp s = t := by
      intro K M _ _ _ s t hs
      letI := s.toAlgebra
      letI := t.toAlgebra
      exact ⟨(IsSepClosed.lift : L →ₐ[K] M).toRingHom,
        RingHom.ext fun a => AlgHom.commutes (IsSepClosed.lift : L →ₐ[K] M) a⟩
    obtain ⟨θ, hθ⟩ := gen _ L (Scheme.descResidueField (Scheme.stalkClosedPointTo f₁)).hom
      σ₂'.hom hsep
    refine ⟨CommRingCat.ofHom θ, ?_⟩
    have hτσ : Scheme.descResidueField (Scheme.stalkClosedPointTo f₁) ≫
        CommRingCat.ofHom θ = σ₂' := by
      apply CommRingCat.hom_ext
      exact hθ
    have hf₁fac : Spec.map (Scheme.descResidueField (Scheme.stalkClosedPointTo f₁)) ≫
        X.fromSpecResidueField (f₁ (IsLocalRing.closedPoint (CommRingCat.of L))) = f₁ :=
      (Scheme.descResidueField_fromSpecResidueField X _).trans hfac1
    have hf₂fac : Spec.map (Scheme.descResidueField (Scheme.stalkClosedPointTo f₂)) ≫
        X.fromSpecResidueField (f₂ (IsLocalRing.closedPoint (CommRingCat.of L))) = f₂ :=
      (Scheme.descResidueField_fromSpecResidueField X _).trans
        (Scheme.Spec_stalkClosedPointTo_fromSpecStalk f₂)
    calc Spec.map (CommRingCat.ofHom θ) ≫ f₁
        = Spec.map (CommRingCat.ofHom θ) ≫
            (Spec.map (Scheme.descResidueField (Scheme.stalkClosedPointTo f₁)) ≫
              X.fromSpecResidueField (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) := by
          rw [hf₁fac]
      _ = Spec.map (Scheme.descResidueField (Scheme.stalkClosedPointTo f₁) ≫
            CommRingCat.ofHom θ) ≫
            X.fromSpecResidueField (f₁ (IsLocalRing.closedPoint (CommRingCat.of L))) := by
          rw [Spec.map_comp, Category.assoc]
      _ = Spec.map σ₂' ≫
            X.fromSpecResidueField (f₁ (IsLocalRing.closedPoint (CommRingCat.of L))) := by
          rw [hτσ]
      _ = Spec.map (Scheme.descResidueField (Scheme.stalkClosedPointTo f₂)) ≫
            (Spec.map (Scheme.residueFieldCongr hx).hom ≫
              X.fromSpecResidueField (f₁ (IsLocalRing.closedPoint (CommRingCat.of L)))) := by
          rw [Spec.map_comp, Category.assoc]
      _ = Spec.map (Scheme.descResidueField (Scheme.stalkClosedPointTo f₂)) ≫
            X.fromSpecResidueField (f₂ (IsLocalRing.closedPoint (CommRingCat.of L))) := by
          rw [Scheme.residueFieldCongr_fromSpecResidueField hx]
      _ = f₂ := hf₂fac

  have hp1 : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  haveI hsm1 : Smooth (wcP1Over F'').hom :=
    @SmoothOfRelativeDimension.smooth 1 _ _ (wcP1Over F'').hom (wc_proj_space_smooth F'' 1)

  have hcond : T.hom ≫ (wcP1Over F'').hom =
      ((e₁ ≫ πE ≫ Ub.ι) ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) := by
    have e1 : T.hom ≫ (wcP1Over F'').hom = (T.hom ≫ lam) ≫ wcProjKStr F'' M' := by
      rw [Category.assoc, hlamstr]
    rw [e1, ← hlam]
    have hc : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom ≫ wcProjKStr F'' M' =
        Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) :=
      Limits.pullback.condition
    simp only [Category.assoc]
    exact congrArg (fun k => e₁ ≫ πE ≫ Ub.ι ≫ k) hc
  obtain ⟨y, hy1, hy2⟩ : ∃ y : T.left ⟶ Limits.pullback (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))),
      y ≫ Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) = T.hom ∧
      y ≫ Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        (e₁ ≫ πE ≫ Ub.ι) ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) :=
    ⟨Limits.pullback.lift _ _ hcond, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hyl : y ≫ lb = e₁ ≫ πE ≫ Ub.ι := by
    have k1 : (y ≫ lb) ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
        (e₁ ≫ πE ≫ Ub.ι) ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom := by
      rw [Category.assoc, hlb1, ← Category.assoc, hy1, ← hlam]
      simp only [Category.assoc]
    have k2 : (y ≫ lb) ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        (e₁ ≫ πE ≫ Ub.ι) ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) := by
      exact (Category.assoc _ _ _).trans ((congrArg (fun k => y ≫ k) hlb2).trans hy2)
    exact Limits.pullback.hom_ext (f := (Over.mk (wcProjKStr F'' M')).hom)
      (g := Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) k1 k2
  have h2 : e₂ ≫ πE = e₁ ≫ πE := by
    rw [← cancel_mono Ub.ι]
    simp only [Category.assoc]
    exact h12.symm
  obtain ⟨d, hd1, hd2⟩ : ∃ d : T.left ⟶ Limits.pullback lb Ub.ι,
      d ≫ Limits.pullback.fst lb Ub.ι = y ∧ d ≫ Limits.pullback.snd lb Ub.ι = e₁ ≫ πE :=
    ⟨Limits.pullback.lift y (e₁ ≫ πE) (by rw [hyl, Category.assoc]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨c₁, hc11, hc12⟩ : ∃ c : T.left ⟶ Limits.pullback πE (Limits.pullback.snd lb Ub.ι),
      c ≫ Limits.pullback.fst πE (Limits.pullback.snd lb Ub.ι) = e₁ ∧
      c ≫ Limits.pullback.snd πE (Limits.pullback.snd lb Ub.ι) = d :=
    ⟨Limits.pullback.lift e₁ d hd2.symm, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨c₂, hc21, hc22⟩ : ∃ c : T.left ⟶ Limits.pullback πE (Limits.pullback.snd lb Ub.ι),
      c ≫ Limits.pullback.fst πE (Limits.pullback.snd lb Ub.ι) = e₂ ∧
      c ≫ Limits.pullback.snd πE (Limits.pullback.snd lb Ub.ι) = d :=
    ⟨Limits.pullback.lift e₂ d (h2.trans hd2.symm), Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩

  have hcg : ∀ c : T.left ⟶ Limits.pullback πE (Limits.pullback.snd lb Ub.ι),
      c ≫ Limits.pullback.snd πE (Limits.pullback.snd lb Ub.ι) = d →
      c ≫ (Limits.pullback.snd πE (Limits.pullback.snd lb Ub.ι) ≫ Limits.pullback.fst lb Ub.ι ≫
        Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) = T.hom := by
    intro c hc
    rw [← Category.assoc, hc, ← Category.assoc, hd1, hy1]
  haveI := hp1
  have hWc : ∀ c : T.left ⟶ Limits.pullback πE (Limits.pullback.snd lb Ub.ι),
      c ≫ Limits.pullback.snd πE (Limits.pullback.snd lb Ub.ι) = d → WeaklyEtale (eL.inv ≫ c) := by
    intro c hc
    have h : WeaklyEtale (c ≫ (Limits.pullback.snd πE (Limits.pullback.snd lb Ub.ι) ≫
        Limits.pullback.fst lb Ub.ι ≫ Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) := by
      rw [hcg c hc]
      exact MorphismProperty.Comma.prop T
    haveI : WeaklyEtale c := @WeaklyEtale.of_comp _ _ _ _ _ h inferInstance
    infer_instance

  haveI : Nonempty ↥(Limits.pullback πE (Limits.pullback.snd lb Ub.ι)) :=
    ⟨c₁ (eL.inv (IsLocalRing.closedPoint (CommRingCat.of L)))⟩
  haveI : ConnectedSpace ↥(Limits.pullback πE (Limits.pullback.snd lb Ub.ι)) :=
    connectedSpace_iff_univ.mpr ⟨Set.univ_nonempty, hC⟩
  haveI : IrreducibleSpace ↥(Limits.pullback πE (Limits.pullback.snd lb Ub.ι)) :=
    wc_smooth_algclosed_connected_irreducible (AlgebraicClosure F'') _
      (Limits.pullback.snd πE (Limits.pullback.snd lb Ub.ι) ≫ Limits.pullback.fst lb Ub.ι ≫
        Limits.pullback.snd (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
  obtain ⟨τ₀, hτ₀⟩ := key _ (eL.inv ≫ c₁) (eL.inv ≫ c₂) (hWc c₁ hc12) (hWc c₂ hc22)

  have hτc : (eL.hom ≫ Spec.map τ₀ ≫ eL.inv) ≫ c₁ = c₂ := by
    simp only [Category.assoc]
    rw [hτ₀, Iso.hom_inv_id_assoc]
  have w : (eL.hom ≫ Spec.map τ₀ ≫ eL.inv) ≫ T.hom = T.hom := by
    calc (eL.hom ≫ Spec.map τ₀ ≫ eL.inv) ≫ T.hom
        = (eL.hom ≫ Spec.map τ₀ ≫ eL.inv) ≫ (c₁ ≫ (Limits.pullback.snd πE
            (Limits.pullback.snd lb Ub.ι) ≫ Limits.pullback.fst lb Ub.ι ≫
              Limits.pullback.fst (wcP1Over F'').hom
                (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :=
          congrArg _ (hcg c₁ hc12).symm
      _ = ((eL.hom ≫ Spec.map τ₀ ≫ eL.inv) ≫ c₁) ≫ (Limits.pullback.snd πE
            (Limits.pullback.snd lb Ub.ι) ≫ Limits.pullback.fst lb Ub.ι ≫
              Limits.pullback.fst (wcP1Over F'').hom
                (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
          (Category.assoc _ _ _).symm
      _ = c₂ ≫ (Limits.pullback.snd πE
            (Limits.pullback.snd lb Ub.ι) ≫ Limits.pullback.fst lb Ub.ι ≫
              Limits.pullback.fst (wcP1Over F'').hom
                (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := by
          rw [hτc]
      _ = T.hom := hcg c₂ hc22
  refine ⟨MorphismProperty.Over.homMk (eL.hom ≫ Spec.map τ₀ ≫ eL.inv) w trivial, ?_⟩
  show (eL.hom ≫ Spec.map τ₀ ≫ eL.inv) ≫ e₁ = e₂
  calc (eL.hom ≫ Spec.map τ₀ ≫ eL.inv) ≫ e₁
      = (eL.hom ≫ Spec.map τ₀ ≫ eL.inv) ≫
          (c₁ ≫ Limits.pullback.fst πE (Limits.pullback.snd lb Ub.ι)) := by rw [hc11]
    _ = ((eL.hom ≫ Spec.map τ₀ ≫ eL.inv) ≫ c₁) ≫
          Limits.pullback.fst πE (Limits.pullback.snd lb Ub.ι) := (Category.assoc _ _ _).symm
    _ = c₂ ≫ Limits.pullback.fst πE (Limits.pullback.snd lb Ub.ι) := by rw [hτc]
    _ = e₂ := hc21

theorem wcpa_dj_mm_section_point_unique : ∀ (X P V C : Scheme.{u}) (f : X ⟶ P) (b : V ⟶ P)
    (ψ : C ⟶ X) (g : C ⟶ V) (σ : P ⟶ X) (τ : V ⟶ C), IsPullback ψ g f b → σ ≫ f = 𝟙 P →
    τ ≫ g = 𝟙 V → τ ≫ ψ = b ≫ σ → ∀ c : C, ψ c = σ (b (g c)) ↔ c = τ (g c) :=
by
  intro X P V C f b ψ g σ τ H1 H2 H3 H4 c
  have hcomp : ∀ x : V, ψ (τ x) = σ (b x) := by
    intro x
    rw [← Scheme.Hom.comp_apply, H4, Scheme.Hom.comp_apply]
  have hgτ : ∀ x : V, g (τ x) = x := by
    intro x
    rw [← Scheme.Hom.comp_apply, H3]
    rfl
  constructor
  · intro h
    have hout : IsPullback (τ ≫ g) b b (σ ≫ f) := by
      rw [H3, H2]
      exact IsPullback.id_horiz b
    have hsq : IsPullback τ b ψ σ := IsPullback.of_right hout H4 H1.flip
    obtain ⟨p, hp, _⟩ := Scheme.exists_preimage_of_isPullback hsq c (b (g c)) h
    have hg : g c = p := by rw [← hp, hgτ]
    rw [hg, hp]
  · intro h
    calc ψ c = ψ (τ (g c)) := congrArg ψ h
      _ = σ (b (g c)) := hcomp (g c)

theorem wcpa_dj_mn_generization : ∀ (X : Scheme.{u}) (x : X) (q : PrimeSpectrum (X.presheaf.stalk x)), ∃ hsp : X.fromSpecStalk x q ⤳ x, ∀ a : X.presheaf.stalk x, (X.presheaf.stalkSpecializes hsp).hom a ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (X.fromSpecStalk x q)) ↔ a ∈ q.asIdeal :=
by
  intro X x q
  have hsp : X.fromSpecStalk x q ⤳ x := by
    first
    | exact (Scheme.range_fromSpecStalk (X := X) (x := x)).subset ⟨q, rfl⟩
    | (have h : X.fromSpecStalk x q ∈ Set.range (X.fromSpecStalk x) := ⟨q, rfl⟩
       rwa [Scheme.range_fromSpecStalk] at h)
    | (have h1 : q ⤳ IsLocalRing.closedPoint (X.presheaf.stalk x) :=
         (PrimeSpectrum.le_iff_specializes _ _).mp (IsLocalRing.le_maximalIdeal q.isPrime.ne_top)
       have h2 := h1.map (X.fromSpecStalk x).continuous
       rwa [Scheme.fromSpecStalk_closedPoint] at h2)
  refine ⟨hsp, fun a => ?_⟩
  have key : (Spec.map (X.presheaf.stalkSpecializes hsp))
      (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q))) = q := by
    apply (X.fromSpecStalk x).isEmbedding.injective
    first
    | (rw [← Scheme.Hom.comp_apply, Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
        Scheme.fromSpecStalk_closedPoint])
    | (show (Spec.map (X.presheaf.stalkSpecializes hsp) ≫ X.fromSpecStalk x)
          (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q))) = _
       rw [Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.fromSpecStalk_closedPoint])
    | (have e := congrArg (fun k : Spec (X.presheaf.stalk (X.fromSpecStalk x q)) ⟶ X =>
          k (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q))))
          (Scheme.SpecMap_stalkSpecializes_fromSpecStalk hsp)
       simp only [Scheme.Hom.comp_apply] at e
       rw [e, Scheme.fromSpecStalk_closedPoint])
  have h2 : a ∈ q.asIdeal ↔ a ∈ ((Spec.map (X.presheaf.stalkSpecializes hsp))
      (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk x q)))).asIdeal := by
    rw [key]
  rw [h2]
  first
  | exact Iff.rfl
  | (rw [Spec.map_base_apply]; exact Iff.rfl)
  | (rw [Scheme.Spec_map_base]; exact Iff.rfl)
  | simp [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, IsLocalRing.closedPoint]

theorem wc_plt_ub_local_regular_data (F' F'' : Type u) [Field F'] [Field F'']
    [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens)
    (hUb : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      y ∈ Ub ↔ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∉ Δ)
    (lb : Limits.pullback (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ⟶
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left)
    (hlb1 : lb ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
      Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ lam)
    (hlb2 : lb ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
      Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
    (s : ↥(Limits.pullback (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hs : lb s ∉ Ub) :
    ∃ (W : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens) (hxW : lb s ∈ W)
      (f : Γ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left, W)),
      IsAffineOpen W ∧
      ((W : Set (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left) ∩ Ub =
        (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.basicOpen f) ∧
      IsRegularLocalRing
        ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.stalk (lb s)) ∧
      IsDomain ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.stalk (lb s)) ∧
      IsIntegrallyClosed
        ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.stalk (lb s)) ∧
      IsAlgClosed (IsLocalRing.ResidueField
        ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.stalk (lb s))) ∧
      IsUnit ((ℓ : ℕ) :
        (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.stalk (lb s)) ∧
      ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.germ W (lb s) hxW).hom f ∈
        IsLocalRing.maximalIdeal
          ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.stalk (lb s)) ∧
      ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.germ W (lb s) hxW).hom f ∉
        IsLocalRing.maximalIdeal
          ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.stalk (lb s)) ^ 2 ∧
      (∃ _ : IsDomain ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.stalk (lb s) ⧸
          RingHom.ker (lb.stalkMap s).hom),
        IsDiscreteValuationRing
          ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.stalk (lb s) ⧸
            RingHom.ker (lb.stalkMap s).hom)) ∧
      Irreducible (Ideal.Quotient.mk (RingHom.ker (lb.stalkMap s).hom)
        (((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.germ W (lb s) hxW).hom f)) ∧
      ∃ Q : PrimeSpectrum
          ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.stalk (lb s)),
        Q.asIdeal = Ideal.span {((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.germ
          W (lb s) hxW).hom f} ∧
        ∀ z : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
          (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom z ∈ Δ →
          z ∈ closure {(wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.fromSpecStalk (lb s) Q} :=
by
  classical
  obtain ⟨-, -, -, -, hΔc, hirr, -, hlamCI, hlamstr, -, -, hiff, hloc⟩ := id hH
  have hmem : ∀ {S : Type u} [CommRing S] [IsLocalRing S] (x : S),
      x ∈ IsLocalRing.maximalIdeal S ↔ ¬ IsUnit x :=
    fun x => (IsLocalRing.mem_maximalIdeal x).trans mem_nonunits_iff

  have T_sec_point : ∀ (K L : Type u) [Field K] [Field L] (τ : K →+* L) (Z : Scheme.{u})
      (qZ : Z ⟶ Spec (.of K)) (σ : Spec (.of K) ⟶ Z), σ ≫ qZ = 𝟙 _ →
      ∀ y : ↥(Limits.pullback qZ (Spec.map (CommRingCat.ofHom τ))),
      Limits.pullback.fst qZ (Spec.map (CommRingCat.ofHom τ)) y ∈ Set.range σ →
      ∃ σL : Spec (.of L) ⟶ Limits.pullback qZ (Spec.map (CommRingCat.ofHom τ)),
        σL ≫ Limits.pullback.snd qZ (Spec.map (CommRingCat.ofHom τ)) = 𝟙 _ ∧
        σL (IsLocalRing.closedPoint L) = y := by
    intro K L _ _ τ Z qZ σ hσ y hy
    have h : (Spec.map (CommRingCat.ofHom τ) ≫ σ) ≫ qZ =
        𝟙 _ ≫ Spec.map (CommRingCat.ofHom τ) := by
      rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]
    refine ⟨Limits.pullback.lift _ _ h, Limits.pullback.lift_snd _ _ _, ?_⟩
    obtain ⟨w, hw⟩ := hy
    have key := (wcpa_dj_mm_section_point_unique Z (Spec (.of K)) (Spec (.of L)) _ qZ
      (Spec.map (CommRingCat.ofHom τ)) (Limits.pullback.fst _ _) (Limits.pullback.snd _ _) σ
      (Limits.pullback.lift _ _ h) (IsPullback.of_hasPullback _ _) hσ
      (Limits.pullback.lift_snd _ _ _) (Limits.pullback.lift_fst _ _ _) y).mp (by
        rw [← hw]; congr 1; exact Subsingleton.elim _ _)
    rw [key]; congr 1; exact Subsingleton.elim _ _

  have T_stalk_pkg : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Z : Scheme.{u})
      (sZ : Z ⟶ Spec (.of K)) (d : ℕ) [SmoothOfRelativeDimension d sZ] (σ : Spec (.of K) ⟶ Z),
      σ ≫ sZ = 𝟙 _ → ∀ z : Z, σ (IsLocalRing.closedPoint K) = z →
      IsRegularLocalRing (Z.presheaf.stalk z) ∧ ringKrullDim (Z.presheaf.stalk z) = d ∧
      IsDomain (Z.presheaf.stalk z) ∧ IsIntegrallyClosed (Z.presheaf.stalk z) ∧
      IsAlgClosed (IsLocalRing.ResidueField (Z.presheaf.stalk z)) ∧
      ∀ ℓ : ℕ, ((ℓ : ℕ) : K) ≠ 0 → IsUnit ((ℓ : ℕ) : Z.presheaf.stalk z) := by
    intro K _ _ Z sZ d _ σ hσ z hz
    obtain ⟨h1, h2⟩ := wc_tla_smooth_rational_stalk_regular K Z sZ d σ hσ z hz
    haveI : Smooth sZ := SmoothOfRelativeDimension.smooth d sZ
    obtain ⟨h3, h4⟩ := wc_fntame_smooth_stalk_normal K Z sZ z
    have hcl : IsClosed ({z} : Set Z) := by
      haveI := isClosedImmersion_of_comp_eq_id sZ σ hσ
      have := σ.isClosedEmbedding.isClosed_range
      convert this using 1
      ext w
      constructor
      · rintro rfl; exact ⟨_, hz⟩
      · rintro ⟨v, rfl⟩
        rw [← hz]
        exact congrArg _ (Subsingleton.elim _ _)
    refine ⟨h1, h2, h3, h4, wc_lfi_closed_point_residue_algClosed K Z sZ z hcl, ?_⟩
    intro ℓ hℓ
    have e : ((ℓ : ℕ) : Z.presheaf.stalk z) =
        ((Scheme.ΓSpecIso (.of K)).inv ≫ sZ.appTop ≫ Z.presheaf.Γgerm z).hom (ℓ : K) :=
      (map_natCast _ _).symm
    rw [e]
    exact (isUnit_iff_ne_zero.mpr hℓ).map _

  have T_local_eq : ∀ (X Y : Scheme.{u}) (q : X ⟶ Y) (Δ : Set Y) (Ub : X.Opens),
      (∀ z : X, z ∈ Ub ↔ q z ∉ Δ) → ∀ (U : Y.Opens) (φ₀ : Γ(Y, U)),
      (∀ (y : Y) (hy : y ∈ U), y ∈ Δ ↔
        (Y.presheaf.germ U y hy).hom φ₀ ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) →
      ∀ (x₀ : X) (hx₀ : q x₀ ∈ U), ∃ (W : X.Opens) (hxW : x₀ ∈ W) (f : Γ(X, W)),
        IsAffineOpen W ∧ (W : Set X) ∩ Ub = X.basicOpen f ∧
        (X.presheaf.germ W x₀ hxW).hom f =
          (q.stalkMap x₀).hom ((Y.presheaf.germ U (q x₀) hx₀).hom φ₀) := by
    intro X Y q Δ Ub hUb U φ₀ hΔ x₀ hx₀
    obtain ⟨W, hW, hxW, hWle⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens X)) (show x₀ ∈ q ⁻¹ᵁ U from hx₀)
    have hgerm : ∀ z (hz : z ∈ W), (X.presheaf.germ W z hz).hom
        (X.presheaf.map (homOfLE hWle).op (q.app U φ₀)) =
        (q.stalkMap z).hom ((Y.presheaf.germ U (q z) (show q z ∈ U from hWle hz)).hom φ₀) := by
      intro z hz
      rw [TopCat.Presheaf.germ_res_apply]
      exact (Scheme.Hom.germ_stalkMap_apply q U z _ φ₀).symm
    refine ⟨W, hxW, X.presheaf.map (homOfLE hWle).op (q.app U φ₀), hW, ?_, hgerm x₀ hxW⟩
    ext z
    simp only [Set.mem_inter_iff, SetLike.mem_coe]
    constructor
    · rintro ⟨hzW, hzU⟩
      rw [Scheme.mem_basicOpen X _ z hzW, hgerm z hzW]
      apply IsUnit.map
      have h1 := (hUb z).mp hzU
      rw [hΔ _ (hWle hzW), hmem] at h1
      exact not_not.mp h1
    · intro hz
      have hzW : z ∈ W := X.basicOpen_le _ hz
      refine ⟨hzW, ?_⟩
      rw [Scheme.mem_basicOpen X _ z hzW, hgerm z hzW, isUnit_map_iff] at hz
      rw [hUb, hΔ _ (hWle hzW), hmem]
      exact fun h => h hz

  have T_line_max : ∀ (L1 P L1b Pb : Scheme.{u}) (lam : L1 ⟶ P) (q : Pb ⟶ P)
      (fst₁ : L1b ⟶ L1) (lb : L1b ⟶ Pb), lb ≫ q = fst₁ ≫ lam →
      ∀ (U : P.Opens) (φ₀ : Γ(P, U)) (s : L1b) (t : L1)
      (ht : fst₁ s = t) (hU : lam t ∈ U) (hU' : q (lb s) ∈ U),
      IsLocalRing.maximalIdeal (L1.presheaf.stalk t) =
        Ideal.span {(lam.stalkMap t).hom ((P.presheaf.germ U (lam t) hU).hom φ₀)} →
      Ideal.map (fst₁.stalkMap s).hom (IsLocalRing.maximalIdeal (L1.presheaf.stalk (fst₁ s))) =
        IsLocalRing.maximalIdeal (L1b.presheaf.stalk s) →
      IsLocalRing.maximalIdeal (L1b.presheaf.stalk s) = Ideal.span {(lb.stalkMap s).hom
        ((q.stalkMap (lb s)).hom ((P.presheaf.germ U (q (lb s)) hU').hom φ₀))} := by
    intro L1 P L1b Pb lam q fst₁ lb hc U φ₀ s t ht hU hU' hline hfib
    subst ht
    have aux : ∀ (a b : L1b ⟶ P), a = b → ∀ (ha : a s ∈ U) (hb : b s ∈ U),
        (a.stalkMap s).hom ((P.presheaf.germ U (a s) ha).hom φ₀) =
        (b.stalkMap s).hom ((P.presheaf.germ U (b s) hb).hom φ₀) := by
      intro a b h; subst h; intros; rfl
    have e1 : (lb.stalkMap s).hom ((q.stalkMap (lb s)).hom
        ((P.presheaf.germ U (q (lb s)) hU').hom φ₀)) =
        ((lb ≫ q).stalkMap s).hom ((P.presheaf.germ U ((lb ≫ q) s) hU').hom φ₀) := by
      rw [Scheme.Hom.stalkMap_comp]; rfl
    have e2 : (fst₁.stalkMap s).hom ((lam.stalkMap (fst₁ s)).hom
        ((P.presheaf.germ U (lam (fst₁ s)) hU).hom φ₀)) =
        ((fst₁ ≫ lam).stalkMap s).hom ((P.presheaf.germ U ((fst₁ ≫ lam) s) hU).hom φ₀) := by
      rw [Scheme.Hom.stalkMap_comp]; rfl
    rw [e1, aux _ _ hc hU' hU, ← e2, ← hfib, hline, Ideal.map_span, Set.image_singleton]

  have T_line_alg : ∀ (R O : Type u) [CommRing R] [IsLocalRing R] [CommRing O]
      [IsRegularLocalRing O] [IsDomain O] (g : R →+* O) [IsLocalHom g],
      Function.Surjective g → ringKrullDim O = 1 →
      ∀ φ : R, IsLocalRing.maximalIdeal O = Ideal.span {g φ} →
      φ ∈ IsLocalRing.maximalIdeal R ∧ φ ∉ IsLocalRing.maximalIdeal R ^ 2 ∧
      (∃ _ : IsDomain (R ⧸ RingHom.ker g), IsDiscreteValuationRing (R ⧸ RingHom.ker g)) ∧
      Irreducible (Ideal.Quotient.mk (RingHom.ker g) φ) := by
    intro R O _ _ _ _ _ g _ hg hd φ hm
    have hgφ : g φ ∈ IsLocalRing.maximalIdeal O := by
      rw [hm]; exact Ideal.mem_span_singleton_self _
    have h1 : φ ∈ IsLocalRing.maximalIdeal R := by
      rw [hmem]; intro hu; exact (hmem _).mp hgφ (hu.map g)
    have hnf : ¬ IsField O := by
      intro hf; rw [ringKrullDim_eq_zero_of_isField hf] at hd; exact zero_ne_one hd
    have hne : IsLocalRing.maximalIdeal O ≠ ⊥ := fun h =>
      hnf ((IsLocalRing.isField_iff_maximalIdeal_eq).mpr h)
    have h2 : φ ∉ IsLocalRing.maximalIdeal R ^ 2 := by
      intro hφ2
      have hle : Ideal.map g (IsLocalRing.maximalIdeal R) ≤ IsLocalRing.maximalIdeal O :=
        Ideal.map_le_iff_le_comap.mpr (fun x hx => by
          rw [Ideal.mem_comap, hmem]; intro hu
          exact (hmem x).mp hx ((isUnit_map_iff g x).mp hu))
      have h3 : g φ ∈ IsLocalRing.maximalIdeal O ^ 2 := by
        have := Ideal.mem_map_of_mem g hφ2
        rw [Ideal.map_pow] at this
        exact Ideal.pow_right_mono hle 2 this
      rw [hm, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at h3
      obtain ⟨c, hc⟩ := h3
      have hu : IsUnit (1 - c * g φ) := by
        apply IsLocalRing.isUnit_one_sub_self_of_mem_nonunits
        exact (IsLocalRing.mem_maximalIdeal _).mp (Ideal.mul_mem_left _ c hgφ)
      have h0 : g φ * (1 - c * g φ) = 0 := by linear_combination -hc
      have h00 : g φ = 0 := (hu.mul_left_eq_zero).mp h0
      apply hne; rw [hm, h00, Ideal.span_singleton_eq_bot.mpr rfl]
    let e := RingHom.quotientKerEquivOfSurjective hg
    have he : ∀ x, e (Ideal.Quotient.mk _ x) = g x := fun x =>
      RingHom.quotientKerEquivOfSurjective_apply_mk hg x
    haveI hdom : IsDomain (R ⧸ RingHom.ker g) := MulEquiv.isDomain O e.toMulEquiv
    haveI : IsNoetherianRing (R ⧸ RingHom.ker g) :=
      isNoetherianRing_of_surjective O _ e.symm.toRingHom e.symm.surjective
    haveI : IsLocalRing (R ⧸ RingHom.ker g) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
    have hnf' : ¬ IsField (R ⧸ RingHom.ker g) := fun h =>
      hnf (MulEquiv.isField h e.symm.toMulEquiv)
    have hK : IsLocalRing.maximalIdeal (R ⧸ RingHom.ker g) =
        Ideal.span {Ideal.Quotient.mk (RingHom.ker g) φ} := by
      ext x
      rw [hmem, ← isUnit_map_iff e x, ← hmem, hm, Ideal.mem_span_singleton,
        Ideal.mem_span_singleton, ← he φ]
      exact map_dvd_iff e
    have hP : Submodule.IsPrincipal (IsLocalRing.maximalIdeal (R ⧸ RingHom.ker g)) := ⟨⟨_, hK⟩⟩
    have hdvr : IsDiscreteValuationRing (R ⧸ RingHom.ker g) :=
      ((IsDiscreteValuationRing.TFAE _ hnf').out 1 5).mpr hP
    exact ⟨h1, h2, ⟨hdom, hdvr⟩, (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr hK⟩

  have T_span_prime : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] (φ : R),
      φ ∈ IsLocalRing.maximalIdeal R → φ ∉ IsLocalRing.maximalIdeal R ^ 2 →
      (Ideal.span {φ}).IsPrime := by
    intro R _ _ φ h1 h2
    let x : Fin 1 → IsLocalRing.maximalIdeal R := fun _ => ⟨φ, h1⟩
    have hli : LinearIndependent (IsLocalRing.ResidueField R)
        (fun i => (IsLocalRing.maximalIdeal R).toCotangent (x i)) := by
      rw [linearIndependent_unique_iff]
      intro h; apply h2
      exact (Ideal.toCotangent_eq_zero _ _).mp h
    have hr : Ideal.span (Set.range (fun i => (x i : R))) = Ideal.span {φ} :=
      congrArg _ Set.range_const
    have hreg := (wcpa_rs_quotient_regular R 1 x hli).1
    rw [hr] at hreg
    have hd := wcpa_regular_isDomain (R ⧸ Ideal.span {φ}) wcpa_rs_quotient_regular hreg
    exact (Ideal.Quotient.isDomain_iff_prime _).mp hd

  have T_gen_pt : ∀ (X : Scheme.{u}) (x₀ : X) (T : Set X), IsClosed T → IsIrreducible T →
      x₀ ∈ T → ∀ (W : X.Opens) (hxW : x₀ ∈ W) (f : Γ(X, W)),
      (∀ z ∈ T, z ∈ W → z ∉ X.basicOpen f) →
      (Ideal.span {(X.presheaf.germ W x₀ hxW).hom f}).IsPrime →
      ∃ Q : PrimeSpectrum (X.presheaf.stalk x₀),
        Q.asIdeal = Ideal.span {(X.presheaf.germ W x₀ hxW).hom f} ∧
        ∀ z ∈ T, z ∈ closure {X.fromSpecStalk x₀ Q} := by
    intro X x₀ T hTc hTi hx W hxW f hTW hpr
    have hg := hTi.isGenericPoint_genericPoint_closure
    rw [hTc.closure_eq] at hg
    generalize hTi.genericPoint = η at hg
    have hηx : η ⤳ x₀ := hg.specializes hx
    have hηT : η ∈ T := hg.mem
    have hmemR : η ∈ Set.range (X.fromSpecStalk x₀) := by
      rw [Scheme.range_fromSpecStalk]; exact hηx
    obtain ⟨Q', rfl⟩ := hmemR
    have hηW : X.fromSpecStalk x₀ Q' ∈ W := hηx.mem_open W.isOpen hxW
    have hnb := hTW _ hηT hηW
    obtain ⟨hsp, hiff⟩ := wcpa_dj_mn_generization X x₀ Q'
    have hφQ : (X.presheaf.germ W x₀ hxW).hom f ∈ Q'.asIdeal := by
      rw [← hiff, TopCat.Presheaf.germ_stalkSpecializes_apply]
      rw [Scheme.mem_basicOpen X f _ hηW] at hnb
      exact (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnb)
    refine ⟨⟨_, hpr⟩, rfl, ?_⟩
    intro z hz
    have h1 : (⟨_, hpr⟩ : PrimeSpectrum (X.presheaf.stalk x₀)) ⤳ Q' :=
      (PrimeSpectrum.le_iff_specializes _ _).mp ((Ideal.span_singleton_le_iff_mem _).mpr hφQ)
    have h2 := h1.map (X.fromSpecStalk x₀).continuous
    exact specializes_iff_mem_closure.mp (h2.trans (hg.specializes hz))

  have T_irr_transport : ∀ {Pk P Sk S : Scheme.{u}} (e' : Pk ⟶ P) (str' : Pk ⟶ Sk)
      (str : P ⟶ S) (b : Sk ⟶ S), IsPullback e' str' str b → ∀ (Δ : Set P),
      IsIrreducible (e' ⁻¹' Δ) → IsIrreducible ((Limits.pullback.fst str b) ⁻¹' Δ) := by
    intro Pk P Sk S e' str' str b hsq Δ hirr
    have hfst : hsq.isoPullback.hom ≫ Limits.pullback.fst str b = e' := hsq.isoPullback_hom_fst
    have hinv : ∀ z, hsq.isoPullback.hom (hsq.isoPullback.inv z) = z := by
      intro z
      rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]
      rfl
    have heq : (Limits.pullback.fst str b) ⁻¹' Δ = hsq.isoPullback.hom '' (e' ⁻¹' Δ) := by
      ext z
      constructor
      · intro hz
        refine ⟨hsq.isoPullback.inv z, ?_, hinv z⟩
        show e' _ ∈ Δ
        have h := Scheme.Hom.comp_apply hsq.isoPullback.hom (Limits.pullback.fst str b)
          (hsq.isoPullback.inv z)
        rw [hfst, hinv] at h
        rw [h]
        exact hz
      · rintro ⟨w, hw, rfl⟩
        show _ ∈ Δ
        rw [← Scheme.Hom.comp_apply, hfst]
        exact hw
    rw [heq]
    exact hirr.image _ (Scheme.Hom.continuous _).continuousOn

  have hℓk : ((ℓ : ℕ) : AlgebraicClosure F'') ≠ 0 := by
    intro h0
    have h0' : ((ℓ : ℕ) : F'') = 0 := by
      apply (algebraMap F'' (AlgebraicClosure F'')).injective
      rw [map_natCast, map_zero]; exact h0
    letI := Fintype.ofFinite F''
    haveI : CharP F'' (ringChar F'') := ringChar.charP F''
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' _
    have h1 : ringChar F'' ∣ ℓ := (ringChar.spec F'' ℓ).mp h0'
    have h2 : ringChar F'' = ℓ := (Nat.prime_dvd_prime_iff_eq hp Fact.out).mp h1
    have h3 : ringChar F'' ∣ Fintype.card F'' :=
      (ringChar.spec F'' _).mp (FiniteField.cast_card_eq_zero F'')
    apply hℓ; rw [← h2, Nat.card_eq_fintype_card]; exact h3

  have hqΔ : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom (lb s) ∈ Δ :=
    not_not.mp (fun h => hs ((hUb _).mpr h))
  have hq : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom (lb s) =
      lam (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) s) := by
    rw [← Scheme.Hom.comp_apply, hlb1, Scheme.Hom.comp_apply]
  obtain ⟨i, hi⟩ := (hiff _).mp (hq ▸ hqΔ)
  have hq' : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom (lb s) =
      lam (D.S i (IsLocalRing.closedPoint F'')) := hq.trans (congrArg lam hi)

  have hsq : IsPullback lb (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
      (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) lam := by
    refine IsPullback.of_right ?_ ?_ (IsPullback.of_hasPullback (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))).flip
    · rw [hlb2]
      have hl' : lam ≫ (Over.mk (wcProjKStr F'' M')).hom = (wcP1Over F'').hom := hlamstr
      rw [hl']
      exact (IsPullback.of_hasPullback _ _).flip
    · exact hlb1
  haveI hlbCI : IsClosedImmersion lb :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq.flip hlamCI
  have hgs : Function.Surjective (lb.stalkMap s).hom := Scheme.Hom.stalkMap_surjective lb s

  haveI hsmP : SmoothOfRelativeDimension M' (Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension M')
      (IsPullback.of_hasPullback _ _) (wc_proj_space_smooth F'' M')
  haveI hsm1 : SmoothOfRelativeDimension 1 (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
      (IsPullback.of_hasPullback _ _) (wc_proj_space_smooth F'' 1)

  have hσP : (D.S i ≫ lam) ≫ (Over.mk (wcProjKStr F'' M')).hom = 𝟙 _ := by
    rw [Category.assoc]
    have hl' : lam ≫ (Over.mk (wcProjKStr F'' M')).hom = (wcP1Over F'').hom := hlamstr
    rw [hl']
    exact D.hS i
  obtain ⟨σb, hσb, hσb2⟩ := T_sec_point F'' (AlgebraicClosure F'')
    (algebraMap F'' (AlgebraicClosure F'')) (wcProjK F'' M') (Over.mk (wcProjKStr F'' M')).hom
    (D.S i ≫ lam) hσP (lb s)
    ⟨IsLocalRing.closedPoint F'', (Scheme.Hom.comp_apply _ _ _).trans hq'.symm⟩
  obtain ⟨σ1, hσ1, hσ12⟩ := T_sec_point F'' (AlgebraicClosure F'')
    (algebraMap F'' (AlgebraicClosure F'')) (wcP1Over F'').left (wcP1Over F'').hom
    (D.S i) (D.hS i) s ⟨IsLocalRing.closedPoint F'', hi.symm⟩
  obtain ⟨hreg, -, hdom, hic, hac, hℓu⟩ := T_stalk_pkg (AlgebraicClosure F'') _ _ M' σb hσb
    (lb s) hσb2
  obtain ⟨hregO, hdimO, hdomO, -, -, -⟩ := T_stalk_pkg (AlgebraicClosure F'') _ _ 1 σ1 hσ1
    s hσ12

  obtain ⟨U, hU, φ₀, hΔeq, hline⟩ := hloc i
  have hx₀U : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom (lb s) ∈ U := by
    rw [hq']; exact hU
  obtain ⟨W, hxW, f, hW, hWU, hgerm⟩ := T_local_eq
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left (wcProjK F'' M')
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom Δ Ub hUb U φ₀ hΔeq (lb s) hx₀U

  have hfib := wc_lfi_rational_fibre_maxIdeal F'' (AlgebraicClosure F'')
    (algebraMap F'' (AlgebraicClosure F'')) (wcP1Over F'').left _ (wcP1Over F'').hom
    (Limits.pullback.snd _ _) (Limits.pullback.fst _ _) (IsPullback.of_hasPullback _ _)
    (D.S i) (D.hS i) s ⟨IsLocalRing.closedPoint F'', hi.symm⟩
  have hmO := T_line_max (wcP1Over F'').left (wcProjK F'' M') _ _ lam
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom _ lb hlb1 U φ₀ s
    (D.S i (IsLocalRing.closedPoint F'')) hi hU hx₀U hline hfib
  have hmO2 : IsLocalRing.maximalIdeal ((Limits.pullback (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))).presheaf.stalk s) =
      Ideal.span {(lb.stalkMap s).hom
        (((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.germ W (lb s) hxW).hom f)} := by
    rw [hmO, hgerm]
  haveI := hregO
  haveI := hdomO
  obtain ⟨hφm, hφm2, hdvr, hirrφ⟩ := T_line_alg _ _ (lb.stalkMap s).hom hgs
    (hdimO.trans Nat.cast_one) _ hmO2

  haveI := hreg
  have hprime := @T_span_prime _ _ hreg _ hφm hφm2
  have hTirr : IsIrreducible
      ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom ⁻¹' Δ) :=
    T_irr_transport (wcLdpProjMap F'' (AlgebraicClosure F'') M')
      (wcProjKStr (AlgebraicClosure F'') M') (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
      (wc_ldnm_di_projmap_pb F'' (AlgebraicClosure F'') M') Δ (hirr (AlgebraicClosure F''))
  have hTc : IsClosed ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom ⁻¹' Δ) :=
    hΔc.preimage (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom.continuous
  have hTW : ∀ z ∈ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom ⁻¹' Δ, z ∈ W →
      z ∉ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.basicOpen f := by
    intro z hz hzW hzb
    have h1 : z ∈ (W : Set (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left) ∩ Ub := by
      rw [hWU]; exact hzb
    exact (hUb z).mp h1.2 hz
  obtain ⟨Q, hQ, hgen⟩ := T_gen_pt _ (lb s) _ hTc hTirr hqΔ W hxW f hTW hprime

  exact ⟨W, hxW, f, hW, hWU, hreg, hdom, hic, hac, hℓu ℓ hℓk, hφm, hφm2, hdvr, hirrφ, Q, hQ,
    fun z hz => hgen z hz⟩

theorem wc_plt_ub_local_finite_etale (X E' : Scheme.{u}) (U : X.Opens) (πE : E' ⟶ U.toScheme)
    [IsFinite πE] [Etale πE] (x : X) (W : X.Opens) (hW : IsAffineOpen W) (hxW : x ∈ W)
    (f : Γ(X, W)) (hWU : (W : Set X) ∩ U = X.basicOpen f)
    [IsDomain (X.presheaf.stalk x)] [IsIntegrallyClosed (X.presheaf.stalk x)]
    [IsNoetherianRing (X.presheaf.stalk x)] :
    letI : Algebra (X.presheaf.stalk x) Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤) :=
      ((Scheme.ΓSpecIso (X.presheaf.stalk x)).inv ≫
        (Limits.pullback.snd (πE ≫ U.ι) (X.fromSpecStalk x)).appTop).hom.toAlgebra
    ∃ (_ : Algebra (Localization.Away ((X.presheaf.germ W x hxW).hom f))
        Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤))
      (_ : IsScalarTower (X.presheaf.stalk x) (Localization.Away ((X.presheaf.germ W x hxW).hom f))
        Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤)),
      Algebra.Etale (Localization.Away ((X.presheaf.germ W x hxW).hom f))
        Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤) ∧
      Module.Finite (Localization.Away ((X.presheaf.germ W x hxW).hom f))
        Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤) ∧
      Module.Finite (X.presheaf.stalk x)
        (integralClosure (X.presheaf.stalk x) Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤)) :=
by
  classical

  have hWtop : X.fromSpecStalk x ⁻¹ᵁ W = ⊤ := by
    ext Q
    refine iff_of_true ?_ trivial
    have hsp : X.fromSpecStalk x Q ⤳ x := by
      have hmem : X.fromSpecStalk x Q ∈ Set.range (X.fromSpecStalk x) := ⟨Q, rfl⟩
      rw [Scheme.range_fromSpecStalk] at hmem
      exact hmem
    exact hsp.mem_open W.isOpen hxW

  have hpreU : X.fromSpecStalk x ⁻¹ᵁ U = X.fromSpecStalk x ⁻¹ᵁ X.basicOpen f := by
    ext Q
    have hQW : X.fromSpecStalk x Q ∈ W := by
      have : Q ∈ X.fromSpecStalk x ⁻¹ᵁ W := by rw [hWtop]; trivial
      exact this
    show X.fromSpecStalk x Q ∈ U ↔ X.fromSpecStalk x Q ∈ X.basicOpen f
    constructor
    · intro hQ
      have h' : X.fromSpecStalk x Q ∈ (W : Set X) ∩ U := ⟨hQW, hQ⟩
      rw [hWU] at h'
      exact h'
    · intro hQ
      have h' : X.fromSpecStalk x Q ∈ (W : Set X) ∩ U := by
        rw [hWU]; exact hQ
      exact h'.2

  have hφ : X.fromSpecStalk x ⁻¹ᵁ U =
      PrimeSpectrum.basicOpen ((X.presheaf.germ W x hxW).hom f) := by
    rw [hpreU, Scheme.preimage_basicOpen, Scheme.fromSpecStalk_app hxW, CategoryTheory.comp_apply,
      CategoryTheory.comp_apply, Scheme.basicOpen_res, basicOpen_eq_of_affine, hWtop]
    exact top_inf_eq _

  have s2 : ∀ (φ : X.presheaf.stalk x), X.fromSpecStalk x ⁻¹ᵁ U = PrimeSpectrum.basicOpen φ →
      ∃ t : Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x) ⟶ Spec (.of (Localization.Away φ)),
        IsFinite t ∧ Etale t ∧
        t ≫ Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk x) (Localization.Away φ))) =
          Limits.pullback.snd (πE ≫ U.ι) (X.fromSpecStalk x) := by
    intro φ hφ
    haveI hjo : IsOpenImmersion (Spec.map (CommRingCat.ofHom
        (algebraMap (X.presheaf.stalk x) (Localization.Away φ)))) :=
      IsOpenImmersion.of_isLocalization φ
    have hrange : Set.range (Spec.map (CommRingCat.ofHom
        (algebraMap (X.presheaf.stalk x) (Localization.Away φ)))) =
        (PrimeSpectrum.basicOpen φ : Set (PrimeSpectrum (X.presheaf.stalk x))) := by
      rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away φ) φ]
      rfl
    have hsub : Set.range (Spec.map (CommRingCat.ofHom
        (algebraMap (X.presheaf.stalk x) (Localization.Away φ))) ≫ X.fromSpecStalk x) ⊆
        Set.range U.ι := by
      rintro _ ⟨a, rfl⟩
      rw [Scheme.Opens.range_ι]
      have ha : Spec.map (CommRingCat.ofHom
          (algebraMap (X.presheaf.stalk x) (Localization.Away φ))) a ∈
          (PrimeSpectrum.basicOpen φ : Set (PrimeSpectrum (X.presheaf.stalk x))) := by
        rw [← hrange]; exact ⟨a, rfl⟩
      have ha' : Spec.map (CommRingCat.ofHom
          (algebraMap (X.presheaf.stalk x) (Localization.Away φ))) a ∈ X.fromSpecStalk x ⁻¹ᵁ U := by
        rw [hφ]; exact ha
      exact ha'
    have hk := IsOpenImmersion.lift_fac U.ι _ hsub
    have hpre : X.fromSpecStalk x ⁻¹ᵁ U.ι.opensRange = (Spec.map (CommRingCat.ofHom
        (algebraMap (X.presheaf.stalk x) (Localization.Away φ)))).opensRange := by
      rw [Scheme.Opens.opensRange_ι, hφ]
      apply TopologicalSpace.Opens.ext
      exact hrange.symm.trans (Scheme.Hom.coe_opensRange _).symm
    have hbot := IsOpenImmersion.isPullback (IsOpenImmersion.lift U.ι _ hsub) _ U.ι _ hk.symm hpre
    have w : (Limits.pullback.fst (πE ≫ U.ι) (X.fromSpecStalk x) ≫ πE) ≫ U.ι =
        Limits.pullback.snd (πE ≫ U.ι) (X.fromSpecStalk x) ≫ X.fromSpecStalk x := by
      rw [Category.assoc]; exact Limits.pullback.condition
    have htop : IsPullback (Limits.pullback.fst (πE ≫ U.ι) (X.fromSpecStalk x))
        (hbot.lift _ _ w) πE (IsOpenImmersion.lift U.ι _ hsub) := by
      refine IsPullback.of_bot ?_ (hbot.lift_fst _ _ w).symm hbot
      rw [hbot.lift_snd _ _ w]
      exact IsPullback.of_hasPullback _ _
    exact ⟨hbot.lift _ _ w, MorphismProperty.of_isPullback (P := @IsFinite) htop inferInstance,
      MorphismProperty.of_isPullback (P := @Etale) htop inferInstance, hbot.lift_snd _ _ w⟩

  have s3 : ∀ (R : CommRingCat.{u}) (φ : R) (P : Scheme.{u}) (p : P ⟶ Spec R)
      (t : P ⟶ Spec (.of (Localization.Away φ))) [IsFinite t] [Etale t],
      t ≫ Spec.map (CommRingCat.ofHom (algebraMap R (Localization.Away φ))) = p →
      letI : Algebra R Γ(P, ⊤) := ((Scheme.ΓSpecIso R).inv ≫ p.appTop).hom.toAlgebra
      ∃ (_ : Algebra (Localization.Away φ) Γ(P, ⊤))
        (_ : IsScalarTower R (Localization.Away φ) Γ(P, ⊤)),
        Algebra.Etale (Localization.Away φ) Γ(P, ⊤) ∧
          Module.Finite (Localization.Away φ) Γ(P, ⊤) := by
    intro R φ P p t _ _ ht
    letI algR : Algebra R Γ(P, ⊤) := ((Scheme.ΓSpecIso R).inv ≫ p.appTop).hom.toAlgebra
    haveI : IsAffine P := isAffine_of_isAffineHom t
    letI algS : Algebra (Localization.Away φ) Γ(P, ⊤) :=
      ((Scheme.ΓSpecIso (CommRingCat.of (Localization.Away φ))).inv ≫ t.appTop).hom.toAlgebra
    have hbij : Function.Bijective
        (Scheme.ΓSpecIso (CommRingCat.of (Localization.Away φ))).inv.hom :=
      ((Scheme.ΓSpecIso (CommRingCat.of (Localization.Away φ))).commRingCatIsoToRingEquiv.symm).bijective
    refine ⟨algS, ?_, ?_, ?_⟩
    · apply IsScalarTower.of_algebraMap_eq'
      have hc : (Scheme.ΓSpecIso R).inv ≫ p.appTop =
          CommRingCat.ofHom (algebraMap R (Localization.Away φ)) ≫
            ((Scheme.ΓSpecIso (CommRingCat.of (Localization.Away φ))).inv ≫ t.appTop) := by
        rw [← ht, Scheme.Hom.comp_appTop, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality,
          Category.assoc]
      exact congrArg CommRingCat.Hom.hom hc
    · have h1 : RingHom.Etale t.appTop.hom := HasRingHomProperty.appTop @Etale t inferInstance
      have h2 : RingHom.Etale (Scheme.ΓSpecIso (CommRingCat.of (Localization.Away φ))).inv.hom :=
        RingHom.Etale.of_bijective hbij
      have h3 := RingHom.Etale.stableUnderComposition _ _ h2 h1
      exact h3
    · have h1 : (t.app ⊤).hom.Finite := IsFinite.finite_app t ⊤ (isAffineOpen_top _)
      have h2 : (Scheme.ΓSpecIso (CommRingCat.of (Localization.Away φ))).inv.hom.Finite :=
        RingHom.Finite.of_surjective _ hbij.2
      exact RingHom.Finite.comp h1 h2

  letI algC : Algebra (X.presheaf.stalk x) Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤) :=
    ((Scheme.ΓSpecIso (X.presheaf.stalk x)).inv ≫
      (Limits.pullback.snd (πE ≫ U.ι) (X.fromSpecStalk x)).appTop).hom.toAlgebra
  obtain ⟨t, htf, hte, ht⟩ := s2 _ hφ
  haveI := htf
  haveI := hte
  obtain ⟨alg, tower, het, hfin⟩ :=
    s3 (X.presheaf.stalk x) ((X.presheaf.germ W x hxW).hom f) _ _ t ht
  letI := alg
  haveI := tower
  haveI := het
  refine ⟨alg, tower, het, hfin, ?_⟩
  exact wc_fnf_integralClosure_finite_of_etale_localization (X.presheaf.stalk x)
    (Localization.Away ((X.presheaf.germ W x hxW).hom f))
    (Submonoid.powers ((X.presheaf.germ W x hxW).hom f))
    Γ(Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x), ⊤)
    (fun A _ _ _ _ _ => wc_fnf_integralClosure_finite_of_etale_field (X.presheaf.stalk x)
      (FractionRing (X.presheaf.stalk x)) A)

theorem wc_plt_ub_tame_transfer (F'' : Type u) [Field F''] (M' : ℕ) (Δ : Set (wcProjK F'' M'))
    (ℓ : ℕ)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens)
    (hUb : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      y ∈ Ub ↔ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∉ Δ)
    (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme) [IsFinite πE] [Etale πE]
    (hEt : wcPfamEllTame M' Δ ℓ hPP Ub πE)
    (x : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left) (hx : x ∉ Ub)
    (W : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens) (hW : IsAffineOpen W)
    (hxW : x ∈ W) (f : Γ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left, W))
    (hWU : (W : Set (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left) ∩ Ub =
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.basicOpen f)
    (Q : PrimeSpectrum ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.stalk x))
    (hQ : Q.asIdeal = Ideal.span
      {((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.germ W x hxW).hom f})
    (hgen : ∀ z : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom z ∈ Δ →
      z ∈ closure {(wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.fromSpecStalk x Q}) :
    letI : Algebra ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.stalk x)
        Γ(Limits.pullback (πE ≫ Ub.ι)
          ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.fromSpecStalk x), ⊤) :=
      ((Scheme.ΓSpecIso ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.stalk x)).inv ≫
        (Limits.pullback.snd (πE ≫ Ub.ι)
          ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.fromSpecStalk x)).appTop).hom.toAlgebra
    ∀ (H : Type u) [CommRing H] [HenselianLocalRing H] [IsSepClosed (IsLocalRing.ResidueField H)]
      (hh : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.stalk x →+* H),
      @Algebra.WeaklyEtale _ H _ _ hh.toAlgebra →
      (IsLocalRing.maximalIdeal H).comap hh = Ideal.span
        {((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.presheaf.germ W x hxW).hom f} →
      ∀ (Ω : Type u) [Field Ω] [IsSepClosed Ω] (j : H →+* Ω),
        @Algebra.WeaklyEtale H Ω _ _ j.toAlgebra →
      ∀ σ : Ω →+* Ω, (∀ a, σ (j a) = j a) →
      ∀ χ : Γ(Limits.pullback (πE ≫ Ub.ι)
          ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.fromSpecStalk x), ⊤) →+* Ω,
        χ.comp (algebraMap _ _) = j.comp hh → ∃ m : ℕ, (σ ^ (ℓ ^ m)).comp χ = χ :=
by
  classical

  have tA : ∀ (X E : Scheme.{u}) (U : X.Opens) (πE : E ⟶ U.toScheme) [IsAffineHom πE] (x : X)
      (W : X.Opens), IsAffineOpen W → ∀ (hxW : x ∈ W) (f : Γ(X, W)),
      (W : Set X) ∩ U = X.basicOpen f →
      IsAffine (Limits.pullback (πE ≫ U.ι) (X.fromSpecStalk x)) := by
    intro X E U πE _ x W hW hxW f hWU
    have hle : X.basicOpen f ≤ U := by
      intro y hy
      have : y ∈ (W : Set X) ∩ U := by rw [hWU]; exact hy
      exact this.2
    have h1 : U.ι ⁻¹ᵁ W = U.ι ⁻¹ᵁ X.basicOpen f := by
      apply TopologicalSpace.Opens.ext
      ext y
      change U.ι y ∈ W ↔ U.ι y ∈ X.basicOpen f
      have hyU : U.ι y ∈ U := by
        rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι]; exact ⟨y, rfl⟩
      constructor
      · intro hy
        have : U.ι y ∈ (W : Set X) ∩ U := ⟨hy, hyU⟩
        rw [hWU] at this
        exact this
      · intro hy
        exact X.basicOpen_le f hy
    have h2 : IsAffineOpen (U.ι ⁻¹ᵁ X.basicOpen f) :=
      (hW.basicOpen f).preimage_of_isOpenImmersion U.ι
        (by rw [Scheme.Opens.opensRange_ι]; exact hle)
    have h3 : IsAffineOpen ((πE ≫ U.ι) ⁻¹ᵁ W) := by
      rw [Scheme.Hom.comp_preimage, h1]; exact h2.preimage πE
    have hrange : Set.range (X.fromSpecStalk x) ⊆ Set.range W.ι := by
      rw [Scheme.range_fromSpecStalk, Scheme.Opens.range_ι]
      intro y hy
      exact hy.mem_open W.isOpen hxW
    have hs : IsOpenImmersion.lift W.ι (X.fromSpecStalk x) hrange ≫ W.ι = X.fromSpecStalk x :=
      IsOpenImmersion.lift_fac _ _ _
    have L := IsPullback.of_hasPullback ((πE ≫ U.ι) ∣_ W)
      (IsOpenImmersion.lift W.ι (X.fromSpecStalk x) hrange)
    have Rt := (isPullback_morphismRestrict (πE ≫ U.ι) W).flip
    have P := L.paste_horiz Rt
    rw [hs] at P
    have : IsAffine ((πE ≫ U.ι) ⁻¹ᵁ W) := h3
    have : IsAffine W := hW
    exact IsAffine.of_isIso P.isoPullback.inv

  have tC : ∀ (X : Scheme.{u}) (U W : X.Opens) (x : X) (hxW : x ∈ W) (f : Γ(X, W)),
      (W : Set X) ∩ U = X.basicOpen f → ∀ Q : PrimeSpectrum (X.presheaf.stalk x),
      (X.presheaf.germ W x hxW).hom f ∈ Q.asIdeal → X.fromSpecStalk x Q ∉ U := by
    intro X U W x hxW f hWU Q hfQ hU
    have hyW : X.fromSpecStalk x Q ∈ W := by
      have : X.fromSpecStalk x Q ∈ Set.range (X.fromSpecStalk x) := ⟨Q, rfl⟩
      rw [Scheme.range_fromSpecStalk] at this
      exact this.mem_open W.isOpen hxW
    have hb : X.fromSpecStalk x Q ∈ X.basicOpen f := by
      rw [← SetLike.mem_coe, ← hWU]; exact ⟨hyW, hU⟩
    have hpre : Q ∈ (X.fromSpecStalk x) ⁻¹ᵁ X.basicOpen f := hb
    rw [Scheme.preimage_basicOpen, Scheme.fromSpecStalk_app hxW] at hpre
    simp only [CommRingCat.comp_apply] at hpre
    rw [Scheme.basicOpen_res, basicOpen_eq_of_affine] at hpre
    exact (PrimeSpectrum.mem_basicOpen _ _).mp hpre.2 hfQ

  have tD : ∀ (X P : Scheme.{u}) (g : P ⟶ X) (x : X),
      IsAffine (Limits.pullback g (X.fromSpecStalk x)) → ∀ (K : Type u) [CommRing K]
      (ψ : X.presheaf.stalk x →+* K) (χ : Γ(Limits.pullback g (X.fromSpecStalk x), ⊤) →+* K),
      χ.comp ((Scheme.ΓSpecIso (X.presheaf.stalk x)).inv ≫
        (Limits.pullback.snd g (X.fromSpecStalk x)).appTop).hom = ψ →
      ∃ a : Spec (.of K) ⟶ Limits.pullback g (X.fromSpecStalk x),
        a ≫ Limits.pullback.snd g (X.fromSpecStalk x) = Spec.map (CommRingCat.ofHom ψ) ∧
        ∀ s : K →+* K, s.comp ψ = ψ →
          Spec.map (CommRingCat.ofHom s) ≫ a ≫ Limits.pullback.fst g (X.fromSpecStalk x) =
            a ≫ Limits.pullback.fst g (X.fromSpecStalk x) → s.comp χ = χ := by
    intro X P g x hA K _ ψ χ hχ
    have := hA
    have hsnd : (Spec.map (CommRingCat.ofHom χ) ≫
        (Limits.pullback g (X.fromSpecStalk x)).isoSpec.inv) ≫
        Limits.pullback.snd g (X.fromSpecStalk x) = Spec.map (CommRingCat.ofHom ψ) := by
      rw [Category.assoc, ← Scheme.isoSpec_inv_naturality, Scheme.isoSpec_Spec_inv,
        ← Spec.map_comp, ← Spec.map_comp, ← hχ, CommRingCat.ofHom_comp]
      rfl
    refine ⟨_, hsnd, ?_⟩
    intro s hs h
    have h2 : Spec.map (CommRingCat.ofHom s) ≫ (Spec.map (CommRingCat.ofHom χ) ≫
        (Limits.pullback g (X.fromSpecStalk x)).isoSpec.inv) ≫
          Limits.pullback.snd g (X.fromSpecStalk x) =
        (Spec.map (CommRingCat.ofHom χ) ≫ (Limits.pullback g (X.fromSpecStalk x)).isoSpec.inv) ≫
          Limits.pullback.snd g (X.fromSpecStalk x) := by
      rw [hsnd, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hs]
    have h3 : Spec.map (CommRingCat.ofHom s) ≫ (Spec.map (CommRingCat.ofHom χ) ≫
        (Limits.pullback g (X.fromSpecStalk x)).isoSpec.inv) =
        Spec.map (CommRingCat.ofHom χ) ≫ (Limits.pullback g (X.fromSpecStalk x)).isoSpec.inv := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc]; exact h
      · rw [Category.assoc]; exact h2
    rw [← Category.assoc, cancel_mono, ← Spec.map_comp, ← CommRingCat.ofHom_comp] at h3
    have h5 := congrArg CommRingCat.Hom.hom (Spec.map_injective h3)
    simpa using h5

  have tS : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S], Algebra.WeaklyEtale R S →
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
    intro R S _ _ _ hwe
    have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      exact RingHom.flat_algebraMap_iff.mpr (Algebra.WeaklyEtale.flat (R := R) (S := S))
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R S)))) := by
      rw [diagonal_SpecMap]
      haveI : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) :=
        HasRingHomProperty.Spec_iff.mpr (Algebra.WeaklyEtale.flat_lmul' R S)
      infer_instance
    exact WeaklyEtale.mk hf hd

  have tF : ∀ (X : Scheme.{u}) (x : X), WeaklyEtale (X.fromSpecStalk x) := by
    intro X x
    refine ⟨?_, inferInstance⟩
    obtain ⟨_, ⟨U, hU, rfl⟩, hx, -⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
    replace hU : IsAffineOpen U := hU
    rw [← hU.fromSpecStalk_eq_fromSpecStalk hx]
    show Flat (Spec.map (X.presheaf.germ U x hx) ≫ hU.fromSpec)
    have : Flat (Spec.map (X.presheaf.germ U x hx)) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      letI : Algebra Γ(X, U) (X.presheaf.stalk x) := (X.presheaf.germ U x hx).hom.toAlgebra
      haveI := hU.isLocalization_stalk ⟨x, hx⟩
      exact RingHom.flat_algebraMap_iff.mpr
        (IsLocalization.flat _ (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl)
    have hoi : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
    have hfs : Flat hU.fromSpec := Flat.instOfIsOpenImmersion _
    exact MorphismProperty.comp_mem @Flat _ _ this hfs

  intro H _ _ _ hh hhW hm Ω _ _ j hjW σ hσ χ hχ
  have hPb := tA _ E Ub πE x W hW hxW f hWU
  obtain ⟨a, ha, hrec⟩ := tD _ E (πE ≫ Ub.ι) x hPb Ω (j.comp hh) χ hχ
  have wH : WeaklyEtale (Spec.map (CommRingCat.ofHom hh)) := by
    letI := hh.toAlgebra
    exact tS _ _ hhW
  have wJ : WeaklyEtale (Spec.map (CommRingCat.ofHom j)) := by
    letI := j.toAlgebra
    exact tS _ _ hjW
  have wFS := tF _ x
  have wq : WeaklyEtale (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom :=
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).prop
  let vh : Spec (.of H) ⟶ wcProjK F'' M' := (Spec.map (CommRingCat.ofHom hh) ≫
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.fromSpecStalk x) ≫
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
  have pV : WeaklyEtale vh := by
    show WeaklyEtale ((Spec.map (CommRingCat.ofHom hh) ≫
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.fromSpecStalk x) ≫
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom)
    infer_instance
  let V : (wcProjK F'' M').ProEt := MorphismProperty.Over.mk ⊤ vh pV
  let v : V ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP :=
    MorphismProperty.Over.homMk (Spec.map (CommRingCat.ofHom hh) ≫
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.fromSpecStalk x) rfl trivial
  have pT : WeaklyEtale (Spec.map (CommRingCat.ofHom j) ≫ vh) := inferInstance
  let T₀ : (wcProjK F'' M').ProEt :=
    MorphismProperty.Over.mk ⊤ (Spec.map (CommRingCat.ofHom j) ≫ vh) pT
  let u : T₀ ⟶ V := MorphismProperty.Over.homMk (Spec.map (CommRingCat.ofHom j)) rfl trivial
  have hσj : σ.comp j = j := RingHom.ext hσ
  have hSj : Spec.map (CommRingCat.ofHom σ) ≫ Spec.map (CommRingCat.ofHom j) =
      Spec.map (CommRingCat.ofHom j) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hσj]
  have hτ : Spec.map (CommRingCat.ofHom σ) ≫ (Spec.map (CommRingCat.ofHom j) ≫ vh) =
      Spec.map (CommRingCat.ofHom j) ≫ vh := by
    rw [← Category.assoc, hSj]
  let τ : T₀ ⟶ T₀ := MorphismProperty.Over.homMk (Spec.map (CommRingCat.ofHom σ)) hτ trivial
  have hτu : τ ≫ u = u := by
    apply MorphismProperty.Over.Hom.ext
    exact (MorphismProperty.Comma.comp_left τ u).trans hSj
  let xx : T₀.left ⟶ E := a ≫ Limits.pullback.fst (πE ≫ Ub.ι)
    ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.fromSpecStalk x)
  have hxx : xx ≫ πE ≫ Ub.ι = u.left ≫ v.left := by
    show (a ≫ Limits.pullback.fst (πE ≫ Ub.ι)
      ((wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.fromSpecStalk x)) ≫ πE ≫ Ub.ι =
      Spec.map (CommRingCat.ofHom j) ≫ Spec.map (CommRingCat.ofHom hh) ≫
        (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.fromSpecStalk x
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, ha, CommRingCat.ofHom_comp,
      Spec.map_comp, Category.assoc]
  let e : V.left ≅ Spec (.of H) := Iso.refl _
  have hpQ : PrimeSpectrum.comap hh (IsLocalRing.closedPoint H) = Q := by
    apply PrimeSpectrum.ext
    rw [PrimeSpectrum.comap_asIdeal, hQ]
    exact hm
  have hξ : v.left (e.inv (IsLocalRing.closedPoint H)) =
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.fromSpecStalk x Q := by
    rw [← hpQ]
    rfl
  have hpt : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      (v.left (e.inv (IsLocalRing.closedPoint H))) ∈ Δ := by
    rw [hξ]
    have hn := tC _ Ub W x hxW f hWU Q (by rw [hQ]; exact Ideal.mem_span_singleton_self _)
    by_contra hc
    exact hn ((hUb _).mpr hc)
  have hcl : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
      y ∈ closure {v.left (e.inv (IsLocalRing.closedPoint H))} := by
    intro y hy
    rw [hξ]
    exact hgen y hy
  obtain ⟨k, hk⟩ := hEt V T₀ u v H e Ω (Iso.refl _) hpt hcl τ hτu xx hxx
  have hk' : (fun g : Spec (.of Ω) ⟶ E => Spec.map (CommRingCat.ofHom σ) ≫ g)^[ℓ ^ k] xx = xx := hk
  have iter : ∀ (t : Spec (.of Ω) ⟶ E) (n : ℕ),
      (fun g : Spec (.of Ω) ⟶ E => Spec.map (CommRingCat.ofHom σ) ≫ g)^[n] t =
      Spec.map (CommRingCat.ofHom (σ ^ n)) ≫ t := by
    intro t n
    induction n with
    | zero =>
      show t = Spec.map (CommRingCat.ofHom (σ ^ 0)) ≫ t
      rw [pow_zero, RingHom.one_def, CommRingCat.ofHom_id, Spec.map_id, Category.id_comp]
    | succ n ih =>
      have e1 : (fun g : Spec (.of Ω) ⟶ E => Spec.map (CommRingCat.ofHom σ) ≫ g)^[n + 1] t =
          Spec.map (CommRingCat.ofHom σ) ≫
            ((fun g : Spec (.of Ω) ⟶ E => Spec.map (CommRingCat.ofHom σ) ≫ g)^[n] t) :=
        Function.iterate_succ_apply' _ n t
      rw [e1, ih, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, pow_succ',
        RingHom.mul_def]
  have hfix : (σ ^ (ℓ ^ k)).comp (j.comp hh) = j.comp hh := by
    apply RingHom.ext
    intro r
    show (⇑(σ ^ (ℓ ^ k))) (j (hh r)) = j (hh r)
    rw [RingHom.coe_pow]
    exact Function.iterate_fixed (hσ (hh r)) _
  exact ⟨k, hrec _ hfix ((iter xx _).symm.trans hk')⟩

theorem wc_pub_henselization_indEtale : ∀ (P : Type u) [CommRing P] [IsLocalRing P] [IsNoetherianRing P], ∃ (H : Type u) (_ : CommRing H) (_ : HenselianLocalRing H) (_ : IsNoetherianRing H) (ι : P →+* H), IsLocalHom ι ∧ (∀ x : H, ∃ y : P, x - ι y ∈ IsLocalRing.maximalIdeal H) ∧ Ideal.map ι (IsLocalRing.maximalIdeal P) = IsLocalRing.maximalIdeal H ∧ wcIndEtale ι :=
by
  classical
  intro P _ _ _
  obtain ⟨H, iCR, iHen, iNoeth, ι, hloc, hres, hmax, hUP, hchart⟩ :=
    wc_hnas_henselization_exists P

  have hlev : ∀ (k : ℕ) (p : P), ι p ∈ Ideal.map ι (IsLocalRing.maximalIdeal P ^ k) →
      p ∈ IsLocalRing.maximalIdeal P ^ k := by
    obtain ⟨hlocC, hcpl, hlh, -⟩ := wc_hnas_completion_local_complete P
    haveI := hlocC
    haveI := hcpl
    haveI hHC : HenselianLocalRing (AdicCompletion (IsLocalRing.maximalIdeal P) P) := by
      haveI := IsAdicComplete.henselianRing (AdicCompletion (IsLocalRing.maximalIdeal P) P)
        (IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal P) P))
      exact HenselianLocalRing.mk (fun f hf a₀ h₁ h₂ =>
        HenselianRing.is_henselian f hf a₀ h₁ (h₂.map (Ideal.Quotient.mk _)))
    obtain ⟨h, -, hh⟩ :=
      (hUP _ (algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P)) hlh).exists
    intro k p hp
    apply (wc_hnas_hs_completion_levels P).2 k p
    have h1 := Ideal.mem_map_of_mem h hp
    rw [Ideal.map_map, hh] at h1
    have e : algebraMap P (AdicCompletion (IsLocalRing.maximalIdeal P) P) p = h (ι p) := by
      rw [← hh]; rfl
    rw [e]
    exact h1

  letI : Algebra P H := ι.toAlgebra
  haveI : IsLocalHom (algebraMap P H) := hloc
  have hkill : ∀ (E : Type u) [CommRing E] [Algebra P E] [Algebra.Etale P E] (e : E →+* H),
      e.comp (algebraMap P E) = ι → ∀ a : E, e a = 0 → ∃ s : E, IsUnit (e s) ∧ s * a = 0 := by
    intro E _ _ _ e he a ha
    obtain ⟨φ, hφ⟩ : ∃ φ : E →ₐ[P] H, ∀ x, φ x = e x :=
      ⟨{ e with commutes' := fun p => RingHom.congr_fun he p }, fun _ => rfl⟩
    obtain ⟨φB, hφB, hnoeth, hmaxB, hlvl⟩ := wc_hnas_hs_etale_local_ring_levels P H hres E φ
    haveI := hnoeth
    have hb0 : φB (algebraMap E (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))) a)
        = 0 := by
      rw [hφB, hφ]; exact ha
    have hbk : ∀ k : ℕ,
        algebraMap E (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))) a ∈
          IsLocalRing.maximalIdeal (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))) ^ k := by
      intro k
      obtain ⟨p, hp⟩ := hlvl k
        (algebraMap E (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))) a)
      have h1 := Ideal.mem_map_of_mem
        (φB : Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H)) →+* H) hp
      rw [Ideal.map_map, φB.comp_algebraMap] at h1
      have h2 : φB (algebraMap E (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))) a
          - algebraMap P (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))) p)
          = -(ι p) := by
        rw [map_sub, hb0, AlgHom.commutes, zero_sub]; rfl
      have h1' : φB (algebraMap E (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))) a
          - algebraMap P (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))) p) ∈
          Ideal.map ι (IsLocalRing.maximalIdeal P ^ k) := h1
      rw [h2] at h1'
      have h3 : ι p ∈ Ideal.map ι (IsLocalRing.maximalIdeal P ^ k) := (Ideal.neg_mem_iff _).mp h1'
      have h4 := hlev k p h3
      have h5 := Ideal.add_mem _ hp (Ideal.mem_map_of_mem
        (algebraMap P (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H)))) h4)
      rw [sub_add_cancel, Ideal.map_pow, ← hmaxB] at h5
      exact h5
    have hbot := Ideal.iInf_pow_eq_bot_of_isLocalRing
      (IsLocalRing.maximalIdeal (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))))
      (IsLocalRing.maximalIdeal.isMaximal _).ne_top
    have hz : algebraMap E (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))) a
        = 0 := by
      have hmem := Ideal.mem_iInf.mpr hbk
      rw [hbot] at hmem
      exact (Ideal.mem_bot).mp hmem
    obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff
      (Ideal.comap φ (IsLocalRing.maximalIdeal H)).primeCompl
      (Localization.AtPrime (Ideal.comap φ (IsLocalRing.maximalIdeal H))) a).mp hz
    refine ⟨m, ?_, hm⟩
    have hmq : (m : E) ∉ Ideal.comap φ (IsLocalRing.maximalIdeal H) := m.2
    rw [Ideal.mem_comap, hφ] at hmq
    exact IsLocalRing.notMem_maximalIdeal.mp hmq

  refine ⟨H, iCR, iHen, iNoeth, ι, hloc, hres, hmax, ?_⟩
  unfold wcIndEtale
  intro Q _ _ _ h
  obtain ⟨n, f, hfs, hfg⟩ := Algebra.FinitePresentation.out (R := P) (A := Q)
  obtain ⟨S, hS⟩ := hfg
  obtain ⟨E₀, _, _, _, e₀, he₀, hcov⟩ :=
    hchart (Finset.univ.image (fun i => h (f (MvPolynomial.X i))))
  have hy : ∀ i, ∃ y : E₀, e₀ y = h (f (MvPolynomial.X i)) := fun i => by
    obtain ⟨y, hy⟩ := hcov _ (Finset.mem_image_of_mem _ (Finset.mem_univ i))
    exact ⟨y, hy⟩
  choose y hy using hy
  obtain ⟨ε₀, hε₀⟩ : ∃ ε : E₀ →ₐ[P] H, ∀ x, ε x = e₀ x :=
    ⟨{ e₀ with commutes' := fun p => RingHom.congr_fun he₀ p }, fun _ => rfl⟩
  have hcomp : ε₀.comp (MvPolynomial.aeval y) = h.comp f := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [AlgHom.comp_apply, AlgHom.comp_apply, MvPolynomial.aeval_X, hε₀, hy]
  have hcomp' : ∀ z, e₀ (MvPolynomial.aeval y z) = h (f z) := fun z => by
    rw [← hε₀]
    exact congrArg (fun φ => φ z) hcomp
  have hrel : ∀ g ∈ S, e₀ (MvPolynomial.aeval y g) = 0 := by
    intro g hg
    have hgk : g ∈ RingHom.ker f.toRingHom := by
      rw [← hS]; exact Submodule.subset_span hg
    have hfg0 : f g = 0 := RingHom.mem_ker.mp hgk
    rw [hcomp', hfg0, map_zero]
  have hkillT : ∀ T : Finset E₀, (∀ a ∈ T, e₀ a = 0) →
      ∃ s : E₀, IsUnit (e₀ s) ∧ ∀ a ∈ T, s * a = 0 := by
    intro T
    induction T using Finset.induction_on with
    | empty => intro _; exact ⟨1, by simp, by simp⟩
    | insert a T haT ih =>
      intro hT
      obtain ⟨sT, hsTu, hsT⟩ := ih (fun b hb => hT b (Finset.mem_insert_of_mem hb))
      obtain ⟨sa, hsau, hsa⟩ := hkill E₀ e₀ he₀ a (hT a (Finset.mem_insert_self a T))
      refine ⟨sa * sT, by rw [map_mul]; exact hsau.mul hsTu, ?_⟩
      intro b hb
      rcases Finset.mem_insert.mp hb with hb | hb
      · rw [hb, mul_comm sa sT, mul_assoc, hsa, mul_zero]
      · rw [mul_assoc, hsT b hb, mul_zero]
  obtain ⟨s, hsu, hs⟩ := hkillT (S.image (MvPolynomial.aeval y)) (by
    intro a ha
    obtain ⟨g, hg, rfl⟩ := Finset.mem_image.mp ha
    exact hrel g hg)
  have hβ₀ : ∀ x : E₀, (IsLocalization.Away.lift s hsu : Localization.Away s →+* H)
      (algebraMap E₀ (Localization.Away s) x) = e₀ x :=
    fun x => IsLocalization.Away.lift_eq s hsu x
  obtain ⟨β, hβ⟩ : ∃ β : Localization.Away s →ₐ[P] H, ∀ x,
      β x = (IsLocalization.Away.lift s hsu : Localization.Away s →+* H) x :=
    ⟨{ (IsLocalization.Away.lift s hsu : Localization.Away s →+* H) with
        commutes' := fun p => by
          show (IsLocalization.Away.lift s hsu : Localization.Away s →+* H)
            (algebraMap P (Localization.Away s) p) = algebraMap P H p
          rw [IsScalarTower.algebraMap_apply P E₀ (Localization.Away s), hβ₀]
          exact RingHom.congr_fun he₀ p }, fun _ => rfl⟩
  have hker : RingHom.ker f.toRingHom ≤
      RingHom.ker ((IsScalarTower.toAlgHom P E₀ (Localization.Away s)).comp
        (MvPolynomial.aeval y)).toRingHom := by
    rw [← hS, Submodule.span_le]
    intro g hg
    rw [SetLike.mem_coe, RingHom.mem_ker]
    show algebraMap E₀ (Localization.Away s) (MvPolynomial.aeval y g) = 0
    have hu := IsLocalization.Away.algebraMap_isUnit (S := Localization.Away s) s
    rw [← hu.mul_right_eq_zero, ← map_mul, hs _ (Finset.mem_image_of_mem _ hg), map_zero]
  refine ⟨Localization.Away s, inferInstance, inferInstance, inferInstance,
    f.liftOfSurjective hfs _ hker, β, ?_⟩
  apply AlgHom.ext
  intro x
  obtain ⟨z, rfl⟩ := hfs x
  rw [AlgHom.comp_apply, AlgHom.liftOfSurjective_apply, hβ]
  show (IsLocalization.Away.lift s hsu : Localization.Away s →+* H)
    (algebraMap E₀ (Localization.Away s) (MvPolynomial.aeval y z)) = h (f z)
  rw [hβ₀, hcomp']

theorem wc_pub_henselization_regular_package : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R], IsAlgClosed (IsLocalRing.ResidueField R) → ∀ (H : Type u) [CommRing H] [HenselianLocalRing H] [IsNoetherianRing H] (ι : R →+* H) [IsLocalHom ι], (∀ x : H, ∃ y : R, x - ι y ∈ IsLocalRing.maximalIdeal H) → Ideal.map ι (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal H → @Algebra.WeaklyEtale R H _ _ ι.toAlgebra → ∀ (ℓ : ℕ), IsUnit ((ℓ : ℕ) : R) → ∀ φ : R, φ ∈ IsLocalRing.maximalIdeal R → φ ∉ IsLocalRing.maximalIdeal R ^ 2 → IsRegularLocalRing H ∧ IsDomain H ∧ IsSepClosed (IsLocalRing.ResidueField H) ∧ IsUnit ((ℓ : ℕ) : H) ∧ ι φ ∈ IsLocalRing.maximalIdeal H ∧ ι φ ∉ IsLocalRing.maximalIdeal H ^ 2 ∧ (letI := ι.toAlgebra; Module.FaithfullyFlat R H) ∧ (Ideal.span {ι φ}).comap ι = Ideal.span {φ} :=
by
  intro R _ _ _ hk H _ _ _ ι _ happrox hmax hwe ℓ hℓ φ hφm hφm2
  letI : Algebra R H := ι.toAlgebra
  haveI hflat : Module.Flat R H := hwe.flat
  haveI : IsLocalHom (algebraMap R H) := ‹IsLocalHom ι›
  haveI hff : Module.FaithfullyFlat R H := Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hcm : ∀ I : Ideal R, Ideal.comap ι (Ideal.map ι I) = I := fun I =>
    Ideal.comap_map_eq_self_of_faithfullyFlat (A := R) (B := H) I
  have h8 : (Ideal.span {ι φ}).comap ι = Ideal.span {φ} := by
    have := hcm (Ideal.span {φ})
    rwa [Ideal.map_span, Set.image_singleton] at this
  have h5 : ι φ ∈ IsLocalRing.maximalIdeal H := by
    rw [← hmax]
    exact Ideal.mem_map_of_mem ι hφm
  have h6 : ι φ ∉ IsLocalRing.maximalIdeal H ^ 2 := by
    intro h
    rw [← hmax, ← Ideal.map_pow] at h
    apply hφm2
    rw [← hcm (IsLocalRing.maximalIdeal R ^ 2)]
    exact Ideal.mem_comap.mpr h
  have h4 : IsUnit ((ℓ : ℕ) : H) := by
    have := hℓ.map ι
    rwa [map_natCast] at this
  have h3 : IsSepClosed (IsLocalRing.ResidueField H) := by
    have hinj : Function.Injective (IsLocalRing.ResidueField.map ι) := RingHom.injective _
    have hsurj : Function.Surjective (IsLocalRing.ResidueField.map ι) := by
      intro z
      obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective z
      obtain ⟨y, hy⟩ := happrox x
      refine ⟨IsLocalRing.residue R y, ?_⟩
      rw [IsLocalRing.ResidueField.map_residue]
      have h0 : IsLocalRing.residue H (x - ι y) = 0 := (IsLocalRing.residue_eq_zero_iff _).mpr hy
      rw [map_sub, sub_eq_zero] at h0
      exact h0.symm
    haveI := hk
    haveI := IsAlgClosed.of_ringEquiv _ _ (RingEquiv.ofBijective _ ⟨hinj, hsurj⟩)
    exact IsSepClosed.of_isAlgClosed _
  have h9 : IsRegularLocalRing (H ⧸ Ideal.map (algebraMap R H) (IsLocalRing.maximalIdeal R)) := by
    set J := Ideal.map (algebraMap R H) (IsLocalRing.maximalIdeal R) with hJdef
    have hJ : J = IsLocalRing.maximalIdeal H := hmax
    have hJmax : J.IsMaximal := by
      rw [hJ]
      exact IsLocalRing.maximalIdeal.isMaximal H
    have hfield : IsField (H ⧸ J) :=
      (Ideal.Quotient.maximal_ideal_iff_isField_quotient J).mp hJmax
    haveI : Nontrivial (H ⧸ J) := ⟨hfield.exists_pair_ne⟩
    haveI : IsLocalRing (H ⧸ J) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
    haveI : IsNoetherianRing (H ⧸ J) := Ideal.Quotient.isNoetherianRing J
    refine IsRegularLocalRing.mk ?_
    rw [IsLocalRing.isField_iff_maximalIdeal_eq.mp hfield, Submodule.spanFinrank_bot,
      ringKrullDim_eq_zero_of_isField hfield]
    rfl
  have h1 : IsRegularLocalRing H :=
    wc_hnas_pfc_regular_flat_ascent R H ‹IsRegularLocalRing R› h9
  have h2 : IsDomain H :=
    wc_rl_isDomain wc_rl_quot_embdim (wc_rl_quot_regular wc_rl_quot_embdim) H h1
  exact ⟨h1, h2, h3, h4, h5, h6, hff, h8⟩

theorem wc_pub_cover_baseChange : ∀ (R H C : Type u) [CommRing R] [CommRing H] [CommRing C] [Algebra R H] (φ : R) [Algebra R C] [Algebra (Localization.Away φ) C] [IsScalarTower R (Localization.Away φ) C] [Algebra.Etale (Localization.Away φ) C] [Module.Finite (Localization.Away φ) C], ∃ (_ : Algebra (Localization.Away (algebraMap R H φ)) (TensorProduct R H C)) (_ : IsScalarTower H (Localization.Away (algebraMap R H φ)) (TensorProduct R H C)), Algebra.Etale (Localization.Away (algebraMap R H φ)) (TensorProduct R H C) ∧ Module.Finite (Localization.Away (algebraMap R H φ)) (TensorProduct R H C) :=
by
  intro R H C _ _ _ _ φ _ _ _ _ _
  have hu : IsUnit (algebraMap H (TensorProduct R H C) (algebraMap R H φ)) := by
    have h1 : IsUnit (algebraMap R C φ) := by
      rw [IsScalarTower.algebraMap_apply R (Localization.Away φ) C]
      exact (IsLocalization.Away.algebraMap_isUnit φ).map _
    have h2 := h1.map (Algebra.TensorProduct.includeRight : C →ₐ[R] TensorProduct R H C)
    rw [AlgHom.commutes, IsScalarTower.algebraMap_apply R H (TensorProduct R H C)] at h2
    exact h2
  let g : Localization.Away (algebraMap R H φ) →+* TensorProduct R H C :=
    Localization.awayLift (algebraMap H _) (algebraMap R H φ) hu
  letI alg : Algebra (Localization.Away (algebraMap R H φ)) (TensorProduct R H C) := g.toAlgebra
  have hg : ∀ x : H, g (algebraMap H (Localization.Away (algebraMap R H φ)) x) =
      algebraMap H (TensorProduct R H C) x :=
    fun x => IsLocalization.Away.lift_eq (algebraMap R H φ) hu x
  have tower : IsScalarTower H (Localization.Away (algebraMap R H φ)) (TensorProduct R H C) := by
    apply IsScalarTower.of_algebraMap_eq
    intro x
    exact (hg x).symm
  refine ⟨alg, tower, ?_, ?_⟩
  · haveI : Algebra.Etale R C := Algebra.Etale.comp R (Localization.Away φ) C
    haveI : Algebra.Etale H (TensorProduct R H C) := inferInstance
    haveI : Algebra.FormallyEtale (Localization.Away (algebraMap R H φ)) (TensorProduct R H C) :=
      Algebra.FormallyEtale.of_restrictScalars (R := H)
    haveI : Algebra.FinitePresentation (Localization.Away (algebraMap R H φ))
        (TensorProduct R H C) :=
      Algebra.FinitePresentation.of_restrict_scalars_finitePresentation H _ _
    exact Algebra.Etale.mk
  · obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := Localization.Away φ) (M := C)
    let lam : Localization.Away φ →+* Localization.Away (algebraMap R H φ) :=
      Localization.awayMap (algebraMap R H) φ
    let iR : C →ₐ[R] TensorProduct R H C := Algebra.TensorProduct.includeRight
    have key : (iR : C →+* TensorProduct R H C).comp (algebraMap (Localization.Away φ) C) =
        g.comp lam := by
      apply IsLocalization.ringHom_ext (Submonoid.powers φ)
      ext r
      simp only [RingHom.comp_apply]
      rw [← IsScalarTower.algebraMap_apply, RingHom.coe_coe, AlgHom.commutes]
      have e1 : lam (algebraMap R (Localization.Away φ) r) =
          algebraMap H (Localization.Away (algebraMap R H φ)) (algebraMap R H r) :=
        IsLocalization.map_eq _ _
      rw [e1, hg, ← IsScalarTower.algebraMap_apply]
    let t : Fin n → TensorProduct R H C := fun i => (1 : H) ⊗ₜ[R] s i
    let N : Submodule (Localization.Away (algebraMap R H φ)) (TensorProduct R H C) :=
      Submodule.span _ (Set.range t)
    have hR : ∀ c : C, iR c ∈ N := by
      intro c
      have hc : c ∈ Submodule.span (Localization.Away φ) (Set.range s) := by
        rw [hs]; trivial
      induction hc using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨i, rfl⟩ := hx
        exact Submodule.subset_span ⟨i, rfl⟩
      | zero => rw [map_zero]; exact N.zero_mem
      | add x y _ _ hx hy => rw [map_add]; exact N.add_mem hx hy
      | smul a x _ hx =>
        have e : iR (a • x) = lam a • iR x := by
          rw [Algebra.smul_def, map_mul, Algebra.smul_def]
          congr 1
          exact congrArg (fun f => f a) key
        rw [e]
        exact N.smul_mem _ hx
    have htop : N = ⊤ := by
      rw [eq_top_iff]
      intro z _
      induction z using TensorProduct.induction_on with
      | zero => exact N.zero_mem
      | tmul h c =>
        have e : h ⊗ₜ[R] c =
            algebraMap H (Localization.Away (algebraMap R H φ)) h • iR c := by
          rw [Algebra.smul_def]
          show h ⊗ₜ[R] c = g (algebraMap H (Localization.Away (algebraMap R H φ)) h) * (1 ⊗ₜ c)
          rw [hg, Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul,
            mul_one, one_mul]
          simp
        rw [e]
        exact N.smul_mem _ (hR c)
      | add x y hx hy => exact N.add_mem (hx trivial) (hy trivial)
    classical
    refine ⟨⟨Finset.univ.image t, ?_⟩⟩
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
    exact htop

theorem wc_pub_tame_baseChange : ∀ (R H C : Type u) [CommRing R] [CommRing H] [CommRing C] [Algebra R H] [Algebra R C] (φ : R) (ℓ : ℕ), Algebra.WeaklyEtale R H → (Ideal.span {algebraMap R H φ}).comap (algebraMap R H) = Ideal.span {φ} → (∀ (H' : Type u) [CommRing H'] [HenselianLocalRing H'] [IsSepClosed (IsLocalRing.ResidueField H')] (hh : R →+* H'), @Algebra.WeaklyEtale R H' _ _ hh.toAlgebra → (IsLocalRing.maximalIdeal H').comap hh = Ideal.span {φ} → ∀ (Ω : Type u) [Field Ω] [IsSepClosed Ω] (j : H' →+* Ω), @Algebra.WeaklyEtale H' Ω _ _ j.toAlgebra → ∀ σ : Ω →+* Ω, (∀ a, σ (j a) = j a) → ∀ χ : C →+* Ω, χ.comp (algebraMap R C) = j.comp hh → ∃ m : ℕ, (σ ^ (ℓ ^ m)).comp χ = χ) → (∀ (H' : Type u) [CommRing H'] [HenselianLocalRing H'] [IsSepClosed (IsLocalRing.ResidueField H')] (hh : H →+* H'), @Algebra.WeaklyEtale H H' _ _ hh.toAlgebra → (IsLocalRing.maximalIdeal H').comap hh = Ideal.span {algebraMap R H φ} → ∀ (Ω : Type u) [Field Ω] [IsSepClosed Ω] (j : H' →+* Ω), @Algebra.WeaklyEtale H' Ω _ _ j.toAlgebra → ∀ σ : Ω →+* Ω, (∀ a, σ (j a) = j a) → ∀ χ : TensorProduct R H C →+* Ω, χ.comp (algebraMap H (TensorProduct R H C)) = j.comp hh → ∃ m : ℕ, (σ ^ (ℓ ^ m)).comp χ = χ) :=
by
  intro R H C _ _ _ _ _ φ ℓ hwe hcomap hT H' _ _ _ hh hweH hmax Ω _ _ j hj σ hσ χD hχD
  set hh₀ : R →+* H' := hh.comp (algebraMap R H) with hh₀_def
  have hwe₀ : @Algebra.WeaklyEtale R H' _ _ hh₀.toAlgebra := by
    letI : Algebra H H' := hh.toAlgebra
    letI : Algebra R H' := hh₀.toAlgebra
    haveI : IsScalarTower R H H' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Algebra.WeaklyEtale H H' := hweH
    exact Algebra.WeaklyEtale.trans R H H'
  have hcomap₀ : (IsLocalRing.maximalIdeal H').comap hh₀ = Ideal.span {φ} := by
    rw [hh₀_def, ← Ideal.comap_comap, hmax, hcomap]
  set χ : C →+* Ω := χD.comp
    (Algebra.TensorProduct.includeRight : C →ₐ[R] TensorProduct R H C).toRingHom with hχ_def
  have hχ : χ.comp (algebraMap R C) = j.comp hh₀ := by
    apply RingHom.ext
    intro r
    have h1 : (Algebra.TensorProduct.includeRight : C →ₐ[R] TensorProduct R H C)
        (algebraMap R C r) = algebraMap H (TensorProduct R H C) (algebraMap R H r) := by
      rw [AlgHom.commutes, IsScalarTower.algebraMap_apply R H (TensorProduct R H C)]
    have h2 := RingHom.congr_fun hχD (algebraMap R H r)
    simp only [RingHom.comp_apply] at h2 ⊢
    show χD ((Algebra.TensorProduct.includeRight : C →ₐ[R] TensorProduct R H C)
      (algebraMap R C r)) = j (hh (algebraMap R H r))
    rw [h1, h2]
  obtain ⟨m, hm⟩ := hT H' hh₀ hwe₀ hcomap₀ Ω j hj σ hσ χ hχ
  refine ⟨m, ?_⟩
  have hfix : ∀ (N : ℕ) (a : H'), (σ ^ N) (j a) = j a := by
    intro N a
    rw [RingHom.coe_pow]
    exact Function.iterate_fixed (hσ a) N
  apply Algebra.TensorProduct.ringHom_ext
  · apply RingHom.ext
    intro h
    have h2 := RingHom.congr_fun hχD h
    simp only [RingHom.comp_apply] at h2 ⊢
    have h3 : (Algebra.TensorProduct.includeLeftRingHom : H →+* TensorProduct R H C) h
        = algebraMap H (TensorProduct R H C) h := by
      rw [Algebra.TensorProduct.includeLeftRingHom_apply, Algebra.TensorProduct.algebraMap_apply]
      rfl
    rw [h3, h2, hfix]
  · rw [RingHom.comp_assoc]
    exact hm

theorem wc_pas_kummer_cover_regular : ∀ (H : Type u) [CommRing H] [HenselianLocalRing H] [IsSepClosed (IsLocalRing.ResidueField H)] [IsRegularLocalRing H] [IsDomain H] (φ : H), φ ∈ IsLocalRing.maximalIdeal H → φ ∉ IsLocalRing.maximalIdeal H ^ 2 → ∀ (N : ℕ), 0 < N → ∃ (_ : HenselianLocalRing (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))), IsSepClosed (IsLocalRing.ResidueField (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))) ∧ IsRegularLocalRing (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) ∧ IsDomain (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) ∧ AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C φ) ∈ IsLocalRing.maximalIdeal (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) ∧ AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C φ) ∉ IsLocalRing.maximalIdeal (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) ^ 2 ∧ (Ideal.span {AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C φ)}).IsPrime :=
by
  intro H _ _ _ _ _ φ hφm hφm2 N hN
  classical
  have hNne : N ≠ 0 := hN.ne'
  have hφ0 : φ ≠ 0 := by
    rintro rfl
    exact hφm2 (Ideal.zero_mem _)
  generalize hf : Polynomial.X ^ N - Polynomial.C φ = f
  have hmon : f.Monic := by rw [← hf]; exact Polynomial.monic_X_pow_sub_C φ hNne
  have hfin : Module.Finite H (AdjoinRoot f) := hmon.finite_adjoinRoot
  have : Module.Free H (AdjoinRoot f) := Module.Free.of_basis (AdjoinRoot.powerBasis' hmon).basis
  have : IsNoetherianRing (AdjoinRoot f) := IsNoetherianRing.of_finite H (AdjoinRoot f)

  have hθN : AdjoinRoot.root f ^ N = AdjoinRoot.of f φ := by
    have h0 : AdjoinRoot.mk f (Polynomial.X ^ N - Polynomial.C φ) = 0 := by
      rw [hf]; exact AdjoinRoot.mk_self
    rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h0
    exact h0

  have hdec : ∀ g : Polynomial H, AdjoinRoot.mk f g =
      AdjoinRoot.root f * AdjoinRoot.mk f g.divX + AdjoinRoot.of f (g.coeff 0) := by
    intro g
    conv_lhs => rw [← Polynomial.X_mul_divX_add g]
    rw [map_add, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C]
  have hdec' : ∀ r : AdjoinRoot f, ∃ y c, r = AdjoinRoot.root f * y + AdjoinRoot.of f c := by
    intro r
    obtain ⟨g, rfl⟩ := AdjoinRoot.mk_surjective r
    exact ⟨_, _, hdec g⟩

  have hres0 : IsLocalRing.residue H φ = 0 := (IsLocalRing.residue_eq_zero_iff φ).mpr hφm
  obtain ⟨ρ, hρof, hρθ⟩ : ∃ ρ : AdjoinRoot f →+* IsLocalRing.ResidueField H,
      (∀ a, ρ (AdjoinRoot.of f a) = IsLocalRing.residue H a) ∧ ρ (AdjoinRoot.root f) = 0 := by
    have h : Polynomial.eval₂ (IsLocalRing.residue H) 0 f = 0 := by
      rw [← hf]; simp [hres0, zero_pow hNne]
    exact ⟨AdjoinRoot.lift _ _ h, fun a => AdjoinRoot.lift_of h, AdjoinRoot.lift_root h⟩
  have hρsurj : Function.Surjective ρ := by
    intro y
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
    exact ⟨_, hρof a⟩
  have hM0 : (RingHom.ker ρ).IsMaximal := RingHom.ker_isMaximal_of_surjective ρ hρsurj
  have hρker : ∀ y c, AdjoinRoot.root f * y + AdjoinRoot.of f c ∈ RingHom.ker ρ ↔
      c ∈ IsLocalRing.maximalIdeal H := by
    intro y c
    rw [RingHom.mem_ker, map_add, map_mul, hρθ, zero_mul, zero_add, hρof,
      IsLocalRing.residue_eq_zero_iff]

  have : Algebra.IsIntegral H (AdjoinRoot f) := Algebra.IsIntegral.of_finite H _
  have hint : (algebraMap H (AdjoinRoot f)).IsIntegral :=
    algebraMap_isIntegral_iff.mpr inferInstance
  have hmaxQ : ∀ Q : Ideal (AdjoinRoot f), Q.IsMaximal → RingHom.ker ρ ≤ Q := by
    intro Q hQ
    have hcQ : Q.comap (algebraMap H (AdjoinRoot f)) = IsLocalRing.maximalIdeal H :=
      IsLocalRing.eq_maximalIdeal (Ideal.isMaximal_comap_of_isIntegral_of_isMaximal _ hint Q)
    have hofQ : ∀ c ∈ IsLocalRing.maximalIdeal H, AdjoinRoot.of f c ∈ Q := by
      intro c hc
      rw [← hcQ, Ideal.mem_comap, AdjoinRoot.algebraMap_eq] at hc
      exact hc
    have hθQ : AdjoinRoot.root f ∈ Q :=
      hQ.isPrime.mem_of_pow_mem N (by rw [hθN]; exact hofQ φ hφm)
    intro r hr
    obtain ⟨y, c, rfl⟩ := hdec' r
    exact Q.add_mem (Q.mul_mem_right _ hθQ) (hofQ c ((hρker y c).mp hr))
  have hloc : IsLocalRing (AdjoinRoot f) :=
    IsLocalRing.of_unique_max_ideal
      ⟨RingHom.ker ρ, hM0, fun Q hQ => (hM0.eq_of_le hQ.ne_top (hmaxQ Q hQ)).symm⟩
  have hMker : RingHom.ker ρ = IsLocalRing.maximalIdeal (AdjoinRoot f) :=
    IsLocalRing.eq_maximalIdeal hM0
  have hMform : ∀ r ∈ IsLocalRing.maximalIdeal (AdjoinRoot f), ∃ y c,
      c ∈ IsLocalRing.maximalIdeal H ∧ r = AdjoinRoot.root f * y + AdjoinRoot.of f c := by
    intro r hr
    obtain ⟨y, c, rfl⟩ := hdec' r
    rw [← hMker] at hr
    exact ⟨y, c, (hρker y c).mp hr, rfl⟩
  have hθM : AdjoinRoot.root f ∈ IsLocalRing.maximalIdeal (AdjoinRoot f) := by
    rw [← hMker, RingHom.mem_ker]; exact hρθ

  have hM2 : ∀ (T : Type u) [CommRing T] (F : AdjoinRoot f →+* T),
      (∀ r ∈ IsLocalRing.maximalIdeal (AdjoinRoot f), ∀ s ∈ IsLocalRing.maximalIdeal (AdjoinRoot f),
        F r * F s = 0) →
      F (AdjoinRoot.root f) ≠ 0 → AdjoinRoot.root f ∉ IsLocalRing.maximalIdeal (AdjoinRoot f) ^ 2 := by
    intro T _ F hprod hFθ hθ2
    apply hFθ
    have hle : IsLocalRing.maximalIdeal (AdjoinRoot f) ^ 2 ≤ RingHom.ker F := by
      rw [pow_two, Ideal.mul_le]
      intro r hr s hs
      rw [RingHom.mem_ker, map_mul]
      exact hprod r hr s hs
    exact hle hθ2
  have hθM2 : AdjoinRoot.root f ∉ IsLocalRing.maximalIdeal (AdjoinRoot f) ^ 2 := by
    rcases Nat.lt_or_ge 1 N with h2 | h1
    · have hε : (DualNumber.eps : DualNumber (IsLocalRing.ResidueField H)) ^ N = 0 := by
        have hN2 : N = (N - 2) + 2 := by omega
        rw [hN2, pow_add, pow_two, DualNumber.eps_mul_eps, mul_zero]
      obtain ⟨F, hFof, hFθ⟩ : ∃ F : AdjoinRoot f →+* DualNumber (IsLocalRing.ResidueField H),
          (∀ a, F (AdjoinRoot.of f a) = algebraMap _ _ (IsLocalRing.residue H a)) ∧
            F (AdjoinRoot.root f) = DualNumber.eps := by
        have h : Polynomial.eval₂ ((algebraMap (IsLocalRing.ResidueField H)
            (DualNumber (IsLocalRing.ResidueField H))).comp (IsLocalRing.residue H))
            DualNumber.eps f = 0 := by
          rw [← hf]; simp [hε, hres0]
        exact ⟨AdjoinRoot.lift _ _ h, fun a => AdjoinRoot.lift_of h, AdjoinRoot.lift_root h⟩
      have hFM : ∀ r ∈ IsLocalRing.maximalIdeal (AdjoinRoot f), ∃ t, F r = DualNumber.eps * t := by
        intro r hr
        obtain ⟨y, c, hc, rfl⟩ := hMform r hr
        refine ⟨F y, ?_⟩
        rw [map_add, map_mul, hFθ, hFof, (IsLocalRing.residue_eq_zero_iff c).mpr hc, map_zero,
          add_zero]
      refine hM2 _ F ?_ ?_
      · intro r hr s hs
        obtain ⟨t, ht⟩ := hFM r hr
        obtain ⟨t', ht'⟩ := hFM s hs
        rw [ht, ht', mul_mul_mul_comm, DualNumber.eps_mul_eps, zero_mul]
      · rw [hFθ]
        intro h0
        have := congrArg TrivSqZeroExt.snd h0
        rw [DualNumber.snd_eps, TrivSqZeroExt.snd_zero] at this
        exact one_ne_zero this
    · have hN1 : N = 1 := by omega
      subst hN1
      obtain ⟨F, hFof, hFθ⟩ : ∃ F : AdjoinRoot f →+* (H ⧸ IsLocalRing.maximalIdeal H ^ 2),
          (∀ a, F (AdjoinRoot.of f a) = Ideal.Quotient.mk _ a) ∧
            F (AdjoinRoot.root f) = Ideal.Quotient.mk _ φ := by
        have h : Polynomial.eval₂ (Ideal.Quotient.mk (IsLocalRing.maximalIdeal H ^ 2))
            (Ideal.Quotient.mk _ φ) f = 0 := by
          rw [← hf]; simp
        exact ⟨AdjoinRoot.lift _ _ h, fun a => AdjoinRoot.lift_of h, AdjoinRoot.lift_root h⟩
      have hFM : ∀ r ∈ IsLocalRing.maximalIdeal (AdjoinRoot f), ∃ a ∈ IsLocalRing.maximalIdeal H,
          F r = Ideal.Quotient.mk _ a := by
        intro r hr
        obtain ⟨y, c, hc, rfl⟩ := hMform r hr
        obtain ⟨y', hy'⟩ := Ideal.Quotient.mk_surjective (F y)
        refine ⟨φ * y' + c, (IsLocalRing.maximalIdeal H).add_mem
          ((IsLocalRing.maximalIdeal H).mul_mem_right _ hφm) hc, ?_⟩
        rw [map_add, map_mul, hFθ, hFof, ← hy', map_add, map_mul]
      refine hM2 _ F ?_ ?_
      · intro r hr s hs
        obtain ⟨a, ha, h1⟩ := hFM r hr
        obtain ⟨b, hb, h2⟩ := hFM s hs
        rw [h1, h2, ← map_mul, Ideal.Quotient.eq_zero_iff_mem, pow_two]
        exact Ideal.mul_mem_mul ha hb
      · rw [hFθ]
        intro h0
        exact hφm2 (Ideal.Quotient.eq_zero_iff_mem.mp h0)

  obtain ⟨n, e, hidem, -, hsum, hloc_e⟩ :=
    wc_strictHensel_finite_idem_decomp H (AdjoinRoot f) hfin
  have h01 : ∀ i, e i = 0 ∨ e i = 1 := by
    intro i
    have h := (hidem i).eq
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (e i) with hu | hu
    · right
      exact hu.mul_left_cancel (h.trans (mul_one _).symm)
    · left
      exact hu.mul_left_cancel (by rw [sub_mul, one_mul, h, sub_self, mul_zero])
  obtain ⟨i, -, hi⟩ := Finset.exists_ne_zero_of_sum_ne_zero (s := Finset.univ) (f := e)
    (by rw [hsum]; exact one_ne_zero)
  have hu : IsUnit (e i) := by
    rcases h01 i with h | h
    · exact absurd h hi
    · rw [h]; exact isUnit_one
  obtain ⟨hhens_i, hsep_i, -⟩ := hloc_e i
  let E : AdjoinRoot f ≃+* Localization.Away (e i) :=
    (IsLocalization.atUnit (AdjoinRoot f) (Localization.Away (e i)) (e i) hu).toRingEquiv
  have hhens : HenselianLocalRing (AdjoinRoot f) :=
    wc_henselian_sepClosed_transfer.1 _ _ E.symm hhens_i
  have hsep : IsSepClosed (IsLocalRing.ResidueField (AdjoinRoot f)) :=
    wc_henselian_sepClosed_transfer.2 _ _ (IsLocalRing.ResidueField.mapEquiv E.symm) hsep_i

  obtain ⟨π, hπof, hπθ⟩ : ∃ π : AdjoinRoot f →+* (H ⧸ Ideal.span {φ}),
      (∀ a, π (AdjoinRoot.of f a) = Ideal.Quotient.mk _ a) ∧ π (AdjoinRoot.root f) = 0 := by
    have hφJ : Ideal.Quotient.mk (Ideal.span {φ}) φ = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self φ)
    have h : Polynomial.eval₂ (Ideal.Quotient.mk (Ideal.span {φ})) 0 f = 0 := by
      rw [← hf]; simp [hφJ, zero_pow hNne]
    exact ⟨AdjoinRoot.lift _ _ h, fun a => AdjoinRoot.lift_of h, AdjoinRoot.lift_root h⟩
  have hπsurj : Function.Surjective π := by
    intro z
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
    exact ⟨_, hπof a⟩
  have hker : Ideal.span {AdjoinRoot.root f} = RingHom.ker π := by
    apply le_antisymm
    · rw [Ideal.span_singleton_le_iff_mem, RingHom.mem_ker]; exact hπθ
    · intro r hr
      obtain ⟨y, c, rfl⟩ := hdec' r
      rw [RingHom.mem_ker, map_add, map_mul, hπθ, zero_mul, zero_add, hπof,
        Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at hr
      obtain ⟨d, rfl⟩ := hr
      rw [Ideal.mem_span_singleton']
      refine ⟨y + AdjoinRoot.of f d * AdjoinRoot.root f ^ (N - 1), ?_⟩
      rw [map_mul, ← hθN, ← pow_sub_one_mul hNne]
      ring
  let eq : (AdjoinRoot f ⧸ Ideal.span {AdjoinRoot.root f}) ≃+* (H ⧸ Ideal.span {φ}) :=
    (Ideal.quotEquivOfEq hker).trans (RingHom.quotientKerEquivOfSurjective hπsurj)

  obtain ⟨hregq, -⟩ := wc_rl_quot_regular wc_rl_quot_embdim H inferInstance φ hφm hφm2
  have : IsLocalRing (AdjoinRoot f ⧸ Ideal.span {AdjoinRoot.root f}) := eq.symm.isLocalRing
  have hmapmax : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (g : A ≃+* B), Ideal.map g.toRingHom (IsLocalRing.maximalIdeal A) = IsLocalRing.maximalIdeal B := by
    intro A B _ _ _ _ g
    apply IsLocalRing.eq_maximalIdeal
    exact Ideal.map_isMaximal_of_equiv g
  have hregR : IsRegularLocalRing (AdjoinRoot f ⧸ Ideal.span {AdjoinRoot.root f}) := by
    have hle1 := Ideal.spanFinrank_map_le_of_fg eq.symm.toRingHom
      (IsNoetherian.noetherian (IsLocalRing.maximalIdeal (H ⧸ Ideal.span {φ})))
    have hle2 := Ideal.spanFinrank_map_le_of_fg eq.toRingHom
      (IsNoetherian.noetherian
        (IsLocalRing.maximalIdeal (AdjoinRoot f ⧸ Ideal.span {AdjoinRoot.root f})))
    rw [hmapmax _ _ eq.symm] at hle1
    rw [hmapmax _ _ eq] at hle2
    refine IsRegularLocalRing.mk ?_
    rw [le_antisymm hle1 hle2, ringKrullDim_eq_of_ringEquiv eq]
    exact IsRegularLocalRing.spanFinrank_maximalIdeal
  have hdimR : ringKrullDim (AdjoinRoot f ⧸ Ideal.span {AdjoinRoot.root f}) =
      ((Submodule.spanFinrank (IsLocalRing.maximalIdeal (H ⧸ Ideal.span {φ})) : ℕ) : WithBot ℕ∞) :=
    (ringKrullDim_eq_of_ringEquiv eq).trans IsRegularLocalRing.spanFinrank_maximalIdeal.symm

  have hnzd : AdjoinRoot.root f ∈ nonZeroDivisors (AdjoinRoot f) := by
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    have h0 : φ • x = 0 := by
      calc φ • x = AdjoinRoot.root f ^ (N - 1) * (x * AdjoinRoot.root f) := by
            rw [Algebra.smul_def, AdjoinRoot.algebraMap_eq, ← hθN, ← pow_sub_one_mul hNne]
            ring
        _ = 0 := by rw [hx, mul_zero]
    exact (smul_eq_zero.mp h0).resolve_left hφ0

  obtain ⟨hreg, -⟩ := wc_odp_regular_lift_nzd (AdjoinRoot f) (AdjoinRoot.root f) _ hθM hnzd
    hregR hdimR
  have hdom : IsDomain (AdjoinRoot f) := (@wc_fco_regular_local_ufd (AdjoinRoot f) _ hreg).1
  have : IsDomain (H ⧸ Ideal.span {φ}) := (wc_fco_regular_local_ufd (H ⧸ Ideal.span {φ})).1
  have : IsDomain (AdjoinRoot f ⧸ Ideal.span {AdjoinRoot.root f}) :=
    MulEquiv.isDomain (H ⧸ Ideal.span {φ}) eq.toMulEquiv
  have hprime : (Ideal.span {AdjoinRoot.root f}).IsPrime :=
    (Ideal.Quotient.isDomain_iff_prime _).mp inferInstance
  exact ⟨hhens, hsep, hreg, hdom, hθM, hθM2, hprime⟩

theorem wc_ppi_etale_off_s : ∀ (A : Type u) [CommRing A] (s : A) (E : Type u) [CommRing E] [Algebra A E] [Algebra (Localization.Away s) E] [IsScalarTower A (Localization.Away s) E] [Algebra.Etale (Localization.Away s) E] [Module.Finite (Localization.Away s) E] (p : Ideal A) [p.IsPrime], s ∉ p → Algebra.Etale (Localization.AtPrime p) (TensorProduct A (Localization.AtPrime p) (integralClosure A E)) :=
by
  intro A _ s E _ _ _ _ _ _ p _ hs
  have h1 : Submonoid.powers s ≤ p.primeCompl := Submonoid.powers_le.mpr hs
  letI : Algebra (Localization.Away s) (Localization.AtPrime p) :=
    IsLocalization.localizationAlgebraOfSubmonoidLe _ _ (Submonoid.powers s) p.primeCompl h1
  haveI : IsScalarTower A (Localization.Away s) (Localization.AtPrime p) :=
    IsLocalization.localization_isScalarTower_of_submonoid_le _ _ _ _ h1
  haveI : Algebra.IsIntegral (Localization.Away s) E := inferInstance
  haveI : IsLocalization (Algebra.algebraMapSubmonoid (integralClosure A E)
      (Submonoid.powers s)) E := by
    constructor
    constructor
    · rintro ⟨y, hy⟩
      obtain ⟨a, ha, rfl⟩ := hy
      obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp ha
      show IsUnit (algebraMap (integralClosure A E) E
        (algebraMap A (integralClosure A E) (s ^ n)))
      rw [← IsScalarTower.algebraMap_apply, IsScalarTower.algebraMap_apply A (Localization.Away s) E]
      exact IsUnit.map (algebraMap (Localization.Away s) E)
        (IsLocalization.map_units (Localization.Away s)
          (⟨s ^ n, n, rfl⟩ : Submonoid.powers s))
    · intro z
      have hz : IsIntegral (Localization.Away s) z := Algebra.IsIntegral.isIntegral z
      obtain ⟨⟨m, hm⟩, hint⟩ :=
        IsIntegral.exists_multiple_integral_of_isLocalization (Submonoid.powers s) z hz
      refine ⟨⟨⟨m • z, hint⟩, ⟨algebraMap A (integralClosure A E) m, ⟨m, hm, rfl⟩⟩⟩, ?_⟩
      show z * algebraMap (integralClosure A E) E (algebraMap A (integralClosure A E) m) = m • z
      rw [← IsScalarTower.algebraMap_apply, Algebra.smul_def, mul_comm]
    · intro x y hxy
      refine ⟨1, ?_⟩
      have : x = y := Subtype.ext hxy
      rw [this]
  haveI hpo : Algebra.IsPushout A (integralClosure A E) (Localization.Away s) E :=
    Algebra.isPushout_of_isLocalization (Submonoid.powers s) _ _ _
  haveI := hpo.symm
  let eP := Algebra.IsPushout.equiv A (Localization.Away s) (integralClosure A E) E
  let e1 : TensorProduct (Localization.Away s) (Localization.AtPrime p)
      (TensorProduct A (Localization.Away s) (integralClosure A E)) ≃ₐ[Localization.AtPrime p]
      TensorProduct (Localization.Away s) (Localization.AtPrime p) E :=
    Algebra.TensorProduct.congr AlgEquiv.refl eP
  let e2 := Algebra.TensorProduct.cancelBaseChange A (Localization.Away s)
    (Localization.AtPrime p) (Localization.AtPrime p) (integralClosure A E)
  haveI : Algebra.Etale (Localization.AtPrime p)
      (TensorProduct (Localization.Away s) (Localization.AtPrime p) E) :=
    Algebra.Etale.baseChange _ _ _
  exact Algebra.Etale.of_equiv (e1.symm.trans e2)

theorem wc_pps_localize_to_maximal : ∀ (k : ℕ), (∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R] (s : R), s ≠ 0 → ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra (Localization.Away s) E] [IsScalarTower R (Localization.Away s) E] [Algebra.Etale (Localization.Away s) E] [Module.Finite (Localization.Away s) E], (IsLocalRing.maximalIdeal R).height = (k : ℕ∞) → (∀ (q : Ideal R) [q.IsPrime], q < IsLocalRing.maximalIdeal R → Algebra.Etale (Localization.AtPrime q) (TensorProduct R (Localization.AtPrime q) (integralClosure R E))) → Algebra.Etale R (integralClosure R E)) → ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A] [IsDomain A] (s : A), s ≠ 0 → ∀ (E : Type u) [CommRing E] [Algebra A E] [Algebra (Localization.Away s) E] [IsScalarTower A (Localization.Away s) E] [Algebra.Etale (Localization.Away s) E] [Module.Finite (Localization.Away s) E] (p : Ideal A) [p.IsPrime], p.height = (k : ℕ∞) → (∀ (q : Ideal A) [q.IsPrime], q < p → Algebra.Etale (Localization.AtPrime q) (TensorProduct A (Localization.AtPrime q) (integralClosure A E))) → Algebra.Etale (Localization.AtPrime p) (TensorProduct A (Localization.AtPrime p) (integralClosure A E)) :=
by

  have crux : ∀ (A R E : Type u) [CommRing A] [CommRing R] [CommRing E] [Algebra A R]
      [Algebra A E] (M : Submonoid A) [IsLocalization M R],
      Nonempty (integralClosure R (TensorProduct A R E) ≃ₐ[R]
        TensorProduct A R (integralClosure A E)) := by
    intro A R E _ _ _ _ _ M _
    classical
    let C := integralClosure A E
    let ι : C →ₐ[A] E := C.val
    let Φ : TensorProduct A R C →ₐ[R] TensorProduct A R E :=
      Algebra.TensorProduct.map (AlgHom.id R R) ι
    haveI : Module.Flat A R := IsLocalization.flat R M
    have hΦ : ∀ x, Φ x = LinearMap.lTensor R ι.toLinearMap x := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul r c => simp [Φ, Algebra.TensorProduct.map_tmul, LinearMap.lTensor_tmul]
      | add x y hx hy => rw [map_add, map_add, hx, hy]
    have hinj : Function.Injective Φ := by
      have h := Module.Flat.lTensor_preserves_injective_linearMap (M := R) ι.toLinearMap
        Subtype.val_injective
      intro a b hab
      apply h
      rw [← hΦ, ← hΦ]
      exact hab
    haveI hloc : IsLocalizedModule M (TensorProduct.mk A R E 1) :=
      IsLocalization.tensorProduct_isLocalizedModule M R
    have descent : ∀ e : E, IsIntegral R ((1 : R) ⊗ₜ[A] e) →
        ∃ n : M, IsIntegral A ((n : A) • e) := by
      intro e he
      obtain ⟨m1, hm1⟩ := IsIntegral.exists_multiple_integral_of_isLocalization M
        ((1 : R) ⊗ₜ[A] e) he
      have h1 : (m1 • ((1 : R) ⊗ₜ[A] e) : TensorProduct A R E) = (1 : R) ⊗ₜ[A] ((m1 : A) • e) := by
        rw [Submonoid.smul_def, TensorProduct.tmul_smul]
      rw [h1] at hm1
      set y := (m1 : A) • e with hy
      obtain ⟨P, hPm, hP⟩ := hm1
      have h2 : (TensorProduct.mk A R E 1) (Polynomial.aeval y P) =
          (TensorProduct.mk A R E 1) 0 := by
        rw [TensorProduct.mk_apply, map_zero, ← Algebra.TensorProduct.includeRight_apply,
          ← Polynomial.aeval_algHom_apply, Algebra.TensorProduct.includeRight_apply,
          Polynomial.aeval_def]
        exact hP
      obtain ⟨m2, hm2⟩ := IsLocalizedModule.exists_of_eq (S := M) h2
      rw [smul_zero, Submonoid.smul_def, Algebra.smul_def, Polynomial.aeval_def] at hm2
      refine ⟨m2 * m1, ?_⟩
      have h3 : ((m2 * m1 : M) : A) • e = algebraMap A E (m2 : A) * y := by
        rw [hy, ← Algebra.smul_def, smul_smul]
        rfl
      rw [h3]
      rcases subsingleton_or_nontrivial E with hE | hE
      · rw [Subsingleton.elim (algebraMap A E (m2 : A) * y) 0]
        exact isIntegral_zero
      haveI : Nontrivial A := (algebraMap A E).domain_nontrivial
      refine ⟨(Polynomial.X * P).scaleRoots (m2 : A),
        (Polynomial.monic_scaleRoots_iff _).mpr (Polynomial.monic_X.mul hPm), ?_⟩
      rw [Polynomial.scaleRoots_eval₂_mul, Polynomial.eval₂_mul, Polynomial.eval₂_X,
        Polynomial.natDegree_X_mul hPm.ne_zero, pow_succ]
      calc algebraMap A E (m2 : A) ^ P.natDegree * algebraMap A E (m2 : A) *
            (y * Polynomial.eval₂ (algebraMap A E) y P)
          = algebraMap A E (m2 : A) ^ P.natDegree * y *
            (algebraMap A E (m2 : A) * Polynomial.eval₂ (algebraMap A E) y P) := by ring
        _ = 0 := by rw [hm2, mul_zero]
    have hle : Φ.range ≤ integralClosure R (TensorProduct A R E) := by
      rintro _ ⟨z, rfl⟩
      show Φ z ∈ _
      rw [mem_integralClosure_iff]
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero]; exact isIntegral_zero
      | tmul r c =>
        have hc : IsIntegral A (c : E) := c.2
        have e1 : Φ (r ⊗ₜ[A] c) = algebraMap R (TensorProduct A R E) r *
            Algebra.TensorProduct.includeRight (c : E) := by
          simp [Φ, ι, Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.algebraMap_apply,
            Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.tmul_mul_tmul]
        rw [e1]
        exact (isIntegral_algebraMap).mul
          (IsIntegral.tower_top (A := R) (hc.map (Algebra.TensorProduct.includeRight)))
      | add x y hx hy => rw [map_add]; exact hx.add hy
    have hge : integralClosure R (TensorProduct A R E) ≤ Φ.range := by
      intro x hx
      rw [mem_integralClosure_iff] at hx
      obtain ⟨⟨e, m⟩, hm⟩ := IsLocalizedModule.surj M (TensorProduct.mk A R E 1) x
      simp only [TensorProduct.mk_apply] at hm
      have hm' : (m : A) • x = (1 : R) ⊗ₜ[A] e := by rw [← Submonoid.smul_def]; exact hm
      have hmx : IsIntegral R ((m : A) • x) := hx.smul (m : A)
      rw [hm'] at hmx
      obtain ⟨n, hn⟩ := descent e hmx
      let c : C := ⟨(n : A) • e, hn⟩
      have hu : IsUnit (algebraMap A R ((n : A) * (m : A))) :=
        IsLocalization.map_units R (n * m)
      refine ⟨(↑hu.unit⁻¹ : R) ⊗ₜ[A] c, ?_⟩
      have e1 : (↑hu.unit⁻¹ : R) ⊗ₜ[A] c = (↑hu.unit⁻¹ : R) • ((1 : R) ⊗ₜ[A] c) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      have e2 : Φ ((1 : R) ⊗ₜ[A] c) = algebraMap A R ((n : A) * (m : A)) • x := by
        have e3 : Φ ((1 : R) ⊗ₜ[A] c) = (1 : R) ⊗ₜ[A] ((n : A) • e) := rfl
        rw [e3, TensorProduct.tmul_smul, ← hm', smul_smul, IsScalarTower.algebraMap_smul]
      show Φ _ = x
      rw [e1, map_smul, e2, smul_smul, IsUnit.val_inv_mul, one_smul]
    have hrange : Φ.range = integralClosure R (TensorProduct A R E) := le_antisymm hle hge
    exact ⟨((AlgEquiv.ofInjective Φ hinj).trans (Subalgebra.equivOfEq _ _ hrange)).symm⟩

  have transport : ∀ (A B B' D : Type u) [CommRing A] [CommRing B] [CommRing B'] [CommRing D]
      [Algebra A B] [Algebra A B'] [Algebra A D], (B ≃ₐ[A] B') →
      Algebra.Etale B (TensorProduct A B D) → Algebra.Etale B' (TensorProduct A B' D) := by
    intro A B B' D _ _ _ _ _ _ _ σ h
    letI : Algebra B B' := σ.toRingHom.toAlgebra
    haveI : IsScalarTower A B B' := IsScalarTower.of_algebraMap_eq (fun a => (σ.commutes a).symm)
    haveI : Algebra.Etale B' (TensorProduct B B' (TensorProduct A B D)) :=
      Algebra.Etale.baseChange B (TensorProduct A B D) B'
    exact Algebra.Etale.of_equiv (Algebra.TensorProduct.cancelBaseChange A B B' B' D)
  intro k MAXPUR A _ _ _ s hs E _ _ _ _ _ _ p _ hp hET
  haveI hRreg : IsRegularLocalRing (Localization.AtPrime p) :=
    wc_hnas_pfc_regular_localization A ‹_› p
  have hs' : algebraMap A (Localization.AtPrime p) s ≠ 0 := by
    intro h0
    apply hs
    apply IsLocalization.injective (Localization.AtPrime p) (Ideal.primeCompl_le_nonZeroDivisors p)
    rw [h0, map_zero]
  obtain ⟨algL, towerL, hetL, hfinL⟩ := wc_pub_cover_baseChange A (Localization.AtPrime p) E s
  letI := algL
  haveI := towerL
  haveI := hetL
  haveI := hfinL
  have hunder : Ideal.comap (algebraMap A (Localization.AtPrime p))
      (IsLocalRing.maximalIdeal (Localization.AtPrime p)) = p :=
    Localization.AtPrime.under_maximalIdeal
  have hheight : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).height = (k : ℕ∞) := by
    rw [← IsLocalization.height_under p.primeCompl (IsLocalRing.maximalIdeal (Localization.AtPrime p))]
    rw [← hp]
    exact congrArg Ideal.height hunder
  obtain ⟨e₁⟩ := crux A (Localization.AtPrime p) E p.primeCompl
  have hQ : ∀ (Q : Ideal (Localization.AtPrime p)) [Q.IsPrime],
      Q < IsLocalRing.maximalIdeal (Localization.AtPrime p) →
      Algebra.Etale (Localization.AtPrime Q) (TensorProduct (Localization.AtPrime p)
        (Localization.AtPrime Q) (integralClosure (Localization.AtPrime p)
          (TensorProduct A (Localization.AtPrime p) E))) := by
    intro Q _ hQm
    have hqp : Ideal.comap (algebraMap A (Localization.AtPrime p)) Q < p := by
      have hle : Ideal.comap (algebraMap A (Localization.AtPrime p)) Q ≤ p :=
        (Ideal.comap_mono hQm.le).trans hunder.le
      refine lt_of_le_of_ne hle ?_
      intro heq
      apply ne_of_lt hQm
      have h1 := IsLocalization.map_under p.primeCompl (Localization.AtPrime p) Q
      have h2 := IsLocalization.map_under p.primeCompl (Localization.AtPrime p)
        (IsLocalRing.maximalIdeal (Localization.AtPrime p))
      calc Q = Ideal.map (algebraMap A (Localization.AtPrime p))
            (Ideal.under A Q) := h1.symm
        _ = Ideal.map (algebraMap A (Localization.AtPrime p))
            (Ideal.under A (IsLocalRing.maximalIdeal (Localization.AtPrime p))) :=
          congrArg (Ideal.map (algebraMap A (Localization.AtPrime p))) (heq.trans hunder.symm)
        _ = IsLocalRing.maximalIdeal (Localization.AtPrime p) := h2
    have hq := hET _ hqp
    have σ := IsLocalization.localizationLocalizationAtPrimeIsoLocalization p.primeCompl Q
    have h3 : Algebra.Etale (Localization.AtPrime Q)
        (TensorProduct A (Localization.AtPrime Q) (integralClosure A E)) :=
      transport A _ _ _ σ hq
    have ψ : TensorProduct (Localization.AtPrime p) (Localization.AtPrime Q)
        (integralClosure (Localization.AtPrime p) (TensorProduct A (Localization.AtPrime p) E))
        ≃ₐ[Localization.AtPrime Q]
        TensorProduct A (Localization.AtPrime Q) (integralClosure A E) :=
      (Algebra.TensorProduct.congr AlgEquiv.refl e₁).trans
        (Algebra.TensorProduct.cancelBaseChange A (Localization.AtPrime p) (Localization.AtPrime Q)
          (Localization.AtPrime Q) (integralClosure A E))
    exact @Algebra.Etale.of_equiv (Localization.AtPrime Q)
      (TensorProduct A (Localization.AtPrime Q) (integralClosure A E)) _ _ _ _ _ _ h3 ψ.symm
  haveI := MAXPUR (Localization.AtPrime p) (algebraMap A (Localization.AtPrime p) s) hs'
    (TensorProduct A (Localization.AtPrime p) E) hheight hQ
  exact Algebra.Etale.of_equiv e₁

theorem wc_pps_free_punctured_etale : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [IsDomain R], 2 ≤ (IsLocalRing.maximalIdeal R).height → ∀ (C : Type u) [CommRing C] [Algebra R C] [Module.Free R C] [Module.Finite R C], (∀ (q : Ideal R) [q.IsPrime], q < IsLocalRing.maximalIdeal R → Algebra.Etale (Localization.AtPrime q) (TensorProduct R (Localization.AtPrime q) C)) → Algebra.Etale R C :=
by
  have t_s2 (R S B : Type u) [CommRing R] [CommRing S] [CommRing B] [Algebra R S] [Algebra R B] (n : ℕ) (b : Module.Basis (Fin n) R B) :
      Algebra.discr S ⇑(Algebra.TensorProduct.basis S b) = algebraMap R S (Algebra.discr R ⇑b) := by
    classical
    haveI := Module.Free.of_basis b
    haveI := Module.Finite.of_basis b
    have htr : ∀ x : B, Algebra.trace S (TensorProduct R S B) (TensorProduct.tmul R (1 : S) x) = algebraMap R S (Algebra.trace R B x) := by
      intro x
      rw [Algebra.trace_apply, Algebra.trace_apply, ← Algebra.baseChange_lmul, LinearMap.trace_baseChange]
    rw [Algebra.discr_def, Algebra.discr_def, RingHom.map_det]
    congr 1
    ext i j
    simp only [Algebra.traceMatrix_apply, RingHom.mapMatrix_apply, Matrix.map_apply, Algebra.traceForm_apply,
      Algebra.TensorProduct.basis_apply, Algebra.TensorProduct.tmul_mul_tmul, one_mul, htr]
  have t_s4 (R C : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [CommRing C] [Algebra R C]
      [Module.Free R C] [Module.Finite R C]
      (h : Algebra.Etale (IsLocalRing.ResidueField R) (TensorProduct R (IsLocalRing.ResidueField R) C)) :
      Algebra.Etale R C := by
    classical
    haveI : Algebra.FinitePresentation R C := Algebra.FinitePresentation.of_finiteType.mp inferInstance
    have hk : Subsingleton (Ω[(TensorProduct R (IsLocalRing.ResidueField R) C)⁄(IsLocalRing.ResidueField R)]) :=
      Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
    letI : Algebra C (TensorProduct R (IsLocalRing.ResidueField R) C) := Algebra.TensorProduct.rightAlgebra
    have hbc := KaehlerDifferential.isBaseChange R (IsLocalRing.ResidueField R) C
      (TensorProduct R (IsLocalRing.ResidueField R) C)
    have h1 : Subsingleton (TensorProduct R (IsLocalRing.ResidueField R) (Ω[C⁄R])) :=
      hbc.equiv.toEquiv.subsingleton
    have h2 : Subsingleton ((Ω[C⁄R]) ⧸ (IsLocalRing.maximalIdeal R • (⊤ : Submodule R (Ω[C⁄R])))) :=
      @Equiv.subsingleton _ _ (TensorProduct.quotTensorEquivQuotSMul (Ω[C⁄R]) (IsLocalRing.maximalIdeal R)).symm.toEquiv h1
    rw [Submodule.Quotient.subsingleton_iff] at h2
    haveI : Module.Finite R (Ω[C⁄R]) := Module.Finite.trans C _
    have h3 : (⊤ : Submodule R (Ω[C⁄R])) = ⊥ :=
      Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ ⊤ Module.Finite.fg_top h2.ge
        (IsLocalRing.maximalIdeal_le_jacobson ⊥)
    haveI : Subsingleton (Ω[C⁄R]) := subsingleton_of_forall_eq 0 (fun x => by
      have hx : x ∈ (⊤ : Submodule R (Ω[C⁄R])) := trivial
      rw [h3] at hx
      exact hx)
    haveI : Algebra.FormallyUnramified R C := (Algebra.formallyUnramified_iff R C).mpr inferInstance
    exact Algebra.Etale.of_formallyUnramified_of_flat
  have t_T (K I : Type u) [Field K] [Fintype I] [DecidableEq I] (Ai : I → Type u) [∀ i, Field (Ai i)]
      [∀ i, Algebra K (Ai i)] [∀ i, Module.Finite K (Ai i)] (i : I) (w : Ai i) :
      Algebra.trace K (∀ j, Ai j) (Pi.single i w) = Algebra.trace K (Ai i) w := by
    have hl : Algebra.lmul K (∀ j, Ai j) (Pi.single i w) =
        LinearMap.single K Ai i ∘ₗ (Algebra.lmul K (Ai i) w ∘ₗ LinearMap.proj i) := by
      apply LinearMap.ext
      intro v
      show Pi.single i w * v = Pi.single i (w * v i)
      exact (Pi.single_mul_left w).symm
    rw [Algebra.trace_apply, Algebra.trace_apply, hl, LinearMap.trace_comp_comm', LinearMap.comp_assoc,
      LinearMap.proj_comp_single_same, LinearMap.comp_id]
  have t_s3 : ∀ (K A : Type u) [Field K] [CommRing A] [Algebra K A] [Algebra.Etale K A] (n : ℕ) (b : Module.Basis (Fin n) K A), Algebra.discr K ⇑b ≠ 0 := by
    intro K A _ _ _ hA n b
    classical
    obtain ⟨I, hI, Ai, hF, hAlg, e, hsep⟩ := (Algebra.Etale.iff_exists_algEquiv_prod K A).mp hA
    haveI := Fintype.ofFinite I
    haveI : ∀ i, Module.Finite K (Ai i) := fun i => (hsep i).1
    haveI : ∀ i, Algebra.IsSeparable K (Ai i) := fun i => (hsep i).2
    have H : ∀ x : A, (∀ y : A, Algebra.trace K A (x * y) = 0) → x = 0 := by
      intro x hx
      have hex : e x = 0 := by
        funext i
        have hnd := (traceForm_nondegenerate K (Ai i)).1
        apply hnd
        intro z
        rw [Algebra.traceForm_apply]
        have h1 := hx (e.symm (Pi.single i z))
        rw [← Algebra.trace_eq_of_algEquiv e, map_mul, AlgEquiv.apply_symm_apply,
          ← Pi.single_mul_right, t_T] at h1
        simpa using h1
      simpa using congrArg e.symm hex
    have hnd : (Algebra.traceForm K A).Nondegenerate := by
      refine ⟨fun x hx => H x (fun y => by simpa [Algebra.traceForm_apply] using hx y),
        fun y hy => H y (fun x => by
          have := hy x
          rw [Algebra.traceForm_apply, mul_comm] at this
          exact this)⟩
    rw [Algebra.discr_def, Algebra.traceMatrix_of_basis]
    exact (LinearMap.BilinForm.nondegenerate_iff_det_ne_zero b).mp hnd
  have t_s5 : ∀ (K A : Type u) [Field K] [CommRing A] [Algebra K A] (n : ℕ) (b : Module.Basis (Fin n) K A), Algebra.discr K ⇑b ≠ 0 → Algebra.Etale K A := by
    intro K A _ _ _ n b hb
    classical
    haveI := Module.Finite.of_basis b
    rw [Algebra.discr_def, Algebra.traceMatrix_of_basis] at hb
    have hnd := ((LinearMap.BilinForm.nondegenerate_iff_det_ne_zero b).mpr hb).1
    have H : ∀ x : A, (∀ y : A, Algebra.trace K A (x * y) = 0) → x = 0 := by
      intro x hx
      exact hnd x (fun y => by rw [Algebra.traceForm_apply]; exact hx y)
    haveI : IsReduced A := ⟨fun x hx => H x (fun y => by
      have h1 : IsNilpotent (x * y) := Commute.isNilpotent_mul_right (Commute.all x y) hx
      have h2 : IsNilpotent (Algebra.lmul K A (x * y)) := h1.map (Algebra.lmul K A)
      have h3 := LinearMap.isNilpotent_trace_of_isNilpotent h2
      rw [← Algebra.trace_apply] at h3
      exact h3.eq_zero)⟩
    haveI : IsArtinianRing A := IsArtinianRing.of_finite K A
    let e : A ≃ₐ[K] ((M : MaximalSpectrum A) → A ⧸ M.asIdeal) :=
      (IsArtinianRing.equivPi A).restrictScalars K
    haveI := Fintype.ofFinite (MaximalSpectrum A)
    letI hF : ∀ M : MaximalSpectrum A, Field (A ⧸ M.asIdeal) :=
      fun M => @Ideal.Quotient.field _ _ M.asIdeal M.isMaximal
    have hfin : ∀ M : MaximalSpectrum A, Module.Finite K (A ⧸ M.asIdeal) := fun M =>
      Module.Finite.of_surjective (Ideal.Quotient.mkₐ K M.asIdeal).toLinearMap
        (Ideal.Quotient.mkₐ_surjective K M.asIdeal)
    have hsep : ∀ M : MaximalSpectrum A, Algebra.IsSeparable K (A ⧸ M.asIdeal) := by
      intro M
      by_contra hns
      have htr := Algebra.trace_eq_zero_of_not_isSeparable hns
      have hx := H (e.symm (Pi.single M 1)) (fun y => by
        rw [← Algebra.trace_eq_of_algEquiv e, map_mul, AlgEquiv.apply_symm_apply,
          ← Pi.single_mul_left, one_mul, t_T, htr]
        rfl)
      have h1 : (Pi.single M (1 : A ⧸ M.asIdeal) : (M : MaximalSpectrum A) → A ⧸ M.asIdeal) = 0 := by
        simpa using congrArg e hx
      have h2 := congrFun h1 M
      simp at h2
    exact (Algebra.Etale.iff_exists_algEquiv_prod K A).mpr
      ⟨MaximalSpectrum A, inferInstance, fun M => A ⧸ M.asIdeal, hF, inferInstance, e,
        fun M => ⟨hfin M, hsep M⟩⟩
  intro R _ _ _ _ hht C _ _ _ _ hq
  classical
  set b := Module.finBasis R C
  set δ := Algebra.discr R ⇑b with hδ
  have s6 : ∀ (q : Ideal R) [q.IsPrime], q < IsLocalRing.maximalIdeal R → δ ∉ q := by
    intro q _ hlt
    haveI := hq q hlt
    have e1 : Algebra.discr (Localization.AtPrime q) ⇑(Algebra.TensorProduct.basis (Localization.AtPrime q) b) =
        algebraMap R (Localization.AtPrime q) δ := t_s2 R _ C _ b
    haveI : Algebra.Etale (IsLocalRing.ResidueField (Localization.AtPrime q))
        (TensorProduct (Localization.AtPrime q) (IsLocalRing.ResidueField (Localization.AtPrime q))
          (TensorProduct R (Localization.AtPrime q) C)) :=
      Algebra.Etale.baseChange (Localization.AtPrime q) _ _
    have e2 := t_s2 (Localization.AtPrime q) (IsLocalRing.ResidueField (Localization.AtPrime q)) _ _
      (Algebra.TensorProduct.basis (Localization.AtPrime q) b)
    have e3 := t_s3 (IsLocalRing.ResidueField (Localization.AtPrime q))
      (TensorProduct (Localization.AtPrime q) (IsLocalRing.ResidueField (Localization.AtPrime q))
          (TensorProduct R (Localization.AtPrime q) C)) _
      (Algebra.TensorProduct.basis (IsLocalRing.ResidueField (Localization.AtPrime q))
        (Algebra.TensorProduct.basis (Localization.AtPrime q) b))
    rw [e2, e1, IsLocalRing.ResidueField.algebraMap_eq, Ne, IsLocalRing.residue_eq_zero_iff] at e3
    rwa [IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime q) q δ] at e3
  have s7 : IsUnit δ := by
    by_contra hnu
    have hδm : δ ∈ IsLocalRing.maximalIdeal R := (IsLocalRing.mem_maximalIdeal δ).mpr hnu
    obtain ⟨Q, hQ, hQle⟩ := Ideal.exists_minimalPrimes_le ((Ideal.span_singleton_le_iff_mem _).mpr hδm)
    haveI hQp : Q.IsPrime := hQ.1.1
    have hδQ : δ ∈ Q := (Ideal.span_singleton_le_iff_mem _).mp hQ.1.2
    have hQh : Q.height ≤ 1 := Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ Q hQ
    have hne : Q ≠ IsLocalRing.maximalIdeal R := by
      rintro rfl
      have h21 := hht.trans hQh
      norm_num at h21
    exact s6 Q (lt_of_le_of_ne hQle hne) hδQ
  have e : Algebra.discr (IsLocalRing.ResidueField R)
      ⇑(Algebra.TensorProduct.basis (IsLocalRing.ResidueField R) b) = algebraMap R _ δ := t_s2 _ _ _ _ b
  have hne : Algebra.discr (IsLocalRing.ResidueField R)
      ⇑(Algebra.TensorProduct.basis (IsLocalRing.ResidueField R) b) ≠ 0 := by
    rw [e]; exact (s7.map _).ne_zero
  haveI := t_s5 _ _ _ _ hne
  exact t_s4 R C inferInstance

theorem wc_pd2_regular_dim2_prime_pid : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R], (IsLocalRing.maximalIdeal R).height = 2 → ∃ x : R, x ∈ IsLocalRing.maximalIdeal R ∧ Prime x ∧ IsPrincipalIdealRing (R ⧸ Ideal.span {x}) :=
by
  intro R _ _ hm
  classical
  haveI : IsNoetherianRing R := IsRegularLocalRing.toIsNoetherian
  have hdim : ((IsLocalRing.maximalIdeal R).height : WithBot ℕ∞) = ringKrullDim R :=
    IsLocalRing.maximalIdeal_height_eq_ringKrullDim
  have hsf : ((Submodule.spanFinrank (IsLocalRing.maximalIdeal R) : ℕ) : WithBot ℕ∞) =
      ringKrullDim R := IsRegularLocalRing.spanFinrank_maximalIdeal
  have h2 : Submodule.spanFinrank (IsLocalRing.maximalIdeal R) = 2 := by
    rw [← hdim, hm] at hsf
    exact_mod_cast hsf
  have hm_ne : ¬ IsLocalRing.maximalIdeal R ≤ IsLocalRing.maximalIdeal R ^ 2 := by
    intro hle
    have hle' : IsLocalRing.maximalIdeal R ≤ IsLocalRing.maximalIdeal R • IsLocalRing.maximalIdeal R := by
      rwa [Ideal.smul_eq_mul, ← sq]
    have hbot : IsLocalRing.maximalIdeal R = ⊥ :=
      Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ _ (IsNoetherian.noetherian _) hle'
        (IsLocalRing.maximalIdeal_le_jacobson ⊥)
    rw [hbot, Submodule.spanFinrank_bot] at h2
    omega
  obtain ⟨x, hxm, hxm2⟩ := SetLike.not_le_iff_exists.mp hm_ne
  have hx0 : x ≠ 0 := by
    rintro rfl
    exact hxm2 (Ideal.zero_mem _)
  obtain ⟨hloc, hemb⟩ := wc_rl_quot_embdim R x hxm hxm2
  have hreg : IsRegularLocalRing (R ⧸ Ideal.span {x}) :=
    (wc_rl_quot_regular wc_rl_quot_embdim R inferInstance x hxm hxm2).1
  haveI := hreg
  have h1' : Submodule.spanFinrank (IsLocalRing.maximalIdeal (R ⧸ Ideal.span {x})) + 1 = 2 :=
    hemb.trans h2
  have h1 : Submodule.spanFinrank (IsLocalRing.maximalIdeal (R ⧸ Ideal.span {x})) = 1 := by
    omega
  haveI : IsNoetherianRing (R ⧸ Ideal.span {x}) := IsRegularLocalRing.toIsNoetherian
  haveI : IsDomain (R ⧸ Ideal.span {x}) :=
    wc_rl_isDomain wc_rl_quot_embdim (wc_rl_quot_regular wc_rl_quot_embdim) _ hreg
  have hprime : (Ideal.span {x}).IsPrime :=
    (Ideal.Quotient.isDomain_iff_prime _).mp inferInstance
  have hx : Prime x := (Ideal.span_singleton_prime hx0).mp hprime
  have hFG : (IsLocalRing.maximalIdeal (R ⧸ Ideal.span {x})).FG := IsNoetherian.noetherian _
  obtain ⟨T, hT, hspan⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank hFG
  rw [h1] at hT
  obtain ⟨y, rfl⟩ := Set.encard_eq_one.mp (by simpa using hT)
  have hprin : (IsLocalRing.maximalIdeal (R ⧸ Ideal.span {x})).IsPrincipal := ⟨⟨y, hspan.symm⟩⟩
  have hnf : ¬ IsField (R ⧸ Ideal.span {x}) := by
    intro hf
    have h0 := IsLocalRing.isField_iff_maximalIdeal_eq.mp hf
    rw [h0, Submodule.spanFinrank_bot] at h1
    omega
  haveI : IsDiscreteValuationRing (R ⧸ Ideal.span {x}) :=
    ((IsDiscreteValuationRing.TFAE (R ⧸ Ideal.span {x}) hnf).out 5 1).mp hprin
  exact ⟨x, hxm, hx, inferInstance⟩

theorem wc_pd2_flat_div_prime : ∀ (R : Type u) [CommRing R] [IsDomain R] (s : R), s ≠ 0 → ∀ (F : Type u) [CommRing F] [Algebra R F] [Algebra (Localization.Away s) F] [IsScalarTower R (Localization.Away s) F] [Module.Flat (Localization.Away s) F], (∀ a : R, a ≠ 0 → IsSMulRegular F a) ∧ ∀ (x r : R) (c c' : F), Prime x → ¬ x ∣ r → r • c = x • c' → ∃ d : F, c = x • d :=
by
  intro R _ _ s hs F _ _ _ _ _
  classical
  have hle : Submonoid.powers s ≤ nonZeroDivisors R :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hs
  have hinj : Function.Injective (algebraMap R (Localization.Away s)) :=
    IsLocalization.injective (Localization.Away s) hle
  have : IsDomain (Localization.Away s) :=
    IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away s) hle

  have s1 : ∀ (x r : R), Prime x → ¬ x ∣ r → ∀ α β : Localization.Away s,
      algebraMap R (Localization.Away s) r * α = algebraMap R (Localization.Away s) x * β →
      ∃ e : Localization.Away s, α = algebraMap R (Localization.Away s) x * e := by
    intro x r hx hr α β h
    obtain ⟨n, a, ha⟩ := IsLocalization.Away.surj s α
    obtain ⟨m, b, hb⟩ := IsLocalization.Away.surj s β
    have key : r * a * s ^ m = x * b * s ^ n := by
      apply hinj
      simp only [map_mul, map_pow]
      linear_combination (-(algebraMap R (Localization.Away s) r *
          algebraMap R (Localization.Away s) s ^ m)) * ha +
        (algebraMap R (Localization.Away s) x * algebraMap R (Localization.Away s) s ^ n) * hb +
        (algebraMap R (Localization.Away s) s ^ n * algebraMap R (Localization.Away s) s ^ m) * h
    have hdvd : x ∣ r * a * s ^ m := ⟨b * s ^ n, by rw [key]; ring⟩
    rcases hx.dvd_or_dvd hdvd with h1 | h1
    · rcases hx.dvd_or_dvd h1 with h2 | h2
      · exact absurd h2 hr
      · obtain ⟨a', rfl⟩ := h2
        have hu : IsUnit (algebraMap R (Localization.Away s) s ^ n) :=
          (IsLocalization.Away.algebraMap_isUnit s).pow n
        refine ⟨algebraMap R (Localization.Away s) a' * ↑hu.unit⁻¹, ?_⟩
        calc α = α * algebraMap R (Localization.Away s) s ^ n * ↑hu.unit⁻¹ := by
              rw [mul_assoc, IsUnit.mul_val_inv, mul_one]
          _ = _ := by rw [ha, map_mul]; ring
    · obtain ⟨t, ht⟩ := hx.dvd_of_dvd_pow h1
      have hsu : IsUnit (algebraMap R (Localization.Away s) s) :=
        IsLocalization.Away.algebraMap_isUnit s
      have hsx : algebraMap R (Localization.Away s) s =
          algebraMap R (Localization.Away s) x * algebraMap R (Localization.Away s) t := by
        rw [← map_mul, ← ht]
      rw [hsx] at hsu
      have hxu : IsUnit (algebraMap R (Localization.Away s) x) := isUnit_of_mul_isUnit_left hsu
      exact ⟨↑hxu.unit⁻¹ * α, by rw [← mul_assoc, IsUnit.mul_val_inv, one_mul]⟩

  have s2 : ∀ (u v : Localization.Away s),
      (∀ α β : Localization.Away s, u * α = v * β → ∃ e : Localization.Away s, α = v * e) →
      ∀ (c c' : F), u • c = v • c' → ∃ d : F, c = v • d := by
    intro u v huv c c' h
    obtain ⟨k, a, y, hxy, hrel⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
      (R := Localization.Away s) (M := F) (f := ![u, -v]) (x := ![c, c'])
      (by
        rw [Fin.sum_univ_two]
        simp only [Matrix.cons_val_zero, Matrix.cons_val_one, neg_smul]
        rw [← sub_eq_add_neg, sub_eq_zero]
        exact h)
    have hj : ∀ j, ∃ e : Localization.Away s, a 0 j = v * e := by
      intro j
      have h0 := hrel j
      rw [Fin.sum_univ_two] at h0
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h0
      exact huv (a 0 j) (a 1 j) (by linear_combination h0)
    choose e he using hj
    refine ⟨∑ j, e j • y j, ?_⟩
    have h0 := hxy 0
    simp only [Matrix.cons_val_zero] at h0
    rw [h0, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [smul_smul, he j]
  refine ⟨?_, ?_⟩
  · intro a ha
    have ha' : algebraMap R (Localization.Away s) a ∈ nonZeroDivisors (Localization.Away s) :=
      mem_nonZeroDivisors_of_ne_zero ((map_ne_zero_iff _ hinj).mpr ha)
    have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := F) ha'
    intro c₁ c₂ h
    apply hreg
    show algebraMap R (Localization.Away s) a • c₁ = algebraMap R (Localization.Away s) a • c₂
    rw [algebraMap_smul, algebraMap_smul]
    exact h
  · intro x r c c' hx hr h
    have h' : algebraMap R (Localization.Away s) r • c = algebraMap R (Localization.Away s) x • c' := by
      rw [algebraMap_smul, algebraMap_smul]; exact h
    obtain ⟨d, hd⟩ := s2 _ _ (s1 x r hx hr) c c' h'
    exact ⟨d, by rw [hd, algebraMap_smul]⟩

theorem wc_pd2_integral_of_coprime_multiples : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] (F : Type u) [CommRing F] [Algebra R F], (∀ a : R, a ≠ 0 → IsSMulRegular F a) → ∀ (x r : R) (d : F), Prime x → ¬ x ∣ r → IsIntegral R (x • d) → IsIntegral R (r • d) → IsIntegral R d :=
by
  intro R _ _ _ F _ _ hreg x r d hx hr hxd hrd
  classical

  let K := FractionRing R
  let L := Localization (Algebra.algebraMapSubmonoid F (nonZeroDivisors R))
  have hinjK : Function.Injective (algebraMap R K) := IsFractionRing.injective R K

  have s1 : ∀ (c : K) (e : ℕ), (∃ a : R, algebraMap R K a = c * algebraMap R K x ^ e) →
      (∃ b : R, algebraMap R K b = c * algebraMap R K r ^ e) → ∃ t : R, algebraMap R K t = c := by
    intro c e ha hb
    obtain ⟨a, ha⟩ := ha
    obtain ⟨b, hb⟩ := hb
    have h1 : r ^ e * a = x ^ e * b := by
      apply hinjK
      simp only [map_mul, map_pow, ha, hb]; ring
    have h2 : ¬ x ∣ r ^ e := fun h => hr (hx.dvd_of_dvd_pow h)
    have h3 : x ^ e ∣ a := hx.pow_dvd_of_dvd_mul_left e h2 ⟨b, h1⟩
    obtain ⟨t, rfl⟩ := h3
    refine ⟨t, ?_⟩
    have hx0 : algebraMap R K x ≠ 0 := by
      rw [Ne, ← map_zero (algebraMap R K)]; exact fun h => hx.ne_zero (hinjK h)
    have : algebraMap R K x ^ e * algebraMap R K t = algebraMap R K x ^ e * c := by
      rw [← map_pow, ← map_mul, ha, map_pow]; ring
    exact mul_left_cancel₀ (pow_ne_zero e hx0) this

  have s2 : ∀ (s : R) (δ : L), s ≠ 0 → IsIntegral R (s • δ) → IsIntegral K δ ∧ ∀ j : ℕ,
      ∃ a : R, algebraMap R K a =
        (minpoly K δ).coeff j * algebraMap R K s ^ ((minpoly K δ).natDegree - j) := by
    intro s δ hs hsd
    set σ := algebraMap R K s with hσ
    have hσ0 : σ ≠ 0 := by
      rw [hσ, Ne, ← map_zero (algebraMap R K)]; exact fun h => hs (hinjK h)
    have hsmul : ∀ y : L, σ • y = s • y := fun y => algebraMap_smul K s y
    have hδK : IsIntegral K δ := by
      have h1 : IsIntegral K (s • δ) := hsd.tower_top
      have h2 : IsIntegral K (σ⁻¹ • (s • δ)) := h1.smul σ⁻¹
      rwa [← hsmul, smul_smul, inv_mul_cancel₀ hσ0, one_smul] at h2
    refine ⟨hδK, ?_⟩
    intro j
    set m := minpoly K δ with hm
    set f := minpoly R (s • δ) with hf
    have hfmon : f.Monic := minpoly.monic hsd
    set F' := f.map (algebraMap R K) with hF'
    set G := F'.comp (Polynomial.C σ * Polynomial.X) with hG
    have hGδ : Polynomial.aeval δ G = 0 := by
      rw [hG, Polynomial.aeval_comp]
      have : Polynomial.aeval δ (Polynomial.C σ * Polynomial.X) = s • δ := by
        rw [map_mul, Polynomial.aeval_C, Polynomial.aeval_X, ← Algebra.smul_def, hsmul]
      rw [this, hF', Polynomial.aeval_map_algebraMap, hf, minpoly.aeval]
    have hmG : m ∣ G := minpoly.dvd K δ hGδ
    have hGs : G.scaleRoots σ = Polynomial.C (σ ^ F'.natDegree) * F' := by
      have hdeg : G.natDegree = F'.natDegree := by
        rw [hG, Polynomial.natDegree_comp, Polynomial.natDegree_C_mul_X σ hσ0, mul_one]
      ext i
      rw [Polynomial.coeff_scaleRoots, hdeg, Polynomial.coeff_C_mul, hG,
        Polynomial.comp_C_mul_X_coeff]
      by_cases hi : i ≤ F'.natDegree
      · rw [mul_assoc, ← pow_add, Nat.add_sub_cancel' hi, mul_comm]
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (not_le.mp hi)]; simp
    have hdvd1 : m.scaleRoots σ ∣ Polynomial.C (σ ^ F'.natDegree) * F' := by
      rw [← hGs]; exact Polynomial.scaleRoots_dvd _ _ hmG
    have hdvd2 : m.scaleRoots σ ∣ F' :=
      (Polynomial.isUnit_C.mpr (pow_ne_zero _ hσ0).isUnit).dvd_mul_left.mp hdvd1
    have hmmon : m.Monic := minpoly.monic hδK
    have hmsmon : (m.scaleRoots σ).Monic := (Polynomial.monic_scaleRoots_iff σ).mpr hmmon
    have hint := Polynomial.isIntegral_coeff_of_dvd f (m.scaleRoots σ) hfmon hmsmon hdvd2 j
    rw [Polynomial.coeff_scaleRoots] at hint
    obtain ⟨a, ha⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    exact ⟨a, ha⟩

  have s3 : Function.Injective (algebraMap F L) := by
    apply IsLocalization.injective (M := Algebra.algebraMapSubmonoid F (nonZeroDivisors R))
    rintro _ ⟨a, ha, rfl⟩
    have ha0 : a ≠ 0 := nonZeroDivisors.ne_zero ha
    rw [mem_nonZeroDivisors_iff]
    refine ⟨fun y hy => ?_, fun y hy => ?_⟩
    · apply hreg a ha0
      show a • y = a • (0 : F)
      rw [smul_zero, Algebra.smul_def]
      exact hy
    · apply hreg a ha0
      show a • y = a • (0 : F)
      rw [smul_zero, Algebra.smul_def, mul_comm]
      exact hy

  let φ : F →ₐ[R] L := IsScalarTower.toAlgHom R F L
  have hinj : Function.Injective φ := s3
  have hx0 : x ≠ 0 := hx.ne_zero
  have hr0 : r ≠ 0 := by rintro rfl; exact hr (dvd_zero x)
  have hxδ : IsIntegral R (x • φ d) := by rw [← map_smul]; exact hxd.map φ
  have hrδ : IsIntegral R (r • φ d) := by rw [← map_smul]; exact hrd.map φ
  obtain ⟨hδK, hcx⟩ := s2 x (φ d) hx0 hxδ
  obtain ⟨-, hcr⟩ := s2 r (φ d) hr0 hrδ
  have hlift : minpoly K (φ d) ∈ Polynomial.lifts (algebraMap R K) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro n
    obtain ⟨t, ht⟩ := s1 _ _ (hcx n) (hcr n)
    exact ⟨t, ht⟩
  obtain ⟨q, hq, -, hqmon⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift (minpoly.monic hδK)
  have hδR : IsIntegral R (φ d) := by
    refine ⟨q, hqmon, ?_⟩
    rw [← Polynomial.aeval_def, ← Polynomial.aeval_map_algebraMap K, hq, minpoly.aeval]
  exact (isIntegral_algHom_iff φ hinj).mp hδR

theorem wc_pd2_free_of_quotSMulTop_free : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M] (x : R), x ∈ IsLocalRing.maximalIdeal R → IsSMulRegular M x → Module.Free (R ⧸ Ideal.span {x}) (QuotSMulTop x M) → Module.Free R M :=
by
  intro R _ _ _ M _ _ _ x hxm hreg hfree
  classical
  have hxnu : x ∈ nonunits R := (IsLocalRing.mem_maximalIdeal x).mp hxm
  have hIne : Ideal.span {x} ≠ ⊤ := by
    rw [Ne, Ideal.span_singleton_eq_top]; exact hxnu
  haveI : Nontrivial (R ⧸ Ideal.span {x}) := Ideal.Quotient.nontrivial_iff.mpr hIne
  haveI : Module.Finite R (QuotSMulTop x M) := Module.Finite.quotient R _
  haveI : Module.Finite (R ⧸ Ideal.span {x}) (QuotSMulTop x M) :=
    Module.Finite.of_restrictScalars_finite R _ _
  let b := Module.Free.chooseBasis (R ⧸ Ideal.span {x}) (QuotSMulTop x M)
  haveI : Finite (Module.Free.ChooseBasisIndex (R ⧸ Ideal.span {x}) (QuotSMulTop x M)) :=
    Module.Finite.finite_basis b
  letI : Fintype (Module.Free.ChooseBasisIndex (R ⧸ Ideal.span {x}) (QuotSMulTop x M)) :=
    Fintype.ofFinite _
  choose e he using fun i => Submodule.Quotient.mk_surjective _ (b i)
  have hkey : ∀ (r : R) (m : M), (Ideal.Quotient.mk (Ideal.span {x}) r) •
      (Submodule.Quotient.mk m : QuotSMulTop x M) = Submodule.Quotient.mk (r • m) := by
    intro r m
    rw [← Ideal.Quotient.algebraMap_eq, algebraMap_smul, Submodule.Quotient.mk_smul]
  have hIJ : Ideal.span {x} ≤ (⊥ : Ideal R).jacobson :=
    (Ideal.span_singleton_le_iff_mem _).mpr (IsLocalRing.maximalIdeal_le_jacobson ⊥ hxm)

  have hspan : Submodule.span R (Set.range e) = ⊤ := by
    apply eq_top_iff.mpr
    apply Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top hIJ
    intro m _
    choose r hr using fun i => Ideal.Quotient.mk_surjective (I := Ideal.span {x})
      (b.repr (Submodule.Quotient.mk m) i)
    have hsum : (Submodule.Quotient.mk (∑ i, r i • e i) : QuotSMulTop x M) =
        Submodule.Quotient.mk m := by
      have h1 := b.sum_repr (Submodule.Quotient.mk m : QuotSMulTop x M)
      rw [← Submodule.mkQ_apply, map_sum]
      conv_rhs => rw [← h1]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Submodule.mkQ_apply, ← hkey, hr, he]
    have hmem : (∑ i, r i • e i) - m ∈ Ideal.span {x} • (⊤ : Submodule R M) := by
      rw [Submodule.ideal_span_singleton_smul]
      exact (Submodule.Quotient.eq _).mp hsum
    rw [Submodule.mem_sup]
    refine ⟨∑ i, r i • e i, Submodule.sum_mem _ fun i _ =>
      Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩), m - ∑ i, r i • e i, ?_, by abel⟩
    have := Submodule.neg_mem _ hmem
    rwa [neg_sub] at this

  have hli : LinearIndependent R e := by
    let φ := Fintype.linearCombination R e
    have hφ : ∀ g, φ g = ∑ i, g i • e i := fun g => Fintype.linearCombination_apply R e g
    have hKle : LinearMap.ker φ ≤ ⊥ ⊔ Ideal.span {x} • LinearMap.ker φ := by
      intro g hg
      have hg0 : ∑ i, g i • e i = 0 := by rw [← hφ]; exact hg
      have hbar : ∑ i, Ideal.Quotient.mk (Ideal.span {x}) (g i) • b i = 0 := by
        have := congrArg (Submodule.mkQ _ : M →ₗ[R] QuotSMulTop x M) hg0
        rw [map_sum, map_zero] at this
        rw [← this]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Submodule.mkQ_apply, ← hkey, he]
      have hgi : ∀ i, g i ∈ Ideal.span {x} := by
        intro i
        rw [← Ideal.Quotient.eq_zero_iff_mem]
        exact (Fintype.linearIndependent_iff.mp b.linearIndependent) _ hbar i
      choose h hh using fun i => Ideal.mem_span_singleton'.mp (hgi i)
      have hx0 : x • ∑ i, h i • e i = x • (0 : M) := by
        rw [smul_zero, Finset.smul_sum, ← hg0]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [smul_smul, ← hh i, mul_comm]
      have hhK : h ∈ LinearMap.ker φ := by
        rw [LinearMap.mem_ker, hφ]; exact hreg hx0
      have hgxh : g = x • h := by
        funext i; simp [← hh i, mul_comm]
      apply Submodule.mem_sup_right
      rw [Submodule.ideal_span_singleton_smul, hgxh]
      exact Submodule.smul_mem_pointwise_smul h x _ hhK
    have hFG : (LinearMap.ker φ).FG := IsNoetherian.noetherian _
    have hK0 := Submodule.le_of_le_smul_of_le_jacobson_bot hFG hIJ hKle
    rw [Fintype.linearIndependent_iff]
    intro g hg i
    have hgK : g ∈ LinearMap.ker φ := by rw [LinearMap.mem_ker, hφ]; exact hg
    have := hK0 hgK
    rw [Submodule.mem_bot] at this
    rw [this]
    rfl
  exact Module.Free.of_basis (Module.Basis.mk hli hspan.ge)

theorem wc_ppi_purity_dim2 : ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A] [IsDomain A] (s : A), s ≠ 0 → ∀ (E : Type u) [CommRing E] [Algebra A E] [Algebra (Localization.Away s) E] [IsScalarTower A (Localization.Away s) E] [Algebra.Etale (Localization.Away s) E] [Module.Finite (Localization.Away s) E] (p : Ideal A) [p.IsPrime], p.height = 2 → (∀ (q : Ideal A) [q.IsPrime], q < p → Algebra.Etale (Localization.AtPrime q) (TensorProduct A (Localization.AtPrime q) (integralClosure A E))) → Algebra.Etale (Localization.AtPrime p) (TensorProduct A (Localization.AtPrime p) (integralClosure A E)) :=
by
  intro A _ _ _ s hs E _ _ _ _ _ _ p _ hp hq
  refine wc_pps_localize_to_maximal 2 ?_ A s hs E p (by simpa using hp) hq
  intro R _ _ _ s hs E _ _ _ _ _ _ hm hET
  classical
  obtain ⟨-, hufd⟩ := wc_fco_regular_local_ufd R
  haveI : UniqueFactorizationMonoid R := hufd
  haveI : IsIntegrallyClosed R := inferInstance
  have hm2 : (IsLocalRing.maximalIdeal R).height = 2 := by simpa using hm
  haveI hCfin : Module.Finite R (integralClosure R E) :=
    wc_fnf_integralClosure_finite_of_etale_localization R (Localization.Away s)
      (Submonoid.powers s) E
      (fun A' _ _ _ _ _ => wc_fnf_integralClosure_finite_of_etale_field R (FractionRing R) A')
  haveI : Module.Flat (Localization.Away s) E := inferInstance
  obtain ⟨htf, hdiv⟩ := wc_pd2_flat_div_prime R s hs E
  obtain ⟨x, hxm, hx, hpid⟩ := wc_pd2_regular_dim2_prime_pid R hm2
  haveI := hpid
  haveI : (Ideal.span {x}).IsPrime := (Ideal.span_singleton_prime hx.ne_zero).mpr hx
  haveI : IsDomain (R ⧸ Ideal.span {x}) := Ideal.Quotient.isDomain _
  have hx0 : x ≠ 0 := hx.ne_zero

  have hdivC : ∀ (r : R) (c c' : integralClosure R E), ¬ x ∣ r → r • c = x • c' →
      ∃ d : integralClosure R E, c = x • d := by
    intro r c c' hr h
    have hE : r • (c : E) = x • (c' : E) := by
      have := congrArg (fun z : integralClosure R E => (z : E)) h
      simpa using this
    obtain ⟨d, hd⟩ := hdiv x r (c : E) (c' : E) hx hr hE
    have hrd : r • d = (c' : E) := by
      apply htf x hx0
      show x • (r • d) = x • (c' : E)
      rw [smul_comm, ← hd, hE]
    have hxd : IsIntegral R (x • d) := by
      rw [← hd]; exact c.2
    have hrd' : IsIntegral R (r • d) := by
      rw [hrd]; exact c'.2
    have hdi := wc_pd2_integral_of_coprime_multiples R E htf x r d hx hr hxd hrd'
    refine ⟨⟨d, hdi⟩, Subtype.ext ?_⟩
    simpa using hd

  have htors : Module.IsTorsionFree (R ⧸ Ideal.span {x})
      (QuotSMulTop x (integralClosure R E)) := by
    refine ⟨fun rb hrb => ?_⟩
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective rb
    have hr : ¬ x ∣ r := by
      intro hxr
      have h0 : Ideal.Quotient.mk (Ideal.span {x}) r = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton.mpr hxr)
      rw [h0] at hrb
      exact not_isRegular_zero hrb
    have key : ∀ m : integralClosure R E,
        (Ideal.Quotient.mk (Ideal.span {x}) r) •
          (Submodule.Quotient.mk m : QuotSMulTop x (integralClosure R E)) =
        Submodule.Quotient.mk (r • m) := by
      intro m
      rw [← Ideal.Quotient.algebraMap_eq, algebraMap_smul, Submodule.Quotient.mk_smul]
    intro a b hab
    obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ a
    obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ b
    have hab' : (Submodule.Quotient.mk (r • a) : QuotSMulTop x (integralClosure R E)) =
        Submodule.Quotient.mk (r • b) := by
      rw [← key, ← key]; exact hab
    rw [Submodule.Quotient.eq, ← smul_sub] at hab'
    obtain ⟨c', -, hc'⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp hab'
    obtain ⟨d, hd⟩ := hdivC r (a - b) c' hr hc'.symm
    show (Submodule.Quotient.mk a : QuotSMulTop x (integralClosure R E)) =
      Submodule.Quotient.mk b
    rw [Submodule.Quotient.eq]
    exact (Submodule.mem_smul_pointwise_iff_exists _ _ _).mpr ⟨d, trivial, hd.symm⟩
  haveI : Module.Finite R (QuotSMulTop x (integralClosure R E)) := Module.Finite.quotient R _
  haveI : Module.Finite (R ⧸ Ideal.span {x}) (QuotSMulTop x (integralClosure R E)) :=
    Module.Finite.of_restrictScalars_finite R _ _
  haveI := htors
  have hfreeQ : Module.Free (R ⧸ Ideal.span {x}) (QuotSMulTop x (integralClosure R E)) :=
    Module.free_of_finite_type_torsion_free'
  have hreg : IsSMulRegular (integralClosure R E) x := by
    intro c₁ c₂ h
    apply Subtype.ext
    apply htf x hx0
    have := congrArg (fun z : integralClosure R E => (z : E)) h
    simpa using this
  haveI : Module.Free R (integralClosure R E) :=
    wc_pd2_free_of_quotSMulTop_free R (integralClosure R E) x hxm hreg hfreeQ
  exact wc_pps_free_punctured_etale R (le_of_eq hm2.symm) (integralClosure R E) hET

theorem wc_pps_good_hyperplane : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R] (s : R), s ≠ 0 → 2 ≤ (IsLocalRing.maximalIdeal R).height → ∃ f : R, f ∈ IsLocalRing.maximalIdeal R ∧ f ∉ IsLocalRing.maximalIdeal R ^ 2 ∧ (Ideal.span {f}).IsPrime ∧ s ∉ Ideal.span {f} ∧ ∃ (_ : IsRegularLocalRing (R ⧸ Ideal.span {f})), (IsLocalRing.maximalIdeal (R ⧸ Ideal.span {f})).height + 1 = (IsLocalRing.maximalIdeal R).height :=
by
  intro R _ _ _ s hs h2
  classical
  haveI : IsNoetherianRing R := IsRegularLocalRing.toIsNoetherian
  obtain ⟨-, hufd⟩ := wc_fco_regular_local_ufd R
  haveI : UniqueFactorizationMonoid R := hufd

  have hPQ : ∀ g : R, g ∈ IsLocalRing.maximalIdeal R → g ∉ IsLocalRing.maximalIdeal R ^ 2 →
      (Ideal.span {g}).IsPrime ∧ ∃ (_ : IsRegularLocalRing (R ⧸ Ideal.span {g})),
        (IsLocalRing.maximalIdeal (R ⧸ Ideal.span {g})).height + 1 =
          (IsLocalRing.maximalIdeal R).height := by
    intro g hg hg2
    let v : Fin 1 → IsLocalRing.maximalIdeal R := fun _ => ⟨g, hg⟩
    have hLI : LinearIndependent (IsLocalRing.ResidueField R)
        (fun i => (IsLocalRing.maximalIdeal R).toCotangent (v i)) := by
      rw [linearIndependent_unique_iff]
      intro h0
      exact hg2 ((Ideal.toCotangent_eq_zero _ _).mp h0)
    have hrange : Set.range (fun i => ((v i : IsLocalRing.maximalIdeal R) : R)) = {g} :=
      Set.range_const
    obtain ⟨hreg, hdim⟩ : IsRegularLocalRing (R ⧸ Ideal.span {g}) ∧
        ringKrullDim (R ⧸ Ideal.span {g}) + ((1 : ℕ) : WithBot ℕ∞) = ringKrullDim R := by
      have key := wcpa_rs_quotient_regular R 1 v hLI
      rw [hrange] at key
      exact key
    have hdom : IsDomain (R ⧸ Ideal.span {g}) :=
      wcpa_regular_isDomain _ wcpa_rs_quotient_regular hreg
    haveI := hreg
    refine ⟨(Ideal.Quotient.isDomain_iff_prime _).mp hdom, hreg, ?_⟩
    have e1 : ((IsLocalRing.maximalIdeal (R ⧸ Ideal.span {g})).height : WithBot ℕ∞) =
        ringKrullDim (R ⧸ Ideal.span {g}) := IsLocalRing.maximalIdeal_height_eq_ringKrullDim
    have e2 : ((IsLocalRing.maximalIdeal R).height : WithBot ℕ∞) = ringKrullDim R :=
      IsLocalRing.maximalIdeal_height_eq_ringKrullDim
    apply WithBot.coe_injective
    rw [WithBot.coe_add, e1, e2, ← hdim]
    norm_cast

  have hTP : ∃ x y : IsLocalRing.maximalIdeal R, LinearIndependent (IsLocalRing.ResidueField R)
      ![(IsLocalRing.maximalIdeal R).toCotangent x, (IsLocalRing.maximalIdeal R).toCotangent y] := by
    have e1 := IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace R
    have e2 : ((Submodule.spanFinrank (IsLocalRing.maximalIdeal R) : ℕ) : WithBot ℕ∞) =
        ringKrullDim R := IsRegularLocalRing.spanFinrank_maximalIdeal
    have e3 : ((IsLocalRing.maximalIdeal R).height : WithBot ℕ∞) = ringKrullDim R :=
      IsLocalRing.maximalIdeal_height_eq_ringKrullDim
    have hh : (IsLocalRing.maximalIdeal R).height =
        ((Module.finrank (IsLocalRing.ResidueField R) (IsLocalRing.CotangentSpace R) : ℕ) : ℕ∞) := by
      apply WithBot.coe_injective
      rw [e3, ← e2, e1]
      norm_cast
    have hn2 : 2 ≤ Module.finrank (IsLocalRing.ResidueField R) (IsLocalRing.CotangentSpace R) := by
      rw [hh] at h2
      exact_mod_cast h2
    haveI : Module.Finite (IsLocalRing.ResidueField R) (IsLocalRing.CotangentSpace R) :=
      Module.finite_of_finrank_pos (by omega)
    obtain ⟨u, hu⟩ := (Module.finrank_pos_iff_exists_ne_zero (R := IsLocalRing.ResidueField R)
      (M := IsLocalRing.CotangentSpace R)).mp (by omega)
    obtain ⟨w, hw⟩ := exists_linearIndependent_pair_of_one_lt_finrank
      (R := IsLocalRing.ResidueField R) (M := IsLocalRing.CotangentSpace R) (by omega) hu
    obtain ⟨x, rfl⟩ := Ideal.toCotangent_surjective _ u
    obtain ⟨y, rfl⟩ := Ideal.toCotangent_surjective _ w
    exact ⟨x, y, hw⟩
  obtain ⟨x, y, LI⟩ := hTP

  have htx : (IsLocalRing.maximalIdeal R).toCotangent x ≠ 0 := LI.ne_zero 0
  let g : ℕ → R := fun n => (x : R) + (y : R) ^ (n + 2)
  have hy2 : ∀ n : ℕ, (y : R) ^ (n + 2) ∈ IsLocalRing.maximalIdeal R ^ 2 := by
    intro n
    rw [pow_add, mul_comm]
    exact Ideal.mul_mem_right _ _ (Ideal.pow_mem_pow y.2 2)
  have hym : ∀ n : ℕ, (y : R) ^ (n + 2) ∈ IsLocalRing.maximalIdeal R :=
    fun n => Ideal.pow_mem_of_mem _ y.2 _ (by omega)
  have hgm : ∀ n, g n ∈ IsLocalRing.maximalIdeal R := fun n => Ideal.add_mem _ x.2 (hym n)
  have hgtc : ∀ n, (IsLocalRing.maximalIdeal R).toCotangent ⟨g n, hgm n⟩ =
      (IsLocalRing.maximalIdeal R).toCotangent x := by
    intro n
    have hsplit : (⟨g n, hgm n⟩ : IsLocalRing.maximalIdeal R) = x + ⟨(y : R) ^ (n + 2), hym n⟩ :=
      Subtype.ext rfl
    rw [hsplit, map_add,
      (Ideal.toCotangent_eq_zero _ (⟨(y : R) ^ (n + 2), hym n⟩ : IsLocalRing.maximalIdeal R)).mpr
        (hy2 n), add_zero]
  have hgm2 : ∀ n, g n ∉ IsLocalRing.maximalIdeal R ^ 2 := by
    intro n h
    apply htx
    rw [← hgtc n]
    exact (Ideal.toCotangent_eq_zero _ _).mpr h
  have hP : ∀ n, (Ideal.span {g n}).IsPrime := fun n => (hPQ (g n) (hgm n) (hgm2 n)).1
  have hne : ∀ n, g n ≠ 0 := by
    intro n h
    apply hgm2 n
    rw [h]
    exact Ideal.zero_mem _
  have hprime : ∀ n, Prime (g n) := fun n => (Ideal.span_singleton_prime (hne n)).mp (hP n)
  have hdist : ∀ a b : ℕ, a < b → ¬ g a ∣ g b := by
    intro a b hab hdvd
    have hb : g b ∈ Ideal.span {g a} := Ideal.mem_span_singleton.mpr hdvd
    have hsub : g b - g a ∈ Ideal.span {g a} :=
      Ideal.sub_mem _ hb (Ideal.mem_span_singleton_self _)
    have hyk : (y : R) ^ (b - a) ∈ IsLocalRing.maximalIdeal R :=
      Ideal.pow_mem_of_mem _ y.2 _ (by omega)
    have hunit : IsUnit ((y : R) ^ (b - a) - 1) := by
      have h1 : IsUnit (1 - (y : R) ^ (b - a)) :=
        IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _
          ((IsLocalRing.mem_maximalIdeal _).mp hyk)
      have h3 : (y : R) ^ (b - a) - 1 = -(1 - (y : R) ^ (b - a)) := by ring
      rw [h3]
      exact h1.neg
    have heq : g b - g a = (y : R) ^ (a + 2) * ((y : R) ^ (b - a) - 1) := by
      have hb2 : b + 2 = (a + 2) + (b - a) := by omega
      show (x : R) + (y : R) ^ (b + 2) - ((x : R) + (y : R) ^ (a + 2)) = _
      rw [hb2, pow_add]
      ring
    rw [heq, Ideal.mul_unit_mem_iff_mem _ hunit] at hsub
    have hyP : (y : R) ∈ Ideal.span {g a} := (hP a).mem_of_pow_mem _ hsub
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hyP
    have hyc : y = c • (⟨g a, hgm a⟩ : IsLocalRing.maximalIdeal R) := by
      apply Subtype.ext
      rw [Submodule.coe_smul, smul_eq_mul]
      exact hc.symm
    have hty : (IsLocalRing.maximalIdeal R).toCotangent y =
        (algebraMap R (IsLocalRing.ResidueField R) c) •
          (IsLocalRing.maximalIdeal R).toCotangent x := by
      rw [algebraMap_smul, hyc, map_smul, hgtc a]
    have hpair := LinearIndependent.pair_iff.mp LI
      (algebraMap R (IsLocalRing.ResidueField R) c) (-1) (by rw [← hty, neg_one_smul, add_neg_cancel])
    exact one_ne_zero (neg_eq_zero.mp hpair.2)

  have havoid : ∃ n, ¬ g n ∣ s := by
    by_contra hcon
    push_neg at hcon
    have hq : ∀ n, ∃ q ∈ UniqueFactorizationMonoid.factors s, Associated (g n) q := fun n =>
      UniqueFactorizationMonoid.exists_mem_factors_of_dvd hs (hprime n).irreducible (hcon n)
    choose q hqmem hqass using hq
    let F : ℕ → {z // z ∈ (UniqueFactorizationMonoid.factors s).toFinset} :=
      fun n => ⟨q n, Multiset.mem_toFinset.mpr (hqmem n)⟩
    obtain ⟨a, b, hab, hF⟩ := Finite.exists_ne_map_eq_of_infinite F
    have hqab : q a = q b := congrArg Subtype.val hF
    have hassoc : Associated (g a) (g b) := by
      refine (hqass a).trans ?_
      rw [hqab]
      exact (hqass b).symm
    rcases lt_or_gt_of_ne hab with h | h
    · exact hdist a b h hassoc.dvd
    · exact hdist b a h hassoc.symm.dvd

  obtain ⟨n, hn⟩ := havoid
  obtain ⟨hPn, hreg, hht⟩ := hPQ (g n) (hgm n) (hgm2 n)
  exact ⟨g n, hgm n, hgm2 n, hPn, fun h => hn (Ideal.mem_span_singleton.mp h), hreg, hht⟩

theorem wc_pks_etale_localization_normal : ∀ (R T : Type u) [CommRing R] [IsDomain R] [IsIntegrallyClosed R] [CommRing T] [Algebra R T] [Algebra.Etale R T] (q : Ideal T) [q.IsPrime], IsDomain (Localization.AtPrime q) ∧ IsIntegrallyClosed (Localization.AtPrime q) :=
by
  intro R T _ _ _ _ _ _ q _
  classical

  have s2 : ∀ (K A : Type u) [Field K] [CommRing A] [Algebra K A] [Algebra.Etale K A] (s : A),
      ∃ γ : A, s * s * γ = s := by
    intro K A _ _ _ _ s
    obtain ⟨I, _, Ai, hF, hA, e, -⟩ := (Algebra.Etale.iff_exists_algEquiv_prod K A).mp inferInstance
    refine ⟨e.symm (fun i => (e s i)⁻¹), ?_⟩
    apply e.injective
    rw [map_mul, map_mul, AlgEquiv.apply_symm_apply]
    funext i
    simp only [Pi.mul_apply]
    exact mul_self_mul_inv (e s i)
  let K := FractionRing R
  let S := TensorProduct R T K
  let j : T →ₐ[R] S := Algebra.TensorProduct.includeLeft
  have hj : ∀ t : T, j t = TensorProduct.tmul R t (1 : K) := fun t => rfl
  have hjinj : Function.Injective j :=
    Algebra.TensorProduct.includeLeft_injective (R := R) (S := R) (A := T) (B := K)
      (IsFractionRing.injective R K)
  have hjA : ∀ t : T, algebraMap T S t = j t := fun t => rfl
  have hinjA : Function.Injective (algebraMap T S) := fun a b h =>
    hjinj (by rw [← hjA, ← hjA]; exact h)

  have hreg : ∀ s : S, ∃ γ : S, s * s * γ = s := by
    intro s
    let c : S ≃ₐ[R] TensorProduct R K T := Algebra.TensorProduct.comm R T K
    obtain ⟨γ', h⟩ := s2 K (TensorProduct R K T) (c s)
    refine ⟨c.symm γ', c.injective ?_⟩
    rw [map_mul, map_mul, AlgEquiv.apply_symm_apply]
    exact h

  have hlift : ∀ z : S, IsIntegral T z → ∃ t : T, j t = z := by
    intro z hint
    obtain ⟨w, hw⟩ := (TensorProduct.toIntegralClosure_bijective_of_smooth (R := R) (S := T)
      (B := K)).2 ⟨z, (mem_integralClosure_iff T S).mpr hint⟩
    have hw' := congrArg Subtype.val hw
    simp only at hw'
    have key : ∀ w' : TensorProduct R T (integralClosure R K),
        ∃ t : T, ((TensorProduct.toIntegralClosure R T K w' : integralClosure T S) : S) = j t := by
      intro w'
      induction w' using TensorProduct.induction_on with
      | zero => exact ⟨0, by rw [map_zero, map_zero]; rfl⟩
      | tmul t c =>
        have hc : (c : K) ∈ (⊥ : Subalgebra R K) := by
          rw [← IsIntegrallyClosed.integralClosure_eq_bot R K]; exact c.2
        obtain ⟨r, hr⟩ := Algebra.mem_bot.mp hc
        refine ⟨r • t, ?_⟩
        rw [hj]
        change TensorProduct.tmul R t (c : K) = _
        rw [TensorProduct.smul_tmul, ← hr, Algebra.algebraMap_eq_smul_one]
      | add x y hx hy =>
        obtain ⟨t₁, h₁⟩ := hx
        obtain ⟨t₂, h₂⟩ := hy
        exact ⟨t₁ + t₂, by rw [map_add, Subalgebra.coe_add, h₁, h₂, map_add]⟩
    obtain ⟨t, ht⟩ := key w
    exact ⟨t, ht.symm.trans hw'⟩

  have hsep : ∀ a b : S, a * b = 0 → ∃ ε : S, IsIdempotentElem ε ∧ ε * b = 0 ∧ (1 - ε) * a = 0 := by
    intro a b hab
    obtain ⟨γ, hγ⟩ := hreg b
    refine ⟨1 - b * γ, ?_, ?_, ?_⟩
    · show (1 - b * γ) * (1 - b * γ) = 1 - b * γ
      linear_combination γ * hγ
    · linear_combination -hγ
    · linear_combination γ * hab
  have hliftε : ∀ ε : S, IsIdempotentElem ε → ∃ e : T, j e = ε := by
    intro ε hε
    apply hlift
    refine ⟨Polynomial.X ^ 2 - Polynomial.X,
        Polynomial.monic_X_pow_sub (Polynomial.degree_X_le.trans_lt (by norm_num)), ?_⟩
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X, pow_two, hε.eq,
      sub_self]

  have hnzd : NoZeroDivisors (Localization.AtPrime q) := by
    refine ⟨fun {x y} hxy => ?_⟩
    obtain ⟨⟨s, u⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl x
    obtain ⟨⟨s', u'⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl y
    dsimp only at hxy ⊢
    rw [← IsLocalization.mk'_mul] at hxy
    obtain ⟨m, hm⟩ := (IsLocalization.mk'_eq_zero_iff _ _).mp hxy
    obtain ⟨ε, hε, h1, h2⟩ := hsep (j ((m : T) * s)) (j s')
      (by rw [← map_mul, mul_assoc, hm, map_zero])
    obtain ⟨e, rfl⟩ := hliftε ε hε
    have he1 : e * s' = 0 := hjinj (by rw [map_mul, h1, map_zero])
    have he2 : (1 - e) * ((m : T) * s) = 0 :=
      hjinj (by rw [map_mul, map_sub, map_one, h2, map_zero])
    have he3 : e * e = e := hjinj (by rw [map_mul]; exact hε.eq)
    set π := algebraMap T (Localization.AtPrime q) with hπ
    have hē : π e * π e = π e := by rw [← map_mul, he3]
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (π e) with hu | hu
    · right
      have h1' : π e = 1 := hu.mul_left_cancel (by rw [hē, mul_one])
      have hs' : π s' = 0 := by
        have := congrArg π he1
        rwa [map_mul, h1', one_mul, map_zero] at this
      rw [IsLocalization.mk'_eq_mul_mk'_one, hs', zero_mul]
    · left
      have h0 : π e = 0 := (hu.mul_right_eq_zero).mp (by rw [sub_mul, one_mul, hē, sub_self])
      have hs : π s = 0 := by
        have := congrArg π he2
        rw [map_mul, map_sub, map_one, h0, sub_zero, one_mul, map_mul, map_zero] at this
        exact ((IsLocalization.map_units (Localization.AtPrime q) m).mul_right_eq_zero).mp this
      rw [IsLocalization.mk'_eq_mul_mk'_one, hs, zero_mul]
  haveI hdom : IsDomain (Localization.AtPrime q) := NoZeroDivisors.to_isDomain _

  have hdiv : ∀ p : Polynomial T, p.Monic → ∀ α β : T,
      ∑ i ∈ Finset.range (p.natDegree + 1), p.coeff i * β ^ (p.natDegree - i) * α ^ i = 0 →
      ∃ t : T, t * β = α := by
    intro p hp α β hE
    have hES : ∑ i ∈ Finset.range (p.natDegree + 1), algebraMap T S (p.coeff i) *
        algebraMap T S β ^ (p.natDegree - i) * algebraMap T S α ^ i = 0 := by
      have := congrArg (algebraMap T S) hE
      simpa only [map_sum, map_mul, map_pow, map_zero] using this
    have hCn : algebraMap T S (p.coeff p.natDegree) = 1 := by rw [hp.coeff_natDegree, map_one]
    obtain ⟨n, hn⟩ : ∃ n, p.natDegree = n := ⟨_, rfl⟩
    obtain ⟨A, hA⟩ : ∃ A, algebraMap T S α = A := ⟨_, rfl⟩
    obtain ⟨B, hB⟩ : ∃ B, algebraMap T S β = B := ⟨_, rfl⟩
    rw [hn, hA, hB] at hES
    rw [hn] at hCn
    obtain ⟨γ, hγ⟩ := hreg B
    have hfB : (1 - B * γ) * B = 0 := by linear_combination -hγ
    have hu : ((1 - B * γ) * A) ^ n = 0 := by
      have h1 : (1 - B * γ) ^ n * ∑ i ∈ Finset.range (n + 1),
          algebraMap T S (p.coeff i) * B ^ (n - i) * A ^ i = ((1 - B * γ) * A) ^ n := by
        rw [Finset.mul_sum, Finset.sum_range_succ, Finset.sum_eq_zero, zero_add]
        · rw [hCn, Nat.sub_self, pow_zero, mul_pow]
          ring
        · intro i hi
          have hi' : i < n := Finset.mem_range.mp hi
          obtain ⟨k, hk⟩ : ∃ k, n - i = k + 1 := ⟨n - i - 1, by omega⟩
          have hk2 : (1 - B * γ) ^ n = (1 - B * γ) ^ i * (1 - B * γ) ^ (k + 1) := by
            rw [← pow_add]; congr 1; omega
          rw [hk2, hk]
          have h0 : (1 - B * γ) ^ (k + 1) * B ^ (k + 1) = 0 := by
            rw [← mul_pow, hfB, zero_pow (Nat.succ_ne_zero k)]
          calc (1 - B * γ) ^ i * (1 - B * γ) ^ (k + 1) *
                (algebraMap T S (p.coeff i) * B ^ (k + 1) * A ^ i)
              = (1 - B * γ) ^ i * algebraMap T S (p.coeff i) * A ^ i *
                ((1 - B * γ) ^ (k + 1) * B ^ (k + 1)) := by ring
            _ = 0 := by rw [h0, mul_zero]
      rw [← h1, hES, mul_zero]
    obtain ⟨δ, hδ⟩ := hreg ((1 - B * γ) * A)
    have hpw : ∀ m : ℕ, ((1 - B * γ) * A) ^ (m + 1) * δ ^ m = (1 - B * γ) * A := by
      intro m
      induction m with
      | zero => simp
      | succ m ih =>
        calc ((1 - B * γ) * A) ^ (m + 1 + 1) * δ ^ (m + 1)
            = (((1 - B * γ) * A) ^ (m + 1) * δ ^ m) * ((1 - B * γ) * A) * δ := by ring
          _ = (1 - B * γ) * A := by rw [ih, hδ]
    have hu0 : (1 - B * γ) * A = 0 := by
      rcases Nat.eq_zero_or_pos n with h | h
      · rw [h, pow_zero] at hu
        calc (1 - B * γ) * A = ((1 - B * γ) * A) * 1 := (mul_one _).symm
          _ = 0 := by rw [hu, mul_zero]
      · have := hpw (n - 1)
        rw [Nat.sub_add_cancel h, hu, zero_mul] at this
        exact this.symm
    have hfA : B * γ * A = A := by linear_combination -hu0
    have hfz : ∀ k : ℕ, (B * γ) ^ k * (A * γ) = A * γ := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        calc (B * γ) ^ (k + 1) * (A * γ) = (B * γ) ^ k * ((B * γ * A) * γ) := by ring
          _ = A * γ := by rw [hfA, ih]
    have hroot : Polynomial.eval₂ (algebraMap T S) (A * γ) (p * Polynomial.X) = 0 := by
      rw [Polynomial.eval₂_mul_X, Polynomial.eval₂_eq_sum_range, hn, Finset.sum_mul]
      have e : ∑ i ∈ Finset.range (n + 1), algebraMap T S (p.coeff i) * (A * γ) ^ i * (A * γ) =
          γ ^ n * (A * γ) * ∑ i ∈ Finset.range (n + 1),
            algebraMap T S (p.coeff i) * B ^ (n - i) * A ^ i := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun i hi => ?_)
        have hi' : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        have hγn : γ ^ n = γ ^ (n - i) * γ ^ i := by rw [← pow_add, Nat.sub_add_cancel hi']
        calc algebraMap T S (p.coeff i) * (A * γ) ^ i * (A * γ)
            = algebraMap T S (p.coeff i) * (A * γ) ^ i * ((B * γ) ^ (n - i) * (A * γ)) := by
              rw [hfz]
          _ = γ ^ n * (A * γ) * (algebraMap T S (p.coeff i) * B ^ (n - i) * A ^ i) := by
              rw [hγn]; ring
      rw [e, hES, mul_zero]
    obtain ⟨t, ht⟩ := hlift (A * γ) ⟨p * Polynomial.X, hp.mul Polynomial.monic_X, hroot⟩
    refine ⟨t, hinjA ?_⟩
    rw [map_mul, hjA t, ht, hB, hA]
    linear_combination hfA

  refine ⟨hdom, ?_⟩
  rw [isIntegrallyClosed_iff (FractionRing (Localization.AtPrime q))]
  intro x hx
  obtain ⟨m, hm⟩ := IsIntegral.exists_multiple_integral_of_isLocalization q.primeCompl x hx
  rw [Submonoid.smul_def, Algebra.smul_def] at hm
  obtain ⟨p, hp, hpx⟩ := hm
  obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors (Localization.AtPrime q)) x
  obtain ⟨⟨α₀, s₁⟩, ha⟩ := IsLocalization.surj q.primeCompl a
  obtain ⟨⟨β₀, s₂⟩, hb⟩ := IsLocalization.surj q.primeCompl (b : Localization.AtPrime q)
  dsimp only at hab ha hb
  have hψ : ∀ t : T, algebraMap T (FractionRing (Localization.AtPrime q)) t =
      algebraMap (Localization.AtPrime q) (FractionRing (Localization.AtPrime q))
        (algebraMap T (Localization.AtPrime q) t) :=
    IsScalarTower.algebraMap_apply T (Localization.AtPrime q) (FractionRing (Localization.AtPrime q))
  have key : algebraMap T (FractionRing (Localization.AtPrime q)) (m : T) * x *
      algebraMap T (FractionRing (Localization.AtPrime q)) (β₀ * (s₁ : T)) =
      algebraMap T (FractionRing (Localization.AtPrime q)) ((m : T) * α₀ * (s₂ : T)) := by
    simp only [hψ, map_mul, ← ha, ← hb]
    linear_combination (algebraMap (Localization.AtPrime q) (FractionRing (Localization.AtPrime q))
        (algebraMap T (Localization.AtPrime q) (m : T)) *
      algebraMap (Localization.AtPrime q) (FractionRing (Localization.AtPrime q))
        (algebraMap T (Localization.AtPrime q) (s₂ : T)) *
      algebraMap (Localization.AtPrime q) (FractionRing (Localization.AtPrime q))
        (algebraMap T (Localization.AtPrime q) (s₁ : T))) * hab
  have hE0 : algebraMap T (FractionRing (Localization.AtPrime q))
      (Polynomial.eval ((m : T) * α₀ * (s₂ : T)) (p.scaleRoots (β₀ * (s₁ : T)))) = 0 := by
    rw [← Polynomial.eval₂_at_apply, ← key,
      mul_comm (algebraMap T (FractionRing (Localization.AtPrime q)) (m : T) * x),
      Polynomial.scaleRoots_eval₂_mul, hpx, mul_zero]
  have hE1 : algebraMap T (Localization.AtPrime q)
      (Polynomial.eval ((m : T) * α₀ * (s₂ : T)) (p.scaleRoots (β₀ * (s₁ : T)))) = 0 := by
    apply IsFractionRing.injective (Localization.AtPrime q) (FractionRing (Localization.AtPrime q))
    rw [map_zero, ← hψ]
    exact hE0
  obtain ⟨m', hm'⟩ := (IsLocalization.map_eq_zero_iff q.primeCompl (Localization.AtPrime q) _).mp hE1
  have hsum : ∀ (α β : T), Polynomial.eval α (p.scaleRoots β) =
      ∑ i ∈ Finset.range (p.natDegree + 1), p.coeff i * β ^ (p.natDegree - i) * α ^ i := by
    intro α β
    rw [Polynomial.eval_eq_sum_range, Polynomial.natDegree_scaleRoots]
    simp only [Polynomial.coeff_scaleRoots]
  have hhom : ∀ (α β c : T), ∑ i ∈ Finset.range (p.natDegree + 1),
      p.coeff i * (c * β) ^ (p.natDegree - i) * (c * α) ^ i =
      c ^ p.natDegree * ∑ i ∈ Finset.range (p.natDegree + 1),
        p.coeff i * β ^ (p.natDegree - i) * α ^ i := by
    intro α β c
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun i hi => ?_)
    have hi' : i ≤ p.natDegree := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    rw [mul_pow, mul_pow, show c ^ p.natDegree = c ^ (p.natDegree - i) * c ^ i by
      rw [← pow_add, Nat.sub_add_cancel hi']]
    ring
  have hE2 : ∑ i ∈ Finset.range (p.natDegree + 1), p.coeff i *
      ((m' : T) * (β₀ * (s₁ : T))) ^ (p.natDegree - i) *
      ((m' : T) * ((m : T) * α₀ * (s₂ : T))) ^ i = 0 := by
    rw [hhom, ← hsum ((m : T) * α₀ * (s₂ : T)) (β₀ * (s₁ : T))]
    rcases Nat.eq_zero_or_pos p.natDegree with h | h
    · exfalso
      have h1 : Polynomial.eval ((m : T) * α₀ * (s₂ : T)) (p.scaleRoots (β₀ * (s₁ : T))) = 1 := by
        rw [hsum, h, Finset.sum_range_one]
        simp only [Nat.sub_self, pow_zero, mul_one]
        have := hp.coeff_natDegree
        rwa [h] at this
      rw [h1, mul_one] at hm'
      exact m'.2 (by rw [hm']; exact q.zero_mem)
    · obtain ⟨k, hk⟩ : ∃ k, p.natDegree = k + 1 := ⟨p.natDegree - 1, by omega⟩
      rw [hk, pow_succ, mul_assoc, hm', mul_zero]
  obtain ⟨t, ht⟩ := hdiv p hp _ _ hE2
  have hπm' : IsUnit (algebraMap T (Localization.AtPrime q) (m' : T)) :=
    IsLocalization.map_units _ m'
  have ht2 : algebraMap T (Localization.AtPrime q) t *
      algebraMap T (Localization.AtPrime q) (β₀ * (s₁ : T)) =
      algebraMap T (Localization.AtPrime q) ((m : T) * α₀ * (s₂ : T)) := by
    have := congrArg (algebraMap T (Localization.AtPrime q)) ht
    apply hπm'.mul_left_cancel
    simp only [map_mul] at this ⊢
    linear_combination this
  have hβ0 : algebraMap T (FractionRing (Localization.AtPrime q)) (β₀ * (s₁ : T)) ≠ 0 := by
    rw [hψ, map_mul, ← hb]
    refine (map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr ?_
    refine mul_ne_zero (mul_ne_zero (nonZeroDivisors.coe_ne_zero b) ?_) ?_
    · exact (IsLocalization.map_units (Localization.AtPrime q) s₂).ne_zero
    · exact (IsLocalization.map_units (Localization.AtPrime q) s₁).ne_zero
  have hψt : algebraMap T (FractionRing (Localization.AtPrime q)) t =
      algebraMap T (FractionRing (Localization.AtPrime q)) (m : T) * x := by
    apply mul_right_cancel₀ hβ0
    rw [key, hψ, hψ, hψ, ← map_mul, ht2]
  have hπm : algebraMap T (FractionRing (Localization.AtPrime q)) (m : T) ≠ 0 := by
    rw [hψ]
    exact (map_ne_zero_iff _ (IsFractionRing.injective _ _)).mpr
      (IsLocalization.map_units (Localization.AtPrime q) m).ne_zero
  refine ⟨IsLocalization.mk' (Localization.AtPrime q) t m, ?_⟩
  apply mul_left_cancel₀ hπm
  rw [← hψt, hψ t, ← IsLocalization.mk'_spec (Localization.AtPrime q) t m, map_mul, hψ (m : T)]
  ring

theorem wc_pas_integralClosure_isLocalization : ∀ (A : Type u) [CommRing A] (s : A) (E : Type u) [CommRing E] [Algebra A E] [Algebra (Localization.Away s) E] [IsScalarTower A (Localization.Away s) E] [Module.Finite (Localization.Away s) E], IsLocalization (Algebra.algebraMapSubmonoid (integralClosure A E) (Submonoid.powers s)) E :=
by
  intro A _ s E _ _ _ _ _
  have hu : ∀ n : ℕ, IsUnit (algebraMap A E (s ^ n)) := by
    intro n
    rw [IsScalarTower.algebraMap_apply A (Localization.Away s) E, map_pow]
    exact ((IsLocalization.Away.algebraMap_isUnit s).pow n).map _
  refine ⟨?_, ?_, ?_⟩
  · rintro ⟨y, hy⟩
    obtain ⟨a, ha, rfl⟩ := Submonoid.mem_map.mp hy
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp ha
    show IsUnit (algebraMap (integralClosure A E) E (algebraMap A (integralClosure A E) (s ^ n)))
    rw [← IsScalarTower.algebraMap_apply]
    exact hu n
  · intro z
    have hz : IsIntegral (Localization.Away s) z := Algebra.IsIntegral.isIntegral z
    obtain ⟨m, hm⟩ := IsIntegral.exists_multiple_integral_of_isLocalization
      (Submonoid.powers s) z hz
    rw [Submonoid.smul_def, Algebra.smul_def] at hm
    refine ⟨(⟨algebraMap A E (m : A) * z, hm⟩,
      ⟨algebraMap A (integralClosure A E) (m : A), ⟨(m : A), m.2, rfl⟩⟩), ?_⟩
    show z * algebraMap (integralClosure A E) E (algebraMap A (integralClosure A E) (m : A)) =
      algebraMap A E (m : A) * z
    rw [← IsScalarTower.algebraMap_apply, mul_comm]
  · intro x y hxy
    exact ⟨1, by rw [Subtype.val_injective hxy]⟩

theorem wc_pps_cut_punctured_etale : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R] (s : R), s ≠ 0 → ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra (Localization.Away s) E] [IsScalarTower R (Localization.Away s) E] [Algebra.Etale (Localization.Away s) E] [Module.Finite (Localization.Away s) E], (∀ (q : Ideal R) [q.IsPrime], q < IsLocalRing.maximalIdeal R → Algebra.Etale (Localization.AtPrime q) (TensorProduct R (Localization.AtPrime q) (integralClosure R E))) → ∀ (f : R), f ∈ IsLocalRing.maximalIdeal R → f ∉ IsLocalRing.maximalIdeal R ^ 2 → ∀ [(Ideal.span {f}).IsPrime], s ∉ Ideal.span {f} → ∀ [IsLocalRing (R ⧸ Ideal.span {f})] (Q : Ideal (R ⧸ Ideal.span {f})) [Q.IsPrime], Q < IsLocalRing.maximalIdeal (R ⧸ Ideal.span {f}) → Algebra.Etale (Localization.AtPrime Q) (TensorProduct (R ⧸ Ideal.span {f}) (Localization.AtPrime Q) (integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E))) :=
by
  intro R _ _ _ s hs E _ _ _ _ _ _ hET f hfm hfm2 _ hsf _ Q _ hQ
  classical

  have hEs : IsUnit (algebraMap R E s) := by
    rw [IsScalarTower.algebraMap_apply R (Localization.Away s) E]
    exact (IsLocalization.Away.algebraMap_isUnit s).map _
  haveI hEloc := wc_pas_integralClosure_isLocalization R s E


  have key : ∀ (L : Type u) [CommRing L] [IsDomain L] [IsIntegrallyClosed L] [Algebra R L],
      algebraMap R L s ≠ 0 → Algebra.Etale L (TensorProduct R L (integralClosure R E)) →
      Nonempty (integralClosure L (TensorProduct R L E) ≃ₐ[L]
        TensorProduct R L (integralClosure R E)) := by
    intro L _ _ _ _ ht hNet
    haveI : Module.Flat L (TensorProduct R L (integralClosure R E)) := Algebra.Smooth.flat _ _
    haveI : Algebra.IsIntegral L (TensorProduct R L (integralClosure R E)) :=
      Algebra.IsIntegral.tensorProduct R L (integralClosure R E)
    obtain ⟨τ, hτ⟩ : ∃ τ, τ = algebraMap R (TensorProduct R L (integralClosure R E)) s :=
      ⟨_, rfl⟩
    have htn : τ ∈ nonZeroDivisors (TensorProduct R L (integralClosure R E)) := by
      have hreg0 : IsSMulRegular L (algebraMap R L s) :=
        fun a b h => mul_left_cancel₀ ht h
      have hreg : IsSMulRegular (TensorProduct R L (integralClosure R E))
          (algebraMap L (TensorProduct R L (integralClosure R E)) (algebraMap R L s)) :=
        IsSMulRegular.of_flat hreg0
      have h1 : ∀ x : TensorProduct R L (integralClosure R E), τ * x = 0 → x = 0 := by
        intro x hx
        apply hreg
        change algebraMap L (TensorProduct R L (integralClosure R E)) (algebraMap R L s) * x =
          algebraMap L (TensorProduct R L (integralClosure R E)) (algebraMap R L s) * 0
        rw [mul_zero, ← IsScalarTower.algebraMap_apply, ← hτ]
        exact hx
      exact mem_nonZeroDivisors_iff.mpr ⟨h1, fun x hx => h1 x (by rw [mul_comm]; exact hx)⟩
    have hnorm : ∀ (P : Ideal (TensorProduct R L (integralClosure R E))) [P.IsPrime],
        IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P) :=
      fun P _ => wc_pks_etale_localization_normal L _ P

    let ι : TensorProduct R L (integralClosure R E) →ₐ[L] Localization.Away τ :=
      IsScalarTower.toAlgHom L _ _
    have hιinj : Function.Injective ι := fun a b h =>
      IsLocalization.injective (Localization.Away τ) ((Submonoid.powers_le).mpr htn) h
    have hrange : ι.range = integralClosure L (Localization.Away τ) := by
      ext y
      constructor
      · rintro ⟨b, rfl⟩
        exact (Algebra.IsIntegral.isIntegral b).map ι
      · intro hy
        obtain ⟨b, hb⟩ := wcfd_tn_locally_normal_away_closed _ hnorm τ htn y
          (IsIntegral.tower_top (A := TensorProduct R L (integralClosure R E)) hy)
        exact ⟨b, hb⟩
    let e4 : TensorProduct R L (integralClosure R E) ≃ₐ[L] integralClosure L (Localization.Away τ) :=
      (AlgEquiv.ofInjective ι hιinj).trans (Subalgebra.equivOfEq _ _ hrange)

    have hτunit : IsUnit (algebraMap _ (Localization.Away τ) τ) :=
      IsLocalization.Away.algebraMap_isUnit τ
    have hg0 : ∀ y : Algebra.algebraMapSubmonoid (integralClosure R E) (Submonoid.powers s),
        IsUnit (((algebraMap (TensorProduct R L (integralClosure R E)) (Localization.Away τ)).comp
          (Algebra.TensorProduct.includeRight : integralClosure R E →ₐ[R]
            TensorProduct R L (integralClosure R E)).toRingHom) y) := by
      intro y
      obtain ⟨z, hz, hzy⟩ := y.2
      obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hz
      rw [RingHom.comp_apply, ← hzy, map_pow, map_pow, map_pow]
      have : (Algebra.TensorProduct.includeRight : integralClosure R E →ₐ[R]
            TensorProduct R L (integralClosure R E)).toRingHom (algebraMap R (integralClosure R E) s)
            = τ := by
        rw [hτ]
        exact (Algebra.TensorProduct.includeRight : integralClosure R E →ₐ[R]
            TensorProduct R L (integralClosure R E)).commutes s
      rw [this]
      exact hτunit.pow n
    let g0 : E →+* Localization.Away τ :=
      IsLocalization.lift (M := Algebra.algebraMapSubmonoid (integralClosure R E) (Submonoid.powers s)) hg0
    have hg0c : ∀ c : integralClosure R E, g0 (algebraMap (integralClosure R E) E c) =
        algebraMap _ (Localization.Away τ) (TensorProduct.tmul R (1 : L) c) :=
      fun c => IsLocalization.lift_eq hg0 c
    let g : E →ₐ[R] Localization.Away τ :=
      { toRingHom := g0
        commutes' := fun r => by
          show g0 (algebraMap R E r) = _
          rw [IsScalarTower.algebraMap_apply R (integralClosure R E) E, hg0c,
            ← Algebra.TensorProduct.algebraMap_apply',
            ← IsScalarTower.algebraMap_apply] }
    let ψ : TensorProduct R L E →ₐ[L] Localization.Away τ :=
      Algebra.TensorProduct.lift (Algebra.ofId L _) g (fun _ _ => Commute.all _ _)
    let j : TensorProduct R L (integralClosure R E) →ₐ[L] TensorProduct R L E :=
      Algebra.TensorProduct.map (AlgHom.id L L) (integralClosure R E).val
    have hjτ : IsUnit (j τ) := by
      have : j τ = Algebra.TensorProduct.includeRight (algebraMap R E s) := by
        rw [hτ, Algebra.TensorProduct.algebraMap_apply', Algebra.TensorProduct.map_tmul,
          Algebra.TensorProduct.includeRight_apply, map_one, AlgHom.commutes]
      rw [this]
      exact hEs.map _
    have hjpow : ∀ y : Submonoid.powers τ, IsUnit (j.toRingHom y) := by
      rintro ⟨y, n, rfl⟩
      show IsUnit (j (τ ^ n))
      rw [map_pow]
      exact hjτ.pow n
    let φ0 : Localization.Away τ →+* TensorProduct R L E := IsLocalization.lift hjpow
    have hφ0 : ∀ b, φ0 (algebraMap _ (Localization.Away τ) b) = j b :=
      fun b => IsLocalization.lift_eq hjpow b
    let φ : Localization.Away τ →ₐ[L] TensorProduct R L E :=
      { toRingHom := φ0
        commutes' := fun l => by
          show φ0 (algebraMap L (Localization.Away τ) l) = _
          rw [IsScalarTower.algebraMap_apply L (TensorProduct R L (integralClosure R E))
            (Localization.Away τ), hφ0, j.commutes] }
    have hψj : ψ.comp j = IsScalarTower.toAlgHom L _ (Localization.Away τ) := by
      apply Algebra.TensorProduct.ext'
      intro l c
      rw [AlgHom.comp_apply, Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.lift_tmul,
        IsScalarTower.coe_toAlgHom', AlgHom.id_apply, Algebra.ofId_apply]
      show algebraMap L (Localization.Away τ) l * g0 (algebraMap (integralClosure R E) E c) = _
      rw [hg0c, IsScalarTower.algebraMap_apply L (TensorProduct R L (integralClosure R E))
        (Localization.Away τ), ← map_mul, Algebra.TensorProduct.algebraMap_apply,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rfl
    have h1 : ψ.comp φ = AlgHom.id L (Localization.Away τ) := by
      apply AlgHom.coe_ringHom_injective
      apply IsLocalization.ringHom_ext (Submonoid.powers τ)
      refine RingHom.ext fun b => ?_
      show ψ (φ0 (algebraMap _ (Localization.Away τ) b)) = algebraMap _ (Localization.Away τ) b
      rw [hφ0]
      exact AlgHom.congr_fun hψj b
    have hφg : φ0.comp g0 = (Algebra.TensorProduct.includeRight :
        E →ₐ[R] TensorProduct R L E).toRingHom := by
      apply IsLocalization.ringHom_ext
        (Algebra.algebraMapSubmonoid (integralClosure R E) (Submonoid.powers s))
      refine RingHom.ext fun c => ?_
      show φ0 (g0 (algebraMap _ E c)) = Algebra.TensorProduct.includeRight (algebraMap _ E c)
      rw [hg0c, hφ0, Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.includeRight_apply,
        AlgHom.id_apply]
      rfl
    have h2 : φ.comp ψ = AlgHom.id L (TensorProduct R L E) := by
      apply Algebra.TensorProduct.ext'
      intro l e
      rw [AlgHom.comp_apply, Algebra.TensorProduct.lift_tmul, map_mul, AlgHom.id_apply,
        Algebra.ofId_apply, AlgHom.commutes, Algebra.TensorProduct.algebraMap_apply]
      have := RingHom.congr_fun hφg e
      show TensorProduct.tmul R l (1 : E) * φ0 (g0 e) = _
      rw [RingHom.comp_apply] at this
      rw [this]
      show TensorProduct.tmul R l (1 : E) * TensorProduct.tmul R (1 : L) e = _
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    let ψe : TensorProduct R L E ≃ₐ[L] Localization.Away τ := AlgEquiv.ofAlgHom ψ φ h1 h2
    exact ⟨ψe.mapIntegralClosure.trans e4.symm⟩

  have hPm : Q.comap (Ideal.Quotient.mk (Ideal.span {f})) < IsLocalRing.maximalIdeal R := by
    refine lt_of_le_of_ne (IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)) ?_
    intro heq
    obtain ⟨x, hxm, hxQ⟩ := SetLike.exists_of_lt hQ
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
    apply hxQ
    have hy : y ∈ IsLocalRing.maximalIdeal R := by
      by_contra h
      have hu : IsUnit y := by
        by_contra h'
        exact h ((IsLocalRing.mem_maximalIdeal y).mpr h')
      exact (IsLocalRing.mem_maximalIdeal _).mp hxm (hu.map _)
    rw [← heq] at hy
    exact hy
  haveI hetP := hET _ hPm
  letI algPL : Algebra (Localization.AtPrime (Q.comap (Ideal.Quotient.mk (Ideal.span {f}))))
      (Localization.AtPrime Q) :=
    (Localization.localRingHom (Q.comap (Ideal.Quotient.mk (Ideal.span {f}))) Q
      (Ideal.Quotient.mk (Ideal.span {f})) rfl).toAlgebra
  haveI : IsScalarTower R (Localization.AtPrime (Q.comap (Ideal.Quotient.mk (Ideal.span {f}))))
      (Localization.AtPrime Q) := by
    apply IsScalarTower.of_algebraMap_eq
    intro x
    show _ = Localization.localRingHom (Q.comap (Ideal.Quotient.mk (Ideal.span {f}))) Q
      (Ideal.Quotient.mk (Ideal.span {f})) rfl (algebraMap R _ x)
    rw [Localization.localRingHom_to_map, IsScalarTower.algebraMap_apply R (R ⧸ Ideal.span {f})
      (Localization.AtPrime Q)]
    rfl
  haveI hNet : Algebra.Etale (Localization.AtPrime Q)
      (TensorProduct R (Localization.AtPrime Q) (integralClosure R E)) := by
    haveI := Algebra.Etale.baseChange
      (Localization.AtPrime (Q.comap (Ideal.Quotient.mk (Ideal.span {f}))))
      (TensorProduct R (Localization.AtPrime (Q.comap (Ideal.Quotient.mk (Ideal.span {f}))))
        (integralClosure R E)) (Localization.AtPrime Q)
    let eC : TensorProduct (Localization.AtPrime (Q.comap (Ideal.Quotient.mk (Ideal.span {f}))))
        (Localization.AtPrime Q)
        (TensorProduct R (Localization.AtPrime (Q.comap (Ideal.Quotient.mk (Ideal.span {f}))))
          (integralClosure R E)) ≃ₐ[Localization.AtPrime Q]
        TensorProduct R (Localization.AtPrime Q) (integralClosure R E) :=
      Algebra.TensorProduct.cancelBaseChange R
        (Localization.AtPrime (Q.comap (Ideal.Quotient.mk (Ideal.span {f}))))
        (Localization.AtPrime Q) (Localization.AtPrime Q) (integralClosure R E)
    exact Algebra.Etale.of_equiv (R := Localization.AtPrime Q)
      (A := TensorProduct (Localization.AtPrime (Q.comap (Ideal.Quotient.mk (Ideal.span {f}))))
        (Localization.AtPrime Q)
        (TensorProduct R (Localization.AtPrime (Q.comap (Ideal.Quotient.mk (Ideal.span {f}))))
          (integralClosure R E)))
      (B := TensorProduct R (Localization.AtPrime Q) (integralClosure R E)) eC

  obtain ⟨hRbreg, -⟩ := wc_rl_quot_regular wc_rl_quot_embdim R inferInstance f hfm hfm2
  have hLreg : IsRegularLocalRing (Localization.AtPrime Q) :=
    wc_hnas_pfc_regular_localization (R ⧸ Ideal.span {f}) hRbreg Q
  haveI := hLreg
  obtain ⟨hLdom, hLufd⟩ := wc_fco_regular_local_ufd (Localization.AtPrime Q)
  haveI := hLdom
  haveI := hLufd

  have ht : algebraMap R (Localization.AtPrime Q) s ≠ 0 := by
    rw [IsScalarTower.algebraMap_apply R (R ⧸ Ideal.span {f}) (Localization.AtPrime Q)]
    intro h
    have hinj : Function.Injective (algebraMap (R ⧸ Ideal.span {f}) (Localization.AtPrime Q)) :=
      IsLocalization.injective (Localization.AtPrime Q) (Ideal.primeCompl_le_nonZeroDivisors Q)
    apply hsf
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    exact hinj (by rw [map_zero]; exact h)
  obtain ⟨α⟩ := key (Localization.AtPrime Q) ht hNet

  let β₁ := AlgEquiv.ofBijective
    (TensorProduct.toIntegralClosure (R ⧸ Ideal.span {f}) (Localization.AtPrime Q)
      (TensorProduct R (R ⧸ Ideal.span {f}) E))
    (TensorProduct.toIntegralClosure_bijective_of_isLocalization Q.primeCompl)
  let eE : TensorProduct (R ⧸ Ideal.span {f}) (Localization.AtPrime Q)
      (TensorProduct R (R ⧸ Ideal.span {f}) E) ≃ₐ[Localization.AtPrime Q]
      TensorProduct R (Localization.AtPrime Q) E :=
    Algebra.TensorProduct.cancelBaseChange R (R ⧸ Ideal.span {f})
      (Localization.AtPrime Q) (Localization.AtPrime Q) E
  let β₂ := AlgEquiv.mapIntegralClosure (R := Localization.AtPrime Q)
    (A := TensorProduct (R ⧸ Ideal.span {f}) (Localization.AtPrime Q)
      (TensorProduct R (R ⧸ Ideal.span {f}) E))
    (S := TensorProduct R (Localization.AtPrime Q) E) eE
  exact Algebra.Etale.of_equiv ((β₁.trans β₂).trans α).symm

theorem wc_pps_hartogs_kernel : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R] (s : R), s ≠ 0 → ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra (Localization.Away s) E] [IsScalarTower R (Localization.Away s) E] [Algebra.Etale (Localization.Away s) E] [Module.Finite (Localization.Away s) E] (f : R) [(Ideal.span {f}).IsPrime], s ∉ Ideal.span {f} → ∀ (c : integralClosure R E), TensorProduct.tmul R (1 : R ⧸ Ideal.span {f}) (c : E) = 0 → ∃ c' : integralClosure R E, (c : E) = f • (c' : E) :=
by
  intro R _ _ _ s hs E _ _ _ _ _ _ f hfp hsf c hc
  classical
  obtain ⟨-, hufd⟩ := wc_fco_regular_local_ufd R
  haveI : UniqueFactorizationMonoid R := hufd
  haveI : IsIntegrallyClosed R := UniqueFactorizationMonoid.instIsIntegrallyClosed

  obtain ⟨e, hce⟩ : ∃ e : E, f • e = (c : E) := by
    have h1 := TensorProduct.quotTensorEquivQuotSMul_mk_tmul (Ideal.span {f}) (1 : R) (c : E)
    rw [map_one, hc, map_zero, one_smul] at h1
    have h2 : (c : E) ∈ Ideal.span {f} • (⊤ : Submodule R E) :=
      (Submodule.Quotient.mk_eq_zero _).mp h1.symm
    rw [Submodule.ideal_span_singleton_smul] at h2
    obtain ⟨e, -, he⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp h2
    exact ⟨e, he⟩

  by_cases hf0 : f = 0
  · refine ⟨0, ?_⟩
    rw [← hce, hf0, zero_smul, zero_smul]
  have hfprime : Prime f := (Ideal.span_singleton_prime hf0).mp hfp

  have heint : IsIntegral (Localization.Away s) e := Algebra.IsIntegral.isIntegral e
  obtain ⟨m, hm⟩ :=
    IsIntegral.exists_multiple_integral_of_isLocalization (Submonoid.powers s) e heint
  obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp m.2
  rw [Submonoid.smul_def] at hm
  have ht0 : (m : R) ≠ 0 := by rw [← hk]; exact pow_ne_zero _ hs
  have hft : ¬ f ∣ (m : R) := by
    rw [← hk]; intro h
    exact hsf (Ideal.mem_span_singleton.mpr (hfprime.dvd_of_dvd_pow h))

  have hinj : Function.Injective
      (algebraMap E (Localization (Algebra.algebraMapSubmonoid E (nonZeroDivisors R)))) := by
    apply IsLocalization.injective _ (M := Algebra.algebraMapSubmonoid E (nonZeroDivisors R))
    rintro _ ⟨r, hr, rfl⟩
    have hpow : Submonoid.powers s ≤ nonZeroDivisors R :=
      powers_le_nonZeroDivisors_of_noZeroDivisors hs
    have : IsDomain (Localization.Away s) := IsLocalization.isDomain_localization hpow
    have hr0 : r ≠ 0 := nonZeroDivisors.ne_zero hr
    have hρ : algebraMap R (Localization.Away s) r ≠ 0 := by
      intro h
      apply hr0
      apply IsLocalization.injective (Localization.Away s) hpow
      rw [h, map_zero]
    have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := E)
      (mem_nonZeroDivisors_of_ne_zero hρ)
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    have h1 : algebraMap R (Localization.Away s) r • x = 0 := by
      rw [Algebra.smul_def, mul_comm, ← IsScalarTower.algebraMap_apply]
      exact hx
    exact hreg (h1.trans (smul_zero _).symm)
  let L := Localization (Algebra.algebraMapSubmonoid E (nonZeroDivisors R))
  let K := FractionRing R

  have s4 : ∀ (x : L), IsIntegral K x → ∀ (a : K), a ≠ 0 →
      minpoly K (a • x) = (minpoly K x).scaleRoots a := by
    intro x hx a ha
    have hax : IsIntegral K (a • x) := hx.smul a
    have hμ := minpoly.monic hx
    have hν := minpoly.monic hax
    have hsm : ((minpoly K x).scaleRoots a).Monic := by
      rw [Polynomial.Monic, Polynomial.leadingCoeff_scaleRoots]; exact hμ
    have hsν : ((minpoly K (a • x)).scaleRoots a⁻¹).Monic := by
      rw [Polynomial.Monic, Polynomial.leadingCoeff_scaleRoots]; exact hν
    have h1 : Polynomial.aeval (a • x) ((minpoly K x).scaleRoots a) = 0 := by
      rw [Algebra.smul_def]
      exact Polynomial.scaleRoots_aeval_eq_zero (minpoly.aeval K x)
    have h2 : Polynomial.aeval x ((minpoly K (a • x)).scaleRoots a⁻¹) = 0 := by
      have := Polynomial.scaleRoots_aeval_eq_zero (r := a⁻¹) (minpoly.aeval K (a • x))
      have e : algebraMap K L a⁻¹ * (a • x) = x := by
        rw [Algebra.smul_def, ← mul_assoc, ← map_mul, inv_mul_cancel₀ ha, map_one, one_mul]
      rwa [e] at this
    have hdvd : minpoly K (a • x) ∣ (minpoly K x).scaleRoots a := minpoly.dvd K _ h1
    have hdeg : (minpoly K x).degree ≤ ((minpoly K (a • x)).scaleRoots a⁻¹).degree :=
      minpoly.min K x hsν h2
    rw [Polynomial.degree_scaleRoots] at hdeg
    have hnat : (minpoly K x).natDegree ≤ (minpoly K (a • x)).natDegree :=
      Polynomial.natDegree_le_natDegree hdeg
    exact (Polynomial.eq_of_monic_of_dvd_of_natDegree_le hν hsm hdvd
      (by rw [Polynomial.natDegree_scaleRoots]; exact hnat)).symm

  have s5 : ∀ (y : L), IsIntegral K y →
      (IsIntegral R y ↔ ∀ i : ℕ, (minpoly K y).coeff i ∈ Set.range (algebraMap R K)) := by
    intro y hy
    have hμ := minpoly.monic hy
    constructor
    · rintro ⟨p, hp, hpy⟩
      have h1 : Polynomial.aeval y (p.map (algebraMap R K)) = 0 := by
        rw [Polynomial.aeval_map_algebraMap, Polynomial.aeval_def]; exact hpy
      have hdvd : minpoly K y ∣ p.map (algebraMap R K) := minpoly.dvd K y h1
      obtain ⟨g', hg'⟩ := IsIntegrallyClosed.eq_map_mul_C_of_dvd K hp hdvd
      rw [hμ.leadingCoeff, Polynomial.C_1, mul_one] at hg'
      intro i
      exact ⟨g'.coeff i, by rw [← hg', Polynomial.coeff_map]⟩
    · intro h
      have hl : minpoly K y ∈ Polynomial.lifts (algebraMap R K) :=
        (Polynomial.lifts_iff_coeff_lifts _).mpr h
      obtain ⟨q, hq, -, hqm⟩ := Polynomial.lifts_and_degree_eq_and_monic hl hμ
      refine ⟨q, hqm, ?_⟩
      rw [← Polynomial.aeval_def, ← Polynomial.aeval_map_algebraMap K, hq, minpoly.aeval]
  have hKinj := IsFractionRing.injective R K

  have s6 : ∀ (κ : K) (p : ℕ),
      κ * algebraMap R K f ^ p ∈ Set.range (algebraMap R K) →
      κ * algebraMap R K (m : R) ^ p ∈ Set.range (algebraMap R K) →
      κ ∈ Set.range (algebraMap R K) := by
    rintro κ p ⟨a, ha⟩ ⟨b, hb⟩
    have h1 : a * (m : R) ^ p = b * f ^ p := by
      apply hKinj
      simp only [map_mul, map_pow]
      rw [ha, hb]
      ring
    have hft' : ¬ f ∣ (m : R) ^ p := fun h => hft (hfprime.dvd_of_dvd_pow h)
    have h2 : f ^ p ∣ (m : R) ^ p * a := ⟨b, by linear_combination h1⟩
    obtain ⟨a', ha'⟩ := hfprime.pow_dvd_of_dvd_mul_left p hft' h2
    refine ⟨a', ?_⟩
    have hf0' : algebraMap R K f ^ p ≠ 0 := pow_ne_zero _ (by
      rw [Ne, ← map_zero (algebraMap R K)]; exact fun h => hfprime.ne_zero (hKinj h))
    apply mul_right_cancel₀ hf0'
    rw [← ha, ha', map_mul, map_pow]
    ring

  have hsmul : ∀ r : R, algebraMap E L (r • e) = (algebraMap R K r) • algebraMap E L e := by
    intro r
    rw [Algebra.smul_def, Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply R E L,
      ← IsScalarTower.algebraMap_apply R K L]
  have hF0 : algebraMap R K f ≠ 0 := by
    rw [Ne, ← map_zero (algebraMap R K)]; exact fun h => hf0 (hKinj h)
  have hT0 : algebraMap R K (m : R) ≠ 0 := by
    rw [Ne, ← map_zero (algebraMap R K)]; exact fun h => ht0 (hKinj h)
  have hcint : IsIntegral R (c : E) := c.2
  have hFxR : IsIntegral R (algebraMap R K f • algebraMap E L e) := by
    rw [← hsmul, hce]; exact hcint.algebraMap
  have hTxR : IsIntegral R (algebraMap R K (m : R) • algebraMap E L e) := by
    rw [← hsmul]; exact hm.algebraMap
  have hFxK : IsIntegral K (algebraMap R K f • algebraMap E L e) := hFxR.tower_top
  have hTxK : IsIntegral K (algebraMap R K (m : R) • algebraMap E L e) := hTxR.tower_top
  have hxK : IsIntegral K (algebraMap E L e) := by
    have := hTxK.smul (algebraMap R K (m : R))⁻¹
    rwa [inv_smul_smul₀ hT0] at this
  have hcoef := (s5 _ hFxK).mp hFxR
  have hcoefT := (s5 _ hTxK).mp hTxR
  rw [s4 _ hxK _ hF0] at hcoef
  rw [s4 _ hxK _ hT0] at hcoefT
  have hxR : IsIntegral R (algebraMap E L e) := by
    rw [s5 _ hxK]
    intro i
    have h1 := hcoef i
    have h2 := hcoefT i
    rw [Polynomial.coeff_scaleRoots] at h1 h2
    exact s6 _ _ h1 h2
  have heR : IsIntegral R e :=
    (isIntegral_algHom_iff (x := e) (IsScalarTower.toAlgHom R E L) hinj).mp hxR
  exact ⟨⟨e, heR⟩, by rw [← hce]⟩

theorem wc_pls_regular_triple : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R], 3 ≤ (IsLocalRing.maximalIdeal R).height → ∀ (f : R), f ∈ IsLocalRing.maximalIdeal R → f ∉ IsLocalRing.maximalIdeal R ^ 2 → ∃ a b : R, a ∈ IsLocalRing.maximalIdeal R ∧ b ∈ IsLocalRing.maximalIdeal R ∧ a ∉ Ideal.span {f} ∧ (∀ (n M : ℕ) (z : R), a ^ M * z ∈ Ideal.span {f ^ n} → z ∈ Ideal.span {f ^ n}) ∧ (∀ (n M N : ℕ) (z : R), b ^ N * z ∈ Ideal.span {f ^ n, a ^ M} → z ∈ Ideal.span {f ^ n, a ^ M}) ∧ (∀ (n : ℕ) (z : R), b * z ∈ Ideal.span {f ^ n} → z ∈ Ideal.span {f ^ n}) :=
by
  intro R _ _ _ h3 f hf hf2
  classical
  haveI : IsNoetherianRing R := IsRegularLocalRing.toIsNoetherian

  have lemP : ∀ (J : Ideal R) (x y : R), (∀ z : R, x * z ∈ J → z ∈ J) →
      (∀ z : R, y * z ∈ J ⊔ Ideal.span {x} → z ∈ J ⊔ Ideal.span {x}) →
      ∀ (n : ℕ) (z : R), y * z ∈ J ⊔ Ideal.span {x ^ n} → z ∈ J ⊔ Ideal.span {x ^ n} := by
    intro J x y hx hy n
    induction n with
    | zero => intro z _; simp
    | succ n ih =>
      intro z hz
      obtain ⟨j, hj, t, ht, hjt⟩ := Submodule.mem_sup.mp hz
      obtain ⟨w, rfl⟩ := Ideal.mem_span_singleton'.mp ht
      have h1 : y * z ∈ J ⊔ Ideal.span {x} := by
        rw [← hjt]
        exact Submodule.add_mem_sup hj (Ideal.mem_span_singleton'.mpr ⟨w * x ^ n, by ring⟩)
      obtain ⟨j', hj', t', ht', hjt'⟩ := Submodule.mem_sup.mp (hy z h1)
      obtain ⟨z1, rfl⟩ := Ideal.mem_span_singleton'.mp ht'
      have h2 : x * (y * z1 - x ^ n * w) ∈ J := by
        have e : y * (j' + z1 * x) = j + w * x ^ (n + 1) := by rw [hjt', hjt]
        have : x * (y * z1 - x ^ n * w) = j - y * j' := by linear_combination e
        rw [this]
        exact J.sub_mem hj (J.mul_mem_left _ hj')
      have h3 := hx _ h2
      have h4 : y * z1 ∈ J ⊔ Ideal.span {x ^ n} := by
        have : y * z1 = (y * z1 - x ^ n * w) + w * x ^ n := by ring
        rw [this]
        exact Submodule.add_mem_sup h3 (Ideal.mem_span_singleton'.mpr ⟨w, rfl⟩)
      obtain ⟨j'', hj'', t'', ht'', hjt''⟩ := Submodule.mem_sup.mp (ih z1 h4)
      obtain ⟨v, rfl⟩ := Ideal.mem_span_singleton'.mp ht''
      rw [← hjt', ← hjt'']
      have : j' + (j'' + v * x ^ n) * x = (j' + x * j'') + v * x ^ (n + 1) := by ring
      rw [this]
      exact Submodule.add_mem_sup (J.add_mem hj' (J.mul_mem_left _ hj''))
        (Ideal.mem_span_singleton'.mpr ⟨v, rfl⟩)

  have lemPow : ∀ (I : Ideal R) (y : R), (∀ z : R, y * z ∈ I → z ∈ I) →
      ∀ (N : ℕ) (z : R), y ^ N * z ∈ I → z ∈ I := by
    intro I y hy N
    induction N with
    | zero => intro z hz; simpa using hz
    | succ N ih =>
      intro z hz
      exact hy z (ih (y * z) (by rw [pow_succ, mul_assoc] at hz; exact hz))

  have hdim : 3 ≤ Module.finrank (IsLocalRing.ResidueField R) (IsLocalRing.CotangentSpace R) := by
    have e1 := IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace R
    have e2 : ((Submodule.spanFinrank (IsLocalRing.maximalIdeal R) : ℕ) : WithBot ℕ∞) =
        ringKrullDim R := IsRegularLocalRing.spanFinrank_maximalIdeal
    have e3 : ((IsLocalRing.maximalIdeal R).height : WithBot ℕ∞) = ringKrullDim R :=
      IsLocalRing.maximalIdeal_height_eq_ringKrullDim
    have hh : (IsLocalRing.maximalIdeal R).height =
        ((Module.finrank (IsLocalRing.ResidueField R) (IsLocalRing.CotangentSpace R) : ℕ) : ℕ∞) := by
      apply WithBot.coe_injective
      rw [e3, ← e2, e1]
      norm_cast
    rw [hh] at h3
    exact_mod_cast h3

  have hf0 : (IsLocalRing.maximalIdeal R).toCotangent ⟨f, hf⟩ ≠ 0 :=
    fun h => hf2 ((Ideal.toCotangent_eq_zero _ _).mp h)
  obtain ⟨u, hu⟩ := exists_linearIndependent_pair_of_one_lt_finrank
    (R := IsLocalRing.ResidueField R) (M := IsLocalRing.CotangentSpace R) (by omega) hf0
  obtain ⟨w, hw⟩ := exists_linearIndependent_snoc_of_lt_finrank hu (by omega)
  obtain ⟨⟨a, ha⟩, rfl⟩ := Ideal.toCotangent_surjective _ u
  obtain ⟨⟨b, hb⟩, rfl⟩ := Ideal.toCotangent_surjective _ w

  have haf : a ∉ Ideal.span {f} := by
    intro h
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h
    have e : (⟨a, ha⟩ : IsLocalRing.maximalIdeal R) = c • ⟨f, hf⟩ :=
      Subtype.ext (by rw [Submodule.coe_smul, smul_eq_mul]; exact hc.symm)
    have h2 := LinearIndependent.pair_iff.mp hu
      (algebraMap R (IsLocalRing.ResidueField R) c) (-1)
      (by rw [e, map_smul, algebraMap_smul, neg_one_smul, add_neg_cancel])
    exact one_ne_zero (neg_eq_zero.mp h2.2)
  have hfa : f ∉ Ideal.span {a} := by
    intro h
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h
    have e : (⟨f, hf⟩ : IsLocalRing.maximalIdeal R) = c • ⟨a, ha⟩ :=
      Subtype.ext (by rw [Submodule.coe_smul, smul_eq_mul]; exact hc.symm)
    have h2 := LinearIndependent.pair_iff.mp hu
      (-1) (algebraMap R (IsLocalRing.ResidueField R) c)
      (by rw [e, map_smul, algebraMap_smul, neg_one_smul, neg_add_cancel])
    exact one_ne_zero (neg_eq_zero.mp h2.1)
  have hbfa : b ∉ Ideal.span {f, a} := by
    intro h
    obtain ⟨r, s, hrs⟩ := Ideal.mem_span_pair.mp h
    have e : (⟨b, hb⟩ : IsLocalRing.maximalIdeal R) = r • ⟨f, hf⟩ + s • ⟨a, ha⟩ :=
      Subtype.ext (by
        simp only [Submodule.coe_add, Submodule.coe_smul, smul_eq_mul]
        exact hrs.symm)
    apply (linearIndependent_finSnoc.mp hw).2
    rw [e, map_add, map_smul, map_smul]
    exact Submodule.add_mem _ (Submodule.smul_of_tower_mem _ r (Submodule.subset_span ⟨0, rfl⟩))
      (Submodule.smul_of_tower_mem _ s (Submodule.subset_span ⟨1, rfl⟩))
  have hbf : b ∉ Ideal.span {f} := fun h =>
    hbfa (Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _)) h)

  have fne : f ≠ 0 := by
    rintro rfl
    exact hf2 (Ideal.zero_mem _)
  have ha2 : a ∉ IsLocalRing.maximalIdeal R ^ 2 := by
    intro h
    have h1 := hu.ne_zero 1
    exact absurd h (by simpa [Ideal.toCotangent_eq_zero] using h1)
  have ane : a ≠ 0 := by
    rintro rfl
    exact ha2 (Ideal.zero_mem _)
  have hPQ : ∀ g : R, g ∈ IsLocalRing.maximalIdeal R → g ∉ IsLocalRing.maximalIdeal R ^ 2 →
      (Ideal.span {g}).IsPrime := by
    intro g hg hg2
    let v : Fin 1 → IsLocalRing.maximalIdeal R := fun _ => ⟨g, hg⟩
    have hLI : LinearIndependent (IsLocalRing.ResidueField R)
        (fun i => (IsLocalRing.maximalIdeal R).toCotangent (v i)) := by
      rw [linearIndependent_unique_iff]
      intro h0
      exact hg2 ((Ideal.toCotangent_eq_zero _ _).mp h0)
    have hrange1 : Set.range (fun i => ((v i : IsLocalRing.maximalIdeal R) : R)) = {g} :=
      Set.range_const
    have key := (wcpa_rs_quotient_regular R 1 v hLI).1
    rw [hrange1] at key
    haveI := key
    exact (Ideal.Quotient.isDomain_iff_prime _).mp (wc_fco_regular_local_ufd (R ⧸ Ideal.span {g})).1
  have Pf : (Ideal.span {f}).IsPrime := hPQ f hf hf2
  have Pa : (Ideal.span {a}).IsPrime := hPQ a ha ha2
  have hLI2 : LinearIndependent (IsLocalRing.ResidueField R) (fun i =>
      (IsLocalRing.maximalIdeal R).toCotangent
        ((![⟨f, hf⟩, ⟨a, ha⟩] : Fin 2 → IsLocalRing.maximalIdeal R) i)) := by
    have e : (fun i => (IsLocalRing.maximalIdeal R).toCotangent
        ((![⟨f, hf⟩, ⟨a, ha⟩] : Fin 2 → IsLocalRing.maximalIdeal R) i)) =
        ![(IsLocalRing.maximalIdeal R).toCotangent ⟨f, hf⟩,
          (IsLocalRing.maximalIdeal R).toCotangent ⟨a, ha⟩] := by
      funext i; fin_cases i <;> rfl
    rw [e]; exact hu
  have hrange : Set.range (fun i => (((![⟨f, hf⟩, ⟨a, ha⟩] : Fin 2 → IsLocalRing.maximalIdeal R) i :
      IsLocalRing.maximalIdeal R) : R)) = {f, a} := by
    ext z; simp [Fin.exists_fin_two, eq_comm]
  obtain ⟨hreg, -⟩ := wcpa_rs_quotient_regular R 2 ![⟨f, hf⟩, ⟨a, ha⟩] hLI2
  rw [hrange] at hreg
  haveI := hreg
  have Pfa : (Ideal.span {f, a}).IsPrime :=
    (Ideal.Quotient.isDomain_iff_prime _).mp (wc_fco_regular_local_ufd (R ⧸ Ideal.span {f, a})).1

  have R0 : ∀ z : R, f * z ∈ (⊥ : Ideal R) → z ∈ (⊥ : Ideal R) := by
    intro z hz
    rw [Ideal.mem_bot] at hz ⊢
    exact (mul_eq_zero.mp hz).resolve_left fne
  have R1 : ∀ z : R, a * z ∈ (⊥ : Ideal R) ⊔ Ideal.span {f} → z ∈ (⊥ : Ideal R) ⊔ Ideal.span {f} := by
    intro z hz
    rw [bot_sup_eq] at hz ⊢
    exact (Pf.mem_or_mem hz).resolve_left haf
  have R2 : ∀ z : R, b * z ∈ (⊥ : Ideal R) ⊔ Ideal.span {f} → z ∈ (⊥ : Ideal R) ⊔ Ideal.span {f} := by
    intro z hz
    rw [bot_sup_eq] at hz ⊢
    exact (Pf.mem_or_mem hz).resolve_left hbf
  have R3 : ∀ z : R, f * z ∈ Ideal.span {a} → z ∈ Ideal.span {a} := by
    intro z hz
    exact (Pa.mem_or_mem hz).resolve_left hfa
  have hsup : Ideal.span {a} ⊔ Ideal.span {f} = Ideal.span {f, a} := by
    rw [Ideal.span_insert, sup_comm]
  have R4 : ∀ z : R, b * z ∈ Ideal.span {a} ⊔ Ideal.span {f} → z ∈ Ideal.span {a} ⊔ Ideal.span {f} := by
    intro z hz
    rw [hsup] at hz ⊢
    exact (Pfa.mem_or_mem hz).resolve_left hbfa

  have hA1' : ∀ (n : ℕ) (z : R), a * z ∈ Ideal.span {f ^ n} → z ∈ Ideal.span {f ^ n} := by
    intro n z hz
    have := lemP ⊥ f a R0 R1 n z (by rw [bot_sup_eq]; exact hz)
    rwa [bot_sup_eq] at this
  have hQ : ∀ (n : ℕ) (z : R), b * z ∈ Ideal.span {a} ⊔ Ideal.span {f ^ n} →
      z ∈ Ideal.span {a} ⊔ Ideal.span {f ^ n} := lemP (Ideal.span {a}) f b R3 R4
  refine ⟨a, b, ha, hb, haf, ?_, ?_, ?_⟩
  · intro n M z hz
    exact lemPow _ a (hA1' n) M z hz
  · intro n M N z hz
    have hQn : ∀ z : R, b * z ∈ Ideal.span {f ^ n} ⊔ Ideal.span {a} →
        z ∈ Ideal.span {f ^ n} ⊔ Ideal.span {a} := by
      intro z hz
      rw [sup_comm] at hz ⊢
      exact hQ n z hz
    have hP2 := lemP (Ideal.span {f ^ n}) a b (hA1' n) hQn M
    rw [Ideal.span_insert] at hz ⊢
    exact lemPow _ b hP2 N z hz
  · intro n z hz
    have := lemP ⊥ f b R0 R2 n z (by rw [bot_sup_eq]; exact hz)
    rwa [bot_sup_eq] at this

theorem wc_pss_torsionfree_embed : ∀ (R : Type u) [CommRing R] [IsDomain R] (N : Type u) [AddCommGroup N] [Module R N] [Module.Finite R N], (∀ (r : R) (x : N), r ≠ 0 → r • x = 0 → x = 0) → ∃ (n : ℕ) (ι : N →ₗ[R] (Fin n → R)), Function.Injective ι :=
by
  intro R _ _ N _ _ _ htf
  classical
  obtain ⟨k, g, hg⟩ := Module.Finite.exists_fin (R := R) (M := N)
  obtain ⟨S, hS, hmax⟩ := exists_maximal_linearIndepOn R g
  have ha : ∀ i, ∃ a : R, a ≠ 0 ∧ a • g i ∈ Submodule.span R (g '' S) := by
    intro i
    by_cases hi : i ∈ S
    · exact ⟨1, one_ne_zero, by
        rw [one_smul]; exact Submodule.subset_span (Set.mem_image_of_mem g hi)⟩
    · exact hmax i hi
  choose a ha0 haP using ha
  have hc0 : (∏ i, a i) ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => ha0 i)
  have hcg : ∀ i, (∏ i, a i) • g i ∈ Submodule.span R (g '' S) := by
    intro i
    rw [← Finset.prod_erase_mul _ _ (Finset.mem_univ i), mul_smul]
    exact Submodule.smul_mem _ _ (haP i)
  have hcx : ∀ x : N, (∏ i, a i) • x ∈ Submodule.span R (g '' S) := by
    intro x
    have hx : x ∈ Submodule.span R (Set.range g) := by rw [hg]; trivial
    induction hx using Submodule.span_induction with
    | mem y hy => obtain ⟨i, rfl⟩ := hy; exact hcg i
    | zero => rw [smul_zero]; exact Submodule.zero_mem _
    | add y z _ _ hy hz => rw [smul_add]; exact Submodule.add_mem _ hy hz
    | smul r y _ hy => rw [smul_comm]; exact Submodule.smul_mem _ r hy
  have hli : LinearIndependent R (fun s : S => g s) := hS.linearIndependent
  let b := Module.Basis.span hli
  have hrange : g '' S = Set.range (fun s : S => g s) := Set.image_eq_range g S
  let μ : N →ₗ[R] Submodule.span R (Set.range fun s : S => g s) :=
    LinearMap.codRestrict _ (LinearMap.lsmul R N (∏ i, a i))
      (fun x => by rw [LinearMap.lsmul_apply, ← hrange]; exact hcx x)
  have hμ : Function.Injective μ := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro x hx
    have h1 : ((μ x : Submodule.span R (Set.range fun s : S => g s)) : N) = 0 := by
      rw [hx]; rfl
    exact htf _ x hc0 h1
  let e := b.equivFun.trans (LinearEquiv.funCongrLeft R R (Fintype.equivFin S).symm)
  exact ⟨Fintype.card S, e.toLinearMap ∘ₗ μ, e.injective.comp hμ⟩

theorem wc_pss_local_divisibility : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R] (p : R), Prime p → ∀ [(Ideal.span {p}).IsPrime] [IsDiscreteValuationRing (Localization.AtPrime (Ideal.span {p}))] (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M], (∀ (r : R) (x : M), r ≠ 0 → r • x = 0 → x = 0) → ∀ x : M, (∀ φ : Module.Dual R M, p ∣ φ x) → ∃ (u : R) (y : M), ¬ p ∣ u ∧ u • x = p • y :=
by
  intro R _ _ _ p hp _ _ M _ _ _ hM x hx
  classical
  have hSnz : (Ideal.span {p}).primeCompl ≤ nonZeroDivisors R :=
    Ideal.primeCompl_le_nonZeroDivisors (Ideal.span {p})
  have : Module.IsTorsionFree R M := by
    rw [Module.isTorsionFree_iff_smul_eq_zero]
    intro r m h
    by_cases hr : r = 0
    · exact Or.inl hr
    · exact Or.inr (hM r m hr h)
  have : Module.IsTorsionFree (Localization.AtPrime (Ideal.span {p}))
      (LocalizedModule (Ideal.span {p}).primeCompl M) :=
    IsLocalizedModule.isTorsionFree (f := LocalizedModule.mkLinearMap (Ideal.span {p}).primeCompl M)
      (Ideal.span {p}).primeCompl
  have : Module.Free (Localization.AtPrime (Ideal.span {p}))
      (LocalizedModule (Ideal.span {p}).primeCompl M) :=
    Module.free_of_finite_type_torsion_free'
  let b := Module.Free.chooseBasis (Localization.AtPrime (Ideal.span {p}))
      (LocalizedModule (Ideal.span {p}).primeCompl M)
  obtain ⟨n, gen, hgen⟩ := Module.Finite.exists_fin (R := R) (M := M)
  let g : Module.Free.ChooseBasisIndex (Localization.AtPrime (Ideal.span {p}))
      (LocalizedModule (Ideal.span {p}).primeCompl M) → M →ₗ[R] Localization.AtPrime (Ideal.span {p}) :=
    fun i => ((b.coord i).restrictScalars R) ∘ₗ LocalizedModule.mkLinearMap (Ideal.span {p}).primeCompl M
  obtain ⟨c, hc⟩ := IsLocalization.exist_integer_multiples (Ideal.span {p}).primeCompl
    (Finset.univ : Finset (_ × Fin n)) (fun ij => g ij.1 (gen ij.2))
  have hint : ∀ i m, IsLocalization.IsInteger R ((c : R) • g i m) := by
    intro i m
    have hm : m ∈ Submodule.span R (Set.range gen) := by rw [hgen]; trivial
    induction hm using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨j, rfl⟩ := hy
      exact hc (i, j) (Finset.mem_univ _)
    | zero => rw [map_zero, smul_zero]; exact IsLocalization.isInteger_zero
    | add y z _ _ hy hz => rw [map_add, smul_add]; exact IsLocalization.isInteger_add hy hz
    | smul a y _ hy => rw [map_smul, smul_comm]; exact IsLocalization.isInteger_smul hy
  have hint' : ∀ i m, ∃ r : R, algebraMap R (Localization.AtPrime (Ideal.span {p})) r =
      (c : R) • g i m := fun i m => RingHom.mem_rangeS.mp (hint i m)
  choose f hf using hint'
  have inj : Function.Injective (algebraMap R (Localization.AtPrime (Ideal.span {p}))) :=
    IsLocalization.injective (Localization.AtPrime (Ideal.span {p})) hSnz
  let φ : Module.Free.ChooseBasisIndex (Localization.AtPrime (Ideal.span {p}))
      (LocalizedModule (Ideal.span {p}).primeCompl M) → Module.Dual R M := fun i =>
    { toFun := f i
      map_add' := fun m m' => inj (by rw [map_add, hf i (m + m'), hf i m, hf i m', map_add, smul_add])
      map_smul' := fun a m => inj (by
        rw [hf i (a • m), RingHom.id_apply, smul_eq_mul, map_mul, hf i m, map_smul,
          ← Algebra.smul_def, smul_comm]) }
  have hr : ∀ i, ∃ r : R, f i x = p * r := fun i => hx (φ i)
  choose r hr using hr
  have hcoef : ∀ i, (c : R) • b.repr (LocalizedModule.mk x 1) i =
      algebraMap R (Localization.AtPrime (Ideal.span {p})) (p * r i) := by
    intro i
    rw [← hr i, hf i x]
    rfl
  have key : (c : R) • (LocalizedModule.mk x 1 : LocalizedModule (Ideal.span {p}).primeCompl M) =
      p • ∑ i, r i • b i := by
    conv_lhs => rw [← b.sum_repr (LocalizedModule.mk x 1)]
    rw [Finset.smul_sum, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [← smul_assoc, hcoef i, algebraMap_smul, mul_smul]
  generalize (∑ i, r i • b i) = w at key
  induction w using LocalizedModule.induction_on with
  | h z t =>
    rw [LocalizedModule.smul'_mk, LocalizedModule.smul'_mk, LocalizedModule.mk_eq] at key
    obtain ⟨v, hv⟩ := key
    refine ⟨(v : R) * (t : R) * (c : R), (v : R) • z, ?_, ?_⟩
    · have hmem : (v : R) * (t : R) * (c : R) ∈ (Ideal.span {p}).primeCompl :=
        Submonoid.mul_mem _ (Submonoid.mul_mem _ v.2 t.2) c.2
      intro hd
      exact (Ideal.mem_primeCompl_iff.mp hmem) (Ideal.mem_span_singleton.mpr hd)
    · simp only [Submonoid.smul_def, one_smul] at hv
      rw [mul_smul, mul_smul, hv, smul_comm (v : R) p z]

theorem wc_pss_etale_prime_division : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R] (s : R), s ≠ 0 → ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra (Localization.Away s) E] [IsScalarTower R (Localization.Away s) E] [Algebra.Etale (Localization.Away s) E] [Module.Finite (Localization.Away s) E] (π t : R), Prime π → ¬ π ∣ t → ∀ (x y : E), t • x = π • y → ∃ z : E, x = π • z :=
by
  intro R _ _ _ s _ E _ _ _ _ _ _ π t hπ hπt x y hxy
  classical
  haveI : Module.Flat (Localization.Away s) E := Algebra.Smooth.flat (Localization.Away s) E
  haveI : Module.Flat R E := Module.Flat.trans R (Localization.Away s) E
  have hsum : ∑ i, (![t, -π] : Fin 2 → R) i • (![x, y] : Fin 2 → E) i = 0 := by
    rw [Fin.sum_univ_two]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, neg_smul]
    rw [hxy, add_neg_cancel]
  obtain ⟨k, a, w, hv, hrel⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := R)
    (M := E) (f := (![t, -π] : Fin 2 → R)) (x := (![x, y] : Fin 2 → E)) (by exact hsum)
  have hdiv : ∀ j, π ∣ a 0 j := by
    intro j
    have h := hrel j
    rw [Fin.sum_univ_two] at h
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons] at h
    have h2 : t * a 0 j = π * a 1 j := by linear_combination h
    have h3 : π ∣ t * a 0 j := ⟨a 1 j, h2⟩
    exact (hπ.dvd_or_dvd h3).resolve_left hπt
  choose b hb using hdiv
  refine ⟨∑ j, b j • w j, ?_⟩
  have hx : x = ∑ j, a 0 j • w j := by
    have := hv 0
    simpa using this
  rw [hx, Finset.smul_sum]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [hb j, mul_smul]

theorem wc_pss_coprime_integral : ∀ (R : Type u) [CommRing R] [IsDomain R] [UniqueFactorizationMonoid R] (B : Type u) [CommRing B] [Algebra R B] [Module.Flat R B] (π t : R), Prime π → ¬ π ∣ t → ∀ (e : B), IsIntegral R (π • e) → IsIntegral R (t • e) → IsIntegral R e :=
by
  intro R _ _ _ B _ _ _ π t hπ hπt e hπe hte
  classical

  have s1 : ∀ (x : FractionRing R) (a b : ℕ),
      (∃ r : R, algebraMap R (FractionRing R) r = algebraMap R (FractionRing R) π ^ a * x) →
      (∃ r : R, algebraMap R (FractionRing R) r = algebraMap R (FractionRing R) t ^ b * x) →
      ∃ r : R, algebraMap R (FractionRing R) r = x := by
    intro x a b ⟨r₁, h₁⟩ ⟨r₂, h₂⟩
    have hx := IsFractionRing.mk'_num_den' R x
    have hred := IsFractionRing.num_den_reduced R x
    have hd0 : algebraMap R (FractionRing R) (IsFractionRing.den R x : R) ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors (IsFractionRing.den R x).2
    have hxd : x * algebraMap R (FractionRing R) (IsFractionRing.den R x : R) =
        algebraMap R (FractionRing R) (IsFractionRing.num R x) := (eq_div_iff hd0).mp hx.symm
    have key : ∀ (c : R) (k : ℕ) (r : R),
        algebraMap R (FractionRing R) r = algebraMap R (FractionRing R) c ^ k * x →
        (IsFractionRing.den R x : R) ∣ c ^ k := by
      intro c k r h
      have h' : algebraMap R (FractionRing R) (r * (IsFractionRing.den R x : R)) =
          algebraMap R (FractionRing R) (c ^ k * IsFractionRing.num R x) := by
        rw [map_mul, map_mul, map_pow, h, mul_assoc, hxd]
      have h2 := IsFractionRing.injective R (FractionRing R) h'
      have hdvd : (IsFractionRing.den R x : R) ∣ c ^ k * IsFractionRing.num R x :=
        ⟨r, by rw [← h2, mul_comm]⟩
      exact hred.symm.dvd_of_dvd_mul_right hdvd
    have hd1 := key π a r₁ h₁
    have hd2 := key t b r₂ h₂
    have hrel : IsRelPrime (π ^ a) (t ^ b) :=
      ((hπ.irreducible.isRelPrime_iff_not_dvd).mpr hπt).pow
    have hu : IsUnit (IsFractionRing.den R x : R) := hrel hd1 hd2
    obtain ⟨r, hr⟩ := (IsFractionRing.isUnit_den_iff x).mp hu
    exact ⟨r, hr⟩

  have s2 : ∀ (x : TensorProduct R (FractionRing R) B) (c : R), c ≠ 0 →
      IsIntegral (FractionRing R) x → IsIntegral R (c • x) → ∀ i : ℕ,
      ∃ r : R, algebraMap R (FractionRing R) r = (minpoly (FractionRing R) x).coeff i *
        algebraMap R (FractionRing R) c ^ ((minpoly (FractionRing R) x).natDegree - i) := by
    intro x c hc hxK hcx i
    set s := algebraMap R (FractionRing R) c with hsdef
    have hs : s ≠ 0 := by
      intro h; apply hc
      exact IsFractionRing.injective R (FractionRing R) (h.trans (map_zero _).symm)
    have hcx' : c • x = algebraMap (FractionRing R) (TensorProduct R (FractionRing R) B) s * x := by
      rw [← IsScalarTower.algebraMap_apply R (FractionRing R) (TensorProduct R (FractionRing R) B)]
      exact Algebra.smul_def (R := R) (A := TensorProduct R (FractionRing R) B) c x
    have hcxK : IsIntegral (FractionRing R) (c • x) := hcx.tower_top
    have hμm : (minpoly (FractionRing R) x).Monic := minpoly.monic hxK
    have hνm : (minpoly (FractionRing R) (c • x)).Monic := minpoly.monic hcxK
    obtain ⟨f, hfm, hf⟩ := hcx
    have hνf : minpoly (FractionRing R) (c • x) ∣ f.map (algebraMap R (FractionRing R)) :=
      minpoly.dvd _ _ (by rw [Polynomial.aeval_map_algebraMap, Polynomial.aeval_def]; exact hf)
    obtain ⟨g, hg⟩ := IsIntegrallyClosed.eq_map_mul_C_of_dvd (FractionRing R) hfm hνf
    rw [hνm.leadingCoeff, map_one, mul_one] at hg
    have hsc : minpoly (FractionRing R) (c • x) ∣ (minpoly (FractionRing R) x).scaleRoots s :=
      minpoly.dvd _ _ (by rw [hcx']; exact Polynomial.scaleRoots_aeval_eq_zero (minpoly.aeval _ x))
    have hsc' : minpoly (FractionRing R) x ∣ (minpoly (FractionRing R) (c • x)).scaleRoots s⁻¹ := by
      apply minpoly.dvd
      have hx' : x = algebraMap (FractionRing R) (TensorProduct R (FractionRing R) B) s⁻¹ * (c • x) := by
        rw [hcx', ← mul_assoc, ← map_mul, inv_mul_cancel₀ hs, map_one, one_mul]
      have := Polynomial.scaleRoots_aeval_eq_zero (r := s⁻¹) (minpoly.aeval (FractionRing R) (c • x))
      rwa [← hx'] at this
    have hd1 : (minpoly (FractionRing R) x).natDegree ≤ (minpoly (FractionRing R) (c • x)).natDegree := by
      have := Polynomial.natDegree_le_of_dvd hsc'
        ((Polynomial.monic_scaleRoots_iff _).mpr hνm).ne_zero
      rwa [Polynomial.natDegree_scaleRoots] at this
    have heq : (minpoly (FractionRing R) x).scaleRoots s = minpoly (FractionRing R) (c • x) :=
      Polynomial.eq_of_monic_of_dvd_of_natDegree_le hνm
        ((Polynomial.monic_scaleRoots_iff _).mpr hμm) hsc
        (by rw [Polynomial.natDegree_scaleRoots]; exact hd1)
    refine ⟨g.coeff i, ?_⟩
    rw [← Polynomial.coeff_map, hg, ← heq, Polynomial.coeff_scaleRoots]

  let ι : B →ₐ[R] TensorProduct R (FractionRing R) B := Algebra.TensorProduct.includeRight
  have hι : Function.Injective ι :=
    Algebra.TensorProduct.includeRight_injective (IsFractionRing.injective R (FractionRing R))
  have hmap : ∀ c : R, ι (c • e) = c • ι e := fun c => map_smul ι c e
  have hπe' : IsIntegral R (π • ι e) := by rw [← hmap]; exact hπe.map ι
  have hte' : IsIntegral R (t • ι e) := by rw [← hmap]; exact hte.map ι
  have hπ0 : π ≠ 0 := hπ.ne_zero
  have ht0 : t ≠ 0 := by rintro rfl; exact hπt (dvd_zero _)
  have hπK : algebraMap R (FractionRing R) π ≠ 0 := by
    intro h; apply hπ0
    exact IsFractionRing.injective R (FractionRing R) (h.trans (map_zero _).symm)
  have he'K : IsIntegral (FractionRing R) (ι e) := by
    have h1 : IsIntegral (FractionRing R) (π • ι e) := hπe'.tower_top
    have h2 : ι e = (algebraMap R (FractionRing R) π)⁻¹ • (π • ι e) := by
      rw [← algebraMap_smul (FractionRing R) π (ι e), smul_smul, inv_mul_cancel₀ hπK, one_smul]
    rw [h2]; exact h1.smul _
  have hcoeff : ∀ i, (minpoly (FractionRing R) (ι e)).coeff i ∈ Set.range (algebraMap R (FractionRing R)) := by
    intro i
    obtain ⟨r₁, h₁⟩ := s2 (ι e) π hπ0 he'K hπe' i
    obtain ⟨r₂, h₂⟩ := s2 (ι e) t ht0 he'K hte' i
    exact s1 _ _ _ ⟨r₁, by rw [h₁, mul_comm]⟩ ⟨r₂, by rw [h₂, mul_comm]⟩
  have hlift : minpoly (FractionRing R) (ι e) ∈ Polynomial.lifts (algebraMap R (FractionRing R)) :=
    (Polynomial.lifts_iff_coeff_lifts _).mpr hcoeff
  obtain ⟨q, hqmap, -, hqm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift (minpoly.monic he'K)
  refine ⟨q, hqm, ?_⟩
  have h0 : ι (Polynomial.aeval e q) = 0 := by
    rw [← Polynomial.aeval_algHom_apply, ← Polynomial.aeval_map_algebraMap (FractionRing R), hqmap]
    exact minpoly.aeval _ _
  have h3 : Polynomial.aeval e q = 0 := hι (h0.trans (map_zero ι).symm)
  rwa [Polynomial.aeval_def] at h3

theorem wc_pss_abstract_second_syzygy : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsNoetherianRing R] [UniqueFactorizationMonoid R], (∀ (N : Type u) [AddCommGroup N] [Module R N] [Module.Finite R N], (∀ (r : R) (x : N), r ≠ 0 → r • x = 0 → x = 0) → ∃ (n : ℕ) (ι : N →ₗ[R] (Fin n → R)), Function.Injective ι) → ∀ (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M], (∀ (r : R) (x : M), r ≠ 0 → r • x = 0 → x = 0) → (∀ (p : R), Prime p → ∀ x : M, (∀ φ : Module.Dual R M, p ∣ φ x) → ∃ y : M, x = p • y) → ∃ (m m' : ℕ) (α : M →ₗ[R] (Fin m → R)) (β : (Fin m → R) →ₗ[R] (Fin m' → R)), Function.Injective α ∧ LinearMap.range α = LinearMap.ker β :=
by
  intro R _ _ _ _ HTF M _ _ _ TF PP
  classical

  have hsep : ∀ x : M, (∀ ψ : Module.Dual R M, ψ x = 0) → x = 0 := by
    obtain ⟨n, ι, hι⟩ := HTF M TF
    intro x hx
    by_contra hne
    have h1 : ι x ≠ 0 := by
      intro h
      apply hne
      apply hι
      rw [h, map_zero]
    obtain ⟨l, hl⟩ := Function.ne_iff.mp h1
    exact hl (hx (LinearMap.proj l ∘ₗ ι))

  have hdiv : ∀ (r : R) (x : M), (∀ ψ : Module.Dual R M, r ∣ ψ x) → ∃ y : M, x = r • y := by
    intro r
    refine UniqueFactorizationMonoid.induction_on_prime r ?_ ?_ ?_
    · intro x hx
      refine ⟨0, ?_⟩
      rw [smul_zero]
      exact hsep x (fun ψ => zero_dvd_iff.mp (hx ψ))
    · intro u hu x _
      refine ⟨((hu.unit⁻¹ : Rˣ) : R) • x, ?_⟩
      rw [smul_smul, IsUnit.mul_val_inv, one_smul]
    · intro a p _ hp ih x hx
      obtain ⟨x₁, rfl⟩ := PP p hp x (fun ψ => dvd_trans (dvd_mul_right p a) (hx ψ))
      have ha : ∀ ψ : Module.Dual R M, a ∣ ψ x₁ := by
        intro ψ
        have h := hx ψ
        rw [map_smul, smul_eq_mul] at h
        exact (mul_dvd_mul_iff_left hp.ne_zero).mp h
      obtain ⟨x₂, rfl⟩ := ih x₁ ha
      exact ⟨x₂, by rw [smul_smul]⟩

  obtain ⟨m, φ, hφ⟩ := Module.Finite.exists_fin (R := R) (M := Module.Dual R M)
  let α : M →ₗ[R] (Fin m → R) := LinearMap.pi φ
  have hα : ∀ x j, α x j = φ j x := fun x j => rfl
  have hG : ∀ ψ : Module.Dual R M, ∃ c : Fin m → R, ∀ x, ψ x = ∑ j, c j * φ j x := by
    intro ψ
    have hψ : ψ ∈ Submodule.span R (Set.range φ) := by rw [hφ]; trivial
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hψ
    refine ⟨c, fun x => ?_⟩
    rw [← hc]
    simp [LinearMap.sum_apply]
  have hαinj : Function.Injective α := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro x hx
    apply hsep x
    intro ψ
    obtain ⟨c, hc⟩ := hG ψ
    rw [hc x]
    apply Finset.sum_eq_zero
    intro j _
    rw [← hα, hx]
    simp

  have hDIV : ∀ (r : R) (x : M), (∀ j, r ∣ α x j) → ∃ y, x = r • y := by
    intro r x hx
    apply hdiv r x
    intro ψ
    obtain ⟨c, hc⟩ := hG ψ
    rw [hc x]
    exact Finset.dvd_sum (fun j _ => Dvd.dvd.mul_left (hx j) _)

  have hQtf : ∀ (r : R) (q : (Fin m → R) ⧸ LinearMap.range α), r ≠ 0 → r • q = 0 → q = 0 := by
    intro r q hr hq
    obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective _ q
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hq
    obtain ⟨x, hx⟩ := hq
    obtain ⟨y, rfl⟩ := hDIV r x (fun j => ⟨v j, by rw [hx]; rfl⟩)
    rw [Submodule.Quotient.mk_eq_zero]
    refine ⟨y, ?_⟩
    funext j
    have := congrFun hx j
    rw [map_smul] at this
    simp only [Pi.smul_apply, smul_eq_mul] at this
    exact mul_left_cancel₀ hr this

  obtain ⟨m', ιQ, hιQ⟩ := HTF ((Fin m → R) ⧸ LinearMap.range α) hQtf
  refine ⟨m, m', α, ιQ ∘ₗ (LinearMap.range α).mkQ, hαinj, ?_⟩
  rw [LinearMap.ker_comp, LinearMap.ker_eq_bot.mpr hιQ, Submodule.comap_bot, Submodule.ker_mkQ]

theorem wc_pls_second_syzygy : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R] (s : R), s ≠ 0 → ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra (Localization.Away s) E] [IsScalarTower R (Localization.Away s) E] [Algebra.Etale (Localization.Away s) E] [Module.Finite (Localization.Away s) E], ∃ (m m' : ℕ) (α : integralClosure R E →ₗ[R] (Fin m → R)) (β : (Fin m → R) →ₗ[R] (Fin m' → R)), Function.Injective α ∧ LinearMap.range α = LinearMap.ker β :=
by
  intro R _ _ _ s hs E _ _ _ _ _ _
  classical

  obtain ⟨_, hufd⟩ := wc_fco_regular_local_ufd R
  haveI : UniqueFactorizationMonoid R := hufd
  haveI : IsIntegrallyClosed R := inferInstance

  haveI : Module.Finite R (integralClosure R E) :=
    wc_fnf_integralClosure_finite_of_etale_localization R (Localization.Away s)
      (Submonoid.powers s) E
      (fun A _ _ _ _ _ => wc_fnf_integralClosure_finite_of_etale_field R (FractionRing R) A)

  haveI : Module.Flat (Localization.Away s) E := Algebra.Smooth.flat (Localization.Away s) E
  haveI : Module.Flat R E := Module.Flat.trans R (Localization.Away s) E
  have hE : ∀ (r : R) (x : E), r ≠ 0 → r • x = 0 → x = 0 := by
    intro r x hr hx
    have hreg : IsSMulRegular E r :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hr)
    exact hreg (show r • x = r • (0 : E) by rw [hx, smul_zero])
  have hC : ∀ (r : R) (x : integralClosure R E), r ≠ 0 → r • x = 0 → x = 0 := by
    intro r x hr hx
    apply Subtype.ext
    have h1 : r • (x : E) = 0 := by
      have := congrArg (fun z : integralClosure R E => (z : E)) hx
      simpa using this
    simpa using hE r _ hr h1

  have hPP : ∀ (p : R), Prime p → ∀ x : integralClosure R E,
      (∀ φ : Module.Dual R (integralClosure R E), p ∣ φ x) →
        ∃ y : integralClosure R E, x = p • y := by
    intro p hp x hx
    haveI : (Ideal.span {p}).IsPrime := (Ideal.span_singleton_prime hp.ne_zero).mpr hp

    haveI hdvr : IsDiscreteValuationRing (Localization.AtPrime (Ideal.span {p})) := by
      have hne : (Ideal.span {p}).primeCompl ≤ nonZeroDivisors R := fun z hz =>
        mem_nonZeroDivisors_of_ne_zero (fun h => hz (h ▸ Ideal.zero_mem _))
      haveI : IsNoetherianRing (Localization.AtPrime (Ideal.span {p})) :=
        IsLocalization.isNoetherianRing (Ideal.span {p}).primeCompl _ inferInstance
      have hmax : IsLocalRing.maximalIdeal (Localization.AtPrime (Ideal.span {p})) =
          Ideal.span {algebraMap R (Localization.AtPrime (Ideal.span {p})) p} := by
        rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_span, Set.image_singleton]
      have hnf : ¬ IsField (Localization.AtPrime (Ideal.span {p})) := by
        rw [IsLocalRing.isField_iff_maximalIdeal_eq, hmax]
        intro h
        rw [Ideal.span_singleton_eq_bot] at h
        exact hp.ne_zero (IsLocalization.injective _ hne (h.trans (map_zero _).symm))
      have hprin : (IsLocalRing.maximalIdeal (Localization.AtPrime (Ideal.span {p}))).IsPrincipal :=
        ⟨⟨_, hmax⟩⟩
      exact ((IsDiscreteValuationRing.TFAE _ hnf).out 1 5).mpr hprin

    obtain ⟨u, y, hpu, huy⟩ :=
      wc_pss_local_divisibility R p hp (integralClosure R E) hC x hx
    have huyE : u • (x : E) = p • (y : E) := by
      have := congrArg (fun z : integralClosure R E => (z : E)) huy
      simpa using this

    obtain ⟨z, hz⟩ := wc_pss_etale_prime_division R s hs E p u hp hpu (x : E) (y : E) huyE
    have huz : u • z = (y : E) := by
      have h1 : p • (u • z - (y : E)) = 0 := by
        rw [smul_sub, smul_comm p u z, ← hz, huyE, sub_self]
      exact sub_eq_zero.mp (hE p _ hp.ne_zero h1)
    have hint1 : IsIntegral R (p • z) := by
      rw [← hz]; exact x.2
    have hint2 : IsIntegral R (u • z) := by
      rw [huz]; exact y.2

    have hzint : IsIntegral R z := wc_pss_coprime_integral R E p u hp hpu z hint1 hint2
    refine ⟨⟨z, hzint⟩, Subtype.ext ?_⟩
    simpa using hz

  exact wc_pss_abstract_second_syzygy R (wc_pss_torsionfree_embed R) (integralClosure R E) hC hPP

theorem wc_pls_lift_free : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (f : R), f ∈ IsLocalRing.maximalIdeal R → ∀ (n : ℕ), 1 ≤ n → ∀ (B : Type u) [CommRing B] [Algebra (R ⧸ Ideal.span {f}) B] [Algebra R B] [IsScalarTower R (R ⧸ Ideal.span {f}) B] [Algebra.Etale (R ⧸ Ideal.span {f}) B] [Algebra.IsIntegral (R ⧸ Ideal.span {f}) B], ∃ (D : Type u) (_ : CommRing D) (_ : Algebra R D) (π : D →ₐ[R] B) (r : ℕ), Function.Surjective π ∧ (∀ x : D, π x = 0 ↔ ∃ y : D, x = f • y) ∧ (∀ x : D, f ^ n • x = 0) ∧ Nonempty (D ≃ₗ[R] (Fin r → R ⧸ Ideal.span {f ^ n})) :=
by
  intro R _ _ _ f hfm n hn B _ _ _ _ _ _
  classical

  have hle : Ideal.span {f ^ n} ≤ Ideal.span {f} := by
    rw [Ideal.span_singleton_le_span_singleton]
    exact dvd_pow_self f (by omega)
  let q : R ⧸ Ideal.span {f ^ n} →+* R ⧸ Ideal.span {f} := Ideal.Quotient.factor hle
  have hq : Function.Surjective q := Ideal.Quotient.factor_surjective hle
  have hqmk : ∀ r : R, q (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk _ r :=
    fun r => Ideal.Quotient.factor_mk hle r
  have hkerq : RingHom.ker q = Ideal.span {Ideal.Quotient.mk (Ideal.span {f ^ n}) f} := by
    ext a
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [RingHom.mem_ker, hqmk, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton',
      Ideal.mem_span_singleton']
    constructor
    · rintro ⟨c, hc⟩
      exact ⟨Ideal.Quotient.mk _ c, by rw [← map_mul, hc]⟩
    · rintro ⟨c, hc⟩
      obtain ⟨c', rfl⟩ := Ideal.Quotient.mk_surjective c
      rw [← map_mul, Ideal.Quotient.eq, Ideal.mem_span_singleton'] at hc
      obtain ⟨d, hd⟩ := hc
      refine ⟨c' - d * f ^ (n - 1), ?_⟩
      have e : f ^ n = f ^ (n - 1) * f := by
        rw [← pow_succ]; congr 1; omega
      rw [sub_mul, mul_assoc, ← e, hd]; ring
  have hfn_m : f ^ n ∈ IsLocalRing.maximalIdeal R := Ideal.pow_mem_of_mem _ hfm n (by omega)
  haveI : Nontrivial (R ⧸ Ideal.span {f ^ n}) := Ideal.Quotient.nontrivial_iff.mpr (by
    rw [Ne, Ideal.span_singleton_eq_top]
    exact (IsLocalRing.mem_maximalIdeal _).mp hfn_m)
  haveI : IsLocalRing (R ⧸ Ideal.span {f ^ n}) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective

  have hEt : Algebra.IsStandardSmoothOfRelativeDimension 0 (R ⧸ Ideal.span {f}) B :=
    Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp inferInstance
  obtain ⟨ι, σ, _, _, P, hPdim⟩ := hEt.out
  haveI : Fintype σ := Fintype.ofFinite σ
  have hdim : Nat.card ι - Nat.card σ = 0 := hPdim
  have hmapq : Function.Surjective (MvPolynomial.map (σ := ι) q) := MvPolynomial.map_surjective q hq
  choose v hv using fun j : σ => hmapq (P.relation j)

  have hkerP : ∀ p : MvPolynomial ι (R ⧸ Ideal.span {f}),
      MvPolynomial.aeval P.val p = 0 ↔ p ∈ Ideal.span (Set.range P.relation) := by
    intro p
    rw [P.span_range_relation_eq_ker, Algebra.Generators.ker_eq_ker_aeval_val, RingHom.mem_ker]

  have hspan : Ideal.span (Set.range P.relation) =
      Ideal.map (MvPolynomial.map q) (Ideal.span (Set.range v)) := by
    rw [Ideal.map_span, ← Set.range_comp]
    have e : (MvPolynomial.map q) ∘ v = P.relation := funext hv
    rw [e]
  have hmem : ∀ p : MvPolynomial ι (R ⧸ Ideal.span {f ^ n}),
      MvPolynomial.map q p ∈ Ideal.span (Set.range P.relation) ↔
        p ∈ Ideal.span (Set.range v) ⊔
          Ideal.span {MvPolynomial.C (Ideal.Quotient.mk (Ideal.span {f ^ n}) f)} := by
    intro p
    rw [hspan, ← Ideal.mem_comap, Ideal.comap_map_of_surjective' _ hmapq, MvPolynomial.ker_map,
      hkerq, Ideal.map_span, Set.image_singleton]

  let φ₀ : MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) →+* B :=
    (MvPolynomial.aeval P.val).toRingHom.comp (MvPolynomial.map q)
  have hφ₀ : ∀ p, φ₀ p = MvPolynomial.aeval P.val (MvPolynomial.map q p) := fun p => rfl
  have hφ₀I : ∀ p ∈ Ideal.span (Set.range v), φ₀ p = 0 := by
    intro p hp
    rw [hφ₀, hkerP, hmem]
    exact Ideal.mem_sup_left hp
  let φ : MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v) →+* B :=
    Ideal.Quotient.lift _ φ₀ hφ₀I
  have hφmk : ∀ p, φ (Ideal.Quotient.mk _ p) = φ₀ p := fun p => Ideal.Quotient.lift_mk _ _ _
  have halgD : ∀ r : R, algebraMap R (MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v)) r
      = Ideal.Quotient.mk _ (MvPolynomial.C (Ideal.Quotient.mk _ r)) := fun r => rfl
  have hφalg : ∀ r : R, φ (algebraMap R
      (MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v)) r) = algebraMap R B r := by
    intro r
    rw [halgD, hφmk, hφ₀, MvPolynomial.map_C, MvPolynomial.aeval_C, hqmk,
      IsScalarTower.algebraMap_apply R (R ⧸ Ideal.span {f}) B, Ideal.Quotient.algebraMap_eq]
  let π : (MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v)) →ₐ[R] B :=
    { φ with commutes' := hφalg }
  have hπ : ∀ p, π (Ideal.Quotient.mk _ p) = MvPolynomial.aeval P.val (MvPolynomial.map q p) :=
    fun p => hφmk p
  have hsurj : Function.Surjective π := by
    intro b
    obtain ⟨p, hp⟩ := hmapq (P.σ' b)
    exact ⟨Ideal.Quotient.mk _ p, by rw [hπ, hp, P.aeval_val_σ']⟩
  have hsmul : ∀ (r : R) (x : MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v)),
      r • x = Ideal.Quotient.mk _ (MvPolynomial.C (Ideal.Quotient.mk _ r)) * x := by
    intro r x
    rw [← halgD]
    exact Algebra.smul_def r x
  have hfn : ∀ x : MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v),
      f ^ n • x = 0 := by
    intro x
    rw [hsmul]
    have e : (Ideal.Quotient.mk (Ideal.span {f ^ n}) (f ^ n)) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
    rw [e, map_zero, map_zero, zero_mul]
  have hfB : ∀ b : B, f • b = 0 := by
    intro b
    rw [← algebraMap_smul (R ⧸ Ideal.span {f}) f b, Ideal.Quotient.algebraMap_eq,
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self f), zero_smul]
  have hker : ∀ x, π x = 0 ↔ ∃ y, x = f • y := by
    intro x
    constructor
    · obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [hπ, hkerP, hmem, sup_comm, Ideal.mem_span_singleton_sup]
      rintro ⟨a, b, hb, hab⟩
      refine ⟨Ideal.Quotient.mk _ a, ?_⟩
      rw [hsmul, ← hab, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hb, add_zero, map_mul]
      exact mul_comm (Ideal.Quotient.mk (Ideal.span (Set.range v)) a) _
    · rintro ⟨y, rfl⟩
      rw [map_smul, hfB]

  let M : Matrix σ σ (MvPolynomial ι (R ⧸ Ideal.span {f ^ n})) :=
    Matrix.of fun i j => MvPolynomial.pderiv (P.map i) (v j)
  have hMmap : (MvPolynomial.map q).mapMatrix M = P.jacobiMatrix := by
    ext i j
    rw [RingHom.mapMatrix_apply, Matrix.map_apply, P.jacobiMatrix_apply]
    simp only [M, Matrix.of_apply]
    rw [← MvPolynomial.pderiv_map, hv]
  have hz : π (Ideal.Quotient.mk _ M.det) = P.jacobian := by
    rw [hπ, RingHom.map_det, hMmap, P.jacobian_eq_jacobiMatrix_det, P.algebraMap_eq]
    rfl
  have hzunit : IsUnit (Ideal.Quotient.mk (Ideal.span (Set.range v)) M.det) := by
    obtain ⟨w, hw⟩ := P.jacobian_isUnit.exists_right_inv
    obtain ⟨w', hw'⟩ := hsurj w
    have h0 : π (Ideal.Quotient.mk _ M.det * w' - 1) = 0 := by
      rw [map_sub, map_mul, hz, hw', hw, map_one, sub_self]
    obtain ⟨y, hy⟩ := (hker _).mp h0
    have hnil : IsNilpotent (f • y) := ⟨n, by rw [smul_pow, hfn]⟩
    have h1 : IsUnit (1 + f • y) := hnil.isUnit_one_add
    rw [← hy, add_sub_cancel] at h1
    exact isUnit_of_mul_isUnit_left h1

  let Q : Algebra.PreSubmersivePresentation (R ⧸ Ideal.span {f ^ n})
      (MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v)) ι σ :=
    Algebra.PreSubmersivePresentation.naive (v := v) P.map P.map_inj
  have hQalg : ∀ p, algebraMap Q.Ring
      (MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v)) p
        = Ideal.Quotient.mk _ p := by
    intro p
    rw [Q.algebraMap_eq]
    have e : MvPolynomial.aeval Q.val =
        Ideal.Quotient.mkₐ (R ⧸ Ideal.span {f ^ n}) (Ideal.span (Set.range v)) := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [MvPolynomial.aeval_X, Ideal.Quotient.mkₐ_eq_mk]
      first
        | rfl
        | exact Algebra.Generators.naive_val _ (fun x => Function.surjInv_eq Ideal.Quotient.mk_surjective x) i
        | simp [Q, Algebra.PreSubmersivePresentation.naive, Algebra.Presentation.naive]
    show MvPolynomial.aeval Q.val p = _
    rw [e, Ideal.Quotient.mkₐ_eq_mk]
  have hQjac : Q.jacobian = Ideal.Quotient.mk _ M.det := by
    rw [Q.jacobian_eq_jacobiMatrix_det, hQalg]
    congr 2
    ext i j
    rw [Q.jacobiMatrix_apply]
    rfl
  let Qs : Algebra.SubmersivePresentation (R ⧸ Ideal.span {f ^ n})
      (MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v)) ι σ :=
    ⟨Q, by rw [hQjac]; exact hzunit⟩
  haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 (R ⧸ Ideal.span {f ^ n})
      (MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v)) :=
    Algebra.IsStandardSmoothOfRelativeDimension.mk ⟨ι, σ, inferInstance, inferInstance, Qs, hdim⟩
  haveI : Algebra.Etale (R ⧸ Ideal.span {f ^ n})
      (MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v)) :=
    Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mpr inferInstance

  haveI : Module.Finite (R ⧸ Ideal.span {f}) B := Algebra.IsIntegral.finite
  haveI : Module.Finite R B := Module.Finite.trans (R ⧸ Ideal.span {f}) B
  obtain ⟨t, b, hb⟩ := Module.Finite.exists_fin (R := R) (M := B)
  choose d hd using fun i => hsurj (b i)
  have hN : ∀ x, ∃ y ∈ Submodule.span R (Set.range d), ∃ z, x = y + f • z := by
    intro x
    have hcomp : (π.toLinearMap : _ →ₗ[R] B) ∘ d = b := funext hd
    have hmapN : (Submodule.span R (Set.range d)).map π.toLinearMap = ⊤ := by
      rw [Submodule.map_span, ← Set.range_comp, hcomp, hb]
    have hx : π x ∈ (Submodule.span R (Set.range d)).map π.toLinearMap := by
      rw [hmapN]; trivial
    obtain ⟨y, hyN, hy⟩ := Submodule.mem_map.mp hx
    obtain ⟨z, hz⟩ := (hker (x - y)).mp (by
      rw [map_sub, sub_eq_zero]; exact hy.symm)
    exact ⟨y, hyN, z, eq_add_of_sub_eq' hz⟩
  have hNk : ∀ k : ℕ, ∀ x, ∃ y ∈ Submodule.span R (Set.range d), ∃ z, x = y + f ^ k • z := by
    intro k
    induction k with
    | zero => intro x; exact ⟨0, Submodule.zero_mem _, x, by simp⟩
    | succ k ih =>
      intro x
      obtain ⟨y, hy, z, rfl⟩ := ih x
      obtain ⟨y', hy', z', rfl⟩ := hN z
      refine ⟨y + f ^ k • y', Submodule.add_mem _ hy (Submodule.smul_mem _ _ hy'), z', ?_⟩
      rw [smul_add, smul_smul, ← pow_succ, add_assoc]
  have hNtop : Submodule.span R (Set.range d) = ⊤ := by
    rw [Submodule.eq_top_iff']
    intro x
    obtain ⟨y, hy, z, rfl⟩ := hNk n x
    rw [hfn, add_zero]; exact hy
  haveI : Module.Finite R
      (MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v)) :=
    ⟨by rw [← hNtop]; exact Submodule.fg_span (Set.finite_range d)⟩
  haveI : Module.Finite (R ⧸ Ideal.span {f ^ n})
      (MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v)) :=
    Module.Finite.of_restrictScalars_finite R (R ⧸ Ideal.span {f ^ n}) _

  haveI : Module.Flat (R ⧸ Ideal.span {f ^ n})
      (MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v)) :=
    Algebra.Smooth.flat (R ⧸ Ideal.span {f ^ n})
      (MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v))
  haveI : Module.Free (R ⧸ Ideal.span {f ^ n})
      (MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v)) :=
    Module.free_of_flat_of_isLocalRing

  exact ⟨MvPolynomial ι (R ⧸ Ideal.span {f ^ n}) ⧸ Ideal.span (Set.range v), inferInstance,
    inferInstance, π, _, hsurj, hker, hfn,
    ⟨(Module.finBasis (R ⧸ Ideal.span {f ^ n}) _).equivFun.restrictScalars R⟩⟩

theorem wc_pcm_nu_local_surj : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R] (s : R), s ≠ 0 → ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra (Localization.Away s) E] [IsScalarTower R (Localization.Away s) E] [Algebra.Etale (Localization.Away s) E] [Module.Finite (Localization.Away s) E], (∀ (q : Ideal R) [q.IsPrime], q < IsLocalRing.maximalIdeal R → Algebra.Etale (Localization.AtPrime q) (TensorProduct R (Localization.AtPrime q) (integralClosure R E))) → ∀ (f : R), f ∈ IsLocalRing.maximalIdeal R → f ∉ IsLocalRing.maximalIdeal R ^ 2 → ∀ [(Ideal.span {f}).IsPrime], s ∉ Ideal.span {f} → Algebra.Etale (R ⧸ Ideal.span {f}) (integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E)) → ∀ (Q : Ideal R) [Q.IsPrime], Q < IsLocalRing.maximalIdeal R → f ∈ Q → ∀ (y : integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E)), ∃ (t : R) (c : integralClosure R E), t ∉ Q ∧ t • (y : TensorProduct R (R ⧸ Ideal.span {f}) E) = TensorProduct.tmul R (1 : R ⧸ Ideal.span {f}) (c : E) :=
by
  intro R _ _ _ s hs E _ _ _ _ _ _ hET f hfm hfm2 _ hsf _ Q _ hQm hfQ y
  classical
  have hEs : IsUnit (algebraMap R E s) := by
    rw [IsScalarTower.algebraMap_apply R (Localization.Away s) E]
    exact (IsLocalization.Away.algebraMap_isUnit s).map _
  haveI hEloc := wc_pas_integralClosure_isLocalization R s E


  have key : ∀ (L : Type u) [CommRing L] [IsDomain L] [IsIntegrallyClosed L] [Algebra R L],
      algebraMap R L s ≠ 0 → Algebra.Etale L (TensorProduct R L (integralClosure R E)) →
      ∀ w : TensorProduct R L E, IsIntegral L w →
        ∃ b : TensorProduct R L (integralClosure R E),
          Algebra.TensorProduct.map (AlgHom.id L L) (integralClosure R E).val b = w := by
    intro L _ _ _ _ ht hNet
    haveI : Module.Flat L (TensorProduct R L (integralClosure R E)) := Algebra.Smooth.flat _ _
    obtain ⟨τ, hτ⟩ : ∃ τ, τ = algebraMap R (TensorProduct R L (integralClosure R E)) s :=
      ⟨_, rfl⟩
    have htn : τ ∈ nonZeroDivisors (TensorProduct R L (integralClosure R E)) := by
      have hreg0 : IsSMulRegular L (algebraMap R L s) :=
        fun a b h => mul_left_cancel₀ ht h
      have hreg : IsSMulRegular (TensorProduct R L (integralClosure R E))
          (algebraMap L (TensorProduct R L (integralClosure R E)) (algebraMap R L s)) :=
        IsSMulRegular.of_flat hreg0
      have h1 : ∀ x : TensorProduct R L (integralClosure R E), τ * x = 0 → x = 0 := by
        intro x hx
        apply hreg
        change algebraMap L (TensorProduct R L (integralClosure R E)) (algebraMap R L s) * x =
          algebraMap L (TensorProduct R L (integralClosure R E)) (algebraMap R L s) * 0
        rw [mul_zero, ← IsScalarTower.algebraMap_apply, ← hτ]
        exact hx
      exact mem_nonZeroDivisors_iff.mpr ⟨h1, fun x hx => h1 x (by rw [mul_comm]; exact hx)⟩
    have hnorm : ∀ (P : Ideal (TensorProduct R L (integralClosure R E))) [P.IsPrime],
        IsDomain (Localization.AtPrime P) ∧ IsIntegrallyClosed (Localization.AtPrime P) :=
      fun P _ => wc_pks_etale_localization_normal L _ P
    have hτunit : IsUnit (algebraMap _ (Localization.Away τ) τ) :=
      IsLocalization.Away.algebraMap_isUnit τ
    have hg0 : ∀ y : Algebra.algebraMapSubmonoid (integralClosure R E) (Submonoid.powers s),
        IsUnit (((algebraMap (TensorProduct R L (integralClosure R E)) (Localization.Away τ)).comp
          (Algebra.TensorProduct.includeRight : integralClosure R E →ₐ[R]
            TensorProduct R L (integralClosure R E)).toRingHom) y) := by
      intro y
      obtain ⟨z, hz, hzy⟩ := y.2
      obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hz
      rw [RingHom.comp_apply, ← hzy, map_pow, map_pow, map_pow]
      have : (Algebra.TensorProduct.includeRight : integralClosure R E →ₐ[R]
            TensorProduct R L (integralClosure R E)).toRingHom (algebraMap R (integralClosure R E) s)
            = τ := by
        rw [hτ]
        exact (Algebra.TensorProduct.includeRight : integralClosure R E →ₐ[R]
            TensorProduct R L (integralClosure R E)).commutes s
      rw [this]
      exact hτunit.pow n
    let g0 : E →+* Localization.Away τ :=
      IsLocalization.lift (M := Algebra.algebraMapSubmonoid (integralClosure R E) (Submonoid.powers s)) hg0
    have hg0c : ∀ c : integralClosure R E, g0 (algebraMap (integralClosure R E) E c) =
        algebraMap _ (Localization.Away τ) (TensorProduct.tmul R (1 : L) c) :=
      fun c => IsLocalization.lift_eq hg0 c
    let g : E →ₐ[R] Localization.Away τ :=
      { toRingHom := g0
        commutes' := fun r => by
          show g0 (algebraMap R E r) = _
          rw [IsScalarTower.algebraMap_apply R (integralClosure R E) E, hg0c,
            ← Algebra.TensorProduct.algebraMap_apply',
            ← IsScalarTower.algebraMap_apply] }
    let ψ : TensorProduct R L E →ₐ[L] Localization.Away τ :=
      Algebra.TensorProduct.lift (Algebra.ofId L _) g (fun _ _ => Commute.all _ _)
    let j : TensorProduct R L (integralClosure R E) →ₐ[L] TensorProduct R L E :=
      Algebra.TensorProduct.map (AlgHom.id L L) (integralClosure R E).val
    have hjτ : IsUnit (j τ) := by
      have : j τ = Algebra.TensorProduct.includeRight (algebraMap R E s) := by
        rw [hτ, Algebra.TensorProduct.algebraMap_apply', Algebra.TensorProduct.map_tmul,
          Algebra.TensorProduct.includeRight_apply, map_one, AlgHom.commutes]
      rw [this]
      exact hEs.map _
    have hjpow : ∀ y : Submonoid.powers τ, IsUnit (j.toRingHom y) := by
      rintro ⟨y, n, rfl⟩
      show IsUnit (j (τ ^ n))
      rw [map_pow]
      exact hjτ.pow n
    let φ0 : Localization.Away τ →+* TensorProduct R L E := IsLocalization.lift hjpow
    have hφ0 : ∀ b, φ0 (algebraMap _ (Localization.Away τ) b) = j b :=
      fun b => IsLocalization.lift_eq hjpow b
    let φ : Localization.Away τ →ₐ[L] TensorProduct R L E :=
      { toRingHom := φ0
        commutes' := fun l => by
          show φ0 (algebraMap L (Localization.Away τ) l) = _
          rw [IsScalarTower.algebraMap_apply L (TensorProduct R L (integralClosure R E))
            (Localization.Away τ), hφ0, j.commutes] }
    have hφg : φ0.comp g0 = (Algebra.TensorProduct.includeRight :
        E →ₐ[R] TensorProduct R L E).toRingHom := by
      apply IsLocalization.ringHom_ext
        (Algebra.algebraMapSubmonoid (integralClosure R E) (Submonoid.powers s))
      refine RingHom.ext fun c => ?_
      show φ0 (g0 (algebraMap _ E c)) = Algebra.TensorProduct.includeRight (algebraMap _ E c)
      rw [hg0c, hφ0, Algebra.TensorProduct.map_tmul, Algebra.TensorProduct.includeRight_apply,
        AlgHom.id_apply]
      rfl
    have h2 : φ.comp ψ = AlgHom.id L (TensorProduct R L E) := by
      apply Algebra.TensorProduct.ext'
      intro l e
      rw [AlgHom.comp_apply, Algebra.TensorProduct.lift_tmul, map_mul, AlgHom.id_apply,
        Algebra.ofId_apply, AlgHom.commutes, Algebra.TensorProduct.algebraMap_apply]
      have := RingHom.congr_fun hφg e
      show TensorProduct.tmul R l (1 : E) * φ0 (g0 e) = _
      rw [RingHom.comp_apply] at this
      rw [this]
      show TensorProduct.tmul R l (1 : E) * TensorProduct.tmul R (1 : L) e = _
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    intro w hw
    have hψw : IsIntegral L (ψ w) := hw.map ψ
    obtain ⟨b, hb⟩ := wcfd_tn_locally_normal_away_closed _ hnorm τ htn (ψ w)
      (IsIntegral.tower_top (A := TensorProduct R L (integralClosure R E)) hψw)
    refine ⟨b, ?_⟩
    have e1 : φ (ψ w) = w := AlgHom.congr_fun h2 w
    rw [← e1, ← hb]
    exact (hφ0 b).symm

  have hIQ : Ideal.span {f} ≤ Q := (Ideal.span_singleton_le_iff_mem Q).mpr hfQ
  obtain ⟨P, hPdef⟩ : ∃ P : Ideal (R ⧸ Ideal.span {f}),
      P = Q.map (Ideal.Quotient.mk (Ideal.span {f})) := ⟨_, rfl⟩
  haveI hPprime : P.IsPrime := by
    rw [hPdef]
    exact Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
      (by rw [Ideal.mk_ker]; exact hIQ)
  have hPQ : P.comap (Ideal.Quotient.mk (Ideal.span {f})) = Q := by
    rw [hPdef]; exact Ideal.comap_map_mk hIQ
  have hlift : ∀ x : R, Ideal.Quotient.mk (Ideal.span {f}) x ∉ P → x ∉ Q := by
    intro x hx hxQ
    apply hx
    rw [hPdef]
    exact Ideal.mem_map_of_mem _ hxQ
  have hQne : (1 : R) ∉ Q := fun h => (inferInstance : Q.IsPrime).ne_top ((Ideal.eq_top_iff_one Q).mpr h)

  have hPm : P.comap (Ideal.Quotient.mk (Ideal.span {f})) < IsLocalRing.maximalIdeal R := by
    rw [hPQ]; exact hQm
  haveI hetP := hET _ hPm
  letI algPL : Algebra (Localization.AtPrime (P.comap (Ideal.Quotient.mk (Ideal.span {f}))))
      (Localization.AtPrime P) :=
    (Localization.localRingHom (P.comap (Ideal.Quotient.mk (Ideal.span {f}))) P
      (Ideal.Quotient.mk (Ideal.span {f})) rfl).toAlgebra
  haveI : IsScalarTower R (Localization.AtPrime (P.comap (Ideal.Quotient.mk (Ideal.span {f}))))
      (Localization.AtPrime P) := by
    apply IsScalarTower.of_algebraMap_eq
    intro x
    show _ = Localization.localRingHom (P.comap (Ideal.Quotient.mk (Ideal.span {f}))) P
      (Ideal.Quotient.mk (Ideal.span {f})) rfl (algebraMap R _ x)
    rw [Localization.localRingHom_to_map, IsScalarTower.algebraMap_apply R (R ⧸ Ideal.span {f})
      (Localization.AtPrime P)]
    rfl
  haveI hNet : Algebra.Etale (Localization.AtPrime P)
      (TensorProduct R (Localization.AtPrime P) (integralClosure R E)) := by
    haveI := Algebra.Etale.baseChange
      (Localization.AtPrime (P.comap (Ideal.Quotient.mk (Ideal.span {f}))))
      (TensorProduct R (Localization.AtPrime (P.comap (Ideal.Quotient.mk (Ideal.span {f}))))
        (integralClosure R E)) (Localization.AtPrime P)
    let eC : TensorProduct (Localization.AtPrime (P.comap (Ideal.Quotient.mk (Ideal.span {f}))))
        (Localization.AtPrime P)
        (TensorProduct R (Localization.AtPrime (P.comap (Ideal.Quotient.mk (Ideal.span {f}))))
          (integralClosure R E)) ≃ₐ[Localization.AtPrime P]
        TensorProduct R (Localization.AtPrime P) (integralClosure R E) :=
      Algebra.TensorProduct.cancelBaseChange R
        (Localization.AtPrime (P.comap (Ideal.Quotient.mk (Ideal.span {f}))))
        (Localization.AtPrime P) (Localization.AtPrime P) (integralClosure R E)
    exact Algebra.Etale.of_equiv (R := Localization.AtPrime P)
      (A := TensorProduct (Localization.AtPrime (P.comap (Ideal.Quotient.mk (Ideal.span {f}))))
        (Localization.AtPrime P)
        (TensorProduct R (Localization.AtPrime (P.comap (Ideal.Quotient.mk (Ideal.span {f}))))
          (integralClosure R E)))
      (B := TensorProduct R (Localization.AtPrime P) (integralClosure R E)) eC

  obtain ⟨hRbreg, -⟩ := wc_rl_quot_regular wc_rl_quot_embdim R inferInstance f hfm hfm2
  haveI := hRbreg
  have hLreg : IsRegularLocalRing (Localization.AtPrime P) :=
    wc_hnas_pfc_regular_localization (R ⧸ Ideal.span {f}) hRbreg P
  haveI := hLreg
  obtain ⟨hLdom, hLufd⟩ := wc_fco_regular_local_ufd (Localization.AtPrime P)
  haveI := hLdom
  haveI := hLufd

  have ht : algebraMap R (Localization.AtPrime P) s ≠ 0 := by
    rw [IsScalarTower.algebraMap_apply R (R ⧸ Ideal.span {f}) (Localization.AtPrime P)]
    intro h
    have hinj : Function.Injective (algebraMap (R ⧸ Ideal.span {f}) (Localization.AtPrime P)) :=
      IsLocalization.injective (Localization.AtPrime P) (Ideal.primeCompl_le_nonZeroDivisors P)
    apply hsf
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    exact hinj (by rw [map_zero]; exact h)

  obtain ⟨θ, hθ⟩ : ∃ θ : TensorProduct R (R ⧸ Ideal.span {f}) E →ₐ[R]
      TensorProduct R (Localization.AtPrime P) E,
      θ = Algebra.TensorProduct.map
        (IsScalarTower.toAlgHom R (R ⧸ Ideal.span {f}) (Localization.AtPrime P)) (AlgHom.id R E) :=
    ⟨_, rfl⟩
  have hθy : IsIntegral (Localization.AtPrime P)
      (θ (y : TensorProduct R (R ⧸ Ideal.span {f}) E)) := by
    have hy : IsIntegral (R ⧸ Ideal.span {f}) (y : TensorProduct R (R ⧸ Ideal.span {f}) E) :=
      (mem_integralClosure_iff _ _).mp y.2
    have hcomp0 : ∀ r : R ⧸ Ideal.span {f},
        algebraMap (Localization.AtPrime P) (TensorProduct R (Localization.AtPrime P) E)
          (algebraMap (R ⧸ Ideal.span {f}) (Localization.AtPrime P) r) =
        θ (algebraMap (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E) r) := by
      intro r
      rw [Algebra.TensorProduct.algebraMap_apply,
        Algebra.TensorProduct.algebraMap_apply, hθ,
        Algebra.TensorProduct.map_tmul, map_one]
      rfl
    exact IsIntegral.map_of_comp_eq (T := Localization.AtPrime P)
      (U := TensorProduct R (Localization.AtPrime P) E)
      (algebraMap (R ⧸ Ideal.span {f}) (Localization.AtPrime P))
      θ.toRingHom (RingHom.ext fun r => hcomp0 r) hy

  obtain ⟨b, hb⟩ := key (Localization.AtPrime P) ht hNet _ hθy
  obtain ⟨j, hj⟩ : ∃ j : TensorProduct R (Localization.AtPrime P) (integralClosure R E) →ₐ[Localization.AtPrime P]
      TensorProduct R (Localization.AtPrime P) E,
      j = Algebra.TensorProduct.map (AlgHom.id (Localization.AtPrime P) (Localization.AtPrime P))
        (integralClosure R E).val := ⟨_, rfl⟩
  rw [← hj] at hb

  have hclear : ∀ l : Localization.AtPrime P, ∃ u : R, u ∉ Q ∧ ∃ r : R,
      u • l = algebraMap R (Localization.AtPrime P) r := by
    intro l
    obtain ⟨⟨x, p⟩, hxp⟩ := IsLocalization.surj P.primeCompl l
    obtain ⟨x', hx'⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨p', hp'⟩ := Ideal.Quotient.mk_surjective (p : R ⧸ Ideal.span {f})
    refine ⟨p', hlift p' (by rw [hp']; exact p.2), x', ?_⟩
    rw [Algebra.smul_def,
      IsScalarTower.algebraMap_apply R (R ⧸ Ideal.span {f}) (Localization.AtPrime P) p',
      IsScalarTower.algebraMap_apply R (R ⧸ Ideal.span {f}) (Localization.AtPrime P) x',
      Ideal.Quotient.algebraMap_eq, hp', hx', mul_comm]
    exact hxp
  have hclearT : ∀ z : TensorProduct R (Localization.AtPrime P) (integralClosure R E),
      ∃ u : R, u ∉ Q ∧ ∃ c : integralClosure R E,
        u • z = (1 : Localization.AtPrime P) ⊗ₜ[R] c := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨1, hQne, 0, by rw [smul_zero, TensorProduct.tmul_zero]⟩
    | tmul l c =>
      obtain ⟨u, hu, r, hr⟩ := hclear l
      refine ⟨u, hu, r • c, ?_⟩
      rw [TensorProduct.smul_tmul', hr, Algebra.algebraMap_eq_smul_one, TensorProduct.smul_tmul]
    | add z₁ z₂ h₁ h₂ =>
      obtain ⟨u₁, hu₁, c₁, e₁⟩ := h₁
      obtain ⟨u₂, hu₂, c₂, e₂⟩ := h₂
      refine ⟨u₁ * u₂, fun h => (Ideal.IsPrime.mem_or_mem inferInstance h).elim hu₁ hu₂,
        u₂ • c₁ + u₁ • c₂, ?_⟩
      have hsplit : (u₁ * u₂) • (z₁ + z₂) = u₂ • (u₁ • z₁) + u₁ • (u₂ • z₂) := by
        rw [smul_add, mul_smul, mul_smul, smul_comm u₁ u₂ z₁]
      rw [hsplit, e₁, e₂, TensorProduct.tmul_add, TensorProduct.tmul_smul, TensorProduct.tmul_smul]
  obtain ⟨u, hu, c, huc⟩ := hclearT b
  have hjsmul : j (u • b) = u • j b := map_smul (j.restrictScalars R) u b
  have hθx : θ (u • (y : TensorProduct R (R ⧸ Ideal.span {f}) E) -
      (1 : R ⧸ Ideal.span {f}) ⊗ₜ[R] (c : E)) = 0 := by
    have h1 : θ ((1 : R ⧸ Ideal.span {f}) ⊗ₜ[R] (c : E)) =
        (1 : Localization.AtPrime P) ⊗ₜ[R] (c : E) := by
      rw [hθ, Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply]
    have h2 : j ((1 : Localization.AtPrime P) ⊗ₜ[R] c) =
        (1 : Localization.AtPrime P) ⊗ₜ[R] (c : E) := by
      rw [hj, Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
      rfl
    rw [map_sub, map_smul, h1, ← hb, ← hjsmul, huc, h2, sub_self]

  let ρ := TensorProduct.AlgebraTensorModule.rTensor R E
    (Algebra.linearMap (R ⧸ Ideal.span {f}) (Localization.AtPrime P))
  haveI : IsLocalizedModule P.primeCompl ρ := inferInstance
  have hρθ : ∀ x, ρ x = θ x := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero]
    | tmul a e =>
      show (TensorProduct.AlgebraTensorModule.rTensor R E
        (Algebra.linearMap (R ⧸ Ideal.span {f}) (Localization.AtPrime P))) (a ⊗ₜ[R] e) = _
      rw [TensorProduct.AlgebraTensorModule.rTensor_tmul, hθ, Algebra.TensorProduct.map_tmul]
      rfl
    | add x₁ x₂ h₁ h₂ => rw [map_add, map_add, h₁, h₂]
  obtain ⟨t', ht'⟩ := (IsLocalizedModule.eq_zero_iff P.primeCompl ρ
    (m := u • (y : TensorProduct R (R ⧸ Ideal.span {f}) E) -
      (1 : R ⧸ Ideal.span {f}) ⊗ₜ[R] (c : E))).mp ((hρθ _).trans hθx)
  obtain ⟨t, htt⟩ := Ideal.Quotient.mk_surjective (t' : R ⧸ Ideal.span {f})
  have htQ : t ∉ Q := hlift t (by rw [htt]; exact t'.2)
  have hkill : t • (u • (y : TensorProduct R (R ⧸ Ideal.span {f}) E) -
      (1 : R ⧸ Ideal.span {f}) ⊗ₜ[R] (c : E)) = 0 := by
    rw [← algebraMap_smul (R ⧸ Ideal.span {f}) t, Ideal.Quotient.algebraMap_eq, htt]
    exact ht'
  refine ⟨t * u, t • c, fun h => (Ideal.IsPrime.mem_or_mem inferInstance h).elim htQ hu, ?_⟩
  rw [smul_sub, sub_eq_zero] at hkill
  rw [mul_smul, hkill, ← TensorProduct.tmul_smul]
  rfl

theorem wc_pcm_formallyEtale_away : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (C : Type u) [CommRing C] [Algebra R C], (∀ (q : Ideal R) [q.IsPrime], q < IsLocalRing.maximalIdeal R → Algebra.Etale (Localization.AtPrime q) (TensorProduct R (Localization.AtPrime q) C)) → ∀ e ∈ IsLocalRing.maximalIdeal R, Algebra.FormallyEtale R (Localization.Away (algebraMap R C e)) :=
by
  intro R _ _ C _ _ hE e he

  have s1 : ∀ (J : Ideal R), (∀ (q : Ideal R) [q.IsPrime], q < IsLocalRing.maximalIdeal R → ¬ J ≤ q) →
      ∃ n : ℕ, e ^ n ∈ J := by
    intro J hJ
    have h : e ∈ J.radical := by
      rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
      rintro P ⟨hJP, hP⟩
      by_contra heP
      have hPm : P < IsLocalRing.maximalIdeal R :=
        lt_of_le_of_ne (IsLocalRing.le_maximalIdeal hP.ne_top) (fun h => heP (by rw [h]; exact he))
      exact hJ P hPm hJP
    exact h

  have s2 : ∀ (q : Ideal R) [q.IsPrime], q < IsLocalRing.maximalIdeal R →
      Algebra.FormallyEtale R (TensorProduct R C (Localization.AtPrime q)) := by
    intro q _ hq
    have := hE q hq
    have : Algebra.FormallyEtale R (TensorProduct R (Localization.AtPrime q) C) :=
      Algebra.FormallyEtale.comp R (Localization.AtPrime q) _
    exact Algebra.FormallyEtale.of_equiv (Algebra.TensorProduct.comm R (Localization.AtPrime q) C)

  have s3 : ∀ (q : Ideal R) [q.IsPrime], q < IsLocalRing.maximalIdeal R →
      (∀ x : KaehlerDifferential R C, ∃ t : R, t ∉ q ∧ algebraMap R C t • x = 0) ∧
      (∀ x : Algebra.H1Cotangent R C, ∃ t : R, t ∉ q ∧ algebraMap R C t • x = 0) := by
    intro q _ hq
    have := s2 q hq
    let S := Algebra.algebraMapSubmonoid C q.primeCompl
    have hΩ : Subsingleton (KaehlerDifferential R (TensorProduct R C (Localization.AtPrime q))) :=
      inferInstance
    have hH : Subsingleton (Algebra.H1Cotangent R (TensorProduct R C (Localization.AtPrime q))) :=
      inferInstance
    constructor
    · intro x
      obtain ⟨r, hr, hrx⟩ := (IsLocalizedModule.subsingleton_iff S
        (KaehlerDifferential.map R R C (TensorProduct R C (Localization.AtPrime q)))).mp hΩ x
      obtain ⟨t, ht, rfl⟩ := Submonoid.mem_map.mp hr
      exact ⟨t, ht, hrx⟩
    · intro x
      obtain ⟨r, hr, hrx⟩ := (IsLocalizedModule.subsingleton_iff S
        (Algebra.H1Cotangent.map R R C (TensorProduct R C (Localization.AtPrime q)))).mp hH x
      obtain ⟨t, ht, rfl⟩ := Submonoid.mem_map.mp hr
      exact ⟨t, ht, hrx⟩

  have s4 : ∀ (M : Type u) [AddCommGroup M] [Module C M] (x : M),
      (∀ (q : Ideal R) [q.IsPrime], q < IsLocalRing.maximalIdeal R →
        ∃ t : R, t ∉ q ∧ algebraMap R C t • x = 0) →
      ∃ n : ℕ, algebraMap R C e ^ n • x = 0 := by
    intro M _ _ x hx
    let J : Ideal R := Ideal.comap (algebraMap R C) (Submodule.span C {x}).annihilator
    have hJ : ∀ r : R, r ∈ J ↔ algebraMap R C r • x = 0 := by
      intro r
      rw [Ideal.mem_comap, Submodule.mem_annihilator_span_singleton]
    obtain ⟨n, hn⟩ := s1 J (fun q _ hq hJq => by
      obtain ⟨t, ht, htx⟩ := hx q hq
      exact ht (hJq ((hJ t).mpr htx)))
    exact ⟨n, by rw [← map_pow]; exact (hJ _).mp hn⟩

  let P := Submonoid.powers (algebraMap R C e)
  apply Algebra.FormallyEtale.mk
  · apply (IsLocalizedModule.subsingleton_iff P
      (KaehlerDifferential.map R R C (Localization.Away (algebraMap R C e)))).mpr
    intro x
    obtain ⟨n, hn⟩ := s4 _ x (fun q _ hq => (s3 q hq).1 x)
    exact ⟨_, ⟨n, rfl⟩, hn⟩
  · apply (IsLocalizedModule.subsingleton_iff P
      (Algebra.H1Cotangent.map R R C (Localization.Away (algebraMap R C e)))).mpr
    intro x
    obtain ⟨n, hn⟩ := s4 _ x (fun q _ hq => (s3 q hq).2 x)
    exact ⟨_, ⟨n, rfl⟩, hn⟩

theorem wc_pcm_local_lift : ∀ (R : Type u) [CommRing R] (C D B : Type u) [CommRing C] [CommRing D] [CommRing B] [Algebra R C] [Algebra R D] [Algebra R B] (f e : R) (n : ℕ) (π : D →ₐ[R] B) (ν : C →ₐ[R] B), Function.Surjective π → (∀ x : D, π x = 0 ↔ ∃ y : D, x = f • y) → (∀ x : D, f ^ n • x = 0) → Algebra.FormallyEtale R (Localization.Away (algebraMap R C e)) → ∃ φ : C →ₐ[R] Localization.Away (algebraMap R D e), wcPcmLift π ν e φ ∧ ∀ φ' : C →ₐ[R] Localization.Away (algebraMap R D e), wcPcmLift π ν e φ' → φ' = φ :=
by
  intro R _ C D B _ _ _ _ _ _ f e n π ν hπs hπk hfn hFE
  classical

  have hunitB : ∀ y : Submonoid.powers (algebraMap R D e),
      IsUnit (((IsScalarTower.toAlgHom R B (Localization.Away (algebraMap R B e))).comp π)
        (y : D)) := by
    rintro ⟨y, k, rfl⟩
    show IsUnit (algebraMap B (Localization.Away (algebraMap R B e)) (π (algebraMap R D e ^ k)))
    rw [map_pow, AlgHom.commutes, map_pow]
    exact (IsLocalization.Away.algebraMap_isUnit _).pow k
  obtain ⟨p, hp⟩ : ∃ p : Localization.Away (algebraMap R D e) →ₐ[R]
      Localization.Away (algebraMap R B e), ∀ x : D,
      p (algebraMap D (Localization.Away (algebraMap R D e)) x) =
        algebraMap B (Localization.Away (algebraMap R B e)) (π x) := by
    refine ⟨IsLocalization.liftAlgHom (M := Submonoid.powers (algebraMap R D e)) hunitB,
      fun x => ?_⟩
    rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
    rfl
  have hF1 : ∀ (x : D) (N : ℕ),
      p (IsLocalization.mk' (Localization.Away (algebraMap R D e)) x
        (⟨algebraMap R D e ^ N, N, rfl⟩ : Submonoid.powers (algebraMap R D e))) =
      IsLocalization.mk' (Localization.Away (algebraMap R B e)) (π x)
        (⟨algebraMap R B e ^ N, N, rfl⟩ : Submonoid.powers (algebraMap R B e)) := by
    intro x N
    have h1 : π (algebraMap R D e ^ N) = algebraMap R B e ^ N := by
      rw [map_pow, AlgHom.commutes]
    have hs : IsLocalization.mk' (Localization.Away (algebraMap R D e)) x
        (⟨algebraMap R D e ^ N, N, rfl⟩ : Submonoid.powers (algebraMap R D e)) *
        algebraMap D (Localization.Away (algebraMap R D e)) (algebraMap R D e ^ N) =
        algebraMap D (Localization.Away (algebraMap R D e)) x :=
      IsLocalization.mk'_spec _ x _
    symm
    rw [IsLocalization.mk'_eq_iff_eq_mul]
    show _ = _ * algebraMap B _ (algebraMap R B e ^ N)
    rw [← h1, ← hp, ← hp, ← map_mul, hs]
  have hpsurj : Function.Surjective p := by
    intro y
    obtain ⟨⟨b, ⟨t, N, rfl⟩⟩, rfl⟩ :=
      IsLocalization.mk'_surjective (Submonoid.powers (algebraMap R B e)) y
    obtain ⟨x, rfl⟩ := hπs b
    exact ⟨_, hF1 x N⟩
  have hker : ∀ z ∈ RingHom.ker p,
      z ∈ Ideal.span {algebraMap R (Localization.Away (algebraMap R D e)) f} := by
    intro z hz
    rw [RingHom.mem_ker] at hz
    obtain ⟨⟨x, ⟨t, N, rfl⟩⟩, rfl⟩ :=
      IsLocalization.mk'_surjective (Submonoid.powers (algebraMap R D e)) z
    have hz' : IsLocalization.mk' (Localization.Away (algebraMap R B e)) (π x)
        (⟨algebraMap R B e ^ N, N, rfl⟩ : Submonoid.powers (algebraMap R B e)) = 0 := by
      rw [← hF1]; exact hz
    rw [IsLocalization.mk'_eq_zero_iff] at hz'
    obtain ⟨⟨m, K, rfl⟩, hm⟩ := hz'
    have h2 : π (algebraMap R D e ^ K * x) = 0 := by
      rw [map_mul, map_pow, AlgHom.commutes]; exact hm
    obtain ⟨y, hy⟩ := (hπk _).mp h2
    rw [Ideal.mem_span_singleton']
    refine ⟨IsLocalization.mk' (Localization.Away (algebraMap R D e)) y
      (⟨algebraMap R D e ^ (K + N), K + N, rfl⟩ : Submonoid.powers (algebraMap R D e)), ?_⟩
    rw [mul_comm, IsScalarTower.algebraMap_apply R D (Localization.Away (algebraMap R D e)),
      IsLocalization.mul_mk'_eq_mk'_of_mul, IsLocalization.mk'_eq_iff_eq]
    congr 1
    show algebraMap R D e ^ N * (algebraMap R D f * y) = algebraMap R D e ^ (K + N) * x
    rw [← Algebra.smul_def, ← hy, pow_add]
    ring
  have hfn' : (algebraMap R (Localization.Away (algebraMap R D e)) f) ^ n = 0 := by
    have h0 : algebraMap R D (f ^ n) = 0 := by
      rw [Algebra.algebraMap_eq_smul_one (f ^ n)]
      exact hfn 1
    rw [← map_pow, IsScalarTower.algebraMap_apply R D (Localization.Away (algebraMap R D e)),
      h0, map_zero]
  have hpnil : IsNilpotent (RingHom.ker p) := by
    refine ⟨n, ?_⟩
    have h1 : RingHom.ker p ^ n ≤
        Ideal.span {algebraMap R (Localization.Away (algebraMap R D e)) f} ^ n :=
      Ideal.pow_right_mono hker n
    rw [Ideal.span_singleton_pow, hfn', Ideal.span_singleton_eq_bot.mpr rfl] at h1
    rw [Ideal.zero_eq_bot]
    exact le_bot_iff.mp h1

  have hKE : ∀ (x : D) (N : ℕ) (b : B),
      IsLocalization.mk' (Localization.Away (algebraMap R B e)) (π x)
        (⟨algebraMap R B e ^ N, N, rfl⟩ : Submonoid.powers (algebraMap R B e)) =
        algebraMap B (Localization.Away (algebraMap R B e)) b ↔
      ∃ K : ℕ, e ^ K • (π x - e ^ N • b) = 0 := by
    intro x N b
    rw [IsLocalization.mk'_eq_iff_eq_mul, ← map_mul,
      IsLocalization.eq_iff_exists (Submonoid.powers (algebraMap R B e))]
    constructor
    · rintro ⟨⟨m, K, rfl⟩, hK⟩
      refine ⟨K, ?_⟩
      have hK' : algebraMap R B e ^ K * π x =
          algebraMap R B e ^ K * (b * algebraMap R B e ^ N) := hK
      rw [Algebra.smul_def, Algebra.smul_def, map_pow, map_pow, mul_sub, hK']
      ring
    · rintro ⟨K, hK⟩
      refine ⟨⟨algebraMap R B e ^ K, K, rfl⟩, ?_⟩
      rw [Algebra.smul_def, Algebra.smul_def, map_pow, map_pow, mul_sub, sub_eq_zero] at hK
      show algebraMap R B e ^ K * π x = algebraMap R B e ^ K * (b * algebraMap R B e ^ N)
      rw [hK]
      ring
  have hiff : ∀ φ : C →ₐ[R] Localization.Away (algebraMap R D e),
      wcPcmLift π ν e φ ↔
        ∀ c, p (φ c) = algebraMap B (Localization.Away (algebraMap R B e)) (ν c) := by
    intro φ
    constructor
    · intro h c
      obtain ⟨⟨x, ⟨t, N, rfl⟩⟩, hx⟩ :=
        IsLocalization.mk'_surjective (Submonoid.powers (algebraMap R D e)) (φ c)
      have hx' : φ c = IsLocalization.mk' (Localization.Away (algebraMap R D e)) x
          (⟨algebraMap R D e ^ N, N, rfl⟩ : Submonoid.powers (algebraMap R D e)) := hx.symm
      obtain ⟨K, hK⟩ := h c x N hx'
      rw [hx', hF1]
      exact (hKE x N (ν c)).mpr ⟨K, hK⟩
    · intro h c x N hx
      apply (hKE x N (ν c)).mp
      rw [← hF1, ← hx, h]

  have hgunit : ∀ y : Submonoid.powers (algebraMap R C e),
      IsUnit (((IsScalarTower.toAlgHom R B (Localization.Away (algebraMap R B e))).comp ν)
        (y : C)) := by
    rintro ⟨y, k, rfl⟩
    show IsUnit (algebraMap B (Localization.Away (algebraMap R B e)) (ν (algebraMap R C e ^ k)))
    rw [map_pow, AlgHom.commutes, map_pow]
    exact (IsLocalization.Away.algebraMap_isUnit _).pow k
  obtain ⟨gh, hgh⟩ : ∃ gh : Localization.Away (algebraMap R C e) →ₐ[R]
      Localization.Away (algebraMap R B e), ∀ c : C,
      gh (algebraMap C (Localization.Away (algebraMap R C e)) c) =
        algebraMap B (Localization.Away (algebraMap R B e)) (ν c) := by
    refine ⟨IsLocalization.liftAlgHom (M := Submonoid.powers (algebraMap R C e)) hgunit,
      fun c => ?_⟩
    rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
    rfl
  let q := Ideal.quotientKerAlgEquivOfSurjective hpsurj
  have hq : ∀ y, q (Ideal.Quotient.mk (RingHom.ker p) y) = p y := fun y => rfl
  let Φ := Algebra.FormallySmooth.lift (RingHom.ker p) hpnil
    ((q.symm : Localization.Away (algebraMap R B e) →ₐ[R] _).comp gh)
  have hΦ : ∀ z, p (Φ z) = gh z := by
    intro z
    rw [← hq, Algebra.FormallySmooth.mk_lift]
    exact q.apply_symm_apply (gh z)
  let φ := Φ.comp (IsScalarTower.toAlgHom R C (Localization.Away (algebraMap R C e)))
  have hφ : ∀ c, p (φ c) = algebraMap B (Localization.Away (algebraMap R B e)) (ν c) := by
    intro c
    show p (Φ (algebraMap C _ c)) = _
    rw [hΦ, hgh]
  refine ⟨φ, (hiff φ).mpr hφ, fun φ' hφ' => ?_⟩
  have h' := (hiff φ').mp hφ'
  have hunitD : ∀ y : Submonoid.powers (algebraMap R C e), IsUnit (φ' (y : C)) := by
    rintro ⟨y, k, rfl⟩
    show IsUnit (φ' (algebraMap R C e ^ k))
    rw [map_pow, AlgHom.commutes,
      IsScalarTower.algebraMap_apply R D (Localization.Away (algebraMap R D e))]
    exact (IsLocalization.Away.algebraMap_isUnit _).pow k
  obtain ⟨Φ', hΦ'⟩ : ∃ Φ' : Localization.Away (algebraMap R C e) →ₐ[R]
      Localization.Away (algebraMap R D e), ∀ c : C,
      Φ' (algebraMap C (Localization.Away (algebraMap R C e)) c) = φ' c := by
    refine ⟨IsLocalization.liftAlgHom (M := Submonoid.powers (algebraMap R C e)) hunitD,
      fun c => ?_⟩
    rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
    rfl
  have heq : p.comp Φ' = p.comp Φ := by
    apply IsLocalization.algHom_ext (Submonoid.powers (algebraMap R C e))
    apply AlgHom.ext
    intro c
    show p (Φ' (algebraMap C _ c)) = p (Φ (algebraMap C _ c))
    rw [hΦ', h', hΦ, hgh]
  have hΦΦ : Φ' = Φ := by
    apply Algebra.FormallyUnramified.ext (RingHom.ker p) hpnil
    intro z
    rw [Ideal.Quotient.eq, RingHom.mem_ker, map_sub, sub_eq_zero]
    exact DFunLike.congr_fun heq z
  apply AlgHom.ext
  intro c
  rw [← hΦ' c, hΦΦ]
  rfl

theorem wc_pcm_compat : ∀ (R : Type u) [CommRing R] (C D B : Type u) [CommRing C] [CommRing D] [CommRing B] [Algebra R C] [Algebra R D] [Algebra R B] (π : D →ₐ[R] B) (ν : C →ₐ[R] B) (a b : R) (φa : C →ₐ[R] Localization.Away (algebraMap R D a)) (φb : C →ₐ[R] Localization.Away (algebraMap R D b)), wcPcmLift π ν a φa → wcPcmLift π ν b φb → (∀ φ φ' : C →ₐ[R] Localization.Away (algebraMap R D (a * b)), wcPcmLift π ν (a * b) φ → wcPcmLift π ν (a * b) φ' → φ = φ') → ∀ (c : C) (u v : D) (N : ℕ), φa c = IsLocalization.mk' (Localization.Away (algebraMap R D a)) u (⟨algebraMap R D a ^ N, N, rfl⟩ : Submonoid.powers (algebraMap R D a)) → φb c = IsLocalization.mk' (Localization.Away (algebraMap R D b)) v (⟨algebraMap R D b ^ N, N, rfl⟩ : Submonoid.powers (algebraMap R D b)) → ∃ L : ℕ, (a * b) ^ L • (b ^ N • u - a ^ N • v) = 0 :=
by
  intro R _ C D B _ _ _ _ _ _ π ν a b φa φb ha hb huniq c u v N hu hv
  have restrict : ∀ (e w t : R), t = e * w →
      ∃ ρ : Localization.Away (algebraMap R D e) →ₐ[R] Localization.Away (algebraMap R D t),
        (∀ (x : D) (s : Submonoid.powers (algebraMap R D e)),
          ρ (IsLocalization.mk' (Localization.Away (algebraMap R D e)) x s) *
            algebraMap D (Localization.Away (algebraMap R D t)) (s : D) =
            algebraMap D (Localization.Away (algebraMap R D t)) x) ∧
        (∀ φ : C →ₐ[R] Localization.Away (algebraMap R D e),
          wcPcmLift π ν e φ → wcPcmLift π ν t (ρ.comp φ)) := by
    intro e w t ht
    subst ht
    have hunit : ∀ y : Submonoid.powers (algebraMap R D e),
        IsUnit ((IsScalarTower.toAlgHom R D (Localization.Away (algebraMap R D (e * w))))
          (y : D)) := by
      rintro ⟨_, k, rfl⟩
      have h1 : IsUnit (algebraMap D (Localization.Away (algebraMap R D (e * w)))
          (algebraMap R D (e * w))) :=
        IsLocalization.Away.algebraMap_isUnit _
      have h3 : algebraMap D (Localization.Away (algebraMap R D (e * w))) (algebraMap R D (e * w)) =
          algebraMap D (Localization.Away (algebraMap R D (e * w))) (algebraMap R D e) *
          algebraMap D (Localization.Away (algebraMap R D (e * w))) (algebraMap R D w) :=
        (congrArg (algebraMap D (Localization.Away (algebraMap R D (e * w))))
          (map_mul (algebraMap R D) e w)).trans (map_mul _ _ _)
      rw [h3] at h1
      have h2 := isUnit_of_mul_isUnit_left h1
      simp only [IsScalarTower.coe_toAlgHom', map_pow]
      exact h2.pow k
    let ρ : Localization.Away (algebraMap R D e) →ₐ[R]
        Localization.Away (algebraMap R D (e * w)) :=
      IsLocalization.liftAlgHom (M := Submonoid.powers (algebraMap R D e)) hunit
    have hρ1 : ∀ x : D, ρ (algebraMap D (Localization.Away (algebraMap R D e)) x) =
        algebraMap D (Localization.Away (algebraMap R D (e * w))) x := by
      intro x
      simp only [ρ, IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq] <;> rfl
    have hρ2 : ∀ (x : D) (s : Submonoid.powers (algebraMap R D e)),
        ρ (IsLocalization.mk' (Localization.Away (algebraMap R D e)) x s) *
          algebraMap D (Localization.Away (algebraMap R D (e * w))) (s : D) =
          algebraMap D (Localization.Away (algebraMap R D (e * w))) x := by
      intro x s
      rw [← hρ1 (s : D), ← hρ1 x, ← map_mul, IsLocalization.mk'_spec]
    refine ⟨ρ, hρ2, ?_⟩
    intro φ hφ c x N hx
    obtain ⟨⟨u', s⟩, hy⟩ :=
      IsLocalization.mk'_surjective (Submonoid.powers (algebraMap R D e)) (φ c)
    obtain ⟨M, hM⟩ := (Submonoid.mem_powers_iff _ _).mp s.2
    have hs : s = ⟨algebraMap R D e ^ M, M, rfl⟩ := Subtype.ext hM.symm
    rw [hs] at hy
    obtain ⟨K, hK⟩ := hφ c u' M hy.symm
    have e1 : ρ (φ c) * algebraMap D (Localization.Away (algebraMap R D (e * w)))
        (algebraMap R D e ^ M) = algebraMap D _ u' := by
      rw [← hy]; exact hρ2 u' _
    have e2 : ρ (φ c) * algebraMap D (Localization.Away (algebraMap R D (e * w)))
        (algebraMap R D (e * w) ^ N) = algebraMap D _ x := by
      have : ρ (φ c) = (ρ.comp φ) c := rfl
      rw [this, hx]; exact IsLocalization.mk'_spec _ _ _
    have e3 : algebraMap D (Localization.Away (algebraMap R D (e * w)))
        (algebraMap R D e ^ M * x) =
        algebraMap D (Localization.Away (algebraMap R D (e * w)))
        (algebraMap R D (e * w) ^ N * u') := by
      rw [map_mul (algebraMap D (Localization.Away (algebraMap R D (e * w))))
          (algebraMap R D e ^ M) x,
        map_mul (algebraMap D (Localization.Away (algebraMap R D (e * w))))
          (algebraMap R D (e * w) ^ N) u', ← e1, ← e2]
      ring
    obtain ⟨⟨_, L, rfl⟩, hL⟩ := (IsLocalization.eq_iff_exists
      (Submonoid.powers (algebraMap R D (e * w)))
      (Localization.Away (algebraMap R D (e * w)))).mp e3
    dsimp only at hL
    have hL' := congrArg π hL
    simp only [map_mul, map_pow, AlgHom.commutes] at hL'
    simp only [Algebra.smul_def, map_pow] at hK
    refine ⟨K + M + L, ?_⟩
    simp only [Algebra.smul_def, map_pow, map_mul] at hL' ⊢
    linear_combination ((algebraMap R B w) ^ (K + M) * (algebraMap R B e) ^ K) * hL' +
      ((algebraMap R B w) ^ (K + M) * (algebraMap R B e * algebraMap R B w) ^ L *
        (algebraMap R B e * algebraMap R B w) ^ N) * hK
  obtain ⟨ρa, hρa, hLa⟩ := restrict a b (a * b) rfl
  obtain ⟨ρb, hρb, hLb⟩ := restrict b a (a * b) (mul_comm a b)
  have heq := huniq _ _ (hLa φa ha) (hLb φb hb)
  have hz : ρa (φa c) = ρb (φb c) := AlgHom.congr_fun heq c
  have e1 : ρa (φa c) * algebraMap D (Localization.Away (algebraMap R D (a * b)))
      (algebraMap R D a ^ N) = algebraMap D _ u := by
    rw [hu]; exact hρa u _
  have e2 : ρa (φa c) * algebraMap D (Localization.Away (algebraMap R D (a * b)))
      (algebraMap R D b ^ N) = algebraMap D _ v := by
    rw [hz, hv]; exact hρb v _
  have e3 : algebraMap D (Localization.Away (algebraMap R D (a * b)))
      (algebraMap R D b ^ N * u) =
      algebraMap D (Localization.Away (algebraMap R D (a * b))) (algebraMap R D a ^ N * v) := by
    rw [map_mul (algebraMap D (Localization.Away (algebraMap R D (a * b))))
        (algebraMap R D b ^ N) u,
      map_mul (algebraMap D (Localization.Away (algebraMap R D (a * b))))
        (algebraMap R D a ^ N) v, ← e1, ← e2]
    ring
  obtain ⟨⟨_, L, rfl⟩, hL⟩ := (IsLocalization.eq_iff_exists
    (Submonoid.powers (algebraMap R D (a * b)))
    (Localization.Away (algebraMap R D (a * b)))).mp e3
  dsimp only at hL
  refine ⟨L, ?_⟩
  simp only [Algebra.smul_def, map_pow, map_mul] at hL ⊢
  linear_combination hL

theorem wc_pcm_glue_linear : ∀ (R : Type u) [CommRing R] (C : Type u) [AddCommGroup C] [Module R C] (D : Type u) [CommRing D] [Algebra R D] (a b : R), (∀ x : D, a • x = 0 → x = 0) → (∀ x : D, b • x = 0 → x = 0) → (∀ (N j : ℕ) (z w : D), b ^ j • z = a ^ N • w → ∃ w' : D, z = a ^ N • w') → ∀ (φa : C →ₗ[R] Localization.Away (algebraMap R D a)) (φb : C →ₗ[R] Localization.Away (algebraMap R D b)), (∀ (c : C) (u v : D) (N : ℕ), φa c = IsLocalization.mk' (Localization.Away (algebraMap R D a)) u (⟨algebraMap R D a ^ N, N, rfl⟩ : Submonoid.powers (algebraMap R D a)) → φb c = IsLocalization.mk' (Localization.Away (algebraMap R D b)) v (⟨algebraMap R D b ^ N, N, rfl⟩ : Submonoid.powers (algebraMap R D b)) → ∃ L : ℕ, (a * b) ^ L • (b ^ N • u - a ^ N • v) = 0) → ∃ ψ : C →ₗ[R] D, ∀ c : C, algebraMap D (Localization.Away (algebraMap R D a)) (ψ c) = φa c ∧ algebraMap D (Localization.Away (algebraMap R D b)) (ψ c) = φb c :=
by
  intro R _ C _ _ D _ _ a b ha hb hG φa φb hcomp

  have pa : ∀ (k : ℕ) (x : D), (algebraMap R D a) ^ k * x = 0 → x = 0 := by
    intro k
    induction k with
    | zero => intro x h; simpa using h
    | succ k ih =>
      intro x h
      apply ha x
      apply ih
      rw [Algebra.smul_def, ← mul_assoc, ← pow_succ]
      exact h
  have pb : ∀ (k : ℕ) (x : D), (algebraMap R D b) ^ k * x = 0 → x = 0 := by
    intro k
    induction k with
    | zero => intro x h; simpa using h
    | succ k ih =>
      intro x h
      apply hb x
      apply ih
      rw [Algebra.smul_def, ← mul_assoc, ← pow_succ]
      exact h

  have inj : ∀ x : D, algebraMap D (Localization.Away (algebraMap R D a)) x = 0 → x = 0 := by
    intro x hx
    rw [IsLocalization.map_eq_zero_iff (Submonoid.powers (algebraMap R D a))] at hx
    obtain ⟨⟨m, k, rfl⟩, hm⟩ := hx
    exact pa k x hm

  have hsm : ∀ (r : R) (y : D), algebraMap D (Localization.Away (algebraMap R D a)) (r • y)
      = r • algebraMap D (Localization.Away (algebraMap R D a)) y := by
    intro r y
    rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply, ← Algebra.smul_def]

  have hpt : ∀ c : C, ∃ x : D, algebraMap D (Localization.Away (algebraMap R D a)) x = φa c ∧
      algebraMap D (Localization.Away (algebraMap R D b)) x = φb c := by
    intro c
    obtain ⟨n1, u1, h1⟩ :=
      IsLocalization.Away.surj (algebraMap R D a) (φa c)
    obtain ⟨n2, v1, h2⟩ :=
      IsLocalization.Away.surj (algebraMap R D b) (φb c)
    have e1 : φa c = IsLocalization.mk' (Localization.Away (algebraMap R D a))
        ((algebraMap R D a) ^ n2 * u1)
        (⟨(algebraMap R D a) ^ (n1 + n2), n1 + n2, rfl⟩ : Submonoid.powers (algebraMap R D a)) := by
      rw [IsLocalization.eq_mk'_iff_mul_eq]
      simp only [map_mul, map_pow, pow_add]
      rw [← h1]; ring
    have e2 : φb c = IsLocalization.mk' (Localization.Away (algebraMap R D b))
        ((algebraMap R D b) ^ n1 * v1)
        (⟨(algebraMap R D b) ^ (n1 + n2), n1 + n2, rfl⟩ : Submonoid.powers (algebraMap R D b)) := by
      rw [IsLocalization.eq_mk'_iff_mul_eq]
      simp only [map_mul, map_pow, pow_add]
      rw [← h2]; ring
    obtain ⟨L, hL⟩ := hcomp c _ _ (n1 + n2) e1 e2
    simp only [Algebra.smul_def, map_mul, map_pow] at hL
    have s1 : (algebraMap R D b) ^ L * ((algebraMap R D b) ^ (n1 + n2) * ((algebraMap R D a) ^ n2 * u1)
        - (algebraMap R D a) ^ (n1 + n2) * ((algebraMap R D b) ^ n1 * v1)) = 0 := by
      apply pa L
      rw [← hL]; ring
    obtain ⟨x, hx⟩ := hG (n1 + n2) (L + (n1 + n2)) ((algebraMap R D a) ^ n2 * u1)
      (b ^ L • ((algebraMap R D b) ^ n1 * v1)) (by
      simp only [Algebra.smul_def, map_pow]; linear_combination s1)
    rw [Algebra.smul_def, map_pow] at hx
    have s3 : (algebraMap R D b) ^ n1 * v1 = (algebraMap R D b) ^ (n1 + n2) * x := by
      have : (algebraMap R D b) ^ (n1 + n2) * x - (algebraMap R D b) ^ n1 * v1 = 0 := by
        apply pb L
        apply pa (n1 + n2)
        rw [hx] at s1
        linear_combination s1
      linear_combination -this
    refine ⟨x, ?_, ?_⟩
    · rw [e1, IsLocalization.eq_mk'_iff_mul_eq, hx, map_mul, mul_comm]
    · rw [e2, IsLocalization.eq_mk'_iff_mul_eq, s3, map_mul, mul_comm]
  choose g hg using hpt
  refine ⟨{ toFun := g, map_add' := ?_, map_smul' := ?_ }, fun c => hg c⟩
  · intro c c'
    rw [← sub_eq_zero]
    apply inj
    rw [map_sub, map_add, (hg _).1, (hg _).1, (hg _).1, map_add, sub_self]
  · intro r c
    rw [← sub_eq_zero]
    apply inj
    rw [map_sub, RingHom.id_apply, hsm, (hg _).1, (hg _).1, map_smul, sub_self]

theorem wc_pcm_C0_regular : ∀ (R : Type u) [CommRing R] (s : R) (E : Type u) [CommRing E] [Algebra R E] [Algebra (Localization.Away s) E] [IsScalarTower R (Localization.Away s) E] [Algebra.Etale (Localization.Away s) E] [Module.Finite (Localization.Away s) E] (f : R) [(Ideal.span {f}).IsPrime], s ∉ Ideal.span {f} → ∀ (a : R), a ∉ Ideal.span {f} → ∀ z : integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E), a • z = 0 → z = 0 :=
by
  intro R _ s E _ _ _ _ _ _ f _ hsf a haf z hz
  haveI : Module.Flat (Localization.Away s) E := Algebra.Smooth.flat (Localization.Away s) E
  haveI : Module.Flat R E := Module.Flat.trans R (Localization.Away s) E
  have hQ : IsSMulRegular (R ⧸ Ideal.span {f}) a := by
    intro x y hxy
    change a • x = a • y at hxy
    have hne : Ideal.Quotient.mk (Ideal.span {f}) a ≠ 0 := by
      rw [Ne, Ideal.Quotient.eq_zero_iff_mem]; exact haf
    rw [Algebra.smul_def, Algebra.smul_def, Ideal.Quotient.algebraMap_eq] at hxy
    exact mul_left_cancel₀ hne hxy
  have hT : IsSMulRegular (TensorProduct R (R ⧸ Ideal.span {f}) E) a :=
    IsSMulRegular.rTensor E hQ
  apply Subtype.ext
  have h1 : a • (z : TensorProduct R (R ⧸ Ideal.span {f}) E) = 0 := by
    have h2 := congrArg Subtype.val hz
    exact h2
  exact hT.right_eq_zero_of_smul h1

theorem wc_pls_comparison_map : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R] (s : R), s ≠ 0 → ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra (Localization.Away s) E] [IsScalarTower R (Localization.Away s) E] [Algebra.Etale (Localization.Away s) E] [Module.Finite (Localization.Away s) E], (∀ (q : Ideal R) [q.IsPrime], q < IsLocalRing.maximalIdeal R → Algebra.Etale (Localization.AtPrime q) (TensorProduct R (Localization.AtPrime q) (integralClosure R E))) → ∀ (f : R), f ∈ IsLocalRing.maximalIdeal R → f ∉ IsLocalRing.maximalIdeal R ^ 2 → ∀ [(Ideal.span {f}).IsPrime], s ∉ Ideal.span {f} → Algebra.Etale (R ⧸ Ideal.span {f}) (integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E)) → ∀ (n : ℕ), 1 ≤ n → ∀ (D : Type u) [CommRing D] [Algebra R D] (π : D →ₐ[R] integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E)) (r : ℕ), Function.Surjective π → (∀ x : D, π x = 0 ↔ ∃ y : D, x = f • y) → (∀ x : D, f ^ n • x = 0) → Nonempty (D ≃ₗ[R] (Fin r → R ⧸ Ideal.span {f ^ n})) → ∀ (a b : R), a ∈ IsLocalRing.maximalIdeal R → b ∈ IsLocalRing.maximalIdeal R → a ∉ Ideal.span {f} → (∀ x : D, a • x = 0 → x = 0) → (∀ x : D, b • x = 0 → x = 0) → (∀ (N j : ℕ) (z w : D), b ^ j • z = a ^ N • w → ∃ w' : D, z = a ^ N • w') → ∃ ψ : integralClosure R E →ₗ[R] D, (∀ c : integralClosure R E, ((π (ψ c) : integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E)) : TensorProduct R (R ⧸ Ideal.span {f}) E) = TensorProduct.tmul R (1 : R ⧸ Ideal.span {f}) (c : E)) ∧ (∀ x : D, ∃ (N : ℕ) (c : integralClosure R E), a ^ N • x = ψ c) ∧ (∀ x : D, ∃ (N : ℕ) (c : integralClosure R E), b ^ N • x = ψ c) ∧ (∀ w : integralClosure R E, ψ w = 0 → ∃ (M : ℕ) (w' : integralClosure R E), a ^ M • w = f ^ n • w') :=
by
  intro R _ _ _ s hs E _ _ _ _ _ _ hET f hfm hfm2 _ hsf hC0 n hn D _ _ π r hπs hπk hfn hDe a b ha hb
    haf hDa hDb hG
  classical
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  obtain ⟨eqv⟩ := hDe
  have hf0 : f ≠ 0 := by
    rintro rfl
    exact hfm2 (Ideal.zero_mem _)

  let incl : integralClosure R E →ₐ[R] TensorProduct R (R ⧸ Ideal.span {f}) E :=
    (Algebra.TensorProduct.includeRight).comp (integralClosure R E).val
  have hmem : ∀ c : integralClosure R E,
      incl c ∈ integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E) := by
    intro c
    have h1 : IsIntegral R (incl c) :=
      c.2.map (Algebra.TensorProduct.includeRight : E →ₐ[R] TensorProduct R (R ⧸ Ideal.span {f}) E)
    exact h1.tower_top
  let ν : integralClosure R E →ₐ[R]
      integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E) :=
    { toFun := fun c => ⟨incl c, hmem c⟩
      map_one' := Subtype.ext (map_one incl)
      map_mul' := fun x y => Subtype.ext (map_mul incl x y)
      map_zero' := Subtype.ext (map_zero incl)
      map_add' := fun x y => Subtype.ext (map_add incl x y)
      commutes' := fun x => Subtype.ext (incl.commutes x) }
  have hν : ∀ c : integralClosure R E, ((ν c : integralClosure (R ⧸ Ideal.span {f})
      (TensorProduct R (R ⧸ Ideal.span {f}) E)) : TensorProduct R (R ⧸ Ideal.span {f}) E) =
      TensorProduct.tmul R (1 : R ⧸ Ideal.span {f}) (c : E) := fun c => rfl
  have hfC0 : ∀ z : integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E),
      f • z = 0 := by
    intro z
    rw [← algebraMap_smul (R ⧸ Ideal.span {f}) f z, Ideal.Quotient.algebraMap_eq,
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self f), zero_smul]

  have hFE : ∀ e ∈ IsLocalRing.maximalIdeal R,
      Algebra.FormallyEtale R (Localization.Away (algebraMap R (integralClosure R E) e)) :=
    fun e he => wc_pcm_formallyEtale_away R (integralClosure R E) hET e he
  have hLL := wc_pcm_local_lift R (integralClosure R E) D
    (integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E))
  obtain ⟨φa, hφa, -⟩ := hLL f a (m + 1) π ν hπs hπk hfn (hFE a ha)
  obtain ⟨φb, hφb, -⟩ := hLL f b (m + 1) π ν hπs hπk hfn (hFE b hb)
  obtain ⟨φab, -, huab⟩ := hLL f (a * b) (m + 1) π ν hπs hπk hfn
    (hFE (a * b) (Ideal.mul_mem_right b _ ha))

  have hcomp : ∀ (c : integralClosure R E) (u v : D) (N : ℕ),
      φa.toLinearMap c = IsLocalization.mk' (Localization.Away (algebraMap R D a)) u
        (⟨algebraMap R D a ^ N, N, rfl⟩ : Submonoid.powers (algebraMap R D a)) →
      φb.toLinearMap c = IsLocalization.mk' (Localization.Away (algebraMap R D b)) v
        (⟨algebraMap R D b ^ N, N, rfl⟩ : Submonoid.powers (algebraMap R D b)) →
      ∃ L : ℕ, (a * b) ^ L • (b ^ N • u - a ^ N • v) = 0 := by
    intro c u v N h1 h2
    exact wc_pcm_compat R (integralClosure R E) D
      (integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E)) π ν a b φa φb
      hφa hφb (fun φ φ' h h' => (huab φ h).trans (huab φ' h').symm) c u v N h1 h2
  obtain ⟨ψ, hψ⟩ := wc_pcm_glue_linear R (integralClosure R E) D a b hDa hDb hG
    φa.toLinearMap φb.toLinearMap hcomp

  have hregC0 : ∀ (k : ℕ)
      (z : integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E)),
      a ^ k • z = 0 → z = 0 := by
    intro k
    induction k with
    | zero => intro z hz; simpa using hz
    | succ k ih =>
      intro z hz
      rw [pow_succ', mul_smul] at hz
      exact ih z (wc_pcm_C0_regular R s E f hsf a haf _ hz)
  have hP0' : ∀ c : integralClosure R E, π (ψ c) = ν c := by
    intro c
    have h1 : φa c = IsLocalization.mk' (Localization.Away (algebraMap R D a)) (ψ c)
        (⟨algebraMap R D a ^ 0, 0, rfl⟩ : Submonoid.powers (algebraMap R D a)) := by
      have h2 : (⟨algebraMap R D a ^ 0, 0, rfl⟩ : Submonoid.powers (algebraMap R D a)) = 1 :=
        Subtype.ext (pow_zero _)
      rw [h2, IsLocalization.mk'_one]
      exact ((hψ c).1).symm
    obtain ⟨K, hK⟩ := hφa c (ψ c) 0 h1
    rw [pow_zero, one_smul] at hK
    exact sub_eq_zero.mp (hregC0 K _ hK)

  have hS : ∀ e ∈ IsLocalRing.maximalIdeal R,
      ∀ y : integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E),
      ∃ (N : ℕ) (c : integralClosure R E), e ^ N • y = ν c := by
    intro e he y
    let J : Ideal R := (LinearMap.range ν.toLinearMap).colon {y}
    have hJ : ∀ t : R, t ∈ J ↔ ∃ c, t • y = ν c := by
      intro t
      rw [Submodule.mem_colon_singleton, LinearMap.mem_range]
      constructor
      · rintro ⟨c, hc⟩; exact ⟨c, hc.symm⟩
      · rintro ⟨c, hc⟩; exact ⟨c, hc.symm⟩
    have hfJ : f ∈ J := (hJ f).mpr ⟨0, by rw [map_zero]; exact hfC0 y⟩
    have heJ : e ∈ J.radical := by
      rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
      rintro P ⟨hJP, hP⟩
      by_contra heP
      have hPm : P < IsLocalRing.maximalIdeal R :=
        lt_of_le_of_ne (IsLocalRing.le_maximalIdeal hP.ne_top)
          (fun h => heP (by rw [h]; exact he))
      obtain ⟨t, c, htP, htc⟩ :=
        wc_pcm_nu_local_surj R s hs E hET f hfm hfm2 hsf hC0 P hPm (hJP hfJ) y
      exact htP (hJP ((hJ t).mpr ⟨c, Subtype.ext htc⟩))
    obtain ⟨N, hN⟩ := heJ
    obtain ⟨c, hc⟩ := (hJ _).mp hN
    exact ⟨N, c, hc⟩

  have hchase : ∀ e ∈ IsLocalRing.maximalIdeal R, ∀ x : D,
      ∃ (N : ℕ) (c : integralClosure R E), e ^ N • x = ψ c := by
    intro e he
    have key : ∀ j : ℕ, ∀ x : D, ∃ (N : ℕ) (c : integralClosure R E) (y : D),
        e ^ N • x = ψ c + f ^ j • y := by
      intro j
      induction j with
      | zero => intro x; exact ⟨0, 0, x, by simp⟩
      | succ j ih =>
        intro x
        obtain ⟨N, c, y, h⟩ := ih x
        obtain ⟨N', c', h'⟩ := hS e he (π y)
        have hk : π (e ^ N' • y - ψ c') = 0 := by
          rw [map_sub, map_smul, h', hP0', sub_self]
        obtain ⟨y', hy'⟩ := (hπk _).mp hk
        have h3 : e ^ N' • y = ψ c' + f • y' := by rw [← hy']; abel
        refine ⟨N' + N, e ^ N' • c + f ^ j • c', y', ?_⟩
        rw [pow_add e N' N, mul_smul, h, map_add, map_smul ψ (e ^ N') c, map_smul ψ (f ^ j) c',
          smul_add, smul_comm (e ^ N') (f ^ j) y, h3, smul_add, smul_smul (f ^ j) f y',
          ← pow_succ]
        abel
    intro x
    obtain ⟨N, c, y, h⟩ := key (m + 1) x
    exact ⟨N, c, by rw [h, hfn, add_zero]⟩

  have hh1 : ∀ c : integralClosure R E, ν c = 0 → ∃ c', c = f • c' := by
    intro c hc
    have htm : TensorProduct.tmul R (1 : R ⧸ Ideal.span {f}) (c : E) = 0 := by
      rw [← hν c, hc]; rfl
    obtain ⟨c', hc'⟩ := wc_pps_hartogs_kernel R s hs E f hsf c htm
    exact ⟨c', Subtype.ext (by rw [hc']; rfl)⟩
  have hsm : ∀ (g p : R), g • (Ideal.Quotient.mk (Ideal.span {f ^ (m + 1)}) p) =
      Ideal.Quotient.mk (Ideal.span {f ^ (m + 1)}) (g * p) := by
    intro g p
    rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, map_mul]
  have hDf : ∀ z : D, f • z = 0 → ∃ z' : D, z = f ^ m • z' := by
    intro z h
    have : ∀ i, ∃ q : R, eqv z i = f ^ m • Ideal.Quotient.mk (Ideal.span {f ^ (m + 1)}) q := by
      intro i
      have hi := congrFun (show eqv (f • z) = 0 by rw [h, map_zero]) i
      rw [map_smul, Pi.smul_apply, Pi.zero_apply] at hi
      obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (eqv z i)
      rw [← hp, hsm, Ideal.Quotient.eq_zero_iff_mem] at hi
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hi
      refine ⟨c, ?_⟩
      rw [← hp, hsm]
      exact congrArg (Ideal.Quotient.mk _) (mul_left_cancel₀ hf0 (by rw [← hc]; ring))
    choose q hq using this
    refine ⟨eqv.symm (fun i => Ideal.Quotient.mk _ (q i)), ?_⟩
    apply eqv.injective
    rw [map_smul, LinearEquiv.apply_symm_apply]
    funext i
    rw [Pi.smul_apply]
    exact hq i

  have hker : ∀ j : ℕ, j ≤ m + 1 → ∀ w : integralClosure R E, ψ w = 0 →
      ∃ (M : ℕ) (k c : integralClosure R E), ψ k = 0 ∧ a ^ M • w = f ^ j • k + f ^ (m + 1) • c := by
    intro j
    induction j with
    | zero => intro _ w hw; exact ⟨0, w, 0, hw, by simp⟩
    | succ j ih =>
      intro hj w hw
      obtain ⟨M, k, c, hk, h⟩ := ih (by omega) w hw
      have hνk : ν k = 0 := by rw [← hP0', hk, map_zero]
      obtain ⟨k1, hk1⟩ := hh1 k hνk
      have hfk1 : f • ψ k1 = 0 := by rw [← map_smul ψ f k1, ← hk1, hk]
      obtain ⟨z, hz⟩ := hDf _ hfk1
      obtain ⟨N, c1, hc1⟩ := hchase a ha z
      refine ⟨N + M, a ^ N • k1 - f ^ m • c1, f ^ j • c1 + a ^ N • c, ?_, ?_⟩
      · rw [map_sub, map_smul ψ (a ^ N) k1, map_smul ψ (f ^ m) c1, hz, ← hc1,
          smul_comm (a ^ N) (f ^ m) z, sub_self]
      · rw [pow_add a N M, mul_smul, h, hk1]
        module
  refine ⟨ψ, fun c => ?_, hchase a ha, hchase b hb, fun w hw => ?_⟩
  · exact (congrArg Subtype.val (hP0' c)).trans (hν c)
  · obtain ⟨M, k, c, -, h⟩ := hker (m + 1) le_rfl w hw
    exact ⟨M, k + c, by rw [h, smul_add]⟩

theorem wc_pps_lefschetz_surjective : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R] (s : R), s ≠ 0 → ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra (Localization.Away s) E] [IsScalarTower R (Localization.Away s) E] [Algebra.Etale (Localization.Away s) E] [Module.Finite (Localization.Away s) E], 3 ≤ (IsLocalRing.maximalIdeal R).height → (∀ (q : Ideal R) [q.IsPrime], q < IsLocalRing.maximalIdeal R → Algebra.Etale (Localization.AtPrime q) (TensorProduct R (Localization.AtPrime q) (integralClosure R E))) → ∀ (f : R), f ∈ IsLocalRing.maximalIdeal R → f ∉ IsLocalRing.maximalIdeal R ^ 2 → ∀ [(Ideal.span {f}).IsPrime], s ∉ Ideal.span {f} → Algebra.Etale (R ⧸ Ideal.span {f}) (integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E)) → ∀ (y : integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E)), ∃ c : integralClosure R E, TensorProduct.tmul R (1 : R ⧸ Ideal.span {f}) (c : E) = (y : TensorProduct R (R ⧸ Ideal.span {f}) E) :=
by
  intro R _ _ _ s hs E _ _ _ _ _ _ h3 hET f hfm hfm2 _ hsf hC0 y
  classical
  have hf0 : f ≠ 0 := by
    rintro rfl
    exact hfm2 (Ideal.zero_mem _)

  obtain ⟨a, b, ha, hb, ha0, hA1, hA2, hA3⟩ := wc_pls_regular_triple R h3 f hfm hfm2

  obtain ⟨m, m', α, β, hαinj, hrange⟩ := wc_pls_second_syzygy R s hs E

  have hH1 : ∀ (ι : Type) (n : ℕ) (p : ι → R), f ^ n • p = 0 → p = 0 := by
    intro ι n p h
    funext i
    have hi := congrFun h i
    simp only [Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at hi ⊢
    exact (mul_eq_zero.mp hi).resolve_left (pow_ne_zero _ hf0)
  have hH2 : ∀ (ι : Type) (n M : ℕ) (z w : ι → R), a ^ M • z = f ^ n • w →
      ∃ w' : ι → R, z = f ^ n • w' := by
    intro ι n M z w h
    have : ∀ i, ∃ c : R, z i = f ^ n * c := by
      intro i
      have hi := congrFun h i
      simp only [Pi.smul_apply, smul_eq_mul] at hi
      have hm : a ^ M * z i ∈ Ideal.span {f ^ n} := by
        rw [hi]; exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp (hA1 n M (z i) hm)
      exact ⟨c, by rw [← hc, mul_comm]⟩
    choose c hc using this
    exact ⟨c, funext fun i => by simp only [Pi.smul_apply, smul_eq_mul]; exact hc i⟩
  have hH3 : ∀ (ι : Type) (n N : ℕ) (z u v : ι → R), b ^ N • z = f ^ n • u + a ^ N • v →
      ∃ u' v' : ι → R, z = f ^ n • u' + a ^ N • v' := by
    intro ι n N z u v h
    have : ∀ i, ∃ c d : R, z i = f ^ n * c + a ^ N * d := by
      intro i
      have hi := congrFun h i
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul] at hi
      have hm : b ^ N * z i ∈ Ideal.span {f ^ n, a ^ N} := by
        rw [hi]; exact Ideal.mem_span_pair.mpr ⟨u i, v i, by ring⟩
      obtain ⟨c, d, hcd⟩ := Ideal.mem_span_pair.mp (hA2 n N N (z i) hm)
      exact ⟨c, d, by rw [← hcd]; ring⟩
    choose c d hcd using this
    exact ⟨c, d, funext fun i => by
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]; exact hcd i⟩

  have hk : ∃ k : ℕ, ∀ (p : Fin m' → R) (M : ℕ), f ^ M • p ∈ LinearMap.range β →
      f ^ k • p ∈ LinearMap.range β := by
    let T : ℕ →o Submodule R (Fin m' → R) :=
      ⟨fun M => (LinearMap.range β).comap (f ^ M • LinearMap.id), by
        intro M M' hMM' p hp
        simp only [Submodule.mem_comap, LinearMap.smul_apply, LinearMap.id_apply] at hp ⊢
        obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hMM'
        rw [pow_add, mul_comm, mul_smul]
        exact Submodule.smul_mem _ _ hp⟩
    obtain ⟨k, hk⟩ := (monotone_stabilizes_iff_noetherian.mpr inferInstance) T
    refine ⟨k, fun p M hp => ?_⟩
    have h1 : p ∈ T (max M k) := by
      show p ∈ (LinearMap.range β).comap (f ^ (max M k) • LinearMap.id)
      simp only [Submodule.mem_comap, LinearMap.smul_apply, LinearMap.id_apply]
      obtain ⟨d, hd⟩ := Nat.exists_eq_add_of_le (le_max_left M k)
      rw [hd, pow_add, mul_comm, mul_smul]
      exact Submodule.smul_mem _ _ hp
    rw [← hk (max M k) (le_max_right _ _)] at h1
    have h2 : p ∈ (LinearMap.range β).comap (f ^ k • LinearMap.id) := h1
    simpa only [Submodule.mem_comap, LinearMap.smul_apply, LinearMap.id_apply] using h2
  obtain ⟨k, hk⟩ := hk

  haveI := hC0
  obtain ⟨D, _, _, π, r, hπs, hπk, hfn, ⟨e⟩⟩ :=
    wc_pls_lift_free R f hfm (k + 1) (by omega)
      (integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E))

  have hsm : ∀ (g p : R), g • (Ideal.Quotient.mk (Ideal.span {f ^ (k + 1)}) p) =
      Ideal.Quotient.mk (Ideal.span {f ^ (k + 1)}) (g * p) := by
    intro g p
    rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, map_mul]
  have hreg : ∀ g : R, (∀ z : R, g * z ∈ Ideal.span {f ^ (k + 1)} → z ∈ Ideal.span {f ^ (k + 1)}) →
      ∀ x : D, g • x = 0 → x = 0 := by
    intro g hg x hx
    apply e.injective
    rw [map_zero]
    funext i
    have hi := congrFun (show e (g • x) = 0 by rw [hx, map_zero]) i
    rw [map_smul, Pi.smul_apply, Pi.zero_apply] at hi
    obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (e x i)
    rw [← hp, hsm, Ideal.Quotient.eq_zero_iff_mem] at hi
    rw [Pi.zero_apply, ← hp, Ideal.Quotient.eq_zero_iff_mem]
    exact hg p hi
  have hDa : ∀ x : D, a • x = 0 → x = 0 :=
    hreg a (fun z hz => hA1 (k + 1) 1 z (by rw [pow_one]; exact hz))
  have hDb : ∀ x : D, b • x = 0 → x = 0 := hreg b (hA3 (k + 1))
  have hDaN : ∀ (N : ℕ) (x : D), a ^ N • x = 0 → x = 0 := by
    intro N
    induction N with
    | zero => intro x hx; simpa using hx
    | succ N ih =>
      intro x hx
      rw [pow_succ', mul_smul] at hx
      exact ih x (hDa _ hx)
  have hDab : ∀ (N j : ℕ) (z w : D), b ^ j • z = a ^ N • w → ∃ w' : D, z = a ^ N • w' := by
    intro N j z w h
    have : ∀ i, ∃ q : R, e z i = a ^ N • Ideal.Quotient.mk (Ideal.span {f ^ (k + 1)}) q := by
      intro i
      have hi := congrFun (congrArg e h) i
      rw [map_smul, map_smul, Pi.smul_apply, Pi.smul_apply] at hi
      obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (e z i)
      obtain ⟨q, hq⟩ := Ideal.Quotient.mk_surjective (e w i)
      rw [← hp, ← hq, hsm, hsm, Ideal.Quotient.eq] at hi
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hi
      have hm : b ^ j * p ∈ Ideal.span {f ^ (k + 1), a ^ N} :=
        Ideal.mem_span_pair.mpr ⟨c, q, by rw [hc]; ring⟩
      obtain ⟨x1, y1, hxy⟩ := Ideal.mem_span_pair.mp (hA2 (k + 1) N j p hm)
      refine ⟨y1, ?_⟩
      rw [← hp, hsm, Ideal.Quotient.eq, ← hxy]
      exact Ideal.mem_span_singleton'.mpr ⟨x1, by ring⟩
    choose q hq using this
    refine ⟨e.symm (fun i => Ideal.Quotient.mk _ (q i)), ?_⟩
    apply e.injective
    rw [map_smul, LinearEquiv.apply_symm_apply]
    funext i
    rw [Pi.smul_apply]
    exact hq i
  have hDf : ∀ z : D, f • z = 0 → ∃ z' : D, z = f ^ k • z' := by
    intro z h
    have : ∀ i, ∃ q : R, e z i = f ^ k • Ideal.Quotient.mk (Ideal.span {f ^ (k + 1)}) q := by
      intro i
      have hi := congrFun (show e (f • z) = 0 by rw [h, map_zero]) i
      rw [map_smul, Pi.smul_apply, Pi.zero_apply] at hi
      obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (e z i)
      rw [← hp, hsm, Ideal.Quotient.eq_zero_iff_mem] at hi
      obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hi
      refine ⟨c, ?_⟩
      rw [← hp, hsm]
      exact congrArg (Ideal.Quotient.mk _) (mul_left_cancel₀ hf0 (by rw [← hc]; ring))
    choose q hq using this
    refine ⟨e.symm (fun i => Ideal.Quotient.mk _ (q i)), ?_⟩
    apply e.injective
    rw [map_smul, LinearEquiv.apply_symm_apply]
    funext i
    rw [Pi.smul_apply]
    exact hq i

  obtain ⟨ψ, hP0, hSa, hSb, hIa⟩ := wc_pls_comparison_map R s hs E hET f hfm hfm2 hsf hC0
    (k + 1) (by omega) D π r hπs hπk hfn ⟨e⟩ a b ha hb ha0 hDa hDb hDab

  have hchase : ∀ x : D, ∃ c : integralClosure R E, ψ c = f ^ k • x := by
    intro x
    obtain ⟨N1, c1, hc1⟩ := hSa x
    obtain ⟨N2, c2, hc2⟩ := hSb x
    have hc1' : a ^ (N1 + N2) • x = ψ (a ^ N2 • c1) := by
      rw [map_smul, ← hc1, smul_smul, ← pow_add, add_comm]
    have hc2' : b ^ (N1 + N2) • x = ψ (b ^ N1 • c2) := by
      rw [map_smul, ← hc2, smul_smul, ← pow_add]
    have hw : ψ (b ^ (N1 + N2) • (a ^ N2 • c1) - a ^ (N1 + N2) • (b ^ N1 • c2)) = 0 := by
      rw [map_sub, map_smul ψ (b ^ (N1 + N2)) (a ^ N2 • c1), map_smul ψ (a ^ (N1 + N2)) (b ^ N1 • c2),
        ← hc1', ← hc2', smul_smul, smul_smul, mul_comm, sub_self]
    obtain ⟨M, w', hw'⟩ := hIa _ hw
    have h1 : a ^ M • α (b ^ (N1 + N2) • (a ^ N2 • c1) - a ^ (N1 + N2) • (b ^ N1 • c2)) =
        f ^ (k + 1) • α w' := by
      rw [← map_smul, ← map_smul, hw']
    obtain ⟨g0, hg0⟩ := hH2 _ (k + 1) M _ _ h1
    have h2 : b ^ (N1 + N2) • α (a ^ N2 • c1) = f ^ (k + 1) • g0 + a ^ (N1 + N2) • α (b ^ N1 • c2) := by
      rw [← hg0, map_sub, map_smul α (b ^ (N1 + N2)) (a ^ N2 • c1),
        map_smul α (a ^ (N1 + N2)) (b ^ N1 • c2)]; abel
    obtain ⟨h1v, t, ht⟩ := hH3 _ (k + 1) (N1 + N2) _ _ _ h2
    have hβα : β (α (a ^ N2 • c1)) = 0 := by
      have : α (a ^ N2 • c1) ∈ LinearMap.ker β := by rw [← hrange]; exact ⟨_, rfl⟩
      exact this
    have h3' : a ^ (N1 + N2) • β t = f ^ (k + 1) • (- β h1v) := by
      rw [ht, map_add, map_smul, map_smul] at hβα
      rw [smul_neg]
      exact eq_neg_of_add_eq_zero_right hβα
    obtain ⟨p, hp⟩ := hH2 _ (k + 1) (N1 + N2) _ _ h3'
    obtain ⟨u, hu⟩ := hk p (k + 1) ⟨t, hp⟩
    have h5 : f ^ k • t - f ^ (k + 1) • u ∈ LinearMap.ker β := by
      rw [LinearMap.mem_ker, map_sub, map_smul, map_smul, hp, hu, smul_smul, smul_smul, mul_comm,
        sub_self]
    rw [← hrange] at h5
    obtain ⟨c', hc'⟩ := h5
    have h6 : α (f ^ k • (a ^ N2 • c1) - a ^ (N1 + N2) • c') =
        f ^ (k + 1) • (f ^ k • h1v + a ^ (N1 + N2) • u) := by
      rw [map_sub, map_smul α (f ^ k) (a ^ N2 • c1), map_smul α (a ^ (N1 + N2)) c', hc', ht]
      module
    have h7 : f ^ (k + 1) • (f ^ k • h1v + a ^ (N1 + N2) • u) ∈ LinearMap.ker β := by
      rw [← h6, ← hrange]; exact ⟨_, rfl⟩
    have h8 : f ^ k • h1v + a ^ (N1 + N2) • u ∈ LinearMap.ker β := by
      rw [LinearMap.mem_ker, map_smul] at h7
      rw [LinearMap.mem_ker]
      exact hH1 _ (k + 1) _ h7
    rw [← hrange] at h8
    obtain ⟨c'', hc''⟩ := h8
    have h9 : f ^ k • (a ^ N2 • c1) - a ^ (N1 + N2) • c' = f ^ (k + 1) • c'' :=
      hαinj (by rw [h6, map_smul, hc''])
    have h10 := congrArg ψ h9
    rw [map_sub, map_smul ψ (f ^ k) (a ^ N2 • c1), map_smul ψ (a ^ (N1 + N2)) c',
      map_smul ψ (f ^ (k + 1)) c'', hfn, ← hc1'] at h10
    refine ⟨c', ?_⟩
    have h11 : a ^ (N1 + N2) • (f ^ k • x - ψ c') = 0 := by
      rw [smul_sub, smul_comm (a ^ (N1 + N2)) (f ^ k) x]
      exact h10
    exact (sub_eq_zero.mp (hDaN _ _ h11)).symm

  have hfC0 : ∀ z : integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E),
      f • z = 0 := by
    intro z
    rw [← algebraMap_smul (R ⧸ Ideal.span {f}) f z, Ideal.Quotient.algebraMap_eq,
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self f), zero_smul]
  have hdesc : ∀ i : ℕ, i ≤ k → ∀ x : D, ∃ c : integralClosure R E, ψ c = f ^ (k - i) • x := by
    intro i
    induction i with
    | zero => intro _ x; simpa using hchase x
    | succ i ih =>
      intro hi x
      obtain ⟨c, hc⟩ := ih (by omega) x
      have hj : k - i = (k - (i + 1)) + 1 := by omega
      rw [hj, pow_succ', mul_smul] at hc
      have hπ0 : π (ψ c) = 0 := by rw [hc, map_smul, hfC0]
      have htm : TensorProduct.tmul R (1 : R ⧸ Ideal.span {f}) (c : E) = 0 := by
        rw [← hP0 c, hπ0]; rfl
      obtain ⟨c', hc'⟩ := wc_pps_hartogs_kernel R s hs E f hsf c htm
      have hcc' : c = f • c' := Subtype.ext (by rw [hc']; rfl)
      have hz : f • (f ^ (k - (i + 1)) • x - ψ c') = 0 := by
        rw [smul_sub, ← map_smul, ← hcc', hc, sub_self]
      obtain ⟨z', hz'⟩ := hDf _ hz
      obtain ⟨c''', hc'''⟩ := hchase z'
      refine ⟨c' + c''', ?_⟩
      rw [map_add, hc''', ← hz']
      abel

  obtain ⟨x, hx⟩ := hπs y
  obtain ⟨c, hc⟩ := hdesc k le_rfl x
  refine ⟨c, ?_⟩
  rw [← hP0 c, hc, Nat.sub_self, pow_zero, one_smul, hx]

theorem wc_pps_free_of_hyperplane : ∀ (R : Type u) [CommRing R] [IsRegularLocalRing R] [IsDomain R] (s : R), s ≠ 0 → ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra (Localization.Away s) E] [IsScalarTower R (Localization.Away s) E] [Algebra.Etale (Localization.Away s) E] [Module.Finite (Localization.Away s) E] (f : R), f ∈ IsLocalRing.maximalIdeal R → f ∉ IsLocalRing.maximalIdeal R ^ 2 → ∀ [(Ideal.span {f}).IsPrime], Algebra.Etale (R ⧸ Ideal.span {f}) (integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E)) → (∀ (y : integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E)), ∃ c : integralClosure R E, TensorProduct.tmul R (1 : R ⧸ Ideal.span {f}) (c : E) = (y : TensorProduct R (R ⧸ Ideal.span {f}) E)) → (∀ (c : integralClosure R E), TensorProduct.tmul R (1 : R ⧸ Ideal.span {f}) (c : E) = 0 → ∃ c' : integralClosure R E, (c : E) = f • (c' : E)) → Module.Free R (integralClosure R E) ∧ Module.Finite R (integralClosure R E) :=
by
  intro R _ _ _ s hs E _ _ _ _ _ _ f hfm hfm2 _ hC0 hsurj hker
  classical

  obtain ⟨-, hufd⟩ := wc_fco_regular_local_ufd R
  haveI : UniqueFactorizationMonoid R := hufd
  have hfin : Module.Finite R (integralClosure R E) :=
    wc_fnf_integralClosure_finite_of_etale_localization R (Localization.Away s)
      (Submonoid.powers s) E
      (fun A' _ _ _ _ _ => wc_fnf_integralClosure_finite_of_etale_field R (FractionRing R) A')
  refine ⟨?_, hfin⟩

  have hf0 : f ≠ 0 := by
    rintro rfl
    exact hfm2 (Submodule.zero_mem _)

  have hreg : IsSMulRegular (integralClosure R E) f := by
    haveI : Module.Flat (Localization.Away s) E := Algebra.Smooth.flat _ _
    haveI : Module.Flat R E := Module.Flat.trans R (Localization.Away s) E
    have hE : IsSMulRegular E f :=
      Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hf0)
    intro x y hxy
    apply Subtype.ext
    apply hE
    have h := congrArg Subtype.val hxy
    exact h

  have basis_lift : ∀ (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M],
      IsSMulRegular M f → ∀ (n : ℕ) (v : Fin n → M),
      (∀ x : M, ∃ (a : Fin n → R) (y : M), x = ∑ i, a i • v i + f • y) →
      (∀ a : Fin n → R, (∃ y : M, ∑ i, a i • v i = f • y) → ∀ i, f ∣ a i) →
      Module.Free R M := by
    intro M _ _ _ hregM n v hi hii
    have hItop : Ideal.span {f} ≠ ⊤ := by
      intro h
      rw [Ideal.span_singleton_eq_top] at h
      exact (IsLocalRing.mem_maximalIdeal f).mp hfm h
    have hsp : ⊤ ≤ Submodule.span R (Set.range v) := by
      apply Submodule.le_of_le_smul_of_le_jacobson_bot (I := Ideal.span {f}) Module.Finite.fg_top
      · exact le_trans ((Ideal.span_singleton_le_iff_mem _).mpr hfm)
          (IsLocalRing.maximalIdeal_le_jacobson ⊥)
      · intro x _
        obtain ⟨a, y, rfl⟩ := hi x
        apply Submodule.add_mem_sup
        · exact Submodule.sum_mem _
            (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))
        · exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self f) Submodule.mem_top
    have hpow : ∀ k : ℕ, ∀ a : Fin n → R, ∑ i, a i • v i = 0 →
        ∀ i, a i ∈ Ideal.span {f} ^ k := by
      intro k
      induction k with
      | zero => intro a _ i; simp
      | succ k ih =>
        intro a ha i
        have hdiv := hii a ⟨0, by rw [ha, smul_zero]⟩
        choose a' ha' using hdiv
        have h1 : f • ∑ j, a' j • v j = f • (0 : M) := by
          rw [smul_zero, Finset.smul_sum, ← ha]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [ha' j, mul_smul]
        have h2 : ∑ j, a' j • v j = 0 := hregM h1
        rw [ha' i, pow_succ']
        exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self f) (ih a' h2 i)
    have hli : LinearIndependent R v := by
      rw [Fintype.linearIndependent_iff]
      intro a ha i
      have hmem : a i ∈ ⨅ k : ℕ, Ideal.span {f} ^ k :=
        Ideal.mem_iInf.mpr (fun k => hpow k a ha i)
      rw [Ideal.iInf_pow_eq_bot_of_isLocalRing _ hItop] at hmem
      exact (Submodule.mem_bot R).mp hmem
    exact Module.Free.of_basis (Module.Basis.mk hli hsp)

  have s2 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (A : Type u) [CommRing A] [Algebra B A]
      [Algebra.Etale B A] [Algebra.IsIntegral B A], Module.Free B A ∧ Module.Finite B A := by
    intro B _ _ A _ _ _ _
    haveI : Module.Finite B A := Algebra.IsIntegral.finite
    haveI : Module.Flat B A := Algebra.Smooth.flat _ _
    exact ⟨Module.free_of_flat_of_isLocalRing, inferInstance⟩
  haveI : IsLocalRing (R ⧸ Ideal.span {f}) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  haveI := hC0
  obtain ⟨hC0free, hC0fin⟩ := s2 (R ⧸ Ideal.span {f})
    (integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E))
  set b := Module.finBasis (R ⧸ Ideal.span {f})
      (integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E)) with hb

  let φ : integralClosure R E →ₗ[R] TensorProduct R (R ⧸ Ideal.span {f}) E :=
    (TensorProduct.mk R (R ⧸ Ideal.span {f}) E 1) ∘ₗ (integralClosure R E).val.toLinearMap
  have hφC0 : ∀ x : integralClosure R E, φ x ∈
      integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E) := by
    intro x
    have hx : IsIntegral R (x : E) := x.2
    have h1 : IsIntegral R (φ x) := by
      have := hx.map (Algebra.TensorProduct.includeRight :
        E →ₐ[R] TensorProduct R (R ⧸ Ideal.span {f}) E)
      rw [Algebra.TensorProduct.includeRight_apply] at this
      exact this
    exact h1.tower_top
  have hsm : ∀ (a : R) (z : TensorProduct R (R ⧸ Ideal.span {f}) E),
      (Ideal.Quotient.mk (Ideal.span {f}) a) • z = a • z := by
    intro a z
    rw [← Ideal.Quotient.algebraMap_eq, algebraMap_smul]
  have hfk : ∀ z : TensorProduct R (R ⧸ Ideal.span {f}) E, f • z = 0 := by
    intro z
    rw [← hsm, Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self f), zero_smul]
  choose lift hlift using
    (Ideal.Quotient.mk_surjective : Function.Surjective (Ideal.Quotient.mk (Ideal.span {f})))
  choose c hc using fun i => hsurj (b i)
  have hcφ : ∀ i, φ (c i) = ((b i : integralClosure (R ⧸ Ideal.span {f})
      (TensorProduct R (R ⧸ Ideal.span {f}) E)) : TensorProduct R (R ⧸ Ideal.span {f}) E) :=
    fun i => hc i

  have hsumφ : ∀ a : Fin (Module.finrank (R ⧸ Ideal.span {f})
      (integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E))) → R,
      φ (∑ i, a i • c i) = ((∑ i, Ideal.Quotient.mk (Ideal.span {f}) (a i) • b i :
        integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E)) :
        TensorProduct R (R ⧸ Ideal.span {f}) E) := by
    intro a
    rw [map_sum, AddSubmonoidClass.coe_finset_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_smul, hcφ, Subalgebra.coe_smul, hsm]
  refine basis_lift (integralClosure R E) hreg _ c ?_ ?_
  ·
    intro x
    set y : integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E) :=
      ⟨φ x, hφC0 x⟩ with hy
    refine ⟨fun i => lift (b.repr y i), ?_⟩
    have e1 : φ (x - ∑ i, lift (b.repr y i) • c i) = 0 := by
      rw [map_sub, hsumφ]
      simp_rw [hlift]
      rw [b.sum_repr]
      exact sub_self _
    obtain ⟨c', hc'⟩ := hker (x - ∑ i, lift (b.repr y i) • c i) e1
    refine ⟨c', ?_⟩
    apply eq_add_of_sub_eq'
    exact Subtype.ext hc'
  ·
    intro a ⟨y, hy⟩ i
    have e1 := congrArg φ hy
    rw [hsumφ, map_smul, hfk] at e1
    have e2 : (∑ i, Ideal.Quotient.mk (Ideal.span {f}) (a i) • b i :
        integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E)) = 0 :=
      Subtype.ext e1
    have e3' : Ideal.Quotient.mk (Ideal.span {f}) (a i) = 0 := by
      have key := b.repr_sum_self (fun j => Ideal.Quotient.mk (Ideal.span {f}) (a j))
      rw [e2, LinearEquiv.map_zero] at key
      have := congrFun key i
      rw [Finsupp.coe_zero, Pi.zero_apply] at this
      exact this.symm
    exact Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp e3')

theorem wc_ppi_purity_step : ∀ (k : ℕ), 3 ≤ k → (∀ (A' : Type u) [CommRing A'] [IsRegularLocalRing A'] [IsDomain A'] (s' : A'), s' ≠ 0 → ∀ (E' : Type u) [CommRing E'] [Algebra A' E'] [Algebra (Localization.Away s') E'] [IsScalarTower A' (Localization.Away s') E'] [Algebra.Etale (Localization.Away s') E'] [Module.Finite (Localization.Away s') E'] (p' : Ideal A') [p'.IsPrime], 2 ≤ p'.height → p'.height < (k : ℕ∞) → (∀ (q : Ideal A') [q.IsPrime], q < p' → Algebra.Etale (Localization.AtPrime q) (TensorProduct A' (Localization.AtPrime q) (integralClosure A' E'))) → Algebra.Etale (Localization.AtPrime p') (TensorProduct A' (Localization.AtPrime p') (integralClosure A' E'))) → ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A] [IsDomain A] (s : A), s ≠ 0 → ∀ (E : Type u) [CommRing E] [Algebra A E] [Algebra (Localization.Away s) E] [IsScalarTower A (Localization.Away s) E] [Algebra.Etale (Localization.Away s) E] [Module.Finite (Localization.Away s) E] (p : Ideal A) [p.IsPrime], p.height = (k : ℕ∞) → (∀ (q : Ideal A) [q.IsPrime], q < p → Algebra.Etale (Localization.AtPrime q) (TensorProduct A (Localization.AtPrime q) (integralClosure A E))) → Algebra.Etale (Localization.AtPrime p) (TensorProduct A (Localization.AtPrime p) (integralClosure A E)) :=
by
  intro k hk3 hpre
  apply wc_pps_localize_to_maximal k
  intro R _ _ _ s hs E _ _ _ _ _ _ hk hET
  have h3 : (3 : ℕ∞) ≤ (IsLocalRing.maximalIdeal R).height := by
    rw [hk]; exact_mod_cast hk3
  have h2 : (2 : ℕ∞) ≤ (IsLocalRing.maximalIdeal R).height :=
    le_trans (by norm_num) h3
  obtain ⟨f, hfm, hfm2, hfp, hsf, hreg, hht⟩ := wc_pps_good_hyperplane R s hs h2
  haveI := hfp
  haveI := hreg
  have hs' : algebraMap R (R ⧸ Ideal.span {f}) s ≠ 0 := by
    rw [Ideal.Quotient.algebraMap_eq, Ne, Ideal.Quotient.eq_zero_iff_mem]
    exact hsf
  obtain ⟨algL, towerL, hetL, hfinL⟩ := wc_pub_cover_baseChange R (R ⧸ Ideal.span {f}) E s
  letI := algL
  haveI := towerL
  haveI := hetL
  haveI := hfinL
  have hne : (IsLocalRing.maximalIdeal (R ⧸ Ideal.span {f})).height ≠ ⊤ :=
    Ideal.height_ne_top (Ideal.IsPrime.ne_top inferInstance)
  obtain ⟨j, hj⟩ := ENat.ne_top_iff_exists.mp hne
  rw [← hj, hk] at hht
  have hjk : j + 1 = k := by exact_mod_cast hht
  have hp2 : 2 ≤ (IsLocalRing.maximalIdeal (R ⧸ Ideal.span {f})).height := by
    rw [← hj]; exact_mod_cast (by omega : 2 ≤ j)
  have hplt : (IsLocalRing.maximalIdeal (R ⧸ Ideal.span {f})).height < (k : ℕ∞) := by
    rw [← hj]; exact_mod_cast (by omega : j < k)
  haveI hm := hpre (R ⧸ Ideal.span {f}) (algebraMap R (R ⧸ Ideal.span {f}) s) hs'
    (TensorProduct R (R ⧸ Ideal.span {f}) E) (IsLocalRing.maximalIdeal (R ⧸ Ideal.span {f}))
    hp2 hplt (wc_pps_cut_punctured_etale R s hs E hET f hfm hfm2 hsf)
  have key : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (C : Type u) [CommRing C] [Algebra B C],
      Algebra.Etale (Localization.AtPrime (IsLocalRing.maximalIdeal B))
        (TensorProduct B (Localization.AtPrime (IsLocalRing.maximalIdeal B)) C) →
      Algebra.Etale B C := by
    intro B _ _ C _ _ hBC
    let e : B ≃ₐ[B] Localization.AtPrime (IsLocalRing.maximalIdeal B) :=
      IsLocalization.atUnits B (IsLocalRing.maximalIdeal B).primeCompl (fun x hx => by
        rw [IsUnit.mem_submonoid_iff]
        by_contra h
        exact hx ((IsLocalRing.mem_maximalIdeal x).mpr h))
    haveI : Algebra.Etale B (Localization.AtPrime (IsLocalRing.maximalIdeal B)) :=
      Algebra.Etale.of_equiv e
    haveI := hBC
    haveI : Algebra.Etale B (TensorProduct B (Localization.AtPrime (IsLocalRing.maximalIdeal B)) C) :=
      Algebra.Etale.comp B (Localization.AtPrime (IsLocalRing.maximalIdeal B)) _
    let e2 : TensorProduct B (Localization.AtPrime (IsLocalRing.maximalIdeal B)) C ≃ₐ[B] C :=
      (Algebra.TensorProduct.congr e.symm AlgEquiv.refl).trans (Algebra.TensorProduct.lid B _)
    exact Algebra.Etale.of_equiv e2
  have hC0 : Algebra.Etale (R ⧸ Ideal.span {f})
      (integralClosure (R ⧸ Ideal.span {f}) (TensorProduct R (R ⧸ Ideal.span {f}) E)) :=
    key (R ⧸ Ideal.span {f}) _ hm
  have hsurj := wc_pps_lefschetz_surjective R s hs E h3 hET f hfm hfm2 hsf hC0
  have hker := wc_pps_hartogs_kernel R s hs E f hsf
  obtain ⟨hfree, hfin⟩ := wc_pps_free_of_hyperplane R s hs E f hfm hfm2 hC0 hsurj hker
  haveI := hfree
  haveI := hfin
  exact wc_pps_free_punctured_etale R h2 (integralClosure R E) hET

theorem wc_pas_purity_integralClosure : ∀ (A : Type u) [CommRing A] [IsRegularLocalRing A] [IsDomain A] (t s : A) (N : ℕ), 0 < N → s = t ^ N → t ∈ IsLocalRing.maximalIdeal A → t ∉ IsLocalRing.maximalIdeal A ^ 2 → ∀ [(Ideal.span {t}).IsPrime] (E : Type u) [CommRing E] [Algebra A E] [Algebra (Localization.Away s) E] [IsScalarTower A (Localization.Away s) E] [Algebra.Etale (Localization.Away s) E] [Module.Finite (Localization.Away s) E], Algebra.Etale (Localization.AtPrime (Ideal.span {t})) (TensorProduct A (Localization.AtPrime (Ideal.span {t})) (integralClosure A E)) → Algebra.Etale A (integralClosure A E) ∧ Module.Finite A (integralClosure A E) :=
by
  intro A _ _ _ t s N hN hs htm htm2 _ E _ _ _ _ _ _ hT
  classical
  obtain ⟨-, hufd⟩ := wc_fco_regular_local_ufd A
  haveI : UniqueFactorizationMonoid A := hufd
  have ht0 : t ≠ 0 := by
    rintro rfl
    exact htm2 (Ideal.zero_mem _)
  have hs0 : s ≠ 0 := by
    rw [hs]
    exact pow_ne_zero _ ht0

  have hPUR : ∀ k : ℕ, 2 ≤ k → ∀ (A' : Type u) [CommRing A'] [IsRegularLocalRing A'] [IsDomain A'] (s' : A'), s' ≠ 0 → ∀ (E' : Type u) [CommRing E'] [Algebra A' E'] [Algebra (Localization.Away s') E'] [IsScalarTower A' (Localization.Away s') E'] [Algebra.Etale (Localization.Away s') E'] [Module.Finite (Localization.Away s') E'] (p' : Ideal A') [p'.IsPrime], p'.height = (k : ℕ∞) → (∀ (q : Ideal A') [q.IsPrime], q < p' → Algebra.Etale (Localization.AtPrime q) (TensorProduct A' (Localization.AtPrime q) (integralClosure A' E'))) → Algebra.Etale (Localization.AtPrime p') (TensorProduct A' (Localization.AtPrime p') (integralClosure A' E')) := by
    intro k
    induction k using Nat.strong_induction_on with
    | _ k ih =>
      intro hk
      rcases (show k = 2 ∨ 3 ≤ k by omega) with rfl | hk3
      · intro A' _ _ _ s' hs' E' _ _ _ _ _ _ p' _ hp' hq
        exact wc_ppi_purity_dim2 A' s' hs' E' p' (by simpa using hp') hq
      · apply wc_ppi_purity_step k hk3
        intro A' _ _ _ s' hs' E' _ _ _ _ _ _ p' _ h2 hlt hq
        have hne : p'.height ≠ ⊤ := Ideal.height_ne_top (Ideal.IsPrime.ne_top inferInstance)
        obtain ⟨j, hj⟩ := ENat.ne_top_iff_exists.mp hne
        rw [← hj] at h2 hlt
        have h2' : 2 ≤ j := by exact_mod_cast h2
        have hlt' : j < k := by exact_mod_cast hlt
        exact ih j hlt' h2' A' s' hs' E' p' hj.symm hq

  have hET : ∀ n : ℕ, ∀ (p : Ideal A) [p.IsPrime], p.height = (n : ℕ∞) → Algebra.Etale (Localization.AtPrime p) (TensorProduct A (Localization.AtPrime p) (integralClosure A E)) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro p _ hpn
      by_cases hsp : s ∈ p
      · have htp : t ∈ p := (inferInstance : p.IsPrime).mem_of_pow_mem N (hs ▸ hsp)
        have hle : Ideal.span {t} ≤ p := (Ideal.span_singleton_le_iff_mem p).mpr htp
        rcases hle.lt_or_eq with hlt | heq
        · haveI : (⊥ : Ideal A).IsPrime := inferInstance
          have hbot : (⊥ : Ideal A) < Ideal.span {t} := by
            rw [bot_lt_iff_ne_bot, Ne, Ideal.span_singleton_eq_bot]
            exact ht0
          have h1 : (⊥ : Ideal A).height < (Ideal.span {t}).height :=
            Ideal.height_strict_mono_of_isPrime hbot
          have h2 : (Ideal.span {t}).height < p.height :=
            Ideal.height_strict_mono_of_isPrime hlt
          have hn2 : 2 ≤ n := by
            rw [hpn] at h2
            have hne : (Ideal.span {t}).height ≠ ⊤ :=
              Ideal.height_ne_top (Ideal.IsPrime.ne_top inferInstance)
            obtain ⟨a, ha⟩ := ENat.ne_top_iff_exists.mp hne
            rw [← ha] at h1 h2
            have h0 : (0 : ℕ∞) ≤ (⊥ : Ideal A).height := bot_le
            have ha1 : (0 : ℕ∞) < (a : ℕ∞) := lt_of_le_of_lt h0 h1
            have ha1' : 0 < a := by exact_mod_cast ha1
            have ha2 : a < n := by exact_mod_cast h2
            omega
          refine hPUR n hn2 A s hs0 E p hpn ?_
          intro q _ hqp
          have hq : q.height < p.height := Ideal.height_strict_mono_of_isPrime hqp
          have hne : q.height ≠ ⊤ := Ideal.height_ne_top (Ideal.IsPrime.ne_top inferInstance)
          obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp hne
          rw [← hm, hpn] at hq
          exact ih m (by exact_mod_cast hq) q hm.symm
        · subst heq
          exact hT
      · exact wc_ppi_etale_off_s A s E p hsp

  have hne : (IsLocalRing.maximalIdeal A).height ≠ ⊤ :=
    Ideal.height_ne_top (Ideal.IsPrime.ne_top inferInstance)
  obtain ⟨n, hn⟩ := ENat.ne_top_iff_exists.mp hne
  haveI hm := hET n (IsLocalRing.maximalIdeal A) hn.symm
  let e : A ≃ₐ[A] Localization.AtPrime (IsLocalRing.maximalIdeal A) :=
    IsLocalization.atUnits A (IsLocalRing.maximalIdeal A).primeCompl (fun x hx => by
      rw [IsUnit.mem_submonoid_iff]
      by_contra h
      exact hx ((IsLocalRing.mem_maximalIdeal x).mpr h))
  haveI : Algebra.Etale A (Localization.AtPrime (IsLocalRing.maximalIdeal A)) :=
    Algebra.Etale.of_equiv e
  haveI : Algebra.Etale A (TensorProduct A (Localization.AtPrime (IsLocalRing.maximalIdeal A))
      (integralClosure A E)) :=
    Algebra.Etale.comp A (Localization.AtPrime (IsLocalRing.maximalIdeal A)) _
  let e2 : TensorProduct A (Localization.AtPrime (IsLocalRing.maximalIdeal A))
      (integralClosure A E) ≃ₐ[A] integralClosure A E :=
    (Algebra.TensorProduct.congr e.symm AlgEquiv.refl).trans (Algebra.TensorProduct.lid A _)
  refine ⟨Algebra.Etale.of_equiv e2, ?_⟩

  exact wc_fnf_integralClosure_finite_of_etale_localization A (Localization.Away s)
    (Submonoid.powers s) E
    (fun A' _ _ _ _ _ => wc_fnf_integralClosure_finite_of_etale_field A (FractionRing A) A')

theorem wc_pas_strictHensel_etale_section : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (B : Type u) [CommRing B] [Algebra A B] [Algebra.Etale A B] [Module.Finite A B] [Nontrivial B], Nonempty (B →ₐ[A] A) :=
by
  intro A _ _ _ B _ _ _ _ _
  classical

  have s1 : ∀ (k : Type u) [Field k] [IsSepClosed k], Infinite k := by
    intro k _ _
    by_contra hfin
    rw [not_infinite_iff_finite] at hfin
    haveI := Fintype.ofFinite k
    have hq1 : 1 < Fintype.card k := Fintype.one_lt_card
    have hdeg : (Polynomial.X ^ Fintype.card k - (Polynomial.X + 1) : Polynomial k).degree
        = (Fintype.card k : WithBot ℕ) := by
      have h1 : (Polynomial.X + 1 : Polynomial k).degree
          < (Polynomial.X ^ Fintype.card k : Polynomial k).degree := by
        rw [Polynomial.degree_X_pow, ← Polynomial.C_1, Polynomial.degree_X_add_C]
        exact_mod_cast hq1
      rw [Polynomial.degree_sub_eq_left_of_degree_lt h1, Polynomial.degree_X_pow]
    have hder : Polynomial.derivative
        (Polynomial.X ^ Fintype.card k - (Polynomial.X + 1) : Polynomial k) = -1 := by
      simp [Polynomial.derivative_X_pow]
    have hsep : (Polynomial.X ^ Fintype.card k - (Polynomial.X + 1) : Polynomial k).Separable := by
      rw [Polynomial.separable_def, hder]
      exact isCoprime_one_right.neg_right
    have hdeg0 : (Polynomial.X ^ Fintype.card k - (Polynomial.X + 1) : Polynomial k).degree ≠ 0 := by
      rw [hdeg]
      exact_mod_cast (show Fintype.card k ≠ 0 by omega)
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root _ hdeg0 hsep
    have hx' : x ^ Fintype.card k - (x + 1) = 0 := by simpa using hx
    rw [FiniteField.pow_card] at hx'
    have : (1 : k) = 0 := by linear_combination -hx'
    exact one_ne_zero this

  have s2 : ∀ (k : Type u) [Field k] [IsSepClosed k] (C : Type u) [CommRing C] [Algebra k C]
      [Algebra.Etale k C], ∃ m : ℕ, Nonempty (C ≃ₐ[k] (Fin m → k)) := by
    intro k _ _ C _ _ hC
    obtain ⟨I, hI, Ai, x1, x2, e, h⟩ := (Algebra.Etale.iff_exists_algEquiv_prod k C).mp hC
    haveI := Fintype.ofFinite I
    let ε : ∀ i, Ai i ≃ₐ[k] k := fun i =>
      haveI := (h i).2
      (AlgEquiv.ofBijective (Algebra.ofId k (Ai i))
        ⟨(algebraMap k (Ai i)).injective, IsSepClosed.algebraMap_surjective k (Ai i)⟩).symm
    exact ⟨Fintype.card I, ⟨(e.trans (AlgEquiv.piCongrRight ε)).trans
      (AlgEquiv.piCongrLeft' k (fun _ : I => k) (Fintype.equivFin I))⟩⟩

  have s3 : ∀ (k : Type u) [Field k] (f : Polynomial k), f.Monic → ∀ (n : ℕ), f.natDegree = n →
      ∀ (c : Fin n → k), Function.Injective c → (∀ i, f.eval (c i) = 0) →
      ∀ i, (Polynomial.derivative f).eval (c i) ≠ 0 := by
    intro k _ f hf n hn c hc hroot i hi
    have hf0 : f ≠ 0 := hf.ne_zero
    have hnd : (Finset.univ.val.map c).Nodup := Multiset.Nodup.map hc Finset.univ.nodup
    have hle : Finset.univ.val.map c ≤ f.roots := by
      rw [Multiset.le_iff_subset hnd]
      intro a ha
      obtain ⟨j, -, rfl⟩ := Multiset.mem_map.mp ha
      exact (Polynomial.mem_roots hf0).mpr (hroot j)
    have hcard : (Finset.univ.val.map c).card = n := by simp
    have heq : Finset.univ.val.map c = f.roots :=
      Multiset.eq_of_le_of_card_le hle (by rw [hcard, ← hn]; exact Polynomial.card_roots' f)
    have hmem : c i ∈ Finset.univ.val.map c := Multiset.mem_map.mpr ⟨i, Finset.mem_univ_val _, rfl⟩
    have h1 : Polynomial.rootMultiplicity (c i) f = 1 := by
      rw [← Polynomial.count_roots, ← heq]
      exact Multiset.count_eq_one_of_mem hnd hmem
    have h2 : 1 < Polynomial.rootMultiplicity (c i) f :=
      (Polynomial.one_lt_rootMultiplicity_iff_isRoot hf0).mpr ⟨hroot i, hi⟩
    omega

  have s5 : ∀ (k : Type u) [Field k] (m : ℕ) (c : Fin m → k), Function.Injective c →
      LinearIndependent k (fun j : Fin m => fun i : Fin m => c i ^ (j : ℕ)) := by
    intro k _ m c hc
    have := Matrix.linearIndependent_cols_of_det_ne_zero (Matrix.det_vandermonde_ne_zero_iff.mpr hc)
    convert this using 1
    funext j i
    simp [Matrix.vandermonde_apply, Matrix.col]

  haveI : Module.Flat A B := Algebra.Smooth.flat A B
  haveI : Module.Free A B := Module.free_of_flat_of_isLocalRing
  have hn : 0 < Module.finrank A B := (Module.finrank_pos_iff_of_free A B).mpr inferInstance

  haveI : Algebra.Etale (IsLocalRing.ResidueField A)
      (TensorProduct A (IsLocalRing.ResidueField A) B) := Algebra.Etale.baseChange A B _
  obtain ⟨m, ⟨Φ⟩⟩ := s2 (IsLocalRing.ResidueField A)
    (TensorProduct A (IsLocalRing.ResidueField A) B)
  have hmK : Module.finrank (IsLocalRing.ResidueField A)
      (TensorProduct A (IsLocalRing.ResidueField A) B) = m := by
    rw [LinearEquiv.finrank_eq Φ.toLinearEquiv, Module.finrank_fin_fun]
  have hmn : Module.finrank A B = m := by
    rw [← hmK, Module.finrank_baseChange]
  have hm : 0 < m := hmn ▸ hn

  haveI : Infinite (IsLocalRing.ResidueField A) := s1 _
  let c : Fin m → IsLocalRing.ResidueField A := fun i => Infinite.natEmbedding _ (i : ℕ)
  have hc : Function.Injective c := fun i j h =>
    Fin.val_injective ((Infinite.natEmbedding _).injective h)
  have hsurj : Function.Surjective (algebraMap A (IsLocalRing.ResidueField A)) := by
    rw [IsLocalRing.ResidueField.algebraMap_eq]; exact IsLocalRing.residue_surjective
  obtain ⟨e, he⟩ := TensorProduct.mk_surjective A B (IsLocalRing.ResidueField A) hsurj (Φ.symm c)
  have he' : (1 : IsLocalRing.ResidueField A) ⊗ₜ[A] e = Φ.symm c := he

  have hΦ : ∀ j : ℕ, Φ ((1 : IsLocalRing.ResidueField A) ⊗ₜ[A] (e ^ j)) = fun i => c i ^ j := by
    intro j
    have h1 : (1 : IsLocalRing.ResidueField A) ⊗ₜ[A] (e ^ j) = (Φ.symm c) ^ j := by
      rw [← he', Algebra.TensorProduct.tmul_pow, one_pow]
    rw [h1, map_pow, AlgEquiv.apply_symm_apply]
    funext i
    simp [Pi.pow_apply]
  have hv : LinearIndependent (IsLocalRing.ResidueField A)
      (fun j : Fin m => (1 : IsLocalRing.ResidueField A) ⊗ₜ[A] (e ^ (j : ℕ))) := by
    apply LinearIndependent.of_comp Φ.toLinearMap
    convert s5 _ m c hc using 1
    funext j
    exact hΦ j

  haveI : Nonempty (Fin m) := ⟨⟨0, hm⟩⟩
  have hrankK : Fintype.card (Fin m) = Module.finrank (IsLocalRing.ResidueField A)
      (TensorProduct A (IsLocalRing.ResidueField A) B) := by
    rw [Fintype.card_fin, hmK]
  have hspan : Submodule.span A (Set.range fun j : Fin m => e ^ (j : ℕ)) = ⊤ :=
    IsLocalRing.span_eq_top_of_tmul_eq_basis (fun j : Fin m => e ^ (j : ℕ))
      (basisOfLinearIndependentOfCardEqFinrank hv hrankK)
      (fun j => (congrFun (coe_basisOfLinearIndependentOfCardEqFinrank hv hrankK) j).symm)
  have hliA : LinearIndependent A (fun j : Fin m => e ^ (j : ℕ)) :=
    linearIndependent_of_top_le_span_of_card_eq_finrank hspan.ge (by rw [Fintype.card_fin, hmn])
  let pb : PowerBasis A B := PowerBasis.mk e m (Module.Basis.mk hliA hspan.ge)
    (fun j => Module.Basis.mk_apply hliA hspan.ge j)

  have hmonic : pb.minpolyGen.Monic := pb.minpolyGen_monic
  have hdegf : pb.minpolyGen.natDegree = m := pb.natDegree_minpolyGen
  have haev : Polynomial.aeval e pb.minpolyGen = 0 := pb.aeval_minpolyGen

  let ψ : B →ₐ[A] (Fin m → IsLocalRing.ResidueField A) :=
    ((Φ : TensorProduct A (IsLocalRing.ResidueField A) B →ₐ[IsLocalRing.ResidueField A]
      (Fin m → IsLocalRing.ResidueField A)).restrictScalars A).comp
      Algebra.TensorProduct.includeRight
  have hψ : ψ e = c := by
    show Φ ((1 : IsLocalRing.ResidueField A) ⊗ₜ[A] e) = c
    rw [he', AlgEquiv.apply_symm_apply]
  have hroots : ∀ i, Polynomial.aeval (c i) pb.minpolyGen = 0 := by
    intro i
    have h1 : Polynomial.aeval c pb.minpolyGen = 0 := by
      rw [← hψ, Polynomial.aeval_algHom_apply, haev, map_zero]
    have h2 := Polynomial.aeval_algHom_apply
      (Pi.evalAlgHom A (fun _ : Fin m => IsLocalRing.ResidueField A) i) c pb.minpolyGen
    rw [h1, map_zero] at h2
    exact h2

  have hfbar := s3 (IsLocalRing.ResidueField A)
    (pb.minpolyGen.map (algebraMap A (IsLocalRing.ResidueField A)))
    (hmonic.map _) m (by rw [hmonic.natDegree_map, hdegf]) c hc
    (fun i => by rw [Polynomial.eval_map_algebraMap]; exact hroots i) ⟨0, hm⟩
  rw [Polynomial.derivative_map, Polynomial.eval_map_algebraMap] at hfbar
  have hhens := (HenselianLocalRing.TFAE A).out 1 2
  obtain ⟨a, ha, -⟩ := hhens.mp (inferInstance : HenselianLocalRing A) pb.minpolyGen
    hmonic (c ⟨0, hm⟩) (hroots _) hfbar

  have ha' : Polynomial.eval a pb.minpolyGen = 0 := ha
  refine ⟨pb.lift a ?_⟩
  rw [← pb.minpolyGen_eq, Polynomial.coe_aeval_eq_eval]
  exact ha'

theorem wc_pas_integralClosure_pi : ∀ (R : Type u) [CommRing R] (r : ℕ) (A : Fin r → Type u) [∀ i, CommRing (A i)] [∀ i, Algebra R (A i)], Nonempty (integralClosure R ((i : Fin r) → A i) ≃ₐ[R] ((i : Fin r) → integralClosure R (A i))) :=
by
  intro R _ r A _ _
  classical
  have back : ∀ x : (i : Fin r) → A i, (∀ i, IsIntegral R (x i)) → IsIntegral R x := by
    intro x hx
    choose p hp using fun i => (hx i : ∃ q : Polynomial R, q.Monic ∧
      q.eval₂ (algebraMap R (A i)) (x i) = 0)
    refine ⟨∏ i, p i, Polynomial.monic_prod_of_monic _ _ (fun i _ => (hp i).1), ?_⟩
    rw [← Polynomial.aeval_def]
    funext i
    have h1 : (Polynomial.aeval x (∏ j, p j)) i = Polynomial.aeval (x i) (∏ j, p j) := by
      rw [show x i = Pi.evalAlgHom R A i x from rfl, Polynomial.aeval_algHom_apply]
      rfl
    rw [h1, map_prod, Pi.zero_apply]
    exact Finset.prod_eq_zero (Finset.mem_univ i) (by rw [Polynomial.aeval_def]; exact (hp i).2)
  let Φ : integralClosure R ((i : Fin r) → A i) →ₐ[R] ((i : Fin r) → integralClosure R (A i)) :=
    AlgHom.pi (fun i => AlgHom.codRestrict
      ((Pi.evalAlgHom R A i).comp (integralClosure R ((i : Fin r) → A i)).val)
      (integralClosure R (A i))
      (fun y => (y.2 : IsIntegral R (y : (i : Fin r) → A i)).map (Pi.evalAlgHom R A i)))
  refine ⟨AlgEquiv.ofBijective Φ ⟨?_, ?_⟩⟩
  · intro y z h
    apply Subtype.ext
    funext i
    exact congrArg (fun w => ((w i : integralClosure R (A i)) : A i)) h
  · intro w
    refine ⟨⟨fun i => (w i : A i), back _ (fun i => (w i).2)⟩, ?_⟩
    funext i
    apply Subtype.ext
    rfl

theorem wc_pas_dks_tame_galois_closure : ∀ (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (F : Type u) [CommRing F] [Algebra K F] [Algebra.Etale K F] [Module.Finite K F], (∀ (σ : SeparableClosure K ≃ₐ[K] SeparableClosure K) (χ : F →ₐ[K] SeparableClosure K), ∃ m : ℕ, (σ ^ (ℓ ^ m)).toAlgHom.comp χ = χ) → ∃ L : IntermediateField K (SeparableClosure K), FiniteDimensional K L ∧ IsGalois K L ∧ (∀ g : L ≃ₐ[K] L, ∃ m : ℕ, orderOf g = ℓ ^ m) ∧ ∀ (χ : F →ₐ[K] SeparableClosure K) (x : F), χ x ∈ L :=
by
  intro K _ ℓ _ F _ _ _ _ htame
  classical

  have hfin : Finite (F →ₐ[K] SeparableClosure K) := by
    have h1 := cardinalMk_algHom_le_rank K F (SeparableClosure K)
    have h2 : Cardinal.lift.{u} (Module.rank K F) < Cardinal.aleph0 :=
      Cardinal.lift_lt_aleph0.mpr (Module.rank_lt_aleph0 K F)
    exact Cardinal.mk_lt_aleph0_iff.mp (lt_of_le_of_lt h1 h2)
  obtain ⟨n, b⟩ : ∃ n : ℕ, Nonempty (Module.Basis (Fin n) K F) :=
    ⟨Module.finrank K F, ⟨Module.finBasis K F⟩⟩
  obtain ⟨b⟩ := b
  obtain ⟨S, hSdef⟩ : ∃ S : Set (SeparableClosure K),
      S = Set.range (fun p : (F →ₐ[K] SeparableClosure K) × Fin n => p.1 (b p.2)) := ⟨_, rfl⟩
  have hSfin : S.Finite := by rw [hSdef]; exact Set.finite_range _
  have hSmem : ∀ (χ : F →ₐ[K] SeparableClosure K) (i : Fin n), χ (b i) ∈ S := by
    intro χ i; rw [hSdef]; exact ⟨(χ, i), rfl⟩
  have hSstab : ∀ (σ : SeparableClosure K ≃ₐ[K] SeparableClosure K), ∀ y ∈ S, σ y ∈ S := by
    intro σ y hy
    rw [hSdef] at hy
    obtain ⟨p, rfl⟩ := hy
    exact hSmem ((σ : SeparableClosure K →ₐ[K] SeparableClosure K).comp p.1) p.2
  have : Finite S := hSfin.to_subtype
  have hLfd : FiniteDimensional K (IntermediateField.adjoin K S) :=
    IntermediateField.finiteDimensional_adjoin (fun x _ => Algebra.IsIntegral.isIntegral x)
  have hsep : Algebra.IsSeparable K (IntermediateField.adjoin K S) :=
    Algebra.isSeparable_tower_bot_of_isSeparable K (IntermediateField.adjoin K S) (SeparableClosure K)
  have hnorm : Normal K (IntermediateField.adjoin K S) := by
    rw [IntermediateField.normal_iff_forall_map_le']
    intro σ
    rw [IntermediateField.adjoin_map, IntermediateField.adjoin_le_iff]
    rintro _ ⟨y, hy, rfl⟩
    exact IntermediateField.subset_adjoin K S (hSstab σ y hy)
  have hgal : IsGalois K (IntermediateField.adjoin K S) := IsGalois.mk

  have hunif : ∀ σ : SeparableClosure K ≃ₐ[K] SeparableClosure K,
      ∃ M : ℕ, ∀ y ∈ S, (σ ^ (ℓ ^ M)) y = y := by
    intro σ
    letI := Fintype.ofFinite (F →ₐ[K] SeparableClosure K)
    choose m hm using htame σ
    refine ⟨∑ χ, m χ, ?_⟩
    intro y hy
    rw [hSdef] at hy
    obtain ⟨⟨χ, i⟩, rfl⟩ := hy
    have hle : m χ ≤ ∑ χ, m χ :=
      Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ χ)
    have hfix : ∀ z : F, (σ ^ (ℓ ^ m χ)) (χ z) = χ z := fun z => AlgHom.congr_fun (hm χ) z
    have hiter : ∀ k : ℕ, ((σ ^ (ℓ ^ m χ)) ^ k) (χ (b i)) = χ (b i) := by
      intro k
      induction k with
      | zero => rfl
      | succ k ih => rw [pow_succ, AlgEquiv.mul_apply, hfix, ih]
    have hpow : σ ^ (ℓ ^ (∑ χ, m χ)) = (σ ^ (ℓ ^ m χ)) ^ (ℓ ^ (∑ χ, m χ - m χ)) := by
      rw [← pow_mul, ← pow_add, Nat.add_sub_cancel' hle]
    show (σ ^ (ℓ ^ (∑ χ, m χ))) (χ (b i)) = χ (b i)
    rw [hpow]
    exact hiter _
  refine ⟨IntermediateField.adjoin K S, hLfd, hgal, ?_, ?_⟩
  ·
    intro g
    obtain ⟨σ, hσ⟩ := AlgEquiv.restrictNormalHom_surjective
      (K₁ := IntermediateField.adjoin K S) (SeparableClosure K) g
    obtain ⟨M, hM⟩ := hunif σ
    have hτ : ∀ x : IntermediateField.adjoin K S, (σ ^ (ℓ ^ M)) (x : SeparableClosure K) = x := by
      have h : (((σ ^ (ℓ ^ M) : SeparableClosure K ≃ₐ[K] SeparableClosure K) :
          SeparableClosure K →ₐ[K] SeparableClosure K).comp (IntermediateField.adjoin K S).val) =
          (IntermediateField.adjoin K S).val := by
        apply IntermediateField.adjoin_algHom_ext
        intro x hx
        exact hM x hx
      intro x
      exact AlgHom.congr_fun h x
    have hg1 : g ^ (ℓ ^ M) = 1 := by
      rw [← hσ, ← map_pow]
      apply AlgEquiv.ext
      intro x
      apply Subtype.ext
      rw [AlgEquiv.restrictNormalHom_apply]
      exact hτ x
    obtain ⟨k, -, hk⟩ :=
      (Nat.dvd_prime_pow (Fact.out : ℓ.Prime)).mp (orderOf_dvd_of_pow_eq_one hg1)
    exact ⟨k, hk⟩
  ·
    intro χ x
    rw [← b.sum_repr x, map_sum]
    refine IntermediateField.sum_mem _ (fun i _ => ?_)
    rw [map_smul]
    exact IntermediateField.smul_mem _ (IntermediateField.subset_adjoin K S (hSmem χ i))

theorem wc_pas_dks_galois_in_kummer : ∀ (V : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V] [HenselianLocalRing V] [IsSepClosed (IsLocalRing.ResidueField V)] (ϖ : V), Irreducible ϖ → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : V) → ∀ (K : Type u) [Field K] [Algebra V K] [IsFractionRing V K] (L : IntermediateField K (SeparableClosure K)) [FiniteDimensional K L] [IsGalois K L], (∀ g : L ≃ₐ[K] L, ∃ m : ℕ, orderOf g = ℓ ^ m) → ∃ (k : ℕ) (α : SeparableClosure K), α ^ (ℓ ^ k) = algebraMap K (SeparableClosure K) (algebraMap V K ϖ) ∧ L ≤ IntermediateField.adjoin K {α} :=
by
  intro V _ _ _ _ _ ϖ hϖ ℓ _ hℓ K _ _ _ L _ _ hord
  classical
  have hℓp : Nat.Prime ℓ := Fact.out

  have sroots : ∀ (N : ℕ), IsUnit (N : V) → ∀ u : Vˣ, ∃ v : V, v ^ N = u := by
    intro N hN
    have hN0 : N ≠ 0 := by
      rintro rfl
      simp at hN
    have hNk : ((N : ℕ) : IsLocalRing.ResidueField V) ≠ 0 := by
      rw [← map_natCast (IsLocalRing.residue V)]
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hN
    intro u
    have hru : IsLocalRing.residue V (u : V) ≠ 0 :=
      (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr u.isUnit
    haveI : NeZero ((N : ℕ) : IsLocalRing.ResidueField V) := ⟨hNk⟩
    obtain ⟨z, hz⟩ := IsSepClosed.exists_pow_nat_eq (IsLocalRing.residue V (u : V)) N
    obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective z
    have hz0 : z ≠ 0 := by
      rintro rfl
      rw [zero_pow hN0] at hz
      exact hru hz.symm
    have hua : IsUnit a₀ :=
      (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (by rw [ha₀]; exact hz0)
    have hmon : (Polynomial.X ^ N - Polynomial.C (u : V) : Polynomial V).Monic :=
      Polynomial.monic_X_pow_sub_C _ hN0
    have heval : (Polynomial.X ^ N - Polynomial.C (u : V) : Polynomial V).eval a₀ ∈
        IsLocalRing.maximalIdeal V := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
        map_sub, map_pow, ha₀, hz, sub_self]
    have hder : IsUnit ((Polynomial.derivative
        (Polynomial.X ^ N - Polynomial.C (u : V) : Polynomial V)).eval a₀) := by
      rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
        sub_zero, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_X]
      simpa using hN.mul (hua.pow (N - 1))
    obtain ⟨a, ha, -⟩ := HenselianLocalRing.is_henselian
      (Polynomial.X ^ N - Polynomial.C (u : V)) hmon a₀ heval hder
    refine ⟨a, ?_⟩
    have h := ha.eq_zero
    simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C] at h
    exact sub_eq_zero.mp h

  have sprim : ∀ (m : ℕ), IsUnit ((m : ℕ) : V) → ∃ ω : V, IsPrimitiveRoot ω m := by
    intro m hm
    rcases Nat.eq_zero_or_pos m with h0 | hpos
    · subst h0
      exact ⟨0, IsPrimitiveRoot.zero⟩
    have hm0 : m ≠ 0 := hpos.ne'
    have hk : ((m : ℕ) : IsLocalRing.ResidueField V) ≠ 0 := by
      rw [← map_natCast (IsLocalRing.residue V) m]
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hm
    haveI : NeZero ((m : ℕ) : IsLocalRing.ResidueField V) := ⟨hk⟩
    obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (IsLocalRing.ResidueField V) m
    have hζ0 : ζ ≠ 0 := hζ.ne_zero hm0
    obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective ζ
    have ha₀u : IsUnit a₀ :=
      (IsLocalRing.residue_ne_zero_iff_isUnit a₀).mp (by rw [ha₀]; exact hζ0)
    have hmon : (Polynomial.X ^ m - Polynomial.C (1 : V)).Monic :=
      Polynomial.monic_X_pow_sub_C (1 : V) hm0
    have hev : Polynomial.eval a₀ (Polynomial.X ^ m - Polynomial.C (1 : V)) ∈
        IsLocalRing.maximalIdeal V := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_one, map_sub, map_pow, map_one, ha₀, hζ.pow_eq_one, sub_self,
        Polynomial.eval_C]
    have hder : IsUnit (Polynomial.eval a₀
        (Polynomial.derivative (Polynomial.X ^ m - Polynomial.C (1 : V)))) := by
      simp only [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
        sub_zero, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
      exact hm.mul (ha₀u.pow _)
    obtain ⟨ω, hroot, hω⟩ := HenselianLocalRing.is_henselian _ hmon a₀ hev hder
    have hωm : ω ^ m = 1 := by
      have := hroot.eq_zero
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_C] at this
      exact sub_eq_zero.mp this
    have hπ : IsLocalRing.residue V ω = ζ := by
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, sub_eq_zero] at hω
      rw [hω, ha₀]
    refine ⟨ω, IsPrimitiveRoot.mk_of_lt ω hpos hωm ?_⟩
    intro l hl0 hlm hl
    apply hζ.pow_ne_one_of_pos_of_lt hl0.ne' hlm
    rw [← hπ, ← map_pow, hl, map_one]

  have s6 : ∀ (n : ℕ), IsUnit ((n : ℕ) : V) → ∃ α : SeparableClosure K,
      α ^ n = algebraMap K (SeparableClosure K) (algebraMap V K ϖ) := by
    intro n hn
    have hn0 : ((n : ℕ) : SeparableClosure K) ≠ 0 := by
      have := hn.map ((algebraMap K (SeparableClosure K)).comp (algebraMap V K))
      rw [map_natCast] at this
      exact this.ne_zero
    haveI : NeZero ((n : ℕ) : SeparableClosure K) := ⟨hn0⟩
    exact IsSepClosed.exists_pow_nat_eq _ n

  have s5 : ∀ (n : ℕ), 0 < n → ∀ (c : K) (α : SeparableClosure K),
      α ^ n = algebraMap K (SeparableClosure K) c →
      FiniteDimensional K (IntermediateField.adjoin K {α}) ∧
        Module.finrank K (IntermediateField.adjoin K {α}) ≤ n := by
    intro n hn c α h
    have hmon : (Polynomial.X ^ n - Polynomial.C c).Monic := Polynomial.monic_X_pow_sub_C c hn.ne'
    have hev : Polynomial.aeval α (Polynomial.X ^ n - Polynomial.C c) = 0 := by
      simp [h]
    have hint : IsIntegral K α := ⟨_, hmon, by rwa [Polynomial.aeval_def] at hev⟩
    refine ⟨IntermediateField.adjoin.finiteDimensional hint, ?_⟩
    rw [IntermediateField.adjoin.finrank hint]
    calc (minpoly K α).natDegree ≤ (Polynomial.X ^ n - Polynomial.C c).natDegree :=
          Polynomial.natDegree_le_of_dvd (minpoly.dvd K α hev) hmon.ne_zero
      _ = n := Polynomial.natDegree_X_pow_sub_C

  have s2 : ∀ (n : ℕ), 0 < n → (∀ u : Vˣ, ∃ v : V, v ^ n = u) → ∀ (ω : V),
      IsPrimitiveRoot ω n → ∀ (α β : SeparableClosure K),
      α ^ n = algebraMap K (SeparableClosure K) (algebraMap V K ϖ) → β ≠ 0 →
      β ^ n ∈ Set.range (algebraMap K (SeparableClosure K)) →
      β ∈ IntermediateField.adjoin K {α} := by
    intro n hn hroot ω hω α β hα hβ0 hβ
    set ι : V →+* SeparableClosure K := (algebraMap K (SeparableClosure K)).comp (algebraMap V K)
      with hι
    have hιinj : Function.Injective ι :=
      (algebraMap K (SeparableClosure K)).injective.comp (IsFractionRing.injective V K)
    set A := IntermediateField.adjoin K {α} with hA
    have hιA : ∀ x : V, ι x ∈ A := fun x => A.algebraMap_mem (algebraMap V K x)
    have hαA : α ∈ A := IntermediateField.mem_adjoin_simple_self K α
    have hα' : α ^ n = ι ϖ := hα
    have hne : ∀ x : V, x ≠ 0 → ι x ≠ 0 := fun x hx => (map_ne_zero_iff _ hιinj).mpr hx
    obtain ⟨c, hc⟩ := hβ
    obtain ⟨x, y, hy, hxy⟩ := IsFractionRing.div_surjective V c
    have hy0 : y ≠ 0 := nonZeroDivisors.ne_zero hy
    have hβn : β ^ n = ι x / ι y := by
      rw [← hc, ← hxy, map_div₀]
      rfl
    have hx0 : x ≠ 0 := by
      rintro rfl
      rw [map_zero, zero_div] at hβn
      exact hβ0 ((pow_eq_zero_iff hn.ne').mp hβn)
    obtain ⟨s, u₁, hu₁⟩ := IsDiscreteValuationRing.associated_pow_irreducible hx0 hϖ
    obtain ⟨t, u₂, hu₂⟩ := IsDiscreteValuationRing.associated_pow_irreducible hy0 hϖ
    obtain ⟨v, hv⟩ := hroot (u₂ * u₁⁻¹)
    set γ := ι v * α ^ s * (α ^ t)⁻¹ with hγ
    have hγA : γ ∈ A :=
      A.mul_mem (A.mul_mem (hιA v) (pow_mem hαA s)) (A.inv_mem (pow_mem hαA t))
    have e1 : (ι v) ^ n = ι u₂ * ι (↑u₁⁻¹ : V) := by
      rw [← map_pow, hv, Units.val_mul, map_mul]
    have e2 : ι (↑u₁⁻¹ : V) * ι u₁ = 1 := by
      rw [← map_mul, Units.inv_mul, map_one]
    have es : (α ^ s) ^ n = ι x * ι u₁ := by
      rw [← pow_mul, mul_comm, pow_mul, hα', ← map_pow, ← hu₁, map_mul]
    have et : (α ^ t) ^ n = ι y * ι u₂ := by
      rw [← pow_mul, mul_comm, pow_mul, hα', ← map_pow, ← hu₂, map_mul]
    have hu₂0 : ι u₂ ≠ 0 := hne _ u₂.ne_zero
    have hγn : γ ^ n = ι x / ι y := by
      rw [hγ, mul_pow, mul_pow, inv_pow, e1, es, et]
      calc ι u₂ * ι (↑u₁⁻¹ : V) * (ι x * ι u₁) * (ι y * ι u₂)⁻¹
          = (ι (↑u₁⁻¹ : V) * ι u₁) * ι x * (ι u₂ * (ι u₂)⁻¹) * (ι y)⁻¹ := by ring
        _ = ι x / ι y := by rw [e2, mul_inv_cancel₀ hu₂0]; ring
    have hxy0 : ι x / ι y ≠ 0 := div_ne_zero (hne x hx0) (hne y hy0)
    have hγ0 : γ ≠ 0 := by
      intro h0
      rw [h0, zero_pow hn.ne'] at hγn
      exact hxy0 hγn.symm
    have hζ : (β * γ⁻¹) ^ n = 1 := by
      rw [mul_pow, inv_pow, hβn, hγn, mul_inv_cancel₀ hxy0]
    have hω' : IsPrimitiveRoot (ι ω) n := hω.map_of_injective hιinj
    haveI : NeZero n := ⟨hn.ne'⟩
    obtain ⟨i, -, hi⟩ := hω'.eq_pow_of_pow_eq_one hζ
    have hβeq : β = (β * γ⁻¹) * γ := by
      rw [mul_assoc, inv_mul_cancel₀ hγ0, mul_one]
    rw [hβeq, ← hi]
    exact A.mul_mem (pow_mem (hιA ω) i) hγA

  have s3 : ∀ (L : IntermediateField K (SeparableClosure K)) [FiniteDimensional K L]
      [IsGalois K L], IsCyclic (L ≃ₐ[K] L) →
      (primitiveRoots (Module.finrank K L) K).Nonempty →
      ∀ (M : IntermediateField K (SeparableClosure K)),
      (∀ β : SeparableClosure K, β ≠ 0 →
        β ^ (Module.finrank K L) ∈ Set.range (algebraMap K (SeparableClosure K)) → β ∈ M) →
      L ≤ M := by
    intro L _ _ hcyc hprim M hM
    have hex : ∃ b : L, b ^ Module.finrank K L ∈ Set.range (algebraMap K L) ∧
        IntermediateField.adjoin K {b} = ⊤ :=
      ((isCyclic_tfae K L hprim).out 1 3).mp
        (⟨inferInstance, hcyc⟩ : IsGalois K L ∧ IsCyclic (L ≃ₐ[K] L))
    obtain ⟨b, ⟨c, hc⟩, hb⟩ := hex
    have hL : L = IntermediateField.adjoin K {(b : SeparableClosure K)} := by
      rw [← IntermediateField.lift_adjoin_simple, hb, IntermediateField.lift_top]
    rw [hL, IntermediateField.adjoin_simple_le_iff]
    by_cases h0 : (b : SeparableClosure K) = 0
    · rw [h0]; exact M.zero_mem
    · apply hM _ h0
      refine ⟨c, ?_⟩
      have := congrArg (fun z : L => (z : SeparableClosure K)) hc
      simpa using this

  have s1 : (∀ H₁ H₂ : Subgroup (L ≃ₐ[K] L), H₁.index = ℓ → H₂.index = ℓ → H₁ = H₂) →
      IsPGroup ℓ (L ≃ₐ[K] L) → IsCyclic (L ≃ₐ[K] L) := by
    intro huniq hG
    obtain ⟨a, ha⟩ := IsPGroup.iff_card.mp hG
    rcases Nat.eq_zero_or_pos a with h0 | hapos
    · subst h0
      rw [pow_zero] at ha
      haveI : Subsingleton (L ≃ₐ[K] L) := (Nat.card_eq_one_iff_unique.mp ha).1
      exact isCyclic_of_subsingleton
    · by_contra hnc
      have hdvd : ℓ ^ (a - 1) ∣ Nat.card (L ≃ₐ[K] L) := by
        rw [ha]; exact pow_dvd_pow ℓ (Nat.sub_le a 1)
      obtain ⟨K₀, hK₀⟩ := Sylow.exists_subgroup_card_pow_prime ℓ hdvd
      have hidx : ∀ H : Subgroup (L ≃ₐ[K] L), Nat.card H = ℓ ^ (a - 1) → H.index = ℓ := by
        intro H hH
        have h1 := H.card_mul_index
        rw [hH, ha] at h1
        have hp0 : 0 < ℓ ^ (a - 1) := pow_pos hℓp.pos _
        have h2 : ℓ ^ (a - 1) * H.index = ℓ ^ (a - 1) * ℓ := by
          rw [h1, ← pow_succ, Nat.sub_add_cancel hapos]
        exact Nat.eq_of_mul_eq_mul_left hp0 h2
      have hall : ∀ g : L ≃ₐ[K] L, g ∈ K₀ := by
        intro g
        have h1 := orderOf_dvd_natCard g
        rw [ha] at h1
        obtain ⟨j, hj, hjg⟩ := (Nat.dvd_prime_pow hℓp).mp h1
        have hja : j ≠ a := by
          rintro rfl
          exact hnc (isCyclic_of_orderOf_eq_card g (by rw [hjg, ha]))
        obtain ⟨K', hK', hle⟩ := Sylow.exists_subgroup_card_pow_prime_le ℓ hdvd
          (Subgroup.zpowers g) (by rw [Nat.card_zpowers, hjg]) (by omega)
        have h3 := huniq K' K₀ (hidx K' hK') (hidx K₀ hK₀)
        rw [← h3]
        exact hle (Subgroup.mem_zpowers g)
      have htop : K₀ = ⊤ := eq_top_iff.mpr (fun g _ => hall g)
      have h4 := hidx K₀ hK₀
      rw [htop, Subgroup.index_top] at h4
      exact hℓp.one_lt.ne h4

  have s4 : ∀ (A : IntermediateField K (SeparableClosure K)) [FiniteDimensional K A],
      Module.finrank K A ≤ ℓ →
      (∀ E : IntermediateField K (SeparableClosure K), IsGalois K E →
        Module.finrank K E = ℓ → E ≤ A) →
      ∀ H₁ H₂ : Subgroup (L ≃ₐ[K] L), H₁.index = ℓ → H₂.index = ℓ → H₁ = H₂ := by
    intro A _ hA hE H₁ H₂ h₁ h₂
    have hG : IsPGroup ℓ (L ≃ₐ[K] L) := IsPGroup.iff_orderOf.mpr hord
    obtain ⟨a, ha⟩ := IsPGroup.iff_card.mp hG
    have key : ∀ H : Subgroup (L ≃ₐ[K] L), H.index = ℓ →
        IntermediateField.lift (IntermediateField.fixedField H) = A := by
      intro H hH
      have ha0 : a ≠ 0 := by
        rintro rfl
        have h1 := H.index_dvd_card
        rw [hH, ha, pow_zero] at h1
        exact hℓp.one_lt.ne' (Nat.dvd_one.mp h1)
      have hmin : H.index = (Nat.card (L ≃ₐ[K] L)).minFac := by
        rw [ha, Nat.Prime.pow_minFac hℓp ha0, hH]
      haveI : H.Normal := Subgroup.normal_of_index_eq_minFac_card hmin
      haveI : IsGalois K (IntermediateField.fixedField H) :=
        IsGalois.of_fixedField_normal_subgroup H
      have hfr : Module.finrank K (IntermediateField.fixedField H) = ℓ := by
        rw [IntermediateField.finrank_eq_fixingSubgroup_index L,
          IntermediateField.fixingSubgroup_fixedField, hH]
      let e := IntermediateField.liftAlgEquiv (IntermediateField.fixedField H)
      haveI : IsGalois K (IntermediateField.lift (IntermediateField.fixedField H)) :=
        IsGalois.of_algEquiv e
      have hfrE : Module.finrank K (IntermediateField.lift (IntermediateField.fixedField H)) = ℓ := by
        rw [← e.toLinearEquiv.finrank_eq, hfr]
      have hle := hE _ inferInstance hfrE
      exact IntermediateField.eq_of_le_of_finrank_le hle (hA.trans hfrE.ge)
    have h := IntermediateField.lift_injective _ ((key H₁ h₁).trans (key H₂ h₂).symm)
    rw [← IntermediateField.fixingSubgroup_fixedField H₁, h,
      IntermediateField.fixingSubgroup_fixedField]

  have hn : ∀ j : ℕ, IsUnit (((ℓ ^ j : ℕ)) : V) := fun j => by
    rw [Nat.cast_pow]; exact hℓ.pow j
  have hpos : ∀ j : ℕ, 0 < ℓ ^ j := fun j => pow_pos hℓp.pos j
  have hVK : Function.Injective (algebraMap V K) := IsFractionRing.injective V K
  have env : ∀ j : ℕ, ∃ α : SeparableClosure K,
      α ^ (ℓ ^ j) = algebraMap K (SeparableClosure K) (algebraMap V K ϖ) ∧
      (primitiveRoots (ℓ ^ j) K).Nonempty ∧
      ∀ β : SeparableClosure K, β ≠ 0 →
        β ^ (ℓ ^ j) ∈ Set.range (algebraMap K (SeparableClosure K)) →
        β ∈ IntermediateField.adjoin K {α} := by
    intro j
    obtain ⟨α, hα⟩ := s6 (ℓ ^ j) (hn j)
    obtain ⟨ω, hω⟩ := sprim (ℓ ^ j) (hn j)
    refine ⟨α, hα, ⟨algebraMap V K ω,
      (mem_primitiveRoots (hpos j)).mpr (hω.map_of_injective hVK)⟩,
      fun β hβ0 hβ => s2 (ℓ ^ j) (hpos j) (sroots (ℓ ^ j) (hn j)) ω hω α β hα hβ0 hβ⟩
  have hG : IsPGroup ℓ (L ≃ₐ[K] L) := IsPGroup.iff_orderOf.mpr hord
  obtain ⟨a, ha⟩ := IsPGroup.iff_card.mp hG
  have hdeg : Module.finrank K L = ℓ ^ a := by
    rw [← IsGalois.card_aut_eq_finrank K L, ha]
  obtain ⟨α₁, hα₁, hP₁, hR₁⟩ := env 1
  rw [pow_one] at hα₁ hP₁ hR₁
  have hE : ∀ E : IntermediateField K (SeparableClosure K), IsGalois K E →
      Module.finrank K E = ℓ → E ≤ IntermediateField.adjoin K {α₁} := by
    intro E hgal hfr
    haveI := hgal
    haveI : FiniteDimensional K E :=
      FiniteDimensional.of_finrank_pos (by rw [hfr]; exact hℓp.pos)
    have hcyc : IsCyclic (E ≃ₐ[K] E) :=
      isCyclic_of_prime_card (by rw [IsGalois.card_aut_eq_finrank K E, hfr])
    exact s3 E hcyc (by rw [hfr]; exact hP₁) _ (by rw [hfr]; exact hR₁)
  obtain ⟨hfd₁, hfr₁⟩ := s5 ℓ hℓp.pos _ α₁ hα₁
  haveI := hfd₁
  have huniq := s4 _ hfr₁ hE
  have hcyc : IsCyclic (L ≃ₐ[K] L) := s1 huniq hG
  obtain ⟨α, hα, hP, hR⟩ := env a
  exact ⟨a, α, hα, s3 L hcyc (by rw [hdeg]; exact hP) _ (by rw [hdeg]; exact hR)⟩

theorem wc_pas_dks_kummer_dvr : ∀ (V : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V] (ϖ : V), Irreducible ϖ → ∀ (N : ℕ), 0 < N → ∃ (_ : IsDomain (AdjoinRoot (Polynomial.X ^ N - Polynomial.C ϖ))), IsDiscreteValuationRing (AdjoinRoot (Polynomial.X ^ N - Polynomial.C ϖ)) ∧ Irreducible (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C ϖ)) :=
by
  intro V _ _ _ ϖ hϖ N hN
  classical
  set f : Polynomial V := Polynomial.X ^ N - Polynomial.C ϖ with hf
  have hN0 : N ≠ 0 := hN.ne'
  have hfm : f.Monic := Polynomial.monic_X_pow_sub_C ϖ hN0
  have hfdeg : f.natDegree = N := Polynomial.natDegree_X_pow_sub_C

  have hθN : AdjoinRoot.root f ^ N = AdjoinRoot.of f ϖ := by
    have h : AdjoinRoot.mk f (Polynomial.X ^ N - Polynomial.C ϖ) = 0 := AdjoinRoot.mk_self
    rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h
    exact h

  have hmaxV : IsLocalRing.maximalIdeal V = Ideal.span {ϖ} :=
    (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ

  have hPprime : (Ideal.span {ϖ} : Ideal V).IsPrime :=
    (Ideal.span_singleton_prime hϖ.ne_zero).mpr hϖ.prime
  have hcoeff : ∀ n, f.coeff n = (if n = N then 1 else 0) - (if n = 0 then ϖ else 0) := by
    intro n
    rw [hf, Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C]
  have hE : f.IsEisensteinAt (Ideal.span {ϖ}) := by
    refine ⟨?_, ?_, ?_⟩
    · rw [hfm.leadingCoeff]
      intro h
      exact hϖ.not_isUnit (Ideal.span_singleton_eq_top.mp ((Ideal.eq_top_iff_one _).mpr h))
    · intro n hn
      rw [hfdeg] at hn
      have hnN : n ≠ N := by omega
      rw [hcoeff n]
      simp only [hnN, if_false]
      apply Ideal.mem_span_singleton.mpr
      split_ifs <;> simp
    · have h0 : (0 : ℕ) ≠ N := Ne.symm hN0
      rw [hcoeff 0]
      simp only [h0, if_false, if_true]
      rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton]
      rintro ⟨c, hc⟩
      have h1 : ϖ * (ϖ * c + 1) = 0 := by linear_combination -hc
      have h2 := (mul_eq_zero.mp h1).resolve_left hϖ.ne_zero
      exact hϖ.not_isUnit (IsUnit.of_mul_eq_one (-c) (by linear_combination -h2))
  have hirr : Irreducible f := hE.irreducible hPprime hfm.isPrimitive (by rw [hfdeg]; exact hN)
  have hfprime : Prime f := hirr.prime
  letI hdom : IsDomain (AdjoinRoot f) := AdjoinRoot.isDomain_of_prime hfprime

  haveI hfin : Module.Finite V (AdjoinRoot f) := (AdjoinRoot.powerBasis' hfm).finite
  haveI : Algebra.IsIntegral V (AdjoinRoot f) := Algebra.IsIntegral.of_finite V _

  have hM : ∀ M : Ideal (AdjoinRoot f), M.IsMaximal →
      AdjoinRoot.root f ∈ M ∧ Ideal.comap (AdjoinRoot.of f) M = Ideal.span {ϖ} := by
    intro M hMm
    haveI := hMm
    have hu : (Ideal.comap (algebraMap V (AdjoinRoot f)) M).IsMaximal :=
      Ideal.IsMaximal.under V M
    have hc : Ideal.comap (AdjoinRoot.of f) M = Ideal.span {ϖ} := by
      rw [← hmaxV, ← AdjoinRoot.algebraMap_eq]
      exact IsLocalRing.eq_maximalIdeal hu
    refine ⟨?_, hc⟩
    have h1 : ϖ ∈ Ideal.comap (AdjoinRoot.of f) M := by
      rw [hc]; exact Ideal.mem_span_singleton_self ϖ
    have h2 : AdjoinRoot.of f ϖ ∈ M := h1
    rw [← hθN] at h2
    exact hMm.isPrime.mem_of_pow_mem N h2

  have H : ∀ x : AdjoinRoot f, IsUnit x ∨ x ∈ Ideal.span {AdjoinRoot.root f} := by
    intro x
    obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective x
    obtain ⟨q, hq⟩ := Polynomial.X_dvd_sub_C (p := p)
    have hx : AdjoinRoot.mk f p =
        AdjoinRoot.of f (p.coeff 0) + AdjoinRoot.root f * AdjoinRoot.mk f q := by
      have h := congrArg (AdjoinRoot.mk f) hq
      rw [map_sub, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C] at h
      rw [← h]; ring
    by_cases hc : IsUnit (p.coeff 0)
    · left
      by_contra hnu
      obtain ⟨M, hMm, hxM⟩ := Ideal.exists_le_maximal (Ideal.span {AdjoinRoot.mk f p})
        (by rwa [Ne, Ideal.span_singleton_eq_top])
      have hxM' : AdjoinRoot.mk f p ∈ M := hxM (Ideal.mem_span_singleton_self _)
      obtain ⟨hθM, hcM⟩ := hM M hMm
      have h1 : AdjoinRoot.of f (p.coeff 0) ∈ M := by
        have e : AdjoinRoot.of f (p.coeff 0) =
            AdjoinRoot.mk f p - AdjoinRoot.root f * AdjoinRoot.mk f q := by rw [hx]; ring
        rw [e]; exact M.sub_mem hxM' (M.mul_mem_right _ hθM)
      have h2 : p.coeff 0 ∈ Ideal.span {ϖ} := by rw [← hcM]; exact h1
      rw [Ideal.mem_span_singleton] at h2
      exact hϖ.not_isUnit (isUnit_of_dvd_unit h2 hc)
    · right
      have h2 : p.coeff 0 ∈ Ideal.span {ϖ} := by
        rw [← hmaxV]; exact (IsLocalRing.mem_maximalIdeal _).mpr hc
      obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp h2
      rw [Ideal.mem_span_singleton']
      refine ⟨AdjoinRoot.of f d * AdjoinRoot.root f ^ (N - 1) + AdjoinRoot.mk f q, ?_⟩
      have hN1 : AdjoinRoot.root f ^ N = AdjoinRoot.root f ^ (N - 1) * AdjoinRoot.root f := by
        rw [← pow_succ, Nat.sub_add_cancel hN]
      rw [hx, ← hd, map_mul, ← hθN, hN1]
      ring

  have hθnu : ¬ IsUnit (AdjoinRoot.root f) := by
    intro hu
    obtain ⟨M₀, hM₀⟩ := Ideal.exists_maximal (AdjoinRoot f)
    exact hM₀.ne_top (Ideal.eq_top_of_isUnit_mem _ (hM M₀ hM₀).1 hu)
  have hPne : (Ideal.span {AdjoinRoot.root f} : Ideal (AdjoinRoot f)) ≠ ⊤ := by
    rw [Ne, Ideal.span_singleton_eq_top]; exact hθnu
  have hle : ∀ M : Ideal (AdjoinRoot f), M.IsMaximal → M ≤ Ideal.span {AdjoinRoot.root f} := by
    intro M hMm z hz
    rcases H z with hu | hz'
    · exact absurd (Ideal.eq_top_of_isUnit_mem _ hz hu) hMm.ne_top
    · exact hz'
  have hPmax : (Ideal.span {AdjoinRoot.root f} : Ideal (AdjoinRoot f)).IsMaximal := by
    obtain ⟨M, hMm, hPM⟩ := Ideal.exists_le_maximal _ hPne
    have e : M = Ideal.span {AdjoinRoot.root f} := le_antisymm (hle M hMm) hPM
    rw [← e]; exact hMm
  haveI hloc : IsLocalRing (AdjoinRoot f) :=
    IsLocalRing.of_unique_max_ideal ⟨_, hPmax, fun M hMm => hMm.eq_of_le hPne (hle M hMm)⟩
  have hmax : IsLocalRing.maximalIdeal (AdjoinRoot f) = Ideal.span {AdjoinRoot.root f} :=
    (IsLocalRing.eq_maximalIdeal hPmax).symm

  haveI : IsNoetherianRing (AdjoinRoot f) := IsNoetherianRing.of_finite V _
  have hθ0 : AdjoinRoot.root f ≠ 0 := by
    intro h0
    have e : AdjoinRoot.of f ϖ = 0 := by rw [← hθN, h0, zero_pow hN0]
    have hinj := AdjoinRoot.of.injective_of_degree_ne_zero (f := f)
      (by rw [Polynomial.degree_eq_natDegree hfm.ne_zero, hfdeg]; exact_mod_cast hN0)
    exact hϖ.ne_zero (hinj (by rw [e, map_zero]))
  have hnf : ¬ IsField (AdjoinRoot f) := by
    intro hF
    obtain ⟨b, hb⟩ := hF.mul_inv_cancel hθ0
    exact hθnu (IsUnit.of_mul_eq_one _ hb)
  have hpr : Submodule.IsPrincipal (IsLocalRing.maximalIdeal (AdjoinRoot f)) :=
    ⟨⟨AdjoinRoot.root f, hmax⟩⟩
  have hdvr : IsDiscreteValuationRing (AdjoinRoot f) :=
    ((IsDiscreteValuationRing.TFAE (AdjoinRoot f) hnf).out 1 5).mpr hpr
  exact ⟨hdom, hdvr, (IsDiscreteValuationRing.irreducible_iff_uniformizer _).mpr hmax⟩

theorem wc_pas_dks_tensor_split : ∀ (V : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V] (ϖ : V), Irreducible ϖ → ∀ (K : Type u) [Field K] [Algebra V K] [IsFractionRing V K] (F : Type u) [CommRing F] [Algebra V F] [Algebra K F] [IsScalarTower V K F] [Algebra.Etale K F] [Module.Finite K F] (N : ℕ), 0 < N → ∀ (α : SeparableClosure K), α ^ N = algebraMap K (SeparableClosure K) (algebraMap V K ϖ) → (∀ (χ : F →ₐ[K] SeparableClosure K) (x : F), χ x ∈ IntermediateField.adjoin K {α}) → ∃ r : ℕ, Nonempty (TensorProduct V (AdjoinRoot (Polynomial.X ^ N - Polynomial.C ϖ)) F ≃ₐ[AdjoinRoot (Polynomial.X ^ N - Polynomial.C ϖ)] (Fin r → Localization.Away (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C ϖ)))) :=
by
  have s1 : ∀ (V : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V] (ϖ : V), Irreducible ϖ → ∀ (K : Type u) [Field K] [Algebra V K] [IsFractionRing V K] (N : ℕ), 0 < N → Irreducible (Polynomial.X ^ N - Polynomial.C (algebraMap V K ϖ)) := by
    intro V _ _ _ ϖ hϖ K _ _ _ N hN
    have hN0 : N ≠ 0 := hN.ne'
    have hprime : Prime ϖ := UniqueFactorizationMonoid.irreducible_iff_prime.mp hϖ
    have hP : (Ideal.span {ϖ}).IsPrime := (Ideal.span_singleton_prime hϖ.ne_zero).mpr hprime
    set f : Polynomial V := Polynomial.X ^ N - Polynomial.C ϖ with hf
    have hmon : f.Monic := Polynomial.monic_X_pow_sub_C ϖ hN0
    have hdeg : f.natDegree = N := Polynomial.natDegree_X_pow_sub_C
    have hE : f.IsEisensteinAt (Ideal.span {ϖ}) := by
      refine ⟨?_, ?_, ?_⟩
      · rw [hmon.leadingCoeff, Ideal.mem_span_singleton]
        intro h
        exact hϖ.not_isUnit (isUnit_of_dvd_one h)
      · intro n hn
        rw [hdeg] at hn
        rw [hf, Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C,
          if_neg (Nat.ne_of_lt hn), zero_sub, Ideal.neg_mem_iff, Ideal.mem_span_singleton]
        split_ifs
        · exact dvd_refl _
        · exact dvd_zero _
      · rw [hf, Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C,
          if_neg (Ne.symm hN0), if_pos rfl, zero_sub, Ideal.span_singleton_pow,
          Ideal.mem_span_singleton]
        rintro ⟨c, hc⟩
        apply hϖ.not_isUnit
        have h2 : ϖ * (ϖ * c) = ϖ * (-1) := by rw [← mul_assoc, ← sq, ← hc]; ring
        have h3 := mul_left_cancel₀ hϖ.ne_zero h2
        exact IsUnit.of_mul_eq_one (-c) (by rw [mul_neg, h3, neg_neg])
    have hirrV : Irreducible f :=
      hE.irreducible hP hmon.isPrimitive (by rw [hdeg]; exact hN)
    have := (Polynomial.Monic.irreducible_iff_irreducible_map_fraction_map (K := K) hmon).mp hirrV
    simpa [hf, Polynomial.map_sub, Polynomial.map_pow] using this
  have s2 : ∀ (V : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V] (ϖ : V), Irreducible ϖ → ∀ (K : Type u) [Field K] [Algebra V K] [IsFractionRing V K] (N : ℕ), 0 < N → Irreducible (Polynomial.X ^ N - Polynomial.C (algebraMap V K ϖ)) → ∀ (α : SeparableClosure K), α ^ N = algebraMap K (SeparableClosure K) (algebraMap V K ϖ) → ∃ τ : Localization.Away (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C ϖ)) ≃+* ↥(IntermediateField.adjoin K ({α} : Set (SeparableClosure K))), ∀ v : V, τ (algebraMap (AdjoinRoot (Polynomial.X ^ N - Polynomial.C ϖ)) (Localization.Away (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C ϖ))) (algebraMap V (AdjoinRoot (Polynomial.X ^ N - Polynomial.C ϖ)) v)) = algebraMap K ↥(IntermediateField.adjoin K ({α} : Set (SeparableClosure K))) (algebraMap V K v) := by
    intro V _ _ _ ϖ hϖ K _ _ _ N hN hirr α hα
    classical
    set f : Polynomial V := Polynomial.X ^ N - Polynomial.C ϖ with hf
    set E : IntermediateField K (SeparableClosure K) := IntermediateField.adjoin K ({α} : Set (SeparableClosure K)) with hE
    let i : V →+* (SeparableClosure K) := (algebraMap K (SeparableClosure K)).comp (algebraMap V K)
    have hi_inj : Function.Injective i :=
      (algebraMap K (SeparableClosure K)).injective.comp (IsFractionRing.injective V K)
    have hϖ0 : ϖ ≠ 0 := hϖ.ne_zero
    have hαN : α ^ N = i ϖ := hα
    have h0 : Polynomial.eval₂ i α f = 0 := by
      rw [hf, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hαN, sub_self]
    have hα0 : α ≠ 0 := by
      intro h
      rw [h, zero_pow hN.ne'] at hαN
      exact hϖ0 (hi_inj (hαN.symm.trans (map_zero i).symm))
    let g : AdjoinRoot f →+* (SeparableClosure K) := AdjoinRoot.lift i α h0
    have hgθ : g (AdjoinRoot.root f) = α := AdjoinRoot.lift_root h0
    have hgof : ∀ v : V, g (algebraMap V (AdjoinRoot f) v) = i v := by
      intro v
      rw [AdjoinRoot.algebraMap_eq]
      exact AdjoinRoot.lift_of h0
    have hgmk : ∀ p : Polynomial V, g (AdjoinRoot.mk f p) =
        Polynomial.aeval α (p.map (algebraMap V K)) := by
      intro p
      rw [AdjoinRoot.lift_mk, Polynomial.aeval_def, Polynomial.eval₂_map]

    have hmon' : (Polynomial.X ^ N - Polynomial.C (algebraMap V K ϖ)).Monic :=
      Polynomial.monic_X_pow_sub_C _ hN.ne'
    have hmin : Polynomial.X ^ N - Polynomial.C (algebraMap V K ϖ) = minpoly K α := by
      apply minpoly.eq_of_irreducible_of_monic hirr _ hmon'
      rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, hα, sub_self]
    have hmon : f.Monic := Polynomial.monic_X_pow_sub_C ϖ hN.ne'
    have hfdeg : f.natDegree = N := Polynomial.natDegree_X_pow_sub_C

    have hg_inj : Function.Injective g := by
      rw [injective_iff_map_eq_zero]
      intro a ha
      obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective a
      have hpq : AdjoinRoot.mk f p = AdjoinRoot.mk f (p %ₘ f) := by
        rw [AdjoinRoot.mk_eq_mk]
        refine ⟨p /ₘ f, ?_⟩
        have : p %ₘ f + f * (p /ₘ f) = p := by
          first
          | exact Polynomial.modByMonic_add_div p hmon
          | exact Polynomial.modByMonic_add_div p f
        linear_combination this.symm
      rw [hpq] at ha ⊢
      rw [hgmk] at ha
      have hdvd := minpoly.dvd K α ha
      rw [← hmin] at hdvd
      have hf1 : f ≠ 1 := by
        intro h1
        have := hfdeg
        rw [h1, Polynomial.natDegree_one] at this
        omega
      have hlt : ((p %ₘ f).map (algebraMap V K)).natDegree <
          (Polynomial.X ^ N - Polynomial.C (algebraMap V K ϖ)).natDegree := by
        rw [Polynomial.natDegree_X_pow_sub_C]
        calc ((p %ₘ f).map (algebraMap V K)).natDegree ≤ (p %ₘ f).natDegree :=
              Polynomial.natDegree_map_le
          _ < f.natDegree := Polynomial.natDegree_modByMonic_lt p hmon hf1
          _ = N := hfdeg
      have hz := Polynomial.eq_zero_of_dvd_of_natDegree_lt hdvd hlt
      have hq0 : p %ₘ f = 0 :=
        Polynomial.map_injective (algebraMap V K) (IsFractionRing.injective V K)
          (by rw [hz, Polynomial.map_zero])
      rw [hq0, map_zero]

    set θ := AdjoinRoot.root f with hθdef
    have hgθu : IsUnit (g θ) := by rw [hgθ]; exact hα0.isUnit
    let ρ : Localization.Away θ →+* (SeparableClosure K) := IsLocalization.Away.lift θ hgθu
    have hρ : ∀ a : AdjoinRoot f, ρ (algebraMap (AdjoinRoot f) (Localization.Away θ) a) = g a :=
      fun a => IsLocalization.Away.lift_eq θ hgθu a
    have hρ_inj : Function.Injective ρ := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨k, a, hka⟩ := IsLocalization.Away.surj θ z
      have hga : g a = 0 := by
        rw [← hρ, ← hka, map_mul, hz, zero_mul]
      have ha0 : a = 0 := hg_inj (hga.trans (map_zero g).symm)
      rw [ha0, map_zero] at hka
      exact ((IsLocalization.Away.algebraMap_isUnit (S := Localization.Away θ) θ).pow k).mul_left_eq_zero.mp hka

    have hgE : ∀ a : AdjoinRoot f, g a ∈ E := by
      intro a
      obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective a
      rw [hgmk]
      have h1 : Algebra.adjoin K ({α} : Set (SeparableClosure K)) ≤ E.toSubalgebra :=
        Algebra.adjoin_le (Set.singleton_subset_iff.mpr (IntermediateField.mem_adjoin_simple_self K α))
      exact h1 (Polynomial.aeval_mem_adjoin_singleton K α)
    have hrange : ∀ z, ρ z ∈ E := by
      intro z
      obtain ⟨k, a, hka⟩ := IsLocalization.Away.surj θ z
      have h1 : ρ z * α ^ k = g a := by
        rw [← hρ, ← hka, map_mul, map_pow, hρ, hgθ]
      have h2 : ρ z = g a * (α ^ k)⁻¹ := by
        rw [← h1, mul_assoc, mul_inv_cancel₀ (pow_ne_zero k hα0), mul_one]
      rw [h2]
      exact E.mul_mem (hgE a) (E.inv_mem (pow_mem (IntermediateField.mem_adjoin_simple_self K α) k))

    let β : V →+* Localization.Away θ :=
      (algebraMap (AdjoinRoot f) (Localization.Away θ)).comp (algebraMap V (AdjoinRoot f))
    have hρβ : ∀ v : V, ρ (β v) = i v := fun v => by
      show ρ (algebraMap (AdjoinRoot f) (Localization.Away θ) (algebraMap V (AdjoinRoot f) v)) = i v
      rw [hρ, hgof]
    have hθN : θ ^ N = algebraMap V (AdjoinRoot f) ϖ := by
      have h := AdjoinRoot.eval₂_root f
      rw [hf, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, sub_eq_zero] at h
      rw [hθdef, h, AdjoinRoot.algebraMap_eq]
    have hβϖ : IsUnit (β ϖ) := by
      show IsUnit (algebraMap (AdjoinRoot f) (Localization.Away θ) (algebraMap V (AdjoinRoot f) ϖ))
      rw [← hθN, map_pow]
      exact (IsLocalization.Away.algebraMap_isUnit θ).pow N
    have hK : ∀ c : K, algebraMap K (SeparableClosure K) c ∈ ρ.range := by
      intro c
      obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective V c
      have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
      obtain ⟨m, u, hu⟩ := IsDiscreteValuationRing.associated_pow_irreducible hb0 hϖ
      have hβb : IsUnit (β b) := by
        have : β b * β (u : V) = β ϖ ^ m := by rw [← map_mul, hu, map_pow]
        exact isUnit_of_mul_isUnit_left (this ▸ hβϖ.pow m)
      refine ⟨β a * ↑(hβb.unit⁻¹), ?_⟩
      have hib : i b ≠ 0 := fun h => hb0 (hi_inj (h.trans (map_zero i).symm))
      have hinv : ρ ↑(hβb.unit⁻¹) = (i b)⁻¹ := by
        apply eq_inv_of_mul_eq_one_left
        rw [← hρβ, ← map_mul]
        simp
      rw [map_mul, hinv, hρβ, map_div₀, div_eq_mul_inv]
      rfl
    let S : Subalgebra K (SeparableClosure K) :=
      { ρ.range.toSubsemiring with algebraMap_mem' := hK }
    have hαS : α ∈ S := ⟨algebraMap (AdjoinRoot f) (Localization.Away θ) θ, by rw [hρ, hgθ]⟩
    have hES : E.toSubalgebra ≤ S := by
      rw [hE, IntermediateField.adjoin_toSubalgebra_of_isAlgebraic
        (fun x _ => Algebra.IsAlgebraic.isAlgebraic x)]
      exact Algebra.adjoin_le (Set.singleton_subset_iff.mpr hαS)
    let ρE : Localization.Away θ →+* E := ρ.codRestrict E hrange
    have hbij : Function.Bijective ρE := by
      constructor
      · intro z w h
        apply hρ_inj
        exact congrArg Subtype.val h
      · rintro ⟨y, hy⟩
        obtain ⟨z, hz⟩ := hES hy
        exact ⟨z, Subtype.ext hz⟩
    refine ⟨RingEquiv.ofBijective ρE hbij, ?_⟩
    intro v
    apply Subtype.ext
    show ρ (β v) = _
    rw [hρβ]
    first
    | rfl
    | simp [i]
  have s3 : ∀ (V : Type u) [CommRing V] [IsDomain V] (K : Type u) [Field K] [Algebra V K] [IsFractionRing V K] (F : Type u) [CommRing F] [Algebra V F] [Algebra K F] [IsScalarTower V K F] (A : Type u) [CommRing A] [Algebra V A] (s : A) (n : ℕ) (v₀ : V), 0 < n → v₀ ≠ 0 → s ^ n = algebraMap V A v₀ → ∀ (E : Type u) [Field E] [Algebra K E] (τ : Localization.Away s ≃+* E), (∀ v : V, τ (algebraMap A (Localization.Away s) (algebraMap V A v)) = algebraMap K E (algebraMap V K v)) → ∃ Φ : TensorProduct V A F ≃+* TensorProduct K E F, ∀ (a : A) (x : F), Φ (a ⊗ₜ[V] x) = τ (algebraMap A (Localization.Away s) a) ⊗ₜ[K] x := by
    intro V _ _ K _ _ _ F _ _ _ _ A _ _ s n v₀ hn hv₀ hs E _ _ τ hτ
    classical

    letI algC : Algebra V (TensorProduct K E F) :=
      ((algebraMap K (TensorProduct K E F)).comp (algebraMap V K)).toAlgebra
    let f₁ : A →ₐ[V] TensorProduct K E F :=
      { toRingHom := (Algebra.TensorProduct.includeLeftRingHom : E →+* TensorProduct K E F).comp
          (τ.toRingHom.comp (algebraMap A (Localization.Away s)))
        commutes' := fun v => by
          show τ (algebraMap A (Localization.Away s) (algebraMap V A v)) ⊗ₜ[K] (1 : F) =
            algebraMap K (TensorProduct K E F) (algebraMap V K v)
          rw [hτ, Algebra.TensorProduct.algebraMap_apply] }
    let g₁ : F →ₐ[V] TensorProduct K E F :=
      { toRingHom := (Algebra.TensorProduct.includeRight : F →ₐ[K] TensorProduct K E F).toRingHom
        commutes' := fun v => by
          show (Algebra.TensorProduct.includeRight : F →ₐ[K] TensorProduct K E F) (algebraMap V F v) =
            algebraMap K (TensorProduct K E F) (algebraMap V K v)
          rw [IsScalarTower.algebraMap_apply V K F, AlgHom.commutes] }
    let Φ₀ : TensorProduct V A F →ₐ[V] TensorProduct K E F :=
      Algebra.TensorProduct.lift f₁ g₁ (fun _ _ => Commute.all _ _)
    have hΦ₀ : ∀ (a : A) (x : F), Φ₀ (a ⊗ₜ[V] x) =
        τ (algebraMap A (Localization.Away s) a) ⊗ₜ[K] x := by
      intro a x
      show f₁ a * g₁ x = _
      show (τ (algebraMap A (Localization.Away s) a) ⊗ₜ[K] (1 : F)) * ((1 : E) ⊗ₜ[K] x) = _
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]

    have hunitV : IsUnit (algebraMap V (TensorProduct V A F) v₀) := by
      have hK : IsUnit (algebraMap V K v₀) :=
        (map_ne_zero_iff _ (IsFractionRing.injective V K)).mpr hv₀ |>.isUnit
      have h1 := (hK.map (algebraMap K F)).map
        (Algebra.TensorProduct.includeRight : F →ₐ[V] TensorProduct V A F)
      rwa [← IsScalarTower.algebraMap_apply, AlgHom.commutes] at h1
    have hunit : IsUnit ((Algebra.TensorProduct.includeLeftRingHom :
        A →+* TensorProduct V A F) s) := by
      rw [← isUnit_pow_iff hn.ne', ← map_pow, hs]
      convert hunitV using 1
    let hL : Localization.Away s →+* TensorProduct V A F :=
      IsLocalization.Away.lift s hunit
    have hLeq : ∀ a : A, hL (algebraMap A (Localization.Away s) a) = a ⊗ₜ[V] (1 : F) :=
      fun a => IsLocalization.Away.lift_eq s hunit a
    letI algD : Algebra K (TensorProduct V A F) :=
      ((Algebra.TensorProduct.includeRight : F →ₐ[V] TensorProduct V A F).toRingHom.comp
        (algebraMap K F)).toAlgebra
    let hE : E →ₐ[K] TensorProduct V A F :=
      { toRingHom := hL.comp τ.symm.toRingHom
        commutes' := by
          have : (hL.comp τ.symm.toRingHom).comp (algebraMap K E) =
              algebraMap K (TensorProduct V A F) := by
            apply IsLocalization.ringHom_ext (nonZeroDivisors V)
            ext v
            simp only [RingHom.comp_apply]
            rw [← hτ v]
            show hL (τ.symm (τ _)) = (1 : A) ⊗ₜ[V] algebraMap K F (algebraMap V K v)
            rw [RingEquiv.symm_apply_apply, hLeq, ← IsScalarTower.algebraMap_apply,
              ← Algebra.TensorProduct.algebraMap_apply' (R := V) (A := A) (B := F),
              Algebra.TensorProduct.algebraMap_apply]
          intro c
          exact RingHom.congr_fun this c }
    let g₂ : F →ₐ[K] TensorProduct V A F :=
      { toRingHom := (Algebra.TensorProduct.includeRight : F →ₐ[V] TensorProduct V A F).toRingHom
        commutes' := fun c => rfl }
    let Ψ₀ : TensorProduct K E F →ₐ[K] TensorProduct V A F :=
      Algebra.TensorProduct.lift hE g₂ (fun _ _ => Commute.all _ _)
    have hΨ₀ : ∀ (e : E) (x : F), Ψ₀ (e ⊗ₜ[K] x) = hL (τ.symm e) * ((1 : A) ⊗ₜ[V] x) := by
      intro e x
      rfl
    have hΦL : ∀ z : Localization.Away s, Φ₀ (hL z) = τ z ⊗ₜ[K] (1 : F) := by
      have : (Φ₀.toRingHom.comp hL) =
          (Algebra.TensorProduct.includeLeftRingHom : E →+* TensorProduct K E F).comp τ.toRingHom := by
        apply IsLocalization.ringHom_ext (Submonoid.powers s)
        ext a
        simp only [RingHom.comp_apply]
        rw [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hLeq, hΦ₀]
        rfl
      intro z
      exact RingHom.congr_fun this z
    have hleft : ∀ z, Ψ₀ (Φ₀ z) = z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a x =>
        rw [hΦ₀, hΨ₀, RingEquiv.symm_apply_apply, hLeq, Algebra.TensorProduct.tmul_mul_tmul,
          mul_one, one_mul]
      | add z w hz hw => rw [map_add, map_add, hz, hw]
    have hright : ∀ z, Φ₀ (Ψ₀ z) = z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul e x =>
        rw [hΨ₀, map_mul, hΦL, RingEquiv.apply_symm_apply, hΦ₀,
          Algebra.TensorProduct.tmul_mul_tmul]
        simp only [map_one, mul_one, one_mul]
      | add z w hz hw => rw [map_add, map_add, hz, hw]
    refine ⟨RingEquiv.ofRingHom Φ₀.toRingHom Ψ₀.toRingHom
      (RingHom.ext fun z => hright z) (RingHom.ext fun z => hleft z), ?_⟩
    intro a x
    exact hΦ₀ a x
  have s4 : ∀ (K : Type u) [Field K] (F : Type u) [CommRing F] [Algebra K F] [Module.Finite K F] (E : Type u) [Field E] [Algebra K E], Nat.card (F →ₐ[K] E) = Module.finrank K F → ∃ r : ℕ, Nonempty (TensorProduct K E F ≃ₐ[E] (Fin r → E)) := by
    intro K _ F _ _ _ E _ _ hcard
    classical
    haveI hfinH : Finite (F →ₐ[K] E) :=
      Cardinal.lt_aleph0_iff_finite.mp
        (lt_of_le_of_lt (cardinalMk_algHom K F E) Cardinal.natCast_lt_aleph0)
    letI : Fintype (F →ₐ[K] E) := Fintype.ofFinite _
    have hcardH : Fintype.card (F →ₐ[K] E) = Module.finrank K F := by
      rw [← Nat.card_eq_fintype_card, hcard]
    let ev : (F →ₐ[K] E) → (TensorProduct K E F →ₐ[E] E) := fun ψ =>
      Algebra.TensorProduct.lift (AlgHom.id E E) ψ (fun _ _ => Commute.all _ _)
    let Φ : TensorProduct K E F →ₐ[E] ((F →ₐ[K] E) → E) := Pi.algHom E (fun _ => E) ev
    have hΦx : ∀ x : F, Φ ((1 : E) ⊗ₜ[K] x) = fun ψ => ψ x := by
      intro x
      funext ψ
      simp [Φ, ev, Pi.algHom_apply, Algebra.TensorProduct.lift_tmul]
    have hsurj : Function.Surjective Φ.toLinearMap := by
      rw [← LinearMap.range_eq_top]
      by_contra hne
      obtain ⟨l, hl0, hle⟩ := Submodule.exists_le_ker_of_lt_top _ (lt_top_iff_ne_top.mpr hne)
      apply hl0
      let c : (F →ₐ[K] E) → E := fun ψ => l (fun j => if ψ = j then 1 else 0)
      have hlv : ∀ v, l v = ∑ ψ, v ψ • c ψ := fun v => LinearMap.pi_apply_eq_sum_univ l v
      have hdep : ∑ ψ, c ψ • (ψ.toLinearMap : F →ₗ[K] E) = 0 := by
        ext x
        have hx : l (fun ψ => ψ x) = 0 := by
          have : (fun ψ : F →ₐ[K] E => ψ x) ∈ LinearMap.range Φ.toLinearMap :=
            ⟨(1 : E) ⊗ₜ[K] x, by simpa using hΦx x⟩
          exact hle this
        rw [hlv] at hx
        rw [LinearMap.zero_apply, ← hx]
        simp [smul_eq_mul, mul_comm]
      have hc0 := (Fintype.linearIndependent_iff.mp (linearIndependent_toLinearMap K F E)) c hdep
      apply LinearMap.ext
      intro v
      rw [hlv]
      simp [hc0]
    have hdim : Module.finrank E (TensorProduct K E F) = Module.finrank E ((F →ₐ[K] E) → E) := by
      rw [Module.finrank_baseChange, Module.finrank_fintype_fun_eq_card, hcardH]
    have hinj : Function.Injective Φ.toLinearMap :=
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim).mpr hsurj
    let Φe : TensorProduct K E F ≃ₐ[E] ((F →ₐ[K] E) → E) := AlgEquiv.ofBijective Φ ⟨hinj, hsurj⟩
    let σ : Fin (Module.finrank K F) ≃ (F →ₐ[K] E) := (Fintype.equivFinOfCardEq hcardH).symm
    exact ⟨Module.finrank K F, ⟨Φe.trans (AlgEquiv.piCongrLeft E (fun _ => E) σ).symm⟩⟩
  have s5 : ∀ (K : Type u) [Field K] (F : Type u) [CommRing F] [Algebra K F] (Ω : Type u) [Field Ω] [Algebra K Ω] (E : IntermediateField K Ω), (∀ (χ : F →ₐ[K] Ω) (x : F), χ x ∈ E) → Nat.card (F →ₐ[K] E) = Nat.card (F →ₐ[K] Ω) := by
    intro K _ F _ _ Ω _ _ E hE
    apply Nat.card_eq_of_bijective (fun ψ => E.val.comp ψ)
    constructor
    · intro ψ₁ ψ₂ h
      ext x
      have := congrArg (fun φ : F →ₐ[K] Ω => φ x) h
      simpa using this
    · intro χ
      refine ⟨χ.codRestrict E.toSubalgebra (hE χ), ?_⟩
      ext x
      rfl
  have s6 : ∀ (K : Type u) [Field K] (F : Type u) [CommRing F] [Algebra K F] [Algebra.Etale K F] (Ω : Type u) [Field Ω] [IsSepClosed Ω] [Algebra K Ω], Nat.card (F →ₐ[K] Ω) = Module.finrank K F := by
    intro K _ F _ _ _ Ω _ _ _
    classical
    obtain ⟨I, hI, Ai, _, _, e, hAi⟩ := (Algebra.Etale.iff_exists_algEquiv_prod K F).mp inferInstance
    haveI : Fintype I := Fintype.ofFinite I
    haveI : ∀ i, Module.Finite K (Ai i) := fun i => (hAi i).1
    haveI : ∀ i, Algebra.IsSeparable K (Ai i) := fun i => (hAi i).2
    haveI hfin : ∀ i, Finite (Ai i →ₐ[K] Ω) := fun i =>
      Cardinal.lt_aleph0_iff_finite.mp
        (lt_of_le_of_lt (cardinalMk_algHom K (Ai i) Ω) Cardinal.natCast_lt_aleph0)
    have h1 : Nat.card (F →ₐ[K] Ω) = Nat.card (((i : I) → Ai i) →ₐ[K] Ω) :=
      Nat.card_congr (AlgEquiv.arrowCongr e AlgEquiv.refl)
    have h2 : Module.finrank K F = ∑ i, Module.finrank K (Ai i) := by
      rw [LinearEquiv.finrank_eq e.toLinearEquiv, Module.finrank_pi_fintype]
    have h3 : ∀ i, Nat.card (Ai i →ₐ[K] Ω) = Module.finrank K (Ai i) := fun i =>
      AlgHom.natCard_of_splits K (Ai i) Ω (fun x =>
        IsSepClosed.splits_codomain (minpoly K x) (Algebra.IsSeparable.isSeparable K x))
    let G : (Σ i, (Ai i →ₐ[K] Ω)) → (((i : I) → Ai i) →ₐ[K] Ω) :=
      fun p => p.2.comp (Pi.evalAlgHom K Ai p.1)
    have hG : Function.Bijective G := by
      constructor
      · rintro ⟨i, φ⟩ ⟨j, φ'⟩ h
        have hij : i = j := by
          by_contra hne
          have := congrArg (fun Ψ : ((i : I) → Ai i) →ₐ[K] Ω => Ψ (Pi.single i 1)) h
          simp only [G, AlgHom.comp_apply, Pi.evalAlgHom_apply, Pi.single_eq_same, map_one,
            Pi.single_eq_of_ne' hne, map_zero] at this
          exact one_ne_zero this
        subst hij
        have hφ : φ = φ' := by
          ext x
          have := congrArg (fun Ψ : ((i : I) → Ai i) →ₐ[K] Ω => Ψ (Pi.single i x)) h
          simpa [G] using this
        rw [hφ]
      · intro Ψ
        have hidem : ∀ i, Ψ (Pi.single i 1) = 0 ∨ Ψ (Pi.single i 1) = 1 := by
          intro i
          apply IsIdempotentElem.iff_eq_zero_or_one.mp
          show Ψ (Pi.single i 1) * Ψ (Pi.single i 1) = Ψ (Pi.single i 1)
          rw [← map_mul, ← Pi.single_mul, mul_one]
        have hsum : ∑ i, Ψ (Pi.single i 1) = 1 := by
          rw [← map_sum, Finset.univ_sum_single (fun i => (1 : Ai i))]
          exact map_one Ψ
        obtain ⟨i, hi⟩ : ∃ i, Ψ (Pi.single i 1) = 1 := by
          by_contra hno
          push_neg at hno
          have : ∑ i, Ψ (Pi.single i 1) = 0 :=
            Finset.sum_eq_zero (fun i _ => (hidem i).resolve_right (hno i))
          rw [hsum] at this
          exact one_ne_zero this
        have hmulsingle : ∀ x : (i : I) → Ai i, x * Pi.single i 1 = Pi.single i (x i) := by
          intro x
          funext j
          by_cases hj : j = i
          · subst hj; simp
          · simp [Pi.single_eq_of_ne hj]
        let φ : Ai i →ₐ[K] Ω :=
          { toFun := fun a => Ψ (Pi.single i a)
            map_one' := hi
            map_mul' := fun a b => by simp only [Pi.single_mul, map_mul]
            map_zero' := by simp only [Pi.single_zero, map_zero]
            map_add' := fun a b => by simp only [Pi.single_add, map_add]
            commutes' := fun c => by
              have : Pi.single i (algebraMap K (Ai i) c) =
                  algebraMap K ((i : I) → Ai i) c * Pi.single i 1 := by
                rw [hmulsingle]; rfl
              show Ψ (Pi.single i (algebraMap K (Ai i) c)) = algebraMap K Ω c
              rw [this, map_mul, AlgHom.commutes, hi, mul_one] }
        refine ⟨⟨i, φ⟩, ?_⟩
        ext x
        show Ψ (Pi.single i (x i)) = Ψ x
        rw [← hmulsingle, map_mul, hi, mul_one]
    rw [h1, ← Nat.card_eq_of_bijective G hG, Nat.card_sigma, h2]
    exact Finset.sum_congr rfl (fun i _ => h3 i)
  intro V _ _ _ ϖ hϖ K _ _ _ F _ _ _ _ _ _ N hN α hα hcont
  classical
  have hθ : (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C ϖ)) ^ N =
      algebraMap V (AdjoinRoot (Polynomial.X ^ N - Polynomial.C ϖ)) ϖ := by
    have h := AdjoinRoot.eval₂_root (Polynomial.X ^ N - Polynomial.C ϖ)
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, sub_eq_zero] at h
    rw [h, AdjoinRoot.algebraMap_eq]
  have hϖ0 : ϖ ≠ 0 := hϖ.ne_zero
  have hirr := s1 V ϖ hϖ K N hN
  obtain ⟨τ, hτ⟩ := s2 V ϖ hϖ K N hN hirr α hα
  obtain ⟨Φ, hΦ⟩ := s3 V K F (AdjoinRoot (Polynomial.X ^ N - Polynomial.C ϖ))
    (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C ϖ)) N ϖ hN hϖ0 hθ _ τ hτ
  have hcard : Nat.card (F →ₐ[K] ↥(IntermediateField.adjoin K ({α} : Set (SeparableClosure K)))) =
      Module.finrank K F :=
    (s5 K F (SeparableClosure K) _ hcont).trans
      (s6 K F (SeparableClosure K))
  obtain ⟨r, ⟨ψ⟩⟩ := s4 K F _ hcard
  let Ψ : TensorProduct V (AdjoinRoot (Polynomial.X ^ N - Polynomial.C ϖ)) F ≃+*
      (Fin r → Localization.Away (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C ϖ))) :=
    Φ.trans (ψ.toRingEquiv.trans (RingEquiv.piCongrRight (fun _ : Fin r => τ.symm)))
  refine ⟨r, ⟨AlgEquiv.ofRingEquiv (f := Ψ) ?_⟩⟩
  intro a
  rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
  have h1 : Ψ (a ⊗ₜ[V] (1 : F)) = RingEquiv.piCongrRight (fun _ : Fin r => τ.symm)
      (ψ (τ (algebraMap _ (Localization.Away (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C ϖ))) a)
        ⊗ₜ[K] (1 : F))) := by
    show RingEquiv.piCongrRight (fun _ : Fin r => τ.symm) (ψ (Φ (a ⊗ₜ[V] (1 : F)))) = _
    rw [hΦ]
  rw [h1]
  have h2 : ∀ e : ↥(IntermediateField.adjoin K ({α} : Set (SeparableClosure K))),
      ψ (e ⊗ₜ[K] (1 : F)) = algebraMap _ (Fin r → ↥(IntermediateField.adjoin K ({α} : Set (SeparableClosure K)))) e :=
    fun e => ψ.commutes e
  rw [h2]
  funext i
  simp [Pi.algebraMap_apply, RingEquiv.piCongrRight_apply]

theorem wc_pas_dvr_tame_kummer_split : ∀ (V : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V] [HenselianLocalRing V] [IsSepClosed (IsLocalRing.ResidueField V)] (ϖ : V), Irreducible ϖ → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : V) → ∀ (F : Type u) [CommRing F] [Algebra V F] [Algebra (Localization.Away ϖ) F] [IsScalarTower V (Localization.Away ϖ) F] [Algebra.Etale (Localization.Away ϖ) F] [Module.Finite (Localization.Away ϖ) F], (∀ (H' : Type u) [CommRing H'] [HenselianLocalRing H'] [IsSepClosed (IsLocalRing.ResidueField H')] (hh : V →+* H'), @Algebra.WeaklyEtale V H' _ _ hh.toAlgebra → (IsLocalRing.maximalIdeal H').comap hh = Ideal.span {ϖ} → ∀ (Ω : Type u) [Field Ω] [IsSepClosed Ω] (j : H' →+* Ω), @Algebra.WeaklyEtale H' Ω _ _ j.toAlgebra → ∀ σ : Ω →+* Ω, (∀ a, σ (j a) = j a) → ∀ χ : F →+* Ω, χ.comp (algebraMap V F) = j.comp hh → ∃ m : ℕ, (σ ^ (ℓ ^ m)).comp χ = χ) → ∃ k : ℕ, Algebra.Etale (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ϖ)) (integralClosure (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ϖ)) (TensorProduct V (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ϖ)) F)) :=
by
  intro V _ _ _ _ _ ϖ hϖ ℓ _ hℓ F _ _ _ _ _ _ hT
  classical

  have hfrac : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (p : R),
      Irreducible p → IsFractionRing R (Localization.Away p) := by
    intro R _ _ _ p hp
    refine IsLocalization.of_le (Submonoid.powers p) (nonZeroDivisors R) ?_ ?_
    · rintro x ⟨n, rfl⟩
      exact mem_nonZeroDivisors_of_ne_zero (pow_ne_zero n hp.ne_zero)
    · intro r hr
      obtain ⟨n, ⟨u, hu⟩⟩ :=
        IsDiscreteValuationRing.associated_pow_irreducible (nonZeroDivisors.ne_zero hr) hp
      have h1 : IsUnit (algebraMap R (Localization.Away p) (p ^ n)) := by
        rw [map_pow]; exact (IsLocalization.Away.algebraMap_isUnit p).pow n
      rw [← hu, map_mul] at h1
      exact isUnit_of_mul_isUnit_left h1
  haveI hKfr : IsFractionRing V (Localization.Away ϖ) := hfrac V ϖ hϖ
  letI : Field (Localization.Away ϖ) := IsFractionRing.toField V

  let j : V →+* SeparableClosure (Localization.Away ϖ) :=
    (algebraMap (Localization.Away ϖ) (SeparableClosure (Localization.Away ϖ))).comp
      (algebraMap V (Localization.Away ϖ))
  have hWK : Algebra.WeaklyEtale V (Localization.Away ϖ) :=
    wc_localization_weaklyEtale V _ (Submonoid.powers ϖ)
  have hWΩ : Algebra.WeaklyEtale (Localization.Away ϖ) (SeparableClosure (Localization.Away ϖ)) := by
    have h := wc_lpkt_specMap_weaklyEtale_ring _ _
      (algebraMap (Localization.Away ϖ) (SeparableClosure (Localization.Away ϖ)))
      (wc_fpe_sepClosure_weaklyEtale _)
    have e : (algebraMap (Localization.Away ϖ) (SeparableClosure (Localization.Away ϖ))).toAlgebra =
        (inferInstance : Algebra (Localization.Away ϖ) (SeparableClosure (Localization.Away ϖ))) :=
      Algebra.algebra_ext _ _ (fun _ => rfl)
    rw [e] at h
    exact h
  have hWj : @Algebra.WeaklyEtale V (SeparableClosure (Localization.Away ϖ)) _ _ j.toAlgebra := by
    letI : Algebra V (SeparableClosure (Localization.Away ϖ)) := j.toAlgebra
    haveI : IsScalarTower V (Localization.Away ϖ) (SeparableClosure (Localization.Away ϖ)) :=
      IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    exact Algebra.WeaklyEtale.trans V (Localization.Away ϖ) (SeparableClosure (Localization.Away ϖ))
  have hWid : @Algebra.WeaklyEtale V V _ _ (RingHom.id V).toAlgebra := by
    have e : (RingHom.id V).toAlgebra = Algebra.id V := Algebra.algebra_ext _ _ (fun _ => rfl)
    rw [e]
    infer_instance
  have hcomap : (IsLocalRing.maximalIdeal V).comap (RingHom.id V) = Ideal.span {ϖ} := by
    rw [Ideal.comap_id]
    exact (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ
  have htame : ∀ (σ : SeparableClosure (Localization.Away ϖ) ≃ₐ[Localization.Away ϖ]
      SeparableClosure (Localization.Away ϖ))
      (χ : F →ₐ[Localization.Away ϖ] SeparableClosure (Localization.Away ϖ)),
      ∃ m : ℕ, (σ ^ (ℓ ^ m)).toAlgHom.comp χ = χ := by
    intro σ χ
    have hσ : ∀ a, (σ : SeparableClosure (Localization.Away ϖ) →+*
        SeparableClosure (Localization.Away ϖ)) (j a) = j a := by
      intro a
      show σ (algebraMap (Localization.Away ϖ) _ (algebraMap V (Localization.Away ϖ) a)) = _
      exact σ.commutes _
    have hχ : (χ : F →+* SeparableClosure (Localization.Away ϖ)).comp (algebraMap V F) =
        j.comp (RingHom.id V) := by
      refine RingHom.ext fun a => ?_
      show χ (algebraMap V F a) =
        algebraMap (Localization.Away ϖ) _ (algebraMap V (Localization.Away ϖ) a)
      rw [IsScalarTower.algebraMap_apply V (Localization.Away ϖ) F a, χ.commutes]
    obtain ⟨m, hm⟩ := hT V (RingHom.id V) hWid hcomap (SeparableClosure (Localization.Away ϖ)) j hWj
      (σ : SeparableClosure (Localization.Away ϖ) →+* SeparableClosure (Localization.Away ϖ)) hσ
      (χ : F →+* SeparableClosure (Localization.Away ϖ)) hχ
    have hpow : ∀ (n : ℕ) (x : SeparableClosure (Localization.Away ϖ)),
        (σ ^ n) x = ((σ : SeparableClosure (Localization.Away ϖ) →+*
          SeparableClosure (Localization.Away ϖ)) ^ n) x := by
      intro n
      induction n with
      | zero => intro x; rw [pow_zero, pow_zero]; rfl
      | succ n ih =>
        intro x
        rw [pow_succ, pow_succ, AlgEquiv.mul_apply]
        exact ih (σ x)
    refine ⟨m, AlgHom.ext fun x => ?_⟩
    show (σ ^ ℓ ^ m) (χ x) = χ x
    rw [hpow]
    exact RingHom.congr_fun hm x

  obtain ⟨L, hLfd, hLgal, hLord, hLmem⟩ :=
    wc_pas_dks_tame_galois_closure (Localization.Away ϖ) ℓ F htame
  haveI := hLfd
  haveI := hLgal

  obtain ⟨k, α, hα, hLle⟩ :=
    wc_pas_dks_galois_in_kummer V ϖ hϖ ℓ hℓ (Localization.Away ϖ) L hLord
  refine ⟨k, ?_⟩
  have hNpos : 0 < ℓ ^ k := pow_pos (Fact.out : Nat.Prime ℓ).pos k

  obtain ⟨r, ⟨e⟩⟩ := wc_pas_dks_tensor_split V ϖ hϖ (Localization.Away ϖ) F (ℓ ^ k) hNpos α hα
    (fun χ x => hLle (hLmem χ x))

  obtain ⟨hdom, hdvr, hθ⟩ := wc_pas_dks_kummer_dvr V ϖ hϖ (ℓ ^ k) hNpos
  letI := hdom
  haveI := hdvr

  haveI hθfr : IsFractionRing (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ϖ))
      (Localization.Away (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ϖ))) :=
    hfrac _ _ hθ
  haveI : IsIntegrallyClosed (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ϖ)) :=
    UniqueFactorizationMonoid.instIsIntegrallyClosed
  let β : integralClosure (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ϖ))
      (Localization.Away (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ϖ))) ≃ₐ[
        AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ϖ)]
      AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ϖ) :=
    (Subalgebra.equivOfEq _ _ (IsIntegrallyClosed.integralClosure_eq_bot _ _)).trans
      (Algebra.botEquivOfInjective (IsFractionRing.injective _ _))

  obtain ⟨γ⟩ := wc_pas_integralClosure_pi (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ϖ)) r
    (fun _ => Localization.Away (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ϖ)))
  let E := (e.mapIntegralClosure.trans γ).trans (AlgEquiv.piCongrRight fun _ => β)
  exact Algebra.Etale.of_equiv E.symm

theorem wc_pub_integralClosure_indEtale_baseChange : ∀ (R H C : Type u) [CommRing R] [IsNoetherianRing R] [CommRing H] [CommRing C] [Algebra R H] [Algebra R C], wcIndEtale (algebraMap R H) → ∃ e : TensorProduct R H (integralClosure R C) ≃ₐ[H] integralClosure H (TensorProduct R H C), ∀ (h : H) (b : integralClosure R C), (e (h ⊗ₜ[R] b) : TensorProduct R H C) = h ⊗ₜ[R] (b : C) :=
by
  intro R H C _ _ _ _ _ _ hind
  classical
  have hinst : (algebraMap R H).toAlgebra = ‹Algebra R H› := Algebra.algebra_ext _ _ (fun _ => rfl)
  have hW : Algebra.WeaklyEtale R H := by
    have h0 := wc_indEtale_weaklyEtale (algebraMap R H) hind
    rwa [hinst] at h0
  have hind' : ∀ (P : Type u) [CommRing P] [Algebra R P] [Algebra.FinitePresentation R P]
      (h : P →ₐ[R] H), ∃ (E : Type u) (_ : CommRing E) (_ : Algebra R E), Algebra.Etale R E ∧
        ∃ (α : P →ₐ[R] E) (β : E →ₐ[R] H), β.comp α = h := by
    have h0 := hind
    unfold wcIndEtale at h0
    rw [hinst] at h0
    exact h0
  haveI : Module.Flat R H := inferInstance

  have hnat : ∀ (A A' : Type u) [CommRing A] [CommRing A'] [Algebra R A] [Algebra R A']
      (f : A →ₐ[R] A') (x : TensorProduct R A C) (p : Polynomial A),
      Algebra.TensorProduct.map f (AlgHom.id R C) (Polynomial.aeval x p) =
        Polynomial.aeval (Algebra.TensorProduct.map f (AlgHom.id R C) x)
          (p.map (f : A →+* A')) := by
    intro A A' _ _ _ _ f x p
    have hc : (algebraMap A' (TensorProduct R A' C)).comp (f : A →+* A') =
        ((Algebra.TensorProduct.map f (AlgHom.id R C)).toRingHom).comp
          (algebraMap A (TensorProduct R A C)) := by
      ext a
      simp [Algebra.TensorProduct.algebraMap_apply]
    exact Polynomial.map_aeval_eq_aeval_map hc p x

  have s3 : ∀ (z : TensorProduct R H C), IsIntegral H z → ∃ S₀ : Subalgebra R H, S₀.FG ∧
      ∃ (z₀ : TensorProduct R S₀ C) (p₀ : Polynomial S₀), p₀.Monic ∧
        Algebra.TensorProduct.map S₀.val (AlgHom.id R C) z₀ = z ∧
        Algebra.TensorProduct.map S₀.val (AlgHom.id R C) (Polynomial.aeval z₀ p₀) = 0 := by
    intro z hz
    obtain ⟨p, hpm, hp⟩ := hz
    obtain ⟨T, hT⟩ := TensorProduct.exists_finset z
    set s : Finset H := T.image Prod.fst ∪ p.coeffs with hs
    set S₀ : Subalgebra R H := Algebra.adjoin R (s : Set H) with hS₀
    have hsS : ∀ x ∈ s, x ∈ S₀ := fun x hx => Algebra.subset_adjoin hx
    have hT1 : ∀ q ∈ T, q.1 ∈ S₀ := fun q hq =>
      hsS _ (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hq))
    have hcoeff : ∀ n, p.coeff n ∈ S₀ := by
      intro n
      by_cases h : p.coeff n = 0
      · rw [h]; exact zero_mem _
      · exact hsS _ (Finset.mem_union_right _ (Polynomial.coeff_mem_coeffs h))
    have hlift : p ∈ Polynomial.lifts (S₀.val : S₀ →+* H) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro n
      exact ⟨⟨_, hcoeff n⟩, rfl⟩
    obtain ⟨p₀, hp₀map, -, hp₀m⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hpm
    have hz₀ : Algebra.TensorProduct.map S₀.val (AlgHom.id R C)
        (∑ q ∈ T.attach, (⟨q.1.1, hT1 q.1 q.2⟩ : S₀) ⊗ₜ[R] q.1.2) = z := by
      rw [map_sum, hT]
      simp only [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, Subalgebra.coe_val]
      exact Finset.sum_attach T (fun q => q.1 ⊗ₜ[R] q.2)
    refine ⟨S₀, Subalgebra.fg_adjoin_finset s, _, p₀, hp₀m, hz₀, ?_⟩
    rw [hnat, hz₀]
    have : Polynomial.map (S₀.val : S₀ →+* H) p₀ = p := hp₀map
    rw [this, Polynomial.aeval_def]
    exact hp

  have s4 : ∀ (S₀ : Subalgebra R H), S₀.FG → ∀ y : TensorProduct R S₀ C,
      Algebra.TensorProduct.map S₀.val (AlgHom.id R C) y = 0 →
      ∃ S₁ : Subalgebra R H, S₁.FG ∧ ∃ hle : S₀ ≤ S₁,
        Algebra.TensorProduct.map (Subalgebra.inclusion hle) (AlgHom.id R C) y = 0 := by
    intro S₀ hS₀ y hy
    obtain ⟨T, hT⟩ := TensorProduct.exists_finset y
    set Q₀ : Submodule R H := Submodule.span R ((T.image (fun q => (q.1 : H)) : Finset H) : Set H)
      with hQ₀def
    have hQ₀ : Q₀.FG := Submodule.fg_span (Finset.finite_toSet _)
    have hmem : ∀ q ∈ T, (q.1 : H) ∈ Q₀ := fun q hq =>
      Submodule.subset_span (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hq))
    set y' : TensorProduct R Q₀ C := ∑ q ∈ T.attach, (⟨(q.1.1 : H), hmem q.1 q.2⟩ : Q₀) ⊗ₜ[R] q.1.2
      with hy'def
    have hy'0 : LinearMap.rTensor C Q₀.subtype y' = 0 := by
      rw [← hy, hT, hy'def, map_sum, map_sum]
      simp only [LinearMap.rTensor_tmul, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
        Subalgebra.coe_val, Submodule.subtype_apply]
      exact Finset.sum_attach T (fun q => (q.1 : H) ⊗ₜ[R] q.2)
    have h1 := (LinearEquiv.map_eq_zero_iff (Submodule.FG.rTensor.directLimit R H C)).mp
      ((Submodule.FG.rTensor.directLimit_apply' R H C hQ₀ y').trans hy'0)
    obtain ⟨⟨Q₁, hQ₁⟩, h₀₁, hz⟩ := Module.DirectLimit.of.zero_exact h1
    obtain ⟨t, ht, htQ⟩ := Submodule.fg_def.mp hQ₁
    set S₁ : Subalgebra R H := S₀ ⊔ Algebra.adjoin R t with hS₁
    have hS₁fg : S₁.FG := hS₀.sup (Subalgebra.fg_def.mpr ⟨t, ht, rfl⟩)
    have hle : S₀ ≤ S₁ := le_sup_left
    have hQS : ∀ x ∈ Q₁, x ∈ S₁ := by
      intro x hx
      rw [← htQ] at hx
      have : Submodule.span R t ≤ Subalgebra.toSubmodule S₁ := by
        rw [Submodule.span_le]
        intro a ha
        exact (le_sup_right : Algebra.adjoin R t ≤ S₁) (Algebra.subset_adjoin ha)
      exact this hx
    let ι₁ : Q₁ →ₗ[R] S₁ :=
      { toFun := fun x => ⟨x, hQS x x.2⟩
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
    refine ⟨S₁, hS₁fg, hle, ?_⟩
    have e1 : LinearMap.rTensor C ι₁ (LinearMap.rTensor C (Submodule.inclusion h₀₁) y') =
        Algebra.TensorProduct.map (Subalgebra.inclusion hle) (AlgHom.id R C) y := by
      rw [hT, hy'def, map_sum, map_sum, map_sum]
      simp only [LinearMap.rTensor_tmul, Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
      rw [← Finset.sum_attach T]
      rfl
    rw [← e1]
    have hz' : LinearMap.rTensor C (Submodule.inclusion h₀₁) y' = 0 := hz
    rw [hz', map_zero]

  have s5 : ∀ (A E : Type u) [CommRing A] [CommRing E] [Algebra R A] [Algebra R E]
      (f : A →ₐ[R] E) (w : TensorProduct R A C) (p : Polynomial A), p.Monic →
      Algebra.TensorProduct.map f (AlgHom.id R C) (Polynomial.aeval w p) = 0 →
      IsIntegral E (Algebra.TensorProduct.map f (AlgHom.id R C) w) := by
    intro A E _ _ _ _ f w p hp h
    refine ⟨p.map (f : A →+* E), hp.map _, ?_⟩
    rw [← Polynomial.aeval_def, ← hnat, h]

  have s6 : ∀ (E : Type u) [CommRing E] [Algebra R E] [Algebra.Etale R E] (β : E →ₐ[R] H)
      (x : TensorProduct R E C), IsIntegral E x →
      ∃ y : TensorProduct R H (integralClosure R C),
        Algebra.TensorProduct.map (AlgHom.id H H) (integralClosure R C).val y =
          Algebra.TensorProduct.map β (AlgHom.id R C) x := by
    intro E _ _ _ β x hx
    obtain ⟨u, hu⟩ := (TensorProduct.toIntegralClosure_bijective_of_smooth (R := R) (S := E)
      (B := C)).2 ⟨x, (mem_integralClosure_iff _ _).mpr hx⟩
    have hu' : Algebra.TensorProduct.map (AlgHom.id E E) (integralClosure R C).val u = x :=
      congrArg Subtype.val hu
    have nat : ∀ v : TensorProduct R E (integralClosure R C),
        Algebra.TensorProduct.map (AlgHom.id H H) (integralClosure R C).val
          (Algebra.TensorProduct.map β (AlgHom.id R (integralClosure R C)) v) =
        Algebra.TensorProduct.map β (AlgHom.id R C)
          (Algebra.TensorProduct.map (AlgHom.id E E) (integralClosure R C).val v) := by
      intro v
      induction v using TensorProduct.induction_on with
      | zero => simp only [map_zero]
      | tmul a b => simp only [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
      | add a b ha hb => simp only [map_add, ha, hb]
    exact ⟨_, (nat u).trans (by rw [hu'])⟩
  have hinj : Function.Injective (TensorProduct.toIntegralClosure R H C) :=
    TensorProduct.toIntegralClosure_injective_of_flat
  have hsurj : Function.Surjective (TensorProduct.toIntegralClosure R H C) := by
    rintro ⟨z, hz⟩
    have hzi : IsIntegral H z := (mem_integralClosure_iff _ _).mp hz
    obtain ⟨S₀, hS₀, z₀, p₀, hmon, hz₀, hv⟩ := s3 z hzi
    obtain ⟨S₁, hS₁, hle, hv₁⟩ := s4 S₀ hS₀ _ hv
    haveI : Algebra.FinitePresentation R S₁ :=
      Algebra.FinitePresentation.of_finiteType.mp ((Subalgebra.fg_iff_finiteType S₁).mp hS₁)
    obtain ⟨E, _, _, hE, α, β, hαβ⟩ := hind' S₁ S₁.val
    set f : S₀ →ₐ[R] E := α.comp (Subalgebra.inclusion hle) with hfdef
    have hf0 : Algebra.TensorProduct.map f (AlgHom.id R C) (Polynomial.aeval z₀ p₀) = 0 := by
      have : Algebra.TensorProduct.map f (AlgHom.id R C) =
          (Algebra.TensorProduct.map α (AlgHom.id R C)).comp
            (Algebra.TensorProduct.map (Subalgebra.inclusion hle) (AlgHom.id R C)) := by
        rw [← Algebra.TensorProduct.map_comp, AlgHom.id_comp]
      rw [this, AlgHom.comp_apply, hv₁, map_zero]
    have hint := s5 S₀ E f z₀ p₀ hmon hf0
    obtain ⟨y, hy⟩ := s6 E β _ hint
    refine ⟨y, Subtype.ext ?_⟩
    have hcomp : β.comp f = S₀.val := by
      rw [hfdef, ← AlgHom.comp_assoc, hαβ, Subalgebra.val_comp_inclusion]
    show Algebra.TensorProduct.map (AlgHom.id H H) (integralClosure R C).val y = z
    rw [hy, ← AlgHom.comp_apply, ← Algebra.TensorProduct.map_comp, AlgHom.id_comp, hcomp, hz₀]
  refine ⟨AlgEquiv.ofBijective _ ⟨hinj, hsurj⟩, fun h b => ?_⟩
  show Algebra.TensorProduct.map (AlgHom.id H H) (integralClosure R C).val (h ⊗ₜ[R] b) =
    h ⊗ₜ[R] (b : C)
  rw [Algebra.TensorProduct.map_tmul]
  rfl

theorem wc_pas_codim_one_descent : (∀ (V : Type u) [CommRing V] [IsDomain V] [IsDiscreteValuationRing V] [HenselianLocalRing V] [IsSepClosed (IsLocalRing.ResidueField V)] (ϖ : V), Irreducible ϖ → ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : V) → ∀ (F : Type u) [CommRing F] [Algebra V F] [Algebra (Localization.Away ϖ) F] [IsScalarTower V (Localization.Away ϖ) F] [Algebra.Etale (Localization.Away ϖ) F] [Module.Finite (Localization.Away ϖ) F], (∀ (H' : Type u) [CommRing H'] [HenselianLocalRing H'] [IsSepClosed (IsLocalRing.ResidueField H')] (hh : V →+* H'), @Algebra.WeaklyEtale V H' _ _ hh.toAlgebra → (IsLocalRing.maximalIdeal H').comap hh = Ideal.span {ϖ} → ∀ (Ω : Type u) [Field Ω] [IsSepClosed Ω] (j : H' →+* Ω), @Algebra.WeaklyEtale H' Ω _ _ j.toAlgebra → ∀ σ : Ω →+* Ω, (∀ a, σ (j a) = j a) → ∀ χ : F →+* Ω, χ.comp (algebraMap V F) = j.comp hh → ∃ m : ℕ, (σ ^ (ℓ ^ m)).comp χ = χ) → ∃ k : ℕ, Algebra.Etale (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ϖ)) (integralClosure (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ϖ)) (TensorProduct V (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C ϖ)) F))) → ∀ (H : Type u) [CommRing H] [HenselianLocalRing H] [IsSepClosed (IsLocalRing.ResidueField H)] [IsRegularLocalRing H] [IsDomain H] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : H) → ∀ (φ : H), φ ∈ IsLocalRing.maximalIdeal H → φ ∉ IsLocalRing.maximalIdeal H ^ 2 → ∀ (D : Type u) [CommRing D] [Algebra H D] [Algebra (Localization.Away φ) D] [IsScalarTower H (Localization.Away φ) D] [Algebra.Etale (Localization.Away φ) D] [Module.Finite (Localization.Away φ) D], (∀ (H' : Type u) [CommRing H'] [HenselianLocalRing H'] [IsSepClosed (IsLocalRing.ResidueField H')] (hh : H →+* H'), @Algebra.WeaklyEtale H H' _ _ hh.toAlgebra → (IsLocalRing.maximalIdeal H').comap hh = Ideal.span {φ} → ∀ (Ω : Type u) [Field Ω] [IsSepClosed Ω] (j : H' →+* Ω), @Algebra.WeaklyEtale H' Ω _ _ j.toAlgebra → ∀ σ : Ω →+* Ω, (∀ a, σ (j a) = j a) → ∀ χ : D →+* Ω, χ.comp (algebraMap H D) = j.comp hh → ∃ m : ℕ, (σ ^ (ℓ ^ m)).comp χ = χ) → ∃ N : ℕ, (∃ k : ℕ, N = ℓ ^ k) ∧ ∀ [(Ideal.span {AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C φ : Polynomial H)}).IsPrime], Algebra.Etale (Localization.AtPrime (Ideal.span {AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C φ : Polynomial H)})) (TensorProduct (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ : Polynomial H)) (Localization.AtPrime (Ideal.span {AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C φ : Polynomial H)})) (integralClosure (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ : Polynomial H)) (TensorProduct H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ : Polynomial H)) D))) :=
by
  intro C3A H _ _ _ _ _ ℓ _ hℓ φ hφm hφm2 D _ _ _ _ _ _ hT
  classical
  have dev_aux : ∀ (R₀ : Type u) [CommRing R₀] (b : R₀) (N : ℕ) (hN : 0 < N),
      (∀ x : AdjoinRoot (Polynomial.X ^ N - Polynomial.C b), ∃ r : R₀,
      x - AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C b) r ∈
        Ideal.span {AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C b)}) ∧
    (∀ r : R₀, AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C b) r ∈
        Ideal.span {AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C b)} ↔ r ∈ Ideal.span {b}) := by
    intro R₀ _ b N hN
    constructor
    · intro x
      obtain ⟨g, rfl⟩ := AdjoinRoot.mk_surjective x
      obtain ⟨h, hh⟩ := (Polynomial.X_dvd_sub_C : Polynomial.X ∣ g - Polynomial.C (g.coeff 0))
      refine ⟨g.coeff 0, ?_⟩
      rw [Ideal.mem_span_singleton']
      refine ⟨AdjoinRoot.mk _ h, ?_⟩
      rw [← AdjoinRoot.mk_C, ← map_sub, hh, map_mul, AdjoinRoot.mk_X, mul_comm]
    · intro r
      have hroot : AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C b) ^ N =
          AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C b) b := by
        have h0 := AdjoinRoot.mk_self (f := Polynomial.X ^ N - Polynomial.C b)
        rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h0
        exact h0
      constructor
      · intro hr
        rw [Ideal.mem_span_singleton'] at hr
        obtain ⟨a, ha⟩ := hr
        obtain ⟨h, rfl⟩ := AdjoinRoot.mk_surjective a
        have h1 : AdjoinRoot.mk (Polynomial.X ^ N - Polynomial.C b)
            (Polynomial.C r - h * Polynomial.X) = 0 := by
          rw [map_sub, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C, ha, sub_self]
        rw [AdjoinRoot.mk_eq_zero] at h1
        obtain ⟨w, hw⟩ := h1
        have h2 := congrArg (fun P => Polynomial.coeff P 0) hw
        simp only [Polynomial.coeff_sub, Polynomial.coeff_C_zero, Polynomial.mul_coeff_zero,
          Polynomial.coeff_X_zero, mul_zero, sub_zero, Polynomial.coeff_X_pow,
          if_neg (Nat.pos_iff_ne_zero.mp hN).symm, zero_sub] at h2
        rw [Ideal.mem_span_singleton']
        exact ⟨-(w.coeff 0), by rw [h2]; ring⟩
      · intro hr
        rw [Ideal.mem_span_singleton'] at hr
        obtain ⟨a, rfl⟩ := hr
        rw [Ideal.mem_span_singleton']
        refine ⟨AdjoinRoot.of _ a * AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C b) ^ (N - 1), ?_⟩
        rw [map_mul, ← hroot, mul_assoc, ← pow_succ, Nat.sub_add_cancel hN]
  have dev_L4 : ∀ (R S : Type u) [CommRing R] [CommRing S] (σ : R →+* S) (a : R) (N : ℕ) (hN : 0 < N)
    (τ : AdjoinRoot (Polynomial.X ^ N - Polynomial.C a) →+* AdjoinRoot (Polynomial.X ^ N - Polynomial.C (σ a)))
    (hτof : τ.comp (AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C a)) = (AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C (σ a))).comp σ)
    (hτroot : τ (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C a)) = AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C (σ a)))
    (hc : (Ideal.span {σ a}).comap σ = Ideal.span {a}) (hp : (Ideal.span {σ a}).IsPrime),
      (Ideal.span {AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C (σ a))}).IsPrime ∧
    (Ideal.span {AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C (σ a))}).comap τ =
      Ideal.span {AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C a)} := by
    intro R S _ _ σ a N hN τ hτof hτroot hc hp
    obtain ⟨hSi, hSii⟩ := dev_aux S (σ a) N hN
    obtain ⟨hRi, hRii⟩ := dev_aux R a N hN
    constructor
    · refine ⟨?_, ?_⟩
      · rw [Ne, Ideal.eq_top_iff_one]
        intro h1
        rw [← map_one (AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C (σ a))), hSii] at h1
        exact hp.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
      · intro x y hxy
        obtain ⟨r, hr⟩ := hSi x
        obtain ⟨s, hs⟩ := hSi y
        have h1 : AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C (σ a)) (r * s) ∈
            Ideal.span {AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C (σ a))} := by
          have e : AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C (σ a)) (r * s) =
              x * y - ((x - AdjoinRoot.of _ r) * y + AdjoinRoot.of _ r * (y - AdjoinRoot.of _ s)) := by
            rw [map_mul]; ring
