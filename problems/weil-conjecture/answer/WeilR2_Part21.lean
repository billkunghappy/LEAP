  haveI hprop : IsProper (Over.mk (wcProjKStr F'' M')).hom := wc_proj_space_isProper F'' M'
  haveI hLFTf : LocallyOfFiniteType (Over.mk (wcProjKStr F'' M')).hom := inferInstance
  haveI hQCf : QuasiCompact (Over.mk (wcProjKStr F'' M')).hom := inferInstance
  haveI hLFT : LocallyOfFiniteType (Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
      (IsPullback.of_hasPullback (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hLFTf
  haveI hQC : QuasiCompact (Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
