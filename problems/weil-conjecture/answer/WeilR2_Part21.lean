        (Functor.whiskeringLeft Cᵒᵖ Dᵒᵖ AddCommGrpCat.{u+1}).obj bc.op ⋙
          presheafToSheaf J AddCommGrpCat.{u+1})
      (V : C) (F F' : Sheaf J AddCommGrpCat.{u+1}) (α : F.over V ≅ F'.over V),
