    ((Xu.hom.appLE ⊤ V le_top).hom.comp (Scheme.ΓSpecIso (.of F'')).inv.hom).toAlgebra
  letI : (RingHom.ker e).IsPrime := RingHom.ker_isPrime e
  obtain ⟨τ, hτ⟩ := wc_pfam_mc_stalk_loc_iso Xu.left V hV _ hx (RingHom.ker e) he3
  have hdimO : ringKrullDim (Localization.AtPrime (RingHom.ker e)) =
