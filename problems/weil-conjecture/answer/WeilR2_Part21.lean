      congrArg (fun f => f.hom x) ((L.obj F).obj.map_id (op (bc.obj V)))
    have hm' : ∀ x : (L.obj F').obj.obj (op (bc.obj V)),
        (((L.obj F').over (bc.obj V)).obj.map ι.op).hom x = x := fun x =>
      congrArg (fun f => f.hom x) ((L.obj F').obj.map_id (op (bc.obj V)))
    have nb := congrArg (fun f => f.hom y) (β.hom.hom.naturality ι.op)
    have e2 : (β.hom.hom.app (op (Over.mk (𝟙 (bc.obj V))))).hom y =
        (β.hom.hom.app (op ((Over.post bc).obj (Over.mk (𝟙 V))))).hom y :=
      (congrArg (β.hom.hom.app (op (Over.mk (𝟙 (bc.obj V))))).hom (hm y)).symm.trans
        (nb.trans (hm' _))
    have hy' : y = (uF.app (op V)).hom s := by
      haveI := tSiso (L.obj F)
      apply injOfIso ((toSheafify J (bc.op ⋙ (L.obj F).obj)).app (op V))
      rw [hy, hu1]
    exact (congrArg ((toSheafify J (bc.op ⋙ (L.obj F').obj)).app (op V)).hom
      (e2.trans ((congrArg (β.hom.hom.app (op ((Over.post bc).obj (Over.mk (𝟙 V))))).hom hy').trans
        e1))).trans (hu1' _)
  haveI hcont : (wcProEtBaseChange i).IsContinuous (Scheme.ProEt.topology X)
      (Scheme.ProEt.topology B) := (wc_proet_pullback_continuous_flat i).1
  haveI hflat : RepresentablyFlat (wcProEtBaseChange i) := (wc_proet_pullback_continuous_flat i).2
  haveI := preservesFiniteLimits_of_flat (wcProEtBaseChange i)
  exact gen (Scheme.ProEt.topology X) (Scheme.ProEt.topology B) (wcProEtBaseChange i) L adj V F F' α

theorem wc_profinite_universal_unique : ∀ (S : Scheme.{u}) (K : Type) [TopologicalSpace K]
    [CompactSpace K] [T2Space K] [TotallyDisconnectedSpace K],
    ∃ (P : Scheme.{u}) (p : P ⟶ S) (_ : WeaklyEtale p) (π : C(↥P, K)),
      ∀ (T : Scheme.{u}) (t : T ⟶ S) (c : C(↥T, K)),
        ∃! h : T ⟶ P, h ≫ p = t ∧ π.comp h.base.hom = c :=
by
  intro S K _ _ _ _
  classical
  have sep : ∀ a b : K, (∀ U : Set K, IsClopen U → (a ∈ U ↔ b ∈ U)) → a = b := by
    intro a b h
    by_contra hab
    obtain ⟨U, hU, haU, hbU⟩ := exists_isClopen_of_totally_separated hab
    exact hbU ((h U hU).mp haU)
  have s5 : ∀ (T : Scheme.{u}) (R : CommRingCat.{u}) (ψ : R ⟶ Γ(T, ⊤)) (a : R) (x : ↥T),
      (T.toSpecΓ ≫ Spec.map ψ).base x ∈ PrimeSpectrum.basicOpen a ↔
        x ∈ T.basicOpen (ψ a) := by
    intro T R ψ a x
    rw [← Scheme.toSpecΓ_preimage_basicOpen]
    exact Iff.rfl
  obtain ⟨ι, hιW⟩ : ∃ ι : Spec (CommRingCat.of (LocallyConstant K (ULift.{u} ℤ))) ⟶
      Spec (CommRingCat.of (ULift.{u} ℤ)), WeaklyEtale ι :=
    ⟨_, wc_lc_spec_weaklyEtale.{u} K⟩
  obtain ⟨π0, hπ0⟩ := wc_lc_spec_pi0.{u} K
  obtain ⟨P, p, q, hpb⟩ : ∃ (P : Scheme.{u}) (p : P ⟶ S)
      (q : P ⟶ Spec (CommRingCat.of (LocallyConstant K (ULift.{u} ℤ)))),
      IsPullback p q (specULiftZIsTerminal.from S) ι :=
    ⟨_, _, _, IsPullback.of_hasPullback _ _⟩
  have hp : WeaklyEtale p := MorphismProperty.of_isPullback (P := @WeaklyEtale) hpb.flip hιW
  refine ⟨P, p, hp, π0.comp q.base.hom, ?_⟩
  intro T t c
  obtain ⟨θ, -, hθ⟩ := wc_scheme_lc_to_global T
  let ψ : LocallyConstant K (ULift.{u} ℤ) →+* Γ(T, ⊤) :=
    θ.comp (LocallyConstant.comapRingHom c)
  obtain ⟨h0, hh0⟩ : ∃ h0 : T ⟶ Spec (CommRingCat.of (LocallyConstant K (ULift.{u} ℤ))),
      h0 = T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ) := ⟨_, rfl⟩
  have hclaim : ∀ x, π0 (h0.base x) = c x := by
    intro x
    apply sep
    intro U hU
    refine (hπ0 U hU (h0.base x)).trans ?_
    rw [hh0]
    refine (s5 T _ (CommRingCat.ofHom ψ) (LocallyConstant.charFn _ hU) x).trans ?_
    have he : LocallyConstant.comap c (LocallyConstant.charFn (ULift.{u} ℤ) hU) =
        LocallyConstant.charFn (ULift.{u} ℤ) (hU.preimage c.continuous) := by
      ext y
      simp [LocallyConstant.coe_charFn, Set.indicator_apply]
    have hψ : (CommRingCat.ofHom ψ) (LocallyConstant.charFn (ULift.{u} ℤ) hU) =
        θ (LocallyConstant.charFn (ULift.{u} ℤ) (hU.preimage c.continuous)) := by
      rw [← he]
      rfl
    rw [hψ, hθ]
    exact Iff.rfl
  obtain ⟨h, hhp, hhq⟩ : ∃ h : T ⟶ P, h ≫ p = t ∧ h ≫ q = h0 :=
    ⟨hpb.lift t h0 (specULiftZIsTerminal.hom_ext _ _), hpb.lift_fst _ _ _, hpb.lift_snd _ _ _⟩
  refine ⟨h, ⟨hhp, ?_⟩, ?_⟩
  · apply ContinuousMap.ext
    intro x
    have e1 : (h ≫ q).base x = h0.base x := by rw [hhq]
    rw [← hclaim x]
    exact congrArg π0 e1
  · rintro h' ⟨hp', hc'⟩
    apply hpb.hom_ext
    · rw [hp', hhp]
    · rw [hhq]
      apply wc_lc_spec_hom_ext K T
      intro U hU x
      have hx : π0 ((h' ≫ q).base x) = c x := by
        have := congrArg (fun f : C(↥T, K) => f x) hc'
        exact this
      refine (hπ0 U hU ((h' ≫ q).base x)).symm.trans ?_
      rw [hx, ← hclaim x]
      exact hπ0 U hU (h0.base x)

theorem wc_proet_univ_obj_bc {X B : Scheme.{u}} (i : B ⟶ X) (K : Type) [TopologicalSpace K]
    (P : Scheme.{u}) (p : P ⟶ X) (hp : WeaklyEtale p) (π : C(↥P, K))
    (H : ∀ (T : Scheme.{u}) (t : T ⟶ X) (c : C(↥T, K)),
      ∃! h : T ⟶ P, h ≫ p = t ∧ π.comp h.base.hom = c) :
    (∀ (W : X.ProEt) (c : C(↥W.left, K)),
      ∃! k : W ⟶ (MorphismProperty.Over.mk ⊤ p hp : X.ProEt),
        ∀ t : ↥W.left, π (k.left.base t) = c t) ∧
    (∀ (W : B.ProEt) (c : C(↥W.left, K)),
      ∃! k : W ⟶ (wcProEtBaseChange i).obj (MorphismProperty.Over.mk ⊤ p hp : X.ProEt),
        ∀ t : ↥W.left, π ((Limits.pullback.fst p i).base (k.left.base t)) = c t) :=
by
  refine ⟨fun W c => ?_, fun W c => ?_⟩
  · obtain ⟨h, ⟨h1, h2⟩, huniq⟩ := H W.left W.hom c
    refine ⟨MorphismProperty.Over.homMk h h1 trivial, fun t => ?_, fun k' hk' => ?_⟩
    · show π (h.base t) = c t
      exact DFunLike.congr_fun h2 t
    · apply MorphismProperty.Over.Hom.ext
      show k'.left = h
      apply huniq
      refine ⟨MorphismProperty.Over.w k', ?_⟩
      exact ContinuousMap.ext fun t => hk' t
  · obtain ⟨h, ⟨h1, h2⟩, huniq⟩ := H W.left (W.hom ≫ i) c
    have hsnd : ∀ k' : W ⟶ (wcProEtBaseChange i).obj (MorphismProperty.Over.mk ⊤ p hp : X.ProEt),
        k'.left ≫ Limits.pullback.snd p i = W.hom := fun k' => MorphismProperty.Over.w k'
    have e : Limits.pullback.lift h W.hom h1 ≫ Limits.pullback.fst p i = h :=
      Limits.pullback.lift_fst _ _ _
    refine ⟨MorphismProperty.Over.homMk
      (Limits.pullback.lift h W.hom h1 : W.left ⟶ Limits.pullback p i)
      (Limits.pullback.lift_snd _ _ _) trivial, fun t => ?_, fun k' hk' => ?_⟩
    · have e2 : (Limits.pullback.fst p i).base ((Limits.pullback.lift h W.hom h1).base t) =
          h.base t := congrArg (fun f : W.left ⟶ P => f.base t) e
      show π ((Limits.pullback.fst p i).base ((Limits.pullback.lift h W.hom h1).base t)) = c t
      rw [e2]
      exact DFunLike.congr_fun h2 t
    · apply MorphismProperty.Over.Hom.ext
      have aux : ∀ g : W.left ⟶ Limits.pullback p i, g ≫ Limits.pullback.snd p i = W.hom →
          (∀ t : ↥W.left, π ((Limits.pullback.fst p i).base (g.base t)) = c t) →
          g = Limits.pullback.lift h W.hom h1 := by
        intro g hg hgt
        have hc : (g ≫ Limits.pullback.fst p i) ≫ p = W.hom ≫ i := by
          rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hg]
        have hh' : g ≫ Limits.pullback.fst p i = h :=
          huniq _ ⟨hc, ContinuousMap.ext fun t => hgt t⟩
        apply Limits.pullback.hom_ext
        · rw [hh', Limits.pullback.lift_fst]
        · rw [hg, Limits.pullback.lift_snd]
      exact aux k'.left (hsnd k') hk'

theorem wc_presheaf_corep_transfer_bijective {C : Type*} [Category C] {D : Type*} [Category D]
    (F G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (F' E : Dᵒᵖ ⥤ AddCommGrpCat.{u+1})
    (Q Q₂ : C) (ρ : F.obj (Opposite.op Q)) (a₁ a₂ aₘ : Q₂ ⟶ Q)
    (Q' Q₂' : D) (ρ' : F'.obj (Opposite.op Q')) (a₁' a₂' aₘ' : Q₂' ⟶ Q')
    (hU : ∀ (W : C) (c : F.obj (Opposite.op W)), ∃! k : W ⟶ Q, (F.map k.op).hom ρ = c)
    (hA : (F.map aₘ.op).hom ρ = (F.map a₁.op).hom ρ + (F.map a₂.op).hom ρ)
    (hU' : ∀ (W : D) (c : F'.obj (Opposite.op W)), ∃! k : W ⟶ Q', (F'.map k.op).hom ρ' = c)
    (hA' : (F'.map aₘ'.op).hom ρ' = (F'.map a₁'.op).hom ρ' + (F'.map a₂'.op).hom ρ')
    (hP' : ∀ (W : D) (c c' : F'.obj (Opposite.op W)), ∃ k : W ⟶ Q₂',
      (F'.map (k ≫ a₁').op).hom ρ' = c ∧ (F'.map (k ≫ a₂').op).hom ρ' = c')
    (τ : E.obj (Opposite.op Q') ⟶ G.obj (Opposite.op Q)) (hτ : Function.Bijective τ.hom)
    (τ₂ : E.obj (Opposite.op Q₂') ⟶ G.obj (Opposite.op Q₂)) (hτ₂ : Function.Injective τ₂.hom)
    (h₁ : ∀ e, (G.map a₁.op).hom (τ.hom e) = τ₂.hom ((E.map a₁'.op).hom e))
    (h₂ : ∀ e, (G.map a₂.op).hom (τ.hom e) = τ₂.hom ((E.map a₂'.op).hom e))
    (hₘ : ∀ e, (G.map aₘ.op).hom (τ.hom e) = τ₂.hom ((E.map aₘ'.op).hom e))
    (Θ : (F' ⟶ E) → (F ⟶ G))
    (hΘ : ∀ x : F' ⟶ E, ((Θ x).app (Opposite.op Q)).hom ρ = τ.hom ((x.app (Opposite.op Q')).hom ρ')) :
    Function.Bijective Θ :=
by

  have compD : ∀ (P : Dᵒᵖ ⥤ AddCommGrpCat.{u+1}) {W V V' : D} (k : W ⟶ V) (a : V ⟶ V')
      (z : P.obj (Opposite.op V')),
      (P.map (k ≫ a).op).hom z = (P.map k.op).hom ((P.map a.op).hom z) := by
    intro P W V V' k a z
    rw [op_comp, CategoryTheory.Functor.map_comp]
    rfl

  have natC : ∀ (x : F ⟶ G) {W V : C} (k : W ⟶ V) (z : F.obj (Opposite.op V)),
      (x.app (Opposite.op W)).hom ((F.map k.op).hom z) = (G.map k.op).hom ((x.app (Opposite.op V)).hom z) := by
    intro x W V k z
    exact congrArg (fun f => f.hom z) (x.naturality k.op)
  have natD : ∀ (x : F' ⟶ E) {W V : D} (k : W ⟶ V) (z : F'.obj (Opposite.op V)),
      (x.app (Opposite.op W)).hom ((F'.map k.op).hom z) = (E.map k.op).hom ((x.app (Opposite.op V)).hom z) := by
    intro x W V k z
    exact congrArg (fun f => f.hom z) (x.naturality k.op)

  have extC : ∀ x y : F ⟶ G, (x.app (Opposite.op Q)).hom ρ = (y.app (Opposite.op Q)).hom ρ → x = y := by
    intro x y h
    ext X c
    obtain ⟨k, hk, -⟩ := hU X.unop c
    have e1 := natC x k ρ
    have e2 := natC y k ρ
    rw [hk] at e1 e2
    exact e1.trans ((congrArg _ h).trans e2.symm)
  have extD : ∀ x y : F' ⟶ E, (x.app (Opposite.op Q')).hom ρ' = (y.app (Opposite.op Q')).hom ρ' → x = y := by
    intro x y h
    ext X c
    obtain ⟨k, hk, -⟩ := hU' X.unop c
    have e1 := natD x k ρ'
    have e2 := natD y k ρ'
    rw [hk] at e1 e2
    exact e1.trans ((congrArg _ h).trans e2.symm)

  have extend : ∀ e : E.obj (Opposite.op Q'),
      (E.map aₘ'.op).hom e = (E.map a₁'.op).hom e + (E.map a₂'.op).hom e →
      ∃ x : F' ⟶ E, (x.app (Opposite.op Q')).hom ρ' = e := by
    intro e he
    let κ : ∀ (W : D), F'.obj (Opposite.op W) → (W ⟶ Q') := fun W c => (hU' W c).exists.choose
    have hκ : ∀ W c, (F'.map (κ W c).op).hom ρ' = c := fun W c => (hU' W c).exists.choose_spec
    have hκu : ∀ W c (k : W ⟶ Q'), (F'.map k.op).hom ρ' = c → k = κ W c :=
      fun W c k hk => (hU' W c).unique hk (hκ W c)
    have hadd : ∀ (W : D) (c c' : F'.obj (Opposite.op W)),
        (E.map (κ W (c + c')).op).hom e =
          (E.map (κ W c).op).hom e + (E.map (κ W c').op).hom e := by
      intro W c c'
      obtain ⟨k, hk1, hk2⟩ := hP' W c c'
      have hkm : (F'.map (k ≫ aₘ').op).hom ρ' = c + c' := by
        rw [compD, hA', map_add, ← compD, ← compD, hk1, hk2]
      rw [← hκu W _ _ hkm, ← hκu W _ _ hk1, ← hκu W _ _ hk2, compD, compD, compD, he, map_add]
    let x : F' ⟶ E :=
      { app := fun X => AddCommGrpCat.ofHom
          (AddMonoidHom.mk' (fun c => (E.map (κ X.unop c).op).hom e) (hadd X.unop))
        naturality := by
          intro X Y f
          ext c
          show (E.map (κ Y.unop ((F'.map f).hom c)).op).hom e =
            (E.map f).hom ((E.map (κ X.unop c).op).hom e)
          have hk : κ Y.unop ((F'.map f).hom c) = f.unop ≫ κ X.unop c := by
            symm
            apply hκu
            rw [compD, hκ]
            rfl
          rw [hk, compD]
          rfl }
    refine ⟨x, ?_⟩
    show (E.map (κ Q' ρ').op).hom e = e
    have h1 : κ Q' ρ' = 𝟙 Q' := by
      symm
      apply hκu
      rw [op_id, CategoryTheory.Functor.map_id]
      rfl
    rw [h1, op_id, CategoryTheory.Functor.map_id]
    rfl
  refine ⟨?_, ?_⟩
  ·
    intro x y hxy
    apply extD
    apply hτ.1
    rw [← hΘ x, ← hΘ y, hxy]
  ·
    intro g
    obtain ⟨e, he⟩ := hτ.2 ((g.app (Opposite.op Q)).hom ρ)
    have hadd : (E.map aₘ'.op).hom e = (E.map a₁'.op).hom e + (E.map a₂'.op).hom e := by
      apply hτ₂
      rw [map_add, ← hₘ, ← h₁, ← h₂, he, ← natC, ← natC, ← natC, hA, map_add]
    obtain ⟨x, hx⟩ := extend e hadd
    refine ⟨x, extC _ _ ?_⟩
    rw [hΘ, hx, he]

theorem wc_proet_contPull_adj_iso_profinite {X B : Scheme.{u}} (i : B ⟶ X)
    (L : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1})
    (adj : L ⊣ wcProEtPush i)
    (M : Type) [AddCommGroup M] [TopologicalSpace M] [IsTopologicalAddGroup M]
    [CompactSpace M] [T2Space M] [TotallyDisconnectedSpace M] :
    IsIso ((adj.homEquiv (wcContSheaf X M) (wcContSheaf B M)).symm (wcContPull i M)) :=
by
  classical
  haveI hcont : (wcProEtBaseChange i).IsContinuous (Scheme.ProEt.topology X)
      (Scheme.ProEt.topology B) := (wc_proet_pullback_continuous_flat i).1
  set a := (adj.homEquiv (wcContSheaf X M) (wcContSheaf B M)).symm (wcContPull i M) with ha

  obtain ⟨P, p, hp, π, H⟩ := wc_profinite_universal_unique X M
  obtain ⟨UX, UB⟩ := wc_proet_univ_obj_bc i M P p hp π H
  obtain ⟨P₂, p₂, hp₂, π₂, H₂⟩ := wc_profinite_universal_unique X (M × M)
  obtain ⟨-, UB₂⟩ := wc_proet_univ_obj_bc i (M × M) P₂ p₂ hp₂ π₂ H₂
  set Q : X.ProEt := MorphismProperty.Over.mk ⊤ p hp with hQ
  set Q₂ : X.ProEt := MorphismProperty.Over.mk ⊤ p₂ hp₂ with hQ₂

  obtain ⟨a₁, ha₁, -⟩ := UX Q₂ (ContinuousMap.comp ContinuousMap.fst π₂)
  obtain ⟨a₂, ha₂, -⟩ := UX Q₂ (ContinuousMap.comp ContinuousMap.snd π₂)
  obtain ⟨aₘ, haₘ, -⟩ := UX Q₂
    (ContinuousMap.comp (ContinuousMap.fst + ContinuousMap.snd : C(M × M, M)) π₂)

  let ρ : (wcContSheaf X M).obj.obj (Opposite.op Q) := (ULift.up π : ULift.{u+1} C(↥P, M))
  let ρ' : (wcContSheaf B M).obj.obj (Opposite.op ((wcProEtBaseChange i).obj Q)) :=
    (ULift.up (π.comp (Limits.pullback.fst p i).base.hom) :
      ULift.{u+1} C(↥(Limits.pullback p i), M))
  have hfst : ∀ (a' : Q₂ ⟶ Q) (t : ↥((wcProEtBaseChange i).obj Q₂).left),
      (Limits.pullback.fst p i).base (((wcProEtBaseChange i).map a').left.base t) =
        a'.left.base ((Limits.pullback.fst p₂ i).base t) := by
    intro a' t
    have h : ((wcProEtBaseChange i).map a').left ≫ Limits.pullback.fst p i =
        Limits.pullback.fst p₂ i ≫ a'.left := Limits.pullback.lift_fst _ _ _
    exact congrArg (fun f : ((wcProEtBaseChange i).obj Q₂).left ⟶ P => f.base t) h

  have hU : ∀ (W : X.ProEt) (c : (wcContSheaf X M).obj.obj (Opposite.op W)),
      ∃! k : W ⟶ Q, ((wcContSheaf X M).obj.map k.op).hom ρ = c := by
    intro W c
    obtain ⟨k, hk, huniq⟩ := UX W (show ULift.{u+1} C(↥W.left, M) from c).down
    refine ⟨k, ?_, fun k' hk' => huniq k' ?_⟩
    · exact ULift.ext_iff.mpr (ContinuousMap.ext fun t => hk t)
    · intro t
      have h2 : (show ULift.{u+1} C(↥W.left, M) from ((wcContSheaf X M).obj.map k'.op).hom ρ) =
          (show ULift.{u+1} C(↥W.left, M) from c) := hk'
      exact congrArg (fun f : ULift.{u+1} C(↥W.left, M) => f.down t) h2
  have hU' : ∀ (W : B.ProEt) (c : (wcContSheaf B M).obj.obj (Opposite.op W)),
      ∃! k : W ⟶ (wcProEtBaseChange i).obj Q, ((wcContSheaf B M).obj.map k.op).hom ρ' = c := by
    intro W c
    obtain ⟨k, hk, huniq⟩ := UB W (show ULift.{u+1} C(↥W.left, M) from c).down
    refine ⟨k, ?_, fun k' hk' => huniq k' ?_⟩
    · exact ULift.ext_iff.mpr (ContinuousMap.ext fun t => hk t)
    · intro t
      have h2 : (show ULift.{u+1} C(↥W.left, M) from ((wcContSheaf B M).obj.map k'.op).hom ρ') =
          (show ULift.{u+1} C(↥W.left, M) from c) := hk'
      exact congrArg (fun f : ULift.{u+1} C(↥W.left, M) => f.down t) h2

  have hA : ((wcContSheaf X M).obj.map aₘ.op).hom ρ =
      ((wcContSheaf X M).obj.map a₁.op).hom ρ + ((wcContSheaf X M).obj.map a₂.op).hom ρ := by
    refine ULift.ext_iff.mpr (ContinuousMap.ext fun t => ?_)
    show π (aₘ.left.base t) = π (a₁.left.base t) + π (a₂.left.base t)
    rw [haₘ t, ha₁ t, ha₂ t]
    rfl

  have hA' : ((wcContSheaf B M).obj.map ((wcProEtBaseChange i).map aₘ).op).hom ρ' =
      ((wcContSheaf B M).obj.map ((wcProEtBaseChange i).map a₁).op).hom ρ' +
      ((wcContSheaf B M).obj.map ((wcProEtBaseChange i).map a₂).op).hom ρ' := by
    refine ULift.ext_iff.mpr (ContinuousMap.ext fun t => ?_)
    show π ((Limits.pullback.fst p i).base (((wcProEtBaseChange i).map aₘ).left.base t)) =
      π ((Limits.pullback.fst p i).base (((wcProEtBaseChange i).map a₁).left.base t)) +
      π ((Limits.pullback.fst p i).base (((wcProEtBaseChange i).map a₂).left.base t))
