    Function.Surjective ((IsLocalRing.residue (AdicCompletion (IsLocalRing.maximalIdeal
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))).comp
      (algebraMap K (AdicCompletion (IsLocalRing.maximalIdeal
