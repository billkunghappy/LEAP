  have hTy := wc_proet_free_projective_strict_local (wcProjK F'' M') Ty L eL
  obtain ⟨Φ, hΦs, hΦn⟩ := wc_proet_Rq_hm_comparison h ℓ
  obtain ⟨⟨η, hηinj, hηlin⟩, hnd⟩ :=
    wc_pfam_Ty_hm_fibre_duality F' F'' Y n hn2 D ℓ hℓ M' Xu h Δ lam p hH Ty L eL
  have hodd : Odd (n - 1) := by
    obtain ⟨k, hk⟩ := hn
