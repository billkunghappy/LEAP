      intro Q
      refine ⟨fun x₁ x₂ h => ?_, fun k => ?_⟩
      · apply (hM Q).1
        simp only at h ⊢
        rw [← hk, ← hk, h]
      · obtain ⟨x, hx⟩ := (hM Q).2 (g' ≫ G'.map k)
        simp only at hx
        refine ⟨x, (hg' Q).1 ?_⟩
