    (g := Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
    (lam ((wcGeomPoint F'' (wcP1Over F'') hP1).hom (Ub₁.ι y₁)))
    (IsLocalRing.closedPoint (AlgebraicClosure F''))
    (@Subsingleton.elim (PrimeSpectrum F'') inferInstance _ _)
  have hp₀' : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom p₀ =
      lam ((wcGeomPoint F'' (wcP1Over F'') hP1).hom (Ub₁.ι y₁)) := hp₀
  have hne : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom p₀ ∉ Δ := by
    rw [hp₀']; exact hlt

  let U₀ : (wcProjK F'' M').Opens := ⟨Δᶜ, isOpen_compl_iff.mpr hΔ⟩
  let Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens :=
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom ⁻¹ᵁ U₀
  have hUb : ∀ x : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left, x ∈ Ub ↔
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom x ∉ Δ := fun x => Iff.rfl
  haveI hpr : IsProper (Over.mk (wcProjKStr F'' M')).hom := wc_proj_space_isProper F'' M'
  haveI : IsLocallyNoetherian (Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd _ _)
  haveI : CompactSpace ↥(Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd _ _)
  haveI : AlgebraicGeometry.IsNoetherian (Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    AlgebraicGeometry.IsNoetherian.mk
  haveI hN : TopologicalSpace.NoetherianSpace
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left :=
    (inferInstance : TopologicalSpace.NoetherianSpace ↥(Limits.pullback
      (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
  obtain ⟨eP, heP, -⟩ := wcpa_proj_base_change F'' (AlgebraicClosure F'') M'
  haveI := heP
  haveI := wc_proj_space_irreducible (AlgebraicClosure F'') M'
  haveI hirrP : IrreducibleSpace (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left :=
    Function.Surjective.irreducibleSpace (Scheme.Hom.homeomorph eP).symm.continuous
      (Scheme.Hom.homeomorph eP).symm.surjective
  have hirr : IsIrreducible (Ub : Set (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left) :=
    ⟨⟨p₀, (hUb p₀).2 hne⟩, (IrreducibleSpace.isIrreducible_univ _).isPreirreducible.open_subset
      Ub.isOpen (Set.subset_univ _)⟩
  haveI hNU : TopologicalSpace.NoetherianSpace Ub.toScheme :=
    TopologicalSpace.NoetherianSpace.set
      (Ub : Set (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left)
  have hconn : ConnectedSpace Ub.toScheme := isConnected_iff_connectedSpace.mp hirr.isConnected
  haveI hcpt : CompactSpace Ub.toScheme := inferInstance
  have hqs : QuasiSeparatedSpace Ub.toScheme := inferInstance
  haveI hqcι : QuasiCompact Ub.ι := quasiCompact_of_noetherianSpace_source Ub.ι
  have hu : WeaklyEtale (Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) :=
    inferInstance

  have htors : ∀ j : ℕ, ∃ (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme),
      IsFinite πE ∧ Etale πE ∧ Surjective πE ∧
      ∃ hE : WeaklyEtale (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom),
      ∃ (b' : ℕ) (e' : Fin b' → ℕ),
        Nonempty ((((wcProEtPush h).rightDerived (Nat.unpair j).1).obj
            (wcContSheaf Xu.left (ZMod (ℓ ^ (Nat.unpair j).2)))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫
              (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) hE) ≅
          (wcContSheaf (wcProjK F'' M') ((i : Fin b') → ZMod (ℓ ^ e' i))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫
              (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) hE)) := by
    intro j
    obtain ⟨N, V, v, het, hcov, hV, b, e, hiso⟩ :=
      wc_pfam_Rq_torsion_etale_locally_const F'' M' Xu.left h Δ hΔ hsm ℓ hℓ hPP Ub hUb hcpt
        (Nat.unpair j).1 (Nat.unpair j).2
    exact wc_proet_loc_const_finite_fet_trivial (wcProjK F'' M') _ ℓ Ub.toScheme
      (Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) hu hconn hcpt hqs
      N V v het hcov hV b e hiso
  choose E πE hfin het hsurj hE b' e' hθ using htors

  obtain ⟨W₀, pr, hpWE, hpqc, hpsurj, hW₀conn, hW₀cpt, hW₀qs, ht, hgal₀⟩ :=
    wc_fet_galois_tower_connected_limit Ub.toScheme hconn hcpt hqs E πE hfin het hsurj
  choose t ht using ht
  haveI := hpWE
  haveI := hpqc
  have hWE : WeaklyEtale (pr ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) :=
    inferInstance
  let W : (wcProjK F'' M').ProEt :=
    MorphismProperty.Over.mk ⊤ (pr ≫ Ub.ι ≫
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) hWE
  let w : W ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP :=
    MorphismProperty.Over.homMk (pr ≫ Ub.ι) (Category.assoc _ _ _) trivial
  let Ej : ℕ → (wcProjK F'' M').ProEt := fun j =>
    MorphismProperty.Over.mk ⊤ (πE j ≫ Ub.ι ≫
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) (hE j)
  let c : ∀ j, W ⟶ Ej j := fun j =>
    MorphismProperty.Over.homMk (t j)
      (show t j ≫ πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
          pr ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom by
        rw [← Category.assoc, ht j]) trivial

  have hres : ∀ q' k : ℕ, ∃ (b : ℕ) (e : Fin b → ℕ),
      Nonempty ((((wcProEtPush h).rightDerived q').obj
          (wcContSheaf Xu.left (ZMod (ℓ ^ k)))).over W ≅
        (wcContSheaf (wcProjK F'' M') ((j : Fin b) → ZMod (ℓ ^ e j))).over W) := by
    intro q' k
    have hh := hθ (Nat.pair q' k)
    rw [Nat.unpair_pair] at hh
    obtain ⟨θ⟩ := hh
    exact ⟨b' (Nat.pair q' k), e' (Nat.pair q' k),
      ⟨((Scheme.ProEt.topology (wcProjK F'' M')).overMapPullback AddCommGrpCat.{u+1}
        (c (Nat.pair q' k))).mapIso θ⟩⟩
  obtain ⟨a, b, e, hZ⟩ :=
    wc_proet_Rq_int_const_of_torsion_const h ℓ W hW₀conn hW₀cpt hW₀qs hres q
  obtain ⟨τ, hτ⟩ := wc_proet_Rq_rat_linear_triv h ℓ W hW₀conn hW₀cpt hW₀qs q a b e hZ

  refine ⟨⟨W, w, a, τ, fun c' => hτ c', hW₀conn, ?_, ?_, ?_⟩⟩
  · intro z
    have hy : Ub.ι (pr z) ∈ Ub := by
      have hr : Ub.ι (pr z) ∈ Set.range Ub.ι := ⟨pr z, rfl⟩
      rw [Scheme.Opens.range_ι] at hr
      exact hr
    have key := (hUb (Ub.ι (pr z))).1 hy
    exact key
  · intro x hx
    have hxU : x ∈ Ub := (hUb x).2 hx
    obtain ⟨y, hy⟩ : x ∈ Set.range Ub.ι := by rw [Scheme.Opens.range_ι]; exact hxU
    obtain ⟨z, hz⟩ := hpsurj.surj y
    refine ⟨z, ?_⟩
    show (pr ≫ Ub.ι) z = x
    rw [Scheme.Hom.comp_apply, hz, hy]
  · intro V a' b'' hV hab
    have h1 : a'.left ≫ pr ≫ Ub.ι = b''.left ≫ pr ≫ Ub.ι := by
      have := congrArg (fun f => f.left) hab
      exact this
    have h2' : (a'.left ≫ pr) ≫ Ub.ι = (b''.left ≫ pr) ≫ Ub.ι := by
      have e1 := Category.assoc a'.left pr Ub.ι
      have e2 := Category.assoc b''.left pr Ub.ι
      exact e1.trans (h1.trans e2.symm)
    have h2 : a'.left ≫ pr = b''.left ≫ pr := (cancel_mono Ub.ι).1 h2'
    obtain ⟨γ₀, hγp, hγb⟩ := hgal₀ V.left a'.left b''.left hV h2
    let γ : W ⟶ W := MorphismProperty.Over.homMk γ₀
      (show γ₀ ≫ pr ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
          pr ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom by
        rw [← Category.assoc, hγp]) trivial
    refine ⟨γ, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      show γ₀ ≫ pr ≫ Ub.ι = pr ≫ Ub.ι
      rw [← Category.assoc, hγp]
    · apply MorphismProperty.Over.Hom.ext
      show b''.left = a'.left ≫ γ₀
      exact hγb

theorem wc_pfam_line_base_point (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (π : wcPencilPL D ℓ hP)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP) :
    ∃ (T₀ : (wcP1Over F'').left.ProEt) (a₀ : T₀ ⟶ π.W) (b₀ : T₀.left ⟶ Ω.W'.left)
      (hb₀ : b₀ ≫ Ω.W'.hom = T₀.hom ≫ lam),
      ConnectedSpace T₀.left ∧
      a₀.left ≫ π.w.left ≫ Limits.pullback.snd (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        b₀ ≫ Ω.w'.left ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) :=
by
  classical


  have hfs : ∀ (X : Scheme.{u}) (x : X), WeaklyEtale (X.fromSpecStalk x) := by
    have hLoc : ∀ (A L : Type u) [CommRing A] [CommRing L] [Algebra A L] (M : Submonoid A)
        [IsLocalization M L], Algebra.WeaklyEtale A L := by
      intro A L _ _ _ M _
      haveI hc : TensorProduct.CompatibleSMul A L L L :=
        IsLocalization.tensorProduct_compatibleSMul M L L L
      have key : ∀ z : TensorProduct A L L,
          z = (Algebra.TensorProduct.lmul' A (S := L) z) ⊗ₜ[A] (1 : L) := by
        intro z
        induction z using TensorProduct.induction_on with
        | zero => rw [map_zero, TensorProduct.zero_tmul]
        | tmul a b =>
          rw [Algebra.TensorProduct.lmul'_apply_tmul]
          have h := TensorProduct.smul_tmul (R := A) b a (1 : L)
          rw [smul_eq_mul, smul_eq_mul, mul_one, mul_comm b a] at h
          exact h.symm
        | add x y hx hy =>
          rw [map_add, TensorProduct.add_tmul, ← hx, ← hy]
      have hbij : Function.Bijective (Algebra.TensorProduct.lmul' A (S := L)) := by
        refine ⟨fun z₁ z₂ h => ?_, fun c => ⟨c ⊗ₜ[A] (1 : L), ?_⟩⟩
        · rw [key z₁, key z₂, h]
        · rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
      exact Algebra.WeaklyEtale.mk (IsLocalization.flat L M)
        (RingHom.Flat.of_bijective (f := (Algebra.TensorProduct.lmul' A (S := L)).toRingHom) hbij)
    have hSpec : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S],
        Algebra.WeaklyEtale R S →
        WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
      intro R S _ _ _ hwe
      haveI := hwe
      have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
        rw [HasRingHomProperty.Spec_iff (P := @Flat)]
        exact RingHom.flat_algebraMap_iff.mpr (Algebra.WeaklyEtale.flat (R := R) (S := S))
      have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R S)))) := by
        rw [diagonal_SpecMap]
        haveI : Flat (Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) :=
          HasRingHomProperty.Spec_iff.mpr (Algebra.WeaklyEtale.flat_lmul' R S)
        infer_instance
      exact WeaklyEtale.mk hf hd
    intro X x
    obtain ⟨W, hW, hxW, -⟩ :=
      exists_isAffineOpen_mem_and_subset (U := (⊤ : X.Opens)) (x := x) trivial
    rw [← hW.fromSpecStalk_eq_fromSpecStalk hxW, IsAffineOpen.fromSpecStalk.eq_1]
    letI : Algebra Γ(X, W) (X.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hxW⟩ : W)
    haveI hloc : IsLocalization.AtPrime (X.presheaf.stalk x) (hW.primeIdealOf ⟨x, hxW⟩).asIdeal :=
      hW.isLocalization_stalk ⟨x, hxW⟩
    have h5 : Algebra.WeaklyEtale Γ(X, W) (X.presheaf.stalk x) :=
      hLoc Γ(X, W) (X.presheaf.stalk x) (hW.primeIdealOf ⟨x, hxW⟩).asIdeal.primeCompl
    have h6 : WeaklyEtale (Spec.map (X.presheaf.germ W x hxW)) :=
      hSpec _ _ h5
    haveI : MorphismProperty.IsStableUnderComposition @WeaklyEtale :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    exact MorphismProperty.comp_mem @WeaklyEtale _ _ h6 inferInstance

  have hconnLoc : ∀ (R : CommRingCat.{u}) [IsLocalRing R], ConnectedSpace ↥(Spec R) := by
    intro R _
    rw [connectedSpace_iff_clopen]
    refine ⟨⟨IsLocalRing.closedPoint R⟩, fun s hs => ?_⟩
    by_cases hne : s = ∅
    · exact Or.inl hne
    · right
      obtain ⟨x, hx⟩ := Set.nonempty_iff_ne_empty.mpr hne
      have hc : IsLocalRing.closedPoint R ∈ s :=
        (IsLocalRing.specializes_closedPoint (R := R) x).mem_closed hs.isClosed hx
      exact Set.eq_univ_of_forall fun y =>
        (IsLocalRing.specializes_closedPoint (R := R) y).mem_open hs.isOpen hc

  have key : ∀ {Z Y' : Scheme.{u}} (V : (wcP1Over F'').left.ProEt) (g : V.left ⟶ Z)
      (h' : Y' ⟶ Z), WeaklyEtale h' → ∀ (v : V.left) (y : Y'), g v = h' y →
      ∃ (T : (wcP1Over F'').left.ProEt) (a : T ⟶ V) (b : T.left ⟶ Y'),
        a.left ≫ g = b ≫ h' ∧ ConnectedSpace T.left := by
    intro Z Y' V g h' hh' v y hvy
    obtain ⟨z, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := g) (g := h') v y hvy
    haveI := hh'
    haveI hq1 : WeaklyEtale (Limits.pullback.fst g h') :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback g h').flip hh'
    haveI : WeaklyEtale V.hom := V.prop
    haveI := hfs (Limits.pullback g h') z
    have hT : WeaklyEtale ((Limits.pullback g h').fromSpecStalk z ≫
        Limits.pullback.fst g h' ≫ V.hom) := inferInstance
    refine ⟨MorphismProperty.Over.mk ⊤ _ hT,
      MorphismProperty.Over.homMk ((Limits.pullback g h').fromSpecStalk z ≫
        Limits.pullback.fst g h') (Category.assoc _ _ _) trivial,
      (Limits.pullback g h').fromSpecStalk z ≫ Limits.pullback.snd g h', ?_, ?_⟩
    · show ((Limits.pullback g h').fromSpecStalk z ≫ Limits.pullback.fst g h') ≫ g = _
      rw [Category.assoc, Limits.pullback.condition]
      exact (Category.assoc _ _ _).symm
    · show ConnectedSpace ↥(Spec ((Limits.pullback g h').presheaf.stalk z))
      exact hconnLoc _

  obtain ⟨-, -, -, -, -, -, -, -, hlam, -, -, hlamΔ, -⟩ := hH
  have hw : (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ lam) ≫
        (Over.mk (wcProjKStr F'' M')).hom =
      Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) := by
    rw [Category.assoc]
    change Limits.pullback.fst _ _ ≫ (lam ≫ wcProjKStr F'' M') = _
    rw [hlam]
    exact Limits.pullback.condition
  obtain ⟨lamb, L1, L2⟩ : ∃ l : Limits.pullback (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ⟶
      Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))),
      l ≫ Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ lam ∧
      l ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        Limits.pullback.snd (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) :=
    ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hwW : π.w.left ≫ Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) = π.W.hom :=
    MorphismProperty.Over.w π.w
  have hw'' : Ω.w'.left ≫ Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) = Ω.W'.hom :=
    MorphismProperty.Over.w Ω.w'
  have hww : WeaklyEtale Ω.w'.left := by
    have h1 : WeaklyEtale (Ω.w'.left ≫ Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := by
      rw [hw'']; exact Ω.W'.prop
    exact @WeaklyEtale.of_comp _ _ _ Ω.w'.left (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) h1 hPP
  haveI := π.hconn
  obtain ⟨z₀⟩ : Nonempty π.W.left := inferInstance
  have hp : Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
        (lamb (π.w.left z₀)) = lam (π.W.hom z₀) := by
    have e1 := congrArg (fun f => f (π.w.left z₀)) L1
    have e2 := congrArg (fun f => f z₀) hwW
    exact e1.trans (congrArg lam e2)
  have hnot : lam (π.W.hom z₀) ∉ Δ := fun hh => by
    obtain ⟨i, hi⟩ := (hlamΔ _).mp hh
    exact π.hoff z₀ i hi
  obtain ⟨z₂, hz₂⟩ := Ω.hcov' (lamb (π.w.left z₀)) (by
    show Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
        (lamb (π.w.left z₀)) ∉ Δ
    rw [hp]; exact hnot)
  have hvy : (π.w.left ≫ lamb) z₀ = Ω.w'.left z₂ := hz₂.symm
  obtain ⟨T, a, b, hab, hconn⟩ := key π.W (π.w.left ≫ lamb) Ω.w'.left hww z₀ z₂ hvy
  refine ⟨T, a, b, ?_, hconn, ?_⟩
  · have e1 : b ≫ Ω.W'.hom = (b ≫ Ω.w'.left) ≫ Limits.pullback.fst
        (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) :=
      (congrArg (fun k => b ≫ k) hw''.symm).trans (Category.assoc _ _ _).symm
    have e2 : (a.left ≫ (π.w.left ≫ lamb)) ≫ Limits.pullback.fst
        (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        a.left ≫ (π.w.left ≫ (lamb ≫ Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :=
      (Category.assoc _ _ _).trans (congrArg (fun k => a.left ≫ k) (Category.assoc _ _ _))
    have e3 : a.left ≫ (π.w.left ≫ (Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ lam)) =
        (a.left ≫ π.W.hom) ≫ lam :=
      (congrArg (fun k => a.left ≫ k) (Category.assoc _ _ _).symm).trans
        ((Category.assoc _ _ _).symm.trans (congrArg (fun k => (a.left ≫ k) ≫ lam) hwW))
    exact e1.trans ((congrArg (fun k => k ≫ Limits.pullback.fst
        (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hab).symm.trans
      (e2.trans ((congrArg (fun k => a.left ≫ π.w.left ≫ k) L1).trans
        (e3.trans (congrArg (fun k => k ≫ lam) (MorphismProperty.Over.w a))))))
  · have e2 : (a.left ≫ (π.w.left ≫ lamb)) ≫ Limits.pullback.snd
        (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        a.left ≫ (π.w.left ≫ (lamb ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :=
      (Category.assoc _ _ _).trans (congrArg (fun k => a.left ≫ k) (Category.assoc _ _ _))
    exact (congrArg (fun k => a.left ≫ π.w.left ≫ k) L2).symm.trans (e2.symm.trans
      ((congrArg (fun k => k ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hab).trans
        (Category.assoc _ _ _)))

theorem wc_proet_closed_pull_henselian_eval {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    [IsClosedImmersion i] [IsLocallyNoetherian Y]
    (L : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
    (adj : L ⊣ wcProEtPush i) (U : Z.ProEt) :
    Sieve.generate (fun (T : Z.ProEt) (_ : T ⟶ U) =>
      ∃ (A : Type u) (_ : CommRing A) (I : Ideal A) (_ : HenselianRing A I) (Vt : Y.ProEt)
        (e : Vt.left ≅ Spec (.of A)) (c : Limits.pullback Vt.hom i ⟶ Spec (.of (A ⧸ I)))
        (_ : (wcProEtBaseChange i).obj Vt ≅ T),
        IsPullback (Limits.pullback.fst Vt.hom i) c e.hom
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) ∧
        Projective (wcFreeSheaf Y Vt) ∧
        Projective (wcFreeSheaf Z ((wcProEtBaseChange i).obj Vt)) ∧
        ∀ G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1},
          Function.Bijective ((adj.unit.app G).hom.app (Opposite.op Vt)).hom)
      ∈ Scheme.ProEt.topology Z U :=
by
  classical
  refine (Scheme.ProEt.topology Z).superset_covering (Sieve.generate_mono ?_)
    (wc_proet_wcontr_affine_open_cover i U)
  rintro T f ⟨⟨O, hO, hTO⟩, hT⟩
  obtain ⟨A, iA, I, iI, Vt, e, c, κ, hsq, hV, hiV⟩ :=
    wc_proet_henselian_thickening_exists i T O hO hTO hT
  have hinit : ∀ V : Y.ProEt,
      Function.Bijective (fun a : Vt ⟶ V => (wcProEtBaseChange i).map a) := by
    intro V
    refine wc_proet_thickening_bc_hom_bijective i A I Vt e c hsq ?_ V
    intro X S g _ a b hab
    exact wc_weaklyEtale_henselian_lift g A I a b hab
  refine ⟨A, iA, I, iI, Vt, e, c, κ, hsq, wc_proet_free_projective_wcontractible Y Vt hV,
    wc_proet_free_projective_wcontractible Z _ hiV, fun G => ?_⟩
  apply wc_proet_closed_unit_bij_of_lan i L adj Vt G
  refine Function.Bijective.comp ?_ (wc_proet_lan_unit_bijective_of_init i Vt hinit G.obj)
  apply wc_proet_toSheafify_bijective_wcontr Z _ _ hiV
  intro m Q ι hι hpart
  obtain ⟨Vk, ιt, κk, hιt, hpt, hκ, hthick⟩ :=
    wc_proet_thickening_clopen_lift i A I Vt e c hsq m Q ι hι hpart
  refine wc_proet_lan_clopen_additive i Vt G m Q ι Vk ιt κk hιt hpt hκ
    (wc_proet_lan_unit_bijective_of_init i Vt hinit G.obj) (fun k => ?_)
  obtain ⟨Ak, iAk, Ik, iIk, ek, ck, hsqk⟩ := hthick k
  refine wc_proet_lan_unit_bijective_of_init i (Vk k) (fun V => ?_) G.obj
  refine wc_proet_thickening_bc_hom_bijective i Ak Ik (Vk k) ek ck hsqk ?_ V
  intro X S g _ a b hab
  exact wc_weaklyEtale_henselian_lift g Ak Ik a b hab

theorem wc_proet_res_theta_swap_natural {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    (L : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush i)
    (θ θ' : ∀ V : Y.ProEt, L.obj (wcFreeSheaf Y V) ≅ wcFreeSheaf Z ((wcProEtPullback i).obj V))
    (M : Type) [AddCommGroup M] [TopologicalSpace M] [IsTopologicalAddGroup M] (j : ℕ) :
    (∀ (U : Y.ProEt) (z : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y M) j),
      wcProEtRes i L adj θ M U j z =
        (Abelian.Ext.mk₀ ((θ U).inv ≫ (θ' U).hom)).comp (wcProEtRes i L adj θ' M U j z)
          (zero_add j)) ∧
    ((∀ {V V' : Y.ProEt} (a : V ⟶ V'),
        L.map (wcFreeSheafMap Y a) ≫ (θ' V').hom =
          (θ' V).hom ≫ wcFreeSheafMap Z ((wcProEtPullback i).map a)) →
      ∀ (U U' : Y.ProEt) (a : U' ⟶ U) (z : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y M) j),
        wcProEtRes i L adj θ' M U' j ((Abelian.Ext.mk₀ (wcFreeSheafMap Y a)).comp z (zero_add j)) =
          (Abelian.Ext.mk₀ (wcFreeSheafMap Z ((wcProEtPullback i).map a))).comp
            (wcProEtRes i L adj θ' M U j z) (zero_add j)) :=
by
  have hD : ∀ (θ'' : ∀ V : Y.ProEt, L.obj (wcFreeSheaf Y V) ≅
        wcFreeSheaf Z ((wcProEtPullback i).obj V)) (U : Y.ProEt)
      (z : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y M) j),
      wcProEtRes i L adj θ'' M U j z =
        (Abelian.Ext.mk₀ (θ'' U).inv).comp ((Abelian.Ext.mapExactFunctor L z).comp
          (Abelian.Ext.mk₀ ((adj.homEquiv (wcContSheaf Y M) (wcContSheaf Z M)).symm
            (wcContPull i M))) (add_zero j)) (zero_add j) :=
    fun θ'' U z => rfl
  refine ⟨fun U z => ?_, fun hθ' U U' a z => ?_⟩
  · rw [hD θ U z, hD θ' U z,
      ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add j) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  · have key : (θ' U').inv ≫ L.map (wcFreeSheafMap Y a) =
        wcFreeSheafMap Z ((wcProEtPullback i).map a) ≫ (θ' U).inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, ← hθ' a, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    rw [hD θ' U', hD θ' U, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (zero_add j) (add_zero j) (by omega),
      ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add j) (by omega),
      ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add j) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, key]

theorem wc_proet_free_pullback_square_natIso {W X₁ X₂ S : Scheme.{u}} (p : W ⟶ X₁)
    (h : X₁ ⟶ S) (f : W ⟶ X₂) (lam : X₂ ⟶ S) (hw : p ≫ h = f ≫ lam) :
    ∃ κ : ∀ V : S.ProEt, wcFreeSheaf W ((wcProEtPullback p).obj ((wcProEtPullback h).obj V)) ≅
        wcFreeSheaf W ((wcProEtPullback f).obj ((wcProEtBaseChange lam).obj V)),
      ∀ {V V' : S.ProEt} (a : V' ⟶ V),
        wcFreeSheafMap W ((wcProEtPullback p).map ((wcProEtPullback h).map a)) ≫ (κ V).hom =
          (κ V').hom ≫ wcFreeSheafMap W ((wcProEtPullback f).map ((wcProEtBaseChange lam).map a)) :=
by
  letI i1 : ∀ {A B : Scheme.{u}} (g : A ⟶ B),
      MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) g :=
    fun _ => ⟨fun _ _ => inferInstance⟩
  letI i2 : ∀ {A B : Scheme.{u}} (g : A ⟶ B),
      MorphismProperty.IsStableUnderBaseChangeAlong
        (@WeaklyEtale : MorphismProperty Scheme.{u}) g :=
    fun g => (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
      (inferInstance : P.IsStableUnderBaseChangeAlong g)) (@WeaklyEtale : MorphismProperty Scheme.{u})
  have Φ : wcProEtPullback h ⋙ wcProEtPullback p ≅ wcProEtBaseChange lam ⋙ wcProEtPullback f :=
    (MorphismProperty.Over.pullbackComp (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
        (Q := ⊤) p h).symm ≪≫ MorphismProperty.Over.pullbackCongr hw ≪≫
      MorphismProperty.Over.pullbackComp f lam
  let Fr : W.ProEt ⥤ Sheaf (Scheme.ProEt.topology W) AddCommGrpCat.{u+1} :=
    yoneda ⋙ (Functor.whiskeringRight _ _ _).obj (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⋙
      presheafToSheaf (Scheme.ProEt.topology W) AddCommGrpCat.{u+1}
  refine ⟨fun V => Fr.mapIso (Φ.app V), ?_⟩
  intro V V' a
  show Fr.map ((wcProEtPullback p).map ((wcProEtPullback h).map a)) ≫ Fr.map (Φ.hom.app V) =
    Fr.map (Φ.hom.app V') ≫ Fr.map ((wcProEtPullback f).map ((wcProEtBaseChange lam).map a))
  rw [← Fr.map_comp, ← Fr.map_comp]
  exact congrArg Fr.map (Φ.hom.naturality a)

theorem wc_proet_sheaf_hom_of_dense_sections {S : Scheme.{u}} (Q : S.ProEt → Prop)
    (hQ : ∀ U : S.ProEt, Sieve.generate (fun (W : S.ProEt) (_ : W ⟶ U) => Q W) ∈
      Scheme.ProEt.topology S U)
    (A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (t : ∀ V : S.ProEt, Q V → (A.obj.obj (Opposite.op V) →+ B.obj.obj (Opposite.op V)))
    (ht : ∀ (V V' : S.ProEt) (hV : Q V) (hV' : Q V') (a : V' ⟶ V) (x : A.obj.obj (Opposite.op V)),
      t V' hV' ((A.obj.map a.op).hom x) = (B.obj.map a.op).hom (t V hV x)) :
    ∃ φ : A ⟶ B, ∀ (V : S.ProEt) (hV : Q V) (x : A.obj.obj (Opposite.op V)),
      (φ.hom.app (Opposite.op V)).hom x = t V hV x :=
by
  classical
  let G : ObjectProperty.FullSubcategory (Q : ObjectProperty S.ProEt) ⥤ S.ProEt :=
    ObjectProperty.ι (Q : ObjectProperty S.ProEt)
  haveI hcd : G.IsCoverDense (Scheme.ProEt.topology S) := by
    refine ⟨fun U => ?_⟩
    refine (Scheme.ProEt.topology S).superset_covering ?_ (hQ U)
    rw [Sieve.generate_le_iff]
    intro W f hW
    exact ⟨{ obj := ⟨W, hW⟩, lift := 𝟙 W, map := f, fac := Category.id_comp f }⟩
  let α : G.op ⋙ A.obj ⟶ G.op ⋙ B.obj :=
    { app := fun X => AddCommGrpCat.ofHom (t X.unop.obj X.unop.property)
      naturality := by
        intro X Y f
        ext x
        exact ht X.unop.obj Y.unop.obj X.unop.property Y.unop.property (G.map f.unop) x }
  refine ⟨ObjectProperty.homMk (Functor.IsCoverDense.sheafHom α), fun V hV x => ?_⟩
  have h := congrArg (fun g => (g.app (Opposite.op
    (⟨V, hV⟩ : ObjectProperty.FullSubcategory (Q : ObjectProperty S.ProEt)))).hom x)
    (Functor.IsCoverDense.sheafHom_restrict_eq α)
  exact h

theorem wc_proet_Rq_sections_ext_model {X B : Scheme.{u}} (g : X ⟶ B) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (q : ℕ) :
    ∃ Θ : ∀ V : B.ProEt, Abelian.Ext (wcFreeSheaf X ((wcProEtPullback g).obj V))
        (wcContSheaf X ℚ_[ℓ]) q →+ (wcRq g ℓ q).obj.obj (Opposite.op V),
      (∀ V : B.ProEt, Projective (wcFreeSheaf B V) → Function.Bijective (Θ V)) ∧
      ∀ (V V' : B.ProEt) (a : V' ⟶ V)
        (z : Abelian.Ext (wcFreeSheaf X ((wcProEtPullback g).obj V)) (wcContSheaf X ℚ_[ℓ]) q),
        Θ V' ((Abelian.Ext.mk₀ (wcFreeSheafMap X ((wcProEtPullback g).map a))).comp z (zero_add q)) =
          ((wcRq g ℓ q).obj.map a.op).hom (Θ V z) :=
by
  classical
  obtain ⟨L, adj, -, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat g
  obtain ⟨ed, hbij, hnat, -⟩ := ext_rightDerived_adj_edge L (wcProEtPush g) adj
    (wcLadicSheaf X ℓ) q
  obtain ⟨ev, -, hev⟩ := wc_free_ext0_eval B
  let κ : ∀ V : B.ProEt,
      Abelian.Ext (wcFreeSheaf X ((wcProEtPullback g).obj V)) (wcLadicSheaf X ℓ) q →+
        Abelian.Ext (L.obj (wcFreeSheaf B V)) (wcLadicSheaf X ℓ) q :=
    fun V => (Abelian.Ext.mk₀ (θ V).hom).precomp (wcLadicSheaf X ℓ) (zero_add q)
  have hκ : ∀ V, Function.Bijective (κ V) := by
    intro V
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun t => (Abelian.Ext.mk₀ (θ V).inv).comp t (zero_add q), ?_, ?_⟩
    · intro t
      show (Abelian.Ext.mk₀ (θ V).inv).comp
        ((Abelian.Ext.mk₀ (θ V).hom).comp t (zero_add q)) (zero_add q) = t
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    · intro t
      show (Abelian.Ext.mk₀ (θ V).hom).comp
        ((Abelian.Ext.mk₀ (θ V).inv).comp t (zero_add q)) (zero_add q) = t
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
  let Θ : ∀ V : B.ProEt, Abelian.Ext (wcFreeSheaf X ((wcProEtPullback g).obj V))
        (wcContSheaf X ℚ_[ℓ]) q →+ (wcRq g ℓ q).obj.obj (Opposite.op V) :=
    fun V => (ev V (wcRq g ℓ q)).toAddMonoidHom.comp ((ed (wcFreeSheaf B V)).comp (κ V))
  refine ⟨Θ, ?_, ?_⟩
  · intro V hV
    exact (ev V (wcRq g ℓ q)).bijective.comp ((@hbij _ hV).comp (hκ V))
  · have key : ∀ (V V' : B.ProEt) (a : V' ⟶ V)
        (z : Abelian.Ext (wcFreeSheaf X ((wcProEtPullback g).obj V)) (wcLadicSheaf X ℓ) q),
        ev V' (wcRq g ℓ q) (ed _ ((Abelian.Ext.mk₀ (θ V').hom).comp
          ((Abelian.Ext.mk₀ (wcFreeSheafMap X ((wcProEtPullback g).map a))).comp z (zero_add q))
            (zero_add q))) =
        ((wcRq g ℓ q).obj.map a.op).hom
          (ev V (wcRq g ℓ q) (ed _ ((Abelian.Ext.mk₀ (θ V).hom).comp z (zero_add q)))) := by
      intro V V' a z
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← hθ a, ← Abelian.Ext.mk₀_comp_mk₀_assoc, hnat]
      exact hev V V' a (wcRq g ℓ q) _
    intro V V' a z
    exact key V V' a z

theorem wc_pfam_Rq_bc_morphism (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p) (q : ℕ)
    (Lp : Sheaf (Scheme.ProEt.topology Xu.left) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1})
    [Lp.Additive] [Limits.PreservesFiniteLimits Lp] [Limits.PreservesFiniteColimits Lp]
    (adjp : Lp ⊣ wcProEtPush p)
    (θp : ∀ V : Xu.left.ProEt, Lp.obj (wcFreeSheaf Xu.left V) ≅
      wcFreeSheaf D.Yt.left ((wcProEtPullback p).obj V)) :
    ∃ g : wcRq h ℓ q ⟶ (wcProEtPush lam).obj (wcRq D.f ℓ q),
      ∀ V : (wcProjK F'' M').ProEt, Projective (wcFreeSheaf (wcProjK F'' M') V) →
        Projective (wcFreeSheaf (wcP1Over F'').left ((wcProEtBaseChange lam).obj V)) →
        ∃ (e₁ : (wcRq h ℓ q).obj.obj (Opposite.op V) ≃+
            Abelian.Ext (wcFreeSheaf Xu.left ((wcProEtPullback h).obj V))
              (wcContSheaf Xu.left ℚ_[ℓ]) q)
          (e₂ : ((wcProEtPush lam).obj (wcRq D.f ℓ q)).obj.obj (Opposite.op V) ≃+
            Abelian.Ext (wcFreeSheaf D.Yt.left
                ((wcProEtPullback p).obj ((wcProEtPullback h).obj V)))
              (wcContSheaf D.Yt.left ℚ_[ℓ]) q),
          ∀ s, e₂ ((g.hom.app (Opposite.op V)).hom s) =
            wcProEtRes p Lp adjp θp ℚ_[ℓ] ((wcProEtPullback h).obj V) q (e₁ s) :=
by
  classical

  obtain ⟨L₀, adj₀, -, θ₀, hθ₀⟩ := wc_proet_push_left_adjoint_free_nat p
  let ν : Lp ≅ L₀ := adjp.leftAdjointUniq adj₀
  let θ' : ∀ V : Xu.left.ProEt, Lp.obj (wcFreeSheaf Xu.left V) ≅
      wcFreeSheaf D.Yt.left ((wcProEtPullback p).obj V) := fun V => ν.app _ ≪≫ θ₀ V
  have hθ' : ∀ {V V' : Xu.left.ProEt} (a : V ⟶ V'),
      Lp.map (wcFreeSheafMap Xu.left a) ≫ (θ' V').hom =
        (θ' V).hom ≫ wcFreeSheafMap D.Yt.left ((wcProEtPullback p).map a) := by
    intro V V' a
    show Lp.map (wcFreeSheafMap Xu.left a) ≫ (ν.hom.app _ ≫ (θ₀ V').hom) =
      (ν.hom.app _ ≫ (θ₀ V).hom) ≫ wcFreeSheafMap D.Yt.left ((wcProEtPullback p).map a)
    rw [← Category.assoc, ν.hom.naturality, Category.assoc, hθ₀ a, Category.assoc]

  have hw : p ≫ h = D.f ≫ lam := hH.2.2.2.2.2.2.2.2.2.2.1.w
  obtain ⟨Θh, hΘh_bij, hΘh_nat⟩ := wc_proet_Rq_sections_ext_model h ℓ q
  obtain ⟨Θf, hΘf_bij, hΘf_nat⟩ := wc_proet_Rq_sections_ext_model D.f ℓ q
  obtain ⟨κ, hκ⟩ := wc_proet_free_pullback_square_natIso p h D.f lam hw
  obtain ⟨hRes1, hRes2⟩ := wc_proet_res_theta_swap_natural p Lp adjp θp θ' ℚ_[ℓ] q
  have hRes2' := hRes2 hθ'
  haveI hcont : (wcProEtBaseChange lam).IsContinuous (Scheme.ProEt.topology (wcProjK F'' M'))
      (Scheme.ProEt.topology (wcP1Over F'').left) := (wc_proet_pullback_continuous_flat lam).1
  set τ := toSheafify (Scheme.ProEt.topology (wcProjK F'' M'))
      ((wcProEtBaseChange lam).op ⋙ (wcRq D.f ℓ q).obj) with hτ
  haveI : IsIso τ :=
    isIso_toSheafify _ (Functor.op_comp_isSheaf (wcProEtBaseChange lam) _ _ (wcRq D.f ℓ q))
  have hτbij : ∀ V : (wcProjK F'' M').ProEt, Function.Bijective (τ.app (Opposite.op V)).hom := by
    intro V
    haveI := NatIso.isIso_app_of_isIso τ (Opposite.op V)
    exact ConcreteCategory.bijective_of_isIso (τ.app (Opposite.op V))

  let Eh : ∀ V : (wcProjK F'' M').ProEt, Projective (wcFreeSheaf (wcProjK F'' M') V) →
      ((wcRq h ℓ q).obj.obj (Opposite.op V) ≃+
        Abelian.Ext (wcFreeSheaf Xu.left ((wcProEtPullback h).obj V))
          (wcContSheaf Xu.left ℚ_[ℓ]) q) :=
    fun V hV => (AddEquiv.ofBijective (Θh V) (hΘh_bij V hV)).symm
  have e1 : ∀ (W : (wcProjK F'' M').ProEt) (hW : Projective (wcFreeSheaf (wcProjK F'' M') W))
      (y : (wcRq h ℓ q).obj.obj (Opposite.op W)), Θh W (Eh W hW y) = y :=
    fun W hW y => (AddEquiv.ofBijective (Θh W) (hΘh_bij W hW)).apply_symm_apply y
  let Pκ : ∀ V : (wcProjK F'' M').ProEt,
      Abelian.Ext (wcFreeSheaf D.Yt.left ((wcProEtPullback p).obj ((wcProEtPullback h).obj V)))
        (wcContSheaf D.Yt.left ℚ_[ℓ]) q →+
      Abelian.Ext (wcFreeSheaf D.Yt.left
          ((wcProEtPullback D.f).obj ((wcProEtBaseChange lam).obj V)))
        (wcContSheaf D.Yt.left ℚ_[ℓ]) q :=
    fun V => (Abelian.Ext.mk₀ (κ V).inv).precomp (wcContSheaf D.Yt.left ℚ_[ℓ]) (zero_add q)
  have hPκ : ∀ (V : (wcProjK F'' M').ProEt) (w : Abelian.Ext (wcFreeSheaf D.Yt.left
      ((wcProEtPullback p).obj ((wcProEtPullback h).obj V))) (wcContSheaf D.Yt.left ℚ_[ℓ]) q),
      Pκ V w = (Abelian.Ext.mk₀ (κ V).inv).comp w (zero_add q) := fun V w => rfl
  let t : ∀ V : (wcProjK F'' M').ProEt, Projective (wcFreeSheaf (wcProjK F'' M') V) →
      ((wcRq h ℓ q).obj.obj (Opposite.op V) →+
        ((wcProEtPush lam).obj (wcRq D.f ℓ q)).obj.obj (Opposite.op V)) :=
    fun V hV => (τ.app (Opposite.op V)).hom.comp ((Θf ((wcProEtBaseChange lam).obj V)).comp
      ((Pκ V).comp ((wcProEtRes p Lp adjp θ' ℚ_[ℓ] ((wcProEtPullback h).obj V) q).comp
        (Eh V hV).toAddMonoidHom)))
  have ht : ∀ (V V' : (wcProjK F'' M').ProEt) (hV : Projective (wcFreeSheaf (wcProjK F'' M') V))
      (hV' : Projective (wcFreeSheaf (wcProjK F'' M') V')) (a : V' ⟶ V)
      (x : (wcRq h ℓ q).obj.obj (Opposite.op V)),
      t V' hV' (((wcRq h ℓ q).obj.map a.op).hom x) =
        (((wcProEtPush lam).obj (wcRq D.f ℓ q)).obj.map a.op).hom (t V hV x) := by
    intro V V' hV hV' a x
    have n1 : Eh V' hV' (((wcRq h ℓ q).obj.map a.op).hom x) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap Xu.left ((wcProEtPullback h).map a))).comp
          (Eh V hV x) (zero_add q) := by
      apply (hΘh_bij V' hV').injective
      rw [hΘh_nat V V' a, e1 V' hV', e1 V hV]
    have hk : (κ V').inv ≫ wcFreeSheafMap D.Yt.left
          ((wcProEtPullback p).map ((wcProEtPullback h).map a)) =
        wcFreeSheafMap D.Yt.left ((wcProEtPullback D.f).map ((wcProEtBaseChange lam).map a)) ≫
          (κ V).inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, ← hκ a, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    have n3 : ∀ w : Abelian.Ext (wcFreeSheaf D.Yt.left
          ((wcProEtPullback p).obj ((wcProEtPullback h).obj V))) (wcContSheaf D.Yt.left ℚ_[ℓ]) q,
        Pκ V' ((Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left
          ((wcProEtPullback p).map ((wcProEtPullback h).map a)))).comp w (zero_add q)) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap D.Yt.left
          ((wcProEtPullback D.f).map ((wcProEtBaseChange lam).map a)))).comp (Pκ V w)
            (zero_add q) := by
      intro w
      rw [hPκ, hPκ, ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add q) (by omega),
        ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add q) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hk]
    show (τ.app (Opposite.op V')).hom (Θf ((wcProEtBaseChange lam).obj V') (Pκ V'
        (wcProEtRes p Lp adjp θ' ℚ_[ℓ] ((wcProEtPullback h).obj V') q
          (Eh V' hV' (((wcRq h ℓ q).obj.map a.op).hom x))))) =
      (((wcProEtPush lam).obj (wcRq D.f ℓ q)).obj.map a.op).hom ((τ.app (Opposite.op V)).hom
        (Θf ((wcProEtBaseChange lam).obj V) (Pκ V
          (wcProEtRes p Lp adjp θ' ℚ_[ℓ] ((wcProEtPullback h).obj V) q (Eh V hV x)))))
    rw [n1, hRes2' _ _ ((wcProEtPullback h).map a), n3,
      hΘf_nat _ _ ((wcProEtBaseChange lam).map a)]
    exact NatTrans.naturality_apply τ a.op _

  obtain ⟨φ, hφ⟩ := wc_proet_sheaf_hom_of_dense_sections
    (fun W => Projective (wcFreeSheaf (wcProjK F'' M') W))
    (wc_proet_projective_free_covering (wcProjK F'' M'))
    (wcRq h ℓ q) ((wcProEtPush lam).obj (wcRq D.f ℓ q)) t ht

  have extIso : ∀ {A₁ A₂ C : Sheaf (Scheme.ProEt.topology D.Yt.left) AddCommGrpCat.{u+1}}
      (e : A₁ ≅ A₂), ∃ E : Abelian.Ext A₂ C q ≃+ Abelian.Ext A₁ C q,
        ∀ y, E y = (Abelian.Ext.mk₀ e.hom).comp y (zero_add q) := by
    intro A₁ A₂ C e
    refine ⟨AddMonoidHom.toAddEquiv ((Abelian.Ext.mk₀ e.hom).precomp C (zero_add q))
      ((Abelian.Ext.mk₀ e.inv).precomp C (zero_add q)) ?_ ?_, fun y => rfl⟩
    · refine AddMonoidHom.ext fun y => ?_
      show (Abelian.Ext.mk₀ e.inv).comp ((Abelian.Ext.mk₀ e.hom).comp y (zero_add q))
        (zero_add q) = y
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add q) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, e.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    · refine AddMonoidHom.ext fun y => ?_
      show (Abelian.Ext.mk₀ e.hom).comp ((Abelian.Ext.mk₀ e.inv).comp y (zero_add q))
        (zero_add q) = y
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add q) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id, Abelian.Ext.mk₀_id_comp]
  refine ⟨φ, fun V hV hT => ?_⟩
  obtain ⟨Eκ, hEκ⟩ := extIso (κ V)
  obtain ⟨Eθ, hEθ⟩ := extIso ((θp ((wcProEtPullback h).obj V)).symm ≪≫ θ' ((wcProEtPullback h).obj V))
  have hEθ' : ∀ y, Eθ y = (Abelian.Ext.mk₀ ((θp ((wcProEtPullback h).obj V)).inv ≫
      (θ' ((wcProEtPullback h).obj V)).hom)).comp y (zero_add q) := hEθ
  let E1 := (AddEquiv.ofBijective (τ.app (Opposite.op V)).hom (hτbij V)).symm
  let E2 := (AddEquiv.ofBijective (Θf ((wcProEtBaseChange lam).obj V)) (hΘf_bij _ hT)).symm
  have c1 : ∀ y, E1 ((τ.app (Opposite.op V)).hom y) = y := fun y =>
    (AddEquiv.ofBijective (τ.app (Opposite.op V)).hom (hτbij V)).symm_apply_apply y
  have c2 : ∀ y, E2 (Θf ((wcProEtBaseChange lam).obj V) y) = y := fun y =>
    (AddEquiv.ofBijective (Θf ((wcProEtBaseChange lam).obj V)) (hΘf_bij _ hT)).symm_apply_apply y
  refine ⟨Eh V hV, E1.trans (E2.trans (Eκ.trans Eθ)), fun s => ?_⟩
  have ht_def : t V hV s = (τ.app (Opposite.op V)).hom (Θf ((wcProEtBaseChange lam).obj V)
      (Pκ V (wcProEtRes p Lp adjp θ' ℚ_[ℓ] ((wcProEtPullback h).obj V) q (Eh V hV s)))) := rfl
  rw [hφ V hV s, AddEquiv.trans_apply, AddEquiv.trans_apply, AddEquiv.trans_apply, ht_def, c1,
    c2, hEκ, hPκ, ← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add q) (by omega),
    Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp, hEθ', hRes1]

theorem wc_proet_res_bij_of_zmod_pull_bij {Y' X' : Scheme.{u}} (ι : X' ⟶ Y')
    (L : Sheaf (Scheme.ProEt.topology Y') AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology X') AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush ι)
    (θ : ∀ V : Y'.ProEt, L.obj (wcFreeSheaf Y' V) ≅ wcFreeSheaf X' ((wcProEtPullback ι).obj V))
    (U : Y'.ProEt) (n : ℕ) (hn : 0 < n)
    (D : wcZModPullData (Limits.pullback.fst U.hom ι) n) (hD : wcZModPullCanonical D) (j : ℕ)
    (hbij : Function.Bijective (wcZModPull D j)) :
    Function.Bijective (wcProEtRes ι L adj θ (ZMod n) U j) :=
by
  classical
  have hev : ∀ {C : Type (u+1)} [Category.{u} C] (J' : GrothendieckTopology C)
      [HasWeakSheafify J' AddCommGrpCat.{u+1}] (W : C) (Q : Sheaf J' AddCommGrpCat.{u+1}),
      Function.Bijective (fun φ : (presheafToSheaf J' AddCommGrpCat.{u+1}).obj
          (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q =>
        φ.hom.app (Opposite.op W)
          ((toSheafify J' (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op W) (FreeAbelianGroup.of (ULift.up (𝟙 W))))) := by
    intro C _ J' _ W Q
    let e := ((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv _ Q).trans
      (((Adjunction.whiskerRight Cᵒᵖ AddCommGrpCat.adj).homEquiv
        (yoneda.obj W ⋙ uliftFunctor.{u+1, u}) _).trans uliftYonedaEquiv)
    have h : (fun φ : (presheafToSheaf J' AddCommGrpCat.{u+1}).obj
          (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Q =>
        φ.hom.app (Opposite.op W)
          ((toSheafify J' (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op W) (FreeAbelianGroup.of (ULift.up (𝟙 W))))) = ⇑e := by
      funext φ
      simp only [e, Equiv.trans_apply]
      rw [Adjunction.homEquiv_unit, sheafificationAdjunction_unit_app]
      rfl
    rw [h]
    exact e.bijective
  have hkey : ∀ {C : Type (u+1)} [Category.{u} C] (J' : GrothendieckTopology C)
      [HasWeakSheafify J' AddCommGrpCat.{u+1}] (P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (Q : Sheaf J' AddCommGrpCat.{u+1}) (γ : P ⟶ Q.obj) (U : Cᵒᵖ) (s : P.obj U),
      (((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv P Q).symm γ).hom.app U
        ((toSheafify J' P).app U s) = γ.app U s := by
    intro C _ J' _ P Q γ U s
    have h := (sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv_unit P Q
      (((sheafificationAdjunction J' AddCommGrpCat.{u+1}).homEquiv P Q).symm γ)
    rw [Equiv.apply_symm_apply, sheafificationAdjunction_unit_app] at h
    exact (congrArg (fun φ : P ⟶ Q.obj => φ.app U s) h).symm

  have hΦgen : ∀ (S : Scheme.{u}) (V : S.ProEt)
      [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
      (Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      Function.Bijective (fun f : wcFreeSheaf S V ⟶ Y =>
        wcLpscGen S V (Scheme.ProEt.mk (𝟙 V.left)) V (wcLpscBetaTop S V) ≫
          (wcLpscG S V).map f) := by
    intro S V _ Y
    haveI hβiso : IsIso (wcLpscBetaTop S V) :=
      ⟨⟨(MorphismProperty.Over.homMk (𝟙 V.left) rfl trivial :
          V ⟶ (wcSliceFunctor S V).obj (Scheme.ProEt.mk (𝟙 V.left))),
        MorphismProperty.Over.Hom.ext (Category.comp_id _),
        MorphismProperty.Over.Hom.ext (Category.comp_id _)⟩⟩
    have hclaim : ∀ (f : wcFreeSheaf S V ⟶ Y),
        (wcLpscGen S V (Scheme.ProEt.mk (𝟙 V.left)) V (wcLpscBetaTop S V) ≫
            (wcLpscG S V).map f).hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
          ((toSheafify (Scheme.ProEt.topology V.left)
            (yoneda.obj (Scheme.ProEt.mk (𝟙 V.left)) ⋙ uliftFunctor.{u+1, u} ⋙
              AddCommGrpCat.free)).app
            (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
            (FreeAbelianGroup.of (ULift.up (𝟙 (Scheme.ProEt.mk (𝟙 V.left)))))) =
        Y.obj.map (wcLpscBetaTop S V).op (f.hom.app (Opposite.op V)
          ((toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op V) (FreeAbelianGroup.of (ULift.up (𝟙 V))))) := by
      intro f
      have e2 := hkey (Scheme.ProEt.topology V.left)
        (yoneda.obj (Scheme.ProEt.mk (𝟙 V.left)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
        ((wcLpscG S V).obj (wcFreeSheaf S V))
        (Functor.whiskerRight ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj V)).symm
            (wcLpscBetaTop S V)) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
          Functor.whiskerLeft (wcSliceFunctor S V).op
            (toSheafify (Scheme.ProEt.topology S)
              (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)))
        (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
        (FreeAbelianGroup.of (ULift.up (𝟙 (Scheme.ProEt.mk (𝟙 V.left)))))
      have hb : ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj V)).symm
          (wcLpscBetaTop S V)).app (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
            (𝟙 (Scheme.ProEt.mk (𝟙 V.left))) = wcLpscBetaTop S V ≫ 𝟙 V := by
        have hb0 : ((yonedaEquiv (F := (wcSliceFunctor S V).op ⋙ yoneda.obj V)).symm
            (wcLpscBetaTop S V)).app (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
              (𝟙 (Scheme.ProEt.mk (𝟙 V.left))) =
            (wcSliceFunctor S V).map (𝟙 (Scheme.ProEt.mk (𝟙 V.left))) ≫ wcLpscBetaTop S V := by
          first
            | rfl
            | exact yonedaEquiv_symm_app_apply _ _ _
            | (erw [yonedaEquiv_symm_app_apply]; rfl)
        rw [hb0]
        first
          | rw [CategoryTheory.Functor.map_id, Category.id_comp, Category.comp_id]
          | simp only [CategoryTheory.Functor.map_id, Category.id_comp, Category.comp_id]
          | (apply MorphismProperty.Over.Hom.ext; rfl)
          | rfl
          | simp
      have hn1 := NatTrans.naturality_apply (toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) (wcLpscBetaTop S V).op
            (FreeAbelianGroup.of (ULift.up (𝟙 V)))
      have hn2 := NatTrans.naturality_apply f.hom (wcLpscBetaTop S V).op
        ((toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op V) (FreeAbelianGroup.of (ULift.up (𝟙 V))))
      refine Eq.trans (congrArg (fun x => f.hom.app
        (Opposite.op ((wcSliceFunctor S V).obj (Scheme.ProEt.mk (𝟙 V.left)))) x) e2) ?_
      refine Eq.trans ?_ hn2
      refine congrArg (fun x => f.hom.app
        (Opposite.op ((wcSliceFunctor S V).obj (Scheme.ProEt.mk (𝟙 V.left)))) x) ?_
      refine Eq.trans ?_ hn1
      show (toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
          (Opposite.op ((wcSliceFunctor S V).obj (Scheme.ProEt.mk (𝟙 V.left))))
          (FreeAbelianGroup.of (ULift.up (((yonedaEquiv
            (F := (wcSliceFunctor S V).op ⋙ yoneda.obj V)).symm
            (wcLpscBetaTop S V)).app (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
              (𝟙 (Scheme.ProEt.mk (𝟙 V.left)))))) = _
      rw [hb]
      rfl
    have h1 := hev (Scheme.ProEt.topology V.left) (Scheme.ProEt.mk (𝟙 V.left))
      ((wcLpscG S V).obj Y)
    have h2 := hev (Scheme.ProEt.topology S) V Y
    have h3 : Function.Bijective (fun x : Y.obj.obj (Opposite.op V) =>
        Y.obj.map (wcLpscBetaTop S V).op x) :=
      ConcreteCategory.bijective_of_isIso (Y.obj.map (wcLpscBetaTop S V).op)
    refine ⟨fun f₁ f₂ hf => h2.1 (h3.1 ?_), fun g => ?_⟩
    · have := congrArg (fun φ : wcFreeSheaf V.left (Scheme.ProEt.mk (𝟙 V.left)) ⟶
          (wcLpscG S V).obj Y => φ.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
        ((toSheafify (Scheme.ProEt.topology V.left)
          (yoneda.obj (Scheme.ProEt.mk (𝟙 V.left)) ⋙ uliftFunctor.{u+1, u} ⋙
            AddCommGrpCat.free)).app
          (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
          (FreeAbelianGroup.of (ULift.up (𝟙 (Scheme.ProEt.mk (𝟙 V.left))))))) hf
      exact (hclaim f₁).symm.trans (this.trans (hclaim f₂))
    · obtain ⟨y, hy⟩ := h3.2 (g.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
        ((toSheafify (Scheme.ProEt.topology V.left)
          (yoneda.obj (Scheme.ProEt.mk (𝟙 V.left)) ⋙ uliftFunctor.{u+1, u} ⋙
            AddCommGrpCat.free)).app
          (Opposite.op (Scheme.ProEt.mk (𝟙 V.left)))
          (FreeAbelianGroup.of (ULift.up (𝟙 (Scheme.ProEt.mk (𝟙 V.left)))))))
      obtain ⟨f, hf⟩ := h2.2 y
      refine ⟨f, h1.1 ?_⟩
      exact (hclaim f).trans
        ((congrArg (fun x => Y.obj.map (wcLpscBetaTop S V).op x) hf).trans hy)

  have hOmega : ∀ {C₁ C₂ D₁ D₂ : Type (u+2)} [Category.{u+1} C₁] [Category.{u+1} C₂]
      [Category.{u+1} D₁] [Category.{u+1} D₂]
      {L : C₁ ⥤ C₂} {R : C₂ ⥤ C₁} (adj : L ⊣ R) (G : C₁ ⥤ D₁) (G' : C₂ ⥤ D₂)
      {F : D₁ ⥤ D₂} {H : D₂ ⥤ D₁} (adjS : F ⊣ H) (χ : R ⋙ G ⟶ G' ⋙ H),
      ∃ ω : G ⋙ F ⟶ L ⋙ G', ∀ (M : C₁) (Q : C₂) (y : L.obj M ⟶ Q),
        ω.app M ≫ G'.map y =
          (adjS.homEquiv (G.obj M) (G'.obj Q)).symm (G.map (adj.homEquiv M Q y) ≫ χ.app Q) := by
    intro C₁ C₂ D₁ D₂ _ _ _ _ L R adj G G' F H adjS χ
    have key : ∀ (M : C₁) (Q : C₂) (y : L.obj M ⟶ Q),
        (adjS.homEquiv (G.obj M) (G'.obj (L.obj M))).symm
            (G.map (adj.unit.app M) ≫ χ.app (L.obj M)) ≫ G'.map y =
          (adjS.homEquiv (G.obj M) (G'.obj Q)).symm (G.map (adj.homEquiv M Q y) ≫ χ.app Q) := by
      intro M Q y
      rw [← Adjunction.homEquiv_naturality_right_symm, Category.assoc]
      have hn := χ.naturality y
      simp only [Functor.comp_map] at hn
      rw [← hn, ← Category.assoc, ← G.map_comp, ← Adjunction.homEquiv_unit]
    refine ⟨{ app := fun M => (adjS.homEquiv (G.obj M) (G'.obj (L.obj M))).symm
                (G.map (adj.unit.app M) ≫ χ.app (L.obj M))
              naturality := ?_ }, key⟩
    intro M M' f
    simp only [Functor.comp_map]
    rw [key]
    refine (adjS.homEquiv_naturality_left_symm (G.map f) _).symm.trans (congrArg _ ?_)
    rw [← Category.assoc, ← G.map_comp, Adjunction.homEquiv_unit, Adjunction.unit_naturality]

  have hCoeff : ∀ {C₁ C₂ D₁ D₂ : Type (u+2)} [Category.{u+1} C₁] [Category.{u+1} C₂]
      [Category.{u+1} D₁] [Category.{u+1} D₂]
      {L : C₁ ⥤ C₂} {R : C₂ ⥤ C₁} (adj : L ⊣ R) (G : C₁ ⥤ D₁) (G' : C₂ ⥤ D₂)
      {F : D₁ ⥤ D₂} {H : D₂ ⥤ D₁} (adjS : F ⊣ H) (χ : R ⋙ G ⟶ G' ⋙ H)
      (ω : G ⋙ F ⟶ L ⋙ G')
      (_hω : ∀ (M : C₁) (Q : C₂) (y : L.obj M ⟶ Q), ω.app M ≫ G'.map y =
          (adjS.homEquiv (G.obj M) (G'.obj Q)).symm (G.map (adj.homEquiv M Q y) ≫ χ.app Q))
      {Y : C₁} {Y₂ : C₂} {Z : D₁} {Z' : D₂}
      (c : Y ⟶ R.obj Y₂) (lam : G.obj Y ⟶ Z) (lam' : G'.obj Y₂ ⟶ Z') (cp : Z ⟶ H.obj Z')
      (_hχC : G.map c ≫ χ.app Y₂ ≫ H.map lam' = lam ≫ cp),
      ω.app Y ≫ G'.map ((adj.homEquiv Y Y₂).symm c) ≫ lam' =
        F.map lam ≫ (adjS.homEquiv Z Z').symm cp := by
    intro C₁ C₂ D₁ D₂ _ _ _ _ L R adj G G' F H adjS χ ω hω Y Y₂ Z Z' c lam lam' cp hχC
    rw [← Category.assoc, hω, Equiv.apply_symm_apply, ← Adjunction.homEquiv_naturality_right_symm,
      Category.assoc, hχC, Adjunction.homEquiv_naturality_left_symm]

  have hCorep : ∀ {C₁ C₂ D₁ D₂ : Type (u+2)} [Category.{u+1} C₁] [Category.{u+1} C₂]
      [Category.{u+1} D₁] [Category.{u+1} D₂]
      {L : C₁ ⥤ C₂} {R : C₂ ⥤ C₁} (adj : L ⊣ R) (G : C₁ ⥤ D₁) (G' : C₂ ⥤ D₂)
      {F : D₁ ⥤ D₂} {H : D₂ ⥤ D₁} (adjS : F ⊣ H) (χ : R ⋙ G ≅ G' ⋙ H)
      (ω : G ⋙ F ⟶ L ⋙ G')
      (_hω : ∀ (M : C₁) (Q : C₂) (y : L.obj M ⟶ Q), ω.app M ≫ G'.map y =
          (adjS.homEquiv (G.obj M) (G'.obj Q)).symm (G.map (adj.homEquiv M Q y) ≫ χ.hom.app Q))
      {X : C₁} {A : C₂} {T : D₁} {T' : D₂} (θ : L.obj X ≅ A) (g : T ⟶ G.obj X)
      (_hg : ∀ Q : C₁, Function.Bijective (fun f : X ⟶ Q => g ≫ G.map f))
      (φ : T' ⟶ F.obj T) (_hφ : IsIso φ) (Q : C₂),
      Function.Bijective
        (fun x : A ⟶ Q => (φ ≫ F.map g ≫ ω.app X ≫ G'.map θ.hom) ≫ G'.map x) := by
    intro C₁ C₂ D₁ D₂ _ _ _ _ L R adj G G' F H adjS χ ω hω X A T T' θ g hg φ hφ Q
    have heq : (fun x : A ⟶ Q => (φ ≫ F.map g ≫ ω.app X ≫ G'.map θ.hom) ≫ G'.map x) =
        (fun z => φ ≫ z) ∘ (adjS.homEquiv T (G'.obj Q)).symm ∘ (fun k => k ≫ χ.hom.app Q) ∘
          (fun f => g ≫ G.map f) ∘ (adj.homEquiv X Q) ∘ (fun x => θ.hom ≫ x) := by
      funext x
      simp only [Function.comp_apply, Category.assoc]
      rw [← G'.map_comp, hω, ← Adjunction.homEquiv_naturality_left_symm]
    rw [heq]
    have b1 : Function.Bijective (fun x : A ⟶ Q => θ.hom ≫ x) :=
      Function.bijective_iff_has_inverse.mpr ⟨fun x' => θ.inv ≫ x',
        fun x => by simp, fun x => by simp⟩
    have b4 : Function.Bijective (fun k : T ⟶ G.obj (R.obj Q) => k ≫ χ.hom.app Q) :=
      Function.bijective_iff_has_inverse.mpr ⟨fun k' => k' ≫ χ.inv.app Q,
        fun k => by simp, fun k => by simp⟩
    have b6 : Function.Bijective (fun z : F.obj T ⟶ G'.obj Q => φ ≫ z) :=
      Function.bijective_iff_has_inverse.mpr ⟨fun z' => inv φ ≫ z',
        fun z => by simp, fun z => by simp⟩
    exact b6.comp ((Equiv.bijective _).comp (b4.comp ((hg (R.obj Q)).comp
      ((Equiv.bijective _).comp b1))))

  have hIso : ∀ {C D : Type (u+2)} [Category.{u+1} C] [Category.{u+1} D] (G' : C ⥤ D)
      {A : C} {T : D}
      (g' : T ⟶ G'.obj A) (_hg' : ∀ Q : C, Function.Bijective (fun x : A ⟶ Q => g' ≫ G'.map x))
      (M₀ : T ⟶ G'.obj A) (_hM : ∀ Q : C, Function.Bijective (fun x : A ⟶ Q => M₀ ≫ G'.map x)),
