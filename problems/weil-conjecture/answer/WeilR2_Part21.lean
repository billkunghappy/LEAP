          show bc.map (prod.map (𝟙 V) f) ≫ (PreservesLimitPair.iso bc V W').hom =
            (PreservesLimitPair.iso bc V W).hom ≫ prod.map (𝟙 (bc.obj V)) (bc.map f)
          rw [PreservesLimitPair.iso_hom, PreservesLimitPair.iso_hom, prodComparison_natural,
            bc.map_id])
    have hχ : ∀ W : C, (χ.hom.app W).left ≫ (Over.forgetAdjStar (bc.obj V)).counit.app (bc.obj W) =
        bc.map ((Over.forgetAdjStar V).counit.app W) := fun W => by
      show (PreservesLimitPair.iso bc V W).hom ≫ _ = _
      rw [PreservesLimitPair.iso_hom, Over.forgetAdjStar_counit_app, Over.forgetAdjStar_counit_app,
        prodComparison_snd]
      rfl
    let R : Sheaf (K.over (bc.obj V)) AddCommGrpCat.{u+1} ⥤ ((Over V)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) :=
