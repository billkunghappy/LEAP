        (Ps k).coeff e = MvPowerSeries.coeff e F := by
      intro k e he
      rw [htel k, MvPolynomial.coeff_sum, Finset.sum_eq_single (Finsupp.degree e)]
      · rfl
      · intro j _ hj
        exact (hH j).coeff_eq_zero (Ne.symm hj)
      · intro h
        exact absurd (Finset.mem_range.2 he) h
    refine ⟨F, fun k => ?_⟩
    have hD : MvPolynomial.aeval α (MvPowerSeries.trunc' K
        (Finsupp.equivFunOnFinite.symm (fun _ : Fin n => k)) F - Ps k) ∈ J ^ k := by
      apply star
      intro e he
      rw [MvPolynomial.coeff_sub, MvPowerSeries.coeff_trunc', if_pos (hbox k e he),
