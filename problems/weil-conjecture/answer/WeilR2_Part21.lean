        (((toSheafify (Scheme.ProEt.topology X) ((wcProEtBaseChange i).op ⋙ E.obj)).app
          (Opposite.op Q)).hom e) =
      ((toSheafify (Scheme.ProEt.topology X) ((wcProEtBaseChange i).op ⋙ E.obj)).app
          (Opposite.op Q₂)).hom
        ((E.obj.map ((wcProEtBaseChange i).map a').op).hom e) := by
    intro a' e
    have := congrArg (fun f => f.hom e)
