    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens)
    (hUb : ∀ p : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left, p ∈ Ub ↔
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom p ∉ Δ)
    (hcpt : CompactSpace Ub.toScheme) (q k : ℕ) :
    ∃ (N : ℕ) (V : Fin N → Scheme.{u}) (v : ∀ j, V j ⟶ Ub.toScheme),
      (∀ j, Etale (v j)) ∧ (∀ x : Ub.toScheme, ∃ j, x ∈ Set.range (v j)) ∧
      ∃ hV : ∀ j, WeaklyEtale (v j ≫ Ub.ι ≫
        (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom),
      ∃ (b : Fin N → ℕ) (e : ∀ j, Fin (b j) → ℕ), ∀ j,
        Nonempty ((((wcProEtPush h).rightDerived q).obj (wcContSheaf X (ZMod (ℓ ^ k)))).over
            (MorphismProperty.Over.mk ⊤ (v j ≫ Ub.ι ≫
              (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) (hV j)) ≅
          (wcContSheaf (wcProjK F'' M') ((i : Fin (b j)) → ZMod (ℓ ^ e j i))).over
            (MorphismProperty.Over.mk ⊤ (v j ≫ Ub.ι ≫
              (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) (hV j))) :=
by
  classical
  haveI hPw : WeaklyEtale (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom := hPP
  haveI hProp : IsProper (wcProjKStr F'' M') := wc_proj_space_isProper F'' M'

  have hℓK : (ℓ : F'') ≠ 0 := by
    intro h0
    haveI := Fintype.ofFinite F''
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have h1 : ringChar F'' ∣ ℓ := ringChar.dvd h0
    have h2 : ringChar F'' = ℓ := (Nat.prime_dvd_prime_iff_eq hp (Fact.out)).mp h1
    have h3 : ((Fintype.card F'' : ℕ) : F'') = 0 := FiniteField.cast_card_eq_zero F''
    have h4 : ringChar F'' ∣ Fintype.card F'' := ringChar.dvd h3
