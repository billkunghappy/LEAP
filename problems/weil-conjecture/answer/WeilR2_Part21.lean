      have hFc : IsClosed (Limits.pullback.snd h (e'.inv ≫ Vξ.hom) ⁻¹'
          {IsLocalRing.closedPoint A'}) :=
        (IsLocalRing.isClosed_singleton_closedPoint A').preimage
          (Limits.pullback.snd h (e'.inv ≫ Vξ.hom)).continuous
      have heq : ({x₀} : Set ↥(Limits.pullback h (e'.inv ≫ Vξ.hom))) =
          Limits.pullback.snd h (e'.inv ≫ Vξ.hom) ⁻¹' {IsLocalRing.closedPoint A'} ∩
