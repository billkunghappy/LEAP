  have wc_plt_hlgc_lowest_form : ∃ I : ℕ → Ideal R, (∀ (N : ℕ) (r : R), r ∈ I N ↔ ∀ j < N, GradedRing.proj 𝒜 j r = 0) ∧ (∀ k : ℕ, (HomogeneousIdeal.irrelevant 𝒜).toIdeal ^ k ≤ I k) ∧ (∀ (i j : ℕ) (a b : R), a ∉ I (i + 1) → b ∉ I (j + 1) → a * b ∉ I (i + j + 1)) ∧ (∀ s : R, s ∉ (HomogeneousIdeal.irrelevant 𝒜).toIdeal → ∀ (N : ℕ) (r : R), s * r ∈ I N → r ∈ I N) := by
    classical
    have PF : ∀ (a b : R) (n : ℕ), GradedRing.proj 𝒜 n (a * b) =
