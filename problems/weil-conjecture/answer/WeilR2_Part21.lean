            · intro p
              exact ⟨ObjectProperty.homMk p, rfl⟩
        let Es : Sheaf K AddCommGrpCat.{u+1} :=
          ⟨(Over.star (bc.obj V)).op ⋙ E.obj, Functor.op_comp_isSheaf _ _ _ E⟩
        let e' := (Adjunction.whiskerLeft AddCommGrpCat.{u+1}
          (Over.forgetAdjStar (bc.obj V)).op).homEquiv (L.obj G).obj E.obj
        let e := (Adjunction.whiskerLeft AddCommGrpCat.{u+1}
          (Over.forgetAdjStar V).op).homEquiv G.obj ((Over.post bc).op ⋙ E.obj)
        let I := Functor.isoWhiskerRight (NatIso.op χ) E.obj
        let C1 : ((L.obj G).over (bc.obj V) ⟶ E) → (L.obj G ⟶ Es) :=
          fun g => ObjectProperty.homMk (e' g.hom)
        let C2 : (L.obj G ⟶ Es) → (G.obj ⟶ bc.op ⋙ Es.obj) :=
          fun k => uG ≫ Functor.whiskerLeft bc.op k.hom
        let C3 : (G.obj ⟶ bc.op ⋙ Es.obj) →
            (G.obj ⟶ (Over.star V).op ⋙ (Over.post bc).op ⋙ E.obj) :=
          fun q => q ≫ (I.hom : bc.op ⋙ Es.obj ⟶ (Over.star V).op ⋙ (Over.post bc).op ⋙ E.obj)
        have hC1 : Function.Bijective C1 := by
          constructor
          · intro g1 g2 h
