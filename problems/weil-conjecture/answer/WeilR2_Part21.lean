    rw [reassoc_of% hθ₂, hψ2, ← Category.assoc a₁, ← hθ₁]
    simp only [Category.assoc, Iso.inv_hom_id_assoc]

theorem wc_pfam_xwt_trait_sing_morse_model (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (j : Fin D.m) (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : Vy.left ≅ Spec (.of A))
    (hVy : Vy.hom (e.inv (IsLocalRing.closedPoint A)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (L : Type u) [Field L] [IsSepClosed L] (eL : Ty.left ≅ Spec (.of L))
    (Vξ : (wcProjK F'' M').ProEt) (ι : Vξ ⟶ Vy) (uξ : Ty ⟶ Vξ)
    (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    (e' : Vξ.left ≅ Spec (.of A')) (hιu : uξ ≫ ι = uy)
    (hΔξ : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      ((ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))) ∈ Δ)
    (hclξ : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
      y ∈ closure {(ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))})
    (x : ↥(Limits.pullback Vξ.hom h))
    (hx : (Limits.pullback.fst Vξ.hom h ≫ e'.hom) x = IsLocalRing.closedPoint A')
    (hsing : ¬ ∃ U : (Limits.pullback Vξ.hom h).Opens,
      x ∈ U ∧ Smooth (U.ι ≫ Limits.pullback.fst Vξ.hom h ≫ e'.hom))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback Vξ.hom h) x))
      (Scheme.Etale.forget (Limits.pullback Vξ.hom h)))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ Limits.pullback Vξ.hom h)
    (hB : wcHalShData x B Λ' W'' φ' a') :
    ∃ (_ : IsDomain A'), IsDiscreteValuationRing A' ∧ ∃ (π : A') (c : Matrix (Fin n) (Fin n) A'),
      IsLocalRing.maximalIdeal A' = Ideal.span {π} ∧ IsUnit (c + c.transpose).det ∧
      ∃ (x₀ : Spec (.of (wcQuadModelRing A' n π c))),
        (∀ r : Fin n, Ideal.Quotient.mk (wcQuadModelIdeal A' n π c) (MvPolynomial.X r) ∈
          PrimeSpectrum.asIdeal x₀) ∧
        wcQuadModelStr A' n π c x₀ = IsLocalRing.closedPoint A' ∧
        ∃ (B₀ : Type u) (_ : CommRing B₀) (_ : HenselianLocalRing B₀)
          (_ : IsSepClosed (IsLocalRing.ResidueField B₀)) (Λ₀ : Type u) (_ : SmallCategory Λ₀)
          (_ : IsCofiltered Λ₀)
          (W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A' n π c))) x₀))
            (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A' n π c)))))
          (φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left)
          (a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A' n π c))),
          wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀ ∧
          ∃ θ : Spec (.of B) ≅ Spec (.of B₀),
            θ.hom ≫ a₀ ≫ wcQuadModelStr A' n π c = a' ≫ Limits.pullback.fst Vξ.hom h ≫ e'.hom :=
by
  classical
  obtain ⟨x₀, hx₀cl, hsm', hmod⟩ := wc_pfam_xwt_trait_odp_model F' F'' Y n hn hn2 D ℓ hℓ M' Xu h
    Δ lam p hH hPP j Vy Ty uy vy A e hVy L eL Vξ ι uξ A' e' hιu hΔξ hclξ
  have w₁ : Limits.pullback.snd Vξ.hom h ≫ h =
      (Limits.pullback.fst Vξ.hom h ≫ e'.hom) ≫ e'.inv ≫ Vξ.hom := by
    rw [Category.assoc, Iso.hom_inv_id_assoc]
    exact Limits.pullback.condition.symm
  have w₂ : (Limits.pullback.snd h (e'.inv ≫ Vξ.hom) ≫ e'.inv) ≫ Vξ.hom =
      Limits.pullback.fst h (e'.inv ≫ Vξ.hom) ≫ h := by
    rw [Category.assoc]
    exact Limits.pullback.condition.symm
  let ψ : Limits.pullback Vξ.hom h ⟶ Limits.pullback h (e'.inv ≫ Vξ.hom) :=
    Limits.pullback.lift _ _ w₁
  let χ : Limits.pullback h (e'.inv ≫ Vξ.hom) ⟶ Limits.pullback Vξ.hom h :=
    Limits.pullback.lift _ _ w₂
  have hψf : ψ ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom) =
      Limits.pullback.fst Vξ.hom h ≫ e'.hom :=
    Limits.pullback.lift_snd _ _ _
  have hψ1 : ψ ≫ Limits.pullback.fst h (e'.inv ≫ Vξ.hom) = Limits.pullback.snd Vξ.hom h :=
    Limits.pullback.lift_fst _ _ _
  have hχ1 : χ ≫ Limits.pullback.fst Vξ.hom h =
      Limits.pullback.snd h (e'.inv ≫ Vξ.hom) ≫ e'.inv :=
    Limits.pullback.lift_fst _ _ _
  have hχ2 : χ ≫ Limits.pullback.snd Vξ.hom h = Limits.pullback.fst h (e'.inv ≫ Vξ.hom) :=
    Limits.pullback.lift_snd _ _ _
  have hψχ : ψ ≫ χ = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hχ1, ← Category.assoc, hψf, Category.assoc, Iso.hom_inv_id,
        Category.comp_id, Category.id_comp]
    · rw [Category.assoc, hχ2, hψ1, Category.id_comp]
  have hχψ : χ ≫ ψ = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hψ1, hχ2, Category.id_comp]
    · rw [Category.assoc, hψf, ← Category.assoc, hχ1, Category.assoc, Iso.inv_hom_id,
        Category.comp_id, Category.id_comp]
  haveI : IsIso ψ := ⟨⟨χ, hψχ, hχψ⟩⟩
  haveI : Etale ψ := inferInstance
  have hx' : Limits.pullback.snd h (e'.inv ≫ Vξ.hom) (ψ x) = IsLocalRing.closedPoint A' := by
    rw [← Scheme.Hom.comp_apply, hψf]
    exact hx
  have hψx : ψ x = x₀ := by
    by_contra hne
    obtain ⟨U', hxU', hU'⟩ := hsm' (ψ x) hx' hne
    apply hsing
    refine ⟨ψ ⁻¹ᵁ U', (Scheme.Hom.mem_preimage ψ).mpr hxU', ?_⟩
    have heq : (ψ ⁻¹ᵁ U').ι ≫ Limits.pullback.fst Vξ.hom h ≫ e'.hom =
        (ψ ∣_ U') ≫ (U'.ι ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) := by
      rw [← hψf, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    rw [heq]
    haveI := hU'
    infer_instance
  obtain ⟨B₁, i1, i2, i3, Λ₁, i4, i5, W₁, φ₁, a₁, ε₁, k1, k2, k3, k4, k5, k6, k7⟩ :=
    wc_et_geom_strict_henselization x₀
  have hB₁ : wcHalShData x₀ B₁ Λ₁ W₁ φ₁ a₁ := ⟨k1, k2, k3, k4, k5, ε₁, k6, k7⟩
  obtain ⟨hdom, hdvr, π, c, hπ, hc, x₁, hX, hx₁, B₀, j1, j2, j3, Λ₀, j4, j5, W₀, φ₀, a₀, hB₀,
    θ₁, hθ₁⟩ := hmod B₁ Λ₁ W₁ φ₁ a₁ hB₁
  obtain ⟨ι₀, hι₀⟩ := wc_etale_geom_point_residue_iso ψ x x₀ hψx
  obtain ⟨θ₂, hθ₂⟩ := wc_shdata_etale_iso ψ x x₀ ι₀ hι₀ B Λ' W'' φ' a' hB B₁ Λ₁ W₁ φ₁ a₁ hB₁
  refine ⟨hdom, hdvr, π, c, hπ, hc, x₁, hX, hx₁, B₀, j1, j2, j3, Λ₀, j4, j5, W₀, φ₀, a₀, hB₀,
    θ₂ ≪≫ θ₁, ?_⟩
  rw [Iso.trans_hom, Category.assoc, hθ₁, ← Category.assoc, hθ₂, Category.assoc, hψf]

theorem wc_pfam_xwt_sp_torsion_injective (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (j : Fin D.m) (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : Vy.left ≅ Spec (.of A))
    (hVy : Vy.hom (e.inv (IsLocalRing.closedPoint A)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (L : Type u) [Field L] [IsSepClosed L] (eL : Ty.left ≅ Spec (.of L))
    (Vξ : (wcProjK F'' M').ProEt) (ι : Vξ ⟶ Vy) (uξ : Ty ⟶ Vξ)
    (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    (e' : Vξ.left ≅ Spec (.of A')) (hιu : uξ ≫ ι = uy)
    (hΔξ : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      ((ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))) ∈ Δ)
    (hclξ : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
      y ∈ closure {(ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))})
    (k : ℕ) (hk : 1 ≤ k) (Dk : wcZModPullData ((wcProEtPullback h).map uξ).left (ℓ ^ k))
    (hDk : wcZModPullCanonical Dk) :
    Function.Injective (wcZModPull Dk (n - 1)) :=
by
  classical

  have hH' := hH
  obtain ⟨-, -, -, -, hΔc, -, -, -, -, -, -, hlamΔ, -⟩ := hH'
  obtain ⟨-, hprop, hc1, hq1, -, -⟩ := wc_pfam_line_fibre_square D M' Xu h Δ lam p hH Vξ A' e'
  obtain ⟨-, -, hc2, hq2, -, -⟩ := wc_pfam_line_fibre_square D M' Xu h Δ lam p hH Ty L eL
  haveI := hprop
  have hm0 : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k

  have hℓK : ((ℓ : ℕ) : F'') ≠ 0 := by
    intro h0
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have hdvd : ringChar F'' ∣ ℓ := (ringChar.spec F'' ℓ).mp h0
    have hpl : ringChar F'' = ℓ :=
      ((Fact.out : ℓ.Prime).eq_one_or_self_of_dvd _ hdvd).resolve_left hp.ne_one
    letI := Fintype.ofFinite F''
    have hc : ((Fintype.card F'' : ℕ) : F'') = 0 := FiniteField.cast_card_eq_zero F''
    have hc' : ringChar F'' ∣ Fintype.card F'' := (ringChar.spec F'' _).mp hc
    apply hℓ
    rw [← hpl, Nat.card_eq_fintype_card]
    exact hc'
  have hunitK : IsUnit (((ℓ ^ k : ℕ) : F'')) :=
    isUnit_iff_ne_zero.mpr (by rw [Nat.cast_pow]; exact pow_ne_zero _ hℓK)
  have hmu : IsUnit (((ℓ ^ k : ℕ) : A')) := by
    have h1 := hunitK.map (Spec.preimage (e'.inv ≫ Vξ.hom ≫ wcProjKStr F'' M')).hom
    rwa [map_natCast] at h1
  have hunitℓ : IsUnit (((ℓ : ℕ) : A')) := by
    have h1 := (isUnit_iff_ne_zero.mpr hℓK).map
      (Spec.preimage (e'.inv ≫ Vξ.hom ≫ wcProjKStr F'' M')).hom
    rwa [map_natCast] at h1

  obtain ⟨τ⟩ : Nonempty (Spec (.of (AlgebraicClosure L)) ⟶ Ty.left) :=
    ⟨Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) ≫ eL.inv⟩
  obtain ⟨ξ, hξd⟩ : ∃ ξ : Spec (.of (AlgebraicClosure L)) ⟶ Spec (.of A'),
      ξ = τ ≫ uξ.left ≫ e'.hom := ⟨_, rfl⟩

  have hξ : ξ (IsLocalRing.closedPoint (AlgebraicClosure L)) ≠ IsLocalRing.closedPoint A' := by
    intro hcl
    generalize IsLocalRing.closedPoint (AlgebraicClosure L) = c at hcl
    have hsubT : ∀ a b : Ty.left, a = b := by
      intro a b
      have hab : eL.hom a = eL.hom b := Subsingleton.elim _ _
      exact (Scheme.hom_inv_apply eL a).symm.trans
        ((congrArg (fun z => eL.inv z) hab).trans (Scheme.hom_inv_apply eL b))
    haveI := wc_proj_space_irreducible F'' M'
    haveI : WeaklyEtale Ty.hom := Ty.prop
    have hgen := Flat.generalizingMap Ty.hom
    have hη : genericPoint (wcProjK F'' M') ⤳ Ty.hom (τ c) :=
      (genericPoint_spec (wcProjK F'' M')).specializes (Set.mem_univ _)
    obtain ⟨t', -, ht'⟩ := hgen hη
    have hTy : Ty.hom (τ c) = genericPoint (wcProjK F'' M') := by
      rw [← hsubT t' (τ c)]
      exact ht'
    have e1 : e'.hom (uξ.left (τ c)) = IsLocalRing.closedPoint A' := by
      rw [← hcl, hξd]
      exact ((Scheme.Hom.comp_apply τ (uξ.left ≫ e'.hom) c).trans
        (Scheme.Hom.comp_apply uξ.left e'.hom (τ c))).symm
    have e2 : uξ.left (τ c) = e'.inv (IsLocalRing.closedPoint A') := by
      rw [← e1, Scheme.hom_inv_apply]
    have w1 : Ty.hom (τ c) = Vξ.hom (uξ.left (τ c)) := by
      rw [← MorphismProperty.Over.w uξ, Scheme.Hom.comp_apply]
    have hcomp : (ι ≫ vy).left = ι.left ≫ vy.left := by
      first
        | rfl
        | exact MorphismProperty.Comma.comp_left ι vy
    have w2 : Vξ.hom (e'.inv (IsLocalRing.closedPoint A')) =
        (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
          ((ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))) := by
      have a1 : Vξ.hom (e'.inv (IsLocalRing.closedPoint A')) =
          (ι.left ≫ Vy.hom) (e'.inv (IsLocalRing.closedPoint A')) := by
        rw [MorphismProperty.Over.w ι]
      have a2 : Vy.hom (ι.left (e'.inv (IsLocalRing.closedPoint A'))) =
          (vy.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom)
            (ι.left (e'.inv (IsLocalRing.closedPoint A'))) := by
        rw [MorphismProperty.Over.w vy]
      have a3 : (ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A')) =
          vy.left (ι.left (e'.inv (IsLocalRing.closedPoint A'))) :=
        (congrArg (fun f : Vξ.left ⟶ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left =>
          f (e'.inv (IsLocalRing.closedPoint A'))) hcomp).trans (Scheme.Hom.comp_apply _ _ _)
      rw [a3]
      exact a1.trans ((Scheme.Hom.comp_apply _ _ _).trans
        (a2.trans (Scheme.Hom.comp_apply _ _ _)))
    have e3 : Ty.hom (τ c) ∈ Δ := by
      rw [w1, e2, w2]
      exact hΔξ
    rw [hTy] at e3
    have h4 : lam (D.u0 (IsLocalRing.closedPoint F'')) ∈ Δ :=
      ((genericPoint_spec (wcProjK F'' M')).specializes
        (Set.mem_univ (lam (D.u0 (IsLocalRing.closedPoint F''))))).mem_closed hΔc e3
    obtain ⟨i, hi⟩ := (hlamΔ _).mp h4
    exact D.hu0S i hi

  have hdev : ∀ (T : Scheme.{u}) (q : ℕ), Subsingleton (wcEtCoh T ℓ q) →
      ∀ k : ℕ, Subsingleton (wcEtCoh T (ℓ ^ k) q) := by
    intro T q hq
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hmid : ∀ (X : Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})
        (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1})),
        S.ShortExact → Subsingleton (Abelian.Ext X S.X₁ q) →
        Subsingleton (Abelian.Ext X S.X₃ q) → Subsingleton (Abelian.Ext X S.X₂ q) := by
      intro X S hS h1 h3
      let ψ' : Abelian.Ext X S.X₂ q →+ Abelian.Ext X S.X₃ q :=
        (Abelian.Ext.mk₀ S.g).postcomp X (add_zero q)
