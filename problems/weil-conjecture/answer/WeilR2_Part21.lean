    have e1 : Limits.pullback.fst h a x = u cU := huniq _ _ hhx' huc hhx hns
    apply hne
    exact wc_pullback_point_unique_of_residue_bij h a (u cU) (IsLocalRing.closedPoint A') huc
      (hres _ huc hns) x x₀ e1 hx₀1 hx hx₀2

  · intro B _ _ _ Λ' _ _ W'' φ' a' hB
    obtain ⟨B₀, _, _, _, Λ₀, _, _, W₀, φ₀, a₀, e₀, h01, h02, h03, h04, h05, h06, h07⟩ :=
      wc_et_geom_strict_henselization (ψ x'')
    have hB₀ : wcHalShData (ψ x'') B₀ Λ₀ W₀ φ₀ a₀ := ⟨h01, h02, h03, h04, h05, e₀, h06, h07⟩
    obtain ⟨B₁, _, _, _, Λ₁, _, _, W₁, φ₁, a₁, e₁, h11, h12, h13, h14, h15, h16, h17⟩ :=
      wc_et_geom_strict_henselization x''
    have hB₁ : wcHalShData x'' B₁ Λ₁ W₁ φ₁ a₁ := ⟨h11, h12, h13, h14, h15, e₁, h16, h17⟩
    obtain ⟨ι₁, hι₁⟩ := wc_etale_geom_point_residue_iso
      (Limits.pullback.snd u (Limits.pullback.fst h a)) x'' x₀ hx''2
    obtain ⟨θ₁, hθ₁⟩ := wc_shdata_etale_iso (Limits.pullback.snd u (Limits.pullback.fst h a))
      x'' x₀ ι₁ hι₁ B₁ Λ₁ W₁ φ₁ a₁ hB₁ B Λ' W'' φ' a' hB
    obtain ⟨ι₂, hι₂⟩ := wc_etale_geom_point_residue_iso ψ x'' (ψ x'') rfl
    obtain ⟨θ₂, hθ₂⟩ := wc_shdata_etale_iso ψ x'' (ψ x'') ι₂ hι₂ B₁ Λ₁ W₁ φ₁ a₁ hB₁
      B₀ Λ₀ W₀ φ₀ a₀ hB₀
    refine ⟨hdom, hdvr, ρ φ, cR.map ρ, hmax, hc', ψ x'', hTx₁, hStrx₁, B₀, inferInstance,
      inferInstance, inferInstance, Λ₀, inferInstance, inferInstance, W₀, φ₀, a₀, hB₀,
      θ₁.symm ≪≫ θ₂, ?_⟩
