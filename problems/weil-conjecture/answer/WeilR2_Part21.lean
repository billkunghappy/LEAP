    have hαXn : α (MvPolynomial.X none) = Q₀ := by rw [hαdef, MvPolynomial.eval₂Hom_X']; rfl
    have hαXs : ∀ k, α (MvPolynomial.X (some k)) = MvPolynomial.X (Sum.inr k) := fun k => by
