    · obtain ⟨U, hpU, hsmU⟩ := hsm p hp hpx
      obtain ⟨h0, hq⟩ := wc_smooth_open_shens_milnor_fibre_acyclic A Y f U hsmU m hmu p hpU hp
        B₁ Λ₁ W₁ φ₁ a₁ hB₁ Ω z
