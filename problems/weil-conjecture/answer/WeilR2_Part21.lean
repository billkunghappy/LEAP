      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F q)
    constructor
    intro x y
    have key : ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology U.left)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F q,
        (Abelian.Ext.mk₀ eL.inv).comp ((Abelian.Ext.mk₀ eL.hom).comp z (zero_add _)) (zero_add _)
