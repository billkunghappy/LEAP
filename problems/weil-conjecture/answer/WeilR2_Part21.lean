        congrArg (· ≫ Limits.pullback.fst E.hom f ≫ eE.hom) hwu
    _ = Limits.pullback.fst ((wcProEtPullback f).map a₀).left u ≫
        Limits.pullback.fst E.hom f ≫ τ.left ≫ eE.hom :=
        (Category.assoc _ _ _).trans
          (congrArg (Limits.pullback.fst ((wcProEtPullback f).map a₀).left u ≫ ·) h3)
    _ = (Limits.pullback.fst ((wcProEtPullback f).map a₀).left u ≫
        Limits.pullback.fst E.hom f ≫ eE.hom) ≫ eE.inv ≫ τ.left ≫ eE.hom :=
        ((congrArg (Limits.pullback.fst ((wcProEtPullback f).map a₀).left u ≫ ·)
          (congrArg (Limits.pullback.fst E.hom f ≫ ·)
            (Iso.hom_inv_id_assoc eE (τ.left ≫ eE.hom)).symm)).trans
          (congrArg (Limits.pullback.fst ((wcProEtPullback f).map a₀).left u ≫ ·)
            (Category.assoc (Limits.pullback.fst E.hom f) eE.hom
              (eE.inv ≫ τ.left ≫ eE.hom)).symm)).trans
          (Category.assoc _ _ _).symm
    _ = _ := congrArg (fun t => (Limits.pullback.fst ((wcProEtPullback f).map a₀).left u ≫
        Limits.pullback.fst E.hom f ≫ eE.hom) ≫ t) hσ.symm

theorem wc_pltr_model_data (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L]
    (eE : E.left ≅ Spec (.of L)) (τ : E ⟶ E)
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (hcomp : ((wcProEtPullback D.f).map τ).left ≫ ((wcProEtPullback D.f).map a₀).left =
      ((wcProEtPullback D.f).map a₀).left) :
    ∃ (_ : IsDomain A), IsDiscreteValuationRing A ∧
    ∃ (π : A) (c : Matrix (Fin n) (Fin n) A),
      IsLocalRing.maximalIdeal A = Ideal.span {π} ∧ IsUnit (c + c.transpose).det ∧
    ∃ (x₀ : Spec (.of (wcQuadModelRing A n π c))),
      (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
        PrimeSpectrum.asIdeal x₀) ∧
    ∃ (B₀ : Type u) (_ : CommRing B₀) (_ : HenselianLocalRing B₀)
      (_ : IsSepClosed (IsLocalRing.ResidueField B₀))
      (Λ₀ : Type u) (_ : SmallCategory Λ₀) (_ : IsCofiltered Λ₀)
      (W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
        (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c)))))
      (φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left)
      (a₀' : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))),
      wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀' ∧
    ∃ (u : Spec (.of B₀) ⟶ ((wcProEtPullback D.f).obj V).left), WeaklyEtale u ∧
    ∃ (XE : Scheme.{u}) (u' : XE ⟶ ((wcProEtPullback D.f).obj E).left)
      (p : XE ⟶ Spec (.of B₀)) (q : XE ⟶ Spec (.of L)),
      IsPullback u' p ((wcProEtPullback D.f).map a₀).left u ∧
      IsPullback p q (a₀' ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom)) ∧
    ∃ (Xs : Scheme.{u})
      (uZ : Xs ⟶ Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A))
      (ι : Xs ⟶ Spec (.of B₀)) (s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))),
      IsPullback uZ ι (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom) (wcQmSp A) :
        _ ⟶ ((wcProEtPullback D.f).obj V).left) u ∧
      IsPullback ι s (a₀' ≫ wcQuadModelStr A n π c) (wcQmSp A) ∧
    ∃ (w : XE ⟶ XE), w ≫ p = p ∧
      w ≫ q = q ≫ Spec.map (CommRingCat.ofHom (Spec.preimage (eE.inv ≫ τ.left ≫ eE.hom)).hom) ∧
      w ≫ u' = u' ≫ ((wcProEtPullback D.f).map τ).left :=
by
  classical
  obtain ⟨aA, haA⟩ : ∃ aA : Spec (.of A) ⟶ (wcP1Over F'').left, aA = e.inv ≫ V.hom := ⟨_, rfl⟩
  have ha : aA (IsLocalRing.closedPoint A) = D.S i (IsLocalRing.closedPoint F'') := by
    subst haA; exact (Scheme.Hom.comp_apply _ _ _).trans hV
  haveI : WeaklyEtale V.hom := V.prop
  have hwa : WeaklyEtale aA := by rw [haA]; infer_instance

  obtain ⟨ε, hεint, hεeq⟩ := wc_pltr_wet_residue_geom_point _ A aA hwa ha
  have hqpt : (Spec.map (CommRingCat.ofHom ε) ≫ Spec.map (CommRingCat.ofHom
      (IsLocalRing.residue A))) (IsLocalRing.closedPoint (AlgebraicClosure
        ((wcP1Over F'').left.residueField (D.S i (IsLocalRing.closedPoint F''))))) =
      IsLocalRing.closedPoint A := by
    refine (Scheme.Hom.comp_apply _ _ _).trans ?_
    refine (congrArg (fun z => (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) z)
      (Subsingleton.elim _ (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)))).trans ?_
    exact (Spec.map_apply _ _).trans (IsLocalRing.comap_closedPoint (IsLocalRing.residue A))
  have hqc : (Spec.map (CommRingCat.ofHom ε) ≫ Spec.map (CommRingCat.ofHom
      (IsLocalRing.residue A))) ≫ aA =
      wcEtGeomPt (wcP1Over F'').left (D.S i (IsLocalRing.closedPoint F'')) := by
    rw [Category.assoc]; exact hεeq

  obtain ⟨A₁, _, _, _, Λ, _, _, W', φ₁, a₁, e₁, h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_et_geom_strict_henselization (D.S i (IsLocalRing.closedPoint F''))
  have hsh₁ : wcHalShData (D.S i (IsLocalRing.closedPoint F'')) A₁ Λ W' φ₁ a₁ :=
    ⟨h1, h2, h3, h4, h5, e₁, h6, h7⟩
  obtain ⟨δ, hδ, -⟩ := wc_shdata_lift_geom_point _ A₁ Λ W' φ₁ a₁ hsh₁ A aA _ hqpt hqc

  haveI hδiso : IsIso δ := wc_pltr_shens_lift_iso _ A₁ Λ W' φ₁ a₁ hsh₁ A aA hwa ha δ hδ

  have hshA' := wc_pltr_shdata_iso_transport _ A₁ A Λ W' φ₁ a₁ hsh₁ δ hδiso ε hεint
    (by rw [hδ]; exact hεeq)
  rw [hδ] at hshA'

  have hpt : D.f (D.xs i (IsLocalRing.closedPoint F'')) = aA (IsLocalRing.closedPoint A) := by
    rw [ha, ← D.hxs i]; rfl
  obtain ⟨x', hx'₁, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := D.f) (g := aA) _ _ hpt
  obtain ⟨B, _, _, _, Λ', _, _, W'', φ', a', eB, g1, g2, g3, g4, g5, g6, g7⟩ :=
    wc_et_geom_strict_henselization x'
  have hsh' : wcHalShData x' B Λ' W'' φ' a' := ⟨g1, g2, g3, g4, g5, eB, g6, g7⟩

  obtain ⟨hdom, hdvr, π, c, hπ, hc, x₀, hx₀, -, B₀, iB1, iB2, iB3, Λ₀, iL1, iL2, W₀, φ₀, a₀',
      hsh₀, θ, hθ⟩ :=
    wc_pencil_odp_shens_morse_model F' F'' Y n hn hn2 D i A Λ W' (fun l => δ ≫ φ₁ l) aA hshA'
      x' hx'₁ B Λ' W'' φ' a' hsh'

  have hκw : (Limits.pullback.snd D.f aA ≫ e.inv) ≫ V.hom =
      Limits.pullback.fst D.f aA ≫ D.f := by
    rw [Category.assoc, ← haA]; exact Limits.pullback.condition.symm
  have hκw' : Limits.pullback.snd V.hom D.f ≫ D.f =
      (Limits.pullback.fst V.hom D.f ≫ e.hom) ≫ aA := by
    rw [haA, Category.assoc, e.hom_inv_id_assoc]; exact Limits.pullback.condition.symm
  let κ : Limits.pullback D.f aA ⟶ Limits.pullback V.hom D.f :=
    Limits.pullback.lift (Limits.pullback.snd D.f aA ≫ e.inv) (Limits.pullback.fst D.f aA) hκw
  let κ' : Limits.pullback V.hom D.f ⟶ Limits.pullback D.f aA :=
    Limits.pullback.lift (Limits.pullback.snd V.hom D.f) (Limits.pullback.fst V.hom D.f ≫ e.hom)
      hκw'
  have k1 : κ ≫ Limits.pullback.fst V.hom D.f = Limits.pullback.snd D.f aA ≫ e.inv :=
    Limits.pullback.lift_fst _ _ _
  have k2 : κ ≫ Limits.pullback.snd V.hom D.f = Limits.pullback.fst D.f aA :=
    Limits.pullback.lift_snd _ _ _
  have k1' : κ' ≫ Limits.pullback.fst D.f aA = Limits.pullback.snd V.hom D.f :=
    Limits.pullback.lift_fst _ _ _
  have k2' : κ' ≫ Limits.pullback.snd D.f aA = Limits.pullback.fst V.hom D.f ≫ e.hom :=
    Limits.pullback.lift_snd _ _ _
  have hκκ' : κ ≫ κ' = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, k1', k2, Category.id_comp]
    · simp only [Category.assoc, k2', reassoc_of% k1, Iso.inv_hom_id, Category.comp_id,
        Category.id_comp]
  have hκ'κ : κ' ≫ κ = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, k1, reassoc_of% k2', Iso.hom_inv_id, Category.comp_id,
        Category.id_comp]
    · simp only [Category.assoc, k2, k1', Category.id_comp]
  haveI : IsIso κ := ⟨⟨κ', hκκ', hκ'κ⟩⟩
  haveI : WeaklyEtale a' := wc_shdata_weaklyEtale x' B Λ' W'' φ' a' hsh'
  have hu : WeaklyEtale (θ.inv ≫ a' ≫ κ) := inferInstance
  have hK : (θ.inv ≫ a' ≫ κ) ≫ Limits.pullback.fst V.hom D.f ≫ e.hom =
      a₀' ≫ wcQuadModelStr A n π c := by
    simp only [Category.assoc, κ, Limits.pullback.lift_fst_assoc, Iso.inv_hom_id,
      Category.comp_id]
    rw [← hθ, Iso.inv_hom_id_assoc]
  obtain ⟨XE, u', p, q', sq1, sq2, Xs, uZ, ι, s, sq3, sq4, w, hw1, hw2, hw3⟩ :=
    wc_pltr_model_squares_gen D.f V E a₀ τ A L e eE hcomp (θ.inv ≫ a' ≫ κ) _ hK
  exact ⟨hdom, hdvr, π, c, hπ, hc, x₀, hx₀, B₀, iB1, iB2, iB3, Λ₀, iL1, iL2, W₀, φ₀, a₀', hsh₀,
    θ.inv ≫ a' ≫ κ, hu, XE, u', p, q', sq1, sq2, Xs, uZ, ι, s, sq3, sq4, w, hw1, hw2, hw3⟩

theorem wc_pltr_model_ring_hyps (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] [HenselianLocalRing A]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (τ : E ⟶ E) (hτ : τ ≫ a₀ = a₀) :
    IsUnit ((ℓ : ℕ) : A) ∧ Function.Injective (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom ∧
      (letI := (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom.toAlgebra;
        Algebra.IsAlgebraic A L) ∧
      (Spec.preimage (eE.inv ≫ τ.left ≫ eE.hom)).hom.comp
          (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom =
        (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom :=
by
  classical

  have ha : IsUnit ((ℓ : ℕ) : A) := by
    have hne : ((ℓ : ℕ) : F'') ≠ 0 := by
      intro h0
      have h1 : ringChar F'' ∣ ℓ := ringChar.dvd h0
      have h2 : ringChar F'' = ℓ := by
        rcases (Fact.out : Nat.Prime ℓ).eq_one_or_self_of_dvd _ h1 with h | h
        · exact absurd h CharP.ringChar_ne_one
        · exact h
      letI := Fintype.ofFinite F''
      have h3 : ringChar F'' ∣ Fintype.card F'' :=
        ringChar.dvd (FiniteField.cast_card_eq_zero F'')
      apply hℓ
      rw [← h2, Nat.card_eq_fintype_card]
      exact h3
    have hu : IsUnit ((ℓ : ℕ) : F'') := IsUnit.mk0 _ hne
    have := hu.map (Spec.preimage (e.inv ≫ V.hom ≫ (wcP1Over F'').hom)).hom
    rwa [map_natCast] at this

  have hb : Function.Injective (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom := by
    rw [RingHom.injective_iff_ker_eq_bot]
    by_contra hne
    have hprime : (RingHom.ker (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom).IsPrime :=
      RingHom.ker_isPrime _
    have hmax : RingHom.ker (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom =
        IsLocalRing.maximalIdeal A :=
      IsLocalRing.eq_maximalIdeal (hprime.isMaximal hne)
    have hpt_gen : ∀ g : Spec (.of L) ⟶ Spec (.of A),
        RingHom.ker (Spec.preimage g).hom = IsLocalRing.maximalIdeal A →
        g (IsLocalRing.closedPoint L) = IsLocalRing.closedPoint A := by
      intro g hg
      have h1 := Spec.map_apply (Spec.preimage g) (IsLocalRing.closedPoint L)
      rw [Spec.map_preimage] at h1
      rw [h1]
      apply PrimeSpectrum.ext
      rw [PrimeSpectrum.comap_asIdeal]
      show Ideal.comap (Spec.preimage g).hom
          (IsLocalRing.maximalIdeal L) = IsLocalRing.maximalIdeal A
      rw [(IsLocalRing.maximalIdeal L).eq_bot_of_prime, ← RingHom.ker_eq_comap_bot, hg]
    have hpt : (eE.inv ≫ a₀.left ≫ e.hom) (IsLocalRing.closedPoint L) =
        IsLocalRing.closedPoint A := hpt_gen _ hmax
    apply hE (eE.inv (IsLocalRing.closedPoint L)) i
    rw [← hV, ← hpt]
    have hw : a₀.left ≫ V.hom = E.hom := MorphismProperty.Over.w a₀
    have key : (eE.inv ≫ a₀.left ≫ e.hom) ≫ (e.inv ≫ V.hom) = eE.inv ≫ E.hom := by
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
      rw [hw]
    calc E.hom (eE.inv (IsLocalRing.closedPoint L))
        = (eE.inv ≫ E.hom) (IsLocalRing.closedPoint L) := (Scheme.Hom.comp_apply _ _ _).symm
      _ = ((eE.inv ≫ a₀.left ≫ e.hom) ≫ (e.inv ≫ V.hom)) (IsLocalRing.closedPoint L) := by
          rw [key]
      _ = (e.inv ≫ V.hom) ((eE.inv ≫ a₀.left ≫ e.hom) (IsLocalRing.closedPoint L)) :=
          Scheme.Hom.comp_apply _ _ _
      _ = V.hom (e.inv ((eE.inv ≫ a₀.left ≫ e.hom) (IsLocalRing.closedPoint L))) :=
          Scheme.Hom.comp_apply _ _ _

  have hc : (letI := (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom.toAlgebra;
        Algebra.IsAlgebraic A L) := by
    letI := (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom.toAlgebra
    have hwe := wc_mnt_point_map_weaklyEtale (wcP1Over F'').left V E a₀ A L e eE
    haveI : FaithfulSMul A L := (faithfulSMul_iff_algebraMap_injective A L).mpr hb
    letI := FractionRing.liftAlgebra A L
    haveI := FractionRing.isScalarTower_liftAlgebra A L
    have h2 := (wc_mnt_fraction_field_weaklyEtale_algebraic A L hwe).2
    exact (IsFractionRing.comap_isAlgebraic_iff (A := A) (K := FractionRing A) (C := L)).mpr h2

  have hd : (Spec.preimage (eE.inv ≫ τ.left ≫ eE.hom)).hom.comp
        (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom =
      (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom := by
    have hτL : τ.left ≫ a₀.left = a₀.left := congrArg (fun f => f.left) hτ
    have hsg : (eE.inv ≫ τ.left ≫ eE.hom) ≫ (eE.inv ≫ a₀.left ≫ e.hom) =
        eE.inv ≫ a₀.left ≫ e.hom := by
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
      rw [reassoc_of% hτL]
    have h1 : Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom) ≫
        Spec.preimage (eE.inv ≫ τ.left ≫ eE.hom) = Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom) := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_preimage, Spec.map_preimage]
      exact hsg
    rw [← CommRingCat.hom_comp, h1]
  exact ⟨ha, hb, hc, hd⟩

theorem wc_pltr_tame_transfer (A : Type u) [CommRing A] [IsDomain A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) (ϖ π : A)
    (hϖ : IsLocalRing.maximalIdeal A = Ideal.span {ϖ})
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    (L : Type u) [Field L] (φA : A →+* L) (σ : L →+* L) (hσ : σ.comp φA = φA) :
    wcMntTame ℓ φA σ ϖ → wcMntTame ℓ φA σ π :=
by
  classical
  intro htame
  unfold wcMntTame at htame ⊢
  intro k hk z hz

  have hensel : ∀ n : ℕ, 0 < n → IsUnit ((n : ℕ) : A) → ∀ u : A, IsUnit u →
      ∃ v : A, v ^ n = u := by
    intro n hn0 hnA u hu
    have hu0 : IsLocalRing.residue A u ≠ 0 :=
      (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hu
    have hnk : ((n : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
      rw [← map_natCast (IsLocalRing.residue A)]
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hnA
    have hsep : (Polynomial.X ^ n - Polynomial.C (IsLocalRing.residue A u)).Separable :=
      Polynomial.separable_X_pow_sub_C _ hnk hu0
    have hdeg : (Polynomial.X ^ n - Polynomial.C (IsLocalRing.residue A u)).degree ≠ 0 := by
      rw [Polynomial.degree_X_pow_sub_C hn0]
      exact_mod_cast hn0.ne'
    obtain ⟨b, hb⟩ := IsSepClosed.exists_root _ hdeg hsep
    have hb' : b ^ n = IsLocalRing.residue A u := by
      simpa [Polynomial.IsRoot, sub_eq_zero] using hb
    obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective b
    have hb0 : b ≠ 0 := by
      rintro rfl
      rw [zero_pow hn0.ne'] at hb'
      exact hu0 hb'.symm
    have hmonic : (Polynomial.X ^ n - Polynomial.C u).Monic :=
      Polynomial.monic_X_pow_sub_C _ hn0.ne'
    have hfa : (Polynomial.X ^ n - Polynomial.C u).eval a₀ ∈ IsLocalRing.maximalIdeal A := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
        map_sub, map_pow, ha₀, hb', sub_self]
    have ha0u : IsUnit a₀ :=
      (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (by rw [ha₀]; exact hb0)
    have hfa' : IsUnit ((Polynomial.derivative (Polynomial.X ^ n - Polynomial.C u)).eval a₀) := by
      simp only [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
        sub_zero, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
      exact hnA.mul (ha0u.pow _)
    obtain ⟨v, hv, -⟩ := HenselianLocalRing.is_henselian _ hmonic a₀ hfa hfa'
    refine ⟨v, ?_⟩
    simpa [Polynomial.IsRoot, sub_eq_zero] using hv

  have hspan : Ideal.span {ϖ} = Ideal.span {π} := hϖ.symm.trans hπ
  obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.mp hspan
  have hℓpos : 0 < ℓ := (Fact.out : Nat.Prime ℓ).pos
  have hn0 : 0 < ℓ ^ k := pow_pos hℓpos k
  have hnA : IsUnit (((ℓ ^ k : ℕ) : ℕ) : A) := by
    rw [Nat.cast_pow]; exact hℓ.pow k
  obtain ⟨v, hv⟩ := hensel (ℓ ^ k) hn0 hnA (u : A) u.isUnit
  obtain ⟨w, hw⟩ : ∃ w : L, w = φA v := ⟨_, rfl⟩
  have hwn : w ^ (ℓ ^ k) = φA (u : A) := by rw [hw, ← map_pow, hv]
  have hu0 : φA (u : A) ≠ 0 := (u.isUnit.map φA).ne_zero
  have hw0 : w ≠ 0 := by
    intro h
    apply hu0
    rw [← hwn, h, zero_pow hn0.ne']
  have hσw : σ w = w := by rw [hw]; exact RingHom.congr_fun hσ v
  have hz' : (z * w⁻¹) ^ (ℓ ^ k) = φA ϖ := by
    rw [mul_pow, inv_pow, hz, hwn, ← hu, map_mul, mul_inv_cancel_right₀ hu0]
  have key := htame k hk (z * w⁻¹) hz'
  have heq : σ (z * w⁻¹) * (z * w⁻¹)⁻¹ = σ z * z⁻¹ := by
    rw [map_mul, map_inv₀, hσw, mul_inv, inv_inv]
    calc σ z * w⁻¹ * (z⁻¹ * w) = σ z * z⁻¹ * (w⁻¹ * w) := by ring
      _ = σ z * z⁻¹ := by rw [inv_mul_cancel₀ hw0, mul_one]
  rw [heq] at key
  exact key

