        have hC3 : Function.Bijective C3 := by
          constructor
          · intro q1 q2 h
            exact (cancel_mono _).mp h
          · intro q
            refine ⟨q ≫ (I.inv : (Over.star V).op ⋙ (Over.post bc).op ⋙ E.obj ⟶
