      intro r
      rw [← AdjoinRoot.algebraMap_eq, Algebra.algebraMap_eq_smul_one, Algebra.algebraMap_eq_smul_one,
        TensorProduct.smul_tmul]
    have hΨ : Polynomial.eval₂
        (Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R (AdjoinRoot (Polynomial.X ^ N - Polynomial.C a)) S).toRingHom
        (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C a) ⊗ₜ[R] (1 : S))
        (Polynomial.X ^ N - Polynomial.C (algebraMap R S a)) = 0 := by
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
      rw [AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, Algebra.TensorProduct.includeRight_apply,
        Algebra.TensorProduct.tmul_pow, one_pow, hrootp, halg, sub_self]
    let Ψ := AdjoinRoot.lift
      (Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R (AdjoinRoot (Polynomial.X ^ N - Polynomial.C a)) S).toRingHom
      (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C a) ⊗ₜ[R] (1 : S)) hΨ
