      intro B _ _ _ Λ' _ _ W'' φ' a' hB
      exact (hloc0 x hx B Λ' W'' φ' a' hB).1
    have hcoker : ∀ r : ℕ, Subsingleton (@Abelian.Ext
        (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback h (e'.inv ≫ Vξ.hom)) (ℓ ^ k))) _ _
        (HasExt.standard _)
        (SheafOfModules.unit (wcEtZModRing (Limits.pullback h (e'.inv ≫ Vξ.hom)) (ℓ ^ k)))
        (Limits.cokernel (wcEtSuppUnitMap D')) r) := by
