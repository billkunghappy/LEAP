theorem wc_pfam_lfl_fibre_transitive {F'' : Type u} [Field F''] [Finite F''] (M' : ℕ)
    {X : Scheme.{u}} (h : X ⟶ wcProjK F'' M') (Δ : Set (wcProjK F'' M')) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (q : ℕ)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ q hPP) (L : Type u) [Field L] [IsSepClosed L]
    (Z : Scheme.{u}) (eZ : Z ≅ Spec (.of L)) (b₁ b₂ : Z ⟶ Ω.W'.left)
    (h12 : b₁ ≫ Ω.w'.left = b₂ ≫ Ω.w'.left) :
    ∃ σ : Ω.W' ⟶ Ω.W', σ ≫ Ω.w' = Ω.w' ∧ b₂ = b₁ ≫ σ.left :=
by
  have hfromStalk : ∀ (Y : Scheme.{u}) (y : Y), WeaklyEtale (Y.fromSpecStalk y) := by
    intro Y y
    refine ⟨?_, inferInstance⟩
    obtain ⟨_, ⟨U, hU, rfl⟩, hy, -⟩ :=
      Y.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ y) isOpen_univ
    replace hU : IsAffineOpen U := hU
    rw [← hU.fromSpecStalk_eq_fromSpecStalk hy]
    show Flat (Spec.map (Y.presheaf.germ U y hy) ≫ hU.fromSpec)
    have : Flat (Spec.map (Y.presheaf.germ U y hy)) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      letI : Algebra Γ(Y, U) (Y.presheaf.stalk y) := (Y.presheaf.germ U y hy).hom.toAlgebra
      haveI := hU.isLocalization_stalk ⟨y, hy⟩
      exact RingHom.flat_algebraMap_iff.mpr
        (IsLocalization.flat _ (hU.primeIdealOf ⟨y, hy⟩).asIdeal.primeCompl)
    have hoi : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
    have hfs : Flat hU.fromSpec := Flat.instOfIsOpenImmersion _
    exact MorphismProperty.comp_mem @Flat _ _ this hfs
  have hW : WeaklyEtale Ω.W'.hom := Ω.W'.prop
  have hP : WeaklyEtale (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom :=
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).prop
  have kw : Ω.w'.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom = Ω.W'.hom :=
    MorphismProperty.Over.w Ω.w'
  have hw1 : WeaklyEtale
      (Ω.w'.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) := by
    rw [kw]; exact hW
  have hw : WeaklyEtale Ω.w'.left :=
    WeaklyEtale.of_comp Ω.w'.left (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
  have hq : WeaklyEtale (Limits.pullback.fst Ω.w'.left Ω.w'.left) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale)
      (IsPullback.of_hasPullback Ω.w'.left Ω.w'.left).flip hw
  let t : Z ⟶ Limits.pullback Ω.w'.left Ω.w'.left := Limits.pullback.lift b₁ b₂ h12
  let t₀ : Spec (.of L) ⟶ Limits.pullback Ω.w'.left Ω.w'.left := eZ.inv ≫ t
  have htt₀ : t = eZ.hom ≫ t₀ := (eZ.hom_inv_id_assoc t).symm
  have hζ := Scheme.Spec_stalkClosedPointTo_fromSpecStalk t₀
  set x := t₀ (IsLocalRing.closedPoint ↑(CommRingCat.of L)) with hx
  set fs := (Limits.pullback Ω.w'.left Ω.w'.left).fromSpecStalk x with hfs
  set pr₁ := Limits.pullback.fst Ω.w'.left Ω.w'.left with hpr₁
  set pr₂ := Limits.pullback.snd Ω.w'.left Ω.w'.left with hpr₂
  set ζ := Spec.map (Scheme.stalkClosedPointTo t₀) with hζdef
  have hfsE : WeaklyEtale fs := hfromStalk _ x
  have hV : WeaklyEtale (fs ≫ pr₁ ≫ Ω.W'.hom) := inferInstance
  let V : (wcProjK F'' M').ProEt := MorphismProperty.Over.mk ⊤ (fs ≫ pr₁ ≫ Ω.W'.hom) hV
  have hconn : ConnectedSpace V.left := by
    show ConnectedSpace (Spec ((Limits.pullback Ω.w'.left Ω.w'.left).presheaf.stalk x))
    rw [connectedSpace_iff_clopen]
    refine ⟨⟨IsLocalRing.closedPoint ((Limits.pullback Ω.w'.left Ω.w'.left).presheaf.stalk x)⟩,
      fun s hs => ?_⟩
    by_cases hmem :
        IsLocalRing.closedPoint ((Limits.pullback Ω.w'.left Ω.w'.left).presheaf.stalk x) ∈ s
    · right
      exact Set.eq_univ_of_forall (fun y =>
        (IsLocalRing.specializes_closedPoint y).mem_open hs.isOpen hmem)
    · left
      have hc : sᶜ = Set.univ := Set.eq_univ_of_forall (fun y =>
        (IsLocalRing.specializes_closedPoint y).mem_open hs.compl.isOpen hmem)
      exact Set.compl_univ_iff.mp hc
  have hcond : pr₁ ≫ Ω.w'.left = pr₂ ≫ Ω.w'.left := Limits.pullback.condition
  let a₁ : V ⟶ Ω.W' := MorphismProperty.Over.homMk (fs ≫ pr₁) (Category.assoc _ _ _) trivial
  have h2 : (fs ≫ pr₂) ≫ Ω.W'.hom = V.hom := by
    show (fs ≫ pr₂) ≫ Ω.W'.hom = fs ≫ pr₁ ≫ Ω.W'.hom
    rw [← kw]
    simp only [Category.assoc]
    rw [← Category.assoc pr₂, ← hcond, Category.assoc]
  let a₂ : V ⟶ Ω.W' := MorphismProperty.Over.homMk (fs ≫ pr₂) h2 trivial
  have heq : a₁ ≫ Ω.w' = a₂ ≫ Ω.w' := by
    apply MorphismProperty.Over.Hom.ext
    show (fs ≫ pr₁) ≫ Ω.w'.left = (fs ≫ pr₂) ≫ Ω.w'.left
    rw [Category.assoc, Category.assoc, hcond]
  obtain ⟨σ, hσ, hσa⟩ := Ω.hgal' V a₁ a₂ hconn heq
  have hl : fs ≫ pr₂ = (fs ≫ pr₁) ≫ σ.left := congrArg (fun f => f.left) hσa
  have hleft : fs ≫ pr₂ = fs ≫ pr₁ ≫ σ.left := by rw [hl, Category.assoc]
  refine ⟨σ, hσ, ?_⟩
  calc b₂ = t ≫ pr₂ := (Limits.pullback.lift_snd b₁ b₂ h12).symm
    _ = eZ.hom ≫ (ζ ≫ fs) ≫ pr₂ := by rw [hζ, htt₀, Category.assoc]
    _ = eZ.hom ≫ (ζ ≫ fs) ≫ pr₁ ≫ σ.left := by simp only [Category.assoc]; rw [hleft]
    _ = (eZ.hom ≫ t₀) ≫ pr₁ ≫ σ.left := by rw [hζ]; exact (Category.assoc _ _ _).symm
    _ = t ≫ pr₁ ≫ σ.left := by rw [← htt₀]
    _ = b₁ ≫ σ.left := by rw [← Category.assoc, Limits.pullback.lift_fst]

theorem wc_lfc_field_point_stalk (X : Scheme.{u}) (L : Type u) [Field L]
    (c : Spec (.of L) ⟶ X) :
    ∃ (R : CommRingCat.{u}) (s : R ⟶ CommRingCat.of L),
      (∀ ψ : CommRingCat.of L ⟶ CommRingCat.of L, Spec.map ψ ≫ c = c ↔ s ≫ ψ = s) ∧
      (WeaklyEtale c → ∀ x : L, ∃ f : Polynomial R, f.map s.hom ≠ 0 ∧ f.eval₂ s.hom x = 0) :=
by
  have hfac : Spec.map (Scheme.stalkClosedPointTo c) ≫
      X.fromSpecStalk (c (IsLocalRing.closedPoint (CommRingCat.of L))) = c :=
    Scheme.Spec_stalkClosedPointTo_fromSpecStalk c
  refine ⟨_, Scheme.stalkClosedPointTo c, ?_, ?_⟩
  · intro ψ
    constructor
    · intro h
      apply Spec.map_injective
      rw [← cancel_mono (X.fromSpecStalk (c (IsLocalRing.closedPoint (CommRingCat.of L)))),
        Spec.map_comp, Category.assoc, hfac, h]
    · intro h
      calc Spec.map ψ ≫ c
          = Spec.map ψ ≫ (Spec.map (Scheme.stalkClosedPointTo c) ≫
              X.fromSpecStalk (c (IsLocalRing.closedPoint (CommRingCat.of L)))) := by rw [hfac]
        _ = Spec.map (Scheme.stalkClosedPointTo c ≫ ψ) ≫
              X.fromSpecStalk (c (IsLocalRing.closedPoint (CommRingCat.of L))) := by
            rw [Spec.map_comp, Category.assoc]
        _ = c := by rw [h, hfac]
  · intro hc x
    have h1 : WeaklyEtale (Spec.map (Scheme.stalkClosedPointTo c) ≫
        X.fromSpecStalk (c (IsLocalRing.closedPoint (CommRingCat.of L)))) := by
      rw [hfac]; exact hc
    have h2 := wc_fromSpecStalk_weaklyEtale X (c (IsLocalRing.closedPoint (CommRingCat.of L)))
    have h3 : WeaklyEtale (Spec.map (Scheme.stalkClosedPointTo c)) :=
      WeaklyEtale.of_comp _ (X.fromSpecStalk (c (IsLocalRing.closedPoint (CommRingCat.of L))))
    have h4 : WeaklyEtale (Spec.map (CommRingCat.ofHom (Scheme.stalkClosedPointTo c).hom)) := by
      rw [CommRingCat.ofHom_hom]; exact h3
    have h5 := wc_lpkt_specMap_weaklyEtale_ring _ L (Scheme.stalkClosedPointTo c).hom h4
    letI := (Scheme.stalkClosedPointTo c).hom.toAlgebra
    obtain ⟨f, hf1, hf2⟩ := wc_weaklyEtale_point_algebraic _ L L h5 (RingHom.id L) x
    exact ⟨f, hf1, hf2⟩

theorem wc_lfc_field_endo_ultralimit (R L : Type u) [CommRing R] [Field L] (s : R →+* L)
    (halg : ∀ x : L, ∃ f : Polynomial R, f.map s ≠ 0 ∧ f.eval₂ s x = 0)
    (ψ : ℕ → (L →+* L)) (hψ : ∀ m, (ψ m).comp s = s) :
    ∃ (U : Ultrafilter ℕ) (ψinf : L →+* L), (U : Filter ℕ) ≤ Filter.atTop ∧
      ∀ x : L, ∀ᶠ m in (U : Filter ℕ), ψ m x = ψinf x :=
by
  classical
  let U : Ultrafilter ℕ := Ultrafilter.of Filter.atTop
  choose f hf0 hfx using halg
  have hroot : ∀ x m, ψ m x ∈ ((f x).map s).roots := by
    intro x m
    rw [Polynomial.mem_roots (hf0 x), Polynomial.IsRoot.def, Polynomial.eval_map]
    have h := Polynomial.hom_eval₂ (f x) s (ψ m) x
    rw [hψ m, hfx x, map_zero] at h
    exact h.symm
  have hconc : ∀ x : L, ∃ y : L, ∀ᶠ m in (U : Filter ℕ), ψ m x = y := by
    intro x
    have hfin : {a : L | a ∈ ((f x).map s).roots}.Finite := Multiset.finite_toSet _
    have h1 : ∀ᶠ m in (U : Filter ℕ), ∃ a ∈ {a : L | a ∈ ((f x).map s).roots}, ψ m x = a :=
      Filter.Eventually.of_forall (fun m => ⟨ψ m x, hroot x m, rfl⟩)
    obtain ⟨a, _, ha⟩ := (Ultrafilter.eventually_exists_mem_iff hfin).mp h1
    exact ⟨a, ha⟩
  choose g hg using hconc
  let ψinf : L →+* L :=
    { toFun := g
      map_one' := by
        obtain ⟨m, hm⟩ := (hg 1).exists
        rw [← hm, map_one]
      map_mul' := fun a b => by
        obtain ⟨m, hm1, hm2, hm3⟩ := ((hg (a * b)).and ((hg a).and (hg b))).exists
        rw [← hm1, ← hm2, ← hm3, map_mul]
      map_zero' := by
        obtain ⟨m, hm⟩ := (hg 0).exists
        rw [← hm, map_zero]
      map_add' := fun a b => by
        obtain ⟨m, hm1, hm2, hm3⟩ := ((hg (a + b)).and ((hg a).and (hg b))).exists
        rw [← hm1, ← hm2, ← hm3, map_add] }
  exact ⟨U, ψinf, Ultrafilter.of_le _, fun x => hg x⟩

theorem wc_lfc_pullback_point_tendsto (X Y Z : Scheme.{u}) (f : X ⟶ Z) (g : Y ⟶ Z)
    (L : Type u) [Field L] (a₁ : Spec (.of L) ⟶ X) (a₂ : Spec (.of L) ⟶ Y)
    (ψ : ℕ → (CommRingCat.of L ⟶ CommRingCat.of L)) (ψinf : CommRingCat.of L ⟶ CommRingCat.of L)
    (hm : ∀ m, (Spec.map (ψ m) ≫ a₁) ≫ f = a₂ ≫ g) (hinf : (Spec.map ψinf ≫ a₁) ≫ f = a₂ ≫ g)
    (U : Filter ℕ) (hU : ∀ x : L, ∀ᶠ m in U, (ψ m).hom x = ψinf.hom x) :
    Filter.Tendsto
      (fun m => (Limits.pullback.lift (Spec.map (ψ m) ≫ a₁) a₂ (hm m))
        (IsLocalRing.closedPoint L)) U
      (nhds ((Limits.pullback.lift (Spec.map ψinf ≫ a₁) a₂ hinf) (IsLocalRing.closedPoint L))) :=
by
  suffices key : ∀ pt : ↥(Spec (.of L)), Filter.Tendsto
      (fun m => (Limits.pullback.lift (Spec.map (ψ m) ≫ a₁) a₂ (hm m)) pt) U
      (nhds ((Limits.pullback.lift (Spec.map ψinf ≫ a₁) a₂ hinf) pt)) from key _
  intro pt

  have s1 : ∀ (R : CommRingCat.{u}) (χ : ℕ → (R ⟶ CommRingCat.of L))
      (χinf : R ⟶ CommRingCat.of L),
      (∀ t : R, ∀ᶠ m in U, (χ m).hom t = χinf.hom t) →
      Filter.Tendsto (fun m => (Spec.map (χ m)) pt) U (nhds ((Spec.map χinf) pt)) := by
    intro R χ χinf hχ
    have hbot : (pt : PrimeSpectrum L).asIdeal = ⊥ :=
      (Ideal.eq_bot_or_top _).resolve_right (pt : PrimeSpectrum L).isPrime.ne_top
    have hmem : ∀ (φ : R ⟶ CommRingCat.of L) (r : R),
        r ∈ ((Spec.map φ) pt).asIdeal ↔ φ.hom r = 0 := by
      intro φ r
      have e1 : r ∈ ((Spec.map φ) pt).asIdeal ↔ φ.hom r ∈ (pt : PrimeSpectrum L).asIdeal :=
        Iff.rfl
      rw [e1, hbot, Ideal.mem_bot]
    have hB : TopologicalSpace.IsTopologicalBasis (α := ↥(Spec R))
        (Set.range fun r : R => ((PrimeSpectrum.basicOpen r :
          TopologicalSpace.Opens (PrimeSpectrum R)) : Set (PrimeSpectrum R))) :=
      PrimeSpectrum.isTopologicalBasis_basic_opens
    rw [(hB.nhds_hasBasis).tendsto_right_iff]
    rintro t ⟨⟨r, rfl⟩, ht⟩
    filter_upwards [hχ r] with m hm'
    have ht' : r ∉ ((Spec.map χinf) pt).asIdeal := ht
    show r ∉ ((Spec.map (χ m)) pt).asIdeal
    rw [hmem] at ht' ⊢
    rwa [hm']

  have s4 : ∀ (A B C : CommRingCat.{u}) (α : C ⟶ A) (β : C ⟶ B) (b₁ : Spec (.of L) ⟶ Spec A)
      (b₂ : Spec (.of L) ⟶ Spec B)
      (hm' : ∀ m, (Spec.map (ψ m) ≫ b₁) ≫ Spec.map α = b₂ ≫ Spec.map β)
      (hinf' : (Spec.map ψinf ≫ b₁) ≫ Spec.map α = b₂ ≫ Spec.map β),
      Filter.Tendsto (fun m => (Limits.pullback.lift (Spec.map (ψ m) ≫ b₁) b₂ (hm' m)) pt) U
        (nhds ((Limits.pullback.lift (Spec.map ψinf ≫ b₁) b₂ hinf') pt)) := by
    intro A B C α β b₁ b₂ hm' hinf'
    letI : Algebra C A := α.hom.toAlgebra
    letI : Algebra C B := β.hom.toAlgebra
    let e : Limits.pullback (Spec.map α) (Spec.map β) ≅ Spec (.of (TensorProduct C A B)) :=
      pullbackSpecIso C A B
    have efst : e.hom ≫ Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) =
        Limits.pullback.fst (Spec.map α) (Spec.map β) := pullbackSpecIso_hom_fst C A B
    have esnd : e.hom ≫ Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight : B →ₐ[C] TensorProduct C A B).toRingHom) =
        Limits.pullback.snd (Spec.map α) (Spec.map β) := pullbackSpecIso_hom_snd C A B
    have formula : ∀ (φ : CommRingCat.of L ⟶ CommRingCat.of L)
        (ℓ : Spec (.of L) ⟶ Limits.pullback (Spec.map α) (Spec.map β)),
        ℓ ≫ Limits.pullback.fst _ _ = Spec.map φ ≫ b₁ → ℓ ≫ Limits.pullback.snd _ _ = b₂ →
        ∀ (x : A) (y : B), (Spec.preimage (ℓ ≫ e.hom)).hom (x ⊗ₜ[C] y) =
          φ.hom ((Spec.preimage b₁).hom x) * (Spec.preimage b₂).hom y := by
      intro φ ℓ hl1 hl2 x y
      have k1 : CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom ≫
          Spec.preimage (ℓ ≫ e.hom) = Spec.preimage b₁ ≫ φ := by
        apply Spec.map_injective
        simp only [Spec.map_comp, Spec.map_preimage, Category.assoc, efst, hl1]
      have k2 : CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : B →ₐ[C] TensorProduct C A B).toRingHom ≫
          Spec.preimage (ℓ ≫ e.hom) = Spec.preimage b₂ := by
        apply Spec.map_injective
        simp only [Spec.map_comp, Spec.map_preimage, Category.assoc, esnd, hl2]
      have t : x ⊗ₜ[C] y = Algebra.TensorProduct.includeLeftRingHom x *
          (Algebra.TensorProduct.includeRight : B →ₐ[C] TensorProduct C A B).toRingHom y := by
        simp [Algebra.TensorProduct.tmul_mul_tmul]
      have k1' := congrArg (fun h => h.hom x) k1
      have k2' := congrArg (fun h => h.hom y) k2
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at k1' k2'
      rw [t, map_mul, k1', k2']
    let ℓ : ℕ → (Spec (.of L) ⟶ Limits.pullback (Spec.map α) (Spec.map β)) :=
      fun m => Limits.pullback.lift (Spec.map (ψ m) ≫ b₁) b₂ (hm' m)
    let ℓinf : Spec (.of L) ⟶ Limits.pullback (Spec.map α) (Spec.map β) :=
      Limits.pullback.lift (Spec.map ψinf ≫ b₁) b₂ hinf'
    have hev : ∀ r : TensorProduct C A B, ∀ᶠ m in U,
        (Spec.preimage (ℓ m ≫ e.hom)).hom r = (Spec.preimage (ℓinf ≫ e.hom)).hom r := by
      intro r
      induction r using TensorProduct.induction_on with
      | zero => exact Filter.Eventually.of_forall (fun m => by rw [map_zero, map_zero])
      | tmul x y =>
        filter_upwards [hU ((Spec.preimage b₁).hom x)] with m hmx
        rw [formula (ψ m) (ℓ m) (Limits.pullback.lift_fst _ _ _) (Limits.pullback.lift_snd _ _ _),
          formula ψinf ℓinf (Limits.pullback.lift_fst _ _ _) (Limits.pullback.lift_snd _ _ _), hmx]
      | add x y hx hy =>
        filter_upwards [hx, hy] with m h1 h2
        rw [map_add, map_add, h1, h2]
    have hT := (e.inv.continuous.tendsto _).comp
      (s1 (.of (TensorProduct C A B)) (fun m => Spec.preimage (ℓ m ≫ e.hom))
        (Spec.preimage (ℓinf ≫ e.hom)) hev)
    have hpt : ∀ ℓ' : Spec (.of L) ⟶ Limits.pullback (Spec.map α) (Spec.map β),
        e.inv ((Spec.map (Spec.preimage (ℓ' ≫ e.hom))) pt) = ℓ' pt := by
      intro ℓ'
      rw [Spec.map_preimage, Scheme.Hom.comp_apply, Scheme.hom_inv_apply]
    rw [hpt] at hT
    exact hT.congr (fun m => hpt (ℓ m))

  have hpt1 : ∀ φ : CommRingCat.of L ⟶ CommRingCat.of L, (Spec.map φ) pt = pt :=
    fun φ => Subsingleton.elim _ _
  have hz : f (a₁ pt) = g (a₂ pt) := by
    have h := congrArg (fun h : Spec (.of L) ⟶ Z => h pt) hinf
    simp only [Scheme.Hom.comp_apply, hpt1] at h
    exact h

  obtain ⟨A, B, C, ιX, ιY, ιZ, α, β, b₁, b₂, hZ, hf, hg, h₁, h₂⟩ :
      ∃ (A B C : CommRingCat.{u}) (ιX : Spec A ⟶ X) (ιY : Spec B ⟶ Y) (ιZ : Spec C ⟶ Z)
        (α : C ⟶ A) (β : C ⟶ B) (b₁ : Spec (.of L) ⟶ Spec A) (b₂ : Spec (.of L) ⟶ Spec B),
        IsOpenImmersion ιZ ∧ Spec.map α ≫ ιZ = ιX ≫ f ∧ Spec.map β ≫ ιZ = ιY ≫ g ∧
          b₁ ≫ ιX = a₁ ∧ b₂ ≫ ιY = a₂ := by
    obtain ⟨WZ, hWZ, hzWZ, -⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Z.isBasis_affineOpens)
        (show g (a₂ pt) ∈ (⊤ : Z.Opens) from trivial)
    obtain ⟨WX, hWX, hxWX, hWXle⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens)
        (show a₁ pt ∈ f ⁻¹ᵁ WZ from by
          rw [Scheme.Hom.mem_preimage, hz]; exact hzWZ)
    obtain ⟨WY, hWY, hyWY, hWYle⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp Y.isBasis_affineOpens)
        (show a₂ pt ∈ g ⁻¹ᵁ WZ from by
          rw [Scheme.Hom.mem_preimage]; exact hzWZ)
    have hWZ' : IsAffineOpen WZ := hWZ
    have hWX' : IsAffineOpen WX := hWX
    have hWY' : IsAffineOpen WY := hWY
    have H1 : Set.range ⇑(hWX'.fromSpec ≫ f) ⊆ Set.range ⇑hWZ'.fromSpec := by
      rintro _ ⟨p, rfl⟩
      rw [hWZ'.range_fromSpec, Scheme.Hom.comp_apply]
      have hp : hWX'.fromSpec p ∈ WX := by
        rw [← SetLike.mem_coe, ← hWX'.range_fromSpec]; exact ⟨p, rfl⟩
      exact (Scheme.Hom.mem_preimage f).mp (hWXle hp)
    have H2 : Set.range ⇑(hWY'.fromSpec ≫ g) ⊆ Set.range ⇑hWZ'.fromSpec := by
      rintro _ ⟨p, rfl⟩
      rw [hWZ'.range_fromSpec, Scheme.Hom.comp_apply]
      have hp : hWY'.fromSpec p ∈ WY := by
        rw [← SetLike.mem_coe, ← hWY'.range_fromSpec]; exact ⟨p, rfl⟩
      exact (Scheme.Hom.mem_preimage g).mp (hWYle hp)
    have H3 : Set.range ⇑a₁ ⊆ Set.range ⇑hWX'.fromSpec := by
      rintro _ ⟨q, rfl⟩
      rw [Subsingleton.elim q pt, hWX'.range_fromSpec]
      exact hxWX
    have H4 : Set.range ⇑a₂ ⊆ Set.range ⇑hWY'.fromSpec := by
      rintro _ ⟨q, rfl⟩
      rw [Subsingleton.elim q pt, hWY'.range_fromSpec]
      exact hyWY
    exact ⟨_, _, _, hWX'.fromSpec, hWY'.fromSpec, hWZ'.fromSpec,
      Spec.preimage (IsOpenImmersion.lift hWZ'.fromSpec _ H1),
      Spec.preimage (IsOpenImmersion.lift hWZ'.fromSpec _ H2),
      IsOpenImmersion.lift hWX'.fromSpec a₁ H3, IsOpenImmersion.lift hWY'.fromSpec a₂ H4,
      inferInstance,
      by rw [Spec.map_preimage, IsOpenImmersion.lift_fac],
      by rw [Spec.map_preimage, IsOpenImmersion.lift_fac],
      IsOpenImmersion.lift_fac _ _ _, IsOpenImmersion.lift_fac _ _ _⟩
  have hsq : ∀ (φ : CommRingCat.of L ⟶ CommRingCat.of L), (Spec.map φ ≫ a₁) ≫ f = a₂ ≫ g →
      (Spec.map φ ≫ b₁) ≫ Spec.map α = b₂ ≫ Spec.map β := by
    intro φ h
    rw [← cancel_mono ιZ]
    simp only [Category.assoc, hf, hg, reassoc_of% h₁, reassoc_of% h₂]
    simpa only [Category.assoc] using h

  obtain ⟨Λ, hΛ1, hΛ2⟩ : ∃ Λ : Limits.pullback (Spec.map α) (Spec.map β) ⟶ Limits.pullback f g,
      Λ ≫ Limits.pullback.fst f g = Limits.pullback.fst _ _ ≫ ιX ∧
      Λ ≫ Limits.pullback.snd f g = Limits.pullback.snd _ _ ≫ ιY :=
    ⟨Limits.pullback.map _ _ _ _ ιX ιY ιZ hf hg, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have hΛ : ∀ (φ : CommRingCat.of L ⟶ CommRingCat.of L) (h : (Spec.map φ ≫ a₁) ≫ f = a₂ ≫ g)
      (h' : (Spec.map φ ≫ b₁) ≫ Spec.map α = b₂ ≫ Spec.map β),
      Limits.pullback.lift (Spec.map φ ≫ a₁) a₂ h =
        Limits.pullback.lift (Spec.map φ ≫ b₁) b₂ h' ≫ Λ := by
    intro φ h h'
    apply Limits.pullback.hom_ext
    · rw [Limits.pullback.lift_fst, Category.assoc, hΛ1, Limits.pullback.lift_fst_assoc,
        Category.assoc, h₁]
    · rw [Limits.pullback.lift_snd, Category.assoc, hΛ2, Limits.pullback.lift_snd_assoc, h₂]

  rw [hΛ ψinf hinf (hsq ψinf hinf), Scheme.Hom.comp_apply]
  refine Filter.Tendsto.congr (fun m => ?_) ((Λ.continuous.tendsto _).comp
    (s4 A B C α β b₁ b₂ (fun m => hsq (ψ m) (hm m)) (hsq ψinf hinf)))
  rw [Function.comp_apply, hΛ (ψ m) (hm m) (hsq (ψ m) (hm m)), Scheme.Hom.comp_apply]

theorem wc_lfc_deck_transition_frames (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (R : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (B W : S.ProEt) (w : W ⟶ B)
    (hW : ConnectedSpace W.left) (k : ℕ)
    (θ : R.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W)
    (hgal : ∀ (V : S.ProEt) (a b : V ⟶ W), ConnectedSpace V.left → a ≫ w = b ≫ w →
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ) :
    ∃ G : ↥(Limits.pullback w.left w.left) →
        ((Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])),
      (∀ j : Fin k, Continuous (fun z => G z (Pi.single j 1))) ∧
      ∀ (δ : W ⟶ W) (g : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
        (hδ : δ.left ≫ w.left = 𝟙 W.left ≫ w.left), δ ≫ w = w →
        (∀ (s : R.obj.obj (Opposite.op W)) (z : W.left),
          (show C(↥W.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk δ))).hom s).down) z =
          g ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
        ∀ z, G (Limits.pullback.lift δ.left (𝟙 W.left) hδ z) ∘ₗ g = LinearMap.id :=
by
  classical
  haveI hBp : WeaklyEtale B.hom := B.prop
  haveI hWp : WeaklyEtale W.hom := W.prop
  haveI hwB : WeaklyEtale (w.left ≫ B.hom) := by
    rw [MorphismProperty.Over.w w]; exact hWp
  haveI hwl : WeaklyEtale w.left := WeaklyEtale.of_comp w.left B.hom

  have TR : ∀ (V V' : S.ProEt) (h' : V' ⟶ W) (j : V ⟶ V')
      (y : R.obj.obj (Opposite.op V')) (z : V.left),
      (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (j ≫ h')))).hom
          ((R.obj.map j.op).hom y)).down) z =
      (show C(↥V'.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y).down) (j.left z) := by
    intro V V' h' j y z
    have hn := θ.hom.hom.naturality
      (Over.homMk j (by rfl) : (Over.mk (j ≫ h') : Over W) ⟶ Over.mk h').op
    have h1 := congrArg (fun m => m.hom y) hn
    have h2 : (θ.hom.hom.app (Opposite.op (Over.mk (j ≫ h')))).hom
          ((R.obj.map j.op).hom y) =
        ((wcContSheaf S (Fin k → ℚ_[ℓ])).obj.map j.op).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y) := h1
    rw [h2]
    rfl

  have hcancel2 : ∀ (T : Over W)
      (c : ((wcContSheaf S (Fin k → ℚ_[ℓ])).over W).obj.obj (Opposite.op T)),
      (θ.hom.hom.app (Opposite.op T)).hom ((θ.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) θ.inv_hom_id
  have hK : ∀ (V : S.ProEt) (a : V ⟶ W) (v₀ : Fin k → ℚ_[ℓ]),
      ∃ t : R.obj.obj (Opposite.op V), ∀ x : V.left,
        (show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom t).down) x = v₀ := by
    intro V a v₀
    let c : (wcContSheaf S (Fin k → ℚ_[ℓ])).obj.obj (Opposite.op V) :=
      (show (wcContSheaf S (Fin k → ℚ_[ℓ])).obj.obj (Opposite.op V) from
        ULift.up (ContinuousMap.const ↥V.left v₀))
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk a))).hom c, fun x => ?_⟩
    have hs := hcancel2 (Over.mk a) c
    exact congrArg (fun y : ULift.{u+1} C(↥V.left, Fin k → ℚ_[ℓ]) => y.down x) hs

  choose A hA using fun γ : W ⟶ W => wc_proet_deck_frame_linear S ℓ R W hW k θ γ

  have hnbhd : ∀ (V₀ : S.ProEt) (z : V₀.left),
      ∃ (V₁ : S.ProEt) (k₁ : V₁ ⟶ V₀) (z₁ : V₁.left),
        ConnectedSpace V₁.left ∧ k₁.left z₁ = z := by
    intro V₀ z
    have hι : WeaklyEtale (V₀.left.fromSpecStalk z) := by
      refine ⟨?_, inferInstance⟩
      obtain ⟨_, ⟨U, hU, rfl⟩, hx, -⟩ :=
        V₀.left.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ z) isOpen_univ
      replace hU : IsAffineOpen U := hU
      rw [← hU.fromSpecStalk_eq_fromSpecStalk hx]
      show Flat (Spec.map (V₀.left.presheaf.germ U z hx) ≫ hU.fromSpec)
      have : Flat (Spec.map (V₀.left.presheaf.germ U z hx)) := by
        rw [HasRingHomProperty.Spec_iff (P := @Flat)]
        letI : Algebra Γ(V₀.left, U) (V₀.left.presheaf.stalk z) :=
          (V₀.left.presheaf.germ U z hx).hom.toAlgebra
        haveI := hU.isLocalization_stalk ⟨z, hx⟩
        exact RingHom.flat_algebraMap_iff.mpr
          (IsLocalization.flat _ (hU.primeIdealOf ⟨z, hx⟩).asIdeal.primeCompl)
      have hoi : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
      have hfs : Flat hU.fromSpec := Flat.instOfIsOpenImmersion _
      exact MorphismProperty.comp_mem @Flat _ _ this hfs
    have hcomp : WeaklyEtale (V₀.left.fromSpecStalk z ≫ V₀.hom) :=
      @MorphismProperty.comp_mem _ _ @WeaklyEtale
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hι V₀.prop
    let V₁ : S.ProEt :=
      MorphismProperty.Over.mk ⊤ (V₀.left.fromSpecStalk z ≫ V₀.hom) hcomp
    let k₁ : V₁ ⟶ V₀ := MorphismProperty.Over.homMk (V₀.left.fromSpecStalk z) rfl trivial
    have hconnR : ∀ (R₀ : CommRingCat.{u}) [IsLocalRing R₀], ConnectedSpace (Spec R₀) := by
      intro R₀ _
      have hpre : PreconnectedSpace (PrimeSpectrum R₀) := by
        rw [preconnectedSpace_iff_clopen]
        intro s hs
        obtain ⟨e, he, rfl⟩ := PrimeSpectrum.isClopen_iff.mp hs
        rcases IsLocalRing.isUnit_or_isUnit_one_sub_self e with h | h
        · right
          have he1 : e = 1 := h.mul_left_cancel (by rw [mul_one]; exact he.eq)
          subst he1
          simp
        · left
          have he0 : e = 0 := by
            have h0 : (1 - e) * e = (1 - e) * 0 := by
              rw [sub_mul, one_mul, he.eq, sub_self, mul_zero]
            exact h.mul_left_cancel h0
          subst he0
          simp
      have hc : ConnectedSpace (PrimeSpectrum R₀) :=
        { toPreconnectedSpace := hpre, toNonempty := ⟨IsLocalRing.closedPoint R₀⟩ }
      exact hc
    exact ⟨V₁, k₁, IsLocalRing.closedPoint _, hconnR (V₀.left.presheaf.stalk z),
      Scheme.fromSpecStalk_closedPoint⟩

  haveI : WeaklyEtale (Limits.pullback.fst w.left w.left) := inferInstance
  haveI : WeaklyEtale (Limits.pullback.fst w.left w.left ≫ W.hom) := inferInstance
  let Zo : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst w.left w.left ≫ W.hom)
  let P₁ : Zo ⟶ W :=
    MorphismProperty.Over.homMk (Limits.pullback.fst w.left w.left) rfl trivial
  have h₂ : Limits.pullback.snd w.left w.left ≫ W.hom =
      Limits.pullback.fst w.left w.left ≫ W.hom := by
    rw [← MorphismProperty.Over.w w, ← Category.assoc, ← Category.assoc,
      Limits.pullback.condition]
  let P₂ : Zo ⟶ W :=
    MorphismProperty.Over.homMk (Limits.pullback.snd w.left w.left) h₂ trivial
  have hPw : P₁ ≫ w = P₂ ≫ w := by
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.condition (f := w.left) (g := w.left)

  choose V₁ κ z₁ hc hκ using fun z : ↥(Limits.pullback w.left w.left) => hnbhd Zo z
  have hab0 : ∀ z, (κ z ≫ P₁) ≫ w = (κ z ≫ P₂) ≫ w := fun z => by
    rw [Category.assoc, Category.assoc, hPw]
  choose γ hγw hγ using fun z => hgal (V₁ z) (κ z ≫ P₁) (κ z ≫ P₂) (hc z) (hab0 z)

  have hb : ∀ (V : S.ProEt) (a b : V ⟶ W)
      (hl : a.left ≫ w.left = b.left ≫ w.left)
      (t : R.obj.obj (Opposite.op V)) (z : V.left),
      (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom t).down) z =
      A (γ (Limits.pullback.lift a.left b.left hl z))
        ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom t).down) z) := by
    intro V a b hl t v
    generalize hz₀ : Limits.pullback.lift a.left b.left hl v = z₀
    have hKw : Limits.pullback.lift a.left b.left hl ≫
        (Limits.pullback.fst w.left w.left ≫ W.hom) = V.hom := by
      rw [Limits.pullback.lift_fst_assoc, MorphismProperty.Over.w a]
    let K : V ⟶ Zo :=
      MorphismProperty.Over.homMk (Limits.pullback.lift a.left b.left hl) hKw trivial
    have hK1 : K ≫ P₁ = a := by
      apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.lift_fst a.left b.left hl
    have hK2 : K ≫ P₂ = b := by
      apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.lift_snd a.left b.left hl
    haveI : WeaklyEtale (V₁ z₀).hom := (V₁ z₀).prop
    haveI hVp : WeaklyEtale V.hom := V.prop
    haveI hZp : WeaklyEtale Zo.hom := Zo.prop
    haveI : WeaklyEtale (K.left ≫ Zo.hom) := by
      rw [MorphismProperty.Over.w K]; exact hVp
    haveI : WeaklyEtale K.left := WeaklyEtale.of_comp K.left Zo.hom
    haveI : WeaklyEtale (Limits.pullback.fst (κ z₀).left K.left) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst (κ z₀).left K.left ≫ (V₁ z₀).hom) :=
      inferInstance
    let Q : S.ProEt :=
      Scheme.ProEt.mk (Limits.pullback.fst (κ z₀).left K.left ≫ (V₁ z₀).hom)
    let p₁ : Q ⟶ V₁ z₀ :=
      MorphismProperty.Over.homMk (Limits.pullback.fst (κ z₀).left K.left) rfl trivial
    have hq2 : Limits.pullback.snd (κ z₀).left K.left ≫ V.hom =
        Limits.pullback.fst (κ z₀).left K.left ≫ (V₁ z₀).hom := by
      rw [← MorphismProperty.Over.w K, ← MorphismProperty.Over.w (κ z₀), ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let p₂ : Q ⟶ V :=
      MorphismProperty.Over.homMk (Limits.pullback.snd (κ z₀).left K.left) hq2 trivial
    have hsq : p₁ ≫ κ z₀ = p₂ ≫ K := by
      apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition (f := (κ z₀).left) (g := K.left)
    obtain ⟨q, -, hqv⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := (κ z₀).left) (g := K.left) (z₁ z₀) v ((hκ z₀).trans hz₀.symm)
    have key : p₂ ≫ b = (p₂ ≫ a) ≫ γ z₀ := by
      calc p₂ ≫ b = p₂ ≫ K ≫ P₂ := by rw [hK2]
        _ = (p₂ ≫ K) ≫ P₂ := (Category.assoc _ _ _).symm
        _ = (p₁ ≫ κ z₀) ≫ P₂ := by rw [hsq]
        _ = p₁ ≫ (κ z₀ ≫ P₂) := Category.assoc _ _ _
        _ = p₁ ≫ ((κ z₀ ≫ P₁) ≫ γ z₀) := by rw [hγ z₀]
        _ = ((p₁ ≫ κ z₀) ≫ P₁) ≫ γ z₀ := by simp only [Category.assoc]
        _ = ((p₂ ≫ K) ≫ P₁) ≫ γ z₀ := by rw [hsq]
        _ = (p₂ ≫ a) ≫ γ z₀ := by rw [Category.assoc p₂, hK1]
    have hF := hA (γ z₀) Q (p₂ ≫ a) (p₂ ≫ b) key ((R.obj.map p₂.op).hom t) q
    have L := TR Q V b p₂ t q
    have R' := TR Q V a p₂ t q
    have hp : p₂.left q = v := hqv
    rw [hp] at L R'
    exact L.symm.trans (hF.trans (congrArg (A (γ z₀)) R'))
  refine ⟨fun z => A (γ z), ?_, ?_⟩
  ·
    intro j
    have hl : P₁.left ≫ w.left = P₂.left ≫ w.left :=
      Limits.pullback.condition (f := w.left) (g := w.left)
    have hid : ∀ z : ↥(Limits.pullback w.left w.left),
        Limits.pullback.lift P₁.left P₂.left hl z = z := by
      intro z
      have e : Limits.pullback.lift P₁.left P₂.left hl = 𝟙 _ :=
        Limits.pullback.lift_fst_snd w.left w.left
      rw [e]
      rfl
    obtain ⟨t, ht⟩ := hK Zo P₁ (Pi.single j 1)
    have hcont := (show C(↥Zo.left, Fin k → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk P₂))).hom t).down).continuous
    refine hcont.congr ?_
    intro z
    have h1 := hb Zo P₁ P₂ hl t z
    rw [ht z, hid z] at h1
    exact h1
  ·
    intro δ g hδ _ hg z
    apply LinearMap.ext
    intro v₀
    obtain ⟨s, hs⟩ := hK W (𝟙 W) v₀
    have h1 := hb W δ (𝟙 W) hδ s z
    have h2 := hg s z
    rw [hs z] at h1 h2
    rw [h2] at h1
    rw [LinearMap.comp_apply, LinearMap.id_apply]
    exact h1.symm

theorem wc_pfam_lfl_line_frames_closed (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP)
    (T : (wcP1Over F'').left.ProEt) (L : Type u) [Field L] [IsSepClosed L]
    (eL : T.left ≅ Spec (.of L)) (b : T.left ⟶ Ω.W'.left) (hb : b ≫ Ω.W'.hom = T.hom ≫ lam)
    (g' : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]))
    (happrox : ∀ ε : ℝ, 0 < ε → ∃ (τ : T ⟶ T) (σ : Ω.W' ⟶ Ω.W')
      (g₁ : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
      σ ≫ Ω.w' = Ω.w' ∧ wcPfamFrame Ω σ g₁ ∧ τ.left ≫ b = b ≫ σ.left ∧
      ∀ i j : Fin Ω.r', ‖g₁ (Pi.single j 1) i - g' (Pi.single j 1) i‖ < ε) :
    ∃ (τ : T ⟶ T) (σ'' : Ω.W' ⟶ Ω.W'), σ'' ≫ Ω.w' = Ω.w' ∧ wcPfamFrame Ω σ'' g' ∧
      τ.left ≫ b = b ≫ σ''.left :=
by

  have hεpos : ∀ m : ℕ, (0 : ℝ) < 1 / ((m : ℝ) + 1) := fun m => by positivity
  choose τs σs gs hσs hfrs hτs hεs using fun m : ℕ => happrox (1 / ((m : ℝ) + 1)) (hεpos m)
  have kσs : ∀ m, (σs m).left ≫ Ω.w'.left = Ω.w'.left :=
    fun m => congrArg (fun x => x.left) (hσs m)
  have hτw' : ∀ m, (τs m).left ≫ b ≫ Ω.w'.left = b ≫ Ω.w'.left := fun m => by
    rw [← Category.assoc, hτs m, Category.assoc, kσs m]
  obtain ⟨ψs, hψs⟩ : ∃ ψs : ℕ → (CommRingCat.of L ⟶ CommRingCat.of L),
      ∀ m, Spec.map (ψs m) = eL.inv ≫ (τs m).left ≫ eL.hom :=
    ⟨fun m => Spec.preimage _, fun m => Spec.map_preimage _⟩

  haveI hTp : WeaklyEtale T.hom := T.prop
  have hc₁ : WeaklyEtale (eL.inv ≫ T.hom) := inferInstance
  obtain ⟨R₁, s₁, iff₁, alg₁⟩ := wc_lfc_field_point_stalk (wcP1Over F'').left L (eL.inv ≫ T.hom)
  have hfix₁ : ∀ m, s₁ ≫ ψs m = s₁ := by
    intro m
    rw [← iff₁, hψs m]
    simp only [Category.assoc, Iso.hom_inv_id_assoc, MorphismProperty.Over.w (τs m)]
  obtain ⟨U, ψinf, hUle, hE⟩ := wc_lfc_field_endo_ultralimit R₁ L s₁.hom (alg₁ hc₁)
    (fun m => (ψs m).hom) (fun m => by rw [← CommRingCat.hom_comp, hfix₁ m])
  haveI : (U : Filter ℕ).NeBot := Ultrafilter.neBot U
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : CommRingCat.of L ⟶ CommRingCat.of L, Ψ.hom = ψinf :=
    ⟨CommRingCat.ofHom ψinf, rfl⟩
  have hclaim : ∀ (R'' : CommRingCat.{u}) (s' : R'' ⟶ CommRingCat.of L),
      (∀ m, s' ≫ ψs m = s') → s' ≫ Ψ = s' := by
    intro R'' s' hs'
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro r
    rw [CommRingCat.hom_comp, RingHom.comp_apply, hΨ]
    obtain ⟨m, hm⟩ := (hE (s'.hom r)).exists
    have hm' : (ψs m).hom (s'.hom r) = ψinf (s'.hom r) := hm
    rw [← hm']
    have := congrArg (fun φ => φ.hom r) (hs' m)
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this
  have hΨ₁ : Spec.map Ψ ≫ eL.inv ≫ T.hom = eL.inv ≫ T.hom := (iff₁ Ψ).mpr (hclaim R₁ s₁ hfix₁)
  have hτw : (eL.hom ≫ Spec.map Ψ ≫ eL.inv) ≫ T.hom = T.hom := by
    simp only [Category.assoc]
    rw [hΨ₁, Iso.hom_inv_id_assoc]
  obtain ⟨τ, hτl⟩ : ∃ τ : T ⟶ T, τ.left = eL.hom ≫ Spec.map Ψ ≫ eL.inv :=
    ⟨MorphismProperty.Over.homMk (eL.hom ≫ Spec.map Ψ ≫ eL.inv) hτw trivial, rfl⟩

  obtain ⟨R₂, s₂, iff₂, -⟩ := wc_lfc_field_point_stalk _ L (eL.inv ≫ b ≫ Ω.w'.left)
  have hfix₂ : ∀ m, s₂ ≫ ψs m = s₂ := by
    intro m
    rw [← iff₂, hψs m]
    simp only [Category.assoc, Iso.hom_inv_id_assoc, hτw' m]
  have hΨ₂ : Spec.map Ψ ≫ eL.inv ≫ b ≫ Ω.w'.left = eL.inv ≫ b ≫ Ω.w'.left :=
    (iff₂ Ψ).mpr (hclaim R₂ s₂ hfix₂)
  have hτgeo : τ.left ≫ b ≫ Ω.w'.left = b ≫ Ω.w'.left := by
    rw [hτl]
    simp only [Category.assoc]
    rw [hΨ₂, Iso.hom_inv_id_assoc]
  obtain ⟨σ'', hσ'', hb''⟩ := wc_pfam_lfl_fibre_transitive M' h Δ ℓ (n - 1) hPP Ω L T.left eL
    b (τ.left ≫ b) (by rw [Category.assoc, hτgeo])
  have kσ'' : σ''.left ≫ Ω.w'.left = Ω.w'.left := congrArg (fun x => x.left) hσ''
  obtain ⟨g'', hg''⟩ := wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ (n - 1)) Ω.W'
    Ω.hconn' Ω.r' Ω.θ' σ''
  have hfr'' : wcPfamFrame Ω σ'' g'' := fun s z =>
    hg'' Ω.W' (𝟙 Ω.W') σ'' (Category.id_comp σ'').symm s z

  have hmP : ∀ m, (Spec.map (ψs m) ≫ eL.inv ≫ b) ≫ Ω.w'.left = (eL.inv ≫ b) ≫ Ω.w'.left := by
    intro m
    rw [hψs m]
    simp only [Category.assoc, Iso.hom_inv_id_assoc, hτw' m]
  have hinfP : (Spec.map Ψ ≫ eL.inv ≫ b) ≫ Ω.w'.left = (eL.inv ≫ b) ≫ Ω.w'.left := by
    simp only [Category.assoc]
    exact hΨ₂
  have hconv := wc_lfc_pullback_point_tendsto Ω.W'.left Ω.W'.left _ Ω.w'.left Ω.w'.left L
    (eL.inv ≫ b) (eL.inv ≫ b) ψs Ψ hmP hinfP (U : Filter ℕ) (fun x => by rw [hΨ]; exact hE x)
  have hδs : ∀ m, (σs m).left ≫ Ω.w'.left = 𝟙 Ω.W'.left ≫ Ω.w'.left := fun m => by
    rw [Category.id_comp, kσs m]
  have hδ'' : σ''.left ≫ Ω.w'.left = 𝟙 Ω.W'.left ≫ Ω.w'.left := by
    rw [Category.id_comp, kσ'']
  obtain ⟨t₀, hpt⟩ : ∃ t₀ : T.left, eL.hom t₀ = IsLocalRing.closedPoint L :=
    ⟨eL.inv (IsLocalRing.closedPoint L), @Subsingleton.elim (PrimeSpectrum L) inferInstance _ _⟩
  have hQm : ∀ m, eL.hom ≫ Limits.pullback.lift (Spec.map (ψs m) ≫ eL.inv ≫ b) (eL.inv ≫ b)
      (hmP m) = b ≫ Limits.pullback.lift (σs m).left (𝟙 Ω.W'.left) (hδs m) := by
    intro m
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, Limits.pullback.lift_fst]
      rw [hψs m]
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
      exact hτs m
    · simp only [Category.assoc, Limits.pullback.lift_snd, Iso.hom_inv_id_assoc,
        Category.comp_id]
  have hQinf : eL.hom ≫ Limits.pullback.lift (Spec.map Ψ ≫ eL.inv ≫ b) (eL.inv ≫ b) hinfP =
      b ≫ Limits.pullback.lift σ''.left (𝟙 Ω.W'.left) hδ'' := by
    apply Limits.pullback.hom_ext
    · simp only [Category.assoc, Limits.pullback.lift_fst]
      rw [← hb'', hτl]
      simp only [Category.assoc]
    · simp only [Category.assoc, Limits.pullback.lift_snd, Iso.hom_inv_id_assoc,
        Category.comp_id]
  have hPm : ∀ m, Limits.pullback.lift (Spec.map (ψs m) ≫ eL.inv ≫ b) (eL.inv ≫ b) (hmP m)
      (IsLocalRing.closedPoint L) =
      Limits.pullback.lift (σs m).left (𝟙 Ω.W'.left) (hδs m) (b t₀) := by
    intro m
    have e := congrArg (fun k => k t₀) (hQm m)
    simp only [Scheme.Hom.comp_apply] at e
    rw [← e, hpt]
  have hPinf : Limits.pullback.lift (Spec.map Ψ ≫ eL.inv ≫ b) (eL.inv ≫ b) hinfP
      (IsLocalRing.closedPoint L) =
      Limits.pullback.lift σ''.left (𝟙 Ω.W'.left) hδ'' (b t₀) := by
    have e := congrArg (fun k => k t₀) hQinf
    simp only [Scheme.Hom.comp_apply] at e
    rw [← e, hpt]
  have hconv' : Filter.Tendsto
      (fun m => Limits.pullback.lift (σs m).left (𝟙 Ω.W'.left) (hδs m) (b t₀)) (U : Filter ℕ)
      (nhds (Limits.pullback.lift σ''.left (𝟙 Ω.W'.left) hδ'' (b t₀))) := by
    rw [← hPinf]
    exact hconv.congr hPm

  obtain ⟨G, hGc, hGe⟩ := wc_lfc_deck_transition_frames (wcProjK F'' M') ℓ (wcRq h ℓ (n - 1)) _
    Ω.W' Ω.w' Ω.hconn' Ω.r' Ω.θ' Ω.hgal'
  have hIm : ∀ m, G (Limits.pullback.lift (σs m).left (𝟙 Ω.W'.left) (hδs m) (b t₀)) ∘ₗ gs m =
      LinearMap.id := fun m => hGe (σs m) (gs m) (hδs m) (hσs m) (hfrs m) (b t₀)
  have hIinf : G (Limits.pullback.lift σ''.left (𝟙 Ω.W'.left) hδ'' (b t₀)) ∘ₗ g'' =
      LinearMap.id := hGe σ'' g'' hδ'' hσ'' hfr'' (b t₀)
  have hent : ∀ i j : Fin Ω.r', Filter.Tendsto (fun m => gs m (Pi.single j 1) i) (U : Filter ℕ)
      (nhds (g' (Pi.single j 1) i)) := by
    intro i j
    apply Filter.Tendsto.mono_left ?_ hUle
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero_norm (fun m => ?_) tendsto_one_div_add_atTop_nhds_zero_nat
    rw [norm_norm]
    exact (hεs m i j).le
  have hcol : ∀ i : Fin Ω.r', Filter.Tendsto
      (fun m => G (Limits.pullback.lift (σs m).left (𝟙 Ω.W'.left) (hδs m) (b t₀)) (Pi.single i 1))
      (U : Filter ℕ)
      (nhds (G (Limits.pullback.lift σ''.left (𝟙 Ω.W'.left) hδ'' (b t₀)) (Pi.single i 1))) :=
    fun i => ((hGc i).tendsto _).comp hconv'
  have hexp : ∀ (A : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]))
      (v : Fin Ω.r' → ℚ_[ℓ]), A v = ∑ i, v i • A (Pi.single i 1) := by
    intro A v
    conv_lhs => rw [pi_eq_sum_univ' v]
    simp only [map_sum, map_smul]
  have hlim : ∀ j : Fin Ω.r',
      G (Limits.pullback.lift σ''.left (𝟙 Ω.W'.left) hδ'' (b t₀)) (g' (Pi.single j 1)) =
        Pi.single j 1 := by
    intro j
    have h1 : Filter.Tendsto (fun m => ∑ i, gs m (Pi.single j 1) i •
        G (Limits.pullback.lift (σs m).left (𝟙 Ω.W'.left) (hδs m) (b t₀)) (Pi.single i 1))
        (U : Filter ℕ) (nhds (∑ i, g' (Pi.single j 1) i •
          G (Limits.pullback.lift σ''.left (𝟙 Ω.W'.left) hδ'' (b t₀)) (Pi.single i 1))) :=
      tendsto_finsetSum _ (fun i _ => (hent i j).smul (hcol i))
    have h2 : ∀ m, ∑ i, gs m (Pi.single j 1) i •
        G (Limits.pullback.lift (σs m).left (𝟙 Ω.W'.left) (hδs m) (b t₀)) (Pi.single i 1) =
        Pi.single j 1 := by
      intro m
      rw [← hexp (G (Limits.pullback.lift (σs m).left (𝟙 Ω.W'.left) (hδs m) (b t₀)))
        (gs m (Pi.single j 1))]
      exact LinearMap.congr_fun (hIm m) (Pi.single j 1)
    rw [hexp (G (Limits.pullback.lift σ''.left (𝟙 Ω.W'.left) hδ'' (b t₀))) (g' (Pi.single j 1))]
    exact tendsto_nhds_unique h1 (tendsto_const_nhds.congr (fun m => (h2 m).symm))
  have hall : ∀ v, G (Limits.pullback.lift σ''.left (𝟙 Ω.W'.left) hδ'' (b t₀)) (g' v) = v := by
    intro v
    rw [hexp g' v, map_sum]
    simp only [map_smul, hlim]
    exact (pi_eq_sum_univ' v).symm

  have hinj : Function.Injective g'' := by
    intro x y hxy
    have hc := congrArg (G (Limits.pullback.lift σ''.left (𝟙 Ω.W'.left) hδ'' (b t₀))) hxy
    have e1 := LinearMap.congr_fun hIinf x
    have e2 := LinearMap.congr_fun hIinf y
    simp only [LinearMap.comp_apply, LinearMap.id_apply] at e1 e2
    rw [← e1, ← e2]
    exact hc
  have hsurj := LinearMap.injective_iff_surjective.mp hinj
  have heq : g' = g'' := by
    apply LinearMap.ext
    intro v
    obtain ⟨u, hu⟩ := hsurj (g' v)
    have e1 : G (Limits.pullback.lift σ''.left (𝟙 Ω.W'.left) hδ'' (b t₀)) (g'' u) = u := by
      have := LinearMap.congr_fun hIinf u
      simpa only [LinearMap.comp_apply, LinearMap.id_apply] using this
    have e2 := hall v
    rw [← hu, e1] at e2
    rw [← hu, e2]
  refine ⟨τ, σ'', hσ'', ?_, hb''⟩
  rw [heq]
  exact hfr''

theorem wc_proet_frames_bounded (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (B W : S.ProEt) (w : W ⟶ B)
    (hWc : CompactSpace W.left) (hWn : Nonempty W.left) (hqc : QuasiCompact w.left) (r : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W) :
    ∃ C : ℝ, ∀ (γ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])), γ ≫ w = w →
      (∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
        (show C(↥W.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
        g ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
      ∀ j : Fin r, ‖g (Pi.single j 1)‖ ≤ C :=
by
  classical
  haveI := hWc
  haveI := hqc

  haveI hBp : WeaklyEtale B.hom := B.prop
  haveI hWp : WeaklyEtale W.hom := W.prop
  have hwB : w.left ≫ B.hom = W.hom := MorphismProperty.Over.w w
  haveI : WeaklyEtale (w.left ≫ B.hom) := by rw [hwB]; exact hWp
  haveI hw0 : WeaklyEtale w.left := WeaklyEtale.of_comp w.left B.hom

  let p₁ := Limits.pullback.fst w.left w.left
  let p₂ := Limits.pullback.snd w.left w.left
  haveI : WeaklyEtale p₁ := inferInstance
  haveI : WeaklyEtale (p₁ ≫ W.hom) := inferInstance
  let Zl : S.ProEt := Scheme.ProEt.mk (p₁ ≫ W.hom)
  have e₂ : p₂ ≫ W.hom = Zl.hom := by
    show p₂ ≫ W.hom = p₁ ≫ W.hom
    rw [← hwB, ← Category.assoc, ← Category.assoc, Limits.pullback.condition]
  let P₁ : Zl ⟶ W := MorphismProperty.Over.homMk p₁ rfl trivial
  let P₂ : Zl ⟶ W := MorphismProperty.Over.homMk p₂ e₂ trivial
  let O₁ : Over W := Over.mk P₁
  let O₂ : Over W := Over.mk P₂

  haveI hZc : CompactSpace (Limits.pullback w.left w.left : Scheme) :=
    QuasiCompact.compactSpace_of_compactSpace p₁
  haveI hZc' : CompactSpace ↥Zl.left := hZc

  let c : Fin r → (wcContSheaf S (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op Zl) := fun j =>
    (show (wcContSheaf S (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op Zl) from
      ULift.up (ContinuousMap.const ↥Zl.left (Pi.single j 1)))
  let sj : Fin r → G.obj.obj (Opposite.op Zl) := fun j =>
    (θ.inv.hom.app (Opposite.op O₁)).hom (c j)
  have hcancel : ∀ j, (θ.hom.hom.app (Opposite.op O₁)).hom (sj j) = c j := fun j =>
    congrArg (fun m => (m.hom.app (Opposite.op O₁)).hom (c j)) θ.inv_hom_id
  let Fj : Fin r → C(↥Zl.left, Fin r → ℚ_[ℓ]) := fun j =>
    (show C(↥Zl.left, Fin r → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op O₂)).hom (sj j)).down)

  have hbd : ∀ j, ∃ C : ℝ, ∀ x, ‖Fj j x‖ ≤ C := by
    intro j
    obtain ⟨C, hC⟩ := (isCompact_univ (X := ↥Zl.left)).exists_bound_of_continuousOn
      (Fj j).continuous.continuousOn
    exact ⟨C, fun x => hC x (Set.mem_univ x)⟩
  choose Cf hCf using hbd
  refine ⟨∑ i, |Cf i|, ?_⟩
  intro γ g hγ hg j

  have hγ0 : γ.left ≫ w.left = w.left := congrArg (fun f => f.left) hγ
  let Γ : W.left ⟶ Limits.pullback w.left w.left :=
    Limits.pullback.lift (𝟙 W.left) γ.left (by rw [Category.id_comp, hγ0])
  have hΓ1 : Γ ≫ p₁ = 𝟙 W.left := Limits.pullback.lift_fst _ _ _
  have hΓ2 : Γ ≫ p₂ = γ.left := Limits.pullback.lift_snd _ _ _
  have eΓ : Γ ≫ Zl.hom = W.hom := by
    show Γ ≫ p₁ ≫ W.hom = W.hom
    rw [← Category.assoc, hΓ1, Category.id_comp]
  let Γt : W ⟶ Zl := MorphismProperty.Over.homMk Γ eΓ trivial
  let a₁ : (Over.mk (𝟙 W) : Over W) ⟶ O₁ :=
    Over.homMk Γt (MorphismProperty.Over.Hom.ext (by exact hΓ1))
  let a₂ : (Over.mk γ : Over W) ⟶ O₂ :=
    Over.homMk Γt (MorphismProperty.Over.Hom.ext (by exact hΓ2))

  let s : G.obj.obj (Opposite.op W) := ((G.over W).obj.map a₁.op).hom (sj j)
  have hN1 : ∀ z : W.left, (show C(↥W.left, Fin r → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z = Pi.single j 1 := by
    intro z
    have N1 := congrArg (fun F : (G.over W).obj.obj (Opposite.op O₁) ⟶
        ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj
          (Opposite.op (Over.mk (𝟙 W) : Over W)) => F.hom (sj j))
      (θ.hom.hom.naturality a₁.op)
    have h3 := congrArg (fun y : ULift.{u+1} C(↥W.left, Fin r → ℚ_[ℓ]) => y.down z) N1
    have h4 := congrArg (fun y => (((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.map a₁.op).hom y)
      (hcancel j)
    have h5 := congrArg (fun y : ULift.{u+1} C(↥W.left, Fin r → ℚ_[ℓ]) => y.down z) h4
    exact h3.trans (h5.trans rfl)
  have hN2 : ∀ z : W.left, (show C(↥W.left, Fin r → ℚ_[ℓ]) from
      ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z = Fj j (Γ z) := by
    intro z
    have N2 := congrArg (fun F : (G.over W).obj.obj (Opposite.op O₂) ⟶
        ((wcContSheaf S (Fin r → ℚ_[ℓ])).over W).obj.obj
          (Opposite.op (Over.mk γ : Over W)) => F.hom (sj j))
      (θ.hom.hom.naturality a₂.op)
    have h3 := congrArg (fun y : ULift.{u+1} C(↥W.left, Fin r → ℚ_[ℓ]) => y.down z) N2
    exact h3

  obtain ⟨z₀⟩ := hWn
  have key : Fj j (Γ z₀) = g (Pi.single j 1) :=
    (hN2 z₀).symm.trans ((hg s z₀).trans (congrArg g (hN1 z₀)))
  calc ‖g (Pi.single j 1)‖ = ‖Fj j (Γ z₀)‖ := by rw [key]
    _ ≤ Cf j := hCf j _
    _ ≤ |Cf j| := le_abs_self _
    _ ≤ ∑ i, |Cf i| := Finset.single_le_sum (fun i _ => abs_nonneg (Cf i)) (Finset.mem_univ j)

theorem wc_padic_stable_lattice_coords (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (U₁ U₂ : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ])) (h12 : U₁ ≤ U₂)
    (GG : Set ((Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])))
    (hid : LinearMap.id ∈ GG) (hmul : ∀ g ∈ GG, ∀ g' ∈ GG, g' ∘ₗ g ∈ GG)
    (hst : ∀ g ∈ GG, ∀ x ∈ U₂, g x ∈ U₂ ∧ (x ∈ U₁ → g x ∈ U₁))
    (C : ℝ) (hC : ∀ g ∈ GG, ∀ j : Fin r, ‖g (Pi.single j 1)‖ ≤ C) :
    ∃ (q : ℕ) (π : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q → ℚ_[ℓ])),
      (∀ x ∈ U₂, π x = 0 ↔ x ∈ U₁) ∧ (∀ y, ∃ x ∈ U₂, π x = y) ∧
      ∀ g ∈ GG, ∀ x ∈ U₂, (∀ j, ‖π x j‖ ≤ 1) → ∀ j, ‖π (g x) j‖ ≤ 1 :=
by
  classical

  obtain ⟨q₀, π₀, s, hs, hπs, hker⟩ : ∃ (q : ℕ) (π₀ : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q → ℚ_[ℓ]))
      (s : (Fin q → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
      (∀ y, s y ∈ U₂) ∧ (∀ y, π₀ (s y) = y) ∧ (∀ x ∈ U₂, π₀ x = 0 ↔ x ∈ U₁) := by
    let P : Submodule ℚ_[ℓ] U₂ := U₁.comap U₂.subtype
    let bQ := Module.finBasis ℚ_[ℓ] (U₂ ⧸ P)
    let f : U₂ →ₗ[ℚ_[ℓ]] (Fin (Module.finrank ℚ_[ℓ] (U₂ ⧸ P)) → ℚ_[ℓ]) :=
      bQ.equivFun.toLinearMap ∘ₗ P.mkQ
    obtain ⟨π₀, hπ₀⟩ := LinearMap.exists_extend f
    have hfs : Function.Surjective f := bQ.equivFun.surjective.comp P.mkQ_surjective
    obtain ⟨h, hh⟩ :=
      LinearMap.exists_rightInverse_of_surjective f (LinearMap.range_eq_top.mpr hfs)
    refine ⟨_, π₀, U₂.subtype ∘ₗ h, fun y => (h y).2, fun y => ?_, fun x hx => ?_⟩
    · have e1 := LinearMap.congr_fun hπ₀ (h y)
      have e2 := LinearMap.congr_fun hh y
      simp only [LinearMap.comp_apply, Submodule.subtype_apply, LinearMap.id_apply] at e1 e2 ⊢
      rw [e1, e2]
    · have e1 := LinearMap.congr_fun hπ₀ ⟨x, hx⟩
      simp only [LinearMap.comp_apply, Submodule.subtype_apply] at e1
      rw [e1]
      simp only [f, LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.map_eq_zero_iff,
        Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, P, Submodule.mem_comap,
        Submodule.subtype_apply]

  have key : ∀ g ∈ GG, ∀ z ∈ U₂, π₀ (g (s (π₀ z))) = π₀ (g z) := by
    intro g hg z hz
    have hw2 : s (π₀ z) - z ∈ U₂ := U₂.sub_mem (hs _) hz
    have hw1 : s (π₀ z) - z ∈ U₁ := (hker _ hw2).mp (by rw [map_sub, hπs, sub_self])
    have hgw1 := (hst g hg _ hw2).2 hw1
    have e := (hker _ (h12 hgw1)).mpr hgw1
    rw [map_sub, map_sub, sub_eq_zero] at e
    exact e

  let G : Set (Fin q₀ → ℚ_[ℓ]) := {y | ∃ h ∈ GG, ∃ k : Fin q₀, y = π₀ (h (s (Pi.single k 1)))}
  let M : Submodule ℤ_[ℓ] (Fin q₀ → ℚ_[ℓ]) := Submodule.span ℤ_[ℓ] G
  have hM1 : ∀ k, Pi.single k (1 : ℚ_[ℓ]) ∈ M := fun k =>
    Submodule.subset_span ⟨LinearMap.id, hid, k, by rw [LinearMap.id_apply, hπs]⟩
  have hMst : ∀ g ∈ GG, ∀ y ∈ M, π₀ (g (s y)) ∈ M := by
    intro g hg y hy0
    have hy' : y ∈ Submodule.span ℤ_[ℓ] G := hy0
    clear hy0
    induction hy' using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨h, hh, k, rfl⟩ := hy
      apply Submodule.subset_span
      refine ⟨g ∘ₗ h, hmul h hh g hg, k, ?_⟩
      rw [key g hg _ (hst h hh _ (hs _)).1, LinearMap.comp_apply]
    | zero => rw [map_zero, map_zero, map_zero]; exact M.zero_mem
    | add x y _ _ hx hy => rw [map_add, map_add, map_add]; exact M.add_mem hx hy
    | smul a x _ hx =>
      rw [LinearMap.map_smul_of_tower, LinearMap.map_smul_of_tower,
        LinearMap.map_smul_of_tower]
      exact M.smul_mem a hx

  have colb : ∀ (a b : ℕ) (A : (Fin a → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ]))
      (v : Fin a → ℚ_[ℓ]), ‖A v‖ ≤ ∑ j, ‖v j‖ * ‖A (Pi.single j 1)‖ := by
    intro a b A v
    have hv : v = ∑ j, v j • Pi.single j (1 : ℚ_[ℓ]) := by
      ext i; simp [Finset.sum_apply, Pi.single_apply]
    calc ‖A v‖ = ‖∑ j, v j • A (Pi.single j 1)‖ := by
          congr 1
          conv_lhs => rw [hv]
          rw [map_sum]
          simp_rw [map_smul]
      _ ≤ ∑ j, ‖v j • A (Pi.single j 1)‖ := norm_sum_le _ _
      _ = ∑ j, ‖v j‖ * ‖A (Pi.single j 1)‖ := by simp_rw [norm_smul]
  set C' := max C 0 with hC'
  have hC'0 : 0 ≤ C' := le_max_right _ _
  have hGb : ∀ h ∈ GG, ∀ v : Fin r → ℚ_[ℓ], ‖h v‖ ≤ ∑ j, ‖v j‖ * C' := by
    intro h hh v
    refine (colb r r h v).trans (Finset.sum_le_sum fun j _ => ?_)
    exact mul_le_mul_of_nonneg_left ((hC h hh j).trans (le_max_left _ _)) (norm_nonneg _)
  set Kv : ℝ := ∑ k : Fin q₀, ∑ j, ‖s (Pi.single k 1) j‖ * C' with hKv
  set Kp : ℝ := ∑ j, ‖π₀ (Pi.single j 1)‖ with hKp
  have hKv0 : 0 ≤ Kv := Finset.sum_nonneg fun k _ =>
    Finset.sum_nonneg fun j _ => mul_nonneg (norm_nonneg _) hC'0
  have hKp0 : 0 ≤ Kp := Finset.sum_nonneg fun j _ => norm_nonneg _
  have hπb : ∀ x, ‖π₀ x‖ ≤ ‖x‖ * Kp := by
    intro x
    refine (colb r q₀ π₀ x).trans ?_
    rw [hKp, Finset.mul_sum]
    exact Finset.sum_le_sum fun j _ =>
      mul_le_mul_of_nonneg_right (norm_le_pi_norm x j) (norm_nonneg _)
  have hgen : ∀ y ∈ G, ∀ i, ‖y i‖ ≤ Kv * Kp := by
    rintro y ⟨h, hh, k, rfl⟩ i
    refine (norm_le_pi_norm _ i).trans ((hπb _).trans (mul_le_mul_of_nonneg_right ?_ hKp0))
    refine (hGb h hh _).trans ?_
    exact Finset.single_le_sum (f := fun k : Fin q₀ => ∑ j, ‖s (Pi.single k 1) j‖ * C')
      (fun k _ => Finset.sum_nonneg fun j _ => mul_nonneg (norm_nonneg _) hC'0)
      (Finset.mem_univ k)
  have hMb : ∀ m ∈ M, ∀ i, ‖m i‖ ≤ Kv * Kp := by
    intro m hm
    have hm' : m ∈ Submodule.span ℤ_[ℓ] G := hm
    clear hm
    induction hm' using Submodule.span_induction with
    | mem y hy => exact hgen y hy
    | zero => intro i; simp only [Pi.zero_apply, norm_zero]; exact mul_nonneg hKv0 hKp0
    | add x y _ _ hx hy =>
      intro i
      rw [Pi.add_apply]
      exact (Padic.nonarchimedean _ _).trans (max_le (hx i) (hy i))
    | smul a x _ hx =>
      intro i
      rw [Pi.smul_apply, Algebra.smul_def, PadicInt.algebraMap_apply, norm_mul]
      have ha : ‖(a : ℚ_[ℓ])‖ ≤ 1 := by rw [← PadicInt.norm_def]; exact PadicInt.norm_le_one a
      exact (mul_le_of_le_one_left (norm_nonneg _) ha).trans (hx i)

  have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
  have hℓN : ∀ N : ℕ, (ℓ : ℚ_[ℓ]) ^ N ≠ 0 := fun N =>
    pow_ne_zero N (by exact_mod_cast (Fact.out : ℓ.Prime).ne_zero)
  have clear : ∀ R : ℝ, ∃ N : ℕ, ∀ x : ℚ_[ℓ], ‖x‖ ≤ R → ‖(ℓ : ℚ_[ℓ]) ^ N * x‖ ≤ 1 := by
    intro R
    obtain ⟨N, hN⟩ := pow_unbounded_of_one_lt R hℓ1
    refine ⟨N, fun x hx => ?_⟩
    rw [norm_mul, norm_pow, Padic.norm_p, inv_pow]
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ N := by positivity
    rw [inv_mul_le_iff₀ hpos, mul_one]
    linarith

  obtain ⟨N0, hN0⟩ := clear (Kv * Kp)
  set c : ℚ_[ℓ] := ((ℓ : ℚ_[ℓ]) ^ N0)⁻¹ with hc
  let ι : (Fin q₀ → ℤ_[ℓ]) →ₗ[ℤ_[ℓ]] (Fin q₀ → ℚ_[ℓ]) :=
    { toFun := fun τ j => c * (τ j : ℚ_[ℓ])
      map_add' := fun τ τ' => by ext j; simp [mul_add]
      map_smul' := fun a τ => by
        ext j; simp [Algebra.smul_def, PadicInt.algebraMap_apply] <;> ring }
  have hMle : M ≤ LinearMap.range ι := by
    intro m hm
    refine ⟨fun j => ⟨(ℓ : ℚ_[ℓ]) ^ N0 * m j, hN0 _ (hMb m hm j)⟩, ?_⟩
    ext j
    show c * ((ℓ : ℚ_[ℓ]) ^ N0 * m j) = m j
    rw [hc, inv_mul_cancel_left₀ (hℓN N0)]
  have hιfg : (LinearMap.range ι).FG := by
    rw [LinearMap.range_eq_map]; exact (Module.Finite.fg_top).map ι
  have hMfg : M.FG := hιfg.of_le hMle
  haveI : Module.Finite ℤ_[ℓ] M := Module.Finite.iff_fg.mpr hMfg
  haveI : Module.Free ℤ_[ℓ] M := Module.free_of_finite_type_torsion_free'
  set n := Module.finrank ℤ_[ℓ] M with hn
  let b := Module.finBasis ℤ_[ℓ] M

  let Φ : (Fin n → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q₀ → ℚ_[ℓ]) :=
    { toFun := fun t => ∑ i, t i • ((b i : M) : Fin q₀ → ℚ_[ℓ])
      map_add' := fun t t' => by simp [add_smul, Finset.sum_add_distrib]
      map_smul' := fun a t => by simp [Finset.smul_sum, mul_smul] }
  have hΦ : ∀ t, Φ t = ∑ i, t i • ((b i : M) : Fin q₀ → ℚ_[ℓ]) := fun t => rfl
  have hH : ∀ τ : Fin n → ℤ_[ℓ],
      ((b.equivFun.symm τ : M) : Fin q₀ → ℚ_[ℓ]) = Φ (fun i => (τ i : ℚ_[ℓ])) := by
    intro τ
    rw [Module.Basis.equivFun_symm_apply, Submodule.coe_sum, hΦ]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Submodule.coe_smul, ← algebraMap_smul ℚ_[ℓ] (τ i) ((b i : M) : Fin q₀ → ℚ_[ℓ]),
      PadicInt.algebraMap_apply]
  have hHm : ∀ m : M, (m : Fin q₀ → ℚ_[ℓ]) = Φ (fun i => (b.equivFun m i : ℚ_[ℓ])) := by
    intro m
    rw [← hH, LinearEquiv.symm_apply_apply]
  have hinj : Function.Injective Φ := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro t ht
    obtain ⟨N, hN⟩ := clear (∑ i, ‖t i‖)
    have hti : ∀ i, ‖t i‖ ≤ ∑ i, ‖t i‖ := fun i =>
      Finset.single_le_sum (f := fun i => ‖t i‖) (fun i _ => norm_nonneg _) (Finset.mem_univ i)
    let τ : Fin n → ℤ_[ℓ] := fun i => ⟨(ℓ : ℚ_[ℓ]) ^ N * t i, hN _ (hti i)⟩
    have h1 : Φ (fun i => (τ i : ℚ_[ℓ])) = 0 := by
      have : (fun i => (τ i : ℚ_[ℓ])) = ((ℓ : ℚ_[ℓ]) ^ N) • t := by
        funext i; rfl
      rw [this, map_smul, ht, smul_zero]
    rw [← hH] at h1
    have h2 : b.equivFun.symm τ = 0 := Subtype.ext h1
    have h3 : τ = 0 := by
      rwa [LinearEquiv.map_eq_zero_iff] at h2
    funext i
    have h4 : (τ i : ℚ_[ℓ]) = 0 := by rw [h3]; rfl
    have h5 : (ℓ : ℚ_[ℓ]) ^ N * t i = 0 := h4
    exact (mul_eq_zero.mp h5).resolve_left (hℓN N)
  have hsurj : Function.Surjective Φ := by
    intro y
    have hy : y ∈ LinearMap.range Φ := by
      have hv : y = ∑ k, y k • Pi.single k (1 : ℚ_[ℓ]) := by
        ext i; simp [Finset.sum_apply, Pi.single_apply]
      rw [hv]
      refine Submodule.sum_mem _ (fun k _ => Submodule.smul_mem _ _ ?_)
      exact ⟨_, (hHm ⟨Pi.single k 1, hM1 k⟩).symm⟩
    exact hy
  let φ := (LinearEquiv.ofBijective Φ ⟨hinj, hsurj⟩).symm
  have hφΦ : ∀ t, φ (Φ t) = t := fun t =>
    (LinearEquiv.ofBijective Φ ⟨hinj, hsurj⟩).symm_apply_apply t
  have hΦφ : ∀ y, Φ (φ y) = y := fun y =>
    (LinearEquiv.ofBijective Φ ⟨hinj, hsurj⟩).apply_symm_apply y
  have hφM : ∀ y, y ∈ M ↔ ∀ i, ‖φ y i‖ ≤ 1 := by
    intro y
    constructor
    · intro hy i
      have e := hHm ⟨y, hy⟩
      simp only at e
      rw [e, hφΦ]
      rw [← PadicInt.norm_def]; exact PadicInt.norm_le_one _
    · intro hyi
      let τ : Fin n → ℤ_[ℓ] := fun i => ⟨φ y i, hyi i⟩
      have e : y = ((b.equivFun.symm τ : M) : Fin q₀ → ℚ_[ℓ]) := by
        rw [hH]
        conv_lhs => rw [← hΦφ y]
      rw [e]
      exact Submodule.coe_mem _

  refine ⟨n, φ.toLinearMap ∘ₗ π₀, fun x hx => ?_, fun y => ⟨s (φ.symm y), hs _, ?_⟩, ?_⟩
  · rw [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.map_eq_zero_iff]
    exact hker x hx
  · rw [LinearMap.comp_apply, LinearEquiv.coe_coe, hπs, LinearEquiv.apply_symm_apply]
  · intro g hg x hx hxi
    have h1 : π₀ x ∈ M := (hφM _).mpr hxi
    have h2 := hMst g hg _ h1
    rw [key g hg x hx] at h2
    exact (hφM _).mp h2

theorem wc_pfam_cover_exists_qc (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (q : ℕ) :
    ∃ Ω₀ : wcPfamCover M' h Δ ℓ q hPP, CompactSpace Ω₀.W'.left ∧ QuasiCompact Ω₀.w'.left :=
by
  classical
  obtain ⟨_, hprop, _, _, hΔ, _, hsm, _, _, _, _, hlamΔ, _⟩ := hH
  haveI hfp : IsProper h := hprop
  have hP1 : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  haveI hPw : WeaklyEtale (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom := hPP
  obtain ⟨Ub₁, hUb₁, hconn₁, -, -, -⟩ := wc_P1bar_smooth_locus F'' hP1 D.m D.S D.hS
  obtain ⟨y₁⟩ := hconn₁.toNonempty
  have hy₁ : Ub₁.ι y₁ ∈ Ub₁ := by
    have hr : Ub₁.ι y₁ ∈ Set.range Ub₁.ι := ⟨y₁, rfl⟩
    rwa [Scheme.Opens.range_ι] at hr
  have htS := (hUb₁ (Ub₁.ι y₁)).1 hy₁
  have hlt : lam ((wcGeomPoint F'' (wcP1Over F'') hP1).hom (Ub₁.ι y₁)) ∉ Δ := by
    intro hin
    obtain ⟨i, hi⟩ := (hlamΔ _).1 hin
    exact htS i hi
  obtain ⟨p₀, hp₀, -⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := (Over.mk (wcProjKStr F'' M')).hom)
    (g := Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
    (lam ((wcGeomPoint F'' (wcP1Over F'') hP1).hom (Ub₁.ι y₁)))
    (IsLocalRing.closedPoint (AlgebraicClosure F''))
    (@Subsingleton.elim (PrimeSpectrum F'') inferInstance _ _)
  have hp₀' : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom p₀ =
      lam ((wcGeomPoint F'' (wcP1Over F'') hP1).hom (Ub₁.ι y₁)) := hp₀
  have hne : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom p₀ ∉ Δ := by
    rw [hp₀']; exact hlt
  let U₀ : (wcProjK F'' M').Opens := ⟨Δᶜ, isOpen_compl_iff.mpr hΔ⟩
  let Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens :=
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom ⁻¹ᵁ U₀
  have hUb : ∀ x : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left, x ∈ Ub ↔
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom x ∉ Δ := fun x => Iff.rfl
  haveI hpr : IsProper (Over.mk (wcProjKStr F'' M')).hom := wc_proj_space_isProper F'' M'
  haveI : IsLocallyNoetherian (Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd _ _)
  haveI : CompactSpace ↥(Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd _ _)
  haveI : AlgebraicGeometry.IsNoetherian (Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    AlgebraicGeometry.IsNoetherian.mk
  haveI hN : TopologicalSpace.NoetherianSpace
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left :=
    (inferInstance : TopologicalSpace.NoetherianSpace ↥(Limits.pullback
      (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
  obtain ⟨eP, heP, -⟩ := wcpa_proj_base_change F'' (AlgebraicClosure F'') M'
  haveI := heP
  haveI := wc_proj_space_irreducible (AlgebraicClosure F'') M'
  haveI hirrP : IrreducibleSpace (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left :=
    Function.Surjective.irreducibleSpace (Scheme.Hom.homeomorph eP).symm.continuous
      (Scheme.Hom.homeomorph eP).symm.surjective
  have hirr : IsIrreducible (Ub : Set (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left) :=
    ⟨⟨p₀, (hUb p₀).2 hne⟩, (IrreducibleSpace.isIrreducible_univ _).isPreirreducible.open_subset
      Ub.isOpen (Set.subset_univ _)⟩
  haveI hNU : TopologicalSpace.NoetherianSpace Ub.toScheme :=
    TopologicalSpace.NoetherianSpace.set
      (Ub : Set (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left)
  have hconn : ConnectedSpace Ub.toScheme := isConnected_iff_connectedSpace.mp hirr.isConnected
  haveI hcpt : CompactSpace Ub.toScheme := inferInstance
  have hqs : QuasiSeparatedSpace Ub.toScheme := inferInstance
  haveI hqcι : QuasiCompact Ub.ι := quasiCompact_of_noetherianSpace_source Ub.ι
  have hu : WeaklyEtale (Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) :=
    inferInstance
  have htors : ∀ j : ℕ, ∃ (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme),
      IsFinite πE ∧ Etale πE ∧ Surjective πE ∧
      ∃ hE : WeaklyEtale (πE ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom),
      ∃ (b' : ℕ) (e' : Fin b' → ℕ),
        Nonempty ((((wcProEtPush h).rightDerived (Nat.unpair j).1).obj
            (wcContSheaf Xu.left (ZMod (ℓ ^ (Nat.unpair j).2)))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫
              (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) hE) ≅
          (wcContSheaf (wcProjK F'' M') ((i : Fin b') → ZMod (ℓ ^ e' i))).over
            (MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫
              (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) hE)) := by
    intro j
    obtain ⟨N, V, v, het, hcov, hV, b, e, hiso⟩ :=
      wc_pfam_Rq_torsion_etale_locally_const F'' M' Xu.left h Δ hΔ hsm ℓ hℓ hPP Ub hUb hcpt
        (Nat.unpair j).1 (Nat.unpair j).2
    exact wc_proet_loc_const_finite_fet_trivial (wcProjK F'' M') _ ℓ Ub.toScheme
      (Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) hu hconn hcpt hqs
      N V v het hcov hV b e hiso
  choose E πE hfin het hsurj hE b' e' hθ using htors
  obtain ⟨W₀, pr, hpWE, hpqc, hpsurj, hW₀conn, hW₀cpt, hW₀qs, ht, hgal₀⟩ :=
    wc_fet_galois_tower_connected_limit Ub.toScheme hconn hcpt hqs E πE hfin het hsurj
  choose t ht using ht
  haveI := hpWE
  haveI := hpqc
  have hWE : WeaklyEtale (pr ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) :=
    inferInstance
  let W : (wcProjK F'' M').ProEt :=
    MorphismProperty.Over.mk ⊤ (pr ≫ Ub.ι ≫
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) hWE
  let w : W ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP :=
    MorphismProperty.Over.homMk (pr ≫ Ub.ι) (Category.assoc _ _ _) trivial
  let Ej : ℕ → (wcProjK F'' M').ProEt := fun j =>
    MorphismProperty.Over.mk ⊤ (πE j ≫ Ub.ι ≫
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) (hE j)
  let c : ∀ j, W ⟶ Ej j := fun j =>
    MorphismProperty.Over.homMk (t j)
      (show t j ≫ πE j ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
          pr ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom by
        rw [← Category.assoc, ht j]) trivial
  have hres : ∀ q' k : ℕ, ∃ (b : ℕ) (e : Fin b → ℕ),
      Nonempty ((((wcProEtPush h).rightDerived q').obj
          (wcContSheaf Xu.left (ZMod (ℓ ^ k)))).over W ≅
        (wcContSheaf (wcProjK F'' M') ((j : Fin b) → ZMod (ℓ ^ e j))).over W) := by
    intro q' k
    have hh := hθ (Nat.pair q' k)
    rw [Nat.unpair_pair] at hh
    obtain ⟨θ⟩ := hh
    exact ⟨b' (Nat.pair q' k), e' (Nat.pair q' k),
      ⟨((Scheme.ProEt.topology (wcProjK F'' M')).overMapPullback AddCommGrpCat.{u+1}
        (c (Nat.pair q' k))).mapIso θ⟩⟩
  obtain ⟨a, b, e, hZ⟩ :=
    wc_proet_Rq_int_const_of_torsion_const h ℓ W hW₀conn hW₀cpt hW₀qs hres q
  obtain ⟨τ, hτ⟩ := wc_proet_Rq_rat_linear_triv h ℓ W hW₀conn hW₀cpt hW₀qs q a b e hZ
  refine ⟨⟨W, w, a, τ, fun c' => hτ c', hW₀conn, ?_, ?_, ?_⟩, ?_, ?_⟩
  · intro z
    have hy : Ub.ι (pr z) ∈ Ub := by
      have hr : Ub.ι (pr z) ∈ Set.range Ub.ι := ⟨pr z, rfl⟩
      rw [Scheme.Opens.range_ι] at hr
      exact hr
    have key := (hUb (Ub.ι (pr z))).1 hy
    exact key
  · intro x hx
    have hxU : x ∈ Ub := (hUb x).2 hx
    obtain ⟨y, hy⟩ : x ∈ Set.range Ub.ι := by rw [Scheme.Opens.range_ι]; exact hxU
    obtain ⟨z, hz⟩ := hpsurj.surj y
    refine ⟨z, ?_⟩
    show (pr ≫ Ub.ι) z = x
    rw [Scheme.Hom.comp_apply, hz, hy]
  · intro V a' b'' hV hab
    have h1 : a'.left ≫ pr ≫ Ub.ι = b''.left ≫ pr ≫ Ub.ι := by
      have := congrArg (fun f => f.left) hab
      exact this
    have h2' : (a'.left ≫ pr) ≫ Ub.ι = (b''.left ≫ pr) ≫ Ub.ι := by
      have e1 := Category.assoc a'.left pr Ub.ι
      have e2 := Category.assoc b''.left pr Ub.ι
      exact e1.trans (h1.trans e2.symm)
    have h2 : a'.left ≫ pr = b''.left ≫ pr := (cancel_mono Ub.ι).1 h2'
    obtain ⟨γ₀, hγp, hγb⟩ := hgal₀ V.left a'.left b''.left hV h2
    let γ : W ⟶ W := MorphismProperty.Over.homMk γ₀
      (show γ₀ ≫ pr ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
          pr ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom by
        rw [← Category.assoc, hγp]) trivial
    refine ⟨γ, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      show γ₀ ≫ pr ≫ Ub.ι = pr ≫ Ub.ι
      rw [← Category.assoc, hγp]
    · apply MorphismProperty.Over.Hom.ext
      show b''.left = a'.left ≫ γ₀
      exact hγb
  · show CompactSpace W₀
    exact hW₀cpt
  · show QuasiCompact (pr ≫ Ub.ι)
    exact quasiCompact_comp pr Ub.ι

theorem wc_pfam_cover_fibre_product {F'' : Type u} [Field F''] [Finite F''] (M' : ℕ)
    {X : Scheme.{u}} (h : X ⟶ wcProjK F'' M') (Δ : Set (wcProjK F'' M')) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (q : ℕ)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω Ω₀ : wcPfamCover M' h Δ ℓ q hPP) (hqc₀ : QuasiCompact Ω₀.w'.left) :
    ∃ (Z : (wcProjK F'' M').ProEt) (pr1 : Z ⟶ Ω.W') (pr2 : Z ⟶ Ω₀.W'),
      pr1 ≫ Ω.w' = pr2 ≫ Ω₀.w' ∧ Topology.IsQuotientMap pr1.left ∧ Nonempty Z.left ∧
      (∀ σ : Ω.W' ⟶ Ω.W', σ ≫ Ω.w' = Ω.w' →
        ∃ τ : Z ⟶ Z, τ ≫ pr1 = pr1 ≫ σ ∧ τ ≫ pr2 = pr2) ∧
      (∀ z z'' : Z.left, pr1.left z = pr1.left z'' →
        ∃ (σ₀ : Ω₀.W' ⟶ Ω₀.W') (τ : Z ⟶ Z), σ₀ ≫ Ω₀.w' = Ω₀.w' ∧ τ ≫ pr1 = pr1 ∧
          τ ≫ pr2 = pr2 ≫ σ₀ ∧ τ.left z = z'') :=
by
  classical

  have s2 : ∀ {P Y : Scheme.{u}} (p : P ⟶ Y) (z z'' : P), p z = p z'' →
      ∃ (L : Type u) (_ : Field L) (_ : IsSepClosed L) (c c'' : Spec (.of L) ⟶ P),
        c ≫ p = c'' ≫ p ∧ (∀ s, c s = z) ∧ (∀ s, c'' s = z'') := by
    intro P Y p z z'' hzz
    obtain ⟨s₀⟩ : Nonempty (Spec (P.residueField z)) := inferInstance
    obtain ⟨s₀''⟩ : Nonempty (Spec (P.residueField z'')) := inferInstance
    have hf : (P.fromSpecResidueField z ≫ p) s₀ = (P.fromSpecResidueField z'' ≫ p) s₀'' := by
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply,
        Scheme.fromSpecResidueField_apply, hzz]
    obtain ⟨y, -, -⟩ := Scheme.Pullback.exists_preimage_pullback s₀ s₀'' hf
    let K : CommRingCat.{u} := (Limits.pullback (P.fromSpecResidueField z ≫ p)
        (P.fromSpecResidueField z'' ≫ p)).residueField y
    let c₀ : Spec (.of (AlgebraicClosure K)) ⟶ Limits.pullback (P.fromSpecResidueField z ≫ p)
        (P.fromSpecResidueField z'' ≫ p) :=
      Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)) :
          K ⟶ CommRingCat.of (AlgebraicClosure K)) ≫
        (Limits.pullback (P.fromSpecResidueField z ≫ p)
          (P.fromSpecResidueField z'' ≫ p)).fromSpecResidueField y
    refine ⟨AlgebraicClosure K, inferInstance, inferInstance,
      c₀ ≫ Limits.pullback.fst _ _ ≫ P.fromSpecResidueField z,
      c₀ ≫ Limits.pullback.snd _ _ ≫ P.fromSpecResidueField z'', ?_, ?_, ?_⟩
    · simp only [Category.assoc]
      rw [Limits.pullback.condition]
    · intro s
      simp only [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
    · intro s
      simp only [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]

  haveI hPw : WeaklyEtale (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom := hPP
  haveI hW0 : WeaklyEtale Ω₀.W'.hom := Ω₀.W'.prop
  haveI hW : WeaklyEtale Ω.W'.hom := Ω.W'.prop
  have ew0 : Ω₀.w'.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom = Ω₀.W'.hom :=
    MorphismProperty.Over.w Ω₀.w'
  have ew : Ω.w'.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom = Ω.W'.hom :=
    MorphismProperty.Over.w Ω.w'
  haveI : WeaklyEtale
      (Ω₀.w'.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) := by
    rw [ew0]; exact hW0
  haveI ha0 : WeaklyEtale Ω₀.w'.left :=
    WeaklyEtale.of_comp Ω₀.w'.left (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
  haveI : Flat Ω₀.w'.left := inferInstance
  haveI := hqc₀
  haveI : WeaklyEtale (Limits.pullback.fst Ω.w'.left Ω₀.w'.left) := inferInstance
  haveI hZW : WeaklyEtale (Limits.pullback.fst Ω.w'.left Ω₀.w'.left ≫ Ω.W'.hom) := inferInstance

  have hcond : Limits.pullback.snd Ω.w'.left Ω₀.w'.left ≫ Ω₀.W'.hom =
      Limits.pullback.fst Ω.w'.left Ω₀.w'.left ≫ Ω.W'.hom := by
    rw [← ew0, ← ew, ← Category.assoc,
      ← Category.assoc, Limits.pullback.condition]

  have hrange : ∀ x : Ω.W'.left, ∃ y : Ω₀.W'.left, Ω₀.w'.left y = Ω.w'.left x := by
    intro x
    apply Ω₀.hcov'
    have e : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom (Ω.w'.left x) =
        Ω.W'.hom x := by
      rw [← ew, Scheme.Hom.comp_apply]
    rw [e]
    exact Ω.hoff' x
  have hsurj : Function.Surjective (Limits.pullback.fst Ω.w'.left Ω₀.w'.left) := by
    intro x
    obtain ⟨y, hy⟩ := hrange x
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := Ω.w'.left)
      (g := Ω₀.w'.left) x y hy.symm
    exact ⟨z, hz⟩
  haveI : Surjective (Limits.pullback.fst Ω.w'.left Ω₀.w'.left) := ⟨hsurj⟩
  have hquot : Topology.IsQuotientMap (Limits.pullback.fst Ω.w'.left Ω₀.w'.left) :=
    Flat.isQuotientMap_of_surjective _
  refine ⟨MorphismProperty.Over.mk ⊤ (Limits.pullback.fst Ω.w'.left Ω₀.w'.left ≫ Ω.W'.hom) hZW,
    MorphismProperty.Over.homMk (Limits.pullback.fst Ω.w'.left Ω₀.w'.left) rfl,
    MorphismProperty.Over.homMk (Limits.pullback.snd Ω.w'.left Ω₀.w'.left) hcond,
    ?_, hquot, ?_, ?_, ?_⟩
  · exact MorphismProperty.Over.Hom.ext Limits.pullback.condition
  · obtain ⟨x₀⟩ := @ConnectedSpace.toNonempty _ _ Ω.hconn'
    obtain ⟨z₀, -⟩ := hsurj x₀
    exact ⟨z₀⟩
  · intro σ hσ
    have kσ : σ.left ≫ Ω.w'.left = Ω.w'.left := congrArg (fun f => f.left) hσ
    obtain ⟨τs, hτ1, hτ2⟩ : ∃ τs : Limits.pullback Ω.w'.left Ω₀.w'.left ⟶
        Limits.pullback Ω.w'.left Ω₀.w'.left,
        τs ≫ Limits.pullback.fst Ω.w'.left Ω₀.w'.left =
          Limits.pullback.fst Ω.w'.left Ω₀.w'.left ≫ σ.left ∧
        τs ≫ Limits.pullback.snd Ω.w'.left Ω₀.w'.left =
          Limits.pullback.snd Ω.w'.left Ω₀.w'.left :=
      ⟨Limits.pullback.lift (Limits.pullback.fst Ω.w'.left Ω₀.w'.left ≫ σ.left)
        (Limits.pullback.snd Ω.w'.left Ω₀.w'.left)
        (by rw [Category.assoc, kσ, Limits.pullback.condition]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hτs : τs ≫ Limits.pullback.fst Ω.w'.left Ω₀.w'.left ≫ Ω.W'.hom =
        Limits.pullback.fst Ω.w'.left Ω₀.w'.left ≫ Ω.W'.hom := by
      have eσ : σ.left ≫ Ω.W'.hom = Ω.W'.hom := MorphismProperty.Over.w σ
      rw [← Category.assoc, hτ1, Category.assoc, eσ]
    exact ⟨MorphismProperty.Over.homMk τs hτs, MorphismProperty.Over.Hom.ext hτ1,
      MorphismProperty.Over.Hom.ext hτ2⟩
  · intro z z'' hzz
    obtain ⟨L, _, _, c, c'', hcc, hc, hc''⟩ :=
      s2 (Limits.pullback.fst Ω.w'.left Ω₀.w'.left) z z'' hzz
    have h12 : (c ≫ Limits.pullback.snd Ω.w'.left Ω₀.w'.left) ≫ Ω₀.w'.left =
        (c'' ≫ Limits.pullback.snd Ω.w'.left Ω₀.w'.left) ≫ Ω₀.w'.left := by
      rw [Category.assoc, Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hcc,
        Category.assoc]
    obtain ⟨σ₀, hσ₀, hb⟩ := wc_pfam_lfl_fibre_transitive M' h Δ ℓ q hPP Ω₀ L (Spec (.of L))
      (Iso.refl _) _ _ h12
    have kσ₀ : σ₀.left ≫ Ω₀.w'.left = Ω₀.w'.left := congrArg (fun f => f.left) hσ₀
    obtain ⟨τs, hτ1, hτ2⟩ : ∃ τs : Limits.pullback Ω.w'.left Ω₀.w'.left ⟶
        Limits.pullback Ω.w'.left Ω₀.w'.left,
        τs ≫ Limits.pullback.fst Ω.w'.left Ω₀.w'.left =
          Limits.pullback.fst Ω.w'.left Ω₀.w'.left ∧
        τs ≫ Limits.pullback.snd Ω.w'.left Ω₀.w'.left =
          Limits.pullback.snd Ω.w'.left Ω₀.w'.left ≫ σ₀.left :=
      ⟨Limits.pullback.lift (Limits.pullback.fst Ω.w'.left Ω₀.w'.left)
        (Limits.pullback.snd Ω.w'.left Ω₀.w'.left ≫ σ₀.left)
        (by rw [Category.assoc, kσ₀, Limits.pullback.condition]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hτs : τs ≫ Limits.pullback.fst Ω.w'.left Ω₀.w'.left ≫ Ω.W'.hom =
        Limits.pullback.fst Ω.w'.left Ω₀.w'.left ≫ Ω.W'.hom := by
      rw [← Category.assoc, hτ1]
    have hcτ : c ≫ τs = c'' := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hτ1, hcc]
      · rw [Category.assoc, hτ2, ← Category.assoc, ← hb]
    obtain ⟨s⟩ : Nonempty (Spec (.of L)) := inferInstance
    refine ⟨σ₀, MorphismProperty.Over.homMk τs hτs, hσ₀, MorphismProperty.Over.Hom.ext hτ1,
      MorphismProperty.Over.Hom.ext hτ2, ?_⟩
    show τs z = z''
    rw [← hc'' s, ← hcτ, Scheme.Hom.comp_apply, hc s]

theorem wc_pfam_cover_compare {F'' : Type u} [Field F''] {M' : ℕ} {X : Scheme.{u}}
    {h : X ⟶ wcProjK F'' M'} {Δ : Set (wcProjK F'' M')} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {q : ℕ}
    {hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (Ω Ω₀ : wcPfamCover M' h Δ ℓ q hPP) (Z : (wcProjK F'' M').ProEt)
    (pr1 : Z ⟶ Ω.W') (pr2 : Z ⟶ Ω₀.W') :
    ∃ M : Z.left → ((Fin Ω.r' → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ])),
      (∀ v, Continuous (fun z => M z v)) ∧
      (∀ (σ : Ω.W' ⟶ Ω.W') (g : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
        (∀ (V : (wcProjK F'' M').ProEt) (a : V ⟶ Ω.W') (x : (wcRq h ℓ q).obj.obj (Opposite.op V))
          (t : V.left),
          (show C(↥V.left, Fin Ω.r' → ℚ_[ℓ]) from
            ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (a ≫ σ)))).hom x).down) t =
          g ((show C(↥V.left, Fin Ω.r' → ℚ_[ℓ]) from
            ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) t)) →
        ∀ τ : Z ⟶ Z, τ ≫ pr1 = pr1 ≫ σ → τ ≫ pr2 = pr2 →
        ∀ (z : Z.left) (v : Fin Ω.r' → ℚ_[ℓ]), M (τ.left z) (g v) = M z v) ∧
      (∀ (σ₀ : Ω₀.W' ⟶ Ω₀.W') (g₀ : (Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ])),
        (∀ (V : (wcProjK F'' M').ProEt) (a : V ⟶ Ω₀.W') (x : (wcRq h ℓ q).obj.obj (Opposite.op V))
          (t : V.left),
          (show C(↥V.left, Fin Ω₀.r' → ℚ_[ℓ]) from
            ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk (a ≫ σ₀)))).hom x).down) t =
          g₀ ((show C(↥V.left, Fin Ω₀.r' → ℚ_[ℓ]) from
            ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) t)) →
        ∀ τ : Z ⟶ Z, τ ≫ pr1 = pr1 → τ ≫ pr2 = pr2 ≫ σ₀ →
        ∀ (z : Z.left) (v : Fin Ω.r' → ℚ_[ℓ]), M (τ.left z) v = g₀ (M z v)) :=
by
  classical

  have hF : ∀ (W₁ W₂ : (wcProjK F'' M').ProEt) (r₁ r₂ : ℕ)
      (θ₁ : (wcRq h ℓ q).over W₁ ≅ (wcContSheaf (wcProjK F'' M') (Fin r₁ → ℚ_[ℓ])).over W₁)
      (θ₂ : (wcRq h ℓ q).over W₂ ≅ (wcContSheaf (wcProjK F'' M') (Fin r₂ → ℚ_[ℓ])).over W₂)
      (p₁ : Z ⟶ W₁) (p₂ : Z ⟶ W₂),
      ∃ Gm : Z.left → ((Fin r₁ → ℚ_[ℓ]) →+ (Fin r₂ → ℚ_[ℓ])),
        ∀ (V : (wcProjK F'' M').ProEt) (b : V ⟶ Z) (x : (wcRq h ℓ q).obj.obj (Opposite.op V))
          (t : V.left),
          (show C(↥V.left, Fin r₂ → ℚ_[ℓ]) from
            ((θ₂.hom.hom.app (Opposite.op (Over.mk (b ≫ p₂)))).hom x).down) t =
          Gm (b.left t) ((show C(↥V.left, Fin r₁ → ℚ_[ℓ]) from
            ((θ₁.hom.hom.app (Opposite.op (Over.mk (b ≫ p₁)))).hom x).down) t) := by
    intro W₁ W₂ r₁ r₂ θ₁ θ₂ p₁ p₂
    let ρ1 : (wcContSheaf (wcProjK F'' M') (Fin r₁ → ℚ_[ℓ])).over Z ⟶ (wcRq h ℓ q).over Z :=
      ⟨{ app := fun T => θ₁.inv.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ p₁)))
         naturality := fun X Y f => θ₁.inv.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ p₁ = Y.unop.hom ≫ p₁
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ p₁) ⟶ Over.mk (X.unop.hom ≫ p₁)).op }⟩
    let ρ2 : (wcRq h ℓ q).over Z ⟶ (wcContSheaf (wcProjK F'' M') (Fin r₂ → ℚ_[ℓ])).over Z :=
      ⟨{ app := fun T => θ₂.hom.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ p₂)))
         naturality := fun X Y f => θ₂.hom.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ p₂ = Y.unop.hom ≫ p₂
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ p₂) ⟶ Over.mk (X.unop.hom ≫ p₂)).op }⟩
    obtain ⟨Gm, hGm⟩ := wc_contSheaf_over_hom_padic_pointwise (wcProjK F'' M') ℓ r₁ r₂ Z
      (ρ1 ≫ ρ2)
    refine ⟨Gm, fun V b x t => ?_⟩
    have hc : (θ₁.inv.hom.app (Opposite.op (Over.mk (b ≫ p₁)))).hom
        ((θ₁.hom.hom.app (Opposite.op (Over.mk (b ≫ p₁)))).hom x) = x :=
      congrArg (fun m => (m.hom.app (Opposite.op (Over.mk (b ≫ p₁)))).hom x) θ₁.hom_inv_id
    have E : ((ρ1 ≫ ρ2).hom.app (Opposite.op (Over.mk b))).hom
        ((θ₁.hom.hom.app (Opposite.op (Over.mk (b ≫ p₁)))).hom x) =
        (θ₂.hom.hom.app (Opposite.op (Over.mk (b ≫ p₂)))).hom x :=
      congrArg (θ₂.hom.hom.app (Opposite.op (Over.mk (b ≫ p₂)))).hom hc
    have h1 := hGm (Over.mk b) ((θ₁.hom.hom.app (Opposite.op (Over.mk (b ≫ p₁)))).hom x) t
    have h4 := congrArg (fun y : ULift.{u+1} C(↥V.left, Fin r₂ → ℚ_[ℓ]) => y.down t) E
    exact h4.symm.trans h1
  obtain ⟨Gf, hGf⟩ := hF Ω.W' Ω₀.W' Ω.r' Ω₀.r' Ω.θ' Ω₀.θ' pr1 pr2
  obtain ⟨Hf, hHf⟩ := hF Ω₀.W' Ω.W' Ω₀.r' Ω.r' Ω₀.θ' Ω.θ' pr2 pr1

  have T1 : ∀ (u u' : Z ⟶ Ω.W'), u = u' → ∀ (y : (wcRq h ℓ q).obj.obj (Opposite.op Z))
      (t : Z.left),
      (show C(↥Z.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk u))).hom y).down) t =
      (show C(↥Z.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk u'))).hom y).down) t := by
    rintro u _ rfl y t
    rfl
  have T0 : ∀ (u u' : Z ⟶ Ω₀.W'), u = u' → ∀ (y : (wcRq h ℓ q).obj.obj (Opposite.op Z))
      (t : Z.left),
      (show C(↥Z.left, Fin Ω₀.r' → ℚ_[ℓ]) from
        ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk u))).hom y).down) t =
      (show C(↥Z.left, Fin Ω₀.r' → ℚ_[ℓ]) from
        ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk u'))).hom y).down) t := by
    rintro u _ rfl y t
    rfl

  let xv : (Fin Ω.r' → ℚ_[ℓ]) → (wcRq h ℓ q).obj.obj (Opposite.op Z) := fun v =>
    (Ω.θ'.inv.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr1)))).hom
      (show (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Z) from
        ULift.up (ContinuousMap.const ↥Z.left v))
  let xw : (Fin Ω₀.r' → ℚ_[ℓ]) → (wcRq h ℓ q).obj.obj (Opposite.op Z) := fun w =>
    (Ω₀.θ'.inv.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr2)))).hom
      (show (wcContSheaf (wcProjK F'' M') (Fin Ω₀.r' → ℚ_[ℓ])).obj.obj (Opposite.op Z) from
        ULift.up (ContinuousMap.const ↥Z.left w))
  have hxv : ∀ (v : Fin Ω.r' → ℚ_[ℓ]) (t : Z.left),
      (show C(↥Z.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr1)))).hom (xv v)).down) t = v := by
    intro v t
    have hs := congrArg (fun m => (m.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr1)))).hom
      (show (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Z) from
        ULift.up (ContinuousMap.const ↥Z.left v))) Ω.θ'.inv_hom_id
    exact congrArg (fun y : ULift.{u+1} C(↥Z.left, Fin Ω.r' → ℚ_[ℓ]) => y.down t) hs
  have hxw : ∀ (w : Fin Ω₀.r' → ℚ_[ℓ]) (t : Z.left),
      (show C(↥Z.left, Fin Ω₀.r' → ℚ_[ℓ]) from
        ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr2)))).hom (xw w)).down) t = w := by
    intro w t
    have hs := congrArg (fun m => (m.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr2)))).hom
      (show (wcContSheaf (wcProjK F'' M') (Fin Ω₀.r' → ℚ_[ℓ])).obj.obj (Opposite.op Z) from
        ULift.up (ContinuousMap.const ↥Z.left w))) Ω₀.θ'.inv_hom_id
    exact congrArg (fun y : ULift.{u+1} C(↥Z.left, Fin Ω₀.r' → ℚ_[ℓ]) => y.down t) hs

  have K1 : ∀ (z : Z.left) (v : Fin Ω.r' → ℚ_[ℓ]), Gf z v =
      (show C(↥Z.left, Fin Ω₀.r' → ℚ_[ℓ]) from
        ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr2)))).hom (xv v)).down) z := by
    intro z v
    exact ((hGf Z (𝟙 Z) (xv v) z).trans (congrArg (Gf ((𝟙 Z : Z ⟶ Z).left z)) (hxv v z))).symm
  have K1' : ∀ (z : Z.left) (w : Fin Ω₀.r' → ℚ_[ℓ]), Hf z w =
      (show C(↥Z.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr1)))).hom (xw w)).down) z := by
    intro z w
    exact ((hHf Z (𝟙 Z) (xw w) z).trans (congrArg (Hf ((𝟙 Z : Z ⟶ Z).left z)) (hxw w z))).symm

  have hinvA : ∀ (z : Z.left) (v : Fin Ω.r' → ℚ_[ℓ]), Hf z (Gf z v) = v := by
    intro z v
    exact ((hxv v z).symm.trans ((hHf Z (𝟙 Z) (xv v) z).trans
      (congrArg (Hf z) (K1 z v).symm))).symm
  have hinvB : ∀ (z : Z.left) (w : Fin Ω₀.r' → ℚ_[ℓ]), Gf z (Hf z w) = w := by
    intro z w
    exact ((hxw w z).symm.trans ((hGf Z (𝟙 Z) (xw w) z).trans
      (congrArg (Gf z) (K1' z w).symm))).symm

  have hsc : ∀ (c : ℚ_[ℓ]) (y : (wcRq h ℓ q).obj.obj (Opposite.op Z)) (t : Z.left),
      (show C(↥Z.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr1)))).hom
          (((wcRqScalar h ℓ q c).hom.app (Opposite.op Z)).hom y)).down) t =
      c • (show C(↥Z.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr1)))).hom y).down) t := by
    intro c y t
    have e := congrArg (fun m => (m.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr1)))).hom y)
      (Ω.hθc' c)
    exact congrArg (fun s : ULift.{u+1} C(↥Z.left, Fin Ω.r' → ℚ_[ℓ]) => s.down t) e
  have hsc₀ : ∀ (c : ℚ_[ℓ]) (y : (wcRq h ℓ q).obj.obj (Opposite.op Z)) (t : Z.left),
      (show C(↥Z.left, Fin Ω₀.r' → ℚ_[ℓ]) from
        ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr2)))).hom
          (((wcRqScalar h ℓ q c).hom.app (Opposite.op Z)).hom y)).down) t =
      c • (show C(↥Z.left, Fin Ω₀.r' → ℚ_[ℓ]) from
        ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr2)))).hom y).down) t := by
    intro c y t
    have e := congrArg (fun m => (m.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr2)))).hom y)
      (Ω₀.hθc' c)
    exact congrArg (fun s : ULift.{u+1} C(↥Z.left, Fin Ω₀.r' → ℚ_[ℓ]) => s.down t) e
  have hlin : ∀ (z : Z.left) (c : ℚ_[ℓ]) (v : Fin Ω.r' → ℚ_[ℓ]), Gf z (c • v) = c • Gf z v := by
    intro z c v
    have a1 := hGf Z (𝟙 Z) (((wcRqScalar h ℓ q c).hom.app (Opposite.op Z)).hom (xv v)) z
    have a2 := hsc c (xv v) z
    have a3 := hsc₀ c (xv v) z
    calc Gf z (c • v)
        = Gf z (c • (show C(↥Z.left, Fin Ω.r' → ℚ_[ℓ]) from
            ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr1)))).hom (xv v)).down) z) :=
          congrArg (fun w => Gf z (c • w)) (hxv v z).symm
      _ = Gf z ((show C(↥Z.left, Fin Ω.r' → ℚ_[ℓ]) from
            ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr1)))).hom
              (((wcRqScalar h ℓ q c).hom.app (Opposite.op Z)).hom (xv v))).down) z) :=
          congrArg (Gf z) a2.symm
      _ = c • (show C(↥Z.left, Fin Ω₀.r' → ℚ_[ℓ]) from
            ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr2)))).hom (xv v)).down) z :=
          a1.symm.trans a3
      _ = c • Gf z v := congrArg (fun w => c • w) (K1 z v).symm
  refine ⟨fun z => (AddMonoidHom.toAddEquiv (Gf z) (Hf z)
      (AddMonoidHom.ext fun v => hinvA z v) (AddMonoidHom.ext fun w => hinvB z w)).toLinearEquiv
      (hlin z), ?_, ?_, ?_⟩
  · intro v
    show Continuous (fun z => Gf z v)
    have hc : Continuous (fun z : Z.left => (show C(↥Z.left, Fin Ω₀.r' → ℚ_[ℓ]) from
        ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Z ≫ pr2)))).hom (xv v)).down) z) :=
      ContinuousMap.continuous _
    exact hc.congr (fun z => (K1 z v).symm)
  · intro σ g hσ τ e1 e2 z v
    show Gf (τ.left z) (g v) = Gf z v
    have A := hGf Z τ (xv v) z
    have inner : (show C(↥Z.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (τ ≫ pr1)))).hom (xv v)).down) z = g v :=
      (T1 _ _ e1 (xv v) z).trans ((hσ Z pr1 (xv v) z).trans (congrArg g
        ((T1 _ _ (Category.id_comp pr1).symm (xv v) z).trans (hxv v z))))
    have left : (show C(↥Z.left, Fin Ω₀.r' → ℚ_[ℓ]) from
        ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk (τ ≫ pr2)))).hom (xv v)).down) z = Gf z v :=
      (T0 _ _ (e2.trans (Category.id_comp pr2).symm) (xv v) z).trans (K1 z v).symm
    exact (congrArg (Gf (τ.left z)) inner.symm).trans (A.symm.trans left)
  · intro σ₀ g₀ hσ₀ τ e1 e2 z v
    show Gf (τ.left z) v = g₀ (Gf z v)
    have A := hGf Z τ (xv v) z
    have inner : (show C(↥Z.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (τ ≫ pr1)))).hom (xv v)).down) z = v :=
      (T1 _ _ (e1.trans (Category.id_comp pr1).symm) (xv v) z).trans (hxv v z)
    have left : (show C(↥Z.left, Fin Ω₀.r' → ℚ_[ℓ]) from
        ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk (τ ≫ pr2)))).hom (xv v)).down) z =
        g₀ (Gf z v) :=
      (T0 _ _ e2 (xv v) z).trans ((hσ₀ Z pr2 (xv v) z).trans (congrArg g₀
        ((T0 _ _ (Category.id_comp pr2).symm (xv v) z).trans (K1 z v).symm)))
    exact (congrArg (Gf (τ.left z)) inner.symm).trans (A.symm.trans left)

theorem wc_pfam_lfl_deck_frames_lattice (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP) :
    ∃ A : (Fin Ω.r' → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ]),
      ∀ (σ : Ω.W' ⟶ Ω.W') (g : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
        σ ≫ Ω.w' = Ω.w' → wcPfamFrame Ω σ g →
        ∀ x : Fin Ω.r' → ℚ_[ℓ], (∀ i, ‖x i‖ ≤ 1) → ∀ i, ‖A (g (A.symm x)) i‖ ≤ 1 :=
by
  classical
  haveI := Ω.hconn'

  have hext : ∀ (Ω₁ : wcPfamCover M' h Δ ℓ (n - 1) hPP) (σ : Ω₁.W' ⟶ Ω₁.W')
      (g : (Fin Ω₁.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₁.r' → ℚ_[ℓ])), wcPfamFrame Ω₁ σ g →
      ∀ (V : (wcProjK F'' M').ProEt) (a : V ⟶ Ω₁.W')
        (x : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op V)) (t : V.left),
        (show C(↥V.left, Fin Ω₁.r' → ℚ_[ℓ]) from
          ((Ω₁.θ'.hom.hom.app (Opposite.op (Over.mk (a ≫ σ)))).hom x).down) t =
        g ((show C(↥V.left, Fin Ω₁.r' → ℚ_[ℓ]) from
          ((Ω₁.θ'.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) t) := by
    intro Ω₁ σ g hfr V a x t
    obtain ⟨B, hB⟩ := wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ (n - 1)) Ω₁.W'
      Ω₁.hconn' Ω₁.r' Ω₁.θ' σ
    have hBg : B = g := by
      apply LinearMap.ext
      intro v
      obtain ⟨z₀⟩ := @ConnectedSpace.toNonempty _ _ Ω₁.hconn'
      let c : (wcContSheaf (wcProjK F'' M') (Fin Ω₁.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω₁.W') :=
        (show (wcContSheaf (wcProjK F'' M') (Fin Ω₁.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω₁.W') from
          ULift.up (ContinuousMap.const ↥Ω₁.W'.left v))
      have hc : (show C(↥Ω₁.W'.left, Fin Ω₁.r' → ℚ_[ℓ]) from
          ((Ω₁.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω₁.W')))).hom
            ((Ω₁.θ'.inv.hom.app (Opposite.op (Over.mk (𝟙 Ω₁.W')))).hom c)).down) z₀ = v := by
        have hs := congrArg (fun m => (m.hom.app (Opposite.op (Over.mk (𝟙 Ω₁.W')))).hom c)
          Ω₁.θ'.inv_hom_id
        exact congrArg (fun y : ULift.{u+1} C(↥Ω₁.W'.left, Fin Ω₁.r' → ℚ_[ℓ]) => y.down z₀) hs
      have e1 := hB Ω₁.W' (𝟙 Ω₁.W') σ (Category.id_comp σ).symm
        ((Ω₁.θ'.inv.hom.app (Opposite.op (Over.mk (𝟙 Ω₁.W')))).hom c) z₀
      have e2 := hfr ((Ω₁.θ'.inv.hom.app (Opposite.op (Over.mk (𝟙 Ω₁.W')))).hom c) z₀
      exact (congrArg B hc.symm).trans (e1.symm.trans (e2.trans (congrArg g hc)))
    rw [← hBg]
    exact hB V a (a ≫ σ) rfl x t

  have hiso : ∀ (k : ℕ) (N : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])),
      (∀ j : Fin k, ‖N (Pi.single j 1) - Pi.single j 1‖ < 1) → ∀ y, ‖N y‖ = ‖y‖ := by
    intro k N hN y
    by_cases hy : y = 0
    · rw [hy, map_zero]
    have hpos : 0 < ‖y‖ := norm_pos_iff.mpr hy
    have hdec : N y - y = ∑ j, y j • (N (Pi.single j 1) - Pi.single j 1) := by
      have hy' : y = ∑ j, y j • (Pi.single j (1 : ℚ_[ℓ]) : Fin k → ℚ_[ℓ]) := by
        ext i; simp [Finset.sum_apply, Pi.single_apply]
      conv_lhs => rw [hy']
      rw [map_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_smul, smul_sub]
    have hlt : ‖N y - y‖ < ‖y‖ := by
      rw [hdec]
      obtain ⟨i₀, -⟩ := Function.ne_iff.mp hy
      have hne : (Finset.univ : Finset (Fin k)).Nonempty := ⟨i₀, Finset.mem_univ i₀⟩
      obtain ⟨j, -, hj⟩ := IsUltrametricDist.exists_norm_finsetSum_le_of_nonempty hne
        (fun j => y j • (N (Pi.single j 1) - Pi.single j 1))
      refine lt_of_le_of_lt hj ?_
      rw [norm_smul]
      by_cases hyj : y j = 0
      · rw [hyj, norm_zero, zero_mul]; exact hpos
      · calc ‖y j‖ * ‖N (Pi.single j 1) - Pi.single j 1‖ < ‖y j‖ * 1 :=
              mul_lt_mul_of_pos_left (hN j) (norm_pos_iff.mpr hyj)
          _ = ‖y j‖ := mul_one _
          _ ≤ ‖y‖ := norm_le_pi_norm y j
    have e : N y = y + (N y - y) := by abel
    rw [e, IsUltrametricDist.norm_add_eq_max_of_norm_ne_norm hlt.ne', max_eq_left hlt.le]

  obtain ⟨Ω₀, hcpt₀, hqc₀⟩ :=
    wc_pfam_cover_exists_qc F' F'' Y n D ℓ hℓ M' Xu h Δ lam p hH hPP (n - 1)

  set GG : Set ((Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ])) :=
    {g | ∃ σ₀ : Ω₀.W' ⟶ Ω₀.W', σ₀ ≫ Ω₀.w' = Ω₀.w' ∧ wcPfamFrame Ω₀ σ₀ g} with hGG
  have hid : LinearMap.id ∈ GG := ⟨𝟙 Ω₀.W', Category.id_comp _, fun s z => rfl⟩
  have hmul : ∀ g ∈ GG, ∀ g' ∈ GG, g' ∘ₗ g ∈ GG := by
    rintro g ⟨σ₁, hσ₁, hf₁⟩ g' ⟨σ₂, hσ₂, hf₂⟩
    refine ⟨σ₁ ≫ σ₂, by rw [Category.assoc, hσ₂, hσ₁], fun s z => ?_⟩
    exact (hext Ω₀ σ₂ g' hf₂ Ω₀.W' σ₁ s z).trans (congrArg g' (hf₁ s z))
  have hst : ∀ g ∈ GG, ∀ x ∈ (⊤ : Submodule ℚ_[ℓ] (Fin Ω₀.r' → ℚ_[ℓ])),
      g x ∈ (⊤ : Submodule ℚ_[ℓ] (Fin Ω₀.r' → ℚ_[ℓ])) ∧
      (x ∈ (⊥ : Submodule ℚ_[ℓ] (Fin Ω₀.r' → ℚ_[ℓ])) →
        g x ∈ (⊥ : Submodule ℚ_[ℓ] (Fin Ω₀.r' → ℚ_[ℓ]))) := by
    intro g _ x _
    refine ⟨Submodule.mem_top, fun hx => ?_⟩
    rw [Submodule.mem_bot] at hx ⊢
    rw [hx, map_zero]

  obtain ⟨C, hC⟩ := wc_proet_frames_bounded (wcProjK F'' M') ℓ (wcRq h ℓ (n - 1))
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP) Ω₀.W' Ω₀.w' hcpt₀
    (@ConnectedSpace.toNonempty _ _ Ω₀.hconn') hqc₀ Ω₀.r' Ω₀.θ'
  obtain ⟨q', π₀, hπinj, hπsurj, hπst⟩ := wc_padic_stable_lattice_coords ℓ Ω₀.r' ⊥ ⊤ bot_le GG
    hid hmul hst C (by rintro g ⟨σ₀, hσ₀, hf⟩ j; exact hC σ₀ g hσ₀ hf j)
  have hπbij : Function.Bijective π₀ := by
    refine ⟨(injective_iff_map_eq_zero π₀).2 (fun x hx => ?_), fun y => ?_⟩
    · exact (Submodule.mem_bot ℚ_[ℓ]).1 ((hπinj x Submodule.mem_top).1 hx)
    · obtain ⟨x, -, hx⟩ := hπsurj y
      exact ⟨x, hx⟩
  set πe := LinearEquiv.ofBijective π₀ hπbij with hπe

  obtain ⟨Z, pr1, pr2, -, hquot, hZne, hlift, hfib⟩ :=
    wc_pfam_cover_fibre_product M' h Δ ℓ (n - 1) hPP Ω Ω₀ hqc₀
  obtain ⟨M, hMc, hMΩ, hMΩ₀⟩ := wc_pfam_cover_compare Ω Ω₀ Z pr1 pr2

  obtain ⟨Lset, hLset⟩ : ∃ L : Z.left → Set (Fin Ω.r' → ℚ_[ℓ]),
      ∀ z, L z = {v | ∀ j, ‖π₀ (M z v) j‖ ≤ 1} := ⟨_, fun _ => rfl⟩
  have hmemL : ∀ z v, v ∈ Lset z ↔ ∀ j, ‖π₀ (M z v) j‖ ≤ 1 := fun z v => by
    simp only [hLset, Set.mem_setOf_eq]

  have hfibL : ∀ z z'' : Z.left, pr1.left z = pr1.left z'' → Lset z ⊆ Lset z'' := by
    intro z z'' hzz v hv
    obtain ⟨σ₀, τ, hσ₀, hτ1, hτ2, hτz⟩ := hfib z z'' hzz
    obtain ⟨g₀, hg₀⟩ := wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ (n - 1)) Ω₀.W'
      Ω₀.hconn' Ω₀.r' Ω₀.θ' σ₀
    have hfr₀ : wcPfamFrame Ω₀ σ₀ g₀ := fun s z =>
      hg₀ Ω₀.W' (𝟙 Ω₀.W') σ₀ (Category.id_comp σ₀).symm s z
    have hmem : g₀ ∈ GG := ⟨σ₀, hσ₀, hfr₀⟩
    have e := hMΩ₀ σ₀ g₀ (hext Ω₀ σ₀ g₀ hfr₀) τ hτ1 hτ2 z v
    rw [hτz] at e
    rw [hmemL, e]
    exact hπst g₀ hmem (M z v) Submodule.mem_top ((hmemL z v).1 hv)
  have hfibE : ∀ z z'' : Z.left, pr1.left z = pr1.left z'' → Lset z = Lset z'' :=
    fun z z'' hzz => Set.Subset.antisymm (hfibL z z'' hzz) (hfibL z'' z hzz.symm)

  have hloc : IsLocallyConstant Lset := by
    rw [IsLocallyConstant.iff_eventually_eq]
    intro z₁
    set K₁ : (Fin Ω.r' → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ]) := (M z₁).trans πe with hK₁
    have hK₁app : ∀ v, K₁ v = π₀ (M z₁ v) := fun v => rfl
    have hcont : ∀ j : Fin q', Continuous
        (fun z => π₀ (M z (K₁.symm (Pi.single j 1))) - Pi.single j 1) :=
      fun j => ((LinearMap.continuous_of_finiteDimensional π₀).comp (hMc _)).sub continuous_const
    have hev : ∀ᶠ z in nhds z₁, ∀ j : Fin q',
        ‖π₀ (M z (K₁.symm (Pi.single j 1))) - Pi.single j 1‖ < 1 := by
      rw [Filter.eventually_all]
      intro j
      refine (hcont j).norm.continuousAt.eventually_lt continuousAt_const ?_
      have h1 : π₀ (M z₁ (K₁.symm (Pi.single j 1))) = Pi.single j 1 := by
        rw [← hK₁app]; exact K₁.apply_symm_apply _
      show ‖π₀ (M z₁ (K₁.symm (Pi.single j 1))) - Pi.single j 1‖ < 1
      rw [h1, sub_self, norm_zero]
      exact one_pos
    filter_upwards [hev] with z hz
    let N : (Fin q' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ]) :=
      π₀ ∘ₗ (M z).toLinearMap ∘ₗ K₁.symm.toLinearMap
    have hN : ∀ y, ‖N y‖ = ‖y‖ := hiso q' N (fun j => hz j)
    ext v
    have hNv : N (K₁ v) = π₀ (M z v) := by
      show π₀ (M z (K₁.symm (K₁ v))) = π₀ (M z v)
      rw [K₁.symm_apply_apply]
    rw [hmemL, hmemL, ← pi_norm_le_iff_of_nonneg zero_le_one,
      ← pi_norm_le_iff_of_nonneg zero_le_one, ← hNv, hN, hK₁app]

  obtain ⟨z₀⟩ := hZne
  have hconst : ∀ z, Lset z = Lset z₀ := by
    set fb : Ω.W'.left → Set (Fin Ω.r' → ℚ_[ℓ]) := Lset ∘ Function.surjInv hquot.surjective
      with hfb
    have hfb' : ∀ x, fb (pr1.left x) = Lset x := fun x =>
      hfibE _ _ (Function.surjInv_eq hquot.surjective (pr1.left x))
    have hlc : IsLocallyConstant fb := by
      rw [IsLocallyConstant.iff_isOpen_fiber]
      intro b
      rw [← hquot.isOpen_preimage]
      have hpre : ⇑pr1.left ⁻¹' (fb ⁻¹' {b}) = Lset ⁻¹' {b} := by
        ext x
        simp only [Set.mem_preimage, Set.mem_singleton_iff, hfb']
      rw [hpre]
      exact hloc.isOpen_fiber b
    intro z
    rw [← hfb' z, ← hfb' z₀]
    exact hlc.apply_eq_of_preconnectedSpace _ _

  have hrq : Ω.r' = q' := by
    have := ((M z₀).trans πe).finrank_eq
    simpa using this
  set K := (M z₀).trans πe with hKdef
  have hKapp : ∀ v, K v = π₀ (M z₀ v) := fun v => rfl
  refine ⟨K.trans (LinearEquiv.funCongrLeft ℚ_[ℓ] ℚ_[ℓ] (finCongr hrq)), ?_⟩
  intro σ g hσ hfr x hx i
  obtain ⟨τ, hτ1, hτ2⟩ := hlift σ hσ
  set A := K.trans (LinearEquiv.funCongrLeft ℚ_[ℓ] ℚ_[ℓ] (finCongr hrq)) with hA
  have hAapp : ∀ y j, A y j = K y (finCongr hrq j) := by
    intro y j
    rw [hA, LinearEquiv.trans_apply, LinearEquiv.funCongrLeft_apply]
    rfl
  set y := A.symm x with hy
  have hAy : A y = x := A.apply_symm_apply x
  have hKy : ∀ j, ‖π₀ (M z₀ y) j‖ ≤ 1 := by
    intro j
    have h1 := hx ((finCongr hrq).symm j)
    rw [← hAy, hAapp, Equiv.apply_symm_apply, hKapp] at h1
    exact h1

  have hgy : g y ∈ Lset z₀ := by
    rw [← hconst (τ.left z₀), hmemL, hMΩ σ g (hext Ω σ g hfr) τ hτ1 hτ2 z₀ y]
    exact hKy
  have hfin := (hmemL z₀ (g y)).1 hgy (finCongr hrq i)
  rw [hAapp, hKapp]
  exact hfin

theorem wc_pfam_xwt_scalar_laws {X B : Scheme.{u}} (g : X ⟶ B) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ) :
    (∀ (V : B.ProEt) (x : (wcRq g ℓ q).obj.obj (Opposite.op V)),
      ((wcRqScalar g ℓ q 1).hom.app (Opposite.op V)).hom x = x) ∧
    (∀ (V : B.ProEt) (a b : ℚ_[ℓ]) (x : (wcRq g ℓ q).obj.obj (Opposite.op V)),
      ((wcRqScalar g ℓ q (a * b)).hom.app (Opposite.op V)).hom x =
        ((wcRqScalar g ℓ q a).hom.app (Opposite.op V)).hom
          (((wcRqScalar g ℓ q b).hom.app (Opposite.op V)).hom x)) ∧
    (∀ (V : B.ProEt) (a b : ℚ_[ℓ]) (x : (wcRq g ℓ q).obj.obj (Opposite.op V)),
      ((wcRqScalar g ℓ q (a + b)).hom.app (Opposite.op V)).hom x =
        ((wcRqScalar g ℓ q a).hom.app (Opposite.op V)).hom x +
        ((wcRqScalar g ℓ q b).hom.app (Opposite.op V)).hom x) ∧
    (∀ (V V' : B.ProEt) (f : V' ⟶ V) (a : ℚ_[ℓ]) (x : (wcRq g ℓ q).obj.obj (Opposite.op V)),
      ((wcRq g ℓ q).obj.map f.op).hom (((wcRqScalar g ℓ q a).hom.app (Opposite.op V)).hom x) =
        ((wcRqScalar g ℓ q a).hom.app (Opposite.op V')).hom (((wcRq g ℓ q).obj.map f.op).hom x)) :=
by
  have key : ∀ (c : ℚ_[ℓ]) (U : (X.ProEt)ᵒᵖ) (x : ((wcLadicSheaf X ℓ).obj.obj U : Type (u+1))),
      (wcLadicScalar X ℓ c).hom.app U x =
        (ULift.up (c • (ULift.down x : C(↥((Scheme.ProEt.forget X ⋙ Over.forget X).obj
          (Opposite.unop U)), ℚ_[ℓ]))) : _) := by
    intro c U x
    rfl
  have h1 : wcLadicScalar X ℓ 1 = 𝟙 _ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [key]
    apply ULift.ext
    exact one_smul _ _
  have h2 : ∀ a b : ℚ_[ℓ], wcLadicScalar X ℓ (a * b) = wcLadicScalar X ℓ b ≫ wcLadicScalar X ℓ a := by
    intro a b
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply,
      key, key, key]
    apply ULift.ext
    exact mul_smul _ _ _
  have h3 : ∀ a b : ℚ_[ℓ], wcLadicScalar X ℓ (a + b) = wcLadicScalar X ℓ a + wcLadicScalar X ℓ b := by
    intro a b
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, key, key, key]
    apply ULift.ext
    exact add_smul _ _ _
  have wc_rightDerived_map_add : ∀ (f f' : wcLadicSheaf X ℓ ⟶ wcLadicSheaf X ℓ),
      ((wcProEtPush g).rightDerived q).map (f + f') =
        ((wcProEtPush g).rightDerived q).map f + ((wcProEtPush g).rightDerived q).map f' := by
    intro f f'
    let I : InjectiveResolution (wcLadicSheaf X ℓ) := injectiveResolution (wcLadicSheaf X ℓ)
    let φ := InjectiveResolution.desc f I I
    let ψ := InjectiveResolution.desc f' I I
    have hf : I.ι ≫ φ = (CochainComplex.single₀ _).map f ≫ I.ι :=
      InjectiveResolution.desc_commutes f I I
    have hg : I.ι ≫ ψ = (CochainComplex.single₀ _).map f' ≫ I.ι :=
      InjectiveResolution.desc_commutes f' I I
    have hfg : I.ι ≫ (φ + ψ) = (CochainComplex.single₀ _).map (f + f') ≫ I.ι := by
      rw [Preadditive.comp_add, hf, hg, CategoryTheory.Functor.map_add, Preadditive.add_comp]
    rw [(wcProEtPush g).rightDerived_map_eq q (f + f') (P := I) (Q := I) (φ + ψ) hfg,
      (wcProEtPush g).rightDerived_map_eq q f (P := I) (Q := I) φ hf,
      (wcProEtPush g).rightDerived_map_eq q f' (P := I) (Q := I) ψ hg,
      CategoryTheory.Functor.map_add, Preadditive.add_comp, Preadditive.comp_add]
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro V x
    show ((((wcProEtPush g).rightDerived q).map (wcLadicScalar X ℓ 1)).hom.app
      (Opposite.op V)).hom x = x
    rw [h1, CategoryTheory.Functor.map_id]
    rfl
  · intro V a b x
    show ((((wcProEtPush g).rightDerived q).map (wcLadicScalar X ℓ (a * b))).hom.app
      (Opposite.op V)).hom x = _
    rw [h2 a b, CategoryTheory.Functor.map_comp]
    rfl
  · intro V a b x
    show ((((wcProEtPush g).rightDerived q).map (wcLadicScalar X ℓ (a + b))).hom.app
      (Opposite.op V)).hom x = _
    rw [h3 a b, wc_rightDerived_map_add, Sheaf.Hom.add_app]
    rfl
  · intro V V' f a x
    exact (CategoryTheory.NatTrans.naturality_apply (wcRqScalar g ℓ q a).hom f.op x).symm

theorem wc_pfam_mc_dim_count : ∀ (K : Type u) [Field K] {Yt Xu C P : Scheme.{u}} (sX : Xu ⟶ Spec (.of K)) (sP : P ⟶ Spec (.of K)) (sC : C ⟶ Spec (.of K)) (sY : Yt ⟶ Spec (.of K)) (d m c n : ℕ), SmoothOfRelativeDimension d sX → SmoothOfRelativeDimension m sP → SmoothOfRelativeDimension c sC → SmoothOfRelativeDimension n sY → ∀ (p : Yt ⟶ Xu) (f : Yt ⟶ C) (h : Xu ⟶ P) (lam : C ⟶ P), IsPullback p f h lam → h ≫ sP = sX → lam ≫ sP = sC → f ≫ sC = sY → ∀ ξ : Yt, (∃ V : Xu.Opens, p ξ ∈ V ∧ Smooth (V.ι ≫ h)) → d + c = n + m :=
by
  intro K _ Yt Xu C P sX sP sC sY d m c n hsX hsP hsC hsY p f h lam hpb hhP _hlP hfC ξ hV

  have c_ring : ∀ (R S : Type u) [CommRing R] [CommRing S] [Nontrivial S] (φ : R →+* S)
      (a b : ℕ), RingHom.IsStandardSmoothOfRelativeDimension a φ →
      RingHom.Locally (fun {R S : Type u} [CommRing R] [CommRing S] =>
        RingHom.IsStandardSmoothOfRelativeDimension b) φ → a = b := by
    intro R S _ _ _ φ a b ha hb
    obtain ⟨s, hs, hQ⟩ := hb
    have hex : ∃ t ∈ s, Nontrivial (Localization.Away t) := by
      by_contra hcon
      have hsub : s ⊆ (nilradical S : Set S) := by
        intro t ht
        have h1 : Subsingleton (Localization.Away t) :=
          not_nontrivial_iff_subsingleton.mp (fun hn => hcon ⟨t, ht, hn⟩)
        have h0 : (0 : S) ∈ Submonoid.powers t :=
          (IsLocalization.subsingleton_iff (M := Submonoid.powers t)
            (S := Localization.Away t)).mp h1
        obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp h0
        exact mem_nilradical.mpr ⟨k, hk⟩
      have h2 : nilradical S = ⊤ := by
        rw [eq_top_iff, ← hs]; exact Ideal.span_le.mpr hsub
      obtain ⟨M, hM⟩ := Ideal.exists_maximal S
      have h3 := nilradical_le_prime M (H := hM.isPrime)
      rw [h2, top_le_iff] at h3
      exact hM.ne_top h3
    obtain ⟨t, ht, hnt⟩ := hex
    have h1 : RingHom.IsStandardSmoothOfRelativeDimension (0 + a)
        ((algebraMap S (Localization.Away t)).comp φ) :=
      RingHom.IsStandardSmoothOfRelativeDimension.comp
        (RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway t) ha
    have h2 := hQ t ht
    letI := ((algebraMap S (Localization.Away t)).comp φ).toAlgebra
    haveI i1 : Algebra.IsStandardSmoothOfRelativeDimension (0 + a) R (Localization.Away t) := h1
    haveI i2 : Algebra.IsStandardSmoothOfRelativeDimension b R (Localization.Away t) := h2
    have r1 := Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential
      (R := R) (S := Localization.Away t) (0 + a)
    have r2 := Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential
      (R := R) (S := Localization.Away t) b
    rw [r1] at r2
    have := Nat.cast_inj.mp r2
    omega

  have s_uniq : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) (a b : ℕ), SmoothOfRelativeDimension a g →
      SmoothOfRelativeDimension b g → ∀ x : X, a = b := by
    intro X Y g a b ha hb x
    obtain ⟨U, hU, V, hV, hxV, eUV, hQa⟩ :=
      SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (f := g) (n := a) x
    have hQb := HasRingHomProperty.appLE (@SmoothOfRelativeDimension b) g hb ⟨U, hU⟩ ⟨V, hV⟩ eUV
    haveI : Nonempty V := ⟨⟨x, hxV⟩⟩
    haveI := Scheme.component_nontrivial X V
    exact c_ring _ _ _ a b hQa hQb

  have chart : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y), Smooth g → ∀ x : X,
      ∃ (Z : Scheme.{u}) (k : Z ⟶ X) (_ : IsOpenImmersion k) (z : Z) (e : ℕ),
        k z = x ∧ SmoothOfRelativeDimension e (k ≫ g) := by
    intro X Y g hg x
    obtain ⟨U, hU, V, hV, hxV, eUV, hstd⟩ := Smooth.exists_isStandardSmooth g x
    letI := (g.appLE U V eUV).hom.toAlgebra
    obtain ⟨ι, σ, _, _, ⟨Pr⟩⟩ := (hstd : Algebra.IsStandardSmooth Γ(Y, U) Γ(X, V)).out
    have hrel : RingHom.IsStandardSmoothOfRelativeDimension Pr.dimension (g.appLE U V eUV).hom :=
      Pr.isStandardSmoothOfRelativeDimension rfl
    have hspec : SmoothOfRelativeDimension Pr.dimension (Spec.map (g.appLE U V eUV)) := by
      rw [HasRingHomProperty.Spec_iff (P := @SmoothOfRelativeDimension Pr.dimension)]
      exact RingHom.locally_of RingHom.isStandardSmoothOfRelativeDimension_respectsIso _ hrel
    haveI := hspec
    have hc := smoothOfRelativeDimension_comp Pr.dimension 0 (Spec.map (g.appLE U V eUV))
      hU.fromSpec
    rw [IsAffineOpen.SpecMap_appLE_fromSpec g hU hV eUV] at hc
    have hxr : x ∈ Set.range hV.fromSpec := by rw [hV.range_fromSpec]; exact hxV
    obtain ⟨z, hz⟩ := hxr
    exact ⟨_, hV.fromSpec, inferInstance, z, Pr.dimension + 0, hz, hc⟩

  obtain ⟨V₀, hx, hsm⟩ := hV
  obtain ⟨Z, k₀, hk₀, z, e, hz, hke⟩ := chart (V₀.ι ≫ h) hsm ⟨p ξ, hx⟩
  obtain ⟨k, hk, hkz, hkh⟩ : ∃ k : Z ⟶ Xu, IsOpenImmersion k ∧ k z = p ξ ∧
      SmoothOfRelativeDimension e (k ≫ h) := by
    haveI := hk₀
    refine ⟨k₀ ≫ V₀.ι, inferInstance, ?_, ?_⟩
    · show V₀.ι (k₀ z) = p ξ
      rw [hz]
      rfl
    · rw [Category.assoc]; exact hke
  haveI := hk

  have e1 : e + m = 0 + d := by
    haveI := hkh; haveI := hsP; haveI := hsX
    have A := smoothOfRelativeDimension_comp e m (k ≫ h) sP
    have B := smoothOfRelativeDimension_comp 0 d k sX
    rw [Category.assoc, hhP] at A
    exact s_uniq _ _ _ A B z

  have e2 : e + c = 0 + n := by
    have hpb2 := IsPullback.paste_vert (IsPullback.of_hasPullback k p) hpb
    have hbc : SmoothOfRelativeDimension e (Limits.pullback.snd k p ≫ f) :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension e) hpb2 hkh
    haveI := hbc; haveI := hsC; haveI := hsY
    have A := smoothOfRelativeDimension_comp e c (Limits.pullback.snd k p ≫ f) sC
    have B := smoothOfRelativeDimension_comp 0 n (Limits.pullback.snd k p) sY
    rw [Category.assoc, hfC] at A
    obtain ⟨q, _, _⟩ := Scheme.Pullback.exists_preimage_pullback (f := k) (g := p) z ξ hkz
    exact s_uniq _ _ _ A B q
  omega

theorem wc_pfam_mc_source_chart : ∀ (K : Type u) [Field K] {X P : Scheme.{u}} (hX : X ⟶ Spec (.of K)) (hP : P ⟶ Spec (.of K)) (d : ℕ) [SmoothOfRelativeDimension d hX] (h : X ⟶ P), h ≫ hP = hX → ∀ (W : P.Opens) (hW : IsAffineOpen W) (s : Spec (.of K) ⟶ X), s ≫ hX = 𝟙 _ → ∀ (hxW : s (IsLocalRing.closedPoint K) ∈ h ⁻¹ᵁ W), ∃ (V : X.Opens) (hV : IsAffineOpen V) (hx : s (IsLocalRing.closedPoint K) ∈ V) (e : Γ(X, V) →+* K) (ρ : Γ(P, W) →+* Γ(X, V)), V ≤ h ⁻¹ᵁ W ∧ IsClosed ({s (IsLocalRing.closedPoint K)} : Set X) ∧ IsNoetherianRing Γ(X, V) ∧ RingHom.IsStandardSmoothOfRelativeDimension d ((hX.appLE ⊤ V le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) ∧ Spec.map (CommRingCat.ofHom e) ≫ hV.fromSpec = s ∧ e.comp ((hX.appLE ⊤ V le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) = RingHom.id K ∧ RingHom.ker e = (hV.primeIdealOf ⟨_, hx⟩).asIdeal ∧ Spec.map (CommRingCat.ofHom ρ) ≫ hW.fromSpec = hV.fromSpec ≫ h ∧ ρ.comp ((hP.appLE ⊤ W le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) = (hX.appLE ⊤ V le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom ∧ ∀ r : Γ(P, W), (X.presheaf.germ V _ hx).hom (ρ r) = (X.presheaf.germ (h ⁻¹ᵁ W) _ hxW).hom ((h.app W).hom r) :=
by

  have ringHom_eq_of_spec : ∀ {R S : Type u} [CommRing R] [CommRing S] (f g : R →+* S),
      Spec.map (CommRingCat.ofHom f) = Spec.map (CommRingCat.ofHom g) → f = g := by
    intro R S _ _ f g h
    have := congrArg CommRingCat.Hom.hom (Spec.map_injective h)
    simpa using this
  have specK_kappa : ∀ (K : Type u) [Field K] {X : Scheme.{u}} (h : X ⟶ Spec (.of K)) (W : X.Opens)
      (hW : IsAffineOpen W), Spec.map (CommRingCat.ofHom ((h.appLE ⊤ W le_top).hom.comp
        (Scheme.ΓSpecIso (.of K)).inv.hom)) = hW.fromSpec ≫ h := by
    intro K _ X h W hW
    rw [CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom, CommRingCat.ofHom_hom,
      ← Scheme.isoSpec_Spec_inv, ← IsAffineOpen.fromSpec_top]
    exact IsAffineOpen.SpecMap_appLE_fromSpec h (isAffineOpen_top (Spec (.of K))) hW le_top

  have c1 : ∀ (K : Type u) [Field K] {X : Scheme.{u}} (h : X ⟶ Spec (.of K)) (n : ℕ) [SmoothOfRelativeDimension n h] (x : X) (O : X.Opens), x ∈ O → ∃ (W : X.Opens) (_ : IsAffineOpen W), x ∈ W ∧ W ≤ O ∧ IsNoetherianRing Γ(X, W) ∧ RingHom.IsStandardSmoothOfRelativeDimension n ((h.appLE ⊤ W le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) := by
    intro K _ X h n _ x O hxO
    obtain ⟨U, hU, V, hV, hxV, e, hstd⟩ :=
      SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := n) (f := h) x
    have hUtop : U = ⊤ := by
      rw [eq_top_iff]
      intro y _
      have : h x ∈ U := e hxV
      rwa [Subsingleton.elim y (h x)]
    subst hUtop
    obtain ⟨f, hfle, hxf⟩ := hV.exists_basicOpen_le (V := V ⊓ O) ⟨x, ⟨hxV, hxO⟩⟩ hxV
    have hfV : X.basicOpen f ≤ V := X.basicOpen_le f
    refine ⟨X.basicOpen f, hV.basicOpen f, hxf, hfle.trans inf_le_right, ?_⟩
    have hiso : RingHom.IsStandardSmoothOfRelativeDimension 0 (Scheme.ΓSpecIso (.of K)).inv.hom := by
      letI : Algebra K Γ(Spec (.of K), ⊤) := (Scheme.ΓSpecIso (.of K)).inv.hom.toAlgebra
      haveI : IsLocalization.Away (1 : K) Γ(Spec (.of K), ⊤) :=
        IsLocalization.away_of_isUnit_of_bijective _ isUnit_one
          (Scheme.ΓSpecIso (.of K)).symm.commRingCatIsoToRingEquiv.bijective
      exact RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway (1 : K)
    have hloc : RingHom.IsStandardSmoothOfRelativeDimension 0
        (X.presheaf.map (homOfLE hfV).op).hom := by
      haveI := hV.isLocalization_basicOpen f
      exact RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway f
    have hSm : RingHom.IsStandardSmoothOfRelativeDimension n
        ((h.appLE ⊤ (X.basicOpen f) le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) := by
      rw [← Scheme.Hom.appLE_map h e (homOfLE hfV).op, CommRingCat.hom_comp, RingHom.comp_assoc]
      have := hloc.comp (hstd.comp hiso)
      simpa using this
    refine ⟨?_, hSm⟩
    letI : Algebra K Γ(X, X.basicOpen f) :=
      ((h.appLE ⊤ (X.basicOpen f) le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom).toAlgebra
    haveI : Algebra.IsStandardSmoothOfRelativeDimension n K Γ(X, X.basicOpen f) := hSm.toAlgebra
    haveI : Algebra.IsStandardSmooth K Γ(X, X.basicOpen f) :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
    haveI : Algebra.FinitePresentation K Γ(X, X.basicOpen f) := inferInstance
    exact Algebra.FiniteType.isNoetherianRing K Γ(X, X.basicOpen f)

  have c2 : ∀ (K : Type u) [Field K] {X : Scheme.{u}} (h : X ⟶ Spec (.of K)) (s : Spec (.of K) ⟶ X), s ≫ h = 𝟙 _ → ∀ (W : X.Opens) (hW : IsAffineOpen W) (hx : s (IsLocalRing.closedPoint K) ∈ W), ∃ e : Γ(X, W) →+* K, Spec.map (CommRingCat.ofHom e) ≫ hW.fromSpec = s ∧ e.comp ((h.appLE ⊤ W le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) = RingHom.id K ∧ RingHom.ker e = (hW.primeIdealOf ⟨s (IsLocalRing.closedPoint K), hx⟩).asIdeal := by
    intro K _ X h s hs W hW hx
    have hr : Set.range s ⊆ Set.range hW.fromSpec := by
      rintro _ ⟨y, rfl⟩
      rw [Subsingleton.elim y (IsLocalRing.closedPoint K), hW.range_fromSpec]
      exact hx
    set e := (Spec.preimage (IsOpenImmersion.lift hW.fromSpec s hr)).hom with he
    have he1 : Spec.map (CommRingCat.ofHom e) ≫ hW.fromSpec = s := by
      rw [he, CommRingCat.ofHom_hom, Spec.map_preimage, IsOpenImmersion.lift_fac]
    refine ⟨e, he1, ?_, ?_⟩
    · apply ringHom_eq_of_spec
      rw [CommRingCat.ofHom_comp, Spec.map_comp, specK_kappa K h W hW, ← Category.assoc, he1, hs,
        CommRingCat.ofHom_id, Spec.map_id]
    · have hpt : Spec.map (CommRingCat.ofHom e) (IsLocalRing.closedPoint K) =
          hW.primeIdealOf ⟨s (IsLocalRing.closedPoint K), hx⟩ := by
        apply hW.fromSpec.isOpenEmbedding.injective
        rw [hW.fromSpec_primeIdealOf]
        exact congrArg (fun g => g (IsLocalRing.closedPoint K)) he1
      rw [← hpt]
      ext r
      rw [RingHom.mem_ker]
      show e r = 0 ↔ e r ∈ IsLocalRing.maximalIdeal K
      rw [IsLocalRing.maximalIdeal_eq_bot, Ideal.mem_bot]
  intro K _ X P hX hP d _ h hh W hW s hs hxW
  obtain ⟨V, hV, hx, hVW, hNoeth, hSm⟩ :=
    c1 K hX d (s (IsLocalRing.closedPoint K)) (h ⁻¹ᵁ W) hxW
  obtain ⟨e, he1, he2, he3⟩ := c2 K hX s hs V hV hx

  have hclosed : IsClosed ({s (IsLocalRing.closedPoint K)} : Set X) := by
    rw [← closure_subset_iff_isClosed]
    intro y hy
    rw [← specializes_iff_mem_closure] at hy
    obtain ⟨U, hU, hyU, -⟩ :=
      exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) (by trivial)
    have hxU : s (IsLocalRing.closedPoint K) ∈ U := hy.mem_open U.isOpen hyU
    obtain ⟨eU, -, heU2, heU3⟩ := c2 K hX s hs U hU hxU
    have hsurj : Function.Surjective eU := fun k =>
      ⟨_, congrArg (fun g => g k) heU2⟩
    have hmax : (hU.primeIdealOf ⟨_, hxU⟩).asIdeal.IsMaximal := by
      rw [← heU3]
      exact RingHom.ker_isMaximal_of_surjective eU hsurj
    have hsp : hU.primeIdealOf ⟨_, hxU⟩ ⤳ hU.primeIdealOf ⟨y, hyU⟩ := by
      apply hU.fromSpec.isOpenEmbedding.isInducing.specializes_iff.mp
      have e1 := hU.fromSpec_primeIdealOf ⟨_, hxU⟩
      have e2 := hU.fromSpec_primeIdealOf ⟨y, hyU⟩
      convert hy using 1
      all_goals first | exact e1 | exact e2
    have hle := (PrimeSpectrum.le_iff_specializes _ _).mpr hsp
    have heq : hU.primeIdealOf ⟨_, hxU⟩ = hU.primeIdealOf ⟨y, hyU⟩ :=
      PrimeSpectrum.ext (hmax.eq_of_le (hU.primeIdealOf ⟨y, hyU⟩).isPrime.ne_top hle)
    have h2 := congrArg hU.fromSpec heq
    rw [hU.fromSpec_primeIdealOf, hU.fromSpec_primeIdealOf] at h2
    exact Set.mem_singleton_iff.mpr h2.symm

  refine ⟨V, hV, hx, e, (h.appLE W V hVW).hom, hVW, hclosed, hNoeth, hSm, he1, he2, he3,
    ?_, ?_, ?_⟩
  · rw [CommRingCat.ofHom_hom]
    exact IsAffineOpen.SpecMap_appLE_fromSpec h hW hV hVW
  · apply ringHom_eq_of_spec
    rw [CommRingCat.ofHom_comp, Spec.map_comp, specK_kappa K hP W hW, specK_kappa K hX V hV,
      CommRingCat.ofHom_hom, ← Category.assoc, IsAffineOpen.SpecMap_appLE_fromSpec h hW hV hVW,
      Category.assoc, hh]
  · intro r
    show (X.presheaf.germ V _ hx).hom ((X.presheaf.map (homOfLE hVW).op).hom ((h.app W).hom r)) = _
    exact X.presheaf.germ_res_apply (homOfLE hVW) _ hx _

theorem wc_pfam_mc_kaehler_basis_of_gens : ∀ (K A : Type u) [Field K] [CommRing A] [IsLocalRing A] [Algebra K A] (ι : Type) [Fintype ι], Module.Free A Ω[A⁄K] → Module.Finite A Ω[A⁄K] → Module.finrank A Ω[A⁄K] = Fintype.card ι → ∀ (e : A →+* K), e.comp (algebraMap K A) = RingHom.id K → ∀ (a : ι → A), IsLocalRing.maximalIdeal A = Ideal.span (Set.range a) → ∃ b : Module.Basis ι A Ω[A⁄K], ∀ i, b i = KaehlerDifferential.D K A (a i) :=
by
  intro K A _ _ _ _ ι _ _ hfin hrank e he a hm
  classical
  have hsurj : Function.Surjective e := fun k => ⟨algebraMap K A k, by
    have h1 := RingHom.congr_fun he k
    simpa using h1⟩
  have hker : RingHom.ker e = IsLocalRing.maximalIdeal A := by
    haveI := RingHom.ker_isMaximal_of_surjective e hsurj
    exact IsLocalRing.eq_maximalIdeal this
  have hs2 : ∀ x : A, x - algebraMap K A (e x) ∈ IsLocalRing.maximalIdeal A := by
    intro x
    rw [← hker, RingHom.mem_ker, map_sub]
    have h1 := RingHom.congr_fun he (e x)
    simp only [RingHom.comp_apply, RingHom.id_apply] at h1
    rw [h1, sub_self]
  have ham : ∀ i, a i ∈ IsLocalRing.maximalIdeal A := fun i => by
    rw [hm]; exact Ideal.subset_span ⟨i, rfl⟩
  have hs3 : ∀ x : A, KaehlerDifferential.D K A x ∈
      Submodule.span A (Set.range fun i => KaehlerDifferential.D K A (a i)) ⊔
        IsLocalRing.maximalIdeal A • (⊤ : Submodule A Ω[A⁄K]) := by
    intro x
    have hmem := hs2 x
    rw [hm] at hmem
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun A).mp hmem
    have hx : x = algebraMap K A (e x) + ∑ i, c i * a i := by
      simp only [smul_eq_mul] at hc
      rw [hc]; ring
    rw [hx, map_add, Derivation.map_algebraMap, zero_add, map_sum]
    refine Submodule.sum_mem _ (fun i _ => ?_)
    rw [Derivation.leibniz]
    refine Submodule.add_mem _ ?_ ?_
    · exact Submodule.mem_sup_left (Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))
    · exact Submodule.mem_sup_right (Submodule.smul_mem_smul (ham i) Submodule.mem_top)
  have hs4 : (⊤ : Submodule A Ω[A⁄K]) ≤
      Submodule.span A (Set.range fun i => KaehlerDifferential.D K A (a i)) ⊔
        IsLocalRing.maximalIdeal A • (⊤ : Submodule A Ω[A⁄K]) := by
    intro y _
    have hy : y ∈ Submodule.span A (Set.range (KaehlerDifferential.D K A)) := by
      rw [KaehlerDifferential.span_range_derivation]; trivial
    refine Submodule.span_le.mpr ?_ hy
    rintro _ ⟨x, rfl⟩
    exact hs3 x
  have hs5 : (⊤ : Submodule A Ω[A⁄K]) ≤
      Submodule.span A (Set.range fun i => KaehlerDifferential.D K A (a i)) :=
    Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top
      (IsLocalRing.maximalIdeal_le_jacobson ⊥) hs4
  refine ⟨basisOfTopLeSpanOfCardEqFinrank (fun i => KaehlerDifferential.D K A (a i)) hs5
    hrank.symm, fun i => ?_⟩
  rw [coe_basisOfTopLeSpanOfCardEqFinrank]

theorem wc_pfam_mc_loc_kaehler_free : ∀ (K R : Type u) [Field K] [CommRing R] [Algebra K R] (d : ℕ), RingHom.IsStandardSmoothOfRelativeDimension d (algebraMap K R) → ∀ (q : Ideal R) [q.IsPrime], Module.Free (Localization.AtPrime q) Ω[Localization.AtPrime q⁄K] ∧ Module.Finite (Localization.AtPrime q) Ω[Localization.AtPrime q⁄K] ∧ Module.finrank (Localization.AtPrime q) Ω[Localization.AtPrime q⁄K] = d :=
by
  intro K R _ _ _ d hd q _
  haveI hsm : Algebra.IsStandardSmoothOfRelativeDimension d K R :=
    (RingHom.isStandardSmoothOfRelativeDimension_algebraMap d).mp hd
  haveI : Nontrivial R :=
    nontrivial_of_ne 0 1 (Ideal.zero_ne_one_of_proper (Ideal.IsPrime.ne_top ‹q.IsPrime›))
  haveI : Algebra.IsStandardSmooth K R := Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth d
  haveI : Module.Free R Ω[R⁄K] := inferInstance
  have hrk : Module.rank R Ω[R⁄K] = d :=
    Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential d
  haveI : Module.Finite R Ω[R⁄K] := Module.finite_of_rank_eq_nat hrk
  have hfr : Module.finrank R Ω[R⁄K] = d := Module.finrank_eq_of_rank_eq hrk
  let f : Ω[R⁄K] →ₗ[R] Ω[Localization.AtPrime q⁄K] :=
    KaehlerDifferential.map K K R (Localization.AtPrime q)
  haveI : IsLocalizedModule q.primeCompl f :=
    KaehlerDifferential.isLocalizedModule_map K R (Localization.AtPrime q) q.primeCompl
  refine ⟨Module.free_of_isLocalizedModule (Rₛ := Localization.AtPrime q) q.primeCompl f,
    Module.Finite.of_isLocalizedModule q.primeCompl (Rₚ := Localization.AtPrime q) f, ?_⟩
  exact (Module.finrank_of_isLocalizedModule_of_free (Localization.AtPrime q) q.primeCompl f).trans hfr

theorem wc_pfam_mc_rational_stalk_regular : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (q : X ⟶ Spec (.of K)) (d : ℕ) [SmoothOfRelativeDimension d q] (s : Spec (.of K) ⟶ X), s ≫ q = 𝟙 _ → IsClosed ({s (IsLocalRing.closedPoint K)} : Set X) → IsRegularLocalRing (X.presheaf.stalk (s (IsLocalRing.closedPoint K))) ∧ ringKrullDim (X.presheaf.stalk (s (IsLocalRing.closedPoint K))) = (d : WithBot ℕ∞) :=
by
  intro K _ X q d _ s hσ hcl

  have hratAll : ∀ pt : Spec (.of K), ∀ y : X.presheaf.stalk (s pt), ∃ c : K,
      y - wcLdpConst K q (s pt) c ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (s pt)) := by
    intro pt y
    have key : ∀ c : K, (s.stalkMap pt).hom (wcLdpConst K q (s pt) c) =
        ((Spec (.of K)).presheaf.germ ⊤ pt trivial).hom
          ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c) := by
      intro c
      simp only [wcLdpConst, RingHom.comp_apply]
      have h0 := Scheme.Hom.germ_stalkMap_apply s ⊤ pt trivial
        (q.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c))
      have h1 : (s.appTop).hom (q.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c)) =
          (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom c := by
        rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Scheme.Hom.comp_appTop, hσ,
          Scheme.Hom.id_appTop, CommRingCat.hom_id, RingHom.id_apply]
      refine h0.trans ?_
      exact congrArg _ h1
    obtain ⟨U, hU, w, hw⟩ :=
      (Spec (.of K)).presheaf.exists_germ_eq ((s.stalkMap pt).hom y)
    have hUt : U = ⊤ := by
      ext x
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true, SetLike.mem_coe]
      exact Subsingleton.elim pt x ▸ hU
    subst hUt
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom w, ?_⟩
    have hinv : (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom
        ((Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom w) = w := by
      rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Iso.hom_inv_id, CommRingCat.hom_id,
        RingHom.id_apply]
    have hzero : (s.stalkMap pt).hom
        (y - wcLdpConst K q (s pt)
          ((Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom w)) = 0 := by
      rw [map_sub, key, hinv, ← hw]
      exact sub_self _
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have := hu.map (s.stalkMap pt).hom
    rw [hzero] at this
    exact not_isUnit_zero this

  have hreg : ∀ v : X, IsClosed ({v} : Set X) →
      (∀ y : X.presheaf.stalk v, ∃ c : K,
        y - wcLdpConst K q v c ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk v)) →
      IsRegularLocalRing (X.presheaf.stalk v) ∧
        ringKrullDim (X.presheaf.stalk v) = (d : WithBot ℕ∞) := by
    intro v hv hrat
    haveI := SmoothOfRelativeDimension.smooth d q
    haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian q
    have hdim := wc_lfi_smooth_stalk_dim K X q d v hv
    letI := (wcLdpConst K q v).toAlgebra
    obtain ⟨hfs, hfree, hfin, hrk, -⟩ := wc_ldp_il_stalk_of_smooth_field K q d v
    have hκ : Algebra.FormallySmooth K (IsLocalRing.ResidueField (X.presheaf.stalk v)) := by
      have hsurj : Function.Surjective
          (Algebra.ofId K (IsLocalRing.ResidueField (X.presheaf.stalk v))) := by
        intro x
        obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective x
        obtain ⟨c, hc⟩ := hrat y
        refine ⟨c, ?_⟩
        rw [Algebra.ofId_apply]
        show IsLocalRing.residue _ (wcLdpConst K q v c) = IsLocalRing.residue _ y
        rw [eq_comm, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
        exact hc
      exact Algebra.FormallySmooth.of_equiv
        (AlgEquiv.ofBijective (Algebra.ofId K _) ⟨RingHom.injective _, hsurj⟩)
    have hle := wcpa_embdim_le_rank_omega K (X.presheaf.stalk v) hfs hfree hfin hκ
    rw [hrk] at hle
    have hge := ringKrullDim_le_spanFinrank_maximalIdeal (X.presheaf.stalk v)
    rw [hdim] at hge
    have hge' : d ≤ Submodule.spanFinrank (IsLocalRing.maximalIdeal (X.presheaf.stalk v)) := by
      exact_mod_cast hge
    have heq : Submodule.spanFinrank (IsLocalRing.maximalIdeal (X.presheaf.stalk v)) = d :=
      le_antisymm hle hge'
    exact ⟨IsRegularLocalRing.mk (by rw [heq, hdim]), hdim⟩
  exact hreg _ hcl (hratAll _)

theorem wc_pfam_mc_curve_ideal : ∀ (A B : Type u) [CommRing A] [IsRegularLocalRing A] [CommRing B] [IsRegularLocalRing B] (r : ℕ), ringKrullDim A = ((r + 1 : ℕ) : WithBot ℕ∞) → ringKrullDim B = ((1 : ℕ) : WithBot ℕ∞) → ∀ (f : A →+* B), Function.Surjective f → ∀ φ : A, IsLocalRing.maximalIdeal B = Ideal.span {f φ} → ∃ z : Fin r → A, RingHom.ker f = Ideal.span (Set.range z) ∧ IsLocalRing.maximalIdeal A = Ideal.span (insert φ (Set.range z)) :=
by
  intro A B _ _ _ _ r hdimA hdimB f hf φ hφB
  haveI : IsLocalHom f := IsLocalHom.of_surjective f hf
  set mA := IsLocalRing.maximalIdeal A with hmA
  set mB := IsLocalRing.maximalIdeal B with hmB
  have hπmem : f φ ∈ mB := by rw [hφB]; exact Ideal.subset_span rfl

  have hnil : ∀ N : ℕ, f φ ^ N ≠ 0 := by
    intro N hN
    have hall : ∀ P : Ideal B, P.IsPrime → P.IsMaximal := by
      intro P hP
      have h1 : f φ ∈ P := hP.mem_of_pow_mem N (by rw [hN]; exact P.zero_mem)
      have h2 : mB ≤ P := by rw [hφB]; exact (Ideal.span_singleton_le_iff_mem P).mpr h1
      have h3 : P ≤ mB := IsLocalRing.le_maximalIdeal hP.ne_top
      have h4 : P = mB := le_antisymm h3 h2
      rw [h4]; exact IsLocalRing.maximalIdeal.isMaximal B
    haveI : Ring.KrullDimLE 0 B := Ring.KrullDimLE.mk₀ hall
    have h0 : ringKrullDim B = 0 := ringKrullDimZero_iff_ringKrullDim_eq_zero.mp this
    rw [hdimB] at h0
    norm_num at h0

  have hnzd : ∀ b : B, b * f φ = 0 → b = 0 := by
    intro b hb
    have hdiv : ∀ n : ℕ, ∃ c, b = c * f φ ^ n := by
      intro n
      induction n with
      | zero => exact ⟨b, by simp⟩
      | succ n ih =>
        obtain ⟨c, hc⟩ := ih
        by_cases hu : IsUnit c
        · exfalso
          apply hnil (n + 1)
          have h1 : c * f φ ^ (n + 1) = 0 := by rw [pow_succ, ← mul_assoc, ← hc, hb]
          exact (hu.mul_right_eq_zero).mp h1
        · have hcm : c ∈ mB := by
            by_contra h
            exact hu (IsLocalRing.notMem_maximalIdeal.mp h)
          rw [hφB, Ideal.mem_span_singleton'] at hcm
          obtain ⟨c', hc'⟩ := hcm
          exact ⟨c', by rw [hc, ← hc', pow_succ]; ring⟩
    have hmem : b ∈ ⨅ n : ℕ, mB ^ n := by
      rw [Ideal.mem_iInf]
      intro n
      obtain ⟨c, hc⟩ := hdiv n
      rw [hφB, Ideal.span_singleton_pow, hc]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
    rw [Ideal.iInf_pow_eq_bot_of_isLocalRing mB
      (IsLocalRing.maximalIdeal.isMaximal B).ne_top] at hmem
    exact (Ideal.mem_bot).mp hmem
  have hmap : ∀ x ∈ mA, f x ∈ mB := by
    intro x hx
    by_contra h
    exact (IsLocalRing.notMem_maximalIdeal.mpr
      (isUnit_of_map_unit f x (IsLocalRing.notMem_maximalIdeal.mp h))) hx
  have hφm : φ ∈ mA := by
    by_contra h
    have hu : IsUnit φ := IsLocalRing.notMem_maximalIdeal.mp h
    exact (IsLocalRing.notMem_maximalIdeal.mpr (hu.map f)) hπmem

  have hsq : φ ∉ mA ^ 2 := by
    intro h
    have h1 : f φ ∈ mB ^ 2 := by
      have hle : Ideal.map f mA ≤ mB := Ideal.map_le_iff_le_comap.mpr hmap
      have hle2 : Ideal.map f (mA ^ 2) ≤ mB ^ 2 := by
        rw [Ideal.map_pow, pow_two, pow_two]
        exact Ideal.mul_mono hle hle
      exact hle2 (Ideal.mem_map_of_mem f h)
    rw [hφB, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at h1
    obtain ⟨c, hc⟩ := h1
    have h2 : (1 - c * f φ) * f φ = 0 := by
      rw [sub_mul, one_mul, mul_assoc, ← pow_two, hc, sub_self]
    have h3 := hnzd _ h2
    have h4 : (1 : B) ∈ mB := by
      have h5 : (1 : B) = c * f φ := sub_eq_zero.mp h3
      rw [h5]; exact Ideal.mul_mem_left _ _ hπmem
    exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top ((Ideal.eq_top_iff_one _).mpr h4)

  have hfg : mA.FG := IsNoetherian.noetherian mA
  obtain ⟨s, hs_card, hs_span⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank hfg
  have hrank : Submodule.spanFinrank mA = r + 1 := by
    have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
    rw [hdimA] at h
    exact_mod_cast h
  rw [hrank] at hs_card
  have hsfin : s.Finite := Set.finite_of_encard_eq_coe hs_card
  have hcard : hsfin.toFinset.card = r + 1 := by
    have h := hsfin.encard_eq_coe_toFinset_card
    rw [hs_card] at h
    exact_mod_cast h.symm
  let e := Finset.equivFinOfCardEq hcard
  let g : Fin (r + 1) → A := fun i => ((e.symm i : hsfin.toFinset) : A)
  have hg_range : Set.range g = s := by
    ext a
    constructor
    · rintro ⟨i, rfl⟩
      exact hsfin.mem_toFinset.mp (e.symm i).2
    · intro ha
      refine ⟨e ⟨a, hsfin.mem_toFinset.mpr ha⟩, ?_⟩
      simp [g]
  have hg : mA = Ideal.span (Set.range g) := by rw [hg_range]; exact hs_span.symm

  have hφg : φ ∈ Ideal.span (Set.range g) := hg ▸ hφm
  obtain ⟨a, ha⟩ := Ideal.mem_span_range_iff_exists_fun.mp hφg
  have hgm : ∀ i, g i ∈ mA := fun i => by rw [hg]; exact Ideal.subset_span ⟨i, rfl⟩
  have hunit : ∃ j, IsUnit (a j) := by
    by_contra hcon
    push_neg at hcon
    apply hsq
    rw [← ha, pow_two]
    refine Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_mul ?_ (hgm i))
    by_contra h
    exact hcon i (IsLocalRing.notMem_maximalIdeal.mp h)
  obtain ⟨j, hj⟩ := hunit
  let y : Fin r → A := fun i => g (j.succAbove i)
  have hy : mA = Ideal.span (insert φ (Set.range y)) := by
    apply le_antisymm
    · rw [hg, Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      by_cases hk : k = j
      · rw [hk]
        have hsum : ∑ i, a i * g i = a j * g j + ∑ i, a (j.succAbove i) * g (j.succAbove i) :=
          Fin.sum_univ_succAbove _ j
        obtain ⟨u, hu⟩ := hj.exists_left_inv
        have hgj : g j = u * (φ - ∑ i, a (j.succAbove i) * g (j.succAbove i)) := by
          rw [← ha, hsum, add_sub_cancel_right, ← mul_assoc, hu, one_mul]
        rw [hgj]
        apply Ideal.mul_mem_left
        apply Ideal.sub_mem
        · exact Ideal.subset_span (Set.mem_insert _ _)
        · exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _
            (Ideal.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩)))
      · obtain ⟨i, hi⟩ := Fin.exists_succAbove_eq hk
        rw [← hi]
        exact Ideal.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩)
    · rw [Ideal.span_le]
      rintro _ (rfl | ⟨i, rfl⟩)
      · exact hφm
      · exact hgm _
  have hyB : ∀ i, f (y i) ∈ Ideal.span {f φ} := by
    intro i
    rw [← hφB]
    exact hmap _ (hgm _)

  have hβ : ∀ i, ∃ c : A, f (y i) = f c * f φ := by
    intro i
    obtain ⟨β, hβ⟩ := Ideal.mem_span_singleton'.mp (hyB i)
    obtain ⟨c, rfl⟩ := hf β
    exact ⟨c, hβ.symm⟩
  choose c hc using hβ
  let z : Fin r → A := fun i => y i - c i * φ
  have hz0 : ∀ i, f (z i) = 0 := fun i => by
    simp only [z, map_sub, map_mul, hc i, sub_self]
  have hzs : Ideal.span (insert φ (Set.range z)) = Ideal.span (insert φ (Set.range y)) := by
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ (rfl | ⟨i, rfl⟩)
      · exact Ideal.subset_span (Set.mem_insert _ _)
      · exact Ideal.sub_mem _ (Ideal.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩))
          (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _)))
    · rw [Ideal.span_le]
      rintro _ (rfl | ⟨i, rfl⟩)
      · exact Ideal.subset_span (Set.mem_insert _ _)
      · have hyz : y i = z i + c i * φ := by simp [z]
        rw [hyz]
        exact Ideal.add_mem _ (Ideal.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩))
          (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _)))
  have hmz : mA = Ideal.span (insert φ (Set.range z)) := hy.trans hzs.symm

  set J := Ideal.span (Set.range z) with hJdef
  have hJ : J ≤ RingHom.ker f := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact hz0 i
  have hmJ : mA ≤ Ideal.span {φ} ⊔ J := by
    rw [hmz, Ideal.span_insert]
  have hkerm : RingHom.ker f ≤ mA := IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top f)
  have happrox : ∀ x ∈ RingHom.ker f, ∀ n : ℕ, ∃ a ∈ RingHom.ker f, x - a * φ ^ n ∈ J := by
    intro x hx n
    induction n with
    | zero => exact ⟨x, hx, by simp⟩
    | succ n ih =>
      obtain ⟨a, ha, haJ⟩ := ih
      obtain ⟨b, j', hj', hab⟩ := Ideal.mem_span_singleton_sup.mp (hmJ (hkerm ha))
      have hfb : f b = 0 := by
        apply hnzd
        have h1 : f a = 0 := ha
        have h2 : f j' = 0 := hJ hj'
        rw [← hab, map_add, map_mul, h2, add_zero] at h1
        exact h1
      refine ⟨b, hfb, ?_⟩
      have hx' : x - b * φ ^ (n + 1) = (x - a * φ ^ n) + j' * φ ^ n := by rw [← hab]; ring
      rw [hx']
      exact Ideal.add_mem _ haJ (Ideal.mul_mem_right _ _ hj')
  have hI : Ideal.span {φ} ≠ ⊤ := by
    intro h
    rw [Ideal.span_singleton_eq_top] at h
    exact (IsLocalRing.notMem_maximalIdeal.mpr h) hφm
  have krull : ∀ (J' : Ideal A) (x : A), (∀ n : ℕ, ∃ a : A, x - a * φ ^ n ∈ J') → x ∈ J' := by
    intro J' x hx
    have hK := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (M := A ⧸ J') (Ideal.span {φ}) hI
    have hmem : (Submodule.Quotient.mk (p := J') x) ∈
        ⨅ i, (Ideal.span {φ}) ^ i • (⊤ : Submodule A (A ⧸ J')) := by
      rw [Submodule.mem_iInf]
      intro n
      obtain ⟨a, haJ⟩ := hx n
      have e1 : Submodule.Quotient.mk (p := J') x =
          (a * φ ^ n) • Submodule.Quotient.mk (p := J') (1 : A) := by
        rw [← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one, Submodule.Quotient.eq]
        exact haJ
      have h1 : a * φ ^ n ∈ Ideal.span {φ} ^ n :=
        Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self φ) n)
      rw [e1]
      exact Submodule.smul_mem_smul h1 Submodule.mem_top
    rw [hK, Submodule.mem_bot] at hmem
    exact (Submodule.Quotient.mk_eq_zero J').mp hmem
  have hle : RingHom.ker f ≤ J := by
    intro x hx
    exact krull J x (fun n => by
      obtain ⟨a, _, haJ⟩ := happrox x hx n
      exact ⟨a, haJ⟩)
  exact ⟨z, le_antisymm hle hJ, hmz⟩

theorem wc_pfam_mc_base_chart : ∀ (K : Type u) [Field K] (P : Scheme.{u}) (sP : P ⟶ Spec (.of K)) (m r : ℕ) [SmoothOfRelativeDimension m sP], m = r + 1 → ∀ (σ : Spec (.of K) ⟶ P), σ ≫ sP = 𝟙 _ → ∀ (U : P.Opens) (hyU : σ (IsLocalRing.closedPoint K) ∈ U) (φ₀ : Γ(P, U)) (zt : Fin r → P.presheaf.stalk (σ (IsLocalRing.closedPoint K))), IsLocalRing.maximalIdeal (P.presheaf.stalk (σ (IsLocalRing.closedPoint K))) = Ideal.span (insert ((P.presheaf.germ U _ hyU).hom φ₀) (Set.range zt)) → ∃ (W : P.Opens) (hW : IsAffineOpen W) (hyW : σ (IsLocalRing.closedPoint K) ∈ W) (hWU : W ≤ U) (z : Fin r → Γ(P, W)), (∀ k, (P.presheaf.germ W _ hyW).hom (z k) = zt k) ∧ RingHom.Etale (MvPolynomial.eval₂Hom ((sP.appLE ⊤ W le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) (fun o : Option (Fin r) => o.elim ((P.presheaf.map (homOfLE hWU).op).hom φ₀) z)) :=
by
  intro K _ P sP m r _ hmr σ hσ U hyU φ₀ zt hgen

  have t_s1 : ∀ (X : Scheme.{u}) (x : X) (U : X.Opens) (hxU : x ∈ U) (r : ℕ) (zt : Fin r → X.presheaf.stalk x), ∃ (W₀ : X.Opens) (_ : IsAffineOpen W₀) (hxW₀ : x ∈ W₀) (_ : W₀ ≤ U) (s : Fin r → Γ(X, W₀)), ∀ k, (X.presheaf.germ W₀ x hxW₀).hom (s k) = zt k := by
    intro X x U hxU r
    induction r generalizing U with
    | zero =>
      intro zt
      obtain ⟨W₀, hW₀, hxW₀, hW₀U⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens) hxU
      exact ⟨W₀, hW₀, hxW₀, hW₀U, Fin.elim0, fun k => k.elim0⟩
    | succ r ih =>
      intro zt
      obtain ⟨W₁, hW₁, hxW₁, hW₁U, s₁, hs₁⟩ := ih U hxU (fun k => zt k.succ)
      obtain ⟨U₀, hxU₀, s₀, hs₀⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf (zt 0)
      have hx01 : x ∈ W₁ ⊓ U₀ := ⟨hxW₁, hxU₀⟩
      obtain ⟨W₀, hW₀, hxW₀, hW₀le⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens) hx01
      have h1 : W₀ ≤ W₁ := hW₀le.trans inf_le_left
      have h2 : W₀ ≤ U₀ := hW₀le.trans inf_le_right
      refine ⟨W₀, hW₀, hxW₀, h1.trans hW₁U,
        Fin.cons ((X.presheaf.map (homOfLE h2).op).hom s₀) (fun k => (X.presheaf.map (homOfLE h1).op).hom (s₁ k)), ?_⟩
      intro k
      refine Fin.cases ?_ ?_ k
      · rw [Fin.cons_zero]
        exact (TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE h2) x hxW₀ s₀).trans hs₀
      · intro k
        rw [Fin.cons_succ]
        exact (TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE h1) x hxW₀ (s₁ k)).trans (hs₁ k)

  have t_s3 : ∀ (X : Scheme.{u}) (V : X.Opens) (hV : IsAffineOpen V) (x : X) (hx : x ∈ V) (ι : Type) (a : ι → Γ(X, V)), IsLocalRing.maximalIdeal (X.presheaf.stalk x) = Ideal.span (Set.range (fun i => (X.presheaf.germ V x hx).hom (a i))) → (∀ i, a i ∈ (hV.primeIdealOf ⟨x, hx⟩).asIdeal) ∧ (∀ f ∈ (hV.primeIdealOf ⟨x, hx⟩).asIdeal, ∃ w : Γ(X, V), w ∉ (hV.primeIdealOf ⟨x, hx⟩).asIdeal ∧ w * f ∈ Ideal.span (Set.range a)) ∧ ∀ f : Γ(X, V), f ∉ (hV.primeIdealOf ⟨x, hx⟩).asIdeal → x ∈ X.basicOpen f := by
    intro X V hV x hx ι a hgen
    letI : Algebra Γ(X, V) (X.presheaf.stalk x) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf (U := V) ⟨x, hx⟩
    set q := (hV.primeIdealOf ⟨x, hx⟩).asIdeal with hq
    have hloc : IsLocalization.AtPrime (X.presheaf.stalk x) q := hV.isLocalization_stalk ⟨x, hx⟩
    have hgerm : ∀ f : Γ(X, V), algebraMap Γ(X, V) (X.presheaf.stalk x) f = (X.presheaf.germ V x hx).hom f := fun f => rfl
    refine ⟨?_, ?_, ?_⟩
    · intro i
      have h1 : (X.presheaf.germ V x hx).hom (a i) ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
        rw [hgen]; exact Ideal.subset_span ⟨i, rfl⟩
      rw [← hgerm] at h1
      exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (X.presheaf.stalk x) q (a i)).mp h1
    · intro f hf
      have h1 : algebraMap Γ(X, V) (X.presheaf.stalk x) f ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff (X.presheaf.stalk x) q f).mpr hf
      have hmap : IsLocalRing.maximalIdeal (X.presheaf.stalk x) =
          Ideal.map (algebraMap Γ(X, V) (X.presheaf.stalk x)) (Ideal.span (Set.range a)) := by
        rw [hgen, Ideal.map_span, ← Set.range_comp]
        rfl
      rw [hmap] at h1
      obtain ⟨⟨⟨x₁, hx₁⟩, ⟨t, ht⟩⟩, hxt⟩ := (IsLocalization.mem_map_algebraMap_iff q.primeCompl _).mp h1
      simp only at hxt
      rw [← map_mul] at hxt
      obtain ⟨⟨c, hc⟩, hc'⟩ := IsLocalization.exists_of_eq (M := q.primeCompl) hxt
      simp only at hc'
      refine ⟨c * t, ?_, ?_⟩
      · exact q.primeCompl.mul_mem hc ht
      · have : c * t * f = c * x₁ := by rw [← hc']; ring
        rw [this]
        exact Ideal.mul_mem_left _ _ hx₁
    · intro f hf
      rw [Scheme.mem_basicOpen X f x hx]
      rw [← hgerm]
      exact (IsLocalization.AtPrime.isUnit_to_map_iff (X.presheaf.stalk x) q f).mpr hf

  have t_s4 : ∀ (K A : Type u) [Field K] [CommRing A] [Algebra K A] (e : A →+* K), e.comp (algebraMap K A) = RingHom.id K → ∀ (q : Ideal A) [q.IsPrime], RingHom.ker e = q → ∀ (ι : Type) [Fintype ι] (a : ι → A), (∀ i, a i ∈ q) → (∀ x ∈ q, ∃ w : A, w ∉ q ∧ w * x ∈ Ideal.span (Set.range a)) → Submodule.span q.ResidueField (Set.range (fun i => (1 : q.ResidueField) ⊗ₜ[A] KaehlerDifferential.D K A (a i))) = ⊤ := by
    intro K A _ _ _ e he q _ hq ι _ a ha hw
    set N := Submodule.span q.ResidueField (Set.range (fun i => (1 : q.ResidueField) ⊗ₜ[A] KaehlerDifferential.D K A (a i))) with hN
    have hsm : ∀ (c : A) (ω : Ω[A⁄K]), (1 : q.ResidueField) ⊗ₜ[A] (c • ω) =
        algebraMap A q.ResidueField c • ((1 : q.ResidueField) ⊗ₜ[A] ω) := by
      intro c ω
      rw [← TensorProduct.smul_tmul, TensorProduct.smul_tmul', Algebra.smul_def, mul_one]
      simp only [smul_eq_mul, mul_one]
    have hD : ∀ x : A, (1 : q.ResidueField) ⊗ₜ[A] KaehlerDifferential.D K A x ∈ N := by
      intro x
      set x' := x - algebraMap K A (e x) with hx'def
      have hx' : x' ∈ q := by
        rw [← hq, RingHom.mem_ker, hx'def, map_sub]
        have : e (algebraMap K A (e x)) = e x := by
          rw [← RingHom.comp_apply, he, RingHom.id_apply]
        rw [this, sub_self]
      have hDx : KaehlerDifferential.D K A x' = KaehlerDifferential.D K A x := by
        rw [hx'def, map_sub, Derivation.map_algebraMap, sub_zero]
      obtain ⟨w, hwq, hwx⟩ := hw x' hx'
      obtain ⟨b, hb⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hwx
      have hL := congrArg (KaehlerDifferential.D K A) hb
      rw [map_sum, Derivation.leibniz] at hL
      simp only [Derivation.leibniz] at hL
      have hT := congrArg (fun ω => (1 : q.ResidueField) ⊗ₜ[A] ω) hL
      simp only [TensorProduct.tmul_add, TensorProduct.tmul_sum, hsm] at hT
      have ha0 : ∀ i, algebraMap A q.ResidueField (a i) = 0 := fun i =>
        (Ideal.algebraMap_residueField_eq_zero).mpr (ha i)
      have hx0 : algebraMap A q.ResidueField x' = 0 := (Ideal.algebraMap_residueField_eq_zero).mpr hx'
      simp only [ha0, hx0, zero_smul, add_zero] at hT
      have hmem : algebraMap A q.ResidueField w • ((1 : q.ResidueField) ⊗ₜ[A] KaehlerDifferential.D K A x') ∈ N := by
        rw [← hT]
        exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))
      have hw0 : algebraMap A q.ResidueField w ≠ 0 := fun h =>
        hwq ((Ideal.algebraMap_residueField_eq_zero).mp h)
      have := Submodule.smul_mem N (algebraMap A q.ResidueField w)⁻¹ hmem
      rwa [smul_smul, inv_mul_cancel₀ hw0, one_smul, hDx] at this
    have h1 : ∀ ω : Ω[A⁄K], (1 : q.ResidueField) ⊗ₜ[A] ω ∈ N := by
      intro ω
      have hω : ω ∈ Submodule.span A (Set.range (KaehlerDifferential.D K A)) := by
        rw [KaehlerDifferential.span_range_derivation]; trivial
      induction hω using Submodule.span_induction with
      | mem x hx => obtain ⟨y, rfl⟩ := hx; exact hD y
      | zero => rw [TensorProduct.tmul_zero]; exact N.zero_mem
      | add x y _ _ hx hy => rw [TensorProduct.tmul_add]; exact N.add_mem hx hy
      | smul c x _ hx => rw [hsm]; exact N.smul_mem _ hx
    rw [eq_top_iff]
    intro m hm
    clear hm
    induction m using TensorProduct.induction_on with
    | zero => exact N.zero_mem
    | tmul k ω =>
      have : k ⊗ₜ[A] ω = k • ((1 : q.ResidueField) ⊗ₜ[A] ω) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [this]; exact N.smul_mem _ (h1 ω)
    | add x y hx hy => exact N.add_mem hx hy

  have t_s6 : ∀ (V : P.Opens) (hV : IsAffineOpen V) (ι : Type) (a : ι → Γ(P, V)) (s : Γ(P, V)), (letI : Algebra K Γ(P, V) := ((sP.appLE ⊤ V le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom).toAlgebra; ∀ (A' : Type u) [CommRing A'] [Algebra Γ(P, V) A'] [IsLocalization.Away s A'], RingHom.Etale ((algebraMap Γ(P, V) A').comp (MvPolynomial.eval₂Hom (algebraMap K Γ(P, V)) a))) → RingHom.Etale (MvPolynomial.eval₂Hom ((sP.appLE ⊤ (P.basicOpen s) le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) (fun i => (P.presheaf.map (homOfLE (P.basicOpen_le s)).op).hom (a i))) := by
    intro V hV ι a s hét
    letI : Algebra K Γ(P, V) := ((sP.appLE ⊤ V le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom).toAlgebra
    haveI := hV.isLocalization_basicOpen s
    have h := hét Γ(P, P.basicOpen s)
    rw [MvPolynomial.comp_eval₂Hom] at h
    have hmap : sP.appLE ⊤ V le_top ≫ P.presheaf.map (homOfLE (P.basicOpen_le s)).op =
        sP.appLE ⊤ (P.basicOpen s) le_top := Scheme.Hom.appLE_map sP _ _
    have hκ : (algebraMap Γ(P, V) Γ(P, P.basicOpen s)).comp (algebraMap K Γ(P, V)) =
        (sP.appLE ⊤ (P.basicOpen s) le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom := by
      show (P.presheaf.map (homOfLE (P.basicOpen_le s)).op).hom.comp
        ((sP.appLE ⊤ V le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom) = _
      rw [← RingHom.comp_assoc, ← CommRingCat.hom_comp, hmap]
    rw [hκ] at h
    exact h

  obtain ⟨W₀, hW₀, hyW₀, hW₀U, s₀, hs₀⟩ := t_s1 P _ U hyU r zt
  obtain ⟨V, hV, hx, e, _ρ, hVW₀, _, _, hSm, _, he1, he2, _, _, _⟩ :=
    wc_pfam_mc_source_chart K sP sP m (𝟙 P) (Category.id_comp sP) W₀ hW₀ σ hσ hyW₀
  have hVW₀' : V ≤ W₀ := hVW₀
  have hVU : V ≤ U := hVW₀'.trans hW₀U
  let a : Option (Fin r) → Γ(P, V) := fun o =>
    o.elim ((P.presheaf.map (homOfLE hVU).op).hom φ₀) (fun k => (P.presheaf.map (homOfLE hVW₀').op).hom (s₀ k))
  have hrange : Set.range (fun o => (P.presheaf.germ V _ hx).hom (a o)) =
      insert ((P.presheaf.germ U _ hyU).hom φ₀) (Set.range zt) := by
    have : (fun o => (P.presheaf.germ V _ hx).hom (a o)) =
        (fun o : Option (Fin r) => o.elim ((P.presheaf.germ U _ hyU).hom φ₀) zt) := by
      funext o
      cases o with
      | none => exact TopCat.Presheaf.germ_res_apply P.presheaf (homOfLE hVU) _ hx φ₀
      | some k => exact (TopCat.Presheaf.germ_res_apply P.presheaf (homOfLE hVW₀') _ hx (s₀ k)).trans (hs₀ k)
    rw [this, Option.range_elim]
  have hgen' := hgen
  rw [← hrange] at hgen'
  obtain ⟨h3a, h3b, h3c⟩ := t_s3 P V hV _ hx (Option (Fin r)) a hgen'
  letI : Algebra K Γ(P, V) := ((sP.appLE ⊤ V le_top).hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom).toAlgebra
  letI : (RingHom.ker e).IsPrime := RingHom.ker_isPrime e
  rw [← he2] at h3a h3b h3c
  have hspan := t_s4 K Γ(P, V) e he1 (RingHom.ker e) rfl (Option (Fin r)) a h3a h3b
  have hcard : Fintype.card (Option (Fin r)) = m := by
    rw [Fintype.card_option, Fintype.card_fin, hmr]
  obtain ⟨s, hs, hét⟩ := wc_tube_jacobian_etale K Γ(P, V) m (Option (Fin r)) a hSm hcard (RingHom.ker e) hspan
  have hWV : P.basicOpen s ≤ V := P.basicOpen_le s
  have hWU : P.basicOpen s ≤ U := hWV.trans hVU
  have hyW : σ (IsLocalRing.closedPoint K) ∈ P.basicOpen s := h3c s hs
  have h6 := t_s6 V hV (Option (Fin r)) a s hét
  refine ⟨P.basicOpen s, hV.basicOpen s, hyW, hWU,
    fun k => (P.presheaf.map (homOfLE hWV).op).hom (a (some k)), ?_, ?_⟩
  · intro k
    rw [TopCat.Presheaf.germ_res_apply P.presheaf (homOfLE hWV) _ hyW (a (some k))]
    exact (TopCat.Presheaf.germ_res_apply P.presheaf (homOfLE hVW₀') _ hx (s₀ k)).trans (hs₀ k)
  · convert h6 using 2
    funext o
    cases o with
    | none =>
      show (P.presheaf.map (homOfLE hWU).op).hom φ₀ =
        (P.presheaf.map (homOfLE hWV).op).hom ((P.presheaf.map (homOfLE hVU).op).hom φ₀)
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]
      rfl
    | some k => rfl

theorem wc_pfam_mc_pullback_stalk_ideal : ∀ {Yt Xu P C : Scheme.{u}} (p : Yt ⟶ Xu) (f : Yt ⟶ C) (h : Xu ⟶ P) (lam : C ⟶ P), IsPullback p f h lam → IsClosedImmersion lam → ∀ (y : Yt) (c : C), f y = c → ∀ (W : P.Opens) (hy : lam c ∈ W) (hpy : p y ∈ h ⁻¹ᵁ W) (I : Set Γ(P, W)), RingHom.ker (lam.stalkMap c).hom = Ideal.span ((fun s => (P.presheaf.germ W (lam c) hy).hom s) '' I) → Function.Surjective (p.stalkMap y).hom ∧ RingHom.ker (p.stalkMap y).hom = Ideal.span ((fun s => (Xu.presheaf.germ (h ⁻¹ᵁ W) (p y) hpy).hom ((h.app W).hom s)) '' I) :=
by
  intro Yt Xu P C p f h lam hpb hlam y c hfy W hy hpy I hker
  have : IsClosedImmersion p :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hpb.flip hlam
  have hpinj : Function.Injective p := p.isClosedEmbedding.isEmbedding.injective
  have hlsurj : Function.Surjective (lam.stalkMap c).hom := lam.stalkMap_surjective c
  refine ⟨p.stalkMap_surjective y, ?_⟩
  set J := Ideal.span ((fun s => (Xu.presheaf.germ (h ⁻¹ᵁ W) (p y) hpy).hom ((h.app W).hom s)) '' I)
    with hJ
  have hw : p ≫ h = f ≫ lam := hpb.w
  have hpt : h (p y) = lam c := by
    rw [← Scheme.Hom.comp_apply, hw, Scheme.Hom.comp_apply, hfy]
  have hIker : ∀ s ∈ I, (lam.stalkMap c).hom ((P.presheaf.germ W (lam c) hy).hom s) = 0 := by
    intro s hs
    rw [← RingHom.mem_ker, hker]
    exact Ideal.subset_span ⟨s, hs, rfl⟩

  have hJle : J ≤ RingHom.ker (p.stalkMap y).hom := by
    subst hfy
    rw [hJ, Ideal.span_le]
    rintro _ ⟨s, hs, rfl⟩
    simp only [SetLike.mem_coe, RingHom.mem_ker]
    have key : ∀ (g1 g2 : Yt ⟶ P), g1 = g2 → ∀ (h1 : y ∈ g1 ⁻¹ᵁ W) (h2 : y ∈ g2 ⁻¹ᵁ W),
        (Yt.presheaf.germ (g1 ⁻¹ᵁ W) y h1).hom ((g1.app W).hom s) =
          (Yt.presheaf.germ (g2 ⁻¹ᵁ W) y h2).hom ((g2.app W).hom s) := by
      rintro g1 g2 rfl h1 h2
      rfl
    have e1 := Scheme.Hom.germ_stalkMap_apply p (h ⁻¹ᵁ W) y hpy ((h.app W).hom s)
    have e2 := Scheme.Hom.germ_stalkMap_apply f (lam ⁻¹ᵁ W) y hy ((lam.app W).hom s)
    have e3 := Scheme.Hom.germ_stalkMap_apply lam W (f y) hy s
    have e4 := key (p ≫ h) (f ≫ lam) hw hpy hy
    rw [e1]
    have h0 := hIker s hs
    rw [e3] at h0
    have h00 : (f.stalkMap y).hom ((C.presheaf.germ (lam ⁻¹ᵁ W) (f y) hy).hom ((lam.app W).hom s)) = 0 := by
      rw [h0, map_zero]
    rw [e2] at h00
    rw [← h00]
    exact e4

  have hJne : J ≠ ⊤ := by
    intro hJt
    apply RingHom.ker_ne_top (p.stalkMap y).hom
    exact top_le_iff.mp (hJt ▸ hJle)

  have : Nontrivial (Xu.presheaf.stalk (p y) ⧸ J) := by
    refine ⟨⟨0, 1, fun h01 => hJne ?_⟩⟩
    rw [Ideal.eq_top_iff_one, ← Ideal.Quotient.eq_zero_iff_mem, map_one]
    exact h01.symm
  have hQloc : IsLocalRing (Xu.presheaf.stalk (p y) ⧸ J) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  have : IsLocalRing (CommRingCat.of (Xu.presheaf.stalk (p y) ⧸ J)) := hQloc
  let Mk : Xu.presheaf.stalk (p y) ⟶ CommRingCat.of (Xu.presheaf.stalk (p y) ⧸ J) :=
    CommRingCat.ofHom (Ideal.Quotient.mk J)
  have hloc : IsLocalHom Mk.hom :=
    Function.Surjective.isLocalHom (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
  let g0 : Spec (CommRingCat.of (Xu.presheaf.stalk (p y) ⧸ J)) ⟶ Xu :=
    Spec.map Mk ≫ Xu.fromSpecStalk (p y)

  let σ := P.presheaf.stalkSpecializes (Specializes.of_eq hpt)
  let ψ : P.presheaf.stalk (lam c) →+* (Xu.presheaf.stalk (p y) ⧸ J) :=
    (Ideal.Quotient.mk J).comp ((h.stalkMap (p y)).hom.comp σ.hom)
  have hψ : RingHom.ker (lam.stalkMap c).hom ≤ RingHom.ker ψ := by
    rw [hker, Ideal.span_le]
    rintro _ ⟨s, hs, rfl⟩
    simp only [SetLike.mem_coe, RingHom.mem_ker, ψ, σ, RingHom.comp_apply]
    rw [TopCat.Presheaf.germ_stalkSpecializes_apply, Scheme.Hom.germ_stalkMap_apply]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨s, hs, rfl⟩)
  let β := (lam.stalkMap c).hom.liftOfSurjective hlsurj ⟨ψ, hψ⟩
  have hβ : β.comp (lam.stalkMap c).hom = ψ := RingHom.liftOfSurjective_comp _ _ _
  let B : C.presheaf.stalk c ⟶ CommRingCat.of (Xu.presheaf.stalk (p y) ⧸ J) :=
    CommRingCat.ofHom β
  let b : Spec (CommRingCat.of (Xu.presheaf.stalk (p y) ⧸ J)) ⟶ C :=
    Spec.map B ≫ C.fromSpecStalk c
  have hring : σ ≫ h.stalkMap (p y) ≫ Mk = lam.stalkMap c ≫ B := by
    ext r
    show ψ r = β ((lam.stalkMap c).hom r)
    rw [← hβ]
    rfl
  have hb : g0 ≫ h = b ≫ lam := by
    calc g0 ≫ h = Spec.map Mk ≫ (Xu.fromSpecStalk (p y) ≫ h) := Category.assoc _ _ _
      _ = Spec.map Mk ≫ Spec.map (h.stalkMap (p y)) ≫ P.fromSpecStalk (h (p y)) := by
          rw [Scheme.SpecMap_stalkMap_fromSpecStalk]
      _ = Spec.map Mk ≫ Spec.map (h.stalkMap (p y)) ≫ Spec.map σ ≫ P.fromSpecStalk (lam c) := by
          rw [Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
      _ = Spec.map (σ ≫ h.stalkMap (p y) ≫ Mk) ≫ P.fromSpecStalk (lam c) := by
          simp only [Spec.map_comp, Category.assoc]
      _ = Spec.map (lam.stalkMap c ≫ B) ≫ P.fromSpecStalk (lam c) := by
          rw [hring]
      _ = Spec.map B ≫ (Spec.map (lam.stalkMap c) ≫ P.fromSpecStalk (lam c)) := by
          rw [Spec.map_comp, Category.assoc]
      _ = b ≫ lam := by
          rw [Scheme.SpecMap_stalkMap_fromSpecStalk]
          simp only [b, Category.assoc]

  let ℓ := hpb.lift g0 b hb
  have hℓ : ℓ ≫ p = g0 := hpb.lift_fst _ _ _

  have hE : SpecToEquivOfLocalRing Xu (CommRingCat.of (Xu.presheaf.stalk (p y) ⧸ J)) (ℓ ≫ p) =
      ⟨p y, ⟨Mk, hloc⟩⟩ := by
    rw [Equiv.apply_eq_iff_eq_symm_apply, SpecToEquivOfLocalRing_symm_apply, hℓ]
  obtain ⟨h₁, h₂⟩ := SpecToEquivOfLocalRing_eq_iff.mp hE
  have h₁' : p (ℓ (IsLocalRing.closedPoint (CommRingCat.of (Xu.presheaf.stalk (p y) ⧸ J)))) =
      p y :=
    (Scheme.Hom.comp_apply ℓ p _).symm.trans ((SpecToEquivOfLocalRing_apply_fst _ _ _).symm.trans h₁)
  have hy' : ℓ (IsLocalRing.closedPoint (CommRingCat.of (Xu.presheaf.stalk (p y) ⧸ J))) = y :=
    hpinj h₁'
  have h₃ : Scheme.stalkClosedPointTo (ℓ ≫ p) =
      (Xu.presheaf.stalkCongr (Inseparable.of_eq h₁')).hom ≫ Mk :=
    (SpecToEquivOfLocalRing_apply_snd_coe _ _ _).symm.trans h₂
  have h₅ : p.stalkMap (ℓ (IsLocalRing.closedPoint (CommRingCat.of (Xu.presheaf.stalk (p y) ⧸ J))))
      ≫ Scheme.stalkClosedPointTo ℓ =
      (Xu.presheaf.stalkCongr (Inseparable.of_eq h₁')).hom ≫ Mk :=
    (Scheme.stalkClosedPointTo_comp ℓ p).symm.trans h₃
  have aux : ∀ (y' : Yt) (_ : y' = y) (hin : Inseparable (p y') (p y))
      (φ : Yt.presheaf.stalk y' ⟶ CommRingCat.of (Xu.presheaf.stalk (p y) ⧸ J)),
      p.stalkMap y' ≫ φ = (Xu.presheaf.stalkCongr hin).hom ≫ Mk →
      ∀ r, (p.stalkMap y).hom r = 0 → Mk.hom r = 0 := by
    rintro y' rfl hin φ hφ r hr
    have e := congrArg (fun g => g.hom r) hφ
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e
    rw [TopCat.Presheaf.stalkCongr_hom, TopCat.Presheaf.stalkSpecializes_refl, hr, map_zero] at e
    exact e.symm
  apply le_antisymm _ hJle
  intro r hr
  rw [RingHom.mem_ker] at hr
  have := aux _ hy' (Inseparable.of_eq h₁') (Scheme.stalkClosedPointTo ℓ) h₅ r hr
  exact Ideal.Quotient.eq_zero_iff_mem.mp this

theorem wc_pfam_mc_closed_immersion_stalk_surj : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y), IsClosedImmersion f → ∀ x : X, Function.Surjective (f.stalkMap x).hom :=
by
  intro X Y f hf x
  haveI := hf
  exact f.stalkMap_surjective x

theorem wc_pfam_mc_rational_point_closed : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (q : X ⟶ Spec (.of K)) (s : Spec (.of K) ⟶ X), s ≫ q = 𝟙 _ → IsClosed ({s (IsLocalRing.closedPoint K)} : Set X) :=
by
  intro K _ X q s hs
  have affine : ∀ (A : CommRingCat.{u}) (t : Spec (.of K) ⟶ Spec A) (g : Spec A ⟶ Spec (.of K)),
      t ≫ g = 𝟙 _ → IsClosed ({t (IsLocalRing.closedPoint K)} : Set (Spec A)) := by
    intro A t g htg
    obtain ⟨φ, rfl⟩ : ∃ φ, Spec.map φ = t := ⟨_, Spec.map_preimage t⟩
    obtain ⟨ψ, rfl⟩ : ∃ ψ, Spec.map ψ = g := ⟨_, Spec.map_preimage g⟩
    have h1 : ψ ≫ φ = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, htg, Spec.map_id]
    have hsurj : Function.Surjective φ.hom := fun k => ⟨ψ.hom k, by
      have := congrArg (fun f => f.hom k) h1
      simpa using this⟩
    have hmax := RingHom.ker_isMaximal_of_surjective φ.hom hsurj
    have hid : (PrimeSpectrum.comap φ.hom (IsLocalRing.closedPoint K)).asIdeal
        = RingHom.ker φ.hom := by
      rw [PrimeSpectrum.comap_asIdeal, RingHom.ker_eq_comap_bot]
      congr 1
      exact IsLocalRing.maximalIdeal_eq_bot
    have key := (PrimeSpectrum.isClosed_singleton_iff_isMaximal
      (PrimeSpectrum.comap φ.hom (IsLocalRing.closedPoint K))).mpr (by rw [hid]; exact hmax)
    exact key
  apply isClosed_of_closure_subset
  intro y hy
  have hxy : s (IsLocalRing.closedPoint K) ⤳ y := specializes_iff_mem_closure.mpr hy
  obtain ⟨V, hV, hyV, -⟩ :=
    exists_isAffineOpen_mem_and_subset (x := y) (U := ⊤) (TopologicalSpace.Opens.mem_top y)
  have hxV : s (IsLocalRing.closedPoint K) ∈ V := hxy.mem_open V.isOpen hyV
  have := hV.isOpenImmersion_fromSpec
  have hrange : Set.range hV.fromSpec = V := hV.range_fromSpec
  have hsub : Set.range s ⊆ Set.range hV.fromSpec := by
    rintro _ ⟨w, rfl⟩
    have hw : w = IsLocalRing.closedPoint K := Subsingleton.elim (α := PrimeSpectrum K) _ _
    rw [hw, hrange]
    exact hxV
  let t := IsOpenImmersion.lift hV.fromSpec s hsub
  have ht : t ≫ hV.fromSpec = s := IsOpenImmersion.lift_fac _ _ _
  have htg : t ≫ (hV.fromSpec ≫ q) = 𝟙 _ := by rw [← Category.assoc, ht, hs]
  have hcl := affine Γ(X, V) t (hV.fromSpec ≫ q) htg
  have hιt : hV.fromSpec (t (IsLocalRing.closedPoint K)) = s (IsLocalRing.closedPoint K) := by
    have e := Scheme.Hom.comp_apply t hV.fromSpec (IsLocalRing.closedPoint K)
    rw [ht] at e
    exact e.symm
  have hyr : y ∈ Set.range hV.fromSpec := by rw [hrange]; exact hyV
  obtain ⟨y', rfl⟩ := hyr
  have hspec : t (IsLocalRing.closedPoint K) ⤳ y' := by
    rw [← hV.fromSpec.isOpenEmbedding.isInducing.specializes_iff, hιt]
    exact hxy
  have hmem := hspec.mem_closed hcl rfl
  rw [Set.mem_singleton_iff] at hmem ⊢
  rw [hmem, hιt]

theorem wc_pfam_mc_stalk_loc_iso : ∀ (X : Scheme.{u}) (V : X.Opens) (hV : IsAffineOpen V) (x : X) (hx : x ∈ V) (q : Ideal Γ(X, V)) [q.IsPrime], q = (hV.primeIdealOf ⟨x, hx⟩).asIdeal → ∃ τ : Localization.AtPrime q ≃+* X.presheaf.stalk x, ∀ r : Γ(X, V), τ (algebraMap Γ(X, V) (Localization.AtPrime q) r) = (X.presheaf.germ V x hx).hom r :=
by
  intro X V hV x hx q _ hq
  subst hq
  letI : Algebra Γ(X, V) (X.presheaf.stalk x) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf (⟨x, hx⟩ : V)
  haveI : IsLocalization.AtPrime (X.presheaf.stalk x) (hV.primeIdealOf ⟨x, hx⟩).asIdeal :=
    hV.isLocalization_stalk ⟨x, hx⟩
  refine ⟨(IsLocalization.algEquiv (hV.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl
    (Localization.AtPrime (hV.primeIdealOf ⟨x, hx⟩).asIdeal) (X.presheaf.stalk x)).toRingEquiv, ?_⟩
  intro r
  exact (IsLocalization.algEquiv (hV.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl
    (Localization.AtPrime (hV.primeIdealOf ⟨x, hx⟩).asIdeal) (X.presheaf.stalk x)).commutes r

theorem wc_pfam_mc_odp_stalk_unit : ∀ {Yt Xu C P : Scheme.{u}} (p : Yt ⟶ Xu) (f : Yt ⟶ C) (h : Xu ⟶ P) (lam : C ⟶ P), p ≫ h = f ≫ lam → ∀ (x' : Yt) (c : C), f x' = c → ∀ (W : P.Opens) (hy : lam c ∈ W) (hpW : p x' ∈ h ⁻¹ᵁ W) (φ : Γ(P, W)) (τ : C.presheaf.stalk (f x')), IsLocalRing.maximalIdeal (C.presheaf.stalk (f x')) = Ideal.span {τ} → IsLocalRing.maximalIdeal (C.presheaf.stalk c) = Ideal.span {(lam.stalkMap c).hom ((P.presheaf.germ W (lam c) hy).hom φ)} → ∃ v : C.presheaf.stalk (f x'), IsUnit v ∧ (p.stalkMap x').hom ((Xu.presheaf.germ (h ⁻¹ᵁ W) (p x') hpW).hom ((h.app W).hom φ)) = (f.stalkMap x').hom (v * τ) :=
by
  intro Yt Xu C P p f h lam hsq x' c hc W hy hpW φ τ hτ hg
  subst hc
  set g := (lam.stalkMap (f x')).hom ((P.presheaf.germ W (lam (f x')) hy).hom φ) with hgdef
  have hτm : τ ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk (f x')) := by
    rw [hτ]; exact Ideal.mem_span_singleton_self τ
  have hgm : g ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk (f x')) := by
    rw [hg]; exact Ideal.mem_span_singleton_self g
  have hgτ : g ∈ Ideal.span {τ} := hτ ▸ hgm
  have hτg : τ ∈ Ideal.span {g} := hg ▸ hτm
  obtain ⟨v₀, hv₀⟩ := Ideal.mem_span_singleton'.mp hgτ
  obtain ⟨v₁, hv₁⟩ := Ideal.mem_span_singleton'.mp hτg
  have key : ∃ v : C.presheaf.stalk (f x'), IsUnit v ∧ g = v * τ := by
    by_cases hu : IsUnit v₀
    · exact ⟨v₀, hu, hv₀.symm⟩
    · have hv₀m : v₀ ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk (f x')) :=
        (IsLocalRing.mem_maximalIdeal _).mpr hu
      rw [hτ] at hv₀m
      obtain ⟨w, hw⟩ := Ideal.mem_span_singleton'.mp hv₀m
      have e0 : τ = v₁ * w * τ * τ := by
        calc τ = v₁ * g := hv₁.symm
          _ = v₁ * (v₀ * τ) := by rw [hv₀]
          _ = v₁ * ((w * τ) * τ) := by rw [hw]
          _ = v₁ * w * τ * τ := by ring
      have e1 : (1 - v₁ * w * τ) * τ = 0 := by
        calc (1 - v₁ * w * τ) * τ = τ - v₁ * w * τ * τ := by ring
          _ = 0 := by rw [← e0, sub_self]
      have hm2 : v₁ * w * τ ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk (f x')) :=
        Ideal.mul_mem_left _ _ hτm
      have hun : IsUnit (1 - v₁ * w * τ) :=
        IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ hm2
      have hτ0 : τ = 0 := (hun.mul_right_eq_zero).mp e1
      refine ⟨1, isUnit_one, ?_⟩
      rw [← hv₀, hτ0, mul_zero, mul_zero]
  obtain ⟨v, hv, hgv⟩ := key
  refine ⟨v, hv, ?_⟩
  rw [← hgv]
  have s4 : ∀ (k₁ k₂ : Yt ⟶ P), k₁ = k₂ → ∀ (h₁ : k₁ x' ∈ W) (h₂ : k₂ x' ∈ W),
      (k₁.stalkMap x').hom ((P.presheaf.germ W (k₁ x') h₁).hom φ) =
        (k₂.stalkMap x').hom ((P.presheaf.germ W (k₂ x') h₂).hom φ) := by
    rintro k₁ _ rfl h₁ h₂
    rfl
  have hpW' : (p ≫ h) x' ∈ W := hpW
  have hy' : (f ≫ lam) x' ∈ W := hy
  have e1 := Scheme.Hom.germ_stalkMap_apply h W (p x') hpW φ
  have L : (p.stalkMap x').hom ((Xu.presheaf.germ (h ⁻¹ᵁ W) (p x') hpW).hom ((h.app W).hom φ)) =
      ((p ≫ h).stalkMap x').hom ((P.presheaf.germ W ((p ≫ h) x') hpW').hom φ) := by
    rw [Scheme.Hom.stalkMap_comp]
    exact congrArg (p.stalkMap x').hom e1.symm
  have R : ((f ≫ lam).stalkMap x').hom ((P.presheaf.germ W ((f ≫ lam) x') hy').hom φ) =
      (f.stalkMap x').hom g := by
    rw [Scheme.Hom.stalkMap_comp]
    rfl
  rw [L, s4 _ _ hsq hpW' hy', R]

theorem wc_pfam_mc_normal_form_local : ∀ (K O Ob : Type u) [Field K] [CommRing O] [IsLocalRing O] [Algebra K O] [CommRing Ob] [IsLocalRing Ob] (n r : ℕ) (eX : O →+* K), eX.comp (algebraMap K O) = RingHom.id K → ∀ (π : O →+* Ob), Function.Surjective π → ∀ (ζ : Fin r → O), RingHom.ker π = Ideal.span (Set.range ζ) → ∀ (tb : Fin n → Ob) (A : Matrix (Fin n) (Fin n) Ob) (T u : Ob), IsLocalRing.maximalIdeal Ob = Ideal.span (Set.range tb) → IsUnit (A + A.transpose).det → T - ∑ p, ∑ q, A p q * tb p * tb q ∈ IsLocalRing.maximalIdeal Ob ^ 3 → IsUnit u → ∀ G : O, π G = u * T → ∃ (t : Fin n → O) (a : Matrix (Fin n) (Fin n) K) (H : Matrix (Fin n) (Fin n) O) (w : Fin r → O), (a + a.transpose).det ≠ 0 ∧ (∀ p q, H p q ∈ IsLocalRing.maximalIdeal O) ∧ IsLocalRing.maximalIdeal O = Ideal.span (Set.range t ∪ Set.range ζ) ∧ G = ∑ p, ∑ q, (algebraMap K O (a p q) + H p q) * t p * t q + ∑ k, ζ k * w k :=
by
  classical
  intro K O Ob _ _ _ _ _ _ n r eX hX π hπ ζ hker tb A T u htb hA hcub hu G hG

  have hι : ∀ c : K, eX (algebraMap K O c) = c := fun c => RingHom.congr_fun hX c
  have hmem : ∀ x : O, x ∈ IsLocalRing.maximalIdeal O ↔ eX x = 0 := by
    have hsurj : Function.Surjective eX := fun c => ⟨algebraMap K O c, hι c⟩
    have hmax : (RingHom.ker eX).IsMaximal := RingHom.ker_isMaximal_of_surjective eX hsurj
    have hk : RingHom.ker eX = IsLocalRing.maximalIdeal O := IsLocalRing.eq_maximalIdeal hmax
    intro x
    rw [← hk, RingHom.mem_ker]

  have : IsLocalHom π := hπ.isLocalHom π
  choose t ht using fun p => hπ (tb p)
  choose Ã hÃ using fun p q => hπ (A p q)
  obtain ⟨ũ, hũ⟩ := hπ u
  obtain ⟨B, hB⟩ : ∃ B : Matrix (Fin n) (Fin n) O, ∀ p q, B p q = ũ * Ã p q :=
    ⟨Matrix.of fun p q => ũ * Ã p q, fun _ _ => rfl⟩
  have hdetB : IsUnit (B + B.transpose).det := by
    apply isUnit_of_map_unit π
    rw [RingHom.map_det]
    have h1 : π.mapMatrix (B + B.transpose) = u • (A + A.transpose) := by
      ext p q
      simp [hB, hũ, hÃ, Matrix.transpose_apply, mul_add]
    rw [h1, Matrix.det_smul, Fintype.card_fin]
    exact (hu.pow n).mul hA
  have hmap : Ideal.map π (IsLocalRing.maximalIdeal O) = IsLocalRing.maximalIdeal Ob :=
    IsLocalRing.map_maximalIdeal_of_surjective π hπ
  have hkerle : RingHom.ker π ≤ IsLocalRing.maximalIdeal O :=
    IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top π)

  have hm : IsLocalRing.maximalIdeal O = Ideal.span (Set.range t ∪ Set.range ζ) := by
    rw [Ideal.span_union, ← hker]
    apply le_antisymm
    · intro m hm
      have h1 : π m ∈ Ideal.span (Set.range tb) := by
        rw [← htb, ← hmap]; exact Ideal.mem_map_of_mem π hm
      obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp h1
      choose b hb using fun p => hπ (c p)
      have h2 : m - ∑ p, b p * t p ∈ RingHom.ker π := by
        rw [RingHom.mem_ker, map_sub, map_sum]
        simp only [map_mul, hb, ht]
        rw [hc, sub_self]
      have h3 : ∑ p, b p * t p ∈ Ideal.span (Set.range t) :=
        Ideal.sum_mem _ (fun p _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨p, rfl⟩))
      rw [show m = ∑ p, b p * t p + (m - ∑ p, b p * t p) by ring]
      exact Submodule.add_mem_sup h3 h2
    · apply sup_le
      · rw [Ideal.span_le]
        rintro _ ⟨p, rfl⟩
        rw [SetLike.mem_coe, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu'
        have h1 : tb p ∈ IsLocalRing.maximalIdeal Ob := by
          rw [htb]; exact Ideal.subset_span ⟨p, rfl⟩
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h1
        exact h1 (ht p ▸ hu'.map π)
      · exact hkerle

  have hgen : ∀ b ∈ IsLocalRing.maximalIdeal O, ∃ (β : Fin n → O) (v : Fin r → O),
      b = ∑ p, β p * t p + ∑ k, ζ k * v k := by
    intro b hb
    rw [hm, Ideal.span_union] at hb
    obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hb
    obtain ⟨β, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hy
    obtain ⟨v, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hz
    exact ⟨β, v, congrArg _ (Finset.sum_congr rfl fun k _ => mul_comm _ _)⟩
  have hQ : ∀ y ∈ IsLocalRing.maximalIdeal O * IsLocalRing.maximalIdeal O,
      ∃ (c : Matrix (Fin n) (Fin n) O) (v : Fin r → O),
        y = ∑ p, ∑ q, c p q * t p * t q + ∑ k, ζ k * v k := by
    intro y hy
    refine Submodule.mul_induction_on hy ?_ ?_
    · intro b hb b' hb'
      obtain ⟨β, v, rfl⟩ := hgen b hb
      obtain ⟨β', v', rfl⟩ := hgen b' hb'
      obtain ⟨c, hc⟩ : ∃ c : Matrix (Fin n) (Fin n) O, ∀ p q, c p q = β p * β' q :=
        ⟨Matrix.of fun p q => β p * β' q, fun _ _ => rfl⟩
      refine ⟨c, fun k => v' k * ∑ p, β p * t p + v k * (∑ p, β' p * t p + ∑ k, ζ k * v' k), ?_⟩
      have h1 : ∑ p, ∑ q, c p q * t p * t q = (∑ p, β p * t p) * (∑ p, β' p * t p) := by
        rw [Finset.sum_mul_sum]
        refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
        rw [hc]; ring
      have h2 : ∑ k, ζ k * (v' k * ∑ p, β p * t p + v k * (∑ p, β' p * t p + ∑ k, ζ k * v' k)) =
          (∑ p, β p * t p) * (∑ k, ζ k * v' k) +
            (∑ k, ζ k * v k) * (∑ p, β' p * t p + ∑ k, ζ k * v' k) := by
        rw [Finset.mul_sum, Finset.sum_mul, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun k _ => ?_
        ring
      linear_combination -h1 - h2
    · rintro y₁ y₂ ⟨c₁, v₁, rfl⟩ ⟨c₂, v₂, rfl⟩
      refine ⟨c₁ + c₂, v₁ + v₂, ?_⟩
      simp only [Matrix.add_apply, Pi.add_apply, add_mul, mul_add, Finset.sum_add_distrib]
      ring
  have hcube : ∀ x ∈ IsLocalRing.maximalIdeal O ^ 3, ∃ (m : Matrix (Fin n) (Fin n) O) (w : Fin r → O),
      (∀ p q, m p q ∈ IsLocalRing.maximalIdeal O) ∧
        x = ∑ p, ∑ q, m p q * t p * t q + ∑ k, ζ k * w k := by
    intro x hx
    rw [pow_three] at hx
    refine Submodule.mul_induction_on hx ?_ ?_
    · intro a ha y hy
      obtain ⟨c, v, rfl⟩ := hQ y hy
      obtain ⟨m, hm'⟩ : ∃ m : Matrix (Fin n) (Fin n) O, ∀ p q, m p q = a * c p q :=
        ⟨Matrix.of fun p q => a * c p q, fun _ _ => rfl⟩
      refine ⟨m, fun k => a * v k, fun p q => by rw [hm']; exact Ideal.mul_mem_right _ _ ha, ?_⟩
      simp only [mul_add, Finset.mul_sum]
      congr 1
      · exact Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => by rw [hm']; ring
      · exact Finset.sum_congr rfl fun k _ => by ring
    · rintro x₁ x₂ ⟨m₁, w₁, hm₁, rfl⟩ ⟨m₂, w₂, hm₂, rfl⟩
      refine ⟨m₁ + m₂, w₁ + w₂, fun p q => Ideal.add_mem _ (hm₁ p q) (hm₂ p q), ?_⟩
      simp only [Matrix.add_apply, Pi.add_apply, add_mul, mul_add, Finset.sum_add_distrib]
      ring

  have hπE : π (G - ∑ p, ∑ q, B p q * t p * t q) ∈ IsLocalRing.maximalIdeal Ob ^ 3 := by
    have h1 : π (G - ∑ p, ∑ q, B p q * t p * t q) = u * (T - ∑ p, ∑ q, A p q * tb p * tb q) := by
      rw [map_sub, hG, map_sum, mul_sub, Finset.mul_sum]
      congr 1
      refine Finset.sum_congr rfl fun p _ => ?_
      rw [map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun q _ => ?_
      simp only [map_mul, hB, hũ, hÃ, ht]
      ring
    rw [h1]
    exact Ideal.mul_mem_left _ _ hcub
  have hmap3 : Ideal.map π (IsLocalRing.maximalIdeal O ^ 3) = IsLocalRing.maximalIdeal Ob ^ 3 := by
    rw [Ideal.map_pow, hmap]
  rw [← hmap3] at hπE
  obtain ⟨x, hx, hxE⟩ := (Ideal.mem_map_iff_of_surjective π hπ).mp hπE
  have hEx : G - ∑ p, ∑ q, B p q * t p * t q - x ∈ Ideal.span (Set.range ζ) := by
    rw [← hker, RingHom.mem_ker, map_sub, hxE, sub_self]
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hEx
  have hc' : ∑ k, ζ k * c k = G - ∑ p, ∑ q, B p q * t p * t q - x := by
    rw [← hc]; exact Finset.sum_congr rfl fun _ _ => mul_comm _ _
  obtain ⟨m, w₂, hmm, hxm⟩ := hcube x hx

  obtain ⟨a, ha⟩ : ∃ a : Matrix (Fin n) (Fin n) K, ∀ p q, a p q = eX (B p q) :=
    ⟨Matrix.of fun p q => eX (B p q), fun _ _ => rfl⟩
  obtain ⟨H, hH⟩ : ∃ H : Matrix (Fin n) (Fin n) O, ∀ p q,
      H p q = B p q + m p q - algebraMap K O (eX (B p q)) :=
    ⟨Matrix.of fun p q => B p q + m p q - algebraMap K O (eX (B p q)), fun _ _ => rfl⟩
  refine ⟨t, a, H, fun k => c k + w₂ k, ?_, ?_, hm, ?_⟩
  · have h1 : a + a.transpose = eX.mapMatrix (B + B.transpose) := by
      ext p q
      simp [ha, Matrix.transpose_apply]
    rw [h1, ← RingHom.map_det]
    exact (hdetB.map eX).ne_zero
  · intro p q
    rw [hmem, hH, map_sub, map_add, hι, (hmem _).mp (hmm p q)]
    ring
  · have h2 : ∑ p, ∑ q, (algebraMap K O (a p q) + H p q) * t p * t q =
        ∑ p, ∑ q, B p q * t p * t q + ∑ p, ∑ q, m p q * t p * t q := by
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun p _ => ?_
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun q _ => ?_
      rw [ha, hH]
      ring
    have h3 : ∑ k, ζ k * (c k + w₂ k) = ∑ k, ζ k * c k + ∑ k, ζ k * w₂ k := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun k _ => by ring
    linear_combination hxm - hc' - h2 - h3

theorem wc_pfam_mc_smooth_off_formally_smooth : ∀ {X P : Scheme.{u}} (h : X ⟶ P) (W : P.Opens) (hW : IsAffineOpen W) (V : X.Opens) (hV : IsAffineOpen V) (ρ : Γ(P, W) →+* Γ(X, V)), Spec.map (CommRingCat.ofHom ρ) ≫ hW.fromSpec = hV.fromSpec ≫ h → ∀ (φ : Γ(P, W)) (Δ : Set P), (∀ (x : P) (hx : x ∈ W), x ∈ Δ ↔ (P.presheaf.germ W x hx).hom φ ∈ IsLocalRing.maximalIdeal (P.presheaf.stalk x)) → (∀ x : X, h x ∉ Δ → ∃ U : X.Opens, x ∈ U ∧ Smooth (U.ι ≫ h)) → ∀ 𝔭 : Ideal Γ(X, V), 𝔭.IsPrime → ρ φ ∉ 𝔭 → ∃ s : Γ(X, V), s ∉ 𝔭 ∧ RingHom.FormallySmooth ((algebraMap Γ(X, V) (Localization.Away s)).comp ρ) :=
by
  intro X P h W hW V hV ρ hsq φ Δ hΔ hoff 𝔭 h𝔭 hρφ
  let x𝔭 : Spec Γ(X, V) := ⟨𝔭, h𝔭⟩
  have hη : h (hV.fromSpec x𝔭) ∈ P.basicOpen φ := by
    have e1 : h (hV.fromSpec x𝔭) = hW.fromSpec (Spec.map (CommRingCat.ofHom ρ) x𝔭) := by
      rw [← Scheme.Hom.comp_apply, ← hsq, Scheme.Hom.comp_apply]
    rw [e1]
    show (Spec.map (CommRingCat.ofHom ρ) x𝔭) ∈ hW.fromSpec ⁻¹ᵁ P.basicOpen φ
    rw [hW.fromSpec_preimage_basicOpen]
    exact hρφ
  have hηW : h (hV.fromSpec x𝔭) ∈ W := P.basicOpen_le φ hη
  have hunit := (P.mem_basicOpen φ _ hηW).mp hη
  have hnotΔ : h (hV.fromSpec x𝔭) ∉ Δ := fun hd =>
    (IsLocalRing.notMem_maximalIdeal.mpr hunit) ((hΔ _ hηW).mp hd)
  obtain ⟨U, hξU, hsm⟩ := hoff _ hnotΔ
  have hξV : hV.fromSpec x𝔭 ∈ V := by
    have hmem : hV.fromSpec x𝔭 ∈ Set.range hV.fromSpec := ⟨x𝔭, rfl⟩
    rw [hV.range_fromSpec] at hmem
    exact hmem
  obtain ⟨s, hsU, hξs⟩ := hV.exists_basicOpen_le (V := U) ⟨_, hξU⟩ hξV
  have hs𝔭 : s ∉ 𝔭 := by
    have : x𝔭 ∈ hV.fromSpec ⁻¹ᵁ X.basicOpen s := hξs
    rw [hV.fromSpec_preimage_basicOpen] at this
    exact this
  refine ⟨s, hs𝔭, ?_⟩
  let ιs := Spec.map (CommRingCat.ofHom (algebraMap Γ(X, V) (Localization.Away s)))
  have hfac : Spec.map (CommRingCat.ofHom ((algebraMap Γ(X, V) (Localization.Away s)).comp ρ))
      ≫ hW.fromSpec = ιs ≫ hV.fromSpec ≫ h := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, hsq]
  have hrange : Set.range (ιs ≫ hV.fromSpec) ⊆ Set.range U.ι := by
    rintro _ ⟨y, rfl⟩
    rw [U.range_ι]
    apply hsU
    rw [Scheme.Hom.comp_apply]
    show ιs y ∈ hV.fromSpec ⁻¹ᵁ X.basicOpen s
    rw [hV.fromSpec_preimage_basicOpen]
    show s ∉ Ideal.comap (algebraMap Γ(X, V) (Localization.Away s)) y.asIdeal
    rw [Ideal.mem_comap]
    exact fun hm => y.2.ne_top (Ideal.eq_top_of_isUnit_mem _ hm
      (IsLocalization.Away.algebraMap_isUnit s))
  let j := IsOpenImmersion.lift U.ι (ιs ≫ hV.fromSpec) hrange
  have hj : j ≫ U.ι = ιs ≫ hV.fromSpec := IsOpenImmersion.lift_fac _ _ _
  have : IsOpenImmersion j := by
    have : IsOpenImmersion (j ≫ U.ι) := by rw [hj]; infer_instance
    exact IsOpenImmersion.of_comp j U.ι
  have := hsm
  have h1 : Smooth (j ≫ U.ι ≫ h) := inferInstance
  have h2 : Smooth (Spec.map (CommRingCat.ofHom ((algebraMap Γ(X, V) (Localization.Away s)).comp ρ))
      ≫ hW.fromSpec) := by
    rw [hfac, ← Category.assoc, ← hj, Category.assoc]; exact h1
  have h3 : Smooth (Spec.map (CommRingCat.ofHom ((algebraMap Γ(X, V) (Localization.Away s)).comp ρ))) :=
    @MorphismProperty.of_postcomp _ _ @Smooth @IsOpenImmersion
      (instHasOfPostcompPropertySchemeIsOpenImmersionOfIsStableUnderBaseChange @Smooth) _ _ _ _ _
      (inferInstance : IsOpenImmersion hW.fromSpec) h2
  have h4 : RingHom.Smooth ((algebraMap Γ(X, V) (Localization.Away s)).comp ρ) :=
    HasRingHomProperty.Spec_iff.mp h3
  exact h4.formallySmooth

theorem wc_pfam_mc_crit_alg : ∀ (K T R : Type u) [Field K] [CommRing T] [CommRing R] [Algebra K R] (κ : K →+* T) (ρ : T →+* R), ρ.comp κ = algebraMap K R → ∀ (r : ℕ) (φ : T) (z : Fin r → T), (letI : Algebra K T := κ.toAlgebra; ∃ bT : Module.Basis (Option (Fin r)) T Ω[T⁄K], ∀ o, bT o = KaehlerDifferential.D K T (o.elim φ z)) → (∀ 𝔭 : Ideal R, 𝔭.IsPrime → ρ φ ∉ 𝔭 → ∃ s : R, s ∉ 𝔭 ∧ RingHom.FormallySmooth ((algebraMap R (Localization.Away s)).comp ρ)) → ∀ (q : Ideal R) [q.IsPrime] (n : ℕ) (b : Module.Basis (Fin n ⊕ Fin r) (Localization.AtPrime q) Ω[Localization.AtPrime q⁄K]), (∀ k, b (Sum.inr k) = KaehlerDifferential.D K (Localization.AtPrime q) (algebraMap R (Localization.AtPrime q) (ρ (z k)))) → ∀ 𝔓 : Ideal (Localization.AtPrime q), 𝔓.IsPrime → (∀ i, (b.coord (Sum.inl i)).compDer (KaehlerDifferential.D K (Localization.AtPrime q)) (algebraMap R (Localization.AtPrime q) (ρ φ)) ∈ 𝔓) → algebraMap R (Localization.AtPrime q) (ρ φ) ∈ 𝔓 :=
by

  have s1 : ∀ (A S L : Type u) [CommRing A] [CommRing S] [CommRing L] (f : A →+* S),
      f.FormallySmooth → ∀ (π : S →+* L) (δ : A → L), (∀ a b, δ (a + b) = δ a + δ b) →
      (∀ a b, δ (a * b) = π (f a) * δ b + π (f b) * δ a) →
      ∃ D : S → L, (∀ x y, D (x + y) = D x + D y) ∧ (∀ x y, D (x * y) = π x * D y + π y * D x) ∧
        ∀ a, D (f a) = δ a := by
    intro A S L _ _ _ f hf π δ hadd hmul
    have h0 : δ 0 = 0 := by
      have e := hadd 0 0
      rw [add_zero] at e
      linear_combination -e
    have h1 : δ 1 = 0 := by
      have e := hmul 1 1
      rw [mul_one, map_one, map_one, one_mul] at e
      linear_combination -e
    let β : A →+* TrivSqZeroExt L L :=
      { toFun := fun a => TrivSqZeroExt.inl (π (f a)) + TrivSqZeroExt.inr (δ a)
        map_one' := by ext <;> simp [h1]
        map_mul' := fun a b => by
          ext
          · simp
          · simp [hmul]; ring
        map_zero' := by ext <;> simp [h0]
        map_add' := fun a b => by ext <;> simp [hadd] <;> ring }
    letI : Algebra A S := f.toAlgebra
    letI : Algebra A L := (π.comp f).toAlgebra
    letI : Algebra A (TrivSqZeroExt L L) := β.toAlgebra
    haveI : Algebra.FormallySmooth A S := hf
    let ψ : S →ₐ[A] L := { π with commutes' := fun a => rfl }
    let fstA : TrivSqZeroExt L L →ₐ[A] L :=
      { toFun := fun x => x.fst
        map_one' := rfl
        map_mul' := fun x y => rfl
        map_zero' := rfl
        map_add' := fun x y => rfl
        commutes' := fun a => by
          show (β a).fst = π (f a)
          simp [β] }
    have hsurj : Function.Surjective fstA := fun x => ⟨TrivSqZeroExt.inl x, rfl⟩
    have hnil : IsNilpotent (RingHom.ker (fstA : TrivSqZeroExt L L →+* L)) := by
      refine ⟨2, ?_⟩
      have hsq : RingHom.ker (fstA : TrivSqZeroExt L L →+* L) ^ 2 =
          RingHom.ker (fstA : TrivSqZeroExt L L →+* L) * RingHom.ker (fstA : TrivSqZeroExt L L →+* L) :=
        sq _
      refine hsq.trans (le_bot_iff.mp ?_)
      apply Ideal.mul_le.mpr
      intro x hx y hy
      rw [RingHom.mem_ker] at hx hy
      change x.fst = 0 at hx
      change y.fst = 0 at hy
      rw [Ideal.mem_bot]
      ext
      · simp [hx]
      · simp [hx, hy]
    let σ := Algebra.FormallySmooth.liftOfSurjective ψ fstA hsurj hnil
    have hσ : ∀ x, (σ x).fst = π x := fun x =>
      Algebra.FormallySmooth.liftOfSurjective_apply ψ fstA hsurj hnil x
    refine ⟨fun x => (σ x).snd, ?_, ?_, ?_⟩
    · intro x y
      show (σ (x + y)).snd = (σ x).snd + (σ y).snd
      rw [map_add]
      rfl
    · intro x y
      show (σ (x * y)).snd = π x * (σ y).snd + π y * (σ x).snd
      rw [map_mul, TrivSqZeroExt.snd_mul, hσ x, hσ y, smul_eq_mul, op_smul_eq_mul]
      ring
    · intro a
      show (σ (f a)).snd = δ a
      rw [show f a = algebraMap A S a from rfl, σ.commutes]
      show (β a).snd = δ a
      simp [β]
  intro K T R _ _ _ _ κ ρ hρκ r φ z hbT hsm q _ n b hb 𝔓 h𝔓 hcrit
  haveI := h𝔓

  obtain ⟨dd, hddadd, hddmul, hddκ, hddφ, hddz⟩ : ∃ dd : T → T, (∀ a b, dd (a + b) = dd a + dd b) ∧
      (∀ a b, dd (a * b) = a * dd b + b * dd a) ∧ (∀ c, dd (κ c) = 0) ∧ dd φ = 1 ∧
      ∀ k, dd (z k) = 0 := by
    letI : Algebra K T := κ.toAlgebra
    obtain ⟨bT, hbT⟩ := hbT
    let d : Derivation K T T := (bT.coord none).compDer (KaehlerDifferential.D K T)
    refine ⟨fun x => d x, fun a b => map_add d a b, fun a b => ?_, fun c => ?_, ?_, fun k => ?_⟩
    · show d (a * b) = a * d b + b * d a
      rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    · show d (algebraMap K T c) = 0
      exact d.map_algebraMap c
    · show bT.coord none (KaehlerDifferential.D K T φ) = 1
      have e := hbT none
      simp only [Option.elim_none] at e
      rw [← e, Module.Basis.coord_apply, Module.Basis.repr_self]
      simp
    · show bT.coord none (KaehlerDifferential.D K T (z k)) = 0
      have e := hbT (some k)
      simp only [Option.elim_some] at e
      rw [← e, Module.Basis.coord_apply, Module.Basis.repr_self]
      simp
  by_contra hG

  haveI h𝔭 : (Ideal.comap (algebraMap R (Localization.AtPrime q)) 𝔓).IsPrime :=
    Ideal.IsPrime.comap _
  have hφ𝔭 : ρ φ ∉ Ideal.comap (algebraMap R (Localization.AtPrime q)) 𝔓 :=
    fun h => hG (Ideal.mem_comap.mp h)
  obtain ⟨s, hs, hfs⟩ := hsm _ h𝔭 hφ𝔭
  let g : R →+* 𝔓.ResidueField :=
    (algebraMap (Localization.AtPrime q) 𝔓.ResidueField).comp (algebraMap R (Localization.AtPrime q))
  have hgs : IsUnit (g s) := isUnit_iff_ne_zero.mpr (fun h =>
    hs (Ideal.mem_comap.mpr (Ideal.algebraMap_residueField_eq_zero.mp h)))
  let ψ : Localization.Away s →+* 𝔓.ResidueField := IsLocalization.Away.lift s hgs
  have hψ : ∀ x, ψ (algebraMap R (Localization.Away s) x) = g x :=
    IsLocalization.Away.lift_eq s hgs

  let δ : T → 𝔓.ResidueField := fun a => g (ρ (dd a))
  have hδadd : ∀ a b, δ (a + b) = δ a + δ b := by
    intro a b
    show g (ρ (dd (a + b))) = g (ρ (dd a)) + g (ρ (dd b))
    rw [hddadd, map_add, map_add]
  have hδmul : ∀ a b, δ (a * b) = ψ (((algebraMap R (Localization.Away s)).comp ρ) a) * δ b +
      ψ (((algebraMap R (Localization.Away s)).comp ρ) b) * δ a := by
    intro a b
    show g (ρ (dd (a * b))) = ψ (algebraMap R _ (ρ a)) * g (ρ (dd b)) +
      ψ (algebraMap R _ (ρ b)) * g (ρ (dd a))
    rw [hψ, hψ, hddmul, map_add, map_add, map_mul, map_mul, map_mul, map_mul]
  obtain ⟨Ds, hDsadd, hDsmul, hDsf⟩ :=
    s1 T (Localization.Away s) 𝔓.ResidueField _ hfs ψ δ hδadd hδmul

  let Δ : R → 𝔓.ResidueField := fun x => Ds (algebraMap R (Localization.Away s) x)
  have hΔadd : ∀ a b, Δ (a + b) = Δ a + Δ b := by
    intro a b
    show Ds (algebraMap R _ (a + b)) = Ds (algebraMap R _ a) + Ds (algebraMap R _ b)
    rw [map_add, hDsadd]
  have hΔmul : ∀ a b, Δ (a * b) =
      algebraMap (Localization.AtPrime q) 𝔓.ResidueField (algebraMap R (Localization.AtPrime q) a) * Δ b +
      algebraMap (Localization.AtPrime q) 𝔓.ResidueField (algebraMap R (Localization.AtPrime q) b) * Δ a := by
    intro a b
    show Ds (algebraMap R _ (a * b)) = _
    rw [map_mul, hDsmul, hψ, hψ]
    rfl
  have hfsO : (algebraMap R (Localization.AtPrime q)).FormallySmooth :=
    RingHom.formallySmooth_algebraMap.mpr inferInstance
  obtain ⟨DO, hDOadd, hDOmul, hDOι⟩ :=
    s1 R (Localization.AtPrime q) 𝔓.ResidueField _ hfsO
      (algebraMap (Localization.AtPrime q) 𝔓.ResidueField) Δ hΔadd hΔmul
  have hstar : ∀ a : T, DO (algebraMap R (Localization.AtPrime q) (ρ a)) = g (ρ (dd a)) := by
    intro a
    rw [hDOι]
    exact hDsf a
  have hDOK : ∀ c : K, DO (algebraMap K (Localization.AtPrime q) c) = 0 := by
    intro c
    rw [IsScalarTower.algebraMap_apply K R (Localization.AtPrime q), ← hρκ, RingHom.comp_apply,
      hstar, hddκ, map_zero, map_zero]
  have hDOζ : ∀ k, DO (algebraMap R (Localization.AtPrime q) (ρ (z k))) = 0 := by
    intro k
    rw [hstar, hddz, map_zero, map_zero]
  have hDOG : DO (algebraMap R (Localization.AtPrime q) (ρ φ)) = 1 := by
    rw [hstar, hddφ, map_one, map_one]

  let DL : Localization.AtPrime q →ₗ[K] 𝔓.ResidueField :=
    { toFun := DO
      map_add' := hDOadd
      map_smul' := fun c x => by
        show DO (c • x) = c • DO x
        rw [Algebra.smul_def c x, Algebra.smul_def c (DO x), hDOmul, hDOK c, mul_zero, add_zero,
          IsScalarTower.algebraMap_apply K (Localization.AtPrime q) 𝔓.ResidueField] }
  let Dd : Derivation K (Localization.AtPrime q) 𝔓.ResidueField :=
    Derivation.mk' DL (fun a b => by
      show DO (a * b) = a • DO b + b • DO a
      rw [hDOmul, Algebra.smul_def a (DO b), Algebra.smul_def b (DO a)])
  let ℓ := Dd.liftKaehlerDifferential
  have hℓ : ∀ x, ℓ (KaehlerDifferential.D K (Localization.AtPrime q) x) = DO x := fun x =>
    Dd.liftKaehlerDifferential_comp_D x
  have hkill : DO (algebraMap R (Localization.AtPrime q) (ρ φ)) = 0 := by
    have e1 : ℓ (KaehlerDifferential.D K (Localization.AtPrime q) (algebraMap R (Localization.AtPrime q) (ρ φ))) =
        ∑ j, b.repr (KaehlerDifferential.D K (Localization.AtPrime q) (algebraMap R (Localization.AtPrime q) (ρ φ))) j •
          ℓ (b j) := by
      conv_lhs => rw [← b.sum_repr (KaehlerDifferential.D K (Localization.AtPrime q) (algebraMap R (Localization.AtPrime q) (ρ φ)))]
      rw [map_sum]
      simp only [map_smul]
    rw [← hℓ, e1, Fintype.sum_sum_type]
    have h1 : ∀ i : Fin n, b.repr (KaehlerDifferential.D K (Localization.AtPrime q) (algebraMap R (Localization.AtPrime q) (ρ φ))) (Sum.inl i) •
        ℓ (b (Sum.inl i)) = 0 := by
      intro i
      have hc : b.repr (KaehlerDifferential.D K (Localization.AtPrime q) (algebraMap R (Localization.AtPrime q) (ρ φ))) (Sum.inl i) ∈ 𝔓 :=
        hcrit i
      rw [Algebra.smul_def, Ideal.algebraMap_residueField_eq_zero.mpr hc, zero_mul]
    have h2 : ∀ k : Fin r, b.repr (KaehlerDifferential.D K (Localization.AtPrime q) (algebraMap R (Localization.AtPrime q) (ρ φ))) (Sum.inr k) •
        ℓ (b (Sum.inr k)) = 0 := by
      intro k
      rw [hb k, hℓ, hDOζ k, smul_zero]
    rw [Finset.sum_eq_zero (fun i _ => h1 i), Finset.sum_eq_zero (fun k _ => h2 k), add_zero]
  exact one_ne_zero (hDOG.symm.trans hkill)

theorem wc_pfam_mc_etale_coords_basis : ∀ (K T : Type u) [Field K] [CommRing T] (κ : K →+* T) (r : ℕ) (φ : T) (z : Fin r → T), RingHom.Etale (MvPolynomial.eval₂Hom κ (fun o : Option (Fin r) => o.elim φ z)) → letI : Algebra K T := κ.toAlgebra; ∃ bT : Module.Basis (Option (Fin r)) T Ω[T⁄K], ∀ o, bT o = KaehlerDifferential.D K T (o.elim φ z) :=
by
  intro K T _ _ κ r φ z hf
  letI : Algebra K T := κ.toAlgebra
  let f := MvPolynomial.eval₂Hom κ (fun o : Option (Fin r) => o.elim φ z)
  letI : Algebra (MvPolynomial (Option (Fin r)) K) T := f.toAlgebra
