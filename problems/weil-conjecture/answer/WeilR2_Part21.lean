        (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C (algebraMap R S a)))
        (Polynomial.X ^ N - Polynomial.C a) = 0 := by
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hrootq]
      show _ - algebraMap R _ a = 0
      rw [AdjoinRoot.algebraMap_eq', RingHom.comp_apply, sub_self]
    let f := AdjoinRoot.liftAlgHom (Polynomial.X ^ N - Polynomial.C a)
      (Algebra.ofId R (AdjoinRoot (Polynomial.X ^ N - Polynomial.C (algebraMap R S a))))
      (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C (algebraMap R S a))) hf
    let g := IsScalarTower.toAlgHom R S (AdjoinRoot (Polynomial.X ^ N - Polynomial.C (algebraMap R S a)))
    let Φ := Algebra.TensorProduct.productMap f g
    have halg : ∀ r : R, AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C a) r ⊗ₜ[R] (1 : S) =
