  haveI hNoeth : IsLocallyNoetherian (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left :=
    @LocallyOfFiniteType.isLocallyNoetherian _ _ (Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hLFT inferInstance
  have hsep : IsSepClosed (IsLocalRing.ResidueField
