    apply linearIndependent_of_top_le_span_of_card_eq_finrank hV.ge
    rw [hcard]; exact le_antisymm hge hle
  have s4 : ∀ (K O : Type u) [CommRing K] [CommRing O] [Algebra K O] (n : ℕ) (δ : Fin n → Derivation K O O) (G : O) (σ : Fin n → O), (∀ i, δ i G = σ i) → G ∈ Ideal.span (Set.range σ) → IsUnit (Matrix.of (fun j i => δ j (σ i))).det → ∃ B' : Matrix (Fin n) (Fin n) O, G = ∑ p, ∑ q, B' p q * σ p * σ q := by
    intro K O _ _ _ n δ G σ hδG hG hJ
    classical
    set I := Ideal.span (Set.range σ) with hI
    set J : Matrix (Fin n) (Fin n) O := Matrix.of (fun j i => δ j (σ i)) with hJdef
    obtain ⟨lam, hlam⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hG
