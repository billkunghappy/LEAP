    ⟨fun y => (ρ (π₀.toLinearMap ∘ₗ G₀ (μ y) ∘ₗ π₀.symm.toLinearMap))⁻¹, fun _ => rfl⟩
  have htr : ∀ (Z : Scheme.{u}) (a b : Z ⟶ Ω₀.W'.left) (hab : a ≫ p = b ≫ p)
      (hab' : a ≫ Ω₀.w'.left = b ≫ Ω₀.w'.left) (z : Z),
      c (Limits.pullback.lift a b hab z) =
        (ρ (π₀.toLinearMap ∘ₗ G₀ (Limits.pullback.lift a b hab' z) ∘ₗ π₀.symm.toLinearMap))⁻¹ := by
    intro Z a b hab hab' z
    have e : Limits.pullback.lift a b hab ≫ μ = Limits.pullback.lift a b hab' := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hμ1, Limits.pullback.lift_fst, Limits.pullback.lift_fst]
      · rw [Category.assoc, hμ2, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    rw [hc, ← Scheme.Hom.comp_apply (Limits.pullback.lift a b hab) μ, e]

  have hcol : ∀ v : Fin Ω₀.r' → ℚ_[ℓ], Continuous (fun z => G₀ z v) := by
    intro v
    have e : ∀ z, G₀ z v = ∑ i, v i • G₀ z (Pi.single i 1) := by
      intro z
      conv_lhs => rw [← Finset.univ_sum_single v]
      rw [map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      have hs : (Pi.single i (v i) : Fin Ω₀.r' → ℚ_[ℓ]) = v i • Pi.single i 1 := by
        ext j
        by_cases hj : j = i
        · subst hj; simp
        · simp [Pi.single_apply, hj]
      rw [hs, map_smul]
    exact (continuous_finset_sum (f := fun i z => v i • G₀ z (Pi.single i 1)) Finset.univ
      (fun i _ => (hGc i).const_smul (v i))).congr (fun z => (e z).symm)
  have hccol : ∀ j : Fin q', Continuous
      (fun z => (π₀.toLinearMap ∘ₗ G₀ z ∘ₗ π₀.symm.toLinearMap) (Pi.single j 1)) := by
    intro j
    have hπc : Continuous π₀.toLinearMap := LinearMap.continuous_of_finiteDimensional _
    exact hπc.comp (hcol (π₀.symm (Pi.single j 1)))
  have hρG : IsLocallyConstant
      (fun z => ρ (π₀.toLinearMap ∘ₗ G₀ z ∘ₗ π₀.symm.toLinearMap)) := by
    rw [IsLocallyConstant.iff_exists_open]
    intro z₁
    obtain ⟨ε, hε, hεc⟩ := hρc _ (hGL z₁)
    refine ⟨⋂ j : Fin q', {z | ‖(π₀.toLinearMap ∘ₗ G₀ z ∘ₗ π₀.symm.toLinearMap) (Pi.single j 1) -
      (π₀.toLinearMap ∘ₗ G₀ z₁ ∘ₗ π₀.symm.toLinearMap) (Pi.single j 1)‖ < ε}, ?_, ?_, ?_⟩
    · exact isOpen_iInter_of_finite
        (fun j => isOpen_lt ((hccol j).sub continuous_const).norm continuous_const)
    · refine Set.mem_iInter.mpr (fun j => ?_)
      show ‖(π₀.toLinearMap ∘ₗ G₀ z₁ ∘ₗ π₀.symm.toLinearMap) (Pi.single j 1) -
        (π₀.toLinearMap ∘ₗ G₀ z₁ ∘ₗ π₀.symm.toLinearMap) (Pi.single j 1)‖ < ε
      rw [sub_self, norm_zero]
      exact hε
    · intro z hz
      exact hεc _ (hGL z) (fun j => Set.mem_iInter.mp hz j)
  have hcl : IsLocallyConstant c := by
    rw [show c = fun y => (ρ (π₀.toLinearMap ∘ₗ G₀ (μ y) ∘ₗ π₀.symm.toLinearMap))⁻¹ from
      funext hc]
    exact (hρG.comp_continuous μ.continuous).comp (fun x => x⁻¹)
  have hcoc : ∀ (Z : Scheme.{u}) (a b d : Z ⟶ Ω₀.W'.left) (hab : a ≫ p = b ≫ p)
      (hbd : b ≫ p = d ≫ p) (had : a ≫ p = d ≫ p) (z : Z),
      c (Limits.pullback.lift a d had z) =
        c (Limits.pullback.lift a b hab z) * c (Limits.pullback.lift b d hbd z) := by
    intro Z a b d hab hbd had z
    rw [htr Z a d had (hw' Z a d had) z, htr Z a b hab (hw' Z a b hab) z,
      htr Z b d hbd (hw' Z b d hbd) z,
      hGd Z a b d (hw' Z a b hab) (hw' Z b d hbd) (hw' Z a d had) z, hconj_comp,
      hρm _ (hGL (Limits.pullback.lift a b (hw' Z a b hab) z)) _
        (hGL (Limits.pullback.lift b d (hw' Z b d hbd) z)), mul_inv_rev]
  have hs9 : ∀ (δ : Ω₀.W' ⟶ Ω₀.W') (g : (Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ]))
      (hδ : δ ≫ Ω₀.w' = Ω₀.w'), wcPfamFrame Ω₀ δ g → ∀ z : Ω₀.W'.left,
      c (Limits.pullback.lift δ.left (𝟙 Ω₀.W'.left) (hdeckp' δ hδ) z) =
        ρ (π₀.toLinearMap ∘ₗ g ∘ₗ π₀.symm.toLinearMap) := by
    intro δ g hδ hg z
    rw [htr _ δ.left (𝟙 Ω₀.W'.left) (hdeckp' δ hδ) (hdeckl δ hδ) z]
    have h1 := hρm _ (hfr δ g hδ hg) _
      (hGL (Limits.pullback.lift δ.left (𝟙 Ω₀.W'.left) (hdeckl δ hδ) z))
    rw [← hconj_comp, hGe δ g (hdeckl δ hδ) hδ hg z, hconj_id, hρ1] at h1
    exact inv_eq_of_mul_eq_one_right h1.symm

  obtain ⟨E, πE, s, hEfin, hEet, -, hsp, hMR, hLOC⟩ :=
    wc_fpqc_gtor_descent Ub.toScheme Ω₀.W'.left p hUc hUq hpflat hpqc hpsurj
      (Multiplicative (AddAut (Fin q' → ZMod (ℓ ^ k)))) c hcl hcoc

  refine ⟨E, πE, s, G₀, hEfin, hEet, ?_, ?_, hGL, hGb, ?_, ?_, ?_⟩
  · intro γ
    rw [← Category.assoc, hsp, hp]
  · intro Z' hZ' a e' he'
    refine hLOC Z' hZ' a e' ?_
    rw [← cancel_mono Ub.ι, Category.assoc, hp, Category.assoc]
    exact he'
  · intro T a b hab γ γ'
    rw [hMR T a b (hp' T a b hab) γ γ']
    refine forall_congr' (fun t => ?_)
    rw [htr T a b (hp' T a b hab) hab t]
  · intro T a t
    have hδ' : 𝟙 Ω₀.W'.left ≫ Ω₀.w'.left = 𝟙 Ω₀.W'.left ≫ Ω₀.w'.left := rfl
    have hid : G₀ (Limits.pullback.lift (𝟙 Ω₀.W'.left) (𝟙 Ω₀.W'.left) hδ' (a t)) ∘ₗ
        LinearMap.id = LinearMap.id :=
      hGe (𝟙 Ω₀.W') LinearMap.id hδ' (Category.id_comp _) (fun _ _ => rfl) (a t)
    rw [LinearMap.comp_id] at hid
    have e : Limits.pullback.lift a a rfl =
        a ≫ Limits.pullback.lift (𝟙 Ω₀.W'.left) (𝟙 Ω₀.W'.left) hδ' := by
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst, Category.comp_id]
      · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd, Category.comp_id]
    rw [e, Scheme.Hom.comp_apply]
    exact hid
  · intro σ₀ g₀ hσ hf γ
    have h := (hMR Ω₀.W'.left σ₀.left (𝟙 Ω₀.W'.left) (hdeckp' σ₀ hσ) γ
      (γ * ρ (π₀.toLinearMap ∘ₗ g₀ ∘ₗ π₀.symm.toLinearMap))).mpr
      (fun z => by rw [hs9 σ₀ g₀ hσ hf z])
    rw [Category.id_comp] at h
    exact h

theorem wc_pfam_strict_local_lift {F'' : Type u} [Field F''] (M' : ℕ) {X : Scheme.{u}}
    (h : X ⟶ wcProjK F'' M') (Δ : Set (wcProjK F'' M')) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (q : ℕ)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ q hPP)
    (Z : (wcProjK F'' M').ProEt) (B : Type u) [CommRing B] [HenselianLocalRing B]
    [IsSepClosed (IsLocalRing.ResidueField B)] (eZ : Z.left ≅ Spec (.of B))
    (x : Z ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (hZ : ∀ z : Z.left, Z.hom z ∉ Δ) :
    ∃ ψ : Z ⟶ Ω.W', ψ ≫ Ω.w' = x :=
by
  classical
  have hx0 : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      (x.left (eZ.inv (IsLocalRing.closedPoint B))) = Z.hom (eZ.inv (IsLocalRing.closedPoint B)) := by
    rw [← MorphismProperty.Over.w x, Scheme.Hom.comp_apply]
  obtain ⟨y, hy⟩ := Ω.hcov' (x.left (eZ.inv (IsLocalRing.closedPoint B)))
    (by rw [hx0]; exact hZ _)
  haveI hPbar : WeaklyEtale (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom :=
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).prop
  haveI : WeaklyEtale (Ω.w'.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) := by
    rw [MorphismProperty.Over.w Ω.w']; exact Ω.W'.prop
  have hw' : WeaklyEtale Ω.w'.left :=
    AlgebraicGeometry.WeaklyEtale.of_comp Ω.w'.left
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
  obtain ⟨t, ht1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := x.left) (g := Ω.w'.left)
    (eZ.inv (IsLocalRing.closedPoint B)) y hy.symm
  have hq : WeaklyEtale (Limits.pullback.fst x.left Ω.w'.left) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale)
      (IsPullback.of_hasPullback x.left Ω.w'.left).flip hw'
  haveI : WeaklyEtale (Limits.pullback.fst x.left Ω.w'.left) := hq
  haveI : WeaklyEtale ((Limits.pullback x.left Ω.w'.left).fromSpecStalk t) :=
    wc_fromSpecStalk_weaklyEtale _ t
  obtain ⟨k, hkdef⟩ : ∃ k, k = (Limits.pullback x.left Ω.w'.left).fromSpecStalk t ≫
      Limits.pullback.fst x.left Ω.w'.left ≫ eZ.hom := ⟨_, rfl⟩
  have hk : WeaklyEtale k := by rw [hkdef]; infer_instance
  have hφ : Spec.map (Spec.preimage k) = k := Spec.map_preimage k
  have hk' : WeaklyEtale (Spec.map (CommRingCat.ofHom (Spec.preimage k).hom)) := by
    change WeaklyEtale (Spec.map (Spec.preimage k))
    rw [hφ]; exact hk
  letI := (Spec.preimage k).hom.toAlgebra
  have hWE := wc_lpkt_specMap_weaklyEtale_ring _ _ (Spec.preimage k).hom hk'
  have hk_pt : k (IsLocalRing.closedPoint ((Limits.pullback x.left Ω.w'.left).presheaf.stalk t)) =
      IsLocalRing.closedPoint B := by
    have h1 : k (IsLocalRing.closedPoint ((Limits.pullback x.left Ω.w'.left).presheaf.stalk t)) =
        eZ.hom ((Limits.pullback.fst x.left Ω.w'.left)
          ((Limits.pullback x.left Ω.w'.left).fromSpecStalk t
          (IsLocalRing.closedPoint ((Limits.pullback x.left Ω.w'.left).presheaf.stalk t)))) := by
      subst hkdef
      first | rfl | simp [Scheme.Hom.comp_apply]
    have h2 : ∀ y : Spec (CommRingCat.of B), eZ.hom (eZ.inv y) = y := by
      intro y
      first
        | simp
        | (rw [← Scheme.Hom.comp_apply, eZ.inv_hom_id]; rfl)
        | exact congrArg (fun f : Spec (CommRingCat.of B) ⟶ Spec (CommRingCat.of B) => f y)
            eZ.inv_hom_id
    rw [h1, Scheme.fromSpecStalk_closedPoint, ht1]
    first
      | exact h2 _
      | simp
  have hcomap : PrimeSpectrum.comap (Spec.preimage k).hom
      (IsLocalRing.closedPoint ((Limits.pullback x.left Ω.w'.left).presheaf.stalk t)) =
      IsLocalRing.closedPoint B := by
    have h5 : (Spec.map (Spec.preimage k))
        (IsLocalRing.closedPoint ((Limits.pullback x.left Ω.w'.left).presheaf.stalk t)) =
        PrimeSpectrum.comap (Spec.preimage k).hom
          (IsLocalRing.closedPoint ((Limits.pullback x.left Ω.w'.left).presheaf.stalk t)) := by
      first | rfl | simp [Spec.map_base]
    rw [← h5, hφ]
    exact hk_pt
  have hloc : IsLocalHom (Spec.preimage k).hom :=
    (IsLocalRing.isLocalHom_iff_comap_closedPoint (Spec.preimage k).hom).mpr hcomap
  have hbij : Function.Bijective (Spec.preimage k).hom :=
    wc_olivier _ _ inferInstance inferInstance hloc hWE
  haveI : IsIso (Spec.preimage k) := (ConcreteCategory.isIso_iff_bijective _).mpr hbij
  haveI hkiso : IsIso k := by
    rw [← hφ]; infer_instance
  have hcq : (Limits.pullback x.left Ω.w'.left).fromSpecStalk t ≫
      Limits.pullback.fst x.left Ω.w'.left = k ≫ eZ.inv := by
    rw [hkdef]; simp
  obtain ⟨s, hs⟩ : ∃ s : Z.left ⟶ Limits.pullback x.left Ω.w'.left,
      s ≫ Limits.pullback.fst x.left Ω.w'.left = 𝟙 _ :=
    ⟨eZ.hom ≫ inv k ≫ (Limits.pullback x.left Ω.w'.left).fromSpecStalk t, by
      rw [Category.assoc, Category.assoc, hcq, IsIso.inv_hom_id_assoc, Iso.hom_inv_id]⟩
  have hh : (s ≫ Limits.pullback.snd x.left Ω.w'.left) ≫ Ω.w'.left = x.left := by
    rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hs, Category.id_comp]
  have hover : (s ≫ Limits.pullback.snd x.left Ω.w'.left) ≫ Ω.W'.hom = Z.hom := by
    rw [← MorphismProperty.Over.w Ω.w', ← Category.assoc, hh, MorphismProperty.Over.w x]
  refine ⟨MorphismProperty.Over.homMk (s ≫ Limits.pullback.snd x.left Ω.w'.left) hover trivial, ?_⟩
  apply MorphismProperty.Over.Hom.ext
  exact hh

theorem wc_pfam_level_cover_tame {F'' : Type u} [Field F''] [Finite F''] {M' : ℕ} {X : Scheme.{u}}
    {h : X ⟶ wcProjK F'' M'} {Δ : Set (wcProjK F'' M')} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {q : ℕ}
    {hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (Ω₀ : wcPfamCover M' h Δ ℓ q hPP)
    (hU₀ : ∀ (Vξ Tξ : (wcProjK F'' M').ProEt) (uξ : Tξ ⟶ Vξ) (cξ : Tξ ⟶ Ω₀.W'),
      wcPfamXiPt Ω₀ uξ cξ → ∀ g ∈ wcPfamInertFr Ω₀ uξ cξ,
        (g - LinearMap.id) ∘ₗ (g - LinearMap.id) = 0)
    (Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens)
    (hUb : ∀ y, y ∈ Ub ↔ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∉ Δ)
    (k q' : ℕ) (π₀ : (Fin Ω₀.r' → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ]))
    (GLs : Set ((Fin q' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ])))
    (hGLs : ∀ g, g ∈ GLs ↔ ∃ g' : (Fin q' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ]),
      g' ∘ₗ g = LinearMap.id ∧ g ∘ₗ g' = LinearMap.id ∧
      ∀ y : Fin q' → ℚ_[ℓ], (∀ i, ‖y i‖ ≤ 1) → (∀ i, ‖g y i‖ ≤ 1) ∧ ∀ i, ‖g' y i‖ ≤ 1)
    (hfr : ∀ (σ₀ : Ω₀.W' ⟶ Ω₀.W') (g₀ : (Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ])),
      σ₀ ≫ Ω₀.w' = Ω₀.w' → wcPfamFrame Ω₀ σ₀ g₀ →
      π₀.toLinearMap ∘ₗ g₀ ∘ₗ π₀.symm.toLinearMap ∈ GLs)
    (Γ : Type) [Group Γ] (ρ : ((Fin q' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ])) → Γ)
    (hρm : ∀ g ∈ GLs, ∀ g' ∈ GLs, ρ (g' ∘ₗ g) = ρ g' * ρ g)
    (hρ3 : ∀ g ∈ GLs, ρ g = 1 ↔ ∀ x : Fin q' → ℚ_[ℓ], (∀ j, ‖x j‖ ≤ 1) →
      ∀ j, ‖g x j - x j‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)))
    (E₀ : Scheme.{u}) (πE₀ : E₀ ⟶ Ub.toScheme) (s₀ : Γ → (Ω₀.W'.left ⟶ E₀))
    (hSh : ∀ γ, s₀ γ ≫ πE₀ ≫ Ub.ι = Ω₀.w'.left)
    (hLOC : ∀ (Z' : Scheme.{u}), ConnectedSpace Z' → ∀ (a : Z' ⟶ Ω₀.W'.left) (e' : Z' ⟶ E₀),
      a ≫ Ω₀.w'.left = e' ≫ πE₀ ≫ Ub.ι → ∃ γ, e' = a ≫ s₀ γ)
    (hDk : ∀ (σ₀ : Ω₀.W' ⟶ Ω₀.W') (g₀ : (Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ])),
      σ₀ ≫ Ω₀.w' = Ω₀.w' → wcPfamFrame Ω₀ σ₀ g₀ → ∀ γ,
      σ₀.left ≫ s₀ γ = s₀ (γ * ρ (π₀.toLinearMap ∘ₗ g₀ ∘ₗ π₀.symm.toLinearMap)))
    (O : E₀.Opens) :
    wcPfamEllTame M' Δ ℓ hPP Ub (O.ι ≫ πE₀) :=
by
  classical

  have s1 : ∀ (L : Type u) [Field L] [IsSepClosed L],
      IsSepClosed (IsLocalRing.ResidueField L) := by
    intro L _ _
    have hinj : Function.Injective (IsLocalRing.residue L) := (IsLocalRing.residue L).injective
    let e : L ≃+* IsLocalRing.ResidueField L :=
      RingEquiv.ofBijective (IsLocalRing.residue L) ⟨hinj, IsLocalRing.residue_surjective⟩
    apply IsSepClosed.of_exists_root
    intro p _ hirr hsep
    set p' := p.map e.symm.toRingHom with hp'
    have hsep' : p'.Separable := hsep.map
    have hdeg : p'.degree ≠ 0 := by
      rw [hp', Polynomial.degree_map]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨y, hy⟩ := IsSepClosed.exists_root p' hdeg hsep'
    have hy' : Polynomial.eval y p' = 0 := hy
    refine ⟨e y, ?_⟩
    have hp : p = p'.map e.toRingHom := by
      rw [hp', Polynomial.map_map, RingEquiv.toRingHom_comp_symm_toRingHom, Polynomial.map_id]
    rw [hp, Polynomial.eval_map]
    show Polynomial.eval₂ e.toRingHom (e.toRingHom y) p' = 0
    rw [Polynomial.eval₂_at_apply, hy', map_zero]

  have s2 : ∀ (g₀ : (Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ])),
      (g₀ - LinearMap.id) ∘ₗ (g₀ - LinearMap.id) = 0 →
      π₀.toLinearMap ∘ₗ g₀ ∘ₗ π₀.symm.toLinearMap ∈ GLs →
      ρ (π₀.toLinearMap ∘ₗ g₀ ∘ₗ π₀.symm.toLinearMap) ^ (ℓ ^ k) = 1 := by
    intro g₀ hg₀ hmem
    set G := π₀.toLinearMap ∘ₗ g₀ ∘ₗ π₀.symm.toLinearMap with hG
    have hGz : ∀ z, G z = π₀ (g₀ (π₀.symm z)) := fun z => rfl
    have hid : (LinearMap.id : (Fin q' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ])) ∈ GLs :=
      (hGLs _).2 ⟨LinearMap.id, rfl, rfl, fun y hy => ⟨hy, hy⟩⟩
    have hmul : ∀ a ∈ GLs, ∀ b ∈ GLs, b ∘ₗ a ∈ GLs := by
      intro g hg g' hg'
      obtain ⟨a, ha1, ha2, ha3⟩ := (hGLs g).1 hg
      obtain ⟨b, hb1, hb2, hb3⟩ := (hGLs g').1 hg'
      refine (hGLs _).2 ⟨a ∘ₗ b, LinearMap.ext fun x => ?_, LinearMap.ext fun x => ?_,
        fun y hy => ⟨fun i => (hb3 (g y) (ha3 y hy).1).1 i, fun i => (ha3 (b y) (hb3 y hy).2).2 i⟩⟩
      · show a (b (g' (g x))) = x
        rw [show b (g' (g x)) = g x from LinearMap.congr_fun hb1 (g x)]
        exact LinearMap.congr_fun ha1 x
      · show g' (g (a (b x))) = x
        rw [show g (a (b x)) = b x from LinearMap.congr_fun ha2 (b x)]
        exact LinearMap.congr_fun hb2 x
    have hρid : ρ LinearMap.id = 1 := by
      rw [hρ3 _ hid]
      intro x _ j
      simp only [LinearMap.id_apply, sub_self, norm_zero]
      positivity
    have hN : ∀ y, G (G y - y) = G y - y := by
      intro y
      have h1 := LinearMap.congr_fun hg₀ (π₀.symm y)
      simp only [LinearMap.comp_apply, LinearMap.sub_apply, LinearMap.id_apply,
        LinearMap.zero_apply] at h1
      have e1 : G y - y = π₀ (g₀ (π₀.symm y) - π₀.symm y) := by
        rw [hGz, map_sub, LinearEquiv.apply_symm_apply]
      rw [← sub_eq_zero, e1, hGz, LinearEquiv.symm_apply_apply, ← map_sub, h1, map_zero]
    have hpow : ∀ m : ℕ, G ^ m ∈ GLs ∧ ρ (G ^ m) = ρ G ^ m ∧
        ∀ y, (G ^ m) y = y + (m : ℚ_[ℓ]) • (G y - y) := by
      intro m
      induction m with
      | zero =>
        refine ⟨?_, ?_, fun y => by simp⟩
        · rw [pow_zero]; exact hid
        · rw [pow_zero, pow_zero]; exact hρid
      | succ m ih =>
        obtain ⟨h1, h2, h3⟩ := ih
        have e : G ^ (m + 1) = G ∘ₗ G ^ m := by rw [pow_succ', Module.End.mul_eq_comp]
        refine ⟨by rw [e]; exact hmul _ h1 _ hmem, by rw [e, hρm _ h1 _ hmem, h2, pow_succ'],
          fun y => ?_⟩
        rw [e, LinearMap.comp_apply, h3, map_add, map_smul, hN y, Nat.cast_succ, add_smul,
          one_smul]
        abel
    obtain ⟨hm1, hm2, hm3⟩ := hpow (ℓ ^ k)
    rw [← hm2, hρ3 _ hm1]
    intro x hx j
    rw [hm3]
    have hGx : ∀ i, ‖G x i‖ ≤ 1 := (((hGLs G).1 hmem).choose_spec.2.2 x hx).1
    have hNx : ‖G x j - x j‖ ≤ 1 := by
      rw [sub_eq_add_neg]
      refine (IsUltrametricDist.norm_add_le_max _ _).trans ?_
      rw [norm_neg]
      exact max_le (hGx j) (hx j)
    simp only [Pi.add_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul, add_sub_cancel_left]
    rw [norm_mul, Nat.cast_pow, Padic.norm_p_pow]
    exact mul_le_of_le_one_right (by positivity) hNx

  have s3 : ∀ {T W E : Scheme.{u}} (ι : E ⟶ E₀) [Mono ι] (τ : T ⟶ T) (c : T ⟶ W) (σ : W ⟶ W)
      (_ : τ ≫ c = c ≫ σ) (s : Γ → (W ⟶ E₀)) (δ : Γ) (_ : ∀ γ, σ ≫ s γ = s (γ * δ))
      (x : T ⟶ E) (γ : Γ) (_ : x ≫ ι = c ≫ s γ) (N : ℕ) (_ : δ ^ N = 1),
      (fun f : T ⟶ E => τ ≫ f)^[N] x = x := by
    intro T W E ι _ τ c σ hτc s δ hs x γ hx N hN
    have key : ∀ m : ℕ, ((fun f : T ⟶ E => τ ≫ f)^[m] x) ≫ ι = c ≫ s (γ * δ ^ m) := by
      intro m
      induction m with
      | zero => simpa using hx
      | succ m ih =>
        rw [Function.iterate_succ_apply']
        rw [Category.assoc, ih, ← Category.assoc, hτc, Category.assoc, hs, mul_assoc, ← pow_succ]
    apply (cancel_mono ι).1
    rw [key, hN, mul_one, hx]

  unfold wcPfamEllTame
  intro V T₀ u v A _ _ _ e L₀ _ _ eT hξ hclos τ hτu x hx
  refine ⟨k, ?_⟩
  have hconnT : ConnectedSpace T₀.left := by
    have hsub : ∀ a b : T₀.left, a = b := by
      intro a b
      have h1 : eT.hom a = eT.hom b :=
        @Subsingleton.elim (PrimeSpectrum L₀) inferInstance (eT.hom a) (eT.hom b)
      have ha : eT.inv (eT.hom a) = a := by simp
      have hb : eT.inv (eT.hom b) = b := by simp
      rw [← ha, ← hb, h1]
    haveI : Nonempty T₀.left := ⟨eT.inv (IsLocalRing.closedPoint L₀)⟩
    rw [connectedSpace_iff_univ]
    exact ⟨Set.univ_nonempty, Set.Subsingleton.isPreconnected (fun a _ b _ => hsub a b)⟩
  have hoff : ∀ z : T₀.left, T₀.hom z ∉ Δ := by
    intro z
    have h1 : (x ≫ (O.ι ≫ πE₀) ≫ Ub.ι) z = (u.left ≫ v.left) z := by rw [hx]
    have hmem : (u.left ≫ v.left) z ∈ (Ub : Set _) := by
      rw [← Scheme.Opens.range_ι, ← h1]
      exact ⟨((x ≫ O.ι) ≫ πE₀) z, by simp only [Scheme.Hom.comp_apply]⟩
    have h2 := (hUb _).1 hmem
    have hwv : v.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom = V.hom :=
      MorphismProperty.Over.w v
    have hwu : u.left ≫ V.hom = T₀.hom := MorphismProperty.Over.w u
    have hw : (u.left ≫ v.left) ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
        T₀.hom := by rw [Category.assoc, hwv, hwu]
    rw [← hw]
    simpa only [Scheme.Hom.comp_apply] using h2
  haveI : IsSepClosed (IsLocalRing.ResidueField L₀) := s1 L₀
  obtain ⟨c₀, hc₀⟩ := wc_pfam_strict_local_lift M' h Δ ℓ q hPP Ω₀ T₀ L₀ eT (u ≫ v) hoff
  have hτc₀ : c₀ ≫ Ω₀.w' = (τ ≫ c₀) ≫ Ω₀.w' := by
    rw [Category.assoc, hc₀, ← Category.assoc, hτu]
  obtain ⟨σ₀, hσ₀, hτc⟩ := Ω₀.hgal' T₀ c₀ (τ ≫ c₀) hconnT hτc₀
  obtain ⟨g₀, hg⟩ := wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ q) Ω₀.W'
    Ω₀.hconn' Ω₀.r' Ω₀.θ' σ₀
  have hfr0 : wcPfamFrame Ω₀ σ₀ g₀ := fun s z =>
    hg Ω₀.W' (𝟙 Ω₀.W') σ₀ (Category.id_comp σ₀).symm s z
  have hXi : wcPfamXiPt Ω₀ u c₀ := by
    unfold wcPfamXiPt
    exact ⟨v, A, inferInstance, inferInstance, inferInstance, e, L₀, inferInstance,
      inferInstance, eT, hc₀.symm, hξ, hclos⟩
  have hIn : g₀ ∈ wcPfamInertFr Ω₀ u c₀ := by
    unfold wcPfamInertFr
    exact ⟨τ, σ₀, hτu, hσ₀, hτc, hfr0⟩
  have hN := hU₀ V T₀ u c₀ hXi g₀ hIn
  have hmem := hfr σ₀ g₀ hσ₀ hfr0
  have hord := s2 g₀ hN hmem
  have hc₀l : c₀.left ≫ Ω₀.w'.left = u.left ≫ v.left := congrArg (fun f => f.left) hc₀
  obtain ⟨γ, hγ⟩ := hLOC T₀.left hconnT c₀.left (x ≫ O.ι)
    (by rw [hc₀l, ← hx]; simp only [Category.assoc])
  have hτcl : τ.left ≫ c₀.left = c₀.left ≫ σ₀.left := congrArg (fun f => f.left) hτc
  exact s3 O.ι τ.left c₀.left σ₀.left hτcl s₀ _ (hDk σ₀ g₀ hσ₀ hfr0) x γ hγ (ℓ ^ k) hord

theorem wc_pfam_level_transport {F'' : Type u} [Field F''] [Finite F''] {M' : ℕ} {X : Scheme.{u}}
    {h : X ⟶ wcProjK F'' M'} {Δ : Set (wcProjK F'' M')} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {q : ℕ}
    {hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (Ω Ω₀ : wcPfamCover M' h Δ ℓ q hPP) (hqc₀ : QuasiCompact Ω₀.w'.left)
    (Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens)
    (hUb : ∀ y, y ∈ Ub ↔ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∉ Δ)
    (q' : ℕ) (π₀ : (Fin Ω₀.r' → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ]))
    (GLs : Set ((Fin q' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ])))
    (hGLs : ∀ g, g ∈ GLs ↔ ∃ g' : (Fin q' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ]),
      g' ∘ₗ g = LinearMap.id ∧ g ∘ₗ g' = LinearMap.id ∧
      ∀ y : Fin q' → ℚ_[ℓ], (∀ i, ‖y i‖ ≤ 1) → (∀ i, ‖g y i‖ ≤ 1) ∧ ∀ i, ‖g' y i‖ ≤ 1)
    (hfr : ∀ (σ₀ : Ω₀.W' ⟶ Ω₀.W') (g₀ : (Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ])),
      σ₀ ≫ Ω₀.w' = Ω₀.w' → wcPfamFrame Ω₀ σ₀ g₀ →
      π₀.toLinearMap ∘ₗ g₀ ∘ₗ π₀.symm.toLinearMap ∈ GLs) :
    ∃ K₀ : (Fin Ω.r' → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ]),
      (∀ (σ : Ω.W' ⟶ Ω.W') (g : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
        σ ≫ Ω.w' = Ω.w' → wcPfamFrame Ω σ g →
        K₀.toLinearMap ∘ₗ g ∘ₗ K₀.symm.toLinearMap ∈ GLs) ∧
      ∀ (Γ : Type) [Group Γ] (ρ : ((Fin q' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ])) → Γ),
        ρ LinearMap.id = 1 → (∀ g ∈ GLs, ∀ g' ∈ GLs, ρ (g' ∘ₗ g) = ρ g' * ρ g) →
        (∀ g ∈ GLs, ∃ ε : ℝ, 0 < ε ∧ ∀ g' ∈ GLs,
          (∀ j : Fin q', ‖g' (Pi.single j 1) - g (Pi.single j 1)‖ < ε) → ρ g' = ρ g) →
        ∀ (E₀ : Scheme.{u}) (πE₀ : E₀ ⟶ Ub.toScheme) (s₀ : Γ → (Ω₀.W'.left ⟶ E₀))
          (G₀ : ↥(Limits.pullback Ω₀.w'.left Ω₀.w'.left) →
            ((Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ]))),
          (∀ γ, s₀ γ ≫ πE₀ ≫ Ub.ι = Ω₀.w'.left) →
          (∀ z, π₀.toLinearMap ∘ₗ G₀ z ∘ₗ π₀.symm.toLinearMap ∈ GLs) →
          (∀ (V : (wcProjK F'' M').ProEt) (a b : V ⟶ Ω₀.W')
            (hl : a.left ≫ Ω₀.w'.left = b.left ≫ Ω₀.w'.left)
            (x : (wcRq h ℓ q).obj.obj (Opposite.op V)) (t : V.left),
            (show C(↥V.left, Fin Ω₀.r' → ℚ_[ℓ]) from
              ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) t =
            G₀ (Limits.pullback.lift a.left b.left hl t)
              ((show C(↥V.left, Fin Ω₀.r' → ℚ_[ℓ]) from
                ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) t)) →
          (∀ (T : Scheme.{u}) (a b : T ⟶ Ω₀.W'.left) (hab : a ≫ Ω₀.w'.left = b ≫ Ω₀.w'.left)
            (γ γ' : Γ), a ≫ s₀ γ = b ≫ s₀ γ' ↔ ∀ t : T, γ' = γ * (ρ (π₀.toLinearMap ∘ₗ
              G₀ (Limits.pullback.lift a b hab t) ∘ₗ π₀.symm.toLinearMap))⁻¹) →
          (∀ (T : Scheme.{u}) (a : T ⟶ Ω₀.W'.left) (t : T),
            G₀ (Limits.pullback.lift a a rfl t) = LinearMap.id) →
          ∃ e : Ω.W'.left ⟶ E₀, e ≫ πE₀ ≫ Ub.ι = Ω.w'.left ∧
            ∀ (σ₁ σ₂ : Ω.W' ⟶ Ω.W') (g₁ g₂ : (Fin Ω.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
              σ₁ ≫ Ω.w' = Ω.w' → σ₂ ≫ Ω.w' = Ω.w' → wcPfamFrame Ω σ₁ g₁ → wcPfamFrame Ω σ₂ g₂ →
              ∀ (Z : Scheme.{u}) (t : Z ⟶ Ω.W'.left), Nonempty Z →
                t ≫ σ₁.left ≫ e = t ≫ σ₂.left ≫ e →
                ρ (K₀.toLinearMap ∘ₗ g₁ ∘ₗ K₀.symm.toLinearMap) =
                  ρ (K₀.toLinearMap ∘ₗ g₂ ∘ₗ K₀.symm.toLinearMap) :=
by
  classical
  haveI := Ω.hconn'



  have L_glue : ∀ {Y E : Scheme.{u}} {Γ : Type} (β : ↥Y → Γ), IsLocallyConstant β →
      ∀ hh : Γ → (Y ⟶ E), ∃ φ : Y ⟶ E, ∀ (T : Scheme.{u}) (a : T ⟶ Y) (γ : Γ),
        (∀ t, β (a t) = γ) → a ≫ φ = a ≫ hh γ := by
    intro Y E Γ β hβ hh
    let U : Γ → Y.Opens := fun γ => ⟨{x | β x = γ}, hβ.isOpen_fiber γ⟩
    have hU : TopologicalSpace.IsOpenCover U :=
      TopologicalSpace.IsOpenCover.mk (by
        rw [eq_top_iff]
        intro x _
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨β x, rfl⟩)
    have hr : ∀ γ : Γ, Set.range (U γ).ι = {x | β x = γ} := by
      intro γ
      rw [Scheme.Opens.range_ι]
      rfl
    let 𝒰 := Y.openCoverOfIsOpenCover U hU
    let f : ∀ γ : 𝒰.I₀, 𝒰.X γ ⟶ E := fun γ => (U γ).ι ≫ hh γ
    have hfc' : ∀ x y : Γ, Limits.pullback.fst (U x).ι (U y).ι ≫ (U x).ι ≫ hh x =
        Limits.pullback.snd (U x).ι (U y).ι ≫ (U y).ι ≫ hh y := by
      intro x y
      by_cases hxy : x = y
      · subst hxy
        rw [← Category.assoc, ← Category.assoc, Limits.pullback.condition]
      · haveI : IsEmpty ↥(Limits.pullback (U x).ι (U y).ι) := by
          apply Scheme.isEmpty_pullback
          rw [hr, hr]
          exact Set.disjoint_left.mpr (fun a ha hb => hxy (ha.symm.trans hb))
        exact isInitialOfIsEmpty.hom_ext _ _
    have hfc : ∀ x y : 𝒰.I₀, Limits.pullback.fst (𝒰.f x) (𝒰.f y) ≫ f x =
        Limits.pullback.snd (𝒰.f x) (𝒰.f y) ≫ f y := fun x y => hfc' x y
    refine ⟨𝒰.glueMorphisms f hfc, ?_⟩
    intro T a γ ha
    have hsub : Set.range a ⊆ Set.range (U γ).ι := by
      rw [hr]; rintro _ ⟨t, rfl⟩; exact ha t
    have hfac := IsOpenImmersion.lift_fac (U γ).ι a hsub
    have hg : (U γ).ι ≫ 𝒰.glueMorphisms f hfc = (U γ).ι ≫ hh γ :=
      Scheme.Cover.ι_glueMorphisms 𝒰 f hfc γ
    rw [← hfac, Category.assoc, Category.assoc, hg]
  have L_ext : ∀ {Y E : Scheme.{u}} {Γ : Type} (β : ↥Y → Γ), IsLocallyConstant β →
      ∀ f₁ f₂ : Y ⟶ E, (∀ (T : Scheme.{u}) (a : T ⟶ Y) (γ : Γ),
        (∀ t, β (a t) = γ) → a ≫ f₁ = a ≫ f₂) → f₁ = f₂ := by
    intro Y E Γ β hβ f₁ f₂ H
    let U : Γ → Y.Opens := fun γ => ⟨{x | β x = γ}, hβ.isOpen_fiber γ⟩
    have hU : TopologicalSpace.IsOpenCover U :=
      TopologicalSpace.IsOpenCover.mk (by
        rw [eq_top_iff]
        intro x _
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨β x, rfl⟩)
    refine Scheme.Cover.hom_ext (Y.openCoverOfIsOpenCover U hU) f₁ f₂ (fun γ => ?_)
    show (U γ).ι ≫ f₁ = (U γ).ι ≫ f₂
    refine H _ _ γ (fun t => ?_)
    have : (U γ).ι t ∈ Set.range (U γ).ι := ⟨t, rfl⟩
    rw [Scheme.Opens.range_ι] at this
    exact this
  have L_desc : ∀ {X₁ T₁ Y₁ : Scheme.{u}} (p : X₁ ⟶ T₁), Flat p → QuasiCompact p → Surjective p →
      ∀ (s : X₁ ⟶ Y₁), (∀ (Z₁ : Scheme.{u}) (a b : Z₁ ⟶ X₁), a ≫ p = b ≫ p → a ≫ s = b ≫ s) →
      ∃ φ : T₁ ⟶ Y₁, p ≫ φ = s := by
    intro X₁ T₁ Y₁ p hpf hpq hps s hs
    haveI := hpf
    haveI := hpq
    haveI := hps
    have hsh : Presieve.IsSheaf Scheme.fpqcTopology (yoneda.obj Y₁) :=
      GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _
    have hcov' : Sieve.generate (Presieve.ofArrows (fun _ : Unit => X₁) (fun _ => p)) ∈
        Scheme.fpqcTopology T₁ := by
      apply Precoverage.generate_mem_toGrothendieck
      refine ⟨?_, ?_⟩
      · have hqcc : QuasiCompactCover (PreZeroHypercover.mk Unit (fun _ : Unit => X₁)
            (fun _ => p)) := by
          rw [quasiCompactCover_iff]
          intro V' hV'
          refine IsCompactOpenCovered.of_finite (κ := Unit) id (fun _ => p ⁻¹ᵁ V') ?_ ?_
          · intro i
            exact p.isCompact_preimage hV'.isCompact
          · apply Set.Subset.antisymm
            · intro y hy
              obtain ⟨i, x, hx, rfl⟩ := Set.mem_iUnion.mp hy
              exact hx
            · intro y hy
              obtain ⟨x, rfl⟩ := Surjective.surj (f := p) y
              exact Set.mem_iUnion.mpr ⟨(), x, hy, rfl⟩
        exact (Scheme.presieve₀_mem_qcPrecoverage_iff
          (E := PreZeroHypercover.mk Unit (fun _ : Unit => X₁) (fun _ => p))).mpr hqcc
      · exact (Scheme.ofArrows_mem_precoverage_iff (P := @Flat)).2
          ⟨fun x => ⟨(), Surjective.surj (f := p) x⟩, fun _ => hpf⟩
    obtain ⟨φ, hφ, -⟩ := (Presieve.isSheafFor_arrows_iff (yoneda.obj Y₁)
      (fun _ : Unit => p)).mp (hsh.isSheafFor _ hcov') (fun _ => s)
      (fun _ _ Z₁ a b hab => hs Z₁ a b hab)
    exact ⟨φ, hφ ()⟩
  have L_point : ∀ {Zs Y₁ X₁ : Scheme.{u}} (t : Zs ⟶ Y₁) (p : X₁ ⟶ Y₁),
      Function.Surjective p → Nonempty Zs →
      ∃ (P : Scheme.{u}) (y' : P ⟶ X₁) (f : P ⟶ Zs) (y : X₁),
        Nonempty P ∧ y' ≫ p = f ≫ t ∧ ∀ s : P, y' s = y := by
    intro Zs Y₁ X₁ t p hp hZ
    obtain ⟨s₀⟩ := hZ
    obtain ⟨y, hy⟩ := hp (t s₀)
    obtain ⟨pt⟩ : Nonempty (Spec (X₁.residueField y)) := inferInstance
    have hf : t s₀ = (X₁.fromSpecResidueField y ≫ p) pt := by
      rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply, hy]
    obtain ⟨w, -, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := t) (g := X₁.fromSpecResidueField y ≫ p) s₀ pt hf
    refine ⟨Limits.pullback t (X₁.fromSpecResidueField y ≫ p),
      Limits.pullback.snd _ _ ≫ X₁.fromSpecResidueField y, Limits.pullback.fst _ _, y, ⟨w⟩, ?_, ?_⟩
    · rw [Category.assoc, ← Limits.pullback.condition]
    · intro s
      rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]



  have hext : ∀ (Ω₁ : wcPfamCover M' h Δ ℓ q hPP) (σ : Ω₁.W' ⟶ Ω₁.W')
      (g : (Fin Ω₁.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₁.r' → ℚ_[ℓ])), wcPfamFrame Ω₁ σ g →
      ∀ (V : (wcProjK F'' M').ProEt) (a : V ⟶ Ω₁.W')
        (x : (wcRq h ℓ q).obj.obj (Opposite.op V)) (t : V.left),
        (show C(↥V.left, Fin Ω₁.r' → ℚ_[ℓ]) from
          ((Ω₁.θ'.hom.hom.app (Opposite.op (Over.mk (a ≫ σ)))).hom x).down) t =
        g ((show C(↥V.left, Fin Ω₁.r' → ℚ_[ℓ]) from
          ((Ω₁.θ'.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) t) := by
    intro Ω₁ σ g hfr₁ V a x t
    obtain ⟨B, hB⟩ := wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ q) Ω₁.W'
      Ω₁.hconn' Ω₁.r' Ω₁.θ' σ
    have hBg : B = g := by
      apply LinearMap.ext
      intro v
      obtain ⟨z₀⟩ := @ConnectedSpace.toNonempty _ _ Ω₁.hconn'
      let c : (wcContSheaf (wcProjK F'' M') (Fin Ω₁.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω₁.W') :=
        (show (wcContSheaf (wcProjK F'' M') (Fin Ω₁.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω₁.W') from
          ULift.up (ContinuousMap.const ↥Ω₁.W'.left v))
      have hc : (show C(↥Ω₁.W'.left, Fin Ω₁.r' → ℚ_[ℓ]) from
          ((Ω₁.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω₁.W')))).hom
            ((Ω₁.θ'.inv.hom.app (Opposite.op (Over.mk (𝟙 Ω₁.W')))).hom c)).down) z₀ = v := by
        have hs := congrArg (fun m => (m.hom.app (Opposite.op (Over.mk (𝟙 Ω₁.W')))).hom c)
          Ω₁.θ'.inv_hom_id
        exact congrArg (fun y : ULift.{u+1} C(↥Ω₁.W'.left, Fin Ω₁.r' → ℚ_[ℓ]) => y.down z₀) hs
      have e1 := hB Ω₁.W' (𝟙 Ω₁.W') σ (Category.id_comp σ).symm
        ((Ω₁.θ'.inv.hom.app (Opposite.op (Over.mk (𝟙 Ω₁.W')))).hom c) z₀
      have e2 := hfr₁ ((Ω₁.θ'.inv.hom.app (Opposite.op (Over.mk (𝟙 Ω₁.W')))).hom c) z₀
      exact (congrArg B hc.symm).trans (e1.symm.trans (e2.trans (congrArg g hc)))
    rw [← hBg]
    exact hB V a (a ≫ σ) rfl x t



