    · left
      obtain ⟨U, hxU, hsmU⟩ := hW
      intro B _ _ _ Λ' _ _ W'' φ' a' hB b hb
      exact (wc_smooth_open_shens_milnor_fibre_acyclic A' _
        (Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) U hsmU (ℓ ^ k) hmu x₀ hxU hx₀ B Λ' W'' φ' a' hB
        Ω ξ).2 b hb
    · right
      have hWo : IsOpen {x : ↥(Limits.pullback h (e'.inv ≫ Vξ.hom)) |
          ∃ U : (Limits.pullback h (e'.inv ≫ Vξ.hom)).Opens,
            x ∈ U ∧ Smooth (U.ι ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom))} := by
        rw [isOpen_iff_forall_mem_open]
        rintro x ⟨U, hxU, hsmU⟩
        refine ⟨(U : Set ↥(Limits.pullback h (e'.inv ≫ Vξ.hom))), fun y hy => ?_, U.isOpen, hxU⟩
        exact show ∃ V : (Limits.pullback h (e'.inv ≫ Vξ.hom)).Opens,
