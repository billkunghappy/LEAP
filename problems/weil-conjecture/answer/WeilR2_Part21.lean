    · obtain ⟨M, rfl⟩ : ∃ M, N = M + 1 := ⟨N - 1, by omega⟩
      exact hlow 0 M s r hs1 hr (by rw [zero_add]; exact hsr)
  have wc_plt_hlgc_cofinal : ∃ W : ℕ, 1 ≤ W ∧ ∀ (k : ℕ) (r : R), (∀ j < k * W, GradedRing.proj 𝒜 j r = 0) → r ∈ (HomogeneousIdeal.irrelevant 𝒜).toIdeal ^ k := by
    classical
    have PF : ∀ (a b : R) (n : ℕ), GradedRing.proj 𝒜 n (a * b) =
