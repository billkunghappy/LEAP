  have hcoker : ∀ p : ℕ, Subsingleton (@Abelian.Ext
      (SheafOfModules.{u+1} (wcEtZModRing Y m)) _ _
      (HasExt.standard _) (SheafOfModules.unit (wcEtZModRing Y m))
      (Limits.cokernel (wcEtSuppUnitMap D')) p) := by
    refine wc_et_module_ext_vanish_of_closed_fibre_stalks A Y f m hm0 _ ?_
    intro p hp
    refine (wc_et_supp_unit_ker_coker_stalks_of_milnor_h0 A Y f m hm0 Ω z D' p ?_).2
    intro B₁ _ _ _ Λ₁ _ _ W₁ φ₁ a₁ hB₁
    exact (hloc p hp B₁ Λ₁ W₁ φ₁ a₁ hB₁).1
  have H1 := @wc_ext_postcomp_bij_of_ker_coker_acyclic _ _ _ (HasExt.standard _)
    (SheafOfModules.unit (wcEtZModRing Y m))
    (SheafOfModules.unit (wcEtZModRing Y m)) _
    (wcEtSuppUnitMap D') hker hcoker

  have H2 : ∀ q : ℕ, 1 ≤ q → q + 1 ≤ N → ∀ p : ℕ, Subsingleton (@Abelian.Ext
      (SheafOfModules.{u+1} (wcEtZModRing Y m)) _ _ (HasExt.standard _)
      (SheafOfModules.unit (wcEtZModRing Y m))
      ((((@SheafOfModules.pushforward _ _ _ _ _ _
        (wcEtBaseChange (Limits.pullback.fst f z)) _ _
        D'.cont D'.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) p) := by
    intro q hq1 hq2
    refine wc_et_module_ext_vanish_of_closed_fibre_stalks A Y f m hm0 _ ?_
    intro p hp
    refine wc_et_module_push_stalk_vanish_of_milnor_deg A Y f m hm0 Ω z D' I p q ?_
    intro B₁ _ _ _ Λ₁ _ _ W₁ φ₁ a₁ hB₁
    exact (hloc p hp B₁ Λ₁ W₁ φ₁ a₁ hB₁).2 q hq1 hq2

  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback f z) m)) := HasExt.standard _
  obtain ⟨c, hc, rfl⟩ := I.extMk_surjective y (N + 1) rfl
  have hf : D'.adj.homEquiv _ _ (D'.μ.hom ≫ c) ≫ (((@SheafOfModules.pushforward _ _ _ _ _ _
        (wcEtBaseChange (Limits.pullback.fst f z)) _ _
        D'.cont D'.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d
        N (N + 1) = 0 := by
    rw [Functor.mapHomologicalComplex_obj_d, ← Adjunction.homEquiv_naturality_right,
      Category.assoc, hc, Limits.comp_zero, Adjunction.homEquiv_unit, Functor.map_zero,
      Limits.comp_zero]

  have hκ0 : (((@SheafOfModules.pushforward _ _ _ _ _ _
        (wcEtBaseChange (Limits.pullback.fst f z)) _ _
        D'.cont D'.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).liftCycles
        (D'.adj.homEquiv _ _ (D'.μ.hom ≫ c)) (N + 1) (by simp) hf ≫
      (((@SheafOfModules.pushforward _ _ _ _ _ _
        (wcEtBaseChange (Limits.pullback.fst f z)) _ _
        D'.cont D'.φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyπ
        N = 0 := by
    refine wc_et_module_hom_unit_eq_zero_of_closed_stalks A Y f m hm0 _ _ ?_
    intro p hp
    by_cases hpx : p = x₀
    · subst hpx
      exact wc_et_edge_germ_vanish_of_milnor_restr A Y f m hm0
        Ω z D' I _ B Λ W' φ a' hB r hr₁ hr₂ Dr N c hc hf hz
    · obtain ⟨U, hpU, hsmU⟩ := hsm p hp hpx
      have hsub := wc_et_module_push_stalk_vanish_of_milnor_deg A Y f m hm0 Ω z D' I p N (by
          intro B₁ _ _ _ Λ₁ _ _ W₁ φ₁ a₁ hB₁
          exact (wc_smooth_open_shens_milnor_fibre_acyclic A Y f U hsmU
            m hmu p hpU hp B₁ Λ₁ W₁ φ₁ a₁ hB₁ Ω z).2 N hN)
      ext s
      exact @Subsingleton.elim _ hsub _ _

  obtain ⟨w, hw⟩ := wc_ext_leray_edge_ker_le_pull_range D'.Φ _ D'.adj (SheafOfModules.unit _)
    (SheafOfModules.unit _) D'.μ H1 I N hN H2 c hc hf hκ0
  exact ⟨w, hw⟩

theorem wc_pfam_xwt_sp_torsion_coker_cyclic (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (j : Fin D.m) (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : Vy.left ≅ Spec (.of A))
    (hVy : Vy.hom (e.inv (IsLocalRing.closedPoint A)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (L : Type u) [Field L] [IsSepClosed L] (eL : Ty.left ≅ Spec (.of L))
    (Vξ : (wcProjK F'' M').ProEt) (ι : Vξ ⟶ Vy) (uξ : Ty ⟶ Vξ)
    (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    (e' : Vξ.left ≅ Spec (.of A')) (hιu : uξ ≫ ι = uy)
    (hΔξ : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      ((ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))) ∈ Δ)
    (hclξ : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
      y ∈ closure {(ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))})
    (k : ℕ) (hk : 1 ≤ k) (Dk : wcZModPullData ((wcProEtPullback h).map uξ).left (ℓ ^ k))
    (hDk : wcZModPullCanonical Dk) :
    ∀ z₁ z₂ : wcZModProEtExt ((wcProEtPullback h).obj Ty).left (ℓ ^ k) (n - 1),
      ∃ e₁ e₂ : ZMod (ℓ ^ k), (IsUnit e₁ ∨ IsUnit e₂) ∧
        e₁.val • z₁ + e₂.val • z₂ ∈ Set.range (wcZModPull Dk (n - 1)) :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out

  haveI : IsProper h := hH.2.1

  have hℓF : ((ℓ : ℕ) : F'') ≠ 0 := by
    intro h0
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have hdvd : ringChar F'' ∣ ℓ := (ringChar.spec F'' ℓ).mp h0
    have hpl : ringChar F'' = ℓ :=
      (hℓp.eq_one_or_self_of_dvd _ hdvd).resolve_left hp.ne_one
    letI := Fintype.ofFinite F''
    have hc : ((Fintype.card F'' : ℕ) : F'') = 0 := FiniteField.cast_card_eq_zero F''
    have hc' : ringChar F'' ∣ Fintype.card F'' := (ringChar.spec F'' _).mp hc
    apply hℓ
    rw [← hpl, Nat.card_eq_fintype_card]
    exact hc'
  have hunitℓ : IsUnit ((ℓ : ℕ) : A') := by
    have h1 := (isUnit_iff_ne_zero.mpr hℓF).map
      (Spec.preimage (e'.inv ≫ Vξ.hom ≫ wcProjKStr F'' M')).hom
    rwa [map_natCast] at h1
  have hunitk : IsUnit (((ℓ ^ k : ℕ)) : A') := by
    rw [Nat.cast_pow]; exact hunitℓ.pow k
  have hm0 : 0 < ℓ ^ k := pow_pos hℓp.pos k

  obtain ⟨Ω, _, _, ξ, hξ, D', Θ₀, Θ₁, hΘ⟩ :=
    wc_pfam_xwt_sp_etale_bridge F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ lam p hH hPP j Vy Ty uy vy A
      e hVy L eL Vξ ι uξ A' e' hιu hΔξ hclξ k Dk hDk (n - 1)

  obtain ⟨x₀, hx₀, hsm, hmod⟩ :=
    wc_pfam_xwt_trait_odp_model F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ lam p hH hPP j Vy Ty uy vy A
      e hVy L eL Vξ ι uξ A' e' hιu hΔξ hclξ

  have hpid : ∀ {S : Scheme.{u}} {m : ℕ} (D0 : wcEtPullData (𝟙 S) m) (i : ℕ)
      (x : wcEtZModExt S m i), wcEtPull D0 i x = x := by
    intro S m D0 i x
    have h1 := wc_et_pull_comp (𝟙 S) (𝟙 S) (𝟙 S) (Category.id_comp _) D0 D0 D0 i x
    have h2 : wcEtPull D0 i (wcEtPull D0 i x - x) = 0 := by rw [map_sub, ← h1, sub_self]
    exact sub_eq_zero.mp (wc_et_pull_id_injective D0 i _ h2)
  have hpsurj : ∀ {S T : Scheme.{u}} {m : ℕ} (ψ : T ⟶ S) [IsIso ψ] (Dψ : wcEtPullData ψ m)
      (i : ℕ), Function.Surjective (wcEtPull Dψ i) := by
    intro S T m ψ _ Dψ i x
    obtain ⟨Di⟩ := wc_et_zmod_pull_data_exists (inv ψ) m
    obtain ⟨D0⟩ := wc_et_zmod_pull_data_exists (𝟙 T) m
    refine ⟨wcEtPull Di i x, ?_⟩
    rw [← wc_et_pull_comp (inv ψ) ψ (𝟙 T) (IsIso.hom_inv_id ψ) Di Dψ D0 i x, hpid]

  have hmil : ∀ (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)] (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
      (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback h (e'.inv ≫ Vξ.hom)) x₀))
        (Scheme.Etale.forget (Limits.pullback h (e'.inv ≫ Vξ.hom))))
      (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
      (a' : Spec (.of B) ⟶ Limits.pullback h (e'.inv ≫ Vξ.hom)), wcHalShData x₀ B Λ' W'' φ' a' →
      Nat.card (wcEtCoh (Limits.pullback (a' ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ)
        (ℓ ^ k) 0) = ℓ ^ k ∧
      (∀ q : ℕ, 1 ≤ q → q + 1 ≤ n - 1 → Subsingleton (wcEtCoh
        (Limits.pullback (a' ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ) (ℓ ^ k) q)) ∧
      IsAddCyclic (wcEtZModExt (Limits.pullback (a' ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ)
        (ℓ ^ k) (n - 1)) := by
    intro B _ _ _ Λ' _ _ W'' φ' a' hB
    obtain ⟨hdom, hdvr, π, c, hπ, hc, x₁, hX, hx₁, B₀, _, _, _, Λ₀, _, _, W₀, φ₀, a₀, hB₀, θ, hθ⟩ :=
      hmod B Λ' W'' φ' a' hB
    haveI := hdom
    haveI := hdvr
    obtain ⟨hcard, hvan, hcyc⟩ := wc_quadric_model_milnor_package A' ℓ hℓp hunitℓ k n hn hn2 π c
      hπ hc x₁ hX hx₁ B₀ Λ₀ W₀ φ₀ a₀ hB₀ Ω ξ hξ
    have h1 : (a' ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ≫ 𝟙 _ =
        θ.hom ≫ (a₀ ≫ wcQuadModelStr A' n π c) := by
      rw [Category.comp_id, hθ]
    have h2 : ξ ≫ 𝟙 _ = 𝟙 _ ≫ ξ := by simp
    let ψ := Limits.pullback.map (a' ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ
      (a₀ ≫ wcQuadModelStr A' n π c) ξ θ.hom (𝟙 _) (𝟙 _) h1 h2
    haveI : IsIso ψ := by
      first
      | exact inferInstance
      | exact Limits.pullback_map_isIso _ _ _ _ _ _ _ _ _
    refine ⟨?_, ?_, ?_⟩
    · obtain ⟨e0⟩ := wc_et_coh_iso_invariance ψ (ℓ ^ k) 0
      exact (Nat.card_congr e0).symm.trans hcard
    · intro q hq1 hq2
      obtain ⟨eq⟩ := wc_et_coh_iso_invariance ψ (ℓ ^ k) q
      haveI := hvan q hq1 (by omega)
      exact eq.symm.subsingleton
    · obtain ⟨Dψ⟩ := wc_et_zmod_pull_data_exists ψ (ℓ ^ k)
      haveI := hcyc
      exact isAddCyclic_of_surjective (wcEtPull Dψ (n - 1)) (hpsurj ψ Dψ (n - 1))

  have htors : ∀ (Z : Scheme.{u}) (m : ℕ) (x : wcEtZModExt Z m (n - 1)), m • x = 0 := by
    intro Z m x
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing Z m)) := HasExt.standard _
    have hsm' : ∀ (c : ℕ) X (s : (SheafOfModules.unit (wcEtZModRing Z m)).val.obj X),
        ((c • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m))).val.app X).hom s = c • s := by
      intro c X s
      induction c with
      | zero =>
        rw [zero_smul, zero_smul]
        have h00 : ((0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
              SheafOfModules.unit (wcEtZModRing Z m)).val.app X).hom s =
            ((0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
              SheafOfModules.unit (wcEtZModRing Z m)).val.app X).hom s +
            ((0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
              SheafOfModules.unit (wcEtZModRing Z m)).val.app X).hom s := by
          conv_lhs => rw [← add_zero (0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
            SheafOfModules.unit (wcEtZModRing Z m))]
          rw [SheafOfModules.add_val, PresheafOfModules.add_app]
          rfl
        exact add_left_cancel (h00.symm.trans (add_zero _).symm)
      | succ c ih =>
        rw [succ_nsmul, succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app]
        rw [ModuleCat.hom_add, LinearMap.add_apply, ih]
        rfl
    obtain ⟨-, -, -, hm⟩ := wc_et_zmod_ring_locbij Z m
    have hmU : m • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m)) = 0 := by
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro s
      rw [hsm' m X s, show (0 : SheafOfModules.unit (wcEtZModRing Z m) ⟶
          SheafOfModules.unit (wcEtZModRing Z m)) =
          0 • 𝟙 (SheafOfModules.unit (wcEtZModRing Z m)) from (zero_smul _ _).symm, hsm' 0 X s,
        zero_smul, ← Nat.cast_smul_eq_nsmul ((wcEtZModRing Z m).obj.obj X), hm X, zero_smul]
    have hcomp : ∀ c : ℕ, x.comp (Abelian.Ext.mk₀ (c • 𝟙 (SheafOfModules.unit
        (wcEtZModRing Z m)))) (add_zero (n - 1)) = c • x := by
      intro c
      induction c with
      | zero => rw [zero_smul, zero_smul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      | succ c ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
          Abelian.Ext.comp_mk₀_id]
    rw [← hcomp m, hmU, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  obtain ⟨B, _, _, _, Λ', _, _, W'', φ', a', eB, hinit, haff, hφ, hφa', hlim, he, hcompB⟩ :=
    wc_et_geom_strict_henselization x₀
  have hB : wcHalShData x₀ B Λ' W'' φ' a' := ⟨hinit, haff, hφ, hφa', hlim, eB, he, hcompB⟩
  let r : Limits.pullback (a' ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ ⟶
      Limits.pullback (Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ :=
    Limits.pullback.lift (Limits.pullback.fst (a' ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ ≫ a')
      (Limits.pullback.snd (a' ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ)
      (by rw [Category.assoc]; exact Limits.pullback.condition)
  have hr₁ : r ≫ Limits.pullback.fst (Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ =
      Limits.pullback.fst (a' ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ ≫ a' :=
    Limits.pullback.lift_fst _ _ _
  have hr₂ : r ≫ Limits.pullback.snd (Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ =
      Limits.pullback.snd (a' ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ :=
    Limits.pullback.lift_snd _ _ _
  obtain ⟨Dr⟩ := wc_et_zmod_pull_data_exists r (ℓ ^ k)

  have hmil' : ∀ (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ]
      (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback h (e'.inv ≫ Vξ.hom)) x₀))
        (Scheme.Etale.forget (Limits.pullback h (e'.inv ≫ Vξ.hom))))
      (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left)
      (a' : Spec (.of B) ⟶ Limits.pullback h (e'.inv ≫ Vξ.hom)), wcHalShData x₀ B Λ W' φ a' →
      Nat.card (wcEtCoh (Limits.pullback (a' ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ)
        (ℓ ^ k) 0) = ℓ ^ k ∧
      ∀ q : ℕ, 1 ≤ q → q + 1 ≤ n - 1 → Subsingleton (wcEtCoh
        (Limits.pullback (a' ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ) (ℓ ^ k) q) := by
    intro B _ _ _ Λ _ _ W' φ a' hB'
    exact ⟨(hmil B Λ W' φ a' hB').1, (hmil B Λ W' φ a' hB').2.1⟩
  haveI := (hmil B Λ' W'' φ' a' hB).2.2
  haveI := AddSubgroup.isAddCyclic (wcEtPull Dr (n - 1)).range
  obtain ⟨g₀, hg₀⟩ := IsAddCyclic.exists_generator (α := (wcEtPull Dr (n - 1)).range)
  obtain ⟨g, hg⟩ := AddMonoidHom.mem_range.mp g₀.2
  have hs4 := fun z hz => wc_et_shens_res_ker_le_range_of_milnor A'
    (Limits.pullback h (e'.inv ≫ Vξ.hom)) (Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) (ℓ ^ k) hm0
    hunitk (n - 1) (by omega) x₀ hx₀ hsm Ω ξ hmil' D' B Λ' W'' φ' a' hB r hr₁ hr₂ Dr z hz
  obtain ⟨y₀, hy₀⟩ := hs4 ((ℓ ^ k) • g) (by rw [map_nsmul, hg]; exact htors _ _ _)
  have hG2 : ∀ x, ∃ c : ℤ, ∃ y, wcEtPull D' (n - 1) y = x - c • g := by
    intro x
    obtain ⟨c, hc⟩ := AddSubgroup.mem_zmultiples_iff.mp (hg₀ ⟨wcEtPull Dr (n - 1) x, x, rfl⟩)
    have hc' : c • (g₀ : wcEtZModExt (Limits.pullback
        (a' ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ) (ℓ ^ k) (n - 1)) =
        wcEtPull Dr (n - 1) x := by
      rw [← AddSubgroup.coe_zsmul, hc]
    refine ⟨c, hs4 (x - c • g) ?_⟩
    rw [map_sub, map_zsmul, hg, hc', sub_self]

  have P1 : (ℓ ^ k) • Θ₁ g ∈ Set.range (wcZModPull Dk (n - 1)) :=
    ⟨Θ₀ y₀, by rw [hΘ, hy₀, map_nsmul]⟩
  have P2 : ∀ z, ∃ c : ℤ, z - c • Θ₁ g ∈ Set.range (wcZModPull Dk (n - 1)) := by
    intro z
    obtain ⟨c, y, hy⟩ := hG2 (Θ₁.symm z)
    exact ⟨c, Θ₀ y, by rw [hΘ, hy, map_sub, map_zsmul, AddEquiv.apply_symm_apply]⟩

  have hring : ∀ a b : ZMod (ℓ ^ k),
      ∃ e₁ e₂ : ZMod (ℓ ^ k), (IsUnit e₁ ∨ IsUnit e₂) ∧ e₁ * a + e₂ * b = 0 := by
    intro a b
    by_cases ha : a = 0
    · exact ⟨1, 0, Or.inl isUnit_one, by rw [ha]; ring⟩
    by_cases hb : b = 0
    · exact ⟨0, 1, Or.inr isUnit_one, by rw [hb]; ring⟩
    have hav : a.val ≠ 0 := fun h => ha ((ZMod.val_eq_zero a).mp h)
    have hbv : b.val ≠ 0 := fun h => hb ((ZMod.val_eq_zero b).mp h)
    obtain ⟨α, a₁, ha₁, haeq⟩ := Nat.exists_eq_pow_mul_and_not_dvd hav ℓ hℓp.one_lt.ne'
    obtain ⟨β, b₁, hb₁, hbeq⟩ := Nat.exists_eq_pow_mul_and_not_dvd hbv ℓ hℓp.one_lt.ne'
    have hunit : ∀ x : ℕ, ¬ ℓ ∣ x → IsUnit (x : ZMod (ℓ ^ k)) := by
      intro x hx
      exact (ZMod.isUnit_iff_coprime x (ℓ ^ k)).mpr
        (((Nat.Prime.coprime_iff_not_dvd hℓp).mpr hx).symm.pow_right k)
    have ha' : a = (ℓ : ZMod (ℓ ^ k)) ^ α * (a₁ : ZMod (ℓ ^ k)) := by
      rw [← ZMod.natCast_zmod_val a, haeq]; push_cast; ring
    have hb' : b = (ℓ : ZMod (ℓ ^ k)) ^ β * (b₁ : ZMod (ℓ ^ k)) := by
      rw [← ZMod.natCast_zmod_val b, hbeq]; push_cast; ring
    rcases le_or_gt α β with hαβ | hαβ
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hαβ
      have hu := hunit a₁ ha₁
      refine ⟨-((ℓ : ZMod (ℓ ^ k)) ^ d * (b₁ : ZMod (ℓ ^ k))) * ↑hu.unit⁻¹, 1,
        Or.inr isUnit_one, ?_⟩
      have hw := hu.val_inv_mul
      rw [ha', hb', pow_add]
      linear_combination (-((ℓ : ZMod (ℓ ^ k)) ^ d * (b₁ : ZMod (ℓ ^ k)) *
        (ℓ : ZMod (ℓ ^ k)) ^ α)) * hw
    · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hαβ.le
      have hu := hunit b₁ hb₁
      refine ⟨1, -((ℓ : ZMod (ℓ ^ k)) ^ d * (a₁ : ZMod (ℓ ^ k))) * ↑hu.unit⁻¹,
        Or.inl isUnit_one, ?_⟩
      have hw := hu.val_inv_mul
      rw [ha', hb', pow_add]
      linear_combination (-((ℓ : ZMod (ℓ ^ k)) ^ d * (a₁ : ZMod (ℓ ^ k)) *
        (ℓ : ZMod (ℓ ^ k)) ^ β)) * hw
  intro z₁ z₂
  obtain ⟨c₁, hc₁⟩ := P2 z₁
  obtain ⟨c₂, hc₂⟩ := P2 z₂
  obtain ⟨e₁, e₂, hu, he⟩ := hring (c₁ : ZMod (ℓ ^ k)) (c₂ : ZMod (ℓ ^ k))
  refine ⟨e₁, e₂, hu, ?_⟩
  haveI : NeZero (ℓ ^ k) := ⟨pow_ne_zero _ hℓp.ne_zero⟩
  have hdiv : ((ℓ ^ k : ℕ) : ℤ) ∣ (e₁.val : ℤ) * c₁ + (e₂.val : ℤ) * c₂ := by
    rw [← ZMod.intCast_zmod_eq_zero_iff_dvd, Int.cast_add, Int.cast_mul, Int.cast_mul,
      Int.cast_natCast, Int.cast_natCast, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
    exact he
  obtain ⟨t, ht⟩ := hdiv
  have key : (e₁.val : ℤ) • (z₁ - c₁ • Θ₁ g) + (e₂.val : ℤ) • (z₂ - c₂ • Θ₁ g) +
      t • (((ℓ ^ k : ℕ) : ℤ) • Θ₁ g) = (e₁.val : ℤ) • z₁ + (e₂.val : ℤ) • z₂ := by
    rw [smul_smul t, mul_comm t, ← ht, add_smul, smul_sub, smul_sub, smul_smul, smul_smul]
    abel
  have m1 : z₁ - c₁ • Θ₁ g ∈ (wcZModPull Dk (n - 1)).range := AddMonoidHom.mem_range.mpr hc₁
  have m2 : z₂ - c₂ • Θ₁ g ∈ (wcZModPull Dk (n - 1)).range := AddMonoidHom.mem_range.mpr hc₂
  have m3 : ((ℓ ^ k : ℕ) : ℤ) • Θ₁ g ∈ (wcZModPull Dk (n - 1)).range := by
    rw [natCast_zsmul]; exact AddMonoidHom.mem_range.mpr P1
  have hmem : (e₁.val : ℤ) • z₁ + (e₂.val : ℤ) • z₂ ∈ (wcZModPull Dk (n - 1)).range := by
    rw [← key]
    exact add_mem (add_mem (zsmul_mem m1 _) (zsmul_mem m2 _)) (zsmul_mem m3 _)
  rw [← natCast_zsmul z₁ e₁.val, ← natCast_zsmul z₂ e₂.val]
  exact AddMonoidHom.mem_range.mp hmem

theorem wc_pfam_xwt_specialization (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (j : Fin D.m) (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : Vy.left ≅ Spec (.of A))
    (hVy : Vy.hom (e.inv (IsLocalRing.closedPoint A)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (L : Type u) [Field L] [IsSepClosed L] (eL : Ty.left ≅ Spec (.of L))
    (Vξ : (wcProjK F'' M').ProEt) (ι : Vξ ⟶ Vy) (uξ : Ty ⟶ Vξ)
    (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    (e' : Vξ.left ≅ Spec (.of A')) (hιu : uξ ≫ ι = uy)
    (hΔξ : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      ((ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))) ∈ Δ)
    (hclξ : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
      y ∈ closure {(ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))}) :
    ∀ t₁ t₂ : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty), ∃ c₁ c₂ : ℚ_[ℓ], (c₁ ≠ 0 ∨ c₂ ≠ 0) ∧
      ((wcRqScalar h ℓ (n - 1) c₁).hom.app (Opposite.op Ty)).hom t₁ +
        ((wcRqScalar h ℓ (n - 1) c₂).hom.app (Opposite.op Ty)).hom t₂ ∈
        Set.range ((wcRq h ℓ (n - 1)).obj.map uξ.op).hom :=
by
  classical

  have hres : IsSepClosed (IsLocalRing.ResidueField L) := by
    have hbij : Function.Bijective (IsLocalRing.residue L) :=
      ⟨(IsLocalRing.residue L).injective, IsLocalRing.residue_surjective⟩
    let eR : L ≃+* IsLocalRing.ResidueField L := RingEquiv.ofBijective _ hbij
    refine IsSepClosed.of_exists_root _ (fun q _ hirr hsep => ?_)
    have hdeg : (q.map (eR.symm : IsLocalRing.ResidueField L →+* L)).degree ≠ 0 := by
      rw [Polynomial.degree_map]
      intro h0
      have := hirr.natDegree_pos
      rw [Polynomial.natDegree_eq_of_degree_eq_some h0] at this
      exact lt_irrefl 0 this
    obtain ⟨x, hx⟩ := IsSepClosed.exists_root
      (q.map (eR.symm : IsLocalRing.ResidueField L →+* L)) hdeg hsep.map
    refine ⟨eR x, ?_⟩
    have := hx.map (f := (eR : L →+* IsLocalRing.ResidueField L))
    have hc : ((eR : L →+* IsLocalRing.ResidueField L).comp
        (eR.symm : IsLocalRing.ResidueField L →+* L)) = RingHom.id _ := by
      ext y; simp
    rw [Polynomial.map_map, hc, Polynomial.map_id] at this
    exact this
  haveI := hres

  obtain ⟨Φ, hΦsc, hΦnat⟩ : ∃ Φ : ∀ (q : ℕ) (V : (wcProjK F'' M').ProEt),
        Projective (wcFreeSheaf (wcProjK F'' M') V) →
        ((wcRq h ℓ q).obj.obj (Opposite.op V) ≃+ wcHM ((wcProEtPullback h).obj V).left ℓ q),
      (∀ (q : ℕ) (V : (wcProjK F'' M').ProEt) (hV : Projective (wcFreeSheaf (wcProjK F'' M') V))
          (c : ℚ_[ℓ]) (y : (wcRq h ℓ q).obj.obj (Opposite.op V)),
        Φ q V hV (((wcRqScalar h ℓ q c).hom.app (Opposite.op V)).hom y) =
          wcHMScalar ((wcProEtPullback h).obj V).left ℓ q c (Φ q V hV y)) ∧
      (∀ (q : ℕ) (V V' : (wcProjK F'' M').ProEt)
          (hV : Projective (wcFreeSheaf (wcProjK F'' M') V))
          (hV' : Projective (wcFreeSheaf (wcProjK F'' M') V')) (a : V' ⟶ V)
          (Da : wcHMPullData ((wcProEtPullback h).map a).left ℓ), wcHMPullCanonical Da →
          ∀ y : (wcRq h ℓ q).obj.obj (Opposite.op V),
        Φ q V' hV' (((wcRq h ℓ q).obj.map a.op).hom y) = wcHMPull Da q (Φ q V hV y)) := by
    obtain ⟨ev0, hev0post, hev0pre⟩ := wc_free_ext0_eval (wcProjK F'' M')
    obtain ⟨LL, adj, -, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat h
    choose ed hedbij hedτ hedσ using fun q : ℕ =>
      ext_rightDerived_adj_edge LL (wcProEtPush h) adj (wcLadicSheaf Xu.left ℓ) q
    obtain ⟨PP, Pm, evM, Tq, hnatM, hpre, hTs, hTn⟩ :=
      wc_proet_ladic_free_ext_module_natural Xu.left ℓ
    obtain ⟨Θ, hΘs, hΘn⟩ := wc_proet_free_module_ext_hm_natural Xu.left ℓ PP Pm evM hnatM hpre
    have hb : ∀ (q : ℕ) (V : (wcProjK F'' M').ProEt),
        Projective (wcFreeSheaf (wcProjK F'' M') V) →
        Function.Bijective (ed q (wcFreeSheaf (wcProjK F'' M') V)) := by
      intro q V hV
      haveI := hV
      exact hedbij q _
    obtain ⟨E2, hE2a, hE2b⟩ : ∃ E2 : ∀ (q : ℕ) (V : (wcProjK F'' M').ProEt),
        Projective (wcFreeSheaf (wcProjK F'' M') V) →
        (Abelian.Ext (wcFreeSheaf (wcProjK F'' M') V) (wcRq h ℓ q) 0 ≃+
          Abelian.Ext (LL.obj (wcFreeSheaf (wcProjK F'' M') V)) (wcLadicSheaf Xu.left ℓ) q),
        (∀ q V hV x, ed q _ (E2 q V hV x) = x) ∧ (∀ q V hV z, E2 q V hV (ed q _ z) = z) :=
      ⟨fun q V hV => (AddEquiv.ofBijective (ed q _) (hb q V hV)).symm,
        fun q V hV x => (AddEquiv.ofBijective (ed q _) (hb q V hV)).apply_symm_apply x,
        fun q V hV z => (AddEquiv.ofBijective (ed q _) (hb q V hV)).symm_apply_apply z⟩
    obtain ⟨E3, hE3⟩ : ∃ E3 : ∀ (q : ℕ) (V : (wcProjK F'' M').ProEt),
        Abelian.Ext (LL.obj (wcFreeSheaf (wcProjK F'' M') V)) (wcLadicSheaf Xu.left ℓ) q ≃+
          Abelian.Ext (wcFreeSheaf Xu.left ((wcProEtPullback h).obj V))
            (wcLadicSheaf Xu.left ℓ) q,
        ∀ q V z, E3 q V z = (Abelian.Ext.mk₀ (θ V).inv).comp z (zero_add q) :=
      ⟨fun q V =>
        { toFun := fun z => (Abelian.Ext.mk₀ (θ V).inv).comp z (zero_add q)
          invFun := fun z => (Abelian.Ext.mk₀ (θ V).hom).comp z (zero_add q)
          left_inv := fun z => by
            simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
          right_inv := fun z => by
            simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
          map_add' := fun z z' => Abelian.Ext.comp_add _ z z' _ }, fun q V z => rfl⟩
    refine ⟨fun q V hV => (ev0 V (wcRq h ℓ q)).symm.trans ((E2 q V hV).trans ((E3 q V).trans
        ((Tq q ((wcProEtPullback h).obj V)).trans (Θ q ((wcProEtPullback h).obj V))))), ?_, ?_⟩
    · intro q V hV c y
      simp only [AddEquiv.trans_apply]
      have h1 : (ev0 V (wcRq h ℓ q)).symm (((wcRqScalar h ℓ q c).hom.app (Opposite.op V)).hom y) =
          ((ev0 V (wcRq h ℓ q)).symm y).comp (Abelian.Ext.mk₀ (wcRqScalar h ℓ q c))
            (add_zero 0) := by
        rw [AddEquiv.symm_apply_eq]
        have h' := hev0post V _ _ (wcRqScalar h ℓ q c) ((ev0 V (wcRq h ℓ q)).symm y)
        rw [AddEquiv.apply_symm_apply] at h'
        exact h'.symm
      have h2 : ∀ w : Abelian.Ext (wcFreeSheaf (wcProjK F'' M') V) (wcRq h ℓ q) 0,
          E2 q V hV (w.comp (Abelian.Ext.mk₀ (wcRqScalar h ℓ q c)) (add_zero 0)) =
            (E2 q V hV w).comp (Abelian.Ext.mk₀ (wcLadicScalar Xu.left ℓ c)) (add_zero q) := by
        intro w
        have h' := hedσ q (wcFreeSheaf (wcProjK F'' M') V) (wcLadicScalar Xu.left ℓ c)
          (E2 q V hV w)
        rw [hE2a] at h'
        have h'' := congrArg (E2 q V hV) h'
        rw [hE2b] at h''
        exact h''.symm
      have h3 : ∀ z : Abelian.Ext (LL.obj (wcFreeSheaf (wcProjK F'' M') V))
          (wcLadicSheaf Xu.left ℓ) q,
          E3 q V (z.comp (Abelian.Ext.mk₀ (wcLadicScalar Xu.left ℓ c)) (add_zero q)) =
            (E3 q V z).comp (Abelian.Ext.mk₀ (wcLadicScalar Xu.left ℓ c)) (add_zero q) := by
        intro z
        rw [hE3, hE3]
        exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
      rw [h1, h2, h3, hTs, hΘs]
    · intro q V V' hV hV' a Da hDa y
      simp only [AddEquiv.trans_apply]
      have h1 : (ev0 V' (wcRq h ℓ q)).symm (((wcRq h ℓ q).obj.map a.op).hom y) =
          (Abelian.Ext.mk₀ (wcFreeSheafMap (wcProjK F'' M') a)).comp
            ((ev0 V (wcRq h ℓ q)).symm y) (zero_add 0) := by
        rw [AddEquiv.symm_apply_eq]
        have h' := hev0pre V V' a (wcRq h ℓ q) ((ev0 V (wcRq h ℓ q)).symm y)
        rw [AddEquiv.apply_symm_apply] at h'
        exact h'.symm
      have h2 : ∀ w : Abelian.Ext (wcFreeSheaf (wcProjK F'' M') V) (wcRq h ℓ q) 0,
          E2 q V' hV' ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcProjK F'' M') a)).comp w
            (zero_add 0)) =
            (Abelian.Ext.mk₀ (LL.map (wcFreeSheafMap (wcProjK F'' M') a))).comp (E2 q V hV w)
              (zero_add q) := by
        intro w
        have h' := hedτ q (wcFreeSheafMap (wcProjK F'' M') a) (E2 q V hV w)
        rw [hE2a] at h'
        have h'' := congrArg (E2 q V' hV') h'
        rw [hE2b] at h''
        exact h''.symm
      have hθ' : (θ V').inv ≫ LL.map (wcFreeSheafMap (wcProjK F'' M') a) =
          wcFreeSheafMap Xu.left ((wcProEtPullback h).map a) ≫ (θ V).inv := by
        rw [Iso.inv_comp_eq, ← Category.assoc, ← hθ a, Category.assoc, Iso.hom_inv_id,
          Category.comp_id]
      have h3 : ∀ z : Abelian.Ext (LL.obj (wcFreeSheaf (wcProjK F'' M') V))
          (wcLadicSheaf Xu.left ℓ) q,
          E3 q V' ((Abelian.Ext.mk₀ (LL.map (wcFreeSheafMap (wcProjK F'' M') a))).comp z
            (zero_add q)) =
            (Abelian.Ext.mk₀ (wcFreeSheafMap Xu.left ((wcProEtPullback h).map a))).comp
              (E3 q V z) (zero_add q) := by
        intro z
        rw [hE3, hE3, Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, hθ']
      rw [h1, h2, h3, hTn, hΘn q _ _ _ Da hDa]

  have hVξp : Projective (wcFreeSheaf (wcProjK F'' M') Vξ) :=
    wc_proet_free_projective_strict_local _ Vξ A' e'
  have hTyp : Projective (wcFreeSheaf (wcProjK F'' M') Ty) :=
    wc_proet_free_projective_strict_local _ Ty L eL

  obtain ⟨Da, hDa⟩ := wc_hm_pull_data_exists ((wcProEtPullback h).map uξ).left ℓ
  choose Dk hDk using fun k : ℕ =>
    wc_zmod_pull_data_exists ((wcProEtPullback h).map uξ).left (ℓ ^ k)

  obtain ⟨-, -, hc1, hq1, -, -⟩ := wc_pfam_line_fibre_square D M' Xu h Δ lam p hH Vξ A' e'
  obtain ⟨-, hpT, hc2, hq2, -, -⟩ := wc_pfam_line_fibre_square D M' Xu h Δ lam p hH Ty L eL
  haveI := hc1
  haveI := hq1
  haveI := hc2
  haveI := hq2

  have s1 : ∀ (K : Type u) [Field K] [IsSepClosed K] (Z : Scheme.{u})
      (f : Z ⟶ Spec (.of K)) [IsProper f] (m : ℕ), (m : K) ≠ 0 →
      ∀ i : ℕ, Finite (wcEtCoh Z m i) := by
    intro K _ _ Z f _ m hm i
    let eK : K →+* AlgebraicClosure K := algebraMap K (AlgebraicClosure K)
    have hm' : (m : AlgebraicClosure K) ≠ 0 := by
      intro h0
      apply hm
      apply eK.injective
      rw [map_natCast, map_zero]
      exact h0
    obtain ⟨Dp⟩ := wc_et_zmod_pull_data_exists
      (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom eK))) m
    have hb := wc_et_sepclosed_field_ext_proper_pull_bij K (AlgebraicClosure K) eK Z f _
      (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom eK)))
      (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom eK)))
      (IsPullback.of_hasPullback _ _) m hm Dp i
    have hP := wc_etale_proper_finite (AlgebraicClosure K) _
      (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom eK))) m hm' i
    obtain ⟨eP⟩ := wc_et_zmodext_coh_equiv
      (Limits.pullback f (Spec.map (CommRingCat.ofHom eK))) m i
    haveI : Finite (wcEtZModExt (Limits.pullback f (Spec.map (CommRingCat.ofHom eK))) m i) :=
      Finite.of_equiv _ eP.symm
    haveI : Finite (wcEtZModExt Z m i) := Finite.of_injective _ hb.1
    obtain ⟨eY⟩ := wc_et_zmodext_coh_equiv Z m i
    exact Finite.of_equiv _ eY
  have s3 : ∀ (X : Scheme.{u}) [CompactSpace X] [QuasiSeparatedSpace X] (m i : ℕ),
      Finite (wcEtCoh X m i) → Finite (wcZModProEtExt X m i) := by
    intro X _ _ m i hX
    obtain ⟨Θ, hΘ, -⟩ := wc_zmod_et_proet_natural_comparison_all.{u} m i
    obtain ⟨eX⟩ := wc_et_zmodext_coh_equiv X m i
    haveI : Finite (wcEtZModExt X m i) := Finite.of_equiv _ eX.symm
    exact Finite.of_surjective (Θ X) (hΘ X inferInstance inferInstance).2
  have hfT : ∀ k : ℕ, 1 ≤ k →
      Finite (wcZModProEtExt ((wcProEtPullback h).obj Ty).left (ℓ ^ k) (n - 1 - 1)) := by
    intro k hk
    have hmF : ((ℓ ^ k : ℕ) : F'') ≠ 0 := by
      intro h0
      haveI := Fintype.ofFinite F''
      obtain ⟨pc, hp⟩ := CharP.exists F''
      haveI := hp
      have hpp : pc.Prime := CharP.char_is_prime F'' pc
      have h1 : pc ∣ ℓ ^ k := (CharP.cast_eq_zero_iff F'' pc _).mp h0
      have h2 : pc ∣ ℓ := hpp.dvd_of_dvd_pow h1
      have h3 : pc = ℓ := (Nat.prime_dvd_prime_iff_eq hpp Fact.out).mp h2
      have h4 : pc ∣ Fintype.card F'' :=
        (CharP.cast_eq_zero_iff F'' pc _).mp (FiniteField.cast_card_eq_zero F'')
      apply hℓ
      rw [← h3, Nat.card_eq_fintype_card]
      exact h4
    have hL : ((ℓ ^ k : ℕ) : L) ≠ 0 := by
      intro h0
      apply hmF
      apply (Spec.preimage (eL.inv ≫ Ty.hom ≫ wcProjKStr F'' M')).hom.injective
      rw [map_natCast, map_zero]
      exact h0
    obtain ⟨gE, hgE⟩ : ∃ g : ((wcProEtPullback h).obj Ty).left ⟶ Spec (.of L), IsProper g :=
      ⟨_, hpT⟩
    haveI := hgE
    exact s3 _ (ℓ ^ k) (n - 1 - 1) (s1 L _ gE (ℓ ^ k) hL (n - 1 - 1))

  have hinj : ∀ k : ℕ, 1 ≤ k → Function.Injective (wcZModPull (Dk k) (n - 1)) :=
    fun k hk => wc_pfam_xwt_sp_torsion_injective F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ lam p hH
      hPP j Vy Ty uy vy A e hVy L eL Vξ ι uξ A' e' hιu hΔξ hclξ k hk (Dk k) (hDk k)
  have hcyc := fun k (hk : 1 ≤ k) =>
    wc_pfam_xwt_sp_torsion_coker_cyclic F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ lam p hH
      hPP j Vy Ty uy vy A e hVy L eL Vξ ι uξ A' e' hιu hΔξ hclξ k hk (Dk k) (hDk k)

  have hpcod := wc_ladic_pull_codim_one_of_torsion ℓ ((wcProEtPullback h).map uξ).left
    Da hDa Dk hDk (n - 1) hfT hinj hcyc

  have hnat : ∀ y : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Vξ),
      Φ (n - 1) Ty hTyp (((wcRq h ℓ (n - 1)).obj.map uξ.op).hom y) =
        wcHMPull Da (n - 1) (Φ (n - 1) Vξ hVξp y) :=
    fun y => hΦnat (n - 1) Vξ Ty hVξp hTyp uξ Da hDa y

  intro t₁ t₂
  obtain ⟨c₁, c₂, hne, x, hx⟩ := hpcod (Φ (n - 1) Ty hTyp t₁) (Φ (n - 1) Ty hTyp t₂)
  refine ⟨c₁, c₂, hne, (Φ (n - 1) Vξ hVξp).symm x, ?_⟩
  apply (Φ (n - 1) Ty hTyp).injective
  rw [hnat, AddEquiv.apply_symm_apply, hx, map_add, hΦsc, hΦsc]

theorem wc_proet_Rq_hm_comparison {X B : Scheme.{u}} (g : X ⟶ B) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ Φ : ∀ (q : ℕ) (V : B.ProEt), Projective (wcFreeSheaf B V) →
        ((wcRq g ℓ q).obj.obj (Opposite.op V) ≃+ wcHM ((wcProEtPullback g).obj V).left ℓ q),
      (∀ (q : ℕ) (V : B.ProEt) (hV : Projective (wcFreeSheaf B V))
          (c : ℚ_[ℓ]) (y : (wcRq g ℓ q).obj.obj (Opposite.op V)),
        Φ q V hV (((wcRqScalar g ℓ q c).hom.app (Opposite.op V)).hom y) =
          wcHMScalar ((wcProEtPullback g).obj V).left ℓ q c (Φ q V hV y)) ∧
      (∀ (q : ℕ) (V V' : B.ProEt)
          (hV : Projective (wcFreeSheaf B V)) (hV' : Projective (wcFreeSheaf B V')) (a : V' ⟶ V)
          (Da : wcHMPullData ((wcProEtPullback g).map a).left ℓ), wcHMPullCanonical Da →
          ∀ y : (wcRq g ℓ q).obj.obj (Opposite.op V),
        Φ q V' hV' (((wcRq g ℓ q).obj.map a.op).hom y) = wcHMPull Da q (Φ q V hV y)) :=
by
  classical
  obtain ⟨ev0, hev0post, hev0pre⟩ := wc_free_ext0_eval B
  obtain ⟨L, adj, -, θ, hθ⟩ := wc_proet_push_left_adjoint_free_nat g
  choose ed hedbij hedτ hedσ using fun q : ℕ =>
    ext_rightDerived_adj_edge L (wcProEtPush g) adj (wcLadicSheaf X ℓ) q
  obtain ⟨PP, Pm, evM, Tq, hnat, hpre, hTs, hTn⟩ :=
    wc_proet_ladic_free_ext_module_natural X ℓ
  obtain ⟨Θ, hΘs, hΘn⟩ := wc_proet_free_module_ext_hm_natural X ℓ PP Pm evM hnat hpre
  have hb : ∀ (q : ℕ) (V : B.ProEt),
      Projective (wcFreeSheaf B V) →
      Function.Bijective (ed q (wcFreeSheaf B V)) := by
    intro q V hV
    haveI := hV
    exact hedbij q _
  obtain ⟨E2, hE2a, hE2b⟩ : ∃ E2 : ∀ (q : ℕ) (V : B.ProEt),
      Projective (wcFreeSheaf B V) →
      (Abelian.Ext (wcFreeSheaf B V) (wcRq g ℓ q) 0 ≃+
        Abelian.Ext (L.obj (wcFreeSheaf B V)) (wcLadicSheaf X ℓ) q),
      (∀ q V hV x, ed q _ (E2 q V hV x) = x) ∧ (∀ q V hV z, E2 q V hV (ed q _ z) = z) :=
    ⟨fun q V hV => (AddEquiv.ofBijective (ed q _) (hb q V hV)).symm,
      fun q V hV x => (AddEquiv.ofBijective (ed q _) (hb q V hV)).apply_symm_apply x,
      fun q V hV z => (AddEquiv.ofBijective (ed q _) (hb q V hV)).symm_apply_apply z⟩
  obtain ⟨E3, hE3⟩ : ∃ E3 : ∀ (q : ℕ) (V : B.ProEt),
      Abelian.Ext (L.obj (wcFreeSheaf B V)) (wcLadicSheaf X ℓ) q ≃+
        Abelian.Ext (wcFreeSheaf X ((wcProEtPullback g).obj V))
          (wcLadicSheaf X ℓ) q,
      ∀ q V z, E3 q V z = (Abelian.Ext.mk₀ (θ V).inv).comp z (zero_add q) :=
    ⟨fun q V =>
      { toFun := fun z => (Abelian.Ext.mk₀ (θ V).inv).comp z (zero_add q)
        invFun := fun z => (Abelian.Ext.mk₀ (θ V).hom).comp z (zero_add q)
        left_inv := fun z => by
          simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
        right_inv := fun z => by
          simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
        map_add' := fun z z' => Abelian.Ext.comp_add _ z z' _ }, fun q V z => rfl⟩
  refine ⟨fun q V hV => (ev0 V (wcRq g ℓ q)).symm.trans ((E2 q V hV).trans ((E3 q V).trans
      ((Tq q ((wcProEtPullback g).obj V)).trans (Θ q ((wcProEtPullback g).obj V))))), ?_, ?_⟩
  · intro q V hV c y
    simp only [AddEquiv.trans_apply]
    have h1 : (ev0 V (wcRq g ℓ q)).symm (((wcRqScalar g ℓ q c).hom.app (Opposite.op V)).hom y) =
        ((ev0 V (wcRq g ℓ q)).symm y).comp (Abelian.Ext.mk₀ (wcRqScalar g ℓ q c))
          (add_zero 0) := by
      rw [AddEquiv.symm_apply_eq]
      have h := hev0post V _ _ (wcRqScalar g ℓ q c) ((ev0 V (wcRq g ℓ q)).symm y)
      rw [AddEquiv.apply_symm_apply] at h
      exact h.symm
    have h2 : ∀ w : Abelian.Ext (wcFreeSheaf B V) (wcRq g ℓ q) 0,
        E2 q V hV (w.comp (Abelian.Ext.mk₀ (wcRqScalar g ℓ q c)) (add_zero 0)) =
          (E2 q V hV w).comp (Abelian.Ext.mk₀ (wcLadicScalar X ℓ c)) (add_zero q) := by
      intro w
      have h := hedσ q (wcFreeSheaf B V) (wcLadicScalar X ℓ c) (E2 q V hV w)
      rw [hE2a] at h
      have h' := congrArg (E2 q V hV) h
      rw [hE2b] at h'
      exact h'.symm
    have h3 : ∀ z : Abelian.Ext (L.obj (wcFreeSheaf B V)) (wcLadicSheaf X ℓ) q,
        E3 q V (z.comp (Abelian.Ext.mk₀ (wcLadicScalar X ℓ c)) (add_zero q)) =
          (E3 q V z).comp (Abelian.Ext.mk₀ (wcLadicScalar X ℓ c)) (add_zero q) := by
      intro z
      rw [hE3, hE3]
      exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
    rw [h1, h2, h3, hTs, hΘs]
  · intro q V V' hV hV' a Da hDa y
    simp only [AddEquiv.trans_apply]
    have h1 : (ev0 V' (wcRq g ℓ q)).symm (((wcRq g ℓ q).obj.map a.op).hom y) =
        (Abelian.Ext.mk₀ (wcFreeSheafMap B a)).comp
          ((ev0 V (wcRq g ℓ q)).symm y) (zero_add 0) := by
      rw [AddEquiv.symm_apply_eq]
      have h := hev0pre V V' a (wcRq g ℓ q) ((ev0 V (wcRq g ℓ q)).symm y)
      rw [AddEquiv.apply_symm_apply] at h
      exact h.symm
    have h2 : ∀ w : Abelian.Ext (wcFreeSheaf B V) (wcRq g ℓ q) 0,
        E2 q V' hV' ((Abelian.Ext.mk₀ (wcFreeSheafMap B a)).comp w (zero_add 0)) =
          (Abelian.Ext.mk₀ (L.map (wcFreeSheafMap B a))).comp (E2 q V hV w)
            (zero_add q) := by
      intro w
      have h := hedτ q (wcFreeSheafMap B a) (E2 q V hV w)
      rw [hE2a] at h
      have h' := congrArg (E2 q V' hV') h
      rw [hE2b] at h'
      exact h'.symm
    have hθ' : (θ V').inv ≫ L.map (wcFreeSheafMap B a) =
        wcFreeSheafMap X ((wcProEtPullback g).map a) ≫ (θ V).inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, ← hθ a, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    have h3 : ∀ z : Abelian.Ext (L.obj (wcFreeSheaf B V)) (wcLadicSheaf X ℓ) q,
        E3 q V' ((Abelian.Ext.mk₀ (L.map (wcFreeSheafMap B a))).comp z (zero_add q)) =
          (Abelian.Ext.mk₀ (wcFreeSheafMap X ((wcProEtPullback g).map a))).comp
            (E3 q V z) (zero_add q) := by
      intro z
      rw [hE3, hE3, Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, hθ']
    rw [h1, h2, h3, hTn, hΘn q _ _ _ Da hDa]

theorem wc_pfam_offdelta_point_fibre_props (F' F'' : Type u) [Field F'] [Field F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (K : Type u) [Field K] (t : Spec (.of K) ⟶ wcProjK F'' M')
    (ht : t (IsLocalRing.closedPoint K) ∉ Δ) :
    IsProper (Limits.pullback.snd h t) ∧
      SmoothOfRelativeDimension (n - 1) (Limits.pullback.snd h t) :=
by
  classical
  obtain ⟨⟨d, hd⟩, hprop, hhX, -, -, -, hsm, -, -, -, hpb, hlamΔ, -⟩ := hH
  haveI : IsProper h := hprop
  haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension (d - M')) :=
    HasRingHomProperty.instIsZariskiLocalAtSource
  haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension d) :=
    HasRingHomProperty.instIsZariskiLocalAtSource

  have hgen : ∀ (K₁ : Type u) [Field K₁] (t₁ : Spec (.of K₁) ⟶ wcProjK F'' M'),
      t₁ (IsLocalRing.closedPoint K₁) ∉ Δ →
      SmoothOfRelativeDimension (d - M') (Limits.pullback.snd h t₁) := by
    intro K₁ _ t₁ ht₁
    have hB := IsPullback.of_hasPullback h t₁
    have hpt : ∀ x : (Limits.pullback h t₁ : Scheme), ∃ U : Xu.left.Opens,
        (Limits.pullback.fst h t₁) x ∈ U ∧ Smooth (U.ι ≫ h) := by
      intro x
      apply hsm
      have h2 : h ((Limits.pullback.fst h t₁) x) = t₁ ((Limits.pullback.snd h t₁) x) := by
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
      have h3 : (Limits.pullback.snd h t₁) x = IsLocalRing.closedPoint K₁ :=
        Subsingleton.elim _ _
      rw [h2, h3]
      exact ht₁
    choose U hU hUs using hpt
    have hUd : ∀ x, SmoothOfRelativeDimension (d - M') ((U x).ι ≫ h) := by
      intro x
      haveI := hUs x
      haveI := wc_proj_space_smooth F'' M'
      haveI : SmoothOfRelativeDimension d (((U x).ι ≫ h) ≫ wcProjKStr F'' M') := by
        rw [Category.assoc, hhX]
        exact IsZariskiLocalAtSource.comp hd (U x).ι
      exact wc_smooth_reldim_of_comp_reldim ((U x).ι ≫ h) (wcProjKStr F'' M') d M'
    refine IsZariskiLocalAtSource.of_iSup_eq_top
      (fun x => (Limits.pullback.fst h t₁) ⁻¹ᵁ (U x)) ?_ ?_
    · rw [eq_top_iff]
      intro x _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hU x⟩
    · intro x
      have hsq := IsPullback.paste_vert
        (isPullback_morphismRestrict (Limits.pullback.fst h t₁) (U x)) hB
      exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (d - M')) hsq (hUd x)

  have hdM : d - M' = n - 1 := by
    set yb : Spec (.of (AlgebraicClosure F'')) ⟶ Spec (.of F'') :=
      Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) with hyb
    set t₁ : Spec (.of (AlgebraicClosure F'')) ⟶ (wcP1Over F'').left := yb ≫ D.u0 with ht₁def
    have e1 : yb (IsLocalRing.closedPoint (AlgebraicClosure F'')) = IsLocalRing.closedPoint F'' :=
      @Subsingleton.elim (PrimeSpectrum F'') inferInstance _ _
    have ht₁ : ∀ i, t₁ (IsLocalRing.closedPoint (AlgebraicClosure F'')) ≠
        D.S i (IsLocalRing.closedPoint F'') := by
      intro i hi
      apply D.hu0S i
      have : D.u0 (yb (IsLocalRing.closedPoint (AlgebraicClosure F''))) =
          D.S i (IsLocalRing.closedPoint F'') := hi
      rwa [e1] at this
    have ht₀ : (t₁ ≫ lam) (IsLocalRing.closedPoint (AlgebraicClosure F'')) ∉ Δ := by
      intro hin
      have hin' : lam (t₁ (IsLocalRing.closedPoint (AlgebraicClosure F''))) ∈ Δ := hin
      obtain ⟨i, hi⟩ := (hlamΔ _).1 hin'
      exact ht₁ i hi
    have hB₀ := hgen (AlgebraicClosure F'') (t₁ ≫ lam) ht₀
    have hsq := IsPullback.paste_horiz (IsPullback.of_hasPullback D.f t₁) hpb
    have hι : IsPullback hsq.isoPullback.hom (Limits.pullback.snd D.f t₁)
        (Limits.pullback.snd h (t₁ ≫ lam)) (𝟙 _) :=
      IsPullback.of_horiz_isIso ⟨by rw [IsPullback.isoPullback_hom_snd, Category.comp_id]⟩
    have he' : SmoothOfRelativeDimension (d - M') (Limits.pullback.snd D.f t₁) :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (d - M')) hι hB₀
    have h1 : SmoothOfRelativeDimension (n - 1) (Limits.pullback.snd D.f t₁) :=
      (wc_pencil_point_fibre_props F' F'' (AlgebraicClosure F'') Y n hn2 D t₁ ht₁).2.2
    haveI := D.fconn (AlgebraicClosure F'') t₁
    have hne : ¬ IsEmpty (Limits.pullback D.f t₁ : Scheme) :=
      @not_isEmpty_of_nonempty _ ConnectedSpace.toNonempty
    have c1 : ¬ (n - 1 < d - M') := by
      intro hlt
      haveI := h1
      haveI : SmoothOfRelativeDimension (d - M') (𝟙 _ ≫ Limits.pullback.snd D.f t₁) := by
        rw [Category.id_comp]; exact he'
      exact hne ((wc_smooth_closed_reldim_cases (AlgebraicClosure F'') (Limits.pullback D.f t₁)
        (Limits.pullback.snd D.f t₁) (n - 1) (d - M') (Limits.pullback D.f t₁) (𝟙 _)).1 hlt)
    have c2 : ¬ (d - M' < n - 1) := by
      intro hlt
      haveI := he'
      haveI : SmoothOfRelativeDimension (n - 1) (𝟙 _ ≫ Limits.pullback.snd D.f t₁) := by
        rw [Category.id_comp]; exact h1
      exact hne ((wc_smooth_closed_reldim_cases (AlgebraicClosure F'') (Limits.pullback D.f t₁)
        (Limits.pullback.snd D.f t₁) (d - M') (n - 1) (Limits.pullback D.f t₁) (𝟙 _)).1 hlt)
    omega
  have hBt := hgen K t ht
  rw [hdM] at hBt
  exact ⟨inferInstance, hBt⟩

theorem wc_pfam_offdelta_geom_fibre_connected (F' F'' : Type u) [Field F'] [Field F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (ℓ : ℕ) (hℓp : ℓ.Prime) (hℓ : (ℓ : F'') ≠ 0)
    (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ wcProjK F'' M')
    (ht : t (IsLocalRing.closedPoint Ω) ∉ Δ) :
    ConnectedSpace ↥(Limits.pullback h t) :=
by
  classical
  obtain ⟨_, hprop, _, _, hΔ, _, hsm, _, _, _, hpb, hlamΔ, _⟩ := hH
  haveI : IsProper h := hprop
  have hℓ0 : ℓ ≠ 0 := hℓp.ne_zero

  have s1 : ∀ (B : Scheme.{u}) (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ B),
      ∃ j : AlgebraicClosure (B.residueField (s (IsLocalRing.closedPoint K))) →+* K,
        Spec.map (CommRingCat.ofHom j) ≫ wcEtGeomPt B (s (IsLocalRing.closedPoint K)) = s := by
    intro B K _ _ s
    have hφ := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField K B s
    letI : Algebra (B.residueField (s (IsLocalRing.closedPoint K))) K :=
      (Scheme.descResidueField (Scheme.stalkClosedPointTo s)).hom.toAlgebra
    let j₀ : AlgebraicClosure (B.residueField (s (IsLocalRing.closedPoint K))) →ₐ[
        B.residueField (s (IsLocalRing.closedPoint K))] K := IsAlgClosed.lift
    refine ⟨(j₀ : AlgebraicClosure (B.residueField (s (IsLocalRing.closedPoint K))) →+* K), ?_⟩
    have hj : (j₀ : AlgebraicClosure (B.residueField (s (IsLocalRing.closedPoint K))) →+* K).comp
        (algebraMap (B.residueField (s (IsLocalRing.closedPoint K)))
          (AlgebraicClosure (B.residueField (s (IsLocalRing.closedPoint K))))) =
        (Scheme.descResidueField (Scheme.stalkClosedPointTo s)).hom :=
      (AlgHom.comp_algebraMap j₀).trans (RingHom.algebraMap_toAlgebra _)
    show Spec.map (CommRingCat.ofHom _) ≫ (Spec.map (CommRingCat.ofHom
        (algebraMap (B.residueField (s (IsLocalRing.closedPoint K)))
          (AlgebraicClosure (B.residueField (s (IsLocalRing.closedPoint K)))))) ≫
        B.fromSpecResidueField (s (IsLocalRing.closedPoint K))) = s
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hj, CommRingCat.ofHom_hom]
    exact hφ

  have s2 : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [IsProper g] (k K : Type u) [Field k] [IsSepClosed k]
      [Field K] [IsSepClosed K] (geo : Spec (.of k) ⟶ B) (j : k →+* K) (m : ℕ), (m : K) ≠ 0 →
      ∀ q : ℕ, Nat.card (wcEtCoh (Limits.pullback g (Spec.map (CommRingCat.ofHom j) ≫ geo)) m q) =
        Nat.card (wcEtCoh (Limits.pullback g geo) m q) := by
    intro X B g _ k K _ _ _ _ geo j m hm q
    obtain ⟨π, hπ1, hπ2⟩ : ∃ π : Limits.pullback g (Spec.map (CommRingCat.ofHom j) ≫ geo) ⟶
        Limits.pullback g geo,
        π ≫ Limits.pullback.fst g geo = Limits.pullback.fst g (Spec.map (CommRingCat.ofHom j) ≫ geo) ∧
        π ≫ Limits.pullback.snd g geo =
          Limits.pullback.snd g (Spec.map (CommRingCat.ofHom j) ≫ geo) ≫
            Spec.map (CommRingCat.ofHom j) :=
      ⟨Limits.pullback.lift _ _ (Limits.pullback.condition.trans (Category.assoc _ _ _).symm),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hπ : IsPullback π (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom j) ≫ geo))
        (Limits.pullback.snd g geo) (Spec.map (CommRingCat.ofHom j)) := by
      refine IsPullback.of_right ?_ hπ2 (IsPullback.of_hasPullback g geo)
      rw [hπ1]
      exact IsPullback.of_hasPullback g (Spec.map (CommRingCat.ofHom j) ≫ geo)
    have hmk : (m : k) ≠ 0 := by
      intro h0
      apply hm
      rw [← map_natCast j, h0, map_zero]
    obtain ⟨Dπ⟩ := wc_et_zmod_pull_data_exists π m
    have hb := wc_et_sepclosed_field_ext_proper_pull_bij k K j (Limits.pullback g geo)
      (Limits.pullback.snd g geo) _ π _ hπ m hmk Dπ q
    obtain ⟨e1⟩ := wc_et_zmodext_coh_equiv
      (Limits.pullback g (Spec.map (CommRingCat.ofHom j) ≫ geo)) m q
    obtain ⟨e2⟩ := wc_et_zmodext_coh_equiv (Limits.pullback g geo) m q
    exact (Nat.card_congr e1).symm.trans
      ((Nat.card_congr (Equiv.ofBijective _ hb)).symm.trans (Nat.card_congr e2))

  have s3 : ∀ (K : Type u) [Field K] (B X : Scheme.{u}) (sB : B ⟶ Spec (.of K)) (g : X ⟶ B)
      [IsProper g] (W : B.Opens), Smooth (g ∣_ W) → ∀ (m : ℕ), (m : K) ≠ 0 →
      ∀ (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X)
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (q : ℕ) (η x : B),
      (∀ z : B, η ⤳ z) → x ∈ W →
      Nonempty ((wcEtStalk B x).obj ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex).homology q) ≃+
        (wcEtStalk B η).obj ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj
          I.cocomplex).homology q)) := by
    intro K _ B X sB g _ W hsm m hmK I q η x hη hx
    haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) :=
      wc_et_enough_injectives X
    obtain ⟨A, _, _, _, Λ, _, _, W', φ, a, e, hinit, haff, hφ, hφa, hlim, he, hpt⟩ :=
      wc_et_geom_strict_henselization x
    obtain ⟨ξ, hξ⟩ := wc_shens_geom_point_over_generalization x η (hη x) A Λ W' φ a haff hφ hφa hlim
    have hlift : ∀ l, (ξ ≫ φ l) ≫ (W'.obj l).right.hom = wcEtGeomPt B η :=
      fun l => (Category.assoc _ _ _).trans ((congrArg (fun k => ξ ≫ k) (hφa l)).trans hξ)
    have hcompat : ∀ {l l' : Λ} (t : l ⟶ l'), (ξ ≫ φ l) ≫ (W'.map t).right.left = ξ ≫ φ l' :=
      fun t => (Category.assoc _ _ _).trans (congrArg (fun k => ξ ≫ k) (hφ t))
    obtain ⟨sp, hsp⟩ := wc_et_cospec_stalk_nat _ x η Λ W' hinit (fun l => ξ ≫ φ l) hlift hcompat
    have hac : a (IsLocalRing.closedPoint A) = x := by
      have h1 := congrArg (fun g => g (IsLocalRing.closedPoint
        (AlgebraicClosure (B.residueField x)))) hpt
      have hres : (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))
          ((Spec.map (CommRingCat.ofHom e)) (IsLocalRing.closedPoint
            (AlgebraicClosure (B.residueField x)))) =
          IsLocalRing.closedPoint A := by
        first
          | exact (Spec.map_apply _ _).trans (IsLocalRing.PrimeSpectrum.comap_residue A _)
          | exact IsLocalRing.PrimeSpectrum.comap_residue A _
      have h2 : a ((Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))
          ((Spec.map (CommRingCat.ofHom e)) (IsLocalRing.closedPoint
            (AlgebraicClosure (B.residueField x))))) = x := by
        refine h1.trans ?_
        first
          | exact Scheme.fromSpecResidueField_apply x _
          | exact Scheme.fromSpecResidueField_apply (X := B) x
              ((Spec.map (CommRingCat.ofHom (algebraMap (B.residueField x)
                (AlgebraicClosure (B.residueField x))))) (IsLocalRing.closedPoint
                  (AlgebraicClosure (B.residueField x))))
          | simp [Scheme.Hom.comp_apply, wcEtGeomPt]
      rw [hres] at h2
      exact h2
    have hrange : Set.range a ⊆ (W : Set B) := by
      rintro _ ⟨p, rfl⟩
      have hsp' : a p ⤳ x := by
        rw [← hac]
        exact (IsLocalRing.specializes_closedPoint p).map a.continuous
      exact hsp'.mem_open W.isOpen hx
    have hsm1 : Smooth (Limits.pullback.snd (Limits.pullback.snd g a) (𝟙 _)) :=
      wc_smooth_restrict_base_change _ _ _ _ g W hsm a (𝟙 _)
        (by rw [Category.id_comp]; exact hrange)
    have hsm2 : Smooth (Limits.pullback.snd g a) := by
      have e1 : Limits.pullback.snd g a =
          inv (Limits.pullback.fst (Limits.pullback.snd g a) (𝟙 _)) ≫
            Limits.pullback.snd (Limits.pullback.snd g a) (𝟙 _) := by
        rw [IsIso.eq_inv_comp, Limits.pullback.condition, Category.comp_id]
      rw [e1]
      haveI := hsm1
      infer_instance
    haveI : IsProper (Limits.pullback.snd g a) := by
      first
        | exact MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback g a)
            ‹IsProper g›
        | infer_instance
    have hunit : IsUnit ((m : ℕ) : A) := by
      have := (isUnit_iff_ne_zero.mpr hmK).map (Spec.preimage (a ≫ sB)).hom
      rwa [map_natCast] at this
    have hm0 : m ≠ 0 := by
      intro h0
      apply hmK
      rw [h0, Nat.cast_zero]
    have HSPBC := wc_smooth_proper_shens_pull_bij A (Limits.pullback g a)
      (Limits.pullback.snd g a) hsm2 m hunit
      (AlgebraicClosure (B.residueField η)) ξ
    obtain ⟨hS, hK⟩ := wc_et_push_Rj_cospec_germ_of_pull_bij g m hm0 q x η A Λ W' φ a e
      hinit haff hφ hφa hlim he hpt ξ hξ HSPBC
    have hG : IsIso (sp.app (((wcEtPush g).rightDerived q).obj
        ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))) :=
      wc_et_cospec_isIso_of_germ _ x η Λ W' hinit (fun l => ξ ≫ φ l) hlift _ _ (hsp _) hS hK
    have hF : IsIso (sp.app ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj
        I.cocomplex).homology q)) :=
      (NatTrans.isIso_app_iff_of_iso sp (I.isoRightDerivedObj (wcEtPush g) q)).mp hG
    exact ⟨(@asIso _ _ _ _ (sp.app _) hF).addCommGroupIsoToAddEquiv⟩

  have hchar : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ wcProjK F'' M'), (ℓ : K) ≠ 0 := by
    intro K _ s h0
    apply hℓ
    apply (Spec.preimage (s ≫ wcProjKStr F'' M')).hom.injective
    rw [map_natCast, map_zero]
    exact h0

  have fib : ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ wcProjK F'' M'),
      Nat.card (wcEtCoh (Limits.pullback h s) ℓ 0) =
        Nat.card (wcEtCoh (Limits.pullback h
          (wcEtGeomPt (wcProjK F'' M') (s (IsLocalRing.closedPoint K)))) ℓ 0) := by
    intro K _ _ s
    obtain ⟨j, hfac⟩ := s1 _ K s
    have key : ∀ s' : Spec (.of K) ⟶ wcProjK F'' M',
        Spec.map (CommRingCat.ofHom j) ≫
          wcEtGeomPt (wcProjK F'' M') (s (IsLocalRing.closedPoint K)) = s' →
        Nat.card (wcEtCoh (Limits.pullback h s') ℓ 0) =
          Nat.card (wcEtCoh (Limits.pullback h
            (wcEtGeomPt (wcProjK F'' M') (s (IsLocalRing.closedPoint K)))) ℓ 0) := by
      rintro s' rfl
      exact s2 h _ K _ j ℓ (hchar K s) 0
    exact key s hfac

  let W₀ : (wcProjK F'' M').Opens := ⟨Δᶜ, hΔ.isOpen_compl⟩
  have hsmW : Smooth (h ∣_ W₀) := wc_smooth_restrict_of_local_smooth h W₀ (fun x hx => hsm x hx)
  haveI hirrP : IrreducibleSpace ↥(wcProjK F'' M') := wc_proj_space_irreducible F'' M'
  have hη : ∀ z : wcProjK F'' M', genericPoint ↥(wcProjK F'' M') ⤳ z :=
    fun z => @genericPoint_specializes ↥(wcProjK F'' M') _ _ hirrP z
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Xu.left) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives Xu.left
  obtain ⟨I⟩ : Nonempty (InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology Xu.left)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) :=
    ⟨injectiveResolution _⟩
  have PBC : ∀ y : wcProjK F'' M',
      Nat.card ((wcEtStalk (wcProjK F'' M') y).obj ((((wcEtPush h).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).homology 0)) =
      Nat.card (wcEtCoh (Limits.pullback h (wcEtGeomPt (wcProjK F'' M') y)) ℓ 0) := by
    intro y
    obtain ⟨e⟩ := wc_et_proper_stalk_coh h ℓ hℓ0 wc_et_henselian_proper_vanishing I y 0
    exact Nat.card_congr e
  have COSP : ∀ y : wcProjK F'' M', y ∉ Δ →
      Nat.card ((wcEtStalk (wcProjK F'' M') y).obj ((((wcEtPush h).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).homology 0)) =
      Nat.card ((wcEtStalk (wcProjK F'' M') (genericPoint ↥(wcProjK F'' M'))).obj
        ((((wcEtPush h).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology 0)) := by
    intro y hy
    obtain ⟨e⟩ := s3 F'' (wcProjK F'' M') Xu.left (wcProjKStr F'' M') h W₀ hsmW ℓ hℓ I 0
      (genericPoint ↥(wcProjK F'' M')) y hη hy
    exact Nat.card_congr e.toEquiv

  obtain ⟨t₁, ht₁⟩ : ∃ t₁ : Spec (.of (AlgebraicClosure F'')) ⟶ (wcP1Over F'').left,
      t₁ = Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) ≫ D.u0 :=
    ⟨_, rfl⟩
  have hx₀ : (t₁ ≫ lam) (IsLocalRing.closedPoint (AlgebraicClosure F'')) ∉ Δ := by
    subst ht₁
    intro hin
    have e1 : (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
        (IsLocalRing.closedPoint (AlgebraicClosure F'')) = IsLocalRing.closedPoint F'' :=
      @Subsingleton.elim (PrimeSpectrum F'') inferInstance _ _
    have hin' : lam (D.u0 ((Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
        (IsLocalRing.closedPoint (AlgebraicClosure F'')))) ∈ Δ := hin
    rw [e1] at hin'
    obtain ⟨i, hi⟩ := (hlamΔ _).1 hin'
    exact D.hu0S i hi
  haveI := D.fconn (AlgebraicClosure F'') t₁
  have hsq₀ := IsPullback.paste_horiz (IsPullback.of_hasPullback D.f t₁) hpb
  haveI hconn0 : ConnectedSpace ↥(Limits.pullback h (t₁ ≫ lam)) :=
    Function.Surjective.connectedSpace (Scheme.Hom.homeomorph hsq₀.isoPullback.hom).surjective
      (Scheme.Hom.homeomorph hsq₀.isoPullback.hom).continuous
  have c0 : Nat.card (wcEtCoh (Limits.pullback h (t₁ ≫ lam)) ℓ 0) = ℓ :=
    wc_et_coh_zero_connected_card _ ℓ hℓ0
  exact wc_et_coh0_card_prime_connected _ ℓ hℓp
    ((fib Ω t).trans ((PBC _).symm.trans ((COSP _ ht).trans ((COSP _ hx₀).symm.trans
      ((PBC _).trans ((fib _ (t₁ ≫ lam)).symm.trans c0))))))

theorem wc_pfam_Ty_hm_fibre_duality (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (Ty : (wcProjK F'' M').ProEt) (L : Type u) [Field L] [IsSepClosed L]
    (eL : Ty.left ≅ Spec (.of L)) :
    (∃ η : wcHM ((wcProEtPullback h).obj Ty).left ℓ (2 * (n - 1)) →+ ℚ_[ℓ],
      Function.Injective η ∧
      ∀ (c : ℚ_[ℓ]) (z : wcHM ((wcProEtPullback h).obj Ty).left ℓ (2 * (n - 1))),
        η (wcHMScalar ((wcProEtPullback h).obj Ty).left ℓ (2 * (n - 1)) c z) = c * η z) ∧
    ∀ w : wcHM ((wcProEtPullback h).obj Ty).left ℓ (n - 1),
      (∀ y : wcHM ((wcProEtPullback h).obj Ty).left ℓ (n - 1),
        wcHMCup ((wcProEtPullback h).obj Ty).left ℓ (n - 1) (n - 1) (2 * (n - 1))
          (two_mul (n - 1)).symm y w = 0) → w = 0 :=
by
  classical
  obtain ⟨_, _, _, _, hΔ, _, _, _, _, _, _, hlamΔ, _⟩ := id hH

  have hℓF : (ℓ : F'') ≠ 0 := by
    intro h0
    haveI := ringChar.charP F''
    have hc : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have hdvd : ringChar F'' ∣ ℓ := (ringChar.spec F'' ℓ).mp h0
    have heq : ringChar F'' = ℓ :=
      (Nat.prime_dvd_prime_iff_eq hc (Fact.out : ℓ.Prime)).mp hdvd
    letI := Fintype.ofFinite F''
    have hcard : ringChar F'' ∣ Fintype.card F'' :=
      (ringChar.spec F'' _).mp (FiniteField.cast_card_eq_zero F'')
    apply hℓ
    rw [← heq, Nat.card_eq_fintype_card]
    exact hcard

  have hoff : ∀ z : Ty.left, Ty.hom z ∉ Δ := by
    intro z hz
    have hsub : ∀ x y : Ty.left, x = y := by
      intro x y
      have h1 : eL.hom x = eL.hom y :=
        @Subsingleton.elim (PrimeSpectrum L) inferInstance (eL.hom x) (eL.hom y)
      have hx : eL.inv (eL.hom x) = x := by simp
      have hy : eL.inv (eL.hom y) = y := by simp
      rw [← hx, ← hy, h1]
    haveI : WeaklyEtale Ty.hom := Ty.prop
    haveI : Flat Ty.hom := WeaklyEtale.flat
    have hgen := Flat.generalizingMap Ty.hom
    haveI hirrP : IrreducibleSpace ↥(wcProjK F'' M') := wc_proj_space_irreducible F'' M'
    have hspec : genericPoint ↥(wcProjK F'' M') ⤳ Ty.hom z :=
      @genericPoint_specializes ↥(wcProjK F'' M') _ _ hirrP (Ty.hom z)
    obtain ⟨z', -, hz'⟩ := hgen hspec
    rw [hsub z' z] at hz'
    rw [hz'] at hz
    have h0 := (@genericPoint_specializes ↥(wcProjK F'' M') _ _ hirrP
      (lam (D.u0 (IsLocalRing.closedPoint F'')))).mem_closed hΔ hz
    obtain ⟨i, hi⟩ := (hlamΔ _).1 h0
    exact D.hu0S i hi

  obtain ⟨t, ht_def⟩ : ∃ t : Spec (.of L) ⟶ wcProjK F'' M', t = eL.inv ≫ Ty.hom := ⟨_, rfl⟩
  have ht : t (IsLocalRing.closedPoint L) ∉ Δ := by
    subst ht_def
    exact hoff _

  obtain ⟨hPr, hSm⟩ :=
    wc_pfam_offdelta_point_fibre_props F' F'' Y n hn2 D M' Xu h Δ lam p hH L t ht

  obtain ⟨fE, hfE_def⟩ : ∃ fE : Limits.pullback Ty.hom h ⟶ Spec (.of L),
      fE = Limits.pullback.fst Ty.hom h ≫ eL.hom := ⟨_, rfl⟩
  have hsq : IsPullback (Limits.pullback.snd Ty.hom h) fE h t := by
    subst hfE_def ht_def
    refine IsPullback.of_iso (IsPullback.of_hasPullback Ty.hom h).flip (Iso.refl _)
      (Iso.refl _) eL (Iso.refl _) ?_ ?_ ?_ ?_ <;> simp
  have hι : IsPullback hsq.isoPullback.hom fE (Limits.pullback.snd h t) (𝟙 _) :=
    IsPullback.of_horiz_isIso ⟨by rw [IsPullback.isoPullback_hom_snd, Category.comp_id]⟩
  have hfE : IsProper fE := MorphismProperty.of_isPullback (P := @IsProper) hι hPr
  have hsX : SmoothOfRelativeDimension (n - 1) fE :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (n - 1)) hι hSm

  have hπ := IsPullback.of_hasPullback fE
    (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))
  have hp : IsProper (Limits.pullback.snd fE
      (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))) :=
    MorphismProperty.of_isPullback (P := @IsProper) hπ hfE
  have hsp : SmoothOfRelativeDimension (n - 1) (Limits.pullback.snd fE
      (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (n - 1)) hπ hsX

  have ht' : (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) ≫ t)
      (IsLocalRing.closedPoint (AlgebraicClosure L)) ∉ Δ := by
    have e1 : (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))
        (IsLocalRing.closedPoint (AlgebraicClosure L)) = IsLocalRing.closedPoint L :=
      @Subsingleton.elim (PrimeSpectrum L) inferInstance _ _
    intro hin
    apply ht
    have hin' : t ((Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))
        (IsLocalRing.closedPoint (AlgebraicClosure L))) ∈ Δ := hin
    rwa [e1] at hin'
  haveI hc := wc_pfam_offdelta_geom_fibre_connected F' F'' Y n D M' Xu h Δ lam p hH ℓ
    (Fact.out : ℓ.Prime) hℓF (AlgebraicClosure L)
    (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) ≫ t) ht'
  have hW := IsPullback.paste_horiz hπ hsq
  haveI hWconn : ConnectedSpace ↥(Limits.pullback fE
      (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))) :=
    Function.Surjective.connectedSpace (Scheme.Hom.homeomorph hW.isoPullback.inv).surjective
      (Scheme.Hom.homeomorph hW.isoPullback.inv).continuous
  haveI : Smooth (Limits.pullback.snd fE
      (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))) :=
    SmoothOfRelativeDimension.smooth (n - 1) _
  have hirr : IrreducibleSpace ↥(Limits.pullback fE
      (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))) :=
    wc_smooth_algclosed_connected_irreducible (AlgebraicClosure L) _ (Limits.pullback.snd fE
      (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L)))))
  have hchar : ∀ m : ℕ, (m : F'') ≠ 0 → (m : L) ≠ 0 := by
    intro m hm h0
    let ψ : F'' →+* L := (Spec.preimage (t ≫ wcProjKStr F'' M')).hom
    apply hm
    apply ψ.injective
    rw [map_natCast, map_zero]
    exact h0
  haveI := hfE
  haveI := hp
  haveI := hsp
  haveI := hirr
  have hℓL : (ℓ : L) ≠ 0 := hchar ℓ hℓF
  have hℓK : (ℓ : AlgebraicClosure L) ≠ 0 := by
    rw [← map_natCast (algebraMap L (AlgebraicClosure L)) ℓ]
    exact (map_ne_zero (algebraMap L (AlgebraicClosure L))).mpr hℓL

  have hpullsc : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (Df : wcHMPullData f ℓ),
      wcHMPullCanonical Df → ∀ (q : ℕ) (c : ℚ_[ℓ]) (z : wcHM S ℓ q),
        wcHMPull Df q (wcHMScalar S ℓ q c z) = wcHMScalar S' ℓ q c (wcHMPull Df q z) := by
    intro S S' f Df hDf q c z
    have hc := wc_hm_pull_const Df hDf c
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := Df.additive
    haveI := Df.presLim
    haveI := Df.presColim
    show (Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ
          (z.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero q))).comp
          (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q)) (zero_add q) =
        ((Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ z).comp
          (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q)) (zero_add q)).comp
          (Abelian.Ext.mk₀ (wcHMConst S' ℓ c)) (add_zero q)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, ← hc]
    generalize Abelian.Ext.mapExactFunctor Df.Φ z = w
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero w
        (Abelian.Ext.mk₀ (Df.Φ.map (wcHMConst S ℓ c))) (Abelian.Ext.mk₀ Df.μ.hom),
      Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ Df.μ.inv),
      Abelian.Ext.comp_assoc_of_third_deg_zero w (Abelian.Ext.mk₀ Df.μ.hom),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id_assoc]
  obtain ⟨Dπ, hDπ⟩ := wc_hm_pull_data_exists (Limits.pullback.fst fE
      (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))) ℓ
  have hbij : ∀ q, Function.Bijective (wcHMPull Dπ q) := fun q =>
    @wc_hm_sepclosed_base_change_pull_bij L (AlgebraicClosure L) _ _ _ _
      (algebraMap L (AlgebraicClosure L)) ((wcProEtPullback h).obj Ty).left fE hfE _ _ _ hπ ℓ _
      hℓL Dπ hDπ q

  obtain ⟨η, hηinj, hηlin⟩ :=
    wc_hm_top_line (AlgebraicClosure L) (Limits.pullback.snd fE
      (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))) (n - 1) ℓ hℓK
      (2 * (n - 1)) rfl
  refine ⟨⟨η.comp (wcHMPull Dπ (2 * (n - 1))), hηinj.comp (hbij _).1, ?_⟩, ?_⟩
  · intro c x
    show η (wcHMPull Dπ (2 * (n - 1))
          (wcHMScalar ((wcProEtPullback h).obj Ty).left ℓ (2 * (n - 1)) c x)) =
        c * η (wcHMPull Dπ (2 * (n - 1)) x)
    exact (congrArg η (hpullsc Dπ hDπ (2 * (n - 1)) c x)).trans (hηlin c _)

  · have hcup : (n - 1) + (n - 1) = 2 * (n - 1) := by omega
    intro w hw
    have hclaim : ∀ z : wcHM (Limits.pullback fE
        (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))) ℓ (n - 1),
        wcHMCup _ ℓ (n - 1) (n - 1) (2 * (n - 1)) hcup z (wcHMPull Dπ (n - 1) w) = 0 := by
      intro z
      obtain ⟨y, rfl⟩ := (hbij (n - 1)).surjective z
      rw [← wc_hm_pull_cup Dπ (n - 1) (n - 1) (2 * (n - 1)) hcup y w]
      exact (congrArg (wcHMPull Dπ (2 * (n - 1))) (hw y)).trans (map_zero _)
    have hw' : wcHMPull Dπ (n - 1) w = 0 :=
      wc_hm_poincare_right (AlgebraicClosure L) (Limits.pullback.snd fE
        (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))) (n - 1) ℓ hℓK
        (n - 1) (n - 1) (2 * (n - 1)) hcup rfl _ hclaim
    apply (hbij (n - 1)).injective
    exact hw'.trans (map_zero _).symm

theorem wc_ladic_pull_surjective_of_torsion {Y T : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [CompactSpace T] [QuasiSeparatedSpace T] [CompactSpace Y] [QuasiSeparatedSpace Y]
    (p : T ⟶ Y) (D : wcHMPullData p ℓ) (hD : wcHMPullCanonical D)
    (Dk : ∀ k : ℕ, wcZModPullData p (ℓ ^ k)) (hDk : ∀ k : ℕ, wcZModPullCanonical (Dk k))
    (q : ℕ) (hfinY : ∀ k : ℕ, 1 ≤ k → Finite (wcZModProEtExt Y (ℓ ^ k) q))
    (hfinT : ∀ k : ℕ, 1 ≤ k → Finite (wcZModProEtExt T (ℓ ^ k) (q - 1)))
    (hsurj : ∀ k : ℕ, 1 ≤ k → Function.Surjective (wcZModPull (Dk k) q)) :
    Function.Surjective (wcHMPull D q) :=
by
  classical
  obtain ⟨P⟩ := wc_ladic_milnor_package ℓ p D hD Dk hDk q
  letI := P.instMY
  letI := P.instMT
  obtain ⟨L1, L2, L3, L4⟩ := wc_hmScalar_laws T ℓ q
  obtain ⟨L1Y, L2Y, L3Y, L4Y⟩ := wc_hmScalar_laws Y ℓ q
  intro t
  obtain ⟨N, m, hm⟩ := P.denomT t

  let X : ℕ → Type _ := fun j =>
    {a : wcZModProEtExt Y (ℓ ^ (j + 1)) q // wcZModPull (Dk (j + 1)) q a = P.redT (j + 1) m}
  have fmem : ∀ (j : ℕ) (a : X (j + 1)),
      wcZModPull (Dk (j + 1)) q (P.τY (j + 1) q a.1) = P.redT (j + 1) m := by
    intro j a
    rw [← P.τ_pull (j + 1) q a.1, a.2, P.redT_compat (j + 1) m (by omega)]
  let f : ∀ j : ℕ, X (j + 1) → X j := fun j a => ⟨P.τY (j + 1) q a.1, fmem j a⟩
  let F : ℕᵒᵖ ⥤ Type _ := CategoryTheory.Functor.ofOpSequence (fun j => TypeCat.ofHom (f j))
  haveI hFfin : ∀ j : ℕᵒᵖ, Finite (F.obj j) := fun j => by
    show Finite (X j.unop)
    haveI := hfinY (j.unop + 1) (by omega)
    exact Subtype.finite
  haveI hFne : ∀ j : ℕᵒᵖ, Nonempty (F.obj j) := fun j => by
    show Nonempty (X j.unop)
    obtain ⟨a, ha⟩ := hsurj (j.unop + 1) (by omega) (P.redT (j.unop + 1) m)
    exact ⟨⟨a, ha⟩⟩
  obtain ⟨s, hs⟩ := nonempty_sections_of_finite_inverse_system F
  let g : ∀ j : ℕ, X j := fun j => s (Opposite.op j)
  have hg : ∀ j : ℕ, P.τY (j + 1) q (g (j + 1)).1 = (g j).1 := by
    intro j
    have h1 := hs (homOfLE (Nat.le_succ j)).op
    rw [CategoryTheory.Functor.ofOpSequence_map_homOfLE_succ] at h1
    exact congrArg Subtype.val h1
  let α : ∀ k : ℕ, wcZModProEtExt Y (ℓ ^ k) q := fun k =>
    match k with
    | 0 => 0
    | j + 1 => (g j).1
  have hαc : ∀ k, 1 ≤ k → P.τY k q (α (k + 1)) = α k := by
    intro k hk
    obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
    exact hg j
  have hαπ : ∀ k, 1 ≤ k → wcZModPull (Dk k) q (α k) = P.redT k m := by
    intro k hk
    obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
    exact (g j).2

  obtain ⟨y, hy⟩ := P.liftY α hαc
  have hred : ∀ k, 1 ≤ k → P.redT k (P.pI y - m) = 0 := by
    intro k hk
    rw [map_sub, P.red_pI k y, hy k hk, hαπ k hk, sub_self]
  have h0 : P.pI y - m = 0 := by
    refine P.sepT ?_ _ hred
    apply (config := { synthAssignedInstances := false }) wc_tower_lim1_of_ml
    apply (config := { synthAssignedInstances := false }) wc_tower_ml_of_finite
    exact hfinT
  have hpI : P.pI y = m := sub_eq_zero.mp h0
  have h8 : wcHMPull D q (P.ρY y) = wcHMScalar T ℓ q ((ℓ : ℚ_[ℓ]) ^ N) t := by
    rw [← P.ρ_pI y, hpI, hm]

  have hc : ((ℓ : ℚ_[ℓ]) ^ N) ≠ 0 :=
    pow_ne_zero N (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
  obtain ⟨y', hy'⟩ : ∃ y' : wcHM Y ℓ q, (ℓ ^ N : ℕ) • y' = P.ρY y :=
    ⟨wcHMScalar Y ℓ q ((ℓ : ℚ_[ℓ]) ^ N)⁻¹ (P.ρY y), by
      rw [L4Y, Nat.cast_pow, L1Y, inv_mul_cancel₀ hc, L2Y]⟩
  refine ⟨y', ?_⟩
  have hcw : ∀ w : wcHM T ℓ q, wcHMScalar T ℓ q ((ℓ : ℚ_[ℓ]) ^ N) w = (ℓ ^ N : ℕ) • w :=
    fun w => by rw [L4, Nat.cast_pow]
  have hw : wcHMScalar T ℓ q ((ℓ : ℚ_[ℓ]) ^ N) (wcHMPull D q y' - t) = 0 := by
    rw [hcw, smul_sub, ← map_nsmul, hy', h8, hcw, sub_self]
  have hw0 : wcHMPull D q y' - t = 0 := by
    rw [← L2 (wcHMPull D q y' - t), ← mul_inv_cancel₀ hc, ← L1, hw, map_zero]
  exact sub_eq_zero.mp hw0

theorem wc_ext_pull_surj_of_post_bij_ext_deg_acyclic : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] (L : D ⥤ C) (R : C ⥤ D) [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] [R.Additive] (adj : L ⊣ R) (A : D) (B : C) (μ : L.obj A ≅ B), letI := HasExt.standard C; letI := HasExt.standard D; (∀ k : ℕ, Function.Bijective (fun x : Abelian.Ext A A k => x.comp (Abelian.Ext.mk₀ (adj.unit.app A ≫ R.map μ.hom)) (add_zero k))) → ∀ (I : InjectiveResolution B) (q : ℕ), (∀ a b : ℕ, 1 ≤ b → a + b = q → Subsingleton (Abelian.Ext A (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology b) a)) → Function.Surjective (((Abelian.Ext.mk₀ μ.inv).precomp _ (zero_add q)).comp (((Abelian.Ext.mk₀ μ.hom).postcomp _ (add_zero q)).comp (L.mapExtAddHom A A q))) :=
by
  intro C D _ _ _ _ L R _ _ _ _ adj A B μ H1 I q hvan
  letI instC : HasExt C := HasExt.standard C
  letI instD : HasExt D := HasExt.standard D
  haveI := adj.rightAdjoint_preservesLimits
  haveI : L.PreservesMonomorphisms := inferInstance

  have c2 : ∀ n : ℕ, Nonempty (Limits.cokernel (R.map (Limits.kernel.lift
      (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
      (I.cocomplex.d_comp_d n (n + 1) (n + 2)))) ≅
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology (n + 1)) := by
    intro n
    let ψ₁ : R.obj (Limits.kernel (I.cocomplex.d (n + 1) (n + 2))) ≅
        Limits.kernel (R.map (I.cocomplex.d (n + 1) (n + 2))) :=
      Limits.PreservesKernel.iso R _
    have hψ₁ : ψ₁.hom ≫ Limits.kernel.ι (R.map (I.cocomplex.d (n + 1) (n + 2))) =
        R.map (Limits.kernel.ι (I.cocomplex.d (n + 1) (n + 2))) := by
      simp only [ψ₁, Limits.PreservesKernel.iso_hom, Limits.kernelComparison_comp_ι]
    let ψ₂ :=
      Limits.IsLimit.conePointUniqueUpToIso
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).cyclesIsKernel
          (n + 1) (n + 2) (by simp))
        (Limits.kernelIsKernel (R.map (I.cocomplex.d (n + 1) (n + 2))))
    have hψ₂ : ψ₂.inv ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles
        (n + 1) = Limits.kernel.ι (R.map (I.cocomplex.d (n + 1) (n + 2))) :=
      Limits.IsLimit.conePointUniqueUpToIso_inv_comp
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).cyclesIsKernel
          (n + 1) (n + 2) (by simp))
        (Limits.kernelIsKernel (R.map (I.cocomplex.d (n + 1) (n + 2))))
        Limits.WalkingParallelPair.zero
    have hφ : (ψ₁ ≪≫ ψ₂.symm).hom ≫
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles (n + 1) =
        R.map (Limits.kernel.ι (I.cocomplex.d (n + 1) (n + 2))) := by
      rw [Iso.trans_hom, Iso.symm_hom, Category.assoc, hψ₂, hψ₁]
    have claim : R.map (Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
        (I.cocomplex.d_comp_d n (n + 1) (n + 2))) ≫ (ψ₁ ≪≫ ψ₂.symm).hom =
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).toCycles n (n + 1) := by
      rw [← cancel_mono (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles
        (n + 1)), Category.assoc, hφ, ← R.map_comp, Limits.kernel.lift_ι,
        HomologicalComplex.toCycles_i]
      all_goals rfl
    exact ⟨(Limits.cokernelCompIsIso _ (ψ₁ ≪≫ ψ₂.symm).hom).symm ≪≫ Limits.cokernelIsoOfEq claim ≪≫
      Limits.IsColimit.coconePointUniqueUpToIso (Limits.cokernelIsCokernel _)
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyIsCokernel
          n (n + 1) (by simp))⟩

  have c3 : ∀ {T : ShortComplex D} (hT : T.ShortExact) {S : ShortComplex C} (hS : S.ShortExact)
      (φ : T.map L ⟶ S) {X : D} (m : ℕ) (z : Abelian.Ext X T.X₃ m),
      (Abelian.Ext.mapExactFunctor L (z.comp hT.extClass rfl)).comp (Abelian.Ext.mk₀ φ.τ₁)
        (add_zero (m + 1)) =
      ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ φ.τ₃) (add_zero m)).comp
        hS.extClass rfl := by
    intro T hT S hS φ X m z
    have h₁ : (T.map L).ShortExact := hT.map_of_exact L
    have hnat : h₁.extClass.comp (Abelian.Ext.mk₀ φ.τ₁) (add_zero 1) =
        (Abelian.Ext.mk₀ φ.τ₃).comp hS.extClass (zero_add 1) :=
      h₁.extClass_naturality hS φ
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
      Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 1) (by omega), hnat]

  let τ : ∀ (Y : C) (m : ℕ), Abelian.Ext A (R.obj Y) m →+ Abelian.Ext (L.obj A) Y m :=
    fun Y m => AddMonoidHom.mk'
      (fun α => (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y))
        (add_zero m))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp])
  have hτ : ∀ (Y : C) (m : ℕ) (α : Abelian.Ext A (R.obj Y) m),
      τ Y m α = (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y))
        (add_zero m) := fun _ _ _ => rfl

  have s1a : ∀ {Y Y' : C} (g : Y ⟶ Y') (m : ℕ) (v : Abelian.Ext A (R.obj Y) m),
      τ Y' m (v.comp (Abelian.Ext.mk₀ (R.map g)) (add_zero m)) =
        (τ Y m v).comp (Abelian.Ext.mk₀ g) (add_zero m) := by
    intro Y Y' g m v
    have e1 : L.map (R.map g) ≫ adj.counit.app Y' = adj.counit.app Y ≫ g :=
      adj.counit_naturality g
    rw [hτ, hτ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, e1,
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]

  have base : ∀ Y : C, Function.Bijective (τ Y 0) := by
    intro Y
    have e : ⇑(τ Y 0) = fun x =>
        Abelian.Ext.mk₀ ((adj.homEquiv A Y).symm (Abelian.Ext.homEquiv₀ x)) := by
      funext x
      conv_lhs => rw [← Abelian.Ext.mk₀_homEquiv₀_apply x]
      rw [hτ, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀,
        Adjunction.homEquiv_counit]
    rw [e]
    exact (Abelian.Ext.mk₀_bijective _ _).comp
      ((adj.homEquiv A Y).symm.bijective.comp Abelian.Ext.homEquiv₀.bijective)

  have postD : ∀ {X Y Y' : D} (ψ : Y ≅ Y') (n : ℕ),
      Function.Bijective (fun x : Abelian.Ext X Y n => x.comp (Abelian.Ext.mk₀ ψ.hom) (add_zero n)) := by
    intro X Y Y' ψ n
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun x => x.comp (Abelian.Ext.mk₀ ψ.inv) (add_zero n), fun x => ?_, fun x => ?_⟩
    · dsimp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · dsimp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  have postC : ∀ {X Y Y' : C} (ψ : Y ≅ Y') (n : ℕ),
      Function.Bijective (fun x : Abelian.Ext X Y n => x.comp (Abelian.Ext.mk₀ ψ.hom) (add_zero n)) := by
    intro X Y Y' ψ n
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun x => x.comp (Abelian.Ext.mk₀ ψ.inv) (add_zero n), fun x => ?_, fun x => ?_⟩
    · dsimp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · dsimp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  have preC : ∀ {X X' Y : C} (φ : X' ≅ X) (n : ℕ),
      Function.Bijective (fun x : Abelian.Ext X Y n => (Abelian.Ext.mk₀ φ.hom).comp x (zero_add n)) := by
    intro X X' Y φ n
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun x => (Abelian.Ext.mk₀ φ.inv).comp x (zero_add n), fun x => ?_, fun x => ?_⟩
    · dsimp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add n) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    · dsimp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add n) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]

  obtain ⟨Y, f, g, w, hS, hRSex, hRf, hQ', ⟨e⟩⟩ : ∃ (Y : ℕ → C) (f : ∀ n, Y n ⟶ I.cocomplex.X n)
      (g : ∀ n, I.cocomplex.X n ⟶ Y (n + 1)) (w : ∀ n, f n ≫ g n = 0),
      (∀ n, (ShortComplex.mk (f n) (g n) (w n)).ShortExact) ∧
      (∀ n, ((ShortComplex.mk (f n) (g n) (w n)).map R).Exact) ∧
      (∀ n, Mono (R.map (f n))) ∧
      (∀ n p, p + (n + 1) = q → Subsingleton (Abelian.Ext A (Limits.cokernel (R.map (g n))) p)) ∧
      Nonempty (B ≅ Y 0) := by
    have hw : ∀ n, Limits.kernel.ι (I.cocomplex.d n (n + 1)) ≫
        Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
          (I.cocomplex.d_comp_d n (n + 1) (n + 2)) = 0 := by
      intro n
      rw [← cancel_mono (Limits.kernel.ι (I.cocomplex.d (n + 1) (n + 2))), Category.assoc,
        Limits.kernel.lift_ι, Limits.zero_comp]
      exact Limits.kernel.condition _
    have hSE : ∀ n, (ShortComplex.mk (Limits.kernel.ι (I.cocomplex.d n (n + 1)))
        (Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
          (I.cocomplex.d_comp_d n (n + 1) (n + 2))) (hw n)).ShortExact := by
      intro n
      have hex : (I.cocomplex.sc' n (n + 1) (n + 2)).Exact :=
        (I.cocomplex.exactAt_iff' n (n + 1) (n + 2) (by simp) (by simp)).1
          (I.cocomplex_exactAt_succ n)
      rw [ShortComplex.exact_iff_epi_kernel_lift] at hex
      have hlim : Limits.IsLimit (Limits.KernelFork.ofι
          (Limits.kernel.ι (I.cocomplex.d n (n + 1))) (hw n)) :=
        Limits.KernelFork.IsLimit.ofι _ _
          (fun g' hg' => Limits.kernel.lift _ g' (by
            rw [← Limits.kernel.lift_ι (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
              (I.cocomplex.d_comp_d n (n + 1) (n + 2)), ← Category.assoc, hg', Limits.zero_comp]))
          (fun g' hg' => Limits.kernel.lift_ι _ _ _)
          (fun g' hg' m hm => by
            rw [← cancel_mono (Limits.kernel.ι (I.cocomplex.d n (n + 1))), hm,
              Limits.kernel.lift_ι])
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · exact ShortComplex.exact_of_f_is_kernel _ hlim
      · exact (inferInstance : Mono (Limits.kernel.ι (I.cocomplex.d n (n + 1))))
      · exact hex
    refine ⟨fun n => Limits.kernel (I.cocomplex.d n (n + 1)),
      fun n => Limits.kernel.ι (I.cocomplex.d n (n + 1)),
      fun n => Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
        (I.cocomplex.d_comp_d n (n + 1) (n + 2)), hw, hSE, ?_, ?_, ?_, ?_⟩
    · intro n
      exact (hSE n).exact.map_of_mono_of_preservesKernel R (hSE n).mono_f inferInstance
    · intro n
      exact (inferInstance : Mono (R.map (Limits.kernel.ι (I.cocomplex.d n (n + 1)))))
    · intro n p hpn
      obtain ⟨ψ⟩ := c2 n
      haveI := hvan p (n + 1) (by omega) hpn
      exact ⟨fun a b => (postD (X := A) ψ p).1 (Subsingleton.elim _ _)⟩
    · have h0 := I.exact₀.fIsKernel
      exact ⟨(HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 B).symm ≪≫
        Limits.IsLimit.conePointUniqueUpToIso h0 (Limits.limit.isLimit _)⟩

  have hfac : ∀ n, Limits.factorThruImage (R.map (g n)) ≫ Limits.image.ι (R.map (g n)) =
      R.map (g n) := fun n => Limits.image.fac _
  have wT : ∀ n, R.map (f n) ≫ Limits.factorThruImage (R.map (g n)) = 0 := by
    intro n
    rw [← cancel_mono (Limits.image.ι (R.map (g n))), Category.assoc, hfac, ← R.map_comp, w n,
      R.map_zero, Limits.zero_comp]
  have hT : ∀ n, (ShortComplex.mk _ _ (wT n)).ShortExact := by
    intro n
    let m : ShortComplex.mk _ _ (wT n) ⟶ (ShortComplex.mk (f n) (g n) (w n)).map R :=
      { τ₁ := 𝟙 _, τ₂ := 𝟙 _, τ₃ := Limits.image.ι (R.map (g n))
        comm₁₂ := by simp
        comm₂₃ := by simp [hfac] }
    haveI : Epi m.τ₁ := by change Epi (𝟙 _); infer_instance
    haveI : IsIso m.τ₂ := by change IsIso (𝟙 _); infer_instance
    haveI : Mono m.τ₃ := by change Mono (Limits.image.ι (R.map (g n))); infer_instance
    haveI := hRf n
    exact ShortComplex.ShortExact.mk' ((ShortComplex.exact_iff_of_epi_of_isIso_of_mono m).mpr
      (hRSex n)) (by dsimp; infer_instance) (by dsimp; infer_instance)
  have wU : ∀ n, Limits.image.ι (R.map (g n)) ≫ Limits.cokernel.π (R.map (g n)) = 0 := by
    intro n
    rw [← cancel_epi (Limits.factorThruImage (R.map (g n))), ← Category.assoc, hfac,
      Limits.cokernel.condition, Limits.comp_zero]
  have hU : ∀ n, (ShortComplex.mk _ _ (wU n)).ShortExact := by
    intro n
    have hT0 : (ShortComplex.mk _ _ (Limits.cokernel.condition (R.map (g n)))).Exact :=
      ShortComplex.exact_cokernel (R.map (g n))
    let m : ShortComplex.mk _ _ (Limits.cokernel.condition (R.map (g n))) ⟶
        ShortComplex.mk _ _ (wU n) :=
      { τ₁ := Limits.factorThruImage (R.map (g n)), τ₂ := 𝟙 _, τ₃ := 𝟙 _
        comm₁₂ := by simp [hfac]
        comm₂₃ := by simp }
    haveI : Epi m.τ₁ := by change Epi (Limits.factorThruImage (R.map (g n))); infer_instance
    haveI : IsIso m.τ₂ := by change IsIso (𝟙 _); infer_instance
    haveI : Mono m.τ₃ := by change Mono (𝟙 _); infer_instance
    exact ShortComplex.ShortExact.mk' ((ShortComplex.exact_iff_of_epi_of_isIso_of_mono m).mp hT0)
      (by dsimp; infer_instance) (by dsimp; infer_instance)

  have hJ : ∀ n, Injective (I.cocomplex.X n) := I.injective
  have s1b' : ∀ (n m : ℕ) (x : Abelian.Ext A (Limits.image (R.map (g n))) m),
      τ (Y n) (m + 1) (x.comp (hT n).extClass rfl) =
        (τ (Y (n + 1)) m (x.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n)))) (add_zero m))).comp
          (hS n).extClass rfl := by
    intro n m x
    let φ : (ShortComplex.mk _ _ (wT n)).map L ⟶ ShortComplex.mk (f n) (g n) (w n) :=
      { τ₁ := adj.counit.app (Y n)
        τ₂ := adj.counit.app (I.cocomplex.X n)
        τ₃ := L.map (Limits.image.ι (R.map (g n))) ≫ adj.counit.app (Y (n + 1))
        comm₁₂ := (adj.counit_naturality (f n)).symm
        comm₂₃ := by
          show adj.counit.app (I.cocomplex.X n) ≫ g n =
            L.map (Limits.factorThruImage (R.map (g n))) ≫
              L.map (Limits.image.ι (R.map (g n))) ≫ adj.counit.app (Y (n + 1))
          rw [← Category.assoc, ← L.map_comp, hfac]
          exact (adj.counit_naturality (g n)).symm }
    have h3 := c3 (hT n) (hS n) φ m x
    rw [hτ, hτ]
    refine h3.trans ?_
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega), Abelian.Ext.mk₀_comp_mk₀]

  have towerS : ∀ m n, m + n = q → Function.Surjective (τ (Y n) m) := by
    intro m
    induction m with
    | zero => intro n _; exact (base (Y n)).2
    | succ m ih =>
      intro n hmn z
      haveI := hJ n
      have h0 : z.comp (Abelian.Ext.mk₀ (f n)) (add_zero _) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨u, hu⟩ : ∃ u : Abelian.Ext (L.obj A) (Y (n + 1)) m,
          u.comp (hS n).extClass rfl = z :=
        Abelian.Ext.covariant_sequence_exact₁ (L.obj A) (hS n) z h0 rfl
      obtain ⟨v, hv⟩ := ih (n + 1) (by omega) u
      haveI := hQ' n m (by omega)
      have hc : v.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (R.map (g n)))) (add_zero m) = 0 :=
        Subsingleton.elim _ _
      obtain ⟨t, ht⟩ : ∃ t : Abelian.Ext A (Limits.image (R.map (g n))) m,
          t.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n)))) (add_zero m) = v :=
        Abelian.Ext.covariant_sequence_exact₂ A (hU n) v hc
      refine ⟨t.comp (hT n).extClass rfl, ?_⟩
      rw [s1b' n m t, ht, hv, hu]

  have hτB : Function.Surjective (τ B q) := by
    intro z
    obtain ⟨v, hv⟩ := towerS q 0 (by omega) (z.comp (Abelian.Ext.mk₀ e.hom) (add_zero q))
    obtain ⟨v', hv'⟩ := (postD (X := A) (R.mapIso e) q).2 v
    have hv'' : v'.comp (Abelian.Ext.mk₀ (R.map e.hom)) (add_zero q) = v := hv'
    refine ⟨v', (postC (X := L.obj A) e q).1 ?_⟩
    show (τ B q v').comp (Abelian.Ext.mk₀ e.hom) (add_zero q) =
      z.comp (Abelian.Ext.mk₀ e.hom) (add_zero q)
    rw [← s1a e.hom q v', hv'', hv]

  have key : L.map (adj.unit.app A ≫ R.map μ.hom) ≫ adj.counit.app B = μ.hom := by
    have e2 : L.map (R.map μ.hom) ≫ adj.counit.app B = adj.counit.app (L.obj A) ≫ μ.hom :=
      adj.counit_naturality μ.hom
    have e3 : L.map (adj.unit.app A) ≫ adj.counit.app (L.obj A) = 𝟙 _ :=
      adj.left_triangle_components A
    rw [L.map_comp, Category.assoc, e2, ← Category.assoc]
    erw [e3]
    exact Category.id_comp _
  have hb : Function.Surjective (fun β : Abelian.Ext A A q => (Abelian.Ext.mk₀ μ.inv).comp
      (τ B q (β.comp (Abelian.Ext.mk₀ (adj.unit.app A ≫ R.map μ.hom)) (add_zero q))) (zero_add q)) :=
    (preC μ.symm q).2.comp (hτB.comp (H1 q).2)
  convert hb using 1
  funext β
  show (Abelian.Ext.mk₀ μ.inv).comp ((Abelian.Ext.mapExactFunctor L β).comp
      (Abelian.Ext.mk₀ μ.hom) (add_zero q)) (zero_add q) =
    (Abelian.Ext.mk₀ μ.inv).comp
      (τ B q (β.comp (Abelian.Ext.mk₀ (adj.unit.app A ≫ R.map μ.hom)) (add_zero q))) (zero_add q)
  rw [hτ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
    Abelian.Ext.comp_assoc _ _ _ (add_zero q) (zero_add 0) (by omega), Abelian.Ext.mk₀_comp_mk₀,
    key]

theorem wc_et_proper_shens_module_ext_vanish_of_point_supp : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of A)) [IsProper f] (m : ℕ), 0 < m → ∀ (x₀ : Y), IsClosed ({x₀} : Set Y) → IsSepClosed (Y.residueField x₀) → ∀ (N : SheafOfModules.{u+1} (wcEtZModRing Y m)), (∀ x : Y, f x = IsLocalRing.closedPoint A → x ≠ x₀ → Subsingleton ((wcEtStalk Y x).obj ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj N))) → ∀ p : ℕ, 1 ≤ p → Subsingleton (@Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing Y m)) _ _ (HasExt.standard _) (SheafOfModules.unit (wcEtZModRing Y m)) N p) :=
by
  intro A _ _ _ Y f _ m hm x₀ hcl hsep N hN p hp
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _

  obtain ⟨α, -, -, hR⟩ := wc_et_zmod_ring_locbij Y m
  have T : m • 𝟙 N = 0 := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    ext s
    have h0 : ((0 : N ⟶ N).val.app V).hom s = 0 := by
      first | rfl | simp | (rw [SheafOfModules.zero_val]; rfl)
    have hz : ∀ k : ℕ, ((k • 𝟙 N).val.app V).hom s = k • s := by
      intro k
      induction k with
      | zero => rw [zero_nsmul, zero_nsmul]; exact h0
      | succ k ih =>
        rw [succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add,
          LinearMap.add_apply, ih, succ_nsmul]
        rfl
    rw [hz, ← Nat.cast_smul_eq_nsmul (R := ↑((wcEtZModRing Y m).obj.obj V)), hR V,
      zero_smul, h0]
  have htor : m • 𝟙 ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj N) = 0 := by
    rw [← (SheafOfModules.toSheaf (wcEtZModRing Y m)).map_id, ← Functor.map_nsmul, T,
      Functor.map_zero]
  set G := (SheafOfModules.toSheaf (wcEtZModRing Y m)).obj N with hGdef

  obtain ⟨L, ⟨adj⟩, -, -⟩ := wc_et_push_left_adjoint (Y.fromSpecResidueField x₀)
  haveI := adj.isRightAdjoint
  haveI := adj.rightAdjoint_preservesLimits.{0, 0}
  haveI : (wcEtPush (Y.fromSpecResidueField x₀)).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isRightAdjoint _
  haveI : (wcEtPush (Y.fromSpecResidueField x₀)).Additive :=
    Functor.additive_of_preserves_binary_products _
  haveI : L.Additive := adj.left_adjoint_additive
  have htor'' : m • 𝟙 ((wcEtPush (Y.fromSpecResidueField x₀)).obj (L.obj G)) = 0 := by
    rw [← (wcEtPush (Y.fromSpecResidueField x₀)).map_id, ← Functor.map_nsmul, ← L.map_id,
      ← L.map_nsmul, htor, L.map_zero, Functor.map_zero]
  have htorK : m • 𝟙 (Limits.kernel (adj.unit.app G)) = 0 := by
    have hG1 : m • 𝟙 ((𝟭 (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})).obj G) = 0 :=
      htor
    apply (cancel_mono (Limits.kernel.ι (adj.unit.app G))).mp
    rw [Preadditive.nsmul_comp, Category.id_comp, Limits.zero_comp]
    have e : Limits.kernel.ι (adj.unit.app G) ≫
        (m • 𝟙 ((𝟭 (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})).obj G)) =
        m • Limits.kernel.ι (adj.unit.app G) := by
      rw [Preadditive.comp_nsmul]
      exact congrArg (fun g => m • g) (Category.comp_id _)
    rw [← e, hG1, Limits.comp_zero]
  have htorC : m • 𝟙 (Limits.cokernel (adj.unit.app G)) = 0 := by
    have hG2 : m • 𝟙 ((L ⋙ wcEtPush (Y.fromSpecResidueField x₀)).obj G) = 0 := htor''
    apply (cancel_epi (Limits.cokernel.π (adj.unit.app G))).mp
    rw [Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero]
    have e : (m • 𝟙 ((L ⋙ wcEtPush (Y.fromSpecResidueField x₀)).obj G)) ≫
        Limits.cokernel.π (adj.unit.app G) = m • Limits.cokernel.π (adj.unit.app G) := by
      rw [Preadditive.nsmul_comp]
      exact congrArg (fun g => m • g) (Category.id_comp _)
    rw [← e, hG2, Limits.zero_comp]

  have hpp := wc_et_point_push_stalks Y x₀ L adj
  have hoff : ∀ x : Y, x ≠ x₀ →
      Subsingleton ((wcEtStalk Y x).obj ((wcEtPush (Y.fromSpecResidueField x₀)).obj (L.obj G))) :=
    fun x hx => hpp.2 (L.obj G) x (by rw [hcl.closure_eq]; exact hx)
  have hinj : ∀ x : Y, f x = IsLocalRing.closedPoint A →
      Function.Injective ((wcEtStalk Y x).map (adj.unit.app G)).hom := by
    intro x hx
    by_cases hne : x = x₀
    · subst hne
      haveI := hpp.1 G
      exact (ConcreteCategory.bijective_of_isIso ((wcEtStalk Y x).map (adj.unit.app G))).1
    · haveI : Subsingleton ((wcEtStalk Y x).obj
          ((𝟭 (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})).obj G)) := hN x hx hne
      intro a b _
      exact Subsingleton.elim a b
  have hsurj : ∀ x : Y, f x = IsLocalRing.closedPoint A →
      Function.Surjective ((wcEtStalk Y x).map (adj.unit.app G)).hom := by
    intro x _
    by_cases hne : x = x₀
    · subst hne
      haveI := hpp.1 G
      exact (ConcreteCategory.bijective_of_isIso ((wcEtStalk Y x).map (adj.unit.app G))).2
    · haveI : Subsingleton ((wcEtStalk Y x).obj
          ((L ⋙ wcEtPush (Y.fromSpecResidueField x₀)).obj G)) := hoff x hne
      intro y
      exact ⟨0, Subsingleton.elim _ _⟩
  have hK : ∀ x : Y, f x = IsLocalRing.closedPoint A →
      Subsingleton ((wcEtStalk Y x).obj (Limits.kernel (adj.unit.app G))) := fun x hx =>
    wc_et_stalk_kernel_subsingleton _ _ (adj.unit.app G) x (hinj x hx)
  have hC : ∀ x : Y, f x = IsLocalRing.closedPoint A →
      Subsingleton ((wcEtStalk Y x).obj (Limits.cokernel (adj.unit.app G))) := fun x hx =>
    wc_r2gc_stalk_coker_subsingleton _ _ (adj.unit.app G) x (hsurj x hx)

  have hKv := wc_et_ab_ext_vanish_of_closed_fibre_stalks A Y f m hm _ htorK hK
  have hCv := wc_et_ab_ext_vanish_of_closed_fibre_stalks A Y f m hm _ htorC hC
  have hbij := wc_ext_postcomp_bij_of_ker_coker_acyclic
    ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))) G _ (adj.unit.app G) hKv hCv p

  have hG'' := wc_qm_point_sheaf_ext_vanish Y x₀ hcl hsep _ hoff p hp
  haveI : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((L ⋙ wcEtPush (Y.fromSpecResidueField x₀)).obj G) p) := hG''
  haveI hGv : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G p) :=
    ⟨fun a b => hbij.1 (Subsingleton.elim _ _)⟩
  obtain ⟨E⟩ := wc_et_zmod_modext_toSheaf_equiv Y m hm N p
  exact E.subsingleton

theorem wc_lft_closed_point_residue_sepclosed : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)) [LocallyOfFiniteType f] (x : X), IsClosed ({x} : Set X) → f x = IsLocalRing.closedPoint A → IsSepClosed (X.residueField x) :=
by
  intro A _ _ _ X f _ x hx hfx

  have algpart : ∀ (K : Type u) [Field K] (φ : A →+* K), φ.FiniteType →
      RingHom.ker φ = IsLocalRing.maximalIdeal A → IsSepClosed K := by
    intro K _ φ hφ hker
    have hloc : IsLocalHom φ := by
      constructor
      intro a ha
      by_contra hna
      have hm : a ∈ IsLocalRing.maximalIdeal A := (IsLocalRing.mem_maximalIdeal a).mpr hna
      rw [← hker, RingHom.mem_ker] at hm
      rw [hm] at ha
      exact not_isUnit_zero ha
    set ψ : IsLocalRing.ResidueField A →+* K := IsLocalRing.ResidueField.lift φ with hψ
    have hcomp : ψ.comp (IsLocalRing.residue A) = φ := IsLocalRing.ResidueField.lift_comp_residue φ
    have hψft : ψ.FiniteType := by
      apply RingHom.FiniteType.of_comp_finiteType (f := IsLocalRing.residue A)
      rw [hcomp]; exact hφ
    letI : Algebra (IsLocalRing.ResidueField A) K := ψ.toAlgebra
    haveI : Algebra.FiniteType (IsLocalRing.ResidueField A) K := hψft
    haveI : Module.Finite (IsLocalRing.ResidueField A) K :=
      finite_of_finite_type_of_isJacobsonRing (IsLocalRing.ResidueField A) K
    haveI : Algebra.IsAlgebraic (IsLocalRing.ResidueField A) K := Algebra.IsAlgebraic.of_finite _ _
    exact Algebra.IsAlgebraic.isSepClosed (F := IsLocalRing.ResidueField A)

  haveI : IsClosedImmersion (X.fromSpecResidueField x) :=
    (AlgebraicGeometry.isClosed_singleton_iff_isClosedImmersion).mp hx
  set g := X.fromSpecResidueField x ≫ f with hg
  haveI : LocallyOfFiniteType g := inferInstance
  set φc := Spec.preimage g with hφc
  have hmap : Spec.map φc = g := Spec.map_preimage g
  have hft : (CommRingCat.Hom.hom φc).FiniteType := by
    have : LocallyOfFiniteType (Spec.map φc) := by rw [hmap]; infer_instance
    exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
  have hker : RingHom.ker φc.hom = IsLocalRing.maximalIdeal A := by
    let pt : Spec (X.residueField x) := ⟨⊥, Ideal.isPrime_bot⟩
    have h1 : (Spec.map φc) pt = f x := by
      rw [hmap, hg, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
    rw [hfx] at h1
    have h2 := congrArg PrimeSpectrum.asIdeal h1
    rw [Spec.map_apply] at h2
    change Ideal.comap φc.hom (⊥ : Ideal (X.residueField x)) = IsLocalRing.maximalIdeal A at h2
    rw [RingHom.ker_eq_comap_bot]
    exact h2
  exact algpart (X.residueField x) φc.hom hft hker

theorem wc_pfam_xwt_sp_torsion_top_surj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (j : Fin D.m) (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : Vy.left ≅ Spec (.of A))
    (hVy : Vy.hom (e.inv (IsLocalRing.closedPoint A)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (L : Type u) [Field L] [IsSepClosed L] (eL : Ty.left ≅ Spec (.of L))
    (Vξ : (wcProjK F'' M').ProEt) (ι : Vξ ⟶ Vy) (uξ : Ty ⟶ Vξ)
    (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    (e' : Vξ.left ≅ Spec (.of A')) (hιu : uξ ≫ ι = uy)
    (hΔξ : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      ((ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))) ∈ Δ)
    (hclξ : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
      y ∈ closure {(ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))})
    (k : ℕ) (hk : 1 ≤ k) (Dk : wcZModPullData ((wcProEtPullback h).map uξ).left (ℓ ^ k))
    (hDk : wcZModPullCanonical Dk) :
    Function.Surjective (wcZModPull Dk (2 * (n - 1))) :=
by
  classical

  have hH' := hH
  obtain ⟨-, hprop, -⟩ := hH'
  haveI := hprop
  haveI hfP : IsProper (Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) := by
    first
    | exact inferInstance
    | exact MorphismProperty.of_isPullback (IsPullback.of_hasPullback h (e'.inv ≫ Vξ.hom)) hprop
  have hm0 : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k
  have hℓK : ((ℓ : ℕ) : F'') ≠ 0 := by
    intro h0
    have hp : (ringChar F'').Prime := CharP.char_is_prime F'' (ringChar F'')
    have hdvd : ringChar F'' ∣ ℓ := (ringChar.spec F'' ℓ).mp h0
    have hpl : ringChar F'' = ℓ :=
      ((Fact.out : ℓ.Prime).eq_one_or_self_of_dvd _ hdvd).resolve_left hp.ne_one
    letI := Fintype.ofFinite F''
    have hc : ((Fintype.card F'' : ℕ) : F'') = 0 := FiniteField.cast_card_eq_zero F''
    have hc' : ringChar F'' ∣ Fintype.card F'' := (ringChar.spec F'' _).mp hc
    apply hℓ
    rw [← hpl, Nat.card_eq_fintype_card]
    exact hc'
  have hunitK : IsUnit (((ℓ ^ k : ℕ) : F'')) :=
    isUnit_iff_ne_zero.mpr (by rw [Nat.cast_pow]; exact pow_ne_zero _ hℓK)
  have hmu : IsUnit (((ℓ ^ k : ℕ) : A')) := by
    have h1 := hunitK.map (Spec.preimage (e'.inv ≫ Vξ.hom ≫ wcProjKStr F'' M')).hom
    rwa [map_natCast] at h1
  have hunitℓ : IsUnit (((ℓ : ℕ) : A')) := by
    have h1 := (isUnit_iff_ne_zero.mpr hℓK).map
      (Spec.preimage (e'.inv ≫ Vξ.hom ≫ wcProjKStr F'' M')).hom
    rwa [map_natCast] at h1

  obtain ⟨Ω, _, _, ξ, hξ, D', Θ₀, Θ₁, hΘ⟩ := wc_pfam_xwt_sp_etale_bridge F' F'' Y n hn hn2 D ℓ hℓ
    M' Xu h Δ lam p hH hPP j Vy Ty uy vy A e hVy L eL Vξ ι uξ A' e' hιu hΔξ hclξ k Dk hDk
    (2 * (n - 1))

  obtain ⟨x₀, hx₀, hsm, hmod⟩ := wc_pfam_xwt_trait_odp_model F' F'' Y n hn hn2 D ℓ hℓ
    M' Xu h Δ lam p hH hPP j Vy Ty uy vy A e hVy L eL Vξ ι uξ A' e' hιu hΔξ hclξ

  have hloc0 : ∀ x : ↥(Limits.pullback h (e'.inv ≫ Vξ.hom)),
      Limits.pullback.snd h (e'.inv ≫ Vξ.hom) x = IsLocalRing.closedPoint A' →
      ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
        (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
        (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback h (e'.inv ≫ Vξ.hom)) x))
          (Scheme.Etale.forget (Limits.pullback h (e'.inv ≫ Vξ.hom))))
        (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
        (a' : Spec (.of B) ⟶ Limits.pullback h (e'.inv ≫ Vξ.hom)),
        wcHalShData x B Λ' W'' φ' a' →
        Nat.card (wcEtCoh (Limits.pullback (a' ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ)
          (ℓ ^ k) 0) = ℓ ^ k ∧
        ∀ b : ℕ, n - 1 < b →
          Subsingleton (wcEtCoh (Limits.pullback (a' ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ)
            (ℓ ^ k) b) := by
    intro x hx B _ _ _ Λ' _ _ W'' φ' a' hB
    by_cases hxx : x = x₀
    · subst hxx
      obtain ⟨hdom, hdvr, π, c, hπ, hc, x₁, hX, hx₁, B₀, _, _, _, Λ₀, _, _, W₀, φ₀, a₀, hB₀, θ,
        hθ⟩ := hmod B Λ' W'' φ' a' hB
      haveI := hdom
      haveI := hdvr
      obtain ⟨h0, hhi⟩ := wc_quad_model_iso_milnor_fibre_high A' ℓ Fact.out hunitℓ n hn hn2 π c
        hπ hc x₁ hX hx₁ B₀ Λ₀ W₀ φ₀ a₀ hB₀ _ (Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) B a' θ hθ
        Ω ξ hξ k hk
      exact ⟨h0, fun b hb => hhi b (by omega)⟩
    · obtain ⟨U, hxU, hsmU⟩ := hsm x hx hxx
      obtain ⟨h0, hq⟩ := wc_smooth_open_shens_milnor_fibre_acyclic A' _
        (Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) U hsmU (ℓ ^ k) hmu x hxU hx B Λ' W'' φ' a' hB Ω ξ
      exact ⟨h0, fun b hb => hq b (by omega)⟩
  have hlocx : ∀ x : ↥(Limits.pullback h (e'.inv ≫ Vξ.hom)),
      Limits.pullback.snd h (e'.inv ≫ Vξ.hom) x = IsLocalRing.closedPoint A' → x ≠ x₀ →
      ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
        (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
        (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Limits.pullback h (e'.inv ≫ Vξ.hom)) x))
          (Scheme.Etale.forget (Limits.pullback h (e'.inv ≫ Vξ.hom))))
        (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
        (a' : Spec (.of B) ⟶ Limits.pullback h (e'.inv ≫ Vξ.hom)),
        wcHalShData x B Λ' W'' φ' a' → ∀ b : ℕ, 1 ≤ b →
          Subsingleton (wcEtCoh (Limits.pullback (a' ≫ Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ)
