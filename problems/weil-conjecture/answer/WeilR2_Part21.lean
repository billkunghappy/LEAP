            (Ideal.mul_mem_left _ _ hs))
        rw [hSii] at h1
        rcases hp.mem_or_mem h1 with h | h
        · left
          rw [← hSii] at h
          have := Ideal.add_mem _ hr h
          rwa [sub_add_cancel] at this
        · right
          rw [← hSii] at h
          have := Ideal.add_mem _ hs h
          rwa [sub_add_cancel] at this
    · apply le_antisymm
      · intro x hx
        rw [Ideal.mem_comap] at hx
        obtain ⟨r, hr⟩ := hRi x
        rw [Ideal.mem_span_singleton'] at hr
        obtain ⟨y, hy⟩ := hr
        have hx' : x = AdjoinRoot.of _ r + y * AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C a) := by
          rw [hy]; ring
        have h1 : τ x = AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C (σ a)) (σ r) +
            τ y * AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C (σ a)) := by
          have e1 := RingHom.congr_fun hτof r
          rw [RingHom.comp_apply, RingHom.comp_apply] at e1
          rw [hx', map_add, map_mul, hτroot, e1]
        have h2 : AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C (σ a)) (σ r) ∈
            Ideal.span {AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C (σ a))} := by
          have := Ideal.sub_mem _ hx (Ideal.mul_mem_left _ (τ y) (Ideal.mem_span_singleton_self _))
