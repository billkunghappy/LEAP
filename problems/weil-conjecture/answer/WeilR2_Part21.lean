      AdjoinRoot.liftAlgHom_root _ _ _ _
    have hΨof : ∀ s, Ψ (AdjoinRoot.of _ s) = (1 : AdjoinRoot (Polynomial.X ^ N - Polynomial.C a)) ⊗ₜ[R] s :=
