  refine ⟨W, hW, φ, hyW', hΔW, hunifW, z, hétW, V, hV, e, ρ, hNoeth, hSm, he1, he2, hρ1, hρκ, ?_⟩
  exact ⟨hdimO, eX, t, b, a, H, w, heX, hmO, fun i => hb (Sum.inl i), fun k => hb (Sum.inr k),
