theorem wc_et_shens_res_ker_le_range_of_milnor : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of A)) [IsProper f] (m : ℕ), 0 < m → IsUnit (m : A) → ∀ (N : ℕ), 1 ≤ N → ∀ (x₀ : Y), f x₀ = IsLocalRing.closedPoint A → (∀ x : Y, f x = IsLocalRing.closedPoint A → x ≠ x₀ → ∃ U : Y.Opens, x ∈ U ∧ Smooth (U.ι ≫ f)) → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)), (∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y x₀)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a' : Spec (.of B) ⟶ Y), wcHalShData x₀ B Λ W' φ a' → Nat.card (wcEtCoh (Limits.pullback (a' ≫ f) z) m 0) = m ∧ ∀ q : ℕ, 1 ≤ q → q + 1 ≤ N → Subsingleton (wcEtCoh (Limits.pullback (a' ≫ f) z) m q)) → ∀ (D' : wcEtPullData (Limits.pullback.fst f z) m) (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y x₀)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a' : Spec (.of B) ⟶ Y), wcHalShData x₀ B Λ W' φ a' → ∀ (r : Limits.pullback (a' ≫ f) z ⟶ Limits.pullback f z), r ≫ Limits.pullback.fst f z = Limits.pullback.fst (a' ≫ f) z ≫ a' → r ≫ Limits.pullback.snd f z = Limits.pullback.snd (a' ≫ f) z → ∀ (Dr : wcEtPullData r m) (y : wcEtZModExt (Limits.pullback f z) m N), wcEtPull Dr N y = 0 → ∃ w : wcEtZModExt Y m N, wcEtPull D' N w = y :=
by
  classical
  intro A _ _ _ Y f _ m hm0 hmu N hN x₀ hx₀ hsm Ω _ _ z hmil D' B _ _ _ Λ _ _ W' φ a' hB
    r hr₁ hr₂ Dr y hz

  have hloc : ∀ p : Y, f p = IsLocalRing.closedPoint A →
