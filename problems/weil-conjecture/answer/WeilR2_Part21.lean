        apply NatTrans.ext
        funext a
        obtain ⟨a⟩ := a
        have tri' : ((Over.forgetAdjStar V).unit.app a).left ≫
            (Over.forgetAdjStar V).counit.app a.left = 𝟙 _ :=
          (Over.forgetAdjStar V).left_triangle_components a
        have hD : ((Over.post bc).map ((Over.forgetAdjStar V).unit.app a)).left ≫
