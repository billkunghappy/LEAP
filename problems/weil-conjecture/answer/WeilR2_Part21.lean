import WeilR2_Part20
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_qmpl_blowup_transfer : ∀ (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A) →
    ∀ (n : ℕ), Even n → 4 ≤ n → ∀ (π : A) (c : Matrix (Fin n) (Fin n) A),
    IsLocalRing.maximalIdeal A = Ideal.span {π} → IsUnit (c + c.transpose).det →
    ∀ (x₀ : Spec (.of (wcQuadModelRing A n π c))),
    (∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀) →
    ∀ (B₀ : Type u) [CommRing B₀] [HenselianLocalRing B₀]
    [IsSepClosed (IsLocalRing.ResidueField B₀)]
    (Λ₀ : Type u) [SmallCategory Λ₀] [IsCofiltered Λ₀]
    (W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c)))))
    (φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left)
    (a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))),
    wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀ →
    ∀ (L : Type u) [Field L] [IsSepClosed L] (φA : A →+* L), Function.Injective φA →
    (letI := φA.toAlgebra; Algebra.IsAlgebraic A L) →
    ∀ (σ₂ : L →+* L), σ₂.comp φA = φA →
    ∀ (L' : Type u) [Field L'] [IsSepClosed L'] (ιL : L →+* L'),
    (letI := ιL.toAlgebra; Algebra.IsAlgebraic L L') →
    ∀ (S' : L') (σ' : L' →+* L'), S' ^ 2 = ιL (φA π) → σ'.comp ιL = ιL.comp σ₂ → σ' S' = S' →
    (∀ k : ℕ, 1 ≤ k → ∀ y : L', y ^ (ℓ ^ k) = S' → IsPrimitiveRoot (σ' y * y⁻¹) (ℓ ^ k)) →
    ∀ (XE : Scheme.{u}) (p : XE ⟶ Spec (.of B₀)) (q : XE ⟶ Spec (.of L)),
    IsPullback p q (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom φA)) →
    ∀ (Xs : Scheme.{u}) (ι : Xs ⟶ Spec (.of B₀))
      (s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))),
    IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A) →
    ∀ (w : XE ⟶ XE) (hw₁ : w ≫ p = p), w ≫ q = q ≫ Spec.map (CommRingCat.ofHom σ₂) →
    ∀ (Dp : wcHMPullData p ℓ), wcHMPullCanonical Dp →
    ∀ (Dτ : wcHMPullData w ℓ), wcHMPullCanonical Dτ →
    ∀ (Di : wcHMPullData ι ℓ), wcHMPullCanonical Di →
    ∀ (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE ℓ))),
    haveI := Dp.cont
    haveI := Dτ.cont
    haveI : (wcProEtBC p ⋙ wcProEtBC w).IsContinuous
        (Scheme.ProEt.topology (Spec (.of B₀))) (Scheme.ProEt.topology XE) :=
      Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology XE) _
    let α : wcProEtBC p ⟶ wcProEtBC p ⋙ wcProEtBC w :=
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) p :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) p :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong p))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong w))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
        (Q := ⊤) _ _ _ hw₁.symm).hom
    haveI := Dp.additive
    haveI := Dτ.additive
    haveI := Di.additive
    ∀ (hφ : (Dp.φ ≫ ((wcProEtBC p).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.ProEt.topology (Spec (.of B₀))) (Scheme.ProEt.topology XE)).map Dτ.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans α RingCat.{u+1}
          (Scheme.ProEt.topology (Spec (.of B₀))) (Scheme.ProEt.topology XE)).app
          (wcRingSheaf XE ℓ) = Dp.φ)
      (t : (Dτ.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶
        I.cochainComplex),
      (Dτ.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t =
        (HomologicalComplex.singleMapHomologicalComplex Dτ.Φ (ComplexShape.up ℤ) 0).hom.app
          (SheafOfModules.unit (wcRingSheaf XE ℓ)) ≫
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          ((Dτ.adj.homEquiv _ _).symm
            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
              (wcProEtBC w) _ _ Dτ.cont Dτ.φ)) ≫
        I.ι' →
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC p) _ _ Dp.cont Dp.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dp.adj
    let Pw := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC w) _ _ Dτ.cont Dτ.φ
    haveI : Pw.Additive := Adjunction.right_adjoint_additive Dτ.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    let γ : Pw ⋙ P ⟶ P := (SheafOfModules.pushforwardComp Dp.φ Dτ.φ).hom ≫
        SheafOfModules.pushforwardNatTrans _ α ≫ (SheafOfModules.pushforwardCongr hφ).hom
    let Tflat := (Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app
          I.cochainComplex ≫
        (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ Dτ.Φ ⋙ Pw from Dτ.adj.unit)
          (ComplexShape.up ℤ)).app I.cochainComplex ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Dτ.Φ ⋙ Pw))
          (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
        (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map t
    let T : K ⟶ K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).map Tflat ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
          (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
        (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I.cochainComplex
    let TΨ := (Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map T
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
    ∃ (A' : Type u) (_ : CommRing A') (_ : IsDomain A') (_ : IsDiscreteValuationRing A')
      (_ : HenselianLocalRing A') (_ : IsSepClosed (IsLocalRing.ResidueField A')) (π' : A'),
      IsUnit ((ℓ : ℕ) : A') ∧ IsLocalRing.maximalIdeal A' = Ideal.span {π'} ∧
    ∃ (Xm : Scheme.{u}) (f : Xm ⟶ Spec (.of A')), QuasiCompact f ∧ QuasiSeparated f ∧
    (∀ x : Xm, ∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))),
      x ∈ U ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f) ∧
    (∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))))
      (y : U.toScheme),
      WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f ∧
      Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g y) ∧
      Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g y)) ∧
    ∃ (φ' : A' →+* L'), Function.Injective φ' ∧
      (letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L') ∧ σ'.comp φ' = φ' ∧
      wcMntTame ℓ φ' σ' π' ∧
    ∃ (XE' : Scheme.{u}) (p' : XE' ⟶ Xm) (q' : XE' ⟶ Spec (.of L')),
      IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')) ∧
    ∃ (Xs' : Scheme.{u}) (ι' : Xs' ⟶ Xm)
      (s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))),
      IsPullback ι' s' f (wcQmSp A') ∧
    ∃ (w' : XE' ⟶ XE') (hw₁' : w' ≫ p' = p'),
      w' ≫ q' = q' ≫ Spec.map (CommRingCat.ofHom σ') ∧
    ((∀ (Dp' : wcHMPullData p' ℓ), wcHMPullCanonical Dp' →
    ∀ (Dτ' : wcHMPullData w' ℓ), wcHMPullCanonical Dτ' →
    ∀ (Di' : wcHMPullData ι' ℓ), wcHMPullCanonical Di' →
    ∀ (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ))),
    haveI := Dp'.cont
    haveI := Dτ'.cont
    haveI : (wcProEtBC p' ⋙ wcProEtBC w').IsContinuous
        (Scheme.ProEt.topology Xm) (Scheme.ProEt.topology XE') :=
      Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology XE') _
    let α' : wcProEtBC p' ⟶ wcProEtBC p' ⋙ wcProEtBC w' :=
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) p' :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) p' :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong p'))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) w' :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) w' :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong w'))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
        (Q := ⊤) _ _ _ hw₁'.symm).hom
    haveI := Dp'.additive
    haveI := Dτ'.additive
    haveI := Di'.additive
    ∀ (hφ' : (Dp'.φ ≫ ((wcProEtBC p').sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.ProEt.topology Xm) (Scheme.ProEt.topology XE')).map Dτ'.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans α' RingCat.{u+1}
          (Scheme.ProEt.topology Xm) (Scheme.ProEt.topology XE')).app
          (wcRingSheaf XE' ℓ) = Dp'.φ)
      (t' : (Dτ'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex ⟶
        I'.cochainComplex),
      (Dτ'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I'.ι' ≫ t' =
        (HomologicalComplex.singleMapHomologicalComplex Dτ'.Φ (ComplexShape.up ℤ) 0).hom.app
          (SheafOfModules.unit (wcRingSheaf XE' ℓ)) ≫
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          ((Dτ'.adj.homEquiv _ _).symm
            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
              (wcProEtBC w') _ _ Dτ'.cont Dτ'.φ)) ≫
        I'.ι' →
    let P' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC p') _ _ Dp'.cont Dp'.φ
    haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj
    let Pw' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC w') _ _ Dτ'.cont Dτ'.φ
    haveI : Pw'.Additive := Adjunction.right_adjoint_additive Dτ'.adj
    let K' := (P'.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex
    let γ' : Pw' ⋙ P' ⟶ P' := (SheafOfModules.pushforwardComp Dp'.φ Dτ'.φ).hom ≫
        SheafOfModules.pushforwardNatTrans _ α' ≫ (SheafOfModules.pushforwardCongr hφ').hom
    let Tflat' := (Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app
          I'.cochainComplex ≫
        (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ Dτ'.Φ ⋙ Pw' from Dτ'.adj.unit)
          (ComplexShape.up ℤ)).app I'.cochainComplex ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Dτ'.Φ ⋙ Pw'))
          (ComplexShape.up ℤ)).inv.app I'.cochainComplex ≫
        (Pw'.mapHomologicalComplex (ComplexShape.up ℤ)).map t'
    let T' : K' ⟶ K' := (P'.mapHomologicalComplex (ComplexShape.up ℤ)).map Tflat' ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw' ⋙ P'))
          (ComplexShape.up ℤ)).hom.app I'.cochainComplex ≫
        (NatTrans.mapHomologicalComplex γ' (ComplexShape.up ℤ)).app I'.cochainComplex
    let TΨ' := (Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map T'
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))
    DerivedCategory.Q.map TΨ' ≠ 𝟙 _) → DerivedCategory.Q.map TΨ ≠ 𝟙 _) :=
by
  intro A _ _ _ _ _ ℓ _ hℓ n hn hn4 π c hπ hc x₀ hx₀ B₀ _ _ _ Λ₀ _ _ W₀ φ₀ a₀ hsh L _ _ φA hφA
    halg σ₂ hσ₂ L' _ _ ιL hLalg S' σ' hS hσι hσS hprim XE p q hpb Xs ι s hps w hw₁ hw₂
    Dp hDp Dτ hDτ Di hDi I α hφ t ht P Pw K γ Tflat T TΨ

  have key : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] {_hD : HasDerivedCategory 𝒞}
      {𝒟 : Type (u+2)} [Category.{u+1} 𝒟] [Abelian 𝒟] {_hD' : HasDerivedCategory 𝒟}
      (One : 𝒞) (Ψ : CochainComplex 𝒞 ℤ)
      (eΨ : (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One ⟶ Ψ) (TΨ : Ψ ⟶ Ψ)
      (F : DerivedCategory.Plus 𝒞 ⥤ DerivedCategory 𝒟) [F.Additive]
      (hP : DerivedCategory.TStructure.t.plus (DerivedCategory.Q.obj Ψ)),
      eΨ ≫ TΨ = eΨ →
      (DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ)).IsGE 1 →
      (DerivedCategory.Q.map TΨ - 𝟙 _) ≫
        DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) = 0 →
      F.map (ObjectProperty.homMk (X := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))
        (Y := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞)) (DerivedCategory.Q.map TΨ)) = 𝟙 _ →
      (∀ g : DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ) ⟶
          DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One),
        F.map (ObjectProperty.homMk (X := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))
          (Y := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))
          (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) ≫ g ≫
            DerivedCategory.Q.map eΨ)) = 0 →
        DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) ≫ g ≫
          DerivedCategory.Q.map eΨ = 0) →
      DerivedCategory.Q.map TΨ = 𝟙 _ := by
    intro 𝒞 _ _ _ 𝒟 _ _ _ One Ψ eΨ TΨ F _ hP h1 h2 h3 h5 h11
    let t : Triangulated.TStructure (DerivedCategory 𝒞) := DerivedCategory.TStructure.t
    have hdist := DerivedCategory.mappingCone_triangle_distinguished eΨ
    have hV1 : DerivedCategory.Q.map eΨ ≫ (DerivedCategory.Q.map TΨ - 𝟙 _) = 0 := by
      rw [Preadditive.comp_sub, ← Functor.map_comp, h1, Category.comp_id, sub_self]
    obtain ⟨h, hh⟩ := Pretriangulated.Triangle.yoneda_exact₂ _ hdist
      (DerivedCategory.Q.map TΨ - 𝟙 _) hV1
    change DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ) ⟶ DerivedCategory.Q.obj Ψ at h
    change DerivedCategory.Q.map TΨ - 𝟙 _ =
      DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) ≫ h at hh
    obtain ⟨k, hk⟩ := Pretriangulated.Triangle.yoneda_exact₃ _ hdist
      (h ≫ DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ)) (by
        change DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) ≫ h ≫
          DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) = 0
        rw [← Category.assoc, ← hh]
        exact h3)
    have hLE0 : t.IsLE (DerivedCategory.Q.obj
        ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One)) 0 :=
      t.isLE_of_iso ((DerivedCategory.singleFunctorIsoCompQ 𝒞 0).app One) 0
    have hLE : t.IsLE ((DerivedCategory.Q.obj
        ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One))⟦(1 : ℤ)⟧) (-1) :=
      t.isLE_shift _ 0 1 (-1)
    have h2' : t.IsGE (DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ)) 1 := h2
    have hk0 : k = 0 :=
      @Triangulated.TStructure.zero _ _ _ _ _ _ _ t _ _ k (-1) 1 (by omega) hLE h2'
    have hh2 : h ≫ DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) = 0 := by
      exact hk.trans (by subst hk0; exact Limits.comp_zero)
    obtain ⟨g, hg⟩ := Pretriangulated.Triangle.coyoneda_exact₂ _ hdist h hh2
    change DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ) ⟶
      DerivedCategory.Q.obj ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj One) at g
    change h = g ≫ DerivedCategory.Q.map eΨ at hg
    have hV : DerivedCategory.Q.map TΨ - 𝟙 _ =
        DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) ≫ g ≫
          DerivedCategory.Q.map eΨ := by
      rw [hh, hg]
    have hF : F.map (ObjectProperty.homMk (X := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))
        (Y := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))
        (DerivedCategory.Q.map (CochainComplex.mappingCone.inr eΨ) ≫ g ≫
          DerivedCategory.Q.map eΨ)) = 0 := by
      rw [← hV]
      change F.map (ObjectProperty.homMk (X := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞))
        (Y := (⟨_, hP⟩ : DerivedCategory.Plus 𝒞)) (DerivedCategory.Q.map TΨ) - 𝟙 _) = 0
      rw [F.map_sub, h5, CategoryTheory.Functor.map_id, sub_self]
    have h0 := h11 g hF
    rw [← hV] at h0
    exact sub_eq_zero.mp h0

  obtain ⟨A', _, _, _, _, _, ιA, π', κ, hκ, hℓ', hπ', hπ'2, hgen, hφex⟩ :=
    wc_qmbt_eisenstein_base A ℓ hℓ π hπ
  obtain ⟨φ', hφ'i, halg', hφ'A, hφ'π⟩ := hφex L φA hφA halg L' ιL hLalg S' hS

  obtain ⟨Xm, f, bl, hbl, hblf, hqc, hqs, hcov, hpt⟩ :=
    wc_qmbt_blowup_model hℓ hn hn4 hπ hc hx₀ hsh hℓ' hπ' hπ'2 hgen

  have hσφ' : σ'.comp φ' = φ' := by
    apply RingHom.ext
    intro a'
    obtain ⟨x, y, rfl⟩ := hgen a'
    have e0 : ∀ z, φ' (ιA z) = ιL (φA z) := fun z => RingHom.congr_fun hφ'A z
    have e1 : ∀ z, σ' (ιL z) = ιL (σ₂ z) := fun z => RingHom.congr_fun hσι z
    have e2 : ∀ z, σ₂ (φA z) = φA z := fun z => RingHom.congr_fun hσ₂ z
    simp only [RingHom.comp_apply, map_add, map_mul, e0, e1, e2, hφ'π, hσS]
  have htame : wcMntTame ℓ φ' σ' π' := fun k hk z hz => hprim k hk z (hz.trans hφ'π)

  obtain ⟨XE', p', q', hpb'⟩ : ∃ (XE' : Scheme.{u}) (p' : XE' ⟶ Xm) (q' : XE' ⟶ Spec (.of L')),
      IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')) :=
    ⟨_, _, _, IsPullback.of_hasPullback _ _⟩
  obtain ⟨Xs', ι', s', hps'⟩ : ∃ (Xs' : Scheme.{u}) (ι' : Xs' ⟶ Xm)
      (s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))), IsPullback ι' s' f (wcQmSp A') :=
    ⟨_, _, _, IsPullback.of_hasPullback _ _⟩
  have hww : p' ≫ f = (q' ≫ Spec.map (CommRingCat.ofHom σ')) ≫ Spec.map (CommRingCat.ofHom φ') := by
    rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hσφ']
