            · intro q
              refine ⟨q ≫ toSheafify J (bc.op ⋙ H.obj), ?_⟩
              show (q ≫ toSheafify J (bc.op ⋙ H.obj)) ≫ inv (toSheafify J (bc.op ⋙ H.obj)) = q
              rw [Category.assoc, IsIso.hom_inv_id, Category.comp_id]
          · constructor
            · intro f g hfg
