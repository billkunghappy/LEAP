        (ProjectiveResolution.of X).π.f 0 ≫ ((ChainComplex.single₀ (ModuleCat.{u} A)).map f).f 0 := by
      rw [ChainComplex.single₀_map_f_zero]; exact hL
    have hmk := ProjectiveResolution.mk₀_comp_extMk _ (n + 1) rfl (hcyc X' _ z')
      (ProjectiveResolution.Hom.mk L hL')
    refine Eq.trans ?_ hmk.symm
    have hcm : (((ProjectiveResolution.of X).complex.linearYonedaObj A Y).iCycles n).hom
        ((HomologicalComplex.cyclesMap ψ n).hom z') =
        L.f n ≫ (((ProjectiveResolution.of X').complex.linearYonedaObj A Y).iCycles n).hom z' := by
      have h1 := congrArg (fun g => g.hom z') (HomologicalComplex.cyclesMap_i ψ n)
      refine h1.trans ?_
      subst hψ
      rfl
    exact hext X _ _ _ hcm _ _

  obtain ⟨s, rfl⟩ : ∃ s, i = s + 1 := ⟨i - 1, by omega⟩
  rw [hcrit]
  intro t y
  obtain ⟨e, he⟩ := hcomp (ModuleCat.of A M) (s + 1)
  obtain ⟨t', ht, h0⟩ := s3 s M hM t (e _ y)
  refine ⟨t', ht, ?_⟩
  apply (e _).injective
  rw [he, h0, map_zero]

theorem wc_plt_lc_map_smul (A : Type u) [CommRing A] (I : Ideal A) (n : ℕ) (M : ModuleCat.{u} A)
    (x : A) :
    (localCohomology I n).map (x • 𝟙 M) = x • 𝟙 ((localCohomology I n).obj M) :=
by
  obtain ⟨σ, hσ⟩ : ∃ σ : 𝟭 (ModuleCat.{u} A)ᵒᵖ ⟶ 𝟭 (ModuleCat.{u} A)ᵒᵖ,
      ∀ Z, σ.app Z = (x • 𝟙 (Opposite.unop Z)).op :=
    ⟨{ app := fun Z => (x • 𝟙 (Opposite.unop Z)).op
       naturality := by
        intro Z W f
        apply Quiver.Hom.unop_inj
        simp [Linear.smul_comp, Linear.comp_smul] }, fun _ => rfl⟩
  have s1 : ∀ (K : ChainComplex (ModuleCat.{u} A)ᵒᵖ ℕ) (φ : K ⟶ K)
      (_ : ∀ j, φ.f j = σ.app (K.X j)) (i : ℕ),
      HomologicalComplex.homologyMap φ i = σ.app (K.homology i) := by
    intro K φ hφ i
    have hc : HomologicalComplex.cyclesMap φ i = σ.app (K.cycles i) := by
      rw [← cancel_mono (K.iCycles i), HomologicalComplex.cyclesMap_i, hφ i]
      exact σ.naturality (K.iCycles i)
    rw [← cancel_epi (K.homologyπ i), HomologicalComplex.homologyπ_naturality, hc]
    exact (σ.naturality (K.homologyπ i)).symm
  have key : ∀ {Z W : (ModuleCat.{u} A)ᵒᵖ} (e : Z ≅ W), e.hom ≫ σ.app W ≫ e.inv = σ.app Z := by
    intro Z W e
    have h := σ.naturality e.hom
    simp only [Functor.id_map, Functor.id_obj] at h
    rw [← Category.assoc, h, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  have s2 : ∀ (F : ModuleCat.{u} A ⥤ (ModuleCat.{u} A)ᵒᵖ) [F.Additive] (α : F ⟶ F)
      (_ : ∀ P, α.app P = σ.app (F.obj P)) (Y : ModuleCat.{u} A),
      (NatTrans.leftDerived α n).app Y = σ.app ((F.leftDerived n).obj Y) := by
    intro F _ α hα Y
    let P := projectiveResolution Y
    rw [ProjectiveResolution.leftDerived_app_eq α P n, HomologicalComplex.homologyFunctor_map,
      s1 _ _ (fun j => by rw [NatTrans.mapHomologicalComplex_app_f, hα]; rfl) n]
    exact key (P.isoLeftDerivedObj F n)
  have s3 : ∀ X : (ModuleCat.{u} A)ᵒᵖ, ((Ext A (ModuleCat.{u} A) n).obj X).map (x • 𝟙 M) =
      x • 𝟙 (((Ext A (ModuleCat.{u} A) n).obj X).obj M) := by
    intro X
    have hα : ∀ P, (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map (x • 𝟙 M))).app P =
        σ.app (((linearYoneda A (ModuleCat.{u} A)).obj M).rightOp.obj P) := by
      intro P
      rw [hσ]
      apply Quiver.Hom.unop_inj
      ext f
      simp
      have hg : ∀ g : P ⟶ M, g ≫ (x • 𝟙 M) = x • g := fun g => by
        rw [Linear.comp_smul, Category.comp_id]
      exact hg f
    have h := s2 _ _ hα (Opposite.unop X)
    rw [hσ] at h
    exact congrArg Quiver.Hom.unop h
  show (Limits.colimit (localCohomology.diagram (localCohomology.idealPowersDiagram I) n)).map
    (x • 𝟙 M) = x • 𝟙 ((Limits.colimit (localCohomology.diagram
      (localCohomology.idealPowersDiagram I) n)).obj M)
  apply Limits.colimit_obj_ext
  intro j
  rw [← NatTrans.naturality]
  have h3 : ((localCohomology.diagram (localCohomology.idealPowersDiagram I) n).obj j).map
      (x • 𝟙 M) = x • 𝟙 _ := s3 _
  rw [h3, Linear.smul_comp, Category.id_comp, Linear.comp_smul, Category.comp_id]

theorem wc_plt_lc_matlis_good_element (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M]
    (hM : ∀ y : M, (∃ k : ℕ, ∀ a ∈ (IsLocalRing.maximalIdeal A) ^ k, a • y = 0) → y = 0) (i : ℕ) :
    ∃ x ∈ IsLocalRing.maximalIdeal A, IsSMulRegular M x ∧
      IsFiniteLength A (QuotSMulTop x
        ((localCohomology (IsLocalRing.maximalIdeal A) i).obj (ModuleCat.of A M))) :=
by
  classical

  have wc_plt_lc_les_third : ∀ (A : Type u) [CommRing A] (I : Ideal A)
      (S : ShortComplex (ModuleCat.{u} A)) (hS : S.ShortExact) (n : ℕ),
      ∃ δ : (localCohomology I n).obj S.X₃ ⟶ (localCohomology I (n + 1)).obj S.X₁,
        Function.Exact ⇑δ.hom ⇑((localCohomology I (n + 1)).map S.f).hom := by
    intro A _ I S hS n

    have s1 : ∀ {X : ModuleCat.{u} A} (P : ProjectiveResolution X),
      ∃ w : (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.g))
            (ComplexShape.down ℕ)).app P.complex ≫
          (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.f))
            (ComplexShape.down ℕ)).app P.complex = 0,
        (ShortComplex.mk _ _ w).ShortExact := by
      intro X P
      have w : (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.g))
              (ComplexShape.down ℕ)).app P.complex ≫
            (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.f))
              (ComplexShape.down ℕ)).app P.complex = 0 := by
        ext k : 1
        apply Quiver.Hom.unop_inj
        ext φ
        revert φ
        change ∀ φ : P.complex.X k ⟶ S.X₁, (φ ≫ S.f) ≫ S.g = 0
        intro φ
        rw [Category.assoc, S.zero, Limits.comp_zero]
      refine ⟨w, ?_⟩
      have hmono := hS.mono_f
      have hepi := hS.epi_g
      apply HomologicalComplex.shortExact_of_degreewise_shortExact
      intro k
      rw [ShortComplex.shortExact_iff_unop]
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · rw [ShortComplex.moduleCat_exact_iff]
        intro φ hφ
        change (φ : P.complex.X k ⟶ S.X₂) ≫ S.g = 0 at hφ
        exact ⟨hS.exact.lift φ hφ, hS.exact.lift_f φ hφ⟩
      · rw [ModuleCat.mono_iff_injective]
        intro a b hab
        change (a : P.complex.X k ⟶ S.X₁) ≫ S.f = b ≫ S.f at hab
        exact (cancel_mono S.f).mp hab
      · rw [ModuleCat.epi_iff_surjective]
        change ∀ φ : P.complex.X k ⟶ S.X₃, ∃ a : P.complex.X k ⟶ S.X₂, a ≫ S.g = φ
        intro φ
        exact ⟨Projective.factorThru φ S.g, Projective.factorThru_comp _ _⟩

    have s2 : ∀ {X : ModuleCat.{u} A} (P : ProjectiveResolution X)
      (w : (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.g))
            (ComplexShape.down ℕ)).app P.complex ≫
          (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.f))
            (ComplexShape.down ℕ)).app P.complex = 0)
      (hS' : (ShortComplex.mk _ _ w).ShortExact),
      Function.Exact
          ⇑((((P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₁).rightOp) (n + 1)).hom ≫
              hS'.δ (n + 1) n rfl ≫
              (P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₃).rightOp) n).inv).unop :
            ((Ext A (ModuleCat.{u} A) n).obj (Opposite.op X)).obj S.X₃ ⟶
              ((Ext A (ModuleCat.{u} A) (n + 1)).obj (Opposite.op X)).obj S.X₁)).hom
          ⇑(((Ext A (ModuleCat.{u} A) (n + 1)).obj (Opposite.op X)).map S.f).hom := by
      intro X P w hS'
      have conj : ∀ {M1 M2 M3 N1 N2 N3 : ModuleCat.{u} A} (e1 : M1 ≅ N1) (e2 : M2 ≅ N2) (e3 : M3 ≅ N3)
          (f : M1 ⟶ M2) (g : M2 ⟶ M3), Function.Exact f.hom g.hom →
          Function.Exact (e1.inv ≫ f ≫ e2.hom).hom (e2.inv ≫ g ≫ e3.hom).hom := by
        intro M1 M2 M3 N1 N2 N3 e1 e2 e3 f g hex x
        have hi : ∀ {M N : ModuleCat.{u} A} (e : M ≅ N) (y : M), e.inv.hom (e.hom.hom y) = y := by
          intro M N e y
          rw [← LinearMap.comp_apply, ← ModuleCat.hom_comp, e.hom_inv_id]
          rfl
        have hi' : ∀ {M N : ModuleCat.{u} A} (e : M ≅ N) (y : N), e.hom.hom (e.inv.hom y) = y := by
          intro M N e y
          rw [← LinearMap.comp_apply, ← ModuleCat.hom_comp, e.inv_hom_id]
          rfl
        simp only [ModuleCat.hom_comp, LinearMap.comp_apply]
        constructor
        · intro h
          have h' : g.hom (e2.inv.hom x) = 0 := by
            have := congrArg e3.inv.hom h
            rwa [map_zero, hi] at this
          obtain ⟨y, hy⟩ := (hex _).mp h'
          refine ⟨e1.hom.hom y, ?_⟩
          simp only [LinearMap.comp_apply]
          rw [hi, hy, hi']
        · rintro ⟨y, rfl⟩
          simp only [LinearMap.comp_apply]
          rw [hi, hex.apply_apply_eq_zero, map_zero]
      have ex3 := (hS'.homology_exact₃ (n + 1) n rfl).unop
      have fe3 : Function.Exact (hS'.δ (n + 1) n rfl).unop.hom
          (HomologicalComplex.homologyMap
            ((NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.f))
              (ComplexShape.down ℕ)).app P.complex) (n + 1)).unop.hom :=
        LinearMap.exact_iff.mpr ex3.moduleCat_range_eq_ker.symm
      have EY : ∀ {Y Y' : ModuleCat.{u} A} (g : Y ⟶ Y') (m : ℕ),
          ((Ext A (ModuleCat.{u} A) m).obj (Opposite.op X)).map g =
            (P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj Y).rightOp) m).unop.inv ≫
              (HomologicalComplex.homologyMap
                ((NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map g))
                  (ComplexShape.down ℕ)).app P.complex) m).unop ≫
              (P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj Y').rightOp) m).unop.hom := by
        intro Y Y' g m
        rw [show ((Ext A (ModuleCat.{u} A) m).obj (Opposite.op X)).map g =
          ((NatTrans.leftDerived (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map g)) m).app X).unop
          from rfl, ProjectiveResolution.leftDerived_app_eq _ P m]
        rfl
      have Eδ : ((((P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₁).rightOp) (n + 1)).hom ≫
                hS'.δ (n + 1) n rfl ≫
                (P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₃).rightOp) n).inv).unop :
              ((Ext A (ModuleCat.{u} A) n).obj (Opposite.op X)).obj S.X₃ ⟶
                ((Ext A (ModuleCat.{u} A) (n + 1)).obj (Opposite.op X)).obj S.X₁)) =
          (P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₃).rightOp) n).unop.inv ≫
            (hS'.δ (n + 1) n rfl).unop ≫
            (P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₁).rightOp) (n + 1)).unop.hom :=
        rfl
      rw [Eδ, EY S.f (n + 1)]
      exact conj (P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₃).rightOp) n).unop
        (P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₁).rightOp) (n + 1)).unop
        (P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₂).rightOp) (n + 1)).unop _ _ fe3

    have s3 : ∀ {X X' : ModuleCat.{u} A} (f : X ⟶ X') (P : ProjectiveResolution X)
      (P' : ProjectiveResolution X')
      (w : (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.g))
            (ComplexShape.down ℕ)).app P.complex ≫
          (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.f))
            (ComplexShape.down ℕ)).app P.complex = 0)
      (hS' : (ShortComplex.mk _ _ w).ShortExact)
      (w' : (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.g))
            (ComplexShape.down ℕ)).app P'.complex ≫
          (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.f))
            (ComplexShape.down ℕ)).app P'.complex = 0)
      (hS'' : (ShortComplex.mk _ _ w').ShortExact),
      ((Ext A (ModuleCat.{u} A) n).map f.op).app S.X₃ ≫
          ((((P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₁).rightOp) (n + 1)).hom ≫
              hS'.δ (n + 1) n rfl ≫
              (P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₃).rightOp) n).inv).unop :
            ((Ext A (ModuleCat.{u} A) n).obj (Opposite.op X)).obj S.X₃ ⟶
              ((Ext A (ModuleCat.{u} A) (n + 1)).obj (Opposite.op X)).obj S.X₁)) =
        ((((P'.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₁).rightOp) (n + 1)).hom ≫
              hS''.δ (n + 1) n rfl ≫
              (P'.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₃).rightOp) n).inv).unop :
            ((Ext A (ModuleCat.{u} A) n).obj (Opposite.op X')).obj S.X₃ ⟶
              ((Ext A (ModuleCat.{u} A) (n + 1)).obj (Opposite.op X')).obj S.X₁)) ≫
          ((Ext A (ModuleCat.{u} A) (n + 1)).map f.op).app S.X₁ := by
      intro X X' f P P' w hS' w' hS''
      let L := ProjectiveResolution.lift f P P'
      have hL : L.f 0 ≫ P'.π.f 0 = P.π.f 0 ≫ f := ProjectiveResolution.lift_commutes_zero f P P'
      let F₁ := ((linearYoneda A (ModuleCat.{u} A)).obj S.X₁).rightOp
      let F₂ := ((linearYoneda A (ModuleCat.{u} A)).obj S.X₂).rightOp
      let F₃ := ((linearYoneda A (ModuleCat.{u} A)).obj S.X₃).rightOp
      have h3 : (P.isoLeftDerivedObj F₃ n).inv ≫ (F₃.leftDerived n).map f =
          HomologicalComplex.homologyMap ((F₃.mapHomologicalComplex (ComplexShape.down ℕ)).map L) n ≫
            (P'.isoLeftDerivedObj F₃ n).inv :=
        ProjectiveResolution.isoLeftDerivedObj_inv_naturality f P P' L hL F₃ n
      have h1 : (F₁.leftDerived (n + 1)).map f ≫ (P'.isoLeftDerivedObj F₁ (n + 1)).hom =
          (P.isoLeftDerivedObj F₁ (n + 1)).hom ≫
            HomologicalComplex.homologyMap ((F₁.mapHomologicalComplex (ComplexShape.down ℕ)).map L) (n + 1) :=
        ProjectiveResolution.isoLeftDerivedObj_hom_naturality f P P' L hL F₁ (n + 1)
      let Φ : ShortComplex.mk _ _ w ⟶ ShortComplex.mk _ _ w' :=
        ShortComplex.homMk ((F₃.mapHomologicalComplex (ComplexShape.down ℕ)).map L)
          ((F₂.mapHomologicalComplex (ComplexShape.down ℕ)).map L)
          ((F₁.mapHomologicalComplex (ComplexShape.down ℕ)).map L)
          (NatTrans.mapHomologicalComplex_naturality _ L)
          (NatTrans.mapHomologicalComplex_naturality _ L)
      have hδn : hS'.δ (n + 1) n rfl ≫
            HomologicalComplex.homologyMap ((F₃.mapHomologicalComplex (ComplexShape.down ℕ)).map L) n =
          HomologicalComplex.homologyMap ((F₁.mapHomologicalComplex (ComplexShape.down ℕ)).map L) (n + 1) ≫
            hS''.δ (n + 1) n rfl :=
        HomologicalComplex.HomologySequence.δ_naturality Φ hS' hS'' (n + 1) n rfl
      have key : ((P.isoLeftDerivedObj F₁ (n + 1)).hom ≫ hS'.δ (n + 1) n rfl ≫
            (P.isoLeftDerivedObj F₃ n).inv) ≫ (F₃.leftDerived n).map f =
          (F₁.leftDerived (n + 1)).map f ≫ ((P'.isoLeftDerivedObj F₁ (n + 1)).hom ≫
            hS''.δ (n + 1) n rfl ≫ (P'.isoLeftDerivedObj F₃ n).inv) := by
        generalize hS'.δ (n + 1) n rfl = d1 at hδn ⊢
        generalize hS''.δ (n + 1) n rfl = d2 at hδn ⊢
        refine (Category.assoc _ _ _).trans ?_
        refine (whisker_eq _ (Category.assoc _ _ _)).trans ?_
        refine (whisker_eq _ (whisker_eq _ h3)).trans ?_
        refine (whisker_eq _ (Category.assoc _ _ _).symm).trans ?_
        refine (whisker_eq _ (eq_whisker hδn _)).trans ?_
        refine (whisker_eq _ (Category.assoc _ _ _)).trans ?_
        refine (Category.assoc _ _ _).symm.trans ?_
        refine (eq_whisker h1.symm _).trans ?_
        exact Category.assoc _ _ _
      exact congrArg Quiver.Hom.unop key

    have s5 : ∀ (D₀ D₁ : ℕᵒᵖᵒᵖ ⥤ ModuleCat.{u} A ⥤ ModuleCat.{u} A)
      (δ : ∀ j, (D₀.obj j).obj S.X₃ ⟶ (D₁.obj j).obj S.X₁)
      (hδ : ∀ (j j' : ℕᵒᵖᵒᵖ) (i : j ⟶ j'), (D₀.map i).app S.X₃ ≫ δ j' = δ j ≫ (D₁.map i).app S.X₁)
      (h3 : ∀ j, Function.Exact ⇑(δ j).hom ⇑((D₁.obj j).map S.f).hom),
      ∃ Δ : (Limits.colimit D₀).obj S.X₃ ⟶ (Limits.colimit D₁).obj S.X₁,
        Function.Exact ⇑Δ.hom ⇑((Limits.colimit D₁).map S.f).hom := by
      intro D₀ D₁ δ hδ h3
      have := Limits.preservesFilteredColimitsOfSize_of_univLE.{u, u, 0, 0} (forget (ModuleCat.{u} A))
      have hrep : ∀ (D : ℕᵒᵖᵒᵖ ⥤ ModuleCat.{u} A ⥤ ModuleCat.{u} A) (Y : ModuleCat.{u} A),
          (∀ x : (Limits.colimit D).obj Y, ∃ (j : ℕᵒᵖᵒᵖ) (y : (D.obj j).obj Y),
            ((Limits.colimit.ι D j).app Y).hom y = x) ∧
          (∀ (j : ℕᵒᵖᵒᵖ) (y : (D.obj j).obj Y), ((Limits.colimit.ι D j).app Y).hom y = 0 →
            ∃ (j' : ℕᵒᵖᵒᵖ) (i : j ⟶ j'), ((D.map i).app Y).hom y = 0) := by
        intro D Y
        let F : ℕᵒᵖᵒᵖ ⥤ ModuleCat.{u} A := D ⋙ (evaluation (ModuleCat.{u} A) (ModuleCat.{u} A)).obj Y
        have : Limits.PreservesColimit F (forget (ModuleCat.{u} A)) := inferInstance
        let e := Limits.colimitObjIsoColimitCompEvaluation D Y
        have he : ∀ j (y : (D.obj j).obj Y),
            e.hom.hom (((Limits.colimit.ι D j).app Y).hom y) = (Limits.colimit.ι F j).hom y := by
          intro j y
          have := congrArg (fun ψ => ModuleCat.Hom.hom ψ y)
            (Limits.colimitObjIsoColimitCompEvaluation_ι_app_hom D j Y)
          simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at this
          exact this
        have hinj : Function.Injective e.hom.hom :=
          (ModuleCat.mono_iff_injective e.hom).mp inferInstance
        refine ⟨fun x => ?_, fun j y hy => ?_⟩
        · obtain ⟨j, y, hy⟩ := Limits.Concrete.colimit_exists_rep F (e.hom x)
          refine ⟨j, y, hinj ?_⟩
          rw [he]
          exact hy
        · have hy0 : (ConcreteCategory.hom (Limits.colimit.ι F j)) y = 0 := by
            have := he j y
            rw [hy, map_zero] at this
            exact this.symm
          obtain ⟨j', i, hi⟩ := Limits.Concrete.colimit_rep_eq_zero A F j y hy0
          exact ⟨j', i, hi⟩
      have N1 : ∀ (D : ℕᵒᵖᵒᵖ ⥤ ModuleCat.{u} A ⥤ ModuleCat.{u} A) {Y Y' : ModuleCat.{u} A}
          (φ : Y ⟶ Y') (j : ℕᵒᵖᵒᵖ) (y : (D.obj j).obj Y),
          ((Limits.colimit D).map φ).hom (((Limits.colimit.ι D j).app Y).hom y) =
            ((Limits.colimit.ι D j).app Y').hom (((D.obj j).map φ).hom y) := by
        intro D Y Y' φ j y
        have := congrArg (fun ψ => ModuleCat.Hom.hom ψ y) ((Limits.colimit.ι D j).naturality φ)
        simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at this
        exact this.symm
      have N2 : ∀ (D : ℕᵒᵖᵒᵖ ⥤ ModuleCat.{u} A ⥤ ModuleCat.{u} A) (Y : ModuleCat.{u} A)
          (j j' : ℕᵒᵖᵒᵖ) (i : j ⟶ j') (y : (D.obj j).obj Y),
          ((Limits.colimit.ι D j').app Y).hom (((D.map i).app Y).hom y) =
            ((Limits.colimit.ι D j).app Y).hom y := by
        intro D Y j j' i y
        have := congrArg (fun ψ => ModuleCat.Hom.hom (NatTrans.app ψ Y) y) (Limits.colimit.w D i)
        simp only [NatTrans.comp_app, ModuleCat.hom_comp, LinearMap.comp_apply] at this
        exact this
      have N3 : ∀ (D : ℕᵒᵖᵒᵖ ⥤ ModuleCat.{u} A ⥤ ModuleCat.{u} A) {Y Y' : ModuleCat.{u} A}
          (φ : Y ⟶ Y') (j j' : ℕᵒᵖᵒᵖ) (i : j ⟶ j') (y : (D.obj j).obj Y),
          ((D.map i).app Y').hom (((D.obj j).map φ).hom y) =
            ((D.obj j').map φ).hom (((D.map i).app Y).hom y) := by
        intro D Y Y' φ j j' i y
        have := congrArg (fun ψ => ModuleCat.Hom.hom ψ y) ((D.map i).naturality φ)
        simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at this
        exact this
      let β : D₀ ⋙ (evaluation (ModuleCat.{u} A) (ModuleCat.{u} A)).obj S.X₃ ⟶
          D₁ ⋙ (evaluation (ModuleCat.{u} A) (ModuleCat.{u} A)).obj S.X₁ :=
        { app := δ
          naturality := fun j j' i => hδ j j' i }
      let Δ : (Limits.colimit D₀).obj S.X₃ ⟶ (Limits.colimit D₁).obj S.X₁ :=
        (Limits.colimitObjIsoColimitCompEvaluation D₀ S.X₃).hom ≫ Limits.colimMap β ≫
          (Limits.colimitObjIsoColimitCompEvaluation D₁ S.X₁).inv
      have hΔ : ∀ j, (Limits.colimit.ι D₀ j).app S.X₃ ≫ Δ = δ j ≫ (Limits.colimit.ι D₁ j).app S.X₁ := by
        intro j
        simp only [Δ, Limits.colimitObjIsoColimitCompEvaluation_ι_app_hom_assoc, Limits.ι_colimMap_assoc,
          Limits.colimitObjIsoColimitCompEvaluation_ι_inv]
        rfl
      have Δι : ∀ j (y : (D₀.obj j).obj S.X₃),
          Δ.hom (((Limits.colimit.ι D₀ j).app S.X₃).hom y) =
            ((Limits.colimit.ι D₁ j).app S.X₁).hom ((δ j).hom y) := by
        intro j y
        have := congrArg (fun ψ => ModuleCat.Hom.hom ψ y) (hΔ j)
        simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at this
        exact this
      have hδe : ∀ (j j' : ℕᵒᵖᵒᵖ) (i : j ⟶ j') (y : (D₀.obj j).obj S.X₃),
          ((D₁.map i).app S.X₁).hom ((δ j).hom y) = (δ j').hom (((D₀.map i).app S.X₃).hom y) := by
        intro j j' i y
        have := congrArg (fun ψ => ModuleCat.Hom.hom ψ y) (hδ j j' i)
        simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at this
        exact this.symm
      refine ⟨Δ, ?_⟩
      intro x
      constructor
      · intro hx
        obtain ⟨j, y, rfl⟩ := (hrep D₁ S.X₁).1 x
        rw [N1] at hx
        obtain ⟨j', i, hi⟩ := (hrep D₁ S.X₂).2 j _ hx
        rw [N3] at hi
        obtain ⟨z, hz⟩ := (h3 j' _).mp hi
        refine ⟨((Limits.colimit.ι D₀ j').app S.X₃).hom z, ?_⟩
        rw [Δι, hz, N2]
      · rintro ⟨z, rfl⟩
        obtain ⟨j, z, rfl⟩ := (hrep D₀ S.X₃).1 z
        rw [Δι, N1, (h3 j).apply_apply_eq_zero, map_zero]

    let Xj : ℕᵒᵖᵒᵖ → ModuleCat.{u} A := fun j =>
      (localCohomology.ringModIdeals (localCohomology.idealPowersDiagram I)).obj j.unop
    let Pj : ∀ j, ProjectiveResolution (Xj j) := fun j => projectiveResolution (Xj j)
    choose w hw using fun j => s1 (Pj j)
    obtain ⟨Δ, h3⟩ := s5 (localCohomology.diagram (localCohomology.idealPowersDiagram I) n)
      (localCohomology.diagram (localCohomology.idealPowersDiagram I) (n + 1))
      (fun j => (((Pj j).isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₁).rightOp)
          (n + 1)).hom ≫ (hw j).δ (n + 1) n rfl ≫
          ((Pj j).isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₃).rightOp) n).inv).unop)
      (fun j j' i => s3 ((localCohomology.ringModIdeals (localCohomology.idealPowersDiagram I)).map i.unop)
        (Pj j') (Pj j) (w j') (hw j') (w j) (hw j))
      (fun j => s2 (Pj j) (w j) (hw j))
    exact ⟨Δ, h3⟩

  have wc_plt_lc_ext_smul_left : ∀ (A : Type u) [CommRing A] (n : ℕ) (X M : ModuleCat.{u} A) (a : A),
      ((Ext A (ModuleCat.{u} A) n).map (a • 𝟙 X).op).app M =
        a • 𝟙 (((Ext A (ModuleCat.{u} A) n).obj (Opposite.op X)).obj M) := by
    intro A _ n X M a
    obtain ⟨σ, hσ⟩ : ∃ σ : 𝟭 (ModuleCat.{u} A)ᵒᵖ ⟶ 𝟭 (ModuleCat.{u} A)ᵒᵖ,
        ∀ Z, σ.app Z = (a • 𝟙 (Opposite.unop Z)).op :=
      ⟨{ app := fun Z => (a • 𝟙 (Opposite.unop Z)).op
         naturality := by
          intro Z W f
          apply Quiver.Hom.unop_inj
          simp [Linear.smul_comp, Linear.comp_smul] }, fun _ => rfl⟩
    have s1 : ∀ (K : ChainComplex (ModuleCat.{u} A)ᵒᵖ ℕ) (φ : K ⟶ K)
        (_ : ∀ j, φ.f j = σ.app (K.X j)) (i : ℕ),
        HomologicalComplex.homologyMap φ i = σ.app (K.homology i) := by
      intro K φ hφ i
      have hc : HomologicalComplex.cyclesMap φ i = σ.app (K.cycles i) := by
        rw [← cancel_mono (K.iCycles i), HomologicalComplex.cyclesMap_i, hφ i]
        exact σ.naturality (K.iCycles i)
      rw [← cancel_epi (K.homologyπ i), HomologicalComplex.homologyπ_naturality, hc]
      exact (σ.naturality (K.homologyπ i)).symm
    have key : ∀ {Z W : (ModuleCat.{u} A)ᵒᵖ} (e : Z ≅ W), e.hom ≫ σ.app W ≫ e.inv = σ.app Z := by
      intro Z W e
      have h := σ.naturality e.hom
      simp only [Functor.id_map, Functor.id_obj] at h
      rw [← Category.assoc, h, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    let F : ModuleCat.{u} A ⥤ (ModuleCat.{u} A)ᵒᵖ := ((linearYoneda A (ModuleCat.{u} A)).obj M).rightOp
    let P := projectiveResolution X
    have hcomm : (a • 𝟙 P.complex) ≫ P.π =
        P.π ≫ (ChainComplex.single₀ (ModuleCat.{u} A)).map (a • 𝟙 X) := by
      apply HomologicalComplex.hom_ext
      intro i
      rcases i with _ | i
      · simp only [HomologicalComplex.comp_f, HomologicalComplex.smul_f_apply, HomologicalComplex.id_f,
          ChainComplex.single₀_map_f_zero]
        first
          | (erw [Linear.comp_smul, Category.comp_id, Linear.smul_comp, Category.id_comp])
          | (ext y; simp)
      · apply Limits.IsZero.eq_of_tgt
        exact HomologicalComplex.isZero_single_obj_X _ _ _ _ (by simp)
    have hL := F.leftDerived_map_eq n (a • 𝟙 X) (a • 𝟙 P.complex) hcomm
    have hφ : ∀ j, ((F.mapHomologicalComplex (ComplexShape.down ℕ)).map (a • 𝟙 P.complex)).f j =
        σ.app (((F.mapHomologicalComplex (ComplexShape.down ℕ)).obj P.complex).X j) := by
      intro j
      rw [hσ]
      apply Quiver.Hom.unop_inj
      ext f
      simp
      have hg : ∀ g : P.complex.X j ⟶ M, (a • 𝟙 (P.complex.X j)) ≫ g = a • g := fun g => by
        rw [Linear.smul_comp, Category.id_comp]
      exact hg f
    have hD : (F.leftDerived n).map (a • 𝟙 X) = σ.app ((F.leftDerived n).obj X) := by
      rw [hL, Functor.comp_map, HomologicalComplex.homologyFunctor_map, s1 _ _ hφ n]
      exact key _
    have := congrArg Quiver.Hom.unop hD
    rw [hσ] at this
    exact this

  have wc_plt_lc_melkersson : ∀ (A : Type u) [CommRing A] (N : Type u) [AddCommGroup N] [Module A N]
      (x : A), (∀ y : N, ∃ k : ℕ, x ^ k • y = 0) →
      IsArtinian A ↥(Submodule.torsionBy A N x) → IsArtinian A N := by
    intro A _ N _ _ x htors hart
    classical
    let J : ℕ → Submodule A N → Submodule A N := fun k L =>
      (L ⊓ Submodule.torsionBy A N (x ^ (k + 1))).map (x ^ k • (LinearMap.id : N →ₗ[A] N))
    have hmemJ : ∀ k L y, y ∈ J k L ↔ ∃ z ∈ L, x ^ (k + 1) • z = 0 ∧ x ^ k • z = y := by
      intro k L y
      simp only [J, Submodule.mem_map, Submodule.mem_inf, Submodule.mem_torsionBy_iff,
        LinearMap.smul_apply, LinearMap.id_apply]
      constructor
      · rintro ⟨z, ⟨hz1, hz2⟩, rfl⟩
        exact ⟨z, hz1, hz2, rfl⟩
      · rintro ⟨z, hz1, hz2, rfl⟩
        exact ⟨z, ⟨hz1, hz2⟩, rfl⟩
    have F1 : ∀ k L, J k L ≤ Submodule.torsionBy A N x := by
      intro k L y hy
      obtain ⟨z, -, hz, rfl⟩ := (hmemJ k L y).mp hy
      rw [Submodule.mem_torsionBy_iff, ← mul_smul, ← pow_succ']
      exact hz
    have F2 : ∀ k L L', L' ≤ L → J k L' ≤ J k L := by
      intro k L L' h y hy
      obtain ⟨z, hz, hz1, rfl⟩ := (hmemJ k L' y).mp hy
      exact (hmemJ k L _).mpr ⟨z, h hz, hz1, rfl⟩
    have F3 : ∀ k L, J (k + 1) L ≤ J k L := by
      intro k L y hy
      obtain ⟨z, hz, hz1, rfl⟩ := (hmemJ (k + 1) L y).mp hy
      refine (hmemJ k L _).mpr ⟨x • z, L.smul_mem x hz, ?_, ?_⟩
      · rw [← mul_smul, ← pow_succ]
        exact hz1
      · rw [← mul_smul, ← pow_succ]
    have F3' : ∀ L, Antitone (fun k => J k L) := fun L => antitone_nat_of_succ_le (fun k => F3 k L)
    have F4 : ∀ L L', L' ≤ L → (∀ k, J k L' = J k L) → L' = L := by
      intro L L' hle hJ
      apply le_antisymm hle
      have key : ∀ k, ∀ y ∈ L, x ^ k • y = 0 → y ∈ L' := by
        intro k
        induction k with
        | zero =>
          intro y _ hy
          rw [pow_zero, one_smul] at hy
          rw [hy]
          exact L'.zero_mem
        | succ k ih =>
          intro y hy hyk
          have h1 : x ^ k • y ∈ J k L := (hmemJ k L _).mpr ⟨y, hy, hyk, rfl⟩
          rw [← hJ k] at h1
          obtain ⟨y', hy', _, hxy⟩ := (hmemJ k L' _).mp h1
          have h2 : y - y' ∈ L' :=
            ih (y - y') (L.sub_mem hy (hle hy')) (by rw [smul_sub, hxy, sub_self])
          have h3 := L'.add_mem h2 hy'
          rwa [sub_add_cancel] at h3
      intro y hy
      obtain ⟨k, hk⟩ := htors y
      exact key k y hy hk
    have stab : ∀ f : ℕ → Submodule A N, Antitone f → (∀ n, f n ≤ Submodule.torsionBy A N x) →
        ∃ n0, ∀ n, n0 ≤ n → f n = f n0 := by
      intro f hf hle
      let g : ℕ →o (Submodule A (Submodule.torsionBy A N x))ᵒᵈ :=
        ⟨fun n => OrderDual.toDual ((f n).comap (Submodule.torsionBy A N x).subtype),
          fun a b hab => Submodule.comap_mono (hf hab)⟩
      obtain ⟨n0, hn0⟩ := IsArtinian.monotone_stabilizes g
      refine ⟨n0, fun n hn => ?_⟩
      have h' : (f n).comap (Submodule.torsionBy A N x).subtype =
          (f n0).comap (Submodule.torsionBy A N x).subtype := (hn0 n hn).symm
      have e : ∀ m, f m = ((f m).comap (Submodule.torsionBy A N x).subtype).map
          (Submodule.torsionBy A N x).subtype := by
        intro m
        rw [Submodule.map_comap_subtype, inf_eq_right.mpr (hle m)]
      calc f n = ((f n).comap (Submodule.torsionBy A N x).subtype).map
            (Submodule.torsionBy A N x).subtype := e n
        _ = ((f n0).comap (Submodule.torsionBy A N x).subtype).map
            (Submodule.torsionBy A N x).subtype := by rw [h']
        _ = f n0 := (e n0).symm
    rw [← monotone_stabilizes_iff_artinian]
    intro L
    let Lc : ℕ → Submodule A N := fun n => OrderDual.ofDual (L n)
    have hLc : Antitone Lc := fun a b h => L.monotone h
    have hk : ∀ k, ∃ n0, ∀ n, n0 ≤ n → J k (Lc n) = J k (Lc n0) := fun k =>
      stab _ (fun a b h => F2 k _ _ (hLc h)) (fun n => F1 k _)
    choose nk hnk using hk
    let t : ℕ → Submodule A N := fun k => J k (Lc (nk k))
    have ht_le : ∀ k n, t k ≤ J k (Lc n) := by
      intro k n
      show J k (Lc (nk k)) ≤ _
      rw [← hnk k (max n (nk k)) (le_max_right _ _)]
      exact F2 k _ _ (hLc (le_max_left _ _))
    have ht_anti : Antitone t := by
      apply antitone_nat_of_succ_le
      intro k
      show J (k + 1) (Lc (nk (k + 1))) ≤ J k (Lc (nk k))
      rw [← hnk (k + 1) (max (nk k) (nk (k + 1))) (le_max_right _ _),
        ← hnk k (max (nk k) (nk (k + 1))) (le_max_left _ _)]
      exact F3 k _
    obtain ⟨k0, hk0⟩ := stab t ht_anti (fun k => F1 k _)
    refine ⟨(Finset.range (k0 + 1)).sup nk, fun n hn => ?_⟩
    set Ns := (Finset.range (k0 + 1)).sup nk with hNs
    have hJeq : ∀ k, J k (Lc n) = J k (Lc Ns) := by
      intro k
      rcases le_or_gt k k0 with hk | hk
      · have h1 : nk k ≤ Ns := Finset.le_sup (f := nk) (Finset.mem_range.mpr (by omega))
        rw [hnk k n (le_trans h1 hn), hnk k Ns h1]
      · have hk0n : nk k0 ≤ Ns := Finset.le_sup (f := nk) (Finset.mem_range.mpr (by omega))
        have up : ∀ m, Ns ≤ m → J k (Lc m) = t k0 := by
          intro m hm
          apply le_antisymm
          · calc J k (Lc m) ≤ J k0 (Lc m) := F3' (Lc m) hk.le
              _ = t k0 := hnk k0 m (le_trans hk0n hm)
          · rw [← hk0 k hk.le]
            exact ht_le k m
        rw [up n hn, up Ns le_rfl]
    have hfin := F4 (Lc Ns) (Lc n) (hLc hn) hJeq
    exact hfin.symm

  have hfl : ∀ (N : Type u) [AddCommGroup N] [Module A N],
      (∃ k : ℕ, ∀ a ∈ (IsLocalRing.maximalIdeal A) ^ k, ∀ y : N, a • y = 0) →
      (IsArtinian A N ∨ Module.Finite A N) → IsFiniteLength A N := by
    intro N _ _ hk hN
    obtain ⟨k, hk⟩ := hk
    rcases Nat.eq_zero_or_pos k with h0 | hpos
    · subst h0
      haveI : Subsingleton N := ⟨fun y z => by
        rw [← one_smul A y, ← one_smul A z, hk 1 (by simp) y, hk 1 (by simp) z]⟩
      exact IsFiniteLength.of_subsingleton
    set J := (IsLocalRing.maximalIdeal A) ^ k with hJ
    have hJm : J ≤ IsLocalRing.maximalIdeal A := Ideal.pow_le_self hpos.ne'
    have hJtop : J ≠ ⊤ := fun h =>
      (IsLocalRing.maximalIdeal.isMaximal A).ne_top (top_le_iff.mp (h ▸ hJm))
    haveI : Nontrivial (A ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJtop
    haveI : IsLocalRing (A ⧸ J) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
    have htor : Module.IsTorsionBySet A N (J : Set A) := fun y a => hk a a.2 y
    letI : Module (A ⧸ J) N := htor.module
    haveI : IsScalarTower A (A ⧸ J) N := htor.isScalarTower
    have hnil : IsNilpotent (IsLocalRing.maximalIdeal (A ⧸ J)) := by
      refine ⟨k, ?_⟩
      have hle : IsLocalRing.maximalIdeal (A ⧸ J) ≤
          (IsLocalRing.maximalIdeal A).map (Ideal.Quotient.mk J) := by
        intro b hb
        obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
        apply Ideal.mem_map_of_mem
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hb ⊢
        exact fun hu => hb (hu.map _)
      apply le_bot_iff.mp
      calc IsLocalRing.maximalIdeal (A ⧸ J) ^ k
          ≤ ((IsLocalRing.maximalIdeal A).map (Ideal.Quotient.mk J)) ^ k :=
            Ideal.pow_right_mono hle k
        _ = J.map (Ideal.Quotient.mk J) := by rw [Ideal.map_pow]
        _ = ⊥ := Ideal.map_quotient_self J
    haveI : IsArtinianRing (A ⧸ J) := (isArtinianRing_iff_isNilpotent_maximalIdeal _).mpr hnil
    have hfinB : Module.Finite (A ⧸ J) N ∧ IsArtinian (A ⧸ J) N := by
      have tf := IsArtinianRing.tfae (A ⧸ J) N
      rcases hN with h | h
      · have h' : IsArtinian (A ⧸ J) N := isArtinian_of_tower A h
        exact ⟨(tf.out 1 3).mpr h', h'⟩
      · have h' : Module.Finite (A ⧸ J) N := Module.Finite.of_restrictScalars_finite A (A ⧸ J) N
        exact ⟨h', (tf.out 1 3).mp h'⟩
    obtain ⟨h1, h2⟩ := hfinB
    haveI := h1
    haveI := h2
    haveI : Module.Finite A N := Module.Finite.trans (A ⧸ J) N
    haveI : IsNoetherian A N := isNoetherian_of_isNoetherianRing_of_finite A N
    haveI : IsArtinian A N :=
      isArtinian_of_surjective_algebraMap (R := A ⧸ J) Ideal.Quotient.mk_surjective
    exact isFiniteLength_iff_isNoetherian_isArtinian.mpr ⟨inferInstance, inferInstance⟩

  have hbound : ∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N],
      ∃ K : ℕ, ∀ y : N, (∃ k : ℕ, ∀ a ∈ (IsLocalRing.maximalIdeal A) ^ k, a • y = 0) →
        ∀ a ∈ (IsLocalRing.maximalIdeal A) ^ K, a • y = 0 := by
    intro N _ _ _
    haveI : IsNoetherian A N := isNoetherian_of_isNoetherianRing_of_finite A N
    let f : ℕ →o Submodule A N := ⟨fun k => Submodule.torsionBySet A N ↑((IsLocalRing.maximalIdeal A) ^ k),
      fun a b hab => Submodule.torsionBySet_le_torsionBySet_of_subset (Ideal.pow_le_pow_right hab)⟩
    obtain ⟨K, hK⟩ := (monotone_stabilizes_iff_noetherian.mpr inferInstance) f
    refine ⟨K, fun y ⟨k, hk⟩ a ha => ?_⟩
    rcases le_total k K with h | h
    · exact hk a (Ideal.pow_le_pow_right h ha)
    · have hy : y ∈ f k := by
        show y ∈ Submodule.torsionBySet A N ↑((IsLocalRing.maximalIdeal A) ^ k)
        rw [Submodule.mem_torsionBySet_iff]
        rintro ⟨b, hb⟩
        exact hk b hb
      rw [← hK k h] at hy
      have hy' : y ∈ Submodule.torsionBySet A N ↑((IsLocalRing.maximalIdeal A) ^ K) := hy
      rw [Submodule.mem_torsionBySet_iff] at hy'
      exact hy' ⟨a, ha⟩

  have hTtors : ∀ (N : Type u) [AddCommGroup N] [Module A N],
      ∀ t ∈ (⨆ k : ℕ, Submodule.torsionBySet A N ↑((IsLocalRing.maximalIdeal A) ^ k)),
        ∃ k : ℕ, ∀ a ∈ (IsLocalRing.maximalIdeal A) ^ k, a • t = 0 := by
    intro N _ _ t ht
    refine Submodule.iSup_induction _
      (motive := fun y => ∃ k : ℕ, ∀ a ∈ (IsLocalRing.maximalIdeal A) ^ k, a • y = 0)
      ht ?_ ⟨0, fun a _ => smul_zero a⟩ ?_
    · intro k z hz
      rw [Submodule.mem_torsionBySet_iff] at hz
      exact ⟨k, fun a ha => hz ⟨a, ha⟩⟩
    · rintro y z ⟨k₁, hk₁⟩ ⟨k₂, hk₂⟩
      refine ⟨max k₁ k₂, fun a ha => ?_⟩
      rw [smul_add, hk₁ a (Ideal.pow_le_pow_right (le_max_left _ _) ha),
        hk₂ a (Ideal.pow_le_pow_right (le_max_right _ _) ha), add_zero]

  have htfq : ∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N]
      (y : N ⧸ (⨆ k : ℕ, Submodule.torsionBySet A N ↑((IsLocalRing.maximalIdeal A) ^ k))),
      (∃ k : ℕ, ∀ a ∈ (IsLocalRing.maximalIdeal A) ^ k, a • y = 0) → y = 0 := by
    intro N _ _ _ y hy
    induction y using Submodule.Quotient.induction_on with
    | H z =>
    obtain ⟨K, hK⟩ := hbound N
    obtain ⟨k, hk⟩ := hy
    have hc : ∀ c ∈ (IsLocalRing.maximalIdeal A) ^ k,
        c • z ∈ (⨆ k : ℕ, Submodule.torsionBySet A N ↑((IsLocalRing.maximalIdeal A) ^ k)) := by
      intro c hc
      have := hk c hc
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at this
      exact this
    have hz : z ∈ (⨆ k : ℕ, Submodule.torsionBySet A N ↑((IsLocalRing.maximalIdeal A) ^ k)) := by
      apply Submodule.mem_iSup_of_mem (K + k)
      rw [Submodule.mem_torsionBySet_iff]
      rintro ⟨a, ha⟩
      show a • z = 0
      rw [pow_add] at ha
      have hmem : (IsLocalRing.maximalIdeal A) ^ K * (IsLocalRing.maximalIdeal A) ^ k ≤
          (A ∙ z).annihilator := by
        apply Ideal.mul_le.mpr
        intro b hb c hc'
        rw [Submodule.mem_annihilator_span_singleton, mul_smul]
        exact hK (c • z) (hTtors N _ (hc c hc')) b hb
      exact (Submodule.mem_annihilator_span_singleton _ _).mp (hmem ha)
    exact (Submodule.Quotient.mk_eq_zero _).mpr hz

  have hreg : ∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N],
      (∀ y : N, (∃ k : ℕ, ∀ a ∈ (IsLocalRing.maximalIdeal A) ^ k, a • y = 0) → y = 0) →
      ∀ (P : Finset (Ideal A)), (∀ p ∈ P, p.IsPrime ∧ p ≠ IsLocalRing.maximalIdeal A) →
        ∃ x ∈ IsLocalRing.maximalIdeal A, IsSMulRegular N x ∧ ∀ p ∈ P, x ∉ p := by
    intro N _ _ _ hN P hP
    set Q : Finset (Ideal A) := (associatedPrimes.finite A N).toFinset ∪ P with hQ
    have hQprime : ∀ q ∈ Q, q.IsPrime := by
      intro q hq
      rcases Finset.mem_union.mp hq with h | h
      · exact (Set.Finite.mem_toFinset _ |>.mp h).isPrime
      · exact (hP q h).1
    have hQne : ∀ q ∈ Q, q ≠ IsLocalRing.maximalIdeal A := by
      intro q hq
      rcases Finset.mem_union.mp hq with h | h
      · have ha : IsAssociatedPrime q N := (Set.Finite.mem_toFinset _).mp h
        intro hqm
        obtain ⟨hpr, y, hy⟩ := isAssociatedPrime_iff.mp ha
        have hy0 : y = 0 := by
          apply hN y ⟨1, fun a ha => ?_⟩
          rw [pow_one] at ha
          rw [← hqm, hy, Submodule.mem_colon_singleton] at ha
          exact ha
        apply hpr.ne_top
        rw [Ideal.eq_top_iff_one, hy, Submodule.mem_colon_singleton, hy0, smul_zero]
        exact Submodule.zero_mem _
      · exact (hP q h).2
    have hex : ∃ x ∈ IsLocalRing.maximalIdeal A, ∀ q ∈ Q, x ∉ q := by
      by_contra hcon
      push_neg at hcon
      have hsub : ((IsLocalRing.maximalIdeal A : Ideal A) : Set A) ⊆
          ⋃ q ∈ (Q : Set (Ideal A)), ((id q : Ideal A) : Set A) := by
        intro x hx
        obtain ⟨q, hq, hxq⟩ := hcon x hx
        exact Set.mem_biUnion (x := q) hq hxq
      obtain ⟨q, hq, hmq⟩ := (Ideal.subset_union_prime (s := Q) (f := id) (⊥ : Ideal A) ⊥
        (fun i hi _ _ => hQprime i hi)).mp hsub
      have hqm : q ≤ IsLocalRing.maximalIdeal A := IsLocalRing.le_maximalIdeal (hQprime q hq).ne_top
      exact hQne q hq (le_antisymm hqm hmq)
    obtain ⟨x, hxm, hxQ⟩ := hex
    refine ⟨x, hxm, ?_, fun p hp => hxQ p (Finset.mem_union_right _ hp)⟩
    have : x ∈ (⋃ p ∈ associatedPrimes A N, (p : Set A))ᶜ := by
      simp only [Set.mem_compl_iff, Set.mem_iUnion, not_exists]
      intro p hp hxp
      exact hxQ p (Finset.mem_union_left _ ((Set.Finite.mem_toFinset _).mpr hp)) hxp
    rw [biUnion_associatedPrimes_eq_compl_regular A N, compl_compl] at this
    exact this

  have hsec : ∀ (H : Type u) [AddCommGroup H] [Module A H] [IsArtinian A H],
      ∃ S : Finset (Submodule A H), S.sup id = ⊤ ∧
        ∀ N ∈ S, ∀ a : A, (∀ y ∈ N, ∃ z ∈ N, a • z = y) ∨ ∃ k : ℕ, ∀ y ∈ N, a ^ k • y = 0 := by
    intro H _ _ _
    suffices h : ∀ N : Submodule A H, ∃ S : Finset (Submodule A H), S.sup id = N ∧
        ∀ N' ∈ S, ∀ a : A, (∀ y ∈ N', ∃ z ∈ N', a • z = y) ∨
          ∃ k : ℕ, ∀ y ∈ N', a ^ k • y = 0 from h ⊤
    intro N
    refine WellFoundedLT.induction (motive := fun N : Submodule A H => ∃ S : Finset (Submodule A H),
      S.sup id = N ∧ ∀ N' ∈ S, ∀ a : A, (∀ y ∈ N', ∃ z ∈ N', a • z = y) ∨
        ∃ k : ℕ, ∀ y ∈ N', a ^ k • y = 0) N ?_
    intro N ih
    by_cases hgood : ∀ a : A, (∀ y ∈ N, ∃ z ∈ N, a • z = y) ∨ ∃ k : ℕ, ∀ y ∈ N, a ^ k • y = 0
    · exact ⟨{N}, by simp, fun N' hN' => by rw [Finset.mem_singleton.mp hN']; exact hgood⟩
    push_neg at hgood
    obtain ⟨a, ⟨y₀, hy₀, hnsurj⟩, hnnil⟩ := hgood
    let img : ℕ → Submodule A H := fun k => N.map (a ^ k • (LinearMap.id : H →ₗ[A] H))
    have hmem : ∀ k y, y ∈ img k ↔ ∃ x ∈ N, a ^ k • x = y := by
      intro k y
      simp [img, Submodule.mem_map]
    have hanti : ∀ k l, k ≤ l → img l ≤ img k := by
      intro k l hkl y hy
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hkl
      obtain ⟨x, hx, rfl⟩ := (hmem _ y).mp hy
      exact (hmem k _).mpr ⟨a ^ d • x, N.smul_mem _ hx, by rw [pow_add, mul_smul]⟩
    let c : ℕ →o (Submodule A H)ᵒᵈ := ⟨fun k => OrderDual.toDual (img k), fun k l h => hanti k l h⟩
    obtain ⟨n, hn⟩ := IsArtinian.monotone_stabilizes c
    have hs1 : img n = img (n + 1) := hn (n + 1) (by omega)
    have hs2 : img n = img (n + n) := hn (n + n) (by omega)
    set N' := img n with hN'
    set N'' := N ⊓ Submodule.torsionBy A H (a ^ n) with hN''
    have hN'le : N' ≤ N := by
      intro y hy
      obtain ⟨x, hx, rfl⟩ := (hmem n y).mp hy
      exact N.smul_mem _ hx
    have hN''le : N'' ≤ N := inf_le_left
    have hN'ne : N' ≠ N := by
      intro heq
      have : y₀ ∈ img (n + 1) := by rw [← hs1, heq]; exact hy₀
      obtain ⟨x, hx, hxy⟩ := (hmem _ _).mp this
      apply hnsurj (a ^ n • x) (N.smul_mem _ hx)
      rw [← hxy, pow_succ', mul_smul]
    have hN''ne : N'' ≠ N := by
      intro heq
      obtain ⟨y, hy, hy0⟩ := hnnil n
      have : y ∈ N'' := heq ▸ hy
      exact hy0 ((Submodule.mem_torsionBy_iff _ _).mp this.2)
    have hsup : N' ⊔ N'' = N := by
      apply le_antisymm (sup_le hN'le hN''le)
      intro y hy
      have h1 : a ^ n • y ∈ img (n + n) := by rw [← hs2]; exact (hmem n _).mpr ⟨y, hy, rfl⟩
      obtain ⟨z, hz, hzy⟩ := (hmem _ _).mp h1
      rw [Submodule.mem_sup]
      refine ⟨a ^ n • z, (hmem n _).mpr ⟨z, hz, rfl⟩, y - a ^ n • z,
        ⟨N.sub_mem hy (N.smul_mem _ hz), ?_⟩, by abel⟩
      rw [SetLike.mem_coe, Submodule.mem_torsionBy_iff, smul_sub, ← mul_smul, ← pow_add, hzy,
        sub_self]
    obtain ⟨S', hS', hg'⟩ := ih N' (lt_of_le_of_ne hN'le hN'ne)
    obtain ⟨S'', hS'', hg''⟩ := ih N'' (lt_of_le_of_ne hN''le hN''ne)
    refine ⟨S' ∪ S'', by rw [Finset.sup_union, hS', hS'', hsup], ?_⟩
    intro M hM
    rcases Finset.mem_union.mp hM with h | h
    · exact hg' M h
    · exact hg'' M h

  have havoid : ∀ (H : Type u) [AddCommGroup H] [Module A H]
      (S : Finset (Submodule A H)), S.sup id = ⊤ →
      (∀ N ∈ S, ∀ a : A, (∀ y ∈ N, ∃ z ∈ N, a • z = y) ∨ ∃ k : ℕ, ∀ y ∈ N, a ^ k • y = 0) →
      ∃ P : Finset (Ideal A), (∀ p ∈ P, p.IsPrime ∧ p ≠ IsLocalRing.maximalIdeal A) ∧
        ∃ K : ℕ, ∀ x : A, (∀ p ∈ P, x ∉ p) →
          ∀ a ∈ (IsLocalRing.maximalIdeal A) ^ K, ∀ h : H, ∃ h' : H, a • h = x • h' := by
    intro H _ _ S hS hgood
    set p : Submodule A H → Ideal A := fun N => N.annihilator.radical with hp
    have hmemp : ∀ N a, a ∈ p N ↔ ∃ k : ℕ, ∀ y ∈ N, a ^ k • y = 0 := by
      intro N a
      show a ∈ N.annihilator.radical ↔ _
      rw [Ideal.mem_radical_iff]
      simp only [Submodule.mem_annihilator]
    have hprime : ∀ N ∈ S, N ≠ ⊥ → (p N).IsPrime := by
      intro N hN hne
      obtain ⟨y0, hy0, hy0ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
      refine ⟨?_, ?_⟩
      · intro htop
        have h1 : (1 : A) ∈ p N := htop ▸ Submodule.mem_top
        obtain ⟨k, hk⟩ := (hmemp N 1).mp h1
        exact hy0ne (by simpa using hk y0 hy0)
      · intro a b hab
        by_contra hcon
        push_neg at hcon
        obtain ⟨ha, hb⟩ := hcon
        have hsa := (hgood N hN a).resolve_right (fun h => ha ((hmemp N a).mpr h))
        have hsb := (hgood N hN b).resolve_right (fun h => hb ((hmemp N b).mpr h))
        obtain ⟨k, hk⟩ := (hmemp N (a * b)).mp hab
        have hsurj : ∀ n : ℕ, ∀ y ∈ N, ∃ z ∈ N, (a * b) ^ n • z = y := by
          intro n
          induction n with
          | zero => intro y hy; exact ⟨y, hy, by simp⟩
          | succ n ih =>
            intro y hy
            obtain ⟨z, hz, rfl⟩ := ih y hy
            obtain ⟨w, hw, rfl⟩ := hsa z hz
            obtain ⟨v, hv, rfl⟩ := hsb w hw
            exact ⟨v, hv, by rw [pow_succ, mul_smul, mul_smul]⟩
        obtain ⟨z, hz, hzy⟩ := hsurj k y0 hy0
        exact hy0ne (by rw [← hzy]; exact hk z hz)
    have hKex : ∀ N : Submodule A H, ∃ K : ℕ,
        IsLocalRing.maximalIdeal A ≤ p N → (IsLocalRing.maximalIdeal A) ^ K ≤ N.annihilator := by
      intro N
      by_cases hle : IsLocalRing.maximalIdeal A ≤ p N
      · obtain ⟨K, hK⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hle
          (IsNoetherian.noetherian (IsLocalRing.maximalIdeal A))
        exact ⟨K, fun _ => hK⟩
      · exact ⟨0, fun h => absurd h hle⟩
    choose Kf hKf using hKex
    refine ⟨(S.filter (fun N => N ≠ ⊥ ∧ p N ≠ IsLocalRing.maximalIdeal A)).image p, ?_,
      S.sup Kf, ?_⟩
    · intro q hq
      obtain ⟨N, hN, rfl⟩ := Finset.mem_image.mp hq
      obtain ⟨hNS, hbot, hpm⟩ := Finset.mem_filter.mp hN
      exact ⟨hprime N hNS hbot, hpm⟩
    intro x hx a ha h
    have key : ∀ T : Finset (Submodule A H), T ⊆ S → ∀ h ∈ T.sup id, ∃ h' : H, a • h = x • h' := by
      intro T
      induction T using Finset.induction_on with
      | empty =>
        intro _ h hh
        rw [Finset.sup_empty] at hh
        rw [(Submodule.mem_bot A).mp hh]
        exact ⟨0, by simp⟩
      | insert N T hNT ih =>
        intro hsub h hh
        rw [Finset.sup_insert, id, Submodule.mem_sup] at hh
        obtain ⟨y, hy, z, hz, rfl⟩ := hh
        obtain ⟨z', hz'⟩ := ih (fun t ht => hsub (Finset.mem_insert_of_mem ht)) z hz
        have hNS : N ∈ S := hsub (Finset.mem_insert_self N T)
        obtain ⟨w, hw⟩ : ∃ w, a • y = x • w := by
          by_cases hbot : N = ⊥
          · subst hbot
            rw [(Submodule.mem_bot A).mp hy]
            exact ⟨0, by simp⟩
          by_cases hpm : p N = IsLocalRing.maximalIdeal A
          · refine ⟨0, ?_⟩
            have ha' : a ∈ N.annihilator :=
              hKf N hpm.ge (Ideal.pow_le_pow_right (Finset.le_sup (f := Kf) hNS) ha)
            rw [smul_zero]
            exact (Submodule.mem_annihilator.mp ha') y hy
          · have hxP : x ∉ p N := hx (p N) (Finset.mem_image.mpr
              ⟨N, Finset.mem_filter.mpr ⟨hNS, hbot, hpm⟩, rfl⟩)
            have hs := (hgood N hNS x).resolve_right (fun h => hxP ((hmemp N x).mpr h))
            obtain ⟨w, _, hw⟩ := hs (a • y) (N.smul_mem a hy)
            exact ⟨w, hw.symm⟩
        exact ⟨w + z', by rw [smul_add, smul_add, hw, hz']⟩
    exact key S subset_rfl h (hS ▸ Submodule.mem_top)

  have htors : ∀ (n : ℕ) (N : ModuleCat.{u} A)
      (y : ↑((localCohomology (IsLocalRing.maximalIdeal A) n).obj N)),
      ∃ k : ℕ, ∀ a ∈ (IsLocalRing.maximalIdeal A) ^ k, a • y = 0 := by
    intro n N y
    have := Limits.preservesFilteredColimitsOfSize_of_univLE.{u, u, 0, 0} (forget (ModuleCat.{u} A))
    let D := localCohomology.diagram (localCohomology.idealPowersDiagram (IsLocalRing.maximalIdeal A)) n
    let F : ℕᵒᵖᵒᵖ ⥤ ModuleCat.{u} A := D ⋙ (evaluation (ModuleCat.{u} A) (ModuleCat.{u} A)).obj N
    have : Limits.PreservesColimit F (forget (ModuleCat.{u} A)) := inferInstance
    let e := Limits.colimitObjIsoColimitCompEvaluation D N
    have he : ∀ j (z : (D.obj j).obj N),
        e.hom.hom (((Limits.colimit.ι D j).app N).hom z) = (Limits.colimit.ι F j).hom z := by
      intro j z
      have := congrArg (fun ψ => ModuleCat.Hom.hom ψ z)
        (Limits.colimitObjIsoColimitCompEvaluation_ι_app_hom D j N)
      simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at this
      exact this
    have hinj : Function.Injective e.hom.hom :=
      (ModuleCat.mono_iff_injective e.hom).mp inferInstance
    obtain ⟨j, z, hz⟩ := Limits.Concrete.colimit_exists_rep F (e.hom y)
    have hy : ((Limits.colimit.ι D j).app N).hom z = y := hinj (by rw [he]; exact hz)
    refine ⟨j.unop.unop, fun a ha => ?_⟩
    let X := (localCohomology.ringModIdeals
      (localCohomology.idealPowersDiagram (IsLocalRing.maximalIdeal A))).obj j.unop
    have h0 : a • 𝟙 X = (0 : A) • 𝟙 X := by
      rw [zero_smul]
      apply ModuleCat.hom_ext
      rw [ModuleCat.hom_smul, ModuleCat.hom_id, ModuleCat.hom_zero]
      ext b
      rw [LinearMap.smul_apply, LinearMap.id_apply, LinearMap.zero_apply]
      induction b using Submodule.Quotient.induction_on with
      | H b =>
      rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, smul_eq_mul]
      exact Ideal.mul_mem_right b _ ha
    have h1 : (((Ext A (ModuleCat.{u} A) n).map (a • 𝟙 X).op).app N).hom z = a • z := by
      rw [wc_plt_lc_ext_smul_left, ModuleCat.hom_smul, ModuleCat.hom_id]
      rfl
    have h2 : (((Ext A (ModuleCat.{u} A) n).map ((0 : A) • 𝟙 X).op).app N).hom z = 0 := by
      rw [wc_plt_lc_ext_smul_left, ModuleCat.hom_smul, ModuleCat.hom_id, zero_smul]
      rfl
    rw [h0] at h1
    have hz0 : a • z = 0 := h1.symm.trans h2
    have hfin : a • (((Limits.colimit.ι D j).app N).hom z) = 0 := by
      rw [← map_smul, hz0, map_zero]
    rw [← hy]
    exact hfin

  have hart : ∀ (i : ℕ) (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N],
      IsArtinian A ((localCohomology (IsLocalRing.maximalIdeal A) i).obj (ModuleCat.of A N)) := by
    intro i
    induction i with
    | zero =>
      intro N _ _ _
      obtain ⟨e⟩ := wc_plt_lc_zero_eq_torsion A (IsLocalRing.maximalIdeal A) N
      obtain ⟨K, hK⟩ := hbound N
      have hfin : IsFiniteLength A
          ↥(⨆ k : ℕ, Submodule.torsionBySet A N ↑((IsLocalRing.maximalIdeal A) ^ k)) :=
        hfl _ ⟨K, fun a ha t => Subtype.ext (hK t.1 (hTtors N t.1 t.2) a ha)⟩
          (Or.inr inferInstance)
      haveI := (isFiniteLength_iff_isNoetherian_isArtinian.mp hfin).2
      exact isArtinian_of_linearEquiv e.symm
    | succ i ih =>
      intro N _ _ _
      set T := ⨆ k : ℕ, Submodule.torsionBySet A N ↑((IsLocalRing.maximalIdeal A) ^ k) with hT
      let S : ShortComplex (ModuleCat.{u} A) := ShortComplex.mk (ModuleCat.ofHom T.subtype)
        (ModuleCat.ofHom T.mkQ) (by
          ext y
          simp)
      have hS : S.ShortExact := by
        refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
        · rw [ShortComplex.moduleCat_exact_iff]
          intro y hy
          have hy' : (Submodule.Quotient.mk y : N ⧸ T) = 0 := hy
          rw [Submodule.Quotient.mk_eq_zero] at hy'
          exact ⟨⟨y, hy'⟩, rfl⟩
        · rw [ModuleCat.mono_iff_injective]
          exact Submodule.injective_subtype _
        · rw [ModuleCat.epi_iff_surjective]
          exact Submodule.mkQ_surjective _
      obtain ⟨δ0, hex1, -⟩ := wc_plt_lc_les A (IsLocalRing.maximalIdeal A) S hS (i + 1)
      have hzero : Limits.IsZero
          ((localCohomology (IsLocalRing.maximalIdeal A) (i + 1)).obj (ModuleCat.of A T)) := by
        apply wc_plt_lc_torsion_acyclic A _ T _ (i + 1) (by omega)
        rintro ⟨y, hy⟩
        obtain ⟨k, hk⟩ := hTtors N y hy
        exact ⟨k, fun a ha => Subtype.ext (hk a ha)⟩
      have hsub := ModuleCat.isZero_iff_subsingleton.mp hzero
      have hinj : Function.Injective
          ((localCohomology (IsLocalRing.maximalIdeal A) (i + 1)).map S.g).hom := by
        rw [injective_iff_map_eq_zero]
        intro z hz
        obtain ⟨w, rfl⟩ := (hex1 z).mp hz
        rw [Subsingleton.elim w 0, map_zero]
      suffices hM' : IsArtinian A
          ((localCohomology (IsLocalRing.maximalIdeal A) (i + 1)).obj (ModuleCat.of A (N ⧸ T))) from
        @isArtinian_of_injective _ _ _ _ _ _ _ _ _ hinj hM'
      have hM'0 : ∀ y : N ⧸ T,
          (∃ k : ℕ, ∀ a ∈ (IsLocalRing.maximalIdeal A) ^ k, a • y = 0) → y = 0 :=
        fun y hy => htfq N y hy
      obtain ⟨x, hxm, hxreg, -⟩ := hreg (N ⧸ T) hM'0 ∅ (by simp)
      let Sx : ShortComplex (ModuleCat.{u} A) := ShortComplex.mk (x • 𝟙 (ModuleCat.of A (N ⧸ T)))
        (ModuleCat.ofHom (Submodule.mkQ _ : (N ⧸ T) →ₗ[A] QuotSMulTop x (N ⧸ T))) (by
          apply ModuleCat.hom_ext
          apply LinearMap.ext
          intro y
          simp only [ModuleCat.hom_comp, ModuleCat.hom_smul, ModuleCat.hom_id, LinearMap.comp_apply,
            LinearMap.smul_apply, LinearMap.id_apply, ModuleCat.hom_ofHom, Submodule.mkQ_apply,
            ModuleCat.hom_zero, LinearMap.zero_apply]
          exact (Submodule.Quotient.mk_eq_zero _).mpr
            ((Submodule.mem_smul_pointwise_iff_exists _ _ _).mpr ⟨y, trivial, rfl⟩))
      have hSx : Sx.ShortExact := by
        refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
        · rw [ShortComplex.moduleCat_exact_iff]
          intro y hy
          have hy' : (Submodule.Quotient.mk y : QuotSMulTop x (N ⧸ T)) = 0 := hy
          rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_smul_pointwise_iff_exists] at hy'
          obtain ⟨z, -, hz⟩ := hy'
          exact ⟨z, hz⟩
        · rw [ModuleCat.mono_iff_injective]
          intro a b hab
          exact hxreg hab
        · rw [ModuleCat.epi_iff_surjective]
          exact Submodule.mkQ_surjective _
      obtain ⟨δ, hδ⟩ := wc_plt_lc_les_third A (IsLocalRing.maximalIdeal A) Sx hSx i
      have hα : ((localCohomology (IsLocalRing.maximalIdeal A) (i + 1)).map Sx.f).hom =
          x • LinearMap.id := by
        show ((localCohomology (IsLocalRing.maximalIdeal A) (i + 1)).map
          (x • 𝟙 (ModuleCat.of A (N ⧸ T)))).hom = _
        rw [wc_plt_lc_map_smul, ModuleCat.hom_smul, ModuleCat.hom_id]
      have hkerx : Submodule.torsionBy A
          ((localCohomology (IsLocalRing.maximalIdeal A) (i + 1)).obj (ModuleCat.of A (N ⧸ T))) x =
          LinearMap.range δ.hom := by
        ext y
        rw [Submodule.mem_torsionBy_iff, LinearMap.mem_range, ← Set.mem_range, ← hδ y, hα]
        rfl
      have hr : IsArtinian A (LinearMap.range δ.hom) :=
        @isArtinian_range _ _ _ _ _ _ _ _ δ.hom (ih (QuotSMulTop x (N ⧸ T)))
      have htx : IsArtinian A (Submodule.torsionBy A
          ((localCohomology (IsLocalRing.maximalIdeal A) (i + 1)).obj (ModuleCat.of A (N ⧸ T))) x) := by
        rw [hkerx]
        exact hr
      apply wc_plt_lc_melkersson A _ x _ htx
      intro y
      obtain ⟨k, hk⟩ := htors (i + 1) _ y
      exact ⟨k, hk _ (Ideal.pow_mem_pow hxm k)⟩

  haveI hH : IsArtinian A
      ((localCohomology (IsLocalRing.maximalIdeal A) i).obj (ModuleCat.of A M)) := hart i M
  obtain ⟨S, hS, hgood⟩ :=
    hsec ((localCohomology (IsLocalRing.maximalIdeal A) i).obj (ModuleCat.of A M))
  obtain ⟨P, hP, K, hK⟩ :=
    havoid ((localCohomology (IsLocalRing.maximalIdeal A) i).obj (ModuleCat.of A M)) S hS hgood
  obtain ⟨x, hxm, hxreg, hxP⟩ := hreg M hM P hP
  refine ⟨x, hxm, hxreg, ?_⟩
  apply hfl (QuotSMulTop x
    ((localCohomology (IsLocalRing.maximalIdeal A) i).obj (ModuleCat.of A M))) ⟨K, ?_⟩
    (Or.inl inferInstance)
  intro a ha q
  induction q using Submodule.Quotient.induction_on with
  | H h =>
  obtain ⟨h', hh'⟩ := hK x hxP a ha h
  rw [← Submodule.Quotient.mk_smul, hh', Submodule.Quotient.mk_eq_zero]
  exact Submodule.smul_mem_pointwise_smul _ _ _ Submodule.mem_top

theorem wc_plt_lc_grothendieck_nonvanishing (A : Type u) [CommRing A] [IsNoetherianRing A]
    [IsLocalRing A] (d : ℕ) (hd : ringKrullDim A = d) :
    ¬ Limits.IsZero ((localCohomology (IsLocalRing.maximalIdeal A) d).obj (ModuleCat.of A A)) :=
by
  classical
  set m := IsLocalRing.maximalIdeal A with hm

  have cancel : ∀ (a : WithBot ℕ∞) (n : ℕ), a + 1 = ((n + 1 : ℕ) : WithBot ℕ∞) →
      a = (n : WithBot ℕ∞) := by
    intro a n h
    induction a using WithBot.recBotCoe with
    | bot => exact absurd h (by rw [WithBot.bot_add]; exact WithBot.bot_ne_coe)
    | coe b =>
      induction b using ENat.recTopCoe with
      | top =>
        exact absurd h (by
          rw [← WithBot.coe_one, ← WithBot.coe_add, top_add]
          exact fun h' => ENat.top_ne_natCast (n + 1) (WithBot.coe_injective h'))
      | coe k =>
        have h2 : ((k + 1 : ℕ) : WithBot ℕ∞) = ((n + 1 : ℕ) : WithBot ℕ∞) := by exact_mod_cast h
        have h3 : k + 1 = n + 1 := by exact_mod_cast h2
        have h4 : k = n := by omega
        subst h4
        rfl

  have s7 : ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M],
      Module.supportDim A M ≤ 0 → ∃ k : ℕ, ∀ a ∈ m ^ k, ∀ y : M, a • y = 0 := by
    intro M _ _ _ hM
    have hmax := Order.krullDim_nonpos_iff_forall_isMax.mp hM
    have hrad : m ≤ (Module.annihilator A M).radical := by
      rw [Ideal.radical_eq_sInf]
      refine le_sInf ?_
      rintro J ⟨hJ, hJp⟩
      let p : PrimeSpectrum A := ⟨J, hJp⟩
      have hp : p ∈ Module.support A M := Module.mem_support_iff_of_finite.mpr hJ
      have hJm : J ≤ m := IsLocalRing.le_maximalIdeal hJp.ne_top
      have hmS : IsLocalRing.closedPoint A ∈ Module.support A M :=
        Module.mem_support_iff_of_finite.mpr (hJ.trans hJm)
      have hle : (⟨p, hp⟩ : Module.support A M) ≤ ⟨IsLocalRing.closedPoint A, hmS⟩ := hJm
      exact hmax ⟨p, hp⟩ hle
    obtain ⟨k, hk⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hrad (IsNoetherian.noetherian m)
    exact ⟨k, fun a ha y => Module.mem_annihilator.mp (hk ha) y⟩

  have s8 : ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M] [Nontrivial M]
      (x : A), x ∈ m → IsSMulRegular M x → ∀ t : ℕ,
      (t : ℕ∞) ≤ Module.length A (QuotSMulTop (x ^ t) M) := by
    intro M _ _ _ _ x hx hreg t
    open Pointwise in
    have hnak : ¬ ((⊤ : Submodule A M) ≤ x • (⊤ : Submodule A M)) := by
      intro h
      have h' : (⊤ : Submodule A M) ≤ Ideal.span {x} • ⊤ := by
        rwa [Submodule.ideal_span_singleton_smul]
      have hbot := Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (Ideal.span {x}) ⊤
        Module.Finite.fg_top h'
        ((Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hx)).trans
          (IsLocalRing.maximalIdeal_le_jacobson ⊥))
      obtain ⟨a, b, hab⟩ := exists_pair_ne M
      apply hab
      have ha : a ∈ (⊥ : Submodule A M) := hbot ▸ Submodule.mem_top
      have hb : b ∈ (⊥ : Submodule A M) := hbot ▸ Submodule.mem_top
      rw [Submodule.mem_bot] at ha hb
      rw [ha, hb]
    induction t with
    | zero => simp
    | succ t ih =>
      open Pointwise in
      have hle : (x ^ (t + 1) • (⊤ : Submodule A M)) ≤ x ^ t • (⊤ : Submodule A M) := by
        intro y hy
        obtain ⟨z, -, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp hy
        exact (Submodule.mem_smul_pointwise_iff_exists _ _ _).mpr
          ⟨x • z, trivial, by rw [pow_succ, mul_smul]⟩
      have hsurj : Function.Surjective (Submodule.factor hle) := by
        intro q
        obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective _ q
        exact ⟨Submodule.mkQ _ y, Submodule.factor_mk hle y⟩
      have hsplit := Module.length_eq_add_of_exact (LinearMap.ker (Submodule.factor hle)).subtype
        (Submodule.factor hle) (Submodule.injective_subtype _) hsurj
        (by rw [LinearMap.exact_iff, Submodule.range_subtype])
      open Pointwise in
      have hex : ∃ y : M, x ^ t • y ∉ (x ^ (t + 1) • (⊤ : Submodule A M)) := by
        by_contra hcon
        push_neg at hcon
        apply hnak
        intro y _
        obtain ⟨z, -, hz⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp (hcon y)
        refine (Submodule.mem_smul_pointwise_iff_exists _ _ _).mpr ⟨z, trivial, ?_⟩
        exact (hreg.pow t) (show x ^ t • (x • z) = x ^ t • y by
          rw [← mul_smul, ← pow_succ]; exact hz)
      obtain ⟨y, hy⟩ := hex
      have hmem : Submodule.mkQ _ (x ^ t • y) ∈ LinearMap.ker (Submodule.factor hle) := by
        rw [LinearMap.mem_ker, Submodule.factor_mk, Submodule.mkQ_apply,
          Submodule.Quotient.mk_eq_zero]
        exact (Submodule.mem_smul_pointwise_iff_exists _ _ _).mpr ⟨y, trivial, rfl⟩
      have : Nontrivial (LinearMap.ker (Submodule.factor hle)) :=
        ⟨⟨⟨_, hmem⟩, 0, fun h => hy ((Submodule.Quotient.mk_eq_zero _).mp
          (congrArg Subtype.val h))⟩⟩
      have h1 : 1 ≤ Module.length A (LinearMap.ker (Submodule.factor hle)) := by
        have hpos : 0 < Module.length A (LinearMap.ker (Submodule.factor hle)) :=
          Module.length_pos_iff.mpr inferInstance
        exact Order.one_le_iff_pos.mpr hpos
      calc ((t + 1 : ℕ) : ℕ∞) = 1 + (t : ℕ∞) := by rw [Nat.cast_succ, add_comm]
        _ ≤ Module.length A (LinearMap.ker (Submodule.factor hle)) +
            Module.length A (QuotSMulTop (x ^ t) M) := add_le_add h1 ih
        _ = _ := hsplit.symm

  have s5 : ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M] (r : ℕ), 1 ≤ r →
      Module.supportDim A M = r →
      Nontrivial (M ⧸ (⨆ k : ℕ, Submodule.torsionBySet A M ↑(m ^ k))) ∧
      Module.supportDim A (M ⧸ (⨆ k : ℕ, Submodule.torsionBySet A M ↑(m ^ k))) = r ∧
      ∀ y : M ⧸ (⨆ k : ℕ, Submodule.torsionBySet A M ↑(m ^ k)),
        (∃ k : ℕ, ∀ a ∈ m ^ k, a • y = 0) → y = 0 := by
    intro M _ _ _ r hr hdim
    set T := ⨆ k : ℕ, Submodule.torsionBySet A M ↑(m ^ k) with hT
    have hmono : Monotone (fun k : ℕ => Submodule.torsionBySet A M ↑(m ^ k)) := by
      intro i j hij y hy
      rw [Submodule.mem_torsionBySet_iff] at hy ⊢
      rintro ⟨a, ha⟩
      exact hy ⟨a, Ideal.pow_le_pow_right hij ha⟩
    obtain ⟨c, hc⟩ := (monotone_stabilizes_iff_noetherian.mpr inferInstance) ⟨_, hmono⟩
    have hTc : ∀ y ∈ T, ∀ a ∈ m ^ c, a • y = 0 := by
      intro y hy
      refine Submodule.iSup_induction _ (motive := fun y => ∀ a ∈ m ^ c, a • y = 0) hy ?_
        (fun a _ => smul_zero a) ?_
      · intro k z hz
        have h1 : z ∈ Submodule.torsionBySet A M ↑(m ^ (max k c)) := hmono (le_max_left k c) hz
        have h2 : Submodule.torsionBySet A M ↑(m ^ c) =
            Submodule.torsionBySet A M ↑(m ^ (max k c)) := hc (max k c) (le_max_right k c)
        rw [← h2, Submodule.mem_torsionBySet_iff] at h1
        intro a ha
        exact h1 ⟨a, ha⟩
      · intro y z hy hz a ha
        rw [smul_add, hy a ha, hz a ha, add_zero]
    have hΓ : ∀ y : M ⧸ T, (∃ k : ℕ, ∀ a ∈ m ^ k, a • y = 0) → y = 0 := by
      rintro y ⟨k, hk⟩
      obtain ⟨y, rfl⟩ := Submodule.mkQ_surjective T y
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      apply Submodule.mem_iSup_of_mem (c + k)
      rw [Submodule.mem_torsionBySet_iff]
      rintro ⟨e, he⟩
      rw [pow_add] at he
      have hle : m ^ c * m ^ k ≤ LinearMap.ker (LinearMap.toSpanSingleton A M y) := by
        rw [Ideal.mul_le]
        intro a ha b hb
        rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply, mul_smul]
        have h1 := hk b hb
        rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h1
        exact hTc _ h1 a ha
      have := hle he
      rwa [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply] at this
    have hann : ∀ p : Ideal A, p.IsPrime → Module.annihilator A M ≤ p → ¬ m ≤ p →
        Module.annihilator A (M ⧸ T) ≤ p := by
      intro p hp hMp hmp a ha
      have hmc : ¬ m ^ c ≤ p := fun h => hmp (hp.le_of_pow_le h)
      obtain ⟨b, hb, hbp⟩ := SetLike.not_le_iff_exists.mp hmc
      have hba : b * a ∈ Module.annihilator A M := by
        rw [Module.mem_annihilator]
        intro y
        rw [mul_smul]
        apply hTc _ _ b hb
        have h1 := Module.mem_annihilator.mp ha (T.mkQ y)
        rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h1
        exact h1
      exact (hp.mem_or_mem (hMp hba)).resolve_left hbp
    have hr' : ((r : ℕ) : WithBot ℕ∞) ≤ Order.krullDim (Module.support A M) := by
      change ((r : ℕ) : WithBot ℕ∞) ≤ Module.supportDim A M
      exact hdim.ge
    obtain ⟨l, hl⟩ := Order.le_krullDim_iff.mp hr'
    have hlt : l 0 < l (Fin.last l.length) :=
      l.strictMono (by rw [Fin.lt_def, Fin.val_zero, Fin.val_last]; omega)
    have hlt' : (l 0).1.asIdeal < (l (Fin.last l.length)).1.asIdeal := hlt
    have hlem : (l (Fin.last l.length)).1.asIdeal ≤ m :=
      IsLocalRing.le_maximalIdeal (l (Fin.last l.length)).1.isPrime.ne_top
    have hmp0 : ¬ m ≤ (l 0).1.asIdeal := fun h =>
      absurd (hlt'.trans_le (hlem.trans h)) (lt_irrefl _)
    have hann0 : Module.annihilator A (M ⧸ T) ≤ (l 0).1.asIdeal :=
      hann _ (l 0).1.isPrime (Module.mem_support_iff_of_finite.mp (l 0).2) hmp0
    have hall : ∀ i, (l i).1 ∈ Module.support A (M ⧸ T) := by
      intro i
      apply Module.mem_support_iff_of_finite.mpr
      refine hann0.trans ?_
      have : l 0 ≤ l i := l.strictMono.monotone (Fin.zero_le i)
      exact this
    let l' : LTSeries (Module.support A (M ⧸ T)) :=
      LTSeries.mk l.length (fun i => ⟨(l i).1, hall i⟩) (fun i j hij => by
        show (l i).1 < (l j).1
        exact l.strictMono hij)
    have hge : ((r : ℕ) : WithBot ℕ∞) ≤ Module.supportDim A (M ⧸ T) := by
      change ((r : ℕ) : WithBot ℕ∞) ≤ Order.krullDim (Module.support A (M ⧸ T))
      exact Order.le_krullDim_iff.mpr ⟨l', hl⟩
    have hle : Module.supportDim A (M ⧸ T) ≤ Module.supportDim A M :=
      Module.supportDim_le_of_surjective T.mkQ (Submodule.mkQ_surjective T)
    refine ⟨?_, le_antisymm (hle.trans hdim.le) hge, hΓ⟩
    by_contra hnt
    rw [not_nontrivial_iff_subsingleton] at hnt
    have htop : Module.annihilator A (M ⧸ T) = ⊤ := Module.annihilator_eq_top_iff.mpr hnt
    rw [htop] at hann0
    exact (l 0).1.isPrime.ne_top (top_le_iff.mp hann0)

  have h0top : ∀ (M : Type u) [AddCommGroup M] [Module A M],
      (∃ k : ℕ, ∀ a ∈ m ^ k, ∀ y : M, a • y = 0) →
      Nonempty (((localCohomology m 0).obj (ModuleCat.of A M)) ≃ₗ[A] M) := by
    intro M _ _ hk
    obtain ⟨k, hk⟩ := hk
    obtain ⟨e⟩ := wc_plt_lc_zero_eq_torsion A m M
    have htop : (⨆ k : ℕ, Submodule.torsionBySet A M ↑(m ^ k)) = ⊤ := by
      rw [eq_top_iff]
      intro y _
      apply Submodule.mem_iSup_of_mem k
      rw [Submodule.mem_torsionBySet_iff]
      rintro ⟨a, ha⟩
      exact hk a ha y
    exact ⟨e.trans (LinearEquiv.ofTop _ htop)⟩

  have h0zero : ∀ (N : Type u) [AddCommGroup N] [Module A N],
      (∀ y : N, (∃ k : ℕ, ∀ a ∈ m ^ k, a • y = 0) → y = 0) →
      Subsingleton ((localCohomology m 0).obj (ModuleCat.of A N)) := by
    intro N _ _ hN
    obtain ⟨e⟩ := wc_plt_lc_zero_eq_torsion A m N
    have key : ∀ y ∈ (⨆ k : ℕ, Submodule.torsionBySet A N ↑(m ^ k)), y = 0 := by
      intro y hy
      refine Submodule.iSup_induction _ (motive := fun y => y = 0) hy ?_ rfl ?_
      · intro k z hz
        apply hN z ⟨k, fun a ha => ?_⟩
        rw [Submodule.mem_torsionBySet_iff] at hz
        exact hz ⟨a, ha⟩
      · intro y z hy hz
        rw [hy, hz, add_zero]
    have : Subsingleton ↥(⨆ k : ℕ, Submodule.torsionBySet A N ↑(m ^ k)) := by
      constructor
      rintro ⟨a, ha⟩ ⟨b, hb⟩
      apply Subtype.ext
      exact (key a ha).trans (key b hb).symm
    exact e.toEquiv.subsingleton

  have smulLES : ∀ (N : Type u) [AddCommGroup N] [Module A N] (c : A), IsSMulRegular N c →
      ∀ n : ℕ, ∃ δ : (localCohomology m n).obj (ModuleCat.of A (QuotSMulTop c N)) ⟶
          (localCohomology m (n + 1)).obj (ModuleCat.of A N),
        Function.Exact ⇑((localCohomology m n).map (c • 𝟙 (ModuleCat.of A N))).hom
          ⇑((localCohomology m n).map
            (ModuleCat.ofHom (Submodule.mkQ _ : N →ₗ[A] QuotSMulTop c N))).hom ∧
        Function.Exact ⇑((localCohomology m n).map
            (ModuleCat.ofHom (Submodule.mkQ _ : N →ₗ[A] QuotSMulTop c N))).hom ⇑δ.hom := by
    intro N _ _ c hc n
    let S : ShortComplex (ModuleCat.{u} A) := ShortComplex.mk (c • 𝟙 (ModuleCat.of A N))
      (ModuleCat.ofHom (Submodule.mkQ _ : N →ₗ[A] QuotSMulTop c N)) (by
        ext y
        simp only [ModuleCat.hom_comp, ModuleCat.hom_smul, ModuleCat.hom_id, LinearMap.comp_apply,
          LinearMap.smul_apply, LinearMap.id_apply, ModuleCat.hom_ofHom, Submodule.mkQ_apply,
          ModuleCat.hom_zero, LinearMap.zero_apply]
        exact (Submodule.Quotient.mk_eq_zero _).mpr
          ((Submodule.mem_smul_pointwise_iff_exists _ _ _).mpr ⟨y, trivial, rfl⟩))
    have hS : S.ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · rw [ShortComplex.moduleCat_exact_iff]
        intro y hy
        have hy' : (Submodule.Quotient.mk y : QuotSMulTop c N) = 0 := hy
        rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_smul_pointwise_iff_exists] at hy'
        obtain ⟨z, -, hz⟩ := hy'
        exact ⟨z, hz⟩
      · rw [ModuleCat.mono_iff_injective]
        intro a b hab
        exact hc hab
      · rw [ModuleCat.epi_iff_surjective]
        exact Submodule.mkQ_surjective _
    obtain ⟨δ, h1, h2⟩ := wc_plt_lc_les A m S hS n
    exact ⟨δ, h1, h2⟩

  have red : ∀ (s : ℕ) (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M],
      Module.supportDim A M = ((s + 1 : ℕ) : WithBot ℕ∞) →
      (∀ (N : Type u) [AddCommGroup N] [Module A N] [Module.Finite A N] [Nontrivial N],
        Module.supportDim A N = ((s + 1 : ℕ) : WithBot ℕ∞) →
        (∀ y : N, (∃ k : ℕ, ∀ a ∈ m ^ k, a • y = 0) → y = 0) →
        Module.length A ((localCohomology m (s + 1)).obj (ModuleCat.of A N)) = ⊤) →
      Module.length A ((localCohomology m (s + 1)).obj (ModuleCat.of A M)) = ⊤ := by
    intro s M _ _ _ hdim H
    obtain ⟨hnt, hdimN, hΓ⟩ := s5 M (s + 1) (by omega) hdim
    set T := ⨆ k : ℕ, Submodule.torsionBySet A M ↑(m ^ k) with hT
    have hN := H (M ⧸ T) hdimN hΓ
    let S : ShortComplex (ModuleCat.{u} A) := ShortComplex.mk (ModuleCat.ofHom T.subtype)
      (ModuleCat.ofHom T.mkQ) (by
        ext y
        simp)
    have hS : S.ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · rw [ShortComplex.moduleCat_exact_iff]
        intro y hy
        have hy' : (Submodule.Quotient.mk y : M ⧸ T) = 0 := hy
        rw [Submodule.Quotient.mk_eq_zero] at hy'
        exact ⟨⟨y, hy'⟩, rfl⟩
      · rw [ModuleCat.mono_iff_injective]
        exact Submodule.injective_subtype _
      · rw [ModuleCat.epi_iff_surjective]
        exact Submodule.mkQ_surjective _
    obtain ⟨δ, -, hex2⟩ := wc_plt_lc_les A m S hS (s + 1)
    have hzero : Limits.IsZero ((localCohomology m (s + 1 + 1)).obj (ModuleCat.of A T)) := by
      apply wc_plt_lc_torsion_acyclic A m T _ (s + 1 + 1) (by omega)
      rintro ⟨y, hy⟩
      have : ∃ k : ℕ, ∀ a ∈ m ^ k, a • y = 0 := by
        refine Submodule.iSup_induction _ (motive := fun y => ∃ k : ℕ, ∀ a ∈ m ^ k, a • y = 0)
          hy ?_ ⟨0, fun a _ => smul_zero a⟩ ?_
        · intro k z hz
          rw [Submodule.mem_torsionBySet_iff] at hz
          exact ⟨k, fun a ha => hz ⟨a, ha⟩⟩
        · rintro y z ⟨k₁, hk₁⟩ ⟨k₂, hk₂⟩
          refine ⟨max k₁ k₂, fun a ha => ?_⟩
          rw [smul_add, hk₁ a (Ideal.pow_le_pow_right (le_max_left _ _) ha),
            hk₂ a (Ideal.pow_le_pow_right (le_max_right _ _) ha), add_zero]
      obtain ⟨k, hk⟩ := this
      exact ⟨k, fun a ha => Subtype.ext (hk a ha)⟩
    have hsub := ModuleCat.isZero_iff_subsingleton.mp hzero
    have hsurj : Function.Surjective ((localCohomology m (s + 1)).map S.g).hom := by
      intro z
      have hz : δ.hom z = 0 := Subsingleton.elim _ _
      exact (hex2 z).mp hz
    have hle := Module.length_le_of_surjective _ hsurj
    rw [show S.X₃ = ModuleCat.of A (M ⧸ T) from rfl, hN] at hle
    exact top_le_iff.mp hle

  have P : ∀ s : ℕ, ∀ (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M],
      Module.supportDim A M = ((s + 1 : ℕ) : WithBot ℕ∞) →
      Module.length A ((localCohomology m (s + 1)).obj (ModuleCat.of A M)) = ⊤ := by
    intro s
    induction s with
    | zero =>
      intro M _ _ _ hdim
      refine red 0 M hdim ?_
      intro N _ _ _ _ hdimN hΓ
      obtain ⟨x, hxm, hreg, -⟩ := wc_plt_lc_matlis_good_element A N hΓ 0
      apply ENat.eq_top_iff_forall_ge.mpr
      intro t
      rcases Nat.eq_zero_or_pos t with ht | ht
      · subst ht; exact bot_le
      have hregt := hreg.pow t
      have hxt : x ^ t ∈ m := Ideal.pow_mem_of_mem _ hxm t ht
      obtain ⟨δ, -, hex⟩ := smulLES N (x ^ t) hregt 0
      have hsub := h0zero N hΓ
      have hinj : Function.Injective δ.hom := by
        rw [injective_iff_map_eq_zero]
        intro z hz
        obtain ⟨w, rfl⟩ := (hex z).mp hz
        rw [Subsingleton.elim w 0, map_zero]
      have hdL := Module.supportDim_quotSMulTop_succ_eq_supportDim (M := N) hregt hxt
      rw [hdimN] at hdL
      have hdL0 := cancel _ 0 hdL
      obtain ⟨k, hk⟩ := s7 (QuotSMulTop (x ^ t) N) (by rw [hdL0]; simp)
      obtain ⟨e⟩ := h0top (QuotSMulTop (x ^ t) N) ⟨k, hk⟩
      calc (t : ℕ∞) ≤ Module.length A (QuotSMulTop (x ^ t) N) := s8 N x hxm hreg t
        _ = Module.length A ((localCohomology m 0).obj
              (ModuleCat.of A (QuotSMulTop (x ^ t) N))) := e.length_eq.symm
        _ ≤ _ := Module.length_le_of_injective δ.hom hinj
    | succ s ih =>
      intro M _ _ _ hdim
      refine red (s + 1) M hdim ?_
      intro N _ _ _ _ hdimN hΓ
      obtain ⟨x, hxm, hreg, hfin⟩ := wc_plt_lc_matlis_good_element A N hΓ (s + 1)
      have hdL := Module.supportDim_quotSMulTop_succ_eq_supportDim (M := N) hreg hxm
      rw [hdimN] at hdL
      have hdL' := cancel _ (s + 1) hdL
      have hL := ih (QuotSMulTop x N) hdL'
      obtain ⟨δ, hex1, hex2⟩ := smulLES N x hreg (s + 1)
      have hα : ((localCohomology m (s + 1)).map (x • 𝟙 (ModuleCat.of A N))).hom =
          x • LinearMap.id := by
        rw [wc_plt_lc_map_smul, ModuleCat.hom_smul, ModuleCat.hom_id]
      have hkerg := LinearMap.exact_iff.mp hex1
      rw [hα] at hkerg
      have hker : LinearMap.ker ((localCohomology m (s + 1)).map
            (ModuleCat.ofHom (Submodule.mkQ _ : N →ₗ[A] QuotSMulTop x N))).hom =
          (Submodule.mkQ _ : _ →ₗ[A] QuotSMulTop x
            ((localCohomology m (s + 1)).obj (ModuleCat.of A N))).ker := by
        rw [hkerg, Submodule.ker_mkQ]
        ext y
        rw [LinearMap.mem_range, Submodule.mem_smul_pointwise_iff_exists]
        simp
      have hfinR : Module.length A (LinearMap.range ((localCohomology m (s + 1)).map
            (ModuleCat.ofHom (Submodule.mkQ _ : N →ₗ[A] QuotSMulTop x N))).hom) ≠ ⊤ := by
        rw [← (LinearMap.quotKerEquivRange _).length_eq,
          (Submodule.quotEquivOfEq _ _ hker).length_eq, Submodule.ker_mkQ]
        exact Module.length_ne_top_iff.mpr hfin
      have hsplit := Module.length_eq_add_of_exact (LinearMap.ker δ.hom).subtype
        δ.hom.rangeRestrict (Submodule.injective_subtype _) (LinearMap.surjective_rangeRestrict _)
        (by rw [LinearMap.exact_iff, LinearMap.ker_rangeRestrict, Submodule.range_subtype])
      rw [hL, LinearMap.exact_iff.mp hex2] at hsplit
      have hrδ : Module.length A (LinearMap.range δ.hom) = ⊤ := by
        rcases ENat.add_eq_top.mp hsplit.symm with h | h
        · exact absurd h hfinR
        · exact h
      apply top_le_iff.mp
      rw [← hrδ]
      exact Module.length_le_of_injective (LinearMap.range δ.hom).subtype
        (Submodule.injective_subtype _)

  have hdimA : Module.supportDim A A = (d : WithBot ℕ∞) := by
    rw [Module.supportDim_eq_ringKrullDim_quotient_annihilator, ← hd]
    have hann : Module.annihilator A A = ⊥ := Module.annihilator_eq_bot.mpr inferInstance
    exact ringKrullDim_eq_of_ringEquiv ((Ideal.quotEquivOfEq hann).trans (RingEquiv.quotientBot A))
  intro hZ
  have hsub := ModuleCat.isZero_iff_subsingleton.mp hZ
  cases d with
  | zero =>
    obtain ⟨k, hk⟩ := s7 A (by rw [hdimA]; simp)
    obtain ⟨e⟩ := h0top A ⟨k, hk⟩
    have : Subsingleton A := e.symm.toEquiv.subsingleton
    exact not_subsingleton A this
  | succ s =>
    have h := P s A hdimA
    rw [Module.length_eq_zero] at h
    exact absurd h (by simp)

theorem wc_plt_hl_graded_completion (K : Type u) [Field K] (R : Type u) [CommRing R]
