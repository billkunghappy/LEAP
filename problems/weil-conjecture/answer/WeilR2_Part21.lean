  obtain ⟨Th, g, _, B, iB1, _, iB3, iB4, eB, _, _, _, _, hfibg, _, _, _, _, _⟩ :=
    wc_proet_strict_nbhd_of_fixed_point (wcProjK F'' M')
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP) yb (𝟙 _) rfl hsep
  have hc : g.left (eB.inv (IsLocalRing.closedPoint B)) = yb := by
