AtPrime (RingHom.ker e) →+* F'') (t : Fin n → Localization.AtPrime (RingHom.ker e)) (b : Module.Basis (Fin n ⊕ Fin (M' - 1)) (Localization.AtPrime (RingHom.ker e)) Ω[Localization.AtPrime (RingHom.ker e)⁄F'']) (a : Matrix (Fin n) (Fin n) F'') (H : Matrix (Fin n) (Fin n) (Localization.AtPrime (RingHom.ker e))) (w : Fin (M' - 1) → Localization.AtPrime (RingHom.ker e)), eX.comp (algebraMap F'' (Localization.AtPrime (RingHom.ker e))) = RingHom.id F'' ∧ IsLocalRing.maximalIdeal (Localization.AtPrime (RingHom.ker e)) = Ideal.span (Set.range t ∪ Set.range (fun k => algebraMap Γ(Xu.left, V) (Localization.AtPrime (RingHom.ker e)) (ρ (z k)))) ∧ (∀ i, b (Sum.inl i) = KaehlerDifferential.D F'' (Localization.AtPrime (RingHom.ker e)) (t i)) ∧ (∀ k, b (Sum.inr k) = KaehlerDifferential.D F'' (Localization.AtPrime (RingHom.ker e)) (algebraMap Γ(Xu.left, V) (Localization.AtPrime (RingHom.ker e)) (ρ (z k)))) ∧ (a + a.transpose).det ≠ 0 ∧ (∀ p q, H p q ∈ IsLocalRing.maximalIdeal (Localization.AtPrime (RingHom.ker e))) ∧ algebraMap Γ(Xu.left, V) (Localization.AtPrime (RingHom.ker e)) (ρ φ) = ∑ p, ∑ q, (algebraMap F'' (Localization.AtPrime (RingHom.ker e)) (a p q) + H p q) * t p * t q + ∑ k, algebraMap Γ(Xu.left, V) (Localization.AtPrime (RingHom.ker e)) (ρ (z k)) * w k ∧ (∀ 𝔓 : Ideal (Localization.AtPrime (RingHom.ker e)), 𝔓.IsPrime → (∀ i, (b.coord (Sum.inl i)).compDer (KaehlerDifferential.D F'' (Localization.AtPrime (RingHom.ker e))) (algebraMap Γ(Xu.left, V) (Localization.AtPrime (RingHom.ker e)) (ρ φ)) ∈ 𝔓) → algebraMap Γ(Xu.left, V) (Localization.AtPrime (RingHom.ker e)) (ρ φ) ∈ 𝔓)) :=
by
