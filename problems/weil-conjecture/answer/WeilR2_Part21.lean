    (fun i => rfl) hHs hB'
  refine ⟨B'.map e, B' - (B'.map e).map (algebraMap K O), hc, ?_, hP, ?_⟩
  · intro p q
    rw [← hker, RingHom.mem_ker]
    simp [Matrix.sub_apply, heι]
  · have e1 : ∀ p q, algebraMap K O ((B'.map e) p q) + (B' - (B'.map e).map (algebraMap K O)) p q
