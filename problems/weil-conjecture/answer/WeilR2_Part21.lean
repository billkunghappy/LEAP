by
  classical
  have hstar : ∀ (S : Type u) [CommRing S] [Algebra K S] (n : ℕ) (α : Fin n → S) (k : ℕ)
      (P : MvPolynomial (Fin n) K),
      (∀ e : Fin n →₀ ℕ, Finsupp.degree e < k → P.coeff e = 0) →
      MvPolynomial.aeval α P ∈ Ideal.span (Set.range α) ^ k := by
    intro S _ _ n α
    classical
    have hmono : ∀ e : Fin n →₀ ℕ, (e.prod fun i k => α i ^ k) ∈
        Ideal.span (Set.range α) ^ (Finsupp.degree e) := by
      intro e
      rw [Finsupp.prod, Finsupp.degree_apply, ← Finset.prod_pow_eq_pow_sum]
      exact Ideal.prod_mem_prod (fun i _ => Ideal.pow_mem_pow (Ideal.subset_span (Set.mem_range_self i)) _)
    intro k P hP
    rw [MvPolynomial.as_sum P, map_sum]
    refine Ideal.sum_mem _ (fun e he => ?_)
    rw [MvPolynomial.aeval_monomial]
    have hk : k ≤ Finsupp.degree e := by
      by_contra h
      exact (MvPolynomial.mem_support_iff.1 he) (hP e (by omega))
    exact Ideal.mul_mem_left _ _ (Ideal.pow_le_pow_right hk (hmono e))
  have wc_plt_hlgc_powerseries_lift : ∀ (S : Type u) [CommRing S] [Algebra K S] (n : ℕ) (α : Fin n → S) (hcomp : IsAdicComplete (Ideal.span (Set.range α)) S), ∃ φ : MvPowerSeries (Fin n) K →+* S, ∀ (F : MvPowerSeries (Fin n) K) (k : ℕ), φ F - MvPolynomial.aeval α (MvPowerSeries.trunc' K (Finsupp.equivFunOnFinite.symm (fun _ : Fin n => k)) F) ∈ Ideal.span (Set.range α) ^ k := by
    intro S _ _ n α hcomp
    classical
    have star := hstar S n α
    set J := Ideal.span (Set.range α) with hJ
    have hbox : ∀ (k : ℕ) (e : Fin n →₀ ℕ), Finsupp.degree e < k →
        e ≤ Finsupp.equivFunOnFinite.symm (fun _ : Fin n => k) := by
      intro k e he i
      show e i ≤ k
      exact ((Finsupp.le_degree i e).trans_lt he).le
    let T : ℕ → MvPowerSeries (Fin n) K → MvPolynomial (Fin n) K := fun k =>
      MvPowerSeries.trunc' K (Finsupp.equivFunOnFinite.symm (fun _ : Fin n => k))
    have hTc : ∀ k (F : MvPowerSeries (Fin n) K) (e : Fin n →₀ ℕ), Finsupp.degree e < k →
        (T k F).coeff e = MvPowerSeries.coeff e F := by
      intro k F e he
      show (MvPowerSeries.trunc' K _ F).coeff e = _
      rw [MvPowerSeries.coeff_trunc', if_pos (hbox k e he)]
    let f : (k : ℕ) → MvPowerSeries (Fin n) K →+* S ⧸ J ^ k := fun k =>
      { toFun := fun F => Ideal.Quotient.mk (J ^ k) (MvPolynomial.aeval α (T k F))
        map_one' := by
          show Ideal.Quotient.mk (J ^ k) (MvPolynomial.aeval α (MvPowerSeries.trunc' K _ 1)) = 1
          rw [MvPowerSeries.trunc'_one, map_one, map_one]
        map_mul' := fun F G => by
          show Ideal.Quotient.mk (J ^ k) (MvPolynomial.aeval α (T k (F * G))) =
            Ideal.Quotient.mk (J ^ k) (MvPolynomial.aeval α (T k F)) *
              Ideal.Quotient.mk (J ^ k) (MvPolynomial.aeval α (T k G))
          rw [← map_mul, ← map_mul, Ideal.Quotient.eq, ← map_sub]
          apply star
          intro e he
          rw [MvPolynomial.coeff_sub, hTc k _ e he, MvPowerSeries.coeff_mul,
            MvPolynomial.coeff_mul, sub_eq_zero]
          refine Finset.sum_congr rfl (fun p hp => ?_)
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
          have h1 : Finsupp.degree p.1 < k := by
            have : Finsupp.degree p.1 ≤ Finsupp.degree e := by
              rw [← hp, map_add]; omega
            omega
          have h2 : Finsupp.degree p.2 < k := by
            have : Finsupp.degree p.2 ≤ Finsupp.degree e := by
              rw [← hp, map_add]; omega
            omega
          rw [hTc k F _ h1, hTc k G _ h2]
        map_zero' := by
          show Ideal.Quotient.mk (J ^ k) (MvPolynomial.aeval α (T k 0)) = 0
          simp only [T, map_zero]
        map_add' := fun F G => by
          show Ideal.Quotient.mk (J ^ k) (MvPolynomial.aeval α (T k (F + G))) =
            Ideal.Quotient.mk (J ^ k) (MvPolynomial.aeval α (T k F)) +
              Ideal.Quotient.mk (J ^ k) (MvPolynomial.aeval α (T k G))
          simp only [T, map_add] }
    have hf : ∀ {m k : ℕ} (hle : m ≤ k), (Ideal.Quotient.factorPow J hle).comp (f k) = f m := by
      intro m k hle
      ext F
      show Ideal.Quotient.factorPow J hle (Ideal.Quotient.mk (J ^ k) (MvPolynomial.aeval α (T k F)))
        = Ideal.Quotient.mk (J ^ m) (MvPolynomial.aeval α (T m F))
      rw [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk, Ideal.Quotient.eq, ← map_sub]
      apply star
      intro e he
      rw [MvPolynomial.coeff_sub, hTc k F e (by omega), hTc m F e he, sub_self]
