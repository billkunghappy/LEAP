    have hw : ∀ i : Fin n ⊕ Fin r, ((1 + Nall).mulVec (fun k => algebraMap R₀ S₀ (tall k))) (ε i) =
        Sum.elim ((1 + N).mulVec (fun k => algebraMap R₀ S₀ (t k)))
          (fun k => algebraMap R₀ S₀ (ζ k)) i := by
      intro i
      have h2 : ((1 + Nall).mulVec (fun k => algebraMap R₀ S₀ (tall k))) (ε i) =
          ((1 + Matrix.fromBlocks N 0 0 0).mulVec (Sum.elim (fun k => algebraMap R₀ S₀ (t k))
            (fun k => algebraMap R₀ S₀ (ζ k)))) i := by
