      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact Ideal.mem_comap.mpr (by rw [hτroot]; exact Ideal.mem_span_singleton_self _)
  have dev_iso_indEtale : ∀ {X Y : Type u} [CommRing X] [CommRing Y] (e : X ≃+* Y),
