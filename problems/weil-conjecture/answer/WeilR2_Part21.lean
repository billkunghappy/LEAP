    intro s y hy
    have e1 : (β.hom.hom.app (op ((Over.post bc).obj (Over.mk (𝟙 V))))).hom ((uF.app (op V)).hom s) =
        (uF'.app (op V)).hom ((α.hom.hom.app (op (Over.mk (𝟙 V)))).hom s) :=
      congrArg (fun f => (f.app (op (Over.mk (𝟙 V)))).hom s) hβ
    let ι : Over.mk (𝟙 (bc.obj V)) ⟶ (Over.post bc).obj (Over.mk (𝟙 V)) :=
