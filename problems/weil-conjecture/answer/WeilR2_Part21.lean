    let I := InjectiveResolution.of
      (SheafOfModules.unit
        (wcEtZModRing (Limits.pullback (Limits.pullback.snd h (e'.inv ≫ Vξ.hom)) ξ) (ℓ ^ k)))
    have hker : ∀ r : ℕ, Subsingleton (@Abelian.Ext
        (SheafOfModules.{u+1} (wcEtZModRing (Limits.pullback h (e'.inv ≫ Vξ.hom)) (ℓ ^ k))) _ _
        (HasExt.standard _)
        (SheafOfModules.unit (wcEtZModRing (Limits.pullback h (e'.inv ≫ Vξ.hom)) (ℓ ^ k)))
