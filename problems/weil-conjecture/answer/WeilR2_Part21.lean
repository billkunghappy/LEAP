      rw [IsLocalization.mk'_eq_mul_mk'_one]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ h))
    rw [← IsLocalization.mk'_mul, IsLocalization.mk'_mem_map_algebraMap_iff] at hab
    obtain ⟨t, ht, htm⟩ := hab
    exact hP2 i j r r' hr hr' (hsat t ((Ideal.mem_primeCompl_iff).1 ht) _ _ htm)
  have hnzd := wc_plt_hlgc_completion_domain_criterion
    (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)
    (IsLocalRing.maximalIdeal (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
    (fun N => (I N).map (algebraMap R
      (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))) W hW q1 q2 q3
  exact main _ s7 hnzd

theorem wc_plt_hl_completion_radical (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (J : Ideal A) (hJ : J.radical ≠ IsLocalRing.maximalIdeal A) :
    (J.map (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))).radical ≠
      IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
by
  intro H
  set m := IsLocalRing.maximalIdeal A with hm
  set B := AdicCompletion m A with hB
  set φ := algebraMap A B with hφ
  by_cases hJt : J = ⊤
  · rw [hJt, Ideal.map_top, Ideal.radical_top] at H
    exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top H.symm
  have s2 : Ideal.map φ m ≤ (J.map φ).radical := by
    rw [H, Ideal.map_le_iff_le_comap]
    intro a ha
    exact map_nonunit φ a ha
  have hmfg : m.FG := IsNoetherian.noetherian m
  obtain ⟨n, hn⟩ := Ideal.exists_pow_le_of_le_radical_of_fg s2 (hmfg.map φ)
  rw [← Ideal.map_pow] at hn
  set π : B →+* A ⧸ m ^ (n + 1) := (AdicCompletion.evalₐ m (n + 1)).toRingHom with hπ
  have hcomp : π.comp φ = Ideal.Quotient.mk (m ^ (n + 1)) := by
    ext a
    simp [hπ, hφ, AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of]
  have s4 := Ideal.map_mono (f := π) hn
  rw [Ideal.map_map, Ideal.map_map, hcomp] at s4
  have s5 : m ^ n ≤ J ⊔ m • m ^ n := by
    intro x hx
    have h1 : Ideal.Quotient.mk (m ^ (n + 1)) x ∈ Ideal.map (Ideal.Quotient.mk (m ^ (n + 1))) J :=
      s4 (Ideal.mem_map_of_mem _ hx)
    rw [Ideal.mem_quotient_iff_mem_sup] at h1
    rwa [Ideal.smul_eq_mul, ← pow_succ']
  have s6 : m ^ n ≤ J :=
    Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian (m ^ n))
      (IsLocalRing.maximalIdeal_le_jacobson ⊥) s5
  apply hJ
  apply le_antisymm
  · exact (Ideal.IsPrime.radical_le_iff (IsLocalRing.maximalIdeal.isMaximal A).isPrime).mpr
      (IsLocalRing.le_maximalIdeal hJt)
  · intro x hx
    exact ⟨n, s6 (Ideal.pow_mem_pow hx n)⟩

theorem wc_plt_hl_completion_transfer (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (J : Ideal A) (i : ℕ)
    (h : Limits.IsZero ((localCohomology
      (J.map (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) i).obj
      (ModuleCat.of (AdicCompletion (IsLocalRing.maximalIdeal A) A)
        (AdicCompletion (IsLocalRing.maximalIdeal A) A)))) :
    Limits.IsZero ((localCohomology J i).obj (ModuleCat.of A A)) :=
by
  classical
  have s1 : ∀ (A : Type u)
      [CommRing A]
      (J : Ideal A)
      (M : ModuleCat.{u} A)
      (i : ℕ),
      Limits.IsZero ((localCohomology J i).obj M) ↔
    ∀ (t : ℕ) (y : Abelian.Ext (ModuleCat.of A (A ⧸ J ^ t)) M i), ∃ (t' : ℕ) (ht : t ≤ t'),
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t)))).comp y (zero_add i) = 0 := by
    intro A _ J M i

    rw [wc_plt_lc_mv_vanishing_iff A J M i]
    obtain ⟨e, he⟩ := wc_plt_lc_mv_ext_comparison A M i
    constructor
    · intro H t y
      obtain ⟨t', ht, h0⟩ := H t ((e _).symm y)
      refine ⟨t', ht, ?_⟩
      have := he _ _ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t))) ((e _).symm y)
      rw [h0, map_zero, AddEquiv.apply_symm_apply] at this
      exact this.symm
    · intro H t y
      obtain ⟨t', ht, h0⟩ := H t (e _ y)
      refine ⟨t', ht, ?_⟩
      have := he _ _ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t))) y
      rw [h0] at this
      exact (AddEquiv.map_eq_zero_iff _).mp this
  have s2 : ∀ (A : Type u)
      [CommRing A]
      [IsNoetherianRing A]
      [IsLocalRing A],
      (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)).FaithfullyFlat := by
    intro A _ _ _

    rw [RingHom.faithfullyFlat_algebraMap_iff, Module.FaithfullyFlat.iff_flat_and_proper_ideal]
    refine ⟨AdicCompletion.flat_of_isNoetherian _, ?_⟩
    intro I hI htop
    have hIm : I ≤ IsLocalRing.maximalIdeal A := IsLocalRing.le_maximalIdeal hI
    set ε := AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1
    have key : ∀ z ∈ I • (⊤ : Submodule A (AdicCompletion (IsLocalRing.maximalIdeal A) A)),
        ε z = 0 := by
      intro z hz
      refine Submodule.smul_induction_on hz ?_ ?_
      · intro r hr n _
        rw [AlgHom.map_smul_of_tower, Algebra.smul_def]
        have : algebraMap A (A ⧸ IsLocalRing.maximalIdeal A ^ 1) r = 0 := by
          rw [Ideal.Quotient.algebraMap_eq, Ideal.Quotient.eq_zero_iff_mem, pow_one]
          exact hIm hr
        rw [this, zero_mul]
      · intro x y hx hy
        rw [map_add, hx, hy, add_zero]
    have h1 := key 1 (by rw [htop]; exact Submodule.mem_top)
    rw [map_one] at h1
    haveI : Nontrivial (A ⧸ IsLocalRing.maximalIdeal A ^ 1) := by
      rw [Ideal.Quotient.nontrivial_iff, pow_one]
      exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top
    exact one_ne_zero h1
  have s3 : ∀ (A B : Type u)
      [CommRing A]
      [CommRing B]
      (f : A →+* B)
      (hf : f.FaithfullyFlat)
      (M N : ModuleCat.{u} A)
      (g : M ⟶ N)
      (hg : (ModuleCat.extendScalars.{u} f).map g = 0),
      g = 0 := by
    intro A B _ _ f hf M N g hg

    letI := f.toAlgebra
    haveI : Module.FaithfullyFlat A B := hf
    ext m
    have h1 : ((ModuleCat.extendScalars.{u} f).map g).hom ((1 : B) ⊗ₜ[A] m) = 0 := by
      rw [hg]; rfl
    have h2 := ModuleCat.ExtendScalars.map_tmul f g (1 : B) m
    have h3 : ((1 : B) ⊗ₜ[A] (g.hom m) : TensorProduct A B N) = 0 := h2.symm.trans h1
    rw [(Module.FaithfullyFlat.one_tmul_eq_zero_iff A N (A := B) (g.hom m)).mp h3]
    rfl
  have s4 : ∀ (A B : Type u)
      [CommRing A]
      [CommRing B]
      (f : A →+* B)
      (hf : f.FaithfullyFlat)
      (U V : ModuleCat.{u} A)
      (T : U ⟶ V)
      (x : V)
      (w : (ModuleCat.extendScalars.{u} f).obj U)
      (hw : ((ModuleCat.extendScalars.{u} f).map T).hom w =
      ((ModuleCat.extendRestrictScalarsAdj.{u} f).unit.app V).hom x),
      ∃ u0 : U, T.hom u0 = x := by
    intro A B _ _ f hf U V T x w hw

    letI := f.toAlgebra
    haveI : Module.FaithfullyFlat A B := hf
    let g : V ⟶ ModuleCat.of A (V ⧸ LinearMap.range T.hom) :=
      ModuleCat.ofHom (LinearMap.range T.hom).mkQ
    have hTg : T ≫ g = 0 := by
      ext u0
      simp [g]
    have h0 : (ModuleCat.extendScalars f).map T ≫ (ModuleCat.extendScalars f).map g = 0 := by
      rw [← Functor.map_comp, hTg, Functor.map_zero]
    have h1 : ((ModuleCat.extendScalars f).map g).hom
        (((ModuleCat.extendScalars f).map T).hom w) = 0 := by
      have := congrArg (fun φ => φ.hom w) h0
      exact this
    rw [hw] at h1
    have h2 := ModuleCat.extendRestrictScalarsAdj_unit_app_apply f V x
    have h3 := ModuleCat.ExtendScalars.map_tmul f g (1 : B) x
    have h4 : ((1 : B) ⊗ₜ[A] (g.hom x) : TensorProduct A B _) = 0 := by
      refine h3.symm.trans ?_
      refine Eq.trans ?_ h1
      exact congrArg _ h2.symm
    have h5 := (Module.FaithfullyFlat.one_tmul_eq_zero_iff A _ (A := B) (g.hom x)).mp h4
    have h6 : x ∈ LinearMap.range T.hom := (Submodule.Quotient.mk_eq_zero _).mp h5
    obtain ⟨u0, hu⟩ := h6
    exact ⟨u0, hu⟩
  have s5 : ∀ (A B : Type u)
      [CommRing A]
      [CommRing B]
      (f : A →+* B)
      (hD : ∀ (U V : ModuleCat.{u} A) (T : U ⟶ V) (x : V) (w : (ModuleCat.extendScalars.{u} f).obj U),
      ((ModuleCat.extendScalars.{u} f).map T).hom w =
        ((ModuleCat.extendRestrictScalarsAdj.{u} f).unit.app V).hom x → ∃ u0 : U, T.hom u0 = x)
      (K N : ModuleCat.{u} A)
      [Module.Finite A K]
      (m : ℕ)
      (ι : K ⟶ ModuleCat.of A (Fin m → A))
      (z : K ⟶ N)
      (w : (ModuleCat.extendScalars.{u} f).obj (ModuleCat.of A (Fin m → A)) ⟶
      (ModuleCat.extendScalars.{u} f).obj N)
      (hw : (ModuleCat.extendScalars.{u} f).map ι ≫ w = (ModuleCat.extendScalars.{u} f).map z),
      ∃ v : ModuleCat.of A (Fin m → A) ⟶ N, ι ≫ v = z := by
    intro A B _ _ f hD K N _ m ι z w hw

    classical
    let F := ModuleCat.extendScalars.{u} f
    let t : ∀ P : ModuleCat.{u} A, P → F.obj P := fun P p => (1 : B) ⊗ₜ[A] p
    have ht_map : ∀ (P Q : ModuleCat.{u} A) (g : P ⟶ Q) (p : P),
        (F.map g).hom (t P p) = t Q (g.hom p) := fun P Q g p =>
      ModuleCat.ExtendScalars.map_tmul f g 1 p
    have ht_smul : ∀ (P : ModuleCat.{u} A) (c : A) (p : P), f c • t P p = t P (c • p) := by
      intro P c p
      have e1 : f c • t P p = ((c • (show ((ModuleCat.restrictScalars f).obj (ModuleCat.of B B)) from (1 : B)))
          ⊗ₜ[A] p : TensorProduct A ((ModuleCat.restrictScalars f).obj (ModuleCat.of B B)) P) := rfl
      rw [e1, TensorProduct.smul_tmul]
    have ht_sum : ∀ (P : ModuleCat.{u} A) {ι' : Type} (s : Finset ι') (p : ι' → P),
        t P (∑ a ∈ s, p a) = ∑ a ∈ s, t P (p a) := fun P _ s p =>
      TensorProduct.tmul_sum _ s p
    have ht_unit : ∀ (P : ModuleCat.{u} A) (p : P),
        ((ModuleCat.extendRestrictScalarsAdj.{u} f).unit.app P).hom p = t P p := fun P p =>
      ModuleCat.extendRestrictScalarsAdj_unit_app_apply f P p
    obtain ⟨r, k, hk⟩ := Module.Finite.exists_fin (R := A) (M := K)
    let a : Fin r → Fin m → A := fun i j => ι.hom (k i) j
    let U := ModuleCat.of A (Fin m → N)
    let V := ModuleCat.of A (Fin r → N)
    let T : U ⟶ V := ModuleCat.ofHom
      { toFun := fun n i => ∑ j, a i j • n j
        map_add' := fun n n' => by
          funext i
          simp only [Pi.add_apply, smul_add, Finset.sum_add_distrib]
        map_smul' := fun c n => by
          funext i
          simp only [Pi.smul_apply, RingHom.id_apply, Finset.smul_sum, smul_smul, mul_comm] }
    have hT : ∀ (n : U) (i : Fin r), T.hom n i = ∑ j, a i j • n j := fun n i => rfl
    let x : V := fun i => z.hom (k i)
    let σ : Fin r → (N ⟶ V) := fun i => ModuleCat.ofHom (LinearMap.single A (fun _ => N) i)
    let σ' : Fin m → (N ⟶ U) := fun j => ModuleCat.ofHom (LinearMap.single A (fun _ => N) j)
    let e : Fin m → (Fin m → A) := fun j => Pi.single j 1
    let ω : F.obj U := ∑ j, (F.map (σ' j)).hom (w.hom (t _ (e j)))
    have hmap : ∀ j, F.map (σ' j ≫ T) = ∑ i, f (a i j) • F.map (σ i) := by
      intro j
      apply ModuleCat.ExtendScalars.hom_ext
      intro n
      refine (ht_map _ _ _ n).trans ?_
      have h1 : (σ' j ≫ T).hom n = ∑ i, a i j • (σ i).hom n := by
        funext l
        simp only [ModuleCat.hom_comp, LinearMap.comp_apply, hT, σ', σ, ModuleCat.hom_ofHom]
        change (∑ j_1, a l j_1 • (Pi.single j n : Fin m → N) j_1) =
          (∑ i, a i j • (Pi.single i n : Fin r → N)) l
        rw [Finset.sum_apply]
        simp [Pi.single_apply]
      change t V ((σ' j ≫ T).hom n) = (∑ i, f (a i j) • F.map (σ i)).hom (t N n)
      rw [h1, ht_sum, ModuleCat.hom_sum, LinearMap.sum_apply]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [ModuleCat.hom_smul, LinearMap.smul_apply, ht_map, ht_smul]
    have hwj : ∀ i, ∑ j, f (a i j) • w.hom (t _ (e j)) = t N (z.hom (k i)) := by
      intro i
      have h2 : ∑ j, a i j • e j = ι.hom (k i) := by
        funext l
        simp only [e, a, Finset.sum_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul, mul_ite,
          mul_one, mul_zero, Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, if_true]
      have h3 : (F.map ι ≫ w).hom (t K (k i)) = (F.map z).hom (t K (k i)) := by rw [hw]
      rw [ModuleCat.hom_comp, LinearMap.comp_apply, ht_map, ht_map] at h3
      rw [← h3, ← h2]
      erw [ht_sum]
      rw [map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [← map_smul]
      exact congrArg w.hom (ht_smul (ModuleCat.of A (Fin m → A)) (a i j) (e j))
    have hω : (F.map T).hom ω = ((ModuleCat.extendRestrictScalarsAdj.{u} f).unit.app V).hom x := by
      rw [ht_unit]
      have h4 : x = ∑ i, (σ i).hom (z.hom (k i)) := by
        funext l
        simp only [x, σ, ModuleCat.hom_ofHom]
        change z.hom (k l) = (∑ i, (Pi.single i (z.hom (k i)) : Fin r → N)) l
        rw [Finset.sum_apply]
        simp [Pi.single_apply]
      rw [h4, ht_sum]
      simp only [ω, map_sum]
      have h5 : ∀ j, (F.map T).hom ((F.map (σ' j)).hom (w.hom (t _ (e j)))) =
          ∑ i, (F.map (σ i)).hom (f (a i j) • w.hom (t _ (e j))) := by
        intro j
        rw [← LinearMap.comp_apply, ← ModuleCat.hom_comp, ← Functor.map_comp, hmap j,
          ModuleCat.hom_sum, LinearMap.sum_apply]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [ModuleCat.hom_smul, LinearMap.smul_apply, map_smul]
      simp only [h5]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [← map_sum, hwj, ht_map]
    obtain ⟨n, hn⟩ := hD U V T x ω hω
    refine ⟨ModuleCat.ofHom (Fintype.linearCombination A n), ?_⟩
    apply ModuleCat.hom_ext
    apply LinearMap.ext_on_range hk
    intro i
    rw [ModuleCat.hom_comp, LinearMap.comp_apply, ModuleCat.hom_ofHom,
      Fintype.linearCombination_apply]
    have := congrFun hn i
    rw [hT] at this
    exact this
  have s6 : ∀ (A B : Type u)
      [CommRing A]
      [IsNoetherianRing A]
      [CommRing B]
      (f : A →+* B)
      [(ModuleCat.extendScalars.{u} f).Additive]
      [Limits.PreservesFiniteLimits (ModuleCat.extendScalars.{u} f)]
      (h0 : ∀ (M N : ModuleCat.{u} A) (g : M ⟶ N), (ModuleCat.extendScalars.{u} f).map g = 0 → g = 0)
      (h1 : ∀ (K N : ModuleCat.{u} A) [Module.Finite A K] (m : ℕ)
      (ι : K ⟶ ModuleCat.of A (Fin m → A)) (z : K ⟶ N)
      (w : (ModuleCat.extendScalars.{u} f).obj (ModuleCat.of A (Fin m → A)) ⟶
        (ModuleCat.extendScalars.{u} f).obj N),
      (ModuleCat.extendScalars.{u} f).map ι ≫ w = (ModuleCat.extendScalars.{u} f).map z →
      ∃ v : ModuleCat.of A (Fin m → A) ⟶ N, ι ≫ v = z)
      (N : ModuleCat.{u} A)
      (n : ℕ),
      ∀ (M : ModuleCat.{u} A) [Module.Finite A M] (y : Abelian.Ext M N n),
    Abelian.Ext.mapExactFunctor (ModuleCat.extendScalars.{u} f) y = 0 → y = 0 := by
    intro A B _ _ _ f _ _ h0 h1 N n

    induction n with
    | zero =>
      intro M _ y hy
      obtain ⟨g, rfl⟩ : ∃ g, Abelian.Ext.mk₀ g = y := ⟨_, Abelian.Ext.mk₀_addEquiv₀_apply y⟩
      rw [Abelian.Ext.mapExactFunctor_mk₀] at hy
      have : (ModuleCat.extendScalars.{u} f).map g = 0 := by
        apply (Abelian.Ext.mk₀_bijective _ _).1
        rw [hy, Abelian.Ext.mk₀_zero]
      rw [h0 _ _ _ this, Abelian.Ext.mk₀_zero]
    | succ k ih =>
      intro M _ y hy
      obtain ⟨m, π, hπ⟩ := Module.Finite.exists_fin' A M
      haveI hK : Module.Finite A (LinearMap.ker π) := inferInstance
      let S : ShortComplex (ModuleCat.{u} A) :=
        ShortComplex.mk (X₃ := M) (ModuleCat.ofHom (LinearMap.ker π).subtype) (ModuleCat.ofHom π)
          (by ext x; exact x.2)
      have hS : S.ShortExact := by
        refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
        · rw [ShortComplex.moduleCat_exact_iff]
          intro x hx
          exact ⟨⟨x, hx⟩, rfl⟩
        · rw [ModuleCat.mono_iff_injective]; exact Subtype.val_injective
        · rw [ModuleCat.epi_iff_surjective]; exact hπ
      haveI hP : Projective S.X₂ := ModuleCat.projective_of_free (Pi.basisFun A (Fin m))
      haveI hFP : Projective ((ModuleCat.extendScalars.{u} f).obj S.X₂) :=
        (ModuleCat.extendRestrictScalarsAdj f).map_projective _ hP
      haveI hFP' : Projective (S.map (ModuleCat.extendScalars.{u} f)).X₂ := hFP
      have hSF := hS.map_of_exact (ModuleCat.extendScalars.{u} f)
      have hy0 : (Abelian.Ext.mk₀ S.g).comp y (zero_add (k + 1)) = 0 :=
        Abelian.Ext.eq_zero_of_projective _
      obtain ⟨x, hx⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS N y hy0 (add_comm 1 k)
      have hFx : hSF.extClass.comp
          (Abelian.Ext.mapExactFunctor (ModuleCat.extendScalars.{u} f) x) (add_comm 1 k) = 0 := by
        rw [← hx, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass] at hy
        exact hy
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hSF _ _ (add_comm 1 k) hFx
      cases k with
      | zero =>
        obtain ⟨z, rfl⟩ : ∃ z, Abelian.Ext.mk₀ z = x := ⟨_, Abelian.Ext.mk₀_addEquiv₀_apply x⟩
        obtain ⟨w, rfl⟩ : ∃ w, Abelian.Ext.mk₀ w = x₂ := ⟨_, Abelian.Ext.mk₀_addEquiv₀_apply x₂⟩
        have hw : (ModuleCat.extendScalars.{u} f).map S.f ≫ w =
            (ModuleCat.extendScalars.{u} f).map z := by
          apply (Abelian.Ext.mk₀_bijective _ _).1
          rw [← Abelian.Ext.mk₀_comp_mk₀]
          have hx₂' := hx₂
          rw [Abelian.Ext.mapExactFunctor_mk₀] at hx₂'
          exact hx₂'
        obtain ⟨v, hv⟩ := h1 (ModuleCat.of A (LinearMap.ker π)) N m S.f z w hw
        rw [← hx, ← hv, ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero,
          hS.extClass_comp, Abelian.Ext.zero_comp]
      | succ j =>
        have hx₂0 : x₂ = 0 := Abelian.Ext.eq_zero_of_projective x₂
        rw [hx₂0, Abelian.Ext.comp_zero] at hx₂
        have := ih (ModuleCat.of A (LinearMap.ker π)) x hx₂.symm
        rw [← hx, this, Abelian.Ext.comp_zero]
  have s7 : ∀ (A B : Type u)
      [CommRing A]
      [CommRing B]
      (f : A →+* B)
      (J : Ideal A),
      ∃ (e : (t : ℕ) → (ModuleCat.of B (B ⧸ (J.map f) ^ t) ≅
      (ModuleCat.extendScalars.{u} f).obj (ModuleCat.of A (A ⧸ J ^ t)))),
    (∀ (t t' : ℕ) (ht : t ≤ t'),
      (e t').hom ≫ (ModuleCat.extendScalars.{u} f).map
        (ModuleCat.ofHom (Submodule.factor (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t))) =
      ModuleCat.ofHom (Submodule.factor (Ideal.pow_le_pow_right ht : (J.map f) ^ t' ≤ (J.map f) ^ t)) ≫
        (e t).hom) ∧
    Nonempty ((ModuleCat.extendScalars.{u} f).obj (ModuleCat.of A A) ≅ ModuleCat.of B B) := by
    intro A B _ _ f J

    letI := f.toAlgebra
    have hmap : ∀ t : ℕ, (J.map f) ^ t = (J ^ t).map (algebraMap A B) :=
      fun t => (Ideal.map_pow f J t).symm
    let E : (t : ℕ) → (B ⧸ (J.map f) ^ t) ≃ₗ[B] TensorProduct A B (A ⧸ J ^ t) := fun t =>
      (Submodule.quotEquivOfEq _ _ (hmap t)).trans
        (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B (J ^ t)).toLinearEquiv
    have hE : ∀ (t : ℕ) (b : B), E t (Submodule.Quotient.mk b) = b ⊗ₜ[A] (1 : A ⧸ J ^ t) := by
      intro t b
      exact Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk B (J ^ t) b
    refine ⟨fun t => (E t).toModuleIso, ?_, ⟨(TensorProduct.AlgebraTensorModule.rid A B B).toModuleIso⟩⟩
    intro t t' ht
    apply ModuleCat.hom_ext
    apply Submodule.linearMap_qext
    apply LinearMap.ext
    intro b
    have h1 := ModuleCat.ExtendScalars.map_tmul f
      (ModuleCat.ofHom (Submodule.factor (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t))) b 1
    have h2 := hE t' b
    have h3 := hE t b
    have e1 : (Submodule.factor (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t)) (1 : A ⧸ J ^ t') = 1 :=
      Submodule.factor_mk _ (1 : A)
    have e2 : (Submodule.factor (Ideal.pow_le_pow_right ht : (J.map f) ^ t' ≤ (J.map f) ^ t))
        (Submodule.Quotient.mk b) = Submodule.Quotient.mk b := Submodule.factor_mk _ b
    change ((ModuleCat.extendScalars f).map (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t)))).hom (E t' (Submodule.Quotient.mk b)) =
      E t (Submodule.factor (Ideal.pow_le_pow_right ht : (J.map f) ^ t' ≤ (J.map f) ^ t)
        (Submodule.Quotient.mk b))
    rw [e2, h2, h3]
    refine h1.trans ?_
    have e3 : (ModuleCat.ofHom (Submodule.factor (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t))).hom
        (1 : A ⧸ J ^ t') = 1 := e1
    exact congrArg _ e3
  have s8 : ∀ (A B : Type u)
      [CommRing A]
      [CommRing B]
      (f : A →+* B)
      [(ModuleCat.extendScalars.{u} f).Additive]
      [Limits.PreservesFiniteLimits (ModuleCat.extendScalars.{u} f)]
      (J : Ideal A)
      (i : ℕ)
      (hinj : ∀ (t : ℕ) (y : Abelian.Ext (ModuleCat.of A (A ⧸ J ^ t)) (ModuleCat.of A A) i),
      Abelian.Ext.mapExactFunctor (ModuleCat.extendScalars.{u} f) y = 0 → y = 0)
      (e : (t : ℕ) → (ModuleCat.of B (B ⧸ (J.map f) ^ t) ≅
      (ModuleCat.extendScalars.{u} f).obj (ModuleCat.of A (A ⧸ J ^ t))))
      (he : ∀ (t t' : ℕ) (ht : t ≤ t'),
      (e t').hom ≫ (ModuleCat.extendScalars.{u} f).map
        (ModuleCat.ofHom (Submodule.factor (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t))) =
      ModuleCat.ofHom (Submodule.factor (Ideal.pow_le_pow_right ht : (J.map f) ^ t' ≤ (J.map f) ^ t)) ≫
        (e t).hom)
      (e₀ : (ModuleCat.extendScalars.{u} f).obj (ModuleCat.of A A) ≅ ModuleCat.of B B)
      (hB : ∀ (t : ℕ) (y : Abelian.Ext (ModuleCat.of B (B ⧸ (J.map f) ^ t)) (ModuleCat.of B B) i),
      ∃ (t' : ℕ) (ht : t ≤ t'), (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : (J.map f) ^ t' ≤ (J.map f) ^ t)))).comp y (zero_add i) = 0),
      ∀ (t : ℕ) (y : Abelian.Ext (ModuleCat.of A (A ⧸ J ^ t)) (ModuleCat.of A A) i),
      ∃ (t' : ℕ) (ht : t ≤ t'), (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t)))).comp y (zero_add i) = 0 := by
    intro A B _ _ f _ _ J i hinj e he e₀ hB

    intro t y
    obtain ⟨t', ht, hk⟩ := hB t ((Abelian.Ext.mk₀ (e t).hom).comp
      ((Abelian.Ext.mapExactFunctor (ModuleCat.extendScalars.{u} f) y).comp
        (Abelian.Ext.mk₀ e₀.hom) (add_zero i)) (zero_add i))
    refine ⟨t', ht, hinj t' _ ?_⟩
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← he t t' ht, ← Abelian.Ext.mk₀_comp_mk₀_assoc,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero] at hk
    have k2 := congrArg (fun W => (Abelian.Ext.mk₀ (e t').inv).comp W (zero_add i)) hk
    simp only [Abelian.Ext.comp_zero] at k2
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp] at k2
    have k3 := congrArg (fun W => W.comp (Abelian.Ext.mk₀ e₀.inv) (add_zero i)) k2
    simp only [Abelian.Ext.zero_comp] at k3
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
      Abelian.Ext.comp_mk₀_id] at k3
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    exact k3

  have hff := s2 A
  letI : (ModuleCat.extendScalars.{u} (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))).Additive :=
    (ModuleCat.extendRestrictScalarsAdj (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))).left_adjoint_additive
  haveI := ModuleCat.preservesFiniteLimits_extendScalars_of_flat hff.flat
  have hinj : ∀ (t : ℕ) (y : Abelian.Ext (ModuleCat.of A (A ⧸ J ^ t)) (ModuleCat.of A A) i),
      Abelian.Ext.mapExactFunctor (ModuleCat.extendScalars.{u}
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) y = 0 → y = 0 :=
    fun t y => s6 A _ _ (s3 A _ _ hff) (s5 A _ _ (s4 A _ _ hff)) (ModuleCat.of A A) i
      (ModuleCat.of A (A ⧸ J ^ t)) y
  obtain ⟨e, he, ⟨e₀⟩⟩ := s7 A (AdicCompletion (IsLocalRing.maximalIdeal A) A)
    (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) J
  have hB := (s1 _ _ _ i).mp h
  rw [s1 A J (ModuleCat.of A A) i]
  exact s8 A _ _ J i hinj e he e₀ hB

theorem wc_plt_hl_enlarge (B : Type u) [CommRing B] [IsNoetherianRing B] [IsLocalRing B] (d : ℕ)
    (hd : ringKrullDim B = d) (J J' : Ideal B) (hJJ' : J ≤ J')
    (hJ' : J' ≤ IsLocalRing.maximalIdeal B)
    (h : Limits.IsZero ((localCohomology J' d).obj (ModuleCat.of B B))) :
    Limits.IsZero ((localCohomology J d).obj (ModuleCat.of B B)) :=
by
  classical

  have rho_comp : ∀ {k : ℕ} {p q s : Ideal B} (h1 : p ≤ q) (h2 : q ≤ s)
      (y : Abelian.Ext (ModuleCat.of B (B ⧸ s)) (ModuleCat.of B B) k),
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor h1))).comp
        ((Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor h2))).comp y (zero_add k))
        (zero_add k) =
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor (h1.trans h2)))).comp y
        (zero_add k) := by
    intro k p q s h1 h2 y
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← ModuleCat.ofHom_comp, Submodule.factor_comp]
  have hJt : ∀ (I : Ideal B) (t : ℕ), I ≤ (I ^ t).radical := by
    intro I t
    rcases Nat.eq_zero_or_pos t with h0 | h0
    · subst h0; rw [pow_zero, Ideal.one_eq_top, Ideal.radical_top]; exact le_top
    · rw [Ideal.radical_pow _ (by omega)]; exact Ideal.le_radical

  have c1 : ∀ (I : Ideal B), Limits.IsZero ((localCohomology I d).obj (ModuleCat.of B B)) ↔
      ∀ (𝔠 : Ideal B), I ≤ 𝔠.radical →
        ∀ (y : Abelian.Ext (ModuleCat.of B (B ⧸ 𝔠)) (ModuleCat.of B B) d),
          ∃ (𝔠' : Ideal B) (h : 𝔠' ≤ 𝔠), I ≤ 𝔠'.radical ∧
            (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor h))).comp y (zero_add d) = 0 := by
    intro I
    have hI : I.FG := IsNoetherian.noetherian I
    rw [wc_plt_lc_mv_vanishing_iff B I (ModuleCat.of B B) d]
    obtain ⟨e, he⟩ := wc_plt_lc_mv_ext_comparison B (ModuleCat.of B B) d
    constructor
    · intro H 𝔠 h𝔠 y
      obtain ⟨t, ht⟩ := Ideal.exists_pow_le_of_le_radical_of_fg h𝔠 hI
      obtain ⟨t', htt', h0⟩ := H t ((e _).symm
        ((Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor ht))).comp y (zero_add d)))
      have h1 := he (ModuleCat.of B (B ⧸ I ^ t')) (ModuleCat.of B (B ⧸ I ^ t))
        (ModuleCat.ofHom (Submodule.factor (Ideal.pow_le_pow_right htt'))) ((e _).symm
          ((Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor ht))).comp y (zero_add d)))
      rw [h0, map_zero, AddEquiv.apply_symm_apply, rho_comp] at h1
      exact ⟨I ^ t', (Ideal.pow_le_pow_right htt').trans ht, hJt I t', h1.symm⟩
    · intro H t y₀
      obtain ⟨𝔠', h𝔠', h𝔠'r, hy⟩ := H (I ^ t) (hJt I t) (e _ y₀)
      obtain ⟨m, hm⟩ := Ideal.exists_pow_le_of_le_radical_of_fg h𝔠'r hI
      have hle : I ^ max m t ≤ 𝔠' := (Ideal.pow_le_pow_right (le_max_left m t)).trans hm
      refine ⟨max m t, le_max_right m t, ?_⟩
      have h1 := he (ModuleCat.of B (B ⧸ I ^ max m t)) (ModuleCat.of B (B ⧸ I ^ t))
        (ModuleCat.ofHom (Submodule.factor (Ideal.pow_le_pow_right (le_max_right m t)))) y₀
      have h2 := rho_comp hle h𝔠' (e _ y₀)
      rw [hy, Abelian.Ext.comp_zero] at h2
      exact (e _).map_eq_zero_iff.mp (h1.trans h2.symm)

  let S : Ideal B → B → ShortComplex (ModuleCat.{u} B) := fun d c =>
    { X₁ := ModuleCat.of B (B ⧸ Submodule.comap (LinearMap.mulLeft B c) d)
      X₂ := ModuleCat.of B (B ⧸ d)
      X₃ := ModuleCat.of B (B ⧸ (d ⊔ Ideal.span {c}))
      f := ModuleCat.ofHom (Submodule.mapQ (Submodule.comap (LinearMap.mulLeft B c) d) d
        (LinearMap.mulLeft B c) le_rfl)
      g := ModuleCat.ofHom (Submodule.factor (le_sup_left : d ≤ d ⊔ Ideal.span {c}))
      zero := by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro a
        obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ a
        change (Submodule.Quotient.mk (c * a) : B ⧸ (d ⊔ Ideal.span {c})) = 0
        rw [Submodule.Quotient.mk_eq_zero]
        exact Ideal.mem_sup_right (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self c)) }
  have hSE : ∀ (d : Ideal B) (c : B), (S d c).ShortExact := by
    intro d c
    refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
    · rw [ShortComplex.moduleCat_exact_iff]
      intro w hw
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ w
      change (Submodule.Quotient.mk z : B ⧸ (d ⊔ Ideal.span {c})) = 0 at hw
      rw [Submodule.Quotient.mk_eq_zero] at hw
      obtain ⟨β, hβ, γ, hγ, rfl⟩ := Submodule.mem_sup.mp hw
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hγ
      refine ⟨Submodule.Quotient.mk a, ?_⟩
      change (Submodule.Quotient.mk (c * a) : B ⧸ d) = Submodule.Quotient.mk (β + a * c)
      rw [Submodule.Quotient.eq]
      have : c * a - (β + a * c) = -β := by ring
      rw [this]
      exact d.neg_mem hβ
    · rw [ModuleCat.mono_iff_injective]
      intro u v huv
      obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ u
      obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ v
      change (Submodule.Quotient.mk (c * a) : B ⧸ d) = Submodule.Quotient.mk (c * b) at huv
      rw [Submodule.Quotient.eq] at huv
      change (Submodule.Quotient.mk a : B ⧸ Submodule.comap (LinearMap.mulLeft B c) d) =
        Submodule.Quotient.mk b
      rw [Submodule.Quotient.eq, Submodule.mem_comap, LinearMap.mulLeft_apply, mul_sub]
      exact huv
    · rw [ModuleCat.epi_iff_surjective]
      intro w
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ w
      exact ⟨Submodule.Quotient.mk z, rfl⟩

  have hstab : ∀ (I : Ideal B) (z : B), ∃ N : ℕ, ∀ m : ℕ, N ≤ m → ∀ a : B,
      z ^ m * a ∈ I → z ^ N * a ∈ I := by
    intro I z
    let C : ℕ →o Ideal B := ⟨fun m => Submodule.comap (LinearMap.mulLeft B (z ^ m)) I, by
      intro m m' hmm' a ha
      simp only [Submodule.mem_comap, LinearMap.mulLeft_apply] at ha ⊢
      obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hmm'
      rw [pow_add, mul_comm (z ^ m), mul_assoc]
      exact I.mul_mem_left _ ha⟩
    obtain ⟨N, hN⟩ := WellFoundedGT.monotone_chain_condition C
    refine ⟨N, fun m hm a ha => ?_⟩
    have h1 : a ∈ C m := by
      show a ∈ Submodule.comap (LinearMap.mulLeft B (z ^ m)) I
      rw [Submodule.mem_comap, LinearMap.mulLeft_apply]; exact ha
    rw [← hN m hm] at h1
    change a ∈ Submodule.comap (LinearMap.mulLeft B (z ^ N)) I at h1
    rw [Submodule.mem_comap, LinearMap.mulLeft_apply] at h1
    exact h1

  have hmh : (IsLocalRing.maximalIdeal B).height = d := by
    have h1 := IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := B)
    rw [hd] at h1
    exact_mod_cast h1
  have c4a : ∀ (𝔞 : Ideal B) (k : ℕ), ∃ g : Fin k → B, (∀ j, g j ∈ 𝔞) ∧
      ∀ Q ∈ (Ideal.span (Set.range g)).minimalPrimes, ¬ 𝔞 ≤ Q → (k : ℕ∞) ≤ Q.height := by
    intro 𝔞 k
    induction k with
    | zero => exact ⟨Fin.elim0, fun j => j.elim0, fun Q _ _ => by simp⟩
    | succ k ih =>
      obtain ⟨g, hg𝔞, hgQ⟩ := ih
      set S0 : Set (Ideal B) :=
        {Q | Q ∈ (Ideal.span (Set.range g)).minimalPrimes ∧ ¬ 𝔞 ≤ Q} with hS0
      have hS0fin : S0.Finite := (Ideal.finite_minimalPrimes_of_isNoetherianRing B _).subset
        (fun Q hQ => hQ.1)
      have hnot : ¬ ((𝔞 : Set B) ⊆ ⋃ i ∈ S0, ((i : Ideal B) : Set B)) := by
        intro hsub
        obtain ⟨i, hi, h𝔞i⟩ := (Ideal.subset_union_prime_finite (f := fun i : Ideal B => i)
          hS0fin ⊥ ⊥ (fun i hi _ _ => hi.1.1.1)).mp hsub
        exact hi.2 h𝔞i
      obtain ⟨x, hx𝔞, hxS⟩ := Set.not_subset.mp hnot
      have hrange : Set.range (Fin.snoc (α := fun _ => B) g x) = insert x (Set.range g) :=
        Fin.range_snoc g x
      refine ⟨Fin.snoc (α := fun _ => B) g x, ?_, ?_⟩
      · intro j
        refine Fin.lastCases ?_ (fun j => ?_) j
        · rw [Fin.snoc_last]; exact hx𝔞
        · rw [Fin.snoc_castSucc]; exact hg𝔞 j
      · intro Q' hQ' hQ'𝔞
        have hQ'p : Q'.IsPrime := hQ'.1.1
        have hspan : Ideal.span (Set.range g) ≤ Q' :=
          (Ideal.span_mono (by rw [hrange]; exact Set.subset_insert _ _)).trans hQ'.1.2
        obtain ⟨Q, hQ, hQQ'⟩ := Ideal.exists_minimalPrimes_le hspan
        have hQ𝔞 : ¬ 𝔞 ≤ Q := fun h => hQ'𝔞 (h.trans hQQ')
        have hQS : Q ∈ S0 := ⟨hQ, hQ𝔞⟩
        have hxQ : x ∉ Q := fun h => hxS (Set.mem_biUnion hQS h)
        have hxQ' : x ∈ Q' :=
          hQ'.1.2 (Ideal.subset_span (by rw [hrange]; exact Set.mem_insert _ _))
        have hlt : Q < Q' := lt_of_le_of_ne hQQ' (fun h => hxQ (h ▸ hxQ'))
        have hk := hgQ Q hQ hQ𝔞
        by_contra hcon
        push_neg at hcon
        have hle : Q'.height ≤ (k : ℕ∞) := by
          rw [← ENat.lt_add_one_iff (by simp)]
          exact_mod_cast hcon
        have := (Ideal.height_le_iff.mp hle) Q hQ.1.1 hlt
        exact absurd hk (not_le.mpr this)
  have c4 : ∀ (𝔞 P : Ideal B), P.IsPrime → P ≠ IsLocalRing.maximalIdeal B → 𝔞 ≤ P →
      ∃ (k : ℕ) (g : Fin k → B), k < d ∧ (∀ j, g j ∈ 𝔞) ∧
        ∃ u : B, u ∉ P ∧ ∀ a ∈ 𝔞, u * a ∈ (Ideal.span (Set.range g)).radical := by
    intro 𝔞 P hP hPm h𝔞P
    have hPlt : P < IsLocalRing.maximalIdeal B :=
      lt_of_le_of_ne (IsLocalRing.le_maximalIdeal hP.ne_top) hPm
    have hPd : P.height < (d : ℕ∞) := Ideal.height_le_iff.mp hmh.le P hP hPlt
    have hne : P.height ≠ ⊤ := ne_top_of_lt hPd
    have hPh : ((P.height.toNat : ℕ) : ℕ∞) = P.height := ENat.coe_toNat hne
    have hkd : P.height.toNat < d := by
      have h1 : ((P.height.toNat : ℕ) : ℕ∞) < d := by rw [hPh]; exact hPd
      exact_mod_cast h1
    obtain ⟨g, hg𝔞, hgQ⟩ := c4a 𝔞 P.height.toNat
    refine ⟨P.height.toNat, g, hkd, hg𝔞, ?_⟩
    have hcont : ∀ Q ∈ (Ideal.span (Set.range g)).minimalPrimes, Q ≤ P → 𝔞 ≤ Q := by
      intro Q hQ hQP
      by_contra h𝔞Q
      have hk := hgQ Q hQ h𝔞Q
      have hQne : Q ≠ P := fun e => h𝔞Q (e ▸ h𝔞P)
      have hQlt : Q < P := lt_of_le_of_ne hQP hQne
      have := (Ideal.height_le_iff (p := P) (n := P.height.toNat)).mp hPh.ge Q hQ.1.1 hQlt
      exact absurd hk (not_le.mpr this)
    set S2 : Set (Ideal B) :=
      {Q | Q ∈ (Ideal.span (Set.range g)).minimalPrimes ∧ ¬ Q ≤ P} with hS2
    have hS2fin : S2.Finite := (Ideal.finite_minimalPrimes_of_isNoetherianRing B _).subset
      (fun Q hQ => hQ.1)
    have hv : ∀ Q ∈ S2, ∃ v : B, v ∈ Q ∧ v ∉ P := by
      intro Q hQ
      obtain ⟨v, hvQ, hvP⟩ := Set.not_subset.mp hQ.2
      exact ⟨v, hvQ, hvP⟩
    choose! v hvQ hvP using hv
    refine ⟨∏ Q ∈ hS2fin.toFinset, v Q, ?_, ?_⟩
    · intro hmem
      obtain ⟨Q, hQ, hvQP⟩ := Ideal.IsPrime.prod_mem_iff.mp hmem
      exact hvP Q (hS2fin.mem_toFinset.mp hQ) hvQP
    · intro a ha
      rw [← Ideal.sInf_minimalPrimes, Submodule.mem_sInf]
      intro Q hQ
      by_cases hQP : Q ≤ P
      · exact Ideal.mul_mem_left Q _ (hcont Q hQ hQP ha)
      · obtain ⟨c, hc⟩ := Finset.dvd_prod_of_mem v (hS2fin.mem_toFinset.mpr ⟨hQ, hQP⟩)
        rw [hc, mul_assoc]
        exact Ideal.mul_mem_right _ Q (hvQ Q ⟨hQ, hQP⟩)

  have c5 : ∀ (𝔞 𝔟 : Ideal B) (u : B), 𝔟 ≤ 𝔞 → (∀ a ∈ 𝔞, u * a ∈ 𝔟.radical) →
      (∀ (𝔠 : Ideal B), 𝔟 ≤ 𝔠.radical →
        ∀ (y : Abelian.Ext (ModuleCat.of B (B ⧸ 𝔠)) (ModuleCat.of B B) d),
          ∃ (𝔠' : Ideal B) (h : 𝔠' ≤ 𝔠), 𝔟 ≤ 𝔠'.radical ∧
            (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor h))).comp y (zero_add d) = 0) →
      ∀ (𝔠 : Ideal B), 𝔞 ≤ 𝔠.radical →
        ∀ (y : Abelian.Ext (ModuleCat.of B (B ⧸ 𝔠)) (ModuleCat.of B B) d),
        ∃ (k : ℕ) (𝔠' : Ideal B) (h : 𝔠' ≤ 𝔠), 𝔞 ≤ 𝔠'.radical ∧
          (Abelian.Ext.mk₀ (u ^ k • ModuleCat.ofHom (Submodule.factor h))).comp y
            (zero_add d) = 0 := by
    intro 𝔞 𝔟 u h𝔟 hu hW 𝔠 h𝔠 y
    obtain ⟨𝔠'', h𝔠'', h𝔠''r, hy⟩ := hW 𝔠 (h𝔟.trans h𝔠) y
    have hL : Ideal.span {u} * 𝔞 ≤ 𝔠''.radical := by
      rw [Ideal.mul_le]
      intro r hr s hs
      obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp hr
      rw [mul_assoc]
      exact Ideal.mul_mem_left _ _ (Ideal.radical_le_radical_iff.mpr h𝔠''r (hu s hs))
    obtain ⟨K, hK⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hL (IsNoetherian.noetherian _)
    have hμ : 𝔠 ⊓ Submodule.comap (LinearMap.mulLeft B (u ^ K)) 𝔠'' ≤
        Submodule.comap (LinearMap.mulLeft B (u ^ K)) 𝔠'' := inf_le_right
    refine ⟨K, 𝔠 ⊓ Submodule.comap (LinearMap.mulLeft B (u ^ K)) 𝔠'', inf_le_left, ?_, ?_⟩
    · intro a ha
      rw [Ideal.radical_inf]
      refine ⟨h𝔠 ha, K, ?_⟩
      rw [Submodule.mem_comap, LinearMap.mulLeft_apply, ← mul_pow]
      exact hK (Ideal.pow_mem_pow (Ideal.mul_mem_mul (Ideal.mem_span_singleton_self u) ha) K)
    · have hid : u ^ K • ModuleCat.ofHom (Submodule.factor
            (inf_le_left : 𝔠 ⊓ Submodule.comap (LinearMap.mulLeft B (u ^ K)) 𝔠'' ≤ 𝔠)) =
          ModuleCat.ofHom (Submodule.mapQ _ _ (LinearMap.mulLeft B (u ^ K)) hμ) ≫
            ModuleCat.ofHom (Submodule.factor h𝔠'') := by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro a
        obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ a
        change u ^ K • (Submodule.Quotient.mk a : B ⧸ 𝔠) = Submodule.Quotient.mk (u ^ K * a)
        rw [← Submodule.Quotient.mk_smul, smul_eq_mul]
      rw [hid, ← Abelian.Ext.mk₀_comp_mk₀_assoc, hy, Abelian.Ext.comp_zero]

  have c6 : ∀ (𝔞 𝔠 : Ideal B), 𝔞 ≤ 𝔠.radical →
      ∀ (y : Abelian.Ext (ModuleCat.of B (B ⧸ 𝔠)) (ModuleCat.of B B) d) (x : B),
      (∀ P : Ideal B, P.IsPrime → 𝔞 ≤ P → x ∉ P → ∃ r : B, r ∉ P ∧
        ∃ (𝔠' : Ideal B) (h : 𝔠' ≤ 𝔠), 𝔞 ≤ 𝔠'.radical ∧
          (Abelian.Ext.mk₀ (r • ModuleCat.ofHom (Submodule.factor h))).comp y (zero_add d) = 0) →
      ∃ (n : ℕ) (𝔠' : Ideal B) (h : 𝔠' ≤ 𝔠), 𝔞 ≤ 𝔠'.radical ∧
        (Abelian.Ext.mk₀ (x ^ n • ModuleCat.ofHom (Submodule.factor h))).comp y
          (zero_add d) = 0 := by
    intro 𝔞 𝔠 h𝔠 y x hPx
    let T : Ideal B :=
      { carrier := {r | ∃ (𝔠' : Ideal B) (h : 𝔠' ≤ 𝔠), 𝔞 ≤ 𝔠'.radical ∧
          (Abelian.Ext.mk₀ (r • ModuleCat.ofHom (Submodule.factor h))).comp y (zero_add d) = 0}
        add_mem' := by
          intro r₁ r₂ hr₁ hr₂
          simp only [Set.mem_setOf_eq] at hr₁ hr₂ ⊢
          obtain ⟨𝔠₁, h₁, hc₁, e₁⟩ := hr₁
          obtain ⟨𝔠₂, h₂, hc₂, e₂⟩ := hr₂
          refine ⟨𝔠₁ ⊓ 𝔠₂, inf_le_left.trans h₁, ?_, ?_⟩
          · rw [Ideal.radical_inf]; exact le_inf hc₁ hc₂
          · have hid : (r₁ + r₂) • ModuleCat.ofHom (Submodule.factor
                  (inf_le_left.trans h₁ : 𝔠₁ ⊓ 𝔠₂ ≤ 𝔠)) =
                ModuleCat.ofHom (Submodule.factor (inf_le_left : 𝔠₁ ⊓ 𝔠₂ ≤ 𝔠₁)) ≫
                  (r₁ • ModuleCat.ofHom (Submodule.factor h₁)) +
                ModuleCat.ofHom (Submodule.factor (inf_le_right : 𝔠₁ ⊓ 𝔠₂ ≤ 𝔠₂)) ≫
                  (r₂ • ModuleCat.ofHom (Submodule.factor h₂)) := by
              rw [Linear.comp_smul, Linear.comp_smul, ← ModuleCat.ofHom_comp,
                ← ModuleCat.ofHom_comp, Submodule.factor_comp, Submodule.factor_comp, add_smul]
            rw [hid, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp, ← Abelian.Ext.mk₀_comp_mk₀_assoc,
              ← Abelian.Ext.mk₀_comp_mk₀_assoc, e₁, e₂, Abelian.Ext.comp_zero,
              Abelian.Ext.comp_zero, add_zero]
        zero_mem' := by
          simp only [Set.mem_setOf_eq]
          exact ⟨𝔠, le_rfl, h𝔠, by rw [zero_smul, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]⟩
        smul_mem' := by
          intro s r hr
          simp only [Set.mem_setOf_eq] at hr ⊢
          obtain ⟨𝔠', h, hc, e⟩ := hr
          refine ⟨𝔠', h, hc, ?_⟩
          have hid : (s • r) • ModuleCat.ofHom (Submodule.factor h) =
              (s • 𝟙 (ModuleCat.of B (B ⧸ 𝔠'))) ≫ (r • ModuleCat.ofHom (Submodule.factor h)) := by
            rw [Linear.smul_comp, Category.id_comp, smul_eq_mul, mul_smul]
          rw [hid, ← Abelian.Ext.mk₀_comp_mk₀_assoc, e, Abelian.Ext.comp_zero] }
    have hT : ∀ r, r ∈ T ↔ ∃ (𝔠' : Ideal B) (h : 𝔠' ≤ 𝔠), 𝔞 ≤ 𝔠'.radical ∧
        (Abelian.Ext.mk₀ (r • ModuleCat.ofHom (Submodule.factor h))).comp y (zero_add d) = 0 :=
      fun r => Iff.rfl
    have h𝔞T : 𝔞 ≤ T.radical := by
      intro a ha
      obtain ⟨n, hn⟩ := h𝔠 ha
      refine ⟨n, (hT _).mpr ⟨𝔠, le_rfl, h𝔠, ?_⟩⟩
      have h0 : a ^ n • ModuleCat.ofHom (Submodule.factor (le_rfl : 𝔠 ≤ 𝔠)) = 0 := by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro b
        obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ b
        change a ^ n • (Submodule.Quotient.mk b : B ⧸ 𝔠) = 0
        rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, smul_eq_mul]
        exact 𝔠.mul_mem_right _ hn
      rw [h0, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
    have hxT : x ∈ T.radical := by
      rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
      rintro P ⟨hTP, hP⟩
      by_contra hxP
      have h𝔞P : 𝔞 ≤ P := h𝔞T.trans ((Ideal.IsPrime.radical_le_iff hP).mpr hTP)
      obtain ⟨r, hrP, hr⟩ := hPx P hP h𝔞P hxP
      exact hrP (hTP ((hT r).mpr hr))
    obtain ⟨n, hn⟩ := hxT
    exact ⟨n, (hT _).mp hn⟩

  have c7 : ∀ (𝔞 : Ideal B) (x : B),
      (∀ (𝔠 : Ideal B), 𝔞 ⊔ Ideal.span {x} ≤ 𝔠.radical →
        ∀ (y : Abelian.Ext (ModuleCat.of B (B ⧸ 𝔠)) (ModuleCat.of B B) d),
          ∃ (𝔠' : Ideal B) (h : 𝔠' ≤ 𝔠), 𝔞 ⊔ Ideal.span {x} ≤ 𝔠'.radical ∧
            (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor h))).comp y (zero_add d) = 0) →
      ∀ (𝔠 : Ideal B) (y : Abelian.Ext (ModuleCat.of B (B ⧸ 𝔠)) (ModuleCat.of B B) d)
        (n : ℕ) (𝔠₁ : Ideal B) (h₁ : 𝔠₁ ≤ 𝔠), 𝔞 ≤ 𝔠₁.radical →
        (Abelian.Ext.mk₀ (x ^ n • ModuleCat.ofHom (Submodule.factor h₁))).comp y
          (zero_add d) = 0 →
        ∃ (𝔠' : Ideal B) (h : 𝔠' ≤ 𝔠), 𝔞 ≤ 𝔠'.radical ∧
          (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor h))).comp y (zero_add d) = 0 := by
    intro 𝔞 x hW 𝔠 y n 𝔠₁ h₁ hr₁ hy
    obtain ⟨N, hN⟩ := hstab 𝔠₁ x
    have hγ : Submodule.comap (LinearMap.mulLeft B (x ^ (n + N))) 𝔠₁ ≤
        Submodule.comap (LinearMap.mulLeft B (x ^ N)) 𝔠₁ := by
      intro a ha
      rw [Submodule.mem_comap, LinearMap.mulLeft_apply] at ha ⊢
      exact hN (n + N) (by omega) a ha
    have hid : (S 𝔠₁ (x ^ (n + N))).f ≫ ModuleCat.ofHom (Submodule.factor h₁) =
        ModuleCat.ofHom (Submodule.mapQ _ _ (LinearMap.mulLeft B (x ^ N)) hγ) ≫
          (x ^ n • ModuleCat.ofHom (Submodule.factor h₁)) := by
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro a
      obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ a
      change (Submodule.Quotient.mk (x ^ (n + N) * a) : B ⧸ 𝔠) =
        x ^ n • (Submodule.Quotient.mk (x ^ N * a) : B ⧸ 𝔠)
      rw [← Submodule.Quotient.mk_smul, smul_eq_mul, ← mul_assoc, ← pow_add]
    have h3 : (Abelian.Ext.mk₀ (S 𝔠₁ (x ^ (n + N))).f).comp
        ((Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor h₁))).comp y (zero_add d))
        (zero_add d) = 0 := by
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, hid, ← Abelian.Ext.mk₀_comp_mk₀_assoc, hy,
        Abelian.Ext.comp_zero]
    obtain ⟨v, hv⟩ := Abelian.Ext.contravariant_sequence_exact₂ (hSE 𝔠₁ (x ^ (n + N)))
      (ModuleCat.of B B) _ h3
    have hrad : 𝔞 ⊔ Ideal.span {x} ≤ (𝔠₁ ⊔ Ideal.span {x ^ (n + N)}).radical :=
      sup_le (hr₁.trans (Ideal.radical_mono le_sup_left))
        ((Ideal.span_singleton_le_iff_mem _).mpr
          ⟨n + N, Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)⟩)
    obtain ⟨𝔢, h𝔢, h𝔢r, hv0⟩ := hW _ hrad v
    refine ⟨𝔢 ⊓ 𝔠₁, inf_le_right.trans h₁, ?_, ?_⟩
    · rw [Ideal.radical_inf]; exact le_inf (le_sup_left.trans h𝔢r) hr₁
    · have e1 := rho_comp (inf_le_right : 𝔢 ⊓ 𝔠₁ ≤ 𝔠₁) h₁ y
      have e2 := rho_comp (inf_le_right : 𝔢 ⊓ 𝔠₁ ≤ 𝔠₁)
        (le_sup_left : 𝔠₁ ≤ 𝔠₁ ⊔ Ideal.span {x ^ (n + N)}) v
      have e3 := rho_comp (inf_le_left : 𝔢 ⊓ 𝔠₁ ≤ 𝔢) h𝔢 v
      rw [hv0, Abelian.Ext.comp_zero] at e3
      rw [← e1, ← hv]
      exact e2.trans e3.symm

  have hstepΦ : ∀ (𝔞 : Ideal B) (x : B), x ∈ IsLocalRing.maximalIdeal B →
      Limits.IsZero ((localCohomology (𝔞 ⊔ Ideal.span {x}) d).obj (ModuleCat.of B B)) →
      Limits.IsZero ((localCohomology 𝔞 d).obj (ModuleCat.of B B)) := by
    intro 𝔞 x hxm hx
    have hW := (c1 _).mp hx
    rw [c1]
    intro 𝔠 h𝔠 y
    have hP : ∀ P : Ideal B, P.IsPrime → 𝔞 ≤ P → x ∉ P → ∃ r : B, r ∉ P ∧
        ∃ (𝔠' : Ideal B) (h : 𝔠' ≤ 𝔠), 𝔞 ≤ 𝔠'.radical ∧
          (Abelian.Ext.mk₀ (r • ModuleCat.ofHom (Submodule.factor h))).comp y
            (zero_add d) = 0 := by
      intro P hP h𝔞P hxP
      have hPm : P ≠ IsLocalRing.maximalIdeal B := fun e => hxP (e ▸ hxm)
      obtain ⟨k, g, hkd, hg𝔞, u, huP, hu⟩ := c4 𝔞 P hP hPm h𝔞P
      have hb𝔞 : Ideal.span (Set.range g) ≤ 𝔞 := by
        rw [Ideal.span_le]; rintro _ ⟨j, rfl⟩; exact hg𝔞 j
      have hWb := (c1 _).mp (wc_plt_lc_cech_vanishing B k g (ModuleCat.of B B) d hkd)
      obtain ⟨K, 𝔠', h𝔠', h𝔠'r, hK⟩ := c5 𝔞 _ u hb𝔞 hu hWb 𝔠 h𝔠 y
      exact ⟨u ^ K, fun hm => huP (hP.mem_of_pow_mem K hm), 𝔠', h𝔠', h𝔠'r, hK⟩
    obtain ⟨n, 𝔠₁, h₁, hr₁, hy⟩ := c6 𝔞 𝔠 h𝔠 y x hP
    exact c7 𝔞 x hW 𝔠 y n 𝔠₁ h₁ hr₁ hy

  have hind : ∀ (k : ℕ) (f : Fin k → B) (𝔞 : Ideal B),
      (∀ j, f j ∈ IsLocalRing.maximalIdeal B) →
      Limits.IsZero ((localCohomology (𝔞 ⊔ Ideal.span (Set.range f)) d).obj
        (ModuleCat.of B B)) →
      Limits.IsZero ((localCohomology 𝔞 d).obj (ModuleCat.of B B)) := by
    intro k
    induction k with
    | zero =>
      intro f 𝔞 _ hf
      rwa [Set.range_eq_empty, Ideal.span_empty, sup_bot_eq] at hf
    | succ k ih =>
      intro f 𝔞 hfm hf
      have e : Ideal.span (Set.range f) =
          Ideal.span {f (Fin.last k)} ⊔ Ideal.span (Set.range (Fin.init f)) := by
        calc Ideal.span (Set.range f)
            = Ideal.span (Set.range (Fin.snoc (Fin.init f) (f (Fin.last k)) :
                Fin (k + 1) → B)) := by
              rw [Fin.snoc_init_self]
          _ = _ := by rw [Fin.range_snoc, Ideal.span_insert]
      rw [e, ← sup_assoc] at hf
      exact hstepΦ 𝔞 _ (hfm _) (ih (Fin.init f) _ (fun j => hfm _) hf)

  obtain ⟨k, f, hf⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (IsNoetherian.noetherian J')
  apply hind k f J
  · intro j
    apply hJ'
    rw [← hf]
    exact Submodule.subset_span (Set.mem_range_self j)
  · have hJ'eq : J ⊔ Ideal.span (Set.range f) = J' := by
      rw [show Ideal.span (Set.range f) = J' from hf]
      exact sup_eq_right.mpr hJJ'
    rw [hJ'eq]
    exact h

theorem wc_plt_hlc_param_choice (B : Type u) [CommRing B] [IsNoetherianRing B] [IsLocalRing B]
    (k : ℕ) (hk : 1 ≤ k) (hd : ringKrullDim B = (k + 1 : ℕ)) (P : Ideal B) [P.IsPrime]
    (hPm : P ≠ IsLocalRing.maximalIdeal B)
    (hP1 : ∀ Q : Ideal B, Q.IsPrime → P ≤ Q → Q = P ∨ Q = IsLocalRing.maximalIdeal B) :
    ∃ (w y : B) (x : Fin k → B), w ∈ P ∧ (∀ i, x i ∈ P) ∧ y ∉ P ∧
      (Ideal.span (Set.range (Fin.cons w x : Fin (k + 1) → B))).radical = P ∧
      (Ideal.span (Set.range (Fin.cons y x : Fin (k + 1) → B))).radical =
        IsLocalRing.maximalIdeal B :=
by
  classical

  have avoid : ∀ (S : Set (Ideal B)) (J : Ideal B), S.Finite → (∀ p ∈ S, p.IsPrime) →
      (∀ p ∈ S, ¬ J ≤ p) → ∃ x ∈ J, ∀ p ∈ S, x ∉ p := by
    intro S J hS hSp hJ
    have h := Ideal.subset_union_prime_finite (f := id) hS (⊥ : Ideal B) ⊥
      (fun i hi _ _ => hSp i hi) (I := J)
    have hn : ¬ ((J : Set B) ⊆ ⋃ i ∈ S, ((id i : Ideal B) : Set B)) := by
      rw [h]
      rintro ⟨i, hi, hJi⟩
      exact hJ i hi hJi
    rw [Set.not_subset] at hn
    obtain ⟨x, hxJ, hx⟩ := hn
    exact ⟨x, hxJ, fun p hp hxp => hx (Set.mem_biUnion hp hxp)⟩

  have step : ∀ (I J : Ideal B) (n : ℕ),
      (∀ q : PrimeSpectrum B, I ≤ q.asIdeal → Order.coheight q ≤ ((n + 1 : ℕ) : ℕ∞)) →
      (∀ q : PrimeSpectrum B, q.asIdeal ∈ I.minimalPrimes →
        Order.coheight q = ((n + 1 : ℕ) : ℕ∞) → ¬ J ≤ q.asIdeal) →
      ∃ x ∈ J, ∀ q : PrimeSpectrum B, I ≤ q.asIdeal → x ∈ q.asIdeal →
        Order.coheight q ≤ (n : ℕ∞) := by
    intro I J n hI hJ
    obtain ⟨x, hxJ, hx⟩ := avoid {p | p ∈ I.minimalPrimes ∧ ∃ hp : p.IsPrime,
        Order.coheight (⟨p, hp⟩ : PrimeSpectrum B) = ((n + 1 : ℕ) : ℕ∞)} J
      ((Ideal.finite_minimalPrimes_of_isNoetherianRing B I).subset (fun p hp => hp.1))
      (fun p hp => hp.2.1)
      (fun p hp hJp => by
        obtain ⟨hpmin, hp, hch⟩ := hp
        exact hJ ⟨p, hp⟩ hpmin hch hJp)
    refine ⟨x, hxJ, fun q hIq hxq => ?_⟩
    obtain ⟨p, hpmin, hpq⟩ := Ideal.exists_minimalPrimes_le hIq
    have hpp : p.IsPrime := hpmin.1.1
    have hIp : I ≤ p := hpmin.1.2
    have hch := hI ⟨p, hpp⟩ hIp
    have hpq' : (⟨p, hpp⟩ : PrimeSpectrum B) ≤ q :=
      (PrimeSpectrum.asIdeal_le_asIdeal _ _).mp hpq
    by_cases heq : Order.coheight (⟨p, hpp⟩ : PrimeSpectrum B) = ((n + 1 : ℕ) : ℕ∞)
    · have hxp : x ∉ p := hx p ⟨hpmin, hpp, heq⟩
      have hlt : (⟨p, hpp⟩ : PrimeSpectrum B) < q := by
        rw [← PrimeSpectrum.asIdeal_lt_asIdeal]
        exact lt_of_le_of_ne hpq (fun h => hxp (by change p = q.asIdeal at h; rw [h]; exact hxq))
      have h2 := Order.coheight_add_one_le hlt
      rw [heq] at h2
      push_cast at h2
      exact (ENat.add_le_add_iff_right ENat.one_ne_top).mp h2
    · have h3 : Order.coheight (⟨p, hpp⟩ : PrimeSpectrum B) < (n : ℕ∞) + 1 := by
        have := lt_of_le_of_ne hch heq
        push_cast at this
        exact this
      have h4 : Order.coheight (⟨p, hpp⟩ : PrimeSpectrum B) ≤ (n : ℕ∞) :=
        (ENat.lt_add_one_iff (ENat.coe_ne_top n)).mp h3
      exact le_trans (Order.coheight_anti hpq') h4

  have hmax : ∀ q : PrimeSpectrum B, IsMax q ↔ q.asIdeal = IsLocalRing.maximalIdeal B := by
    intro q
    constructor
    · intro h
      have h1 : q ≤ IsLocalRing.closedPoint B := by
        rw [← PrimeSpectrum.asIdeal_le_asIdeal]
        exact IsLocalRing.le_maximalIdeal q.isPrime.ne_top
      have h2 := h h1
      rw [← PrimeSpectrum.asIdeal_le_asIdeal] at h1 h2
      exact le_antisymm h1 h2
    · intro h r hr
      rw [← PrimeSpectrum.asIdeal_le_asIdeal] at hr ⊢
      rw [h]
      exact IsLocalRing.le_maximalIdeal r.isPrime.ne_top
  have hch0 : ∀ q : PrimeSpectrum B,
      Order.coheight q = 0 ↔ q.asIdeal = IsLocalRing.maximalIdeal B :=
    fun q => Order.coheight_eq_zero.trans (hmax q)
  have hPm' : P ≤ IsLocalRing.maximalIdeal B :=
    IsLocalRing.le_maximalIdeal (Ideal.IsPrime.ne_top inferInstance)

  let p0 : PrimeSpectrum B := ⟨P, inferInstance⟩
  have hchP : Order.coheight p0 = 1 := by
    apply le_antisymm
    · rw [show (1 : ℕ∞) = ((1 : ℕ) : ℕ∞) by norm_num, Order.coheight_le_coe_iff]
      intro r hr
      have hr' : P < r.asIdeal := (PrimeSpectrum.asIdeal_lt_asIdeal p0 r).mpr hr
      rcases hP1 r.asIdeal r.isPrime hr'.le with h | h
      · exact absurd h hr'.ne'
      · rw [(hch0 r).mpr h]; norm_num
    · have hlt : p0 < IsLocalRing.closedPoint B := by
        rw [← PrimeSpectrum.asIdeal_lt_asIdeal]
        exact lt_of_le_of_ne hPm' hPm
      have h := Order.coheight_add_one_le hlt
      rw [(hch0 _).mpr rfl, zero_add] at h
      exact h

  have hbase : ∀ q : PrimeSpectrum B, Order.coheight q ≤ ((k + 1 : ℕ) : ℕ∞) := by
    intro q
    have h := Order.coheight_le_krullDim q
    rw [show Order.krullDim (PrimeSpectrum B) = ringKrullDim B from rfl, hd] at h
    exact_mod_cast h

  have hchain : ∀ i : ℕ, i ≤ k → ∃ x : Fin i → B, (∀ j, x j ∈ P) ∧
      ∀ q : PrimeSpectrum B, Ideal.span (Set.range x) ≤ q.asIdeal →
        Order.coheight q ≤ ((k + 1 - i : ℕ) : ℕ∞) := by
    intro i
    induction i with
    | zero =>
      intro _
      exact ⟨Fin.elim0, fun j => j.elim0, fun q _ => by simpa using hbase q⟩
    | succ i ih =>
      intro hi
      obtain ⟨x, hxP, hxb⟩ := ih (by omega)
      obtain ⟨x', hx'P, hx'⟩ := step (Ideal.span (Set.range x)) P (k - i)
        (fun q hq => by
          have := hxb q hq
          rwa [show k + 1 - i = k - i + 1 by omega] at this)
        (fun q _ hq hPq => by
          have h1 : Order.coheight q ≤ Order.coheight p0 :=
            Order.coheight_anti ((PrimeSpectrum.asIdeal_le_asIdeal p0 q).mp hPq)
          rw [hq, hchP] at h1
          have h2 : k - i + 1 ≤ 1 := by exact_mod_cast h1
          omega)
      refine ⟨Fin.cons x' x, fun j => ?_, fun q hq => ?_⟩
      · refine Fin.cases ?_ (fun j => ?_) j
        · simpa using hx'P
        · simpa using hxP j
      · rw [Fin.range_cons, Ideal.span_insert, sup_le_iff] at hq
        have := hx' q hq.2 (Ideal.span_le.mp hq.1 (Set.mem_singleton x'))
        rwa [show k + 1 - (i + 1) = k - i by omega]
  obtain ⟨x, hxP, hx1⟩ := hchain k le_rfl
  have hx1' : ∀ q : PrimeSpectrum B, Ideal.span (Set.range x) ≤ q.asIdeal →
      Order.coheight q ≤ 1 := by
    intro q hq
    have := hx1 q hq
    rwa [show k + 1 - k = 1 by omega, Nat.cast_one] at this
  have hIP : Ideal.span (Set.range x) ≤ P :=
    Ideal.span_le.mpr (by rintro _ ⟨j, rfl⟩; exact hxP j)
  have hspan : ∀ z : B, Ideal.span (Set.range (Fin.cons z x : Fin (k + 1) → B)) =
      Ideal.span {z} ⊔ Ideal.span (Set.range x) := fun z => by
    rw [Fin.range_cons, Ideal.span_insert]

  obtain ⟨y, hym, hy⟩ := step (Ideal.span (Set.range x)) (IsLocalRing.maximalIdeal B) 0
    (fun q hq => by simpa using hx1' q hq)
    (fun q _ hq hmq => by
      have h1 : q.asIdeal = IsLocalRing.maximalIdeal B :=
        le_antisymm (IsLocalRing.le_maximalIdeal q.isPrime.ne_top) hmq
      rw [(hch0 q).mpr h1] at hq
      norm_num at hq)
  have hyP : y ∉ P := by
    intro hyP
    have := hy p0 hIP hyP
    rw [hchP] at this
    norm_num at this
  have hrady : (Ideal.span (Set.range (Fin.cons y x : Fin (k + 1) → B))).radical =
      IsLocalRing.maximalIdeal B := by
    rw [Ideal.radical_eq_sInf]
    apply le_antisymm
    · apply sInf_le
      refine Set.mem_setOf.mpr ⟨?_, inferInstance⟩
      rw [hspan, sup_le_iff, Ideal.span_le, Set.singleton_subset_iff]
      exact ⟨hym, hIP.trans hPm'⟩
    · apply le_sInf
      rintro Q ⟨hQ, hQp⟩
      rw [hspan, sup_le_iff, Ideal.span_le, Set.singleton_subset_iff] at hQ
      have h0 := hy ⟨Q, hQp⟩ hQ.2 hQ.1
      have h0' : Order.coheight (⟨Q, hQp⟩ : PrimeSpectrum B) = 0 := by
        simpa using h0
      exact ((hch0 _).mp h0').ge

  obtain ⟨w, hwP, hw⟩ := avoid {p | p ∈ (Ideal.span (Set.range x)).minimalPrimes ∧ p ≠ P} P
    ((Ideal.finite_minimalPrimes_of_isNoetherianRing B _).subset (fun p hp => hp.1))
    (fun p hp => hp.1.1.1)
    (fun p hp hPp => by
      obtain ⟨hpmin, hpne⟩ := hp
      rcases hP1 p hpmin.1.1 hPp with h | h
      · exact hpne h
      · apply hPm
        apply le_antisymm hPm'
        rw [← h]
        exact hpmin.2 ⟨inferInstance, hIP⟩ hPp)
  have hradw : (Ideal.span (Set.range (Fin.cons w x : Fin (k + 1) → B))).radical = P := by
    rw [Ideal.radical_eq_sInf]
    apply le_antisymm
    · apply sInf_le
      refine Set.mem_setOf.mpr ⟨?_, inferInstance⟩
      rw [hspan, sup_le_iff, Ideal.span_le, Set.singleton_subset_iff]
      exact ⟨hwP, hIP⟩
    · apply le_sInf
      rintro Q ⟨hQ, hQp⟩
      rw [hspan, sup_le_iff, Ideal.span_le, Set.singleton_subset_iff] at hQ
      obtain ⟨p, hpmin, hpQ⟩ := Ideal.exists_minimalPrimes_le hQ.2
      by_cases hpP : p = P
      · rw [← hpP]; exact hpQ
      · have hwp : w ∉ p := hw p ⟨hpmin, hpP⟩
        have hpp : p.IsPrime := hpmin.1.1
        have hlt : (⟨p, hpp⟩ : PrimeSpectrum B) < ⟨Q, hQp⟩ := by
          rw [← PrimeSpectrum.asIdeal_lt_asIdeal]
          exact lt_of_le_of_ne hpQ (fun h => hwp (by change p = Q at h; rw [h]; exact hQ.1))
        have h1 := Order.coheight_add_one_le hlt
        have h2 := hx1' ⟨p, hpp⟩ hpmin.1.2
        have h3 : Order.coheight (⟨Q, hQp⟩ : PrimeSpectrum B) + 1 ≤ 0 + 1 := by
          rw [zero_add]; exact h1.trans h2
        have h4 : Order.coheight (⟨Q, hQp⟩ : PrimeSpectrum B) = 0 :=
          nonpos_iff_eq_zero.mp ((ENat.add_le_add_iff_right ENat.one_ne_top).mp h3)
        exact hPm'.trans ((hch0 _).mp h4).ge
  exact ⟨w, y, x, hwP, hxP, hyP, hradw, hrady⟩

theorem wc_plt_hlc_powerseries_eval (K : Type u) [Field K] (B : Type u) [CommRing B] [IsDomain B]
    [IsNoetherianRing B] [IsLocalRing B] [Algebra K B]
    (hcomp : IsAdicComplete (IsLocalRing.maximalIdeal B) B)
    (hres : Function.Surjective ((IsLocalRing.residue B).comp (algebraMap K B)))
    (n : ℕ) (hd : ringKrullDim B = n) (z : Fin n → B)
    (hz : (Ideal.span (Set.range z)).radical = IsLocalRing.maximalIdeal B) :
    ∃ ψ : MvPowerSeries (Fin n) K →ₐ[K] B, (∀ i, ψ (MvPowerSeries.X i) = z i) ∧
      Function.Injective ψ ∧ (ψ : MvPowerSeries (Fin n) K →+* B).Finite :=
by
  classical
  set m := IsLocalRing.maximalIdeal B with hm_def
  set 𝔞 := Ideal.span (Set.range z) with h𝔞_def
  have hzm : ∀ i, z i ∈ m := fun i => by
    rw [← hz]; exact Ideal.le_radical (Ideal.subset_span ⟨i, rfl⟩)
  have h𝔞m : 𝔞 ≤ m := by
    rw [← hz]; exact Ideal.le_radical
  have hH : IsHausdorff m B := hcomp.toIsHausdorff
  have hP : IsPrecomplete m B := hcomp.toIsPrecomplete
  have hsm : ∀ N : ℕ, (m ^ N • (⊤ : Submodule B B)) = m ^ N := fun N => by
    rw [Ideal.smul_eq_mul, Ideal.mul_top]

  have hpoly : ∀ (N : ℕ) (p : MvPolynomial (Fin n) K),
      (∀ α : Fin n →₀ ℕ, α.degree < N → p.coeff α = 0) → MvPolynomial.aeval z p ∈ m ^ N := by
    intro N p hp
    rw [p.as_sum, map_sum]
    refine Ideal.sum_mem _ (fun α hα => ?_)
    rw [MvPolynomial.aeval_monomial]
    apply Ideal.mul_mem_left
    have hdeg : N ≤ α.degree := by
      by_contra h
      push_neg at h
      exact (MvPolynomial.mem_support_iff.mp hα) (hp α h)
    have hmem : α.prod (fun i k => z i ^ k) ∈ m ^ α.degree := by
      rw [Finsupp.prod_fintype _ _ (fun i => pow_zero _), Finsupp.degree_eq_sum,
        ← Finset.prod_pow_eq_pow_sum]
      exact Ideal.prod_mem_prod (fun i _ => Ideal.pow_mem_pow (hzm i) _)
    exact Ideal.pow_le_pow_right hdeg hmem

  have hG : ∀ (N : ℕ) (F : MvPowerSeries (Fin n) K) (p : MvPolynomial (Fin n) K),
      (∀ α : Fin n →₀ ℕ, α.degree < N → MvPowerSeries.coeff α F = p.coeff α) →
      MvPolynomial.aeval z (MvPowerSeries.truncTotal N F) - MvPolynomial.aeval z p ∈ m ^ N := by
    intro N F p h
    rw [← map_sub]
    apply hpoly
    intro α hα
    rw [MvPolynomial.coeff_sub, MvPowerSeries.coeff_truncTotal _ hα, h α hα, sub_self]

  have hlim : ∀ F : MvPowerSeries (Fin n) K, ∃ L : B, ∀ N : ℕ,
      MvPolynomial.aeval z (MvPowerSeries.truncTotal N F) - L ∈ m ^ N := by
    intro F
    obtain ⟨L, hL⟩ := hP.prec (f := fun N => MvPolynomial.aeval z (MvPowerSeries.truncTotal N F))
      (fun {a b} hab => by
        rw [SModEq.sub_mem, hsm]
        apply hG
        intro α hα
        rw [MvPowerSeries.coeff_truncTotal _ (lt_of_lt_of_le hα hab)])
    exact ⟨L, fun N => by have := hL N; rwa [SModEq.sub_mem, hsm] at this⟩
  choose L hL using hlim
  have hU : ∀ (F : MvPowerSeries (Fin n) K) (x : B),
      (∀ N : ℕ, MvPolynomial.aeval z (MvPowerSeries.truncTotal N F) - x ∈ m ^ N) → L F = x := by
    intro F x hx
    have h0 : x - L F = 0 := by
      apply hH.haus
      intro N
      rw [SModEq.sub_mem, sub_zero, hsm]
      have := Ideal.sub_mem _ (hL F N) (hx N)
      rwa [sub_sub_sub_cancel_left] at this
    exact (sub_eq_zero.mp h0).symm
  have hLpoly : ∀ p : MvPolynomial (Fin n) K,
      L (p : MvPowerSeries (Fin n) K) = MvPolynomial.aeval z p := by
    intro p
    apply hU
    intro N
    apply hG
    intro α _
    rw [MvPolynomial.coeff_coe]
  have hLadd : ∀ F G, L (F + G) = L F + L G := by
    intro F G
    apply hU
    intro N
    have := Ideal.add_mem _ (hL F N) (hL G N)
    rw [map_add, map_add]
    convert this using 1
    ring
  have hLmul : ∀ F G, L (F * G) = L F * L G := by
    intro F G
    apply hU
    intro N
    have hD : MvPolynomial.aeval z (MvPowerSeries.truncTotal N (F * G)) -
        MvPolynomial.aeval z (MvPowerSeries.truncTotal N F) *
          MvPolynomial.aeval z (MvPowerSeries.truncTotal N G) ∈ m ^ N := by
      rw [← map_mul]
      apply hG
      intro α hα
      rw [MvPowerSeries.coeff_mul, MvPolynomial.coeff_mul]
      apply Finset.sum_congr rfl
      intro x hx
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
      have h1 : x.1.degree < N :=
        lt_of_le_of_lt (Finsupp.degree_mono (by rw [← hx]; exact le_self_add)) hα
      have h2 : x.2.degree < N :=
        lt_of_le_of_lt (Finsupp.degree_mono (by rw [← hx]; exact le_add_self)) hα
      rw [MvPowerSeries.coeff_truncTotal _ h1, MvPowerSeries.coeff_truncTotal _ h2]
    have e : MvPolynomial.aeval z (MvPowerSeries.truncTotal N (F * G)) - L F * L G =
        (MvPolynomial.aeval z (MvPowerSeries.truncTotal N (F * G)) -
          MvPolynomial.aeval z (MvPowerSeries.truncTotal N F) *
            MvPolynomial.aeval z (MvPowerSeries.truncTotal N G)) +
        (MvPolynomial.aeval z (MvPowerSeries.truncTotal N F) - L F) *
          MvPolynomial.aeval z (MvPowerSeries.truncTotal N G) +
        L F * (MvPolynomial.aeval z (MvPowerSeries.truncTotal N G) - L G) := by ring
    rw [e]
    exact Ideal.add_mem _ (Ideal.add_mem _ hD (Ideal.mul_mem_right _ _ (hL F N)))
      (Ideal.mul_mem_left _ _ (hL G N))
  let ψ : MvPowerSeries (Fin n) K →ₐ[K] B :=
    { toFun := L
      map_one' := by
        show L 1 = 1
        rw [← MvPolynomial.coe_one, hLpoly, map_one]
      map_mul' := hLmul
      map_zero' := by
        show L 0 = 0
        rw [← MvPolynomial.coe_zero, hLpoly, map_zero]
      map_add' := hLadd
      commutes' := fun c => by
        show L _ = _
        rw [MvPowerSeries.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
          ← MvPolynomial.coe_C, hLpoly, MvPolynomial.aeval_C] }
  have hψ : ∀ F, ψ F = L F := fun F => rfl
  have hψX : ∀ i, ψ (MvPowerSeries.X i) = z i := fun i => by
    rw [hψ, ← MvPolynomial.coe_X, hLpoly, MvPolynomial.aeval_X]

  have hspan : ∀ k : ℕ, ∃ (s : ℕ) (b : Fin s → B), ∀ y : B, ∃ c : Fin s → K,
      y - ∑ j, algebraMap K B (c j) * b j ∈ m ^ k := by
    intro k
    induction k with
    | zero => exact ⟨0, Fin.elim0, fun y => ⟨Fin.elim0, by simp⟩⟩
    | succ k ih =>
      obtain ⟨s, b, hb⟩ := ih
      obtain ⟨r, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
        (IsNoetherian.noetherian (m ^ k))
      refine ⟨s + r, Fin.append b g, fun y => ?_⟩
      obtain ⟨c, hc⟩ := hb y
      rw [← hg] at hc
      obtain ⟨a, ha⟩ := Ideal.mem_span_range_iff_exists_fun.mp hc
      choose κ hκ using fun l => hres (IsLocalRing.residue B (a l))
      refine ⟨Fin.append c κ, ?_⟩
      rw [Fin.sum_univ_add]
      simp only [Fin.append_left, Fin.append_right]
      have e : y - (∑ j, algebraMap K B (c j) * b j + ∑ l, algebraMap K B (κ l) * g l) =
          ∑ l, (a l - algebraMap K B (κ l)) * g l := by
        rw [sub_add_eq_sub_sub, ← ha, ← Finset.sum_sub_distrib]
        simp only [sub_mul]
      rw [e, pow_succ']
      refine Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_mul ?_ ?_)
      · rw [← IsLocalRing.residue_eq_zero_iff, map_sub, ← hκ l, RingHom.comp_apply, sub_self]
      · rw [← hg]; exact Submodule.subset_span ⟨l, rfl⟩
  obtain ⟨e, he⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hz.ge (IsNoetherian.noetherian m)
  obtain ⟨s, b, hb0⟩ := hspan e
  have hb : ∀ y : B, ∃ c : Fin s → K, y - ∑ j, algebraMap K B (c j) * b j ∈ 𝔞 := fun y => by
    obtain ⟨c, hc⟩ := hb0 y
    exact ⟨c, he hc⟩

  have hstep : ∀ (N : ℕ) (r : B), r ∈ 𝔞 ^ N → ∃ G : Fin s → MvPolynomial (Fin n) K,
      (∀ j, (G j).IsHomogeneous N) ∧
        r - ∑ j, MvPolynomial.aeval z (G j) * b j ∈ 𝔞 ^ (N + 1) := by
    intro N
    induction N with
    | zero =>
      intro r _
      obtain ⟨c, hc⟩ := hb r
      refine ⟨fun j => MvPolynomial.C (c j), fun j => MvPolynomial.isHomogeneous_C _ _, ?_⟩
      simp only [MvPolynomial.aeval_C, zero_add, pow_one]
      exact hc
    | succ N ih =>
      intro r hr
      rw [pow_succ] at hr
      refine Submodule.mul_induction_on (C := fun r => ∃ G : Fin s → MvPolynomial (Fin n) K,
        (∀ j, (G j).IsHomogeneous (N + 1)) ∧
          r - ∑ j, MvPolynomial.aeval z (G j) * b j ∈ 𝔞 ^ (N + 1 + 1)) hr ?_ ?_
      · intro x hx y hy
        obtain ⟨d, hd⟩ := Ideal.mem_span_range_iff_exists_fun.mp hy
        choose G hGh hG using fun i => ih (x * d i) (Ideal.mul_mem_right _ _ hx)
        refine ⟨fun j => ∑ i, G i j * MvPolynomial.X i, fun j => ?_, ?_⟩
        · apply MvPolynomial.IsHomogeneous.sum
          intro i _
          exact (hGh i j).mul (MvPolynomial.isHomogeneous_X K i)
        · have e1 : ∑ j, MvPolynomial.aeval z (∑ i, G i j * MvPolynomial.X i) * b j =
              ∑ i, (∑ j, MvPolynomial.aeval z (G i j) * b j) * z i := by
            simp only [map_sum, map_mul, MvPolynomial.aeval_X, Finset.sum_mul]
            rw [Finset.sum_comm]
            exact Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))
          have e2 : x * y = ∑ i, x * d i * z i := by
            rw [← hd, Finset.mul_sum]
            simp only [mul_assoc]
          have e : x * y - ∑ j, MvPolynomial.aeval z (∑ i, G i j * MvPolynomial.X i) * b j =
              ∑ i, (x * d i - ∑ j, MvPolynomial.aeval z (G i j) * b j) * z i := by
            rw [e1, e2, ← Finset.sum_sub_distrib]
            exact Finset.sum_congr rfl (fun i _ => (sub_mul _ _ _).symm)
          show x * y - ∑ j, MvPolynomial.aeval z (∑ i, G i j * MvPolynomial.X i) * b j ∈ _
          rw [e, pow_succ 𝔞 (N + 1)]
          exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_mul (hG i) (Ideal.subset_span ⟨i, rfl⟩))
      · rintro x y ⟨Gx, hGx, hx⟩ ⟨Gy, hGy, hy⟩
        refine ⟨Gx + Gy, fun j => (hGx j).add (hGy j), ?_⟩
        have e : x + y - ∑ j, MvPolynomial.aeval z ((Gx + Gy) j) * b j =
            (x - ∑ j, MvPolynomial.aeval z (Gx j) * b j) +
              (y - ∑ j, MvPolynomial.aeval z (Gy j) * b j) := by
          simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
          ring
        rw [e]
        exact Ideal.add_mem _ hx hy

  have hlift : ∀ y : B, ∃ F : Fin s → MvPowerSeries (Fin n) K, y = ∑ j, ψ (F j) * b j := by
    intro y
    have hstep' : ∀ (N : ℕ) (r : B), ∃ G : Fin s → MvPolynomial (Fin n) K,
        (∀ j, (G j).IsHomogeneous N) ∧
          (r ∈ 𝔞 ^ N → r - ∑ j, MvPolynomial.aeval z (G j) * b j ∈ 𝔞 ^ (N + 1)) := by
      intro N r
      by_cases hr : r ∈ 𝔞 ^ N
      · obtain ⟨G, hGh, hG⟩ := hstep N r hr
        exact ⟨G, hGh, fun _ => hG⟩
      · exact ⟨0, fun j => MvPolynomial.isHomogeneous_zero _ _ _, fun h => absurd h hr⟩
    choose Gc hGch hGc using hstep'
    let rs : ℕ → B := fun N =>
      Nat.rec y (fun k r => r - ∑ j, MvPolynomial.aeval z (Gc k r j) * b j) N
    let G : ℕ → Fin s → MvPolynomial (Fin n) K := fun k => Gc k (rs k)
    have hrsS : ∀ k, rs (k + 1) = rs k - ∑ j, MvPolynomial.aeval z (G k j) * b j :=
      fun k => rfl
    have hrsmem : ∀ N, rs N ∈ 𝔞 ^ N := by
      intro N
      induction N with
      | zero => rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
      | succ k ih => rw [hrsS]; exact hGc k (rs k) ih
    have hGh : ∀ k j, (G k j).IsHomogeneous k := fun k j => hGch k (rs k) j
    let F : Fin s → MvPowerSeries (Fin n) K := fun j α => (G α.degree j).coeff α
    have htrunc : ∀ N j, MvPowerSeries.truncTotal N (F j) = ∑ k ∈ Finset.range N, G k j := by
      intro N j
      ext α
      rw [MvPolynomial.coeff_sum]
      have hs : ∑ k ∈ Finset.range N, (G k j).coeff α =
          ∑ k ∈ Finset.range N, if α.degree = k then (G α.degree j).coeff α else 0 := by
        refine Finset.sum_congr rfl (fun k _ => ?_)
        split_ifs with h
        · rw [h]
        · exact (hGh k j).coeff_eq_zero h
      rw [hs, Finset.sum_ite_eq]
      split_ifs with h
      · exact (MvPowerSeries.coeff_truncTotal _ (Finset.mem_range.mp h)).trans rfl
      · exact MvPowerSeries.coeff_truncTotal_eq_zero _
          (not_lt.mp (fun h' => h (Finset.mem_range.mpr h')))
    have htele : ∀ N, y = rs N + ∑ k ∈ Finset.range N, ∑ j, MvPolynomial.aeval z (G k j) * b j := by
      intro N
      induction N with
      | zero => simp only [Finset.range_zero, Finset.sum_empty, add_zero]; rfl
      | succ k ih => rw [Finset.sum_range_succ, hrsS]; rw [← sub_eq_zero] at ih ⊢; rw [← ih]; ring
    refine ⟨F, ?_⟩
    have h0 : y - ∑ j, ψ (F j) * b j = 0 := by
      apply hH.haus
      intro N
      rw [SModEq.sub_mem, sub_zero, hsm]
      have e2 : ∑ k ∈ Finset.range N, ∑ j, MvPolynomial.aeval z (G k j) * b j =
          ∑ j, MvPolynomial.aeval z (MvPowerSeries.truncTotal N (F j)) * b j := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [htrunc, map_sum, Finset.sum_mul]
      have e : y - ∑ j, ψ (F j) * b j = rs N +
          ∑ j, (MvPolynomial.aeval z (MvPowerSeries.truncTotal N (F j)) - L (F j)) * b j := by
        rw [htele N, e2]
        simp only [hψ, sub_mul, Finset.sum_sub_distrib]
        ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.pow_right_mono h𝔞m N (hrsmem N))
        (Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_right _ _ (hL (F j) N)))
    exact sub_eq_zero.mp h0

  have hfin : (ψ : MvPowerSeries (Fin n) K →+* B).Finite := by
    letI := (ψ : MvPowerSeries (Fin n) K →+* B).toAlgebra
    show Module.Finite (MvPowerSeries (Fin n) K) B
    refine ⟨⟨Finset.univ.image b, ?_⟩⟩
    rw [eq_top_iff]
    intro y _
    obtain ⟨F, hF⟩ := hlift y
    rw [hF, Finset.coe_image, Finset.coe_univ, Set.image_univ]
    refine Submodule.sum_mem _ (fun j _ => ?_)
    have : ψ (F j) * b j = F j • b j := by rw [Algebra.smul_def]; rfl
    rw [this]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)

  have hdimInt : ∀ {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S), f.IsIntegral →
      ringKrullDim S ≤ ringKrullDim R := by
    intro R S _ _ f hf
    show Order.krullDim (PrimeSpectrum S) ≤ Order.krullDim (PrimeSpectrum R)
    apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap f)
    intro P Q hPQ
    rw [← PrimeSpectrum.asIdeal_lt_asIdeal] at hPQ ⊢
    obtain ⟨x, hxQ, hxP⟩ := SetLike.exists_of_lt hPQ
    letI := f.toAlgebra
    exact Ideal.under_lt_under_of_integral_mem_sdiff (R := R) hPQ.le ⟨hxQ, hxP⟩ (hf x)

  have hconst : ∀ F : MvPowerSeries (Fin n) K, MvPowerSeries.constantCoeff F = 0 →
      F ∈ Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) K)) := by
    intro F hF
    let T : ℕ → MvPowerSeries (Fin n) K := fun i α =>
      if ∀ j : Fin n, (j : ℕ) < i → α j = 0 then MvPowerSeries.coeff α F else 0
    have hT0 : T 0 = F := by
      ext α
      show (if ∀ j : Fin n, (j : ℕ) < 0 → α j = 0 then MvPowerSeries.coeff α F else 0) = _
      rw [if_pos (fun j hj => absurd hj (Nat.not_lt_zero _))]
    have hTn : T n = 0 := by
      ext α
      show (if ∀ j : Fin n, (j : ℕ) < n → α j = 0 then MvPowerSeries.coeff α F else 0) = _
      rw [map_zero]
      split_ifs with h
      · have hα : α = 0 := Finsupp.ext (fun j => h j j.2)
        rw [hα, MvPowerSeries.coeff_zero_eq_constantCoeff_apply, hF]
      · rfl
    have hD : ∀ i (hi : i < n), T i - T (i + 1) ∈
        Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) K)) := by
      intro i hi
      have hdvd : MvPowerSeries.X (⟨i, hi⟩ : Fin n) ∣ T i - T (i + 1) := by
        rw [MvPowerSeries.X_dvd_iff]
        intro α hα
        rw [map_sub]
        show (if ∀ j : Fin n, (j : ℕ) < i → α j = 0 then MvPowerSeries.coeff α F else 0) -
          (if ∀ j : Fin n, (j : ℕ) < i + 1 → α j = 0 then MvPowerSeries.coeff α F else 0) = 0
        have hiff : (∀ j : Fin n, (j : ℕ) < i → α j = 0) ↔
            (∀ j : Fin n, (j : ℕ) < i + 1 → α j = 0) := by
          constructor
          · intro h j hj
            rcases Nat.lt_succ_iff_lt_or_eq.mp hj with h' | h'
            · exact h j h'
            · have hj' : j = ⟨i, hi⟩ := Fin.ext h'
              rw [hj']
              exact hα
          · intro h j hj
            exact h j (by omega)
        by_cases h : ∀ j : Fin n, (j : ℕ) < i → α j = 0
        · rw [if_pos h, if_pos (hiff.mp h), sub_self]
        · rw [if_neg h, if_neg (fun h' => h (hiff.mpr h')), sub_self]
      obtain ⟨c, hc⟩ := hdvd
      rw [hc]
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨_, rfl⟩)
    have hsum : F = ∑ i ∈ Finset.range n, (T i - T (i + 1)) := by
      rw [Finset.sum_range_sub', hT0, hTn, sub_zero]
    rw [hsum]
    exact Ideal.sum_mem _ (fun i hi => hD i (Finset.mem_range.mp hi))

  have hdimA : ringKrullDim (MvPowerSeries (Fin n) K) ≤ n := by
    have hmA : IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K) =
        Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) K)) := by
      apply le_antisymm
      · intro F hF
        apply hconst
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
          MvPowerSeries.isUnit_iff_constantCoeff] at hF
        by_contra h
        exact hF (Ne.isUnit h)
      · rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        rw [SetLike.mem_coe, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
          MvPowerSeries.isUnit_iff_constantCoeff, MvPowerSeries.constantCoeff_X]
        exact not_isUnit_zero
    have hmem : IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K) ∈
        (Ideal.span ((Finset.univ.image
          (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) K) : Finset _) : Set _)).minimalPrimes := by
      rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, ← hmA,
        Ideal.minimalPrimes_eq_subsingleton_self]
      exact Set.mem_singleton _
    have h1 := Ideal.height_le_card_of_mem_minimalPrimes_span_finset hmem
    have h2 : (Finset.univ.image (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) K)).card ≤ n :=
      Finset.card_image_le.trans (by simp)
    have h3 : (IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K)).height ≤ (n : ℕ∞) :=
      h1.trans (by exact_mod_cast h2)
    rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim]
    exact_mod_cast h3

  have hinj : Function.Injective ψ := by
    by_contra hni
    have hker : RingHom.ker (ψ : MvPowerSeries (Fin n) K →+* B) ≠ ⊥ := fun h =>
      hni ((RingHom.injective_iff_ker_eq_bot _).mpr h)
    obtain ⟨f, hfker, hf0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hker
    have hfnz : f ∈ nonZeroDivisors (MvPowerSeries (Fin n) K) := mem_nonZeroDivisors_of_ne_zero hf0
    have hq : ∀ a ∈ Ideal.span {f}, (ψ : MvPowerSeries (Fin n) K →+* B) a = 0 := by
      intro a ha
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul, RingHom.mem_ker.mp hfker, mul_zero]
    have hcomp' : (Ideal.Quotient.lift (Ideal.span {f}) (ψ : MvPowerSeries (Fin n) K →+* B) hq).comp
        (Ideal.Quotient.mk (Ideal.span {f})) = (ψ : MvPowerSeries (Fin n) K →+* B) :=
      Ideal.Quotient.lift_comp_mk _ _ hq
    have hbarfin : (Ideal.Quotient.lift (Ideal.span {f})
        (ψ : MvPowerSeries (Fin n) K →+* B) hq).Finite :=
      RingHom.Finite.of_comp_finite (by rw [hcomp']; exact hfin)
    have h1 := hdimInt _ (RingHom.IsIntegral.of_finite hbarfin)
    have h2 := ringKrullDim_quotient_succ_le_of_nonZeroDivisor hfnz
    rw [hd] at h1
    have h3 : (n : WithBot ℕ∞) + 1 ≤ n := (add_le_add h1 le_rfl).trans (h2.trans hdimA)
    have h4 : ((n + 1 : ℕ) : WithBot ℕ∞) ≤ ((n : ℕ) : WithBot ℕ∞) := by exact_mod_cast h3
    have h5 : n + 1 ≤ n := by exact_mod_cast h4
    omega
  exact ⟨ψ, hψX, hinj, hfin⟩

theorem wc_plt_hlc_powerseries_normal (K : Type u) [Field K] (n : ℕ) :
    IsDomain (MvPowerSeries (Fin n) K) ∧ IsIntegrallyClosed (MvPowerSeries (Fin n) K) ∧
      IsAdicComplete (IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K))
        (MvPowerSeries (Fin n) K) :=
by
  classical
  have hdom : IsDomain (MvPowerSeries (Fin n) K) := NoZeroDivisors.to_isDomain _

  have star : ∀ f : MvPowerSeries (Fin n) K,
      f ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K) ↔ MvPowerSeries.constantCoeff f = 0 := by
    intro f
    rw [← IsLocalRing.ker_eq_maximalIdeal (MvPowerSeries.constantCoeff (σ := Fin n) (R := K))
      (fun a => ⟨MvPowerSeries.C a, by simp⟩), RingHom.mem_ker]
  have star' : ∀ f : MvPowerSeries (Fin n) K,
      f ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K) ↔ (1 : ℕ∞) ≤ f.order := by
    intro f
    rw [star, Order.one_le_iff_ne_zero, MvPowerSeries.order_ne_zero_iff_constCoeff_eq_zero]

  have s1 : ∀ (k : ℕ) (f : MvPowerSeries (Fin n) K),
      f ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K) ^ k ↔ (k : ℕ∞) ≤ f.order := by
    intro k
    induction k with
    | zero => intro f; simp
    | succ k ih =>
      intro f
      constructor
      · intro hf
        rw [pow_succ] at hf
        refine Submodule.mul_induction_on hf ?_ ?_
        · intro x hx y hy
          have h1 := (ih x).mp hx
          have h2 := (star' y).mp hy
          calc ((k + 1 : ℕ) : ℕ∞) = (k : ℕ∞) + 1 := by push_cast; rfl
            _ ≤ x.order + y.order := add_le_add h1 h2
            _ ≤ (x * y).order := MvPowerSeries.le_order_mul
        · intro x y hx hy
          apply MvPowerSeries.nat_le_order
          intro d hd
          rw [map_add, MvPowerSeries.coeff_of_lt_order (lt_of_lt_of_le (by exact_mod_cast hd) hx),
            MvPowerSeries.coeff_of_lt_order (lt_of_lt_of_le (by exact_mod_cast hd) hy), add_zero]
      · intro hf
        let g : Fin n → MvPowerSeries (Fin n) K := fun i d =>
          if (∀ j : Fin n, j < i → d j = 0) then
            MvPowerSeries.coeff (d + Finsupp.single i 1) f else 0
        have hgc : ∀ i (d : Fin n →₀ ℕ), MvPowerSeries.coeff d (g i) =
            if (∀ j : Fin n, j < i → d j = 0) then
              MvPowerSeries.coeff (d + Finsupp.single i 1) f else 0 := fun _ _ => rfl
        have hg : ∀ i, g i ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K) ^ k := by
          intro i
          rw [ih]
          apply MvPowerSeries.nat_le_order
          intro d hd
          rw [hgc]
          split_ifs
          · apply MvPowerSeries.coeff_of_lt_order
            refine lt_of_lt_of_le ?_ hf
            rw [map_add, Finsupp.degree_single]
            exact_mod_cast Nat.add_lt_add_right hd 1
          · rfl
        have hsum : f = ∑ i, MvPowerSeries.X i * g i := by
          ext e
          rw [map_sum]
          simp only [MvPowerSeries.X_def, MvPowerSeries.coeff_monomial_mul, one_mul]
          by_cases he : e = 0
          · subst he
            rw [Finset.sum_eq_zero]
            · apply MvPowerSeries.coeff_of_lt_order
              refine lt_of_lt_of_le ?_ hf
              simp
            · intro i _
              rw [if_neg]
              rw [Finsupp.single_le_iff]
              simp
          · have hne : e.support.Nonempty := Finsupp.support_nonempty_iff.mpr he
            set i₀ := e.support.min' hne with hi₀
            have hi₀mem : e i₀ ≠ 0 :=
              Finsupp.mem_support_iff.mp (Finset.min'_mem _ hne)
            have hmin : ∀ j, e j ≠ 0 → i₀ ≤ j :=
              fun j hj => Finset.min'_le _ _ (Finsupp.mem_support_iff.mpr hj)
            rw [Finset.sum_eq_single i₀]
            · have hle : Finsupp.single i₀ 1 ≤ e :=
                Finsupp.single_le_iff.mpr (Nat.one_le_iff_ne_zero.mpr hi₀mem)
              rw [if_pos hle, hgc, if_pos, tsub_add_cancel_of_le hle]
              intro j hj
              have h0 : e j = 0 := by
                by_contra h
                exact absurd (hmin j h) (not_le.mpr hj)
              rw [Finsupp.tsub_apply, h0, zero_tsub]
            · intro i _ hi
              split_ifs with h1
              · rw [hgc, if_neg]
                intro hall
                have hei : e i ≠ 0 := by
                  have := Finsupp.single_le_iff.mp h1
                  omega
                have hlt : i₀ < i := lt_of_le_of_ne (hmin i hei) (Ne.symm hi)
                have h2 := hall _ hlt
                rw [Finsupp.tsub_apply] at h2
                have hs : (Finsupp.single i 1 : Fin n →₀ ℕ) i₀ = 0 := by
                  simp [hlt.ne]
                rw [hs, tsub_zero] at h2
                exact hi₀mem h2
              · rfl
            · intro h
              exact absurd (Finset.mem_univ _) h
        rw [hsum, pow_succ']
        refine Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_mul ?_ (hg i))
        rw [star]
        exact MvPowerSeries.constantCoeff_X i

  have hcomp : IsAdicComplete (IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K))
      (MvPowerSeries (Fin n) K) := by
    haveI : IsPrecomplete (IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K))
        (MvPowerSeries (Fin n) K) := by
      refine IsPrecomplete.mk (fun f hf => ?_)
      have hf' : ∀ i j : ℕ, i ≤ j → (i : ℕ∞) ≤ (f i - f j).order := by
        intro i j hij
        have := hf hij
        rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top] at this
        exact (s1 i _).mp this
      let L : MvPowerSeries (Fin n) K := fun d =>
        MvPowerSeries.coeff d (f (Finsupp.degree d + 1))
      refine ⟨L, fun i => ?_⟩
      rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top, s1]
      apply MvPowerSeries.nat_le_order
      intro d hd
      have h1 := hf' (Finsupp.degree d + 1) i (by omega)
      have h2 := MvPowerSeries.coeff_of_lt_order (d := d)
        (lt_of_lt_of_le (by exact_mod_cast Nat.lt_succ_self _) h1)
      rw [map_sub, sub_eq_zero] at h2
      rw [map_sub, sub_eq_zero]
      exact h2.symm
    exact IsAdicComplete.mk

  have s3 : ∀ a b : MvPowerSeries (Fin n) K, (∀ N : ℕ, ∃ q,
      a - b * q ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K) ^ N) → b ∣ a := by
    intro a b h
    have hH : IsHausdorff (IsLocalRing.maximalIdeal (MvPowerSeries (Fin n) K))
        (MvPowerSeries (Fin n) K ⧸ Ideal.span {b}) := inferInstance
    have h0 : Ideal.Quotient.mk (Ideal.span {b}) a = 0 := by
      refine hH.haus _ (fun N => ?_)
      obtain ⟨q, hq⟩ := h N
      rw [SModEq.sub_mem, sub_zero]
      have e1 : Ideal.Quotient.mk (Ideal.span {b}) a =
          (a - b * q) • Ideal.Quotient.mk (Ideal.span {b}) 1 := by
        rw [← Ideal.Quotient.mk_eq_mk, ← Ideal.Quotient.mk_eq_mk, ← Submodule.Quotient.mk_smul,
          smul_eq_mul, mul_one, Ideal.Quotient.mk_eq_mk, Ideal.Quotient.mk_eq_mk,
          Ideal.Quotient.mk_eq_mk_iff_sub_mem, sub_sub_cancel]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self b)
      rw [e1]
      exact Submodule.smul_mem_smul hq Submodule.mem_top
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at h0
    exact h0

  have P2 : ∀ (p : ℕ) (f : MvPowerSeries (Fin n) K), ∃ P : MvPolynomial (Fin n) K,
      (P : MvPowerSeries (Fin n) K) = MvPowerSeries.homogeneousComponent p f := by
    intro p f
    refine ⟨MvPolynomial.homogeneousComponent p
      (MvPowerSeries.trunc' K (Finsupp.equivFunOnFinite.symm (fun _ => p)) f), ?_⟩
    ext d
    rw [MvPolynomial.coeff_coe, MvPolynomial.coeff_homogeneousComponent,
      MvPowerSeries.coeff_trunc', MvPowerSeries.coeff_homogeneousComponent]
    by_cases h1 : Finsupp.degree d = p
    · rw [if_pos h1, if_pos h1, if_pos]
      rw [Finsupp.le_def]
      intro i
      rw [Finsupp.coe_equivFunOnFinite_symm, ← h1]
      exact Finsupp.le_degree i d
    · rw [if_neg h1, if_neg h1]

  have P3 : ∀ Γ B R : MvPolynomial (Fin n) K, Γ ≠ 0 → B ≠ 0 →
      (∀ k : ℕ, ∃ S, Γ * R ^ k = B ^ k * S) → ∃ H, R = B * H := by
    intro Γ B R hΓ hB hS
    have hinj := IsFractionRing.injective (MvPolynomial (Fin n) K)
      (FractionRing (MvPolynomial (Fin n) K))
    have hB' : algebraMap _ (FractionRing (MvPolynomial (Fin n) K)) B ≠ 0 :=
      (map_ne_zero_iff _ hinj).mpr hB
    have hai : IsAlmostIntegral (MvPolynomial (Fin n) K)
        (algebraMap _ (FractionRing (MvPolynomial (Fin n) K)) R /
          algebraMap _ (FractionRing (MvPolynomial (Fin n) K)) B) := by
      refine ⟨Γ, mem_nonZeroDivisors_of_ne_zero hΓ, fun k => ?_⟩
      obtain ⟨S, hS⟩ := hS k
      refine RingHom.mem_range.mpr ⟨S, ?_⟩
      have hBk : algebraMap _ (FractionRing (MvPolynomial (Fin n) K)) B ^ k ≠ 0 :=
        pow_ne_zero _ hB'
      rw [Algebra.smul_def, div_pow, eq_comm, mul_div_assoc', div_eq_iff hBk, ← map_pow,
        ← map_pow, ← map_mul, ← map_mul, hS, mul_comm]
    have hint := (isAlmostIntegral_iff_isIntegral).mp hai
    obtain ⟨H, hH⟩ := (IsIntegrallyClosed.isIntegral_iff).mp hint
    refine ⟨H, hinj ?_⟩
    rw [map_mul, hH, mul_div_cancel₀ _ hB']

  have hc_idem : ∀ (p : ℕ) (f : MvPowerSeries (Fin n) K),
      MvPowerSeries.homogeneousComponent p (MvPowerSeries.homogeneousComponent p f) =
        MvPowerSeries.homogeneousComponent p f := by
    intro p f
    ext d
    simp only [MvPowerSeries.coeff_homogeneousComponent]
    split_ifs <;> rfl
  have ord_nat : ∀ f : MvPowerSeries (Fin n) K, f ≠ 0 → ∃ p : ℕ, f.order = p := by
    intro f hf
    obtain ⟨p, hp⟩ := ENat.ne_top_iff_exists.mp
      (fun h => hf (MvPowerSeries.order_eq_top_iff.mp h))
    exact ⟨p, hp.symm⟩
  have hcmul : ∀ (f g : MvPowerSeries (Fin n) K) (p q : ℕ), f.order = p → g.order = q →
      (f * g).order = ((p + q : ℕ) : ℕ∞) ∧
        MvPowerSeries.homogeneousComponent (p + q) (f * g) =
          MvPowerSeries.homogeneousComponent p f * MvPowerSeries.homogeneousComponent q g := by
    intro f g p q hf hg
    refine ⟨by rw [MvPowerSeries.order_mul, hf, hg, Nat.cast_add],
      MvPowerSeries.homogeneousComponent_mul_of_le_order hf.ge hg.ge⟩
  have ord_one : (1 : MvPowerSeries (Fin n) K).order = ((0 : ℕ) : ℕ∞) := by
    rw [MvPowerSeries.order_eq_nat]
    exact ⟨⟨0, by simp, by simp⟩, fun d hd => absurd hd (Nat.not_lt_zero _)⟩
  have hc_one : MvPowerSeries.homogeneousComponent 0 (1 : MvPowerSeries (Fin n) K) = 1 := by
    ext d
    rw [MvPowerSeries.coeff_homogeneousComponent, MvPowerSeries.coeff_one]
    by_cases hd : d = 0
    · simp [hd]
    · rw [if_neg hd, if_neg]
      rwa [Finsupp.degree_eq_zero_iff]
  have hcpow : ∀ (f : MvPowerSeries (Fin n) K) (p : ℕ), f.order = p → ∀ k : ℕ,
      (f ^ k).order = ((k * p : ℕ) : ℕ∞) ∧
        MvPowerSeries.homogeneousComponent (k * p) (f ^ k) =
          (MvPowerSeries.homogeneousComponent p f) ^ k := by
    intro f p hf k
    induction k with
    | zero =>
      rw [pow_zero, pow_zero, Nat.zero_mul]
      exact ⟨ord_one, hc_one⟩
    | succ k ih =>
      obtain ⟨h1, h2⟩ := hcmul (f ^ k) f (k * p) p ih.1 hf
      rw [pow_succ, add_mul, one_mul, pow_succ, ← ih.2]
      exact ⟨h1, h2⟩
  have B4 : ∀ (p : ℕ) (f : MvPowerSeries (Fin n) K),
      MvPowerSeries.homogeneousComponent p f ≠ 0 →
        (MvPowerSeries.homogeneousComponent p f).order = p := by
    intro p f hf
    rw [MvPowerSeries.order_eq_nat]
    refine ⟨?_, fun d hd => ?_⟩
    · by_contra hcon
      push_neg at hcon
      apply hf
      ext d
      by_contra hne
      rw [map_zero] at hne
      have h1 := hcon d hne
      rw [MvPowerSeries.coeff_homogeneousComponent, if_neg h1] at hne
      exact hne rfl
    · rw [MvPowerSeries.coeff_homogeneousComponent, if_neg (by omega)]

  have s4 : ∀ (t : ℕ) (b c r : MvPowerSeries (Fin n) K), b ≠ 0 → c ≠ 0 →
      (t : ℕ∞) ≤ r.order → (∀ k : ℕ, ∃ s, c * r ^ k = b ^ k * s) →
      ∃ h, ((t + 1 : ℕ) : ℕ∞) ≤ (r - b * h).order := by
    intro t b c r hb hc hr hs
    by_cases hA : ((t + 1 : ℕ) : ℕ∞) ≤ r.order
    · exact ⟨0, by simpa using hA⟩
    have hrt : r.order = t := by
      push_neg at hA
      have hne : r.order ≠ ⊤ := ne_top_of_lt hA
      obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp hne
      rw [← hm] at hA hr ⊢
      have h1 : m < t + 1 := by exact_mod_cast hA
      have h2 : t ≤ m := by exact_mod_cast hr
      exact_mod_cast (by omega : m = t)
    have hr0 : r ≠ 0 := by
      intro h0
      rw [h0, MvPowerSeries.order_zero] at hrt
      exact ENat.top_ne_coe t hrt
    obtain ⟨s₀, hs₀⟩ := ord_nat b hb
    obtain ⟨u, hu⟩ := ord_nat c hc
    obtain ⟨Γ, hΓ⟩ := P2 u c
    obtain ⟨Rp, hRp⟩ := P2 t r
    obtain ⟨Bp, hBp⟩ := P2 s₀ b
    have hΓ0 : Γ ≠ 0 := by
      intro h0
      apply MvPowerSeries.homogeneousComponent_of_order hu.symm
      rw [← hΓ, h0, MvPolynomial.coe_zero]
    have hBp0 : Bp ≠ 0 := by
      intro h0
      apply MvPowerSeries.homogeneousComponent_of_order hs₀.symm
      rw [← hBp, h0, MvPolynomial.coe_zero]
    have hpoly : ∀ k : ℕ, ∃ S, Γ * Rp ^ k = Bp ^ k * S := by
      intro k
      obtain ⟨s, hsk⟩ := hs k
      have hs0 : s ≠ 0 := by
        rintro rfl
        rw [mul_zero] at hsk
        exact mul_ne_zero hc (pow_ne_zero k hr0) hsk
      obtain ⟨v, hv⟩ := ord_nat s hs0
      obtain ⟨S, hS⟩ := P2 v s
      refine ⟨S, MvPolynomial.coe_injective _ _ ?_⟩
      obtain ⟨o1, e1⟩ := hcpow r t hrt k
      obtain ⟨o2, e2⟩ := hcpow b s₀ hs₀ k
      obtain ⟨o3, e3⟩ := hcmul c (r ^ k) u (k * t) hu o1
      obtain ⟨o4, e4⟩ := hcmul (b ^ k) s (k * s₀) v o2 hv
      have hidx : u + k * t = k * s₀ + v := by
        have := o3.symm.trans ((congrArg MvPowerSeries.order hsk).trans o4)
        exact_mod_cast this
      show ((Γ * Rp ^ k : MvPolynomial (Fin n) K) : MvPowerSeries (Fin n) K) =
        ((Bp ^ k * S : MvPolynomial (Fin n) K) : MvPowerSeries (Fin n) K)
      rw [MvPolynomial.coe_mul, MvPolynomial.coe_mul, MvPolynomial.coe_pow, MvPolynomial.coe_pow,
        hΓ, hRp, hBp, hS, ← e1, ← e2, ← e3, ← e4, hsk, hidx]
    obtain ⟨H, hH⟩ := P3 Γ Bp Rp hΓ0 hBp0 hpoly
    have hRH : MvPowerSeries.homogeneousComponent t r =
        MvPowerSeries.homogeneousComponent s₀ b * (H : MvPowerSeries (Fin n) K) := by
      rw [← hRp, ← hBp, hH, MvPolynomial.coe_mul]
    have hrt0 : MvPowerSeries.homogeneousComponent t r ≠ 0 :=
      MvPowerSeries.homogeneousComponent_of_order hrt.symm
    have hbs0 : MvPowerSeries.homogeneousComponent s₀ b ≠ 0 :=
      MvPowerSeries.homogeneousComponent_of_order hs₀.symm
    have e1 : (MvPowerSeries.homogeneousComponent t r).order =
        (MvPowerSeries.homogeneousComponent s₀ b).order +
          (H : MvPowerSeries (Fin n) K).order := by
      rw [hRH, MvPowerSeries.order_mul]
    rw [B4 t r hrt0, B4 s₀ b hbs0] at e1
    have hhtop : (H : MvPowerSeries (Fin n) K).order ≠ ⊤ := by
      intro htop
      rw [htop] at e1
      simp at e1
    obtain ⟨w, hw⟩ := ENat.ne_top_iff_exists.mp hhtop
    rw [← hw] at e1
    have htw : t = s₀ + w := by exact_mod_cast e1
    have hB5 : MvPowerSeries.homogeneousComponent t r =
        MvPowerSeries.homogeneousComponent t (b * (H : MvPowerSeries (Fin n) K)) := by
      have i1 := MvPowerSeries.homogeneousComponent_mul_of_le_order (f := b)
        (g := (H : MvPowerSeries (Fin n) K)) (p := s₀) (q := w) hs₀.ge hw.le
      have i2 := MvPowerSeries.homogeneousComponent_mul_of_le_order
        (f := MvPowerSeries.homogeneousComponent s₀ b)
        (g := (H : MvPowerSeries (Fin n) K)) (p := s₀) (q := w) (B4 s₀ b hbs0).ge hw.le
      rw [hc_idem] at i2
      rw [htw, i1, ← i2, ← hRH, ← htw, hc_idem]
    refine ⟨(H : MvPowerSeries (Fin n) K), ?_⟩
    have hbh : (b * (H : MvPowerSeries (Fin n) K)).order = t := by
      rw [MvPowerSeries.order_mul, hs₀, ← hw, htw, Nat.cast_add]
    apply MvPowerSeries.nat_le_order
    intro d hd
    rw [map_sub, sub_eq_zero]
    by_cases heq : Finsupp.degree d = t
    · have e2 := congrArg (MvPowerSeries.coeff d) hB5
      rw [MvPowerSeries.coeff_homogeneousComponent, MvPowerSeries.coeff_homogeneousComponent,
        if_pos heq, if_pos heq] at e2
      exact e2
    · have hlt : Finsupp.degree d < t := lt_of_le_of_ne (Nat.lt_succ_iff.mp hd) heq
      rw [MvPowerSeries.coeff_of_lt_order (by rw [hrt]; exact_mod_cast hlt),
        MvPowerSeries.coeff_of_lt_order (by rw [hbh]; exact_mod_cast hlt)]

  have hIC : IsIntegrallyClosed (MvPowerSeries (Fin n) K) := by
    rw [isIntegrallyClosed_iff (FractionRing (MvPowerSeries (Fin n) K))]
    intro x hx
    obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (MvPowerSeries (Fin n) K) x
    have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
    have hinj := IsFractionRing.injective (MvPowerSeries (Fin n) K)
      (FractionRing (MvPowerSeries (Fin n) K))
    have hb' : algebraMap _ (FractionRing (MvPowerSeries (Fin n) K)) b ≠ 0 :=
      (map_ne_zero_iff _ hinj).mpr hb0
    have approx : ∀ N : ℕ, ∃ q, (N : ℕ∞) ≤ (a - b * q).order := by
      intro N
      induction N with
      | zero => exact ⟨0, by simp⟩
      | succ N ih =>
        obtain ⟨q, hq⟩ := ih
        have hz : IsIntegral (MvPowerSeries (Fin n) K)
            (algebraMap _ (FractionRing (MvPowerSeries (Fin n) K)) (a - b * q) /
              algebraMap _ (FractionRing (MvPowerSeries (Fin n) K)) b) := by
          have : algebraMap _ (FractionRing (MvPowerSeries (Fin n) K)) (a - b * q) /
              algebraMap _ (FractionRing (MvPowerSeries (Fin n) K)) b =
              algebraMap _ (FractionRing (MvPowerSeries (Fin n) K)) a /
                algebraMap _ (FractionRing (MvPowerSeries (Fin n) K)) b -
              algebraMap _ (FractionRing (MvPowerSeries (Fin n) K)) q := by
            rw [map_sub, map_mul, sub_div, mul_div_cancel_left₀ _ hb']
          rw [this]
          exact hx.sub isIntegral_algebraMap
        obtain ⟨c, hc, hck⟩ := hz.isAlmostIntegral
        have hs : ∀ k : ℕ, ∃ s, c * (a - b * q) ^ k = b ^ k * s := by
          intro k
          obtain ⟨s, hs⟩ := RingHom.mem_range.mp (hck k)
          refine ⟨s, hinj ?_⟩
          rw [Algebra.smul_def, div_pow] at hs
          rw [map_mul, map_mul, map_pow, map_pow, hs]
          field_simp
        have hc0 : c ≠ 0 := nonZeroDivisors.ne_zero hc
        obtain ⟨h, hh⟩ := s4 N b c (a - b * q) hb0 hc0 hq hs
        refine ⟨q + h, ?_⟩
        have : a - b * (q + h) = (a - b * q) - b * h := by ring
        rw [this]
        exact hh
    have hdvd : b ∣ a := s3 a b (fun N => by
      obtain ⟨q, hq⟩ := approx N
      exact ⟨q, (s1 N _).mpr hq⟩)
    obtain ⟨y, rfl⟩ := hdvd
    exact ⟨y, by rw [map_mul, mul_div_cancel_left₀ _ hb']⟩
  exact ⟨hdom, hIC, hcomp⟩

theorem wc_plt_hlc_minpoly_model (A : Type u) [CommRing A] [IsDomain A] [IsIntegrallyClosed A]
    (B : Type u) [CommRing B] [IsDomain B] (ψ : A →+* B) (hψi : Function.Injective ψ)
    (hψf : ψ.Finite) (b : B) :
    ∃ (f : Polynomial A) (φ : AdjoinRoot f →+* B), f.Monic ∧ Function.Injective φ ∧ φ.Finite ∧
      φ (AdjoinRoot.root f) = b ∧ φ.comp (AdjoinRoot.of f) = ψ :=
by
  classical
  letI : Algebra A B := ψ.toAlgebra
  haveI : Module.IsTorsionFree A B :=
    (Module.isTorsionFree_iff_algebraMap_injective).mpr hψi
  have hb : IsIntegral A b := (RingHom.IsIntegral.of_finite hψf) b
  have hroot : Polynomial.eval₂ ψ b (minpoly A b) = 0 := by
    have := minpoly.aeval A b
    rwa [Polynomial.aeval_def] at this
  have hc : (AdjoinRoot.lift ψ b hroot).comp (AdjoinRoot.of (minpoly A b)) = ψ :=
    RingHom.ext fun a => AdjoinRoot.lift_of hroot
  refine ⟨minpoly A b, AdjoinRoot.lift ψ b hroot, minpoly.monic hb, ?_, ?_,
    AdjoinRoot.lift_root hroot, hc⟩
  · rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨g, rfl⟩ := AdjoinRoot.mk_surjective x
    rw [AdjoinRoot.lift_mk] at hx
    have hg : Polynomial.aeval b g = 0 := by rw [Polynomial.aeval_def]; exact hx
    exact AdjoinRoot.mk_eq_zero.mpr (minpoly.isIntegrallyClosed_dvd hb hg)
  · apply RingHom.Finite.of_comp_finite (f := AdjoinRoot.of (minpoly A b))
    rw [hc]
    exact hψf

theorem wc_plt_hlc_finite_complete (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (C : Type u) [CommRing C] [IsLocalRing C] [Algebra A C] [Module.Finite A C]
    [IsLocalHom (algebraMap A C)]
    (hA : IsAdicComplete (IsLocalRing.maximalIdeal A) A) :
    IsAdicComplete (IsLocalRing.maximalIdeal C) C :=
by
  classical

  have s1 : ∀ (R : Type u) [CommRing R] (J : Ideal R) (M : Type u) [AddCommGroup M] [Module R M]
      [Module.Finite R M], IsPrecomplete J R → IsPrecomplete J M := by
    intro R _ J M _ _ _ h
    rw [← AdicCompletion.of_surjective_iff]
    haveI := h
    have hR := AdicCompletion.of_surjective J R
    have key : ∀ (a : R) (x : M), AdicCompletion.of J R a • AdicCompletion.of J M x
        = AdicCompletion.of J M (a • x) := by
      intro a x
      have : AdicCompletion.of J R a = algebraMap R (AdicCompletion J R) a := by
        rw [AdicCompletion.algebraMap_apply]; rfl
      rw [this, algebraMap_smul, LinearMap.map_smul]
    intro y
    obtain ⟨z, rfl⟩ := AdicCompletion.ofTensorProduct_surjective_of_finite J M y
    have hz : AdicCompletion.ofTensorProduct J M z ∈ LinearMap.range (AdicCompletion.of J M) := by
      induction z using TensorProduct.induction_on with
      | zero => rw [map_zero]; exact Submodule.zero_mem _
      | tmul r x =>
        rw [AdicCompletion.ofTensorProduct_tmul]
        obtain ⟨a, rfl⟩ := hR r
        rw [key]
        exact ⟨_, rfl⟩
      | add z w hz hw => rw [map_add]; exact Submodule.add_mem _ hz hw
    exact hz
  haveI : IsNoetherianRing C := IsNoetherianRing.of_finite A C

  have h2 : (IsLocalRing.maximalIdeal A).map (algebraMap A C) ≤ IsLocalRing.maximalIdeal C := by
    rw [Ideal.map_le_iff_le_comap]
    intro a ha
    exact map_nonunit (algebraMap A C) a ha
  have hint : (algebraMap A C).IsIntegral := fun x => (Algebra.IsIntegral.of_finite A C).isIntegral x
  have hrad : IsLocalRing.maximalIdeal C ≤
      ((IsLocalRing.maximalIdeal A).map (algebraMap A C)).radical := by
    rw [Ideal.radical_eq_sInf]
    refine le_sInf ?_
    rintro Q ⟨hIQ, hQ⟩
    have hmQ : IsLocalRing.maximalIdeal A ≤ Q.comap (algebraMap A C) :=
      Ideal.map_le_iff_le_comap.mp hIQ
    have hne : Q.comap (algebraMap A C) ≠ ⊤ := Ideal.comap_ne_top _ hQ.ne_top
    have heq : IsLocalRing.maximalIdeal A = Q.comap (algebraMap A C) :=
      (IsLocalRing.maximalIdeal.isMaximal A).eq_of_le hne hmQ
    haveI := hQ
    have hcm : (Q.comap (algebraMap A C)).IsMaximal := by
      rw [← heq]; exact IsLocalRing.maximalIdeal.isMaximal A
    have hQmax : Q.IsMaximal :=
      Ideal.isMaximal_of_isIntegral_of_isMaximal_comap (algebraMap A C) hint Q hcm
    rw [IsLocalRing.eq_maximalIdeal hQmax]
  obtain ⟨e, h1⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hrad
    (IsNoetherian.noetherian (IsLocalRing.maximalIdeal C))

  have hpA : IsPrecomplete (IsLocalRing.maximalIdeal A) C := s1 A _ C hA.toIsPrecomplete
  have hmem1 : ∀ (k : ℕ) (x : C), x ∈ ((IsLocalRing.maximalIdeal A) ^ k • ⊤ : Submodule A C) ↔
      x ∈ ((IsLocalRing.maximalIdeal A).map (algebraMap A C)) ^ k := by
    intro k x
    rw [Ideal.smul_top_eq_map, Ideal.map_pow, Submodule.restrictScalars_mem]
  have hmem2 : ∀ (k : ℕ) (x : C), x ∈ ((IsLocalRing.maximalIdeal C) ^ k • ⊤ : Submodule C C) ↔
      x ∈ (IsLocalRing.maximalIdeal C) ^ k := by
    intro k x
    rw [Ideal.smul_eq_mul, Ideal.mul_top]
  have hprec : IsPrecomplete (IsLocalRing.maximalIdeal C) C := by
    rw [isPrecomplete_iff]
    intro f hf
    have hf' : ∀ {a b : ℕ}, a ≤ b → f a - f b ∈ (IsLocalRing.maximalIdeal C) ^ a :=
      fun hab => (hmem2 _ _).mp (SModEq.sub_mem.mp (hf hab))
    have hle : ∀ j : ℕ, (IsLocalRing.maximalIdeal C) ^ ((e + 1) * j) ≤
        ((IsLocalRing.maximalIdeal A).map (algebraMap A C)) ^ j := by
      intro j
      rw [pow_mul]
      exact Ideal.pow_right_mono ((Ideal.pow_le_pow_right (Nat.le_succ e)).trans h1) j
    obtain ⟨L, hL⟩ := hpA.prec (f := fun j => f ((e + 1) * j)) (by
      intro a b hab
      rw [SModEq.sub_mem, hmem1]
      exact hle a (hf' (Nat.mul_le_mul_left _ hab)))
    refine ⟨L, fun k => ?_⟩
    rw [SModEq.sub_mem, hmem2]
    have hk : k ≤ (e + 1) * k := by rw [add_mul, one_mul]; omega
    have e1 : f k - f ((e + 1) * k) ∈ (IsLocalRing.maximalIdeal C) ^ k := hf' hk
    have e2 : f ((e + 1) * k) - L ∈ ((IsLocalRing.maximalIdeal A).map (algebraMap A C)) ^ k :=
      (hmem1 _ _).mp (SModEq.sub_mem.mp (hL k))
    have e3 : f ((e + 1) * k) - L ∈ (IsLocalRing.maximalIdeal C) ^ k :=
      Ideal.pow_right_mono h2 k e2
    have e4 := Ideal.add_mem _ e1 e3
    rwa [sub_add_sub_cancel] at e4
  have hH : IsHausdorff (IsLocalRing.maximalIdeal C) C :=
    IsHausdorff.of_isLocalRing _ _ (IsLocalRing.maximalIdeal.isMaximal C).ne_top
  exact { toIsHausdorff := hH, toIsPrecomplete := hprec }

theorem wc_plt_hlc_symbolic_reduction (C : Type u) [CommRing C] [IsDomain C] [IsNoetherianRing C]
    [IsLocalRing C] (hcomp : IsAdicComplete (IsLocalRing.maximalIdeal C) C)
    (Q : Ideal C) [Q.IsPrime] (hQm : Q ≠ IsLocalRing.maximalIdeal C)
    (hQ1 : ∀ Q' : Ideal C, Q'.IsPrime → Q ≤ Q' → Q' = Q ∨ Q' = IsLocalRing.maximalIdeal C)
    (i : ℕ)
    (hext : ∀ J : Ideal C, (∀ a s : C, s ∉ Q → s * a ∈ J → a ∈ J) →
      Limits.IsZero (((Ext C (ModuleCat.{u} C) i).obj
        (Opposite.op (ModuleCat.of C (C ⧸ J)))).obj (ModuleCat.of C C))) :
    Limits.IsZero ((localCohomology Q i).obj (ModuleCat.of C C)) :=
by
  classical
  set m := IsLocalRing.maximalIdeal C with hmdef
  have hQp : Q.IsPrime := inferInstance
  have h1Q : (1 : C) ∉ Q := fun h => hQp.ne_top ((Ideal.eq_top_iff_one Q).mpr h)

  let J : ℕ → Ideal C := fun n =>
    { carrier := {a | ∃ s, s ∉ Q ∧ s * a ∈ Q ^ n}
      add_mem' := by
        rintro a b ⟨s₁, hs₁, h₁⟩ ⟨s₂, hs₂, h₂⟩
        refine ⟨s₁ * s₂, fun h => (hQp.mem_or_mem h).elim hs₁ hs₂, ?_⟩
        have e : s₁ * s₂ * (a + b) = s₂ * (s₁ * a) + s₁ * (s₂ * b) := by ring
        rw [e]
        exact add_mem (Ideal.mul_mem_left _ _ h₁) (Ideal.mul_mem_left _ _ h₂)
      zero_mem' := ⟨1, h1Q, by simp⟩
      smul_mem' := by
        rintro c a ⟨s, hs, h⟩
        refine ⟨s, hs, ?_⟩
        have e : s * (c • a) = c * (s * a) := by rw [smul_eq_mul]; ring
        rw [e]
        exact Ideal.mul_mem_left _ _ h }
  have hJmem : ∀ n a, a ∈ J n ↔ ∃ s, s ∉ Q ∧ s * a ∈ Q ^ n := fun n a => Iff.rfl
  clear_value J

  have hQJ : ∀ n, Q ^ n ≤ J n := fun n a ha => (hJmem n a).mpr ⟨1, h1Q, by rwa [one_mul]⟩

  have hanti : Antitone J := by
    intro n n' hnn' a ha
    obtain ⟨s, hs, h⟩ := (hJmem n' a).mp ha
    exact (hJmem n a).mpr ⟨s, hs, Ideal.pow_le_pow_right hnn' h⟩

  have s5 : ∀ a : C, (∀ n : ℕ, ∃ s : C, s ∉ Q ∧ s * a ∈ Q ^ n) → a = 0 := by
    intro a ha
    let L := Localization.AtPrime Q
    haveI : IsNoetherianRing L := IsLocalization.isNoetherianRing Q.primeCompl L inferInstance
    have hmem : ∀ n, algebraMap C L a ∈ (IsLocalRing.maximalIdeal L) ^ n := by
      intro n
      obtain ⟨s, hs, hsa⟩ := ha n
      have hu : IsUnit (algebraMap C L s) :=
        IsLocalization.map_units L (⟨s, hs⟩ : Q.primeCompl)
      have h1 : algebraMap C L (s * a) ∈ Ideal.map (algebraMap C L) (Q ^ n) :=
        Ideal.mem_map_of_mem _ hsa
      rw [Ideal.map_pow, Localization.AtPrime.map_eq_maximalIdeal, map_mul] at h1
      obtain ⟨v, hv⟩ := hu
      have e : algebraMap C L a = ↑v⁻¹ * (algebraMap C L s * algebraMap C L a) := by
        rw [← hv, ← mul_assoc, Units.inv_mul, one_mul]
      rw [e]
      exact Ideal.mul_mem_left _ _ h1
    have h0 : algebraMap C L a = 0 := by
      have hb := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal L)
        (IsLocalRing.maximalIdeal.isMaximal L).ne_top
      have hm : algebraMap C L a ∈ ⨅ i, (IsLocalRing.maximalIdeal L) ^ i :=
        (Submodule.mem_iInf _).mpr hmem
      rw [hb] at hm
      exact hm
    obtain ⟨u', hu'⟩ := (IsLocalization.map_eq_zero_iff Q.primeCompl L a).mp h0
    have hu0 : (u' : C) ≠ 0 := fun h => u'.2 (h ▸ Q.zero_mem)
    exact (mul_eq_zero.mp hu').resolve_left hu0

  have hbot : ⨅ n, J n = ⊥ := by
    rw [eq_bot_iff]
    intro a ha
    rw [Submodule.mem_iInf] at ha
    rw [Submodule.mem_bot]
    exact s5 a (fun n => (hJmem n a).mp (ha n))

  have hsat : ∀ n a s, s ∉ Q → s * a ∈ J n → a ∈ J n := by
    intro n a s hs h
    obtain ⟨s', hs', h'⟩ := (hJmem n _).mp h
    refine (hJmem n a).mpr ⟨s' * s, fun h => (hQp.mem_or_mem h).elim hs' hs, ?_⟩
    rw [mul_assoc]
    exact h'

  have hE : ∀ n, Limits.IsZero (((Ext C (ModuleCat.{u} C) i).obj
      (Opposite.op (ModuleCat.of C (C ⧸ J n)))).obj (ModuleCat.of C C)) :=
    fun n => hext (J n) (hsat n)

  have s3 : ∀ I : Ideal C, ⨅ j : ℕ, (I ⊔ m ^ j) = I := by
    intro I
    apply le_antisymm
    · intro x hx
      rw [Submodule.mem_iInf] at hx
      have h0 := Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (M := C ⧸ I) m
        (IsLocalRing.maximalIdeal.isMaximal C).ne_top
      have hmem : (Submodule.Quotient.mk x : C ⧸ I) ∈
          ⨅ j : ℕ, m ^ j • (⊤ : Submodule C (C ⧸ I)) := by
        rw [Submodule.mem_iInf]
        intro j
        obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp (hx j)
        have e : (Submodule.Quotient.mk (y + z) : C ⧸ I) = z • Submodule.Quotient.mk 1 := by
          rw [Submodule.Quotient.mk_add, (Submodule.Quotient.mk_eq_zero I).mpr hy, zero_add,
            ← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one]
        rw [e]
        exact Submodule.smul_mem_smul hz Submodule.mem_top
      rw [h0, Submodule.mem_bot, Submodule.Quotient.mk_eq_zero] at hmem
      exact hmem
    · exact le_iInf fun j => le_sup_left

  have s4 : ∀ (I : ℕ → Ideal C), Antitone I → ∀ j : ℕ,
      ∃ N, ∀ n, N ≤ n → I n ⊔ m ^ j = I N ⊔ m ^ j := by
    intro I hI j
    rcases Nat.eq_zero_or_pos j with hj0 | hj
    · refine ⟨0, fun n _ => ?_⟩
      rw [hj0, pow_zero, Ideal.one_eq_top, sup_top_eq, sup_top_eq]
    have hmin : m ∈ (m ^ j).minimalPrimes := by
      refine ⟨⟨(IsLocalRing.maximalIdeal.isMaximal C).isPrime, Ideal.pow_le_self hj.ne'⟩, ?_⟩
      rintro p ⟨hp, hpj⟩ _
      exact @Ideal.IsPrime.le_of_pow_le _ _ _ _ hp _ hpj
    haveI := IsLocalRing.quotient_artinian_of_mem_minimalPrimes_of_isLocalRing _ hmin
    let π := Ideal.Quotient.mk (m ^ j)
    let f : ℕ →o (Ideal (C ⧸ m ^ j))ᵒᵈ :=
      ⟨fun n => OrderDual.toDual (Ideal.map π (I n)), fun a b hab => Ideal.map_mono (hI hab)⟩
    obtain ⟨N, hN⟩ := IsArtinian.monotone_stabilizes f
    have e : ∀ k, Ideal.comap π (Ideal.map π (I k)) = I k ⊔ m ^ j := fun k => by
      rw [Ideal.comap_map_of_surjective' π Ideal.Quotient.mk_surjective, Ideal.mk_ker]
    refine ⟨N, fun n hn => ?_⟩
    have h : Ideal.map π (I N) = Ideal.map π (I n) := hN n hn
    rw [← e n, ← e N, h]

  have chev : ∀ (I : ℕ → Ideal C), Antitone I → (∀ n, ⨅ j : ℕ, (I n ⊔ m ^ j) = I n) →
      (∀ j, ∃ N, ∀ n, N ≤ n → I n ⊔ m ^ j = I N ⊔ m ^ j) → ⨅ n, I n = ⊥ →
      ∀ k, ∃ n, I n ≤ m ^ k := by
    intro I hI hclosed hstab hIbot k
    choose N hN using hstab
    set L : ℕ → Ideal C := fun j => I (N j) ⊔ m ^ j with hL
    have ha : ∀ j n, L j ≤ I n ⊔ m ^ j := by
      intro j n
      rcases le_total n (N j) with h | h
      · exact sup_le_sup_right (hI h) _
      · rw [hN j n h]
    have hb : ∀ j, L j ≤ L (j + 1) ⊔ m ^ j := by
      intro j
      have h1 : L (j + 1) = I (max (N j) (N (j + 1))) ⊔ m ^ (j + 1) :=
        (hN (j + 1) _ (le_max_right _ _)).symm
      have h2 : L j = I (max (N j) (N (j + 1))) ⊔ m ^ j :=
        (hN j _ (le_max_left _ _)).symm
      rw [h1, h2]
      exact sup_le (le_sup_left.trans le_sup_left) le_sup_right
    by_contra hcon
    push_neg at hcon
    obtain ⟨a₀, ha₀I, ha₀m⟩ := SetLike.not_le_iff_exists.mp (hcon (N k))
    have step : ∀ j x, x ∈ L (j + k) → ∃ y, y ∈ L (j + k + 1) ∧ x - y ∈ m ^ (j + k) := by
      intro j x hx
      obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp (hb (j + k) hx)
      exact ⟨y, hy, by rwa [add_sub_cancel_left]⟩
    choose! nxt hnxt1 hnxt2 using step
    let b : ℕ → C := fun j => Nat.rec a₀ (fun j x => nxt j x) j
    have hb0 : b 0 = a₀ := rfl
    have hbs : ∀ j, b (j + 1) = nxt j (b j) := fun j => rfl
    clear_value b
    have hbL : ∀ j, b j ∈ L (j + k) := by
      intro j
      induction j with
      | zero =>
        rw [hb0, zero_add]
        exact Ideal.mem_sup_left ha₀I
      | succ j ih =>
        rw [hbs, show j + 1 + k = j + k + 1 by omega]
        exact hnxt1 j (b j) ih
    have hdiff : ∀ j, b j - b (j + 1) ∈ m ^ (j + k) := fun j => by
      rw [hbs]; exact hnxt2 j (b j) (hbL j)
    have htel : ∀ p q, p ≤ q → b p - b q ∈ m ^ (p + k) := by
      intro p q hpq
      induction q, hpq using Nat.le_induction with
      | base => rw [sub_self]; exact Submodule.zero_mem _
      | succ q hpq ih =>
        have e : b p - b (q + 1) = (b p - b q) + (b q - b (q + 1)) := by ring
        rw [e]
        exact add_mem ih (Ideal.pow_le_pow_right (by omega) (hdiff q))
    have hsm : ∀ p, (m ^ p • ⊤ : Submodule C C) = m ^ p := fun p => by
      rw [Ideal.smul_eq_mul, Ideal.mul_top]
    obtain ⟨ℓ, hℓ⟩ := hcomp.toIsPrecomplete.prec (f := b) (fun {p q} hpq => by
      rw [SModEq.sub_mem, hsm]
      exact Ideal.pow_le_pow_right (by omega) (htel p q hpq))
    have hℓ' : ∀ n, b n - ℓ ∈ m ^ n := fun n => by
      have := (SModEq.sub_mem).mp (hℓ n)
      rwa [hsm] at this
    have hℓI : ∀ n, ℓ ∈ I n := by
      intro n
      rw [← hclosed n, Submodule.mem_iInf]
      intro j
      have h1 : b j ∈ I n ⊔ m ^ j :=
        (sup_le_sup_left (Ideal.pow_le_pow_right (show j ≤ j + k by omega) : m ^ (j + k) ≤ m ^ j)
          (I n)) (ha (j + k) n (hbL j))
      have e : ℓ = b j - (b j - ℓ) := by ring
      rw [e]
      exact sub_mem h1 (Ideal.mem_sup_right (hℓ' j))
    have hℓ0 : ℓ = 0 := by
      have : ℓ ∈ ⨅ n, I n := (Submodule.mem_iInf _).mpr hℓI
      rw [hIbot, Submodule.mem_bot] at this
      exact this
    apply ha₀m
    have e : a₀ = (b 0 - b k) + (b k - ℓ) + ℓ := by rw [hb0]; ring
    have h1 := htel 0 k (Nat.zero_le k)
    rw [zero_add] at h1
    rw [e]
    refine add_mem (add_mem h1 (hℓ' k)) ?_
    rw [hℓ0]
    exact Submodule.zero_mem _

  have s6 : ∀ t : ℕ, ∃ K : ℕ, ∀ a : C, a ∈ J t → a ∈ m ^ K → a ∈ Q ^ t := by
    intro t
    obtain ⟨G, hG⟩ := IsNoetherian.noetherian (J t)
    have hGJ : ∀ g ∈ G, ∃ s, s ∉ Q ∧ s * g ∈ Q ^ t := fun g hg => by
      have h := Submodule.subset_span (R := C) (s := (G : Set C)) hg
      rw [hG] at h
      exact (hJmem t g).mp h
    choose! sg hsgQ hsg using hGJ
    set s₀ := ∏ g ∈ G, sg g with hs₀
    have hs₀Q : s₀ ∉ Q := by
      rw [hs₀, Ideal.IsPrime.prod_mem_iff]
      rintro ⟨g, hg, h⟩
      exact hsgQ g hg h
    have hs₀J : ∀ a ∈ J t, s₀ * a ∈ Q ^ t := by
      intro a ha
      rw [← hG] at ha
      induction ha using Submodule.span_induction with
      | mem g hg =>
        have e : s₀ * g = (∏ x ∈ G.erase g, sg x) * (sg g * g) := by
          rw [hs₀, ← Finset.mul_prod_erase G sg hg]; ring
        rw [e]
        exact Ideal.mul_mem_left _ _ (hsg g hg)
      | zero => rw [mul_zero]; exact Submodule.zero_mem _
      | add x y _ _ hx hy => rw [mul_add]; exact add_mem hx hy
      | smul c x _ hx =>
        have e : s₀ * (c • x) = c * (s₀ * x) := by rw [smul_eq_mul]; ring
        rw [e]
        exact Ideal.mul_mem_left _ _ hx
    have hrad : m ≤ (Q ^ t ⊔ Ideal.span {s₀}).radical := by
      rw [Ideal.radical_eq_sInf]
      refine le_sInf ?_
      rintro p ⟨hHp, hp⟩
      have hQp' : Q ≤ p := @Ideal.IsPrime.le_of_pow_le _ _ _ _ hp _ (le_sup_left.trans hHp)
      rcases hQ1 p hp hQp' with h | h
      · exfalso
        apply hs₀Q
        rw [← h]
        exact hHp (Ideal.mem_sup_right (Ideal.mem_span_singleton_self s₀))
      · exact h.ge
    obtain ⟨e, he⟩ := Ideal.exists_pow_le_of_le_radical_of_fg hrad (IsNoetherian.noetherian m)
    have hkill : ∀ x ∈ m ^ e, ∀ a ∈ J t, x * a ∈ Q ^ t := by
      intro x hx a ha
      obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp (he hx)
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hz
      have e' : (y + c * s₀) * a = a * y + c * (s₀ * a) := by ring
      rw [e']
      exact add_mem (Ideal.mul_mem_left _ _ hy) (Ideal.mul_mem_left _ _ (hs₀J a ha))
    let T : Submodule C (C ⧸ Q ^ t) := Submodule.map (Q ^ t).mkQ (J t)
    obtain ⟨c, hc⟩ := Ideal.exists_pow_inf_eq_pow_smul m T
    refine ⟨e + c, fun a ha ham => ?_⟩
    have hT : (Q ^ t).mkQ a ∈ T := Submodule.mem_map_of_mem ha
    have hM : (Q ^ t).mkQ a ∈ m ^ (e + c) • (⊤ : Submodule C (C ⧸ Q ^ t)) := by
      have e' : (Q ^ t).mkQ a = a • (Q ^ t).mkQ 1 := by
        rw [← LinearMap.map_smul, smul_eq_mul, mul_one]
      rw [e']
      exact Submodule.smul_mem_smul ham Submodule.mem_top
    have h1 : (Q ^ t).mkQ a ∈ m ^ e • T := by
      have h2 : (Q ^ t).mkQ a ∈ m ^ (e + c) • (⊤ : Submodule C (C ⧸ Q ^ t)) ⊓ T := ⟨hM, hT⟩
      rw [hc (e + c) (Nat.le_add_left c e), Nat.add_sub_cancel] at h2
      exact Submodule.smul_mono le_rfl inf_le_right h2
    have h3 : m ^ e • T ≤ ⊥ := by
      rw [Submodule.smul_le]
      intro r hr n hn
      obtain ⟨b, hb, rfl⟩ := Submodule.mem_map.mp hn
      rw [← LinearMap.map_smul, Submodule.mem_bot, Submodule.mkQ_apply,
        Submodule.Quotient.mk_eq_zero, smul_eq_mul]
      exact hkill r hr b hb
    have h4 := h3 h1
    rw [Submodule.mem_bot, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h4
    exact h4

  have hcof : ∀ t, ∃ n, J n ≤ Q ^ t := by
    intro t
    obtain ⟨K, hK⟩ := s6 t
    obtain ⟨n₀, hn₀⟩ := chev J hanti (fun n => s3 (J n)) (s4 J hanti) hbot K
    refine ⟨max n₀ t, fun a ha => hK a (hanti (le_max_right _ _) ha)
      (hn₀ (hanti (le_max_left _ _) ha))⟩

  have vanish : (∀ (t : ℕ) (y : ↑(((Ext C (ModuleCat.{u} C) i).obj
        (Opposite.op (ModuleCat.of C (C ⧸ Q ^ t)))).obj (ModuleCat.of C C))),
      ∃ (t' : ℕ) (ht : t ≤ t'),
        (((Ext C (ModuleCat.{u} C) i).map
          (ModuleCat.ofHom (Submodule.factor (Ideal.pow_le_pow_right ht : Q ^ t' ≤ Q ^ t))).op).app
            (ModuleCat.of C C)).hom y = 0) →
      Limits.IsZero ((localCohomology Q i).obj (ModuleCat.of C C)) := by
    intro H
    have := Limits.preservesFilteredColimitsOfSize_of_univLE.{u, u, 0, 0}
      (forget (ModuleCat.{u} C))
    have e := Limits.colimitObjIsoColimitCompEvaluation
      (localCohomology.diagram (localCohomology.idealPowersDiagram Q) i) (ModuleCat.of C C)
    change Limits.IsZero ((Limits.colimit
      (localCohomology.diagram (localCohomology.idealPowersDiagram Q) i)).obj (ModuleCat.of C C))
    rw [e.isZero_iff, ModuleCat.isZero_iff_subsingleton]
    let F : ℕᵒᵖᵒᵖ ⥤ ModuleCat.{u} C :=
      localCohomology.diagram (localCohomology.idealPowersDiagram Q) i ⋙
        (evaluation (ModuleCat.{u} C) (ModuleCat.{u} C)).obj (ModuleCat.of C C)
    haveI : Limits.PreservesColimit F (forget (ModuleCat.{u} C)) := inferInstance
    change Subsingleton ↑(Limits.colimit F)
    have hall : ∀ x : ↑(Limits.colimit F), x = 0 := by
      intro x
      obtain ⟨j, y, rfl⟩ := Limits.Concrete.colimit_exists_rep F x
      rcases j with ⟨⟨t⟩⟩
      obtain ⟨t', ht, hy⟩ := H t y
      rw [← Limits.colimit.w_apply F (homOfLE ht).op.op y]
      have hy' : (ConcreteCategory.hom (F.map (homOfLE ht).op.op)) y = 0 := hy
      rw [hy', map_zero]
    exact ⟨fun x y => (hall x).trans (hall y).symm⟩
  apply vanish
  intro t y
  obtain ⟨n, hn⟩ := hcof t
  refine ⟨max n t, le_max_right _ _, ?_⟩
  have h1 : Q ^ (max n t) ≤ J n := (Ideal.pow_le_pow_right (le_max_left _ _)).trans (hQJ n)
  have hfac : ModuleCat.ofHom (Submodule.factor
      (Ideal.pow_le_pow_right (le_max_right n t) : Q ^ max n t ≤ Q ^ t)) =
      ModuleCat.ofHom (Submodule.factor h1) ≫ ModuleCat.ofHom (Submodule.factor hn) := by
    rw [← ModuleCat.ofHom_comp, Submodule.factor_comp]
  rw [hfac, op_comp, Functor.map_comp, NatTrans.comp_app, ModuleCat.hom_comp,
    LinearMap.comp_apply]
  have hz : (((Ext C (ModuleCat.{u} C) i).map (ModuleCat.ofHom (Submodule.factor hn)).op).app
      (ModuleCat.of C C)).hom y = 0 := by
    haveI := ModuleCat.isZero_iff_subsingleton.mp (hE n)
    exact Subsingleton.elim _ _
  rw [hz, map_zero]

theorem wc_plt_hlc_hypersurface_ext (A : Type u) [CommRing A] (f : Polynomial A) (hf : f.Monic)
    (M : ModuleCat.{u} (AdjoinRoot f)) (i : ℕ)
    (h : Limits.IsZero (((Ext A (ModuleCat.{u} A) i).obj
      (Opposite.op ((ModuleCat.restrictScalars (algebraMap A (AdjoinRoot f))).obj M))).obj
        (ModuleCat.of A A))) :
    Limits.IsZero (((Ext (AdjoinRoot f) (ModuleCat.{u} (AdjoinRoot f)) i).obj
      (Opposite.op M)).obj (ModuleCat.of (AdjoinRoot f) (AdjoinRoot f))) :=
by
  classical

  have s5 : ∀ (R : Type u) [CommRing R] (X Y : ModuleCat.{u} R) (n : ℕ),
      Limits.IsZero (((Ext R (ModuleCat.{u} R) n).obj (Opposite.op X)).obj Y) ↔
        ∀ x : Abelian.Ext X Y n, x = 0 := by
    intro R _ X Y n
    have capp : ∀ {M N Q : ModuleCat.{u} R} (f : M ⟶ N) (g : N ⟶ Q) (x : M),
        (f ≫ g).hom x = g.hom (f.hom x) := fun _ _ _ => rfl
    have s1 : ∀ {Z G H : Type u} [AddCommGroup Z] [AddCommGroup G] [AddCommGroup H]
        (Ψ : Z →+ G) (Φ : Z →+ H), Function.Surjective Ψ → Function.Surjective Φ →
        (∀ z, Ψ z = 0 ↔ Φ z = 0) → ∃ e : G ≃+ H, ∀ z, e (Ψ z) = Φ z := by
      intro Z G H _ _ _ Ψ Φ hΨ hΦ hker
      have hk : Ψ.ker = Φ.ker := by ext z; simp [AddMonoidHom.mem_ker, hker]
      refine ⟨((QuotientAddGroup.quotientKerEquivOfSurjective Ψ hΨ).symm.trans
        (QuotientAddGroup.quotientAddEquivOfEq hk)).trans
        (QuotientAddGroup.quotientKerEquivOfSurjective Φ hΦ), fun z => ?_⟩
      have h1 : (QuotientAddGroup.quotientKerEquivOfSurjective Ψ hΨ).symm (Ψ z) =
          (z : Z ⧸ Ψ.ker) := by
        rw [AddEquiv.symm_apply_eq]; rfl
      simp only [AddEquiv.trans_apply, h1]
      rfl
    have hext : ∀ (P : ProjectiveResolution X) (φ φ' : P.complex.X n ⟶ Y)
        (_ : φ = φ') (hφ : P.complex.d (n + 1) n ≫ φ = 0) (hφ' : P.complex.d (n + 1) n ≫ φ' = 0),
        P.extMk φ (n + 1) rfl hφ = P.extMk φ' (n + 1) rfl hφ' := by
      intro P φ φ' h hφ hφ'; subst h; rfl
    have s2 : ∀ (P : ProjectiveResolution X) (φ ψ : P.complex.X n ⟶ Y)
        (hφ : P.complex.d (n + 1) n ≫ φ = 0) (hψ : P.complex.d (n + 1) n ≫ ψ = 0)
        (hφψ : P.complex.d (n + 1) n ≫ (φ + ψ) = 0),
        P.extMk (φ + ψ) (n + 1) rfl hφψ = P.extMk φ (n + 1) rfl hφ + P.extMk ψ (n + 1) rfl hψ := by
      intro P φ ψ hφ hψ hφψ
      apply P.extEquivCohomologyClass.injective
      rw [ProjectiveResolution.extEquivCohomologyClass_add,
        ProjectiveResolution.extEquivCohomologyClass_extMk,
        ProjectiveResolution.extEquivCohomologyClass_extMk,
        ProjectiveResolution.extEquivCohomologyClass_extMk,
        ← CochainComplex.HomComplex.CohomologyClass.mk_add,
        ← CochainComplex.HomComplex.Cocycle.toSingleMk_add]
      congr 1
    have s3 : ∀ (P : ProjectiveResolution X) (φ : P.complex.X n ⟶ Y)
        (hφ : P.complex.d (n + 1) n ≫ φ = 0),
        P.extMk φ (n + 1) rfl hφ = 0 ↔
          ∃ g : P.complex.X (n - 1) ⟶ Y, P.complex.d n (n - 1) ≫ g = φ := by
      intro P φ hφ
      cases n with
      | succ p => exact P.extMk_eq_zero_iff φ (p + 1 + 1) rfl hφ p rfl
      | zero =>
        have hd : P.complex.d 0 (0 - 1) = 0 := P.complex.shape _ _ (by simp)
        constructor
        · intro h
          refine ⟨0, ?_⟩
          rw [hd, Limits.zero_comp]
          have h2 := congrArg P.extEquivCohomologyClass h
          rw [ProjectiveResolution.extEquivCohomologyClass_extMk] at h2
          have h0 : P.extEquivCohomologyClass (0 : Abelian.Ext X Y 0) = 0 := by
            rw [← ProjectiveResolution.extAddEquivCohomologyClass_apply, map_zero]
          rw [h0, CochainComplex.HomComplex.CohomologyClass.mk_eq_zero_iff,
            CochainComplex.HomComplex.Cocycle.toSingleMk_mem_coboundaries_iff _ _ _ _ _ 1
              (by simp)] at h2
          obtain ⟨g, hg⟩ := h2
          have hz : Limits.IsZero (P.cochainComplex.X 1) :=
            HomologicalComplex.isZero_extend_X _ _ _ (fun i => by
              rw [ComplexShape.embeddingDownNat_f]; omega)
          rw [hz.eq_of_src g 0, Limits.comp_zero] at hg
          exact ((cancel_epi _).mp (by rw [Limits.comp_zero]; exact hg))
        · rintro ⟨g, hg⟩
          rw [hd, Limits.zero_comp] at hg
          subst hg
          exact P.extMk_zero _ _
    have dapp : ∀ (P : ProjectiveResolution X) (i j : ℕ)
        (φ : P.complex.X i ⟶ Y),
        ((P.complex.linearYonedaObj R Y).d i j).hom φ = P.complex.d j i ≫ φ := by
      intro P i j φ
      rw [ChainComplex.linearYonedaObj_d]; rfl
    have hprev : (ComplexShape.up ℕ).prev n = n - 1 := by
      cases n with
      | zero => exact ComplexShape.prev_eq_self _ _ (by simp)
      | succ k =>
        rw [Nat.add_sub_cancel]
        exact ComplexShape.prev_eq' _ (by simp)
    have hcyc : ∀ (P : ProjectiveResolution X)
        (z : ↑((P.complex.linearYonedaObj R Y).cycles n)),
        P.complex.d (n + 1) n ≫ ((P.complex.linearYonedaObj R Y).iCycles n).hom z = 0 := by
      intro P z
      have h1 := (dapp P n (n + 1) (((P.complex.linearYonedaObj R Y).iCycles n).hom z)).symm
      rw [h1, ← capp, HomologicalComplex.iCycles_d]; rfl
    have main : ∀ (P : ProjectiveResolution X),
        Nonempty (↑(((Ext R (ModuleCat.{u} R) n).obj (Opposite.op X)).obj Y) ≃+
          Abelian.Ext X Y n) := by
      intro P
      have hi : Function.Injective ((P.complex.linearYonedaObj R Y).iCycles n).hom :=
        (ModuleCat.mono_iff_injective _).mp inferInstance
      have hπs : Function.Surjective ((P.complex.linearYonedaObj R Y).homologyπ n).hom :=
        (ModuleCat.epi_iff_surjective _).mp inferInstance
      have hlift : ∀ φ : P.complex.X n ⟶ Y, P.complex.d (n + 1) n ≫ φ = 0 →
          ∃ z, ((P.complex.linearYonedaObj R Y).iCycles n).hom z = φ := by
        intro φ hφ
        have hS := (ShortComplex.mk ((P.complex.linearYonedaObj R Y).iCycles n)
          ((P.complex.linearYonedaObj R Y).d n (n + 1))
          ((P.complex.linearYonedaObj R Y).iCycles_d n (n + 1))).exact_of_f_is_kernel
          ((P.complex.linearYonedaObj R Y).cyclesIsKernel n (n + 1) (CochainComplex.next ℕ n))
        rw [ShortComplex.moduleCat_exact_iff] at hS
        exact hS φ ((dapp P n (n + 1) φ).trans hφ)
      have hker : ∀ z : ↑((P.complex.linearYonedaObj R Y).cycles n),
          ((P.complex.linearYonedaObj R Y).homologyπ n).hom z = 0 ↔
            ∃ g : P.complex.X (n - 1) ⟶ Y,
              P.complex.d n (n - 1) ≫ g = ((P.complex.linearYonedaObj R Y).iCycles n).hom z := by
        intro z
        constructor
        · intro hz
          have hS := (ShortComplex.mk ((P.complex.linearYonedaObj R Y).toCycles (n - 1) n)
            ((P.complex.linearYonedaObj R Y).homologyπ n)
            ((P.complex.linearYonedaObj R Y).toCycles_comp_homologyπ (n - 1) n)).exact_of_g_is_cokernel
            ((P.complex.linearYonedaObj R Y).homologyIsCokernel (n - 1) n hprev)
          rw [ShortComplex.moduleCat_exact_iff] at hS
          obtain ⟨g, hg⟩ := hS z hz
          refine ⟨g, ?_⟩
          have e1 := congrArg (fun h => h.hom g)
            (HomologicalComplex.toCycles_i (P.complex.linearYonedaObj R Y) (n - 1) n)
          have e2 : ((P.complex.linearYonedaObj R Y).iCycles n).hom
              (((P.complex.linearYonedaObj R Y).toCycles (n - 1) n).hom g) =
              ((P.complex.linearYonedaObj R Y).iCycles n).hom z :=
            congrArg (fun x => ((P.complex.linearYonedaObj R Y).iCycles n).hom x) hg
          exact (dapp P (n - 1) n g).symm.trans (e1.symm.trans e2)
        · rintro ⟨g, hg⟩
          obtain ⟨g', hg'⟩ : ∃ g' : ↑((P.complex.linearYonedaObj R Y).X (n - 1)), g' = g :=
            ⟨g, rfl⟩
          have e1 : ((P.complex.linearYonedaObj R Y).iCycles n).hom
              (((P.complex.linearYonedaObj R Y).toCycles (n - 1) n).hom g') =
              ((P.complex.linearYonedaObj R Y).d (n - 1) n).hom g' :=
            congrArg (fun h => h.hom g')
              (HomologicalComplex.toCycles_i (P.complex.linearYonedaObj R Y) (n - 1) n)
          have e3 : ((P.complex.linearYonedaObj R Y).d (n - 1) n).hom g' =
              ((P.complex.linearYonedaObj R Y).iCycles n).hom z := by
            subst hg'
            exact (dapp P (n - 1) n g').trans hg
          have h1 : ((P.complex.linearYonedaObj R Y).toCycles (n - 1) n).hom g' = z :=
            hi (e1.trans e3)
          rw [← h1]
          exact (congrArg (fun h => h.hom g')
            (HomologicalComplex.toCycles_comp_homologyπ (P.complex.linearYonedaObj R Y) (n - 1) n)).trans
            rfl
      have hinv : ∀ w : ↑((P.complex.linearYonedaObj R Y).homology n),
          (P.isoExt n Y).inv.hom w = 0 ↔ w = 0 := by
        intro w
        constructor
        · intro h
          have h1 : (P.isoExt n Y).hom.hom ((P.isoExt n Y).inv.hom w) = w := by
            rw [← capp, Iso.inv_hom_id]; rfl
          rw [← h1, h, map_zero]
        · rintro rfl; exact map_zero _
      let Ψ' : ↑((P.complex.linearYonedaObj R Y).cycles n) →+
          ↑(((Ext R (ModuleCat.{u} R) n).obj (Opposite.op X)).obj Y) :=
        ((P.isoExt n Y).inv.hom.comp
          ((P.complex.linearYonedaObj R Y).homologyπ n).hom).toAddMonoidHom
      let Φ' : ↑((P.complex.linearYonedaObj R Y).cycles n) →+ Abelian.Ext X Y n :=
        AddMonoidHom.mk' (fun z => P.extMk (((P.complex.linearYonedaObj R Y).iCycles n).hom z)
            (n + 1) rfl (hcyc P z))
          (fun a b => by
            have hab : P.complex.d (n + 1) n ≫
                ((((P.complex.linearYonedaObj R Y).iCycles n).hom a : P.complex.X n ⟶ Y) +
                  (((P.complex.linearYonedaObj R Y).iCycles n).hom b : P.complex.X n ⟶ Y)) = 0 := by
              have h0 := Preadditive.comp_add _ _ _ (P.complex.d (n + 1) n)
                (((P.complex.linearYonedaObj R Y).iCycles n).hom a : P.complex.X n ⟶ Y)
                (((P.complex.linearYonedaObj R Y).iCycles n).hom b : P.complex.X n ⟶ Y)
              rw [hcyc, hcyc, add_zero] at h0
              exact h0
            rw [← s2 P _ _ (hcyc P a) (hcyc P b) hab]
            exact hext P _ _ (map_add _ a b) _ _)
      obtain ⟨e, -⟩ := s1 Ψ' Φ'
        (fun y => by
          obtain ⟨z, hz⟩ := hπs ((P.isoExt n Y).hom.hom y)
          refine ⟨z, ?_⟩
          show (P.isoExt n Y).inv.hom (((P.complex.linearYonedaObj R Y).homologyπ n).hom z) = y
          rw [hz, ← capp, Iso.hom_inv_id]; rfl)
        (fun α => by
          obtain ⟨φ, hφ, hα⟩ := P.extMk_surjective α (n + 1) rfl
          obtain ⟨z, hz⟩ := hlift φ hφ
          refine ⟨z, ?_⟩
          rw [← hα]
          exact hext P _ _ hz (hcyc P z) hφ)
        (fun z => by
          show (P.isoExt n Y).inv.hom (((P.complex.linearYonedaObj R Y).homologyπ n).hom z) = 0 ↔
            P.extMk (((P.complex.linearYonedaObj R Y).iCycles n).hom z) (n + 1) rfl (hcyc P z) = 0
          exact (hinv _).trans ((hker z).trans (s3 P _ (hcyc P z)).symm))
      exact ⟨e⟩
    obtain ⟨e⟩ := main (ProjectiveResolution.of X)
    rw [ModuleCat.isZero_iff_subsingleton]
    constructor
    · intro hs x
      haveI := hs
      rw [← e.apply_symm_apply x, Subsingleton.elim (e.symm x) 0, map_zero]
    · intro H
      exact ⟨fun a b => e.injective ((H _).trans (H _).symm)⟩

  have s3 : ∀ (R : Type u) [CommRing R] (S : ShortComplex (ModuleCat.{u} R)) (_hS : S.ShortExact)
      (_hP : Projective S.X₂) (Y : ModuleCat.{u} R),
      ((∀ x : Abelian.Ext S.X₃ Y 1, x = 0) ↔ ∀ u : S.X₁ ⟶ Y, ∃ v : S.X₂ ⟶ Y, S.f ≫ v = u) ∧
      (∀ n : ℕ, (∀ x : Abelian.Ext S.X₁ Y (n + 1), x = 0) →
        ∀ x : Abelian.Ext S.X₃ Y (n + 2), x = 0) ∧
      (∀ n : ℕ, (∀ x : Abelian.Ext S.X₃ Y (n + 2), x = 0) →
        ∀ x : Abelian.Ext S.X₁ Y (n + 1), x = 0) := by
    intro R _ S hS hP Y
    haveI := hP
    refine ⟨⟨fun H u => ?_, fun H x₃ => ?_⟩, fun n H x₃ => ?_, fun n H x₁ => ?_⟩
    · obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS Y (Abelian.Ext.mk₀ u)
        (show 1 + 0 = 1 from rfl) (H _)
      obtain ⟨v, rfl⟩ := (Abelian.Ext.mk₀_bijective S.X₂ Y).2 x₂
      refine ⟨v, (Abelian.Ext.mk₀_bijective S.X₁ Y).1 ?_⟩
      rw [← hx₂, Abelian.Ext.mk₀_comp_mk₀]
    · obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS Y x₃
        (Abelian.Ext.eq_zero_of_projective _) (show 1 + 0 = 1 from rfl)
      obtain ⟨u, rfl⟩ := (Abelian.Ext.mk₀_bijective S.X₁ Y).2 x₁
      obtain ⟨v, rfl⟩ := H u
      have e1 := Abelian.Ext.comp_assoc hS.extClass (Abelian.Ext.mk₀ S.f) (Abelian.Ext.mk₀ v)
        (show 1 + 0 = 1 from rfl) (show 0 + 0 = 0 from rfl) (show 1 + 0 + 0 = 1 from rfl)
      rw [hS.extClass_comp, Abelian.Ext.zero_comp, Abelian.Ext.mk₀_comp_mk₀] at e1
      rw [← hx₁]
      exact e1.symm
    · obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS Y x₃
        (Abelian.Ext.eq_zero_of_projective _) (show 1 + (n + 1) = n + 2 by omega)
      rw [← hx₁, H x₁, Abelian.Ext.comp_zero]
    · obtain ⟨x₂, hx₂⟩ := Abelian.Ext.contravariant_sequence_exact₁ hS Y x₁
        (show 1 + (n + 1) = n + 2 by omega) (H _)
      rw [← hx₂, Abelian.Ext.eq_zero_of_projective x₂, Abelian.Ext.comp_zero]

  have s1 : ∀ (C : Type u) [CommRing C] [Algebra A C] (pb : PowerBasis A C),
      ∃ τ : C →ₗ[A] A, (∀ x : C, (∀ c : C, τ (c * x) = 0) → x = 0) ∧
        ∀ φ : C →ₗ[A] A, ∃ x : C, ∀ c : C, τ (c * x) = φ c := by
    intro C _ _ pb
    rcases Nat.eq_zero_or_pos pb.dim with h0 | hpos
    · have hsub : ∀ x : C, x = 0 := by
        intro x
        rw [← pb.basis.sum_repr x]
        apply Finset.sum_eq_zero
        intro k _
        exfalso
        have := k.2
        omega
      refine ⟨0, fun x _ => hsub x, fun φ => ⟨0, fun c => ?_⟩⟩
      rw [LinearMap.zero_apply, hsub c, map_zero]
    · set n := pb.dim with hn
      obtain ⟨τ, hτdef⟩ : ∃ τ : C →ₗ[A] A, τ = pb.basis.coord ⟨n - 1, by omega⟩ := ⟨_, rfl⟩
      have hb : ∀ k : Fin n, pb.basis k = pb.gen ^ (k : ℕ) := fun k => by
        rw [PowerBasis.coe_basis]
      have hτ : ∀ m : ℕ, ∀ hm : m < n, τ (pb.gen ^ m) = if m = n - 1 then 1 else 0 := by
        intro m hm
        have e0 : pb.gen ^ m = pb.basis ⟨m, hm⟩ := by rw [hb]
        rw [e0, hτdef, Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]
        by_cases hm' : m = n - 1
        · subst hm'
          simp
        · rw [if_neg, if_neg hm']
          intro hh
          exact hm' (congrArg Fin.val hh)
      obtain ⟨H, hH⟩ : ∃ H : Matrix (Fin n) (Fin n) A,
          ∀ j k, H j k = τ (pb.gen ^ (n - 1 - (j : ℕ)) * pb.gen ^ (k : ℕ)) :=
        ⟨fun j k => τ (pb.gen ^ (n - 1 - (j : ℕ)) * pb.gen ^ (k : ℕ)), fun _ _ => rfl⟩
      have hHut : H.BlockTriangular id := by
        intro j k hjk
        have h1 : (k : ℕ) < (j : ℕ) := hjk
        have h2 := j.2
        rw [hH, ← pow_add, hτ _ (by omega), if_neg (by omega)]
      have hdiag : ∀ j, H j j = 1 := by
        intro j
        have h2 := j.2
        rw [hH, ← pow_add, hτ _ (by omega), if_pos (by omega)]
      have hdet : H.det = 1 := by
        rw [Matrix.det_of_isUpperTriangular hHut]
        simp [hdiag]
      have hunit : IsUnit H.det := by rw [hdet]; exact isUnit_one
      have hc : ∀ (x : C) (j : Fin n),
          τ (pb.gen ^ (n - 1 - (j : ℕ)) * x) = H.mulVec (pb.basis.equivFun x) j := by
        intro x j
        conv_lhs => rw [← pb.basis.sum_equivFun x]
        rw [Finset.mul_sum, map_sum]
        simp only [Matrix.mulVec, dotProduct]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [mul_smul_comm, map_smul, hb k, smul_eq_mul, hH]
        exact mul_comm _ _
      refine ⟨τ, fun x hx => ?_, fun φ => ?_⟩
      · have h1 : H.mulVec (pb.basis.equivFun x) = 0 := by
          funext j
          rw [← hc]
          exact hx _
        have h2 : pb.basis.equivFun x = 0 := by
          rw [← Matrix.one_mulVec (pb.basis.equivFun x), ← Matrix.nonsing_inv_mul H hunit,
            ← Matrix.mulVec_mulVec, h1, Matrix.mulVec_zero]
        rw [← pb.basis.equivFun.symm_apply_apply x, h2, map_zero]
      · obtain ⟨v, hv⟩ : ∃ v : Fin n → A, ∀ j, v j = φ (pb.gen ^ (n - 1 - (j : ℕ))) :=
          ⟨fun j => φ (pb.gen ^ (n - 1 - (j : ℕ))), fun _ => rfl⟩
        refine ⟨pb.basis.equivFun.symm (H⁻¹.mulVec v), fun c => ?_⟩
        have hw : H.mulVec (H⁻¹.mulVec v) = v := by
          rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv H hunit, Matrix.one_mulVec]
        have key : τ ∘ₗ LinearMap.mulRight A (pb.basis.equivFun.symm (H⁻¹.mulVec v)) = φ := by
          apply pb.basis.ext
          intro k
          have hk2 := k.2
          have e3 := hc (pb.basis.equivFun.symm (H⁻¹.mulVec v)) ⟨n - 1 - (k : ℕ), by omega⟩
          rw [LinearEquiv.apply_symm_apply, hw, hv] at e3
          have hj : n - 1 - (n - 1 - (k : ℕ)) = (k : ℕ) := by omega
          simp only [hj] at e3
          rw [LinearMap.comp_apply, LinearMap.mulRight_apply, hb k]
          exact e3
        have e4 := LinearMap.congr_fun key c
        rwa [LinearMap.comp_apply, LinearMap.mulRight_apply] at e4
  obtain ⟨τ, hτ1, hτ2⟩ := s1 (AdjoinRoot f) (AdjoinRoot.powerBasis' hf)
  have huniq : ∀ y y' : AdjoinRoot f, (∀ c, τ (c * y) = τ (c * y')) → y = y' := by
    intro y y' H
    have := hτ1 (y - y') (fun c => by rw [mul_sub, map_sub, H, sub_self])
    exact sub_eq_zero.mp this

  have Φ1 : ∀ (N : ModuleCat.{u} (AdjoinRoot f))
      (u : N ⟶ ModuleCat.of (AdjoinRoot f) (AdjoinRoot f)),
      ∃ h : (ModuleCat.restrictScalars (algebraMap A (AdjoinRoot f))).obj N ⟶ ModuleCat.of A A,
        ∀ p : N, h.hom p = τ (u.hom p) := by
    intro N u
    let φ : ((ModuleCat.restrictScalars (algebraMap A (AdjoinRoot f))).obj N : Type u) →ₗ[A] A :=
      { toFun := fun p => τ (u.hom p)
        map_add' := fun p q => (congrArg τ (map_add u.hom p q)).trans (map_add τ _ _)
        map_smul' := fun a (p : (N : Type u)) => by
          show τ (u.hom ((algebraMap A (AdjoinRoot f) a) • p)) = a • τ (u.hom p)
          rw [map_smul, smul_eq_mul, ← Algebra.smul_def, map_smul] }
    exact ⟨ModuleCat.ofHom (R := A)
      (X := ((ModuleCat.restrictScalars (algebraMap A (AdjoinRoot f))).obj N : Type u))
      (Y := A) φ, fun p => rfl⟩
  have Φ3 : ∀ (N : ModuleCat.{u} (AdjoinRoot f))
      (g₁ g₂ : N ⟶ ModuleCat.of (AdjoinRoot f) (AdjoinRoot f)),
      (∀ p : N, τ (g₁.hom p) = τ (g₂.hom p)) → g₁ = g₂ := by
    intro N g₁ g₂ H
    refine ModuleCat.hom_ext (LinearMap.ext fun p => huniq _ _ fun c => ?_)
    have e1 : (c * g₁.hom p : AdjoinRoot f) = g₁.hom (c • p) := by rw [map_smul, smul_eq_mul]
    have e2 : (c * g₂.hom p : AdjoinRoot f) = g₂.hom (c • p) := by rw [map_smul, smul_eq_mul]
    rw [e1, e2]
    exact H _
  have Φ2 : ∀ (N : ModuleCat.{u} (AdjoinRoot f))
      (h : (ModuleCat.restrictScalars (algebraMap A (AdjoinRoot f))).obj N ⟶ ModuleCat.of A A),
      ∃ g : N ⟶ ModuleCat.of (AdjoinRoot f) (AdjoinRoot f), ∀ p : N, τ (g.hom p) = h.hom p := by
    intro N h
    have hx : ∀ p : N, ∃ y : AdjoinRoot f, ∀ c : AdjoinRoot f, τ (c * y) = h.hom (c • p) := by
      intro p
      obtain ⟨y, hy⟩ := hτ2
        { toFun := fun c => h.hom (c • p)
          map_add' := fun c d =>
            (congrArg h.hom (add_smul c d p)).trans (map_add h.hom (c • p) (d • p))
          map_smul' := fun a c => by
            have e := map_smul h.hom a (show ((ModuleCat.restrictScalars
              (algebraMap A (AdjoinRoot f))).obj N : Type u) from c • p)
            refine Eq.trans ?_ e
            show h.hom ((a • c) • p) = h.hom ((algebraMap A (AdjoinRoot f) a) • (c • p))
            rw [Algebra.smul_def, mul_smul] }
      exact ⟨y, hy⟩
    choose x hx using hx
    have hadd : ∀ p q : N, x (p + q) = x p + x q := fun p q => huniq _ _ fun c => by
      rw [hx, mul_add, map_add, hx, hx, smul_add]
      exact map_add h.hom (c • p) (c • q)
    have hsmul : ∀ (d : AdjoinRoot f) (p : N), x (d • p) = d • x p := fun d p =>
      huniq _ _ fun c => by
        rw [hx, smul_eq_mul, ← mul_assoc, hx, smul_smul]
    let gφ : (N : Type u) →ₗ[AdjoinRoot f] AdjoinRoot f :=
      { toFun := x, map_add' := hadd, map_smul' := hsmul }
    refine ⟨ModuleCat.ofHom gφ, fun p => ?_⟩
    have := hx p 1
    rw [one_mul, one_smul] at this
    exact this

  have s4 : ∀ (M : ModuleCat.{u} (AdjoinRoot f)), ∃ (K P : ModuleCat.{u} (AdjoinRoot f))
      (ι : K ⟶ P) (π : P ⟶ M) (w : ι ≫ π = 0),
      (ShortComplex.mk ι π w).ShortExact ∧ Projective P ∧
        Projective ((ModuleCat.restrictScalars (algebraMap A (AdjoinRoot f))).obj P) := by
    intro M
    let π' : ((M : Type u) →₀ AdjoinRoot f) →ₗ[AdjoinRoot f] (M : Type u) :=
      Finsupp.linearCombination (AdjoinRoot f) (fun m : (M : Type u) => m)
    refine ⟨ModuleCat.of (AdjoinRoot f) (LinearMap.ker π'),
      ModuleCat.of (AdjoinRoot f) ((M : Type u) →₀ AdjoinRoot f),
      ModuleCat.ofHom (LinearMap.ker π').subtype, ModuleCat.ofHom π', ?_, ?_, ?_, ?_⟩
    · ext k
      have hk := LinearMap.mem_ker.mp k.2
      simpa using hk
    · apply ShortComplex.ShortExact.mk'
      · rw [ShortComplex.ShortExact.moduleCat_exact_iff_function_exact]
        exact LinearMap.exact_subtype_ker_map π'
      · exact (ModuleCat.mono_iff_injective _).2 Subtype.val_injective
      · exact (ModuleCat.epi_iff_surjective _).2 fun m => ⟨Finsupp.single m 1, by simp [π']⟩
    · exact ModuleCat.projective_of_free Finsupp.basisSingleOne
    · let pb := AdjoinRoot.powerBasis' hf
      let e : ((M : Type u) →₀ AdjoinRoot f) ≃ₗ[A]
          ((ModuleCat.restrictScalars (algebraMap A (AdjoinRoot f))).obj
            (ModuleCat.of (AdjoinRoot f) ((M : Type u) →₀ AdjoinRoot f)) : Type u) :=
        { toFun := fun x => x
          invFun := fun x => x
          map_add' := fun _ _ => rfl
          map_smul' := fun a x => by
            show a • x = (algebraMap A (AdjoinRoot f) a) • x
            ext m
            simp [Algebra.smul_def]
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl }
      exact ModuleCat.projective_of_free ((Finsupp.basis fun _ : (M : Type u) => pb.basis).map e)

  have Q0 : ∀ (M : ModuleCat.{u} (AdjoinRoot f)),
      (∀ x : Abelian.Ext ((ModuleCat.restrictScalars (algebraMap A (AdjoinRoot f))).obj M)
        (ModuleCat.of A A) 0, x = 0) →
      ∀ x : Abelian.Ext M (ModuleCat.of (AdjoinRoot f) (AdjoinRoot f)) 0, x = 0 := by
    intro M H x
    obtain ⟨u, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x
    obtain ⟨h, hh⟩ := Φ1 M u
    have h0 : h = 0 := (Abelian.Ext.mk₀_bijective _ _).1
      ((H (Abelian.Ext.mk₀ h)).trans (Abelian.Ext.mk₀_zero _ _).symm)
    have hu : u = 0 := Φ3 M u 0 (fun p => by rw [← hh p, h0]; simp; rfl)
    rw [hu, Abelian.Ext.mk₀_zero]
  have Q : ∀ (n : ℕ) (M : ModuleCat.{u} (AdjoinRoot f)),
      (∀ x : Abelian.Ext ((ModuleCat.restrictScalars (algebraMap A (AdjoinRoot f))).obj M)
        (ModuleCat.of A A) (n + 1), x = 0) →
      ∀ x : Abelian.Ext M (ModuleCat.of (AdjoinRoot f) (AdjoinRoot f)) (n + 1), x = 0 := by
    intro n
    induction n with
    | zero =>
      intro M H
      obtain ⟨K, P, ι, π, w, hS, hP, hPA⟩ := s4 M
      have hSA := hS.map_of_exact (ModuleCat.restrictScalars (algebraMap A (AdjoinRoot f)))
      have dC := s3 (AdjoinRoot f) _ hS hP (ModuleCat.of (AdjoinRoot f) (AdjoinRoot f))
      have dA := s3 A _ hSA hPA (ModuleCat.of A A)
      have extA := dA.1.1 H
      refine dC.1.2 (fun u => ?_)
      obtain ⟨h, hh⟩ := Φ1 K u
      obtain ⟨h', hh'⟩ := extA h
      obtain ⟨g, hg⟩ := Φ2 P h'
      refine ⟨g, Φ3 K _ _ (fun k => ?_)⟩
      exact (hg (ι.hom k)).trans ((congrArg
        (fun φ : (ModuleCat.restrictScalars (algebraMap A (AdjoinRoot f))).obj K ⟶
          ModuleCat.of A A => φ.hom k) hh').trans (hh k))
    | succ m ih =>
      intro M H
      obtain ⟨K, P, ι, π, w, hS, hP, hPA⟩ := s4 M
      have hSA := hS.map_of_exact (ModuleCat.restrictScalars (algebraMap A (AdjoinRoot f)))
      have dC := s3 (AdjoinRoot f) _ hS hP (ModuleCat.of (AdjoinRoot f) (AdjoinRoot f))
      have dA := s3 A _ hSA hPA (ModuleCat.of A A)
      exact dC.2.1 m (ih K (dA.2.2 m H))
  have hA := (s5 A _ _ i).1 h
  refine (s5 (AdjoinRoot f) _ _ i).2 ?_
  cases i with
  | zero => exact Q0 M hA
  | succ n => exact Q n M hA

theorem wc_plt_hlc_pd_of_quot_regular : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (x : R) (hxm : x ∈ IsLocalRing.maximalIdeal R) (hxR : IsSMulRegular R x) (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M] (hxM : IsSMulRegular M x) (k : ℕ) (hk : 1 ≤ k) (h : CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of (R ⧸ Ideal.span {x}) (M ⧸ (Ideal.span {x}) • (⊤ : Submodule R M))) k), CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of R M) k :=
by
  classical

  have s1 : ∀ (R : Type u) [CommRing R] (M : Type u) [AddCommGroup M] [Module R M] (s : ℕ)
      (ψ : (Fin s → R) →ₗ[R] M) (hψ : Function.Surjective ψ) (k : ℕ),
      (HasProjectiveDimensionLT (ModuleCat.of R (LinearMap.ker ψ)) k →
        HasProjectiveDimensionLT (ModuleCat.of R M) (k + 1)) ∧
      (1 ≤ k → HasProjectiveDimensionLT (ModuleCat.of R M) (k + 1) →
        HasProjectiveDimensionLT (ModuleCat.of R (LinearMap.ker ψ)) k) := by
    intro R _ M _ _ s ψ hψ k
    let S : ShortComplex (ModuleCat.{u} R) :=
      ShortComplex.mk (ModuleCat.ofHom (LinearMap.ker ψ).subtype) (ModuleCat.ofHom ψ) (by
        ext y; exact y.2)
    have hS : S.ShortExact := by
      apply ShortComplex.ShortExact.mk'
      · rw [ShortComplex.moduleCat_exact_iff]
        intro y hy
        exact ⟨⟨y, hy⟩, rfl⟩
      · rw [ModuleCat.mono_iff_injective]; exact Subtype.val_injective
      · rw [ModuleCat.epi_iff_surjective]; exact hψ
    have hP : Projective (ModuleCat.of R (Fin s → R)) :=
      ModuleCat.projective_of_free (Pi.basisFun R (Fin s))
    have hP1 : HasProjectiveDimensionLT (ModuleCat.of R (Fin s → R)) 1 :=
      projective_iff_hasProjectiveDimensionLT_one.mp hP
    have hPj : ∀ j, 1 ≤ j → HasProjectiveDimensionLT (ModuleCat.of R (Fin s → R)) j :=
      fun j hj => hasProjectiveDimensionLT_of_ge _ 1 j hj
    constructor
    · intro hL
      exact hS.hasProjectiveDimensionLT_X₃ k hL (hPj (k + 1) (by omega))
    · intro hk hM
      exact hS.hasProjectiveDimensionLT_X₁ k (hPj k hk) hM

  have s2 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (x : R)
      (hxm : x ∈ IsLocalRing.maximalIdeal R) (M : Type u) [AddCommGroup M] [Module R M]
      [Module.Finite R M] (hxM : IsSMulRegular M x)
      (hproj : Module.Projective (R ⧸ Ideal.span {x}) (M ⧸ (Ideal.span {x}) • (⊤ : Submodule R M))),
      Module.Projective R M := by
    intro R _ _ _ x hxm M _ _ _ hxM hproj
    set I : Ideal R := Ideal.span {x} with hI
    have hIm : I ≤ IsLocalRing.maximalIdeal R := (Ideal.span_singleton_le_iff_mem _).mpr hxm
    have hIj : I ≤ (⊥ : Ideal R).jacobson := hIm.trans (IsLocalRing.maximalIdeal_le_jacobson ⊥)
    have hItop : I ≠ ⊤ := fun h =>
      (IsLocalRing.maximalIdeal.isMaximal R).ne_top (top_le_iff.mp (h ▸ hIm))
    have : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hItop
    have : IsLocalRing (R ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    have : Module.Free (R ⧸ I) (M ⧸ I • (⊤ : Submodule R M)) := Module.free_of_flat_of_isLocalRing
    let b := Module.Free.chooseBasis (R ⧸ I) (M ⧸ I • (⊤ : Submodule R M))
    have hm : ∀ i, ∃ m : M, (Submodule.Quotient.mk m : M ⧸ I • (⊤ : Submodule R M)) = b i :=
      fun i => Submodule.Quotient.mk_surjective _ (b i)
    choose m hm using hm
    let φ := Fintype.linearCombination R m
    have hq : ∀ c, (Submodule.Quotient.mk (φ c) : M ⧸ I • (⊤ : Submodule R M)) =
        ∑ i, (Ideal.Quotient.mk I (c i)) • b i := by
      intro c
      rw [Fintype.linearCombination_apply]
      show (Submodule.mkQ (I • (⊤ : Submodule R M))) (∑ i, c i • m i) = _
      rw [map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← hm i]; rfl
    have hsurj : Function.Surjective φ := by
      have hle : (⊤ : Submodule R M) ≤ LinearMap.range φ := by
        apply Submodule.le_of_le_smul_of_le_jacobson_bot (I := I) Module.Finite.fg_top hIj
        intro v _
        have ha : ∀ i, ∃ a : R, Ideal.Quotient.mk I a = b.repr (Submodule.Quotient.mk v) i :=
          fun i => Ideal.Quotient.mk_surjective _
        choose a ha using ha
        have h1 : (Submodule.Quotient.mk (v - φ a) : M ⧸ I • (⊤ : Submodule R M)) = 0 := by
          rw [Submodule.Quotient.mk_sub, hq, sub_eq_zero]
          conv_lhs => rw [← b.sum_repr (Submodule.Quotient.mk v)]
          simp only [ha]
        rw [Submodule.Quotient.mk_eq_zero] at h1
        have hv : v = φ a + (v - φ a) := by abel
        rw [hv]
        exact Submodule.add_mem_sup (LinearMap.mem_range_self φ a) h1
      intro v; exact hle Submodule.mem_top
    have hinj : Function.Injective φ := by
      have hL : LinearMap.ker φ ≤ I • LinearMap.ker φ := by
        intro c hc
        rw [LinearMap.mem_ker] at hc
        have h0 : ∑ i, (Ideal.Quotient.mk I (c i)) • b i = 0 := by
          rw [← hq, hc]; rfl
        have hci : ∀ i, Ideal.Quotient.mk I (c i) = 0 :=
          Fintype.linearIndependent_iff.mp b.linearIndependent _ h0
        have hw : ∀ i, ∃ w, w * x = c i := fun i =>
          Ideal.mem_span_singleton'.mp (Ideal.Quotient.eq_zero_iff_mem.mp (hci i))
        choose w hw using hw
        have hcw : c = x • w := by
          funext i; rw [← hw i, Pi.smul_apply, smul_eq_mul, mul_comm]
        have hφw : φ w = 0 := by
          apply hxM
          show x • φ w = x • 0
          rw [smul_zero, ← map_smul, ← hcw, hc]
        rw [hcw]
        exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self x) (LinearMap.mem_ker.mpr hφw)
      have hfg : (LinearMap.ker φ).FG := IsNoetherian.noetherian _
      exact LinearMap.ker_eq_bot.mp (Submodule.eq_bot_of_le_smul_of_le_jacobson_bot I _ hfg hL hIj)
    let e := LinearEquiv.ofBijective φ ⟨hinj, hsurj⟩
    have : Module.Free R M := Module.Free.of_equiv e
    exact Module.Projective.of_free

  have s3 : ∀ (R : Type u) [CommRing R] (x : R) (M : Type u) [AddCommGroup M] [Module R M]
      (hxM : IsSMulRegular M x) (s : ℕ) (φ : (Fin s → R) →ₗ[R] M) (hφ : Function.Surjective φ),
      ∃ φbar : (Fin s → R ⧸ Ideal.span {x}) →ₗ[R ⧸ Ideal.span {x}]
          (M ⧸ (Ideal.span {x}) • (⊤ : Submodule R M)),
        Function.Surjective φbar ∧
        Nonempty ((LinearMap.ker φ ⧸ (Ideal.span {x}) • (⊤ : Submodule R (LinearMap.ker φ))) ≃ₗ[R ⧸ Ideal.span {x}]
          LinearMap.ker φbar) := by
    intro R _ x M _ _ hxM s φ hφ
    set I : Ideal R := Ideal.span {x} with hI
    let π := Ideal.Quotient.mk I
    let q : M →ₗ[R] M ⧸ I • (⊤ : Submodule R M) := Submodule.mkQ _
    let e : Fin s → M := fun i => φ (fun j => if i = j then 1 else 0)
    let φbar : (Fin s → R ⧸ I) →ₗ[R ⧸ I] (M ⧸ I • (⊤ : Submodule R M)) :=
      Fintype.linearCombination (R ⧸ I) (fun i => q (e i))
    let πs : (Fin s → R) →ₗ[R] (Fin s → R ⧸ I) :=
      LinearMap.pi (fun i => (Ideal.Quotient.mkₐ R I).toLinearMap.comp (LinearMap.proj i))
    have hstar : ∀ y, φbar (πs y) = q (φ y) := by
      intro y
      rw [LinearMap.pi_apply_eq_sum_univ φ y, map_sum, Fintype.linearCombination_apply]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_smul]; rfl
    have hsurj : Function.Surjective φbar := by
      intro z
      obtain ⟨m, rfl⟩ := Submodule.mkQ_surjective _ z
      obtain ⟨y, rfl⟩ := hφ m
      exact ⟨πs y, hstar y⟩
    let θ : LinearMap.ker φ →ₗ[R] LinearMap.ker φbar :=
      { toFun := fun ℓ => ⟨πs ℓ, by
          rw [LinearMap.mem_ker, hstar, LinearMap.mem_ker.mp ℓ.2, map_zero]⟩
        map_add' := fun a b => Subtype.ext (map_add πs _ _)
        map_smul' := fun r a => Subtype.ext (map_smul πs r _) }
    have hθs : Function.Surjective θ := by
      rintro ⟨ybar, hy⟩
      obtain ⟨y, rfl⟩ : ∃ y, πs y = ybar :=
        ⟨fun i => (Ideal.Quotient.mk_surjective (ybar i)).choose,
          funext fun i => (Ideal.Quotient.mk_surjective (ybar i)).choose_spec⟩
      have h1 : q (φ y) = 0 := by rw [← hstar]; exact hy
      have h2 : φ y ∈ I • (⊤ : Submodule R M) := (Submodule.Quotient.mk_eq_zero _).mp h1
      rw [hI, Submodule.ideal_span_singleton_smul] at h2
      obtain ⟨m, -, hm⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).mp h2
      obtain ⟨w, rfl⟩ := hφ m
      refine ⟨⟨y - x • w, ?_⟩, ?_⟩
      · rw [LinearMap.mem_ker, map_sub, map_smul, hm, sub_self]
      · apply Subtype.ext
        show πs (y - x • w) = πs y
        rw [map_sub, map_smul]
        have : x • πs w = 0 := by
          funext i
          show π (x * w i) = 0
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (I.mul_mem_right _ (Ideal.mem_span_singleton_self x))
        rw [this, sub_zero]
    have hker : LinearMap.ker θ = I • (⊤ : Submodule R (LinearMap.ker φ)) := by
      apply le_antisymm
      · intro ℓ hℓ
        rw [LinearMap.mem_ker] at hℓ
        have hℓi : ∀ i, π ((ℓ : Fin s → R) i) = 0 := fun i =>
          congrFun (congrArg Subtype.val hℓ) i
        have hw : ∀ i, ∃ w, w * x = (ℓ : Fin s → R) i := fun i =>
          Ideal.mem_span_singleton'.mp (Ideal.Quotient.eq_zero_iff_mem.mp (hℓi i))
        choose w hw using hw
        have hcw : (ℓ : Fin s → R) = x • w := by
          funext i; rw [← hw i, Pi.smul_apply, smul_eq_mul, mul_comm]
        have hφw : φ w = 0 := by
          apply hxM
          show x • φ w = x • 0
          rw [smul_zero, ← map_smul, ← hcw]; exact ℓ.2
        have hl : ℓ = x • (⟨w, hφw⟩ : LinearMap.ker φ) := Subtype.ext hcw
        rw [hl]
        exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self x) Submodule.mem_top
      · rw [Submodule.smul_le]
        intro r hr n _
        rw [LinearMap.mem_ker, map_smul]
        apply Subtype.ext
        funext i
        show π (r * (n : Fin s → R) i) = 0
        exact Ideal.Quotient.eq_zero_iff_mem.mpr (I.mul_mem_right _ hr)
    let E : (LinearMap.ker φ ⧸ I • (⊤ : Submodule R (LinearMap.ker φ))) ≃ₗ[R] LinearMap.ker φbar :=
      (Submodule.quotEquivOfEq _ _ hker.symm).trans (θ.quotKerEquivOfSurjective hθs)
    exact ⟨φbar, hsurj, ⟨LinearEquiv.extendScalarsOfSurjective
      (by rw [Ideal.Quotient.algebraMap_eq]; exact Ideal.Quotient.mk_surjective) E⟩⟩

  intro R _ _ _ x hxm hxR M₀ _ _ _ hxM₀ k₀ hk₀ h₀
  have P : ∀ k, 1 ≤ k → ∀ (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M],
      IsSMulRegular M x →
      HasProjectiveDimensionLT (ModuleCat.of (R ⧸ Ideal.span {x})
        (M ⧸ (Ideal.span {x}) • (⊤ : Submodule R M))) k →
      HasProjectiveDimensionLT (ModuleCat.of R M) k := by
    intro k hk
    induction k, hk using Nat.le_induction with
    | base =>
      intro M _ _ _ hxM h
      have h1 : Projective (ModuleCat.of (R ⧸ Ideal.span {x})
          (M ⧸ (Ideal.span {x}) • (⊤ : Submodule R M))) :=
        projective_iff_hasProjectiveDimensionLT_one.mpr h
      have h2 := (IsProjective.iff_projective _).mpr h1
      have h3 := s2 R x hxm M hxM h2
      exact projective_iff_hasProjectiveDimensionLT_one.mp ((IsProjective.iff_projective M).mp h3)
    | succ k hk ih =>
      intro M _ _ _ hxM h
      obtain ⟨s, φ, hφ⟩ := Module.Finite.exists_fin' R M
      have hxL : IsSMulRegular (LinearMap.ker φ) x := by
        have hpi : IsSMulRegular (Fin s → R) x := IsSMulRegular.pi (fun _ => hxR)
        exact hpi.of_injective (LinearMap.ker φ).subtype Subtype.val_injective
      obtain ⟨φbar, hφbar, ⟨E⟩⟩ := s3 R x M hxM s φ hφ
      have h1 := (s1 (R ⧸ Ideal.span {x}) _ s φbar hφbar k).2 hk h
      have h2 : HasProjectiveDimensionLT (ModuleCat.of (R ⧸ Ideal.span {x})
          (LinearMap.ker φ ⧸ (Ideal.span {x}) • (⊤ : Submodule R (LinearMap.ker φ)))) k :=
        hasProjectiveDimensionLT_of_iso (E.toModuleIso).symm k
      have h3 := ih (LinearMap.ker φ) hxL h2
      exact (s1 R M s φ hφ k).1 h3
  exact P k₀ hk₀ M₀ hxM₀ h₀

theorem wc_plt_hlc_regular_params_quot : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (m : ℕ) (x : Fin (m + 1) → R) (hx : (Ideal.span (Set.range x)).IsMaximal) (hreg : ∀ (i : Fin (m + 1)) (r : R), x i * r ∈ Ideal.span (x '' {j | j < i}) → r ∈ Ideal.span (x '' {j | j < i})), IsLocalRing (R ⧸ Ideal.span {x 0}) ∧ (Ideal.span (Set.range (fun i : Fin m => Ideal.Quotient.mk (Ideal.span {x 0}) (x i.succ)))).IsMaximal ∧ ∀ (i : Fin m) (r : R ⧸ Ideal.span {x 0}), Ideal.Quotient.mk (Ideal.span {x 0}) (x i.succ) * r ∈ Ideal.span ((fun j : Fin m => Ideal.Quotient.mk (Ideal.span {x 0}) (x j.succ)) '' {j | j < i}) → r ∈ Ideal.span ((fun j : Fin m => Ideal.Quotient.mk (Ideal.span {x 0}) (x j.succ)) '' {j | j < i}) :=
by
  intro R _ _ m x hx hreg
  set I : Ideal R := Ideal.span {x 0} with hI
  have hsurj : Function.Surjective (Ideal.Quotient.mk I) := Ideal.Quotient.mk_surjective
  have hx0 : x 0 ∈ Ideal.span (Set.range x) := Ideal.subset_span ⟨0, rfl⟩
  have hIne : I ≠ ⊤ := by
    intro h
    apply hx.ne_top
    rw [eq_top_iff, ← h]
    exact (Ideal.span_singleton_le_iff_mem _).mpr hx0
  have s1 : ∀ T : Set R, Ideal.comap (Ideal.Quotient.mk I) (Ideal.span ((Ideal.Quotient.mk I) '' T)) =
      Ideal.span (insert (x 0) T) := by
    intro T
    rw [← Ideal.map_span, Ideal.comap_map_of_surjective _ hsurj, ← RingHom.ker_eq_comap_bot,
      Ideal.mk_ker, Ideal.span_insert, sup_comm]
  have s3 : insert (x 0) (Set.range (fun i : Fin m => x i.succ)) = Set.range x := by
    ext z
    simp only [Set.mem_insert_iff, Set.mem_range]
    rw [Fin.exists_fin_succ]
    constructor <;> rintro (h | h) <;> first | exact Or.inl h.symm | exact Or.inr h
  have s5 : ∀ i : Fin m, insert (x 0) ((fun j : Fin m => x j.succ) '' {j | j < i}) =
      x '' {j | j < i.succ} := by
    intro i
    ext z
    simp only [Set.mem_insert_iff, Set.mem_image, Set.mem_setOf_eq]
    rw [Fin.exists_fin_succ]
    simp only [Fin.succ_lt_succ_iff, Fin.succ_pos, true_and]
    constructor <;> rintro (h | h) <;> first | exact Or.inl h.symm | exact Or.inr h
  refine ⟨?_, ?_, ?_⟩
  · have : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hIne
    exact IsLocalRing.of_surjective' _ hsurj
  · have hr : Set.range (fun i : Fin m => Ideal.Quotient.mk I (x i.succ)) =
        (Ideal.Quotient.mk I) '' Set.range (fun i : Fin m => x i.succ) := by
      rw [← Set.range_comp]; rfl
    have hc : Ideal.comap (Ideal.Quotient.mk I)
        (Ideal.span (Set.range (fun i : Fin m => Ideal.Quotient.mk I (x i.succ)))) =
        Ideal.span (Set.range x) := by
      rw [hr, s1, s3]
    have hm : Ideal.span (Set.range (fun i : Fin m => Ideal.Quotient.mk I (x i.succ))) =
        Ideal.map (Ideal.Quotient.mk I) (Ideal.span (Set.range x)) := by
      rw [← hc, Ideal.map_comap_of_surjective _ hsurj]
    rw [hm]
    rcases Ideal.map_eq_top_or_isMaximal_of_surjective _ hsurj hx with h | h
    · exfalso
      apply hx.ne_top
      rw [← hc, hm, h, Ideal.comap_top]
    · exact h
  · intro i r hr
    obtain ⟨s, rfl⟩ := hsurj r
    have himg : (fun j : Fin m => Ideal.Quotient.mk I (x j.succ)) '' {j | j < i} =
        (Ideal.Quotient.mk I) '' ((fun j : Fin m => x j.succ) '' {j | j < i}) := by
      rw [Set.image_image]
    rw [himg] at hr ⊢
    rw [← map_mul, ← Ideal.mem_comap, s1, s5] at hr
    rw [← Ideal.mem_comap, s1, s5]
    exact hreg i.succ s hr

theorem wc_plt_hlc_regular_params_pd : ∀ (m : ℕ) (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (x : Fin m → R) (hx : (Ideal.span (Set.range x)).IsMaximal) (hreg : ∀ (i : Fin m) (r : R), x i * r ∈ Ideal.span (x '' {j | j < i}) → r ∈ Ideal.span (x '' {j | j < i})) (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M], CategoryTheory.HasProjectiveDimensionLT (ModuleCat.of R M) (m + 1) :=
by
  intro m
  induction m with
  | zero =>
    intro R _ _ _ x hx hreg M _ _ _
    have hbot : (⊥ : Ideal R).IsMaximal := by
      have h0 : Ideal.span (Set.range x) = ⊥ := by
        rw [Set.range_eq_empty, Ideal.span_empty]
      rw [← h0]
      exact hx
    obtain ⟨ι, ⟨b⟩⟩ : ∃ ι : Type u, Nonempty (Module.Basis ι R M) := by
      letI : Field R := (Ring.isField_iff_maximal_bot.mpr hbot).toField
      exact ⟨_, ⟨Module.Free.chooseBasis R M⟩⟩
    have hproj : Projective (ModuleCat.of R M) := ModuleCat.projective_of_free (M := ModuleCat.of R M) b
    exact projective_iff_hasProjectiveDimensionLT_one.mp hproj
  | succ m ih =>
    intro R _ _ _ x hx hreg M _ _ _
    obtain ⟨s, φ, hφ⟩ := Module.Finite.exists_fin' R M
    have hm : Ideal.span (Set.range x) = IsLocalRing.maximalIdeal R := IsLocalRing.eq_maximalIdeal hx
    have hx0m : x 0 ∈ IsLocalRing.maximalIdeal R := by
      rw [← hm]
      exact Ideal.subset_span ⟨0, rfl⟩
    have hempty : x '' {j | j < 0} = ∅ := by
      ext j
      simp
    have hxR : IsSMulRegular R (x 0) := by
      intro a b h
      have h1 : x 0 * (a - b) ∈ Ideal.span (x '' {j | j < 0}) := by
        rw [hempty, Ideal.span_empty, Ideal.mem_bot, mul_sub]
        exact sub_eq_zero.mpr h
      have h2 := hreg 0 (a - b) h1
      rw [hempty, Ideal.span_empty, Ideal.mem_bot] at h2
      exact sub_eq_zero.mp h2
    have hxL : IsSMulRegular (LinearMap.ker φ) (x 0) := by
      intro a b h
      apply Subtype.ext
      funext i
      apply hxR
      have h1 := congrArg (fun v : LinearMap.ker φ => (v : Fin s → R) i) h
      simpa using h1
    obtain ⟨hloc, hmax', hreg'⟩ := wc_plt_hlc_regular_params_quot R m x hx hreg
    haveI := hloc
    have hih := ih (R ⧸ Ideal.span {x 0}) _ hmax' hreg'
      (LinearMap.ker φ ⧸ (Ideal.span {x 0}) • (⊤ : Submodule R (LinearMap.ker φ)))
    have hL := wc_plt_hlc_pd_of_quot_regular R (x 0) hx0m hxR (LinearMap.ker φ) hxL (m + 1)
      (by omega) hih
    let S : ShortComplex (ModuleCat R) :=
      ShortComplex.mk (ModuleCat.ofHom (LinearMap.ker φ).subtype) (ModuleCat.ofHom φ)
        (by ext v; simp)
    have hS : S.ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · rw [ShortComplex.moduleCat_exact_iff]
        intro v hv
        exact ⟨⟨v, LinearMap.mem_ker.mpr hv⟩, rfl⟩
      · rw [ModuleCat.mono_iff_injective]
        exact Subtype.val_injective
      · rw [ModuleCat.epi_iff_surjective]
        exact hφ
    have hP : Projective (ModuleCat.of R (Fin s → R)) :=
      ModuleCat.projective_of_free (M := ModuleCat.of R (Fin s → R)) (Pi.basisFun R (Fin s))
    haveI : HasProjectiveDimensionLT (ModuleCat.of R (Fin s → R)) 1 :=
      projective_iff_hasProjectiveDimensionLT_one.mp hP
    have h2 : HasProjectiveDimensionLT S.X₂ (m + 1 + 1) :=
      hasProjectiveDimensionLT_of_ge (ModuleCat.of R (Fin s → R)) 1 _ (by omega)
    exact hS.hasProjectiveDimensionLT_X₃ (m + 1) hL h2

theorem wc_plt_hlc_powerseries_regular_params : ∀ (K : Type u) [Field K] (n : ℕ), (Ideal.span (Set.range (MvPowerSeries.X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) K))).IsMaximal ∧ ∀ (i : Fin (n + 1)) (r : MvPowerSeries (Fin (n + 1)) K), MvPowerSeries.X i * r ∈ Ideal.span ((MvPowerSeries.X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) K) '' {j | j < i}) → r ∈ Ideal.span ((MvPowerSeries.X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) K) '' {j | j < i}) :=
by
  intro K _ n
  classical
  have s1 : ∀ (k : ℕ) (f : MvPowerSeries (Fin (n + 1)) K),
      f ∈ Ideal.span ((MvPowerSeries.X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) K) ''
        {j | (j : ℕ) < k}) →
      ∀ m : Fin (n + 1) →₀ ℕ, (∀ j : Fin (n + 1), (j : ℕ) < k → m j = 0) →
        MvPowerSeries.coeff (R := K) m f = 0 := by
    intro k f hf
    induction hf using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨j, hj, rfl⟩ := hx
      intro m hm
      rw [MvPowerSeries.coeff_X]
      split_ifs with h
      · exfalso
        have h2 := hm j hj
        rw [h, Finsupp.single_eq_same] at h2
        exact one_ne_zero h2
      · rfl
    | zero => intro m _; simp
    | add x y _ _ hx hy => intro m hm; rw [map_add, hx m hm, hy m hm, add_zero]
    | smul a x _ hx =>
      intro m hm
      rw [smul_eq_mul, MvPowerSeries.coeff_mul]
      apply Finset.sum_eq_zero
      intro p hp
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
      rw [hx p.2 (fun j hj => by
        have h2 := hm j hj
        rw [← hp, Finsupp.add_apply] at h2
        omega), mul_zero]
  have s2 : ∀ (k : ℕ) (f : MvPowerSeries (Fin (n + 1)) K),
      (∀ m : Fin (n + 1) →₀ ℕ, (∀ j : Fin (n + 1), (j : ℕ) < k → m j = 0) →
        MvPowerSeries.coeff (R := K) m f = 0) →
      f ∈ Ideal.span ((MvPowerSeries.X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) K) ''
        {j | (j : ℕ) < k}) := by
    intro k
    induction k with
    | zero =>
      intro f hf
      have hf0 : f = 0 := by
        ext m
        rw [hf m (fun j hj => absurd hj (Nat.not_lt_zero _))]
        simp
      rw [hf0]
      exact Ideal.zero_mem _
    | succ k ih =>
      intro f hf
      have hmono : Ideal.span ((MvPowerSeries.X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) K) ''
            {j | (j : ℕ) < k}) ≤
          Ideal.span ((MvPowerSeries.X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) K) ''
            {j | (j : ℕ) < k + 1}) :=
        Ideal.span_mono (Set.image_mono (fun j hj => by
          simp only [Set.mem_setOf_eq] at hj ⊢
          omega))
      by_cases hk : k < n + 1
      · let t : Fin (n + 1) := ⟨k, hk⟩
        let ψ : MvPowerSeries (Fin (n + 1)) K := fun m => f (m + Finsupp.single t 1)
        have hcoeff : ∀ m, MvPowerSeries.coeff (R := K) m (MvPowerSeries.X t * ψ) =
            if 1 ≤ m t then MvPowerSeries.coeff (R := K) m f else 0 := by
          intro m
          rw [MvPowerSeries.X_def, MvPowerSeries.coeff_monomial_mul]
          by_cases h : 1 ≤ m t
          · have hle : Finsupp.single t 1 ≤ m := by rw [Finsupp.single_le_iff]; exact h
            rw [if_pos hle, if_pos h, one_mul]
            show f (m - Finsupp.single t 1 + Finsupp.single t 1) = _
            rw [tsub_add_cancel_of_le hle]
            rfl
          · have hle : ¬ Finsupp.single t 1 ≤ m := by rw [Finsupp.single_le_iff]; exact h
            rw [if_neg hle, if_neg h]
        have hg := ih (f - MvPowerSeries.X t * ψ) (by
          intro m hm
          rw [map_sub, hcoeff]
          split_ifs with h
          · exact sub_self _
          · rw [hf m (fun j hj => by
              rcases Nat.lt_succ_iff_lt_or_eq.mp hj with hj | hj
              · exact hm j hj
              · rw [show j = t from Fin.ext hj]
                omega), sub_zero])
        have hXt : MvPowerSeries.X t ∈
            Ideal.span ((MvPowerSeries.X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) K) ''
              {j | (j : ℕ) < k + 1}) :=
          Ideal.subset_span ⟨t, by simp [t], rfl⟩
        have h3 := Ideal.add_mem _ (hmono hg) (Ideal.mul_mem_right ψ _ hXt)
        rwa [sub_add_cancel] at h3
      · apply hmono
        apply ih
        intro m hm
        apply hf m
        intro j hj
        exact hm j (by have := j.isLt; omega)
  refine ⟨?_, ?_⟩
  · have hA : Ideal.span (Set.range (MvPowerSeries.X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) K))
        = RingHom.ker (MvPowerSeries.constantCoeff (σ := Fin (n + 1)) (R := K)) := by
      apply le_antisymm
      · rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        simp [RingHom.mem_ker]
      · intro f hf
        have hr : Set.range (MvPowerSeries.X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) K) =
            (MvPowerSeries.X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) K) ''
              {j : Fin (n + 1) | (j : ℕ) < n + 1} := by
          rw [← Set.image_univ]
          congr 1
          ext j
          exact ⟨fun _ => j.isLt, fun _ => Set.mem_univ j⟩
        rw [hr]
        apply s2
        intro m hm
        have hm0 : m = 0 := by
          ext j
          exact hm j j.isLt
        rw [hm0, MvPowerSeries.coeff_zero_eq_constantCoeff_apply]
        exact hf
    rw [hA]
    exact RingHom.ker_isMaximal_of_surjective _
      (fun a => ⟨MvPowerSeries.C (σ := Fin (n + 1)) (R := K) a, by simp⟩)
  · intro i r hr
    have hset : {j : Fin (n + 1) | j < i} = {j : Fin (n + 1) | (j : ℕ) < (i : ℕ)} := by
      ext j
      show j < i ↔ (j : ℕ) < (i : ℕ)
      exact Fin.lt_iff_val_lt_val
    rw [hset] at hr ⊢
    apply s2
    intro m hm
    have h1 := s1 i (MvPowerSeries.X i * r) hr (m + Finsupp.single i 1) (fun j hj => by
      have hne : i ≠ j := fun h => by rw [h] at hj; omega
      simp [hne, hm j hj])
    rw [MvPowerSeries.X_def, MvPowerSeries.coeff_monomial_mul, if_pos le_add_self, one_mul,
      add_tsub_cancel_right] at h1
    exact h1

theorem wc_plt_hlc_powerseries_ext_vanish (K : Type u) [Field K] (n : ℕ)
    (N : ModuleCat.{u} (MvPowerSeries (Fin (n + 1)) K))
    [Module.Finite (MvPowerSeries (Fin (n + 1)) K) N]
    (hreg : ∀ v : N, (MvPowerSeries.X 0 : MvPowerSeries (Fin (n + 1)) K) • v = 0 → v = 0) :
    Limits.IsZero (((Ext (MvPowerSeries (Fin (n + 1)) K)
      (ModuleCat.{u} (MvPowerSeries (Fin (n + 1)) K)) (n + 1)).obj (Opposite.op N)).obj
        (ModuleCat.of (MvPowerSeries (Fin (n + 1)) K) (MvPowerSeries (Fin (n + 1)) K))) :=
by
  classical
  obtain ⟨hmax, hregx⟩ := wc_plt_hlc_powerseries_regular_params K n
  obtain ⟨hloc, hmax', hreg'⟩ := wc_plt_hlc_regular_params_quot (MvPowerSeries (Fin (n + 1)) K) n
    (MvPowerSeries.X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) K) hmax hregx
  haveI := hloc
  have hpd' := wc_plt_hlc_regular_params_pd n
    (MvPowerSeries (Fin (n + 1)) K ⧸
      Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin (n + 1)) K)}) _ hmax' hreg'
    (N ⧸ (Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin (n + 1)) K)}) •
      (⊤ : Submodule (MvPowerSeries (Fin (n + 1)) K) N))
  have hm : Ideal.span (Set.range
      (MvPowerSeries.X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) K)) =
      IsLocalRing.maximalIdeal (MvPowerSeries (Fin (n + 1)) K) :=
    IsLocalRing.eq_maximalIdeal hmax
  have hx0m : (MvPowerSeries.X 0 : MvPowerSeries (Fin (n + 1)) K) ∈
      IsLocalRing.maximalIdeal (MvPowerSeries (Fin (n + 1)) K) := by
    rw [← hm]
    exact Ideal.subset_span ⟨0, rfl⟩
  have hempty : (MvPowerSeries.X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) K) ''
      {j | j < 0} = ∅ := by
    ext j
    simp
  have hxA : IsSMulRegular (MvPowerSeries (Fin (n + 1)) K)
      (MvPowerSeries.X 0 : MvPowerSeries (Fin (n + 1)) K) := by
    intro a b h
    have h1 : (MvPowerSeries.X 0 : MvPowerSeries (Fin (n + 1)) K) * (a - b) ∈
        Ideal.span ((MvPowerSeries.X : Fin (n + 1) → MvPowerSeries (Fin (n + 1)) K) ''
          {j | j < 0}) := by
      rw [hempty, Ideal.span_empty, Ideal.mem_bot, mul_sub]
      exact sub_eq_zero.mpr h
    have h2 := hregx 0 (a - b) h1
    rw [hempty, Ideal.span_empty, Ideal.mem_bot] at h2
    exact sub_eq_zero.mp h2
  have hxN : IsSMulRegular N (MvPowerSeries.X 0 : MvPowerSeries (Fin (n + 1)) K) := by
    intro a b h
    have h1 : (MvPowerSeries.X 0 : MvPowerSeries (Fin (n + 1)) K) • (a - b) = 0 := by
      rw [smul_sub]
      exact sub_eq_zero.mpr h
    exact sub_eq_zero.mp (hreg _ h1)
  have hpd := wc_plt_hlc_pd_of_quot_regular (MvPowerSeries (Fin (n + 1)) K)
    (MvPowerSeries.X 0) hx0m hxA N hxN (n + 1) (by omega) hpd'
  haveI : HasProjectiveDimensionLT N (n + 1) := hpd
  haveI := HasProjectiveDimensionLT.subsingleton N (n + 1) (n + 1) le_rfl
    (ModuleCat.of (MvPowerSeries (Fin (n + 1)) K) (MvPowerSeries (Fin (n + 1)) K))
  obtain ⟨e, -⟩ := wc_plt_lc_mv_ext_comparison (MvPowerSeries (Fin (n + 1)) K)
    (ModuleCat.of (MvPowerSeries (Fin (n + 1)) K) (MvPowerSeries (Fin (n + 1)) K)) (n + 1)
  haveI : Subsingleton ↑(((Ext (MvPowerSeries (Fin (n + 1)) K)
      (ModuleCat.{u} (MvPowerSeries (Fin (n + 1)) K)) (n + 1)).obj (Opposite.op N)).obj
        (ModuleCat.of (MvPowerSeries (Fin (n + 1)) K) (MvPowerSeries (Fin (n + 1)) K))) :=
    (e N).injective.subsingleton
  exact ModuleCat.isZero_of_subsingleton _

theorem wc_plt_hlct_free_cover (C : Type u) [CommRing C] (I : Ideal C) (n : ℕ)
    (hK : ∀ (K : ModuleCat.{u} C) (t : ℕ) (y : Abelian.Ext (ModuleCat.of C (C ⧸ I ^ t)) K (n + 1)),
      ∃ (t' : ℕ) (ht : t ≤ t'), (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : I ^ t' ≤ I ^ t)))).comp y (zero_add (n + 1)) = 0)
    (hC : ∀ (t : ℕ) (y : Abelian.Ext (ModuleCat.of C (C ⧸ I ^ t)) (ModuleCat.of C C) n),
      ∃ (t' : ℕ) (ht : t ≤ t'), (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : I ^ t' ≤ I ^ t)))).comp y (zero_add n) = 0)
    (m : ℕ) (M : ModuleCat.{u} C) (π : ModuleCat.of C (Fin m → C) ⟶ M) (hπ : Function.Surjective π.hom)
    (t : ℕ) (y : Abelian.Ext (ModuleCat.of C (C ⧸ I ^ t)) M n) :
    ∃ (t' : ℕ) (ht : t ≤ t'), (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
      (Ideal.pow_le_pow_right ht : I ^ t' ≤ I ^ t)))).comp y (zero_add n) = 0 :=
by
  classical

  have hFct : ∀ {Y : ModuleCat.{u} C} {k : ℕ} (a b c : ℕ) (hab : a ≤ b) (hbc : b ≤ c)
      (z : Abelian.Ext (ModuleCat.of C (C ⧸ I ^ a)) Y k),
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right hbc : I ^ c ≤ I ^ b)))).comp
        ((Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right hab : I ^ b ≤ I ^ a)))).comp z (zero_add k)) (zero_add k) =
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right (hab.trans hbc) : I ^ c ≤ I ^ a)))).comp z (zero_add k) := by
    intro Y k a b c hab hbc z
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← ModuleCat.ofHom_comp, Submodule.factor_comp]

  have hAsc : ∀ {Y Z : ModuleCat.{u} C} {p r k : ℕ} (a b : ℕ) (hab : a ≤ b)
      (x : Abelian.Ext (ModuleCat.of C (C ⧸ I ^ a)) Y p) (w : Abelian.Ext Y Z r) (h : p + r = k),
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right hab : I ^ b ≤ I ^ a)))).comp (x.comp w h) (zero_add k) =
      ((Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right hab : I ^ b ≤ I ^ a)))).comp x (zero_add p)).comp w h := by
    intro Y Z p r k a b hab x w h
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add p) h (by omega)).symm

  have hfree : ∀ (s : ℕ) (x : Abelian.Ext (ModuleCat.of C (C ⧸ I ^ s)) (ModuleCat.of C (Fin m → C)) n),
      ∃ (s' : ℕ) (hs : s ≤ s'), (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right hs : I ^ s' ≤ I ^ s)))).comp x (zero_add n) = 0 := by
    intro s x
    let p : Fin m → (ModuleCat.of C (Fin m → C) ⟶ ModuleCat.of C C) := fun j =>
      ModuleCat.ofHom (LinearMap.proj j)
    let ι : Fin m → (ModuleCat.of C C ⟶ ModuleCat.of C (Fin m → C)) := fun j =>
      ModuleCat.ofHom (LinearMap.single C (fun _ : Fin m => C) j)
    have hdec : ∑ j, p j ≫ ι j = 𝟙 _ := by
      ext v i
      simp [p, ι, ModuleCat.hom_sum, Finset.sum_apply, Pi.single_apply]
    have hx : x = ∑ j, (x.comp (Abelian.Ext.mk₀ (p j)) (add_zero n)).comp
        (Abelian.Ext.mk₀ (ι j)) (add_zero n) := by
      calc x = x.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero n) := (Abelian.Ext.comp_mk₀_id x).symm
        _ = x.comp (Abelian.Ext.mk₀ (∑ j, p j ≫ ι j)) (add_zero n) := by rw [hdec]
        _ = ∑ j, x.comp (Abelian.Ext.mk₀ (p j ≫ ι j)) (add_zero n) := by
          rw [Abelian.Ext.mk₀_sum, Abelian.Ext.comp_sum]
        _ = _ := Finset.sum_congr rfl (fun j _ => by
          rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_third_deg_zero])
    choose tj htj hz using fun j => hC s (x.comp (Abelian.Ext.mk₀ (p j)) (add_zero n))
    refine ⟨s ⊔ Finset.univ.sup tj, le_sup_left, ?_⟩
    rw [hx, Abelian.Ext.comp_sum]
    apply Finset.sum_eq_zero
    intro j _
    have hjT : tj j ≤ s ⊔ Finset.univ.sup tj :=
      le_sup_of_le_right (Finset.le_sup (Finset.mem_univ j))
    rw [hAsc s _ le_sup_left, ← hFct s (tj j) _ (htj j) hjT, hz j, Abelian.Ext.comp_zero,
      Abelian.Ext.zero_comp]

  let K : ModuleCat.{u} C := ModuleCat.of C (LinearMap.ker π.hom)
  let f : K ⟶ ModuleCat.of C (Fin m → C) := ModuleCat.ofHom (LinearMap.ker π.hom).subtype
  have hw : f ≫ π = 0 := by
    ext x
    exact LinearMap.mem_ker.mp x.2
  let S : ShortComplex (ModuleCat.{u} C) := ShortComplex.mk f π hw
  have hS : S.ShortExact := by
    apply ShortComplex.ShortExact.mk'
    · rw [ShortComplex.moduleCat_exact_iff]
      intro x₂ hx₂
      exact ⟨⟨x₂, LinearMap.mem_ker.mpr hx₂⟩, rfl⟩
    · rw [ModuleCat.mono_iff_injective]
      exact Subtype.val_injective
    · rw [ModuleCat.epi_iff_surjective]
      exact hπ
  obtain ⟨t₁, ht₁, h1⟩ := hK K t (y.comp hS.extClass rfl)
  rw [hAsc t t₁ ht₁] at h1
  obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ _ hS _ rfl h1
  obtain ⟨t₂, ht₂, h2⟩ := hfree t₁ x₂
  refine ⟨t₂, ht₁.trans ht₂, ?_⟩
  rw [← hFct t t₁ t₂ ht₁ ht₂, ← hx₂, hAsc t₁ t₂ ht₂, h2, Abelian.Ext.zero_comp]

theorem wc_plt_hlct_artin_rees_extend (C : Type u) [CommRing C] [IsNoetherianRing C] (I : Ideal C)
    (E' : Type u) [AddCommGroup E'] [Module C E'] [Module.Injective C E']
    (m : ℕ) (K : Submodule C (Fin m → C)) (t : ℕ) :
    ∃ t' : ℕ, t ≤ t' ∧ ∀ g : K →ₗ[C] E', (∀ a ∈ I ^ t, ∀ x : K, a • g x = 0) →
      ∃ h : (Fin m → C) →ₗ[C] E', h ∘ₗ K.subtype = g ∧ ∀ a ∈ I ^ t', ∀ v : Fin m → C, a • h v = 0 :=
by
  classical
  obtain ⟨k, hk⟩ := Ideal.exists_pow_inf_eq_pow_smul I K
  refine ⟨t + k, by omega, ?_⟩
  intro g hg
  set P : Submodule C (Fin m → C) := I ^ (t + k) • (⊤ : Submodule C (Fin m → C)) with hP
  set Kc : Submodule C K := P.comap K.subtype with hKc
  have s2 : ∀ x : Fin m → C, x ∈ P → x ∈ K → x ∈ I ^ t • K := by
    intro x hxP hxK
    have hx : x ∈ I ^ (t + k) • (⊤ : Submodule C (Fin m → C)) ⊓ K :=
      Submodule.mem_inf.mpr ⟨hxP, hxK⟩
    rw [hk (t + k) (by omega), Nat.add_sub_cancel] at hx
    exact Submodule.smul_mono le_rfl inf_le_right hx
  have s3 : ∀ y : Fin m → C, y ∈ I ^ t • K → y ∈ K ∧ ∀ hy : y ∈ K, g ⟨y, hy⟩ = 0 := by
    intro y hy
    refine Submodule.smul_induction_on (p := fun y => y ∈ K ∧ ∀ hy : y ∈ K, g ⟨y, hy⟩ = 0)
      hy ?_ ?_
    · intro r hr n hn
      refine ⟨K.smul_mem r hn, fun hrn => ?_⟩
      have e : (⟨r • n, hrn⟩ : K) = r • (⟨n, hn⟩ : K) := rfl
      rw [e, map_smul]
      exact hg r hr _
    · rintro a b ⟨haK, ha⟩ ⟨hbK, hb⟩
      refine ⟨K.add_mem haK hbK, fun hab => ?_⟩
      have e : (⟨a + b, hab⟩ : K) = (⟨a, haK⟩ : K) + ⟨b, hbK⟩ := rfl
      rw [e, map_add, ha, hb, add_zero]
  have s4 : Kc ≤ LinearMap.ker g := by
    intro x hx
    rw [LinearMap.mem_ker]
    have hxP : (x : Fin m → C) ∈ P := hx
    exact (s3 _ (s2 _ hxP x.2)).2 x.2
  let gb : (K ⧸ Kc) →ₗ[C] E' := Kc.liftQ g s4
  let f₀ : K →ₗ[C] (Fin m → C) ⧸ P := P.mkQ ∘ₗ K.subtype
  have hker : LinearMap.ker f₀ = Kc := by
    rw [LinearMap.ker_comp, Submodule.ker_mkQ]
  let ι : (K ⧸ Kc) →ₗ[C] (Fin m → C) ⧸ P := Kc.liftQ f₀ hker.ge
  have hι : Function.Injective ι :=
    LinearMap.ker_eq_bot.mp (Submodule.ker_liftQ_eq_bot _ _ _ hker.le)
  obtain ⟨h₀, hh₀⟩ := Module.Injective.out ι hι gb
  refine ⟨h₀ ∘ₗ P.mkQ, ?_, ?_⟩
  · apply LinearMap.ext
    intro x
    have e := hh₀ (Kc.mkQ x)
    exact e
  · intro a ha v
    rw [← map_smul]
    change h₀ (P.mkQ (a • v)) = 0
    rw [Submodule.mkQ_apply,
      (Submodule.Quotient.mk_eq_zero P).mpr (Submodule.smul_mem_smul ha Submodule.mem_top),
      map_zero]

theorem wc_plt_hlct_coinduced_kill (C : Type u) [CommRing C] [IsNoetherianRing C] (I : Ideal C)
    (E' : Type u) [AddCommGroup E'] [Module C E'] [Module.Injective C E']
    (hAR : ∀ (m : ℕ) (K : Submodule C (Fin m → C)) (t : ℕ),
      ∃ t' : ℕ, t ≤ t' ∧ ∀ g : K →ₗ[C] E', (∀ a ∈ I ^ t, ∀ x : K, a • g x = 0) →
        ∃ h : (Fin m → C) →ₗ[C] E', h ∘ₗ K.subtype = g ∧ ∀ a ∈ I ^ t', ∀ v : Fin m → C, a • h v = 0)
    (i : ℕ) (M : Type u) [AddCommGroup M] [Module C M] [Module.Finite C M] (t : ℕ)
    (y : Abelian.Ext (ModuleCat.of C (C ⧸ I ^ t)) (ModuleCat.of C (M →ₗ[C] E')) (i + 1)) :
    ∃ (t' : ℕ) (ht : t ≤ t'), (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
      (Ideal.pow_le_pow_right ht : I ^ t' ≤ I ^ t)))).comp y (zero_add (i + 1)) = 0 :=
by
  classical

  have s1 : ∀ (S : ShortComplex (ModuleCat.{u} C)) (hS : S.ShortExact) (_ : Injective S.X₂) (i : ℕ)
      (_ : ∀ (t : ℕ) (w : Abelian.Ext (ModuleCat.of C (C ⧸ I ^ t)) S.X₃ i), ∃ (t' : ℕ) (ht : t ≤ t'),
        ((Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right ht : I ^ t' ≤ I ^ t)))).comp w (zero_add i)).comp hS.extClass rfl = 0)
      (t : ℕ) (y : Abelian.Ext (ModuleCat.of C (C ⧸ I ^ t)) S.X₁ (i + 1)),
      ∃ (t' : ℕ) (ht : t ≤ t'), (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : I ^ t' ≤ I ^ t)))).comp y (zero_add (i + 1)) = 0 := by
    intro S hS hinj i h3 t y
    haveI := hinj
    have h0 : y.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 := Abelian.Ext.eq_zero_of_injective _
    obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS y h0 (rfl : i + 1 = i + 1)
    obtain ⟨t', ht, h⟩ := h3 t w
    refine ⟨t', ht, ?_⟩
    rw [← hw, ← Abelian.Ext.comp_assoc _ _ _ (zero_add i) rfl (by omega)]
    exact h

  have s2 : ∀ (m : ℕ) (M' : Type u) [AddCommGroup M'] [Module C M']
      (π : (Fin m → C) →ₗ[C] M') (_ : Function.Surjective π),
      ∃ hz : ModuleCat.ofHom (LinearMap.lcomp C E' π) ≫
          ModuleCat.ofHom (LinearMap.lcomp C E' (LinearMap.ker π).subtype) = 0,
        (ShortComplex.mk (ModuleCat.ofHom (LinearMap.lcomp C E' π))
          (ModuleCat.ofHom (LinearMap.lcomp C E' (LinearMap.ker π).subtype)) hz).ShortExact ∧
        Injective (ModuleCat.of C ((Fin m → C) →ₗ[C] E')) := by
    intro m M' _ _ π hπ
    have hz : ModuleCat.ofHom (LinearMap.lcomp C E' π) ≫
        ModuleCat.ofHom (LinearMap.lcomp C E' (LinearMap.ker π).subtype) = 0 := by
      apply ModuleCat.hom_ext
      apply LinearMap.ext; intro h
      apply LinearMap.ext; intro x
      simp only [ModuleCat.hom_comp, ModuleCat.hom_ofHom, LinearMap.comp_apply,
        LinearMap.lcomp_apply, Submodule.coe_subtype, ModuleCat.hom_zero, LinearMap.zero_apply]
      rw [LinearMap.mem_ker.mp x.2, map_zero]
    refine ⟨hz, ?_, ?_⟩
    · have hmono : Mono (ModuleCat.ofHom (LinearMap.lcomp C E' π)) := by
        rw [ModuleCat.mono_iff_injective]
        intro h₁ h₂ heq
        apply LinearMap.ext
        intro y
        obtain ⟨x, rfl⟩ := hπ y
        have := LinearMap.congr_fun heq x
        simpa [LinearMap.lcomp_apply] using this
      have hepi : Epi (ModuleCat.ofHom (LinearMap.lcomp C E' (LinearMap.ker π).subtype)) := by
        rw [ModuleCat.epi_iff_surjective]
        intro g₀
        obtain ⟨h, hh⟩ := Module.Injective.out (LinearMap.ker π).subtype Subtype.val_injective g₀
        refine ⟨h, ?_⟩
        apply LinearMap.ext
        intro x
        simpa [LinearMap.lcomp_apply] using hh x
      refine ShortComplex.ShortExact.mk' ?_ hmono hepi
      rw [ShortComplex.moduleCat_exact_iff]
      intro h hh
      have hh' : ∀ x : LinearMap.ker π, h x = 0 := fun x => by
        have := LinearMap.congr_fun hh x
        simpa [LinearMap.lcomp_apply] using this
      have hker : LinearMap.ker π ≤ LinearMap.ker h := fun x hx => hh' ⟨x, hx⟩
      refine ⟨(LinearMap.ker π).liftQ h hker ∘ₗ
        (π.quotKerEquivOfSurjective hπ).symm.toLinearMap, ?_⟩
      apply LinearMap.ext
      intro x
      simp [LinearMap.lcomp_apply, LinearMap.quotKerEquivOfSurjective_symm_apply]
    · have h1 : Injective (ModuleCat.of C (Fin m → E')) :=
        (Module.injective_iff_injective_object C (Fin m → E')).mp inferInstance
      exact Injective.of_iso (LinearEquiv.piRing C E' (Fin m) C).toModuleIso.symm h1

  have s3 : ∀ (m : ℕ) (K : Submodule C (Fin m → C)) (t : ℕ)
      (w₀ : ModuleCat.of C (C ⧸ I ^ t) ⟶ ModuleCat.of C (K →ₗ[C] E')),
      ∃ (t' : ℕ) (ht : t ≤ t')
        (v : ModuleCat.of C (C ⧸ I ^ t') ⟶ ModuleCat.of C ((Fin m → C) →ₗ[C] E')),
        ModuleCat.ofHom (Submodule.factor (Ideal.pow_le_pow_right ht : I ^ t' ≤ I ^ t)) ≫ w₀ =
          v ≫ ModuleCat.ofHom (LinearMap.lcomp C E' K.subtype) := by
    intro m K t w₀
    set g : K →ₗ[C] E' := w₀.hom (Submodule.Quotient.mk 1) with hg
    have hkill : ∀ a ∈ I ^ t, ∀ x : K, a • g x = 0 := by
      intro a ha x
      have h2 : (a • (Submodule.Quotient.mk (1 : C)) : C ⧸ I ^ t) = 0 := by
        rw [← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one, Submodule.Quotient.mk_eq_zero]
        exact ha
      have h3 := congrArg w₀.hom h2
      rw [map_smul, map_zero] at h3
      rw [← LinearMap.smul_apply, hg, h3, LinearMap.zero_apply]
    obtain ⟨t', ht, H⟩ := hAR m K t
    obtain ⟨h, hh, hk⟩ := H g hkill
    have hker : I ^ t' ≤ LinearMap.ker (LinearMap.toSpanSingleton C _ h) := by
      intro a ha
      rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply]
      apply LinearMap.ext
      intro v
      rw [LinearMap.smul_apply, LinearMap.zero_apply]
      exact hk a ha v
    refine ⟨t', ht, ModuleCat.ofHom ((I ^ t').liftQ (LinearMap.toSpanSingleton C _ h) hker), ?_⟩
    apply ModuleCat.hom_ext
    apply Submodule.linearMap_qext
    apply LinearMap.ext_ring
    simp only [ModuleCat.hom_comp, ModuleCat.hom_ofHom, LinearMap.comp_apply,
      Submodule.mkQ_apply, Submodule.liftQ_apply,
      LinearMap.toSpanSingleton_apply, one_smul]
    change w₀.hom (Submodule.Quotient.mk 1) = _
    rw [← hg]
    apply LinearMap.ext
    intro x
    rw [LinearMap.lcomp_apply, ← hh]
    rfl

  induction i generalizing M t with
  | zero =>
    obtain ⟨m, π, hπ⟩ := Module.Finite.exists_fin' C M
    obtain ⟨hz, hS, hinj⟩ := s2 m M π hπ
    refine s1 _ hS hinj 0 ?_ t y
    intro t w
    obtain ⟨w₀, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 w
    obtain ⟨t', ht, v, hv⟩ := s3 m (LinearMap.ker π) t w₀
    refine ⟨t', ht, ?_⟩
    have hg0 : (Abelian.Ext.mk₀ (ModuleCat.ofHom
        (LinearMap.lcomp C E' (LinearMap.ker π).subtype))).comp hS.extClass (zero_add 1) = 0 :=
      hS.comp_extClass
    rw [Abelian.Ext.mk₀_comp_mk₀, hv, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc_of_second_deg_zero, hg0, Abelian.Ext.comp_zero]
  | succ j ih =>
    obtain ⟨m, π, hπ⟩ := Module.Finite.exists_fin' C M
    obtain ⟨hz, hS, hinj⟩ := s2 m M π hπ
    refine s1 _ hS hinj (j + 1) ?_ t y
    intro t w
    obtain ⟨t', ht, hw⟩ := ih (LinearMap.ker π) t w
    exact ⟨t', ht, by rw [hw, Abelian.Ext.zero_comp]⟩

theorem wc_plt_hlct_good_injective (C B : Type u) [CommRing C] [CommRing B] (φ : C →+* B)
    (hφ : φ.Finite) (I : Ideal C)
    (hcoind : ∀ (E' : Type u) [AddCommGroup E'] [Module C E'] [Module.Injective C E']
      (i : ℕ) (M : Type u) [AddCommGroup M] [Module C M] [Module.Finite C M] (t : ℕ)
      (y : Abelian.Ext (ModuleCat.of C (C ⧸ I ^ t)) (ModuleCat.of C (M →ₗ[C] E')) (i + 1)),
        ∃ (t' : ℕ) (ht : t ≤ t'), (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right ht : I ^ t' ≤ I ^ t)))).comp y (zero_add (i + 1)) = 0)
    (N : ModuleCat.{u} B) :
    ∃ (E : ModuleCat.{u} B) (ι : N ⟶ E), Injective E ∧ Mono ι ∧
      ∀ (i t : ℕ) (y : Abelian.Ext (ModuleCat.of C (C ⧸ I ^ t))
          ((ModuleCat.restrictScalars φ).obj E) (i + 1)),
        ∃ (t' : ℕ) (ht : t ≤ t'), (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right ht : I ^ t' ≤ I ^ t)))).comp y (zero_add (i + 1)) = 0 :=
by
  classical
  let adj := ModuleCat.restrictCoextendScalarsAdj.{u} φ
  let E'₀ : ModuleCat.{u} C := Injective.under ((ModuleCat.restrictScalars.{u} φ).obj N)
  have hinj0 : Injective E'₀ := Injective.injective_under _
  haveI hminj : Module.Injective C E'₀ := (Module.injective_iff_injective_object C E'₀).mpr hinj0
  haveI hfin : Module.Finite C ((ModuleCat.restrictScalars φ).obj (ModuleCat.of B B)) := hφ
  let eqv := ModuleCat.CoextendScalars.equiv φ E'₀
  have hsmul : ∀ (a : C) (x : (ModuleCat.restrictScalars φ).obj
      ((ModuleCat.coextendScalars φ).obj E'₀)),
      eqv.toAddEquiv (a • x) = a • eqv.toAddEquiv x := by
    intro a x
    apply LinearMap.ext
    intro s
    let x' : (ModuleCat.coextendScalars φ).obj E'₀ := x
    let s' : B := s
    have h3 : eqv (φ a • x') s = eqv x' (s' * φ a) :=
      ModuleCat.CoextendScalars.smul_apply φ E'₀ x' (φ a) s
    have h2 : (s' * φ a : B) = (a • s : (ModuleCat.restrictScalars φ).obj (ModuleCat.of B B)) := by
      rw [mul_comm]; exact (ModuleCat.restrictScalars.smul_def φ a s).symm
    change eqv (φ a • x') s = a • eqv x' s
    rw [h3, h2, LinearMap.map_smul]
  let L : ((ModuleCat.restrictScalars φ).obj ((ModuleCat.coextendScalars φ).obj E'₀)) ≃ₗ[C]
      (((ModuleCat.restrictScalars φ).obj (ModuleCat.of B B)) →ₗ[C] E'₀) :=
    AddEquiv.toLinearEquiv eqv.toAddEquiv hsmul
  let e : (ModuleCat.restrictScalars φ).obj ((ModuleCat.coextendScalars φ).obj E'₀) ≅
      ModuleCat.of C (((ModuleCat.restrictScalars φ).obj (ModuleCat.of B B)) →ₗ[C] E'₀) :=
    L.toModuleIso
  refine ⟨(ModuleCat.coextendScalars φ).obj E'₀,
    adj.unit.app N ≫ (ModuleCat.coextendScalars φ).map
      (Injective.ι ((ModuleCat.restrictScalars.{u} φ).obj N)),
    Injective.injective_of_adjoint adj E'₀, ?_, ?_⟩
  · have := adj.unit_mono_of_L_faithful N
    have := Injective.ι_mono ((ModuleCat.restrictScalars.{u} φ).obj N)
    exact mono_comp _ _
  · intro i t y
    obtain ⟨t', ht, h⟩ := hcoind E'₀ i ((ModuleCat.restrictScalars φ).obj (ModuleCat.of B B)) t
      (y.comp (Abelian.Ext.mk₀ e.hom) (add_zero _))
    refine ⟨t', ht, ?_⟩
    have hy : y = (y.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)).comp
        (Abelian.Ext.mk₀ e.inv) (add_zero _) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    rw [hy, ← Abelian.Ext.comp_assoc_of_third_deg_zero, h, Abelian.Ext.zero_comp]

theorem wc_plt_hlct_base_chase (C B : Type u) [CommRing C] [CommRing B] (φ : C →+* B) (I : Ideal C)
    (q : ∀ t : ℕ, ModuleCat.of C (C ⧸ I ^ t) ⟶
      (ModuleCat.restrictScalars φ).obj (ModuleCat.of B (B ⧸ (I.map φ) ^ t)))
    (hq : ∀ (t : ℕ) (a : C), (q t).hom (Submodule.Quotient.mk a) =
      (Submodule.Quotient.mk (φ a) : B ⧸ (I.map φ) ^ t))
    (h0inj : ∀ (t : ℕ) (N : ModuleCat.{u} B) (x : ModuleCat.of B (B ⧸ (I.map φ) ^ t) ⟶ N),
       q t ≫ (ModuleCat.restrictScalars φ).map x = 0 → x = 0)
    (h0lift : ∀ (t : ℕ) (E : ModuleCat.{u} B)
       (w : ModuleCat.of C (C ⧸ I ^ t) ⟶ (ModuleCat.restrictScalars φ).obj E),
       ∃ v : ModuleCat.of B (B ⧸ (I.map φ) ^ t) ⟶ E, q t ≫ (ModuleCat.restrictScalars φ).map v = w)
    (hE : ∀ N : ModuleCat.{u} B, ∃ (E : ModuleCat.{u} B) (ι : N ⟶ E), Injective E ∧ Mono ι ∧
      ∀ (i t : ℕ) (y : Abelian.Ext (ModuleCat.of C (C ⧸ I ^ t))
          ((ModuleCat.restrictScalars φ).obj E) (i + 1)),
        ∃ (t' : ℕ) (ht : t ≤ t'), (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right ht : I ^ t' ≤ I ^ t)))).comp y (zero_add (i + 1)) = 0)
    (i : ℕ) (N : ModuleCat.{u} B) (t : ℕ) (y : Abelian.Ext (ModuleCat.of B (B ⧸ (I.map φ) ^ t)) N i)
    (t' : ℕ) (ht : t ≤ t')
    (hy : (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : I ^ t' ≤ I ^ t)))).comp
      ((Abelian.Ext.mk₀ (q t)).comp
        (Abelian.Ext.mapExactFunctor (ModuleCat.restrictScalars.{u} φ) y) (zero_add i))
          (zero_add i) = 0) :
    ∃ (t'' : ℕ) (ht'' : t ≤ t''),
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht'' : (I.map φ) ^ t'' ≤ (I.map φ) ^ t)))).comp y (zero_add i) = 0 :=
by

  have trans : ∀ (M : ModuleCat.{u} B) (i t t₁ t₂ : ℕ) (h₁ : t ≤ t₁) (h₂ : t₁ ≤ t₂)
      (y : Abelian.Ext (ModuleCat.of B (B ⧸ (I.map φ) ^ t)) M i),
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right h₂ : (I.map φ) ^ t₂ ≤ (I.map φ) ^ t₁)))).comp
        ((Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right h₁ : (I.map φ) ^ t₁ ≤ (I.map φ) ^ t)))).comp y (zero_add i))
          (zero_add i) =
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right (h₁.trans h₂) : (I.map φ) ^ t₂ ≤ (I.map φ) ^ t)))).comp y
          (zero_add i) := by
    intro M i t t₁ t₂ h₁ h₂ y
    have hm : ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right h₂ : (I.map φ) ^ t₂ ≤ (I.map φ) ^ t₁)) ≫
        ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right h₁ : (I.map φ) ^ t₁ ≤ (I.map φ) ^ t)) =
        ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right (h₁.trans h₂) : (I.map φ) ^ t₂ ≤ (I.map φ) ^ t)) := by
      apply ModuleCat.hom_ext
      apply Submodule.linearMap_qext
      apply LinearMap.ext
      intro a
      rfl
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, hm]

  have reindex : ∀ (i : ℕ) (N : ModuleCat.{u} B) (t t₁ : ℕ) (h : t ≤ t₁)
      (w : Abelian.Ext (ModuleCat.of B (B ⧸ (I.map φ) ^ t)) N i),
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right h : I ^ t₁ ≤ I ^ t)))).comp
        ((Abelian.Ext.mk₀ (q t)).comp
          (Abelian.Ext.mapExactFunctor (ModuleCat.restrictScalars.{u} φ) w) (zero_add i))
          (zero_add i) =
      (Abelian.Ext.mk₀ (q t₁)).comp
        (Abelian.Ext.mapExactFunctor (ModuleCat.restrictScalars.{u} φ)
          ((Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
            (Ideal.pow_le_pow_right h : (I.map φ) ^ t₁ ≤ (I.map φ) ^ t)))).comp w (zero_add i)))
        (zero_add i) := by
    intro i N t t₁ h w
    have hm : ModuleCat.ofHom (Submodule.factor (Ideal.pow_le_pow_right h : I ^ t₁ ≤ I ^ t)) ≫
        q t = q t₁ ≫ (ModuleCat.restrictScalars φ).map (ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right h : (I.map φ) ^ t₁ ≤ (I.map φ) ^ t))) := by
      apply ModuleCat.hom_ext
      apply Submodule.linearMap_qext
      apply LinearMap.ext
      intro a
      change (q t).hom (Submodule.Quotient.mk a) =
        (Submodule.factor (Ideal.pow_le_pow_right h : (I.map φ) ^ t₁ ≤ (I.map φ) ^ t))
          ((q t₁).hom (Submodule.Quotient.mk a))
      rw [hq, hq]
      rfl
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀_assoc, hm]

  have P : ∀ (i : ℕ) (N : ModuleCat.{u} B) (t : ℕ)
      (z : Abelian.Ext (ModuleCat.of B (B ⧸ (I.map φ) ^ t)) N i),
      (Abelian.Ext.mk₀ (q t)).comp
        (Abelian.Ext.mapExactFunctor (ModuleCat.restrictScalars.{u} φ) z) (zero_add i) = 0 →
      ∃ (t'' : ℕ) (ht'' : t ≤ t''),
        (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right ht'' : (I.map φ) ^ t'' ≤ (I.map φ) ^ t)))).comp z
          (zero_add i) = 0 := by
    intro i
    induction i with
    | zero =>
      intro N t z hz
      obtain ⟨x, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 z
      rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.mk₀_eq_zero_iff] at hz
      rw [h0inj t N x hz, Abelian.Ext.mk₀_zero]
      exact ⟨t, le_refl t, Abelian.Ext.comp_zero _ _ _ _ _⟩
    | succ k ih =>
      intro N t z hz
      obtain ⟨E, ι, hEinj, hι, hkill⟩ := hE N
      let S : ShortComplex (ModuleCat.{u} B) :=
        ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) hι inferInstance
      have : Injective S.X₂ := hEinj
      have hz0 : (z : Abelian.Ext _ S.X₁ (k + 1)).comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
        Abelian.Ext.eq_zero_of_injective _
      obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS _ hz0 (rfl : k + 1 = k + 1)
      have hFS : (S.map (ModuleCat.restrictScalars.{u} φ)).ShortExact := hS.map_of_exact _
      have hFz : Abelian.Ext.mapExactFunctor (ModuleCat.restrictScalars.{u} φ) z =
          (Abelian.Ext.mapExactFunctor (ModuleCat.restrictScalars.{u} φ) w).comp hFS.extClass rfl := by
        rw [← hw, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass]
      have h3 : ((Abelian.Ext.mk₀ (q t)).comp
          (Abelian.Ext.mapExactFunctor (ModuleCat.restrictScalars.{u} φ) w) (zero_add k)).comp
            hFS.extClass rfl = 0 := by
        rw [Abelian.Ext.comp_assoc _ _ _ (zero_add k) rfl (show 0 + k + 1 = k + 1 by omega),
          ← hFz]
        exact hz
      obtain ⟨x, hx⟩ := Abelian.Ext.covariant_sequence_exact₃ _ hFS _ (rfl : k + 1 = k + 1) h3
      cases k with
      | zero =>
        obtain ⟨w₀, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 w
        obtain ⟨x₀, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x
        rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
          Abelian.Ext.mk₀_comp_mk₀] at hx
        have hx' := (Abelian.Ext.mk₀_bijective _ _).1 hx
        obtain ⟨v, hv⟩ := h0lift t E x₀
        have hw0 : w₀ = v ≫ S.g := by
          rw [← sub_eq_zero]
          apply h0inj t
          rw [Functor.map_sub, Preadditive.comp_sub, Functor.map_comp, ← Category.assoc, hv,
            ← hx']
          exact sub_self _
        have hzz : z = 0 := by
          rw [← hw, hw0, ← Abelian.Ext.mk₀_comp_mk₀,
            Abelian.Ext.comp_assoc_of_second_deg_zero, hS.comp_extClass, Abelian.Ext.comp_zero]
        refine ⟨t, le_refl t, ?_⟩
        rw [hzz, Abelian.Ext.comp_zero]
      | succ j =>
        obtain ⟨t₁, h₁, hx1⟩ := hkill j t x
        have h4 : (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
            (Ideal.pow_le_pow_right h₁ : I ^ t₁ ≤ I ^ t)))).comp
            ((Abelian.Ext.mk₀ (q t)).comp
              (Abelian.Ext.mapExactFunctor (ModuleCat.restrictScalars.{u} φ) w) (zero_add (j + 1)))
            (zero_add (j + 1)) = 0 := by
          rw [← hx, ← Abelian.Ext.comp_assoc_of_third_deg_zero, hx1, Abelian.Ext.zero_comp]
        rw [reindex _ _ _ _ h₁] at h4
        obtain ⟨t'', h₂, h5⟩ := ih S.X₃ t₁ _ h4
        rw [trans _ _ _ _ _ h₁ h₂] at h5
        refine ⟨t'', h₁.trans h₂, ?_⟩
        rw [← hw, ← Abelian.Ext.comp_assoc _ _ _ (zero_add (j + 1)) rfl
          (show 0 + (j + 1) + 1 = j + 1 + 1 by omega), h5, Abelian.Ext.zero_comp]

  have hy' := hy
  rw [reindex _ _ _ _ ht] at hy'
  obtain ⟨t'', h₃, h6⟩ := P i N t' _ hy'
  rw [trans _ _ _ _ _ ht h₃] at h6
  exact ⟨t'', ht.trans h₃, h6⟩

theorem wc_plt_hlc_top_transfer (C : Type u) [CommRing C] [IsNoetherianRing C] (B : Type u)
    [CommRing B] [IsNoetherianRing B] (φ : C →+* B) (hφ : φ.Finite) (n : ℕ) (c : Fin n → C)
    (h : Limits.IsZero ((localCohomology (Ideal.span (Set.range c)) n).obj (ModuleCat.of C C))) :
    Limits.IsZero ((localCohomology (Ideal.span (Set.range (fun i => φ (c i)))) n).obj
      (ModuleCat.of B B)) :=
by
  classical

  have s1 : ∀ (A : Type u) [CommRing A] (J : Ideal A) (M : ModuleCat.{u} A) (i : ℕ),
      Limits.IsZero ((localCohomology J i).obj M) ↔
    ∀ (t : ℕ) (y : Abelian.Ext (ModuleCat.of A (A ⧸ J ^ t)) M i), ∃ (t' : ℕ) (ht : t ≤ t'),
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t)))).comp y (zero_add i) = 0 := by
    intro A _ J M i
    rw [wc_plt_lc_mv_vanishing_iff A J M i]
    obtain ⟨e, he⟩ := wc_plt_lc_mv_ext_comparison A M i
    constructor
    · intro H t y
      obtain ⟨t', ht, h0⟩ := H t ((e _).symm y)
      refine ⟨t', ht, ?_⟩
      have := he _ _ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t))) ((e _).symm y)
      rw [h0, map_zero, AddEquiv.apply_symm_apply] at this
      exact this.symm
    · intro H t y
      obtain ⟨t', ht, h0⟩ := H t (e _ y)
      refine ⟨t', ht, ?_⟩
      have := he _ _ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t))) y
      rw [h0] at this
      exact (AddEquiv.map_eq_zero_iff _).mp this
  set I : Ideal C := Ideal.span (Set.range c) with hI
  have hIB : Ideal.span (Set.range (fun i => φ (c i))) = I.map φ := by
    rw [hI, Ideal.map_span, ← Set.range_comp]
    rfl
  rw [hIB]

  have hle : ∀ t : ℕ, I ^ t ≤ Ideal.comap φ ((I.map φ) ^ t) := fun t => by
    rw [← Ideal.map_pow]
    exact Ideal.le_comap_map
  let q : ∀ t : ℕ, ModuleCat.of C (C ⧸ I ^ t) ⟶
      (ModuleCat.restrictScalars φ).obj (ModuleCat.of B (B ⧸ (I.map φ) ^ t)) := fun t =>
    ModuleCat.ofHom (Y := ((ModuleCat.restrictScalars φ).obj (ModuleCat.of B (B ⧸ (I.map φ) ^ t))))
      { toFun := fun x => Ideal.quotientMap ((I.map φ) ^ t) φ (hle t) x
        map_add' := fun x y => map_add _ x y
        map_smul' := fun a x => by
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
          change Ideal.quotientMap ((I.map φ) ^ t) φ (hle t) (Ideal.Quotient.mk _ (a * x)) =
            φ a • Ideal.quotientMap ((I.map φ) ^ t) φ (hle t) (Ideal.Quotient.mk _ x)
          rw [Ideal.quotientMap_mk, Ideal.quotientMap_mk, map_mul]
          exact Submodule.Quotient.mk_smul _ (φ a) (φ x) }
  have hq : ∀ (t : ℕ) (a : C), (q t).hom (Submodule.Quotient.mk a) =
      (Submodule.Quotient.mk (φ a) : B ⧸ (I.map φ) ^ t) := fun t a => rfl

  have h0inj : ∀ (t : ℕ) (N : ModuleCat.{u} B) (x : ModuleCat.of B (B ⧸ (I.map φ) ^ t) ⟶ N),
      q t ≫ (ModuleCat.restrictScalars φ).map x = 0 → x = 0 := by
    intro t N x hx
    have h1 := congrArg (fun g => g.hom (Submodule.Quotient.mk (1 : C))) hx
    change x.hom ((q t).hom (Submodule.Quotient.mk 1)) = 0 at h1
    rw [hq, map_one] at h1
    apply ModuleCat.hom_ext
    apply Submodule.linearMap_qext
    apply LinearMap.ext_ring
    change x.hom (Submodule.Quotient.mk 1) = 0
    exact h1
  have h0lift : ∀ (t : ℕ) (E : ModuleCat.{u} B)
      (w : ModuleCat.of C (C ⧸ I ^ t) ⟶ (ModuleCat.restrictScalars φ).obj E),
      ∃ v : ModuleCat.of B (B ⧸ (I.map φ) ^ t) ⟶ E,
        q t ≫ (ModuleCat.restrictScalars φ).map v = w := by
    intro t E w
    let e : E := w.hom (Submodule.Quotient.mk (1 : C))
    have hker : (I.map φ) ^ t ≤ LinearMap.ker (LinearMap.toSpanSingleton B E e) := by
      rw [← Ideal.map_pow, Ideal.map_le_iff_le_comap]
      intro a ha
      rw [Ideal.mem_comap, LinearMap.mem_ker, LinearMap.toSpanSingleton_apply]
      have h2 : (a • (Submodule.Quotient.mk (1 : C)) : C ⧸ I ^ t) = 0 := by
        rw [← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one, Submodule.Quotient.mk_eq_zero]
        exact ha
      have h3 := congrArg w.hom h2
      rw [map_smul, map_zero] at h3
      exact h3
    refine ⟨ModuleCat.ofHom (Submodule.liftQ _ (LinearMap.toSpanSingleton B E e) hker), ?_⟩
    apply ModuleCat.hom_ext
    apply Submodule.linearMap_qext
    apply LinearMap.ext_ring
    change (Submodule.liftQ _ (LinearMap.toSpanSingleton B E e) hker)
      ((q t).hom (Submodule.Quotient.mk 1)) = e
    rw [hq, map_one, Submodule.liftQ_apply, LinearMap.toSpanSingleton_apply, one_smul]

  have hC := (s1 C I (ModuleCat.of C C) n).mp h
  have hK : ∀ (K : ModuleCat.{u} C) (t : ℕ)
      (y : Abelian.Ext (ModuleCat.of C (C ⧸ I ^ t)) K (n + 1)),
      ∃ (t' : ℕ) (ht : t ≤ t'), (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : I ^ t' ≤ I ^ t)))).comp y (zero_add (n + 1)) = 0 :=
    fun K => (s1 C I K (n + 1)).mp (wc_plt_lc_cech_vanishing C n c K (n + 1) (by omega))
  haveI hfin : Module.Finite C ((ModuleCat.restrictScalars φ).obj (ModuleCat.of B B)) := hφ
  obtain ⟨m, π, hπ⟩ :=
    Module.Finite.exists_fin' C ((ModuleCat.restrictScalars φ).obj (ModuleCat.of B B))
  have hE := fun N : ModuleCat.{u} B => wc_plt_hlct_good_injective C B φ hφ I
    (fun E' _ _ _ i M _ _ _ t y =>
      wc_plt_hlct_coinduced_kill C I E' (wc_plt_hlct_artin_rees_extend C I E') i M t y) N

  rw [s1 B (I.map φ) (ModuleCat.of B B) n]
  intro t y
  obtain ⟨t', ht, hy⟩ := wc_plt_hlct_free_cover C I n hK hC m
    ((ModuleCat.restrictScalars φ).obj (ModuleCat.of B B))
    (ModuleCat.ofHom (Y := ((ModuleCat.restrictScalars φ).obj (ModuleCat.of B B))) π) hπ t
    ((Abelian.Ext.mk₀ (q t)).comp
      (Abelian.Ext.mapExactFunctor (ModuleCat.restrictScalars.{u} φ) y) (zero_add n))
  exact wc_plt_hlct_base_chase C B φ I q hq h0inj h0lift hE n (ModuleCat.of B B) t y t' ht hy

theorem wc_plt_hl_complete_core (K : Type u) [Field K] (B : Type u) [CommRing B] [IsDomain B]
    [IsNoetherianRing B] [IsLocalRing B] [Algebra K B]
    (hcomp : IsAdicComplete (IsLocalRing.maximalIdeal B) B)
    (hres : Function.Surjective ((IsLocalRing.residue B).comp (algebraMap K B)))
    (d : ℕ) (hd : ringKrullDim B = d) (P : Ideal B) [P.IsPrime]
    (hPm : P ≠ IsLocalRing.maximalIdeal B)
    (hP1 : ∀ Q : Ideal B, Q.IsPrime → P ≤ Q → Q = P ∨ Q = IsLocalRing.maximalIdeal B) :
    Limits.IsZero ((localCohomology P d).obj (ModuleCat.of B B)) :=
by
  classical
  rcases Nat.lt_or_ge d 2 with hd2 | hd2
  · interval_cases d
    · exfalso
      haveI : Ring.KrullDimLE 0 B := Ring.krullDimLE_iff.mpr hd.le
      exact hPm (IsLocalRing.eq_maximalIdeal (inferInstance : P.IsMaximal))
    · have hP0 : P = ⊥ := by
        by_contra hne
        haveI : Ring.KrullDimLE 1 B := Ring.krullDimLE_iff.mpr hd.le
        have := (Ring.krullDimLE_one_iff_of_isPrime_bot.mp this) P hne inferInstance
        exact hPm (IsLocalRing.eq_maximalIdeal this)
      have h := wc_plt_lc_cech_vanishing B 0 Fin.elim0 (ModuleCat.of B B) 1 (by norm_num)
      have hspan : Ideal.span (Set.range (Fin.elim0 : Fin 0 → B)) = P := by
        rw [hP0, Set.range_eq_empty, Ideal.span_empty]
      rw [hspan] at h
      exact h
  obtain ⟨k, rfl⟩ : ∃ k, d = k + 1 := ⟨d - 1, by omega⟩
  have hk : 1 ≤ k := by omega
  obtain ⟨w, y, x, hwP, hxP, hyP, hradP, hradm⟩ := wc_plt_hlc_param_choice B k hk hd P hPm hP1
  obtain ⟨ψ, hψX, hψi, hψf⟩ :=
    wc_plt_hlc_powerseries_eval K B hcomp hres (k + 1) hd (Fin.cons y x) hradm
  obtain ⟨hAdom, hAic, hAcomp⟩ := wc_plt_hlc_powerseries_normal K (k + 1)
  haveI := hAdom
  haveI := hAic
  obtain ⟨f, φ, hfm, hφi, hφf, hφroot, hφof⟩ :=
    wc_plt_hlc_minpoly_model (MvPowerSeries (Fin (k + 1)) K) B
      (ψ : MvPowerSeries (Fin (k + 1)) K →+* B) hψi hψf w
  have hφA : ∀ a, φ (AdjoinRoot.of f a) = ψ a := fun a => by
    have := congrArg (fun g : MvPowerSeries (Fin (k + 1)) K →+* B => g a) hφof
    exact this

  haveI hCdom : IsDomain (AdjoinRoot f) := Function.Injective.isDomain φ hφi
  have hφint : φ.IsIntegral := RingHom.IsIntegral.of_finite hφf
  haveI hφloc : IsLocalHom φ := hφint.isLocalHom hφi
  haveI hCloc : IsLocalRing (AdjoinRoot f) :=
    IsLocalRing.of_isUnit_or_isUnit_one_sub_self (fun a => by
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (φ a) with h | h
      · exact Or.inl (isUnit_of_map_unit φ a h)
      · refine Or.inr (isUnit_of_map_unit φ _ ?_)
        rw [map_sub, map_one]
        exact h)
  haveI hCfin : Module.Finite (MvPowerSeries (Fin (k + 1)) K) (AdjoinRoot f) :=
    (AdjoinRoot.powerBasis' hfm).finite
  have hψint : (ψ : MvPowerSeries (Fin (k + 1)) K →+* B).IsIntegral :=
    RingHom.IsIntegral.of_finite hψf
  haveI hψloc : IsLocalHom (ψ : MvPowerSeries (Fin (k + 1)) K →+* B) := hψint.isLocalHom hψi
  haveI : IsLocalHom (algebraMap (MvPowerSeries (Fin (k + 1)) K) (AdjoinRoot f)) := by
    rw [AdjoinRoot.algebraMap_eq]
    haveI : IsLocalHom (φ.comp (AdjoinRoot.of f)) := by rw [hφof]; exact hψloc
    exact isLocalHom_of_comp (AdjoinRoot.of f) φ
  have hCcomp := wc_plt_hlc_finite_complete (MvPowerSeries (Fin (k + 1)) K) (AdjoinRoot f) hAcomp

  set c : Fin (k + 1) → AdjoinRoot f :=
    Fin.cons (AdjoinRoot.root f) (fun i => AdjoinRoot.of f (MvPowerSeries.X i.succ)) with hc
  set s0 : AdjoinRoot f := AdjoinRoot.of f (MvPowerSeries.X 0) with hs0
  have hφc : ∀ i, φ (c i) = (Fin.cons w x : Fin (k + 1) → B) i := by
    intro i
    induction i using Fin.cases with
    | zero =>
      simp only [hc, Fin.cons_zero]
      exact hφroot
    | succ j =>
      simp only [hc, Fin.cons_succ]
      rw [hφA, hψX]
      simp only [Fin.cons_succ]
  have hφs0 : φ s0 = y := by
    rw [hs0, hφA, hψX]
    simp only [Fin.cons_zero]
  set Q : Ideal (AdjoinRoot f) := Ideal.comap φ P with hQ
  haveI hQprime : Q.IsPrime := Ideal.comap_isPrime φ P
  have hs0Q : s0 ∉ Q := by
    intro h
    have h' : φ s0 ∈ P := h
    rw [hφs0] at h'
    exact hyP h'
  have hym : y ∈ IsLocalRing.maximalIdeal B := by
    rw [← hradm]
    apply Ideal.le_radical
    apply Ideal.subset_span
    exact ⟨0, rfl⟩
  have hs0m : s0 ∈ IsLocalRing.maximalIdeal (AdjoinRoot f) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have := hu.map φ
    rw [hφs0] at this
    exact (mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hym)) this
  have hQm : Q ≠ IsLocalRing.maximalIdeal (AdjoinRoot f) := by
    intro h
    apply hs0Q
    rw [h]
    exact hs0m
  have hcomapm : Ideal.comap φ (IsLocalRing.maximalIdeal B) =
      IsLocalRing.maximalIdeal (AdjoinRoot f) := by
    haveI := Ideal.isMaximal_comap_of_isIntegral_of_isMaximal φ hφint
      (IsLocalRing.maximalIdeal B)
    exact IsLocalRing.eq_maximalIdeal inferInstance

  have hover : ∀ (Q' : Ideal (AdjoinRoot f)) (I : Ideal B), Q'.IsPrime →
      Ideal.comap φ I ≤ Q' → ∃ P' : Ideal B, I ≤ P' ∧ P'.IsPrime ∧ Ideal.comap φ P' = Q' := by
    intro Q' I hQ' hI
    letI := φ.toAlgebra
    haveI := hQ'
    haveI : Algebra.IsIntegral (AdjoinRoot f) B := ⟨fun b => hφint b⟩
    obtain ⟨P', hIP', hP', hP'Q⟩ := Ideal.exists_ideal_over_prime_of_isIntegral Q' I hI
    exact ⟨P', hIP', hP', hP'Q⟩
  have hQ1 : ∀ Q' : Ideal (AdjoinRoot f), Q'.IsPrime → Q ≤ Q' →
      Q' = Q ∨ Q' = IsLocalRing.maximalIdeal (AdjoinRoot f) := by
    intro Q' hQ' hQQ'
    obtain ⟨P', hPP', hP', hP'Q⟩ := hover Q' P hQ' hQQ'
    rcases hP1 P' hP' hPP' with h | h
    · left
      rw [← hP'Q, h]
    · right
      rw [← hP'Q, h, hcomapm]
  have hradQ : (Ideal.span (Set.range c)).radical = Q.radical := by
    rw [hQprime.radical]
    apply le_antisymm
    · refine (Ideal.radical_mono (Ideal.span_le.mpr ?_)).trans hQprime.radical.le
      rintro _ ⟨i, rfl⟩
      show φ (c i) ∈ P
      rw [hφc i]
      induction i using Fin.cases with
      | zero => simpa using hwP
      | succ j => simpa using hxP j
    · rw [Ideal.radical_eq_sInf]
      refine le_sInf ?_
      rintro Q' ⟨hcQ', hQ'⟩
      have hbot : Ideal.comap φ ⊥ ≤ Q' := by
        intro a ha
        have h0 : φ a = 0 := Ideal.mem_bot.mp ha
        rw [hφi (h0.trans (map_zero φ).symm)]
        exact Q'.zero_mem
      obtain ⟨P', -, hP', hP'Q⟩ := hover Q' ⊥ hQ' hbot
      have hsP' : Ideal.span (Set.range (Fin.cons w x : Fin (k + 1) → B)) ≤ P' := by
        rw [Ideal.span_le]
        rintro _ ⟨i, rfl⟩
        rw [← hφc i]
        have h1 : c i ∈ Q' := hcQ' (Ideal.subset_span ⟨i, rfl⟩)
        rw [← hP'Q] at h1
        exact h1
      have hPP' : P ≤ P' := by
        rw [← hradP, ← hP'.radical]
        exact Ideal.radical_mono hsP'
      rw [← hP'Q]
      exact Ideal.comap_mono hPP'

  have hext : ∀ J : Ideal (AdjoinRoot f), (∀ a s : AdjoinRoot f, s ∉ Q → s * a ∈ J → a ∈ J) →
      Limits.IsZero (((Ext (AdjoinRoot f) (ModuleCat.{u} (AdjoinRoot f)) (k + 1)).obj
        (Opposite.op (ModuleCat.of (AdjoinRoot f) (AdjoinRoot f ⧸ J)))).obj
          (ModuleCat.of (AdjoinRoot f) (AdjoinRoot f))) := by
    intro J hJ
    let N := (ModuleCat.restrictScalars (algebraMap (MvPowerSeries (Fin (k + 1)) K)
      (AdjoinRoot f))).obj (ModuleCat.of (AdjoinRoot f) (AdjoinRoot f ⧸ J))
    let g : AdjoinRoot f →ₗ[MvPowerSeries (Fin (k + 1)) K] N :=
      { toFun := fun c' => Ideal.Quotient.mk J c'
        map_add' := fun a b => map_add _ a b
        map_smul' := fun a c' => by
          change Ideal.Quotient.mk J (a • c') =
            (algebraMap (MvPowerSeries (Fin (k + 1)) K) (AdjoinRoot f) a) •
              Ideal.Quotient.mk J c'
          simp only [Algebra.smul_def, map_mul, Ideal.Quotient.algebraMap_eq] }
    haveI : Module.Finite (MvPowerSeries (Fin (k + 1)) K) N :=
      Module.Finite.of_surjective g (fun v => by
        obtain ⟨c', hc'⟩ := Ideal.Quotient.mk_surjective (I := J) v
        exact ⟨c', hc'⟩)
    have hreg : ∀ v : N, (MvPowerSeries.X 0 : MvPowerSeries (Fin (k + 1)) K) • v = 0 → v = 0 := by
      intro v hv
      obtain ⟨c', rfl⟩ := Ideal.Quotient.mk_surjective (I := J) v
      change (algebraMap (MvPowerSeries (Fin (k + 1)) K) (AdjoinRoot f) (MvPowerSeries.X 0)) •
        (Ideal.Quotient.mk J c') = 0 at hv
      rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul,
        Ideal.Quotient.eq_zero_iff_mem, AdjoinRoot.algebraMap_eq] at hv
      change Ideal.Quotient.mk J c' = 0
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact hJ c' s0 hs0Q hv
    have h1 := wc_plt_hlc_powerseries_ext_vanish K k N hreg
    exact wc_plt_hlc_hypersurface_ext (MvPowerSeries (Fin (k + 1)) K) f hfm
      (ModuleCat.of (AdjoinRoot f) (AdjoinRoot f ⧸ J)) (k + 1) h1
  have hQzero := wc_plt_hlc_symbolic_reduction (AdjoinRoot f) hCcomp Q hQm hQ1 (k + 1) hext
  have hczero : Limits.IsZero ((localCohomology (Ideal.span (Set.range c)) (k + 1)).obj
      (ModuleCat.of (AdjoinRoot f) (AdjoinRoot f))) :=
    hQzero.of_iso ((localCohomology.isoOfSameRadical hradQ (k + 1)).app _)
  have hBzero := wc_plt_hlc_top_transfer (AdjoinRoot f) B φ hφf (k + 1) c hczero
  have hfun : (fun i => φ (c i)) = (Fin.cons w x : Fin (k + 1) → B) := funext hφc
  rw [hfun] at hBzero
  have hradB : (Ideal.span (Set.range (Fin.cons w x : Fin (k + 1) → B))).radical = P.radical := by
    rw [hradP, Ideal.IsPrime.radical inferInstance]
  exact hBzero.of_iso ((localCohomology.isoOfSameRadical hradB.symm (k + 1)).app _)

theorem wc_plt_lc_hartshorne_lichtenbaum_graded (K : Type u) [Field K] (R : Type u) [CommRing R]
    [IsDomain R] [IsNoetherianRing R] [Algebra K R] (𝒜 : ℕ → Submodule K R) [GradedAlgebra 𝒜]
    (h𝒜0 : ∀ x : R, x ∈ 𝒜 0 ↔ x ∈ Set.range (algebraMap K R))
    [(HomogeneousIdeal.irrelevant 𝒜).toIdeal.IsPrime] (d : ℕ)
    (hd : ringKrullDim (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal) = d)
    (J : Ideal (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
    (hJ : J.radical ≠
      IsLocalRing.maximalIdeal (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)) :
    Limits.IsZero ((localCohomology J d).obj (ModuleCat.of _
      (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))) :=
by
  classical

  have htop : ∀ (T : Type u) [CommRing T] (i : ℕ),
      Limits.IsZero ((localCohomology (⊤ : Ideal T) i).obj (ModuleCat.of T T)) := by
    intro T _ i
    have hExt : ∀ (X : ModuleCat.{u} T), Limits.IsZero X →
        Limits.IsZero (((Ext T (ModuleCat.{u} T) i).obj (Opposite.op X)).obj
          (ModuleCat.of T T)) := by
      intro X hX
      have : Projective X := hX.projective
      have e := (ProjectiveResolution.self X).isoLeftDerivedObj
        ((linearYoneda T (ModuleCat.{u} T)).obj (ModuleCat.of T T)).rightOp i
      refine (Limits.IsZero.of_iso ?_ e).unop
      have hXi : Limits.IsZero (((((linearYoneda T (ModuleCat.{u} T)).obj
          (ModuleCat.of T T)).rightOp.mapHomologicalComplex (ComplexShape.down ℕ)).obj
          (ProjectiveResolution.self X).complex).X i) := by
        show Limits.IsZero (((linearYoneda T (ModuleCat.{u} T)).obj (ModuleCat.of T T)).rightOp.obj
          ((ProjectiveResolution.self X).complex.X i))
        apply Functor.map_isZero
        cases i with
        | zero => exact hX
        | succ n => exact Limits.isZero_zero _
      exact ShortComplex.isZero_homology_of_isZero_X₂ _ hXi
    refine Limits.IsZero.of_iso ?_ (Limits.colimitObjIsoColimitCompEvaluation _ _)
    apply Limits.IsColimit.isZero_pt (Limits.colimit.isColimit _)
    apply Functor.isZero
    intro t
    have hsub : Subsingleton (T ⧸ (⊤ : Ideal T) ^ (Opposite.unop (Opposite.unop t))) :=
      Ideal.Quotient.subsingleton_iff.mpr (Ideal.top_pow _ _)
    exact hExt (ModuleCat.of T (T ⧸ (⊤ : Ideal T) ^ (Opposite.unop (Opposite.unop t))))
      (ModuleCat.isZero_of_subsingleton _)
  haveI hA : IsNoetherianRing (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal) :=
    IsLocalization.isNoetherianRing (HomogeneousIdeal.irrelevant 𝒜).toIdeal.primeCompl _
      inferInstance
  obtain ⟨hBN, hBD, hBC, hBd, hBres⟩ := wc_plt_hl_graded_completion K R 𝒜 h𝒜0
  haveI := hBN
  haveI := hBD
  have hdB : ringKrullDim (AdicCompletion (IsLocalRing.maximalIdeal
      (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
      (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)) = d := hBd.trans hd
  have hrad := wc_plt_hl_completion_radical _ J hJ
  apply wc_plt_hl_completion_transfer _ J d
  by_cases hJB : J.map (algebraMap (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)
      (AdicCompletion (IsLocalRing.maximalIdeal
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))) = ⊤
  · rw [hJB]
    exact htop _ d

  obtain ⟨P, hP, hJP, hPm, hP1⟩ : ∃ P : Ideal (AdicCompletion (IsLocalRing.maximalIdeal
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)), P.IsPrime ∧
      J.map (algebraMap (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)
        (AdicCompletion (IsLocalRing.maximalIdeal
          (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
          (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))) ≤ P ∧
      P ≠ IsLocalRing.maximalIdeal _ ∧
      ∀ Q, Q.IsPrime → P ≤ Q → Q = P ∨ Q = IsLocalRing.maximalIdeal _ := by
    have hJBm := IsLocalRing.le_maximalIdeal hJB
    obtain ⟨p0, ⟨hJp0, hp0⟩, hp0m⟩ : ∃ p0 ∈ {I | J.map (algebraMap
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)
        (AdicCompletion (IsLocalRing.maximalIdeal
          (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
          (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))) ≤ I ∧ I.IsPrime},
        p0 ≠ IsLocalRing.maximalIdeal _ := by
      by_contra hcon
      push_neg at hcon
      apply hrad
      rw [Ideal.radical_eq_sInf]
      apply le_antisymm
      · exact sInf_le ⟨hJBm, (IsLocalRing.maximalIdeal.isMaximal _).isPrime⟩
      · exact le_sInf (fun I hI => (hcon I hI).ge)
    obtain ⟨P, ⟨hP, hp0P, hPm⟩, hmax⟩ := (wellFounded_gt (α := Ideal (AdicCompletion
        (IsLocalRing.maximalIdeal
          (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)))).has_min
      {P | P.IsPrime ∧ p0 ≤ P ∧ P ≠ IsLocalRing.maximalIdeal _} ⟨p0, hp0, le_rfl, hp0m⟩
    refine ⟨P, hP, hJp0.trans hp0P, hPm, fun Q hQ hPQ => ?_⟩
    by_cases hQm : Q = IsLocalRing.maximalIdeal _
    · exact Or.inr hQm
    · left
      by_contra hne
      exact hmax Q ⟨hQ, hp0P.trans hPQ, hQm⟩ (lt_of_le_of_ne hPQ (Ne.symm hne))
  haveI := hP
  have hcore := wc_plt_hl_complete_core K _ hBC hBres d hdB P hPm hP1
  exact wc_plt_hl_enlarge _ d hdB _ P hJP (IsLocalRing.le_maximalIdeal hP.ne_top) hcore

theorem wc_plt_fulton_hansen_line (K : Type u) [Field K] [IsAlgClosed K] (N : ℕ) (hN : 2 ≤ N)
    (Z : Scheme.{u}) [IrreducibleSpace Z] (ν : Z ⟶ wcProjK K N) [IsFinite ν] [Surjective ν]
    (Lf : Fin (N - 1) → MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1)
    (hLf : LinearIndependent K (fun a => (Lf a : MvPolynomial (Fin (N + 1)) K))) :
    _root_.IsPreconnected (⇑ν ⁻¹' {x : ↥(wcProjK K N) | ∀ a, x ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) MvPolynomial.gradedAlgebra
        (Lf a : MvPolynomial (Fin (N + 1)) K)}) :=
by
  classical
  obtain ⟨R, _, _, _, _, 𝒜, _, φ, h𝒜0, hφi, hφf, hφ1, g, hg, hgV⟩ :=
    wc_plt_fh_cone_model K N Z ν Lf
  obtain ⟨hm, d, hd, hdim⟩ := wc_plt_fh_cone_dim K N R 𝒜 h𝒜0 φ hφi hφf hφ1
  rw [← hgV]
  refine IsPreconnected.image ?_ g hg
  by_contra hV
  have hf : ∀ a, (fun a => φ (Lf a : MvPolynomial (Fin (N + 1)) K)) a ∈ 𝒜 1 :=
    fun a => hφ1 _ (Lf a).2
  obtain ⟨J₁, J₂, h12, hsup, hJ1, hJ2⟩ := wc_plt_fh_disconnect_ideals K R 𝒜 h𝒜0 (N - 1)
    (fun a => φ (Lf a : MvPolynomial (Fin (N + 1)) K)) hf hV
  haveI hA : IsNoetherianRing (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal) :=
    IsLocalization.isNoetherianRing (HomogeneousIdeal.irrelevant 𝒜).toIdeal.primeCompl _
      inferInstance
  obtain ⟨n, rfl⟩ : ∃ n, d = n + 1 := ⟨d - 1, by omega⟩
  have h4 := wc_plt_lc_cech_vanishing
    (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal) (N - 1)
    (fun a => algebraMap R (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)
      (φ (Lf a : MvPolynomial (Fin (N + 1)) K)))
    (ModuleCat.of _ (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)) n
    (by omega)
  have h4' : Limits.IsZero ((localCohomology (J₁ ⊓ J₂) n).obj
      (ModuleCat.of _ (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))) :=
    h4.of_iso ((localCohomology.isoOfSameRadical h12 n).app _)
  have h7a := wc_plt_lc_hartshorne_lichtenbaum_graded K R 𝒜 h𝒜0 (n + 1) hdim J₁ hJ1
  have h7b := wc_plt_lc_hartshorne_lichtenbaum_graded K R 𝒜 h𝒜0 (n + 1) hdim J₂ hJ2
  have h5 := wc_plt_lc_mayer_vietoris_zero
    (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal) J₁ J₂
    (ModuleCat.of _ (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)) n h4' h7a h7b
  have hrad : (IsLocalRing.maximalIdeal
      (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)).radical =
      (J₁ ⊔ J₂).radical := by
    rw [hsup]
    exact (IsLocalRing.maximalIdeal.isMaximal _).isPrime.radical
  have h5' := h5.of_iso ((localCohomology.isoOfSameRadical hrad (n + 1)).app _)
  exact wc_plt_lc_grothendieck_nonvanishing _ (n + 1) hdim h5'

theorem wc_plt_geom_line_range (F'' : Type u) [Field F''] (M' : ℕ)
    (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (hlamstr : lam ≫ wcProjKStr F'' M' = (wcP1Over F'').hom)
    (hlin : ∃ L : Fin (M' - 1) → MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) F'' 1,
      LinearIndependent F'' (fun a => (L a : MvPolynomial (Fin (M' + 1)) F'')) ∧
      Set.range lam = {x | ∀ a, x ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) F'') MvPolynomial.gradedAlgebra
        (L a : MvPolynomial (Fin (M' + 1)) F'')})
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (lb : Limits.pullback (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ⟶
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left)
    (hlb1 : lb ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
      Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ lam)
    (hlb2 : lb ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
      Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :
    ∃ (ψ : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left ≅
        wcProjK (AlgebraicClosure F'') M')
      (Lk : Fin (M' - 1) → MvPolynomial.homogeneousSubmodule (Fin (M' + 1))
        (AlgebraicClosure F'') 1),
      LinearIndependent (AlgebraicClosure F'')
        (fun a => (Lk a : MvPolynomial (Fin (M' + 1)) (AlgebraicClosure F''))) ∧
      ⇑ψ.hom ⁻¹' {x : ↥(wcProjK (AlgebraicClosure F'') M') | ∀ a, x ∉ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) (AlgebraicClosure F''))
        MvPolynomial.gradedAlgebra
        (Lk a : MvPolynomial (Fin (M' + 1)) (AlgebraicClosure F''))} = Set.range ⇑lb :=
by
  classical
  obtain ⟨L, hL, hrange⟩ := hlin
  have hPB := wc_ldnm_di_projmap_pb F'' (AlgebraicClosure F'') M'
  let ψ : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left ≅
      wcProjK (AlgebraicClosure F'') M' := hPB.isoPullback.symm
  have hψ : ψ.hom ≫ wcLdpProjMap F'' (AlgebraicClosure F'') M' =
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom :=
    hPB.isoPullback_inv_fst
  let Lk : Fin (M' - 1) → MvPolynomial.homogeneousSubmodule (Fin (M' + 1))
      (AlgebraicClosure F'') 1 := fun a =>
    ⟨MvPolynomial.map (algebraMap F'' (AlgebraicClosure F''))
        (L a : MvPolynomial (Fin (M' + 1)) F''),
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (((MvPolynomial.mem_homogeneousSubmodule 1 _).mp (L a).2).map _)⟩
  have hLk : LinearIndependent (AlgebraicClosure F'')
      (fun a => (Lk a : MvPolynomial (Fin (M' + 1)) (AlgebraicClosure F''))) := by
    have h1 := Module.Flat.linearIndependent_one_tmul (S := AlgebraicClosure F'') hL
    have h2 := h1.map'
      (MvPolynomial.algebraTensorAlgEquiv (σ := Fin (M' + 1)) F''
        (AlgebraicClosure F'')).toLinearEquiv.toLinearMap (LinearEquiv.ker _)
    convert h2 using 1
    funext a
    simp [Lk, MvPolynomial.algebraTensorAlgEquiv_tmul]
  refine ⟨ψ, Lk, hLk, ?_⟩
  have hsq : IsPullback lb (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom lam := by
    refine IsPullback.of_right
      (h₁₂ := Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
      (h₂₂ := wcProjKStr F'' M')
      (v₁₃ := Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ?_ hlb1 ?_
    · have key : ∀ (a : Limits.pullback (wcP1Over F'').hom
            (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ⟶
            Spec (.of (AlgebraicClosure F'')))
          (b : (wcP1Over F'').left ⟶ Spec (.of F'')),
          a = Limits.pullback.snd (wcP1Over F'').hom
            (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) →
          b = (wcP1Over F'').hom →
          IsPullback a (Limits.pullback.fst (wcP1Over F'').hom
            (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
            (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) b := by
        rintro a b rfl rfl
        exact (IsPullback.of_hasPullback _ _).flip
      exact key _ _ hlb2 hlamstr
    · exact (IsPullback.of_hasPullback _ _).flip
  have hrl : Set.range ⇑lb =
      ⇑(wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom ⁻¹' Set.range ⇑lam := by
    rw [← Scheme.Pullback.range_fst]
    ext x
    constructor
    · rintro ⟨y, rfl⟩
      refine ⟨hsq.isoPullback.hom y, ?_⟩
      rw [← Scheme.Hom.comp_apply, hsq.isoPullback_hom_fst]
    · rintro ⟨z, rfl⟩
      refine ⟨hsq.isoPullback.inv z, ?_⟩
      rw [← Scheme.Hom.comp_apply, hsq.isoPullback_inv_fst]
  rw [hrl, hrange]
  ext x
  simp only [Set.mem_preimage, Set.mem_setOf_eq]
  apply forall_congr'
  intro a
  apply not_congr
  have hb : wcLdpProjMap F'' (AlgebraicClosure F'') M' ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) F'') MvPolynomial.gradedAlgebra
        (L a : MvPolynomial (Fin (M' + 1)) F'') =
      @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) (AlgebraicClosure F''))
        MvPolynomial.gradedAlgebra
        (Lk a : MvPolynomial (Fin (M' + 1)) (AlgebraicClosure F'')) :=
    Proj.map_preimage_basicOpen _ _ _
  have hx : wcLdpProjMap F'' (AlgebraicClosure F'') M' (ψ.hom x) =
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom x := by
    rw [← Scheme.Hom.comp_apply, hψ]
  rw [← hb, Scheme.Hom.mem_preimage, hx]

theorem wc_plt_line_connected_glue (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens)
    (hUb : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      y ∈ Ub ↔ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∉ Δ)
    (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme) [IsFinite πE] [Etale πE]
    (lb : Limits.pullback (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ⟶
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left)
    (hlb1 : lb ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
      Limits.pullback.fst (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ lam)
    (hlb2 : lb ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
      Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))
    (Eb : Scheme.{u}) (ν : Eb ⟶ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left)
    [IsFinite ν] (j : E ⟶ Eb) (hj : IsPullback j πE ν Ub.ι)
    (hY : _root_.IsPreconnected (⇑ν ⁻¹' Set.range ⇑lb))
    (hU : ∀ y : ↥(Limits.pullback ν lb), lb (Limits.pullback.snd ν lb y) ∉ Ub →
        ∀ Z₁ ∈ irreducibleComponents (↥(Limits.pullback ν lb)),
        ∀ Z₂ ∈ irreducibleComponents (↥(Limits.pullback ν lb)), y ∈ Z₁ → y ∈ Z₂ → Z₁ = Z₂) :
    _root_.IsPreconnected (Set.univ : Set ↥(Limits.pullback πE (Limits.pullback.snd lb Ub.ι))) :=
by
  classical
  obtain ⟨_, _, _, _, _, _, _, hcl, hlamstr, _⟩ := id hH

  have s1 : ∀ {X : Type u} [TopologicalSpace X] (O : Set X)
      (hO : IsOpen O) (hfin : (irreducibleComponents X).Finite)
      (hX : _root_.IsPreconnected (Set.univ : Set X))
      (hU : ∀ y : X, y ∉ O → ∀ Z₁ ∈ irreducibleComponents X, ∀ Z₂ ∈ irreducibleComponents X,
        y ∈ Z₁ → y ∈ Z₂ → Z₁ = Z₂), _root_.IsPreconnected O := by
    intro X _ O hO hfin hX hU
    rw [isPreconnected_iff_subset_of_disjoint]
    intro U V hUo hVo hcov hdisj
    have hpre : ∀ Z ∈ irreducibleComponents X, IsPreirreducible Z := fun Z hZ =>
      (Maximal.prop hZ).isPreirreducible
    have hdich : ∀ Z ∈ irreducibleComponents X, Z ∩ O ⊆ U ∨ Z ∩ O ⊆ V := by
      intro Z hZ
      by_contra hcon
      rw [not_or, Set.not_subset, Set.not_subset] at hcon
      obtain ⟨⟨a, ⟨haZ, haO⟩, haU⟩, ⟨b, ⟨hbZ, hbO⟩, hbV⟩⟩ := hcon
      have haV : a ∈ V := ((hcov haO).resolve_left haU)
      have hbU : b ∈ U := ((hcov hbO).resolve_right hbV)
      obtain ⟨c, hcZ, ⟨hcO, hcU⟩, ⟨_, hcV⟩⟩ := hpre Z hZ (O ∩ U) (O ∩ V) (hO.inter hUo) (hO.inter hVo)
        ⟨b, hbZ, hbO, hbU⟩ ⟨a, haZ, haO, haV⟩
      have : c ∈ O ∩ (U ∩ V) := ⟨hcO, hcU, hcV⟩
      rw [hdisj] at this
      exact this
    set 𝒜 := {Z ∈ irreducibleComponents X | Z ∩ O ⊆ U} with h𝒜
    set ℬ := {Z ∈ irreducibleComponents X | ¬ (Z ∩ O ⊆ U)} with hℬ
    have hA : IsClosed (⋃₀ 𝒜) := (hfin.subset (fun Z hZ => hZ.1)).isClosed_sUnion
      (fun Z hZ => isClosed_of_mem_irreducibleComponents Z hZ.1)
    have hB : IsClosed (⋃₀ ℬ) := (hfin.subset (fun Z hZ => hZ.1)).isClosed_sUnion
      (fun Z hZ => isClosed_of_mem_irreducibleComponents Z hZ.1)
    have hcovAB : Set.univ ⊆ ⋃₀ 𝒜 ∪ ⋃₀ ℬ := by
      intro x _
      by_cases hx : irreducibleComponent x ∩ O ⊆ U
      · exact Or.inl ⟨irreducibleComponent x, ⟨irreducibleComponent_mem_irreducibleComponents x, hx⟩,
          mem_irreducibleComponent⟩
      · exact Or.inr ⟨irreducibleComponent x, ⟨irreducibleComponent_mem_irreducibleComponents x, hx⟩,
          mem_irreducibleComponent⟩
    have hdisjAB : Set.univ ∩ (⋃₀ 𝒜 ∩ ⋃₀ ℬ) = ∅ := by
      ext x
      simp only [Set.mem_inter_iff, Set.mem_univ, true_and, Set.mem_empty_iff_false, iff_false]
      rintro ⟨⟨Z₁, ⟨hZ₁, hZ₁U⟩, hx₁⟩, ⟨Z₂, ⟨hZ₂, hZ₂U⟩, hx₂⟩⟩
      by_cases hxO : x ∈ O
      · have hxU : x ∈ U := hZ₁U ⟨hx₁, hxO⟩
        have hxV : x ∈ V := ((hdich Z₂ hZ₂).resolve_left hZ₂U) ⟨hx₂, hxO⟩
        have : x ∈ O ∩ (U ∩ V) := ⟨hxO, hxU, hxV⟩
        rw [hdisj] at this
        exact this
      · have := hU x hxO Z₁ hZ₁ Z₂ hZ₂ hx₁ hx₂
        subst this
        exact hZ₂U hZ₁U
    rcases (isPreconnected_iff_subset_of_disjoint_closed.mp hX) _ _ hA hB hcovAB hdisjAB with h | h
    · left
      intro x hxO
      obtain ⟨Z, ⟨_, hZU⟩, hxZ⟩ := h (Set.mem_univ x)
      exact hZU ⟨hxZ, hxO⟩
    · right
      intro x hxO
      obtain ⟨Z, ⟨hZ, hZU⟩, hxZ⟩ := h (Set.mem_univ x)
      exact ((hdich Z hZ).resolve_left hZU) ⟨hxZ, hxO⟩

  have s2 : ∀ {Eb Pb P1 E : Scheme.{u}} (U : Pb.Opens) (πE : E ⟶ U.toScheme)
      (ν : Eb ⟶ Pb) (j : E ⟶ Eb) (lb : P1 ⟶ Pb) (hj : IsPullback j πE ν U.ι),
      ∃ φ : Limits.pullback πE (Limits.pullback.snd lb U.ι) ⟶ Limits.pullback ν lb,
        IsOpenImmersion φ ∧
        Set.range ⇑φ = {y | lb (Limits.pullback.snd ν lb y) ∈ U} := by
    intro Eb Pb P1 E U πE ν j lb hj
    have R1 := IsPullback.paste_horiz (IsPullback.of_hasPullback πE (Limits.pullback.snd lb U.ι)) hj
    rw [← Limits.pullback.condition] at R1
    have w : (Limits.pullback.fst πE (Limits.pullback.snd lb U.ι) ≫ j) ≫ ν =
        (Limits.pullback.snd πE (Limits.pullback.snd lb U.ι) ≫ Limits.pullback.fst lb U.ι) ≫ lb := by
      rw [R1.w, Category.assoc]
    refine ⟨Limits.pullback.lift _ _ w, ?_⟩
    have S : IsPullback (Limits.pullback.lift _ _ w)
        (Limits.pullback.snd πE (Limits.pullback.snd lb U.ι))
        (Limits.pullback.snd ν lb) (Limits.pullback.fst lb U.ι) := by
      refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _) (IsPullback.of_hasPullback ν lb)
      rw [Limits.pullback.lift_fst]
      exact R1
    refine ⟨MorphismProperty.of_isPullback (P := @IsOpenImmersion) S.flip inferInstance, ?_⟩
    have e := S.isoPullback_hom_fst
    have hsurj : Function.Surjective ⇑S.isoPullback.hom :=
      (Scheme.homeoOfIso S.isoPullback).surjective
    rw [← e, Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp, hsurj.range_eq, Set.image_univ,
      Scheme.Pullback.range_fst, Scheme.Pullback.range_fst, Scheme.Opens.range_ι]
    rfl

  have s3 : ∀ {P1 P S S' : Scheme.{u}} (str : P ⟶ S) (ι : S' ⟶ S) (lam : P1 ⟶ P)
      [IsClosedImmersion lam] (str1 : P1 ⟶ S) (hl : lam ≫ str = str1)
      (lb : Limits.pullback str1 ι ⟶ Limits.pullback str ι)
      (h1 : lb ≫ Limits.pullback.fst str ι = Limits.pullback.fst str1 ι ≫ lam)
      (h2 : lb ≫ Limits.pullback.snd str ι = Limits.pullback.snd str1 ι),
      IsClosedImmersion lb := by
    intro P1 P S S' str ι lam _ str1 hl lb h1 h2
    have S : IsPullback lb (Limits.pullback.fst str1 ι) (Limits.pullback.fst str ι) lam := by
      refine IsPullback.of_right (h₁₂ := Limits.pullback.snd str ι) (v₁₃ := ι) (h₂₂ := str) ?_ h1
        (IsPullback.of_hasPullback str ι).flip
      rw [h2, hl]
      exact (IsPullback.of_hasPullback str1 ι).flip
    exact MorphismProperty.of_isPullback (P := @IsClosedImmersion) S.flip inferInstance

  have s4 : IsProper (wcProjKStr F'' 1) := by
    letI := @MvPolynomial.gradedAlgebra (Fin (1+1)) F'' _
    letI : IsScalarTower F'' ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0)
        (MvPolynomial (Fin (1+1)) F'') :=
      IsScalarTower.of_algebraMap_eq (R := F'')
        (S := (MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0)
        (A := MvPolynomial (Fin (1+1)) F'') (fun r => rfl)
    haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0)
        (MvPolynomial (Fin (1+1)) F'') :=
      Algebra.FiniteType.of_restrictScalars_finiteType F'' _ _
    haveI : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'')) :=
      inferInstance
    have hbij : Function.Bijective
        (algebraMap F'' ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0)) := by
      constructor
      · intro a b hab
        have h := congrArg (fun x : (MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0 =>
          (x : MvPolynomial (Fin (1+1)) F'')) hab
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq] at h
        exact MvPolynomial.C_injective _ _ h
      · intro x
        have hx : (x : MvPolynomial (Fin (1+1)) F'').IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
        have ht : (x : MvPolynomial (Fin (1+1)) F'').totalDegree = 0 :=
          Nat.le_zero.mp hx.totalDegree_le
        refine ⟨(x : MvPolynomial (Fin (1+1)) F'').coeff 0, Subtype.ext ?_⟩
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp ht).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap F'' ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0))) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      exact hbij
    show IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap F'' ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0))))
    infer_instance

  have s5 : ∀ {K : Type u} [Field K] {P1 Eb Pb : Scheme.{u}} (str1 : P1 ⟶ Spec (.of K))
      [IsProper str1] (ν : Eb ⟶ Pb) [IsFinite ν]
      (lb : Limits.pullback str1 (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) ⟶ Pb),
      (irreducibleComponents ↥(Limits.pullback ν lb)).Finite := by
    intro K _ P1 Eb Pb str1 _ ν _ lb
    haveI : IsLocallyNoetherian (Limits.pullback str1
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
      LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd str1 _)
    haveI : CompactSpace ↥(Limits.pullback str1
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
      QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd str1 _)
    haveI : IsLocallyNoetherian (Limits.pullback ν lb) :=
      LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd ν lb)
    haveI : CompactSpace ↥(Limits.pullback ν lb) :=
      QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd ν lb)
    haveI : AlgebraicGeometry.IsNoetherian (Limits.pullback ν lb) := AlgebraicGeometry.IsNoetherian.mk
    exact TopologicalSpace.NoetherianSpace.finite_irreducibleComponents

  have s6 : ∀ {Eb Pb P1 : Scheme.{u}} (ν : Eb ⟶ Pb) (lb : P1 ⟶ Pb) [IsClosedImmersion lb]
      (hY : _root_.IsPreconnected (⇑ν ⁻¹' Set.range ⇑lb)),
      _root_.IsPreconnected (Set.univ : Set ↥(Limits.pullback ν lb)) := by
    intro Eb Pb P1 ν lb _ hY
    have hind := (Limits.pullback.fst ν lb).isClosedEmbedding.isInducing
    rw [← hind.isPreconnected_image, Set.image_univ, Scheme.Pullback.range_fst]
    exact hY

  haveI : IsClosedImmersion lam := hcl
  haveI : IsProper (wcP1Over F'').hom := s4
  haveI hlbc : IsClosedImmersion lb :=
    s3 (wcProjKStr F'' M') (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
      lam (wcP1Over F'').hom hlamstr lb hlb1 hlb2
  have hfin := s5 (wcP1Over F'').hom ν lb
  have hYc := s6 ν lb hY
  have hOo : IsOpen {y : ↥(Limits.pullback ν lb) | lb (Limits.pullback.snd ν lb y) ∈ Ub} :=
    Ub.isOpen.preimage ((Limits.pullback.snd ν lb ≫ lb).continuous)
  have hOc := s1 _ hOo hfin hYc hU
  obtain ⟨φ, hφ, hφr⟩ := s2 Ub πE ν j lb hj
  rw [← φ.isOpenEmbedding.isInducing.isPreconnected_image, Set.image_univ, hφr]
  exact hOc

theorem wc_poly_etale_free_discr_const : ∀ (K : Type u) [Field K] [IsAlgClosed K] (B : Type u)
    [CommRing B] [Algebra (Polynomial K) B] [Module.Finite (Polynomial K) B]
    [Algebra.Etale (Polynomial K) B],
    Module.Free (Polynomial K) B ∧ ∀ (d : ℕ) (b : Module.Basis (Fin d) (Polynomial K) B),
      ∃ c : K, c ≠ 0 ∧ Algebra.discr (Polynomial K) ⇑b = Polynomial.C c :=
by
  intro K _ _ B _ _ _ _
  have s2 : ∀ (R S M : Type u) [CommRing R] [CommRing S] [CommRing M] [Algebra R S]
      [Algebra R M] (d : ℕ) (b : Module.Basis (Fin d) R M),
      Algebra.discr S ⇑(Algebra.TensorProduct.basis S b) = algebraMap R S (Algebra.discr R ⇑b) := by
    intro R S M _ _ _ _ _ d b
    haveI := Module.Free.of_basis b
    haveI := Module.Finite.of_basis b
    have htr : ∀ x : M, Algebra.trace S (TensorProduct R S M) (1 ⊗ₜ x) =
        algebraMap R S (Algebra.trace R M x) := by
      intro x
      rw [Algebra.trace_apply, Algebra.trace_apply, ← Algebra.baseChange_lmul,
        LinearMap.trace_baseChange]
    rw [Algebra.discr_def, Algebra.discr_def, RingHom.map_det]
    congr 1
    ext i j
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Algebra.traceMatrix_apply,
      Algebra.traceForm_apply, Algebra.TensorProduct.basis_apply,
      Algebra.TensorProduct.tmul_mul_tmul, one_mul, htr]
  have s3 : ∀ (I : Type u) [Fintype I] [DecidableEq I],
      (Algebra.traceForm K (I → K)).Nondegenerate := by
    intro I _ _
    have htr : ∀ z : I → K, Algebra.trace K (I → K) z = ∑ j, z j := by
      intro z
      rw [Algebra.trace_eq_matrix_trace (Pi.basisFun K I) z, Matrix.trace]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      simp [Algebra.leftMulMatrix_eq_repr_mul]
    apply LinearMap.BilinForm.Nondegenerate.ofSeparatingLeft
    intro x hx
    funext i
    have h := hx (Pi.single i 1)
    rw [Algebra.traceForm_apply, htr] at h
    simpa [Pi.single_apply] using h
  refine ⟨?_, ?_⟩
  · haveI : Module.Flat (Polynomial K) B := Algebra.Smooth.flat (Polynomial K) B
    haveI : Module.IsTorsionFree (Polynomial K) B := Module.Flat.isTorsionFree
    exact Module.free_of_finite_type_torsion_free'
  · intro d b
    have s5 : ∀ a : K, Polynomial.eval a (Algebra.discr (Polynomial K) ⇑b) ≠ 0 := by
      intro a
      letI : Algebra (Polynomial K) K := (Polynomial.evalRingHom a).toAlgebra
      haveI : Algebra.Etale K (TensorProduct (Polynomial K) K B) :=
        Algebra.Etale.baseChange (Polynomial K) B K
      obtain ⟨I, hI, Ai, _, _, e, hAi⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K (TensorProduct (Polynomial K) K B)).mp
          inferInstance
      classical
      haveI := Fintype.ofFinite I
      have hbij : ∀ i, Function.Bijective (algebraMap K (Ai i)) := by
        intro i
        haveI := (hAi i).1
        exact IsAlgClosed.algebraMap_bijective_of_isIntegral
      let φ : ∀ i, Ai i ≃ₐ[K] K := fun i =>
        (AlgEquiv.ofBijective (Algebra.ofId K (Ai i)) (hbij i)).symm
      let E : TensorProduct (Polynomial K) K B ≃ₐ[K] (I → K) :=
        e.trans (AlgEquiv.piCongrRight φ)
      let c := Algebra.TensorProduct.basis K b
      let c' := c.map E.toLinearEquiv
      have h1 : Algebra.discr K ⇑c = Polynomial.eval a (Algebra.discr (Polynomial K) ⇑b) := by
        rw [s2]
        rfl
      have h2 : Algebra.discr K ⇑c = Algebra.discr K ⇑c' := by
        rw [Algebra.discr_eq_discr_of_algEquiv (⇑c) E]
        congr 1
      have h3 : Algebra.discr K ⇑c' ≠ 0 := by
        rw [Algebra.discr_def, Algebra.traceMatrix_of_basis]
        exact (LinearMap.BilinForm.nondegenerate_iff_det_ne_zero c').mp (s3 I)
      rw [← h1, h2]
      exact h3
    set δ := Algebra.discr (Polynomial K) ⇑b with hδ
    have hdeg : δ.degree ≤ 0 := by
      by_contra h
      obtain ⟨a, ha⟩ := IsAlgClosed.exists_root δ (by
        intro h0
        exact h (h0 ▸ le_refl _))
      exact s5 a ha
    refine ⟨δ.coeff 0, ?_, Polynomial.eq_C_of_degree_le_zero hdeg⟩
    intro h0
    apply s5 0
    rw [Polynomial.eq_C_of_degree_le_zero hdeg, h0]
    simp

theorem wc_laurent_lattice_dim_ge : ∀ (K : Type u) [Field K] (d : ℕ)
    (P : Matrix (Fin d) (Fin d) (LaurentPolynomial K)),
    (∃ c : K, c ≠ 0 ∧ P.det = LaurentPolynomial.C c) →
    ∃ V : Submodule K (Fin d → LaurentPolynomial K),
      (∀ v, v ∈ V ↔ (∀ i, ∃ p : Polynomial K,
          v i = LaurentPolynomial.invert (Polynomial.toLaurent p)) ∧
        ∃ w : Fin d → Polynomial K, v = P.mulVec (fun i => Polynomial.toLaurent (w i))) ∧
      FiniteDimensional K V ∧ d ≤ Module.finrank K V :=
by
  intro K _
  classical

  have s1 : ∀ (d : ℕ) (P : Matrix (Fin d) (Fin d) (LaurentPolynomial K)) (c : K),
      P.det = LaurentPolynomial.C c →
      ∃ (N : ℕ) (Q : Matrix (Fin d) (Fin d) (Polynomial K)),
        (∀ i j, Polynomial.toLaurent (Q i j) = LaurentPolynomial.T (N : ℤ) * P i j) ∧
        Q.det = Polynomial.C c * Polynomial.X ^ (N * d) := by
    intro d P c hP
    choose n f hf using fun i j => LaurentPolynomial.exists_T_pow (P i j)
    obtain ⟨N, hle⟩ : ∃ N : ℕ, ∀ i j, n i j ≤ N := by
      refine ⟨∑ i, ∑ j, n i j, fun i j => ?_⟩
      calc n i j ≤ ∑ j', n i j' :=
            Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ j)
        _ ≤ ∑ i', ∑ j', n i' j' :=
            Finset.single_le_sum (f := fun i' => ∑ j', n i' j') (fun _ _ => Nat.zero_le _)
              (Finset.mem_univ i)
    obtain ⟨Q, hQ⟩ : ∃ Q : Matrix (Fin d) (Fin d) (Polynomial K),
        ∀ i j, Polynomial.toLaurent (Q i j) = LaurentPolynomial.T (N : ℤ) * P i j := by
      refine ⟨Matrix.of fun i j => Polynomial.X ^ (N - n i j) * f i j, fun i j => ?_⟩
      rw [Matrix.of_apply, map_mul, Polynomial.toLaurent_X_pow, hf, mul_comm (P i j), ← mul_assoc,
        ← LaurentPolynomial.T_add, ← Nat.cast_add, Nat.sub_add_cancel (hle i j)]
    refine ⟨N, Q, hQ, ?_⟩
    apply Polynomial.toLaurent_injective
    rw [RingHom.map_det]
    have hm : (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K).mapMatrix Q =
        (LaurentPolynomial.T (N : ℤ) : LaurentPolynomial K) • P := by
      refine Matrix.ext fun i j => ?_
      rw [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.smul_apply, smul_eq_mul]
      exact hQ i j
    rw [hm, Matrix.det_smul, Fintype.card_fin, hP, LaurentPolynomial.T_pow,
      Polynomial.toLaurent_C_mul_X_pow, mul_comm]
    congr 2
    push_cast
    ring

  have s2 : ∀ (N : ℕ) (u : Polynomial K),
      (∃ p : Polynomial K, LaurentPolynomial.T (-(N : ℤ)) * Polynomial.toLaurent u =
        LaurentPolynomial.invert (Polynomial.toLaurent p)) ↔ u.natDegree ≤ N := by
    intro N u
    have hsumrefl : ∀ (M : ℕ) (s : Finset ℕ) (f : ℕ → Polynomial K),
        Polynomial.reflect M (∑ i ∈ s, f i) = ∑ i ∈ s, Polynomial.reflect M (f i) := by
      intro M s f
      induction s using Finset.induction_on with
      | empty => simp
      | insert a s ha ih =>
        rw [Finset.sum_insert ha, Finset.sum_insert ha, Polynomial.reflect_add, ih]
    have key : ∀ (M : ℕ) (r : Polynomial K), r.natDegree ≤ M →
        LaurentPolynomial.invert (Polynomial.toLaurent (Polynomial.reflect M r)) =
          LaurentPolynomial.T (-(M : ℤ)) * Polynomial.toLaurent r := by
      intro M r hr
      have hr' : r = ∑ i ∈ Finset.range (M + 1), Polynomial.C (r.coeff i) * Polynomial.X ^ i := by
        conv_lhs => rw [Polynomial.as_sum_range' r (M + 1) (by omega)]
        simp only [Polynomial.C_mul_X_pow_eq_monomial]
      rw [hr', hsumrefl]
      simp only [map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      have hi' : i ≤ M := by rw [Finset.mem_range] at hi; omega
      rw [Polynomial.reflect_C_mul_X_pow, Polynomial.revAt_le hi', Polynomial.toLaurent_C_mul_X_pow,
        Polynomial.toLaurent_C_mul_X_pow, map_mul, LaurentPolynomial.invert_C,
        LaurentPolynomial.invert_T, mul_left_comm, ← LaurentPolynomial.T_add]
      congr 2
      omega
    constructor
    · rintro ⟨p, hp⟩
      set m := p.natDegree with hm
      set r := Polynomial.reflect m p with hrdef
      have hr : r.natDegree ≤ m := by
        have := (Polynomial.natDegree_reflect_le (N := m) (p := p))
        rw [← hm, max_self] at this
        exact this
      have hrr : Polynomial.reflect m r = p := Polynomial.reflect_reflect
      have hk := key m r hr
      rw [hrr] at hk
      rw [hk] at hp
      have h2 : LaurentPolynomial.T (m : ℤ) * Polynomial.toLaurent u =
          LaurentPolynomial.T (N : ℤ) * Polynomial.toLaurent r := by
        calc LaurentPolynomial.T (m : ℤ) * Polynomial.toLaurent u
            = LaurentPolynomial.T ((N : ℤ) + m) *
                (LaurentPolynomial.T (-(N : ℤ)) * Polynomial.toLaurent u) := by
              rw [← mul_assoc, ← LaurentPolynomial.T_add, show (N : ℤ) + m + -N = m by ring]
          _ = LaurentPolynomial.T ((N : ℤ) + m) *
                (LaurentPolynomial.T (-(m : ℤ)) * Polynomial.toLaurent r) := by rw [hp]
          _ = LaurentPolynomial.T (N : ℤ) * Polynomial.toLaurent r := by
              rw [← mul_assoc, ← LaurentPolynomial.T_add, show (N : ℤ) + m + -m = N by ring]
      have h3 : Polynomial.toLaurent (Polynomial.X ^ m * u) =
          Polynomial.toLaurent (Polynomial.X ^ N * r) := by
        rw [map_mul, map_mul, Polynomial.toLaurent_X_pow, Polynomial.toLaurent_X_pow]
        exact h2
      have h4 := Polynomial.toLaurent_injective h3
      by_cases hu : u = 0
      · rw [hu, Polynomial.natDegree_zero]; exact Nat.zero_le _
      · have hr0 : r ≠ 0 := by
          intro hr0
          rw [hr0, mul_zero] at h4
          exact mul_ne_zero (pow_ne_zero _ Polynomial.X_ne_zero) hu h4
        have h5 := congrArg Polynomial.natDegree h4
        rw [Polynomial.natDegree_X_pow_mul _ hu, Polynomial.natDegree_X_pow_mul _ hr0] at h5
        omega
    · intro h
      exact ⟨Polynomial.reflect N u, (key N u h).symm⟩

  have s3 : ∀ (d : ℕ) (Q : Matrix (Fin d) (Fin d) (Polynomial K)), Q.det ≠ 0 →
      FiniteDimensional K ((Fin d → Polynomial K) ⧸ LinearMap.range Q.mulVecLin) ∧
      Module.finrank K ((Fin d → Polynomial K) ⧸ LinearMap.range Q.mulVecLin) =
        Q.det.natDegree := by
    intro d Q hQ
    have hinj : Function.Injective Q.mulVecLin := by
      intro x y hxy
      rw [Matrix.mulVecLin_apply, Matrix.mulVecLin_apply] at hxy
      have : Q.mulVec (x - y) = 0 := by
        rw [Matrix.mulVec_sub]; exact sub_eq_zero.mpr hxy
      exact sub_eq_zero.mp (Matrix.eq_zero_of_mulVec_eq_zero hQ this)
    have h : Module.finrank (Polynomial K) (LinearMap.range Q.mulVecLin) =
        Module.finrank (Polynomial K) (Fin d → Polynomial K) := LinearMap.finrank_range_of_inj hinj
    let b := Pi.basisFun (Polynomial K) (Fin d)
    have ha0 : ∀ i, Submodule.smithNormalFormCoeffs b h i ≠ 0 :=
      Submodule.smithNormalFormCoeffs_ne_zero b h
    haveI : ∀ i, Module.Finite K
        (Polynomial K ⧸ Ideal.span {Submodule.smithNormalFormCoeffs b h i}) :=
      fun i => (AdjoinRoot.powerBasis (ha0 i)).finite
    have e := (Submodule.quotientEquivPiSpan (LinearMap.range Q.mulVecLin) b h).restrictScalars K
    haveI hfd : FiniteDimensional K ((Fin d → Polynomial K) ⧸ LinearMap.range Q.mulVecLin) :=
      Module.Finite.equiv e.symm
    refine ⟨hfd, ?_⟩
    rw [Submodule.finrank_quotient_eq_sum K b h]
    simp only [finrank_quotient_span_eq_natDegree]
    have hprod : (∏ i, Submodule.smithNormalFormCoeffs b h i).natDegree =
        ∑ i, (Submodule.smithNormalFormCoeffs b h i).natDegree :=
      Polynomial.natDegree_prod _ _ (fun i _ => ha0 i)
    rw [← hprod]
    have hassoc : Associated (LinearMap.det Q.mulVecLin)
        (∏ i, Submodule.smithNormalFormCoeffs b h i) := by
      let b' := Submodule.smithNormalFormTopBasis b h
      let bN := Submodule.smithNormalFormBotBasis b h
      let e₁ := LinearEquiv.ofInjective Q.mulVecLin hinj
      let e₂ : (Fin d → Polynomial K) ≃ₗ[Polynomial K] LinearMap.range Q.mulVecLin :=
        b'.equiv bN (Equiv.refl _)
      let ψ : (Fin d → Polynomial K) →ₗ[Polynomial K] (Fin d → Polynomial K) :=
        (LinearMap.range Q.mulVecLin).subtype ∘ₗ e₂.toLinearMap
      have hψ : LinearMap.toMatrix b' b' ψ =
          Matrix.diagonal (Submodule.smithNormalFormCoeffs b h) := by
        ext i j
        rw [LinearMap.toMatrix_apply]
        simp only [ψ, e₂, LinearMap.comp_apply, LinearEquiv.coe_coe, Module.Basis.equiv_apply,
          Equiv.refl_apply, Submodule.subtype_apply]
        rw [Submodule.smithNormalFormBotBasis_def, map_smul, Module.Basis.repr_self]
        by_cases hij : i = j
        · subst hij; simp
        · simp [Matrix.diagonal_apply_ne _ hij, Ne.symm hij]
      have hdetψ : LinearMap.det ψ = ∏ i, Submodule.smithNormalFormCoeffs b h i := by
        rw [← LinearMap.det_toMatrix b', hψ, Matrix.det_diagonal]
      rw [← hdetψ]
      apply LinearMap.associated_det_of_eq_comp (e₁.trans e₂.symm)
      intro x
      simp only [ψ, LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.trans_apply,
        LinearEquiv.apply_symm_apply, Submodule.subtype_apply, e₁, LinearEquiv.ofInjective_apply]
    have hdetφ : LinearMap.det Q.mulVecLin = Q.det := by
      rw [← Matrix.toLin'_apply', LinearMap.det_toLin']
    rw [hdetφ] at hassoc
    exact (Polynomial.natDegree_eq_of_degree_eq
      (Polynomial.degree_eq_degree_of_associated hassoc)).symm

  have s4 : ∀ (d n : ℕ) (Q : Matrix (Fin d) (Fin d) (Polynomial K)),
      Function.Injective Q.mulVec →
      FiniteDimensional K ((Fin d → Polynomial K) ⧸ LinearMap.range Q.mulVecLin) →
      ∃ W : Submodule K (Fin d → Polynomial K),
        (∀ w, w ∈ W ↔ ∀ i, (Q.mulVec w i).natDegree ≤ n) ∧ FiniteDimensional K W ∧
        d * (n + 1) ≤ Module.finrank K W +
          Module.finrank K ((Fin d → Polynomial K) ⧸ LinearMap.range Q.mulVecLin) := by
    intro d n Q hinj hfd
    have hdeg : ∀ p : Polynomial K, p ∈ Polynomial.degreeLT K (n + 1) ↔ p.natDegree ≤ n := by
      intro p
      rw [Polynomial.mem_degreeLT]
      by_cases hp : p = 0
      · subst hp
        simp only [Polynomial.degree_zero, Polynomial.natDegree_zero, zero_le, iff_true]
        exact WithBot.bot_lt_coe _
      · rw [← Polynomial.natDegree_lt_iff_degree_lt hp]; omega
    let E : (Fin d → Fin (n + 1) → K) →ₗ[K] (Fin d → Polynomial K) :=
      LinearMap.pi (fun i => (Polynomial.degreeLT K (n + 1)).subtype ∘ₗ
        (Polynomial.degreeLTEquiv K (n + 1)).symm.toLinearMap ∘ₗ LinearMap.proj i)
    have hEapp : ∀ c i, E c i =
        ((Polynomial.degreeLTEquiv K (n + 1)).symm (c i) : Polynomial K) := fun c i => rfl
    have hEinj : Function.Injective E := by
      intro c c' hcc
      funext i
      apply (Polynomial.degreeLTEquiv K (n + 1)).symm.injective
      apply Subtype.ext
      rw [← hEapp, ← hEapp, hcc]
    have hmemU : ∀ x, x ∈ LinearMap.range E ↔ ∀ i, (x i).natDegree ≤ n := by
      intro x
      constructor
      · rintro ⟨c, rfl⟩ i
        rw [hEapp]
        exact (hdeg _).mp ((Polynomial.degreeLTEquiv K (n + 1)).symm (c i)).2
      · intro hx
        refine ⟨fun i => Polynomial.degreeLTEquiv K (n + 1) ⟨x i, (hdeg _).mpr (hx i)⟩, ?_⟩
        funext i
        rw [hEapp, LinearEquiv.symm_apply_apply]
    have hUrank : Module.finrank K (LinearMap.range E) = d * (n + 1) := by
      rw [LinearMap.finrank_range_of_inj hEinj, Module.finrank_pi_fintype]
      simp
    let φK : (Fin d → Polynomial K) →ₗ[K] (Fin d → Polynomial K) :=
      Q.mulVecLin.restrictScalars K
    have hφK : ∀ w, φK w = Q.mulVec w := fun w => rfl
    let α : ((LinearMap.range E).comap φK) →ₗ[K] (LinearMap.range E) :=
      φK.restrict (fun x hx => hx)
    have hα : Function.Injective α := by
      intro x y hxy
      apply Subtype.ext
      apply hinj
      exact congrArg Subtype.val hxy
    haveI hWfd : FiniteDimensional K ((LinearMap.range E).comap φK) :=
      Module.Finite.of_injective α hα
    refine ⟨(LinearMap.range E).comap φK, ?_, hWfd, ?_⟩
    · intro w
      rw [Submodule.mem_comap, hmemU, hφK]
    let g : (LinearMap.range E) →ₗ[K] ((Fin d → Polynomial K) ⧸ LinearMap.range Q.mulVecLin) :=
      ((LinearMap.range Q.mulVecLin).mkQ.restrictScalars K) ∘ₗ (LinearMap.range E).subtype
    have hrn := LinearMap.finrank_range_add_finrank_ker g
    have h1 : Module.finrank K (LinearMap.range g) ≤
        Module.finrank K ((Fin d → Polynomial K) ⧸ LinearMap.range Q.mulVecLin) :=
      Submodule.finrank_le _
    have hker : LinearMap.ker g ≤ LinearMap.range α := by
      intro x hx
      rw [LinearMap.mem_ker] at hx
      have hx' : (x : Fin d → Polynomial K) ∈ LinearMap.range Q.mulVecLin := by
        rw [← Submodule.Quotient.mk_eq_zero]; exact hx
      obtain ⟨w, hw⟩ := hx'
      have hwW : w ∈ (LinearMap.range E).comap φK := by
        rw [Submodule.mem_comap]
        show Q.mulVecLin w ∈ LinearMap.range E
        rw [hw]; exact x.2
      exact ⟨⟨w, hwW⟩, Subtype.ext hw⟩
    have h2 : Module.finrank K (LinearMap.ker g) ≤
        Module.finrank K ((LinearMap.range E).comap φK) := by
      rw [← LinearMap.finrank_range_of_inj hα]
      exact Submodule.finrank_mono hker
    rw [hUrank] at hrn
    omega

  intro d P ⟨c, hc, hdet⟩
  obtain ⟨N, Q, hQ, hQdet⟩ := s1 d P c hdet
  have hQ0 : Q.det ≠ 0 := by
    rw [hQdet]
    exact mul_ne_zero (Polynomial.C_ne_zero.mpr hc) (pow_ne_zero _ Polynomial.X_ne_zero)
  have hQdeg : Q.det.natDegree = N * d := by
    rw [hQdet]; exact Polynomial.natDegree_C_mul_X_pow _ _ hc
  obtain ⟨hCfd, hCrank⟩ := s3 d Q hQ0
  have hQinj : Function.Injective Q.mulVec := by
    intro x y hxy
    have : Q.mulVec (x - y) = 0 := by
      rw [Matrix.mulVec_sub]; exact sub_eq_zero.mpr hxy
    exact sub_eq_zero.mp (Matrix.eq_zero_of_mulVec_eq_zero hQ0 this)
  obtain ⟨W, hW, hWfd, hWrank⟩ := s4 d N Q hQinj hCfd
  rw [hCrank, hQdeg] at hWrank
  have hdW : d ≤ Module.finrank K W := by nlinarith
  let θ : (Fin d → Polynomial K) →ₗ[K] (Fin d → LaurentPolynomial K) :=
    { toFun := fun w => P.mulVec (fun i => Polynomial.toLaurent (w i))
      map_add' := fun w w' => by
        simp only [Pi.add_apply, map_add]
        rw [← Matrix.mulVec_add]; rfl
      map_smul' := fun a w => by
        simp only [Pi.smul_apply, RingHom.id_apply]
        have : (fun i => Polynomial.toLaurent (a • w i)) =
            a • (fun i => Polynomial.toLaurent (w i)) := by
          funext i
          rw [Pi.smul_apply, ← Polynomial.toLaurentAlg_apply, ← Polynomial.toLaurentAlg_apply,
            map_smul]
        rw [this, Matrix.mulVec_smul] }
  have hθ : ∀ w, θ w = P.mulVec (fun i => Polynomial.toLaurent (w i)) := fun w => rfl
  have hθinj : Function.Injective θ := by
    intro w w' hww
    rw [hθ, hθ] at hww
    have hPu : IsUnit P := (Matrix.isUnit_iff_isUnit_det P).mpr
      (by rw [hdet]; exact (Ne.isUnit hc).map LaurentPolynomial.C)
    have := Matrix.mulVec_injective_of_isUnit hPu hww
    funext i
    exact Polynomial.toLaurent_injective (congrFun this i)
  have hkey : ∀ w i, θ w i =
      LaurentPolynomial.T (-(N : ℤ)) * Polynomial.toLaurent (Q.mulVec w i) := by
    intro w i
    have h1 : Polynomial.toLaurent (Q.mulVec w i) = LaurentPolynomial.T (N : ℤ) * θ w i := by
      rw [hθ]
      simp only [Matrix.mulVec, dotProduct, map_sum, map_mul, hQ, Finset.mul_sum, mul_assoc]
    rw [h1, ← mul_assoc, ← LaurentPolynomial.T_add, neg_add_cancel, LaurentPolynomial.T_zero,
      one_mul]
  refine ⟨W.map θ, ?_, ?_, ?_⟩
  · intro v
    rw [Submodule.mem_map]
    constructor
    · rintro ⟨w, hw, rfl⟩
      refine ⟨fun i => ?_, w, hθ w⟩
      obtain ⟨p, hp⟩ := (s2 N (Q.mulVec w i)).mpr ((hW w).mp hw i)
      exact ⟨p, by rw [hkey]; exact hp⟩
    · rintro ⟨hinv, w, rfl⟩
      refine ⟨w, (hW w).mpr (fun i => (s2 N (Q.mulVec w i)).mp ?_), hθ w⟩
      obtain ⟨p, hp⟩ := hinv i
      exact ⟨p, by rw [← hkey, hθ]; exact hp⟩
  · exact Module.Finite.equiv (Submodule.equivMapOfInjective θ hθinj W)
  · rw [LinearEquiv.finrank_eq (Submodule.equivMapOfInjective θ hθinj W)] at hdW
    exact hdW

theorem wc_pushout_basis : ∀ (R S B C : Type u) [CommRing R] [CommRing S] [CommRing B] [CommRing C]
    [Algebra R B] [Algebra S C] (f : R →+* S) (ι : B →+* C) (d : ℕ)
    (b : Module.Basis (Fin d) R B),
    IsPushout (CommRingCat.ofHom (algebraMap R B)) (CommRingCat.ofHom f) (CommRingCat.ofHom ι)
      (CommRingCat.ofHom (algebraMap S C)) →
    ∃ c : Module.Basis (Fin d) S C, ∀ i, c i = ι (b i) :=
by
  intro R S B C _ _ _ _ _ _ f ι d b hP
  have hsq : ι.comp (algebraMap R B) = (algebraMap S C).comp f := by
    have h := congrArg CommRingCat.Hom.hom hP.toCommSq.w
    simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using h
  letI : Algebra R S := f.toAlgebra
  letI : Algebra B C := ι.toAlgebra
  letI : Algebra R C := ((algebraMap S C).comp f).toAlgebra
  haveI : IsScalarTower R S C := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsScalarTower R B C :=
    IsScalarTower.of_algebraMap_eq (fun x => (RingHom.congr_fun hsq x).symm)
  haveI hAP : Algebra.IsPushout R B S C := CommRingCat.isPushout_iff_isPushout.mp hP
  have ibc : IsBaseChange S (IsScalarTower.toAlgHom R B C).toLinearMap := hAP.symm.out
  refine ⟨ibc.basis b, fun i => ?_⟩
  rw [IsBaseChange.basis_apply]
  rfl

theorem wc_basechange_basis_facts : ∀ (R S B C : Type u) [CommRing R] [CommRing S] [CommRing B]
    [CommRing C] [Algebra R B] [Algebra S C] (f : R →+* S) (ι : B →+* C),
    ι.comp (algebraMap R B) = (algebraMap S C).comp f →
    ∀ (d : ℕ) (b : Module.Basis (Fin d) R B) (c : Module.Basis (Fin d) S C), (∀ i, c i = ι (b i)) →
      (∀ (x : B) (i : Fin d), c.repr (ι x) i = f (b.repr x i)) ∧
      (Function.Injective f → Function.Injective ι) ∧
      Algebra.discr S ⇑c = f (Algebra.discr R ⇑b) :=
by
  intro R S B C _ _ _ _ _ _ f ι h d b c hc
  have s0 : ∀ r : R, ι (algebraMap R B r) = algebraMap S C (f r) := fun r => by
    have := RingHom.congr_fun h r
    simpa using this
  have s1 : ∀ (x : B) (i : Fin d), c.repr (ι x) i = f (b.repr x i) := by
    intro x i
    have hx : ι x = ∑ j, f (b.repr x j) • c j := by
      conv_lhs => rw [← b.sum_repr x]
      rw [map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [Algebra.smul_def, map_mul, s0, hc, ← Algebra.smul_def]
    rw [hx, c.repr_sum_self]
  have s2 : Function.Injective f → Function.Injective ι := by
    intro hf
    rw [injective_iff_map_eq_zero]
    intro x hx
    apply b.ext_elem
    intro i
    apply hf
    have h1 := s1 x i
    rw [hx, map_zero, Finsupp.zero_apply] at h1
    rw [← h1]
    simp
  have s3 : ∀ y : B, Algebra.trace S C (ι y) = f (Algebra.trace R B y) := by
    intro y
    rw [Algebra.trace_eq_matrix_trace c, Algebra.trace_eq_matrix_trace b, Matrix.trace,
      Matrix.trace, map_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    simp only [Matrix.diag, Algebra.leftMulMatrix_eq_repr_mul]
    rw [hc, ← map_mul, s1]
  have s4 : Algebra.traceMatrix S ⇑c = (Algebra.traceMatrix R ⇑b).map f := by
    ext i j
    rw [Algebra.traceMatrix_apply, Matrix.map_apply, Algebra.traceMatrix_apply,
      Algebra.traceForm_apply, Algebra.traceForm_apply, hc, hc, ← map_mul, s3]
  have s5 : Algebra.discr S ⇑c = f (Algebra.discr R ⇑b) := by
    rw [Algebra.discr_def, Algebra.discr_def, s4, RingHom.map_det, RingHom.mapMatrix_apply]
  exact ⟨s1, s2, s5⟩

theorem wc_laurent_sq_mul_C_const : ∀ (K : Type u) [Field K] (u : LaurentPolynomial K) (a b : K),
    a ≠ 0 → b ≠ 0 → u ^ 2 * LaurentPolynomial.C a = LaurentPolynomial.C b →
    ∃ c : K, c ≠ 0 ∧ u = LaurentPolynomial.C c :=
by
  intro K _ u a b ha hb h
  obtain ⟨n, f, hf⟩ := LaurentPolynomial.exists_T_pow u
  have hT2 : (LaurentPolynomial.T (n : ℤ) : LaurentPolynomial K) ^ 2 =
      LaurentPolynomial.T ((2 * n : ℕ) : ℤ) := by
    rw [pow_two, ← LaurentPolynomial.T_add]
    congr 1
    push_cast
    ring
  have hpoly : f ^ 2 * Polynomial.C a = Polynomial.C b * Polynomial.X ^ (2 * n) := by
    apply Polynomial.toLaurent_injective
    rw [map_mul, map_pow, hf, Polynomial.toLaurent_C, Polynomial.toLaurent_C_mul_X_pow, ← hT2]
    calc (u * LaurentPolynomial.T (n : ℤ)) ^ 2 * LaurentPolynomial.C a
        = (u ^ 2 * LaurentPolynomial.C a) * LaurentPolynomial.T (n : ℤ) ^ 2 := by ring
      _ = _ := by rw [h]
  have hf0 : f ≠ 0 := by
    rintro rfl
    have hne : Polynomial.C b * Polynomial.X ^ (2 * n) ≠ (0 : Polynomial K) :=
      mul_ne_zero (Polynomial.C_ne_zero.mpr hb) (pow_ne_zero _ Polynomial.X_ne_zero)
    apply hne
    rw [← hpoly]
    simp
  have hdeg : f.natDegree = n := by
    have h2 := congrArg Polynomial.natDegree hpoly
    rw [Polynomial.natDegree_mul_C ha, Polynomial.natDegree_pow,
      Polynomial.natDegree_C_mul_X_pow _ _ hb] at h2
    omega
  have htdeg : f.natTrailingDegree = n := by
    have h2 := congrArg Polynomial.natTrailingDegree hpoly
    rw [sq, Polynomial.natTrailingDegree_mul (mul_ne_zero hf0 hf0) (Polynomial.C_ne_zero.mpr ha),
      Polynomial.natTrailingDegree_mul hf0 hf0, Polynomial.natTrailingDegree_C,
      Polynomial.natTrailingDegree_mul_X_pow (Polynomial.C_ne_zero.mpr hb),
      Polynomial.natTrailingDegree_C] at h2
    omega
  have hc : f.coeff n ≠ 0 := by
    have h2 := Polynomial.leadingCoeff_ne_zero.mpr hf0
    rwa [Polynomial.leadingCoeff, hdeg] at h2
  have hfeq : f = Polynomial.C (f.coeff n) * Polynomial.X ^ n := by
    ext k
    rw [Polynomial.coeff_C_mul_X_pow]
    rcases lt_trichotomy k n with hk | hk | hk
    · rw [if_neg hk.ne]
      exact Polynomial.coeff_eq_zero_of_lt_natTrailingDegree (htdeg ▸ hk)
    · rw [if_pos hk, hk]
    · rw [if_neg hk.ne']
      exact Polynomial.coeff_eq_zero_of_natDegree_lt (hdeg ▸ hk)
  refine ⟨f.coeff n, hc, ?_⟩
  have h1 : u * LaurentPolynomial.T (n : ℤ) =
      LaurentPolynomial.C (f.coeff n) * LaurentPolynomial.T (n : ℤ) := by
    rw [← hf]
    conv_lhs => rw [hfeq]
    rw [Polynomial.toLaurent_C_mul_X_pow]
  have hTT : (LaurentPolynomial.T (n : ℤ) : LaurentPolynomial K) *
      LaurentPolynomial.T (-(n : ℤ)) = 1 := by
    rw [← LaurentPolynomial.T_add, add_neg_cancel, LaurentPolynomial.T_zero]
  calc u = u * LaurentPolynomial.T (n : ℤ) * LaurentPolynomial.T (-(n : ℤ)) := by
        rw [mul_assoc, hTT, mul_one]
    _ = _ := by rw [h1, mul_assoc, hTT, mul_one]

theorem wc_isReduced_of_discr_ne_zero : ∀ (R B : Type u) [CommRing R] [IsDomain R] [CommRing B]
    [Algebra R B] (d : ℕ) (b : Module.Basis (Fin d) R B), Algebra.discr R ⇑b ≠ 0 → IsReduced B :=
by
  intro R B _ _ _ _ d b hb
  classical
  haveI : Module.Free R B := Module.Free.of_basis b
  haveI : Module.Finite R B := Module.Finite.of_basis b
  refine ⟨fun z hz => ?_⟩
  have ht : ∀ i, Algebra.trace R B (z * b i) = 0 := fun i =>
    (Algebra.isNilpotent_trace_of_isNilpotent
      ((Commute.all z (b i)).isNilpotent_mul_right hz)).eq_zero
  have hmv : (Algebra.traceMatrix R ⇑b).mulVec (b.equivFun z) = 0 := by
    rw [Algebra.traceMatrix_of_basis_mulVec]
    funext i
    exact ht i
  rw [Algebra.discr_def] at hb
  exact b.equivFun.map_eq_zero_iff.mp (Matrix.eq_zero_of_mulVec_eq_zero hb hmv)

theorem wc_fd_reduced_subalgebra_idempotents : ∀ (K : Type u) [Field K] [IsAlgClosed K] (B : Type u)
    [CommRing B] [Algebra K B] [IsReduced B] (S : Subalgebra K B) [FiniteDimensional K S],
    ∃ e : Fin (Module.finrank K S) → B, (∀ k, e k ∈ S) ∧ (∀ k, e k * e k = e k) ∧
      (∀ k, e k ≠ 0) ∧ (∀ k l, k ≠ l → e k * e l = 0) ∧ ∑ k, e k = 1 :=
by
  intro K _ _ B _ _ _ S _
  classical
  haveI : IsReduced S := isReduced_of_injective S.val Subtype.val_injective
  haveI : IsArtinianRing S := IsArtinianRing.of_finite K S
  letI : Fintype (MaximalSpectrum S) := Fintype.ofFinite (MaximalSpectrum S)
  have hres : ∀ I : MaximalSpectrum S, Module.finrank K (S ⧸ I.asIdeal) = 1 := by
    intro I
    haveI := I.isMaximal
    letI : Field (S ⧸ I.asIdeal) := Ideal.Quotient.field I.asIdeal
    haveI : Algebra.IsIntegral K (S ⧸ I.asIdeal) := Algebra.IsIntegral.of_finite K _
    have hbij : Function.Bijective (algebraMap K (S ⧸ I.asIdeal)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let ψ : K ≃ₗ[K] S ⧸ I.asIdeal := LinearEquiv.ofBijective (Algebra.linearMap K _) hbij
    rw [← ψ.finrank_eq, Module.finrank_self]
  let Φ := IsArtinianRing.equivPi S
  have hdim : Module.finrank K S = Fintype.card (MaximalSpectrum S) := by
    rw [(Φ.restrictScalars K).toLinearEquiv.finrank_eq, Module.finrank_pi_fintype]
    simp [hres]
  let σ : Fin (Module.finrank K S) ≃ MaximalSpectrum S :=
    (finCongr hdim).trans (Fintype.equivFin _).symm
  let f : Fin (Module.finrank K S) → S := fun k => Φ.symm (Pi.single (σ k) 1)
  have hfid : ∀ k, f k * f k = f k := by
    intro k
    simp only [f]
    rw [← map_mul, ← Pi.single_mul, mul_one]
  have hfne : ∀ k, f k ≠ 0 := by
    intro k h
    have h1 : (Pi.single (σ k) 1 : (I : MaximalSpectrum S) → S ⧸ I.asIdeal) = 0 :=
      (map_eq_zero_iff Φ.symm Φ.symm.injective).mp h
    have h2 := congrFun h1 (σ k)
    haveI := (σ k).isMaximal
    simp at h2
  have hforth : ∀ k l, k ≠ l → f k * f l = 0 := by
    intro k l hkl
    have hne : σ k ≠ σ l := σ.injective.ne hkl
    have h1 : (Pi.single (σ k) 1 * Pi.single (σ l) 1 :
        (I : MaximalSpectrum S) → S ⧸ I.asIdeal) = 0 := by
      ext J
      by_cases h : J = σ k
      · subst h; simp [hne]
      · simp [h]
    simp only [f]
    rw [← map_mul, h1, map_zero]
  have hfsum : ∑ k, f k = 1 := by
    simp only [f]
    rw [← map_sum, Equiv.sum_comp σ (fun I => (Pi.single I (1 : S ⧸ I.asIdeal) :
      (J : MaximalSpectrum S) → S ⧸ J.asIdeal)), Finset.univ_sum_single]
    exact map_one Φ.symm
  refine ⟨fun k => (f k : B), fun k => (f k).2, ?_, ?_, ?_, ?_⟩
  · intro k
    show ((f k * f k : S) : B) = f k
    rw [hfid]
  · intro k h
    exact hfne k (Subtype.ext h)
  · intro k l hkl
    show ((f k * f l : S) : B) = 0
    rw [hforth k l hkl]
    rfl
  · show ∑ k, ((f k : S) : B) = 1
    rw [← AddSubmonoidClass.coe_finsetSum, hfsum]
    rfl

theorem wc_rank_one_of_idempotents : ∀ (R B : Type u) [CommRing R] [IsDomain R]
    [IsPrincipalIdealRing R] [CommRing B] [Algebra R B] (d : ℕ) (b : Module.Basis (Fin d) R B)
    (n : ℕ) (e : Fin n → B), d ≤ n → (∀ k, e k * e k = e k) → (∀ k, e k ≠ 0) →
    (∀ k l, k ≠ l → e k * e l = 0) → ∑ k, e k = 1 →
    ∀ (k : Fin n) (x : B), ∃! p : R, e k * x = algebraMap R B p * e k :=
by
  intro R B _ _ _ _ _ d b n e hdn hid hne horth hsum
  classical
  haveI : Module.Free R B := Module.Free.of_basis b
  haveI : Module.Finite R B := Module.Finite.of_basis b
  let M : Fin n → Submodule R B := fun k => LinearMap.range (LinearMap.mulLeft R (e k))
  haveI hMfin : ∀ k, Module.Finite R (M k) := fun k => Module.Finite.range _
  haveI hMfree : ∀ k, Module.Free R (M k) := fun k => Module.free_of_finite_type_torsion_free'
  let Φ : B →ₗ[R] (Π k, M k) :=
    LinearMap.pi (fun k => (LinearMap.mulLeft R (e k)).rangeRestrict)
  have hΦ : ∀ x k, ((Φ x k : M k) : B) = e k * x := fun x k => rfl
  have hinj : Function.Injective Φ := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro x hx
    have h : ∀ k, e k * x = 0 := by
      intro k
      rw [← hΦ x k, hx]
      rfl
    calc x = (∑ k, e k) * x := by rw [hsum, one_mul]
      _ = ∑ k, e k * x := Finset.sum_mul _ _ _
      _ = 0 := Finset.sum_eq_zero (fun k _ => h k)
  have hsurj : Function.Surjective Φ := by
    intro m
    refine ⟨∑ k, (m k : B), ?_⟩
    funext l
    apply Subtype.ext
    rw [hΦ, Finset.mul_sum, Finset.sum_eq_single l]
    · obtain ⟨y, hy⟩ := (m l).2
      rw [← hy, LinearMap.mulLeft_apply, ← mul_assoc, hid]
    · intro k _ hkl
      obtain ⟨y, hy⟩ := (m k).2
      rw [← hy, LinearMap.mulLeft_apply, ← mul_assoc, horth l k (Ne.symm hkl), zero_mul]
    · intro h
      exact absurd (Finset.mem_univ l) h
  let Ψ := LinearEquiv.ofBijective Φ ⟨hinj, hsurj⟩
  have hd : d = ∑ k, Module.finrank R (M k) := by
    rw [← Module.finrank_pi_fintype R, ← LinearEquiv.finrank_eq Ψ,
      Module.finrank_eq_card_basis b, Fintype.card_fin]
  have hpos : ∀ k, 1 ≤ Module.finrank R (M k) := by
    intro k
    haveI : Nontrivial (M k) :=
      ⟨⟨⟨e k, ⟨1, mul_one _⟩⟩, 0, fun h => hne k (congrArg Subtype.val h)⟩⟩
    exact Module.finrank_pos
  have hone : ∀ k, Module.finrank R (M k) = 1 := by
    have hle : ∑ _k : Fin n, (1 : ℕ) ≤ ∑ k, Module.finrank R (M k) :=
      Finset.sum_le_sum (fun k _ => hpos k)
    have hn : ∑ _k : Fin n, (1 : ℕ) = n := by simp
    have heq : ∑ _k : Fin n, (1 : ℕ) = ∑ k, Module.finrank R (M k) := by omega
    intro k
    exact ((Finset.sum_eq_sum_iff_of_le (fun k _ => hpos k)).mp heq k (Finset.mem_univ k)).symm
  intro k x
  let β := Module.finBasisOfFinrankEq R (M k) (hone k)
  set β₀ : B := ((β 0 : M k) : B) with hβ₀def
  have hspan : ∀ z : M k, (z : B) = (β.repr z 0) • β₀ := by
    intro z
    have h := β.sum_repr z
    rw [Fin.sum_univ_one] at h
    calc (z : B) = ((β.repr z 0 • β 0 : M k) : B) := by rw [h]
      _ = _ := Submodule.coe_smul _ _
  have hβne : β₀ ≠ 0 := by
    intro h
    exact β.ne_zero 0 (Submodule.coe_eq_zero.mp h)
  obtain ⟨y, hy⟩ := (β 0).2
  have hy' : e k * y = β₀ := hy
  have heβ : e k * β₀ = β₀ := by
    rw [← hy', ← mul_assoc, hid]
  have hf := hspan ⟨e k, ⟨1, mul_one _⟩⟩
  set f := β.repr ⟨e k, ⟨1, mul_one _⟩⟩ 0 with hfdef
  have hg := hspan ⟨β₀ * β₀, ⟨y * β₀, by
    show e k * (y * β₀) = β₀ * β₀
    rw [← mul_assoc, hy']⟩⟩
  set g := β.repr ⟨β₀ * β₀, ⟨y * β₀, by
    show e k * (y * β₀) = β₀ * β₀
    rw [← mul_assoc, hy']⟩⟩ 0 with hgdef
  have hfg : (f * g) • β₀ = (1 : R) • β₀ := by
    calc (f * g) • β₀ = f • (g • β₀) := mul_smul _ _ _
      _ = f • (β₀ * β₀) := by rw [← hg]
      _ = (f • β₀) * β₀ := (smul_mul_assoc _ _ _).symm
      _ = e k * β₀ := by rw [← hf]
      _ = β₀ := heβ
      _ = (1 : R) • β₀ := (one_smul _ _).symm
  have hfg' : f * g = 1 := smul_left_injective R hβne hfg
  have hge : g • e k = β₀ := by
    rw [show e k = f • β₀ from hf, smul_smul, mul_comm, hfg', one_smul]
  have hh := hspan ⟨e k * x, ⟨x, rfl⟩⟩
  set h := β.repr ⟨e k * x, ⟨x, rfl⟩⟩ 0 with hhdef
  have hex : e k * x = algebraMap R B (h * g) * e k := by
    rw [← Algebra.smul_def, mul_smul, hge]
    exact hh
  refine ⟨h * g, hex, ?_⟩
  intro p hp
  apply smul_left_injective R (hne k)
  show p • e k = (h * g) • e k
  rw [Algebra.smul_def, Algebra.smul_def, ← hp, hex]

theorem wc_sections_of_global_idempotent : ∀ (K : Type u) [Field K] (B₁ B₂ C : Type u) [CommRing B₁]
    [CommRing B₂] [CommRing C] [Algebra (Polynomial K) B₁] [Algebra (Polynomial K) B₂]
    (ι₁ : B₁ →+* C) (ι₂ : B₂ →+* C) (lam : LaurentPolynomial K →+* C),
    IsPushout (CommRingCat.ofHom (algebraMap (Polynomial K) B₁))
      (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
        (LaurentPolynomial.T (-1))))
      (CommRingCat.ofHom ι₁) (CommRingCat.ofHom lam) →
    ι₂.comp (algebraMap (Polynomial K) B₂) =
      lam.comp (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K) →
    ∀ (e₁ : B₁) (e₂ : B₂), e₁ * e₁ = e₁ → e₂ * e₂ = e₂ → ι₁ e₁ = ι₂ e₂ →
      (∀ x : B₁, ∃! p : Polynomial K, e₁ * x = algebraMap (Polynomial K) B₁ p * e₁) →
      (∀ y : B₂, ∃! p : Polynomial K, e₂ * y = algebraMap (Polynomial K) B₂ p * e₂) →
      ∃ (σ₁ : B₁ →+* Polynomial K) (σ₂ : B₂ →+* Polynomial K) (τ : C →+* LaurentPolynomial K),
        σ₁.comp (algebraMap (Polynomial K) B₁) = RingHom.id _ ∧
        σ₂.comp (algebraMap (Polynomial K) B₂) = RingHom.id _ ∧
        τ.comp lam = RingHom.id _ ∧
        τ.comp ι₁ = (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
          (LaurentPolynomial.T (-1))).comp σ₁ ∧
        τ.comp ι₂ = (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K).comp σ₂ :=
by
  intro K _ B₁ B₂ C _ _ _ _ _ ι₁ ι₂ lam hP₁ hsq₂ e₁ e₂ he₁ he₂ he h₁ h₂

  have retr : ∀ (B : Type u) [CommRing B] [Algebra (Polynomial K) B] (e : B), e * e = e →
      (∀ x : B, ∃! p : Polynomial K, e * x = algebraMap (Polynomial K) B p * e) →
      ∃ σ : B →+* Polynomial K, σ.comp (algebraMap (Polynomial K) B) = RingHom.id _ ∧ σ e = 1 ∧
        ∀ x : B, e * x = algebraMap (Polynomial K) B (σ x) * e := by
    intro B _ _ e hee h
    let σ₀ : B → Polynomial K := fun x => Classical.choose (h x).exists
    have hspec : ∀ x : B, e * x = algebraMap (Polynomial K) B (σ₀ x) * e :=
      fun x => Classical.choose_spec (h x).exists
    have uniq : ∀ (x : B) (p : Polynomial K), e * x = algebraMap (Polynomial K) B p * e →
        p = σ₀ x := fun x p hp => (h x).unique hp (hspec x)
    let σ : B →+* Polynomial K :=
      { toFun := σ₀
        map_one' := by
          symm; apply uniq; rw [map_one, one_mul, mul_one]
        map_mul' := by
          intro x y
          symm; apply uniq
          calc e * (x * y) = (e * x) * (e * y) := by
                calc e * (x * y) = (e * e) * (x * y) := by rw [hee]
                  _ = (e * x) * (e * y) := by ring
            _ = (algebraMap (Polynomial K) B (σ₀ x) * e) *
                  (algebraMap (Polynomial K) B (σ₀ y) * e) := by rw [← hspec x, ← hspec y]
            _ = algebraMap (Polynomial K) B (σ₀ x * σ₀ y) * (e * e) := by rw [map_mul]; ring
            _ = algebraMap (Polynomial K) B (σ₀ x * σ₀ y) * e := by rw [hee]
        map_zero' := by
          symm; apply uniq; rw [map_zero, zero_mul, mul_zero]
        map_add' := by
          intro x y
          symm; apply uniq
          rw [mul_add, hspec x, hspec y, map_add, add_mul] }
    refine ⟨σ, ?_, ?_, hspec⟩
    · apply RingHom.ext
      intro r
      show σ₀ (algebraMap (Polynomial K) B r) = r
      symm; apply uniq; rw [mul_comm]
    · show σ₀ e = 1
      symm; apply uniq; rw [hee, map_one, one_mul]
  obtain ⟨σ₁, hσ₁, hσ₁e, -⟩ := retr B₁ e₁ he₁ h₁
  obtain ⟨σ₂, hσ₂, -, hσ₂x⟩ := retr B₂ e₂ he₂ h₂

  have hw : CommRingCat.ofHom (algebraMap (Polynomial K) B₁) ≫
      CommRingCat.ofHom ((Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
        (LaurentPolynomial.T (-1))).comp σ₁) =
      CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
        (LaurentPolynomial.T (-1))) ≫
      CommRingCat.ofHom (RingHom.id (LaurentPolynomial K)) := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, RingHom.comp_assoc, hσ₁,
      RingHom.comp_id, RingHom.id_comp]
  obtain ⟨τ, hτ₁, hτL⟩ : ∃ τ : C →+* LaurentPolynomial K,
      τ.comp ι₁ = (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
        (LaurentPolynomial.T (-1))).comp σ₁ ∧ τ.comp lam = RingHom.id _ := by
    refine ⟨(hP₁.desc _ _ hw).hom, ?_, ?_⟩
    · have := congrArg CommRingCat.Hom.hom (hP₁.inl_desc _ _ hw)
      simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using this
    · have := congrArg CommRingCat.Hom.hom (hP₁.inr_desc _ _ hw)
      simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using this

  have hτe : τ (ι₂ e₂) = 1 := by
    rw [← he]
    have := RingHom.congr_fun hτ₁ e₁
    simp only [RingHom.comp_apply] at this
    rw [this, hσ₁e, map_one]
  refine ⟨σ₁, σ₂, τ, hσ₁, hσ₂, hτL, hτ₁, ?_⟩
  apply RingHom.ext
  intro y
  have h1 := congrArg (fun z => τ (ι₂ z)) (hσ₂x y)
  simp only [map_mul] at h1
  have h2 := RingHom.congr_fun hsq₂ (σ₂ y)
  simp only [RingHom.comp_apply] at h2
  rw [h2, hτe] at h1
  have h3 := RingHom.congr_fun hτL (Polynomial.toLaurent (σ₂ y))
  simp only [RingHom.comp_apply, RingHom.id_apply] at h3
  rw [h3, one_mul, mul_one] at h1
  simp only [RingHom.comp_apply]
  exact h1

theorem wc_equalizer_subalgebra_finrank : ∀ (K : Type u) [Field K] (B₁ B₂ C : Type u) [CommRing B₁]
    [CommRing B₂] [CommRing C] [Algebra (Polynomial K) B₁] [Algebra (Polynomial K) B₂]
    [Algebra K B₁] [IsScalarTower K (Polynomial K) B₁] [Algebra (LaurentPolynomial K) C]
    (ι₁ : B₁ →+* C) (ι₂ : B₂ →+* C),
    ι₁.comp (algebraMap (Polynomial K) B₁) = (algebraMap (LaurentPolynomial K) C).comp
      (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K)) (LaurentPolynomial.T (-1))) →
    ι₂.comp (algebraMap (Polynomial K) B₂) = (algebraMap (LaurentPolynomial K) C).comp
      (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K) →
    ∀ (d : ℕ) (b : Module.Basis (Fin d) (Polynomial K) B₁)
      (b' : Module.Basis (Fin d) (Polynomial K) B₂)
      (c c' : Module.Basis (Fin d) (LaurentPolynomial K) C),
      (∀ (x : B₁) (i : Fin d), c.repr (ι₁ x) i = Polynomial.eval₂RingHom
        (algebraMap K (LaurentPolynomial K)) (LaurentPolynomial.T (-1)) (b.repr x i)) →
      (∀ (y : B₂) (j : Fin d), c'.repr (ι₂ y) j = Polynomial.toLaurent (b'.repr y j)) →
      (∃ a : K, a ≠ 0 ∧ (c.toMatrix ⇑c').det = LaurentPolynomial.C a) →
      (∀ (d : ℕ) (P : Matrix (Fin d) (Fin d) (LaurentPolynomial K)),
        (∃ c : K, c ≠ 0 ∧ P.det = LaurentPolynomial.C c) →
        ∃ V : Submodule K (Fin d → LaurentPolynomial K),
          (∀ v, v ∈ V ↔ (∀ i, ∃ p : Polynomial K,
              v i = LaurentPolynomial.invert (Polynomial.toLaurent p)) ∧
            ∃ w : Fin d → Polynomial K, v = P.mulVec (fun i => Polynomial.toLaurent (w i))) ∧
          FiniteDimensional K V ∧ d ≤ Module.finrank K V) →
      ∃ S : Subalgebra K B₁, (∀ x : B₁, x ∈ S ↔ ∃ y : B₂, ι₁ x = ι₂ y) ∧
        FiniteDimensional K S ∧ d ≤ Module.finrank K S :=
by
  intro K _ B₁ B₂ C _ _ _ _ _ _ _ _ ι₁ ι₂ hsq₁ hsq₂ d b b' c c' hrep₁ hrep₂ hdet H3
  classical
  set φ₁ : Polynomial K →+* LaurentPolynomial K :=
    Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K)) (LaurentPolynomial.T (-1))
    with hφ₁def

  have hφ : ∀ p : Polynomial K, φ₁ p = LaurentPolynomial.invert (Polynomial.toLaurent p) := by
    have h : φ₁ = (LaurentPolynomial.invert : LaurentPolynomial K ≃ₐ[K] LaurentPolynomial K
        ).toRingEquiv.toRingHom.comp Polynomial.toLaurent := by
      apply Polynomial.ringHom_ext
      · intro a; simp [φ₁, LaurentPolynomial.invert_C]
      · simp [φ₁, LaurentPolynomial.invert_T]
    intro p
    rw [h]; rfl
  have hφinj : Function.Injective φ₁ := by
    intro p q hpq
    rw [hφ, hφ] at hpq
    exact Polynomial.toLaurent_injective (LaurentPolynomial.invert.injective hpq)
  have hφC : ∀ a : K, φ₁ (Polynomial.C a) = algebraMap K (LaurentPolynomial K) a := by
    intro a; exact Polynomial.eval₂_C _ _
  have hCL : ∀ a : K, φ₁ (Polynomial.C a) = Polynomial.toLaurent (Polynomial.C a) := by
    intro a
    rw [hφ, Polynomial.toLaurent_C, LaurentPolynomial.invert_C]
  have hsmul : ∀ (a : K) (x : B₁), a • x = (Polynomial.C a) • x := by
    intro a x
    rw [← algebraMap_smul (Polynomial K) a x, Polynomial.algebraMap_eq]

  let Θ : B₁ →ₗ[K] (Fin d → LaurentPolynomial K) :=
    { toFun := fun x i => φ₁ (b.repr x i)
      map_add' := fun x y => by funext i; simp
      map_smul' := fun a x => by
        funext i
        simp only [RingHom.id_apply, Pi.smul_apply]
        rw [hsmul, LinearEquiv.map_smul, Finsupp.smul_apply, smul_eq_mul, map_mul, hφC,
          Algebra.smul_def] }
  have hΘ : ∀ x i, Θ x i = φ₁ (b.repr x i) := fun _ _ => rfl
  have hΘinj : Function.Injective Θ := by
    intro x x' hxx
    rw [b.ext_elem_iff]
    intro i
    apply hφinj
    rw [← hΘ, ← hΘ, hxx]

  have hscal : ∀ a : K, ∃ y : B₂, ι₁ (algebraMap K B₁ a) = ι₂ y := by
    intro a
    refine ⟨algebraMap (Polynomial K) B₂ (Polynomial.C a), ?_⟩
    rw [IsScalarTower.algebraMap_apply K (Polynomial K) B₁, Polynomial.algebraMap_eq]
    have h1 := RingHom.congr_fun hsq₁ (Polynomial.C a)
    have h2 := RingHom.congr_fun hsq₂ (Polynomial.C a)
    simp only [RingHom.comp_apply] at h1 h2
    rw [h1, h2]
    exact congrArg _ (hCL a)
  let S : Subalgebra K B₁ :=
    { carrier := {x | ∃ y : B₂, ι₁ x = ι₂ y}
      mul_mem' := by
        rintro x x' ⟨y, hy⟩ ⟨y', hy'⟩
        exact ⟨y * y', by rw [map_mul, map_mul, hy, hy']⟩
      one_mem' := ⟨1, by rw [map_one, map_one]⟩
      add_mem' := by
        rintro x x' ⟨y, hy⟩ ⟨y', hy'⟩
        exact ⟨y + y', by rw [map_add, map_add, hy, hy']⟩
      zero_mem' := ⟨0, by rw [map_zero, map_zero]⟩
      algebraMap_mem' := hscal }
  have hS : ∀ x : B₁, x ∈ S ↔ ∃ y : B₂, ι₁ x = ι₂ y := fun _ => Iff.rfl

  set P := c.toMatrix ⇑c' with hPdef
  have hstar : ∀ z : C, P.mulVec ⇑(c'.repr z) = ⇑(c.repr z) := fun z =>
    Module.Basis.toMatrix_mulVec_repr c' c z
  have hcrit : ∀ x : B₁, (∃ y : B₂, ι₁ x = ι₂ y) ↔
      ∃ w : Fin d → Polynomial K, Θ x = P.mulVec (fun i => Polynomial.toLaurent (w i)) := by
    intro x
    constructor
    · rintro ⟨y, hy⟩
      refine ⟨fun j => b'.repr y j, ?_⟩
      have e1 : (⇑(c'.repr (ι₂ y)) : Fin d → LaurentPolynomial K) =
          fun j => Polynomial.toLaurent (b'.repr y j) := funext (hrep₂ y)
      funext i
      rw [hΘ, ← hrep₁, hy, ← hstar, e1]
    · rintro ⟨w, hw⟩
      refine ⟨∑ j, w j • b' j, ?_⟩
      have e1 : (⇑(c'.repr (ι₂ (∑ j, w j • b' j))) : Fin d → LaurentPolynomial K) =
          fun j => Polynomial.toLaurent (w j) := by
        funext j
        rw [hrep₂, b'.repr_sum_self w]
      rw [c.ext_elem_iff]
      intro i
      have h := congrFun hw i
      rw [hΘ] at h
      rw [hrep₁, h, ← e1, hstar]

  obtain ⟨V, hV, hVfd, hVd⟩ := H3 d P hdet
  have hinto : ∀ x ∈ Subalgebra.toSubmodule S, Θ x ∈ V := by
    intro x hx
    rw [Subalgebra.mem_toSubmodule] at hx
    rw [hV]
    exact ⟨fun i => ⟨b.repr x i, by rw [hΘ, hφ]⟩, (hcrit x).mp ((hS x).mp hx)⟩
  have honto : ∀ v ∈ V, ∃ x ∈ Subalgebra.toSubmodule S, Θ x = v := by
    intro v hv
    rw [hV] at hv
    obtain ⟨hp, w, hw⟩ := hv
    choose p hp using hp
    have hx : Θ (∑ i, p i • b i) = v := by
      funext i
      rw [hΘ, b.repr_sum_self p, hφ, hp]
    refine ⟨∑ i, p i • b i, ?_, hx⟩
    rw [Subalgebra.mem_toSubmodule, hS, hcrit]
    exact ⟨w, by rw [hx]; exact hw⟩
  have hmap : (Subalgebra.toSubmodule S).map Θ = V := by
    ext v
    rw [Submodule.mem_map]
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact hinto x hx
    · intro hv
      exact honto v hv
  let e : (Subalgebra.toSubmodule S) ≃ₗ[K] V :=
    (Submodule.equivMapOfInjective Θ hΘinj (Subalgebra.toSubmodule S)).trans
      (LinearEquiv.ofEq _ _ hmap)
  have hUfd : FiniteDimensional K (Subalgebra.toSubmodule S) := LinearEquiv.finiteDimensional e.symm
  have hUr : Module.finrank K (Subalgebra.toSubmodule S) = Module.finrank K V :=
    LinearEquiv.finrank_eq e
  refine ⟨S, hS, Subalgebra.finiteDimensional_toSubmodule.mp hUfd, ?_⟩
  rw [← Subalgebra.finrank_toSubmodule, hUr]
  exact hVd

theorem wc_P1_alg_section : ∀ (K : Type u) [Field K] [IsAlgClosed K],
    (∀ (B : Type u) [CommRing B] [Algebra (Polynomial K) B] [Module.Finite (Polynomial K) B]
      [Algebra.Etale (Polynomial K) B],
      Module.Free (Polynomial K) B ∧ ∀ (d : ℕ) (b : Module.Basis (Fin d) (Polynomial K) B),
        ∃ c : K, c ≠ 0 ∧ Algebra.discr (Polynomial K) ⇑b = Polynomial.C c) →
    (∀ (d : ℕ) (P : Matrix (Fin d) (Fin d) (LaurentPolynomial K)),
      (∃ c : K, c ≠ 0 ∧ P.det = LaurentPolynomial.C c) →
      ∃ V : Submodule K (Fin d → LaurentPolynomial K),
        (∀ v, v ∈ V ↔ (∀ i, ∃ p : Polynomial K,
            v i = LaurentPolynomial.invert (Polynomial.toLaurent p)) ∧
          ∃ w : Fin d → Polynomial K, v = P.mulVec (fun i => Polynomial.toLaurent (w i))) ∧
        FiniteDimensional K V ∧ d ≤ Module.finrank K V) →
    ∀ (B₁ B₂ C : Type u) [CommRing B₁] [CommRing B₂] [CommRing C]
      [Algebra (Polynomial K) B₁] [Algebra (Polynomial K) B₂]
      [Module.Finite (Polynomial K) B₁] [Algebra.Etale (Polynomial K) B₁]
      [Module.Finite (Polynomial K) B₂] [Algebra.Etale (Polynomial K) B₂] [Nontrivial B₁]
      (ι₁ : B₁ →+* C) (ι₂ : B₂ →+* C) (lam : LaurentPolynomial K →+* C),
      IsPushout (CommRingCat.ofHom (algebraMap (Polynomial K) B₁))
        (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
          (LaurentPolynomial.T (-1))))
        (CommRingCat.ofHom ι₁) (CommRingCat.ofHom lam) →
      IsPushout (CommRingCat.ofHom (algebraMap (Polynomial K) B₂))
        (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K))
        (CommRingCat.ofHom ι₂) (CommRingCat.ofHom lam) →
      ∃ (σ₁ : B₁ →+* Polynomial K) (σ₂ : B₂ →+* Polynomial K) (τ : C →+* LaurentPolynomial K),
        σ₁.comp (algebraMap (Polynomial K) B₁) = RingHom.id _ ∧
        σ₂.comp (algebraMap (Polynomial K) B₂) = RingHom.id _ ∧
        τ.comp lam = RingHom.id _ ∧
        τ.comp ι₁ = (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
          (LaurentPolynomial.T (-1))).comp σ₁ ∧
        τ.comp ι₂ = (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K).comp σ₂ :=
by
  intro K _ _ H1 H3 B₁ B₂ C _ _ _ _ _ _ _ _ _ _ ι₁ ι₂ lam hP₁ hP₂
  classical

  have hφ : (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
      (LaurentPolynomial.T (-1)) : Polynomial K →+* LaurentPolynomial K) =
      (LaurentPolynomial.invert : LaurentPolynomial K ≃ₐ[K] LaurentPolynomial K).toRingEquiv.toRingHom.comp
        (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K) := by
    apply Polynomial.ringHom_ext
    · intro a
      simp [LaurentPolynomial.invert_C]
    · simp [LaurentPolynomial.invert_T]
  have hφinj : Function.Injective (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
      (LaurentPolynomial.T (-1)) : Polynomial K →+* LaurentPolynomial K) := by
    rw [hφ]
    intro x y h
    simpa using h
  have hφC : ∀ δ : K, (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
      (LaurentPolynomial.T (-1)) : Polynomial K →+* LaurentPolynomial K) (Polynomial.C δ) =
      LaurentPolynomial.C δ := by
    intro δ
    simp

  haveI hfree1 : Module.Free (Polynomial K) B₁ := (H1 B₁).1
  haveI hfree2 : Module.Free (Polynomial K) B₂ := (H1 B₂).1
  obtain ⟨d₁, b, -⟩ : ∃ d, ∃ _ : Module.Basis (Fin d) (Polynomial K) B₁, True :=
    ⟨_, Module.finBasis _ _, trivial⟩
  obtain ⟨d₂, b', -⟩ : ∃ d, ∃ _ : Module.Basis (Fin d) (Polynomial K) B₂, True :=
    ⟨_, Module.finBasis _ _, trivial⟩
  obtain ⟨δ₁, hδ₁, hdb⟩ := (H1 B₁).2 d₁ b
  obtain ⟨δ₂, hδ₂, hdb'⟩ := (H1 B₂).2 d₂ b'

  letI : Algebra (LaurentPolynomial K) C := lam.toAlgebra
  have hsq₁ : ι₁.comp (algebraMap (Polynomial K) B₁) =
      lam.comp (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
        (LaurentPolynomial.T (-1))) := by
    have := congrArg CommRingCat.Hom.hom hP₁.toCommSq.w
    simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using this
  have hsq₂ : ι₂.comp (algebraMap (Polynomial K) B₂) =
      lam.comp (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K) := by
    have := congrArg CommRingCat.Hom.hom hP₂.toCommSq.w
    simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using this

  obtain ⟨c, hc⟩ := wc_pushout_basis (Polynomial K) (LaurentPolynomial K) B₁ C
    (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K)) (LaurentPolynomial.T (-1)))
    ι₁ d₁ b hP₁
  obtain ⟨c', hc'⟩ := wc_pushout_basis (Polynomial K) (LaurentPolynomial K) B₂ C
    (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K) ι₂ d₂ b' hP₂
  have hd : d₁ = d₂ := by
    have h1 := Module.finrank_eq_card_basis c
    have h2 := Module.finrank_eq_card_basis c'
    simpa using h1.symm.trans h2
  subst hd
  have hd1 : 0 < d₁ := Fin.pos_iff_nonempty.mpr b.index_nonempty

  obtain ⟨hrep₁, hinj₁, hdisc₁⟩ := wc_basechange_basis_facts (Polynomial K) (LaurentPolynomial K)
    B₁ C (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K)) (LaurentPolynomial.T (-1)))
    ι₁ hsq₁ d₁ b c hc
  obtain ⟨hrep₂, hinj₂, hdisc₂⟩ := wc_basechange_basis_facts (Polynomial K) (LaurentPolynomial K)
    B₂ C (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K) ι₂ hsq₂ d₁ b' c' hc'
  have hι₁ : Function.Injective ι₁ := hinj₁ hφinj
  have hι₂ : Function.Injective ι₂ := hinj₂ Polynomial.toLaurent_injective
  rw [hdb, hφC] at hdisc₁
  rw [hdb', Polynomial.toLaurent_C] at hdisc₂

  have hcc : (⇑c' : Fin d₁ → C) = ((c.toMatrix ⇑c').transpose.map
      (algebraMap (LaurentPolynomial K) C)).mulVec ⇑c := by
    funext j
    simp only [Matrix.mulVec, dotProduct, Matrix.map_apply, Matrix.transpose_apply,
      Module.Basis.toMatrix_apply, ← Algebra.smul_def]
    exact (c.sum_repr (c' j)).symm
  have hdisc := Algebra.discr_of_matrix_mulVec (⇑c) (c.toMatrix ⇑c').transpose
  rw [← hcc, Matrix.det_transpose, hdisc₁, hdisc₂] at hdisc
  obtain ⟨a, ha, hdet⟩ := wc_laurent_sq_mul_C_const K (c.toMatrix ⇑c').det δ₁ δ₂ hδ₁ hδ₂
    hdisc.symm

  letI : Algebra K B₁ :=
    ((algebraMap (Polynomial K) B₁).comp (algebraMap K (Polynomial K))).toAlgebra
  haveI : IsScalarTower K (Polynomial K) B₁ := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  haveI : IsReduced B₁ := wc_isReduced_of_discr_ne_zero (Polynomial K) B₁ d₁ b
    (by rw [hdb]; exact Polynomial.C_ne_zero.mpr hδ₁)
  obtain ⟨S, hS, hSfd, hSd⟩ := wc_equalizer_subalgebra_finrank K B₁ B₂ C ι₁ ι₂ hsq₁ hsq₂ d₁ b b'
    c c' hrep₁ hrep₂ ⟨a, ha, hdet⟩ H3

  haveI := hSfd
  obtain ⟨e, heS, heid, hene, heorth, hesum⟩ := wc_fd_reduced_subalgebra_idempotents K B₁ S
  choose e' he' using fun k => (hS (e k)).mp (heS k)
  have he'id : ∀ k, e' k * e' k = e' k := by
    intro k
    apply hι₂
    rw [map_mul, ← he' k, ← map_mul, heid k]
  have he'ne : ∀ k, e' k ≠ 0 := by
    intro k h
    apply hene k
    apply hι₁
    rw [he' k, h, map_zero, map_zero]
  have he'orth : ∀ k l, k ≠ l → e' k * e' l = 0 := by
    intro k l hkl
    apply hι₂
    rw [map_mul, ← he' k, ← he' l, ← map_mul, heorth k l hkl, map_zero, map_zero]
  have he'sum : ∑ k, e' k = 1 := by
    apply hι₂
    rw [map_sum, map_one]
    simp_rw [← he']
    rw [← map_sum, hesum, map_one]

  have hn : d₁ ≤ Module.finrank K S := hSd
  let k₀ : Fin (Module.finrank K S) := ⟨0, lt_of_lt_of_le hd1 hn⟩
  have hr1 := wc_rank_one_of_idempotents (Polynomial K) B₁ d₁ b _ e hn heid hene heorth hesum k₀
  have hr2 := wc_rank_one_of_idempotents (Polynomial K) B₂ d₁ b' _ e' hn he'id he'ne he'orth
    he'sum k₀
  exact wc_sections_of_global_idempotent K B₁ B₂ C ι₁ ι₂ lam hP₁ hsq₂ (e k₀) (e' k₀) (heid k₀)
    (he'id k₀) (he' k₀) hr1 hr2

theorem wc_P1_fet_section_of_alg : ∀ (K : Type u) [Field K] [IsAlgClosed K],
    (∀ (B₁ B₂ C : Type u) [CommRing B₁] [CommRing B₂] [CommRing C]
      [Algebra (Polynomial K) B₁] [Algebra (Polynomial K) B₂]
      [Module.Finite (Polynomial K) B₁] [Algebra.Etale (Polynomial K) B₁]
      [Module.Finite (Polynomial K) B₂] [Algebra.Etale (Polynomial K) B₂] [Nontrivial B₁]
      (ι₁ : B₁ →+* C) (ι₂ : B₂ →+* C) (lam : LaurentPolynomial K →+* C),
      IsPushout (CommRingCat.ofHom (algebraMap (Polynomial K) B₁))
        (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
          (LaurentPolynomial.T (-1))))
        (CommRingCat.ofHom ι₁) (CommRingCat.ofHom lam) →
      IsPushout (CommRingCat.ofHom (algebraMap (Polynomial K) B₂))
        (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K))
        (CommRingCat.ofHom ι₂) (CommRingCat.ofHom lam) →
      ∃ (σ₁ : B₁ →+* Polynomial K) (σ₂ : B₂ →+* Polynomial K) (τ : C →+* LaurentPolynomial K),
        σ₁.comp (algebraMap (Polynomial K) B₁) = RingHom.id _ ∧
        σ₂.comp (algebraMap (Polynomial K) B₂) = RingHom.id _ ∧
        τ.comp lam = RingHom.id _ ∧
        τ.comp ι₁ = (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
          (LaurentPolynomial.T (-1))).comp σ₁ ∧
        τ.comp ι₂ = (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K).comp σ₂) →
    ∀ (E : Scheme.{u})
      (πE : E ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra),
      IsFinite πE → Etale πE → Surjective πE →
      ∃ σ : @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra ⟶ E, σ ≫ πE = 𝟙 _ :=
by
  have charts : ∀ (A : Type u) [CommRing A], ∃ (j c : Spec (.of (Polynomial A)) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), IsOpenImmersion j ∧ IsOpenImmersion c ∧ IsAffineHom j ∧ (∀ x, x ∈ Set.range j ∨ x ∈ Set.range c) ∧ IsPullback (Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A)) (LaurentPolynomial.T (-1))))) (Spec.map (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A))) j c := by
    intro A _
    let 𝒜 : ℕ → Submodule A (MvPolynomial (Fin 2) A) := MvPolynomial.homogeneousSubmodule (Fin 2) A
    let _inst𝒜 : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have fin2 : ∀ a b c : Fin 2, a ≠ b → c ≠ a → c = b := by decide
    have hX : ∀ i : Fin 2, (MvPolynomial.X i : MvPolynomial (Fin 2) A) ∈ 𝒜 1 := fun i =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X A i)
    have h11 : ∀ k : Fin 2, (MvPolynomial.X k : MvPolynomial (Fin 2) A) ∈ 𝒜 (1 • 1) := fun k => by
      rw [smul_eq_mul, mul_one]; exact hX k
    have s1 : ∀ {T : Type u} [CommRing T] (f : A →+* T) (g : Fin 2 → T) (c : T)
        (φ : MvPolynomial (Fin 2) A) (n : ℕ), φ.IsHomogeneous n →
        MvPolynomial.eval₂ f (fun i => c * g i) φ = c ^ n * MvPolynomial.eval₂ f g φ := by
      intro T _ f g c φ n hφ
      conv_lhs => rw [φ.as_sum]
      conv_rhs => rw [φ.as_sum]
      rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun d hd => ?_)
      rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
      have hdeg : ∑ i ∈ d.support, d i = n := by
        have := hφ (MvPolynomial.mem_support_iff.mp hd)
        simpa [Finsupp.weight_apply, Finsupp.sum] using this
      simp only [Finsupp.prod, mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
      ring
    have hval0 : ∀ (f : MvPolynomial (Fin 2) A) (a : ↥(𝒜 0)),
        (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f) a).val =
          algebraMap (MvPolynomial (Fin 2) A) (Localization.Away f) (a : MvPolynomial (Fin 2) A) := by
      intro f a
      rfl
    have hcoe0 : ∀ r : A, ((algebraMap A (𝒜 0) r : ↥(𝒜 0)) : MvPolynomial (Fin 2) A) = MvPolynomial.C r := by
      intro r
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    have chart : ∀ i k : Fin 2, i ≠ k → ∃ e : Polynomial A ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i),
        (∀ r : A, e (Polynomial.C r) = HomogeneousLocalization.fromZeroRingHom 𝒜
          (Submonoid.powers (MvPolynomial.X i)) (algebraMap A (𝒜 0) r)) ∧
        e Polynomial.X = HomogeneousLocalization.Away.mk 𝒜 (hX i) 1 (MvPolynomial.X k) (h11 k) := by
      intro i k hik
      obtain ⟨κ, hκ⟩ : ∃ κ : A →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i),
          κ = (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X i))).comp
            (algebraMap A (𝒜 0)) := ⟨_, rfl⟩
      obtain ⟨α, hα⟩ : ∃ α : Polynomial A →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i),
          α = Polynomial.eval₂RingHom κ
            (HomogeneousLocalization.Away.mk 𝒜 (hX i) 1 (MvPolynomial.X k) (h11 k)) := ⟨_, rfl⟩
      obtain ⟨ψ, hψ⟩ : ∃ ψ : MvPolynomial (Fin 2) A →+* Polynomial A,
          ψ = MvPolynomial.eval₂Hom Polynomial.C (fun j => if j = i then 1 else Polynomial.X) := ⟨_, rfl⟩
      have hψi : ψ (MvPolynomial.X i) = 1 := by rw [hψ, MvPolynomial.eval₂Hom_X', if_pos rfl]
      have hψk : ψ (MvPolynomial.X k) = Polynomial.X := by
        rw [hψ, MvPolynomial.eval₂Hom_X', if_neg (Ne.symm hik)]
      have hψC : ∀ r, ψ (MvPolynomial.C r) = Polynomial.C r := by
        intro r; rw [hψ, MvPolynomial.eval₂Hom_C]
      have hψv : ψ (MvPolynomial.X i) * 1 = 1 := by rw [hψi, mul_one]
      have hu : IsUnit (ψ (MvPolynomial.X i)) := by rw [hψi]; exact isUnit_one
      obtain ⟨χ, hχ⟩ : ∃ χ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i) →+* Polynomial A,
          χ = (Localization.awayLift ψ (MvPolynomial.X i) hu).comp
            (algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i))
              (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))) := ⟨_, rfl⟩
      have hχmk : ∀ (n : ℕ) (a : MvPolynomial (Fin 2) A) (ha : a ∈ 𝒜 (n • 1)),
          χ (HomogeneousLocalization.Away.mk 𝒜 (hX i) n a ha) = ψ a := by
        intro n a ha
        rw [hχ, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
          HomogeneousLocalization.Away.val_mk, Localization.awayLift_mk ψ (MvPolynomial.X i) a 1 hψv n,
          one_pow, mul_one]
      have hκv : ∀ r, (κ r).val = algebraMap (MvPolynomial (Fin 2) A)
          (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.C r) := by
        intro r
        rw [hκ, RingHom.comp_apply, hval0, hcoe0]
      have h1 : χ.comp α = RingHom.id _ := by
        apply Polynomial.ringHom_ext
        · intro r
          rw [RingHom.comp_apply, hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hχ,
            RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply, hκv]
          first
            | rw [IsLocalization.lift_eq]
            | erw [IsLocalization.lift_eq]
          rw [hψC, RingHom.id_apply]
        · rw [RingHom.comp_apply, hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hχmk, hψk,
            RingHom.id_apply]
      have h2 : α.comp χ = RingHom.id _ := by
        refine RingHom.ext fun w => ?_
        obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX i) w
        rw [RingHom.comp_apply, hχmk, RingHom.id_apply]
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.Away.val_mk]
        have ha' : a.IsHomogeneous n := by
          have := (MvPolynomial.mem_homogeneousSubmodule _ a).1 ha
          simpa using this
        obtain ⟨μ, hμdef⟩ : ∃ μ : Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A),
            μ = IsLocalization.mk' (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))
              (1 : MvPolynomial (Fin 2) A) ⟨MvPolynomial.X i, Submonoid.mem_powers _⟩ := ⟨_, rfl⟩
        have hμ : μ * algebraMap (MvPolynomial (Fin 2) A)
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X i) = 1 := by
          have := IsLocalization.mk'_spec (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))
            (1 : MvPolynomial (Fin 2) A) ⟨MvPolynomial.X i, Submonoid.mem_powers _⟩
          rw [map_one] at this
          rw [hμdef]; exact this
        have hρ : (algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i))
              (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp (α.comp ψ) =
            MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin 2) A)
              (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp MvPolynomial.C)
              (fun j => μ * algebraMap (MvPolynomial (Fin 2) A)
                (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X j)) := by
          apply MvPolynomial.ringHom_ext
          · intro r
            simp only [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
            rw [hψC, hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
              HomogeneousLocalization.algebraMap_apply, hκv]
          · intro j
            simp only [MvPolynomial.eval₂Hom_X', RingHom.comp_apply]
            by_cases hj : j = i
            · subst hj
              rw [hψi, map_one, map_one, hμ]
            · have hjk : j = k := fin2 i k j hik hj
              subst hjk
              rw [hψk, hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
                HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
                Localization.mk_eq_mk'_apply, IsLocalization.mk'_eq_iff_eq_mul]
              show _ = μ * _ * algebraMap (MvPolynomial (Fin 2) A)
                (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X i ^ 1)
              rw [pow_one, mul_comm μ, mul_assoc, hμ, mul_one]
        have hσ : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin 2) A)
              (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp MvPolynomial.C)
              (fun j => algebraMap (MvPolynomial (Fin 2) A)
                (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X j)) =
            algebraMap (MvPolynomial (Fin 2) A)
              (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) := by
          apply MvPolynomial.ringHom_ext
          · intro r; simp only [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
          · intro j; simp only [MvPolynomial.eval₂Hom_X']
        have hval : (α (ψ a)).val = ((algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i))
              (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp (α.comp ψ)) a := by
          rw [RingHom.comp_apply, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
        rw [hval, hρ, MvPolynomial.coe_eval₂Hom, s1 _ (fun j => algebraMap (MvPolynomial (Fin 2) A)
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X j)) μ a n ha',
          ← MvPolynomial.coe_eval₂Hom, hσ, Localization.mk_eq_mk'_apply, eq_comm,
          IsLocalization.mk'_eq_iff_eq_mul]
        show _ = μ ^ n * _ * algebraMap (MvPolynomial (Fin 2) A)
          (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X i ^ n)
        rw [map_pow, mul_comm (μ ^ n), mul_assoc, ← mul_pow, hμ, one_pow, mul_one]
      refine ⟨RingEquiv.ofRingHom α χ h2 h1, ?_, ?_⟩
      · intro r
        show α (Polynomial.C r) = _
        rw [hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hκ, RingHom.comp_apply]
      · show α Polynomial.X = _
        rw [hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
    have specIso : ∀ {R R' : Type u} [CommRing R] [CommRing R'] (e : R ≃+* R'),
        ∃ E : Spec (CommRingCat.of R') ≅ Spec (CommRingCat.of R),
          E.hom = Spec.map (CommRingCat.ofHom e.toRingHom) := by
      intro R R' _ _ e
      refine ⟨⟨Spec.map (CommRingCat.ofHom e.toRingHom), Spec.map (CommRingCat.ofHom e.symm.toRingHom),
        ?_, ?_⟩, rfl⟩
      · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, RingEquiv.toRingHom_comp_symm_toRingHom,
          CommRingCat.ofHom_id, Spec.map_id]
      · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, RingEquiv.symm_toRingHom_comp_toRingHom,
          CommRingCat.ofHom_id, Spec.map_id]
    obtain ⟨e0, he0C, he0X⟩ := chart 0 1 (by decide)
    obtain ⟨e1, he1C, he1X⟩ := chart 1 0 (by decide)
    have hx' : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
        MvPolynomial.X 1 * MvPolynomial.X 0 := mul_comm _ _
    letI alg : Algebra (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1))
        (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1)) :=
      (HomogeneousLocalization.awayMap 𝒜 (hX 0) hx').toAlgebra
    haveI hloc : IsLocalization.Away (HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0))
        (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1)) :=
      HomogeneousLocalization.Away.isLocalization_mul (hX 1) (hX 0) hx' one_ne_zero
    have helem : e1 Polynomial.X = HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0) := by
      rw [he1X]
      apply HomogeneousLocalization.val_injective
      simp only [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk,
        pow_one]
    have H : Submonoid.map e1.toMonoidHom (Submonoid.powers (Polynomial.X : Polynomial A)) =
        Submonoid.powers (HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0)) := by
      rw [Submonoid.map_powers]
      exact congrArg Submonoid.powers helem
    obtain ⟨e01, he01⟩ : ∃ e01 : LaurentPolynomial A ≃+*
        HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1),
        e01 = IsLocalization.ringEquivOfRingEquiv (LaurentPolynomial A)
          (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1)) e1 H := ⟨_, rfl⟩
    have Sq2 : e01.toRingHom.comp (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A) =
        (HomogeneousLocalization.awayMap 𝒜 (hX 0) hx').comp e1.toRingHom := by
      refine RingHom.ext fun p => ?_
      show e01 (Polynomial.toLaurent p) = HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 p)
      rw [← LaurentPolynomial.algebraMap_eq_toLaurent, he01, IsLocalization.ringEquivOfRingEquiv_eq]
      rfl
    have hS2' : ∀ p : Polynomial A, e01 (Polynomial.toLaurent p) =
        HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 p) := fun p => by
      have := congrArg (fun φ => φ p) Sq2
      exact this
    have hCL : ∀ r : A, Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
        (LaurentPolynomial.T (-1)) (Polynomial.C r) = Polynomial.toLaurent (Polynomial.C r) := by
      intro r
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      first
        | rfl
        | simp [Polynomial.toLaurent_C, LaurentPolynomial.algebraMap_apply]
    have Sq1 : e01.toRingHom.comp (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
          (LaurentPolynomial.T (-1))) =
        (HomogeneousLocalization.awayMap 𝒜 (hX 1)
          (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
            MvPolynomial.X 0 * MvPolynomial.X 1)).comp e0.toRingHom := by
      apply Polynomial.ringHom_ext
      · intro r
        show e01 (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
          (LaurentPolynomial.T (-1)) (Polynomial.C r)) = HomogeneousLocalization.awayMap 𝒜 (hX 1)
          (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
            MvPolynomial.X 0 * MvPolynomial.X 1) (e0 (Polynomial.C r))
        rw [hCL, hS2', he0C, he1C, HomogeneousLocalization.awayMap_fromZeroRingHom,
          HomogeneousLocalization.awayMap_fromZeroRingHom]
      · show e01 (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
          (LaurentPolynomial.T (-1)) Polynomial.X) = HomogeneousLocalization.awayMap 𝒜 (hX 1)
          (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
            MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X)
        have hT1 : e01 (LaurentPolynomial.T 1) =
            HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X) := by
          rw [← Polynomial.toLaurent_X]; exact hS2' _
        have hK : HomogeneousLocalization.awayMap 𝒜 (hX 1)
              (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
                MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X) *
            HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X) = 1 := by
          rw [he0X, he1X, HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk]
          apply HomogeneousLocalization.val_injective
          rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_one,
            HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, Localization.mk_mul,
            ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
          refine ⟨1, ?_⟩
          simp only [Submonoid.coe_mul, OneMemClass.coe_one, one_mul, mul_one, pow_one]
          ring
        have hb : e01 (LaurentPolynomial.T (-1)) * e01 (LaurentPolynomial.T 1) = 1 := by
          rw [← map_mul, ← LaurentPolynomial.T_add, show (-1 : ℤ) + 1 = 0 by norm_num,
            LaurentPolynomial.T_zero, map_one]
        rw [hT1] at hb
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        calc e01 (LaurentPolynomial.T (-1))
            = e01 (LaurentPolynomial.T (-1)) * (HomogeneousLocalization.awayMap 𝒜 (hX 1)
              (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
                MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X) *
              HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X)) := by rw [hK, mul_one]
          _ = HomogeneousLocalization.awayMap 𝒜 (hX 1)
              (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
                MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X) *
              (e01 (LaurentPolynomial.T (-1)) *
                HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X)) := by ring
          _ = _ := by rw [hb, mul_one]
    obtain ⟨E0, hE0⟩ := specIso e0
    obtain ⟨E1, hE1⟩ := specIso e1
    obtain ⟨E01, hE01⟩ := specIso e01
    obtain ⟨j, hj⟩ : ∃ j : Spec (CommRingCat.of (Polynomial A)) ⟶ Proj 𝒜,
        j = E0.inv ≫ Proj.awayι 𝒜 (MvPolynomial.X 0) (hX 0) one_pos := ⟨_, rfl⟩
    obtain ⟨c, hc⟩ : ∃ c : Spec (CommRingCat.of (Polynomial A)) ⟶ Proj 𝒜,
        c = E1.inv ≫ Proj.awayι 𝒜 (MvPolynomial.X 1) (hX 1) one_pos := ⟨_, rfl⟩
    have hj0 : E0.hom ≫ j = Proj.awayι 𝒜 (MvPolynomial.X 0) (hX 0) one_pos := by
      rw [hj, Iso.hom_inv_id_assoc]
    have hc0 : E1.hom ≫ c = Proj.awayι 𝒜 (MvPolynomial.X 1) (hX 1) one_pos := by
      rw [hc, Iso.hom_inv_id_assoc]
    have hirr : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) A)) := by
      intro a ha
      have h0 : GradedRing.proj 𝒜 0 a = 0 := (HomogeneousIdeal.mem_irrelevant_iff 𝒜 a).1 ha
      have hc : a.coeff 0 = 0 := by
        have h1 : GradedRing.proj 𝒜 0 a = MvPolynomial.homogeneousComponent 0 a :=
          MvPolynomial.decomposition.decompose'_apply a 0
        rw [h1, MvPolynomial.homogeneousComponent_zero] at h0
        exact MvPolynomial.C_injective (Fin 2) A (h0.trans (map_zero _).symm)
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.1 hm) hc
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.1 hm0
      exact ⟨i, Set.mem_univ _, hi⟩
    have htop := Proj.iSup_basicOpen_eq_top 𝒜 (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) A) hirr
    refine ⟨j, c, ?_, ?_, ?_, ?_, ?_⟩
    · rw [hj]; infer_instance
    · rw [hc]; infer_instance
    · have : IsAffineHom (j ≫ Proj.toSpecZero 𝒜) := isAffineHom_of_isAffine _
      have := Proj.isSeparated 𝒜
      exact IsAffineHom.of_comp j (Proj.toSpecZero 𝒜)
    · intro p
      have hp : p ∈ (⊤ : (Proj 𝒜).Opens) := trivial
      rw [← htop, TopologicalSpace.Opens.mem_iSup] at hp
      obtain ⟨i, hi⟩ := hp
      have hi' : p ∈ Set.range (Proj.awayι 𝒜 (MvPolynomial.X i) (hX i) one_pos) := by
        rw [← Scheme.Hom.coe_opensRange, Proj.opensRange_awayι]; exact hi
      obtain ⟨y, hy⟩ := hi'
      have hi2 : i = 0 ∨ i = 1 := by fin_cases i <;> simp
      rcases hi2 with rfl | rfl
      · refine Or.inl ⟨E0.hom y, ?_⟩
        rw [← hy, ← hj0]
        rfl
      · refine Or.inr ⟨E1.hom y, ?_⟩
        rw [← hy, ← hc0]
        rfl
    · refine IsPullback.of_iso (IsPullback.of_hasPullback
        (Proj.awayι 𝒜 (MvPolynomial.X 0) (hX 0) one_pos) (Proj.awayι 𝒜 (MvPolynomial.X 1) (hX 1) one_pos))
        (Proj.pullbackAwayιIso 𝒜 (hX 0) one_pos (hX 1) one_pos rfl ≪≫ E01) E0 E1 (Iso.refl _)
        ?_ ?_ ?_ ?_
      · rw [Iso.trans_hom, hE0, hE01, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, Sq1,
          CommRingCat.ofHom_comp, Spec.map_comp, ← Category.assoc,
          Proj.pullbackAwayιIso_hom_SpecMap_awayMap_left]
      · rw [Iso.trans_hom, hE1, hE01, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, Sq2,
          CommRingCat.ofHom_comp, Spec.map_comp, ← Category.assoc,
          Proj.pullbackAwayιIso_hom_SpecMap_awayMap_right]
      · rw [Iso.refl_hom, Category.comp_id, hj0]
      · rw [Iso.refl_hom, Category.comp_id, hc0]
  intro K _ _ H E πE hfin het hsurj
  haveI := hfin
  haveI := het
  haveI := hsurj

  have s1 : ∀ {R : CommRingCat.{u}} {Y : Scheme.{u}} [IsAffine Y] (p : Y ⟶ Spec R),
      Y.isoSpec.hom ≫ Spec.map ((Scheme.ΓSpecIso R).inv ≫ p.appTop) = p := by
    intro R Y _ p
    rw [Spec.map_comp, ← Category.assoc, Scheme.isoSpec_hom_naturality, Category.assoc,
      Scheme.isoSpec_Spec_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]
  have s1b : ∀ {R : CommRingCat.{u}} {Y : Scheme.{u}} [IsAffine Y] (p : Y ⟶ Spec R)
      (σ : Γ(Y, ⊤) ⟶ R), ((Scheme.ΓSpecIso R).inv ≫ p.appTop) ≫ σ = 𝟙 R →
      (Spec.map σ ≫ Y.isoSpec.inv) ≫ p = 𝟙 (Spec R) := by
    intro R Y _ p σ hσ
    have e := s1 p
    calc (Spec.map σ ≫ Y.isoSpec.inv) ≫ p
        = (Spec.map σ ≫ Y.isoSpec.inv) ≫ Y.isoSpec.hom ≫
            Spec.map ((Scheme.ΓSpecIso R).inv ≫ p.appTop) := by rw [e]
      _ = 𝟙 (Spec R) := by
        rw [Category.assoc, Iso.inv_hom_id_assoc, ← Spec.map_comp, hσ, Spec.map_id]

  have s7 : ∀ {R R' : CommRingCat.{u}} {Y Y' : Scheme.{u}} [IsAffine Y] [IsAffine Y']
      (f : Y' ⟶ Y) (ψ : R ⟶ R') (σ : Γ(Y, ⊤) ⟶ R) (τ : Γ(Y', ⊤) ⟶ R'),
      f.appTop ≫ τ = σ ≫ ψ →
      Spec.map ψ ≫ Spec.map σ ≫ Y.isoSpec.inv = Spec.map τ ≫ Y'.isoSpec.inv ≫ f := by
    intro R R' Y Y' _ _ f ψ σ τ h
    have e := Scheme.isoSpec_inv_naturality f
    calc Spec.map ψ ≫ Spec.map σ ≫ Y.isoSpec.inv = Spec.map (σ ≫ ψ) ≫ Y.isoSpec.inv := by
          rw [Spec.map_comp, Category.assoc]
      _ = Spec.map (f.appTop ≫ τ) ≫ Y.isoSpec.inv := by rw [h]
      _ = Spec.map τ ≫ Y'.isoSpec.inv ≫ f := by rw [Spec.map_comp, Category.assoc, e]

  have s2 : ∀ {R : CommRingCat.{u}} {Y : Scheme.{u}} [IsAffine Y] (p : Y ⟶ Spec R)
      [IsFinite p] [Etale p],
      ((Scheme.ΓSpecIso R).inv ≫ p.appTop).hom.Finite ∧
        ((Scheme.ΓSpecIso R).inv ≫ p.appTop).hom.Etale := by
    intro R Y _ p _ _
    have e : Spec.map ((Scheme.ΓSpecIso R).inv ≫ p.appTop) = Y.isoSpec.inv ≫ p :=
      (Iso.eq_inv_comp _).mpr (s1 p)
    refine ⟨(IsFinite.SpecMap_iff _).mp ?_, (HasRingHomProperty.Spec_iff (P := @Etale)).mp ?_⟩
    · rw [e]; infer_instance
    · rw [e]; infer_instance

  have s3 : ∀ {R S : CommRingCat.{u}} {Y₀ Y₁ : Scheme.{u}} [IsAffine Y₀] [IsAffine Y₁]
      (fst : Y₀ ⟶ Y₁) (snd : Y₀ ⟶ Spec S) (p : Y₁ ⟶ Spec R) (ψ : R ⟶ S),
      IsPullback fst snd p (Spec.map ψ) →
      IsPushout ((Scheme.ΓSpecIso R).inv ≫ p.appTop) ψ fst.appTop
        ((Scheme.ΓSpecIso S).inv ≫ snd.appTop) := by
    intro R S Y₀ Y₁ _ _ fst snd p ψ h
    have h2 : IsPullback (Spec.map fst.appTop) (Spec.map ((Scheme.ΓSpecIso S).inv ≫ snd.appTop))
        (Spec.map ((Scheme.ΓSpecIso R).inv ≫ p.appTop)) (Spec.map ψ) :=
      IsPullback.of_iso h Y₀.isoSpec Y₁.isoSpec (Iso.refl _) (Iso.refl _)
        (Scheme.isoSpec_hom_naturality fst).symm
        (by rw [Iso.refl_hom, Category.comp_id, s1 snd])
        (by rw [Iso.refl_hom, Category.comp_id, s1 p])
        (by simp)
    have h3 : IsPullback fst.appTop.op ((Scheme.ΓSpecIso S).inv ≫ snd.appTop).op
        ((Scheme.ΓSpecIso R).inv ≫ p.appTop).op ψ.op := by
      refine IsPullback.of_map Scheme.Spec ?_ h2
      have hw := h2.w
      rw [← Spec.map_comp, ← Spec.map_comp] at hw
      rw [← op_comp, ← op_comp]
      exact congrArg Quiver.Hom.op (Spec.map_injective hw)
    exact h3.unop.flip

  obtain ⟨j, c, hj, hc, -, hcov, hsq⟩ := charts K
  haveI := hj
  haveI := hc
  obtain ⟨f₁, hf₁⟩ : ∃ f₁ : CommRingCat.of (Polynomial K) ⟶ CommRingCat.of (LaurentPolynomial K),
      f₁ = CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
        (LaurentPolynomial.T (-1))) := ⟨_, rfl⟩
  obtain ⟨f₂, hf₂⟩ : ∃ f₂ : CommRingCat.of (Polynomial K) ⟶ CommRingCat.of (LaurentPolynomial K),
      f₂ = CommRingCat.ofHom (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K) :=
    ⟨_, rfl⟩
  rw [← hf₁, ← hf₂] at hsq
  have hw : Spec.map f₁ ≫ j = Spec.map f₂ ≫ c := hsq.w

  haveI hAj : IsAffine (Limits.pullback πE j) := isAffine_of_isAffineHom (Limits.pullback.snd πE j)
  haveI hAc : IsAffine (Limits.pullback πE c) := isAffine_of_isAffineHom (Limits.pullback.snd πE c)
  haveI hAO : IsAffine (Limits.pullback (Limits.pullback.snd πE j) (Spec.map f₁)) :=
    isAffine_of_isAffineHom (Limits.pullback.snd (Limits.pullback.snd πE j) (Spec.map f₁))

  obtain ⟨y₀⟩ : Nonempty (Spec (CommRingCat.of (Polynomial K))) := inferInstance
  obtain ⟨e₀, he₀⟩ := πE.surjective (j y₀)
  obtain ⟨z₀, -, -⟩ := Scheme.Pullback.exists_preimage_pullback e₀ y₀ he₀
  haveI hnt : Nontrivial ↑Γ(Limits.pullback πE j, ⊤) :=
    @Scheme.component_nontrivial _ ⊤ ⟨⟨z₀, trivial⟩⟩

  obtain ⟨g, hg1, hg2'⟩ : ∃ g : Limits.pullback (Limits.pullback.snd πE j) (Spec.map f₁) ⟶
      Limits.pullback πE c,
      g ≫ Limits.pullback.fst πE c = Limits.pullback.fst (Limits.pullback.snd πE j) (Spec.map f₁) ≫
        Limits.pullback.fst πE j ∧
      g ≫ Limits.pullback.snd πE c =
        Limits.pullback.snd (Limits.pullback.snd πE j) (Spec.map f₁) ≫ Spec.map f₂ := by
    refine ⟨Limits.pullback.lift
      (Limits.pullback.fst (Limits.pullback.snd πE j) (Spec.map f₁) ≫ Limits.pullback.fst πE j)
      (Limits.pullback.snd (Limits.pullback.snd πE j) (Spec.map f₁) ≫ Spec.map f₂) ?_,
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    simp only [Category.assoc]
    rw [Limits.pullback.condition, ← Category.assoc, Limits.pullback.condition, Category.assoc, hw]
  have hg2 : IsPullback g (Limits.pullback.snd (Limits.pullback.snd πE j) (Spec.map f₁))
      (Limits.pullback.snd πE c) (Spec.map f₂) := by
    have big := IsPullback.paste_horiz
      (IsPullback.of_hasPullback (Limits.pullback.snd πE j) (Spec.map f₁))
      (IsPullback.of_hasPullback πE j)
    rw [hw, ← hg1] at big
    exact IsPullback.of_right big hg2' (IsPullback.of_hasPullback πE c)

  obtain ⟨hfj, hej⟩ := s2 (Limits.pullback.snd πE j)
  obtain ⟨hfc, hec⟩ := s2 (Limits.pullback.snd πE c)
  letI alg1 : Algebra (Polynomial K) ↑Γ(Limits.pullback πE j, ⊤) :=
    ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial K))).inv ≫
      (Limits.pullback.snd πE j).appTop).hom.toAlgebra
  letI alg2 : Algebra (Polynomial K) ↑Γ(Limits.pullback πE c, ⊤) :=
    ((Scheme.ΓSpecIso (CommRingCat.of (Polynomial K))).inv ≫
      (Limits.pullback.snd πE c).appTop).hom.toAlgebra
  haveI : Module.Finite (Polynomial K) ↑Γ(Limits.pullback πE j, ⊤) :=
    RingHom.finite_algebraMap.mp hfj
  haveI : Algebra.Etale (Polynomial K) ↑Γ(Limits.pullback πE j, ⊤) :=
    RingHom.etale_algebraMap.mp hej
  haveI : Module.Finite (Polynomial K) ↑Γ(Limits.pullback πE c, ⊤) :=
    RingHom.finite_algebraMap.mp hfc
  haveI : Algebra.Etale (Polynomial K) ↑Γ(Limits.pullback πE c, ⊤) :=
    RingHom.etale_algebraMap.mp hec
  have PO1 := s3 (Limits.pullback.fst (Limits.pullback.snd πE j) (Spec.map f₁))
    (Limits.pullback.snd (Limits.pullback.snd πE j) (Spec.map f₁)) (Limits.pullback.snd πE j) f₁
    (IsPullback.of_hasPullback _ _)
  have PO2 := s3 g (Limits.pullback.snd (Limits.pullback.snd πE j) (Spec.map f₁))
    (Limits.pullback.snd πE c) f₂ hg2
  subst hf₁ hf₂
  obtain ⟨σ₁, σ₂, τ, h1, h2, -, h4, h5⟩ := H ↑Γ(Limits.pullback πE j, ⊤) ↑Γ(Limits.pullback πE c, ⊤)
    ↑Γ(Limits.pullback (Limits.pullback.snd πE j) (Spec.map (CommRingCat.ofHom
      (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K)) (LaurentPolynomial.T (-1))))), ⊤)
    (Limits.pullback.fst (Limits.pullback.snd πE j) _).appTop.hom g.appTop.hom
    ((Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial K))).inv ≫
      (Limits.pullback.snd (Limits.pullback.snd πE j) _).appTop).hom
    (by exact PO1) (by exact PO2)

  have hsj := s1b (Limits.pullback.snd πE j) (CommRingCat.ofHom σ₁) (CommRingCat.hom_ext h1)
  have hsc := s1b (Limits.pullback.snd πE c) (CommRingCat.ofHom σ₂) (CommRingCat.hom_ext h2)
  have ht₁ : ((Spec.map (CommRingCat.ofHom σ₁) ≫ (Limits.pullback πE j).isoSpec.inv) ≫
      Limits.pullback.fst πE j) ≫ πE = j := by
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hsj, Category.id_comp]
  have ht₂ : ((Spec.map (CommRingCat.ofHom σ₂) ≫ (Limits.pullback πE c).isoSpec.inv) ≫
      Limits.pullback.fst πE c) ≫ πE = c := by
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hsc, Category.id_comp]
  have A := s7 (Limits.pullback.fst (Limits.pullback.snd πE j) _)
    (CommRingCat.ofHom (Polynomial.eval₂RingHom
        (algebraMap K (LaurentPolynomial K)) (LaurentPolynomial.T (-1))))
    (CommRingCat.ofHom σ₁) (CommRingCat.ofHom τ) (CommRingCat.hom_ext h4)
  have B := s7 g (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K))
    (CommRingCat.ofHom σ₂) (CommRingCat.ofHom τ) (CommRingCat.hom_ext h5)
  have A' := congrArg (· ≫ Limits.pullback.fst πE j) A
  have B' := congrArg (· ≫ Limits.pullback.fst πE c) B
  simp only [Category.assoc] at A' B'
  rw [hg1] at B'
  have hover : Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom
        (algebraMap K (LaurentPolynomial K)) (LaurentPolynomial.T (-1)))) ≫
      ((Spec.map (CommRingCat.ofHom σ₁) ≫ (Limits.pullback πE j).isoSpec.inv) ≫
        Limits.pullback.fst πE j) =
      Spec.map (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K)) ≫
      ((Spec.map (CommRingCat.ofHom σ₂) ≫ (Limits.pullback πE c).isoSpec.inv) ≫
        Limits.pullback.fst πE c) := by
    simp only [Category.assoc]
    rw [A', B']

  generalize (Spec.map (CommRingCat.ofHom σ₁) ≫ (Limits.pullback πE j).isoSpec.inv) ≫
      Limits.pullback.fst πE j = t₁ at ht₁ hover
  generalize (Spec.map (CommRingCat.ofHom σ₂) ≫ (Limits.pullback πE c).isoSpec.inv) ≫
      Limits.pullback.fst πE c = t₂ at ht₂ hover
  have hcov' : ∀ x, ∃ (b : Bool) (y : Spec (CommRingCat.of (Polynomial K))), (cond b j c) y = x := by
    intro x
    rcases hcov x with ⟨y, hy⟩ | ⟨y, hy⟩
    · exact ⟨true, y, hy⟩
    · exact ⟨false, y, hy⟩
  let 𝒰 : Scheme.OpenCover _ := Scheme.Cover.mkOfCovers (P := @IsOpenImmersion) Bool
    (fun _ => Spec (CommRingCat.of (Polynomial K))) (fun b => cond b j c) hcov'
    (fun b => by cases b; exacts [hc, hj])
  have hf : ∀ x y : 𝒰.I₀, Limits.pullback.fst (𝒰.f x) (𝒰.f y) ≫ (fun b => cond b t₁ t₂) x =
      Limits.pullback.snd (𝒰.f x) (𝒰.f y) ≫ (fun b => cond b t₁ t₂) y := by
    intro x y
    cases x <;> cases y
    · show Limits.pullback.fst c c ≫ t₂ = Limits.pullback.snd c c ≫ t₂
      rw [Limits.fst_eq_snd_of_mono_eq]
    · show Limits.pullback.fst c j ≫ t₂ = Limits.pullback.snd c j ≫ t₁
      rw [← hsq.flip.isoPullback_inv_fst, ← hsq.flip.isoPullback_inv_snd]
      simp only [Category.assoc]
      rw [hover]
    · show Limits.pullback.fst j c ≫ t₁ = Limits.pullback.snd j c ≫ t₂
      rw [← hsq.isoPullback_inv_fst, ← hsq.isoPullback_inv_snd]
      simp only [Category.assoc]
      rw [hover]
    · show Limits.pullback.fst j j ≫ t₁ = Limits.pullback.snd j j ≫ t₁
      rw [Limits.fst_eq_snd_of_mono_eq]
  refine ⟨Scheme.Cover.glueMorphisms 𝒰 (fun b => cond b t₁ t₂) hf, ?_⟩
  refine Scheme.Cover.hom_ext 𝒰 _ _ (fun b => ?_)
  have key := Scheme.Cover.ι_glueMorphisms 𝒰 (fun b => cond b t₁ t₂) hf b
  rw [← Category.assoc]
  refine (congrArg (· ≫ πE) key).trans ?_
  rw [Category.comp_id]
  cases b
  · exact ht₂
  · exact ht₁

theorem wc_P1bar_fet_section (F'' : Type u) [Field F''] [Finite F'']
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (E : Scheme.{u}) (πE : E ⟶ (wcGeomPoint F'' (wcP1Over F'') hP).left)
    (hfin : IsFinite πE) (het : Etale πE) (hsurj : Surjective πE) :
    ∃ σ : (wcGeomPoint F'' (wcP1Over F'') hP).left ⟶ E, σ ≫ πE = 𝟙 _ :=
by
  classical

  obtain ⟨e₀, he₀, -⟩ := wcpa_proj_base_change F'' (AlgebraicClosure F'') 1
  let e : (wcGeomPoint F'' (wcP1Over F'') hP).left ⟶
      @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) (AlgebraicClosure F''))
        MvPolynomial.gradedAlgebra := e₀
  haveI : IsIso e := he₀

  have h3 := wc_P1_alg_section (AlgebraicClosure F'')
    (wc_poly_etale_free_discr_const (AlgebraicClosure F''))
    (wc_laurent_lattice_dim_ge (AlgebraicClosure F''))
  haveI := hfin
  haveI := het
  haveI := hsurj
  obtain ⟨σ', hσ'⟩ := wc_P1_fet_section_of_alg (AlgebraicClosure F'') h3 E (πE ≫ e)
    inferInstance inferInstance inferInstance
  refine ⟨e ≫ σ', ?_⟩
  have hinv : σ' ≫ πE = inv e := by
    apply (cancel_mono e).mp
    rw [Category.assoc, hσ', IsIso.inv_hom_id]
  rw [Category.assoc, hinv, IsIso.hom_inv_id]

theorem wc_iuc2_Ub_fet_section (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hmiss : ∀ t : (wcP1Over F'').left, lam t ∉ Δ)
    (Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens)
    (hUb : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      y ∈ Ub ↔ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∉ Δ)
    (E : Scheme.{u}) (πE : E ⟶ Ub.toScheme) (hfin : IsFinite πE) (het : Etale πE)
    (hsurj : Surjective πE) :
    ∃ σ : Ub.toScheme ⟶ E, σ ≫ πE = 𝟙 _ :=
by
  classical

  have s2 : ∀ {C E : Scheme.{u}} (p : E ⟶ C), IsFinite p → Etale p →
      ∀ (s : C ⟶ E), s ≫ p = 𝟙 C → _root_.IsPreconnected (Set.univ : Set ↥E) → Nonempty C →
      IsIso p := by
    intro C E p hpf hpe s hs hconn hC
    haveI := hpf
    haveI := hpe
    haveI : Etale (s ≫ p) := by rw [hs]; infer_instance
    haveI : Etale s := Etale.of_comp s p
    haveI : IsSplitMono s := IsSplitMono.mk' ⟨p, hs⟩
    haveI : IsOpenImmersion s := IsOpenImmersion.of_flat_of_mono s
    have hw : 𝟙 E ≫ p = (p ≫ s) ≫ p := by
      rw [Category.assoc, hs, Category.comp_id, Category.id_comp]
    have hrange : Set.range s = (Limits.pullback.lift (𝟙 E) (p ≫ s) hw) ⁻¹'
        Set.range (Limits.pullback.diagonal p) := by
      ext e
      constructor
      · rintro ⟨x, rfl⟩
        refine ⟨s x, ?_⟩
        have h3 : s ≫ Limits.pullback.diagonal p =
            s ≫ Limits.pullback.lift (𝟙 E) (p ≫ s) hw := by
          apply Limits.pullback.hom_ext
          · rw [Category.assoc, Category.assoc, Limits.pullback.diagonal_fst,
              Limits.pullback.lift_fst]
          · rw [Category.assoc, Category.assoc, Limits.pullback.diagonal_snd,
              Limits.pullback.lift_snd, reassoc_of% hs, Category.comp_id]
        rw [← Scheme.Hom.comp_apply, h3, Scheme.Hom.comp_apply]
      · rintro ⟨e', he'⟩
        have h1 := congrArg (Limits.pullback.fst p p) he'
        have h2 := congrArg (Limits.pullback.snd p p) he'
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.diagonal_fst,
          Limits.pullback.lift_fst] at h1
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.diagonal_snd,
          Limits.pullback.lift_snd, Scheme.Hom.comp_apply] at h2
        refine ⟨p e, ?_⟩
        rw [← h2]
        simpa using h1
    have hcl : IsClosed (Set.range s) := by
      rw [hrange]
      exact (Limits.pullback.diagonal p).isClosedEmbedding.isClosed_range.preimage
        (Limits.pullback.lift (𝟙 E) (p ≫ s) hw).continuous
    have hop : IsOpen (Set.range s) := s.isOpenEmbedding.isOpen_range
    haveI : PreconnectedSpace E := ⟨hconn⟩
    obtain ⟨c₀⟩ := hC
    have huniv : Set.range s = Set.univ := IsClopen.eq_univ ⟨hcl, hop⟩ ⟨s c₀, c₀, rfl⟩
    haveI : Surjective s := ⟨Set.range_eq_univ.mp huniv⟩
    haveI : IsIso s :=
      (isIso_iff_isOpenImmersion_and_surjective s).mpr ⟨inferInstance, inferInstance⟩
    haveI : IsIso (s ≫ p) := by rw [hs]; infer_instance
    exact IsIso.of_isIso_comp_left s p

  have s1 : ∀ {U E C : Scheme.{u}} (πE : E ⟶ U), IsFinite πE → Etale πE → Surjective πE →
      ConnectedSpace E → ∀ (c : C ⟶ U), Nonempty C → Mono (Limits.pullback.snd πE c) →
      IsIso πE := by
    intro U E C πE hf he hsurj hE c hC hmono
    haveI := hf
    haveI := he
    haveI := hsurj
    obtain ⟨c₀⟩ := hC
    have hRo : IsOpen (Set.range (Limits.pullback.diagonal πE)) :=
      (Limits.pullback.diagonal πE).isOpenEmbedding.isOpen_range
    have hRc : IsClosed (Set.range (Limits.pullback.diagonal πE)) :=
      (Limits.pullback.diagonal πE).isClosedEmbedding.isClosed_range
    have hsurjΔ : Function.Surjective (Limits.pullback.diagonal πE) := by
      by_contra hK
      have hKne : (Set.range (Limits.pullback.diagonal πE))ᶜ.Nonempty := by
        rw [← Set.range_eq_univ] at hK
        by_contra h0
        rw [Set.not_nonempty_iff_eq_empty, Set.compl_empty_iff] at h0
        exact hK h0
      have himg : (Limits.pullback.fst πE πE) '' (Set.range (Limits.pullback.diagonal πE))ᶜ =
          Set.univ := by
        apply IsClopen.eq_univ
        · exact ⟨(Limits.pullback.fst πE πE).isClosedMap _ hRo.isClosed_compl,
            (Limits.pullback.fst πE πE).isOpenMap _ hRc.isOpen_compl⟩
        · exact hKne.image _
      obtain ⟨e₀, he₀⟩ := hsurj.surj (c c₀)
      obtain ⟨k₀, hk₀K, hk₀⟩ :
          e₀ ∈ (Limits.pullback.fst πE πE) '' (Set.range (Limits.pullback.diagonal πE))ᶜ := by
        rw [himg]; trivial
      obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.fst πE πE ≫ πE) (g := c) k₀ c₀
        (by rw [Scheme.Hom.comp_apply, hk₀, he₀])
      have w1 : (Limits.pullback.fst (Limits.pullback.fst πE πE ≫ πE) c ≫
          Limits.pullback.fst πE πE) ≫ πE =
          Limits.pullback.snd (Limits.pullback.fst πE πE ≫ πE) c ≫ c := by
        rw [Category.assoc]; exact Limits.pullback.condition
      have w2 : (Limits.pullback.fst (Limits.pullback.fst πE πE ≫ πE) c ≫
          Limits.pullback.snd πE πE) ≫ πE =
          Limits.pullback.snd (Limits.pullback.fst πE πE ≫ πE) c ≫ c := by
        rw [Category.assoc, ← Limits.pullback.condition, ← w1, Category.assoc]
      have hm : Limits.pullback.lift _ _ w1 = Limits.pullback.lift _ _ w2 :=
        (cancel_mono (Limits.pullback.snd πE c)).1
          (by rw [Limits.pullback.lift_snd, Limits.pullback.lift_snd])
      have h12 : Limits.pullback.fst (Limits.pullback.fst πE πE ≫ πE) c ≫
          Limits.pullback.fst πE πE =
          Limits.pullback.fst (Limits.pullback.fst πE πE ≫ πE) c ≫
          Limits.pullback.snd πE πE := by
        have := congrArg (· ≫ Limits.pullback.fst πE c) hm
        simp only [Limits.pullback.lift_fst] at this
        exact this
      have ha : Limits.pullback.fst (Limits.pullback.fst πE πE ≫ πE) c =
          (Limits.pullback.fst (Limits.pullback.fst πE πE ≫ πE) c ≫
            Limits.pullback.fst πE πE) ≫ Limits.pullback.diagonal πE := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.diagonal_fst, Category.comp_id]
        · rw [Category.assoc, Limits.pullback.diagonal_snd, Category.comp_id, h12]
      apply hk₀K
      refine ⟨Limits.pullback.fst πE πE k₀, ?_⟩
      have := congrArg (fun f => f z) ha
      simp only [Scheme.Hom.comp_apply] at this
      rw [← hz]
      exact this.symm
    haveI : Surjective (Limits.pullback.diagonal πE) := ⟨hsurjΔ⟩
    haveI : IsIso (Limits.pullback.diagonal πE) :=
      (isIso_iff_isOpenImmersion_and_surjective _).mpr ⟨inferInstance, inferInstance⟩
    haveI : Mono πE := (Limits.pullback.isIso_diagonal_iff πE).mp inferInstance
    haveI : IsOpenImmersion πE := IsOpenImmersion.of_flat_of_mono πE
    exact (isIso_iff_isOpenImmersion_and_surjective πE).mpr ⟨inferInstance, inferInstance⟩

  obtain ⟨_, _, _, hM, _, _, _, _, hlamstr, hlin, _⟩ := id hH
  have hcond : (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ lam) ≫
        (Over.mk (wcProjKStr F'' M')).hom =
      Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) := by
    have hl' : lam ≫ (Over.mk (wcProjKStr F'' M')).hom = (wcP1Over F'').hom := hlamstr
    rw [Category.assoc, hl']
    exact Limits.pullback.condition
  obtain ⟨lb, hlb1, hlb2⟩ : ∃ lb : Limits.pullback (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ⟶
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      lb ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
        Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ≫ lam ∧
      lb ≫ Limits.pullback.snd (Over.mk (wcProjKStr F'' M')).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) =
        Limits.pullback.snd (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) :=
    ⟨Limits.pullback.lift _ _ hcond, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')

  have hlbU : ∀ y, lb y ∈ Ub := by
    intro y
    refine (hUb _).2 ?_
    have e1 := congrArg (fun k : Limits.pullback (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ⟶
          wcProjK F'' M' => k y) hlb1
    simp only [Scheme.Hom.comp_apply] at e1
    rw [e1]
    exact hmiss _

  haveI hirr1 := wc_proj_space_irreducible F'' 1
  obtain ⟨t₁⟩ : Nonempty (wcProjK F'' 1) := inferInstance
  obtain ⟨y₁, -, -⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := (wcP1Over F'').hom)
    (g := Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
    t₁ (IsLocalRing.closedPoint (AlgebraicClosure F''))
    (@Subsingleton.elim (PrimeSpectrum F'') inferInstance _ _)
  obtain ⟨eP, heP, -⟩ := wcpa_proj_base_change F'' (AlgebraicClosure F'') M'
  haveI := heP
  haveI := wc_proj_space_irreducible (AlgebraicClosure F'') M'
  haveI hirrP : IrreducibleSpace (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left :=
    Function.Surjective.irreducibleSpace (Scheme.Hom.homeomorph eP).symm.continuous
      (Scheme.Hom.homeomorph eP).symm.surjective
  have hirr : IsIrreducible (Ub : Set (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left) :=
    ⟨⟨lb y₁, hlbU y₁⟩, (IrreducibleSpace.isIrreducible_univ _).isPreirreducible.open_subset
      Ub.isOpen (Set.subset_univ _)⟩
  have hconnU : ConnectedSpace Ub.toScheme := isConnected_iff_connectedSpace.mp hirr.isConnected

  have hfstS : Function.Surjective (Limits.pullback.fst lb Ub.ι) := by
    intro y
    have hy : lb y ∈ Set.range Ub.ι := by rw [Scheme.Opens.range_ι]; exact hlbU y
    obtain ⟨u0, hu0⟩ := hy
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := lb) (g := Ub.ι)
      y u0 hu0.symm
    exact ⟨z, hz⟩
  haveI : Surjective (Limits.pullback.fst lb Ub.ι) := ⟨hfstS⟩
  haveI : IsIso (Limits.pullback.fst lb Ub.ι) :=
    (isIso_iff_isOpenImmersion_and_surjective _).mpr ⟨inferInstance, inferInstance⟩
  obtain ⟨c₁, -⟩ := hfstS y₁

  suffices key : ∀ (E₁ : Scheme.{u}) (π₁ : E₁ ⟶ Ub.toScheme), IsFinite π₁ → Etale π₁ →
      Surjective π₁ → ConnectedSpace E₁ → IsIso π₁ by
    obtain ⟨G, ιG, hGf, hGe, hGs, hGc⟩ :=
      wc_fet_connected_clopen_piece Ub.toScheme E πE hfin het hsurj hconnU
    haveI := key G (ιG ≫ πE) hGf hGe hGs hGc
    exact ⟨inv (ιG ≫ πE) ≫ ιG, by rw [Category.assoc, IsIso.inv_hom_id]⟩
  intro E₁ π₁ hfin₁ het₁ hsurj₁ hEc
  haveI := hfin₁
  haveI := het₁
  haveI := hsurj₁

  obtain ⟨hqc, hνfin, hνsurj, hirrN⟩ := wc_plt_normalization_facts F'' M' hPP Ub E₁ π₁ hEc
  haveI := hqc
  haveI := hνfin
  haveI := hνsurj
  haveI := hirrN
  have hj := wc_hfe_normalization_restrict _ E₁ Ub π₁ inferInstance
  obtain ⟨ψ, Lk, hLk, hψ⟩ := wc_plt_geom_line_range F'' M' lam hlamstr hlin hPP lb hlb1 hlb2
  haveI hψI : IsIso ψ.hom := Iso.isIso_hom ψ
  haveI hψS : Surjective ψ.hom := ((isIso_iff_isOpenImmersion_and_surjective ψ.hom).mp hψI).2
  haveI hψF : IsFinite ψ.hom := IsFinite.instOfIsIsoScheme ψ.hom
  haveI hcS : Surjective ((π₁ ≫ Ub.ι).fromNormalization ≫ ψ.hom) :=
    (Surjective.comp_iff (π₁ ≫ Ub.ι).fromNormalization ψ.hom).mpr hψS
  haveI hcF : IsFinite ((π₁ ≫ Ub.ι).fromNormalization ≫ ψ.hom) :=
    IsFinite.instCompScheme (π₁ ≫ Ub.ι).fromNormalization ψ.hom
  have hFH := wc_plt_fulton_hansen_line (AlgebraicClosure F'') M' hM
    (π₁ ≫ Ub.ι).normalization ((π₁ ≫ Ub.ι).fromNormalization ≫ ψ.hom) Lk hLk
  have hY : _root_.IsPreconnected (⇑(π₁ ≫ Ub.ι).fromNormalization ⁻¹' Set.range ⇑lb) := by
    rw [← hψ]
    exact hFH
  have hC := wc_plt_line_connected_glue F' F'' Y n D M' Xu h Δ lam p hH hPP Ub hUb E₁ π₁
    lb hlb1 hlb2 _ (π₁ ≫ Ub.ι).fromNormalization _ hj hY (fun y hy => absurd (hlbU _) hy)

  haveI : Surjective (Limits.pullback.snd π₁ (Limits.pullback.snd lb Ub.ι)) :=
    MorphismProperty.of_isPullback (P := @Surjective) (IsPullback.of_hasPullback π₁ _) hsurj₁
  have hqF : IsFinite (Limits.pullback.snd π₁ (Limits.pullback.snd lb Ub.ι) ≫
      Limits.pullback.fst lb Ub.ι) := inferInstance
  have hqE : Etale (Limits.pullback.snd π₁ (Limits.pullback.snd lb Ub.ι) ≫
      Limits.pullback.fst lb Ub.ι) := inferInstance
  have hqS : Surjective (Limits.pullback.snd π₁ (Limits.pullback.snd lb Ub.ι) ≫
      Limits.pullback.fst lb Ub.ι) := inferInstance
  obtain ⟨σ₁, hσ₁⟩ := wc_P1bar_fet_section F'' hP _
    (Limits.pullback.snd π₁ (Limits.pullback.snd lb Ub.ι) ≫ Limits.pullback.fst lb Ub.ι)
    hqF hqE hqS
  have hsec : ∀ σ : Limits.pullback (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))) ⟶
        Limits.pullback π₁ (Limits.pullback.snd lb Ub.ι),
      σ ≫ Limits.pullback.snd π₁ (Limits.pullback.snd lb Ub.ι) ≫ Limits.pullback.fst lb Ub.ι =
        𝟙 _ →
      (Limits.pullback.fst lb Ub.ι ≫ σ) ≫
        Limits.pullback.snd π₁ (Limits.pullback.snd lb Ub.ι) = 𝟙 _ := by
    intro σ hσ
    rw [← cancel_mono (Limits.pullback.fst lb Ub.ι), Category.assoc, Category.assoc, hσ,
      Category.comp_id, Category.id_comp]
  have hs : (Limits.pullback.fst lb Ub.ι ≫ σ₁) ≫
      Limits.pullback.snd π₁ (Limits.pullback.snd lb Ub.ι) = 𝟙 _ := hsec σ₁ hσ₁

  haveI : IsIso (Limits.pullback.snd π₁ (Limits.pullback.snd lb Ub.ι)) :=
    s2 _ inferInstance inferInstance _ hs hC ⟨c₁⟩
  exact s1 π₁ hfin₁ het₁ hsurj₁ hEc (Limits.pullback.snd lb Ub.ι) ⟨c₁⟩ inferInstance

theorem wc_pfam_lfl_iu_codim2_trivial (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hm : D.m = 0) (Vξ Tξ : (wcProjK F'' M').ProEt) (uξ : Tξ ⟶ Vξ)
    (v : Vξ ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    (e' : Vξ.left ≅ Spec (.of A')) (L : Type u) [Field L] [IsSepClosed L]
    (eL : Tξ.left ≅ Spec (.of L))
    (hΔξ : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      (v.left (e'.inv (IsLocalRing.closedPoint A'))) ∈ Δ)
    (hclξ : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
      y ∈ closure {v.left (e'.inv (IsLocalRing.closedPoint A'))})
    (τ : Tξ ⟶ Tξ) (hτ : τ ≫ uξ = uξ) :
    ∀ x, ((wcRq h ℓ (n - 1)).obj.map τ.op).hom x = x :=
by
  classical
  obtain ⟨_, hprop, _, _, hΔ, _, hsm, _, _, _, _, hlamΔ, _⟩ := id hH
  haveI hfp : IsProper h := hprop

  have hmiss : ∀ t : (wcP1Over F'').left, lam t ∉ Δ := by
    intro t ht
    obtain ⟨i, _⟩ := (hlamΔ t).1 ht
    have hi := i.isLt
    omega

  haveI hirr1 := wc_proj_space_irreducible F'' 1
  obtain ⟨t₁⟩ : Nonempty (wcProjK F'' 1) := inferInstance
  obtain ⟨p₀, hp₀, -⟩ := Scheme.Pullback.exists_preimage_pullback
    (f := (Over.mk (wcProjKStr F'' M')).hom)
    (g := Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
    (lam t₁) (IsLocalRing.closedPoint (AlgebraicClosure F''))
    (@Subsingleton.elim (PrimeSpectrum F'') inferInstance _ _)
  have hp₀' : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom p₀ = lam t₁ := hp₀
  have hne : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom p₀ ∉ Δ := by
    rw [hp₀']; exact hmiss t₁
  haveI hPw : WeaklyEtale (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom := hPP

  let U₀ : (wcProjK F'' M').Opens := ⟨Δᶜ, isOpen_compl_iff.mpr hΔ⟩
  let Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens :=
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom ⁻¹ᵁ U₀
  have hUb : ∀ x : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left, x ∈ Ub ↔
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom x ∉ Δ := fun x => Iff.rfl
  haveI hpr : IsProper (Over.mk (wcProjKStr F'' M')).hom := wc_proj_space_isProper F'' M'
  haveI : IsLocallyNoetherian (Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd _ _)
  haveI : CompactSpace ↥(Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd _ _)
  haveI : AlgebraicGeometry.IsNoetherian (Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    AlgebraicGeometry.IsNoetherian.mk
  haveI hN : TopologicalSpace.NoetherianSpace
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left :=
    (inferInstance : TopologicalSpace.NoetherianSpace ↥(Limits.pullback
      (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
  obtain ⟨eP, heP, -⟩ := wcpa_proj_base_change F'' (AlgebraicClosure F'') M'
  haveI := heP
  haveI := wc_proj_space_irreducible (AlgebraicClosure F'') M'
  haveI hirrP : IrreducibleSpace (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left :=
    Function.Surjective.irreducibleSpace (Scheme.Hom.homeomorph eP).symm.continuous
      (Scheme.Hom.homeomorph eP).symm.surjective
  have hirr : IsIrreducible (Ub : Set (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left) :=
    ⟨⟨p₀, (hUb p₀).2 hne⟩, (IrreducibleSpace.isIrreducible_univ _).isPreirreducible.open_subset
      Ub.isOpen (Set.subset_univ _)⟩
  haveI hNU : TopologicalSpace.NoetherianSpace Ub.toScheme :=
    TopologicalSpace.NoetherianSpace.set
      (Ub : Set (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left)
  have hconn : ConnectedSpace Ub.toScheme := isConnected_iff_connectedSpace.mp hirr.isConnected
  haveI hcpt : CompactSpace Ub.toScheme := inferInstance
  have hqs : QuasiSeparatedSpace Ub.toScheme := inferInstance
  have hu : WeaklyEtale (Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) :=
    inferInstance
  let VU : (wcProjK F'' M').ProEt :=
    MorphismProperty.Over.mk ⊤ (Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) hu

  have hres : ∀ q' k : ℕ, ∃ (b : ℕ) (e : Fin b → ℕ),
      Nonempty ((((wcProEtPush h).rightDerived q').obj
          (wcContSheaf Xu.left (ZMod (ℓ ^ k)))).over VU ≅
        (wcContSheaf (wcProjK F'' M') ((j : Fin b) → ZMod (ℓ ^ e j))).over VU) := by
    intro q' k
    obtain ⟨N, Vc, vc, hetc, hcov, hV, b₀, e₀, hiso⟩ :=
      wc_pfam_Rq_torsion_etale_locally_const F'' M' Xu.left h Δ hΔ hsm ℓ hℓ hPP Ub hUb hcpt q' k
    obtain ⟨E, πE, hfin, hetE, hsurj, hE, b₁, e₁, ⟨θ₁⟩⟩ :=
      wc_proet_loc_const_finite_fet_trivial (wcProjK F'' M') _ ℓ Ub.toScheme
        (Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) hu hconn hcpt hqs
        N Vc vc hetc hcov hV b₀ e₀ hiso
    obtain ⟨σ, hσ⟩ := wc_iuc2_Ub_fet_section F' F'' Y n D M' Xu h Δ lam p hH hPP hmiss Ub hUb
      E πE hfin hetE hsurj
    let Eo : (wcProjK F'' M').ProEt :=
      MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι ≫
        (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) hE
    let c : VU ⟶ Eo :=
      MorphismProperty.Over.homMk σ
        (show σ ≫ πE ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
            Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom by
          rw [← Category.assoc, hσ, Category.id_comp]) trivial
    exact ⟨b₁, e₁,
      ⟨((Scheme.ProEt.topology (wcProjK F'' M')).overMapPullback AddCommGrpCat.{u+1} c).mapIso θ₁⟩⟩
  obtain ⟨a, b, e, hZ⟩ :=
    wc_proet_Rq_int_const_of_torsion_const h ℓ VU hconn hcpt hqs hres (n - 1)
  obtain ⟨θ, -⟩ := wc_proet_Rq_rat_linear_triv h ℓ VU hconn hcpt hqs (n - 1) a b e hZ

  have hsub : ∀ x y : Tξ.left, x = y := by
    intro x y
    have h1 : eL.hom x = eL.hom y :=
      @Subsingleton.elim (PrimeSpectrum L) inferInstance (eL.hom x) (eL.hom y)
    have hx : eL.inv (eL.hom x) = x := by simp
    have hy : eL.inv (eL.hom y) = y := by simp
    rw [← hx, ← hy, h1]
  haveI : WeaklyEtale Tξ.hom := Tξ.prop
  have hgen : ∀ ⦃a : Tξ.left⦄ ⦃b⦄, b ⤳ Tξ.hom a → ∃ a', a' ⤳ a ∧ Tξ.hom a' = b :=
    Flat.generalizingMap Tξ.hom
  haveI hirrM := wc_proj_space_irreducible F'' M'
  have hηΔ : genericPoint (wcProjK F'' M') ∉ Δ := by
    intro hin
    exact hmiss t₁ ((genericPoint_specializes (lam t₁)).mem_closed hΔ hin)
  have hTΔ : ∀ t : Tξ.left, Tξ.hom t ∉ Δ := by
    intro t
    have hsp : genericPoint (wcProjK F'' M') ⤳ Tξ.hom t := genericPoint_specializes _
    obtain ⟨t', -, ht'⟩ := hgen hsp
    rw [hsub t t', ht']
    exact hηΔ

  have hw : (uξ.left ≫ v.left) ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom =
      Tξ.hom := by
    rw [Category.assoc, MorphismProperty.Over.w v, MorphismProperty.Over.w uξ]
  have hrange : Set.range ⇑(uξ.left ≫ v.left) ⊆ Set.range ⇑Ub.ι := by
    rintro _ ⟨t, rfl⟩
    rw [Scheme.Opens.range_ι]
    refine (hUb _).2 ?_
    have e1 := congrArg (fun k : Tξ.left ⟶ wcProjK F'' M' => k t) hw
    simp only [Scheme.Hom.comp_apply] at e1 ⊢
    rw [e1]
    exact hTΔ t
  let ψl : Tξ.left ⟶ Ub.toScheme := IsOpenImmersion.lift Ub.ι (uξ.left ≫ v.left) hrange
  have hψl : ψl ≫ Ub.ι = uξ.left ≫ v.left := IsOpenImmersion.lift_fac _ _ _
  let ψ : Tξ ⟶ VU := MorphismProperty.Over.homMk ψl
    (show ψl ≫ Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom = Tξ.hom by
      rw [← Category.assoc, hψl, hw]) trivial

  have hτl : τ.left ≫ uξ.left = uξ.left := congrArg (fun f => f.left) hτ
  have hτψ : τ ≫ ψ = ψ := by
    apply MorphismProperty.Over.Hom.ext
    show τ.left ≫ ψl = ψl
    apply (cancel_mono Ub.ι).1
    rw [Category.assoc, hψl, ← Category.assoc, hτl]

  have hNθ : ∀ (V V' : (wcProjK F'' M').ProEt) (k : V' ⟶ V) (c : V ⟶ VU) (u : V' ⟶ VU),
      k ≫ c = u → ∀ (y : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op V)) (z : V'.left),
      (show C(↥V'.left, Fin a → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk u))).hom
          (((wcRq h ℓ (n - 1)).obj.map k.op).hom y)).down) z =
      (show C(↥V.left, Fin a → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom y).down) (k.left z) := by
    rintro V V' k c u rfl y z
    have e := congrArg (fun m => m.hom y)
      (θ.hom.hom.naturality (Over.homMk k rfl : Over.mk (k ≫ c) ⟶ Over.mk c).op)
    exact congrArg (fun w : ULift.{u+1} C(↥V'.left, Fin a → ℚ_[ℓ]) => w.down z) e

  have hcancel : ∀ c : ((wcRq h ℓ (n - 1)).over VU).obj.obj (Opposite.op (Over.mk ψ)),
      (θ.inv.hom.app (Opposite.op (Over.mk ψ))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk ψ))).hom c) = c := fun c =>
    congrArg (fun m => (m.hom.app (Opposite.op (Over.mk ψ))).hom c) θ.hom_inv_id
  intro y
  have hfun : (show C(↥Tξ.left, Fin a → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk ψ))).hom
          (((wcRq h ℓ (n - 1)).obj.map τ.op).hom y)).down) =
      (show C(↥Tξ.left, Fin a → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk ψ))).hom y).down) := by
    apply ContinuousMap.ext
    intro z
    have e1 := hNθ Tξ Tξ τ ψ ψ hτψ y z
    rw [hsub (τ.left z) z] at e1
    exact e1
  have key : (θ.hom.hom.app (Opposite.op (Over.mk ψ))).hom
        (((wcRq h ℓ (n - 1)).obj.map τ.op).hom y) =
      (θ.hom.hom.app (Opposite.op (Over.mk ψ))).hom y :=
    ULift.ext _ _ hfun
  have e2 := congrArg (fun c => (θ.inv.hom.app (Opposite.op (Over.mk ψ))).hom c) key
  exact (hcancel _).symm.trans (e2.trans (hcancel _))

theorem wc_pfam_lfl_inertia_unipotent (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP) :
    ∀ (Vξ Tξ : (wcProjK F'' M').ProEt) (uξ : Tξ ⟶ Vξ) (cξ : Tξ ⟶ Ω.W'),
      wcPfamXiPt Ω uξ cξ → ∀ g ∈ wcPfamInertFr Ω uξ cξ,
        (g - LinearMap.id) ∘ₗ (g - LinearMap.id) = 0 :=
by
  classical

  have alg : ∀ {V : Type (u+1)} [AddCommGroup V] (s : ℚ_[ℓ] → V →+ V)
      (hs1 : ∀ x, s 1 x = x) (hsm : ∀ a b x, s (a * b) x = s a (s b x))
      (hsa : ∀ a b x, s (a + b) x = s a x + s b x)
      (G : V →+ V) (hGs : ∀ a x, G (s a x) = s a (G x))
      (W : AddSubgroup V) (hWs : ∀ a, ∀ w ∈ W, s a w ∈ W) (hGW : ∀ w ∈ W, G w = w)
      (hcod : ∀ x y : V, ∃ a b : ℚ_[ℓ], (a ≠ 0 ∨ b ≠ 0) ∧ s a x + s b y ∈ W)
      (B : V →+ V →+ ℚ_[ℓ]) (hBs : ∀ a x y, B (s a x) y = a * B x y)
      (hBalt : ∀ x y, B x y = -(B y x)) (hBnd : ∀ x, (∀ y, B x y = 0) → x = 0)
      (hBg : ∀ x y, B (G x) (G y) = B x y),
      ∀ x, G (G x - x) - (G x - x) = 0 := by
    intro V _ s hs1 hsm hsa G hGs W hWs hGW hcod B hBs hBalt hBnd hBg
    have hs0 : ∀ x, s 0 x = 0 := by
      intro x
      have e := hsa 0 0 x
      rw [add_zero] at e
      exact add_left_cancel (by rw [add_zero]; exact e.symm : s 0 x + s 0 x = s 0 x + 0)
    have hinv : ∀ a : ℚ_[ℓ], a ≠ 0 → ∀ x, s a⁻¹ (s a x) = x := by
      intro a ha x
      rw [← hsm, inv_mul_cancel₀ ha, hs1]
    have hds : ∀ a x, G (s a x) - s a x = s a (G x - x) := by
      intro a x
      rw [hGs, map_sub]
    have hdW : ∀ w ∈ W, G w - w = 0 := by
      intro w hw
      rw [hGW w hw, sub_self]
    have hB2 : ∀ a x y, B x (s a y) = a * B x y := by
      intro a x y
      rw [hBalt x (s a y), hBs, hBalt y x]
      ring
    have hiso : ∀ x, B x x = 0 := by
      intro x
      have e := hBalt x x
      have e2 : (2 : ℚ_[ℓ]) * B x x = 0 := by linear_combination e
      rcases mul_eq_zero.mp e2 with e3 | e3
      · exact absurd e3 (two_ne_zero : (2 : ℚ_[ℓ]) ≠ 0)
      · exact e3
    have hA : ∀ x, ∀ w ∈ W, B (G x - x) w = 0 := by
      intro x w hw
      rw [map_sub, AddMonoidHom.sub_apply, ← hBg x w, hGW w hw, sub_self]
    by_cases hall : ∀ y, y ∈ W
    · intro x
      exact hdW _ (hall _)
    push_neg at hall
    obtain ⟨y₀, hy₀⟩ := hall
    have claim1 : ∀ x, ∃ a b : ℚ_[ℓ], a ≠ 0 ∧ s a x + s b y₀ ∈ W := by
      intro x
      obtain ⟨a, b, hab, hw⟩ := hcod x y₀
      refine ⟨a, b, ?_, hw⟩
      intro ha
      subst ha
      rw [hs0, zero_add] at hw
      have hb : b ≠ 0 := hab.resolve_left (fun h0 => h0 rfl)
      apply hy₀
      have e := hWs b⁻¹ _ hw
      rwa [hinv b hb] at e
    have hz : G y₀ - y₀ ∈ W := by
      obtain ⟨a₁, b₁, ha₁, hw₁⟩ := claim1 (G y₀ - y₀)
      by_cases hb₁ : b₁ = 0
      · rw [hb₁, hs0, add_zero] at hw₁
        have e := hWs a₁⁻¹ _ hw₁
        rwa [hinv a₁ ha₁] at e
      · have hzy : B (G y₀ - y₀) y₀ = 0 := by
          have e := hA y₀ _ hw₁
          rw [map_add, hB2, hB2, hiso, mul_zero, zero_add] at e
          exact (mul_eq_zero.mp e).resolve_left hb₁
        have hzv : ∀ v, B (G y₀ - y₀) v = 0 := by
          intro v
          obtain ⟨a, b, ha, hw⟩ := claim1 v
          have e := hA y₀ _ hw
          rw [map_add, hB2, hB2, hzy, mul_zero, add_zero] at e
          exact (mul_eq_zero.mp e).resolve_left ha
        rw [hBnd _ hzv]
        exact W.zero_mem
    intro x
    obtain ⟨a, b, ha, hw⟩ := claim1 x
    have e1 : s a (G x - x) + s b (G y₀ - y₀) = 0 := by
      have h0 := hdW _ hw
      rw [map_add] at h0
      rw [← hds, ← hds, ← h0]
      abel
    have e2 : s a (G (G x - x) - (G x - x)) = 0 := by
      have h2 := hds b (G y₀ - y₀)
      rw [hdW _ hz, map_zero] at h2
      have h3 := congrArg (fun t => G t - t) e1
      simp only [map_add, map_zero, sub_zero] at h3
      rw [← hds]
      calc G (s a (G x - x)) - s a (G x - x)
          = (G (s a (G x - x)) + G (s b (G y₀ - y₀)) - (s a (G x - x) + s b (G y₀ - y₀))) -
            (G (s b (G y₀ - y₀)) - s b (G y₀ - y₀)) := by abel
        _ = 0 := by rw [h3, h2, sub_zero]
    have e3 := hinv a ha (G (G x - x) - (G x - x))
    rw [e2, map_zero] at e3
    exact e3.symm
  intro Vξ Tξ uξ cξ hξ g hg
  obtain ⟨v, A', _, _, _, e', L, _, _, eL, hc, hΔξ, hclξ⟩ := hξ
  obtain ⟨τ, σ, hτu, hσ, hτc, hfr⟩ := hg
  obtain ⟨L1, L2, L3, L4⟩ := wc_pfam_xwt_scalar_laws h ℓ (n - 1)

  have hsq : ∀ x, ((wcRq h ℓ (n - 1)).obj.map τ.op).hom
      (((wcRq h ℓ (n - 1)).obj.map τ.op).hom x - x) -
      (((wcRq h ℓ (n - 1)).obj.map τ.op).hom x - x) = 0 := by
    by_cases hm : D.m = 0
    · have hid := wc_pfam_lfl_iu_codim2_trivial F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ lam p hH hPP
        hm Vξ Tξ uξ v A' e' L eL hΔξ hclξ τ hτu
      intro x
      rw [hid x, sub_self, map_zero, sub_self]
    · have j : Fin D.m := ⟨0, Nat.pos_of_ne_zero hm⟩
      obtain ⟨Vy, vy, A, _, _, _, e, ι, hVy, hιv⟩ :=
        wc_pfam_lfl_iu_yj_point F' F'' Y n D M' Xu h Δ lam p hH hPP j Vξ v A' e' hΔξ hclξ
      have hΔξ' : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
          ((ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))) ∈ Δ := by
        rw [hιv]; exact hΔξ
      have hclξ' : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
          (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
          y ∈ closure {(ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))} := by
        rw [hιv]; exact hclξ
      have hcod := wc_pfam_xwt_specialization F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ lam p hH hPP j
        Vy Tξ (uξ ≫ ι) vy A e hVy L eL Vξ ι uξ A' e' rfl hΔξ' hclξ'
      obtain ⟨B, hBs, hBalt, hBnd, hBg⟩ := wc_pfam_xwt_cup_form F' F'' Y n hn hn2 D ℓ hℓ M' Xu h
        Δ lam p hH hPP j Vy Tξ (uξ ≫ ι) vy A e hVy L eL Vξ ι uξ A' e' rfl hΔξ' hclξ'
      refine alg (fun c => ((wcRqScalar h ℓ (n - 1) c).hom.app (Opposite.op Tξ)).hom)
        (L1 Tξ) (L2 Tξ) (L3 Tξ) ((wcRq h ℓ (n - 1)).obj.map τ.op).hom
        (fun a x => L4 Tξ Tξ τ a x)
        (((wcRq h ℓ (n - 1)).obj.map uξ.op).hom.range) ?_ ?_ ?_ B hBs hBalt hBnd (hBg τ hτu)
      · intro a w hw
        obtain ⟨w', rfl⟩ := AddMonoidHom.mem_range.mp hw
        exact AddMonoidHom.mem_range.mpr ⟨_, L4 Vξ Tξ uξ a w'⟩
      · intro w hw
        obtain ⟨w', rfl⟩ := AddMonoidHom.mem_range.mp hw
        have e0 := congrArg (fun f => ((wcRq h ℓ (n - 1)).obj.map f.op).hom w') hτu
        simp only [op_comp, Functor.map_comp] at e0
        exact e0
      · intro x y
        obtain ⟨c₁, c₂, hc', hmem⟩ := hcod x y
        exact ⟨c₁, c₂, hc', AddMonoidHom.mem_range.mpr hmem⟩

  have hcancel : ∀ (V : Over Ω.W')
      (c : ((wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).over Ω.W').obj.obj
        (Opposite.op V)),
      (Ω.θ'.hom.hom.app (Opposite.op V)).hom ((Ω.θ'.inv.hom.app (Opposite.op V)).hom c) = c := by
    intro V c
    exact congrArg (fun m => (m.hom.app (Opposite.op V)).hom c) Ω.θ'.inv_hom_id
  have hNθ' : ∀ (V V' : (wcProjK F'' M').ProEt) (k : V' ⟶ V) (c : V ⟶ Ω.W') (u : V' ⟶ Ω.W'),
      k ≫ c = u → ∀ (y : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op V)) (z : V'.left),
      (show C(↥V'.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk u))).hom
          (((wcRq h ℓ (n - 1)).obj.map k.op).hom y)).down) z =
      (show C(↥V.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk c))).hom y).down) (k.left z) := by
    rintro V V' k c u rfl y z
    have e := congrArg (fun m => m.hom y)
      (Ω.θ'.hom.hom.naturality (Over.homMk k rfl : Over.mk (k ≫ c) ⟶ Over.mk c).op)
    exact congrArg (fun w : ULift.{u+1} C(↥V'.left, Fin Ω.r' → ℚ_[ℓ]) => w.down z) e
  have hconst' : ∀ w : Fin Ω.r' → ℚ_[ℓ], ∃ s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ω.W'),
      ∀ z : Ω.W'.left, (show C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) from
        ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom s).down) z = w := by
    intro w
    let c : (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω.W') :=
      (show (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω.W') from
        ULift.up (ContinuousMap.const ↥Ω.W'.left w))
    refine ⟨(Ω.θ'.inv.hom.app (Opposite.op (Over.mk (𝟙 Ω.W')))).hom c, fun z => ?_⟩
    have hs := hcancel (Over.mk (𝟙 Ω.W')) c
    exact congrArg (fun y : ULift.{u+1} C(↥Ω.W'.left, Fin Ω.r' → ℚ_[ℓ]) => y.down z) hs
  obtain ⟨Am, hAm⟩ := wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ (n - 1)) Ω.W'
    Ω.hconn' Ω.r' Ω.θ' σ
  obtain ⟨z₀⟩ := Ω.hconn'.toNonempty
  have hAg : ∀ w, Am w = g w := by
    intro w
    obtain ⟨s, hs⟩ := hconst' w
    have e1 := hAm Ω.W' (𝟙 Ω.W') σ (Category.id_comp σ).symm s z₀
    have e2 := hfr s z₀
    exact (congrArg Am (hs z₀)).symm.trans (e1.symm.trans (e2.trans (congrArg g (hs z₀))))
  have hsub : ∀ x y : Tξ.left, x = y := by
    intro x y
    have h1 : eL.hom x = eL.hom y :=
      @Subsingleton.elim (PrimeSpectrum L) inferInstance (eL.hom x) (eL.hom y)
    have hx : eL.inv (eL.hom x) = x := by simp
    have hy : eL.inv (eL.hom y) = y := by simp
    rw [← hx, ← hy, h1]
  have t₀ : Tξ.left := eL.inv (IsLocalRing.closedPoint L)
  let Mf : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Tξ) → (Fin Ω.r' → ℚ_[ℓ]) := fun y =>
    (show C(↥Tξ.left, Fin Ω.r' → ℚ_[ℓ]) from
      ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk cξ))).hom y).down) t₀
  have hMadd : ∀ y y', Mf (y + y') = Mf y + Mf y' := by
    intro y y'
    have e := congrArg (fun w : ULift.{u+1} C(↥Tξ.left, Fin Ω.r' → ℚ_[ℓ]) => w.down t₀)
      ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk cξ))).hom.map_add y y')
    exact e.trans rfl
  let M : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Tξ) →+ (Fin Ω.r' → ℚ_[ℓ]) :=
    AddMonoidHom.mk' Mf hMadd
  have hMsub : ∀ a b, Mf (a - b) = Mf a - Mf b := fun a b => map_sub M a b
  have hMs : ∀ w : Fin Ω.r' → ℚ_[ℓ], ∃ y, Mf y = w := by
    intro w
    let c : (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Tξ) :=
      (show (wcContSheaf (wcProjK F'' M') (Fin Ω.r' → ℚ_[ℓ])).obj.obj (Opposite.op Tξ) from
        ULift.up (ContinuousMap.const ↥Tξ.left w))
    refine ⟨(Ω.θ'.inv.hom.app (Opposite.op (Over.mk cξ))).hom c, ?_⟩
    have hs := hcancel (Over.mk cξ) c
    exact congrArg (fun y : ULift.{u+1} C(↥Tξ.left, Fin Ω.r' → ℚ_[ℓ]) => y.down t₀) hs
  have hMg : ∀ y, g (Mf (((wcRq h ℓ (n - 1)).obj.map τ.op).hom y)) = Mf y := by
    intro y
    have e1 := hAm Tξ cξ (τ ≫ cξ) hτc (((wcRq h ℓ (n - 1)).obj.map τ.op).hom y) t₀
    have e2 := hNθ' Tξ Tξ τ cξ (τ ≫ cξ) rfl y t₀
    have e3 : τ.left t₀ = t₀ := hsub _ _
    rw [← hAg]
    exact e1.symm.trans (e2.trans (congrArg (fun t => (show C(↥Tξ.left, Fin Ω.r' → ℚ_[ℓ]) from
      ((Ω.θ'.hom.hom.app (Opposite.op (Over.mk cξ))).hom y).down) t) e3))

  apply LinearMap.ext
  intro w
  obtain ⟨y, rfl⟩ := hMs w
  simp only [LinearMap.comp_apply, LinearMap.sub_apply, LinearMap.id_apply, LinearMap.zero_apply]
  have hPz := sub_eq_zero.mp (hsq y)
  have h1 := hMg (((wcRq h ℓ (n - 1)).obj.map τ.op).hom y - y)
  rw [hPz, hMsub, map_sub] at h1
  have h2 := hMg y
  rw [h2] at h1
  have hgb : g (Mf y) = Mf y + Mf y - Mf (((wcRq h ℓ (n - 1)).obj.map τ.op).hom y) := by
    have e : g (Mf y) = Mf y - (Mf (((wcRq h ℓ (n - 1)).obj.map τ.op).hom y) - Mf y) := by
      rw [← h1]; abel
    rw [e]; abel
  rw [map_sub, hgb, map_sub, map_add, h2, hgb]
  abel

theorem wc_hmg_lattice_reduction : ∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r q k : ℕ) (U₂ : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ])) (π : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q → ℚ_[ℓ])), (∀ y, ∃ x ∈ U₂, π x = y) → ∀ (GG : Set ((Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]))), (∀ g ∈ GG, ∀ x ∈ U₂, g x ∈ U₂ ∧ ((∀ j, ‖π x j‖ ≤ 1) → ∀ j, ‖π (g x) j‖ ≤ 1)) → (∀ g ∈ GG, ∃ g' ∈ GG, ∀ x ∈ U₂, g' (g x) = x) → ∃ ρ : ((Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])) → Multiplicative (AddAut (Fin q → ZMod (ℓ ^ k))), ρ LinearMap.id = 1 ∧ (∀ g ∈ GG, ∀ g' ∈ GG, ρ (g' ∘ₗ g) = ρ g' * ρ g) ∧ (∀ g ∈ GG, ρ g = 1 ↔ ∀ x ∈ U₂, (∀ j, ‖π x j‖ ≤ 1) → ∀ j, ‖π (g x) j - π x j‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ))) ∧ (∀ g ∈ GG, (∀ x ∈ U₂, π (g x) = π x) → ρ g = 1) ∧ (∀ g ∈ GG, ∃ ε : ℝ, 0 < ε ∧ ∀ g' ∈ GG, (∀ j : Fin r, ‖g' (Pi.single j 1) - g (Pi.single j 1)‖ < ε) → ρ g' = ρ g) :=
by
  intro ℓ _ r q k U₂ π hπs GG hst hinv
  have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : Nat.Prime ℓ).one_lt
  have hc : (0 : ℝ) < (ℓ : ℝ) ^ (-(k : ℤ)) := zpow_pos (by linarith) _
  have hsingle : ∀ (j j' : Fin q), ‖(Pi.single j (1 : ℚ_[ℓ]) : Fin q → ℚ_[ℓ]) j'‖ ≤ 1 := by
    intro j j'
    rw [Pi.single_apply]
    split_ifs <;> simp

  obtain ⟨σ₀, hσ⟩ : ∃ σ₀ : (Fin q → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]),
      ∀ y, σ₀ y ∈ U₂ ∧ π (σ₀ y) = y := by
    have hsurj : (π ∘ₗ U₂.subtype).range = ⊤ := by
      rw [LinearMap.range_eq_top]
      intro y
      obtain ⟨x, hx, hxy⟩ := hπs y
      exact ⟨⟨x, hx⟩, hxy⟩
    obtain ⟨τ₀, hτ₀⟩ := LinearMap.exists_rightInverse_of_surjective _ hsurj
    refine ⟨U₂.subtype ∘ₗ τ₀, fun y => ⟨(τ₀ y).2, ?_⟩⟩
    exact LinearMap.congr_fun hτ₀ y

  have hkill : ∀ g ∈ GG, ∀ u ∈ U₂, π u = 0 → π (g u) = 0 := by
    intro g hg u hu hπu
    funext j
    by_contra hne
    have ht : 0 < ‖π (g u) j‖ := norm_pos_iff.mpr hne
    obtain ⟨N, hN⟩ := pow_unbounded_of_one_lt (1 / ‖π (g u) j‖) hℓ1
    have hmem : ((ℓ : ℚ_[ℓ]) ^ N)⁻¹ • u ∈ U₂ := U₂.smul_mem _ hu
    have h1 := (hst g hg _ hmem).2 (fun j' => by rw [map_smul, hπu, smul_zero]; simp) j
    rw [map_smul, map_smul, Pi.smul_apply, smul_eq_mul, norm_mul, norm_inv, Padic.norm_p_pow,
      zpow_neg, inv_inv, zpow_natCast] at h1
    rw [div_lt_iff₀ ht] at hN
    linarith
  have hfac : ∀ g ∈ GG, ∀ x ∈ U₂, π (g x) = π (g (σ₀ (π x))) := by
    intro g hg x hx
    have hu : x - σ₀ (π x) ∈ U₂ := U₂.sub_mem hx (hσ _).1
    have h0 := hkill g hg _ hu (by rw [map_sub, (hσ _).2, sub_self])
    rw [map_sub, map_sub, sub_eq_zero] at h0
    exact h0

  have hmext : ∀ {R : Type} [CommRing R] (M N : Matrix (Fin q) (Fin q) R),
      (∀ y, M.mulVec y = N.mulVec y) → M = N := by
    intro R _ M N h
    ext i j
    have := congrFun (h (Pi.single j 1)) i
    rwa [Matrix.mulVec_single_one, Matrix.mulVec_single_one] at this

  obtain ⟨A, hAmv, hAe⟩ : ∃ A : ((Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])) →
      Matrix (Fin q) (Fin q) ℚ_[ℓ], (∀ g y, (A g).mulVec y = π (g (σ₀ y))) ∧
      (∀ g i j, A g i j = π (g (σ₀ (Pi.single j 1))) i) := by
    refine ⟨fun g => LinearMap.toMatrix' (π ∘ₗ g ∘ₗ σ₀), fun g y => ?_, fun g i j => ?_⟩
    · rw [LinearMap.toMatrix'_mulVec]; rfl
    · show LinearMap.toMatrix' (π ∘ₗ g ∘ₗ σ₀) i j = _
      rw [LinearMap.toMatrix'_apply]; rfl
  have hAint : ∀ g ∈ GG, ∀ i j, ‖A g i j‖ ≤ 1 := by
    intro g hg i j
    rw [hAe]
    exact (hst g hg _ (hσ _).1).2 (fun j' => by rw [(hσ _).2]; exact hsingle j j') i
  have hAfacm : ∀ g ∈ GG, ∀ x ∈ U₂, π (g x) = (A g).mulVec (π x) := by
    intro g hg x hx
    rw [hAmv]
    exact hfac g hg x hx
  have hAcomp : ∀ g ∈ GG, ∀ g' ∈ GG, A (g' ∘ₗ g) = A g' * A g := by
    intro g hg g' hg'
    refine hmext _ _ fun y => ?_
    rw [← Matrix.mulVec_mulVec, hAmv, hAmv, hAmv, LinearMap.comp_apply]
    exact hfac g' hg' _ (hst g hg _ (hσ y).1).1
  have hAid : A LinearMap.id = 1 :=
    hmext _ _ fun y => by rw [hAmv, Matrix.one_mulVec, LinearMap.id_apply, (hσ y).2]
  have hAinv : ∀ g ∈ GG, ∃ h ∈ GG, A h * A g = 1 := by
    intro g hg
    obtain ⟨h, hh, hhg⟩ := hinv g hg
    refine ⟨h, hh, ?_⟩
    rw [← hAcomp g hg h hh]
    exact hmext _ _ fun y => by
      rw [hAmv, Matrix.one_mulVec, LinearMap.comp_apply, hhg _ (hσ y).1, (hσ y).2]

  obtain ⟨zp, hzp⟩ : ∃ zp : ℚ_[ℓ] → ℤ_[ℓ], ∀ x, ‖x‖ ≤ 1 → (zp x : ℚ_[ℓ]) = x := by
    classical
    exact ⟨fun x => if h : ‖x‖ ≤ 1 then (⟨x, h⟩ : ℤ_[ℓ]) else 0, fun x h => by
      simp [h]⟩
  obtain ⟨red, hred⟩ : ∃ red : ℚ_[ℓ] → ZMod (ℓ ^ k), ∀ x, red x = PadicInt.toZModPow k (zp x) :=
    ⟨fun x => PadicInt.toZModPow k (zp x), fun _ => rfl⟩
  have hred_eq : ∀ a b : ℚ_[ℓ], ‖a‖ ≤ 1 → ‖b‖ ≤ 1 →
      (red a = red b ↔ ‖a - b‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ))) := by
    intro a b ha hb
    rw [hred, hred, ← RingHom.sub_mem_ker_iff, PadicInt.ker_toZModPow,
      ← PadicInt.norm_le_pow_iff_mem_span_pow, PadicInt.norm_def, PadicInt.coe_sub, hzp a ha,
      hzp b hb]
  have hz1 : zp 1 = 1 := PadicInt.ext (by rw [hzp 1 (by simp)]; simp)
  have hz0 : zp 0 = 0 := PadicInt.ext (by rw [hzp 0 (by simp)]; simp)
  have hN1 : (1 : Matrix (Fin q) (Fin q) ℚ_[ℓ]).map red = 1 :=
    Matrix.map_one red (by rw [hred, hz0, map_zero]) (by rw [hred, hz1, map_one])
  have hNmul : ∀ M N : Matrix (Fin q) (Fin q) ℚ_[ℓ], (∀ i j, ‖M i j‖ ≤ 1) →
      (∀ i j, ‖N i j‖ ≤ 1) → (M * N).map red = M.map red * N.map red := by
    intro M N hM hN
    ext i j
    simp only [Matrix.map_apply, Matrix.mul_apply, hred]
    have e : ∑ t, M i t * N t j = ((∑ t, zp (M i t) * zp (N t j) : ℤ_[ℓ]) : ℚ_[ℓ]) := by
      show _ = PadicInt.Coe.ringHom (∑ t, zp (M i t) * zp (N t j))
      rw [map_sum]
      refine Finset.sum_congr rfl fun t _ => ?_
      rw [map_mul]
      show _ = (zp (M i t) : ℚ_[ℓ]) * (zp (N t j) : ℚ_[ℓ])
      rw [hzp _ (hM i t), hzp _ (hN t j)]
    have hz : zp (∑ t, M i t * N t j) = ∑ t, zp (M i t) * zp (N t j) := by
      apply PadicInt.ext
      rw [hzp _ (by rw [e, ← PadicInt.norm_def]; exact PadicInt.norm_le_one _), e]
    rw [hz, map_sum]
    simp only [map_mul]
  have h1int : ∀ i j, ‖(1 : Matrix (Fin q) (Fin q) ℚ_[ℓ]) i j‖ ≤ 1 := by
    intro i j
    rw [Matrix.one_apply]
    split_ifs <;> simp

  obtain ⟨τ, hτapp⟩ : ∃ τ : Matrix (Fin q) (Fin q) (ZMod (ℓ ^ k)) →
      Multiplicative (AddAut (Fin q → ZMod (ℓ ^ k))),
      ∀ X, (∃ X', X' * X = 1) → ∀ m, Multiplicative.toAdd (τ X) m = X.mulVec m := by
    classical
    have hbij : ∀ X : Matrix (Fin q) (Fin q) (ZMod (ℓ ^ k)), (∃ X', X' * X = 1) →
        Function.Bijective (Matrix.mulVecLin X) := by
      rintro X ⟨X', hX'⟩
      apply Function.Injective.bijective_of_finite
      intro u v huv
      simp only [Matrix.mulVecLin_apply] at huv
      have := congrArg X'.mulVec huv
      rwa [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, hX', Matrix.one_mulVec,
        Matrix.one_mulVec] at this
    refine ⟨fun X => if h : Function.Bijective (Matrix.mulVecLin X) then
      Multiplicative.ofAdd (AddEquiv.ofBijective (Matrix.mulVecLin X) h) else 1, ?_⟩
    intro X hX m
    dsimp only
    rw [dif_pos (hbij X hX)]
    rfl
  have hext : ∀ a b : Multiplicative (AddAut (Fin q → ZMod (ℓ ^ k))),
      (∀ m, Multiplicative.toAdd a m = Multiplicative.toAdd b m) → a = b :=
    fun a b h => Multiplicative.toAdd.injective (AddEquiv.ext h)
  have hτ1 : τ 1 = 1 :=
    hext _ _ fun m => by rw [hτapp 1 ⟨1, mul_one 1⟩, Matrix.one_mulVec]; rfl
  have hτmul : ∀ X Y : Matrix (Fin q) (Fin q) (ZMod (ℓ ^ k)), (∃ X', X' * X = 1) →
      (∃ Y', Y' * Y = 1) → τ (X * Y) = τ X * τ Y := by
    rintro X Y ⟨X', hX'⟩ ⟨Y', hY'⟩
    have hXY : ∃ Z, Z * (X * Y) = 1 :=
      ⟨Y' * X', by rw [mul_assoc, ← mul_assoc X', hX', one_mul, hY']⟩
    refine hext _ _ fun m => ?_
    show _ = Multiplicative.toAdd (τ X) (Multiplicative.toAdd (τ Y) m)
    rw [hτapp _ hXY, hτapp _ ⟨X', hX'⟩, hτapp _ ⟨Y', hY'⟩, Matrix.mulVec_mulVec]
  have hτone : ∀ X : Matrix (Fin q) (Fin q) (ZMod (ℓ ^ k)), (∃ X', X' * X = 1) →
      (τ X = 1 ↔ X = 1) := by
    intro X hX
    constructor
    · intro h
      refine hmext _ _ fun m => ?_
      rw [← hτapp X hX m, h, Matrix.one_mulVec]
      rfl
    · rintro rfl
      exact hτ1

  have hNinv : ∀ g ∈ GG, ∃ X', X' * (A g).map red = 1 := by
    intro g hg
    obtain ⟨h, hh, hhg⟩ := hAinv g hg
    exact ⟨(A h).map red, by rw [← hNmul _ _ (hAint h hh) (hAint g hg), hhg, hN1]⟩

  have hρ3 : ∀ g ∈ GG, τ ((A g).map red) = 1 ↔ ∀ x ∈ U₂, (∀ j, ‖π x j‖ ≤ 1) →
      ∀ j, ‖π (g x) j - π x j‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) := by
    intro g hg
    rw [hτone _ (hNinv g hg)]
    have step1 : (A g).map red = 1 ↔
        ∀ i j, ‖A g i j - (1 : Matrix (Fin q) (Fin q) ℚ_[ℓ]) i j‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) := by
      rw [← hN1]
      constructor
      · intro h i j
        have := congrFun (congrFun h i) j
        simp only [Matrix.map_apply] at this
        exact (hred_eq _ _ (hAint g hg i j) (h1int i j)).mp this
      · intro h
        ext i j
        simp only [Matrix.map_apply]
        exact (hred_eq _ _ (hAint g hg i j) (h1int i j)).mpr (h i j)
    rw [step1]
    constructor
    · intro hE x hx hxint i
      rw [hAfacm g hg x hx]
      have e : (A g).mulVec (π x) i - π x i = (A g - 1).mulVec (π x) i := by
        rw [Matrix.sub_mulVec, Matrix.one_mulVec]; rfl
      rw [e]
      simp only [Matrix.mulVec, dotProduct]
      apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg hc.le
      intro j _
      rw [norm_mul, Matrix.sub_apply]
      calc ‖A g i j - (1 : Matrix (Fin q) (Fin q) ℚ_[ℓ]) i j‖ * ‖π x j‖
          ≤ (ℓ : ℝ) ^ (-(k : ℤ)) * 1 :=
            mul_le_mul (hE i j) (hxint j) (norm_nonneg _) hc.le
        _ = (ℓ : ℝ) ^ (-(k : ℤ)) := mul_one _
    · intro hC i j
      have := hC (σ₀ (Pi.single j 1)) (hσ _).1
        (fun j' => by rw [(hσ _).2]; exact hsingle j j') i
      have e1 : (Pi.single j (1 : ℚ_[ℓ]) : Fin q → ℚ_[ℓ]) i =
          (1 : Matrix (Fin q) (Fin q) ℚ_[ℓ]) i j := by
        rw [Pi.single_apply, Matrix.one_apply]
      rw [(hσ _).2, ← hAe, e1] at this
      exact this
  have hρ5 : ∃ ε : ℝ, 0 < ε ∧ ∀ g ∈ GG, ∀ g' ∈ GG,
      (∀ j : Fin r, ‖g' (Pi.single j 1) - g (Pi.single j 1)‖ < ε) →
      ∀ i j, ‖A g' i j - A g i j‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) := by
    obtain ⟨Cπ, hCπ, hπb⟩ : ∃ C : ℝ, 0 ≤ C ∧ ∀ w, ‖π w‖ ≤ C * ‖w‖ :=
      ⟨‖LinearMap.toContinuousLinearMap π‖, norm_nonneg _,
        fun w => by simpa using (LinearMap.toContinuousLinearMap π).le_opNorm w⟩
    obtain ⟨S, hS, hvS⟩ : ∃ S : ℝ, 0 ≤ S ∧ ∀ j, ∑ t, ‖σ₀ (Pi.single j 1) t‖ ≤ S :=
      ⟨∑ j : Fin q, ∑ t : Fin r, ‖σ₀ (Pi.single j 1) t‖,
        Finset.sum_nonneg fun j _ => Finset.sum_nonneg fun t _ => norm_nonneg _,
        fun j => Finset.single_le_sum (f := fun j => ∑ t : Fin r, ‖σ₀ (Pi.single j 1) t‖)
          (fun j _ => Finset.sum_nonneg fun t _ => norm_nonneg _) (Finset.mem_univ j)⟩
    have hden : 0 < Cπ * S + 1 := add_pos_of_nonneg_of_pos (mul_nonneg hCπ hS) one_pos
    have hε : 0 < (ℓ : ℝ) ^ (-(k : ℤ)) / (Cπ * S + 1) := div_pos hc hden
    refine ⟨_, hε, ?_⟩
    intro g hg g' hg' hD i j
    have hdiff : A g' i j - A g i j = π ((g' - g) (σ₀ (Pi.single j 1))) i := by
      rw [hAe, hAe, LinearMap.sub_apply, map_sub]; rfl
    have hDv : (g' - g) (σ₀ (Pi.single j 1)) =
        ∑ t, σ₀ (Pi.single j 1) t • (g' (Pi.single t 1) - g (Pi.single t 1)) := by
      conv_lhs => rw [pi_eq_sum_univ' (σ₀ (Pi.single j 1))]
      rw [map_sum]
      simp only [map_smul, LinearMap.sub_apply]
    have hnDv : ‖(g' - g) (σ₀ (Pi.single j 1))‖ ≤
        (∑ t, ‖σ₀ (Pi.single j 1) t‖) * ((ℓ : ℝ) ^ (-(k : ℤ)) / (Cπ * S + 1)) := by
      rw [hDv, Finset.sum_mul]
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun t _ => ?_)
      rw [norm_smul]
      exact mul_le_mul_of_nonneg_left (hD t).le (norm_nonneg _)
    rw [hdiff]
    calc ‖π ((g' - g) (σ₀ (Pi.single j 1))) i‖ ≤ ‖π ((g' - g) (σ₀ (Pi.single j 1)))‖ :=
          norm_le_pi_norm _ i
      _ ≤ Cπ * ‖(g' - g) (σ₀ (Pi.single j 1))‖ := hπb _
      _ ≤ Cπ * (S * ((ℓ : ℝ) ^ (-(k : ℤ)) / (Cπ * S + 1))) :=
          mul_le_mul_of_nonneg_left (hnDv.trans (mul_le_mul_of_nonneg_right (hvS j) hε.le)) hCπ
      _ = (ℓ : ℝ) ^ (-(k : ℤ)) * (Cπ * S / (Cπ * S + 1)) := by ring
      _ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) :=
          mul_le_of_le_one_right hc.le ((div_le_one hden).mpr (by linarith))
  refine ⟨fun g => τ ((A g).map red), ?_, ?_, hρ3, ?_, ?_⟩
  · show τ ((A LinearMap.id).map red) = 1
    rw [hAid, hN1]
    exact hτ1
  · intro g hg g' hg'
    show τ ((A (g' ∘ₗ g)).map red) = τ ((A g').map red) * τ ((A g).map red)
    rw [hAcomp g hg g' hg', hNmul _ _ (hAint g' hg') (hAint g hg)]
    exact hτmul _ _ (hNinv g' hg') (hNinv g hg)
  · intro g hg hfix
    exact (hρ3 g hg).mpr fun x hx _ j => by rw [hfix x hx, sub_self, norm_zero]; exact hc.le
  · intro g hg
    obtain ⟨ε, hε, hb⟩ := hρ5
    refine ⟨ε, hε, fun g' hg' hD => ?_⟩
    show τ ((A g').map red) = τ ((A g).map red)
    congr 1
    ext i j
    simp only [Matrix.map_apply]
    exact (hred_eq _ _ (hAint g' hg' i j) (hAint g hg i j)).mpr (hb g hg g' hg' hD i j)

theorem wc_pfam_qc_integral_coords {F'' : Type u} [Field F''] {M' : ℕ} {X : Scheme.{u}}
    {h : X ⟶ wcProjK F'' M'} {Δ : Set (wcProjK F'' M')} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {q : ℕ}
    {hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (Ω₀ : wcPfamCover M' h Δ ℓ q hPP) (hcpt₀ : CompactSpace Ω₀.W'.left)
    (hqc₀ : QuasiCompact Ω₀.w'.left) :
    ∃ (q' : ℕ) (π₀ : (Fin Ω₀.r' → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ])),
      ∀ (σ₀ : Ω₀.W' ⟶ Ω₀.W') (g₀ : (Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ])),
        σ₀ ≫ Ω₀.w' = Ω₀.w' → wcPfamFrame Ω₀ σ₀ g₀ →
        ∃ g' : (Fin q' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ]),
          g' ∘ₗ (π₀.toLinearMap ∘ₗ g₀ ∘ₗ π₀.symm.toLinearMap) = LinearMap.id ∧
          (π₀.toLinearMap ∘ₗ g₀ ∘ₗ π₀.symm.toLinearMap) ∘ₗ g' = LinearMap.id ∧
          ∀ y : Fin q' → ℚ_[ℓ], (∀ i, ‖y i‖ ≤ 1) →
            (∀ i, ‖(π₀.toLinearMap ∘ₗ g₀ ∘ₗ π₀.symm.toLinearMap) y i‖ ≤ 1) ∧ ∀ i, ‖g' y i‖ ≤ 1 :=
by
  classical
  haveI := Ω₀.hconn'
  obtain ⟨z₀⟩ := @ConnectedSpace.toNonempty _ _ Ω₀.hconn'

  have hconst : ∀ v : Fin Ω₀.r' → ℚ_[ℓ], ∃ s : (wcRq h ℓ q).obj.obj (Opposite.op Ω₀.W'),
      (show C(↥Ω₀.W'.left, Fin Ω₀.r' → ℚ_[ℓ]) from
        ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 Ω₀.W')))).hom s).down) z₀ = v := by
    intro v
    let c : (wcContSheaf (wcProjK F'' M') (Fin Ω₀.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω₀.W') :=
      (show (wcContSheaf (wcProjK F'' M') (Fin Ω₀.r' → ℚ_[ℓ])).obj.obj (Opposite.op Ω₀.W') from
        ULift.up (ContinuousMap.const ↥Ω₀.W'.left v))
    refine ⟨(Ω₀.θ'.inv.hom.app (Opposite.op (Over.mk (𝟙 Ω₀.W')))).hom c, ?_⟩
    have hs := congrArg (fun m => (m.hom.app (Opposite.op (Over.mk (𝟙 Ω₀.W')))).hom c)
      Ω₀.θ'.inv_hom_id
    exact congrArg (fun y : ULift.{u+1} C(↥Ω₀.W'.left, Fin Ω₀.r' → ℚ_[ℓ]) => y.down z₀) hs

  have hext : ∀ (σ : Ω₀.W' ⟶ Ω₀.W')
      (g : (Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ])), wcPfamFrame Ω₀ σ g →
      ∀ (V : (wcProjK F'' M').ProEt) (a : V ⟶ Ω₀.W')
        (x : (wcRq h ℓ q).obj.obj (Opposite.op V)) (t : V.left),
        (show C(↥V.left, Fin Ω₀.r' → ℚ_[ℓ]) from
          ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk (a ≫ σ)))).hom x).down) t =
        g ((show C(↥V.left, Fin Ω₀.r' → ℚ_[ℓ]) from
          ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) t) := by
    intro σ g hfr V a x t
    obtain ⟨B, hB⟩ := wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ q) Ω₀.W'
      Ω₀.hconn' Ω₀.r' Ω₀.θ' σ
    have hBg : B = g := by
      apply LinearMap.ext
      intro v
      obtain ⟨s, hc⟩ := hconst v
      have e1 := hB Ω₀.W' (𝟙 Ω₀.W') σ (Category.id_comp σ).symm s z₀
      have e2 := hfr s z₀
      exact (congrArg B hc.symm).trans (e1.symm.trans (e2.trans (congrArg g hc)))
    rw [← hBg]
    exact hB V a (a ≫ σ) rfl x t

  set GG : Set ((Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ])) :=
    {g | ∃ σ₀ : Ω₀.W' ⟶ Ω₀.W', σ₀ ≫ Ω₀.w' = Ω₀.w' ∧ wcPfamFrame Ω₀ σ₀ g} with hGG
  have hid : LinearMap.id ∈ GG := ⟨𝟙 Ω₀.W', Category.id_comp _, fun s z => rfl⟩
  have hmul : ∀ g ∈ GG, ∀ g' ∈ GG, g' ∘ₗ g ∈ GG := by
    rintro g ⟨σ₁, hσ₁, hf₁⟩ g' ⟨σ₂, hσ₂, hf₂⟩
    refine ⟨σ₁ ≫ σ₂, by rw [Category.assoc, hσ₂, hσ₁], fun s z => ?_⟩
    exact (hext σ₂ g' hf₂ Ω₀.W' σ₁ s z).trans (congrArg g' (hf₁ s z))
  have hst : ∀ g ∈ GG, ∀ x ∈ (⊤ : Submodule ℚ_[ℓ] (Fin Ω₀.r' → ℚ_[ℓ])),
      g x ∈ (⊤ : Submodule ℚ_[ℓ] (Fin Ω₀.r' → ℚ_[ℓ])) ∧
      (x ∈ (⊥ : Submodule ℚ_[ℓ] (Fin Ω₀.r' → ℚ_[ℓ])) →
        g x ∈ (⊥ : Submodule ℚ_[ℓ] (Fin Ω₀.r' → ℚ_[ℓ]))) := by
    intro g _ x _
    refine ⟨Submodule.mem_top, fun hx => ?_⟩
    rw [Submodule.mem_bot] at hx ⊢
    rw [hx, map_zero]

  obtain ⟨C, hC⟩ := wc_proet_frames_bounded (wcProjK F'' M') ℓ (wcRq h ℓ q)
    (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP) Ω₀.W' Ω₀.w' hcpt₀
    (@ConnectedSpace.toNonempty _ _ Ω₀.hconn') hqc₀ Ω₀.r' Ω₀.θ'
  obtain ⟨q', π₁, hπinj, hπsurj, hπst⟩ := wc_padic_stable_lattice_coords ℓ Ω₀.r' ⊥ ⊤ bot_le GG
    hid hmul hst C (by rintro g ⟨σ₀, hσ₀, hf⟩ j; exact hC σ₀ g hσ₀ hf j)
  have hπbij : Function.Bijective π₁ := by
    refine ⟨(injective_iff_map_eq_zero π₁).2 (fun x hx => ?_), fun y => ?_⟩
    · exact (Submodule.mem_bot ℚ_[ℓ]).1 ((hπinj x Submodule.mem_top).1 hx)
    · obtain ⟨x, -, hx⟩ := hπsurj y
      exact ⟨x, hx⟩
  refine ⟨q', LinearEquiv.ofBijective π₁ hπbij, ?_⟩
  set π₀ := LinearEquiv.ofBijective π₁ hπbij with hπ₀
  have hπapp : ∀ x, π₀ x = π₁ x := fun x => rfl

  have hinv : ∀ (σ : Ω₀.W' ⟶ Ω₀.W') (g : (Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ])),
      σ ≫ Ω₀.w' = Ω₀.w' → wcPfamFrame Ω₀ σ g →
      ∃ (ρ : Ω₀.W' ⟶ Ω₀.W') (gρ : (Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ])),
        ρ ≫ Ω₀.w' = Ω₀.w' ∧ wcPfamFrame Ω₀ ρ gρ ∧ gρ ∘ₗ g = LinearMap.id := by
    intro σ g hσ hfr
    obtain ⟨ρ, hρ, h1⟩ := Ω₀.hgal' Ω₀.W' σ (𝟙 Ω₀.W') Ω₀.hconn' (by rw [hσ, Category.id_comp])
    obtain ⟨gρ, hgρ⟩ := wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ q) Ω₀.W'
      Ω₀.hconn' Ω₀.r' Ω₀.θ' ρ
    have hfrρ : wcPfamFrame Ω₀ ρ gρ := fun s z =>
      hgρ Ω₀.W' (𝟙 Ω₀.W') ρ (Category.id_comp ρ).symm s z
    refine ⟨ρ, gρ, hρ, hfrρ, ?_⟩
    apply LinearMap.ext
    intro v
    obtain ⟨s, hc⟩ := hconst v
    have e := hext ρ gρ hfrρ Ω₀.W' σ s z₀
    rw [← h1] at e
    rw [hfr s z₀, hc] at e
    exact e.symm
  intro σ₀ g₀ hσ₀ hfr₀
  obtain ⟨ρ, gρ, hρ, hfrρ, hc1⟩ := hinv σ₀ g₀ hσ₀ hfr₀
  obtain ⟨ρ', gρ', -, -, hc1'⟩ := hinv ρ gρ hρ hfrρ
  have hmem₀ : g₀ ∈ GG := ⟨σ₀, hσ₀, hfr₀⟩
  have hmemρ : gρ ∈ GG := ⟨ρ, hρ, hfrρ⟩
  have hg₀ : g₀ = gρ' := by
    calc g₀ = (gρ' ∘ₗ gρ) ∘ₗ g₀ := by rw [hc1', LinearMap.id_comp]
      _ = gρ' ∘ₗ (gρ ∘ₗ g₀) := LinearMap.comp_assoc _ _ _
      _ = gρ' := by rw [hc1, LinearMap.comp_id]
  have hc2 : g₀ ∘ₗ gρ = LinearMap.id := by rw [hg₀]; exact hc1'
  refine ⟨π₀.toLinearMap ∘ₗ gρ ∘ₗ π₀.symm.toLinearMap, ?_, ?_, ?_⟩
  · apply LinearMap.ext
    intro y
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply,
      LinearMap.id_apply]
    rw [show gρ (g₀ (π₀.symm y)) = π₀.symm y from LinearMap.congr_fun hc1 _]
    exact π₀.apply_symm_apply y
  · apply LinearMap.ext
    intro y
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply,
      LinearMap.id_apply]
    rw [show g₀ (gρ (π₀.symm y)) = π₀.symm y from LinearMap.congr_fun hc2 _]
    exact π₀.apply_symm_apply y
  · intro y hy
    have hx : ∀ j, ‖π₁ (π₀.symm y) j‖ ≤ 1 := by
      intro j
      rw [← hπapp, π₀.apply_symm_apply]
      exact hy j
    refine ⟨fun i => ?_, fun i => ?_⟩
    · exact hπst g₀ hmem₀ (π₀.symm y) Submodule.mem_top hx i
    · exact hπst gρ hmemρ (π₀.symm y) Submodule.mem_top hx i

theorem wc_pfam_qc_level_cover {F'' : Type u} [Field F''] [Finite F''] {M' : ℕ} {X : Scheme.{u}}
    {h : X ⟶ wcProjK F'' M'} {Δ : Set (wcProjK F'' M')} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {q : ℕ}
    {hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))}
    (Ω₀ : wcPfamCover M' h Δ ℓ q hPP) (hqc₀ : QuasiCompact Ω₀.w'.left)
    (Ub : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left.Opens)
    (hUb : ∀ y, y ∈ Ub ↔ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∉ Δ)
    (hUc : CompactSpace Ub.toScheme) (hUq : QuasiSeparatedSpace Ub.toScheme)
    (k q' : ℕ) (π₀ : (Fin Ω₀.r' → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ]))
    (GLs : Set ((Fin q' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ])))
    (hGLs : ∀ g, g ∈ GLs ↔ ∃ g' : (Fin q' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ]),
      g' ∘ₗ g = LinearMap.id ∧ g ∘ₗ g' = LinearMap.id ∧
      ∀ y : Fin q' → ℚ_[ℓ], (∀ i, ‖y i‖ ≤ 1) → (∀ i, ‖g y i‖ ≤ 1) ∧ ∀ i, ‖g' y i‖ ≤ 1)
    (hfr : ∀ (σ₀ : Ω₀.W' ⟶ Ω₀.W') (g₀ : (Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ])),
      σ₀ ≫ Ω₀.w' = Ω₀.w' → wcPfamFrame Ω₀ σ₀ g₀ →
      π₀.toLinearMap ∘ₗ g₀ ∘ₗ π₀.symm.toLinearMap ∈ GLs)
    (ρ : ((Fin q' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin q' → ℚ_[ℓ])) →
      Multiplicative (AddAut (Fin q' → ZMod (ℓ ^ k))))
    (hρ1 : ρ LinearMap.id = 1) (hρm : ∀ g ∈ GLs, ∀ g' ∈ GLs, ρ (g' ∘ₗ g) = ρ g' * ρ g)
    (hρc : ∀ g ∈ GLs, ∃ ε : ℝ, 0 < ε ∧ ∀ g' ∈ GLs,
      (∀ j : Fin q', ‖g' (Pi.single j 1) - g (Pi.single j 1)‖ < ε) → ρ g' = ρ g) :
    ∃ (E₀ : Scheme.{u}) (πE₀ : E₀ ⟶ Ub.toScheme)
      (s₀ : Multiplicative (AddAut (Fin q' → ZMod (ℓ ^ k))) → (Ω₀.W'.left ⟶ E₀))
      (G₀ : ↥(Limits.pullback Ω₀.w'.left Ω₀.w'.left) →
        ((Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ]))),
      IsFinite πE₀ ∧ Etale πE₀ ∧
      (∀ γ, s₀ γ ≫ πE₀ ≫ Ub.ι = Ω₀.w'.left) ∧
      (∀ (Z' : Scheme.{u}), ConnectedSpace Z' → ∀ (a : Z' ⟶ Ω₀.W'.left) (e' : Z' ⟶ E₀),
        a ≫ Ω₀.w'.left = e' ≫ πE₀ ≫ Ub.ι → ∃ γ, e' = a ≫ s₀ γ) ∧
      (∀ z, π₀.toLinearMap ∘ₗ G₀ z ∘ₗ π₀.symm.toLinearMap ∈ GLs) ∧
      (∀ (V : (wcProjK F'' M').ProEt) (a b : V ⟶ Ω₀.W')
        (hl : a.left ≫ Ω₀.w'.left = b.left ≫ Ω₀.w'.left)
        (x : (wcRq h ℓ q).obj.obj (Opposite.op V)) (t : V.left),
        (show C(↥V.left, Fin Ω₀.r' → ℚ_[ℓ]) from
          ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) t =
        G₀ (Limits.pullback.lift a.left b.left hl t)
          ((show C(↥V.left, Fin Ω₀.r' → ℚ_[ℓ]) from
            ((Ω₀.θ'.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) t)) ∧
      (∀ (T : Scheme.{u}) (a b : T ⟶ Ω₀.W'.left) (hab : a ≫ Ω₀.w'.left = b ≫ Ω₀.w'.left)
        (γ γ' : Multiplicative (AddAut (Fin q' → ZMod (ℓ ^ k)))),
        a ≫ s₀ γ = b ≫ s₀ γ' ↔ ∀ t : T, γ' = γ * (ρ (π₀.toLinearMap ∘ₗ
          G₀ (Limits.pullback.lift a b hab t) ∘ₗ π₀.symm.toLinearMap))⁻¹) ∧
      (∀ (T : Scheme.{u}) (a : T ⟶ Ω₀.W'.left) (t : T),
        G₀ (Limits.pullback.lift a a rfl t) = LinearMap.id) ∧
      (∀ (σ₀ : Ω₀.W' ⟶ Ω₀.W') (g₀ : (Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ])),
        σ₀ ≫ Ω₀.w' = Ω₀.w' → wcPfamFrame Ω₀ σ₀ g₀ → ∀ γ,
        σ₀.left ≫ s₀ γ = s₀ (γ * ρ (π₀.toLinearMap ∘ₗ g₀ ∘ₗ π₀.symm.toLinearMap))) :=
by
  classical

  have hTF : ∀ (W : (wcProjK F'' M').ProEt)
      (w : W ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP) (r : ℕ)
      (θ : (wcRq h ℓ q).over W ≅ (wcContSheaf (wcProjK F'' M') (Fin r → ℚ_[ℓ])).over W),
      ConnectedSpace W.left →
      (∀ (V : (wcProjK F'' M').ProEt) (a b : V ⟶ W), ConnectedSpace V.left → a ≫ w = b ≫ w →
        ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ) →
      ∃ G : ↥(Limits.pullback w.left w.left) → ((Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
        (∀ z, ∃ γ : W ⟶ W, γ ≫ w = w ∧
          ∀ (s : (wcRq h ℓ q).obj.obj (Opposite.op W)) (x : W.left),
            (show C(↥W.left, Fin r → ℚ_[ℓ]) from
              ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) x =
            G z ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
              ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) x)) ∧
        (∀ (V : (wcProjK F'' M').ProEt) (a b : V ⟶ W) (hl : a.left ≫ w.left = b.left ≫ w.left)
          (t : (wcRq h ℓ q).obj.obj (Opposite.op V)) (z : V.left),
          (show C(↥V.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom t).down) z =
          G (Limits.pullback.lift a.left b.left hl z)
            ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
              ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom t).down) z)) ∧
        (∀ j : Fin r, Continuous (fun z => G z (Pi.single j 1))) ∧
        (∀ (Z : Scheme.{u}) (a b d : Z ⟶ W.left) (hab : a ≫ w.left = b ≫ w.left)
          (hbd : b ≫ w.left = d ≫ w.left) (had : a ≫ w.left = d ≫ w.left) (z : Z),
          G (Limits.pullback.lift a d had z) =
            G (Limits.pullback.lift b d hbd z) ∘ₗ G (Limits.pullback.lift a b hab z)) ∧
        (∀ (δ : W ⟶ W) (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]))
          (hδ : δ.left ≫ w.left = 𝟙 W.left ≫ w.left), δ ≫ w = w →
          (∀ (s : (wcRq h ℓ q).obj.obj (Opposite.op W)) (x : W.left),
            (show C(↥W.left, Fin r → ℚ_[ℓ]) from
              ((θ.hom.hom.app (Opposite.op (Over.mk δ))).hom s).down) x =
            g ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
              ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) x)) →
          ∀ z, G (Limits.pullback.lift δ.left (𝟙 W.left) hδ z) ∘ₗ g = LinearMap.id) := by
    intro W w r θ hW hgal

    haveI hBp : WeaklyEtale (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom :=
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).prop
    haveI hWp : WeaklyEtale W.hom := W.prop
    haveI hwB : WeaklyEtale (w.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) := by
      rw [MorphismProperty.Over.w w]; exact hWp
    haveI hwl : WeaklyEtale w.left :=
      WeaklyEtale.of_comp w.left (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom

    have TR : ∀ (V V' : (wcProjK F'' M').ProEt) (h' : V' ⟶ W) (j : V ⟶ V')
        (y : (wcRq h ℓ q).obj.obj (Opposite.op V')) (z : V.left),
        (show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (j ≫ h')))).hom
            (((wcRq h ℓ q).obj.map j.op).hom y)).down) z =
        (show C(↥V'.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y).down) (j.left z) := by
      intro V V' h' j y z
      have hn := θ.hom.hom.naturality
        (Over.homMk j (by rfl) : (Over.mk (j ≫ h') : Over W) ⟶ Over.mk h').op
      have h1 := congrArg (fun m => m.hom y) hn
      have h2 : (θ.hom.hom.app (Opposite.op (Over.mk (j ≫ h')))).hom
            (((wcRq h ℓ q).obj.map j.op).hom y) =
          ((wcContSheaf (wcProjK F'' M') (Fin r → ℚ_[ℓ])).obj.map j.op).hom
            ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y) := h1
      rw [h2]
      rfl

    have hcancel2 : ∀ (T : Over W)
        (c : ((wcContSheaf (wcProjK F'' M') (Fin r → ℚ_[ℓ])).over W).obj.obj
          (Opposite.op T)),
        (θ.hom.hom.app (Opposite.op T)).hom ((θ.inv.hom.app (Opposite.op T)).hom c) = c := by
      intro T c
      exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) θ.inv_hom_id
    have hK : ∀ (V : (wcProjK F'' M').ProEt) (a : V ⟶ W) (v₀ : Fin r → ℚ_[ℓ]),
        ∃ t : (wcRq h ℓ q).obj.obj (Opposite.op V), ∀ x : V.left,
          (show C(↥V.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom t).down) x = v₀ := by
      intro V a v₀
      let c : (wcContSheaf (wcProjK F'' M') (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op V) :=
        (show (wcContSheaf (wcProjK F'' M') (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op V) from
          ULift.up (ContinuousMap.const ↥V.left v₀))
      refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk a))).hom c, fun x => ?_⟩
      have hs := hcancel2 (Over.mk a) c
      exact congrArg (fun y : ULift.{u+1} C(↥V.left, Fin r → ℚ_[ℓ]) => y.down x) hs

    choose A hA using fun γ : W ⟶ W =>
      wc_proet_deck_frame_linear (wcProjK F'' M') ℓ (wcRq h ℓ q) W hW r θ γ

    have hnbhd : ∀ (V₀ : (wcProjK F'' M').ProEt) (z : V₀.left),
        ∃ (V₁ : (wcProjK F'' M').ProEt) (k : V₁ ⟶ V₀) (z₁ : V₁.left),
          ConnectedSpace V₁.left ∧ k.left z₁ = z := by
      intro V₀ z
      have hι : WeaklyEtale (V₀.left.fromSpecStalk z) := by
        refine ⟨?_, inferInstance⟩
        obtain ⟨_, ⟨U, hU, rfl⟩, hx, -⟩ :=
          V₀.left.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ z) isOpen_univ
        replace hU : IsAffineOpen U := hU
        rw [← hU.fromSpecStalk_eq_fromSpecStalk hx]
        show Flat (Spec.map (V₀.left.presheaf.germ U z hx) ≫ hU.fromSpec)
        have : Flat (Spec.map (V₀.left.presheaf.germ U z hx)) := by
          rw [HasRingHomProperty.Spec_iff (P := @Flat)]
          letI : Algebra Γ(V₀.left, U) (V₀.left.presheaf.stalk z) :=
            (V₀.left.presheaf.germ U z hx).hom.toAlgebra
          haveI := hU.isLocalization_stalk ⟨z, hx⟩
          exact RingHom.flat_algebraMap_iff.mpr
            (IsLocalization.flat _ (hU.primeIdealOf ⟨z, hx⟩).asIdeal.primeCompl)
        have hoi : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
        have hfs : Flat hU.fromSpec := Flat.instOfIsOpenImmersion _
        exact MorphismProperty.comp_mem @Flat _ _ this hfs
      have hcomp : WeaklyEtale (V₀.left.fromSpecStalk z ≫ V₀.hom) :=
        @MorphismProperty.comp_mem _ _ @WeaklyEtale
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ hι V₀.prop
      let V₁ : (wcProjK F'' M').ProEt :=
        MorphismProperty.Over.mk ⊤ (V₀.left.fromSpecStalk z ≫ V₀.hom) hcomp
      let k : V₁ ⟶ V₀ := MorphismProperty.Over.homMk (V₀.left.fromSpecStalk z) rfl trivial
      have hconnR : ∀ (R : CommRingCat.{u}) [IsLocalRing R], ConnectedSpace (Spec R) := by
        intro R _
        have hpre : PreconnectedSpace (PrimeSpectrum R) := by
          rw [preconnectedSpace_iff_clopen]
          intro s hs
          obtain ⟨e, he, rfl⟩ := PrimeSpectrum.isClopen_iff.mp hs
          rcases IsLocalRing.isUnit_or_isUnit_one_sub_self e with h | h
          · right
            have he1 : e = 1 := h.mul_left_cancel (by rw [mul_one]; exact he.eq)
            subst he1
            simp
          · left
            have he0 : e = 0 := by
              have h0 : (1 - e) * e = (1 - e) * 0 := by
                rw [sub_mul, one_mul, he.eq, sub_self, mul_zero]
              exact h.mul_left_cancel h0
            subst he0
            simp
        have hc : ConnectedSpace (PrimeSpectrum R) :=
          { toPreconnectedSpace := hpre, toNonempty := ⟨IsLocalRing.closedPoint R⟩ }
        exact hc
      exact ⟨V₁, k, IsLocalRing.closedPoint _, hconnR (V₀.left.presheaf.stalk z),
        Scheme.fromSpecStalk_closedPoint⟩

    haveI : WeaklyEtale (Limits.pullback.fst w.left w.left) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst w.left w.left ≫ W.hom) := inferInstance
    let Zo : (wcProjK F'' M').ProEt :=
      Scheme.ProEt.mk (Limits.pullback.fst w.left w.left ≫ W.hom)
    let P₁ : Zo ⟶ W :=
      MorphismProperty.Over.homMk (Limits.pullback.fst w.left w.left) rfl trivial
    have h₂ : Limits.pullback.snd w.left w.left ≫ W.hom =
        Limits.pullback.fst w.left w.left ≫ W.hom := by
      rw [← MorphismProperty.Over.w w, ← Category.assoc, ← Category.assoc,
        Limits.pullback.condition]
    let P₂ : Zo ⟶ W :=
      MorphismProperty.Over.homMk (Limits.pullback.snd w.left w.left) h₂ trivial
    have hPw : P₁ ≫ w = P₂ ≫ w := by
      apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition (f := w.left) (g := w.left)

    choose V₁ κ z₁ hc hκ using fun z : ↥(Limits.pullback w.left w.left) => hnbhd Zo z
    have hab0 : ∀ z, (κ z ≫ P₁) ≫ w = (κ z ≫ P₂) ≫ w := fun z => by
      rw [Category.assoc, Category.assoc, hPw]
    choose γ hγw hγ using fun z => hgal (V₁ z) (κ z ≫ P₁) (κ z ≫ P₂) (hc z) (hab0 z)

    have hb : ∀ (V : (wcProjK F'' M').ProEt) (a b : V ⟶ W)
        (hl : a.left ≫ w.left = b.left ≫ w.left)
        (t : (wcRq h ℓ q).obj.obj (Opposite.op V)) (z : V.left),
        (show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom t).down) z =
        A (γ (Limits.pullback.lift a.left b.left hl z))
          ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom t).down) z) := by
      intro V a b hl t v
      generalize hz₀ : Limits.pullback.lift a.left b.left hl v = z₀
      have hKw : Limits.pullback.lift a.left b.left hl ≫
          (Limits.pullback.fst w.left w.left ≫ W.hom) = V.hom := by
        rw [Limits.pullback.lift_fst_assoc, MorphismProperty.Over.w a]
      let K : V ⟶ Zo :=
        MorphismProperty.Over.homMk (Limits.pullback.lift a.left b.left hl) hKw trivial
      have hK1 : K ≫ P₁ = a := by
        apply MorphismProperty.Over.Hom.ext
        exact Limits.pullback.lift_fst a.left b.left hl
      have hK2 : K ≫ P₂ = b := by
        apply MorphismProperty.Over.Hom.ext
        exact Limits.pullback.lift_snd a.left b.left hl
      haveI : WeaklyEtale (V₁ z₀).hom := (V₁ z₀).prop
      haveI hVp : WeaklyEtale V.hom := V.prop
      haveI hZp : WeaklyEtale Zo.hom := Zo.prop
      haveI : WeaklyEtale (K.left ≫ Zo.hom) := by
        rw [MorphismProperty.Over.w K]; exact hVp
      haveI : WeaklyEtale K.left := WeaklyEtale.of_comp K.left Zo.hom
      haveI : WeaklyEtale (Limits.pullback.fst (κ z₀).left K.left) := inferInstance
      haveI : WeaklyEtale (Limits.pullback.fst (κ z₀).left K.left ≫ (V₁ z₀).hom) :=
        inferInstance
      let Q : (wcProjK F'' M').ProEt :=
        Scheme.ProEt.mk (Limits.pullback.fst (κ z₀).left K.left ≫ (V₁ z₀).hom)
      let p₁ : Q ⟶ V₁ z₀ :=
        MorphismProperty.Over.homMk (Limits.pullback.fst (κ z₀).left K.left) rfl trivial
      have hq2 : Limits.pullback.snd (κ z₀).left K.left ≫ V.hom =
          Limits.pullback.fst (κ z₀).left K.left ≫ (V₁ z₀).hom := by
        rw [← MorphismProperty.Over.w K, ← MorphismProperty.Over.w (κ z₀), ← Category.assoc,
          ← Category.assoc, Limits.pullback.condition]
      let p₂ : Q ⟶ V :=
        MorphismProperty.Over.homMk (Limits.pullback.snd (κ z₀).left K.left) hq2 trivial
      have hsq : p₁ ≫ κ z₀ = p₂ ≫ K := by
        apply MorphismProperty.Over.Hom.ext
        exact Limits.pullback.condition (f := (κ z₀).left) (g := K.left)
      obtain ⟨qpt, -, hqv⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := (κ z₀).left) (g := K.left) (z₁ z₀) v ((hκ z₀).trans hz₀.symm)
      have key : p₂ ≫ b = (p₂ ≫ a) ≫ γ z₀ := by
        calc p₂ ≫ b = p₂ ≫ K ≫ P₂ := by rw [hK2]
          _ = (p₂ ≫ K) ≫ P₂ := (Category.assoc _ _ _).symm
          _ = (p₁ ≫ κ z₀) ≫ P₂ := by rw [hsq]
          _ = p₁ ≫ (κ z₀ ≫ P₂) := Category.assoc _ _ _
          _ = p₁ ≫ ((κ z₀ ≫ P₁) ≫ γ z₀) := by rw [hγ z₀]
          _ = ((p₁ ≫ κ z₀) ≫ P₁) ≫ γ z₀ := by simp only [Category.assoc]
          _ = ((p₂ ≫ K) ≫ P₁) ≫ γ z₀ := by rw [hsq]
          _ = (p₂ ≫ a) ≫ γ z₀ := by rw [Category.assoc p₂, hK1]
      have hF := hA (γ z₀) Q (p₂ ≫ a) (p₂ ≫ b) key
        (((wcRq h ℓ q).obj.map p₂.op).hom t) qpt
      have L := TR Q V b p₂ t qpt
      have R := TR Q V a p₂ t qpt
      have hp : p₂.left qpt = v := hqv
      rw [hp] at L R
      exact L.symm.trans (hF.trans (congrArg (A (γ z₀)) R))
    refine ⟨fun z => A (γ z), ?_, hb, ?_, ?_, ?_⟩
    ·
      intro z
      exact ⟨γ z, hγw z, fun s x => hA (γ z) W (𝟙 W) (γ z) (Category.id_comp _).symm s x⟩
    ·
      intro j
      have hl : P₁.left ≫ w.left = P₂.left ≫ w.left :=
        Limits.pullback.condition (f := w.left) (g := w.left)
      have hid : ∀ z : ↥(Limits.pullback w.left w.left),
          Limits.pullback.lift P₁.left P₂.left hl z = z := by
        intro z
        have e : Limits.pullback.lift P₁.left P₂.left hl = 𝟙 _ :=
