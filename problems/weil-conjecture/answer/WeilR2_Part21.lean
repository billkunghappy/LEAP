    intro X X' f P P' w hS' w' hS''
    let L := ProjectiveResolution.lift f P P'
    have hL : L.f 0 ≫ P'.π.f 0 = P.π.f 0 ≫ f := ProjectiveResolution.lift_commutes_zero f P P'
    let F₁ := ((linearYoneda A (ModuleCat.{u} A)).obj S.X₁).rightOp
    let F₂ := ((linearYoneda A (ModuleCat.{u} A)).obj S.X₂).rightOp
    let F₃ := ((linearYoneda A (ModuleCat.{u} A)).obj S.X₃).rightOp
