      (A : Type u) (_ : CommRing A) (_ : HenselianLocalRing A)
      (_ : IsSepClosed (IsLocalRing.ResidueField A)) (e : Vy.left ≅ Spec (.of A))
      (ι : Vξ ⟶ Vy),
      Vy.hom (e.inv (IsLocalRing.closedPoint A)) = lam (D.S j (IsLocalRing.closedPoint F'')) ∧
