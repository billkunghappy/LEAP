by
  intro A _ _ _ _ _ ℓ _ hℓ n hn hn2 π c hπ hc x₀ hx₀ B₀ _ _ _ Λ₀ _ _ W₀ φ₀ a₀ hsh L _ _ φA hφA
    halg σ hσ htame XE p q hpb Xs ι s hps w hw₁ hw₂ Dp hDp Dτ hDτ Di hDi I
  obtain ⟨k, hk⟩ := hn
  rcases (by omega : n = 2 ∨ 4 ≤ n) with h2 | h4
  · subst h2
    obtain ⟨hqc, hqs, hloc, hsing⟩ :=
      wc_qmpl_n2_semistable_chart A π c hπ hc x₀ hx₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
    exact wc_qmpl_semistable_local_PL A ℓ hℓ π hπ _ _ hqc hqs hloc hsing L φA hφA halg σ hσ
      htame XE p q hpb Xs ι s hps w hw₁ hw₂ Dp hDp Dτ hDτ Di hDi I
  · intro α hφ t ht P Pw K γ Tflat T TΨ hT
    obtain ⟨L', _, _, ιL, S', σ', hLalg, hS, hσι, hσS, hprim⟩ :=
      wc_qmpl_root_field A ℓ hℓ π hπ L φA hφA σ hσ htame
    have hcomp₂ : (w ≫ w) ≫ p = p := by rw [Category.assoc, hw₁, hw₁]
    obtain ⟨D₂, hD₂, hφ₂, t₂, ht₂, hsq⟩ :=
      wc_qmpl_T_square hw₁ hcomp₂ Dp hDp Dτ hDτ Di I hφ t ht
    have hσ2 : (σ.comp σ).comp φA = φA := by rw [RingHom.comp_assoc, hσ, hσ]
    have hw2q : (w ≫ w) ≫ q = q ≫ Spec.map (CommRingCat.ofHom (σ.comp σ)) := by
      rw [Category.assoc, hw₂, ← Category.assoc, hw₂, Category.assoc, ← Spec.map_comp]
      rfl
    obtain ⟨A', _, _, _, _, _, π', hℓ', hπ', Xm, f, hqc, hqs, hloc, hsing, φ', hφ', halg',
      hσφ', htame', XE', p', q', hpb', Xs', ι', s', hps', w', hw₁', hw₂', himp⟩ :=
      wc_qmpl_blowup_transfer A ℓ hℓ n ⟨k, hk⟩ h4 π c hπ hc x₀ hx₀ B₀ Λ₀ W₀ φ₀ a₀ hsh L φA hφA
        halg (σ.comp σ) hσ2 L' ιL hLalg S' σ' hS hσι hσS hprim XE p q hpb Xs ι s hps (w ≫ w)
        hcomp₂ hw2q Dp hDp D₂ hD₂ Di hDi I hφ₂ t₂ ht₂
    refine himp ?_ (hsq.trans (by rw [hT, Category.comp_id]))
    intro Dp' hDp' Dτ' hDτ' Di' hDi' I' α' hφ'' t' ht'
    exact wc_qmpl_semistable_local_PL A' ℓ hℓ' π' hπ' Xm f hqc hqs hloc hsing L' φ' hφ'
