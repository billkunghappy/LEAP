theorem wc_res_tower_bijective_of_torsion_bij {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    (L : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush i)
    (θ : ∀ V : Y.ProEt, L.obj (wcFreeSheaf Y V) ≅ wcFreeSheaf Z ((wcProEtPullback i).obj V))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (U : Y.ProEt) (j : ℕ)
    (htor : ∀ k : ℕ, Function.Bijective (wcProEtRes i L adj θ (ZMod (ℓ ^ k)) U j)) :
    Function.Bijective (wcProEtRes i L adj θ ((n : ℕ) → ZMod (ℓ ^ n)) U j) :=
by
  classical
  let R : ∀ (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
      (G' : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
      (_ : L.obj G ⟶ G') (q : ℕ),
      Abelian.Ext (wcFreeSheaf Y U) G q →+
        Abelian.Ext (wcFreeSheaf Z ((wcProEtPullback i).obj U)) G' q :=
    fun G G' a q => ((Abelian.Ext.mk₀ (θ U).inv).precomp G'
      (zero_add q)).comp (((Abelian.Ext.mk₀ a).postcomp _ (add_zero q)).comp (L.mapExtAddHom _ _ q))
  have hR : ∀ G G' (a : L.obj G ⟶ G') (q : ℕ)
      (z : Abelian.Ext (wcFreeSheaf Y U) G q),
      R G G' a q z = (Abelian.Ext.mk₀ (θ U).inv).comp
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ a) (add_zero q)) (zero_add q) := by
    intro G G' a q z
    first
      | rfl
      | (simp only [R, AddMonoidHom.comp_apply, Functor.mapExtAddHom_apply]; rfl)
  have hN : ∀ {G1 G2 : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
      {G1' G2' : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}}
      (κY : G1 ⟶ G2) (κX : G1' ⟶ G2') (a1 : L.obj G1 ⟶ G1') (a2 : L.obj G2 ⟶ G2'),
      L.map κY ≫ a2 = a1 ≫ κX → ∀ (q : ℕ)
      (z : Abelian.Ext (wcFreeSheaf Y U) G1 q),
      R G2 G2' a2 q (z.comp (Abelian.Ext.mk₀ κY) (add_zero q)) =
        (R G1 G1' a1 q z).comp (Abelian.Ext.mk₀ κX) (add_zero q) := by
    intro G1 G2 G1' G2' κY κX a1 a2 h q z
    have e1 : Abelian.Ext.mapExactFunctor L (z.comp (Abelian.Ext.mk₀ κY) (add_zero q)) =
        (Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ (L.map κY)) (add_zero q) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    have e2 : ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ (L.map κY))
        (add_zero q)).comp (Abelian.Ext.mk₀ a2) (add_zero q) =
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ a1) (add_zero q)).comp
        (Abelian.Ext.mk₀ κX) (add_zero q) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, h,
        ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero]
    rw [hR, hR, e1, e2]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add q) (add_zero q) (by omega)).symm
  have hAdj : ∀ {G1 G2 : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
      {G1' G2' : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}}
      (κY : G1 ⟶ G2) (κX : G1' ⟶ G2')
      (p1 : G1 ⟶ (wcProEtPush i).obj G1')
      (p2 : G2 ⟶ (wcProEtPush i).obj G2'),
      κY ≫ p2 = p1 ≫ (wcProEtPush i).map κX →
      L.map κY ≫ (adj.homEquiv _ _).symm p2 = (adj.homEquiv _ _).symm p1 ≫ κX := by
    intro G1 G2 G1' G2' κY κX p1 p2 h
    rw [← adj.homEquiv_naturality_left_symm, h, adj.homEquiv_naturality_right_symm]

  have hstar : ∀ (m : ℕ)
      (x : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y ((n : ℕ) → ZMod (ℓ ^ n))) j),
      wcProEtRes i L adj θ (ZMod (ℓ ^ m)) U j (x.comp (Abelian.Ext.mk₀
        (wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) m)
          (continuous_apply m))) (add_zero j)) =
        (wcProEtRes i L adj θ ((n : ℕ) → ZMod (ℓ ^ n)) U j x).comp (Abelian.Ext.mk₀
          (wcContSheafMap Z (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) m)
            (continuous_apply m))) (add_zero j) := by
    intro m x
    exact hN _ _ _ _ (hAdj _ _ (wcContPull i ((n : ℕ) → ZMod (ℓ ^ n)))
      (wcContPull i (ZMod (ℓ ^ m))) (wc_contPull_contSheafMap i _ (continuous_apply m))) j x
  haveI := wc_proet_products_exact Y
  haveI := wc_proet_products_exact Z
  have hYl := (wc_contSheaf_pi_isLimit Y (fun n => ZMod (ℓ ^ n))).some
  have hZl := (wc_contSheaf_pi_isLimit Z (fun n => ZMod (ℓ ^ n))).some
  have hprodY := wc_ext_prod_bijective (wcFreeSheaf Y U)
    (wcContSheaf Y ((n : ℕ) → ZMod (ℓ ^ n))) (fun n => wcContSheaf Y (ZMod (ℓ ^ n)))
    (fun n => wcContSheafMap Y (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      (continuous_apply n)) hYl j
  have hprodZ := wc_ext_prod_bijective (wcFreeSheaf Z ((wcProEtPullback i).obj U))
    (wcContSheaf Z ((n : ℕ) → ZMod (ℓ ^ n))) (fun n => wcContSheaf Z (ZMod (ℓ ^ n)))
    (fun n => wcContSheafMap Z (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n)
      (continuous_apply n)) hZl j
  constructor
  · rw [injective_iff_map_eq_zero]
    intro x hx
    apply hprodY.1 x
    intro m
    apply (htor m).1
    rw [hstar m x, hx, map_zero, Abelian.Ext.zero_comp]
  · intro x'
    have hsurj : ∀ m : ℕ, ∃ t : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y (ZMod (ℓ ^ m))) j,
        wcProEtRes i L adj θ (ZMod (ℓ ^ m)) U j t =
          x'.comp (Abelian.Ext.mk₀ (wcContSheafMap Z
            (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) m) (continuous_apply m))) (add_zero j) :=
      fun m => (htor m).2 _
    choose y hy using hsurj
    obtain ⟨x, hx⟩ := hprodY.2 y
    refine ⟨x, ?_⟩
    rw [← sub_eq_zero]
    apply hprodZ.1
    intro m
    rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg,
      ← hstar m x, hx m, hy m, sub_self]

theorem wc_res_int_bijective_of_tower_bij {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    (L : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush i)
    (θ : ∀ V : Y.ProEt, L.obj (wcFreeSheaf Y V) ≅ wcFreeSheaf Z ((wcProEtPullback i).obj V))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (U : Y.ProEt)
    (htow : ∀ j : ℕ, Function.Bijective (wcProEtRes i L adj θ ((n : ℕ) → ZMod (ℓ ^ n)) U j))
    (j : ℕ) : Function.Bijective (wcProEtRes i L adj θ ℤ_[ℓ] U j) :=
by
  classical
  obtain ⟨hcI, hemb, hcS, hker, hsec⟩ := wc_padic_tower_facts ℓ
  obtain ⟨hzY, hSY⟩ := wc_contSheaf_shortExact Y (wcTowerIncl ℓ) hcI
    (wcTowerShift ℓ) hcS hemb hker hsec
  obtain ⟨hzZ, hSZ⟩ := wc_contSheaf_shortExact Z (wcTowerIncl ℓ) hcI
    (wcTowerShift ℓ) hcS hemb hker hsec
  let R : ∀ (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
      (G' : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
      (_ : L.obj G ⟶ G') (q : ℕ),
      Abelian.Ext (wcFreeSheaf Y U) G q →+
        Abelian.Ext (wcFreeSheaf Z ((wcProEtPullback i).obj U)) G' q :=
    fun G G' a q => ((Abelian.Ext.mk₀ (θ U).inv).precomp G'
      (zero_add q)).comp (((Abelian.Ext.mk₀ a).postcomp _ (add_zero q)).comp (L.mapExtAddHom _ _ q))
  have hR : ∀ G G' (a : L.obj G ⟶ G') (q : ℕ)
      (z : Abelian.Ext (wcFreeSheaf Y U) G q),
      R G G' a q z = (Abelian.Ext.mk₀ (θ U).inv).comp
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ a) (add_zero q)) (zero_add q) := by
    intro G G' a q z
    first
      | rfl
      | (simp only [R, AddMonoidHom.comp_apply, Functor.mapExtAddHom_apply]; rfl)
  have hN : ∀ {G1 G2 : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
      {G1' G2' : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}}
      (κY : G1 ⟶ G2) (κX : G1' ⟶ G2') (a1 : L.obj G1 ⟶ G1') (a2 : L.obj G2 ⟶ G2'),
      L.map κY ≫ a2 = a1 ≫ κX → ∀ (q : ℕ)
      (z : Abelian.Ext (wcFreeSheaf Y U) G1 q),
      R G2 G2' a2 q (z.comp (Abelian.Ext.mk₀ κY) (add_zero q)) =
        (R G1 G1' a1 q z).comp (Abelian.Ext.mk₀ κX) (add_zero q) := by
    intro G1 G2 G1' G2' κY κX a1 a2 h q z
    have e1 : Abelian.Ext.mapExactFunctor L (z.comp (Abelian.Ext.mk₀ κY) (add_zero q)) =
        (Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ (L.map κY)) (add_zero q) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    have e2 : ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ (L.map κY))
        (add_zero q)).comp (Abelian.Ext.mk₀ a2) (add_zero q) =
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ a1) (add_zero q)).comp
        (Abelian.Ext.mk₀ κX) (add_zero q) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, h,
        ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero]
    rw [hR, hR, e1, e2]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add q) (add_zero q) (by omega)).symm
  have hAdj : ∀ {G1 G2 : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
      {G1' G2' : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}}
      (κY : G1 ⟶ G2) (κX : G1' ⟶ G2')
      (p1 : G1 ⟶ (wcProEtPush i).obj G1')
      (p2 : G2 ⟶ (wcProEtPush i).obj G2'),
      κY ≫ p2 = p1 ≫ (wcProEtPush i).map κX →
      L.map κY ≫ (adj.homEquiv _ _).symm p2 = (adj.homEquiv _ _).symm p1 ≫ κX := by
    intro G1 G2 G1' G2' κY κX p1 p2 h
    rw [← adj.homEquiv_naturality_left_symm, h, adj.homEquiv_naturality_right_symm]

  have h1 : L.map (wcContSheafMap Y (wcTowerIncl ℓ) hcI) ≫
      (adj.homEquiv _ _).symm (wcContPull i ((n : ℕ) → ZMod (ℓ ^ n))) =
      (adj.homEquiv _ _).symm (wcContPull i ℤ_[ℓ]) ≫ wcContSheafMap Z (wcTowerIncl ℓ) hcI :=
    hAdj _ _ (wcContPull i ℤ_[ℓ]) (wcContPull i ((n : ℕ) → ZMod (ℓ ^ n)))
      (wc_contPull_contSheafMap i (wcTowerIncl ℓ) hcI)
  have h2 : L.map (wcContSheafMap Y (wcTowerShift ℓ) hcS) ≫
      (adj.homEquiv _ _).symm (wcContPull i ((n : ℕ) → ZMod (ℓ ^ n))) =
      (adj.homEquiv _ _).symm (wcContPull i ((n : ℕ) → ZMod (ℓ ^ n))) ≫
        wcContSheafMap Z (wcTowerShift ℓ) hcS :=
    hAdj _ _ (wcContPull i ((n : ℕ) → ZMod (ℓ ^ n))) (wcContPull i ((n : ℕ) → ZMod (ℓ ^ n)))
      (wc_contPull_contSheafMap i (wcTowerShift ℓ) hcS)

  have hf : ∀ (q : ℕ) (x : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y ℤ_[ℓ]) q),
      wcProEtRes i L adj θ ((n : ℕ) → ZMod (ℓ ^ n)) U q
        (x.comp (Abelian.Ext.mk₀ (wcContSheafMap Y (wcTowerIncl ℓ) hcI)) (add_zero q)) =
      (wcProEtRes i L adj θ ℤ_[ℓ] U q x).comp
        (Abelian.Ext.mk₀ (wcContSheafMap Z (wcTowerIncl ℓ) hcI)) (add_zero q) :=
    fun q x => hN _ _ _ _ h1 q x
  have hg : ∀ (q : ℕ)
      (x : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y ((n : ℕ) → ZMod (ℓ ^ n))) q),
      wcProEtRes i L adj θ ((n : ℕ) → ZMod (ℓ ^ n)) U q
        (x.comp (Abelian.Ext.mk₀ (wcContSheafMap Y (wcTowerShift ℓ) hcS)) (add_zero q)) =
      (wcProEtRes i L adj θ ((n : ℕ) → ZMod (ℓ ^ n)) U q x).comp
        (Abelian.Ext.mk₀ (wcContSheafMap Z (wcTowerShift ℓ) hcS)) (add_zero q) :=
    fun q x => hN _ _ _ _ h2 q x

  have hL := hSY.map_of_exact L
  let Φ : (ShortComplex.mk (wcContSheafMap Y (wcTowerIncl ℓ) hcI)
      (wcContSheafMap Y (wcTowerShift ℓ) hcS) hzY).map L ⟶
      ShortComplex.mk (wcContSheafMap Z (wcTowerIncl ℓ) hcI)
        (wcContSheafMap Z (wcTowerShift ℓ) hcS) hzZ :=
    ShortComplex.homMk ((adj.homEquiv _ _).symm (wcContPull i ℤ_[ℓ]))
      ((adj.homEquiv _ _).symm (wcContPull i ((n : ℕ) → ZMod (ℓ ^ n))))
      ((adj.homEquiv _ _).symm (wcContPull i ((n : ℕ) → ZMod (ℓ ^ n)))) h1.symm h2.symm
  have hnat := hL.extClass_naturality hSZ Φ
  have key : (Abelian.Ext.mapExactFunctor L hSY.extClass).comp
      (Abelian.Ext.mk₀ ((adj.homEquiv _ _).symm (wcContPull i ℤ_[ℓ]))) (add_zero 1) =
      (Abelian.Ext.mk₀ ((adj.homEquiv _ _).symm (wcContPull i ((n : ℕ) → ZMod (ℓ ^ n))))).comp
        hSZ.extClass (zero_add 1) := by
    rw [Abelian.Ext.mapExactFunctor_extClass]
    exact hnat
  have hδ : ∀ (q : ℕ)
      (x : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y ((n : ℕ) → ZMod (ℓ ^ n))) q),
      wcProEtRes i L adj θ ℤ_[ℓ] U (q + 1) (x.comp hSY.extClass rfl) =
      (wcProEtRes i L adj θ ((n : ℕ) → ZMod (ℓ ^ n)) U q x).comp hSZ.extClass rfl := by
    intro q x
    change R (wcContSheaf Y ℤ_[ℓ]) (wcContSheaf Z ℤ_[ℓ])
        ((adj.homEquiv _ _).symm (wcContPull i ℤ_[ℓ])) (q + 1) (x.comp hSY.extClass rfl) =
      (R (wcContSheaf Y ((n : ℕ) → ZMod (ℓ ^ n))) (wcContSheaf Z ((n : ℕ) → ZMod (ℓ ^ n)))
        ((adj.homEquiv _ _).symm (wcContPull i ((n : ℕ) → ZMod (ℓ ^ n)))) q x).comp
        hSZ.extClass rfl
    rw [hR, hR, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.comp_assoc_of_third_deg_zero, key,
      ← Abelian.Ext.comp_assoc_of_second_deg_zero]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add q) rfl (by omega)).symm

  haveI hmY : Mono (wcContSheafMap Y (wcTowerIncl ℓ) hcI) := hSY.mono_f
  haveI hmZ : Mono (wcContSheafMap Z (wcTowerIncl ℓ) hcI) := hSZ.mono_f
  have inj0Y : ∀ x : Abelian.Ext (wcFreeSheaf Y U) (wcContSheaf Y ℤ_[ℓ]) 0,
      x.comp (Abelian.Ext.mk₀ (wcContSheafMap Y (wcTowerIncl ℓ) hcI)) (add_zero 0) = 0 →
      x = 0 := by
    intro x hx
    obtain ⟨φ, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x
    rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_eq_zero_iff] at hx
    have hφ : φ = 0 := (cancel_mono (wcContSheafMap Y (wcTowerIncl ℓ) hcI)).1
      (hx.trans Limits.zero_comp.symm)
    rw [hφ, Abelian.Ext.mk₀_zero]
  have inj0Z : ∀ x : Abelian.Ext (wcFreeSheaf Z ((wcProEtPullback i).obj U))
      (wcContSheaf Z ℤ_[ℓ]) 0,
      x.comp (Abelian.Ext.mk₀ (wcContSheafMap Z (wcTowerIncl ℓ) hcI)) (add_zero 0) = 0 →
      x = 0 := by
    intro x hx
    obtain ⟨φ, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x
    rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_eq_zero_iff] at hx
    have hφ : φ = 0 := (cancel_mono (wcContSheafMap Z (wcTowerIncl ℓ) hcI)).1
      (hx.trans Limits.zero_comp.symm)
    rw [hφ, Abelian.Ext.mk₀_zero]
  cases j with
  | zero =>
    constructor
    · rw [injective_iff_map_eq_zero]
      intro y hy
      apply inj0Y y
      apply (htow 0).1
      rw [hf, hy, Abelian.Ext.zero_comp, map_zero]
    · intro y'
      obtain ⟨t, ht⟩ := (htow 0).2
        (y'.comp (Abelian.Ext.mk₀ (wcContSheafMap Z (wcTowerIncl ℓ) hcI)) (add_zero 0))
      have h3 : t.comp (Abelian.Ext.mk₀ (wcContSheafMap Y (wcTowerShift ℓ) hcS)) (add_zero 0) = 0 := by
        apply (htow 0).1
        rw [hg, ht, map_zero, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
          hzZ, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hSY t h3
      refine ⟨y, ?_⟩
      rw [← sub_eq_zero]
      apply inj0Z
      have hy' : y.comp (Abelian.Ext.mk₀ (wcContSheafMap Y (wcTowerIncl ℓ) hcI)) (add_zero 0) = t :=
        hy
      rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← hf, hy', ht,
        add_neg_cancel]
  | succ n =>
    have ex1 := (ShortComplex.ab_exact_iff_function_exact _).mp
      (Abelian.Ext.covariant_sequence_exact₃' (wcFreeSheaf Y U) hSY n (n + 1) rfl)
    have ex2 := (ShortComplex.ab_exact_iff_function_exact _).mp
      (Abelian.Ext.covariant_sequence_exact₁' (wcFreeSheaf Y U) hSY n (n + 1) rfl)
    have ex3 := (ShortComplex.ab_exact_iff_function_exact _).mp
      (Abelian.Ext.covariant_sequence_exact₂' (wcFreeSheaf Y U) hSY (n + 1))
    have ex1' := (ShortComplex.ab_exact_iff_function_exact _).mp
      (Abelian.Ext.covariant_sequence_exact₃' (wcFreeSheaf Z ((wcProEtPullback i).obj U))
        hSZ n (n + 1) rfl)
    have ex2' := (ShortComplex.ab_exact_iff_function_exact _).mp
      (Abelian.Ext.covariant_sequence_exact₁' (wcFreeSheaf Z ((wcProEtPullback i).obj U))
        hSZ n (n + 1) rfl)
    have ex3' := (ShortComplex.ab_exact_iff_function_exact _).mp
      (Abelian.Ext.covariant_sequence_exact₂' (wcFreeSheaf Z ((wcProEtPullback i).obj U))
        hSZ (n + 1))
    exact AddMonoidHom.bijective_of_surjective_of_bijective_of_bijective_of_injective
      ((Abelian.Ext.mk₀ (wcContSheafMap Y (wcTowerShift ℓ) hcS)).postcomp (wcFreeSheaf Y U)
        (add_zero n))
      (hSY.extClass.postcomp (wcFreeSheaf Y U) (show n + 1 = n + 1 from rfl))
      ((Abelian.Ext.mk₀ (wcContSheafMap Y (wcTowerIncl ℓ) hcI)).postcomp (wcFreeSheaf Y U)
        (add_zero (n + 1)))
      ((Abelian.Ext.mk₀ (wcContSheafMap Y (wcTowerShift ℓ) hcS)).postcomp (wcFreeSheaf Y U)
        (add_zero (n + 1)))
      ((Abelian.Ext.mk₀ (wcContSheafMap Z (wcTowerShift ℓ) hcS)).postcomp
        (wcFreeSheaf Z ((wcProEtPullback i).obj U)) (add_zero n))
      (hSZ.extClass.postcomp (wcFreeSheaf Z ((wcProEtPullback i).obj U))
        (show n + 1 = n + 1 from rfl))
      ((Abelian.Ext.mk₀ (wcContSheafMap Z (wcTowerIncl ℓ) hcI)).postcomp
        (wcFreeSheaf Z ((wcProEtPullback i).obj U)) (add_zero (n + 1)))
      ((Abelian.Ext.mk₀ (wcContSheafMap Z (wcTowerShift ℓ) hcS)).postcomp
        (wcFreeSheaf Z ((wcProEtPullback i).obj U)) (add_zero (n + 1)))
      (wcProEtRes i L adj θ ((n : ℕ) → ZMod (ℓ ^ n)) U n)
      (wcProEtRes i L adj θ ((n : ℕ) → ZMod (ℓ ^ n)) U n)
      (wcProEtRes i L adj θ ℤ_[ℓ] U (n + 1))
      (wcProEtRes i L adj θ ((n : ℕ) → ZMod (ℓ ^ n)) U (n + 1))
      (wcProEtRes i L adj θ ((n : ℕ) → ZMod (ℓ ^ n)) U (n + 1))
      (AddMonoidHom.ext fun x => (hg n x).symm)
      (AddMonoidHom.ext fun x => (hδ n x).symm)
      (AddMonoidHom.ext fun x => (hf (n + 1) x).symm)
      (AddMonoidHom.ext fun x => (hg (n + 1) x).symm)
      ex1 ex2 ex3 ex1' ex2' ex3'
      (htow n).2 (htow n) (htow (n + 1)) (htow (n + 1)).1

theorem wc_res_ladic_bijective_of_int_bij {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    (L : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush i)
    (θ : ∀ V : Y.ProEt, L.obj (wcFreeSheaf Y V) ≅ wcFreeSheaf Z ((wcProEtPullback i).obj V))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (U : Y.ProEt) [CompactSpace U.left] [QuasiSeparatedSpace U.left]
    [CompactSpace ((wcProEtPullback i).obj U).left]
    [QuasiSeparatedSpace ((wcProEtPullback i).obj U).left]
    (j : ℕ) (hint : Function.Bijective (wcProEtRes i L adj θ ℤ_[ℓ] U j)) :
    Function.Bijective (wcProEtRes i L adj θ ℚ_[ℓ] U j) :=
by
  classical
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have ratY := proet_qcqs_ladic_rationalization Y U ℓ j
  have ratX := proet_qcqs_ladic_rationalization Z ((wcProEtPullback i).obj U) ℓ j

  let R : ∀ (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
      (G' : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
      (_ : L.obj G ⟶ G') (q : ℕ),
      Abelian.Ext (wcFreeSheaf Y U) G q →+
        Abelian.Ext (wcFreeSheaf Z ((wcProEtPullback i).obj U)) G' q :=
    fun G G' a q => ((Abelian.Ext.mk₀ (θ U).inv).precomp G'
      (zero_add q)).comp (((Abelian.Ext.mk₀ a).postcomp _ (add_zero q)).comp (L.mapExtAddHom _ _ q))
  have hR : ∀ G G' (a : L.obj G ⟶ G') (q : ℕ)
      (z : Abelian.Ext (wcFreeSheaf Y U) G q),
      R G G' a q z = (Abelian.Ext.mk₀ (θ U).inv).comp
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ a) (add_zero q)) (zero_add q) := by
    intro G G' a q z
    first
      | rfl
      | (simp only [R, AddMonoidHom.comp_apply, Functor.mapExtAddHom_apply]; rfl)
  have hN : ∀ {G1 G2 : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
      {G1' G2' : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}}
      (κY : G1 ⟶ G2) (κX : G1' ⟶ G2') (a1 : L.obj G1 ⟶ G1') (a2 : L.obj G2 ⟶ G2'),
      L.map κY ≫ a2 = a1 ≫ κX → ∀ (q : ℕ)
      (z : Abelian.Ext (wcFreeSheaf Y U) G1 q),
      R G2 G2' a2 q (z.comp (Abelian.Ext.mk₀ κY) (add_zero q)) =
        (R G1 G1' a1 q z).comp (Abelian.Ext.mk₀ κX) (add_zero q) := by
    intro G1 G2 G1' G2' κY κX a1 a2 h q z
    have e1 : Abelian.Ext.mapExactFunctor L (z.comp (Abelian.Ext.mk₀ κY) (add_zero q)) =
        (Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ (L.map κY)) (add_zero q) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
    have e2 : ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ (L.map κY)) (add_zero q)).comp
        (Abelian.Ext.mk₀ a2) (add_zero q) =
        ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ a1) (add_zero q)).comp
        (Abelian.Ext.mk₀ κX) (add_zero q) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, h,
        ← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero]
    rw [hR, hR, e1, e2]
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add q) (add_zero q) (by omega)).symm
  have hAdj : ∀ {G1 G2 : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
      {G1' G2' : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}}
      (κY : G1 ⟶ G2) (κX : G1' ⟶ G2')
      (p1 : G1 ⟶ (wcProEtPush i).obj G1')
      (p2 : G2 ⟶ (wcProEtPush i).obj G2'),
      κY ≫ p2 = p1 ≫ (wcProEtPush i).map κX →
      L.map κY ≫ (adj.homEquiv _ _).symm p2 = (adj.homEquiv _ _).symm p1 ≫ κX := by
    intro G1 G2 G1' G2' κY κX p1 p2 h
    rw [← adj.homEquiv_naturality_left_symm, h, adj.homEquiv_naturality_right_symm]
  let Ψ0 : Abelian.Ext (wcFreeSheaf Y U) (wcLadicSheaf Y ℓ) j →+
      Abelian.Ext (wcFreeSheaf Z ((wcProEtPullback i).obj U)) (wcLadicSheaf Z ℓ) j :=
    R (wcLadicSheaf Y ℓ) (wcLadicSheaf Z ℓ) ((adj.homEquiv _ _).symm (wcContPull i ℚ_[ℓ])) j
  let ρI : Abelian.Ext (wcFreeSheaf Y U) (wcIntSheaf Y ℓ) j →+
      Abelian.Ext (wcFreeSheaf Z ((wcProEtPullback i).obj U)) (wcIntSheaf Z ℓ) j :=
    R (wcIntSheaf Y ℓ) (wcIntSheaf Z ℓ) ((adj.homEquiv _ _).symm (wcContPull i ℤ_[ℓ])) j
  have hΨ0 : ∀ z, wcProEtRes i L adj θ ℚ_[ℓ] U j z = Ψ0 z := fun z => rfl
  have hρI : ∀ x, wcProEtRes i L adj θ ℤ_[ℓ] U j x = ρI x := fun x => rfl
  have hNatQ : ∀ y : Abelian.Ext (wcFreeSheaf Y U) (wcIntSheaf Y ℓ) j,
      Ψ0 (y.comp (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)) (add_zero j)) =
        (ρI y).comp (Abelian.Ext.mk₀ (wcIntToLadic Z ℓ)) (add_zero j) := by
    intro y
    have hsq : wcIntToLadic Y ℓ ≫ wcContPull i ℚ_[ℓ] =
        wcContPull i ℤ_[ℓ] ≫ (wcProEtPush i).map (wcIntToLadic Z ℓ) :=
      wc_contPull_intToLadic i ℓ
    exact hN _ _ _ _ (hAdj _ _ _ _ hsq) j y
  have hNatS : ∀ (c : ℚ_[ℓ]) (z : Abelian.Ext (wcFreeSheaf Y U) (wcLadicSheaf Y ℓ) j),
      Ψ0 (z.comp (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ c)) (add_zero j)) =
        (Ψ0 z).comp (Abelian.Ext.mk₀ (wcLadicScalar Z ℓ c)) (add_zero j) := by
    intro c z
    exact hN _ _ _ _ (hAdj _ _ _ _ (wc_contPull_ladicScalar i ℓ c)) j z

  have hρIinj : ∀ x, ρI x = 0 → x = 0 := by
    intro x hx
    have e : ρI x = ρI 0 := by rw [hx, map_zero]
    exact hint.1 e

  have Q1 : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (q N : ℕ)
      (x : Abelian.Ext P (wcLadicSheaf S ℓ) q),
      N • x = x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ (N : ℚ_[ℓ]))) (add_zero q) := by
    intro S P q N x
    obtain ⟨h1, -, hadd⟩ := wc_ladic_scalar_ring S ℓ
    induction N with
    | zero =>
      have h0 : wcLadicScalar S ℓ 0 = 0 := by
        have h := congrArg (fun t => t - wcLadicScalar S ℓ 0) (hadd 0 0)
        simp only [add_zero, sub_self, add_sub_cancel_right] at h
        exact h.symm
      rw [zero_nsmul, Nat.cast_zero, h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ N ih =>
      rw [succ_nsmul, ih, Nat.cast_succ, hadd, h1, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add,
        Abelian.Ext.comp_mk₀_id]
  have hinv : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (q : ℕ)
      (x : Abelian.Ext P (wcLadicSheaf S ℓ) q) (c : ℚ_[ℓ]), c ≠ 0 →
      (x.comp (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c)) (add_zero q)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar S ℓ c⁻¹)) (add_zero q) = x := by
    intro S P q x c hc0
    obtain ⟨h1, hmul, -⟩ := wc_ladic_scalar_ring S ℓ
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, ← hmul,
      inv_mul_cancel₀ hc0, h1, Abelian.Ext.comp_mk₀_id]
  have hΨ0inj : Function.Injective Ψ0 := by
    rw [injective_iff_map_eq_zero]
    intro z hz
    obtain ⟨a, y, hy⟩ := ratY.1 z
    have h2 : (ρI y).comp (Abelian.Ext.mk₀ (wcIntToLadic Z ℓ)) (add_zero j) = 0 := by
      rw [← hNatQ y, ← hy, map_nsmul, hz, smul_zero]
    obtain ⟨b, hb⟩ := ratX.2 (ρI y) h2
    have h3 : ℓ ^ b • y = 0 := hρIinj _ (by rw [map_nsmul, hb])
    have h4 : (ℓ ^ b * ℓ ^ a) • z = 0 := by
      calc (ℓ ^ b * ℓ ^ a) • z = ℓ ^ b • (y.comp (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ))
            (add_zero j)) := by rw [mul_smul, hy]
        _ = ((Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)).postcomp
              (wcFreeSheaf Y U) (add_zero j)) (ℓ ^ b • y) :=
            (by rw [map_nsmul]; rfl)
        _ = 0 := by rw [h3, map_zero]
    have h5 : z.comp (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ ((ℓ ^ b * ℓ ^ a : ℕ) : ℚ_[ℓ])))
        (add_zero j) = 0 := by
      rw [← Q1, h4]
    have hN0 : ((ℓ ^ b * ℓ ^ a : ℕ) : ℚ_[ℓ]) ≠ 0 :=
      Nat.cast_ne_zero.mpr (mul_ne_zero (pow_ne_zero _ hℓ0) (pow_ne_zero _ hℓ0))
    have h6 := hinv _ _ j z _ hN0
    rw [h5, Abelian.Ext.zero_comp] at h6
    exact h6.symm
  have hΨ0surj : Function.Surjective Ψ0 := by
    intro x'
    obtain ⟨a, y', hy'⟩ := ratX.1 x'
    have hsurjI : ∀ w : Abelian.Ext (wcFreeSheaf Z ((wcProEtPullback i).obj U)) (wcIntSheaf Z ℓ) j,
        ∃ v : Abelian.Ext (wcFreeSheaf Y U) (wcIntSheaf Y ℓ) j, ρI v = w := fun w => by
      obtain ⟨v, hv⟩ := hint.2 w
      exact ⟨v, hv⟩
    obtain ⟨y, hd⟩ := hsurjI y'
    have hN0 : ((ℓ ^ a : ℕ) : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr (pow_ne_zero _ hℓ0)
    refine ⟨((y.comp (Abelian.Ext.mk₀ (wcIntToLadic Y ℓ)) (add_zero j)).comp
      (Abelian.Ext.mk₀ (wcLadicScalar Y ℓ ((ℓ ^ a : ℕ) : ℚ_[ℓ])⁻¹)) (add_zero j)), ?_⟩
    rw [hNatS, hNatQ, hd, ← hy', Q1 Z _ j (ℓ ^ a) x']
    exact hinv Z _ j x' _ hN0
  exact ⟨fun z z' h => hΨ0inj h, fun x' => hΨ0surj x'⟩

theorem wc_res_ladic_bijective_of_torsion_bij {Y Z : Scheme.{u}} (i : Z ⟶ Y)
    (L : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush i)
    (θ : ∀ V : Y.ProEt, L.obj (wcFreeSheaf Y V) ≅ wcFreeSheaf Z ((wcProEtPullback i).obj V))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (U : Y.ProEt) [CompactSpace U.left] [QuasiSeparatedSpace U.left]
    [CompactSpace ((wcProEtPullback i).obj U).left]
    [QuasiSeparatedSpace ((wcProEtPullback i).obj U).left]
    (htor : ∀ j k : ℕ, Function.Bijective (wcProEtRes i L adj θ (ZMod (ℓ ^ k)) U j))
    (j : ℕ) : Function.Bijective (wcProEtRes i L adj θ ℚ_[ℓ] U j) :=
by
  have htow : ∀ j' : ℕ,
      Function.Bijective (wcProEtRes i L adj θ ((n : ℕ) → ZMod (ℓ ^ n)) U j') :=
    fun j' => wc_res_tower_bijective_of_torsion_bij i L adj θ ℓ U j' (fun k => htor j' k)
  have hint : Function.Bijective (wcProEtRes i L adj θ ℤ_[ℓ] U j) :=
    wc_res_int_bijective_of_tower_bij i L adj θ ℓ U htow j
  exact wc_res_ladic_bijective_of_int_bij i L adj θ ℓ U j hint

theorem wc_pfam_line_fibre_square {F' F'' : Type u} [Field F'] [Field F''] [Algebra F' F'']
    {Y : Over (Spec (.of F'))} {n : ℕ} (D : wcLefschetzDatum F' F'' Y n) (M' : ℕ)
    (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M') (Δ : Set (wcProjK F'' M'))
    (lam : (wcP1Over F'').left ⟶ wcProjK F'' M') (p : D.Yt.left ⟶ Xu.left)
    (hH : wcPfamHyp D M' Xu h Δ lam p) (V : (wcProjK F'' M').ProEt)
    (A : Type u) [CommRing A] (e : V.left ≅ Spec (.of A)) :
    (∃ c : Limits.pullback ((wcProEtPullback h).obj V).hom p ⟶ Limits.pullback V.hom lam,
      IsPullback (Limits.pullback.fst ((wcProEtPullback h).obj V).hom p) c
        (Limits.pullback.fst V.hom h) (Limits.pullback.fst V.hom lam)) ∧
    IsProper (Limits.pullback.fst V.hom h ≫ e.hom) ∧
    CompactSpace ((wcProEtPullback h).obj V).left ∧
    QuasiSeparatedSpace ((wcProEtPullback h).obj V).left ∧
    CompactSpace ((wcProEtPullback p).obj ((wcProEtPullback h).obj V)).left ∧
    QuasiSeparatedSpace ((wcProEtPullback p).obj ((wcProEtPullback h).obj V)).left :=
by
  obtain ⟨_, hprop, _, _, _, _, _, hlam, _, _, hpb, _, _⟩ := hH
  haveI := hprop
  haveI := hlam

  change (∃ c : Limits.pullback (Limits.pullback.snd V.hom h) p ⟶ Limits.pullback V.hom lam,
      IsPullback (Limits.pullback.fst (Limits.pullback.snd V.hom h) p) c
        (Limits.pullback.fst V.hom h) (Limits.pullback.fst V.hom lam)) ∧
    IsProper (Limits.pullback.fst V.hom h ≫ e.hom) ∧
    CompactSpace (Limits.pullback V.hom h : Scheme.{u}) ∧
    QuasiSeparatedSpace (Limits.pullback V.hom h : Scheme.{u}) ∧
    CompactSpace (Limits.pullback (Limits.pullback.snd V.hom h) p : Scheme.{u}) ∧
    QuasiSeparatedSpace (Limits.pullback (Limits.pullback.snd V.hom h) p : Scheme.{u})
  have hi : Limits.pullback.fst V.hom h ≫ V.hom = Limits.pullback.snd V.hom h ≫ h :=
    Limits.pullback.condition
  have hii : Limits.pullback.fst (Limits.pullback.snd V.hom h) p ≫ Limits.pullback.snd V.hom h =
      Limits.pullback.snd (Limits.pullback.snd V.hom h) p ≫ p :=
    Limits.pullback.condition
  have hiii : p ≫ h = D.f ≫ lam := hpb.w
  have hcond : (Limits.pullback.fst (Limits.pullback.snd V.hom h) p ≫
      Limits.pullback.fst V.hom h) ≫ V.hom =
      (Limits.pullback.snd (Limits.pullback.snd V.hom h) p ≫ D.f) ≫ lam := by
    rw [Category.assoc, hi, ← Category.assoc, hii, Category.assoc, hiii, Category.assoc]
  set c := Limits.pullback.lift _ _ hcond with hc
  have L1 : c ≫ Limits.pullback.fst V.hom lam =
      Limits.pullback.fst (Limits.pullback.snd V.hom h) p ≫ Limits.pullback.fst V.hom h :=
    Limits.pullback.lift_fst _ _ _
  have L2 : c ≫ Limits.pullback.snd V.hom lam =
      Limits.pullback.snd (Limits.pullback.snd V.hom h) p ≫ D.f :=
    Limits.pullback.lift_snd _ _ _
  have R := (IsPullback.of_hasPullback (Limits.pullback.snd V.hom h) p).paste_vert hpb
  rw [← L2, ← hi] at R
  have hsq : IsPullback (Limits.pullback.fst (Limits.pullback.snd V.hom h) p) c
      (Limits.pullback.fst V.hom h) (Limits.pullback.fst V.hom lam) :=
    IsPullback.of_bot R L1.symm (IsPullback.of_hasPullback V.hom lam)
  have hfW : IsProper (Limits.pullback.fst V.hom h) :=
    MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback V.hom h).flip hprop
  haveI := hfW
  have hb : IsProper (Limits.pullback.fst V.hom h ≫ e.hom) := inferInstance
  haveI := hb
  have hc1 : CompactSpace (Limits.pullback V.hom h : Scheme.{u}) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst V.hom h ≫ e.hom)
  have hq1 : QuasiSeparatedSpace (Limits.pullback V.hom h : Scheme.{u}) :=
    quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst V.hom h ≫ e.hom)
  haveI := hc1
  haveI := hq1
  have hp : IsClosedImmersion p :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hpb.flip hlam
  haveI := hp
  have hfE : IsClosedImmersion (Limits.pullback.fst (Limits.pullback.snd V.hom h) p) :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion)
      (IsPullback.of_hasPullback (Limits.pullback.snd V.hom h) p).flip hp
  haveI := hfE
  have hc2 : CompactSpace (Limits.pullback (Limits.pullback.snd V.hom h) p : Scheme.{u}) :=
    QuasiCompact.compactSpace_of_compactSpace
      (Limits.pullback.fst (Limits.pullback.snd V.hom h) p)
  have hq2 : QuasiSeparatedSpace (Limits.pullback (Limits.pullback.snd V.hom h) p : Scheme.{u}) :=
    quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst (Limits.pullback.snd V.hom h) p)
  exact ⟨⟨c, hsq⟩, hb, hc1, hq1, hc2, hq2⟩

theorem wc_pfam_Rq_line_pbc_iso (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p) (q : ℕ) :
    ∃ φ : (wcRq h ℓ q).obj ⟶ (wcProEtBaseChange lam).op ⋙ (wcRq D.f ℓ q).obj,
      ∀ (L : Sheaf (Scheme.ProEt.topology (wcProjK F'' M')) AddCommGrpCat.{u+1} ⥤
          Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
        (adj : L ⊣ wcProEtPush lam),
        IsIso ((adj.homEquiv (wcRq h ℓ q) (wcRq D.f ℓ q)).symm
          (ObjectProperty.homMk (φ ≫ toSheafify (Scheme.ProEt.topology (wcProjK F'' M'))
            ((wcProEtBaseChange lam).op ⋙ (wcRq D.f ℓ q).obj)))) :=
by
  classical
  have hlamci : IsClosedImmersion lam := hH.2.2.2.2.2.2.2.1

  have hPnoeth : IsLocallyNoetherian (wcProjK F'' M') := by
    letI := (MvPolynomial.gradedAlgebra :
      GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) F''))
    haveI : IsScalarTower F'' (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) F'' 0)
        (MvPolynomial (Fin (M' + 1)) F'') :=
      ⟨fun a b c => smul_mul_assoc a (b : MvPolynomial (Fin (M' + 1)) F'') c⟩
    haveI : Algebra.FiniteType (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) F'' 0)
        (MvPolynomial (Fin (M' + 1)) F'') :=
      Algebra.FiniteType.of_restrictScalars_finiteType F'' _ _
    have hsurj : Function.Surjective
        (algebraMap F'' (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) F'' 0)) := by
      rintro ⟨x, hx⟩
      have h0 : x.IsHomogeneous 0 := (MvPolynomial.mem_homogeneousSubmodule 0 x).mp hx
      have h2 : x.totalDegree = 0 := by
        have := h0.totalDegree_le
        omega
      rw [MvPolynomial.totalDegree_eq_zero_iff_eq_C] at h2
      exact ⟨_, Subtype.ext h2.symm⟩
    haveI : IsNoetherianRing (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) F'' 0) :=
      isNoetherianRing_of_surjective F'' _ _ hsurj
    haveI : IsLocallyNoetherian
        (Spec (.of (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) F'' 0))) :=
      isLocallyNoetherian_Spec.mpr (by assumption)
    exact LocallyOfFiniteType.isLocallyNoetherian
      (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (M' + 1)) F''))
  haveI := hlamci
  haveI := hPnoeth

  have hbij : ∀ {X₁ X₂ : AddCommGrpCat.{u+1}} (f : X₁ ⟶ X₂) [IsIso f],
      Function.Bijective f.hom := fun f _ => ConcreteCategory.bijective_of_isIso f

  obtain ⟨Lp, adjp, hLplim, θp, -⟩ := wc_proet_push_left_adjoint_free_nat p
  haveI := hLplim
  haveI : Lp.IsLeftAdjoint := ⟨_, ⟨adjp⟩⟩
  haveI : Limits.PreservesColimitsOfSize.{0, 0} Lp := adjp.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits Lp :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits Lp
  haveI : Lp.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint Lp
  haveI : Lp.Additive := Functor.additive_of_preserves_binary_products Lp

  obtain ⟨g, hg⟩ := wc_pfam_Rq_bc_morphism F' F'' Y n D ℓ M' Xu h Δ lam p hH q Lp adjp θp

  haveI hcont : (wcProEtBaseChange lam).IsContinuous (Scheme.ProEt.topology (wcProjK F'' M'))
      (Scheme.ProEt.topology (wcP1Over F'').left) := (wc_proet_pullback_continuous_flat lam).1
  have hTS : ∀ G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1},
      IsIso (toSheafify (Scheme.ProEt.topology (wcProjK F'' M'))
        ((wcProEtBaseChange lam).op ⋙ G.obj)) := fun G =>
    isIso_toSheafify _ (Functor.op_comp_isSheaf (wcProEtBaseChange lam) _ _ G)
  haveI := hTS (wcRq D.f ℓ q)
  refine ⟨g.hom ≫ inv (toSheafify (Scheme.ProEt.topology (wcProjK F'' M'))
      ((wcProEtBaseChange lam).op ⋙ (wcRq D.f ℓ q).obj)), fun L adj => ?_⟩
  have hφ : (ObjectProperty.homMk ((g.hom ≫ inv (toSheafify
      (Scheme.ProEt.topology (wcProjK F'' M'))
      ((wcProEtBaseChange lam).op ⋙ (wcRq D.f ℓ q).obj))) ≫
        toSheafify (Scheme.ProEt.topology (wcProjK F'' M'))
          ((wcProEtBaseChange lam).op ⋙ (wcRq D.f ℓ q).obj)) :
        wcRq h ℓ q ⟶ (wcProEtPush lam).obj (wcRq D.f ℓ q)) = g := by
    apply Sheaf.hom_ext
    show (g.hom ≫ inv _) ≫ _ = g.hom
    rw [Category.assoc, IsIso.inv_hom_id, Category.comp_id]
  rw [hφ]
  set b := (adj.homEquiv (wcRq h ℓ q) (wcRq D.f ℓ q)).symm g with hb

  have hunitb : adj.unit.app (wcRq h ℓ q) ≫ (wcProEtPush lam).map b = g := by
    exact (adj.homEquiv_unit _ _ b).symm.trans (Equiv.apply_symm_apply _ g)

  apply wc_proet_isIso_of_sections_bijective
  intro U

  refine (Scheme.ProEt.topology (wcP1Over F'').left).superset_covering
    (Sieve.generate_mono ?_) (wc_proet_closed_pull_henselian_eval lam L adj U)
  rintro T f ⟨A, iA, I, iI, V, e, c, κ, hsq, hprojV, hprojT, hunit⟩

