        ∀ E : Sheaf (K.over (bc.obj V)) AddCommGrpCat.{u+1},
          Function.Bijective (fun g : (L.obj G).over (bc.obj V) ⟶ E =>
            (Functor.whiskerLeft (Over.forget V).op uG :
              (G.over V).obj ⟶ R.obj ((L.obj G).over (bc.obj V))) ≫ R.map g) := by
      intro G
      haveI := tSiso (L.obj G)
      refine ⟨(adj.unit.app G).hom ≫ inv (toSheafify J (bc.op ⋙ (L.obj G).obj)), ?_, ?_⟩
      · intro s
        have := congrArg (fun f => (f.app (op V)).hom (((adj.unit.app G).hom.app (op V)).hom s))
          (IsIso.inv_hom_id (toSheafify J (bc.op ⋙ (L.obj G).obj)))
        exact this
      · intro E
        set uG := (adj.unit.app G).hom ≫ inv (toSheafify J (bc.op ⋙ (L.obj G).obj)) with huG
        have hcor : ∀ H : Sheaf K AddCommGrpCat.{u+1},
            Function.Bijective (fun k : L.obj G ⟶ H => uG ≫ Functor.whiskerLeft bc.op k.hom) := by
          intro H
          haveI := tSiso H
          have hfun : (fun k : L.obj G ⟶ H => uG ≫ Functor.whiskerLeft bc.op k.hom) =
              (fun p => p ≫ inv (toSheafify J (bc.op ⋙ H.obj))) ∘
                (fun f : G ⟶ _ => f.hom) ∘ (adj.homEquiv G H) := by
            funext k
            simp only [Function.comp_apply, Adjunction.homEquiv_unit]
            show (adj.unit.app G).hom ≫ inv (toSheafify J (bc.op ⋙ (L.obj G).obj)) ≫
