        DirectSum.coe_mul_apply_eq_sum_antidiagonal]
    obtain ⟨t, y, hy⟩ := Submodule.fg_iff_exists_fin_generating_family.1
      (IsNoetherian.noetherian (HomogeneousIdeal.irrelevant 𝒜).toIdeal)
    have hy' : Ideal.span (Set.range y) = (HomogeneousIdeal.irrelevant 𝒜).toIdeal := hy
    set Bd := Finset.univ.sup (fun l => (DirectSum.decompose 𝒜 (y l)).support.sup id) with hBd
    have hbig : ∀ l j, Bd < j → GradedRing.proj 𝒜 j (y l) = 0 := by
      intro l j hj
      rw [GradedRing.proj_apply]
      have hns : j ∉ (DirectSum.decompose 𝒜 (y l)).support := by
        intro hmem
        have h1 : j ≤ (DirectSum.decompose 𝒜 (y l)).support.sup id :=
          Finset.le_sup (f := id) hmem
        have h2 : (DirectSum.decompose 𝒜 (y l)).support.sup id ≤ Bd :=
          Finset.le_sup (f := fun l => (DirectSum.decompose 𝒜 (y l)).support.sup id)
            (Finset.mem_univ l)
        omega
      rw [DFinsupp.notMem_support_iff] at hns
      rw [hns]
      rfl
    have hyirr : ∀ l, y l ∈ (HomogeneousIdeal.irrelevant 𝒜).toIdeal := fun l => by
      rw [← hy']; exact Ideal.subset_span ⟨l, rfl⟩
    have hhomirr : ∀ q x, 1 ≤ q → x ∈ 𝒜 q → x ∈ (HomogeneousIdeal.irrelevant 𝒜).toIdeal := by
      intro q x hq hx
      refine (HomogeneousIdeal.mem_irrelevant_iff 𝒜 x).2 ?_
      rw [GradedRing.proj_apply]
      exact DirectSum.decompose_of_mem_ne 𝒜 hx (by omega)
    refine ⟨Bd + 1, by omega, ?_⟩
    have H : ∀ k N, k * (Bd + 1) ≤ N → ∀ x ∈ 𝒜 N,
        x ∈ (HomogeneousIdeal.irrelevant 𝒜).toIdeal ^ k := by
      intro k
      induction k with
      | zero => intro N _ x _; rw [pow_zero, Ideal.one_eq_top]; exact Submodule.mem_top
      | succ k ih =>
        intro N hN x hx
        have e : (k + 1) * (Bd + 1) = k * (Bd + 1) + (Bd + 1) := Nat.succ_mul _ _
        rw [e] at hN
        have hxirr := hhomirr N x (by omega) hx
        rw [← hy', Ideal.mem_span_range_iff_exists_fun] at hxirr
        obtain ⟨c, hc⟩ := hxirr
        have hxN : x = GradedRing.proj 𝒜 N x := by
          rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_same 𝒜 hx]
        rw [hxN, ← hc, map_sum]
        refine Ideal.sum_mem _ (fun l _ => ?_)
        rw [PF]
        refine Ideal.sum_mem _ (fun pq hpq => ?_)
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hpq
        rcases Nat.eq_zero_or_pos pq.2 with h0 | hpos
        · rw [h0, (HomogeneousIdeal.mem_irrelevant_iff 𝒜 _).1 (hyirr l), mul_zero]
          exact Ideal.zero_mem _
        rcases lt_or_ge Bd pq.2 with hb | hb
        · rw [hbig l _ hb, mul_zero]; exact Ideal.zero_mem _
        rw [pow_succ]
        apply Ideal.mul_mem_mul
        · apply ih pq.1 (by omega)
          rw [GradedRing.proj_apply]; exact SetLike.coe_mem _
        · apply hhomirr pq.2 _ hpos
          rw [GradedRing.proj_apply]; exact SetLike.coe_mem _
    intro k r hr
    rw [← DirectSum.sum_support_decompose 𝒜 r]
    refine Ideal.sum_mem _ (fun j _ => ?_)
    rcases lt_or_ge j (k * (Bd + 1)) with hj | hj
    · have := hr j hj
      rw [GradedRing.proj_apply] at this
      rw [this]; exact Ideal.zero_mem _
    · exact H k j hj _ (SetLike.coe_mem _)
  have wc_plt_hlgc_completion_domain_criterion : ∀ (A : Type u) [CommRing A] (m : Ideal A) (Q : ℕ → Ideal A) (W : ℕ) (hW : 1 ≤ W) (h1 : ∀ k : ℕ, m ^ k ≤ Q k) (h2 : ∀ k : ℕ, Q (k * W) ≤ m ^ k) (h3 : ∀ (i j : ℕ) (a b : A), a ∉ Q (i + 1) → b ∉ Q (j + 1) → a * b ∉ Q (i + j + 1)), ∀ x y : AdicCompletion m A, x * y = 0 → x = 0 ∨ y = 0 := by
    intro A _ m Q W hW h1 h2 h3
    intro x y hxy
    by_contra hne
    push_neg at hne
    obtain ⟨hx, hy⟩ := hne
    have hev : ∀ z : AdicCompletion m A, z ≠ 0 → ∃ k, 1 ≤ k ∧ AdicCompletion.evalₐ m k z ≠ 0 := by
      intro z hz
      by_contra hcon
      push_neg at hcon
      apply hz
      apply AdicCompletion.ext_evalₐ
      intro n
      rw [map_zero]
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · haveI : Subsingleton (A ⧸ m ^ 0) :=
          Ideal.Quotient.subsingleton_iff.mpr (by rw [pow_zero, Ideal.one_eq_top])
        exact Subsingleton.elim _ _
      · exact hcon n hn
    obtain ⟨k0, hk0, hx0⟩ := hev x hx
    obtain ⟨k1, hk1, hy0⟩ := hev y hy
    obtain ⟨f, rfl⟩ := AdicCompletion.mk_surjective m A x
    obtain ⟨g, rfl⟩ := AdicCompletion.mk_surjective m A y
    have hcau : ∀ (h : AdicCompletion.AdicCauchySequence m A) (i j : ℕ), i ≤ j →
        (h : ℕ → A) j - h i ∈ m ^ i := by
      intro h i j hij
      have := AdicCompletion.AdicCauchySequence.mk_eq_mk hij h
      rw [Submodule.Quotient.eq] at this
      simpa [Ideal.smul_eq_mul, Ideal.mul_top] using this
    have hnot : ∀ (h : AdicCompletion.AdicCauchySequence m A) (k0 : ℕ),
        AdicCompletion.evalₐ m k0 (AdicCompletion.mk m A h) ≠ 0 →
        ∀ j, k0 ≤ j → (h : ℕ → A) j ∉ m ^ k0 := by
      intro h k0 hne j hj hmem
      apply hne
      rw [AdicCompletion.evalₐ_mk, Ideal.Quotient.eq_zero_iff_mem]
      have h' := Ideal.sub_mem _ hmem (hcau h k0 j hj)
      simpa using h'
    set P0 := k0 * W with hP0
    set P1 := k1 * W with hP1
    have hP0a : 1 ≤ P0 := by simpa using Nat.mul_le_mul hk0 hW
    have hP1a : 1 ≤ P1 := by simpa using Nat.mul_le_mul hk1 hW
    have hP0b : k0 ≤ P0 := by
      calc k0 = k0 * 1 := (mul_one _).symm
        _ ≤ k0 * W := Nat.mul_le_mul_left _ hW
    have hP1b : k1 ≤ P1 := by
      calc k1 = k1 * 1 := (mul_one _).symm
        _ ≤ k1 * W := Nat.mul_le_mul_left _ hW
    set k := P0 + P1 with hk
    have ha : (f : ℕ → A) k ∉ Q ((P0 - 1) + 1) := by
      intro hmem
      rw [Nat.sub_add_cancel hP0a] at hmem
      exact hnot f k0 hx0 k (by omega) (h2 k0 hmem)
    have hb : (g : ℕ → A) k ∉ Q ((P1 - 1) + 1) := by
      intro hmem
      rw [Nat.sub_add_cancel hP1a] at hmem
      exact hnot g k1 hy0 k (by omega) (h2 k1 hmem)
    apply h3 _ _ _ _ ha hb
    have hprod : (f : ℕ → A) k * (g : ℕ → A) k ∈ m ^ k := by
      have := congrArg (AdicCompletion.evalₐ m k) hxy
      rw [map_mul, map_zero, AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, ← map_mul,
        Ideal.Quotient.eq_zero_iff_mem] at this
      exact this
    exact h1 _ (Ideal.pow_le_pow_right (by omega) hprod)

  have s9 : ∀ (A S : Type u) [CommRing A] [CommRing S] [Algebra A S] (I : Ideal A),
      IsAdicComplete I S → IsAdicComplete (I.map (algebraMap A S)) S := by
    intro A S _ _ _ I h
    have key : ∀ (n : ℕ) (x : S), x ∈ ((I.map (algebraMap A S)) ^ n • (⊤ : Submodule S S)) ↔
        x ∈ (I ^ n • (⊤ : Submodule A S)) := by
      intro n x
      rw [Ideal.smul_top_eq_map (R := A) (S := S) (I ^ n), Submodule.restrictScalars_mem,
        Ideal.smul_eq_mul, Ideal.mul_top, Ideal.map_pow]
    haveI : IsHausdorff (I.map (algebraMap A S)) S := ⟨fun x hx => h.toIsHausdorff.haus x
      (fun n => by
        have := hx n
        rw [SModEq.sub_mem] at this ⊢
        exact (key n _).1 this)⟩
    haveI : IsPrecomplete (I.map (algebraMap A S)) S := ⟨fun {f} hf => by
      obtain ⟨L, hL⟩ := h.toIsPrecomplete.prec (f := f) (fun {m n} hmn => by
        have := hf hmn
        rw [SModEq.sub_mem] at this ⊢
        exact (key _ _).1 this)
      exact ⟨L, fun n => by
        have := hL n
        rw [SModEq.sub_mem] at this ⊢
        exact (key _ _).2 this⟩⟩
    exact IsAdicComplete.mk

  have s10 : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
      [IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal A) A)],
      ringKrullDim (AdicCompletion (IsLocalRing.maximalIdeal A) A) = ringKrullDim A := by
    intro A _ _ _ _
    haveI : Module.Flat A (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
      AdicCompletion.flat_of_isNoetherian _
    haveI : Algebra.HasGoingDown A (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
      Algebra.HasGoingDown.of_flat
    haveI : (IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal A) A)).LiesOver
        (IsLocalRing.maximalIdeal A) := by
      rw [Ideal.liesOver_iff]
      exact (IsLocalRing.maximalIdeal_comap (algebraMap A _)).symm
    have h := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown (IsLocalRing.maximalIdeal A)
      (IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal A) A))
    have hbot : Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap A
        (AdicCompletion (IsLocalRing.maximalIdeal A) A)) (IsLocalRing.maximalIdeal A)))
        (IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal A) A)) = ⊥ := by
      rw [Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker, ← AdicCompletion.maximalIdeal_eq_map]
    haveI : Nontrivial (AdicCompletion (IsLocalRing.maximalIdeal A) A ⧸ Ideal.map (algebraMap A
        (AdicCompletion (IsLocalRing.maximalIdeal A) A)) (IsLocalRing.maximalIdeal A)) := by
      rw [Ideal.Quotient.nontrivial_iff, ← AdicCompletion.maximalIdeal_eq_map]
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top
    rw [hbot, Ideal.height_bot, add_zero] at h
    rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
      ← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, h]

  have s8 : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A] [Algebra K A],
      (∀ a : A, ∃ c : K, a - algebraMap K A c ∈ IsLocalRing.maximalIdeal A) →
      ∀ b : AdicCompletion (IsLocalRing.maximalIdeal A) A, ∃ c : K,
        b - algebraMap K (AdicCompletion (IsLocalRing.maximalIdeal A) A) c ∈
          IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal A) A) := by
    intro A _ _ _ _ hA b
    obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective
      (AdicCompletion.evalOneₐ (IsLocalRing.maximalIdeal A) b)
    obtain ⟨c, hc⟩ := hA a
    refine ⟨c, ?_⟩
    have hx : b - algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a ∈
        IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal A) A) := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have h1 := hu.map (AdicCompletion.evalOneₐ (IsLocalRing.maximalIdeal A))
      rw [map_sub, AlgHom.commutes, ← ha, Ideal.Quotient.algebraMap_eq, sub_self] at h1
      haveI : Nontrivial (A ⧸ IsLocalRing.maximalIdeal A) :=
        Ideal.Quotient.nontrivial_iff.mpr (IsLocalRing.maximalIdeal.isMaximal A).ne_top
      exact not_isUnit_zero h1
    have hy := map_nonunit (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) _ hc
    rw [map_sub, ← IsScalarTower.algebraMap_apply] at hy
    have := Ideal.add_mem _ hx hy
    convert this using 1
    ring

  have main : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A] [Algebra K A],
      (∀ a : A, ∃ c : K, a - algebraMap K A c ∈ IsLocalRing.maximalIdeal A) →
      (∀ x y : AdicCompletion (IsLocalRing.maximalIdeal A) A, x * y = 0 → x = 0 ∨ y = 0) →
      IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal A) A) ∧
      IsDomain (AdicCompletion (IsLocalRing.maximalIdeal A) A) ∧
      IsAdicComplete (IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal A) A))
        (AdicCompletion (IsLocalRing.maximalIdeal A) A) ∧
      ringKrullDim (AdicCompletion (IsLocalRing.maximalIdeal A) A) = ringKrullDim A ∧
      Function.Surjective ((IsLocalRing.residue
        (AdicCompletion (IsLocalRing.maximalIdeal A) A)).comp
        (algebraMap K (AdicCompletion (IsLocalRing.maximalIdeal A) A))) := by
    intro A _ _ _ _ hA hnzd
    have hfg : (IsLocalRing.maximalIdeal A).FG := IsNoetherian.noetherian _
    haveI hc : IsAdicComplete (IsLocalRing.maximalIdeal A)
        (AdicCompletion (IsLocalRing.maximalIdeal A) A) := AdicCompletion.isAdicComplete hfg
    have G3 : IsAdicComplete (IsLocalRing.maximalIdeal
        (AdicCompletion (IsLocalRing.maximalIdeal A) A))
        (AdicCompletion (IsLocalRing.maximalIdeal A) A) := by
      rw [AdicCompletion.maximalIdeal_eq_map]
      exact s9 _ _ _ hc
    have hres := s8 A hA
    have G5 : Function.Surjective ((IsLocalRing.residue
        (AdicCompletion (IsLocalRing.maximalIdeal A) A)).comp
        (algebraMap K (AdicCompletion (IsLocalRing.maximalIdeal A) A))) := by
      intro z
      obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective z
      obtain ⟨c, hc⟩ := hres b
      refine ⟨c, ?_⟩
      rw [RingHom.comp_apply, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff, ← neg_sub]
      exact (Ideal.neg_mem_iff _).mpr hc
    obtain ⟨n, a, ha⟩ := Submodule.fg_iff_exists_fin_generating_family.1 hfg
    set α : Fin n → AdicCompletion (IsLocalRing.maximalIdeal A) A :=
      fun i => algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) (a i) with hαdef
    have hJ : Ideal.span (Set.range α) =
        IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal A) A) := by
      have ha' : Ideal.span (Set.range a) = IsLocalRing.maximalIdeal A := ha
      have h2 : Ideal.map (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
          (Ideal.span (Set.range a)) = Ideal.map (algebraMap A
            (AdicCompletion (IsLocalRing.maximalIdeal A) A)) (IsLocalRing.maximalIdeal A) := by
        rw [ha']
      rw [AdicCompletion.maximalIdeal_eq_map, ← h2, Ideal.map_span, ← Set.range_comp]
      rfl
    have hcompJ : IsAdicComplete (Ideal.span (Set.range α))
        (AdicCompletion (IsLocalRing.maximalIdeal A) A) := by
      rw [hJ]; exact G3
    have hresJ : ∀ s : AdicCompletion (IsLocalRing.maximalIdeal A) A, ∃ c : K,
        s - algebraMap K (AdicCompletion (IsLocalRing.maximalIdeal A) A) c ∈
          Ideal.span (Set.range α) := by
      rw [hJ]; exact hres
    obtain ⟨φ, hφ⟩ := wc_plt_hlgc_powerseries_lift _ n α hcompJ
    have hsurj : Function.Surjective φ := by
      intro b
      obtain ⟨F, hF⟩ := wc_plt_hlgc_cohen_approx _ n α hresJ b
      refine ⟨F, ?_⟩
      rw [← sub_eq_zero]
      haveI := hcompJ
      refine IsHausdorff.haus (inferInstance : IsHausdorff (Ideal.span (Set.range α)) _) _ ?_
      intro k
      rw [SModEq.sub_mem, sub_zero, Ideal.smul_eq_mul, Ideal.mul_top]
      have := Ideal.sub_mem _ (hφ F k) (hF k)
      convert this using 1
      ring
    haveI : IsNoetherianRing (MvPowerSeries (Fin n) K) := MvPowerSeries.isNoetherianRing K
    have G1 : IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
      isNoetherianRing_of_surjective _ _ φ hsurj
    haveI : NoZeroDivisors (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
      ⟨fun {x y} h => hnzd x y h⟩
    have G2 : IsDomain (AdicCompletion (IsLocalRing.maximalIdeal A) A) :=
      NoZeroDivisors.to_isDomain _
    haveI := G1
    exact ⟨G1, G2, G3, s10 A, G5⟩

  have hm : IsLocalRing.maximalIdeal (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)
