    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = s0 (IsLocalRing.closedPoint F''))
    (T : (wcP1Over F'').left.ProEt) (u : T ⟶ V)
    (L : Type u) [Field L] [IsSepClosed L] (eL : T.left ≅ Spec (.of L))
    (hT : ∀ z : T.left, T.hom z ≠ s0 (IsLocalRing.closedPoint F''))
    (V' : (wcP1Over F'').left.ProEt) (v' : V' ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (A' : Type u) [CommRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] (e' : V'.left ≅ Spec (.of A'))
    (hV' : V'.hom (e'.inv (IsLocalRing.closedPoint A')) = s0 (IsLocalRing.closedPoint F''))
    (T' : (wcP1Over F'').left.ProEt) (u' : T' ⟶ V')
    (L' : Type u) [Field L'] [IsSepClosed L'] (eL' : T'.left ≅ Spec (.of L'))
    (hT' : ∀ z : T'.left, T'.hom z ≠ s0 (IsLocalRing.closedPoint F'')) :
    ∃ (β : V ≅ V') (κ : T ≅ T'), β.hom ≫ v' = v ∧ κ.hom ≫ u' = u ≫ β.hom :=
by
  classical
  haveI hWEc : MorphismProperty.IsStableUnderComposition @WeaklyEtale :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition

  have key4 : ∀ (K : Type u) [Field K] [IsSepClosed K] (O : CommRingCat.{u}) [IsLocalRing O]
      (X : Scheme.{u}) (eK : X ≅ Spec (.of K)) (s : Spec O ⟶ X), WeaklyEtale s → IsIso s := by
