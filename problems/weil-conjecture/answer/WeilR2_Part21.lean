  have hB0 : ∀ (O : (wcProjK F'' M').Opens), wcUnK F'' M' (𝟙 (wcProjK F'' M')) O =
      ((wcProjKStr F'' M').appLE ⊤ O le_top).hom.comp (Scheme.ΓSpecIso (.of F'')).inv.hom := by
    intro O
    unfold wcUnK
    simp only [Category.id_comp, CommRingCat.hom_comp]

  obtain ⟨U, hU, φ₀, hΔ₀, hunif₀⟩ := hloc j
  have hclY := wc_pfam_mc_rational_point_closed F'' _ (wcProjKStr F'' M') (D.S j ≫ lam) hσP
  have hclC := wc_pfam_mc_rational_point_closed F'' _ (wcP1Over F'').hom (D.S j) (D.hS j)
