        ((adj.unit.app G).hom.app (Opposite.op V)).hom s :=
    ⟨((inv (toSheafify (Scheme.ProEt.topology X)
          ((wcProEtBaseChange i).op ⋙ (L.obj G).obj))).app (Opposite.op V)).hom
        (((adj.unit.app G).hom.app (Opposite.op V)).hom s), by
      have := congrArg (fun f => (f.app (Opposite.op V)).hom
        (((adj.unit.app G).hom.app (Opposite.op V)).hom s))
        (IsIso.inv_hom_id (toSheafify (Scheme.ProEt.topology X)
          ((wcProEtBaseChange i).op ⋙ (L.obj G).obj)))
