        ((algebraMap S₀ S').comp (MvPolynomial.eval₂Hom ((algebraMap R₀ S₀).comp (algebraMap K R₀))
          ((1 + Nall).mulVec (fun k => algebraMap R₀ S₀ (tall k))))).comp
          (MvPolynomial.rename ε : MvPolynomial (Fin n ⊕ Fin r) K →ₐ[K]
            MvPolynomial (Fin (n + r)) K).toRingHom := by
      apply MvPolynomial.ringHom_ext
