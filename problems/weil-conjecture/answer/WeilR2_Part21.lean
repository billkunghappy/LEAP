      rfl
    · show Φ (AdjoinRoot.root _ ⊗ₜ[R] (1 : S)) = _
      rw [hΦt, map_one, mul_one, hfroot]
  have dev_L1 : ∀ (A B : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A]
    [IsLocalRing A] [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (α : A →+* B) (hα : @Algebra.WeaklyEtale A B _ _ α.toAlgebra)
    (f₀ : A) (hpr : (Ideal.span {f₀}).IsPrime)
    (hcomap : (IsLocalRing.maximalIdeal B).comap α = Ideal.span {f₀}),
      IsLocalRing.maximalIdeal B = Ideal.span {α f₀} := by
    intro A B _ _ _ _ _ _ _ α hα f₀ hpr hcomap
    classical
    letI : Algebra A B := α.toAlgebra
    have hπm : α f₀ ∈ IsLocalRing.maximalIdeal B := by
      have h1 : f₀ ∈ (IsLocalRing.maximalIdeal B).comap α := by
        rw [hcomap]; exact Ideal.mem_span_singleton_self f₀
      exact h1
    apply le_antisymm
    · intro b hb
      obtain ⟨E, _, _, hE, β, e, hβ, he⟩ := wc_lpkt_indetale_factor A B α hα 1 (fun _ => b)
      set P := (IsLocalRing.maximalIdeal B).comap β with hPdef
      have hP : P.comap (algebraMap A E) = Ideal.span {f₀} := by
        rw [hPdef, Ideal.comap_comap, hβ, hcomap]
      have hunit : ∀ y : P.primeCompl, IsUnit (β y) := fun y =>
        IsLocalRing.notMem_maximalIdeal.mp y.2
      let β' : Localization.AtPrime P →+* B := IsLocalization.lift hunit
      have hβ'1 : β'.comp (algebraMap E (Localization.AtPrime P)) = β := IsLocalization.lift_comp hunit
      have hβ'e : ∀ x, β' (algebraMap E (Localization.AtPrime P) x) = β x := fun x => by
        rw [← RingHom.comp_apply, hβ'1]
      haveI : P.LiesOver (Ideal.span {f₀}) := ⟨by rw [Ideal.under_def, hP]⟩
      letI : Algebra (Localization.AtPrime (Ideal.span {f₀})) (Localization.AtPrime P) :=
        (Localization.localRingHom (Ideal.span {f₀}) P (algebraMap A E) hP.symm).toAlgebra
      haveI : IsScalarTower A (Localization.AtPrime (Ideal.span {f₀})) (Localization.AtPrime P) :=
        IsScalarTower.of_algebraMap_eq (fun x => by
          show _ = Localization.localRingHom (Ideal.span {f₀}) P (algebraMap A E) hP.symm
            (algebraMap A (Localization.AtPrime (Ideal.span {f₀})) x)
          rw [Localization.localRingHom_to_map,
            IsScalarTower.algebraMap_apply A E (Localization.AtPrime P)])
      have hmax : Ideal.map (algebraMap A (Localization.AtPrime P)) (Ideal.span {f₀}) =
          IsLocalRing.maximalIdeal (Localization.AtPrime P) :=
        ((Algebra.isUnramifiedAt_iff_map_eq A (Ideal.span {f₀}) P).mp inferInstance).2
      have hmaxg : IsLocalRing.maximalIdeal (Localization.AtPrime P) =
          Ideal.span {algebraMap A (Localization.AtPrime P) f₀} := by
        rw [← hmax, Ideal.map_span, Set.image_singleton]
      have hg : β' (algebraMap A (Localization.AtPrime P) f₀) = α f₀ := by
        rw [IsScalarTower.algebraMap_apply A E (Localization.AtPrime P), hβ'e,
          ← RingHom.comp_apply, hβ]
      have hP0 : e 0 ∈ P := by
        show β (e 0) ∈ IsLocalRing.maximalIdeal B
        rw [he 0]; exact hb
      have h1 := (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime P) P (e 0)).mpr hP0
      rw [hmaxg, Ideal.mem_span_singleton'] at h1
      obtain ⟨z, hz⟩ := h1
      rw [Ideal.mem_span_singleton']
      exact ⟨β' z, by rw [← hg, ← map_mul, hz, hβ'e, he 0]⟩
    · rw [Ideal.span_le, Set.singleton_subset_iff]; exact hπm
  have dev_L3 : ∀ (A : Type u) [CommRing A] (f : A) (hpr : (Ideal.span {f}).IsPrime),
      ∃ (V : Type u) (_ : CommRing V) (_ : HenselianLocalRing V) (σ : A →+* V),
      IsSepClosed (IsLocalRing.ResidueField V) ∧ wcIndEtale σ ∧
      (IsLocalRing.maximalIdeal V).comap σ = Ideal.span {f} := by
    intro A _ f hpr
    let κ := FractionRing (A ⧸ Ideal.span {f})
    let Ω := SeparableClosure κ
    let ι : A →+* Ω := (algebraMap κ Ω).comp
      ((algebraMap (A ⧸ Ideal.span {f}) κ).comp (Ideal.Quotient.mk (Ideal.span {f})))
    letI : Algebra A Ω := ι.toAlgebra
    haveI : HenselianLocalRing Ω := Field.henselian Ω
    have hbij : Function.Bijective (IsLocalRing.residue Ω) := by
      refine ⟨?_, IsLocalRing.residue_surjective⟩
      rw [injective_iff_map_eq_zero]
      intro x hx
      rw [IsLocalRing.residue_eq_zero_iff, IsLocalRing.maximalIdeal_eq_bot] at hx
      exact hx
    have hsep : IsSepClosed (IsLocalRing.ResidueField Ω) :=
      wc_henselian_sepClosed_transfer.2 Ω _ (RingEquiv.ofBijective _ hbij)
        (SeparableClosure.isSepClosed κ)
    obtain ⟨V, _, σ, ρ, _, hρσ, hhens, hsepV, hloc, hind⟩ := wc_strict_hull A Ω hsep
    refine ⟨V, inferInstance, hhens, σ, hsepV, hind, ?_⟩
    have hρ : (IsLocalRing.maximalIdeal Ω).comap ρ = IsLocalRing.maximalIdeal V :=
      ((IsLocalRing.local_hom_TFAE ρ).out 1 5).mp hloc
    rw [← hρ, IsLocalRing.maximalIdeal_eq_bot, Ideal.comap_comap, hρσ]
    ext x
    rw [Ideal.mem_comap, Ideal.mem_bot]
    show ι x = 0 ↔ _
    have hinj1 : Function.Injective (algebraMap κ Ω) := (algebraMap κ Ω).injective
    have hinj2 : Function.Injective (algebraMap (A ⧸ Ideal.span {f}) κ) :=
      IsFractionRing.injective _ _
    constructor
    · intro h
      have h1 : Ideal.Quotient.mk (Ideal.span {f}) x = 0 := by
        apply hinj2
        apply hinj1
        rw [map_zero, map_zero]
        exact h
      exact Ideal.Quotient.eq_zero_iff_mem.mp h1
    · intro h
      show (algebraMap κ Ω) ((algebraMap (A ⧸ Ideal.span {f}) κ) (Ideal.Quotient.mk _ x)) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr h, map_zero, map_zero]
  have dev_L5 : ∀ (H V HN VN D : Type u) [CommRing H] [CommRing V] [CommRing HN] [CommRing VN] [CommRing D]
    [Algebra H V] [Algebra H HN] [Algebra H D] [Algebra H VN] [Algebra V VN] [Algebra HN VN]
    [IsScalarTower H V VN] [IsScalarTower H HN VN] [IsNoetherianRing HN]
    (hind : wcIndEtale (algebraMap HN VN))
    (hEV : Algebra.Etale VN (integralClosure VN (TensorProduct V VN (TensorProduct H V D)))),
      Algebra.Etale VN (TensorProduct HN VN (integralClosure HN (TensorProduct H HN D))) := by
    intro H V HN VN D _ _ _ _ _ _ _ _ _ _ _ _ _ _ hind hEV
    obtain ⟨e1, -⟩ := wc_pub_integralClosure_indEtale_baseChange HN VN (TensorProduct H HN D) hind
    let k1 := Algebra.TensorProduct.cancelBaseChange H HN VN VN D
    let k2 := Algebra.TensorProduct.cancelBaseChange H V VN VN D
    let m := AlgEquiv.mapIntegralClosure (k1.trans k2.symm)
    haveI := hEV
    exact Algebra.Etale.of_equiv (R := VN) (A := integralClosure VN (TensorProduct V VN (TensorProduct H V D))) (e1.trans m).symm
  obtain ⟨-, hufd⟩ := wc_fco_regular_local_ufd H
  haveI : UniqueFactorizationMonoid H := hufd
  have hφ0 : φ ≠ 0 := by
    rintro rfl
    exact hφm2 (Ideal.zero_mem _)
  have hirrφ : Irreducible φ := by
    rw [irreducible_iff]
    refine ⟨fun hu => mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal φ).mp hφm) hu, ?_⟩
    intro a b hab
    by_contra h
    push_neg at h
    have ha : a ∈ IsLocalRing.maximalIdeal H :=
      (IsLocalRing.mem_maximalIdeal a).mpr (mem_nonunits_iff.mpr h.1)
    have hb : b ∈ IsLocalRing.maximalIdeal H :=
      (IsLocalRing.mem_maximalIdeal b).mpr (mem_nonunits_iff.mpr h.2)
    apply hφm2
    rw [hab, pow_two]
    exact Ideal.mul_mem_mul ha hb
  have hpr : (Ideal.span {φ}).IsPrime :=
    (Ideal.span_singleton_prime hφ0).mpr (UniqueFactorizationMonoid.irreducible_iff_prime.mp hirrφ)

  obtain ⟨V, _, _, σ, hsepV, hind, hcomapV⟩ := dev_L3 H φ hpr
  have hwe : @Algebra.WeaklyEtale H V _ _ σ.toAlgebra := wc_indEtale_weaklyEtale σ hind

  obtain ⟨hdomV, hdvrV, hinj⟩ := wc_pfam_ltd_wt_xi_dvr H V σ hwe φ hφ0 hpr hcomapV
  have hmV := dev_L1 H V σ hwe φ hpr hcomapV
  haveI := hdomV
  haveI := hdvrV
  letI : Algebra H V := σ.toAlgebra
  have hϖ0 : algebraMap H V φ ≠ 0 := fun h => hφ0 (hinj (by
    show σ φ = σ 0
    rw [map_zero]; exact h))
  have hmV' : IsLocalRing.maximalIdeal V = Ideal.span {algebraMap H V φ} := hmV
  have hirr : Irreducible (algebraMap H V φ) :=
    IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _ hϖ0 hmV'
  have hℓV : IsUnit ((ℓ : ℕ) : V) := by
    have := hℓ.map (algebraMap H V)
    rwa [map_natCast] at this
  have hc' : (Ideal.span {algebraMap H V φ}).comap (algebraMap H V) = Ideal.span {φ} := by
    rw [← hmV']
    exact hcomapV
  have hpV : (Ideal.span {algebraMap H V φ}).IsPrime := by
    rw [← hmV']
    exact (IsLocalRing.maximalIdeal.isMaximal V).isPrime

  obtain ⟨algF, towerF, hetF, hfinF⟩ := wc_pub_cover_baseChange H V D φ
  have hTF := wc_pub_tame_baseChange H V D φ ℓ hwe hc' hT

  obtain ⟨k, hEV⟩ := C3A V (algebraMap H V φ) hirr ℓ hℓV (TensorProduct H V D) hTF
  have hNpos : 0 < ℓ ^ k := pow_pos (Fact.out : Nat.Prime ℓ).pos k
  refine ⟨ℓ ^ k, ⟨k, rfl⟩, ?_⟩
  intro hθprime

  obtain ⟨τ, hτof, hτroot, hτind⟩ := dev_L2 H V hind φ (ℓ ^ k)
  letI : Algebra (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (algebraMap H V φ))) := τ.toAlgebra
  haveI : IsScalarTower H (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (algebraMap H V φ))) := IsScalarTower.of_algebraMap_eq (fun x => by
    show algebraMap H (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (algebraMap H V φ))) x = τ (algebraMap H (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) x)
    rw [AdjoinRoot.algebraMap_eq' H (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (algebraMap H V φ)),
      AdjoinRoot.algebraMap_eq (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)]
    exact (RingHom.congr_fun hτof x).symm)
  haveI : Module.Flat (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (algebraMap H V φ))) := (wc_indEtale_weaklyEtale τ hτind).flat

  obtain ⟨_, -, hregN, hdomN, -, -, -⟩ := wc_pas_kummer_cover_regular H φ hφm hφm2 (ℓ ^ k) hNpos
  haveI := hregN
  haveI := hdomN
  haveI : IsNoetherianRing (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) := inferInstance
  obtain ⟨-, hufdN⟩ := wc_fco_regular_local_ufd (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H))
  haveI := hufdN
  haveI : IsIntegrallyClosed (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) := inferInstance

  obtain ⟨algE, towerE, hetE, -⟩ := wc_pub_cover_baseChange H (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) D φ
  have hfin : Module.Finite (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) (integralClosure (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) (TensorProduct H (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) D)) := by
    refine wc_fnf_integralClosure_finite_of_etale_localization (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H))
      (Localization.Away (algebraMap H (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) φ)) (Submonoid.powers (algebraMap H (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) φ))
      (TensorProduct H (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) D) ?_
    intro A _ _ _ _ _
    exact wc_fnf_integralClosure_finite_of_etale_field (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) (FractionRing (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H))) A

  obtain ⟨hpθV, hθcomap⟩ := dev_L4 H V (algebraMap H V) φ (ℓ ^ k) hNpos τ hτof hτroot hc' hpV
  haveI := hpθV

  have hE := dev_L5 H V (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (algebraMap H V φ))) D hτind hEV

  have hloc := wc_cg2_etale_descent (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) (integralClosure (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) (TensorProduct H (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) D)) (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (algebraMap H V φ)))
    (Ideal.span {AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)})
    (Ideal.span {AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (algebraMap H V φ))})
    hθcomap hE
  exact wc_cfp_locEtale_tensor_transport (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) (integralClosure (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) (TensorProduct H (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) D))
    (integralClosure (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) (TensorProduct H (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) D))
    (Algebra.TensorProduct.lid (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) (integralClosure (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) (TensorProduct H (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C φ : Polynomial H)) D))) _ hloc

theorem wc_pks_phi_prime_eisenstein : ∀ (H : Type u) [CommRing H] [IsRegularLocalRing H] [IsDomain H] (φ : H), φ ∈ IsLocalRing.maximalIdeal H → φ ∉ IsLocalRing.maximalIdeal H ^ 2 → ∀ (N : ℕ), 0 < N → Prime φ ∧ Irreducible (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ)) :=
by
  intro H _ _ _ φ hφm hφm2 N hN
  classical
  obtain ⟨-, hufd⟩ := wc_fco_regular_local_ufd H
  haveI : UniqueFactorizationMonoid H := hufd
  have hφ0 : φ ≠ 0 := by
    rintro rfl
    exact hφm2 (Ideal.zero_mem _)
  have hirr : Irreducible φ := by
    refine Irreducible.mk ?_ ?_
    · exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal φ).mp hφm)
    · intro a b hab
      by_contra hcon
      push_neg at hcon
      have ha : a ∈ IsLocalRing.maximalIdeal H :=
        (IsLocalRing.mem_maximalIdeal a).mpr (mem_nonunits_iff.mpr hcon.1)
      have hb : b ∈ IsLocalRing.maximalIdeal H :=
        (IsLocalRing.mem_maximalIdeal b).mpr (mem_nonunits_iff.mpr hcon.2)
      apply hφm2
      rw [hab, pow_two]
      exact Ideal.mul_mem_mul ha hb
  have hprime : Prime φ := UniqueFactorizationMonoid.irreducible_iff_prime.mp hirr
  have hPprime : (Ideal.span {φ}).IsPrime := (Ideal.span_singleton_prime hφ0).mpr hprime
  have hPm : Ideal.span {φ} ≤ IsLocalRing.maximalIdeal H :=
    (Ideal.span_singleton_le_iff_mem _).mpr hφm
  have hP2 : Ideal.span {φ} ^ 2 ≤ IsLocalRing.maximalIdeal H ^ 2 := Ideal.pow_right_mono hPm 2
  have hN0 : N ≠ 0 := Nat.pos_iff_ne_zero.mp hN
  have hmonic : (Polynomial.X ^ N - Polynomial.C φ : Polynomial H).Monic :=
    Polynomial.monic_X_pow_sub_C φ hN0
  have hdeg : (Polynomial.X ^ N - Polynomial.C φ : Polynomial H).natDegree = N :=
    Polynomial.natDegree_X_pow_sub_C
  have heis : (Polynomial.X ^ N - Polynomial.C φ : Polynomial H).IsEisensteinAt
      (Ideal.span {φ}) := by
    refine ⟨?_, ?_, ?_⟩
    · rw [hmonic.leadingCoeff]
      exact (Ideal.ne_top_iff_one _).mp hPprime.ne_top
    · intro n hn
      rw [hdeg] at hn
      rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C, if_neg hn.ne]
      split_ifs with h0
      · rw [zero_sub]
        exact (Ideal.span {φ}).neg_mem (Ideal.mem_span_singleton_self φ)
      · rw [sub_zero]
        exact Ideal.zero_mem _
    · rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C, if_neg (Ne.symm hN0),
        if_pos rfl, zero_sub]
      intro h
      have h2 := (IsLocalRing.maximalIdeal H ^ 2).neg_mem (hP2 h)
      rw [neg_neg] at h2
      exact hφm2 h2
  have hirrH : Irreducible (Polynomial.X ^ N - Polynomial.C φ : Polynomial H) :=
    heis.irreducible hPprime hmonic.isPrimitive (by rw [hdeg]; exact hN)
  have hK := (hmonic.irreducible_iff_irreducible_map_fraction_map (K := FractionRing H)).mp hirrH
  refine ⟨hprime, ?_⟩
  simpa only [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C] using hK

theorem wc_pks_kummer_subfield_root_power : ∀ (K M : Type u) [Field K] [Field M] [Algebra K M] (N : ℕ), 0 < N → ∀ (ζ : K), IsPrimitiveRoot ζ N → ∀ (a : K) (θ : M), a ≠ 0 → θ ^ N = algebraMap K M a → (∀ c : Fin N → K, ∑ i, algebraMap K M (c i) * θ ^ (i : ℕ) = 0 → ∀ i, c i = 0) → (∀ x : M, ∃ c : Fin N → K, x = ∑ i, algebraMap K M (c i) * θ ^ (i : ℕ)) → ∀ (F : IntermediateField K M), θ ^ (Module.finrank F M) ∈ F ∧ Module.finrank K F * Module.finrank F M = N :=
by
  intro K M _ _ _ N hN ζ hζ a θ ha hθN hind hspan F
  classical

  have hli : LinearIndependent K (fun i : Fin N => θ ^ (i : ℕ)) := by
    rw [Fintype.linearIndependent_iff]
    intro g hg
    apply hind g
    rw [← hg]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Algebra.smul_def]
  have hsp : ⊤ ≤ Submodule.span K (Set.range (fun i : Fin N => θ ^ (i : ℕ))) := by
    intro x _
    obtain ⟨c, hc⟩ := hspan x
    rw [Submodule.mem_span_range_iff_exists_fun]
    refine ⟨c, ?_⟩
    rw [hc]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Algebra.smul_def]
  let b := Module.Basis.mk hli hsp
  have : FiniteDimensional K M := Module.Finite.of_basis b
  have hKM : Module.finrank K M = N := by
    rw [Module.finrank_eq_card_basis b, Fintype.card_fin]

  have hB : Module.finrank K F * Module.finrank F M = N := by
    rw [Module.finrank_mul_finrank K F M, hKM]
  refine ⟨?_, hB⟩

  have htop : IntermediateField.adjoin F ({θ} : Set M) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    obtain ⟨c, hc⟩ := hspan x
    rw [hc]
    refine sum_mem (fun i _ => mul_mem ?_
      (pow_mem (IntermediateField.mem_adjoin_simple_self F θ) _))
    rw [IsScalarTower.algebraMap_apply K F M]
    exact IntermediateField.algebraMap_mem _ _

  have : FiniteDimensional F M := FiniteDimensional.right K F M
  have hθint : IsIntegral F θ := IsIntegral.of_finite F θ
  have hdeg : (minpoly F θ).natDegree = Module.finrank F M := by
    rw [← IntermediateField.adjoin.finrank hθint, htop, IntermediateField.finrank_top']

  have hθ0 : θ ≠ 0 := by
    rintro rfl
    rw [zero_pow hN.ne'] at hθN
    exact ha ((map_eq_zero_iff _ (algebraMap K M).injective).mp hθN.symm)
  have hζM : IsPrimitiveRoot (algebraMap K M ζ) N :=
    hζ.map_of_injective (algebraMap K M).injective

  have hdvd : minpoly F θ ∣ Polynomial.X ^ N - Polynomial.C (algebraMap K F a) := by
    apply minpoly.dvd
    rw [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C,
      ← IsScalarTower.algebraMap_apply, ← hθN, sub_self]
  have hpdvd : (minpoly F θ).map (algebraMap F M) ∣
      Polynomial.X ^ N - Polynomial.C (θ ^ N) := by
    have := Polynomial.map_dvd (algebraMap F M) hdvd
    rwa [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C,
      ← IsScalarTower.algebraMap_apply, ← hθN] at this
  have hpmon : ((minpoly F θ).map (algebraMap F M)).Monic := (minpoly.monic hθint).map _
  have hpdeg : ((minpoly F θ).map (algebraMap F M)).natDegree = Module.finrank F M := by
    rw [(minpoly.monic hθint).natDegree_map, hdeg]

  have hq0 : (Polynomial.X ^ N - Polynomial.C (θ ^ N) : Polynomial M) ≠ 0 :=
    Polynomial.X_pow_sub_C_ne_zero hN _
  have hqs : (Polynomial.X ^ N - Polynomial.C (θ ^ N) : Polynomial M).Splits :=
    X_pow_sub_C_splits_of_isPrimitiveRoot hζM rfl
  have hps : ((minpoly F θ).map (algebraMap F M)).Splits :=
    Polynomial.Splits.of_dvd hqs hq0 hpdvd
  have hcard : ((minpoly F θ).map (algebraMap F M)).roots.card =
      ((minpoly F θ).map (algebraMap F M)).natDegree := hps.natDegree_eq_card_roots.symm
  have hprod := Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hpmon hcard
  have hcoeff : ((minpoly F θ).map (algebraMap F M)).coeff 0 =
      (-1) ^ ((minpoly F θ).map (algebraMap F M)).roots.card *
        ((minpoly F θ).map (algebraMap F M)).roots.prod := by
    conv_lhs => rw [← hprod]
    rw [Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_multiset_prod, Multiset.map_map]
    have : (Polynomial.eval 0 ∘ fun a => Polynomial.X - Polynomial.C a) = fun a : M => -a := by
      funext a; simp
    rw [this, Multiset.prod_map_neg]
  have : NeZero N := ⟨hN.ne'⟩
  have hroot : ∀ r ∈ ((minpoly F θ).map (algebraMap F M)).roots,
      ∃ i : ℕ, r = algebraMap K M ζ ^ i * θ := by
    intro r hr
    have hr' : r ∈ (Polynomial.X ^ N - Polynomial.C (θ ^ N) : Polynomial M).roots :=
      Multiset.mem_of_le (Polynomial.roots.le_of_dvd hq0 hpdvd) hr
    rw [Polynomial.mem_roots hq0, Polynomial.IsRoot.def] at hr'
    simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
      sub_eq_zero] at hr'
    have h1 : (r / θ) ^ N = 1 := by rw [div_pow, hr', div_self (pow_ne_zero _ hθ0)]
    obtain ⟨i, -, hi⟩ := hζM.eq_pow_of_pow_eq_one h1
    exact ⟨i, by rw [hi, div_mul_cancel₀ _ hθ0]⟩
  have hmult : ∀ s : Multiset M, (∀ r ∈ s, ∃ i : ℕ, r = algebraMap K M ζ ^ i * θ) →
      ∃ k : ℕ, s.prod = algebraMap K M ζ ^ k * θ ^ Multiset.card s := by
    intro s
    induction s using Multiset.induction_on with
    | empty => intro _; exact ⟨0, by simp⟩
    | cons r s ih =>
      intro h
      obtain ⟨k, hk⟩ := ih (fun x hx => h x (Multiset.mem_cons_of_mem hx))
      obtain ⟨i, hi⟩ := h r (Multiset.mem_cons_self r s)
      refine ⟨i + k, ?_⟩
      rw [Multiset.prod_cons, Multiset.card_cons, hk, hi]
      ring
  obtain ⟨k, hk⟩ := hmult _ hroot
  rw [hk, hcard, hpdeg, Polynomial.coeff_map] at hcoeff

  have hc0 : algebraMap F M ((minpoly F θ).coeff 0) ∈ F := SetLike.coe_mem _
  have hu0 : algebraMap K M ((-1) ^ Module.finrank F M * ζ ^ k) ≠ 0 := by
    rw [map_ne_zero]
    exact mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero))
      (pow_ne_zero _ (hζ.ne_zero hN.ne'))
  have key : algebraMap K M ((-1) ^ Module.finrank F M * ζ ^ k) * θ ^ Module.finrank F M =
      algebraMap F M ((minpoly F θ).coeff 0) := by
    rw [hcoeff, map_mul, map_pow, map_pow, map_neg, map_one]
    ring
  have hθf : θ ^ Module.finrank F M =
      (algebraMap K M ((-1) ^ Module.finrank F M * ζ ^ k))⁻¹ *
        algebraMap F M ((minpoly F θ).coeff 0) := by
    rw [← key, ← mul_assoc, inv_mul_cancel₀ hu0, one_mul]
  rw [hθf]
  exact mul_mem (inv_mem (IntermediateField.algebraMap_mem F _)) hc0

theorem wc_pks_subfield_coeff_support : ∀ (K M : Type u) [Field K] [Field M] [Algebra K M] (N : ℕ) (θ : M), 0 < N → (∀ c : Fin N → K, ∑ i, algebraMap K M (c i) * θ ^ (i : ℕ) = 0 → ∀ i, c i = 0) → (∀ x : M, ∃ c : Fin N → K, x = ∑ i, algebraMap K M (c i) * θ ^ (i : ℕ)) → ∀ (F : IntermediateField K M) (d e : ℕ), d * e = N → θ ^ d ∈ F → Module.finrank K F = e → ∀ x ∈ F, ∀ c : Fin N → K, x = ∑ i, algebraMap K M (c i) * θ ^ (i : ℕ) → ∀ i : Fin N, ¬ (d ∣ (i : ℕ)) → c i = 0 :=
by
  classical
  intro K M _ _ _ N θ hN hind _hspan F d e hde hθ hfr x hxF c hx i hi
  have hd : 0 < d := Nat.pos_of_ne_zero (by rintro rfl; simp at hde; omega)
  have he : 0 < e := Nat.pos_of_ne_zero (by rintro rfl; simp at hde; omega)
  have hlt : ∀ k : Fin e, d * (k : ℕ) < N := fun k => by
    rw [← hde]; exact Nat.mul_lt_mul_of_pos_left k.isLt hd
  set spread : (Fin e → K) → Fin N → K := fun g j =>
    ∑ k : Fin e, if (j : ℕ) = d * (k : ℕ) then g k else 0 with hspread
  have hA : ∀ g : Fin e → K, ∑ j : Fin N, algebraMap K M (spread g j) * θ ^ (j : ℕ) =
      ∑ k : Fin e, algebraMap K M (g k) * θ ^ (d * (k : ℕ)) := by
    intro g
    simp only [hspread, map_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [Finset.sum_eq_single ⟨d * k, hlt k⟩]
    · simp
    · intro j _ hj
      have : (j : ℕ) ≠ d * k := fun h => hj (Fin.ext h)
      simp [this]
    · intro h; exact absurd (Finset.mem_univ _) h
  have hB : ∀ g : Fin e → K, ∀ j : Fin N, ¬ d ∣ (j : ℕ) → spread g j = 0 := by
    intro g j hj
    apply Finset.sum_eq_zero
    intro k _
    rw [if_neg]
    rintro h; exact hj ⟨k, h⟩
  have hC : ∀ g : Fin e → K, ∀ k : Fin e, spread g ⟨d * k, hlt k⟩ = g k := by
    intro g k
    simp only [hspread]
    rw [Finset.sum_eq_single k]
    · simp
    · intro k' _ hk'
      rw [if_neg]
      intro h
      apply hk'
      exact Fin.ext (Nat.eq_of_mul_eq_mul_left hd h).symm
    · intro h; exact absurd (Finset.mem_univ _) h
  have hmem : ∀ k : Fin e, θ ^ (d * (k : ℕ)) ∈ F := fun k => by
    rw [pow_mul]; exact pow_mem hθ _
  let v : Fin e → F := fun k => ⟨θ ^ (d * (k : ℕ)), hmem k⟩
  have hcoe : ∀ g : Fin e → K, ((∑ k, g k • v k : F) : M) =
      ∑ k, algebraMap K M (g k) * θ ^ (d * (k : ℕ)) := by
    intro g
    rw [IntermediateField.coe_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [IntermediateField.coe_smul, Algebra.smul_def]
  have hli : LinearIndependent K v := by
    rw [Fintype.linearIndependent_iff]
    intro g hg k
    have h1 : ∑ j : Fin N, algebraMap K M (spread g j) * θ ^ (j : ℕ) = 0 := by
      rw [hA, ← hcoe, hg]
      rfl
    have := hind _ h1 ⟨d * k, hlt k⟩
    rwa [hC] at this
  haveI : Nonempty (Fin e) := ⟨⟨0, he⟩⟩
  have hspanv : Submodule.span K (Set.range v) = ⊤ :=
    hli.span_eq_top_of_card_eq_finrank (by rw [Fintype.card_fin, hfr])
  have hxmem : (⟨x, hxF⟩ : F) ∈ Submodule.span K (Set.range v) := by
    rw [hspanv]; trivial
  obtain ⟨b, hb⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hxmem
  have hx' : x = ∑ j : Fin N, algebraMap K M (spread b j) * θ ^ (j : ℕ) := by
    rw [hA, ← hcoe, hb]
  have hdiff : ∑ j : Fin N, algebraMap K M (c j - spread b j) * θ ^ (j : ℕ) = 0 := by
    simp only [map_sub, sub_mul, Finset.sum_sub_distrib]
    rw [← hx, ← hx', sub_self]
  have h2 := hind _ hdiff i
  rw [sub_eq_zero] at h2
  rw [h2, hB b i hi]

theorem wc_pks_kummer_coeff_integral : ∀ (H : Type u) [CommRing H] [IsDomain H] (φ : H) (N : ℕ), 0 < N → IsUnit ((N : ℕ) : H) → ∀ (ζ : H), IsPrimitiveRoot ζ N → ∀ (c : Fin N → FractionRing H), IsIntegral H (∑ i, algebraMap (FractionRing H) (AdjoinRoot (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ))) (c i) * AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ)) ^ (i : ℕ)) → ∀ i : Fin N, IsIntegral H (c i ^ N * algebraMap H (FractionRing H) φ ^ (i : ℕ)) :=
by
  intro H _ _ φ N hN hNu ζ hζ
  classical

  have main : ∀ (K : Type u) [Field K] [Algebra H K] (M : Type u) [CommRing M] [Algebra K M]
      [Algebra H M] [IsScalarTower H K M] (θ : M) (a : K),
      Function.Injective (algebraMap K M) → θ ^ N = algebraMap K M a →
      IsPrimitiveRoot (algebraMap H K ζ) N →
      (∀ k : ℕ, ∃ σ : M →ₐ[K] M, σ θ = algebraMap K M (algebraMap H K ζ) ^ k * θ) →
      ∀ c : Fin N → K, IsIntegral H (∑ i, algebraMap K M (c i) * θ ^ (i : ℕ)) →
      ∀ i : Fin N, IsIntegral H (c i ^ N * a ^ (i : ℕ)) := by
    intro K _ _ M _ _ _ _ θ a hinj hθN hζK hσ c hx i
    choose σ hσ' using hσ
    have hσx : ∀ k, σ k (∑ i, algebraMap K M (c i) * θ ^ (i : ℕ)) =
        ∑ j : Fin N, algebraMap K M (c j) *
          (algebraMap K M (algebraMap H K ζ) ^ k * θ) ^ (j : ℕ) := by
      intro k
      rw [map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_mul, map_pow, AlgHom.commutes, hσ']
    have hσint : ∀ k, IsIntegral H (σ k (∑ i, algebraMap K M (c i) * θ ^ (i : ℕ))) :=
      fun k => hx.map (σ k)

    have orth : ∀ j : Fin N, ∑ k ∈ Finset.range N,
        algebraMap H K ζ ^ (k * (N - (i : ℕ) + (j : ℕ))) = if j = i then (N : K) else 0 := by
      intro j
      have hw : ∀ k : ℕ, algebraMap H K ζ ^ (k * (N - (i : ℕ) + (j : ℕ))) =
          (algebraMap H K ζ ^ (N - (i : ℕ) + (j : ℕ))) ^ k := fun k => by
        rw [← pow_mul, mul_comm]
      simp_rw [hw]
      have hi := i.isLt
      have hj := j.isLt
      split_ifs with hji
      · subst hji
        have e : N - (j : ℕ) + (j : ℕ) = N := by omega
        rw [e, hζK.pow_eq_one]
        simp
      · have hij : (i : ℕ) ≠ (j : ℕ) := fun h => hji (Fin.ext h.symm)
        have hne : algebraMap H K ζ ^ (N - (i : ℕ) + (j : ℕ)) ≠ 1 := by
          rw [Ne, hζK.pow_eq_one_iff_dvd]
          rintro ⟨t, ht⟩
          have ht2 : t < 2 := by
            by_contra h
            have h' : 2 ≤ t := by omega
            have : N * 2 ≤ N * t := Nat.mul_le_mul_left N h'
            omega
          interval_cases t <;> omega
        have hpow : (algebraMap H K ζ ^ (N - (i : ℕ) + (j : ℕ))) ^ N = 1 := by
          rw [← pow_mul, mul_comm, pow_mul, hζK.pow_eq_one, one_pow]
        have hg := geom_sum_mul (algebraMap H K ζ ^ (N - (i : ℕ) + (j : ℕ))) N
        rw [hpow, sub_self] at hg
        exact (mul_eq_zero.mp hg).resolve_right (sub_ne_zero.mpr hne)

    have hy : ∑ k ∈ Finset.range N, algebraMap K M (algebraMap H K ζ ^ (k * (N - (i : ℕ)))) *
        σ k (∑ i, algebraMap K M (c i) * θ ^ (i : ℕ)) =
        algebraMap K M ((N : K) * c i) * θ ^ (i : ℕ) := by
      simp_rw [hσx, Finset.mul_sum]
      rw [Finset.sum_comm]
      have e : ∀ j : Fin N, ∑ k ∈ Finset.range N,
          algebraMap K M (algebraMap H K ζ ^ (k * (N - (i : ℕ)))) *
            (algebraMap K M (c j) * (algebraMap K M (algebraMap H K ζ) ^ k * θ) ^ (j : ℕ)) =
          algebraMap K M ((∑ k ∈ Finset.range N,
            algebraMap H K ζ ^ (k * (N - (i : ℕ) + (j : ℕ)))) * c j) * θ ^ (j : ℕ) := by
        intro j
        rw [Finset.sum_mul, map_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        simp only [map_mul, map_pow]
        ring
      rw [Finset.sum_congr rfl (fun j _ => e j)]
      simp_rw [orth]
      rw [Finset.sum_eq_single i]
      · simp
      · intro j _ hj
        rw [if_neg hj]
        simp
      · intro h
        exact absurd (Finset.mem_univ i) h
    have hyint : IsIntegral H (∑ k ∈ Finset.range N,
        algebraMap K M (algebraMap H K ζ ^ (k * (N - (i : ℕ)))) *
        σ k (∑ i, algebraMap K M (c i) * θ ^ (i : ℕ))) := by
      refine IsIntegral.sum _ (fun k _ => IsIntegral.mul ?_ (hσint k))
      rw [← map_pow, ← IsScalarTower.algebraMap_apply]
      exact isIntegral_algebraMap
    rw [hy] at hyint

    obtain ⟨u, hu⟩ := hNu
    have h1 : algebraMap H K ↑u⁻¹ * (N : K) = 1 := by
      rw [← map_natCast (algebraMap H K) N, ← map_mul, ← hu, Units.inv_mul, map_one]
    have hz : algebraMap K M (c i) * θ ^ (i : ℕ) =
        algebraMap H M ↑u⁻¹ * (algebraMap K M ((N : K) * c i) * θ ^ (i : ℕ)) := by
      rw [IsScalarTower.algebraMap_apply H K M, ← mul_assoc, ← map_mul, ← mul_assoc, h1, one_mul]
    have hzint : IsIntegral H (algebraMap K M (c i) * θ ^ (i : ℕ)) := by
      rw [hz]
      exact isIntegral_algebraMap.mul hyint
    have hzN : (algebraMap K M (c i) * θ ^ (i : ℕ)) ^ N =
        algebraMap K M (c i ^ N * a ^ (i : ℕ)) := by
      rw [mul_pow, ← pow_mul, mul_comm (i : ℕ) N, pow_mul, hθN, map_mul, map_pow, map_pow]
    have hfin := hzint.pow N
    rw [hzN] at hfin
    exact (isIntegral_algHom_iff (IsScalarTower.toAlgHom H K M) hinj).mp hfin
  intro c hx i
  have hζK : IsPrimitiveRoot (algebraMap H (FractionRing H) ζ) N :=
    hζ.map_of_injective (IsFractionRing.injective H (FractionRing H))
  have hθN : AdjoinRoot.root (Polynomial.X ^ N -
      Polynomial.C (algebraMap H (FractionRing H) φ)) ^ N =
      algebraMap (FractionRing H) (AdjoinRoot (Polynomial.X ^ N -
        Polynomial.C (algebraMap H (FractionRing H) φ))) (algebraMap H (FractionRing H) φ) := by
    have h0 := AdjoinRoot.mk_self (f := Polynomial.X ^ N -
      Polynomial.C (algebraMap H (FractionRing H) φ))
    rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h0
    rw [AdjoinRoot.algebraMap_eq]
    exact h0
  have hinj : Function.Injective (algebraMap (FractionRing H) (AdjoinRoot (Polynomial.X ^ N -
      Polynomial.C (algebraMap H (FractionRing H) φ)))) := by
    rw [AdjoinRoot.algebraMap_eq]
    apply AdjoinRoot.of.injective_of_degree_ne_zero
    rw [Polynomial.degree_X_pow_sub_C hN]
    exact_mod_cast hN.ne'
  refine main (FractionRing H) (AdjoinRoot (Polynomial.X ^ N -
      Polynomial.C (algebraMap H (FractionRing H) φ))) _ _ hinj hθN hζK ?_ c hx i
  intro k
  refine ⟨AdjoinRoot.liftAlgHom _ (Algebra.ofId _ _)
    (algebraMap (FractionRing H) (AdjoinRoot (Polynomial.X ^ N -
      Polynomial.C (algebraMap H (FractionRing H) φ))) (algebraMap H (FractionRing H) ζ) ^ k *
      AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ))) ?_,
    AdjoinRoot.liftAlgHom_root _ _ _ _⟩
  rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, mul_pow, ← pow_mul,
    mul_comm k N, pow_mul, ← map_pow, hζK.pow_eq_one, map_one, one_pow, one_mul, hθN, sub_eq_zero]
  rfl

theorem wc_pks_root_denominator_free : ∀ (H : Type u) [CommRing H] [IsDomain H] [UniqueFactorizationMonoid H] (φ : H), Prime φ → ∀ (N i : ℕ), i < N → ∀ c : FractionRing H, IsIntegral H (c ^ N * algebraMap H (FractionRing H) φ ^ i) → ∃ h : H, algebraMap H (FractionRing H) h = c :=
by
  intro H _ _ _ φ hφ N i hiN c hc
  have hN : 0 < N := by omega
  obtain ⟨k, hNk, hk1⟩ : ∃ k, N = i + k ∧ 1 ≤ k := ⟨N - i, by omega, by omega⟩
  have hinj := IsFractionRing.injective H (FractionRing H)
  have hφ0 : φ ≠ 0 := hφ.ne_zero
  have hp0 : algebraMap H (FractionRing H) φ ≠ 0 := by
    intro h
    apply hφ0
    apply hinj
    rw [map_zero]
    exact h
  obtain ⟨α, hα⟩ := (IsIntegrallyClosed.isIntegral_iff (R := H) (K := FractionRing H)).mp hc
  have hbN : (c * algebraMap H (FractionRing H) φ) ^ N =
      (c ^ N * algebraMap H (FractionRing H) φ ^ i) * algebraMap H (FractionRing H) φ ^ k := by
    rw [hNk]
    ring
  have hbint : IsIntegral H ((c * algebraMap H (FractionRing H) φ) ^ N) := by
    rw [hbN]
    exact hc.mul ((isIntegral_algebraMap (x := φ)).pow k)
  have hb : IsIntegral H (c * algebraMap H (FractionRing H) φ) := IsIntegral.of_pow hN hbint
  obtain ⟨β, hβ⟩ := (IsIntegrallyClosed.isIntegral_iff (R := H) (K := FractionRing H)).mp hb
  have hβN : β ^ N = α * φ ^ k := by
    apply hinj
    simp only [map_pow, map_mul]
    rw [hβ, hα, hbN]
  have hφβ : φ ∣ β := by
    apply hφ.dvd_of_dvd_pow (n := N)
    rw [hβN]
    exact dvd_mul_of_dvd_right (dvd_pow_self φ (by omega)) α
  obtain ⟨γ, rfl⟩ := hφβ
  refine ⟨γ, ?_⟩
  rw [map_mul] at hβ
  exact mul_left_cancel₀ hp0 (hβ.trans (mul_comm c _))

theorem wc_pks_localized_cover_embedding : ∀ (H : Type u) [CommRing H] [IsDomain H] (φ : H) (N : ℕ), 0 < N → ∀ (M : Type u) [CommRing M] [Algebra H M] (θ : M), θ ^ N = algebraMap H M φ → IsUnit (algebraMap H M φ) → (∀ h : Fin N → H, ∑ i, algebraMap H M (h i) * θ ^ (i : ℕ) = 0 → ∀ i, h i = 0) → ∃ ι : Localization.Away (algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) φ) →ₐ[H] M, Function.Injective ι ∧ ι (algebraMap (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) (Localization.Away (algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) φ)) (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C φ))) = θ :=
by
  intro H _ _ φ N hN M _ _ θ hθ hu hind
  set f : Polynomial H := Polynomial.X ^ N - Polynomial.C φ with hfdef
  have hmon : f.Monic := Polynomial.monic_X_pow_sub_C φ hN.ne'
  have hdeg : f.natDegree = N := Polynomial.natDegree_X_pow_sub_C
  have hne1 : f ≠ 1 := by
    intro h
    have := congrArg Polynomial.natDegree h
    rw [hdeg, Polynomial.natDegree_one] at this
    omega
  have hf : Polynomial.eval₂ ((Algebra.ofId H M : H →ₐ[H] M) : H →+* M) θ f = 0 := by
    rw [show ((Algebra.ofId H M : H →ₐ[H] M) : H →+* M) = algebraMap H M from rfl]
    simp [hfdef, hθ]
  let g : AdjoinRoot f →ₐ[H] M := AdjoinRoot.liftAlgHom f (Algebra.ofId H M) θ hf
  have hgr : g (AdjoinRoot.root f) = θ := by
    simp [g]
  have hgmk : ∀ q : Polynomial H, g (AdjoinRoot.mk f q) = Polynomial.aeval θ q := by
    intro q
    rw [← AdjoinRoot.aeval_eq, ← Polynomial.aeval_algHom_apply, hgr]
  have hginj : Function.Injective g := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective a
    have hpq : AdjoinRoot.mk f p = AdjoinRoot.mk f (p %ₘ f) := by
      conv_lhs => rw [← Polynomial.modByMonic_add_div p f]
      rw [map_add, map_mul, AdjoinRoot.mk_self, zero_mul, add_zero]
    rw [hpq] at ha ⊢
    set q := p %ₘ f with hqdef
    have hqdeg : q.natDegree < N := hdeg ▸ Polynomial.natDegree_modByMonic_lt p hmon hne1
    rw [hgmk, Polynomial.aeval_eq_sum_range' hqdeg] at ha
    have hsum : ∑ i : Fin N, algebraMap H M (q.coeff i) * θ ^ (i : ℕ) = 0 := by
      refine Eq.trans ?_ ha
      rw [Finset.sum_range]
      simp only [Algebra.smul_def]
    have hcoef := hind (fun i => q.coeff i) hsum
    have hq0 : q = 0 := by
      ext i
      rw [Polynomial.coeff_zero]
      by_cases hi : i < N
      · exact hcoef ⟨i, hi⟩
      · exact Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
    rw [hq0, map_zero]
  set s := algebraMap H (AdjoinRoot f) φ with hs
  have hgs : g s = algebraMap H M φ := g.commutes φ
  have hy : ∀ y : Submonoid.powers s, IsUnit (g y) := by
    rintro ⟨y, n, rfl⟩
    simp only [map_pow, hgs]
    exact hu.pow n
  let ι : Localization.Away s →ₐ[H] M := IsLocalization.liftAlgHom (M := Submonoid.powers s) hy
  have hιa : ∀ a, ι (algebraMap (AdjoinRoot f) (Localization.Away s) a) = g a := by
    intro a
    rw [IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
    rfl
  refine ⟨ι, ?_, (hιa _).trans hgr⟩
  rw [injective_iff_map_eq_zero]
  intro z hz
  obtain ⟨n, a, hzn⟩ := IsLocalization.Away.surj s z
  have h1 := congrArg ι hzn
  rw [map_mul, hz, zero_mul, hιa] at h1
  have ha0 : a = 0 := hginj (by rw [← h1, map_zero])
  rw [ha0, map_zero] at hzn
  have hunit : IsUnit (algebraMap (AdjoinRoot f) (Localization.Away s) s ^ n) :=
    (IsLocalization.Away.algebraMap_isUnit s).pow n
  exact hunit.mul_left_eq_zero.mp hzn

theorem wc_pks_integral_root_descent : ∀ (H D M : Type u) [CommRing H] [IsDomain H] [CommRing D] [IsDomain D] [IsIntegrallyClosed D] [Field M] [Algebra H D] [Algebra H M] [Algebra (FractionRing H) M] [IsScalarTower H (FractionRing H) M] [FiniteDimensional (FractionRing H) M] (j : D →ₐ[H] M), Function.Injective j → ∀ (z : M) (e : ℕ) (a : H), 0 < e → z ^ e = algebraMap H M a → z ∈ IntermediateField.adjoin (FractionRing H) (Set.range j) → ∃ d₀ : D, j d₀ = z :=
by
  intro H D M _ _ _ _ _ _ _ _ _ _ _ j hj z e a he hze hz
  classical
  have hg : Function.Injective (j : D →+* M) := hj
  let jh : FractionRing D →+* M :=
    IsFractionRing.lift (A := D) (K := FractionRing D) (L := M) hg
  have s1 : ∀ d : D, jh (algebraMap D (FractionRing D) d) = j d := fun d =>
    IsFractionRing.lift_algebraMap hg d
  have s2 : Function.Injective jh := jh.injective
  have s3 : ∀ h : H, j (algebraMap H D h) = algebraMap H M h := fun h => j.commutes h
  have s4 : ∀ k : FractionRing H, algebraMap (FractionRing H) M k ∈ jh.fieldRange := by
    intro k
    obtain ⟨a', s', -, rfl⟩ := IsFractionRing.div_surjective (A := H) k
    refine ⟨algebraMap D (FractionRing D) (algebraMap H D a') /
      algebraMap D (FractionRing D) (algebraMap H D s'), ?_⟩
    rw [map_div₀, map_div₀, s1, s1, s3, s3, ← IsScalarTower.algebraMap_apply,
      ← IsScalarTower.algebraMap_apply]
  let S : IntermediateField (FractionRing H) M := Subfield.toIntermediateField jh.fieldRange s4
  have s5 : Set.range j ⊆ (S : Set M) := by
    rintro _ ⟨d, rfl⟩
    exact ⟨algebraMap D (FractionRing D) d, s1 d⟩
  have s6 : z ∈ S := (IntermediateField.adjoin_le_iff.mpr s5) hz
  obtain ⟨y, hy⟩ : z ∈ jh.fieldRange := s6
  have s7 : y ^ e = algebraMap D (FractionRing D) (algebraMap H D a) := by
    apply s2
    rw [map_pow, hy, hze, s1, s3]
  have s8 : IsIntegral D y := by
    refine ⟨Polynomial.X ^ e - Polynomial.C (algebraMap H D a),
      Polynomial.monic_X_pow_sub_C _ he.ne', ?_⟩
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, s7, sub_self]
  obtain ⟨d₀, hd₀⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral s8
  exact ⟨d₀, by rw [← s1, hd₀, hy]⟩

theorem wc_pks_integralClosure_identify : ∀ (H K M D : Type u) [CommRing H] [IsDomain H] [Field K] [CommRing M] [CommRing D] [Algebra H K] [Algebra K M] [Algebra H M] [IsScalarTower H K M] [Algebra H D] (φ : H) (θ : M) (N g e : ℕ), 0 < g → 0 < e → g * e = N → θ ^ N = algebraMap H M φ → Function.Injective (algebraMap H K) → (∀ c : Fin N → K, ∑ i, algebraMap K M (c i) * θ ^ (i : ℕ) = 0 → ∀ i, c i = 0) → (∀ b : M, ∃ c : Fin N → K, b = ∑ i, algebraMap K M (c i) * θ ^ (i : ℕ)) → (∀ c : Fin N → K, IsIntegral H (∑ i, algebraMap K M (c i) * θ ^ (i : ℕ)) → ∀ i, ∃ h : H, algebraMap H K h = c i) → ∀ (j : D →ₐ[H] M), Function.Injective j → ∀ d₀ : D, j d₀ = θ ^ g → (∀ (d : D) (c : Fin N → K), j d = ∑ i, algebraMap K M (c i) * θ ^ (i : ℕ) → ∀ i : Fin N, ¬ (g ∣ (i : ℕ)) → c i = 0) → Nonempty (integralClosure H D ≃ₐ[H] AdjoinRoot (Polynomial.X ^ e - Polynomial.C φ)) :=
by
  intro H K M D _ _ _ _ _ _ _ _ _ _ φ θ N g e hg he hge hθN hHK hind hspan hint j hj d₀ hd₀ hsupp
  classical

  have reindex : ∀ F : ℕ → M, (∀ i, i < N → ¬ (g ∣ i) → F i = 0) →
      ∑ i : Fin N, F (i : ℕ) = ∑ k : Fin e, F (g * (k : ℕ)) := by
    intro F hF
    rw [Fin.sum_univ_eq_sum_range F N, Fin.sum_univ_eq_sum_range (fun k => F (g * k)) e]
    have hinjm : Set.InjOn (fun k => g * k) ↑(Finset.range e) := by
      intro a _ b _ hab
      exact Nat.eq_of_mul_eq_mul_left hg hab
    have h1 : ∑ x ∈ (Finset.range e).image (fun k => g * k), F x =
        ∑ k ∈ Finset.range e, F (g * k) := Finset.sum_image hinjm
    rw [← h1]
    symm
    apply Finset.sum_subset
    · intro i hi
      rw [Finset.mem_image] at hi
      obtain ⟨k, hk, rfl⟩ := hi
      rw [Finset.mem_range] at hk ⊢
      rw [← hge]
      exact (Nat.mul_lt_mul_left hg).mpr hk
    · intro i hi hni
      rw [Finset.mem_range] at hi
      apply hF i hi
      rintro ⟨q, rfl⟩
      apply hni
      rw [Finset.mem_image]
      refine ⟨q, ?_, rfl⟩
      rw [Finset.mem_range]
      rw [← hge] at hi
      exact (Nat.mul_lt_mul_left hg).mp hi
  have hlt : ∀ k : Fin e, g * (k : ℕ) < N := fun k => by
    rw [← hge]; exact (Nat.mul_lt_mul_left hg).mpr k.isLt
  have reindex' : ∀ f : Fin N → M, (∀ i : Fin N, ¬ g ∣ (i : ℕ) → f i = 0) →
      ∑ i, f i = ∑ k : Fin e, f ⟨g * k, hlt k⟩ := by
    intro f hf
    have h2 := reindex (fun i => if hi : i < N then f ⟨i, hi⟩ else 0)
      (fun i hi hgi => by simp only [dif_pos hi]; exact hf _ hgi)
    simp only [Fin.is_lt, dif_pos, Fin.eta, hlt] at h2
    exact h2

  have hd0e : d₀ ^ e = algebraMap H D φ := by
    apply hj
    rw [map_pow, hd₀, ← pow_mul, hge, hθN, AlgHom.commutes]
  have hmon : (Polynomial.X ^ e - Polynomial.C φ : Polynomial H).Monic :=
    Polynomial.monic_X_pow_sub_C φ he.ne'

  have hev : Polynomial.eval₂ (Algebra.ofId H D : H →+* D) d₀
      (Polynomial.X ^ e - Polynomial.C φ) = 0 := by
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hd0e]
    simp
  obtain ⟨α, hαroot⟩ : ∃ α : AdjoinRoot (Polynomial.X ^ e - Polynomial.C φ) →ₐ[H] D,
      α (AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C φ)) = d₀ :=
    ⟨AdjoinRoot.liftAlgHom _ (Algebra.ofId H D) d₀ hev, AdjoinRoot.liftAlgHom_root _ _ _ hev⟩

  haveI : Module.Finite H (AdjoinRoot (Polynomial.X ^ e - Polynomial.C φ)) :=
    (AdjoinRoot.powerBasis' hmon).finite
  haveI : Algebra.IsIntegral H (AdjoinRoot (Polynomial.X ^ e - Polynomial.C φ)) :=
    Algebra.IsIntegral.of_finite H _
  have hαint : ∀ x, α x ∈ integralClosure H D := fun x =>
    (mem_integralClosure_iff H D).mpr ((Algebra.IsIntegral.isIntegral (R := H) x).map α)
  let α' := α.codRestrict (integralClosure H D) hαint
  have hcoord : ∀ x : AdjoinRoot (Polynomial.X ^ e - Polynomial.C φ), ∃ c : Fin e → H,
      x = ∑ i, algebraMap H (AdjoinRoot (Polynomial.X ^ e - Polynomial.C φ)) (c i) *
        AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C φ) ^ (i : ℕ) := by
    have hdim : (AdjoinRoot.powerBasis' hmon).dim = e := by
      rw [AdjoinRoot.powerBasis'_dim, Polynomial.natDegree_X_pow_sub_C]
    let b := (AdjoinRoot.powerBasis' hmon).basis.reindex (finCongr hdim)
    have hb : ∀ i : Fin e,
        b i = AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C φ) ^ (i : ℕ) := by
      intro i
      simp only [b, Module.Basis.reindex_apply, PowerBasis.coe_basis, AdjoinRoot.powerBasis'_gen]
      rfl
    intro x
    refine ⟨fun i => b.repr x i, ?_⟩
    have T : ∑ i, b.repr x i • b i =
        ∑ i, algebraMap H (AdjoinRoot (Polynomial.X ^ e - Polynomial.C φ)) (b.repr x i) *
          AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C φ) ^ (i : ℕ) := by
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Algebra.smul_def, hb]
    rw [← T]
    exact (b.sum_repr x).symm

  have key : ∀ h : Fin e → H, j (α (∑ k, algebraMap H (AdjoinRoot (Polynomial.X ^ e -
      Polynomial.C φ)) (h k) * AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C φ) ^ (k : ℕ))) =
      ∑ k, algebraMap H M (h k) * θ ^ (g * (k : ℕ)) := by
    intro h
    rw [map_sum, map_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [map_mul, map_mul, map_pow, map_pow, AlgHom.commutes, AlgHom.commutes, hαroot, hd₀,
      pow_mul]

  have hinj : Function.Injective α' := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    have hx' : α x = 0 := by
      have h3 := congrArg Subtype.val hx
      rw [AlgHom.coe_codRestrict] at h3
      simpa using h3
    obtain ⟨h, rfl⟩ := hcoord x
    have h0 : ∑ k, algebraMap H M (h k) * θ ^ (g * (k : ℕ)) = 0 := by
      rw [← key, hx', map_zero]
    let hN : ℕ → H := fun q => if hq : q < e then h ⟨q, hq⟩ else 0
    let c : Fin N → K := fun i => if g ∣ (i : ℕ) then algebraMap H K (hN ((i : ℕ) / g)) else 0
    have hck : ∀ k : Fin e, c ⟨g * k, hlt k⟩ = algebraMap H K (h k) := by
      intro k
      show (if g ∣ g * (k : ℕ) then algebraMap H K (hN (g * (k : ℕ) / g)) else 0) = _
      rw [if_pos (dvd_mul_right g k), Nat.mul_div_cancel_left _ hg]
      show algebraMap H K (if hq : (k : ℕ) < e then h ⟨k, hq⟩ else 0) = _
      rw [dif_pos k.isLt]
    have hcsum : ∑ i, algebraMap K M (c i) * θ ^ (i : ℕ) = 0 := by
      have e1 := reindex' (fun i => algebraMap K M (c i) * θ ^ (i : ℕ)) (fun i hi => by
        show algebraMap K M (if g ∣ (i : ℕ) then algebraMap H K (hN ((i : ℕ) / g)) else 0) *
          θ ^ (i : ℕ) = 0
        rw [if_neg hi, map_zero, zero_mul])
      beta_reduce at e1
      rw [e1, ← h0]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [hck k, ← IsScalarTower.algebraMap_apply]
    have hc0 := hind c hcsum
    have hh : ∀ k, h k = 0 := fun k => hHK (by rw [map_zero, ← hck k]; exact hc0 _)
    simp [hh]

  have hsurj : Function.Surjective α' := by
    rintro ⟨y, hy⟩
    obtain ⟨c, hc⟩ := hspan (j y)
    have hyint : IsIntegral H (j y) := ((mem_integralClosure_iff H D).mp hy).map j
    rw [hc] at hyint
    choose hc' hhc' using hint c hyint
    have hs := hsupp y c hc
    refine ⟨∑ k : Fin e, algebraMap H (AdjoinRoot (Polynomial.X ^ e - Polynomial.C φ))
      (hc' ⟨g * k, hlt k⟩) * AdjoinRoot.root (Polynomial.X ^ e - Polynomial.C φ) ^ (k : ℕ), ?_⟩
    apply Subtype.ext
    rw [AlgHom.coe_codRestrict]
    apply hj
    have e1 := reindex' (fun i => algebraMap K M (c i) * θ ^ (i : ℕ)) (fun i hi => by
      show algebraMap K M (c i) * θ ^ (i : ℕ) = 0
      rw [hs i hi, map_zero, zero_mul])
    beta_reduce at e1
    rw [key, hc, e1]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [← hhc', ← IsScalarTower.algebraMap_apply]
  exact ⟨(AlgEquiv.ofBijective α' ⟨hinj, hsurj⟩).symm⟩

theorem wc_pks_finite_domain_hom_injective : ∀ (H : Type u) [CommRing H] (φ : H) (D M : Type u) [CommRing D] [IsDomain D] [CommRing M] [IsDomain M] [Algebra H D] [Algebra (Localization.Away φ) D] [IsScalarTower H (Localization.Away φ) D] [Module.Finite (Localization.Away φ) D] [Nontrivial (Localization.Away φ)] (j : D →+* M), Function.Injective (j.comp (algebraMap H D)) → Function.Injective j :=
by
  intro H _ φ D M _ _ _ _ _ _ _ _ _ j hinj
  rw [injective_iff_map_eq_zero]
  intro x hx
  by_contra hx0
  haveI : Algebra.IsIntegral (Localization.Away φ) D := Algebra.IsIntegral.of_finite _ _
  have hint : IsIntegral (Localization.Away φ) x := Algebra.IsIntegral.isIntegral x
  have hne : Ideal.under (Localization.Away φ) (RingHom.ker j) ≠ ⊥ :=
    Ideal.under_ne_bot_of_integral_mem hx0 (RingHom.mem_ker.mpr hx) hint
  obtain ⟨y, hy, hy0⟩ := (Submodule.ne_bot_iff _).mp hne
  have hy' : j (algebraMap (Localization.Away φ) D y) = 0 := hy
  obtain ⟨⟨a, s⟩, hs0⟩ := IsLocalization.surj (Submonoid.powers φ) y
  have hu : IsUnit (algebraMap H (Localization.Away φ) (s : H)) :=
    IsLocalization.map_units (Localization.Away φ) s
  have hs : y * algebraMap H (Localization.Away φ) (s : H) =
      algebraMap H (Localization.Away φ) a := hs0
  have ha : j (algebraMap H D a) = 0 := by
    rw [IsScalarTower.algebraMap_apply H (Localization.Away φ) D a, ← hs, map_mul, map_mul, hy',
      zero_mul]
  have ha0 : a = 0 := hinj (by simpa using ha)
  rw [ha0, map_zero] at hs
  exact hy0 ((hu.mul_left_eq_zero).mp hs)

theorem wc_pks_adjoinRoot_coords : ∀ (R : Type u) [CommRing R] [Nontrivial R] (a : R) (N : ℕ), 0 < N → (∀ c : Fin N → R, ∑ i, algebraMap R (AdjoinRoot (Polynomial.X ^ N - Polynomial.C a)) (c i) * AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C a) ^ (i : ℕ) = 0 → ∀ i, c i = 0) ∧ ∀ x : AdjoinRoot (Polynomial.X ^ N - Polynomial.C a), ∃ c : Fin N → R, x = ∑ i, algebraMap R (AdjoinRoot (Polynomial.X ^ N - Polynomial.C a)) (c i) * AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C a) ^ (i : ℕ) :=
by
  intro R _ _ a N hN
  have hmon : (Polynomial.X ^ N - Polynomial.C a : Polynomial R).Monic :=
    Polynomial.monic_X_pow_sub_C a (by omega)
  have h : (AdjoinRoot.powerBasis' hmon).dim = N := by
    rw [AdjoinRoot.powerBasis'_dim, Polynomial.natDegree_X_pow_sub_C]
  let b := (AdjoinRoot.powerBasis' hmon).basis.reindex (finCongr h)
  have hb : ∀ i : Fin N,
      b i = AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C a) ^ (i : ℕ) := by
    intro i
    simp only [b, Module.Basis.reindex_apply, PowerBasis.coe_basis, AdjoinRoot.powerBasis'_gen]
    rfl
  have T : ∀ c : Fin N → R, ∑ i, c i • b i =
      ∑ i, algebraMap R (AdjoinRoot (Polynomial.X ^ N - Polynomial.C a)) (c i) *
        AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C a) ^ (i : ℕ) := by
    intro c
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Algebra.smul_def, hb]
  refine ⟨fun c hc => ?_, fun x => ⟨fun i => b.repr x i, ?_⟩⟩
  · exact Fintype.linearIndependent_iff.mp b.linearIndependent c (by rw [T]; exact hc)
  · rw [← T]
    exact (b.sum_repr x).symm

theorem wc_pas_kummer_subfield_integralClosure : ∀ (H : Type u) [CommRing H] [HenselianLocalRing H] [IsSepClosed (IsLocalRing.ResidueField H)] [IsRegularLocalRing H] [IsDomain H] (φ : H), φ ∈ IsLocalRing.maximalIdeal H → φ ∉ IsLocalRing.maximalIdeal H ^ 2 → ∀ (N : ℕ), 0 < N → IsUnit ((N : ℕ) : H) → ∀ (D : Type u) [CommRing D] [IsDomain D] [Algebra H D] [Algebra (Localization.Away φ) D] [IsScalarTower H (Localization.Away φ) D] [Algebra.Etale (Localization.Away φ) D] [Module.Finite (Localization.Away φ) D] (ψ : D →+* Localization.Away (algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) φ)), ψ.comp (algebraMap H D) = (algebraMap (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) (Localization.Away (algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) φ))).comp (algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))) → ∃ e : ℕ, 0 < e ∧ e ∣ N ∧ Nonempty (integralClosure H D ≃ₐ[H] AdjoinRoot (Polynomial.X ^ e - Polynomial.C φ)) :=
by
  intro H _ _ _ _ _ φ hφm hφm2 N hN hNu D _ _ _ _ _ _ _ ψ hψ
  classical

  obtain ⟨-, hufd⟩ := wc_fco_regular_local_ufd H
  haveI : UniqueFactorizationMonoid H := hufd
  have hφ0 : φ ≠ 0 := by
    rintro rfl
    exact hφm2 (Ideal.zero_mem _)
  obtain ⟨hφprime, hirr⟩ := wc_pks_phi_prime_eisenstein H φ hφm hφm2 N hN
  haveI : Fact (Irreducible (Polynomial.X ^ N -
      Polynomial.C (algebraMap H (FractionRing H) φ))) := ⟨hirr⟩
  obtain ⟨ζ, hζ⟩ := wc_henselian_sepClosed_primitive_root H N hNu
  have hζK : IsPrimitiveRoot (algebraMap H (FractionRing H) ζ) N :=
    hζ.map_of_injective (IsFractionRing.injective H (FractionRing H))
  have hφK0 : algebraMap H (FractionRing H) φ ≠ 0 :=
    (map_ne_zero_iff _ (IsFractionRing.injective H (FractionRing H))).mpr hφ0
  haveI hdomφ : IsDomain (Localization.Away φ) :=
    IsLocalization.isDomain_localization (powers_le_nonZeroDivisors_of_noZeroDivisors hφ0)
  haveI : IsIntegrallyClosed (Localization.Away φ) :=
    isIntegrallyClosed_of_isLocalization (Localization.Away φ) (Submonoid.powers φ)
      (powers_le_nonZeroDivisors_of_noZeroDivisors hφ0)

  obtain ⟨hindK, hspanK⟩ := wc_pks_adjoinRoot_coords (FractionRing H)
    (algebraMap H (FractionRing H) φ) N hN
  have hθN' : AdjoinRoot.root (Polynomial.X ^ N -
      Polynomial.C (algebraMap H (FractionRing H) φ)) ^ N =
      algebraMap (FractionRing H) (AdjoinRoot (Polynomial.X ^ N -
        Polynomial.C (algebraMap H (FractionRing H) φ))) (algebraMap H (FractionRing H) φ) := by
    have h0 := AdjoinRoot.mk_self (f := Polynomial.X ^ N -
      Polynomial.C (algebraMap H (FractionRing H) φ))
    rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h0
    rw [AdjoinRoot.algebraMap_eq]
    exact h0
  have hθN : AdjoinRoot.root (Polynomial.X ^ N -
      Polynomial.C (algebraMap H (FractionRing H) φ)) ^ N =
      algebraMap H (AdjoinRoot (Polynomial.X ^ N -
        Polynomial.C (algebraMap H (FractionRing H) φ))) φ := by
    rw [hθN', ← IsScalarTower.algebraMap_apply]

  have hφM : algebraMap H (AdjoinRoot (Polynomial.X ^ N -
      Polynomial.C (algebraMap H (FractionRing H) φ))) φ ≠ 0 := by
    have h2 : algebraMap H (AdjoinRoot (Polynomial.X ^ N -
        Polynomial.C (algebraMap H (FractionRing H) φ))) φ =
        algebraMap (FractionRing H) (AdjoinRoot (Polynomial.X ^ N -
          Polynomial.C (algebraMap H (FractionRing H) φ))) (algebraMap H (FractionRing H) φ) :=
      IsScalarTower.algebraMap_apply _ _ _ _
    rw [h2]
    exact (map_ne_zero_iff _ (algebraMap (FractionRing H) _).injective).mpr hφK0
  have hindH : ∀ h : Fin N → H, ∑ i, algebraMap H (AdjoinRoot (Polynomial.X ^ N -
      Polynomial.C (algebraMap H (FractionRing H) φ))) (h i) *
      AdjoinRoot.root (Polynomial.X ^ N -
        Polynomial.C (algebraMap H (FractionRing H) φ)) ^ (i : ℕ) = 0 → ∀ i, h i = 0 := by
    intro h hsum i
    have e : ∑ i, algebraMap (FractionRing H) (AdjoinRoot (Polynomial.X ^ N -
        Polynomial.C (algebraMap H (FractionRing H) φ))) (algebraMap H (FractionRing H) (h i)) *
        AdjoinRoot.root (Polynomial.X ^ N -
          Polynomial.C (algebraMap H (FractionRing H) φ)) ^ (i : ℕ) = 0 := by
      rw [← hsum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [← IsScalarTower.algebraMap_apply]
    have h1 := hindK _ e i
    exact IsFractionRing.injective H (FractionRing H) (by rw [h1, map_zero])
  obtain ⟨ι, hιinj, -⟩ := wc_pks_localized_cover_embedding H φ N hN
    (AdjoinRoot (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ)))
    (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ)))
    hθN (Ne.isUnit hφM) hindH

  let j : D →ₐ[H] AdjoinRoot (Polynomial.X ^ N -
      Polynomial.C (algebraMap H (FractionRing H) φ)) :=
    { (ι : Localization.Away (algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) φ) →+*
        AdjoinRoot (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ))).comp ψ with
      commutes' := fun h => by
        show ι (ψ (algebraMap H D h)) = _
        have h1 := RingHom.congr_fun hψ h
        simp only [RingHom.comp_apply] at h1
        rw [h1, ← IsScalarTower.algebraMap_apply, AlgHom.commutes] }
  have hjH : Function.Injective ((j : D →+* AdjoinRoot (Polynomial.X ^ N -
      Polynomial.C (algebraMap H (FractionRing H) φ))).comp (algebraMap H D)) := by
    have h1 : (j : D →+* AdjoinRoot (Polynomial.X ^ N -
        Polynomial.C (algebraMap H (FractionRing H) φ))).comp (algebraMap H D) =
        algebraMap H _ := by
      ext h
      exact j.commutes h
    rw [h1]
    have h2 : algebraMap H (AdjoinRoot (Polynomial.X ^ N -
        Polynomial.C (algebraMap H (FractionRing H) φ))) =
        (algebraMap (FractionRing H) (AdjoinRoot (Polynomial.X ^ N -
          Polynomial.C (algebraMap H (FractionRing H) φ)))).comp
          (algebraMap H (FractionRing H)) := IsScalarTower.algebraMap_eq _ _ _
    rw [h2]
    exact (algebraMap (FractionRing H) _).injective.comp (IsFractionRing.injective H (FractionRing H))
  haveI : Nontrivial (Localization.Away φ) := inferInstance
  haveI : IsDomain (AdjoinRoot (Polynomial.X ^ N -
      Polynomial.C (algebraMap H (FractionRing H) φ))) := inferInstance
  have hjinj : Function.Injective j := by
    have h1 := wc_pks_finite_domain_hom_injective H φ D
      (AdjoinRoot (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ)))
      (j : D →+* _) hjH
    intro a b hab
    exact h1 hab

  haveI : IsIntegrallyClosed D := IsIntegrallyClosed.of_localization_maximal
    (fun p _ _ => (wc_pks_etale_localization_normal (Localization.Away φ) D p).2)

  haveI : FiniteDimensional (FractionRing H) (AdjoinRoot (Polynomial.X ^ N -
      Polynomial.C (algebraMap H (FractionRing H) φ))) :=
    (AdjoinRoot.powerBasis (Polynomial.X_pow_sub_C_ne_zero hN _)).finite
  obtain ⟨hθg, hfin⟩ := wc_pks_kummer_subfield_root_power (FractionRing H)
    (AdjoinRoot (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ))) N hN
    (algebraMap H (FractionRing H) ζ) hζK (algebraMap H (FractionRing H) φ)
    (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ)))
    hφK0 hθN' hindK hspanK (IntermediateField.adjoin (FractionRing H) (Set.range j))
  have he0 : 0 < Module.finrank (FractionRing H)
      (IntermediateField.adjoin (FractionRing H) (Set.range j)) := by
    rcases Nat.eq_zero_or_pos (Module.finrank (FractionRing H)
      (IntermediateField.adjoin (FractionRing H) (Set.range j))) with h | h
    · rw [h, zero_mul] at hfin
      omega
    · exact h
  have hg0 : 0 < Module.finrank (IntermediateField.adjoin (FractionRing H) (Set.range j))
      (AdjoinRoot (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ))) := by
    rcases Nat.eq_zero_or_pos (Module.finrank
      (IntermediateField.adjoin (FractionRing H) (Set.range j))
      (AdjoinRoot (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ)))) with h | h
    · rw [h, mul_zero] at hfin
      omega
    · exact h
  have hge : Module.finrank (IntermediateField.adjoin (FractionRing H) (Set.range j))
      (AdjoinRoot (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ))) *
      Module.finrank (FractionRing H)
        (IntermediateField.adjoin (FractionRing H) (Set.range j)) = N := by
    rw [mul_comm]
    exact hfin

  have hsupp := fun (d : D) (c : Fin N → FractionRing H) (hd : j d = ∑ i,
      algebraMap (FractionRing H) (AdjoinRoot (Polynomial.X ^ N -
        Polynomial.C (algebraMap H (FractionRing H) φ))) (c i) *
      AdjoinRoot.root (Polynomial.X ^ N -
        Polynomial.C (algebraMap H (FractionRing H) φ)) ^ (i : ℕ)) =>
    wc_pks_subfield_coeff_support (FractionRing H)
      (AdjoinRoot (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ))) N
      (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ)))
      hN hindK hspanK (IntermediateField.adjoin (FractionRing H) (Set.range j)) _ _ hge hθg rfl
      (j d) (IntermediateField.subset_adjoin (FractionRing H) _ ⟨d, rfl⟩) c hd

  obtain ⟨d₀, hd₀⟩ := wc_pks_integral_root_descent H D
    (AdjoinRoot (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ))) j hjinj
    _ (Module.finrank (FractionRing H)
      (IntermediateField.adjoin (FractionRing H) (Set.range j))) φ he0
    (by rw [← pow_mul, hge, hθN]) hθg

  have hint : ∀ c : Fin N → FractionRing H, IsIntegral H (∑ i,
      algebraMap (FractionRing H) (AdjoinRoot (Polynomial.X ^ N -
        Polynomial.C (algebraMap H (FractionRing H) φ))) (c i) *
      AdjoinRoot.root (Polynomial.X ^ N -
        Polynomial.C (algebraMap H (FractionRing H) φ)) ^ (i : ℕ)) →
      ∀ i, ∃ h : H, algebraMap H (FractionRing H) h = c i := fun c hc i =>
    wc_pks_root_denominator_free H φ hφprime N i i.isLt (c i)
      (wc_pks_kummer_coeff_integral H φ N hN hNu ζ hζ c hc i)

  refine ⟨_, he0, Dvd.intro_left _ hge, ?_⟩
  exact wc_pks_integralClosure_identify H (FractionRing H)
    (AdjoinRoot (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ))) D φ
    (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C (algebraMap H (FractionRing H) φ)))
    N _ _ hg0 he0 hge hθN (IsFractionRing.injective H (FractionRing H)) hindK hspanK hint
    j hjinj d₀ hd₀ hsupp

theorem wc_pas_etale_domain_decomposition : ∀ (H : Type u) [CommRing H] [IsDomain H] [IsIntegrallyClosed H] [IsNoetherianRing H] (φ : H), φ ≠ 0 → ∀ (D : Type u) [CommRing D] [Algebra (Localization.Away φ) D] [Algebra.Etale (Localization.Away φ) D] [Module.Finite (Localization.Away φ) D], ∃ (r : ℕ) (Di : Fin r → Type u) (_ : ∀ i, CommRing (Di i)) (_ : ∀ i, Algebra H (Di i)) (_ : ∀ i, Algebra (Localization.Away φ) (Di i)) (_ : ∀ i, IsScalarTower H (Localization.Away φ) (Di i)), (∀ i, IsDomain (Di i)) ∧ (∀ i, Algebra.Etale (Localization.Away φ) (Di i)) ∧ (∀ i, Module.Finite (Localization.Away φ) (Di i)) ∧ Nonempty (D ≃ₐ[Localization.Away φ] ((i : Fin r) → Di i)) :=
by
  intro H _ _ _ _ φ hφ D _ _ _ _
  classical
  have hle : Submonoid.powers φ ≤ nonZeroDivisors H :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hφ
  haveI hdomφ : IsDomain (Localization.Away φ) := IsLocalization.isDomain_localization hle
  haveI : IsIntegrallyClosed (Localization.Away φ) :=
    isIntegrallyClosed_of_isLocalization (Localization.Away φ) (Submonoid.powers φ) hle
  haveI : IsNoetherianRing (Localization.Away φ) :=
    IsLocalization.isNoetherianRing (Submonoid.powers φ) (Localization.Away φ) inferInstance
  haveI : IsNoetherianRing D := IsNoetherianRing.of_finite (Localization.Away φ) D
  have LD : ∀ (q : Ideal D) [q.IsPrime], IsDomain (Localization.AtPrime q) :=
    fun q _ => wc_ring_etale_localization_isDomain (Localization.Away φ) D q

  haveI hred : IsReduced D := by
    refine IsReduced.mk fun x hx => ?_
    apply eq_zero_of_localization
    intro J hJ
    haveI := LD J
    exact (hx.map (algebraMap D (Localization.AtPrime J))).eq_zero

  have hcop : ∀ P ∈ minimalPrimes D, ∀ Q ∈ minimalPrimes D, P ≠ Q → IsCoprime P Q := by
    intro P hP Q hQ hPQ
    by_contra hnc
    have hne : P ⊔ Q ≠ ⊤ := fun h => hnc (Ideal.isCoprime_iff_sup_eq.mpr h)
    obtain ⟨m, hm, hmle⟩ := Ideal.exists_le_maximal _ hne
    haveI := hm.isPrime
    haveI := LD m
    have hK : (RingHom.ker (algebraMap D (Localization.AtPrime m))).IsPrime :=
      RingHom.ker_isPrime _
    have key : ∀ I ∈ minimalPrimes D, I ≤ m →
        RingHom.ker (algebraMap D (Localization.AtPrime m)) = I := by
      intro I hI hIm
      have hIp : I.IsPrime := Ideal.minimalPrimes_isPrime hI
      have hKI : RingHom.ker (algebraMap D (Localization.AtPrime m)) ≤ I := by
        intro x hx
        rw [RingHom.mem_ker, IsLocalization.map_eq_zero_iff m.primeCompl] at hx
        obtain ⟨⟨s, hs⟩, hsx⟩ := hx
        rcases hIp.mem_or_mem (show s * x ∈ I by rw [hsx]; exact I.zero_mem) with h | h
        · exact absurd (hIm h) hs
        · exact h
      exact le_antisymm hKI (hI.2 ⟨hK, bot_le⟩ hKI)
    exact hPQ ((key P hP (le_trans le_sup_left hmle)).symm.trans
      (key Q hQ (le_trans le_sup_right hmle)))

  obtain ⟨s, hs⟩ := (minimalPrimes.finite_of_isNoetherianRing D).exists_finset_coe
  let e := s.equivFin
  let P : Fin s.card → Ideal D := fun i => (e.symm i).1
  have hPmem : ∀ i, P i ∈ minimalPrimes D := fun i => by
    rw [← hs]; exact (e.symm i).2
  have hPp : ∀ i, (P i).IsPrime := fun i => Ideal.minimalPrimes_isPrime (hPmem i)
  have hPinj : Function.Injective P := fun i j h => e.symm.injective (Subtype.ext h)
  have hpair : Pairwise (Function.onFun IsCoprime P) := fun i j hij =>
    hcop _ (hPmem i) _ (hPmem j) (fun h => hij (hPinj h))
  have hinf : (⨅ i, P i) = ⊥ := by
    rw [eq_bot_iff]
    intro x hx
    rw [Submodule.mem_iInf] at hx
    have hx' : x ∈ sInf (minimalPrimes D) := by
      rw [Submodule.mem_sInf]
      intro I hI
      rw [← hs] at hI
      have := hx (e ⟨I, hI⟩)
      simpa [P] using this
    have h2 : sInf (minimalPrimes D) = nilradical D := Ideal.sInf_minimalPrimes
    rw [h2, nilradical_eq_bot_iff.mpr hred] at hx'
    exact hx'
  let g : D →+* ((i : Fin s.card) → D ⧸ P i) :=
    (Ideal.quotientInfRingEquivPiQuotient P hpair).toRingHom.comp (Ideal.Quotient.mk _)
  have hg : ∀ x, g x = fun i => Ideal.Quotient.mk (P i) x := fun x => rfl
  have hgbij : Function.Bijective g := by
    constructor
    · intro x y hxy
      have h1 : Ideal.Quotient.mk (⨅ i, P i) x = Ideal.Quotient.mk (⨅ i, P i) y :=
        (Ideal.quotientInfRingEquivPiQuotient P hpair).injective hxy
      rw [Ideal.Quotient.eq, hinf, Ideal.mem_bot, sub_eq_zero] at h1
      exact h1
    · exact (Ideal.quotientInfRingEquivPiQuotient P hpair).surjective.comp
        Ideal.Quotient.mk_surjective
  let α : D ≃ₐ[Localization.Away φ] ((i : Fin s.card) → D ⧸ P i) :=
    AlgEquiv.ofRingEquiv (f := RingEquiv.ofBijective g hgbij) (fun c => by
      funext i
      show g _ i = _
      rw [hg]
      rfl)

  haveI hEt : Algebra.Etale (Localization.Away φ) ((i : Fin s.card) → D ⧸ P i) :=
    Algebra.Etale.of_equiv α
  have hfin_i : ∀ i, Module.Finite (Localization.Away φ) (D ⧸ P i) := fun i =>
    Module.Finite.of_surjective (Ideal.Quotient.mkₐ (Localization.Away φ) (P i)).toLinearMap
      Ideal.Quotient.mk_surjective
  have hEt_i : ∀ i, Algebra.Etale (Localization.Away φ) (D ⧸ P i) := by
    intro i
    haveI := hfin_i i
    have hfe : Algebra.FormallyEtale (Localization.Away φ) (D ⧸ P i) :=
      (Algebra.FormallyEtale.pi_iff (fun j => D ⧸ P j)).mp inferInstance i
    have hfp : Algebra.FinitePresentation (Localization.Away φ) (D ⧸ P i) :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance
    exact ⟨hfe, hfp⟩
  refine ⟨s.card, fun i => D ⧸ P i, fun i => inferInstance,
    fun i => ((algebraMap (Localization.Away φ) (D ⧸ P i)).comp
      (algebraMap H (Localization.Away φ))).toAlgebra,
    fun i => inferInstance, fun i => ?_, fun i => ?_, fun i => hEt_i i, fun i => hfin_i i, ⟨α⟩⟩
  · letI : Algebra H (D ⧸ P i) := ((algebraMap (Localization.Away φ) (D ⧸ P i)).comp
      (algebraMap H (Localization.Away φ))).toAlgebra
    exact IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  · haveI := hPp i
    exact Ideal.Quotient.isDomain (P i)

theorem wc_pub_abhyankar_strict : ∀ (H : Type u) [CommRing H] [HenselianLocalRing H] [IsSepClosed (IsLocalRing.ResidueField H)] [IsRegularLocalRing H] [IsDomain H] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : H) → ∀ (φ : H), φ ∈ IsLocalRing.maximalIdeal H → φ ∉ IsLocalRing.maximalIdeal H ^ 2 → ∀ (D : Type u) [CommRing D] [Algebra H D] [Algebra (Localization.Away φ) D] [IsScalarTower H (Localization.Away φ) D] [Algebra.Etale (Localization.Away φ) D] [Module.Finite (Localization.Away φ) D], (∀ (H' : Type u) [CommRing H'] [HenselianLocalRing H'] [IsSepClosed (IsLocalRing.ResidueField H')] (hh : H →+* H'), @Algebra.WeaklyEtale H H' _ _ hh.toAlgebra → (IsLocalRing.maximalIdeal H').comap hh = Ideal.span {φ} → ∀ (Ω : Type u) [Field Ω] [IsSepClosed Ω] (j : H' →+* Ω), @Algebra.WeaklyEtale H' Ω _ _ j.toAlgebra → ∀ σ : Ω →+* Ω, (∀ a, σ (j a) = j a) → ∀ χ : D →+* Ω, χ.comp (algebraMap H D) = j.comp hh → ∃ m : ℕ, (σ ^ (ℓ ^ m)).comp χ = χ) → ∃ (n : ℕ) (e : Fin n → ℕ) (u : Fin n → Hˣ), (∀ j, 0 < e j ∧ IsUnit ((e j : ℕ) : H)) ∧ Nonempty (integralClosure H D ≃ₐ[H] ((j : Fin n) → AdjoinRoot (Polynomial.X ^ (e j) - Polynomial.C ((u j : H) * φ)))) :=
by
  intro H _ _ _ _ _ ℓ _ hℓ φ hφm hφm2 D _ _ _ _ _ _ hT
  classical
  obtain ⟨-, hufd⟩ := wc_fco_regular_local_ufd H
  haveI : UniqueFactorizationMonoid H := hufd
  have hφ0 : φ ≠ 0 := by
    rintro rfl
    exact hφm2 (Ideal.zero_mem _)

  have key : ∀ (E : Type u) [CommRing E] [IsDomain E] [Algebra H E]
      [Algebra (Localization.Away φ) E] [IsScalarTower H (Localization.Away φ) E]
      [Algebra.Etale (Localization.Away φ) E] [Module.Finite (Localization.Away φ) E],
      (∀ (H' : Type u) [CommRing H'] [HenselianLocalRing H'] [IsSepClosed (IsLocalRing.ResidueField H')] (hh : H →+* H'), @Algebra.WeaklyEtale H H' _ _ hh.toAlgebra → (IsLocalRing.maximalIdeal H').comap hh = Ideal.span {φ} → ∀ (Ω : Type u) [Field Ω] [IsSepClosed Ω] (j : H' →+* Ω), @Algebra.WeaklyEtale H' Ω _ _ j.toAlgebra → ∀ σ : Ω →+* Ω, (∀ a, σ (j a) = j a) → ∀ χ : E →+* Ω, χ.comp (algebraMap H E) = j.comp hh → ∃ m : ℕ, (σ ^ (ℓ ^ m)).comp χ = χ) →
      ∃ e : ℕ, 0 < e ∧ IsUnit ((e : ℕ) : H) ∧
        Nonempty (integralClosure H E ≃ₐ[H] AdjoinRoot (Polynomial.X ^ e - Polynomial.C φ)) := by
    intro E _ _ _ _ _ _ _ hTE
    obtain ⟨N, ⟨k, hN⟩, hk⟩ :=
      wc_pas_codim_one_descent wc_pas_dvr_tame_kummer_split H ℓ hℓ φ hφm hφm2 E hTE
    have hNpos : 0 < N := by rw [hN]; exact pow_pos (Fact.out : Nat.Prime ℓ).pos k
    have hNunit : IsUnit ((N : ℕ) : H) := by
      rw [hN, Nat.cast_pow]
      exact hℓ.pow k
    obtain ⟨hhens, hsep, hreg, hdom, hθm, hθm2, hθprime⟩ :=
      wc_pas_kummer_cover_regular H φ hφm hφm2 N hNpos
    obtain ⟨algE, towerE, hetE, hfinE⟩ :=
      wc_pub_cover_baseChange H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) E φ
    have hs : algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) φ =
        AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C φ) ^ N := by
      have h0 := AdjoinRoot.mk_self (f := Polynomial.X ^ N - Polynomial.C φ)
      rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h0
      rw [AdjoinRoot.algebraMap_eq]
      exact h0.symm
    obtain ⟨hBet, hBfin⟩ := wc_pas_purity_integralClosure
      (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
      (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C φ)) _ N hNpos hs hθm hθm2
      (TensorProduct H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) E) hk
    have hmon : (Polynomial.X ^ N - Polynomial.C φ).Monic :=
      Polynomial.monic_X_pow_sub_C φ hNpos.ne'
    haveI : Module.Free H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) :=
      Module.Free.of_basis (AdjoinRoot.powerBasis' hmon).basis
    haveI : Nontrivial (TensorProduct H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) E) :=
      (Module.FaithfullyFlat.nontrivial_tensorProduct_iff_right H
        (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))).mpr inferInstance
    haveI : Nontrivial (integralClosure (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
        (TensorProduct H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) E)) := inferInstance
    obtain ⟨σ₀⟩ := wc_pas_strictHensel_etale_section (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
      (integralClosure (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
        (TensorProduct H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) E))
    haveI hloc := wc_pas_integralClosure_isLocalization
      (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
      (algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) φ)
      (TensorProduct H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) E)
    have hσ₀ : ∀ a : AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ),
        σ₀ (algebraMap (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
          (integralClosure (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
            (TensorProduct H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) E)) a) = a :=
      fun a => σ₀.commutes a
    have hunits : ∀ y : Algebra.algebraMapSubmonoid
        (integralClosure (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
          (TensorProduct H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) E))
        (Submonoid.powers (algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) φ)),
        IsUnit (((algebraMap (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
          (Localization.Away (algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) φ))).comp
            σ₀.toRingHom) y) := by
      rintro ⟨y, hy⟩
      obtain ⟨z, hz, rfl⟩ := hy
      obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hz
      show IsUnit (algebraMap (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
          (Localization.Away (algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) φ))
          (σ₀ (algebraMap (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
            (integralClosure (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
              (TensorProduct H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) E))
            ((algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) φ) ^ n))))
      rw [hσ₀, map_pow]
      exact (IsLocalization.Away.algebraMap_isUnit _).pow n
    let τ := IsLocalization.lift
      (S := TensorProduct H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) E) hunits
    let ψ := τ.comp (Algebra.TensorProduct.includeRight :
      E →ₐ[H] TensorProduct H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) E).toRingHom
    have hψ : ψ.comp (algebraMap H E) =
        (algebraMap (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
          (Localization.Away (algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) φ))).comp
          (algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))) := by
      ext h
      have e1 : (Algebra.TensorProduct.includeRight :
            E →ₐ[H] TensorProduct H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) E)
            (algebraMap H E h) =
          algebraMap (integralClosure (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
              (TensorProduct H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) E))
            (TensorProduct H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) E)
            (algebraMap (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) _
              (algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) h)) := by
        rw [AlgHom.commutes]
        rfl
      show τ ((Algebra.TensorProduct.includeRight :
        E →ₐ[H] TensorProduct H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) E)
          (algebraMap H E h)) = _
      rw [e1, IsLocalization.lift_eq]
      show algebraMap (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
          (Localization.Away (algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) φ))
          (σ₀ (algebraMap (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
            (integralClosure (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
              (TensorProduct H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) E))
            (algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) h))) = _
      exact congrArg (algebraMap (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ))
          (Localization.Away (algebraMap H (AdjoinRoot (Polynomial.X ^ N - Polynomial.C φ)) φ)))
        (hσ₀ _)
    obtain ⟨e, he0, hediv, hβ⟩ :=
      wc_pas_kummer_subfield_integralClosure H φ hφm hφm2 N hNpos hNunit E ψ hψ
    refine ⟨e, he0, ?_, hβ⟩
    obtain ⟨c, hc⟩ := hediv
    have hNe : ((N : ℕ) : H) = (e : H) * (c : H) := by rw [hc, Nat.cast_mul]
    rw [hNe] at hNunit
    exact isUnit_of_mul_isUnit_left hNunit

  obtain ⟨r, Di, iCR, iAH, iAφ, iST, hdom, het, hfin, ⟨α⟩⟩ :=
    wc_pas_etale_domain_decomposition H φ hφ0 D
  have hcomp : ∀ (i : Fin r) (h : H), α (algebraMap H D h) i = algebraMap H (Di i) h := by
    intro i h
    rw [IsScalarTower.algebraMap_apply H (Localization.Away φ) D, AlgEquiv.commutes,
      Pi.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
  have hTi : ∀ i : Fin r, ∀ (H' : Type u) [CommRing H'] [HenselianLocalRing H'] [IsSepClosed (IsLocalRing.ResidueField H')] (hh : H →+* H'), @Algebra.WeaklyEtale H H' _ _ hh.toAlgebra → (IsLocalRing.maximalIdeal H').comap hh = Ideal.span {φ} → ∀ (Ω : Type u) [Field Ω] [IsSepClosed Ω] (j : H' →+* Ω), @Algebra.WeaklyEtale H' Ω _ _ j.toAlgebra → ∀ σ : Ω →+* Ω, (∀ a, σ (j a) = j a) → ∀ χ : Di i →+* Ω, χ.comp (algebraMap H (Di i)) = j.comp hh → ∃ m : ℕ, (σ ^ (ℓ ^ m)).comp χ = χ := by
    intro i H' _ _ _ hh hhwe hhm Ω _ _ j hj σ hσ χ hχ
    let π : D →+* Di i := (Pi.evalRingHom Di i).comp α.toAlgHom.toRingHom
    have hπ : ∀ y, π y = α y i := fun y => rfl
    obtain ⟨m, hm⟩ := hT H' hh hhwe hhm Ω j hj σ hσ (χ.comp π) (by
      ext h
      have := RingHom.congr_fun hχ h
      simp only [RingHom.comp_apply] at this ⊢
      rw [hπ, hcomp, this])
    refine ⟨m, ?_⟩
    ext x
    have hx : π (α.symm (Pi.single i x)) = x := by
      rw [hπ, AlgEquiv.apply_symm_apply, Pi.single_eq_same]
    have := RingHom.congr_fun hm (α.symm (Pi.single i x))
    simp only [RingHom.comp_apply] at this
    rw [hx] at this
    exact this
  have hkey : ∀ i : Fin r, ∃ e : ℕ, 0 < e ∧ IsUnit ((e : ℕ) : H) ∧
      Nonempty (integralClosure H (Di i) ≃ₐ[H] AdjoinRoot (Polynomial.X ^ e - Polynomial.C φ)) := by
    intro i
    haveI := hdom i
    haveI := het i
    haveI := hfin i
    exact key (Di i) (hTi i)
  choose e he using hkey
  refine ⟨r, e, fun _ => 1, fun i => ⟨(he i).1, (he i).2.1⟩, ?_⟩
  obtain ⟨γ⟩ := wc_pas_integralClosure_pi H r Di
  refine ⟨((α.restrictScalars H).mapIntegralClosure.trans γ).trans
    (AlgEquiv.piCongrRight fun i => ?_)⟩
  rw [Units.val_one, one_mul]
  exact (he i).2.2.some

