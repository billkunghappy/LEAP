        MvPolynomial (Fin (n + r)) K).toRingHom.Etale :=
      RingHom.Etale.of_bijective (MvPolynomial.renameEquiv K ε).bijective
    have h1 : (1 : Matrix (Fin n ⊕ Fin r) (Fin n ⊕ Fin r) S₀) + Matrix.fromBlocks N 0 0 0 =
        Matrix.fromBlocks (1 + N) 0 0 1 := by
