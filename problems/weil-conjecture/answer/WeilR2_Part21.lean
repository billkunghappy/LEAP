    (fun j j' i => s3 ((localCohomology.ringModIdeals (localCohomology.idealPowersDiagram I)).map i.unop)
      (Pj j') (Pj j) (w j') (hw j') (w j) (hw j))
    (fun j => (s2 (Pj j) (w j) (hw j)).1) (fun j => (s2 (Pj j) (w j) (hw j)).2)
  exact ⟨Δ, h1, h2⟩

theorem wc_plt_lc_zero_eq_torsion (A : Type u) [CommRing A] (I : Ideal A) (M : Type u)
    [AddCommGroup M] [Module A M] :
    Nonempty (((localCohomology I 0).obj (ModuleCat.of A M)) ≃ₗ[A]
      ↥(⨆ k : ℕ, Submodule.torsionBySet A M ↑(I ^ k))) :=
by
  classical

  have hs1 : ∀ (N : ModuleCat.{u} A), ∃ ψ : (X : ModuleCat.{u} A) →
        (↑(((Ext A (ModuleCat.{u} A) 0).obj (Opposite.op X)).obj N) ≃ₗ[A] (X ⟶ N)),
      ∀ (X X' : ModuleCat.{u} A) (f : X ⟶ X')
        (y : ↑(((Ext A (ModuleCat.{u} A) 0).obj (Opposite.op X')).obj N)),
        ψ X ((((Ext A (ModuleCat.{u} A) 0).map f.op).app N).hom y) = f ≫ ψ X' y := by
    intro N
    let G := (linearYoneda A (ModuleCat.{u} A)).obj N
    have : Limits.PreservesFiniteLimits G :=
      @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _ G (forget _)
        (inferInstanceAs (Limits.PreservesFiniteLimits (yoneda.obj N))) inferInstance
    have : Limits.PreservesFiniteColimits G.rightOp := Limits.preservesFiniteColimits_rightOp G
    let η := G.rightOp.leftDerivedZeroIsoSelf
    refine ⟨fun X => ((η.symm.app X).unop).toLinearEquiv, ?_⟩
    intro X X' f y
    have hnat := η.inv.naturality f
    have h2 := congrArg Quiver.Hom.unop hnat
    simp only [unop_comp] at h2
    have h3 := congrArg (fun φ => φ.hom y) h2
    simp only [ModuleCat.hom_comp] at h3
    exact h3.symm

  have hs2 : ∀ J : Ideal A, ∃ e : (ModuleCat.of A (A ⧸ J) ⟶ ModuleCat.of A M) ≃ₗ[A]
        ↥(Submodule.torsionBySet A M ↑J),
      ∀ φ : ModuleCat.of A (A ⧸ J) ⟶ ModuleCat.of A M,
        ((e φ : ↥(Submodule.torsionBySet A M ↑J)) : M) =
          φ.hom (Submodule.Quotient.mk (1 : A)) := by
    intro J
    have hmk : ∀ a : A, (Submodule.Quotient.mk a : A ⧸ J) =
        a • Submodule.Quotient.mk (1 : A) := by
      intro a
      rw [← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one]
    let ev : (ModuleCat.of A (A ⧸ J) ⟶ ModuleCat.of A M) →ₗ[A]
        ↥(Submodule.torsionBySet A M ↑J) :=
      { toFun := fun φ => ⟨φ.hom (Submodule.Quotient.mk (1 : A)), by
          rw [Submodule.mem_torsionBySet_iff]
          rintro ⟨a, ha⟩
          show a • φ.hom _ = 0
          rw [← map_smul, ← hmk, (Submodule.Quotient.mk_eq_zero _).mpr ha, map_zero]⟩
        map_add' := fun φ ψ => by ext; simp
        map_smul' := fun c φ => by ext; simp }
    have inj : Function.Injective ev := by
      rw [injective_iff_map_eq_zero]
      intro φ hφ
      have h0 : φ.hom (Submodule.Quotient.mk (1 : A)) = 0 := congrArg Subtype.val hφ
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      rw [hmk, map_smul, h0, smul_zero]
      rfl
    have surj : Function.Surjective ev := by
      rintro ⟨m, hm⟩
      rw [Submodule.mem_torsionBySet_iff] at hm
      have hker : J ≤ LinearMap.ker (LinearMap.toSpanSingleton A M m) := by
        intro a ha
        simp only [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply]
        exact hm ⟨a, ha⟩
      refine ⟨ModuleCat.ofHom (J.liftQ (LinearMap.toSpanSingleton A M m) hker), ?_⟩
      apply Subtype.ext
      show (J.liftQ (LinearMap.toSpanSingleton A M m) hker) (Submodule.Quotient.mk (1 : A)) = m
      rw [Submodule.liftQ_apply, LinearMap.toSpanSingleton_apply, one_smul]
    exact ⟨LinearEquiv.ofBijective ev ⟨inj, surj⟩, fun φ => rfl⟩

  have hs3 : ∀ (F : ℕᵒᵖᵒᵖ ⥤ ModuleCat.{u} A)
      (N : Type u) [AddCommGroup N] [Module A N] (g : (j : ℕᵒᵖᵒᵖ) → ↑(F.obj j) →ₗ[A] N),
      (∀ (j j' : ℕᵒᵖᵒᵖ) (f : j ⟶ j') (y : ↑(F.obj j)), g j' ((F.map f).hom y) = g j y) →
      (∀ j, Function.Injective (g j)) →
      (∀ z : N, ∃ (j : ℕᵒᵖᵒᵖ) (y : ↑(F.obj j)), g j y = z) →
      Nonempty (↑(Limits.colimit F) ≃ₗ[A] N) := by
    intro F N _ _ g hcompat hinj hsurj
    let c : Limits.Cocone F :=
      { pt := ModuleCat.of A N
        ι := { app := fun j => ModuleCat.ofHom (g j)
               naturality := fun j j' f => by
                 ext y
                 simp [hcompat] } }
    let Φ := Limits.colimit.desc F c
    have hΦ : ∀ j y, Φ.hom ((Limits.colimit.ι F j).hom y) = g j y := by
      intro j y
      rw [← ModuleCat.comp_apply, Limits.colimit.ι_desc]
      rfl
    have := Limits.preservesFilteredColimitsOfSize_of_univLE.{u, u, 0, 0}
      (forget (ModuleCat.{u} A))
    have : Limits.PreservesColimit F (forget _) := inferInstance
    have inj : Function.Injective Φ.hom := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨j, y, rfl⟩ := Limits.Concrete.colimit_exists_rep F x
      have : g j y = 0 := by rw [← hΦ]; exact hx
      rw [(map_eq_zero_iff _ (hinj j)).mp this]
      exact map_zero _
    have surj : Function.Surjective Φ.hom := by
      intro z
      obtain ⟨j, y, rfl⟩ := hsurj z
      exact ⟨_, hΦ j y⟩
    exact ⟨LinearEquiv.ofBijective Φ.hom ⟨inj, surj⟩⟩

  let D := localCohomology.diagram (localCohomology.idealPowersDiagram I) 0
  let F := D ⋙ (evaluation (ModuleCat.{u} A) (ModuleCat.{u} A)).obj (ModuleCat.of A M)
  let e₁ : ↑((localCohomology I 0).obj (ModuleCat.of A M)) ≃ₗ[A] ↑(Limits.colimit F) :=
    (Limits.colimitObjIsoColimitCompEvaluation D (ModuleCat.of A M)).toLinearEquiv
  obtain ⟨ψ, hψ⟩ := hs1 (ModuleCat.of A M)
  choose e he using hs2
  let T := ⨆ k : ℕ, Submodule.torsionBySet A M ↑(I ^ k)
  have hle : ∀ k : ℕ, Submodule.torsionBySet A M ↑(I ^ k) ≤ T := fun k =>
    le_iSup (fun k : ℕ => Submodule.torsionBySet A M ↑(I ^ k)) k
  let g : (j : ℕᵒᵖᵒᵖ) → ↑(F.obj j) →ₗ[A] ↥T := fun j =>
    ((Submodule.inclusion (hle j.unop.unop)).comp (e (I ^ j.unop.unop)).toLinearMap).comp
      (ψ (ModuleCat.of A (A ⧸ I ^ j.unop.unop))).toLinearMap
  have hg : ∀ j y, ((g j y : ↥T) : M) =
      (ψ (ModuleCat.of A (A ⧸ I ^ j.unop.unop)) y).hom (Submodule.Quotient.mk (1 : A)) :=
    fun j y => he _ _
  have hcompat : ∀ (j j' : ℕᵒᵖᵒᵖ) (f : j ⟶ j') (y : ↑(F.obj j)),
      g j' ((F.map f).hom y) = g j y := by
    intro j j' f y
    apply Subtype.ext
    rw [hg, hg]
    have key2 : ψ (ModuleCat.of A (A ⧸ I ^ j'.unop.unop)) ((F.map f).hom y) =
        (localCohomology.ringModIdeals (localCohomology.idealPowersDiagram I)).map f.unop ≫
          ψ (ModuleCat.of A (A ⧸ I ^ j.unop.unop)) y :=
      hψ _ _ ((localCohomology.ringModIdeals (localCohomology.idealPowersDiagram I)).map f.unop) y
    rw [key2]
    rfl
  have hinj : ∀ j, Function.Injective (g j) := fun j =>
    (Submodule.inclusion_injective (hle j.unop.unop)).comp
      ((e _).injective.comp (ψ _).injective)
  have hsurj : ∀ z : ↥T, ∃ (j : ℕᵒᵖᵒᵖ) (y : ↑(F.obj j)), g j y = z := by
    intro z
    have hmono : Monotone (fun k : ℕ => Submodule.torsionBySet A M ↑(I ^ k)) := by
      intro k k' hkk'
      exact Submodule.torsionBySet_le_torsionBySet_of_subset (Ideal.pow_le_pow_right hkk')
    obtain ⟨k, hk⟩ := (Submodule.mem_iSup_of_directed _ hmono.directed_le).mp z.2
    refine ⟨Opposite.op (Opposite.op k),
      (ψ (ModuleCat.of A (A ⧸ I ^ k))).symm ((e (I ^ k)).symm ⟨z, hk⟩), ?_⟩
    apply Subtype.ext
    show (((e (I ^ k) ((ψ (ModuleCat.of A (A ⧸ I ^ k)))
      ((ψ (ModuleCat.of A (A ⧸ I ^ k))).symm ((e (I ^ k)).symm ⟨z, hk⟩))))
        : ↥(Submodule.torsionBySet A M ↑(I ^ k))) : M) = z
    rw [LinearEquiv.apply_symm_apply, LinearEquiv.apply_symm_apply]
  obtain ⟨e₂⟩ := hs3 F ↥T g hcompat hinj hsurj
  exact ⟨e₁.trans e₂⟩

theorem wc_plt_lc_torsion_acyclic (A : Type u) [CommRing A] [IsNoetherianRing A] (I : Ideal A)
    (M : Type u) [AddCommGroup M] [Module A M] (hM : ∀ y : M, ∃ k : ℕ, ∀ a ∈ I ^ k, a • y = 0)
    (i : ℕ) (hi : 0 < i) :
    Limits.IsZero ((localCohomology I i).obj (ModuleCat.of A M)) :=
by
  classical

  have memΓ : ∀ (J : Type u) [AddCommGroup J] [Module A J] (y : J),
      y ∈ (⨆ k : ℕ, Submodule.torsionBySet A J ↑(I ^ k)) ↔ ∃ k : ℕ, ∀ a ∈ I ^ k, a • y = 0 := by
    intro J _ _ y
    constructor
    · intro hy
      refine Submodule.iSup_induction _ (motive := fun y => ∃ k : ℕ, ∀ a ∈ I ^ k, a • y = 0)
        hy ?_ ⟨0, fun a _ => smul_zero a⟩ ?_
      · intro k z hz
        rw [Submodule.mem_torsionBySet_iff] at hz
        exact ⟨k, fun a ha => hz ⟨a, ha⟩⟩
      · rintro y z ⟨k₁, hk₁⟩ ⟨k₂, hk₂⟩
        refine ⟨max k₁ k₂, fun a ha => ?_⟩
        rw [smul_add, hk₁ a (Ideal.pow_le_pow_right (le_max_left _ _) ha),
          hk₂ a (Ideal.pow_le_pow_right (le_max_right _ _) ha), add_zero]
    · rintro ⟨k, hk⟩
      apply Submodule.mem_iSup_of_mem k
      rw [Submodule.mem_torsionBySet_iff]
      rintro ⟨a, ha⟩
      exact hk a ha

  have s1 : ∀ (J : Type u) [AddCommGroup J] [Module A J] [Module.Injective A J],
      Module.Injective A ↥(⨆ k : ℕ, Submodule.torsionBySet A J ↑(I ^ k)) := by
    intro J _ _ _
    apply Module.Baer.injective
    intro 𝔞 g

    have hmono : Monotone (fun k : ℕ => Submodule.comap
        ((⨆ k : ℕ, Submodule.torsionBySet A J ↑(I ^ k)).subtype ∘ₗ g)
        (Submodule.torsionBySet A J ↑(I ^ k))) := by
      intro k k' hkk' x hx
      simp only [Submodule.mem_comap, Submodule.mem_torsionBySet_iff] at hx ⊢
      rintro ⟨a, ha⟩
      exact hx ⟨a, Ideal.pow_le_pow_right hkk' ha⟩
    obtain ⟨c, hc⟩ := (monotone_stabilizes_iff_noetherian.mpr inferInstance) ⟨_, hmono⟩
    have hgc : ∀ (x : 𝔞), ∀ b ∈ I ^ c, b • ((g x : _) : J) = 0 := by
      intro x b hb
      obtain ⟨k, hk⟩ := (memΓ J (g x : J)).mp (g x).2
      have hx : x ∈ Submodule.comap ((⨆ k : ℕ, Submodule.torsionBySet A J ↑(I ^ k)).subtype ∘ₗ g)
          (Submodule.torsionBySet A J ↑(I ^ (max c k))) := by
        rw [Submodule.mem_comap, Submodule.mem_torsionBySet_iff]
        rintro ⟨a, ha⟩
        exact hk a (Ideal.pow_le_pow_right (le_max_right _ _) ha)
      have hx' : x ∈ Submodule.comap ((⨆ k : ℕ, Submodule.torsionBySet A J ↑(I ^ k)).subtype ∘ₗ g)
          (Submodule.torsionBySet A J ↑(I ^ c)) := by
        have h := hc (max c k) (le_max_left _ _)
        simp only [OrderHom.coe_mk] at h
        rw [h]; exact hx
      rw [Submodule.mem_comap, Submodule.mem_torsionBySet_iff] at hx'
      exact hx' ⟨b, hb⟩

    obtain ⟨k₀, hk₀⟩ := Ideal.exists_pow_inf_eq_pow_smul I 𝔞
    have hAR := hk₀ (k₀ + c) (by omega)
    rw [show k₀ + c - k₀ = c by omega] at hAR
    have hvan : ∀ x : 𝔞, (x : A) ∈ I ^ (k₀ + c) → g x = 0 := by
      intro x hxn
      have h1 : (x : A) ∈ I ^ (k₀ + c) • (⊤ : Submodule A A) ⊓ 𝔞 := by
        refine ⟨?_, x.2⟩
        rw [Ideal.smul_eq_mul, Ideal.mul_top]; exact hxn
      rw [hAR] at h1
      have h2 : I ^ c • (I ^ k₀ • (⊤ : Submodule A A) ⊓ 𝔞) ≤
          Submodule.map 𝔞.subtype (LinearMap.ker g) := by
        rw [Submodule.smul_le]
        intro r hr m hm
        refine ⟨r • ⟨m, (Submodule.mem_inf.mp hm).2⟩, ?_, rfl⟩
        show g (r • ⟨m, (Submodule.mem_inf.mp hm).2⟩) = 0
        rw [map_smul]
        apply Subtype.ext
        exact hgc _ r hr
      obtain ⟨w, hw, hwx⟩ := h2 h1
      have hwx' : w = x := Subtype.ext hwx
      rw [← hwx']; exact hw

    have hpg : Submodule.comap 𝔞.subtype (I ^ (k₀ + c)) ≤
        LinearMap.ker ((⨆ k : ℕ, Submodule.torsionBySet A J ↑(I ^ k)).subtype ∘ₗ g) := by
      intro x hx
      rw [LinearMap.mem_ker, LinearMap.comp_apply, hvan x hx, map_zero]
    let gb := (Submodule.comap 𝔞.subtype (I ^ (k₀ + c))).liftQ _ hpg
    let ι := (Submodule.comap 𝔞.subtype (I ^ (k₀ + c))).mapQ (I ^ (k₀ + c)) 𝔞.subtype le_rfl
    have hι : Function.Injective ι := by
      rw [injective_iff_map_eq_zero]
      intro q hq
      obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective _ q
      have h1 : ι (Submodule.Quotient.mk x) = Submodule.Quotient.mk (x : A) :=
        Submodule.mapQ_apply _ _ _ x
      rw [Submodule.mkQ_apply, h1, Submodule.Quotient.mk_eq_zero] at hq
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      exact hq
    obtain ⟨h, hh⟩ := Module.Injective.out ι hι gb

    have hg₀ : ∀ a : A, (h ∘ₗ (I ^ (k₀ + c)).mkQ) a ∈
        (⨆ k : ℕ, Submodule.torsionBySet A J ↑(I ^ k)) := by
      intro a
      rw [memΓ]
      refine ⟨k₀ + c, fun b hb => ?_⟩
      have e1 : b • (h ∘ₗ (I ^ (k₀ + c)).mkQ) a = (h ∘ₗ (I ^ (k₀ + c)).mkQ) (b • a) :=
        (map_smul _ b a).symm
      rw [e1, LinearMap.comp_apply, Submodule.mkQ_apply,
        (Submodule.Quotient.mk_eq_zero _).mpr (by rw [smul_eq_mul]; exact Ideal.mul_mem_right a _ hb),
        map_zero]
    refine ⟨LinearMap.codRestrict _ (h ∘ₗ (I ^ (k₀ + c)).mkQ) hg₀, fun x mem => ?_⟩
    apply Subtype.ext
    have e2 := hh (Submodule.Quotient.mk ⟨x, mem⟩)
    exact e2

  have s2 : ∀ (N : Type u) [AddCommGroup N] [Module A N],
      (∀ y : N, ∃ k : ℕ, ∀ a ∈ I ^ k, a • y = 0) →
      ∃ (E : Type u) (_ : AddCommGroup E) (_ : Module A E), Module.Injective A E ∧
        (∀ e : E, ∃ k : ℕ, ∀ a ∈ I ^ k, a • e = 0) ∧ ∃ ι : N →ₗ[A] E, Function.Injective ι := by
    intro N _ _ hN
    let J₀ := Injective.under (ModuleCat.of A N)
    have hι₀ : Function.Injective (Injective.ι (ModuleCat.of A N)).hom :=
      (ModuleCat.mono_iff_injective _).mp (Injective.ι_mono _)
    haveI : Injective (ModuleCat.of A J₀) := (inferInstance : Injective J₀)
    haveI : Module.Injective A J₀ := Module.injective_module_of_injective_object A J₀
    refine ⟨↥(⨆ k : ℕ, Submodule.torsionBySet A J₀ ↑(I ^ k)), inferInstance, inferInstance,
      s1 J₀, ?_, ?_⟩
    · rintro ⟨e, he⟩
      obtain ⟨k, hk⟩ := (memΓ J₀ e).mp he
      exact ⟨k, fun a ha => Subtype.ext (hk a ha)⟩
    · refine ⟨LinearMap.codRestrict _ (Injective.ι (ModuleCat.of A N)).hom (fun y => ?_), ?_⟩
      · obtain ⟨k, hk⟩ := hN y
        exact (memΓ J₀ _).mpr ⟨k, fun a ha => by rw [← map_smul, hk a ha, map_zero]⟩
      · intro y z hyz
        exact hι₀ (congrArg Subtype.val hyz)

  have setup : ∀ (N : Type u) [AddCommGroup N] [Module A N],
      (∀ y : N, ∃ k : ℕ, ∀ a ∈ I ^ k, a • y = 0) →
      ∀ (t s : ℕ) (x : Abelian.Ext (ModuleCat.of A (A ⧸ I ^ t)) (ModuleCat.of A N) (s + 1)),
      ∃ (E : Type u) (_ : AddCommGroup E) (_ : Module A E) (Q : Type u) (_ : AddCommGroup Q)
        (_ : Module A Q) (π : E →ₗ[A] Q) (δ : Abelian.Ext (ModuleCat.of A Q) (ModuleCat.of A N) 1)
        (x₃ : Abelian.Ext (ModuleCat.of A (A ⧸ I ^ t)) (ModuleCat.of A Q) s),
        (∀ e : E, ∃ k : ℕ, ∀ a ∈ I ^ k, a • e = 0) ∧ (∀ q : Q, ∃ k : ℕ, ∀ a ∈ I ^ k, a • q = 0) ∧
        Function.Surjective π ∧ (Abelian.Ext.mk₀ (ModuleCat.ofHom π)).comp δ (zero_add 1) = 0 ∧
        x₃.comp δ rfl = x := by
    intro N _ _ hN t s x
    obtain ⟨E, _, _, hEinj, hEt, ι, hι⟩ := s2 N hN
    let S : ShortComplex (ModuleCat.{u} A) := ShortComplex.mk (ModuleCat.ofHom ι)
      (ModuleCat.ofHom (LinearMap.range ι).mkQ) (by ext y; simp)
    have hS : S.ShortExact := by
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · rw [ShortComplex.moduleCat_exact_iff]
        intro y hy
        have hy' : (Submodule.Quotient.mk y : E ⧸ LinearMap.range ι) = 0 := hy
        rw [Submodule.Quotient.mk_eq_zero] at hy'
        obtain ⟨z, hz⟩ := hy'
        exact ⟨z, hz⟩
      · rw [ModuleCat.mono_iff_injective]; exact hι
      · rw [ModuleCat.epi_iff_surjective]; exact Submodule.mkQ_surjective _
    haveI : Injective (ModuleCat.of A E) := Module.injective_object_of_injective_module A E
    have hx0 : x.comp (Abelian.Ext.mk₀ S.f) (add_zero (s + 1)) = 0 := by
      haveI := HasInjectiveDimensionLT.subsingleton (ModuleCat.of A E) 1 (s + 1) (by omega)
        (ModuleCat.of A (A ⧸ I ^ t))
      exact Subsingleton.elim _ _
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS x hx0 (n₀ := s) rfl
    refine ⟨E, inferInstance, inferInstance, E ⧸ LinearMap.range ι, inferInstance, inferInstance,
      (LinearMap.range ι).mkQ, hS.extClass, x₃, hEt, ?_, Submodule.mkQ_surjective _,
      hS.comp_extClass, hx₃⟩
    intro q
    obtain ⟨e, rfl⟩ := Submodule.mkQ_surjective _ q
    obtain ⟨k, hk⟩ := hEt e
    exact ⟨k, fun a ha => by rw [← map_smul, hk a ha, map_zero]⟩

  have s3 : ∀ (s : ℕ) (N : Type u) [AddCommGroup N] [Module A N],
      (∀ y : N, ∃ k : ℕ, ∀ a ∈ I ^ k, a • y = 0) →
      ∀ (t : ℕ) (x : Abelian.Ext (ModuleCat.of A (A ⧸ I ^ t)) (ModuleCat.of A N) (s + 1)),
      ∃ (t' : ℕ) (ht : t ≤ t'), (Abelian.Ext.mk₀ (ModuleCat.ofHom
          (Submodule.factor (Ideal.pow_le_pow_right ht : I ^ t' ≤ I ^ t)))).comp x
            (zero_add (s + 1)) = 0 := by
    intro s
    induction s with
    | zero =>
      intro N _ _ hN t x
      obtain ⟨E, _, _, Q, _, _, π, δ, x₃, hEt, hQt, hπ, hπδ, hx⟩ := setup N hN t 0 x
      have hx₃ : x₃ = Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ x₃) :=
        (Abelian.Ext.mk₀_homEquiv₀_apply x₃).symm
      obtain ⟨e, he⟩ := hπ ((Abelian.Ext.homEquiv₀ x₃).hom (Submodule.Quotient.mk 1))
      obtain ⟨k, hk⟩ := hEt e
      refine ⟨max t k, le_max_left _ _, ?_⟩
      have hψ : I ^ (max t k) ≤ LinearMap.ker (LinearMap.toSpanSingleton A E e) := by
        intro b hb
        rw [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply]
        exact hk b (Ideal.pow_le_pow_right (le_max_right _ _) hb)
      let ψ : ModuleCat.of A (A ⧸ I ^ (max t k)) ⟶ ModuleCat.of A E :=
        ModuleCat.ofHom ((I ^ (max t k)).liftQ (LinearMap.toSpanSingleton A E e) hψ)
