  have e5 := hφCev ((θ'.hom.hom.app (Opposite.op (Over.mk (𝟙 V)))).hom s) t
  show (show C(↥((wcProEtBaseChange i).obj V).left, Fin r → ℚ_[ℓ]) from
      ((a.hom.app (Opposite.op ((wcProEtBaseChange i).obj V))).hom
        ((β.hom.hom.app (Opposite.op (Over.mk (𝟙 ((wcProEtBaseChange i).obj V))))).hom
          (((inv ψ).hom.app (Opposite.op ((wcProEtBaseChange i).obj V))).hom
            ((φ.app (Opposite.op V)).hom s)))).down) t = _
  rw [e2, e4]
  exact e5

theorem wc_proet_two_triv_compare (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
