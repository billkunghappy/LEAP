        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hQCf
  obtain ⟨yb, hyb, hybc⟩ : ∃ yb : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom yb =
        lam (D.S j (IsLocalRing.closedPoint F'')) ∧
      IsClosed ({yb} : Set (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left) := by
    haveI : CompactSpace ↥(Limits.pullback (Over.mk (wcProjKStr F'' M')).hom
