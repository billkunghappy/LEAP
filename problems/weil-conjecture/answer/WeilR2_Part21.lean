  obtain ⟨huniq, hres⟩ := wc_pfam_xwt_crit_point_unique F' F'' Y n hn2 D M' Xu h Δ lam p hH j
    (a (IsLocalRing.closedPoint A')) hx'Δ hspec
  refine ⟨x₀, hx₀2, ?_, ?_⟩

  · intro x hx hne
    by_contra hns'
    have hhx : ¬ ∃ V : Xu.left.Opens, Limits.pullback.fst h a x ∈ V ∧ Smooth (V.ι ≫ h) := by
      rintro ⟨V, hV, hsm⟩
