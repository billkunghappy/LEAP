theorem wc_pltr_model_squares_gen : ∀ {P Yt U : Scheme.{u}} (f : Yt ⟶ P) (V E : P.ProEt) (a₀ : E ⟶ V) (τ : E ⟶ E) (A L : Type u) [CommRing A] [IsLocalRing A] [CommRing L] (e : V.left ≅ Spec (.of A)) (eE : E.left ≅ Spec (.of L)) (hcomp : ((wcProEtPullback f).map τ).left ≫ ((wcProEtPullback f).map a₀).left = ((wcProEtPullback f).map a₀).left) (u : U ⟶ ((wcProEtPullback f).obj V).left) (g : U ⟶ Spec (.of A)) (hK : u ≫ Limits.pullback.fst V.hom f ≫ e.hom = g), ∃ (XE : Scheme.{u}) (u' : XE ⟶ ((wcProEtPullback f).obj E).left) (p : XE ⟶ U) (q : XE ⟶ Spec (.of L)), IsPullback u' p ((wcProEtPullback f).map a₀).left u ∧ IsPullback p q g (Spec.map (CommRingCat.ofHom (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom)) ∧ ∃ (Xs : Scheme.{u}) (uZ : Xs ⟶ Limits.pullback (Limits.pullback.fst V.hom f ≫ e.hom) (wcQmSp A)) (ι : Xs ⟶ U) (s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))), IsPullback uZ ι (Limits.pullback.fst (Limits.pullback.fst V.hom f ≫ e.hom) (wcQmSp A) : _ ⟶ ((wcProEtPullback f).obj V).left) u ∧ IsPullback ι s g (wcQmSp A) ∧ ∃ (w : XE ⟶ XE), w ≫ p = p ∧ w ≫ q = q ≫ Spec.map (CommRingCat.ofHom (Spec.preimage (eE.inv ≫ τ.left ≫ eE.hom)).hom) ∧ w ≫ u' = u' ≫ ((wcProEtPullback f).map τ).left :=
by
  intro P Yt U f V E a₀ τ A L _ _ _ e eE hcomp u g hK
  subst hK
  have F1 : ((wcProEtPullback f).map a₀).left ≫ Limits.pullback.fst V.hom f =
      Limits.pullback.fst E.hom f ≫ a₀.left := Limits.pullback.lift_fst _ _ _
