theorem wc_pfam_mc_ring_chart : ∀ (K R : Type u) [Field K] [CommRing R] [Algebra K R] [IsNoetherianRing R] (n r : ℕ), RingHom.IsStandardSmoothOfRelativeDimension (n + r) (algebraMap K R) → ∀ (e : R →+* K), e.comp (algebraMap K R) = RingHom.id K → letI : (RingHom.ker e).IsPrime := RingHom.ker_isPrime e; ∀ (T : Type u) [CommRing T] (κ : K →+* T) (ρ : T →+* R), ρ.comp κ = algebraMap K R → ∀ (φ : T) (z : Fin r → T), RingHom.Etale (MvPolynomial.eval₂Hom κ (fun o : Option (Fin r) => o.elim φ z)) → ∀ (σ : Fin n → Localization.AtPrime (RingHom.ker e)) (c : Matrix (Fin n) (Fin n) K) (B : Matrix (Fin n) (Fin n) (Localization.AtPrime (RingHom.ker e))), (c + c.transpose).det ≠ 0 → (∀ p q, B p q ∈ IsLocalRing.maximalIdeal (Localization.AtPrime (RingHom.ker e))) → IsLocalRing.maximalIdeal (Localization.AtPrime (RingHom.ker e)) = Ideal.span (Set.range σ ∪ Set.range (fun k => algebraMap R (Localization.AtPrime (RingHom.ker e)) (ρ (z k)))) → algebraMap R (Localization.AtPrime (RingHom.ker e)) (ρ φ) = ∑ p, ∑ q, (algebraMap K (Localization.AtPrime (RingHom.ker e)) (c p q) + B p q) * σ p * σ q → ∃ (S : Type u) (_ : CommRing S) (θR : R →+* S) (θ : wcQuadModelRing T n φ (c.map κ) →+* S) (e' : S →+* K), θR.Etale ∧ θ.Etale ∧ θ.comp (algebraMap T (wcQuadModelRing T n φ (c.map κ))) = θR.comp ρ ∧ e'.comp θR = e ∧ ∀ q, e' (θ (Ideal.Quotient.mk (wcQuadModelIdeal T n φ (c.map κ)) (MvPolynomial.X q))) = 0 :=
by
  intro K R _ _ _ _ n r hSm e he
  letI : (RingHom.ker e).IsPrime := RingHom.ker_isPrime e
  intro T _ κ ρ hρ φ z hét σ c B hc hB hmax hG

  have L5b : ∀ {A B C : Type u} [CommRing A] [CommRing B] [CommRing C] (f : A →+* B)
      (g : B →+* C), f.Etale → (g.comp f).Etale → g.Etale := by
    intro A B C _ _ _ f g hf hgf
    letI := f.toAlgebra
    letI := g.toAlgebra
    letI : Algebra A C := (g.comp f).toAlgebra
    haveI : IsScalarTower A B C := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Algebra.Etale A B := hf
    haveI : Algebra.Etale A C := hgf
    exact Algebra.Etale.of_restrictScalars A B C

  have L3 : ∀ {S : Type u} [CommRing S] (c Mi U : Matrix (Fin n) (Fin n) S) (t : Fin n → S),
      (c + c.transpose) * Mi = 1 →
      ∑ p, ∑ r, c p r * ((1 + Mi * U.transpose).mulVec t) p * ((1 + Mi * U.transpose).mulVec t) r =
        ∑ p, ∑ r, (c + U + U * (Mi.transpose * c * Mi) * U.transpose) p r * t p * t r := by
    intro S _ c Mi U t h
    have hsum : ∀ (A : Matrix (Fin n) (Fin n) S) (v : Fin n → S),
        ∑ p, ∑ r, A p r * v p * v r = dotProduct v (A.mulVec v) := by
      intro A v
      simp only [Matrix.mulVec, dotProduct, Finset.mul_sum]
