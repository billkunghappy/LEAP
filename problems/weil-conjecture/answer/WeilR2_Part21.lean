  have hΘ : ∀ x : (wcContSheaf B M).obj ⟶ E.obj,
      (((wcContPull i M ≫ (wcProEtPush i).map
          (ObjectProperty.homMk x : wcContSheaf B M ⟶ E)).hom).app (Opposite.op Q)).hom ρ =
      ((toSheafify (Scheme.ProEt.topology X) ((wcProEtBaseChange i).op ⋙ E.obj)).app
          (Opposite.op Q)).hom ((x.app (Opposite.op ((wcProEtBaseChange i).obj Q))).hom ρ') := by
    intro x
    have hn := toSheafify_naturality (Scheme.ProEt.topology X)
      (Functor.whiskerLeft (wcProEtBaseChange i).op x)
    exact (congrArg (fun f => (f.app (Opposite.op Q)).hom ρ') hn).symm

  have hbij := wc_presheaf_corep_transfer_bijective
    (wcContSheaf X M).obj ((wcProEtPush i).obj E).obj (wcContSheaf B M).obj E.obj
    Q Q₂ ρ a₁ a₂ aₘ ((wcProEtBaseChange i).obj Q) ((wcProEtBaseChange i).obj Q₂) ρ'
    ((wcProEtBaseChange i).map a₁) ((wcProEtBaseChange i).map a₂) ((wcProEtBaseChange i).map aₘ)
    hU hA hU' hA' hP'
    ((toSheafify (Scheme.ProEt.topology X) ((wcProEtBaseChange i).op ⋙ E.obj)).app (Opposite.op Q))
    (hτb Q)
    ((toSheafify (Scheme.ProEt.topology X) ((wcProEtBaseChange i).op ⋙ E.obj)).app (Opposite.op Q₂))
    (hτb Q₂).1 (hnat a₁) (hnat a₂) (hnat aₘ)
    (fun x => (wcContPull i M ≫ (wcProEtPush i).map
      (ObjectProperty.homMk x : wcContSheaf B M ⟶ E)).hom) hΘ
  have hΘs : Function.Bijective
      (fun y : wcContSheaf B M ⟶ E => wcContPull i M ≫ (wcProEtPush i).map y) := by
