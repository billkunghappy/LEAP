    intro y hy
    have h0 : wcHMPull Dr (n - 1) y = 0 := hκ (hy.trans (map_zero κ).symm)
    obtain ⟨w, rfl⟩ := wc_mnt_milnor_restr_exact F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE
      hE x hx₁ hx₂ B Λ' W'' φ' a' hsh Dp hDp Dr hDr y h0
    exact (wc_hm_pull_comp _ _ _ hcomp Dp hDp Dτ hDτ Dp hDp (n - 1) w).symm

  by_cases hall : ∀ y : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
      κ (wcHMPull Dr (n - 1) y) = 0
  · refine ⟨1, one_ne_zero, fun y => ?_⟩
    rw [hfixker y (hall y), sub_self, hall y, mul_zero, hzero]

  push_neg at hall
  obtain ⟨y₀, hy₀⟩ := hall
  have hres₀ : wcHMPull Dr (n - 1) y₀ ≠ 0 := fun h => hy₀ (by rw [h, map_zero])
  obtain ⟨y₁, hlam1⟩ : ∃ y₁ : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
      κ (wcHMPull Dr (n - 1) y₁) = 1 :=
    ⟨wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (κ (wcHMPull Dr (n - 1) y₀))⁻¹ y₀,
      by rw [hlamsc, inv_mul_cancel₀ hy₀]⟩
  obtain ⟨δ, hδ⟩ : ∃ δ : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
      δ = wcHMPull Dτ (n - 1) y₁ - y₁ := ⟨_, rfl⟩
  have hstar : ∀ y : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
      wcHMPull Dτ (n - 1) y = y +
        wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (κ (wcHMPull Dr (n - 1) y)) δ := by
    intro y
    have hz := hfixker (y - wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1)
        (κ (wcHMPull Dr (n - 1) y)) y₁) (by
      simp only [map_sub]
      rw [hlamsc, hlam1, mul_one, sub_self])
    rw [map_sub, hpullsc Dτ hDτ] at hz
    rw [hδ, map_sub]
    rw [sub_eq_iff_eq_add] at hz
    rw [hz]
    abel
  have hgy1 : wcHMPull Dτ (n - 1) y₁ = y₁ + δ := by rw [hδ]; abel

  have hodd : Odd (n - 1) := by
    obtain ⟨k, hk⟩ := hn
    exact ⟨k - 1, by omega⟩
  have hanti : ∀ u v : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
      wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1)) (by omega)
          u v =
        -wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1)) (by omega)
          v u := by
    intro u v
    rw [wc_hm_graded_comm ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1))
      (by omega) (by omega) u v, (Nat.odd_mul.mpr ⟨hodd, hodd⟩).neg_one_pow, neg_one_zsmul]
  have hcc : ∀ c : wcHM ((wcProEtPullback D.f).obj E).left ℓ (2 * (n - 1)), c = -c → c = 0 := by
    intro c hc
    have h2 : (2 : ℕ) • c = 0 := by
      rw [two_nsmul]
      calc c + c = c + -c := congrArg (c + ·) hc
        _ = 0 := add_neg_cancel c
    rw [hnsmul2] at h2
    have h3 := congrArg
      (wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (2 * (n - 1)) (2 : ℚ_[ℓ])⁻¹) h2
    rw [hmul2, map_zero, show ((2 : ℕ) : ℚ_[ℓ]) * (2 : ℚ_[ℓ])⁻¹ = 1 by norm_num, hone2] at h3
    exact h3
  have hδδ : wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1))
      (by omega) δ δ = 0 := hcc _ (hanti δ δ)
  have hexp : ∀ p q r s : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
      wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1)) (by omega)
          (p + q) (r + s) =
        wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1)) (by omega) p r +
        wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1)) (by omega) p s +
        wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1)) (by omega) q r +
        wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1)) (by omega)
          q s := by
    intro p q r s
    simp only [map_add, AddMonoidHom.add_apply]
    abel
  have htop := wc_mnt_inertia_top_trivial F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
    τ hτ Dτ hDτ
  have hcupδ : ∀ xx : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
      wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1)) (by omega)
          xx δ =
        wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (2 * (n - 1))
          (κ (wcHMPull Dr (n - 1) xx))
          (wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1)) (by omega)
            y₁ δ) := by
    intro xx
    have h1 := wc_hm_pull_cup Dτ (n - 1) (n - 1) (2 * (n - 1)) (by omega) xx y₁
    rw [htop, hstar xx, hgy1, hexp, (wc_hm_cup_scalar _ _ _ _ _ _ _ δ y₁).1,
      (wc_hm_cup_scalar _ _ _ _ _ _ _ δ δ).1, hδδ, map_zero, add_zero, hanti δ y₁,
      map_neg] at h1
    have h2 : wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1))
          (by omega) xx δ -
        wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (2 * (n - 1))
          (κ (wcHMPull Dr (n - 1) xx))
          (wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1)) (by omega)
            y₁ δ) =
        (wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1))
          (by omega) xx y₁ +
        wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1))
          (by omega) xx δ +
        -wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (2 * (n - 1))
          (κ (wcHMPull Dr (n - 1) xx))
          (wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1)) (by omega)
            y₁ δ)) -
        wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1))
          (by omega) xx y₁ := by abel
    rw [← h1, sub_self] at h2
    exact sub_eq_zero.mp h2

  obtain ⟨μ, hμ⟩ := wc_mnt_XE_top_line F' F'' Y n hn hn2 D ℓ hℓ E L eE hE ω
    (wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1)) (by omega)
      y₁ δ) hω
  have hδμ : δ = wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1) μ δ' := by
    rw [← sub_eq_zero]
    apply wc_mnt_XE_cup_right_nondeg F' F'' Y n hn hn2 D ℓ hℓ E L eE hE
    intro yy
    rw [map_sub, hcupδ yy, hμ, hmul2, (wc_hm_cup_scalar _ _ _ _ _ _ _ yy δ').2, hδ', hmul2,
      mul_comm μ, sub_self]

  have hμ0 : μ ≠ 0 := by
    intro hμ0
    obtain ⟨y₂, hy₂⟩ := wc_mnt_PL_monodromy_nontrivial F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀
      L eE hE ϖ hϖ τ hτ htame x hx₁ hx₂ B Λ' W'' φ' a' hsh Dτ hDτ Dr hDr ⟨y₀, hres₀⟩
    apply hy₂
    rw [hstar y₂, hδμ, hμ0, hzero, map_zero, add_zero]

  refine ⟨μ, hμ0, fun y => ?_⟩
  rw [hstar y, add_sub_cancel_left, hδμ, hmul]

theorem wc_mnt_milnor_variation_moves (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (ϖ : A) (hϖ : IsLocalRing.maximalIdeal A = Ideal.span {ϖ})
    (τ : E ⟶ E) (hτ : τ ≫ a₀ = a₀)
    (htame : wcMntTame ℓ (Spec.preimage (eE.inv ≫ a₀.left ≫ e.hom)).hom
      (Spec.preimage (eE.inv ≫ τ.left ≫ eE.hom)).hom ϖ)
    (x : ((wcProEtPullback D.f).obj V).left)
    (hx₁ : Limits.pullback.fst V.hom D.f x = e.inv (IsLocalRing.closedPoint A))
    (hx₂ : Limits.pullback.snd V.hom D.f x = D.xs i (IsLocalRing.closedPoint F''))
    (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (Λ' : Type u) [SmallCategory Λ'] [IsCofiltered Λ']
    (W'' : Λ' ⥤ StructuredArrow (Over.mk (wcEtGeomPt ((wcProEtPullback D.f).obj V).left x))
      (Scheme.Etale.forget ((wcProEtPullback D.f).obj V).left))
    (φ' : ∀ l, Spec (.of B) ⟶ (W''.obj l).right.left)
    (a' : Spec (.of B) ⟶ ((wcProEtPullback D.f).obj V).left)
    (hsh : wcHalShData x B Λ' W'' φ' a')
    (Dτ : wcHMPullData ((wcProEtPullback D.f).map τ).left ℓ) (hDτ : wcHMPullCanonical Dτ)
    (Dr : wcHMPullData (Limits.pullback.snd a' ((wcProEtPullback D.f).map a₀).left) ℓ)
    (hDr : wcHMPullCanonical Dr) :
    ∀ y : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
      wcHMPull Dr (n - 1) y ≠ 0 → wcHMPull Dτ (n - 1) y ≠ y :=
by
  intro y hres

  have hpullsc : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (Df : wcHMPullData f ℓ),
      wcHMPullCanonical Df → ∀ (q : ℕ) (c : ℚ_[ℓ]) (z : wcHM S ℓ q),
        wcHMPull Df q (wcHMScalar S ℓ q c z) = wcHMScalar S' ℓ q c (wcHMPull Df q z) := by
    intro S S' f Df hDf q c z
    have hc := wc_hm_pull_const Df hDf c
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := Df.additive
    haveI := Df.presLim
    haveI := Df.presColim
    show (Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ
          (z.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero q))).comp
          (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q)) (zero_add q) =
        ((Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ z).comp
          (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q)) (zero_add q)).comp
          (Abelian.Ext.mk₀ (wcHMConst S' ℓ c)) (add_zero q)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, ← hc]
    generalize Abelian.Ext.mapExactFunctor Df.Φ z = w
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero w
        (Abelian.Ext.mk₀ (Df.Φ.map (wcHMConst S ℓ c))) (Abelian.Ext.mk₀ Df.μ.hom),
      Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ Df.μ.inv),
      Abelian.Ext.comp_assoc_of_third_deg_zero w (Abelian.Ext.mk₀ Df.μ.hom),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id_assoc]

  obtain ⟨κ, hκ, hκc⟩ := wc_mnt_fib_rank_le_one F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
    x hx₁ hx₂ B Λ' W'' φ' a' hsh
  obtain ⟨ω, hω, hrep⟩ := wc_mnt_XE_poincare_middle F' F'' Y n hn hn2 D ℓ hℓ E L eE hE
  have hlam : ∀ (c : ℚ_[ℓ]) (z : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1)),
      (κ.comp (wcHMPull Dr (n - 1)))
          (wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1) c z) =
        c * (κ.comp (wcHMPull Dr (n - 1))) z := by
    intro c z
    simp only [AddMonoidHom.comp_apply]
    rw [hpullsc Dr hDr, hκc]
  obtain ⟨δ', hδ'⟩ := hrep (κ.comp (wcHMPull Dr (n - 1))) hlam
  have hδ'' : ∀ y : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
      wcHMCup ((wcProEtPullback D.f).obj E).left ℓ (n - 1) (n - 1) (2 * (n - 1)) (by omega)
          y δ' =
        wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (2 * (n - 1))
          (κ (wcHMPull Dr (n - 1) y)) ω := fun y => hδ' y

  obtain ⟨c, hc, hPL⟩ := wc_mnt_local_PL_formula F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE
    hE ϖ hϖ τ hτ htame x hx₁ hx₂ B Λ' W'' φ' a' hsh Dτ hDτ Dr hDr κ hκ hκc ω hω δ' hδ''

  have ha : κ (wcHMPull Dr (n - 1) y) ≠ 0 := by
    intro h0
    apply hres
    apply hκ
    rw [h0, map_zero]
  obtain ⟨hmul2, hone2, -, -⟩ := wc_hmScalar_laws ((wcProEtPullback D.f).obj E).left ℓ (2 * (n - 1))
  obtain ⟨hmul1, hone1, -, -⟩ := wc_hmScalar_laws ((wcProEtPullback D.f).obj E).left ℓ (n - 1)
  have hδne : δ' ≠ 0 := by
    intro h0
    have h1 := hδ'' y
    rw [h0, map_zero] at h1
    apply hω
    have h2 := congrArg (wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (2 * (n - 1))
      (κ (wcHMPull Dr (n - 1) y))⁻¹) h1
    rw [map_zero, hmul2, mul_inv_cancel₀ ha, hone2] at h2
    exact h2.symm
  intro hfix
  have h1 := hPL y
  rw [hfix, sub_self] at h1
  apply hδne
  have hb : c * κ (wcHMPull Dr (n - 1) y) ≠ 0 := mul_ne_zero hc ha
  have h2 := congrArg (wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1)
    (c * κ (wcHMPull Dr (n - 1) y))⁻¹) h1
  rw [map_zero, hmul1, mul_inv_cancel₀ hb, hone1] at h2
  exact h2.symm

theorem wc_mnt_hm_inertia_nontrivial (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F'')) :
    ∃ τ : E ⟶ E, τ ≫ a₀ = a₀ ∧
      ∀ (Dp : wcHMPullData ((wcProEtPullback D.f).map a₀).left ℓ)
        (Dτ : wcHMPullData ((wcProEtPullback D.f).map τ).left ℓ),
        wcHMPullCanonical Dp → wcHMPullCanonical Dτ →
        ∀ y : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
          y ∉ Set.range (wcHMPull Dp (n - 1)) →
          ∃ x : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1), wcHMPull Dτ (n - 1) x ≠ x :=
by
  obtain ⟨ϖ, hϖ, τ, hτ, htame⟩ :=
    wc_mnt_tame_inertia_exists F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
  refine ⟨τ, hτ, ?_⟩
  intro Dp Dτ hDp hDτ y hy

  have hpt : V.hom (e.inv (IsLocalRing.closedPoint A)) =
      D.f (D.xs i (IsLocalRing.closedPoint F'')) := by
    rw [hV, ← D.hxs i]
    rfl
  obtain ⟨x, hx₁, hx₂⟩ := Scheme.Pullback.exists_preimage_pullback _ _ hpt
  obtain ⟨B, _, _, _, Λ', _, _, W'', φ', a', eB, h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_et_geom_strict_henselization (B := ((wcProEtPullback D.f).obj V).left) x
  have hsh : wcHalShData x B Λ' W'' φ' a' := ⟨h1, h2, h3, h4, h5, eB, h6, h7⟩
  obtain ⟨Dr, hDr⟩ :=
    wc_hm_pull_data_exists (Limits.pullback.snd a' ((wcProEtPullback D.f).map a₀).left) ℓ
  have hres : wcHMPull Dr (n - 1) y ≠ 0 := fun h0 =>
    hy (wc_mnt_milnor_restr_exact F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE x hx₁ hx₂
      B Λ' W'' φ' a' hsh Dp hDp Dr hDr y h0)
  exact ⟨y, wc_mnt_milnor_variation_moves F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
    ϖ hϖ τ hτ htame x hx₁ hx₂ B Λ' W'' φ' a' hsh Dτ hDτ Dr hDr y hres⟩

theorem wc_mnt_fibre_PL_fixed_in_sp (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F'')) :
    ∃ τ : E ⟶ E, τ ≫ a₀ = a₀ ∧
      ∀ (Dp : wcHMPullData ((wcProEtPullback D.f).map a₀).left ℓ)
        (Dτ : wcHMPullData ((wcProEtPullback D.f).map τ).left ℓ),
        wcHMPullCanonical Dp → wcHMPullCanonical Dτ →
        ∀ x : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
          wcHMPull Dτ (n - 1) x = x → x ∈ Set.range (wcHMPull Dp (n - 1)) :=
by
  classical

  haveI hres : IsSepClosed (IsLocalRing.ResidueField L) := by
    have hinj : Function.Injective (IsLocalRing.residue L) := (IsLocalRing.residue L).injective
    let φ : L ≃+* IsLocalRing.ResidueField L :=
      RingEquiv.ofBijective (IsLocalRing.residue L) ⟨hinj, IsLocalRing.residue_surjective⟩
    refine IsSepClosed.of_exists_root _ (fun p _ hirr hsep => ?_)
    set q : Polynomial L := p.map (φ.symm : IsLocalRing.ResidueField L →+* L) with hq
    have hqs : q.Separable := hsep.map
    have hdeg : q.degree ≠ 0 := by
      rw [hq, Polynomial.degree_map]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨y, hy⟩ := IsSepClosed.exists_root q hdeg hqs
    refine ⟨φ y, ?_⟩
    have hp : p = q.map (φ : L →+* IsLocalRing.ResidueField L) := by
      rw [hq, Polynomial.map_map]
      have : ((φ : L →+* IsLocalRing.ResidueField L).comp
          (φ.symm : IsLocalRing.ResidueField L →+* L)) = RingHom.id _ := by
        ext z; simp
      rw [this, Polynomial.map_id]
    rw [hp, Polynomial.eval_map]
    exact (Polynomial.eval₂_at_apply (φ : L →+* IsLocalRing.ResidueField L) y).trans
      (by rw [hy.eq_zero, map_zero])
  have hVp := wc_proet_free_projective_strict_local (wcP1Over F'').left V A e
  have hEp := wc_proet_free_projective_strict_local (wcP1Over F'').left E L eE

  obtain ⟨Φ, hsc, hnat⟩ := wc_pencil_Rq_hm_comparison F' F'' Y n D ℓ
  obtain ⟨-, hcod⟩ :=
    wc_pencil_PL_specialization F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
  obtain ⟨τ, hτ, hmove⟩ :=
    wc_mnt_hm_inertia_nontrivial F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
  refine ⟨τ, hτ, ?_⟩
  intro Dp Dτ hDp hDτ x hx

  have hpullsc : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (Df : wcHMPullData f ℓ),
      wcHMPullCanonical Df → ∀ (q : ℕ) (c : ℚ_[ℓ]) (z : wcHM S ℓ q),
        wcHMPull Df q (wcHMScalar S ℓ q c z) = wcHMScalar S' ℓ q c (wcHMPull Df q z) := by
    intro S S' f Df hDf q c z
    have hc := wc_hm_pull_const Df hDf c
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := Df.additive
    haveI := Df.presLim
    haveI := Df.presColim
    show (Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ
          (z.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero q))).comp
          (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q)) (zero_add q) =
        ((Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ z).comp
          (Abelian.Ext.mk₀ Df.μ.hom) (add_zero q)) (zero_add q)).comp
          (Abelian.Ext.mk₀ (wcHMConst S' ℓ c)) (add_zero q)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, ← hc]
    generalize Abelian.Ext.mapExactFunctor Df.Φ z = w
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero w
        (Abelian.Ext.mk₀ (Df.Φ.map (wcHMConst S ℓ c))) (Abelian.Ext.mk₀ Df.μ.hom),
      Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ Df.μ.inv),
      Abelian.Ext.comp_assoc_of_third_deg_zero w (Abelian.Ext.mk₀ Df.μ.hom),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id_assoc]

  obtain ⟨hmul, hone, hadd, -⟩ := wc_hmScalar_laws ((wcProEtPullback D.f).obj E).left ℓ (n - 1)
  have hzero : ∀ t : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
      wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1) 0 t = 0 := by
    intro t
    have h := hadd 0 0 t
    rw [add_zero] at h
    exact add_left_cancel (h.symm.trans (add_zero _).symm)
  have hinv : ∀ c : ℚ_[ℓ], c ≠ 0 → ∀ t : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
      wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1) c⁻¹
        (wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1) c t) = t := by
    intro c hc t
    rw [hmul, mul_inv_cancel₀ hc, hone]

  have hcomp : ((wcProEtPullback D.f).map τ).left ≫ ((wcProEtPullback D.f).map a₀).left =
      ((wcProEtPullback D.f).map a₀).left := by
    have h := congrArg (fun k => k.left)
      (show (wcProEtPullback D.f).map τ ≫ (wcProEtPullback D.f).map a₀ =
        (wcProEtPullback D.f).map a₀ by rw [← Functor.map_comp, hτ])
    exact h
  have hfix : ∀ w : wcHM ((wcProEtPullback D.f).obj V).left ℓ (n - 1),
      wcHMPull Dτ (n - 1) (wcHMPull Dp (n - 1) w) = wcHMPull Dp (n - 1) w := fun w =>
    (wc_hm_pull_comp _ _ _ hcomp Dp hDp Dτ hDτ Dp hDp (n - 1) w).symm

  have hcodH : ∀ h₁ h₂ : wcHM ((wcProEtPullback D.f).obj E).left ℓ (n - 1),
      ∃ c₁ c₂ : ℚ_[ℓ], (c₁ ≠ 0 ∨ c₂ ≠ 0) ∧
        ∃ w : wcHM ((wcProEtPullback D.f).obj V).left ℓ (n - 1),
          wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1) c₁ h₁ +
            wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1) c₂ h₂ =
            wcHMPull Dp (n - 1) w := by
    intro h₁ h₂
    obtain ⟨c₁, c₂, hc, s, hs⟩ :=
      hcod ((Φ (n - 1) E hEp).symm h₁) ((Φ (n - 1) E hEp).symm h₂)
    refine ⟨c₁, c₂, hc, Φ (n - 1) V hVp s, ?_⟩
    have h := congrArg (Φ (n - 1) E hEp) hs
    rw [hnat (n - 1) V E hVp hEp a₀ Dp hDp s, map_add, hsc, hsc,
      AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply] at h
    exact h.symm

  by_contra hxS
  obtain ⟨x', hx'⟩ := hmove Dp Dτ hDp hDτ x hxS
  apply hx'
  obtain ⟨c₁, c₂, hc, w, hw⟩ := hcodH x x'
  by_cases hc₂ : c₂ = 0
  · exfalso
    have hc₁ : c₁ ≠ 0 := hc.resolve_right (not_not.mpr hc₂)
    rw [hc₂, hzero, add_zero] at hw
    apply hxS
    refine ⟨wcHMScalar ((wcProEtPullback D.f).obj V).left ℓ (n - 1) c₁⁻¹ w, ?_⟩
    rw [hpullsc Dp hDp, ← hw, hinv c₁ hc₁]
  · have h1 : wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1) c₂ x' =
        wcHMPull Dp (n - 1) w - wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1) c₁ x := by
      rw [← hw]; abel
    have h2 : wcHMPull Dτ (n - 1)
        (wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1) c₂ x') =
        wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1) c₂ x' := by
      rw [h1, map_sub, hfix, hpullsc Dτ hDτ, hx]
    rw [hpullsc Dτ hDτ] at h2
    have h3 := congrArg (wcHMScalar ((wcProEtPullback D.f).obj E).left ℓ (n - 1) c₂⁻¹) h2
    rwa [hinv c₂ hc₂, hinv c₂ hc₂] at h3

theorem wc_pencil_Rq_shens_monodromy_nontrivial (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'')) :
    ∃ (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V) (L : Type u) (_ : Field L) (_ : IsSepClosed L)
      (eE : E.left ≅ Spec (.of L)),
      (∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F'')) ∧
      ((∃ t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op E),
          t ∉ Set.range ((wcRq D.f ℓ (n - 1)).obj.map a₀.op).hom) →
        ∃ (τ : E ⟶ E) (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op E)),
          τ ≫ a₀ = a₀ ∧ ((wcRq D.f ℓ (n - 1)).obj.map τ.op).hom t ≠ t) :=
by
  obtain ⟨E, a₀, L, instL, instSC, eE, hE⟩ :=
    wc_pencil_PL_generic_geom_point F'' D.m D.S D.hS V A e
  refine ⟨E, a₀, L, instL, instSC, eE, hE, ?_⟩
  rintro ⟨t, ht⟩

  haveI hres : IsSepClosed (IsLocalRing.ResidueField L) := by
    have hinj : Function.Injective (IsLocalRing.residue L) := (IsLocalRing.residue L).injective
    let φ : L ≃+* IsLocalRing.ResidueField L :=
      RingEquiv.ofBijective (IsLocalRing.residue L) ⟨hinj, IsLocalRing.residue_surjective⟩
    refine IsSepClosed.of_exists_root _ (fun p _ hirr hsep => ?_)
    set q : Polynomial L := p.map (φ.symm : IsLocalRing.ResidueField L →+* L) with hq
    have hqs : q.Separable := hsep.map
    have hdeg : q.degree ≠ 0 := by
      rw [hq, Polynomial.degree_map]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨y, hy⟩ := IsSepClosed.exists_root q hdeg hqs
    refine ⟨φ y, ?_⟩
    have hp : p = q.map (φ : L →+* IsLocalRing.ResidueField L) := by
      rw [hq, Polynomial.map_map]
      have : ((φ : L →+* IsLocalRing.ResidueField L).comp
          (φ.symm : IsLocalRing.ResidueField L →+* L)) = RingHom.id _ := by
        ext z; simp
      rw [this, Polynomial.map_id]
    rw [hp, Polynomial.eval_map]
    exact (Polynomial.eval₂_at_apply (φ : L →+* IsLocalRing.ResidueField L) y).trans
      (by rw [hy.eq_zero, map_zero])
  have hVp := wc_proet_free_projective_strict_local (wcP1Over F'').left V A e
  have hEp := wc_proet_free_projective_strict_local (wcP1Over F'').left E L eE
  obtain ⟨Φ, -, hnat⟩ := wc_pencil_Rq_hm_comparison F' F'' Y n D ℓ
  obtain ⟨τ, hτ, hfix⟩ :=
    wc_mnt_fibre_PL_fixed_in_sp F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE
  obtain ⟨Dp, hDp⟩ := wc_hm_pull_data_exists ((wcProEtPullback D.f).map a₀).left ℓ
  obtain ⟨Dτ, hDτ⟩ := wc_hm_pull_data_exists ((wcProEtPullback D.f).map τ).left ℓ
  refine ⟨τ, t, hτ, fun heq => ?_⟩
  have h1 := hnat (n - 1) E E hEp hEp τ Dτ hDτ t
  rw [heq] at h1
  obtain ⟨y, hy⟩ := hfix Dp Dτ hDp hDτ (Φ (n - 1) E hEp t) h1.symm
  apply ht
  refine ⟨(Φ (n - 1) V hVp).symm y, ?_⟩
  apply (Φ (n - 1) E hEp).injective
  rw [hnat (n - 1) V E hVp hEp a₀ Dp hDp, AddEquiv.apply_symm_apply, hy]

theorem wc_pencil_Rq_shens_punct_surj (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V : (wcP1Over F'').left.ProEt)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (V₀ : (wcP1Over F'').left.ProEt) (j : V₀ ⟶ V) (hj : IsOpenImmersion j.left)
    (hrange : Set.range j.left = {e.inv (IsLocalRing.closedPoint A)}ᶜ) :
    Function.Surjective ((wcRq D.f ℓ (n - 1)).obj.map j.op).hom :=
by
  classical

  have hfun : ∀ {X Y Z : (wcP1Over F'').left.ProEt} (f : X ⟶ Y) (g : Y ⟶ Z)
      (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op Z)),
      ((wcRq D.f ℓ (n - 1)).obj.map f.op).hom (((wcRq D.f ℓ (n - 1)).obj.map g.op).hom s) =
      ((wcRq D.f ℓ (n - 1)).obj.map (f ≫ g).op).hom s := by
    intro X Y Z f g s
    rw [op_comp, CategoryTheory.Functor.map_comp]
    rfl

  have L1 : ∀ (X : (wcP1Over F'').left.ProEt) (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op X)),
      ((wcRqScalar D.f ℓ (n - 1) 1).hom.app (Opposite.op X)).hom x = x := by
    intro X x
    have h : wcRqScalar D.f ℓ (n - 1) 1 = 𝟙 _ :=
      (congrArg ((wcProEtPush D.f).rightDerived (n - 1)).map
        (wc_ladic_scalar_ring D.Yt.left ℓ).1).trans
        (CategoryTheory.Functor.map_id ((wcProEtPush D.f).rightDerived (n - 1)) _)
    rw [h]
    rfl
  have L2 : ∀ (X : (wcP1Over F'').left.ProEt) (c d : ℚ_[ℓ])
      (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op X)),
      ((wcRqScalar D.f ℓ (n - 1) (c * d)).hom.app (Opposite.op X)).hom x =
        ((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op X)).hom
          (((wcRqScalar D.f ℓ (n - 1) d).hom.app (Opposite.op X)).hom x) := by
    intro X c d x
    have h : wcRqScalar D.f ℓ (n - 1) (c * d) =
        wcRqScalar D.f ℓ (n - 1) d ≫ wcRqScalar D.f ℓ (n - 1) c :=
      (congrArg ((wcProEtPush D.f).rightDerived (n - 1)).map
        ((wc_ladic_scalar_ring D.Yt.left ℓ).2.1 c d)).trans
        (CategoryTheory.Functor.map_comp ((wcProEtPush D.f).rightDerived (n - 1)) _ _)
    rw [h]
    rfl
  have L3 : ∀ (X : (wcP1Over F'').left.ProEt) (x : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op X)),
      ((wcRqScalar D.f ℓ (n - 1) 0).hom.app (Opposite.op X)).hom x = 0 := by
    intro X x
    have h : wcRqScalar D.f ℓ (n - 1) (0 + 0) =
        wcRqScalar D.f ℓ (n - 1) 0 + wcRqScalar D.f ℓ (n - 1) 0 :=
      (congrArg ((wcProEtPush D.f).rightDerived (n - 1)).map
        ((wc_ladic_scalar_ring D.Yt.left ℓ).2.2 0 0)).trans
        (wc_rightDerived_map_add (wcProEtPush D.f) (n - 1) _ _ _)
    rw [add_zero] at h
    have h2 := congrArg (fun m => (m.hom.app (Opposite.op X)).hom x) h
    simp only [Sheaf.Hom.add_app, AddCommGrpCat.hom_add, AddMonoidHom.add_apply] at h2
    exact left_eq_add.mp h2
  have L4 : ∀ {X Y : (wcP1Over F'').left.ProEt} (f : X ⟶ Y) (c : ℚ_[ℓ])
      (y : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op Y)),
      ((wcRq D.f ℓ (n - 1)).obj.map f.op).hom
          (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op Y)).hom y) =
        ((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op X)).hom
          (((wcRq D.f ℓ (n - 1)).obj.map f.op).hom y) := by
    intro X Y f c y
    have := congrArg (fun m => m.hom y) ((wcRqScalar D.f ℓ (n - 1) c).hom.naturality f.op)
    exact this.symm

  obtain ⟨V₁, j₁, hj₁, hrange₁, hsub₁⟩ :=
    wc_P1_shens_punct_subsingleton F'' (D.S i) (D.hS i) V A e hV
  haveI := hj
  have hjinj : Function.Injective j.left :=
    (Scheme.Hom.isOpenEmbedding j.left).toIsEmbedding.injective
  have hsub : ∀ x y : V₀.left, x = y := by
    intro x y
    have hx : j.left x ∈ Set.range j₁.left := by rw [hrange₁, ← hrange]; exact ⟨x, rfl⟩
    have hy : j.left y ∈ Set.range j₁.left := by rw [hrange₁, ← hrange]; exact ⟨y, rfl⟩
    obtain ⟨x₁, hx₁⟩ := hx
    obtain ⟨y₁, hy₁⟩ := hy
    apply hjinj
    rw [← hx₁, ← hy₁, hsub₁ x₁ y₁]
  haveI : Subsingleton V₀.left := ⟨hsub⟩

  obtain ⟨E, a₀, L, _, _, eE, hE, hmono⟩ :=
    wc_pencil_Rq_shens_monodromy_nontrivial F' F'' Y n hn hn2 D ℓ hℓ i V A e hV
  obtain ⟨-, hcod⟩ :=
    wc_pencil_PL_specialization F' F'' Y n hn hn2 D ℓ hℓ i V A e hV E a₀ L eE hE

  have hrng : Set.range a₀.left ⊆ Set.range j.left := by
    rintro _ ⟨z, rfl⟩
    rw [hrange]
    intro hz
    apply hE z i
    rw [← MorphismProperty.Over.w a₀, Scheme.Hom.comp_apply]
    rw [Set.mem_singleton_iff] at hz
    rw [hz, hV]
  let al : E.left ⟶ V₀.left := IsOpenImmersion.lift j.left a₀.left hrng
  have hal : al ≫ j.left = a₀.left := IsOpenImmersion.lift_fac _ _ _
  let a : E ⟶ V₀ := MorphismProperty.Over.homMk al (by
    rw [← MorphismProperty.Over.w j, ← Category.assoc, hal, MorphismProperty.Over.w a₀])
  have haj : a ≫ j = a₀ := by
    apply MorphismProperty.Over.Hom.ext
    exact hal

  have hEaff : IsAffine E.left := IsAffine.of_isIso eE.hom
  have hcov := proet_finite_affine_jointly_surjective_covers (wcP1Over F'').left V₀ 1
    (fun _ => E) (fun _ => a) (fun _ => hEaff)
    (fun x => ⟨0, eE.inv (IsLocalRing.closedPoint L), hsub _ _⟩)
  have hRa_inj : Function.Injective ((wcRq D.f ℓ (n - 1)).obj.map a.op).hom := by
    intro y₁ y₂ hy12
    refine (wcRq D.f ℓ (n - 1)).isSeparated V₀ _ hcov y₁ y₂ ?_
    rintro Z f ⟨Z', h, g, hg, rfl⟩
    cases hg
    exact (hfun h a y₁).symm.trans ((congrArg _ hy12).trans (hfun h a y₂))
  have hcompa : ∀ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
      ((wcRq D.f ℓ (n - 1)).obj.map a₀.op).hom s =
        ((wcRq D.f ℓ (n - 1)).obj.map a.op).hom (((wcRq D.f ℓ (n - 1)).obj.map j.op).hom s) := by
    intro s
    rw [hfun a j s, haj]

  intro y
  by_contra hy
  push_neg at hy
  obtain ⟨u, hu⟩ : ∃ u, u = ((wcRq D.f ℓ (n - 1)).obj.map a.op).hom y := ⟨_, rfl⟩

  have hA : u ∉ Set.range ((wcRq D.f ℓ (n - 1)).obj.map a₀.op).hom := by
    rintro ⟨s, hs⟩
    rw [hcompa, hu] at hs
    exact hy _ (hRa_inj hs)

  have hB : ∀ t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op E),
      ∃ w, ((wcRq D.f ℓ (n - 1)).obj.map a.op).hom w = t := by
    intro t
    obtain ⟨c₁, c₂, hc, s, hs⟩ := hcod u t
    rw [hcompa] at hs
    by_cases hc₂ : c₂ = 0
    · exfalso
      have hc₁ : c₁ ≠ 0 := hc.resolve_right (not_not.mpr hc₂)
      rw [hc₂, L3, add_zero] at hs
      apply hA
      refine ⟨((wcRqScalar D.f ℓ (n - 1) c₁⁻¹).hom.app (Opposite.op V)).hom s, ?_⟩
      rw [hcompa, L4 j, L4 a, hs, ← L2, inv_mul_cancel₀ hc₁, L1]
    · refine ⟨((wcRqScalar D.f ℓ (n - 1) c₂⁻¹).hom.app (Opposite.op V₀)).hom
          (((wcRq D.f ℓ (n - 1)).obj.map j.op).hom s) -
        ((wcRqScalar D.f ℓ (n - 1) (c₂⁻¹ * c₁)).hom.app (Opposite.op V₀)).hom y, ?_⟩
      rw [map_sub, L4 a, L4 a, ← hu, hs, map_add, ← L2, ← L2, inv_mul_cancel₀ hc₂, L1]
      abel

  obtain ⟨τ, t, hτ, hne⟩ := hmono ⟨u, hA⟩
  have hτa : τ ≫ a = a := by
    apply MorphismProperty.Over.Hom.ext
    have e1 : (τ ≫ a).left ≫ j.left = a₀.left := by
      have h3 : ((τ ≫ a) ≫ j).left = a₀.left := by rw [Category.assoc, haj, hτ]
      exact h3
    have e2 : a.left ≫ j.left = a₀.left := hal
    exact (cancel_mono j.left).mp (e1.trans e2.symm)
  obtain ⟨w, hw⟩ := hB t
  apply hne
  rw [← hw, hfun τ a w, hτa]

theorem wc_pencil_PL_local_invariants (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (i : Fin D.m) (V₀ : (wcP1Over F'').left.ProEt)
    (A₀ : Type u) [CommRing A₀] [HenselianLocalRing A₀]
    [IsSepClosed (IsLocalRing.ResidueField A₀)]
    (e₀ : V₀.left ≅ Spec (.of A₀))
    (hV₀ : V₀.hom (e₀.inv (IsLocalRing.closedPoint A₀)) = D.S i (IsLocalRing.closedPoint F''))
    (E : (wcP1Over F'').left.ProEt) (a₀ : E ⟶ V₀) (L : Type u) [Field L] [IsSepClosed L]
    (eE : E.left ≅ Spec (.of L))
    (hE : ∀ (z : E.left) (j : Fin D.m), E.hom z ≠ D.S j (IsLocalRing.closedPoint F''))
    (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op E))
    (ht : ∀ σ : E ⟶ E, σ ≫ a₀ = a₀ → ((wcRq D.f ℓ (n - 1)).obj.map σ.op).hom t = t) :
    t ∈ Set.range ((wcRq D.f ℓ (n - 1)).obj.map a₀.op).hom :=
by
  classical

  have hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')

  obtain ⟨W, w, r, θ, -, -, -, -, hcov, -⟩ :=
    wc_pencil_PL_galois_cover F' F'' Y n hn hn2 D ℓ hℓ hP

  obtain ⟨v₀⟩ := wc_P1_strict_local_geomPoint_map F'' hP V₀ A₀ e₀

  obtain ⟨b, -⟩ := wc_pencil_PL_lift_to_cover F'' hP D.m D.S W w hcov E L eE hE (a₀ ≫ v₀)

  obtain ⟨Vp, j, hj, hrange, hsub⟩ :=
    wc_P1_shens_punct_subsingleton F'' (D.S i) (D.hS i) V₀ A₀ e₀ hV₀
  haveI := hj

  have hsubset : Set.range a₀.left ⊆ Set.range j.left := by
    rintro _ ⟨z, rfl⟩
    rw [hrange]
    intro hz
    rw [Set.mem_singleton_iff] at hz
    apply hE z i
    have h1 : E.hom z = V₀.hom (a₀.left z) := by
      rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w a₀]
    rw [h1, hz, hV₀]
  have haL : IsOpenImmersion.lift j.left a₀.left hsubset ≫ j.left = a₀.left :=
    IsOpenImmersion.lift_fac _ _ _
  obtain ⟨a, ha⟩ : ∃ a : E ⟶ Vp, a ≫ j = a₀ := by
    refine ⟨MorphismProperty.Over.homMk (IsOpenImmersion.lift j.left a₀.left hsubset) ?_, ?_⟩
    · rw [← MorphismProperty.Over.w j, ← Category.assoc, haL, MorphismProperty.Over.w a₀]
    · exact MorphismProperty.Over.Hom.ext haL
  have ha' : ∀ y : Vp.left, ∃ x : E.left, a.left x = y :=
    fun y => ⟨eE.inv (IsLocalRing.closedPoint L), hsub _ _⟩

  have ht' : ∀ τ : E ⟶ E, τ ≫ a = a → ((wcRq D.f ℓ (n - 1)).obj.map τ.op).hom t = t := by
    intro τ hτ
    apply ht
    rw [← ha, ← Category.assoc, hτ]

  obtain ⟨y, hy⟩ := wc_proet_sep_point_descent (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1)) W r θ
    Vp E a b ha' L eE t ht'

  obtain ⟨s, hs⟩ := wc_pencil_Rq_shens_punct_surj F' F'' Y n hn hn2 D ℓ hℓ i V₀ A₀ e₀ hV₀
    Vp j hj hrange y

  refine ⟨s, ?_⟩
  have hcomp : ((wcRq D.f ℓ (n - 1)).obj.map (a ≫ j).op).hom s =
      ((wcRq D.f ℓ (n - 1)).obj.map a.op).hom (((wcRq D.f ℓ (n - 1)).obj.map j.op).hom s) := by
    rw [op_comp, Functor.map_comp]
    rfl
  rw [← ha, hcomp, hs, hy]

theorem wc_pencil_PL_local_inertia (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcRq D.f ℓ (n - 1)).over W ≅
      (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (hθc : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
          (wcRqScalar D.f ℓ (n - 1) c) ≫ θ.hom =
        θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
          AddCommGrpCat.{u+1} W).map (wcConstScalar (wcP1Over F'').left ℓ r c))
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin D.m), W.hom z ≠ D.S i (IsLocalRing.closedPoint F''))
    (hcov : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ)
    (i : Fin D.m) :
    ∃ γ : W ⟶ W, γ ≫ w = w ∧
      ∃ g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]),
        (∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op W)) (z : W.left),
          (show C(↥W.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
          g ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) ∧
        ∃ u d : Fin r → ℚ_[ℓ], (∀ x, g x = x + (dotProduct u x) • d) ∧
          ∀ (V : (wcP1Over F'').left.ProEt)
            (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
            (A : Type u) [CommRing A] [HenselianLocalRing A]
            [IsSepClosed (IsLocalRing.ResidueField A)]
            (e : V.left ≅ Spec (.of A)),
            V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'') →
            ∃ (V' : (wcP1Over F'').left.ProEt) (a : V' ⟶ V) (b : V' ⟶ W) (z : V'.left),
              a ≫ v = b ≫ w ∧
              (∀ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
                (show C(↥V'.left, Fin r → ℚ_[ℓ]) from
                  ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
                    (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s)).down) z = 0 → s = 0) ∧
              ∀ x : Fin r → ℚ_[ℓ], g x = x ↔
                ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V),
                  (show C(↥V'.left, Fin r → ℚ_[ℓ]) from
                    ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
                      (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s)).down) z = x :=
by
  classical

  have hcancel1 : ∀ (T : Over W)
      (s : ((wcRq D.f ℓ (n - 1)).over W).obj.obj (Opposite.op T)),
      (θ.inv.hom.app (Opposite.op T)).hom ((θ.hom.hom.app (Opposite.op T)).hom s) = s := by
    intro T s
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom s) θ.hom_inv_id
  have hcancel2 : ∀ (T : Over W)
      (c : ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op T)),
      (θ.hom.hom.app (Opposite.op T)).hom ((θ.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) θ.inv_hom_id

  have hframeLem : ∀ γ : W ⟶ W, ∃ A : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]),
      ∀ (V' : (wcP1Over F'').left.ProEt) (c u : V' ⟶ W), c ≫ γ = u →
      ∀ (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V')) (z : V'.left),
      (show C(↥V'.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk u))).hom t).down) z =
      A ((show C(↥V'.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom t).down) z) := by
    intro γ
    let θσ : (wcRq D.f ℓ (n - 1)).over W ⟶
        (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W :=
      ⟨{ app := fun T => θ.hom.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ γ)))
         naturality := fun X Y f => θ.hom.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ γ = Y.unop.hom ≫ γ
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ γ) ⟶ Over.mk (X.unop.hom ≫ γ)).op }⟩
    obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear (wcP1Over F'').left ℓ W hconn r r
      (θ.inv ≫ θσ)
    have hPt : ∀ (T : Over W)
        (c : (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
        (t : T.left.left),
        (show C(↥T.left.left, Fin r → ℚ_[ℓ]) from
          (((θ.inv ≫ θσ).hom.app (Opposite.op T)).hom c).down) t =
          A ((show C(↥T.left.left, Fin r → ℚ_[ℓ]) from c.down) t) := by
      intro T c t
      rw [hA]
      rfl
    refine ⟨A, ?_⟩
    rintro V' c u rfl t z
    have e1 : ((θ.inv ≫ θσ).hom.app (Opposite.op (Over.mk c))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom t) =
        (θσ.hom.app (Opposite.op (Over.mk c))).hom t :=
      congrArg (θσ.hom.app (Opposite.op (Over.mk c))).hom (hcancel1 (Over.mk c) t)
    have h1 := hPt (Over.mk c) ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom t) z
    have h4 := congrArg (fun y : ULift.{u+1} C(↥V'.left, Fin r → ℚ_[ℓ]) => y.down z) e1
    exact h4.symm.trans h1

  have hRcomp : ∀ {X Y Z : (wcP1Over F'').left.ProEt} (f : X ⟶ Y) (g : Y ⟶ Z)
      (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op Z)),
      ((wcRq D.f ℓ (n - 1)).obj.map (f ≫ g).op).hom t =
        ((wcRq D.f ℓ (n - 1)).obj.map f.op).hom (((wcRq D.f ℓ (n - 1)).obj.map g.op).hom t) := by
    intro X Y Z f g t
    rw [op_comp, Functor.map_comp]
    rfl
  have hRid : ∀ {X : (wcP1Over F'').left.ProEt} (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op X)),
      ((wcRq D.f ℓ (n - 1)).obj.map (𝟙 X).op).hom t = t := by
    intro X t
    exact congrArg (fun m => m.hom t) ((wcRq D.f ℓ (n - 1)).obj.map_id (Opposite.op X))
  have hRsc : ∀ {X Y : (wcP1Over F'').left.ProEt} (f : X ⟶ Y) (c : ℚ_[ℓ])
      (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op Y)),
      ((wcRq D.f ℓ (n - 1)).obj.map f.op).hom
          (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op Y)).hom t) =
        ((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op X)).hom
          (((wcRq D.f ℓ (n - 1)).obj.map f.op).hom t) := by
    intro X Y f c t
    exact (congrArg (fun m => m.hom t) ((wcRqScalar D.f ℓ (n - 1) c).hom.naturality f.op)).symm

  by_cases hex : ∃ (V₀ : (wcP1Over F'').left.ProEt) (v₀ : V₀ ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
      (A₀ : Type u) (_ : CommRing A₀) (_ : HenselianLocalRing A₀)
      (_ : IsSepClosed (IsLocalRing.ResidueField A₀)) (e₀ : V₀.left ≅ Spec (.of A₀)),
      V₀.hom (e₀.inv (IsLocalRing.closedPoint A₀)) = D.S i (IsLocalRing.closedPoint F'')
  swap
  · refine ⟨𝟙 W, Category.id_comp w, LinearMap.id, fun s z => rfl, 0, 0, fun x => by simp, ?_⟩
    intro V v A _ _ _ e he
    exact absurd ⟨V, v, A, inferInstance, inferInstance, inferInstance, e, he⟩ hex
  obtain ⟨V₀, v₀, A₀, iA₀, hA₀, sA₀, e₀, he₀⟩ := hex

  obtain ⟨E, a₀, L, iL, sL, eE, hE⟩ := wc_pencil_PL_generic_geom_point F'' D.m D.S D.hS V₀ A₀ e₀
  obtain ⟨b₀, hb₀⟩ := wc_pencil_PL_lift_to_cover F'' hP D.m D.S W w hcov E L eE hE (a₀ ≫ v₀)

  obtain ⟨hinj, hcodim⟩ := wc_pencil_PL_specialization F' F'' Y n hn hn2 D ℓ hℓ i V₀ A₀ e₀ he₀
    E a₀ L eE hE
  have hinv := wc_pencil_PL_local_invariants F' F'' Y n hn hn2 D ℓ hℓ i V₀ A₀ e₀ he₀ E a₀ L eE hE

  have hEsub : ∀ z z' : E.left, z = z' := by
    intro z z'
    have h : eE.hom z = eE.hom z' := Subsingleton.elim (α := PrimeSpectrum L) _ _
    have h2 := congrArg (fun p => eE.inv p) h
    simpa using h2
  set z₀ : E.left := eE.inv (IsLocalRing.closedPoint L) with hz₀
  haveI : Subsingleton E.left := ⟨hEsub⟩
  haveI : Nonempty E.left := ⟨z₀⟩
  have hEconn : ConnectedSpace E.left := inferInstance

  obtain ⟨Θ, hΘ⟩ : ∃ Θ : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op E) → (Fin r → ℚ_[ℓ]),
      ∀ t, Θ t = (show C(↥E.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b₀))).hom t).down) z₀ := ⟨_, fun _ => rfl⟩
  have hΘadd : ∀ t₁ t₂, Θ (t₁ + t₂) = Θ t₁ + Θ t₂ := by
    intro t₁ t₂
    refine (hΘ _).trans ((congrArg (fun y : ULift.{u+1} C(↥E.left, Fin r → ℚ_[ℓ]) => y.down z₀)
      (map_add (θ.hom.hom.app (Opposite.op (Over.mk b₀))).hom t₁ t₂)).trans ?_)
    rw [hΘ t₁, hΘ t₂]
    rfl
  have hΘ0 : Θ 0 = 0 := by
    refine (hΘ _).trans ((congrArg (fun y : ULift.{u+1} C(↥E.left, Fin r → ℚ_[ℓ]) => y.down z₀)
      (map_zero (θ.hom.hom.app (Opposite.op (Over.mk b₀))).hom)).trans ?_)
    rfl
  have hΘsc : ∀ (c : ℚ_[ℓ]) t,
      Θ (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op E)).hom t) = c • Θ t := by
    intro c t
    rw [hΘ, hΘ]
    exact congrArg (fun m => (show C(↥E.left, Fin r → ℚ_[ℓ]) from
      ((m.hom.app (Opposite.op (Over.mk b₀))).hom t).down) z₀) (hθc c)
  have hΘinj : ∀ t₁ t₂, Θ t₁ = Θ t₂ → t₁ = t₂ := by
    intro t₁ t₂ h
    rw [hΘ, hΘ] at h
    have e : (θ.hom.hom.app (Opposite.op (Over.mk b₀))).hom t₁ =
        (θ.hom.hom.app (Opposite.op (Over.mk b₀))).hom t₂ := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      rw [hEsub z z₀]
      exact h
    have := congrArg (θ.inv.hom.app (Opposite.op (Over.mk b₀))).hom e
    exact (hcancel1 (Over.mk b₀) t₁).symm.trans (this.trans (hcancel1 (Over.mk b₀) t₂))
  have hΘsurj : ∀ v, ∃ t, Θ t = v := by
    intro v
    let c : ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W).obj.obj
        (Opposite.op (Over.mk b₀)) :=
      (show ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W).obj.obj
          (Opposite.op (Over.mk b₀)) from
        (ULift.up (ContinuousMap.const ↥E.left v) : ULift.{u+1} C(↥E.left, Fin r → ℚ_[ℓ])))
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk b₀))).hom c, (hΘ _).trans ?_⟩
    have hs := hcancel2 (Over.mk b₀) c
    exact congrArg (fun y : ULift.{u+1} C(↥E.left, Fin r → ℚ_[ℓ]) => y.down z₀) hs

  obtain ⟨H', hH'⟩ : ∃ H' : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]), ∀ x, x ∈ H' ↔
      ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V₀),
        Θ (((wcRq D.f ℓ (n - 1)).obj.map a₀.op).hom s) = x :=
    ⟨{ carrier := {x | ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V₀),
          Θ (((wcRq D.f ℓ (n - 1)).obj.map a₀.op).hom s) = x}
       add_mem' := by
         rintro _ _ ⟨s₁, rfl⟩ ⟨s₂, rfl⟩
         exact ⟨s₁ + s₂, by rw [map_add, hΘadd]⟩
       zero_mem' := ⟨0, by rw [map_zero, hΘ0]⟩
       smul_mem' := by
         rintro c _ ⟨s, rfl⟩
         exact ⟨((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V₀)).hom s,
           by rw [hRsc, hΘsc]⟩ },
     fun x => Iff.rfl⟩

  have hclaim : ∃ γ : W ⟶ W, γ ≫ w = w ∧ ∃ A : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]),
      (∀ (V' : (wcP1Over F'').left.ProEt) (c u : V' ⟶ W), c ≫ γ = u →
        ∀ (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V')) (z : V'.left),
        (show C(↥V'.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk u))).hom t).down) z =
        A ((show C(↥V'.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk c))).hom t).down) z)) ∧
      ∃ u d : Fin r → ℚ_[ℓ], (∀ x, A x = x + (dotProduct u x) • d) ∧
        ∀ x, A x = x ↔ x ∈ H' := by
    by_cases htop : ∀ x, x ∈ H'
    · refine ⟨𝟙 W, Category.id_comp w, LinearMap.id, ?_, 0, 0, fun x => by simp,
        fun x => ⟨fun _ => htop x, fun _ => rfl⟩⟩
      intro V' c u hcu t z
      rw [Category.comp_id] at hcu
      subst hcu
      rfl
    push_neg at htop
    obtain ⟨x₀, hx₀⟩ := htop
    obtain ⟨t₀, ht₀⟩ := hΘsurj x₀
    have hnot : t₀ ∉ Set.range ((wcRq D.f ℓ (n - 1)).obj.map a₀.op).hom := by
      rintro ⟨s, hs⟩
      exact hx₀ ((hH' x₀).mpr ⟨s, by rw [hs, ht₀]⟩)
    obtain ⟨σ, hσa, hσt⟩ : ∃ σ : E ⟶ E, σ ≫ a₀ = a₀ ∧
        ((wcRq D.f ℓ (n - 1)).obj.map σ.op).hom t₀ ≠ t₀ := by
      by_contra hcon
      push_neg at hcon
      exact hnot (hinv t₀ hcon)
    obtain ⟨γ, hγw, hγ⟩ := hgal E b₀ (σ ≫ b₀) hEconn
      (by rw [hb₀, Category.assoc, hb₀, ← Category.assoc, hσa])
    obtain ⟨A, hA⟩ := hframeLem γ

    have hkey : ∀ t, A (Θ (((wcRq D.f ℓ (n - 1)).obj.map σ.op).hom t)) = Θ t := by
      intro t
      rw [hΘ, hΘ]
      have h2 := hA E b₀ (σ ≫ b₀) hγ.symm (((wcRq D.f ℓ (n - 1)).obj.map σ.op).hom t) z₀
      refine h2.symm.trans ?_
      have hnat := θ.hom.hom.naturality
        (Over.homMk σ rfl : Over.mk (σ ≫ b₀) ⟶ Over.mk b₀).op
      have h1 := congrArg (fun m => (show C(↥E.left, Fin r → ℚ_[ℓ]) from
        (m.hom t).down) z₀) hnat
      refine h1.trans ?_
      show (show C(↥E.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b₀))).hom t).down) (σ.left z₀) = _
      rw [hEsub (σ.left z₀) z₀]
    have hfix : ∀ x ∈ H', A x = x := by
      intro x hx
      obtain ⟨s, rfl⟩ := (hH' x).mp hx
      have e := hkey (((wcRq D.f ℓ (n - 1)).obj.map a₀.op).hom s)
      rwa [← hRcomp, hσa] at e
    have hcod : ∀ x, ∃ c₁ c₂ : ℚ_[ℓ], (c₁ ≠ 0 ∨ c₂ ≠ 0) ∧ c₁ • x + c₂ • x₀ ∈ H' := by
      intro x
      obtain ⟨t, rfl⟩ := hΘsurj x
      obtain ⟨c₁, c₂, hne, s, hs⟩ := hcodim t t₀
      refine ⟨c₁, c₂, hne, (hH' _).mpr ⟨s, ?_⟩⟩
      rw [hs, hΘadd, hΘsc, hΘsc, ht₀]

    obtain ⟨f, hfx₀, hHf⟩ := Submodule.exists_le_ker_of_notMem hx₀
    have hdecomp : ∀ x, x - (f x / f x₀) • x₀ ∈ H' := by
      intro x
      obtain ⟨c₁, c₂, hne, hy⟩ := hcod x
      have hc₁ : c₁ ≠ 0 := by
        intro h0
        rw [h0, zero_smul, zero_add] at hy
        have hc₂ : c₂ ≠ 0 := hne.resolve_left (not_not.mpr h0)
        apply hx₀
        have := H'.smul_mem c₂⁻¹ hy
        rwa [smul_smul, inv_mul_cancel₀ hc₂, one_smul] at this
      have hf : c₁ * f x + c₂ * f x₀ = 0 := by
        have := hHf hy
        rw [LinearMap.mem_ker, map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul] at this
        exact this
      have hcoef : c₁⁻¹ * c₂ = -(f x / f x₀) := by
        field_simp
        linear_combination hf
      have key : x - (f x / f x₀) • x₀ = c₁⁻¹ • (c₁ • x + c₂ • x₀) := by
        rw [smul_add, smul_smul, smul_smul, inv_mul_cancel₀ hc₁, one_smul, hcoef, neg_smul,
          sub_eq_add_neg]
      rw [key]
      exact H'.smul_mem _ hy
    have hgen : ∀ x, A x = x + (f x / f x₀) • (A x₀ - x₀) := by
      intro x
      have h1 := hfix _ (hdecomp x)
      rw [map_sub, map_smul] at h1
      rw [smul_sub]
      rw [sub_eq_iff_eq_add] at h1
      rw [h1]
      abel
    have hAx₀ : A x₀ ≠ x₀ := by
      intro h
      apply hσt
      apply hΘinj
      have e := hkey t₀
      rw [hgen, h, sub_self, smul_zero, add_zero] at e
      exact e
    let uv : Fin r → ℚ_[ℓ] := fun j => f (fun k => if j = k then 1 else 0) / f x₀
    have hu : ∀ x, dotProduct uv x = f x / f x₀ := by
      intro x
      rw [LinearMap.pi_apply_eq_sum_univ f x, Finset.sum_div]
      simp only [dotProduct, uv, smul_eq_mul]
      apply Finset.sum_congr rfl
      intro j _
      ring
    refine ⟨γ, hγw, A, hA, uv, A x₀ - x₀, fun x => by rw [hu x]; exact hgen x,
      fun x => ⟨fun hx => ?_, hfix x⟩⟩
    have h2 : (f x / f x₀) • (A x₀ - x₀) = 0 := by
      have h3 := hgen x
      rw [hx] at h3
      exact (add_left_cancel (h3.symm.trans (add_zero x).symm))
    have hd : A x₀ - x₀ ≠ 0 := sub_ne_zero.mpr hAx₀
    have h4 : f x = 0 := by
      have h5 := (smul_eq_zero.mp h2).resolve_right hd
      rw [div_eq_zero_iff] at h5
      exact h5.resolve_right hfx₀
    have h6 := hdecomp x
    rwa [h4, zero_div, zero_smul, sub_zero] at h6

  obtain ⟨γ, hγw, A, hA, uv, dv, hAud, hAfix⟩ := hclaim
  refine ⟨γ, hγw, A, fun s z => hA W (𝟙 W) γ (Category.id_comp γ) s z, uv, dv, hAud, ?_⟩
  intro V v A' _ _ _ e he
  obtain ⟨c, hc⟩ := wc_pencil_PL_shens_nbhd_rigid F'' hP (D.S i) (D.hS i) V v A' e he
    V₀ v₀ A₀ e₀ he₀
  refine ⟨E, a₀ ≫ c.inv, b₀, z₀, ?_, ?_, ?_⟩
  · rw [hb₀, ← hc]
    simp
  · intro s hs
    have h1 : Θ (((wcRq D.f ℓ (n - 1)).obj.map a₀.op).hom
        (((wcRq D.f ℓ (n - 1)).obj.map c.inv.op).hom s)) = Θ 0 := by
      rw [hΘ0, hΘ, ← hRcomp]
      exact hs
    have h2 : ((wcRq D.f ℓ (n - 1)).obj.map c.inv.op).hom s = 0 :=
      hinj ((hΘinj _ _ h1).trans (map_zero _).symm)
    have h3 := hRcomp c.hom c.inv s
    rw [c.hom_inv_id, hRid, h2, map_zero] at h3
    exact h3
  · intro x
    rw [hAfix x, hH' x]
    constructor
    · rintro ⟨s, hs⟩
      refine ⟨((wcRq D.f ℓ (n - 1)).obj.map c.hom.op).hom s, ?_⟩
      have h3 := hRcomp c.inv c.hom s
      rw [c.inv_hom_id, hRid] at h3
      rw [hRcomp, ← h3, ← hs, hΘ]
    · rintro ⟨s, hs⟩
      refine ⟨((wcRq D.f ℓ (n - 1)).obj.map c.inv.op).hom s, ?_⟩
      rw [hΘ, ← hRcomp]
      exact hs

theorem wc_pencil_point_fibre_smooth (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (K : Type u) [Field K] (t : Spec (.of K) ⟶ (wcP1Over F'').left)
    (ht : ∀ i, t (IsLocalRing.closedPoint K) ≠ D.S i (IsLocalRing.closedPoint F'')) :
    IsProper (Limits.pullback.snd D.f t) ∧
      SmoothOfRelativeDimension (n - 1) (Limits.pullback.snd D.f t) :=
by
  classical
  have hB := IsPullback.of_hasPullback D.f t
  refine ⟨?_, ?_⟩
  · haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
    haveI : IsSeparated (wcP1Over F'').hom := by
      dsimp only [wcP1Over, wcProjKStr, Over.mk_hom]
      infer_instance
    haveI : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
    infer_instance
  · haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension (n - 1)) :=
      HasRingHomProperty.instIsZariskiLocalAtSource
    haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension n) :=
      HasRingHomProperty.instIsZariskiLocalAtSource
    have hpt : ∀ x : (Limits.pullback D.f t : Scheme), ∃ U : D.Yt.left.Opens,
        (Limits.pullback.fst D.f t) x ∈ U ∧ Smooth (U.ι ≫ D.f) := by
      intro x
      apply D.smooth_off
      intro i hi
      have h1 : D.f ((Limits.pullback.fst D.f t) x) =
          (D.S i) (IsLocalRing.closedPoint F'') := by
        rw [hi, ← D.hxs i]
        rfl
      have h2 : D.f ((Limits.pullback.fst D.f t) x) =
          t ((Limits.pullback.snd D.f t) x) := by
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
      have h3 : (Limits.pullback.snd D.f t) x = IsLocalRing.closedPoint K :=
        Subsingleton.elim _ _
      have h4 := h2.symm.trans h1
      rw [h3] at h4
      exact ht i h4
    choose U hU hUs using hpt
    have hUd : ∀ x, SmoothOfRelativeDimension (n - 1) ((U x).ι ≫ D.f) := by
      intro x
      haveI := hUs x
      haveI := wc_p1_smooth_reldim_one F''
      haveI : SmoothOfRelativeDimension n (((U x).ι ≫ D.f) ≫ (wcP1Over F'').hom) := by
        rw [Category.assoc, D.hf]
        exact IsZariskiLocalAtSource.comp D.smooth (U x).ι
      exact wc_smooth_reldim_of_comp_reldim ((U x).ι ≫ D.f) (wcP1Over F'').hom n 1
    refine IsZariskiLocalAtSource.of_iSup_eq_top
      (fun x => (Limits.pullback.fst D.f t) ⁻¹ᵁ (U x)) ?_ ?_
    · rw [eq_top_iff]
      intro x _
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨x, hU x⟩
    · intro x
      have hsq := IsPullback.paste_vert
        (isPullback_morphismRestrict (Limits.pullback.fst D.f t) (U x)) hB
      exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (n - 1)) hsq (hUd x)

theorem wc_pencil_point_fibre_gi (F' F'' : Type u) [Field F'] [Field F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (K : Type u) [Field K] (t : Spec (.of K) ⟶ (wcP1Over F'').left) (d : ℕ)
    [SmoothOfRelativeDimension d (Limits.pullback.snd D.f t)] :
    GeometricallyIrreducible (Limits.pullback.snd D.f t) :=
by
  classical
  have hB := IsPullback.of_hasPullback D.f t
  rw [GeometricallyIrreducible.eq_geometrically]
  intro L _ y Z fst snd h
  haveI hsd : SmoothOfRelativeDimension d snd :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d) h inferInstance
  haveI : Smooth snd := SmoothOfRelativeDimension.smooth d snd
  haveI : IsLocallyNoetherian Z := LocallyOfFiniteType.isLocallyNoetherian snd
  have hdom : ∀ w : Z, IsDomain (Z.presheaf.stalk w) := fun w =>
    wcpa_smooth_stalk_isDomain L Z snd d w
  haveI : ConnectedSpace Z := by
    let yb : Spec (.of (AlgebraicClosure L)) ⟶ Spec (.of L) :=
      Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L)))
    have hZ' := IsPullback.paste_horiz h hB
    haveI := D.fconn (AlgebraicClosure L) (yb ≫ y ≫ t)
    have hQ := IsPullback.of_hasPullback D.f (yb ≫ y ≫ t)
    have w : Limits.pullback.fst D.f (yb ≫ y ≫ t) ≫ D.f =
        (Limits.pullback.snd D.f (yb ≫ y ≫ t) ≫ yb) ≫ (y ≫ t) := by
      rw [Limits.pullback.condition, Category.assoc]
    let c := hZ'.lift _ _ w
    have hc1 : c ≫ (fst ≫ Limits.pullback.fst D.f t) =
        Limits.pullback.fst D.f (yb ≫ y ≫ t) := hZ'.lift_fst _ _ w
    have hc2 : c ≫ snd = Limits.pullback.snd D.f (yb ≫ y ≫ t) ≫ yb := hZ'.lift_snd _ _ w
    have houter : IsPullback (c ≫ (fst ≫ Limits.pullback.fst D.f t))
        (Limits.pullback.snd D.f (yb ≫ y ≫ t)) D.f (yb ≫ (y ≫ t)) := by
      rw [hc1]; exact hQ
    have hc : IsPullback c (Limits.pullback.snd D.f (yb ≫ y ≫ t)) snd yb :=
      IsPullback.of_right houter hc2 hZ'
    haveI : Surjective c := MorphismProperty.of_isPullback (P := @Surjective) hc.flip inferInstance
    exact Function.Surjective.connectedSpace (Surjective.surj (f := c)) c.continuous
  exact wcpa_irreducible_of_connected_domain_stalks Z hdom

theorem wc_pencil_strict_local_closed_fibre_model (F' F'' : Type u) [Field F'] [Field F'']
    [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ)
    (D : wcLefschetzDatum F' F'' Y n)
    (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A))
    (hcl : IsClosed ({V.hom (e.inv (IsLocalRing.closedPoint A))} : Set (wcP1Over F'').left)) :
    ∃ (K : Type u) (_ : Field K) (_ : Finite K) (t : Spec (.of K) ⟶ (wcP1Over F'').left),
      t (IsLocalRing.closedPoint K) = V.hom (e.inv (IsLocalRing.closedPoint A)) ∧
      (∃ m : ℕ, Nat.card K = Nat.card F'' ^ m) ∧
      ∃ (σ : AlgebraicClosure K →+* IsLocalRing.ResidueField A) (X₀ : Scheme.{u})
        (i : X₀ ⟶ Limits.pullback V.hom D.f)
        (p : X₀ ⟶ Spec (.of (IsLocalRing.ResidueField A)))
        (π : X₀ ⟶ wcXbar K (Over.mk (Limits.pullback.snd D.f t))),
        IsPullback i p (Limits.pullback.fst V.hom D.f ≫ e.hom)
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))) ∧
        IsPullback π p (wcPi2 K (Over.mk (Limits.pullback.snd D.f t)))
          (Spec.map (CommRingCat.ofHom σ)) :=
by
  classical

  have s1 : ∀ (k₀ : Type u) [Field k₀] [Finite k₀] (X : Scheme.{u})
      (q : X ⟶ Spec (.of k₀)) [LocallyOfFiniteType q] (x : X), IsClosed ({x} : Set X) →
      Finite ↑(X.residueField x) ∧ ∃ m : ℕ, Nat.card ↑(X.residueField x) = Nat.card k₀ ^ m := by
    intro k₀ _ _ X q _ x hx
    haveI : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace q
    haveI : LocallyOfFiniteType (X.fromSpecResidueField x) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hx
    set g := X.fromSpecResidueField x ≫ q with hg
    have hψ : Spec.map (Spec.preimage g) = g := Spec.map_preimage g
    have hft : (Spec.preimage g).hom.FiniteType := by
      have : LocallyOfFiniteType (Spec.map (Spec.preimage g)) := by rw [hψ]; infer_instance
      exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp this
    letI : Algebra k₀ (X.residueField x) := (Spec.preimage g).hom.toAlgebra
    haveI : Algebra.FiniteType k₀ (X.residueField x) := hft
    haveI : Module.Finite k₀ (X.residueField x) := finite_of_finite_type_of_isJacobsonRing k₀ _
    exact ⟨Module.finite_of_finite k₀, Module.finrank k₀ (X.residueField x),
      Module.natCard_eq_pow_finrank⟩

  have s2 : ∀ (k : Type u) [Field k] [IsSepClosed k] (X : Scheme.{u}) (x : X)
      [Finite ↑(X.residueField x)] (g : Spec (.of k) ⟶ X), g (IsLocalRing.closedPoint k) = x →
      ∃ σ : AlgebraicClosure ↑(X.residueField x) →+* k,
        g = Spec.map (CommRingCat.ofHom σ) ≫
          Spec.map (CommRingCat.ofHom (algebraMap ↑(X.residueField x)
            (AlgebraicClosure ↑(X.residueField x)))) ≫ X.fromSpecResidueField x := by
    intro k _ _ X x _ g hg
    subst hg
    have hfac := Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField k X g
    set ψ := Scheme.descResidueField (Scheme.stalkClosedPointTo g) with hψdef
    letI : Algebra ↑(X.residueField (g (IsLocalRing.closedPoint k))) k := ψ.hom.toAlgebra
    let σ' : AlgebraicClosure ↑(X.residueField (g (IsLocalRing.closedPoint k))) →ₐ[
        ↑(X.residueField (g (IsLocalRing.closedPoint k)))] k := IsSepClosed.lift
    refine ⟨σ'.toRingHom, ?_⟩
    have hσ : (σ'.toRingHom).comp (algebraMap _ (AlgebraicClosure _)) = ψ.hom := by
      ext z
      exact σ'.commutes z
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hσ, CommRingCat.ofHom_hom]
    exact hfac.symm

  have s3 : ∀ {Yt P Vl Sa Sk SKb SK X₀ : Scheme.{u}} (f : Yt ⟶ P) (v : Vl ⟶ P) (ε : Vl ≅ Sa)
      (r : Sk ⟶ Sa) (s : Sk ⟶ SKb) (a : SKb ⟶ SK) (t : SK ⟶ P),
      r ≫ ε.inv ≫ v = s ≫ a ≫ t → ∀ (i : X₀ ⟶ Limits.pullback v f) (p : X₀ ⟶ Sk),
      IsPullback i p (Limits.pullback.fst v f ≫ ε.hom) r →
      ∃ π : X₀ ⟶ Limits.pullback (Limits.pullback.snd f t) a,
        IsPullback π p (Limits.pullback.snd (Limits.pullback.snd f t) a) s := by
    intro Yt P Vl Sa Sk SKb SK X₀ f v ε r s a t h i p hi
    have hA : IsPullback i p (Limits.pullback.fst v f) (r ≫ ε.inv) :=
      hi.of_iso (Iso.refl _) (Iso.refl _) (Iso.refl _) ε.symm (by simp) (by simp) (by simp)
        (by simp)
    have hbig := hA.flip.paste_vert (IsPullback.of_hasPullback v f)
    have hbar := (IsPullback.of_hasPullback (Limits.pullback.snd f t) a).flip.paste_vert
      (IsPullback.of_hasPullback f t).flip
    have hv : (r ≫ ε.inv) ≫ v = s ≫ (a ≫ t) := by rw [Category.assoc, h]
    have hw : (i ≫ Limits.pullback.snd v f) ≫ f = (p ≫ s) ≫ (a ≫ t) := by
      rw [← hbig.w, hv, Category.assoc]
    let π := hbar.flip.lift (i ≫ Limits.pullback.snd v f) (p ≫ s) hw
    have e1 : π ≫ (Limits.pullback.fst (Limits.pullback.snd f t) a ≫ Limits.pullback.fst f t) =
        i ≫ Limits.pullback.snd v f := hbar.flip.lift_fst _ _ _
    have e2 : π ≫ Limits.pullback.snd (Limits.pullback.snd f t) a = p ≫ s :=
      hbar.flip.lift_snd _ _ _
    refine ⟨π, ?_⟩
    have hE1 : IsPullback p (π ≫ (Limits.pullback.fst (Limits.pullback.snd f t) a ≫
        Limits.pullback.fst f t)) (s ≫ (a ≫ t)) f := by
      rw [e1, ← hv]; exact hbig
    exact (IsPullback.of_bot hE1 e2.symm hbar).flip



  have hloft : LocallyOfFiniteType (@Proj.toSpecZero _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'') MvPolynomial.gradedAlgebra ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap F'' ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0)))) := by
    have hsurj : Function.Surjective
        (algebraMap F'' ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0)) := by
      rintro ⟨p, hp⟩
      have h0 : p.totalDegree = 0 := by
        rw [MvPolynomial.mem_homogeneousSubmodule] at hp
        exact Nat.le_zero.mp hp.totalDegree_le
      refine ⟨p.coeff 0, ?_⟩
      apply Subtype.ext
      rw [MvPolynomial.totalDegree_eq_zero_iff_eq_C] at h0
      exact h0.symm
    have hft : (algebraMap ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0)
        (MvPolynomial (Fin (1 + 1)) F'')).FiniteType := by
      apply RingHom.FiniteType.of_comp_finiteType
        (f := algebraMap F'' ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0))
      have : (algebraMap ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0)
          (MvPolynomial (Fin (1 + 1)) F'')).comp
            (algebraMap F'' ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0)) =
          algebraMap F'' (MvPolynomial (Fin (1 + 1)) F'') := by
        ext c
        rfl
      rw [this, RingHom.finiteType_algebraMap]
      infer_instance
    haveI : Algebra.FiniteType ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0)
        (MvPolynomial (Fin (1 + 1)) F'') := RingHom.finiteType_algebraMap.mp hft
    haveI : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom
        (algebraMap F'' ↥(MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) F'' 0)))) :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mpr
        (RingHom.FiniteType.of_surjective _ hsurj)
    infer_instance
  haveI : LocallyOfFiniteType (wcP1Over F'').hom := hloft
  obtain ⟨hfin, m, hm⟩ := s1 F'' (wcP1Over F'').left (wcP1Over F'').hom
    (V.hom (e.inv (IsLocalRing.closedPoint A))) hcl
  haveI := hfin
  haveI : IsLocalHom (CommRingCat.ofHom (IsLocalRing.residue A)).hom :=
    inferInstanceAs (IsLocalHom (IsLocalRing.residue A))
  have hg : (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ e.inv ≫ V.hom)
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
      V.hom (e.inv (IsLocalRing.closedPoint A)) := by
    change V.hom (e.inv ((Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)))) = _
    rw [Spec_closedPoint]
  obtain ⟨σ, hσ⟩ := s2 (IsLocalRing.ResidueField A) (wcP1Over F'').left _ _ hg
  refine ⟨↑((wcP1Over F'').left.residueField (V.hom (e.inv (IsLocalRing.closedPoint A)))),
    inferInstance, hfin,
    (wcP1Over F'').left.fromSpecResidueField (V.hom (e.inv (IsLocalRing.closedPoint A))),
    Scheme.fromSpecResidueField_apply _ _, ⟨m, hm⟩, σ,
    Limits.pullback (Limits.pullback.fst V.hom D.f ≫ e.hom)
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))),
    Limits.pullback.fst _ _, Limits.pullback.snd _ _, ?_⟩
  obtain ⟨π, hπ⟩ := s3 D.f V.hom e _ _ _ _ hσ
    (Limits.pullback.fst (Limits.pullback.fst V.hom D.f ≫ e.hom)
      (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))
    (Limits.pullback.snd _ _) (IsPullback.of_hasPullback _ _)
  exact ⟨π, IsPullback.of_hasPullback _ _, hπ⟩

theorem wc_closed_fibre_xbar_zmod_pull_bij {X X₀ : Scheme.{u}} (A : Type u) [CommRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (fA : X ⟶ Spec (.of A)) [IsProper fA] [CompactSpace X] [QuasiSeparatedSpace X]
    (i : X₀ ⟶ X) (p : X₀ ⟶ Spec (.of (IsLocalRing.ResidueField A)))
    (hi : IsPullback i p fA (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))))
    (K : Type u) [Field K] [Finite K] (Z : Over (Spec (.of K))) [GeometricallyIrreducible Z.hom]
    [IsProper Z.hom] (d : ℕ) [SmoothOfRelativeDimension d Z.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (σ : AlgebraicClosure K →+* IsLocalRing.ResidueField A) (π : X₀ ⟶ wcXbar K Z)
    (hπ : IsPullback π p (wcPi2 K Z) (Spec.map (CommRingCat.ofHom σ))) :
    (∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt X (ℓ ^ k) j)) ∧
    (∀ k j : ℕ, 1 ≤ k → ∀ Dk : wcZModPullData i (ℓ ^ k), wcZModPullCanonical Dk →
      Function.Bijective (wcZModPull Dk j)) ∧
    (∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt (wcXbar K Z) (ℓ ^ k) j)) ∧
    (∀ k j : ℕ, 1 ≤ k → ∀ Dk : wcZModPullData π (ℓ ^ k), wcZModPullCanonical Dk →
      Function.Bijective (wcZModPull Dk j)) :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out

  have hpos : ∀ k : ℕ, 0 < ℓ ^ k := fun k => pow_pos hℓp.pos k
  have hne : ∀ k : ℕ, ℓ ^ k ≠ 0 := fun k => (hpos k).ne'
  have hcast : ∀ k : ℕ, 1 ≤ k → ((ℓ ^ k : ℕ) : AlgebraicClosure K) ≠ 0 := by
    intro k hk h
    have hK : ((ℓ ^ k : ℕ) : K) = 0 := by
      apply (algebraMap K (AlgebraicClosure K)).injective
      rw [map_natCast, map_zero]
      exact h
    haveI := ringChar.charP K
    have hc : (ringChar K).Prime := CharP.char_is_prime K (ringChar K)
    have h1 : ringChar K ∣ ℓ ^ k := (CharP.cast_eq_zero_iff K (ringChar K) _).mp hK
    have h2 : ringChar K = ℓ := (Nat.prime_dvd_prime_iff_eq hc hℓp).mp (hc.dvd_of_dvd_pow h1)
    letI := Fintype.ofFinite K
    have h3 : ringChar K ∣ Fintype.card K :=
      (CharP.cast_eq_zero_iff K (ringChar K) _).mp (FiniteField.cast_card_eq_zero K)
    rw [h2, ← Nat.card_eq_fintype_card] at h3
    exact hℓ h3

  haveI hPi : IsProper (wcPi2 K Z) := inferInstance
  haveI : CompactSpace (wcXbar K Z) := QuasiCompact.compactSpace_of_compactSpace (wcPi2 K Z)
  haveI : QuasiSeparatedSpace (wcXbar K Z) := quasiSeparatedSpace_of_quasiSeparated (wcPi2 K Z)
  haveI hp : IsProper p := MorphismProperty.of_isPullback (P := @IsProper) hi inferInstance
  haveI : CompactSpace X₀ := QuasiCompact.compactSpace_of_compactSpace p
  haveI : QuasiSeparatedSpace X₀ := quasiSeparatedSpace_of_quasiSeparated p

  have c4 : ∀ k j : ℕ, 1 ≤ k → ∀ Dk : wcZModPullData π (ℓ ^ k), wcZModPullCanonical Dk →
      Function.Bijective (wcZModPull Dk j) := by
    intro k j hk Dk hDk
    obtain ⟨E⟩ := wc_et_zmod_pull_data_exists π (ℓ ^ k)
    have hE : Function.Bijective (wcEtPull E j) :=
      wc_et_sepclosed_field_ext_proper_pull_bij (AlgebraicClosure K)
        (IsLocalRing.ResidueField A) σ (wcXbar K Z) (wcPi2 K Z) X₀ π p hπ (ℓ ^ k)
        (hcast k hk) E j
    exact wc_zmod_proet_pull_bij_of_et_pull_bij π (ℓ ^ k) (hpos k) Dk hDk E j hE

  have c3 : ∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt (wcXbar K Z) (ℓ ^ k) j) :=
    wc_xbar_zmod_coh_finite K Z d ℓ hℓ

  have c0 : ∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt X₀ (ℓ ^ k) j) := by
    intro k j hk
    obtain ⟨Dπ, hDπ⟩ := wc_zmod_pull_data_exists π (ℓ ^ k)
    haveI := c3 k j hk
    exact Finite.of_surjective (wcZModPull Dπ j) (c4 k j hk Dπ hDπ).2

  have c2 : ∀ k j : ℕ, 1 ≤ k → ∀ Dk : wcZModPullData i (ℓ ^ k), wcZModPullCanonical Dk →
      Function.Bijective (wcZModPull Dk j) := by
    intro k j hk Dk hDk
    obtain ⟨E'⟩ := wc_et_zmod_pull_data_exists i (ℓ ^ k)
    have hE' : Function.Bijective (wcEtPull E' j) :=
      wc_r2gs_hens_closed_fibre_pull_bij A X fA (ℓ ^ k) (hne k)
        (fun A _ _ _ Y₀ f _ m' hm' S hS hS' q' =>
          wc_et_henselian_proper_vanishing A Y₀ f m' hm' S hS hS' q')
        X₀ i p hi E' j
    exact wc_zmod_proet_pull_bij_of_et_pull_bij i (ℓ ^ k) (hpos k) Dk hDk E' j hE'

  have c1 : ∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt X (ℓ ^ k) j) := by
    intro k j hk
    obtain ⟨Di, hDi⟩ := wc_zmod_pull_data_exists i (ℓ ^ k)
    haveI := c0 k j hk
    exact Finite.of_injective (wcZModPull Di j) (c2 k j hk Di hDi).1
  exact ⟨c1, c2, c3, c4⟩

theorem wc_pencil_fibre_hm_cup_perfect (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A))
    (hcl : IsClosed ({V.hom (e.inv (IsLocalRing.closedPoint A))} : Set (wcP1Over F'').left))
    (hoff : ∀ i, V.hom (e.inv (IsLocalRing.closedPoint A)) ≠ D.S i (IsLocalRing.closedPoint F'')) :
    (∀ x : wcHM ((wcProEtPullback D.f).obj V).left ℓ (n - 1),
      (∀ y : wcHM ((wcProEtPullback D.f).obj V).left ℓ (n - 1),
        wcHMCup ((wcProEtPullback D.f).obj V).left ℓ (n - 1) (n - 1) (2 * (n - 1))
          (two_mul (n - 1)).symm x y = 0) → x = 0) ∧
    (∀ y : wcHM ((wcProEtPullback D.f).obj V).left ℓ (n - 1),
      (∀ x : wcHM ((wcProEtPullback D.f).obj V).left ℓ (n - 1),
        wcHMCup ((wcProEtPullback D.f).obj V).left ℓ (n - 1) (n - 1) (2 * (n - 1))
          (two_mul (n - 1)).symm x y = 0) → y = 0) :=
by
  classical
  change (∀ x : wcHM (Limits.pullback V.hom D.f) ℓ (n - 1),
      (∀ y : wcHM (Limits.pullback V.hom D.f) ℓ (n - 1),
        wcHMCup (Limits.pullback V.hom D.f) ℓ (n - 1) (n - 1) (2 * (n - 1))
          (two_mul (n - 1)).symm x y = 0) → x = 0) ∧
    (∀ y : wcHM (Limits.pullback V.hom D.f) ℓ (n - 1),
      (∀ x : wcHM (Limits.pullback V.hom D.f) ℓ (n - 1),
        wcHMCup (Limits.pullback V.hom D.f) ℓ (n - 1) (n - 1) (2 * (n - 1))
          (two_mul (n - 1)).symm x y = 0) → y = 0)

  obtain ⟨K, _, _, t, ht, ⟨m, hm⟩, σ, X₀, i, p, π, hi, hπ⟩ :=
    wc_pencil_strict_local_closed_fibre_model F' F'' Y n D V A e hcl

  have hℓK : ¬ ℓ ∣ Nat.card K := by
    rw [hm]
    intro hd
    exact hℓ ((Fact.out : ℓ.Prime).dvd_of_dvd_pow hd)

  have ht' : ∀ j, t (IsLocalRing.closedPoint K) ≠ D.S j (IsLocalRing.closedPoint F'') := by
    intro j
    rw [ht]
    exact hoff j

  obtain ⟨hZp, hZs⟩ := wc_pencil_point_fibre_smooth F' F'' Y n D K t ht'
  haveI := hZs
  have hZg := wc_pencil_point_fibre_gi F' F'' Y n D K t (n - 1)
  haveI hZp' : IsProper (Over.mk (Limits.pullback.snd D.f t)).hom := hZp
  haveI hZs' : SmoothOfRelativeDimension (n - 1) (Over.mk (Limits.pullback.snd D.f t)).hom := hZs
  haveI hZg' : GeometricallyIrreducible (Over.mk (Limits.pullback.snd D.f t)).hom := hZg
  have hZ : WeaklyEtale (Limits.pullback.fst (Over.mk (Limits.pullback.snd D.f t)).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure K)

  obtain ⟨hc, hq, -, -⟩ := wc_pencil_nbhd_qcqs F' F'' Y n D V A e
  haveI : CompactSpace ↥(Limits.pullback V.hom D.f : Scheme.{u}) := hc
  haveI : QuasiSeparatedSpace ↥(Limits.pullback V.hom D.f : Scheme.{u}) := hq
  haveI : IsProper (D.f ≫ (wcP1Over F'').hom) := by rw [D.hf]; exact D.proper
  haveI : IsSeparated (wcP1Over F'').hom := by
    dsimp only [wcP1Over, wcProjKStr, Over.mk_hom]
    infer_instance
  haveI : IsProper D.f := IsProper.of_comp D.f (wcP1Over F'').hom
  haveI hfA : IsProper (Limits.pullback.fst V.hom D.f ≫ e.hom) := inferInstance
  haveI hp : IsProper p := MorphismProperty.of_isPullback (P := @IsProper) hi hfA
  haveI : CompactSpace X₀ := QuasiCompact.compactSpace_of_compactSpace p
  haveI : QuasiSeparatedSpace X₀ := quasiSeparatedSpace_of_quasiSeparated p
  haveI : CompactSpace (wcXbar K (Over.mk (Limits.pullback.snd D.f t))) :=
    QuasiCompact.compactSpace_of_compactSpace (wcPi2 K (Over.mk (Limits.pullback.snd D.f t)))
  haveI : QuasiSeparatedSpace (wcXbar K (Over.mk (Limits.pullback.snd D.f t))) :=
    quasiSeparatedSpace_of_quasiSeparated (wcPi2 K (Over.mk (Limits.pullback.snd D.f t)))

  obtain ⟨finX, bijI, finXb, bijPi⟩ := wc_closed_fibre_xbar_zmod_pull_bij A
    (Limits.pullback.fst V.hom D.f ≫ e.hom) i p hi K (Over.mk (Limits.pullback.snd D.f t))
    (n - 1) ℓ hℓK σ π hπ

  obtain ⟨Di, hDi⟩ := wc_hm_pull_data_exists i ℓ
  obtain ⟨Dπ, hDπ⟩ := wc_hm_pull_data_exists π ℓ
  have hΨ : ∀ q, Function.Bijective (wcHMPull Di q) := fun q =>
    wc_hm_pull_bij_of_zmod_pull_bij ℓ i Di hDi finX bijI q
  have hΛ : ∀ q, Function.Bijective (wcHMPull Dπ q) := fun q =>
    wc_hm_pull_bij_of_zmod_pull_bij ℓ π Dπ hDπ finXb bijPi q

  obtain ⟨Θ, hΘ⟩ := wc_modcoh_hm_cup_iso K (Over.mk (Limits.pullback.snd D.f t)) hZ ℓ

  obtain ⟨P1, P2⟩ := wc_modcup_perfect K (Over.mk (Limits.pullback.snd D.f t)) (n - 1) ℓ hℓK hZ
    (n - 1) (by omega)
  have key : ∀ (j : ℕ) (hj : j = n - 1) (hk : n - 1 + j = 2 * (n - 1)),
      (∀ x : wcModCoh K (Over.mk (Limits.pullback.snd D.f t)) hZ ℓ (n - 1),
        (∀ y : wcModCoh K (Over.mk (Limits.pullback.snd D.f t)) hZ ℓ j,
          wcModCup K (Over.mk (Limits.pullback.snd D.f t)) hZ ℓ (n - 1) j (2 * (n - 1)) hk x y = 0) →
          x = 0) ∧
      (∀ y : wcModCoh K (Over.mk (Limits.pullback.snd D.f t)) hZ ℓ j,
        (∀ x : wcModCoh K (Over.mk (Limits.pullback.snd D.f t)) hZ ℓ (n - 1),
          wcModCup K (Over.mk (Limits.pullback.snd D.f t)) hZ ℓ (n - 1) j (2 * (n - 1)) hk x y = 0) →
          y = 0) := by
    intro j hj hk
    have hj' : j = 2 * (n - 1) - (n - 1) := by omega
    subst hj'
    exact ⟨P1, P2⟩
  obtain ⟨Q1, Q2⟩ := key (n - 1) rfl (two_mul (n - 1)).symm

  have hmul : ∀ w w' : wcModCoh K (Over.mk (Limits.pullback.snd D.f t)) hZ ℓ (n - 1),
      wcHMPull Dπ (2 * (n - 1)) (Θ (2 * (n - 1))
        (wcModCup K (Over.mk (Limits.pullback.snd D.f t)) hZ ℓ (n - 1) (n - 1) (2 * (n - 1))
          (two_mul (n - 1)).symm w w')) =
      wcHMCup X₀ ℓ (n - 1) (n - 1) (2 * (n - 1)) (two_mul (n - 1)).symm
        (wcHMPull Dπ (n - 1) (Θ (n - 1) w)) (wcHMPull Dπ (n - 1) (Θ (n - 1) w')) := by
    intro w w'
    rw [hΘ, wc_hm_pull_cup]
  have hpre : ∀ z : wcHM (Limits.pullback V.hom D.f) ℓ (n - 1),
      ∃ w₀, wcHMPull Dπ (n - 1) (Θ (n - 1) w₀) = wcHMPull Di (n - 1) z := by
    intro z
    obtain ⟨z', hz'⟩ := (hΛ (n - 1)).2 (wcHMPull Di (n - 1) z)
    exact ⟨(Θ (n - 1)).symm z', by rw [AddEquiv.apply_symm_apply, hz']⟩
  refine ⟨?_, ?_⟩
  ·
    intro a ha
    obtain ⟨w₀, hw₀⟩ := hpre a
    have hw0 : w₀ = 0 := by
      apply Q1 w₀
      intro w'
      obtain ⟨b, hb⟩ := (hΨ (n - 1)).2 (wcHMPull Dπ (n - 1) (Θ (n - 1) w'))
      apply (Θ (2 * (n - 1))).injective
      apply (hΛ (2 * (n - 1))).1
      rw [hmul, hw₀, ← hb,
        ← wc_hm_pull_cup Di (n - 1) (n - 1) (2 * (n - 1)) (two_mul (n - 1)).symm a b, ha b]
      simp only [map_zero]
    have h1 : wcHMPull Di (n - 1) a = 0 := by
      rw [← hw₀, hw0]
      simp only [map_zero]
    exact (hΨ (n - 1)).1 (h1.trans (map_zero _).symm)
  ·
    intro b hb
    obtain ⟨w₀, hw₀⟩ := hpre b
    have hw0 : w₀ = 0 := by
      apply Q2 w₀
      intro w'
      obtain ⟨a, ha⟩ := (hΨ (n - 1)).2 (wcHMPull Dπ (n - 1) (Θ (n - 1) w'))
      apply (Θ (2 * (n - 1))).injective
      apply (hΛ (2 * (n - 1))).1
      rw [hmul, hw₀, ← ha,
        ← wc_hm_pull_cup Di (n - 1) (n - 1) (2 * (n - 1)) (two_mul (n - 1)).symm a b, hb a]
      simp only [map_zero]
    have h1 : wcHMPull Di (n - 1) b = 0 := by
      rw [← hw₀, hw0]
      simp only [map_zero]
    exact (hΨ (n - 1)).1 (h1.trans (map_zero _).symm)

theorem wc_proet_natural_alt_pairing_extend (S : Scheme.{u}) (Good : S.ProEt → Prop)
    (hcov : ∀ U : S.ProEt,
      Sieve.generate (fun (W : S.ProEt) (_ : W ⟶ U) => Good W) ∈ Scheme.ProEt.topology S U)
    (G H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (ι : Type)
    (σG : ι → (G ⟶ G)) (σH : ι → (H ⟶ H))
    (β : ∀ V : S.ProEt, Good V →
      G.obj.obj (Opposite.op V) →+ G.obj.obj (Opposite.op V) →+ H.obj.obj (Opposite.op V))
    (hβ : ∀ (V V' : S.ProEt) (hV : Good V) (hV' : Good V') (a : V' ⟶ V)
      (y y' : G.obj.obj (Opposite.op V)),
      β V' hV' ((G.obj.map a.op).hom y) ((G.obj.map a.op).hom y') =
        (H.obj.map a.op).hom (β V hV y y'))
    (hβL : ∀ (V : S.ProEt) (hV : Good V) (c : ι) (y y' : G.obj.obj (Opposite.op V)),
      β V hV (((σG c).hom.app (Opposite.op V)).hom y) y' =
        ((σH c).hom.app (Opposite.op V)).hom (β V hV y y'))
    (hβA : ∀ (V : S.ProEt) (hV : Good V) (y y' : G.obj.obj (Opposite.op V)),
      β V hV y y' = -(β V hV y' y)) :
    ∃ B : ∀ V : S.ProEt,
        G.obj.obj (Opposite.op V) →+ G.obj.obj (Opposite.op V) →+ H.obj.obj (Opposite.op V),
      (∀ (V V' : S.ProEt) (a : V' ⟶ V) (y y' : G.obj.obj (Opposite.op V)),
        B V' ((G.obj.map a.op).hom y) ((G.obj.map a.op).hom y') = (H.obj.map a.op).hom (B V y y')) ∧
      (∀ (V : S.ProEt) (c : ι) (y y' : G.obj.obj (Opposite.op V)),
        B V (((σG c).hom.app (Opposite.op V)).hom y) y' = ((σH c).hom.app (Opposite.op V)).hom (B V y y')) ∧
      (∀ (V : S.ProEt) (y y' : G.obj.obj (Opposite.op V)), B V y y' = -(B V y' y)) ∧
      (∀ (V : S.ProEt) (hV : Good V) (y y' : G.obj.obj (Opposite.op V)), B V y y' = β V hV y y') :=
by
  classical

  have hF : ∀ (K : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) {V W Z : S.ProEt}
      (k : Z ⟶ W) (g : W ⟶ V) (x : K.obj.obj (Opposite.op V)),
      (K.obj.map (k ≫ g).op).hom x = (K.obj.map k.op).hom ((K.obj.map g.op).hom x) := by
    intro K V W Z k g x
    rw [op_comp, Functor.map_comp]
    rfl

  have hN : ∀ (K : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (σ : K ⟶ K)
      {V W : S.ProEt} (g : W ⟶ V) (y : K.obj.obj (Opposite.op V)),
      (σ.hom.app (Opposite.op W)).hom ((K.obj.map g.op).hom y) =
        (K.obj.map g.op).hom ((σ.hom.app (Opposite.op V)).hom y) := by
    intro K σ V W g y
    have h := congrArg (fun m => m.hom y) (σ.hom.naturality g.op)
    simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] using h

  have hP : Presieve.IsSheaf (Scheme.ProEt.topology S) (H.obj ⋙ forget AddCommGrpCat.{u+1}) :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      ((Presheaf.isSheaf_iff_isSheaf_forget _ H.obj (forget AddCommGrpCat.{u+1})).mp H.property)
  have hSF : ∀ U : S.ProEt, Presieve.IsSheafFor (H.obj ⋙ forget AddCommGrpCat.{u+1})
      (fun (W : S.ProEt) (_ : W ⟶ U) => Good W) :=
    fun U => hP.isSheafFor _ (hcov U)

  have hU : ∀ (U : S.ProEt) (t t' : H.obj.obj (Opposite.op U)),
      (∀ (W : S.ProEt) (g : W ⟶ U), Good W → (H.obj.map g.op).hom t = (H.obj.map g.op).hom t') →
      t = t' := by
    intro U t t' h
    exact (hSF U).isSeparatedFor.ext (fun W g hg => h W g hg)

  have hE : ∀ (V : S.ProEt) (y y' : G.obj.obj (Opposite.op V)),
      ∃ t : H.obj.obj (Opposite.op V), ∀ (W : S.ProEt) (g : W ⟶ V) (hW : Good W),
        (H.obj.map g.op).hom t = β W hW ((G.obj.map g.op).hom y) ((G.obj.map g.op).hom y') := by
    intro V y y'
    let x : Presieve.FamilyOfElements (H.obj ⋙ forget AddCommGrpCat.{u+1})
        (fun (W : S.ProEt) (_ : W ⟶ V) => Good W) :=
      fun W g hW => β W hW ((G.obj.map g.op).hom y) ((G.obj.map g.op).hom y')
    have hx : x.Compatible := by
      intro W₁ W₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
      change (H.obj.map g₁.op).hom
          (β W₁ h₁ ((G.obj.map f₁.op).hom y) ((G.obj.map f₁.op).hom y')) =
        (H.obj.map g₂.op).hom (β W₂ h₂ ((G.obj.map f₂.op).hom y) ((G.obj.map f₂.op).hom y'))
      apply hU Z
      intro Z' k hZ'
      rw [← hF H k g₁, ← hF H k g₂, ← hβ W₁ Z' h₁ hZ' (k ≫ g₁), ← hβ W₂ Z' h₂ hZ' (k ≫ g₂),
        ← hF G (k ≫ g₁) f₁, ← hF G (k ≫ g₁) f₁, ← hF G (k ≫ g₂) f₂, ← hF G (k ≫ g₂) f₂,
        Category.assoc, Category.assoc, comm]
    obtain ⟨t, ht, -⟩ := hSF V x hx
    exact ⟨t, fun W g hW => ht g hW⟩
  choose B₀ hB₀ using hE
  have addR : ∀ (V : S.ProEt) (y y₁ y₂ : G.obj.obj (Opposite.op V)),
      B₀ V y (y₁ + y₂) = B₀ V y y₁ + B₀ V y y₂ := by
    intro V y y₁ y₂
    apply hU V
    intro W g hW
    rw [map_add, hB₀ V y (y₁ + y₂) W g hW, hB₀ V y y₁ W g hW, hB₀ V y y₂ W g hW]
    simp only [map_add]
  have addL : ∀ (V : S.ProEt) (y₁ y₂ y' : G.obj.obj (Opposite.op V)),
      B₀ V (y₁ + y₂) y' = B₀ V y₁ y' + B₀ V y₂ y' := by
    intro V y₁ y₂ y'
    apply hU V
    intro W g hW
    rw [map_add, hB₀ V (y₁ + y₂) y' W g hW, hB₀ V y₁ y' W g hW, hB₀ V y₂ y' W g hW]
    simp only [map_add, AddMonoidHom.add_apply]
  obtain ⟨B, hB⟩ : ∃ B : ∀ V : S.ProEt,
      G.obj.obj (Opposite.op V) →+ G.obj.obj (Opposite.op V) →+ H.obj.obj (Opposite.op V),
      ∀ V y y', B V y y' = B₀ V y y' :=
    ⟨fun V => AddMonoidHom.mk' (fun y => AddMonoidHom.mk' (fun y' => B₀ V y y') (addR V y))
      (fun y₁ y₂ => AddMonoidHom.ext (fun y' => addL V y₁ y₂ y')), fun _ _ _ => rfl⟩
  refine ⟨B, ?_, ?_, ?_, ?_⟩
  · intro V V' a y y'
    rw [hB, hB]
    apply hU V'
    intro W g hW
    rw [hB₀ V' _ _ W g hW, ← hF H g a, hB₀ V y y' W (g ≫ a) hW, ← hF G g a, ← hF G g a]
  · intro V c y y'
    rw [hB, hB]
    apply hU V
    intro W g hW
    rw [hB₀ V _ y' W g hW, ← hN H (σH c) g, hB₀ V y y' W g hW, ← hβL W hW c, hN G (σG c) g]
  · intro V y y'
    rw [hB, hB]
    apply hU V
    intro W g hW
    rw [map_neg, hB₀ V y y' W g hW, hB₀ V y' y W g hW,
      hβA W hW ((G.obj.map g.op).hom y) ((G.obj.map g.op).hom y')]
  · intro V hV y y'
    rw [hB]
    apply hU V
    intro W g hW
    rw [hB₀ V y y' W g hW, hβ V W hV hW g]

theorem wc_proet_projective_free_covering (S : Scheme.{u}) (U : S.ProEt) :
    Sieve.generate (fun (W : S.ProEt) (_ : W ⟶ U) => Projective (wcFreeSheaf S W)) ∈
      Scheme.ProEt.topology S U :=
by
  apply wc_proet_sieve_of_affine_finite_covers S U
  intro W v hW
  obtain ⟨Δ, δ, hΔa, hδwe, hδs, hcl, hsp, hed, hloc⟩ := wc_exists_wcontractible_cover W.left hW
  have hcomp : WeaklyEtale (δ ≫ W.hom) := by
    haveI := hδwe
    haveI : WeaklyEtale W.hom := W.prop
    exact inferInstance
  let W₀ : S.ProEt := MorphismProperty.Over.mk ⊤ (δ ≫ W.hom) hcomp
  let e₀ : W₀ ⟶ W := MorphismProperty.Over.homMk δ rfl trivial
  have hproj : Projective (wcFreeSheaf S W₀) :=
    wc_proet_free_projective_wcontractible S W₀ ⟨hΔa, hcl, hsp, hed, hloc⟩
  refine ⟨1, fun _ => W₀, fun _ => e₀, fun _ => hΔa, ?_, ?_⟩
  · intro y
    obtain ⟨x, hx⟩ := hδs.surj y
    exact ⟨0, x, hx⟩
  · intro _
    exact Sieve.le_generate _ _ (e₀ ≫ v) hproj

theorem wc_pencil_Rq_cup_pairing_alt (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    ∃ B : ∀ V : (wcP1Over F'').left.ProEt,
        (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V) →+
          (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V) →+
            (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V),
      (∀ (V V' : (wcP1Over F'').left.ProEt) (a : V' ⟶ V)
          (y y' : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
        B V' (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom y)
            (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom y') =
          ((wcRq D.f ℓ (2 * (n - 1))).obj.map a.op).hom (B V y y')) ∧
      (∀ (V : (wcP1Over F'').left.ProEt) (c : ℚ_[ℓ])
          (y y' : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
        B V (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom y) y' =
          ((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op V)).hom (B V y y')) ∧
      (∀ (V : (wcP1Over F'').left.ProEt)
          (y y' : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
        B V y y' = -(B V y' y)) ∧
      (∀ (V : (wcP1Over F'').left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
          [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)),
        IsClosed ({V.hom (e.inv (IsLocalRing.closedPoint A))} : Set (wcP1Over F'').left) →
        (∀ i, V.hom (e.inv (IsLocalRing.closedPoint A)) ≠ D.S i (IsLocalRing.closedPoint F'')) →
        (∀ y, (∀ y', B V y y' = 0) → y = 0) ∧ (∀ y', (∀ y, B V y y' = 0) → y' = 0)) :=
by
  classical

  obtain ⟨Φ, hΦs, hΦn⟩ := wc_pencil_Rq_hm_comparison F' F'' Y n D ℓ

  obtain ⟨β, hβdef⟩ : ∃ β : ∀ V : (wcP1Over F'').left.ProEt,
      Projective (wcFreeSheaf (wcP1Over F'').left V) →
      (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V) →+
        (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V) →+
          (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op V),
      ∀ V hV y y', β V hV y y' = (Φ (2 * (n - 1)) V hV).symm
          (wcHMCup ((wcProEtPullback D.f).obj V).left ℓ (n - 1) (n - 1) (2 * (n - 1))
            (two_mul (n - 1)).symm (Φ (n - 1) V hV y) (Φ (n - 1) V hV y')) :=
    ⟨fun V hV => AddMonoidHom.mk' (fun y => AddMonoidHom.mk' (fun y' =>
        (Φ (2 * (n - 1)) V hV).symm
          (wcHMCup ((wcProEtPullback D.f).obj V).left ℓ (n - 1) (n - 1) (2 * (n - 1))
            (two_mul (n - 1)).symm (Φ (n - 1) V hV y) (Φ (n - 1) V hV y')))
        (fun a b => by simp only [map_add]))
      (fun a b => AddMonoidHom.ext fun y' => by
        simp only [AddMonoidHom.mk'_apply, AddMonoidHom.add_apply, map_add]),
     fun _ _ _ _ => rfl⟩

  have hβ : ∀ (V V' : (wcP1Over F'').left.ProEt)
      (hV : Projective (wcFreeSheaf (wcP1Over F'').left V))
      (hV' : Projective (wcFreeSheaf (wcP1Over F'').left V')) (a : V' ⟶ V)
      (y y' : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      β V' hV' (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom y)
          (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom y') =
        ((wcRq D.f ℓ (2 * (n - 1))).obj.map a.op).hom (β V hV y y') := by
    intro V V' hV hV' a y y'
    obtain ⟨Da, hDa⟩ := wc_hm_pull_data_exists ((wcProEtPullback D.f).map a).left ℓ
    rw [hβdef, hβdef, hΦn (n - 1) V V' hV hV' a Da hDa y, hΦn (n - 1) V V' hV hV' a Da hDa y',
      ← wc_hm_pull_cup]
    apply (Φ (2 * (n - 1)) V' hV').injective
    rw [AddEquiv.apply_symm_apply, hΦn (2 * (n - 1)) V V' hV hV' a Da hDa,
      AddEquiv.apply_symm_apply]

  have hβL : ∀ (V : (wcP1Over F'').left.ProEt)
      (hV : Projective (wcFreeSheaf (wcP1Over F'').left V)) (c : ℚ_[ℓ])
      (y y' : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      β V hV (((wcRqScalar D.f ℓ (n - 1) c).hom.app (Opposite.op V)).hom y) y' =
        ((wcRqScalar D.f ℓ (2 * (n - 1)) c).hom.app (Opposite.op V)).hom (β V hV y y') := by
    intro V hV c y y'
    rw [hβdef, hβdef, hΦs, (wc_hm_cup_scalar _ ℓ _ _ _ _ c _ _).1]
    apply (Φ (2 * (n - 1)) V hV).injective
    rw [AddEquiv.apply_symm_apply, hΦs, AddEquiv.apply_symm_apply]

  have hodd : Odd (n - 1) := Nat.Even.sub_odd (by omega) hn odd_one
  have hsign : ((-1 : ℤ) ^ ((n - 1) * (n - 1))) = -1 := (hodd.mul hodd).neg_one_pow
  have hβA : ∀ (V : (wcP1Over F'').left.ProEt)
      (hV : Projective (wcFreeSheaf (wcP1Over F'').left V))
      (y y' : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      β V hV y y' = -(β V hV y' y) := by
    intro V hV y y'
    rw [hβdef, hβdef, wc_hm_graded_comm _ ℓ (n - 1) (n - 1) (2 * (n - 1))
      (two_mul (n - 1)).symm (two_mul (n - 1)).symm, hsign, neg_one_zsmul, map_neg]

  obtain ⟨B, hN, hL, hA, hagree⟩ := wc_proet_natural_alt_pairing_extend (wcP1Over F'').left
    (fun V => Projective (wcFreeSheaf (wcP1Over F'').left V))
    (fun U => wc_proet_projective_free_covering (wcP1Over F'').left U)
    (wcRq D.f ℓ (n - 1)) (wcRq D.f ℓ (2 * (n - 1))) ℚ_[ℓ]
    (wcRqScalar D.f ℓ (n - 1)) (wcRqScalar D.f ℓ (2 * (n - 1))) β hβ hβL hβA
  refine ⟨B, hN, hL, hA, ?_⟩

  intro V A _ _ _ e hcl hoff
  have hV := wc_proet_free_projective_strict_local (wcP1Over F'').left V A e
  obtain ⟨hp1, hp2⟩ := wc_pencil_fibre_hm_cup_perfect F' F'' Y n hn hn2 D ℓ hℓ V A e hcl hoff
  constructor
  · intro y hy
    have h1 : Φ (n - 1) V hV y = 0 := by
      apply hp1
      intro z
      have h := hy ((Φ (n - 1) V hV).symm z)
      rw [hagree V hV, hβdef, AddEquiv.apply_symm_apply] at h
      have h2 := congrArg (Φ (2 * (n - 1)) V hV) h
      rwa [AddEquiv.apply_symm_apply, map_zero] at h2
    exact (Φ (n - 1) V hV).injective (h1.trans (map_zero _).symm)
  · intro y' hy'
    have h1 : Φ (n - 1) V hV y' = 0 := by
      apply hp2
      intro z
      have h := hy' ((Φ (n - 1) V hV).symm z)
      rw [hagree V hV, hβdef, AddEquiv.apply_symm_apply] at h
      have h2 := congrArg (Φ (2 * (n - 1)) V hV) h
      rwa [AddEquiv.apply_symm_apply, map_zero] at h2
    exact (Φ (n - 1) V hV).injective (h1.trans (map_zero _).symm)

theorem wc_pencil_PL_cup_form (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcRq D.f ℓ (n - 1)).over W ≅
      (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (hθc : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
          (wcRqScalar D.f ℓ (n - 1) c) ≫ θ.hom =
        θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
          AddCommGrpCat.{u+1} W).map (wcConstScalar (wcP1Over F'').left ℓ r c))
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin D.m), W.hom z ≠ D.S i (IsLocalRing.closedPoint F''))
    (hcov : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left,
      (∀ i : Fin D.m, (wcGeomPoint F'' (wcP1Over F'') hP).hom p ≠
        D.S i (IsLocalRing.closedPoint F'')) →
      ∃ z : W.left, w.left z = p)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ) :
    ∃ J : Matrix (Fin r) (Fin r) ℚ_[ℓ], J.transpose = -J ∧ IsUnit J.det ∧
      ∀ γ : W ⟶ W, γ ≫ w = w →
        ∀ g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]),
          (∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op W)) (z : W.left),
            (show C(↥W.left, Fin r → ℚ_[ℓ]) from
              ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
            g ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
              ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
          (LinearMap.toMatrix' g).transpose * J * LinearMap.toMatrix' g = J :=
by
  classical
  haveI := hconn

  have hcancel1 : ∀ (T : Over W) (s : ((wcRq D.f ℓ (n - 1)).over W).obj.obj (Opposite.op T)),
      (θ.inv.hom.app (Opposite.op T)).hom ((θ.hom.hom.app (Opposite.op T)).hom s) = s := by
    intro T s
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom s) θ.hom_inv_id
  have hcancel2 : ∀ (T : Over W)
      (x : ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op T)),
      (θ.hom.hom.app (Opposite.op T)).hom ((θ.inv.hom.app (Opposite.op T)).hom x) = x := by
    intro T x
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom x) θ.inv_hom_id
  have hinjθ : ∀ (T : Over W) (s s' : ((wcRq D.f ℓ (n - 1)).over W).obj.obj (Opposite.op T)),
      (θ.hom.hom.app (Opposite.op T)).hom s = (θ.hom.hom.app (Opposite.op T)).hom s' → s = s' := by
    intro T s s' h
    rw [← hcancel1 T s, ← hcancel1 T s', h]
  have hext : ∀ (V : (wcP1Over F'').left.ProEt) (h : V ⟶ W)
      (s s' : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)),
      (∀ v : V.left, (show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk h))).hom s).down) v =
        (show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk h))).hom s').down) v) → s = s' := by
    intro V h s s' hv
    apply hinjθ (Over.mk h) s s'
    apply ULift.ext
    apply ContinuousMap.ext
    exact hv

  have hnat : ∀ (V V' : (wcP1Over F'').left.ProEt) (h : V ⟶ W) (a : V' ⟶ V) (h' : V' ⟶ W),
      a ≫ h = h' → ∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)) (v : V'.left),
      (show C(↥V'.left, Fin r → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
        (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s)).down) v =
      (show C(↥V.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk h))).hom s).down) (a.left v) := by
    rintro V V' h a h' rfl s v
    have hN := θ.hom.hom.naturality (Over.homMk a rfl : Over.mk (a ≫ h) ⟶ Over.mk h).op
    exact congrArg (fun m => (show C(↥V'.left, Fin r → ℚ_[ℓ]) from (m.hom s).down) v) hN

  have hconst : ∀ x : Fin r → ℚ_[ℓ], ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op W),
      ∀ z : W.left, (show C(↥W.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z = x := by
    intro v
    let cv : (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op W) :=
      (show (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op W) from
        ULift.up (ContinuousMap.const ↥W.left v))
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom cv, fun z => ?_⟩
    have hs := hcancel2 (Over.mk (𝟙 W)) cv
    exact congrArg (fun y : ULift.{u+1} C(↥W.left, Fin r → ℚ_[ℓ]) => y.down z) hs
  choose c hc using hconst
  obtain ⟨z₀⟩ : Nonempty W.left := ConnectedSpace.toNonempty

  obtain ⟨V₀, -, φ₀, A, iR, iH, iS, e, ε, hv, -, hε, hεφ⟩ :=
    wc_P1bar_strict_local_nbhd F'' D.u0 D.hu0 hP
  have hx₀ : ∀ i, V₀.hom (e.inv (IsLocalRing.closedPoint A)) ≠ D.S i (IsLocalRing.closedPoint F'') :=
    fun i => by rw [hv]; exact D.hu0S i

  obtain ⟨ι⟩ : Nonempty (V₀ ⟶ W) := by
    haveI hsub : Subsingleton ↥(Spec (CommRingCat.of F'')) :=
      inferInstanceAs (Subsingleton (PrimeSpectrum F''))
    have hπ : (wcP1Over F'').hom (V₀.hom (e.inv (IsLocalRing.closedPoint A))) =
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))
          (IsLocalRing.closedPoint (AlgebraicClosure F'')) := Subsingleton.elim _ _
    obtain ⟨p, hp1, -⟩ := Scheme.Pullback.exists_preimage_pullback _ _ hπ
    have hp : (wcGeomPoint F'' (wcP1Over F'') hP).hom p =
        V₀.hom (e.inv (IsLocalRing.closedPoint A)) := hp1
    obtain ⟨z, hz⟩ := hcov p (fun i => by rw [hp]; exact hx₀ i)
    have hWz : W.hom z = V₀.hom (e.inv (IsLocalRing.closedPoint A)) := by
      rw [← MorphismProperty.Over.w w, Scheme.Hom.comp_apply, hz, hp]
    obtain ⟨t, ht1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := V₀.hom) (g := W.hom)
      (e.inv (IsLocalRing.closedPoint A)) z hWz.symm
    have hq : WeaklyEtale (Limits.pullback.fst V₀.hom W.hom) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback V₀.hom W.hom).flip
        W.prop
    haveI : WeaklyEtale (Limits.pullback.fst V₀.hom W.hom) := hq
    haveI : WeaklyEtale ((Limits.pullback V₀.hom W.hom).fromSpecStalk t) :=
      wc_fromSpecStalk_weaklyEtale _ t
    obtain ⟨k, hkdef⟩ : ∃ k, k = (Limits.pullback V₀.hom W.hom).fromSpecStalk t ≫
        Limits.pullback.fst V₀.hom W.hom ≫ e.hom := ⟨_, rfl⟩
    have hk : WeaklyEtale k := by rw [hkdef]; infer_instance
    have hφ : Spec.map (Spec.preimage k) = k := Spec.map_preimage k
    have hk' : WeaklyEtale (Spec.map (CommRingCat.ofHom (Spec.preimage k).hom)) := by
      change WeaklyEtale (Spec.map (Spec.preimage k))
      rw [hφ]; exact hk
    letI := (Spec.preimage k).hom.toAlgebra
    have hWE := wc_lpkt_specMap_weaklyEtale_ring _ _ (Spec.preimage k).hom hk'
    have hk_pt : k (IsLocalRing.closedPoint ((Limits.pullback V₀.hom W.hom).presheaf.stalk t)) =
        IsLocalRing.closedPoint A := by
      have h1 : k (IsLocalRing.closedPoint ((Limits.pullback V₀.hom W.hom).presheaf.stalk t)) =
          e.hom ((Limits.pullback.fst V₀.hom W.hom) ((Limits.pullback V₀.hom W.hom).fromSpecStalk t
            (IsLocalRing.closedPoint ((Limits.pullback V₀.hom W.hom).presheaf.stalk t)))) := by
        subst hkdef
        first | rfl | simp [Scheme.Hom.comp_apply]
      have h2 : ∀ y : Spec (CommRingCat.of A), e.hom (e.inv y) = y := by
        intro y
        first
          | simp
          | (rw [← Scheme.Hom.comp_apply, e.inv_hom_id]; rfl)
          | exact congrArg (fun f : Spec (CommRingCat.of A) ⟶ Spec (CommRingCat.of A) => f y) e.inv_hom_id
      rw [h1, Scheme.fromSpecStalk_closedPoint, ht1]
      first
        | exact h2 _
        | simp
        | exact congrArg (fun f : Spec (CommRingCat.of A) ⟶ Spec (CommRingCat.of A) => f _) e.inv_hom_id
    have hcomap : PrimeSpectrum.comap (Spec.preimage k).hom
        (IsLocalRing.closedPoint ((Limits.pullback V₀.hom W.hom).presheaf.stalk t)) =
        IsLocalRing.closedPoint A := by
      have h5 : (Spec.map (Spec.preimage k))
          (IsLocalRing.closedPoint ((Limits.pullback V₀.hom W.hom).presheaf.stalk t)) =
          PrimeSpectrum.comap (Spec.preimage k).hom
            (IsLocalRing.closedPoint ((Limits.pullback V₀.hom W.hom).presheaf.stalk t)) := by
        first | rfl | simp [Spec.map_base]
      rw [← h5, hφ]
      exact hk_pt
    have hloc : IsLocalHom (Spec.preimage k).hom :=
      (IsLocalRing.isLocalHom_iff_comap_closedPoint (Spec.preimage k).hom).mpr hcomap
    have hbij : Function.Bijective (Spec.preimage k).hom :=
      wc_olivier _ _ inferInstance inferInstance hloc hWE
    haveI : IsIso (Spec.preimage k) := (ConcreteCategory.isIso_iff_bijective _).mpr hbij
    haveI hkiso : IsIso k := by
      rw [← hφ]; infer_instance
    have hcq : (Limits.pullback V₀.hom W.hom).fromSpecStalk t ≫ Limits.pullback.fst V₀.hom W.hom =
        k ≫ e.inv := by
      rw [hkdef]; simp
    obtain ⟨s, hs⟩ : ∃ s : V₀.left ⟶ Limits.pullback V₀.hom W.hom,
        s ≫ Limits.pullback.fst V₀.hom W.hom = 𝟙 _ :=
      ⟨e.hom ≫ inv k ≫ (Limits.pullback V₀.hom W.hom).fromSpecStalk t, by
        rw [Category.assoc, Category.assoc, hcq, IsIso.inv_hom_id_assoc, Iso.hom_inv_id]⟩
    have hh : (s ≫ Limits.pullback.snd V₀.hom W.hom) ≫ W.hom = V₀.hom := by
      rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hs, Category.id_comp]
    exact ⟨MorphismProperty.Over.homMk (s ≫ Limits.pullback.snd V₀.hom W.hom) hh trivial⟩

  have hV₀ : ConnectedSpace V₀.left := by
    have hspec : ∀ y : V₀.left, y ⤳ e.inv (IsLocalRing.closedPoint A) := by
      intro y
      have h1 : e.hom y ⤳ IsLocalRing.closedPoint A := IsLocalRing.specializes_closedPoint _
      have h2 := h1.map e.inv.continuous
      have h3 : e.inv (e.hom y) = y := by
        first
          | simp
          | (rw [← Scheme.Hom.comp_apply, e.hom_inv_id]; rfl)
          | exact congrArg (fun f : V₀.left ⟶ V₀.left => f y) e.hom_inv_id
      rwa [h3] at h2
    rw [connectedSpace_iff_clopen]
    refine ⟨⟨e.inv (IsLocalRing.closedPoint A)⟩, fun U hU => ?_⟩
    by_cases h0 : e.inv (IsLocalRing.closedPoint A) ∈ U
    · right
      ext y
      simp only [Set.mem_univ, iff_true]
      exact (hspec y).mem_open hU.isOpen h0
    · left
      ext y
      simp only [Set.mem_empty_iff_false, iff_false]
      intro hy
      exact ((hspec y).mem_open hU.compl.isOpen h0) hy
  haveI := hV₀

  have hclosed : IsClosed ({V₀.hom (e.inv (IsLocalRing.closedPoint A))} :
      Set (wcP1Over F'').left) := by
    have hcl := (wc_P1_sections_closed_generize F'' 1 (fun _ => D.u0) (fun _ => D.hu0)).1
    have hset : {p : (wcP1Over F'').left | ∃ i : Fin 1, p = D.u0 (IsLocalRing.closedPoint F'')} =
        {V₀.hom (e.inv (IsLocalRing.closedPoint A))} := by
      ext p
      rw [Set.mem_setOf_eq, Set.mem_singleton_iff, hv]
      constructor
      · rintro ⟨_, h⟩; exact h
      · intro h; exact ⟨0, h⟩
    rw [← hset]
    exact hcl

  obtain ⟨B, hBnat, hBsc, hBalt, hBperf⟩ :=
    wc_pencil_Rq_cup_pairing_alt F' F'' Y n hn hn2 D ℓ hℓ hP
  obtain ⟨-, hperfR⟩ := hBperf V₀ A e hclosed hx₀
  obtain ⟨L, hLinj, hLsc⟩ :=
    wc_pencil_R2_u0_strict_line F' F'' Y n hn2 D ℓ hℓ V₀ φ₀ A e ε hv hε hεφ

  obtain ⟨v0⟩ : Nonempty V₀.left := ⟨e.inv (IsLocalRing.closedPoint A)⟩
  have hlc : ∀ (f : C(↥V₀.left, Fin r → ℚ_[ℓ])) (v : V₀.left), f v = f v0 := by
    intro f v
    exact (isPreconnected_range f.continuous).subsingleton ⟨v, rfl⟩ ⟨v0, rfl⟩
  let τ : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V₀) →+ (Fin r → ℚ_[ℓ]) :=
    AddMonoidHom.mk' (fun t => (show C(↥V₀.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk ι))).hom t).down) v0)
      (fun t t' => by
        have h := map_add (θ.hom.hom.app (Opposite.op (Over.mk ι))).hom t t'
        exact congrArg (fun y : ULift.{u+1} C(↥V₀.left, Fin r → ℚ_[ℓ]) => y.down v0) h)
  have hτsc : ∀ (a : ℚ_[ℓ]) (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V₀)),
      τ (((wcRqScalar D.f ℓ (n - 1) a).hom.app (Opposite.op V₀)).hom t) = a • τ t := by
    intro a t
    have h := congrArg (fun m => (m.hom.app (Opposite.op (Over.mk ι))).hom t) (hθc a)
    exact congrArg (fun y : ULift.{u+1} C(↥V₀.left, Fin r → ℚ_[ℓ]) => y.down v0) h
  have hτc : ∀ x, τ (((wcRq D.f ℓ (n - 1)).obj.map ι.op).hom (c x)) = x := by
    intro x
    show (show C(↥V₀.left, Fin r → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk ι))).hom
      (((wcRq D.f ℓ (n - 1)).obj.map ι.op).hom (c x))).down) v0 = x
    rw [hnat W V₀ (𝟙 W) ι ι (Category.comp_id ι) (c x) v0, hc]
  have hτinj : Function.Injective τ := by
    rw [injective_iff_map_eq_zero]
    intro t ht
    apply hext V₀ ι t 0
    intro v
    have h1 : (show C(↥V₀.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk ι))).hom t).down) v = τ t := hlc _ v
    have h2 : (show C(↥V₀.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk ι))).hom 0).down) v = 0 := by
      have h := map_zero (θ.hom.hom.app (Opposite.op (Over.mk ι))).hom
      exact congrArg (fun y : ULift.{u+1} C(↥V₀.left, Fin r → ℚ_[ℓ]) => y.down v) h
    rw [h1, ht]
    exact h2.symm
  have hτsurj : Function.Surjective τ := fun x =>
    ⟨((wcRq D.f ℓ (n - 1)).obj.map ι.op).hom (c x), hτc x⟩
  let eτ := AddEquiv.ofBijective τ ⟨hτinj, hτsurj⟩
  have heτ : ∀ t, eτ t = τ t := fun t => rfl
  have hσsc : ∀ (a : ℚ_[ℓ]) (x : Fin r → ℚ_[ℓ]), eτ.symm (a • x) =
      ((wcRqScalar D.f ℓ (n - 1) a).hom.app (Opposite.op V₀)).hom (eτ.symm x) := by
    intro a x
    apply eτ.injective
    rw [AddEquiv.apply_symm_apply, heτ, hτsc, ← heτ, AddEquiv.apply_symm_apply]
  have hσc : ∀ x, eτ.symm x = ((wcRq D.f ℓ (n - 1)).obj.map ι.op).hom (c x) := by
    intro x
    apply eτ.injective
    rw [AddEquiv.apply_symm_apply, heτ, hτc]

  let Bil : (Fin r → ℚ_[ℓ]) → (Fin r → ℚ_[ℓ]) → ℚ_[ℓ] := fun x y =>
    L (B V₀ (eτ.symm x) (eτ.symm y))
  have hBalt' : ∀ x y, Bil x y = -Bil y x := by
    intro x y
    show L (B V₀ (eτ.symm x) (eτ.symm y)) = -L (B V₀ (eτ.symm y) (eτ.symm x))
    rw [hBalt V₀ (eτ.symm x) (eτ.symm y), map_neg]
  have hadd1 : ∀ x x' y, Bil (x + x') y = Bil x y + Bil x' y := by
    intro x x' y
    show L (B V₀ (eτ.symm (x + x')) (eτ.symm y)) =
      L (B V₀ (eτ.symm x) (eτ.symm y)) + L (B V₀ (eτ.symm x') (eτ.symm y))
    simp only [map_add, AddMonoidHom.add_apply]
  have hsmul1 : ∀ (a : ℚ_[ℓ]) x y, Bil (a • x) y = a • Bil x y := by
    intro a x y
    show L (B V₀ (eτ.symm (a • x)) (eτ.symm y)) = a • L (B V₀ (eτ.symm x) (eτ.symm y))
    rw [hσsc, hBsc, hLsc, smul_eq_mul]
  have hadd2 : ∀ x y y', Bil x (y + y') = Bil x y + Bil x y' := by
    intro x y y'
    linear_combination hBalt' x (y + y') - hadd1 y y' x - hBalt' x y - hBalt' x y'
  have hsmul2 : ∀ (a : ℚ_[ℓ]) x y, Bil x (a • y) = a • Bil x y := by
    intro a x y
    have h := hsmul1 a y x
    rw [smul_eq_mul] at h
    rw [smul_eq_mul]
    linear_combination hBalt' x (a • y) - h - a * hBalt' x y
  let β : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] ℚ_[ℓ] :=
    LinearMap.mk₂ ℚ_[ℓ] Bil hadd1 hsmul1 hadd2 hsmul2
  have hβ : ∀ x y, β x y = Bil x y := fun x y => rfl
  have hnd : ∀ y, (∀ x, β x y = 0) → y = 0 := by
    intro y hy
    have h1 : ∀ t, B V₀ t (eτ.symm y) = 0 := by
      intro t
      apply hLinj
      have h2 : L (B V₀ (eτ.symm (eτ t)) (eτ.symm y)) = 0 := hy (eτ t)
      rw [AddEquiv.symm_apply_apply] at h2
      rw [h2, map_zero]
    have h3 := hperfR (eτ.symm y) h1
    rw [← AddEquiv.apply_symm_apply eτ y, h3, map_zero]

  obtain ⟨J, hJdef⟩ : ∃ J : Matrix (Fin r) (Fin r) ℚ_[ℓ], J = LinearMap.toMatrix₂' ℚ_[ℓ] β :=
    ⟨_, rfl⟩
  have hgram : ∀ x y, dotProduct x (J.mulVec y) = β x y := by
    intro x y
    rw [← Matrix.toLinearMap₂'_apply', hJdef, Matrix.toLinearMap₂'_toMatrix']
  refine ⟨J, ?_, ?_, ?_⟩
  · ext a b
    rw [Matrix.transpose_apply, Matrix.neg_apply, hJdef, LinearMap.toMatrix₂'_apply,
      LinearMap.toMatrix₂'_apply, hβ, hβ]
    exact hBalt' _ _
  · have hinjJ : Function.Injective J.mulVec := by
      intro y₁ y₂ hy
      have h0 : J.mulVec (y₁ - y₂) = 0 := by rw [Matrix.mulVec_sub, hy, sub_self]
      have h4 : y₁ - y₂ = 0 := hnd _ (fun x => by rw [← hgram, h0, dotProduct_zero])
      exact sub_eq_zero.mp h4
    exact (Matrix.isUnit_iff_isUnit_det J).mp (Matrix.mulVec_injective_iff_isUnit.mp hinjJ)
  · intro γ hγ g hframe

    have hginj : Function.Injective g := by
      rw [injective_iff_map_eq_zero]
      intro y hy
      have e1 : c y = c 0 := by
        apply hext W γ (c y) (c 0)
        intro z
        rw [hframe (c y) z, hframe (c 0) z, hc y z, hc 0 z, hy, map_zero]
      have h5 := hc y z₀
      rw [e1, hc 0 z₀] at h5
      exact h5.symm

    have hpull : ∀ x, ((wcRq D.f ℓ (n - 1)).obj.map γ.op).hom (c (g x)) = c x := by
      intro x
      apply hext W (𝟙 W)
      intro z
      rw [hc x z]
      apply hginj
      rw [← hframe]
      rw [hnat W W (𝟙 W) γ γ (Category.comp_id γ) (c (g x)) z, hc]
    have hdeck := wc_pencil_R2_deck_trivial F' F'' Y n hn hn2 D ℓ hℓ hP W w hconn hoff γ hγ
    have hWinv : ∀ x y, B W (c (g x)) (c (g y)) = B W (c x) (c y) := by
      intro x y
      rw [← hpull x, ← hpull y, hBnat W W γ, hdeck]
    have hinv : ∀ x y, β (g x) (g y) = β x y := by
      intro x y
      rw [hβ, hβ]
      show L (B V₀ (eτ.symm (g x)) (eτ.symm (g y))) = L (B V₀ (eτ.symm x) (eτ.symm y))
      rw [hσc (g x), hσc (g y), hσc x, hσc y, hBnat W V₀ ι, hBnat W V₀ ι, hWinv]
    have hcomp : β.compl₁₂ g g = β :=
      LinearMap.ext₂ (fun x y => by rw [LinearMap.compl₁₂_apply, hinv])
    rw [hJdef, ← LinearMap.toMatrix₂'_compl₁₂, hcomp]

theorem wc_pencil_PL_datum_exists (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) :
    Nonempty (wcPencilPL D ℓ hP) :=
by
  classical
  obtain ⟨W, w, r, θ, hθc, hqc, hconn, hoff, hcov, hgal⟩ :=
    wc_pencil_PL_galois_cover F' F'' Y n hn hn2 D ℓ hℓ hP
  obtain ⟨J, hJalt, hJunit, hJinv⟩ :=
    wc_pencil_PL_cup_form F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ hθc hqc hconn hoff hcov hgal

  have c4 : ∀ (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])) (u d : Fin r → ℚ_[ℓ]),
      (∀ x, g x = x + (dotProduct u x) • d) →
      (LinearMap.toMatrix' g).transpose * J * LinearMap.toMatrix' g = J →
      ∃ (δ : Fin r → ℚ_[ℓ]) (ε : ℚ_[ℓ]), ε ≠ 0 ∧
        (∀ x, g x = x + (ε * dotProduct δ (J.mulVec x)) • δ) ∧
        ∀ x, (dotProduct δ (J.mulVec x) = 0 ↔ g x = x) := by
    intro g u d hg hgJ
    by_cases hud : u = 0 ∨ d = 0
    · have hid : ∀ x, g x = x := by
        intro x
        rcases hud with h | h
        · rw [hg x, h, zero_dotProduct, zero_smul, add_zero]
        · rw [hg x, h, smul_zero, add_zero]
      refine ⟨0, 1, one_ne_zero, fun x => ?_, fun x => ?_⟩
      · rw [hid x, smul_zero, add_zero]
      · simp only [zero_dotProduct, hid x]
    push_neg at hud
    obtain ⟨hu, hd⟩ := hud
    have hskew : ∀ x y : Fin r → ℚ_[ℓ],
        dotProduct x (J.mulVec y) = - dotProduct y (J.mulVec x) := by
      intro x y
      rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hJalt, Matrix.neg_mulVec,
        neg_dotProduct, dotProduct_comm]
    have halt : ∀ x : Fin r → ℚ_[ℓ], dotProduct x (J.mulVec x) = 0 := by
      intro x
      have h := hskew x x
      have h2 : (2 : ℚ_[ℓ]) * dotProduct x (J.mulVec x) = 0 := by linear_combination h
      exact (mul_eq_zero.mp h2).resolve_left two_ne_zero
    have hinv : ∀ x y : Fin r → ℚ_[ℓ],
        dotProduct (g x) (J.mulVec (g y)) = dotProduct x (J.mulVec y) := by
      intro x y
      have h1 : dotProduct x (((LinearMap.toMatrix' g).transpose * J *
          LinearMap.toMatrix' g).mulVec y) = dotProduct (g x) (J.mulVec (g y)) := by
        rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec,
          Matrix.vecMul_transpose, LinearMap.toMatrix'_mulVec, LinearMap.toMatrix'_mulVec]
      rw [← h1, hgJ]
    have hstar : ∀ x y : Fin r → ℚ_[ℓ], dotProduct u x * dotProduct d (J.mulVec y) =
        dotProduct u y * dotProduct d (J.mulVec x) := by
      intro x y
      have h := hinv x y
      rw [hg x, hg y] at h
      simp only [Matrix.mulVec_add, Matrix.mulVec_smul, add_dotProduct, dotProduct_add,
        smul_dotProduct, dotProduct_smul, smul_eq_mul] at h
      have e1 := halt d
      have e2 := hskew x d
      linear_combination h - dotProduct u y * e2 - dotProduct u x * dotProduct u y * e1
    have hJinj : Function.Injective J.mulVec :=
      Matrix.mulVec_injective_iff_isUnit.mpr ((Matrix.isUnit_iff_isUnit_det J).mpr hJunit)
    have hfne : ∃ y₀ : Fin r → ℚ_[ℓ], dotProduct d (J.mulVec y₀) ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      apply hd
      apply hJinj
      rw [Matrix.mulVec_zero]
      funext j
      have h := hcon (Pi.single j 1)
      rw [hskew, single_dotProduct, one_mul, neg_eq_zero] at h
      simpa using h
    obtain ⟨y₀, hy₀⟩ := hfne
    obtain ⟨c, hc⟩ : ∃ c : ℚ_[ℓ], c = dotProduct u y₀ / dotProduct d (J.mulVec y₀) :=
      ⟨_, rfl⟩
    have hux : ∀ x, dotProduct u x = c * dotProduct d (J.mulVec x) := by
      intro x
      have h := hstar x y₀
      rw [hc, div_mul_eq_mul_div, eq_div_iff hy₀]
      exact h
    have hc0 : c ≠ 0 := by
      intro h0
      apply hu
      funext j
      have h := hux (Pi.single j 1)
      rw [h0, zero_mul, dotProduct_single, mul_one] at h
      simpa using h
    refine ⟨d, c, hc0, fun x => ?_, fun x => ?_⟩
    · rw [hg x, hux x]
    · rw [hg x, hux x]
      constructor
      · intro h
        rw [h, mul_zero, zero_smul, add_zero]
      · intro h
        have h' : (c * dotProduct d (J.mulVec x)) • d = 0 := by
          rw [← add_right_inj x, add_zero]
          exact h
        rcases smul_eq_zero.mp h' with h1 | h1
        · exact (mul_eq_zero.mp h1).resolve_left hc0
        · exact absurd h1 hd

  have c2 := fun i : Fin D.m => wc_pencil_PL_local_inertia F' F'' Y n hn hn2 D ℓ hℓ hP
    W w r θ hθc hqc hconn hoff hcov hgal i
  choose γ hγ g hframe u d hg hloc using c2
  have c4i := fun i : Fin D.m =>
    c4 (g i) (u i) (d i) (hg i) (hJinv (γ i) (hγ i) (g i) (hframe i))
  choose δ ε hε hτ hiff using c4i
  refine ⟨wcPencilPL.mk W w r θ hθc hqc hconn hoff hcov D.m γ hγ g hframe J hJalt hJunit
    (fun j => hJinv (γ j) (hγ j) (g j) (hframe j)) δ ε hε id (fun i x => hτ i x) ?_ ?_⟩
  · intro j
    rintro _ ⟨x, rfl⟩
    have hx : (g j - LinearMap.id : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])) x =
        (ε j * dotProduct (δ j) (J.mulVec x)) • δ j := by
      rw [LinearMap.sub_apply, LinearMap.id_apply, hτ j x, add_sub_cancel_left]
    rw [hx]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
  · intro i V v A _ _ _ e he
    obtain ⟨V', a, b, z, h1, h2, h3⟩ := hloc i V v A e he
    exact ⟨V', a, b, z, h1, h2, fun x => (hiff i x).trans (h3 x)⟩

theorem wc_pencil_PL_galois_refine (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (π : wcPencilPL D ℓ hP) :
    ∃ π₂ : wcPencilPL D ℓ hP, ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ π₂.W),
      ConnectedSpace V.left → a ≫ π₂.w = b ≫ π₂.w →
      ∃ σ : π₂.W ⟶ π₂.W, σ ≫ π₂.w = π₂.w ∧ b = a ≫ σ :=
by
  classical
  obtain ⟨W, w, r, θ, hθc, hqc, hconn, hoff, hcov, hgal⟩ :=
    wc_pencil_PL_galois_cover F' F'' Y n hn hn2 D ℓ hℓ hP
  obtain ⟨J, hJalt, hJunit, hJinv⟩ :=
    wc_pencil_PL_cup_form F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ hθc hqc hconn hoff hcov hgal

  have c4 : ∀ (g : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])) (u d : Fin r → ℚ_[ℓ]),
      (∀ x, g x = x + (dotProduct u x) • d) →
      (LinearMap.toMatrix' g).transpose * J * LinearMap.toMatrix' g = J →
      ∃ (δ : Fin r → ℚ_[ℓ]) (ε : ℚ_[ℓ]), ε ≠ 0 ∧
        (∀ x, g x = x + (ε * dotProduct δ (J.mulVec x)) • δ) ∧
        ∀ x, (dotProduct δ (J.mulVec x) = 0 ↔ g x = x) := by
    intro g u d hg hgJ
    by_cases hud : u = 0 ∨ d = 0
    · have hid : ∀ x, g x = x := by
        intro x
        rcases hud with h | h
        · rw [hg x, h, zero_dotProduct, zero_smul, add_zero]
        · rw [hg x, h, smul_zero, add_zero]
      refine ⟨0, 1, one_ne_zero, fun x => ?_, fun x => ?_⟩
      · rw [hid x, smul_zero, add_zero]
      · simp only [zero_dotProduct, hid x]
    push_neg at hud
    obtain ⟨hu, hd⟩ := hud
    have hskew : ∀ x y : Fin r → ℚ_[ℓ],
        dotProduct x (J.mulVec y) = - dotProduct y (J.mulVec x) := by
      intro x y
      rw [Matrix.dotProduct_mulVec, ← Matrix.mulVec_transpose, hJalt, Matrix.neg_mulVec,
        neg_dotProduct, dotProduct_comm]
    have halt : ∀ x : Fin r → ℚ_[ℓ], dotProduct x (J.mulVec x) = 0 := by
      intro x
      have h := hskew x x
      have h2 : (2 : ℚ_[ℓ]) * dotProduct x (J.mulVec x) = 0 := by linear_combination h
      exact (mul_eq_zero.mp h2).resolve_left two_ne_zero
    have hinv : ∀ x y : Fin r → ℚ_[ℓ],
        dotProduct (g x) (J.mulVec (g y)) = dotProduct x (J.mulVec y) := by
      intro x y
      have h1 : dotProduct x (((LinearMap.toMatrix' g).transpose * J *
          LinearMap.toMatrix' g).mulVec y) = dotProduct (g x) (J.mulVec (g y)) := by
        rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec,
          Matrix.vecMul_transpose, LinearMap.toMatrix'_mulVec, LinearMap.toMatrix'_mulVec]
      rw [← h1, hgJ]
    have hstar : ∀ x y : Fin r → ℚ_[ℓ], dotProduct u x * dotProduct d (J.mulVec y) =
        dotProduct u y * dotProduct d (J.mulVec x) := by
      intro x y
      have h := hinv x y
      rw [hg x, hg y] at h
      simp only [Matrix.mulVec_add, Matrix.mulVec_smul, add_dotProduct, dotProduct_add,
        smul_dotProduct, dotProduct_smul, smul_eq_mul] at h
      have e1 := halt d
      have e2 := hskew x d
      linear_combination h - dotProduct u y * e2 - dotProduct u x * dotProduct u y * e1
    have hJinj : Function.Injective J.mulVec :=
      Matrix.mulVec_injective_iff_isUnit.mpr ((Matrix.isUnit_iff_isUnit_det J).mpr hJunit)
    have hfne : ∃ y₀ : Fin r → ℚ_[ℓ], dotProduct d (J.mulVec y₀) ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      apply hd
      apply hJinj
      rw [Matrix.mulVec_zero]
      funext j
      have h := hcon (Pi.single j 1)
      rw [hskew, single_dotProduct, one_mul, neg_eq_zero] at h
      simpa using h
    obtain ⟨y₀, hy₀⟩ := hfne
    obtain ⟨c, hc⟩ : ∃ c : ℚ_[ℓ], c = dotProduct u y₀ / dotProduct d (J.mulVec y₀) :=
      ⟨_, rfl⟩
    have hux : ∀ x, dotProduct u x = c * dotProduct d (J.mulVec x) := by
      intro x
      have h := hstar x y₀
      rw [hc, div_mul_eq_mul_div, eq_div_iff hy₀]
      exact h
    have hc0 : c ≠ 0 := by
      intro h0
      apply hu
      funext j
      have h := hux (Pi.single j 1)
      rw [h0, zero_mul, dotProduct_single, mul_one] at h
      simpa using h
    refine ⟨d, c, hc0, fun x => ?_, fun x => ?_⟩
    · rw [hg x, hux x]
    · rw [hg x, hux x]
      constructor
      · intro h
        rw [h, mul_zero, zero_smul, add_zero]
      · intro h
        have h' : (c * dotProduct d (J.mulVec x)) • d = 0 := by
          rw [← add_right_inj x, add_zero]
          exact h
        rcases smul_eq_zero.mp h' with h1 | h1
        · exact (mul_eq_zero.mp h1).resolve_left hc0
        · exact absurd h1 hd

  have c2 := fun i : Fin D.m => wc_pencil_PL_local_inertia F' F'' Y n hn hn2 D ℓ hℓ hP
    W w r θ hθc hqc hconn hoff hcov hgal i
  choose γ hγ g hframe u d hg hloc using c2
  have c4i := fun i : Fin D.m =>
    c4 (g i) (u i) (d i) (hg i) (hJinv (γ i) (hγ i) (g i) (hframe i))
  choose δ ε hε hτ hiff using c4i
  refine ⟨wcPencilPL.mk W w r θ hθc hqc hconn hoff hcov D.m γ hγ g hframe J hJalt hJunit
    (fun j => hJinv (γ j) (hγ j) (g j) (hframe j)) δ ε hε id (fun i x => hτ i x) ?_ ?_, ?_⟩
  · intro j
    rintro _ ⟨x, rfl⟩
    have hx : (g j - LinearMap.id : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])) x =
        (ε j * dotProduct (δ j) (J.mulVec x)) • δ j := by
      rw [LinearMap.sub_apply, LinearMap.id_apply, hτ j x, add_sub_cancel_left]
    rw [hx]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
  · intro i V v A _ _ _ e he
    obtain ⟨V', a, b, z, h1, h2, h3⟩ := hloc i V v A e he
    exact ⟨V', a, b, z, h1, h2, fun x => (hiff i x).trans (h3 x)⟩
  · intro V a b hV hab
    exact hgal V a b hV hab

theorem wc_pencil_PL_frame_extend (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (π : wcPencilPL D ℓ hP) (σ : π.W ⟶ π.W) (hσ : σ ≫ π.w = π.w)
    (g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ]))
    (hg : ∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op π.W)) (z : π.W.left),
      (show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk σ))).hom s).down) z =
      g ((show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s).down) z)) :
    Function.Bijective g ∧
      ∀ (V' : (wcP1Over F'').left.ProEt) (b : V' ⟶ π.W)
        (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V')) (z : V'.left),
        (show C(↥V'.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk (b ≫ σ)))).hom t).down) z =
        g ((show C(↥V'.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk b))).hom t).down) z) :=
by
  classical
  haveI := π.hconn

  let θσ : (wcRq D.f ℓ (n - 1)).over π.W ⟶
      (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).over π.W :=
    ⟨{ app := fun T => π.θ.hom.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ σ)))
       naturality := fun X Y f => π.θ.hom.hom.naturality
          (Over.homMk f.unop.left (by
            show f.unop.left ≫ X.unop.hom ≫ σ = Y.unop.hom ≫ σ
            rw [← Category.assoc, Over.w f.unop]) :
            Over.mk (Y.unop.hom ≫ σ) ⟶ Over.mk (X.unop.hom ≫ σ)).op }⟩
  have hres : ∀ (V' : (wcP1Over F'').left.ProEt) (c u : V' ⟶ π.W), c ≫ σ = u →
      ∀ t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V'),
      (θσ.hom.app (Opposite.op (Over.mk c))).hom t =
        (π.θ.hom.hom.app (Opposite.op (Over.mk u))).hom t := by
    rintro V' c u rfl t
    rfl

  have hcancel1 : ∀ (T : Over π.W)
      (s : ((wcRq D.f ℓ (n - 1)).over π.W).obj.obj (Opposite.op T)),
      (π.θ.inv.hom.app (Opposite.op T)).hom ((π.θ.hom.hom.app (Opposite.op T)).hom s) = s := by
    intro T s
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom s) π.θ.hom_inv_id
  have hcancel2 : ∀ (T : Over π.W)
      (c : ((wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).over π.W).obj.obj
        (Opposite.op T)),
      (π.θ.hom.hom.app (Opposite.op T)).hom ((π.θ.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) π.θ.inv_hom_id

  obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear (wcP1Over F'').left ℓ π.W π.hconn π.r π.r
    (π.θ.inv ≫ θσ)
  have hPt : ∀ (T : Over π.W)
      (c : (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
      (t : T.left.left),
      (show C(↥T.left.left, Fin π.r → ℚ_[ℓ]) from
        (((π.θ.inv ≫ θσ).hom.app (Opposite.op T)).hom c).down) t =
        A ((show C(↥T.left.left, Fin π.r → ℚ_[ℓ]) from c.down) t) := by
    intro T c t
    rw [hA]
    rfl

  have hkey : ∀ (V' : (wcP1Over F'').left.ProEt) (c u : V' ⟶ π.W), c ≫ σ = u →
      ∀ (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V')) (z : V'.left),
      (show C(↥V'.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk u))).hom t).down) z =
      A ((show C(↥V'.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk c))).hom t).down) z) := by
    intro V' c u hcu t z
    have e1 : ((π.θ.inv ≫ θσ).hom.app (Opposite.op (Over.mk c))).hom
        ((π.θ.hom.hom.app (Opposite.op (Over.mk c))).hom t) =
        (θσ.hom.app (Opposite.op (Over.mk c))).hom t :=
      congrArg (θσ.hom.app (Opposite.op (Over.mk c))).hom (hcancel1 (Over.mk c) t)
    have E := e1.trans (hres V' c u hcu t)
    have h1 := hPt (Over.mk c) ((π.θ.hom.hom.app (Opposite.op (Over.mk c))).hom t) z
    have h4 := congrArg (fun y : ULift.{u+1} C(↥V'.left, Fin π.r → ℚ_[ℓ]) => y.down z) E
    exact h4.symm.trans h1

  obtain ⟨z₀⟩ : Nonempty π.W.left := ConnectedSpace.toNonempty
  have hconst : ∀ v : Fin π.r → ℚ_[ℓ], ∃ s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op π.W),
      ∀ z : π.W.left, (show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s).down) z = v := by
    intro v
    let c : (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).obj.obj (Opposite.op π.W) :=
      (show (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).obj.obj (Opposite.op π.W) from
        ULift.up (ContinuousMap.const ↥π.W.left v))
    refine ⟨(π.θ.inv.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom c, fun z => ?_⟩
    have hs := hcancel2 (Over.mk (𝟙 π.W)) c
    exact congrArg (fun y : ULift.{u+1} C(↥π.W.left, Fin π.r → ℚ_[ℓ]) => y.down z) hs

  have hAg : ∀ v, A v = g v := by
    intro v
    obtain ⟨s, hs⟩ := hconst v
    have k1 := hkey π.W (𝟙 π.W) σ (Category.id_comp σ) s z₀
    rw [hg s z₀, hs z₀] at k1
    exact k1.symm

  have hinj : Function.Injective g := by
    rw [injective_iff_map_eq_zero]
    intro v hv
    obtain ⟨s, hs⟩ := hconst v
    obtain ⟨s0, hs0⟩ := hconst 0
    have e : (π.θ.hom.hom.app (Opposite.op (Over.mk σ))).hom s =
        (π.θ.hom.hom.app (Opposite.op (Over.mk σ))).hom s0 := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      have h1 := hg s z
      have h2 := hg s0 z
      rw [hs z, hv] at h1
      rw [hs0 z, map_zero] at h2
      exact h1.trans h2.symm
    have e2 : s = s0 := by
      have := congrArg (π.θ.inv.hom.app (Opposite.op (Over.mk σ))).hom e
      exact (hcancel1 (Over.mk σ) s).symm.trans (this.trans (hcancel1 (Over.mk σ) s0))
    have h3 := hs z₀
    rw [e2, hs0 z₀] at h3
    exact h3.symm

  refine ⟨⟨hinj, LinearMap.injective_iff_surjective.mp hinj⟩, ?_⟩
  intro V' b t z
  rw [← hAg]
  exact hkey V' b (b ≫ σ) rfl t z

theorem wc_pencil_PL_hloc_sep_point (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (π : wcPencilPL D ℓ hP) (i : Fin D.m)
    (V : (wcP1Over F'').left.ProEt) (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F'')) :
    ∃ (V' : (wcP1Over F'').left.ProEt) (u : V' ⟶ V) (c : V' ⟶ π.W) (L : Type u) (_ : Field L)
      (_ : IsSepClosed L) (eL : V'.left ≅ Spec (.of L)),
      u ≫ v = c ≫ π.w ∧
      ∀ x : Fin π.r → ℚ_[ℓ], dotProduct (π.δ i) (π.J.mulVec x) = 0 ↔
        x ∈ wcPLSpImg π u c (eL.inv (IsLocalRing.closedPoint L)) :=
by
  classical

  have s1 : ∀ (K B : Type u) [CommRing K] [CommRing B] [IsLocalRing B] [Algebra K B],
      IsField K → Algebra.WeaklyEtale K B → IsLocalRing.maximalIdeal B = ⊥ := by
    intro K B _ _ _ _ hK hW
    letI : Field K := hK.toField
    have hμsurj : Function.Surjective (Algebra.TensorProduct.lmul' K (S := B)) := fun b =>
      ⟨b ⊗ₜ[K] (1 : B), by rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]⟩
    have hflatQ : Module.Flat (TensorProduct K B B)
        (TensorProduct K B B ⧸ RingHom.ker (Algebra.TensorProduct.lmul' K (S := B)).toRingHom) := by
      let e := RingHom.quotientKerEquivOfSurjective
        (f := (Algebra.TensorProduct.lmul' K (S := B)).toRingHom) hμsurj
      have h1 : ((Algebra.TensorProduct.lmul' K (S := B)).toRingHom).Flat := hW.flat_lmul'
      have h2 : (e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' K (S := B)).toRingHom).Flat :=
        RingHom.Flat.comp h1 (RingHom.Flat.of_bijective (f := e.symm.toRingHom) e.symm.bijective)
      have h3 : e.symm.toRingHom.comp (Algebra.TensorProduct.lmul' K (S := B)).toRingHom =
          algebraMap _ (TensorProduct K B B ⧸
            RingHom.ker (Algebra.TensorProduct.lmul' K (S := B)).toRingHom) := by
        refine RingHom.ext fun t => ?_
        rw [Ideal.Quotient.algebraMap_eq]
        show e.symm (Algebra.TensorProduct.lmul' K (S := B) t) = Ideal.Quotient.mk _ t
        rw [e.symm_apply_eq]
        rfl
      rw [h3, RingHom.flat_algebraMap_iff] at h2
      exact h2
    have habs : ∀ (S : Type u) [CommRing S] (I : Ideal S), Module.Flat S (S ⧸ I) →
        ∀ x ∈ I, ∃ z ∈ I, x * z = x := by
      intro S _ I hflat x hx
      have hrel : ∑ i : Fin 1, (fun _ => x) i • (fun _ => (1 : S ⧸ I)) i = 0 := by
        rw [Fin.sum_univ_one]
        show x • (1 : S ⧸ I) = 0
        rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, mul_one,
          Ideal.Quotient.eq_zero_iff_mem]
        exact hx
      obtain ⟨k, a, y, h1, h2⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
      choose b hb using fun j => Ideal.Quotient.mk_surjective (I := I) (y j)
      set w : S := ∑ j, a 0 j * b j with hw
      have h10 : (1 : S ⧸ I) = ∑ j, a 0 j • y j := h1 0
      have hmk : Ideal.Quotient.mk I w = 1 := by
        rw [hw, map_sum, h10]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [map_mul, hb j, Algebra.smul_def, Ideal.Quotient.algebraMap_eq]
      have hxw : x * w = 0 := by
        rw [hw, Finset.mul_sum]
        refine Finset.sum_eq_zero (fun j _ => ?_)
        have := h2 j
        rw [Fin.sum_univ_one] at this
        rw [← mul_assoc, this, zero_mul]
      refine ⟨1 - w, ?_, ?_⟩
      · rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_one, hmk, sub_self]
      · rw [mul_sub, mul_one, hxw, sub_zero]
    have habs := habs _ _ hflatQ
    have t1 : ∀ b : B, ∃ w : TensorProduct K B B, Algebra.TensorProduct.lmul' K w = 1 ∧
        (b ⊗ₜ[K] (1 : B)) * w = ((1 : B) ⊗ₜ[K] b) * w := by
      intro b
      have hx : b ⊗ₜ[K] (1 : B) - (1 : B) ⊗ₜ[K] b ∈
          RingHom.ker (Algebra.TensorProduct.lmul' K (S := B)).toRingHom := by
        rw [RingHom.mem_ker]
        show Algebra.TensorProduct.lmul' K (S := B) (b ⊗ₜ[K] (1 : B) - (1 : B) ⊗ₜ[K] b) = 0
        rw [map_sub, Algebra.TensorProduct.lmul'_apply_tmul, Algebra.TensorProduct.lmul'_apply_tmul,
          mul_one, one_mul, sub_self]
      obtain ⟨z, hzI, hxz⟩ := habs _ hx
      refine ⟨1 - z, ?_, ?_⟩
      · have hz : Algebra.TensorProduct.lmul' K (S := B) z = 0 := RingHom.mem_ker.mp hzI
        rw [map_sub, map_one, hz, sub_zero]
      · rw [← sub_eq_zero, ← sub_mul, mul_sub, mul_one, hxz, sub_self]
    have t2 : ∀ r : B, ∃ g : B →ₗ[K] B, ∀ b : B, r * g (r * b) = r * b := by
      intro r
      let m := LinearMap.mulLeft K r
      obtain ⟨s, hs⟩ := LinearMap.exists_rightInverse_of_surjective m.rangeRestrict
        (LinearMap.range_rangeRestrict m)
      obtain ⟨g, hg⟩ := LinearMap.exists_extend s
      refine ⟨g, fun b => ?_⟩
      have hp : r * b ∈ LinearMap.range m := ⟨b, rfl⟩
      have h1 : g (r * b) = s ⟨r * b, hp⟩ := LinearMap.congr_fun hg ⟨r * b, hp⟩
      rw [h1]
      have h2 := congrArg Subtype.val (LinearMap.congr_fun hs ⟨r * b, hp⟩)
      exact h2
    have t3 : ∀ (r : B) (g : B →ₗ[K] B), (∀ b : B, r * g (r * b) = r * b) →
        ∀ w : TensorProduct K B B, Algebra.TensorProduct.lmul' K w = 1 →
        (r ⊗ₜ[K] (1 : B)) * w = ((1 : B) ⊗ₜ[K] r) * w → ∃ y : B, r = r * r * y := by
      intro r g hg w hμ hw
      let Φ : TensorProduct K B B →ₗ[K] B := TensorProduct.lift ((LinearMap.mul K B).compl₂ g)
      have hΦ : ∀ a b : B, Φ (a ⊗ₜ[K] b) = a * g b := by
        intro a b
        simp [Φ, TensorProduct.lift.tmul]
      have hA : ∀ t, r * Φ (((1 : B) ⊗ₜ[K] r) * t) = r * Algebra.TensorProduct.lmul' K t := by
        intro t
        induction t using TensorProduct.induction_on with
        | zero => rw [mul_zero, map_zero, map_zero]
        | tmul a b =>
          rw [Algebra.TensorProduct.tmul_mul_tmul, hΦ, Algebra.TensorProduct.lmul'_apply_tmul,
            one_mul]
          calc r * (a * g (r * b)) = a * (r * g (r * b)) := by ring
            _ = a * (r * b) := by rw [hg]
            _ = r * (a * b) := by ring
        | add x y hx hy => rw [mul_add, map_add, mul_add, hx, hy, map_add, mul_add]
      have hB : ∀ t, Φ ((r ⊗ₜ[K] (1 : B)) * t) = r * Φ t := by
        intro t
        induction t using TensorProduct.induction_on with
        | zero => rw [mul_zero, map_zero, mul_zero]
        | tmul a b => rw [Algebra.TensorProduct.tmul_mul_tmul, hΦ, hΦ, one_mul, mul_assoc]
        | add x y hx hy => rw [mul_add, map_add, hx, hy, map_add, mul_add]
      refine ⟨Φ w, ?_⟩
      calc r = r * Algebra.TensorProduct.lmul' K w := by rw [hμ, mul_one]
        _ = r * Φ (((1 : B) ⊗ₜ[K] r) * w) := (hA w).symm
        _ = r * Φ ((r ⊗ₜ[K] (1 : B)) * w) := by rw [hw]
        _ = r * r * Φ w := by rw [hB, mul_assoc]
    rw [eq_bot_iff]
    intro t ht
    rw [Ideal.mem_bot]
    obtain ⟨g, hg⟩ := t2 t
    obtain ⟨w, hμ, hw⟩ := t1 t
    obtain ⟨y, hy⟩ := t3 t g hg w hμ hw
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (t * y) with h | h
    · exfalso
      exact (IsLocalRing.mem_maximalIdeal _).mp (Ideal.mul_mem_right y _ ht) h
    · have h0 : t * (1 - t * y) = 0 := by
        calc t * (1 - t * y) = t - t * t * y := by ring
          _ = 0 := by rw [← hy, sub_self]
      exact (h.mul_left_eq_zero).mp h0

  have s2 : ∀ (S : Scheme.{u}) (V' : S.ProEt) (z : V'.left),
      IsField (S.presheaf.stalk (V'.hom z)) → IsField (V'.left.presheaf.stalk z) := by
    intro S V' z hx
    haveI : WeaklyEtale V'.hom := V'.prop
    haveI := wc_lfi_fromSpecStalk_weaklyEtale V'.left z
    haveI := wc_lfi_fromSpecStalk_weaklyEtale S (V'.hom z)
    have hc : WeaklyEtale (V'.left.fromSpecStalk z ≫ V'.hom) := inferInstance
    haveI : WeaklyEtale (Spec.map (V'.hom.stalkMap z) ≫ S.fromSpecStalk (V'.hom z)) := by
      rw [Scheme.SpecMap_stalkMap_fromSpecStalk]
      exact hc
    haveI h1 : WeaklyEtale (Spec.map (V'.hom.stalkMap z)) :=
      WeaklyEtale.of_comp _ (S.fromSpecStalk (V'.hom z))
    have h2 := wc_lpkt_specMap_weaklyEtale_ring _ _ (V'.hom.stalkMap z).hom
      (by rw [CommRingCat.ofHom_hom]; exact h1)
    exact IsLocalRing.isField_iff_maximalIdeal_eq.mpr
      (@s1 _ _ _ _ _ (V'.hom.stalkMap z).hom.toAlgebra hx h2)

  have s4 : ∀ (S : Scheme.{u}) (V' : S.ProEt) (z : V'.left),
      IsField (V'.left.presheaf.stalk z) →
      ∃ (V'' : S.ProEt) (jP : V'' ⟶ V') (L : Type u) (_ : Field L) (_ : IsSepClosed L)
        (eL : V''.left ≅ Spec (.of L)), jP.left (eL.inv (IsLocalRing.closedPoint L)) = z := by
    intro S V' z hz
    haveI : WeaklyEtale V'.hom := V'.prop
    haveI := wc_lfi_fromSpecStalk_weaklyEtale V'.left z
    haveI hres : IsIso (V'.left.residue z) := by
      rw [ConcreteCategory.isIso_iff_bijective, Scheme.residue.eq_1]
      refine ⟨?_, IsLocalRing.residue_surjective⟩
      show Function.Injective (IsLocalRing.residue _)
      rw [RingHom.injective_iff_ker_eq_bot, IsLocalRing.ker_residue]
      exact IsLocalRing.isField_iff_maximalIdeal_eq.mp hz
    haveI : WeaklyEtale (V'.left.fromSpecResidueField z) := by
      rw [Scheme.fromSpecResidueField.eq_1]
      infer_instance
    haveI := wc_fpe_sepClosure_weaklyEtale (V'.left.residueField z)
    let jj : Spec (.of (SeparableClosure (V'.left.residueField z))) ⟶ V'.left :=
      Spec.map (CommRingCat.ofHom (algebraMap (V'.left.residueField z)
        (SeparableClosure (V'.left.residueField z)))) ≫ V'.left.fromSpecResidueField z
    haveI hjj : WeaklyEtale jj := by dsimp only [jj]; infer_instance
    have hW : WeaklyEtale (jj ≫ V'.hom) := inferInstance
    let V'' : S.ProEt := MorphismProperty.Over.mk ⊤ (jj ≫ V'.hom) hW
    let jP : V'' ⟶ V' := MorphismProperty.Over.homMk jj rfl trivial
    refine ⟨V'', jP, SeparableClosure (V'.left.residueField z), inferInstance,
      SeparableClosure.isSepClosed _, Iso.refl _, ?_⟩
    show (V'.left.fromSpecResidueField z)
      ((Spec.map (CommRingCat.ofHom (algebraMap (V'.left.residueField z)
        (SeparableClosure (V'.left.residueField z))))) (IsLocalRing.closedPoint _)) = z
    exact Scheme.fromSpecResidueField_apply z _

  obtain ⟨V', a, b, z, hab, -, hiff⟩ := π.hloc i V v A e hV
  have ha1 : V'.hom z = V.hom (a.left z) := by
    rw [← MorphismProperty.Over.w a, Scheme.Hom.comp_apply]
  have hb1 : V'.hom z = π.W.hom (b.left z) := by
    rw [← MorphismProperty.Over.w b, Scheme.Hom.comp_apply]
  have hne : V.hom (a.left z) ≠ D.S i (IsLocalRing.closedPoint F'') := by
    rw [← ha1, hb1]
    exact π.hoff _ i

  obtain ⟨c0, ψ, j, hj, hfac, -, -, -⟩ := wc_stpf_chart F'' (D.S i) (D.hS i) V A e hV
  haveI := hj
  have hy : V.hom (a.left z) = j (Spec.map (CommRingCat.ofHom ψ) (e.hom (a.left z))) := by
    have h1 : (e.inv ≫ V.hom) (e.hom (a.left z)) =
        (Spec.map (CommRingCat.ofHom ψ) ≫ j) (e.hom (a.left z)) := by rw [hfac]
    rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
    have h2 : e.inv (e.hom (a.left z)) = a.left z := by
      rw [← Scheme.Hom.comp_apply, Iso.hom_inv_id]; rfl
    rw [h2] at h1
    exact h1
  have hm : j (Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint A)) =
      D.S i (IsLocalRing.closedPoint F'') := by
    have h1 : (e.inv ≫ V.hom) (IsLocalRing.closedPoint A) =
        (Spec.map (CommRingCat.ofHom ψ) ≫ j) (IsLocalRing.closedPoint A) := by rw [hfac]
    have h2 : V.hom (e.inv (IsLocalRing.closedPoint A)) =
        j (Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint A)) := h1
    exact h2.symm.trans hV
  have hfield : IsField ((wcP1Over F'').left.presheaf.stalk
      (j (Spec.map (CommRingCat.ofHom ψ) (e.hom (a.left z))))) := by
    set q : PrimeSpectrum (Polynomial F'') :=
      Spec.map (CommRingCat.ofHom ψ) (e.hom (a.left z)) with hq
    set m : PrimeSpectrum (Polynomial F'') :=
      Spec.map (CommRingCat.ofHom ψ) (IsLocalRing.closedPoint A) with hmdef
    have hqm : q ⤳ m := (IsLocalRing.specializes_closedPoint (R := A) (e.hom (a.left z))).map
      (Spec.map (CommRingCat.ofHom ψ)).continuous
    have hle : q.asIdeal ≤ m.asIdeal := (PrimeSpectrum.le_iff_specializes q m).mpr hqm
    have hqne : q ≠ m := by
      intro h
      apply hne
      rw [hy, ← hm]
      exact congrArg j h
    have hq0 : q.asIdeal = ⊥ := by
      by_contra hne0
      have hmax := Ideal.IsPrime.isMaximal q.isPrime hne0
      exact hqne (PrimeSpectrum.ext (hmax.eq_of_le m.isPrime.ne_top hle))
    have hfq : IsField ((Spec (CommRingCat.of (Polynomial F''))).presheaf.stalk q) := by
      letI := StructureSheaf.stalkAlgebra (Polynomial F'') q
      haveI := StructureSheaf.IsLocalization.to_stalk (Polynomial F'') q
      change IsField ((Spec.structureSheaf (Polynomial F'')).presheaf.stalk q)
      haveI := IsLocalization.AtPrime.isLocalRing
        ((Spec.structureSheaf (Polynomial F'')).presheaf.stalk q) q.asIdeal
      rw [IsLocalRing.isField_iff_maximalIdeal_eq,
        ← IsLocalization.AtPrime.map_eq_maximalIdeal q.asIdeal, hq0, Ideal.map_bot]
    exact MulEquiv.isField hfq (asIso (j.stalkMap q)).commRingCatIsoToRingEquiv.toMulEquiv
  have hP1 : IsField ((wcP1Over F'').left.presheaf.stalk (V'.hom z)) := by
    rw [ha1, hy]
    exact hfield
  have hB := s2 _ V' z hP1
  obtain ⟨V'', jP, L, hL, hLs, eL, hpt⟩ := s4 _ V' z hB

  have s5 : ∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V)) (p : V''.left),
      (show C(↥V''.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk (jP ≫ b)))).hom
          (((wcRq D.f ℓ (n - 1)).obj.map (jP ≫ a).op).hom s)).down) p =
      (show C(↥V'.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s)).down) (jP.left p) := by
    intro s p
    let f : Over.mk (jP ≫ b) ⟶ Over.mk b := Over.homMk jP rfl
    have hnat := congrArg (fun m => m.hom (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s))
      (π.θ.hom.hom.naturality f.op)
    have h2 := congrArg (fun y : ULift.{u+1} C(↥V''.left, Fin π.r → ℚ_[ℓ]) => y.down p) hnat
    have hmc : ((wcRq D.f ℓ (n - 1)).obj.map (jP ≫ a).op).hom s =
        ((wcRq D.f ℓ (n - 1)).obj.map jP.op).hom (((wcRq D.f ℓ (n - 1)).obj.map a.op).hom s) := by
      rw [op_comp, Functor.map_comp]
      rfl
    rw [hmc]
    exact h2
  refine ⟨V'', jP ≫ a, jP ≫ b, L, hL, hLs, eL, ?_, fun x => ?_⟩
  · rw [Category.assoc, hab, Category.assoc]
  · rw [hiff x, wcPLSpImg, Set.mem_setOf_eq]
    constructor
    · rintro ⟨s, hs⟩
      refine ⟨s, ?_⟩
      rw [s5 s, hpt]
      exact hs
    · rintro ⟨s, hs⟩
      refine ⟨s, ?_⟩
      rw [s5 s, hpt] at hs
      exact hs

theorem wc_pencil_PL_sp_img_eq_inv (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (π : wcPencilPL D ℓ hP)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ π.W),
      ConnectedSpace V.left → a ≫ π.w = b ≫ π.w →
      ∃ σ : π.W ⟶ π.W, σ ≫ π.w = π.w ∧ b = a ≫ σ)
    (i : Fin D.m)
    (V : (wcP1Over F'').left.ProEt) (v : V ⟶ wcGeomPoint F'' (wcP1Over F'') hP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : V.left ≅ Spec (.of A))
    (hV : V.hom (e.inv (IsLocalRing.closedPoint A)) = D.S i (IsLocalRing.closedPoint F''))
    (V' : (wcP1Over F'').left.ProEt) (u : V' ⟶ V) (c : V' ⟶ π.W)
    (L : Type u) [Field L] [IsSepClosed L] (eL : V'.left ≅ Spec (.of L))
    (hc : u ≫ v = c ≫ π.w) :
    wcPLSpImg π u c (eL.inv (IsLocalRing.closedPoint L)) = wcPLInv π u c :=
by
  classical
  obtain ⟨pt, hpt⟩ : ∃ p : V'.left, p = eL.inv (IsLocalRing.closedPoint L) := ⟨_, rfl⟩
  rw [← hpt]

  have hsub : ∀ z : V'.left, z = pt := by
    intro z
    have h1 : eL.hom z = eL.hom pt := Subsingleton.elim _ _
    have h2 := congrArg (fun x => eL.inv x) h1
    simp only [Scheme.hom_inv_apply] at h2
    exact h2
  have hconnV' : ConnectedSpace V'.left := by
    haveI : Subsingleton V'.left := ⟨fun a b => (hsub a).trans (hsub b).symm⟩
    haveI hpre : PreconnectedSpace V'.left :=
      ⟨Set.subsingleton_of_subsingleton.isPreconnected⟩
    exact { toPreconnectedSpace := hpre, toNonempty := ⟨pt⟩ }
  have hoffV' : ∀ (z : V'.left) (j : Fin D.m),
      V'.hom z ≠ D.S j (IsLocalRing.closedPoint F'') := by
    intro z j
    rw [← MorphismProperty.Over.w c, Scheme.Hom.comp_apply]
    exact π.hoff _ j

  have hcancel1 : ∀ (T : Over π.W)
      (s : ((wcRq D.f ℓ (n - 1)).over π.W).obj.obj (Opposite.op T)),
      (π.θ.inv.hom.app (Opposite.op T)).hom ((π.θ.hom.hom.app (Opposite.op T)).hom s) = s := by
    intro T s
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom s) π.θ.hom_inv_id
  have hcancel2 : ∀ (T : Over π.W)
      (c : ((wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).over π.W).obj.obj
        (Opposite.op T)),
      (π.θ.hom.hom.app (Opposite.op T)).hom ((π.θ.inv.hom.app (Opposite.op T)).hom c) = c := by
    intro T c
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom c) π.θ.inv_hom_id

  have hΘinj : ∀ t₁ t₂ : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V'),
      (show C(↥V'.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk c))).hom t₁).down) pt =
      (show C(↥V'.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk c))).hom t₂).down) pt → t₁ = t₂ := by
    intro t₁ t₂ h
    have e1 : (π.θ.hom.hom.app (Opposite.op (Over.mk c))).hom t₁ =
        (π.θ.hom.hom.app (Opposite.op (Over.mk c))).hom t₂ := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      rw [hsub z]
      exact h
    have := congrArg (π.θ.inv.hom.app (Opposite.op (Over.mk c))).hom e1
    exact (hcancel1 (Over.mk c) t₁).symm.trans (this.trans (hcancel1 (Over.mk c) t₂))
  have hΘsurj : ∀ x : Fin π.r → ℚ_[ℓ], ∃ t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V'),
      (show C(↥V'.left, Fin π.r → ℚ_[ℓ]) from
        ((π.θ.hom.hom.app (Opposite.op (Over.mk c))).hom t).down) pt = x := by
    intro x
    let cx : (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).obj.obj (Opposite.op V') :=
      (show (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).obj.obj (Opposite.op V') from
        ULift.up (ContinuousMap.const ↥V'.left x))
    refine ⟨(π.θ.inv.hom.app (Opposite.op (Over.mk c))).hom cx, ?_⟩
    have hs := hcancel2 (Over.mk c) cx
    exact congrArg (fun y : ULift.{u+1} C(↥V'.left, Fin π.r → ℚ_[ℓ]) => y.down pt) hs

  have hfun : ∀ {X Y Z : (wcP1Over F'').left.ProEt} (f : X ⟶ Y) (g : Y ⟶ Z)
      (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op Z)),
      ((wcRq D.f ℓ (n - 1)).obj.map f.op).hom (((wcRq D.f ℓ (n - 1)).obj.map g.op).hom s) =
      ((wcRq D.f ℓ (n - 1)).obj.map (f ≫ g).op).hom s := by
    intro X Y Z f g s
    rw [op_comp, Functor.map_comp]
    rfl

  have hdeck : ∀ σ : π.W ⟶ π.W, ∃ g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ]),
      ∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op π.W)) (z : π.W.left),
        (show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk σ))).hom s).down) z =
        g ((show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s).down) z) := by
    intro σ
    haveI := π.hconn
    let θσ : (wcRq D.f ℓ (n - 1)).over π.W ⟶
        (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).over π.W :=
      ⟨{ app := fun T => π.θ.hom.hom.app (Opposite.op (Over.mk (T.unop.hom ≫ σ)))
         naturality := fun X Y f => π.θ.hom.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ σ = Y.unop.hom ≫ σ
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ σ) ⟶ Over.mk (X.unop.hom ≫ σ)).op }⟩
    have hres : ∀ (V₁ : (wcP1Over F'').left.ProEt) (c₁ u₁ : V₁ ⟶ π.W), c₁ ≫ σ = u₁ →
        ∀ t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V₁),
        (θσ.hom.app (Opposite.op (Over.mk c₁))).hom t =
          (π.θ.hom.hom.app (Opposite.op (Over.mk u₁))).hom t := by
      rintro V₁ c₁ u₁ rfl t
      rfl
    obtain ⟨Lσ, hLσ⟩ := wc_contSheaf_over_hom_linear (wcP1Over F'').left ℓ π.W π.hconn π.r π.r
      (π.θ.inv ≫ θσ)
    have hPt : ∀ (T : Over π.W)
        (c₁ : (wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
        (t : T.left.left),
        (show C(↥T.left.left, Fin π.r → ℚ_[ℓ]) from
          (((π.θ.inv ≫ θσ).hom.app (Opposite.op T)).hom c₁).down) t =
          Lσ ((show C(↥T.left.left, Fin π.r → ℚ_[ℓ]) from c₁.down) t) := by
      intro T c₁ t
      rw [hLσ]
      rfl
    have hkey : ∀ (V₁ : (wcP1Over F'').left.ProEt) (c₁ u₁ : V₁ ⟶ π.W), c₁ ≫ σ = u₁ →
        ∀ (t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V₁)) (z : V₁.left),
        (show C(↥V₁.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk u₁))).hom t).down) z =
        Lσ ((show C(↥V₁.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk c₁))).hom t).down) z) := by
      intro V₁ c₁ u₁ hcu t z
      have e1 : ((π.θ.inv ≫ θσ).hom.app (Opposite.op (Over.mk c₁))).hom
          ((π.θ.hom.hom.app (Opposite.op (Over.mk c₁))).hom t) =
          (θσ.hom.app (Opposite.op (Over.mk c₁))).hom t :=
        congrArg (θσ.hom.app (Opposite.op (Over.mk c₁))).hom (hcancel1 (Over.mk c₁) t)
      have E := e1.trans (hres V₁ c₁ u₁ hcu t)
      have h1 := hPt (Over.mk c₁) ((π.θ.hom.hom.app (Opposite.op (Over.mk c₁))).hom t) z
      have h4 := congrArg (fun y : ULift.{u+1} C(↥V₁.left, Fin π.r → ℚ_[ℓ]) => y.down z) E
      exact h4.symm.trans h1
    exact ⟨Lσ, fun s z => hkey π.W (𝟙 π.W) σ (Category.id_comp σ) s z⟩

  have hkeyid : ∀ (τ : V' ⟶ V') (σ : π.W ⟶ π.W)
      (g : (Fin π.r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin π.r → ℚ_[ℓ])),
      σ ≫ π.w = π.w → τ ≫ c = c ≫ σ →
      (∀ (s : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op π.W)) (z : π.W.left),
        (show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk σ))).hom s).down) z =
        g ((show C(↥π.W.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk (𝟙 π.W)))).hom s).down) z)) →
      ∀ t : (wcRq D.f ℓ (n - 1)).obj.obj (Opposite.op V'),
        g ((show C(↥V'.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk c))).hom
            (((wcRq D.f ℓ (n - 1)).obj.map τ.op).hom t)).down) pt) =
        (show C(↥V'.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk c))).hom t).down) pt := by
    intro τ σ g hσ hτc hg t
    obtain ⟨-, hE⟩ := wc_pencil_PL_frame_extend F' F'' Y n hn hn2 D ℓ hℓ hP π σ hσ g hg
    have hnat : ∀ u' : V' ⟶ π.W, τ ≫ c = u' →
        (show C(↥V'.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk u'))).hom
            (((wcRq D.f ℓ (n - 1)).obj.map τ.op).hom t)).down) pt =
        (show C(↥V'.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk c))).hom t).down) pt := by
      rintro u' rfl
      have h : (π.θ.hom.hom.app (Opposite.op (Over.mk (τ ≫ c)))).hom
          ((((wcRq D.f ℓ (n - 1)).over π.W).obj.map
            (Over.homMk τ rfl : Over.mk (τ ≫ c) ⟶ Over.mk c).op).hom t) =
          ((((wcContSheaf (wcP1Over F'').left (Fin π.r → ℚ_[ℓ])).over π.W).obj.map
            (Over.homMk τ rfl : Over.mk (τ ≫ c) ⟶ Over.mk c).op).hom
            ((π.θ.hom.hom.app (Opposite.op (Over.mk c))).hom t)) :=
        congrArg (fun m => m.hom t)
          (π.θ.hom.hom.naturality (Over.homMk τ rfl : Over.mk (τ ≫ c) ⟶ Over.mk c).op)
      have h2 := congrArg (fun y : ULift.{u+1} C(↥V'.left, Fin π.r → ℚ_[ℓ]) => y.down pt) h
      refine h2.trans ?_
      show (show C(↥V'.left, Fin π.r → ℚ_[ℓ]) from
          ((π.θ.hom.hom.app (Opposite.op (Over.mk c))).hom t).down) (τ.left pt) = _
      rw [hsub (τ.left pt)]
    exact (hE V' c (((wcRq D.f ℓ (n - 1)).obj.map τ.op).hom t) pt).symm.trans (hnat _ hτc)
  ext x
  constructor
  ·
    rintro ⟨s, rfl⟩
    intro τ σ g hτu hσ hτc hg
    have k := hkeyid τ σ g hσ hτc hg (((wcRq D.f ℓ (n - 1)).obj.map u.op).hom s)
    rw [hfun τ u s, hτu] at k
    exact k
  · intro hx
    obtain ⟨t₀, ht₀⟩ := hΘsurj x

    have hinv : ∀ τ : V' ⟶ V', τ ≫ u = u →
        ((wcRq D.f ℓ (n - 1)).obj.map τ.op).hom t₀ = t₀ := by
      intro τ hτu
      have hw : c ≫ π.w = (τ ≫ c) ≫ π.w := by
        rw [Category.assoc, ← hc, ← Category.assoc, hτu]
      obtain ⟨σ, hσ, hτc⟩ := hgal V' c (τ ≫ c) hconnV' hw
