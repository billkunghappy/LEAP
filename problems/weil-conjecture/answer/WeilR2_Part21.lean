        (P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₃).rightOp) n).unop
        (P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₁).rightOp) (n + 1)).unop _ _ fe1

  have s3 : ∀ {X X' : ModuleCat.{u} A} (f : X ⟶ X') (P : ProjectiveResolution X)
    (P' : ProjectiveResolution X')
    (w : (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.g))
          (ComplexShape.down ℕ)).app P.complex ≫
        (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.f))
          (ComplexShape.down ℕ)).app P.complex = 0)
    (hS' : (ShortComplex.mk _ _ w).ShortExact)
    (w' : (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.g))
          (ComplexShape.down ℕ)).app P'.complex ≫
        (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.f))
          (ComplexShape.down ℕ)).app P'.complex = 0)
    (hS'' : (ShortComplex.mk _ _ w').ShortExact),
    ((Ext A (ModuleCat.{u} A) n).map f.op).app S.X₃ ≫
        ((((P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₁).rightOp) (n + 1)).hom ≫
            hS'.δ (n + 1) n rfl ≫
            (P.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₃).rightOp) n).inv).unop :
          ((Ext A (ModuleCat.{u} A) n).obj (Opposite.op X)).obj S.X₃ ⟶
            ((Ext A (ModuleCat.{u} A) (n + 1)).obj (Opposite.op X)).obj S.X₁)) =
      ((((P'.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₁).rightOp) (n + 1)).hom ≫
            hS''.δ (n + 1) n rfl ≫
            (P'.isoLeftDerivedObj (((linearYoneda A (ModuleCat.{u} A)).obj S.X₃).rightOp) n).inv).unop :
          ((Ext A (ModuleCat.{u} A) n).obj (Opposite.op X')).obj S.X₃ ⟶
            ((Ext A (ModuleCat.{u} A) (n + 1)).obj (Opposite.op X')).obj S.X₁)) ≫
