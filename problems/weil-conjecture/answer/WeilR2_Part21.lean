        (∀ E, Function.Bijective (fun g : A' ⟶ E => θ' ≫ R.map g)) →
        ∀ a : P ≅ P', ∃ β : A ≅ A', θ ≫ R.map β.hom = a.hom ≫ θ' := by
      intro A A' P P' θ θ' hθ hθ' a
      obtain ⟨b, hb⟩ := (hθ A').2 (a.hom ≫ θ')
      obtain ⟨b', hb'⟩ := (hθ' A).2 (a.inv ≫ θ)
      have hb0 : θ ≫ R.map b = a.hom ≫ θ' := hb
      have hb0' : θ' ≫ R.map b' = a.inv ≫ θ := hb'
      have h1 : b ≫ b' = 𝟙 A := by
