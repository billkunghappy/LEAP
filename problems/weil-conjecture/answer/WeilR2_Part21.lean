        ((wcContSheaf B M).obj.map (k ≫ (wcProEtBaseChange i).map a₁).op).hom ρ' = c ∧
        ((wcContSheaf B M).obj.map (k ≫ (wcProEtBaseChange i).map a₂).op).hom ρ' = c' := by
    intro W c c'
    obtain ⟨k, hk, -⟩ := UB₂ W (ContinuousMap.prodMk (show ULift.{u+1} C(↥W.left, M) from c).down
      (show ULift.{u+1} C(↥W.left, M) from c').down)
    refine ⟨k, ULift.ext_iff.mpr (ContinuousMap.ext fun t => ?_),
      ULift.ext_iff.mpr (ContinuousMap.ext fun t => ?_)⟩
    · show π ((Limits.pullback.fst p i).base
          (((wcProEtBaseChange i).map a₁).left.base (k.left.base t))) = _
      rw [hfst a₁ (k.left.base t)]
      exact (ha₁ _).trans (congrArg Prod.fst (hk t))
    · show π ((Limits.pullback.fst p i).base
          (((wcProEtBaseChange i).map a₂).left.base (k.left.base t))) = _
      rw [hfst a₂ (k.left.base t)]
      exact (ha₂ _).trans (congrArg Prod.snd (hk t))

