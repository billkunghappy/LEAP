    obtain ⟨c5⟩ := wc_contSheaf_discrete_const (wcProjK F'' M')
      ((i : Fin (b y hy)) → ZMod (ℓ ^ e y hy i))
    exact ⟨((Scheme.ProEt.topology (wcProjK F'' M')).overPullback AddCommGrpCat.{u+1}
        ((wcEtToProEt (wcProjK F'' M')).obj (U y hy))).mapIso α ≪≫ s3 ≪≫
      ((Scheme.ProEt.topology (wcProjK F'' M')).overPullback AddCommGrpCat.{u+1}
        ((wcEtToProEt (wcProjK F'' M')).obj (U y hy))).mapIso c6 ≪≫
      ((Scheme.ProEt.topology (wcProjK F'' M')).overPullback AddCommGrpCat.{u+1}
        ((wcEtToProEt (wcProjK F'' M')).obj (U y hy))).mapIso c5.symm⟩

  haveI := hcpt
  have hyW : ∀ x : Ub.toScheme,
      (Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) x ∈ W := by
    intro x
    have hx : Ub.ι x ∈ (Ub : Set _) := by
      rw [← Scheme.Opens.range_ι]
      exact ⟨x, rfl⟩
    rw [Scheme.Hom.comp_apply]
    exact (hUb (Ub.ι x)).1 hx
  have hEt : ∀ x : Ub.toScheme, Etale (Limits.pullback.snd (U _ (hyW x)).hom
      (Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom)) := by
    intro x
    haveI : Etale (U _ (hyW x)).hom := (U _ (hyW x)).prop
    infer_instance
  have hopen : ∀ x : Ub.toScheme, IsOpen (Set.range (Limits.pullback.snd (U _ (hyW x)).hom
      (Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom))) := by
    intro x
    haveI := hEt x
    exact (Limits.pullback.snd (U _ (hyW x)).hom
      (Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom)).isOpenMap.isOpen_range
  have hmem : ∀ x : Ub.toScheme, x ∈ Set.range (Limits.pullback.snd (U _ (hyW x)).hom
      (Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom)) := by
    intro x
    obtain ⟨z, -, hz⟩ := Scheme.Pullback.exists_preimage_pullback (f := (U _ (hyW x)).hom)
      (g := Ub.ι ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom)
