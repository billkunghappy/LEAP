theorem wc_proet_left_adjoint_over_transport {X B : Scheme.{u}} (i : B ⟶ X)
    (L : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1})
    (adj : L ⊣ wcProEtPush i) (V : X.ProEt)
    (F F' : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (α : F.over V ≅ F'.over V) :
    ∃ β : (L.obj F).over ((wcProEtBaseChange i).obj V) ≅
        (L.obj F').over ((wcProEtBaseChange i).obj V),
      ∀ (s : F.obj.obj (Opposite.op V))
        (y : (L.obj F).obj.obj (Opposite.op ((wcProEtBaseChange i).obj V))),
