      [HasWeakSheafify J AddCommGrpCat.{u+1}]
      (bc : C ⥤ D) [bc.IsContinuous J K] [PreservesLimitsOfShape (Discrete WalkingPair) bc]
      (L : Sheaf J AddCommGrpCat.{u+1} ⥤ Sheaf K AddCommGrpCat.{u+1})
