    refine (Ideal.span_le.mpr ?_) hy
    rintro z (⟨q, rfl⟩ | ⟨k, rfl⟩)
    · exact ht q
    · exact Submodule.mem_sup_left (hζN k)
  have s3 : ∀ (O : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O] (N : ℕ), ringKrullDim O = (N : WithBot ℕ∞) → ∀ (ι : Type) [Fintype ι] (f : ι → IsLocalRing.maximalIdeal O), Fintype.card ι = N → IsLocalRing.maximalIdeal O = Ideal.span (Set.range (fun i => (f i : O))) → IsRegularLocalRing O ∧ LinearIndependent (IsLocalRing.ResidueField O) (fun i => (IsLocalRing.maximalIdeal O).toCotangent (f i)) := by
    intro O _ _ _ N hdim ι _ f hcard hspan
    classical
    have hbound : ∀ (κ : Type) [Fintype κ] (g : κ → O),
        IsLocalRing.maximalIdeal O = Ideal.span (Set.range g) →
        (IsLocalRing.maximalIdeal O).spanFinrank ≤ Fintype.card κ := by
      intro κ _ g hg
