theorem wc_proet_contPull_adj_iso_ladic_of_int {X B : Scheme.{u}} (i : B ⟶ X)
    (L : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1})
    (adj : L ⊣ wcProEtPush i) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (hint : IsIso ((adj.homEquiv (wcContSheaf X (Fin r → ℤ_[ℓ])) (wcContSheaf B (Fin r → ℤ_[ℓ]))).symm
      (wcContPull i (Fin r → ℤ_[ℓ])))) :
    IsIso ((adj.homEquiv (wcContSheaf X (Fin r → ℚ_[ℓ])) (wcContSheaf B (Fin r → ℚ_[ℓ]))).symm
      (wcContPull i (Fin r → ℚ_[ℓ]))) :=
by
  classical

  have nat : ∀ {M N : Type} [AddCommGroup M] [TopologicalSpace M] [IsTopologicalAddGroup M]
      [AddCommGroup N] [TopologicalSpace N] [IsTopologicalAddGroup N] (φ : M →+ N)
      (hφ : Continuous φ),
      L.map (wcContSheafMap X φ hφ) ≫
          (adj.homEquiv (wcContSheaf X N) (wcContSheaf B N)).symm (wcContPull i N) =
        (adj.homEquiv (wcContSheaf X M) (wcContSheaf B M)).symm (wcContPull i M) ≫
          wcContSheafMap B φ hφ := by
    intro M N _ _ _ _ _ _ φ hφ
    rw [← adj.homEquiv_naturality_left_symm, ← adj.homEquiv_naturality_right_symm,
      wc_contPull_contSheafMap]

  let ψ : ℕ → ((Fin r → ℤ_[ℓ]) →+ (Fin r → ℚ_[ℓ])) := fun n =>
    { toFun := fun v j => ((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * ((v j : ℤ_[ℓ]) : ℚ_[ℓ])
      map_zero' := by funext j; simp
      map_add' := by intro v w; funext j; simp [mul_add] }
  have hψc : ∀ n, Continuous (ψ n) := by
    intro n
    apply continuous_pi
    intro j
    have h1 : Continuous fun v : Fin r → ℤ_[ℓ] => ((v j : ℤ_[ℓ]) : ℚ_[ℓ]) :=
      Continuous.subtype_val (continuous_apply j)
    show Continuous fun v : Fin r → ℤ_[ℓ] => ((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * ((v j : ℤ_[ℓ]) : ℚ_[ℓ])
    exact continuous_const.mul h1
  have hψ : ∀ n v j, ψ n v j = ((ℓ : ℚ_[ℓ]) ^ n)⁻¹ * ((v j : ℤ_[ℓ]) : ℚ_[ℓ]) :=
    fun _ _ _ => rfl
  obtain ⟨κX, ⟨hX⟩, hκX⟩ := wc_contSheaf_ladic_pi_tower_colimit_legs X ℓ r ψ hψc hψ
  obtain ⟨κB, ⟨hB⟩, hκB⟩ := wc_contSheaf_ladic_pi_tower_colimit_legs B ℓ r ψ hψc hψ
  have hsX := (wc_contSheafMap_scalar_facts X ℓ r).2.1 ℓ
  have hsB := (wc_contSheafMap_scalar_facts B ℓ r).2.1 ℓ

  let τ : Functor.ofSequence (X := fun _ : ℕ => wcContSheaf X (Fin r → ℤ_[ℓ])) (fun _ => ℓ • 𝟙 _) ⋙ L ⟶
      Functor.ofSequence (X := fun _ : ℕ => wcContSheaf B (Fin r → ℤ_[ℓ])) (fun _ => ℓ • 𝟙 _) :=
    NatTrans.ofSequence
      (fun _ => (adj.homEquiv (wcContSheaf X (Fin r → ℤ_[ℓ])) (wcContSheaf B (Fin r → ℤ_[ℓ]))).symm
        (wcContPull i (Fin r → ℤ_[ℓ])))
      (fun n => by
        rw [Functor.comp_map, Functor.ofSequence_map_homOfLE_succ,
          Functor.ofSequence_map_homOfLE_succ, ← hsX, ← hsB]
        exact nat _ _)
  have happ : ∀ n, τ.app n =
      (adj.homEquiv (wcContSheaf X (Fin r → ℤ_[ℓ])) (wcContSheaf B (Fin r → ℤ_[ℓ]))).symm
        (wcContPull i (Fin r → ℤ_[ℓ])) := fun n => NatTrans.ofSequence_app _ _ n
  haveI : IsIso τ := (NatTrans.isIso_iff_isIso_app τ).2 (fun n => by rw [happ n]; exact hint)
  haveI : Limits.PreservesColimitsOfSize.{0, 0} L := adj.leftAdjoint_preservesColimits
  let hL := Limits.isColimitOfPreserves L hX
  have key : (adj.homEquiv (wcContSheaf X (Fin r → ℚ_[ℓ])) (wcContSheaf B (Fin r → ℚ_[ℓ]))).symm
      (wcContPull i (Fin r → ℚ_[ℓ])) = (hL.coconePointsIsoOfNatIso hB (asIso τ)).hom := by
    apply hL.hom_ext
    intro n
    rw [Limits.IsColimit.comp_coconePointsIsoOfNatIso_hom]
    show L.map (κX.app n) ≫ _ = τ.app n ≫ κB.app n
    rw [hκX n, hκB n, happ n]
    exact nat (ψ n) (hψc n)
  rw [key]
  infer_instance

theorem wc_proet_bc_transport_triv {X B : Scheme.{u}} (i : B ⟶ X) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
