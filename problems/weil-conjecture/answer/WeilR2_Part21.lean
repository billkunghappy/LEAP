theorem wc_pfam_Rq_torsion_etale_locally_const (F'' : Type u) [Field F''] [Finite F''] (M' : ℕ)
    (X : Scheme.{u}) (h : X ⟶ wcProjK F'' M') [IsProper h] (Δ : Set (wcProjK F'' M'))
    (hΔ : IsClosed Δ)
