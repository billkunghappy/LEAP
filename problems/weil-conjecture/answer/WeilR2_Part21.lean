theorem wc_pfam_xwt_top_inertia_trivial (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (j : Fin D.m) (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : Vy.left ≅ Spec (.of A))
    (hVy : Vy.hom (e.inv (IsLocalRing.closedPoint A)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (L : Type u) [Field L] [IsSepClosed L] (eL : Ty.left ≅ Spec (.of L))
    (Vξ : (wcProjK F'' M').ProEt) (ι : Vξ ⟶ Vy) (uξ : Ty ⟶ Vξ)
    (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    (e' : Vξ.left ≅ Spec (.of A')) (hιu : uξ ≫ ι = uy)
    (hΔξ : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      ((ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))) ∈ Δ)
    (hclξ : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
      y ∈ closure {(ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))}) :
    ∀ m : Ty ⟶ Ty, m ≫ uξ = uξ →
      ∀ z : (wcRq h ℓ (2 * (n - 1))).obj.obj (Opposite.op Ty),
        ((wcRq h ℓ (2 * (n - 1))).obj.map m.op).hom z = z :=
by
  classical

  haveI hres : IsSepClosed (IsLocalRing.ResidueField L) := by
    have hinj : Function.Injective (IsLocalRing.residue L) := (IsLocalRing.residue L).injective
    let φ : L ≃+* IsLocalRing.ResidueField L :=
      RingEquiv.ofBijective (IsLocalRing.residue L) ⟨hinj, IsLocalRing.residue_surjective⟩
    refine IsSepClosed.of_exists_root _ (fun p _ hirr hsep => ?_)
    set q : Polynomial L := p.map (φ.symm : IsLocalRing.ResidueField L →+* L) with hq
    have hqs : q.Separable := hsep.map
    have hdeg : q.degree ≠ 0 := by
      rw [hq, Polynomial.degree_map]
      exact (Polynomial.degree_pos_of_irreducible hirr).ne'
    obtain ⟨y, hy⟩ := IsSepClosed.exists_root q hdeg hqs
    refine ⟨φ y, ?_⟩
    have hp : p = q.map (φ : L →+* IsLocalRing.ResidueField L) := by
      rw [hq, Polynomial.map_map]
      have : ((φ : L →+* IsLocalRing.ResidueField L).comp
          (φ.symm : IsLocalRing.ResidueField L →+* L)) = RingHom.id _ := by
        ext z; simp
      rw [this, Polynomial.map_id]
    rw [hp, Polynomial.eval_map]
    exact (Polynomial.eval₂_at_apply (φ : L →+* IsLocalRing.ResidueField L) y).trans
      (by rw [hy.eq_zero, map_zero])

  have hVξp := wc_proet_free_projective_strict_local (wcProjK F'' M') Vξ A' e'
  have hTyp := wc_proet_free_projective_strict_local (wcProjK F'' M') Ty L eL

  obtain ⟨Φ, -, hΦn⟩ := wc_proet_Rq_hm_comparison h ℓ
  obtain ⟨Da, hDa⟩ := wc_hm_pull_data_exists ((wcProEtPullback h).map uξ).left ℓ
  choose Dk hDk using fun k : ℕ =>
    wc_zmod_pull_data_exists ((wcProEtPullback h).map uξ).left (ℓ ^ k)

  obtain ⟨-, hp1, hc1, hq1, -, -⟩ := wc_pfam_line_fibre_square D M' Xu h Δ lam p hH Vξ A' e'
  obtain ⟨-, hp2, hc2, hq2, -, -⟩ := wc_pfam_line_fibre_square D M' Xu h Δ lam p hH Ty L eL
  haveI := hc1
  haveI := hq1
  haveI := hc2
  haveI := hq2
  obtain ⟨g₁, hg₁⟩ : ∃ g : ((wcProEtPullback h).obj Vξ).left ⟶ Spec (.of A'), IsProper g :=
    ⟨_, hp1⟩
  obtain ⟨g₂, hg₂⟩ : ∃ g : ((wcProEtPullback h).obj Ty).left ⟶ Spec (.of L), IsProper g :=
    ⟨_, hp2⟩
  haveI := hg₁
  haveI := hg₂

  have s2 : ∀ (k : ℕ) (K : Type u) [Field K] (c : Spec (.of K) ⟶ Spec (.of F'')),
      ((ℓ ^ k : ℕ) : K) ≠ 0 := by
    intro k K _ c h0
    have hmF : ((ℓ ^ k : ℕ) : F'') ≠ 0 := by
      intro h0
      haveI := Fintype.ofFinite F''
      obtain ⟨p, hp⟩ := CharP.exists F''
      haveI := hp
      have hpp : p.Prime := CharP.char_is_prime F'' p
      have h1 : p ∣ ℓ ^ k := (CharP.cast_eq_zero_iff F'' p _).mp h0
      have h2 : p ∣ ℓ := hpp.dvd_of_dvd_pow h1
      have h3 : p = ℓ := (Nat.prime_dvd_prime_iff_eq hpp Fact.out).mp h2
      have h4 : p ∣ Fintype.card F'' :=
        (CharP.cast_eq_zero_iff F'' p _).mp (FiniteField.cast_card_eq_zero F'')
      apply hℓ
      rw [← h3, Nat.card_eq_fintype_card]
      exact h4
    apply hmF
    apply (Spec.preimage c).hom.injective
    rw [map_natCast, map_zero]
    exact h0

  have hfinY : ∀ k : ℕ, 1 ≤ k →
      Finite (wcZModProEtExt ((wcProEtPullback h).obj Vξ).left (ℓ ^ k) (2 * (n - 1))) := by
    intro k _
    exact wc_strict_hens_proper_zmod_proet_finite A' _ g₁ (ℓ ^ k)
      (s2 k (IsLocalRing.ResidueField A')
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A')) ≫ e'.inv ≫ Vξ.hom ≫
          wcProjKStr F'' M')) _
  have hfinT : ∀ k : ℕ, 1 ≤ k →
      Finite (wcZModProEtExt ((wcProEtPullback h).obj Ty).left (ℓ ^ k) (2 * (n - 1) - 1)) := by
    intro k _
    exact wc_strict_hens_proper_zmod_proet_finite L _ g₂ (ℓ ^ k)
      (s2 k (IsLocalRing.ResidueField L)
        (Spec.map (CommRingCat.ofHom (IsLocalRing.residue L)) ≫ eL.inv ≫ Ty.hom ≫
          wcProjKStr F'' M')) _

  have hpull : Function.Surjective (wcHMPull Da (2 * (n - 1))) :=
    wc_ladic_pull_surjective_of_torsion ℓ ((wcProEtPullback h).map uξ).left Da hDa Dk hDk
      (2 * (n - 1)) hfinY hfinT (fun k hk =>
        wc_pfam_xwt_sp_torsion_top_surj F' F'' Y n hn hn2 D ℓ hℓ M' Xu h Δ lam p hH hPP j
          Vy Ty uy vy A e hVy L eL Vξ ι uξ A' e' hιu hΔξ hclξ k hk (Dk k) (hDk k))

  have hsurjρ : ∀ z : (wcRq h ℓ (2 * (n - 1))).obj.obj (Opposite.op Ty),
      ∃ w : (wcRq h ℓ (2 * (n - 1))).obj.obj (Opposite.op Vξ),
        ((wcRq h ℓ (2 * (n - 1))).obj.map uξ.op).hom w = z := by
    intro z
    obtain ⟨x, hx⟩ := hpull (Φ (2 * (n - 1)) Ty hTyp z)
    refine ⟨(Φ (2 * (n - 1)) Vξ hVξp).symm x, ?_⟩
    apply (Φ (2 * (n - 1)) Ty hTyp).injective
    rw [hΦn (2 * (n - 1)) Vξ Ty hVξp hTyp uξ Da hDa, AddEquiv.apply_symm_apply, hx]

  intro m hm z
  obtain ⟨w, rfl⟩ := hsurjρ z
  have hx : ((wcRq h ℓ (2 * (n - 1))).obj.map (m ≫ uξ).op).hom w =
      ((wcRq h ℓ (2 * (n - 1))).obj.map m.op).hom
        (((wcRq h ℓ (2 * (n - 1))).obj.map uξ.op).hom w) := by
    rw [op_comp, CategoryTheory.Functor.map_comp]
    rfl
  rw [hm] at hx
  exact hx.symm

theorem wc_pfam_xwt_cup_form (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (j : Fin D.m) (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : Vy.left ≅ Spec (.of A))
    (hVy : Vy.hom (e.inv (IsLocalRing.closedPoint A)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (L : Type u) [Field L] [IsSepClosed L] (eL : Ty.left ≅ Spec (.of L))
    (Vξ : (wcProjK F'' M').ProEt) (ι : Vξ ⟶ Vy) (uξ : Ty ⟶ Vξ)
    (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    (e' : Vξ.left ≅ Spec (.of A')) (hιu : uξ ≫ ι = uy)
    (hΔξ : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom
      ((ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))) ∈ Δ)
    (hclξ : ∀ y : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
      (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom y ∈ Δ →
      y ∈ closure {(ι ≫ vy).left (e'.inv (IsLocalRing.closedPoint A'))}) :
    ∃ B : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty) →+
        (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty) →+ ℚ_[ℓ],
      (∀ (c : ℚ_[ℓ]) (y y' : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty)),
        B (((wcRqScalar h ℓ (n - 1) c).hom.app (Opposite.op Ty)).hom y) y' = c * B y y') ∧
      (∀ y y', B y y' = -(B y' y)) ∧
      (∀ y, (∀ y', B y y' = 0) → y = 0) ∧
