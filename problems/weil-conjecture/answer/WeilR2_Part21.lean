  obtain ⟨tb, τC, A, hm, hτC, hcub, hA⟩ := D.odp j
  obtain ⟨v, hv, hpφ⟩ := wc_pfam_mc_odp_stalk_unit p D.f h lam hpb.w
    (D.xs j (IsLocalRing.closedPoint F'')) (D.S j (IsLocalRing.closedPoint F'')) hfx W hyW' hxW
    φ τC hτC hunifW
  have hπG : π (algebraMap Γ(Xu.left, V) (Localization.AtPrime (RingHom.ker e)) (ρ φ)) =
