    intro C D _ _ G' A T g' hg' M₀ hM
    obtain ⟨m, hm⟩ := (hg' A).2 M₀
    simp only at hm
    have hk : ∀ {Q : C} (x : A ⟶ Q), g' ≫ G'.map (m ≫ x) = M₀ ≫ G'.map x := by
      intro Q x
