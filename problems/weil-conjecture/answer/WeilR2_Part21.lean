    IsScalarTower.of_algebraMap_eq (fun a => by
      show κ a = f (MvPolynomial.C a)
      exact (MvPolynomial.eval₂Hom_C κ _ a).symm)
  haveI : Algebra.Etale (MvPolynomial (Option (Fin r)) K) T := RingHom.Etale.toAlgebra hf
  let E := KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale K (MvPolynomial (Option (Fin r)) K) T
  refine ⟨((KaehlerDifferential.mvPolynomialBasis K (Option (Fin r))).baseChange T).map E, ?_⟩
  intro o
  rw [Module.Basis.map_apply, Module.Basis.baseChange_apply,
    KaehlerDifferential.mvPolynomialBasis_apply,
    KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale_apply,
    KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]
  congr 1
  show f (MvPolynomial.X o) = _
  simp [f]

