by
  classical

  have bridge : ∀ {X₁ Pb T₁ T₂ E₁ T₃ : Scheme.{u}} (ff : X₁ ⟶ Pb) (uu : T₁ ⟶ Pb) (aa : T₂ ⟶ Pb)
