        rfl
      · rw [RingHom.comp_apply, RingHom.coe_coe, hΨroot, hΦt, map_one, mul_one, hfroot, RingHom.id_apply]
    have h2 : Ψ.comp (Φ : TensorProduct R (AdjoinRoot (Polynomial.X ^ N - Polynomial.C a)) S →+* _) = RingHom.id _ := by
      refine RingHom.ext fun t => ?_
