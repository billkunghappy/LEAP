      refine hcont.congr ?_
      intro z
      have h1 := hb Zo P₁ P₂ hl t z
      rw [ht z, hid z] at h1
      exact h1
    ·
      intro Z a b d hab hbd had z
      obtain ⟨f₂, hf₂⟩ : ∃ f : Limits.pullback w.left w.left ⟶
          (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).left,
          f = Limits.pullback.snd w.left w.left ≫ w.left := ⟨_, rfl⟩
      haveI : WeaklyEtale (Limits.pullback.fst f₂ w.left) := inferInstance
      haveI : WeaklyEtale (Limits.pullback.fst f₂ w.left ≫
        Limits.pullback.fst w.left w.left ≫ W.hom) := inferInstance
      let Q3 : (wcProjK F'' M').ProEt := Scheme.ProEt.mk (Limits.pullback.fst f₂ w.left ≫
        Limits.pullback.fst w.left w.left ≫ W.hom)
      have eab : (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left) ≫ w.left =
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) ≫ w.left := by
        rw [Category.assoc, Category.assoc, Limits.pullback.condition (f := w.left) (g := w.left)]
      have ebd : (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) ≫ w.left =
          Limits.pullback.snd f₂ w.left ≫ w.left := by
        rw [Category.assoc, ← hf₂]
        exact Limits.pullback.condition (f := f₂) (g := w.left)
      have ead := eab.trans ebd
      have hqb : (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) ≫ W.hom =
          Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left ≫ W.hom := by
        rw [← MorphismProperty.Over.w w,
          ← Category.assoc (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left),
          ← eab]
        simp only [Category.assoc]
      have hqd : Limits.pullback.snd f₂ w.left ≫ W.hom =
          Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left ≫ W.hom := by
        rw [← MorphismProperty.Over.w w, ← Category.assoc (Limits.pullback.snd f₂ w.left),
          ← ebd, ← eab]
        simp only [Category.assoc]
      let Qa : Q3 ⟶ W := MorphismProperty.Over.homMk
        (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
        (Category.assoc _ _ _) trivial
      let Qb : Q3 ⟶ W := MorphismProperty.Over.homMk
        (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) hqb trivial
      let Qd : Q3 ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd f₂ w.left) hqd trivial
      have hQ : ∀ y : ↥(Limits.pullback f₂ w.left),
          A (γ (Limits.pullback.lift
            (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
            (Limits.pullback.snd f₂ w.left) ead y)) =
          A (γ (Limits.pullback.lift
            (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left)
            (Limits.pullback.snd f₂ w.left) ebd y)) ∘ₗ
          A (γ (Limits.pullback.lift
            (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
            (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) eab y)) := by
        intro y
        apply LinearMap.ext
        intro v₀
        obtain ⟨t, ht⟩ := hK Q3 Qa v₀
        have e1 := hb Q3 Qa Qb eab t y
        have e2 := hb Q3 Qb Qd ebd t y
        have e3 := hb Q3 Qa Qd ead t y
        rw [ht y] at e1 e3
        rw [e1] at e2
        rw [LinearMap.comp_apply]
        exact e3.symm.trans e2
      have hm : Limits.pullback.lift a b hab ≫ f₂ = d ≫ w.left := by
        rw [hf₂, Limits.pullback.lift_snd_assoc]
        exact hbd
      obtain ⟨m, hm1, hm2⟩ : ∃ m : Z ⟶ Limits.pullback f₂ w.left,
          m ≫ Limits.pullback.fst f₂ w.left = Limits.pullback.lift a b hab ∧
          m ≫ Limits.pullback.snd f₂ w.left = d :=
        ⟨Limits.pullback.lift _ _ hm, Limits.pullback.lift_fst _ _ _,
          Limits.pullback.lift_snd _ _ _⟩
      have ma : m ≫ (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left) = a := by
        rw [← Category.assoc, hm1, Limits.pullback.lift_fst]
      have mb : m ≫ (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) = b := by
        rw [← Category.assoc, hm1, Limits.pullback.lift_snd]
      have e_ab : Limits.pullback.lift a b hab = m ≫ Limits.pullback.lift
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) eab := by
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst, ma]
        · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd, mb]
      have e_bd : Limits.pullback.lift b d hbd = m ≫ Limits.pullback.lift
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left)
          (Limits.pullback.snd f₂ w.left) ebd := by
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst, mb]
        · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd, hm2]
      have e_ad : Limits.pullback.lift a d had = m ≫ Limits.pullback.lift
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
          (Limits.pullback.snd f₂ w.left) ead := by
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, Category.assoc, Limits.pullback.lift_fst, ma]
        · rw [Limits.pullback.lift_snd, Category.assoc, Limits.pullback.lift_snd, hm2]
      have k1 : Limits.pullback.lift a d had z = Limits.pullback.lift
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
          (Limits.pullback.snd f₂ w.left) ead (m z) := by
        rw [e_ad]; exact Scheme.Hom.comp_apply _ _ _
      have k2 : Limits.pullback.lift b d hbd z = Limits.pullback.lift
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left)
          (Limits.pullback.snd f₂ w.left) ebd (m z) := by
        rw [e_bd]; exact Scheme.Hom.comp_apply _ _ _
      have k3 : Limits.pullback.lift a b hab z = Limits.pullback.lift
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.fst w.left w.left)
          (Limits.pullback.fst f₂ w.left ≫ Limits.pullback.snd w.left w.left) eab (m z) := by
        rw [e_ab]; exact Scheme.Hom.comp_apply _ _ _
      show A (γ (Limits.pullback.lift a d had z)) =
        A (γ (Limits.pullback.lift b d hbd z)) ∘ₗ A (γ (Limits.pullback.lift a b hab z))
      rw [k1, k2, k3]
      exact hQ (m z)
    ·
      intro δ g hδ _ hg z
      apply LinearMap.ext
      intro v₀
      obtain ⟨s, hs⟩ := hK W (𝟙 W) v₀
      have h1 := hb W δ (𝟙 W) hδ s z
      have h2 := hg s z
      rw [hs z] at h1 h2
      rw [h2] at h1
      rw [LinearMap.comp_apply, LinearMap.id_apply]
      exact h1.symm

  obtain ⟨G₀, hGa, hGb, hGc, hGd, hGe⟩ :=
    hTF Ω₀.W' Ω₀.w' Ω₀.r' Ω₀.θ' Ω₀.hconn' Ω₀.hgal'
  have hconj_comp : ∀ A B : (Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ]),
      π₀.toLinearMap ∘ₗ (A ∘ₗ B) ∘ₗ π₀.symm.toLinearMap =
        (π₀.toLinearMap ∘ₗ A ∘ₗ π₀.symm.toLinearMap) ∘ₗ
          (π₀.toLinearMap ∘ₗ B ∘ₗ π₀.symm.toLinearMap) := by
    intro A B
    apply LinearMap.ext
    intro y
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
  have hconj_id : π₀.toLinearMap ∘ₗ
      (LinearMap.id : (Fin Ω₀.r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin Ω₀.r' → ℚ_[ℓ])) ∘ₗ
        π₀.symm.toLinearMap = LinearMap.id := by
    apply LinearMap.ext
    intro y
    simp only [LinearMap.comp_apply, LinearMap.id_apply, LinearEquiv.coe_coe,
      LinearEquiv.apply_symm_apply]
  have hGL : ∀ z, π₀.toLinearMap ∘ₗ G₀ z ∘ₗ π₀.symm.toLinearMap ∈ GLs := by
    intro z
    obtain ⟨γ, hγ, hfrm⟩ := hGa z
    exact hfr γ (G₀ z) hγ hfrm
  have hdeckl : ∀ δ : Ω₀.W' ⟶ Ω₀.W', δ ≫ Ω₀.w' = Ω₀.w' →
      δ.left ≫ Ω₀.w'.left = 𝟙 Ω₀.W'.left ≫ Ω₀.w'.left := by
    intro δ hδ
    rw [Category.id_comp]
    exact congrArg (fun f => f.left) hδ

  have hrange : Set.range ⇑Ω₀.w'.left ⊆ Set.range ⇑Ub.ι := by
    rintro _ ⟨z, rfl⟩
    rw [Scheme.Opens.range_ι]
    show Ω₀.w'.left z ∈ Ub
    rw [hUb]
    have h1 : (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom (Ω₀.w'.left z) =
        Ω₀.W'.hom z := by
      rw [← Scheme.Hom.comp_apply Ω₀.w'.left
        (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom, MorphismProperty.Over.w Ω₀.w']
    rw [h1]
    exact Ω₀.hoff' z
  obtain ⟨p, hp⟩ : ∃ p : Ω₀.W'.left ⟶ Ub.toScheme, p ≫ Ub.ι = Ω₀.w'.left :=
    ⟨_, IsOpenImmersion.lift_fac Ub.ι Ω₀.w'.left hrange⟩
  haveI hwe : WeaklyEtale Ω₀.w'.left := by
    haveI : WeaklyEtale (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom :=
