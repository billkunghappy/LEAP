by
  classical
  obtain ⟨_, hprop, _, _, hΔ, _, hsm, _, _, _, _, hlamΔ, _⟩ := hH
  haveI hfp : IsProper h := hprop

  have hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  have hP1 : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  refine ⟨hPP, ?_⟩
  haveI hPw : WeaklyEtale (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom := hPP

  obtain ⟨Ub₁, hUb₁, hconn₁, -, -, -⟩ := wc_P1bar_smooth_locus F'' hP1 D.m D.S D.hS
