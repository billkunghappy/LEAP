  obtain ⟨hpsurj, hpker⟩ := wc_pfam_mc_pullback_stalk_ideal p D.f h lam hpb hlam
    (D.xs j (IsLocalRing.closedPoint F'')) (D.S j (IsLocalRing.closedPoint F'')) hfx W hyW' hxW
    (Set.range z) hkerW
  let π : Localization.AtPrime (RingHom.ker e) →+*
