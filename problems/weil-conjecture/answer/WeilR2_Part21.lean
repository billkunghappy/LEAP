  obtain ⟨B, hB⟩ : ∃ B : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty) →+
      (wcRq h ℓ (n - 1)).obj.obj (Opposite.op Ty) →+ ℚ_[ℓ],
      ∀ y y', B y y' = η (wcHMCup ((wcProEtPullback h).obj Ty).left ℓ (n - 1) (n - 1)
        (2 * (n - 1)) (two_mul (n - 1)).symm (Φ (n - 1) Ty hTy y) (Φ (n - 1) Ty hTy y')) :=
    ⟨((((wcHMCup ((wcProEtPullback h).obj Ty).left ℓ (n - 1) (n - 1) (2 * (n - 1))
        (two_mul (n - 1)).symm).compr₂ η).comp (Φ (n - 1) Ty hTy).toAddMonoidHom).compl₂
        (Φ (n - 1) Ty hTy).toAddMonoidHom), fun _ _ => rfl⟩
  refine ⟨B, ?_, ?_, ?_, ?_⟩
  · intro c y y'
