    refine ⟨(e : TensorProduct R (AdjoinRoot (Polynomial.X ^ N - Polynomial.C a)) S →+* _).comp
      Algebra.TensorProduct.includeLeftRingHom, ?_, ?_, wc_indEtale_comp _ _ hIL (dev_iso_indEtale e)⟩
    · ext r
      show Φ (AdjoinRoot.of _ r ⊗ₜ[R] (1 : S)) = _
