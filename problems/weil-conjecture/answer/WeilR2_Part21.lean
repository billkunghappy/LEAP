      ((toSheafify (Scheme.ProEt.topology X)
          ((wcProEtBaseChange i).op ⋙ (L.obj G₁).obj)).app (Opposite.op V)).hom y =
        ((adj.unit.app G₁).hom.app (Opposite.op V)).hom s →
      ((toSheafify (Scheme.ProEt.topology X)
          ((wcProEtBaseChange i).op ⋙ H₁.obj)).app (Opposite.op V)).hom
        ((((adj.homEquiv G₁ H₁).symm g).hom.app
          (Opposite.op ((wcProEtBaseChange i).obj V))).hom y) =
