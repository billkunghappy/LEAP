        · left
          have h0 : (r * y) * (1 - r * y) = 0 := by rw [mul_sub, mul_one, he, sub_self]
          exact (hu.mul_left_eq_zero).mp h0
      rcases hconn with h | h
      · left
        rw [hy, mul_assoc, h, mul_zero]
      · right
        exact ⟨⟨r, y, h, by rw [mul_comm]; exact h⟩, rfl⟩
    refine ⟨exists_pair_ne R, fun a b => mul_comm a b, fun {a} ha => ?_⟩
    rcases hunit a with h | h
    · exact absurd h ha
    · obtain ⟨b, hb⟩ := h.exists_right_inv
      exact ⟨b, hb⟩



