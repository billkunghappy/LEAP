            rw [← Matrix.mul_assoc, ← Matrix.mul_assoc, Matrix.nonsing_inv_mul _ hU, Matrix.one_mul]
        _ = M⁻¹ * M := by rw [hMM]
        _ = 1 := Matrix.nonsing_inv_mul _ hU
    exact Matrix.det_ne_zero_of_right_inverse h1
  intro K O _ _ _ _ _ n r hdim e he t ζ b hgen hb1 hb2 G a H w ha hH hG hcrit
  classical
  obtain ⟨δ, hδ⟩ : ∃ δ : Fin n → Derivation K O O,
      ∀ i, (b.coord (Sum.inl i)).compDer (KaehlerDifferential.D K O) = δ i := ⟨_, fun i => rfl⟩
  simp only [hδ] at hcrit ⊢
  have heι : ∀ k, e (algebraMap K O k) = k := fun k => by
