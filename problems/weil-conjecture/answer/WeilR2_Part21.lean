    refine ⟨IsAdicComplete.liftRingHom J f hf, fun F k => ?_⟩
    have h := IsAdicComplete.mk_liftRingHom J f hf k F
    rw [← Ideal.Quotient.eq]
    exact h
  have wc_plt_hlgc_cohen_approx : ∀ (S : Type u) [CommRing S] [Algebra K S] (n : ℕ) (α : Fin n → S) (hres : ∀ s : S, ∃ c : K, s - algebraMap K S c ∈ Ideal.span (Set.range α)), ∀ s : S, ∃ F : MvPowerSeries (Fin n) K, ∀ k : ℕ, s - MvPolynomial.aeval α (MvPowerSeries.trunc' K (Finsupp.equivFunOnFinite.symm (fun _ : Fin n => k)) F) ∈ Ideal.span (Set.range α) ^ k := by
    intro S _ _ n α hres
    classical
    have star := hstar S n α
    set J := Ideal.span (Set.range α) with hJ
    have hbox : ∀ (k : ℕ) (e : Fin n →₀ ℕ), Finsupp.degree e < k →
        e ≤ Finsupp.equivFunOnFinite.symm (fun _ : Fin n => k) := by
      intro k e he i
      show e i ≤ k
