theorem wc_proet_henselian_pair_proper_res_bij {X Z₀ : Scheme.{u}} (i : Z₀ ⟶ X)
    (L : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology Z₀) AddCommGrpCat.{u+1})
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
    (adj : L ⊣ wcProEtPush i)
    (θ : ∀ V : X.ProEt, L.obj (wcFreeSheaf X V) ≅ wcFreeSheaf Z₀ ((wcProEtPullback i).obj V))
    (U : X.ProEt) (A : Type u) [CommRing A] (I : Ideal A) [HenselianRing A I]
    (π : U.left ⟶ Spec (.of A)) [IsProper π]
    (c : Limits.pullback U.hom i ⟶ Spec (.of (A ⧸ I)))
    (hpb : IsPullback (Limits.pullback.fst U.hom i) c π
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))))
    (m : ℕ) (hm : 0 < m) (j : ℕ) :
    Function.Bijective (wcProEtRes i L adj θ (ZMod m) U j) :=
by
  classical
  have hm0 : m ≠ 0 := Nat.pos_iff_ne_zero.mp hm

  have hloc : ∀ {X₁ Y₁ : Scheme.{u}} (g : X₁ ⟶ Y₁),
      (∀ y : Y₁, ∃ U₁ : Y₁.Opens, y ∈ U₁ ∧ wcPBCV (g ∣_ U₁)) → wcPBCV g := by
    intro X₁ Y₁ g H A' _ _ _ a X' f' a' hsq m' hm' F hF htor' q'
    obtain ⟨U₁, hyU, hU⟩ := H (a (IsLocalRing.closedPoint A'))
    have htop : a ⁻¹ᵁ U₁ = ⊤ := (IsLocalRing.closedPoint_mem_iff (U := a ⁻¹ᵁ U₁)).mp hyU
    have hrange : Set.range a ⊆ Set.range U₁.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      have hz : z ∈ a ⁻¹ᵁ U₁ := by rw [htop]; trivial
      exact hz
    let b := IsOpenImmersion.lift U₁.ι a hrange
    have hb : b ≫ U₁.ι = a := IsOpenImmersion.lift_fac _ _ _
    have hsq2 : IsPullback (g ⁻¹ᵁ U₁).ι (g ∣_ U₁) g U₁.ι := (isPullback_morphismRestrict g U₁).flip
    let a'' : X' ⟶ (g ⁻¹ᵁ U₁ : Scheme.{u}) :=
      hsq2.lift a' (f' ≫ b) (by rw [Category.assoc, hb, hsq.w])
    have h1 : a'' ≫ (g ⁻¹ᵁ U₁).ι = a' := hsq2.lift_fst _ _ _
    have h2 : a'' ≫ (g ∣_ U₁) = f' ≫ b := hsq2.lift_snd _ _ _
    have hbig : IsPullback (a'' ≫ (g ⁻¹ᵁ U₁).ι) f' g (b ≫ U₁.ι) := by rw [h1, hb]; exact hsq
    have hpb' : IsPullback a'' f' (g ∣_ U₁) b := IsPullback.of_right hbig h2 hsq2
    exact hU A' b X' f' a'' hpb' m' hm' F hF htor' q'
  have hall : ∀ {X₁ Y₁ : Scheme.{u}} (g : X₁ ⟶ Y₁), IsProper g → wcPBCV g :=
    wc_proper_devissage (fun g => wcPBCV g) wc_pbc_finite wc_pbc_P1 wc_pbc_comp wc_pbc_cancel
      hloc
  have hπP : wcPBCV π := hall π inferInstance

  haveI hqci : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  have hZIc : IsClosed (Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))) :=
    (Scheme.Hom.isClosedEmbedding (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))).isClosed_range

  have hvanY : ∀ F : Sheaf (Scheme.smallEtaleTopology U.left) AddCommGrpCat.{u+1},
