theorem wc_pfam_mc_param_morse_local : ∀ (K O : Type u) [Field K] [CommRing O] [IsLocalRing O] [IsNoetherianRing O] [Algebra K O] (n r : ℕ), ringKrullDim O = ((n + r : ℕ) : WithBot ℕ∞) → ∀ (e : O →+* K), e.comp (algebraMap K O) = RingHom.id K → ∀ (t : Fin n → O) (ζ : Fin r → O) (b : Module.Basis (Fin n ⊕ Fin r) O Ω[O⁄K]), IsLocalRing.maximalIdeal O = Ideal.span (Set.range t ∪ Set.range ζ) → (∀ i, b (Sum.inl i) = KaehlerDifferential.D K O (t i)) → (∀ k, b (Sum.inr k) = KaehlerDifferential.D K O (ζ k)) → ∀ (G : O) (a : Matrix (Fin n) (Fin n) K) (H : Matrix (Fin n) (Fin n) O) (w : Fin r → O), (a + a.transpose).det ≠ 0 → (∀ p q, H p q ∈ IsLocalRing.maximalIdeal O) → G = ∑ p, ∑ q, (algebraMap K O (a p q) + H p q) * t p * t q + ∑ k, ζ k * w k → (∀ 𝔓 : Ideal O, 𝔓.IsPrime → (∀ i, (b.coord (Sum.inl i)).compDer (KaehlerDifferential.D K O) G ∈ 𝔓) → G ∈ 𝔓) → ∃ (c : Matrix (Fin n) (Fin n) K) (B : Matrix (Fin n) (Fin n) O), (c + c.transpose).det ≠ 0 ∧ (∀ p q, B p q ∈ IsLocalRing.maximalIdeal O) ∧ IsLocalRing.maximalIdeal O = Ideal.span (Set.range (fun i => (b.coord (Sum.inl i)).compDer (KaehlerDifferential.D K O) G) ∪ Set.range ζ) ∧ G = ∑ p, ∑ q, (algebraMap K O (c p q) + B p q) * (b.coord (Sum.inl p)).compDer (KaehlerDifferential.D K O) G * (b.coord (Sum.inl q)).compDer (KaehlerDifferential.D K O) G :=
by
  have s1 : ∀ (K O : Type u) [Field K] [CommRing O] [IsLocalRing O] [Algebra K O] (n r : ℕ) (e : O →+* K), e.comp (algebraMap K O) = RingHom.id K → RingHom.ker e = IsLocalRing.maximalIdeal O → ∀ (t : Fin n → O) (ζ : Fin r → O) (δ : Fin n → Derivation K O O), (∀ i q, δ i (t q) = if i = q then 1 else 0) → (∀ i k, δ i (ζ k) = 0) → (∀ q, t q ∈ IsLocalRing.maximalIdeal O) → (∀ k, ζ k ∈ IsLocalRing.maximalIdeal O) → ∀ (G : O) (a : Matrix (Fin n) (Fin n) K) (H : Matrix (Fin n) (Fin n) O) (w : Fin r → O), (∀ p q, H p q ∈ IsLocalRing.maximalIdeal O) → G = ∑ p, ∑ q, (algebraMap K O (a p q) + H p q) * t p * t q + ∑ k, ζ k * w k → (∀ i, δ i G - ∑ q, algebraMap K O ((a + a.transpose) i q) * t q ∈ IsLocalRing.maximalIdeal O ^ 2 ⊔ Ideal.span (Set.range ζ)) ∧ (∀ i, e (δ i G) = 0) ∧ (∀ i j, e (δ j (δ i G)) = (a + a.transpose) i j) := by
    intro K O _ _ _ _ n r e he hker t ζ δ hδt hδζ htm hζm G a H w hH hG
    classical
    have heι : ∀ k, e (algebraMap K O k) = k := fun k => by simpa using RingHom.congr_fun he k
    have hem : ∀ x, x ∈ IsLocalRing.maximalIdeal O → e x = 0 := fun x hx => by
      rw [← hker] at hx; exact RingHom.mem_ker.mp hx
    have hHe : ∀ p q, e (H p q) = 0 := fun p q => hem _ (hH p q)
    have hte : ∀ q, e (t q) = 0 := fun q => hem _ (htm q)
    have hζe : ∀ k, e (ζ k) = 0 := fun k => hem _ (hζm k)
    have hm2 : ∀ x y z, x ∈ IsLocalRing.maximalIdeal O → y ∈ IsLocalRing.maximalIdeal O →
        x * y * z ∈ IsLocalRing.maximalIdeal O ^ 2 := fun x y z hx hy =>
      Ideal.mul_mem_right z _ (by rw [pow_two]; exact Ideal.mul_mem_mul hx hy)
    obtain ⟨R, hR⟩ : ∃ R : Fin n → O, R = fun i => ∑ p, ∑ q, (H p q * t p * δ i (t q) +
        t q * H p q * δ i (t p) + t q * t p * δ i (H p q)) + ∑ k, ζ k * δ i (w k) := ⟨_, rfl⟩
    have hδG : ∀ i, δ i G = (∑ q, algebraMap K O (a i q) * t q + ∑ p, algebraMap K O (a p i) * t p)
        + R i := by
      intro i
      have e1 : ∀ p q, δ i ((algebraMap K O (a p q) + H p q) * t p * t q) =
          algebraMap K O (a p q) * (δ i (t p) * t q) + algebraMap K O (a p q) * (t p * δ i (t q)) +
          (H p q * t p * δ i (t q) + t q * H p q * δ i (t p) + t q * t p * δ i (H p q)) := by
        intro p q
        simp only [Derivation.leibniz, smul_eq_mul, Derivation.map_algebraMap, map_add]
        ring
      have e2 : ∀ k, δ i (ζ k * w k) = ζ k * δ i (w k) := by
        intro k; rw [Derivation.leibniz, hδζ, smul_eq_mul, smul_zero, add_zero]
      have c1 : ∑ p, ∑ q, algebraMap K O (a p q) * (δ i (t p) * t q) =
          ∑ q, algebraMap K O (a i q) * t q := by
        rw [Finset.sum_eq_single i]
        · simp [hδt]
        · intro p _ hp; simp [hδt, Ne.symm hp]
        · simp
      have c2 : ∑ p, ∑ q, algebraMap K O (a p q) * (t p * δ i (t q)) =
          ∑ p, algebraMap K O (a p i) * t p := by
        refine Finset.sum_congr rfl (fun p _ => ?_)
        rw [Finset.sum_eq_single i]
        · simp [hδt]
        · intro q _ hq; simp [hδt, Ne.symm hq]
        · simp
      rw [hG, hR]
      simp only [map_add, map_sum, e1, e2, Finset.sum_add_distrib]
      rw [c1, c2]
      ring
    have hRmem : ∀ i, R i ∈ IsLocalRing.maximalIdeal O ^ 2 ⊔ Ideal.span (Set.range ζ) := by
      intro i; rw [hR]; dsimp only
      refine Submodule.add_mem _ (Submodule.mem_sup_left ?_) (Submodule.mem_sup_right ?_)
      · refine Submodule.sum_mem _ (fun p _ => Submodule.sum_mem _ (fun q _ => ?_))
        exact add_mem (add_mem (hm2 _ _ _ (hH p q) (htm p)) (hm2 _ _ _ (htm q) (hH p q)))
          (hm2 _ _ _ (htm q) (htm p))
      · exact Submodule.sum_mem _
          (fun k _ => Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_range_self k)))
    have hMsum : ∀ i, ∑ q, algebraMap K O ((a + a.transpose) i q) * t q =
        ∑ q, algebraMap K O (a i q) * t q + ∑ p, algebraMap K O (a p i) * t p := by
      intro i
      simp only [Matrix.add_apply, Matrix.transpose_apply, map_add, add_mul, Finset.sum_add_distrib]
    have hsupm : IsLocalRing.maximalIdeal O ^ 2 ⊔ Ideal.span (Set.range ζ) ≤
        IsLocalRing.maximalIdeal O := by
      refine sup_le (Ideal.pow_le_self two_ne_zero) ?_
      rw [Ideal.span_le]; rintro _ ⟨k, rfl⟩; exact hζm k
    have hA : ∀ i j, δ j (∑ q, algebraMap K O (a i q) * t q + ∑ p, algebraMap K O (a p i) * t p) =
        algebraMap K O (a i j) + algebraMap K O (a j i) := by
      intro i j; simp [Derivation.leibniz, hδt]
    refine ⟨?_, ?_, ?_⟩
    · intro i
      rw [hδG i, hMsum i, add_sub_cancel_left]
      exact hRmem i
    · intro i
      apply hem
      rw [hδG i]
      refine add_mem (add_mem ?_ ?_) (hsupm (hRmem i))
      · exact Submodule.sum_mem _ (fun q _ => Ideal.mul_mem_left _ _ (htm q))
      · exact Submodule.sum_mem _ (fun q _ => Ideal.mul_mem_left _ _ (htm q))
    · intro i j
      rw [hδG i, map_add, map_add, hA i j, hR]
      simp only [map_add, map_sum, Derivation.leibniz, smul_eq_mul, map_mul, hHe, hte, hζe, hδζ,
        zero_mul, mul_zero, add_zero, Finset.sum_const_zero, heι, Matrix.add_apply,
        Matrix.transpose_apply]
  have s2 : ∀ (K O : Type u) [Field K] [CommRing O] [IsLocalRing O] [Algebra K O] (n r : ℕ) (t σ : Fin n → O) (ζ : Fin r → O) (M : Matrix (Fin n) (Fin n) K), M.det ≠ 0 → IsLocalRing.maximalIdeal O = Ideal.span (Set.range t ∪ Set.range ζ) → (∀ i, σ i ∈ IsLocalRing.maximalIdeal O) → (∀ i, σ i - ∑ q, algebraMap K O (M i q) * t q ∈ IsLocalRing.maximalIdeal O ^ 2 ⊔ Ideal.span (Set.range ζ)) → IsLocalRing.maximalIdeal O = Ideal.span (Set.range σ ∪ Set.range ζ) := by
    intro K O _ _ _ _ n r t σ ζ M hM hgen hσ hL
    classical
    have hζm : ∀ k, ζ k ∈ IsLocalRing.maximalIdeal O := fun k => by
      rw [hgen]; exact Ideal.subset_span (Set.mem_union_right _ (Set.mem_range_self k))
    have hNm : Ideal.span (Set.range σ ∪ Set.range ζ) ≤ IsLocalRing.maximalIdeal O := by
      rw [Ideal.span_le]
      rintro y (⟨i, rfl⟩ | ⟨k, rfl⟩)
      · exact hσ i
      · exact hζm k
