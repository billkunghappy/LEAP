            ((α.hom.hom.app (op (Over.mk (𝟙 V)))).hom s) := by
    intro C D _ _ _ _ J K _ bc _ _ L adj V F F' α
    classical
    have injOfIso : ∀ {A₁ A₂ : AddCommGrpCat.{u+1}} (f : A₁ ⟶ A₂) [IsIso f],
        Function.Injective f.hom := by
      intro A₁ A₂ f _ a b hab
      have k : ∀ x, (inv f).hom (f.hom x) = x := fun x => by
        have := congrArg (fun g => g.hom x) (IsIso.hom_inv_id f)
        exact this
      rw [← k a, ← k b, hab]
    have tSiso : ∀ E : Sheaf K AddCommGrpCat.{u+1}, IsIso (toSheafify J (bc.op ⋙ E.obj)) :=
      fun E => isIso_toSheafify _ (Functor.op_comp_isSheaf _ _ _ E)
    haveI hstarc : (Over.star (bc.obj V)).IsContinuous K (K.over (bc.obj V)) :=
      Adjunction.isContinuous_of_isCocontinuous (K.over (bc.obj V)) K
        (Over.forgetAdjStar (bc.obj V))

    let χ : Over.star V ⋙ Over.post bc ≅ bc ⋙ Over.star (bc.obj V) :=
      NatIso.ofComponents (fun W => Over.isoMk (PreservesLimitPair.iso bc V W) (by
          have h1 : ((Over.star (bc.obj V)).obj (bc.obj W)).hom =
              (prod.fst : bc.obj V ⨯ bc.obj W ⟶ bc.obj V) := prod.lift_fst _ _
          have h2 : ((Over.post bc).obj ((Over.star V).obj W)).hom =
              bc.map (prod.fst : V ⨯ W ⟶ V) := congrArg bc.map (prod.lift_fst _ _)
          rw [PreservesLimitPair.iso_hom]
