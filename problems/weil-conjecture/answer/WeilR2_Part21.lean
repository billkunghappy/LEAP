      push_neg at ha hb
      have exa : ∃ p, GradedRing.proj 𝒜 p a ≠ 0 := let ⟨p, _, hp⟩ := ha; ⟨p, hp⟩
      have exb : ∃ q, GradedRing.proj 𝒜 q b ≠ 0 := let ⟨q, _, hq⟩ := hb; ⟨q, hq⟩
      set p := Nat.find exa with hpdef
      set q := Nat.find exb with hqdef
      have hpa : GradedRing.proj 𝒜 p a ≠ 0 := Nat.find_spec exa
      have hqb : GradedRing.proj 𝒜 q b ≠ 0 := Nat.find_spec exb
      have hpmin : ∀ p' < p, GradedRing.proj 𝒜 p' a = 0 := fun p' hp' => by
        have := Nat.find_min exa hp'
        push_neg at this
