  have hfx : D.f (D.xs j (IsLocalRing.closedPoint F'')) = D.S j (IsLocalRing.closedPoint F'') := by
    show (D.xs j ≫ D.f) _ = _
    rw [D.hxs j]
  have hkerW : RingHom.ker (lam.stalkMap (D.S j (IsLocalRing.closedPoint F''))).hom =
