      (θb : H.over Wb ≅ (wcContSheaf S (Fin rb → ℚ_[ℓ])).over Wb)
      (aa : T ⟶ Wa) (ab : T ⟶ Wb),
      ∃ A : (Fin ra → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin rb → ℚ_[ℓ]),
        ∀ (y : H.obj.obj (Opposite.op T)) (t : T.left),
          (show C(↥T.left, Fin rb → ℚ_[ℓ]) from
            ((θb.hom.hom.app (Opposite.op (Over.mk ab))).hom y).down) t =
          A ((show C(↥T.left, Fin ra → ℚ_[ℓ]) from
            ((θa.hom.hom.app (Opposite.op (Over.mk aa))).hom y).down) t) := by
    intro Wa Wb ra rb θa θb aa ab
    let ρa : (wcContSheaf S (Fin ra → ℚ_[ℓ])).over T ⟶ H.over T :=
      ⟨{ app := fun X => θa.inv.hom.app (Opposite.op (Over.mk (X.unop.hom ≫ aa)))
         naturality := fun X Y f => θa.inv.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ aa = Y.unop.hom ≫ aa
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ aa) ⟶ Over.mk (X.unop.hom ≫ aa)).op }⟩
    let ρb : H.over T ⟶ (wcContSheaf S (Fin rb → ℚ_[ℓ])).over T :=
      ⟨{ app := fun X => θb.hom.hom.app (Opposite.op (Over.mk (X.unop.hom ≫ ab)))
         naturality := fun X Y f => θb.hom.hom.naturality
            (Over.homMk f.unop.left (by
              show f.unop.left ≫ X.unop.hom ≫ ab = Y.unop.hom ≫ ab
              rw [← Category.assoc, Over.w f.unop]) :
              Over.mk (Y.unop.hom ≫ ab) ⟶ Over.mk (X.unop.hom ≫ ab)).op }⟩
    obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear S ℓ T hT ra rb (ρa ≫ ρb)
    have hPt : ∀ (U : Over T)
        (c : (wcContSheaf S (Fin ra → ℚ_[ℓ])).obj.obj (Opposite.op U.left))
        (t : U.left.left),
        (show C(↥U.left.left, Fin rb → ℚ_[ℓ]) from
          (((ρa ≫ ρb).hom.app (Opposite.op U)).hom c).down) t =
          A ((show C(↥U.left.left, Fin ra → ℚ_[ℓ]) from c.down) t) := by
      intro U c t
      rw [hA]
      rfl
    have hE : ∀ (ua : T ⟶ Wa) (ub : T ⟶ Wb), 𝟙 T ≫ aa = ua → 𝟙 T ≫ ab = ub →
        ∀ x : (wcContSheaf S (Fin ra → ℚ_[ℓ])).obj.obj (Opposite.op T),
        ((ρa ≫ ρb).hom.app (Opposite.op (Over.mk (𝟙 T)))).hom x =
          (θb.hom.hom.app (Opposite.op (Over.mk ub))).hom
            ((θa.inv.hom.app (Opposite.op (Over.mk ua))).hom x) := by
      rintro ua ub rfl rfl x
      rfl
    refine ⟨A, fun y t => ?_⟩
    have hc : (θa.inv.hom.app (Opposite.op (Over.mk aa))).hom
        ((θa.hom.hom.app (Opposite.op (Over.mk aa))).hom y) = y :=
      congrArg (fun m => (m.hom.app (Opposite.op (Over.mk aa))).hom y) θa.hom_inv_id
    have E := hE aa ab (Category.id_comp aa) (Category.id_comp ab)
      ((θa.hom.hom.app (Opposite.op (Over.mk aa))).hom y)
    rw [hc] at E
    have h1 := hPt (Over.mk (𝟙 T)) ((θa.hom.hom.app (Opposite.op (Over.mk aa))).hom y) t
    have h4 := congrArg (fun z : ULift.{u+1} C(↥T.left, Fin rb → ℚ_[ℓ]) => z.down t) E
    exact h4.symm.trans h1
  obtain ⟨A, hA⟩ := key W₁ W₂ r₁ r₂ θ₁ θ₂ a₁ a₂
  obtain ⟨B, hB⟩ := key W₂ W₁ r₂ r₁ θ₂ θ₁ a₂ a₁
  obtain ⟨t₀⟩ : Nonempty T.left := @ConnectedSpace.toNonempty _ _ hT
  have hconst : ∀ (W : S.ProEt) (r : ℕ)
      (θ : H.over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W) (a : T ⟶ W)
      (v : Fin r → ℚ_[ℓ]), ∃ y : H.obj.obj (Opposite.op T),
        (show C(↥T.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom y).down) t₀ = v := by
    intro W r θ a v
    let c : (wcContSheaf S (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op T) :=
      (show (wcContSheaf S (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op T) from
        ULift.up (ContinuousMap.const ↥T.left v))
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk a))).hom c, ?_⟩
    have hs := congrArg (fun m => (m.hom.app (Opposite.op (Over.mk a))).hom c) θ.inv_hom_id
    exact congrArg (fun y : ULift.{u+1} C(↥T.left, Fin r → ℚ_[ℓ]) => y.down t₀) hs
  have hBA : ∀ v, B (A v) = v := by
    intro v
    obtain ⟨y, hy⟩ := hconst W₁ r₁ θ₁ a₁ v
    exact (hy.symm.trans ((hB y t₀).trans (congrArg B ((hA y t₀).trans (congrArg A hy))))).symm
  have hAB : ∀ w, A (B w) = w := by
    intro w
    obtain ⟨y, hy⟩ := hconst W₂ r₂ θ₂ a₂ w
    exact (hy.symm.trans ((hA y t₀).trans (congrArg A ((hB y t₀).trans (congrArg B hy))))).symm
  exact ⟨LinearEquiv.ofLinear A B (LinearMap.ext fun w => hAB w) (LinearMap.ext fun v => hBA v),
    fun y t => hA y t⟩

theorem wc_pfam_line_bc (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (π : wcPencilPL D ℓ hP)
    (hgal : ∀ (V : (wcP1Over F'').left.ProEt) (a b : V ⟶ π.W),
      ConnectedSpace V.left → a ≫ π.w = b ≫ π.w →
      ∃ σ : π.W ⟶ π.W, σ ≫ π.w = π.w ∧ b = a ≫ σ)
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (Ω : wcPfamCover M' h Δ ℓ (n - 1) hPP) :
    ∃ (β : wcPfamLineBeta D ℓ h lam) (T₀ : (wcP1Over F'').left.ProEt) (a₀ : T₀ ⟶ π.W)
      (b₀ : T₀.left ⟶ Ω.W'.left) (hb₀ : b₀ ≫ Ω.W'.hom = T₀.hom ≫ lam)
      (M₀ : (Fin π.r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin Ω.r' → ℚ_[ℓ])),
      wcPfamLineBC π Ω lam β ∧ wcPfamLineCmp π Ω lam β T₀ a₀ b₀ hb₀ M₀ :=
by
  classical
  obtain ⟨L, adj, hL, θL, hθL⟩ := wc_proet_push_left_adjoint_free_nat lam
  haveI := hL
  obtain ⟨φ, hφ⟩ := wc_pfam_Rq_line_pbc_iso F' F'' Y n D ℓ hℓ M' Xu h Δ lam p hH (n - 1)
  let β : wcPfamLineBeta D ℓ h lam := fun V T b hb =>
    ((φ.app (Opposite.op V)) ≫
      (wcRq D.f ℓ (n - 1)).obj.map (wcPfamLineIota lam V T b hb).op).hom
  have hβ : ∀ (V : (wcProjK F'' M').ProEt) (T : (wcP1Over F'').left.ProEt)
      (b : T.left ⟶ V.left) (hb : b ≫ V.hom = T.hom ≫ lam)
      (s : (wcRq h ℓ (n - 1)).obj.obj (Opposite.op V)),
      β V T b hb s = ((wcRq D.f ℓ (n - 1)).obj.map (wcPfamLineIota lam V T b hb).op).hom
        ((φ.app (Opposite.op V)).hom s) := fun _ _ _ _ _ => rfl
  have hBC : wcPfamLineBC π Ω lam β := by
    unfold wcPfamLineBC
    refine ⟨?_, ?_, ?_⟩
    ·
      intro V T T' f b hb hb' s
      have key : f ≫ wcPfamLineIota lam V T b hb = wcPfamLineIota lam V T' (f.left ≫ b) hb' := by
        apply MorphismProperty.Over.Hom.ext
        refine Limits.pullback.hom_ext (f := V.hom) (g := lam) ?_ ?_
        · show (f.left ≫ Limits.pullback.lift b T.hom hb) ≫ Limits.pullback.fst V.hom lam =
            Limits.pullback.lift (f.left ≫ b) T'.hom hb' ≫ Limits.pullback.fst V.hom lam
          rw [Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst]
        · show (f.left ≫ Limits.pullback.lift b T.hom hb) ≫ Limits.pullback.snd V.hom lam =
            Limits.pullback.lift (f.left ≫ b) T'.hom hb' ≫ Limits.pullback.snd V.hom lam
          rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
          exact MorphismProperty.Over.w f
      rw [hβ, hβ, ← key, op_comp, Functor.map_comp, AddCommGrpCat.hom_comp,
        AddMonoidHom.comp_apply]
    ·
      intro V V' g T b hb hb' s
      have hfst : ((wcProEtBaseChange lam).map g).left ≫ Limits.pullback.fst V.hom lam =
          Limits.pullback.fst V'.hom lam ≫ g.left :=
        Limits.pullback.lift_fst _ _ _
      have hsnd : ((wcProEtBaseChange lam).map g).left ≫ Limits.pullback.snd V.hom lam =
          Limits.pullback.snd V'.hom lam :=
        Limits.pullback.lift_snd _ _ _
      have key : wcPfamLineIota lam V' T b hb ≫ (wcProEtBaseChange lam).map g =
          wcPfamLineIota lam V T (b ≫ g.left) hb' := by
        apply MorphismProperty.Over.Hom.ext
        refine Limits.pullback.hom_ext (f := V.hom) (g := lam) ?_ ?_
        · show (Limits.pullback.lift b T.hom hb ≫ ((wcProEtBaseChange lam).map g).left) ≫
              Limits.pullback.fst V.hom lam =
            Limits.pullback.lift (b ≫ g.left) T.hom hb' ≫ Limits.pullback.fst V.hom lam
          exact (Category.assoc _ _ _).trans
            ((congrArg (fun k => Limits.pullback.lift b T.hom hb ≫ k) hfst).trans
              ((Category.assoc _ _ _).symm.trans
                ((congrArg (fun k => k ≫ g.left) (Limits.pullback.lift_fst b T.hom hb)).trans
                  (Limits.pullback.lift_fst (b ≫ g.left) T.hom hb').symm)))
        · show (Limits.pullback.lift b T.hom hb ≫ ((wcProEtBaseChange lam).map g).left) ≫
              Limits.pullback.snd V.hom lam =
            Limits.pullback.lift (b ≫ g.left) T.hom hb' ≫ Limits.pullback.snd V.hom lam
          exact (Category.assoc _ _ _).trans
            ((congrArg (fun k => Limits.pullback.lift b T.hom hb ≫ k) hsnd).trans
              ((Limits.pullback.lift_snd b T.hom hb).trans
                (Limits.pullback.lift_snd (b ≫ g.left) T.hom hb').symm))
      have hnat : (φ.app (Opposite.op V')).hom (((wcRq h ℓ (n - 1)).obj.map g.op).hom s) =
          ((wcRq D.f ℓ (n - 1)).obj.map ((wcProEtBaseChange lam).map g).op).hom
            ((φ.app (Opposite.op V)).hom s) := by
        have := congrArg (fun m => m.hom s) (φ.naturality g.op)
        exact this
      rw [hβ, hβ, hnat, ← key, op_comp, Functor.map_comp, AddCommGrpCat.hom_comp,
        AddMonoidHom.comp_apply]
    ·
      intro T a b hb hT hc
      obtain ⟨θ'', hθ''⟩ := wc_proet_bc_transport_triv lam ℓ (wcRq h ℓ (n - 1))
        (wcRq D.f ℓ (n - 1)) φ L adj θL hθL (hφ L adj) Ω.W' Ω.r' Ω.θ'
      obtain ⟨M, hM⟩ := wc_proet_two_triv_compare (wcP1Over F'').left ℓ (wcRq D.f ℓ (n - 1))
        π.W ((wcProEtBaseChange lam).obj Ω.W') T π.r Ω.r' π.θ θ'' a
        (wcPfamLineIota lam Ω.W' T b hb) hT
      refine ⟨M, ?_⟩
      unfold wcPfamLineCmp
      refine ⟨hT, hc, fun s t => ?_⟩
      refine Eq.trans ?_ (hM (β Ω.W' T b hb s) t)
      have e1 : Limits.pullback.fst Ω.W'.hom lam ((wcPfamLineIota lam Ω.W' T b hb).left t) =
          b t := by
        have := congrArg (fun f : T.left ⟶ Ω.W'.left => f t)
          (Limits.pullback.lift_fst b T.hom hb)
        exact this
      rw [← e1]
      refine (hθ'' s _).symm.trans ?_
      have hn := θ''.hom.hom.naturality
        (Over.homMk (wcPfamLineIota lam Ω.W' T b hb) (Category.comp_id _) :
          Over.mk (wcPfamLineIota lam Ω.W' T b hb) ⟶
            Over.mk (𝟙 ((wcProEtBaseChange lam).obj Ω.W'))).op
      have hn2 := congrArg (fun m => (show C(↥T.left, Fin Ω.r' → ℚ_[ℓ]) from
        (m.hom ((φ.app (Opposite.op Ω.W')).hom s)).down) t) hn
      exact hn2.symm
  obtain ⟨T₀, a₀, b₀, hb₀, hT₀, hc₀⟩ :=
    wc_pfam_line_base_point F' F'' Y n D ℓ hP π M' Xu h Δ lam p hH hPP Ω
  obtain ⟨M₀, hM₀⟩ := hBC.2.2 T₀ a₀ b₀ hb₀ hT₀ hc₀
  exact ⟨β, T₀, a₀, b₀, hb₀, M₀, hBC, hM₀⟩

theorem wc_pfam_lms_sep_field_point (F'' : Type u) [Field F'']
    (T₀ : (wcP1Over F'').left.ProEt) (hT₀ : ConnectedSpace T₀.left) :
    ∃ (T : (wcP1Over F'').left.ProEt) (f : T ⟶ T₀) (L : Type u) (_ : Field L)
      (_ : IsSepClosed L), Nonempty (T.left ≅ Spec (.of L)) :=
by
  classical



  have s4 : ∀ (K : Type u) [Field K],
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K)))) := by
    intro K _
    have hsep : ∀ s : SeparableClosure K, ∃ c : TensorProduct K (SeparableClosure K) (SeparableClosure K),
        Algebra.TensorProduct.lmul' K c = 1 ∧
          c * (TensorProduct.tmul K (1 : SeparableClosure K) s - TensorProduct.tmul K s 1) = 0 := by
      intro s
      haveI : Algebra.IsSeparable K (SeparableClosure K) := inferInstance
      haveI : FiniteDimensional K (IntermediateField.adjoin K {s}) :=
        IntermediateField.adjoin.finiteDimensional (Algebra.IsSeparable.isIntegral K s)
      haveI : Algebra.IsSeparable K (IntermediateField.adjoin K {s}) :=
        Algebra.isSeparable_tower_bot_of_isSeparable K _ (SeparableClosure K)
      haveI : Algebra.FormallyUnramified K (IntermediateField.adjoin K {s}) :=
        Algebra.FormallyUnramified.of_isSeparable K _
      haveI : Algebra.FiniteType K (IntermediateField.adjoin K {s}) := Module.Finite.finiteType _
      haveI : Algebra.EssFiniteType K (IntermediateField.adjoin K {s}) :=
        Algebra.EssFiniteType.of_finiteType K _
      obtain ⟨t, ht1, ht2⟩ :=
        (Algebra.FormallyUnramified.iff_exists_tensorProduct (R := K)
          (S := IntermediateField.adjoin K {s})).mp inferInstance
      let φ := Algebra.TensorProduct.map (IntermediateField.adjoin K {s}).val
        (IntermediateField.adjoin K {s}).val
      have hμ : ∀ x : TensorProduct K (IntermediateField.adjoin K {s}) (IntermediateField.adjoin K {s}),
          Algebra.TensorProduct.lmul' K (φ x) =
            (IntermediateField.adjoin K {s}).val (Algebra.TensorProduct.lmul' K x) := by
        intro x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul a b => simp [φ]
        | add a b ha hb => simp only [map_add, ha, hb]
      let g : IntermediateField.adjoin K {s} := ⟨s, IntermediateField.mem_adjoin_simple_self K s⟩
      refine ⟨φ t, ?_, ?_⟩
      · rw [hμ, ht2, map_one]
      · have hg : φ (TensorProduct.tmul K 1 g - TensorProduct.tmul K g 1) =
            TensorProduct.tmul K (1 : SeparableClosure K) s - TensorProduct.tmul K s 1 := by
          simp [φ, g]
        rw [← hg, ← map_mul, mul_comm, ht1 g, map_zero]
    have hflatμ : RingHom.Flat
        (Algebra.TensorProduct.lmul' K :
          TensorProduct K (SeparableClosure K) (SeparableClosure K) →ₐ[K] SeparableClosure K).toRingHom := by
      let μ := (Algebra.TensorProduct.lmul' K :
          TensorProduct K (SeparableClosure K) (SeparableClosure K) →ₐ[K] SeparableClosure K)
      letI : Algebra (TensorProduct K (SeparableClosure K) (SeparableClosure K)) (SeparableClosure K) :=
        μ.toRingHom.toAlgebra
      let M : Submonoid (TensorProduct K (SeparableClosure K) (SeparableClosure K)) :=
        Submonoid.comap μ.toRingHom (IsUnit.submonoid (SeparableClosure K))
      have hM : ∀ y, y ∈ M ↔ IsUnit (μ y) := fun y => by
        rw [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]; rfl
      haveI : IsLocalization (R := TensorProduct K (SeparableClosure K) (SeparableClosure K))
          M (SeparableClosure K) := by
        refine ⟨?_, ?_, ?_⟩
        · intro y
          exact (hM y.1).mp y.2
        · intro z
          refine ⟨⟨TensorProduct.tmul K z 1, 1⟩, ?_⟩
          show z * μ 1 = μ (TensorProduct.tmul K z 1)
          rw [map_one, Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
        · intro x y hxy
          change μ x = μ y at hxy
          have hker : x - y ∈ Ideal.span (Set.range fun s : SeparableClosure K =>
              TensorProduct.tmul K (1 : SeparableClosure K) s - TensorProduct.tmul K s 1) := by
            rw [KaehlerDifferential.span_range_eq_ideal, KaehlerDifferential.ideal, RingHom.mem_ker,
              map_sub]
            exact sub_eq_zero.mpr hxy
          have key : ∀ a ∈ Ideal.span (Set.range fun s : SeparableClosure K =>
              TensorProduct.tmul K (1 : SeparableClosure K) s - TensorProduct.tmul K s 1),
              ∃ c ∈ M, c * a = 0 := by
            intro a ha
            induction ha using Submodule.span_induction with
            | mem a ha =>
              obtain ⟨s, rfl⟩ := ha
              obtain ⟨c, hc1, hc2⟩ := hsep s
              refine ⟨c, (hM c).mpr ?_, hc2⟩
              show IsUnit (Algebra.TensorProduct.lmul' K c)
              rw [hc1]; exact isUnit_one
            | zero => exact ⟨1, M.one_mem, mul_zero 1⟩
            | add a b _ _ ha hb =>
              obtain ⟨c1, h1, e1⟩ := ha
              obtain ⟨c2, h2, e2⟩ := hb
              exact ⟨c1 * c2, M.mul_mem h1 h2, by linear_combination c2 * e1 + c1 * e2⟩
            | smul r a _ ha =>
              obtain ⟨c, h, e⟩ := ha
              refine ⟨c, h, ?_⟩
              rw [smul_eq_mul]; linear_combination r * e
          obtain ⟨c, hc, e⟩ := key _ hker
          exact ⟨⟨c, hc⟩, by rw [mul_sub] at e; exact sub_eq_zero.mp e⟩
      exact IsLocalization.flat (R := TensorProduct K (SeparableClosure K) (SeparableClosure K))
        (SeparableClosure K) M
    have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K)))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      exact RingHom.flat_algebraMap_iff.mpr inferInstance
    have hd : Flat (Limits.pullback.diagonal
        (Spec.map (CommRingCat.ofHom (algebraMap K (SeparableClosure K))))) := by
      rw [diagonal_SpecMap]
      haveI : Flat (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' K :
          TensorProduct K (SeparableClosure K) (SeparableClosure K) →ₐ[K]
            SeparableClosure K).toRingHom)) :=
        HasRingHomProperty.Spec_iff.mpr hflatμ
      infer_instance
    exact ⟨hf, hd⟩



  have sring : ∀ (R S : Type u) [CommRing R] [CommRing S] (ψ : R →+* S),
      WeaklyEtale (Spec.map (CommRingCat.ofHom ψ)) → @Algebra.WeaklyEtale R S _ _ ψ.toAlgebra := by
    intro R S _ _ ψ hW
    letI : Algebra R S := ψ.toAlgebra
    have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := hW
    have hf : Module.Flat R S := RingHom.flat_algebraMap_iff.mp
      ((HasRingHomProperty.Spec_iff (P := @Flat)).mp hW'.flat)
    have h2 := hW'.flat_diagonal
    rw [diagonal_SpecMap] at h2
    have h3 : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' (S := S) R).toRingHom)) := by
      have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (S := S) R).toRingHom) ≫
            (pullbackSpecIso R S S).inv) ≫ (pullbackSpecIso R S S).hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      exact MorphismProperty.comp_mem @Flat _ _ h2 inferInstance
    exact Algebra.WeaklyEtale.mk (flat := hf) ((HasRingHomProperty.Spec_iff (P := @Flat)).mp h3)



  have sfs : ∀ (X : Scheme.{u}) (x : X), WeaklyEtale (X.fromSpecStalk x) := by
    intro X x
    refine ⟨?_, inferInstance⟩
    obtain ⟨_, ⟨U, hU, rfl⟩, hx, -⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
    replace hU : IsAffineOpen U := hU
    rw [← hU.fromSpecStalk_eq_fromSpecStalk hx]
    show Flat (Spec.map (X.presheaf.germ U x hx) ≫ hU.fromSpec)
    have : Flat (Spec.map (X.presheaf.germ U x hx)) := by
