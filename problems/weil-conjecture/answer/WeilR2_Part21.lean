          e.hom.hom (((Limits.colimit.ι D j).app Y).hom y) = (Limits.colimit.ι F j).hom y := by
        intro j y
        have := congrArg (fun ψ => ModuleCat.Hom.hom ψ y)
          (Limits.colimitObjIsoColimitCompEvaluation_ι_app_hom D j Y)
        simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at this
        exact this
