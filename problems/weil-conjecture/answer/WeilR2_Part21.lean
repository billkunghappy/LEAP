    let g : ℕ → S → MvPolynomial (Fin n) K := fun k y =>
      if h : y ∈ J ^ k then Classical.choose (step k y h) else 0
    obtain ⟨Ps, hPs0, hPsS⟩ : ∃ Ps : ℕ → MvPolynomial (Fin n) K, Ps 0 = 0 ∧
        ∀ k, Ps (k + 1) = Ps k + g k (s - MvPolynomial.aeval α (Ps k)) :=
      ⟨fun k => Nat.rec 0 (fun k P => P + g k (s - MvPolynomial.aeval α P)) k, rfl, fun k => rfl⟩
