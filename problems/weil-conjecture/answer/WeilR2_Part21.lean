    rw [map_mul] at hsu
    have hu1 : IsUnit (algebraMap R (Localization.Away s) s₁) := isUnit_of_mul_isUnit_left hsu
    have hu2 : IsUnit (algebraMap R (Localization.Away s) s₂) := isUnit_of_mul_isUnit_right hsu
    have he₁ : ∀ x, IsLocalization.Away.lift (g := e) s (isUnit_iff_ne_zero.mpr hs)
        (algebraMap R (Localization.Away s) x) = e x := fun x =>
      RingHom.congr_fun (IsLocalization.Away.lift_comp (S := Localization.Away s) s
        (isUnit_iff_ne_zero.mpr hs)) x
    obtain ⟨σ₀, hσ₀⟩ : ∃ σ₀ : Fin n → Localization.Away s, ∀ p,
        σ₀ p = algebraMap R _ (a (Sum.inl p)) * ↑hu1.unit⁻¹ := ⟨fun p => _, fun p => rfl⟩
    obtain ⟨B₀, hB₀⟩ : ∃ B₀ : Matrix (Fin n) (Fin n) (Localization.Away s), ∀ p q,
        B₀ p q = algebraMap R _ (a (Sum.inr (p, q))) * ↑hu1.unit⁻¹ :=
      ⟨Matrix.of fun p q => _, fun p q => rfl⟩
    have hσA : ∀ p, algebraMap R (Localization.Away s) (a (Sum.inl p)) =
        algebraMap R (Localization.Away s) s₁ * σ₀ p := by
      intro p; rw [hσ₀, mul_left_comm, hu1.mul_val_inv, mul_one]
    have hBA : ∀ p q, algebraMap R (Localization.Away s) (a (Sum.inr (p, q))) =
        algebraMap R (Localization.Away s) s₁ * B₀ p q := by
      intro p q; rw [hB₀, mul_left_comm, hu1.mul_val_inv, mul_one]
    refine ⟨σ₀, B₀, ?_, ?_, ?_, ?_⟩
    · intro p; rw [hσ₀, map_mul, he₁, heσ, zero_mul]
    · intro p q; rw [hB₀, map_mul, he₁, heB, zero_mul]
    · intro x hx
      obtain ⟨⟨a0, y2⟩, hxy⟩ := IsLocalization.surj (Submonoid.powers s) x
      change x * algebraMap R (Localization.Away s) (y2 : R) = algebraMap R _ a0 at hxy
      obtain ⟨k, hk⟩ := y2.2
      have hey2 : e (y2 : R) ≠ 0 := by rw [← hk, map_pow]; exact pow_ne_zero _ hs
      have hea0 : e a0 = 0 := by
        have := congrArg (IsLocalization.Away.lift (g := e) s (isUnit_iff_ne_zero.mpr hs)) hxy
        rw [map_mul, he₁, he₁, hx, zero_mul] at this; exact this.symm
      have hLa : algebraMap R (Localization.AtPrime (RingHom.ker e)) a0 ∈ IsLocalRing.maximalIdeal (Localization.AtPrime (RingHom.ker e)) := (hmemiff a0).mpr hea0
      rw [hmax, Ideal.span_union, Submodule.mem_sup] at hLa
      obtain ⟨y1, hy1, y2', hy2', hsum⟩ := hLa
      obtain ⟨α, hα⟩ := Ideal.mem_span_range_iff_exists_fun.mp hy1
      obtain ⟨β, hβ⟩ := Ideal.mem_span_range_iff_exists_fun.mp hy2'
      obtain ⟨d, hintd⟩ := IsLocalization.exist_integer_multiples_of_finite
        (RingHom.ker e).primeCompl (Sum.elim α β)
      have hintd' : ∀ i, ∃ y : R, algebraMap R (Localization.AtPrime (RingHom.ker e)) y = algebraMap R (Localization.AtPrime (RingHom.ker e)) d * (Sum.elim α β) i := by
        intro i
        obtain ⟨y, hy⟩ := hintd i
        exact ⟨y, by rw [hy, Algebra.smul_def]⟩
      choose g hg using hintd'
      have hgl : ∀ p, algebraMap R (Localization.AtPrime (RingHom.ker e)) (g (Sum.inl p)) = algebraMap R (Localization.AtPrime (RingHom.ker e)) d * α p :=
        fun p => hg (Sum.inl p)
      have hgr : ∀ k, algebraMap R (Localization.AtPrime (RingHom.ker e)) (g (Sum.inr k)) = algebraMap R (Localization.AtPrime (RingHom.ker e)) d * β k :=
        fun k => hg (Sum.inr k)
      have hLeq : algebraMap R (Localization.AtPrime (RingHom.ker e)) ((d : R) * ((s₁ : R) * a0)) = algebraMap R (Localization.AtPrime (RingHom.ker e))
          (∑ p, g (Sum.inl p) * a (Sum.inl p) + (s₁ : R) * ∑ k, g (Sum.inr k) * ρ (z k)) := by
        rw [map_mul, map_mul, ← hsum, ← hα, ← hβ]
        simp only [map_add, map_sum, map_mul, hσa, hgl, hgr, mul_add, Finset.mul_sum]
        congr 1 <;> refine Finset.sum_congr rfl (fun _ _ => by ring)
      obtain ⟨m, hm⟩ := IsLocalization.exists_of_eq (M := (RingHom.ker e).primeCompl) hLeq
      refine ⟨algebraMap R _ ((m : R) * d * y2), ?_, ?_⟩
      · rw [he₁, map_mul, map_mul]; exact mul_ne_zero (mul_ne_zero (hMe m) (hMe d)) hey2
      · have hT : algebraMap R (Localization.Away s) ((m : R) * d * y2) * x =
            algebraMap R (Localization.Away s) m * (∑ p, algebraMap R _ (g (Sum.inl p)) * σ₀ p +
              ∑ k, algebraMap R _ (g (Sum.inr k)) * algebraMap R (Localization.Away s) (ρ (z k))) := by
          apply hu1.mul_left_cancel
          have h3 := congrArg (algebraMap R (Localization.Away s)) hm
          have hS1 : algebraMap R (Localization.Away s) (∑ p, g (Sum.inl p) * a (Sum.inl p)) =
              algebraMap R (Localization.Away s) s₁ * ∑ p, algebraMap R _ (g (Sum.inl p)) * σ₀ p := by
            rw [map_sum, Finset.mul_sum]
            refine Finset.sum_congr rfl (fun p _ => ?_)
            rw [map_mul, hσA]; ring
          have hS2 : algebraMap R (Localization.Away s) (∑ k, g (Sum.inr k) * ρ (z k)) =
              ∑ k, algebraMap R _ (g (Sum.inr k)) * algebraMap R (Localization.Away s) (ρ (z k)) := by
            simp only [map_sum, map_mul]
          simp only [map_mul, map_add] at h3
          rw [hS1, hS2] at h3
          simp only [map_mul]
          linear_combination h3 + (algebraMap R (Localization.Away s) s₁ *
            algebraMap R (Localization.Away s) m * algebraMap R (Localization.Away s) d) * hxy
        rw [hT]
        exact Ideal.mul_mem_left _ _ (Ideal.add_mem _
          (Ideal.sum_mem _ (fun p _ => Ideal.mul_mem_left _ _
            (Ideal.subset_span (Set.mem_union_left _ ⟨p, rfl⟩))))
          (Ideal.sum_mem _ (fun k _ => Ideal.mul_mem_left _ _
            (Ideal.subset_span (Set.mem_union_right _ ⟨k, rfl⟩)))))
    · apply (hu1.pow 3).mul_left_cancel
      have h3 := congrArg (algebraMap R (Localization.Away s)) hs₂
      rw [map_mul, map_mul (algebraMap R (Localization.Away s)) (s₂ : R)] at h3
      have h4 := hu2.mul_left_cancel h3
      rw [← map_pow, ← map_mul, h4]
      simp only [map_sum, map_mul, map_add, map_pow, hσA, hBA, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => by ring))

  obtain ⟨s, hs, σ₀, B₀, hvσ, hvB, hgen, hid⟩ := L1
  have he₁ := IsLocalization.Away.lift_comp (S := Localization.Away s) s
    (isUnit_iff_ne_zero.mpr hs)
  generalize IsLocalization.Away.lift (S := Localization.Away s) s (isUnit_iff_ne_zero.mpr hs) = e₁
    at hvσ hvB hgen he₁
  have hKR₁ : algebraMap K (Localization.Away s) =
      (algebraMap R (Localization.Away s)).comp (algebraMap K R) :=
    IsScalarTower.algebraMap_eq K R _
  have he₁K : e₁.comp (algebraMap K (Localization.Away s)) = RingHom.id K := by
    rw [hKR₁, ← RingHom.comp_assoc, he₁, he]
  have hSm₁ : RingHom.IsStandardSmoothOfRelativeDimension (n + r)
      (algebraMap K (Localization.Away s)) := by
    rw [hKR₁]
    have := (RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway
      (Rᵣ := Localization.Away s) s).comp hSm
    rwa [zero_add] at this

  have hMu : IsUnit (c + c.transpose).det := isUnit_iff_ne_zero.mpr hc
  have hMMi : (c + c.transpose) * (c + c.transpose)⁻¹ = 1 := Matrix.mul_nonsing_inv _ hMu
  generalize (c + c.transpose)⁻¹ = Mi at hMMi
  obtain ⟨S, _, _, e', U, hS0, he', hU0, hHens⟩ := wc_morse_quadric_hensel_standard_etale K
    (Localization.Away s) n (Mi.transpose * c * Mi) e₁ B₀ hvB

  have hN0 : ∀ p q, e' ((Mi.map ((algebraMap (Localization.Away s) S).comp
      (algebraMap K (Localization.Away s))) * U.transpose) p q) = 0 := by
    intro p q
    simp only [Matrix.mul_apply, map_sum, map_mul, Matrix.transpose_apply, hU0, mul_zero,
      Finset.sum_const_zero]
  have hMS : (c.map ((algebraMap (Localization.Away s) S).comp (algebraMap K (Localization.Away s))) +
      (c.map ((algebraMap (Localization.Away s) S).comp
        (algebraMap K (Localization.Away s)))).transpose) *
      Mi.map ((algebraMap (Localization.Away s) S).comp (algebraMap K (Localization.Away s))) = 1 := by
    have h1 := congrArg ((algebraMap (Localization.Away s) S).comp
      (algebraMap K (Localization.Away s))).mapMatrix hMMi
    rw [map_one, map_mul, map_add] at h1
    simpa [RingHom.mapMatrix_apply, Matrix.transpose_map] using h1
  have hL3 := L3 (c.map ((algebraMap (Localization.Away s) S).comp
      (algebraMap K (Localization.Away s))))
    (Mi.map ((algebraMap (Localization.Away s) S).comp (algebraMap K (Localization.Away s)))) U
    (fun k => algebraMap (Localization.Away s) S (σ₀ k)) hMS
  have hK : (Mi.map ((algebraMap (Localization.Away s) S).comp
      (algebraMap K (Localization.Away s)))).transpose *
      c.map ((algebraMap (Localization.Away s) S).comp (algebraMap K (Localization.Away s))) *
      Mi.map ((algebraMap (Localization.Away s) S).comp (algebraMap K (Localization.Away s))) =
      (Mi.transpose * c * Mi).map ((algebraMap (Localization.Away s) S).comp
        (algebraMap K (Localization.Away s))) := by
    rw [Matrix.map_mul, Matrix.map_mul, Matrix.transpose_map]
  rw [hK, add_assoc, hHens] at hL3
  have hstar : ∑ p, ∑ q, (c.map ((algebraMap (Localization.Away s) S).comp
      (algebraMap K (Localization.Away s)))) p q *
      ((1 + Mi.map ((algebraMap (Localization.Away s) S).comp
        (algebraMap K (Localization.Away s))) * U.transpose).mulVec
        (fun k => algebraMap (Localization.Away s) S (σ₀ k))) p *
      ((1 + Mi.map ((algebraMap (Localization.Away s) S).comp
        (algebraMap K (Localization.Away s))) * U.transpose).mulVec
        (fun k => algebraMap (Localization.Away s) S (σ₀ k))) q =
      algebraMap (Localization.Away s) S (algebraMap R (Localization.Away s) (ρ φ)) := by
    rw [hL3, hid]
    simp only [map_sum, map_mul, map_add, Matrix.add_apply, Matrix.map_apply, RingHom.comp_apply,
      hKR₁]
  generalize hNdef : Mi.map ((algebraMap (Localization.Away s) S).comp
      (algebraMap K (Localization.Away s))) * U.transpose = N at hN0 hstar

  have hζ : ∀ k, e₁ (algebraMap R (Localization.Away s) (ρ (z k))) = 0 := by
    intro k; rw [← RingHom.comp_apply, he₁]; exact hz0 k
  obtain ⟨s', hs', hJ⟩ := L4 (Localization.Away s) hSm₁ e₁ he₁K
    σ₀ (fun k => algebraMap R (Localization.Away s) (ρ (z k))) hvσ hζ hgen S hS0 e' he' N hN0
  have hΦ := hJ (Localization.Away s')
  obtain ⟨t', ht'⟩ : ∃ t' : Fin n → S,
      t' = (1 + N).mulVec (fun k => algebraMap (Localization.Away s) S (σ₀ k)) := ⟨_, rfl⟩
  rw [← ht'] at hstar hΦ

  have hρκ : ∀ x, ρ (κ x) = algebraMap K R x := fun x => by rw [← RingHom.comp_apply, hρ]
  have hι : ∀ x, algebraMap (Localization.Away s) S (algebraMap K (Localization.Away s) x) =
      algebraMap (Localization.Away s) S (algebraMap R (Localization.Away s) (algebraMap K R x)) := by
    intro x; rw [hKR₁, RingHom.comp_apply]

  obtain ⟨θR, hθR⟩ : ∃ θR : R →+* Localization.Away s', θR = (algebraMap S (Localization.Away s')).comp
      ((algebraMap (Localization.Away s) S).comp (algebraMap R (Localization.Away s))) := ⟨_, rfl⟩
  have hθRapp : ∀ x, θR x = algebraMap S (Localization.Away s')
      (algebraMap (Localization.Away s) S (algebraMap R (Localization.Away s) x)) := by
    intro x; rw [hθR]; rfl
  have hθRet : θR.Etale := by
    have h1 : (algebraMap R (Localization.Away s)).Etale :=
      RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway s)
    have h2 : (algebraMap (Localization.Away s) S).Etale := by
      haveI := (RingHom.isStandardSmoothOfRelativeDimension_algebraMap 0).mp hS0
      exact RingHom.etale_algebraMap.mpr inferInstance
    have h3 : (algebraMap S (Localization.Away s')).Etale :=
      RingHom.etale_algebraMap.mpr (Algebra.Etale.of_isLocalizationAway s')
    rw [hθR]
    exact RingHom.Etale.stableUnderComposition _ _
      (RingHom.Etale.stableUnderComposition _ _ h1 h2) h3

  obtain ⟨f, hf⟩ : ∃ f : MvPolynomial (Fin n) T →+* Localization.Away s',
      f = MvPolynomial.eval₂Hom (θR.comp ρ) (fun i => algebraMap S (Localization.Away s') (t' i)) :=
    ⟨_, rfl⟩
  have hfC : ∀ x, f (MvPolynomial.C x) = θR (ρ x) := by
    intro x; rw [hf, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
  have hfX : ∀ i, f (MvPolynomial.X i) = algebraMap S (Localization.Away s') (t' i) := by
    intro i; rw [hf, MvPolynomial.eval₂Hom_X']
  have hQ : f (∑ p, ∑ q, MvPolynomial.C ((c.map κ) p q) * MvPolynomial.X p * MvPolynomial.X q -
      MvPolynomial.C φ) = 0 := by
    rw [map_sub, sub_eq_zero]
    have h := congrArg (algebraMap S (Localization.Away s')) hstar
    simp only [map_sum, map_mul, Matrix.map_apply, RingHom.comp_apply, hι] at h
    simp only [map_sum, map_mul, hfC, hfX, Matrix.map_apply, hρκ, hθRapp]
    exact h
  have hfI : ∀ a ∈ wcQuadModelIdeal T n φ (c.map κ), f a = 0 := by
    intro a ha
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hQ, mul_zero]
  obtain ⟨θ, hθ⟩ : ∃ θ : wcQuadModelRing T n φ (c.map κ) →+* Localization.Away s',
      ∀ a, θ (Ideal.Quotient.mk (wcQuadModelIdeal T n φ (c.map κ)) a) = f a :=
    ⟨Ideal.Quotient.lift _ f hfI, fun a => Ideal.Quotient.lift_mk _ _ _⟩
  have hΦ₀ := L5a
  have hcomp : θ.comp (MvPolynomial.eval₂Hom ((Ideal.Quotient.mk (wcQuadModelIdeal T n φ (c.map κ))).comp
      (MvPolynomial.C.comp κ)) (Sum.elim (fun i => Ideal.Quotient.mk (wcQuadModelIdeal T n φ (c.map κ))
        (MvPolynomial.X i)) (fun k => Ideal.Quotient.mk (wcQuadModelIdeal T n φ (c.map κ))
          (MvPolynomial.C (z k))))) =
      (algebraMap S (Localization.Away s')).comp (MvPolynomial.eval₂Hom
        ((algebraMap (Localization.Away s) S).comp (algebraMap K (Localization.Away s)))
        (Sum.elim t' (fun k => algebraMap (Localization.Away s) S
          (algebraMap R (Localization.Away s) (ρ (z k)))))) := by
    apply MvPolynomial.ringHom_ext
    · intro x
      simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_C, hθ, hfC, hρκ, hθRapp, hι]
    · intro i
      cases i with
      | inl i => simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X', Sum.elim_inl, hθ, hfX]
      | inr k => simp only [RingHom.comp_apply, MvPolynomial.eval₂Hom_X', Sum.elim_inr, hθ, hfC, hθRapp]
  have hθet : θ.Etale := L5b _ θ hΦ₀ (by rw [hcomp]; exact hΦ)

  have he'' := IsLocalization.Away.lift_comp (S := Localization.Away s') s'
    (isUnit_iff_ne_zero.mpr hs')
  generalize IsLocalization.Away.lift (S := Localization.Away s') s' (isUnit_iff_ne_zero.mpr hs') = e''
    at he''
  have hσS : ∀ p, e' (algebraMap (Localization.Away s) S (σ₀ p)) = 0 := fun p => by
    rw [← RingHom.comp_apply, he']; exact hvσ p
  refine ⟨Localization.Away s', inferInstance, θR, θ, e'', hθRet, hθet, ?_, ?_, ?_⟩
  · ext x
    rw [RingHom.comp_apply, RingHom.comp_apply, ← Ideal.Quotient.mk_algebraMap,
      MvPolynomial.algebraMap_eq, hθ, hfC]
  · rw [hθR, ← RingHom.comp_assoc, he'', ← RingHom.comp_assoc, he', he₁]
  · intro q
    rw [hθ, hfX, ← RingHom.comp_apply, he'', ht']
    simp only [Matrix.mulVec, dotProduct, map_sum, map_mul, hσS, mul_zero, Finset.sum_const_zero]

theorem wc_pfam_xwt_param_morse_chart : ∀ (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ), 2 ≤ n → ∀ (D : wcLefschetzDatum F' F'' Y n) (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M') (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M') (p : D.Yt.left ⟶ Xu.left), wcPfamHyp D M' Xu h Δ lam p → ∀ (j : Fin D.m), ∃ (W : (wcProjK F'' M').Opens) (hW : IsAffineOpen W) (φ : Γ(wcProjK F'' M', W)) (hy : lam (D.S j (IsLocalRing.closedPoint F'')) ∈ W), (∀ (x : wcProjK F'' M') (hx : x ∈ W), x ∈ Δ ↔ ((wcProjK F'' M').presheaf.germ W x hx).hom φ ∈ IsLocalRing.maximalIdeal ((wcProjK F'' M').presheaf.stalk x)) ∧ IsLocalRing.maximalIdeal ((wcP1Over F'').left.presheaf.stalk (D.S j (IsLocalRing.closedPoint F''))) = Ideal.span {(lam.stalkMap (D.S j (IsLocalRing.closedPoint F''))).hom (((wcProjK F'' M').presheaf.germ W _ hy).hom φ)} ∧ ∃ (U : Scheme.{u}) (u : U ⟶ Xu.left) (c : Matrix (Fin n) (Fin n) F'') (ψ : U ⟶ Spec (.of (wcQuadModelRing Γ(wcProjK F'' M', W) n φ (c.map (wcUnK F'' M' (𝟙 (wcProjK F'' M')) W))))) (σ : Spec (.of F'') ⟶ U), Etale u ∧ Etale ψ ∧ (c + c.transpose).det ≠ 0 ∧ u ≫ h = ψ ≫ wcQuadModelStr Γ(wcProjK F'' M', W) n φ (c.map (wcUnK F'' M' (𝟙 (wcProjK F'' M')) W)) ≫ hW.fromSpec ∧ σ ≫ u = D.xs j ≫ p ∧ ∀ q, Ideal.Quotient.mk (wcQuadModelIdeal Γ(wcProjK F'' M', W) n φ (c.map (wcUnK F'' M' (𝟙 (wcProjK F'' M')) W))) (MvPolynomial.X q) ∈ (ψ (σ (IsLocalRing.closedPoint F''))).asIdeal :=
by
  intro F' F'' _ _ _ _ Y n hn2 D M' Xu h Δ lam p hH j
  obtain ⟨W, hW, φ, hy, hΔW, hunif, z, hét, V, hV, e, ρ, hNoeth, hSm, he1, he2, hρ1, hρ2, hloc⟩ :=
    wc_pfam_mc_front_end F' F'' Y n hn2 D M' Xu h Δ lam p hH j
  letI : Algebra F'' Γ(Xu.left, V) :=
    ((Xu.hom.appLE ⊤ V le_top).hom.comp (Scheme.ΓSpecIso (.of F'')).inv.hom).toAlgebra
  haveI := hNoeth
  letI : (RingHom.ker e).IsPrime := RingHom.ker_isPrime e
  obtain ⟨hdim, eX, t, b, a, H, w, heX, hgen, hb1, hb2, ha, hH0, hG, hcrit⟩ := hloc
  haveI : IsNoetherianRing (Localization.AtPrime (RingHom.ker e)) :=
    IsLocalization.isNoetherianRing (RingHom.ker e).primeCompl _ inferInstance
  obtain ⟨c, B, hc, hB, hσgen, hGσ⟩ := wc_pfam_mc_param_morse_local F''
    (Localization.AtPrime (RingHom.ker e)) n (M' - 1) hdim eX heX t
    (fun k => algebraMap Γ(Xu.left, V) (Localization.AtPrime (RingHom.ker e)) (ρ (z k))) b hgen
    hb1 hb2 _ a H w ha hH0 hG hcrit
  obtain ⟨S, _, θR, θ, e', hθR, hθ, hcomm, he', hvert⟩ := wc_pfam_mc_ring_chart F''
    Γ(Xu.left, V) n (M' - 1) hSm e he2 Γ(wcProjK F'' M', W) (wcUnK F'' M' (𝟙 (wcProjK F'' M')) W)
    ρ hρ2 φ z hét _ c B hc hB hσgen hGσ
  haveI : Etale (Spec.map (CommRingCat.ofHom θR)) :=
    (HasRingHomProperty.Spec_iff (P := @Etale)).mpr hθR
  have hψ : Etale (Spec.map (CommRingCat.ofHom θ)) :=
    (HasRingHomProperty.Spec_iff (P := @Etale)).mpr hθ
  refine ⟨W, hW, φ, hy, hΔW, hunif, Spec (.of S), Spec.map (CommRingCat.ofHom θR) ≫ hV.fromSpec,
    c, Spec.map (CommRingCat.ofHom θ), Spec.map (CommRingCat.ofHom e'), inferInstance, hψ, hc,
    ?_, ?_, ?_⟩
  · rw [Category.assoc, ← hρ1, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← hcomm, CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc]
  · rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, he', he1]
  · intro q
    show e' (θ (Ideal.Quotient.mk _ (MvPolynomial.X q))) ∈ (IsLocalRing.closedPoint F'').asIdeal
    rw [hvert q]
    exact Ideal.zero_mem _

theorem wc_pfam_ltd_wt_xi_dvr (A B : Type u) [CommRing A] [IsDomain A] [IsNoetherianRing A]
    [IsLocalRing A] [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    (α : A →+* B) (hα : @Algebra.WeaklyEtale A B _ _ α.toAlgebra)
    (f₀ : A) (hf₀ : f₀ ≠ 0) (hpr : (Ideal.span {f₀}).IsPrime)
    (hcomap : (IsLocalRing.maximalIdeal B).comap α = Ideal.span {f₀}) :
    ∃ _ : IsDomain B, IsDiscreteValuationRing B ∧ Function.Injective α :=
by
  classical
  letI : Algebra A B := α.toAlgebra

  have hreg_gen : ∀ a : A, a ≠ 0 → ∀ y : B, α a * y = 0 → y = 0 := by
    intro a ha y hy
    haveI : Module.Flat A B := hα.flat
    have h1 : IsSMulRegular A a := fun x x' hxx =>
      mul_left_cancel₀ ha (by simpa only [smul_eq_mul] using hxx)
    have h2 : IsSMulRegular B (algebraMap A B a) := h1.of_flat
    apply h2
    show α a * y = α a * 0
    rw [hy, mul_zero]
  have hinj : Function.Injective α := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    by_contra hne
    have h1 := hreg_gen a hne 1 (by rw [ha, zero_mul])
    exact one_ne_zero h1

  have hπm : α f₀ ∈ IsLocalRing.maximalIdeal B := by
    have h1 : f₀ ∈ (IsLocalRing.maximalIdeal B).comap α := by
      rw [hcomap]; exact Ideal.mem_span_singleton_self f₀
    exact h1

  have key : ∀ b : B, ∃ (R : Type u) (_ : CommRing R) (_ : IsLocalRing R) (_ : IsNoetherianRing R)
      (g : R) (β' : R →+* B) (ε : R), IsLocalRing.maximalIdeal R = Ideal.span {g} ∧
      β' g = α f₀ ∧ β' ε = b ∧ (∀ I : Ideal R, (I.map β').comap β' = I) ∧
      (b ∈ IsLocalRing.maximalIdeal B → ε ∈ IsLocalRing.maximalIdeal R) := by
    intro b
    obtain ⟨E, _, _, hE, β, e, hβ, he⟩ := wc_lpkt_indetale_factor A B α hα 1 (fun _ => b)
    set P := (IsLocalRing.maximalIdeal B).comap β with hPdef
    have hP : P.comap (algebraMap A E) = Ideal.span {f₀} := by
      rw [hPdef, Ideal.comap_comap, hβ, hcomap]
    haveI : IsNoetherianRing E := Algebra.FiniteType.isNoetherianRing A E
    haveI : IsNoetherianRing (Localization.AtPrime P) :=
      IsLocalization.isNoetherianRing P.primeCompl _ inferInstance
    have hunit : ∀ y : P.primeCompl, IsUnit (β y) := fun y =>
      IsLocalRing.notMem_maximalIdeal.mp y.2
    let β' : Localization.AtPrime P →+* B := IsLocalization.lift hunit
    have hβ'1 : β'.comp (algebraMap E (Localization.AtPrime P)) = β := IsLocalization.lift_comp hunit
    have hβ'e : ∀ x, β' (algebraMap E (Localization.AtPrime P) x) = β x := fun x => by
      rw [← RingHom.comp_apply, hβ'1]
    have hloc : IsLocalHom β' := by
      constructor
      intro z hz
      obtain ⟨⟨x, s⟩, hzs⟩ := IsLocalization.mk'_surjective P.primeCompl z
      subst hzs
      have h1 : β' (IsLocalization.mk' (Localization.AtPrime P) x s) * β s = β x := by
        rw [← hβ'e, ← hβ'e, ← map_mul, IsLocalization.mk'_spec]
      have h2 : IsUnit (β x) := by rw [← h1]; exact hz.mul (hunit s)
      exact (IsLocalization.AtPrime.isUnit_mk'_iff (Localization.AtPrime P) P x s).mpr
        (IsLocalRing.notMem_maximalIdeal.mpr h2)

    letI : Algebra E B := β.toAlgebra
    haveI : IsScalarTower A E B := IsScalarTower.of_algebraMap_eq (fun x =>
      (DFunLike.congr_fun hβ x).symm)
    have hwEB : Algebra.WeaklyEtale E B := wc_weaklyEtale_cancel A E B inferInstance hα
    have hwEEP : Algebra.WeaklyEtale E (Localization.AtPrime P) :=
      wc_localization_weaklyEtale E _ P.primeCompl
    letI : Algebra (Localization.AtPrime P) B := β'.toAlgebra
    haveI : IsScalarTower E (Localization.AtPrime P) B :=
      IsScalarTower.of_algebraMap_eq (fun x => (hβ'e x).symm)
    have hwPB : Algebra.WeaklyEtale (Localization.AtPrime P) B :=
      wc_weaklyEtale_cancel E _ B hwEEP hwEB
    haveI : Module.Flat (Localization.AtPrime P) B := hwPB.flat
    haveI : IsLocalHom (algebraMap (Localization.AtPrime P) B) := hloc
    haveI : Module.FaithfullyFlat (Localization.AtPrime P) B :=
      Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hpure : ∀ I : Ideal (Localization.AtPrime P), (I.map β').comap β' = I := fun I =>
      Ideal.comap_map_eq_self_of_faithfullyFlat I

    haveI : P.LiesOver (Ideal.span {f₀}) := ⟨by rw [Ideal.under_def, hP]⟩
    letI : Algebra (Localization.AtPrime (Ideal.span {f₀})) (Localization.AtPrime P) :=
      (Localization.localRingHom (Ideal.span {f₀}) P (algebraMap A E) hP.symm).toAlgebra
    haveI : IsScalarTower A (Localization.AtPrime (Ideal.span {f₀})) (Localization.AtPrime P) :=
      IsScalarTower.of_algebraMap_eq (fun x => by
        show _ = Localization.localRingHom (Ideal.span {f₀}) P (algebraMap A E) hP.symm
          (algebraMap A (Localization.AtPrime (Ideal.span {f₀})) x)
        rw [Localization.localRingHom_to_map,
          IsScalarTower.algebraMap_apply A E (Localization.AtPrime P)])
    have hmax : Ideal.map (algebraMap A (Localization.AtPrime P)) (Ideal.span {f₀}) =
        IsLocalRing.maximalIdeal (Localization.AtPrime P) :=
      ((Algebra.isUnramifiedAt_iff_map_eq A (Ideal.span {f₀}) P).mp inferInstance).2
    have hmaxg : IsLocalRing.maximalIdeal (Localization.AtPrime P) =
        Ideal.span {algebraMap A (Localization.AtPrime P) f₀} := by
      rw [← hmax, Ideal.map_span, Set.image_singleton]
    have hg : β' (algebraMap A (Localization.AtPrime P) f₀) = α f₀ := by
      rw [IsScalarTower.algebraMap_apply A E (Localization.AtPrime P), hβ'e,
        ← RingHom.comp_apply, hβ]
    refine ⟨Localization.AtPrime P, inferInstance, inferInstance, inferInstance,
      algebraMap A (Localization.AtPrime P) f₀, β', algebraMap E (Localization.AtPrime P) (e 0),
      hmaxg, hg, by rw [hβ'e, he 0], hpure, fun hb => ?_⟩
    have hP0 : e 0 ∈ P := by
      show β (e 0) ∈ IsLocalRing.maximalIdeal B
      rw [he 0]; exact hb
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime P) P (e 0)).mpr hP0

  have hmaxB : IsLocalRing.maximalIdeal B = Ideal.span {α f₀} := by
    apply le_antisymm
    · intro b hb
      obtain ⟨R, _, _, _, g, β', ε, hRm, hg, hε, _, hεm⟩ := key b
      have h1 := hεm hb
      rw [hRm, Ideal.mem_span_singleton'] at h1
      obtain ⟨z, hz⟩ := h1
      rw [Ideal.mem_span_singleton']
      exact ⟨β' z, by rw [← hg, ← map_mul, hz, hε]⟩
    · rw [Ideal.span_le, Set.singleton_subset_iff]; exact hπm

  have hkrull : ∀ x : B, (∀ n : ℕ, x ∈ Ideal.span {α f₀ ^ n}) → x = 0 := by
    intro x hx
    obtain ⟨R, _, _, _, g, β', ε, hRm, hg, hε, hpure, _⟩ := key x
    have hmem : ∀ n : ℕ, ε ∈ IsLocalRing.maximalIdeal R ^ n := by
      intro n
      rw [← hpure (IsLocalRing.maximalIdeal R ^ n), Ideal.mem_comap, hε, hRm,
        Ideal.span_singleton_pow, Ideal.map_span, Set.image_singleton, map_pow, hg]
      exact hx n
    have hbot := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal R)
      (IsLocalRing.maximalIdeal.isMaximal R).ne_top
    have h0 : ε ∈ (⊥ : Ideal R) := by rw [← hbot]; exact Ideal.mem_iInf.mpr hmem
    rw [Ideal.mem_bot] at h0
    rw [← hε, h0, map_zero]

  have hreg : ∀ y : B, α f₀ * y = 0 → y = 0 := hreg_gen f₀ hf₀
  have hpowreg : ∀ k : ℕ, ∀ y : B, α f₀ ^ k * y = 0 → y = 0 := by
    intro k
    induction k with
    | zero => intro y hy; simpa using hy
    | succ k ih =>
      intro y hy
      apply ih
      apply hreg
      rw [← mul_assoc, ← pow_succ']
      exact hy
  have hfact : ∀ x : B, x ≠ 0 → ∃ (u : B) (N : ℕ), IsUnit u ∧ x = u * α f₀ ^ N := by
    intro x hx
    have hex : ∃ k, x ∉ Ideal.span {α f₀ ^ k} := by
      by_contra h
      push_neg at h
      exact hx (hkrull x h)
    have hk₀ : x ∉ Ideal.span {α f₀ ^ Nat.find hex} := Nat.find_spec hex
    have hk₀pos : Nat.find hex ≠ 0 := by
      intro h0
      apply hk₀
      rw [h0, pow_zero, Ideal.span_singleton_one]
      exact Submodule.mem_top
    obtain ⟨N, hN⟩ : ∃ N, Nat.find hex = N + 1 := ⟨Nat.find hex - 1, by omega⟩
    have hxN : x ∈ Ideal.span {α f₀ ^ N} := by
      by_contra h
      exact Nat.find_min hex (show N < Nat.find hex by omega) h
    obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp hxN
    refine ⟨u, N, ?_, hu.symm⟩
    by_contra hu'
    have hum : u ∈ IsLocalRing.maximalIdeal B := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hu'
    rw [hmaxB, Ideal.mem_span_singleton'] at hum
    obtain ⟨w, hw⟩ := hum
    apply hk₀
    rw [Ideal.mem_span_singleton']
    exact ⟨w, by rw [hN, ← hu, ← hw]; ring⟩
  have hnzd : ∀ x y : B, x * y = 0 → x = 0 ∨ y = 0 := by
    intro x y hxy
    by_contra h
    push_neg at h
    obtain ⟨u, n, hu, rfl⟩ := hfact x h.1
    obtain ⟨v, m, hv, rfl⟩ := hfact y h.2
    have h1 : (u * v) * (α f₀ ^ (n + m)) = 0 := by rw [← hxy]; ring
    rw [(hu.mul hv).mul_right_eq_zero] at h1
    have h2 := hpowreg (n + m) 1 (by rw [mul_one]; exact h1)
    exact one_ne_zero h2
  haveI : NoZeroDivisors B := ⟨fun {x y} h => hnzd x y h⟩
  haveI : IsDomain B := NoZeroDivisors.to_isDomain B
  have hπnu : ¬ IsUnit (α f₀) := by
    have h1 := (IsLocalRing.mem_maximalIdeal (α f₀)).mp hπm
    exact mem_nonunits_iff.mp h1
  have hπirr : Irreducible (α f₀) := by
    rw [irreducible_iff]
    refine ⟨hπnu, ?_⟩
    intro a b hab
    by_contra h
    push_neg at h
    have ha : a ∈ IsLocalRing.maximalIdeal B := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact h.1
    have hb : b ∈ IsLocalRing.maximalIdeal B := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact h.2
    rw [hmaxB, Ideal.mem_span_singleton'] at ha hb
    obtain ⟨a', rfl⟩ := ha
    obtain ⟨b', rfl⟩ := hb
    have h1 : α f₀ * (1 - a' * b' * α f₀) = 0 := by linear_combination hab
    have h2 := hreg _ h1
    exact hπnu (isUnit_iff_exists_inv.mpr ⟨a' * b', by linear_combination -h2⟩)
  have hDVR : IsDiscreteValuationRing B := by
    apply IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
    refine ⟨α f₀, hπirr, fun {x} hx => ?_⟩
    obtain ⟨u, N, hu, rfl⟩ := hfact x hx
    exact ⟨N, hu.unit, by rw [IsUnit.unit_spec, mul_comm]⟩
  exact ⟨inferInstance, hDVR, hinj⟩

theorem wc_tla_smooth_rational_stalk_regular : ∀ (K : Type u) [Field K] (Z : Scheme.{u}) (s : Z ⟶ Spec (.of K)) (d : ℕ) [SmoothOfRelativeDimension d s] (σ : Spec (.of K) ⟶ Z), σ ≫ s = 𝟙 _ → ∀ z : Z, σ (IsLocalRing.closedPoint K) = z → IsRegularLocalRing (Z.presheaf.stalk z) ∧ ringKrullDim (Z.presheaf.stalk z) = d :=
by
  intro K _ Z s d _ σ hσ z hz
  subst hz
  have hres : ∀ (O : Type u) [CommRing O] [IsLocalRing O] [Algebra K O] (r : O →+* K),
      r.comp (algebraMap K O) = RingHom.id K →
      Algebra.FormallySmooth K (IsLocalRing.ResidueField O) := by
    intro O _ _ _ r hr
    have hinj : Function.Injective (algebraMap K (IsLocalRing.ResidueField O)) :=
      (algebraMap K (IsLocalRing.ResidueField O)).injective
    have hsurj : Function.Surjective (algebraMap K (IsLocalRing.ResidueField O)) := by
      intro y
      obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
      refine ⟨r a, ?_⟩
      have hx : a - algebraMap K O (r a) ∈ IsLocalRing.maximalIdeal O := by
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        intro hu
        have h1 := hu.map r
        have h2 : r (a - algebraMap K O (r a)) = 0 := by
          rw [map_sub, ← RingHom.comp_apply, hr, RingHom.id_apply, sub_self]
        rw [h2] at h1
        exact not_isUnit_zero h1
      rw [IsScalarTower.algebraMap_apply K O (IsLocalRing.ResidueField O),
        IsLocalRing.ResidueField.algebraMap_eq]
      symm
      rw [← sub_eq_zero, ← map_sub]
      exact (IsLocalRing.residue_eq_zero_iff _).mpr hx
    exact Algebra.FormallySmooth.of_equiv
      (AlgEquiv.ofBijective (Algebra.ofId K (IsLocalRing.ResidueField O)) ⟨hinj, hsurj⟩)
  have hretr : ∃ r : Z.presheaf.stalk (σ (IsLocalRing.closedPoint K)) →+* K,
      r.comp (wcLdpConst K s (σ (IsLocalRing.closedPoint K))) = RingHom.id K := by
    refine ⟨(Scheme.stalkClosedPointTo σ).hom, ?_⟩
    have key : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ s.appTop ≫
        Z.presheaf.germ ⊤ (σ (IsLocalRing.closedPoint K)) trivial ≫
        Scheme.stalkClosedPointTo σ = 𝟙 _ := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_comp, Spec.map_comp, Spec.map_id,
        ← Scheme.fromSpecStalk_toSpecΓ, ← Category.assoc,
        Scheme.Spec_stalkClosedPointTo_fromSpecStalk]
      simp only [Category.assoc]
      rw [← Category.assoc Z.toSpecΓ, ← Scheme.toSpecΓ_naturality, Category.assoc,
        reassoc_of% hσ, toSpecΓ_SpecMap_ΓSpecIso_inv]
    have := congrArg CommRingCat.Hom.hom key
    simp only [CommRingCat.hom_comp, CommRingCat.hom_id] at this
    rw [← this]
    rfl
  have hcl : IsClosed ({σ (IsLocalRing.closedPoint K)} : Set Z) := by
    haveI : IsClosedImmersion σ := isClosedImmersion_of_comp_eq_id s σ hσ
    have h1 : IsClosed (Set.range σ) := (IsClosedImmersion.isClosedEmbedding σ).isClosed_range
    have h2 : Set.range σ = {σ (IsLocalRing.closedPoint K)} := by
      ext y
      constructor
      · rintro ⟨x, rfl⟩
        rw [Subsingleton.elim x (IsLocalRing.closedPoint K)]
        rfl
      · rintro rfl
        exact ⟨IsLocalRing.closedPoint K, rfl⟩
    rw [← h2]
    exact h1
  have hdim : ringKrullDim (Z.presheaf.stalk (σ (IsLocalRing.closedPoint K))) = (d : WithBot ℕ∞) :=
    wc_lfi_smooth_stalk_dim K Z s d (σ (IsLocalRing.closedPoint K)) hcl
  obtain ⟨r, hr⟩ := hretr
  letI := (wcLdpConst K s (σ (IsLocalRing.closedPoint K))).toAlgebra
  obtain ⟨hFS, hFree, hFin, hrank, hEFT⟩ :=
    wc_ldp_il_stalk_of_smooth_field K s d (σ (IsLocalRing.closedPoint K))
  haveI : IsNoetherianRing (Z.presheaf.stalk (σ (IsLocalRing.closedPoint K))) :=
    Algebra.EssFiniteType.isNoetherianRing K _
  have hFSκ := hres (Z.presheaf.stalk (σ (IsLocalRing.closedPoint K))) r hr
  have hup := wcpa_embdim_le_rank_omega K (Z.presheaf.stalk (σ (IsLocalRing.closedPoint K)))
    hFS hFree hFin hFSκ
  rw [hrank] at hup
  have hlo : d ≤ Submodule.spanFinrank
      (IsLocalRing.maximalIdeal (Z.presheaf.stalk (σ (IsLocalRing.closedPoint K)))) := by
    have h1 := Ideal.height_le_spanFinrank
      (IsLocalRing.maximalIdeal (Z.presheaf.stalk (σ (IsLocalRing.closedPoint K))))
      (IsLocalRing.maximalIdeal.isMaximal _).ne_top
    have h2 := IsLocalRing.maximalIdeal_height_eq_ringKrullDim
      (R := Z.presheaf.stalk (σ (IsLocalRing.closedPoint K)))
    rw [hdim] at h2
    have h3 : (IsLocalRing.maximalIdeal
        (Z.presheaf.stalk (σ (IsLocalRing.closedPoint K)))).height = (d : ℕ∞) := by
      exact_mod_cast h2
    rw [h3] at h1
    exact_mod_cast h1
  have heq : Submodule.spanFinrank
      (IsLocalRing.maximalIdeal (Z.presheaf.stalk (σ (IsLocalRing.closedPoint K)))) = d :=
    le_antisymm hup hlo
  refine ⟨IsRegularLocalRing.mk ?_, hdim⟩
  rw [heq, hdim]

theorem wc_pfam_xwt_trait_dvr : ∀ (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n) (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M') (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M') (p : D.Yt.left ⟶ Xu.left), wcPfamHyp D M' Xu h Δ lam p → ∀ (j : Fin D.m) (W : (wcProjK F'' M').Opens) (hW : IsAffineOpen W) (φ : Γ(wcProjK F'' M', W)) (hy : lam (D.S j (IsLocalRing.closedPoint F'')) ∈ W), (∀ (x : wcProjK F'' M') (hx : x ∈ W), x ∈ Δ ↔ ((wcProjK F'' M').presheaf.germ W x hx).hom φ ∈ IsLocalRing.maximalIdeal ((wcProjK F'' M').presheaf.stalk x)) → IsLocalRing.maximalIdeal ((wcP1Over F'').left.presheaf.stalk (D.S j (IsLocalRing.closedPoint F''))) = Ideal.span {(lam.stalkMap (D.S j (IsLocalRing.closedPoint F''))).hom (((wcProjK F'' M').presheaf.germ W _ hy).hom φ)} → ∀ (A' : Type u) [CommRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')] (a : Spec (.of A') ⟶ wcProjK F'' M'), WeaklyEtale a → a (IsLocalRing.closedPoint A') ∈ Δ → (∀ y ∈ Δ, a (IsLocalRing.closedPoint A') ⤳ y) → ∀ (aW : Spec (.of A') ⟶ Spec Γ(wcProjK F'' M', W)), aW ≫ hW.fromSpec = a → ∃ (_ : IsDomain A'), IsDiscreteValuationRing A' ∧ IsLocalRing.maximalIdeal A' = Ideal.span {(Spec.preimage aW).hom φ} :=
by
  intro F' F'' _ _ _ _ Y n D M' Xu h Δ lam p hH j W hW φ hy hΔW hunif A' _ _ _ a hwe hx'Δ hspec aW haW
  classical

  have core : ∀ {X : Scheme.{u}} {W : X.Opens} (hW : IsAffineOpen W) (Δ : Set X) (φ : Γ(X, W))
      (y : X) (hy : y ∈ W), IsRegularLocalRing (X.presheaf.stalk y) →
      ∀ (S : Type u) [CommRing S] [IsLocalRing S] (g : X.presheaf.stalk y →+* S) [IsLocalHom g],
      IsLocalRing.maximalIdeal S ≠ ⊥ →
      IsLocalRing.maximalIdeal S = Ideal.span {g ((X.presheaf.germ W y hy).hom φ)} →
      y ∈ Δ →
      (∀ (x : X) (hx : x ∈ W), x ∈ Δ ↔ (X.presheaf.germ W x hx).hom φ ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk x)) →
      ∀ (A' : Type u) [CommRing A'] [HenselianLocalRing A']
      [IsSepClosed (IsLocalRing.ResidueField A')]
      (a : Spec (.of A') ⟶ X), WeaklyEtale a → a (IsLocalRing.closedPoint A') ∈ Δ →
      (∀ z ∈ Δ, a (IsLocalRing.closedPoint A') ⤳ z) →
      ∀ (aW : Spec (.of A') ⟶ Spec Γ(X, W)), aW ≫ hW.fromSpec = a →
      ∃ (_ : IsDomain A'), IsDiscreteValuationRing A' ∧
        IsLocalRing.maximalIdeal A' = Ideal.span {(Spec.preimage aW).hom φ} := by
    intro X W hW Δ φ y hy hreg S _ _ g _ hS0 hunif hyΔ hΔW A' _ _ _ a hwe hx'Δ hspec aW haW
    have app : ∀ {X Z : Scheme.{u}} {f g : X ⟶ Z}, f = g → ∀ x, f x = g x :=
      fun hfg x => hfg ▸ rfl

    have hWEaW : WeaklyEtale aW := by
      have hsq : IsPullback aW (𝟙 _) hW.fromSpec a :=
        IsPullback.of_vert_isIso_mono ⟨by rw [Category.id_comp, haW]⟩
      exact MorphismProperty.of_isPullback (P := @WeaklyEtale) hsq.flip hwe
    obtain ⟨ρ, hρ, hρφ⟩ : ∃ ρ : ↑Γ(X, W) →+* A',
        Spec.map (CommRingCat.ofHom ρ) = aW ∧ (Spec.preimage aW).hom = ρ :=
      ⟨_, Spec.map_preimage aW, rfl⟩
    rw [hρφ]
    subst hρ
    have hρwe : @Algebra.WeaklyEtale ↑Γ(X, W) A' _ _ ρ.toAlgebra :=
      wc_lpkt_specMap_weaklyEtale_ring _ _ ρ hWEaW
    have hx' : hW.fromSpec (Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint A')) =
        a (IsLocalRing.closedPoint A') := app haW _
    obtain ⟨𝔭, h𝔭pt, h𝔭⟩ : ∃ 𝔭 : PrimeSpectrum ↑Γ(X, W),
        Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint A') = 𝔭 ∧
        𝔭.asIdeal = (IsLocalRing.maximalIdeal A').comap ρ := ⟨_, rfl, rfl⟩
    rw [h𝔭pt] at hx'

    have star : ∀ 𝔯 : PrimeSpectrum ↑Γ(X, W), hW.fromSpec 𝔯 ∈ Δ ↔ φ ∈ 𝔯.asIdeal := by
      intro 𝔯
      have hz : hW.fromSpec 𝔯 ∈ W := by
        show hW.fromSpec 𝔯 ∈ (W : Set X)
        rw [← hW.range_fromSpec]
        exact Set.mem_range_self 𝔯
      letI := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨hW.fromSpec 𝔯, hz⟩
      have hL := hW.isLocalization_stalk' 𝔯 hz
      rw [hΔW _ hz]
      exact @IsLocalization.AtPrime.to_map_mem_maximal_iff _ _ _ _ _
        𝔯.asIdeal _ hL φ _
    have hφ𝔭 : φ ∈ 𝔭.asIdeal := (star 𝔭).mp (by rw [hx']; exact hx'Δ)
    have hρφm : ρ φ ∈ IsLocalRing.maximalIdeal A' := by
      rw [h𝔭] at hφ𝔭; exact hφ𝔭

    have h𝔮 : hW.fromSpec (hW.primeIdealOf ⟨y, hy⟩) = y := hW.fromSpec_primeIdealOf ⟨y, hy⟩
    have hle : 𝔭.asIdeal ≤ (hW.primeIdealOf ⟨y, hy⟩).asIdeal := by
      have h1 : 𝔭 ≤ hW.primeIdealOf ⟨y, hy⟩ := by
        rw [PrimeSpectrum.le_iff_specializes]
        apply (hW.fromSpec.isOpenEmbedding.isInducing.specializes_iff).mp
        rw [hx', h𝔮]
        exact hspec y hyΔ
      exact h1
    letI : Algebra ↑Γ(X, W) (X.presheaf.stalk y) :=
      TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨y, hy⟩
    haveI hloc : IsLocalization.AtPrime (X.presheaf.stalk y) (hW.primeIdealOf ⟨y, hy⟩).asIdeal :=
      hW.isLocalization_stalk ⟨y, hy⟩
    have halg : ∀ r, algebraMap ↑Γ(X, W) (X.presheaf.stalk y) r =
        (X.presheaf.germ W y hy).hom r := fun r => rfl

    have hunitρ : ∀ t : (hW.primeIdealOf ⟨y, hy⟩).asIdeal.primeCompl, IsUnit (ρ t) := by
      intro t
      apply IsLocalRing.notMem_maximalIdeal.mp
      intro ht
      apply t.2
      apply hle
      rw [h𝔭]
      exact ht
    let α : X.presheaf.stalk y →+* A' := IsLocalization.lift hunitρ
    have hαρ : α.comp (algebraMap ↑Γ(X, W) (X.presheaf.stalk y)) = ρ :=
      IsLocalization.lift_comp hunitρ
    have hαe : ∀ r, α ((X.presheaf.germ W y hy).hom r) = ρ r := fun r => by
      rw [← halg, ← RingHom.comp_apply, hαρ]
    have hαwe : @Algebra.WeaklyEtale (X.presheaf.stalk y) A' _ _ α.toAlgebra := by
      letI : Algebra ↑Γ(X, W) A' := ρ.toAlgebra
      letI : Algebra (X.presheaf.stalk y) A' := α.toAlgebra
      haveI : IsScalarTower ↑Γ(X, W) (X.presheaf.stalk y) A' :=
        IsScalarTower.of_algebraMap_eq (fun r => (DFunLike.congr_fun hαρ r).symm)
      exact wc_weaklyEtale_cancel _ _ _
        (wc_localization_weaklyEtale _ _ (hW.primeIdealOf ⟨y, hy⟩).asIdeal.primeCompl) hρwe

    obtain ⟨f₀, hf₀def⟩ : ∃ f₀, f₀ = (X.presheaf.germ W y hy).hom φ := ⟨_, rfl⟩
    rw [← hf₀def] at hunif
    have hαf : α f₀ = ρ φ := by rw [hf₀def]; exact hαe φ
    have hf₀m : f₀ ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk y) := by
      rw [hf₀def]; exact (hΔW y hy).mp hyΔ
    have hf₀0 : f₀ ≠ 0 := by
      intro h
      apply hS0
      rw [hunif, h, map_zero, Ideal.span_singleton_eq_bot]
    have hmapg : ∀ z ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk y),
        g z ∈ IsLocalRing.maximalIdeal S := by
      intro z hz
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hz ⊢
      exact fun hu => hz (isUnit_of_map_unit g z hu)
    have hf₀sq : f₀ ∉ IsLocalRing.maximalIdeal (X.presheaf.stalk y) ^ 2 := by
      intro h
      have h2 : Ideal.map g (IsLocalRing.maximalIdeal (X.presheaf.stalk y) ^ 2) ≤
          IsLocalRing.maximalIdeal S ^ 2 := by
        rw [Ideal.map_pow]
        exact Ideal.pow_right_mono (Ideal.map_le_iff_le_comap.mpr hmapg) 2
      have h1 : g f₀ ∈ IsLocalRing.maximalIdeal S ^ 2 := h2 (Ideal.mem_map_of_mem g h)
      have hπm : g f₀ ∈ IsLocalRing.maximalIdeal S := by
        rw [hunif]; exact Ideal.mem_span_singleton_self _
      rw [hunif, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at h1
      obtain ⟨c, hc⟩ := h1
      have hcm : c * g f₀ ∈ nonunits S :=
        (IsLocalRing.mem_maximalIdeal _).mp (Ideal.mul_mem_left _ c hπm)
      have hu := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ hcm
      have h3 : g f₀ * (1 - c * g f₀) = 0 := by linear_combination -hc
      have h4 : g f₀ = 0 := hu.mul_left_eq_zero.mp h3
      apply hS0
      rw [hunif, h4, Ideal.span_singleton_eq_bot]
    have hlin : LinearIndependent (IsLocalRing.ResidueField (X.presheaf.stalk y))
        (fun i : Fin 1 => (IsLocalRing.maximalIdeal (X.presheaf.stalk y)).toCotangent
          ((fun _ : Fin 1 => (⟨f₀, hf₀m⟩ : IsLocalRing.maximalIdeal (X.presheaf.stalk y))) i)) := by
      rw [linearIndependent_unique_iff]
      intro h0
      exact hf₀sq ((Ideal.toCotangent_eq_zero _ _).mp h0)
    obtain ⟨hQreg, -⟩ := wcpa_rs_quotient_regular (X.presheaf.stalk y) 1
      (fun _ => ⟨f₀, hf₀m⟩) hlin
    have hdomQ := wcpa_regular_isDomain _ wcpa_rs_quotient_regular hQreg
    have hpr' := (Ideal.Quotient.isDomain_iff_prime _).mp hdomQ
    have hpr : (Ideal.span {f₀}).IsPrime := by
      have e : Set.range (fun _ : Fin 1 => f₀) = {f₀} := Set.range_const
      convert hpr' using 2
      exact e.symm
    haveI : IsDomain (X.presheaf.stalk y) := wcpa_regular_isDomain _ wcpa_rs_quotient_regular hreg

    have hcomap : (IsLocalRing.maximalIdeal A').comap α = Ideal.span {f₀} := by
      apply le_antisymm
      · haveI := hpr
        let 𝔯 : PrimeSpectrum ↑Γ(X, W) :=
          ⟨(Ideal.span {f₀}).comap (algebraMap ↑Γ(X, W) (X.presheaf.stalk y)),
            Ideal.IsPrime.comap _⟩
        have hφ𝔯 : φ ∈ 𝔯.asIdeal := by
          show algebraMap ↑Γ(X, W) (X.presheaf.stalk y) φ ∈ Ideal.span {f₀}
          rw [halg, ← hf₀def]
          exact Ideal.mem_span_singleton_self f₀
        have h𝔭𝔯 : 𝔭.asIdeal ≤ 𝔯.asIdeal := by
          have h1 : 𝔭 ≤ 𝔯 := by
            rw [PrimeSpectrum.le_iff_specializes]
            apply (hW.fromSpec.isOpenEmbedding.isInducing.specializes_iff).mp
            rw [hx']
            exact hspec _ ((star 𝔯).mpr hφ𝔯)
          exact h1
        calc (IsLocalRing.maximalIdeal A').comap α
            = Ideal.map (algebraMap ↑Γ(X, W) (X.presheaf.stalk y))
                (Ideal.comap (algebraMap ↑Γ(X, W) (X.presheaf.stalk y))
                  ((IsLocalRing.maximalIdeal A').comap α)) :=
              (IsLocalization.map_comap (hW.primeIdealOf ⟨y, hy⟩).asIdeal.primeCompl _ _).symm
          _ ≤ Ideal.map (algebraMap ↑Γ(X, W) (X.presheaf.stalk y))
                (Ideal.comap (algebraMap ↑Γ(X, W) (X.presheaf.stalk y)) (Ideal.span {f₀})) := by
              apply Ideal.map_mono
              intro r hr
              apply h𝔭𝔯
              rw [h𝔭, Ideal.mem_comap, ← hαe, ← halg]
              exact hr
          _ = Ideal.span {f₀} :=
              IsLocalization.map_comap (hW.primeIdealOf ⟨y, hy⟩).asIdeal.primeCompl _ _
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        show α f₀ ∈ IsLocalRing.maximalIdeal A'
        rw [hαf]; exact hρφm

    obtain ⟨hdom, hdvr, -⟩ :=
      wc_pfam_ltd_wt_xi_dvr (X.presheaf.stalk y) A' α hαwe f₀ hf₀0 hpr hcomap

    have hmax : IsLocalRing.maximalIdeal A' = Ideal.span {α f₀} := by
      apply le_antisymm
      · intro b hb
        obtain ⟨E, _, _, hE, β, e, hβ, he⟩ :=
          wc_lpkt_indetale_factor (X.presheaf.stalk y) A' α hαwe 1 (fun _ => b)
        set P := (IsLocalRing.maximalIdeal A').comap β with hPdef
        have hP : P.comap (algebraMap (X.presheaf.stalk y) E) = Ideal.span {f₀} := by
          rw [hPdef, Ideal.comap_comap, hβ, hcomap]
        have hunit : ∀ z : P.primeCompl, IsUnit (β z) := fun z =>
          IsLocalRing.notMem_maximalIdeal.mp z.2
        let β' : Localization.AtPrime P →+* A' := IsLocalization.lift hunit
        have hβ'e : ∀ x, β' (algebraMap E (Localization.AtPrime P) x) = β x := fun x =>
          IsLocalization.lift_eq hunit x
        haveI : P.LiesOver (Ideal.span {f₀}) := ⟨by rw [Ideal.under_def, hP]⟩
        letI : Algebra (Localization.AtPrime (Ideal.span {f₀})) (Localization.AtPrime P) :=
          (Localization.localRingHom (Ideal.span {f₀}) P (algebraMap _ E) hP.symm).toAlgebra
        haveI : IsScalarTower (X.presheaf.stalk y) (Localization.AtPrime (Ideal.span {f₀}))
            (Localization.AtPrime P) :=
          IsScalarTower.of_algebraMap_eq (fun x => by
            show _ = Localization.localRingHom (Ideal.span {f₀}) P (algebraMap _ E) hP.symm
              (algebraMap _ (Localization.AtPrime (Ideal.span {f₀})) x)
            rw [Localization.localRingHom_to_map,
              IsScalarTower.algebraMap_apply (X.presheaf.stalk y) E (Localization.AtPrime P)])
        have hmaxP : Ideal.map (algebraMap (X.presheaf.stalk y) (Localization.AtPrime P))
            (Ideal.span {f₀}) = IsLocalRing.maximalIdeal (Localization.AtPrime P) :=
          ((Algebra.isUnramifiedAt_iff_map_eq _ (Ideal.span {f₀}) P).mp inferInstance).2
        have hmaxg : IsLocalRing.maximalIdeal (Localization.AtPrime P) =
            Ideal.span {algebraMap (X.presheaf.stalk y) (Localization.AtPrime P) f₀} := by
          rw [← hmaxP, Ideal.map_span, Set.image_singleton]
        have hg : β' (algebraMap (X.presheaf.stalk y) (Localization.AtPrime P) f₀) = α f₀ := by
          rw [IsScalarTower.algebraMap_apply (X.presheaf.stalk y) E (Localization.AtPrime P),
            hβ'e, ← RingHom.comp_apply, hβ]
        have hP0 : e 0 ∈ P := by
          show β (e 0) ∈ IsLocalRing.maximalIdeal A'
          rw [he 0]; exact hb
        have h1 := (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime P) P
          (e 0)).mpr hP0
        rw [hmaxg, Ideal.mem_span_singleton'] at h1
        obtain ⟨z, hz⟩ := h1
        rw [Ideal.mem_span_singleton']
        exact ⟨β' z, by rw [← hg, ← map_mul, hz, hβ'e, he 0]⟩
      · rw [Ideal.span_le, Set.singleton_subset_iff, hαf]
        exact hρφm
    refine ⟨hdom, hdvr, ?_⟩
    rw [hmax, hαf]

  obtain ⟨_, _, _, _, _, _, _, _, hlamStr, _, _, hlamΔ, _⟩ := hH
  have hyΔ : lam (D.S j (IsLocalRing.closedPoint F'')) ∈ Δ := (hlamΔ _).mpr ⟨j, rfl⟩

  haveI : SmoothOfRelativeDimension M' (wcProjKStr F'' M') := wc_proj_space_smooth F'' M'
  have hσ : (D.S j ≫ lam) ≫ wcProjKStr F'' M' = 𝟙 _ := by
    rw [Category.assoc, hlamStr, D.hS j]
  obtain ⟨hreg, -⟩ := wc_tla_smooth_rational_stalk_regular F'' (wcProjK F'' M')
    (wcProjKStr F'' M') M' (D.S j ≫ lam) hσ (lam (D.S j (IsLocalRing.closedPoint F''))) rfl

  haveI : SmoothOfRelativeDimension 1 (wcP1Over F'').hom := wc_proj_space_smooth F'' 1
  obtain ⟨-, hdim⟩ := wc_tla_smooth_rational_stalk_regular F'' (wcP1Over F'').left
    (wcP1Over F'').hom 1 (D.S j) (D.hS j) (D.S j (IsLocalRing.closedPoint F'')) rfl
  have hS0 : IsLocalRing.maximalIdeal
      ((wcP1Over F'').left.presheaf.stalk (D.S j (IsLocalRing.closedPoint F''))) ≠ ⊥ := by
    intro h0
    have h1 := ringKrullDim_eq_zero_of_isField (IsLocalRing.isField_iff_maximalIdeal_eq.mpr h0)
    rw [h1] at hdim
    norm_num at hdim
  exact core hW Δ φ _ hy hreg _ (lam.stalkMap (D.S j (IsLocalRing.closedPoint F''))).hom hS0
    hunif hyΔ hΔW A' a hwe hx'Δ hspec aW haW

theorem wc_pcu_square_fs_iff : ∀ (K R A Rb B : Type u) [Field K] [CommRing R] [CommRing A] [CommRing Rb] [CommRing B] [IsLocalRing R] [IsLocalRing A] [IsLocalRing Rb] [IsLocalRing B] [Algebra K R] [Algebra K A] [Algebra K Rb] [Algebra K B] (ρ : R →ₐ[K] A) (lam : R →ₐ[K] Rb) (π : A →ₐ[K] B) (φ : Rb →ₐ[K] B), Function.Surjective lam → Function.Surjective π → RingHom.ker (π : A →+* B) = Ideal.map (ρ : R →+* A) (RingHom.ker (lam : R →+* Rb)) → π.comp ρ = φ.comp lam → (φ : Rb →+* B).FormallySmooth → Algebra.FormallySmooth K A → ∀ (M d e n : ℕ), Module.Free R Ω[R⁄K] → Module.Finite R Ω[R⁄K] → Module.finrank R Ω[R⁄K] = M → Module.Free A Ω[A⁄K] → Module.Finite A Ω[A⁄K] → Module.finrank A Ω[A⁄K] = d → Module.Free Rb Ω[Rb⁄K] → Module.Finite Rb Ω[Rb⁄K] → Module.finrank Rb Ω[Rb⁄K] = e → Module.Free B Ω[B⁄K] → Module.Finite B Ω[B⁄K] → Module.finrank B Ω[B⁄K] = n → ((ρ : R →+* A).FormallySmooth ↔ d + e = n + M) :=
by

  have thetaTmul : ∀ (K S S' k : Type u) [CommRing K] [CommRing S] [CommRing S'] [CommRing k]
      [Algebra K S] [Algebra K S'] [Algebra S S'] [IsScalarTower K S S'] [Algebra S k]
      [Algebra S' k] [IsScalarTower S S' k] (c : k) (s : S),
      ((KaehlerDifferential.mapBaseChange K S S').baseChange k ∘ₗ
        (TensorProduct.AlgebraTensorModule.cancelBaseChange S S' k k Ω[S⁄K]).symm.toLinearMap)
        (c ⊗ₜ[S] KaehlerDifferential.D K S s) =
        c ⊗ₜ[S'] KaehlerDifferential.D K S' (algebraMap S S' s) := by
    intro K S S' k _ _ _ _ _ _ _ _ _ _ _ c s
    rw [LinearMap.comp_apply, LinearEquiv.coe_coe,
      TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul, LinearMap.baseChange_tmul,
      KaehlerDifferential.mapBaseChange_tmul, one_smul, KaehlerDifferential.map_D]

  have c2 : ∀ (k V1 V2 W1 W2 : Type u) [Field k] [AddCommGroup V1] [Module k V1]
      [AddCommGroup V2] [Module k V2] [AddCommGroup W1] [Module k W1] [AddCommGroup W2]
      [Module k W2] [FiniteDimensional k V1] [FiniteDimensional k V2] [FiniteDimensional k W1]
      [FiniteDimensional k W2] (T : V1 →ₗ[k] V2) (Tb : W1 →ₗ[k] W2) (π1 : V1 →ₗ[k] W1)
      (π2 : V2 →ₗ[k] W2), Function.Injective Tb → Function.Surjective π1 →
      Function.Surjective π2 → π2 ∘ₗ T = Tb ∘ₗ π1 →
      LinearMap.ker π2 ≤ Submodule.map T (LinearMap.ker π1) →
      (Function.Injective T ↔ Module.finrank k V1 + Module.finrank k W2 =
        Module.finrank k V2 + Module.finrank k W1) := by
    intro k V1 V2 W1 W2 _ _ _ _ _ _ _ _ _ _ _ _ _ T Tb π1 π2 hTb h1 h2 hc hk
    have hcx : ∀ x, π2 (T x) = Tb (π1 x) := fun x => LinearMap.congr_fun hc x
    have hmap : Submodule.map T (LinearMap.ker π1) = LinearMap.ker π2 := by
      refine le_antisymm ?_ hk
      rintro _ ⟨x, hx, rfl⟩
      rw [SetLike.mem_coe, LinearMap.mem_ker] at hx
      rw [LinearMap.mem_ker, hcx, hx, map_zero]
    have hkerT : LinearMap.ker T ≤ LinearMap.ker π1 := by
      intro x hx
      rw [LinearMap.mem_ker] at hx ⊢
      apply hTb
      rw [← hcx, hx, map_zero, map_zero]
    have r1 := LinearMap.finrank_range_add_finrank_ker π1
    have r2 := LinearMap.finrank_range_add_finrank_ker π2
    have r3 := LinearMap.finrank_range_add_finrank_ker (T.domRestrict (LinearMap.ker π1))
    rw [LinearMap.range_eq_top.mpr h1, finrank_top] at r1
    rw [LinearMap.range_eq_top.mpr h2, finrank_top] at r2
    rw [LinearMap.range_domRestrict, hmap] at r3
    have key : Function.Injective T ↔
        Function.Injective (T.domRestrict (LinearMap.ker π1)) := by
      constructor
      · intro hT a b hab
        exact Subtype.ext (hT hab)
      · intro hT'
        rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
        intro x hx
        have hx1 : x ∈ LinearMap.ker π1 := hkerT hx
        have h0 : T.domRestrict (LinearMap.ker π1) ⟨x, hx1⟩ = 0 := hx
        have := hT' (h0.trans (map_zero _).symm)
        exact congrArg Subtype.val this
    rw [key, ← LinearMap.ker_eq_bot, ← Submodule.finrank_eq_zero]
    omega

  have c1' : ∀ (K S B : Type u) [CommRing K] [CommRing S] [CommRing B] [Algebra K S]
      [Algebra K B] [Algebra S B] [IsScalarTower K S B], Algebra.FormallySmooth S B →
      ∃ l : Ω[B⁄K] →ₗ[B] TensorProduct S B Ω[S⁄K],
        l ∘ₗ KaehlerDifferential.mapBaseChange K S B = LinearMap.id := by
    intro K S B _ _ _ _ _ _ _ h
    haveI := h
    have hinj : Function.Injective (KaehlerDifferential.mapBaseChange K S B) := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro x hx
      obtain ⟨y, rfl⟩ := (Algebra.H1Cotangent.exact_δ_mapBaseChange K S B x).mp hx
      rw [Subsingleton.elim y 0, map_zero]
    obtain ⟨s, hs⟩ := Module.projective_lifting_property (KaehlerDifferential.map K S B B)
      LinearMap.id (KaehlerDifferential.map_surjective K S B)
    have htfae := (KaehlerDifferential.exact_mapBaseChange_map K S B).split_tfae hinj
      (KaehlerDifferential.map_surjective K S B)
    have h12 : (∃ l, KaehlerDifferential.map K S B B ∘ₗ l = LinearMap.id) ↔
        (∃ l, l ∘ₗ KaehlerDifferential.mapBaseChange K S B = LinearMap.id) := htfae.out 1 2
    exact h12.mp ⟨s, hs⟩

  have c1 : ∀ (K R A k : Type u) [CommRing K] [CommRing R] [CommRing A] [IsLocalRing A]
      [Field k] [Algebra K R] [Algebra K A] [Algebra R A] [IsScalarTower K R A] [Algebra A k],
      Function.Surjective (algebraMap A k) → Algebra.FormallySmooth K A →
      Module.Free A Ω[A⁄K] → Module.Finite A Ω[A⁄K] → Module.Finite R Ω[R⁄K] →
      Function.Injective ((KaehlerDifferential.mapBaseChange K R A).baseChange k) →
      Algebra.FormallySmooth R A := by
    intro K R A k _ _ _ _ _ _ _ _ _ _ hσ hA hfr hfi hfiR hinj
    set f := KaehlerDifferential.mapBaseChange K R A with hf
    have hmax : RingHom.ker (algebraMap A k) = IsLocalRing.maximalIdeal A :=
      IsLocalRing.eq_maximalIdeal (RingHom.ker_isMaximal_of_surjective _ hσ)
    let ψ : IsLocalRing.ResidueField A →ₐ[A] k :=
      Ideal.Quotient.liftₐ (IsLocalRing.maximalIdeal A) (Algebra.ofId A k) (fun a ha => by
        rw [← hmax] at ha; exact ha)
    have hψinj : Function.Injective ψ := RingHom.injective ψ.toRingHom
    have hψsurj : Function.Surjective ψ := by
      intro y
      obtain ⟨a, rfl⟩ := hσ y
      exact ⟨IsLocalRing.residue A a, rfl⟩
    let ε : IsLocalRing.ResidueField A ≃ₗ[A] k :=
      LinearEquiv.ofBijective ψ.toLinearMap ⟨hψinj, hψsurj⟩
    have hinj' : Function.Injective (LinearMap.lTensor k f) := by
      rw [← LinearMap.baseChange_eq_ltensor]; exact hinj
    have hrinj : ∀ (P : Type u) [AddCommGroup P] [Module A P],
        Function.Injective (LinearMap.rTensor P ε.toLinearMap) := by
      intro P _ _
      have : LinearMap.rTensor P ε.symm.toLinearMap ∘ₗ LinearMap.rTensor P ε.toLinearMap =
          LinearMap.id := by
        rw [← LinearMap.rTensor_comp, LinearEquiv.symm_comp, LinearMap.rTensor_id]
      exact Function.LeftInverse.injective (g := LinearMap.rTensor P ε.symm.toLinearMap)
        (fun x => LinearMap.congr_fun this x)
    have hκ : Function.Injective (LinearMap.lTensor (IsLocalRing.ResidueField A) f) := by
      have hsq : LinearMap.rTensor Ω[A⁄K] ε.toLinearMap ∘ₗ
          LinearMap.lTensor (IsLocalRing.ResidueField A) f =
          LinearMap.lTensor k f ∘ₗ
            LinearMap.rTensor (TensorProduct R A Ω[R⁄K]) ε.toLinearMap := by
        rw [LinearMap.rTensor_comp_lTensor, LinearMap.lTensor_comp_rTensor]
      intro x y hxy
      apply hrinj (TensorProduct R A Ω[R⁄K])
      apply hinj'
      have := congrArg (LinearMap.rTensor Ω[A⁄K] ε.toLinearMap) hxy
      rw [← LinearMap.comp_apply (LinearMap.lTensor k f),
        ← LinearMap.comp_apply (LinearMap.lTensor k f), ← hsq]
      exact this
    haveI := hfr
    haveI := hfi
    haveI := hfiR
    haveI := hA
    haveI : Module.Finite A (TensorProduct R A Ω[R⁄K]) := Module.Finite.base_change R A Ω[R⁄K]
    obtain ⟨l, hl⟩ := (IsLocalRing.split_injective_iff_lTensor_residueField_injective f).mpr hκ
    have hfinj : Function.Injective f :=
      Function.LeftInverse.injective (g := l) (fun x => LinearMap.congr_fun hl x)
    haveI hH1 : Subsingleton (Algebra.H1Cotangent R A) := by
      constructor
      suffices h0 : ∀ x : Algebra.H1Cotangent R A, x = 0 by
        intro x y; rw [h0 x, h0 y]
      intro x
      have h1 : Algebra.H1Cotangent.δ K R A x = 0 := by
        apply hfinj
        rw [map_zero]
        exact (Algebra.H1Cotangent.exact_δ_mapBaseChange K R A _).mpr ⟨x, rfl⟩
      obtain ⟨y, rfl⟩ := (Algebra.H1Cotangent.exact_map_δ K R A x).mp h1
      rw [Subsingleton.elim y 0, map_zero]
    have htfae := (KaehlerDifferential.exact_mapBaseChange_map K R A).split_tfae hfinj
      (KaehlerDifferential.map_surjective K R A)
    have h12 : (∃ l, KaehlerDifferential.map K R A A ∘ₗ l = LinearMap.id) ↔
        (∃ l, l ∘ₗ KaehlerDifferential.mapBaseChange K R A = LinearMap.id) := htfae.out 1 2
    obtain ⟨s, hs⟩ := h12.mpr ⟨l, hl⟩
    haveI : Module.Projective A Ω[A⁄R] := Module.Projective.of_split s _ hs
    exact Algebra.FormallySmooth.mk inferInstance inferInstance

  have f4 : ∀ (K A B k : Type u) [CommRing K] [CommRing A] [CommRing B] [CommRing k]
      [Algebra K A] [Algebra K B] [Algebra A B] [IsScalarTower K A B] [Algebra A k]
      [Algebra B k] [IsScalarTower A B k], Function.Surjective (algebraMap A B) →
      LinearMap.ker ((KaehlerDifferential.mapBaseChange K A B).baseChange k ∘ₗ
        (TensorProduct.AlgebraTensorModule.cancelBaseChange A B k k Ω[A⁄K]).symm.toLinearMap) ≤
      Submodule.span k (Set.range fun j : RingHom.ker (algebraMap A B) =>
        TensorProduct.tmul A (1 : k) (KaehlerDifferential.D K A (j : A))) := by
    intro K A B k _ _ _ _ _ _ _ _ _ _ _ hsurj
    have h1 : ∀ w ∈ LinearMap.ker (KaehlerDifferential.mapBaseChange K A B),
        ∃ j : RingHom.ker (algebraMap A B), w = 1 ⊗ₜ[A] KaehlerDifferential.D K A (j : A) := by
      intro w hw
      obtain ⟨z, rfl⟩ :=
        (KaehlerDifferential.exact_kerCotangentToTensor_mapBaseChange K A B hsurj w).mp hw
      obtain ⟨j, rfl⟩ := Ideal.toCotangent_surjective _ z
      exact ⟨j, KaehlerDifferential.kerCotangentToTensor_toCotangent K A B j⟩
    have hex : Function.Exact (LinearMap.ker (KaehlerDifferential.mapBaseChange K A B)).subtype
        (KaehlerDifferential.mapBaseChange K A B) :=
      LinearMap.exact_subtype_ker_map (KaehlerDifferential.mapBaseChange K A B)
    have h2 := lTensor_exact (M := LinearMap.ker (KaehlerDifferential.mapBaseChange K A B)) k hex
      (KaehlerDifferential.mapBaseChange_surjective K A B hsurj)
    intro x hx
    rw [LinearMap.mem_ker, LinearMap.comp_apply, LinearMap.baseChange_eq_ltensor] at hx
    obtain ⟨y, hy⟩ := (h2 _).mp hx
    have hx' : x = TensorProduct.AlgebraTensorModule.cancelBaseChange A B k k Ω[A⁄K]
        (LinearMap.lTensor k
          (LinearMap.ker (KaehlerDifferential.mapBaseChange K A B)).subtype y) := by
      rw [hy]; simp
    rw [hx']
    clear hx' hy hx
    induction y using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero]; exact zero_mem _
    | tmul c w =>
      obtain ⟨j, hj⟩ := h1 w w.2
      rw [LinearMap.lTensor_tmul, Submodule.coe_subtype, hj,
        TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul, one_smul]
      have : c ⊗ₜ[A] KaehlerDifferential.D K A (j : A) =
          c • ((1 : k) ⊗ₜ[A] KaehlerDifferential.D K A (j : A)) := by
        rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
      rw [this]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
    | add y z hy hz => rw [map_add, map_add]; exact add_mem hy hz

  have f5 : ∀ (K R A Rb k : Type u) [CommRing K] [CommRing R] [CommRing A] [CommRing Rb]
      [CommRing k] [Algebra K R] [Algebra K A] [Algebra K Rb] [Algebra R A] [Algebra R Rb]
      [IsScalarTower K R A] [IsScalarTower K R Rb] [Algebra R k] [Algebra A k] [Algebra Rb k]
      [IsScalarTower R A k] [IsScalarTower R Rb k],
      (∀ j ∈ Ideal.map (algebraMap R A) (RingHom.ker (algebraMap R Rb)),
        algebraMap A k j = 0) →
      ∀ j ∈ Ideal.map (algebraMap R A) (RingHom.ker (algebraMap R Rb)),
        TensorProduct.tmul A (1 : k) (KaehlerDifferential.D K A j) ∈
        Submodule.map ((KaehlerDifferential.mapBaseChange K R A).baseChange k ∘ₗ
          (TensorProduct.AlgebraTensorModule.cancelBaseChange R A k k Ω[R⁄K]).symm.toLinearMap)
          (LinearMap.ker ((KaehlerDifferential.mapBaseChange K R Rb).baseChange k ∘ₗ
            (TensorProduct.AlgebraTensorModule.cancelBaseChange R Rb k k
              Ω[R⁄K]).symm.toLinearMap)) := by
    intro K R A Rb k _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hz j hj
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hj
    · rintro x ⟨a, ha, rfl⟩
      refine ⟨(1 : k) ⊗ₜ[R] KaehlerDifferential.D K R a, ?_, ?_⟩
      · rw [SetLike.mem_coe, LinearMap.mem_ker, thetaTmul]
        rw [SetLike.mem_coe, RingHom.mem_ker] at ha
        rw [ha, map_zero, TensorProduct.tmul_zero]
      · rw [thetaTmul]
    · rw [map_zero, TensorProduct.tmul_zero]; exact zero_mem _
    · intro x y _ _ hx hy
      rw [map_add, TensorProduct.tmul_add]; exact add_mem hx hy
    · intro a x hxm hx
      rw [smul_eq_mul, Derivation.leibniz, TensorProduct.tmul_add]
      have e1 : (1 : k) ⊗ₜ[A] (a • KaehlerDifferential.D K A x) =
          (algebraMap A k a) • ((1 : k) ⊗ₜ[A] KaehlerDifferential.D K A x) := by
        rw [← TensorProduct.smul_tmul, TensorProduct.smul_tmul', smul_eq_mul, mul_one,
          Algebra.algebraMap_eq_smul_one]
      have e2 : (1 : k) ⊗ₜ[A] (x • KaehlerDifferential.D K A a) = 0 := by
        rw [← TensorProduct.smul_tmul, ← Algebra.algebraMap_eq_smul_one, hz x hxm,
          TensorProduct.zero_tmul]
      rw [e1, e2, add_zero]
      exact Submodule.smul_mem _ _ hx

  have f6 : ∀ (K R A Rb B k : Type u) [CommRing K] [CommRing R] [CommRing A] [CommRing Rb]
      [CommRing B] [CommRing k] [Algebra K R] [Algebra K A] [Algebra K Rb] [Algebra K B]
      [Algebra R A] [Algebra R Rb] [Algebra A B] [Algebra Rb B] [IsScalarTower K R A]
      [IsScalarTower K R Rb] [IsScalarTower K A B] [IsScalarTower K Rb B] [Algebra R k]
      [Algebra A k] [Algebra Rb k] [Algebra B k] [IsScalarTower R A k] [IsScalarTower R Rb k]
      [IsScalarTower A B k] [IsScalarTower Rb B k],
      (algebraMap A B).comp (algebraMap R A) = (algebraMap Rb B).comp (algebraMap R Rb) →
      ((KaehlerDifferential.mapBaseChange K A B).baseChange k ∘ₗ
        (TensorProduct.AlgebraTensorModule.cancelBaseChange A B k k Ω[A⁄K]).symm.toLinearMap) ∘ₗ
      ((KaehlerDifferential.mapBaseChange K R A).baseChange k ∘ₗ
        (TensorProduct.AlgebraTensorModule.cancelBaseChange R A k k Ω[R⁄K]).symm.toLinearMap) =
      ((KaehlerDifferential.mapBaseChange K Rb B).baseChange k ∘ₗ
        (TensorProduct.AlgebraTensorModule.cancelBaseChange Rb B k k
          Ω[Rb⁄K]).symm.toLinearMap) ∘ₗ
      ((KaehlerDifferential.mapBaseChange K R Rb).baseChange k ∘ₗ
        (TensorProduct.AlgebraTensorModule.cancelBaseChange R Rb k k
          Ω[R⁄K]).symm.toLinearMap) := by
    intro K R A Rb B k _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ hsq
    apply LinearMap.ext
    intro x
    induction x using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero]
    | add x y hx hy => rw [map_add, map_add, hx, hy]
    | tmul c ω =>
      have hω : ω ∈ Submodule.span R (Set.range (KaehlerDifferential.D K R)) := by
        rw [KaehlerDifferential.span_range_derivation]; trivial
      induction hω using Submodule.span_induction generalizing c with
      | mem w hw =>
        obtain ⟨r, rfl⟩ := hw
        rw [LinearMap.comp_apply, thetaTmul, thetaTmul, LinearMap.comp_apply, thetaTmul,
          thetaTmul]
        have := RingHom.congr_fun hsq r
        simp only [RingHom.comp_apply] at this
        rw [this]
      | zero => rw [TensorProduct.tmul_zero, map_zero, map_zero]
      | add x y _ _ hx hy => rw [TensorProduct.tmul_add, map_add, map_add, hx, hy]
      | smul s w _ hw => rw [← TensorProduct.smul_tmul, hw]

  have thetaSurj : ∀ (K S S' k : Type u) [CommRing K] [CommRing S] [CommRing S'] [CommRing k]
      [Algebra K S] [Algebra K S'] [Algebra S S'] [IsScalarTower K S S'] [Algebra S k]
      [Algebra S' k] [IsScalarTower S S' k], Function.Surjective (algebraMap S S') →
      Function.Surjective ((KaehlerDifferential.mapBaseChange K S S').baseChange k ∘ₗ
        (TensorProduct.AlgebraTensorModule.cancelBaseChange S S' k k Ω[S⁄K]).symm.toLinearMap) := by
    intro K S S' k _ _ _ _ _ _ _ _ _ _ _ h
    rw [LinearMap.coe_comp, LinearMap.baseChange_eq_ltensor]
    exact (LinearMap.lTensor_surjective k
      (KaehlerDifferential.mapBaseChange_surjective K S S' h)).comp (LinearEquiv.surjective _)
  have thetaInj : ∀ (K S S' k : Type u) [CommRing K] [CommRing S] [CommRing S'] [CommRing k]
      [Algebra K S] [Algebra K S'] [Algebra S S'] [IsScalarTower K S S'] [Algebra S k]
      [Algebra S' k] [IsScalarTower S S' k],
      (∃ l : Ω[S'⁄K] →ₗ[S'] TensorProduct S S' Ω[S⁄K],
        l ∘ₗ KaehlerDifferential.mapBaseChange K S S' = LinearMap.id) →
      Function.Injective ((KaehlerDifferential.mapBaseChange K S S').baseChange k ∘ₗ
        (TensorProduct.AlgebraTensorModule.cancelBaseChange S S' k k Ω[S⁄K]).symm.toLinearMap) := by
    intro K S S' k _ _ _ _ _ _ _ _ _ _ _ h
    obtain ⟨l, hl⟩ := h
    have hbc : Function.Injective ((KaehlerDifferential.mapBaseChange K S S').baseChange k) := by
      have : l.baseChange k ∘ₗ (KaehlerDifferential.mapBaseChange K S S').baseChange k =
          LinearMap.id := by
        rw [← LinearMap.baseChange_comp, hl, LinearMap.baseChange_id]
      exact Function.LeftInverse.injective (g := l.baseChange k)
        (fun x => LinearMap.congr_fun this x)
    rw [LinearMap.coe_comp]
    exact hbc.comp (LinearEquiv.injective _)
  have thetaInj' : ∀ (K S S' k : Type u) [CommRing K] [CommRing S] [CommRing S'] [CommRing k]
      [Algebra K S] [Algebra K S'] [Algebra S S'] [IsScalarTower K S S'] [Algebra S k]
      [Algebra S' k] [IsScalarTower S S' k],
      Function.Injective ((KaehlerDifferential.mapBaseChange K S S').baseChange k ∘ₗ
        (TensorProduct.AlgebraTensorModule.cancelBaseChange S S' k k Ω[S⁄K]).symm.toLinearMap) →
      Function.Injective ((KaehlerDifferential.mapBaseChange K S S').baseChange k) := by
    intro K S S' k _ _ _ _ _ _ _ _ _ _ _ h x y hxy
    apply (TensorProduct.AlgebraTensorModule.cancelBaseChange S S' k k Ω[S⁄K]).injective
    apply h
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply]
    exact hxy

  intro K R A Rb B _ _ _ _ _ _ _ _ _ _ _ _ _ ρ lam π φ hlam hπ hker hcomm hφ hA M d e n
    frR fiR rkR frA fiA rkA frRb fiRb rkRb frB fiB rkB
  letI : Algebra R A := (ρ : R →+* A).toAlgebra
  letI : Algebra R Rb := (lam : R →+* Rb).toAlgebra
  letI : Algebra A B := (π : A →+* B).toAlgebra
  letI : Algebra Rb B := (φ : Rb →+* B).toAlgebra
  haveI : IsScalarTower K R A := IsScalarTower.of_algebraMap_eq (fun c => (ρ.commutes c).symm)
  haveI : IsScalarTower K R Rb := IsScalarTower.of_algebraMap_eq (fun c => (lam.commutes c).symm)
  haveI : IsScalarTower K A B := IsScalarTower.of_algebraMap_eq (fun c => (π.commutes c).symm)
  haveI : IsScalarTower K Rb B := IsScalarTower.of_algebraMap_eq (fun c => (φ.commutes c).symm)
  letI : Algebra R (IsLocalRing.ResidueField B) :=
    ((algebraMap A (IsLocalRing.ResidueField B)).comp (ρ : R →+* A)).toAlgebra
  haveI : IsScalarTower R A (IsLocalRing.ResidueField B) :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hsq : ∀ x : R, π (ρ x) = φ (lam x) := fun x => AlgHom.congr_fun hcomm x
  haveI : IsScalarTower R Rb (IsLocalRing.ResidueField B) :=
    IsScalarTower.of_algebraMap_eq (fun x => by
      show algebraMap A (IsLocalRing.ResidueField B) (ρ x) =
        algebraMap Rb (IsLocalRing.ResidueField B) (lam x)
      rw [IsScalarTower.algebraMap_apply A B (IsLocalRing.ResidueField B),
        IsScalarTower.algebraMap_apply Rb B (IsLocalRing.ResidueField B)]
      show algebraMap B (IsLocalRing.ResidueField B) (π (ρ x)) =
        algebraMap B (IsLocalRing.ResidueField B) (φ (lam x))
      rw [hsq])
  have dR : Module.finrank (IsLocalRing.ResidueField B)
      (TensorProduct R (IsLocalRing.ResidueField B) Ω[R⁄K]) = M := by
    rw [Module.finrank_baseChange, rkR]
  have dA : Module.finrank (IsLocalRing.ResidueField B)
      (TensorProduct A (IsLocalRing.ResidueField B) Ω[A⁄K]) = d := by
    rw [Module.finrank_baseChange, rkA]
  have dRb : Module.finrank (IsLocalRing.ResidueField B)
      (TensorProduct Rb (IsLocalRing.ResidueField B) Ω[Rb⁄K]) = e := by
    rw [Module.finrank_baseChange, rkRb]
  have dB : Module.finrank (IsLocalRing.ResidueField B)
      (TensorProduct B (IsLocalRing.ResidueField B) Ω[B⁄K]) = n := by
    rw [Module.finrank_baseChange, rkB]
  have s1 := thetaSurj K R Rb (IsLocalRing.ResidueField B) hlam
  have s2 := thetaSurj K A B (IsLocalRing.ResidueField B) hπ
  have hφ' : Algebra.FormallySmooth Rb B := RingHom.FormallySmooth.toAlgebra hφ
  have iTb := thetaInj K Rb B (IsLocalRing.ResidueField B) (c1' K Rb B hφ')
  have hcomm' : (algebraMap A B).comp (algebraMap R A) =
      (algebraMap Rb B).comp (algebraMap R Rb) := RingHom.ext hsq
  have hc := f6 K R A Rb B (IsLocalRing.ResidueField B) hcomm'
  have hz : ∀ j ∈ Ideal.map (algebraMap R A) (RingHom.ker (algebraMap R Rb)),
      algebraMap A (IsLocalRing.ResidueField B) j = 0 := by
    intro j hj
    have hj' : j ∈ Ideal.map (ρ : R →+* A) (RingHom.ker (lam : R →+* Rb)) := hj
    rw [← hker] at hj'
    have h0 : algebraMap A B j = 0 := RingHom.mem_ker.mp hj'
    rw [IsScalarTower.algebraMap_apply A B (IsLocalRing.ResidueField B), h0, map_zero]
  have hk := (f4 K A B (IsLocalRing.ResidueField B) hπ).trans (Submodule.span_le.mpr (by
    rintro _ ⟨j, rfl⟩
    have hj : (j : A) ∈ RingHom.ker (π : A →+* B) := j.2
    rw [hker] at hj
    exact f5 K R A Rb (IsLocalRing.ResidueField B) hz (j : A) hj))
  have key := c2 (IsLocalRing.ResidueField B) _ _ _ _ _ _ _ _ iTb s1 s2 hc hk
  rw [dR, dA, dRb, dB] at key
  constructor
  · intro hρ
    have hρ' : Algebra.FormallySmooth R A := RingHom.FormallySmooth.toAlgebra hρ
    have := key.mp (thetaInj K R A (IsLocalRing.ResidueField B) (c1' K R A hρ'))
    omega
  · intro hdim
    have hT := key.mpr (by omega)
    have hσ : Function.Surjective (algebraMap A (IsLocalRing.ResidueField B)) := by
      rw [IsScalarTower.algebraMap_eq A B (IsLocalRing.ResidueField B), RingHom.coe_comp]
      exact IsLocalRing.residue_surjective.comp hπ
    have hfs := c1 K R A (IsLocalRing.ResidueField B) hσ hA frA fiA fiR
      (thetaInj' K R A (IsLocalRing.ResidueField B) hT)
    exact RingHom.formallySmooth_algebraMap.mpr hfs

theorem wc_pcu_stalk_square_fs_iff : ∀ (K : Type u) [Field K] {T Z L Y : Scheme.{u}} (p : T ⟶ Z) (f : T ⟶ L) (h : Z ⟶ Y) (lam : L ⟶ Y) (sT : T ⟶ Spec (.of K)) (sZ : Z ⟶ Spec (.of K)) (sL : L ⟶ Spec (.of K)) (sY : Y ⟶ Spec (.of K)) (n d e M : ℕ), SmoothOfRelativeDimension n sT → SmoothOfRelativeDimension d sZ → SmoothOfRelativeDimension e sL → SmoothOfRelativeDimension M sY → IsPullback p f h lam → IsClosedImmersion lam → h ≫ sY = sZ → lam ≫ sY = sL → f ≫ sL = sT → ∀ ξ : T, (f.stalkMap ξ).hom.FormallySmooth → ((h.stalkMap (p ξ)).hom.FormallySmooth ↔ d + e = n + M) :=
by
  intro K _ T Z L Y p f h lam sT sZ sL sY n d e M hT hZ hL hY hpb hlam hhS hlamS hfS ξ hfFS
  have app : ∀ {X W : Scheme.{u}} {g g' : X ⟶ W}, g = g' → ∀ x, g x = g' x :=
    fun hgg x => hgg ▸ rfl
  have w : p ≫ h = f ≫ lam := hpb.w
  have e₀ : h (p ξ) = lam (f ξ) := app w ξ
  have hpZ : p ≫ sZ = sT := by
    rw [← hhS, ← Category.assoc, w, Category.assoc, hlamS, hfS]

  have c1 : ∀ {X W : Scheme.{u}} (g : X ⟶ W) (sX : X ⟶ Spec (.of K)) (sW : W ⟶ Spec (.of K)),
      g ≫ sW = sX → ∀ (x : X) (c : K),
      (g.stalkMap x).hom (wcLdpConst K sW (g x) c) = wcLdpConst K sX x c := by
    intro X W g sX sW hg x c
    subst hg
    simp only [wcLdpConst, RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
    exact Scheme.Hom.germ_stalkMap_apply g ⊤ x trivial _

  have c2 : ∀ (y y' : Y) (hyy : y ⤳ y') (c : K),
      (Y.presheaf.stalkSpecializes hyy).hom (wcLdpConst K sY y' c) = wcLdpConst K sY y c := by
    intro y y' hyy c
    simp only [wcLdpConst, RingHom.comp_apply]
    exact TopCat.Presheaf.germ_stalkSpecializes_apply Y.presheaf (U := ⊤) (y := y') trivial hyy _

  have key : Y.presheaf.stalkSpecializes (specializes_of_eq e₀) ≫ h.stalkMap (p ξ) ≫
      p.stalkMap ξ = lam.stalkMap (f ξ) ≫ f.stalkMap ξ := by
    have hrefl : ∀ (y : Y) (hs : y ⤳ y), Y.presheaf.stalkSpecializes hs = 𝟙 _ :=
      fun y hs => TopCat.Presheaf.stalkSpecializes_refl _ y
    rw [← Scheme.Hom.stalkMap_comp, Scheme.Hom.stalkMap_congr_hom (p ≫ h) (f ≫ lam) w,
      TopCat.Presheaf.stalkCongr_hom, Scheme.Hom.stalkMap_comp]
    erw [TopCat.Presheaf.stalkSpecializes_comp_assoc, hrefl, Category.id_comp]
  have hcomm : (p.stalkMap ξ).hom.comp (wcLdnmTvRho h (p ξ) (lam (f ξ)) e₀) =
      (f.stalkMap ξ).hom.comp (lam.stalkMap (f ξ)).hom :=
    congrArg CommRingCat.Hom.hom key

  have hP2 : ∀ (y : Y) (ee : h (p ξ) = y), (wcLdnmTvRho h (p ξ) y ee).FormallySmooth ↔
      (h.stalkMap (p ξ)).hom.FormallySmooth := by
    intro y ee
    subst ee
    simp only [wcLdnmTvRho, TopCat.Presheaf.stalkSpecializes_refl, CommRingCat.hom_id,
      RingHom.comp_id]

  haveI := hT
  haveI := hZ
  haveI := hL
  haveI := hY
  letI iR : Algebra K (Y.presheaf.stalk (lam (f ξ))) := (wcLdpConst K sY (lam (f ξ))).toAlgebra
  letI iA : Algebra K (Z.presheaf.stalk (p ξ)) := (wcLdpConst K sZ (p ξ)).toAlgebra
  letI iRb : Algebra K (L.presheaf.stalk (f ξ)) := (wcLdpConst K sL (f ξ)).toAlgebra
  letI iB : Algebra K (T.presheaf.stalk ξ) := (wcLdpConst K sT ξ).toAlgebra
  obtain ⟨-, frR, fiR, rkR, -⟩ := wc_ldp_il_stalk_of_smooth_field K sY M (lam (f ξ))
  obtain ⟨fsA, frA, fiA, rkA, -⟩ := wc_ldp_il_stalk_of_smooth_field K sZ d (p ξ)
  obtain ⟨-, frRb, fiRb, rkRb, -⟩ := wc_ldp_il_stalk_of_smooth_field K sL e (f ξ)
  obtain ⟨-, frB, fiB, rkB, -⟩ := wc_ldp_il_stalk_of_smooth_field K sT n ξ

  let ρ : Y.presheaf.stalk (lam (f ξ)) →ₐ[K] Z.presheaf.stalk (p ξ) :=
    { toRingHom := wcLdnmTvRho h (p ξ) (lam (f ξ)) e₀
      commutes' := fun c => by
        show wcLdnmTvRho h (p ξ) (lam (f ξ)) e₀ (wcLdpConst K sY (lam (f ξ)) c) =
          wcLdpConst K sZ (p ξ) c
        simp only [wcLdnmTvRho, RingHom.comp_apply]
        rw [c2, c1 h sZ sY hhS] }
  let lm : Y.presheaf.stalk (lam (f ξ)) →ₐ[K] L.presheaf.stalk (f ξ) :=
    { toRingHom := (lam.stalkMap (f ξ)).hom
      commutes' := fun c => c1 lam sL sY hlamS (f ξ) c }
  let πa : Z.presheaf.stalk (p ξ) →ₐ[K] T.presheaf.stalk ξ :=
    { toRingHom := (p.stalkMap ξ).hom
      commutes' := fun c => c1 p sT sZ hpZ ξ c }
  let φa : L.presheaf.stalk (f ξ) →ₐ[K] T.presheaf.stalk ξ :=
    { toRingHom := (f.stalkMap ξ).hom
      commutes' := fun c => c1 f sT sL hfS ξ c }
  obtain ⟨hπs, hker⟩ := wc_ldnm_tvj_pullback_stalk p f h lam hpb hlam ξ (f ξ) rfl e₀
  have hlams : Function.Surjective (lam.stalkMap (f ξ)).hom :=
    SurjectiveOnStalks.stalkMap_surjective lam (f ξ)
  have hC3 := wc_pcu_square_fs_iff K _ _ _ _ ρ lm πa φa hlams hπs hker
    (AlgHom.ext fun x => RingHom.congr_fun hcomm x) hfFS fsA M d e n frR fiR rkR frA fiA rkA
    frRb fiRb rkRb frB fiB rkB
  exact (hP2 _ e₀).symm.trans hC3

theorem wc_pcu_offnode_smooth : ∀ (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ), 2 ≤ n → ∀ (D : wcLefschetzDatum F' F'' Y n) (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M') (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M') (p : D.Yt.left ⟶ Xu.left), wcPfamHyp D M' Xu h Δ lam p → ∀ (j : Fin D.m) (z : Xu.left), h z = lam (D.S j (IsLocalRing.closedPoint F'')) → z ≠ p (D.xs j (IsLocalRing.closedPoint F'')) → ∃ V : Xu.left.Opens, z ∈ V ∧ Smooth (V.ι ≫ h) :=
by
  intro F' F'' _ _ _ _ Y n _hn D M' Xu h Δ lam p hH j z hz hzne
  have app : ∀ {X Z : Scheme.{u}} {f g : X ⟶ Z}, f = g → ∀ x, f x = g x :=
    fun hfg x => hfg ▸ rfl
  have hsub : ∀ s t : Spec (.of F''), s = t := fun s t => Subsingleton.elim s t
  obtain ⟨⟨d, hd⟩, hprop, hhS, _, _, _, hsm, hlamci, hlamS, _, hpb, hlamΔ, _⟩ := hH

  haveI hPs : SmoothOfRelativeDimension M' (wcProjKStr F'' M') := wc_proj_space_smooth F'' M'
  haveI : Smooth (wcProjKStr F'' M') := SmoothOfRelativeDimension.smooth M' _
  haveI : LocallyOfFiniteType (wcProjKStr F'' M') := inferInstance
  haveI : IsLocallyNoetherian (wcProjK F'' M') :=
    LocallyOfFiniteType.isLocallyNoetherian (wcProjKStr F'' M')
  haveI : IsProper h := hprop
  haveI : LocallyOfFinitePresentation h := inferInstance
  have hsq := wc_pcu_stalk_square_fs_iff F'' p D.f h lam D.Yt.hom Xu.hom (wcP1Over F'').hom
    (wcProjKStr F'' M') n d 1 M' D.smooth hd (wc_proj_space_smooth F'' 1) hPs hpb hlamci hhS
    hlamS D.hf

  have hcount : d + 1 = n + M' := by
    obtain ⟨q⟩ : Nonempty ↥(Limits.pullback D.f
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) ≫ D.u0)) :=
      (D.fconn (AlgebraicClosure F'') _).toNonempty
    have e1 : D.f (Limits.pullback.fst D.f
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) ≫ D.u0) q) =
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) ≫ D.u0)
          (Limits.pullback.snd D.f
            (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) ≫ D.u0) q) :=
      app Limits.pullback.condition q
    have e2 : (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) ≫ D.u0)
          (Limits.pullback.snd D.f
            (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) ≫ D.u0) q) =
        D.u0 (IsLocalRing.closedPoint F'') := by
      show D.u0 (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))
        (Limits.pullback.snd D.f
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) ≫ D.u0) q)) = _
      exact congrArg (fun y => D.u0 y) (hsub _ _)
    generalize Limits.pullback.fst D.f
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))) ≫ D.u0) q = w₀ at e1
    have hfw : D.f w₀ = D.u0 (IsLocalRing.closedPoint F'') := e1.trans e2
    have hw0 : ∀ i, w₀ ≠ D.xs i (IsLocalRing.closedPoint F'') := by
      intro i hi
      apply D.hu0S i
      rw [← hfw, hi]
      exact app (D.hxs i) (IsLocalRing.closedPoint F'')
    obtain ⟨U0, hU0, hU0s⟩ := D.smooth_off w₀ hw0
    have hfFS := wc_ldnm_tv_stalk_fs_of_smooth D.f w₀ U0 hU0 hU0s
    have hhw : h (p w₀) = lam (D.f w₀) := app hpb.w w₀
    have hnotΔ : h (p w₀) ∉ Δ := by
      rw [hhw, hfw, hlamΔ]
      rintro ⟨i, hi⟩
      exact D.hu0S i hi
    obtain ⟨V0, hV0, hV0s⟩ := hsm (p w₀) hnotΔ
    have hhFS := wc_ldnm_tv_stalk_fs_of_smooth h (p w₀) V0 hV0 hV0s
    exact (hsq w₀ hfFS).mp hhFS

  obtain ⟨q', hq'1, hq'2⟩ := Scheme.Pullback.exists_preimage_pullback (f := h) (g := lam) z
    (D.S j (IsLocalRing.closedPoint F'')) hz
  obtain ⟨w, hpw, hfw⟩ : ∃ w : D.Yt.left, p w = z ∧ D.f w = D.S j (IsLocalRing.closedPoint F'') :=
    ⟨hpb.isoPullback.inv q', (app hpb.isoPullback_inv_fst q').trans hq'1,
      (app hpb.isoPullback_inv_snd q').trans hq'2⟩
  subst hpw
  have hwn : ∀ i, w ≠ D.xs i (IsLocalRing.closedPoint F'') := by
    intro i hi
    have e1 : D.S i (IsLocalRing.closedPoint F'') = D.S j (IsLocalRing.closedPoint F'') := by
      rw [← hfw, hi]
      exact (app (D.hxs i) (IsLocalRing.closedPoint F'')).symm
    have hij : i = j := D.hSinj e1
    subst hij
    exact hzne (by rw [hi])
  obtain ⟨U1, hU1, hU1s⟩ := D.smooth_off w hwn
  have hfFS := wc_ldnm_tv_stalk_fs_of_smooth D.f w U1 hU1 hU1s
  have hhFS := (hsq w hfFS).mpr hcount
  exact wc_ldp_il_spread_rel h (p w) hhFS

theorem wc_pcu_flat_unram_map_radical : ∀ (O O' : Type u) [CommRing O] [CommRing O'] [IsNoetherianRing O] (f : O →+* O'), f.Flat → f.FormallyUnramified → f.EssFiniteType → ∀ (I : Ideal O), I.IsRadical → (Ideal.map f I).IsRadical :=
by
  intro O O' _ _ _ f hflat hfu heft I hI
  have core : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [_root_.IsReduced R]
      [IsNoetherianRing R] [Module.Flat R S] [Algebra.FormallyUnramified R S]
      [Algebra.EssFiniteType R S], _root_.IsReduced S := by
    intro R S _ _ _ _ _ _ _ _
    classical
    let ι : Type u := ↥((⊥ : Ideal R).minimalPrimes)
    haveI : Fintype ι := (Ideal.finite_minimalPrimes_of_isNoetherianRing R ⊥).fintype
    have hp : ∀ p : ι, p.1.IsPrime := fun p => Ideal.IsMinimalPrime.isPrime p.2
    let K : ι → Type u := fun p => p.1.ResidueField
    have hK : ∀ r : R, (∀ p : ι, algebraMap R (K p) r = 0) → r = 0 := by
      intro r hr
      have hmem : r ∈ sInf (⊥ : Ideal R).minimalPrimes := by
        rw [Ideal.mem_sInf]
        intro p hpm
        exact (@Ideal.algebraMap_residueField_eq_zero R _ p (hp ⟨p, hpm⟩) r).mp (hr ⟨p, hpm⟩)
      rw [Ideal.sInf_minimalPrimes, Ideal.mem_radical_iff] at hmem
      obtain ⟨n, hn⟩ := hmem
      exact IsReduced.eq_zero r ⟨n, by simpa using hn⟩
    let g : R →ₗ[R] (∀ p : ι, K p) := LinearMap.pi (fun p => Algebra.linearMap R (K p))
    have hg : Function.Injective g := by
      rw [injective_iff_map_eq_zero]
      intro r hr
      apply hK r
      intro p
      have := congrFun hr p
      simpa [g] using this
    have hlg : Function.Injective (LinearMap.lTensor S g) :=
      Module.Flat.lTensor_preserves_injective_linearMap g hg
    let φ : S →+* (∀ p : ι, TensorProduct R (K p) S) :=
      RingHom.pi (fun p =>
        (Algebra.TensorProduct.includeRight : S →ₐ[R] TensorProduct R (K p) S).toRingHom)
    have hφ : Function.Injective φ := by
      rw [injective_iff_map_eq_zero]
      intro s hs
      have h1 : ∀ p : ι, TensorProduct.tmul R (1 : K p) s = 0 := fun p => by
        have := congrFun hs p
        exact this
      have h1' : ∀ p : ι, TensorProduct.tmul R s (1 : K p) = 0 := fun p => by
        have := congrArg (TensorProduct.comm R (K p) S) (h1 p)
        simpa using this
      have h2 : TensorProduct.piRight R R S K
          (LinearMap.lTensor S g (TensorProduct.tmul R s (1 : R))) = 0 := by
        funext p
        rw [LinearMap.lTensor_tmul, TensorProduct.piRight_apply, TensorProduct.piRightHom_tmul]
        simpa [g] using h1' p
      have h3 : LinearMap.lTensor S g (TensorProduct.tmul R s (1 : R)) = 0 := by
        rw [← map_zero (TensorProduct.piRight R R S K)] at h2
        exact (TensorProduct.piRight R R S K).injective h2
      have h4 : TensorProduct.tmul R s (1 : R) = 0 := by
        rw [← map_zero (LinearMap.lTensor S g)] at h3
        exact hlg h3
      have h5 := congrArg (TensorProduct.rid R S) h4
      simpa using h5
    haveI : ∀ p : ι, _root_.IsReduced (TensorProduct R (K p) S) := fun p => by
      haveI : Algebra.FormallyUnramified (K p) (TensorProduct R (K p) S) :=
        Algebra.FormallyUnramified.base_change (K p)
      haveI : Algebra.EssFiniteType (K p) (TensorProduct R (K p) S) :=
        Algebra.EssFiniteType.baseChange R S (K p)
      exact Algebra.FormallyUnramified.isReduced_of_field (K p) (TensorProduct R (K p) S)
    exact isReduced_of_injective φ hφ
  letI := f.toAlgebra
  haveI : Module.Flat O O' := RingHom.flat_algebraMap_iff.mp hflat
  haveI : Algebra.FormallyUnramified O O' := RingHom.formallyUnramified_algebraMap.mp hfu
  haveI : Algebra.EssFiniteType O O' := RingHom.essFiniteType_algebraMap.mp heft
  haveI : _root_.IsReduced (O ⧸ I) := (Ideal.isRadical_iff_quotient_reduced I).mp hI
  haveI : Module.Flat (O ⧸ I) (TensorProduct O (O ⧸ I) O') :=
    Module.Flat.baseChange O (O ⧸ I) O'
  haveI : Algebra.FormallyUnramified (O ⧸ I) (TensorProduct O (O ⧸ I) O') :=
    Algebra.FormallyUnramified.base_change (O ⧸ I)
  haveI : Algebra.EssFiniteType (O ⧸ I) (TensorProduct O (O ⧸ I) O') :=
    Algebra.EssFiniteType.baseChange O O' (O ⧸ I)
  haveI hS : _root_.IsReduced (TensorProduct O (O ⧸ I) O') :=
    core (O ⧸ I) (TensorProduct O (O ⧸ I) O')
  show (Ideal.map (algebraMap O O') I).IsRadical
  rw [Ideal.isRadical_iff_quotient_reduced]
  exact isReduced_of_injective
    ((Algebra.TensorProduct.quotIdealMapEquivTensorQuot O' I).toRingEquiv.trans
      (Algebra.TensorProduct.comm O O' (O ⧸ I)).toRingEquiv).toRingHom
    (RingEquiv.injective _)

theorem wc_pcu_vanishing_ideal_le_prime : ∀ {X : Scheme.{u}} (T : Set X), IsClosed T → ∀ (z : X) (q : PrimeSpectrum (X.presheaf.stalk z)), (⨅ (x : X) (_ : x ∈ T) (hxz : x ⤳ z), RingHom.ker (X.presheaf.stalkSpecializes hxz ≫ X.residue x).hom) ≤ q.asIdeal → X.fromSpecStalk z q ∈ T :=
by
  intro X T hT z q hI
  have gen : ∀ (q' : PrimeSpectrum (X.presheaf.stalk z)) (hsp : X.fromSpecStalk z q' ⤳ z)
      (a : X.presheaf.stalk z),
      (X.presheaf.stalkSpecializes hsp).hom a ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk (X.fromSpecStalk z q')) ↔ a ∈ q'.asIdeal := by
    intro q' hsp a
    have key : (Spec.map (X.presheaf.stalkSpecializes hsp))
        (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk z q'))) = q' := by
      apply (X.fromSpecStalk z).isEmbedding.injective
      first
      | (rw [← Scheme.Hom.comp_apply, Scheme.SpecMap_stalkSpecializes_fromSpecStalk,
          Scheme.fromSpecStalk_closedPoint])
      | (show (Spec.map (X.presheaf.stalkSpecializes hsp) ≫ X.fromSpecStalk z)
            (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk z q'))) = _
         rw [Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.fromSpecStalk_closedPoint])
      | (have e := congrArg (fun k : Spec (X.presheaf.stalk (X.fromSpecStalk z q')) ⟶ X =>
            k (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk z q'))))
            (Scheme.SpecMap_stalkSpecializes_fromSpecStalk hsp)
         simp only [Scheme.Hom.comp_apply] at e
         rw [e, Scheme.fromSpecStalk_closedPoint])
    have h2 : a ∈ q'.asIdeal ↔ a ∈ ((Spec.map (X.presheaf.stalkSpecializes hsp))
        (IsLocalRing.closedPoint (X.presheaf.stalk (X.fromSpecStalk z q')))).asIdeal := by
      rw [key]
    rw [h2]
    first
    | exact Iff.rfl
    | (rw [Spec.map_base_apply]; exact Iff.rfl)
    | (rw [Scheme.Spec_map_base]; exact Iff.rfl)
    | simp [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, IsLocalRing.closedPoint]
  set S : Set (PrimeSpectrum (X.presheaf.stalk z)) := (X.fromSpecStalk z) ⁻¹' T with hSdef
  have hS : IsClosed S := hT.preimage (X.fromSpecStalk z).continuous
  have hV : PrimeSpectrum.vanishingIdeal S ≤ q.asIdeal := by
    refine le_trans ?_ hI
    intro f hf
    rw [PrimeSpectrum.mem_vanishingIdeal] at hf
    simp only [Submodule.mem_iInf]
    intro x hxT hxz
    have hx : x ∈ Set.range (X.fromSpecStalk z) := by
      rw [Scheme.range_fromSpecStalk]; exact hxz
    obtain ⟨q', rfl⟩ := hx
    have hfq : f ∈ q'.asIdeal := hf q' hxT
    have hm := (gen q' hxz f).mpr hfq
    rw [RingHom.mem_ker, CommRingCat.hom_comp, RingHom.comp_apply]
    first
    | exact (IsLocalRing.residue_eq_zero_iff _).mpr hm
    | (show IsLocalRing.residue _ _ = 0; exact (IsLocalRing.residue_eq_zero_iff _).mpr hm)
  have hq : q ∈ PrimeSpectrum.zeroLocus (PrimeSpectrum.vanishingIdeal S : Set _) :=
    (PrimeSpectrum.mem_zeroLocus _ _).mpr hV
  rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hS.closure_eq] at hq
  exact hq

theorem wc_pcu_qm_chart_stalk_maximal : ∀ (R : Type u) [CommRing R] (n : ℕ) (g : R) (c : Matrix (Fin n) (Fin n) R) {U P : Scheme.{u}} (ψ : U ⟶ Spec (.of (wcQuadModelRing R n g c))) [Etale ψ] (j : Spec (.of R) ⟶ P) [IsOpenImmersion j] (F : U ⟶ P), F = ψ ≫ wcQuadModelStr R n g c ≫ j → ∀ (s : U), (∀ q, Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.X q) ∈ (ψ s).asIdeal) → IsLocalRing.maximalIdeal (U.presheaf.stalk s) ≤ Ideal.map (F.stalkMap s).hom (IsLocalRing.maximalIdeal (P.presheaf.stalk (F s))) ⊔ Ideal.span (Set.range fun q : Fin n => (U.presheaf.Γgerm s).hom (ψ.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing R n g c))).inv.hom (Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.X q))))) :=
by

  have s1 : ∀ (R : Type u) [CommRing R] (n : ℕ) (I : Ideal (MvPolynomial (Fin n) R))
      (v : Ideal (MvPolynomial (Fin n) R ⧸ I)), (∀ q, Ideal.Quotient.mk I (MvPolynomial.X q) ∈ v) →
      v ≤ Ideal.map (algebraMap R (MvPolynomial (Fin n) R ⧸ I))
          (Ideal.comap (algebraMap R (MvPolynomial (Fin n) R ⧸ I)) v) ⊔
        Ideal.span (Set.range fun q => Ideal.Quotient.mk I (MvPolynomial.X q)) := by
    intro R _ n I v hv
    have key : ∀ F : MvPolynomial (Fin n) R, Ideal.Quotient.mk I
        (F - MvPolynomial.C (MvPolynomial.constantCoeff F)) ∈
        Ideal.span (Set.range fun q => Ideal.Quotient.mk I (MvPolynomial.X q)) := by
      intro F
      induction F using MvPolynomial.induction_on with
      | C a => simp
      | add p q hp hq =>
        have e : p + q - MvPolynomial.C (MvPolynomial.constantCoeff (p + q)) =
            (p - MvPolynomial.C (MvPolynomial.constantCoeff p)) +
              (q - MvPolynomial.C (MvPolynomial.constantCoeff q)) := by
          simp only [map_add]; ring
        rw [e, map_add]
        exact add_mem hp hq
      | mul_X p q _ =>
        have e : MvPolynomial.constantCoeff (p * MvPolynomial.X q) = 0 := by simp
        rw [e, map_zero, sub_zero, map_mul]
        exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨q, rfl⟩)
    have hSv : Ideal.span (Set.range fun q => Ideal.Quotient.mk I (MvPolynomial.X q)) ≤ v :=
      Ideal.span_le.mpr (by rintro _ ⟨q, rfl⟩; exact hv q)
    intro z hz
    obtain ⟨F, rfl⟩ := Ideal.Quotient.mk_surjective z
    have hsplit : Ideal.Quotient.mk I F =
        Ideal.Quotient.mk I (F - MvPolynomial.C (MvPolynomial.constantCoeff F)) +
          algebraMap R _ (MvPolynomial.constantCoeff F) := by
      rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, ← map_add, sub_add_cancel]
    have h1 := key F
    have h2 : algebraMap R (MvPolynomial (Fin n) R ⧸ I) (MvPolynomial.constantCoeff F) ∈ v := by
      have h3 := sub_mem hz (hSv h1)
      rwa [hsplit, add_sub_cancel_left] at h3
    rw [hsplit]
    exact add_mem (Ideal.mem_sup_right h1) (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ h2))

  have s2 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [FormallyUnramified f] [LocallyOfFiniteType f]
      (x : X), Ideal.map (f.stalkMap x).hom (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f x))) =
        IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
    intro X Y f _ _ x
    letI := (f.stalkMap x).hom.toAlgebra
    haveI : IsLocalHom (algebraMap (Y.presheaf.stalk (f x)) (X.presheaf.stalk x)) :=
      inferInstanceAs (IsLocalHom (f.stalkMap x).hom)
    haveI : Algebra.EssFiniteType (Y.presheaf.stalk (f x)) (X.presheaf.stalk x) :=
      LocallyOfFiniteType.stalkMap f x
    haveI : Algebra.FormallyUnramified (Y.presheaf.stalk (f x)) (X.presheaf.stalk x) :=
      FormallyUnramified.stalkMap f x
    exact Algebra.FormallyUnramified.map_maximalIdeal

  have s3 : ∀ (A : Type u) [CommRing A] (w : Spec (.of A)),
      IsLocalRing.maximalIdeal ((Spec (.of A)).presheaf.stalk w) =
        Ideal.map ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
          (Spec (.of A)).presheaf.Γgerm w).hom w.asIdeal := by
    intro A _ w
    haveI : w.asIdeal.IsPrime := w.isPrime
    letI : Algebra A ((Spec (.of A)).presheaf.stalk w) := StructureSheaf.stalkAlgebra A w
    haveI : IsLocalization.AtPrime ((Spec (.of A)).presheaf.stalk w) w.asIdeal :=
      StructureSheaf.IsLocalization.to_stalk A w
    exact (IsLocalization.AtPrime.map_eq_maximalIdeal w.asIdeal _).symm

  have s4 : ∀ (A B : Type u) [CommRing A] [CommRing B] (φ : A →+* B) (w : Spec (.of B)) (a : A),
      ((Spec.map (CommRingCat.ofHom φ)).stalkMap w).hom
        (((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫
          (Spec (.of A)).presheaf.Γgerm (Spec.map (CommRingCat.ofHom φ) w)).hom a) =
      ((Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ (Spec (.of B)).presheaf.Γgerm w).hom (φ a) := by
    intro A B _ _ φ w a
    have h1 := Scheme.Hom.germ_stalkMap_apply (Spec.map (CommRingCat.ofHom φ)) ⊤ w trivial
      ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom a)
    have h2 : (Spec.map (CommRingCat.ofHom φ)).appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom a) =
        (Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom (φ a) := by
      have h3 := congrArg (fun h => h.hom a)
        (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom φ))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h3
      exact h3.symm
    rw [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_comp, RingHom.comp_apply, ← h2]
    exact h1

  intro R _ n g c U P ψ _ j _ F hF s hs
  subst hF
  have hA := s2 ψ s
  have hB := s3 (wcQuadModelRing R n g c) (ψ s)
  have hC := s1 R n (wcQuadModelIdeal R n g c) (ψ s).asIdeal hs
  have hD : Ideal.comap (algebraMap R (wcQuadModelRing R n g c)) (ψ s).asIdeal =
      (wcQuadModelStr R n g c (ψ s)).asIdeal := rfl
  have hR := s3 R (wcQuadModelStr R n g c (ψ s))
  have hJ := s2 j (wcQuadModelStr R n g c (ψ s))
  have hcomp : ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing R n g c))).inv ≫
        (Spec (.of (wcQuadModelRing R n g c))).presheaf.Γgerm (ψ s)).hom.comp
        (algebraMap R (wcQuadModelRing R n g c)) =
      ((wcQuadModelStr R n g c).stalkMap (ψ s)).hom.comp
        ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
          (Spec (.of R)).presheaf.Γgerm (wcQuadModelStr R n g c (ψ s))).hom := by
    ext a
    exact (s4 R (wcQuadModelRing R n g c) (algebraMap R (wcQuadModelRing R n g c)) (ψ s) a).symm
  have hFmap : Ideal.map ((ψ ≫ wcQuadModelStr R n g c ≫ j).stalkMap s).hom
      (IsLocalRing.maximalIdeal (P.presheaf.stalk ((ψ ≫ wcQuadModelStr R n g c ≫ j) s))) =
      Ideal.map (ψ.stalkMap s).hom (Ideal.map ((wcQuadModelStr R n g c).stalkMap (ψ s)).hom
        (Ideal.map (j.stalkMap (wcQuadModelStr R n g c (ψ s))).hom
          (IsLocalRing.maximalIdeal (P.presheaf.stalk (j (wcQuadModelStr R n g c (ψ s))))))) := by
    rw [Ideal.map_map, Ideal.map_map, Scheme.Hom.stalkMap_comp, Scheme.Hom.stalkMap_comp]
    try rfl
  have hE : Ideal.map (ψ.stalkMap s).hom (Ideal.map
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing R n g c))).inv ≫
          (Spec (.of (wcQuadModelRing R n g c))).presheaf.Γgerm (ψ s)).hom
        (Ideal.map (algebraMap R (wcQuadModelRing R n g c))
          (Ideal.comap (algebraMap R (wcQuadModelRing R n g c)) (ψ s).asIdeal))) =
      Ideal.map (ψ.stalkMap s).hom (Ideal.map ((wcQuadModelStr R n g c).stalkMap (ψ s)).hom
        (Ideal.map (j.stalkMap (wcQuadModelStr R n g c (ψ s))).hom
          (IsLocalRing.maximalIdeal (P.presheaf.stalk (j (wcQuadModelStr R n g c (ψ s))))))) := by
    rw [Ideal.map_map (algebraMap R (wcQuadModelRing R n g c)), hcomp, ← Ideal.map_map, hD,
      ← hR, hJ]
  have hT : Ideal.map (ψ.stalkMap s).hom (Ideal.map
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing R n g c))).inv ≫
          (Spec (.of (wcQuadModelRing R n g c))).presheaf.Γgerm (ψ s)).hom
        (Ideal.span (Set.range fun q => Ideal.Quotient.mk (wcQuadModelIdeal R n g c)
          (MvPolynomial.X q)))) ≤
      Ideal.span (Set.range fun q : Fin n => (U.presheaf.Γgerm s).hom (ψ.appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing R n g c))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.X q))))) := by
    rw [Ideal.map_map, Ideal.map_le_iff_le_comap, Ideal.span_le]
    rintro _ ⟨q, rfl⟩
    rw [SetLike.mem_coe, Ideal.mem_comap]
    apply Ideal.subset_span
    refine ⟨q, ?_⟩
    rw [RingHom.comp_apply, CommRingCat.hom_comp, RingHom.comp_apply]
    exact (Scheme.Hom.germ_stalkMap_apply ψ ⊤ s trivial _).symm
  calc IsLocalRing.maximalIdeal (U.presheaf.stalk s)
      = Ideal.map (ψ.stalkMap s).hom (IsLocalRing.maximalIdeal
          ((Spec (.of (wcQuadModelRing R n g c))).presheaf.stalk (ψ s))) := hA.symm
    _ = Ideal.map (ψ.stalkMap s).hom (Ideal.map
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing R n g c))).inv ≫
          (Spec (.of (wcQuadModelRing R n g c))).presheaf.Γgerm (ψ s)).hom (ψ s).asIdeal) := by
        rw [hB]
    _ ≤ Ideal.map (ψ.stalkMap s).hom (Ideal.map
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing R n g c))).inv ≫
          (Spec (.of (wcQuadModelRing R n g c))).presheaf.Γgerm (ψ s)).hom
        (Ideal.map (algebraMap R (wcQuadModelRing R n g c))
          (Ideal.comap (algebraMap R (wcQuadModelRing R n g c)) (ψ s).asIdeal) ⊔
        Ideal.span (Set.range fun q => Ideal.Quotient.mk (wcQuadModelIdeal R n g c)
          (MvPolynomial.X q)))) := Ideal.map_mono (Ideal.map_mono hC)
    _ = Ideal.map (ψ.stalkMap s).hom (Ideal.map
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing R n g c))).inv ≫
          (Spec (.of (wcQuadModelRing R n g c))).presheaf.Γgerm (ψ s)).hom
        (Ideal.map (algebraMap R (wcQuadModelRing R n g c))
          (Ideal.comap (algebraMap R (wcQuadModelRing R n g c)) (ψ s).asIdeal))) ⊔
        Ideal.map (ψ.stalkMap s).hom (Ideal.map
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing R n g c))).inv ≫
          (Spec (.of (wcQuadModelRing R n g c))).presheaf.Γgerm (ψ s)).hom
        (Ideal.span (Set.range fun q => Ideal.Quotient.mk (wcQuadModelIdeal R n g c)
          (MvPolynomial.X q)))) := by
        rw [Ideal.map_sup, Ideal.map_sup]
    _ ≤ _ := sup_le_sup (le_of_eq (hE.trans hFmap.symm)) hT

theorem wc_pcu_qm_smooth_off_vertex : ∀ (R : Type u) [CommRing R] (n : ℕ) (g : R) (c : Matrix (Fin n) (Fin n) R), IsUnit (c + c.transpose).det → ∀ {U P : Scheme.{u}} (ψ : U ⟶ Spec (.of (wcQuadModelRing R n g c))) [Etale ψ] (j : Spec (.of R) ⟶ P) [IsOpenImmersion j] (z : U), (∃ q, Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.X q) ∉ (ψ z).asIdeal) → ∃ V : U.Opens, z ∈ V ∧ Smooth (V.ι ≫ ψ ≫ wcQuadModelStr R n g c ≫ j) :=
by
  intro R _ n g c hc U P ψ _ j _ z hz
  classical
  obtain ⟨q₀, hq₀⟩ := hz


  have jacS : ∀ (G : MvPolynomial (Fin n) R)
      (x : Spec (.of (MvPolynomial (Fin n) R ⧸ Ideal.span {G}))) (r : Fin n),
      Ideal.Quotient.mk (Ideal.span {G}) (MvPolynomial.pderiv r G) ∉ PrimeSpectrum.asIdeal x →
      ∃ O : (Spec (.of (MvPolynomial (Fin n) R ⧸ Ideal.span {G}))).Opens, x ∈ O ∧
        Smooth (O.ι ≫ Spec.map (CommRingCat.ofHom
          (algebraMap R (MvPolynomial (Fin n) R ⧸ Ideal.span {G})))) := by
    intro G x r hr
    have jac : ∀ (m : ℕ) (F : Fin m → MvPolynomial (Fin n) R) (ι : Fin m → Fin n),
        Function.Injective ι → ∀ e : MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range F),
        IsUnit (algebraMap (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range F)) (Localization.Away e)
          (Ideal.Quotient.mk (Ideal.span (Set.range F))
            (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (ι i) (F j)).det)) →
        Algebra.Smooth R (Localization.Away e) := by
      intro m F ι hι e h
      let Pp : Algebra.PreSubmersivePresentation R
          (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range F)) (Fin n) (Fin m) :=
        Algebra.PreSubmersivePresentation.mk (Algebra.Presentation.naive (v := F)) ι hι
      have hval : ∀ y : MvPolynomial (Fin n) R,
          algebraMap Pp.Ring (MvPolynomial (Fin n) R ⧸ Ideal.span (Set.range F)) y =
            Ideal.Quotient.mk (Ideal.span (Set.range F)) y := by
        intro y
        rw [Algebra.Generators.algebraMap_apply]
        have hh : MvPolynomial.aeval Pp.val = Ideal.Quotient.mkₐ R (Ideal.span (Set.range F)) := by
          apply MvPolynomial.algHom_ext
          intro i
          rw [MvPolynomial.aeval_X, Ideal.Quotient.mkₐ_eq_mk]
          rfl
        exact congrArg (fun f => f y) hh
      have hPj : Pp.jacobian = Ideal.Quotient.mk (Ideal.span (Set.range F))
          (Matrix.of fun i j : Fin m => MvPolynomial.pderiv (ι i) (F j)).det := by
        rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det]
        have hmat : Pp.jacobiMatrix =
            Matrix.of fun i j : Fin m => MvPolynomial.pderiv (ι i) (F j) := by
          ext i j
          rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
          rfl
        rw [hmat]
        exact hval _
      let Q := Algebra.PreSubmersivePresentation.localizationAway (Localization.Away e) e
      let C := Q.comp Pp
      have hC : C.jacobian = algebraMap _ (Localization.Away e) Pp.jacobian *
          algebraMap _ (Localization.Away e) e := by
        rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
          Algebra.smul_def, Algebra.PreSubmersivePresentation.localizationAway_jacobian]
      have hunit : IsUnit C.jacobian := by
        rw [hC, hPj]
        exact h.mul (IsLocalization.Away.algebraMap_isUnit e)
      have : Algebra.IsStandardSmooth R (Localization.Away e) :=
        (Algebra.SubmersivePresentation.mk C hunit).isStandardSmooth
      infer_instance
    have hS : Set.range ![G] = {G} := by
      rw [Matrix.range_cons, Matrix.range_empty, Set.union_empty]
    have key := jac 1 ![G] ![r] (Function.injective_of_subsingleton _)
    rw [hS] at key
    set Rq := MvPolynomial (Fin n) R ⧸ Ideal.span {G} with hRq
    set e : Rq := Ideal.Quotient.mk (Ideal.span {G}) (MvPolynomial.pderiv r G) with he
    have hsm : Algebra.Smooth R (Localization.Away e) := by
      apply key e
      have hd : (Matrix.of fun i j : Fin 1 => MvPolynomial.pderiv (![r] i) (![G] j)).det =
          MvPolynomial.pderiv r G := by
        rw [Matrix.det_fin_one]; rfl
      rw [hd]
      exact IsLocalization.Away.algebraMap_isUnit e
    let S := Localization.Away e
    let Ub : (Spec (.of Rq)).Opens := PrimeSpectrum.basicOpen e
    let ι₁ : Spec (.of S) ⟶ Spec (.of Rq) := Spec.map (CommRingCat.ofHom (algebraMap Rq S))
    have : IsOpenImmersion ι₁ := IsOpenImmersion.of_isLocalization e
    have hrange : Set.range Ub.ι = Set.range ι₁ := by
      rw [Scheme.Opens.range_ι]
      have h1 : Set.range ι₁ = Set.range (PrimeSpectrum.comap (algebraMap Rq S)) := rfl
      rw [h1, PrimeSpectrum.localization_away_comap_range S e]
      rfl
    let θ := IsOpenImmersion.isoOfRangeEq Ub.ι ι₁ hrange
    have hθ : θ.hom ≫ ι₁ = Ub.ι := IsOpenImmersion.isoOfRangeEq_hom_fac Ub.ι ι₁ hrange
    refine ⟨Ub, hr, ?_⟩
    have hmor : Ub.ι ≫ Spec.map (CommRingCat.ofHom (algebraMap R Rq)) =
        θ.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap R S)) := by
      rw [← hθ, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
        ← IsScalarTower.algebraMap_eq R Rq S]
    rw [hmor]
    have : Smooth (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Smooth)]
      exact RingHom.smooth_algebraMap.mpr hsm
    infer_instance

  have hpd : ∀ r : Fin n, MvPolynomial.pderiv r
      (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C g : MvPolynomial (Fin n) R) =
      ∑ q, MvPolynomial.C (c r q + c q r) * MvPolynomial.X q := by
    intro r
    have term : ∀ p q : Fin n, MvPolynomial.pderiv r
        (MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin n) R) =
        (if q = r then MvPolynomial.C (c p q) * MvPolynomial.X p else 0) +
        (if p = r then MvPolynomial.C (c p q) * MvPolynomial.X q else 0) := by
      intro p q
      simp only [Derivation.leibniz, MvPolynomial.pderiv_C, MvPolynomial.pderiv_X,
        Pi.single_apply, smul_eq_mul]
      split_ifs <;> ring
    rw [map_sub, MvPolynomial.pderiv_C, sub_zero, map_sum]
    simp only [map_sum, term, Finset.sum_add_distrib]
    have h1 : ∑ p : Fin n, ∑ q : Fin n,
        (if q = r then MvPolynomial.C (c p q) * MvPolynomial.X p else 0) =
        ∑ p : Fin n, (MvPolynomial.C (c p r) * MvPolynomial.X p : MvPolynomial (Fin n) R) := by
      simp
    have h2 : ∑ p : Fin n, ∑ q : Fin n,
        (if p = r then MvPolynomial.C (c p q) * MvPolynomial.X q else 0) =
        ∑ q : Fin n, (MvPolynomial.C (c r q) * MvPolynomial.X q : MvPolynomial (Fin n) R) := by
      rw [Finset.sum_comm]
      simp
    rw [h1, h2, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    rw [map_add]
    ring

  let M : Matrix (Fin n) (Fin n) (wcQuadModelRing R n g c) :=
    (algebraMap R (wcQuadModelRing R n g c)).mapMatrix (c + c.transpose)
  let τ : Fin n → wcQuadModelRing R n g c :=
    fun q => Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.X q)
  have hdetU : IsUnit M.det := by
    have h1 : M.det = algebraMap R (wcQuadModelRing R n g c) (c + c.transpose).det :=
      (RingHom.map_det _ _).symm
    rw [h1]
    exact hc.map _
  have hcoe : ∀ r, M.mulVec τ r =
      Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.pderiv r
        (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C g : MvPolynomial (Fin n) R)) := by
    intro r
    rw [hpd r, map_sum]
    simp only [Matrix.mulVec, dotProduct, M, τ, RingHom.mapMatrix_apply, Matrix.map_apply,
      Matrix.add_apply, Matrix.transpose_apply, map_mul]
    rfl
  have hex : ∃ r, Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.pderiv r
        (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C g : MvPolynomial (Fin n) R)) ∉ (ψ z).asIdeal := by
    by_contra hall
    push_neg at hall
    apply hq₀
    have hkey : M.det • τ = M.adjugate.mulVec (M.mulVec τ) := by
      rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec]
    have hq := congrFun hkey q₀
    rw [Pi.smul_apply, smul_eq_mul] at hq
    have hmem : M.det * τ q₀ ∈ (ψ z).asIdeal := by
      rw [hq]
      simp only [Matrix.mulVec, dotProduct]
      refine Ideal.sum_mem _ (fun s _ => Ideal.mul_mem_left _ _ ?_)
      have := hall s
      rw [← hcoe s] at this
      exact this
    obtain ⟨u, hu⟩ := hdetU
    have : τ q₀ = (↑u⁻¹ : wcQuadModelRing R n g c) * (M.det * τ q₀) := by
      rw [← hu, Units.inv_mul_cancel_left]
    have h2 : τ q₀ ∈ (ψ z).asIdeal := by
      rw [this]
      exact Ideal.mul_mem_left _ _ hmem
    exact h2
  obtain ⟨r, hr⟩ := hex
  obtain ⟨O, hzO, hO⟩ := jacS _ (ψ z) r hr
  have hO' : Smooth (O.ι ≫ wcQuadModelStr R n g c) := hO
  refine ⟨ψ ⁻¹ᵁ O, hzO, ?_⟩
  rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc, ← Category.assoc O.ι]
  infer_instance

theorem wc_pcu_smooth_descend_etale : ∀ {U X P S : Scheme.{u}} (u : U ⟶ X) [Etale u] (h : X ⟶ P) (sP : P ⟶ S) [LocallyOfFiniteType sP] [IsLocallyNoetherian X], Smooth (h ≫ sP) → ∀ (z : U) (V : U.Opens), z ∈ V → Smooth (V.ι ≫ u ≫ h) → ∃ W : X.Opens, u z ∈ W ∧ Smooth (W.ι ≫ h) :=
by

  have s2a : ∀ (R₀ A B B' : Type u) [CommRing R₀] [CommRing A] [CommRing B] [CommRing B']
      (f : R₀ →+* A) (g : A →+* B) (k : B →+* B'), (g.comp f).FormallySmooth →
      (k.comp g).FormallySmooth → k.FormallyEtale → k.FaithfullyFlat →
      letI := g.toAlgebra; Subsingleton (Algebra.H1Cotangent A B) := by
    intro R₀ A B B' _ _ _ _ f g k h1 h2 h3 h4
    letI : Algebra R₀ A := f.toAlgebra
    letI : Algebra A B := g.toAlgebra
    letI : Algebra R₀ B := (g.comp f).toAlgebra
    letI : Algebra B B' := k.toAlgebra
    letI : Algebra A B' := (k.comp g).toAlgebra
    letI : Algebra R₀ B' := ((k.comp g).comp f).toAlgebra
    haveI : IsScalarTower R₀ A B := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower R₀ B B' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower A B B' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : IsScalarTower R₀ A B' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Algebra.FormallySmooth R₀ B := h1
    haveI : Algebra.FormallySmooth A B' := h2
    haveI : Algebra.FormallyEtale B B' := h3
    haveI : Module.FaithfullyFlat B B' := h4

    have hμ' : Function.Injective (KaehlerDifferential.mapBaseChange R₀ A B') := by
      refine (injective_iff_map_eq_zero _).mpr fun x hx => ?_
      obtain ⟨y, rfl⟩ := (Algebra.H1Cotangent.exact_δ_mapBaseChange R₀ A B' x).mp hx
      rw [Subsingleton.elim y 0, map_zero]

    have hcomp : ∀ ω : Ω[A⁄R₀], KaehlerDifferential.map R₀ R₀ B B'
        (KaehlerDifferential.map R₀ R₀ A B ω) = KaehlerDifferential.map R₀ R₀ A B' ω := by
      intro ω
      have hω : ω ∈ Submodule.span A (Set.range (KaehlerDifferential.D R₀ A)) := by
        rw [KaehlerDifferential.span_range_derivation]; trivial
      induction hω using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨a, rfl⟩ := hx
        rw [KaehlerDifferential.map_D, KaehlerDifferential.map_D, KaehlerDifferential.map_D]
        rfl
      | zero => simp
      | add x y _ _ hx hy => simp only [map_add, hx, hy]
      | smul a x _ hx =>
        rw [LinearMap.map_smul, LinearMap.map_smul, ← hx, ← algebraMap_smul B a,
          LinearMap.map_smul, algebraMap_smul]

    set c := TensorProduct.AlgebraTensorModule.cancelBaseChange A B B' B' Ω[A⁄R₀] with hc
    have key : ∀ t, KaehlerDifferential.mapBaseChange R₀ A B' (c t) =
        KaehlerDifferential.mapBaseChange R₀ B B'
          (LinearMap.lTensor B' (KaehlerDifferential.mapBaseChange R₀ A B) t) := by
      intro t
      induction t using TensorProduct.induction_on with
      | zero => simp
      | tmul b' y =>
        induction y using TensorProduct.induction_on with
        | zero => simp
        | tmul b ω =>
          rw [hc, TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul, LinearMap.lTensor_tmul,
            KaehlerDifferential.mapBaseChange_tmul, KaehlerDifferential.mapBaseChange_tmul,
            KaehlerDifferential.mapBaseChange_tmul, LinearMap.map_smul, ← hcomp ω]
          rw [Algebra.smul_def, mul_comm, ← smul_smul, algebraMap_smul]
        | add y₁ y₂ ih₁ ih₂ => simp only [TensorProduct.tmul_add, map_add, ih₁, ih₂]
      | add t₁ t₂ ih₁ ih₂ => simp only [map_add, ih₁, ih₂]
    have hlt : Function.Injective
        (LinearMap.lTensor B' (KaehlerDifferential.mapBaseChange R₀ A B)) := by
      intro t₁ t₂ ht
      apply c.injective
      apply hμ'
      rw [key, key, ht]
    have hμ : Function.Injective (KaehlerDifferential.mapBaseChange R₀ A B) :=
      (Module.FaithfullyFlat.lTensor_injective_iff_injective B B' _).mp hlt
    have h0 : ∀ x : Algebra.H1Cotangent A B, x = 0 := by
      intro x
      have hδ : Algebra.H1Cotangent.δ R₀ A B x = 0 := by
        apply hμ
        rw [map_zero]
        exact (Algebra.H1Cotangent.exact_δ_mapBaseChange R₀ A B _).mpr ⟨x, rfl⟩
      obtain ⟨y, rfl⟩ := (Algebra.H1Cotangent.exact_map_δ R₀ A B x).mp hδ
      rw [Subsingleton.elim y 0, map_zero]
    exact ⟨fun x y => by rw [h0 x, h0 y]⟩

  have s2b : ∀ (A B B' : Type u) [CommRing A] [CommRing B] [CommRing B'] [IsNoetherianRing B]
      (g : A →+* B) (k : B →+* B'), (k.comp g).FormallySmooth → k.FormallyEtale →
      k.FaithfullyFlat → g.EssFiniteType → letI := g.toAlgebra; Module.Projective B Ω[B⁄A] := by
    intro A B B' _ _ _ _ g k h2 h3 h4 h5
    letI : Algebra A B := g.toAlgebra
    letI : Algebra B B' := k.toAlgebra
    letI : Algebra A B' := (k.comp g).toAlgebra
    haveI : IsScalarTower A B B' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Algebra.FormallySmooth A B' := h2
    haveI : Algebra.FormallyEtale B B' := h3
    haveI : Module.FaithfullyFlat B B' := h4
    haveI : Algebra.EssFiniteType A B := h5
    haveI : Module.Projective B' Ω[B'⁄A] := Algebra.FormallySmooth.projective_kaehlerDifferential
    haveI : Module.Flat B' Ω[B'⁄A] := inferInstance
    haveI : Module.Flat B' (TensorProduct B B' Ω[B⁄A]) :=
      Module.Flat.of_linearEquiv (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale A B B')
    haveI : Module.Flat B Ω[B⁄A] := Module.Flat.of_flat_tensorProduct B Ω[B⁄A] B'
    haveI : Module.Finite B Ω[B⁄A] := KaehlerDifferential.finite A B
    haveI : Module.FinitePresentation B Ω[B⁄A] := Module.finitePresentation_of_finite B _
    exact Module.Flat.projective_of_finitePresentation

  have s1 : ∀ {X P S : Scheme.{u}} (h : X ⟶ P) (sP : P ⟶ S) [LocallyOfFiniteType sP],
      LocallyOfFinitePresentation (h ≫ sP) → LocallyOfFinitePresentation h := by
    intro X P S h sP _ hcomp
    rw [HasRingHomProperty.iff_exists_appLE (P := @LocallyOfFinitePresentation)
      (RingHom.finitePresentation_stableUnderComposition.stableUnderCompositionWithLocalizationAway
        RingHom.finitePresentation_holdsForLocalizationAway).1]
    intro x
    obtain ⟨S₀, hS₀, hxS₀, -⟩ :=
      exists_isAffineOpen_mem_and_subset (x := sP (h x)) (U := ⊤) trivial
    obtain ⟨P₀, hP₀, hxP₀, hP₀S⟩ :=
      exists_isAffineOpen_mem_and_subset (x := h x) (U := sP ⁻¹ᵁ S₀) hxS₀
    obtain ⟨X₀, hX₀, hxX₀, hX₀P⟩ :=
      exists_isAffineOpen_mem_and_subset (x := x) (U := h ⁻¹ᵁ P₀) hxP₀
    refine ⟨⟨P₀, hP₀⟩, ⟨X₀, hX₀⟩, hxX₀, hX₀P, ?_⟩
    have e := Scheme.Hom.appLE_comp_appLE h sP S₀ P₀ X₀ hP₀S hX₀P
    have hfp : (Scheme.Hom.appLE (h ≫ sP) S₀ X₀
        (fun y hy => hP₀S (hX₀P hy))).hom.FinitePresentation :=
      LocallyOfFinitePresentation.finitePresentation_appLE (h ≫ sP) hS₀ hX₀ _
    rw [← e, CommRingCat.hom_comp] at hfp
    exact RingHom.FinitePresentation.of_comp_finiteType _ hfp
      (LocallyOfFiniteType.finiteType_appLE sP hS₀ hP₀ hP₀S)

  intro U X P S u _ h sP _ _ hsm z V hz hV
  haveI : Smooth (h ≫ sP) := hsm
  haveI : LocallyOfFinitePresentation h :=
    s1 h sP (instLocallyOfFinitePresentationOfSmooth (h ≫ sP))
  haveI : LocallyOfFiniteType h := inferInstance
  have hc : ((h.stalkMap (u z)).hom.comp (sP.stalkMap (h (u z))).hom).FormallySmooth := by
    have := wc_ldnm_tv_stalk_fs_of_smooth (h ≫ sP) (u z) ⊤ trivial inferInstance
    rw [Scheme.Hom.stalkMap_comp] at this
    exact this
  have hd : ((u.stalkMap z).hom.comp (h.stalkMap (u z)).hom).FormallySmooth := by
    have := wc_ldnm_tv_stalk_fs_of_smooth (u ≫ h) z V hz hV
    rw [Scheme.Hom.stalkMap_comp] at this
    exact this
  have he : (u.stalkMap z).hom.FormallyEtale := by
    letI := (u.stalkMap z).hom.toAlgebra
    have h1 : (u.stalkMap z).hom.FormallyUnramified := FormallyUnramified.stalkMap u z
    have h2 : (u.stalkMap z).hom.FormallySmooth :=
      wc_ldnm_tv_stalk_fs_of_smooth u z ⊤ trivial inferInstance
    haveI : Algebra.FormallyUnramified (X.presheaf.stalk (u z)) (U.presheaf.stalk z) := h1
    haveI : Algebra.FormallySmooth (X.presheaf.stalk (u z)) (U.presheaf.stalk z) := h2
    exact Algebra.FormallyEtale.of_formallyUnramified_and_formallySmooth
  have hff : (u.stalkMap z).hom.FaithfullyFlat := by
    letI := (u.stalkMap z).hom.toAlgebra
    haveI : Module.Flat (X.presheaf.stalk (u z)) (U.presheaf.stalk z) := Flat.stalkMap u z
    haveI : IsLocalHom (algebraMap (X.presheaf.stalk (u z)) (U.presheaf.stalk z)) :=
      (inferInstance : IsLocalHom (u.stalkMap z).hom)
    exact Module.FaithfullyFlat.of_flat_of_isLocalHom
  have hfs : (h.stalkMap (u z)).hom.FormallySmooth :=
    @Algebra.FormallySmooth.mk _ _ _ _ (h.stalkMap (u z)).hom.toAlgebra
      (s2b _ _ _ (h.stalkMap (u z)).hom (u.stalkMap z).hom hd he hff
        (LocallyOfFiniteType.stalkMap h (u z)))
      (s2a _ _ _ _ (sP.stalkMap (h (u z))).hom (h.stalkMap (u z)).hom (u.stalkMap z).hom
        hc hd he hff)
  exact wc_ldp_il_spread_rel h (u z) hfs

theorem wc_pcu_germ_mem_prime_iff : ∀ {U : Scheme.{u}} (A : Type u) [CommRing A] (ψ : U ⟶ Spec (.of A)) (a : A) (z : U) (p' : PrimeSpectrum (U.presheaf.stalk z)), (U.presheaf.Γgerm z).hom (ψ.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom a)) ∈ p'.asIdeal ↔ a ∈ (ψ (U.fromSpecStalk z p')).asIdeal :=
by
  intro U A _ ψ a z p'
  let q : Spec (U.presheaf.stalk z) := p'
  have L : (U.presheaf.Γgerm z).hom (ψ.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom a))
      ∉ p'.asIdeal ↔ q ∈ (Spec (U.presheaf.stalk z)).basicOpen
        ((Scheme.ΓSpecIso (U.presheaf.stalk z)).inv.hom ((U.presheaf.Γgerm z).hom
          (ψ.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom a)))) := by
    rw [basicOpen_eq_of_affine]
    exact (PrimeSpectrum.mem_basicOpen _ _).symm
  have R1 : a ∉ (ψ (U.fromSpecStalk z q)).asIdeal ↔ ψ (U.fromSpecStalk z q) ∈
      (Spec (.of A)).basicOpen ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom a) := by
    rw [basicOpen_eq_of_affine]
    exact (PrimeSpectrum.mem_basicOpen _ _).symm
  have M : ψ (U.fromSpecStalk z q) ∈
      (Spec (.of A)).basicOpen ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom a) ↔
      q ∈ (Spec (U.presheaf.stalk z)).basicOpen
        ((Scheme.ΓSpecIso (U.presheaf.stalk z)).inv.hom ((U.presheaf.Γgerm z).hom
          (ψ.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom a)))) := by
    rw [← Scheme.Hom.mem_preimage, Scheme.preimage_basicOpen_top, ← Scheme.Hom.mem_preimage,
      Scheme.preimage_basicOpen_top, Scheme.fromSpecStalk_appTop, CommRingCat.comp_apply,
      CommRingCat.comp_apply, Scheme.basicOpen_res]
    exact ⟨fun h => h.2, fun h => ⟨trivial, h⟩⟩
  rw [← not_iff_not]
  exact L.trans (M.symm.trans R1.symm)

theorem wc_pcu_node_reduced_fibre : ∀ (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ), 2 ≤ n → ∀ (D : wcLefschetzDatum F' F'' Y n) (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M') (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M') (p : D.Yt.left ⟶ Xu.left), wcPfamHyp D M' Xu h Δ lam p → ∀ (j : Fin D.m), Function.Bijective (h.residueFieldMap (p (D.xs j (IsLocalRing.closedPoint F'')))).hom ∧ IsLocalRing.maximalIdeal (Xu.left.presheaf.stalk (p (D.xs j (IsLocalRing.closedPoint F'')))) ≤ Ideal.map (h.stalkMap (p (D.xs j (IsLocalRing.closedPoint F'')))).hom (IsLocalRing.maximalIdeal ((wcProjK F'' M').presheaf.stalk (h (p (D.xs j (IsLocalRing.closedPoint F'')))))) ⊔ ⨅ (x : Xu.left) (_ : ¬ ∃ V : Xu.left.Opens, x ∈ V ∧ Smooth (V.ι ≫ h)) (hxz : x ⤳ p (D.xs j (IsLocalRing.closedPoint F''))), RingHom.ker (Xu.left.presheaf.stalkSpecializes hxz ≫ Xu.left.residue x).hom :=
by
  intro F' F'' _ _ _ _ Y n hn D M' Xu h Δ lam p hH j
  have app : ∀ {X Z : Scheme.{u}} {f g : X ⟶ Z}, f = g → ∀ x, f x = g x :=
    fun hfg x => hfg ▸ rfl
  have hH' := hH
  obtain ⟨⟨d, hd⟩, hprop, hstr, _, _, _, _, _, hlamStr, _, hpb, _, _⟩ := hH'

  have hR1 : ∀ {X P : Scheme.{u}} (K : Type u) [Field K] (h : X ⟶ P) (π : P ⟶ Spec (.of K))
      (σ : Spec (.of K) ⟶ X), σ ≫ h ≫ π = 𝟙 _ →
      Function.Bijective (h.residueFieldMap (σ (IsLocalRing.closedPoint K))).hom := by
    intro X P K _ h π σ hσ
    suffices H : ∀ pt : ↥(Spec (.of K)), Function.Bijective (h.residueFieldMap (σ pt)).hom from
      H _
    intro pt
    have e1 := Scheme.Hom.residueFieldMap_congr hσ pt
    have hG : Function.Surjective ((σ ≫ h ≫ π).residueFieldMap pt).hom := by
      rw [e1]
      have hI : IsIso (Scheme.Hom.residueFieldMap (𝟙 (Spec (.of K))) pt) := by
        rw [Scheme.residueFieldMap_id]
        exact IsIso.id _
      exact (ConcreteCategory.bijective_of_isIso _).2
    have e2 : (σ ≫ h ≫ π).residueFieldMap pt =
        (h ≫ π).residueFieldMap (σ pt) ≫ σ.residueFieldMap pt :=
      Scheme.residueFieldMap_comp σ (h ≫ π) pt
    have e3 : (h ≫ π).residueFieldMap (σ pt) =
        π.residueFieldMap (h (σ pt)) ≫ h.residueFieldMap (σ pt) :=
      Scheme.residueFieldMap_comp h π (σ pt)
    have hG' : Function.Surjective (⇑(σ.residueFieldMap pt).hom ∘
        ⇑((h ≫ π).residueFieldMap (σ pt)).hom) := by
      have := hG
      rw [e2] at this
      exact this
    have hA : Function.Surjective ((h ≫ π).residueFieldMap (σ pt)).hom := by
      intro y
      obtain ⟨z, hz⟩ := hG' ((σ.residueFieldMap pt).hom y)
      exact ⟨z, RingHom.injective (σ.residueFieldMap pt).hom hz⟩
    have hA' : Function.Surjective (⇑(h.residueFieldMap (σ pt)).hom ∘
        ⇑(π.residueFieldMap (h (σ pt))).hom) := by
      have := hA
      rw [e3] at this
      exact this
    exact ⟨RingHom.injective _, hA'.of_comp⟩

  have hS8 : ∀ (O O' : Type u) [CommRing O] [CommRing O'] [IsLocalRing O] [IsLocalRing O']
      (f : O →+* O') [IsLocalHom f], f.Flat → ∀ (J : Ideal O),
      IsLocalRing.maximalIdeal O' ≤ Ideal.map f J → IsLocalRing.maximalIdeal O ≤ J := by
    intro O O' _ _ _ _ f _ hf J hJ
    letI := f.toAlgebra
    haveI : Module.Flat O O' := hf
    haveI : IsLocalHom (algebraMap O O') := (inferInstance : IsLocalHom f)
    haveI : Module.FaithfullyFlat O O' := Module.FaithfullyFlat.of_flat_of_isLocalHom
    intro a ha
    have h1 : f a ∈ IsLocalRing.maximalIdeal O' := map_nonunit f a ha
    have h2 : f a ∈ Ideal.map (algebraMap O O') J := hJ h1
    rw [← Ideal.comap_map_eq_self_of_faithfullyFlat (B := O') J]
    exact h2

  have hsec : (D.xs j ≫ p) ≫ h ≫ wcProjKStr F'' M' = 𝟙 _ := by
    calc (D.xs j ≫ p) ≫ h ≫ wcProjKStr F'' M'
        = D.xs j ≫ (p ≫ h) ≫ wcProjKStr F'' M' := by simp only [Category.assoc]
      _ = D.xs j ≫ (D.f ≫ lam) ≫ wcProjKStr F'' M' := by rw [hpb.w]
      _ = (D.xs j ≫ D.f) ≫ lam ≫ wcProjKStr F'' M' := by simp only [Category.assoc]
      _ = D.S j ≫ (wcP1Over F'').hom := by rw [D.hxs j, hlamStr]
      _ = 𝟙 _ := D.hS j

  refine ⟨hR1 F'' h (wcProjKStr F'' M') (D.xs j ≫ p) hsec, ?_⟩

  haveI : IsProper h := hprop
  haveI : SmoothOfRelativeDimension d Xu.hom := hd
  haveI : Smooth Xu.hom := SmoothOfRelativeDimension.smooth d Xu.hom
  haveI : IsLocallyNoetherian Xu.left := LocallyOfFiniteType.isLocallyNoetherian Xu.hom
  have hsmc : Smooth (h ≫ wcProjKStr F'' M') := by rw [hstr]; infer_instance
  haveI : SmoothOfRelativeDimension M' (wcProjKStr F'' M') := wc_proj_space_smooth F'' M'
  haveI : Smooth (wcProjKStr F'' M') := SmoothOfRelativeDimension.smooth M' _
  have hCcl : IsClosed {c : Xu.left | ¬ ∃ V : Xu.left.Opens, c ∈ V ∧ Smooth (V.ι ≫ h)} := by
    rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
    intro c hc
    simp only [Set.mem_compl_iff, Set.mem_setOf_eq, not_not] at hc
    obtain ⟨V, hcV, hV⟩ := hc
    refine ⟨V, fun c' hc' => ?_, V.isOpen, hcV⟩
    simp only [Set.mem_compl_iff, Set.mem_setOf_eq, not_not]
    exact ⟨V, hc', hV⟩

  have core : ∀ {U : Scheme.{u}} (u : U ⟶ Xu.left) [Etale u] (R : Type u) [CommRing R] (g : R)
      (cR : Matrix (Fin n) (Fin n) R), IsUnit (cR + cR.transpose).det →
      ∀ (ψW : U ⟶ Spec (.of (wcQuadModelRing R n g cR))) [Etale ψW]
      (jW : Spec (.of R) ⟶ wcProjK F'' M') [IsOpenImmersion jW],
      u ≫ h = ψW ≫ wcQuadModelStr R n g cR ≫ jW → ∀ s : U,
      (∀ q, Ideal.Quotient.mk (wcQuadModelIdeal R n g cR) (MvPolynomial.X q) ∈ (ψW s).asIdeal) →
      IsLocalRing.maximalIdeal (Xu.left.presheaf.stalk (u s)) ≤
        Ideal.map (h.stalkMap (u s)).hom
          (IsLocalRing.maximalIdeal ((wcProjK F'' M').presheaf.stalk (h (u s)))) ⊔
        ⨅ (x : Xu.left) (_ : ¬ ∃ V : Xu.left.Opens, x ∈ V ∧ Smooth (V.ι ≫ h))
          (hxz : x ⤳ u s), RingHom.ker (Xu.left.presheaf.stalkSpecializes hxz ≫
            Xu.left.residue x).hom := by
    intro U u _ R _ g cR hcU ψW _ jW _ hcomm s hT

    have ha := wc_pcu_qm_chart_stalk_maximal R n g cR ψW jW (u ≫ h) hcomm s hT
    have hmap : Ideal.map ((u ≫ h).stalkMap s).hom
        (IsLocalRing.maximalIdeal ((wcProjK F'' M').presheaf.stalk ((u ≫ h) s))) =
        Ideal.map (u.stalkMap s).hom (Ideal.map (h.stalkMap (u s)).hom
          (IsLocalRing.maximalIdeal ((wcProjK F'' M').presheaf.stalk (h (u s))))) := by
      rw [Scheme.Hom.stalkMap_comp]
      exact (Ideal.map_map _ _).symm
    rw [hmap] at ha

    have hIrad : (⨅ (x : Xu.left) (_ : ¬ ∃ V : Xu.left.Opens, x ∈ V ∧ Smooth (V.ι ≫ h))
          (hxz : x ⤳ u s), RingHom.ker (Xu.left.presheaf.stalkSpecializes hxz ≫
            Xu.left.residue x).hom).IsRadical := by
      apply Ideal.isRadical_iInf; intro x
      apply Ideal.isRadical_iInf; intro _
      apply Ideal.isRadical_iInf; intro hxz
      exact (RingHom.ker_isPrime _).isRadical
    have hI'rad := wc_pcu_flat_unram_map_radical _ _ (u.stalkMap s).hom (Flat.stalkMap u s)
      (FormallyUnramified.stalkMap u s) (LocallyOfFiniteType.stalkMap u s) _ hIrad

    have htq : ∀ q : Fin n, (U.presheaf.Γgerm s).hom (ψW.appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing R n g cR))).inv.hom
          (Ideal.Quotient.mk (wcQuadModelIdeal R n g cR) (MvPolynomial.X q)))) ∈
        Ideal.map (u.stalkMap s).hom (⨅ (x : Xu.left)
          (_ : ¬ ∃ V : Xu.left.Opens, x ∈ V ∧ Smooth (V.ι ≫ h))
          (hxz : x ⤳ u s), RingHom.ker (Xu.left.presheaf.stalkSpecializes hxz ≫
            Xu.left.residue x).hom) := by
      intro q
      rw [← hI'rad.radical, Ideal.radical_eq_sInf]
      refine Ideal.mem_sInf.mpr ?_
      rintro p' ⟨hp'le, hp'prime⟩
      by_contra hnot
      let P' : PrimeSpectrum (U.presheaf.stalk s) := ⟨p', hp'prime⟩
      have hcomap : (⨅ (x : Xu.left) (_ : x ∈ {c : Xu.left | ¬ ∃ V : Xu.left.Opens,
            c ∈ V ∧ Smooth (V.ι ≫ h)}) (hxz : x ⤳ u s),
            RingHom.ker (Xu.left.presheaf.stalkSpecializes hxz ≫ Xu.left.residue x).hom) ≤
          (⟨Ideal.comap (u.stalkMap s).hom p', Ideal.IsPrime.comap _⟩ :
            PrimeSpectrum (Xu.left.presheaf.stalk (u s))).asIdeal :=
        fun a ha => hp'le (Ideal.mem_map_of_mem _ ha)
      have hC := wc_pcu_vanishing_ideal_le_prime _ hCcl (u s) _ hcomap
      have hnat := app (Scheme.SpecMap_stalkMap_fromSpecStalk u (x := s)) P'
      have e : u (U.fromSpecStalk s P') = Xu.left.fromSpecStalk (u s)
          ⟨Ideal.comap (u.stalkMap s).hom p', Ideal.IsPrime.comap _⟩ := hnat.symm
      have hC' : u (U.fromSpecStalk s P') ∈
          {c : Xu.left | ¬ ∃ V : Xu.left.Opens, c ∈ V ∧ Smooth (V.ι ≫ h)} := by
        rw [e]; exact hC
      have hnotT : Ideal.Quotient.mk (wcQuadModelIdeal R n g cR) (MvPolynomial.X q) ∉
          (ψW (U.fromSpecStalk s P')).asIdeal :=
        fun hm => hnot ((wc_pcu_germ_mem_prime_iff _ ψW _ s P').mpr hm)
      obtain ⟨V, hV, hsmV⟩ := wc_pcu_qm_smooth_off_vertex R n g cR hcU ψW jW _ ⟨q, hnotT⟩
      have hsm2 : Smooth (V.ι ≫ u ≫ h) := by rw [hcomm]; exact hsmV
      obtain ⟨W', hW', hsmW'⟩ :=
        wc_pcu_smooth_descend_etale u h (wcProjKStr F'' M') hsmc _ V hV hsm2
      exact hC' ⟨W', hW', hsmW'⟩

    have hup : IsLocalRing.maximalIdeal (U.presheaf.stalk s) ≤
        Ideal.map (u.stalkMap s).hom (Ideal.map (h.stalkMap (u s)).hom
          (IsLocalRing.maximalIdeal ((wcProjK F'' M').presheaf.stalk (h (u s)))) ⊔
        ⨅ (x : Xu.left) (_ : ¬ ∃ V : Xu.left.Opens, x ∈ V ∧ Smooth (V.ι ≫ h))
          (hxz : x ⤳ u s), RingHom.ker (Xu.left.presheaf.stalkSpecializes hxz ≫
            Xu.left.residue x).hom) := by
      rw [Ideal.map_sup]
      refine ha.trans (sup_le_sup_left ?_ _)
      rw [Ideal.span_le]
      rintro _ ⟨q, rfl⟩
      exact htq q

    exact hS8 _ _ (u.stalkMap s).hom (Flat.stalkMap u s) _ hup

  obtain ⟨W, hW, φ₀, hy, -, -, U, u, c, ψ, σ, hu, hψ, hc, hcomm, hσ, hT⟩ :=
    wc_pfam_xwt_param_morse_chart F' F'' Y n hn D M' Xu h Δ lam p hH j
  haveI : Etale u := hu
  haveI : Etale ψ := hψ
  have hcU : IsUnit ((c.map (wcUnK F'' M' (𝟙 (wcProjK F'' M')) W)) +
      (c.map (wcUnK F'' M' (𝟙 (wcProjK F'' M')) W)).transpose).det := by
    have h1 : (c.map (wcUnK F'' M' (𝟙 (wcProjK F'' M')) W)) +
        (c.map (wcUnK F'' M' (𝟙 (wcProjK F'' M')) W)).transpose =
        (wcUnK F'' M' (𝟙 (wcProjK F'' M')) W).mapMatrix (c + c.transpose) := by
      ext a b
      simp
    rw [h1, ← RingHom.map_det]
    exact (isUnit_iff_ne_zero.mpr hc).map _
  have hus : u (σ (IsLocalRing.closedPoint F'')) = p (D.xs j (IsLocalRing.closedPoint F'')) :=
    app hσ _
  have Key : ∀ z : Xu.left, u (σ (IsLocalRing.closedPoint F'')) = z →
      IsLocalRing.maximalIdeal (Xu.left.presheaf.stalk z) ≤
        Ideal.map (h.stalkMap z).hom
          (IsLocalRing.maximalIdeal ((wcProjK F'' M').presheaf.stalk (h z))) ⊔
        ⨅ (x : Xu.left) (_ : ¬ ∃ V : Xu.left.Opens, x ∈ V ∧ Smooth (V.ι ≫ h))
          (hxz : x ⤳ z), RingHom.ker (Xu.left.presheaf.stalkSpecializes hxz ≫
            Xu.left.residue x).hom := by
    rintro z rfl
    exact core u _ φ₀ _ hcU ψ hW.fromSpec hcomm _ hT
  exact Key _ hus

theorem wc_proper_isolated_closed_stalk_finite : ∀ {X S : Scheme.{u}} (g : X ⟶ S) [IsProper g] [IsLocallyNoetherian X] (T : Set X), IsClosed T → ∀ z ∈ T, (∀ x ∈ T, g x = g z → x = z) → letI := ((Ideal.Quotient.mk (⨅ (x : X) (_ : x ∈ T) (hxz : x ⤳ z), RingHom.ker (X.presheaf.stalkSpecializes hxz ≫ X.residue x).hom)).comp (g.stalkMap z).hom).toAlgebra; Module.Finite (S.presheaf.stalk (g z)) (X.presheaf.stalk z ⧸ ⨅ (x : X) (_ : x ∈ T) (hxz : x ⤳ z), RingHom.ker (X.presheaf.stalkSpecializes hxz ≫ X.residue x).hom) :=
by
  intro X S g _ _ T hT z _hzT hfib

  have s8 : ∀ (R A : Type u) [CommRing R] [CommRing A] (f : R →+* A) (J : Ideal A),
      ((Ideal.Quotient.mk J).comp f).IsIntegral → ∀ (q : Ideal R) [q.IsPrime] (p : Ideal A),
      (∀ P : Ideal A, P.IsPrime → J ≤ P → P.comap f = q → P = p) →
      ∀ s ∉ p, ∃ t ∉ q, ∃ c : A, f t - c * s ∈ J := by
    intro R A _ _ f J hint q _ p huniq s hs
    by_contra hcon
    push_neg at hcon
    letI : Algebra R (A ⧸ J) := ((Ideal.Quotient.mk J).comp f).toAlgebra
    haveI : Algebra.IsIntegral R (A ⧸ J) := ⟨hint⟩
    have hle : Ideal.under R (Ideal.span {Ideal.Quotient.mk J s}) ≤ q := by
      intro r hr
      rw [Ideal.under, Ideal.mem_comap, Ideal.mem_span_singleton'] at hr
      obtain ⟨a, ha⟩ := hr
      obtain ⟨c, rfl⟩ := Ideal.Quotient.mk_surjective a
      by_contra hrq
      apply hcon r hrq c
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_mul, ha]
      exact sub_self _
    obtain ⟨Q, hQ, hQp, hQq⟩ := Ideal.exists_ideal_over_prime_of_isIntegral q _ hle
    have hP := huniq (Q.comap (Ideal.Quotient.mk J)) (Ideal.comap_isPrime _ _) ?_ ?_
    · apply hs
      rw [← hP]
      show Ideal.Quotient.mk J s ∈ Q
      exact hQ (Ideal.subset_span rfl)
    · intro a ha
      show Ideal.Quotient.mk J a ∈ Q
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha]; exact Q.zero_mem
    · rw [Ideal.comap_comap]; exact hQq

  have s7 : ∀ (R A Rq Ap : Type u) [CommRing R] [CommRing A] [CommRing Rq] [CommRing Ap]
      [Algebra R Rq] [Algebra A Ap] (q : Ideal R) [q.IsPrime] [IsLocalization.AtPrime Rq q]
      (p : Ideal A) [p.IsPrime] [IsLocalization.AtPrime Ap p] (f : R →+* A) (fq : Rq →+* Ap),
      (∀ r : R, fq (algebraMap R Rq r) = algebraMap A Ap (f r)) → ∀ (J : Ideal A),
      ((Ideal.Quotient.mk J).comp f).Finite →
      (∀ s ∉ p, ∃ t ∉ q, ∃ c : A, f t - c * s ∈ J) → ∀ (I : Ideal Ap),
      (∀ a ∈ J, algebraMap A Ap a ∈ I) →
      letI := ((Ideal.Quotient.mk I).comp fq).toAlgebra; Module.Finite Rq (Ap ⧸ I) := by
    intro R A Rq Ap _ _ _ _ _ _ q _ _ p _ _ f fq hcomp J hfin hunit I hJI
    classical
    letI : Algebra R (A ⧸ J) := ((Ideal.Quotient.mk J).comp f).toAlgebra
    haveI : Module.Finite R (A ⧸ J) := hfin
    obtain ⟨n, gens, hgens⟩ := Module.Finite.exists_fin (R := R) (M := A ⧸ J)
    choose a ha using fun i => Ideal.Quotient.mk_surjective (gens i)
    have hstar : ∀ x : A, ∃ r : Fin n → R, x - ∑ i, f (r i) * a i ∈ J := by
      intro x
      have hx : Ideal.Quotient.mk J x ∈ Submodule.span R (Set.range gens) := by
        rw [hgens]; exact Submodule.mem_top
      obtain ⟨r, hr⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hx
      refine ⟨r, ?_⟩
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_sum, ← hr, sub_eq_zero]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [map_mul, ha i, Algebra.smul_def]
      rfl
    letI : Algebra Rq (Ap ⧸ I) := ((Ideal.Quotient.mk I).comp fq).toAlgebra
    refine ⟨⟨Finset.univ.image (fun i => Ideal.Quotient.mk I (algebraMap A Ap (a i))), ?_⟩⟩
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ, eq_top_iff]
    rintro m -
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective m
    obtain ⟨⟨x, ⟨s, hs⟩⟩, hxs⟩ := IsLocalization.surj p.primeCompl y
    obtain ⟨t, ht, c, hc⟩ := hunit s hs
    obtain ⟨r, hr⟩ := hstar (c * x)
    have hu : IsUnit (algebraMap R Rq t) := IsLocalization.map_units Rq (⟨t, ht⟩ : q.primeCompl)
    obtain ⟨v, hv⟩ : ∃ v, v * algebraMap R Rq t = 1 :=
      ⟨((hu.unit⁻¹ : Rqˣ) : Rq), hu.val_inv_mul⟩
    set π := Ideal.Quotient.mk I with hπ
    set ι := algebraMap A Ap with hι
    have hx' : π (ι x) = π y * π (ι s) := by
      simp only at hxs
      rw [← hxs, map_mul]
    have h1 : π (ι (f t)) = π (ι c) * π (ι s) := by
      have := hJI _ hc
      rw [← Ideal.Quotient.eq_zero_iff_mem] at this
      simp only [map_sub, map_mul] at this
      linear_combination this
    have h2 : ∑ i, π (ι (f (r i))) * π (ι (a i)) = π (ι c) * π (ι x) := by
      have := hJI _ hr
      rw [← Ideal.Quotient.eq_zero_iff_mem] at this
      simp only [map_sub, map_mul, map_sum] at this
      linear_combination -this
    have h3 : π (fq v) * π (ι (f t)) = 1 := by
      rw [← hcomp, ← map_mul, ← map_mul, hv, map_one, map_one]
    have e2 : ∀ i, (v * algebraMap R Rq (r i)) • π (ι (a i)) =
        π (fq v) * (π (ι (f (r i))) * π (ι (a i))) := by
      intro i
      show π (fq (v * _)) * _ = _
      rw [map_mul, map_mul, hcomp]
      ring
    have key : π y = ∑ i, (v * algebraMap R Rq (r i)) • π (ι (a i)) := by
      rw [Finset.sum_congr rfl (fun i _ => e2 i), ← Finset.mul_sum]
      linear_combination (-π (fq v)) * h2 + (-π (fq v) * π (ι c)) * hx' +
        (π (fq v) * π y) * h1 + (-π y) * h3
    rw [key]
    exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)

  have s6 : ∀ (U : X.Opens) (hU : IsAffineOpen U) (hzU : z ∈ U),
      ∀ a ∈ PrimeSpectrum.vanishingIdeal (⇑hU.fromSpec ⁻¹' T),
      (X.presheaf.germ U z hzU).hom a ∈ ⨅ (x : X) (_ : x ∈ T) (hxz : x ⤳ z),
        RingHom.ker (X.presheaf.stalkSpecializes hxz ≫ X.residue x).hom := by
    intro U hU hzU a ha
    simp only [Ideal.mem_iInf]
    intro x hxT hxz
    have hxU : x ∈ U := hxz.mem_open U.isOpen hzU
    rw [RingHom.mem_ker, CommRingCat.hom_comp, RingHom.comp_apply,
      TopCat.Presheaf.germ_stalkSpecializes_apply]
    have hmem : a ∈ (hU.primeIdealOf ⟨x, hxU⟩).asIdeal := by
      rw [PrimeSpectrum.mem_vanishingIdeal] at ha
      apply ha
      show hU.fromSpec (hU.primeIdealOf ⟨x, hxU⟩) ∈ T
      rw [hU.fromSpec_primeIdealOf]; exact hxT
    letI := TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨x, hxU⟩
    haveI := hU.isLocalization_stalk ⟨x, hxU⟩
    have : (X.presheaf.germ U x hxU).hom a ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) :=
      (IsLocalization.AtPrime.to_map_mem_maximal_iff (X.presheaf.stalk x) _ a).mpr hmem
    exact (IsLocalRing.residue_eq_zero_iff _).mpr this

  have s4b : ∀ (V : S.Opens) (U : X.Opens) (e : U ≤ g ⁻¹ᵁ V) (hzU : z ∈ U) (r : Γ(S, V)),
      (g.stalkMap z).hom ((S.presheaf.germ V (g z) (g.mem_preimage.mp (e hzU))).hom r) =
        (X.presheaf.germ U z hzU).hom ((g.appLE V U e).hom r) := by
    intro V U e hzU r
    rw [Scheme.Hom.germ_stalkMap_apply]
    exact (TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE e) z hzU ((g.app V).hom r)).symm

  have s4 : ∀ (V : S.Opens) (hV : IsAffineOpen V) (U : X.Opens)
      (hU : IsAffineOpen U) (e : U ≤ g ⁻¹ᵁ V) (hzU : z ∈ U) (P : Ideal Γ(X, U)), P.IsPrime →
      PrimeSpectrum.vanishingIdeal (⇑hU.fromSpec ⁻¹' T) ≤ P →
      P.comap (g.appLE V U e).hom =
        (hV.primeIdealOf ⟨g z, g.mem_preimage.mp (e hzU)⟩).asIdeal →
      P = (hU.primeIdealOf ⟨z, hzU⟩).asIdeal := by
    intro V hV U hU e hzU P hP hJP hcomap
    have app : ∀ {X Z : Scheme.{u}} {f g : X ⟶ Z}, f = g → ∀ x, f x = g x :=
      fun hfg x => hfg ▸ rfl
    let 𝔓 : PrimeSpectrum Γ(X, U) := ⟨P, hP⟩
    have hclosed : IsClosed (hU.fromSpec ⁻¹' T) := hT.preimage hU.fromSpec.continuous
    have hxT : hU.fromSpec 𝔓 ∈ T := by
      have h0 : 𝔓 ∈ PrimeSpectrum.zeroLocus
          (PrimeSpectrum.vanishingIdeal (hU.fromSpec ⁻¹' T) : Set Γ(X, U)) := hJP
      have h1 : PrimeSpectrum.zeroLocus
          (PrimeSpectrum.vanishingIdeal (hU.fromSpec ⁻¹' T) : Set Γ(X, U)) ⊆ hU.fromSpec ⁻¹' T :=
        (PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure _).trans_subset hclosed.closure_subset
      exact h1 h0
    have hg : g (hU.fromSpec 𝔓) = g z := by
      have h1 := app (IsAffineOpen.SpecMap_appLE_fromSpec g hV hU e) 𝔓
      have h2 : Spec.map (g.appLE V U e) 𝔓 =
          hV.primeIdealOf ⟨g z, g.mem_preimage.mp (e hzU)⟩ :=
        PrimeSpectrum.ext hcomap
      calc g (hU.fromSpec 𝔓) = (hU.fromSpec ≫ g) 𝔓 := rfl
        _ = (Spec.map (g.appLE V U e) ≫ hV.fromSpec) 𝔓 := h1.symm
        _ = hV.fromSpec (Spec.map (g.appLE V U e) 𝔓) := rfl
        _ = g z := by rw [h2, hV.fromSpec_primeIdealOf]
    have hxz := hfib _ hxT hg
    have : 𝔓 = hU.primeIdealOf ⟨z, hzU⟩ :=
      hU.fromSpec.isOpenEmbedding.injective (by rw [hU.fromSpec_primeIdealOf]; exact hxz)
    exact congrArg PrimeSpectrum.asIdeal this

  have s3 : ∀ (V : S.Opens) (hV : IsAffineOpen V) (U : X.Opens) (hU : IsAffineOpen U)
      (e : U ≤ g ⁻¹ᵁ V), (∀ x ∈ T, g x ∈ V → x ∈ U) →
      ((Ideal.Quotient.mk (PrimeSpectrum.vanishingIdeal (⇑hU.fromSpec ⁻¹' T))).comp
        (g.appLE V U e).hom).IsIntegral := by
    intro V hV U hU e hTU
    set J := PrimeSpectrum.vanishingIdeal (⇑hU.fromSpec ⁻¹' T) with hJ
    have hclosed : IsClosed (hU.fromSpec ⁻¹' T) := hT.preimage hU.fromSpec.continuous
    let mk : Γ(X, U) ⟶ CommRingCat.of (Γ(X, U) ⧸ J) := CommRingCat.ofHom (Ideal.Quotient.mk J)
    haveI : IsClosedImmersion (Spec.map mk) :=
      IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
    let ι := Spec.map mk ≫ hU.fromSpec
    have hrange : Set.range ι = T ∩ U := by
      have h1 : Set.range (Spec.map mk) = hU.fromSpec ⁻¹' T := by
        have e1 : Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk J)) =
            PrimeSpectrum.zeroLocus (J : Set Γ(X, U)) := by
          rw [range_comap_of_surjective _ _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
        have e2 : PrimeSpectrum.zeroLocus (J : Set Γ(X, U)) = closure (hU.fromSpec ⁻¹' T) :=
          PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure _
        exact e1.trans (e2.trans hclosed.closure_eq)
      rw [show ⇑ι = hU.fromSpec ∘ Spec.map mk from rfl, Set.range_comp, h1,
        Set.image_preimage_eq_inter_range, hU.range_fromSpec]
    have hsub : Set.range ι ⊆ Set.range (g ⁻¹ᵁ V).ι := by
      rw [hrange, Scheme.Opens.range_ι]; exact fun x hx => e hx.2
    let ι' := IsOpenImmersion.lift (g ⁻¹ᵁ V).ι ι hsub
    have hfac : ι' ≫ (g ⁻¹ᵁ V).ι = ι := IsOpenImmersion.lift_fac _ _ _
    haveI : IsPreimmersion (ι' ≫ (g ⁻¹ᵁ V).ι) := by rw [hfac]; infer_instance
    haveI : IsPreimmersion ι' := IsPreimmersion.of_comp ι' (g ⁻¹ᵁ V).ι
    have hcl : IsClosed (Set.range ι') := by
      have : Set.range ι' = (g ⁻¹ᵁ V).ι ⁻¹' T := by
        ext w
        constructor
        · rintro ⟨a, rfl⟩
          show (ι' ≫ (g ⁻¹ᵁ V).ι) a ∈ T
          rw [hfac]
          have : ι a ∈ T ∩ U := hrange ▸ ⟨a, rfl⟩
          exact this.1
        · intro hw
          have hgw : g ((g ⁻¹ᵁ V).ι w) ∈ V :=
            g.mem_preimage.mp ((Scheme.Opens.range_ι (g ⁻¹ᵁ V)).subset ⟨w, rfl⟩)
          have hwU : (g ⁻¹ᵁ V).ι w ∈ U := hTU _ hw hgw
          obtain ⟨a, ha⟩ : (g ⁻¹ᵁ V).ι w ∈ Set.range ι := hrange ▸ ⟨hw, hwU⟩
          refine ⟨a, (g ⁻¹ᵁ V).ι.isOpenEmbedding.injective ?_⟩
          rw [← ha]
          show (ι' ≫ (g ⁻¹ᵁ V).ι) a = ι a
          rw [hfac]
      rw [this]
      exact hT.preimage (g ⁻¹ᵁ V).ι.continuous
    haveI : IsClosedImmersion ι' := IsClosedImmersion.of_isPreimmersion ι' hcl
    have hm : Spec.map (g.appLE V U e ≫ mk) = ι' ≫ (g ∣_ V) ≫ hV.isoSpec.hom := by
      rw [← cancel_mono hV.fromSpec]
      rw [Spec.map_comp, Category.assoc, IsAffineOpen.SpecMap_appLE_fromSpec g hV hU e]
      rw [← hV.isoSpec_inv_ι]
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
      rw [morphismRestrict_ι, ← Category.assoc ι', hfac]
      simp only [ι, Category.assoc]
    have huc : UniversallyClosed (Spec.map (g.appLE V U e ≫ mk)) := by
      rw [hm]; infer_instance
    have hint : IsIntegralHom (Spec.map (g.appLE V U e ≫ mk)) :=
      IsIntegralHom.iff_universallyClosed_and_isAffineHom.mpr ⟨huc, inferInstance⟩
    exact IsIntegralHom.SpecMap_iff.mp hint

  have s1 : ∃ (V : S.Opens) (_ : IsAffineOpen V) (U : X.Opens) (_ : IsAffineOpen U)
      (_ : U ≤ g ⁻¹ᵁ V), z ∈ U ∧ (∀ x ∈ T, g x ∈ V → x ∈ U) := by
    obtain ⟨V₀, hV₀, hzV₀, -⟩ :=
      (TopologicalSpace.Opens.isBasis_iff_nbhd.mp S.isBasis_affineOpens)
        (show g z ∈ (⊤ : S.Opens) from trivial)
    obtain ⟨U₀, hU₀, hzU₀, hU₀le⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      X.isBasis_affineOpens) (show z ∈ g ⁻¹ᵁ V₀ from hzV₀)
    have hZ : IsClosed (T ∩ (U₀ : Set X)ᶜ) := hT.inter U₀.isOpen.isClosed_compl
    have hgZ : IsClosed (g '' (T ∩ (U₀ : Set X)ᶜ)) := g.isClosedMap _ hZ
    let W : S.Opens := V₀ ⊓ ⟨(g '' (T ∩ (U₀ : Set X)ᶜ))ᶜ, hgZ.isOpen_compl⟩
    have hzW : g z ∈ W := by
      refine ⟨hzV₀, ?_⟩
      rintro ⟨x, ⟨hxT, hxU⟩, hgx⟩
      exact hxU (hfib x hxT hgx ▸ hzU₀)
    obtain ⟨f, hfW, hzf⟩ := (show IsAffineOpen V₀ from hV₀).exists_basicOpen_le
      (⟨g z, hzW⟩ : W) hzV₀
    refine ⟨S.basicOpen f, (show IsAffineOpen V₀ from hV₀).basicOpen f,
      X.basicOpen ((g.appLE V₀ U₀ hU₀le).hom f),
      (show IsAffineOpen U₀ from hU₀).basicOpen _, ?_, ?_, ?_⟩
    · rw [Scheme.basicOpen_appLE]; exact inf_le_right
    · rw [Scheme.basicOpen_appLE]; exact ⟨hzU₀, hzf⟩
    · intro x hxT hgx
      rw [Scheme.basicOpen_appLE]
      refine ⟨?_, hgx⟩
      by_contra hxU
      have := (hfW hgx).2
      exact this ⟨x, ⟨hxT, hxU⟩, rfl⟩

  obtain ⟨V, hV, U, hU, e, hzU, hTU⟩ := s1
  have hy : g z ∈ V := g.mem_preimage.mp (e hzU)
  have hint := s3 V hV U hU e hTU
  have hft : (g.appLE V U e).hom.FiniteType :=
    HasRingHomProperty.appLE @LocallyOfFiniteType g inferInstance ⟨V, hV⟩ ⟨U, hU⟩ e
  have hfin : ((Ideal.Quotient.mk (PrimeSpectrum.vanishingIdeal (⇑hU.fromSpec ⁻¹' T))).comp
      (g.appLE V U e).hom).Finite :=
    hint.to_finite ((RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective).comp hft)
  have hunit := s8 _ _ (g.appLE V U e).hom _ hint (hV.primeIdealOf ⟨g z, hy⟩).asIdeal
    (hU.primeIdealOf ⟨z, hzU⟩).asIdeal (fun P hP hJP hc => s4 V hV U hU e hzU P hP hJP hc)
  letI : Algebra Γ(S, V) (S.presheaf.stalk (g z)) :=
    TopCat.Presheaf.algebra_section_stalk S.presheaf ⟨g z, hy⟩
  haveI : IsLocalization.AtPrime (S.presheaf.stalk (g z)) (hV.primeIdealOf ⟨g z, hy⟩).asIdeal :=
    hV.isLocalization_stalk ⟨g z, hy⟩
  letI : Algebra Γ(X, U) (X.presheaf.stalk z) :=
    TopCat.Presheaf.algebra_section_stalk X.presheaf ⟨z, hzU⟩
  haveI : IsLocalization.AtPrime (X.presheaf.stalk z) (hU.primeIdealOf ⟨z, hzU⟩).asIdeal :=
    hU.isLocalization_stalk ⟨z, hzU⟩
  exact s7 Γ(S, V) Γ(X, U) (S.presheaf.stalk (g z)) (X.presheaf.stalk z)
    (hV.primeIdealOf ⟨g z, hy⟩).asIdeal (hU.primeIdealOf ⟨z, hzU⟩).asIdeal
    (g.appLE V U e).hom (g.stalkMap z).hom (fun r => s4b V U e hzU r) _ hfin hunit _
    (s6 U hU hzU)

theorem wc_local_finite_quot_surj : ∀ (A O : Type u) [CommRing A] [IsLocalRing A] [CommRing O] [IsLocalRing O] (f : A →+* O) [IsLocalHom f] (I : Ideal O), (letI := ((Ideal.Quotient.mk I).comp f).toAlgebra; Module.Finite A (O ⧸ I)) → IsLocalRing.maximalIdeal O ≤ Ideal.map f (IsLocalRing.maximalIdeal A) ⊔ I → Function.Surjective (IsLocalRing.ResidueField.map f) → Function.Surjective ((Ideal.Quotient.mk I).comp f) :=
by
  intro A O _ _ _ _ f _ I hfin H2 H3
  letI : Algebra A (O ⧸ I) := ((Ideal.Quotient.mk I).comp f).toAlgebra
  have hg : ∀ a : A, algebraMap A (O ⧸ I) a = Ideal.Quotient.mk I (f a) := fun a => rfl
  set N : Submodule A (O ⧸ I) := LinearMap.range (Algebra.linearMap A (O ⧸ I)) with hN

  have hlift : ∀ o : O, ∃ a : A, o - f a ∈ IsLocalRing.maximalIdeal O := by
    intro o
    obtain ⟨abar, habar⟩ := H3 (IsLocalRing.residue O o)
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective abar
    refine ⟨a, ?_⟩
    rw [← IsLocalRing.residue_eq_zero_iff, map_sub, ← habar, IsLocalRing.ResidueField.map_residue,
      sub_self]

  have hsplit : ∀ z ∈ IsLocalRing.maximalIdeal O,
      Ideal.Quotient.mk I z ∈ Ideal.map (algebraMap A (O ⧸ I)) (IsLocalRing.maximalIdeal A) := by
    intro z hz
    obtain ⟨u, hu, v, hv, rfl⟩ := Submodule.mem_sup.mp (H2 hz)
    rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hv, add_zero]
    have : Ideal.map (algebraMap A (O ⧸ I)) (IsLocalRing.maximalIdeal A)
        = Ideal.map (Ideal.Quotient.mk I) (Ideal.map f (IsLocalRing.maximalIdeal A)) := by
      rw [Ideal.map_map]; rfl
    rw [this]
    exact Ideal.mem_map_of_mem _ hu

  have hcover : (⊤ : Submodule A (O ⧸ I)) ≤ N ⊔ IsLocalRing.maximalIdeal A • ⊤ := by
    intro x _
    obtain ⟨o, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨a, ha⟩ := hlift o
    have hx : Ideal.Quotient.mk I o
        = algebraMap A (O ⧸ I) a + Ideal.Quotient.mk I (o - f a) := by
      rw [hg, map_sub]; abel
    rw [hx]
    refine Submodule.add_mem_sup ?_ ?_
    · exact ⟨a, rfl⟩
    · rw [Ideal.smul_top_eq_map]
      exact (Submodule.restrictScalars_mem _ _ _).mpr (hsplit _ ha)
  have hjac : IsLocalRing.maximalIdeal A ≤ (⊥ : Ideal A).jacobson := by
    rw [IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal A) bot_ne_top]
  have htop : (⊤ : Submodule A (O ⧸ I)) ≤ N :=
    Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top hjac hcover
  intro x
  obtain ⟨a, ha⟩ := htop (Submodule.mem_top : x ∈ ⊤)
  exact ⟨a, ha⟩

theorem wc_stalk_quot_surj_points : ∀ {X S : Scheme.{u}} (g : X ⟶ S) (T : Set X) (z : X), z ∈ T → Function.Surjective ((Ideal.Quotient.mk (⨅ (x : X) (_ : x ∈ T) (hxz : x ⤳ z), RingHom.ker (X.presheaf.stalkSpecializes hxz ≫ X.residue x).hom)).comp (g.stalkMap z).hom) → ∀ c ∈ T, c ⤳ z → (∀ c' ∈ T, c' ⤳ z → g c' = g c → c' = c) ∧ Function.Bijective (g.residueFieldMap c).hom :=
by
  intro X S g T z _hzT hsurj c hcT hcz

  have L1 : ∀ {x x' : X} (hx : x ⤳ z) (hx' : x' ⤳ z),
      RingHom.ker (X.presheaf.stalkSpecializes hx ≫ X.residue x).hom =
        RingHom.ker (X.presheaf.stalkSpecializes hx' ≫ X.residue x').hom → x = x' := by
    have key : ∀ {x : X} (hx : x ⤳ z),
        (Spec.map (X.presheaf.stalkSpecializes hx)
          (IsLocalRing.closedPoint (X.presheaf.stalk x))).asIdeal =
          RingHom.ker (X.presheaf.stalkSpecializes hx ≫ X.residue x).hom ∧
        X.fromSpecStalk z (Spec.map (X.presheaf.stalkSpecializes hx)
          (IsLocalRing.closedPoint (X.presheaf.stalk x))) = x := by
      intro x hx
      constructor
      · ext a
        show (X.presheaf.stalkSpecializes hx).hom a ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) ↔ _
        rw [RingHom.mem_ker, CommRingCat.hom_comp, RingHom.comp_apply]
        show _ ↔ IsLocalRing.residue (X.presheaf.stalk x) _ = 0
        rw [IsLocalRing.residue_eq_zero_iff]
      · have e := Scheme.Hom.comp_apply (Spec.map (X.presheaf.stalkSpecializes hx))
          (X.fromSpecStalk z) (IsLocalRing.closedPoint (X.presheaf.stalk x))
        rw [Scheme.SpecMap_stalkSpecializes_fromSpecStalk, Scheme.fromSpecStalk_closedPoint] at e
        exact e.symm
    intro x x' hx hx' hk
    obtain ⟨h1, h2⟩ := key hx
    obtain ⟨h1', h2'⟩ := key hx'
    rw [← h2, ← h2']
    congr 1
    exact PrimeSpectrum.ext (h1.trans (hk.trans h1'.symm))

  have L2 : ∀ {x : X} (hx : x ⤳ z) (s : S.presheaf.stalk (g z)),
      (X.presheaf.stalkSpecializes hx ≫ X.residue x).hom ((g.stalkMap z).hom s) =
        (g.residueFieldMap x).hom
          ((S.presheaf.stalkSpecializes (hx.map g.continuous) ≫ S.residue (g x)).hom s) := by
    intro x hx s
    have e : g.stalkMap z ≫ X.presheaf.stalkSpecializes hx ≫ X.residue x =
        S.presheaf.stalkSpecializes (hx.map g.continuous) ≫ S.residue (g x) ≫
          g.residueFieldMap x := by
      rw [← Category.assoc, ← Scheme.Hom.stalkSpecializes_stalkMap, Category.assoc,
        ← Scheme.residue_residueFieldMap]
    have := congrArg (fun f => f.hom s) e
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this ⊢
    exact this

  have L3 : ∀ t : X.residueField c, ∃ a b : X.presheaf.stalk z,
      (X.presheaf.stalkSpecializes hcz ≫ X.residue c).hom b ≠ 0 ∧
        t = (X.presheaf.stalkSpecializes hcz ≫ X.residue c).hom a *
          ((X.presheaf.stalkSpecializes hcz ≫ X.residue c).hom b)⁻¹ := by
    intro t
    obtain ⟨W, hW, hzW, -⟩ := exists_isAffineOpen_mem_and_subset (x := z) (U := ⊤) trivial
    have hcW : c ∈ W := hcz.mem_open W.isOpen hzW
    obtain ⟨s, rfl⟩ := Scheme.residue_surjective X c t
    letI : Algebra Γ(X, W) (X.presheaf.stalk c) := (X.presheaf.germ W c hcW).hom.toAlgebra
    have : IsLocalization.AtPrime (X.presheaf.stalk c) (hW.primeIdealOf ⟨c, hcW⟩).asIdeal :=
      hW.isLocalization_stalk ⟨c, hcW⟩
    obtain ⟨⟨r, m⟩, hrm⟩ := IsLocalization.mk'_surjective
      (hW.primeIdealOf ⟨c, hcW⟩).asIdeal.primeCompl s
    simp only at hrm
    have hspec := IsLocalization.mk'_spec (X.presheaf.stalk c) r m
    rw [hrm] at hspec
    have hunit := IsLocalization.map_units (X.presheaf.stalk c) m
    have e1 : ∀ y, algebraMap Γ(X, W) (X.presheaf.stalk c) y = (X.presheaf.germ W c hcW).hom y :=
      fun y => rfl
    rw [e1, e1] at hspec
    rw [e1] at hunit
    have hg : ∀ y, (X.presheaf.stalkSpecializes hcz).hom ((X.presheaf.germ W z hzW).hom y) =
        (X.presheaf.germ W c hcW).hom y := by
      intro y
      have := congrArg (fun f => f.hom y) (X.presheaf.germ_stalkSpecializes hzW hcz)
      simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using this
    have hne : (X.residue c).hom ((X.presheaf.germ W c hcW).hom m) ≠ 0 :=
      (hunit.map (X.residue c).hom).ne_zero
    refine ⟨(X.presheaf.germ W z hzW).hom r, (X.presheaf.germ W z hzW).hom m, ?_, ?_⟩
    · simp only [CommRingCat.hom_comp, RingHom.comp_apply]
      rw [hg]
      exact hne
    · simp only [CommRingCat.hom_comp, RingHom.comp_apply]
      rw [hg, hg, eq_mul_inv_iff_mul_eq₀ hne, ← map_mul, hspec]

  have hIle : ∀ x (hxT : x ∈ T) (hxz : x ⤳ z),
      (⨅ (x : X) (_ : x ∈ T) (hxz : x ⤳ z),
        RingHom.ker (X.presheaf.stalkSpecializes hxz ≫ X.residue x).hom) ≤
        RingHom.ker (X.presheaf.stalkSpecializes hxz ≫ X.residue x).hom :=
    fun x hxT hxz => iInf_le_of_le x (iInf_le_of_le hxT (iInf_le _ hxz))
  have star : ∀ o : X.presheaf.stalk z, ∃ α : S.presheaf.stalk (g z),
      o - (g.stalkMap z).hom α ∈ (⨅ (x : X) (_ : x ∈ T) (hxz : x ⤳ z),
        RingHom.ker (X.presheaf.stalkSpecializes hxz ≫ X.residue x).hom) := by
    intro o
    obtain ⟨α, hα⟩ := hsurj (Ideal.Quotient.mk _ o)
    refine ⟨α, ?_⟩
    rw [RingHom.comp_apply] at hα
    exact Ideal.Quotient.eq.mp hα.symm

  have hU : ∀ c' ∈ T, c' ⤳ z → g c' = g c → c' = c := by
    intro c' hc'T hc'z hgc
    have transport : ∀ (y y' : S) (h : y ⤳ g z) (h' : y' ⤳ g z) (σ : S.presheaf.stalk (g z)),
        y = y' → ((S.presheaf.stalkSpecializes h ≫ S.residue y).hom σ = 0 ↔
          (S.presheaf.stalkSpecializes h' ≫ S.residue y').hom σ = 0) := by
      rintro y y' h h' σ rfl
      exact Iff.rfl
    have keyeq : ∀ {x : X} (hx : x ⤳ z) (α : S.presheaf.stalk (g z)),
        (g.stalkMap z).hom α ∈ RingHom.ker (X.presheaf.stalkSpecializes hx ≫ X.residue x).hom ↔
          (S.presheaf.stalkSpecializes (hx.map g.continuous) ≫ S.residue (g x)).hom α = 0 := by
      intro x hx α
      rw [RingHom.mem_ker, L2 hx α, map_eq_zero_iff _ (g.residueFieldMap x).hom.injective]
    have hmem : ∀ α : S.presheaf.stalk (g z),
        (g.stalkMap z).hom α ∈ RingHom.ker (X.presheaf.stalkSpecializes hcz ≫ X.residue c).hom ↔
        (g.stalkMap z).hom α ∈ RingHom.ker (X.presheaf.stalkSpecializes hc'z ≫ X.residue c').hom := by
      intro α
      rw [keyeq hcz, keyeq hc'z]
      exact transport _ _ _ _ _ hgc.symm
    have hQ : RingHom.ker (X.presheaf.stalkSpecializes hcz ≫ X.residue c).hom =
        RingHom.ker (X.presheaf.stalkSpecializes hc'z ≫ X.residue c').hom := by
      ext o
      obtain ⟨α, hα⟩ := star o
      have h1 := hIle c hcT hcz hα
      have h2 := hIle c' hc'T hc'z hα
      constructor
      · intro ho
        have h3 := Ideal.sub_mem _ ho h1
        rw [sub_sub_cancel] at h3
        have h4 := Ideal.add_mem _ ((hmem α).mp h3) h2
        simpa using h4
      · intro ho
        have h3 := Ideal.sub_mem _ ho h2
        rw [sub_sub_cancel] at h3
        have h4 := Ideal.add_mem _ ((hmem α).mpr h3) h1
        simpa using h4
    exact (L1 hcz hc'z hQ).symm

  refine ⟨hU, (g.residueFieldMap c).hom.injective, ?_⟩
  intro t
  obtain ⟨a, b, _hb, rfl⟩ := L3 t
  obtain ⟨α, hα⟩ := star a
  obtain ⟨β, hβ⟩ := star b
  have ea := (RingHom.sub_mem_ker_iff _).mp (hIle c hcT hcz hα)
  have eb := (RingHom.sub_mem_ker_iff _).mp (hIle c hcT hcz hβ)
  refine ⟨(S.presheaf.stalkSpecializes (hcz.map g.continuous) ≫ S.residue (g c)).hom α *
    ((S.presheaf.stalkSpecializes (hcz.map g.continuous) ≫ S.residue (g c)).hom β)⁻¹, ?_⟩
  rw [map_mul, map_inv₀, ← L2 hcz, ← L2 hcz, ea, eb]

theorem wc_pfam_xwt_crit_point_unique : ∀ (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ), 2 ≤ n → ∀ (D : wcLefschetzDatum F' F'' Y n) (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M') (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M') (p : D.Yt.left ⟶ Xu.left), wcPfamHyp D M' Xu h Δ lam p → ∀ (j : Fin D.m) (x' : wcProjK F'' M'), x' ∈ Δ → (∀ y ∈ Δ, x' ⤳ y) → (∀ c₁ c₂ : Xu.left, h c₁ = x' → h c₂ = x' → (¬ ∃ V : Xu.left.Opens, c₁ ∈ V ∧ Smooth (V.ι ≫ h)) → (¬ ∃ V : Xu.left.Opens, c₂ ∈ V ∧ Smooth (V.ι ≫ h)) → c₁ = c₂) ∧ ∀ c : Xu.left, h c = x' → (¬ ∃ V : Xu.left.Opens, c ∈ V ∧ Smooth (V.ι ≫ h)) → Function.Bijective (h.residueFieldMap c).hom :=
by
  intro F' F'' _ _ _ _ Y n hn D M' Xu h Δ lam p hH j x' _hx'Δ hspec
  have hH' := hH
  obtain ⟨⟨d, hd⟩, hprop, _, _, _, _, _, _, _, _, hpb, hlamΔ, _⟩ := hH'

  have hCcl : IsClosed {c : Xu.left | ¬ ∃ V : Xu.left.Opens, c ∈ V ∧ Smooth (V.ι ≫ h)} := by
    rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
    intro c hc
    simp only [Set.mem_compl_iff, Set.mem_setOf_eq, not_not] at hc
    obtain ⟨V, hcV, hV⟩ := hc
    refine ⟨V, fun c' hc' => ?_, V.isOpen, hcV⟩
    simp only [Set.mem_compl_iff, Set.mem_setOf_eq, not_not]
    exact ⟨V, hc', hV⟩
  have hyj : lam (D.S j (IsLocalRing.closedPoint F'')) ∈ Δ := (hlamΔ _).mpr ⟨j, rfl⟩
  have hxj : h (p (D.xs j (IsLocalRing.closedPoint F''))) =
      lam (D.S j (IsLocalRing.closedPoint F'')) := by
    calc h (p (D.xs j (IsLocalRing.closedPoint F'')))
        = (D.xs j ≫ p ≫ h) (IsLocalRing.closedPoint F'') := rfl
      _ = (D.xs j ≫ D.f ≫ lam) (IsLocalRing.closedPoint F'') := by rw [hpb.w]
      _ = ((D.xs j ≫ D.f) ≫ lam) (IsLocalRing.closedPoint F'') := by rw [Category.assoc]
      _ = (D.S j ≫ lam) (IsLocalRing.closedPoint F'') := by rw [D.hxs j]
      _ = lam (D.S j (IsLocalRing.closedPoint F'')) := rfl

  have hfib : ∀ x ∈ {c : Xu.left | ¬ ∃ V : Xu.left.Opens, c ∈ V ∧ Smooth (V.ι ≫ h)},
      h x = h (p (D.xs j (IsLocalRing.closedPoint F''))) →
      x = p (D.xs j (IsLocalRing.closedPoint F'')) := by
    intro x hx hhx
    by_contra hne
    exact hx (wc_pcu_offnode_smooth F' F'' Y n hn D M' Xu h Δ lam p hH j x (hhx.trans hxj) hne)

  haveI : IsProper h := hprop
  have hgen : ∀ c : Xu.left, (¬ ∃ V : Xu.left.Opens, c ∈ V ∧ Smooth (V.ι ≫ h)) → h c = x' →
      c ⤳ p (D.xs j (IsLocalRing.closedPoint F'')) := by
    intro c hc hcx
    have hcl : IsClosed (⇑h '' closure {c}) := Scheme.Hom.isClosedMap h _ isClosed_closure
    have h1 : x' ∈ ⇑h '' closure {c} := ⟨c, subset_closure rfl, hcx⟩
    have h2 : closure {x'} ⊆ ⇑h '' closure {c} :=
      hcl.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr h1)
    obtain ⟨z, hz, hzy⟩ := h2 (specializes_iff_mem_closure.mp (hspec _ hyj))
    have hzC : z ∈ {c : Xu.left | ¬ ∃ V : Xu.left.Opens, c ∈ V ∧ Smooth (V.ι ≫ h)} :=
      hCcl.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hc) hz
    have hzx : z = p (D.xs j (IsLocalRing.closedPoint F'')) := hfib z hzC (hzy.trans hxj.symm)
    rw [← hzx]
    exact specializes_iff_mem_closure.mpr hz
  haveI : SmoothOfRelativeDimension d Xu.hom := hd
  haveI : Smooth Xu.hom := SmoothOfRelativeDimension.smooth d Xu.hom
  haveI : LocallyOfFiniteType Xu.hom := inferInstance
  haveI : IsLocallyNoetherian Xu.left := LocallyOfFiniteType.isLocallyNoetherian Xu.hom

  have key : ∀ c : Xu.left, (¬ ∃ V : Xu.left.Opens, c ∈ V ∧ Smooth (V.ι ≫ h)) → h c = x' →
      (∀ c' ∈ {c : Xu.left | ¬ ∃ V : Xu.left.Opens, c ∈ V ∧ Smooth (V.ι ≫ h)},
        c' ⤳ p (D.xs j (IsLocalRing.closedPoint F'')) → h c' = h c → c' = c) ∧
      Function.Bijective (h.residueFieldMap c).hom := by
    intro c hc hcx
    have hcxj := hgen c hc hcx
    have hxjC : p (D.xs j (IsLocalRing.closedPoint F'')) ∈
        {c : Xu.left | ¬ ∃ V : Xu.left.Opens, c ∈ V ∧ Smooth (V.ι ≫ h)} :=
      hCcl.closure_subset_iff.mpr (Set.singleton_subset_iff.mpr hc)
        (specializes_iff_mem_closure.mp hcxj)
    have hfin := wc_proper_isolated_closed_stalk_finite h _ hCcl _ hxjC hfib
    obtain ⟨hres, hRF⟩ := wc_pcu_node_reduced_fibre F' F'' Y n hn D M' Xu h Δ lam p hH j
    have hsurj := wc_local_finite_quot_surj _ _
      (h.stalkMap (p (D.xs j (IsLocalRing.closedPoint F'')))).hom _ hfin hRF hres.2
    exact wc_stalk_quot_surj_points h _ _ hxjC hsurj c hc hcxj
  refine ⟨fun c₁ c₂ h1 h2 n1 n2 => ?_, fun c hc hn' => (key c hn' hc).2⟩
  exact ((key c₁ n1 h1).1 c₂ n2 (hgen c₂ n2 h2) (h2.trans h1.symm)).symm

theorem wc_quad_model_vertex_not_smooth : ∀ (R : Type u) [CommRing R] (n : ℕ), 1 ≤ n → ∀ (g : R) (c : Matrix (Fin n) (Fin n) R), IsUnit (c + c.transpose).det → ∀ {U Y : Scheme.{u}} (φ : U ⟶ Spec (.of (wcQuadModelRing R n g c))) [Etale φ] (j : Spec (.of R) ⟶ Y) [IsOpenImmersion j] (x : U), (∀ q, Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.X q) ∈ (φ x).asIdeal) → ¬ ∃ V : U.Opens, x ∈ V ∧ Smooth (V.ι ≫ φ ≫ wcQuadModelStr R n g c ≫ j) :=
by
  classical

  have s4 : ∀ {A B : Type u} [CommRing A] [CommRing B] (f : A →+* B), f.FormallySmooth →
      ∀ (C E : Type u) [CommRing C] [CommRing E] (u : B →+* C) (v : A →+* E) (w : E →+* C),
      Function.Surjective w → (∀ z₁ z₂ : E, w z₁ = 0 → w z₂ = 0 → z₁ * z₂ = 0) →
      w.comp v = u.comp f → ∃ L : B →+* E, w.comp L = u ∧ L.comp f = v := by
    intro A B _ _ f hf C E _ _ u v w hw hsq hc
    letI := f.toAlgebra
    letI := v.toAlgebra
    letI := (u.comp f).toAlgebra
    haveI : Algebra.FormallySmooth A B := hf
    let g : E →ₐ[A] C := { w with commutes' := fun a => RingHom.congr_fun hc a }
    let u' : B →ₐ[A] C := { u with commutes' := fun a => rfl }
    have hnil : IsNilpotent (RingHom.ker (g : E →+* C)) := by
      refine ⟨2, ?_⟩
      rw [pow_two, Ideal.zero_eq_bot, eq_bot_iff]
      apply Ideal.mul_le.mpr
      intro z₁ h₁ z₂ h₂
      rw [Ideal.mem_bot]
      exact hsq z₁ z₂ (RingHom.mem_ker.mp h₁) (RingHom.mem_ker.mp h₂)
    let L₀ := Algebra.FormallySmooth.liftOfSurjective u' g hw hnil
    refine ⟨L₀.toRingHom, ?_, ?_⟩
    · ext b
      exact Algebra.FormallySmooth.liftOfSurjective_apply u' g hw hnil b
    · ext a
      exact L₀.commutes a

  have s0 : ∀ (R : Type u) [CommRing R] (n : ℕ) (g : R) (c : Matrix (Fin n) (Fin n) R)
      {U Y : Scheme.{u}} (φ : U ⟶ Spec (.of (wcQuadModelRing R n g c))) [Etale φ]
      (j : Spec (.of R) ⟶ Y) [IsOpenImmersion j] (x : U) (V : U.Opens), x ∈ V →
      Smooth (V.ι ≫ φ ≫ wcQuadModelStr R n g c ≫ j) →
      ∃ (S : Type u) (_ : CommRing S) (β : wcQuadModelRing R n g c →+* S) (𝔮 : Ideal S),
        𝔮.IsPrime ∧ β.FormallySmooth ∧
        (β.comp (algebraMap R (wcQuadModelRing R n g c))).FormallySmooth ∧
        ∀ F, F ∈ (φ x).asIdeal → β F ∈ 𝔮 := by
    intro R _ n g c U Y φ _ j _ x V hxV hsm
    have hpb : IsPullback (𝟙 V.toScheme) (V.ι ≫ φ ≫ wcQuadModelStr R n g c)
        ((V.ι ≫ φ ≫ wcQuadModelStr R n g c) ≫ j) j :=
      IsPullback.of_horiz_isIso_mono ⟨by simp⟩
    have hsm' : Smooth ((V.ι ≫ φ ≫ wcQuadModelStr R n g c) ≫ j) := by
      simpa only [Category.assoc] using hsm
    have hf₀s : Smooth (V.ι ≫ φ ≫ wcQuadModelStr R n g c) :=
      MorphismProperty.of_isPullback (P := @Smooth) hpb hsm'
    obtain ⟨x', hx'⟩ : x ∈ Set.range V.ι := by rw [Scheme.Opens.range_ι]; exact hxV
    obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (X := V.toScheme)
      (x := x') (U := ⊤) (Set.mem_univ _)
    let ψ : Spec Γ(V.toScheme, W) ⟶ Spec (.of (wcQuadModelRing R n g c)) :=
      hW.fromSpec ≫ V.ι ≫ φ
    haveI : Etale ψ := by dsimp only [ψ]; infer_instance
    let β' := Spec.preimage ψ
    have hβ' : Spec.map β' = ψ := Spec.map_preimage ψ
    have hβet : β'.hom.Etale := by
      apply (HasRingHomProperty.Spec_iff (P := @Etale)).mp
      rw [hβ']
      infer_instance
    have hβfs : β'.hom.FormallySmooth := by
      letI := β'.hom.toAlgebra
      haveI : Algebra.Etale (wcQuadModelRing R n g c) Γ(V.toScheme, W) := hβet
      show Algebra.FormallySmooth (wcQuadModelRing R n g c) Γ(V.toScheme, W)
      infer_instance
    have hαsm : Smooth (Spec.map
        (CommRingCat.ofHom (algebraMap R (wcQuadModelRing R n g c)) ≫ β')) := by
      rw [Spec.map_comp, hβ']
      show Smooth ((hW.fromSpec ≫ V.ι ≫ φ) ≫ wcQuadModelStr R n g c)
      rw [Category.assoc, Category.assoc]
      haveI := hf₀s
      infer_instance
    have hαfs : (β'.hom.comp (algebraMap R (wcQuadModelRing R n g c))).FormallySmooth := by
      have := (HasRingHomProperty.Spec_iff (P := @Smooth)).mp hαsm
      exact RingHom.Smooth.formallySmooth this
    obtain ⟨y, hy⟩ : x' ∈ Set.range hW.fromSpec := by
      rw [hW.range_fromSpec]; exact hxW
    refine ⟨Γ(V.toScheme, W), inferInstance, β'.hom, y.asIdeal, y.isPrime, hβfs, hαfs, ?_⟩
    intro F hF
    have h1 : ψ y = φ x := by
      show φ (V.ι (hW.fromSpec y)) = φ x
      rw [hy, hx']
    have h2 : (Spec.map β' y).asIdeal = Ideal.comap β'.hom y.asIdeal := rfl
    rw [hβ', h1] at h2
    rw [h2] at hF
    exact hF

  have s1 : ∀ (D : Type u) [CommRing D] [Nontrivial D] (n : ℕ), 1 ≤ n →
      ∀ (c : Matrix (Fin n) (Fin n) D), IsUnit (c + c.transpose).det →
      ∃ a : Fin n → D, ∑ p, ∑ q, c p q * a p * a q ≠ 0 := by
    intro D _ _ n hn c hc
    by_contra hcon
    push_neg at hcon
    have hzero : c + c.transpose = 0 := by
      ext p q
      have e1 := hcon (Pi.single p 1)
      have e2 := hcon (Pi.single q 1)
      have e3 := hcon (Pi.single p 1 + Pi.single q 1)
      simp only [Pi.add_apply, add_mul, mul_add, Finset.sum_add_distrib] at e3
      simp only [Pi.single_apply, mul_ite, mul_one, mul_zero,
        Finset.sum_ite_eq', Finset.mem_univ, if_true] at e1 e2 e3
      simp only [Matrix.add_apply, Matrix.transpose_apply, Matrix.zero_apply]
      linear_combination e3 - e1 - e2
    haveI : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
    rw [hzero, Matrix.det_zero] at hc
    exact not_isUnit_zero hc

  have s2 : ∀ (D : Type u) [CommRing D] (n : ℕ) (c : Matrix (Fin n) (Fin n) D) (a : Fin n → D)
      (P : Fin n → Polynomial D),
      (∀ p, (Polynomial.X ^ 2 : Polynomial D) ∣ P p - Polynomial.C (a p) * Polynomial.X) →
      (Polynomial.X ^ 3 : Polynomial D) ∣ ∑ p, ∑ q, Polynomial.C (c p q) * P p * P q →
      ∑ p, ∑ q, c p q * a p * a q = 0 := by
    intro D _ n c a P hP1 hP2
    choose r hr using hP1
    have hPform : ∀ p, P p = Polynomial.C (a p) * Polynomial.X + Polynomial.X ^ 2 * r p := by
      intro p
      rw [← hr p]
      ring
    have hsum : ∑ p, ∑ q, Polynomial.C (c p q) * P p * P q =
        Polynomial.C (∑ p, ∑ q, c p q * a p * a q) * Polynomial.X ^ 2 +
          Polynomial.X ^ 3 * (∑ p, ∑ q, Polynomial.C (c p q) *
            (Polynomial.C (a p) * r q + r p * Polynomial.C (a q) + Polynomial.X * r p * r q)) := by
      rw [map_sum, Finset.sum_mul, Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [map_sum, Finset.sum_mul, Finset.mul_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun q _ => ?_)
      rw [hPform p, hPform q]
      simp only [map_mul]
      ring
    rw [hsum] at hP2
    have hd := (dvd_add_left (dvd_mul_right _ _)).mp hP2
    have hcoeff := Polynomial.X_pow_dvd_iff.mp hd 2 (by norm_num)
    rw [Polynomial.coeff_C_mul_X_pow] at hcoeff
    simpa using hcoeff

  have s3 : ∀ (R S : Type u) [CommRing R] [CommRing S] (n : ℕ) (g : R)
      (c : Matrix (Fin n) (Fin n) R) (β : wcQuadModelRing R n g c →+* S),
      (∀ (C E : Type u) [CommRing C] [CommRing E] (u : S →+* C)
        (v : wcQuadModelRing R n g c →+* E) (w : E →+* C), Function.Surjective w →
        (∀ z₁ z₂ : E, w z₁ = 0 → w z₂ = 0 → z₁ * z₂ = 0) → w.comp v = u.comp β →
        ∃ L : S →+* E, w.comp L = u ∧ L.comp β = v) →
      (∀ (C E : Type u) [CommRing C] [CommRing E] (u : S →+* C)
        (v : R →+* E) (w : E →+* C), Function.Surjective w →
        (∀ z₁ z₂ : E, w z₁ = 0 → w z₂ = 0 → z₁ * z₂ = 0) →
        w.comp v = u.comp (β.comp (algebraMap R (wcQuadModelRing R n g c))) →
        ∃ L : S →+* E, w.comp L = u ∧
          L.comp (β.comp (algebraMap R (wcQuadModelRing R n g c))) = v) →
      ∀ (𝔮 : Ideal S),
      (∀ q, β (Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.X q)) ∈ 𝔮) →
      ∀ (a : Fin n → S ⧸ 𝔮), ∃ P : Fin n → Polynomial (S ⧸ 𝔮),
        (∀ p, (Polynomial.X ^ 2 : Polynomial (S ⧸ 𝔮)) ∣ P p - Polynomial.C (a p) * Polynomial.X) ∧
        (Polynomial.X ^ 3 : Polynomial (S ⧸ 𝔮)) ∣ ∑ p, ∑ q,
          Polynomial.C (Ideal.Quotient.mk 𝔮
            (β (algebraMap R (wcQuadModelRing R n g c) (c p q)))) * P p * P q := by
    intro R S _ _ n g c β hβL hαL 𝔮 hT a
    set M := wcQuadModelRing R n g c with hMdef
    set I := wcQuadModelIdeal R n g c with hIdef
    set alg : R →+* M := algebraMap R M with halg
    set κ : R →+* S ⧸ 𝔮 := (Ideal.Quotient.mk 𝔮).comp (β.comp alg) with hκ
    have hκa : ∀ r, κ r = Ideal.Quotient.mk 𝔮 (β (alg r)) := fun r => rfl
    have halgC : ∀ r, alg r = Ideal.Quotient.mk I (MvPolynomial.C r) := by
      intro r
      rw [halg, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
    set T : Fin n → M := fun q => Ideal.Quotient.mk I (MvPolynomial.X q) with hTdef
    have hrel : ∑ p, ∑ q, alg (c p q) * T p * T q = alg g := by
      have h0 : Ideal.Quotient.mk I
          (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
            MvPolynomial.C g) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
      rw [map_sub, ← halgC, sub_eq_zero] at h0
      rw [← h0, map_sum]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [map_sum]
      refine Finset.sum_congr rfl (fun q _ => ?_)
      rw [map_mul, map_mul, halgC]
    have hg : κ g = 0 := by
      rw [hκa, ← hrel, Ideal.Quotient.eq_zero_iff_mem, map_sum]
      refine Ideal.sum_mem _ (fun p _ => ?_)
      rw [map_sum]
      refine Ideal.sum_mem _ (fun q _ => ?_)
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ (hT q)
    set I2 : Ideal (Polynomial (S ⧸ 𝔮)) := Ideal.span {Polynomial.X ^ 2} with hI2
    set I3 : Ideal (Polynomial (S ⧸ 𝔮)) := Ideal.span {Polynomial.X ^ 3} with hI3
    obtain ⟨ev, hev⟩ : ∃ ev : Polynomial (S ⧸ 𝔮) ⧸ I2 →+* (S ⧸ 𝔮),
        ∀ p, ev (Ideal.Quotient.mk I2 p) = p.eval 0 := by
      refine ⟨Ideal.Quotient.lift I2 (Polynomial.evalRingHom 0) ?_, fun p => ?_⟩
      · intro z hz
        obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton'.mp hz
        simp
      · rw [Ideal.Quotient.lift_mk]
        rfl
    have key2 : ∀ u v w : Polynomial (S ⧸ 𝔮), Ideal.Quotient.mk I2 u *
        Ideal.Quotient.mk I2 (v * Polynomial.X) * Ideal.Quotient.mk I2 (w * Polynomial.X) = 0 := by
      intro u v w
      rw [← map_mul, ← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_span_singleton.mpr ⟨u * v * w, by ring⟩
    set f₁ : MvPolynomial (Fin n) R →+* Polynomial (S ⧸ 𝔮) ⧸ I2 :=
      MvPolynomial.eval₂Hom ((Ideal.Quotient.mk I2).comp (Polynomial.C.comp κ))
        (fun q => Ideal.Quotient.mk I2 (Polynomial.C (a q) * Polynomial.X)) with hf₁
    have hf₁C : ∀ r, f₁ (MvPolynomial.C r) = Ideal.Quotient.mk I2 (Polynomial.C (κ r)) := by
      intro r
      rw [hf₁, MvPolynomial.eval₂Hom_C]
      rfl
    have hf₁X : ∀ q, f₁ (MvPolynomial.X q) =
        Ideal.Quotient.mk I2 (Polynomial.C (a q) * Polynomial.X) := by
      intro q
      rw [hf₁, MvPolynomial.eval₂Hom_X']
    have hG : f₁ (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C g) = 0 := by
      rw [map_sub, hf₁C, hg, map_zero, map_zero, sub_zero, map_sum]
      refine Finset.sum_eq_zero (fun p _ => ?_)
      rw [map_sum]
      refine Finset.sum_eq_zero (fun q _ => ?_)
      rw [map_mul, map_mul, hf₁C, hf₁X, hf₁X]
      exact key2 _ _ _
    have hI : I ≤ RingHom.ker f₁ :=
      (Ideal.span_singleton_le_iff_mem _).mpr (RingHom.mem_ker.mpr hG)
    obtain ⟨μ₁, hμ⟩ : ∃ μ₁ : M →+* Polynomial (S ⧸ 𝔮) ⧸ I2,
        ∀ F, μ₁ (Ideal.Quotient.mk I F) = f₁ F :=
      ⟨Ideal.Quotient.lift I f₁ (fun z hz => RingHom.mem_ker.mp (hI hz)),
        fun F => Ideal.Quotient.lift_mk _ _ _⟩
    have hμC : ∀ r, μ₁ (alg r) = Ideal.Quotient.mk I2 (Polynomial.C (κ r)) := by
      intro r
      rw [halgC, hμ, hf₁C]
    have hμX : ∀ q, μ₁ (T q) = Ideal.Quotient.mk I2 (Polynomial.C (a q) * Polynomial.X) := by
      intro q
      rw [hTdef, hμ, hf₁X]
    have hev_surj : Function.Surjective ev := fun d =>
      ⟨Ideal.Quotient.mk I2 (Polynomial.C d), by rw [hev, Polynomial.eval_C]⟩
    have hev_sq : ∀ z₁ z₂, ev z₁ = 0 → ev z₂ = 0 → z₁ * z₂ = 0 := by
      intro z₁ z₂ h₁ h₂
      obtain ⟨p₁, rfl⟩ := Ideal.Quotient.mk_surjective z₁
      obtain ⟨p₂, rfl⟩ := Ideal.Quotient.mk_surjective z₂
      rw [hev] at h₁ h₂
      have d1 : Polynomial.X ∣ p₁ :=
        Polynomial.X_dvd_iff.mpr (by rw [Polynomial.coeff_zero_eq_eval_zero]; exact h₁)
      have d2 : Polynomial.X ∣ p₂ :=
        Polynomial.X_dvd_iff.mpr (by rw [Polynomial.coeff_zero_eq_eval_zero]; exact h₂)
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_span_singleton.mpr (by rw [pow_two]; exact mul_dvd_mul d1 d2)
    have hc1 : ev.comp μ₁ = (Ideal.Quotient.mk 𝔮).comp β := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply]
        rw [← halgC, hμC, hev, Polynomial.eval_C, hκa]
      · intro q
        simp only [RingHom.comp_apply]
        rw [hμ, hf₁X, hev, Polynomial.eval_mul, Polynomial.eval_X, mul_zero]
        exact (Ideal.Quotient.eq_zero_iff_mem.mpr (hT q)).symm
    obtain ⟨L₁, hL₁a, hL₁b⟩ := hβL (S ⧸ 𝔮) (Polynomial (S ⧸ 𝔮) ⧸ I2) (Ideal.Quotient.mk 𝔮)
      μ₁ ev hev_surj hev_sq hc1
    have hL₁ : ∀ z, L₁ (β z) = μ₁ z := fun z => RingHom.congr_fun hL₁b z
    have hle : I3 ≤ I2 := Ideal.span_singleton_le_span_singleton.mpr ⟨Polynomial.X, by ring⟩
    obtain ⟨qf, hqf, hqf_surj⟩ : ∃ qf : Polynomial (S ⧸ 𝔮) ⧸ I3 →+* Polynomial (S ⧸ 𝔮) ⧸ I2,
        (∀ p, qf (Ideal.Quotient.mk I3 p) = Ideal.Quotient.mk I2 p) ∧ Function.Surjective qf :=
      ⟨Ideal.Quotient.factor hle, fun p => Ideal.Quotient.factor_mk hle p,
        Ideal.Quotient.factor_surjective hle⟩
    set ν₂ : R →+* Polynomial (S ⧸ 𝔮) ⧸ I3 :=
      (Ideal.Quotient.mk I3).comp (Polynomial.C.comp κ) with hν₂
    have hν₂a : ∀ r, ν₂ r = Ideal.Quotient.mk I3 (Polynomial.C (κ r)) := fun r => rfl
    have hqf_sq : ∀ z₁ z₂, qf z₁ = 0 → qf z₂ = 0 → z₁ * z₂ = 0 := by
      intro z₁ z₂ h₁ h₂
      obtain ⟨p₁, rfl⟩ := Ideal.Quotient.mk_surjective z₁
      obtain ⟨p₂, rfl⟩ := Ideal.Quotient.mk_surjective z₂
      rw [hqf, Ideal.Quotient.eq_zero_iff_mem] at h₁ h₂
      have d1 : Polynomial.X ^ 2 ∣ p₁ := Ideal.mem_span_singleton.mp h₁
      have d2 : Polynomial.X ^ 2 ∣ p₂ := Ideal.mem_span_singleton.mp h₂
      rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem]
      refine Ideal.mem_span_singleton.mpr ?_
      have : (Polynomial.X : Polynomial (S ⧸ 𝔮)) ^ 3 ∣ Polynomial.X ^ 2 * Polynomial.X ^ 2 :=
        ⟨Polynomial.X, by ring⟩
      exact this.trans (mul_dvd_mul d1 d2)
    have hc2 : qf.comp ν₂ = L₁.comp (β.comp alg) := by
      refine RingHom.ext fun r => ?_
      show qf (ν₂ r) = L₁ (β (alg r))
      rw [hν₂a, hqf, hL₁, hμC]
    obtain ⟨L₂, hL₂a, hL₂b⟩ := hαL (Polynomial (S ⧸ 𝔮) ⧸ I2) (Polynomial (S ⧸ 𝔮) ⧸ I3) L₁ ν₂
      qf hqf_surj hqf_sq hc2
    have hL₂ : ∀ z, qf (L₂ z) = L₁ z := fun z => RingHom.congr_fun hL₂a z
    have hν : ∀ r, L₂ (β (alg r)) = Ideal.Quotient.mk I3 (Polynomial.C (κ r)) := fun r => by
      rw [← hν₂a, ← hL₂b]
      rfl
    choose P hP using fun p => Ideal.Quotient.mk_surjective (I := I3) (L₂ (β (T p)))
    refine ⟨P, ?_, ?_⟩
    · intro p
      have e : Ideal.Quotient.mk I2 (P p) =
          Ideal.Quotient.mk I2 (Polynomial.C (a p) * Polynomial.X) := by
        rw [← hqf, hP p, hL₂, hL₁, hμX]
      exact Ideal.mem_span_singleton.mp (Ideal.Quotient.eq.mp e)
    · have h3 : Ideal.Quotient.mk I3
          (∑ p, ∑ q, Polynomial.C (κ (c p q)) * P p * P q) = 0 := by
        have e : Ideal.Quotient.mk I3 (∑ p, ∑ q, Polynomial.C (κ (c p q)) * P p * P q) =
            L₂ (β (∑ p, ∑ q, alg (c p q) * T p * T q)) := by
          rw [map_sum, map_sum, map_sum]
          refine Finset.sum_congr rfl (fun p _ => ?_)
          rw [map_sum, map_sum, map_sum]
          refine Finset.sum_congr rfl (fun q _ => ?_)
          rw [map_mul, map_mul, map_mul, map_mul, map_mul, map_mul, hP, hP, hν]
        rw [e, hrel, hν, hg, map_zero, map_zero]
      exact Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp h3)

  intro R _ n hn g c hc U Y φ _ j _ x hT
  rintro ⟨V, hxV, hsm⟩
  obtain ⟨S, _, β, 𝔮, h𝔮, hβ, hα, hpt⟩ := s0 R n g c φ j x V hxV hsm
  have hβL := s4 β hβ
  have hαL := s4 (β.comp (algebraMap R (wcQuadModelRing R n g c))) hα
  haveI := h𝔮
  let κ : R →+* S ⧸ 𝔮 :=
    (Ideal.Quotient.mk 𝔮).comp (β.comp (algebraMap R (wcQuadModelRing R n g c)))
  have hunit : IsUnit ((c.map κ) + (c.map κ).transpose).det := by
    have h1 : (c.map κ) + (c.map κ).transpose = κ.mapMatrix (c + c.transpose) := by
      ext p q
      simp
    rw [h1, ← RingHom.map_det]
    exact hc.map κ
  obtain ⟨a, ha⟩ := s1 (S ⧸ 𝔮) n hn (c.map κ) hunit
  obtain ⟨P, hP1, hP2⟩ := s3 R S n g c β hβL hαL 𝔮 (fun q => hpt _ (hT q)) a
  exact ha (s2 (S ⧸ 𝔮) n (c.map κ) a P hP1 hP2)

theorem wc_quad_model_base_change_isPullback : ∀ (R A : Type u) [CommRing R] [CommRing A] (n : ℕ) (g : R) (c : Matrix (Fin n) (Fin n) R) (ρ : R →+* A), ∃ m : Spec (.of (wcQuadModelRing A n (ρ g) (c.map ρ))) ⟶ Spec (.of (wcQuadModelRing R n g c)), IsPullback m (wcQuadModelStr A n (ρ g) (c.map ρ)) (wcQuadModelStr R n g c) (Spec.map (CommRingCat.ofHom ρ)) ∧ ∀ (x : Spec (.of (wcQuadModelRing A n (ρ g) (c.map ρ)))) (q : Fin n), Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.X q) ∈ (m x).asIdeal → Ideal.Quotient.mk (wcQuadModelIdeal A n (ρ g) (c.map ρ)) (MvPolynomial.X q) ∈ x.asIdeal :=
by
  intro R A _ _ n g c ρ
  have hgen : MvPolynomial.map ρ (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p *
      MvPolynomial.X q - MvPolynomial.C g) = ∑ p, ∑ q, MvPolynomial.C ((c.map ρ) p q) *
      MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C (ρ g) := by
    simp only [map_sub, map_sum, map_mul, MvPolynomial.map_C, MvPolynomial.map_X, Matrix.map_apply]
  have hle : wcQuadModelIdeal R n g c ≤
      Ideal.comap (MvPolynomial.map ρ) (wcQuadModelIdeal A n (ρ g) (c.map ρ)) := by
    rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap, hgen]
    exact Ideal.subset_span rfl
  let θ : wcQuadModelRing R n g c →+* wcQuadModelRing A n (ρ g) (c.map ρ) :=
    Ideal.quotientMap (wcQuadModelIdeal A n (ρ g) (c.map ρ)) (MvPolynomial.map ρ) hle
  have hθ : ∀ F, θ (Ideal.Quotient.mk (wcQuadModelIdeal R n g c) F) =
      Ideal.Quotient.mk (wcQuadModelIdeal A n (ρ g) (c.map ρ)) (MvPolynomial.map ρ F) :=
    fun F => Ideal.quotientMap_mk
  have halgR : ∀ r, algebraMap R (wcQuadModelRing R n g c) r =
      Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.C r) := fun r => by
    rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
  have halgA : ∀ a, algebraMap A (wcQuadModelRing A n (ρ g) (c.map ρ)) a =
      Ideal.Quotient.mk (wcQuadModelIdeal A n (ρ g) (c.map ρ)) (MvPolynomial.C a) := fun a => by
    rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
  have hsq : CommRingCat.ofHom (algebraMap R (wcQuadModelRing R n g c)) ≫ CommRingCat.ofHom θ =
      CommRingCat.ofHom ρ ≫ CommRingCat.ofHom
        (algebraMap A (wcQuadModelRing A n (ρ g) (c.map ρ))) := by
    ext r
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
    rw [halgR, hθ, MvPolynomial.map_C, halgA]

  have hker : ∀ s : Limits.PushoutCocone
      (CommRingCat.ofHom (algebraMap R (wcQuadModelRing R n g c))) (CommRingCat.ofHom ρ),
      ∀ a ∈ wcQuadModelIdeal A n (ρ g) (c.map ρ),
      MvPolynomial.eval₂Hom s.inr.hom
        (fun q => s.inl.hom (Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.X q)))
        a = 0 := by
    intro s a ha
    have hc : ∀ r, s.inr.hom (ρ r) =
        s.inl.hom (Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.C r)) := by
      intro r
      have h1 := congrArg (fun φ => φ.hom r) s.condition
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at h1
      rw [← h1, halgR]
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul]
    have h0 : MvPolynomial.eval₂Hom s.inr.hom
        (fun q => s.inl.hom (Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.X q)))
        (∑ p, ∑ q, MvPolynomial.C ((c.map ρ) p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C (ρ g)) =
        s.inl.hom (Ideal.Quotient.mk (wcQuadModelIdeal R n g c)
          (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
            MvPolynomial.C g)) := by
      simp only [map_sub, map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
        Matrix.map_apply, hc]
    have hz : Ideal.Quotient.mk (wcQuadModelIdeal R n g c)
          (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
            MvPolynomial.C g) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    rw [h0, hz, map_zero, mul_zero]
  let desc : ∀ s : Limits.PushoutCocone
      (CommRingCat.ofHom (algebraMap R (wcQuadModelRing R n g c))) (CommRingCat.ofHom ρ),
      CommRingCat.of (wcQuadModelRing A n (ρ g) (c.map ρ)) ⟶ s.pt := fun s =>
    CommRingCat.ofHom (Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom s.inr.hom
        (fun q => s.inl.hom (Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.X q))))
      (hker s))
  have hdesc : ∀ s F, (desc s).hom (Ideal.Quotient.mk (wcQuadModelIdeal A n (ρ g) (c.map ρ)) F) =
      MvPolynomial.eval₂Hom s.inr.hom
        (fun q => s.inl.hom (Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.X q))) F :=
    fun s F => rfl
  have hpo : IsPushout (CommRingCat.ofHom (algebraMap R (wcQuadModelRing R n g c)))
      (CommRingCat.ofHom ρ) (CommRingCat.ofHom θ)
      (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n (ρ g) (c.map ρ)))) := by
    refine IsPushout.of_isColimit' ⟨hsq⟩
      (Limits.PushoutCocone.IsColimit.mk _ desc ?_ ?_ ?_)
    · intro s
      have hc : ∀ r, s.inr.hom (ρ r) =
          s.inl.hom (Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.C r)) := by
        intro r
        have h1 := congrArg (fun φ => φ.hom r) s.condition
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at h1
        rw [← h1, halgR]
      ext1
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
        rw [hθ, MvPolynomial.map_C, hdesc, MvPolynomial.eval₂Hom_C, hc]
      · intro q
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
        rw [hθ, MvPolynomial.map_X, hdesc, MvPolynomial.eval₂Hom_X']
    · intro s
      ext a
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
      rw [halgA, hdesc, MvPolynomial.eval₂Hom_C]
    · intro s m' h1 h2
      ext1
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        have e := congrArg (fun φ => φ.hom a) h2
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at e
        simp only [RingHom.comp_apply]
        rw [hdesc, MvPolynomial.eval₂Hom_C, ← e, halgA]
      · intro q
        have e := congrArg (fun φ => φ.hom (Ideal.Quotient.mk (wcQuadModelIdeal R n g c)
          (MvPolynomial.X q))) h1
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at e
        simp only [RingHom.comp_apply]
        rw [hdesc, MvPolynomial.eval₂Hom_X', ← e, hθ, MvPolynomial.map_X]
  refine ⟨Spec.map (CommRingCat.ofHom θ), isPullback_SpecMap_of_isPushout _ _ _ _ hpo, ?_⟩
  intro x q hx
  have h : θ (Ideal.Quotient.mk (wcQuadModelIdeal R n g c) (MvPolynomial.X q)) ∈ x.asIdeal := hx
  rwa [hθ, MvPolynomial.map_X] at h

theorem wc_pfam_xwt_trait_odp_model (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F''] (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n)
    (D : wcLefschetzDatum F' F'' Y n) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (M' : ℕ) (Xu : Over (Spec (.of F''))) (h : Xu.left ⟶ wcProjK F'' M')
    (Δ : Set (wcProjK F'' M')) (lam : (wcP1Over F'').left ⟶ wcProjK F'' M')
    (p : D.Yt.left ⟶ Xu.left) (hH : wcPfamHyp D M' Xu h Δ lam p)
    (hPP : WeaklyEtale (Limits.pullback.fst (Over.mk (wcProjKStr F'' M')).hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (j : Fin D.m) (Vy Ty : (wcProjK F'' M').ProEt) (uy : Ty ⟶ Vy)
    (vy : Vy ⟶ wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP)
    (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : Vy.left ≅ Spec (.of A))
    (hVy : Vy.hom (e.inv (IsLocalRing.closedPoint A)) = lam (D.S j (IsLocalRing.closedPoint F'')))
    (L : Type u) [Field L] [IsSepClosed L] (eL : Ty.left ≅ Spec (.of L))
