    rw [← h2, Nat.card_eq_fintype_card]
    exact h4

  let W : (wcProjK F'' M').Opens := ⟨Δᶜ, hΔ.isOpen_compl⟩
  have hsm' : ∀ x : X, h x ∈ W → ∃ U' : X.Opens, x ∈ U' ∧ Smooth (U'.ι ≫ h) :=
