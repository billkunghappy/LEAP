    exact wc_ext_pull_surj_of_post_bij_ext_deg_acyclic D'.Φ _ D'.adj (SheafOfModules.unit _)
      (SheafOfModules.unit _) D'.μ H1 I (2 * (n - 1)) hvan

  intro z
  obtain ⟨y, hy⟩ := hEsurj (Θ₁.symm z)
