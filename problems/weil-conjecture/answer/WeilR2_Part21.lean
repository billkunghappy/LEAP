    obtain ⟨e⟩ := wc_et_supp_unit_ker_extZero_iso (Limits.pullback.fst U.hom i) m E
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology U.left) AddCommGrpCat.{u+1}) :=
