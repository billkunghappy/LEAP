    ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ eE.hom) F3)).trans (Category.assoc _ _ _)
  calc Limits.pullback.lift _ _ hc ≫ Limits.pullback.fst ((wcProEtPullback f).map a₀).left u ≫
