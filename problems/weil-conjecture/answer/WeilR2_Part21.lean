    have hcoc := wc_inj_complex_cocycle_exact ((constantSheaf (Scheme.smallEtaleTopology
        (Spec (.of A))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      (((wcEtPush π).mapHomologicalComplex (ComplexShape.up ℕ)).obj Ires.cocomplex) hKinj hH
    let P0 := (constantSheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))
    have hcoc' : ∀ (n : ℕ) (c : P0 ⟶ (wcEtPush π).obj (Ires.cocomplex.X n)),
