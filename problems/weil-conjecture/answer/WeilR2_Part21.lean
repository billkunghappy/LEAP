  have s5 : ∀ (K O : Type u) [Field K] [CommRing O] [Algebra K O] (n : ℕ) (e : O →+* K) (δ : Fin n → Derivation K O O) (G : O) (σ : Fin n → O) (B' : Matrix (Fin n) (Fin n) O) (M : Matrix (Fin n) (Fin n) K), M.det ≠ 0 → M.transpose = M → (∀ p, e (σ p) = 0) → (∀ i, δ i G = σ i) → (∀ i j, e (δ j (σ i)) = M i j) → G = ∑ p, ∑ q, B' p q * σ p * σ q → (B'.map e + (B'.map e).transpose).det ≠ 0 := by
