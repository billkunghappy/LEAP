      rw [hfibg]; exact Set.mem_singleton _
    exact this
  have hVy : Th.hom (eB.inv (IsLocalRing.closedPoint B)) =
      lam (D.S j (IsLocalRing.closedPoint F'')) := by
    rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply, hc]; exact hyb

  have hsp : v.left (e'.inv (IsLocalRing.closedPoint A')) ⤳
      g.left (eB.inv (IsLocalRing.closedPoint B)) := by
    rw [hc]; exact specializes_iff_mem_closure.mpr (hclξ yb (by rw [hyb]; exact hyΔ))
  haveI : WeaklyEtale (g.left ≫ (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom) := by
    rw [MorphismProperty.Over.w g]; exact Th.prop
  haveI : WeaklyEtale (wcGeomPoint F'' (Over.mk (wcProjKStr F'' M')) hPP).hom :=
