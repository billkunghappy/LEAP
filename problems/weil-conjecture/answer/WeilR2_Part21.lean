  have s1 : ∀ (K A : Type u) [CommRing K] [CommRing A] [IsLocalRing A] [Algebra K A],
      IsField K → Algebra.WeaklyEtale K A → IsField A := by
    intro K R _ _ _ _ hK hW
    letI := hK.toField
    have hμsurj : Function.Surjective (Algebra.TensorProduct.lmul' K (S := R)) := fun b =>
      ⟨b ⊗ₜ[K] (1 : R), by rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]⟩
    have hflatQ : Module.Flat (TensorProduct K R R)
