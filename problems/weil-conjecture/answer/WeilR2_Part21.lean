      have h1 : k (IsLocalRing.closedPoint ((Limits.pullback v.left g.left).presheaf.stalk t)) =
          e'.hom ((Limits.pullback.fst v.left g.left) ((Limits.pullback v.left g.left).fromSpecStalk t
            (IsLocalRing.closedPoint ((Limits.pullback v.left g.left).presheaf.stalk t)))) := by
        subst hkdef
        first | rfl | simp [Scheme.Hom.comp_apply]
      have h2 : ∀ y : Spec (CommRingCat.of A'), e'.hom (e'.inv y) = y := by
