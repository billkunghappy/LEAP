    show b.coord (Sum.inl i) (KaehlerDifferential.D K O (t q)) = _
    rw [← hb1 q, Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]
    by_cases hiq : i = q
    · subst hiq; simp
    · rw [if_neg (fun h => hiq (Sum.inl_injective h).symm), if_neg hiq]
  have hδζ : ∀ i k, δ i (ζ k) = 0 := by
    intro i k
    rw [← hδ i]
    show b.coord (Sum.inl i) (KaehlerDifferential.D K O (ζ k)) = 0
    rw [← hb2 k, Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]
    simp
  obtain ⟨hL, hZ, hHs⟩ := s1 K O n r e he hker t ζ δ hδt hδζ htm hζm G a H w hH hG
  have hσm : ∀ i, δ i G ∈ IsLocalRing.maximalIdeal O := fun i => by
    rw [← hker, RingHom.mem_ker]; exact hZ i
  have hP : IsLocalRing.maximalIdeal O = Ideal.span (Set.range (fun i => δ i G) ∪ Set.range ζ) :=
    s2 K O n r t (fun i => δ i G) ζ (a + a.transpose) ha hgen hσm hL
  let f : Fin n ⊕ Fin r → IsLocalRing.maximalIdeal O :=
    Sum.elim (fun i => ⟨δ i G, hσm i⟩) (fun k => ⟨ζ k, hζm k⟩)
  have hrange : Set.range (fun x => ((f x : IsLocalRing.maximalIdeal O) : O)) =
      Set.range (fun i => δ i G) ∪ Set.range ζ := by
    ext y
    simp only [Set.mem_range, Set.mem_union, Sum.exists, f, Sum.elim_inl, Sum.elim_inr]
  obtain ⟨hreg, hind⟩ := s3 O (n + r) hdim (Fin n ⊕ Fin r) f
