      exact I.sub_mem (hσI j) (I.sum_mem (fun i _ => I.mul_mem_right _ (hσI i)))
    have hdl : ∀ i, J.det * lam i ∈ I := by
      intro i
      have h3 : (J.adjugate.mulVec (J.mulVec lam)) i = J.det * lam i := by
        rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec]
