theorem wc_plt_fhcm_monomial_graded (K F : Type u) [Field K] [Field F] [Algebra K F]
    (gs : Finset (F × ℕ)) (hgs : ∀ q ∈ gs, 0 < q.2) (R : Subalgebra K (Polynomial F))
    (hR : R = Algebra.adjoin K
      ((fun q : F × ℕ => Polynomial.C q.1 * Polynomial.X ^ q.2) '' (gs : Set (F × ℕ)))) :
    ∃ (𝒜 : ℕ → Submodule K R) (_ : GradedAlgebra 𝒜),
      (∀ (e : ℕ) (x : R), x ∈ 𝒜 e ↔ ∃ a : F, (x : Polynomial F) = Polynomial.monomial e a) ∧
      (∀ x : R, x ∈ 𝒜 0 ↔ x ∈ Set.range (algebraMap K R)) ∧
      IsNoetherianRing R :=
by
  classical

  have hcomp : ∀ p ∈ R, ∀ e : ℕ, Polynomial.monomial e (p.coeff e) ∈ R := by
    intro p hp
    rw [hR] at hp ⊢
    induction hp using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨q, hq, rfl⟩ := hx
      intro e
      rw [Polynomial.coeff_C_mul_X_pow]
      split_ifs with h
      · subst h
        rw [← Polynomial.C_mul_X_pow_eq_monomial]
        exact Algebra.subset_adjoin ⟨q, hq, rfl⟩
      · rw [map_zero]; exact Subalgebra.zero_mem _
    | algebraMap k =>
      intro e
      rw [Polynomial.algebraMap_apply, Polynomial.coeff_C]
      split_ifs with h
      · subst h
        rw [Polynomial.monomial_zero_left, ← Polynomial.algebraMap_apply]
        exact Subalgebra.algebraMap_mem _ k
      · rw [map_zero]; exact Subalgebra.zero_mem _
    | add x y _ _ hx hy =>
      intro e
      rw [Polynomial.coeff_add, map_add]
      exact Subalgebra.add_mem _ (hx e) (hy e)
    | mul x y _ _ hx hy =>
      intro e
      rw [Polynomial.coeff_mul, map_sum]
      refine Subalgebra.sum_mem _ (fun ij hij => ?_)
      have hij' : ij.1 + ij.2 = e := by simpa using hij
      rw [← hij', ← Polynomial.monomial_mul_monomial]
      exact Subalgebra.mul_mem _ (hx ij.1) (hy ij.2)

  have hzero : ∀ p ∈ R, p.coeff 0 ∈ Set.range (algebraMap K F) := by
    intro p hp
    rw [hR] at hp
    induction hp using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨q, hq, rfl⟩ := hx
      refine ⟨0, ?_⟩
      rw [map_zero, Polynomial.coeff_C_mul_X_pow, if_neg (hgs q hq).ne]
    | algebraMap k =>
      exact ⟨k, by rw [Polynomial.algebraMap_apply, Polynomial.coeff_C_zero]⟩
    | add x y _ _ hx hy =>
      obtain ⟨a, ha⟩ := hx
      obtain ⟨b, hb⟩ := hy
      exact ⟨a + b, by rw [map_add, ha, hb, Polynomial.coeff_add]⟩
    | mul x y _ _ hx hy =>
      obtain ⟨a, ha⟩ := hx
      obtain ⟨b, hb⟩ := hy
      exact ⟨a * b, by rw [map_mul, ha, hb, Polynomial.mul_coeff_zero]⟩

  let 𝒜 : ℕ → Submodule K R := fun e =>
    { carrier := {x : R | ∃ a : F, (x : Polynomial F) = Polynomial.monomial e a}
      add_mem' := by
        rintro x y ⟨a, ha⟩ ⟨b, hb⟩
        exact ⟨a + b, by
          show (x : Polynomial F) + (y : Polynomial F) = _
          rw [ha, hb, map_add]⟩
      zero_mem' := ⟨0, by rw [map_zero]; rfl⟩
      smul_mem' := by
        rintro k x ⟨a, ha⟩
        exact ⟨k • a, by
          show k • (x : Polynomial F) = _
          rw [ha, Polynomial.smul_monomial]⟩ }
  have hmem : ∀ (e : ℕ) (x : R), x ∈ 𝒜 e ↔ ∃ a : F, (x : Polynomial F) = Polynomial.monomial e a :=
    fun e x => Iff.rfl

  haveI hGM : SetLike.GradedMonoid 𝒜 :=
    { one_mem := (hmem 0 1).mpr ⟨1, by rw [Polynomial.monomial_zero_one]; rfl⟩
      mul_mem := by
        intro i j x y hx hy
        obtain ⟨a, ha⟩ := (hmem i x).mp hx
        obtain ⟨b, hb⟩ := (hmem j y).mp hy
        refine (hmem (i + j) (x * y)).mpr ⟨a * b, ?_⟩
        show (x : Polynomial F) * (y : Polynomial F) = _
        rw [ha, hb, Polynomial.monomial_mul_monomial] }

  have hstar : ∀ (y : DirectSum ℕ (fun e => 𝒜 e)) (e : ℕ),
      ((y e : R) : Polynomial F) = Polynomial.monomial e
        (((DirectSum.coeAddMonoidHom 𝒜 y : R) : Polynomial F).coeff e) := by
    intro y e
    induction y using DirectSum.induction_on with
    | zero => simp
    | of i z =>
      obtain ⟨a, ha⟩ := (hmem i z).mp z.2
      rw [DirectSum.coeAddMonoidHom_of, ha]
      by_cases hie : i = e
      · subst hie
        rw [DirectSum.of_eq_same, ha, Polynomial.coeff_monomial_same]
      · rw [DirectSum.of_eq_of_ne _ _ _ (Ne.symm hie), Polynomial.coeff_monomial_of_ne _ (Ne.symm hie), map_zero]
        rfl
    | add y₁ y₂ h₁ h₂ =>
      rw [DirectSum.add_apply, map_add]
      push_cast
      rw [Polynomial.coeff_add, map_add, h₁, h₂]

  have hint : DirectSum.IsInternal 𝒜 := by
    refine ⟨fun y y' h => ?_, fun x => ?_⟩
    · refine DFinsupp.ext (fun e => ?_)
      have h1 := hstar y e
      have h2 := hstar y' e
      rw [h] at h1
      exact Subtype.ext (Subtype.ext (h1.trans h2.symm))
    · refine ⟨∑ e ∈ (x : Polynomial F).support, DirectSum.of (fun e => 𝒜 e) e
        ⟨⟨Polynomial.monomial e ((x : Polynomial F).coeff e), hcomp _ x.2 e⟩, ⟨_, rfl⟩⟩, ?_⟩
      rw [map_sum]
      simp only [DirectSum.coeAddMonoidHom_of]
      apply Subtype.ext
      rw [AddSubmonoidClass.coe_finsetSum]
      exact (Polynomial.as_sum_support _).symm
  let dec : DirectSum.Decomposition 𝒜 := hint.chooseDecomposition
  refine ⟨𝒜, { toGradedMonoid := hGM, toDecomposition := dec }, hmem, ?_, ?_⟩

  · intro x
    constructor
    · intro hx
      obtain ⟨a, ha⟩ := (hmem 0 x).mp hx
      obtain ⟨k, hk⟩ := hzero _ x.2
      refine ⟨k, Subtype.ext ?_⟩
      rw [Subalgebra.coe_algebraMap, Polynomial.algebraMap_apply, hk, ha,
        Polynomial.coeff_monomial_same, Polynomial.monomial_zero_left]
    · rintro ⟨k, rfl⟩
      refine (hmem 0 _).mpr ⟨algebraMap K F k, ?_⟩
      rw [Subalgebra.coe_algebraMap, Polynomial.algebraMap_apply, Polynomial.monomial_zero_left]

  · have hfg : R.FG := by
      rw [hR]
      exact ⟨gs.image (fun q => Polynomial.C q.1 * Polynomial.X ^ q.2), by rw [Finset.coe_image]⟩
    haveI : Algebra.FiniteType K R := (Subalgebra.fg_iff_finiteType R).mp hfg
    exact Algebra.FiniteType.isNoetherianRing K R

theorem wc_plt_fhcm_chart_ring (K F : Type u) [Field K] [Field F] [Algebra K F] (N : ℕ)
    (u : Fin (N + 1) → F) (hu : ∀ i, u i ≠ 0) (A : Fin (N + 1) → Subalgebra K F)
    (h1 : ∀ i j, u j / u i ∈ A i) (h2 : ∀ i, (A i).FG)
    (h2' : ∀ i, ∀ a ∈ A i, IsIntegral (Algebra.adjoin K (Set.range fun j => u j / u i)) a)
    (h3 : ∀ i j, ∀ a ∈ A i, ∃ m : ℕ, a * (u i / u j) ^ m ∈ A j) :
    ∃ gs : Finset (F × ℕ), (∀ q ∈ gs, 0 < q.2) ∧ (∀ j, (u j, 1) ∈ gs) ∧
      ∀ R : Subalgebra K (Polynomial F), R = Algebra.adjoin K
        ((fun q : F × ℕ => Polynomial.C q.1 * Polynomial.X ^ q.2) '' (gs : Set (F × ℕ))) →
      (∀ i, ∀ p ∈ R, ∀ e : ℕ, p.coeff e / u i ^ e ∈ A i) ∧
      (∀ i, ∀ a ∈ A i, ∃ e : ℕ, Polynomial.C (a * u i ^ e) * Polynomial.X ^ e ∈ R) ∧
      (∀ p ∈ R,
        IsIntegral (Algebra.adjoin K (Set.range fun j => Polynomial.C (u j) * Polynomial.X)) p) :=
by
  classical

  have L1 : ∀ (c : F) (B : Subalgebra K F) (S : Set (Polynomial F)),
      (∀ p ∈ S, ∀ e : ℕ, p.coeff e / c ^ e ∈ B) →
      ∀ p ∈ Algebra.adjoin K S, ∀ e : ℕ, p.coeff e / c ^ e ∈ B := by
    intro c B S hS p hp
    induction hp using Algebra.adjoin_induction with
    | mem x hx => exact hS x hx
    | algebraMap k =>
      intro e
      rw [Polynomial.algebraMap_apply, Polynomial.coeff_C]
      split_ifs with h
      · subst h
        rw [pow_zero, div_one]
        exact B.algebraMap_mem k
      · rw [zero_div]
        exact B.zero_mem
    | add x y _ _ hx hy =>
      intro e
      rw [Polynomial.coeff_add, add_div]
      exact add_mem (hx e) (hy e)
    | mul x y _ _ hx hy =>
      intro e
      rw [Polynomial.coeff_mul, Finset.sum_div]
      refine Subalgebra.sum_mem _ (fun z hz => ?_)
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hz
      rw [← hz, pow_add, mul_div_mul_comm]
      exact mul_mem (hx z.1) (hy z.2)

  have L2 : ∀ (c : F) (R : Subalgebra K (Polynomial F)),
      Polynomial.C c * Polynomial.X ∈ R → ∀ (S : Set F),
      (∀ g ∈ S, ∃ e : ℕ, Polynomial.C (g * c ^ e) * Polynomial.X ^ e ∈ R) →
      ∀ a ∈ Algebra.adjoin K S, ∃ e : ℕ, ∀ e' : ℕ, e ≤ e' →
        Polynomial.C (a * c ^ e') * Polynomial.X ^ e' ∈ R := by
    intro c R hc S hS
    have shift : ∀ (a : F) (e k : ℕ), Polynomial.C (a * c ^ (e + k)) * Polynomial.X ^ (e + k) =
        Polynomial.C (a * c ^ e) * Polynomial.X ^ e * (Polynomial.C c * Polynomial.X) ^ k := by
      intro a e k
      simp only [pow_add, mul_pow, Polynomial.C_mul, Polynomial.C_pow]
      ring
    have mono : ∀ (a : F) (e : ℕ), Polynomial.C (a * c ^ e) * Polynomial.X ^ e ∈ R →
        ∀ e', e ≤ e' → Polynomial.C (a * c ^ e') * Polynomial.X ^ e' ∈ R := by
      intro a e h e' he'
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le he'
      rw [shift]
      exact mul_mem h (pow_mem hc k)
    intro a ha
    induction ha using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨e, he⟩ := hS x hx
      exact ⟨e, mono x e he⟩
    | algebraMap k =>
      refine ⟨0, fun e' _ => ?_⟩
      have : Polynomial.C (algebraMap K F k * c ^ e') * Polynomial.X ^ e' =
          algebraMap K (Polynomial F) k * (Polynomial.C c * Polynomial.X) ^ e' := by
        rw [Polynomial.algebraMap_apply, mul_pow, Polynomial.C_mul, Polynomial.C_pow]
        ring
      rw [this]
      exact mul_mem (R.algebraMap_mem k) (pow_mem hc e')
    | add x y _ _ hx hy =>
      obtain ⟨e1, h1⟩ := hx
      obtain ⟨e2, h2⟩ := hy
      refine ⟨max e1 e2, fun e' he' => ?_⟩
      rw [add_mul, Polynomial.C_add, add_mul]
      exact add_mem (h1 e' (le_of_max_le_left he')) (h2 e' (le_of_max_le_right he'))
    | mul x y _ _ hx hy =>
      obtain ⟨e1, h1⟩ := hx
      obtain ⟨e2, h2⟩ := hy
      refine ⟨e1 + e2, fun e' he' => ?_⟩
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le (le_trans (Nat.le_add_right e1 e2) he')
      have hk : e2 ≤ k := by omega
      have : Polynomial.C (x * y * c ^ (e1 + k)) * Polynomial.X ^ (e1 + k) =
          Polynomial.C (x * c ^ e1) * Polynomial.X ^ e1 *
            (Polynomial.C (y * c ^ k) * Polynomial.X ^ k) := by
        simp only [pow_add, Polynomial.C_mul, Polynomial.C_pow]
        ring
      rw [this]
      exact mul_mem (h1 e1 le_rfl) (h2 k hk)

  have L3 : ∀ (c : F) (Θ : Subalgebra K (Polynomial F)) (T : Subalgebra K F),
      (∀ t ∈ T, ∃ d : ℕ, ∀ e : ℕ, d ≤ e →
        Polynomial.C (t * c ^ e) * Polynomial.X ^ e ∈ Θ) →
      ∀ (a : F), IsIntegral T a →
      ∃ d : ℕ, ∀ n : ℕ, d ≤ n → IsIntegral Θ (Polynomial.C (a * c ^ n) * Polynomial.X ^ n) := by
    intro c Θ T hT a ha
    obtain ⟨p, hpm, hpa⟩ := ha
    choose D hD using hT
    refine ⟨(Finset.range (p.natDegree + 1)).sup (fun l => D (p.coeff l) (p.coeff l).2),
      fun n hn => ?_⟩
    set ι : T →+* Polynomial F := Polynomial.C.comp (algebraMap T F) with hι
    set s : Polynomial F := Polynomial.C (c ^ n) * Polynomial.X ^ n with hs
    set p' := p.map ι with hp'
    set q := p'.scaleRoots s with hq
    have hp'm : p'.Monic := hpm.map ι
    have hp'deg : p'.natDegree = p.natDegree := hpm.natDegree_map ι
    have hqm : q.Monic := (Polynomial.monic_scaleRoots_iff s).mpr hp'm
    have hev : Polynomial.eval₂ (RingHom.id _) (Polynomial.C a) p' = 0 := by
      rw [hp', Polynomial.eval₂_map, RingHom.id_comp, hι,
        ← Polynomial.hom_eval₂ p (algebraMap T F) Polynomial.C a, hpa, map_zero]
    have hevq : Polynomial.eval₂ (RingHom.id _) (Polynomial.C (a * c ^ n) * Polynomial.X ^ n) q
        = 0 := by
      have := Polynomial.scaleRoots_eval₂_eq_zero (RingHom.id _) (s := s) hev
      have e1 : (RingHom.id (Polynomial F)) s * Polynomial.C a =
          Polynomial.C (a * c ^ n) * Polynomial.X ^ n := by
        rw [RingHom.id_apply, hs, Polynomial.C_mul]
        ring
      rw [e1] at this
      exact this
    have hcoeff : ∀ l, q.coeff l ∈ Θ := by
      intro l
      rw [hq, Polynomial.coeff_scaleRoots, hp'deg, hp', Polynomial.coeff_map]
      rcases lt_trichotomy l p.natDegree with hl | hl | hl
      · have hle : D (p.coeff l) (p.coeff l).2 ≤ n * (p.natDegree - l) := by
          have h1' : D (p.coeff l) (p.coeff l).2 ≤
              (Finset.range (p.natDegree + 1)).sup (fun l => D (p.coeff l) (p.coeff l).2) :=
            Finset.le_sup (f := fun l => D (p.coeff l) (p.coeff l).2)
              (Finset.mem_range.mpr (by omega))
          have h2' : n ≤ n * (p.natDegree - l) := Nat.le_mul_of_pos_right n (by omega)
          omega
        have := hD (p.coeff l) (p.coeff l).2 _ hle
        have e2 : ι (p.coeff l) * s ^ (p.natDegree - l) =
            Polynomial.C ((p.coeff l : F) * c ^ (n * (p.natDegree - l))) *
              Polynomial.X ^ (n * (p.natDegree - l)) := by
          rw [hι, hs, RingHom.comp_apply, mul_pow, ← Polynomial.C_pow, ← pow_mul, ← pow_mul,
            Polynomial.C_mul, mul_assoc]
          rfl
        rw [e2]
        exact this
      · subst hl
        rw [hpm.coeff_natDegree, map_one, Nat.sub_self, pow_zero, mul_one]
        exact Θ.one_mem
      · rw [Polynomial.coeff_eq_zero_of_natDegree_lt hl, map_zero, zero_mul]
        exact Θ.zero_mem
    have hlifts : q ∈ Polynomial.lifts (algebraMap Θ (Polynomial F)) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro l
      exact ⟨⟨q.coeff l, hcoeff l⟩, rfl⟩
    obtain ⟨q0, hq0, -, hq0m⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlifts hqm
    refine ⟨q0, hq0m, ?_⟩
    rw [← Polynomial.eval_map, hq0, ← Polynomial.eval₂_id]
    exact hevq

  set Θ : Subalgebra K (Polynomial F) :=
    Algebra.adjoin K (Set.range fun j => Polynomial.C (u j) * Polynomial.X) with hΘ
  choose G hG using h2
  have hGA : ∀ i, ∀ g ∈ G i, g ∈ A i := fun i g hg => by
    rw [← hG i]; exact Algebra.subset_adjoin hg
  have hTi : ∀ i, ∀ t ∈ Algebra.adjoin K (Set.range fun j => u j / u i), ∃ d : ℕ, ∀ e, d ≤ e →
      Polynomial.C (t * u i ^ e) * Polynomial.X ^ e ∈ Θ := by
    intro i
    refine L2 (u i) Θ (Algebra.subset_adjoin ⟨i, rfl⟩) _ ?_
    rintro _ ⟨j, rfl⟩
    refine ⟨1, ?_⟩
    rw [pow_one, div_mul_cancel₀ _ (hu i), pow_one]
    exact Algebra.subset_adjoin ⟨j, rfl⟩
  have hev : ∀ᶠ n in Filter.atTop, 1 ≤ n ∧ ∀ i, ∀ g ∈ G i,
      (∀ j, g * (u i / u j) ^ n ∈ A j) ∧
        IsIntegral Θ (Polynomial.C (g * u i ^ n) * Polynomial.X ^ n) := by
    refine (Filter.eventually_ge_atTop 1).and ?_
    rw [Filter.eventually_all]
    intro i
    rw [Filter.eventually_all_finset]
    intro g hg
    refine Filter.Eventually.and ?_ ?_
    · rw [Filter.eventually_all]
      intro j
      obtain ⟨m, hm⟩ := h3 i j g (hGA i g hg)
      rw [Filter.eventually_atTop]
      refine ⟨m, fun n hn => ?_⟩
      obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hn
      rw [pow_add, ← mul_assoc]
      exact mul_mem hm (pow_mem (h1 j i) k)
    · obtain ⟨d, hd⟩ := L3 (u i) Θ _ (hTi i) g (h2' i g (hGA i g hg))
      rw [Filter.eventually_atTop]
      exact ⟨d, hd⟩
  obtain ⟨n, hn1, hgood⟩ := hev.exists
  set gs : Finset (F × ℕ) := (Finset.univ.image fun j => (u j, 1)) ∪
      Finset.univ.biUnion (fun i => (G i).image fun g => (g * u i ^ n, n)) with hgs
  have hgsj : ∀ j, (u j, 1) ∈ gs := fun j =>
    Finset.mem_union_left _ (Finset.mem_image.mpr ⟨j, Finset.mem_univ _, rfl⟩)
  have hgsg : ∀ i, ∀ g ∈ G i, (g * u i ^ n, n) ∈ gs := fun i g hg =>
    Finset.mem_union_right _ (Finset.mem_biUnion.mpr
      ⟨i, Finset.mem_univ _, Finset.mem_image.mpr ⟨g, hg, rfl⟩⟩)
  have hmem : ∀ q ∈ gs, (∃ j, q = (u j, 1)) ∨ ∃ i, ∃ g ∈ G i, q = (g * u i ^ n, n) := by
    intro q hq
    rcases Finset.mem_union.mp hq with hq | hq
    · obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp hq
      exact Or.inl ⟨j, rfl⟩
    · obtain ⟨i, -, hq⟩ := Finset.mem_biUnion.mp hq
      obtain ⟨g, hg, rfl⟩ := Finset.mem_image.mp hq
      exact Or.inr ⟨i, g, hg, rfl⟩
  refine ⟨gs, ?_, hgsj, ?_⟩
  · intro q hq
    rcases hmem q hq with ⟨j, rfl⟩ | ⟨i, g, hg, rfl⟩
    · exact Nat.one_pos
    · exact hn1
  intro R hR
  subst hR
  have hgen : ∀ q ∈ gs, Polynomial.C q.1 * Polynomial.X ^ q.2 ∈
      Algebra.adjoin K ((fun q : F × ℕ => Polynomial.C q.1 * Polynomial.X ^ q.2) ''
        (gs : Set (F × ℕ))) := fun q hq => Algebra.subset_adjoin ⟨q, Finset.mem_coe.mpr hq, rfl⟩
  refine ⟨fun i p hp e => ?_, fun i a ha => ?_, fun p hp => ?_⟩
  · refine L1 (u i) (A i) _ ?_ p hp e
    rintro _ ⟨q, hq, rfl⟩ e'
    rw [Polynomial.coeff_C_mul_X_pow]
    split_ifs with he
    · subst he
      rcases hmem q hq with ⟨j, rfl⟩ | ⟨k, g, hg, rfl⟩
      · show u j / u i ^ 1 ∈ A i
        rw [pow_one]
        exact h1 i j
      · show g * u k ^ n / u i ^ n ∈ A i
        rw [mul_div_assoc, ← div_pow]
        exact (hgood k g hg).1 i
    · rw [zero_div]
      exact (A i).zero_mem
  · have hc : Polynomial.C (u i) * Polynomial.X ∈
        Algebra.adjoin K ((fun q : F × ℕ => Polynomial.C q.1 * Polynomial.X ^ q.2) ''
          (gs : Set (F × ℕ))) := by
      have := hgen (u i, 1) (hgsj i)
      rw [pow_one] at this
      exact this
    obtain ⟨e, he⟩ := L2 (u i) _ hc (G i : Set F)
      (fun g hg => ⟨n, hgen (g * u i ^ n, n) (hgsg i g hg)⟩) a (by rw [hG i]; exact ha)
    exact ⟨e, he e le_rfl⟩
  · induction hp using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨q, hq, rfl⟩ := hx
      rcases hmem q (Finset.mem_coe.mp hq) with ⟨j, rfl⟩ | ⟨k, g, hg, rfl⟩
      · have hj : Polynomial.C (u j) * Polynomial.X ^ 1 ∈ Θ := by
          rw [pow_one]
          exact Algebra.subset_adjoin ⟨j, rfl⟩
        have : IsIntegral Θ (algebraMap Θ (Polynomial F) ⟨_, hj⟩) := isIntegral_algebraMap
        exact this
      · exact (hgood k g hg).2
    | algebraMap k =>
      rw [IsScalarTower.algebraMap_apply K Θ (Polynomial F)]
      exact isIntegral_algebraMap
    | add x y _ _ hx hy => exact hx.add hy
    | mul x y _ _ hx hy => exact hx.mul hy

theorem wc_plt_fhcm_scheme_datum (K : Type u) [Field K] (N : ℕ)
    (Z : Scheme.{u}) [IrreducibleSpace Z] (ν : Z ⟶ wcProjK K N) [IsFinite ν] [Surjective ν]
    (U : Fin (N + 1) → Z.Opens)
    (hU : ∀ i, U i = ν ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X i)) :
    ∃ (F : Type u) (_ : Field F) (_ : Algebra K F) (u : Fin (N + 1) → F)
      (A : Fin (N + 1) → Subalgebra K F) (ε : ∀ i, Γ(Z, U i) →+* F),
      (∀ i, u i ≠ 0) ∧ (∀ i j, u j / u i ∈ A i) ∧ (∀ i, (A i).FG) ∧
      (∀ i, ∀ a ∈ A i, IsIntegral (Algebra.adjoin K (Set.range fun j => u j / u i)) a) ∧
      (∀ i j, ∀ a ∈ A i, ∃ m : ℕ, a * (u i / u j) ^ m ∈ A j) ∧
      (∀ (e : ℕ) (p : MvPolynomial (Fin (N + 1)) K),
        p ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e → MvPolynomial.aeval u p = 0 →
        p = 0) ∧
      (∀ i a, a ∈ A i ↔ a ∈ Set.range (ε i)) ∧
      (∀ i (b : Γ(Z, U i)), ε i b = 0 → ∀ z ∈ U i, z ∉ Z.basicOpen b) ∧
      (∀ i j (b : Γ(Z, U i)) (b' : Γ(Z, U j)) (k : ℕ),
        ε i b = ε j b' * (u j / u i) ^ k → ∀ z, z ∈ U i → z ∈ U j →
        (z ∈ Z.basicOpen b ↔ z ∈ Z.basicOpen b')) ∧
      (∀ i (L : MvPolynomial (Fin (N + 1)) K),
        L ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 →
        ∃ σ : Γ(Z, U i), ε i σ = MvPolynomial.aeval u L / u i ∧
          ∀ z ∈ U i, (z ∈ Z.basicOpen σ ↔ ν z ∈ @Proj.basicOpen _ _ _ _ _
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) MvPolynomial.gradedAlgebra L)) ∧
      (∀ i, IsAffineOpen (U i)) ∧
      (∀ z : Z, ∃ i, z ∈ U i) :=
by
  classical
  obtain rfl : U = fun i => ν ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X i) := funext hU
  beta_reduce

  have hX : ∀ i : Fin (N + 1), (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun i =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K i)
  have hX' : ∀ j : Fin (N + 1), (MvPolynomial.X j : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (1 • 1) := fun j => by
    simpa using hX j

  have S1 : ∀ (i : Fin (N + 1)) (e : ℕ) (L : MvPolynomial (Fin (N + 1)) K)
      (hL : L ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (e • 1)),
      HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (hX i) e L hL =
      MvPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) K))).comp
          (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))
        (fun j => HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX i) 1 (MvPolynomial.X j) (hX' j))
        L := by
    intro i e L hL
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, ← HomogeneousLocalization.algebraMap_apply,
      MvPolynomial.eval₂_comp_left]
    have hg : (algebraMap (HomogeneousLocalization
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) K)))
          (Localization (Submonoid.powers (MvPolynomial.X i :
            MvPolynomial (Fin (N + 1)) K)))).comp
        ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) K))).comp
          (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0))) =
        (algebraMap (MvPolynomial (Fin (N + 1)) K)
          (Localization (Submonoid.powers (MvPolynomial.X i :
            MvPolynomial (Fin (N + 1)) K)))).comp MvPolynomial.C := by
      ext k
      simp only [RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
      rw [← Localization.mk_one_eq_algebraMap]
      rfl
    have hw : (⇑(algebraMap (HomogeneousLocalization
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) K)))
          (Localization (Submonoid.powers (MvPolynomial.X i :
            MvPolynomial (Fin (N + 1)) K)))) ∘
        (fun j => HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX i) 1 (MvPolynomial.X j)
            (hX' j))) =
        fun j => IsLocalization.mk' (Localization (Submonoid.powers (MvPolynomial.X i :
            MvPolynomial (Fin (N + 1)) K)))
          (MvPolynomial.X j) (⟨MvPolynomial.X i, Submonoid.mem_powers _⟩ :
            Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) K)) := by
      funext j
      simp only [Function.comp_apply, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk']
      congr 1
      ext
      simp
    rw [hg, hw, Localization.mk_eq_mk', eq_comm, IsLocalization.eq_mk'_iff_mul_eq]
    have hL' : L.IsHomogeneous e := by
      have := (MvPolynomial.mem_homogeneousSubmodule _ _).mp hL
      simpa using this
    conv_rhs => rw [L.as_sum]
    conv_lhs => rw [L.as_sum]
    rw [MvPolynomial.eval₂_sum, map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    have hdeg : d.degree = e := by
      by_contra hne
      exact (MvPolynomial.mem_support_iff.mp hd) (hL'.coeff_eq_zero hne)
    rw [MvPolynomial.eval₂_monomial, MvPolynomial.monomial_eq, map_mul, RingHom.comp_apply,
      mul_assoc]
    congr 1
    have hdeg' : d.degree = ∑ j ∈ d.support, d j := rfl
    rw [Finsupp.prod, Finsupp.prod, map_prod, map_pow, ← hdeg, hdeg',
      ← Finset.prod_pow_eq_pow_sum, ← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl (fun j _ => ?_)
    rw [← mul_pow, map_pow]
    congr 1
    have := IsLocalization.mk'_spec (Localization (Submonoid.powers (MvPolynomial.X i :
        MvPolynomial (Fin (N + 1)) K)))
      (MvPolynomial.X j) (⟨MvPolynomial.X i, Submonoid.mem_powers _⟩ :
        Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) K))
    simpa using this

  obtain ⟨η, hgen⟩ : ∃ η : Z, IsGenericPoint η Set.univ := ⟨_, genericPoint_spec Z⟩
  have hbot_prime : (⊥ : HomogeneousIdeal
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)).toIdeal.IsPrime := by
    rw [HomogeneousIdeal.toIdeal_bot]; exact Ideal.isPrime_bot
  have hX0irr : (MvPolynomial.X 0 : MvPolynomial (Fin (N + 1)) K) ∈
      HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) := by
    rw [HomogeneousIdeal.mem_irrelevant_iff]
    have h0 : MvPolynomial.homogeneousComponent 0
        (MvPolynomial.X 0 : MvPolynomial (Fin (N + 1)) K) = 0 := by
      rw [MvPolynomial.homogeneousComponent_zero]; simp
    rw [← MvPolynomial.decomposition.decompose'_apply] at h0
    exact h0
  let ζ : ↥(wcProjK K N) :=
    (⟨⊥, hbot_prime, fun hle => by
      have := HomogeneousIdeal.mem_iff.mpr (hle hX0irr)
      rw [HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at this
      exact MvPolynomial.X_ne_zero _ this⟩ :
        ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K))
  have GP : ∀ f : MvPolynomial (Fin (N + 1)) K, f ≠ 0 →
      f ∉ (ν η).asHomogeneousIdeal := by
    intro f hf
    obtain ⟨z₀, hz₀⟩ := ν.surjective ζ
    have hmem : z₀ ∈ ν ⁻¹ᵁ Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) f := by
      change ν z₀ ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) f
      rw [hz₀, Proj.mem_basicOpen]
      intro hfz
      have := HomogeneousIdeal.mem_iff.mpr hfz
      rw [HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at this
      exact hf this
    have hη := (hgen.mem_open_set_iff (ν ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) f).isOpen).mpr ⟨z₀, trivial, hmem⟩
    exact (Proj.mem_basicOpen _ f _).mp hη
  have hyD : ∀ i : Fin (N + 1), ν η ∈ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i) := fun i =>
    (Proj.mem_basicOpen _ _ _).mpr (GP _ (MvPolynomial.X_ne_zero i))
  have hη : ∀ i : Fin (N + 1), η ∈ ν ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i) := hyD

  have hpow : ∀ (x : wcProjK K N) (i : Fin (N + 1))
      (_ : x ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X i)),
      Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) K) ≤
        @Ideal.primeCompl _ _ (ProjectiveSpectrum.asHomogeneousIdeal x).toIdeal x.isPrime :=
    fun x i hx => Submonoid.powers_le.mpr ((Proj.mem_basicOpen _ _ _).mp hx)

  have UCa : ∀ (𝔭 : Ideal (MvPolynomial (Fin (N + 1)) K)) [𝔭.IsPrime] (i : Fin (N + 1))
      (h : Submonoid.powers (MvPolynomial.X i) ≤ 𝔭.primeCompl) (e : ℕ)
      (L : MvPolynomial (Fin (N + 1)) K)
      (hL : L ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (e • 1)),
      IsUnit (HomogeneousLocalization.mapId (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) h
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (hX i) e L hL)) ↔ L ∉ 𝔭 := by
    intro 𝔭 _ i h e L hL
    rw [← HomogeneousLocalization.isUnit_iff_isUnit_val]
    show IsUnit (Localization.mk L ⟨MvPolynomial.X i ^ e, h ⟨e, rfl⟩⟩) ↔ _
    rw [Localization.mk_eq_mk', IsLocalization.AtPrime.isUnit_mk'_iff]
    rfl
  have UCx : ∀ (x : wcProjK K N) (i : Fin (N + 1))
      (hx : x ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X i)) (e : ℕ) (L : MvPolynomial (Fin (N + 1)) K)
      (hL : L ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (e • 1)),
      IsUnit (HomogeneousLocalization.mapId (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (hpow x i hx)
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (hX i) e L hL)) ↔ L ∉ x.asHomogeneousIdeal := by
    intro x i hx e L hL
    haveI := x.isPrime
    exact UCa _ i _ e L hL

  have G : ∀ (i : Fin (N + 1)) (x : wcProjK K N)
      (hx : x ∈ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X i))
      (h : Submonoid.powers (MvPolynomial.X i) ≤
        @Ideal.primeCompl _ _ (ProjectiveSpectrum.asHomogeneousIdeal x).toIdeal x.isPrime)
      (s : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X i)),
      ((wcProjK K N).presheaf.germ _ x hx).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X i)).hom s) =
      (Proj.stalkIso (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) x).inv.hom
        (HomogeneousLocalization.mapId (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          h s) := by
    intro i x hx h s
    have := congrArg (fun φ => (ConcreteCategory.hom φ) s)
      (ProjectiveSpectrum.Proj.awayToSection_germ
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i) x hx)
    exact this

  have CE : ∀ (i : Fin (N + 1)) (z : Z) (hz : z ∈ ν ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i))
      (s : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X i)),
      (Z.evaluation _ z hz).hom ((ν.app (Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i))).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X i)).hom s)) =
      (ν.residueFieldMap z).hom (((wcProjK K N).residue (ν z)).hom
        ((Proj.stalkIso (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (ν z)).inv.hom
          (HomogeneousLocalization.mapId (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (hpow (ν z) i hz) s))) := by
    intro i z hz s
    refine (Scheme.evaluation_naturality_apply ν z hz _).symm.trans ?_
    congr 1
    have h1 := congrArg (fun φ => (ConcreteCategory.hom φ)
      ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X i)).hom s)) (Scheme.germ_residue (wcProjK K N) (ν z) hz)
    refine h1.symm.trans ?_
    change ((wcProjK K N).residue (ν z)).hom (((wcProjK K N).presheaf.germ _ (ν z) hz).hom
      ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X i)).hom s)) = _
    rw [G i (ν z) hz (hpow (ν z) i hz) s]

  have CB : ∀ (i : Fin (N + 1)) (z : Z) (hz : z ∈ ν ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i))
      (s : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X i)),
      z ∈ Z.basicOpen ((ν.app (Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i))).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X i)).hom s)) ↔
      IsUnit (HomogeneousLocalization.mapId (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (hpow (ν z) i hz) s) := by
    intro i z hz s
    rw [← Scheme.preimage_basicOpen]
    change ν z ∈ (wcProjK K N).basicOpen
      ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X i)).hom s) ↔ _
    rw [Scheme.mem_basicOpen (wcProjK K N) _ (ν z) hz, G i (ν z) hz (hpow (ν z) i hz) s]
    constructor
    · intro h
      have := h.map (Proj.stalkIso (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (ν z)).hom.hom
      rwa [CommRingCat.hom_inv_apply] at this
    · intro h
      exact h.map _

  have EvRes : ∀ (W V : Z.Opens) (hVW : V ≤ W) (z : Z) (hz : z ∈ V) (x : Γ(Z, W)),
      (Z.evaluation V z hz).hom ((Z.presheaf.map (homOfLE hVW).op).hom x) =
        (Z.evaluation W z (hVW hz)).hom x := by
    intro W V hVW z hz x
    rw [← Scheme.germ_residue, ← Scheme.germ_residue, CommRingCat.comp_apply,
      CommRingCat.comp_apply, TopCat.Presheaf.germ_res_apply]
  have GV : ∀ (W : Z.Opens) (hW : η ∈ W) (t : Γ(Z, W)),
      (Z.evaluation W η hW).hom t = 0 → ∀ z, z ∉ Z.basicOpen t := by
    intro W hW t ht z hz
    have hηt : η ∈ Z.basicOpen t :=
      (hgen.mem_open_set_iff (Z.basicOpen t).isOpen).mpr ⟨z, trivial, hz⟩
    exact (Z.evaluation_ne_zero_iff_mem_basicOpen η hW t).mpr hηt ht

  haveI hyP : (ν η).asHomogeneousIdeal.toIdeal.IsPrime := (ν η).isPrime
  have hden : ∀ (i : Fin (N + 1)) (e : ℕ), (MvPolynomial.X i ^ e : MvPolynomial (Fin (N + 1)) K) ∈
      (ν η).asHomogeneousIdeal.toIdeal.primeCompl := fun i e => hpow (ν η) i (hyD i) ⟨e, rfl⟩
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : HomogeneousLocalization.AtPrime
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (ν η).asHomogeneousIdeal.toIdeal →+* Z.residueField η,
      ∀ x, Θ x = (ν.residueFieldMap η).hom (((wcProjK K N).residue (ν η)).hom
        ((Proj.stalkIso (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (ν η)).inv.hom x)) :=
    ⟨(ν.residueFieldMap η).hom.comp (((wcProjK K N).residue (ν η)).hom.comp
      (Proj.stalkIso (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (ν η)).inv.hom),
      fun _ => rfl⟩
  obtain ⟨q, hq⟩ : ∃ q : ∀ i : Fin (N + 1), HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i) →+* Z.residueField η,
      ∀ i s, q i s = Θ (HomogeneousLocalization.mapId
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hpow (ν η) i (hyD i)) s) :=
    ⟨fun i => Θ.comp (HomogeneousLocalization.mapId
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hpow (ν η) i (hyD i))),
      fun _ _ => rfl⟩
  obtain ⟨sec, hsec⟩ : ∃ sec : ∀ i : Fin (N + 1), HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i) →
      Γ(Z, ν ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X i)),
      ∀ i s, sec i s = (ν.app (Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i))).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X i)).hom s) :=
    ⟨fun i s => (ν.app (Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i))).hom
        ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X i)).hom s), fun _ _ => rfl⟩
  obtain ⟨ε, hε⟩ : ∃ ε : ∀ i : Fin (N + 1), Γ(Z, ν ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i)) →+*
        Z.residueField η,
      ∀ i, ε i = (Z.evaluation _ η (hη i)).hom :=
    ⟨fun i => (Z.evaluation _ η (hη i)).hom, fun _ => rfl⟩
  have CEs : ∀ i s, ε i (sec i s) = q i s := by
    intro i s
    rw [hε, hsec, CE i η (hη i) s, hq, hΘ]
  have CBs : ∀ i (z : Z) (hz : z ∈ ν ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i)) (e : ℕ)
      (L : MvPolynomial (Fin (N + 1)) K)
      (hL : L ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (e • 1)),
      z ∈ Z.basicOpen (sec i (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX i) e L hL)) ↔
      L ∉ (ν z).asHomogeneousIdeal := by
    intro i z hz e L hL
    rw [hsec, CB i z hz]
    exact UCx (ν z) i hz e L hL
  letI algK : Algebra K (Z.residueField η) :=
    (Θ.comp ((HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (ν η).asHomogeneousIdeal.toIdeal.primeCompl).comp
      (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))).toAlgebra
  have qF : ∀ i (k : K), q i (HomogeneousLocalization.fromZeroRingHom
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) K))
      (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) k)) =
      algebraMap K (Z.residueField η) k := by
    intro i k
    rw [hq]
    show Θ _ = Θ _
    congr 1
  obtain ⟨u, hu⟩ : ∃ u : Fin (N + 1) → Z.residueField η, ∀ j, u j = q 0
      (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (hX 0) 1 (MvPolynomial.X j) (hX' j)) :=
    ⟨fun j => q 0 (HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX 0) 1 (MvPolynomial.X j) (hX' j)),
      fun _ => rfl⟩
  have S1q : ∀ (i : Fin (N + 1)) (e : ℕ) (L : MvPolynomial (Fin (N + 1)) K)
      (hL : L ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (e • 1)),
      q i (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (hX i) e L hL) = MvPolynomial.aeval (fun j => q i
          (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            (hX i) 1 (MvPolynomial.X j) (hX' j))) L := by
    intro i e L hL
    rw [S1 i e L hL, MvPolynomial.eval₂_comp_left, MvPolynomial.aeval_def]
    congr 1
    ext k
    simp only [RingHom.comp_apply]
    exact qF i k
  have hS2 : ∀ i, u i * q i (HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX i) 1 (MvPolynomial.X 0)
        (hX' 0)) = 1 := by
    intro i
    rw [hu, hq, hq, ← map_mul, ← map_one Θ]
    congr 1
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_one]
    show Localization.mk (MvPolynomial.X i) ⟨MvPolynomial.X 0 ^ 1, hden 0 1⟩ *
      Localization.mk (MvPolynomial.X 0) ⟨MvPolynomial.X i ^ 1, hden i 1⟩ = 1
    rw [Localization.mk_mul, ← Localization.mk_one, Localization.mk_eq_mk_iff,
      Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, one_mul, mul_one, Submonoid.coe_mul, pow_one] <;> ring
  have hS3 : ∀ (i : Fin (N + 1)) (e : ℕ) (L : MvPolynomial (Fin (N + 1)) K)
      (hL : L ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (e • 1)),
      q i (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (hX i) e L hL) * u i ^ e = q 0 (HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX 0) e L hL) := by
    intro i e L hL
    rw [hu, hq, hq, hq, ← map_pow, ← map_mul]
    congr 1
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_pow]
    show Localization.mk L ⟨MvPolynomial.X i ^ e, hden i e⟩ *
      Localization.mk (MvPolynomial.X i) ⟨MvPolynomial.X 0 ^ 1, hden 0 1⟩ ^ e =
      Localization.mk L ⟨MvPolynomial.X 0 ^ e, hden 0 e⟩
    rw [Localization.mk_pow, Localization.mk_mul, Localization.mk_eq_mk_iff,
      Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [OneMemClass.coe_one, one_mul, Submonoid.coe_mul, SubmonoidClass.coe_pow,
      pow_one] <;> ring
  have hu0 : ∀ i, u i ≠ 0 := fun i => left_ne_zero_of_mul_eq_one (hS2 i)
  have hform : ∀ (i : Fin (N + 1)) (e : ℕ) (L : MvPolynomial (Fin (N + 1)) K)
      (hL : L ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (e • 1)),
      q i (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (hX i) e L hL) = MvPolynomial.aeval u L / u i ^ e := by
    intro i e L hL
    apply eq_div_of_mul_eq (pow_ne_zero _ (hu0 i))
    rw [hS3, S1q]
    exact congrArg (fun f => MvPolynomial.aeval f L) (funext fun j => (hu j).symm)
  have hw : ∀ i j, q i (HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX i) 1 (MvPolynomial.X j) (hX' j)) =
      u j / u i := by
    intro i j
    rw [hform, MvPolynomial.aeval_X, pow_one]
  have hT : ∀ i (s : HomogeneousLocalization.Away
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i)),
      q i s ∈ Algebra.adjoin K (Set.range fun j => u j / u i) := by
    intro i s
    obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX i) s
    rw [S1q, Algebra.adjoin_range_eq_range_aeval]
    exact (AlgHom.mem_range _).mpr ⟨a, by simp only [hw]⟩
  obtain ⟨A, hA⟩ : ∃ A : Fin (N + 1) → Subalgebra K (Z.residueField η),
      ∀ i a, a ∈ A i ↔ a ∈ Set.range (ε i) :=
    ⟨fun i => { carrier := Set.range (ε i)
                mul_mem' := by
                  rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
                  exact ⟨a * b, map_mul _ _ _⟩
                one_mem' := ⟨1, map_one _⟩
                add_mem' := by
                  rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
                  exact ⟨a + b, map_add _ _ _⟩
                zero_mem' := ⟨0, map_zero _⟩
                algebraMap_mem' := fun k => ⟨sec i (HomogeneousLocalization.fromZeroRingHom
                  (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
                  (Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) K))
                  (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0) k)),
                  by rw [CEs, qF]⟩ },
      fun i a => Iff.rfl⟩
  have hh1 : ∀ i j, u j / u i ∈ A i := by
    intro i j
    rw [hA, ← hw, ← CEs]
    exact ⟨_, rfl⟩
  have hfin : ∀ i, ((ν.app (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      (MvPolynomial.X i))).hom).Finite := fun i =>
    ν.finite_app _ (Proj.isAffineOpen_basicOpen _ _ (hX i) one_pos)
  have hTr : ∀ i (r : Γ(wcProjK K N, Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i))),
      ε i ((ν.app (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X i))).hom r) ∈ Algebra.adjoin K (Set.range fun j => u j / u i) := by
    intro i r
    have hr : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X i)).hom ((Proj.basicOpenIsoAway
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X i) (hX i) one_pos).inv.hom r) = r := by
      rw [← Proj.basicOpenIsoAway_hom _ _ (hX i) one_pos]
      exact CommRingCat.hom_inv_apply _ r
    rw [← hr, ← hsec, CEs]
    exact hT i _
  have hFI : ∀ i, (A i).FG ∧
      ∀ a ∈ A i, IsIntegral (Algebra.adjoin K (Set.range fun j => u j / u i)) a := by
    intro i
    letI : Algebra Γ(wcProjK K N, Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i))
        Γ(Z, ν ⁻¹ᵁ Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i)) :=
      (ν.app (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X i))).hom.toAlgebra
    haveI : Module.Finite Γ(wcProjK K N, Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i))
        Γ(Z, ν ⁻¹ᵁ Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i)) := hfin i
    obtain ⟨n, m, hm⟩ := Module.Finite.exists_fin (R := Γ(wcProjK K N, Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i)))
        (M := Γ(Z, ν ⁻¹ᵁ Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i)))
    have hTsub : Algebra.adjoin K (Set.range fun j => u j / u i) ≤
        Algebra.adjoin K ((Set.range fun j => u j / u i) ∪ Set.range (fun t => ε i (m t))) :=
      Algebra.adjoin_mono Set.subset_union_left
    have hgen : ∀ b, ε i b ∈ Algebra.adjoin K
        ((Set.range fun j => u j / u i) ∪ Set.range (fun t => ε i (m t))) := by
      intro b
      have hb : b ∈ Submodule.span Γ(wcProjK K N, Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i)) (Set.range m) := by
        rw [hm]; trivial
      obtain ⟨c, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hb
      rw [map_sum]
      refine Subalgebra.sum_mem _ (fun t _ => ?_)
      rw [Algebra.smul_def, map_mul]
      exact Subalgebra.mul_mem _ (hTsub (hTr i (c t)))
        (Algebra.subset_adjoin (Or.inr ⟨t, rfl⟩))
    constructor
    · rw [Subalgebra.fg_def]
      refine ⟨(Set.range fun j => u j / u i) ∪ Set.range (fun t => ε i (m t)),
        (Set.finite_range _).union (Set.finite_range _), le_antisymm ?_ ?_⟩
      · rw [Algebra.adjoin_le_iff]
        rintro _ (⟨j, rfl⟩ | ⟨t, rfl⟩)
        · exact hh1 i j
        · exact (hA i _).mpr ⟨_, rfl⟩
      · intro a ha
        obtain ⟨b, rfl⟩ := (hA i a).mp ha
        exact hgen b
    · intro a ha
      obtain ⟨b, rfl⟩ := (hA i a).mp ha
      have hbint : IsIntegral Γ(wcProjK K N, Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i)) b :=
        Algebra.IsIntegral.isIntegral b
      exact IsIntegral.map_of_comp_eq
        (RingHom.codRestrict ((ε i).comp (ν.app (Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i))).hom)
          (Algebra.adjoin K (Set.range fun j => u j / u i)) (hTr i))
        (ε i) (RingHom.ext fun _ => rfl) hbint
  have hUaff : ∀ i, IsAffineOpen (ν ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i)) := fun i =>
    (Proj.isAffineOpen_basicOpen _ _ (hX i) one_pos).preimage ν
  have hov : ∀ i j (z : Z) (hz : z ∈ ν ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i)),
      z ∈ Z.basicOpen (sec i (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX i) 1 (MvPolynomial.X j)
          (hX' j))) ↔
      z ∈ ν ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X j) := by
    intro i j z hz
    rw [CBs i z hz]
    exact (Proj.mem_basicOpen _ _ _).symm
  have hh3 : ∀ i j, ∀ a ∈ A i, ∃ m : ℕ, a * (u i / u j) ^ m ∈ A j := by
    intro i j a ha
    obtain ⟨b, rfl⟩ := (hA i a).mp ha
    obtain ⟨σ', hσ'⟩ : ∃ σ', σ' = sec j (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX j) 1 (MvPolynomial.X i)
          (hX' i)) := ⟨_, rfl⟩
    have hle : Z.basicOpen σ' ≤ ν ⁻¹ᵁ Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i) := by
      intro z hz
      rw [hσ'] at hz
      exact (hov j i z (Z.basicOpen_le _ hz)).mp hz
    have hηV : η ∈ Z.basicOpen σ' := by
      rw [hσ']
      exact (hov j i η (hη j)).mpr (hη i)
    haveI := (hUaff j).isLocalization_basicOpen σ'
    obtain ⟨n, a', hna⟩ := IsLocalization.Away.surj σ'
      ((Z.presheaf.map (homOfLE hle).op).hom b)
    refine ⟨n, (hA j _).mpr ⟨a', ?_⟩⟩
    have h1 := congrArg (Z.evaluation _ η hηV).hom hna
    rw [map_mul, map_pow] at h1
    have e1 : ∀ x : Γ(Z, ν ⁻¹ᵁ Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X j)),
        (Z.evaluation _ η hηV).hom (algebraMap _ _ x) = ε j x := by
      intro x
      rw [hε]
      exact EvRes _ _ (Z.basicOpen_le σ') η hηV x
    rw [e1, e1, EvRes, ← hε, hσ', CEs, hw] at h1
    exact h1.symm
  have hh4 : ∀ (e : ℕ) (p : MvPolynomial (Fin (N + 1)) K),
      p ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e → MvPolynomial.aeval u p = 0 →
      p = 0 := by
    intro e p hp hp0
    have hp' : p ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (e • 1) := by
      simpa using hp
    by_contra hne
    have hunit := (UCx (ν η) 0 (hyD 0) e p hp').mpr (GP p hne)
    have h0 := hform 0 e p hp'
    rw [hp0, zero_div, hq] at h0
    exact (hunit.map Θ).ne_zero h0
  have he3 : ∀ i j (b : Γ(Z, ν ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i)))
      (b' : Γ(Z, ν ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X j))) (k : ℕ),
      ε i b = ε j b' * (u j / u i) ^ k → ∀ z, z ∈ ν ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i) →
      z ∈ ν ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X j) →
      (z ∈ Z.basicOpen b ↔ z ∈ Z.basicOpen b') := by
    intro i j b b' k hrel z hzi hzj
    obtain ⟨σ, hσ⟩ : ∃ σ, σ = sec i (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX i) 1 (MvPolynomial.X j)
          (hX' j)) := ⟨_, rfl⟩
    have hεσ : ε i σ = u j / u i := by rw [hσ, CEs, hw]
    have hzσ : z ∈ Z.basicOpen σ := by rw [hσ]; exact (hov i j z hzi).mpr hzj
    have hWi : ν ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X i) ⊓ ν ⁻¹ᵁ Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X j) ≤
        ν ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X i) := inf_le_left
    have hWj : ν ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X i) ⊓ ν ⁻¹ᵁ Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X j) ≤
        ν ⁻¹ᵁ Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X j) := inf_le_right
    obtain ⟨t, ht⟩ : ∃ t, t = (Z.presheaf.map (homOfLE hWi).op).hom b -
        (Z.presheaf.map (homOfLE hWj).op).hom b' *
        ((Z.presheaf.map (homOfLE hWi).op).hom σ) ^ k := ⟨_, rfl⟩
    have evt : ∀ (y : Z) (hy : y ∈ ν ⁻¹ᵁ Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i) ⊓ ν ⁻¹ᵁ
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X j)),
        (Z.evaluation _ y hy).hom t =
        (Z.evaluation _ y (hWi hy)).hom b - (Z.evaluation _ y (hWj hy)).hom b' *
          ((Z.evaluation _ y (hWi hy)).hom σ) ^ k := by
      intro y hy
      rw [ht, map_sub, map_mul, map_pow, EvRes, EvRes, EvRes]
    have hηW : η ∈ ν ⁻¹ᵁ Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i) ⊓ ν ⁻¹ᵁ
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X j) :=
      TopologicalSpace.Opens.mem_inf.mpr ⟨hη i, hη j⟩
    have ht0 : (Z.evaluation _ η hηW).hom t = 0 := by
      rw [evt, ← hε, ← hε, hεσ, hrel, sub_self]
    have hzW : z ∈ ν ⁻¹ᵁ Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i) ⊓ ν ⁻¹ᵁ
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X j) :=
      TopologicalSpace.Opens.mem_inf.mpr ⟨hzi, hzj⟩
    have htz : (Z.evaluation _ z hzW).hom t = 0 := by
      by_contra hne
      exact GV _ hηW t ht0 z ((Z.evaluation_ne_zero_iff_mem_basicOpen z hzW t).mp hne)
    rw [evt, sub_eq_zero] at htz
    have hσz : (Z.evaluation _ z hzi).hom σ ≠ 0 :=
      (Z.evaluation_ne_zero_iff_mem_basicOpen z hzi σ).mpr hzσ
    rw [← Z.evaluation_ne_zero_iff_mem_basicOpen z hzi b,
      ← Z.evaluation_ne_zero_iff_mem_basicOpen z hzj b', htz]
    constructor
    · intro h h'
      exact h (by rw [h', zero_mul])
    · intro h
      exact mul_ne_zero h (pow_ne_zero _ hσz)
  have he4 : ∀ i (L : MvPolynomial (Fin (N + 1)) K),
      L ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 →
      ∃ σ : Γ(Z, ν ⁻¹ᵁ Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i)),
        ε i σ = MvPolynomial.aeval u L / u i ∧
        ∀ z ∈ ν ⁻¹ᵁ Proj.basicOpen
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i),
          (z ∈ Z.basicOpen σ ↔ ν z ∈ @Proj.basicOpen _ _ _ _ _
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) MvPolynomial.gradedAlgebra L) := by
    intro i L hL
    have hL' : L ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (1 • 1) := by
      simpa using hL
    refine ⟨sec i (HomogeneousLocalization.Away.mk
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX i) 1 L hL'), ?_, fun z hz => ?_⟩
    · rw [CEs, hform, pow_one]
    · rw [CBs i z hz]
      exact (Proj.mem_basicOpen _ _ _).symm
  have hcov : ∀ z : Z, ∃ i, z ∈ ν ⁻¹ᵁ Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X i) := by
    intro z
    have hY : (⨆ j : Fin (N + 1), Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X j)) = ⊤ := by
      apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
      intro a ha
      have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
      have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
        rw [← MvPolynomial.decomposition.decompose'_apply]
        exact ha'
      rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) h0
      obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨l, Set.mem_univ _, hl⟩
    have hx : ν z ∈ (⨆ j : Fin (N + 1), Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X j)) := by
      rw [hY]; trivial
    obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    exact ⟨j, hj⟩
  refine ⟨Z.residueField η, inferInstance, algK, u, A, ε, hu0, hh1, fun i => (hFI i).1,
    fun i => (hFI i).2, hh3, hh4, hA, ?_, he3, he4, hUaff, hcov⟩
  intro i b hb z _
  exact GV _ (hη i) b (by rw [← hε]; exact hb) z

theorem wc_plt_fhcm_affine_points (Z : Scheme.{u}) (U : Z.Opens) (hU : IsAffineOpen U) :
    (∀ Q : Ideal Γ(Z, U), Q.IsPrime → ∃ z ∈ U, ∀ b : Γ(Z, U), z ∈ Z.basicOpen b ↔ b ∉ Q) ∧
    (∀ z z' : Z, z ∈ U → z' ∈ U → (∀ b : Γ(Z, U), z ∈ Z.basicOpen b ↔ z' ∈ Z.basicOpen b) →
      z = z') ∧
    (∀ z ∈ U, ∃ Q : Ideal Γ(Z, U), Q.IsPrime ∧ ∀ b : Γ(Z, U), z ∈ Z.basicOpen b ↔ b ∉ Q) ∧
    (∀ O : Set Z, IsOpen O → ∀ z ∈ O, z ∈ U →
      ∃ b : Γ(Z, U), z ∈ Z.basicOpen b ∧ ((Z.basicOpen b : Z.Opens) : Set Z) ⊆ O) :=
by
  have KF : ∀ (p : PrimeSpectrum Γ(Z, U)) (b : Γ(Z, U)),
      hU.fromSpec p ∈ Z.basicOpen b ↔ b ∉ p.asIdeal := by
    intro p b
    rw [← PrimeSpectrum.mem_basicOpen]
    show p ∈ hU.fromSpec ⁻¹ᵁ Z.basicOpen b ↔ _
    rw [hU.fromSpec_preimage_basicOpen]
    exact Iff.rfl
  have hmem : ∀ p : PrimeSpectrum Γ(Z, U), hU.fromSpec p ∈ U := by
    intro p
    have : hU.fromSpec p ∈ Set.range hU.fromSpec := Set.mem_range_self p
    rw [hU.range_fromSpec] at this
    exact this
  have hpre : ∀ (z : Z) (hz : z ∈ U), hU.fromSpec (hU.primeIdealOf ⟨z, hz⟩) = z := by
    intro z hz
    exact hU.fromSpec_primeIdealOf ⟨z, hz⟩
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro Q hQ
    exact ⟨hU.fromSpec ⟨Q, hQ⟩, hmem _, fun b => KF ⟨Q, hQ⟩ b⟩
  · intro z z' hz hz' H
    have e1 := hpre z hz
    have e2 := hpre z' hz'
    have hpp : hU.primeIdealOf ⟨z, hz⟩ = hU.primeIdealOf ⟨z', hz'⟩ := by
      apply PrimeSpectrum.ext
      ext b
      have h1 := KF (hU.primeIdealOf ⟨z, hz⟩) b
      have h2 := KF (hU.primeIdealOf ⟨z', hz'⟩) b
      rw [e1] at h1
      rw [e2] at h2
      have h3 : b ∉ (hU.primeIdealOf ⟨z, hz⟩).asIdeal ↔ b ∉ (hU.primeIdealOf ⟨z', hz'⟩).asIdeal :=
        h1.symm.trans ((H b).trans h2)
      exact not_iff_not.mp h3
    rw [← e1, ← e2, hpp]
  · intro z hz
    refine ⟨(hU.primeIdealOf ⟨z, hz⟩).asIdeal, (hU.primeIdealOf ⟨z, hz⟩).isPrime, fun b => ?_⟩
    have h1 := KF (hU.primeIdealOf ⟨z, hz⟩) b
    rw [hpre z hz] at h1
    exact h1
  · intro O hO z hzO hzU
    obtain ⟨b, hle, hb⟩ := hU.exists_basicOpen_le (V := ⟨O, hO⟩) ⟨z, hzO⟩ hzU
    exact ⟨b, hb, fun y hy => hle hy⟩

theorem wc_plt_fhcm_graded_primes (K F : Type u) [Field K] [Field F] [Algebra K F] (N : ℕ)
    (u : Fin (N + 1) → F) (hu : ∀ i, u i ≠ 0) (A : Fin (N + 1) → Subalgebra K F)
    (gs : Finset (F × ℕ)) (hgs1 : ∀ j, (u j, 1) ∈ gs) (R : Subalgebra K (Polynomial F))
    (hR : R = Algebra.adjoin K
      ((fun q : F × ℕ => Polynomial.C q.1 * Polynomial.X ^ q.2) '' (gs : Set (F × ℕ))))
    (o1 : ∀ i, ∀ p ∈ R, ∀ e : ℕ, p.coeff e / u i ^ e ∈ A i)
    (o2 : ∀ i, ∀ a ∈ A i, ∃ e : ℕ, Polynomial.C (a * u i ^ e) * Polynomial.X ^ e ∈ R)
    (𝒜 : ℕ → Submodule K R) [GradedAlgebra 𝒜]
    (h𝒜 : ∀ (e : ℕ) (x : R), x ∈ 𝒜 e ↔ ∃ a : F, (x : Polynomial F) = Polynomial.monomial e a)
    (In : ProjectiveSpectrum 𝒜 → Polynomial F → Prop)
    (hIn : ∀ P p, In P p ↔ ∃ hr : p ∈ R, (⟨p, hr⟩ : R) ∈ P.asHomogeneousIdeal)
    (Mem : ProjectiveSpectrum 𝒜 → F → F → Prop)
    (hMem : ∀ P c a, Mem P c a ↔ ∃ e : ℕ, In P (Polynomial.C (a * c ^ e) * Polynomial.X ^ e))
    (i j : Fin (N + 1)) :
    (∀ P : ProjectiveSpectrum 𝒜, ¬ In P (Polynomial.C (u i) * Polynomial.X) →
      ∀ (a : F) (e : ℕ), Polynomial.C (a * u i ^ e) * Polynomial.X ^ e ∈ R →
        (In P (Polynomial.C (a * u i ^ e) * Polynomial.X ^ e) ↔ Mem P (u i) a)) ∧
    (∀ P : ProjectiveSpectrum 𝒜, ¬ In P (Polynomial.C (u i) * Polynomial.X) →
      ∀ (B : Type u) [CommRing B] (ε : B →+* F), (∀ b, ε b ∈ A i) →
        ∃ Q : Ideal B, Q.IsPrime ∧ ∀ b, b ∈ Q ↔ Mem P (u i) (ε b)) ∧
    (∀ (B : Type u) [CommRing B] (ε : B →+* F), (∀ a, a ∈ A i ↔ a ∈ Set.range ε) →
      ∀ Q : Ideal B, Q.IsPrime → RingHom.ker ε ≤ Q →
        ∃ P : ProjectiveSpectrum 𝒜, ¬ In P (Polynomial.C (u i) * Polynomial.X) ∧
          ∀ b, Mem P (u i) (ε b) ↔ b ∈ Q) ∧
    (∀ P : ProjectiveSpectrum 𝒜, ¬ In P (Polynomial.C (u i) * Polynomial.X) →
      ¬ In P (Polynomial.C (u j) * Polynomial.X) →
      ∀ a ∈ A j, ∀ m : ℕ, a * (u j / u i) ^ m ∈ A i →
        (Mem P (u i) (a * (u j / u i) ^ m) ↔ Mem P (u j) a)) :=
by
  classical

  have hξ : ∀ k, Polynomial.C (u k) * Polynomial.X ∈ R := by
    intro k
    have h1 : Polynomial.C (u k) * Polynomial.X ^ 1 ∈ R := by
      rw [hR]
      exact Algebra.subset_adjoin ⟨(u k, 1), hgs1 k, rfl⟩
    simpa only [pow_one] using h1

  have mem_iff : ∀ (P : ProjectiveSpectrum 𝒜) (x : R),
      x ∈ P.asHomogeneousIdeal ↔ x ∈ P.asHomogeneousIdeal.toIdeal := fun P x => Iff.rfl
  have mk_mul : ∀ (p q : Polynomial F) (hp : p ∈ R) (hq : q ∈ R) (h : p * q ∈ R),
      (⟨p * q, h⟩ : R) = (⟨p, hp⟩ : R) * (⟨q, hq⟩ : R) := fun p q hp hq h =>
    Subtype.ext (R.coe_mul ⟨p, hp⟩ ⟨q, hq⟩).symm
  have mk_add : ∀ (p q : Polynomial F) (hp : p ∈ R) (hq : q ∈ R) (h : p + q ∈ R),
      (⟨p + q, h⟩ : R) = (⟨p, hp⟩ : R) + (⟨q, hq⟩ : R) := fun p q hp hq h =>
    Subtype.ext (R.coe_add ⟨p, hp⟩ ⟨q, hq⟩).symm
  have mk_pow : ∀ (p : Polynomial F) (hp : p ∈ R) (n : ℕ) (h : p ^ n ∈ R),
      (⟨p ^ n, h⟩ : R) = (⟨p, hp⟩ : R) ^ n := fun p hp n h =>
    Subtype.ext (R.coe_pow ⟨p, hp⟩ n).symm
  have mk_zero : ∀ (h : (0 : Polynomial F) ∈ R), (⟨0, h⟩ : R) = 0 := fun h =>
    Subtype.ext R.coe_zero.symm
  have In_zero : ∀ P, In P 0 := fun P =>
    (hIn P 0).2 ⟨R.zero_mem, by rw [mem_iff, mk_zero]; exact Ideal.zero_mem _⟩
  have In_mul : ∀ P p q, In P p → q ∈ R → In P (p * q) := by
    intro P p q hp hq
    obtain ⟨hpR, hpP⟩ := (hIn P p).1 hp
    refine (hIn P _).2 ⟨R.mul_mem hpR hq, ?_⟩
    rw [mem_iff] at hpP ⊢
    rw [mk_mul p q hpR hq]
    exact P.asHomogeneousIdeal.toIdeal.mul_mem_right _ hpP
  have In_mul' : ∀ P p q, In P q → p ∈ R → In P (p * q) := by
    intro P p q hq hp
    obtain ⟨hqR, hqP⟩ := (hIn P q).1 hq
    refine (hIn P _).2 ⟨R.mul_mem hp hqR, ?_⟩
    rw [mem_iff] at hqP ⊢
    rw [mk_mul p q hp hqR]
    exact P.asHomogeneousIdeal.toIdeal.mul_mem_left _ hqP
  have In_add : ∀ P p q, In P p → In P q → In P (p + q) := by
    intro P p q hp hq
    obtain ⟨hpR, hpP⟩ := (hIn P p).1 hp
    obtain ⟨hqR, hqP⟩ := (hIn P q).1 hq
    refine (hIn P _).2 ⟨R.add_mem hpR hqR, ?_⟩
    rw [mem_iff] at hpP hqP ⊢
    rw [mk_add p q hpR hqR]
    exact P.asHomogeneousIdeal.toIdeal.add_mem hpP hqP
  have In_or : ∀ P p q, p ∈ R → q ∈ R → In P (p * q) → In P p ∨ In P q := by
    intro P p q hp hq h
    obtain ⟨hr, hm⟩ := (hIn P _).1 h
    rw [mem_iff, mk_mul p q hp hq] at hm
    rcases P.isPrime.mem_or_mem hm with h | h
    · exact Or.inl ((hIn P p).2 ⟨hp, (mem_iff P _).2 h⟩)
    · exact Or.inr ((hIn P q).2 ⟨hq, (mem_iff P _).2 h⟩)
  have cancel : ∀ P p w q, p ∈ R → w ∈ R → ¬ In P w → In P q → p * w = q → In P p := by
    intro P p w q hp hw hnw hq hpwq
    subst hpwq
    rcases In_or P p w hp hw hq with h | h
    · exact h
    · exact absurd h hnw
  have notIn_mul : ∀ P p q, p ∈ R → q ∈ R → ¬ In P p → ¬ In P q → ¬ In P (p * q) := by
    intro P p q hp hq hnp hnq h
    rcases In_or P p q hp hq h with h | h
    · exact hnp h
    · exact hnq h
  have notIn_pow : ∀ P p, p ∈ R → ¬ In P p → ∀ n : ℕ, ¬ In P (p ^ n) := by
    intro P p hp hnp n h
    obtain ⟨hr, hm⟩ := (hIn P _).1 h
    rw [mem_iff, mk_pow p hp n] at hm
    have h2 := P.isPrime.mem_of_pow_mem n hm
    exact hnp ((hIn P p).2 ⟨hp, (mem_iff P _).2 h2⟩)
  refine ⟨?_, ?_, ?_, ?_⟩

  · intro P hPi a e he
    constructor
    · intro h
      exact (hMem P _ a).2 ⟨e, h⟩
    · intro h
      obtain ⟨e', he'⟩ := (hMem P _ a).1 h
      refine cancel P _ ((Polynomial.C (u i) * Polynomial.X) ^ e') _ he (pow_mem (hξ i) e')
        (notIn_pow P _ (hξ i) hPi e') (In_mul P _ _ he' (pow_mem (hξ i) e)) ?_
      simp only [map_mul, map_pow, mul_pow]
      ring

  · intro P hPi B _ ε hεA
    have xiR := hξ i
    obtain ⟨Q, hQ⟩ : ∃ Q : Ideal B, ∀ b, b ∈ Q ↔ Mem P (u i) (ε b) := by
      obtain ⟨S, hS⟩ : ∃ S : Set B, ∀ b, b ∈ S ↔ Mem P (u i) (ε b) :=
        ⟨setOf (fun b => Mem P (u i) (ε b)), fun b => Iff.rfl⟩
      have S_add : ∀ x y : B, x ∈ S → y ∈ S → x + y ∈ S := by
        intro x y hx hy
        rw [hS] at hx hy ⊢
        obtain ⟨e1, h1⟩ := (hMem P _ _).1 hx
        obtain ⟨e2, h2⟩ := (hMem P _ _).1 hy
        refine (hMem P _ _).2 ⟨e1 + e2, ?_⟩
        have := In_add P _ _ (In_mul P _ _ h1 (pow_mem xiR e2)) (In_mul P _ _ h2 (pow_mem xiR e1))
        convert this using 2
        simp only [map_add, map_mul, map_pow, mul_pow]
        ring
      have S_zero : (0 : B) ∈ S := by
        rw [hS]
        refine (hMem P _ _).2 ⟨0, ?_⟩
        rw [map_zero, zero_mul, map_zero, zero_mul]
        exact In_zero P
      have S_mul : ∀ x b : B, b ∈ S → x * b ∈ S := by
        intro x b hb
        rw [hS] at hb ⊢
        obtain ⟨e, h⟩ := (hMem P _ _).1 hb
        obtain ⟨f, hf⟩ := o2 i (ε x) (hεA x)
        refine (hMem P _ _).2 ⟨f + e, ?_⟩
        have := In_mul' P _ _ h hf
        have heq : Polynomial.C (ε (x * b) * u i ^ (f + e)) * Polynomial.X ^ (f + e) =
            Polynomial.C (ε x * u i ^ f) * Polynomial.X ^ f *
              (Polynomial.C (ε b * u i ^ e) * Polynomial.X ^ e) := by
          simp only [map_mul, map_pow, pow_add]
          ring
        rw [heq]
        exact this
      exact ⟨Submodule.mk (AddSubmonoid.mk (AddSubsemigroup.mk S (S_add _ _)) S_zero)
        (fun x b hb => S_mul x b hb), hS⟩
    refine ⟨Q, ?_, hQ⟩
    refine Ideal.IsPrime.mk ?_ ?_
    · rw [Ideal.ne_top_iff_one, hQ, map_one]
      intro h
      obtain ⟨e, he⟩ := (hMem P _ 1).1 h
      apply notIn_pow P _ xiR hPi e
      convert he using 2
      simp only [one_mul, map_pow, mul_pow]
    · intro x y hxy
      rw [hQ] at hxy
      rw [hQ, hQ]
      obtain ⟨g, hg⟩ := (hMem P _ _).1 hxy
      obtain ⟨f, hf⟩ := o2 i (ε x) (hεA x)
      obtain ⟨f', hf'⟩ := o2 i (ε y) (hεA y)
      have hprod : In P (Polynomial.C (ε x * u i ^ f) * Polynomial.X ^ f *
          (Polynomial.C (ε y * u i ^ f') * Polynomial.X ^ f')) := by
        refine cancel P _ ((Polynomial.C (u i) * Polynomial.X) ^ g) _ (R.mul_mem hf hf')
          (pow_mem xiR g) (notIn_pow P _ xiR hPi g) (In_mul P _ _ hg (pow_mem xiR (f + f'))) ?_
        simp only [map_mul, map_pow, mul_pow]
        ring
      rcases In_or P _ _ hf hf' hprod with h | h
      · exact Or.inl ((hMem P _ _).2 ⟨f, h⟩)
      · exact Or.inr ((hMem P _ _).2 ⟨f', h⟩)

  · intro B _ ε hεA Q hQ hker
    have hc : u i ≠ 0 := hu i
    obtain ⟨G, hG⟩ : ∃ G : F → Prop, ∀ t, G t ↔ ∃ b ∈ Q, ε b = t := ⟨_, fun _ => Iff.rfl⟩
    have G0 : G 0 := (hG 0).2 ⟨0, Q.zero_mem, map_zero ε⟩
    have Gadd : ∀ s t, G s → G t → G (s + t) := by
      intro s t hs ht
      obtain ⟨b, hb, rfl⟩ := (hG _).1 hs
      obtain ⟨b', hb', rfl⟩ := (hG _).1 ht
      exact (hG _).2 ⟨b + b', Q.add_mem hb hb', map_add ε b b'⟩
    have Gmul : ∀ (x : B) t, G t → G (ε x * t) := by
      intro x t ht
      obtain ⟨b, hb, rfl⟩ := (hG _).1 ht
      exact (hG _).2 ⟨x * b, Q.mul_mem_left x hb, map_mul ε x b⟩
    have Geps : ∀ b, G (ε b) ↔ b ∈ Q := by
      intro b
      constructor
      · intro h
        obtain ⟨b', hb', he⟩ := (hG _).1 h
        have h1 : b - b' ∈ Q := hker (by rw [RingHom.mem_ker, map_sub, he, sub_self])
        have h2 := Q.add_mem h1 hb'
        rwa [sub_add_cancel] at h2
      · intro hb
        exact (hG _).2 ⟨b, hb, rfl⟩
    have notG1 : ¬ G 1 := by
      intro h
      rw [← map_one ε, Geps] at h
      exact hQ.ne_top ((Ideal.eq_top_iff_one Q).2 h)
    have GA : ∀ t ∈ A i, ∃ x : B, ε x = t := fun t ht => (hεA t).1 ht

    have CL : ∀ (x : R) (k : ℕ), ((DirectSum.decompose 𝒜 x k : R) : Polynomial F) =
        Polynomial.monomial k ((x : Polynomial F).coeff k) := by
      intro x k
      have hmon : ∀ l, ∃ a : F, ((DirectSum.decompose 𝒜 x l : R) : Polynomial F) =
          Polynomial.monomial l a := fun l => (h𝒜 l _).1 (DirectSum.decompose 𝒜 x l).2
      choose a ha using hmon
      have hsum : (x : Polynomial F) = ∑ l ∈ (DirectSum.decompose 𝒜 x).support,
          ((DirectSum.decompose 𝒜 x l : R) : Polynomial F) := by
        conv_lhs => rw [← DirectSum.sum_support_decompose 𝒜 x]
        rw [AddSubmonoidClass.coe_finsetSum]
      have hcoeff : (x : Polynomial F).coeff k = a k := by
        rw [hsum, Polynomial.finset_sum_coeff]
        simp_rw [ha, Polynomial.coeff_monomial]
        rw [Finset.sum_eq_single k]
        · simp
        · intro l _ hl
          simp [hl]
        · intro hk
          rw [DFinsupp.notMem_support_iff] at hk
          have h0 := ha k
          rw [hk] at h0
          simp only [ZeroMemClass.coe_zero] at h0
          simp only [if_true]
          exact ((Polynomial.monomial_eq_zero_iff _ _).1 h0.symm)
      rw [ha k, hcoeff]

    obtain ⟨I, hI⟩ : ∃ I : Ideal R, ∀ r, r ∈ I ↔
        ∀ e, G ((r : Polynomial F).coeff e / u i ^ e) := by
      obtain ⟨S, hS⟩ : ∃ S : Set R, ∀ r, r ∈ S ↔
          ∀ e, G ((r : Polynomial F).coeff e / u i ^ e) :=
        ⟨setOf (fun r : R => ∀ e, G ((r : Polynomial F).coeff e / u i ^ e)), fun r => Iff.rfl⟩
      have S_add : ∀ r s : R, r ∈ S → s ∈ S → r + s ∈ S := by
        intro r s hr hs
        rw [hS] at hr hs ⊢
        intro e
        rw [Subalgebra.coe_add, Polynomial.coeff_add, add_div]
        exact Gadd _ _ (hr e) (hs e)
      have S_zero : (0 : R) ∈ S := by
        rw [hS]
        intro e
        rw [ZeroMemClass.coe_zero, Polynomial.coeff_zero, zero_div]
        exact G0
      have S_mul : ∀ s r : R, r ∈ S → s * r ∈ S := by
        intro s r hr
        rw [hS] at hr ⊢
        intro e
        rw [Subalgebra.coe_mul, Polynomial.coeff_mul, Finset.sum_div]
        apply Finset.sum_induction _ G Gadd G0
        intro p hp
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        obtain ⟨x, hx⟩ := GA _ (o1 i _ s.2 p.1)
        have : (s : Polynomial F).coeff p.1 * (r : Polynomial F).coeff p.2 / u i ^ e =
            ((s : Polynomial F).coeff p.1 / u i ^ p.1) *
              ((r : Polynomial F).coeff p.2 / u i ^ p.2) := by
          rw [← hp, pow_add, mul_div_mul_comm]
        rw [this, ← hx]
        exact Gmul x _ (hr p.2)
      exact ⟨Submodule.mk (AddSubmonoid.mk (AddSubsemigroup.mk S (S_add _ _)) S_zero)
        (fun x b hb => S_mul x b hb), hS⟩
    have hIhom : I.IsHomogeneous 𝒜 := by
      intro k r hr
      rw [hI] at hr ⊢
      intro e
      rw [CL, Polynomial.coeff_monomial]
      split_ifs with h
      · subst h
        exact hr k
      · rw [zero_div]
        exact G0
    have hIne : I ≠ ⊤ := by
      rw [Ideal.ne_top_iff_one, hI]
      intro h
      have h0 := h 0
      rw [OneMemClass.coe_one, Polynomial.coeff_one_zero, pow_zero, div_one] at h0
      exact notG1 h0
    have hIprime : I.IsPrime := by
      refine hIhom.isPrime_of_homogeneous_mem_or_mem hIne ?_
      rintro x y ⟨k, hk⟩ ⟨l, hl⟩ hxy
      obtain ⟨α, hα⟩ := (h𝒜 k x).1 hk
      obtain ⟨β, hβ⟩ := (h𝒜 l y).1 hl
      obtain ⟨x0, hx0⟩ := GA _ (o1 i _ x.2 k)
      obtain ⟨y0, hy0⟩ := GA _ (o1 i _ y.2 l)
      rw [hα, Polynomial.coeff_monomial, if_pos rfl] at hx0
      rw [hβ, Polynomial.coeff_monomial, if_pos rfl] at hy0
      have hxy' := (hI _).1 hxy (k + l)
      rw [Subalgebra.coe_mul, hα, hβ, Polynomial.monomial_mul_monomial,
        Polynomial.coeff_monomial, if_pos rfl, pow_add, mul_div_mul_comm, ← hx0, ← hy0,
        ← map_mul, Geps] at hxy'
      rcases hQ.mem_or_mem hxy' with h | h
      · left
        rw [hI]
        intro e
        rw [hα, Polynomial.coeff_monomial]
        split_ifs with he
        · subst he
          rw [← hx0]
          exact (Geps x0).2 h
        · rw [zero_div]
          exact G0
      · right
        rw [hI]
        intro e
        rw [hβ, Polynomial.coeff_monomial]
        split_ifs with he
        · subst he
          rw [← hy0]
          exact (Geps y0).2 h
        · rw [zero_div]
          exact G0
    have hξI : (⟨_, hξ i⟩ : R) ∉ I := by
      intro h
      have h1 := (hI _).1 h 1
      rw [Polynomial.coeff_C_mul_X, if_pos rfl, pow_one, div_self hc] at h1
      exact notG1 h1
    have hξirr : (⟨_, hξ i⟩ : R) ∈ HomogeneousIdeal.irrelevant 𝒜 := by
      rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply]
      apply Subtype.ext
      rw [CL]
      simp
    obtain ⟨P, hP⟩ : ∃ P : ProjectiveSpectrum 𝒜, ∀ r, r ∈ P.asHomogeneousIdeal ↔ r ∈ I :=
      ⟨⟨⟨I, hIhom⟩, hIprime, fun hle => hξI (hle hξirr)⟩, fun r => Iff.rfl⟩
    refine ⟨P, ?_, ?_⟩
    · intro h
      obtain ⟨hr, hm⟩ := (hIn P _).1 h
      exact hξI ((hP _).1 hm)
    · intro b
      constructor
      · intro h
        obtain ⟨e, he⟩ := (hMem P _ _).1 h
        obtain ⟨hr, hm⟩ := (hIn P _).1 he
        have h1 := (hI _).1 ((hP _).1 hm) e
        rw [Polynomial.coeff_C_mul_X_pow, if_pos rfl,
          mul_div_cancel_right₀ _ (pow_ne_zero e hc)] at h1
        exact (Geps b).1 h1
      · intro hb
        obtain ⟨e, he⟩ := o2 i (ε b) ((hεA _).2 ⟨b, rfl⟩)
        refine (hMem P _ _).2 ⟨e, (hIn P _).2 ⟨he, (hP _).2 ((hI _).2 fun e' => ?_)⟩⟩
        show G ((Polynomial.C (ε b * u i ^ e) * Polynomial.X ^ e).coeff e' / u i ^ e')
        rw [Polynomial.coeff_C_mul_X_pow]
        split_ifs with h
        · subst h
          rw [mul_div_cancel_right₀ _ (pow_ne_zero _ hc)]
          exact (Geps b).2 hb
        · rw [zero_div]
          exact G0

  · intro P hPi hPj a ha m ham
    have key : (u j / u i) ^ m * u i ^ m = u j ^ m := by
      rw [← mul_pow, div_mul_cancel₀ _ (hu i)]
    have keyC : Polynomial.C (u j / u i) ^ m * Polynomial.C (u i) ^ m =
        Polynomial.C (u j) ^ m := by
      rw [← map_pow, ← map_pow, ← map_mul, key, map_pow]
    have I5 : ∀ E e : ℕ, Polynomial.C (a * (u j / u i) ^ m * u i ^ E) * Polynomial.X ^ E *
        ((Polynomial.C (u i) * Polynomial.X) ^ m * (Polynomial.C (u j) * Polynomial.X) ^ e) =
        Polynomial.C (a * u j ^ e) * Polynomial.X ^ e *
        ((Polynomial.C (u j) * Polynomial.X) ^ m * (Polynomial.C (u i) * Polynomial.X) ^ E) := by
      intro E e
      simp only [map_mul, map_pow, mul_pow]
      linear_combination (Polynomial.C a * Polynomial.C (u i) ^ E * Polynomial.C (u j) ^ e *
        Polynomial.X ^ E * Polynomial.X ^ m * Polynomial.X ^ e) * keyC
    constructor
    · intro h
      obtain ⟨E, hE⟩ := (hMem P _ _).1 h
      obtain ⟨e, he⟩ := o2 j a ha
      refine (hMem P _ _).2 ⟨e, ?_⟩
      exact cancel P _ _ _ he (R.mul_mem (pow_mem (hξ j) m) (pow_mem (hξ i) E))
        (notIn_mul P _ _ (pow_mem (hξ j) m) (pow_mem (hξ i) E)
          (notIn_pow P _ (hξ j) hPj m) (notIn_pow P _ (hξ i) hPi E))
        (In_mul P _ _ hE (R.mul_mem (pow_mem (hξ i) m) (pow_mem (hξ j) e))) (I5 E e).symm
    · intro h
      obtain ⟨e, he⟩ := (hMem P _ _).1 h
      obtain ⟨E, hE⟩ := o2 i _ ham
      refine (hMem P _ _).2 ⟨E, ?_⟩
      exact cancel P _ _ _ hE (R.mul_mem (pow_mem (hξ i) m) (pow_mem (hξ j) e))
        (notIn_mul P _ _ (pow_mem (hξ i) m) (pow_mem (hξ j) e)
          (notIn_pow P _ (hξ i) hPi m) (notIn_pow P _ (hξ j) hPj e))
        (In_mul P _ _ he (R.mul_mem (pow_mem (hξ j) m) (pow_mem (hξ i) E))) (I5 E e)

theorem wc_plt_fhcm_cover (K F : Type u) [Field K] [Field F] [Algebra K F] (N : ℕ)
    (u : Fin (N + 1) → F) (gs : Finset (F × ℕ)) (hgs1 : ∀ j, (u j, 1) ∈ gs)
    (R : Subalgebra K (Polynomial F))
    (hR : R = Algebra.adjoin K
      ((fun q : F × ℕ => Polynomial.C q.1 * Polynomial.X ^ q.2) '' (gs : Set (F × ℕ))))
    (o3 : ∀ p ∈ R,
      IsIntegral (Algebra.adjoin K (Set.range fun j => Polynomial.C (u j) * Polynomial.X)) p)
    (𝒜 : ℕ → Submodule K R) [GradedAlgebra 𝒜]
    (h𝒜 : ∀ (e : ℕ) (x : R), x ∈ 𝒜 e ↔ ∃ a : F, (x : Polynomial F) = Polynomial.monomial e a) :
    ∀ P : ProjectiveSpectrum 𝒜, ∃ i, ∃ hr : Polynomial.C (u i) * Polynomial.X ∈ R,
      (⟨_, hr⟩ : R) ∉ P.asHomogeneousIdeal :=
by
  classical
  intro P
  by_contra hcon
  push_neg at hcon

  have sA : ∀ (e : ℕ), 1 ≤ e → ∀ (r : R), r ∈ 𝒜 e → ∀ (g : Polynomial R), g.Monic →
      g.eval r = 0 →
      (∀ (i d : ℕ), 1 ≤ d →
        ((DirectSum.decompose 𝒜 (g.coeff i) d : 𝒜 d) : R) ∈ P.asHomogeneousIdeal.toIdeal) →
      r ∈ P.asHomogeneousIdeal.toIdeal := by
    intro e he r hr g hg hroot hc
    set n := g.natDegree with hn
    have h0 : ∑ i ∈ Finset.range (n + 1), g.coeff i * r ^ i = 0 := by
      rw [← hroot, Polynomial.eval_eq_sum_range]
    have h1 := congrArg (GradedRing.proj 𝒜 (n * e)) h0
    rw [map_sum, map_zero] at h1
    simp only [GradedRing.proj_apply] at h1
    have h2 : ∀ i ∈ Finset.range (n + 1),
        ((DirectSum.decompose 𝒜 (g.coeff i * r ^ i) (n * e) : 𝒜 (n * e)) : R)
        = ((DirectSum.decompose 𝒜 (g.coeff i) ((n - i) * e) : 𝒜 _) : R) * r ^ i := by
      intro i hi
      have hri : r ^ i ∈ 𝒜 (i * e) := by
        have := SetLike.pow_mem_graded i hr
        simpa [smul_eq_mul] using this
      rw [DirectSum.coe_decompose_mul_of_right_mem 𝒜 (n * e) hri]
      have hle : i * e ≤ n * e := Nat.mul_le_mul_right _ (by simp at hi; omega)
      rw [if_pos hle, Nat.sub_mul]
    rw [Finset.sum_congr rfl h2, Finset.sum_range_succ] at h1
    have hcn : g.coeff n = 1 := hg.coeff_natDegree
    rw [hcn, Nat.sub_self, zero_mul,
      DirectSum.decompose_of_mem_same 𝒜 (SetLike.one_mem_graded 𝒜), one_mul] at h1
    have h3 : r ^ n ∈ P.asHomogeneousIdeal.toIdeal := by
      have : r ^ n = -∑ i ∈ Finset.range n,
          ((DirectSum.decompose 𝒜 (g.coeff i) ((n - i) * e) : 𝒜 _) : R) * r ^ i := by
        linear_combination h1
      rw [this, Ideal.neg_mem_iff]
      apply Ideal.sum_mem
      intro i hi
      apply Ideal.mul_mem_right
      apply hc
      simp at hi
      have : 1 ≤ n - i := by omega
      nlinarith
    exact P.isPrime.mem_of_pow_mem n h3

  have sB : ∀ (s : Set R), (∀ x ∈ s, x ∈ 𝒜 1) → (∀ x ∈ s, x ∈ P.asHomogeneousIdeal.toIdeal) →
      ∀ τ ∈ Algebra.adjoin K s, ∀ d : ℕ, 1 ≤ d →
        ((DirectSum.decompose 𝒜 τ d : 𝒜 d) : R) ∈ P.asHomogeneousIdeal.toIdeal := by
    intro s hs1 hsI
    have key : ∀ τ ∈ Algebra.adjoin K s,
        τ - GradedRing.projZeroRingHom 𝒜 τ ∈ P.asHomogeneousIdeal.toIdeal := by
      intro τ hτ
      induction hτ using Algebra.adjoin_induction with
      | mem x hx =>
        rw [GradedRing.projZeroRingHom_apply,
          DirectSum.decompose_of_mem_ne 𝒜 (hs1 x hx) (by norm_num : (1:ℕ) ≠ 0), sub_zero]
        exact hsI x hx
      | algebraMap k =>
        rw [GradedRing.projZeroRingHom_apply,
          DirectSum.decompose_of_mem_same 𝒜 (SetLike.algebraMap_mem_graded 𝒜 k), sub_self]
        exact Ideal.zero_mem _
      | add x y _ _ hx hy =>
        rw [map_add]
        have : x + y - (GradedRing.projZeroRingHom 𝒜 x + GradedRing.projZeroRingHom 𝒜 y)
            = (x - GradedRing.projZeroRingHom 𝒜 x) + (y - GradedRing.projZeroRingHom 𝒜 y) := by
          ring
        rw [this]; exact Ideal.add_mem _ hx hy
      | mul x y _ _ hx hy =>
        rw [map_mul]
        have : x * y - GradedRing.projZeroRingHom 𝒜 x * GradedRing.projZeroRingHom 𝒜 y
            = (x - GradedRing.projZeroRingHom 𝒜 x) * y
              + GradedRing.projZeroRingHom 𝒜 x * (y - GradedRing.projZeroRingHom 𝒜 y) := by ring
        rw [this]
        exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hx) (Ideal.mul_mem_left _ _ hy)
    intro τ hτ d hd
    have h := (P.asHomogeneousIdeal.isHomogeneous.mem_iff
      (x := τ - GradedRing.projZeroRingHom 𝒜 τ)).1 (key τ hτ) d
    have h0 : ((DirectSum.decompose 𝒜 (GradedRing.projZeroRingHom 𝒜 τ) d : 𝒜 d) : R) = 0 := by
      rw [GradedRing.projZeroRingHom_apply]
      exact DirectSum.decompose_of_mem_ne 𝒜 (SetLike.coe_mem _) (by omega)
    rw [← GradedRing.proj_apply, map_sub, GradedRing.proj_apply, GradedRing.proj_apply, h0,
      sub_zero] at h
    exact h
  have hξR : ∀ j, Polynomial.C (u j) * Polynomial.X ∈ R := by
    intro j
    rw [hR]
    exact Algebra.subset_adjoin ⟨(u j, 1), hgs1 j, by simp⟩
  set S : Set (Polynomial F) := Set.range fun j => Polynomial.C (u j) * Polynomial.X with hS
  set s' : Set R := {x : R | (x : Polynomial F) ∈ S} with hs'
  have hs'P : ∀ x ∈ s', x ∈ P.asHomogeneousIdeal.toIdeal := by
    rintro x ⟨j, hj⟩
    have : x = ⟨_, hξR j⟩ := Subtype.ext hj.symm
    rw [this]
    exact hcon j (hξR j)
  have hs'1 : ∀ x ∈ s', x ∈ 𝒜 1 := by
    rintro x ⟨j, hj⟩
    exact (h𝒜 1 x).2 ⟨u j, by rw [← hj]; exact Polynomial.C_mul_X_eq_monomial⟩
  have H5 := sB s' hs'1 hs'P

  have hSR : S ⊆ R := by
    rintro _ ⟨j, rfl⟩
    exact hξR j
  have hle : Algebra.adjoin K S ≤ R := Algebra.adjoin_le hSR
  have hcoef : ∀ p (hp : p ∈ Algebra.adjoin K S), ∀ hpR : p ∈ R,
      (⟨p, hpR⟩ : R) ∈ Algebra.adjoin K s' := by
    intro p hp
    induction hp using Algebra.adjoin_induction with
    | mem x hx => intro hpR; exact Algebra.subset_adjoin hx
    | algebraMap k =>
      intro hpR
      have e : (⟨algebraMap K (Polynomial F) k, hpR⟩ : R) = algebraMap K R k := Subtype.ext rfl
      rw [e]; exact Subalgebra.algebraMap_mem _ k
    | add x y hx hy ihx ihy =>
      intro hpR
      have e : (⟨x + y, hpR⟩ : R) = ⟨x, hle hx⟩ + ⟨y, hle hy⟩ := Subtype.ext rfl
      rw [e]; exact Subalgebra.add_mem _ (ihx _) (ihy _)
    | mul x y hx hy ihx ihy =>
      intro hpR
      have e : (⟨x * y, hpR⟩ : R) = ⟨x, hle hx⟩ * ⟨y, hle hy⟩ := Subtype.ext rfl
      rw [e]; exact Subalgebra.mul_mem _ (ihx _) (ihy _)
  have lift : ∀ r : R, ∃ g : Polynomial R, g.Monic ∧ g.eval r = 0 ∧
      ∀ i, g.coeff i ∈ Algebra.adjoin K s' := by
    intro r
    obtain ⟨f, hfm, hf⟩ := o3 r r.2
    let ι := Subalgebra.inclusion hle
    refine ⟨f.map (ι : _ →+* R), hfm.map _, ?_, ?_⟩
    · apply Subtype.val_injective
      rw [Polynomial.eval_map]
      have h2 := Polynomial.hom_eval₂ f (ι : _ →+* R) (R.val : R →+* Polynomial F) r
      have hcomp : (R.val : R →+* Polynomial F).comp (ι : _ →+* R)
          = algebraMap (Algebra.adjoin K S) (Polynomial F) := RingHom.ext fun _ => rfl
      rw [hcomp] at h2
      exact h2.trans hf
    · intro i
      rw [Polynomial.coeff_map]
      exact hcoef _ (f.coeff i).2 _
  have hpos : ∀ d, 1 ≤ d → ∀ r : R, r ∈ 𝒜 d → r ∈ P.asHomogeneousIdeal.toIdeal := by
    intro d hd r hr
    obtain ⟨g, hgm, hgr, hgc⟩ := lift r
    exact sA d hd r hr g hgm hgr (fun i d' hd' => H5 _ (hgc i) d' hd')
  apply ProjectiveSpectrum.not_irrelevant_le P
  intro a ha
  rw [HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply] at ha
  change a ∈ P.asHomogeneousIdeal.toIdeal
  apply (P.asHomogeneousIdeal.isHomogeneous.mem_iff).2
  intro d
  rcases Nat.eq_zero_or_pos d with rfl | hd
  · rw [ha]
    exact zero_mem _
  · exact hpos d hd _ (SetLike.coe_mem _)

theorem wc_plt_fhcm_noether_map (K F : Type u) [Field K] [Field F] [Algebra K F] (N : ℕ)
    (u : Fin (N + 1) → F) (gs : Finset (F × ℕ)) (hgs1 : ∀ j, (u j, 1) ∈ gs)
    (R : Subalgebra K (Polynomial F))
    (hR : R = Algebra.adjoin K
      ((fun q : F × ℕ => Polynomial.C q.1 * Polynomial.X ^ q.2) '' (gs : Set (F × ℕ))))
    (h4 : ∀ (e : ℕ) (p : MvPolynomial (Fin (N + 1)) K),
      p ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e → MvPolynomial.aeval u p = 0 →
      p = 0)
    (o3 : ∀ p ∈ R,
      IsIntegral (Algebra.adjoin K (Set.range fun j => Polynomial.C (u j) * Polynomial.X)) p) :
    ∃ φ : MvPolynomial (Fin (N + 1)) K →ₐ[K] R, Function.Injective φ ∧ φ.Finite ∧
      ∀ (d : ℕ) (p : MvPolynomial (Fin (N + 1)) K),
        p ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d →
        ((φ p : R) : Polynomial F) = Polynomial.C (MvPolynomial.aeval u p) * Polynomial.X ^ d :=
by
  classical
  set ξ : Fin (N + 1) → Polynomial F := fun j => Polynomial.C (u j) * Polynomial.X with hξ
  set φ₀ : MvPolynomial (Fin (N + 1)) K →ₐ[K] Polynomial F := MvPolynomial.aeval ξ with hφ₀

  have hmono : ∀ (v : Fin (N + 1) →₀ ℕ) (c : K),
      φ₀ (MvPolynomial.monomial v c) =
        Polynomial.C (MvPolynomial.aeval u (MvPolynomial.monomial v c)) *
          Polynomial.X ^ v.degree := by
    intro v c
    rw [hφ₀, MvPolynomial.aeval_monomial, MvPolynomial.aeval_monomial, Polynomial.C_mul,
      Polynomial.algebraMap_apply, mul_assoc]
    congr 1
    rw [Finsupp.prod_pow, Finsupp.prod_pow, map_prod, Finsupp.degree_eq_sum,
      ← Finset.prod_pow_eq_pow_sum, ← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl (fun i _ => ?_)
    simp only [hξ, map_pow, mul_pow]

  have hA : ∀ (d : ℕ) (p : MvPolynomial (Fin (N + 1)) K),
      p ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d →
      φ₀ p = Polynomial.C (MvPolynomial.aeval u p) * Polynomial.X ^ d := by
    intro d p hp
    rw [MvPolynomial.mem_homogeneousSubmodule] at hp
    conv_lhs => rw [p.as_sum]
    conv_rhs => rw [p.as_sum]
    simp only [map_sum, Finset.sum_mul]
    refine Finset.sum_congr rfl (fun v hv => ?_)
    have hdeg : v.degree = d := by
      by_contra hne
      exact (MvPolynomial.mem_support_iff.mp hv) (hp.coeff_eq_zero hne)
    rw [hmono, hdeg]

  have hinj : Function.Injective φ₀ := by
    rw [injective_iff_map_eq_zero]
    intro p hp
    have hc : ∀ e, MvPolynomial.homogeneousComponent e p = 0 := by
      intro e
      apply h4 e _ (MvPolynomial.homogeneousComponent_mem e p)
      have h1 : (φ₀ p).coeff e =
          MvPolynomial.aeval u (MvPolynomial.homogeneousComponent e p) := by
        conv_lhs => rw [← MvPolynomial.sum_homogeneousComponent p]
        have h2 := fun i => hA i _ (MvPolynomial.homogeneousComponent_mem i p)
        simp only [map_sum, h2, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow,
          Finset.sum_ite_eq]
        split_ifs with h
        · rfl
        · rw [MvPolynomial.homogeneousComponent_eq_zero _ _ (by simp at h; omega), map_zero]
      rw [← h1, hp, Polynomial.coeff_zero]
    rw [← MvPolynomial.sum_homogeneousComponent p]
    exact Finset.sum_eq_zero (fun i _ => hc i)

  have hξR : ∀ j, ξ j ∈ R := by
    intro j
    rw [hR]
    apply Algebra.subset_adjoin
    exact ⟨(u j, 1), Finset.mem_coe.mpr (hgs1 j), by simp [hξ]⟩
  have hφ₀R : ∀ p, φ₀ p ∈ R := by
    intro p
    have : φ₀ p ∈ Algebra.adjoin K (Set.range ξ) := by
      rw [← MvPolynomial.aeval_range]; exact AlgHom.mem_range_self _ p
    exact (Algebra.adjoin_le (Set.range_subset_iff.mpr hξR)) this
  let φ : MvPolynomial (Fin (N + 1)) K →ₐ[K] R := φ₀.codRestrict R hφ₀R
  have hφ : ∀ p, ((φ p : R) : Polynomial F) = φ₀ p := fun p => rfl
  refine ⟨φ, ?_, ?_, ?_⟩
  · intro p q hpq
    apply hinj
    rw [← hφ, ← hφ, hpq]
  · show φ.toRingHom.Finite
    apply RingHom.Finite.of_isIntegral_of_finiteType
    · intro x
      set T := Algebra.adjoin K (Set.range ξ) with hT
      have hT' : ∀ p, φ₀ p ∈ T := fun p => by
        rw [hT, ← MvPolynomial.aeval_range]; exact AlgHom.mem_range_self _ p
      let ψ : MvPolynomial (Fin (N + 1)) K →ₐ[K] T := φ₀.codRestrict T hT'
      have hψs : Function.Surjective ψ := by
        rintro ⟨t, ht⟩
        rw [hT, ← MvPolynomial.aeval_range] at ht
        obtain ⟨p, hp⟩ := ht
        exact ⟨p, Subtype.ext hp⟩
      obtain ⟨q, hqm, hq⟩ := o3 x x.2
      have hlift : q ∈ Polynomial.lifts ψ.toRingHom := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro n
        exact hψs _
      obtain ⟨q', hq'map, -, hq'm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hqm
      refine ⟨q', hq'm, ?_⟩
      apply Subtype.val_injective
      have e1 : ((Polynomial.eval₂ φ.toRingHom x q' : R) : Polynomial F) =
          Polynomial.eval₂ (R.val.toRingHom.comp φ.toRingHom) (x : Polynomial F) q' :=
        Polynomial.hom_eval₂ q' φ.toRingHom R.val.toRingHom x
      have e2 : R.val.toRingHom.comp φ.toRingHom = T.val.toRingHom.comp ψ.toRingHom :=
        RingHom.ext fun p => rfl
      rw [e1, e2, ← Polynomial.eval₂_map, hq'map]
      exact hq
    · have hfg : R.FG := by
        rw [hR, ← Finset.coe_image]
        exact Subalgebra.fg_adjoin_finset _
      have hft : Algebra.FiniteType K R := (Subalgebra.fg_iff_finiteType R).mp hfg
      apply RingHom.FiniteType.of_comp_finiteType
        (f := algebraMap K (MvPolynomial (Fin (N + 1)) K))
      rw [show φ.toRingHom.comp (algebraMap K _) = algebraMap K R from φ.comp_algebraMap]
      exact RingHom.finiteType_algebraMap.mpr hft
  · intro d p hp
    rw [hφ]
    exact hA d p hp

theorem wc_plt_fh_cone_model (K : Type u) [Field K] (N : ℕ)
    (Z : Scheme.{u}) [IrreducibleSpace Z] (ν : Z ⟶ wcProjK K N) [IsFinite ν] [Surjective ν]
    (Lf : Fin (N - 1) → MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1) :
    ∃ (R : Type u) (_ : CommRing R) (_ : IsDomain R) (_ : IsNoetherianRing R) (_ : Algebra K R)
      (𝒜 : ℕ → Submodule K R) (_ : GradedAlgebra 𝒜) (φ : MvPolynomial (Fin (N + 1)) K →ₐ[K] R),
      (∀ x : R, x ∈ 𝒜 0 ↔ x ∈ Set.range (algebraMap K R)) ∧ Function.Injective φ ∧ φ.Finite ∧
      (∀ p ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1, φ p ∈ 𝒜 1) ∧
      ∃ g : ProjectiveSpectrum 𝒜 → Z,
        ContinuousOn g {P : ProjectiveSpectrum 𝒜 |
          ∀ a, φ (Lf a : MvPolynomial (Fin (N + 1)) K) ∈ P.asHomogeneousIdeal} ∧
        g '' {P : ProjectiveSpectrum 𝒜 |
          ∀ a, φ (Lf a : MvPolynomial (Fin (N + 1)) K) ∈ P.asHomogeneousIdeal} =
        ⇑ν ⁻¹' {x : ↥(wcProjK K N) | ∀ a, x ∉ @Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) MvPolynomial.gradedAlgebra
          (Lf a : MvPolynomial (Fin (N + 1)) K)} :=
by
  classical
  obtain ⟨U, hU⟩ : ∃ U : Fin (N + 1) → Z.Opens, ∀ i, U i = ν ⁻¹ᵁ @Proj.basicOpen _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) MvPolynomial.gradedAlgebra
      (MvPolynomial.X i) := ⟨_, fun _ => rfl⟩
  obtain ⟨F, _, _, u, A, ε, hu, h1, h2, h2', h3, h4, e1, e2, e3, e4, haff, hcov⟩ :=
    wc_plt_fhcm_scheme_datum K N Z ν U hU
  obtain ⟨gs, hgs, hgs1, hRall⟩ := wc_plt_fhcm_chart_ring K F N u hu A h1 h2 h2' h3
  obtain ⟨R, hR⟩ : ∃ R : Subalgebra K (Polynomial F), R = Algebra.adjoin K
      ((fun q : F × ℕ => Polynomial.C q.1 * Polynomial.X ^ q.2) '' (gs : Set (F × ℕ))) :=
    ⟨_, rfl⟩
  obtain ⟨o1, o2, o3⟩ := hRall R hR
  obtain ⟨𝒜, hGA, hGr, h𝒜0, hNoeth⟩ := wc_plt_fhcm_monomial_graded K F gs hgs R hR
  obtain ⟨In, hIn⟩ : ∃ In : ProjectiveSpectrum 𝒜 → Polynomial F → Prop,
      ∀ P p, In P p ↔ ∃ hr : p ∈ R, (⟨p, hr⟩ : R) ∈ P.asHomogeneousIdeal :=
    ⟨_, fun _ _ => Iff.rfl⟩
  obtain ⟨Mem, hMem⟩ : ∃ Mem : ProjectiveSpectrum 𝒜 → F → F → Prop,
      ∀ P c a, Mem P c a ↔ ∃ e : ℕ, In P (Polynomial.C (a * c ^ e) * Polynomial.X ^ e) :=
    ⟨_, fun _ _ _ => Iff.rfl⟩
  obtain ⟨φ, hφi, hφf, hφd⟩ := wc_plt_fhcm_noether_map K F N u gs hgs1 R hR h4 o3
  have hcover : ∀ P : ProjectiveSpectrum 𝒜, ∃ i, ¬ In P (Polynomial.C (u i) * Polynomial.X) := by
    intro P
    obtain ⟨i, _, hn⟩ := wc_plt_fhcm_cover K F N u gs hgs1 R hR o3 𝒜 hGr P
    refine ⟨i, fun h => hn ?_⟩
    obtain ⟨_, h'⟩ := (hIn _ _).1 h
    exact h'
  have hp := wc_plt_fhcm_graded_primes K F N u hu A gs hgs1 R hR o1 o2 𝒜 hGr In hIn Mem hMem
  have hpts := fun i => wc_plt_fhcm_affine_points Z (U i) (haff i)
  have hUmem : ∀ (i : Fin (N + 1)) (z : Z), z ∈ U i ↔
      ν z ∈ @Proj.basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        MvPolynomial.gradedAlgebra (MvPolynomial.X i) :=
    fun i z => by rw [hU i]; rfl
  have hIn_coe : ∀ (P : ProjectiveSpectrum 𝒜) (r : R),
      In P (r : Polynomial F) ↔ r ∈ P.asHomogeneousIdeal :=
    fun P r => (hIn P r).trans ⟨fun ⟨_, h⟩ => h, fun h => ⟨r.2, h⟩⟩
  have hXj : ∀ j : Fin (N + 1), (MvPolynomial.X j : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 :=
    fun j => (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X K j)
  have hξ : ∀ (P : ProjectiveSpectrum 𝒜) (j : Fin (N + 1)),
      In P (Polynomial.C (u j) * Polynomial.X) ↔
        φ (MvPolynomial.X j) ∈ P.asHomogeneousIdeal := by
    intro P j
    have hφX : ((φ (MvPolynomial.X j) : R) : Polynomial F) =
        Polynomial.C (u j) * Polynomial.X := by
      rw [hφd 1 _ (hXj j), MvPolynomial.aeval_X, pow_one]
    rw [← hφX]
    exact hIn_coe P _
  have hbo : ∀ (P : ProjectiveSpectrum 𝒜) (j : Fin (N + 1)),
      P ∈ ProjectiveSpectrum.basicOpen 𝒜 (φ (MvPolynomial.X j)) ↔
        ¬ In P (Polynomial.C (u j) * Polynomial.X) := by
    intro P j
    rw [ProjectiveSpectrum.mem_basicOpen, hξ]
  have hlin : ∀ (P : ProjectiveSpectrum 𝒜) (i : Fin (N + 1)),
      ¬ In P (Polynomial.C (u i) * Polynomial.X) →
      ∀ L ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1,
        (φ L ∈ P.asHomogeneousIdeal ↔ Mem P (u i) (MvPolynomial.aeval u L / u i)) := by
    intro P i hPi L hL
    have hr : Polynomial.C (MvPolynomial.aeval u L / u i * u i ^ 1) * Polynomial.X ^ 1 =
        ((φ L : R) : Polynomial F) := by
      rw [hφd 1 L hL]
      simp only [pow_one]
      rw [div_mul_cancel₀ _ (hu i)]
    have hmem : Polynomial.C (MvPolynomial.aeval u L / u i * u i ^ 1) * Polynomial.X ^ 1 ∈
        R := by
      rw [hr]; exact (φ L).2
    rw [← ((hp i i).1 P hPi _ 1 hmem), hr]
    exact (hIn_coe P (φ L)).symm
  have hchart : ∀ (i : Fin (N + 1)) (P : ProjectiveSpectrum 𝒜),
      ¬ In P (Polynomial.C (u i) * Polynomial.X) →
      ∃ z : Z, z ∈ U i ∧ ∀ b : Γ(Z, U i),
        (z ∈ Z.basicOpen b ↔ ¬ Mem P (u i) (ε i b)) := by
    intro i P hPi
    obtain ⟨Q, hQ, hQb⟩ := (hp i i).2.1 P hPi _ (ε i) (fun b => (e1 i _).2 ⟨b, rfl⟩)
    obtain ⟨z, hz, hzb⟩ := (hpts i).1 Q hQ
    exact ⟨z, hz, fun b => by rw [hzb b, hQb b]⟩
  have agree : ∀ (P : ProjectiveSpectrum 𝒜) (i j : Fin (N + 1)) (z z' : Z),
      ¬ In P (Polynomial.C (u i) * Polynomial.X) →
      ¬ In P (Polynomial.C (u j) * Polynomial.X) →
      z ∈ U i →
      (∀ b : Γ(Z, U i), (z ∈ Z.basicOpen b ↔ ¬ Mem P (u i) (ε i b))) →
      z' ∈ U j →
      (∀ b : Γ(Z, U j), (z' ∈ Z.basicOpen b ↔ ¬ Mem P (u j) (ε j b))) →
      z = z' := by
    intro P i j z z' hPi hPj hzi hzb hz'j hz'b
    have hzj : z ∈ U j := by
      obtain ⟨σ, hσ, hσz⟩ := e4 i (MvPolynomial.X j) (hXj j)
      rw [MvPolynomial.aeval_X] at hσ
      have h1' : z ∈ Z.basicOpen σ := by
        rw [hzb σ, hσ]
        intro hm
        apply hPj
        rw [hξ]
        have := (hlin P i hPi (MvPolynomial.X j) (hXj j)).2
        rw [MvPolynomial.aeval_X] at this
        exact this hm
      exact (hUmem j z).2 ((hσz z hzi).1 h1')
    apply (hpts j).2.1 z z' hzj hz'j
    intro b'
    have ha : ε j b' ∈ A j := (e1 j _).2 ⟨b', rfl⟩
    obtain ⟨m, hm⟩ := h3 j i _ ha
    obtain ⟨b, hb⟩ := (e1 i _).1 hm
    rw [← e3 i j b b' m hb z hzi hzj, hzb b, hb, hz'b b',
      (hp i j).2.2.2 P hPi hPj _ ha m hm]
  choose ι hι using hcover
  choose gc hgcU hgcb using hchart
  have gspec : ∀ (P : ProjectiveSpectrum 𝒜) (j : Fin (N + 1)),
      ¬ In P (Polynomial.C (u j) * Polynomial.X) →
      gc (ι P) P (hι P) ∈ U j ∧ ∀ b : Γ(Z, U j),
        (gc (ι P) P (hι P) ∈ Z.basicOpen b ↔ ¬ Mem P (u j) (ε j b)) := by
    intro P j hj
    have := agree P (ι P) j (gc (ι P) P (hι P)) (gc j P hj) (hι P) hj (hgcU _ _ _) (hgcb _ _ _)
      (hgcU j P hj) (hgcb j P hj)
    rw [this]
    exact ⟨hgcU j P hj, hgcb j P hj⟩
  have hgc : Continuous (fun P => gc (ι P) P (hι P)) := by
    rw [continuous_def]
    intro O hO
    rw [isOpen_iff_forall_mem_open]
    intro P hP
    have hP' : gc (ι P) P (hι P) ∈ O := hP
    obtain ⟨hgi, hgb⟩ := gspec P (ι P) (hι P)
    obtain ⟨b, hb1, hb2⟩ := (hpts (ι P)).2.2.2 O hO _ hP' hgi
    obtain ⟨e, he⟩ := o2 (ι P) (ε (ι P) b) ((e1 (ι P) _).2 ⟨b, rfl⟩)
    refine ⟨(ProjectiveSpectrum.basicOpen 𝒜 (φ (MvPolynomial.X (ι P))) : Set _) ∩
      (ProjectiveSpectrum.basicOpen 𝒜 (⟨_, he⟩ : R) : Set _), ?_,
      (ProjectiveSpectrum.isOpen_basicOpen _).inter (ProjectiveSpectrum.isOpen_basicOpen _), ?_⟩
    · rintro P' ⟨hP'1, hP'2⟩
      have hP'i : ¬ In P' (Polynomial.C (u (ι P)) * Polynomial.X) := (hbo P' (ι P)).1 hP'1
      show gc (ι P') P' (hι P') ∈ O
      refine hb2 (((gspec P' (ι P) hP'i).2 b).2 ?_)
      rw [← (hp (ι P) (ι P)).1 P' hP'i _ e he]
      intro hin
      exact (ProjectiveSpectrum.mem_basicOpen _ _ _).1 hP'2 ((hIn_coe P' ⟨_, he⟩).1 hin)
    · refine ⟨(hbo P (ι P)).2 (hι P), (ProjectiveSpectrum.mem_basicOpen _ _ _).2 ?_⟩
      intro hin
      have := (hgb b).1 hb1
      rw [← (hp (ι P) (ι P)).1 P (hι P) _ e he] at this
      exact this ((hIn_coe P ⟨_, he⟩).2 hin)
  have hfib : ∀ (P : ProjectiveSpectrum 𝒜) (a : Fin (N - 1)),
      φ (Lf a : MvPolynomial (Fin (N + 1)) K) ∈ P.asHomogeneousIdeal ↔
      ν (gc (ι P) P (hι P)) ∉ @Proj.basicOpen _ _ _ _ _
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) MvPolynomial.gradedAlgebra
          (Lf a : MvPolynomial (Fin (N + 1)) K) := by
    intro P a
    obtain ⟨hgi, hgb⟩ := gspec P (ι P) (hι P)
    obtain ⟨σ, hσ, hσz⟩ := e4 (ι P) _ (Lf a).2
    have h1' := hgb σ
    rw [hσz _ hgi, hσ] at h1'
    rw [hlin P (ι P) (hι P) _ (Lf a).2, h1', not_not]
  have hsurj : ∀ z : Z, ∃ P, gc (ι P) P (hι P) = z := by
    intro z
    obtain ⟨i, hzi⟩ := hcov z
    obtain ⟨Q, hQ, hQb⟩ := (hpts i).2.2.1 z hzi
    have hker : RingHom.ker (ε i) ≤ Q := by
      intro b hb
      by_contra hbQ
      exact e2 i b (RingHom.mem_ker.1 hb) z hzi ((hQb b).2 hbQ)
    obtain ⟨P, hPi, hPQ⟩ := (hp i i).2.2.1 _ (ε i) (e1 i) Q hQ hker
    refine ⟨P, (hpts i).2.1 _ z (gspec P i hPi).1 hzi (fun b => ?_)⟩
    rw [(gspec P i hPi).2 b, hPQ b, hQb b]
  refine ⟨R, R.toCommRing, inferInstance, hNoeth, inferInstance, 𝒜, hGA,
    φ, h𝒜0, hφi, hφf, ?_, fun P => gc (ι P) P (hι P), hgc.continuousOn, ?_⟩
  · intro p hp1
    exact (hGr 1 _).2 ⟨MvPolynomial.aeval u p, by
      rw [hφd 1 p hp1, Polynomial.C_mul_X_pow_eq_monomial]⟩
  · ext z
    constructor
    · rintro ⟨P, hPV, rfl⟩
      exact fun a => (hfib P a).1 (hPV a)
    · intro hz
      obtain ⟨P, rfl⟩ := hsurj z
      exact ⟨P, fun a => (hfib P a).2 (hz a), rfl⟩

theorem wc_plt_fh_cone_dim (K : Type u) [Field K] (N : ℕ) (R : Type u) [CommRing R] [IsDomain R]
    [IsNoetherianRing R] [Algebra K R] (𝒜 : ℕ → Submodule K R) [GradedAlgebra 𝒜]
    (h𝒜0 : ∀ x : R, x ∈ 𝒜 0 ↔ x ∈ Set.range (algebraMap K R))
    (φ : MvPolynomial (Fin (N + 1)) K →ₐ[K] R) (hφi : Function.Injective φ) (hφf : φ.Finite)
    (hφ1 : ∀ p ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1, φ p ∈ 𝒜 1) :
    ∃ (_ : (HomogeneousIdeal.irrelevant 𝒜).toIdeal.IsPrime) (d : ℕ), N + 1 ≤ d ∧
      ringKrullDim (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal) = d :=
by
  classical
  have hm : (HomogeneousIdeal.irrelevant 𝒜).toIdeal.IsPrime := by
    rw [HomogeneousIdeal.toIdeal_irrelevant]
    exact RingHom.ker_isPrime _
  refine ⟨hm, ?_⟩

  have chain : ∀ (n : ℕ) (P : Fin (n + 1) → Ideal (MvPolynomial (Fin (N + 1)) K)),
      (∀ i, (P i).IsPrime) → StrictMono P → (n : ℕ∞) ≤ (P (Fin.last n)).height := by
    intro n P hP hmono
    have key : ∀ k (hk : k ≤ n), (k : ℕ∞) ≤ (P ⟨k, by omega⟩).height := by
      intro k
      induction k with
      | zero => intro _; simp
      | succ k ih =>
        intro hk
        have ih' := ih (by omega)
        by_contra hcon
        push_neg at hcon
        haveI := hP ⟨k + 1, by omega⟩
        have hle : (P ⟨k + 1, by omega⟩).height ≤ (k : ℕ∞) := by
          rw [← ENat.lt_add_one_iff (ENat.coe_ne_top k)]
          exact_mod_cast hcon
        have hlt : P ⟨k, by omega⟩ < P ⟨k + 1, by omega⟩ := hmono (by simp [Fin.lt_def])
        have := (Ideal.height_le_iff.mp hle) _ (hP _) hlt
        exact absurd ih' (not_le.mpr this)
    exact key n le_rfl

  let σ : ℕ → MvPolynomial (Fin (N + 1)) K →ₐ[K] MvPolynomial (Fin (N + 1)) K :=
    fun j => MvPolynomial.aeval
      (fun i : Fin (N + 1) => if (i : ℕ) < j then 0 else MvPolynomial.X i)
  have hσX : ∀ (j : ℕ) (i : Fin (N + 1)),
      σ j (MvPolynomial.X i) = if (i : ℕ) < j then 0 else MvPolynomial.X i := by
    intro j i
    simp only [σ, MvPolynomial.aeval_X]
  have hcomp : ∀ j, (σ (j + 1)).comp (σ j) = σ (j + 1) := by
    intro j
    apply MvPolynomial.algHom_ext
    intro i
    rw [AlgHom.comp_apply, hσX j i]
    split_ifs with h
    · rw [map_zero, hσX, if_pos (by omega)]
    · rfl
  have hcc : ∀ j (f : MvPolynomial (Fin (N + 1)) K),
      MvPolynomial.constantCoeff (σ j f) = MvPolynomial.constantCoeff f := by
    intro j f
    have h : (MvPolynomial.constantCoeff).comp
        (σ j : MvPolynomial (Fin (N + 1)) K →+* MvPolynomial (Fin (N + 1)) K) =
        MvPolynomial.constantCoeff := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.comp_apply, RingHom.coe_coe, MvPolynomial.algHom_C,
          MvPolynomial.constantCoeff_C]
        rw [MvPolynomial.algebraMap_eq, MvPolynomial.constantCoeff_C]
      · intro i
        simp only [RingHom.comp_apply, RingHom.coe_coe, hσX]
        split_ifs <;> simp
    exact RingHom.congr_fun h f
  let P : Fin (N + 1 + 1) → Ideal (MvPolynomial (Fin (N + 1)) K) := fun j => RingHom.ker (σ j)
  have hPprime : ∀ j, (P j).IsPrime := fun j => RingHom.ker_isPrime _
  have hPmono : StrictMono P := by
    rw [Fin.strictMono_iff_lt_succ]
    intro j
    rw [SetLike.lt_iff_le_and_exists]
    refine ⟨?_, MvPolynomial.X j, ?_, ?_⟩
    · intro f hf
      simp only [P, RingHom.mem_ker, Fin.coe_castSucc, Fin.val_succ] at hf ⊢
      rw [← hcomp j, AlgHom.comp_apply, hf, map_zero]
    · simp only [P, RingHom.mem_ker, Fin.val_succ]
      rw [hσX, if_pos (by omega)]
    · simp only [P, RingHom.mem_ker, Fin.coe_castSucc]
      rw [hσX, if_neg (lt_irrefl _)]
      exact MvPolynomial.X_ne_zero _
  have hlast : P (Fin.last (N + 1)) ≤
      RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin (N + 1)) K →+* K) := by
    intro f hf
    simp only [P, RingHom.mem_ker, Fin.val_last] at hf ⊢
    rw [← hcc (N + 1) f, hf, map_zero]

  have hX : ∀ i, φ (MvPolynomial.X i) ∈ (HomogeneousIdeal.irrelevant 𝒜).toIdeal := by
    intro i
    have h1 : φ (MvPolynomial.X i) ∈ 𝒜 1 := hφ1 _
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X K i))
    rw [HomogeneousIdeal.mem_iff, HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply,
      DirectSum.decompose_of_mem_ne 𝒜 h1 one_ne_zero]
  have hcc_le : RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (Fin (N + 1)) K →+* K) ≤
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal.comap
        (φ : MvPolynomial (Fin (N + 1)) K →+* R) := by
    intro f hf
    rw [RingHom.mem_ker] at hf
    have hspan : f ∈ Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N + 1)))) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro mo hmo
      have hne : mo ≠ 0 := by
        rintro rfl
        rw [MvPolynomial.mem_support_iff] at hmo
        exact hmo hf
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
      exact ⟨i, Set.mem_univ _, by simpa using hi⟩
    have hle : Ideal.span (MvPolynomial.X '' (Set.univ : Set (Fin (N + 1)))) ≤
        (HomogeneousIdeal.irrelevant 𝒜).toIdeal.comap
          (φ : MvPolynomial (Fin (N + 1)) K →+* R) := by
      rw [Ideal.span_le]
      rintro _ ⟨i, _, rfl⟩
      exact hX i
    exact hle hspan

  have hgd : ((HomogeneousIdeal.irrelevant 𝒜).toIdeal.comap
        (φ : MvPolynomial (Fin (N + 1)) K →+* R)).height ≤
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal.height := by
    letI : Algebra (MvPolynomial (Fin (N + 1)) K) R :=
      (φ : MvPolynomial (Fin (N + 1)) K →+* R).toAlgebra
    haveI : FaithfulSMul (MvPolynomial (Fin (N + 1)) K) R :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr hφi
    haveI : Algebra.IsIntegral (MvPolynomial (Fin (N + 1)) K) R :=
      ⟨RingHom.Finite.to_isIntegral hφf⟩
    haveI : Algebra.HasGoingDown (MvPolynomial (Fin (N + 1)) K) R := inferInstance
    let p := (HomogeneousIdeal.irrelevant 𝒜).toIdeal.under (MvPolynomial (Fin (N + 1)) K)
    haveI : p.IsPrime := Ideal.IsPrime.under _ _
    haveI : (HomogeneousIdeal.irrelevant 𝒜).toIdeal.LiesOver p := ⟨rfl⟩
    show p.height ≤ _
    rw [Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown p
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal]
    exact le_self_add
  have hNle : ((N + 1 : ℕ) : ℕ∞) ≤ (HomogeneousIdeal.irrelevant 𝒜).toIdeal.height :=
    (chain (N + 1) P hPprime hPmono).trans
      ((Ideal.height_mono hlast).trans ((Ideal.height_mono hcc_le).trans hgd))
  have htop : (HomogeneousIdeal.irrelevant 𝒜).toIdeal.height ≠ ⊤ :=
    Ideal.height_ne_top hm.ne_top
  obtain ⟨d, hd⟩ : ∃ d : ℕ, (HomogeneousIdeal.irrelevant 𝒜).toIdeal.height = d :=
    ⟨_, (ENat.coe_toNat htop).symm⟩
  rw [hd] at hNle
  refine ⟨d, by exact_mod_cast hNle, ?_⟩
  rw [IsLocalization.AtPrime.ringKrullDim_eq_height (HomogeneousIdeal.irrelevant 𝒜).toIdeal
    (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal), hd]
  norm_cast

theorem wc_plt_fh_disconnect_ideals (K : Type u) [Field K] (R : Type u) [CommRing R] [Algebra K R]
    (𝒜 : ℕ → Submodule K R) [GradedAlgebra 𝒜]
    (h𝒜0 : ∀ x : R, x ∈ 𝒜 0 ↔ x ∈ Set.range (algebraMap K R))
    [(HomogeneousIdeal.irrelevant 𝒜).toIdeal.IsPrime]
    (r : ℕ) (f : Fin r → R) (hf : ∀ a, f a ∈ 𝒜 1)
    (hV : ¬ _root_.IsPreconnected {P : ProjectiveSpectrum 𝒜 | ∀ a, f a ∈ P.asHomogeneousIdeal}) :
    ∃ J₁ J₂ : Ideal (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal),
      (J₁ ⊓ J₂).radical = (Ideal.span (Set.range (fun a => algebraMap R
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal) (f a)))).radical ∧
      (J₁ ⊔ J₂).radical =
        IsLocalRing.maximalIdeal (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal) ∧
      J₁.radical ≠
        IsLocalRing.maximalIdeal (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal) ∧
      J₂.radical ≠
        IsLocalRing.maximalIdeal (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal) :=
by
  classical

  have hVclosed : IsClosed {P : ProjectiveSpectrum 𝒜 | ∀ a, f a ∈ P.asHomogeneousIdeal} := by
    have e : {P : ProjectiveSpectrum 𝒜 | ∀ a, f a ∈ P.asHomogeneousIdeal} =
        ProjectiveSpectrum.zeroLocus 𝒜 (Set.range f) := by
      ext P
      simp [ProjectiveSpectrum.mem_zeroLocus, Set.range_subset_iff]
    rw [e]
    exact ProjectiveSpectrum.isClosed_zeroLocus 𝒜 _
  rw [isPreconnected_closed_iff] at hV
  simp only [not_forall] at hV
  obtain ⟨t, t', ht, ht', hcov, ⟨P₁, hP₁V, hP₁t⟩, ⟨P₂, hP₂V, hP₂t'⟩, hdisj⟩ := hV
  have toI : ∀ {H H' : HomogeneousIdeal 𝒜}, H ≤ H' → H.toIdeal ≤ H'.toIdeal :=
    fun h x hx => h hx
  have KF : ∀ (C : Set (ProjectiveSpectrum 𝒜)), IsClosed C → ∀ P : ProjectiveSpectrum 𝒜,
      ProjectiveSpectrum.vanishingIdeal C ≤ P.asHomogeneousIdeal ↔ P ∈ C := by
    intro C hC P
    conv_rhs => rw [← hC.closure_eq, ← ProjectiveSpectrum.zeroLocus_vanishingIdeal_eq_closure]
    rw [ProjectiveSpectrum.mem_zeroLocus]
    exact SetLike.coe_subset_coe.symm
  have hC₁ := hVclosed.inter ht
  have hC₂ := hVclosed.inter ht'
  have KF₁ := KF _ hC₁
  have KF₂ := KF _ hC₂
  have hfH₁ : ∀ a, f a ∈ (ProjectiveSpectrum.vanishingIdeal
      ({P : ProjectiveSpectrum 𝒜 | ∀ a, f a ∈ P.asHomogeneousIdeal} ∩ t)).toIdeal :=
    fun a => (ProjectiveSpectrum.mem_vanishingIdeal _ _).mpr (fun P hP => hP.1 a)
  have hfH₂ : ∀ a, f a ∈ (ProjectiveSpectrum.vanishingIdeal
      ({P : ProjectiveSpectrum 𝒜 | ∀ a, f a ∈ P.asHomogeneousIdeal} ∩ t')).toIdeal :=
    fun a => (ProjectiveSpectrum.mem_vanishingIdeal _ _).mpr (fun P hP => hP.1 a)

  have s2 : ∀ H : Ideal R, H.IsHomogeneous 𝒜 → H ≠ ⊤ →
      H ≤ (HomogeneousIdeal.irrelevant 𝒜).toIdeal := by
    intro H hH hne x hx
    change x ∈ HomogeneousIdeal.irrelevant 𝒜
    rw [HomogeneousIdeal.mem_irrelevant_iff]
    have hx0 : GradedRing.proj 𝒜 0 x ∈ H := by
      rw [GradedRing.proj_apply]; exact hH 0 hx
    have hx0' : GradedRing.proj 𝒜 0 x ∈ 𝒜 0 := by
      rw [GradedRing.proj_apply]; exact SetLike.coe_mem _
    obtain ⟨c, hc⟩ := (h𝒜0 _).mp hx0'
    by_contra hne0
    apply hne
    have hc0 : c ≠ 0 := by
      rintro rfl
      apply hne0
      rw [← hc, map_zero]
    apply Ideal.eq_top_of_isUnit_mem H hx0
    rw [← hc]
    exact (IsUnit.mk0 c hc0).map (algebraMap K R)
  have hPm : ∀ P : ProjectiveSpectrum 𝒜,
      P.asHomogeneousIdeal.toIdeal ≤ (HomogeneousIdeal.irrelevant 𝒜).toIdeal :=
    fun P => s2 _ P.asHomogeneousIdeal.isHomogeneous P.isPrime.ne_top

  have s3 : ∀ q : Ideal (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal), q.IsPrime →
      IsLocalRing.maximalIdeal (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal) ≤ q ∨
      ∃ Q : ProjectiveSpectrum 𝒜,
        Q.asHomogeneousIdeal.toIdeal ≤
          q.comap (algebraMap R (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)) ∧
        (∀ x : R, SetLike.IsHomogeneousElem 𝒜 x →
          x ∈ q.comap (algebraMap R (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)) →
          x ∈ Q.asHomogeneousIdeal) ∧
        (∀ H : HomogeneousIdeal 𝒜, H.toIdeal ≤
          q.comap (algebraMap R (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)) →
          H ≤ Q.asHomogeneousIdeal) := by
    intro q hq
    have hP : (q.comap (algebraMap R
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))).IsPrime :=
      Ideal.comap_isPrime _ q
    by_cases hc : HomogeneousIdeal.irrelevant 𝒜 ≤ (q.comap (algebraMap R
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))).homogeneousCore 𝒜
    · left
      rw [← Localization.AtPrime.map_eq_maximalIdeal, Ideal.map_le_iff_le_comap]
      exact fun x hx => Ideal.toIdeal_homogeneousCore_le 𝒜 _ (hc hx)
    · right
      refine ⟨⟨_, hP.homogeneousCore, hc⟩, Ideal.toIdeal_homogeneousCore_le 𝒜 _, ?_, ?_⟩
      · intro x hx hxq
        exact Ideal.mem_homogeneousCore_of_homogeneous_of_mem hx hxq
      · intro H hH
        exact (Ideal.homogeneousCore.gc 𝒜).le_iff_le.mp hH

  have R0 : ∀ X Y : Ideal (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal),
      (∀ q : Ideal (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal), q.IsPrime →
        (X ≤ q ↔ Y ≤ q)) → X.radical = Y.radical := by
    intro X Y h
    rw [Ideal.radical_eq_sInf, Ideal.radical_eq_sInf]
    congr 1
    ext q
    simp only [Set.mem_setOf_eq]
    constructor
    · rintro ⟨h1, h2⟩; exact ⟨(h q h2).mp h1, h2⟩
    · rintro ⟨h1, h2⟩; exact ⟨(h q h2).mpr h1, h2⟩

  have hJM : ∀ H : HomogeneousIdeal 𝒜, (∃ P : ProjectiveSpectrum 𝒜, H ≤ P.asHomogeneousIdeal) →
      Ideal.map (algebraMap R (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
        H.toIdeal ≤
      IsLocalRing.maximalIdeal (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal) := by
    rintro H ⟨P, hP⟩
    rw [← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.map_mono ((toI hP).trans (hPm P))
  have hJM₁ := hJM _ ⟨P₁, (KF₁ P₁).mpr ⟨hP₁V, hP₁t⟩⟩
  have hJM₂ := hJM _ ⟨P₂, (KF₂ P₂).mpr ⟨hP₂V, hP₂t'⟩⟩

  have G3 : ∀ (P : ProjectiveSpectrum 𝒜) (H : HomogeneousIdeal 𝒜), H ≤ P.asHomogeneousIdeal →
      (Ideal.map (algebraMap R (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
        H.toIdeal).radical ≠
      IsLocalRing.maximalIdeal (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal) := by
    intro P H hHP hrad
    have hPp := P.isPrime
    have hdj : Disjoint ((HomogeneousIdeal.irrelevant 𝒜).toIdeal.primeCompl : Set R)
        (P.asHomogeneousIdeal.toIdeal : Set R) := by
      rw [Set.disjoint_left]
      intro x hx1 hx2
      exact hx1 (hPm P hx2)
    have hq0 : (Ideal.map (algebraMap R
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
        P.asHomogeneousIdeal.toIdeal).IsPrime :=
      IsLocalization.isPrime_of_isPrime_disjoint _ _ _ hPp hdj
    have hc0 : (Ideal.map (algebraMap R
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
        P.asHomogeneousIdeal.toIdeal).comap (algebraMap R
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)) =
        P.asHomogeneousIdeal.toIdeal :=
      IsLocalization.under_map_of_isPrime_disjoint _ _ hPp hdj
    have hmc : (IsLocalRing.maximalIdeal
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)).comap (algebraMap R
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)) =
        (HomogeneousIdeal.irrelevant 𝒜).toIdeal :=
      Localization.AtPrime.under_maximalIdeal
    have hle : IsLocalRing.maximalIdeal
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal) ≤
        Ideal.map (algebraMap R (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
          P.asHomogeneousIdeal.toIdeal := by
      rw [← hrad, ← hq0.radical]
      exact Ideal.radical_mono (Ideal.map_mono (toI hHP))
    apply ProjectiveSpectrum.not_irrelevant_le P
    intro x hx
    have hx' : x ∈ (IsLocalRing.maximalIdeal
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)).comap (algebraMap R
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)) := by
      rw [hmc]; exact hx
    have h3 : x ∈ (Ideal.map (algebraMap R
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
        P.asHomogeneousIdeal.toIdeal).comap (algebraMap R
        (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal)) :=
      Ideal.mem_comap.mpr (hle (Ideal.mem_comap.mp hx'))
    rw [hc0] at h3
    exact h3
  refine ⟨Ideal.map (algebraMap R (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
      (ProjectiveSpectrum.vanishingIdeal
        ({P : ProjectiveSpectrum 𝒜 | ∀ a, f a ∈ P.asHomogeneousIdeal} ∩ t)).toIdeal,
    Ideal.map (algebraMap R (Localization.AtPrime (HomogeneousIdeal.irrelevant 𝒜).toIdeal))
      (ProjectiveSpectrum.vanishingIdeal
        ({P : ProjectiveSpectrum 𝒜 | ∀ a, f a ∈ P.asHomogeneousIdeal} ∩ t')).toIdeal,
    ?_, ?_, G3 P₁ _ ((KF₁ P₁).mpr ⟨hP₁V, hP₁t⟩), G3 P₂ _ ((KF₂ P₂).mpr ⟨hP₂V, hP₂t'⟩)⟩

  · apply R0
    intro q hq
    rw [hq.inf_le, Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap, Ideal.span_le,
      Set.range_subset_iff]
    constructor
    · rintro (h | h) a
      · exact h (hfH₁ a)
      · exact h (hfH₂ a)
    · intro h
      rcases s3 q hq with hM | ⟨Q, hQ1, hQ2, hQ3⟩
      · left
        exact Ideal.map_le_iff_le_comap.mp (hJM₁.trans hM)
      · have hQV : Q ∈ {P : ProjectiveSpectrum 𝒜 | ∀ a, f a ∈ P.asHomogeneousIdeal} :=
          fun a => hQ2 (f a) ⟨1, hf a⟩ (h a)
        rcases hcov hQV with hQt | hQt'
        · left
          exact (toI ((KF₁ Q).mpr ⟨hQV, hQt⟩)).trans hQ1
        · right
          exact (toI ((KF₂ Q).mpr ⟨hQV, hQt'⟩)).trans hQ1

  · refine (R0 _ _ ?_).trans (IsLocalRing.maximalIdeal.isMaximal _).isPrime.radical
    intro q hq
    rw [sup_le_iff, Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
    constructor
    · rintro ⟨h1, h2⟩
      rcases s3 q hq with hM | ⟨Q, hQ1, hQ2, hQ3⟩
      · exact hM
      · exfalso
        have a1 := (KF₁ Q).mp (hQ3 _ h1)
        have a2 := (KF₂ Q).mp (hQ3 _ h2)
        exact hdisj ⟨Q, a1.1, a1.2, a2.2⟩
    · intro hM
      exact ⟨Ideal.map_le_iff_le_comap.mp (hJM₁.trans hM),
        Ideal.map_le_iff_le_comap.mp (hJM₂.trans hM)⟩

theorem wc_plt_lc_mv_ext_comparison (A : Type u) [CommRing A] (Y : ModuleCat.{u} A) (n : ℕ) :
    ∃ e : (X : ModuleCat.{u} A) →
        (↑(((Ext A (ModuleCat.{u} A) n).obj (Opposite.op X)).obj Y) ≃+ Abelian.Ext X Y n),
      ∀ (X X' : ModuleCat.{u} A) (f : X ⟶ X')
        (y : ↑(((Ext A (ModuleCat.{u} A) n).obj (Opposite.op X')).obj Y)),
        e X ((((Ext A (ModuleCat.{u} A) n).map f.op).app Y).hom y) =
          (Abelian.Ext.mk₀ f).comp (e X' y) (zero_add n) :=
by
  classical

  have capp : ∀ {M N Q : ModuleCat.{u} A} (f : M ⟶ N) (g : N ⟶ Q) (x : M),
      (f ≫ g).hom x = g.hom (f.hom x) := fun _ _ _ => rfl

  have s1 : ∀ {Z G H : Type u} [AddCommGroup Z] [AddCommGroup G] [AddCommGroup H]
      (Ψ : Z →+ G) (Φ : Z →+ H), Function.Surjective Ψ → Function.Surjective Φ →
      (∀ z, Ψ z = 0 ↔ Φ z = 0) → ∃ e : G ≃+ H, ∀ z, e (Ψ z) = Φ z := by
    intro Z G H _ _ _ Ψ Φ hΨ hΦ hker
    have hk : Ψ.ker = Φ.ker := by ext z; simp [AddMonoidHom.mem_ker, hker]
    refine ⟨((QuotientAddGroup.quotientKerEquivOfSurjective Ψ hΨ).symm.trans
      (QuotientAddGroup.quotientAddEquivOfEq hk)).trans
      (QuotientAddGroup.quotientKerEquivOfSurjective Φ hΦ), fun z => ?_⟩
    have h1 : (QuotientAddGroup.quotientKerEquivOfSurjective Ψ hΨ).symm (Ψ z) =
        (z : Z ⧸ Ψ.ker) := by
      rw [AddEquiv.symm_apply_eq]; rfl
    simp only [AddEquiv.trans_apply, h1]
    rfl

  have hext : ∀ (X : ModuleCat.{u} A) (P : ProjectiveResolution X) (φ φ' : P.complex.X n ⟶ Y)
      (_ : φ = φ') (hφ : P.complex.d (n + 1) n ≫ φ = 0) (hφ' : P.complex.d (n + 1) n ≫ φ' = 0),
      P.extMk φ (n + 1) rfl hφ = P.extMk φ' (n + 1) rfl hφ' := by
    intro X P φ φ' h hφ hφ'; subst h; rfl

  have s2 : ∀ (X : ModuleCat.{u} A) (P : ProjectiveResolution X) (φ ψ : P.complex.X n ⟶ Y)
      (hφ : P.complex.d (n + 1) n ≫ φ = 0) (hψ : P.complex.d (n + 1) n ≫ ψ = 0)
      (hφψ : P.complex.d (n + 1) n ≫ (φ + ψ) = 0),
      P.extMk (φ + ψ) (n + 1) rfl hφψ = P.extMk φ (n + 1) rfl hφ + P.extMk ψ (n + 1) rfl hψ := by
    intro X P φ ψ hφ hψ hφψ
    apply P.extEquivCohomologyClass.injective
    rw [ProjectiveResolution.extEquivCohomologyClass_add,
      ProjectiveResolution.extEquivCohomologyClass_extMk,
      ProjectiveResolution.extEquivCohomologyClass_extMk,
      ProjectiveResolution.extEquivCohomologyClass_extMk,
      ← CochainComplex.HomComplex.CohomologyClass.mk_add,
      ← CochainComplex.HomComplex.Cocycle.toSingleMk_add]
    congr 1

  have s3 : ∀ (X : ModuleCat.{u} A) (P : ProjectiveResolution X) (φ : P.complex.X n ⟶ Y)
      (hφ : P.complex.d (n + 1) n ≫ φ = 0),
      P.extMk φ (n + 1) rfl hφ = 0 ↔
        ∃ g : P.complex.X (n - 1) ⟶ Y, P.complex.d n (n - 1) ≫ g = φ := by
    intro X P φ hφ
    cases n with
    | succ p => exact P.extMk_eq_zero_iff φ (p + 1 + 1) rfl hφ p rfl
    | zero =>
      have hd : P.complex.d 0 (0 - 1) = 0 := P.complex.shape _ _ (by simp)
      constructor
      · intro h
        refine ⟨0, ?_⟩
        rw [hd, Limits.zero_comp]
        have h2 := congrArg P.extEquivCohomologyClass h
        rw [ProjectiveResolution.extEquivCohomologyClass_extMk] at h2
        have h0 : P.extEquivCohomologyClass (0 : Abelian.Ext X Y 0) = 0 := by
          rw [← ProjectiveResolution.extAddEquivCohomologyClass_apply, map_zero]
        rw [h0, CochainComplex.HomComplex.CohomologyClass.mk_eq_zero_iff,
          CochainComplex.HomComplex.Cocycle.toSingleMk_mem_coboundaries_iff _ _ _ _ _ 1
            (by simp)] at h2
        obtain ⟨g, hg⟩ := h2
        have hz : Limits.IsZero (P.cochainComplex.X 1) :=
          HomologicalComplex.isZero_extend_X _ _ _ (fun i => by
            rw [ComplexShape.embeddingDownNat_f]; omega)
        rw [hz.eq_of_src g 0, Limits.comp_zero] at hg
        exact ((cancel_epi _).mp (by rw [Limits.comp_zero]; exact hg))
      · rintro ⟨g, hg⟩
        rw [hd, Limits.zero_comp] at hg
        subst hg
        exact P.extMk_zero _ _

  have s4 : ∀ (K K' : HomologicalComplex (ModuleCat.{u} A)ᵒᵖ (ComplexShape.down ℕ)) (φ : K ⟶ K'),
      HomologicalComplex.homologyMap
          ((HomologicalComplex.unopFunctor (ModuleCat.{u} A) (ComplexShape.down ℕ)).map φ.op) n ≫
          (K.homologyUnop n).hom =
        (K'.homologyUnop n).hom ≫ (HomologicalComplex.homologyMap φ n).unop := by
    intro K K' φ
    have := HomologicalComplex.homologyOp_hom_naturality
      ((HomologicalComplex.unopFunctor (ModuleCat.{u} A) (ComplexShape.down ℕ)).map φ.op) n
    have := congrArg Quiver.Hom.unop this
    exact this.symm

  have gen1 : ∀ {c d c' b' : ModuleCat.{u} A} (U : c ≅ d) (U' : c' ≅ b') (H : c' ⟶ c)
      (M : b' ⟶ d), H ≫ U.hom = U'.hom ≫ M → U'.inv ≫ H = M ≫ U.inv := by
    intro c d c' b' U U' H M h
    rw [Iso.eq_comp_inv, Category.assoc, h, Iso.inv_hom_id_assoc]
  have gen2 : ∀ {a b c d b' c' : ModuleCat.{u} A} (D : a ⟶ b) (I : b ⟶ c) (Uinv : c ⟶ d)
      (I' : a ⟶ b') (U'inv : b' ⟶ c') (H : c' ⟶ d) (M : b' ⟶ c),
      D ≫ I = I' ≫ M → U'inv ≫ H = M ≫ Uinv → D ≫ (I ≫ Uinv) = (I' ≫ U'inv) ≫ H := by
    intro a b c d b' c' D I Uinv I' U'inv H M h1 h2
    rw [← Category.assoc, h1, Category.assoc, ← h2, Category.assoc]

  have s5 : ∀ (X X' : ModuleCat.{u} A) (f : X ⟶ X') (P : ProjectiveResolution X)
      (P' : ProjectiveResolution X') (L : P.complex ⟶ P'.complex),
      L.f 0 ≫ P'.π.f 0 = P.π.f 0 ≫ f →
      ((Ext A (ModuleCat.{u} A) n).map f.op).app Y ≫ (P.isoExt n Y).hom =
        (P'.isoExt n Y).hom ≫ HomologicalComplex.homologyMap
          ((HomologicalComplex.unopFunctor (ModuleCat.{u} A) (ComplexShape.down ℕ)).map
            ((((linearYoneda A (ModuleCat.{u} A)).obj Y).rightOp.mapHomologicalComplex
              (ComplexShape.down ℕ)).map L).op) n := by
    intro X X' f P P' L hL
    have hc := ProjectiveResolution.isoLeftDerivedObj_inv_naturality f P P' L hL
      ((linearYoneda A (ModuleCat.{u} A)).obj Y).rightOp n
    have hc'' : ((((linearYoneda A (ModuleCat.{u} A)).obj Y).rightOp.leftDerived n).map f).unop ≫
        (P.isoLeftDerivedObj ((linearYoneda A (ModuleCat.{u} A)).obj Y).rightOp n).inv.unop =
        (P'.isoLeftDerivedObj ((linearYoneda A (ModuleCat.{u} A)).obj Y).rightOp n).inv.unop ≫
        (HomologicalComplex.homologyMap ((((linearYoneda A (ModuleCat.{u} A)).obj Y).rightOp.mapHomologicalComplex
              (ComplexShape.down ℕ)).map L) n).unop :=
      congrArg Quiver.Hom.unop hc
    have hd := s4 _ _ ((((linearYoneda A (ModuleCat.{u} A)).obj Y).rightOp.mapHomologicalComplex
      (ComplexShape.down ℕ)).map L)
    have hd' := gen1 _ _ _ _ hd
    exact gen2 _ _ _ _ _ _ _ hc'' hd'

  have dapp : ∀ (X : ModuleCat.{u} A) (P : ProjectiveResolution X) (i j : ℕ)
      (φ : P.complex.X i ⟶ Y),
      ((P.complex.linearYonedaObj A Y).d i j).hom φ = P.complex.d j i ≫ φ := by
    intro X P i j φ
    rw [ChainComplex.linearYonedaObj_d]; rfl
  have hprev : (ComplexShape.up ℕ).prev n = n - 1 := by
    cases n with
    | zero => exact ComplexShape.prev_eq_self _ _ (by simp)
    | succ k =>
      rw [Nat.add_sub_cancel]
      exact ComplexShape.prev_eq' _ (by simp)
  have hcyc : ∀ (X : ModuleCat.{u} A) (P : ProjectiveResolution X)
      (z : ↑((P.complex.linearYonedaObj A Y).cycles n)),
      P.complex.d (n + 1) n ≫ ((P.complex.linearYonedaObj A Y).iCycles n).hom z = 0 := by
    intro X P z
    have h1 := (dapp X P n (n + 1) (((P.complex.linearYonedaObj A Y).iCycles n).hom z)).symm
    rw [h1, ← capp, HomologicalComplex.iCycles_d]; rfl

  have main : ∀ (X : ModuleCat.{u} A) (P : ProjectiveResolution X),
      ∃ e : ↑(((Ext A (ModuleCat.{u} A) n).obj (Opposite.op X)).obj Y) ≃+ Abelian.Ext X Y n,
        ∀ z : ↑((P.complex.linearYonedaObj A Y).cycles n),
          e ((P.isoExt n Y).inv.hom (((P.complex.linearYonedaObj A Y).homologyπ n).hom z)) =
            P.extMk (((P.complex.linearYonedaObj A Y).iCycles n).hom z) (n + 1) rfl
              (hcyc X P z) := by
    intro X P
    have hi : Function.Injective ((P.complex.linearYonedaObj A Y).iCycles n).hom :=
      (ModuleCat.mono_iff_injective _).mp inferInstance
    have hπs : Function.Surjective ((P.complex.linearYonedaObj A Y).homologyπ n).hom :=
      (ModuleCat.epi_iff_surjective _).mp inferInstance
    have hlift : ∀ φ : P.complex.X n ⟶ Y, P.complex.d (n + 1) n ≫ φ = 0 →
        ∃ z, ((P.complex.linearYonedaObj A Y).iCycles n).hom z = φ := by
      intro φ hφ
      have hS := (ShortComplex.mk ((P.complex.linearYonedaObj A Y).iCycles n)
        ((P.complex.linearYonedaObj A Y).d n (n + 1))
        ((P.complex.linearYonedaObj A Y).iCycles_d n (n + 1))).exact_of_f_is_kernel
        ((P.complex.linearYonedaObj A Y).cyclesIsKernel n (n + 1) (CochainComplex.next ℕ n))
      rw [ShortComplex.moduleCat_exact_iff] at hS
      exact hS φ ((dapp X P n (n + 1) φ).trans hφ)
    have hker : ∀ z : ↑((P.complex.linearYonedaObj A Y).cycles n),
        ((P.complex.linearYonedaObj A Y).homologyπ n).hom z = 0 ↔
          ∃ g : P.complex.X (n - 1) ⟶ Y,
            P.complex.d n (n - 1) ≫ g = ((P.complex.linearYonedaObj A Y).iCycles n).hom z := by
      intro z
      constructor
      · intro hz
        have hS := (ShortComplex.mk ((P.complex.linearYonedaObj A Y).toCycles (n - 1) n)
          ((P.complex.linearYonedaObj A Y).homologyπ n)
          ((P.complex.linearYonedaObj A Y).toCycles_comp_homologyπ (n - 1) n)).exact_of_g_is_cokernel
          ((P.complex.linearYonedaObj A Y).homologyIsCokernel (n - 1) n hprev)
        rw [ShortComplex.moduleCat_exact_iff] at hS
        obtain ⟨g, hg⟩ := hS z hz
        refine ⟨g, ?_⟩
        have e1 := congrArg (fun h => h.hom g)
          (HomologicalComplex.toCycles_i (P.complex.linearYonedaObj A Y) (n - 1) n)
        have e2 : ((P.complex.linearYonedaObj A Y).iCycles n).hom
            (((P.complex.linearYonedaObj A Y).toCycles (n - 1) n).hom g) =
            ((P.complex.linearYonedaObj A Y).iCycles n).hom z :=
          congrArg (fun x => ((P.complex.linearYonedaObj A Y).iCycles n).hom x) hg
        exact (dapp X P (n - 1) n g).symm.trans (e1.symm.trans e2)
      · rintro ⟨g, hg⟩
        obtain ⟨g', hg'⟩ : ∃ g' : ↑((P.complex.linearYonedaObj A Y).X (n - 1)), g' = g :=
          ⟨g, rfl⟩
        have e1 : ((P.complex.linearYonedaObj A Y).iCycles n).hom
            (((P.complex.linearYonedaObj A Y).toCycles (n - 1) n).hom g') =
            ((P.complex.linearYonedaObj A Y).d (n - 1) n).hom g' :=
          congrArg (fun h => h.hom g')
            (HomologicalComplex.toCycles_i (P.complex.linearYonedaObj A Y) (n - 1) n)
        have e3 : ((P.complex.linearYonedaObj A Y).d (n - 1) n).hom g' =
            ((P.complex.linearYonedaObj A Y).iCycles n).hom z := by
          subst hg'
          exact (dapp X P (n - 1) n g').trans hg
        have h1 : ((P.complex.linearYonedaObj A Y).toCycles (n - 1) n).hom g' = z :=
          hi (e1.trans e3)
        rw [← h1]
        exact (congrArg (fun h => h.hom g')
          (HomologicalComplex.toCycles_comp_homologyπ (P.complex.linearYonedaObj A Y) (n - 1) n)).trans
          rfl
    have hinv : ∀ w : ↑((P.complex.linearYonedaObj A Y).homology n),
        (P.isoExt n Y).inv.hom w = 0 ↔ w = 0 := by
      intro w
      constructor
      · intro h
        have h1 : (P.isoExt n Y).hom.hom ((P.isoExt n Y).inv.hom w) = w := by
          rw [← capp, Iso.inv_hom_id]; rfl
        rw [← h1, h, map_zero]
      · rintro rfl; exact map_zero _
    let Ψ' : ↑((P.complex.linearYonedaObj A Y).cycles n) →+
        ↑(((Ext A (ModuleCat.{u} A) n).obj (Opposite.op X)).obj Y) :=
      ((P.isoExt n Y).inv.hom.comp
        ((P.complex.linearYonedaObj A Y).homologyπ n).hom).toAddMonoidHom
    let Φ' : ↑((P.complex.linearYonedaObj A Y).cycles n) →+ Abelian.Ext X Y n :=
      AddMonoidHom.mk' (fun z => P.extMk (((P.complex.linearYonedaObj A Y).iCycles n).hom z)
          (n + 1) rfl (hcyc X P z))
        (fun a b => by
          have hab : P.complex.d (n + 1) n ≫
              ((((P.complex.linearYonedaObj A Y).iCycles n).hom a : P.complex.X n ⟶ Y) +
                (((P.complex.linearYonedaObj A Y).iCycles n).hom b : P.complex.X n ⟶ Y)) = 0 := by
            have h0 := Preadditive.comp_add _ _ _ (P.complex.d (n + 1) n)
              (((P.complex.linearYonedaObj A Y).iCycles n).hom a : P.complex.X n ⟶ Y)
              (((P.complex.linearYonedaObj A Y).iCycles n).hom b : P.complex.X n ⟶ Y)
            rw [hcyc, hcyc, add_zero] at h0
            exact h0
          rw [← s2 X P _ _ (hcyc X P a) (hcyc X P b) hab]
          exact hext X P _ _ (map_add _ a b) _ _)
    obtain ⟨e, he⟩ := s1 Ψ' Φ'
      (fun y => by
        obtain ⟨z, hz⟩ := hπs ((P.isoExt n Y).hom.hom y)
        refine ⟨z, ?_⟩
        show (P.isoExt n Y).inv.hom (((P.complex.linearYonedaObj A Y).homologyπ n).hom z) = y
        rw [hz, ← capp, Iso.hom_inv_id]; rfl)
      (fun α => by
        obtain ⟨φ, hφ, hα⟩ := P.extMk_surjective α (n + 1) rfl
        obtain ⟨z, hz⟩ := hlift φ hφ
        refine ⟨z, ?_⟩
        rw [← hα]
        exact hext X P _ _ hz (hcyc X P z) hφ)
      (fun z => by
        show (P.isoExt n Y).inv.hom (((P.complex.linearYonedaObj A Y).homologyπ n).hom z) = 0 ↔
          P.extMk (((P.complex.linearYonedaObj A Y).iCycles n).hom z) (n + 1) rfl (hcyc X P z) = 0
        exact (hinv _).trans ((hker z).trans (s3 X P _ (hcyc X P z)).symm))
    exact ⟨e, he⟩
  choose e he using fun X => main X (ProjectiveResolution.of X)
  refine ⟨e, ?_⟩
  intro X X' f y
  obtain ⟨L, hL⟩ : ∃ L : (ProjectiveResolution.of X).complex ⟶ (ProjectiveResolution.of X').complex,
      L.f 0 ≫ (ProjectiveResolution.of X').π.f 0 = (ProjectiveResolution.of X).π.f 0 ≫ f :=
    ⟨_, ProjectiveResolution.lift_commutes_zero f _ _⟩
  have h5 := s5 X X' f _ _ L hL
  obtain ⟨ψ, hψ⟩ : ∃ ψ : (ProjectiveResolution.of X').complex.linearYonedaObj A Y ⟶
      (ProjectiveResolution.of X).complex.linearYonedaObj A Y,
      ψ = (HomologicalComplex.unopFunctor (ModuleCat.{u} A) (ComplexShape.down ℕ)).map
        ((((linearYoneda A (ModuleCat.{u} A)).obj Y).rightOp.mapHomologicalComplex
          (ComplexShape.down ℕ)).map L).op := ⟨_, rfl⟩
  have h5' : ((Ext A (ModuleCat.{u} A) n).map f.op).app Y ≫
      ((ProjectiveResolution.of X).isoExt n Y).hom =
      ((ProjectiveResolution.of X').isoExt n Y).hom ≫ HomologicalComplex.homologyMap ψ n := by
    subst hψ
    exact h5
  have h6 := gen1 _ _ _ _ h5'
  have hmor : ((ProjectiveResolution.of X').complex.linearYonedaObj A Y).homologyπ n ≫
      ((ProjectiveResolution.of X').isoExt n Y).inv ≫ ((Ext A (ModuleCat.{u} A) n).map f.op).app Y =
      HomologicalComplex.cyclesMap ψ n ≫
        ((ProjectiveResolution.of X).complex.linearYonedaObj A Y).homologyπ n ≫
        ((ProjectiveResolution.of X).isoExt n Y).inv := by
    rw [h6, ← Category.assoc, HomologicalComplex.homologyπ_naturality, Category.assoc]
  obtain ⟨z', hz'⟩ := (ModuleCat.epi_iff_surjective
    (((ProjectiveResolution.of X').complex.linearYonedaObj A Y).homologyπ n)).mp inferInstance
    (((ProjectiveResolution.of X').isoExt n Y).hom.hom y)
  have hy : ((ProjectiveResolution.of X').isoExt n Y).inv.hom
      ((((ProjectiveResolution.of X').complex.linearYonedaObj A Y).homologyπ n).hom z') = y := by
    rw [hz', ← capp, Iso.hom_inv_id]; rfl
  rw [← hy, he X' z']
  have key : (((Ext A (ModuleCat.{u} A) n).map f.op).app Y).hom
      (((ProjectiveResolution.of X').isoExt n Y).inv.hom
        ((((ProjectiveResolution.of X').complex.linearYonedaObj A Y).homologyπ n).hom z')) =
      ((ProjectiveResolution.of X).isoExt n Y).inv.hom
        ((((ProjectiveResolution.of X).complex.linearYonedaObj A Y).homologyπ n).hom
          ((HomologicalComplex.cyclesMap ψ n).hom z')) :=
    congrArg (fun g => g.hom z') hmor
  rw [key, he X]
  have hL' : L.f 0 ≫ (ProjectiveResolution.of X').π.f 0 =
      (ProjectiveResolution.of X).π.f 0 ≫ ((ChainComplex.single₀ (ModuleCat.{u} A)).map f).f 0 := by
    rw [ChainComplex.single₀_map_f_zero]; exact hL
  have hmk := ProjectiveResolution.mk₀_comp_extMk _ (n + 1) rfl (hcyc X' _ z')
    (ProjectiveResolution.Hom.mk L hL')
  refine Eq.trans ?_ hmk.symm
  have hcm : (((ProjectiveResolution.of X).complex.linearYonedaObj A Y).iCycles n).hom
      ((HomologicalComplex.cyclesMap ψ n).hom z') =
      L.f n ≫ (((ProjectiveResolution.of X').complex.linearYonedaObj A Y).iCycles n).hom z' := by
    have h1 := congrArg (fun g => g.hom z') (HomologicalComplex.cyclesMap_i ψ n)
    refine h1.trans ?_
    subst hψ
    rfl
  exact hext X _ _ _ hcm _ _

theorem wc_plt_lc_mv_vanishing_iff (A : Type u) [CommRing A] (J : Ideal A) (M : ModuleCat.{u} A) (i : ℕ) :
    Limits.IsZero ((localCohomology J i).obj M) ↔
    ∀ (t : ℕ) (y : ↑(((Ext A (ModuleCat.{u} A) i).obj
        (Opposite.op (ModuleCat.of A (A ⧸ J ^ t)))).obj M)),
      ∃ (t' : ℕ) (ht : t ≤ t'),
        (((Ext A (ModuleCat.{u} A) i).map
          (ModuleCat.ofHom (Submodule.factor (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t))).op).app M).hom y = 0 :=
by
  have := Limits.preservesFilteredColimitsOfSize_of_univLE.{u, u, 0, 0}
    (forget (ModuleCat.{u} A))
  have e := Limits.colimitObjIsoColimitCompEvaluation
    (localCohomology.diagram (localCohomology.idealPowersDiagram J) i) M
  change Limits.IsZero ((Limits.colimit
    (localCohomology.diagram (localCohomology.idealPowersDiagram J) i)).obj M) ↔ _
  rw [e.isZero_iff, ModuleCat.isZero_iff_subsingleton]
  let F : ℕᵒᵖᵒᵖ ⥤ ModuleCat.{u} A :=
    localCohomology.diagram (localCohomology.idealPowersDiagram J) i ⋙
      (evaluation (ModuleCat.{u} A) (ModuleCat.{u} A)).obj M
  haveI : Limits.PreservesColimit F (forget (ModuleCat.{u} A)) := inferInstance
  change Subsingleton ↑(Limits.colimit F) ↔ _
  constructor
  · intro hS t y
    have hy0 : (ConcreteCategory.hom (Limits.colimit.ι F (Opposite.op (Opposite.op t)))) y = 0 :=
      Subsingleton.elim _ _
    obtain ⟨j', g, hg⟩ := Limits.Concrete.colimit_rep_eq_zero A F
      (Opposite.op (Opposite.op t)) y hy0
    exact ⟨j'.unop.unop, leOfHom g.unop.unop, hg⟩
  · intro H
    have hall : ∀ x : ↑(Limits.colimit F), x = 0 := by
      intro x
      obtain ⟨j, y, rfl⟩ := Limits.Concrete.colimit_exists_rep F x
      rcases j with ⟨⟨t⟩⟩
      obtain ⟨t', ht, hy⟩ := H t y
      rw [← Limits.colimit.w_apply F (homOfLE ht).op.op y]
      have hy' : (ConcreteCategory.hom (F.map (homOfLE ht).op.op)) y = 0 := hy
      rw [hy', map_zero]
    exact ⟨fun x y => (hall x).trans (hall y).symm⟩

theorem wc_plt_lc_cech_vanishing (A : Type u) [CommRing A] [IsNoetherianRing A] (r : ℕ)
    (f : Fin r → A) (M : ModuleCat.{u} A) (i : ℕ) (hi : r < i) :
    Limits.IsZero ((localCohomology (Ideal.span (Set.range f)) i).obj M) :=
by
  classical
  let S : Ideal A → A → ShortComplex (ModuleCat.{u} A) := fun d c =>
    { X₁ := ModuleCat.of A (A ⧸ Submodule.comap (LinearMap.mulLeft A c) d)
      X₂ := ModuleCat.of A (A ⧸ d)
      X₃ := ModuleCat.of A (A ⧸ (d ⊔ Ideal.span {c}))
      f := ModuleCat.ofHom (Submodule.mapQ (Submodule.comap (LinearMap.mulLeft A c) d) d
        (LinearMap.mulLeft A c) le_rfl)
      g := ModuleCat.ofHom (Submodule.factor (le_sup_left : d ≤ d ⊔ Ideal.span {c}))
      zero := by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro a
        obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ a
        change (Submodule.Quotient.mk (c * a) : A ⧸ (d ⊔ Ideal.span {c})) = 0
        rw [Submodule.Quotient.mk_eq_zero]
        exact Ideal.mem_sup_right (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self c)) }
  let H : ∀ {d' d : Ideal A} (_ : d' ≤ d) (c v : A), S d' (c * v) ⟶ S d c := fun {d' d} hd c v =>
    { τ₁ := ModuleCat.ofHom (Submodule.mapQ (Submodule.comap (LinearMap.mulLeft A (c * v)) d')
        (Submodule.comap (LinearMap.mulLeft A c) d) (LinearMap.mulLeft A v) (by
          intro a ha
          simp only [Submodule.mem_comap, LinearMap.mulLeft_apply] at ha ⊢
          rw [← mul_assoc]; exact hd ha))
      τ₂ := ModuleCat.ofHom (Submodule.factor hd)
      τ₃ := ModuleCat.ofHom (Submodule.factor (sup_le (hd.trans le_sup_left)
        ((Ideal.span_singleton_le_iff_mem _).mpr
          (Ideal.mem_sup_right (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self c))))))
      comm₁₂ := by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro a
        obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ a
        change (Submodule.Quotient.mk (c * (v * a)) : A ⧸ d) = Submodule.Quotient.mk (c * v * a)
        rw [mul_assoc]
      comm₂₃ := by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro a
        obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ a
        rfl }

  have rho_comp : ∀ {k : ℕ} {p q s : Ideal A} (h1 : p ≤ q) (h2 : q ≤ s)
      (y : Abelian.Ext (ModuleCat.of A (A ⧸ s)) M k),
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor h1))).comp
        ((Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor h2))).comp y (zero_add k))
        (zero_add k) =
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor (h1.trans h2)))).comp y
        (zero_add k) := by
    intro k p q s h1 h2 y
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← ModuleCat.ofHom_comp, Submodule.factor_comp]

  have hSE : ∀ (d : Ideal A) (c : A), (S d c).ShortExact := by
    intro d c
    refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
    · rw [ShortComplex.moduleCat_exact_iff]
      intro w hw
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ w
      change (Submodule.Quotient.mk z : A ⧸ (d ⊔ Ideal.span {c})) = 0 at hw
      rw [Submodule.Quotient.mk_eq_zero] at hw
      obtain ⟨β, hβ, γ, hγ, rfl⟩ := Submodule.mem_sup.mp hw
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hγ
      refine ⟨Submodule.Quotient.mk a, ?_⟩
      change (Submodule.Quotient.mk (c * a) : A ⧸ d) = Submodule.Quotient.mk (β + a * c)
      rw [Submodule.Quotient.eq]
      have : c * a - (β + a * c) = -β := by ring
      rw [this]
      exact d.neg_mem hβ
    · rw [ModuleCat.mono_iff_injective]
      intro u v huv
      obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ u
      obtain ⟨b, rfl⟩ := Submodule.Quotient.mk_surjective _ v
      change (Submodule.Quotient.mk (c * a) : A ⧸ d) = Submodule.Quotient.mk (c * b) at huv
      rw [Submodule.Quotient.eq] at huv
      change (Submodule.Quotient.mk a : A ⧸ Submodule.comap (LinearMap.mulLeft A c) d) =
        Submodule.Quotient.mk b
      rw [Submodule.Quotient.eq, Submodule.mem_comap, LinearMap.mulLeft_apply, mul_sub]
      exact huv
    · rw [ModuleCat.epi_iff_surjective]
      intro w
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ w
      exact ⟨Submodule.Quotient.mk z, rfl⟩

  have hstab : ∀ (I : Ideal A) (z : A), ∃ N : ℕ, ∀ m : ℕ, N ≤ m → ∀ a : A,
      z ^ m * a ∈ I → z ^ N * a ∈ I := by
    intro I z
    let C : ℕ →o Ideal A := ⟨fun m => Submodule.comap (LinearMap.mulLeft A (z ^ m)) I, by
      intro m m' hmm' a ha
      simp only [Submodule.mem_comap, LinearMap.mulLeft_apply] at ha ⊢
      obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hmm'
      rw [pow_add, mul_comm (z ^ m), mul_assoc]
      exact I.mul_mem_left _ ha⟩
    obtain ⟨N, hN⟩ := WellFoundedGT.monotone_chain_condition C
    refine ⟨N, fun m hm a ha => ?_⟩
    have h1 : a ∈ C m := by
      show a ∈ Submodule.comap (LinearMap.mulLeft A (z ^ m)) I
      rw [Submodule.mem_comap, LinearMap.mulLeft_apply]; exact ha
    rw [← hN m hm] at h1
    change a ∈ Submodule.comap (LinearMap.mulLeft A (z ^ N)) I at h1
    rw [Submodule.mem_comap, LinearMap.mulLeft_apply] at h1
    exact h1

  have hstep : ∀ (𝔟 : Ideal A) (x : A) (n : ℕ),
      (∀ j : ℕ, n < j → ∀ (𝔠 : Ideal A), 𝔟 ≤ 𝔠.radical →
        ∀ (y : Abelian.Ext (ModuleCat.of A (A ⧸ 𝔠)) M j),
          ∃ (𝔠' : Ideal A) (h : 𝔠' ≤ 𝔠), 𝔟 ≤ 𝔠'.radical ∧
            (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor h))).comp y (zero_add j) = 0) →
      ∀ k : ℕ, n + 1 < k → ∀ (𝔠 : Ideal A), 𝔟 ⊔ Ideal.span {x} ≤ 𝔠.radical →
        ∀ (y : Abelian.Ext (ModuleCat.of A (A ⧸ 𝔠)) M k),
          ∃ (𝔠' : Ideal A) (h : 𝔠' ≤ 𝔠), 𝔟 ⊔ Ideal.span {x} ≤ 𝔠'.radical ∧
            (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor h))).comp y (zero_add k) = 0 := by
    intro 𝔟 x n hW k hk 𝔠 h𝔠 y
    obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    have h𝔟 : 𝔟 ≤ 𝔠.radical := le_sup_left.trans h𝔠
    have hx : x ∈ 𝔠.radical := h𝔠 (Ideal.mem_sup_right (Ideal.mem_span_singleton_self x))
    obtain ⟨s, hs⟩ := hx
    obtain ⟨𝔡, h𝔡, h𝔡r, hy⟩ := hW (k' + 1) (by omega) 𝔠 h𝔟 y
    have h3 : 𝔡 ⊔ Ideal.span {x ^ s} ≤ 𝔠 :=
      sup_le h𝔡 ((Ideal.span_singleton_le_iff_mem _).mpr hs)
    set y₂ := (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor h3))).comp y (zero_add _)
      with hy₂
    have h4 : (Abelian.Ext.mk₀ (S 𝔡 (x ^ s)).g).comp y₂ (zero_add _) = 0 := by
      rw [hy₂]
      change (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
        (le_sup_left : 𝔡 ≤ 𝔡 ⊔ Ideal.span {x ^ s})))).comp _ _ = 0
      rw [rho_comp]
      exact hy
    obtain ⟨z, hz⟩ := Abelian.Ext.contravariant_sequence_exact₃ (hSE 𝔡 (x ^ s)) M y₂ h4
      (show 1 + k' = k' + 1 by omega)
    have h6 : 𝔟 ≤ Ideal.radical (Submodule.comap (LinearMap.mulLeft A (x ^ s)) 𝔡) := by
      refine h𝔡r.trans (Ideal.radical_mono ?_)
      intro a ha
      rw [Submodule.mem_comap, LinearMap.mulLeft_apply]
      exact 𝔡.mul_mem_left _ ha
    obtain ⟨𝔢, h𝔢, h𝔢r, hz0⟩ := hW k' (by omega) _ h6 z
    obtain ⟨N, hN⟩ := hstab 𝔢 x
    have hμ : Submodule.comap (LinearMap.mulLeft A (x ^ s * x ^ N)) (𝔢 ⊓ 𝔡) ≤
        Submodule.comap (LinearMap.mulLeft A (x ^ N)) 𝔢 := by
      intro a ha
      rw [Submodule.mem_comap, LinearMap.mulLeft_apply] at ha ⊢
      have h1 := (Submodule.mem_inf.mp ha).1
      rw [← pow_add] at h1
      exact hN (s + N) (by omega) a h1
    have h9 : (Abelian.Ext.mk₀ (H (inf_le_right : 𝔢 ⊓ 𝔡 ≤ 𝔡) (x ^ s) (x ^ N)).τ₁).comp
        z (zero_add k') = 0 := by
      have e : (H (inf_le_right : 𝔢 ⊓ 𝔡 ≤ 𝔡) (x ^ s) (x ^ N)).τ₁ =
          ModuleCat.ofHom (Submodule.mapQ _ _ (LinearMap.mulLeft A (x ^ N)) hμ) ≫
            ModuleCat.ofHom (Submodule.factor h𝔢) := by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        intro a
        obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ a
        rfl
      have h9' : (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.mapQ _ _ (LinearMap.mulLeft A (x ^ N)) hμ))).comp
          ((Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor h𝔢))).comp z (zero_add k'))
          (zero_add k') = 0 := by
        rw [hz0, Abelian.Ext.comp_zero]
      exact (congrArg (fun φ => (Abelian.Ext.mk₀ φ).comp z (zero_add k')) e).trans
        ((Abelian.Ext.mk₀_comp_mk₀_assoc _ _ z).symm.trans h9')
    have hnat := ShortComplex.ShortExact.extClass_naturality (hSE (𝔢 ⊓ 𝔡) (x ^ s * x ^ N))
      (hSE 𝔡 (x ^ s)) (H (inf_le_right : 𝔢 ⊓ 𝔡 ≤ 𝔡) (x ^ s) (x ^ N))
    have h10 : (Abelian.Ext.mk₀ (H (inf_le_right : 𝔢 ⊓ 𝔡 ≤ 𝔡) (x ^ s) (x ^ N)).τ₃).comp
        y₂ (zero_add _) = 0 := by
      rw [← hz, ← Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (show 1 + k' = k' + 1 by omega)
        (by omega), ← hnat, Abelian.Ext.comp_assoc_of_second_deg_zero, h9, Abelian.Ext.comp_zero]
    have hτ3 : 𝔢 ⊓ 𝔡 ⊔ Ideal.span {x ^ s * x ^ N} ≤ 𝔡 ⊔ Ideal.span {x ^ s} :=
      sup_le (inf_le_right.trans le_sup_left) ((Ideal.span_singleton_le_iff_mem _).mpr
        (Ideal.mem_sup_right (Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _))))
    refine ⟨𝔢 ⊓ 𝔡 ⊔ Ideal.span {x ^ s * x ^ N}, hτ3.trans h3, ?_, ?_⟩
    · apply sup_le
      · intro a ha
        have h1 : a ∈ (𝔢 ⊓ 𝔡).radical := by
          rw [Ideal.radical_inf]; exact ⟨h𝔢r ha, h𝔡r ha⟩
        exact Ideal.radical_mono le_sup_left h1
      · rw [Ideal.span_singleton_le_iff_mem]
        exact ⟨s + N, by
          rw [pow_add]; exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)⟩
    · rw [← rho_comp hτ3 h3]
      exact h10

  have hproj : Projective (ModuleCat.of A (A ⧸ (⊥ : Ideal A))) :=
    (IsProjective.iff_projective (A ⧸ (⊥ : Ideal A))).mp
      (Module.Projective.of_equiv (Submodule.quotEquivOfEqBot (⊥ : Ideal A) rfl).symm)
  have hind : ∀ (r : ℕ) (f : Fin r → A), ∀ k : ℕ, r < k → ∀ (𝔠 : Ideal A),
      Ideal.span (Set.range f) ≤ 𝔠.radical →
        ∀ (y : Abelian.Ext (ModuleCat.of A (A ⧸ 𝔠)) M k),
          ∃ (𝔠' : Ideal A) (h : 𝔠' ≤ 𝔠), Ideal.span (Set.range f) ≤ 𝔠'.radical ∧
            (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor h))).comp y (zero_add k) = 0 := by
    intro r
    induction r with
    | zero =>
      intro f k hk 𝔠 _ y
      obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
      refine ⟨⊥, bot_le, ?_, Abelian.Ext.eq_zero_of_projective _⟩
      rw [Set.range_eq_empty, Ideal.span_empty]
      exact bot_le
    | succ r ih =>
      intro f
      have e : Ideal.span (Set.range f) =
          Ideal.span (Set.range (Fin.init f)) ⊔ Ideal.span {f (Fin.last r)} := by
        calc Ideal.span (Set.range f)
            = Ideal.span (Set.range (Fin.snoc (Fin.init f) (f (Fin.last r)) : Fin (r + 1) → A)) := by
              rw [Fin.snoc_init_self]
          _ = _ := by rw [Fin.range_snoc, Ideal.span_insert, sup_comm]
      rw [e]
      intro k hk
      exact hstep _ _ r (ih (Fin.init f)) k (by omega)
  set J := Ideal.span (Set.range f) with hJdef
  have hWJ := hind r f i hi

  have hJfg : J.FG := Submodule.fg_span (Set.finite_range f)
  have hP : ∀ (t : ℕ) (y : Abelian.Ext (ModuleCat.of A (A ⧸ J ^ t)) M i), ∃ (t' : ℕ) (ht : t ≤ t'),
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t)))).comp y (zero_add i) = 0 := by
    intro t y
    have hJt : J ≤ (J ^ t).radical := by
      rcases Nat.eq_zero_or_pos t with h0 | h0
      · subst h0; rw [pow_zero, Ideal.one_eq_top, Ideal.radical_top]; exact le_top
      · rw [Ideal.radical_pow _ (by omega)]; exact Ideal.le_radical
    obtain ⟨𝔠', h𝔠', h𝔠'r, hy⟩ := hWJ (J ^ t) hJt y
    obtain ⟨m, hm⟩ := Ideal.exists_pow_le_of_le_radical_of_fg h𝔠'r hJfg
    have hle : J ^ max m t ≤ 𝔠' := (Ideal.pow_le_pow_right (le_max_left m t)).trans hm
    refine ⟨max m t, le_max_right m t, ?_⟩
    have := rho_comp hle h𝔠' y
    rw [hy, Abelian.Ext.comp_zero] at this
    exact this.symm

  rw [wc_plt_lc_mv_vanishing_iff A J M i]
  intro t y₀
  obtain ⟨e, he⟩ := wc_plt_lc_mv_ext_comparison A M i
  obtain ⟨t', ht, h0⟩ := hP t (e _ y₀)
  refine ⟨t', ht, ?_⟩
  have h1 := he (ModuleCat.of A (A ⧸ J ^ t')) (ModuleCat.of A (A ⧸ J ^ t))
    (ModuleCat.ofHom (Submodule.factor (Ideal.pow_le_pow_right ht))) y₀
  rw [h0] at h1
  exact (e _).map_eq_zero_iff.mp h1

theorem wc_plt_lc_mayer_vietoris_zero (A : Type u) [CommRing A] [IsNoetherianRing A]
    (𝔞 𝔟 : Ideal A) (M : ModuleCat.{u} A) (n : ℕ)
    (h0 : Limits.IsZero ((localCohomology (𝔞 ⊓ 𝔟) n).obj M))
    (h1 : Limits.IsZero ((localCohomology 𝔞 (n + 1)).obj M))
    (h2 : Limits.IsZero ((localCohomology 𝔟 (n + 1)).obj M)) :
    Limits.IsZero ((localCohomology (𝔞 ⊔ 𝔟) (n + 1)).obj M) :=
by
  classical
  let wcMvRes : ∀ {I I' : Ideal A}, I ≤ I' → ∀ {i : ℕ},
      Abelian.Ext (ModuleCat.of A (A ⧸ I')) M i → Abelian.Ext (ModuleCat.of A (A ⧸ I)) M i :=
    fun {I I'} h {i} y =>
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor h))).comp y (zero_add i)
  let wcMvSes : Ideal A → Ideal A → ShortComplex (ModuleCat.{u} A) := fun I J =>
    ShortComplex.mk
      (ModuleCat.ofHom (LinearMap.prod (Submodule.factor (inf_le_left : I ⊓ J ≤ I))
        (Submodule.factor (inf_le_right : I ⊓ J ≤ J))) :
        ModuleCat.of A (A ⧸ (I ⊓ J)) ⟶ ModuleCat.of A ((A ⧸ I) × (A ⧸ J)))
      (ModuleCat.ofHom (LinearMap.coprod (Submodule.factor (le_sup_left : I ≤ I ⊔ J))
        (-Submodule.factor (le_sup_right : J ≤ I ⊔ J))) :
        ModuleCat.of A ((A ⧸ I) × (A ⧸ J)) ⟶ ModuleCat.of A (A ⧸ (I ⊔ J)))
      (by
        ext
        simp)

  have hcrit : ∀ (J : Ideal A) (i : ℕ), Limits.IsZero ((localCohomology J i).obj M) ↔
      ∀ (t : ℕ) (y : ↑(((Ext A (ModuleCat.{u} A) i).obj
          (Opposite.op (ModuleCat.of A (A ⧸ J ^ t)))).obj M)),
        ∃ (t' : ℕ) (ht : t ≤ t'),
          (((Ext A (ModuleCat.{u} A) i).map
            (ModuleCat.ofHom (Submodule.factor
              (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t))).op).app M).hom y = 0 := by
    intro J i
    have := Limits.preservesFilteredColimitsOfSize_of_univLE.{u, u, 0, 0}
      (forget (ModuleCat.{u} A))
    have e := Limits.colimitObjIsoColimitCompEvaluation
      (localCohomology.diagram (localCohomology.idealPowersDiagram J) i) M
    change Limits.IsZero ((Limits.colimit
      (localCohomology.diagram (localCohomology.idealPowersDiagram J) i)).obj M) ↔ _
    rw [e.isZero_iff, ModuleCat.isZero_iff_subsingleton]
    let F : ℕᵒᵖᵒᵖ ⥤ ModuleCat.{u} A :=
      localCohomology.diagram (localCohomology.idealPowersDiagram J) i ⋙
        (evaluation (ModuleCat.{u} A) (ModuleCat.{u} A)).obj M
    haveI : Limits.PreservesColimit F (forget (ModuleCat.{u} A)) := inferInstance
    change Subsingleton ↑(Limits.colimit F) ↔ _
    constructor
    · intro hS t y
      have hy0 : (ConcreteCategory.hom (Limits.colimit.ι F (Opposite.op (Opposite.op t)))) y = 0 :=
        Subsingleton.elim _ _
      obtain ⟨j', g, hg⟩ := Limits.Concrete.colimit_rep_eq_zero A F
        (Opposite.op (Opposite.op t)) y hy0
      exact ⟨j'.unop.unop, leOfHom g.unop.unop, hg⟩
    · intro H
      have hall : ∀ x : ↑(Limits.colimit F), x = 0 := by
        intro x
        obtain ⟨j, y, rfl⟩ := Limits.Concrete.colimit_exists_rep F x
        rcases j with ⟨⟨t⟩⟩
        obtain ⟨t', ht, hy⟩ := H t y
        rw [← Limits.colimit.w_apply F (homOfLE ht).op.op y]
        have hy' : (ConcreteCategory.hom (F.map (homOfLE ht).op.op)) y = 0 := hy
        rw [hy', map_zero]
      exact ⟨fun x y => (hall x).trans (hall y).symm⟩

  have htrans : ∀ (J : Ideal A) (i : ℕ), Limits.IsZero ((localCohomology J i).obj M) ↔
      ∀ (t : ℕ) (y : Abelian.Ext (ModuleCat.of A (A ⧸ J ^ t)) M i), ∃ (t' : ℕ) (ht : t ≤ t'),
        wcMvRes (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t) y = 0 := by
    intro J i
    rw [hcrit J i]
    obtain ⟨e, he⟩ := wc_plt_lc_mv_ext_comparison A M i
    constructor
    · intro H t y
      obtain ⟨t', ht, hy⟩ := H t ((e _).symm y)
      refine ⟨t', ht, ?_⟩
      have h := he _ _ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t))) ((e _).symm y)
      rw [hy, map_zero, AddEquiv.apply_symm_apply] at h
      exact h.symm
    · intro H t y
      obtain ⟨t', ht, hy⟩ := H t (e _ y)
      refine ⟨t', ht, ?_⟩
      have h := he _ _ (ModuleCat.ofHom (Submodule.factor
        (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t))) y
      have hy' : (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
          (Ideal.pow_le_pow_right ht : J ^ t' ≤ J ^ t)))).comp (e _ y) (zero_add i) = 0 := hy
      rw [hy'] at h
      exact (AddEquiv.map_eq_zero_iff (e _)).mp h

  have hAR : ∀ v : ℕ, ∃ w : ℕ, 𝔞 ^ w ⊓ 𝔟 ^ w ≤ (𝔞 ⊓ 𝔟) ^ v := by
    intro v
    obtain ⟨k, hk⟩ := Ideal.exists_pow_inf_eq_pow_smul 𝔞 (M := A) (𝔟 ^ v)
    refine ⟨k + v, ?_⟩
    have h1 := hk (k + v) (by omega)
    rw [Nat.add_sub_cancel_left] at h1
    calc 𝔞 ^ (k + v) ⊓ 𝔟 ^ (k + v) ≤ 𝔞 ^ (k + v) ⊓ 𝔟 ^ v :=
          inf_le_inf_left _ (Ideal.pow_le_pow_right (by omega))
      _ = 𝔞 ^ (k + v) • (⊤ : Ideal A) ⊓ 𝔟 ^ v := by rw [Ideal.smul_eq_mul, Ideal.mul_top]
      _ = 𝔞 ^ v • (𝔞 ^ k • (⊤ : Ideal A) ⊓ 𝔟 ^ v) := h1
      _ ≤ 𝔞 ^ v • 𝔟 ^ v := Submodule.smul_mono le_rfl inf_le_right
      _ = (𝔞 * 𝔟) ^ v := by rw [Ideal.smul_eq_mul, mul_pow]
      _ ≤ (𝔞 ⊓ 𝔟) ^ v := Ideal.pow_right_mono Ideal.mul_le_inf v

  have hS : ∀ I J : Ideal A, (wcMvSes I J).ShortExact := by
    intro I J
    apply ShortComplex.ShortExact.mk'
    · rw [ShortComplex.moduleCat_exact_iff]
      rintro ⟨y', z'⟩ h
      obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ y'
      obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ z'
      have h' : Submodule.Quotient.mk (p := I ⊔ J) y +
          -Submodule.Quotient.mk (p := I ⊔ J) z = 0 := h
      rw [← sub_eq_add_neg, ← Submodule.Quotient.mk_sub, Submodule.Quotient.mk_eq_zero] at h'
      obtain ⟨i, hi, j, hj, hij⟩ := Submodule.mem_sup.mp h'
      refine ⟨Submodule.Quotient.mk (y - i), ?_⟩
      refine Prod.ext ?_ ?_
      · change Submodule.Quotient.mk (p := I) (y - i) = Submodule.Quotient.mk y
        rw [Submodule.Quotient.eq]
        simpa using I.neg_mem hi
      · change Submodule.Quotient.mk (p := J) (y - i) = Submodule.Quotient.mk z
        rw [Submodule.Quotient.eq]
        have : y - i - z = j := by linear_combination -hij
        rw [this]; exact hj
    · rw [ModuleCat.mono_iff_injective]
      refine (injective_iff_map_eq_zero (ConcreteCategory.hom (wcMvSes I J).f)).mpr ?_
      intro x hx
      obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      have h1 := congrArg Prod.fst hx
      have h2 := congrArg Prod.snd hx
      change Submodule.Quotient.mk (p := I) x = 0 at h1
      change Submodule.Quotient.mk (p := J) x = 0 at h2
      change Submodule.Quotient.mk (p := I ⊓ J) x = 0
      rw [Submodule.Quotient.mk_eq_zero] at h1 h2 ⊢
      exact ⟨h1, h2⟩
    · rw [ModuleCat.epi_iff_surjective]
      intro x
      obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      refine ⟨(Submodule.Quotient.mk x, 0), ?_⟩
      change Submodule.Quotient.mk (p := I ⊔ J) x + (-Submodule.factor _) 0 = _
      rw [map_zero, add_zero]

  have hres : ∀ {I I' I'' : Ideal A} (h1 : I ≤ I') (h2 : I' ≤ I'') {i : ℕ}
      (y : Abelian.Ext (ModuleCat.of A (A ⧸ I'')) M i),
      wcMvRes h1 (wcMvRes h2 y) = wcMvRes (h1.trans h2) y := by
    intro I I' I'' h1 h2 i y
    dsimp only [wcMvRes]
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, ← ModuleCat.ofHom_comp, Submodule.factor_comp]
  have hres0 : ∀ {I I' : Ideal A} (h : I ≤ I') {i : ℕ},
      wcMvRes h (0 : Abelian.Ext (ModuleCat.of A (A ⧸ I')) M i) = 0 := by
    intro I I' h i
    dsimp only [wcMvRes]
    exact Abelian.Ext.comp_zero _ _ _ _ _

  have hsplit : ∀ (I J : Ideal A) {i : ℕ}
      (w : Abelian.Ext (ModuleCat.of A ((A ⧸ I) × (A ⧸ J))) M i),
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (LinearMap.inl A (A ⧸ I) (A ⧸ J)))).comp w
        (zero_add i) = 0 →
      (Abelian.Ext.mk₀ (ModuleCat.ofHom (LinearMap.inr A (A ⧸ I) (A ⧸ J)))).comp w
        (zero_add i) = 0 → w = 0 := by
    intro I J i w ha hb
    have hid : 𝟙 (ModuleCat.of A ((A ⧸ I) × (A ⧸ J))) =
        ModuleCat.ofHom (LinearMap.fst A (A ⧸ I) (A ⧸ J)) ≫
          ModuleCat.ofHom (LinearMap.inl A (A ⧸ I) (A ⧸ J)) +
        ModuleCat.ofHom (LinearMap.snd A (A ⧸ I) (A ⧸ J)) ≫
          ModuleCat.ofHom (LinearMap.inr A (A ⧸ I) (A ⧸ J)) := by
      ext x <;> simp
    rw [← Abelian.Ext.mk₀_id_comp w, hid, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp,
      ← Abelian.Ext.mk₀_comp_mk₀_assoc, ← Abelian.Ext.mk₀_comp_mk₀_assoc, ha, hb,
      Abelian.Ext.comp_zero, Abelian.Ext.comp_zero, add_zero]
  have hinl : ∀ I J : Ideal A, ModuleCat.ofHom (LinearMap.inl A (A ⧸ I) (A ⧸ J)) ≫
      (wcMvSes I J).g = ModuleCat.ofHom (Submodule.factor (le_sup_left : I ≤ I ⊔ J)) := by
    intro I J
    ext x
    simp [wcMvSes]
  have hinr : ∀ I J : Ideal A, ModuleCat.ofHom (LinearMap.inr A (A ⧸ I) (A ⧸ J)) ≫
      (wcMvSes I J).g = -ModuleCat.ofHom (Submodule.factor (le_sup_right : J ≤ I ⊔ J)) := by
    intro I J
    ext x
    simp [wcMvSes]

  have V0 := (htrans (𝔞 ⊓ 𝔟) n).mp h0
  have V1 := (htrans 𝔞 (n + 1)).mp h1
  have V2 := (htrans 𝔟 (n + 1)).mp h2
  refine (htrans (𝔞 ⊔ 𝔟) (n + 1)).mpr ?_
  intro t y

  have hle1 : 𝔞 ^ t ⊔ 𝔟 ^ t ≤ (𝔞 ⊔ 𝔟) ^ t :=
    sup_le (Ideal.pow_right_mono le_sup_left t) (Ideal.pow_right_mono le_sup_right t)

  obtain ⟨t₁, ht₁, hy₁⟩ := V1 t (wcMvRes (le_sup_left : 𝔞 ^ t ≤ 𝔞 ^ t ⊔ 𝔟 ^ t)
    (wcMvRes hle1 y))
  obtain ⟨t₂, ht₂, hy₂⟩ := V2 t (wcMvRes (le_sup_right : 𝔟 ^ t ≤ 𝔞 ^ t ⊔ 𝔟 ^ t)
    (wcMvRes hle1 y))
  have htu : t ≤ max t₁ t₂ := le_trans ht₁ (le_max_left _ _)
  have hsup : 𝔞 ^ max t₁ t₂ ⊔ 𝔟 ^ max t₁ t₂ ≤ 𝔞 ^ t ⊔ 𝔟 ^ t :=
    sup_le_sup (Ideal.pow_le_pow_right htu) (Ideal.pow_le_pow_right htu)
  have ka : wcMvRes (le_sup_left : 𝔞 ^ max t₁ t₂ ≤ 𝔞 ^ max t₁ t₂ ⊔ 𝔟 ^ max t₁ t₂)
      (wcMvRes hsup (wcMvRes hle1 y)) = 0 := by
    rw [show wcMvRes (le_sup_left : 𝔞 ^ max t₁ t₂ ≤ 𝔞 ^ max t₁ t₂ ⊔ 𝔟 ^ max t₁ t₂)
        (wcMvRes hsup (wcMvRes hle1 y)) =
        wcMvRes (Ideal.pow_le_pow_right (le_max_left t₁ t₂) : 𝔞 ^ max t₁ t₂ ≤ 𝔞 ^ t₁)
          (wcMvRes (Ideal.pow_le_pow_right ht₁ : 𝔞 ^ t₁ ≤ 𝔞 ^ t)
            (wcMvRes (le_sup_left : 𝔞 ^ t ≤ 𝔞 ^ t ⊔ 𝔟 ^ t) (wcMvRes hle1 y))) by
      rw [hres, hres, hres, hres, hres]]
    rw [hy₁, hres0]
  have kb : wcMvRes (le_sup_right : 𝔟 ^ max t₁ t₂ ≤ 𝔞 ^ max t₁ t₂ ⊔ 𝔟 ^ max t₁ t₂)
      (wcMvRes hsup (wcMvRes hle1 y)) = 0 := by
    rw [show wcMvRes (le_sup_right : 𝔟 ^ max t₁ t₂ ≤ 𝔞 ^ max t₁ t₂ ⊔ 𝔟 ^ max t₁ t₂)
        (wcMvRes hsup (wcMvRes hle1 y)) =
        wcMvRes (Ideal.pow_le_pow_right (le_max_right t₁ t₂) : 𝔟 ^ max t₁ t₂ ≤ 𝔟 ^ t₂)
          (wcMvRes (Ideal.pow_le_pow_right ht₂ : 𝔟 ^ t₂ ≤ 𝔟 ^ t)
            (wcMvRes (le_sup_right : 𝔟 ^ t ≤ 𝔞 ^ t ⊔ 𝔟 ^ t) (wcMvRes hle1 y))) by
      rw [hres, hres, hres, hres, hres]]
    rw [hy₂, hres0]

  have hw2 : (Abelian.Ext.mk₀ (wcMvSes (𝔞 ^ max t₁ t₂) (𝔟 ^ max t₁ t₂)).g).comp
      (wcMvRes hsup (wcMvRes hle1 y)) (zero_add (n + 1)) = 0 := by
    refine hsplit (𝔞 ^ max t₁ t₂) (𝔟 ^ max t₁ t₂) _ ?_ ?_
    · rw [Abelian.Ext.mk₀_comp_mk₀_assoc, hinl]
      exact ka
    · rw [Abelian.Ext.mk₀_comp_mk₀_assoc, hinr, Abelian.Ext.mk₀_neg, Abelian.Ext.neg_comp]
      have kb' : (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor
          (le_sup_right : 𝔟 ^ max t₁ t₂ ≤ 𝔞 ^ max t₁ t₂ ⊔ 𝔟 ^ max t₁ t₂)))).comp
          (wcMvRes hsup (wcMvRes hle1 y)) (zero_add (n + 1)) = 0 := kb
      rw [kb', neg_zero]

  obtain ⟨z, hz⟩ : ∃ z : Abelian.Ext (ModuleCat.of A (A ⧸ (𝔞 ^ max t₁ t₂ ⊓ 𝔟 ^ max t₁ t₂))) M n,
      (hS (𝔞 ^ max t₁ t₂) (𝔟 ^ max t₁ t₂)).extClass.comp z (by omega : 1 + n = n + 1) =
        wcMvRes hsup (wcMvRes hle1 y) :=
    Abelian.Ext.contravariant_sequence_exact₃
      (hS (𝔞 ^ max t₁ t₂) (𝔟 ^ max t₁ t₂)) M _ hw2 (by omega : 1 + n = n + 1)

  have hle2 : (𝔞 ⊓ 𝔟) ^ max t₁ t₂ ≤ 𝔞 ^ max t₁ t₂ ⊓ 𝔟 ^ max t₁ t₂ :=
    le_inf (Ideal.pow_right_mono inf_le_left _) (Ideal.pow_right_mono inf_le_right _)
  obtain ⟨u', hu', hz'⟩ := V0 (max t₁ t₂) (wcMvRes hle2 z)
  obtain ⟨w₀, hw₀⟩ := hAR u'
  have hwu : max t₁ t₂ ≤ max w₀ (max t₁ t₂) := le_max_right _ _
  have hle3 : 𝔞 ^ max w₀ (max t₁ t₂) ⊓ 𝔟 ^ max w₀ (max t₁ t₂) ≤ (𝔞 ⊓ 𝔟) ^ u' :=
    le_trans (inf_le_inf (Ideal.pow_le_pow_right (le_max_left _ _))
      (Ideal.pow_le_pow_right (le_max_left _ _))) hw₀
  have hle4 : 𝔞 ^ max w₀ (max t₁ t₂) ⊓ 𝔟 ^ max w₀ (max t₁ t₂) ≤
      𝔞 ^ max t₁ t₂ ⊓ 𝔟 ^ max t₁ t₂ :=
    inf_le_inf (Ideal.pow_le_pow_right hwu) (Ideal.pow_le_pow_right hwu)
  have hzw : wcMvRes hle4 z = 0 := by
    rw [show wcMvRes hle4 z = wcMvRes hle3 (wcMvRes (Ideal.pow_le_pow_right hu' :
        (𝔞 ⊓ 𝔟) ^ u' ≤ (𝔞 ⊓ 𝔟) ^ max t₁ t₂) (wcMvRes hle2 z)) by rw [hres, hres]]
    rw [hz', hres0]

  have hle5 : 𝔞 ^ max w₀ (max t₁ t₂) ⊔ 𝔟 ^ max w₀ (max t₁ t₂) ≤
      𝔞 ^ max t₁ t₂ ⊔ 𝔟 ^ max t₁ t₂ :=
    sup_le_sup (Ideal.pow_le_pow_right hwu) (Ideal.pow_le_pow_right hwu)
  let Θ : wcMvSes (𝔞 ^ max w₀ (max t₁ t₂)) (𝔟 ^ max w₀ (max t₁ t₂)) ⟶
      wcMvSes (𝔞 ^ max t₁ t₂) (𝔟 ^ max t₁ t₂) :=
    { τ₁ := ModuleCat.ofHom (Submodule.factor hle4)
      τ₂ := ModuleCat.ofHom ((Submodule.factor (Ideal.pow_le_pow_right hwu :
          𝔞 ^ max w₀ (max t₁ t₂) ≤ 𝔞 ^ max t₁ t₂)).prodMap
        (Submodule.factor (Ideal.pow_le_pow_right hwu :
          𝔟 ^ max w₀ (max t₁ t₂) ≤ 𝔟 ^ max t₁ t₂)))
      τ₃ := ModuleCat.ofHom (Submodule.factor hle5)
      comm₁₂ := by
        apply ModuleCat.hom_ext
        apply Submodule.linearMap_qext
        apply LinearMap.ext
        intro x
        rfl
      comm₂₃ := by
        apply ModuleCat.hom_ext
        apply LinearMap.ext
        rintro ⟨y', z'⟩
        obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ y'
        obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ z'
        rfl }
  have hnat : (hS _ _).extClass.comp (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor hle4)))
      (add_zero 1) = (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor hle5))).comp
        (hS (𝔞 ^ max t₁ t₂) (𝔟 ^ max t₁ t₂)).extClass (zero_add 1) :=
    (hS _ _).extClass_naturality (hS _ _) Θ
  have hy2w : wcMvRes hle5 (wcMvRes hsup (wcMvRes hle1 y)) = 0 := by
    rw [← hz]
    dsimp only [wcMvRes] at hzw ⊢
    rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (ModuleCat.ofHom (Submodule.factor hle5)))
      (hS (𝔞 ^ max t₁ t₂) (𝔟 ^ max t₁ t₂)).extClass z (zero_add 1) (by omega) (by omega)]
    rw [← hnat, Abelian.Ext.comp_assoc_of_second_deg_zero, hzw, Abelian.Ext.comp_zero]

  have hle6 : (𝔞 ⊔ 𝔟) ^ max (max w₀ (max t₁ t₂) + max w₀ (max t₁ t₂)) t ≤
      𝔞 ^ max w₀ (max t₁ t₂) ⊔ 𝔟 ^ max w₀ (max t₁ t₂) :=
    (Ideal.pow_le_pow_right (le_max_left _ _)).trans Ideal.sup_pow_add_le_pow_sup_pow
  refine ⟨max (max w₀ (max t₁ t₂) + max w₀ (max t₁ t₂)) t, le_max_right _ _, ?_⟩
  rw [show wcMvRes (Ideal.pow_le_pow_right (le_max_right _ _) :
      (𝔞 ⊔ 𝔟) ^ max (max w₀ (max t₁ t₂) + max w₀ (max t₁ t₂)) t ≤ (𝔞 ⊔ 𝔟) ^ t) y =
      wcMvRes hle6 (wcMvRes hle5 (wcMvRes hsup (wcMvRes hle1 y))) by
    rw [hres, hres, hres]]
  rw [hy2w, hres0]

theorem wc_plt_lc_les (A : Type u) [CommRing A] (I : Ideal A) (S : ShortComplex (ModuleCat.{u} A))
    (hS : S.ShortExact) (n : ℕ) :
    ∃ δ : (localCohomology I n).obj S.X₃ ⟶ (localCohomology I (n + 1)).obj S.X₁,
      Function.Exact ⇑((localCohomology I n).map S.f).hom ⇑((localCohomology I n).map S.g).hom ∧
      Function.Exact ⇑((localCohomology I n).map S.g).hom ⇑δ.hom :=
by

  have s1 : ∀ {X : ModuleCat.{u} A} (P : ProjectiveResolution X),
    ∃ w : (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.g))
          (ComplexShape.down ℕ)).app P.complex ≫
        (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.f))
          (ComplexShape.down ℕ)).app P.complex = 0,
      (ShortComplex.mk _ _ w).ShortExact := by
    intro X P
    have w : (NatTrans.mapHomologicalComplex (NatTrans.rightOp ((linearYoneda A (ModuleCat.{u} A)).map S.g))
            (ComplexShape.down ℕ)).app P.complex ≫
