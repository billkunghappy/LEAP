  have e3 := hβ s y hy
  have e4 : (a.hom.app (Opposite.op ((wcProEtBaseChange i).obj V))).hom
      ((β.hom.hom.app (Opposite.op (Over.mk (𝟙 ((wcProEtBaseChange i).obj V))))).hom y) =
