      refine (whisker_eq _ (Category.assoc _ _ _)).trans ?_
      refine (whisker_eq _ (whisker_eq _ h3)).trans ?_
      refine (whisker_eq _ (Category.assoc _ _ _).symm).trans ?_
      refine (whisker_eq _ (eq_whisker hδn _)).trans ?_
      refine (whisker_eq _ (Category.assoc _ _ _)).trans ?_
      refine (Category.assoc _ _ _).symm.trans ?_
      refine (eq_whisker h1.symm _).trans ?_
