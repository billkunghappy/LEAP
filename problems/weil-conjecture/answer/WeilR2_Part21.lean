  have L4 : ∀ (R₀ : Type u) [CommRing R₀] [Algebra K R₀], RingHom.IsStandardSmoothOfRelativeDimension (n + r) (algebraMap K R₀) → ∀ (e₀ : R₀ →+* K), e₀.comp (algebraMap K R₀) = RingHom.id K → ∀ (t : Fin n → R₀) (ζ : Fin r → R₀), (∀ p, e₀ (t p) = 0) → (∀ k, e₀ (ζ k) = 0) → (∀ x : R₀, e₀ x = 0 → ∃ w : R₀, e₀ w ≠ 0 ∧ w * x ∈ Ideal.span (Set.range t ∪ Set.range ζ)) → ∀ (S₀ : Type u) [CommRing S₀] [Algebra R₀ S₀], RingHom.IsStandardSmoothOfRelativeDimension 0 (algebraMap R₀ S₀) → ∀ (e₀' : S₀ →+* K), e₀'.comp (algebraMap R₀ S₀) = e₀ → ∀ (N : Matrix (Fin n) (Fin n) S₀), (∀ p q, e₀' (N p q) = 0) → ∃ s : S₀, e₀' s ≠ 0 ∧ ∀ (S' : Type u) [CommRing S'] [Algebra S₀ S'] [IsLocalization.Away s S'], RingHom.Etale ((algebraMap S₀ S').comp (MvPolynomial.eval₂Hom ((algebraMap R₀ S₀).comp (algebraMap K R₀)) (Sum.elim ((1 + N).mulVec (fun k => algebraMap R₀ S₀ (t k))) (fun k => algebraMap R₀ S₀ (ζ k))))) := by
