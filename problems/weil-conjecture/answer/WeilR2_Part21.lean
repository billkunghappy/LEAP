by
  classical

  obtain ⟨-, -, -, -, -, -, -, hlamCI, -, -, -, hlamΔ, -⟩ := hH
  have hyΔ : lam (D.S j (IsLocalRing.closedPoint F'')) ∈ Δ := (hlamΔ _).mpr ⟨j, rfl⟩
  have hyc : IsClosed ({lam (D.S j (IsLocalRing.closedPoint F''))} : Set (wcProjK F'' M')) := by
    haveI : IsProper (wcP1Over F'').hom := wc_proj_space_isProper F'' 1
    haveI : IsClosedImmersion (D.S j ≫ (wcP1Over F'').hom) := by rw [D.hS j]; infer_instance
    haveI : IsClosedImmersion (D.S j) := IsClosedImmersion.of_comp (D.S j) (wcP1Over F'').hom
    haveI := hlamCI
    have h1 := (Scheme.Hom.isClosedEmbedding (D.S j ≫ lam)).isClosed_range
