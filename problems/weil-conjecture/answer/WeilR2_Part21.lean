  haveI := D'.additive
  haveI := D'.presLim
  haveI := D'.presColim
  letI hPadd : (@SheafOfModules.pushforward _ _ _ _ _ _
      (wcEtBaseChange (Limits.pullback.fst f z)) _ _ D'.cont D'.φ).Additive :=
