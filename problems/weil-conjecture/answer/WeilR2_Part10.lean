        have h := congrArg (fun k => (k.hom.app (Opposite.op V)).hom x) hψ
        change (ψ.hom.app (Opposite.op ((wcEtBaseChange e).obj V))).hom
          (((αe.unit.app A).hom.app (Opposite.op V)).hom x) = _ at h
        rw [ue] at h
        exact h
      refine ⟨ψ, ?_⟩
      intro V O₁ h₁ hh₁ O₂ h₂ hh₂ x
      have hX : (h₂ ≫ (wcEtInvLift g V O₁ h₁ hh₁).left) ≫ ((wcEtBaseChange g).obj V).hom =
          O₂.hom ≫ t :=
        (Category.assoc _ _ _).trans
          ((congrArg (fun q => h₂ ≫ q) (ls g V O₁ h₁ hh₁)).trans hh₂)
      have hEinv : (wcEtInvLift e V O₂ (h₂ ≫ h₁) (hh12 V O₁ h₁ hh₁ O₂ h₂ hh₂)).left ≫ m V =
          h₂ ≫ (wcEtInvLift g V O₁ h₁ hh₁).left := by
        apply Limits.pullback.hom_ext
        · exact (Category.assoc _ _ _).trans ((congrArg (fun q =>
            (wcEtInvLift e V O₂ (h₂ ≫ h₁) (hh12 V O₁ h₁ hh₁ O₂ h₂ hh₂)).left ≫ q) (hmf V)).trans
            ((lf e V O₂ _ _).trans ((congrArg (fun q => h₂ ≫ q) (lf g V O₁ h₁ hh₁)).symm.trans
              (Category.assoc _ _ _).symm)))
        · exact (Category.assoc _ _ _).trans ((congrArg (fun q =>
            (wcEtInvLift e V O₂ (h₂ ≫ h₁) (hh12 V O₁ h₁ hh₁ O₂ h₂ hh₂)).left ≫ q) (hms V)).trans
            ((lsa e V O₂ _ _ t).trans (hh₂.symm.trans ((congrArg (fun q => h₂ ≫ q)
              (ls g V O₁ h₁ hh₁)).symm.trans (Category.assoc _ _ _).symm))))
      have e1 := (s1 e A V ((wcEtBaseChange e).obj V) O₂
        (wcEtInvLift e V O₂ (h₂ ≫ h₁) (hh12 V O₁ h₁ hh₁ O₂ h₂ hh₂))
        (Limits.pullback.fst V.hom e) Limits.pullback.condition (h₂ ≫ h₁)
        (hh12 V O₁ h₁ hh₁ O₂ h₂ hh₂) (lf e V O₂ _ _) x).symm
      have e4 := s1 t ((wcEtInv g).obj A) ((wcEtBaseChange g).obj V) ((wcEtBaseChange e).obj V) O₂
        (wcEtInvLift e V O₂ (h₂ ≫ h₁) (hh12 V O₁ h₁ hh₁ O₂ h₂ hh₂)) (m V) (hms V)
        (h₂ ≫ (wcEtInvLift g V O₁ h₁ hh₁).left) hX hEinv
        (wcEtInvRho g A V ((wcEtBaseChange g).obj V) (Limits.pullback.fst V.hom g)
          Limits.pullback.condition x)
      have e5 := (s1 g A V ((wcEtBaseChange g).obj V) O₁ (wcEtInvLift g V O₁ h₁ hh₁)
        (Limits.pullback.fst V.hom g) Limits.pullback.condition h₁ hh₁ (lf g V O₁ h₁ hh₁) x).symm
      have e6 := s2 t ((wcEtInv g).obj A) O₁ ((wcEtBaseChange g).obj V) (wcEtInvLift g V O₁ h₁ hh₁)
        O₂ h₂ hh₂ (h₂ ≫ (wcEtInvLift g V O₁ h₁ hh₁).left) hX rfl
        (wcEtInvRho g A V ((wcEtBaseChange g).obj V) (Limits.pullback.fst V.hom g)
          Limits.pullback.condition x)
      exact (congrArg (fun v => (ψ.hom.app (Opposite.op O₂)).hom v) e1).trans
        ((NatTrans.naturality_apply ψ.hom
          (wcEtInvLift e V O₂ (h₂ ≫ h₁) (hh12 V O₁ h₁ hh₁ O₂ h₂ hh₂)).op _).trans
        ((congrArg (fun v => (B.obj.map
          (wcEtInvLift e V O₂ (h₂ ≫ h₁) (hh12 V O₁ h₁ hh₁ O₂ h₂ hh₂)).op).hom v)
          ((hψc V x).trans (hθ V x))).trans
        (e4.trans (e6.symm.trans (congrArg (fun v => wcEtInvRho t ((wcEtInv g).obj A) O₁ O₂ h₂ hh₂ v)
          e5.symm)))))
    have hc : wcEtInvCompInv t g e he A = Classical.choose hψex := by
      rw [wcEtInvCompInv]
