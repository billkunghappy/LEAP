      ((wcEtBaseChange t).obj O₁) ((wcEtBaseChange t).map (wcEtInvLift g V O₁ h₁ hh₁))
      (Limits.pullback.fst ((wcEtBaseChange g).obj V).hom t ≫ Limits.pullback.fst V.hom g)
