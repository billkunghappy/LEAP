  ·
    intro k k' h E E₁ w E' E₁' w' e he e₁ he₁ hc x
    have H1 : (e₁ ≫ w.left) ≫ E.hom = E₁'.hom ≫ (D.map (homOfLE h).op).left := by
      rw [Category.assoc, MorphismProperty.Over.w w, he₁]
