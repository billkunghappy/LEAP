        (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
        φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
      Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
        (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
    refine (Iso.inv_comp_eq _).1 ?_
    apply Limits.colimit.hom_ext
    intro j
    have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
        (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
        φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
      calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
          = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
            (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
        _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
            (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
        _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
              (Category.assoc _ _ _).symm
        _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
            congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
              (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
        _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
            (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
            Category.assoc _ _ _
        _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
            congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
    erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
    exact key
  have wc_lan_preservesFiniteLimits_of_discrete_final : ∀ {C D : Type (u+1)} [Category.{u} C]
      [Category.{u} D] (L : C ⥤ D)
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
      [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F],
      (∀ Y : D, Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
          (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim)) →
      (∀ Y : D, ∃ (I : Type u) (G : Discrete I ⥤ CostructuredArrow L Y), G.Final) →
      Limits.PreservesFiniteLimits
        (L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) := by
    intro C D _ _ L _ _ hiso hfin
    constructor
    intro J _ _
    apply Limits.preservesLimitsOfShape_of_evaluation
    intro Y
    obtain ⟨θ⟩ := hiso Y
    obtain ⟨I, G, hG⟩ := hfin Y
    haveI : HasExactColimitsOfShape (Discrete I) AddCommGrpCat.{u+1} :=
      HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1}
        (Discrete.equivalence (Equiv.ulift : ULift.{u+1} I ≃ I))
    let e2 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
        ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj G ⋙ Limits.colim) ≅
        (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          Limits.colim :=
      Functor.isoWhiskerLeft _ (Functor.Final.colimIso G)
    exact Limits.preservesLimitsOfShape_of_natIso (e2 ≪≫ θ.symm)

  have hdata : ∀ W : S.ProEt,
      (wcSliceFunctor S W).IsContinuous (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S) ∧
      (wcSliceFunctor S W).IsCocontinuous (Scheme.ProEt.topology W.left)
        (Scheme.ProEt.topology S) ∧
      Limits.PreservesFiniteLimits ((wcSliceFunctor S W).op.lan :
        ((W.left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) := by
    intro U
    have hcov : CoverPreserving (Scheme.ProEt.topology U.left) (Scheme.ProEt.topology S)
        (wcSliceFunctor S U) :=
      CoverPreserving.mk (fun {V} {R} hR =>
        (wc_proet_mem_topology_iff S ((wcSliceFunctor S U).obj V)
          (Sieve.functorPushforward (wcSliceFunctor S U) R)).2
          ((Sieve.functorPushforward_comp (wcSliceFunctor S U)
            (Scheme.ProEt.forget S ⋙ Over.forget S) R) ▸
              (wc_proet_mem_topology_iff U.left V R).1 hR))
    refine ⟨Functor.isContinuous_of_coverPreserving (wc_slice_compatiblePreserving S U) hcov,
      Functor.IsCocontinuous.mk (fun {V} {T} hT => ?_),
      wc_lan_preservesFiniteLimits_of_discrete_final (wcSliceFunctor S U).op
        (fun Y => wc_lan_eval_iso (wcSliceFunctor S U).op Y)
        (fun Y => wc_slice_costructuredArrow_final S U Y.unop)⟩
    have h1 := (wc_proet_mem_topology_iff S ((wcSliceFunctor S U).obj V) T).1 hT
    rw [← wc_slice_pushforward_functorPullback S U V T] at h1
    exact (wc_proet_mem_topology_iff U.left V _).2 h1
  haveI hcont : ∀ W : S.ProEt, (wcSliceFunctor S W).IsContinuous (Scheme.ProEt.topology W.left)
      (Scheme.ProEt.topology S) := fun W => (hdata W).1
  haveI hcocont : ∀ W : S.ProEt, (wcSliceFunctor S W).IsCocontinuous
      (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S) := fun W => (hdata W).2.1

  have hexact : ∀ W : S.ProEt,
      (wcSliceExt S W).Additive ∧ Limits.PreservesFiniteLimits (wcSliceExt S W) ∧
      Limits.PreservesFiniteColimits (wcSliceExt S W) ∧
      ((wcSliceFunctor S W).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)).Additive ∧
      Limits.PreservesFiniteLimits ((wcSliceFunctor S W).sheafPushforwardContinuous
        AddCommGrpCat.{u+1} (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)) ∧
      Limits.PreservesFiniteColimits ((wcSliceFunctor S W).sheafPushforwardContinuous
        AddCommGrpCat.{u+1} (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)) := by
    intro W
    haveI hlan := (hdata W).2.2
    let G := (wcSliceFunctor S W).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)
    let adj : wcSliceExt S W ⊣ G := wcSliceAdj S W
    let adj2 := (wcSliceFunctor S W).sheafAdjunctionCocontinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)
    haveI : Limits.PreservesColimitsOfSize.{0, 0} (wcSliceExt S W) :=
      adj.leftAdjoint_preservesColimits
    haveI hLc : Limits.PreservesFiniteColimits (wcSliceExt S W) :=
      Limits.PreservesColimitsOfSize.preservesFiniteColimits _
    haveI : Limits.PreservesLimitsOfSize.{0, 0} G := adj.rightAdjoint_preservesLimits
    haveI hRl : Limits.PreservesFiniteLimits G :=
      Limits.PreservesLimitsOfSize.preservesFiniteLimits _
    haveI : Limits.PreservesColimitsOfSize.{0, 0} G := adj2.leftAdjoint_preservesColimits
    haveI hRc : Limits.PreservesFiniteColimits G :=
      Limits.PreservesColimitsOfSize.preservesFiniteColimits _
    haveI : G.IsRightAdjoint := ⟨_, ⟨adj⟩⟩
    haveI : G.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint G
    haveI hRa : G.Additive := Functor.additive_of_preserves_binary_products G
    haveI hLa : (wcSliceExt S W).Additive := adj.left_adjoint_additive
    haveI hLl : Limits.PreservesFiniteLimits (wcSliceExt S W) := by
      show Limits.PreservesFiniteLimits (sheafToPresheaf _ _ ⋙ (wcSliceFunctor S W).op.lan ⋙
        presheafToSheaf _ _)
      infer_instance
    exact ⟨hLa, hLl, hLc, hRa, hRl, hRc⟩

  choose b hb using fun W : S.ProEt => wc_slice_epsInv_etInv_iso S W G
  choose c hc using fun W : S.ProEt => wc_slice_free_iso S W
  choose σ hσ using fun (W W' : S.ProEt) (t : W' ⟶ W) => wc_slice_sigma S W W' t

  refine ⟨fun W => wcSliceExt S W,
    fun W => (wcSliceFunctor S W).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S),
    fun W => wcSliceAdj S W,
    fun W => (hexact W).1, fun W => (hexact W).2.1, fun W => (hexact W).2.2.1,
    fun W => (hexact W).2.2.2.1, fun W => (hexact W).2.2.2.2.1, fun W => (hexact W).2.2.2.2.2,
    b, c, σ, fun W => wc_etInv_unit_const W.hom, fun W W' t => ?_, fun W W' t => ?_⟩
  · exact wc_slice_M1_of_specs S W W' t (c W).hom (c W').hom (hc W) (hc W') (σ W W' t)
      (hσ W W' t)
  · exact wc_slice_M2_of_specs S W W' t G (b W).hom (b W').hom (hb W) (hb W') (σ W W' t)
      (hσ W W' t)

theorem wc_etale_proet_comparison (S : Scheme.{u})
    (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (n : ℕ) :
    ∃ Θ : ∀ W : S.ProEt, wcEtInvExt W.hom (wcEtUnitSheaf S) G n →+
        Abelian.Ext (wcFreeSheaf S W) ((wcEpsInv S).obj G) n,
      (∀ W : S.ProEt, CompactSpace W.left → QuasiSeparatedSpace W.left →
        Function.Bijective (Θ W)) ∧
      ∀ (W W' : S.ProEt) (t : W' ⟶ W), CompactSpace W.left → QuasiSeparatedSpace W.left →
        CompactSpace W'.left → QuasiSeparatedSpace W'.left →
        ∀ e : wcEtInvExt W.hom (wcEtUnitSheaf S) G n,
          Θ W' (wcEtInvExtPull t.left W.hom W'.hom (MorphismProperty.Over.w t)
            (wcEtUnitSheaf S) G n e) =
            (Abelian.Ext.mk₀ (wcFreeSheafMap S t)).comp (Θ W e) (zero_add n) :=
by
  classical

  obtain ⟨L, R, adj, hLa, hLl, hLc, hRa, hRl, hRc, b, c, σ, hunit, hM1, hM2⟩ :=
    wc_etale_proet_slice_data S G

  letI iEt : ∀ T : Scheme.{u}, HasExt (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
    fun T => HasExt.standard _
  haveI iEI : ∀ T : Scheme.{u},
      EnoughInjectives (Sheaf (Scheme.smallEtaleTopology T) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives
  have hν : ∀ T : Scheme.{u}, (wcEpsInv T).Additive ∧ Limits.PreservesFiniteLimits (wcEpsInv T) ∧
      Limits.PreservesFiniteColimits (wcEpsInv T) := by
    intro T
    obtain ⟨h0, h1, h2⟩ := wc_epsInv_exact T
    haveI := h0
    haveI := h1
    exact ⟨Functor.additive_of_preserves_binary_products _, h1, h2⟩
  haveI iνa : ∀ T : Scheme.{u}, (wcEpsInv T).Additive := fun T => (hν T).1
  haveI iνl : ∀ T : Scheme.{u}, Limits.PreservesFiniteLimits (wcEpsInv T) := fun T => (hν T).2.1
  haveI iνc : ∀ T : Scheme.{u}, Limits.PreservesFiniteColimits (wcEpsInv T) := fun T => (hν T).2.2
  haveI iLa : ∀ W, (L W).Additive := hLa
  haveI iLl : ∀ W, Limits.PreservesFiniteLimits (L W) := hLl
  haveI iLc : ∀ W, Limits.PreservesFiniteColimits (L W) := hLc
  haveI iRa : ∀ W, (R W).Additive := hRa
  haveI iRl : ∀ W, Limits.PreservesFiniteLimits (R W) := hRl
  haveI iRc : ∀ W, Limits.PreservesFiniteColimits (R W) := hRc

  have hA : ∀ {A B C D : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : A ⟶ B)
      (y : Abelian.Ext B C n) (g : C ⟶ D),
      (Abelian.Ext.mk₀ f).comp (y.comp (Abelian.Ext.mk₀ g) (add_zero n)) (zero_add n) =
        ((Abelian.Ext.mk₀ f).comp y (zero_add n)).comp (Abelian.Ext.mk₀ g) (add_zero n) :=
    fun f y g => (Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ f) y (Abelian.Ext.mk₀ g)
      (zero_add n) (add_zero n) (by omega)).symm
  have hB : ∀ {A B C D : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : A ⟶ B)
      (f' : B ⟶ C) (y : Abelian.Ext C D n),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ f').comp y (zero_add n)) (zero_add n) =
        (Abelian.Ext.mk₀ (f ≫ f')).comp y (zero_add n) := by
    intro A B C D f f' y
    rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ f) (Abelian.Ext.mk₀ f') y (zero_add 0)
      (zero_add n) (by omega), Abelian.Ext.mk₀_comp_mk₀]
  have hC : ∀ {A B C D : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      (y : Abelian.Ext A B n) (g : B ⟶ C) (g' : C ⟶ D),
      (y.comp (Abelian.Ext.mk₀ g) (add_zero n)).comp (Abelian.Ext.mk₀ g') (add_zero n) =
        y.comp (Abelian.Ext.mk₀ (g ≫ g')) (add_zero n) := by
    intro A B C D y g g'
    rw [Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ g) (Abelian.Ext.mk₀ g') (add_zero n)
      (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀]

  obtain ⟨d, hd⟩ : ∃ d : ∀ W : S.ProEt,
      (L W).obj ((wcEpsInv W.left).obj ((wcEtInv W.hom).obj G)) ⟶ (wcEpsInv S).obj G,
      ∀ W, d W = (L W).map (b W).hom ≫ (adj W).counit.app ((wcEpsInv S).obj G) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨θ, hθ⟩ : ∃ θ : ∀ W : S.ProEt, wcEtInvExt W.hom (wcEtUnitSheaf S) G n →+
      Abelian.Ext (wcFreeSheaf S W) ((wcEpsInv S).obj G) n,
      ∀ W e, θ W e = (Abelian.Ext.mk₀ (c W).hom).comp
        ((Abelian.Ext.mapExactFunctor (wcEpsInv W.left ⋙ L W) e).comp (Abelian.Ext.mk₀ (d W))
          (add_zero n)) (zero_add n) :=
    ⟨fun W => ((Abelian.Ext.mk₀ (c W).hom).precomp ((wcEpsInv S).obj G) (zero_add n)).comp
      (((Abelian.Ext.mk₀ (d W)).postcomp _ (add_zero n)).comp
        (Functor.mapExtAddHom (wcEpsInv W.left ⋙ L W) _ _ n)), fun W e => by
      simp only [AddMonoidHom.comp_apply, Abelian.Ext.precomp, Abelian.Ext.postcomp,
        AddMonoidHom.flip_apply, Abelian.Ext.bilinearComp_apply_apply,
        Functor.mapExtAddHom_apply]⟩
  refine ⟨θ, ?_, ?_⟩
  ·
    intro W hc hq
    haveI := hc
    haveI := hq
    have hfac : ∀ e, θ W e = (Abelian.Ext.mk₀ (c W).hom).comp ((adj W).extEquiv.symm
        ((Abelian.Ext.mapExactFunctor (wcEpsInv W.left) e).comp (Abelian.Ext.mk₀ (b W).hom)
          (add_zero n))) (zero_add n) := by
      intro e
      rw [hθ, hd, Adjunction.extEquiv_symm_apply, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_mk₀, ← Abelian.Ext.comp_mapExactFunctor, hC]
    have h1 := wc_epsInv_ext_bijective_qcqs W.left ((wcEtInv W.hom).obj (wcEtUnitSheaf S))
      ((wcEtInv W.hom).obj G) (hunit W) n
    have h2 : Function.Bijective (fun y : Abelian.Ext
        ((wcEpsInv W.left).obj ((wcEtInv W.hom).obj (wcEtUnitSheaf S)))
        ((wcEpsInv W.left).obj ((wcEtInv W.hom).obj G)) n =>
          y.comp (Abelian.Ext.mk₀ (b W).hom) (add_zero n)) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨fun z => z.comp (Abelian.Ext.mk₀ (b W).inv) (add_zero n), ?_, ?_⟩
      · intro y
        show (y.comp (Abelian.Ext.mk₀ (b W).hom) (add_zero n)).comp
          (Abelian.Ext.mk₀ (b W).inv) (add_zero n) = y
        rw [Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ (b W).hom) (Abelian.Ext.mk₀ (b W).inv)
          (add_zero n) (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
          Abelian.Ext.comp_mk₀_id]
      · intro z
        show (z.comp (Abelian.Ext.mk₀ (b W).inv) (add_zero n)).comp
          (Abelian.Ext.mk₀ (b W).hom) (add_zero n) = z
        rw [Abelian.Ext.comp_assoc z (Abelian.Ext.mk₀ (b W).inv) (Abelian.Ext.mk₀ (b W).hom)
          (add_zero n) (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
          Abelian.Ext.comp_mk₀_id]
    have h3 := ((adj W).extEquiv
      (X := (wcEpsInv W.left).obj ((wcEtInv W.hom).obj (wcEtUnitSheaf S)))
      (Y := (wcEpsInv S).obj G) (n := n)).symm.bijective
    have h4 : Function.Bijective (fun y : Abelian.Ext
        ((L W).obj ((wcEpsInv W.left).obj ((wcEtInv W.hom).obj (wcEtUnitSheaf S))))
        ((wcEpsInv S).obj G) n => (Abelian.Ext.mk₀ (c W).hom).comp y (zero_add n)) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨fun z => (Abelian.Ext.mk₀ (c W).inv).comp z (zero_add n), ?_, ?_⟩
      · intro y
        show (Abelian.Ext.mk₀ (c W).inv).comp ((Abelian.Ext.mk₀ (c W).hom).comp y (zero_add n))
          (zero_add n) = y
        rw [hB, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
      · intro z
        show (Abelian.Ext.mk₀ (c W).hom).comp ((Abelian.Ext.mk₀ (c W).inv).comp z (zero_add n))
          (zero_add n) = z
        rw [hB, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    refine ⟨fun e₁ e₂ h => ?_, fun y => ?_⟩
    · rw [hfac, hfac] at h
      exact h1.1 (h2.1 (h3.1 (h4.1 h)))
    · obtain ⟨y1, rfl⟩ := h4.2 y
      obtain ⟨y2, rfl⟩ := h3.2 y1
      obtain ⟨y3, rfl⟩ := h2.2 y2
      obtain ⟨e, rfl⟩ := h1.2 y3
      exact ⟨e, hfac e⟩
  ·
    intro W W' t _ _ _ _ e
    obtain ⟨i1, i2, i3⟩ := wc_etInv_exact t.left
    haveI := i1
    haveI := i2
    haveI := i3
    have hPull : wcEtInvExtPull t.left W.hom W'.hom (MorphismProperty.Over.w t)
        (wcEtUnitSheaf S) G n e =
        ((Abelian.Ext.mk₀ (wcEtInvCompInv t.left W.hom W'.hom (MorphismProperty.Over.w t)
          (wcEtUnitSheaf S))).comp (Abelian.Ext.mapExactFunctor (wcEtInv t.left) e)
            (zero_add n)).comp
          (Abelian.Ext.mk₀ (wcEtInvComp t.left W.hom W'.hom (MorphismProperty.Over.w t) G))
          (add_zero n) := by
      simp only [wcEtInvExtPull]
      rw [dif_pos (⟨i1, i2, i3⟩ : (wcEtInv t.left).Additive ∧
        Limits.PreservesFiniteLimits (wcEtInv t.left) ∧
        Limits.PreservesFiniteColimits (wcEtInv t.left))]
      simp only [AddMonoidHom.comp_apply, Abelian.Ext.postcomp, Abelian.Ext.precomp,
        AddMonoidHom.flip_apply, Abelian.Ext.bilinearComp_apply_apply,
        Functor.mapExtAddHom_apply]
    have e1 := wc_ext_mapExact_natTrans (wcEtInv t.left ⋙ wcEpsInv W'.left ⋙ L W')
      (wcEpsInv W.left ⋙ L W) (σ W W' t) e
    have hM1' : (c W').hom ≫ (wcEpsInv W'.left ⋙ L W').map
        (wcEtInvCompInv t.left W.hom W'.hom (MorphismProperty.Over.w t) (wcEtUnitSheaf S)) ≫
          (σ W W' t).app ((wcEtInv W.hom).obj (wcEtUnitSheaf S)) =
        wcFreeSheafMap S t ≫ (c W).hom := hM1 W W' t
    have hM2' : (wcEpsInv W'.left ⋙ L W').map
        (wcEtInvComp t.left W.hom W'.hom (MorphismProperty.Over.w t) G) ≫ d W' =
        (σ W W' t).app ((wcEtInv W.hom).obj G) ≫ d W := by
      rw [hd, hd]
      exact hM2 W W' t
    rw [hPull, hθ, hθ,
      Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, hC, hM2', ← hC, ← hA, ← e1, hB, ← hA, hB, hM1', ← hB]

theorem wc_etInvComp_inv_pair : ∀ {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y) (e : Z' ⟶ Y) (he : t ≫ g = e) (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), wcEtInvComp t g e he A ≫ wcEtInvCompInv t g e he A = 𝟙 _ ∧ wcEtInvCompInv t g e he A ≫ wcEtInvComp t g e he A = 𝟙 _ :=
by
  classical
  have hbcI : ∀ {X B : Scheme.{u}} (g : X ⟶ B), (wcEtBaseChange g).IsContinuous
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) := by
    have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
        (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
      intro Y V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
        (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
      intro X B g
      constructor
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
