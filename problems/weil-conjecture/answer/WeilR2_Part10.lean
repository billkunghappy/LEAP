theorem wc_slice_M2_of_specs (S : Scheme.{u}) (W W' : S.ProEt) (t : W' ⟶ W)
    [(wcSliceFunctor S W).IsContinuous (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)]
    [(wcSliceFunctor S W').IsContinuous (Scheme.ProEt.topology W'.left) (Scheme.ProEt.topology S)]
    (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
    (b : (wcEpsInv W.left).obj ((wcEtInv W.hom).obj G) ⟶
      ((wcSliceFunctor S W).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)).obj ((wcEpsInv S).obj G))
    (b' : (wcEpsInv W'.left).obj ((wcEtInv W'.hom).obj G) ⟶
      ((wcSliceFunctor S W').sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology W'.left) (Scheme.ProEt.topology S)).obj ((wcEpsInv S).obj G))
    (hb : wcSliceBSpec S W G b) (hb' : wcSliceBSpec S W' G b')
    (σ : wcEtInv t.left ⋙ wcEpsInv W'.left ⋙ wcSliceExt S W' ⟶ wcEpsInv W.left ⋙ wcSliceExt S W)
    (hσ : wcSliceSigmaSpec S W W' t σ) :
    (wcSliceExt S W').map ((wcEpsInv W'.left).map
        (wcEtInvComp t.left W.hom W'.hom (MorphismProperty.Over.w t) G)) ≫
      (wcSliceExt S W').map b' ≫ (wcSliceAdj S W').counit.app ((wcEpsInv S).obj G) =
    σ.app ((wcEtInv W.hom).obj G) ≫
      (wcSliceExt S W).map b ≫ (wcSliceAdj S W).counit.app ((wcEpsInv S).obj G) :=
by

  have ext5 : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (Φ : C ⥤ D)
      (K : GrothendieckTopology D)
      [∀ P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}, Φ.op.HasLeftKanExtension P]
      [HasWeakSheafify K AddCommGrpCat.{u+1}]
      (P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (Q : Dᵒᵖ ⥤ AddCommGrpCat.{u+1}) (_ : Presheaf.IsSheaf K Q)
      (θ₁ θ₂ : sheafify K (Φ.op.lan.obj P) ⟶ Q),
      Φ.op.lanUnit.app P ≫ Φ.op.whiskerLeft (toSheafify K (Φ.op.lan.obj P) ≫ θ₁) =
        Φ.op.lanUnit.app P ≫ Φ.op.whiskerLeft (toSheafify K (Φ.op.lan.obj P) ≫ θ₂) →
        θ₁ = θ₂ := by
    intro C D _ _ Φ K _ _ P Q hQ θ₁ θ₂ h
    apply sheafify_hom_ext K θ₁ θ₂ hQ
    exact Functor.hom_ext_of_isLeftKanExtension (Φ.op.lan.obj P) (Φ.op.lanUnit.app P) _ _ h

  have natG : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (Φ : C ⥤ D)
      (K : GrothendieckTopology D)
      [∀ P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}, Φ.op.HasLeftKanExtension P]
      [HasWeakSheafify K AddCommGrpCat.{u+1}]
      {P P' : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}} (φ : P ⟶ P') (c : C) (x : P.obj (Opposite.op c)),
      ((sheafifyMap K (Φ.op.lan.map φ)).app (Opposite.op (Φ.obj c))).hom
        (((toSheafify K (Φ.op.lan.obj P)).app (Opposite.op (Φ.obj c))).hom
          (((Φ.op.lanUnit.app P).app (Opposite.op c)).hom x)) =
      ((toSheafify K (Φ.op.lan.obj P')).app (Opposite.op (Φ.obj c))).hom
          (((Φ.op.lanUnit.app P').app (Opposite.op c)).hom ((φ.app (Opposite.op c)).hom x)) := by
    intro C D _ _ Φ K _ _ P P' φ c x
    have h1 := congrArg (fun α => (α.app (Opposite.op (Φ.obj c))).hom
      (((Φ.op.lanUnit.app P).app (Opposite.op c)).hom x)) (toSheafify_naturality K (Φ.op.lan.map φ))
    have h2 := congrArg (fun α => (α.app (Opposite.op c)).hom x) (Φ.op.lanUnit.naturality φ)
    simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
      Function.comp_apply] at h1 h2
