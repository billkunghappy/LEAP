      G3F u₁ u₂ _ _ _ (hPmF (τk k)) hu'
    have hv : (u₁ ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (L k))))) ≫
        Spec.map (CommRingCat.ofHom (τk k).toRingHom) =
        (u₂ ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (L k))))) ≫
        Spec.map (CommRingCat.ofHom (τk k).toRingHom) :=
      G3 u₁ u₂ _ _ _ _ (hPmS (τk k)) hu'
    have hN : ∀ y, ((γk k).toRingHom ^ (k + 1).factorial) y = y := by
      intro y; rw [hpowRH, hγN]; rfl
    have hfree : ∀ j, 0 < j → j < (k + 1).factorial → ∃ y, ((γk k).toRingHom ^ j) y ≠ y := by
      intro j hj1 hj2
