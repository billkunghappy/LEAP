  have R : ∀ {Z₀ Y₀ : Scheme.{u}} (f' : Z₀ ⟶ Y₀)
      {A B : Sheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}} (φ : A ⟶ B)
      (V : Y₀.Etale) (O : Z₀.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ f')
