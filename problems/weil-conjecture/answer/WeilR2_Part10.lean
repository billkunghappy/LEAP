    refine ⟨O, hO1, fun j => ?_⟩
    refine Eq.trans ?_ (congrArg (fun x => (O j).ι ≫ u₁ ≫ x) (hIter k j)).symm
    have hσ : Spec.map (CommRingCat.ofHom ((γk k).toRingHom ^ (j : ℕ))) =
        Spec.map (CommRingCat.ofHom ((γk k) ^ (j : ℕ)).toRingHom) := by rw [hpowRH]
    exact Limits.pullback.hom_ext (H1 (O j).ι u₁ u₂ _ _ (hPmF _) hf)
      (H2 (O j).ι u₁ u₂ _ _ _ _ (hPmS _) hσ (hO2 j))
  case C11 =>
    intro k T u j hj1 hj2 hT heq
    have h2 : u ≫ wcLfdTowPm F X ((γk k) ^ j) = u :=
      (congrArg (fun x => u ≫ x) (hIter k j)).symm.trans heq
    have h3 : (u ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (L k))))) ≫
        Spec.map (CommRingCat.ofHom ((γk k) ^ j).toRingHom) =
        u ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (L k)))) :=
      G4 u _ _ _ (hPmS _) h2
