theorem wc_et_sys_rho_calculus (S : Scheme.{u}) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (A : wcEtSys D a) (hA : wcEtSysOK A) :
    (∀ (k k' k'' : ℕ) (h₁ : k ≤ k') (h₂ : k' ≤ k'')
      (E : (D.obj (Opposite.op k)).left.Etale) (E' : (D.obj (Opposite.op k')).left.Etale)
      (E'' : (D.obj (Opposite.op k'')).left.Etale)
      (e₁ : E'.left ⟶ E.left) (he₁ : e₁ ≫ E.hom = E'.hom ≫ (D.map (homOfLE h₁).op).left)
      (e₂ : E''.left ⟶ E'.left) (he₂ : e₂ ≫ E'.hom = E''.hom ≫ (D.map (homOfLE h₂).op).left)
      (e₃ : E''.left ⟶ E.left)
      (he₃ : e₃ ≫ E.hom = E''.hom ≫ (D.map (homOfLE (h₁.trans h₂)).op).left),
      e₂ ≫ e₁ = e₃ → ∀ x : (A.F k).obj.obj (Opposite.op E),
      wcSysTau A k' k'' h₂ E' E'' e₂ he₂ (wcSysTau A k k' h₁ E E' e₁ he₁ x) =
        wcSysTau A k k'' (h₁.trans h₂) E E'' e₃ he₃ x) ∧
    (∀ (k k' : ℕ) (h : k ≤ k') (O : Uinf.left.Etale)
      (E : (D.obj (Opposite.op k)).left.Etale) (E' : (D.obj (Opposite.op k')).left.Etale)
      (e : E'.left ⟶ E.left) (he : e ≫ E.hom = E'.hom ≫ (D.map (homOfLE h).op).left)
      (π : O.left ⟶ E.left) (hπ : π ≫ E.hom = O.hom ≫ (a k).left)
      (π' : O.left ⟶ E'.left) (hπ' : π' ≫ E'.hom = O.hom ≫ (a k').left),
      π' ≫ e = π → ∀ x : (A.F k).obj.obj (Opposite.op E),
      wcSysRho A k' O E' π' hπ' (wcSysTau A k k' h E E' e he x) = wcSysRho A k O E π hπ x) ∧
    (∀ (k : ℕ) (O O' : Uinf.left.Etale) (u : O' ⟶ O)
      (E E' : (D.obj (Opposite.op k)).left.Etale) (w : E' ⟶ E)
      (π : O.left ⟶ E.left) (hπ : π ≫ E.hom = O.hom ≫ (a k).left)
      (π' : O'.left ⟶ E'.left) (hπ' : π' ≫ E'.hom = O'.hom ≫ (a k).left),
      u.left ≫ π = π' ≫ w.left → ∀ x : (A.F k).obj.obj (Opposite.op E),
      A.Finf.obj.map u.op (wcSysRho A k O E π hπ x) =
        wcSysRho A k O' E' π' hπ' ((A.F k).obj.map w.op x)) ∧
    (∀ (k k' : ℕ) (h : k ≤ k')
      (E E₁ : (D.obj (Opposite.op k)).left.Etale) (w : E₁ ⟶ E)
      (E' E₁' : (D.obj (Opposite.op k')).left.Etale) (w' : E₁' ⟶ E')
      (e : E'.left ⟶ E.left) (he : e ≫ E.hom = E'.hom ≫ (D.map (homOfLE h).op).left)
      (e₁ : E₁'.left ⟶ E₁.left) (he₁ : e₁ ≫ E₁.hom = E₁'.hom ≫ (D.map (homOfLE h).op).left),
      w'.left ≫ e = e₁ ≫ w.left → ∀ x : (A.F k).obj.obj (Opposite.op E),
      wcSysTau A k k' h E₁ E₁' e₁ he₁ ((A.F k).obj.map w.op x) =
        (A.F k').obj.map w'.op (wcSysTau A k k' h E E' e he x)) :=
by
  classical

  have NA : ∀ {Z Y : Scheme.{u}} (g : Z ⟶ Y)
      (B C : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (f : B ⟶ C) (V : Y.Etale)
      (O : Z.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g)
      (x : B.obj.obj (Opposite.op V)),
      (((wcEtInv g).map f).hom.app (Opposite.op O)).hom (wcEtInvRho g B V O h hh x) =
        wcEtInvRho g C V O h hh ((f.hom.app (Opposite.op V)).hom x) := by
    intro Z Y g B C f V O h hh x
    have e2 : (((wcEtInv g).map f).hom.app (Opposite.op O)).hom (wcEtInvRho g B V O h hh x) =
        ((toSheafify (Scheme.smallEtaleTopology Z)
            ((wcEtBaseChange g).op.lan.obj C.obj)).app (Opposite.op O)).hom
          ((((wcEtBaseChange g).op.lan.map f.hom).app (Opposite.op O)).hom
            ((((wcEtBaseChange g).op.lan.obj B.obj).map (wcEtInvLift g V O h hh).op).hom
              ((((wcEtBaseChange g).op.lanUnit.app B.obj).app (Opposite.op V)).hom x))) := by
      have e := congrArg (fun m => (m.app (Opposite.op O)).hom
        ((((wcEtBaseChange g).op.lan.obj B.obj).map (wcEtInvLift g V O h hh).op).hom
          ((((wcEtBaseChange g).op.lanUnit.app B.obj).app (Opposite.op V)).hom x)))
        (toSheafify_naturality (Scheme.smallEtaleTopology Z) ((wcEtBaseChange g).op.lan.map f.hom))
      exact e.symm
    have e3 : (((wcEtBaseChange g).op.lan.map f.hom).app (Opposite.op O)).hom
            ((((wcEtBaseChange g).op.lan.obj B.obj).map (wcEtInvLift g V O h hh).op).hom
              ((((wcEtBaseChange g).op.lanUnit.app B.obj).app (Opposite.op V)).hom x)) =
        ((((wcEtBaseChange g).op.lan.obj C.obj).map (wcEtInvLift g V O h hh).op).hom
          ((((wcEtBaseChange g).op.lan.map f.hom).app
              (Opposite.op ((wcEtBaseChange g).obj V))).hom
            ((((wcEtBaseChange g).op.lanUnit.app B.obj).app (Opposite.op V)).hom x))) :=
      congrArg (fun m => m.hom
          ((((wcEtBaseChange g).op.lanUnit.app B.obj).app (Opposite.op V)).hom x))
        (((wcEtBaseChange g).op.lan.map f.hom).naturality (wcEtInvLift g V O h hh).op)
    have e4 : ((((wcEtBaseChange g).op.lanUnit.app C.obj).app (Opposite.op V)).hom
            ((f.hom.app (Opposite.op V)).hom x)) =
        (((wcEtBaseChange g).op.lan.map f.hom).app
              (Opposite.op ((wcEtBaseChange g).obj V))).hom
            ((((wcEtBaseChange g).op.lanUnit.app B.obj).app (Opposite.op V)).hom x) :=
      congrArg (fun m => (m.app (Opposite.op V)).hom x)
        (((wcEtBaseChange g).op.lanUnit).naturality f.hom)
    refine e2.trans ?_
    refine (congrArg (fun w => ((toSheafify (Scheme.smallEtaleTopology Z)
            ((wcEtBaseChange g).op.lan.obj C.obj)).app (Opposite.op O)).hom w) e3).trans ?_
    refine (congrArg (fun w => ((toSheafify (Scheme.smallEtaleTopology Z)
            ((wcEtBaseChange g).op.lan.obj C.obj)).app (Opposite.op O)).hom
          ((((wcEtBaseChange g).op.lan.obj C.obj).map (wcEtInvLift g V O h hh).op).hom w))
        e4.symm).trans ?_
    rfl

  have hbcI : ∀ {X B : Scheme.{u}} (g : X ⟶ B), (wcEtBaseChange g).IsContinuous
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) := by
    have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
        (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
      intro Y V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
        (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
      intro X B g
      constructor
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
      apply hjs
      intro v
      obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
      refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
        Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
      have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom =
          Limits.pullback.snd W.hom g ≫ g := by
        rw [Category.assoc, MorphismProperty.Over.w a]
        exact Limits.pullback.condition
      let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
        Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
      have hmap : ((wcEtBaseChange g).map a).left = m := rfl
      have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
            Limits.pullback.snd V.hom g) ≫ g := by
        rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition,
          Category.assoc, Limits.pullback.condition, Category.assoc]
      let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
        Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
            Limits.pullback.snd V.hom g) h1
