theorem wc_proet_etale_comparison_epsInv_qcsep : ∀ (Y : Scheme.{u}) [CompactSpace Y] [IsSeparated (Limits.terminal.from Y)] (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (i : ℕ), letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _; Nonempty (Abelian.Ext (wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y))) ((wcEpsInv Y).obj G) i ≃ Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G i) :=
by
  intro Y hcY hsY G i
  haveI := hcY
  haveI := hsY

  obtain ⟨hlim, hcont⟩ := wc_etToProEt_flat_cont Y
  haveI := hlim
  haveI := hcont
  haveI hlan := wc_lan_preservesFiniteLimits (wcEtToProEt Y)
  let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
  haveI hpl : Limits.PreservesFiniteLimits (wcEpsInv Y) := by
    haveI := Functor.sheafPullbackConstruction.preservesFiniteLimits (wcEtToProEt Y)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
    exact Limits.preservesFiniteLimits_of_natIso
      (Adjunction.leftAdjointUniq (Functor.sheafAdjunctionContinuous (wcEtToProEt Y)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)) adj)
  haveI hladj : (wcEpsInv Y).IsLeftAdjoint := adj.isLeftAdjoint
  haveI hpc : Limits.PreservesFiniteColimits (wcEpsInv Y) := by
    haveI := adj.leftAdjoint_preservesColimits.{0, 0}
    exact Limits.PreservesColimitsOfSize.preservesFiniteColimits.{0, 0} _
  haveI : (wcEpsInv Y).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isLeftAdjoint _
  haveI hadd : (wcEpsInv Y).Additive := Functor.additive_of_preserves_binary_products _

  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI : EssentiallySmall.{u+1} Y.Etale := inferInstance
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall _ _
  haveI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    IsGrothendieckAbelian.enoughInjectives

  have hunit := fun G' => wc_epsInv_unit_iso Y G'
  haveI : ∀ G', IsIso (adj.unit.app G') := hunit
  haveI : IsIso adj.unit := NatIso.isIso_of_isIso_app _
  let Zet := (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
    (AddCommGrpCat.of (ULift.{u+1} ℤ))
  have ha : ∀ G' : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      Function.Bijective (fun g : Zet ⟶ G' => (wcEpsInv Y).map g) :=
    fun G' => (adj.fullyFaithfulLOfIsIsoUnit).map_bijective Zet G'

  let ψ : (wcEpsInv Y).obj Zet ≅ wcFreeSheaf Y (Scheme.ProEt.mk (𝟙 Y)) :=
    (wc_epsInv_const Y (AddCommGrpCat.of (ULift.{u+1} ℤ))).some ≪≫
      (wc_free_terminal_const Y).some.symm
  have hb : ∀ (I : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) [Injective I] (n : ℕ)
      (e : Abelian.Ext ((wcEpsInv Y).obj Zet) ((wcEpsInv Y).obj I) (n + 1)), e = 0 := by
    intro I _ n e
    have h0 : (Abelian.Ext.mk₀ ψ.inv).comp e (zero_add (n + 1)) = 0 :=
      wc_proet_globalize_vanishing Y hunit (wc_epsInv_affine_vanishing Y) I n _
    calc e = (Abelian.Ext.mk₀ (𝟙 _)).comp e (zero_add (n + 1)) := (Abelian.Ext.mk₀_id_comp e).symm
      _ = ((Abelian.Ext.mk₀ ψ.hom).comp (Abelian.Ext.mk₀ ψ.inv) (add_zero 0)).comp e
            (zero_add (n + 1)) := by rw [Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id]
      _ = (Abelian.Ext.mk₀ ψ.hom).comp ((Abelian.Ext.mk₀ ψ.inv).comp e (zero_add (n + 1)))
            (zero_add (n + 1)) :=
          Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add (n + 1)) (by omega)
      _ = 0 := by rw [h0, Abelian.Ext.comp_zero]

  have hΦ := wc_ext_transfer_exact (wcEpsInv Y) Zet ha hb G i
  let Φ := Equiv.ofBijective _ hΦ

  have pre : ∀ {A A' B : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (e : A ≅ A'),
      Nonempty (Abelian.Ext A B i ≃ Abelian.Ext A' B i) := by
    intro A A' B e
    refine ⟨{ toFun := fun y => (Abelian.Ext.mk₀ e.inv).comp y (zero_add i)
              invFun := fun y => (Abelian.Ext.mk₀ e.hom).comp y (zero_add i)
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    · simp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add i) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  obtain ⟨E1⟩ := pre (B := (wcEpsInv Y).obj G) ψ.symm
  exact ⟨E1.trans Φ.symm⟩

theorem wc_xbar_open_zmod_top_vanish (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (VU : (wcXbar F X).ProEt) (hVUo : IsOpenImmersion VU.hom) (hne : Set.range VU.hom ≠ Set.univ)
    (m : ℕ) (x : Abelian.Ext (wcFreeSheaf (wcXbar F X) VU) (wcZModSheaf (wcXbar F X) (ℓ ^ m)) (2 * d)) :
    x = 0 :=
by
  classical

  have hdev : ∀ (Y : Scheme.{u}) (p i : ℕ), p ≠ 0 → Subsingleton (wcEtCoh Y p i) →
      ∀ k : ℕ, Subsingleton (wcEtCoh Y (p ^ k) i) := by
    intro Y p i hp hsp
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
    have hsub : ∀ (X₀ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (S : ShortComplex (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})), S.ShortExact →
        ∀ m : ℕ, Subsingleton (Abelian.Ext X₀ S.X₁ m) → Subsingleton (Abelian.Ext X₀ S.X₃ m) →
          Subsingleton (Abelian.Ext X₀ S.X₂ m) := by
      intro X₀ S hS m h1 h3
      have hz : ∀ y : Abelian.Ext X₀ S.X₂ m, y = 0 := by
        intro y
        obtain ⟨y₁, hy₁⟩ := Abelian.Ext.covariant_sequence_exact₂ X₀ hS y (Subsingleton.elim _ _)
        rw [← hy₁, Subsingleton.elim y₁ 0, Abelian.Ext.zero_comp]
      exact ⟨fun a b => by rw [hz a, hz b]⟩
    have hzero : ∀ (X₀ Z : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
        Limits.IsZero Z → ∀ m, Subsingleton (Abelian.Ext X₀ Z m) := by
      intro X₀ Z hZ m
      have hx : ∀ x : Abelian.Ext X₀ Z m, x = 0 := by
        intro x
        have := Abelian.Ext.comp_mk₀_id x
        rw [hZ.eq_of_tgt (𝟙 _) 0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at this
        exact this.symm
      exact ⟨fun x y => by rw [hx x, hx y]⟩
    have hses : ∀ (p k : ℕ), p ≠ 0 →
        ∃ (f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))))
          (g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)))
          (hw : f ≫ g = 0), (ShortComplex.mk f g hw).ShortExact := by
      intro p k hp
      have hk0 : (zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k))) (k : ℤ) = 0 := by
        rw [zmultiplesHom_apply, zsmul_eq_mul, Int.cast_natCast, ← Nat.cast_mul, mul_comm,
          ZMod.natCast_self]
      let α : ZMod k →+ ZMod (p * k) :=
        ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩
      have hα : ∀ z : ℤ, α (z : ZMod k) = ((z * p : ℤ) : ZMod (p * k)) := by
        intro z
        show (ZMod.lift k ⟨zmultiplesHom (ZMod (p * k)) (p : ZMod (p * k)), hk0⟩) (z : ZMod k) = _
        rw [ZMod.lift_coe]
        change z • (p : ZMod (p * k)) = _
        rw [zsmul_eq_mul]
        push_cast
        ring
      let β : ZMod (p * k) →+ ZMod p := (ZMod.castHom (dvd_mul_right p k) (ZMod p)).toAddMonoidHom
      have hβ : ∀ z : ℤ, β (z : ZMod (p * k)) = (z : ZMod p) := fun z =>
        map_intCast (ZMod.castHom (dvd_mul_right p k) (ZMod p)) z
      have hαinj : Function.Injective α := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, ZMod.intCast_zmod_eq_zero_iff_dvd] at hx
        rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
        have hp' : (p : ℤ) ≠ 0 := by exact_mod_cast hp
        push_cast at hx
        rw [mul_comm z] at hx
        exact (mul_dvd_mul_iff_left hp').mp hx
      have hβsurj : Function.Surjective β := by
        intro y
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        exact ⟨(z : ZMod (p * k)), hβ z⟩
      have hβα : ∀ x, β (α x) = 0 := by
        intro x
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective x
        rw [hα, hβ]
        push_cast
        rw [ZMod.natCast_self, mul_zero]
      have hker : ∀ y, β y = 0 → ∃ x, α x = y := by
        intro y hy
        obtain ⟨z, rfl⟩ := ZMod.intCast_surjective y
        rw [hβ, ZMod.intCast_zmod_eq_zero_iff_dvd] at hy
        obtain ⟨t, rfl⟩ := hy
        refine ⟨(t : ZMod k), ?_⟩
        rw [hα]
        congr 1
        ring
      let f : AddCommGrpCat.of (ULift.{u+1} (ZMod k)) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp α).comp
          AddEquiv.ulift.toAddMonoidHom)
      let g : AddCommGrpCat.of (ULift.{u+1} (ZMod (p * k))) ⟶ AddCommGrpCat.of (ULift.{u+1} (ZMod p)) :=
        AddCommGrpCat.ofHom ((AddEquiv.ulift.symm.toAddMonoidHom.comp β).comp
          AddEquiv.ulift.toAddMonoidHom)
      have hw : f ≫ g = 0 := by
        ext x
        exact hβα x.down
      refine ⟨f, g, hw, ShortComplex.ShortExact.mk' ?_ ?_ ?_⟩
      · rw [ShortComplex.ab_exact_iff]
        intro x₂ hx₂
        obtain ⟨x₁, hx₁⟩ := hker x₂.down (congrArg ULift.down hx₂)
        exact ⟨ULift.up x₁, congrArg ULift.up hx₁⟩
      · rw [AddCommGrpCat.mono_iff_injective]
        intro a b hab
        exact ULift.ext _ _ (hαinj (congrArg ULift.down hab))
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro y
        obtain ⟨x, hx⟩ := hβsurj y.down
        exact ⟨ULift.up x, congrArg ULift.up hx⟩
    haveI : Limits.PreservesFiniteLimits
        (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
      Limits.comp_preservesFiniteLimits (Functor.const (Scheme.Etale Y)ᵒᵖ)
        (presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    intro k
    induction k with
    | zero =>
      rw [pow_zero]
      exact hzero _ _ (Functor.map_isZero _ (AddCommGrpCat.isZero_of_subsingleton _)) i
    | succ k ih =>
      obtain ⟨f, g, hw, hS₀⟩ := hses p (p ^ k) hp
      have hS := hS₀.map_of_exact (constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      rw [pow_succ']
      exact hsub ((constantSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ))) _ hS i ih hsp

  haveI hprop : IsProper (wcPi2 F X) := inferInstance
  haveI hsm : SmoothOfRelativeDimension d (wcPi2 F X) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
      (IsPullback.of_hasPullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) inferInstance
  haveI hirr : IrreducibleSpace (wcXbar F X) :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom)
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
      (Limits.pullback.fst _ _) (Limits.pullback.snd _ _) (IsPullback.of_hasPullback _ _)
  have hneℓ : ((ℓ : ℕ) : AlgebraicClosure F) ≠ 0 := by
    intro h0
    have hp : ringChar F ∣ ℓ := (CharP.cast_eq_zero_iff (AlgebraicClosure F) (ringChar F) ℓ).mp h0
    have hpp : Nat.Prime (ringChar F) := CharP.char_is_prime F (ringChar F)
    have hpl : ringChar F = ℓ := (Nat.prime_dvd_prime_iff_eq hpp (Fact.out)).mp hp
    letI := Fintype.ofFinite F
    have hc : ((Nat.card F : ℕ) : F) = 0 := by
      rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero F
    have hdvd : ringChar F ∣ Nat.card F := (ringChar.spec F _).mp hc
    exact hℓ (hpl ▸ hdvd)
  haveI : IsLocallyNoetherian (wcXbar F X) := LocallyOfFiniteType.isLocallyNoetherian (wcPi2 F X)
  haveI : CompactSpace (wcXbar F X) := QuasiCompact.compactSpace_of_compactSpace (wcPi2 F X)
  haveI := hVUo
  haveI : CompactSpace VU.left := by
    have hqc : QuasiCompact (VU.hom : VU.left ⟶ wcXbar F X) :=
      @instQuasiCompactOfIsLocallyNoetherianOfIsOpenImmersion (wcXbar F X) VU.left _ VU.hom hVUo
    exact @QuasiCompact.compactSpace_of_compactSpace VU.left (wcXbar F X) VU.hom hqc _
  haveI : IsSeparated (Limits.terminal.from VU.left) := by
    have e : Limits.terminal.from VU.left =
        VU.hom ≫ wcPi2 F X ≫ Limits.terminal.from (Spec (.of (AlgebraicClosure F))) :=
      Limits.terminal.hom_ext _ _
    rw [e]; infer_instance

  obtain ⟨E₁⟩ := wc_ext_free_slice_zmod (wcXbar F X) VU (ℓ ^ m) (2 * d)

  obtain ⟨-, hcont⟩ := wc_etToProEt_flat_cont VU.left
  haveI := hcont
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology VU.left) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨E₀⟩ := wc_proet_etale_comparison_epsInv_qcsep VU.left
    ((constantSheaf (Scheme.smallEtaleTopology VU.left) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) (2 * d)
  let χ : (wcEpsInv VU.left).obj ((constantSheaf (Scheme.smallEtaleTopology VU.left)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))) ≅
      wcZModSheaf VU.left (ℓ ^ m) :=
    (wc_epsInv_const VU.left (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ m))))).some ≪≫
      (wc_zmod_sheaf_const VU.left (ℓ ^ m)).some.symm
  have post : ∀ {A B B' : Sheaf (Scheme.ProEt.topology VU.left) AddCommGrpCat.{u+1}} (e : B ≅ B'),
      Nonempty (Abelian.Ext A B (2 * d) ≃ Abelian.Ext A B' (2 * d)) := by
    intro A B B' e
    refine ⟨{ toFun := fun y => y.comp (Abelian.Ext.mk₀ e.hom) (add_zero (2 * d))
              invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero (2 * d))
              left_inv := fun y => ?_
              right_inv := fun y => ?_ }⟩
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (2 * d)) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · simp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (2 * d)) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  obtain ⟨E₂⟩ := post (A := wcFreeSheaf VU.left (Scheme.ProEt.mk (𝟙 VU.left))) χ.symm

  have h1 := wc_et_open_top_vanishing (AlgebraicClosure F) (wcXbar F X) (wcPi2 F X) d
    VU.left VU.hom hne ℓ (Fact.out) hneℓ
  haveI hn := hdev VU.left ℓ (2 * d) (Fact.out : ℓ.Prime).ne_zero h1 m

  let E : Abelian.Ext (wcFreeSheaf (wcXbar F X) VU) (wcZModSheaf (wcXbar F X) (ℓ ^ m)) (2 * d) ≃
      wcEtCoh VU.left (ℓ ^ m) (2 * d) := E₁.trans (E₂.trans E₀)
  apply E.injective
  exact Subsingleton.elim _ _

theorem wc_xbar_int_supp_kernel_sections (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [IsProper X.hom] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (x₀ : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X) (hx₀ : x₀ ≫ wcPi2 F X = 𝟙 _)
    (Dx : wcHMPullData x₀ ℓ) (hDx : wcHMPullCanonical Dx)
    (V : (wcXbar F X).ProEt) (f : (wcIntUnit (wcXbar F X) ℓ).val.obj (Opposite.op V)) :
    (∃ k, ((Limits.kernel.ι (wcIntSuppπ Dx)).val.app (Opposite.op V)).hom k = f) ↔
      ∀ z : V.left, V.hom z = x₀ (IsLocalRing.closedPoint (AlgebraicClosure F)) →
        (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f) z = 0 :=
by
  classical

  have s1 : ∀ {M N : SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ)} (g : M ⟶ N)
      (W : ((wcXbar F X).ProEt)ᵒᵖ) (s : M.val.obj W),
      (∃ k, ((Limits.kernel.ι (Limits.factorThruImage g)).val.app W).hom k = s) ↔
        (g.val.app W).hom s = 0 := by
    intro M N g W s
    let G : SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ) ⥤
        ModuleCat.{u+1} ((wcIntRingSheaf (wcXbar F X) ℓ).obj.obj W) :=
      SheafOfModules.forget _ ⋙ PresheafOfModules.evaluation _ W
    constructor
    · rintro ⟨k, rfl⟩
      have e : Limits.kernel.ι (Limits.factorThruImage g) ≫ g = 0 :=
        (congrArg (fun h => Limits.kernel.ι (Limits.factorThruImage g) ≫ h)
          (Limits.image.fac g)).symm.trans
          ((Limits.kernel.condition_assoc _ _).trans Limits.zero_comp)
      have e2 : G.map (Limits.kernel.ι (Limits.factorThruImage g)) ≫ G.map g = 0 := by
        rw [← G.map_comp, e, G.map_zero]
      have e3 := congrArg (fun h => h.hom k) e2
      simp only [ModuleCat.hom_comp, ModuleCat.hom_zero] at e3
      exact e3
    · intro hs
      have : Mono (G.map (Limits.image.ι g)) := Functor.map_mono G _
      have hinj := (ModuleCat.mono_iff_injective (G.map (Limits.image.ι g))).mp this
      have hfac : G.map (Limits.factorThruImage g) ≫ G.map (Limits.image.ι g) = G.map g := by
        rw [← G.map_comp, Limits.image.fac]
      have hπ : (G.map (Limits.factorThruImage g)).hom s = 0 := by
        apply hinj
        have h2 := congrArg (fun h => h.hom s) hfac
        simp only [ModuleCat.hom_comp] at h2
        refine h2.trans (hs.trans ?_)
        exact (map_zero _).symm
      let k' : ModuleCat.of ((wcIntRingSheaf (wcXbar F X) ℓ).obj.obj W)
          ((wcIntRingSheaf (wcXbar F X) ℓ).obj.obj W) ⟶ G.obj M :=
        ModuleCat.ofHom (LinearMap.toSpanSingleton _ _ s)
      have hk1 : k'.hom 1 = s := one_smul _ s
      have hk' : k' ≫ G.map (Limits.factorThruImage g) = 0 := by
        apply ModuleCat.hom_ext
        apply LinearMap.ext_ring
        show (G.map (Limits.factorThruImage g)).hom (k'.hom 1) = 0
        rw [hk1]
        exact hπ
      let hl := Limits.KernelFork.IsLimit.lift'
        (Limits.KernelFork.mapIsLimit _ (Limits.kernelIsKernel (Limits.factorThruImage g)) G) k' hk'
      refine ⟨hl.1.hom 1, ?_⟩
      have h3 := congrArg (fun h => h.hom (1 : (wcIntRingSheaf (wcXbar F X) ℓ).obj.obj W)) hl.2
      exact h3.trans hk1

  have s3 : ∀ (g : V.left ⟶ wcXbar F X) (φ : C(↥V.left, ULift.{u+1} ℤ_[ℓ]))
      (w : C(↥(Spec (.of (AlgebraicClosure F))), ULift.{u+1} ℚ_[ℓ])), IsUnit w →
      ((∀ p : ↥(Limits.pullback g x₀),
        ULift.up (((φ (Limits.pullback.fst g x₀ p)).down : ℤ_[ℓ]) : ℚ_[ℓ]) *
          w (Limits.pullback.snd g x₀ p) = 0) ↔
      ∀ z : ↥V.left, g z = x₀ (IsLocalRing.closedPoint (AlgebraicClosure F)) → φ z = 0) := by
    intro g φ w hw
    obtain ⟨v, hv⟩ := hw.exists_right_inv
    have hne : ∀ q, w q ≠ 0 := by
      intro q h0
      have h1 := congrArg (fun G : C(↥(Spec (.of (AlgebraicClosure F))), ULift.{u+1} ℚ_[ℓ]) => G q) hv
      simp only [ContinuousMap.mul_apply, ContinuousMap.one_apply, h0, zero_mul] at h1
      exact zero_ne_one h1
    have hred : ∀ (a : ℤ_[ℓ]) (b : ULift.{u+1} ℚ_[ℓ]), b ≠ 0 →
        (ULift.up (a : ℚ_[ℓ]) * b = 0 ↔ ULift.up a = (0 : ULift.{u+1} ℤ_[ℓ])) := by
      intro a b hb
      rw [mul_eq_zero, or_iff_left hb]
      constructor
      · intro h
        exact ULift.ext _ _ (PadicInt.coe_eq_zero.mp (congrArg ULift.down h))
      · intro h
        have h' : a = 0 := congrArg ULift.down h
        rw [h']
        rfl
    constructor
    · intro H z hz
      have hz' : z ∈ Set.range (Limits.pullback.fst g x₀) := by
        rw [Scheme.Pullback.range_fst]
        exact ⟨_, hz.symm⟩
      obtain ⟨p, rfl⟩ := hz'
      exact (hred _ _ (hne _)).mp (H p)
    · intro H p
      have hp : g (Limits.pullback.fst g x₀ p) =
          x₀ (IsLocalRing.closedPoint (AlgebraicClosure F)) := by
        rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply,
          Subsingleton.elim (Limits.pullback.snd g x₀ p) (IsLocalRing.closedPoint (AlgebraicClosure F))]
      exact (hred _ _ (hne _)).mpr (H _ hp)

  have hsec : ∀ {A B : Scheme.{u}} {i : A ⟶ B} (D : wcHMPullData i ℓ),
      ∃ u : C(↥A, ULift.{u+1} ℚ_[ℓ]), IsUnit u ∧ ∀ W : B.ProEt,
        ((SheafOfModules.unitHomEquiv _ (wcSuppUnitMap D)).1 (Opposite.op W) :
            C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) =
          u.comp (Limits.pullback.snd W.hom i).base.hom := by
    intro A B i D
    haveI := D.cont
    let T : B.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 B) (inferInstance : WeaklyEtale (𝟙 B))
    let σ := SheafOfModules.unitHomEquiv (wcSuppObj D) (wcSuppUnitMap D)
    let v : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ]) := σ.1 (Opposite.op T)
    let u : C(↥A, ULift.{u+1} ℚ_[ℓ]) := v.comp (inv (Limits.pullback.snd (𝟙 B) i)).base.hom
    have hfac : ∀ W : B.ProEt,
        (σ.1 (Opposite.op W) : C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) =
          u.comp (Limits.pullback.snd W.hom i).base.hom := by
      intro W
      let τ : W ⟶ T := MorphismProperty.Over.homMk (B := T) W.hom (Category.comp_id _) trivial
      have h1 : (v.comp ((wcProEtBC i).map τ).left.base.hom :
          C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) =
          (σ.1 (Opposite.op W) : C(↥(Limits.pullback W.hom i), ULift.{u+1} ℚ_[ℓ])) :=
        PresheafOfModules.sections_property σ τ.op
      have hw : ((wcProEtBC i).map τ).left ≫ Limits.pullback.snd (𝟙 B) i =
          Limits.pullback.snd W.hom i :=
        MorphismProperty.Over.w ((wcProEtBC i).map τ)
      have key : ((wcProEtBC i).map τ).left =
          Limits.pullback.snd W.hom i ≫ inv (Limits.pullback.snd (𝟙 B) i) :=
        (IsIso.eq_comp_inv (Limits.pullback.snd (𝟙 B) i)).mpr hw
      refine h1.symm.trans ?_
      apply ContinuousMap.ext
      intro p
      exact congrArg (fun f : Limits.pullback W.hom i ⟶ Limits.pullback (𝟙 B) i => v (f.base p)) key
    let ones : (wcSuppObj D).val.sections :=
      PresheafOfModules.sectionsMk (M := (wcSuppObj D).val)
        (fun W => (1 : C(↥(Limits.pullback W.unop.hom i), ULift.{u+1} ℚ_[ℓ])))
        (fun _ _ _ => rfl)
    let ρ₁ : SheafOfModules.unit (wcRingSheaf B ℓ) ⟶
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).obj
          (SheafOfModules.unit (wcRingSheaf A ℓ)) :=
      (SheafOfModules.unitHomEquiv (wcSuppObj D)).symm ones
    let c : SheafOfModules.unit (wcRingSheaf A ℓ) ⟶ SheafOfModules.unit (wcRingSheaf A ℓ) :=
      D.μ.inv ≫ (D.adj.homEquiv _ _).symm ρ₁
    have h2 : wcSuppUnitMap D = D.adj.homEquiv _ _ D.μ.hom :=
      (D.adj.homEquiv_unit _ _ _).symm
    have hc : wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map c = ρ₁ := by
      rw [h2]
      refine (D.adj.homEquiv_naturality_right D.μ.hom c).symm.trans ?_
      have e3 : D.μ.hom ≫ c = (D.adj.homEquiv _ _).symm ρ₁ := Iso.hom_inv_id_assoc _ _
      rw [e3, Equiv.apply_symm_apply]
    let W : A.ProEt := (wcProEtBC i).obj T
    let h : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ]) :=
      (c.val.app (Opposite.op W)).hom (1 : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ]))
    have eR : (SheafOfModules.unitHomEquiv (wcSuppObj D) ρ₁).1 (Opposite.op T) =
        (1 : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ])) := by
      show (SheafOfModules.unitHomEquiv (wcSuppObj D)
        ((SheafOfModules.unitHomEquiv (wcSuppObj D)).symm ones)).1 (Opposite.op T) = _
      rw [Equiv.apply_symm_apply]
      rfl
    have eL : (SheafOfModules.unitHomEquiv (wcSuppObj D) (wcSuppUnitMap D ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).map c)).1
          (Opposite.op T) = (c.val.app (Opposite.op W)).hom v := rfl
    have eLin : (c.val.app (Opposite.op W)).hom v = v * h := by
      have hs := (c.val.app (Opposite.op W)).hom.map_smul
        (v : (wcRingSheaf A ℓ).obj.obj (Opposite.op W))
        (1 : C(↥(Limits.pullback (𝟙 B) i), ULift.{u+1} ℚ_[ℓ]))
      exact (congrArg (fun x => (c.val.app (Opposite.op W)).hom x) (mul_one v).symm).trans hs
    have hvh : v * h = 1 :=
      eLin.symm.trans (eL.symm.trans ((congrArg
        (fun f => (SheafOfModules.unitHomEquiv (wcSuppObj D) f).1 (Opposite.op T)) hc).trans eR))
    refine ⟨u, ?_, hfac⟩
    refine isUnit_iff_exists_inv.mpr
      ⟨h.comp (inv (Limits.pullback.snd (𝟙 B) i)).base.hom, ?_⟩
    show v.comp (inv (Limits.pullback.snd (𝟙 B) i)).base.hom *
      h.comp (inv (Limits.pullback.snd (𝟙 B) i)).base.hom = 1
    rw [← ContinuousMap.mul_comp, hvh, ContinuousMap.one_comp]

  obtain ⟨uu, huu, hsecV⟩ := hsec Dx
  let Φ := ((wcSuppUnitMap Dx).val.app (Opposite.op V)).hom
  have hΦ1 : (show C(↥(Limits.pullback V.hom x₀), ULift.{u+1} ℚ_[ℓ]) from
      Φ (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))) =
      uu.comp (Limits.pullback.snd V.hom x₀).base.hom :=
    (SheafOfModules.unitHomEquiv_apply_coe _ _ _).symm.trans (hsecV V)
  have hΦ : ∀ w : C(↥V.left, ULift.{u+1} ℚ_[ℓ]),
      (show C(↥(Limits.pullback V.hom x₀), ULift.{u+1} ℚ_[ℓ]) from Φ w) =
        w.comp (Limits.pullback.fst V.hom x₀).base.hom *
          uu.comp (Limits.pullback.snd V.hom x₀).base.hom := by
    intro w
    have hs := Φ.map_smul (w : (wcRingSheaf (wcXbar F X) ℓ).obj.obj (Opposite.op V))
      (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    have e1 := (congrArg Φ (mul_one w).symm).trans hs
    refine e1.trans ?_
    show (show C(↥(Limits.pullback V.hom x₀), ULift.{u+1} ℚ_[ℓ]) from
        (Dx.φ.hom.app (Opposite.op V)).hom w) *
      (show C(↥(Limits.pullback V.hom x₀), ULift.{u+1} ℚ_[ℓ]) from
        Φ (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))) = _
    rw [hDx V w, hΦ1]
  let ψ := ((wcUnitRestrict (wcIntRatRingSheafMap (wcXbar F X) ℓ)).val.app (Opposite.op V)).hom
  have hψ1 : (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from
      ψ (1 : C(↥V.left, ULift.{u+1} ℤ_[ℓ]))) = 1 := by
    have e : (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from (SheafOfModules.unitHomEquiv _
        (wcUnitRestrict (wcIntRatRingSheafMap (wcXbar F X) ℓ))).1 (Opposite.op V)) = 1 := by
      unfold wcUnitRestrict
      rw [Equiv.apply_symm_apply]
      rfl
    exact (SheafOfModules.unitHomEquiv_apply_coe _ _ _).symm.trans e
  have hψ : (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from ψ f) =
      ((wcIntRatRingSheafMap (wcXbar F X) ℓ).hom.app (Opposite.op V)).hom f := by
    have hs := ψ.map_smul (f : (wcIntRingSheaf (wcXbar F X) ℓ).obj.obj (Opposite.op V))
      (1 : C(↥V.left, ULift.{u+1} ℤ_[ℓ]))
    have e1 := (congrArg ψ (mul_one (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f)).symm).trans hs
    refine e1.trans ?_
    show (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from
        ((wcIntRatRingSheafMap (wcXbar F X) ℓ).hom.app (Opposite.op V)).hom f) *
      (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from ψ (1 : C(↥V.left, ULift.{u+1} ℤ_[ℓ]))) = _
    rw [hψ1, mul_one]
  have hgval : ∀ p : ↥(Limits.pullback V.hom x₀),
      (show C(↥(Limits.pullback V.hom x₀), ULift.{u+1} ℚ_[ℓ]) from
        ((wcIntSuppMap Dx).val.app (Opposite.op V)).hom f) p =
      ULift.up ((((show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f)
          (Limits.pullback.fst V.hom x₀ p)).down : ℤ_[ℓ]) : ℚ_[ℓ]) *
        uu (Limits.pullback.snd V.hom x₀ p) := by
    intro p
    have e : (show C(↥(Limits.pullback V.hom x₀), ULift.{u+1} ℚ_[ℓ]) from
        ((wcIntSuppMap Dx).val.app (Opposite.op V)).hom f) =
        (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from
          ((wcIntRatRingSheafMap (wcXbar F X) ℓ).hom.app (Opposite.op V)).hom f).comp
            (Limits.pullback.fst V.hom x₀).base.hom *
          uu.comp (Limits.pullback.snd V.hom x₀).base.hom := by
      refine (hΦ (show C(↥V.left, ULift.{u+1} ℚ_[ℓ]) from ψ f)).trans ?_
      rw [hψ]
    rw [e]
    rfl
  have hzero : ((wcIntSuppMap Dx).val.app (Opposite.op V)).hom f = 0 ↔
      ∀ p : ↥(Limits.pullback V.hom x₀),
        ULift.up ((((show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f)
            (Limits.pullback.fst V.hom x₀ p)).down : ℤ_[ℓ]) : ℚ_[ℓ]) *
          uu (Limits.pullback.snd V.hom x₀ p) = 0 := by
    show (show C(↥(Limits.pullback V.hom x₀), ULift.{u+1} ℚ_[ℓ]) from
        ((wcIntSuppMap Dx).val.app (Opposite.op V)).hom f) = 0 ↔ _
    rw [ContinuousMap.ext_iff]
    simp only [ContinuousMap.zero_apply, hgval]
  exact ((s1 (wcIntSuppMap Dx) (Opposite.op V) f).trans hzero).trans
    (s3 V.hom (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f) uu huu)

theorem wc_int_open_free_ideal_data (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (VU : S.ProEt) (hVUo : IsOpenImmersion VU.hom)
    (L : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⥤
      SheafOfModules.{u+1} (wcIntRingSheaf S ℓ))
    (adj : L ⊣ SheafOfModules.toSheaf (wcIntRingSheaf S ℓ))
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] :
    ∃ (ιJ : L.obj (wcFreeSheaf S VU) ⟶ wcIntUnit S ℓ)
      (s : (L.obj (wcFreeSheaf S VU)).val.obj (Opposite.op VU)),
      Mono ιJ ∧ (∀ k : ℕ, Mono ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel ιJ))) ∧
      (∀ (M : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) (ψ ψ' : L.obj (wcFreeSheaf S VU) ⟶ M),
        (ψ.val.app (Opposite.op VU)).hom s = (ψ'.val.app (Opposite.op VU)).hom s → ψ = ψ') ∧
      (∀ (W : S.ProEt) (a : W ⟶ VU) (f : (wcIntUnit S ℓ).val.obj (Opposite.op W)),
        ∃ t : (L.obj (wcFreeSheaf S VU)).val.obj (Opposite.op W),
          (ιJ.val.app (Opposite.op W)).hom t = f) :=
by
  classical


  have gen : ∀ {C : Type (u+1)} [Category.{u} C]
      (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R : Sheaf J RingCat.{u+1}) (T : C), Limits.IsTerminal T →
      ∃ ε : (presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
          (SheafOfModules.toSheaf.{u+1} R).obj (SheafOfModules.unit R),
        (∀ M : SheafOfModules.{u+1} R,
          Function.Bijective (fun f : SheafOfModules.unit R ⟶ M =>
            ε ≫ (SheafOfModules.toSheaf.{u+1} R).map f)) ∧
        ∀ (X : Cᵒᵖ) (x : ULift.{u+1} (X.unop ⟶ T)),
          (ε.hom.app X).hom (((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙
            AddCommGrpCat.free)).app X).hom (FreeAbelianGroup.of x)) =
            (show ((SheafOfModules.toSheaf.{u+1} R).obj (SheafOfModules.unit R)).obj.obj X from
              (1 : R.obj.obj X)) := by
    intro C _ J _ _ R T hT
    set P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free with hP
    let e : ∀ X : Cᵒᵖ, P.obj X := fun X => FreeAbelianGroup.of (ULift.up (hT.from X.unop))
    have hgen : ∀ (X : Cᵒᵖ) (x : ULift.{u+1} (X.unop ⟶ T)), x = ULift.up (hT.from X.unop) :=
      fun X x => ULift.ext _ _ (hT.hom_ext _ _)
    have hPmap : ∀ ⦃X Y : Cᵒᵖ⦄ (f : X ⟶ Y), P.map f (e X) = e Y := by
      intro X Y f
      exact (FreeAbelianGroup.map_of_apply _).trans (congrArg FreeAbelianGroup.of (hgen Y _))
    have huniq : ∀ (G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (φ ψ : P ⟶ G),
        (∀ X : Cᵒᵖ, φ.app X (e X) = ψ.app X (e X)) → φ = ψ := by
      intro G φ ψ h
      apply NatTrans.ext
      funext X
      apply AddCommGrpCat.hom_ext
      apply FreeAbelianGroup.lift_ext
      intro x
      rw [hgen X x]
      exact h X
    let G0 : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      (PresheafOfModules.toPresheaf R.obj).obj (PresheafOfModules.unit R.obj)
    let η : P ⟶ G0 :=
      { app := fun X => AddCommGrpCat.ofHom
          (FreeAbelianGroup.lift (β := G0.obj X) (fun _ => show G0.obj X from (1 : R.obj.obj X)))
        naturality := by
          intro X Y f
          apply AddCommGrpCat.hom_ext
          apply FreeAbelianGroup.lift_ext
          intro x
          show FreeAbelianGroup.lift _ (FreeAbelianGroup.map _ (FreeAbelianGroup.of x)) =
            (G0.map f).hom (FreeAbelianGroup.lift _ (FreeAbelianGroup.of x))
          rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
            FreeAbelianGroup.lift_apply_of]
          exact ((PresheafOfModules.presheaf_map_apply_coe (PresheafOfModules.unit R.obj) f _).trans
            (PresheafOfModules.unit_map_one R.obj f)).symm }
    have hη : ∀ X : Cᵒᵖ, η.app X (e X) = (1 : R.obj.obj X) := by
      intro X
      exact FreeAbelianGroup.lift_apply_of _ _
    let adj := sheafificationAdjunction J AddCommGrpCat.{u+1}
    obtain ⟨ε, hε⟩ : ∃ ε : (presheafToSheaf J AddCommGrpCat.{u+1}).obj P ⟶
        (SheafOfModules.toSheaf.{u+1} R).obj (SheafOfModules.unit R),
        adj.homEquiv _ _ ε = η := ⟨(adj.homEquiv _ _).symm η, Equiv.apply_symm_apply _ _⟩
    have hu : adj.unit.app P = toSheafify J P := sheafificationAdjunction_unit_app J P
    have hval : ∀ (X : Cᵒᵖ) (x : ULift.{u+1} (X.unop ⟶ T)),
        (ε.hom.app X).hom (((toSheafify J P).app X).hom (FreeAbelianGroup.of x)) =
          (η.app X).hom (FreeAbelianGroup.of x) := by
      intro X x
      have h := congrArg (fun φ => (φ.app X).hom (FreeAbelianGroup.of x)) hε
      simp only [Adjunction.homEquiv_unit, hu] at h
      exact h
    refine ⟨ε, fun M => ?_, fun X x => (hval X x).trans (FreeAbelianGroup.lift_apply_of _ _)⟩
    have key : ∀ f : SheafOfModules.unit R ⟶ M,
        adj.homEquiv P _ (ε ≫ (SheafOfModules.toSheaf R).map f) =
          η ≫ (PresheafOfModules.toPresheaf R.obj).map f.val := by
      intro f
      rw [Adjunction.homEquiv_naturality_right, hε]
      rfl
    have hev : ∀ (f : SheafOfModules.unit R ⟶ M) (X : Cᵒᵖ),
        (η ≫ (PresheafOfModules.toPresheaf R.obj).map f.val).app X (e X) =
          (M.unitHomEquiv f).val X := by
      intro f X
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      show ((PresheafOfModules.toPresheaf R.obj).map f.val).app X (η.app X (e X)) = _
      rw [hη X]
      rfl
    constructor
    · intro f f' hff
      have h1 := congrArg (adj.homEquiv P _) hff
      simp only [key] at h1
      have h2 : M.unitHomEquiv f = M.unitHomEquiv f' := by
        apply Subtype.ext
        funext X
        exact (hev f X).symm.trans
          ((congrArg (fun φ => AddCommGrpCat.Hom.hom (φ.app X) (e X)) h1).trans (hev f' X))
      exact M.unitHomEquiv.injective h2
    · intro θ
      let ψ := adj.homEquiv P _ θ
      let s : ∀ X : Cᵒᵖ, M.val.obj X := fun X => ψ.app X (e X)
      have hs : ∀ ⦃X Y : Cᵒᵖ⦄ (f : X ⟶ Y), M.val.map f (s X) = s Y := by
        intro X Y f
        have h := congrArg (fun g => AddCommGrpCat.Hom.hom g (e X)) (ψ.naturality f)
        exact (PresheafOfModules.presheaf_map_apply_coe M.val f (s X)).symm.trans
          (h.symm.trans (congrArg (fun z => AddCommGrpCat.Hom.hom (ψ.app Y) z) (hPmap f)))
      refine ⟨M.unitHomEquiv.symm (PresheafOfModules.sectionsMk s hs), ?_⟩
      apply (adj.homEquiv P _).injective
      show adj.homEquiv P _ (ε ≫ _) = ψ
      rw [key]
      apply huniq
      intro X
      refine (hev _ X).trans ?_
      rw [Equiv.apply_symm_apply, PresheafOfModules.sectionsMk_coe]
      rfl

  let T : S.ProEt := Scheme.ProEt.mk (𝟙 S)
  have huniqT : ∀ (V : S.ProEt) (f g : V ⟶ T), f = g := by
    intro V f g
    apply MorphismProperty.Over.Hom.ext
    have hf : f.left ≫ 𝟙 S = V.hom := MorphismProperty.Over.w f
    have hg : g.left ≫ 𝟙 S = V.hom := MorphismProperty.Over.w g
    exact (Category.comp_id f.left).symm.trans (hf.trans (hg.symm.trans (Category.comp_id g.left)))
  have hT : Limits.IsTerminal T :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => huniqT V m _)
  obtain ⟨ε, hεbij, hεval⟩ := gen (Scheme.ProEt.topology S) (wcIntRingSheaf S ℓ) T hT
  let a : VU ⟶ T := MorphismProperty.Over.homMk VU.hom (Category.comp_id _) trivial
  let w : (yoneda.obj VU ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
      (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) :=
    Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
  let i : wcFreeSheaf S VU ⟶ wcFreeSheaf S T := wcFreeSheafMap S a
  have hwof : ∀ (X : (S.ProEt)ᵒᵖ) (x : ULift.{u+1} (X.unop ⟶ VU)),
      (w.app X).hom (FreeAbelianGroup.of x) = FreeAbelianGroup.of (ULift.up (x.down ≫ a)) := by
    intro X x
    change FreeAbelianGroup.map _ (FreeAbelianGroup.of x) = _
    exact FreeAbelianGroup.map_of_apply
      (f := fun y : ULift.{u+1} (X.unop ⟶ VU) => (ULift.up (y.down ≫ a) : ULift.{u+1} (X.unop ⟶ T))) x

  let φ : L.obj (wcFreeSheaf S T) ⟶ wcIntUnit S ℓ := (adj.homEquiv _ _).symm ε
  have hφiso : IsIso φ := by
    apply isIso_of_coyoneda_map_bijective
    intro M
    have heq : (fun x : wcIntUnit S ℓ ⟶ M => φ ≫ x) =
        (adj.homEquiv _ M).symm ∘ (fun f : SheafOfModules.unit (wcIntRingSheaf S ℓ) ⟶ M =>
          ε ≫ (SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).map f) := by
      funext x
      exact (adj.homEquiv_naturality_right_symm ε x).symm
    rw [heq]
    exact (Equiv.bijective _).comp (hεbij M)
  haveI := hφiso

  haveI := hVUo
  haveI : Mono a.left := IsOpenImmersion.mono VU.hom
  haveI : Mono a := ⟨fun g h e => MorphismProperty.Over.Hom.ext ((cancel_mono a.left).mp
    (by
      have e' := congrArg (fun t => t.left) e
      first
        | exact e'
        | simpa [MorphismProperty.Comma.comp_left, Comma.comp_left, Over.comp_left] using e'))⟩
  haveI hi : Mono i := by
    show Mono ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map w)
    exact Functor.map_mono (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) w
  let ιJ : L.obj (wcFreeSheaf S VU) ⟶ wcIntUnit S ℓ := L.map i ≫ φ

  let gVU : (wcFreeSheaf S VU).obj.obj (Opposite.op VU) :=
    ((toSheafify (Scheme.ProEt.topology S) (yoneda.obj VU ⋙ uliftFunctor.{u+1, u} ⋙
      AddCommGrpCat.free)).app (Opposite.op VU)).hom (FreeAbelianGroup.of (ULift.up (𝟙 VU)))
  let s : (L.obj (wcFreeSheaf S VU)).val.obj (Opposite.op VU) :=
    ((adj.unit.app (wcFreeSheaf S VU)).hom.app (Opposite.op VU)).hom gVU
  have hevs : ∀ (M : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ))
      (ψ : L.obj (wcFreeSheaf S VU) ⟶ M),
      (ψ.val.app (Opposite.op VU)).hom s =
        (((adj.homEquiv _ M) ψ).hom.app (Opposite.op VU)).hom gVU := by
    intro M ψ
    rw [Adjunction.homEquiv_unit]
    rfl
  let eY : ∀ (G' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
      (wcFreeSheaf S VU ⟶ G') ≃ G'.obj.obj (Opposite.op VU) := fun G' =>
    ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
        (yoneda.obj VU ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) G').trans
      (((Adjunction.whiskerRight (S.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj VU ⋙ uliftFunctor.{u+1, u}) G'.obj).trans
        (uliftYonedaEquiv.{u+1} (X := VU) (F := G'.obj ⋙ forget AddCommGrpCat.{u+1})))
  have heY : ∀ (G' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (g : wcFreeSheaf S VU ⟶ G'), eY G' g = (g.hom.app (Opposite.op VU)).hom gVU :=
    fun _ _ => rfl
  have hiii : ∀ (M : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ))
      (ψ ψ' : L.obj (wcFreeSheaf S VU) ⟶ M),
      (ψ.val.app (Opposite.op VU)).hom s = (ψ'.val.app (Opposite.op VU)).hom s → ψ = ψ' := by
    intro M ψ ψ' h
    apply (adj.homEquiv _ M).injective
    apply (eY _).injective
    rw [heY, heY, ← hevs, ← hevs]
    exact h

  have hι1 : (ιJ.val.app (Opposite.op VU)).hom s =
      (show (wcIntUnit S ℓ).val.obj (Opposite.op VU) from
        (1 : (wcIntRingSheaf S ℓ).obj.obj (Opposite.op VU))) := by
    rw [hevs]
    have hh : adj.homEquiv _ _ ιJ = i ≫ ε := by
      show adj.homEquiv _ _ (L.map i ≫ (adj.homEquiv _ _).symm ε) = i ≫ ε
      rw [Adjunction.homEquiv_naturality_left]
      exact congrArg (fun z => i ≫ z) (Equiv.apply_symm_apply (adj.homEquiv _ _) ε)
    rw [hh]
    have h1 : ((sheafifyMap (Scheme.ProEt.topology S) w).app (Opposite.op VU)).hom gVU =
        ((toSheafify (Scheme.ProEt.topology S) (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙
          AddCommGrpCat.free)).app (Opposite.op VU)).hom
          ((w.app (Opposite.op VU)).hom (FreeAbelianGroup.of (ULift.up (𝟙 VU)))) :=
      (ConcreteCategory.congr_hom
        (congrArg (fun φ => φ.app (Opposite.op VU))
          (toSheafify_naturality (Scheme.ProEt.topology S) w)) _).symm
    change (ε.hom.app (Opposite.op VU)).hom
      (((sheafifyMap (Scheme.ProEt.topology S) w).app (Opposite.op VU)).hom gVU) = _
    rw [h1, hwof]
    exact hεval _ _

  have hloc : ∀ (W : S.ProEt) (a' : W ⟶ VU) (f : (wcIntUnit S ℓ).val.obj (Opposite.op W)),
      ∃ t : (L.obj (wcFreeSheaf S VU)).val.obj (Opposite.op W),
        (ιJ.val.app (Opposite.op W)).hom t = f := by
    intro W a' f
    let sW := ((L.obj (wcFreeSheaf S VU)).val.map a'.op).hom s
    have hsW : (ιJ.val.app (Opposite.op W)).hom sW =
        (show (wcIntUnit S ℓ).val.obj (Opposite.op W) from
          (1 : (wcIntRingSheaf S ℓ).obj.obj (Opposite.op W))) := by
      have hn : (ιJ.val.app (Opposite.op W)).hom sW =
          ((wcIntUnit S ℓ).val.map a'.op).hom ((ιJ.val.app (Opposite.op VU)).hom s) :=
        PresheafOfModules.naturality_apply ιJ.val a'.op s
      rw [hn, hι1]
      exact PresheafOfModules.unit_map_one _ a'.op
    let r : (wcIntRingSheaf S ℓ).obj.obj (Opposite.op W) := f
    refine ⟨r • sW, ?_⟩
    have e1 := (ιJ.val.app (Opposite.op W)).hom.map_smul r sW
    exact e1.trans ((congrArg (fun z => r • z) hsW).trans (mul_one r))

  have htf : ∀ k : ℕ, Mono ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel ιJ)) := by
    intro k
    have hn : (ℓ ^ k : ℕ) ≠ 0 := pow_ne_zero _ (Fact.out : Nat.Prime ℓ).ne_zero
    have tf : ∀ {α : Type (u+1)} (y : FreeAbelianGroup α), (ℓ ^ k : ℕ) • y = 0 → y = 0 := by
      intro α y h
      apply (FreeAbelianGroup.equivFinsupp α).injective
      rw [map_zero]
      ext t
      have h' : (FreeAbelianGroup.equivFinsupp α ((ℓ ^ k : ℕ) • y)) t = 0 := by
        rw [h, map_zero, Finsupp.zero_apply]
      rw [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul] at h'
      rw [Finsupp.zero_apply]
      exact (mul_eq_zero.mp h').resolve_left (by exact_mod_cast hn)
    have hsat : ∀ (X : (S.ProEt)ᵒᵖ) (y : FreeAbelianGroup (ULift.{u+1} (X.unop ⟶ T))),
        (ℓ ^ k : ℕ) • y ∈ (w.app X).hom.range → y ∈ (w.app X).hom.range := by
      intro X y hy
      by_cases hne : Nonempty (X.unop ⟶ VU)
      · obtain ⟨b⟩ := hne
        clear hy
        induction y using FreeAbelianGroup.induction_on with
        | zero => exact zero_mem _
        | of t =>
          refine AddMonoidHom.mem_range.mpr ⟨FreeAbelianGroup.of (ULift.up b), ?_⟩
          exact (hwof X (ULift.up b)).trans
            (congrArg FreeAbelianGroup.of (ULift.ext _ _ (huniqT _ _ _)))
        | neg t ht => exact neg_mem ht
        | add x y hx hy => exact add_mem hx hy
      · obtain ⟨z, hz⟩ := AddMonoidHom.mem_range.mp hy
        have hz0 : ∀ z' : FreeAbelianGroup (ULift.{u+1} (X.unop ⟶ VU)), z' = 0 := by
          intro z'
          induction z' using FreeAbelianGroup.induction_on with
          | zero => rfl
          | of t => exact absurd ⟨t.down⟩ hne
          | neg t ht => rw [ht, neg_zero]
          | add x y hx hy => rw [hx, hy, add_zero]
        have hwz : (w.app X).hom z = 0 := by
          rw [hz0 z]
          exact map_zero _
        rw [tf y (hz.symm.trans hwz)]
        exact zero_mem _
    have T1 : Mono ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel w)) := by
      have happ : ∀ X, Mono (((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel w)).app X) := by
        intro X
        rw [NatTrans.app_nsmul, NatTrans.id_app]
        let E := Limits.PreservesCokernel.iso ((evaluation (S.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj X) w ≪≫
          AddCommGrpCat.cokernelIsoQuotient (w.app X)
        have hq : Mono ((ℓ ^ k : ℕ) • 𝟙 (AddCommGrpCat.of
            (↑((yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).obj X) ⧸
              (w.app X).hom.range))) := by
          rw [AddCommGrpCat.mono_iff_injective]
          have hsm : ∀ z, (ConcreteCategory.hom ((ℓ ^ k : ℕ) • 𝟙 (AddCommGrpCat.of
              (↑((yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free).obj X) ⧸
                (w.app X).hom.range)))) z = (ℓ ^ k : ℕ) • z := by
            intro z
            show (AddCommGrpCat.Hom.hom ((ℓ ^ k : ℕ) • 𝟙 _)) z = _
            rw [AddCommGrpCat.hom_nsmul]
            rfl
          intro x y hxy
          rw [hsm, hsm] at hxy
          have h0 : (ℓ ^ k : ℕ) • (x - y) = 0 := by rw [smul_sub, hxy, sub_self]
          rw [← sub_eq_zero]
          obtain ⟨z, hz⟩ := QuotientAddGroup.mk_surjective (x - y)
          rw [← hz] at h0 ⊢
          rw [← QuotientAddGroup.mk_nsmul, QuotientAddGroup.eq_zero_iff] at h0
          rw [QuotientAddGroup.eq_zero_iff]
          exact hsat X z h0
        have hc : ((ℓ ^ k : ℕ) • 𝟙 ((Limits.cokernel w).obj X)) =
            E.hom ≫ ((ℓ ^ k : ℕ) • 𝟙 _) ≫ E.inv := by
          rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, E.hom_inv_id]
          try rfl
        rw [hc]
        exact @mono_comp _ _ _ _ _ E.hom inferInstance _ (@mono_comp _ _ _ _ _ _ hq E.inv inferInstance)
      exact NatTrans.mono_of_mono_app _
    have T2 : Mono ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel i)) := by
      haveI := T1
      have h0 : Mono ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
          ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel w))) :=
        Functor.map_mono (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) _
      have h1 : (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
          ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel w)) = (ℓ ^ k : ℕ) • 𝟙
            ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj
              (Limits.cokernel w)) := by
        rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
      rw [h1] at h0
      let e := Limits.PreservesCokernel.iso
        (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) w
      have hc : ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel i)) =
          e.inv ≫ ((ℓ ^ k : ℕ) • 𝟙 _) ≫ e.hom := by
        rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, e.inv_hom_id]
        try rfl
      rw [hc]
      exact @mono_comp _ _ _ _ _ e.inv inferInstance _ (@mono_comp _ _ _ _ _ _ h0 e.hom inferInstance)
    have T3 : Mono ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel (L.map i))) := by
      haveI := T2
      have h0 : Mono (L.map ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel i))) := Functor.map_mono L _
      have h1 : L.map ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel i)) =
          (ℓ ^ k : ℕ) • 𝟙 (L.obj (Limits.cokernel i)) := by
        rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
      rw [h1] at h0
      let e := Limits.PreservesCokernel.iso L i
      have hc : ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel (L.map i))) =
          e.inv ≫ ((ℓ ^ k : ℕ) • 𝟙 _) ≫ e.hom := by
        rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, e.inv_hom_id]
        try rfl
      rw [hc]
      exact @mono_comp _ _ _ _ _ e.inv inferInstance _ (@mono_comp _ _ _ _ _ _ h0 e.hom inferInstance)
    haveI := T3
    let c := Limits.cokernelCompIsIso (L.map i) φ
    have hc : ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel ιJ)) = c.hom ≫ ((ℓ ^ k : ℕ) • 𝟙 _) ≫ c.inv := by
      rw [Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul, c.hom_inv_id]
    rw [hc]
    infer_instance
  exact ⟨ιJ, s, inferInstance, htf, hiii, hloc⟩

theorem wc_xbar_int_open_part_epi (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [IsProper X.hom] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (x₀ : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X) (hx₀ : x₀ ≫ wcPi2 F X = 𝟙 _)
    (Dx : wcHMPullData x₀ ℓ)
    (hK : ∀ (V : (wcXbar F X).ProEt) (f : (wcIntUnit (wcXbar F X) ℓ).val.obj (Opposite.op V)),
      (∃ k, ((Limits.kernel.ι (wcIntSuppπ Dx)).val.app (Opposite.op V)).hom k = f) ↔
        ∀ z : V.left, V.hom z = x₀ (IsLocalRing.closedPoint (AlgebraicClosure F)) →
          (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f) z = 0)
    (VU : (wcXbar F X).ProEt) (hVUo : IsOpenImmersion VU.hom)
    (hVU : Set.range VU.hom = (Set.range x₀)ᶜ)
    (Jm : SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ))
    (j : Jm ⟶ Limits.kernel (wcIntSuppπ Dx))
    (hloc : ∀ (W : (wcXbar F X).ProEt) (a : W ⟶ VU)
        (f : (wcIntUnit (wcXbar F X) ℓ).val.obj (Opposite.op W)),
      ∃ t : Jm.val.obj (Opposite.op W),
        ((Limits.kernel.ι (wcIntSuppπ Dx)).val.app (Opposite.op W)).hom
          ((j.val.app (Opposite.op W)).hom t) = f)
    (L : Sheaf (Scheme.ProEt.topology (wcXbar F X)) AddCommGrpCat.{u+1} ⥤
      SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ))
    (adj : L ⊣ SheafOfModules.toSheaf (wcIntRingSheaf (wcXbar F X) ℓ)) :
    ∀ k : ℕ, Epi ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel j)) :=
by
  classical
  intro k

  have s3 : ∀ n : ℕ, (∀ (W : (wcXbar F X).ProEt)
      (y : (Limits.kernel (wcIntSuppπ Dx)).val.obj (Opposite.op W)),
      ∃ (y' : (Limits.kernel (wcIntSuppπ Dx)).val.obj (Opposite.op W)) (Sv : Sieve W),
        Sv ∈ Scheme.ProEt.topology (wcXbar F X) W ∧
        ∀ (W' : (wcXbar F X).ProEt) (e : W' ⟶ W), Sv.arrows e →
          ∃ t : Jm.val.obj (Opposite.op W'),
            (j.val.app (Opposite.op W')).hom t =
              ((Limits.kernel (wcIntSuppπ Dx)).val.map e.op).hom (y - n • y')) →
      Epi (n • 𝟙 (Limits.cokernel j)) := by
    intro n h
    have hnsmul : ∀ {A B : SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ)} (f : A ⟶ B)
        (n : ℕ) (W : ((wcXbar F X).ProEt)ᵒᵖ) (x : A.val.obj W),
        ((n • f).val.app W).hom x = n • (f.val.app W).hom x := by
      intro A B f n W x
      induction n with
      | zero => rw [zero_nsmul, zero_nsmul]; rfl
      | succ n ih =>
        rw [succ_nsmul, succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app,
          ModuleCat.hom_add, LinearMap.add_apply, ih]
    apply Preadditive.epi_of_cancel_zero
    intro T g hg
    rw [Preadditive.nsmul_comp, Category.id_comp] at hg
    have hng : ∀ (W : ((wcXbar F X).ProEt)ᵒᵖ) (q : (Limits.cokernel j).val.obj W),
        n • (g.val.app W).hom q = 0 := by
      intro W q
      rw [← hnsmul, hg]
      rfl
    set φ := Limits.cokernel.π j ≫ g with hφdef
    have hjφ : j ≫ φ = 0 := by rw [hφdef, Limits.cokernel.condition_assoc, Limits.zero_comp]
    have hsep := T.isSheaf.isSeparated
    have hφ : φ = 0 := by
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro Xo
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro y
      obtain ⟨y', Sv, hSv, hlift⟩ := h Xo.unop y
      have hd : (φ.val.app Xo).hom (y - n • y') = 0 := by
        apply hsep Xo.unop Sv hSv
        intro Y f hf
        obtain ⟨t, ht⟩ := hlift Y f hf
        change (T.val.map f.op).hom ((φ.val.app Xo).hom (y - n • y')) =
          (T.val.map f.op).hom 0
        rw [map_zero, ← PresheafOfModules.naturality_apply, ← ht]
        change ((j ≫ φ).val.app (Opposite.op Y)).hom t = 0
        rw [hjφ]
        rfl
      have hy' : (φ.val.app Xo).hom (n • y') = 0 := by
        rw [map_nsmul]
        exact hng Xo _
      have hyy : y = (y - n • y') + n • y' := by abel
      change (φ.val.app Xo).hom y = 0
      rw [hyy, map_add, hd, hy', add_zero]
    exact (cancel_epi (Limits.cokernel.π j)).1 (by rw [← hφdef, hφ, Limits.comp_zero])

  have inj : ∀ V : (wcXbar F X).ProEt,
      Function.Injective ((Limits.kernel.ι (wcIntSuppπ Dx)).val.app (Opposite.op V)).hom := by
    intro V
    haveI := adj.isRightAdjoint
    have h1 : Mono ((SheafOfModules.toSheaf (wcIntRingSheaf (wcXbar F X) ℓ)).map
        (Limits.kernel.ι (wcIntSuppπ Dx))) := Functor.map_mono _ _
    have h2 : Mono ((sheafToPresheaf _ _).map ((SheafOfModules.toSheaf
        (wcIntRingSheaf (wcXbar F X) ℓ)).map (Limits.kernel.ι (wcIntSuppπ Dx)))) :=
      Functor.map_mono _ _
    have h3 := (NatTrans.mono_iff_mono_app _).1 h2 (Opposite.op V)
    exact (AddCommGrpCat.mono_iff_injective _).1 h3

  have s1 : ∀ {Y : Type u} [TopologicalSpace Y] (f : C(Y, ULift.{u+1} ℤ_[ℓ])),
      ∃ (A : Set Y) (g : C(Y, ULift.{u+1} ℤ_[ℓ])), IsClopen A ∧
        (∀ z, (f z).down = 0 → z ∈ A) ∧ (∀ z, (f z).down = 0 → (g z).down = 0) ∧
        (∀ z ∈ A, (f z).down = (ℓ : ℤ_[ℓ]) ^ k * (g z).down) ∧
        (∀ z, z ∉ A → (g z).down = 0) := by
    intro Y _ f
    set r : ℝ := (ℓ : ℝ) ^ (-(k : ℤ)) with hr
    have hℓpos : (0 : ℝ) < ℓ := by exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
    have hrpos : 0 < r := zpow_pos hℓpos _
    set B : Set ℤ_[ℓ] := Metric.closedBall 0 r with hB
    have hBc : IsClopen B := IsUltrametricDist.isClopen_closedBall 0 hrpos.ne'
    have hmemB : ∀ x : ℤ_[ℓ], x ∈ B ↔ x ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ k} := by
      intro x
      rw [hB, mem_closedBall_zero_iff, hr]
      exact PadicInt.norm_le_pow_iff_mem_span_pow x k
    let D : ℤ_[ℓ] → ℤ_[ℓ] := fun x =>
      if h : x ∈ B then Classical.choose (Ideal.mem_span_singleton'.1 ((hmemB x).1 h)) else 0
    have hDspec : ∀ x ∈ B, D x * (ℓ : ℤ_[ℓ]) ^ k = x := by
      intro x hx
      simp only [D, dif_pos hx]
      exact Classical.choose_spec (Ideal.mem_span_singleton'.1 ((hmemB x).1 hx))
    have hDoff : ∀ x, x ∉ B → D x = 0 := by
      intro x hx
      simp only [D, dif_neg hx]
    have hℓk0 : ((ℓ : ℤ_[ℓ]) ^ k) ≠ 0 :=
      pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
    have hnormℓk : ‖((ℓ : ℤ_[ℓ]) ^ k)‖ = ((ℓ : ℝ) ^ k)⁻¹ := by
      rw [PadicInt.norm_p_pow, zpow_neg, zpow_natCast]
    have hLip : LipschitzOnWith ((ℓ : NNReal) ^ k) D B := by
      apply LipschitzOnWith.of_dist_le_mul
      intro x hx y hy
      rw [dist_eq_norm, dist_eq_norm]
      have e : x - y = (D x - D y) * (ℓ : ℤ_[ℓ]) ^ k := by
        rw [sub_mul, hDspec x hx, hDspec y hy]
      have e2 : ‖x - y‖ = ‖D x - D y‖ * ((ℓ : ℝ) ^ k)⁻¹ := by
        rw [e, norm_mul, hnormℓk]
      have hpk : (0 : ℝ) < (ℓ : ℝ) ^ k := pow_pos hℓpos k
      rw [e2, NNReal.coe_pow, NNReal.coe_natCast]
      rw [mul_comm ‖D x - D y‖, ← mul_assoc, mul_inv_cancel₀ hpk.ne', one_mul]
    have hDcont : Continuous D := by
      rw [continuous_iff_continuousAt]
      intro x
      by_cases hx : x ∈ B
      · exact hLip.continuousOn.continuousAt (hBc.isOpen.mem_nhds hx)
      · have hc : ContinuousOn D Bᶜ :=
          (continuousOn_const (c := (0 : ℤ_[ℓ]))).congr (fun z hz => hDoff z hz)
        exact hc.continuousAt (hBc.compl.isOpen.mem_nhds hx)
    have hD0 : D 0 = 0 := by
      have h0B : (0 : ℤ_[ℓ]) ∈ B := Metric.mem_closedBall_self hrpos.le
      have := hDspec 0 h0B
      exact (mul_eq_zero.mp this).resolve_right hℓk0
    set φ : Y → ℤ_[ℓ] := fun z => (f z).down with hφ
    have hφc : Continuous φ := continuous_uliftDown.comp f.continuous
    refine ⟨φ ⁻¹' B, ⟨fun z => ULift.up (D (φ z)),
      continuous_uliftUp.comp (hDcont.comp hφc)⟩, hBc.preimage hφc, ?_, ?_, ?_, ?_⟩
    · intro z hz
      show φ z ∈ B
      rw [show φ z = 0 from hz]
      exact Metric.mem_closedBall_self hrpos.le
    · intro z hz
      show D (φ z) = 0
      rw [show φ z = 0 from hz, hD0]
    · intro z hz
      show φ z = (ℓ : ℤ_[ℓ]) ^ k * D (φ z)
      rw [mul_comm, hDspec _ hz]
    · intro z hz
      exact hDoff _ hz

  have s2 : ∀ (W : (wcXbar F X).ProEt) (A : Set W.left), IsClopen A →
      ∃ Sv : Sieve W, Sv ∈ Scheme.ProEt.topology (wcXbar F X) W ∧
        ∀ (W' : (wcXbar F X).ProEt) (e : W' ⟶ W), Sv.arrows e →
          Set.range e.left ⊆ A ∨ Set.range e.left ⊆ Aᶜ := by
    intro W A hA
    let O : ULift.{u+1} W.left → W.left.Opens := fun i =>
      if i.down ∈ A then ⟨A, hA.isOpen⟩ else ⟨Aᶜ, hA.compl.isOpen⟩
    have hOmem : ∀ i : ULift.{u+1} W.left, i.down ∈ O i := by
      intro i
      by_cases hi : i.down ∈ A
      · simp only [O, if_pos hi]; exact hi
      · simp only [O, if_neg hi]; exact hi
    have hOcases : ∀ i : ULift.{u+1} W.left,
        (O i : Set W.left) ⊆ A ∨ (O i : Set W.left) ⊆ Aᶜ := by
      intro i
      by_cases hi : i.down ∈ A
      · left; simp only [O, if_pos hi]; exact fun _ h => h
      · right; simp only [O, if_neg hi]; exact fun _ h => h
    haveI := W.prop
    let W' : ULift.{u+1} W.left → (wcXbar F X).ProEt := fun i =>
      Scheme.ProEt.mk ((O i).ι ≫ W.hom)
    let f : ∀ i, W' i ⟶ W := fun i => MorphismProperty.Over.homMk (O i).ι rfl trivial
    have hcov : ∀ x : ↥W.left, ∃ (i : ULift.{u+1} W.left) (y : ↥(O i).toScheme),
        (O i).ι y = x := fun x =>
      ⟨ULift.up x, ⟨x, hOmem (ULift.up x)⟩, Scheme.Opens.ι_apply _ _⟩
    let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) W.left :=
      Scheme.Cover.mkOfCovers (P := @WeaklyEtale) (ULift.{u+1} W.left)
        (fun i => (O i).toScheme) (fun i => (O i).ι) hcov (fun i => inferInstance)
    have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover :=
      @QuasiCompactCover.of_isOpenMap _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
        (fun i => (Scheme.Hom.isOpenEmbedding (O i).ι).isOpenMap)
    have hRb : Presieve.ofArrows (fun i : ULift.{u+1} W.left => (O i).toScheme)
        (fun i => (O i).ι) ∈ Scheme.proetalePrecoverage.coverings W.left :=
      Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc, rfl⟩
    have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget (wcXbar F X) ⋙
      Over.forget (wcXbar F X)) (Y := W') f
    have hR' : Presieve.ofArrows W' f ∈ (Scheme.ProEt.precoverage (wcXbar F X)).coverings W :=
      Precoverage.mem_comap_iff.mpr (e ▸ hRb)
    have hRJ : Sieve.generate (Presieve.ofArrows W' f) ∈ (Scheme.ProEt.topology (wcXbar F X)) W :=
      Precoverage.generate_mem_toGrothendieck hR'
    refine ⟨Sieve.generate (Presieve.ofArrows W' f), hRJ, ?_⟩
    rintro T' _ ⟨Y, h', _, ⟨i⟩, rfl⟩
    have hsub : Set.range (h' ≫ f i).left ⊆ (O i : Set W.left) := by
      rintro _ ⟨z, rfl⟩
      have hr := Scheme.Opens.range_ι (O i)
      change (O i).ι (h'.left z) ∈ (O i : Set W.left)
      rw [← hr]
      exact ⟨_, rfl⟩
    rcases hOcases i with hc | hc
    · exact Or.inl (hsub.trans hc)
    · exact Or.inr (hsub.trans hc)

  apply s3
  intro W y
  set ιK := Limits.kernel.ι (wcIntSuppπ Dx) with hιK
  have hf0 := (hK W ((ιK.val.app (Opposite.op W)).hom y)).1 ⟨y, rfl⟩
  obtain ⟨A, g, hA, hzA, hzg, hAeq, hAc⟩ :=
    s1 (show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from (ιK.val.app (Opposite.op W)).hom y)
  obtain ⟨y', hy'⟩ := (hK W (show (wcIntUnit (wcXbar F X) ℓ).val.obj (Opposite.op W) from g)).2
    (by
      intro z hz
      apply ULift.ext
      rw [ULift.zero_down]
      exact hzg z ((congrArg ULift.down (hf0 z hz)).trans ULift.zero_down))
  obtain ⟨Sv, hSv, hcases⟩ := s2 W A hA
  refine ⟨y', Sv, hSv, ?_⟩
  intro W' e he
  set w := ((Limits.kernel (wcIntSuppπ Dx)).val.map e.op).hom (y - (ℓ ^ k : ℕ) • y') with hw
  have key : ∀ z' : W'.left,
      ((show C(↥W'.left, ULift.{u+1} ℤ_[ℓ]) from (ιK.val.app (Opposite.op W')).hom w) z').down =
        ((show C(↥W.left, ULift.{u+1} ℤ_[ℓ]) from (ιK.val.app (Opposite.op W)).hom y)
          (e.left z')).down - (ℓ ^ k : ℕ) • (g (e.left z')).down := by
    intro z'
    rw [hw, PresheafOfModules.naturality_apply, map_sub, map_nsmul, hy']
    rfl
  rcases hcases W' e he with hcase | hcase
  · refine ⟨0, inj W' ?_⟩
    rw [map_zero, map_zero]
    symm
    have h0 : (show C(↥W'.left, ULift.{u+1} ℤ_[ℓ]) from (ιK.val.app (Opposite.op W')).hom w) = 0 := by
      refine ContinuousMap.ext fun z' => ULift.ext _ _ ?_
      refine (key z').trans ?_
      rw [hAeq _ (hcase ⟨z', rfl⟩), nsmul_eq_mul, Nat.cast_pow, sub_self]
      rfl
    exact h0
  · have hsub : Set.range W'.hom ⊆ Set.range VU.hom := by
      rintro _ ⟨z', rfl⟩
      rw [hVU]
      rintro ⟨q, hq⟩
      have hq' : W'.hom z' = x₀ (IsLocalRing.closedPoint (AlgebraicClosure F)) := by
        rw [← hq, Subsingleton.elim q (IsLocalRing.closedPoint (AlgebraicClosure F))]
      have hwz : W.hom (e.left z') = x₀ (IsLocalRing.closedPoint (AlgebraicClosure F)) := by
        rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w e]
        exact hq'
      have h0 := hf0 _ hwz
      have hmem := hzA _ ((congrArg ULift.down h0).trans ULift.zero_down)
      exact hcase ⟨z', rfl⟩ hmem
    haveI := hVUo
    let b : W' ⟶ VU := MorphismProperty.Over.homMk (IsOpenImmersion.lift VU.hom W'.hom hsub)
      (IsOpenImmersion.lift_fac _ _ _) trivial
    obtain ⟨t, ht⟩ := hloc W' b ((ιK.val.app (Opposite.op W')).hom w)
    exact ⟨t, inj W' ht⟩

theorem wc_xbar_int_open_part_divisible (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [IsProper X.hom] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (x₀ : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X) (hx₀ : x₀ ≫ wcPi2 F X = 𝟙 _)
    (Dx : wcHMPullData x₀ ℓ)
    (hK : ∀ (V : (wcXbar F X).ProEt) (f : (wcIntUnit (wcXbar F X) ℓ).val.obj (Opposite.op V)),
      (∃ k, ((Limits.kernel.ι (wcIntSuppπ Dx)).val.app (Opposite.op V)).hom k = f) ↔
        ∀ z : V.left, V.hom z = x₀ (IsLocalRing.closedPoint (AlgebraicClosure F)) →
          (show C(↥V.left, ULift.{u+1} ℤ_[ℓ]) from f) z = 0)
    (VU : (wcXbar F X).ProEt) (hVUo : IsOpenImmersion VU.hom)
    (hVU : Set.range VU.hom = (Set.range x₀)ᶜ)
    (L : Sheaf (Scheme.ProEt.topology (wcXbar F X)) AddCommGrpCat.{u+1} ⥤
      SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ))
    (adj : L ⊣ SheafOfModules.toSheaf (wcIntRingSheaf (wcXbar F X) ℓ))
    [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] :
    ∃ j : L.obj (wcFreeSheaf (wcXbar F X) VU) ⟶ Limits.kernel (wcIntSuppπ Dx),
      Mono j ∧ ∀ k : ℕ, IsIso ((ℓ ^ k : ℕ) • 𝟙 (Limits.cokernel j)) :=
by
  obtain ⟨ιJ, s, hmono, htf, hinj, hloc⟩ :=
    wc_int_open_free_ideal_data (wcXbar F X) ℓ VU hVUo L adj

  have hJ : ιJ ≫ wcIntSuppπ Dx = 0 := by
    apply hinj
    obtain ⟨k₀, hk₀⟩ := (hK VU ((ιJ.val.app (Opposite.op VU)).hom s)).2 (by
      intro z hz
      exfalso
      have h1 : VU.hom z ∈ Set.range VU.hom := ⟨z, rfl⟩
      rw [hVU] at h1
      exact h1 ⟨_, hz.symm⟩)
    have e1 : ((ιJ ≫ wcIntSuppπ Dx).val.app (Opposite.op VU)).hom s =
        ((wcIntSuppπ Dx).val.app (Opposite.op VU)).hom ((ιJ.val.app (Opposite.op VU)).hom s) := rfl
    have e2 : ((Limits.kernel.ι (wcIntSuppπ Dx) ≫ wcIntSuppπ Dx).val.app (Opposite.op VU)).hom k₀ =
        ((wcIntSuppπ Dx).val.app (Opposite.op VU)).hom
          (((Limits.kernel.ι (wcIntSuppπ Dx)).val.app (Opposite.op VU)).hom k₀) := rfl
    rw [e1, ← hk₀, ← e2, Limits.kernel.condition]
    rfl

  refine ⟨Limits.kernel.lift (wcIntSuppπ Dx) ιJ hJ, ?_, ?_⟩
  · have hfac : Limits.kernel.lift (wcIntSuppπ Dx) ιJ hJ ≫ Limits.kernel.ι (wcIntSuppπ Dx) = ιJ :=
