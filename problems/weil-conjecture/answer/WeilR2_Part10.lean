    (Scheme.ProEt.topology S) (wcIntRingSheaf S ℓ)
  haveI hGL : Limits.PreservesFiniteLimits (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) :=
    inferInstance

  have hb := ext_transfer_of_hom_bijective L (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) adj
    (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) (SheafOfModules.unit (wcIntRingSheaf S ℓ)) ε hε M n
  exact ⟨Equiv.ofBijective _ hb⟩

theorem wc_xbar_int_tors_succ_top_vanish (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
    ∀ x : Abelian.Ext (wcIntUnit (wcXbar F X) ℓ) (wcIntTors (wcXbar F X) ℓ 1) (2 * d + 1), x = 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
  intro x

  have h : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F)

  have hA : ∀ a : ZMod (ℓ ^ 1), ∃ k : ℕ, ℓ ^ k • a = 0 := by
    intro a
    refine ⟨1, ?_⟩
    rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  have hv := wc_coh_torsion_vanishing F X d ℓ hℓ h (ZMod (ℓ ^ 1)) hA (2 * d + 1) (by omega)
  haveI hsub1 : Subsingleton (Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcContSheaf X.left (ZMod (ℓ ^ 1))) (2 * d + 1)) :=
    ⟨fun a b => (hv a).trans (hv b).symm⟩
  obtain ⟨Ψ⟩ := wc_ext_free_slice_cont X.left (wcGeomPoint F X h) (ZMod (ℓ ^ 1)) (2 * d + 1)
  haveI hsub2 : Subsingleton (Abelian.Ext
      (wcFreeSheaf (wcGeomPoint F X h).left (Scheme.ProEt.mk (𝟙 (wcGeomPoint F X h).left)))
      (wcContSheaf (wcGeomPoint F X h).left (ZMod (ℓ ^ 1))) (2 * d + 1)) :=
    Ψ.symm.subsingleton
  haveI hsub2' : Subsingleton (Abelian.Ext
      (wcFreeSheaf (wcXbar F X) (Scheme.ProEt.mk (𝟙 (wcXbar F X))))
      (wcContSheaf (wcXbar F X) (ZMod (ℓ ^ 1))) (2 * d + 1)) := hsub2

  obtain ⟨e⟩ := wc_int_tors_toSheaf_iso (wcXbar F X) ℓ 1
  have key : ∀ z : Abelian.Ext (wcFreeSheaf (wcXbar F X) (Scheme.ProEt.mk (𝟙 (wcXbar F X))))
      ((SheafOfModules.toSheaf (wcIntRingSheaf (wcXbar F X) ℓ)).obj (wcIntTors (wcXbar F X) ℓ 1))
      (2 * d + 1), z = 0 := by
    intro z
    have hy : z.comp (Abelian.Ext.mk₀ e.hom) (add_zero _) = 0 := Subsingleton.elim _ _
    have hz : z = (z.comp (Abelian.Ext.mk₀ e.hom) (add_zero _)).comp
        (Abelian.Ext.mk₀ e.inv) (add_zero _) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    rw [hz, hy, Abelian.Ext.zero_comp]
  haveI hsub3 : Subsingleton (Abelian.Ext (wcFreeSheaf (wcXbar F X) (Scheme.ProEt.mk (𝟙 (wcXbar F X))))
      ((SheafOfModules.toSheaf (wcIntRingSheaf (wcXbar F X) ℓ)).obj (wcIntTors (wcXbar F X) ℓ 1))
      (2 * d + 1)) :=
    ⟨fun a b => (key a).trans (key b).symm⟩

  obtain ⟨Φ⟩ := wc_int_unit_ext_free_equiv (wcXbar F X) ℓ (wcIntTors (wcXbar F X) ℓ 1) (2 * d + 1)
  haveI : Subsingleton (Abelian.Ext (wcIntUnit (wcXbar F X) ℓ) (wcIntTors (wcXbar F X) ℓ 1)
      (2 * d + 1)) := Φ.subsingleton
  exact Subsingleton.elim x 0

theorem wc_xbar_tors_supp_lift (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (x₀ : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X) (hx₀ : x₀ ≫ wcPi2 F X = 𝟙 _)
    (Dx : wcHMPullData x₀ ℓ) (hDx : wcHMPullCanonical Dx) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
    ∀ (m : ℕ), 1 ≤ m →
    ∀ a : Abelian.Ext (wcIntSuppObj Dx) (wcIntTors (wcXbar F X) ℓ m) (2 * d),
    ∃ a' : Abelian.Ext (wcIntSuppObj Dx) (wcIntTors (wcXbar F X) ℓ (m + 1)) (2 * d),
      ∀ t : wcIntTors (wcXbar F X) ℓ (m + 1) ⟶ wcIntTors (wcXbar F X) ℓ m,
        Limits.cokernel.π ((ℓ ^ (m + 1) : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ)) ≫ t =
          Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ)) →
        a'.comp (Abelian.Ext.mk₀ t) (add_zero (2 * d)) = a :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
  intro m hm a

  have tors : ∀ (U : SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ)) (n : ℕ → (U ⟶ U)),
      (∀ k, Mono (n k)) → (∀ a b, n a ≫ n b = n (a + b)) → ∀ k : ℕ,
      ∃ (ι : Limits.cokernel (n 1) ⟶ Limits.cokernel (n (k + 1)))
        (t₀ : Limits.cokernel (n (k + 1)) ⟶ Limits.cokernel (n k)) (w : ι ≫ t₀ = 0),
        Limits.cokernel.π (n (k + 1)) ≫ t₀ = Limits.cokernel.π (n k) ∧
          (ShortComplex.mk ι t₀ w).ShortExact := by
    intro U n hmono hnn k
    have E1 : n (k + 1) ≫ Limits.cokernel.π (n k) = 0 := by
      rw [show k + 1 = 1 + k by omega, ← hnn, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    have E2 : n 1 ≫ (n k ≫ Limits.cokernel.π (n (k + 1))) = 0 := by
      rw [← Category.assoc, hnn, show 1 + k = k + 1 by omega, Limits.cokernel.condition]
    obtain ⟨t₀, F1⟩ : ∃ t₀ : Limits.cokernel (n (k + 1)) ⟶ Limits.cokernel (n k),
        Limits.cokernel.π (n (k + 1)) ≫ t₀ = Limits.cokernel.π (n k) :=
      ⟨Limits.cokernel.desc _ _ E1, Limits.cokernel.π_desc _ _ _⟩
    obtain ⟨ι, F2⟩ : ∃ ι : Limits.cokernel (n 1) ⟶ Limits.cokernel (n (k + 1)),
        Limits.cokernel.π (n 1) ≫ ι = n k ≫ Limits.cokernel.π (n (k + 1)) :=
      ⟨Limits.cokernel.desc _ _ E2, Limits.cokernel.π_desc _ _ _⟩
    have F3 : ι ≫ t₀ = 0 := by
      rw [← cancel_epi (Limits.cokernel.π (n 1)), Limits.comp_zero, reassoc_of% F2, F1,
        Limits.cokernel.condition]
    haveI : Epi t₀ := epi_of_epi_fac F1
    haveI : Mono ι := by
      apply Preadditive.mono_of_cancel_zero
      intro P g hg
      obtain ⟨A', π, hπ, y, hy⟩ := surjective_up_to_refinements_of_epi (Limits.cokernel.π (n 1)) g
      have h1 : (y ≫ n k) ≫ Limits.cokernel.π (n (k + 1)) = 0 := by
        simp only [Category.assoc]
        rw [← F2, ← reassoc_of% hy, hg, Limits.comp_zero]
      obtain ⟨A'', π', hπ', z, hz⟩ :=
        (ShortComplex.exact_cokernel (n (k + 1))).exact_up_to_refinements (y ≫ n k) h1
      have hz' : π' ≫ y ≫ n k = z ≫ n (k + 1) := hz
      haveI := hπ
      haveI := hπ'
      haveI := hmono k
      have h2 : π' ≫ y = z ≫ n 1 := by
        rw [← cancel_mono (n k)]
        simp only [Category.assoc]
        rw [hnn, show 1 + k = k + 1 by omega]
        exact hz'
      have h3 : (π' ≫ π) ≫ g = 0 := by
        simp only [Category.assoc]
        rw [hy, reassoc_of% h2, Limits.cokernel.condition, Limits.comp_zero]
      exact (cancel_epi (π' ≫ π)).1 (h3.trans Limits.comp_zero.symm)
    have hexact : (ShortComplex.mk ι t₀ F3).Exact := by
      rw [ShortComplex.exact_iff_exact_up_to_refinements]
      intro A x₂ hx₂
      have hx₂' : x₂ ≫ t₀ = 0 := hx₂
      obtain ⟨A', π, hπ, y, hy⟩ :=
        surjective_up_to_refinements_of_epi (Limits.cokernel.π (n (k + 1))) x₂
      have h1 : y ≫ Limits.cokernel.π (n k) = 0 := by
        rw [← F1, ← reassoc_of% hy, hx₂', Limits.comp_zero]
      obtain ⟨A'', π', hπ', z, hz⟩ := (ShortComplex.exact_cokernel (n k)).exact_up_to_refinements y h1
      have hz' : π' ≫ y = z ≫ n k := hz
      haveI := hπ
      haveI := hπ'
      refine ⟨A'', π' ≫ π, inferInstance, z ≫ Limits.cokernel.π (n 1), ?_⟩
      show (π' ≫ π) ≫ x₂ = (z ≫ Limits.cokernel.π (n 1)) ≫ ι
      simp only [Category.assoc]
      rw [F2, hy, reassoc_of% hz']
    exact ⟨ι, t₀, F3, F1, ShortComplex.ShortExact.mk' hexact inferInstance inferInstance⟩
  have hnn : ∀ a b : ℕ, ((ℓ ^ a : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ)) ≫
      ((ℓ ^ b : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ)) =
        ((ℓ ^ (a + b) : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ)) := by
    intro a b
    rw [Preadditive.comp_nsmul, Category.comp_id, smul_smul, ← pow_add, Nat.add_comm b a]
  obtain ⟨ι, t₀, w, F1, hS⟩ := tors (wcIntUnit (wcXbar F X) ℓ)
    (fun k => (ℓ ^ k : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ))
    (fun k => wc_int_unit_pow_mono (wcXbar F X) ℓ k) hnn m

  have hS' : (ShortComplex.mk (Limits.kernel.ι (wcIntSuppπ Dx)) (wcIntSuppπ Dx)
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _)
      (inferInstance : Mono (Limits.kernel.ι (wcIntSuppπ Dx)))
      (inferInstance : Epi (Limits.factorThruImage (wcIntSuppMap Dx)))

  have hvan1 : ∀ v : Abelian.Ext (wcIntSuppObj Dx) (wcIntTors (wcXbar F X) ℓ 1) (2 * d + 1),
      v = 0 := by
    intro v
    have h0 : (Abelian.Ext.mk₀ (wcIntSuppπ Dx)).comp v (zero_add _) = 0 :=
      wc_xbar_int_tors_succ_top_vanish F X d ℓ hℓ _
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS'
      (wcIntTors (wcXbar F X) ℓ 1) v h0 (show 1 + 2 * d = 2 * d + 1 by omega)
    rw [← hx₁, wc_xbar_int_supp_kernel_tors_vanish F X d ℓ hℓ x₀ hx₀ Dx hDx 1 le_rfl x₁,
      Abelian.Ext.comp_zero]

  have hobs : a.comp hS.extClass (rfl : 2 * d + 1 = 2 * d + 1) = 0 := hvan1 _
  obtain ⟨a', ha'⟩ := Abelian.Ext.covariant_sequence_exact₃ (wcIntSuppObj Dx) hS a rfl hobs
  refine ⟨a', fun t ht => ?_⟩
  have htt : t = t₀ :=
    (cancel_epi (Limits.cokernel.π ((ℓ ^ (m + 1) : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ)))).1
      (ht.trans F1.symm)
  rw [htt]
  exact ha'

theorem wc_int_unit_tower_shortExact : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) (t : ∀ k : ℕ, wcIntTors S ℓ (m + k + 1) ⟶ wcIntTors S ℓ (m + k)), (∀ k : ℕ, Limits.cokernel.π ((ℓ ^ (m + k + 1) : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≫ t k = Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit S ℓ))) → ∃ hz : Limits.Pi.lift (fun k => Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit S ℓ))) ≫ Limits.Pi.lift (fun k => Limits.Pi.π (fun j => wcIntTors S ℓ (m + j)) k - Limits.Pi.π (fun j => wcIntTors S ℓ (m + j)) (k + 1) ≫ t k) = 0, (ShortComplex.mk _ _ hz).ShortExact :=
by
  classical
  intro S ℓ _ m t ht
  have hℓ0 : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero
  have hcongr : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B] (φ φ' : A →+ B)
      (e : φ = φ') (hφ : Continuous φ) (hφ' : Continuous φ'),
      wcContSheafMap S φ hφ = wcContSheafMap S φ' hφ' := by
    intro A B _ _ _ _ _ _ φ φ' e hφ hφ'
    subst e
    rfl



  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology S) (wcIntRingSheaf S ℓ)
  haveI : Limits.PreservesLimitsOfShape (Discrete ℕ)
      (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)) := by
    haveI : Limits.PreservesLimitsOfShape (Discrete ℕ)
        (SheafOfModules.forget.{u+1} (wcIntRingSheaf S ℓ) ⋙
          PresheafOfModules.toPresheaf.{u+1} (wcIntRingSheaf S ℓ).obj) := inferInstance
    haveI : Limits.PreservesLimitsOfShape (Discrete ℕ)
        (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ) ⋙
          sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
      Limits.preservesLimitsOfShape_of_natIso
        (Iso.refl _ : SheafOfModules.forget.{u+1} (wcIntRingSheaf S ℓ) ⋙
          PresheafOfModules.toPresheaf.{u+1} (wcIntRingSheaf S ℓ).obj ≅ _)
    exact Limits.preservesLimitsOfShape_of_reflects_of_preserves _
      (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
  haveI : (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).ReflectsMonomorphisms :=
    Functor.reflectsMonomorphisms_of_faithful _
  haveI : (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).ReflectsEpimorphisms :=
    Functor.reflectsEpimorphisms_of_faithful _



  have hι : Nonempty ((SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).obj
      (SheafOfModules.unit (wcIntRingSheaf S ℓ)) ≅ wcContSheaf S ℤ_[ℓ]) := by
    let e : ∀ V : (S.ProEt)ᵒᵖ,
        C(↥V.unop.left, ULift.{u+1} ℤ_[ℓ]) ≃+ ULift.{u+1} C(↥V.unop.left, ℤ_[ℓ]) :=
      fun V =>
        { toFun := fun r => ULift.up ⟨fun t => (r t).down, continuous_uliftDown.comp r.continuous⟩
          invFun := fun w => ⟨fun t => ULift.up (w.down t), continuous_uliftUp.comp w.down.continuous⟩
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl
          map_add' := fun _ _ => rfl }
    let φ : ∀ V : (S.ProEt)ᵒᵖ,
        ((SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).obj
          (SheafOfModules.unit (wcIntRingSheaf S ℓ))).obj.obj V ≅
        (wcContSheaf S ℤ_[ℓ]).obj.obj V :=
      fun V => (e V).toAddCommGrpIso
    refine ⟨(fullyFaithfulSheafToPresheaf _ _).preimageIso (NatIso.ofComponents φ ?_)⟩
    intro V W f
    ext r
    rfl
  obtain ⟨ι⟩ := hι



  have hT : ∀ n : ℕ, Continuous (PadicInt.toZModPow (p := ℓ) n) := by
    intro n
    have hzero : ∀ᶠ x in nhds (0 : ℤ_[ℓ]), PadicInt.toZModPow (p := ℓ) n x = 0 := by
      have hpos : (0 : ℝ) < (ℓ : ℝ) ^ (-(n : ℤ)) := by
        apply zpow_pos
        exact_mod_cast (Fact.out : Nat.Prime ℓ).pos
      filter_upwards [Metric.closedBall_mem_nhds (0 : ℤ_[ℓ]) hpos] with x hx
      rw [Metric.mem_closedBall, dist_zero_right] at hx
      have h1 := (PadicInt.norm_le_pow_iff_mem_span_pow x n).mp hx
      rw [← PadicInt.ker_toZModPow] at h1
      exact (RingHom.mem_ker).mp h1
    apply continuous_of_continuousAt_zero (PadicInt.toZModPow (p := ℓ) n)
    rw [ContinuousAt, map_zero, nhds_discrete (ZMod (ℓ ^ n)), Filter.tendsto_pure]
    exact hzero
  have hincl : Continuous (wcTwrInclM ℓ m) := continuous_pi fun k => hT (m + k)
  have hinj : Function.Injective (wcTwrInclM ℓ m) := by
    intro x y hxy
    apply PadicInt.ext_of_toZModPow.mp
    intro n
    have h1 : PadicInt.toZModPow (m + n) x = PadicInt.toZModPow (m + n) y := congrFun hxy n
    rw [← PadicInt.cast_toZModPow n (m + n) (Nat.le_add_left n m) x, h1,
      PadicInt.cast_toZModPow n (m + n) (Nat.le_add_left n m) y]
  have hemb : Topology.IsEmbedding (wcTwrInclM ℓ m) := (hincl.isClosedEmbedding hinj).isEmbedding
  have hshift : Continuous (wcTwrShiftM ℓ m) := by
    apply continuous_pi
    intro k
    exact (continuous_apply k).sub
      ((continuous_of_discreteTopology (f := ⇑(wcTwrCastM ℓ m k))).comp (continuous_apply (k + 1)))
  have hker : ∀ b, wcTwrShiftM ℓ m b = 0 ↔ ∃ a, wcTwrInclM ℓ m a = b := by
    intro b
    constructor
    · intro hb
      have hC : ∀ k, b k = ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + k))) (ZMod (ℓ ^ (m + k)))
          (b (k + 1)) := by
        intro k
        exact sub_eq_zero.mp (congrFun hb k)
      have hA : ∀ k K (h : k ≤ K), ZMod.castHom (pow_dvd_pow ℓ (Nat.add_le_add_left h m))
          (ZMod (ℓ ^ (m + k))) (b K) = b k := by
        intro k K h
        induction K, h using Nat.le_induction with
        | base => rw [ZMod.castHom_apply, ZMod.cast_id]
        | succ K hkK ih =>
          rw [← ih, hC K]
          exact (RingHom.congr_fun (ZMod.castHom_comp (pow_dvd_pow ℓ (Nat.add_le_add_left hkK m))
            (pow_dvd_pow ℓ (Nat.le_succ (m + K)))) (b (K + 1))).symm
      have hB : ∀ k K, k ≤ K → PadicInt.toZModPow (m + k) (((b K).val : ℕ) : ℤ_[ℓ]) = b k := by
        intro k K h
        rw [map_natCast, ← hA k K h, ZMod.castHom_apply, ZMod.cast_eq_val]
      have hclosed : IsClosed (Set.range (wcTwrInclM ℓ m)) := (isCompact_range hincl).isClosed
      have hlim : Filter.Tendsto (fun K => wcTwrInclM ℓ m (((b K).val : ℕ) : ℤ_[ℓ])) Filter.atTop
          (nhds b) := by
        rw [tendsto_pi_nhds]
        intro k
        rw [nhds_discrete (ZMod (ℓ ^ (m + k))), Filter.tendsto_pure, Filter.eventually_atTop]
        exact ⟨k, fun K hK => hB k K hK⟩
      exact hclosed.mem_of_tendsto hlim (Filter.Eventually.of_forall fun K => ⟨_, rfl⟩)
    · rintro ⟨a, rfl⟩
      funext k
      show PadicInt.toZModPow (m + k) a - ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + k)))
        (ZMod (ℓ ^ (m + k))) (PadicInt.toZModPow (m + k + 1) a) = 0
      rw [ZMod.castHom_apply, PadicInt.cast_toZModPow (m + k) (m + k + 1) (Nat.le_succ _) a, sub_self]
  have hsec : ∃ σ : ((k : ℕ) → ZMod (ℓ ^ (m + k))) → ((k : ℕ) → ZMod (ℓ ^ (m + k))),
      Continuous σ ∧ ∀ c, wcTwrShiftM ℓ m (σ c) = c := by
    refine ⟨fun c k => -∑ j ∈ Finset.range k, (((c j).val : ℕ) : ZMod (ℓ ^ (m + k))), ?_, ?_⟩
    · apply continuous_pi
      intro k
      exact (continuous_finset_sum _ fun j _ =>
        (continuous_of_discreteTopology
          (f := fun y : ZMod (ℓ ^ (m + j)) => ((y.val : ℕ) : ZMod (ℓ ^ (m + k))))).comp
          (continuous_apply j)).neg
    · intro c
      funext k
      show (-∑ j ∈ Finset.range k, (((c j).val : ℕ) : ZMod (ℓ ^ (m + k)))) -
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ (m + k))) (ZMod (ℓ ^ (m + k)))
          (-∑ j ∈ Finset.range (k + 1), (((c j).val : ℕ) : ZMod (ℓ ^ (m + k + 1)))) = c k
      rw [map_neg, map_sum, Finset.sum_range_succ]
      simp only [map_natCast]
      rw [ZMod.natCast_zmod_val]
      ring



  have hid : ∀ (A : Type) [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A],
      wcContSheafMap S (AddMonoidHom.id A) continuous_id = 𝟙 (wcContSheaf S A) := by
    intro A _ _ _
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro y
    rfl
  have hnsmul : ∀ (A : Type) [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A] (N : ℕ),
      wcContSheafMap S (N • AddMonoidHom.id A) (continuous_nsmul N) = N • 𝟙 (wcContSheaf S A) := by
    intro A _ _ _ N
    induction N with
    | zero =>
      have e : ((0 : ℕ) • AddMonoidHom.id A) = AddMonoidHom.id A - AddMonoidHom.id A := by
        ext x; simp
      rw [hcongr _ _ e _ (continuous_id.sub continuous_id),
        (wc_contSheafMap_comp_sub S (AddMonoidHom.id A) (AddMonoidHom.id A) continuous_id
          continuous_id (AddMonoidHom.id A) continuous_id).2, sub_self, zero_nsmul]
    | succ N ih =>
      have e : ((N + 1) • AddMonoidHom.id A) - AddMonoidHom.id A = N • AddMonoidHom.id A := by
        ext x; simp [succ_nsmul]
      have h2 := (wc_contSheafMap_comp_sub S ((N + 1) • AddMonoidHom.id A) (AddMonoidHom.id A)
