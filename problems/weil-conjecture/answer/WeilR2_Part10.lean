    fun k => by apply AlgHom.ext; intro y; rfl
  have A3 : ∀ k j, (L (k + j)).val.comp (IntermediateField.inclusion (hLmono k j)) = (L k).val :=
    fun k j => by apply AlgHom.ext; intro y; rfl
  have A4 : ∀ k j, (IntermediateField.inclusion (hLmono k j)).comp (τk k) = τk (k + j) :=
    fun k j => by apply AlgHom.ext; intro y; rfl
  have A5 : ∀ k j, (γk (k + j)).comp (IntermediateField.inclusion (hLmono k j)) =
