      change (φ₁.hom.app (Opposite.op ((wcEtBaseChange g).obj V))).hom
        (((αg.unit.app A).hom.app (Opposite.op V)).hom x) =
        (B'.obj.map (κ' V).op).hom (((αe.unit.app A).hom.app (Opposite.op V)).hom x) at h
      rw [ug, ue] at h
