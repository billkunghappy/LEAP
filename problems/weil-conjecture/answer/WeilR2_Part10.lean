    fun k j => by apply AlgHom.ext; intro y; rfl
  have A6 : ∀ k, (γk k).comp (τk k) = τk k := fun k => by
    apply AlgHom.ext; intro e; apply Subtype.ext; exact hF1 e
  have A8 : ∀ k n (y : L k), (((γk k) ^ n) y : AlgebraicClosure F) =
      ((Fr.symm ^ Module.finrank F E) ^ n) (y : AlgebraicClosure F) := by
    intro k n y
    induction n with
    | zero => first | rfl | simp
    | succ n ih =>
      rw [pow_succ', pow_succ', AlgHom.mul_apply, AlgEquiv.mul_apply, ← ih] <;> rfl
  have hpowRH : ∀ k n, (γk k).toRingHom ^ n = ((γk k) ^ n).toRingHom := by
    intro k n
    induction n with
    | zero => rfl
    | succ n ih => rw [pow_succ', pow_succ', ih] <;> rfl
  have hγN : ∀ k, γk k ^ (k + 1).factorial = AlgHom.id F (L k) := by
    intro k; apply AlgHom.ext; intro y; apply Subtype.ext
    exact (A8 k _ y).trans (hLN k y y.2)

  have hco : ∀ e : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F,
      (e : AlgebraicClosure F →+* AlgebraicClosure F) =
        (e : AlgebraicClosure F →ₐ[F] AlgebraicClosure F).toRingHom :=
    fun e => RingHom.ext fun _ => rfl
  have hFrobL : (wcGeomFrob F X h).left =
      wcLfdTowPm F X (Fr.symm : AlgebraicClosure F →ₐ[F] AlgebraicClosure F) := by
    apply Limits.pullback.hom_ext
    · exact ((Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)).trans (hPmF _).symm
    · refine (Limits.pullback.lift_snd _ _ _).trans ?_
      refine Eq.trans ?_ (hPmS (Fr.symm : AlgebraicClosure F →ₐ[F] AlgebraicClosure F)).symm
      exact congrArg (fun φ : AlgebraicClosure F →+* AlgebraicClosure F =>
        Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          Spec.map (CommRingCat.ofHom φ)) (hco Fr.symm)
  have hFrob : ∀ j, (t j).left = wcLfdTowPm F X
      ((Fr.symm ^ j : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) :
        AlgebraicClosure F →ₐ[F] AlgebraicClosure F) := by
    intro j
    induction j with
    | zero => rw [ht0, pow_zero]; exact hId.symm
    | succ j ih =>
      rw [hts j]
      have e : (wcGeomFrob F X h ≫ t j).left = (wcGeomFrob F X h).left ≫ (t j).left := rfl
      refine e.trans ((congrArg₂ (fun x y => x ≫ y) hFrobL ih).trans ?_)
      refine (hComp _ _).trans ?_
      exact congrArg (wcLfdTowPm F X) (AlgHom.ext fun y => by rw [pow_succ']; rfl)
  have hIter : ∀ k n, (wcLfdIter (g k) n).left = wcLfdTowPm F X ((γk k) ^ n) := by
    intro k n
    induction n with
    | zero => exact hId.symm
    | succ n ih =>
      show wcLfdTowPm F X (γk k) ≫ (wcLfdIter (g k) n).left = _
      rw [ih, pow_succ']
      exact hComp _ _
  have hChar : s₀.left = wcLfdTowPm F X τ := by
    apply Limits.pullback.hom_ext
    · exact (MorphismProperty.Over.w s₀).trans (hPmF τ).symm
    · exact hτ.trans (hPmS τ).symm
  have hprop : ∀ k, IsProper (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (L k))))) := fun k => by
    first
      | infer_instance
      | exact MorphismProperty.pullback_snd (P := @IsProper) X.hom _ inferInstance
  refine ⟨D, a, b, g, V, ι, ?C1, ?C2, ?C3, ?C4, ?C5, ?C6, ?C7, ?C8, ?C9, ?C10, ?C11, ?C12, ?C13,
    ?C14, ?C15, ?C16, ?C17⟩
  case C1 =>
    exact fun k => MorphismProperty.Over.Hom.ext ((hComp (τk k) (L k).val).trans
      ((congrArg (wcLfdTowPm F X) (A1 k)).trans hChar.symm))
  case C2 =>
    exact fun k => MorphismProperty.Over.Hom.ext
      (((congrArg (fun x => x ≫ wcLfdTowPm F X (L k).val) (hFrob _)).trans (hComp _ _)).trans
        ((congrArg (wcLfdTowPm F X) (A2 k)).trans (hComp (γk k) (L k).val).symm))
  case C3 =>
    exact fun k j => MorphismProperty.Over.Hom.ext
      ((hComp (IntermediateField.inclusion (hLmono k j)) (L (k + j)).val).trans
        (congrArg (wcLfdTowPm F X) (A3 k j)))
  case C4 =>
    exact fun k j => MorphismProperty.Over.Hom.ext
      ((hComp (τk k) (IntermediateField.inclusion (hLmono k j))).trans
        (congrArg (wcLfdTowPm F X) (A4 k j)))
  case C5 =>
    exact fun k j => MorphismProperty.Over.Hom.ext
      ((hComp (IntermediateField.inclusion (hLmono k j)) (γk (k + j))).trans
        ((congrArg (wcLfdTowPm F X) (A5 k j)).trans
          (hComp (γk k) (IntermediateField.inclusion (hLmono k j))).symm))
  case C6 =>
    exact fun k => MorphismProperty.Over.Hom.ext
      ((hIter k _).trans ((congrArg (wcLfdTowPm F X) (hγN k)).trans hId))
  case C7 =>
    exact fun k => MorphismProperty.Over.Hom.ext
      ((hComp (τk k) (γk k)).trans (congrArg (wcLfdTowPm F X) (A6 k)))
  case C8 =>
    exact fun k => (wc_lfd_basechange_props F X E (L k) (τk k) (wcLfdTowPm F X (τk k))
