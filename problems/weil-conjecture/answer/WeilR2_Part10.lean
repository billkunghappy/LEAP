    fun f V O h hh => Limits.pullback.lift_snd _ _ _

  have s1 : ∀ {Z Y : Scheme.{u}} (f : Z ⟶ Y)
      (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (V : Y.Etale) (O O' : Z.Etale) (k : O' ⟶ O) (h : O.left ⟶ V.left)
      (hh : h ≫ V.hom = O.hom ≫ f) (h' : O'.left ⟶ V.left) (hh' : h' ≫ V.hom = O'.hom ≫ f),
      k.left ≫ h = h' → ∀ x : A.obj.obj (Opposite.op V),
      (((wcEtInv f).obj A).obj.map k.op).hom (wcEtInvRho f A V O h hh x) =
        wcEtInvRho f A V O' h' hh' x := by
    intro Z Y f A V O O' k h hh h' hh' hk x
    have hl : k ≫ wcEtInvLift f V O h hh = wcEtInvLift f V O' h' hh' := by
      apply MorphismProperty.Over.Hom.ext
      apply Limits.pullback.hom_ext
      · exact (Category.assoc _ _ _).trans
          (((congrArg (fun q => k.left ≫ q) (lf f V O h hh)).trans hk).trans (lf f V O' h' hh').symm)
      · exact (Category.assoc _ _ _).trans
          (((congrArg (fun q => k.left ≫ q) (ls f V O h hh)).trans
            (MorphismProperty.Over.w k)).trans (ls f V O' h' hh').symm)
    show ((sheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange f).op.lan.obj A.obj)).map k.op).hom
        (((toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange f).op.lan.obj A.obj)).app
          (Opposite.op O)).hom
          ((((wcEtBaseChange f).op.lan.obj A.obj).map (wcEtInvLift f V O h hh).op).hom
            ((((wcEtBaseChange f).op.lanUnit.app A.obj).app (Opposite.op V)).hom x))) =
      ((toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange f).op.lan.obj A.obj)).app
          (Opposite.op O')).hom
          ((((wcEtBaseChange f).op.lan.obj A.obj).map (wcEtInvLift f V O' h' hh').op).hom
            ((((wcEtBaseChange f).op.lanUnit.app A.obj).app (Opposite.op V)).hom x))
    rw [← NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology Z)
      ((wcEtBaseChange f).op.lan.obj A.obj)) k.op, ← hl, op_comp, CategoryTheory.Functor.map_comp]
    rfl
  have bcf : ∀ {Z Y : Scheme.{u}} (f : Z ⟶ Y) {V₁ V₂ : Y.Etale} (a : V₁ ⟶ V₂),
      ((wcEtBaseChange f).map a).left ≫ Limits.pullback.fst V₂.hom f =
        Limits.pullback.fst V₁.hom f ≫ a.left := by
    intro Z Y f V₁ V₂ a; exact Limits.pullback.lift_fst _ _ _
  have LE : ∀ {Z Y : Scheme.{u}} (f : Z ⟶ Y) (V : Y.Etale) (O : Z.Etale)
      (k₁ k₂ : O ⟶ (wcEtBaseChange f).obj V),
      k₁.left ≫ Limits.pullback.fst V.hom f = k₂.left ≫ Limits.pullback.fst V.hom f → k₁ = k₂ := by
    intro Z Y f V O k₁ k₂ hk
    apply MorphismProperty.Over.Hom.ext
    apply Limits.pullback.hom_ext hk
    exact (MorphismProperty.Over.w k₁).trans (MorphismProperty.Over.w k₂).symm

  have s2 : ∀ {Z Y : Scheme.{u}} (f : Z ⟶ Y)
      (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (V₁ V₂ : Y.Etale) (a : V₁ ⟶ V₂) (O : Z.Etale) (h : O.left ⟶ V₁.left)
      (hh : h ≫ V₁.hom = O.hom ≫ f) (h' : O.left ⟶ V₂.left) (hh' : h' ≫ V₂.hom = O.hom ≫ f),
      h ≫ a.left = h' → ∀ x : A.obj.obj (Opposite.op V₂),
      wcEtInvRho f A V₁ O h hh ((A.obj.map a.op).hom x) = wcEtInvRho f A V₂ O h' hh' x := by
    intro Z Y f A V₁ V₂ a O h hh h' hh' ha x
    have hl : wcEtInvLift f V₁ O h hh ≫ (wcEtBaseChange f).map a = wcEtInvLift f V₂ O h' hh' := by
      apply LE
      exact (Category.assoc (wcEtInvLift f V₁ O h hh).left ((wcEtBaseChange f).map a).left
        (Limits.pullback.fst V₂.hom f)).trans
        ((congrArg (fun q => (wcEtInvLift f V₁ O h hh).left ≫ q) (bcf f a)).trans
        (((Category.assoc _ _ _).symm.trans (congrArg (· ≫ a.left) (lf f V₁ O h hh))).trans
          (ha.trans (lf f V₂ O h' hh').symm)))
    show ((toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange f).op.lan.obj A.obj)).app
          (Opposite.op O)).hom
          ((((wcEtBaseChange f).op.lan.obj A.obj).map (wcEtInvLift f V₁ O h hh).op).hom
            ((((wcEtBaseChange f).op.lanUnit.app A.obj).app (Opposite.op V₁)).hom
              ((A.obj.map a.op).hom x))) =
      ((toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange f).op.lan.obj A.obj)).app
          (Opposite.op O)).hom
          ((((wcEtBaseChange f).op.lan.obj A.obj).map (wcEtInvLift f V₂ O h' hh').op).hom
            ((((wcEtBaseChange f).op.lanUnit.app A.obj).app (Opposite.op V₂)).hom x))
    refine (congrArg (fun v => ((toSheafify (Scheme.smallEtaleTopology Z)
      ((wcEtBaseChange f).op.lan.obj A.obj)).app (Opposite.op O)).hom
        ((((wcEtBaseChange f).op.lan.obj A.obj).map (wcEtInvLift f V₁ O h hh).op).hom v))
      (NatTrans.naturality_apply ((wcEtBaseChange f).op.lanUnit.app A.obj) a.op x)).trans ?_
    rw [← hl, op_comp, CategoryTheory.Functor.map_comp]
    rfl

  have U : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (G : C ⥤ D)
      (J : GrothendieckTopology C) (K : GrothendieckTopology D) [G.IsContinuous J K]
      [∀ F : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}, G.op.HasLeftKanExtension F]
      [HasWeakSheafify K AddCommGrpCat.{u+1}] (F : Sheaf J AddCommGrpCat.{u+1}) (c : C)
      (x : F.obj.obj (Opposite.op c)),
      (((Functor.sheafPullbackConstruction.sheafAdjunctionContinuous G AddCommGrpCat.{u+1} J K).unit.app
          F).hom.app (Opposite.op c)).hom x =
        ((toSheafify K (G.op.lan.obj F.obj)).app (Opposite.op (G.obj c))).hom
          (((G.op.lanUnit.app F.obj).app (Opposite.op c)).hom x) := by
    intro C D _ _ G J K _ _ _ F c x
    have h := Adjunction.map_restrictFullyFaithful_unit_app
      ((G.op.lanAdjunction AddCommGrpCat.{u+1}).comp (sheafificationAdjunction K AddCommGrpCat.{u+1}))
