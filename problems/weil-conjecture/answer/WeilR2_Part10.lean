      ((NatTrans.naturality_apply ψ.hom
        (wcEtInvLift e V O₂ (h₂ ≫ h₁) (hh12 V O₁ h₁ hh₁ O₂ h₂ hh₂)).op _).trans
      ((congrArg (fun v => (B.obj.map
        (wcEtInvLift e V O₂ (h₂ ≫ h₁) (hh12 V O₁ h₁ hh₁ O₂ h₂ hh₂)).op).hom v)
