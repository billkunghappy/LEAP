    MorphismProperty.Over.homMk (Ok k).ι rfl trivial

  have A1 : ∀ k, (L k).val.comp (τk k) = τ := fun k => by apply AlgHom.ext; intro e; rfl
  have A2 : ∀ k, ((Fr.symm ^ Module.finrank F E : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) :
