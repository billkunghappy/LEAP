  refine ⟨fun w => ?_, fun z hz => ?_⟩
  ·
    obtain ⟨fw, hfw⟩ := (wc_etInv_unit_hom_eval_bij (a k).left ((wcEtInv (a k).left).obj H)).2 w
    obtain ⟨l', y', hy'⟩ := cs (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ fw)
    obtain ⟨f', rfl⟩ := (@Abelian.Ext.mk₀_bijective _ _ _ (HasExt.standard _) _ _).2 y'
    obtain ⟨hP1, hP2⟩ := wc_et_inv_ext_pull_degree0_eval (a (k + l')).left
      (D.map (homOfLE (Nat.le_add_right k l')).op).left (a k).left
      (hAL k (k + l') (Nat.le_add_right k l')) H f'
    have hΦ := (@Abelian.Ext.mk₀_bijective _ _ _ (HasExt.standard _) _ _).1 (hP1.symm.trans hy')
    refine ⟨k + l', Nat.le_add_right k l',
      (f'.hom.app (Opposite.op (wcEtTop (D.obj (Opposite.op (k + l'))).left))).hom
        (wcEtInvRho (D.map (homOfLE (Nat.le_add_right k l')).op).left
          (wcEtUnitSheaf (D.obj (Opposite.op k)).left)
          (wcEtTop (D.obj (Opposite.op k)).left) (wcEtTop (D.obj (Opposite.op (k + l'))).left)
          (D.map (homOfLE (Nat.le_add_right k l')).op).left
          ((Category.comp_id _).trans (Category.id_comp _).symm)
          (wcConstSec (D.obj (Opposite.op k)).left (ULift.{u+1} ℤ)
            (wcEtTop (D.obj (Opposite.op k)).left) (ULift.up 1))),
      fun he => ?_⟩
    rw [← hfw, ← hΦ]
    refine (congrArg (fun x => ((wcEtInvCompInv (a (k + l')).left
      (D.map (homOfLE (Nat.le_add_right k l')).op).left (a k).left he H).hom.app
        (Opposite.op (wcEtTop Uinf.left))).hom x) hP2).trans ?_
    exact hI _ _ _ he H _ _
  ·
    obtain ⟨f₀, hf₀⟩ := (wc_etInv_unit_hom_eval_bij (D.map (homOfLE (Nat.le_add_right k 0)).op).left
        ((wcEtInv (D.map (homOfLE (Nat.le_add_right k 0)).op).left).obj H)).2
      (wcEtInvRho (D.map (homOfLE (Nat.le_add_right k 0)).op).left H
        (wcEtTop (D.obj (Opposite.op k)).left)
        (wcEtTop (D.obj (Opposite.op (k + 0))).left) (D.map (homOfLE (Nat.le_add_right k 0)).op).left
        ((Category.comp_id _).trans (Category.id_comp _).symm) z)
    obtain ⟨hQ1, hQ2⟩ := wc_et_inv_ext_pull_degree0_eval (a (k + 0)).left
      (D.map (homOfLE (Nat.le_add_right k 0)).op).left (a k).left
      (hAL k (k + 0) (Nat.le_add_right k 0)) H f₀
    have hΦ0 : wcEtInvCompInv (a (k + 0)).left (D.map (homOfLE (Nat.le_add_right k 0)).op).left
          (a k).left (hAL k (k + 0) (Nat.le_add_right k 0)) (wcEtUnitSheaf (D.obj (Opposite.op k)).left) ≫
        (wcEtInv (a (k + 0)).left).map f₀ ≫
          wcEtInvComp (a (k + 0)).left (D.map (homOfLE (Nat.le_add_right k 0)).op).left (a k).left
            (hAL k (k + 0) (Nat.le_add_right k 0)) H = 0 := by
      apply (wc_etInv_unit_hom_eval_bij (a k).left ((wcEtInv (a k).left).obj H)).1
      refine hQ2.trans (Eq.trans ?_ (hev0 _ _).symm)
      rw [hf₀]
      exact (hC _ _ _ _ H z).trans hz
    have hpull0 := hQ1.trans ((congrArg (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _) hΦ0).trans
      (@Abelian.Ext.mk₀_zero _ _ _ (HasExt.standard _) _ _))
    obtain ⟨j, hj⟩ := ci 0 (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ f₀) hpull0
    obtain ⟨hR1, hR2⟩ := wc_et_inv_ext_pull_degree0_eval
      (D.map (homOfLE (Nat.add_le_add_left (Nat.le_add_right 0 j) k)).op).left
      (D.map (homOfLE (Nat.le_add_right k 0)).op).left
      (D.map (homOfLE (Nat.le_add_right k (0 + j))).op).left
      (hDD k (k + 0) (k + (0 + j)) (Nat.le_add_right k 0)
        (Nat.add_le_add_left (Nat.le_add_right 0 j) k)) H f₀
    have hΦ1 := (@Abelian.Ext.mk₀_bijective _ _ _ (HasExt.standard _) _ _).1
      (hR1.symm.trans (hj.trans (@Abelian.Ext.mk₀_zero _ _ _ (HasExt.standard _) _ _).symm))
    refine ⟨k + (0 + j), Nat.le_add_right k (0 + j), ?_⟩
    have h2 := congrArg (fun m : (wcEtInv (D.map (homOfLE (Nat.le_add_right k (0 + j))).op).left).obj
        (wcEtUnitSheaf (D.obj (Opposite.op k)).left) ⟶
          (wcEtInv (D.map (homOfLE (Nat.le_add_right k (0 + j))).op).left).obj H =>
      (m.hom.app (Opposite.op (wcEtTop (D.obj (Opposite.op (k + (0 + j)))).left))).hom
        (wcEtInvRho (D.map (homOfLE (Nat.le_add_right k (0 + j))).op).left
          (wcEtUnitSheaf (D.obj (Opposite.op k)).left)
          (wcEtTop (D.obj (Opposite.op k)).left) (wcEtTop (D.obj (Opposite.op (k + (0 + j)))).left)
          (D.map (homOfLE (Nat.le_add_right k (0 + j))).op).left
          ((Category.comp_id _).trans (Category.id_comp _).symm)
          (wcConstSec (D.obj (Opposite.op k)).left (ULift.{u+1} ℤ)
            (wcEtTop (D.obj (Opposite.op k)).left) (ULift.up 1)))) hΦ1
    refine Eq.trans ?_ (h2.trans (hev0 _ _))
    refine Eq.trans ?_ hR2.symm
    rw [hf₀]
    exact (hC _ _ _ _ H z).symm

theorem wc_et_sys_degree0_continuity (S : Scheme.{u}) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left)
    (A : wcEtSys D a) (hA : wcEtSysOK A) :
    wcEtSysCont A 0 :=
by
  classical

  have hhom : ∀ k l (f g : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k), f = g := fun k l f g =>
    Quiver.Hom.unop_inj (Subsingleton.elim _ _)
  have heA : ∀ k l (h : k ≤ l), (a l).left ≫ (D.map (homOfLE h).op).left = (a k).left := by
    intro k l h
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
    exact congrArg (fun t => t.left) (ha k j)
  have heD : ∀ k l m (h₁ : k ≤ l) (h₂ : l ≤ m),
      (D.map (homOfLE h₂).op).left ≫ (D.map (homOfLE h₁).op).left =
        (D.map (homOfLE (h₁.trans h₂)).op).left := by
    intro k l m h₁ h₂
    refine (congrArg (fun t => t.left) (D.map_comp (homOfLE h₂).op (homOfLE h₁).op).symm).trans ?_
    exact congrArg (fun f => (D.map f).left) (hhom _ _ _ _)

  have hcomp : ∀ {X : Scheme.{u}} {F G K : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
      (f : F ⟶ G) (g : G ⟶ K) (O : X.Etale) (x : F.obj.obj (Opposite.op O)),
      ((f ≫ g).hom.app (Opposite.op O)).hom x =
        (g.hom.app (Opposite.op O)).hom ((f.hom.app (Opposite.op O)).hom x) :=
    fun _ _ _ _ => rfl
  have hzero : ∀ {X : Scheme.{u}} {F G : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
      (O : X.Etale) (x : F.obj.obj (Opposite.op O)),
      (((0 : F ⟶ G)).hom.app (Opposite.op O)).hom x = 0 :=
    fun _ _ => rfl

  have hCI : ∀ {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y) (e : Z' ⟶ Y) (he : t ≫ g = e)
      (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (x : F.obj.obj (Opposite.op (wcEtTop Y))),
      ((wcEtInvCompInv t g e he F).hom.app (Opposite.op (wcEtTop Z'))).hom
          (wcEtInvRho e F (wcEtTop Y) (wcEtTop Z') e
            ((Category.comp_id _).trans (Category.id_comp _).symm) x) =
        wcEtInvRho t ((wcEtInv g).obj F) (wcEtTop Z) (wcEtTop Z') t
          ((Category.comp_id _).trans (Category.id_comp _).symm)
          (wcEtInvRho g F (wcEtTop Y) (wcEtTop Z) g
            ((Category.comp_id _).trans (Category.id_comp _).symm) x) := by
    intro Z' Z Y t g e he F x
    subst he
    exact (wc_etInvComp_spec t g _ rfl F).2 (wcEtTop Y) (wcEtTop Z) g
      ((Category.comp_id _).trans (Category.id_comp _).symm) (wcEtTop Z') t
      ((Category.comp_id _).trans (Category.id_comp _).symm) x

  obtain ⟨θ, hθdef⟩ : ∃ θ : ∀ k l, k ≤ l →
      ((wcEtInv (a k).left).obj (A.F k) ⟶ (wcEtInv (a l).left).obj (A.F l)),
      ∀ k l (h : k ≤ l), θ k l h =
        wcEtInvCompInv (a l).left (D.map (homOfLE h).op).left (a k).left (heA k l h) (A.F k) ≫
          (wcEtInv (a l).left).map (A.φ k l h) := ⟨_, fun _ _ _ => rfl⟩
  have hθ : ∀ k l m (h₁ : k ≤ l) (h₂ : l ≤ m), θ k l h₁ ≫ θ l m h₂ = θ k m (h₁.trans h₂) := by
    intro k l m h₁ h₂
    have e3 := (wc_etInvCompInv_natural (a m).left (D.map (homOfLE h₂).op).left (a l).left
      (heA l m h₂) (A.φ k l h₁)).symm
    have e4 := wc_etInvCompInv_assoc (a m).left (D.map (homOfLE h₂).op).left
      (D.map (homOfLE h₁).op).left (a l).left (D.map (homOfLE (h₁.trans h₂)).op).left (a k).left
      (heA l m h₂) (heD k l m h₁ h₂) (heA k l h₁) (heA k m (h₁.trans h₂)) (A.F k)
    have e1 := hA.1 k l m h₁ h₂ (heD k l m h₁ h₂)
    rw [hθdef, hθdef, hθdef]
    simp only [Category.assoc]
    rw [← reassoc_of% e3, reassoc_of% e4, ← Functor.map_comp, ← Functor.map_comp, e1]
  have hcone : ∀ k l (h : k ≤ l), θ k l h ≫ A.ψ l = A.ψ k := by
    intro k l h
    rw [hθdef, Category.assoc]
    exact hA.2.1 k l h (heA k l h)
  have hLC2 : ∀ (k : ℕ) (V : Uinf.left.Etale)
      (t : ((wcEtInv (a k).left).obj (A.F k)).obj.obj (Opposite.op V)),
      ((A.ψ k).hom.app (Opposite.op V)).hom t = 0 →
      Sieve.generate (fun (V' : Uinf.left.Etale) (h : V' ⟶ V) =>
        ∃ (l : ℕ) (hkl : k ≤ l),
          ((θ k l hkl).hom.app (Opposite.op V')).hom
            ((((wcEtInv (a k).left).obj (A.F k)).obj.map h.op).hom t) = 0) ∈
        Scheme.smallEtaleTopology Uinf.left V := by
    intro k V t ht
    refine GrothendieckTopology.superset_covering _ ?_ (hA.2.2.2 k V t ht)
    refine (Sieve.generate_le_iff _ _).2 ?_
    rintro V' h ⟨l, hkl, he, hz⟩
    apply Sieve.le_generate
    refine ⟨l, hkl, ?_⟩
    rw [hθdef]
    exact hz
  have hcU := wc_lfd_limit_qcqs S D a ha hlim hqc haff
  obtain ⟨hS6surj, hS6inj⟩ := wc_et_nat_system_sections_colim Uinf.left
    (fun k => (wcEtInv (a k).left).obj (A.F k)) θ hθ A.Finf A.ψ hcone hA.2.2.1 hLC2
    (wcEtTop Uinf.left) hcU.1 hcU.2

  have surjΓ : ∀ s : A.Finf.obj.obj (Opposite.op (wcEtTop Uinf.left)), ∃ (k : ℕ)
      (x : (A.F k).obj.obj (Opposite.op (wcEtTop (D.obj (Opposite.op k)).left))),
      ((A.ψ k).hom.app (Opposite.op (wcEtTop Uinf.left))).hom
        (wcEtInvRho (a k).left (A.F k) (wcEtTop (D.obj (Opposite.op k)).left) (wcEtTop Uinf.left)
          (a k).left ((Category.comp_id _).trans (Category.id_comp _).symm) x) = s := by
    intro s
    obtain ⟨k, w, hw⟩ := hS6surj s
    obtain ⟨l, h, y, hy⟩ :=
      (wc_et_tower_pullback_sections S D a ha hlim hqc haff k (A.F k)).1 w
    refine ⟨l, ((A.φ k l h).hom.app (Opposite.op (wcEtTop (D.obj (Opposite.op l)).left))).hom y, ?_⟩
    have e1 := wc_etInvRho_natural (a l).left _ _ (A.φ k l h)
      (wcEtTop (D.obj (Opposite.op l)).left) (wcEtTop Uinf.left) (a l).left
      ((Category.comp_id _).trans (Category.id_comp _).symm) y
    have e2 := hy (heA k l h)
    rw [← hw, ← hcone k l h, hθdef]
    refine (congrArg ((A.ψ l).hom.app (Opposite.op (wcEtTop Uinf.left))).hom e1).symm.trans ?_
    refine (congrArg (fun z => ((A.ψ l).hom.app (Opposite.op (wcEtTop Uinf.left))).hom
      ((((wcEtInv (a l).left).map (A.φ k l h)).hom.app (Opposite.op (wcEtTop Uinf.left))).hom z))
      e2).symm.trans ?_
    rfl

  have injΓ : ∀ (k : ℕ) (x : (A.F k).obj.obj (Opposite.op (wcEtTop (D.obj (Opposite.op k)).left))),
      ((A.ψ k).hom.app (Opposite.op (wcEtTop Uinf.left))).hom
        (wcEtInvRho (a k).left (A.F k) (wcEtTop (D.obj (Opposite.op k)).left) (wcEtTop Uinf.left)
          (a k).left ((Category.comp_id _).trans (Category.id_comp _).symm) x) = 0 →
      ∃ (m : ℕ) (h : k ≤ m),
        ((A.φ k m h).hom.app (Opposite.op (wcEtTop (D.obj (Opposite.op m)).left))).hom
          (wcEtInvRho (D.map (homOfLE h).op).left (A.F k) (wcEtTop (D.obj (Opposite.op k)).left)
            (wcEtTop (D.obj (Opposite.op m)).left) (D.map (homOfLE h).op).left
            ((Category.comp_id _).trans (Category.id_comp _).symm) x) = 0 := by
    intro k x hx
    obtain ⟨l, hkl, hl⟩ := hS6inj k _ hx
    rw [hθdef, hcomp, hCI] at hl
    have eN1 := wc_etInvRho_natural (a l).left _ _ (A.φ k l hkl)
      (wcEtTop (D.obj (Opposite.op l)).left) (wcEtTop Uinf.left) (a l).left
      ((Category.comp_id _).trans (Category.id_comp _).symm)
      (wcEtInvRho (D.map (homOfLE hkl).op).left (A.F k) (wcEtTop (D.obj (Opposite.op k)).left)
        (wcEtTop (D.obj (Opposite.op l)).left) (D.map (homOfLE hkl).op).left
        ((Category.comp_id _).trans (Category.id_comp _).symm) x)
    have hl' := eN1.symm.trans hl
    obtain ⟨m, hlm, hm⟩ :=
      (wc_et_tower_pullback_sections S D a ha hlim hqc haff l (A.F l)).2 _ hl'
    refine ⟨m, hkl.trans hlm, ?_⟩
    have e1 := hA.1 k l m hkl hlm (heD k l m hkl hlm)
    have e2 := congrArg (fun f => (f.hom.app (Opposite.op (wcEtTop (D.obj (Opposite.op m)).left))).hom
      (wcEtInvRho (D.map (homOfLE (hkl.trans hlm)).op).left (A.F k)
        (wcEtTop (D.obj (Opposite.op k)).left)
        (wcEtTop (D.obj (Opposite.op m)).left) (D.map (homOfLE (hkl.trans hlm)).op).left
        ((Category.comp_id _).trans (Category.id_comp _).symm) x)) e1
    have e3 := hCI (D.map (homOfLE hlm).op).left (D.map (homOfLE hkl).op).left
      (D.map (homOfLE (hkl.trans hlm)).op).left (heD k l m hkl hlm) (A.F k) x
    have e4 := wc_etInvRho_natural (D.map (homOfLE hlm).op).left _ _ (A.φ k l hkl)
      (wcEtTop (D.obj (Opposite.op l)).left) (wcEtTop (D.obj (Opposite.op m)).left)
      (D.map (homOfLE hlm).op).left ((Category.comp_id _).trans (Category.id_comp _).symm)
      (wcEtInvRho (D.map (homOfLE hkl).op).left (A.F k) (wcEtTop (D.obj (Opposite.op k)).left)
        (wcEtTop (D.obj (Opposite.op l)).left) (D.map (homOfLE hkl).op).left
        ((Category.comp_id _).trans (Category.id_comp _).symm) x)
    refine e2.symm.trans ?_
    refine (congrArg (fun z =>
      ((A.φ l m hlm).hom.app (Opposite.op (wcEtTop (D.obj (Opposite.op m)).left))).hom
        ((((wcEtInv (D.map (homOfLE hlm).op).left).map (A.φ k l hkl)).hom.app
          (Opposite.op (wcEtTop (D.obj (Opposite.op m)).left))).hom z)) e3).trans ?_
    refine (congrArg (fun z =>
      ((A.φ l m hlm).hom.app (Opposite.op (wcEtTop (D.obj (Opposite.op m)).left))).hom z) e4).trans ?_
    refine (congrArg (fun z =>
      ((A.φ l m hlm).hom.app (Opposite.op (wcEtTop (D.obj (Opposite.op m)).left))).hom z) hm).trans ?_
    exact map_zero _

  have hEV : ∀ {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y) (e : Z' ⟶ Y) (he : t ≫ g = e)
      (F : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (F' : Sheaf (Scheme.smallEtaleTopology Z') AddCommGrpCat.{u+1})
      (φ : (wcEtInv t).obj F ⟶ F') (f : (wcEtInv g).obj (wcEtUnitSheaf Y) ⟶ F),
      ((wcEtInvCompInv t g e he (wcEtUnitSheaf Y) ≫ (wcEtInv t).map f ≫ φ).hom.app
          (Opposite.op (wcEtTop Z'))).hom
        (wcEtInvRho e (wcEtUnitSheaf Y) (wcEtTop Y) (wcEtTop Z') e
          ((Category.comp_id _).trans (Category.id_comp _).symm)
          (wcConstSec Y (ULift.{u+1} ℤ) (wcEtTop Y) (ULift.up 1))) =
      (φ.hom.app (Opposite.op (wcEtTop Z'))).hom
        (wcEtInvRho t F (wcEtTop Z) (wcEtTop Z') t
          ((Category.comp_id _).trans (Category.id_comp _).symm)
          ((f.hom.app (Opposite.op (wcEtTop Z))).hom
            (wcEtInvRho g (wcEtUnitSheaf Y) (wcEtTop Y) (wcEtTop Z) g
              ((Category.comp_id _).trans (Category.id_comp _).symm)
              (wcConstSec Y (ULift.{u+1} ℤ) (wcEtTop Y) (ULift.up 1))))) := by
    intro Z' Z Y t g e he F F' φ f
    rw [hcomp, hcomp, hCI]
    exact congrArg (fun z => (φ.hom.app (Opposite.op (wcEtTop Z'))).hom z)
      (wc_etInvRho_natural t ((wcEtInv g).obj (wcEtUnitSheaf Y)) F f (wcEtTop Z) (wcEtTop Z') t
        ((Category.comp_id _).trans (Category.id_comp _).symm) _)
  refine ⟨fun e => ?_, fun k y hy => ?_⟩
  · obtain ⟨finf, rfl⟩ := (@Abelian.Ext.mk₀_bijective _ _ _ (HasExt.standard _) _ _).2 e
    obtain ⟨k, x, hx⟩ := surjΓ ((finf.hom.app (Opposite.op (wcEtTop Uinf.left))).hom
      (wcEtInvRho Uinf.hom (wcEtUnitSheaf S) (wcEtTop S) (wcEtTop Uinf.left) Uinf.hom
        ((Category.comp_id _).trans (Category.id_comp _).symm)
        (wcConstSec S (ULift.{u+1} ℤ) (wcEtTop S) (ULift.up 1))))
    obtain ⟨f, hf⟩ := (wc_etInv_unit_hom_eval_bij (D.obj (Opposite.op k)).hom (A.F k)).2 x
    refine ⟨k, @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ f, ?_⟩
    rw [wc_et_sys_pull_degree0]
    congr 1
    refine (wc_etInv_unit_hom_eval_bij Uinf.hom A.Finf).1 _ _ ?_
    refine (hEV (a k).left (D.obj (Opposite.op k)).hom Uinf.hom (MorphismProperty.Over.w (a k))
      (A.F k) A.Finf (A.ψ k) f).trans ?_
    refine (congrArg (fun z => ((A.ψ k).hom.app (Opposite.op (wcEtTop Uinf.left))).hom
      (wcEtInvRho (a k).left (A.F k) (wcEtTop (D.obj (Opposite.op k)).left) (wcEtTop Uinf.left)
        (a k).left ((Category.comp_id _).trans (Category.id_comp _).symm) z)) hf).trans ?_
    exact hx
  · obtain ⟨f, rfl⟩ := (@Abelian.Ext.mk₀_bijective _ _ _ (HasExt.standard _) _ _).2 y
    rw [wc_et_sys_pull_degree0] at hy
    have h0 := (@Abelian.Ext.mk₀_bijective _ _ _ (HasExt.standard _) _ _).1
      (hy.trans (@Abelian.Ext.mk₀_zero _ _ _ (HasExt.standard _) _ _).symm)
    have h1 := congrArg (fun m : (wcEtInv Uinf.hom).obj (wcEtUnitSheaf S) ⟶ A.Finf =>
      (m.hom.app (Opposite.op (wcEtTop Uinf.left))).hom
        (wcEtInvRho Uinf.hom (wcEtUnitSheaf S) (wcEtTop S) (wcEtTop Uinf.left) Uinf.hom
          ((Category.comp_id _).trans (Category.id_comp _).symm)
          (wcConstSec S (ULift.{u+1} ℤ) (wcEtTop S) (ULift.up 1)))) h0
    have h2 := (hEV (a k).left (D.obj (Opposite.op k)).hom Uinf.hom (MorphismProperty.Over.w (a k))
      (A.F k) A.Finf (A.ψ k) f).symm.trans (h1.trans (hzero _ _))
    obtain ⟨m, hkm, hm⟩ := injΓ k _ h2
