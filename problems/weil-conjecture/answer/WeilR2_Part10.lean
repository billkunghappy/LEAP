      (toSheafify_naturality (Scheme.smallEtaleTopology Z₀) ((wcEtBaseChange f').op.lan.map φ.hom))
    have e2 := NatTrans.naturality_apply ((wcEtBaseChange f').op.lan.map φ.hom)
      (wcEtInvLift f' V O h hh).op
      ((((wcEtBaseChange f').op.lanUnit.app A.obj).app (Opposite.op V)).hom x)
    have e3 := congrArg (fun k => (k.app (Opposite.op V)).hom x)
      ((wcEtBaseChange f').op.lanUnit.naturality φ.hom)
    exact e1.symm.trans (congrArg (fun v => ((toSheafify (Scheme.smallEtaleTopology Z₀)
      ((wcEtBaseChange f').op.lan.obj B.obj)).app (Opposite.op O)).hom v)
      (e2.trans (congrArg (fun v => (((wcEtBaseChange f').op.lan.obj B.obj).map
        (wcEtInvLift f' V O h hh).op).hom v) e3.symm)))

  have E0 : ∀ {Z₀ Y₀ : Scheme.{u}} (f' : Z₀ ⟶ Y₀)
      (A : Sheaf (Scheme.smallEtaleTopology Y₀) AddCommGrpCat.{u+1}) (V : Y₀.Etale) (O : Z₀.Etale)
