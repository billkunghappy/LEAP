    haveI := hprop k
    have hoi : IsOpenImmersion (Ok k).ι := inferInstance
    exact (wc_lfd_proper_field_qcqs (L k) _ (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (L k)))))).2.2 _ (Ok k).ι hoi
  case C15 =>
    intro T z hz
    have hzf : ∀ k, z k ≫ Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (L k)))) =
        z 0 ≫ Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (L 0)))) := by
      intro k
      have e : z (0 + k) ≫ wcLfdTowPm F X (IntermediateField.inclusion (hLmono 0 k)) = z 0 := hz 0 k
      have e2 := G1 (z (0 + k)) (z 0) _ _ _ (hPmF (IntermediateField.inclusion (hLmono 0 k))) e
      first
        | exact (Nat.zero_add k) ▸ e2
        | (rw [Nat.zero_add] at e2; exact e2)
        | simpa only [Nat.zero_add] using e2
    have hw : ∀ k j, (z (k + j) ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (L (k + j)))))) ≫
        Spec.map (CommRingCat.ofHom (IntermediateField.inclusion (hLmono k j)).toRingHom) =
        z k ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (L k)))) := by
      intro k j
      have e : z (k + j) ≫ wcLfdTowPm F X (IntermediateField.inclusion (hLmono k j)) = z k := hz k j
      exact G2 (z (k + j)) (z k) _ _ _ _ (hPmS (IntermediateField.inclusion (hLmono k j))) e
    obtain ⟨w₀, hw₀, hw₀u⟩ := wc_lfd_field_limit F (AlgebraicClosure F) L hLmono hLcov T
      (fun k => z k ≫ Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (L k))))) hw
    have hw0 : w₀ ≫ Spec.map (CommRingCat.ofHom (L 0).val.toRingHom) =
        z 0 ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (L 0)))) := hw₀ 0
    have hc : Spec.map (CommRingCat.ofHom (L 0).val.toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F (L 0))) =
        Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))) := by
      rw [← Spec.map_comp]
      congr 1
    have hcond : (z 0 ≫ Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (L 0))))) ≫ X.hom =
        w₀ ≫ Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))) :=
      G6 (z 0) _ _ w₀ _ _ _ _ Limits.pullback.condition hw0 hc
    refine ⟨Limits.pullback.lift _ _ hcond, fun k => ?_, fun z₁ hz₁ => ?_⟩
    · show Limits.pullback.lift _ _ hcond ≫ wcLfdTowPm F X (L k).val = z k
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hPmF, Limits.pullback.lift_fst]
        exact (hzf k).symm
      · rw [Category.assoc, hPmS, ← Category.assoc, Limits.pullback.lift_snd]
        exact hw₀ k
    · apply Limits.pullback.hom_ext
      · have e : z₁ ≫ wcLfdTowPm F X (L 0).val = z 0 := hz₁ 0
        exact (G1 z₁ (z 0) _ _ _ (hPmF (L 0).val) e).trans (Limits.pullback.lift_fst _ _ _).symm
      · have hall : ∀ k, (z₁ ≫ Limits.pullback.snd X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) ≫
            Spec.map (CommRingCat.ofHom (L k).val.toRingHom) =
            z k ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (L k)))) := by
          intro k
          have e : z₁ ≫ wcLfdTowPm F X (L k).val = z k := hz₁ k
          exact G2 z₁ (z k) _ _ _ _ (hPmS (L k).val) e
        exact (hw₀u _ hall).trans (Limits.pullback.lift_snd _ _ _).symm
  case C16 =>
    intro k
    haveI := hprop k
    obtain ⟨h1, h2, -⟩ := wc_lfd_proper_field_qcqs (L k) _ (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (L k)))))
    exact ⟨h1, h2⟩
  case C17 =>
    exact fun k j => (wc_lfd_basechange_props F X (L k) (L (k + j))
      (IntermediateField.inclusion (hLmono k j))
      (wcLfdTowPm F X (IntermediateField.inclusion (hLmono k j))) (hPmF _) (hPmS _)).2.2

theorem wc_lfd_ext_tower_five {C : Type*} [Category C] [Abelian C] [HasExt C] (T : C)
    (A B Q : ℕ → C) (Ainf Binf Qinf : C)
    (f : ∀ k, A k ⟶ B k) (g : ∀ k, B k ⟶ Q k) (w : ∀ k, f k ≫ g k = 0)
    (hS : ∀ k, (ShortComplex.mk (f k) (g k) (w k)).ShortExact)
    (finf : Ainf ⟶ Binf) (ginf : Binf ⟶ Qinf) (winf : finf ≫ ginf = 0)
    (hSinf : (ShortComplex.mk finf ginf winf).ShortExact)
    (αA : ∀ k, Ainf ⟶ A k) (αB : ∀ k, Binf ⟶ B k) (αQ : ∀ k, Qinf ⟶ Q k)
    (hfα : ∀ k, αA k ≫ f k = finf ≫ αB k) (hgα : ∀ k, αB k ≫ g k = ginf ≫ αQ k)
    (pA : ∀ k l, k ≤ l → (A l ⟶ A k)) (pB : ∀ k l, k ≤ l → (B l ⟶ B k))
    (pQ : ∀ k l, k ≤ l → (Q l ⟶ Q k))
    (hfp : ∀ k l (h : k ≤ l), pA k l h ≫ f k = f l ≫ pB k l h)
    (hgp : ∀ k l (h : k ≤ l), pB k l h ≫ g k = g l ≫ pQ k l h)
    (hαA : ∀ k l (h : k ≤ l), αA l ≫ pA k l h = αA k)
    (hαB : ∀ k l (h : k ≤ l), αB l ≫ pB k l h = αB k)
    (hαQ : ∀ k l (h : k ≤ l), αQ l ≫ pQ k l h = αQ k)
    (hpA : ∀ k l n (h₁ : k ≤ l) (h₂ : l ≤ n), pA l n h₂ ≫ pA k l h₁ = pA k n (h₁.trans h₂))
    (hpQ : ∀ k l n (h₁ : k ≤ l) (h₂ : l ≤ n), pQ l n h₂ ≫ pQ k l h₁ = pQ k n (h₁.trans h₂))
    (surjA : ∀ n (x : Abelian.Ext Ainf T n), ∃ k, ∃ y : Abelian.Ext (A k) T n,
       (Abelian.Ext.mk₀ (αA k)).comp y (zero_add n) = x)
    (injA : ∀ n k (y : Abelian.Ext (A k) T n), (Abelian.Ext.mk₀ (αA k)).comp y (zero_add n) = 0 →
       ∃ l, ∃ h : k ≤ l, (Abelian.Ext.mk₀ (pA k l h)).comp y (zero_add n) = 0)
    (surjB : ∀ n (x : Abelian.Ext Binf T n), ∃ k, ∃ y : Abelian.Ext (B k) T n,
       (Abelian.Ext.mk₀ (αB k)).comp y (zero_add n) = x)
    (injB : ∀ n k (y : Abelian.Ext (B k) T n), (Abelian.Ext.mk₀ (αB k)).comp y (zero_add n) = 0 →
       ∃ l, ∃ h : k ≤ l, (Abelian.Ext.mk₀ (pB k l h)).comp y (zero_add n) = 0)
    (i : ℕ) :
    (∀ x : Abelian.Ext Qinf T i, ∃ k, ∃ y : Abelian.Ext (Q k) T i,
       (Abelian.Ext.mk₀ (αQ k)).comp y (zero_add i) = x) ∧
    (∀ k (y : Abelian.Ext (Q k) T i), (Abelian.Ext.mk₀ (αQ k)).comp y (zero_add i) = 0 →
       ∃ l, ∃ h : k ≤ l, (Abelian.Ext.mk₀ (pQ k l h)).comp y (zero_add i) = 0) :=
by

  have F1 : ∀ {X Y Z : C} (φ : X ⟶ Y) (ψ : Y ⟶ Z) {n : ℕ} (z : Abelian.Ext Z T n),
      (Abelian.Ext.mk₀ φ).comp ((Abelian.Ext.mk₀ ψ).comp z (zero_add n)) (zero_add n) =
        (Abelian.Ext.mk₀ (φ ≫ ψ)).comp z (zero_add n) := by
    intro X Y Z φ ψ n z
    rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ φ) (Abelian.Ext.mk₀ ψ) z (zero_add 0)
      (zero_add n) (by omega), Abelian.Ext.mk₀_comp_mk₀]

  have Fsub : ∀ {X Y : C} (φ : X ⟶ Y) {n : ℕ} (z₁ z₂ : Abelian.Ext Y T n),
      (Abelian.Ext.mk₀ φ).comp (z₁ - z₂) (zero_add n) =
        (Abelian.Ext.mk₀ φ).comp z₁ (zero_add n) - (Abelian.Ext.mk₀ φ).comp z₂ (zero_add n) := by
    intro X Y φ n z₁ z₂
    rw [sub_eq_add_neg, Abelian.Ext.comp_add, Abelian.Ext.comp_neg, ← sub_eq_add_neg]

  have F0 : ∀ {X Y : C} {n : ℕ} (z : Abelian.Ext Y T n),
      (Abelian.Ext.mk₀ (0 : X ⟶ Y)).comp z (zero_add n) = 0 := by
    intro X Y n z
    rw [Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]

  have F4 : ∀ {S S' : ShortComplex C} (h₁ : S.ShortExact) (h₂ : S'.ShortExact) (τ : S ⟶ S')
      {n m : ℕ} (e : Abelian.Ext S'.X₁ T n) (h : 1 + n = m),
      h₁.extClass.comp ((Abelian.Ext.mk₀ τ.τ₁).comp e (zero_add n)) h =
        (Abelian.Ext.mk₀ τ.τ₃).comp (h₂.extClass.comp e h) (zero_add m) := by
    intro S S' h₁ h₂ τ n m e h
    rw [← Abelian.Ext.comp_assoc h₁.extClass (Abelian.Ext.mk₀ τ.τ₁) e (add_zero 1) (zero_add n)
      (by omega), h₁.extClass_naturality h₂ τ,
      Abelian.Ext.comp_assoc _ _ _ (zero_add 1) h (by omega)]

  have F5 : ∀ {S : ShortComplex C} (h₁ : S.ShortExact) {n m : ℕ} (z : Abelian.Ext S.X₂ T n)
      (h : 1 + n = m),
      h₁.extClass.comp ((Abelian.Ext.mk₀ S.f).comp z (zero_add n)) h = 0 := by
    intro S h₁ n m z h
    rw [← Abelian.Ext.comp_assoc h₁.extClass (Abelian.Ext.mk₀ S.f) z (add_zero 1) (zero_add n)
      (by omega), h₁.extClass_comp, Abelian.Ext.zero_comp]

  have F6 : ∀ {X Y : C} (g' : X ⟶ Y) (_ : Epi g') (r : Abelian.Ext Y T 0),
      (Abelian.Ext.mk₀ g').comp r (zero_add 0) = 0 → r = 0 := by
    intro X Y g' hg r hr
    obtain ⟨ρ, rfl⟩ := (Abelian.Ext.mk₀_bijective Y T).2 r
    rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_eq_zero_iff] at hr
    have hρ : ρ = 0 := (cancel_epi g').1 (by rw [hr, Limits.comp_zero])
    rw [hρ, Abelian.Ext.mk₀_zero]
  have F4inf : ∀ k {n m : ℕ} (e : Abelian.Ext (A k) T n) (h : 1 + n = m),
      hSinf.extClass.comp ((Abelian.Ext.mk₀ (αA k)).comp e (zero_add n)) h =
        (Abelian.Ext.mk₀ (αQ k)).comp ((hS k).extClass.comp e h) (zero_add m) :=
    fun k n m e h => F4 hSinf (hS k)
      (ShortComplex.homMk (αA k) (αB k) (αQ k) (hfα k) (hgα k)) e h
  have F4tow : ∀ k l (hkl : k ≤ l) {n m : ℕ} (e : Abelian.Ext (A k) T n) (h : 1 + n = m),
      (hS l).extClass.comp ((Abelian.Ext.mk₀ (pA k l hkl)).comp e (zero_add n)) h =
        (Abelian.Ext.mk₀ (pQ k l hkl)).comp ((hS k).extClass.comp e h) (zero_add m) :=
    fun k l hkl n m e h => F4 (hS l) (hS k)
      (ShortComplex.homMk (pA k l hkl) (pB k l hkl) (pQ k l hkl) (hfp k l hkl) (hgp k l hkl)) e h

  have Hsurj0 : ∀ n (r : Abelian.Ext Qinf T n), (Abelian.Ext.mk₀ ginf).comp r (zero_add n) = 0 →
      ∃ l, ∃ q : Abelian.Ext (Q l) T n, (Abelian.Ext.mk₀ (αQ l)).comp q (zero_add n) = r := by
    intro n
    cases n with
    | zero =>
      intro r hr
      have hepi : Epi ginf := hSinf.epi_g
      have hr0 := F6 ginf hepi r hr
      exact ⟨0, 0, by rw [hr0, Abelian.Ext.comp_zero]⟩
    | succ i₀ =>
      intro r hr
      have h1 : 1 + i₀ = i₀ + 1 := by omega
      obtain ⟨e, he⟩ := Abelian.Ext.contravariant_sequence_exact₃ hSinf T r hr h1
      obtain ⟨l', e', he'⟩ := surjA i₀ e
      refine ⟨l', (hS l').extClass.comp e' h1, ?_⟩
      rw [← F4inf l' e' h1, he', he]

  have Hinj0 : ∀ n l₁ (y₁ : Abelian.Ext (Q l₁) T n),
      (Abelian.Ext.mk₀ (g l₁)).comp y₁ (zero_add n) = 0 →
      (Abelian.Ext.mk₀ (αQ l₁)).comp y₁ (zero_add n) = 0 →
      ∃ l₃, ∃ h : l₁ ≤ l₃, (Abelian.Ext.mk₀ (pQ l₁ l₃ h)).comp y₁ (zero_add n) = 0 := by
    intro n
    cases n with
    | zero =>
      intro l₁ y₁ hg _
      have hepi : Epi (g l₁) := (hS l₁).epi_g
      have hy0 := F6 (g l₁) hepi y₁ hg
      exact ⟨l₁, le_refl _, by rw [hy0, Abelian.Ext.comp_zero]⟩
    | succ i₀ =>
      intro l₁ y₁ hg ha
      have h1 : 1 + i₀ = i₀ + 1 := by omega
      obtain ⟨e, he⟩ := Abelian.Ext.contravariant_sequence_exact₃ (hS l₁) T y₁ hg h1
      have hE : hSinf.extClass.comp ((Abelian.Ext.mk₀ (αA l₁)).comp e (zero_add i₀)) h1 = 0 := by
        rw [F4inf, he, ha]
      obtain ⟨b, hb⟩ := Abelian.Ext.contravariant_sequence_exact₁ hSinf T _ h1 hE
      change (Abelian.Ext.mk₀ finf).comp b (zero_add i₀) = _ at hb
      obtain ⟨l₂, b₂, hb₂⟩ := surjB i₀ b
      have h5 : (Abelian.Ext.mk₀ (αA l₁)).comp e (zero_add i₀) =
          (Abelian.Ext.mk₀ (αA l₂ ≫ f l₂)).comp b₂ (zero_add i₀) := by
        rw [← hb, ← hb₂, F1, hfα]
      have h₃ : l₁ ≤ max l₁ l₂ := le_max_left _ _
      have h₄ : l₂ ≤ max l₁ l₂ := le_max_right _ _
      have hm : αA (max l₁ l₂) ≫ f (max l₁ l₂) ≫ pB l₂ (max l₁ l₂) h₄ = αA l₂ ≫ f l₂ := by
        rw [← hfp, ← Category.assoc, hαA]
      have h6 : (Abelian.Ext.mk₀ (αA (max l₁ l₂))).comp
          ((Abelian.Ext.mk₀ (pA l₁ (max l₁ l₂) h₃)).comp e (zero_add i₀) -
            (Abelian.Ext.mk₀ (f (max l₁ l₂))).comp
              ((Abelian.Ext.mk₀ (pB l₂ (max l₁ l₂) h₄)).comp b₂ (zero_add i₀)) (zero_add i₀))
          (zero_add i₀) = 0 := by
        simp only [Fsub, F1]
        rw [hαA, hm, h5, sub_self]
      obtain ⟨l₃, h₅, hl₃⟩ := injA i₀ (max l₁ l₂) _ h6
      have hm2 : pA (max l₁ l₂) l₃ h₅ ≫ f (max l₁ l₂) ≫ pB l₂ (max l₁ l₂) h₄ =
          f l₃ ≫ pB (max l₁ l₂) l₃ h₅ ≫ pB l₂ (max l₁ l₂) h₄ := by
        rw [← Category.assoc, hfp, Category.assoc]
      have h7 : (Abelian.Ext.mk₀ (pA l₁ l₃ (h₃.trans h₅))).comp e (zero_add i₀) =
          (Abelian.Ext.mk₀ (f l₃)).comp
            ((Abelian.Ext.mk₀ (pB (max l₁ l₂) l₃ h₅ ≫ pB l₂ (max l₁ l₂) h₄)).comp b₂
              (zero_add i₀)) (zero_add i₀) := by
        rw [Fsub, sub_eq_zero] at hl₃
        simp only [F1] at hl₃ ⊢
        rw [hpA, hm2] at hl₃
        exact hl₃
      refine ⟨l₃, h₃.trans h₅, ?_⟩
      rw [← he, ← F4tow, h7]
      exact F5 (hS l₃) _ h1
  refine ⟨?_, ?_⟩
  · intro x
    obtain ⟨k, b', hb'⟩ := surjB i ((Abelian.Ext.mk₀ ginf).comp x (zero_add i))
    have hc : (Abelian.Ext.mk₀ (αA k)).comp ((Abelian.Ext.mk₀ (f k)).comp b' (zero_add i))
        (zero_add i) = 0 := by
      rw [F1, hfα k, ← F1, hb', F1, winf, F0]
    obtain ⟨l, h, hl⟩ := injA i k _ hc
    have hl' : (Abelian.Ext.mk₀ (f l)).comp ((Abelian.Ext.mk₀ (pB k l h)).comp b' (zero_add i))
        (zero_add i) = 0 := by
      rw [F1]
      rw [F1, hfp k l h] at hl
      exact hl
    obtain ⟨q, hq⟩ := Abelian.Ext.contravariant_sequence_exact₂ (hS l) T _ hl'
    change (Abelian.Ext.mk₀ (g l)).comp q (zero_add i) = _ at hq
    have hr : (Abelian.Ext.mk₀ ginf).comp (x - (Abelian.Ext.mk₀ (αQ l)).comp q (zero_add i))
        (zero_add i) = 0 := by
      rw [Fsub, F1, ← hgα l, ← F1, hq, F1, hαB k l h, hb', sub_self]
    obtain ⟨l', q'', hq''⟩ := Hsurj0 i _ hr
    refine ⟨max l l', (Abelian.Ext.mk₀ (pQ l (max l l') (le_max_left _ _))).comp q (zero_add i) +
      (Abelian.Ext.mk₀ (pQ l' (max l l') (le_max_right _ _))).comp q'' (zero_add i), ?_⟩
    rw [Abelian.Ext.comp_add, F1, F1, hαQ, hαQ, hq'']
    abel
  · intro k y hy
    have h1 : (Abelian.Ext.mk₀ (αB k)).comp ((Abelian.Ext.mk₀ (g k)).comp y (zero_add i))
        (zero_add i) = 0 := by
      rw [F1, hgα k, ← F1, hy, Abelian.Ext.comp_zero]
    obtain ⟨l₁, h₁, hl₁⟩ := injB i k _ h1
    have hy1g : (Abelian.Ext.mk₀ (g l₁)).comp ((Abelian.Ext.mk₀ (pQ k l₁ h₁)).comp y (zero_add i))
        (zero_add i) = 0 := by
      rw [F1, ← hgp k l₁ h₁, ← F1, hl₁]
    have hy1a : (Abelian.Ext.mk₀ (αQ l₁)).comp ((Abelian.Ext.mk₀ (pQ k l₁ h₁)).comp y (zero_add i))
        (zero_add i) = 0 := by
      rw [F1, hαQ, hy]
    obtain ⟨l₃, h, hl₃⟩ := Hinj0 i l₁ _ hy1g hy1a
    refine ⟨l₃, h₁.trans h, ?_⟩
    rw [← hpQ k l₁ l₃ h₁ h, ← F1]
    exact hl₃

theorem wc_lfd_open_subtower (S : Scheme.{u}) {B VB Uinf Vinf : S.ProEt}
    (ιB : VB ⟶ B)
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (b : ∀ k, D.obj (Opposite.op k) ⟶ B) (binf : Uinf ⟶ B)
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hDb : ∀ k j, D.map (homOfLE (Nat.le_add_right k j)).op ≫ b k = b (k + j))
    (hab : ∀ k, a k ≫ b k = binf)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left)
    (DV : ℕᵒᵖ ⥤ S.ProEt) (ι : ∀ k, DV.obj (Opposite.op k) ⟶ D.obj (Opposite.op k))
    (hι : ∀ k, IsOpenImmersion (ι k).left)
    (hrι : ∀ k, Set.range (ι k).left = (b k).left ⁻¹' Set.range ιB.left)
    (hcV : ∀ k, CompactSpace (DV.obj (Opposite.op k)).left)
    (hDV : ∀ k j, DV.map (homOfLE (Nat.le_add_right k j)).op ≫ ι k =
        ι (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op)
    (ιinf : Vinf ⟶ Uinf) (hιinf : IsOpenImmersion ιinf.left)
    (hrinf : Set.range ιinf.left = binf.left ⁻¹' Set.range ιB.left)
    (aV : ∀ k, Vinf ⟶ DV.obj (Opposite.op k)) (haV : ∀ k, aV k ≫ ι k = ιinf ≫ a k) :
    (∀ k j, aV (k + j) ≫ DV.map (homOfLE (Nat.le_add_right k j)).op = aV k) ∧
    (∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (DV.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (DV.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Vinf.left, ∀ k, z₀ ≫ (aV k).left = z k) ∧
    (∀ k, CompactSpace (DV.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (DV.obj (Opposite.op k)).left) ∧
    (∀ k j, IsAffineHom (DV.map (homOfLE (Nat.le_add_right k j)).op).left) :=
by
  classical
  have hpt : ∀ {P₁ P₂ P₃ : Scheme.{u}} (f : P₁ ⟶ P₂) (f' : P₂ ⟶ P₃) (f'' : P₁ ⟶ P₃),
      f ≫ f' = f'' → ∀ y, f' (f y) = f'' y := by
    intro P₁ P₂ P₃ f f' f'' e y
    rw [← e, Scheme.Hom.comp_apply]
  have hmonoL : ∀ k, Mono (ι k).left := by
    intro k
    haveI := hι k
    infer_instance
  have hmono : ∀ k {Z : S.ProEt} (g₁ g₂ : Z ⟶ DV.obj (Opposite.op k)),
      g₁ ≫ ι k = g₂ ≫ ι k → g₁ = g₂ := by
    intro k Z g₁ g₂ h
    haveI := hmonoL k
    apply MorphismProperty.Over.Hom.ext
    exact (cancel_mono (ι k).left).mp (congrArg (fun t => t.left) h)

  have h1 : ∀ k j, aV (k + j) ≫ DV.map (homOfLE (Nat.le_add_right k j)).op = aV k := by
    intro k j
    apply hmono k
    rw [Category.assoc, hDV k j, ← Category.assoc, haV (k + j), Category.assoc, ha k j, haV k]

  have h2 : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (DV.obj (Opposite.op k)).left),
      (∀ k j, z (k + j) ≫ (DV.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
      ∃! z₀ : T ⟶ Vinf.left, ∀ k, z₀ ≫ (aV k).left = z k := by
    intro T z hz
    have hz' : ∀ k j, (z (k + j) ≫ (ι (k + j)).left) ≫
        (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k ≫ (ι k).left := by
      intro k j
      have e : (DV.map (homOfLE (Nat.le_add_right k j)).op).left ≫ (ι k).left =
          (ι (k + j)).left ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left :=
        congrArg (fun t => t.left) (hDV k j)
      rw [Category.assoc, ← e, ← Category.assoc, hz k j]
    obtain ⟨z₀, hz₀, huniq⟩ := hlim T (fun k => z k ≫ (ι k).left) hz'
    have hz₀' : ∀ k, z₀ ≫ (a k).left = z k ≫ (ι k).left := hz₀
    have hab0 : (a 0).left ≫ (b 0).left = binf.left := congrArg (fun t => t.left) (hab 0)
    have H : Set.range z₀ ⊆ Set.range ιinf.left := by
      rintro _ ⟨p, rfl⟩
      rw [hrinf, Set.mem_preimage, ← hpt _ _ _ hab0, hpt z₀ (a 0).left _ (hz₀' 0) p,
        Scheme.Hom.comp_apply]
      have hv : (ι 0).left (z 0 p) ∈ Set.range (ι 0).left := ⟨z 0 p, rfl⟩
      rw [hrι 0] at hv
      exact hv
    haveI := hιinf
    refine ⟨IsOpenImmersion.lift ιinf.left z₀ H, ?_, ?_⟩
    · intro k
      haveI := hmonoL k
      apply (cancel_mono (ι k).left).mp
      have e : (aV k).left ≫ (ι k).left = ιinf.left ≫ (a k).left :=
        congrArg (fun t => t.left) (haV k)
      rw [Category.assoc, e, ← Category.assoc, IsOpenImmersion.lift_fac, hz₀' k]
    · intro w hw
      apply IsOpenImmersion.lift_uniq
      apply huniq
      intro k
      have e : (aV k).left ≫ (ι k).left = ιinf.left ≫ (a k).left :=
        congrArg (fun t => t.left) (haV k)
      show (w ≫ ιinf.left) ≫ (a k).left = z k ≫ (ι k).left
      rw [Category.assoc, ← e, ← Category.assoc, hw k]

  have h3 : ∀ k, CompactSpace (DV.obj (Opposite.op k)).left ∧
      QuasiSeparatedSpace (DV.obj (Opposite.op k)).left := by
    intro k
    haveI := (hqc k).2
    haveI := hι k
    exact ⟨hcV k, (Scheme.Hom.isOpenEmbedding (ι k).left).quasiSeparatedSpace⟩

  have h4 : ∀ k j, IsAffineHom (DV.map (homOfLE (Nat.le_add_right k j)).op).left := by
    intro k j
    haveI := hι k
    haveI := hι (k + j)
    have hsq : (ι (k + j)).left ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left =
        (DV.map (homOfLE (Nat.le_add_right k j)).op).left ≫ (ι k).left :=
      (congrArg (fun t => t.left) (hDV k j)).symm
    have hbt : (D.map (homOfLE (Nat.le_add_right k j)).op).left ≫ (b k).left =
        (b (k + j)).left := congrArg (fun t => t.left) (hDb k j)
    have hPB : IsPullback (DV.map (homOfLE (Nat.le_add_right k j)).op).left (ι (k + j)).left
        (ι k).left (D.map (homOfLE (Nat.le_add_right k j)).op).left := by
      refine IsOpenImmersion.isPullback _ _ _ _ hsq ?_
      apply TopologicalSpace.Opens.ext
      simp only [Scheme.Hom.coe_preimage, Scheme.Hom.coe_opensRange]
      rw [hrι k, hrι (k + j)]
      ext x
      simp only [Set.mem_preimage]
      rw [hpt _ _ _ hbt x]
    exact MorphismProperty.of_isPullback (P := @IsAffineHom) hPB.flip (haff k j)
  exact ⟨h1, h2, h3, h4⟩

theorem wc_root_twist_classical (S : Scheme.{u}) (m dd : ℕ) :
    ∃ G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1},
      Nonempty (wcRootTwist S m dd ≅ (wcEpsInv S).obj G) :=
by
  obtain ⟨ε, hε⟩ : ∃ ε : (wcEtToProEt S).op.lan.obj ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd) ⟶
      wcRootTwistPre S m dd,
      ε = ((wcEtToProEt S).op.lanAdjunction AddCommGrpCat.{u+1}).counit.app
        (wcRootTwistPre S m dd) := ⟨_, rfl⟩
  have hc1 : ∀ (T : S.ProEt) (V : S.Etale) (a : T ⟶ (wcEtToProEt S).obj V)
      (t : ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd).obj (Opposite.op V)),
      ε.app (Opposite.op T)
        (((wcEtToProEt S).op.lan.obj ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd)).map a.op
          ((((wcEtToProEt S).op.lanUnit.app ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd)).app
            (Opposite.op V)) t)) = (wcRootTwistPre S m dd).map a.op t := by
    intro T V a t
    have h := Functor.lanUnit_app_app_lanAdjunction_counit_app_app (wcEtToProEt S).op
      (wcRootTwistPre S m dd) (Opposite.op V)
    rw [← hε] at h
    have h2 := ConcreteCategory.congr_hom h t
    rw [CategoryTheory.comp_apply, CategoryTheory.id_apply] at h2
    rw [NatTrans.naturality_apply]
    exact congrArg (fun z => (wcRootTwistPre S m dd).map a.op z) h2
  have hnat : ∀ (V V' : S.Etale) (e : V' ⟶ V)
      (t : ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd).obj (Opposite.op V)),
      ((wcEtToProEt S).op.lan.obj ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd)).map
          ((wcEtToProEt S).map e).op
          ((((wcEtToProEt S).op.lanUnit.app ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd)).app
            (Opposite.op V)) t) =
        (((wcEtToProEt S).op.lanUnit.app ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd)).app
            (Opposite.op V')) (((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd).map e.op t) := by
    intro V V' e t
    exact (NatTrans.naturality_apply
      ((wcEtToProEt S).op.lanUnit.app ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd)) e.op t).symm
  have hbij : ∀ (A : S.Opens), IsAffineOpen A → ∀ W : S.ProEt, wcAffIndEt S A W →
      Function.Bijective (ConcreteCategory.hom (ε.app (Opposite.op W))) := by
    intro A hA W hW
    obtain ⟨Pr⟩ := wc_etPres_of_affIndEt S A hA W 0 (fun i => Fin.elim0 i) (fun i => Fin.elim0 i)
      hW (fun i => Fin.elim0 i)
    obtain ⟨hR, hΓs, hΓz⟩ := wc_rtc_pres_limit S W Pr.Λ Pr.U' Pr.φ Pr.hφ Pr.affU Pr.limU
    let R : Pr.Λᵒᵖ ⥤ CommRingCat.{u} :=
      (Pr.U' ⋙ Scheme.Etale.forget S ⋙ Over.forget S).op ⋙ Scheme.Γ
    have hRc : ∀ {l l' : Pr.Λ} (g : l ⟶ l'),
        R.map g.op ≫ (Pr.φ l).left.appTop = (Pr.φ l').left.appTop := by
      intro l l' g
      have e : (Pr.φ l').left = (Pr.φ l).left ≫ (Pr.U'.map g).left :=
        (congrArg (fun f => f.left) (Pr.hφ g)).symm
      have h := Scheme.Hom.comp_appTop (Pr.φ l).left (Pr.U'.map g).left
      rw [← e] at h
      exact h.symm
    obtain ⟨hS1, hK1⟩ := wc_rtc_roots_fin m Pr.Λ R Γ(W.left, ⊤) (fun l => (Pr.φ l).left.appTop)
      hRc hΓs hΓz
    have hMc : ∀ {l l' : Pr.Λ} (g : l ⟶ l'),
        (R ⋙ wcRootsFun.{u} m).map g.op ≫ (wcRootsFun.{u} m).map (Pr.φ l).left.appTop =
          (wcRootsFun.{u} m).map (Pr.φ l').left.appTop := by
      intro l l' g
      exact ((wcRootsFun.{u} m).map_comp _ _).symm.trans (congrArg (wcRootsFun.{u} m).map (hRc g))
    obtain ⟨hS2, hK2⟩ := wc_rtc_twist_fin m dd Pr.Λ (R ⋙ wcRootsFun.{u} m)
      ((wcRootsFun.{u} m).obj Γ(W.left, ⊤)) (fun l => (wcRootsFun.{u} m).map (Pr.φ l).left.appTop)
      hMc hS1 hK1
    have hFs : ∀ s : (wcRootTwistPre S m dd).obj (Opposite.op W), ∃ (l : Pr.Λ)
        (t : ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd).obj (Opposite.op (Pr.U'.obj l))),
        (wcRootTwistPre S m dd).map (Pr.φ l).op t = s := by
      intro s
      obtain ⟨l, x, hx⟩ := hS2 (ULift.down s)
      exact ⟨l, ULift.up x, congrArg ULift.up hx⟩
    have hFi : ∀ (l : Pr.Λ)
        (t : ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd).obj (Opposite.op (Pr.U'.obj l))),
        (wcRootTwistPre S m dd).map (Pr.φ l).op t = 0 → ∃ (l' : Pr.Λ) (g : l' ⟶ l),
          ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd).map (Pr.U'.map g).op t = 0 := by
      intro l t ht
      obtain ⟨l', g, hg⟩ := hK2 l (ULift.down t) (congrArg ULift.down ht)
      exact ⟨l', g, congrArg ULift.up hg⟩
    refine ⟨(injective_iff_map_eq_zero (ConcreteCategory.hom (ε.app (Opposite.op W)))).mpr ?_, ?_⟩
    · intro x hx
      obtain ⟨l₀⟩ : Nonempty Pr.Λ := IsCofiltered.nonempty
      obtain ⟨V₁, b, a, t, -, rfl⟩ :=
        (wc_lan_etale_rep S ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd) W).1
          (Pr.U'.obj l₀) (Pr.φ l₀) x
      obtain ⟨l, e, he⟩ := hR V₁ a
      subst he
      rw [op_comp, Functor.map_comp, CategoryTheory.comp_apply, hnat] at hx ⊢
      have h0 := (hc1 W (Pr.U'.obj l) (Pr.φ l) _).symm.trans hx
      obtain ⟨l', g, hg⟩ := hFi l _ h0
      rw [← Pr.hφ g, op_comp, Functor.map_comp, CategoryTheory.comp_apply, hnat, hg, map_zero,
        map_zero]
    · intro s
      obtain ⟨l, t, ht⟩ := hFs s
      exact ⟨_, (hc1 W _ (Pr.φ l) t).trans ht⟩
  haveI hsurj : Presheaf.IsLocallySurjective (Scheme.ProEt.topology S) ε := by
    apply Presheaf.IsLocallySurjective.mk
    intro U s
    apply GrothendieckTopology.superset_covering _ _ (wc_proet_affIndEt_covering S U)
    rw [Sieve.generate_le_iff]
    rintro T g ⟨A, hA, hT⟩
    rw [Presheaf.imageSieve_apply]
    exact (hbij A hA T hT).2 _
  haveI hinj : Presheaf.IsLocallyInjective (Scheme.ProEt.topology S) ε := by
    apply Presheaf.IsLocallyInjective.mk
    intro X x y hxy
    apply GrothendieckTopology.superset_covering _ _ (wc_proet_affIndEt_covering S X.unop)
    rw [Sieve.generate_le_iff]
    rintro T g ⟨A, hA, hT⟩
    rw [Presheaf.equalizerSieve_apply]
    apply (hbij A hA T hT).1
    have e1 := NatTrans.naturality_apply ε g.op x
    have e2 := NatTrans.naturality_apply ε g.op y
    exact e1.trans ((congrArg _ hxy).trans e2.symm)
  have hW : (Scheme.ProEt.topology S).W ε := GrothendieckTopology.W_of_isLocallyBijective _ ε
  rw [GrothendieckTopology.W_iff] at hW
  obtain ⟨e₁⟩ : Nonempty ((wcEpsInv S).obj ((presheafToSheaf (Scheme.smallEtaleTopology S)
      AddCommGrpCat.{u+1}).obj ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd)) ≅
      (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj
        ((wcEtToProEt S).op.lan.obj ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd))) := by
    haveI : (wcEtToProEt S).IsContinuous (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S) :=
      (wc_etToProEt_flat_cont S).2
    let adj₁ := ((wcEtToProEt S).op.lanAdjunction AddCommGrpCat.{u+1}).comp
      (sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    let adj₂' := (sheafificationAdjunction (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).comp
      (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt S)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S))
    let adj₂ := adj₂'.ofNatIsoRight (Functor.sheafPushforwardContinuousCompSheafToPresheafIso
      (wcEtToProEt S) AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S))
    exact ⟨(adj₂.leftAdjointUniq adj₁).app ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd)⟩
  exact ⟨(presheafToSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).obj
      ((wcEtToProEt S).op ⋙ wcRootTwistPre S m dd),
    ⟨(asIso ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map ε)).symm ≪≫
      e₁.symm⟩⟩

theorem wc_lfd_limit_qcqs (S : Scheme.{u}) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left) :
    CompactSpace Uinf.left ∧ QuasiSeparatedSpace Uinf.left :=
by
  classical
  have hsub : ∀ {k l : ℕ} (f : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k),
      ∃ h : k ≤ l, f = (homOfLE h).op := by
    intro k l f
    exact ⟨leOfHom f.unop, Quiver.Hom.unop_inj (Subsingleton.elim _ _)⟩
  have haL : ∀ k l (h : k ≤ l), a l ≫ D.map (homOfLE h).op = a k := by
    intro k l h
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
    exact ha k j
  have hnat : ∀ k l (f : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k),
      (a l).left ≫ (D.map f).left = (a k).left := by
    intro k l f
    obtain ⟨h, rfl⟩ := hsub f
    exact congrArg (fun φ => φ.left) (haL k l h)
  have haffG : ∀ k l (f : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k), IsAffineHom (D.map f).left := by
    intro k l f
    obtain ⟨h, rfl⟩ := hsub f
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
    exact haff k j
  let G : AsSmall.{u} ℕᵒᵖ ⥤ Scheme.{u} :=
    AsSmall.down ⋙ D ⋙ Scheme.ProEt.forget S ⋙ Over.forget S
  let c : Limits.Cone G :=
    { pt := Uinf.left
      π :=
        { app := fun i => (a (ULift.down i).unop).left
          naturality := by
            rintro ⟨⟨l⟩⟩ ⟨⟨k⟩⟩ f
            show 𝟙 Uinf.left ≫ (a k).left = (a l).left ≫ (D.map f.down).left
            rw [Category.id_comp]
            exact (hnat k l f.down).symm } }
  have hc : Limits.IsLimit c := by
    apply Limits.IsLimit.ofExistsUnique
    intro s
    let z : ∀ k, s.pt ⟶ (D.obj (Opposite.op k)).left :=
      fun k => s.π.app (AsSmall.up.obj (Opposite.op k))
    have hz : ∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k := by
      intro k j
      exact s.w (AsSmall.up.map (homOfLE (Nat.le_add_right k j)).op)
    obtain ⟨z₀, hz₀, huniq⟩ := hlim s.pt z hz
    refine ⟨z₀, ?_, ?_⟩
    · rintro ⟨⟨k⟩⟩
      exact hz₀ k
    · intro y hy
      exact huniq y (fun k => hy (AsSmall.up.obj (Opposite.op k)))
  haveI hGaff : ∀ {i j : AsSmall.{u} ℕᵒᵖ} (f : i ⟶ j), IsAffineHom (G.map f) := by
    rintro ⟨⟨l⟩⟩ ⟨⟨k⟩⟩ f
    exact haffG k l f.down
  haveI hGc : ∀ i, CompactSpace (G.obj i) := by
    rintro ⟨⟨k⟩⟩
    exact (hqc k).1
  have hC : CompactSpace Uinf.left := Scheme.compactSpace_of_isLimit G c hc
  haveI : IsAffineHom (a 0).left := isAffineHom_π_app G c hc (AsSmall.up.obj (Opposite.op 0))
  haveI := (hqc 0).2
  exact ⟨hC, quasiSeparatedSpace_of_quasiSeparated (a 0).left⟩

theorem wc_free_ext0_sections (S : Scheme.{u})
    (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :
    ∃ e : ∀ W : S.ProEt, Abelian.Ext (wcFreeSheaf S W) F 0 ≃ F.obj.obj (Opposite.op W),
      (∀ W, e W 0 = 0) ∧
      ∀ (W W' : S.ProEt) (f : W' ⟶ W) (y : Abelian.Ext (wcFreeSheaf S W) F 0),
        e W' ((Abelian.Ext.mk₀ (wcFreeSheafMap S f)).comp y (zero_add 0)) =
          F.obj.map f.op (e W y) :=
by
  classical
  let e2 : ∀ (W : S.ProEt) (G : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃ G.obj (Opposite.op W) :=
    fun W G => ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
        (yoneda.obj W ⋙ uliftFunctor.{u+1, u}) G).trans
        (uliftYonedaEquiv.{u+1} (X := W) (F := G ⋙ forget AddCommGrpCat.{u+1}))
  have hnat2 : ∀ (W : S.ProEt) (G G' : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}) (ψ : G ⟶ G')
      (h : yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G),
      e2 W G' (h ≫ ψ) = ψ.app (Opposite.op W) (e2 W G h) := by
    intro W G G' ψ h
    have hW := (Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv_naturality_right
      (X := yoneda.obj W ⋙ uliftFunctor.{u+1, u}) h ψ
    have hY := uliftYonedaEquiv_comp.{u+1}
      ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
        (yoneda.obj W ⋙ uliftFunctor.{u+1, u}) G h)
      (((Functor.whiskeringRight S.ProEtᵒᵖ AddCommGrpCat.{u+1} (Type (u+1))).obj
          (forget AddCommGrpCat.{u+1})).map ψ)
    exact (congrArg (uliftYonedaEquiv.{u+1} (X := W) (F := G' ⋙ forget AddCommGrpCat.{u+1})) hW).trans hY
  let ec : ∀ (W : S.ProEt), (wcFreeSheaf S W ⟶ F) ≃ F.obj.obj (Opposite.op W) := fun W =>
    ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
        (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F).trans (e2 W F.obj)
  have hzero : ∀ W, ec W 0 = 0 := by
    intro W
    have hA := (sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv_naturality_right
      (X := yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) (0 : wcFreeSheaf S W ⟶ F)
      (0 : F ⟶ F)
    have h1 : ec W ((0 : wcFreeSheaf S W ⟶ F) ≫ (0 : F ⟶ F)) =
        (0 : F ⟶ F).hom.app (Opposite.op W) (ec W 0) :=
      (congrArg (e2 W F.obj) hA).trans (hnat2 W F.obj F.obj (0 : F ⟶ F).hom _)
    rw [Limits.zero_comp] at h1
    rw [h1]
    have h0 : (0 : F ⟶ F).hom = 0 :=
      (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_zero F F
    rw [h0, NatTrans.app_zero]
    rfl
  have hnatW : ∀ (W W' : S.ProEt) (f : W' ⟶ W) (g : wcFreeSheaf S W ⟶ F),
      ec W' (wcFreeSheafMap S f ≫ g) = F.obj.map f.op (ec W g) := by
    intro W W' f g
    have h1 := (sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv_naturality_left
      (Functor.whiskerRight (yoneda.map f) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) g
    have h2 := (Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv_naturality_left
      (uliftYoneda.{u+1}.map f)
      ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
        (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F g)
    have h3 := uliftYonedaEquiv_naturality.{u+1}
      (F := F.obj ⋙ forget AddCommGrpCat.{u+1})
      ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
        (yoneda.obj W ⋙ uliftFunctor.{u+1, u}) F.obj
        ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj W ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F g))
      f.op
    have k1 := congrArg (fun t => uliftYonedaEquiv.{u+1} (X := W') (F := F.obj ⋙ forget AddCommGrpCat.{u+1})
      ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
        (yoneda.obj W' ⋙ uliftFunctor.{u+1, u}) F.obj t)) h1
    have k2 := congrArg (uliftYonedaEquiv.{u+1} (X := W') (F := F.obj ⋙ forget AddCommGrpCat.{u+1})) h2
    exact k1.trans (k2.trans h3.symm)
  refine ⟨fun W => Abelian.Ext.homEquiv₀.trans (ec W), fun W => ?_, fun W W' f y => ?_⟩
  · show ec W (Abelian.Ext.homEquiv₀ (0 : Abelian.Ext (wcFreeSheaf S W) F 0)) = 0
    have : Abelian.Ext.homEquiv₀ (0 : Abelian.Ext (wcFreeSheaf S W) F 0) = 0 := by
      rw [← Abelian.Ext.mk₀_zero, ← Abelian.Ext.homEquiv₀_symm_apply, Equiv.apply_symm_apply]
    rw [this, hzero]
  · obtain ⟨g, rfl⟩ : ∃ g, y = Abelian.Ext.mk₀ g := ⟨_, (Abelian.Ext.mk₀_homEquiv₀_apply y).symm⟩
    have hh : ∀ {A : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (h : A ⟶ F),
        Abelian.Ext.homEquiv₀ (Abelian.Ext.mk₀ h) = h := by
      intro A h
      rw [← Abelian.Ext.homEquiv₀_symm_apply, Equiv.apply_symm_apply]
    show ec W' (Abelian.Ext.homEquiv₀ _) = F.obj.map f.op (ec W (Abelian.Ext.homEquiv₀ _))
    rw [Abelian.Ext.mk₀_comp_mk₀, hh, hh, hnatW]

theorem wc_epsInv_zero_locus (S : Scheme.{u})
    (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (T : S.ProEt)
    (y : ((wcEpsInv S).obj G).obj.obj (Opposite.op T)) :
    ∃ O : Set T.left, IsOpen O ∧ ∀ (W : S.ProEt) (k : W ⟶ T),
      (((wcEpsInv S).obj G).obj.map k.op y = 0 ↔ Set.range k.left ⊆ O) :=
by
  classical

  have hRef : ∀ (T M M' : S.ProEt) (m : M ⟶ T) (m' : M' ⟶ T) (p : M.left) (p' : M'.left),
      m.left p = m'.left p' → ∀ (O : Set M'.left), IsOpen O → p' ∈ O →
      ∃ (Q : S.ProEt) (q : Q ⟶ M) (q' : Q ⟶ M'), q ≫ m = q' ≫ m' ∧ p ∈ Set.range q.left ∧
        Set.range q'.left ⊆ O := by
    intro T M M' m m' p p' hpp O hO hp'
    let Oo : M'.left.Opens := ⟨O, hO⟩
    haveI hM' : WeaklyEtale M'.hom := M'.prop
    haveI hT : WeaklyEtale T.hom := T.prop
    haveI hM : WeaklyEtale M.hom := M.prop
    haveI h1 : WeaklyEtale (m'.left ≫ T.hom) := by
      rw [MorphismProperty.Over.w m']; exact hM'
    haveI h2 : WeaklyEtale m'.left := WeaklyEtale.of_comp m'.left T.hom
    let g₁ : (Oo : Scheme.{u}) ⟶ T.left := Oo.ι ≫ m'.left
    have hc : Limits.pullback.fst m.left g₁ ≫ m.left = Limits.pullback.snd m.left g₁ ≫ g₁ :=
      Limits.pullback.condition
    let Q : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst m.left g₁ ≫ M.hom)
    let q : Q ⟶ M := MorphismProperty.Over.homMk (Limits.pullback.fst m.left g₁) rfl trivial
    have hw : (Limits.pullback.snd m.left g₁ ≫ Oo.ι) ≫ M'.hom =
        Limits.pullback.fst m.left g₁ ≫ M.hom := by
      rw [← MorphismProperty.Over.w m', ← MorphismProperty.Over.w m, ← Category.assoc _ m.left,
        hc]
      simp only [g₁, Category.assoc]
    let q' : Q ⟶ M' := MorphismProperty.Over.homMk (Limits.pullback.snd m.left g₁ ≫ Oo.ι) hw trivial
    refine ⟨Q, q, q', ?_, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      change Limits.pullback.fst m.left g₁ ≫ m.left = (Limits.pullback.snd m.left g₁ ≫ Oo.ι) ≫ m'.left
      rw [hc, Category.assoc]
    · obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := m.left) (g := g₁) p
        ⟨p', hp'⟩ (by
          rw [hpp]
          have e1 : g₁ ⟨p', hp'⟩ = m'.left (Oo.ι ⟨p', hp'⟩) := Scheme.Hom.comp_apply _ _ _
          rw [e1, Scheme.Opens.ι_apply])
      exact ⟨z, hz⟩
    · rintro _ ⟨w, rfl⟩
      have e1 : q'.left w = Oo.ι (Limits.pullback.snd m.left g₁ w) := Scheme.Hom.comp_apply _ _ _
      have e2 : Oo.ι (Limits.pullback.snd m.left g₁ w) = (Limits.pullback.snd m.left g₁ w).1 :=
        Scheme.Opens.ι_apply Oo _
      rw [e1, e2]
      exact (Limits.pullback.snd m.left g₁ w).2

  have key : ∀ (L Q : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (σ : L ⟶ Q),
      Presheaf.IsSeparated (Scheme.ProEt.topology S) Q →
      (∀ (W : S.ProEt) (a : L.obj (Opposite.op W)), σ.app (Opposite.op W) a = 0 → a = 0) →
      (∀ (W : S.ProEt) (l : L.obj (Opposite.op W)), ∃ O : Set W.left, IsOpen O ∧
          ∀ (V : S.ProEt) (k : V ⟶ W), (L.map k.op l = 0 ↔ Set.range k.left ⊆ O)) →
      ∀ (y : Q.obj (Opposite.op T)), Presheaf.imageSieve σ y ∈ Scheme.ProEt.topology S T →
      ∃ O : Set T.left, IsOpen O ∧ ∀ (W : S.ProEt) (k : W ⟶ T),
        (Q.map k.op y = 0 ↔ Set.range k.left ⊆ O) := by
    intro L Q σ hsep hinj hzl y hR
    have hPc : ∀ {W₁ W₂ W₃ : S.ProEt} (k : W₁ ⟶ W₂) (f : W₂ ⟶ W₃) (x : Q.obj (Opposite.op W₃)),
        Q.map (k ≫ f).op x = Q.map k.op (Q.map f.op x) := by
      intro W₁ W₂ W₃ k f x
      rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
    have hPid : ∀ {W : S.ProEt} (x : Q.obj (Opposite.op W)), Q.map (𝟙 W).op x = x := by
      intro W x
      rw [op_id, CategoryTheory.Functor.map_id, ConcreteCategory.id_apply]
    have hy : ∀ (W : S.ProEt) (f : W ⟶ T), (Presheaf.imageSieve σ y).arrows f →
        ∃ t : L.obj (Opposite.op W), σ.app (Opposite.op W) t = Q.map f.op y := fun W f hf => hf
    choose l hl using hy
    choose O hOo hOL using fun (W : S.ProEt) (f : W ⟶ T)
      (hf : (Presheaf.imageSieve σ y).arrows f) => hzl W (l W f hf)

    have hchar : ∀ (W : S.ProEt) (f : W ⟶ T) (hf : (Presheaf.imageSieve σ y).arrows f)
        (V : S.ProEt) (k : V ⟶ W),
        (Q.map k.op (Q.map f.op y) = 0 ↔ Set.range k.left ⊆ O W f hf) := by
      intro W f hf V k
      rw [← hOL W f hf V k, ← hl W f hf, ← NatTrans.naturality_apply]
      constructor
      · intro h
        exact hinj V _ h
      · intro h
        rw [h, map_zero]

    have hcomp : ∀ (W W' : S.ProEt) (f : W ⟶ T) (f' : W' ⟶ T)
        (hf : (Presheaf.imageSieve σ y).arrows f) (hf' : (Presheaf.imageSieve σ y).arrows f')
        (w : W.left) (w' : W'.left), f.left w = f'.left w' → w' ∈ O W' f' hf' → w ∈ O W f hf := by
      intro W W' f f' hf hf' w w' hww hw'
      obtain ⟨Pb, q, q', hqq, ⟨z, hz⟩, hq'⟩ := hRef T W W' f f' w w' hww _ (hOo W' f' hf') hw'
      have h1 : Q.map q'.op (Q.map f'.op y) = 0 := (hchar W' f' hf' Pb q').mpr hq'
      have h2 : Q.map q.op (Q.map f.op y) = 0 := by
        rw [← hPc, hqq, hPc]
        exact h1
      have h3 := (hchar W f hf Pb q).mp h2
      rw [← hz]
      exact h3 ⟨z, rfl⟩

    let O' : Set T.left := {τ | ∃ (W : S.ProEt) (f : W ⟶ T)
      (hf : (Presheaf.imageSieve σ y).arrows f) (w : W.left), f.left w = τ ∧ w ∈ O W f hf}
    have hpre : ∀ (W : S.ProEt) (f : W ⟶ T) (hf : (Presheaf.imageSieve σ y).arrows f),
        f.left ⁻¹' O' = O W f hf := by
      intro W f hf
      ext p
      constructor
      · rintro ⟨W', f', hf', p', heq, hp'⟩
        exact hcomp W W' f f' hf hf' p p' heq.symm hp'
      · intro hp
        exact ⟨W, f, hf, p, rfl, hp⟩
    have hO'o : IsOpen O' := by
      apply (wc_proet_cover_surj_quotient S T _ hR).2
      intro W f hf
      rw [hpre W f hf]
      exact hOo W f hf
    refine ⟨O', hO'o, fun W k => ⟨fun h => ?_, fun h => ?_⟩⟩
    · rintro _ ⟨w, rfl⟩
      have hR' := (Scheme.ProEt.topology S).pullback_stable k hR
      obtain ⟨M, g, hg, m, hm⟩ := (wc_proet_cover_surj_quotient S W _ hR').1 w
      have hg' : (Presheaf.imageSieve σ y).arrows (g ≫ k) := hg
      have h1 : Q.map (𝟙 M).op (Q.map (g ≫ k).op y) = 0 := by
        rw [hPid, hPc, h, map_zero]
      have h2 := (hchar M (g ≫ k) hg' M (𝟙 M)).mp h1
      have h3 : m ∈ O M (g ≫ k) hg' := h2 ⟨m, rfl⟩
      refine ⟨M, g ≫ k, hg', m, ?_, h3⟩
      rw [← hm]
      first | rfl | simp [Scheme.Hom.comp_apply]
    · have hR' := (Scheme.ProEt.topology S).pullback_stable k hR
      refine hsep W _ hR' (Q.map k.op y) 0 ?_
      intro M g hg
      have hg' : (Presheaf.imageSieve σ y).arrows (g ≫ k) := hg
      rw [map_zero, ← hPc]
      have h1 : Set.range (𝟙 M : M ⟶ M).left ⊆ O M (g ≫ k) hg' := by
        rintro _ ⟨p, rfl⟩
        rw [← hpre M (g ≫ k) hg']
        exact h ⟨g.left ((𝟙 M : M ⟶ M).left p), by first | rfl | simp [Scheme.Hom.comp_apply]⟩
      have h2 := (hchar M (g ≫ k) hg' M (𝟙 M)).mpr h1
      rw [hPid] at h2
      exact h2

  have hinj : ∀ (W : S.ProEt) (a b : ((wcEtToProEt S).op.lan.obj G.obj).obj (Opposite.op W)),
      (toSheafify (Scheme.ProEt.topology S) ((wcEtToProEt S).op.lan.obj G.obj)).app
          (Opposite.op W) a =
        (toSheafify (Scheme.ProEt.topology S) ((wcEtToProEt S).op.lan.obj G.obj)).app
          (Opposite.op W) b → a = b := by
    intro W a b hab
    haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.ProEt.topology S)
      ((wcEtToProEt S).op.lan.obj G.obj)
    have hmem := Presheaf.IsLocallyInjective.equalizerSieve_mem
      (J := Scheme.ProEt.topology S)
      (φ := toSheafify (Scheme.ProEt.topology S) ((wcEtToProEt S).op.lan.obj G.obj)) a b hab
    have h0 := wc_lan_etale_separated S G W _ hmem (a - b) (fun V f hf => by
      have hf' : ((wcEtToProEt S).op.lan.obj G.obj).map f.op a =
          ((wcEtToProEt S).op.lan.obj G.obj).map f.op b := hf
      rw [map_sub, hf', sub_self])
    exact sub_eq_zero.mp h0
  have hLS := Presheaf.isLocallySurjective_toSheafify' (Scheme.ProEt.topology S)
    ((wcEtToProEt S).op.lan.obj G.obj)
  exact key _ _ (toSheafify (Scheme.ProEt.topology S) ((wcEtToProEt S).op.lan.obj G.obj))
    (Sheaf.isSeparated ((wcEpsInv S).obj G))
    (fun W a h => hinj W a 0 (h.trans (map_zero _).symm))
    (wc_lan_etale_zero_locus S G) y
    (Presheaf.IsLocallySurjective.imageSieve_mem (J := Scheme.ProEt.topology S)
      (f := toSheafify (Scheme.ProEt.topology S) ((wcEtToProEt S).op.lan.obj G.obj))
      (self := hLS) y)

theorem wc_tower_fibre_open_absorb (S : Scheme.{u}) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left)
    (k : ℕ) (M : Scheme.{u}) [CompactSpace M] (g : M ⟶ (D.obj (Opposite.op k)).left)
    (O : Set M) (hO : IsOpen O)
    (hinf : ∀ (m : M) (z : Uinf.left), g m = (a k).left z → m ∈ O) :
    ∃ j, ∀ (m : M) (z : (D.obj (Opposite.op (k + j))).left),
      g m = (D.map (homOfLE (Nat.le_add_right k j)).op).left z → m ∈ O :=
by
  classical

  obtain ⟨T, hT⟩ : ∃ T : ∀ p q, p ≤ q →
      ((D.obj (Opposite.op q)).left ⟶ (D.obj (Opposite.op p)).left),
      ∀ p q h, T p q h = (D.map (homOfLE h).op).left := ⟨_, fun _ _ _ => rfl⟩
  have hTT : ∀ p q r (h1 : p ≤ q) (h2 : q ≤ r),
      T q r h2 ≫ T p q h1 = T p r (h1.trans h2) := by
    intro p q r h1 h2
    rw [hT, hT, hT]
    exact (congrArg (fun f => f.left) (D.map_comp (homOfLE h2).op (homOfLE h1).op)).symm
  have hTid : ∀ p (h : p ≤ p), T p p h = 𝟙 _ := by
    intro p h
    rw [hT]
    have e : (homOfLE h).op = 𝟙 (Opposite.op p) := rfl
    rw [e, D.map_id]
    rfl
  have haL : ∀ p q (h : p ≤ q), (a q).left ≫ T p q h = (a p).left := by
    intro p q h
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
    rw [hT]
    exact congrArg (fun f => f.left) (ha p j)
  have hTaff : ∀ p q (h : p ≤ q), IsAffineHom (T p q h) := by
    intro p q h
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
    rw [hT]
    exact haff p j

  obtain ⟨P, fst, snd, hP⟩ : ∃ (P : ℕ → Scheme.{u})
      (fst : ∀ n, P n ⟶ (D.obj (Opposite.op (k + n))).left) (snd : ∀ n, P n ⟶ M),
      ∀ n, IsPullback (fst n) (snd n) (T k (k + n) (Nat.le_add_right k n)) g :=
    ⟨fun n => Limits.pullback (T k (k + n) (Nat.le_add_right k n)) g,
      fun n => Limits.pullback.fst _ _, fun n => Limits.pullback.snd _ _,
      fun n => IsPullback.of_hasPullback _ _⟩
  have hsaff : ∀ n, IsAffineHom (snd n) := fun n =>
    MorphismProperty.of_isPullback (P := @IsAffineHom) (hP n) (hTaff _ _ _)
  have hcomp : ∀ n, CompactSpace (P n) := by
    intro n
    haveI := hsaff n
    exact QuasiCompact.compactSpace_of_compactSpace (snd n)
  obtain ⟨PM, hPMf, hPMs⟩ : ∃ PM : ∀ p q, p ≤ q → (P q ⟶ P p),
      (∀ p q (h : p ≤ q), PM p q h ≫ fst p =
        fst q ≫ T (k + p) (k + q) (Nat.add_le_add_left h k)) ∧
      (∀ p q (h : p ≤ q), PM p q h ≫ snd p = snd q) :=
    ⟨fun p q h => (hP p).lift (fst q ≫ T (k + p) (k + q) (Nat.add_le_add_left h k)) (snd q)
        (by rw [Category.assoc, hTT, (hP q).w]),
      fun p q h => (hP p).lift_fst _ _ _, fun p q h => (hP p).lift_snd _ _ _⟩
  have hPMid : ∀ p (h : p ≤ p), PM p p h = 𝟙 _ := by
    intro p h
    apply (hP p).hom_ext
    · rw [hPMf, hTid, Category.id_comp, Category.comp_id]
    · rw [hPMs, Category.id_comp]
  have hPMcomp : ∀ p q r (h1 : p ≤ q) (h2 : q ≤ r),
      PM q r h2 ≫ PM p q h1 = PM p r (h1.trans h2) := by
    intro p q r h1 h2
    apply (hP p).hom_ext
    · rw [Category.assoc, hPMf, ← Category.assoc, hPMf, Category.assoc, hTT, hPMf]
    · rw [Category.assoc, hPMs, hPMs, hPMs]
  have hPMaff : ∀ p q (h : p ≤ q), IsAffineHom (PM p q h) := by
    intro p q h
    haveI := hsaff p
    haveI : IsAffineHom (PM p q h ≫ snd p) := by rw [hPMs]; exact hsaff q
    exact IsAffineHom.of_comp (PM p q h) (snd p)
  let G0 : ℕᵒᵖ ⥤ Scheme.{u} :=
    { obj := fun n => P n.unop
      map := fun {n n'} f => PM n'.unop n.unop (leOfHom f.unop)
      map_id := fun n => hPMid n.unop _
      map_comp := fun {n n' n''} f f' => (hPMcomp _ _ _ _ _).symm }
  let G : AsSmall.{u} ℕᵒᵖ ⥤ Scheme.{u} := AsSmall.down ⋙ G0
  haveI hGaff : ∀ {i j : AsSmall.{u} ℕᵒᵖ} (f : i ⟶ j), IsAffineHom (G.map f) :=
    fun f => hPMaff _ _ _

  obtain ⟨L, fL, sL, hL⟩ : ∃ (L : Scheme.{u}) (fL : L ⟶ Uinf.left) (sL : L ⟶ M),
      IsPullback fL sL (a k).left g :=
    ⟨_, _, _, IsPullback.of_hasPullback (a k).left g⟩
  obtain ⟨πL, hπf, hπs⟩ : ∃ πL : ∀ n, L ⟶ P n,
      (∀ n, πL n ≫ fst n = fL ≫ (a (k + n)).left) ∧ (∀ n, πL n ≫ snd n = sL) :=
    ⟨fun n => (hP n).lift (fL ≫ (a (k + n)).left) sL
        (by rw [Category.assoc, haL, hL.w]),
      fun n => (hP n).lift_fst _ _ _, fun n => (hP n).lift_snd _ _ _⟩
  have hπPM : ∀ p q (h : p ≤ q), πL q ≫ PM p q h = πL p := by
    intro p q h
    apply (hP p).hom_ext
    · rw [Category.assoc, hPMf, ← Category.assoc, hπf, Category.assoc, haL, hπf]
    · rw [Category.assoc, hPMs, hπs, hπs]
  let c : Limits.Cone G :=
    { pt := L
      π :=
        { app := fun i => πL (AsSmall.down.obj i).unop
          naturality := fun i j f => (Category.id_comp _).trans (hπPM _ _ _).symm } }
  have hc : Limits.IsLimit c := by
    refine Limits.IsLimit.ofExistsUnique (fun s => ?_)
    obtain ⟨zz, hzz, hzzs⟩ : ∃ zz : ∀ n, s.pt ⟶ P n,
        (∀ p q (h : p ≤ q), zz q ≫ PM p q h = zz p) ∧
        ∀ i, s.π.app i = zz (AsSmall.down.obj i).unop :=
      ⟨fun n => s.π.app (AsSmall.up.obj (Opposite.op n)),
        fun p q h => s.w (AsSmall.up.map (homOfLE h).op), fun i => rfl⟩
    have hzf : ∀ p q (h : p ≤ q),
        zz q ≫ fst q ≫ T (k + p) (k + q) (Nat.add_le_add_left h k) = zz p ≫ fst p := by
      intro p q h
      rw [← hzz p q h, Category.assoc, hPMf]
    have hzs : ∀ n, zz n ≫ snd n = zz 0 ≫ snd 0 := by
      intro n
      rw [← hzz 0 n (Nat.zero_le n), Category.assoc, hPMs]
    obtain ⟨u, hudef⟩ : ∃ u : ∀ n, s.pt ⟶ (D.obj (Opposite.op n)).left,
        ∀ n, u n = zz n ≫ fst n ≫ T n (k + n) (Nat.le_add_left n k) := ⟨_, fun _ => rfl⟩
    have hu : ∀ p q (h : p ≤ q), u q ≫ T p q h = u p := by
      intro p q h
      rw [hudef, hudef, ← Category.assoc (zz p), ← hzf p q h]
      simp only [Category.assoc, hTT]
    obtain ⟨z₀, hz₀, hz₀u⟩ := hlim s.pt u (fun n j => by rw [← hT]; exact hu n (n + j) _)
    have hw : z₀ ≫ (a k).left = (zz 0 ≫ snd 0) ≫ g := by
      rw [hz₀, hudef, ← hzs k, Category.assoc, ← (hP k).w]
    refine ⟨hL.lift z₀ (zz 0 ≫ snd 0) hw, fun i => ?_, fun y hy => ?_⟩
    · rw [hzzs i]
      show hL.lift z₀ (zz 0 ≫ snd 0) hw ≫ πL _ = _
      apply (hP _).hom_ext
      · rw [Category.assoc, hπf, ← Category.assoc, hL.lift_fst, hz₀, hudef,
          hzf _ _ (Nat.le_add_left _ k)]
      · rw [Category.assoc, hπs, hL.lift_snd]
        exact (hzs _).symm
    · have hy' : ∀ n, y ≫ πL n = zz n := fun n => by
        have := hy (AsSmall.up.obj (Opposite.op n))
        rw [hzzs] at this
        exact this
      apply hL.hom_ext
      · rw [hL.lift_fst]
        apply hz₀u
        intro n
        rw [Category.assoc, ← haL n (k + n) (Nat.le_add_left n k), ← Category.assoc fL,
          ← hπf, hudef, ← hy' n]
        simp only [Category.assoc]
      · rw [hL.lift_snd, ← hπs 0, ← Category.assoc, hy']

  by_contra hne
  push_neg at hne
  let Z : ∀ i : AsSmall.{u} ℕᵒᵖ, Set (G.obj i) :=
    fun i => (snd (AsSmall.down.obj i).unop) ⁻¹' Oᶜ
  have hZc : ∀ i, IsClosed (Z i) := fun i =>
    IsClosed.preimage (snd _).continuous hO.isClosed_compl
  have hZne : ∀ i, (Z i).Nonempty := by
    intro i
    obtain ⟨m, z, hmz, hmO⟩ := hne (AsSmall.down.obj i).unop
    rw [← hT] at hmz
    obtain ⟨w, -, hw2⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := T k (k + (AsSmall.down.obj i).unop) (Nat.le_add_right _ _)) (g := g) z m hmz.symm
    refine ⟨(hP (AsSmall.down.obj i).unop).isoPullback.inv w, ?_⟩
    show snd _ ((hP (AsSmall.down.obj i).unop).isoPullback.inv w) ∈ Oᶜ
    rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_snd, hw2]
    exact hmO
  have hZk : ∀ i, IsCompact (Z i) := fun i =>
    (hcomp _).isCompact_univ.of_isClosed_subset (hZc i) (Set.subset_univ _)
  have hmaps : ∀ p q (h : p ≤ q) (x : P q), snd q x ∈ Oᶜ → snd p (PM p q h x) ∈ Oᶜ := by
    intro p q h x hx
    rw [← Scheme.Hom.comp_apply, hPMs]
    exact hx
  have hZm : ∀ {i i' : AsSmall.{u} ℕᵒᵖ} (f : i ⟶ i'), Set.MapsTo (G.map f) (Z i) (Z i') := by
    intro i i' f x hx
    exact hmaps _ _ _ x hx
  obtain ⟨s, hs⟩ := AlgebraicGeometry.exists_mem_of_isClosed_of_nonempty G c hc Z hZc hZne hZk hZm
  have h0 : snd 0 (πL 0 s) ∈ Oᶜ := hs (AsSmall.up.obj (Opposite.op 0))
  rw [← Scheme.Hom.comp_apply, hπs] at h0
  apply h0
  apply hinf (sL s) (fL s)
  rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hL.w]

theorem wc_epsInv_locally_etale_section : ∀ (S : Scheme.{u}) (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (T : S.ProEt) (x : ((wcEpsInv S).obj G).obj.obj (Opposite.op T)) (τ : T.left), ∃ (W : S.ProEt) (f : W ⟶ T) (V₁ : S.Etale) (c : W ⟶ (wcEtToProEt S).obj V₁) (s₀ : ((wcEpsInv S).obj G).obj.obj (Opposite.op ((wcEtToProEt S).obj V₁))), τ ∈ Set.range f.left ∧ ((wcEpsInv S).obj G).obj.map f.op x = ((wcEpsInv S).obj G).obj.map c.op s₀ :=
by
  have hcov : ∀ (Y : Scheme.{u}) (T : Y.ProEt) (R : Sieve T), R ∈ Scheme.ProEt.topology Y T →
      ∀ τ : T.left, ∃ (W : Y.ProEt) (f : W ⟶ T), R.arrows f ∧ τ ∈ Set.range f.left := by
    intro Y T R hR
    have fact : ∀ {Z : Scheme.{u}} (g : Z ⟶ T.left),
        (Sieve.overEquiv ((Scheme.ProEt.forget Y).obj T)
          (Sieve.functorPushforward (Scheme.ProEt.forget Y) R)).arrows g →
        ∃ (W : Y.ProEt) (f : W ⟶ T) (e : Z ⟶ W.left), R.arrows f ∧ g = e ≫ f.left := by
      intro Z g hg
      have hg' := (Sieve.overEquiv_iff _ g).mp hg
      obtain ⟨W, φ, ψ, hφ, heq⟩ := hg'
      refine ⟨W, φ, ψ.left, hφ, ?_⟩
      have := congrArg CommaMorphism.left heq
      simp only [Over.homMk_left, Over.comp_left] at this
      exact this
    have hS : Sieve.overEquiv ((Scheme.ProEt.forget Y).obj T)
        (Sieve.functorPushforward (Scheme.ProEt.forget Y) R) ∈ Scheme.proetaleTopology T.left :=
      (GrothendieckTopology.mem_over_iff _ _).mp ((CoverPreserving.of_isContinuous
        (Scheme.ProEt.forget Y) (Scheme.ProEt.topology Y) (Scheme.proetaleTopology.over Y)).cover_preserve hR)
    obtain ⟨R', hR', hle⟩ :=
      (Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition (J := Scheme.proetalePrecoverage)).mp hS
    obtain ⟨𝒰, h𝒰, hR'eq⟩ := (Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover).mp hR'
    haveI := h𝒰
    have hmem : ∀ j, (Sieve.overEquiv ((Scheme.ProEt.forget Y).obj T)
        (Sieve.functorPushforward (Scheme.ProEt.forget Y) R)).arrows (𝒰.f j) := by
      intro j
      apply hle
      rw [hR'eq]
      exact Presieve.ofArrows.mk j
    choose W f e hf he using fun j =>
      fact (𝒰.f j) (hmem j)
    intro τ
    obtain ⟨U, hUa, hτU, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := τ) trivial
    obtain ⟨n, c, V, hV, hUeq⟩ :=
      QuasiCompactCover.exists_isAffineOpen_of_isCompact 𝒰.toPreZeroHypercover hUa.isCompact
    have hτ' : τ ∈ (U : Set T.left) := hτU
    rw [← hUeq] at hτ'
    obtain ⟨i, z, hz, hzτ⟩ := Set.mem_iUnion.mp hτ'
    refine ⟨W (c i), f (c i), hf _, e (c i) z, ?_⟩
    rw [← hzτ, he (c i), Scheme.Hom.comp_apply]
  have hrep : ∀ (Y : Scheme.{u}) (F : Y.Etaleᵒᵖ ⥤ AddCommGrpCat.{u+1}) (T : Y.ProEt)
      (x : ((wcEtToProEt Y).op.lan.obj F).obj (Opposite.op T)),
      ∃ (V₁ : Y.Etale) (a : T ⟶ (wcEtToProEt Y).obj V₁) (t : F.obj (Opposite.op V₁)),
        x = ((wcEtToProEt Y).op.lan.obj F).map a.op
          (((wcEtToProEt Y).op.lanUnit.app F).app (Opposite.op V₁) t) := by
    intro Y F T x
    haveI : Limits.PreservesFiniteLimits (wcEtToProEt Y) :=
      @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _ (wcEtToProEt Y)
        (Scheme.ProEt.forget Y)
        (inferInstanceAs (Limits.PreservesFiniteLimits (Scheme.Etale.forget Y))) inferInstance
    haveI : RepresentablyFlat (wcEtToProEt Y) := flat_of_preservesFiniteLimits _
    haveI : IsCofiltered (StructuredArrow T (wcEtToProEt Y)) := RepresentablyFlat.cofiltered T
    haveI hI : IsFiltered (CostructuredArrow (wcEtToProEt Y).op (Opposite.op T)) :=
      IsFiltered.of_equivalence (structuredArrowOpEquivalence (wcEtToProEt Y) T)
    haveI : IsFiltered (ULiftHom.{u+1} (CostructuredArrow (wcEtToProEt Y).op (Opposite.op T))) :=
      IsFiltered.of_equivalence ULiftHom.equiv
    haveI := Limits.preservesColimitsOfShape_of_equiv
      (ULiftHom.equiv (C := CostructuredArrow (wcEtToProEt Y).op (Opposite.op T))).symm
      (forget AddCommGrpCat.{u+1})
    let E := Functor.LeftExtension.mk ((wcEtToProEt Y).op.leftKanExtension F)
      ((wcEtToProEt Y).op.leftKanExtensionUnit F)
    have hc : Limits.IsColimit (E.coconeAt (Opposite.op T)) :=
      (wcEtToProEt Y).op.isPointwiseLeftKanExtensionLeftKanExtensionUnit F (Opposite.op T)
    obtain ⟨j, y, hy⟩ := Limits.Concrete.isColimit_exists_rep _ hc x
    refine ⟨j.left.unop, j.hom.unop, y, ?_⟩
    rw [← hy]
    rfl
  intro S G T x τ
  have hR := Presheaf.imageSieve_mem (Scheme.ProEt.topology S)
    (toSheafify (Scheme.ProEt.topology S) ((wcEtToProEt S).op.lan.obj G.obj)) x
  obtain ⟨W, f, hf, hτ⟩ := hcov S T _ hR τ
  obtain ⟨l, hl⟩ := hf
  obtain ⟨V₁, c, t, hl'⟩ := hrep S G.obj W l
  refine ⟨W, f, V₁, c,
    (toSheafify (Scheme.ProEt.topology S) ((wcEtToProEt S).op.lan.obj G.obj)).app
      (Opposite.op ((wcEtToProEt S).obj V₁))
      (((wcEtToProEt S).op.lanUnit.app G.obj).app (Opposite.op V₁) t), hτ, ?_⟩
  have hnat := NatTrans.naturality_apply
    (toSheafify (Scheme.ProEt.topology S) ((wcEtToProEt S).op.lan.obj G.obj)) c.op
    (((wcEtToProEt S).op.lanUnit.app G.obj).app (Opposite.op V₁) t)
  rw [← hl', hl] at hnat
  exact hnat

theorem wc_proet_agreement_open : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (hZL : ∀ (T : S.ProEt) (y : P.obj.obj (Opposite.op T)), ∃ O : Set T.left, IsOpen O ∧ ∀ (W : S.ProEt) (k : W ⟶ T), (P.obj.map k.op y = 0 ↔ Set.range k.left ⊆ O)) (T : S.ProEt) (x : P.obj.obj (Opposite.op T)) (V₁ : S.Etale) (s₀ : P.obj.obj (Opposite.op ((wcEtToProEt S).obj V₁))) (W : S.ProEt) (f : W ⟶ T) (c : W ⟶ (wcEtToProEt S).obj V₁) (hfc : P.obj.map f.op x = P.obj.map c.op s₀), ∃ O : Set ↥(Limits.pullback T.hom V₁.hom), IsOpen O ∧ (∀ w : W.left, ∃ ε ∈ O, Limits.pullback.fst T.hom V₁.hom ε = f.left w) ∧ ∀ (W' : S.ProEt) (k₁ : W' ⟶ T) (k₂ : W' ⟶ (wcEtToProEt S).obj V₁) (κ : W'.left ⟶ Limits.pullback T.hom V₁.hom), κ ≫ Limits.pullback.fst T.hom V₁.hom = k₁.left → κ ≫ Limits.pullback.snd T.hom V₁.hom = k₂.left → Set.range κ ⊆ O → P.obj.map k₁.op x = P.obj.map k₂.op s₀ :=
by
  intro S P hZL T x V₁ s₀ W f c hfc
  haveI : Etale V₁.hom := V₁.prop
  have hE : WeaklyEtale (Limits.pullback.fst T.hom V₁.hom ≫ T.hom) := by
    haveI : WeaklyEtale T.hom := T.prop
    haveI : WeaklyEtale (Limits.pullback.fst T.hom V₁.hom) :=
      etale_le_weaklyEtale _ _ _ inferInstance
    infer_instance
  let E : S.ProEt := MorphismProperty.Over.mk ⊤ (Limits.pullback.fst T.hom V₁.hom ≫ T.hom) hE
  let p₁ : E ⟶ T := MorphismProperty.Over.homMk (Limits.pullback.fst T.hom V₁.hom) rfl trivial
  let p₂ : E ⟶ (wcEtToProEt S).obj V₁ :=
    MorphismProperty.Over.homMk (Limits.pullback.snd T.hom V₁.hom)
      (Limits.pullback.condition).symm trivial
  obtain ⟨O, hO, hOiff⟩ := hZL E (P.obj.map p₁.op x - P.obj.map p₂.op s₀)
  have key : ∀ (W' : S.ProEt) (κ' : W' ⟶ E),
      P.obj.map κ'.op (P.obj.map p₁.op x - P.obj.map p₂.op s₀) =
        P.obj.map (κ' ≫ p₁).op x - P.obj.map (κ' ≫ p₂).op s₀ := by
    intro W' κ'
    rw [map_sub, op_comp, op_comp, Functor.map_comp_apply, Functor.map_comp_apply]
  refine ⟨O, hO, ?_, ?_⟩
  · have hw : f.left ≫ T.hom = c.left ≫ V₁.hom :=
      (MorphismProperty.Over.w f).trans (MorphismProperty.Over.w c).symm
    let ℓ := Limits.pullback.lift f.left c.left hw
    have he : ℓ ≫ (Limits.pullback.fst T.hom V₁.hom ≫ T.hom) = W.hom := by
      first
        | exact (Category.assoc ℓ _ _).symm.trans
            ((congrArg (fun g => g ≫ T.hom) (Limits.pullback.lift_fst f.left c.left hw)).trans
              (MorphismProperty.Over.w f))
        | (erw [← Category.assoc, Limits.pullback.lift_fst]
           exact MorphismProperty.Over.w f)
    let e : W ⟶ E := MorphismProperty.Over.homMk ℓ he trivial
    have h1 : e ≫ p₁ = f := MorphismProperty.Over.Hom.ext (Limits.pullback.lift_fst _ _ _)
    have h2 : e ≫ p₂ = c := MorphismProperty.Over.Hom.ext (Limits.pullback.lift_snd _ _ _)
    have hz : P.obj.map e.op (P.obj.map p₁.op x - P.obj.map p₂.op s₀) = 0 := by
      rw [key, h1, h2, hfc, sub_self]
    have hr := (hOiff W e).mp hz
    intro w
    refine ⟨ℓ w, hr ⟨w, rfl⟩, ?_⟩
    first
      | (show (ℓ ≫ Limits.pullback.fst T.hom V₁.hom) w = f.left w
         rw [Limits.pullback.lift_fst])
      | exact (Scheme.Hom.comp_apply ℓ (Limits.pullback.fst T.hom V₁.hom) w).symm.trans
          (congrArg (fun g : W.left ⟶ T.left => g w) (Limits.pullback.lift_fst f.left c.left hw))
      | (have hh := congrArg (fun g : W.left ⟶ T.left => g w)
           (Limits.pullback.lift_fst f.left c.left hw)
         simpa using hh)
  · intro W' k₁ k₂ κ h₁ h₂ hr
    have hκ : κ ≫ (Limits.pullback.fst T.hom V₁.hom ≫ T.hom) = W'.hom := by
      rw [← Category.assoc, h₁]
      exact MorphismProperty.Over.w k₁
    let κ' : W' ⟶ E := MorphismProperty.Over.homMk κ hκ trivial
    have e1 : κ' ≫ p₁ = k₁ := MorphismProperty.Over.Hom.ext h₁
    have e2 : κ' ≫ p₂ = k₂ := MorphismProperty.Over.Hom.ext h₂
    have hz := (hOiff W' κ').mpr hr
    rw [key, e1, e2] at hz
    exact sub_eq_zero.mp hz

theorem wc_tower_basechange_affine_nbhd : ∀ (S : Scheme.{u}) {Uinf : S.ProEt} (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k)) (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k) (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left), (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) → ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k) (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left) (V : Scheme.{u}) (h : V ⟶ S) (O : Set ↥(Limits.pullback Uinf.hom h)) (hO : IsOpen O) (ε : ↥(Limits.pullback Uinf.hom h)) (hε : ε ∈ O), ∃ (k : ℕ) (A : (Limits.pullback (D.obj (Opposite.op k)).hom h).Opens) (π : Limits.pullback Uinf.hom h ⟶ Limits.pullback (D.obj (Opposite.op k)).hom h), π ≫ Limits.pullback.fst (D.obj (Opposite.op k)).hom h = Limits.pullback.fst Uinf.hom h ≫ (a k).left ∧ π ≫ Limits.pullback.snd (D.obj (Opposite.op k)).hom h = Limits.pullback.snd Uinf.hom h ∧ IsAffineOpen A ∧ π ε ∈ A ∧ ∀ e, π e ∈ A → e ∈ O :=
by
  intro S Uinf D a ha hlim haff V h O hO ε hε
  classical
  have hsub : ∀ {k l : ℕ} (f : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k),
      ∃ h : k ≤ l, f = (homOfLE h).op := by
    intro k l f
    exact ⟨leOfHom f.unop, Quiver.Hom.unop_inj (Subsingleton.elim _ _)⟩
  have hnat : ∀ k l (f : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k),
      (a l).left ≫ (D.map f).left = (a k).left := by
    intro k l f
    obtain ⟨hkl, rfl⟩ := hsub f
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hkl
    exact congrArg (fun φ => φ.left) (ha k j)
  have haffG : ∀ k l (f : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k), IsAffineHom (D.map f).left := by
    intro k l f
    obtain ⟨hkl, rfl⟩ := hsub f
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hkl
    exact haff k j

  have key : ∀ (E : ℕᵒᵖ ⥤ Over S) (Einf : Over S) (b : ∀ k, Einf ⟶ E.obj (Opposite.op k))
      (hb : ∀ k l (f : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k), (b l).left ≫ (E.map f).left = (b k).left)
      (hlimE : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (E.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (E.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Einf.left, ∀ k, z₀ ≫ (b k).left = z k)
      (haffE : ∀ k l (f : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k), IsAffineHom (E.map f).left)
      (O : Set ↥(Limits.pullback Einf.hom h)) (hO : IsOpen O)
      (ε : ↥(Limits.pullback Einf.hom h)) (hε : ε ∈ O),
      ∃ (k : ℕ) (A : (Limits.pullback (E.obj (Opposite.op k)).hom h).Opens)
        (π : Limits.pullback Einf.hom h ⟶ Limits.pullback (E.obj (Opposite.op k)).hom h),
        π ≫ Limits.pullback.fst (E.obj (Opposite.op k)).hom h = Limits.pullback.fst Einf.hom h ≫ (b k).left ∧
        π ≫ Limits.pullback.snd (E.obj (Opposite.op k)).hom h = Limits.pullback.snd Einf.hom h ∧
        IsAffineOpen A ∧ π ε ∈ A ∧ ∀ e, π e ∈ A → e ∈ O := by
    intro E Einf b hb hlimE haffE O hO ε hε
    let F : Over S ⥤ Scheme.{u} := Over.pullback h ⋙ Over.forget V
    have hF1 : ∀ {U U' : Over S} (t : U' ⟶ U),
        (F.map t : Limits.pullback U'.hom h ⟶ Limits.pullback U.hom h) ≫ Limits.pullback.fst U.hom h =
          Limits.pullback.fst U'.hom h ≫ t.left := by
      intro U U' t
      exact Limits.pullback.lift_fst _ _ _
    have hF2 : ∀ {U U' : Over S} (t : U' ⟶ U),
        (F.map t : Limits.pullback U'.hom h ⟶ Limits.pullback U.hom h) ≫ Limits.pullback.snd U.hom h =
          Limits.pullback.snd U'.hom h := by
      intro U U' t
      exact Limits.pullback.lift_snd _ _ _
    have hFaff : ∀ {U U' : Over S} (t : U' ⟶ U), IsAffineHom t.left →
        IsAffineHom (F.map t : Limits.pullback U'.hom h ⟶ Limits.pullback U.hom h) := by
      intro U U' t ht
      have hout : IsPullback ((F.map t : Limits.pullback U'.hom h ⟶ Limits.pullback U.hom h) ≫
          Limits.pullback.snd U.hom h) (Limits.pullback.fst U'.hom h) h (t.left ≫ U.hom) := by
        rw [hF2 t, Over.w t]
        exact (IsPullback.of_hasPullback U'.hom h).flip
      have hsq : IsPullback (F.map t : Limits.pullback U'.hom h ⟶ Limits.pullback U.hom h)
          (Limits.pullback.fst U'.hom h) (Limits.pullback.fst U.hom h) t.left :=
        IsPullback.of_right hout (hF1 t) (IsPullback.of_hasPullback U.hom h).flip
      exact MorphismProperty.of_isPullback (P := @IsAffineHom) hsq.flip ht
    let G : AsSmall.{u} ℕᵒᵖ ⥤ Scheme.{u} := AsSmall.down ⋙ E ⋙ F
    have hw : ∀ k, (Limits.pullback.fst Einf.hom h ≫ (b k).left) ≫ (E.obj (Opposite.op k)).hom =
        Limits.pullback.snd Einf.hom h ≫ h := by
      intro k
      rw [Category.assoc, Over.w (b k)]
      exact Limits.pullback.condition
    let p : ∀ k, Limits.pullback Einf.hom h ⟶ Limits.pullback (E.obj (Opposite.op k)).hom h :=
      fun k => Limits.pullback.lift (Limits.pullback.fst Einf.hom h ≫ (b k).left)
        (Limits.pullback.snd Einf.hom h) (hw k)
    have hp1 : ∀ k, p k ≫ Limits.pullback.fst (E.obj (Opposite.op k)).hom h =
        Limits.pullback.fst Einf.hom h ≫ (b k).left := fun k => Limits.pullback.lift_fst _ _ _
    have hp2 : ∀ k, p k ≫ Limits.pullback.snd (E.obj (Opposite.op k)).hom h =
        Limits.pullback.snd Einf.hom h := fun k => Limits.pullback.lift_snd _ _ _
    have hpnat : ∀ k l (f : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k),
        p l ≫ (F.map (E.map f) : Limits.pullback (E.obj (Opposite.op l)).hom h ⟶
          Limits.pullback (E.obj (Opposite.op k)).hom h) = p k := by
      intro k l f
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hF1, ← Category.assoc, hp1, Category.assoc, hb, hp1]
      · rw [Category.assoc, hF2, hp2, hp2]
    let c : Limits.Cone G :=
      { pt := Limits.pullback Einf.hom h
        π :=
          { app := fun i => p (ULift.down i).unop
            naturality := by
              rintro ⟨⟨l⟩⟩ ⟨⟨k⟩⟩ f
              show 𝟙 _ ≫ p k = p l ≫ F.map (E.map f.down)
              rw [Category.id_comp]
              exact (hpnat k l f.down).symm } }
    have hc : Limits.IsLimit c := by
      apply Limits.IsLimit.ofExistsUnique
      intro s
      let z : ∀ k, s.pt ⟶ Limits.pullback (E.obj (Opposite.op k)).hom h :=
        fun k => s.π.app (AsSmall.up.obj (Opposite.op k))
      have hz : ∀ k l (f : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k),
          z l ≫ (F.map (E.map f) : Limits.pullback (E.obj (Opposite.op l)).hom h ⟶
            Limits.pullback (E.obj (Opposite.op k)).hom h) = z k := by
        intro k l f
        exact s.w (AsSmall.up.map f)
      let w : ∀ k, s.pt ⟶ (E.obj (Opposite.op k)).left :=
        fun k => z k ≫ Limits.pullback.fst (E.obj (Opposite.op k)).hom h
      have hwc : ∀ k j, w (k + j) ≫ (E.map (homOfLE (Nat.le_add_right k j)).op).left = w k := by
        intro k j
        show (z (k + j) ≫ Limits.pullback.fst _ h) ≫ _ = z k ≫ Limits.pullback.fst _ h
        rw [Category.assoc, ← hF1 (E.map (homOfLE (Nat.le_add_right k j)).op), ← Category.assoc,
          hz]
      obtain ⟨y₀, hy₀, huniq⟩ := hlimE s.pt w hwc
      have hsnd : ∀ k, z k ≫ Limits.pullback.snd (E.obj (Opposite.op k)).hom h =
          z 0 ≫ Limits.pullback.snd (E.obj (Opposite.op 0)).hom h := by
        intro k
        rw [← hz 0 k (homOfLE (Nat.zero_le k)).op, Category.assoc, hF2]
      have hcond : y₀ ≫ Einf.hom =
          (z 0 ≫ Limits.pullback.snd (E.obj (Opposite.op 0)).hom h) ≫ h := by
        rw [← Over.w (b 0), ← Category.assoc, hy₀ 0]
        show (z 0 ≫ Limits.pullback.fst _ h) ≫ _ = _
        rw [Category.assoc, Limits.pullback.condition, Category.assoc]
      refine ⟨Limits.pullback.lift y₀ (z 0 ≫ Limits.pullback.snd _ h) hcond, ?_, ?_⟩
      · rintro ⟨⟨k⟩⟩
        show Limits.pullback.lift _ _ hcond ≫ p k = z k
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, hp1, Limits.pullback.lift_fst_assoc, hy₀]
        · rw [Category.assoc, hp2, Limits.pullback.lift_snd]
          exact (hsnd k).symm
      · intro y hy
        have hyk : ∀ k, y ≫ p k = z k := fun k => hy (AsSmall.up.obj (Opposite.op k))
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst]
          apply huniq
          intro k
          show _ = z k ≫ _
          rw [Category.assoc, ← hp1, ← Category.assoc, hyk]
        · rw [Limits.pullback.lift_snd, ← hyk 0, Category.assoc, hp2]
    have hGaff : ∀ {i j : AsSmall.{u} ℕᵒᵖ} (f : i ⟶ j), IsAffineHom (G.map f) := by
      rintro ⟨⟨l⟩⟩ ⟨⟨k⟩⟩ f
      exact hFaff _ (haffE k l f.down)
    have hB := isBasis_preimage_isAffineOpen G c hc
    have hnb : ∀ {U : TopologicalSpace.Opens ↥c.pt} {x : ↥c.pt}, x ∈ U →
        ∃ U' ∈ {x | ∃ i V, ∃ (_ : IsAffineOpen V), c.π.app i ⁻¹ᵁ V = x}, x ∈ U' ∧ U' ≤ U :=
      TopologicalSpace.Opens.isBasis_iff_nbhd.mp hB
    obtain ⟨U', ⟨i, A, hA, rfl⟩, hεU', hU'O⟩ :=
      @hnb ⟨O, hO⟩ ε (show ε ∈ (⟨O, hO⟩ : TopologicalSpace.Opens _) from hε)
    rcases i with ⟨⟨k⟩⟩
    exact ⟨k, A, p k, hp1 k, hp2 k, hA, hεU', fun e he => hU'O he⟩
  exact key (D ⋙ Scheme.ProEt.forget S) ((Scheme.ProEt.forget S).obj Uinf)
    (fun k => (Scheme.ProEt.forget S).map (a k)) hnat hlim haffG O hO ε hε

theorem wc_epsInv_descent_square : ∀ (S : Scheme.{u}) (P : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) {Uinf : S.ProEt} (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k)) (x : P.obj (Opposite.op Uinf)) (τ : Uinf.left) (k : ℕ) (V₁ : S.Etale) (s₀ : P.obj (Opposite.op ((wcEtToProEt S).obj V₁))) (O : Set ↥(Limits.pullback Uinf.hom V₁.hom)) (hOx : ∀ (W' : S.ProEt) (k₁ : W' ⟶ Uinf) (k₂ : W' ⟶ (wcEtToProEt S).obj V₁) (κ : W'.left ⟶ Limits.pullback Uinf.hom V₁.hom), κ ≫ Limits.pullback.fst Uinf.hom V₁.hom = k₁.left → κ ≫ Limits.pullback.snd Uinf.hom V₁.hom = k₂.left → Set.range κ ⊆ O → P.map k₁.op x = P.map k₂.op s₀) (A : (Limits.pullback (D.obj (Opposite.op k)).hom V₁.hom).Opens) (hA : IsAffineOpen A) (π : Limits.pullback Uinf.hom V₁.hom ⟶ Limits.pullback (D.obj (Opposite.op k)).hom V₁.hom) (hπ1 : π ≫ Limits.pullback.fst (D.obj (Opposite.op k)).hom V₁.hom = Limits.pullback.fst Uinf.hom V₁.hom ≫ (a k).left) (hπ2 : π ≫ Limits.pullback.snd (D.obj (Opposite.op k)).hom V₁.hom = Limits.pullback.snd Uinf.hom V₁.hom) (ε : ↥(Limits.pullback Uinf.hom V₁.hom)) (hεA : π ε ∈ A) (hAO : ∀ e, π e ∈ A → e ∈ O) (hετ : Limits.pullback.fst Uinf.hom V₁.hom ε = τ), ∃ (N : S.ProEt) (n : N ⟶ D.obj (Opposite.op k)) (s : P.obj (Opposite.op N)) (N' : S.ProEt) (q₁ : N' ⟶ N) (q₂ : N' ⟶ Uinf), IsAffine N.left ∧ Etale n.left ∧ IsPullback q₁.left q₂.left n.left (a k).left ∧ τ ∈ Set.range q₂.left ∧ P.map q₁.op s = P.map q₂.op x :=
by
  intro S P Uinf D a x τ k V₁ s₀ O hOx A hA π hπ1 hπ2 ε hεA hAO hετ

  have hpaste : ∀ {X X' V T : Scheme.{u}} (f : X ⟶ T) (f' : X' ⟶ T) (g : V ⟶ T) (b : X' ⟶ X)
      (_hb : b ≫ f = f') (π : Limits.pullback f' g ⟶ Limits.pullback f g)
      (_h1 : π ≫ Limits.pullback.fst f g = Limits.pullback.fst f' g ≫ b)
      (_h2 : π ≫ Limits.pullback.snd f g = Limits.pullback.snd f' g)
      (A : (Limits.pullback f g).Opens),
      IsPullback (π ∣_ A) ((π ⁻¹ᵁ A).ι ≫ Limits.pullback.fst f' g)
        (A.ι ≫ Limits.pullback.fst f g) b := by
    intro X X' V T f f' g b hb π h1 h2 A
    subst hb
    have H1 : IsPullback π (Limits.pullback.fst (b ≫ f) g) (Limits.pullback.fst f g) b := by
      refine IsPullback.of_right (h₁₂ := Limits.pullback.snd f g) (h₂₂ := f) (v₁₃ := g) ?_ h1
        (IsPullback.of_hasPullback f g).flip
      rw [h2]
      exact (IsPullback.of_hasPullback (b ≫ f) g).flip
    exact (isPullback_morphismRestrict π A).paste_vert H1
  haveI : Etale V₁.hom := V₁.prop
  haveI : WeaklyEtale (D.obj (Opposite.op k)).hom := (D.obj (Opposite.op k)).prop
  haveI : WeaklyEtale Uinf.hom := Uinf.prop
  have hnEt : Etale (A.ι ≫ Limits.pullback.fst (D.obj (Opposite.op k)).hom V₁.hom) :=
    inferInstance
  have hNW : WeaklyEtale (A.ι ≫ Limits.pullback.fst (D.obj (Opposite.op k)).hom V₁.hom ≫
      (D.obj (Opposite.op k)).hom) := by
    rw [← Category.assoc]; infer_instance
  let N : S.ProEt := MorphismProperty.Over.mk ⊤
    (A.ι ≫ Limits.pullback.fst (D.obj (Opposite.op k)).hom V₁.hom ≫ (D.obj (Opposite.op k)).hom) hNW
  let n : N ⟶ D.obj (Opposite.op k) := MorphismProperty.Over.homMk
    (A.ι ≫ Limits.pullback.fst (D.obj (Opposite.op k)).hom V₁.hom) (Category.assoc _ _ _) trivial
  have hmw : (A.ι ≫ Limits.pullback.snd (D.obj (Opposite.op k)).hom V₁.hom) ≫
      ((wcEtToProEt S).obj V₁).hom = N.hom := by
    change (A.ι ≫ Limits.pullback.snd (D.obj (Opposite.op k)).hom V₁.hom) ≫ V₁.hom =
      A.ι ≫ Limits.pullback.fst (D.obj (Opposite.op k)).hom V₁.hom ≫ (D.obj (Opposite.op k)).hom
    rw [Category.assoc, ← Limits.pullback.condition]
  let m : N ⟶ (wcEtToProEt S).obj V₁ := MorphismProperty.Over.homMk
    (A.ι ≫ Limits.pullback.snd (D.obj (Opposite.op k)).hom V₁.hom) hmw trivial
  have hN'W : WeaklyEtale ((π ⁻¹ᵁ A).ι ≫ Limits.pullback.fst Uinf.hom V₁.hom ≫ Uinf.hom) := by
    rw [← Category.assoc]; infer_instance
  let N' : S.ProEt := MorphismProperty.Over.mk ⊤
    ((π ⁻¹ᵁ A).ι ≫ Limits.pullback.fst Uinf.hom V₁.hom ≫ Uinf.hom) hN'W
  let q₂ : N' ⟶ Uinf := MorphismProperty.Over.homMk
    ((π ⁻¹ᵁ A).ι ≫ Limits.pullback.fst Uinf.hom V₁.hom) (Category.assoc _ _ _) trivial
  have H := hpaste (D.obj (Opposite.op k)).hom Uinf.hom V₁.hom (a k).left
    (MorphismProperty.Over.w (a k)) π hπ1 hπ2 A
  have hq₁w : (π ∣_ A) ≫ N.hom = N'.hom := by
    change (π ∣_ A) ≫ A.ι ≫ Limits.pullback.fst (D.obj (Opposite.op k)).hom V₁.hom ≫
        (D.obj (Opposite.op k)).hom =
      (π ⁻¹ᵁ A).ι ≫ Limits.pullback.fst Uinf.hom V₁.hom ≫ Uinf.hom
    calc (π ∣_ A) ≫ A.ι ≫ Limits.pullback.fst (D.obj (Opposite.op k)).hom V₁.hom ≫
          (D.obj (Opposite.op k)).hom
        = ((π ∣_ A) ≫ (A.ι ≫ Limits.pullback.fst (D.obj (Opposite.op k)).hom V₁.hom)) ≫
          (D.obj (Opposite.op k)).hom := by simp only [Category.assoc]
      _ = (((π ⁻¹ᵁ A).ι ≫ Limits.pullback.fst Uinf.hom V₁.hom) ≫ (a k).left) ≫
          (D.obj (Opposite.op k)).hom := by rw [H.w]
      _ = (π ⁻¹ᵁ A).ι ≫ Limits.pullback.fst Uinf.hom V₁.hom ≫ Uinf.hom := by
          simp only [Category.assoc, MorphismProperty.Over.w (a k)]
  let q₁ : N' ⟶ N := MorphismProperty.Over.homMk (π ∣_ A) hq₁w trivial
  refine ⟨N, n, P.map m.op s₀, N', q₁, q₂, hA, hnEt, H, ?_, ?_⟩
  · have hεB : ε ∈ Set.range (π ⁻¹ᵁ A).ι := by
      rw [Scheme.Opens.range_ι, Scheme.Hom.coe_preimage]
      exact hεA
    obtain ⟨p, hp⟩ := hεB
    refine ⟨p, ?_⟩
    change ((π ⁻¹ᵁ A).ι ≫ Limits.pullback.fst Uinf.hom V₁.hom) p = τ
    rw [Scheme.Hom.comp_apply, hp, hετ]
  · have r := hOx N' q₂ (q₁ ≫ m) (π ⁻¹ᵁ A).ι rfl ?_ ?_
    · rw [r, op_comp, Functor.map_comp]
      rfl
    · change _ = (π ∣_ A) ≫ A.ι ≫ Limits.pullback.snd (D.obj (Opposite.op k)).hom V₁.hom
      rw [← Category.assoc, morphismRestrict_ι, Category.assoc, hπ2] <;> rfl
    · intro e he
      have h2 : Set.range (π ⁻¹ᵁ A).ι = π ⁻¹' (A : Set _) := by
        rw [Scheme.Opens.range_ι, Scheme.Hom.coe_preimage]
      exact hAO e (h2.le he)

theorem wc_epsInv_local_descent (S : Scheme.{u})
    (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
    (hZL : ∀ (T : S.ProEt) (y : ((wcEpsInv S).obj G).obj.obj (Opposite.op T)),
      ∃ O : Set T.left, IsOpen O ∧ ∀ (W : S.ProEt) (k : W ⟶ T),
        (((wcEpsInv S).obj G).obj.map k.op y = 0 ↔ Set.range k.left ⊆ O))
    {Uinf : S.ProEt} (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left)
    (x : ((wcEpsInv S).obj G).obj.obj (Opposite.op Uinf)) (τ : Uinf.left) :
    ∃ (k : ℕ) (N : S.ProEt) (n : N ⟶ D.obj (Opposite.op k))
      (s : ((wcEpsInv S).obj G).obj.obj (Opposite.op N))
      (N' : S.ProEt) (q₁ : N' ⟶ N) (q₂ : N' ⟶ Uinf),
      IsAffine N.left ∧ Etale n.left ∧ IsPullback q₁.left q₂.left n.left (a k).left ∧
        τ ∈ Set.range q₂.left ∧
        ((wcEpsInv S).obj G).obj.map q₁.op s = ((wcEpsInv S).obj G).obj.map q₂.op x :=
by
  obtain ⟨W, f, V₁, c, s₀, ⟨w, hw⟩, hfc⟩ := wc_epsInv_locally_etale_section S G Uinf x τ
  obtain ⟨O, hO, hlift, hOx⟩ :=
    wc_proet_agreement_open S ((wcEpsInv S).obj G) hZL Uinf x V₁ s₀ W f c hfc
  obtain ⟨ε, hεO, hετ⟩ := hlift w
  obtain ⟨k, A, π, hπ1, hπ2, hA, hεA, hAO⟩ :=
    wc_tower_basechange_affine_nbhd S D a ha hlim haff V₁.left V₁.hom O hO ε hεO
  obtain ⟨N, n, s, N', q₁, q₂, h1, h2, h3, h4, h5⟩ :=
    wc_epsInv_descent_square S ((wcEpsInv S).obj G).obj D a x τ k V₁ s₀ O hOx A hA π hπ1 hπ2
      ε hεA hAO (hετ.trans hw)
  exact ⟨k, N, n, s, N', q₁, q₂, h1, h2, h3, h4, h5⟩

theorem wc_tsl_base_change (S : Scheme.{u}) {Uinf : S.ProEt} (D : ℕᵒᵖ ⥤ S.ProEt)
    (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left)
    (k L : ℕ) (hkL : k ≤ L) (N : S.ProEt) (n : N ⟶ D.obj (Opposite.op k)) (N' : S.ProEt)
    (q₁ : N' ⟶ N) (q₂ : N' ⟶ Uinf) (hN : IsAffine N.left) (hn : Etale n.left)
    (hpb : IsPullback q₁.left q₂.left n.left (a k).left) :
    ∃ (N₂ : S.ProEt) (n₂ : N₂ ⟶ D.obj (Opposite.op L)) (r : N₂ ⟶ N) (q₃ : N' ⟶ N₂),
      IsAffine N₂.left ∧ Etale n₂.left ∧ IsPullback q₃.left q₂.left n₂.left (a L).left ∧
      r ≫ n = n₂ ≫ D.map (homOfLE hkL).op ∧ q₃ ≫ r = q₁ ∧
      ∀ z : (D.obj (Opposite.op L)).left,
        (D.map (homOfLE hkL).op).left z ∈ Set.range n.left → z ∈ Set.range n₂.left :=
by
  classical
  have HA : a L ≫ D.map (homOfLE hkL).op = a k := by
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hkL
    exact ha k j
  have HAFF : IsAffineHom (D.map (homOfLE hkL).op).left := by
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hkL
    exact haff k j
  generalize D.map (homOfLE hkL).op = t at HA HAFF ⊢
  have HAl : (a L).left ≫ t.left = (a k).left := by rw [← HA]; rfl
  haveI : Etale n.left := hn
  haveI : IsAffineHom t.left := HAFF
  haveI : IsAffine N.left := hN
  haveI : WeaklyEtale (D.obj (Opposite.op L)).hom := (D.obj (Opposite.op L)).prop
  have hE : q₁.left ≫ n.left = (q₂.left ≫ (a L).left) ≫ t.left := by
    rw [Category.assoc, HAl]; exact hpb.toCommSq.w
  refine ⟨Scheme.ProEt.mk (Limits.pullback.snd n.left t.left ≫ (D.obj (Opposite.op L)).hom),
    MorphismProperty.Over.homMk (Limits.pullback.snd n.left t.left) rfl trivial,
    MorphismProperty.Over.homMk (Limits.pullback.fst n.left t.left) ?_ trivial,
    MorphismProperty.Over.homMk (Limits.pullback.lift q₁.left (q₂.left ≫ (a L).left) hE) ?_ trivial,
    ?_, ?_, ?_, ?_, ?_, ?_⟩
  · show Limits.pullback.fst n.left t.left ≫ N.hom =
      Limits.pullback.snd n.left t.left ≫ (D.obj (Opposite.op L)).hom
    rw [← MorphismProperty.Over.w n, ← Category.assoc, Limits.pullback.condition, Category.assoc,
      MorphismProperty.Over.w t]
  · show Limits.pullback.lift q₁.left (q₂.left ≫ (a L).left) hE ≫
      Limits.pullback.snd n.left t.left ≫ (D.obj (Opposite.op L)).hom = N'.hom
    rw [← Category.assoc, Limits.pullback.lift_snd, Category.assoc, MorphismProperty.Over.w (a L),
      MorphismProperty.Over.w q₂]
  · show IsAffine (Limits.pullback n.left t.left)
    haveI : IsAffineHom (Limits.pullback.fst n.left t.left) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasPullback n.left t.left).flip HAFF
    exact isAffine_of_isAffineHom (Limits.pullback.fst n.left t.left)
  · show Etale (Limits.pullback.snd n.left t.left)
    infer_instance
  · show IsPullback (Limits.pullback.lift q₁.left (q₂.left ≫ (a L).left) hE) q₂.left
      (Limits.pullback.snd n.left t.left) (a L).left
    refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _)
      (IsPullback.of_hasPullback n.left t.left)
    rw [Limits.pullback.lift_fst, HAl]
    exact hpb
  · apply MorphismProperty.Over.Hom.ext
    show Limits.pullback.fst n.left t.left ≫ n.left = Limits.pullback.snd n.left t.left ≫ t.left
    exact Limits.pullback.condition
  · apply MorphismProperty.Over.Hom.ext
    show Limits.pullback.lift q₁.left (q₂.left ≫ (a L).left) hE ≫
      Limits.pullback.fst n.left t.left = q₁.left
    exact Limits.pullback.lift_fst _ _ _
  · rintro z ⟨p, hp⟩
    obtain ⟨w, _, hw2⟩ := Scheme.Pullback.exists_preimage_pullback p z hp
    exact ⟨w, hw2⟩

theorem wc_tsl_pair_agree (S : Scheme.{u})
    (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (hZL : ∀ (T : S.ProEt) (y : P.obj.obj (Opposite.op T)),
      ∃ O : Set T.left, IsOpen O ∧ ∀ (W : S.ProEt) (k : W ⟶ T),
        (P.obj.map k.op y = 0 ↔ Set.range k.left ⊆ O))
    {U Uinf : S.ProEt} (aU : Uinf ⟶ U) (hqs : QuasiSeparatedSpace U.left)
    (x : P.obj.obj (Opposite.op Uinf))
    (N₁ N₂ : S.ProEt) (n₁ : N₁ ⟶ U) (n₂ : N₂ ⟶ U)
    (s₁ : P.obj.obj (Opposite.op N₁)) (s₂ : P.obj.obj (Opposite.op N₂))
    (N₁' N₂' : S.ProEt) (q₁₁ : N₁' ⟶ N₁) (q₁₂ : N₁' ⟶ Uinf) (q₂₁ : N₂' ⟶ N₂) (q₂₂ : N₂' ⟶ Uinf)
    (hN₁ : IsAffine N₁.left) (hN₂ : IsAffine N₂.left) (hn₁ : Etale n₁.left) (hn₂ : Etale n₂.left)
    (hpb₁ : IsPullback q₁₁.left q₁₂.left n₁.left aU.left)
    (hpb₂ : IsPullback q₂₁.left q₂₂.left n₂.left aU.left)
    (hx₁ : P.obj.map q₁₁.op s₁ = P.obj.map q₁₂.op x)
    (hx₂ : P.obj.map q₂₁.op s₂ = P.obj.map q₂₂.op x) :
    ∃ (M : Scheme.{u}) (_ : CompactSpace M) (g : M ⟶ U.left) (O : Set M), IsOpen O ∧
      (∀ (m : M) (z : Uinf.left), g m = aU.left z → m ∈ O) ∧
      ∀ (Z : S.ProEt) (g₁ : Z ⟶ N₁) (g₂ : Z ⟶ N₂), g₁ ≫ n₁ = g₂ ≫ n₂ →
        (∀ (m : M) (ζ : Z.left), g m = n₁.left (g₁.left ζ) → m ∈ O) →
        P.obj.map g₁.op s₁ = P.obj.map g₂.op s₂ :=
by
  classical
  haveI := hN₁
  haveI := hN₂
  haveI := hqs
  haveI := hn₁
  haveI := hn₂
  have hPc : ∀ {A B C : S.ProEt} (f : A ⟶ B) (g : B ⟶ C) (v : P.obj.obj (Opposite.op C)),
      P.obj.map f.op (P.obj.map g.op v) = P.obj.map (f ≫ g).op v := by
    intro A B C f g v
    first
      | (rw [op_comp, Functor.map_comp]; rfl)
      | simp [op_comp, Functor.map_comp]

  have hlift : ∀ (N N' : S.ProEt) (n : N ⟶ U) (s : P.obj.obj (Opposite.op N))
      (q₁ : N' ⟶ N) (q₂ : N' ⟶ Uinf) (_ : IsPullback q₁.left q₂.left n.left aU.left)
      (_ : P.obj.map q₁.op s = P.obj.map q₂.op x) (W : S.ProEt) (w₁ : W ⟶ N) (w₂ : W ⟶ Uinf)
      (_ : w₁.left ≫ n.left = w₂.left ≫ aU.left), P.obj.map w₁.op s = P.obj.map w₂.op x := by
    intro N N' n s q₁ q₂ hpb hx W w₁ w₂ hw
    let ℓ : W ⟶ N' := MorphismProperty.Over.homMk (hpb.lift w₁.left w₂.left hw) (by
      rw [← MorphismProperty.Over.w q₂, ← Category.assoc, IsPullback.lift_snd,
        MorphismProperty.Over.w w₂])
    have h1 : ℓ ≫ q₁ = w₁ := MorphismProperty.Over.Hom.ext
      (IsPullback.lift_fst hpb w₁.left w₂.left hw)
    have h2 : ℓ ≫ q₂ = w₂ := MorphismProperty.Over.Hom.ext
      (IsPullback.lift_snd hpb w₁.left w₂.left hw)
    rw [← h1, ← h2, ← hPc, ← hPc, hx]

  haveI : QuasiCompact n₂.left := quasiCompact_of_compactSpace n₂.left
  haveI hMc : CompactSpace (Limits.pullback n₁.left n₂.left : Scheme.{u}) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst n₁.left n₂.left)
  have hpc : Limits.pullback.fst n₁.left n₂.left ≫ n₁.left =
      Limits.pullback.snd n₁.left n₂.left ≫ n₂.left := Limits.pullback.condition
  let Mo : S.ProEt := MorphismProperty.Over.mk ⊤
    (Limits.pullback.fst n₁.left n₂.left ≫ N₁.hom) (by haveI := N₁.prop; infer_instance)
  let π₁ : Mo ⟶ N₁ := MorphismProperty.Over.homMk (Limits.pullback.fst n₁.left n₂.left) rfl
  let π₂ : Mo ⟶ N₂ := MorphismProperty.Over.homMk (Limits.pullback.snd n₁.left n₂.left) (by
    show Limits.pullback.snd n₁.left n₂.left ≫ N₂.hom =
      Limits.pullback.fst n₁.left n₂.left ≫ N₁.hom
    rw [← MorphismProperty.Over.w n₂, ← MorphismProperty.Over.w n₁]
    have := hpc =≫ U.hom
    simpa only [Category.assoc] using this.symm)
  obtain ⟨O, hO, hOiff⟩ := hZL Mo (P.obj.map π₁.op s₁ - P.obj.map π₂.op s₂)
  have hsub : ∀ {W : S.ProEt} (k : W ⟶ Mo),
      P.obj.map k.op (P.obj.map π₁.op s₁ - P.obj.map π₂.op s₂) =
        P.obj.map (k ≫ π₁).op s₁ - P.obj.map (k ≫ π₂).op s₂ := by
    intro W k
    rw [map_sub, hPc, hPc]
  refine ⟨Limits.pullback n₁.left n₂.left, hMc, Limits.pullback.fst n₁.left n₂.left ≫ n₁.left,
    O, hO, ?_, ?_⟩
  ·
    intro m z hmz
    let Qo : S.ProEt := MorphismProperty.Over.mk ⊤
      (Limits.pullback.snd (Limits.pullback.fst n₁.left n₂.left ≫ n₁.left) aU.left ≫ Uinf.hom)
      (by haveI := Uinf.prop; infer_instance)
    have hqc : Limits.pullback.fst (Limits.pullback.fst n₁.left n₂.left ≫ n₁.left) aU.left ≫
        (Limits.pullback.fst n₁.left n₂.left ≫ n₁.left) =
        Limits.pullback.snd (Limits.pullback.fst n₁.left n₂.left ≫ n₁.left) aU.left ≫ aU.left :=
      Limits.pullback.condition
    let κ : Qo ⟶ Mo := MorphismProperty.Over.homMk
      (Limits.pullback.fst (Limits.pullback.fst n₁.left n₂.left ≫ n₁.left) aU.left) (by
        show Limits.pullback.fst (Limits.pullback.fst n₁.left n₂.left ≫ n₁.left) aU.left ≫
            Limits.pullback.fst n₁.left n₂.left ≫ N₁.hom =
          Limits.pullback.snd (Limits.pullback.fst n₁.left n₂.left ≫ n₁.left) aU.left ≫ Uinf.hom
        rw [← MorphismProperty.Over.w n₁, ← MorphismProperty.Over.w aU]
        have := hqc =≫ U.hom
        simpa only [Category.assoc] using this)
    let πi : Qo ⟶ Uinf := MorphismProperty.Over.homMk
      (Limits.pullback.snd (Limits.pullback.fst n₁.left n₂.left ≫ n₁.left) aU.left) rfl
    have E1 : (κ ≫ π₁).left ≫ n₁.left = πi.left ≫ aU.left := by
      show (Limits.pullback.fst (Limits.pullback.fst n₁.left n₂.left ≫ n₁.left) aU.left ≫
          Limits.pullback.fst n₁.left n₂.left) ≫ n₁.left =
        Limits.pullback.snd (Limits.pullback.fst n₁.left n₂.left ≫ n₁.left) aU.left ≫ aU.left
      rw [Category.assoc]
      exact hqc
    have E2 : (κ ≫ π₂).left ≫ n₂.left = πi.left ≫ aU.left := by
      show (Limits.pullback.fst (Limits.pullback.fst n₁.left n₂.left ≫ n₁.left) aU.left ≫
          Limits.pullback.snd n₁.left n₂.left) ≫ n₂.left =
        Limits.pullback.snd (Limits.pullback.fst n₁.left n₂.left ≫ n₁.left) aU.left ≫ aU.left
      rw [Category.assoc, ← hpc]
      exact hqc
    have e1 := hlift N₁ N₁' n₁ s₁ q₁₁ q₁₂ hpb₁ hx₁ Qo (κ ≫ π₁) πi E1
    have e2 := hlift N₂ N₂' n₂ s₂ q₂₁ q₂₂ hpb₂ hx₂ Qo (κ ≫ π₂) πi E2
    have h0 : P.obj.map κ.op (P.obj.map π₁.op s₁ - P.obj.map π₂.op s₂) = 0 := by
      rw [hsub, e1, e2, sub_self]
    have hr := (hOiff Qo κ).1 h0
    obtain ⟨q, hq1, -⟩ := Scheme.Pullback.exists_preimage_pullback m z hmz
    exact hr ⟨q, hq1⟩
  ·
    intro Z g₁ g₂ hg hpt
    have e : g₁.left ≫ n₁.left = g₂.left ≫ n₂.left := congrArg (fun f => f.left) hg
    let hh : Z ⟶ Mo := MorphismProperty.Over.homMk (Limits.pullback.lift g₁.left g₂.left e) (by
      show Limits.pullback.lift g₁.left g₂.left e ≫ Limits.pullback.fst n₁.left n₂.left ≫ N₁.hom =
        Z.hom
      rw [Limits.pullback.lift_fst_assoc, MorphismProperty.Over.w g₁])
    have h1 : hh ≫ π₁ = g₁ := MorphismProperty.Over.Hom.ext
      (Limits.pullback.lift_fst g₁.left g₂.left e)
    have h2 : hh ≫ π₂ = g₂ := MorphismProperty.Over.Hom.ext
      (Limits.pullback.lift_snd g₁.left g₂.left e)
    have hr : Set.range hh.left ⊆ O := by
      rintro _ ⟨ζ, rfl⟩
      apply hpt _ ζ
      have hl : Limits.pullback.lift g₁.left g₂.left e ≫ Limits.pullback.fst n₁.left n₂.left ≫
          n₁.left = g₁.left ≫ n₁.left := by
        rw [Limits.pullback.lift_fst_assoc]
      have hl' := congrArg (fun f : Z.left ⟶ U.left => f ζ) hl
      simp only [Scheme.Hom.comp_apply] at hl'
      change n₁.left (Limits.pullback.fst n₁.left n₂.left
        (Limits.pullback.lift g₁.left g₂.left e ζ)) = n₁.left (g₁.left ζ)
      first | exact hl' | simpa using hl'
    have h0 := (hOiff Z hh).2 hr
    rw [hsub, h1, h2] at h0
    exact sub_eq_zero.mp h0

theorem wc_tsl_glue_check (S : Scheme.{u})
    (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (hZL : ∀ (T : S.ProEt) (y : P.obj.obj (Opposite.op T)),
      ∃ O : Set T.left, IsOpen O ∧ ∀ (W : S.ProEt) (k : W ⟶ T),
        (P.obj.map k.op y = 0 ↔ Set.range k.left ⊆ O))
    {U Uinf : S.ProEt} (aU : Uinf ⟶ U) (m : ℕ) (N : Fin m → S.ProEt) (n : ∀ i, N i ⟶ U)
    (s : ∀ i, P.obj.obj (Opposite.op (N i))) (N' : Fin m → S.ProEt)
    (q₁ : ∀ i, N' i ⟶ N i) (q₂ : ∀ i, N' i ⟶ Uinf) (x : P.obj.obj (Opposite.op Uinf))
    (hcovU : Sieve.generate (Presieve.ofArrows N n) ∈ Scheme.ProEt.topology S U)
    (hcov : ∀ τ : Uinf.left, ∃ i, τ ∈ Set.range (q₂ i).left)
    (hsq : ∀ i, q₁ i ≫ n i = q₂ i ≫ aU)
    (hcomp : ∀ (i j : Fin m) (Z : S.ProEt) (gi : Z ⟶ N i) (gj : Z ⟶ N j),
      gi ≫ n i = gj ≫ n j → P.obj.map gi.op (s i) = P.obj.map gj.op (s j))
    (hx : ∀ i, P.obj.map (q₁ i).op (s i) = P.obj.map (q₂ i).op x) :
    ∃ y : P.obj.obj (Opposite.op U), P.obj.map aU.op y = x :=
by
  classical
  have hP : Presieve.IsSheaf (Scheme.ProEt.topology S) (P.obj ⋙ forget AddCommGrpCat) :=
    (isSheaf_iff_isSheaf_of_type (Scheme.ProEt.topology S) (P.obj ⋙ forget AddCommGrpCat)).mp
      ((Presheaf.isSheaf_iff_isSheaf_forget (Scheme.ProEt.topology S) P.obj
        (forget AddCommGrpCat)).mp P.property)
  have hSF := hP.isSheafFor (Presieve.ofArrows N n) hcovU
  obtain ⟨y, hy, -⟩ := (Presieve.isSheafFor_arrows_iff (P.obj ⋙ forget AddCommGrpCat) n).mp hSF s
    (fun i j Z gi gj h => hcomp i j Z gi gj h)
  have hy' : ∀ i, P.obj.map (n i).op y = s i := fun i => hy i
  have hPc : ∀ {A B C : S.ProEt} (f : A ⟶ B) (g : B ⟶ C) (v : P.obj.obj (Opposite.op C)),
      P.obj.map f.op (P.obj.map g.op v) = P.obj.map (f ≫ g).op v := by
    intro A B C f g v
    first
      | (rw [op_comp, Functor.map_comp]; rfl)
      | simp [op_comp, Functor.map_comp]
  have h4 : ∀ i, P.obj.map (q₂ i).op (P.obj.map aU.op y - x) = 0 := by
    intro i
    have e1 : P.obj.map (q₂ i).op (P.obj.map aU.op y - x) =
        P.obj.map (q₂ i).op (P.obj.map aU.op y) - P.obj.map (q₂ i).op x :=
      map_sub (P.obj.map (q₂ i).op).hom _ _
    rw [e1, hPc, ← hsq i, ← hPc, hy', hx, sub_self]
  obtain ⟨O, hO, hOiff⟩ := hZL Uinf (P.obj.map aU.op y - x)
  have hr : ∀ i, Set.range (q₂ i).left ⊆ O := fun i => (hOiff (N' i) (q₂ i)).mp (h4 i)
  have h0 := (hOiff Uinf (𝟙 Uinf)).mpr (by
    intro p _
    obtain ⟨i, hi⟩ := hcov p
    exact hr i hi)
  have hδ : P.obj.map aU.op y - x = 0 := by
    first
      | (rw [op_id, Functor.map_id] at h0; exact h0)
      | (rw [op_id, Functor.map_id] at h0; simpa using h0)
      | simpa using h0
  exact ⟨y, sub_eq_zero.mp hδ⟩

theorem wc_tower_surj_of_local (S : Scheme.{u})
    (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (hZL : ∀ (T : S.ProEt) (y : P.obj.obj (Opposite.op T)),
      ∃ O : Set T.left, IsOpen O ∧ ∀ (W : S.ProEt) (k : W ⟶ T),
        (P.obj.map k.op y = 0 ↔ Set.range k.left ⊆ O))
    {Uinf : S.ProEt} (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left)
    (hcU : CompactSpace Uinf.left) (hqU : QuasiSeparatedSpace Uinf.left)
    (x : P.obj.obj (Opposite.op Uinf))
    (hloc : ∀ τ : Uinf.left, ∃ (k : ℕ) (N : S.ProEt) (n : N ⟶ D.obj (Opposite.op k))
      (s : P.obj.obj (Opposite.op N)) (N' : S.ProEt) (q₁ : N' ⟶ N) (q₂ : N' ⟶ Uinf),
      IsAffine N.left ∧ Etale n.left ∧ IsPullback q₁.left q₂.left n.left (a k).left ∧
        τ ∈ Set.range q₂.left ∧ P.obj.map q₁.op s = P.obj.map q₂.op x) :
    ∃ k, ∃ y : P.obj.obj (Opposite.op (D.obj (Opposite.op k))), P.obj.map (a k).op y = x :=
by
  classical

  have hPc : ∀ {A B C : S.ProEt} (f : A ⟶ B) (g : B ⟶ C) (v : P.obj.obj (Opposite.op C)),
      P.obj.map f.op (P.obj.map g.op v) = P.obj.map (f ≫ g).op v := by
    intro A B C f g v
    first
      | (rw [op_comp, Functor.map_comp]; rfl)
      | simp [op_comp, Functor.map_comp]

  have hhom : ∀ k l (f g : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k), f = g := by
    intro k l f g
    exact Quiver.Hom.unop_inj (Subsingleton.elim _ _)
  have hDc : ∀ k l n (h₁ : k ≤ l) (h₂ : l ≤ n),
      D.map (homOfLE h₂).op ≫ D.map (homOfLE h₁).op = D.map (homOfLE (h₁.trans h₂)).op := by
    intro k l n h₁ h₂
    rw [← D.map_comp]
    exact congrArg D.map (hhom _ _ _ _)
  have hTR : ∀ k₁ k₂ k₃ (h₁ : k₁ ≤ k₂) (h₂ : k₂ ≤ k₃) (z : (D.obj (Opposite.op k₃)).left),
      (D.map (homOfLE h₁).op).left ((D.map (homOfLE h₂).op).left z) =
        (D.map (homOfLE (h₁.trans h₂)).op).left z := by
    intro k₁ k₂ k₃ h₁ h₂ z
    have e2 : ((D.map (homOfLE h₂).op ≫ D.map (homOfLE h₁).op).left) z =
        (D.map (homOfLE (h₁.trans h₂)).op).left z := by rw [hDc]
    simp only [MorphismProperty.Comma.comp_left, Scheme.Hom.comp_apply] at e2
    exact e2

  choose kk N n s N' q₁ q₂ hNa hne hpb hτ hag using hloc
  have hopen : ∀ τ, IsOpen (Set.range (q₂ τ).left) := by
    intro τ
    haveI : Etale (q₂ τ).left := MorphismProperty.of_isPullback (P := @Etale) (hpb τ) (hne τ)
    exact (q₂ τ).left.isOpenMap.isOpen_range
  obtain ⟨m, τi, hCOV⟩ : ∃ (m : ℕ) (τi : Fin m → Uinf.left),
      ∀ τ' : Uinf.left, ∃ i, τ' ∈ Set.range (q₂ (τi i)).left := by
    haveI := hcU
    obtain ⟨T, hT⟩ := (isCompact_univ : IsCompact (Set.univ : Set Uinf.left)).elim_finite_subcover
      (fun τ => Set.range (q₂ τ).left) hopen (fun τ _ => Set.mem_iUnion.2 ⟨τ, hτ τ⟩)
    refine ⟨T.card, fun i => (T.equivFin.symm i).1, fun τ' => ?_⟩
    have h1 := hT (Set.mem_univ τ')
    simp only [Set.mem_iUnion] at h1
    obtain ⟨τ, hτT, hmem⟩ := h1
    refine ⟨T.equivFin ⟨τ, hτT⟩, ?_⟩
    have hse : T.equivFin.symm (T.equivFin ⟨τ, hτT⟩) = ⟨τ, hτT⟩ := Equiv.symm_apply_apply _ _
    show τ' ∈ Set.range (q₂ (T.equivFin.symm (T.equivFin ⟨τ, hτT⟩)).1).left
    rw [hse]
    exact hmem

  obtain ⟨K, hkK⟩ : ∃ K, ∀ i, kk (τi i) ≤ K :=
    ⟨Finset.univ.sup (fun i : Fin m => kk (τi i)),
      fun i => Finset.le_sup (f := fun i : Fin m => kk (τi i)) (Finset.mem_univ i)⟩
  have hbc1 := fun i => wc_tsl_base_change S D a ha haff (kk (τi i)) K (hkK i) (N (τi i))
    (n (τi i)) (N' (τi i)) (q₁ (τi i)) (q₂ (τi i)) (hNa _) (hne _) (hpb _)
  choose NK nK rK q₃ hNKa hnKe hpbK hrK hq₃ hptK using hbc1
  obtain ⟨sK, hsK⟩ : ∃ sK : ∀ i, P.obj.obj (Opposite.op (NK i)),
      ∀ i, sK i = P.obj.map (rK i).op (s (τi i)) := ⟨_, fun _ => rfl⟩
  have hAGK : ∀ i, P.obj.map (q₃ i).op (sK i) = P.obj.map (q₂ (τi i)).op x := by
    intro i
    rw [hsK, hPc, hq₃ i]
    exact hag _

  have hΩo : IsOpen (⋃ i, Set.range (nK i).left) := isOpen_iUnion (fun i => by
    haveI := hnKe i
    exact (nK i).left.isOpenMap.isOpen_range)
  haveI := (hqc K).1
  obtain ⟨j₁, hj₁⟩ := wc_tower_fibre_open_absorb S D a ha hlim hqc haff K
    (D.obj (Opposite.op K)).left (𝟙 _) _ hΩo (by
      intro μ z hμz
      obtain ⟨i, w, hw⟩ := hCOV z
      refine Set.mem_iUnion.2 ⟨i, (q₃ i).left w, ?_⟩
      have e : ((q₃ i).left ≫ (nK i).left) w = ((q₂ (τi i)).left ≫ (a K).left) w := by
        rw [(hpbK i).toCommSq.w]
      simp only [Scheme.Hom.comp_apply] at e
      rw [e, hw, ← hμz]
      first | rfl | simp)
  have hJS : ∀ L (hKL : K ≤ L) (h1 : K + j₁ ≤ L) (z : (D.obj (Opposite.op L)).left),
      ∃ i, (D.map (homOfLE hKL).op).left z ∈ Set.range (nK i).left := by
    intro L hKL h1 z
    have hm := hj₁ ((D.map (homOfLE hKL).op).left z) ((D.map (homOfLE h1).op).left z) (by
      rw [hTR K (K + j₁) L (Nat.le_add_right K j₁) h1 z]
      first | rfl | simp)
    exact Set.mem_iUnion.1 hm

  have hpair : ∀ i j : Fin m, ∃ j₀ : ℕ, ∀ L (hKL : K ≤ L) (_ : K + j₀ ≤ L) (Z : S.ProEt)
      (g₁ : Z ⟶ NK i) (g₂ : Z ⟶ NK j) (w : Z ⟶ D.obj (Opposite.op L)),
      g₁ ≫ nK i = w ≫ D.map (homOfLE hKL).op → g₂ ≫ nK j = w ≫ D.map (homOfLE hKL).op →
      P.obj.map g₁.op (sK i) = P.obj.map g₂.op (sK j) := by
    intro i j
    obtain ⟨M, hMc, g, O, hO, hinf, hAGR⟩ := wc_tsl_pair_agree S P hZL (a K) (hqc K).2 x
      (NK i) (NK j) (nK i) (nK j) (sK i) (sK j) (N' (τi i)) (N' (τi j)) (q₃ i) (q₂ (τi i))
      (q₃ j) (q₂ (τi j)) (hNKa i) (hNKa j) (hnKe i) (hnKe j) (hpbK i) (hpbK j) (hAGK i) (hAGK j)
    haveI := hMc
    obtain ⟨j₀, hj₀⟩ := wc_tower_fibre_open_absorb S D a ha hlim hqc haff K M g O hO hinf
    refine ⟨j₀, fun L hKL h0 Z g₁ g₂ w h₁ h₂ => ?_⟩
    apply hAGR Z g₁ g₂ (h₁.trans h₂.symm)
    intro μ ζ hμ
    apply hj₀ μ ((D.map (homOfLE h0).op).left (w.left ζ))
    rw [hTR K (K + j₀) L (Nat.le_add_right K j₀) h0, hμ]
    have e : (g₁ ≫ nK i).left ζ = (w ≫ D.map (homOfLE hKL).op).left ζ := by rw [h₁]
    simp only [MorphismProperty.Comma.comp_left, Scheme.Hom.comp_apply] at e
    exact e
  choose j₀ hj₀ using hpair

  obtain ⟨L, hKL, h1L, h0L⟩ : ∃ L, K ≤ L ∧ K + j₁ ≤ L ∧ ∀ i j, K + j₀ i j ≤ L := by
    refine ⟨K + j₁ + Finset.univ.sup (fun p : Fin m × Fin m => j₀ p.1 p.2), by omega, by omega,
      fun i j => ?_⟩
    have := Finset.le_sup (f := fun p : Fin m × Fin m => j₀ p.1 p.2) (Finset.mem_univ (i, j))
    simp only at this
    omega
  have hbc2 := fun i => wc_tsl_base_change S D a ha haff K L hKL (NK i) (nK i) (N' (τi i))
    (q₃ i) (q₂ (τi i)) (hNKa i) (hnKe i) (hpbK i)
  choose NL nL rL q₄ hNLa hnLe hpbL hrL hq₄ hptL using hbc2
  obtain ⟨sL, hsL⟩ : ∃ sL : ∀ i, P.obj.obj (Opposite.op (NL i)),
      ∀ i, sL i = P.obj.map (rL i).op (sK i) := ⟨_, fun _ => rfl⟩

  haveI := (hqc L).2
  have hcovU := proet_finite_affine_jointly_surjective_covers S (D.obj (Opposite.op L)) m NL nL
    hNLa (by
      intro z
      obtain ⟨i, hi⟩ := hJS L hKL h1L z
      exact ⟨i, hptL i z hi⟩)
  obtain ⟨y, hy⟩ := wc_tsl_glue_check S P hZL (a L) m NL nL sL (fun i => N' (τi i)) q₄
    (fun i => q₂ (τi i)) x hcovU hCOV
    (fun i => MorphismProperty.Over.Hom.ext (by
      first
        | exact (hpbL i).toCommSq.w
        | simpa using (hpbL i).toCommSq.w))
    (by
      intro i j Z gi gj hij
      rw [hsL, hsL, hPc, hPc]
      apply hj₀ i j L hKL (h0L i j) Z (gi ≫ rL i) (gj ≫ rL j) (gi ≫ nL i)
      · simp only [Category.assoc, hrL i]
      · rw [hij]
        simp only [Category.assoc, hrL j])
    (by
      intro i
      rw [hsL, hPc, hq₄ i]
      exact hAGK i)
  exact ⟨L, y, hy⟩

theorem wc_epsInv_tower_ext0_continuity (S : Scheme.{u})
    (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left) :
    (∀ x : Abelian.Ext (wcFreeSheaf S Uinf) ((wcEpsInv S).obj G) 0,
      ∃ k, ∃ y : Abelian.Ext (wcFreeSheaf S (D.obj (Opposite.op k))) ((wcEpsInv S).obj G) 0,
        (Abelian.Ext.mk₀ (wcFreeSheafMap S (a k))).comp y (zero_add 0) = x) ∧
    (∀ k (y : Abelian.Ext (wcFreeSheaf S (D.obj (Opposite.op k))) ((wcEpsInv S).obj G) 0),
      (Abelian.Ext.mk₀ (wcFreeSheafMap S (a k))).comp y (zero_add 0) = 0 →
      ∃ j, (Abelian.Ext.mk₀ (wcFreeSheafMap S
        (D.map (homOfLE (Nat.le_add_right k j)).op))).comp y (zero_add 0) = 0) :=
by
  classical
  obtain ⟨e, he0, hen⟩ := wc_free_ext0_sections S ((wcEpsInv S).obj G)
  have hZL := wc_epsInv_zero_locus S G
  obtain ⟨hcU, hqU⟩ := wc_lfd_limit_qcqs S D a ha hlim hqc haff
  refine ⟨fun x => ?_, fun k y hy => ?_⟩
  · obtain ⟨k, y', hy'⟩ := wc_tower_surj_of_local S ((wcEpsInv S).obj G) hZL D a ha hlim hqc
      haff hcU hqU (e Uinf x)
      (fun τ => wc_epsInv_local_descent S G hZL D a ha hlim hqc haff (e Uinf x) τ)
    refine ⟨k, (e _).symm y', ?_⟩
    apply (e Uinf).injective
    rw [hen, Equiv.apply_symm_apply, hy']
  · have h1 : ((wcEpsInv S).obj G).obj.map (a k).op (e _ y) = 0 := by
      rw [← hen, hy, he0]
    obtain ⟨O, hO, hOiff⟩ := hZL _ (e _ y)
    have hr : Set.range (a k).left ⊆ O := (hOiff _ (a k)).1 h1
    haveI := (hqc k).1
    obtain ⟨j, hj⟩ := wc_tower_fibre_open_absorb S D a ha hlim hqc haff k _ (𝟙 _) O hO
      (by
        intro m z hmz
        apply hr
        refine ⟨z, ?_⟩
        rw [← hmz]
        first | rfl | simp)
    have hsub : Set.range (D.map (homOfLE (Nat.le_add_right k j)).op).left ⊆ O := by
      rintro _ ⟨w, rfl⟩
      exact hj _ w (by first | rfl | simp)
    have h2 := (hOiff _ (D.map (homOfLE (Nat.le_add_right k j)).op)).2 hsub
    refine ⟨j, (e _).injective ?_⟩
    rw [hen, h2, he0]

theorem wc_ext_mapExact_natTrans {C D : Type*} [Category C] [Abelian C] [HasExt C]
    [EnoughInjectives C] [Category D] [Abelian D] [HasExt D] (Φ₁ Φ₂ : C ⥤ D)
    [Φ₁.Additive] [Limits.PreservesFiniteLimits Φ₁] [Limits.PreservesFiniteColimits Φ₁]
    [Φ₂.Additive] [Limits.PreservesFiniteLimits Φ₂] [Limits.PreservesFiniteColimits Φ₂]
    (σ : Φ₁ ⟶ Φ₂) {X Y : C} {n : ℕ} (e : Abelian.Ext X Y n) :
    (Abelian.Ext.mk₀ (σ.app X)).comp (Abelian.Ext.mapExactFunctor Φ₂ e) (zero_add n) =
      (Abelian.Ext.mapExactFunctor Φ₁ e).comp (Abelian.Ext.mk₀ (σ.app Y)) (add_zero n) :=
by
  exact (Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp (F := Φ₁) (G := Φ₂) e σ).symm

theorem wc_etInv_unit_const : ∀ {Z Y : Scheme.{u}} (g : Z ⟶ Y),
    Nonempty ((wcEtInv g).obj (wcEtUnitSheaf Y) ≅ wcEtUnitSheaf Z) :=
by
  intro Z Y g

  have hjs : ∀ (X : Scheme.{u}) (V : X.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : X.Etale)
      (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X V := by
    intro X V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale X V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hcov : CoverPreserving (Scheme.smallEtaleTopology Y)
      (Scheme.smallEtaleTopology Z) (wcEtBaseChange g) := by
    constructor
    intro V S hS
    change S ∈ Scheme.smallGrothendieckTopology @Etale Y V at hS
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
    have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
    apply hjs
    intro v
    obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
    have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom = Limits.pullback.snd W.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫ Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
  haveI h1 : Limits.PreservesFiniteLimits (wcEtBaseChange g) := ⟨fun J _ _ =>
    haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget Z) :=
      Limits.preservesLimitsOfShape_of_natIso
        (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
          Scheme.Etale.forget Y ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget Z)
    Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g) (Scheme.Etale.forget Z)⟩
  haveI := flat_of_preservesFiniteLimits (wcEtBaseChange g)
  haveI hcont : (wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology Y)
      (Scheme.smallEtaleTopology Z) :=
    Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) hcov

  have hTY : Limits.IsTerminal (wcEtTop Y) :=
    Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))

  have hT0 : Limits.IsTerminal ((wcEtBaseChange g).obj (wcEtTop Y)) := by
    refine Limits.IsTerminal.ofUniqueHom
      (fun O => wcEtInvLift g (wcEtTop Y) O (O.hom ≫ g) (Category.comp_id _)) ?_
    intro O m
    apply MorphismProperty.Over.Hom.ext
    have hsnd : m.left ≫ Limits.pullback.snd (wcEtTop Y).hom g = O.hom :=
      MorphismProperty.Over.w m
    let ml : O.left ⟶ Limits.pullback (wcEtTop Y).hom g := m.left
    have hsnd' : ml ≫ Limits.pullback.snd (wcEtTop Y).hom g = O.hom := hsnd
    have hfst' : ml ≫ Limits.pullback.fst (wcEtTop Y).hom g = O.hom ≫ g := by
      have hc : Limits.pullback.fst (wcEtTop Y).hom g ≫ (wcEtTop Y).hom =
          Limits.pullback.snd (wcEtTop Y).hom g ≫ g := Limits.pullback.condition
      have hc' : Limits.pullback.fst (wcEtTop Y).hom g =
          Limits.pullback.snd (wcEtTop Y).hom g ≫ g :=
        (Category.comp_id (Limits.pullback.fst (wcEtTop Y).hom g)).symm.trans hc
      exact (congrArg (fun k => ml ≫ k) hc').trans
        ((Category.assoc ml (Limits.pullback.snd (wcEtTop Y).hom g) g).symm.trans
          (congrArg (fun k => k ≫ g) hsnd'))
    refine Limits.pullback.hom_ext ?_ ?_
    · exact hfst'.trans (Limits.pullback.lift_fst _ _ _).symm
    · exact hsnd'.trans (Limits.pullback.lift_snd _ _ _).symm

  let adj1 := constantSheafAdj (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} hTY
  let adj2 : wcEtInv g ⊣ (wcEtBaseChange g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z) :=
    Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtBaseChange g)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)
  let ρ : (wcEtBaseChange g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z) ⋙
      (sheafSections (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj
        (Opposite.op (wcEtTop Y)) ≅
      (sheafSections (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}).obj
        (Opposite.op ((wcEtBaseChange g).obj (wcEtTop Y))) := Iso.refl _
  let adj3 := (adj1.comp adj2).ofNatIsoRight ρ
  let adj4 := constantSheafAdj (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1} hT0

  exact ⟨(adj3.leftAdjointUniq adj4).app (AddCommGrpCat.of (ULift.{u+1} ℤ))⟩

theorem wc_slice_epsInv_etInv_iso (S : Scheme.{u}) (W : S.ProEt)
    [(wcSliceFunctor S W).IsContinuous (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)]
    [(wcSliceFunctor S W).IsCocontinuous (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)]
    (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) :
    ∃ b : (wcEpsInv W.left).obj ((wcEtInv W.hom).obj G) ≅
        ((wcSliceFunctor S W).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)).obj ((wcEpsInv S).obj G),
      wcSliceBSpec S W G b.hom :=
by
  classical
  have hflat : ∀ (Y : Scheme.{u}), Limits.PreservesFiniteLimits (wcEtToProEt Y) ∧
      (wcEtToProEt Y).IsContinuous (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y) := by
    intro Y
    haveI h1 : Limits.PreservesFiniteLimits (wcEtToProEt Y) :=
      @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _ (wcEtToProEt Y)
        (Scheme.ProEt.forget Y)
        (inferInstanceAs (Limits.PreservesFiniteLimits (Scheme.Etale.forget Y))) inferInstance
    have hcov : CoverPreserving (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
        (wcEtToProEt Y) := by
      refine ⟨fun {V} {R} hR => ?_⟩
      obtain ⟨𝒰, h₁, h, hle⟩ := (Scheme.mem_smallGrothendieckTopology V R).1 hR
      have hP : Presieve.map (wcEtToProEt Y) (@Scheme.Cover.toPresieveOverProp _ _ _ _ _ 𝒰 h₁ h) ∈
          (Scheme.ProEt.precoverage Y).coverings ((wcEtToProEt Y).obj V) :=
        Precoverage.mem_comap_iff.2
          ((congrArg (· ∈ Scheme.proetalePrecoverage.coverings V.left)
              ((congrArg (Presieve.map (Scheme.ProEt.forget Y ⋙ Over.forget Y))
                (Presieve.map_ofArrows (F := wcEtToProEt Y) _)).trans
                (Presieve.map_ofArrows (F := Scheme.ProEt.forget Y ⋙ Over.forget Y) _))).mpr
            (Scheme.etalePrecoverage_le_proetalePrecoverage _ 𝒰.mem₀))
      have hgen := Precoverage.generate_mem_toGrothendieck hP
      refine GrothendieckTopology.superset_covering _ ?_ hgen
      rw [Sieve.generate_le_iff]
      intro W f hf
      cases hf with
      | of hg => exact ⟨_, _, 𝟙 _, (by apply hle; exact hg), (Category.id_comp _).symm⟩
    haveI := flat_of_preservesFiniteLimits (wcEtToProEt Y)
    exact ⟨h1, Functor.isContinuous_of_coverPreserving
      (compatiblePreservingOfFlat (Scheme.ProEt.topology Y) (wcEtToProEt Y)) hcov⟩
  haveI hιS := (hflat S).2
  haveI hιT := (hflat W.left).2
  have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (R : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
      (c : V₁ ⟶ V), R.arrows c ∧ v ∈ Set.range c.left) → R ∈ Scheme.smallEtaleTopology Y V := by
    intro Y V R hR
    change R ∈ Scheme.smallGrothendieckTopology @Etale Y V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hR x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  have hcovBC : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
      (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
    intro X B g
    constructor
    intro V R hR
    change R ∈ Scheme.smallGrothendieckTopology @Etale B V at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    have hR' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR
    apply hjs
    intro v
    obtain ⟨W', a, w, ha, -, hw⟩ := hR' (Limits.pullback.fst V.hom g v)
    refine ⟨(wcEtBaseChange g).obj W', (wcEtBaseChange g).map a,
      Sieve.image_mem_functorPushforward (wcEtBaseChange g) R ha, ?_⟩
    have h0 : (Limits.pullback.fst W'.hom g ≫ a.left) ≫ V.hom =
        Limits.pullback.snd W'.hom g ≫ g := by
      rw [Category.assoc, MorphismProperty.Over.w a]
      exact Limits.pullback.condition
    let m : Limits.pullback W'.hom g ⟶ Limits.pullback V.hom g :=
      Limits.pullback.lift (Limits.pullback.fst W'.hom g ≫ a.left) (Limits.pullback.snd W'.hom g) h0
    have hmap : ((wcEtBaseChange g).map a).left = m := rfl
    have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W'.hom =
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
          Limits.pullback.snd V.hom g) ≫ g := by
      rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition,
        Category.assoc, Limits.pullback.condition, Category.assoc]
    let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W'.hom g :=
      Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
        (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
          Limits.pullback.snd V.hom g) h1
    have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.condition]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
    obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
      have hv : (v : ↥(Limits.pullback V.hom g)) ∈
          Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
        rw [Scheme.Pullback.range_snd]
        exact ⟨w, hw⟩
      exact hv
    rw [hmap]
    exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
  haveI hβl : Limits.PreservesFiniteLimits (wcEtBaseChange W.hom) := ⟨fun J _ _ =>
    haveI : Limits.PreservesLimitsOfShape J
        (wcEtBaseChange W.hom ⋙ Scheme.Etale.forget W.left) :=
      Limits.preservesLimitsOfShape_of_natIso
        (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
          Scheme.Etale.forget S ⋙ Over.pullback W.hom ≅
