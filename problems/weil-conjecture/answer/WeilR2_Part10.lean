    have hh12 : ∀ (V : Y.Etale) (O₁ : Z.Etale) (h₁ : O₁.left ⟶ V.left)
        (hh₁ : h₁ ≫ V.hom = O₁.hom ≫ g) (O₂ : Z'.Etale) (h₂ : O₂.left ⟶ O₁.left)
        (hh₂ : h₂ ≫ O₁.hom = O₂.hom ≫ t), (h₂ ≫ h₁) ≫ V.hom = O₂.hom ≫ e := by
      intro V O₁ h₁ hh₁ O₂ h₂ hh₂
      rw [Category.assoc, hh₁, ← Category.assoc, hh₂, Category.assoc, he]
    apply ext1 e A
    intro V x
    have hm : Limits.pullback.fst V.hom e ≫ V.hom = (Limits.pullback.snd V.hom e ≫ t) ≫ g :=
      Limits.pullback.condition.trans ((congrArg (fun q => Limits.pullback.snd V.hom e ≫ q)
        he.symm).trans (Category.assoc _ _ _).symm)
    obtain ⟨h₂, hh₂, hcomp⟩ : ∃ h₂ : ((wcEtBaseChange e).obj V).left ⟶ ((wcEtBaseChange g).obj V).left,
        h₂ ≫ ((wcEtBaseChange g).obj V).hom = ((wcEtBaseChange e).obj V).hom ≫ t ∧
        h₂ ≫ Limits.pullback.fst V.hom g = Limits.pullback.fst V.hom e :=
      ⟨Limits.pullback.lift (Limits.pullback.fst V.hom e) (Limits.pullback.snd V.hom e ≫ t) hm,
        Limits.pullback.lift_snd _ _ _, Limits.pullback.lift_fst _ _ _⟩
    have hE := E0 e A V ((wcEtBaseChange e).obj V) (h₂ ≫ Limits.pullback.fst V.hom g)
      (Limits.pullback.fst V.hom e)
      (hh12 V ((wcEtBaseChange g).obj V) (Limits.pullback.fst V.hom g) Limits.pullback.condition
        ((wcEtBaseChange e).obj V) h₂ hh₂) Limits.pullback.condition hcomp
    rw [← hE]
    exact (congrArg (fun v => (((wcEtInv t).map ((wcEtInv g).map f)).hom.app
          (Opposite.op ((wcEtBaseChange e).obj V))).hom v)
        (hCA V ((wcEtBaseChange g).obj V) (Limits.pullback.fst V.hom g) Limits.pullback.condition
          ((wcEtBaseChange e).obj V) h₂ hh₂ x)).trans
      ((R t ((wcEtInv g).map f) ((wcEtBaseChange g).obj V) ((wcEtBaseChange e).obj V) h₂ hh₂
          (wcEtInvRho g A V ((wcEtBaseChange g).obj V) (Limits.pullback.fst V.hom g)
            Limits.pullback.condition x)).trans
      ((congrArg (fun v => wcEtInvRho t ((wcEtInv g).obj B) ((wcEtBaseChange g).obj V)
          ((wcEtBaseChange e).obj V) h₂ hh₂ v)
          (R g f V ((wcEtBaseChange g).obj V) (Limits.pullback.fst V.hom g)
            Limits.pullback.condition x)).trans
      ((hCB V ((wcEtBaseChange g).obj V) (Limits.pullback.fst V.hom g) Limits.pullback.condition
          ((wcEtBaseChange e).obj V) h₂ hh₂ ((f.hom.app (Opposite.op V)).hom x)).symm.trans
      (congrArg (fun v => ((wcEtInvCompInv t g e he B).hom.app
          (Opposite.op ((wcEtBaseChange e).obj V))).hom v)
        (R e f V ((wcEtBaseChange e).obj V) (h₂ ≫ Limits.pullback.fst V.hom g)
