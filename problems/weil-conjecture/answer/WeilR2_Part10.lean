    MorphismProperty.Over.homMk (wcLfdTowPm F X (τk k)) (hPmF (τk k)) trivial
  let g : ∀ k, D.obj (Opposite.op k) ⟶ D.obj (Opposite.op k) := fun k =>
    MorphismProperty.Over.homMk (wcLfdTowPm F X (γk k)) (hPmF (γk k)) trivial
  haveI := hιE
  let Ok : ∀ k, (Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (L k))))).Opens :=
    fun k => wcLfdTowPm F X (τk k) ⁻¹ᵁ ιE.left.opensRange
  have hVk : ∀ k, WeaklyEtale ((Ok k).ι ≫ Limits.pullback.fst X.hom
