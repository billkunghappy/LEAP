        (B'.obj.map (κ' V).op).hom (((αe.unit.app A).hom.app (Opposite.op V)).hom x) at h
      rw [ug, ue] at h
      exact h.trans (s1 e A V ((wcEtBaseChange e).obj V) _ (κ' V) _ _ _ (hw' V) (hκ'f V) x)
    refine ⟨φ, ?_⟩
    intro V O₁ h₁ hh₁ O₂ h₂ hh₂ x
    have w₁ : (Limits.pullback.fst O₁.hom t ≫ h₁) ≫ V.hom =
        ((wcEtBaseChange t).obj O₁).hom ≫ e := by
      have c2 : Limits.pullback.fst O₁.hom t ≫ O₁.hom = Limits.pullback.snd O₁.hom t ≫ t :=
        Limits.pullback.condition
      exact (Category.assoc _ _ _).trans ((congrArg (fun q => Limits.pullback.fst O₁.hom t ≫ q)
        hh₁).trans ((Category.assoc _ _ _).symm.trans ((congrArg (· ≫ g) c2).trans
          ((Category.assoc _ _ _).trans (congrArg (fun q => Limits.pullback.snd O₁.hom t ≫ q) he)))))
    have ea := (s1 t ((wcEtInv g).obj A) O₁ ((wcEtBaseChange t).obj O₁) O₂
      (wcEtInvLift t O₁ O₂ h₂ hh₂) (Limits.pullback.fst O₁.hom t) Limits.pullback.condition
      h₂ hh₂ (lf t O₁ O₂ h₂ hh₂) (wcEtInvRho g A V O₁ h₁ hh₁ x)).symm
    have ed := (s1 g A V ((wcEtBaseChange g).obj V) O₁ (wcEtInvLift g V O₁ h₁ hh₁)
      (Limits.pullback.fst V.hom g) Limits.pullback.condition h₁ hh₁ (lf g V O₁ h₁ hh₁) x).symm
