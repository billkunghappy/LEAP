    rintro V' h ⟨k, t, ht⟩
    exact ⟨AsSmall.up.obj k, t, ht⟩
  have hL2 : ∀ (i : AsSmall.{u+1} ℕ) (V : Y.Etale) (t : (F.obj i).obj.obj (Opposite.op V)),
      ((ψ' i).hom.app (Opposite.op V)).hom t = 0 →
      Sieve.generate (fun (V' : Y.Etale) (h : V' ⟶ V) => ∃ (j : AsSmall.{u+1} ℕ) (f : i ⟶ j),
        ((F.map f).hom.app (Opposite.op V')).hom (((F.obj i).obj.map h.op).hom t) = 0) ∈
        Scheme.smallEtaleTopology Y V := by
    intro i V t ht
    refine GrothendieckTopology.superset_covering _ (Sieve.generate_mono ?_)
      (hLC2 (AsSmall.down.obj i) V t ht)
    rintro V' h ⟨l, hkl, hz⟩
    refine ⟨AsSmall.up.obj (l + 1), AsSmall.up.map (homOfLE (hkl.trans (Nat.le_add_right l 1))), ?_⟩
    have e := congrArg (fun m => (m.hom.app (Opposite.op V')).hom
      (((H (AsSmall.down.obj i)).obj.map h.op).hom t)) (hC (AsSmall.down.obj i) l hkl)
    refine e.trans ?_
    show ((θ l (l + 1) (Nat.le_add_right l 1)).hom.app (Opposite.op V')).hom
      (((θ (AsSmall.down.obj i) l hkl).hom.app (Opposite.op V')).hom
        (((H (AsSmall.down.obj i)).obj.map h.op).hom t)) = 0
    rw [hz]
    exact map_zero _
  obtain ⟨hS, hI⟩ := wc_et_qcqs_sections_local_cocone Y (AsSmall.{u+1} ℕ) F G ψ' hcone hL1 hL2
    U hU1 hU2
  refine ⟨fun s => ?_, fun k t ht => ?_⟩
  · obtain ⟨i, t, ht⟩ := hS s
    exact ⟨AsSmall.down.obj i, t, ht⟩
  · obtain ⟨j, f, hf⟩ := hI (AsSmall.up.obj k) t ht
    refine ⟨AsSmall.down.obj j + 1,
      (leOfHom (AsSmall.down.map f)).trans (Nat.le_add_right _ 1), ?_⟩
    have e := congrArg (fun m => (m.hom.app (Opposite.op U)).hom t)
      (hstar k (AsSmall.down.obj j) (AsSmall.down.map f))
    refine e.symm.trans ?_
    have hf' : ((Φ.map (AsSmall.down.map f)).hom.app (Opposite.op U)).hom t = 0 := hf
    show ((θ (AsSmall.down.obj j) (AsSmall.down.obj j + 1) (Nat.le_add_right _ 1)).hom.app
      (Opposite.op U)).hom (((Φ.map (AsSmall.down.map f)).hom.app (Opposite.op U)).hom t) = 0
    rw [hf']
    exact map_zero _

theorem wc_etale_tower_continuity_zero (S : Scheme.{u})
    (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left) :
    (∀ e : wcEtInvExt Uinf.hom (wcEtUnitSheaf S) G 0,
      ∃ k, ∃ y : wcEtInvExt (D.obj (Opposite.op k)).hom (wcEtUnitSheaf S) G 0,
        wcEtInvExtPull (a k).left (D.obj (Opposite.op k)).hom Uinf.hom
          (MorphismProperty.Over.w (a k)) (wcEtUnitSheaf S) G 0 y = e) ∧
    (∀ k (y : wcEtInvExt (D.obj (Opposite.op k)).hom (wcEtUnitSheaf S) G 0),
      wcEtInvExtPull (a k).left (D.obj (Opposite.op k)).hom Uinf.hom
          (MorphismProperty.Over.w (a k)) (wcEtUnitSheaf S) G 0 y = 0 →
      ∃ j, wcEtInvExtPull (D.map (homOfLE (Nat.le_add_right k j)).op).left
          (D.obj (Opposite.op k)).hom (D.obj (Opposite.op (k + j))).hom
          (MorphismProperty.Over.w (D.map (homOfLE (Nat.le_add_right k j)).op))
          (wcEtUnitSheaf S) G 0 y = 0) :=
by
  obtain ⟨Θ, hbij, hnat⟩ := wc_etale_proet_comparison S G 0
  obtain ⟨cs, ci⟩ := wc_epsInv_tower_ext0_continuity S G D a ha hlim hqc haff
  obtain ⟨hcU, hqU⟩ := wc_lfd_limit_qcqs S D a ha hlim hqc haff
  refine ⟨fun e => ?_, fun k y hy => ?_⟩
  · obtain ⟨k, yP, hyP⟩ := cs (Θ Uinf e)
    obtain ⟨yE, rfl⟩ := (hbij (D.obj (Opposite.op k)) (hqc k).1 (hqc k).2).2 yP
    refine ⟨k, yE, ?_⟩
    apply (hbij Uinf hcU hqU).1
    rw [hnat _ _ (a k) (hqc k).1 (hqc k).2 hcU hqU, hyP]
  · have h0 : (Abelian.Ext.mk₀ (wcFreeSheafMap S (a k))).comp
        (Θ (D.obj (Opposite.op k)) y) (zero_add 0) = 0 := by
      rw [← hnat _ _ (a k) (hqc k).1 (hqc k).2 hcU hqU y, hy, map_zero]
    obtain ⟨j, hj⟩ := ci k (Θ _ y) h0
    refine ⟨j, ?_⟩
    apply (hbij (D.obj (Opposite.op (k + j))) (hqc (k + j)).1 (hqc (k + j)).2).1
    rw [hnat _ _ _ (hqc k).1 (hqc k).2 (hqc (k + j)).1 (hqc (k + j)).2, hj, map_zero]

theorem wc_tower_shift_hyps (S : Scheme.{u}) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left) (k : ℕ) :
    (∀ (p q : ℕ) (h : p ≤ q), (a q).left ≫ (D.map (homOfLE h).op).left = (a p).left) ∧
    (∀ (p q r : ℕ) (h₁ : p ≤ q) (h₂ : q ≤ r),
      (D.map (homOfLE h₂).op).left ≫ (D.map (homOfLE h₁).op).left =
        (D.map (homOfLE (h₁.trans h₂)).op).left) ∧
    (∀ (p q : ℕ) (h : p ≤ q), IsAffineHom (D.map (homOfLE h).op).left) ∧
    (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj (Opposite.op (k + l))).left),
      (∀ (l j : ℕ) (h : k + l ≤ k + (l + j)), z (l + j) ≫ (D.map (homOfLE h).op).left = z l) →
      ∃! z₀ : T ⟶ Uinf.left, ∀ l, z₀ ≫ (a (k + l)).left = z l) :=
by
  have hhom : ∀ (X Y : ℕᵒᵖ) (f g : X ⟶ Y), f = g := fun X Y f g =>
    Quiver.Hom.unop_inj (Subsingleton.elim _ _)
  have hAL : ∀ (p q : ℕ) (h : p ≤ q), (a q).left ≫ (D.map (homOfLE h).op).left = (a p).left := by
    intro p q h
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
    exact congrArg (fun t => t.left) (ha p j)
  have hDD : ∀ (p q r : ℕ) (h₁ : p ≤ q) (h₂ : q ≤ r),
      (D.map (homOfLE h₂).op).left ≫ (D.map (homOfLE h₁).op).left =
        (D.map (homOfLE (h₁.trans h₂)).op).left := by
    intro p q r h₁ h₂
    refine (congrArg (fun t => t.left)
      (D.map_comp (homOfLE h₂).op (homOfLE h₁).op).symm).trans ?_
    exact congrArg (fun f => (D.map f).left) (hhom _ _ _ _)
  have hAff : ∀ (p q : ℕ) (h : p ≤ q), IsAffineHom (D.map (homOfLE h).op).left := by
    intro p q h
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
    exact haff p j
  refine ⟨hAL, hDD, hAff, ?_⟩
  intro T z hz
  let z' : ∀ n, T ⟶ (D.obj (Opposite.op n)).left := fun n =>
    z n ≫ (D.map (homOfLE (Nat.le_add_left n k)).op).left
  have hz' : ∀ (l l' : ℕ) (hl : l ≤ l') (h' : k + l ≤ k + l'),
      z l' ≫ (D.map (homOfLE h').op).left = z l := by
    intro l l' hl h'
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hl
    exact hz l j h'
  have hcompat : ∀ n j,
      z' (n + j) ≫ (D.map (homOfLE (Nat.le_add_right n j)).op).left = z' n := by
    intro n j
    have e1 := hDD n (n + j) (k + (n + j)) (Nat.le_add_right n j) (Nat.le_add_left (n + j) k)
    have e2 := hDD n (k + n) (k + (n + j)) (Nat.le_add_left n k)
      (Nat.add_le_add_left (Nat.le_add_right n j) k)
    calc z' (n + j) ≫ (D.map (homOfLE (Nat.le_add_right n j)).op).left
        = z (n + j) ≫ ((D.map (homOfLE (Nat.le_add_left (n + j) k)).op).left ≫
            (D.map (homOfLE (Nat.le_add_right n j)).op).left) := Category.assoc _ _ _
      _ = z (n + j) ≫ ((D.map (homOfLE (Nat.add_le_add_left (Nat.le_add_right n j) k)).op).left ≫
            (D.map (homOfLE (Nat.le_add_left n k)).op).left) :=
          congrArg (fun t => z (n + j) ≫ t) (e1.trans e2.symm)
      _ = (z (n + j) ≫
            (D.map (homOfLE (Nat.add_le_add_left (Nat.le_add_right n j) k)).op).left) ≫
            (D.map (homOfLE (Nat.le_add_left n k)).op).left := (Category.assoc _ _ _).symm
      _ = z' n := congrArg (fun t => t ≫ (D.map (homOfLE (Nat.le_add_left n k)).op).left)
            (hz n j (Nat.add_le_add_left (Nat.le_add_right n j) k))
  obtain ⟨z₀, hz₀, huniq⟩ := hlim T z' hcompat
  refine ⟨z₀, fun l => ?_, fun z₁ hz₁ => ?_⟩
  · refine (hz₀ (k + l)).trans ?_
    exact hz' l (k + l) (Nat.le_add_left l k) (Nat.le_add_left (k + l) k)
  · apply huniq
    intro n
    calc z₁ ≫ (a n).left
        = z₁ ≫ ((a (k + n)).left ≫ (D.map (homOfLE (Nat.le_add_left n k)).op).left) :=
          (congrArg (fun t => z₁ ≫ t) (hAL n (k + n) (Nat.le_add_left n k))).symm
      _ = (z₁ ≫ (a (k + n)).left) ≫ (D.map (homOfLE (Nat.le_add_left n k)).op).left :=
          (Category.assoc _ _ _).symm
      _ = z' n := congrArg (fun t => t ≫ (D.map (homOfLE (Nat.le_add_left n k)).op).left)
            (hz₁ n)

theorem wc_et_inv_ext_pull_degree0_eval : ∀ {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y)
    (e : Z' ⟶ Y) (he : t ≫ g = e) (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
    (f : (wcEtInv g).obj (wcEtUnitSheaf Y) ⟶ (wcEtInv g).obj A),
    wcEtInvExtPull t g e he (wcEtUnitSheaf Y) A 0 (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ f) =
      @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _
        (wcEtInvCompInv t g e he (wcEtUnitSheaf Y) ≫ (wcEtInv t).map f ≫ wcEtInvComp t g e he A) ∧
    ((wcEtInvCompInv t g e he (wcEtUnitSheaf Y) ≫ (wcEtInv t).map f ≫
        wcEtInvComp t g e he A).hom.app (Opposite.op (wcEtTop Z'))).hom
      (wcEtInvRho e (wcEtUnitSheaf Y) (wcEtTop Y) (wcEtTop Z') e
        ((Category.comp_id _).trans (Category.id_comp _).symm)
        (wcConstSec Y (ULift.{u+1} ℤ) (wcEtTop Y) (ULift.up 1))) =
    ((wcEtInvComp t g e he A).hom.app (Opposite.op (wcEtTop Z'))).hom
      (wcEtInvRho t ((wcEtInv g).obj A) (wcEtTop Z) (wcEtTop Z') t
        ((Category.comp_id _).trans (Category.id_comp _).symm)
        ((f.hom.app (Opposite.op (wcEtTop Z))).hom
          (wcEtInvRho g (wcEtUnitSheaf Y) (wcEtTop Y) (wcEtTop Z) g
            ((Category.comp_id _).trans (Category.id_comp _).symm)
            (wcConstSec Y (ULift.{u+1} ℤ) (wcEtTop Y) (ULift.up 1))))) :=
by

  have hCIspec : ∀ {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y) (e : Z' ⟶ Y) (he : t ≫ g = e)
      (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
      wcEtInvCompatInv t g e he A (wcEtInvCompInv t g e he A) := by
    classical
    have hbcI : ∀ {X B : Scheme.{u}} (g : X ⟶ B), (wcEtBaseChange g).IsContinuous
        (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) := by
      have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
          (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
        intro Y V S hS
        change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
        apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
        intro x
        obtain ⟨V₁, c, hc, y, hy⟩ := hS x
        have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
        have hEt : Etale c.left := by
          have h1 : Etale V.hom := V.prop
          have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
          exact Etale.of_comp c.left V.hom
        exact ⟨V₁, c, y, hc, hEt, hy⟩
      have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
          (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
        intro X B g
        constructor
        intro V S hS
        change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
        have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
        apply hjs
        intro v
        obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
        refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
          Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
        have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom =
            Limits.pullback.snd W.hom g ≫ g := by
          rw [Category.assoc, MorphismProperty.Over.w a]
          exact Limits.pullback.condition
        let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
          Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
        have hmap : ((wcEtBaseChange g).map a).left = m := rfl
        have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
            (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
              Limits.pullback.snd V.hom g) ≫ g := by
          rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition,
            Category.assoc, Limits.pullback.condition, Category.assoc]
        let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
          Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
            (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
              Limits.pullback.snd V.hom g) h1
        have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
          apply Limits.pullback.hom_ext
          · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
              Limits.pullback.lift_fst, Limits.pullback.condition]
          · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
        obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
          have hv : (v : ↥(Limits.pullback V.hom g)) ∈
              Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
            rw [Scheme.Pullback.range_snd]
            exact ⟨w, hw⟩
          exact hv
        rw [hmap]
        exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
      intro X B g
      haveI h1 : Limits.PreservesFiniteLimits (wcEtBaseChange g) := ⟨fun J _ _ =>
        haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget X) :=
          Limits.preservesLimitsOfShape_of_natIso
            (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
              Scheme.Etale.forget B ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget X)
        Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g)
          (Scheme.Etale.forget X)⟩
      haveI := flat_of_preservesFiniteLimits (wcEtBaseChange g)
      exact Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)
    have lf : ∀ {Z Y : Scheme.{u}} (f : Z ⟶ Y) (V : Y.Etale) (O : Z.Etale) (h : O.left ⟶ V.left)
        (hh : h ≫ V.hom = O.hom ≫ f),
        (wcEtInvLift f V O h hh).left ≫ Limits.pullback.fst V.hom f = h :=
      fun f V O h hh => Limits.pullback.lift_fst _ _ _
    have ls : ∀ {Z Y : Scheme.{u}} (f : Z ⟶ Y) (V : Y.Etale) (O : Z.Etale) (h : O.left ⟶ V.left)
        (hh : h ≫ V.hom = O.hom ≫ f),
        (wcEtInvLift f V O h hh).left ≫ Limits.pullback.snd V.hom f = O.hom :=
      fun f V O h hh => Limits.pullback.lift_snd _ _ _

    have s1 : ∀ {Z Y : Scheme.{u}} (f : Z ⟶ Y)
        (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (V : Y.Etale) (O O' : Z.Etale) (k : O' ⟶ O) (h : O.left ⟶ V.left)
        (hh : h ≫ V.hom = O.hom ≫ f) (h' : O'.left ⟶ V.left) (hh' : h' ≫ V.hom = O'.hom ≫ f),
        k.left ≫ h = h' → ∀ x : A.obj.obj (Opposite.op V),
        (((wcEtInv f).obj A).obj.map k.op).hom (wcEtInvRho f A V O h hh x) =
          wcEtInvRho f A V O' h' hh' x := by
      intro Z Y f A V O O' k h hh h' hh' hk x
      have hl : k ≫ wcEtInvLift f V O h hh = wcEtInvLift f V O' h' hh' := by
        apply MorphismProperty.Over.Hom.ext
        apply Limits.pullback.hom_ext
        · exact (Category.assoc _ _ _).trans
            (((congrArg (fun q => k.left ≫ q) (lf f V O h hh)).trans hk).trans (lf f V O' h' hh').symm)
        · exact (Category.assoc _ _ _).trans
            (((congrArg (fun q => k.left ≫ q) (ls f V O h hh)).trans
              (MorphismProperty.Over.w k)).trans (ls f V O' h' hh').symm)
      show ((sheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange f).op.lan.obj A.obj)).map k.op).hom
          (((toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange f).op.lan.obj A.obj)).app
            (Opposite.op O)).hom
            ((((wcEtBaseChange f).op.lan.obj A.obj).map (wcEtInvLift f V O h hh).op).hom
              ((((wcEtBaseChange f).op.lanUnit.app A.obj).app (Opposite.op V)).hom x))) =
        ((toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange f).op.lan.obj A.obj)).app
            (Opposite.op O')).hom
            ((((wcEtBaseChange f).op.lan.obj A.obj).map (wcEtInvLift f V O' h' hh').op).hom
              ((((wcEtBaseChange f).op.lanUnit.app A.obj).app (Opposite.op V)).hom x))
      rw [← NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology Z)
        ((wcEtBaseChange f).op.lan.obj A.obj)) k.op, ← hl, op_comp, CategoryTheory.Functor.map_comp]
      rfl
    have bcf : ∀ {Z Y : Scheme.{u}} (f : Z ⟶ Y) {V₁ V₂ : Y.Etale} (a : V₁ ⟶ V₂),
        ((wcEtBaseChange f).map a).left ≫ Limits.pullback.fst V₂.hom f =
          Limits.pullback.fst V₁.hom f ≫ a.left := by
      intro Z Y f V₁ V₂ a; exact Limits.pullback.lift_fst _ _ _
    have LE : ∀ {Z Y : Scheme.{u}} (f : Z ⟶ Y) (V : Y.Etale) (O : Z.Etale)
        (k₁ k₂ : O ⟶ (wcEtBaseChange f).obj V),
        k₁.left ≫ Limits.pullback.fst V.hom f = k₂.left ≫ Limits.pullback.fst V.hom f → k₁ = k₂ := by
      intro Z Y f V O k₁ k₂ hk
      apply MorphismProperty.Over.Hom.ext
