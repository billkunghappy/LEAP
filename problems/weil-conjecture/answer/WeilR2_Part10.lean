    induction k with
    | zero => rw [zero_nsmul, zero_nsmul]; exact Abelian.Ext.zero_comp _ _ _ _ _
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.add_comp, ih]
  have hR' : ∀ {A B C : SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ)} {p q r : ℕ}
