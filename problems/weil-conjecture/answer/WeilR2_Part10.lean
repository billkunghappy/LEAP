      ((congrArg (fun v => (B'.obj.map (wcEtInvLift t O₁ O₂ h₂ hh₂).op).hom v)
        ((c1 O₁ _).trans ((congrArg (fun v => (φ₁.hom.app (Opposite.op O₁)).hom v) ed).trans
          ((NatTrans.naturality_apply φ₁.hom (wcEtInvLift g V O₁ h₁ hh₁).op _).trans
            ((congrArg (fun v => (B'.obj.map
