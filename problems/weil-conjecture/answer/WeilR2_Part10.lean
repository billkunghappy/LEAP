    fun k => Nat.rec
      (motive := fun k => Abelian.Ext (wcIntSuppObj Dx) (wcIntTors (wcXbar F X) ℓ (m + k)) (2 * d))
      a₀ (fun k ak => f (m + k) (by omega) ak) k
  have ha : ∀ (k : ℕ) (t : wcIntTors (wcXbar F X) ℓ (m + k + 1) ⟶ wcIntTors (wcXbar F X) ℓ (m + k)),
      Limits.cokernel.π ((ℓ ^ (m + k + 1) : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ)) ≫ t =
        Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ)) →
      (a (k + 1)).comp (Abelian.Ext.mk₀ t) (add_zero (2 * d)) = a k := by
    intro k t ht
    exact hf (m + k) (by omega) (a k) t ht

  obtain ⟨θz, hθz⟩ := wc_xbar_int_supp_milnor F X d ℓ hℓ x₀ hx₀ Dx hDx m a ha
  have hθ0 : θz.comp (Abelian.Ext.mk₀
      (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ)))) (add_zero (2 * d)) = a₀ :=
    hθz 0

  obtain ⟨y, hy⟩ : ∃ y : Abelian.Ext (wcIntUnit (wcXbar F X) ℓ) (wcIntUnit (wcXbar F X) ℓ) (2 * d),
      y = (Abelian.Ext.mk₀ (wcIntSuppπ Dx)).comp θz (zero_add (2 * d)) := ⟨_, rfl⟩
  have hred : y.comp (Abelian.Ext.mk₀
      (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ)))) (add_zero (2 * d)) = b := by
    rw [hy, Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (wcIntSuppπ Dx)) θz
      (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ))))
      (zero_add (2 * d)) (add_zero (2 * d)) (by omega), hθ0, ha₀]

  obtain ⟨rat, ratB, hsq, hker⟩ := wc_xbar_int_supp_rational F X d ℓ hℓ x₀ hx₀ Dx hDx
  refine ⟨rat θz, fun h0 => ?_⟩
  have hy0 : ratB y = 0 := by rw [hy, ← hsq θz]; exact h0
  obtain ⟨r, hr⟩ := hker y hy0
  have hey : ℓ ^ e • y = 0 := he y ⟨r, hr⟩

  apply hb
  rw [← hred]
  have hpost := map_nsmul ((Abelian.Ext.mk₀
      (Limits.cokernel.π ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ)))).postcomp
        (wcIntUnit (wcXbar F X) ℓ) (add_zero (2 * d))) (ℓ ^ e) y
  rw [hey, map_zero] at hpost
  exact hpost.symm

theorem wc_proet_module_section_eq_zero_of_affine_covers {S : Scheme.{u}}
    {R : Sheaf (Scheme.ProEt.topology S) RingCat.{u+1}} (M : SheafOfModules.{u+1} R) (V : S.ProEt)
    (m : M.val.obj (Opposite.op V))
    (h : ∀ (W : S.ProEt) (g : W ⟶ V), IsAffine W.left →
      ∃ (n : ℕ) (W' : Fin n → S.ProEt) (e : ∀ k, W' k ⟶ W),
        (∀ k, IsAffine (W' k).left) ∧ (∀ x : ↥W.left, ∃ k, x ∈ Set.range (e k).left) ∧
        ∀ k, (M.val.map (e k ≫ g).op).hom m = 0) :
    m = 0 :=
by
  classical


  have fin_covers : ∀ (U : S.ProEt) [QuasiSeparatedSpace U.left] (n : ℕ) (W : Fin n → S.ProEt)
      (h : ∀ i, W i ⟶ U), (∀ i, IsAffine (W i).left) →
      (∀ x : U.left, ∃ i, x ∈ Set.range (h i).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology S U := by
    intro U _ n W h hA hJ
    have hs : ∀ x : U.left, ∃ j y, (h j).left y = x := by
      intro x
      obtain ⟨j, y, hy⟩ := hJ x
      exact ⟨j, y, hy⟩
    have hq : ∀ i, QuasiCompact (h i).left := fun i => by
      haveI := hA i
      exact quasiCompact_of_compactSpace _
    have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
      have h1 : WeaklyEtale ((h i).left ≫ U.hom) := by
        rw [MorphismProperty.Over.w (h i)]
        exact (W i).prop
      haveI := U.prop
      exact @WeaklyEtale.of_comp _ _ _ (h i).left U.hom h1 U.prop
    have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
        Scheme.proetalePrecoverage.coverings U.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
        (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
          hs (fun _ => trivial)) _ hq
          (inferInstanceAs (Finite (Fin n)))),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))

  have affine_local : ∀ (U : S.ProEt) (T : Sieve U),
      (∀ (V : S.ProEt) (f : V ⟶ U), IsAffine V.left → T.pullback f ∈ Scheme.ProEt.topology S V) →
      T ∈ Scheme.ProEt.topology S U := by
    intro U T hT
    have hU : WeaklyEtale U.hom := U.prop
    let W : U.left.affineCover.I₀ → S.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (U.left.affineCover.f i ≫ U.hom) inferInstance
    let e : ∀ i, W i ⟶ U := fun i => MorphismProperty.Over.homMk (U.left.affineCover.f i) rfl trivial
    have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage S).coverings U := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)
        Scheme.proetalePrecoverage).coverings U
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
        U.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
    refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) T ?_
    intro Y f hf
    obtain ⟨Y', h, g', hg', rfl⟩ := hf
    rcases hg' with ⟨i⟩
    rw [Sieve.pullback_comp]
    exact GrothendieckTopology.pullback_stable _ h
      (hT (W i) (e i) (show IsAffine (U.left.affineCover.X i) by infer_instance))

  let T0 : Sieve V :=
    { arrows := fun _ f => (M.val.map f.op).hom m = 0
      downward_closed := by
        intro Y Z f hf g
        have hf' : (M.val.map f.op).hom m = 0 := hf
        show (M.val.map (g ≫ f).op).hom m = 0
        rw [op_comp, PresheafOfModules.map_comp, ModuleCat.hom_comp, LinearMap.comp_apply, hf',
          map_zero] }

  have hT0 : T0 ∈ Scheme.ProEt.topology S V := by
    apply affine_local V T0
    intro W f hW
    obtain ⟨n, W', e, haff, hsurj, hzero⟩ := h W f hW
    haveI : IsAffine W.left := hW
    refine GrothendieckTopology.superset_covering _ ?_
      (fin_covers W n W' e haff hsurj)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨k⟩
    show (M.val.map (e k ≫ f).op).hom m = 0
    exact hzero k

  refine M.isSheaf.isSeparated V T0 hT0 m (0 : M.val.obj (Opposite.op V)) ?_
  intro Y f hf
  have hf' : (M.val.map f.op).hom m = 0 := hf
  change (M.val.map f.op).hom m = (M.val.map f.op).hom 0
  rw [map_zero]
  exact hf'

theorem wc_supp_pull_unit_vanish_off {Y Z Y' Z' : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    (g : Y' ⟶ Y) (i' : Z' ⟶ Y') (g' : Z' ⟶ Z) (hsq : IsPullback i' g' g i)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Di : wcHMPullData i ℓ) (Dg : wcHMPullData g ℓ)
    (V : Y'.ProEt) (hV : ∀ x : ↥V.left, V.hom x ∉ Set.range i') :
    ((Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val.app (Opposite.op V)).hom
      (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) = 0 :=
by
  classical
  letI := Dg.cont

  let O : Y.Opens := ⟨(Set.range i)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  let U : Y.ProEt := MorphismProperty.Over.mk ⊤ O.ι inferInstance
  have hU : ∀ x : ↥U.left, U.hom x ∉ Set.range i := by
    intro x
    have hx : O.ι x ∈ (O : Set Y) := by
      rw [← Scheme.Opens.range_ι]; exact ⟨x, rfl⟩
    exact hx
  have hrange : ∀ y : Y', g y ∈ Set.range i → y ∈ Set.range i' := by
    intro y hy
    have hy' : y ∈ Set.range (Limits.pullback.fst g i) := by
      rw [Scheme.Pullback.range_fst]; exact hy
    obtain ⟨w, rfl⟩ := hy'
    refine ⟨hsq.isoPullback.inv w, ?_⟩
    rw [← Scheme.Hom.comp_apply, hsq.isoPullback_inv_fst]
  have hVO : Set.range (V.hom ≫ g) ⊆ Set.range O.ι := by
    rintro _ ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι]
    refine fun hx => hV x (hrange _ ?_)
    rw [← Scheme.Hom.comp_apply]
    exact hx
  let l := IsOpenImmersion.lift O.ι (V.hom ≫ g) hVO
  have hl : l ≫ O.ι = V.hom ≫ g := IsOpenImmersion.lift_fac _ _ _
  let p : V.left ⟶ Limits.pullback U.hom g := Limits.pullback.lift l V.hom hl
  have hp : p ≫ Limits.pullback.snd U.hom g = V.hom := Limits.pullback.lift_snd l V.hom hl
  let af : V ⟶ (wcProEtBC g).obj U := MorphismProperty.Over.homMk p hp trivial

  have htr : wcSuppUnitMap Dg ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ).map
        (Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)) =
      wcSuppUnitMap Di ≫ Dg.adj.unit.app (wcSuppObj Di) := by
    have e1 : wcSuppUnitMap Dg = Dg.adj.homEquiv _ _ Dg.μ.hom := by
      rw [Adjunction.homEquiv_unit]; rfl
    rw [e1]
    refine (Adjunction.homEquiv_naturality_right _ _ _).symm.trans ?_
    rw [Iso.hom_inv_id_assoc,
      Adjunction.homEquiv_unit]
    exact Dg.adj.unit_naturality (wcSuppUnitMap Di)

  let u0 := SheafOfModules.unitToPushforwardObjUnit Dg.φ
  let ψ₁ := (Dg.adj.homEquiv _ _).symm u0
  let h : SheafOfModules.unit (wcRingSheaf Y' ℓ) ⟶ SheafOfModules.unit (wcRingSheaf Y' ℓ) :=
    Dg.μ.inv ≫ ψ₁
  have hfac : u0 = wcSuppUnitMap Dg ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ).map h := by
    have e1 : Dg.μ.hom ≫ h = ψ₁ := Iso.hom_inv_id_assoc _ _
    calc u0 = Dg.adj.homEquiv _ _ ψ₁ := (Equiv.apply_symm_apply _ _).symm
      _ = Dg.adj.homEquiv _ _ (Dg.μ.hom ≫ h) := by rw [e1]
      _ = Dg.adj.homEquiv _ _ Dg.μ.hom ≫
          (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ).map h :=
        Adjunction.homEquiv_naturality_right _ _ _
      _ = wcSuppUnitMap Dg ≫
          (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ).map h := by
        rw [Adjunction.homEquiv_unit]; rfl
  let c : C(↥(Limits.pullback U.hom g), ULift.{u+1} ℚ_[ℓ]) :=
    ((wcSuppUnitMap Dg).val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ]))
  let a : C(↥(Limits.pullback U.hom g), ULift.{u+1} ℚ_[ℓ]) :=
    (h.val.app (Opposite.op ((wcProEtBC g).obj U))).hom
      (1 : C(↥(Limits.pullback U.hom g), ULift.{u+1} ℚ_[ℓ]))
  have hu1 : (u0.val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ])) =
      (1 : C(↥(Limits.pullback U.hom g), ULift.{u+1} ℚ_[ℓ])) :=
    (Dg.φ.hom.app (Opposite.op U)).hom.map_one
  have hev : (u0.val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ])) =
      (h.val.app (Opposite.op ((wcProEtBC g).obj U))).hom c := by
    rw [hfac]
    rfl
  have hlin : ∀ x : C(↥(Limits.pullback U.hom g), ULift.{u+1} ℚ_[ℓ]),
      (h.val.app (Opposite.op ((wcProEtBC g).obj U))).hom x = x * a := by
    intro x
    have e := (h.val.app (Opposite.op ((wcProEtBC g).obj U))).hom.map_smul x
      (1 : C(↥(Limits.pullback U.hom g), ULift.{u+1} ℚ_[ℓ]))
    have e2 : (h.val.app (Opposite.op ((wcProEtBC g).obj U))).hom x =
        (h.val.app (Opposite.op ((wcProEtBC g).obj U))).hom (x * 1) :=
      congrArg (fun y => (h.val.app (Opposite.op ((wcProEtBC g).obj U))).hom y) (mul_one x).symm
    exact e2.trans e
  have key : c * a = 1 := by
    rw [← hlin c, ← hev, hu1]

  have hz : ((wcSuppUnitMap Di).val.app (Opposite.op U)).hom
      (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ])) = 0 := by
    have hempty : ∀ z : ↥(Limits.pullback U.hom i), False := by
      intro z
      have e : (Limits.pullback.fst U.hom i ≫ U.hom) z = (Limits.pullback.snd U.hom i ≫ i) z := by
        rw [Limits.pullback.condition]
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e
      exact hU (Limits.pullback.fst U.hom i z) ⟨Limits.pullback.snd U.hom i z, e.symm⟩
    change (((wcSuppUnitMap Di).val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ])) :
      C(↥(Limits.pullback U.hom i), ULift.{u+1} ℚ_[ℓ])) = 0
    exact ContinuousMap.ext (fun z => (hempty z).elim)

  have hT : ((Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val.app
        (Opposite.op ((wcProEtBC g).obj U))).hom c =
      ((Dg.adj.unit.app (wcSuppObj Di)).val.app (Opposite.op U)).hom
        (((wcSuppUnitMap Di).val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ]))) :=
    congrArg (fun φ => (φ.val.app (Opposite.op U)).hom (1 : C(↥U.left, ULift.{u+1} ℚ_[ℓ]))) htr
  have hvc : ((Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val.app
        (Opposite.op ((wcProEtBC g).obj U))).hom c = 0 := by
    rw [hT, hz]
    exact map_zero _

  have hW1 : ((Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val.app
        (Opposite.op ((wcProEtBC g).obj U))).hom
      (1 : C(↥(Limits.pullback U.hom g), ULift.{u+1} ℚ_[ℓ])) = 0 := by
    have e1 : (1 : C(↥(Limits.pullback U.hom g), ULift.{u+1} ℚ_[ℓ])) = a * c := by
      rw [mul_comm, key]
    have e2 : ((Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val.app
          (Opposite.op ((wcProEtBC g).obj U))).hom
        (1 : C(↥(Limits.pullback U.hom g), ULift.{u+1} ℚ_[ℓ])) =
        ((Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val.app
          (Opposite.op ((wcProEtBC g).obj U))).hom (a * c) :=
      congrArg (fun y => ((Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val.app
          (Opposite.op ((wcProEtBC g).obj U))).hom y) e1
    have hsm := ((Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val.app
          (Opposite.op ((wcProEtBC g).obj U))).hom.map_smul a c
    refine (e2.trans hsm).trans ?_
    rw [hvc]
    exact smul_zero _

  have h1 : ((SheafOfModules.unit (wcRingSheaf Y' ℓ)).val.map af.op).hom
      (1 : C(↥(Limits.pullback U.hom g), ULift.{u+1} ℚ_[ℓ])) =
      (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) := by
    change (1 : C(↥(Limits.pullback U.hom g), ULift.{u+1} ℚ_[ℓ])).comp af.left.base.hom = 1
    exact ContinuousMap.one_comp _
  refine (congrArg (fun y => ((Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val.app
    (Opposite.op V)).hom y) h1.symm).trans ?_
  refine (PresheafOfModules.naturality_apply
    (Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val af.op _).trans ?_
  exact (congrArg (fun y => ((Dg.Φ.obj (wcSuppObj Di)).val.map af.op).hom y) hW1).trans
    (map_zero _)

theorem wc_affine_zero_locus_weaklyEtale (X : Scheme.{u}) [IsAffine X] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (t : C(↥X, ULift.{u+1} ℚ_[ℓ])) :
    ∃ (W : Scheme.{u}) (q : W ⟶ X), IsAffine W ∧ WeaklyEtale q ∧
      (∀ w : ↥W, t (q w) = 0) ∧ ∀ x : ↥X, t x = 0 → x ∈ Set.range q :=
by
  classical
  let B := Γ(X, ⊤)
  let e := X.isoSpec
  have hτ : Continuous (fun p : ↥(Spec B) => t (e.inv p)) :=
    t.continuous.comp e.inv.continuous
  let Z : Set (PrimeSpectrum B) := {p | t (e.inv p) = 0}
  have hZc : IsClosed Z := isClosed_singleton.preimage hτ
  have hgen : ∀ p p' : PrimeSpectrum B, p ≤ p' → p' ∈ Z → p ∈ Z := by
    intro p p' hle hp'
    have hs : p ⤳ p' := (PrimeSpectrum.le_iff_specializes p p').mp hle
    have h2 : t (e.inv p) = t (e.inv p') := (hs.map hτ).eq
    show t (e.inv p) = 0
    rw [h2]
    exact hp'
  have key : ∀ p : PrimeSpectrum B, (∀ f ∈ p.asIdeal, ∃ q ∈ Z, f ∈ q.asIdeal) → p ∈ Z := by
    intro p hp
    have hZI : PrimeSpectrum.zeroLocus (PrimeSpectrum.vanishingIdeal Z : Set B) = Z := by
      rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hZc.closure_eq]
    by_cases h : p.asIdeal ⊔ PrimeSpectrum.vanishingIdeal Z = ⊤
    · exfalso
      have h1 : (1 : B) ∈ p.asIdeal ⊔ PrimeSpectrum.vanishingIdeal Z := by
        rw [h]; exact Submodule.mem_top
      obtain ⟨a, ha, i, hi, hai⟩ := Submodule.mem_sup.mp h1
      obtain ⟨q, hq, haq⟩ := hp a ha
      have hiq : i ∈ q.asIdeal := (PrimeSpectrum.mem_vanishingIdeal Z i).mp hi q hq
      have h1q : (1 : B) ∈ q.asIdeal := by
        rw [← hai]; exact q.asIdeal.add_mem haq hiq
      exact q.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1q)
    · obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ h
      let M : PrimeSpectrum B := ⟨m, hm.isPrime⟩
      have hM : M ∈ Z := by
        rw [← hZI]
        exact (PrimeSpectrum.mem_zeroLocus _ _).mpr
          (fun x hx => hle (Ideal.mem_sup_right hx))
      exact hgen p M (le_sup_left.trans hle) hM
  let S : Submonoid B :=
    { carrier := {f | ∀ q ∈ Z, f ∉ q.asIdeal}
      one_mem' := fun q _ h1 => q.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
      mul_mem' := fun {f g} hf hg q hq hfg =>
        (q.isPrime.mem_or_mem hfg).elim (hf q hq) (hg q hq) }
  let L := Localization S
  let q₀ : Spec (CommRingCat.of L) ⟶ Spec B := Spec.map (CommRingCat.ofHom (algebraMap B L))
  have hq₀ : WeaklyEtale q₀ := by
    haveI : Flat q₀ := HasRingHomProperty.Spec_iff.mpr
      (RingHom.flat_algebraMap_iff.mpr (IsLocalization.flat L S))
    haveI : Epi (CommRingCat.ofHom (algebraMap B L)) := IsLocalization.epi S L
    haveI : Mono q₀ :=
      inferInstanceAs (Mono (Scheme.Spec.map (CommRingCat.ofHom (algebraMap B L)).op))
    exact WeaklyEtale.mk
  refine ⟨Spec (CommRingCat.of L), q₀ ≫ e.inv, inferInstance,
    MorphismProperty.RespectsIso.postcomp @WeaklyEtale e.inv q₀ hq₀, ?_, ?_⟩
  · intro w
    have hw : PrimeSpectrum.comap (algebraMap B L) w ∈
        Set.range (PrimeSpectrum.comap (algebraMap B L)) := ⟨w, rfl⟩
    rw [PrimeSpectrum.localization_comap_range L S] at hw
    have hp := key (PrimeSpectrum.comap (algebraMap B L) w) (by
      intro f hf
      by_contra hcon
      push_neg at hcon
      exact Set.disjoint_left.mp hw (show f ∈ (S : Set B) from hcon) hf)
    rw [Scheme.Hom.comp_apply]
    exact hp
  · intro x hx
    have hpZ : (e.hom x : PrimeSpectrum B) ∈ Z := by
      show t (e.inv (e.hom x)) = 0
      rw [Scheme.hom_inv_apply]
      exact hx
    have hdisj : (e.hom x : PrimeSpectrum B) ∈
        {p : PrimeSpectrum B | Disjoint (S : Set B) p.asIdeal} :=
      Set.disjoint_left.mpr (fun f hfS hfp => hfS _ hpZ hfp)
    rw [← PrimeSpectrum.localization_comap_range L S] at hdisj
    obtain ⟨w, hw⟩ := hdisj
    refine ⟨(w : ↥(Spec (CommRingCat.of L))), ?_⟩
    change e.inv (PrimeSpectrum.comap (algebraMap B L) w) = x
    rw [hw]
    exact Scheme.hom_inv_apply e x

theorem wc_affine_complement_basicOpen_cover {Y' Z' : Scheme.{u}} (i' : Z' ⟶ Y') [IsClosedImmersion i']
    [IsLocallyNoetherian Y'] (W : Scheme.{u}) [IsAffine W] (p : W ⟶ Y') :
    ∃ (n : ℕ) (f : Fin n → Γ(W, ⊤)),
      ∀ x : ↥W, (p x ∉ Set.range i' ↔ ∃ k, x ∈ W.basicOpen (f k)) :=
by
  classical
  have hC : IsOpen (Set.range i')ᶜ := i'.isClosedEmbedding.isClosed_range.isOpen_compl
  have hK : IsCompact (Set.range p) := isCompact_range p.continuous
  have hcov : Set.range p ⊆ ⋃ V : Y'.affineOpens, ((V : Y'.Opens) : Set Y') := by
    intro y _
    obtain ⟨V, hV, hyV, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens Y')) (show y ∈ (⊤ : Y'.Opens) from trivial)
    exact Set.mem_iUnion.mpr ⟨⟨V, hV⟩, hyV⟩
  obtain ⟨t, ht⟩ := hK.elim_finite_subcover
    (fun V : Y'.affineOpens => ((V : Y'.Opens) : Set Y')) (fun V => V.1.isOpen) hcov
  haveI : QuasiCompact p := quasiCompact_of_compactSpace p
  have hcpt : ∀ V : Y'.affineOpens,
      IsCompact (p ⁻¹' ((Set.range i')ᶜ ∩ ((V : Y'.Opens) : Set Y'))) := by
    intro V
    haveI : IsNoetherianRing Γ(Y', V.1) := IsLocallyNoetherian.component_noetherian V
    haveI : TopologicalSpace.NoetherianSpace V.1 := noetherianSpace_of_isAffineOpen V.1 V.2
    have h1 : IsCompact (Subtype.val ⁻¹' (Set.range i')ᶜ : Set V.1) :=
      TopologicalSpace.NoetherianSpace.isCompact _
    have h2 : IsCompact (((V : Y'.Opens) : Set Y') ∩ (Set.range i')ᶜ) := by
      convert h1.image continuous_subtype_val using 1
      ext y
      constructor
      · rintro ⟨hz, h⟩
        exact ⟨⟨y, hz⟩, h, rfl⟩
      · rintro ⟨⟨z, hz⟩, h, rfl⟩
        exact ⟨hz, h⟩
    rw [Set.inter_comm]
    exact QuasiCompact.isCompact_preimage _ (V.1.isOpen.inter hC) h2
  have hpre : p ⁻¹' (Set.range i')ᶜ =
      ⋃ V ∈ t, p ⁻¹' ((Set.range i')ᶜ ∩ ((V : Y'.Opens) : Set Y')) := by
    ext x
    simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_inter_iff, exists_prop]
    constructor
    · intro hx
      obtain ⟨V, hVt, hxV⟩ := Set.mem_iUnion₂.mp (ht ⟨x, rfl⟩)
      exact ⟨V, hVt, hx, hxV⟩
    · rintro ⟨V, _, hx, _⟩
      exact hx
  have hcptU : IsCompact (p ⁻¹' (Set.range i')ᶜ) := by
    rw [hpre]
    exact t.isCompact_biUnion (fun V _ => hcpt V)
  have hopen : IsOpen (p ⁻¹' (Set.range i')ᶜ) := hC.preimage p.continuous
  obtain ⟨s, hs, hseq⟩ :=
    isCompact_and_isOpen_iff_finite_and_eq_biUnion_basicOpen.mp ⟨hcptU, hopen⟩
  obtain ⟨n, f, -, hf⟩ := hs.fin_param
  refine ⟨n, f, fun x => ?_⟩
  have hmem : p x ∉ Set.range i' ↔ x ∈ p ⁻¹' (Set.range i')ᶜ := Iff.rfl
  rw [hmem, hseq, Set.mem_iUnion₂]
  constructor
  · rintro ⟨g, hg, hx⟩
    rw [← hf] at hg
    obtain ⟨k, rfl⟩ := hg
    exact ⟨k, hx⟩
  · rintro ⟨k, hk⟩
    exact ⟨f k, hf ▸ ⟨k, rfl⟩, hk⟩

theorem wc_supp_kernel_kill_of_noetherian {Y Z Y' Z' : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    (g : Y' ⟶ Y) (i' : Z' ⟶ Y') (g' : Z' ⟶ Z) (hsq : IsPullback i' g' g i)
    [IsLocallyNoetherian Y'] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (Di' : wcHMPullData i' ℓ) (hDi' : wcHMPullCanonical Di')
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg) :
    Limits.kernel.ι (wcSuppUnitMap Di') ≫ Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di) = 0 :=
by
  classical
  haveI : IsClosedImmersion i' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq.flip ‹IsClosedImmersion i›

  have vanish : ∀ (V : Y'.ProEt) (t : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
      ((wcSuppUnitMap Di').val.app (Opposite.op V)).hom t = 0 →
      ∀ y : ↥V.left, V.hom y ∈ Set.range i' → t y = 0 := by
    intro V t h0 y hy
    have hy' : y ∈ Set.range (Limits.pullback.fst V.hom i') := by
      rw [Scheme.Pullback.range_fst]; exact hy
    obtain ⟨z, rfl⟩ := hy'
    obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit Di'
    have htw := wc_supp_hom_twist_formula Di' hDi' (wcSuppUnitMap Di') V t
    rw [h0] at htw
    have h1 := congrArg
      (fun φ : C(↥(Limits.pullback V.hom i'), ULift.{u+1} ℚ_[ℓ]) => φ z) htw
    have h2 := congrArg (fun φ : C(↥Z', ULift.{u+1} ℚ_[ℓ]) =>
      φ ((Limits.pullback.snd V.hom i').base.hom z)) hc'
    simp only [ContinuousMap.mul_apply, ContinuousMap.comp_apply,
      ContinuousMap.one_apply] at h1 h2
    have h1' : (0 : ULift.{u+1} ℚ_[ℓ]) =
        t ((Limits.pullback.fst V.hom i').base.hom z) *
          (wcSuppTwist (wcSuppUnitMap Di')) ((Limits.pullback.snd V.hom i').base.hom z) := h1
    show t ((Limits.pullback.fst V.hom i').base.hom z) = 0
    linear_combination (-(c' ((Limits.pullback.snd V.hom i').base.hom z))) * h1' -
      (t ((Limits.pullback.fst V.hom i').base.hom z)) * h2

  have key : ∀ (V : Y'.ProEt) (t : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
      (∀ y : ↥V.left, V.hom y ∈ Set.range i' → t y = 0) →
      ((Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val.app (Opposite.op V)).hom t = 0 := by
    intro V t ht
    apply wc_proet_module_section_eq_zero_of_affine_covers (Dg.Φ.obj (wcSuppObj Di)) V
    intro W gW hWaff
    haveI : IsAffine W.left := hWaff
    haveI : WeaklyEtale W.hom := W.prop
    have htW : ∀ w : ↥W.left, W.hom w ∈ Set.range i' → (t.comp gW.left.base.hom) w = 0 := by
      intro w hw
      apply ht
      have e : V.hom (gW.left w) = W.hom w := by
        rw [← MorphismProperty.Over.w gW]; rfl
      rw [e]; exact hw
    obtain ⟨W₀, q, hW₀, hq, hq0, hqr⟩ :=
      wc_affine_zero_locus_weaklyEtale W.left ℓ (t.comp gW.left.base.hom)
    obtain ⟨n, f, hf⟩ := wc_affine_complement_basicOpen_cover i' W.left W.hom
    haveI := hq
    let W' : Fin (n + 1) → Y'.ProEt :=
      Fin.cases (MorphismProperty.Over.mk ⊤ (q ≫ W.hom) inferInstance)
        (fun k => MorphismProperty.Over.mk ⊤ ((W.left.basicOpen (f k)).ι ≫ W.hom) inferInstance)
    let e : ∀ k, W' k ⟶ W := Fin.cases (motive := fun k => W' k ⟶ W)
      (MorphismProperty.Over.homMk q rfl trivial)
      (fun k => MorphismProperty.Over.homMk (W.left.basicOpen (f k)).ι rfl trivial)
    refine ⟨n + 1, W', e, ?_, ?_, ?_⟩
    · intro k
      induction k using Fin.cases with
      | zero => exact hW₀
      | succ k => exact (isAffineOpen_top W.left).basicOpen (f k)
    · intro x
      by_cases hx : W.hom x ∈ Set.range i'
      · exact ⟨0, hqr x (htW x hx)⟩
      · obtain ⟨k, hk⟩ := (hf x).mp hx
        refine ⟨k.succ, ?_⟩
        show x ∈ Set.range (W.left.basicOpen (f k)).ι
        rw [Scheme.Opens.range_ι]
        exact hk
    · intro k
      refine (PresheafOfModules.naturality_apply
        (Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val (e k ≫ gW).op t).symm.trans ?_
      induction k using Fin.cases with
      | zero =>
        have h0 : (t.comp ((e 0 ≫ gW).left.base.hom) : C(↥(W' 0).left, ULift.{u+1} ℚ_[ℓ])) = 0 := by
          ext w
          exact congrArg ULift.down (hq0 w)
        change ((Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val.app (Opposite.op (W' 0))).hom
          (t.comp ((e 0 ≫ gW).left.base.hom)) = 0
        refine (congrArg (fun s => ((Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val.app
          (Opposite.op (W' 0))).hom s) h0).trans ?_
        exact map_zero _
      | succ k =>
        have hV : ∀ x : ↥(W' k.succ).left, (W' k.succ).hom x ∉ Set.range i' := by
          intro x
          have hx : (W.left.basicOpen (f k)).ι x ∈ (W.left.basicOpen (f k) : Set ↥W.left) := by
            rw [← Scheme.Opens.range_ι]; exact ⟨x, rfl⟩
          exact (hf _).mpr ⟨k, hx⟩
        have hs4 := wc_supp_pull_unit_vanish_off i g i' g' hsq ℓ Di Dg (W' k.succ) hV
        have hsm := ((Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val.app
          (Opposite.op (W' k.succ))).hom.map_smul (t.comp ((e k.succ ≫ gW).left.base.hom))
          (1 : C(↥(W' k.succ).left, ULift.{u+1} ℚ_[ℓ]))
        change ((Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val.app (Opposite.op (W' k.succ))).hom
          (t.comp ((e k.succ ≫ gW).left.base.hom)) = 0
        refine (congrArg (fun s => ((Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val.app
          (Opposite.op (W' k.succ))).hom s)
          (mul_one (t.comp ((e k.succ ≫ gW).left.base.hom))).symm).trans ?_
        refine hsm.trans ?_
        rw [hs4]
        exact smul_zero _

  apply SheafOfModules.hom_ext
  apply PresheafOfModules.hom_ext
  intro X
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  induction X using Opposite.rec with
  | op V =>
  have hk := congrArg (fun φ => (φ.val.app (Opposite.op V)).hom x)
    (Limits.kernel.condition (wcSuppUnitMap Di'))
  change ((wcSuppUnitMap Di').val.app (Opposite.op V)).hom
    (((Limits.kernel.ι (wcSuppUnitMap Di')).val.app (Opposite.op V)).hom x) = 0 at hk
  change ((Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di)).val.app (Opposite.op V)).hom
    (((Limits.kernel.ι (wcSuppUnitMap Di')).val.app (Opposite.op V)).hom x) = 0
  exact key V _ (vanish V _ hk)

theorem wc_supp_class_base_change_of_noetherian {Y Z Y' Z' : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    (g : Y' ⟶ Y) (i' : Z' ⟶ Y') (g' : Z' ⟶ Z) (hsq : IsPullback i' g' g i)
    [IsLocallyNoetherian Y] [IsLocallyNoetherian Y']
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (Di' : wcHMPullData i' ℓ) (hDi' : wcHMPullCanonical Di')
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg)
    (n : ℕ) (θ : wcSuppExt Di n) :
    ∃ θ' : wcSuppExt Di' n, wcHMPull Dg n (wcSuppClass Di n θ) = wcSuppClass Di' n θ' :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y' ℓ)) := HasExt.standard _
  haveI := Dg.additive
  haveI := Dg.presLim
  haveI := Dg.presColim
  haveI : IsClosedImmersion i' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq.flip ‹IsClosedImmersion i›
  haveI : Epi (wcSuppUnitMap Di') := wc_supp_unit_epi_of_noetherian i' ℓ Di' hDi'
  have hK := wc_supp_kernel_kill_of_noetherian i g i' g' hsq ℓ Di hDi Di' hDi' Dg hDg
  obtain ⟨β, hβ⟩ : ∃ β : wcSuppObj Di' ⟶ Dg.Φ.obj (wcSuppObj Di),
      wcSuppUnitMap Di' ≫ β = Dg.μ.inv ≫ Dg.Φ.map (wcSuppUnitMap Di) :=
    ⟨Abelian.epiDesc _ _ hK, Abelian.comp_epiDesc _ _ _⟩
  obtain ⟨T, hT⟩ : ∃ T : Abelian.Ext (Dg.Φ.obj (wcSuppObj Di)) (SheafOfModules.unit (wcRingSheaf Y' ℓ)) n,
      T = (Abelian.Ext.mapExactFunctor Dg.Φ θ).comp (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero n) :=
    ⟨_, rfl⟩
  refine ⟨(Abelian.Ext.mk₀ β).comp T (zero_add n), ?_⟩
  show (Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ
      ((Abelian.Ext.mk₀ (wcSuppUnitMap Di)).comp θ (zero_add n))).comp
      (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero n)) (zero_add n) =
    (Abelian.Ext.mk₀ (wcSuppUnitMap Di')).comp ((Abelian.Ext.mk₀ β).comp T (zero_add n)) (zero_add n)
  rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
    Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (Dg.Φ.map (wcSuppUnitMap Di)))
      (Abelian.Ext.mapExactFunctor Dg.Φ θ) (Abelian.Ext.mk₀ Dg.μ.hom) (zero_add n) (add_zero n)
      (by omega), ← hT,
    ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ Dg.μ.inv)
      (Abelian.Ext.mk₀ (Dg.Φ.map (wcSuppUnitMap Di))) T (zero_add 0) (zero_add n) (by omega),
    ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (wcSuppUnitMap Di'))
      (Abelian.Ext.mk₀ β) T (zero_add 0) (zero_add n) (by omega),
    Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hβ]

theorem wc_ybar_fibre_projection (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (D1 : wcHMPullData (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ) (hD1 : wcHMPullCanonical D1)
    (D2 : wcHMPullData (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ) (hD2 : wcHMPullCanonical D2)
    (x₀ : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X) (hx₀ : x₀ ≫ wcPi2 F X = 𝟙 _)
    (i : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X))
    (hi1 : i ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = wcPi2 F X ≫ x₀)
    (hi2 : i ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) = 𝟙 _)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (ω : wcHM (wcXbar F X) ℓ (2 * d))
    (y : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d)) :
    wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
        (wcHMPull D1 (2 * d) ω) y =
      wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
        (wcHMPull D1 (2 * d) ω) (wcHMPull D2 (2 * d) (wcHMPull Di (2 * d) y)) :=
by
  classical

  obtain ⟨Did, hDid⟩ := wc_hm_pull_data_exists (𝟙 (wcXbar F X)) ℓ
  have hR2 : ∀ x : wcHM (wcXbar F X) ℓ (2 * d),
      wcHMPull Di (2 * d) (wcHMPull D2 (2 * d) x) = x := by
    intro x
    rw [← wc_hm_pull_comp _ i (𝟙 _) hi2 D2 hD2 Di hDi Did hDid (2 * d) x]
    exact wc_hm_pull_id _ rfl Did hDid (2 * d) x
  obtain ⟨w, hw⟩ : ∃ w : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      w = y - wcHMPull D2 (2 * d) (wcHMPull Di (2 * d) y) := ⟨_, rfl⟩
  have hiw : wcHMPull Di (2 * d) w = 0 := by
    rw [hw, map_sub, hR2, sub_self]

  haveI : IsProper (wcPi2 F X) := inferInstance
  haveI : IsSeparated (wcPi2 F X) := inferInstance
  haveI : IsClosedImmersion (x₀ ≫ wcPi2 F X) := by rw [hx₀]; infer_instance
  haveI : IsClosedImmersion x₀ := IsClosedImmersion.of_comp x₀ (wcPi2 F X)
  haveI : IsSeparated (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) := inferInstance
  haveI : IsClosedImmersion (i ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) := by
    rw [hi2]; infer_instance
  haveI : IsClosedImmersion i := IsClosedImmersion.of_comp i (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X))
  have hsq : IsPullback i (wcPi2 F X) (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) x₀ := by
    refine IsPullback.of_right (h₁₂ := Limits.pullback.snd (wcPi2 F X) (wcPi2 F X))
      (h₂₂ := wcPi2 F X) (v₁₃ := wcPi2 F X) ?_ hi1 (IsPullback.of_hasPullback _ _).flip
    rw [hi2, hx₀]
    exact (IsPullback.id_vert (wcPi2 F X)).flip

  haveI : IsLocallyNoetherian (wcXbar F X) := LocallyOfFiniteType.isLocallyNoetherian (wcPi2 F X)
  haveI : IsLocallyNoetherian (Limits.pullback (wcPi2 F X) (wcPi2 F X)) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X))

  have h : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F)
  obtain ⟨T, hTs, -⟩ := wc_hm_comparison F X h ℓ
  obtain ⟨⟨e₁, he₁⟩, -⟩ := wc_top_coh_frobenius F X d ℓ hℓ h
  have hTinv : ∀ (n : ℕ) (c : ℚ_[ℓ]) (z : wcHM (wcXbar F X) ℓ n),
      (T n).symm (wcHMScalar (wcXbar F X) ℓ n c z) = wcCohScalar F X h ℓ n c ((T n).symm z) := by
    intro n c z
    apply (T n).injective
    rw [AddEquiv.apply_symm_apply, hTs, AddEquiv.apply_symm_apply]
  obtain ⟨η, hηapp⟩ : ∃ η : wcHM (wcXbar F X) ℓ (2 * d) →+ ℚ_[ℓ],
      ∀ z, η z = e₁ ((T (2 * d)).symm z) 0 :=
    ⟨(Pi.evalAddMonoidHom (fun _ : Fin 1 => ℚ_[ℓ]) 0).comp
      (e₁.toAddMonoidHom.comp (T (2 * d)).symm.toAddMonoidHom), fun z => rfl⟩
  have hηinj : Function.Injective η := by
    intro z z' hzz
    rw [hηapp, hηapp] at hzz
    have h1 : e₁ ((T (2 * d)).symm z) = e₁ ((T (2 * d)).symm z') := by
      funext k
      rw [Subsingleton.elim k 0]
      exact hzz
    exact (T (2 * d)).symm.injective (e₁.injective h1)
  have hηc : ∀ (c : ℚ_[ℓ]) (z : wcHM (wcXbar F X) ℓ (2 * d)),
      η (wcHMScalar (wcXbar F X) ℓ (2 * d) c z) = c * η z := by
    intro c z
    rw [hηapp, hηapp, hTinv, he₁]
    rfl
  obtain ⟨Dx, hDx⟩ := wc_hm_pull_data_exists x₀ ℓ
  obtain ⟨θ₀, hθ₀⟩ := wc_xbar_point_supp_class_nonzero F X d ℓ hℓ x₀ hx₀ Dx hDx
  have hη0 : η (wcSuppClass Dx (2 * d) θ₀) ≠ 0 := by
    intro h0
    apply hθ₀
    apply hηinj
    rw [h0, map_zero]
  have hωline : ω = wcHMScalar (wcXbar F X) ℓ (2 * d)
      (η ω / η (wcSuppClass Dx (2 * d) θ₀)) (wcSuppClass Dx (2 * d) θ₀) := by
    apply hηinj
    rw [hηc, div_mul_cancel₀ _ hη0]
  have habs : ∀ c : ℚ_[ℓ], ∃ θ : wcSuppExt Dx (2 * d),
      wcHMScalar (wcXbar F X) ℓ (2 * d) c (wcSuppClass Dx (2 * d) θ₀) =
        wcSuppClass Dx (2 * d) θ := by
    intro c
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
    refine ⟨θ₀.comp (Abelian.Ext.mk₀ (wcHMConst (wcXbar F X) ℓ c)) (add_zero _), ?_⟩
    show ((Abelian.Ext.mk₀ (wcSuppUnitMap Dx)).comp θ₀ (zero_add _)).comp
        (Abelian.Ext.mk₀ (wcHMConst (wcXbar F X) ℓ c)) (add_zero _) =
      (Abelian.Ext.mk₀ (wcSuppUnitMap Dx)).comp
        (θ₀.comp (Abelian.Ext.mk₀ (wcHMConst (wcXbar F X) ℓ c)) (add_zero _)) (zero_add _)
    exact Abelian.Ext.comp_assoc _ _ _ (zero_add _) (add_zero _) (by omega)
  obtain ⟨θ, hθs⟩ := habs (η ω / η (wcSuppClass Dx (2 * d) θ₀))
  have hθ : ω = wcSuppClass Dx (2 * d) θ := hωline.trans hθs

  obtain ⟨θ', hθ'⟩ := wc_supp_class_base_change_of_noetherian x₀
    (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) i (wcPi2 F X) hsq ℓ Dx hDx Di hDi D1 hD1
    (2 * d) θ
  have hP1 : wcHMPull D1 (2 * d) ω = wcSuppClass Di (2 * d) θ' := by
    rw [hθ]; exact hθ'

  have hex := wc_closed_pushforward_exact_of_noetherian i ℓ Di

  have hsign : ((-1 : ℤ) ^ (2 * d * (2 * d))) = 1 := by
    rw [mul_assoc]
    exact Even.neg_one_pow (even_two_mul _)
  have key : wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
      (wcHMPull D1 (2 * d) ω) w = 0 := by
    rw [wc_hm_graded_comm (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d)
      (by omega) (by omega) (wcHMPull D1 (2 * d) ω) w, hsign, one_zsmul, hP1]
    exact wc_closed_supp_class_restriction_zero_of_exact i ℓ Di hex (2 * d) (2 * d) (4 * d)
      (by omega) θ' w hiw
  rw [← sub_eq_zero, ← map_sub, ← hw]
  exact key

theorem wc_ybar_top_class_nonzero (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (D1 : wcHMPullData (Limits.pullback.fst (wcPi2 F X) (wcPi2 F X)) ℓ) (hD1 : wcHMPullCanonical D1)
    (D2 : wcHMPullData (Limits.pullback.snd (wcPi2 F X) (wcPi2 F X)) ℓ) (hD2 : wcHMPullCanonical D2)
    (ω : wcHM (wcXbar F X) ℓ (2 * d)) (hω : ω ≠ 0) :
    wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
      (wcHMPull D1 (2 * d) ω) (wcHMPull D2 (2 * d) ω) ≠ 0 :=
by
  classical

  have H_scR : ∀ (S : Scheme.{u}) (a b k : ℕ) (hk : a + b = k) (c : ℚ_[ℓ]) (x : wcHM S ℓ a)
      (y : wcHM S ℓ b), wcHMCup S ℓ a b k hk x (wcHMScalar S ℓ b c y) =
        wcHMScalar S ℓ k c (wcHMCup S ℓ a b k hk x y) := by
    intro S a b k hk c x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    show x.comp (y.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero b)) hk =
      (x.comp y hk).comp (Abelian.Ext.mk₀ (wcHMConst S ℓ c)) (add_zero k)
    exact (Abelian.Ext.comp_assoc x y _ hk (add_zero b) (by omega)).symm
  have H_mul : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (a b k : ℕ) (hk : a + b = k)
      (x : wcHM S ℓ a) (y : wcHM S ℓ b),
      wcHMPull D k (wcHMCup S ℓ a b k hk x y) =
        wcHMCup S' ℓ a b k hk (wcHMPull D a x) (wcHMPull D b y) := by
    intro S S' f D a b k hk x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y hk)).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero k)) (zero_add k) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero a)) (zero_add a)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero b)) (zero_add b)) hk
    rw [Abelian.Ext.mapExactFunctor_comp]
    generalize Abelian.Ext.mapExactFunctor D.Φ x = z
    generalize Abelian.Ext.mapExactFunctor D.Φ y = w
    have e1 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        (w.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b)) (zero_add b)) (zero_add b) =
        w.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero b) := by
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add b) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
        (z.comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero a)) _ (zero_add a) hk (by omega),
      Abelian.Ext.comp_assoc z (Abelian.Ext.mk₀ D.μ.hom) _ (add_zero a) (zero_add b) (by omega), e1,
      Abelian.Ext.comp_assoc z w (Abelian.Ext.mk₀ D.μ.hom) hk (add_zero b) (by omega)]

  have hPS : ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ (2 * d)),
      wcHMPull D2 (2 * d) (wcHMScalar (wcXbar F X) ℓ (2 * d) c x) =
        wcHMScalar (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) c
          (wcHMPull D2 (2 * d) x) := by
    intro c x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1}
      (wcRingSheaf (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ)) := HasExt.standard _
    have e := H_mul D2 (2 * d) 0 (2 * d) (add_zero _) x
      (Abelian.Ext.mk₀ (wcHMConst (wcXbar F X) ℓ c))
    have e0 : wcHMPull D2 0 (Abelian.Ext.mk₀ (wcHMConst (wcXbar F X) ℓ c)) =
        Abelian.Ext.mk₀ (wcHMConst (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ c) := by
      haveI := D2.additive
      haveI := D2.presLim
      haveI := D2.presColim
      show (Abelian.Ext.mk₀ D2.μ.inv).comp ((Abelian.Ext.mapExactFunctor D2.Φ
          (Abelian.Ext.mk₀ (wcHMConst (wcXbar F X) ℓ c))).comp
          (Abelian.Ext.mk₀ D2.μ.hom) (add_zero 0)) (zero_add 0) = _
      rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀,
        wc_hm_pull_const D2 hD2 c]
    rw [e0] at e
    exact e

  have h : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F)
  obtain ⟨T, hTs, -⟩ := wc_hm_comparison F X h ℓ
  obtain ⟨⟨e₁, he₁⟩, -⟩ := wc_top_coh_frobenius F X d ℓ hℓ h
  have hTinv : ∀ (n : ℕ) (c : ℚ_[ℓ]) (y : wcHM (wcXbar F X) ℓ n),
      (T n).symm (wcHMScalar (wcXbar F X) ℓ n c y) = wcCohScalar F X h ℓ n c ((T n).symm y) := by
    intro n c y
    apply (T n).injective
    rw [AddEquiv.apply_symm_apply, hTs, AddEquiv.apply_symm_apply]
  obtain ⟨η, hηapp⟩ : ∃ η : wcHM (wcXbar F X) ℓ (2 * d) →+ ℚ_[ℓ],
      ∀ y, η y = e₁ ((T (2 * d)).symm y) 0 :=
    ⟨(Pi.evalAddMonoidHom (fun _ : Fin 1 => ℚ_[ℓ]) 0).comp
      (e₁.toAddMonoidHom.comp (T (2 * d)).symm.toAddMonoidHom), fun y => rfl⟩
  have hηinj : Function.Injective η := by
    intro y y' hyy
    rw [hηapp, hηapp] at hyy
    have h1 : e₁ ((T (2 * d)).symm y) = e₁ ((T (2 * d)).symm y') := by
      funext k
      rw [Subsingleton.elim k 0]
      exact hyy
    exact (T (2 * d)).symm.injective (e₁.injective h1)
  have hηc : ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F X) ℓ (2 * d)),
      η (wcHMScalar (wcXbar F X) ℓ (2 * d) c x) = c * η x := by
    intro c x
    rw [hηapp, hηapp, hTinv, he₁]
    rfl
  have hηω : η ω ≠ 0 := by
    intro h0
    apply hω
    apply hηinj
    rw [h0, map_zero]
  have hU : ∀ u : wcHM (wcXbar F X) ℓ (2 * d),
      u = wcHMScalar (wcXbar F X) ℓ (2 * d) (η u / η ω) ω := by
    intro u
    apply hηinj
    rw [hηc, div_mul_cancel₀ _ hηω]

  obtain ⟨x₀, hx₀⟩ := wc_xbar_geom_point_exists F X d
  have ws : 𝟙 (wcXbar F X) ≫ wcPi2 F X = (wcPi2 F X ≫ x₀) ≫ wcPi2 F X := by
    rw [Category.assoc, hx₀, Category.comp_id, Category.id_comp]
  obtain ⟨s, hS1⟩ : ∃ s : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X),
      s ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = 𝟙 _ :=
    ⟨Limits.pullback.lift (𝟙 _) (wcPi2 F X ≫ x₀) ws, Limits.pullback.lift_fst _ _ _⟩
  obtain ⟨i, hi1, hi2⟩ : ∃ i : wcXbar F X ⟶ Limits.pullback (wcPi2 F X) (wcPi2 F X),
      i ≫ Limits.pullback.fst (wcPi2 F X) (wcPi2 F X) = wcPi2 F X ≫ x₀ ∧
      i ≫ Limits.pullback.snd (wcPi2 F X) (wcPi2 F X) = 𝟙 _ :=
    ⟨Limits.pullback.lift (wcPi2 F X ≫ x₀) (𝟙 _) ws.symm, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨Ds, hDs⟩ := wc_hm_pull_data_exists s ℓ
  obtain ⟨Di, hDi⟩ := wc_hm_pull_data_exists i ℓ
  obtain ⟨Did, hDid⟩ := wc_hm_pull_data_exists (𝟙 (wcXbar F X)) ℓ

  have hR1 : ∀ x : wcHM (wcXbar F X) ℓ (2 * d),
      wcHMPull Ds (2 * d) (wcHMPull D1 (2 * d) x) = x := by
    intro x
    rw [← wc_hm_pull_comp _ s (𝟙 _) hS1 D1 hD1 Ds hDs Did hDid (2 * d) x]
    exact wc_hm_pull_id _ rfl Did hDid (2 * d) x
  have hP1 : wcHMPull D1 (2 * d) ω ≠ 0 := by
    intro h0
    apply hω
    rw [← hR1 ω, h0, map_zero]

  obtain ⟨z, hz⟩ : ∃ z : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega)
        (wcHMPull D1 (2 * d) ω) z ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    exact hP1 (wc_ybar_poincare_middle F X d ℓ hℓ _ hcon)

  have hfib := wc_ybar_fibre_projection F X d ℓ hℓ D1 hD1 D2 hD2 x₀ hx₀ i hi1 hi2 Di hDi ω z
  intro hΩ
  apply hz
  rw [hfib, hU (wcHMPull Di (2 * d) z), hPS, H_scR, hΩ, map_zero]

theorem wc_leray_ext_dim_bound : ∀ {K : Type*} [Field K] {C : Type*} {D : Type*} [Category C] [Category D]
    [Abelian C] [Abelian D] [EnoughInjectives D] (L : D ⥤ C) (R : C ⥤ D) [L.Additive] [R.Additive]
    (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] (P : D) (γ : K → (P ⟶ P)),
    γ 1 = 𝟙 P → (∀ a b : K, γ (a * b) = γ b ≫ γ a) → (∀ a b : K, γ (a + b) = γ a + γ b) →
    ∀ (A : C) (I : InjectiveResolution A) (k : ℕ) (b : ℕ → ℕ),
    letI := HasExt.standard C; letI := HasExt.standard D;
    (∀ p : ℕ, p ≤ k → ∃ (np : ℕ) (e : Abelian.Ext P
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology (k - p)) p ≃+
          (Fin np → K)),
      (∀ (c : K) (x : Abelian.Ext P
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology (k - p)) p),
        e ((Abelian.Ext.mk₀ (γ c)).comp x (zero_add p)) = c • e x) ∧ np ≤ b p) →
    ∃ (N : ℕ) (e : Abelian.Ext (L.obj P) A k ≃+ (Fin N → K)),
      (∀ (c : K) (x : Abelian.Ext (L.obj P) A k),
        e ((Abelian.Ext.mk₀ (L.map (γ c))).comp x (zero_add k)) = c • e x) ∧
      N ≤ ∑ p ∈ Finset.range (k + 1), b p :=
by
  intro K _ C D _ _ _ _ _ L R _ _ adj _ P γ h1 hmul hadd A I k b hyp
  letI : HasExt C := HasExt.standard C
  letI : HasExt D := HasExt.standard D
  classical

  have hγ0 : γ 0 = 0 := by
    have h := hadd 0 0
    rw [add_zero] at h
    simpa using h
  have hLγ0 : L.map (γ 0) = 0 := by rw [hγ0, L.map_zero]
  letI instD : ∀ (M : D) (n : ℕ), Module K (Abelian.Ext P M n) := fun M n =>
    { smul := fun c x => (Abelian.Ext.mk₀ (γ c)).comp x (zero_add n)
      one_smul := fun x => by
        show (Abelian.Ext.mk₀ (γ 1)).comp x (zero_add n) = x
        rw [h1, Abelian.Ext.mk₀_id_comp]
      mul_smul := fun a b x => by
        show (Abelian.Ext.mk₀ (γ (a * b))).comp x (zero_add n) =
          (Abelian.Ext.mk₀ (γ a)).comp ((Abelian.Ext.mk₀ (γ b)).comp x (zero_add n)) (zero_add n)
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, mul_comm, hmul]
      smul_zero := fun a => by
        show (Abelian.Ext.mk₀ (γ a)).comp (0 : Abelian.Ext P M n) (zero_add n) = 0
        exact Abelian.Ext.comp_zero _ _ _ _ _
      smul_add := fun a x y => by
        show (Abelian.Ext.mk₀ (γ a)).comp (x + y) (zero_add n) =
          (Abelian.Ext.mk₀ (γ a)).comp x (zero_add n) + (Abelian.Ext.mk₀ (γ a)).comp y (zero_add n)
        exact Abelian.Ext.comp_add _ _ _ _
      add_smul := fun a b x => by
        show (Abelian.Ext.mk₀ (γ (a + b))).comp x (zero_add n) =
          (Abelian.Ext.mk₀ (γ a)).comp x (zero_add n) + (Abelian.Ext.mk₀ (γ b)).comp x (zero_add n)
        rw [hadd, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp]
      zero_smul := fun x => by
        show (Abelian.Ext.mk₀ (γ 0)).comp x (zero_add n) = 0
        rw [hγ0, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp] }
  letI instC : ∀ (M : C) (n : ℕ), Module K (Abelian.Ext (L.obj P) M n) := fun M n =>
    { smul := fun c x => (Abelian.Ext.mk₀ (L.map (γ c))).comp x (zero_add n)
      one_smul := fun x => by
        show (Abelian.Ext.mk₀ (L.map (γ 1))).comp x (zero_add n) = x
        rw [h1, L.map_id, Abelian.Ext.mk₀_id_comp]
      mul_smul := fun a b x => by
        show (Abelian.Ext.mk₀ (L.map (γ (a * b)))).comp x (zero_add n) =
          (Abelian.Ext.mk₀ (L.map (γ a))).comp
            ((Abelian.Ext.mk₀ (L.map (γ b))).comp x (zero_add n)) (zero_add n)
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, mul_comm, hmul, L.map_comp]
      smul_zero := fun a => by
        show (Abelian.Ext.mk₀ (L.map (γ a))).comp (0 : Abelian.Ext (L.obj P) M n) (zero_add n) = 0
        exact Abelian.Ext.comp_zero _ _ _ _ _
      smul_add := fun a x y => by
        show (Abelian.Ext.mk₀ (L.map (γ a))).comp (x + y) (zero_add n) =
          (Abelian.Ext.mk₀ (L.map (γ a))).comp x (zero_add n) +
            (Abelian.Ext.mk₀ (L.map (γ a))).comp y (zero_add n)
        exact Abelian.Ext.comp_add _ _ _ _
      add_smul := fun a b x => by
        show (Abelian.Ext.mk₀ (L.map (γ (a + b)))).comp x (zero_add n) =
          (Abelian.Ext.mk₀ (L.map (γ a))).comp x (zero_add n) +
            (Abelian.Ext.mk₀ (L.map (γ b))).comp x (zero_add n)
        rw [hadd, L.map_add, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp]
      zero_smul := fun x => by
        show (Abelian.Ext.mk₀ (L.map (γ 0))).comp x (zero_add n) = 0
        rw [hLγ0, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp] }

  have postL : ∀ {M M' : D} {n m q : ℕ} (y : Abelian.Ext M M' m) (h : n + m = q),
      ∃ f : Abelian.Ext P M n →ₗ[K] Abelian.Ext P M' q, ∀ x, f x = x.comp y h := by
    intro M M' n m q y h
    refine ⟨{ toFun := fun x => x.comp y h
              map_add' := fun x x' => Abelian.Ext.add_comp _ _ _ _
              map_smul' := fun c x => ?_ }, fun x => rfl⟩
    show ((Abelian.Ext.mk₀ (γ c)).comp x (zero_add n)).comp y h =
      (Abelian.Ext.mk₀ (γ c)).comp (x.comp y h) (zero_add q)
    exact Abelian.Ext.comp_assoc _ _ _ (zero_add n) h (by omega)

  have LA : ∀ (MZ MB M1 M2 : D) (nZ nB n1 n2 : ℕ)
      (β : Abelian.Ext P MB nB →ₗ[K] Abelian.Ext P MZ nZ)
      (θ : Abelian.Ext P MZ nZ →ₗ[K] Abelian.Ext P M1 n1)
      (ξ : Abelian.Ext P MB nB →ₗ[K] Abelian.Ext P M2 n2)
      (N : Submodule K (Abelian.Ext P MZ nZ)),
      FiniteDimensional K (Abelian.Ext P M1 n1) → FiniteDimensional K (Abelian.Ext P M2 n2) →
      (∀ z, θ z = 0 → ∃ y, β y = z) → (∀ y, ξ y = 0 → β y ∈ N) →
      FiniteDimensional K (Abelian.Ext P MZ nZ ⧸ N) ∧
        Module.finrank K (Abelian.Ext P MZ nZ ⧸ N) ≤
          Module.finrank K (Abelian.Ext P M1 n1) + Module.finrank K (Abelian.Ext P M2 n2) := by
    intro MZ MB M1 M2 nZ nB n1 n2 β θ ξ N hW1 hW2 hθ hξ
    haveI := hW1
    haveI := hW2
    have hker1 : LinearMap.ker ξ ≤ LinearMap.ker (N.mkQ ∘ₗ β) := by
      intro y hy
      rw [LinearMap.mem_ker] at hy ⊢
      exact (Submodule.Quotient.mk_eq_zero N).mpr (hξ y hy)
    obtain ⟨g', hg'⟩ : ∃ g' : (Abelian.Ext P MB nB ⧸ LinearMap.ker ξ) →ₗ[K] (Abelian.Ext P MZ nZ ⧸ N),
        ∀ y, g' (Submodule.Quotient.mk y) = N.mkQ (β y) :=
      ⟨(LinearMap.ker ξ).liftQ _ hker1, fun y => rfl⟩
    haveI : FiniteDimensional K (Abelian.Ext P MB nB ⧸ LinearMap.ker ξ) :=
      LinearEquiv.finiteDimensional ξ.quotKerEquivRange.symm
    have hU : Module.finrank K (LinearMap.range g') ≤ Module.finrank K (Abelian.Ext P M2 n2) :=
      (LinearMap.finrank_range_le g').trans
        (ξ.quotKerEquivRange.finrank_eq.trans_le (Submodule.finrank_le _))
    have hker2 : LinearMap.ker θ ≤ LinearMap.ker ((LinearMap.range g').mkQ ∘ₗ N.mkQ) := by
      intro z hz
      rw [LinearMap.mem_ker] at hz ⊢
      obtain ⟨y, rfl⟩ := hθ z hz
      show (LinearMap.range g').mkQ (N.mkQ (β y)) = 0
      rw [← hg']
      exact (Submodule.Quotient.mk_eq_zero _).mpr (LinearMap.mem_range_self g' _)
    obtain ⟨q', hq'⟩ : ∃ q' : (Abelian.Ext P MZ nZ ⧸ LinearMap.ker θ) →ₗ[K]
        ((Abelian.Ext P MZ nZ ⧸ N) ⧸ LinearMap.range g'),
        ∀ z, q' (Submodule.Quotient.mk z) = (LinearMap.range g').mkQ (N.mkQ z) :=
      ⟨(LinearMap.ker θ).liftQ _ hker2, fun z => rfl⟩
    have hq'surj : Function.Surjective q' := by
      intro w
      obtain ⟨v, rfl⟩ := Submodule.mkQ_surjective _ w
      obtain ⟨z, rfl⟩ := Submodule.mkQ_surjective N v
      exact ⟨Submodule.Quotient.mk z, hq' z⟩
    haveI : FiniteDimensional K (Abelian.Ext P MZ nZ ⧸ LinearMap.ker θ) :=
      LinearEquiv.finiteDimensional θ.quotKerEquivRange.symm
    haveI hQfd : FiniteDimensional K ((Abelian.Ext P MZ nZ ⧸ N) ⧸ LinearMap.range g') :=
      Module.Finite.of_surjective q' hq'surj
    have hQ : Module.finrank K ((Abelian.Ext P MZ nZ ⧸ N) ⧸ LinearMap.range g') ≤
        Module.finrank K (Abelian.Ext P M1 n1) := by
      have h := LinearMap.finrank_range_le q'
      rw [LinearMap.range_eq_top.mpr hq'surj, finrank_top] at h
      exact h.trans (θ.quotKerEquivRange.finrank_eq.trans_le (Submodule.finrank_le _))
    haveI hVfd : FiniteDimensional K (Abelian.Ext P MZ nZ ⧸ N) := by
      have hfg1 : (Submodule.map (LinearMap.range g').mkQ ⊤).FG := by
        rw [Submodule.map_top, Submodule.range_mkQ]
        exact Module.finite_def.mp hQfd
      have hfg2 : (⊤ ⊓ LinearMap.ker (LinearMap.range g').mkQ).FG := by
        rw [top_inf_eq, Submodule.ker_mkQ]
        exact Module.Finite.iff_fg.mp inferInstance
      exact Module.finite_def.mpr (Submodule.fg_of_fg_map_of_fg_inf_ker _ hfg1 hfg2)
    refine ⟨hVfd, ?_⟩
    have := Submodule.finrank_quotient_add_finrank (LinearMap.range g')
    omega

  have s1 : ∀ (Q : CochainComplex D ℕ) (j : ℕ), ∃ (B : D) (u : Q.X j ⟶ B)
      (v : B ⟶ Q.cycles (j + 1)) (h1 : Q.iCycles j ≫ u = 0) (h2 : v ≫ Q.homologyπ (j + 1) = 0),
      (ShortComplex.mk _ _ h1).ShortExact ∧ (ShortComplex.mk _ _ h2).ShortExact ∧
        u ≫ v ≫ Q.iCycles (j + 1) = Q.d j (j + 1) := by
    intro Q j
    have hv : Limits.image.ι (Q.d j (j + 1)) ≫ Q.d (j + 1) (j + 1 + 1) = 0 := by
      rw [← cancel_epi (Limits.factorThruImage (Q.d j (j + 1))), Limits.image.fac_assoc,
        Q.d_comp_d, Limits.comp_zero]
    let v := Q.liftCycles (Limits.image.ι (Q.d j (j + 1))) (j + 1 + 1)
      (CochainComplex.next ℕ (j + 1)) hv
    have hvi : v ≫ Q.iCycles (j + 1) = Limits.image.ι (Q.d j (j + 1)) :=
      Q.liftCycles_i _ _ _ _
    have huv : Limits.factorThruImage (Q.d j (j + 1)) ≫ v = Q.toCycles j (j + 1) := by
      rw [← cancel_mono (Q.iCycles (j + 1)), Category.assoc, hvi, Limits.image.fac,
        Q.toCycles_i]
    have h1 : Q.iCycles j ≫ Limits.factorThruImage (Q.d j (j + 1)) = 0 := by
      rw [← cancel_mono (Limits.image.ι (Q.d j (j + 1))), Category.assoc, Limits.image.fac,
        Limits.zero_comp]
      exact Q.iCycles_d j (j + 1)
    have h2 : v ≫ Q.homologyπ (j + 1) = 0 := by
      rw [← cancel_epi (Limits.factorThruImage (Q.d j (j + 1))), ← Category.assoc, huv,
        Limits.comp_zero]
      exact Q.toCycles_comp_homologyπ j (j + 1)
    haveI : Mono v := mono_of_mono_fac hvi
    refine ⟨Limits.image (Q.d j (j + 1)), Limits.factorThruImage (Q.d j (j + 1)), v, h1, h2,
      ?_, ?_, ?_⟩
    · refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _
        (Limits.KernelFork.IsLimit.ofι _ _
          (fun g' hg' => Q.liftCycles g' (j + 1) (CochainComplex.next ℕ j) (by
            rw [← Limits.image.fac (Q.d j (j + 1)), ← Category.assoc,
              show g' ≫ Limits.factorThruImage (Q.d j (j + 1)) = 0 from hg', Limits.zero_comp]))
          (fun g' hg' => Q.liftCycles_i _ _ _ _)
          (fun g' hg' m hm => by
            rw [← cancel_mono (Q.iCycles j), Q.liftCycles_i]
            exact hm))) inferInstance inferInstance
    · have hprev : (ComplexShape.up ℕ).prev (j + 1) = j := by simp
      refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_g_is_cokernel _
        (Limits.CokernelCofork.IsColimit.ofπ _ _
          (fun g' hg' => (Limits.CokernelCofork.IsColimit.desc'
            (Q.homologyIsCokernel j (j + 1) hprev) g' (by
              rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).1)
          (fun g' hg' => (Limits.CokernelCofork.IsColimit.desc'
            (Q.homologyIsCokernel j (j + 1) hprev) g' (by
              rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).2)
          (fun g' hg' m hm => by
            rw [← cancel_epi (Q.homologyπ (j + 1))]
            exact hm.trans (Limits.CokernelCofork.IsColimit.desc'
              (Q.homologyIsCokernel j (j + 1) hprev) g' (by
                rw [← huv, Category.assoc, show v ≫ g' = 0 from hg', Limits.comp_zero])).2.symm)))
        inferInstance inferInstance
    · rw [hvi, Limits.image.fac]

  have claim : ∀ (Kc : CochainComplex D ℕ), (∀ j, Injective (Kc.X j)) →
      (∀ p q : ℕ, p + q = k → FiniteDimensional K (Abelian.Ext P (Kc.homology q) p) ∧
        Module.finrank K (Abelian.Ext P (Kc.homology q) p) ≤ b p) →
      ∀ (N : Submodule K (Abelian.Ext P (Kc.cycles k) 0)),
      (∀ p : ℕ, p + 1 = k → ∀ (x : Abelian.Ext P (Kc.cycles k) 0) (e : P ⟶ Kc.X p),
        Abelian.Ext.homEquiv₀ x ≫ Kc.iCycles k = e ≫ Kc.d p k → x ∈ N) →
      FiniteDimensional K (Abelian.Ext P (Kc.cycles k) 0 ⧸ N) ∧
        Module.finrank K (Abelian.Ext P (Kc.cycles k) 0 ⧸ N) ≤ ∑ p ∈ Finset.range (k + 1), b p := by
    intro Kc hinj hH N hN
    choose Bo u v hh1 hh2 hS1 hS2 hfac using s1 Kc
    have hiso0 : IsIso (Kc.homologyπ 0) :=
      Kc.isIso_homologyπ 0 0 CochainComplex.prev_nat_zero (Kc.shape 0 0 (by simp))

    have hA : ∀ j i : ℕ, (1 ≤ i ∨ j = 0) → i + j = k →
        FiniteDimensional K (Abelian.Ext P (Kc.cycles j) i) ∧
          Module.finrank K (Abelian.Ext P (Kc.cycles j) i) ≤
            ∑ t ∈ Finset.range (j + 1), b (i + t) := by
      intro j
      induction j with
      | zero =>
        intro i _ hik
        have hHi := hH i 0 (by omega)
        haveI := hHi.1
        obtain ⟨f, hf⟩ := postL (M := Kc.cycles 0) (M' := Kc.homology 0) (n := i)
          (Abelian.Ext.mk₀ (Kc.homologyπ 0)) (add_zero i)
        have hl : ∀ z : Abelian.Ext P (Kc.cycles 0) i,
            (z.comp (Abelian.Ext.mk₀ (Kc.homologyπ 0)) (add_zero _)).comp
              (Abelian.Ext.mk₀ (inv (Kc.homologyπ 0))) (add_zero _) = z := by
          intro z
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
        have hfinj : Function.Injective f := by
          intro x y hxy
          rw [hf, hf] at hxy
          rw [← hl x, ← hl y, hxy]
        refine ⟨FiniteDimensional.of_injective f hfinj, ?_⟩
        calc Module.finrank K (Abelian.Ext P (Kc.cycles 0) i)
            ≤ Module.finrank K (Abelian.Ext P (Kc.homology 0) i) :=
              LinearMap.finrank_le_finrank_of_injective hfinj
          _ ≤ b i := hHi.2
          _ = ∑ t ∈ Finset.range (0 + 1), b (i + t) := by simp
      | succ j ih =>
        intro i hi hik
        obtain ⟨i', rfl⟩ : ∃ i', i = i' + 1 := ⟨i - 1, by omega⟩
        haveI : Injective (ShortComplex.mk _ _ (hh1 j)).X₂ := hinj j
        have ihr := ih (i' + 1 + 1) (Or.inl (by omega)) (by omega)
        have hHr := hH (i' + 1) (j + 1) (by omega)
        obtain ⟨β, hβ⟩ := postL (M := Bo j) (M' := Kc.cycles (j + 1)) (n := i' + 1)
          (Abelian.Ext.mk₀ (v j)) (add_zero (i' + 1))
        obtain ⟨θ, hθ⟩ := postL (M := Kc.cycles (j + 1)) (M' := Kc.homology (j + 1)) (n := i' + 1)
          (Abelian.Ext.mk₀ (Kc.homologyπ (j + 1))) (add_zero (i' + 1))
        obtain ⟨ξ, hξ⟩ := postL (M := Bo j) (M' := Kc.cycles j) (n := i' + 1)
          (hS1 j).extClass (rfl : i' + 1 + 1 = i' + 1 + 1)
        have hLA := LA _ _ _ _ _ _ _ _ β θ ξ ⊥ hHr.1 ihr.1
          (fun z hz => by
            rw [hθ] at hz
            obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₂ P (hS2 j) z hz
            exact ⟨y, by rw [hβ]; exact hy⟩)
          (fun y hy => by
            rw [hξ] at hy
            obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P (hS1 j) y rfl hy
            rw [← hx₂, Abelian.Ext.eq_zero_of_injective x₂, Abelian.Ext.zero_comp, map_zero]
            exact Submodule.zero_mem _)
        have e0 := Submodule.quotEquivOfEqBot
          (⊥ : Submodule K (Abelian.Ext P (Kc.cycles (j + 1)) (i' + 1))) rfl
        haveI := hLA.1
        refine ⟨LinearEquiv.finiteDimensional e0, ?_⟩
        have h := Finset.sum_range_succ' (fun t => b (i' + 1 + t)) (j + 1)
        simp only [add_zero] at h
        have h2 : ∑ t ∈ Finset.range (j + 1), b (i' + 1 + (t + 1)) =
            ∑ t ∈ Finset.range (j + 1), b (i' + 1 + 1 + t) :=
          Finset.sum_congr rfl (fun t _ => by rw [show i' + 1 + (t + 1) = i' + 1 + 1 + t by omega])
        rw [← e0.finrank_eq]
        have := hLA.2
        have := hHr.2
        have := ihr.2
        omega
    cases k with
    | zero =>
      have h0 := hA 0 0 (Or.inr rfl) (by omega)
      haveI := h0.1
      refine ⟨inferInstance, ?_⟩
      calc Module.finrank K (Abelian.Ext P (Kc.cycles 0) 0 ⧸ N)
          ≤ Module.finrank K (Abelian.Ext P (Kc.cycles 0) 0) := Submodule.finrank_quotient_le N
        _ ≤ ∑ t ∈ Finset.range (0 + 1), b (0 + t) := h0.2
        _ = ∑ p ∈ Finset.range (0 + 1), b p := by simp
    | succ p =>
      have hW1 := hH 0 (p + 1) (by omega)
      have hW2 := hA p 1 (Or.inl le_rfl) (by omega)
      obtain ⟨β, hβ⟩ := postL (M := Bo p) (M' := Kc.cycles (p + 1)) (n := 0)
        (Abelian.Ext.mk₀ (v p)) (add_zero 0)
      obtain ⟨θ, hθ⟩ := postL (M := Kc.cycles (p + 1)) (M' := Kc.homology (p + 1)) (n := 0)
        (Abelian.Ext.mk₀ (Kc.homologyπ (p + 1))) (add_zero 0)
      obtain ⟨ξ, hξ⟩ := postL (M := Bo p) (M' := Kc.cycles p) (n := 0)
        (hS1 p).extClass (zero_add 1)
      have hLA := LA _ _ _ _ _ _ _ _ β θ ξ N hW1.1 hW2.1
        (fun z hz => by
          rw [hθ] at hz
          obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₂ P (hS2 p) z hz
          exact ⟨y, by rw [hβ]; exact hy⟩)
        (fun y hy => by
          rw [hξ] at hy
          obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P (hS1 p) y (zero_add 1) hy
          have hy' : y = Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ x₂ ≫ u p) := by
            rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
            exact hx₂.symm
          apply hN p rfl (β y) (Abelian.Ext.homEquiv₀ x₂)
          rw [hβ, hy', Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.homEquiv₀_symm_apply,
            Equiv.apply_symm_apply, Category.assoc, Category.assoc, hfac p])
      refine ⟨hLA.1, ?_⟩
      have h := Finset.sum_range_succ' b (p + 1)
      have h2 : ∑ t ∈ Finset.range (p + 1), b (1 + t) = ∑ t ∈ Finset.range (p + 1), b (t + 1) :=
        Finset.sum_congr rfl (fun t _ => by rw [add_comm])
      have := hLA.2
      have := hW1.2
      have := hW2.2
      omega

  have hinj : ∀ j, Injective (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj
      I.cocomplex).X j) := fun j => by
    haveI := I.injective j
    exact Injective.injective_of_adjoint adj (I.cocomplex.X j)
  have hH : ∀ p q : ℕ, p + q = k →
      FiniteDimensional K (Abelian.Ext P
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) p) ∧
      Module.finrank K (Abelian.Ext P
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) p) ≤ b p := by
    intro p q hpq
    obtain rfl : q = k - p := by omega
    obtain ⟨np, e, he, hnp⟩ := hyp p (by omega)
    let Le := e.toLinearEquiv (fun c x => he c x)
    refine ⟨LinearEquiv.finiteDimensional Le.symm, ?_⟩
    rw [Le.finrank_eq, Module.finrank_fin_fun]
    exact hnp
  have hφ0 : ∀ j, (adj.homEquiv P (I.cocomplex.X j)) 0 = 0 := fun j => by
    rw [Adjunction.homEquiv_unit, Functor.map_zero, Limits.comp_zero]
  have hφs0 : ∀ j, (adj.homEquiv P (I.cocomplex.X j)).symm 0 = 0 := fun j => by
    rw [Equiv.symm_apply_eq, hφ0]
  have hΦadd : ∀ j (f g : P ⟶ R.obj (I.cocomplex.X j)),
      (adj.homEquiv P _).symm (f + g) =
        (adj.homEquiv P _).symm f + (adj.homEquiv P _).symm g := fun j f g => by
    simp only [Adjunction.homEquiv_counit, Functor.map_add, Preadditive.add_comp]
  have hextc : ∀ (f g : L.obj P ⟶ I.cocomplex.X k) (hf : f ≫ I.cocomplex.d k (k + 1) = 0)
      (hg : g ≫ I.cocomplex.d k (k + 1) = 0), f = g →
      I.extMk f (k + 1) rfl hf = I.extMk g (k + 1) rfl hg := by
    rintro f g hf hg rfl
    rfl
  have hd : ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles k ≫
      R.map (I.cocomplex.d k (k + 1)) = 0 :=
    ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles_d k (k + 1)
  have hfx : ∀ x : Abelian.Ext P
      (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).cycles k) 0,
      (adj.homEquiv P (I.cocomplex.X k)).symm (Abelian.Ext.homEquiv₀ x ≫
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles k) ≫
          I.cocomplex.d k (k + 1) = 0 := by
    intro x
    rw [← adj.homEquiv_naturality_right_symm, Category.assoc, hd, Limits.comp_zero, hφs0]
  have hhe_add : ∀ {M : D} (x y : Abelian.Ext P M 0),
      Abelian.Ext.homEquiv₀ (x + y) = Abelian.Ext.homEquiv₀ x + Abelian.Ext.homEquiv₀ y := by
    intro M x y
    apply Abelian.Ext.homEquiv₀.symm.injective
    rw [Equiv.symm_apply_apply, Abelian.Ext.homEquiv₀_symm_apply, Abelian.Ext.mk₀_add,
      Abelian.Ext.mk₀_homEquiv₀_apply, Abelian.Ext.mk₀_homEquiv₀_apply]
  have hhe_smul : ∀ {M : D} (c : K) (x : Abelian.Ext P M 0),
      Abelian.Ext.homEquiv₀ (c • x) = γ c ≫ Abelian.Ext.homEquiv₀ x := by
    intro M c x
    show Abelian.Ext.homEquiv₀ ((Abelian.Ext.mk₀ (γ c)).comp x (zero_add 0)) =
      γ c ≫ Abelian.Ext.homEquiv₀ x
    apply Abelian.Ext.homEquiv₀.symm.injective
    rw [Equiv.symm_apply_apply, Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_homEquiv₀_apply]
  obtain ⟨ε, hε⟩ : ∃ ε : Abelian.Ext P
      (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).cycles k) 0 →ₗ[K]
        Abelian.Ext (L.obj P) A k,
      ∀ x, ε x = I.extMk ((adj.homEquiv P (I.cocomplex.X k)).symm (Abelian.Ext.homEquiv₀ x ≫
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles k))
          (k + 1) rfl (hfx x) := by
    refine ⟨{ toFun := fun x => I.extMk _ (k + 1) rfl (hfx x)
              map_add' := fun x y => ?_
              map_smul' := fun c x => ?_ }, fun x => rfl⟩
    · rw [I.add_extMk]
      apply hextc
      rw [hhe_add, Preadditive.add_comp, hΦadd]
    · rw [RingHom.id_apply]
      show _ = (Abelian.Ext.mk₀ (L.map (γ c))).comp (I.extMk _ (k + 1) rfl (hfx x)) (zero_add k)
      rw [I.mk₀_comp_extMk]
      apply hextc
      rw [hhe_smul, Category.assoc, adj.homEquiv_naturality_left_symm]
  have hsurj : Function.Surjective ε := by
    intro α
    obtain ⟨f, hf, rfl⟩ := I.extMk_surjective α (k + 1) rfl
    have hc : adj.homEquiv P _ f ≫ R.map (I.cocomplex.d k (k + 1)) = 0 := by
      rw [← adj.homEquiv_naturality_right, hf, hφ0]
    refine ⟨Abelian.Ext.mk₀ (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj
      I.cocomplex).liftCycles (adj.homEquiv P _ f) (k + 1) (CochainComplex.next ℕ k) hc), ?_⟩
    rw [hε]
    apply hextc
    rw [← Abelian.Ext.homEquiv₀_symm_apply, Equiv.apply_symm_apply,
      HomologicalComplex.liftCycles_i, Equiv.symm_apply_apply]
  have hkerε : ∀ p : ℕ, p + 1 = k → ∀ (x : Abelian.Ext P
      (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).cycles k) 0)
      (e : P ⟶ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).X p),
      Abelian.Ext.homEquiv₀ x ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles k =
        e ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).d p k → ε x = 0 := by
    intro p hp x e h
    rw [hε, I.extMk_eq_zero_iff _ _ _ _ p hp]
    refine ⟨(adj.homEquiv P (I.cocomplex.X p)).symm e, ?_⟩
    rw [← adj.homEquiv_naturality_right_symm]
    exact congrArg (adj.homEquiv P (I.cocomplex.X k)).symm h.symm

  have hc := claim _ hinj hH (LinearMap.ker ε)
    (fun p hp x e h => LinearMap.mem_ker.mpr (hkerε p hp x e h))
  haveI := hc.1
  let Eq' := ε.quotKerEquivOfSurjective hsurj
  haveI : FiniteDimensional K (Abelian.Ext (L.obj P) A k) := LinearEquiv.finiteDimensional Eq'
  refine ⟨Module.finrank K (Abelian.Ext (L.obj P) A k),
    (Module.finBasis K (Abelian.Ext (L.obj P) A k)).equivFun.toAddEquiv, fun c x => ?_, ?_⟩
  · exact (Module.finBasis K (Abelian.Ext (L.obj P) A k)).equivFun.map_smul c x
  · rw [← Eq'.finrank_eq]
    exact hc.2

theorem sheafOfModules_split_of_local_basis {C : Type (u+1)} [Category.{u} C]
    {J : GrothendieckTopology C}
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R : Sheaf J RingCat.{u+1}) (M : SheafOfModules.{u+1} R) (m : ℕ)
    (ι : Fin m → (SheafOfModules.unit R ⟶ M))
    (hinj : ∀ (W : C) (c : Fin m → R.obj.obj (Opposite.op W)),
        ∑ a, ((ι a).val.app (Opposite.op W)).hom (c a) = 0 → c = 0)
    (hloc : ∀ (W : C) (s : M.val.obj (Opposite.op W)),
        Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∃ c : Fin m → R.obj.obj (Opposite.op W'),
          (M.val.map g.op).hom s = ∑ a, ((ι a).val.app (Opposite.op W')).hom (c a)) ∈ J W) :
    ∃ ρ : Fin m → (M ⟶ SheafOfModules.unit R),
      (∀ a b : Fin m, ι a ≫ ρ b = if a = b then 𝟙 _ else 0) ∧ ∑ a, ρ a ≫ ι a = 𝟙 M :=
by
  classical

  have hE_comp : ∀ {A B D : SheafOfModules.{u+1} R} (f : A ⟶ B) (g : B ⟶ D) (X : Cᵒᵖ)
      (x : A.val.obj X), ((f ≫ g).val.app X).hom x = (g.val.app X).hom ((f.val.app X).hom x) :=
    fun _ _ _ _ => rfl
  have hE_zero : ∀ {A B : SheafOfModules.{u+1} R} (X : Cᵒᵖ) (x : A.val.obj X),
      ((0 : A ⟶ B).val.app X).hom x = 0 := by
    intro A B X x
    have h1 := (SheafOfModules.forget R ⋙ PresheafOfModules.evaluation R.obj X).map_zero A B
    have h2 : ((SheafOfModules.forget R ⋙ PresheafOfModules.evaluation R.obj X).map
        (0 : A ⟶ B)).hom x = ((0 : (SheafOfModules.forget R ⋙
          PresheafOfModules.evaluation R.obj X).obj A ⟶ _)).hom x := by rw [h1]
    exact h2
  have hE_sum : ∀ {A B : SheafOfModules.{u+1} R} (f : Fin m → (A ⟶ B)) (X : Cᵒᵖ)
      (x : A.val.obj X), ((∑ a, f a).val.app X).hom x = ∑ a, ((f a).val.app X).hom x := by
    intro A B f X x
    have h1 := (SheafOfModules.forget R ⋙ PresheafOfModules.evaluation R.obj X).map_sum f
      Finset.univ
    have h2 : ((SheafOfModules.forget R ⋙ PresheafOfModules.evaluation R.obj X).map
        (∑ a, f a)).hom x = (∑ a, (SheafOfModules.forget R ⋙
          PresheafOfModules.evaluation R.obj X).map (f a)).hom x := by rw [h1]
    rw [ModuleCat.hom_sum] at h2
    refine h2.trans ?_
    exact LinearMap.sum_apply _ _ _

  have s2 : ∀ (N : SheafOfModules.{u+1} R) (h : M ⟶ N), (∀ a, ι a ≫ h = 0) → h = 0 := by
    intro N h hh
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    obtain ⟨W⟩ := X
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro s
    rw [hE_zero]
    have hsep := Sheaf.isSeparated (⟨N.val.presheaf, N.isSheaf⟩ : Sheaf J AddCommGrpCat.{u+1})
    refine hsep W _ (hloc W s) ((h.val.app (Opposite.op W)).hom s) 0 ?_
    rintro Y f ⟨W', k, g, ⟨c, hc⟩, rfl⟩
    have e2 : (M.val.map (k ≫ g).op).hom s = (M.val.map k.op).hom ((M.val.map g.op).hom s) := by
      rw [op_comp, PresheafOfModules.map_comp]
      rfl
    have e3 : (h.val.app (Opposite.op W')).hom ((M.val.map g.op).hom s) = 0 := by
      rw [hc, map_sum]
      refine Finset.sum_eq_zero (fun a _ => ?_)
      have hz := hE_zero (A := SheafOfModules.unit R) (B := N) (Opposite.op W') (c a)
      exact (hE_comp (ι a) h _ (c a)).symm.trans (by rw [hh a]; exact hz)
    have e4 : (h.val.app (Opposite.op Y)).hom ((M.val.map (k ≫ g).op).hom s) = 0 := by
      rw [e2]
      exact (PresheafOfModules.naturality_apply h.val k.op _).trans
        ((congrArg (N.val.map k.op).hom e3).trans (map_zero _))
    change (N.val.map (k ≫ g).op).hom ((h.val.app _).hom s) = (N.val.map (k ≫ g).op).hom 0
    exact ((PresheafOfModules.naturality_apply h.val (k ≫ g).op s).symm.trans e4).trans
      (map_zero _).symm

  have s3 : ∀ (N : SheafOfModules.{u+1} R) (g : Fin m → (N ⟶ SheafOfModules.unit R)),
      ∑ a, g a ≫ ι a = 0 → ∀ a, g a = 0 := by
    intro N g hg a
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    obtain ⟨W⟩ := X
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro n
    rw [hE_zero]
    have hsum : ((∑ b, g b ≫ ι b).val.app (Opposite.op W)).hom n =
        ∑ b, ((g b ≫ ι b).val.app (Opposite.op W)).hom n := hE_sum (fun b => g b ≫ ι b) _ n
    rw [hg, hE_zero] at hsum
    have hc := hinj W (fun b => ((g b).val.app (Opposite.op W)).hom n) hsum.symm
    exact congrFun hc a

  letI : Limits.HasFiniteBiproducts (SheafOfModules.{u+1} R) :=
    Limits.HasFiniteBiproducts.of_hasFiniteProducts
  obtain ⟨Φ, hΦ1, hΦ2⟩ : ∃ Φ : Limits.biproduct (fun _ : Fin m => SheafOfModules.unit R) ⟶ M,
      (∀ a, Limits.biproduct.ι _ a ≫ Φ = ι a) ∧
        Φ = ∑ a, Limits.biproduct.π _ a ≫ ι a :=
    ⟨Limits.biproduct.desc ι, fun a => Limits.biproduct.ι_desc ι a, Limits.biproduct.desc_eq⟩
  haveI : Epi Φ := Preadditive.epi_of_cancel_zero Φ (fun {N} h hh => s2 N h (fun a => by
    rw [← hΦ1 a, Category.assoc, hh, Limits.comp_zero]))
  haveI : Mono Φ := Preadditive.mono_of_cancel_zero Φ (fun {N} g hg => by
    have h1 : ∑ a, (g ≫ Limits.biproduct.π _ a) ≫ ι a = 0 := by
      simp only [Category.assoc]
      rw [← Preadditive.comp_sum, ← hΦ2, hg]
    have h2 := s3 N (fun a => g ≫ Limits.biproduct.π _ a) h1
    apply Limits.biproduct.hom_ext
    intro a
    rw [Limits.zero_comp]
    exact h2 a)
  haveI : IsIso Φ := isIso_of_mono_of_epi Φ
  refine ⟨fun b => inv Φ ≫ Limits.biproduct.π _ b, ?_, ?_⟩
  · intro a b
    rw [← hΦ1 a, Category.assoc, IsIso.hom_inv_id_assoc]
    split_ifs with hab
    · subst hab
      exact Limits.biproduct.ι_π_self _ _
    · exact Limits.biproduct.ι_π_ne _ hab
  · simp only [Category.assoc]
    rw [← Preadditive.comp_sum, ← hΦ2, IsIso.inv_hom_id]

theorem wcwl_germ : ∀ (A : Type u) [CommRing A] (b : wcwlRing A) (x : PrimeSpectrum A), ∃ (a s : A) (ε : wcwlRing A), s ∉ x.asIdeal ∧ ε * ε = ε ∧ (∀ Q : Ideal (wcwlRing A), Q.IsPrime → wcwlI A ≤ Q → Ideal.comap (algebraMap A (wcwlRing A)) Q = x.asIdeal → ε ∉ Q) ∧ algebraMap A (wcwlRing A) s * ε * b = ε * algebraMap A (wcwlRing A) a :=
by
  intro A _ b x
  classical
  have hext : ∀ b b' : wcwlRing A, (∀ y, wcwlEv A y b = wcwlEv A y b') → b = b' :=
    fun b b' h => Subtype.ext (funext h)
  have hev_alg : ∀ (y : PrimeSpectrum A) (a : A),
      wcwlEv A y (algebraMap A (wcwlRing A) a) = algebraMap A (Localization.AtPrime y.asIdeal) a :=
    fun y a => rfl
  obtain ⟨D, hD, hDval⟩ : ∃ D : A → wcwlRing A, (∀ (c : A) (y : PrimeSpectrum A),
      wcwlEv A y (D c) = wcwlDelta A c y) ∧ ∀ c : A,
      (D c : ∀ y : PrimeSpectrum A, Localization.AtPrime y.asIdeal) = wcwlDelta A c :=
    ⟨fun c => ⟨wcwlDelta A c, Algebra.subset_adjoin (Set.mem_range_self c)⟩,
      fun _ _ => rfl, fun _ => rfl⟩
  obtain ⟨E, hE⟩ : ∃ E : A → wcwlRing A, ∀ c : A, E c = algebraMap A (wcwlRing A) c * D c :=
    ⟨_, fun _ => rfl⟩
  have hunitA : ∀ (c : A) (y : PrimeSpectrum A),
      IsUnit (algebraMap A (Localization.AtPrime y.asIdeal) c) ↔ c ∉ y.asIdeal := fun c y =>
    (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime y.asIdeal) y.asIdeal c).trans
      Iff.rfl
  have hδ1 : ∀ (c : A) (y : PrimeSpectrum A), c ∉ y.asIdeal →
      algebraMap A (Localization.AtPrime y.asIdeal) c * wcwlDelta A c y = 1 := fun c y h =>
    Ring.mul_inverse_cancel _ ((hunitA c y).2 h)
  have hδ0 : ∀ (c : A) (y : PrimeSpectrum A), c ∈ y.asIdeal → wcwlDelta A c y = 0 := fun c y h =>
    Ring.inverse_non_unit _ (fun h' => (hunitA c y).1 h' h)
  have he1 : ∀ (c : A) (y : PrimeSpectrum A), c ∉ y.asIdeal → wcwlEv A y (E c) = 1 := by
    intro c y h
    rw [hE, map_mul, hev_alg, hD]
    exact hδ1 c y h
  have he0 : ∀ (c : A) (y : PrimeSpectrum A), c ∈ y.asIdeal → wcwlEv A y (E c) = 0 := by
    intro c y h
    rw [hE, map_mul, hev_alg, hD, hδ0 c y h, mul_zero]
  have hidem : ∀ c : A, E c * E c = E c := by
    intro c
    apply hext
    intro y
    rw [map_mul]
    by_cases hcy : c ∈ y.asIdeal
    · rw [he0 c y hcy, mul_zero]
    · rw [he1 c y hcy, mul_one]
  have hmemI : ∀ i : wcwlRing A, i ∈ wcwlI A ↔ ∀ y, i ∈ wcwlZ A y := by
    intro i
    unfold wcwlI
    exact Ideal.mem_iInf
  have hone : (1 : A) ∉ x.asIdeal := (Ideal.ne_top_iff_one _).1 x.isPrime.ne_top
  have hQone : ∀ Q : Ideal (wcwlRing A), Q.IsPrime → (1 : wcwlRing A) ∉ Q := fun Q hQ =>
    (Ideal.ne_top_iff_one _).1 hQ.ne_top

  let P : wcwlRing A → Prop := fun β => ∃ (a s : A) (ε : wcwlRing A), s ∉ x.asIdeal ∧ ε * ε = ε ∧
    (∀ Q : Ideal (wcwlRing A), Q.IsPrime → wcwlI A ≤ Q →
      Ideal.comap (algebraMap A (wcwlRing A)) Q = x.asIdeal → ε ∉ Q) ∧
    algebraMap A (wcwlRing A) s * ε * β = ε * algebraMap A (wcwlRing A) a

  have hgen : ∀ c : A, P (D c) := by
    intro c
    by_cases hc : c ∈ x.asIdeal
    · refine ⟨0, 1, 1 - E c, hone, ?_, ?_, ?_⟩
      · have h := hidem c
        linear_combination h
      · intro Q hQ _ hcomap hmem
        have hcQ : algebraMap A (wcwlRing A) c ∈ Q := by
          rw [← hcomap] at hc
          exact Ideal.mem_comap.1 hc
        have heQ : E c ∈ Q := by
          rw [hE]
          exact Q.mul_mem_right _ hcQ
        apply hQone Q hQ
        have h1 := Q.add_mem hmem heQ
        rwa [sub_add_cancel] at h1
      · apply hext
        intro y
        simp only [map_mul, map_sub, map_one, map_zero, mul_zero, one_mul]
        by_cases hcy : c ∈ y.asIdeal
        · rw [hD, hδ0 c y hcy, mul_zero]
        · rw [he1 c y hcy, sub_self, zero_mul]
    · refine ⟨1, c, E c, hc, hidem c, ?_, ?_⟩
      · intro Q hQ hIQ hcomap heQ
        have hw : algebraMap A (wcwlRing A) c * (1 - E c) ∈ wcwlI A := by
          rw [hmemI]
          intro y
          show wcwlEv A y _ ∈ IsLocalRing.maximalIdeal (Localization.AtPrime y.asIdeal)
          rw [map_mul, map_sub, map_one, hev_alg]
          by_cases hcy : c ∈ y.asIdeal
          · rw [he0 c y hcy, sub_zero, mul_one]
            exact (IsLocalization.AtPrime.to_map_mem_maximal_iff
              (Localization.AtPrime y.asIdeal) y.asIdeal c).2 hcy
          · rw [he1 c y hcy, sub_self, mul_zero]
            exact Ideal.zero_mem _
        rcases hQ.mem_or_mem (hIQ hw) with h | h
        · apply hc
          rw [← hcomap]
          exact Ideal.mem_comap.2 h
        · apply hQone Q hQ
          have h1 := Q.add_mem h heQ
          rwa [sub_add_cancel] at h1
      · apply hext
        intro y
        rw [map_mul, map_mul, map_mul, hev_alg, hD]
        simp only [map_one]
        by_cases hcy : c ∈ y.asIdeal
        · rw [he0 c y hcy]
          ring
        · rw [he1 c y hcy]
          have h := hδ1 c y hcy
          linear_combination h
  have halg : ∀ r : A, P (algebraMap A (wcwlRing A) r) := by
    intro r
    refine ⟨r, 1, 1, hone, mul_one 1, fun Q hQ _ _ h => hQone Q hQ h, ?_⟩
    rw [map_one]
    ring
  have hadd : ∀ β₁ β₂ : wcwlRing A, P β₁ → P β₂ → P (β₁ + β₂) := by
    rintro β₁ β₂ ⟨a₁, s₁, ε₁, hs₁, hε₁, hg₁, H₁⟩ ⟨a₂, s₂, ε₂, hs₂, hε₂, hg₂, H₂⟩
    refine ⟨a₁ * s₂ + a₂ * s₁, s₁ * s₂, ε₁ * ε₂, ?_, ?_, ?_, ?_⟩
    · intro h
      rcases x.isPrime.mem_or_mem h with h | h
      · exact hs₁ h
      · exact hs₂ h
    · linear_combination (ε₂ * ε₂) * hε₁ + ε₁ * hε₂
    · intro Q hQ hI hc h
      rcases hQ.mem_or_mem h with h | h
      · exact hg₁ Q hQ hI hc h
      · exact hg₂ Q hQ hI hc h
    · simp only [map_add, map_mul]
      linear_combination (algebraMap A (wcwlRing A) s₂ * ε₂) * H₁ +
        (algebraMap A (wcwlRing A) s₁ * ε₁) * H₂
  have hmul : ∀ β₁ β₂ : wcwlRing A, P β₁ → P β₂ → P (β₁ * β₂) := by
    rintro β₁ β₂ ⟨a₁, s₁, ε₁, hs₁, hε₁, hg₁, H₁⟩ ⟨a₂, s₂, ε₂, hs₂, hε₂, hg₂, H₂⟩
    refine ⟨a₁ * a₂, s₁ * s₂, ε₁ * ε₂, ?_, ?_, ?_, ?_⟩
    · intro h
      rcases x.isPrime.mem_or_mem h with h | h
      · exact hs₁ h
      · exact hs₂ h
    · linear_combination (ε₂ * ε₂) * hε₁ + ε₁ * hε₂
    · intro Q hQ hI hc h
      rcases hQ.mem_or_mem h with h | h
      · exact hg₁ Q hQ hI hc h
      · exact hg₂ Q hQ hI hc h
    · simp only [map_mul]
      linear_combination (algebraMap A (wcwlRing A) s₂ * ε₂ * β₂) * H₁ +
        (ε₁ * algebraMap A (wcwlRing A) a₁) * H₂
  have key : ∀ (z : ∀ y : PrimeSpectrum A, Localization.AtPrime y.asIdeal)
      (hz : z ∈ Algebra.adjoin A (Set.range (wcwlDelta A))), P ⟨z, hz⟩ := by
    intro z hz
    induction hz using Algebra.adjoin_induction with
    | mem z hz =>
      obtain ⟨c, rfl⟩ := hz
      have hDc : (⟨wcwlDelta A c, Algebra.subset_adjoin (Set.mem_range_self c)⟩ : wcwlRing A) = D c :=
        Subtype.ext (hDval c).symm
      rw [hDc]
      exact hgen c
    | algebraMap r => exact halg r
    | add z₁ z₂ h₁ h₂ ih₁ ih₂ => exact hadd _ _ ih₁ ih₂
    | mul z₁ z₂ h₁ h₂ ih₁ ih₂ => exact hmul _ _ ih₁ ih₂
  exact key b.1 b.2

theorem wcwl_decomp : ∀ (A : Type u) [CommRing A] (b : wcwlRing A), ∃ (n : ℕ) (ε t : Fin n → wcwlRing A) (s a : Fin n → A), (∀ k, ε k * ε k = ε k) ∧ (∀ k l, k ≠ l → ε k * ε l = 0) ∧ ∑ k, ε k = 1 ∧ (∀ k, ε k * algebraMap A (wcwlRing A) (s k) * t k = ε k) ∧ ∀ k, algebraMap A (wcwlRing A) (s k) * ε k * b = ε k * algebraMap A (wcwlRing A) (a k) :=
by
  intro A _ b
  classical
  let P : wcwlRing A → Prop := fun b => ∃ (n : ℕ) (ε t : Fin n → wcwlRing A) (s a : Fin n → A),
    (∀ k, ε k * ε k = ε k) ∧ (∀ k l, k ≠ l → ε k * ε l = 0) ∧ ∑ k, ε k = 1 ∧
    (∀ k, ε k * algebraMap A (wcwlRing A) (s k) * t k = ε k) ∧
    ∀ k, algebraMap A (wcwlRing A) (s k) * ε k * b = ε k * algebraMap A (wcwlRing A) (a k)

  have hgen : ∀ (c : A) (d : wcwlRing A), algebraMap A (wcwlRing A) c * d * d = d → P d := by
    intro c d hK
    have F1 : (algebraMap A (wcwlRing A) c * d) * (algebraMap A (wcwlRing A) c * d) =
        algebraMap A (wcwlRing A) c * d := by
      linear_combination (algebraMap A (wcwlRing A) c) * hK
    refine ⟨2, ![algebraMap A (wcwlRing A) c * d, 1 - algebraMap A (wcwlRing A) c * d], ![d, 1],
      ![c, 1], ![1, 0], ?_, ?_, ?_, ?_, ?_⟩
    · simp only [Fin.forall_fin_two, Matrix.cons_val_zero, Matrix.cons_val_one]
      exact ⟨F1, by linear_combination F1⟩
    · simp only [Fin.forall_fin_two, Matrix.cons_val_zero, Matrix.cons_val_one]
      refine ⟨⟨fun h => absurd rfl h, fun _ => ?_⟩, fun _ => ?_, fun h => absurd rfl h⟩
      · linear_combination (-1 : wcwlRing A) * F1
      · linear_combination (-1 : wcwlRing A) * F1
    · simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one]
      ring
    · simp only [Fin.forall_fin_two, Matrix.cons_val_zero, Matrix.cons_val_one, map_one]
      exact ⟨by linear_combination F1, by ring⟩
    · simp only [Fin.forall_fin_two, Matrix.cons_val_zero, Matrix.cons_val_one, map_one, map_zero]
      exact ⟨by linear_combination (algebraMap A (wcwlRing A) c) * hK,
        by linear_combination (-1 : wcwlRing A) * hK⟩

  have hconst : ∀ r : A, P (algebraMap A (wcwlRing A) r) := by
    intro r
    refine ⟨1, fun _ => 1, fun _ => 1, fun _ => 1, fun _ => r, ?_, ?_, ?_, ?_, ?_⟩
    · intro k; exact mul_one 1
    · intro k l h; exact absurd (Subsingleton.elim k l) h
    · simp
    · intro k; simp
    · intro k; simp

  have hcomb : ∀ b₁ b₂ : wcwlRing A, P b₁ → P b₂ → P (b₁ + b₂) ∧ P (b₁ * b₂) := by
    intro b₁ b₂ h₁ h₂
    obtain ⟨n, ε₁, t₁, s₁, a₁, h1i, h1ii, h1iii, h1iv, h1v⟩ := h₁
    obtain ⟨m, ε₂, t₂, s₂, a₂, h2i, h2ii, h2iii, h2iv, h2v⟩ := h₂
    obtain ⟨e, -⟩ : ∃ e : Fin n × Fin m ≃ Fin (n * m), True := ⟨finProdFinEquiv, trivial⟩
    have Hi : ∀ k : Fin (n * m), (ε₁ (e.symm k).1 * ε₂ (e.symm k).2) *
        (ε₁ (e.symm k).1 * ε₂ (e.symm k).2) = ε₁ (e.symm k).1 * ε₂ (e.symm k).2 := by
      intro k
      linear_combination (ε₂ (e.symm k).2 * ε₂ (e.symm k).2) * h1i (e.symm k).1 +
        ε₁ (e.symm k).1 * h2i (e.symm k).2
    have Hii : ∀ k l : Fin (n * m), k ≠ l → (ε₁ (e.symm k).1 * ε₂ (e.symm k).2) *
        (ε₁ (e.symm l).1 * ε₂ (e.symm l).2) = 0 := by
      intro k l hkl
      have hne : e.symm k ≠ e.symm l := e.symm.injective.ne hkl
      have hre : (ε₁ (e.symm k).1 * ε₂ (e.symm k).2) * (ε₁ (e.symm l).1 * ε₂ (e.symm l).2) =
          (ε₁ (e.symm k).1 * ε₁ (e.symm l).1) * (ε₂ (e.symm k).2 * ε₂ (e.symm l).2) := by ring
      rw [hre]
      by_cases h1 : (e.symm k).1 = (e.symm l).1
      · have h2 : (e.symm k).2 ≠ (e.symm l).2 := fun h2 => hne (Prod.ext h1 h2)
        rw [h2ii _ _ h2, mul_zero]
      · rw [h1ii _ _ h1, zero_mul]
    have Hiii : ∑ k : Fin (n * m), ε₁ (e.symm k).1 * ε₂ (e.symm k).2 = 1 := by
      calc ∑ k : Fin (n * m), ε₁ (e.symm k).1 * ε₂ (e.symm k).2
          = ∑ p : Fin n × Fin m, ε₁ p.1 * ε₂ p.2 :=
            Equiv.sum_comp e.symm (fun p : Fin n × Fin m => ε₁ p.1 * ε₂ p.2)
        _ = (∑ i, ε₁ i) * (∑ j, ε₂ j) := by rw [Finset.sum_mul_sum, Fintype.sum_prod_type]
        _ = 1 := by rw [h1iii, h2iii, mul_one]
    have Hiv : ∀ k : Fin (n * m), (ε₁ (e.symm k).1 * ε₂ (e.symm k).2) *
        algebraMap A (wcwlRing A) (s₁ (e.symm k).1 * s₂ (e.symm k).2) *
        (t₁ (e.symm k).1 * t₂ (e.symm k).2) = ε₁ (e.symm k).1 * ε₂ (e.symm k).2 := by
      intro k
      rw [map_mul]
      linear_combination (ε₂ (e.symm k).2 * algebraMap A (wcwlRing A) (s₂ (e.symm k).2) *
        t₂ (e.symm k).2) * h1iv (e.symm k).1 + ε₁ (e.symm k).1 * h2iv (e.symm k).2
    refine ⟨⟨n * m, fun k => ε₁ (e.symm k).1 * ε₂ (e.symm k).2,
      fun k => t₁ (e.symm k).1 * t₂ (e.symm k).2, fun k => s₁ (e.symm k).1 * s₂ (e.symm k).2,
      fun k => a₁ (e.symm k).1 * s₂ (e.symm k).2 + a₂ (e.symm k).2 * s₁ (e.symm k).1,
      Hi, Hii, Hiii, Hiv, ?_⟩,
      ⟨n * m, fun k => ε₁ (e.symm k).1 * ε₂ (e.symm k).2,
      fun k => t₁ (e.symm k).1 * t₂ (e.symm k).2, fun k => s₁ (e.symm k).1 * s₂ (e.symm k).2,
      fun k => a₁ (e.symm k).1 * a₂ (e.symm k).2,
      Hi, Hii, Hiii, Hiv, ?_⟩⟩
    · intro k
      simp only [map_mul, map_add]
      linear_combination (algebraMap A (wcwlRing A) (s₂ (e.symm k).2) * ε₂ (e.symm k).2) *
          h1v (e.symm k).1 +
        (algebraMap A (wcwlRing A) (s₁ (e.symm k).1) * ε₁ (e.symm k).1) * h2v (e.symm k).2
    · intro k
      simp only [map_mul]
      linear_combination (algebraMap A (wcwlRing A) (s₂ (e.symm k).2) * ε₂ (e.symm k).2 * b₂) *
          h1v (e.symm k).1 +
        (ε₁ (e.symm k).1 * algebraMap A (wcwlRing A) (a₁ (e.symm k).1)) * h2v (e.symm k).2

  have key : ∀ (z : ∀ x : PrimeSpectrum A, Localization.AtPrime x.asIdeal)
      (hz : z ∈ Algebra.adjoin A (Set.range (wcwlDelta A))), P ⟨z, hz⟩ := by
    intro z hz
    induction hz using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨c, rfl⟩ := hx
      apply hgen c
      apply Subtype.ext
      funext y
      show algebraMap A (Localization.AtPrime y.asIdeal) c *
          Ring.inverse (algebraMap A (Localization.AtPrime y.asIdeal) c) *
          Ring.inverse (algebraMap A (Localization.AtPrime y.asIdeal) c) =
        Ring.inverse (algebraMap A (Localization.AtPrime y.asIdeal) c)
      by_cases hu : IsUnit (algebraMap A (Localization.AtPrime y.asIdeal) c)
      · rw [Ring.mul_inverse_cancel _ hu, one_mul]
      · rw [Ring.inverse_non_unit _ hu, mul_zero]
    | algebraMap r => exact hconst r
    | add x y hx hy ihx ihy => exact (hcomb _ _ ihx ihy).1
    | mul x y hx hy ihx ihy => exact (hcomb _ _ ihx ihy).2
  exact key b.1 b.2

theorem wcwl_inverse_of_decomp : ∀ (A : Type u) [CommRing A] (b : wcwlRing A) (n : ℕ) (ε t : Fin n → wcwlRing A) (s a : Fin n → A), (∀ k, ε k * ε k = ε k) → (∀ k l, k ≠ l → ε k * ε l = 0) → ∑ k, ε k = 1 → (∀ k, ε k * algebraMap A (wcwlRing A) (s k) * t k = ε k) → (∀ k, algebraMap A (wcwlRing A) (s k) * ε k * b = ε k * algebraMap A (wcwlRing A) (a k)) → ∃ b' : wcwlRing A, ∀ x : PrimeSpectrum A, wcwlEv A x b' = Ring.inverse (wcwlEv A x b) :=
by
  intro A _ b n ε t s a h1 h2 h3 h4 h5
  classical
  let D : A → wcwlRing A := fun c =>
    ⟨wcwlDelta A c, Algebra.subset_adjoin (Set.mem_range_self c)⟩
  have hD : ∀ (c : A) (x : PrimeSpectrum A), wcwlEv A x (D c) =
      Ring.inverse (algebraMap A (Localization.AtPrime x.asIdeal) c) := fun _ _ => rfl
  have hev_alg : ∀ (x : PrimeSpectrum A) (c : A), wcwlEv A x (algebraMap A (wcwlRing A) c) =
      algebraMap A (Localization.AtPrime x.asIdeal) c := fun _ _ => rfl
  refine ⟨∑ k, ε k * algebraMap A (wcwlRing A) (s k) * D (a k), fun x => ?_⟩
  have E1 : ∀ k, wcwlEv A x (ε k) * wcwlEv A x (ε k) = wcwlEv A x (ε k) := fun k => by
    rw [← map_mul, h1 k]
  have E2 : ∀ k l, k ≠ l → wcwlEv A x (ε k) * wcwlEv A x (ε l) = 0 := fun k l hkl => by
    rw [← map_mul, h2 k l hkl, map_zero]
  have E3 : ∑ k, wcwlEv A x (ε k) = 1 := by
    rw [← map_sum, h3, map_one]
  have E01 : ∀ k, wcwlEv A x (ε k) = 0 ∨ wcwlEv A x (ε k) = 1 := by
    intro k
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (wcwlEv A x (ε k)) with hu | hu
    · right
      apply hu.mul_left_cancel
      rw [E1 k, mul_one]
    · left
      apply hu.mul_right_eq_zero.mp
      rw [sub_mul, one_mul, E1 k, sub_self]
  have hne : ∑ k, wcwlEv A x (ε k) ≠ 0 := by
    rw [E3]; exact one_ne_zero
  obtain ⟨k₀, -, hk₀⟩ := Finset.exists_ne_zero_of_sum_ne_zero hne
  have hE0 : wcwlEv A x (ε k₀) = 1 := (E01 k₀).resolve_left hk₀
  have hEk : ∀ k, k ≠ k₀ → wcwlEv A x (ε k) = 0 := fun k hk => by
    rw [← mul_one (wcwlEv A x (ε k)), ← hE0, E2 k k₀ hk]
  have hb' : wcwlEv A x (∑ k, ε k * algebraMap A (wcwlRing A) (s k) * D (a k)) =
      algebraMap A (Localization.AtPrime x.asIdeal) (s k₀) *
        Ring.inverse (algebraMap A (Localization.AtPrime x.asIdeal) (a k₀)) := by
    rw [map_sum, Fintype.sum_eq_single k₀]
    · rw [map_mul, map_mul, hE0, one_mul, hev_alg, hD]
    · intro k hk
      rw [map_mul, map_mul, hEk k hk, zero_mul, zero_mul]
  have hσT : algebraMap A (Localization.AtPrime x.asIdeal) (s k₀) * wcwlEv A x (t k₀) = 1 := by
    have h := congrArg (wcwlEv A x) (h4 k₀)
    simp only [map_mul, hE0, one_mul, hev_alg] at h
    exact h
  have hTσ : wcwlEv A x (t k₀) * algebraMap A (Localization.AtPrime x.asIdeal) (s k₀) = 1 := by
    rw [mul_comm]; exact hσT
  have hσβ : algebraMap A (Localization.AtPrime x.asIdeal) (s k₀) * wcwlEv A x b =
      algebraMap A (Localization.AtPrime x.asIdeal) (a k₀) := by
    have h := congrArg (wcwlEv A x) (h5 k₀)
    simp only [map_mul, hE0, mul_one, one_mul, hev_alg] at h
    exact h
  have hT : IsUnit (wcwlEv A x (t k₀)) := ⟨⟨_, _, hTσ, hσT⟩, rfl⟩
  have hTinv : Ring.inverse (wcwlEv A x (t k₀)) =
      algebraMap A (Localization.AtPrime x.asIdeal) (s k₀) := by
    calc Ring.inverse (wcwlEv A x (t k₀))
        = Ring.inverse (wcwlEv A x (t k₀)) *
            (wcwlEv A x (t k₀) * algebraMap A (Localization.AtPrime x.asIdeal) (s k₀)) := by
          rw [hTσ, mul_one]
      _ = algebraMap A (Localization.AtPrime x.asIdeal) (s k₀) :=
          Ring.inverse_mul_cancel_left _ _ hT
  have hβ : wcwlEv A x b =
      wcwlEv A x (t k₀) * algebraMap A (Localization.AtPrime x.asIdeal) (a k₀) := by
    calc wcwlEv A x b
        = (wcwlEv A x (t k₀) * algebraMap A (Localization.AtPrime x.asIdeal) (s k₀)) *
            wcwlEv A x b := by rw [hTσ, one_mul]
      _ = wcwlEv A x (t k₀) *
            (algebraMap A (Localization.AtPrime x.asIdeal) (s k₀) * wcwlEv A x b) := by ring
      _ = wcwlEv A x (t k₀) * algebraMap A (Localization.AtPrime x.asIdeal) (a k₀) := by
          rw [hσβ]
  rw [hb', hβ, Ring.mul_inverse_rev, hTinv, mul_comm]

theorem wcwl_local_split : ∀ (A : Type u) [CommRing A], (∀ b : wcwlRing A, ∃ b' : wcwlRing A, ∀ x : PrimeSpectrum A, wcwlEv A x b' = Ring.inverse (wcwlEv A x b)) → ∀ (n : ℕ) (g : Fin n → wcwlRing A), Ideal.span (Set.range g) = ⊤ → ∃ e : Fin n → wcwlRing A, (∀ i, e i * e i = e i) ∧ (∀ i j, i ≠ j → e i * e j = 0) ∧ ∑ i, e i = 1 ∧ ∀ i, ∃ c : wcwlRing A, c * g i = e i :=
by
  intro A _ hInv n g hspan
  classical
  have hext : ∀ b b' : wcwlRing A, (∀ x, wcwlEv A x b = wcwlEv A x b') → b = b' :=
    fun b b' h => Subtype.ext (funext h)

  have h1mem : (1 : wcwlRing A) ∈ Ideal.span (Set.range g) := by
    rw [hspan]; exact Submodule.mem_top
  obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).1 h1mem

  choose g' hg' using fun i => hInv (g i)
  obtain ⟨u, hu⟩ : ∃ u : Fin n → wcwlRing A, ∀ i, u i = g i * g' i := ⟨_, fun _ => rfl⟩
  have hu1 : ∀ i x, IsUnit (wcwlEv A x (g i)) → wcwlEv A x (u i) = 1 := by
    intro i x h
    rw [hu, map_mul, hg']
    exact Ring.mul_inverse_cancel _ h
  have hu0 : ∀ i x, ¬ IsUnit (wcwlEv A x (g i)) → wcwlEv A x (u i) = 0 := by
    intro i x h
    rw [hu, map_mul, hg', Ring.inverse_non_unit _ h, mul_zero]
  have hidem : ∀ i, u i * u i = u i := by
    intro i
    apply hext
    intro x
    rw [map_mul]
    by_cases h : IsUnit (wcwlEv A x (g i))
    · rw [hu1 i x h, mul_one]
    · rw [hu0 i x h, mul_zero]

  have hcov : ∀ x : PrimeSpectrum A, ∃ i, IsUnit (wcwlEv A x (g i)) := by
    intro x
    by_contra hne
    push_neg at hne
    have hsum : wcwlEv A x (∑ i, c i * g i) ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime x.asIdeal) := by
      rw [map_sum]
      refine Ideal.sum_mem _ (fun i _ => ?_)
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ ((IsLocalRing.mem_maximalIdeal _).2 (hne i))
    rw [hc, map_one] at hsum
    exact ((IsLocalRing.mem_maximalIdeal _).1 hsum) isUnit_one

  have hprod : ∏ i, (1 - u i) = 0 := by
    apply hext
    intro x
    obtain ⟨i₀, hi₀⟩ := hcov x
    rw [map_prod, map_zero]
    apply Finset.prod_eq_zero (Finset.mem_univ i₀)
    rw [map_sub, map_one, hu1 i₀ x hi₀, sub_self]

  obtain ⟨P, hP⟩ : ∃ P : Fin n → wcwlRing A,
      ∀ i, P i = ∏ j ∈ Finset.univ.filter (fun j => j < i), (1 - u j) := ⟨_, fun _ => rfl⟩
  have hone_sub : ∀ i, (1 - u i) * (1 - u i) = 1 - u i := by
    intro i; linear_combination hidem i
  have hPidem : ∀ i, P i * P i = P i := by
    intro i
    rw [hP, ← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl (fun j _ => hone_sub j)
  have horth_lt : ∀ i k, i < k → u i * P i * (u k * P k) = 0 := by
    intro i k hik
    have hmem : i ∈ Finset.univ.filter (fun j => j < k) :=
      Finset.mem_filter.2 ⟨Finset.mem_univ _, hik⟩
    have hPk : P k = (1 - u i) *
        ∏ j ∈ (Finset.univ.filter (fun j => j < k)).erase i, (1 - u j) := by
      rw [hP]
      exact (Finset.mul_prod_erase _ (fun j => 1 - u j) hmem).symm
    have h0 : u i * (1 - u i) = 0 := by linear_combination -(hidem i)
    rw [hPk]
    calc u i * P i * (u k * ((1 - u i) *
          ∏ j ∈ (Finset.univ.filter (fun j => j < k)).erase i, (1 - u j)))
        = (u i * (1 - u i)) * (P i * u k *
          ∏ j ∈ (Finset.univ.filter (fun j => j < k)).erase i, (1 - u j)) := by ring
      _ = 0 := by rw [h0, zero_mul]
  have hsum : ∑ i, u i * P i = 1 := by
    have h := Finset.prod_one_sub_ordered (s := (Finset.univ : Finset (Fin n))) (f := u)
    rw [hprod] at h
    have e : ∑ i, u i * P i =
        ∑ i, u i * ∏ j ∈ Finset.univ.filter (fun j => j < i), (1 - u j) :=
      Finset.sum_congr rfl (fun i _ => by rw [hP])
    rw [e]
    linear_combination h
  refine ⟨fun i => u i * P i, ?_, ?_, hsum, ?_⟩
  · intro i
    show u i * P i * (u i * P i) = u i * P i
    calc u i * P i * (u i * P i) = (u i * u i) * (P i * P i) := by ring
      _ = u i * P i := by rw [hidem i, hPidem i]
  · intro i j hij
    show u i * P i * (u j * P j) = 0
    rcases lt_or_gt_of_ne hij with h | h
    · exact horth_lt i j h
    · rw [mul_comm]; exact horth_lt j i h
  · intro i
    refine ⟨g' i * P i, ?_⟩
    show g' i * P i * g i = u i * P i
    rw [hu i]; ring

theorem wcwl_isLocalization_atMax : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (m : Ideal B) [m.IsMaximal], (∀ b : B, ∃ (a s : A) (ε : B), s ∉ Ideal.comap (algebraMap A B) m ∧ ε * ε = ε ∧ ε ∉ m ∧ algebraMap A B s * ε * b = ε * algebraMap A B a) → (∀ (a : A) (u : B), u ∉ m → u * algebraMap A B a = 0 → ∃ s : A, s ∉ Ideal.comap (algebraMap A B) m ∧ s * a = 0) → IsLocalization (Ideal.comap (algebraMap A B) m).primeCompl (Localization.AtPrime m) :=
by
  intro A B _ _ _ m hm H1 H2
  have : m.IsPrime := hm.isPrime
  have hT : ∀ x : A, algebraMap A (Localization.AtPrime m) x =
      algebraMap B (Localization.AtPrime m) (algebraMap A B x) :=
    fun x => IsScalarTower.algebraMap_apply A B _ x
  have hU : ∀ c : B, c ∉ m → IsUnit (algebraMap B (Localization.AtPrime m) c) :=
    fun c hc => IsLocalization.map_units (Localization.AtPrime m) (⟨c, hc⟩ : m.primeCompl)
  have hU' : ∀ c : B, IsUnit (algebraMap B (Localization.AtPrime m) c) → c ∉ m :=
    fun c h => (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime m) m c).mp h
  have hE : ∀ (b : B) (a s : A) (ε : B), ε ∉ m → algebraMap A B s * ε * b = ε * algebraMap A B a →
      algebraMap B (Localization.AtPrime m) (algebraMap A B s) *
          algebraMap B (Localization.AtPrime m) b =
        algebraMap B (Localization.AtPrime m) (algebraMap A B a) := by
    intro b a s ε hε h
    have h' := congrArg (algebraMap B (Localization.AtPrime m)) h
    simp only [map_mul] at h'
    apply (hU ε hε).mul_left_cancel
    linear_combination h'
  refine (isLocalization_iff _ _).mpr ⟨?_, ?_, ?_⟩
  · intro y
    rw [hT]
    exact hU _ y.2
  · intro z
    obtain ⟨⟨b, u⟩, hz⟩ := IsLocalization.surj m.primeCompl z
    simp only at hz
    obtain ⟨a1, s1, ε1, hs1, -, hε1, h1⟩ := H1 b
    obtain ⟨a2, s2, ε2, hs2, -, hε2, h2⟩ := H1 (u : B)
    have E1 := hE b a1 s1 ε1 hε1 h1
    have E2 := hE (u : B) a2 s2 ε2 hε2 h2
    have ha2 : a2 ∉ Ideal.comap (algebraMap A B) m := by
      have : IsUnit (algebraMap B (Localization.AtPrime m) (algebraMap A B a2)) := by
        rw [← E2]; exact (hU _ hs2).mul (hU _ u.2)
      exact hU' _ this
    have hsa : s1 * a2 ∉ Ideal.comap (algebraMap A B) m := fun h =>
      ((Ideal.comap_isPrime (algebraMap A B) m).mem_or_mem h).elim hs1 ha2
    refine ⟨(a1 * s2, ⟨s1 * a2, hsa⟩), ?_⟩
    show z * algebraMap A (Localization.AtPrime m) (s1 * a2) =
      algebraMap A (Localization.AtPrime m) (a1 * s2)
    rw [hT, hT, map_mul, map_mul, map_mul, map_mul]
    linear_combination
      (-(z * algebraMap B (Localization.AtPrime m) (algebraMap A B s1))) * E2 +
      (algebraMap B (Localization.AtPrime m) (algebraMap A B s1) *
        algebraMap B (Localization.AtPrime m) (algebraMap A B s2)) * hz +
      algebraMap B (Localization.AtPrime m) (algebraMap A B s2) * E1
  · intro x y hxy
    rw [hT, hT] at hxy
    obtain ⟨u, hu⟩ := IsLocalization.exists_of_eq (M := m.primeCompl) hxy
    have h0 : (u : B) * algebraMap A B (x - y) = 0 := by
      rw [map_sub, mul_sub, hu, sub_self]
    obtain ⟨s, hs, hsa⟩ := H2 (x - y) u u.2 h0
    refine ⟨⟨s, hs⟩, ?_⟩
    show s * x = s * y
    rw [mul_sub] at hsa
    exact sub_eq_zero.mp hsa

theorem wc_wcc_wlocalization : ∀ (A : Type u) [CommRing A], ∃ (Aw : Type u) (_ : CommRing Aw) (_ : Algebra A Aw) (I : Ideal Aw), wcIndEtale (algebraMap A Aw) ∧ (∀ p : PrimeSpectrum A, ∃ q : PrimeSpectrum Aw, I ≤ q.asIdeal ∧ PrimeSpectrum.comap (algebraMap A Aw) q = p) ∧ (∀ q : PrimeSpectrum Aw, IsClosed ({q} : Set (PrimeSpectrum Aw)) ↔ I ≤ q.asIdeal) ∧ (∀ x : PrimeSpectrum Aw, ∃! y : PrimeSpectrum Aw, IsClosed ({y} : Set (PrimeSpectrum Aw)) ∧ x ⤳ y) ∧ ∀ (m : Ideal Aw) [m.IsMaximal], Nonempty (Localization.AtPrime (Ideal.comap (algebraMap A Aw) m) ≃+* Localization.AtPrime m) :=
by
  intro A _
  classical

  have hext : ∀ b b' : wcwlRing A, (∀ x, wcwlEv A x b = wcwlEv A x b') → b = b' :=
    fun b b' h => Subtype.ext (funext h)
  have hev_alg : ∀ (x : PrimeSpectrum A) (a : A),
      wcwlEv A x (algebraMap A (wcwlRing A) a) = algebraMap A (Localization.AtPrime x.asIdeal) a :=
    fun x a => rfl
  obtain ⟨D, hD⟩ : ∃ D : A → wcwlRing A, ∀ (c : A) (x : PrimeSpectrum A),
      wcwlEv A x (D c) = wcwlDelta A c x :=
    ⟨fun c => ⟨wcwlDelta A c, Algebra.subset_adjoin (Set.mem_range_self c)⟩, fun _ _ => rfl⟩

  have hunitA : ∀ (c : A) (x : PrimeSpectrum A),
      IsUnit (algebraMap A (Localization.AtPrime x.asIdeal) c) ↔ c ∉ x.asIdeal := fun c x =>
    (IsLocalization.AtPrime.isUnit_to_map_iff (Localization.AtPrime x.asIdeal) x.asIdeal c).trans
      Iff.rfl
  have hδ1 : ∀ (c : A) (x : PrimeSpectrum A), c ∉ x.asIdeal →
      algebraMap A (Localization.AtPrime x.asIdeal) c * wcwlDelta A c x = 1 := fun c x h =>
    Ring.mul_inverse_cancel _ ((hunitA c x).2 h)
  have hδ0 : ∀ (c : A) (x : PrimeSpectrum A), c ∈ x.asIdeal → wcwlDelta A c x = 0 := fun c x h =>
    Ring.inverse_non_unit _ (fun h' => (hunitA c x).1 h' h)
  have he1 : ∀ (c : A) (y : PrimeSpectrum A), c ∉ y.asIdeal →
      wcwlEv A y (algebraMap A (wcwlRing A) c * D c) = 1 := by
    intro c y h
    rw [map_mul, hev_alg, hD]
    exact hδ1 c y h
  have he0 : ∀ (c : A) (y : PrimeSpectrum A), c ∈ y.asIdeal →
      wcwlEv A y (algebraMap A (wcwlRing A) c * D c) = 0 := by
    intro c y h
    rw [map_mul, hev_alg, hD, hδ0 c y h, mul_zero]

  have hsurj : ∀ x : PrimeSpectrum A, Function.Surjective (wcwlEv A x) := by
    intro x w
    obtain ⟨⟨a, s⟩, h⟩ := IsLocalization.surj x.asIdeal.primeCompl w
    have h' : w * algebraMap A (Localization.AtPrime x.asIdeal) (s : A) =
        algebraMap A (Localization.AtPrime x.asIdeal) a := h
    refine ⟨algebraMap A (wcwlRing A) a * D s, ?_⟩
    rw [map_mul, hev_alg, hD, ← h']
    have h1 := hδ1 (s : A) x s.2
    calc w * algebraMap A (Localization.AtPrime x.asIdeal) (s : A) * wcwlDelta A (s : A) x
        = w * (algebraMap A (Localization.AtPrime x.asIdeal) (s : A) * wcwlDelta A (s : A) x) := by
          ring
      _ = w := by rw [h1, mul_one]
  have hmemZ : ∀ (x : PrimeSpectrum A) (b : wcwlRing A),
      b ∈ wcwlZ A x ↔ wcwlEv A x b ∈ IsLocalRing.maximalIdeal (Localization.AtPrime x.asIdeal) :=
    fun _ _ => Iff.rfl
  have hzmax : ∀ x : PrimeSpectrum A, (wcwlZ A x).IsMaximal := by
    intro x
    unfold wcwlZ
    exact Ideal.comap_isMaximal_of_surjective _ (hsurj x)
  have hzprime : ∀ x : PrimeSpectrum A, (wcwlZ A x).IsPrime := fun x => (hzmax x).isPrime
  have hcomapZ : ∀ x : PrimeSpectrum A,
      Ideal.comap (algebraMap A (wcwlRing A)) (wcwlZ A x) = x.asIdeal := by
    intro x
    ext a
    rw [Ideal.mem_comap, hmemZ, hev_alg]
    exact IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime x.asIdeal) x.asIdeal a
  have hmemI : ∀ i : wcwlRing A, i ∈ wcwlI A ↔ ∀ x, i ∈ wcwlZ A x := by
    intro i
    unfold wcwlI
    exact Ideal.mem_iInf
  have hIZ : ∀ x : PrimeSpectrum A, wcwlI A ≤ wcwlZ A x := fun x i hi => (hmemI i).1 hi x

  have hInv : ∀ b : wcwlRing A, ∃ b' : wcwlRing A, ∀ x : PrimeSpectrum A,
      wcwlEv A x b' = Ring.inverse (wcwlEv A x b) := by
    intro b
    obtain ⟨n, ε, t, s, a, h1, h2, h3, h4, h5⟩ := wcwl_decomp A b
    exact wcwl_inverse_of_decomp A b n ε t s a h1 h2 h3 h4 h5
  have hunitB : ∀ b : wcwlRing A, (∀ x, IsUnit (wcwlEv A x b)) → IsUnit b := by
    intro b hb
    obtain ⟨b', hb'⟩ := hInv b
    have hbb' : b * b' = 1 := hext _ _ fun x => by
      rw [map_mul, map_one, hb', Ring.mul_inverse_cancel _ (hb x)]
    exact ⟨⟨b, b', hbb', by rw [mul_comm]; exact hbb'⟩, rfl⟩

  have hImax : ∀ m : Ideal (wcwlRing A), m.IsMaximal → wcwlI A ≤ m := by
    intro m hm i hi
    by_contra him
    obtain ⟨y, q, hq, hyq⟩ := hm.exists_inv him
    have hyi : y * i ∈ wcwlI A := Ideal.mul_mem_left _ y hi
    have hu : IsUnit q := by
      apply hunitB
      intro x
      have h1 : wcwlEv A x (y * i) ∈ IsLocalRing.maximalIdeal (Localization.AtPrime x.asIdeal) :=
        (hmemZ x _).1 ((hmemI _).1 hyi x)
      have h2 : q = 1 - y * i := by rw [← hyq]; ring
      rw [h2, map_sub, map_one]
      exact IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ ((IsLocalRing.mem_maximalIdeal _).1 h1)
    exact hm.ne_top (Ideal.eq_top_of_isUnit_mem _ hq hu)

  have htransfer : ∀ (P : Ideal (wcwlRing A)), P.IsPrime → ∀ (b ε : wcwlRing A) (a s : A),
      algebraMap A (wcwlRing A) s ∉ P → ε ∉ P →
      algebraMap A (wcwlRing A) s * ε * b = ε * algebraMap A (wcwlRing A) a →
      (b ∈ P ↔ algebraMap A (wcwlRing A) a ∈ P) := by
    intro P hP b ε a s hs hε h
    constructor
    · intro hb
      have : ε * algebraMap A (wcwlRing A) a ∈ P := by
        rw [← h]
        exact P.mul_mem_left _ hb
      exact (hP.mem_or_mem this).resolve_left hε
    · intro ha
      have : algebraMap A (wcwlRing A) s * ε * b ∈ P := by
        rw [h]
        exact P.mul_mem_left ε ha
      rcases hP.mem_or_mem this with h1 | h1
      · rcases hP.mem_or_mem h1 with h2 | h2
        · exact absurd h2 hs
        · exact absurd h2 hε
      · exact h1

  have hclaimA : ∀ (Q : Ideal (wcwlRing A)), Q.IsPrime → wcwlI A ≤ Q → ∀ x : PrimeSpectrum A,
      Ideal.comap (algebraMap A (wcwlRing A)) Q = x.asIdeal → Q = wcwlZ A x := by
    intro Q hQ hIQ x hx
    ext b
    obtain ⟨a, s, ε, hs, -, hgood, hid⟩ := wcwl_germ A b x
    have hεQ : ε ∉ Q := hgood Q hQ hIQ hx
    have hεZ : ε ∉ wcwlZ A x := hgood _ (hzprime x) (hIZ x) (hcomapZ x)
    have hsQ : algebraMap A (wcwlRing A) s ∉ Q := fun h => hs (by rw [← hx]; exact Ideal.mem_comap.2 h)
    have hsZ : algebraMap A (wcwlRing A) s ∉ wcwlZ A x := fun h =>
      hs (by rw [← hcomapZ x]; exact Ideal.mem_comap.2 h)
    have e1 : algebraMap A (wcwlRing A) a ∈ Q ↔ a ∈ x.asIdeal := by rw [← hx, Ideal.mem_comap]
    have e2 : algebraMap A (wcwlRing A) a ∈ wcwlZ A x ↔ a ∈ x.asIdeal := by
      rw [← Ideal.mem_comap, hcomapZ x]
    rw [htransfer Q hQ b ε a s hsQ hεQ hid, htransfer _ (hzprime x) b ε a s hsZ hεZ hid, e1, e2]

  have hsep : ∀ (Q : Ideal (wcwlRing A)), Q.IsPrime → ∀ p₁ p₂ : PrimeSpectrum A,
      Q ≤ wcwlZ A p₁ → Q ≤ wcwlZ A p₂ → p₁.asIdeal ≤ p₂.asIdeal := by
    intro Q hQ p₁ p₂ h1 h2 c hc
    by_contra hc2
    have hprod : (algebraMap A (wcwlRing A) c * D c) * (1 - algebraMap A (wcwlRing A) c * D c) ∈ Q := by
      have : (algebraMap A (wcwlRing A) c * D c) * (1 - algebraMap A (wcwlRing A) c * D c) = 0 := by
        apply hext
        intro y
        rw [map_mul, map_sub, map_one, map_zero]
        by_cases hcy : c ∈ y.asIdeal
        · rw [he0 c y hcy]; ring
        · rw [he1 c y hcy]; ring
      rw [this]
      exact Q.zero_mem
    rcases hQ.mem_or_mem hprod with h | h
    · have h3 := (hmemZ p₂ _).1 (h2 h)
      rw [he1 c p₂ hc2] at h3
      exact ((IsLocalRing.mem_maximalIdeal _).1 h3) isUnit_one
    · have h3 := (hmemZ p₁ _).1 (h1 h)
      rw [map_sub, map_one, he0 c p₁ hc, sub_zero] at h3
      exact ((IsLocalRing.mem_maximalIdeal _).1 h3) isUnit_one

  have hlocAt : ∀ (m : Ideal (wcwlRing A)) [m.IsMaximal],
      IsLocalization (Ideal.comap (algebraMap A (wcwlRing A)) m).primeCompl
        (Localization.AtPrime m) := by
    intro m hm
    have hIm := hImax m hm
    obtain ⟨x, hx⟩ : ∃ x : PrimeSpectrum A,
        Ideal.comap (algebraMap A (wcwlRing A)) m = x.asIdeal :=
      ⟨PrimeSpectrum.comap (algebraMap A (wcwlRing A)) ⟨m, hm.isPrime⟩, rfl⟩
    have hmz : m = wcwlZ A x := hclaimA m hm.isPrime hIm x hx
    apply wcwl_isLocalization_atMax A (wcwlRing A) m
    · intro b
      obtain ⟨a, s, ε, hs, hεε, hgood, hid⟩ := wcwl_germ A b x
      exact ⟨a, s, ε, by rw [hx]; exact hs, hεε, hgood m hm.isPrime hIm hx, hid⟩
    · intro a u hu hua
      have hu' : u ∉ wcwlZ A x := by rw [← hmz]; exact hu
      have hu1 : IsUnit (wcwlEv A x u) := by
        by_contra hnu
        exact hu' ((hmemZ x u).2 ((IsLocalRing.mem_maximalIdeal _).2 hnu))
      have h0 : algebraMap A (Localization.AtPrime x.asIdeal) a = 0 := by
        have h1 := congrArg (wcwlEv A x) hua
        rw [map_mul, hev_alg, map_zero] at h1
        exact hu1.mul_right_eq_zero.1 h1
      obtain ⟨⟨s, hs⟩, hsa⟩ := (IsLocalization.map_eq_zero_iff x.asIdeal.primeCompl _ a).1 h0
      exact ⟨s, by rw [hx]; exact hs, hsa⟩
  refine ⟨wcwlRing A, inferInstance, inferInstance, wcwlI A, ?_, ?_, ?_, ?_, ?_⟩
  ·
    apply wc_indEtale_of_local_split A (wcwlRing A)
    · exact wcwl_local_split A hInv
    · intro M hM
      haveI := hlocAt M
      have h := wc_sh_localization_indEtale A (Localization.AtPrime M)
        (Ideal.comap (algebraMap A (wcwlRing A)) M).primeCompl
      rw [IsScalarTower.algebraMap_eq A (wcwlRing A) (Localization.AtPrime M)] at h
      exact h
  ·
    intro p
    exact ⟨⟨wcwlZ A p, hzprime p⟩, hIZ p, PrimeSpectrum.ext (hcomapZ p)⟩
  ·
    intro q
    rw [PrimeSpectrum.isClosed_singleton_iff_isMaximal]
    constructor
    · intro hq
      exact hImax _ hq
    · intro hq
      rw [hclaimA q.asIdeal q.isPrime hq (PrimeSpectrum.comap (algebraMap A (wcwlRing A)) q) rfl]
      exact hzmax _
  ·
    intro x
    obtain ⟨m, hm, hxm⟩ := Ideal.exists_le_maximal x.asIdeal x.isPrime.ne_top
    refine ⟨⟨m, hm.isPrime⟩, ⟨(PrimeSpectrum.isClosed_singleton_iff_isMaximal _).2 hm,
      (PrimeSpectrum.le_iff_specializes x ⟨m, hm.isPrime⟩).1 hxm⟩, ?_⟩
    rintro y ⟨hy, hxy⟩
    have hym : y.asIdeal.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).1 hy
    have hxy' : x.asIdeal ≤ y.asIdeal := (PrimeSpectrum.le_iff_specializes x y).2 hxy
    have e1 : y.asIdeal = wcwlZ A (PrimeSpectrum.comap (algebraMap A (wcwlRing A)) y) :=
      hclaimA y.asIdeal hym.isPrime (hImax _ hym) _ rfl
    have e2 : m = wcwlZ A (PrimeSpectrum.comap (algebraMap A (wcwlRing A))
        (⟨m, hm.isPrime⟩ : PrimeSpectrum (wcwlRing A))) :=
      hclaimA m hm.isPrime (hImax _ hm) _ rfl
    have k1 : x.asIdeal ≤ wcwlZ A (PrimeSpectrum.comap (algebraMap A (wcwlRing A)) y) := by
      rw [← e1]; exact hxy'
    have k2 : x.asIdeal ≤ wcwlZ A (PrimeSpectrum.comap (algebraMap A (wcwlRing A))
        (⟨m, hm.isPrime⟩ : PrimeSpectrum (wcwlRing A))) := by
      rw [← e2]; exact hxm
    have h12 := hsep x.asIdeal x.isPrime _ _ k1 k2
    have h21 := hsep x.asIdeal x.isPrime _ _ k2 k1
    have hp : PrimeSpectrum.comap (algebraMap A (wcwlRing A)) y =
        PrimeSpectrum.comap (algebraMap A (wcwlRing A))
          (⟨m, hm.isPrime⟩ : PrimeSpectrum (wcwlRing A)) :=
      PrimeSpectrum.ext (le_antisymm h12 h21)
    apply PrimeSpectrum.ext
    rw [e1, hp]
    exact e2.symm
  ·
    intro m hm
    haveI := hlocAt m
    exact ⟨(IsLocalization.algEquiv (Ideal.comap (algebraMap A (wcwlRing A)) m).primeCompl
      (Localization.AtPrime (Ideal.comap (algebraMap A (wcwlRing A)) m))
      (Localization.AtPrime m)).toRingEquiv⟩

theorem wc_wcc_indEtale_closed_fibre_maximal : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S], wcIndEtale (algebraMap R S) → ∀ (I : Ideal R), (∀ p : Ideal R, p.IsPrime → I ≤ p → p.IsMaximal) → ∀ q : Ideal S, q.IsPrime → I ≤ Ideal.comap (algebraMap R S) q → q.IsMaximal :=
by
  intro R S _ _ _ hInd I hI q hq hIq
  haveI := hq
  have hInd' := hInd
  unfold wcIndEtale at hInd'
  rw [show (algebraMap R S).toAlgebra = ‹Algebra R S› from
    Algebra.algebra_ext _ _ (fun _ => rfl)] at hInd'
  haveI hpm : (Ideal.comap (algebraMap R S) q).IsMaximal :=
    hI _ (Ideal.comap_isPrime (algebraMap R S) q) hIq
  letI : Field (R ⧸ Ideal.comap (algebraMap R S) q) := Ideal.Quotient.field _
  have hint : Algebra.IsIntegral (R ⧸ Ideal.comap (algebraMap R S) q) (S ⧸ q) := by
    constructor
    intro y
    obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨E, _, _, hE, α, β, hαβ⟩ := hInd' (Polynomial R) (Polynomial.aeval s)
    haveI := hE
    have hβ : β (α Polynomial.X) = s := by
      have h0 := congrArg (fun f => f Polynomial.X) hαβ
      simpa using h0
    haveI : Module.Finite (R ⧸ Ideal.comap (algebraMap R S) q)
        (TensorProduct R (R ⧸ Ideal.comap (algebraMap R S) q) E) :=
      Algebra.FormallyUnramified.finite_of_free _ _
    haveI : Algebra.IsIntegral (R ⧸ Ideal.comap (algebraMap R S) q)
        (TensorProduct R (R ⧸ Ideal.comap (algebraMap R S) q) E) :=
      Algebra.IsIntegral.of_finite _ _
    let ψ : TensorProduct R (R ⧸ Ideal.comap (algebraMap R S) q) E →ₐ[R ⧸ Ideal.comap (algebraMap R S) q]
        S ⧸ q :=
      Algebra.TensorProduct.lift (Algebra.ofId _ (S ⧸ q)) ((Ideal.Quotient.mkₐ R q).comp β)
        (fun _ _ => Commute.all _ _)
    have h1 : ψ (TensorProduct.tmul R (1 : R ⧸ Ideal.comap (algebraMap R S) q) (α Polynomial.X)) =
        Ideal.Quotient.mk q s := by
      simp only [ψ, Algebra.TensorProduct.lift_tmul, map_one, one_mul, AlgHom.comp_apply,
        Ideal.Quotient.mkₐ_eq_mk, hβ]
    rw [← h1]
    exact (Algebra.IsIntegral.isIntegral _).map ψ
  have hinj : Function.Injective
      (algebraMap (R ⧸ Ideal.comap (algebraMap R S) q) (S ⧸ q)) := by
    exact Ideal.algebraMap_quotient_injective
  have hfield : IsField (S ⧸ q) :=
    (Algebra.IsIntegral.isField_iff_isField (R := R ⧸ Ideal.comap (algebraMap R S) q)
      (S := S ⧸ q) hinj).mp (Field.toIsField _)
  exact Ideal.Quotient.maximal_of_isField q hfield

theorem wc_wcc_jacobson_localize : ∀ (C : Type u) [CommRing C] (J : Ideal C), (∀ x : PrimeSpectrum C, ∃! y : PrimeSpectrum C, IsClosed ({y} : Set (PrimeSpectrum C)) ∧ x ⤳ y) → (∀ q : Ideal C, q.IsPrime → J ≤ q → q.IsMaximal) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra C D) (M : Submonoid C), IsLocalization M D ∧ (∀ q : PrimeSpectrum C, J ≤ q.asIdeal → q ∈ Set.range (PrimeSpectrum.comap (algebraMap C D))) ∧ IsClosed {x : PrimeSpectrum D | IsClosed ({x} : Set (PrimeSpectrum D))} ∧ (∀ x : PrimeSpectrum D, ∃! y : PrimeSpectrum D, IsClosed ({y} : Set (PrimeSpectrum D)) ∧ x ⤳ y) ∧ ∀ (m : Ideal D) [m.IsMaximal], J ≤ Ideal.comap (algebraMap C D) m ∧ Nonempty (Localization.AtPrime (Ideal.comap (algebraMap C D) m) ≃+* Localization.AtPrime m) :=
by
  intro C _ J hW hJ
  let M : Submonoid C :=
    { carrier := {x | x - 1 ∈ J}
      one_mem' := by simp
      mul_mem' := by
        intro a b ha hb
        simp only [Set.mem_setOf_eq] at *
        have e : a * b - 1 = a * (b - 1) + (a - 1) := by ring
        rw [e]
        exact J.add_mem (J.mul_mem_left a hb) ha }
  have hM : ∀ x ∈ M, x - 1 ∈ J := fun x hx => hx

  have s2 : ∀ m : Ideal (Localization M), m.IsMaximal →
      J ≤ Ideal.comap (algebraMap C (Localization M)) m := by
    intro m hm a ha
    rw [Ideal.mem_comap]
    by_contra hna
    obtain ⟨y, i, hi, hyi⟩ := hm.exists_inv hna
    obtain ⟨⟨c, s⟩, hcs⟩ := IsLocalization.surj M y
    simp only at hcs
    have hsM : (s : C) - c * a ∈ M := by
      show (s : C) - c * a - 1 ∈ J
      have e : (s : C) - c * a - 1 = ((s : C) - 1) - c * a := by ring
      rw [e]
      exact J.sub_mem (hM s s.2) (J.mul_mem_left c ha)
    have heq : i * algebraMap C (Localization M) s =
        algebraMap C (Localization M) ((s : C) - c * a) := by
      rw [map_sub, map_mul]
      linear_combination (algebraMap C (Localization M) s) * hyi -
        (algebraMap C (Localization M) a) * hcs
    have hu : IsUnit (i * algebraMap C (Localization M) s) := by
      rw [heq]
      exact IsLocalization.map_units (Localization M) (⟨_, hsM⟩ : M)
    exact hm.ne_top (Ideal.eq_top_of_isUnit_mem m hi (isUnit_of_mul_isUnit_left hu))

  have s3 : ∀ P : Ideal (Localization M), P.IsPrime →
      (Ideal.comap (algebraMap C (Localization M)) P).IsMaximal → P.IsMaximal := by
    intro P hP hPc
    obtain ⟨m, hm, hPm⟩ := Ideal.exists_le_maximal P hP.ne_top
    have hle : Ideal.comap (algebraMap C (Localization M)) P ≤
        Ideal.comap (algebraMap C (Localization M)) m := Ideal.comap_mono hPm
    haveI := hm.isPrime
    have hne : Ideal.comap (algebraMap C (Localization M)) m ≠ ⊤ :=
      (inferInstance : (Ideal.comap (algebraMap C (Localization M)) m).IsPrime).ne_top
    have hceq := hPc.eq_of_le hne hle
    have e : P = m := by
      calc P = Ideal.map (algebraMap C (Localization M))
            (Ideal.comap (algebraMap C (Localization M)) P) :=
            (IsLocalization.map_comap M (Localization M) P).symm
        _ = Ideal.map (algebraMap C (Localization M))
            (Ideal.comap (algebraMap C (Localization M)) m) := by rw [hceq]
        _ = m := IsLocalization.map_comap M (Localization M) m
    rw [e]
    exact hm
  have key : ∀ P : Ideal (Localization M), P.IsPrime →
      (P.IsMaximal ↔ J ≤ Ideal.comap (algebraMap C (Localization M)) P) := by
    intro P hP
    haveI := hP
    exact ⟨s2 P, fun h => s3 P hP (hJ _ inferInstance h)⟩
  refine ⟨Localization M, inferInstance, inferInstance, M, Localization.isLocalization,
    ?_, ?_, ?_, ?_⟩
  ·
    intro q hq
    rw [PrimeSpectrum.localization_comap_range (Localization M) M]
    show Disjoint (M : Set C) (q.asIdeal : Set C)
    rw [Set.disjoint_left]
    intro x hxM hxq
    apply q.isPrime.ne_top
    rw [Ideal.eq_top_iff_one]
    have e : (1 : C) = x - (x - 1) := by ring
    rw [e]
    exact q.asIdeal.sub_mem hxq (hq (hM x hxM))
  ·
    have hset : {x : PrimeSpectrum (Localization M) | IsClosed ({x} : Set _)} =
        PrimeSpectrum.zeroLocus
          ((Ideal.map (algebraMap C (Localization M)) J : Ideal (Localization M)) :
            Set (Localization M)) := by
      ext x
      rw [Set.mem_setOf_eq, PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe,
        PrimeSpectrum.isClosed_singleton_iff_isMaximal, key x.asIdeal x.isPrime,
        Ideal.map_le_iff_le_comap]
    rw [hset]
    exact PrimeSpectrum.isClosed_zeroLocus _
  ·
    intro x
    obtain ⟨m, hm, hxm⟩ := Ideal.exists_le_maximal x.asIdeal x.isPrime.ne_top
    let y : PrimeSpectrum (Localization M) := ⟨m, hm.isPrime⟩
    have hcl : ∀ z : PrimeSpectrum (Localization M), IsClosed ({z} : Set _) →
        IsClosed ({PrimeSpectrum.comap (algebraMap C (Localization M)) z} :
          Set (PrimeSpectrum C)) := by
      intro z hz
      rw [PrimeSpectrum.isClosed_singleton_iff_isMaximal] at hz ⊢
      exact hJ _ (PrimeSpectrum.comap (algebraMap C (Localization M)) z).isPrime (s2 _ hz)
    have hy : IsClosed ({y} : Set _) := (PrimeSpectrum.isClosed_singleton_iff_isMaximal y).mpr hm
    have hxy : x ⤳ y := (PrimeSpectrum.le_iff_specializes x y).mp hxm
    refine ⟨y, ⟨hy, hxy⟩, ?_⟩
    rintro y' ⟨hy', hxy'⟩
    obtain ⟨z, -, hz⟩ := hW (PrimeSpectrum.comap (algebraMap C (Localization M)) x)
    have e1 := hz _ ⟨hcl y' hy', hxy'.map (PrimeSpectrum.continuous_comap _)⟩
    have e2 := hz _ ⟨hcl y hy, hxy.map (PrimeSpectrum.continuous_comap _)⟩
    exact PrimeSpectrum.localization_comap_injective (Localization M) M (e1.trans e2.symm)
  ·
    intro m _
    exact ⟨s2 m inferInstance,
      ⟨(IsLocalization.localizationLocalizationAtPrimeIsoLocalization M m).toRingEquiv⟩⟩

theorem wc_wcc_extremal_refine : ∀ (C : Type u) [CommRing C], IsClosed {x : PrimeSpectrum C | IsClosed ({x} : Set (PrimeSpectrum C))} → (∀ x : PrimeSpectrum C, ∃! y : PrimeSpectrum C, IsClosed ({y} : Set (PrimeSpectrum C)) ∧ x ⤳ y) → ∃ (D : Type u) (_ : CommRing D) (_ : Algebra C D), Algebra.WeaklyEtale C D ∧ Function.Surjective (PrimeSpectrum.comap (algebraMap C D)) ∧ IsClosed {x : PrimeSpectrum D | IsClosed ({x} : Set (PrimeSpectrum D))} ∧ (∀ x : PrimeSpectrum D, ∃! y : PrimeSpectrum D, IsClosed ({y} : Set (PrimeSpectrum D)) ∧ x ⤳ y) ∧ ExtremallyDisconnected {x : PrimeSpectrum D | IsClosed ({x} : Set (PrimeSpectrum D))} ∧ ∀ (m : Ideal D) [m.IsMaximal], (Ideal.comap (algebraMap C D) m).IsMaximal ∧ Nonempty (Localization.AtPrime (Ideal.comap (algebraMap C D) m) ≃+* Localization.AtPrime m) :=
by

  have s1 : ∀ (C : Type u) [CommRing C], IsClosed {x : PrimeSpectrum C | IsClosed ({x} : Set (PrimeSpectrum C))} → CompactSpace {x : PrimeSpectrum C | IsClosed ({x} : Set (PrimeSpectrum C))} ∧ T2Space {x : PrimeSpectrum C | IsClosed ({x} : Set (PrimeSpectrum C))} := by
    intro C _ hcl
    classical
    refine ⟨isCompact_iff_compactSpace.mp hcl.isCompact, ?_⟩
    set X0 := {x : PrimeSpectrum C | IsClosed ({x} : Set (PrimeSpectrum C))} with hX0
    set J := PrimeSpectrum.vanishingIdeal X0 with hJ
    have hJle : ∀ x ∈ X0, ∀ f ∈ J, f ∈ x.asIdeal := fun x hx f hf =>
      (PrimeSpectrum.mem_vanishingIdeal X0 f).mp hf x hx
    have hmaxX : ∀ x ∈ X0, x.asIdeal.IsMaximal := fun x hx =>
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal x).mp hx
    have hb : ∀ q : PrimeSpectrum C, (J : Set C) ⊆ q.asIdeal → q ∈ X0 := by
      intro q hq
      have : q ∈ PrimeSpectrum.zeroLocus (J : Set C) := hq
      rw [hJ, PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hcl.closure_eq] at this
      exact this
    have hrad : ∀ (f : C) (n : ℕ), f ^ n ∈ J → f ∈ J := by
      intro f n hf
      rw [PrimeSpectrum.mem_vanishingIdeal]
      intro x hx
      exact x.isPrime.mem_of_pow_mem n (hJle x hx _ hf)
    refine ⟨fun x y hxy => ?_⟩
    have hx := hmaxX x.1 x.2
    have hy := hmaxX y.1 y.2
    have hne : ¬ x.1.asIdeal ≤ y.1.asIdeal := by
      intro hle
      apply hxy
      apply Subtype.ext
      apply PrimeSpectrum.ext
      exact hx.eq_of_le hy.ne_top hle
    obtain ⟨a, hax, hay⟩ := Set.not_subset.mp hne
    have hclaim : ∃ s : C, s ∉ x.1.asIdeal ∧ s * a ∈ J := by
      by_contra hno
      push_neg at hno
      let S : Submonoid C := x.1.asIdeal.primeCompl ⊔ Submonoid.powers a
      have hdisj : Disjoint (J : Set C) (S : Set C) := by
        rw [Set.disjoint_left]
        intro z hzJ hzS
        obtain ⟨w, hw, v, hv, rfl⟩ := Submonoid.mem_sup.mp hzS
        obtain ⟨n, rfl⟩ := hv
        simp only at hzJ
        rcases Nat.eq_zero_or_pos n with h0 | hpos
        · subst h0
          rw [pow_zero, mul_one] at hzJ
          exact hw (hJle x.1 x.2 _ hzJ)
        · apply hno w hw
          apply hrad _ n
          have e : (w * a) ^ n = w ^ (n - 1) * (w * a ^ n) := by
            obtain ⟨k, rfl⟩ : ∃ k, n = k + 1 := ⟨n - 1, by omega⟩
            rw [Nat.add_sub_cancel, mul_pow, pow_succ]
            ring
          rw [e]
          exact J.mul_mem_left _ hzJ
      obtain ⟨q, hq, hJq, hqS⟩ := Ideal.exists_le_prime_disjoint J S hdisj
      have hqx : q ≤ x.1.asIdeal := by
        intro r hr
        by_contra hrx
        exact Set.disjoint_left.mp hqS hr (Submonoid.mem_sup_left (show r ∈ x.1.asIdeal.primeCompl from hrx))
      have haq : a ∉ q := fun h =>
        Set.disjoint_left.mp hqS h (Submonoid.mem_sup_right (Submonoid.mem_powers a))
      have hqX : (⟨q, hq⟩ : PrimeSpectrum C) ∈ X0 := hb ⟨q, hq⟩ hJq
      have hqmax := hmaxX _ hqX
      have : q = x.1.asIdeal := hqmax.eq_of_le hx.ne_top hqx
      exact haq (this ▸ hax)
    obtain ⟨s, hsx, hsa⟩ := hclaim
    refine ⟨Subtype.val ⁻¹' (PrimeSpectrum.basicOpen s : Set (PrimeSpectrum C)),
      Subtype.val ⁻¹' (PrimeSpectrum.basicOpen a : Set (PrimeSpectrum C)),
      (PrimeSpectrum.basicOpen s).isOpen.preimage continuous_subtype_val,
      (PrimeSpectrum.basicOpen a).isOpen.preimage continuous_subtype_val, hsx, hay, ?_⟩
    rw [Set.disjoint_left]
    intro z hzs hza
    have h1 : s ∉ z.1.asIdeal := hzs
    have h2 : a ∉ z.1.asIdeal := hza
    rcases z.1.isPrime.mem_or_mem (hJle z.1 z.2 _ hsa) with h | h
    exacts [h1 h, h2 h]

  have s3 : ∀ (C : Type u) [CommRing C] (T : Type u) [TopologicalSpace T] [CompactSpace T], Algebra.WeaklyEtale C (LocallyConstant T C) := by
    intro C _ T _ _
    classical
    have hsep : ∀ φ : LocallyConstant T C,
        ∃ c : TensorProduct C (LocallyConstant T C) (LocallyConstant T C),
        Algebra.TensorProduct.lmul' C c = 1 ∧
          c * (TensorProduct.tmul C (1 : LocallyConstant T C) φ -
            TensorProduct.tmul C φ 1) = 0 := by
      intro φ
      let s : Finset C := (LocallyConstant.range_finite φ).toFinset
      let ε : C → LocallyConstant T C :=
        fun v => φ.map (fun w => if w = v then (1 : C) else 0)
      have hε : ∀ v y, ε v y = if φ y = v then 1 else 0 := fun v y => rfl
      have F1 : ∀ v, ε v * ε v = ε v := by
        intro v
        ext y
        rw [LocallyConstant.mul_apply, hε]
        split_ifs <;> simp
      have F2 : ∀ v, ε v * φ = v • ε v := by
        intro v
        ext y
        rw [LocallyConstant.mul_apply, LocallyConstant.smul_apply, hε]
        split_ifs with h
        · rw [h, one_mul, smul_eq_mul, mul_one]
        · rw [zero_mul, smul_eq_mul, mul_zero]
      have F3 : ∑ v ∈ s, ε v = 1 := by
        ext y
        have := map_sum (LocallyConstant.evalRingHom y :
          LocallyConstant T C →+* C) ε s
        simp only [LocallyConstant.evalRingHom_apply] at this
        rw [this]
        simp [hε, s, Finset.sum_ite_eq]
      refine ⟨∑ v ∈ s, TensorProduct.tmul C (ε v) (ε v), ?_, ?_⟩
      · rw [map_sum]
        simp only [Algebra.TensorProduct.lmul'_apply_tmul, F1]
        exact F3
      · rw [Finset.sum_mul]
        apply Finset.sum_eq_zero
        intro v _
        rw [mul_sub, Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
          mul_one, F2, TensorProduct.smul_tmul, sub_self]
    have hflat : Module.Flat C (LocallyConstant T C) := by
      refine Module.Flat.of_forall_isTrivialRelation ?_
      intro l f x hfx
      let xb : LocallyConstant T (Fin l → C) := LocallyConstant.unflip x
      have hxb : ∀ t i, xb t i = x i t := fun t i => rfl
      let R : Finset (Fin l → C) := (LocallyConstant.range_finite xb).toFinset
      let eR : R ≃ Fin R.card := R.equivFin
      let v : Fin R.card → (Fin l → C) := fun j => (eR.symm j).1
      have hv : ∀ j, ∃ t, xb t = v j := fun j => by
        have h := (eR.symm j).2
        simp only [R, Set.Finite.mem_toFinset, Set.mem_range] at h
        exact h
      have hfib : ∀ j, IsClopen {t | xb t = v j} := fun j => xb.isLocallyConstant.isClopen_fiber _
      have hev : ∀ (t : T) (g : Fin R.card → LocallyConstant T C),
          (∑ j, g j) t = ∑ j, g j t := by
        intro t g
        have := map_sum (LocallyConstant.evalRingHom t : LocallyConstant T C →+* C) g Finset.univ
        simp only [LocallyConstant.evalRingHom_apply] at this
        exact this
      refine ⟨R.card, fun i j => v j i, fun j => LocallyConstant.charFn C (hfib j), ?_, ?_⟩
      · intro i
        ext t
        rw [hev]
        have hmem : xb t ∈ R := by
          simp only [R, Set.Finite.mem_toFinset, Set.mem_range]
          exact ⟨t, rfl⟩
        rw [Finset.sum_eq_single (eR ⟨xb t, hmem⟩)]
        · rw [LocallyConstant.smul_apply, LocallyConstant.coe_charFn, Set.indicator_of_mem]
          · simp only [v, Equiv.symm_apply_apply, Pi.one_apply, smul_eq_mul, mul_one]
            exact (hxb t i).symm
          · show xb t = v (eR ⟨xb t, hmem⟩)
            simp only [v, Equiv.symm_apply_apply]
        · intro j _ hj
          rw [LocallyConstant.smul_apply, LocallyConstant.coe_charFn, Set.indicator_of_notMem]
          · simp
          · intro h
            apply hj
            have h' : xb t = v j := h
            rw [eq_comm, eR.apply_eq_iff_eq_symm_apply]
            exact Subtype.ext h'
        · intro h
          exact absurd (Finset.mem_univ _) h
      · intro j
        obtain ⟨t, ht⟩ := hv j
        have h1 := congrArg (fun g : LocallyConstant T C => g t) hfx
        have h2 := map_sum (LocallyConstant.evalRingHom t : LocallyConstant T C →+* C)
          (fun i => f i • x i) Finset.univ
        simp only [LocallyConstant.evalRingHom_apply, LocallyConstant.smul_apply, smul_eq_mul] at h2
        simp only [LocallyConstant.zero_apply] at h1
        rw [h2] at h1
        simp only [← ht, hxb]
        exact h1
    have hflatμ : RingHom.Flat
        (Algebra.TensorProduct.lmul' C :
          TensorProduct C (LocallyConstant T C) (LocallyConstant T C) →ₐ[C]
              LocallyConstant T C).toRingHom := by
      let μ := (Algebra.TensorProduct.lmul' C :
          TensorProduct C (LocallyConstant T C) (LocallyConstant T C) →ₐ[C] LocallyConstant T C)
      letI : Algebra (TensorProduct C (LocallyConstant T C) (LocallyConstant T C))
          (LocallyConstant T C) := μ.toRingHom.toAlgebra
      let M : Submonoid (TensorProduct C (LocallyConstant T C) (LocallyConstant T C)) :=
        Submonoid.comap μ.toRingHom (IsUnit.submonoid (LocallyConstant T C))
      have hM : ∀ y, y ∈ M ↔ IsUnit (μ y) := fun y => by
        rw [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]; rfl
      haveI : IsLocalization M (LocallyConstant T C) := by
        refine ⟨?_, ?_, ?_⟩
        · intro y
          exact (hM y.1).mp y.2
        · intro z
          refine ⟨⟨TensorProduct.tmul C z 1, 1⟩, ?_⟩
          show z * μ 1 = μ (TensorProduct.tmul C z 1)
          rw [map_one, Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
        · intro x y hxy
          change μ x = μ y at hxy
          have hker : x - y ∈ Ideal.span (Set.range fun s : LocallyConstant T C =>
              TensorProduct.tmul C (1 : LocallyConstant T C) s - TensorProduct.tmul C s 1) := by
            rw [KaehlerDifferential.span_range_eq_ideal, KaehlerDifferential.ideal, RingHom.mem_ker,
              map_sub]
            exact sub_eq_zero.mpr hxy
          have key : ∀ a ∈ Ideal.span (Set.range fun s : LocallyConstant T C =>
              TensorProduct.tmul C (1 : LocallyConstant T C) s - TensorProduct.tmul C s 1),
              ∃ c ∈ M, c * a = 0 := by
            intro a ha
            induction ha using Submodule.span_induction with
            | mem a ha =>
              obtain ⟨s, rfl⟩ := ha
              obtain ⟨c, hc1, hc2⟩ := hsep s
              refine ⟨c, (hM c).mpr ?_, hc2⟩
              show IsUnit (Algebra.TensorProduct.lmul' C c)
              rw [hc1]; exact isUnit_one
            | zero => exact ⟨1, M.one_mem, mul_zero 1⟩
            | add a b _ _ ha hb =>
              obtain ⟨c1, h1, e1⟩ := ha
              obtain ⟨c2, h2, e2⟩ := hb
              exact ⟨c1 * c2, M.mul_mem h1 h2, by linear_combination c2 * e1 + c1 * e2⟩
            | smul r a _ ha =>
              obtain ⟨c, h, e⟩ := ha
              exact ⟨c, h, by rw [smul_eq_mul, mul_left_comm, e, mul_zero]⟩
          obtain ⟨c, hc, e⟩ := key _ hker
          exact ⟨⟨c, hc⟩, by rw [mul_sub] at e; exact sub_eq_zero.mp e⟩
      exact IsLocalization.flat (LocallyConstant T C) M
    exact Algebra.WeaklyEtale.mk hflat hflatμ

  have s5 : ∀ (C : Type u) [CommRing C] (T : Type u) [TopologicalSpace T] [CompactSpace T] (P : Ideal (LocallyConstant T C)), P.IsPrime → ∃ t : T, ∀ ψ : LocallyConstant T C, ψ ∈ P ↔ ψ t ∈ Ideal.comap (algebraMap C (LocallyConstant T C)) P := by
    intro C _ T _ _ P hP
    classical
    have hchar : ∀ (U : Set T) (hU : IsClopen U) (u : T),
        LocallyConstant.charFn C hU u = if u ∈ U then 1 else 0 := by
      intro U hU u
      simp [LocallyConstant.coe_charFn, Set.indicator_apply]
    let S : Set (Set T) := {U | ∃ hU : IsClopen U, LocallyConstant.charFn C hU ∉ P}
    have h1 : (1 : LocallyConstant T C) ∉ P := fun h => hP.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    have huniv : Set.univ ∈ S := by
      refine ⟨isClopen_univ, ?_⟩
      have : LocallyConstant.charFn C (isClopen_univ (X := T)) = 1 := by
        ext u; rw [hchar]; simp
      rw [this]; exact h1
    haveI : Nonempty S := ⟨⟨_, huniv⟩⟩
    have hdir : DirectedOn (fun x1 x2 => x1 ⊇ x2) S := by
      rintro U ⟨hU, hUP⟩ V ⟨hV, hVP⟩
      refine ⟨U ∩ V, ⟨hU.inter hV, ?_⟩, Set.inter_subset_left, Set.inter_subset_right⟩
      have : LocallyConstant.charFn C (hU.inter hV) =
          LocallyConstant.charFn C hU * LocallyConstant.charFn C hV := by
        ext u; rw [LocallyConstant.mul_apply, hchar, hchar, hchar]
        by_cases a : u ∈ U <;> by_cases b : u ∈ V <;> simp [a, b]
      rw [this]
      intro h
      rcases hP.mem_or_mem h with h | h
      exacts [hUP h, hVP h]
    have hne : ∀ U ∈ S, U.Nonempty := by
      rintro U ⟨hU, hUP⟩
      by_contra h
      rw [Set.not_nonempty_iff_eq_empty] at h
      apply hUP
      have : LocallyConstant.charFn C hU = 0 := by
        ext u; rw [hchar]; simp [h]
      rw [this]; exact P.zero_mem
    obtain ⟨t, ht⟩ := IsCompact.nonempty_sInter_of_directed_nonempty_isCompact_isClosed hdir hne
      (fun U hU => by obtain ⟨hc, _⟩ := hU; exact hc.isClosed.isCompact)
      (fun U hU => by obtain ⟨hc, _⟩ := hU; exact hc.isClosed)
    have hkey : ∀ (U : Set T) (hU : IsClopen U), t ∈ U → LocallyConstant.charFn C hU ∉ P := by
      intro U hU htU hUP
      have hc : LocallyConstant.charFn C hU.compl ∉ P := by
        intro hc
        apply h1
        have : (1 : LocallyConstant T C) =
            LocallyConstant.charFn C hU + LocallyConstant.charFn C hU.compl := by
          ext u; rw [LocallyConstant.add_apply, hchar, hchar]
          by_cases a : u ∈ U <;> simp [a]
        rw [this]; exact P.add_mem hUP hc
      have : t ∈ Uᶜ := (Set.mem_sInter.mp ht) Uᶜ ⟨hU.compl, hc⟩
      exact this htU
    refine ⟨t, fun ψ => ?_⟩
    have hU : IsClopen {u | ψ u = ψ t} := ψ.isLocallyConstant.isClopen_fiber _
    have he := hkey _ hU rfl
    have hmul : ψ * LocallyConstant.charFn C hU =
        algebraMap C (LocallyConstant T C) (ψ t) * LocallyConstant.charFn C hU := by
      ext u; rw [LocallyConstant.mul_apply, LocallyConstant.mul_apply, hchar]
      split_ifs with h
      · rw [mul_one, mul_one]; exact h
      · rw [mul_zero, mul_zero]
    rw [Ideal.mem_comap]
    constructor
    · intro h
      have : algebraMap C (LocallyConstant T C) (ψ t) * LocallyConstant.charFn C hU ∈ P := by
        rw [← hmul]; exact P.mul_mem_right _ h
      exact (hP.mem_or_mem this).resolve_right he
    · intro h
      have : ψ * LocallyConstant.charFn C hU ∈ P := by
        rw [hmul]; exact P.mul_mem_right _ h
      exact (hP.mem_or_mem this).resolve_right he

  have s6 : ∀ (C : Type u) [CommRing C] (T : Type u) [TopologicalSpace T] [CompactSpace T] [T2Space T] [TotallyDisconnectedSpace T] (τ : T → PrimeSpectrum C), Continuous τ → ∀ (M : Submonoid (LocallyConstant T C)), (∀ ψ : LocallyConstant T C, ψ ∈ M ↔ ∀ t : T, ψ t ∉ (τ t).asIdeal) → ∀ (t : T) (p : Ideal C), Disjoint (M : Set (LocallyConstant T C)) (Ideal.comap (LocallyConstant.evalRingHom t) p : Set (LocallyConstant T C)) ↔ p ≤ (τ t).asIdeal := by
    intro C _ T _ _ _ _ τ hτ M hM t p
    classical
    constructor
    · intro hd
      by_contra hle
      obtain ⟨c, hcp, hct⟩ := Set.not_subset.mp hle
      have hV : IsOpen (τ ⁻¹' (PrimeSpectrum.basicOpen c : Set (PrimeSpectrum C))) :=
        (PrimeSpectrum.basicOpen c).isOpen.preimage hτ
      obtain ⟨U, hUc, htU, hUV⟩ := (isTopologicalBasis_isClopen (X := T)).exists_subset_of_mem_open
        (show t ∈ τ ⁻¹' (PrimeSpectrum.basicOpen c : Set (PrimeSpectrum C)) from hct) hV
      let ψ : LocallyConstant T C := algebraMap C (LocallyConstant T C) c *
        LocallyConstant.charFn C hUc + LocallyConstant.charFn C hUc.compl
      have hψ : ∀ u, ψ u = if u ∈ U then c else 1 := by
        intro u
        simp only [ψ, LocallyConstant.add_apply, LocallyConstant.mul_apply, LocallyConstant.coe_charFn,
          Set.indicator_apply, Set.mem_compl_iff, Pi.one_apply]
        split_ifs <;> simp [LocallyConstant.coe_algebraMap]
      have hψM : ψ ∈ M := by
        rw [hM]
        intro u hu
        rw [hψ] at hu
        split_ifs at hu with h
        · exact (hUV h) hu
        · exact (τ u).isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr hu)
      have hψP : ψ ∈ (Ideal.comap (LocallyConstant.evalRingHom t) p : Set (LocallyConstant T C)) := by
        show LocallyConstant.evalRingHom t ψ ∈ p
        rw [LocallyConstant.evalRingHom_apply, hψ, if_pos htU]
        exact hcp
      exact Set.disjoint_left.mp hd hψM hψP
    · intro hle
      rw [Set.disjoint_left]
      intro ψ hψM hψP
      exact (hM ψ).mp hψM t (hle hψP)

  have s7 : ∀ (C : Type u) [CommRing C] (T : Type u) [TopologicalSpace T] (t : T) (p : Ideal C) [p.IsPrime] (P : Ideal (LocallyConstant T C)) [P.IsPrime], (∀ ψ : LocallyConstant T C, ψ ∈ P ↔ ψ t ∈ p) → Nonempty (Localization.AtPrime p ≃+* Localization.AtPrime P) := by
    intro C _ T _ t p _ P _ hP
    classical
    have hev' : ∀ (c : C) (u : T), (algebraMap C (LocallyConstant T C) c) u = c := fun c u => rfl
    have hev : ∀ (c : C), (algebraMap C (LocallyConstant T C) c) t = c := fun c => rfl
    have hj : ∀ c : C, algebraMap C (Localization.AtPrime P) c =
        algebraMap (LocallyConstant T C) (Localization.AtPrime P) (algebraMap C (LocallyConstant T C) c) :=
      fun c => IsScalarTower.algebraMap_apply C (LocallyConstant T C) (Localization.AtPrime P) c
    haveI : IsLocalization p.primeCompl (Localization.AtPrime P) := by
      refine ⟨?_, ?_, ?_⟩
      · intro s
        rw [hj]
        apply IsLocalization.map_units (Localization.AtPrime P)
          (⟨algebraMap C (LocallyConstant T C) s, ?_⟩ : P.primeCompl)
        show _ ∉ P
        rw [hP, hev]
        exact s.2
      · intro z
        obtain ⟨⟨ψ, φ⟩, hz⟩ := IsLocalization.surj P.primeCompl z
        have hφ : (φ : LocallyConstant T C) t ∉ p := fun h => φ.2 ((hP _).mpr h)
        let U : Set T := {u | ψ u = ψ t} ∩ {u | (φ : LocallyConstant T C) u = (φ : LocallyConstant T C) t}
        have hU : IsClopen U := (ψ.isLocallyConstant.isClopen_fiber _).inter
          ((φ : LocallyConstant T C).isLocallyConstant.isClopen_fiber _)
        let e : LocallyConstant T C := LocallyConstant.charFn C hU
        have htU : t ∈ U := ⟨rfl, rfl⟩
        have he : ∀ u, e u = if u ∈ U then 1 else 0 := by
          intro u
          simp only [e, LocallyConstant.coe_charFn, Set.indicator_apply, Pi.one_apply]
        have heP : e ∉ P := by
          rw [hP, he, if_pos htU]
          exact fun h => (inferInstance : p.IsPrime).ne_top ((Ideal.eq_top_iff_one _).mpr h)
        have h1 : ψ * e = algebraMap C (LocallyConstant T C) (ψ t) * e := by
          ext u
          simp only [LocallyConstant.mul_apply, he]
          split_ifs with h
          · rw [mul_one, mul_one, hev']; exact h.1
          · rw [mul_zero, mul_zero]
        have h2 : (φ : LocallyConstant T C) * e =
            algebraMap C (LocallyConstant T C) ((φ : LocallyConstant T C) t) * e := by
          ext u
          simp only [LocallyConstant.mul_apply, he]
          split_ifs with h
          · rw [mul_one, mul_one, hev']; exact h.2
          · rw [mul_zero, mul_zero]
        have heu : IsUnit (algebraMap (LocallyConstant T C) (Localization.AtPrime P) e) :=
          IsLocalization.map_units (Localization.AtPrime P) (⟨e, heP⟩ : P.primeCompl)
        refine ⟨⟨ψ t, ⟨(φ : LocallyConstant T C) t, hφ⟩⟩, ?_⟩
        show z * algebraMap C (Localization.AtPrime P) ((φ : LocallyConstant T C) t) =
          algebraMap C (Localization.AtPrime P) (ψ t)
        rw [hj, hj]
        apply heu.mul_right_cancel
        rw [mul_assoc, ← map_mul, ← map_mul, ← h1, ← h2, map_mul, map_mul, ← mul_assoc, hz]
      · intro x y hxy
        rw [hj, hj] at hxy
        obtain ⟨c, hc⟩ := IsLocalization.exists_of_eq (M := P.primeCompl) hxy
        have hct : (c : LocallyConstant T C) t ∉ p := fun h => c.2 ((hP _).mpr h)
        refine ⟨⟨(c : LocallyConstant T C) t, hct⟩, ?_⟩
        have := congrArg (fun f : LocallyConstant T C => f t) hc
        simp only [LocallyConstant.mul_apply, hev] at this
        exact this
    exact ⟨(IsLocalization.algEquiv p.primeCompl (Localization.AtPrime p)
      (Localization.AtPrime P)).toRingEquiv⟩

  have s8a : ∀ (C : Type u) [CommRing C] (T : Type u) [TopologicalSpace T] [CompactSpace T] [T2Space T] [TotallyDisconnectedSpace T] (τ : T → PrimeSpectrum C), (∀ t : T, (τ t).asIdeal.IsMaximal) → IsClosed {x : PrimeSpectrum C | IsClosed ({x} : Set (PrimeSpectrum C))} → ∀ (M : Submonoid (LocallyConstant T C)), (∀ ψ : LocallyConstant T C, ψ ∈ M ↔ ∀ t : T, ψ t ∉ (τ t).asIdeal) → ∀ (D : Type u) [CommRing D] [Algebra (LocallyConstant T C) D] [IsLocalization M D], (∀ P : Ideal (LocallyConstant T C), P.IsPrime → ∃ t : T, ∀ ψ : LocallyConstant T C, ψ ∈ P ↔ ψ t ∈ Ideal.comap (algebraMap C (LocallyConstant T C)) P) → (∀ (t : T) (p : Ideal C), p.IsPrime → (Disjoint (M : Set (LocallyConstant T C)) (Ideal.comap (LocallyConstant.evalRingHom t) p : Set (LocallyConstant T C)) ↔ p ≤ (τ t).asIdeal)) → (∀ m : Ideal D, m.IsMaximal ↔ ∃ t : T, Ideal.comap (algebraMap (LocallyConstant T C) D) m = Ideal.comap (LocallyConstant.evalRingHom t) (τ t).asIdeal) ∧ IsClosed {x : PrimeSpectrum D | IsClosed ({x} : Set (PrimeSpectrum D))} ∧ (∀ x : PrimeSpectrum D, ∃! y : PrimeSpectrum D, IsClosed ({y} : Set (PrimeSpectrum D)) ∧ x ⤳ y) := by
    intro C _ T _ _ _ _ τ hτmax hcl M hM D _ _ _ hpt hdisj
    classical
    let A := LocallyConstant T C
    let j := algebraMap A D
    let P : T → Ideal C → Ideal A := fun t p => Ideal.comap (LocallyConstant.evalRingHom t) p
    have hPmem : ∀ t p (ψ : A), ψ ∈ P t p ↔ ψ t ∈ p := fun t p ψ => Iff.rfl
    have hPprime : ∀ t (p : Ideal C), p.IsPrime → (P t p).IsPrime := fun t p hp => Ideal.comap_isPrime _ _
    have hcomapι : ∀ t p, Ideal.comap (algebraMap C A) (P t p) = p := by
      intro t p; ext c; exact Iff.rfl
    have hsep : ∀ t t' : T, t ≠ t' → ∃ U : Set T, IsClopen U ∧ t ∈ U ∧ t' ∉ U := by
      intro t t' hne
      obtain ⟨U, hUc, htU, hUV⟩ := (isTopologicalBasis_isClopen (X := T)).exists_subset_of_mem_open
        (show t ∈ ({t'}ᶜ : Set T) from hne) isOpen_compl_singleton
      exact ⟨U, hUc, htU, fun h => hUV h rfl⟩
    have hord : ∀ t t' (p p' : Ideal C), p' ≠ ⊤ → P t p ≤ P t' p' → t = t' := by
      intro t t' p p' hp' hle
      by_contra hne
      obtain ⟨U, hUc, htU, ht'U⟩ := hsep t t' hne
      have h1 : LocallyConstant.charFn C hUc.compl ∈ P t p := by
        rw [hPmem, LocallyConstant.coe_charFn, Set.indicator_of_notMem (by simpa using htU)]
        exact p.zero_mem
      have h2 := hle h1
      rw [hPmem, LocallyConstant.coe_charFn, Set.indicator_of_mem (by simpa using ht'U)] at h2
      exact hp' ((Ideal.eq_top_iff_one _).mpr h2)
    have hnf : ∀ Q : Ideal D, Q.IsPrime → ∃ t p, p.IsPrime ∧ p ≤ (τ t).asIdeal ∧
        Ideal.comap j Q = P t p := by
      intro Q hQ
      have hQ' : (Ideal.comap j Q).IsPrime := Ideal.comap_isPrime _ _
      obtain ⟨t, ht⟩ := hpt _ hQ'
      set p := Ideal.comap (algebraMap C A) (Ideal.comap j Q) with hp
      have hpp : p.IsPrime := Ideal.comap_isPrime _ _
      have heq : Ideal.comap j Q = P t p := by
        ext ψ; rw [ht ψ]; exact Iff.rfl
      have hd : Disjoint (M : Set A) (Ideal.comap j Q : Set A) :=
        (IsLocalization.disjoint_comap_iff M D Q).mpr hQ.ne_top
      rw [heq] at hd
      exact ⟨t, p, hpp, (hdisj t p hpp).mp hd, heq⟩
    have hPt_disj : ∀ t, Disjoint (M : Set A) (P t (τ t).asIdeal : Set A) := fun t =>
      (hdisj t _ (hτmax t).isPrime).mpr le_rfl
    have hQprime : ∀ t, (Ideal.map j (P t (τ t).asIdeal)).IsPrime := fun t =>
      IsLocalization.isPrime_of_isPrime_disjoint M D _ (hPprime t _ (hτmax t).isPrime) (hPt_disj t)
    have hQcomap : ∀ t, Ideal.comap j (Ideal.map j (P t (τ t).asIdeal)) = P t (τ t).asIdeal := fun t =>
      IsLocalization.comap_map_of_isPrime_disjoint M D (hPprime t _ (hτmax t).isPrime) (hPt_disj t)
    have hmapcomap : ∀ Q : Ideal D, Ideal.map j (Ideal.comap j Q) = Q := fun Q =>
      IsLocalization.map_comap M D Q
    have hmax1 : ∀ m : Ideal D, m.IsMaximal → ∃ t, Ideal.comap j m = P t (τ t).asIdeal := by
      intro m hm
      obtain ⟨t, p, hp, hpt', heq⟩ := hnf m hm.isPrime
      have hle : m ≤ Ideal.map j (P t (τ t).asIdeal) := by
        rw [← hmapcomap m, heq]
        exact Ideal.map_mono (Ideal.comap_mono hpt')
      have := hm.eq_of_le (hQprime t).ne_top hle
      exact ⟨t, by rw [this, hQcomap]⟩
    have hQmax : ∀ t, (Ideal.map j (P t (τ t).asIdeal)).IsMaximal := by
      intro t
      obtain ⟨m', hm', hle⟩ := Ideal.exists_le_maximal _ (hQprime t).ne_top
      obtain ⟨t', ht'⟩ := hmax1 m' hm'
      have h1 : P t (τ t).asIdeal ≤ P t' (τ t').asIdeal := by
        rw [← hQcomap t, ← ht']; exact Ideal.comap_mono hle
      have htt := hord t t' _ _ (hτmax t').ne_top h1
      subst htt
      have : m' = Ideal.map j (P t (τ t).asIdeal) := by rw [← hmapcomap m', ht']
      rw [← this]; exact hm'
    have hmax : ∀ m : Ideal D, m.IsMaximal ↔ ∃ t : T, Ideal.comap j m = P t (τ t).asIdeal := by
      intro m
      refine ⟨hmax1 m, ?_⟩
      rintro ⟨t, ht⟩
      have : m = Ideal.map j (P t (τ t).asIdeal) := by rw [← hmapcomap m, ht]
      rw [this]; exact hQmax t
    refine ⟨hmax, ?_, ?_⟩
    · set J := PrimeSpectrum.vanishingIdeal {x : PrimeSpectrum C | IsClosed ({x} : Set (PrimeSpectrum C))}
      have hκ : ∀ Q : Ideal D, Ideal.comap (j.comp (algebraMap C A)) Q = Ideal.comap (algebraMap C A) (Ideal.comap j Q) := by
        intro Q
        rw [← Ideal.comap_comap]
      have hset : {x : PrimeSpectrum D | IsClosed ({x} : Set (PrimeSpectrum D))} =
          PrimeSpectrum.zeroLocus (Ideal.map (j.comp (algebraMap C A)) J : Set D) := by
        ext x
        rw [Set.mem_setOf_eq, PrimeSpectrum.mem_zeroLocus, SetLike.coe_subset_coe,
          Ideal.map_le_iff_le_comap, PrimeSpectrum.isClosed_singleton_iff_isMaximal]
        constructor
        · intro hx
          obtain ⟨t, ht⟩ := hmax1 _ hx
          rw [hκ, ht, hcomapι]
          intro f hf
          exact (PrimeSpectrum.mem_vanishingIdeal _ f).mp hf (τ t)
            ((PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr (hτmax t))
        · intro hJ
          obtain ⟨t, p, hp, hpt', heq⟩ := hnf x.asIdeal x.isPrime
          rw [hκ, heq, hcomapι] at hJ
          have hpX : (⟨p, hp⟩ : PrimeSpectrum C) ∈ {x : PrimeSpectrum C | IsClosed ({x} : Set (PrimeSpectrum C))} := by
            have : (⟨p, hp⟩ : PrimeSpectrum C) ∈ PrimeSpectrum.zeroLocus (J : Set C) := hJ
            rwa [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hcl.closure_eq] at this
          have hpmax : p.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hpX
          have hpe : p = (τ t).asIdeal := hpmax.eq_of_le (hτmax t).ne_top hpt'
          exact (hmax _).mpr ⟨t, by rw [heq, hpe]⟩
      rw [hset]
      exact PrimeSpectrum.isClosed_zeroLocus _
    · intro x
      obtain ⟨t, p, hp, hpt', heq⟩ := hnf x.asIdeal x.isPrime
      refine ⟨⟨_, hQprime t⟩, ⟨(PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr (hQmax t), ?_⟩, ?_⟩
      · rw [← PrimeSpectrum.le_iff_specializes]
        show x.asIdeal ≤ Ideal.map j (P t (τ t).asIdeal)
        rw [← hmapcomap x.asIdeal, heq]
        exact Ideal.map_mono (Ideal.comap_mono hpt')
      · rintro y ⟨hy, hxy⟩
        rw [← PrimeSpectrum.le_iff_specializes] at hxy
        have hym := (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hy
        obtain ⟨t', ht'⟩ := hmax1 _ hym
        have h1 : P t p ≤ P t' (τ t').asIdeal := by
          rw [← heq, ← ht']; exact Ideal.comap_mono hxy
        have htt := hord t t' _ _ (hτmax t').ne_top h1
        subst htt
        apply PrimeSpectrum.ext
        rw [← hmapcomap y.asIdeal, ht']

  have s8b : ∀ (C : Type u) [CommRing C] (T : Type u) [TopologicalSpace T] [CompactSpace T] [T2Space T] [ExtremallyDisconnected T] (τ : T → PrimeSpectrum C), Continuous τ → ∀ (M : Submonoid (LocallyConstant T C)), (∀ ψ : LocallyConstant T C, ψ ∈ M ↔ ∀ t : T, ψ t ∉ (τ t).asIdeal) → ∀ (D : Type u) [CommRing D] [Algebra (LocallyConstant T C) D] [IsLocalization M D], (∀ m : Ideal D, m.IsMaximal ↔ ∃ t : T, Ideal.comap (algebraMap (LocallyConstant T C) D) m = Ideal.comap (LocallyConstant.evalRingHom t) (τ t).asIdeal) → ExtremallyDisconnected {x : PrimeSpectrum D | IsClosed ({x} : Set (PrimeSpectrum D))} := by
    intro C _ T _ _ _ _ τ hτ M hM D _ _ _ hmax
    classical
    let A := LocallyConstant T C
    let j := algebraMap A D
    let X0 := {x : PrimeSpectrum D | IsClosed ({x} : Set (PrimeSpectrum D))}
    let P : T → Ideal A := fun t => Ideal.comap (LocallyConstant.evalRingHom t) (τ t).asIdeal
    have hPmem : ∀ t (ψ : A), ψ ∈ P t ↔ ψ t ∈ (τ t).asIdeal := fun t ψ => Iff.rfl
    have hPprime : ∀ t, (P t).IsPrime := fun t => Ideal.comap_isPrime _ _
    have hPd : ∀ t, Disjoint (M : Set A) (P t : Set A) := by
      intro t
      rw [Set.disjoint_left]
      intro ψ hψM hψP
      exact (hM ψ).mp hψM t hψP
    have hQprime : ∀ t, (Ideal.map j (P t)).IsPrime := fun t =>
      IsLocalization.isPrime_of_isPrime_disjoint M D _ (hPprime t) (hPd t)
    have hQcomap : ∀ t, Ideal.comap j (Ideal.map j (P t)) = P t := fun t =>
      IsLocalization.comap_map_of_isPrime_disjoint M D (hPprime t) (hPd t)
    have hmapcomap : ∀ Q : Ideal D, Ideal.map j (Ideal.comap j Q) = Q := fun Q =>
      IsLocalization.map_comap M D Q
    have hmemQ : ∀ t (ψ : A), j ψ ∈ Ideal.map j (P t) ↔ ψ t ∈ (τ t).asIdeal := by
      intro t ψ
      have h := hQcomap t
      constructor
      · intro hψ
        have h2 : ψ ∈ Ideal.comap j (Ideal.map j (P t)) := hψ
        rw [h] at h2
        exact h2
      · intro hψ
        have h2 : ψ ∈ Ideal.comap j (Ideal.map j (P t)) := by rw [h]; exact hψ
        exact h2
    have hsep : ∀ t t' : T, t ≠ t' → ∃ U : Set T, IsClopen U ∧ t ∈ U ∧ t' ∉ U := by
      intro t t' hne
      obtain ⟨U, hUc, htU, hUV⟩ := (isTopologicalBasis_isClopen (X := T)).exists_subset_of_mem_open
        (show t ∈ ({t'}ᶜ : Set T) from hne) isOpen_compl_singleton
      exact ⟨U, hUc, htU, fun h => hUV h rfl⟩
    have hchar : ∀ (U : Set T) (hU : IsClopen U) (u : T),
        LocallyConstant.charFn C hU u = if u ∈ U then 1 else 0 := by
      intro U hU u
      simp [LocallyConstant.coe_charFn, Set.indicator_apply]
    have h1nm : ∀ t, (1 : C) ∉ (τ t).asIdeal := fun t h =>
      (τ t).isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h)
    let Qp : T → PrimeSpectrum D := fun t => ⟨Ideal.map j (P t), hQprime t⟩
    have hQcl : ∀ t, Qp t ∈ X0 := fun t =>
      (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr ((hmax _).mpr ⟨t, hQcomap t⟩)
    let θ : T → X0 := fun t => ⟨Qp t, hQcl t⟩
    have hbas : ∀ (d : D), ∃ ψ : A, ∀ t, (θ t).1 ∈ PrimeSpectrum.basicOpen d ↔ ψ t ∉ (τ t).asIdeal := by
      intro d
      obtain ⟨⟨ψ, s⟩, hs⟩ := IsLocalization.surj M d
      refine ⟨ψ, fun t => ?_⟩
      have hsu : j s ∉ Ideal.map j (P t) := by
        rw [hmemQ]; exact (hM s).mp s.2 t
      show d ∉ Ideal.map j (P t) ↔ _
      rw [← hmemQ]
      simp only at hs
      rw [← hs]
      constructor
      · intro hd hmul
        rcases (hQprime t).mem_or_mem hmul with h | h
        exacts [hd h, hsu h]
      · intro h hd
        exact h (Ideal.mul_mem_right _ _ hd)
    have hθc : Continuous θ := by
      apply Continuous.subtype_mk
      rw [PrimeSpectrum.isTopologicalBasis_basic_opens.continuous_iff]
      rintro _ ⟨d, rfl⟩
      obtain ⟨ψ, hψ⟩ := hbas d
      have : (fun t => (θ t).1) ⁻¹' (PrimeSpectrum.basicOpen d : Set (PrimeSpectrum D)) =
          {t | ψ t ∉ (τ t).asIdeal} := by
        ext t; exact hψ t
      rw [this, isOpen_iff_forall_mem_open]
      intro t₀ ht₀
      refine ⟨{u | ψ u = ψ t₀} ∩ τ ⁻¹' (PrimeSpectrum.basicOpen (ψ t₀) : Set (PrimeSpectrum C)), ?_,
        ((ψ.isLocallyConstant.isOpen_fiber _).inter
          ((PrimeSpectrum.basicOpen (ψ t₀)).isOpen.preimage hτ)), ⟨rfl, ht₀⟩⟩
      rintro u ⟨hu1, hu2⟩
      show ψ u ∉ (τ u).asIdeal
      rw [Set.mem_setOf_eq.mp hu1]
      exact hu2
    have hθinj : Function.Injective θ := by
      intro t t' h
      by_contra hne
      obtain ⟨U, hUc, htU, ht'U⟩ := hsep t t' hne
      have hQ : Ideal.map j (P t) = Ideal.map j (P t') :=
        congrArg (fun x : X0 => x.1.asIdeal) h
      have e1 : j (LocallyConstant.charFn C hUc) ∈ Ideal.map j (P t') := by
        rw [hmemQ, hchar, if_neg ht'U]; exact Ideal.zero_mem _
      rw [← hQ, hmemQ, hchar, if_pos htU] at e1
      exact h1nm t e1
    have hθsurj : Function.Surjective θ := by
      rintro ⟨x, hx⟩
      have hxm := (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hx
      obtain ⟨t, ht⟩ := (hmax _).mp hxm
      refine ⟨t, Subtype.ext (PrimeSpectrum.ext ?_)⟩
      show Ideal.map j (P t) = x.asIdeal
      have ht' : Ideal.comap j x.asIdeal = P t := ht
      rw [← ht', hmapcomap]
    haveI hT2X : T2Space X0 := by
      refine ⟨fun x y hxy => ?_⟩
      obtain ⟨t, rfl⟩ := hθsurj x
      obtain ⟨t', rfl⟩ := hθsurj y
      have hne : t ≠ t' := fun h => hxy (h ▸ rfl)
      obtain ⟨U, hUc, htU, ht'U⟩ := hsep t t' hne
      refine ⟨Subtype.val ⁻¹' (PrimeSpectrum.basicOpen (j (LocallyConstant.charFn C hUc)) :
          Set (PrimeSpectrum D)),
        Subtype.val ⁻¹' (PrimeSpectrum.basicOpen (j (LocallyConstant.charFn C hUc.compl)) :
          Set (PrimeSpectrum D)),
        (PrimeSpectrum.basicOpen _).isOpen.preimage continuous_subtype_val,
        (PrimeSpectrum.basicOpen _).isOpen.preimage continuous_subtype_val, ?_, ?_, ?_⟩
      · show j (LocallyConstant.charFn C hUc) ∉ Ideal.map j (P t)
        rw [hmemQ, hchar, if_pos htU]; exact h1nm t
      · show j (LocallyConstant.charFn C hUc.compl) ∉ Ideal.map j (P t')
        rw [hmemQ, hchar, if_pos (show t' ∈ Uᶜ from ht'U)]; exact h1nm t'
      · rw [Set.disjoint_left]
        intro z hz1 hz2
        have h1 : j (LocallyConstant.charFn C hUc) ∉ z.1.asIdeal := hz1
        have h2 : j (LocallyConstant.charFn C hUc.compl) ∉ z.1.asIdeal := hz2
        have h0 : LocallyConstant.charFn C hUc * LocallyConstant.charFn C hUc.compl = 0 := by
          ext u
          rw [LocallyConstant.mul_apply, hchar, hchar]
          by_cases a : u ∈ U <;> simp [a]
        have : j (LocallyConstant.charFn C hUc) * j (LocallyConstant.charFn C hUc.compl) ∈ z.1.asIdeal := by
          rw [← map_mul, h0, map_zero]; exact Ideal.zero_mem _
        rcases z.1.isPrime.mem_or_mem this with h | h
        exacts [h1 h, h2 h]
    let h : T ≃ₜ X0 := Continuous.homeoOfEquivCompactToT2 (f := Equiv.ofBijective θ ⟨hθinj, hθsurj⟩) hθc
    refine ⟨fun U hU => ?_⟩
    have e : closure U = h '' closure (h ⁻¹' U) := by
      rw [Homeomorph.image_closure, Set.image_preimage_eq _ h.surjective]
    rw [e, Homeomorph.isOpen_image]
    exact ExtremallyDisconnected.open_closure _ (hU.preimage h.continuous)

  intro C _ hcl _
  classical
  obtain ⟨hcpt, ht2⟩ := s1 C hcl
  haveI := hcpt
  haveI := ht2

  obtain ⟨T, _, hTc, hT2, hTed, τ₀, hτ₀c, hτ₀s⟩ : ∃ (T : Type u) (_ : TopologicalSpace T),
      CompactSpace T ∧ T2Space T ∧ ExtremallyDisconnected T ∧
      ∃ τ : T → {x : PrimeSpectrum C | IsClosed ({x} : Set (PrimeSpectrum C))},
        Continuous τ ∧ Function.Surjective τ := by
    let X0 : CompHaus := CompHaus.of {x : PrimeSpectrum C | IsClosed ({x} : Set (PrimeSpectrum C))}
    refine ⟨X0.presentation, inferInstance, inferInstance, inferInstance, inferInstance,
      ⇑(ConcreteCategory.hom (CompHaus.presentation.π X0)),
      (ConcreteCategory.hom (CompHaus.presentation.π X0)).continuous, ?_⟩
    exact (CompHaus.epi_iff_surjective (CompHaus.presentation.π X0)).mp inferInstance
  haveI := hTc
  haveI := hT2
  haveI := hTed
  obtain ⟨τ, hτc, hτmax, hτsurj⟩ : ∃ τ : T → PrimeSpectrum C, Continuous τ ∧
      (∀ t, (τ t).asIdeal.IsMaximal) ∧ ∀ m : Ideal C, m.IsMaximal → ∃ t, (τ t).asIdeal = m := by
    refine ⟨fun t => (τ₀ t).1, continuous_subtype_val.comp hτ₀c,
      fun t => (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp (τ₀ t).2, fun m hm => ?_⟩
    obtain ⟨t, ht⟩ := hτ₀s ⟨⟨m, hm.isPrime⟩, (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr hm⟩
    exact ⟨t, congrArg (fun x : {x : PrimeSpectrum C | IsClosed ({x} : Set (PrimeSpectrum C))} =>
      x.1.asIdeal) ht⟩
  let M : Submonoid (LocallyConstant T C) :=
    { carrier := {ψ | ∀ t, ψ t ∉ (τ t).asIdeal}
      one_mem' := by
        intro t h
        exact (τ t).isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h)
      mul_mem' := by
        intro a b ha hb t h
        rcases (τ t).isPrime.mem_or_mem h with h | h
        exacts [ha t h, hb t h] }
  have hM : ∀ ψ : LocallyConstant T C, ψ ∈ M ↔ ∀ t : T, ψ t ∉ (τ t).asIdeal := fun ψ => Iff.rfl
  have hdisj := s6 C T τ hτc M hM
  obtain ⟨hmax, hclD, huniqD⟩ := s8a C T τ hτmax hcl M hM (Localization M)
    (s5 C T) (fun t p _ => hdisj t p)
  have hed := s8b C T τ hτc M hM (Localization M) hmax
  refine ⟨Localization M, inferInstance, inferInstance, ?_, ?_, hclD, huniqD, hed, ?_⟩
  ·
    have toSch : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
        Algebra.WeaklyEtale R' S' → WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
      intro R' S' _ _ _ hW
      have hfl : Flat (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
          RingHom.flat_algebraMap_iff]
        exact hW.flat
      have hmu : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom]
        exact hW.flat_lmul'
      have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R' S')))) := by
        rw [diagonal_SpecMap]
        infer_instance
      exact ⟨hfl, hd⟩
    have toRing : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
        WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) → Algebra.WeaklyEtale R' S' := by
      intro R' S' _ _ _ hW
      have hfl : Module.Flat R' S' := by
        have := hW.flat
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
          RingHom.flat_algebraMap_iff] at this
        exact this
      have hd := hW.flat_diagonal
      rw [diagonal_SpecMap] at hd
      have hmu : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
        have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) =
            (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) ≫
              (pullbackSpecIso R' S' S').inv) ≫ (pullbackSpecIso R' S' S').hom := by
          rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
        rw [e]
        haveI := hd
        infer_instance
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hmu
      exact Algebra.WeaklyEtale.mk hfl hmu
    haveI h1 : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap C (LocallyConstant T C)))) :=
      toSch _ _ (s3 C T)
    haveI h2 : WeaklyEtale (Spec.map (CommRingCat.ofHom
        (algebraMap (LocallyConstant T C) (Localization M)))) :=
      toSch _ _ (by
        haveI hc : TensorProduct.CompatibleSMul (LocallyConstant T C) (Localization M) (Localization M)
            (Localization M) :=
          IsLocalization.tensorProduct_compatibleSMul M (Localization M) (Localization M) (Localization M)
        have key : ∀ z : TensorProduct (LocallyConstant T C) (Localization M) (Localization M),
            z = (Algebra.TensorProduct.lmul' (LocallyConstant T C) (S := Localization M) z) ⊗ₜ[LocallyConstant T C]
              (1 : Localization M) := by
          intro z
          induction z using TensorProduct.induction_on with
          | zero => rw [map_zero, TensorProduct.zero_tmul]
          | tmul a b =>
            rw [Algebra.TensorProduct.lmul'_apply_tmul]
            have h := TensorProduct.smul_tmul (R := LocallyConstant T C) b a (1 : Localization M)
            rw [smul_eq_mul, smul_eq_mul, mul_one, mul_comm b a] at h
            exact h.symm
          | add x y hx hy =>
            rw [map_add, TensorProduct.add_tmul, ← hx, ← hy]
        have hbij : Function.Bijective
            (Algebra.TensorProduct.lmul' (LocallyConstant T C) (S := Localization M)) := by
          refine ⟨fun z₁ z₂ h => ?_, fun c => ⟨c ⊗ₜ[LocallyConstant T C] (1 : Localization M), ?_⟩⟩
          · rw [key z₁, key z₂, h]
          · rw [Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
        refine Algebra.WeaklyEtale.mk (IsLocalization.flat (Localization M) M) ?_
        exact RingHom.Flat.of_bijective hbij)
    have hcomp : Spec.map (CommRingCat.ofHom (algebraMap (LocallyConstant T C) (Localization M))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap C (LocallyConstant T C))) =
        Spec.map (CommRingCat.ofHom (algebraMap C (Localization M))) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]
    apply toRing
    rw [← hcomp]
    infer_instance
  ·
    intro p
    obtain ⟨m, hm, hpm⟩ := Ideal.exists_le_maximal p.asIdeal p.isPrime.ne_top
    obtain ⟨t, ht⟩ := hτsurj m hm
    let P : Ideal (LocallyConstant T C) := Ideal.comap (LocallyConstant.evalRingHom t) p.asIdeal
    have hPp : P.IsPrime := Ideal.comap_isPrime _ _
    have hPd : Disjoint (M : Set (LocallyConstant T C)) (P : Set (LocallyConstant T C)) :=
      (hdisj t p.asIdeal).mpr (by rw [ht]; exact hpm)
    have hQ := IsLocalization.isPrime_of_isPrime_disjoint M (Localization M) P hPp hPd
    refine ⟨⟨Ideal.map (algebraMap (LocallyConstant T C) (Localization M)) P, hQ⟩, ?_⟩
    apply PrimeSpectrum.ext
    have e : Ideal.comap (algebraMap (LocallyConstant T C) (Localization M))
        (Ideal.map (algebraMap (LocallyConstant T C) (Localization M)) P) = P :=
      IsLocalization.comap_map_of_isPrime_disjoint M (Localization M) hPp hPd
    show Ideal.comap (algebraMap C (Localization M))
      (Ideal.map (algebraMap (LocallyConstant T C) (Localization M)) P) = p.asIdeal
    rw [IsScalarTower.algebraMap_eq C (LocallyConstant T C) (Localization M), ← Ideal.comap_comap, e]
    ext c
    exact Iff.rfl
  ·
    intro m hm
    obtain ⟨t, ht⟩ := (hmax m).mp hm
    have hcomapC : Ideal.comap (algebraMap C (Localization M)) m = (τ t).asIdeal := by
      rw [IsScalarTower.algebraMap_eq C (LocallyConstant T C) (Localization M), ← Ideal.comap_comap, ht]
      ext c
      exact Iff.rfl
    refine ⟨by rw [hcomapC]; exact hτmax t, ?_⟩
    obtain ⟨e1⟩ := s7 C T t (Ideal.comap (algebraMap C (Localization M)) m)
      (Ideal.comap (algebraMap (LocallyConstant T C) (Localization M)) m)
      (fun ψ => by rw [ht, hcomapC]; exact Iff.rfl)
    exact ⟨e1.trans (IsLocalization.localizationLocalizationAtPrimeIsoLocalization M m).toRingEquiv⟩

theorem wc_exists_wcontractible_cover : ∀ (V : Scheme.{u}), IsAffine V → ∃ (Δ : Scheme.{u}) (δ : Δ ⟶ V), IsAffine Δ ∧ WeaklyEtale δ ∧ Surjective δ ∧ IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ∧ (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ∧ ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} ∧ (∀ x : Δ, IsClosed ({x} : Set Δ) → HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x)) :=
by
  classical

  have hev : ∀ {R S : Type u} [CommRing R] [CommRing S] (σ : S ≃+* R) (p : Polynomial S) (y : S),
      (p.map (σ : S →+* R)).eval (σ y) = σ (p.eval y) := by
    intro R S _ _ σ p y
    rw [Polynomial.eval_map]
    exact Polynomial.eval₂_at_apply (σ : S →+* R) y
  have s9 : ∀ (R S : Type u) [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S] (e : R ≃+* S),
      HenselianLocalRing R → IsSepClosed (IsLocalRing.ResidueField R) →
      HenselianLocalRing S ∧ IsSepClosed (IsLocalRing.ResidueField S) := by
    intro R S _ _ _ _ e hR hk
    constructor
    · refine HenselianLocalRing.mk ?_
      intro f hf a₀ h1 h2
      have hunit : ∀ y : S, IsUnit (e.symm y) ↔ IsUnit y := fun y =>
        ⟨fun h => by simpa using h.map e, fun h => h.map e.symm⟩
      have hmem : ∀ y : S, e.symm y ∈ IsLocalRing.maximalIdeal R ↔
          y ∈ IsLocalRing.maximalIdeal S := by
        intro y
        rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
          mem_nonunits_iff, hunit]
      obtain ⟨a, ha, ha'⟩ := HenselianLocalRing.is_henselian (f.map (e.symm : S →+* R))
        (hf.map _) (e.symm a₀)
        (by rw [hev]; exact (hmem _).mpr h1)
        (by rw [Polynomial.derivative_map, hev]; exact (hunit _).mpr h2)
      refine ⟨e a, ?_, ?_⟩
      · have h3 : e.symm (f.eval (e a)) = 0 := by
          rw [← hev, RingEquiv.symm_apply_apply]; exact ha
        have h4 : f.eval (e a) = 0 := by simpa using h3
        exact h4
      · rw [← hmem, map_sub, RingEquiv.symm_apply_apply]; exact ha'
    · haveI := hk
      refine IsSepClosed.of_exists_root _ ?_
      intro p _ hpi hps
      have hdeg : (p.map ((IsLocalRing.ResidueField.mapEquiv e).symm :
          IsLocalRing.ResidueField S →+* IsLocalRing.ResidueField R)).degree ≠ 0 := by
        rw [Polynomial.degree_map]; exact (Polynomial.degree_pos_of_irreducible hpi).ne'
      obtain ⟨x, hx⟩ := IsSepClosed.exists_root _ hdeg hps.map
      refine ⟨IsLocalRing.ResidueField.mapEquiv e x, ?_⟩
      have h3 : (IsLocalRing.ResidueField.mapEquiv e).symm
          (p.eval (IsLocalRing.ResidueField.mapEquiv e x)) = 0 := by
        rw [← hev, RingEquiv.symm_apply_apply]; exact hx
      simpa using h3

  have toSch : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
      Algebra.WeaklyEtale R' S' → WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
    intro R' S' _ _ _ hW
    have hfl : Flat (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff]
      exact hW.flat
    have hmu : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom]
      exact hW.flat_lmul'
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R' S')))) := by
      rw [diagonal_SpecMap]
      infer_instance
    exact ⟨hfl, hd⟩
  have ind_we : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S],
      wcIndEtale (algebraMap R S) → WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
    intro R S _ _ _ h
    have h' := wc_indEtale_weaklyEtale (algebraMap R S) h
    rw [show (algebraMap R S).toAlgebra = ‹Algebra R S› from
      Algebra.algebra_ext _ _ (fun _ => rfl)] at h'
    exact toSch R S h'
  intro V hV
  haveI := hV

  obtain ⟨Aw, _, _, I, hAind, hAsurj, hAclosed, -, -⟩ := wc_wcc_wlocalization Γ(V, ⊤)
  obtain ⟨C', _, _, hC'ff, hC'ind, hC'ret⟩ := wc_retCover_exists Aw
  obtain ⟨C'', _, _, I'', hC''ind, hC''surj, -, hC''wloc, hC''loc⟩ := wc_wcc_wlocalization C'
  have hAmax : ∀ p : Ideal Aw, p.IsPrime → I ≤ p → p.IsMaximal := by
    intro p hp hIp
    exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal ⟨p, hp⟩).mp ((hAclosed ⟨p, hp⟩).mpr hIp)
  have hC'max : ∀ q : Ideal C', q.IsPrime → Ideal.map (algebraMap Aw C') I ≤ q → q.IsMaximal := by
    intro q hq hq'
    exact wc_wcc_indEtale_closed_fibre_maximal Aw C' hC'ind I hAmax q hq
      (Ideal.map_le_iff_le_comap.mp hq')
  have hC''max : ∀ q : Ideal C'', q.IsPrime →
      Ideal.map (algebraMap C' C'') (Ideal.map (algebraMap Aw C') I) ≤ q → q.IsMaximal := by
    intro q hq hq'
    exact wc_wcc_indEtale_closed_fibre_maximal C' C'' hC''ind _ hC'max q hq
      (Ideal.map_le_iff_le_comap.mp hq')
  obtain ⟨D', _, _, M, hMloc, hD'range, hD'cl, hD'wloc, hD'loc⟩ :=
    wc_wcc_jacobson_localize C'' (Ideal.map (algebraMap C' C'') (Ideal.map (algebraMap Aw C') I))
      hC''wloc hC''max
  obtain ⟨D, _, _, hDwe, hDsurj, hDcl, hDwloc, hDext, hDloc⟩ :=
    wc_wcc_extremal_refine D' hD'cl hD'wloc

  have hD'sh : ∀ (m : Ideal D') [m.IsMaximal], HenselianLocalRing (Localization.AtPrime m) ∧
      IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime m)) := by
    intro m _
    obtain ⟨hJm, ⟨e1⟩⟩ := hD'loc m
    haveI hm''max : (Ideal.comap (algebraMap C'' D') m).IsMaximal :=
      hC''max _ inferInstance hJm
    obtain ⟨e2⟩ := hC''loc (Ideal.comap (algebraMap C'' D') m)
    haveI hq'max : (Ideal.comap (algebraMap C' C'') (Ideal.comap (algebraMap C'' D') m)).IsMaximal :=
      hC'max _ inferInstance (Ideal.map_le_iff_le_comap.mp hJm)
    obtain ⟨h1, h2⟩ := wc_ret_stalk_strictlyHenselian C' hC'ret
      (Ideal.comap (algebraMap C' C'') (Ideal.comap (algebraMap C'' D') m))
    obtain ⟨h3, h4⟩ := s9 _ _ e2 h1 h2
    exact s9 _ _ e1 h3 h4
  have hDsh : ∀ (n : Ideal D) [n.IsMaximal], HenselianLocalRing (Localization.AtPrime n) ∧
      IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime n)) := by
    intro n _
    obtain ⟨hmax, ⟨e⟩⟩ := hDloc n
    haveI := hmax
    obtain ⟨h1, h2⟩ := hD'sh (Ideal.comap (algebraMap D' D) n)
    exact s9 _ _ e h1 h2

  obtain ⟨Φ, hΦdef⟩ : ∃ Φ : Γ(V, ⊤) →+* D, Φ = (algebraMap D' D).comp ((algebraMap C'' D').comp
      ((algebraMap C' C'').comp ((algebraMap Aw C').comp (algebraMap Γ(V, ⊤) Aw)))) := ⟨_, rfl⟩
  haveI w1 := ind_we _ _ hAind
  haveI w2 := ind_we _ _ hC'ind
  haveI w3 := ind_we _ _ hC''ind
  haveI w4 := toSch C'' D' (wc_localization_weaklyEtale C'' D' M)
  haveI w5 := toSch D' D hDwe
  haveI hWΦ : WeaklyEtale (Spec.map (CommRingCat.ofHom Φ)) := by
    rw [hΦdef]
    simp only [CommRingCat.ofHom_comp, Spec.map_comp]
    infer_instance
  have hsurjΦ : Function.Surjective (PrimeSpectrum.comap Φ) := by
    intro p
    obtain ⟨q, hIq, hqp⟩ := hAsurj p
    obtain ⟨q', hq'⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := Aw) (B := C') q
    obtain ⟨q'', -, hq''⟩ := hC''surj q'
    have hJq'' : Ideal.map (algebraMap C' C'') (Ideal.map (algebraMap Aw C') I) ≤ q''.asIdeal := by
      rw [Ideal.map_le_iff_le_comap, Ideal.map_le_iff_le_comap]
      have e1 : Ideal.comap (algebraMap C' C'') q''.asIdeal = q'.asIdeal := by rw [← hq'']; rfl
      have e2 : Ideal.comap (algebraMap Aw C') q'.asIdeal = q.asIdeal := by rw [← hq']; rfl
      rw [e1, e2]; exact hIq
    obtain ⟨d', hd'⟩ := hD'range q'' hJq''
    obtain ⟨d, hd⟩ := hDsurj d'
    refine ⟨d, ?_⟩
    rw [hΦdef]
    simp only [PrimeSpectrum.comap_comp_apply, hd, hd', hq'', hq', hqp]
  haveI hSΦ : Surjective (Spec.map (CommRingCat.ofHom Φ)) := ⟨hsurjΦ⟩

  refine ⟨Spec (CommRingCat.of D), Spec.map (CommRingCat.ofHom Φ) ≫ V.isoSpec.inv, inferInstance,
    inferInstance, inferInstance, hDcl, hDwloc, hDext, ?_⟩
  intro x hx
  let x' : PrimeSpectrum D := x
  have hx' : IsClosed ({x'} : Set (PrimeSpectrum D)) := hx
  haveI : x'.asIdeal.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal x').mp hx'
  obtain ⟨h1, h2⟩ := hDsh x'.asIdeal
  exact s9 (Localization.AtPrime x'.asIdeal) ((Spec (CommRingCat.of D)).presheaf.stalk x)
    (Spec.stalkIso (CommRingCat.of D) x').commRingCatIsoToRingEquiv.symm h1 h2

theorem wc_proet_cover_of_affine_local : ∀ (Q : Scheme.{u} → Prop), (∀ (V : Scheme.{u}), IsAffine V → ∃ (Δ : Scheme.{u}) (δ : Δ ⟶ V), IsAffine Δ ∧ WeaklyEtale δ ∧ Surjective δ ∧ Q Δ) → ∀ {S : Scheme.{u}} (V : S.ProEt), Sieve.generate (fun (W : S.ProEt) (_ : W ⟶ V) => IsAffine W.left ∧ Q W.left) ∈ Scheme.ProEt.topology S V :=
by
  intro Q hQ S V
  classical
  choose Δ δ hΔa hδw hδs hΔQ using
    fun i : V.left.affineCover.I₀ => hQ (V.left.affineCover.X i) inferInstance
  have hcov := Precoverage.comp_mem_coverings (J := Scheme.proetalePrecoverage)
    V.left.affineCover.f
    ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage V.left V.left.affineCover.mem₀,
     (Scheme.ofArrows_mem_precoverage_iff _).2
       ⟨fun x => ⟨_, V.left.affineCover.covers x⟩, fun i => inferInstance⟩⟩
    (σ := fun _ => PUnit.{1}) (Y := fun i _ => Δ i) (fun i _ => δ i)
    (fun i => by
      haveI := hδs i
      haveI := hΔa i
      rw [Presieve.ofArrows_pUnit]
      exact Scheme.Hom.singleton_mem_propQCPrecoverage (hδw i))
  haveI : ∀ i, WeaklyEtale (δ i) := hδw
  let W : (Σ _ : V.left.affineCover.I₀, PUnit.{1}) → S.ProEt := fun p =>
    Scheme.ProEt.mk (δ p.1 ≫ V.left.affineCover.f p.1 ≫ V.hom)
  let a : ∀ p, W p ⟶ V := fun p =>
    MorphismProperty.Over.homMk (A := W p) (B := V) (δ p.1 ≫ V.left.affineCover.f p.1)
      (Category.assoc _ _ _) trivial
  have hmem' : Presieve.ofArrows W a ∈
      (Scheme.proetalePrecoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)).coverings V := by
    rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
    exact hcov
  have hmem : Presieve.ofArrows W a ∈ (Scheme.ProEt.precoverage S).coverings V := hmem'
  refine GrothendieckTopology.superset_covering _ (Sieve.generate_mono ?_)
    (Precoverage.generate_mem_toGrothendieck hmem)
  rintro _ _ ⟨p⟩
  exact ⟨hΔa p.1, hΔQ p.1⟩

theorem sheafOfModules_free_yoneda {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R : Sheaf J RingCat.{u+1}) (U : C) :
    ∃ (P : SheafOfModules.{u+1} R)
      (ev : ∀ M : SheafOfModules.{u+1} R, (P ⟶ M) ≃ M.val.obj (Opposite.op U)),
      (∀ (M N : SheafOfModules.{u+1} R) (ψ : M ⟶ N) (g : P ⟶ M),
        ev N (g ≫ ψ) = (ψ.val.app (Opposite.op U)).hom (ev M g)) ∧
      (∀ (M : SheafOfModules.{u+1} R) (g g' : P ⟶ M), ev M (g + g') = ev M g + ev M g') :=
by
  classical
  let Y : Cᵒᵖ ⥤ Type (u+1) := uliftYoneda.{u+1}.obj U
  let F₀ := (PresheafOfModules.free.{u+1} R.val).obj Y
  let adjS := PresheafOfModules.sheafificationAdjunction (J := J) (R := R) (𝟙 R.val)
  let adjF := PresheafOfModules.freeAdjunction.{u+1} R.val
  let P := (PresheafOfModules.sheafification (J := J) (R := R) (𝟙 R.val)).obj F₀
  let ev : ∀ M : SheafOfModules.{u+1} R, (P ⟶ M) ≃ M.val.obj (Opposite.op U) := fun M =>
    (adjS.homEquiv F₀ M).trans ((adjF.homEquiv Y _).trans uliftYonedaEquiv)
  have hnat : ∀ (M N : SheafOfModules.{u+1} R) (ψ : M ⟶ N) (g : P ⟶ M),
      ev N (g ≫ ψ) = (ψ.val.app (Opposite.op U)).hom (ev M g) := by
    intro M N ψ g
    change uliftYonedaEquiv (adjF.homEquiv Y _ (adjS.homEquiv F₀ N (g ≫ ψ))) =
      (ψ.val.app (Opposite.op U)).hom
        (uliftYonedaEquiv (adjF.homEquiv Y _ (adjS.homEquiv F₀ M g)))
    rw [adjS.homEquiv_naturality_right, adjF.homEquiv_naturality_right, uliftYonedaEquiv_comp]
    rfl
  refine ⟨P, ev, hnat, ?_⟩
  intro M g g'
  have h0 : ∀ h : P ⟶ M, ev M h = (h.val.app (Opposite.op U)).hom (ev P (𝟙 P)) := by
    intro h
    rw [← hnat, Category.id_comp]
  rw [h0, h0 g, h0 g', SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add,
    LinearMap.add_apply]

theorem injectiveResolution_coboundary_of_extMk_eq_sum {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜]
    [HasExt 𝒜] {A : 𝒜} (I : InjectiveResolution A) {P : 𝒜} (q m : ℕ)
    (g : P ⟶ I.cocomplex.X q) (hg : g ≫ I.cocomplex.d q (q + 1) = 0)
    (u : Fin m → (P ⟶ I.cocomplex.X q)) (hu : ∀ a, u a ≫ I.cocomplex.d q (q + 1) = 0)
    (h : I.extMk g (q + 1) rfl hg = ∑ a, I.extMk (u a) (q + 1) rfl (hu a)) :
    ∃ k : P ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev q),
      g = ∑ a, u a + k ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev q) q :=
by
  classical
  have hcongr : ∀ (f f' : P ⟶ I.cocomplex.X q) (_ : f = f')
      (hf : f ≫ I.cocomplex.d q (q + 1) = 0) (hf' : f' ≫ I.cocomplex.d q (q + 1) = 0),
      I.extMk f (q + 1) rfl hf = I.extMk f' (q + 1) rfl hf' := by
    intro f f' e hf hf'
    subst e
    rfl
  have s1 : ∀ (s : Finset (Fin m)) (hs : (∑ a ∈ s, u a) ≫ I.cocomplex.d q (q + 1) = 0),
      ∑ a ∈ s, I.extMk (u a) (q + 1) rfl (hu a) = I.extMk (∑ a ∈ s, u a) (q + 1) rfl hs := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      intro hs
      rw [Finset.sum_empty, hcongr _ 0 Finset.sum_empty hs (by rw [Limits.zero_comp]), I.extMk_zero]
    | insert a s ha ih =>
      intro hs
      have hs' : (∑ b ∈ s, u b) ≫ I.cocomplex.d q (q + 1) = 0 := by
        rw [Preadditive.sum_comp]
        exact Finset.sum_eq_zero (fun b _ => hu b)
      rw [hcongr _ _ (Finset.sum_insert ha) hs
          (by rw [Preadditive.add_comp, hu a, hs', add_zero]),
        ← I.add_extMk _ _ _ rfl (hu a) hs', ← ih hs',
        Finset.sum_insert ha (f := fun b => I.extMk (u b) (q + 1) rfl (hu b))]
  have hsum : (∑ a, u a) ≫ I.cocomplex.d q (q + 1) = 0 := by
    rw [Preadditive.sum_comp]
    exact Finset.sum_eq_zero (fun a _ => hu a)
  have hδ : (g - ∑ a, u a) ≫ I.cocomplex.d q (q + 1) = 0 := by
    rw [Preadditive.sub_comp, hg, hsum, sub_zero]
  have hext0 : I.extMk (g - ∑ a, u a) (q + 1) rfl hδ = 0 := by
    rw [← I.sub_extMk _ _ _ rfl hg hsum, ← s1 Finset.univ hsum, ← h, sub_self]
  rcases q with _ | p
  · refine ⟨0, ?_⟩
    rw [Limits.zero_comp, add_zero]
    have h1 := congrArg I.extEquivCohomologyClass hext0
    rw [InjectiveResolution.extEquivCohomologyClass_extMk,
      InjectiveResolution.extEquivCohomologyClass_zero,
      CochainComplex.HomComplex.CohomologyClass.mk_eq_zero_iff,
      CochainComplex.HomComplex.Cocycle.fromSingleMk_mem_coboundaries_iff _ _ _ _ _ (-1)
        (by norm_num)] at h1
    obtain ⟨g', hg'⟩ := h1
    have hz : Limits.IsZero (I.cochainComplex.X (-1)) :=
      CochainComplex.isZero_of_isStrictlyGE I.cochainComplex 0 (-1)
    rw [hz.eq_of_tgt g' 0, Limits.zero_comp] at hg'
    have h2 : (g - ∑ a, u a) = 0 := by
      rw [← cancel_mono (I.cochainComplexXIso ((0 : ℕ) : ℤ) 0 rfl).inv, Limits.zero_comp]
      exact hg'.symm
    exact sub_eq_zero.mp h2
  · obtain ⟨k, hk⟩ := (I.extMk_eq_zero_iff (g - ∑ a, u a) _ rfl hδ
      ((ComplexShape.up ℕ).prev (p + 1)) (by rw [CochainComplex.prev_nat_succ])).mp hext0
    exact ⟨k, by rw [hk]; abel⟩

theorem wc_hm_pull_Phi_slice_iso (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    (DV : wcHMPullData V.hom ℓ) (hDV : wcHMPullCanonical DV) :
    Nonempty (DV.Φ ≅ wcSliceRes S ℓ V) :=
by
  letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) V.hom :=
    ⟨fun _ _ => inferInstance⟩
  letI : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) V.hom :=
    (fun (P : MorphismProperty Scheme.{u}) [P.IsStableUnderBaseChange] =>
      (inferInstance : P.IsStableUnderBaseChangeAlong V.hom)) (@WeaklyEtale : MorphismProperty Scheme.{u})
  let adj₀ : wcSliceFunctor S V ⊣ wcProEtBC V.hom :=
    @MorphismProperty.Over.mapPullbackAdj Scheme.{u} _ @WeaklyEtale ⊤ _ V.left S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ V.hom _ _ _ V.prop trivial
  have hc : ∀ W : S.ProEt, (adj₀.counit.app W).left = Limits.pullback.fst W.hom V.hom :=
    fun W => rfl
  have hu : ∀ W' : V.left.ProEt, (adj₀.unit.app W').left ≫
      Limits.pullback.fst ((wcSliceFunctor S V).obj W').hom V.hom = 𝟙 W'.left :=
    fun W' => Limits.pullback.lift_fst _ _ _
  have hj : (wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left)
      (Scheme.ProEt.topology S) := inferInstance
  letI := DV.cont
  have H1 : Functor.whiskerRight (NatTrans.op adj₀.counit) (wcRingSheaf S ℓ).obj =
      DV.φ.hom ≫ (wcProEtBC V.hom).op.whiskerLeft
        (𝟙 (wcRingSheaf V.left ℓ) : wcRingSheaf V.left ℓ ⟶
          ((wcSliceFunctor S V).sheafPushforwardContinuous RingCat.{u+1}
            (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)).obj
            (wcRingSheaf S ℓ)).hom := by
    ext V' s
    obtain ⟨W⟩ := V'
    show s.comp (adj₀.counit.app W).left.base.hom = (DV.φ.hom.app (Opposite.op W)).hom s
    rw [hDV W s, hc W]
    rfl
  have H2 : (𝟙 (wcRingSheaf V.left ℓ) : wcRingSheaf V.left ℓ ⟶
          ((wcSliceFunctor S V).sheafPushforwardContinuous RingCat.{u+1}
            (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)).obj
            (wcRingSheaf S ℓ)).hom ≫
      (wcSliceFunctor S V).op.whiskerLeft DV.φ.hom ≫
      Functor.whiskerRight (NatTrans.op adj₀.unit) (wcRingSheaf V.left ℓ).obj =
      𝟙 (wcRingSheaf V.left ℓ).obj := by
    ext V' t
    obtain ⟨W'⟩ := V'
    show ((DV.φ.hom.app (Opposite.op ((wcSliceFunctor S V).obj W'))).hom t).comp
        (adj₀.unit.app W').left.base.hom = t
    refine (congrArg (fun g => ContinuousMap.comp g (adj₀.unit.app W').left.base.hom)
      (hDV ((wcSliceFunctor S V).obj W') t)).trans ?_
    have key : ∀ t : C(↥W'.left, ULift.{u+1} ℚ_[ℓ]),
        ContinuousMap.comp (ContinuousMap.comp t (Limits.pullback.fst
          ((wcSliceFunctor S V).obj W').hom V.hom).base.hom)
          (adj₀.unit.app W').left.base.hom = t := by
      intro t
      first
      | (rw [ContinuousMap.comp_assoc, ← TopCat.hom_comp, ← Scheme.Hom.comp_base, hu W',
          Scheme.Hom.id_base, TopCat.hom_id, ContinuousMap.comp_id])
      | (refine ContinuousMap.ext fun x => ?_
         change t _ = t x
         congr 1
         exact congrArg (fun k : W'.left ⟶ W'.left => k.base x) (hu W'))
      | (refine ContinuousMap.ext fun x => ?_
         change t _ = t x
         congr 1
         have e := congrArg (fun k : W'.left ⟶ W'.left => k x) (hu W')
         simpa only [Scheme.Hom.comp_apply, Scheme.Hom.id_apply] using e)
    exact key t
  exact ⟨Adjunction.leftAdjointUniq DV.adj
    (@SheafOfModules.pushforwardPushforwardAdj _ _ _ _ _ _ _ _ _ _ hj DV.cont adj₀ _ DV.φ H1 H2)⟩

theorem wc_slice_res_free_corep (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    (P : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
    (ev : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), (P ⟶ M) ≃ M.val.obj (Opposite.op V))
    (hnat : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : P ⟶ M),
      ev N (g ≫ ψ) = (ψ.val.app (Opposite.op V)).hom (ev M g)) :
    ∃ ε : SheafOfModules.unit (wcRingSheaf V.left ℓ) ⟶ (wcSliceRes S ℓ V).obj P,
      (∀ Y : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
        Function.Bijective (fun f : P ⟶ Y => ε ≫ (wcSliceRes S ℓ V).map f)) ∧
      ∀ r : C(↥V.left, ULift.{u+1} ℚ_[ℓ]),
        ε ≫ (wcSliceRes S ℓ V).map ((ev (SheafOfModules.unit (wcRingSheaf S ℓ))).symm r) =
          wcHMFun V.left ℓ r ≫ wcSliceUnit S ℓ V :=
by
  classical

  let h : ∀ W' : V.left.ProEt, (wcSliceFunctor S V).obj W' ⟶ V := fun W' =>
    MorphismProperty.Over.homMk W'.hom rfl trivial
  have hcompat : ∀ {W₁ W₂ : V.left.ProEt} (g : W₁ ⟶ W₂),
      (wcSliceFunctor S V).map g ≫ h W₂ = h W₁ := fun g =>
    MorphismProperty.Over.Hom.ext (MorphismProperty.Over.w g)

  let ρ : ∀ Y : SheafOfModules.{u+1} (wcRingSheaf S ℓ), Y.val.obj (Opposite.op V) →
      ((wcSliceRes S ℓ V).obj Y).sections := fun Y s =>
    PresheafOfModules.sectionsMk (fun W' => (Y.val.map (h W'.unop).op).hom s) (by
      intro X X' f
      have e := (PresheafOfModules.map_comp_apply Y.val (h X.unop).op
        ((wcSliceFunctor S V).map f.unop).op s).symm
      rw [← op_comp, hcompat f.unop] at e
      exact e)

  have hρnat : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N)
      (s : M.val.obj (Opposite.op V)),
      PresheafOfModules.sectionsMap ((wcSliceRes S ℓ V).map ψ).val (ρ M s) =
        ρ N ((ψ.val.app (Opposite.op V)).hom s) := by
    intro M N ψ s
    apply PresheafOfModules.sections_ext
    intro W'
    refine (PresheafOfModules.sectionsMap_coe _ _ _).trans ?_
    exact PresheafOfModules.naturality_apply ψ.val (h W'.unop).op s

  have hev : ∀ (Y : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (f : P ⟶ Y),
      ev Y f = (f.val.app (Opposite.op V)).hom (ev P (𝟙 P)) := by
    intro Y f
    rw [← hnat P Y f (𝟙 P), Category.id_comp]
  obtain ⟨ε, hε⟩ : ∃ ε : SheafOfModules.unit (wcRingSheaf V.left ℓ) ⟶ (wcSliceRes S ℓ V).obj P,
      ε = ((wcSliceRes S ℓ V).obj P).unitHomEquiv.symm (ρ P (ev P (𝟙 P))) := ⟨_, rfl⟩
  have hfac : ∀ (Y : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (f : P ⟶ Y),
      ((wcSliceRes S ℓ V).obj Y).unitHomEquiv (ε ≫ (wcSliceRes S ℓ V).map f) = ρ Y (ev Y f) := by
    intro Y f
    rw [SheafOfModules.unitHomEquiv_comp_apply, hε, Equiv.apply_symm_apply, hev Y f]
    exact hρnat P Y f _

  have hρbij : ∀ Y : SheafOfModules.{u+1} (wcRingSheaf S ℓ), Function.Bijective (ρ Y) := by
    intro Y
    let t : V.left.ProEt := Scheme.ProEt.mk (𝟙 V.left)
    let e' : V ⟶ (wcSliceFunctor S V).obj t :=
      MorphismProperty.Over.homMk (𝟙 V.left)
        (by
          first
            | exact (Category.id_comp (𝟙 V.left ≫ V.hom)).trans (Category.id_comp V.hom)
            | simp [t, wcSliceFunctor, MorphismProperty.Over.map_obj_hom, Scheme.ProEt.mk_hom])
        trivial
    have hee : e' ≫ h t = 𝟙 V :=
      MorphismProperty.Over.Hom.ext (Category.id_comp (𝟙 V.left) : _)
    let bang : ∀ W' : V.left.ProEt, W' ⟶ t := fun W' =>
      MorphismProperty.Over.homMk W'.hom (Category.comp_id W'.hom : _) trivial
    have hW' : ∀ W' : V.left.ProEt, h W' ≫ e' = (wcSliceFunctor S V).map (bang W') := fun W' =>
      MorphismProperty.Over.Hom.ext (Category.comp_id W'.hom : _)
    have hinv : ∀ s : Y.val.obj (Opposite.op V),
        (Y.val.map e'.op).hom ((Y.val.map (h t).op).hom s) = s := by
      intro s
      have e1 := (PresheafOfModules.map_comp_apply Y.val (h t).op e'.op s).symm
      rw [← op_comp, hee, op_id] at e1
      have e2 : ConcreteCategory.hom (Y.val.map (𝟙 (Opposite.op V))) s = s := by
        rw [← PresheafOfModules.presheaf_map_apply_coe]
        first
          | (rw [Y.val.presheaf.map_id]; rfl)
          | simp
          | (erw [CategoryTheory.Functor.map_id]; rfl)
      exact e1.trans e2
    refine ⟨fun s s' hss => ?_, fun σ => ?_⟩
    · have h1 : (Y.val.map (h t).op).hom s = (Y.val.map (h t).op).hom s' := by
        have := congrArg (fun σ : ((wcSliceRes S ℓ V).obj Y).sections => σ.1 (Opposite.op t)) hss
        exact this
      exact (hinv s).symm.trans ((congrArg (fun x => (Y.val.map e'.op).hom x) h1).trans (hinv s'))
    · refine ⟨(Y.val.map e'.op).hom (σ.1 (Opposite.op t)), ?_⟩
      apply PresheafOfModules.sections_ext
      intro W'
      have e1 := (PresheafOfModules.map_comp_apply Y.val e'.op (h W'.unop).op
        (σ.1 (Opposite.op t))).symm
      rw [← op_comp, hW'] at e1
      exact e1.trans (PresheafOfModules.sections_property σ (bang W'.unop).op)
  refine ⟨ε, fun Y => ?_, fun r => ?_⟩
  ·
    have hfun : (fun f : P ⟶ Y => ε ≫ (wcSliceRes S ℓ V).map f) =
        ((wcSliceRes S ℓ V).obj Y).unitHomEquiv.symm ∘ ρ Y ∘ ev Y := by
      funext f
      apply ((wcSliceRes S ℓ V).obj Y).unitHomEquiv.injective
      simp only [Function.comp_apply, Equiv.apply_symm_apply]
      exact hfac Y f
    rw [hfun]
    exact (Equiv.bijective _).comp ((hρbij Y).comp (Equiv.bijective _))
  ·
    obtain ⟨g, hg⟩ : ∃ g, g = (ev (SheafOfModules.unit (wcRingSheaf S ℓ))).symm r := ⟨_, rfl⟩
    have hr : ev (SheafOfModules.unit (wcRingSheaf S ℓ)) g = r := by
      rw [hg]; exact Equiv.apply_symm_apply _ _
    rw [← hg]
    obtain ⟨σr, hσr⟩ : ∃ σr, (SheafOfModules.unit (wcRingSheaf V.left ℓ)).unitHomEquiv
        (wcHMFun V.left ℓ r) = σr := ⟨_, rfl⟩
    have hσr' : ∀ W' : (V.left.ProEt)ᵒᵖ,
        σr.1 W' = r.comp (TopCat.Hom.hom W'.unop.hom.base) := by
      intro W'
      rw [← hσr]
      unfold wcHMFun
      rw [Equiv.apply_symm_apply]
      rfl
    apply ((wcSliceRes S ℓ V).obj (SheafOfModules.unit (wcRingSheaf S ℓ))).unitHomEquiv.injective
    refine (hfac _ g).trans ((congrArg (ρ _) hr).trans ?_)
    rw [SheafOfModules.unitHomEquiv_comp_apply, hσr]
    apply PresheafOfModules.sections_ext
    intro W'
    refine Eq.trans ?_ (PresheafOfModules.sectionsMap_coe _ _ _).symm
    rw [hσr' W']
    first
      | rfl
      | exact ContinuousMap.ext (fun x => rfl)
      | (rw [SheafOfModules.unitToPushforwardObjUnit_val_app_apply]; rfl)

theorem wc_slice_unit_isIso (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)] :
    IsIso (wcSliceUnit S ℓ V) :=
by
  let u := wcSliceUnit S ℓ V
  show IsIso u
  have hU : ∀ U, IsIso (((PresheafOfModules.toPresheaf _).map
      ((SheafOfModules.forget _).map u)).app U) := by
    intro U
    have hb : Function.Bijective
        (ConcreteCategory.hom (((PresheafOfModules.toPresheaf _).map
          ((SheafOfModules.forget _).map u)).app U)) := by
      first
        | exact ConcreteCategory.bijective_of_isIso ((𝟙 (wcRingSheaf V.left ℓ)).hom.app U)
        | (have hid : (ConcreteCategory.hom (((PresheafOfModules.toPresheaf _).map
              ((SheafOfModules.forget _).map u)).app U) : _ → _) = id := by
              funext a
              rfl
           rw [hid]
           exact Function.bijective_id)
    have h2 : IsIso ((forget AddCommGrpCat.{u+1}).map (((PresheafOfModules.toPresheaf _).map
          ((SheafOfModules.forget _).map u)).app U)) :=
      (isIso_iff_bijective _).mpr hb
    exact isIso_of_reflects_iso _ (forget AddCommGrpCat.{u+1})
  have h3 : IsIso ((PresheafOfModules.toPresheaf _).map
      ((SheafOfModules.forget _).map u)) := NatIso.isIso_of_isIso_app _
  have h4 : IsIso ((SheafOfModules.forget _).map u) :=
    isIso_of_reflects_iso _ (PresheafOfModules.toPresheaf _)
  exact isIso_of_reflects_iso u (SheafOfModules.forget _)

theorem wc_slice_res_toSheaf_injective (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)]
    (I : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (hI : Injective I) :
    Injective ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf V.left ℓ)).obj ((wcSliceRes S ℓ V).obj I)) :=
by

  have hunit : ∀ (W : (S.ProEt)ᵒᵖ) (m : ℕ), m ≠ 0 →
      IsUnit (m : ↑((wcRingSheaf S ℓ).obj.obj W)) := by
    intro W m hm
    show IsUnit ((m : C(↥W.unop.left, ULift.{u+1} ℚ_[ℓ])))
    have h1 : ((m : ULift.{u+1} ℚ_[ℓ])) ≠ 0 := fun h0 => hm (by
      have := congrArg ULift.down h0
      rw [ULift.down_natCast] at this
      exact_mod_cast this)
    have h2 := (IsUnit.mk0 _ h1).map
      (ContinuousMap.C : ULift.{u+1} ℚ_[ℓ] →+* C(↥W.unop.left, ULift.{u+1} ℚ_[ℓ]))
    rwa [map_natCast] at h2
  obtain ⟨L, adj, -, hLl, -⟩ := sheafOfModules_toSheaf_exact_left_adjoint
    (Scheme.ProEt.topology S) (wcRingSheaf S ℓ) hunit
  haveI := hLl
  haveI : L.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape L
  haveI := hI
  have hA : Injective ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).obj I) :=
    Injective.injective_of_adjoint adj I

  obtain ⟨L₁, adj₁, -, hL₁, -⟩ := proet_overPullback_exact_left_adjoint S V
  haveI := hL₁
  haveI : L₁.PreservesMonomorphisms := preservesMonomorphisms_of_preservesLimitsOfShape L₁
  haveI := hA
  have h₁ : Injective (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} V).obj
      ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).obj I)) :=
    Injective.injective_of_adjoint adj₁ _

  haveI hσ : (wcSliceToOver S V).IsContinuous (Scheme.ProEt.topology V.left)
      ((Scheme.ProEt.topology S).over V) := (wc_slice_over_sites_cont S V).1
  haveI hτ : (wcOverToSlice S V).IsContinuous ((Scheme.ProEt.topology S).over V)
      (Scheme.ProEt.topology V.left) := (wc_slice_over_sites_cont S V).2.1
  let εapp : ∀ W : Over V, (wcOverToSlice S V ⋙ wcSliceToOver S V).obj W ≅ W := fun W =>
    Over.isoMk (MorphismProperty.Over.isoMk (Iso.refl W.left.left)
        ((Category.id_comp _).trans (MorphismProperty.Over.w W.hom).symm))
      (MorphismProperty.Over.Hom.ext (Category.id_comp W.hom.left))
  let ε : wcOverToSlice S V ⋙ wcSliceToOver S V ≅ 𝟭 (Over V) :=
    NatIso.ofComponents εapp (fun {W W'} g => by
      apply Over.OverMorphism.ext
      apply MorphismProperty.Over.Hom.ext
      exact (Category.comp_id g.left.left).trans (Category.id_comp g.left.left).symm)
  let eqv : V.left.ProEt ≌ Over V :=
    Equivalence.mk' (wcSliceToOver S V) (wcOverToSlice S V) (Iso.refl _) ε (fun W => by
      apply Over.OverMorphism.ext
      apply MorphismProperty.Over.Hom.ext
      exact Category.comp_id (𝟙 W.left))
  let adj₀ : wcOverToSlice S V ⊣ wcSliceToOver S V := eqv.symm.toAdjunction
  let adj₂ := adj₀.sheafPushforwardContinuous (E := AddCommGrpCat.{u+1})
    ((Scheme.ProEt.topology S).over V) (Scheme.ProEt.topology V.left)
  haveI : ((wcOverToSlice S V).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      ((Scheme.ProEt.topology S).over V) (Scheme.ProEt.topology V.left)).PreservesMonomorphisms :=
    preservesMonomorphisms_of_preservesLimitsOfShape _
  haveI := h₁
  have h₂ : Injective (((wcSliceToOver S V).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology V.left) ((Scheme.ProEt.topology S).over V)).obj
      (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} V).obj
        ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).obj I))) :=
    Injective.injective_of_adjoint adj₂ _

  exact h₂

theorem wc_ring_sheaf_unit_ext_vanish (T : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (N : SheafOfModules.{u+1} (wcRingSheaf T ℓ))
    (hN : Injective ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf T ℓ)).obj N)) (k : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
    ∀ e : Abelian.Ext (SheafOfModules.unit (wcRingSheaf T ℓ)) N (k + 1), e = 0 :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T ℓ)) := HasExt.standard _
  intro e
  letI : HasExt (Sheaf (Scheme.ProEt.topology T) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI : Injective ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf T ℓ)).obj N) := hN
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcRingSheaf T ℓ)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits _ _
  have hunit : ∀ (V : (T.ProEt)ᵒᵖ) (m : ℕ), m ≠ 0 →
      IsUnit (m : ↑((wcRingSheaf T ℓ).obj.obj V)) := by
    intro V m hm
    show IsUnit ((m : C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ])))
    have h1 : ((m : ULift.{u+1} ℚ_[ℓ])) ≠ 0 := fun h0 => hm (by
      have := congrArg ULift.down h0
      rw [ULift.down_natCast] at this
      exact_mod_cast this)
    have h2 := (IsUnit.mk0 _ h1).map
      (ContinuousMap.C : ULift.{u+1} ℚ_[ℓ] →+* C(↥V.unop.left, ULift.{u+1} ℚ_[ℓ]))
    rwa [map_natCast] at h2
  obtain ⟨L, adj, hLa, hLl, hLc⟩ := sheafOfModules_toSheaf_exact_left_adjoint
    (Scheme.ProEt.topology T) (wcRingSheaf T ℓ) hunit
  haveI := hLa
  haveI := hLl
  haveI := hLc
  have htT : Limits.IsTerminal (Scheme.ProEt.mk (𝟙 T)) :=
    Limits.IsTerminal.ofUniqueHom (C := T.ProEt) (X := Scheme.ProEt.mk (𝟙 T))
      (fun W => MorphismProperty.Over.homMk W.hom (Category.comp_id _) trivial)
      (fun _ m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  obtain ⟨ε, hε⟩ := sheafOfModules_unit_corepresented_by_free_terminal
    (Scheme.ProEt.topology T) (wcRingSheaf T ℓ) _ htT
  have hbij := ext_transfer_of_hom_bijective L (SheafOfModules.toSheaf.{u+1} (wcRingSheaf T ℓ))
    adj _ (SheafOfModules.unit (wcRingSheaf T ℓ)) ε hε N (k + 1)
  have h0 : ∀ x : Abelian.Ext ((presheafToSheaf (Scheme.ProEt.topology T) AddCommGrpCat.{u+1}).obj
      (yoneda.obj (Scheme.ProEt.mk (𝟙 T)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
      ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf T ℓ)).obj N) (k + 1), x = 0 :=
    fun x => Abelian.Ext.eq_zero_of_injective x
  exact hbij.injective ((h0 _).trans (h0 _).symm)

theorem wc_proet_free_slice_module_ext (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    (P : SheafOfModules.{u+1} (wcRingSheaf S ℓ))
    (ev : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ), (P ⟶ M) ≃ M.val.obj (Opposite.op V))
    (hnat : ∀ (M N : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (ψ : M ⟶ N) (g : P ⟶ M),
      ev N (g ≫ ψ) = (ψ.val.app (Opposite.op V)).hom (ev M g))
    (hadd : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (g g' : P ⟶ M),
      ev M (g + g') = ev M g + ev M g')
    (DV : wcHMPullData V.hom ℓ) (hDV : wcHMPullCanonical DV) (n : ℕ) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V.left ℓ)) := HasExt.standard _
    ∃ Θ : Abelian.Ext P (SheafOfModules.unit (wcRingSheaf S ℓ)) n ≃+ wcHM V.left ℓ n,
      ∀ (r : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) (y : wcHM S ℓ n),
        Θ ((Abelian.Ext.mk₀ ((ev (SheafOfModules.unit (wcRingSheaf S ℓ))).symm r)).comp y
            (zero_add n)) =
          (Abelian.Ext.mk₀ (wcHMFun V.left ℓ r)).comp (wcHMPull DV n y) (zero_add n) :=
by
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf V.left ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((Functor.fromPUnit S).obj V.right) ℓ)) :=
    HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf ((𝟭 Scheme).obj V.left) ℓ)) :=
    HasExt.standard _
  classical

  haveI hσ : (wcSliceToOver S V).IsContinuous (Scheme.ProEt.topology V.left)
      ((Scheme.ProEt.topology S).over V) := (wc_slice_over_sites_cont S V).1
  haveI hj : (wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left)
      (Scheme.ProEt.topology S) := by
    have h := Functor.isContinuous_comp (wcSliceToOver S V) (Over.forget V)
      (Scheme.ProEt.topology V.left) ((Scheme.ProEt.topology S).over V) (Scheme.ProEt.topology S)
    exact h
  haveI := DV.additive
  haveI := DV.presLim
  haveI := DV.presColim
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology S) (wcRingSheaf S ℓ)
  haveI : EnoughInjectives
      (SheafOfModules.{u+1} (wcRingSheaf ((Functor.fromPUnit S).obj V.right) ℓ)) :=
    sheafOfModules_enoughInjectives (Scheme.ProEt.topology S) (wcRingSheaf S ℓ)
  obtain ⟨θ⟩ := wc_hm_pull_Phi_slice_iso S ℓ V DV hDV
  obtain ⟨ε, hA1, hA2⟩ := wc_slice_res_free_corep S ℓ V P ev hnat
  haveI := wc_slice_unit_isIso S ℓ V

  have hcomm : ∀ e₁ e₂ : SheafOfModules.unit (wcRingSheaf V.left ℓ) ⟶
      SheafOfModules.unit (wcRingSheaf V.left ℓ), e₁ ≫ e₂ = e₂ ≫ e₁ := by
    intro e₁ e₂
    have h := wc_hm_unit_end_central V.left ℓ e₁ 0 (Abelian.Ext.mk₀ e₂)
    rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀] at h
    exact (Abelian.Ext.mk₀_bijective _ _).1 h

  obtain ⟨c, hc⟩ : ∃ c : SheafOfModules.unit (wcRingSheaf V.left ℓ) ⟶
      SheafOfModules.unit (wcRingSheaf V.left ℓ),
      c = wcSliceUnit S ℓ V ≫ θ.inv.app (SheafOfModules.unit (wcRingSheaf S ℓ)) ≫ DV.μ.hom :=
    ⟨_, rfl⟩
  haveI : IsIso c := by rw [hc]; infer_instance
  obtain ⟨ε', hε'⟩ : ∃ ε' : SheafOfModules.unit (wcRingSheaf V.left ℓ) ⟶ DV.Φ.obj P,
      ε' = inv c ≫ ε ≫ θ.inv.app P := ⟨_, rfl⟩

  have hhom : ∀ Y : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      Function.Bijective (fun f : P ⟶ Y => ε' ≫ DV.Φ.map f) := by
    intro Y
    have e1 : (fun f : P ⟶ Y => ε' ≫ DV.Φ.map f) =
        (fun g : SheafOfModules.unit (wcRingSheaf V.left ℓ) ⟶ (wcSliceRes S ℓ V).obj Y =>
          inv c ≫ g ≫ θ.inv.app Y) ∘ (fun f : P ⟶ Y => ε ≫ (wcSliceRes S ℓ V).map f) := by
      funext f
      simp only [Function.comp_apply, hε', Category.assoc, NatTrans.naturality]
    have hb2 : Function.Bijective
        (fun g : SheafOfModules.unit (wcRingSheaf V.left ℓ) ⟶ (wcSliceRes S ℓ V).obj Y =>
          inv c ≫ g ≫ θ.inv.app Y) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨fun g' => c ≫ g' ≫ θ.hom.app Y, fun g => ?_, fun g' => ?_⟩
      · simp only [Category.assoc, IsIso.hom_inv_id_assoc, Iso.inv_hom_id_app, Category.comp_id]
      · simp only [Category.assoc, IsIso.inv_hom_id_assoc, Iso.hom_inv_id_app, Category.comp_id]
    rw [e1]
    exact hb2.comp (hA1 Y)

  have hvan : ∀ (I : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) [Injective I] (k : ℕ)
      (e : Abelian.Ext (SheafOfModules.unit (wcRingSheaf V.left ℓ)) (DV.Φ.obj I) (k + 1)),
      e = 0 := by
    intro I hI k e
    have h1 := wc_slice_res_toSheaf_injective S ℓ V I hI
    have h2 := wc_ring_sheaf_unit_ext_vanish V.left ℓ ((wcSliceRes S ℓ V).obj I) h1 k
    have h3 : e.comp (Abelian.Ext.mk₀ (θ.hom.app I)) (add_zero _) = 0 := h2 _
    calc e = (e.comp (Abelian.Ext.mk₀ (θ.hom.app I)) (add_zero _)).comp
          (Abelian.Ext.mk₀ (θ.inv.app I)) (add_zero _) := by
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
            Iso.hom_inv_id_app, Abelian.Ext.comp_mk₀_id]
      _ = 0 := by rw [h3, Abelian.Ext.zero_comp]

  have hbij := ext_transfer_of_corep DV.Φ P (SheafOfModules.unit (wcRingSheaf V.left ℓ)) ε' hhom
    hvan (SheafOfModules.unit (wcRingSheaf S ℓ)) n
  have hpost : Function.Bijective (fun x : Abelian.Ext (SheafOfModules.unit (wcRingSheaf V.left ℓ))
      (DV.Φ.obj (SheafOfModules.unit (wcRingSheaf S ℓ))) n =>
        x.comp (Abelian.Ext.mk₀ DV.μ.hom) (add_zero n)) := by
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun z => z.comp (Abelian.Ext.mk₀ DV.μ.inv) (add_zero n), fun x => ?_, fun z => ?_⟩
    · show (x.comp (Abelian.Ext.mk₀ DV.μ.hom) (add_zero n)).comp (Abelian.Ext.mk₀ DV.μ.inv)
        (add_zero n) = x
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    · show (z.comp (Abelian.Ext.mk₀ DV.μ.inv) (add_zero n)).comp (Abelian.Ext.mk₀ DV.μ.hom)
        (add_zero n) = z
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
        Abelian.Ext.comp_mk₀_id]
  obtain ⟨Θ₀, hΘ₀⟩ : ∃ Θ₀ : Abelian.Ext P (SheafOfModules.unit (wcRingSheaf S ℓ)) n →+
      wcHM V.left ℓ n, ∀ β, Θ₀ β =
        ((Abelian.Ext.mk₀ ε').comp (Abelian.Ext.mapExactFunctor DV.Φ β) (zero_add n)).comp
          (Abelian.Ext.mk₀ DV.μ.hom) (add_zero n) :=
    ⟨((Abelian.Ext.mk₀ DV.μ.hom).postcomp (SheafOfModules.unit (wcRingSheaf V.left ℓ))
        (add_zero n)).comp
      (((Abelian.Ext.mk₀ ε').precomp (DV.Φ.obj (SheafOfModules.unit (wcRingSheaf S ℓ)))
        (zero_add n)).comp (DV.Φ.mapExtAddHom P (SheafOfModules.unit (wcRingSheaf S ℓ)) n)),
      fun β => rfl⟩
  have hΘbij : Function.Bijective Θ₀ := by
    have hfun : (Θ₀ : Abelian.Ext P (SheafOfModules.unit (wcRingSheaf S ℓ)) n → wcHM V.left ℓ n) =
        (fun x : Abelian.Ext (SheafOfModules.unit (wcRingSheaf V.left ℓ))
          (DV.Φ.obj (SheafOfModules.unit (wcRingSheaf S ℓ))) n =>
            x.comp (Abelian.Ext.mk₀ DV.μ.hom) (add_zero n)) ∘
        (fun β : Abelian.Ext P (SheafOfModules.unit (wcRingSheaf S ℓ)) n =>
          (Abelian.Ext.mk₀ ε').comp (Abelian.Ext.mapExactFunctor DV.Φ β) (zero_add n)) := by
      funext β
      exact hΘ₀ β
    rw [hfun]
    exact hpost.comp hbij
  refine ⟨AddEquiv.ofBijective Θ₀ hΘbij, fun r y => ?_⟩
  rw [AddEquiv.ofBijective_apply, hΘ₀]

  have hkey : ε' ≫ DV.Φ.map ((ev (SheafOfModules.unit (wcRingSheaf S ℓ))).symm r) =
      wcHMFun V.left ℓ r ≫ DV.μ.inv := by
    rw [← cancel_mono DV.μ.hom]
    rw [Category.assoc, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    calc ε' ≫ DV.Φ.map ((ev (SheafOfModules.unit (wcRingSheaf S ℓ))).symm r) ≫ DV.μ.hom
        = inv c ≫ (ε ≫ (wcSliceRes S ℓ V).map
            ((ev (SheafOfModules.unit (wcRingSheaf S ℓ))).symm r)) ≫
            θ.inv.app (SheafOfModules.unit (wcRingSheaf S ℓ)) ≫ DV.μ.hom := by
          simp only [hε', Category.assoc, NatTrans.naturality_assoc]
      _ = inv c ≫ (wcHMFun V.left ℓ r ≫ c) := by
          rw [hA2]
          congr 1
          rw [hc]
          simp only [Category.assoc]
      _ = inv c ≫ (c ≫ wcHMFun V.left ℓ r) := by rw [hcomm (wcHMFun V.left ℓ r) c]
      _ = wcHMFun V.left ℓ r := IsIso.inv_hom_id_assoc _ _
  show _ = (Abelian.Ext.mk₀ (wcHMFun V.left ℓ r)).comp ((Abelian.Ext.mk₀ DV.μ.inv).comp
      ((Abelian.Ext.mapExactFunctor DV.Φ y).comp (Abelian.Ext.mk₀ DV.μ.hom) (add_zero n))
      (zero_add n)) (zero_add n)
  rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
    Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀_assoc, hkey,
    Abelian.Ext.comp_assoc_of_third_deg_zero]

theorem wc_zmod_pull_data_exists {S S' : Scheme.{u}} (f : S' ⟶ S) (n : ℕ) :
    ∃ D : wcZModPullData f n, wcZModPullCanonical D :=
by
  classical

  obtain ⟨hcont, hflat⟩ := wc_proet_pullback_continuous_flat f
  have hcont' : (wcProEtBC f).IsContinuous (Scheme.ProEt.topology S)
      (Scheme.ProEt.topology S') := hcont
  have hflat' : RepresentablyFlat (wcProEtBC f) := hflat
  letI := hcont'
  haveI := hflat'

  have key : ∀ {V W : S.ProEt} (g : W ⟶ V),
      ((wcProEtBC f).map g).left ≫ Limits.pullback.fst V.hom f =
        Limits.pullback.fst W.hom f ≫ g.left := by
    intro V W g
    exact Limits.pullback.lift_fst _ _ _
  let φp : (wcZModRingSheaf S n).obj ⟶ (wcProEtBC f).op ⋙ (wcZModRingSheaf S' n).obj :=
    { app := fun V => RingCat.ofHom (ContinuousMap.compRightAlgHom ℤ (ULift.{u+1} (ZMod n))
          (Limits.pullback.fst V.unop.hom f).base.hom).toRingHom
      naturality := fun V W g => by
        ext s
        apply ContinuousMap.ext
        intro x
        have hx := congrArg (fun k => k.base x) (key g.unop)
        let s' : C(↥(Opposite.unop V).left, ULift.{u+1} (ZMod n)) := s
        first
          | exact congrArg s' hx.symm
          | exact congrArg s' hx
          | (simp only [Scheme.Hom.comp_base] at hx; exact congrArg s' hx.symm)
          | (simp only [Scheme.Hom.comp_base] at hx; exact congrArg s' hx) }
  let φ : wcZModRingSheaf S n ⟶ ((wcProEtBC f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).obj (wcZModRingSheaf S' n) :=
    ObjectProperty.homMk φp

  haveI : (PresheafOfModules.pushforward.{u+1} φ.hom).IsRightAdjoint :=
    wc_presheafOfModules_pushforward_isRightAdjoint _ φ.hom
  let Φ : SheafOfModules.{u+1} (wcZModRingSheaf S n) ⥤ SheafOfModules.{u+1} (wcZModRingSheaf S' n) :=
    SheafOfModules.pullback φ
  let adj : Φ ⊣ SheafOfModules.pushforward φ := SheafOfModules.pullbackPushforwardAdjunction φ

  haveI : Φ.IsLeftAdjoint := adj.isLeftAdjoint
  haveI : Φ.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint Φ
  haveI : Limits.PreservesColimitsOfSize.{0, 0} Φ := adj.leftAdjoint_preservesColimits
  haveI hcol : Limits.PreservesFiniteColimits Φ :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits Φ
  haveI : Limits.PreservesBinaryBiproducts Φ :=
    Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts Φ
  haveI hadd : Φ.Additive := Functor.additive_of_preservesBinaryBiproducts Φ

  have H1 : ∀ (V : S'.ProEt) (R : Sieve V), (∀ x : ↥V.left, ∃ (W : S'.ProEt) (g : W ⟶ V),
      R.arrows g ∧ IsOpenImmersion g.left ∧ x ∈ Set.range g.left) →
      R ∈ Scheme.ProEt.topology S' V := by
    intro V R hR
    choose W g hgR hgo hgx using hR
    have hZ : Presieve.ofArrows (fun x => (W x).left) (fun x => (g x).left) ∈
        (Scheme.precoverage @IsOpenImmersion).coverings V.left :=
      (Scheme.ofArrows_mem_precoverage_iff _).mpr ⟨fun x => ⟨x, hgx x⟩, fun x => hgo x⟩
    have hP : Presieve.ofArrows W g ∈ (Scheme.ProEt.precoverage S').coverings V := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S' ⋙ Over.forget S')
        Scheme.proetalePrecoverage).coverings V
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change Presieve.ofArrows (fun x => (W x).left) (fun x => (g x).left) ∈
        Scheme.proetalePrecoverage.coverings V.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage V.left hZ, hZ.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun x => inferInstance)⟩
    refine GrothendieckTopology.superset_covering _ ?_ (Precoverage.generate_mem_toGrothendieck hP)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨x⟩
    exact hgR x

  have hsurj : ∀ (V' : S'.ProEt) (r' : C(↥V'.left, ULift.{u+1} (ZMod n))),
      ∃ T ∈ Scheme.ProEt.topology S' V', ∀ ⦃W' : S'.ProEt⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (V : S.ProEt) (a : W' ⟶ (wcProEtBC f).obj V) (r : C(↥V.left, ULift.{u+1} (ZMod n))),
          r'.comp g.left.base.hom =
            (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom := by
    intro V' r'
    let T : Sieve V' :=
      { arrows := fun W' g => ∃ (V : S.ProEt) (a : W' ⟶ (wcProEtBC f).obj V)
            (r : C(↥V.left, ULift.{u+1} (ZMod n))),
            r'.comp g.left.base.hom =
              (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom
        downward_closed := by
          rintro Y Z g ⟨V, a, r, h⟩ k
          exact ⟨V, k ≫ a, r,
            ContinuousMap.ext fun z => congrArg (fun ψ : C(_, _) => ψ (k.left.base z)) h⟩ }
    refine ⟨T, H1 V' T ?_, fun W' g hg => hg⟩
    intro x
    let U : V'.left.Opens := ⟨r' ⁻¹' {r' x}, (isOpen_discrete _).preimage r'.continuous⟩
    have hxU : x ∈ U := Set.mem_singleton (r' x)
    haveI : WeaklyEtale V'.hom := V'.prop
    let W : S'.ProEt := Scheme.ProEt.mk (U.ι ≫ V'.hom)
    let g : W ⟶ V' := MorphismProperty.Over.homMk U.ι rfl trivial
    refine ⟨W, g, ?_, (inferInstance : IsOpenImmersion U.ι), ?_⟩
    swap
    · exact (Set.ext_iff.mp (Scheme.Opens.range_ι U) x).mpr hxU
    let V : S.ProEt := Scheme.ProEt.mk (𝟙 S)
    let aL : U.toScheme ⟶ Limits.pullback (𝟙 S) f :=
      Limits.pullback.lift (U.ι ≫ V'.hom ≫ f) (U.ι ≫ V'.hom)
        (by rw [Category.comp_id, Category.assoc])
    let a : W ⟶ (wcProEtBC f).obj V :=
      MorphismProperty.Over.homMk aL (Limits.pullback.lift_snd _ _ _) trivial
    refine ⟨V, a, ContinuousMap.const _ (r' x), ?_⟩
    apply ContinuousMap.ext
    intro z
    have hz : U.ι.base z ∈ U :=
      (Set.ext_iff.mp (Scheme.Opens.range_ι U) (U.ι.base z)).mp ⟨z, rfl⟩
    exact hz

  have hinj : ∀ (V' : S'.ProEt) (V : S.ProEt) (a : V' ⟶ (wcProEtBC f).obj V)
      (r : C(↥V.left, ULift.{u+1} (ZMod n))),
      (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom = 0 →
      ∃ T ∈ Scheme.ProEt.topology S' V', ∀ ⦃W' : S'.ProEt⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (W : S.ProEt) (b : W ⟶ V) (a' : W' ⟶ (wcProEtBC f).obj W),
          a' ≫ (wcProEtBC f).map b = g ≫ a ∧ r.comp b.left.base.hom = 0 := by
    intro V' V a r hr
    refine ⟨⊤, (Scheme.ProEt.topology S').top_mem V', fun W' g _ => ?_⟩
    have ha : a.left ≫ Limits.pullback.snd V.hom f = V'.hom := Over.w a.toCommaMorphism
    have hg : g.left ≫ V'.hom = W'.hom := Over.w g.toCommaMorphism
    have hGb1 : ∀ {W : S.ProEt} (b : W ⟶ V), ((wcProEtBC f).map b).left ≫
        Limits.pullback.fst V.hom f = Limits.pullback.fst W.hom f ≫ b.left := fun b =>
      Limits.pullback.lift_fst _ _ _
    have hGb2 : ∀ {W : S.ProEt} (b : W ⟶ V), ((wcProEtBC f).map b).left ≫
        Limits.pullback.snd V.hom f = Limits.pullback.snd W.hom f := fun b =>
      Limits.pullback.lift_snd _ _ _
    let Z : V.left.Opens := ⟨r ⁻¹' {0}, (isOpen_discrete _).preimage r.continuous⟩
    haveI : WeaklyEtale V.hom := V.prop
    let W : S.ProEt := Scheme.ProEt.mk (Z.ι ≫ V.hom)
    let b : W ⟶ V := MorphismProperty.Over.homMk Z.ι rfl trivial
    have hb0 : r.comp b.left.base.hom = 0 := by
      apply ContinuousMap.ext
      intro w
      have hw : Z.ι.base w ∈ Z :=
        (Set.ext_iff.mp (Scheme.Opens.range_ι Z) (Z.ι.base w)).mp ⟨w, rfl⟩
      exact hw
    let φ : W'.left ⟶ V.left := g.left ≫ a.left ≫ Limits.pullback.fst V.hom f
    have hrange : Set.range φ.base ⊆ Set.range Z.ι.base := by
      rintro _ ⟨y, rfl⟩
      refine (Set.ext_iff.mp (Scheme.Opens.range_ι Z) _).mpr ?_
      have e := congrArg (fun ψ : C(_, ULift.{u+1} (ZMod n)) => ψ (g.left.base y)) hr
      exact e
    let m : W'.left ⟶ Z.toScheme := IsOpenImmersion.lift Z.ι φ hrange
    have hm : m ≫ Z.ι = φ := IsOpenImmersion.lift_fac _ _ _
    have hcond : Limits.pullback.fst V.hom f ≫ V.hom = Limits.pullback.snd V.hom f ≫ f :=
      Limits.pullback.condition
    have hw : m ≫ (Z.ι ≫ V.hom) = W'.hom ≫ f :=
      calc m ≫ (Z.ι ≫ V.hom) = (m ≫ Z.ι) ≫ V.hom := (Category.assoc _ _ _).symm
        _ = φ ≫ V.hom := congrArg (fun k => k ≫ V.hom) hm
        _ = g.left ≫ a.left ≫ (Limits.pullback.fst V.hom f ≫ V.hom) :=
          (Category.assoc _ _ _).trans (congrArg (fun k => g.left ≫ k) (Category.assoc _ _ _))
        _ = g.left ≫ a.left ≫ (Limits.pullback.snd V.hom f ≫ f) :=
          congrArg (fun k => g.left ≫ a.left ≫ k) hcond
        _ = g.left ≫ (a.left ≫ Limits.pullback.snd V.hom f) ≫ f :=
          congrArg (fun k => g.left ≫ k) (Category.assoc _ _ _).symm
        _ = g.left ≫ V'.hom ≫ f := congrArg (fun k => g.left ≫ k ≫ f) ha
        _ = (g.left ≫ V'.hom) ≫ f := (Category.assoc _ _ _).symm
        _ = W'.hom ≫ f := congrArg (fun k => k ≫ f) hg
    let aL' : W'.left ⟶ Limits.pullback (Z.ι ≫ V.hom) f := Limits.pullback.lift m W'.hom hw
    let a' : W' ⟶ (wcProEtBC f).obj W :=
      MorphismProperty.Over.homMk aL' (Limits.pullback.lift_snd _ _ _) trivial
    refine ⟨W, b, a', ?_, hb0⟩
    apply MorphismProperty.Over.Hom.ext
    change aL' ≫ ((wcProEtBC f).map b).left = g.left ≫ a.left
    have e1 : aL' ≫ Limits.pullback.fst W.hom f = m := Limits.pullback.lift_fst _ _ _
    have e2 : aL' ≫ Limits.pullback.snd W.hom f = W'.hom := Limits.pullback.lift_snd _ _ _
    refine Limits.pullback.hom_ext ?_ ?_
    · exact calc (aL' ≫ ((wcProEtBC f).map b).left) ≫ Limits.pullback.fst V.hom f
          = aL' ≫ (((wcProEtBC f).map b).left ≫ Limits.pullback.fst V.hom f) :=
            Category.assoc _ _ _
        _ = aL' ≫ (Limits.pullback.fst W.hom f ≫ b.left) := congrArg (fun k => aL' ≫ k) (hGb1 b)
        _ = (aL' ≫ Limits.pullback.fst W.hom f) ≫ b.left := (Category.assoc _ _ _).symm
        _ = m ≫ Z.ι := congrArg (fun k => k ≫ b.left) e1
        _ = g.left ≫ a.left ≫ Limits.pullback.fst V.hom f := hm
        _ = (g.left ≫ a.left) ≫ Limits.pullback.fst V.hom f := (Category.assoc _ _ _).symm
    · exact calc (aL' ≫ ((wcProEtBC f).map b).left) ≫ Limits.pullback.snd V.hom f
          = aL' ≫ (((wcProEtBC f).map b).left ≫ Limits.pullback.snd V.hom f) :=
            Category.assoc _ _ _
        _ = aL' ≫ Limits.pullback.snd W.hom f := congrArg (fun k => aL' ≫ k) (hGb2 b)
        _ = W'.hom := e2
        _ = g.left ≫ V'.hom := hg.symm
        _ = g.left ≫ (a.left ≫ Limits.pullback.snd V.hom f) :=
          congrArg (fun k => g.left ≫ k) ha.symm
        _ = (g.left ≫ a.left) ≫ Limits.pullback.snd V.hom f := (Category.assoc _ _ _).symm

  obtain ⟨ι⟩ := wc_sheafOfModules_pullback_toSheaf_iso (Scheme.ProEt.topology S)
    (Scheme.ProEt.topology S') (wcProEtBC f) (wcZModRingSheaf S n) (wcZModRingSheaf S' n) φ
    hsurj hinj Φ adj
  haveI := wc_sheafPullback_preservesFiniteLimits_of_flat (Scheme.ProEt.topology S)
    (Scheme.ProEt.topology S') (wcProEtBC f)
  haveI : Limits.PreservesFiniteLimits (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S n) ⋙
      (wcProEtBC f).sheafPullback AddCommGrpCat.{u+1} (Scheme.ProEt.topology S)
        (Scheme.ProEt.topology S')) :=
    Limits.comp_preservesFiniteLimits _ _
  haveI : Limits.PreservesFiniteLimits (Φ ⋙ SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S' n)) :=
    Limits.preservesFiniteLimits_of_natIso ι.symm
  haveI hlim : Limits.PreservesFiniteLimits Φ :=
    Limits.preservesFiniteLimits_of_reflects_of_preserves Φ
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S' n))

  haveI : (wcProEtBC f).Final := final_of_representablyFlat _
  let μ : Φ.obj (SheafOfModules.unit (wcZModRingSheaf S n)) ≅
      SheafOfModules.unit (wcZModRingSheaf S' n) :=
    Φ.mapIso (Limits.coproductUniqueIso
        (fun _ : PUnit.{u+2} => SheafOfModules.unit (wcZModRingSheaf S n))).symm ≪≫
      SheafOfModules.pullbackObjFreeIso φ PUnit.{u+2} ≪≫
      Limits.coproductUniqueIso (fun _ : PUnit.{u+2} => SheafOfModules.unit (wcZModRingSheaf S' n))

  exact ⟨⟨hcont', φ, Φ, adj, hadd, hlim, hcol, μ⟩, fun V s => rfl⟩

theorem wc_xbar_zmod_coh_finite (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F) :
    ∀ k j : ℕ, 1 ≤ k → Finite (wcZModProEtExt (wcXbar F X) (ℓ ^ k) j) :=
by
  intro k j _
  haveI hprop : IsProper (wcPi2 F X) :=
    (show IsProper (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) from inferInstance)
  have hpos : 0 < ℓ ^ k := pow_pos (Nat.Prime.pos Fact.out) k
  have hℓF : ((ℓ : ℕ) : F) ≠ 0 := by
    intro h0
    haveI : Fact (Nat.Prime (ringChar F)) := ⟨CharP.char_is_prime F (ringChar F)⟩
    have h1 : ringChar F ∣ ℓ := (ringChar.spec F ℓ).mp h0
    have h2 : ringChar F = ℓ :=
      (Nat.prime_dvd_prime_iff_eq (Fact.out : Nat.Prime (ringChar F)) Fact.out).mp h1
    letI := Fintype.ofFinite F
    have h3 : ((Fintype.card F : ℕ) : F) = 0 := FiniteField.cast_card_eq_zero F
    have h4 : ringChar F ∣ Fintype.card F := (ringChar.spec F _).mp h3
    apply hℓ
    rw [← h2, Nat.card_eq_fintype_card]
    exact h4
  have hne : ((ℓ ^ k : ℕ) : AlgebraicClosure F) ≠ 0 := by
    have hℓK : ((ℓ : ℕ) : AlgebraicClosure F) ≠ 0 := by
      rw [← map_natCast (algebraMap F (AlgebraicClosure F))]
      exact (map_ne_zero (algebraMap F (AlgebraicClosure F))).mpr hℓF
    rw [Nat.cast_pow]
    exact pow_ne_zero k hℓK
  obtain ⟨Ψ, -⟩ := wc_zmod_proet_etale_mod_comparison (AlgebraicClosure F) (wcXbar F X)
    (wcPi2 F X) (ℓ ^ k) hpos
  obtain ⟨E⟩ := wc_et_zmodext_coh_equiv (wcXbar F X) (ℓ ^ k) j
  haveI h3 : Finite (wcEtCoh (wcXbar F X) (ℓ ^ k) j) :=
    wc_etale_proper_finite (AlgebraicClosure F) (wcXbar F X) (wcPi2 F X) (ℓ ^ k) hne j
  haveI h2 : Finite (wcEtZModExt (wcXbar F X) (ℓ ^ k) j) := Finite.of_equiv _ E.symm
  exact Finite.of_equiv _ (Ψ j).toEquiv.symm

theorem wc_lc_clopen_assembly {W₀ : Type*} [TopologicalSpace W₀] [CompactSpace W₀]
    {A H : Type*} [AddCommGroup A] [AddCommGroup H]
    (e : ∀ V : Set W₀, IsClopen V → H →+ H)
    (he1 : ∀ h : H, e Set.univ isClopen_univ h = h)
    (hei : ∀ (V V' : Set W₀) (hV : IsClopen V) (hV' : IsClopen V') (h : H),
      e (V ∩ V') (hV.inter hV') h = e V hV (e V' hV' h))
    (heu : ∀ (V V' : Set W₀) (hV : IsClopen V) (hV' : IsClopen V'), Disjoint V V' → ∀ h : H,
      e (V ∪ V') (hV.union hV') h = e V hV h + e V' hV' h)
    (ι : A →+ H) (Z : Set W₀) (hZ : ∀ x : W₀, ∃ z ∈ Z, x ⤳ z)
    (hs : ∀ z ∈ Z, ∀ h : H, ∃ (a : A) (V : Set W₀) (hV : IsClopen V), z ∈ V ∧ e V hV h = e V hV (ι a))
    (hi : ∀ z ∈ Z, ∀ (a : A) (V : Set W₀) (hV : IsClopen V), z ∈ V → e V hV (ι a) = 0 → a = 0) :
    ∃ Ξ : LocallyConstant W₀ A ≃+ H, ∀ (V : Set W₀) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V) (a : A),
      Ξ ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then a else 0)) = e V hV (ι a) :=
by
  classical

  have hcong : ∀ (S S' : Set W₀) (hS : IsClopen S) (hS' : IsClopen S'), S = S' →
      e S hS = e S' hS' := by
    intro S S' hS hS' hSS
    subst hSS
    rfl

  have hempty : ∀ h : H, e ∅ isClopen_empty h = 0 := by
    intro h
    have h1 := heu ∅ ∅ isClopen_empty isClopen_empty (Set.disjoint_empty ∅) h
    rw [hcong (∅ ∪ ∅) ∅ (isClopen_empty.union isClopen_empty) isClopen_empty (Set.union_self ∅)] at h1
    have h2 : e ∅ isClopen_empty h + e ∅ isClopen_empty h = e ∅ isClopen_empty h + 0 := by
      rw [add_zero]; exact h1.symm
    exact add_left_cancel h2

  have hrefine : ∀ (V : W₀ → Set W₀) (hV : ∀ x, IsClopen (V x)), (∀ x, x ∈ V x) →
      ∃ (n : ℕ) (σ : Fin n → W₀) (U : Fin n → Set W₀) (hU : ∀ k, IsClopen (U k)),
        (∀ k, U k ⊆ V (σ k)) ∧ (∀ k l, k ≠ l → Disjoint (U k) (U l)) ∧ (∀ x, ∃ k, x ∈ U k) := by
    intro V hV hmem
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover V (fun x => (hV x).isOpen)
      (fun x _ => Set.mem_iUnion.mpr ⟨x, hmem x⟩)
    let σ : Fin t.card → W₀ := fun k => (t.equivFin.symm k : W₀)
    let U : Fin t.card → Set W₀ := fun k =>
      V (σ k) \ ⋃ l ∈ Finset.univ.filter (fun l => l < k), V (σ l)
    have hU : ∀ k, IsClopen (U k) := fun k =>
      (hV _).diff (isClopen_biUnion_finset fun l _ => hV _)
    have hdlt : ∀ k l, l < k → Disjoint (U k) (U l) := by
      intro k l hlk
      rw [Set.disjoint_left]
      intro x hxk hxl
      exact hxk.2 (Set.mem_iUnion₂.mpr ⟨l, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hlk⟩, hxl.1⟩)
    refine ⟨t.card, σ, U, hU, fun k => Set.diff_subset, ?_, ?_⟩
    · intro k l hkl
      rcases lt_or_gt_of_ne hkl with h | h
      · exact (hdlt l k h).symm
      · exact hdlt k l h
    · intro x
      have hx := ht (Set.mem_univ x)
      rw [Set.mem_iUnion₂] at hx
      obtain ⟨i, hi, hxi⟩ := hx
      have hne : (Finset.univ.filter (fun k => x ∈ V (σ k))).Nonempty :=
        ⟨t.equivFin ⟨i, hi⟩, Finset.mem_filter.mpr ⟨Finset.mem_univ _, by simp [σ, hxi]⟩⟩
      obtain ⟨k, hk, hmin⟩ := Finset.exists_min_image _ id hne
      refine ⟨k, (Finset.mem_filter.mp hk).2, ?_⟩
      intro hx'
      obtain ⟨l, hl, hxl⟩ := Set.mem_iUnion₂.mp hx'
      have h1 := hmin l (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hxl⟩)
      exact absurd (Finset.mem_filter.mp hl).2 (not_lt.mpr h1)

  have hpart : ∀ (n : ℕ) (U : Fin n → Set W₀) (hU : ∀ k, IsClopen (U k)),
      (∀ k l, k ≠ l → Disjoint (U k) (U l)) → (∀ x, ∃ k, x ∈ U k) →
      ∀ h, ∑ k, e (U k) (hU k) h = h := by
    intro n U hU hd hc h
    have key : ∀ T : Finset (Fin n), ∑ k ∈ T, e (U k) (hU k) h =
        e (⋃ k ∈ T, U k) (isClopen_biUnion_finset fun k _ => hU k) h := by
      intro T
      induction T using Finset.induction_on with
      | empty =>
        rw [Finset.sum_empty, hcong (⋃ k ∈ (∅ : Finset (Fin n)), U k) ∅ _ isClopen_empty (by simp),
          hempty]
      | insert j T hj ih =>
        have hdisj : Disjoint (U j) (⋃ k ∈ T, U k) := by
          rw [Set.disjoint_left]
          intro x hxj hxT
          obtain ⟨k, hk, hxk⟩ := Set.mem_iUnion₂.mp hxT
          exact Set.disjoint_left.mp (hd j k (fun hjk => hj (by rw [hjk]; exact hk))) hxj hxk
        rw [Finset.sum_insert hj, ih, ← heu (U j) (⋃ k ∈ T, U k) (hU j)
          (isClopen_biUnion_finset fun k _ => hU k) hdisj h,
          hcong (U j ∪ ⋃ k ∈ T, U k) (⋃ k ∈ insert j T, U k) _
            (isClopen_biUnion_finset fun k _ => hU k) (Finset.set_biUnion_insert j T U).symm]
    rw [key, hcong (⋃ k ∈ (Finset.univ : Finset (Fin n)), U k) Set.univ _ isClopen_univ ?_, he1]
    exact Set.eq_univ_of_forall fun x => by
      obtain ⟨k, hk⟩ := hc x
      exact Set.mem_iUnion₂.mpr ⟨k, Finset.mem_univ _, hk⟩

  have hloc : ∀ y : H, (∀ x, ∃ (V : Set W₀) (hV : IsClopen V), x ∈ V ∧ e V hV y = 0) → y = 0 := by
    intro y hy
    choose V hV hxV hVy using hy
    obtain ⟨n, σ, U, hU, hUV, hd, hc⟩ := hrefine V hV hxV
    rw [← hpart n U hU hd hc y]
    apply Finset.sum_eq_zero
    intro k _
    rw [hcong (U k) (U k ∩ V (σ k)) (hU k) ((hU k).inter (hV (σ k)))
      (Set.inter_eq_left.mpr (hUV k)).symm, hei _ _ (hU k) (hV (σ k)), hVy, map_zero]

  let Ψ₀ : LocallyConstant W₀ A → H := fun f =>
    ∑ a ∈ f.range_finite.toFinset, e {x | f x = a} (f.isLocallyConstant.isClopen_fiber a) (ι a)
  have hK : ∀ (f : LocallyConstant W₀ A) (V : Set W₀) (hV : IsClopen V) (c : A),
      (∀ x ∈ V, f x = c) → e V hV (Ψ₀ f) = e V hV (ι c) := by
    intro f V hV c hfc
    by_cases hne : V.Nonempty
    · obtain ⟨x₀, hx₀⟩ := hne
      have hcm : c ∈ f.range_finite.toFinset := by
        rw [Set.Finite.mem_toFinset]; exact ⟨x₀, hfc x₀ hx₀⟩
      simp only [Ψ₀]
      rw [map_sum, Finset.sum_eq_single_of_mem c hcm]
      · rw [← hei V {x | f x = c} hV (f.isLocallyConstant.isClopen_fiber c),
          hcong (V ∩ {x | f x = c}) V _ hV (Set.inter_eq_left.mpr (fun x hx => hfc x hx))]
      · intro b _ hbc
        rw [← hei V {x | f x = b} hV (f.isLocallyConstant.isClopen_fiber b),
          hcong (V ∩ {x | f x = b}) ∅ _ isClopen_empty ?_, hempty]
        exact Set.subset_empty_iff.mp fun x hx =>
          (hbc ((hx.2 : f x = b).symm.trans (hfc x hx.1))).elim
    · rw [Set.not_nonempty_iff_eq_empty] at hne
      subst hne
      rw [hempty, hempty]
  have hchar : ∀ (f : LocallyConstant W₀ A) (y : H),
      (∀ x, ∃ (V : Set W₀) (hV : IsClopen V) (c : A), x ∈ V ∧ (∀ x' ∈ V, f x' = c) ∧
        e V hV y = e V hV (ι c)) → Ψ₀ f = y := by
    intro f y hy
    rw [← sub_eq_zero]
    apply hloc
    intro x
    obtain ⟨V, hV, c, hxV, hfc, hey⟩ := hy x
    exact ⟨V, hV, hxV, by rw [map_sub, hK f V hV c hfc, hey, sub_self]⟩
  have hadd : ∀ f g, Ψ₀ (f + g) = Ψ₀ f + Ψ₀ g := by
    intro f g
    apply hchar
    intro x
    refine ⟨{y | f y = f x} ∩ {y | g y = g x},
      (f.isLocallyConstant.isClopen_fiber _).inter (g.isLocallyConstant.isClopen_fiber _),
      f x + g x, ⟨rfl, rfl⟩, ?_, ?_⟩
    · intro x' hx'
      have h1 : f x' = f x := hx'.1
      have h2 : g x' = g x := hx'.2
      rw [LocallyConstant.coe_add, Pi.add_apply, h1, h2]
    · rw [map_add, hK f _ _ (f x) (fun x' hx' => hx'.1), hK g _ _ (g x) (fun x' hx' => hx'.2),
        map_add, map_add]
  have hval : ∀ (V : Set W₀) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V) (a : A) (x : W₀),
      ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then a else 0)) x =
        if x ∈ V then a else 0 := by
    intro V _ hV a x
    show (fun i : Fin 2 => if i = 0 then a else 0) (LocallyConstant.ofIsClopen hV x) = _
    by_cases hx : x ∈ V
    · have h0 : LocallyConstant.ofIsClopen hV x = 0 := by
        have := LocallyConstant.ofIsClopen_fiber_zero hV
        rw [Set.ext_iff] at this
        exact (this x).mpr hx
      rw [h0, if_pos hx]
      simp
    · have h1 : LocallyConstant.ofIsClopen hV x = 1 := by
        have := LocallyConstant.ofIsClopen_fiber_one hV
        rw [Set.ext_iff] at this
        exact (this x).mpr hx
      rw [h1, if_neg hx]
      simp
  have hind : ∀ (V : Set W₀) [∀ x, Decidable (x ∈ V)] (hV : IsClopen V) (a : A),
      Ψ₀ ((LocallyConstant.ofIsClopen hV).map (fun i : Fin 2 => if i = 0 then a else 0)) =
        e V hV (ι a) := by
    intro V inst hV a
    apply hchar
    intro x
    by_cases hx : x ∈ V
    · refine ⟨V, hV, a, hx, fun x' hx' => by rw [hval, if_pos hx'], ?_⟩
      rw [← hei V V hV hV, hcong (V ∩ V) V (hV.inter hV) hV (Set.inter_self V)]
    · refine ⟨Vᶜ, hV.compl, 0, hx, fun x' hx' => by rw [hval, if_neg hx'], ?_⟩
      rw [← hei Vᶜ V hV.compl hV, hcong (Vᶜ ∩ V) ∅ (hV.compl.inter hV) isClopen_empty
        (Set.compl_inter_self V), hempty, map_zero, map_zero]
  have hinj : ∀ f, Ψ₀ f = 0 → f = 0 := by
    intro f hf
    ext x
    obtain ⟨z, hz, hxz⟩ := hZ x
    have h1 := hK f {y | f y = f z} (f.isLocallyConstant.isClopen_fiber _) (f z) (fun _ h => h)
    rw [hf, map_zero] at h1
    have h2 := hi z hz (f z) {y | f y = f z} (f.isLocallyConstant.isClopen_fiber _) rfl h1.symm
    have h3 : x ∈ {y | f y = f z} :=
      hxz.mem_open (f.isLocallyConstant.isClopen_fiber _).isOpen rfl
    exact ((h3 : f x = f z).trans h2 : f x = 0)
  have hsurj : ∀ h : H, ∃ f, Ψ₀ f = h := by
    intro h
    choose z hz hxz using hZ
    choose a V hV hzV hVe using fun x => hs (z x) (hz x) h
    obtain ⟨n, σ, U, hU, hUV, hd, hc⟩ :=
      hrefine V hV (fun x => (hxz x).mem_open (hV x).isOpen (hzV x))
    let g : Fin n → LocallyConstant W₀ A := fun k =>
      (LocallyConstant.ofIsClopen (hU k)).map (fun i : Fin 2 => if i = 0 then a (σ k) else 0)
    have hg : ∀ k x', g k x' = if x' ∈ U k then a (σ k) else 0 := fun k x' =>
      hval (U k) (hU k) (a (σ k)) x'
    have hsum_apply : ∀ (s : Finset (Fin n)) (x' : W₀), (∑ k ∈ s, g k) x' = ∑ k ∈ s, g k x' := by
      intro s x'
      induction s using Finset.induction_on with
      | empty => rw [Finset.sum_empty, Finset.sum_empty, LocallyConstant.coe_zero, Pi.zero_apply]
      | insert j s hj ih =>
        rw [Finset.sum_insert hj, Finset.sum_insert hj, LocallyConstant.coe_add, Pi.add_apply, ih]
    refine ⟨∑ k, g k, ?_⟩
    apply hchar
    intro x
    obtain ⟨k, hk⟩ := hc x
    refine ⟨U k, hU k, a (σ k), hk, ?_, ?_⟩
    · intro x' hx'
      rw [hsum_apply, Finset.sum_eq_single_of_mem k (Finset.mem_univ k)]
      · rw [hg, if_pos hx']
      · intro l _ hlk
        rw [hg, if_neg]
        intro hx'l
        exact Set.disjoint_left.mp (hd l k hlk) hx'l hx'
    · rw [hcong (U k) (U k ∩ V (σ k)) (hU k) ((hU k).inter (hV (σ k)))
        (Set.inter_eq_left.mpr (hUV k)).symm, hei _ _ (hU k) (hV (σ k)),
        hei _ _ (hU k) (hV (σ k)), hVe]
  let Ψ : LocallyConstant W₀ A →+ H := AddMonoidHom.mk' Ψ₀ hadd
  have hbij : Function.Bijective Ψ := ⟨(injective_iff_map_eq_zero Ψ).mpr hinj, hsurj⟩
  refine ⟨AddEquiv.ofBijective Ψ hbij, fun V inst hV a => ?_⟩
  rw [AddEquiv.ofBijective_apply]
  exact @hind V inst hV a

theorem wc_zmod_mod_pullback_nat : ∀ (Y : Scheme.{u}) (n : ℕ), 0 < n → ∃ N : SheafOfModules.{u+1} (wcEtZModRing Y n) ⥤ SheafOfModules.{u+1} (wcZModRingSheaf Y n), N.Additive ∧ Limits.PreservesFiniteLimits N ∧ Limits.PreservesFiniteColimits N ∧ ∃ e : N.obj (SheafOfModules.unit (wcEtZModRing Y n)) ≅ SheafOfModules.unit (wcZModRingSheaf Y n), (∀ M : SheafOfModules.{u+1} (wcEtZModRing Y n), Function.Bijective (fun g : SheafOfModules.unit (wcEtZModRing Y n) ⟶ M => e.inv ≫ N.map g)) ∧ Nonempty (N ⋙ SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Y n) ≅ SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n) ⋙ wcEpsInv Y) :=
by
  intro Y n hn
  classical

  have s1 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      (R : Sheaf J RingCat.{u+1}) (m : ℕ), (∀ V, ((m : ℕ) : ↑(R.obj.obj V)) = 0) →
      ∀ M : SheafOfModules.{u+1} R, m • 𝟙 ((SheafOfModules.toSheaf.{u+1} R).obj M) = 0 := by
    intro C _ J R m h M
    have key : ∀ (X : Cᵒᵖ) (x : M.val.obj X), m • x = 0 := fun X x => by
      rw [← Nat.cast_smul_eq_nsmul (R.obj.obj X), h X, zero_smul]
    apply (sheafToPresheaf J AddCommGrpCat.{u+1}).map_injective
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id, Functor.map_zero]
    ext X x
    simp only [NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
      AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply,
      AddMonoidHom.zero_apply]
    exact key X x

  have s2 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R : Sheaf J RingCat.{u+1}) (m : ℕ)
      (α : (Functor.const Cᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod m))) ⟶ R.obj),
      Presheaf.IsLocallyInjective J α → Presheaf.IsLocallySurjective J α →
      Nonempty ((SheafOfModules.toSheaf.{u+1} R).obj (SheafOfModules.unit R) ≅
        (constantSheaf J AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) := by
    intro C _ J _ _ R m α hinj hsurj
    let P := ((SheafOfModules.toSheaf.{u+1} R).obj (SheafOfModules.unit R)).obj
    let α' : (Functor.const Cᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) ⟶ P :=
      { app := fun X => AddCommGrpCat.ofHom (α.app X).hom.toAddMonoidHom
        naturality := fun X Y f => by
          ext t
          exact ConcreteCategory.congr_hom (α.naturality f) t }
    have hi : Presheaf.IsLocallyInjective J α' := by
      refine Presheaf.IsLocallyInjective.mk ?_
      intro X x y hxy
      exact hinj.equalizerSieve_mem x y hxy
    have hs : Presheaf.IsLocallySurjective J α' := by
      refine Presheaf.IsLocallySurjective.mk ?_
      intro U s
      exact hsurj.imageSieve_mem s
    have hW : J.W α' := (GrothendieckTopology.W_iff_isLocallyBijective J α').2 ⟨hi, hs⟩
    have : IsIso ((presheafToSheaf J AddCommGrpCat.{u+1}).map α') :=
      (GrothendieckTopology.W_iff J α').1 hW
    exact ⟨sheafificationIso _ ≪≫ (asIso ((presheafToSheaf J AddCommGrpCat.{u+1}).map α')).symm⟩

  obtain ⟨hlim, hcont⟩ := wc_etToProEt_flat_cont Y
  haveI := hlim
  haveI := hcont
  haveI hlan := wc_lan_preservesFiniteLimits (wcEtToProEt Y)
  let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt Y)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
  haveI hpl : Limits.PreservesFiniteLimits (wcEpsInv Y) := by
    haveI := Functor.sheafPullbackConstruction.preservesFiniteLimits (wcEtToProEt Y)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)
    exact Limits.preservesFiniteLimits_of_natIso
      (Adjunction.leftAdjointUniq (Functor.sheafAdjunctionContinuous (wcEtToProEt Y)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)) adj)
  haveI hladj : (wcEpsInv Y).IsLeftAdjoint := adj.isLeftAdjoint
  haveI hpc : Limits.PreservesFiniteColimits (wcEpsInv Y) := by
    haveI := adj.leftAdjoint_preservesColimits.{0, 0}
    exact Limits.PreservesColimitsOfSize.preservesFiniteColimits.{0, 0} _
  haveI : (wcEpsInv Y).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_isLeftAdjoint _
  haveI hadd : (wcEpsInv Y).Additive := Functor.additive_of_preserves_binary_products _
  have hunit := fun G => wc_epsInv_unit_iso Y G
  haveI : ∀ G, IsIso (adj.unit.app G) := hunit
  haveI : IsIso adj.unit := NatIso.isIso_of_isIso_app _
  let hεFF : (wcEpsInv Y).FullyFaithful := adj.fullyFaithfulLOfIsIsoUnit

  obtain ⟨αe, hαe1, hαe2, hαe3⟩ := wc_et_zmod_ring_locbij Y n
  obtain ⟨αp, hαp1, hαp2, hαp3⟩ := wc_proet_zmod_ring_locbij Y n hn
  obtain ⟨hFe, hEe⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.smallEtaleTopology Y)
    (wcEtZModRing Y n) n αe hαe1 hαe2
  obtain ⟨hFp, hEp⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.ProEt.topology Y)
    (wcZModRingSheaf Y n) n αp hαp1 hαp2
  haveI := hFe
  haveI := hFp
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits _ _

  have hG : ∀ M : SheafOfModules.{u+1} (wcEtZModRing Y n),
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Y n)).essImage
        ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n) ⋙ wcEpsInv Y).obj M) := by
    intro M
    apply hEp
    show n • 𝟙 ((wcEpsInv Y).obj ((SheafOfModules.toSheaf.{u+1} (wcEtZModRing Y n)).obj M)) = 0
