    have e6 := s2 t ((wcEtInv g).obj A) O₁ ((wcEtBaseChange g).obj V) (wcEtInvLift g V O₁ h₁ hh₁)
      O₂ h₂ hh₂ (h₂ ≫ (wcEtInvLift g V O₁ h₁ hh₁).left) hX rfl
      (wcEtInvRho g A V ((wcEtBaseChange g).obj V) (Limits.pullback.fst V.hom g)
