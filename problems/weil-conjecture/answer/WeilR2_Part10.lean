      rw [ut] at h
      exact h
    have c2 : ∀ (V : Y.Etale) (x : A.obj.obj (Opposite.op V)),
        (φ₁.hom.app (Opposite.op ((wcEtBaseChange g).obj V))).hom
          (wcEtInvRho g A V ((wcEtBaseChange g).obj V) (Limits.pullback.fst V.hom g)
            Limits.pullback.condition x) =
