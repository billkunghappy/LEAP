  unfold wcEtSysOK at hA
  obtain ⟨SC1, SC2, -, -⟩ := hA
  refine ⟨?_, ?_, ?_, ?_⟩
  ·
    intro k k' k'' h₁ h₂ E E' E'' e₁ he₁ e₂ he₂ e₃ he₃ hc x
    have het := hT k k' k'' h₁ h₂
    have H : (e₂ ≫ e₁) ≫ E.hom = E''.hom ≫ (D.map (homOfLE (h₁.trans h₂)).op).left := by
      rw [hc]; exact he₃
    have sc := SC1 k k' k'' h₁ h₂ het
    show ((A.φ k' k'' h₂).hom.app (Opposite.op E'')).hom
        (wcEtInvRho (D.map (homOfLE h₂).op).left (A.F k') E' E'' e₂ he₂
          (((A.φ k k' h₁).hom.app (Opposite.op E')).hom
            (wcEtInvRho (D.map (homOfLE h₁).op).left (A.F k) E E' e₁ he₁ x))) =
      ((A.φ k k'' (h₁.trans h₂)).hom.app (Opposite.op E'')).hom
        (wcEtInvRho (D.map (homOfLE (h₁.trans h₂)).op).left (A.F k) E E'' e₃ he₃ x)
    refine (congrArg (fun y => ((A.φ k' k'' h₂).hom.app (Opposite.op E'')).hom y)
      (NA (D.map (homOfLE h₂).op).left _ _ (A.φ k k' h₁) E' E'' e₂ he₂
        (wcEtInvRho (D.map (homOfLE h₁).op).left (A.F k) E E' e₁ he₁ x)).symm).trans ?_
    refine (congrArg (fun y => ((A.φ k' k'' h₂).hom.app (Opposite.op E'')).hom
      ((((wcEtInv (D.map (homOfLE h₂).op).left).map (A.φ k k' h₁)).hom.app
        (Opposite.op E'')).hom y))
      (CI (D.map (homOfLE h₂).op).left (D.map (homOfLE h₁).op).left
        (D.map (homOfLE (h₁.trans h₂)).op).left het (A.F k) E E' e₁ he₁ E'' e₂ he₂ H x).symm).trans ?_
    refine (congrArg (fun m => (m.hom.app (Opposite.op E'')).hom
      (wcEtInvRho (D.map (homOfLE (h₁.trans h₂)).op).left (A.F k) E E'' (e₂ ≫ e₁) H x)) sc).trans ?_
    exact congrArg (fun y => ((A.φ k k'' (h₁.trans h₂)).hom.app (Opposite.op E'')).hom y)
      (hρ _ _ _ _ _ _ H he₃ hc x)
  ·
    intro k k' h O E E' e he π hπ π' hπ' hc x
    have hte := hA' k k' h
    have H : (π' ≫ e) ≫ E.hom = O.hom ≫ (a k).left := by
      rw [hc]; exact hπ
    have sc := SC2 k k' h hte
    show ((A.ψ k').hom.app (Opposite.op O)).hom
        (wcEtInvRho (a k').left (A.F k') E' O π' hπ'
          (((A.φ k k' h).hom.app (Opposite.op E')).hom
            (wcEtInvRho (D.map (homOfLE h).op).left (A.F k) E E' e he x))) =
      ((A.ψ k).hom.app (Opposite.op O)).hom (wcEtInvRho (a k).left (A.F k) E O π hπ x)
    refine (congrArg (fun y => ((A.ψ k').hom.app (Opposite.op O)).hom y)
      (NA (a k').left _ _ (A.φ k k' h) E' O π' hπ'
        (wcEtInvRho (D.map (homOfLE h).op).left (A.F k) E E' e he x)).symm).trans ?_
    refine (congrArg (fun y => ((A.ψ k').hom.app (Opposite.op O)).hom
      ((((wcEtInv (a k').left).map (A.φ k k' h)).hom.app (Opposite.op O)).hom y))
      (CI (a k').left (D.map (homOfLE h).op).left (a k).left hte (A.F k) E E' e he O π' hπ'
        H x).symm).trans ?_
    refine (congrArg (fun m => (m.hom.app (Opposite.op O)).hom
      (wcEtInvRho (a k).left (A.F k) E O (π' ≫ e) H x)) sc).trans ?_
    exact congrArg (fun y => ((A.ψ k).hom.app (Opposite.op O)).hom y) (hρ _ _ _ _ _ _ H hπ hc x)
  ·
    intro k O O' u E E' w π hπ π' hπ' hc x
    have H1 : (u.left ≫ π) ≫ E.hom = O'.hom ≫ (a k).left := by
      rw [Category.assoc, hπ, ← Category.assoc, MorphismProperty.Over.w u]
    have H2 : (π' ≫ w.left) ≫ E.hom = O'.hom ≫ (a k).left := by
      rw [Category.assoc, MorphismProperty.Over.w w, hπ']
    show (A.Finf.obj.map u.op).hom (((A.ψ k).hom.app (Opposite.op O)).hom
        (wcEtInvRho (a k).left (A.F k) E O π hπ x)) =
      ((A.ψ k).hom.app (Opposite.op O')).hom
        (wcEtInvRho (a k).left (A.F k) E' O' π' hπ' (((A.F k).obj.map w.op).hom x))
