  obtain ⟨θ, S, b, Y, hSm, hS, hS', hb, hB⟩ := hs1



  have hs2 : ∃ f₀ : Polynomial (MvPolynomial (Fin d) F), f₀.Monic ∧ 0 < f₀.natDegree ∧
      (∀ h : Polynomial (MvPolynomial (Fin d) F),
        Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd c)).toRingHom θ h ∈ I ↔ f₀ ∣ h) ∧
      ∃ (α β : Polynomial (MvPolynomial (Fin d) F)) (r : MvPolynomial (Fin d) F), r ≠ 0 ∧
        α * f₀ + β * Polynomial.derivative f₀ = Polynomial.C r := by
    let ι : MvPolynomial (Fin d) F →+* MvPolynomial (Fin (d + c)) F ⧸ I :=
      (Ideal.Quotient.mk I).comp (MvPolynomial.rename (Fin.castAdd c)).toRingHom
    letI alg : Algebra (MvPolynomial (Fin d) F) (MvPolynomial (Fin (d + c)) F ⧸ I) := ι.toAlgebra
    letI mdl : Module (MvPolynomial (Fin d) F) (MvPolynomial (Fin (d + c)) F ⧸ I) := alg.toModule
    have hι : Function.Injective
        (algebraMap (MvPolynomial (Fin d) F) (MvPolynomial (Fin (d + c)) F ⧸ I)) := by
      rw [injective_iff_map_eq_zero]
      intro p hp
      exact hind p (Ideal.Quotient.eq_zero_iff_mem.mp hp)
    haveI tf : Module.IsTorsionFree (MvPolynomial (Fin d) F) (MvPolynomial (Fin (d + c)) F ⧸ I) :=
      Module.isTorsionFree_iff_algebraMap_injective.mpr hι
    set θb := Ideal.Quotient.mk I θ with hθb
    have hev : ∀ h : Polynomial (MvPolynomial (Fin d) F), Polynomial.aeval θb h =
        Ideal.Quotient.mk I
          (Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd c)).toRingHom θ h) := by
      intro h
      rw [Polynomial.aeval_def, Polynomial.hom_eval₂]
      rfl
    have hmem : ∀ h, Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd c)).toRingHom θ h ∈ I ↔
        Polynomial.aeval θb h = 0 := by
      intro h; rw [hev, Ideal.Quotient.eq_zero_iff_mem]
    have hint : IsIntegral (MvPolynomial (Fin d) F) θb :=
      ⟨S, hSm, by rw [← Polynomial.aeval_def]; exact (hmem S).mp hS⟩
    have hK : ∀ h, Polynomial.aeval θb h = 0 ↔ minpoly (MvPolynomial (Fin d) F) θb ∣ h :=
      fun h => minpoly.isIntegrallyClosed_dvd_iff hint h
    refine ⟨minpoly _ θb, minpoly.monic hint, minpoly.natDegree_pos hint, fun h => ?_, ?_⟩
    · rw [hmem]; exact hK h
    set f₀ := minpoly (MvPolynomial (Fin d) F) θb with hf₀
    have hnd : ¬ f₀ ∣ Polynomial.derivative f₀ := by
      intro hdvd
      obtain ⟨q, hq⟩ := (hK S).mp ((hmem S).mp hS)
      apply hS'
      rw [hmem, hq, Polynomial.derivative_mul, map_add, map_mul, map_mul, (hK _).mpr hdvd,
        (hK f₀).mpr dvd_rfl, zero_mul, zero_mul, add_zero]
    let K := FractionRing (MvPolynomial (Fin d) F)
    have hirr : Irreducible (f₀.map (algebraMap (MvPolynomial (Fin d) F) K)) :=
      (Polynomial.Monic.irreducible_iff_irreducible_map_fraction_map (minpoly.monic hint)).mp
        (minpoly.irreducible hint)
    have hinjK : Function.Injective (Polynomial.map (algebraMap (MvPolynomial (Fin d) F) K)) :=
      Polynomial.map_injective _ (IsFractionRing.injective _ _)
    have hnd' : ¬ f₀.map (algebraMap _ K) ∣ (Polynomial.derivative f₀).map (algebraMap _ K) := by
      intro hdvd
      have hdeg : ((Polynomial.derivative f₀).map (algebraMap _ K)).natDegree <
          (f₀.map (algebraMap _ K)).natDegree := by
        rw [Polynomial.natDegree_map_eq_of_injective (IsFractionRing.injective _ _),
          Polynomial.natDegree_map_eq_of_injective (IsFractionRing.injective _ _)]
        exact Polynomial.natDegree_derivative_lt (minpoly.natDegree_pos hint).ne'
      have h0 := Polynomial.eq_zero_of_dvd_of_natDegree_lt hdvd hdeg
      rw [← Polynomial.map_zero (algebraMap (MvPolynomial (Fin d) F) K)] at h0
      have h00 := hinjK h0
      exact hnd (by rw [h00]; exact dvd_zero _)
    obtain ⟨a, b', hab⟩ := (Irreducible.coprime_iff_not_dvd hirr).mpr hnd'
    obtain ⟨s1, hs1m, hs1⟩ :=
      IsLocalization.integerNormalization_spec (nonZeroDivisors (MvPolynomial (Fin d) F)) a
    obtain ⟨s2, hs2m, hs2⟩ :=
      IsLocalization.integerNormalization_spec (nonZeroDivisors (MvPolynomial (Fin d) F)) b'
    refine ⟨Polynomial.C s2 *
        IsLocalization.integerNormalization (nonZeroDivisors (MvPolynomial (Fin d) F)) a,
      Polynomial.C s1 *
        IsLocalization.integerNormalization (nonZeroDivisors (MvPolynomial (Fin d) F)) b',
      s1 * s2, ?_, ?_⟩
    · exact mul_ne_zero (nonZeroDivisors.ne_zero hs1m) (nonZeroDivisors.ne_zero hs2m)
    · apply hinjK
      simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, hs1, hs2,
        Algebra.smul_def, Polynomial.algebraMap_apply, map_mul]
      linear_combination (Polynomial.C (algebraMap (MvPolynomial (Fin d) F) K s1) *
        Polynomial.C (algebraMap (MvPolynomial (Fin d) F) K s2)) * hab
  obtain ⟨f₀, hf₀m, hf₀deg, hK, hbez⟩ := hs2
  have hf₀θ : Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd c)).toRingHom θ f₀ ∈ I :=
    (hK f₀).mpr dvd_rfl



  have hU : ∀ (T : Type u) [CommRing T] (ρ : Polynomial (MvPolynomial (Fin d) F) →+* T) (v : T),
      ρ f₀ = 0 → ρ (Polynomial.C b) * v = 1 →
      (∀ p ∈ I, MvPolynomial.eval₂ (ρ.comp (Polynomial.C.comp MvPolynomial.C))
          (fun j => ρ (Y j) * v) p = 0) ∧
      ∀ h : Polynomial (MvPolynomial (Fin d) F),
        MvPolynomial.eval₂ (ρ.comp (Polynomial.C.comp MvPolynomial.C)) (fun j => ρ (Y j) * v)
          (Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd c)).toRingHom θ h) = ρ h := by
    intro T _ ρ v hf hbv
    let ψ : MvPolynomial (Fin (d + c)) F →+* T :=
      MvPolynomial.eval₂Hom (ρ.comp (Polynomial.C.comp MvPolynomial.C)) (fun j => ρ (Y j) * v)
    let tθ : Polynomial (MvPolynomial (Fin d) F) →+* MvPolynomial (Fin (d + c)) F :=
      Polynomial.eval₂RingHom (MvPolynomial.rename (Fin.castAdd c)).toRingHom θ
    set β := ρ (Polynomial.C b) with hβ
    set rb := MvPolynomial.rename (Fin.castAdd c) b with hrb
    have htθ : ∀ h, Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd c)).toRingHom θ h = tθ h :=
      fun h => rfl
    have hψ : ∀ p, MvPolynomial.eval₂ (ρ.comp (Polynomial.C.comp MvPolynomial.C))
        (fun j => ρ (Y j) * v) p = ψ p := fun p => rfl
    have hz : ∀ h, tθ h ∈ I → ρ h = 0 := by
      intro h hh
      obtain ⟨k, rfl⟩ := (hK h).mp hh
      rw [map_mul, hf, zero_mul]
    have hcancel : ∀ (N : ℕ) (x y : T), β ^ N * x = β ^ N * y → x = y := by
      intro N x y hxy
      have h1 : (v ^ N * β ^ N) = 1 := by rw [← mul_pow, mul_comm, hbv, one_pow]
      calc x = (v ^ N * β ^ N) * x := by rw [h1, one_mul]
        _ = v ^ N * (β ^ N * x) := by ring
        _ = v ^ N * (β ^ N * y) := by rw [hxy]
        _ = (v ^ N * β ^ N) * y := by ring
        _ = y := by rw [h1, one_mul]

    have homog : ∀ p : MvPolynomial (Fin (d + c)) F,
        ∃ (N : ℕ) (h : Polynomial (MvPolynomial (Fin d) F)),
        ρ h = β ^ N * ψ p ∧ tθ h - rb ^ N * p ∈ I := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a =>
        refine ⟨0, Polynomial.C (MvPolynomial.C a), ?_, ?_⟩
        · simp [ψ]
        · simp [tθ]
      | add p q hp hq =>
        obtain ⟨N1, h1, e1, i1⟩ := hp
        obtain ⟨N2, h2, e2, i2⟩ := hq
        refine ⟨N1 + N2, Polynomial.C b ^ N2 * h1 + Polynomial.C b ^ N1 * h2, ?_, ?_⟩
        · rw [map_add, map_mul, map_mul, map_pow, map_pow, e1, e2, map_add, ← hβ]
          ring
        · have : tθ (Polynomial.C b ^ N2 * h1 + Polynomial.C b ^ N1 * h2) -
              rb ^ (N1 + N2) * (p + q)
              = rb ^ N2 * (tθ h1 - rb ^ N1 * p) + rb ^ N1 * (tθ h2 - rb ^ N2 * q) := by
            rw [map_add, map_mul, map_mul, map_pow, map_pow]
            have : tθ (Polynomial.C b) = rb := by simp [tθ, rb]
            rw [this]
            ring
          rw [this]
          exact I.add_mem (I.mul_mem_left _ i1) (I.mul_mem_left _ i2)
      | mul_X p j hp =>
        obtain ⟨N, h, e, i⟩ := hp
        refine ⟨N + 1, h * Y j, ?_, ?_⟩
        · rw [map_mul, e, map_mul]
          have : ψ (MvPolynomial.X j) = ρ (Y j) * v := by simp [ψ]
          rw [this]
          calc β ^ N * ψ p * ρ (Y j) = β ^ N * ψ p * ρ (Y j) * (β * v) := by rw [hbv, mul_one]
            _ = β ^ (N + 1) * (ψ p * (ρ (Y j) * v)) := by ring
        · have hj := hB j
          rw [htθ] at hj
          have : tθ (h * Y j) - rb ^ (N + 1) * (p * MvPolynomial.X j)
              = (tθ h - rb ^ N * p) * tθ (Y j) -
                rb ^ N * p * (rb * MvPolynomial.X j - tθ (Y j)) := by
            rw [map_mul]; ring
          rw [this]
          exact I.sub_mem (I.mul_mem_right _ i) (I.mul_mem_left _ hj)

    have hcoef : ψ.comp (MvPolynomial.rename (Fin.castAdd c)).toRingHom = ρ.comp Polynomial.C := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp [ψ]
      · intro i
        have hG' : tθ (Polynomial.C (b * MvPolynomial.X i) - Y (Fin.castAdd c i)) ∈ I := by
          have := hB (Fin.castAdd c i)
          rw [htθ] at this
          convert this using 1
          simp [tθ, rb]
        have h0 := hz _ hG'
        rw [map_sub, sub_eq_zero, map_mul, map_mul, ← hβ] at h0
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.rename_X]
        have : ψ (MvPolynomial.X (Fin.castAdd c i)) = ρ (Y (Fin.castAdd c i)) * v := by simp [ψ]
        rw [this, ← h0, mul_comm β, mul_assoc, hbv, mul_one]
    have hθ : ψ θ = ρ Polynomial.X := by
      obtain ⟨N, h, e, i⟩ := homog θ
      have hG' : tθ (h - Polynomial.C b ^ N * Polynomial.X) ∈ I := by
        have : tθ (h - Polynomial.C b ^ N * Polynomial.X) = tθ h - rb ^ N * θ := by
          rw [map_sub, map_mul, map_pow]
          have h1 : tθ (Polynomial.C b) = rb := by simp [tθ, rb]
          have h2 : tθ Polynomial.X = θ := by simp [tθ]
          rw [h1, h2]
        rw [this]; exact i
      have h0 := hz _ hG'
      rw [map_sub, sub_eq_zero, map_mul, map_pow, ← hβ, e] at h0
      exact hcancel N _ _ h0
    have hcomp : ψ.comp tθ = ρ := by
      apply Polynomial.ringHom_ext'
      · rw [RingHom.comp_assoc]
        have : tθ.comp Polynomial.C = (MvPolynomial.rename (Fin.castAdd c)).toRingHom := by
          ext p <;> simp [tθ]
        rw [this, hcoef]
      · simp only [RingHom.comp_apply]
        have : tθ Polynomial.X = θ := by simp [tθ]
        rw [this, hθ]
    refine ⟨fun p hp => ?_, fun h => ?_⟩
    · rw [hψ]
      obtain ⟨N, h, e, i⟩ := homog p
      have h1 : tθ h ∈ I := by
        have := I.add_mem i (I.mul_mem_left (rb ^ N) hp)
        simpa using this
      have h0 := hz _ h1
      rw [e] at h0
      exact hcancel N _ _ (by rw [h0, mul_zero])
    · rw [hψ, htθ]
      exact RingHom.congr_fun hcomp h



  have hirr : Irreducible
      (Polynomial.map (MvPolynomial.map (algebraMap F (AlgebraicClosure F))) f₀) := by
    obtain ⟨α, β, r, hr, hbez⟩ := hbez
    set Fb := AlgebraicClosure F
    let κ : MvPolynomial (Fin d) F →+* MvPolynomial (Fin d) Fb :=
      MvPolynomial.map (algebraMap F Fb)
    have hκ : Function.Injective κ :=
      MvPolynomial.map_injective _ (algebraMap F Fb).injective
    set fb := Polynomial.map κ f₀ with hfb
    set P := (Ideal.map (MvPolynomial.map (algebraMap F Fb)) I).radical with hP
    let evθ : Polynomial (MvPolynomial (Fin d) Fb) →+* MvPolynomial (Fin (d + c)) Fb :=
      Polynomial.eval₂RingHom (MvPolynomial.rename (Fin.castAdd c)).toRingHom
        (MvPolynomial.map (algebraMap F Fb) θ)
    have hmapren : (MvPolynomial.map (algebraMap F Fb)).comp
        (MvPolynomial.rename (Fin.castAdd c) : MvPolynomial (Fin d) F →ₐ[F] _).toRingHom =
        (MvPolynomial.rename (Fin.castAdd c) :
          MvPolynomial (Fin d) Fb →ₐ[Fb] _).toRingHom.comp κ := by
      apply MvPolynomial.ringHom_ext
      · intro a; simp [κ]
      · intro i; simp [κ]
    have hevfb : evθ fb ∈ P := by
      apply Ideal.le_radical
      have : evθ fb = MvPolynomial.map (algebraMap F Fb)
          (Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd c)).toRingHom θ f₀) := by
        simp only [evθ, hfb, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_map]
        rw [Polynomial.hom_eval₂, hmapren]
      rw [this]
      exact Ideal.mem_map_of_mem _ hf₀θ
    have hfbm : fb.Monic := hf₀m.map κ
    have hfbdeg : fb.natDegree = f₀.natDegree := hf₀m.natDegree_map κ
    have key : ∀ g1 g2 : Polynomial (MvPolynomial (Fin d) Fb), fb = g1 * g2 → evθ g1 ∈ P →
        IsUnit g2 := by
      intro g1 g2 hfac hg1
      obtain ⟨n, hn⟩ := hg1
      have loc : ∀ (Q : Type u) [CommRing Q] (u : Q), ∃ (T : Type u) (_ : CommRing T)
          (j : Q →+* T) (v : T), j u * v = 1 ∧ ∀ y, j y = 0 → ∃ M : ℕ, u ^ M * y = 0 := by
        intro Q _ u
        refine ⟨Localization.Away u, inferInstance, algebraMap Q _, IsLocalization.Away.invSelf u,
          IsLocalization.Away.mul_invSelf u, fun y hy => ?_⟩
        obtain ⟨⟨m, hm⟩, hm0⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers u) _ y).mp hy
        obtain ⟨M, rfl⟩ := hm
        exact ⟨M, hm0⟩
      let π0 := Ideal.Quotient.mk (Ideal.span {g2})
      obtain ⟨T, _, j, v, hv, hj⟩ := loc _ (π0 (Polynomial.C (κ b)))
      let π : Polynomial (MvPolynomial (Fin d) Fb) →+* T := j.comp π0
      let ρ : Polynomial (MvPolynomial (Fin d) F) →+* T := π.comp (Polynomial.mapRingHom κ)
      have hπg2 : π g2 = 0 := by
        simp only [π, RingHom.comp_apply]
        rw [show π0 g2 = 0 from
          Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _), map_zero]
      have hρf : ρ f₀ = 0 := by
        simp only [ρ, RingHom.comp_apply, Polynomial.coe_mapRingHom]
        rw [← hfb, hfac, map_mul, hπg2, mul_zero]
      have hρb : ρ (Polynomial.C b) * v = 1 := by
        simp only [ρ, RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.map_C, π]
        exact hv
      obtain ⟨h1, h2⟩ := hU T ρ v hρf hρb
      let ψb : MvPolynomial (Fin (d + c)) Fb →+* T :=
        MvPolynomial.eval₂Hom (π.comp (Polynomial.C.comp MvPolynomial.C)) (fun j => ρ (Y j) * v)
      have hψmap : ∀ p, ψb (MvPolynomial.map (algebraMap F Fb) p) =
          MvPolynomial.eval₂ (ρ.comp (Polynomial.C.comp MvPolynomial.C))
            (fun j => ρ (Y j) * v) p := by
        intro p
        simp only [ψb, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_map]
        congr 1
        ext a
        simp [ρ, κ]
      have hker : Ideal.map (MvPolynomial.map (algebraMap F Fb)) I ≤ RingHom.ker ψb := by
        rw [Ideal.map_le_iff_le_comap]
        intro p hp
        rw [Ideal.mem_comap, RingHom.mem_ker, hψmap]
        exact h1 p hp
      have hren : ψb.comp (MvPolynomial.rename (Fin.castAdd c) :
          MvPolynomial (Fin d) Fb →ₐ[Fb] _).toRingHom = π.comp Polynomial.C := by
        apply MvPolynomial.ringHom_ext
        · intro a; simp [ψb]
        · intro i
          have := h2 (Polynomial.C (MvPolynomial.X i))
          simp only [Polynomial.eval₂_C, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            MvPolynomial.rename_X, MvPolynomial.eval₂_X] at this
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
            MvPolynomial.rename_X, ψb, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_X]
          rw [this]
          simp [ρ, κ]
      have hθ : ψb (MvPolynomial.map (algebraMap F Fb) θ) = π Polynomial.X := by
        rw [hψmap]
        have := h2 Polynomial.X
        rw [Polynomial.eval₂_X] at this
        rw [this]
        simp [ρ]
      have hev : ∀ g, ψb (evθ g) = π g := by
        intro g
        simp only [evθ, Polynomial.coe_eval₂RingHom]
        rw [Polynomial.hom_eval₂, hren, hθ]
        conv_rhs => rw [← Polynomial.eval₂_C_X (p := g)]
        rw [Polynomial.hom_eval₂]
      have hπg1 : π (g1 ^ n) = 0 := by
        rw [← hev, map_pow]
        exact hker hn
      simp only [π, RingHom.comp_apply] at hπg1
      obtain ⟨M, hm0⟩ := hj _ hπg1
      have hbez' := congrArg (Polynomial.map κ) hbez
      simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C,
        ← Polynomial.derivative_map] at hbez'
      rw [← hfb, hfac, Polynomial.derivative_mul] at hbez'
      have e1 : π0 (Polynomial.C (κ r)) = π0 g1 *
          π0 (Polynomial.map κ α * g2 + Polynomial.map κ β * Polynomial.derivative g2) := by
        rw [← map_mul, Ideal.Quotient.eq, Ideal.mem_span_singleton']
        refine ⟨Polynomial.map κ β * Polynomial.derivative g1, ?_⟩
        linear_combination hbez'
      set c0 := κ r ^ n * κ b ^ M with hc0
      have hc0ne : c0 ≠ 0 := by
        apply mul_ne_zero <;> apply pow_ne_zero
        · exact fun h => hr (hκ (by rw [h, map_zero]))
        · exact fun h => hb (hκ (by rw [h, map_zero]))
      have hc0Q : π0 (Polynomial.C c0) = 0 := by
        rw [hc0, map_mul, map_pow, map_pow, map_mul, map_pow, map_pow, e1]
        calc (π0 g1 * π0 (Polynomial.map κ α * g2 +
                Polynomial.map κ β * Polynomial.derivative g2)) ^ n *
              π0 (Polynomial.C (κ b)) ^ M
            = π0 (Polynomial.map κ α * g2 + Polynomial.map κ β * Polynomial.derivative g2) ^ n *
              (π0 (Polynomial.C (κ b)) ^ M * π0 (g1 ^ n)) := by rw [map_pow]; ring
          _ = 0 := by rw [hm0, mul_zero]
      have hdvd : g2 ∣ Polynomial.C c0 := by
        rw [← Ideal.mem_span_singleton]
        exact Ideal.Quotient.eq_zero_iff_mem.mp hc0Q
      obtain ⟨q, hq⟩ := hdvd
      have hCne : Polynomial.C c0 ≠ 0 := Polynomial.C_ne_zero.mpr hc0ne
      have hg2ne : g2 ≠ 0 := by rintro rfl; rw [zero_mul] at hq; exact hCne hq
      have hqne : q ≠ 0 := by rintro rfl; rw [mul_zero] at hq; exact hCne hq
      have hdeg : g2.natDegree = 0 := by
        have := congrArg Polynomial.natDegree hq
        rw [Polynomial.natDegree_C, Polynomial.natDegree_mul hg2ne hqne] at this
        omega
      have hlc : g1.leadingCoeff * g2.leadingCoeff = 1 := by
        rw [← Polynomial.leadingCoeff_mul, ← hfac]; exact hfbm
      rw [Polynomial.eq_C_of_natDegree_eq_zero hdeg]
      apply IsUnit.map Polynomial.C
      have : g2.leadingCoeff = g2.coeff 0 := by
        rw [Polynomial.leadingCoeff, hdeg]
      rw [← this]
      exact ⟨⟨g2.leadingCoeff, g1.leadingCoeff, by rw [mul_comm]; exact hlc, hlc⟩, rfl⟩
    refine ⟨?_, fun {a b'} hab => ?_⟩
    · rw [hfbm.isUnit_iff]
      intro h1
      have := congrArg Polynomial.natDegree h1
      rw [Polynomial.natDegree_one, hfbdeg] at this
      omega
    · have hmem : evθ a * evθ b' ∈ P := by rw [← map_mul, ← hab]; exact hevfb
      rcases hG.mem_or_mem hmem with h | h
      · exact Or.inr (key a b' hab h)
      · exact Or.inl (key b' a (by rw [hab, mul_comm]) h)



  have hcount : ∀ (E : Type u) [Field E] [Algebra F E],
      Nat.card {x : Fin (d + c) → E //
          (∀ p ∈ I, MvPolynomial.aeval x p = 0) ∧
            MvPolynomial.aeval x (MvPolynomial.rename (Fin.castAdd c) b) ≠ 0} =
        Nat.card {z : Fin (d + 1) → E //
          (∀ p ∈ Ideal.span {Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd 1)).toRingHom
              (MvPolynomial.X (Fin.last d)) f₀}, MvPolynomial.aeval z p = 0) ∧
            MvPolynomial.aeval z (MvPolynomial.rename (Fin.castAdd 1) b) ≠ 0} := by
    intro E _ _
    let e : Polynomial (MvPolynomial (Fin d) F) →+* MvPolynomial (Fin (d + 1)) F :=
      Polynomial.eval₂RingHom (MvPolynomial.rename (Fin.castAdd 1)).toRingHom
        (MvPolynomial.X (Fin.last d))
    let tθ : Polynomial (MvPolynomial (Fin d) F) →+* MvPolynomial (Fin (d + c)) F :=
      Polynomial.eval₂RingHom (MvPolynomial.rename (Fin.castAdd c)).toRingHom θ
    have hcs : ∀ i : Fin d, (Fin.castAdd 1 i : Fin (d + 1)) = Fin.castSucc i := fun i => rfl
    let φ : (Fin (d + c) → E) → (Fin (d + 1) → E) := fun x =>
      Fin.lastCases (motive := fun _ => E) (MvPolynomial.aeval x θ) (fun i => x (Fin.castAdd c i))
    let ρ : (Fin (d + 1) → E) → (Polynomial (MvPolynomial (Fin d) F) →+* E) := fun z =>
      (MvPolynomial.aeval z).toRingHom.comp e
    have L1 : ∀ x h, ρ (φ x) h = MvPolynomial.aeval x (tθ h) := by
      intro x h
      have : ρ (φ x) = (MvPolynomial.aeval x).toRingHom.comp tθ := by
        apply Polynomial.ringHom_ext'
        · apply MvPolynomial.ringHom_ext
          · intro a; simp [ρ, e, tθ]
          · intro i; simp [ρ, e, tθ, φ, hcs]
        · simp [ρ, e, tθ, φ]
      exact RingHom.congr_fun this h
    have hρC : ∀ z, (ρ z).comp (Polynomial.C.comp MvPolynomial.C) = algebraMap F E := by
      intro z; ext a; simp [ρ, e]
    have hρb : ∀ z, ρ z (Polynomial.C b) =
        MvPolynomial.aeval z (MvPolynomial.rename (Fin.castAdd 1) b) := by
      intro z; simp [ρ, e]
    have hρX : ∀ z, ρ z Polynomial.X = z (Fin.last d) := by intro z; simp [ρ, e]
    have hρCX : ∀ z (i : Fin d), ρ z (Polynomial.C (MvPolynomial.X i)) = z (Fin.castSucc i) := by
      intro z i; simp [ρ, e, hcs]
    have hρf : ∀ z, ρ z f₀ = MvPolynomial.aeval z (Polynomial.eval₂
        (MvPolynomial.rename (Fin.castAdd 1)).toRingHom (MvPolynomial.X (Fin.last d)) f₀) :=
      fun z => rfl
    have htθ : ∀ h, Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd c)).toRingHom θ h = tθ h :=
      fun h => rfl
    have htθb : tθ (Polynomial.C b) = MvPolynomial.rename (Fin.castAdd c) b := by simp [tθ]
    have hspan : ∀ z : Fin (d + 1) → E,
        (∀ p ∈ Ideal.span {Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd 1)).toRingHom
          (MvPolynomial.X (Fin.last d)) f₀}, MvPolynomial.aeval z p = 0) ↔ ρ z f₀ = 0 := by
      intro z
      constructor
      · intro hz; exact hz _ (Ideal.mem_span_singleton_self _)
      · intro hz p hp
        obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hp
        rw [map_mul, ← hρf, hz, mul_zero]
    let v : (Fin (d + 1) → E) → E := fun z => (ρ z (Polynomial.C b))⁻¹
    let ψ : (Fin (d + 1) → E) → (Fin (d + c) → E) := fun z j => ρ z (Y j) * v z
    have hU' : ∀ z, ρ z f₀ = 0 → ρ z (Polynomial.C b) ≠ 0 →
        (∀ p ∈ I, MvPolynomial.aeval (ψ z) p = 0) ∧
        ∀ h, MvPolynomial.aeval (ψ z) (tθ h) = ρ z h := by
      intro z hf hb0
      obtain ⟨h1, h2⟩ := hU E (ρ z) (v z) hf (mul_inv_cancel₀ hb0)
      rw [hρC z] at h1 h2
      refine ⟨fun p hp => ?_, fun h => ?_⟩
      · rw [MvPolynomial.aeval_def]; exact h1 p hp
      · rw [MvPolynomial.aeval_def]; exact h2 h
    have fwd : ∀ x : Fin (d + c) → E, ((∀ p ∈ I, MvPolynomial.aeval x p = 0) ∧
          MvPolynomial.aeval x (MvPolynomial.rename (Fin.castAdd c) b) ≠ 0) →
        (∀ p ∈ Ideal.span {Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd 1)).toRingHom
          (MvPolynomial.X (Fin.last d)) f₀}, MvPolynomial.aeval (φ x) p = 0) ∧
          MvPolynomial.aeval (φ x) (MvPolynomial.rename (Fin.castAdd 1) b) ≠ 0 := by
      intro x hx
      refine ⟨(hspan (φ x)).mpr ?_, ?_⟩
      · rw [L1]; exact hx.1 _ hf₀θ
      · rw [← hρb, L1, htθb]; exact hx.2
    have bwd : ∀ z : Fin (d + 1) → E,
        ((∀ p ∈ Ideal.span {Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd 1)).toRingHom
          (MvPolynomial.X (Fin.last d)) f₀}, MvPolynomial.aeval z p = 0) ∧
          MvPolynomial.aeval z (MvPolynomial.rename (Fin.castAdd 1) b) ≠ 0) →
        (∀ p ∈ I, MvPolynomial.aeval (ψ z) p = 0) ∧
          MvPolynomial.aeval (ψ z) (MvPolynomial.rename (Fin.castAdd c) b) ≠ 0 := by
      intro z hz
      have hf := (hspan z).mp hz.1
      have hb0 : ρ z (Polynomial.C b) ≠ 0 := by rw [hρb]; exact hz.2
      obtain ⟨h1, h2⟩ := hU' z hf hb0
      refine ⟨h1, ?_⟩
      rw [← htθb, h2]; exact hb0
    have hφψ : ∀ z, ρ z f₀ = 0 → ρ z (Polynomial.C b) ≠ 0 → φ (ψ z) = z := by
      intro z hf hb0
      have key := (hU' z hf hb0).2
      funext k
      refine Fin.lastCases ?_ (fun i => ?_) k
      · simp only [φ, Fin.lastCases_last]
        have := key Polynomial.X
        rw [hρX] at this
        simpa [tθ] using this
      · simp only [φ, Fin.lastCases_castSucc]
        have := key (Polynomial.C (MvPolynomial.X i))
        rw [hρCX] at this
        simpa [tθ] using this
    have hψφ : ∀ x : Fin (d + c) → E, (∀ p ∈ I, MvPolynomial.aeval x p = 0) →
        MvPolynomial.aeval x (MvPolynomial.rename (Fin.castAdd c) b) ≠ 0 → ψ (φ x) = x := by
      intro x hx hb0
      funext j
      simp only [ψ, v]
      rw [L1, L1, htθb]
      have h1 := hx _ (hB j)
      rw [htθ, map_sub, map_mul, MvPolynomial.aeval_X, sub_eq_zero] at h1
      rw [← h1, mul_comm (MvPolynomial.aeval x (MvPolynomial.rename (Fin.castAdd c) b)) (x j),
        mul_assoc, mul_inv_cancel₀ hb0, mul_one]
    exact Nat.card_congr
      { toFun := fun x => ⟨φ x.1, fwd x.1 x.2⟩
        invFun := fun z => ⟨ψ z.1, bwd z.1 z.2⟩
        left_inv := fun x => Subtype.ext (hψφ x.1 x.2.1 x.2.2)
        right_inv := fun z => Subtype.ext (hφψ z.1 ((hspan z.1).mp z.2.1)
          (by rw [hρb]; exact z.2.2)) }



  obtain ⟨hbijF, -⟩ := hs6 F F (RingHom.id F)
  obtain ⟨hbijFb, -⟩ := hs6 (AlgebraicClosure F) (AlgebraicClosure F) (RingHom.id _)
  obtain ⟨-, hmapc⟩ := hs6 F (AlgebraicClosure F) (algebraMap F (AlgebraicClosure F))
  let eF : Polynomial (MvPolynomial (Fin d) F) →+* MvPolynomial (Fin (d + 1)) F :=
    Polynomial.eval₂RingHom (MvPolynomial.rename (Fin.castAdd 1)).toRingHom
      (MvPolynomial.X (Fin.last d))
  let eFb : Polynomial (MvPolynomial (Fin d) (AlgebraicClosure F)) →+*
      MvPolynomial (Fin (d + 1)) (AlgebraicClosure F) :=
    Polynomial.eval₂RingHom (MvPolynomial.rename (Fin.castAdd 1)).toRingHom
      (MvPolynomial.X (Fin.last d))
  have heF : ∀ P, eF P = Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd 1)).toRingHom
      (MvPolynomial.X (Fin.last d)) P := fun P => rfl
  let eqF := RingEquiv.ofBijective eF hbijF
  let eqFb := RingEquiv.ofBijective eFb hbijFb

  let Ψ : MvPolynomial (Fin (d + 1)) F →ₐ[F] MvPolynomial (Fin (d + c)) F ⧸ I :=
    MvPolynomial.aeval (Fin.lastCases (Ideal.Quotient.mk I θ)
      (fun i => Ideal.Quotient.mk I (MvPolynomial.X (Fin.castAdd c i))))
  have hΨ : ∀ h : Polynomial (MvPolynomial (Fin d) F), Ψ (eF h) =
      Ideal.Quotient.mk I
        (Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd c)).toRingHom θ h) := by
    intro h
    have : (Ψ.toRingHom.comp eF) = (Ideal.Quotient.mk I).comp
        (Polynomial.eval₂RingHom (MvPolynomial.rename (Fin.castAdd c)).toRingHom θ) := by
      apply Polynomial.ringHom_ext'
      · apply MvPolynomial.ringHom_ext
        · intro a
          simp [eF, Ψ]
          rfl
        · intro i
          simp [eF, Ψ]
          exact Fin.lastCases_castSucc i
      · simp [eF, Ψ]
    exact congrArg (fun φ => φ h) this
  set f := Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd 1)).toRingHom
      (MvPolynomial.X (Fin.last d)) f₀ with hfdef
  have hker : Ideal.span {f} = RingHom.ker Ψ := by
    ext p
    obtain ⟨h, rfl⟩ := hbijF.2 p
    rw [RingHom.mem_ker]
    change eF h ∈ Ideal.span {eF f₀} ↔ Ψ (eF h) = 0
    rw [Ideal.mem_span_singleton, hΨ, Ideal.Quotient.eq_zero_iff_mem, hK]
    exact map_dvd_iff eqF
  have hindf : ∀ p : MvPolynomial (Fin d) F,
      MvPolynomial.rename (Fin.castAdd 1) p ∈ Ideal.span {f} → p = 0 := by
    intro p hp
    rw [hker, RingHom.mem_ker] at hp
    have h1 : MvPolynomial.rename (Fin.castAdd 1) p = eF (Polynomial.C p) := by
      rw [heF, Polynomial.eval₂_C]; rfl
    rw [h1, hΨ, Polynomial.eval₂_C, Ideal.Quotient.eq_zero_iff_mem] at hp
    exact hind p hp
  refine ⟨f, MvPolynomial.rename (Fin.castAdd c) b, MvPolynomial.rename (Fin.castAdd 1) b,
    ?_, ?_, hindf, ?_, ?_, ?_, ?_⟩
  · rw [hfdef, hmapc f₀]
    exact (MulEquiv.irreducible_iff eqFb).mpr hirr
  · rw [hker]
    exact RingHom.ker_isPrime Ψ
  · intro j
    refine Fin.lastCases ?_ (fun i => ?_) j
    · exact ⟨f₀, hf₀m.ne_zero, Ideal.mem_span_singleton_self _⟩
    · refine ⟨Polynomial.X - Polynomial.C (MvPolynomial.X i), Polynomial.X_sub_C_ne_zero _, ?_⟩
      have : Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd 1)).toRingHom
          (MvPolynomial.X (Fin.castSucc i) : MvPolynomial (Fin (d + 1)) F)
          (Polynomial.X - Polynomial.C (MvPolynomial.X i : MvPolynomial (Fin d) F)) = 0 := by
        simp only [Polynomial.eval₂_sub, Polynomial.eval₂_X, Polynomial.eval₂_C,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.rename_X]
        rw [sub_eq_zero]
        rfl
      rw [this]
      exact Ideal.zero_mem _
  · intro h
    exact hb (hind b h)
  · intro h
    exact hb (hindf b h)
  · intro E _ _ _
    exact hcount E

theorem lw_curve_normal_form (D : ℕ) (K : Type u) [Field K] [Finite K]
    (g : MvPolynomial (Fin 2) K) (hdeg : g.totalDegree ≤ D)
    (hirr : Irreducible (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g))
    (hq : D + 2 ≤ Nat.card K) :
    ∃ (k : ℕ) (g' : MvPolynomial (Fin 2) K), k + 1 ≤ D ∧ g'.totalDegree = k + 1 ∧
      g'.coeff (Finsupp.single 1 (k + 1)) = 1 ∧ MvPolynomial.pderiv 1 g' ≠ 0 ∧
      Irreducible (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g') ∧
      Nat.card {z : Fin 2 → K // MvPolynomial.eval z g' = 0} =
        Nat.card {z : Fin 2 → K // MvPolynomial.eval z g = 0} :=
by
  classical
  open MvPolynomial in

  have t_inv : ∀ (L : Type u) [Field L] (c : L) (P : MvPolynomial (Fin 2) L),
      aeval (![X 0 + C (-c) * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) L)
        (aeval (![X 0 + C c * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) L) P) = P := by
    intro L _ c P
    induction P using MvPolynomial.induction_on
    · simp
    · rename_i p q hp hq; simp only [map_add, hp, hq]
    · rename_i p n hp
      rw [map_mul, map_mul, hp]
      congr 1
      fin_cases n
      · simp
      · simp

  have t_eval : ∀ (c : K) (P : MvPolynomial (Fin 2) K) (z : Fin 2 → K),
      eval z (aeval (![X 0 + C c * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) K) P) =
        eval ![z 0 + c * z 1, z 1] P := by
    intro c P z
    induction P using MvPolynomial.induction_on
    · simp
    · rename_i p q hp hq; simp only [map_add, hp, hq]
    · rename_i p n hp
      rw [map_mul, map_mul, map_mul, hp]
      congr 1
      fin_cases n <;> simp

  have t_map : ∀ (c : K) (P : MvPolynomial (Fin 2) K),
      map (algebraMap K (AlgebraicClosure K))
          (aeval (![X 0 + C c * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) K) P) =
        aeval (![X 0 + C (algebraMap K (AlgebraicClosure K) c) * X 1, X 1] :
          Fin 2 → MvPolynomial (Fin 2) (AlgebraicClosure K))
          (map (algebraMap K (AlgebraicClosure K)) P) := by
    intro c P
    induction P using MvPolynomial.induction_on
    · simp
    · rename_i p q hp hq; simp only [map_add, hp, hq]
    · rename_i p n hp
      rw [map_mul, map_mul, map_mul, hp]
      fin_cases n <;> simp

  have t_chain : ∀ (c : K) (P : MvPolynomial (Fin 2) K),
      pderiv 1 (aeval (![X 0 + C c * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) K) P) =
        aeval (![X 0 + C c * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) K)
          (C c * pderiv 0 P + pderiv 1 P) := by
    intro c P
    induction P using MvPolynomial.induction_on
    · simp
    · rename_i p q hp hq; simp only [map_add, hp, hq, mul_add]; ring
    · rename_i p n hp
      have hX : pderiv 1 (aeval (![X 0 + C c * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) K)
          (X n : MvPolynomial (Fin 2) K)) =
          aeval (![X 0 + C c * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) K)
            (C c * pderiv 0 (X n) + pderiv 1 (X n)) := by
        fin_cases n <;> simp [pderiv_X]
      rw [map_mul, pderiv_mul, hp, hX, pderiv_mul, pderiv_mul]
      simp only [map_add, map_mul]
      ring

  have t_mono : ∀ (c : K) (m : Fin 2 →₀ ℕ) (a : K),
      aeval (![X 0 + C c * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) K) (monomial m a) =
        C a * ((X 0 + C c * X 1 : MvPolynomial (Fin 2) K) ^ m 0 * X 1 ^ m 1) := by
    intro c m a
    rw [aeval_monomial, Finsupp.prod_fintype _ _ (fun _ => pow_zero _), Fin.prod_univ_two]
    simp

  have t_deg : ∀ (c : K) (P : MvPolynomial (Fin 2) K),
      (aeval (![X 0 + C c * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) K) P).totalDegree ≤
        P.totalDegree := by
    intro c P
    have hY : (X 0 + C c * X 1 : MvPolynomial (Fin 2) K).totalDegree ≤ 1 := by
      refine (totalDegree_add _ _).trans (max_le ?_ ?_)
      · simp [totalDegree_X]
      · refine (totalDegree_mul _ _).trans ?_
        simp [totalDegree_C, totalDegree_X]
    conv_lhs => rw [P.as_sum]
    rw [map_sum]
    refine (totalDegree_finsetSum _ _).trans (Finset.sup_le fun m hm => ?_)
    have hm' := le_totalDegree hm
    rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two] at hm'
    rw [t_mono]
    have h1 : (X 1 : MvPolynomial (Fin 2) K).totalDegree = 1 := totalDegree_X _
    have e1 := totalDegree_mul (C (P.coeff m) : MvPolynomial (Fin 2) K)
      ((X 0 + C c * X 1 : MvPolynomial (Fin 2) K) ^ m 0 * X 1 ^ m 1)
    have e2 := totalDegree_mul ((X 0 + C c * X 1 : MvPolynomial (Fin 2) K) ^ m 0) (X 1 ^ m 1)
    have e3 := totalDegree_pow (X 0 + C c * X 1 : MvPolynomial (Fin 2) K) (m 0)
    have e4 := totalDegree_pow (X 1 : MvPolynomial (Fin 2) K) (m 1)
    have e5 : (C (P.coeff m) : MvPolynomial (Fin 2) K).totalDegree = 0 := totalDegree_C _
    rw [h1] at e4
    have e6 := Nat.mul_le_mul_left (m 0) hY
    omega

  have t_coeff_aux : ∀ (c : K) (j r n : ℕ),
      ((X 0 + C c * X 1 : MvPolynomial (Fin 2) K) ^ j * X 1 ^ r).coeff (Finsupp.single 1 n) =
        if j + r = n then c ^ j else 0 := by
    intro c j
    induction j with
    | zero =>
      intro r n
      rw [pow_zero, one_mul, X_pow_eq_monomial, coeff_monomial]
      simp only [(Finsupp.single_injective _).eq_iff, zero_add, pow_zero]
    | succ j ih =>
      intro r n
      have : (X 0 + C c * X 1 : MvPolynomial (Fin 2) K) ^ (j + 1) * X 1 ^ r =
          X 0 * ((X 0 + C c * X 1) ^ j * X 1 ^ r) +
            C c * ((X 0 + C c * X 1) ^ j * X 1 ^ (r + 1)) := by
        ring
      rw [this, MvPolynomial.coeff_add, coeff_X_mul', coeff_C_mul, ih]
      have h0 : (0 : Fin 2) ∉ (Finsupp.single (1 : Fin 2) n).support := by
        simp [Finsupp.mem_support_iff]
      rw [if_neg h0, zero_add]
      by_cases h : j + (r + 1) = n
      · rw [if_pos h, if_pos (by omega)]; ring
      · rw [if_neg h, if_neg (by omega), mul_zero]
  have t_coeff_mono : ∀ (c : K) (m : Fin 2 →₀ ℕ) (a : K) (n : ℕ),
      (aeval (![X 0 + C c * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) K) (monomial m a)).coeff
        (Finsupp.single 1 n) = a * if m 0 + m 1 = n then c ^ (m 0) else 0 := by
    intro c m a n
    rw [t_mono, coeff_C_mul, t_coeff_aux]

  have t_top : ∀ (P : MvPolynomial (Fin 2) K), P ≠ 0 →
      ∃ ℓ : Polynomial K, ℓ ≠ 0 ∧ ℓ.natDegree ≤ P.totalDegree ∧ ∀ c : K,
        (aeval (![X 0 + C c * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) K) P).coeff
          (Finsupp.single 1 P.totalDegree) = ℓ.eval c := by
    intro P hP
    set δ := P.totalDegree with hδ
    refine ⟨∑ m ∈ P.support,
      if m 0 + m 1 = δ then Polynomial.monomial (m 0) (P.coeff m) else 0, ?_, ?_, ?_⟩
    · obtain ⟨ms, hms, hsup⟩ := Finset.exists_mem_eq_sup P.support (support_nonempty.mpr hP)
        (fun s => s.sum fun _ e => e)
      have hms' : ms 0 + ms 1 = δ := by
        have : δ = ms.sum fun _ e => e := hsup
        rw [this, Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two]
      intro h0
      have := congrArg (fun q => Polynomial.coeff q (ms 0)) h0
      simp only [Polynomial.finsetSum_coeff, Polynomial.coeff_zero] at this
      rw [Finset.sum_eq_single ms] at this
      · rw [if_pos hms', Polynomial.coeff_monomial, if_pos rfl] at this
        exact (mem_support_iff.mp hms) this
      · intro m hm hne
        split_ifs with h1
        · rw [Polynomial.coeff_monomial, if_neg]
          intro h2
          apply hne
          ext i
          fin_cases i
          · exact h2
          · show m 1 = ms 1
            omega
        · simp
      · intro h; exact absurd hms h
    · refine Polynomial.natDegree_sum_le_of_forall_le _ _ (fun m hm => ?_)
      split_ifs with h1
      · exact (Polynomial.natDegree_monomial_le _).trans (by omega)
      · simp
    · intro c
      conv_lhs => rw [P.as_sum]
      rw [map_sum, coeff_sum, Polynomial.eval_finsetSum]
      refine Finset.sum_congr rfl (fun m hm => ?_)
      rw [t_coeff_mono]
      split_ifs with h1
      · simp [Polynomial.eval_monomial]
      · simp

  have t_irr : ∀ (c : AlgebraicClosure K) (P : MvPolynomial (Fin 2) (AlgebraicClosure K)),
      Irreducible (aeval (![X 0 + C c * X 1, X 1] :
        Fin 2 → MvPolynomial (Fin 2) (AlgebraicClosure K)) P) ↔ Irreducible P := by
    intro c P
    let e : MvPolynomial (Fin 2) (AlgebraicClosure K) ≃ₐ[AlgebraicClosure K]
        MvPolynomial (Fin 2) (AlgebraicClosure K) :=
      AlgEquiv.ofAlgHom
        (aeval (![X 0 + C c * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) (AlgebraicClosure K)))
        (aeval (![X 0 + C (-c) * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) (AlgebraicClosure K)))
        (AlgHom.ext fun Q => by simpa using t_inv (AlgebraicClosure K) (-c) Q)
        (AlgHom.ext fun Q => by simpa using t_inv (AlgebraicClosure K) c Q)
    exact MulEquiv.irreducible_iff (x := P) e

  have t_part : pderiv 0 g ≠ 0 ∨ pderiv 1 g ≠ 0 := by
    by_contra hcon
    rw [not_or, not_not, not_not] at hcon
    obtain ⟨hp0, hp1⟩ := hcon
    have hpi : ∀ i, pderiv i g = 0 := by
      intro i; fin_cases i
      · exact hp0
      · exact hp1
    obtain ⟨p, hpdef⟩ : ∃ p, p = ringChar K := ⟨_, rfl⟩
    have hc : CharP K p := by rw [hpdef]; infer_instance
    have hp : p.Prime := CharP.char_is_prime K p
    have : Fact p.Prime := ⟨hp⟩
    have : ExpChar K p := ExpChar.prime hp
    have : ExpChar (MvPolynomial (Fin 2) K) p := ExpChar.prime hp
    have hdiv : ∀ m ∈ g.support, ∀ i, p ∣ m i := by
      intro m hm i
      by_cases hmi : m i = 0
      · rw [hmi]; exact dvd_zero p
      · set m' : Fin 2 →₀ ℕ := m - Finsupp.single i 1 with hm'def
        have hm'i : m' i + 1 = m i := by
          rw [hm'def, Finsupp.tsub_apply, Finsupp.single_eq_same]; omega
        have hm' : m' + Finsupp.single i 1 = m := by
          ext j
          rcases eq_or_ne j i with rfl | hj
          · rw [Finsupp.add_apply, Finsupp.single_eq_same]; exact hm'i
          · simp [hm'def, hj]
        have h1 := coeff_pderiv (i := i) g m'
        rw [hpi i, MvPolynomial.coeff_zero, hm'] at h1
        have h2 : ((m' i : ℕ) : K) + 1 = 0 :=
          (mul_eq_zero.mp h1.symm).resolve_left (mem_support_iff.mp hm)
        have h3 : ((m i : ℕ) : K) = 0 := by
          rw [← hm'i]; push_cast; exact h2
        exact (CharP.cast_eq_zero_iff K p (m i)).mp h3
    have hsurj : Function.Surjective (frobenius K p) :=
      Finite.injective_iff_surjective.mp (frobenius_inj K p)
    choose r hr using hsurj
    have hgh : g = (∑ m ∈ g.support,
        monomial (Finsupp.mapRange (fun e => e / p) (Nat.zero_div p) m) (r (g.coeff m))) ^ p := by
      rw [sum_pow_char]
      conv_lhs => rw [g.as_sum]
      refine Finset.sum_congr rfl (fun m hm => ?_)
      rw [monomial_pow]
      have hexp : p • Finsupp.mapRange (fun e => e / p) (Nat.zero_div p) m = m := by
        ext i
        rw [Finsupp.smul_apply, Finsupp.mapRange_apply, smul_eq_mul]
        exact Nat.mul_div_cancel' (hdiv m hm i)
      have hcoef : r (g.coeff m) ^ p = g.coeff m := by
        have := hr (g.coeff m)
        rw [frobenius_def] at this
        exact this
      rw [hexp, hcoef]
    rw [hgh, map_pow] at hirr
    exact not_irreducible_pow hp.ne_one hirr

  have hδ1 : 1 ≤ g.totalDegree := by
    by_contra h0
    have h0' : g.totalDegree = 0 := by omega
    rw [totalDegree_eq_zero_iff_eq_C.mp h0', map_C] at hirr
    by_cases ha : g.coeff 0 = 0
    · rw [ha] at hirr; simp at hirr
    · exact hirr.not_isUnit (IsUnit.map C (Ne.isUnit ((map_ne_zero _).mpr ha)))
  have hg0 : g ≠ 0 := by
    intro h; rw [h, totalDegree_zero] at hδ1; omega

  obtain ⟨ℓ, hℓ0, hℓdeg, hℓ⟩ := t_top g hg0
  letI : Fintype K := Fintype.ofFinite K
  have hB1 : ℓ.roots.toFinset.card ≤ g.totalDegree :=
    (Multiset.toFinset_card_le _).trans ((Polynomial.card_roots' ℓ).trans hℓdeg)
  have hB2 : (Finset.univ.filter
      (fun c : K => C c * pderiv 0 g + pderiv 1 g = 0)).card ≤ 1 := by
    refine Finset.card_le_one.mpr (fun a ha b hb => ?_)
    rw [Finset.mem_filter] at ha hb
    have hab : C (a - b) * pderiv 0 g = 0 := by
      rw [C_sub, sub_mul]; linear_combination ha.2 - hb.2
    rcases mul_eq_zero.mp hab with h | h
    · exact sub_eq_zero.mp (C_eq_zero.mp h)
    · exfalso
      have h1 : pderiv 1 g = 0 := by
        have := ha.2; rw [h, mul_zero, zero_add] at this; exact this
      rcases t_part with h' | h'
      · exact h' h
      · exact h' h1
  have hlt : (ℓ.roots.toFinset ∪ Finset.univ.filter
      (fun c : K => C c * pderiv 0 g + pderiv 1 g = 0)).card < (Finset.univ : Finset K).card := by
    rw [Finset.card_univ, ← Nat.card_eq_fintype_card]
    have := Finset.card_union_le ℓ.roots.toFinset (Finset.univ.filter
      (fun c : K => C c * pderiv 0 g + pderiv 1 g = 0))
    omega
  obtain ⟨c, -, hc⟩ := Finset.exists_mem_notMem_of_card_lt_card hlt
  rw [Finset.mem_union, not_or] at hc
  have hlam : ℓ.eval c ≠ 0 := fun h =>
    hc.1 (Multiset.mem_toFinset.mpr ((Polynomial.mem_roots hℓ0).mpr h))
  have hQ : C c * pderiv 0 g + pderiv 1 g ≠ 0 := fun h =>
    hc.2 (Finset.mem_filter.mpr ⟨Finset.mem_univ _, h⟩)

  have hk : g.totalDegree - 1 + 1 = g.totalDegree := by omega
  have T3 : (C (ℓ.eval c)⁻¹ * aeval (![X 0 + C c * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) K) g).coeff
      (Finsupp.single 1 g.totalDegree) = 1 := by
    rw [coeff_C_mul, hℓ c, inv_mul_cancel₀ hlam]
  refine ⟨g.totalDegree - 1,
    C (ℓ.eval c)⁻¹ * aeval (![X 0 + C c * X 1, X 1] : Fin 2 → MvPolynomial (Fin 2) K) g,
    by omega, ?_, ?_, ?_, ?_, ?_⟩
  ·
    rw [hk]
    refine le_antisymm ?_ ?_
    · refine (totalDegree_mul _ _).trans ?_
      rw [totalDegree_C, zero_add]
      exact t_deg c g
    · have hmem : Finsupp.single (1 : Fin 2) g.totalDegree ∈
          (C (ℓ.eval c)⁻¹ * aeval (![X 0 + C c * X 1, X 1] :
            Fin 2 → MvPolynomial (Fin 2) K) g).support := by
        rw [mem_support_iff, T3]; exact one_ne_zero
      have := le_totalDegree hmem
      rwa [Finsupp.sum_single_index rfl] at this
  ·
    rw [hk]; exact T3
  ·
    rw [pderiv_C_mul, t_chain]
    refine mul_ne_zero (C_eq_zero.not.mpr (inv_ne_zero hlam)) ?_
    intro h
    apply hQ
    have := t_inv K c (C c * pderiv 0 g + pderiv 1 g)
    rw [h, map_zero] at this
    exact this.symm
  ·
    rw [map_mul, map_C, t_map]
    have hu : IsUnit (C (algebraMap K (AlgebraicClosure K) (ℓ.eval c)⁻¹) :
        MvPolynomial (Fin 2) (AlgebraicClosure K)) :=
      IsUnit.map C (Ne.isUnit ((map_ne_zero _).mpr (inv_ne_zero hlam)))
    rw [irreducible_isUnit_mul hu, t_irr]
    exact hirr
  ·
    let T : (Fin 2 → K) ≃ (Fin 2 → K) :=
      { toFun := fun z => ![z 0 + c * z 1, z 1]
        invFun := fun w => ![w 0 - c * w 1, w 1]
        left_inv := fun z => by funext i; fin_cases i <;> simp
        right_inv := fun w => by funext i; fin_cases i <;> simp }
    refine Nat.card_congr (Equiv.subtypeEquiv T (fun z => ?_))
    show _ ↔ eval ![z 0 + c * z 1, z 1] g = 0
    rw [eval_mul, eval_C, t_eval, mul_eq_zero]
    constructor
    · rintro (h | h)
      · exact absurd h (inv_ne_zero hlam)
      · exact h
    · intro h; exact Or.inr h

theorem lw_upper_singular_points (K : Type u) [Field K] [Finite K] (m : ℕ)
    (g : MvPolynomial (Fin 2) K) (hm : 1 ≤ m) (hdeg : g.totalDegree = m)
    (hmon : g.coeff (Finsupp.single 1 m) = 1) (hder : MvPolynomial.pderiv 1 g ≠ 0)
    (hirr : Irreducible (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g)) :
    Nat.card {z : Fin 2 → K // MvPolynomial.eval z g = 0 ∧
      MvPolynomial.eval z (MvPolynomial.pderiv 1 g) = 0} ≤ m ^ 3 :=
by
  classical

  have s1 : ∀ (f h : Polynomial (Polynomial K)) (a b B : ℕ),
      (∀ k, f.coeff k ≠ 0 → (f.coeff k).natDegree + k ≤ a) →
      (∀ k, h.coeff k ≠ 0 → (h.coeff k).natDegree + k ≤ B) →
      (Polynomial.resultant f h a b).natDegree ≤ a * B := by
    intro f h a b B hf hh
    unfold Polynomial.resultant
    let w : Fin (a + b) → ℕ :=
      Fin.addCases (fun j₁ : Fin a => B + (j₁ : ℕ)) (fun j₁ : Fin b => a + (j₁ : ℕ))
    have hA : ∀ i j, Polynomial.sylvester f h a b i j ≠ 0 →
        (Polynomial.sylvester f h a b i j).natDegree + (i : ℕ) ≤ w j := by
      intro i j hij
      induction j using Fin.addCases with
      | left j₁ =>
        simp only [Polynomial.sylvester, Matrix.of_apply, Fin.addCases_left, w] at hij ⊢
        split_ifs at hij ⊢ with hI
        · obtain ⟨h1, h2⟩ := hI
          have := hh _ hij
          omega
        · exact absurd rfl hij
      | right j₁ =>
        simp only [Polynomial.sylvester, Matrix.of_apply, Fin.addCases_right, w] at hij ⊢
        split_ifs at hij ⊢ with hI
        · obtain ⟨h1, h2⟩ := hI
          have := hf _ hij
          omega
        · exact absurd rfl hij
    rw [Matrix.det_apply]
    apply Polynomial.natDegree_sum_le_of_forall_le
    intro σ _
    refine (Polynomial.natDegree_smul_le _ _).trans ?_
    by_cases hT : ∏ j, Polynomial.sylvester f h a b (σ j) j = 0
    · rw [hT]; simp
    · have hne : ∀ j, Polynomial.sylvester f h a b (σ j) j ≠ 0 := fun j hj =>
        hT (Finset.prod_eq_zero (Finset.mem_univ j) hj)
      have h1 := Polynomial.natDegree_prod_le Finset.univ
        (fun j => Polynomial.sylvester f h a b (σ j) j)
      have h2 : ∑ j, ((Polynomial.sylvester f h a b (σ j) j).natDegree +
          ((σ j : Fin (a + b)) : ℕ)) ≤ ∑ j, w j :=
        Finset.sum_le_sum fun j _ => hA _ _ (hne j)
      rw [Finset.sum_add_distrib] at h2
      have h3 : ∑ j, ((σ j : Fin (a + b)) : ℕ) = ∑ j : Fin (a + b), (j : ℕ) :=
        Equiv.sum_comp σ (fun j => (j : ℕ))
      have h4 : ∑ j : Fin (a + b), (j : ℕ) =
          ∑ j : Fin a, (j : ℕ) + ∑ j : Fin b, (a + (j : ℕ)) := by
        rw [Fin.sum_univ_add]; simp
      have h5 : ∑ j, w j = ∑ j : Fin a, (B + (j : ℕ)) + ∑ j : Fin b, (a + (j : ℕ)) := by
        rw [Fin.sum_univ_add]; simp [w]
      have h6 : ∑ j : Fin a, (B + (j : ℕ)) = a * B + ∑ j : Fin a, (j : ℕ) := by
        rw [Finset.sum_add_distrib]; simp
      omega

  have s2 : Function.Bijective (MvPolynomial.aeval (R := K)
        (![Polynomial.C Polynomial.X, Polynomial.X] : Fin 2 → Polynomial (Polynomial K))) ∧
      (∀ p : MvPolynomial (Fin 2) K,
        MvPolynomial.aeval (R := K) (![Polynomial.C Polynomial.X, Polynomial.X] :
            Fin 2 → Polynomial (Polynomial K)) (MvPolynomial.pderiv 1 p) =
          Polynomial.derivative (MvPolynomial.aeval (R := K)
            (![Polynomial.C Polynomial.X, Polynomial.X] : Fin 2 → Polynomial (Polynomial K)) p)) ∧
      (∀ (p : MvPolynomial (Fin 2) K) (z : Fin 2 → K),
        Polynomial.eval (z 1) (Polynomial.map (Polynomial.evalRingHom (z 0))
          (MvPolynomial.aeval (R := K) (![Polynomial.C Polynomial.X, Polynomial.X] :
            Fin 2 → Polynomial (Polynomial K)) p)) = MvPolynomial.eval z p) := by
    set ψ := (MvPolynomial.aeval (R := K)
          (![Polynomial.C Polynomial.X, Polynomial.X] : Fin 2 → Polynomial (Polynomial K))) with hψ
    let χ : Polynomial (Polynomial K) →+* MvPolynomial (Fin 2) K :=
      Polynomial.eval₂RingHom (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0))
        (MvPolynomial.X 1)
    have h1 : χ.comp ψ.toRingHom = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro r; simp [χ, ψ]
      · intro i; fin_cases i <;> simp [χ, ψ]
    have h2c : (ψ.toRingHom.comp χ).comp Polynomial.C = Polynomial.C := by
      apply Polynomial.ringHom_ext
      · intro r; simp [χ, ψ]
      · simp [χ, ψ]
    have h2 : ψ.toRingHom.comp χ = RingHom.id _ := by
      apply Polynomial.ringHom_ext'
      · rw [h2c]; rfl
      · simp [χ, ψ]
    refine ⟨⟨?_, ?_⟩, ?_, ?_⟩
    · intro x y hxy
      have := congrArg χ hxy
      have e1 := RingHom.congr_fun h1 x
      have e2 := RingHom.congr_fun h1 y
      simp only [RingHom.comp_apply, RingHom.id_apply] at e1 e2
      rw [← e1, ← e2]; exact this
    · intro y
      refine ⟨χ y, ?_⟩
      have := RingHom.congr_fun h2 y
      simpa using this
    · intro p
      induction p using MvPolynomial.induction_on with
      | C a => simp [ψ]
      | add p q hp hq => simp only [map_add, hp, hq]
      | mul_X p n hp =>
        rw [hψ] at hp ⊢
        simp only [Derivation.leibniz, map_add, map_mul, Polynomial.derivative_mul, smul_eq_mul,
          hp]
        fin_cases n <;> simp [MvPolynomial.pderiv_X] <;> ring
    · intro p z
      have : ((Polynomial.evalRingHom (z 1)).comp
          ((Polynomial.mapRingHom (Polynomial.evalRingHom (z 0))).comp
          ψ.toRingHom)) = MvPolynomial.eval z := by
        apply MvPolynomial.ringHom_ext
        · intro r; simp [ψ]
        · intro i; fin_cases i <;> simp [ψ]
      have := RingHom.congr_fun this p
      simpa using this

  have s3 : ∀ (p : MvPolynomial (Fin 2) K) (d : ℕ), p.totalDegree ≤ d →
      (∀ k, (MvPolynomial.aeval (R := K) (![Polynomial.C Polynomial.X, Polynomial.X] :
            Fin 2 → Polynomial (Polynomial K)) p).coeff k ≠ 0 →
          ((MvPolynomial.aeval (R := K) (![Polynomial.C Polynomial.X, Polynomial.X] :
            Fin 2 → Polynomial (Polynomial K)) p).coeff k).natDegree + k ≤ d) ∧
      (p.coeff (Finsupp.single 1 d) = 1 →
        (MvPolynomial.aeval (R := K) (![Polynomial.C Polynomial.X, Polynomial.X] :
            Fin 2 → Polynomial (Polynomial K)) p).Monic ∧
        (MvPolynomial.aeval (R := K) (![Polynomial.C Polynomial.X, Polynomial.X] :
            Fin 2 → Polynomial (Polynomial K)) p).natDegree = d) := by
    intro p d hp
    set ψ := (MvPolynomial.aeval (R := K)
          (![Polynomial.C Polynomial.X, Polynomial.X] : Fin 2 → Polynomial (Polynomial K))) with hψ
    have hmono : ∀ (s : Fin 2 →₀ ℕ) (c : K),
        ψ (MvPolynomial.monomial s c) = Polynomial.C (Polynomial.C c * Polynomial.X ^ (s 0)) *
          Polynomial.X ^ (s 1) := by
      intro s c
      rw [hψ, MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (by simp), Fin.prod_univ_two]
      simp [Polynomial.C_mul, Polynomial.C_pow]
      ring
    have hdegs : ∀ s ∈ p.support, s 0 + s 1 ≤ d := by
      intro s hs
      have := MvPolynomial.le_totalDegree hs
      rw [Finsupp.sum_fintype _ _ (by simp), Fin.sum_univ_two] at this
      omega
    have hcoeff : ∀ k, (ψ p).coeff k = ∑ s ∈ p.support,
        (if k = s 1 then Polynomial.C (p.coeff s) * Polynomial.X ^ (s 0) else 0) := by
      intro k
      conv_lhs => rw [MvPolynomial.as_sum p, map_sum]
      rw [Polynomial.finsetSum_coeff]
      refine Finset.sum_congr rfl fun s _ => ?_
      rw [hmono, Polynomial.coeff_C_mul_X_pow]
    have hbound : ∀ k, (ψ p).coeff k ≠ 0 → ((ψ p).coeff k).natDegree + k ≤ d := by
      intro k hk
      have hk' := hk
      rw [hcoeff] at hk'
      obtain ⟨s, hs, hsne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hk'
      have hks : k = s 1 := by
        by_contra hne; rw [if_neg hne] at hsne; exact hsne rfl
      have hkd : k ≤ d := by have := hdegs s hs; omega
      have : ((ψ p).coeff k).natDegree ≤ d - k := by
        rw [hcoeff]
        apply Polynomial.natDegree_sum_le_of_forall_le
        intro t ht
        split_ifs with htk
        · refine (Polynomial.natDegree_C_mul_X_pow_le _ _).trans ?_
          have := hdegs t ht; omega
        · simp
      omega
    refine ⟨hbound, fun h1 => ?_⟩
    have hle : (ψ p).natDegree ≤ d := by
      rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
      intro k hk
      by_contra hne
      have := hbound k hne
      omega
    have hcd : (ψ p).coeff d = 1 := by
      rw [hcoeff, Finset.sum_eq_single (Finsupp.single 1 d)]
      · simp [h1]
      · intro b hb hbne
        rw [if_neg]
        intro hdb
        apply hbne
        have := hdegs b hb
        ext i
        fin_cases i
        · simp; omega
        · simp; omega
      · intro hn
        rw [MvPolynomial.notMem_support_iff] at hn
        simp [hn]
    exact ⟨Polynomial.monic_of_natDegree_le_of_coeff_eq_one d hle hcd,
      Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hle (by rw [hcd]; exact one_ne_zero)⟩

  have s4 : ∀ p : MvPolynomial (Fin 2) K,
      Irreducible (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) p) → Irreducible p := by
    intro p h
    have hinj := (algebraMap K (AlgebraicClosure K)).injective
    have key : ∀ a : MvPolynomial (Fin 2) K,
        IsUnit (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) a) → IsUnit a := by
      intro a ha
      obtain ⟨r, hr, hra⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp ha
      have hcoeff : ∀ s, s ≠ 0 → a.coeff s = 0 := by
        intro s hs
        apply hinj
        have := congrArg (fun q : MvPolynomial (Fin 2) (AlgebraicClosure K) => q.coeff s) hra
        simp only [MvPolynomial.coeff_map, MvPolynomial.coeff_C, if_neg (Ne.symm hs)] at this
        rw [this, map_zero]
      have ha' : a = MvPolynomial.C (a.coeff 0) := by
        ext s
        rw [MvPolynomial.coeff_C]
        split_ifs with hs
        · rw [hs]
        · exact hcoeff s (Ne.symm hs)
      have h0 : a.coeff 0 ≠ 0 := by
        intro h0
        have := congrArg (fun q : MvPolynomial (Fin 2) (AlgebraicClosure K) => q.coeff 0) hra
        simp only [MvPolynomial.coeff_map, MvPolynomial.coeff_C, h0, map_zero] at this
        exact hr.ne_zero this.symm
      rw [ha']
      exact (isUnit_iff_ne_zero.mpr h0).map MvPolynomial.C
    refine irreducible_iff.mpr ⟨fun hu => h.not_isUnit (hu.map _), fun a b hab => ?_⟩
    have hab' : MvPolynomial.map (algebraMap K (AlgebraicClosure K)) p =
        MvPolynomial.map (algebraMap K (AlgebraicClosure K)) a *
          MvPolynomial.map (algebraMap K (AlgebraicClosure K)) b := by
      rw [hab, map_mul]
    rcases h.isUnit_or_isUnit hab' with ha | hb
    · exact Or.inl (key a ha)
    · exact Or.inr (key b hb)

  have s5 : ∀ G : Polynomial (Polynomial K), G.Monic → Irreducible G →
      Polynomial.derivative G ≠ 0 →
      Polynomial.resultant G (Polynomial.derivative G) G.natDegree
        (Polynomial.derivative G).natDegree ≠ 0 := by
    intro G hmon hirr hd
    set ι := algebraMap (Polynomial K) (FractionRing (Polynomial K)) with hι
    have hinj : Function.Injective ι := IsFractionRing.injective _ _
    have hirr' : Irreducible (G.map ι) :=
      (hmon.irreducible_iff_irreducible_map_fraction_map).mp hirr
    have hdmap : Polynomial.derivative (G.map ι) = (Polynomial.derivative G).map ι :=
      Polynomial.derivative_map _ _
    have hd' : (Polynomial.derivative G).map ι ≠ 0 := by
      intro h0; apply hd
      exact Polynomial.map_injective _ hinj (by rw [h0, Polynomial.map_zero])
    have hG0 : G.natDegree ≠ 0 := by
      intro h0
      apply hd
      rw [Polynomial.eq_C_of_natDegree_eq_zero h0, Polynomial.derivative_C]
    have hlt : ((Polynomial.derivative G).map ι).natDegree < (G.map ι).natDegree := by
      rw [Polynomial.natDegree_map_eq_of_injective hinj,
        Polynomial.natDegree_map_eq_of_injective hinj]
      exact Polynomial.natDegree_derivative_lt hG0
    have hndvd : ¬ (G.map ι) ∣ (Polynomial.derivative G).map ι :=
      (hmon.map ι).not_dvd_of_natDegree_lt hd' hlt
    have hcop : IsCoprime (G.map ι) (Polynomial.derivative (G.map ι)) := by
      rw [hdmap]; exact (hirr'.coprime_iff_not_dvd).mpr hndvd
    have hres := Polynomial.resultant_ne_zero _ _ hcop
    rw [hdmap] at hres
    simp only [Polynomial.natDegree_map_eq_of_injective hinj] at hres
    rw [Polynomial.resultant_map_map] at hres
    intro h0
    apply hres
    rw [h0, map_zero]

  have s6 : ∀ (G H : Polynomial (Polynomial K)) (m N : ℕ), G.Monic → G.natDegree = m →
      ∀ (R : Polynomial K), R ≠ 0 → R.natDegree ≤ N →
      ∀ (p q : Polynomial (Polynomial K)), G * p + H * q = Polynomial.C R →
      Nat.card {z : Fin 2 → K //
        Polynomial.eval (z 1) (Polynomial.map (Polynomial.evalRingHom (z 0)) G) = 0 ∧
        Polynomial.eval (z 1) (Polynomial.map (Polynomial.evalRingHom (z 0)) H) = 0} ≤
        N * m := by
    intro G H m N hmon hdeg R hR hRdeg p q hbez
    let T : Finset (Fin 2 → K) := R.roots.toFinset.biUnion
      (fun a => (G.map (Polynomial.evalRingHom a)).roots.toFinset.image (fun b => ![a, b]))
    have hmem : ∀ z : Fin 2 → K,
        Polynomial.eval (z 1) (Polynomial.map (Polynomial.evalRingHom (z 0)) G) = 0 →
        Polynomial.eval (z 1) (Polynomial.map (Polynomial.evalRingHom (z 0)) H) = 0 →
        z ∈ T := by
      intro z hG hH
      have hRa : R.eval (z 0) = 0 := by
        have := congrArg
          (fun P => Polynomial.eval (z 1) (Polynomial.map (Polynomial.evalRingHom (z 0)) P)) hbez
        simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.eval_add,
          Polynomial.eval_mul, hG, hH, Polynomial.map_C, Polynomial.eval_C, zero_mul, add_zero,
          Polynomial.coe_evalRingHom] at this
        exact this.symm
      have hGa : G.map (Polynomial.evalRingHom (z 0)) ≠ 0 := (hmon.map _).ne_zero
      refine Finset.mem_biUnion.mpr ⟨z 0, ?_, Finset.mem_image.mpr ⟨z 1, ?_, ?_⟩⟩
      · rw [Multiset.mem_toFinset, Polynomial.mem_roots hR]; exact hRa
      · rw [Multiset.mem_toFinset, Polynomial.mem_roots hGa]; exact hG
      · funext i; fin_cases i <;> rfl
    have hcard1 : Nat.card {z : Fin 2 → K //
        Polynomial.eval (z 1) (Polynomial.map (Polynomial.evalRingHom (z 0)) G) = 0 ∧
        Polynomial.eval (z 1) (Polynomial.map (Polynomial.evalRingHom (z 0)) H) = 0} ≤
        T.card := by
      calc _ ≤ Nat.card T :=
            Nat.card_le_card_of_injective (fun z => ⟨z.1, hmem z.1 z.2.1 z.2.2⟩)
              (fun x y hxy => Subtype.ext (by simpa using congrArg Subtype.val hxy))
        _ = T.card := Nat.card_eq_finsetCard T
    have hcard2 : T.card ≤ N * m := by
      calc T.card ≤ ∑ a ∈ R.roots.toFinset,
            ((G.map (Polynomial.evalRingHom a)).roots.toFinset.image (fun b => ![a, b])).card :=
            Finset.card_biUnion_le
        _ ≤ ∑ a ∈ R.roots.toFinset, m := by
            apply Finset.sum_le_sum; intro a _
            calc _ ≤ (G.map (Polynomial.evalRingHom a)).roots.toFinset.card :=
                  Finset.card_image_le
              _ ≤ (G.map (Polynomial.evalRingHom a)).roots.card := Multiset.toFinset_card_le _
              _ ≤ (G.map (Polynomial.evalRingHom a)).natDegree := Polynomial.card_roots' _
              _ = m := by rw [hmon.natDegree_map, hdeg]
        _ = R.roots.toFinset.card * m := by rw [Finset.sum_const, smul_eq_mul]
        _ ≤ N * m := by
            apply Nat.mul_le_mul_right
            exact (Multiset.toFinset_card_le _).trans ((Polynomial.card_roots' R).trans hRdeg)
    exact hcard1.trans hcard2

  set ψ := (MvPolynomial.aeval (R := K)
        (![Polynomial.C Polynomial.X, Polynomial.X] : Fin 2 → Polynomial (Polynomial K))) with hψ
  obtain ⟨hbij, hderψ, heval⟩ := s2
  have hg : Irreducible g := s4 g hirr
  let e : MvPolynomial (Fin 2) K ≃+* Polynomial (Polynomial K) := RingEquiv.ofBijective ψ hbij
  have hGirr : Irreducible (ψ g) := by
    have : Irreducible (e g) := (MulEquiv.irreducible_iff e).mpr hg
    exact this
  obtain ⟨hcb, hmon2⟩ := s3 g m hdeg.le
  obtain ⟨hGmon, hGdeg⟩ := hmon2 hmon
  have hGd : ψ (MvPolynomial.pderiv 1 g) = Polynomial.derivative (ψ g) := hderψ g
  have hG'ne : Polynomial.derivative (ψ g) ≠ 0 := by
    rw [← hGd]; intro h0; apply hder; apply hbij.1; rw [h0, map_zero]
  have hR := s5 (ψ g) hGmon hGirr hG'ne
  rw [hGdeg] at hR
  have hRdeg : (Polynomial.resultant (ψ g) (Polynomial.derivative (ψ g)) m
      (Polynomial.derivative (ψ g)).natDegree).natDegree ≤ m * m := by
    apply s1 (ψ g) (Polynomial.derivative (ψ g)) m _ m hcb
    intro k hk
    rw [Polynomial.coeff_derivative] at hk ⊢
    have hc : (ψ g).coeff (k + 1) ≠ 0 := left_ne_zero_of_mul hk
    have h1 := hcb (k + 1) hc
    have h2 : ((ψ g).coeff (k + 1) * ((k : Polynomial K) + 1)).natDegree ≤
        ((ψ g).coeff (k + 1)).natDegree := by
      refine (Polynomial.natDegree_mul_le).trans ?_
      have : ((k : Polynomial K) + 1).natDegree = 0 := by
        have := Polynomial.natDegree_add_le (k : Polynomial K) 1
        simp only [Polynomial.natDegree_natCast, Polynomial.natDegree_one, max_self] at this
        omega
      omega
    omega
  obtain ⟨p, q, -, -, hbez⟩ := Polynomial.exists_mul_add_mul_eq_C_resultant (m := m)
    (n := (Polynomial.derivative (ψ g)).natDegree) (ψ g) (Polynomial.derivative (ψ g))
    hGdeg.le le_rfl (Or.inl (by omega))
  have hcount := s6 (ψ g) (Polynomial.derivative (ψ g)) m (m * m) hGmon hGdeg _ hR hRdeg p q hbez
  calc Nat.card {z : Fin 2 → K // MvPolynomial.eval z g = 0 ∧
        MvPolynomial.eval z (MvPolynomial.pderiv 1 g) = 0}
      = Nat.card {z : Fin 2 → K //
        Polynomial.eval (z 1) (Polynomial.map (Polynomial.evalRingHom (z 0)) (ψ g)) = 0 ∧
        Polynomial.eval (z 1) (Polynomial.map (Polynomial.evalRingHom (z 0))
          (Polynomial.derivative (ψ g))) = 0} := by
        refine Nat.card_congr (Equiv.subtypeEquivRight fun z => ?_)
        rw [← hGd, heval g z, heval (MvPolynomial.pderiv 1 g) z]
    _ ≤ m * m * m := hcount
    _ = m ^ 3 := by ring

theorem lw_upper_branch_order_sum (K : Type u) [Field K] (m : ℕ)
    (g : MvPolynomial (Fin 2) K) (hm : 1 ≤ m) (hdeg : g.totalDegree = m)
    (hmon : g.coeff (Finsupp.single 1 m) = 1)
    (hirr : Irreducible (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g))
    (S : Finset (Fin 2 → K)) (φ : (Fin 2 → K) → PowerSeries K)
    (hφ0 : ∀ z ∈ S, PowerSeries.constantCoeff (φ z) = z 1)
    (hφg : ∀ z ∈ S, MvPolynomial.aeval
      ![algebraMap K (PowerSeries K) (z 0) + PowerSeries.X, φ z] g = 0)
    (Φ : MvPolynomial (Fin 2) K) (hΦ : ¬ g ∣ Φ) :
    ∑ z ∈ S, (MvPolynomial.aeval
      ![algebraMap K (PowerSeries K) (z 0) + PowerSeries.X, φ z] Φ).order ≤
      ((m * Φ.totalDegree : ℕ) : ℕ∞) :=
by
  classical

  have s1 : ∃ e : MvPolynomial (Fin 2) K ≃+* Polynomial (Polynomial K),
      (∀ (F : MvPolynomial (Fin 2) K) (k i : ℕ),
        ((e F).coeff k).coeff i = F.coeff (Finsupp.single 0 i + Finsupp.single 1 k)) ∧
      (∀ (F : MvPolynomial (Fin 2) K) (a : K) (ψ : PowerSeries K),
        Polynomial.eval ψ (Polynomial.map (Polynomial.eval₂RingHom (algebraMap K (PowerSeries K))
            (algebraMap K (PowerSeries K) a + PowerSeries.X)) (e F)) =
          MvPolynomial.aeval ![algebraMap K (PowerSeries K) a + PowerSeries.X, ψ] F) := by
    let e₁ : MvPolynomial (Fin 2) K →+* Polynomial (Polynomial K) :=
      MvPolynomial.eval₂Hom (Polynomial.C.comp Polynomial.C)
        ![Polynomial.C Polynomial.X, Polynomial.X]
    let e₂ : Polynomial (Polynomial K) →+* MvPolynomial (Fin 2) K :=
      Polynomial.eval₂RingHom (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0))
        (MvPolynomial.X 1)
    have h21 : e₂.comp e₁ = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro r; simp [e₁, e₂]
      · intro i; fin_cases i <;> simp [e₁, e₂]
    have h12 : e₁.comp e₂ = RingHom.id _ := by
      apply Polynomial.ringHom_ext'
      · apply Polynomial.ringHom_ext'
        · ext r : 1; simp [e₁, e₂]
        · simp [e₁, e₂]
      · simp [e₁, e₂]
    refine ⟨RingEquiv.ofRingHom e₁ e₂ h12 h21, ?_, ?_⟩
    · intro F k i
      change ((e₁ F).coeff k).coeff i = _
      induction F using MvPolynomial.induction_on' with
      | monomial s c =>
        have hmon' : e₁ (MvPolynomial.monomial s c) =
            Polynomial.C (Polynomial.C c * Polynomial.X ^ (s 0)) * Polynomial.X ^ (s 1) := by
          simp [e₁, MvPolynomial.eval₂_monomial, Finsupp.prod_fintype, Fin.prod_univ_two]
          ring
        rw [hmon', Polynomial.coeff_C_mul_X_pow, MvPolynomial.coeff_monomial]
        by_cases h1 : k = s 1
        · rw [if_pos h1, Polynomial.coeff_C_mul_X_pow]
          by_cases h2 : i = s 0
          · rw [if_pos h2, if_pos]
            subst h1 h2
            ext j; fin_cases j <;> simp
          · rw [if_neg h2, if_neg]
            rintro rfl
            exact h2 (by simp)
        · rw [if_neg h1, Polynomial.coeff_zero, if_neg]
          rintro rfl
          exact h1 (by simp)
      | add p q hp hq =>
        rw [map_add, Polynomial.coeff_add, Polynomial.coeff_add, hp, hq, MvPolynomial.coeff_add]
    · intro F a ψ
      change Polynomial.eval ψ (Polynomial.map _ (e₁ F)) = _
      have key : (Polynomial.evalRingHom ψ).comp ((Polynomial.mapRingHom
          (Polynomial.eval₂RingHom (algebraMap K (PowerSeries K))
            (algebraMap K (PowerSeries K) a + PowerSeries.X))).comp e₁) =
          (MvPolynomial.aeval ![algebraMap K (PowerSeries K) a + PowerSeries.X, ψ]).toRingHom := by
        apply MvPolynomial.ringHom_ext
        · intro r; simp [e₁]
        · intro i; fin_cases i <;> simp [e₁]
      exact RingHom.congr_fun key F

  have s2 : ∀ (F : MvPolynomial (Fin 2) K) (P : Polynomial (Polynomial K)),
      (∀ k i : ℕ, (P.coeff k).coeff i = F.coeff (Finsupp.single 0 i + Finsupp.single 1 k)) →
      (∀ k : ℕ, P.coeff k ≠ 0 → (P.coeff k).natDegree + k ≤ F.totalDegree) ∧
      P.natDegree ≤ F.totalDegree ∧
      (∀ n : ℕ, F.totalDegree = n → F.coeff (Finsupp.single 1 n) = 1 →
        P.Monic ∧ P.natDegree = n) := by
    intro F P hP
    have hw : ∀ k i : ℕ, (P.coeff k).coeff i ≠ 0 → i + k ≤ F.totalDegree := by
      intro k i hne
      rw [hP] at hne
      have hmem : Finsupp.single 0 i + Finsupp.single 1 k ∈ F.support :=
        MvPolynomial.mem_support_iff.mpr hne
      have := MvPolynomial.le_totalDegree hmem
      rwa [Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl), Finsupp.sum_single_index rfl,
        Finsupp.sum_single_index rfl] at this
    have ha : ∀ k : ℕ, P.coeff k ≠ 0 → (P.coeff k).natDegree + k ≤ F.totalDegree := by
      intro k hk
      apply hw
      rw [Polynomial.coeff_natDegree]
      exact Polynomial.leadingCoeff_ne_zero.mpr hk
    refine ⟨ha, ?_, ?_⟩
    · by_cases hP0 : P = 0
      · simp [hP0]
      · have := ha P.natDegree (by
          rw [Polynomial.coeff_natDegree]; exact Polynomial.leadingCoeff_ne_zero.mpr hP0)
        omega
    · intro n hn h1
      have hc : P.coeff n = 1 := by
        ext i
        rw [hP, Polynomial.coeff_one]
        rcases Nat.eq_zero_or_pos i with rfl | hi
        · simpa using h1
        · rw [if_neg (by omega)]
          by_contra hne
          have := hw n i (by rw [hP]; exact hne)
          omega
      have hle : P.natDegree ≤ n := by
        rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
        intro k hk
        by_contra hne
        have := ha k hne
        have hk' : n < k := by exact_mod_cast hk
        omega
      have hnat : P.natDegree = n :=
        Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hle (by rw [hc]; exact one_ne_zero)
      refine ⟨?_, hnat⟩
      unfold Polynomial.Monic Polynomial.leadingCoeff
      rw [hnat, hc]

  have s3 : ∀ (f h : Polynomial (Polynomial K)) (p q d e : ℕ), p ≤ d → q ≤ e →
      (∀ k : ℕ, f.coeff k ≠ 0 → (f.coeff k).natDegree + k ≤ d) →
      (∀ k : ℕ, h.coeff k ≠ 0 → (h.coeff k).natDegree + k ≤ e) →
      (Polynomial.resultant f h p q).natDegree ≤ d * e := by
    intro f h p q d e hpd hqe hf hg
    let sl : Fin (p + q) → ℕ := fun j => if (j : ℕ) < p then e else d - p
    have hsl1 : ∀ j₁ : Fin p, sl (Fin.castAdd q j₁) = e := fun j₁ => by simp [sl]
    have hsl2 : ∀ j₁ : Fin q, sl (Fin.natAdd p j₁) = d - p := fun j₁ => by simp [sl]
    have hcol1 : ∀ (r : Fin (p + q)) (j₁ : Fin p),
        Polynomial.sylvester f h p q r (Fin.castAdd q j₁) =
        if (r : ℕ) ∈ Set.Icc (j₁ : ℕ) (j₁ + q) then h.coeff (r - j₁) else 0 := by
      intro r j₁
      simp only [Polynomial.sylvester, Matrix.of_apply, Fin.addCases_left]
    have hcol2 : ∀ (r : Fin (p + q)) (j₁ : Fin q),
        Polynomial.sylvester f h p q r (Fin.natAdd p j₁) =
        if (r : ℕ) ∈ Set.Icc (j₁ : ℕ) (j₁ + p) then f.coeff (r - j₁) else 0 := by
      intro r j₁
      simp only [Polynomial.sylvester, Matrix.of_apply, Fin.addCases_right]
    have claim : ∀ r j : Fin (p + q), Polynomial.sylvester f h p q r j ≠ 0 →
        (Polynomial.sylvester f h p q r j).natDegree + r ≤ j + sl j := by
      intro r j
      refine Fin.addCases (fun j₁ => ?_) (fun j₁ => ?_) j
      · intro hne
        rw [hcol1] at hne ⊢
        rw [hsl1, Fin.val_castAdd]
        split_ifs at hne ⊢ with h1
        · have := hg _ hne
          rw [Set.mem_Icc] at h1
          omega
        · exact absurd rfl hne
      · intro hne
        rw [hcol2] at hne ⊢
        rw [hsl2, Fin.val_natAdd]
        split_ifs at hne ⊢ with h1
        · have := hf _ hne
          rw [Set.mem_Icc] at h1
          omega
        · exact absurd rfl hne
    unfold Polynomial.resultant
    rw [Matrix.det_apply']
    apply Polynomial.natDegree_sum_le_of_forall_le
    intro σ _
    by_cases hz : ∏ i, Polynomial.sylvester f h p q (σ i) i = 0
    · rw [hz, mul_zero, Polynomial.natDegree_zero]; exact Nat.zero_le _
    · have hall : ∀ i, Polynomial.sylvester f h p q (σ i) i ≠ 0 :=
        fun i h0 => hz (Finset.prod_eq_zero (Finset.mem_univ i) h0)
      refine (Polynomial.natDegree_mul_le).trans ?_
      rw [Polynomial.natDegree_intCast, zero_add]
      refine (Polynomial.natDegree_prod_le _ _).trans ?_
      have h1 : ∑ i, ((Polynomial.sylvester f h p q (σ i) i).natDegree +
          ((σ i : Fin (p + q)) : ℕ)) ≤ ∑ i : Fin (p + q), ((i : ℕ) + sl i) :=
        Finset.sum_le_sum fun i _ => claim _ _ (hall i)
      rw [Finset.sum_add_distrib, Finset.sum_add_distrib] at h1
      have h4 : ∑ i, ((σ i : Fin (p + q)) : ℕ) = ∑ i : Fin (p + q), (i : ℕ) :=
        Equiv.sum_comp σ (fun i => (i : ℕ))
      have h2 : ∑ i, sl i = p * e + q * (d - p) := by
        rw [Fin.sum_univ_add]
        simp only [hsl1, hsl2, Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
      have h3 : p * e + q * (d - p) ≤ d * e := by
        obtain ⟨r, rfl⟩ := Nat.exists_eq_add_of_le hpd
        rw [Nat.add_sub_cancel_left]
        have := Nat.mul_le_mul_left r hqe
        nlinarith
      rw [h4, h2] at h1
      linarith

  have s4 : ∀ (f h : Polynomial (Polynomial K)), h.Monic → Irreducible h → ¬ h ∣ f →
      Polynomial.resultant f h ≠ 0 := by
    intro f h hmon' hirr' hndvd
    have hinj : Function.Injective (algebraMap (Polynomial K) (FractionRing (Polynomial K))) :=
      IsFractionRing.injective _ _
    have hirr'' : Irreducible (h.map (algebraMap (Polynomial K) (FractionRing (Polynomial K)))) :=
      (hmon'.irreducible_iff_irreducible_map_fraction_map).mp hirr'
    have hnd : ¬ (h.map (algebraMap (Polynomial K) (FractionRing (Polynomial K)))) ∣
        (f.map (algebraMap (Polynomial K) (FractionRing (Polynomial K)))) := by
      intro hd
      apply hndvd
      rw [← Polynomial.modByMonic_eq_zero_iff_dvd hmon']
      apply Polynomial.map_injective _ hinj
      rw [Polynomial.map_modByMonic _ hmon', Polynomial.map_zero]
      exact (Polynomial.modByMonic_eq_zero_iff_dvd (hmon'.map _)).mpr hd
    have hcop : IsCoprime (f.map (algebraMap (Polynomial K) (FractionRing (Polynomial K))))
        (h.map (algebraMap (Polynomial K) (FractionRing (Polynomial K)))) :=
      ((hirr''.coprime_iff_not_dvd).mpr hnd).symm
    have hne := Polynomial.resultant_ne_zero _ _ hcop
    rw [Polynomial.natDegree_map_eq_of_injective hinj,
      Polynomial.natDegree_map_eq_of_injective hinj, Polynomial.resultant_map_map] at hne
    intro h0
    apply hne
    rw [h0, map_zero]

  have s5 : ∀ (R : Polynomial K), R ≠ 0 → ∀ a : K,
      (Polynomial.eval₂ (algebraMap K (PowerSeries K))
        (algebraMap K (PowerSeries K) a + PowerSeries.X) R).order =
        (R.rootMultiplicity a : ℕ∞) := by
    intro R hR a
    have hc : PowerSeries.constantCoeff.comp (Polynomial.eval₂RingHom
        (algebraMap K (PowerSeries K))
        (algebraMap K (PowerSeries K) a + PowerSeries.X)) = Polynomial.evalRingHom a := by
      apply Polynomial.ringHom_ext
      · intro c; simp
      · simp
    have hlin : Polynomial.eval₂RingHom (algebraMap K (PowerSeries K))
        (algebraMap K (PowerSeries K) a + PowerSeries.X) (Polynomial.X - Polynomial.C a) =
        PowerSeries.X := by
      simp
    have hRQ := (Polynomial.pow_mul_divByMonic_rootMultiplicity_eq R a).symm
    have hQ := Polynomial.eval_divByMonic_pow_rootMultiplicity_ne_zero a hR
    generalize R /ₘ (Polynomial.X - Polynomial.C a) ^ R.rootMultiplicity a = Q at hRQ hQ
    generalize R.rootMultiplicity a = k at hRQ hQ ⊢
    have hQ0 : (Polynomial.eval₂RingHom (algebraMap K (PowerSeries K))
        (algebraMap K (PowerSeries K) a + PowerSeries.X) Q).order = 0 := by
      have hne : PowerSeries.coeff 0 (Polynomial.eval₂RingHom (algebraMap K (PowerSeries K))
          (algebraMap K (PowerSeries K) a + PowerSeries.X) Q) ≠ 0 := by
        rw [PowerSeries.coeff_zero_eq_constantCoeff_apply]
        have := RingHom.congr_fun hc Q
        rw [RingHom.comp_apply, Polynomial.coe_evalRingHom] at this
        rw [this]; exact hQ
      have h := (PowerSeries.order_eq_nat (n := 0)).mpr
        ⟨hne, fun i hi => absurd hi (Nat.not_lt_zero _)⟩
      simpa using h
    rw [← Polynomial.coe_eval₂RingHom, hRQ, map_mul, map_pow, hlin, PowerSeries.order_mul,
      PowerSeries.order_X_pow, hQ0, add_zero]

  have s6 : ∀ (f G : Polynomial (PowerSeries K)) (p : ℕ), f.natDegree ≤ p → G.Monic →
      ∀ (s : Finset (Fin 2 → K)) (r : (Fin 2 → K) → PowerSeries K), Set.InjOn r ↑s →
      (∀ i ∈ s, G.eval (r i) = 0) →
      ∃ c : PowerSeries K, Polynomial.resultant f G p G.natDegree =
        (∏ i ∈ s, ((-1) ^ p * f.eval (r i))) * c := by
    intro f G p hf hG s r hr hroot
    have hPdvd : (∏ i ∈ s, (Polynomial.X - Polynomial.C (r i))) ∣ G := by
      have hnd : (s.val.map r).Nodup := Multiset.Nodup.map_on hr s.nodup
      have hle : s.val.map r ≤ G.roots := by
        rw [Multiset.le_iff_subset hnd]
        intro x hx
        obtain ⟨i, hi, rfl⟩ := Multiset.mem_map.mp hx
        exact (Polynomial.mem_roots hG.ne_zero).mpr (hroot i hi)
      have := (Multiset.prod_X_sub_C_dvd_iff_le_roots hG.ne_zero _).mpr hle
      rw [Multiset.map_map] at this
      exact this
    obtain ⟨h, hGh⟩ := hPdvd
    have hPmon : (∏ i ∈ s, (Polynomial.X - Polynomial.C (r i))).Monic :=
      Polynomial.monic_prod_of_monic _ _ (fun i _ => Polynomial.monic_X_sub_C (r i))
    have hhmon' : h.Monic := hPmon.of_mul_monic_left (hGh ▸ hG)
    have hdeg' : G.natDegree = (∏ i ∈ s, (Polynomial.X - Polynomial.C (r i))).natDegree +
        h.natDegree := by rw [hGh, hPmon.natDegree_mul hhmon']
    refine ⟨f.resultant h p, ?_⟩
    rw [hdeg', hGh, Polynomial.resultant_mul_right f _ h p hf]
    congr 1
    rw [Polynomial.resultant_prod_right s f _ p hf]
    · apply Finset.prod_congr rfl
      intro i _
      rw [Polynomial.natDegree_X_sub_C, Polynomial.resultant_X_sub_C_right f p (r i) hf]
    · simp [Polynomial.leadingCoeff_X_sub_C]

  have s7 : Irreducible g := by
    have hunit : ∀ a : MvPolynomial (Fin 2) K,
        IsUnit (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) a) → IsUnit a := by
      intro a ha
      obtain ⟨r, hr, hra⟩ := MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp ha
      have hcoef : ∀ s, s ≠ 0 → a.coeff s = 0 := by
        intro s hs
        have : (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) a).coeff s =
            (MvPolynomial.C r : MvPolynomial (Fin 2) (AlgebraicClosure K)).coeff s := by
          rw [hra]
        rw [MvPolynomial.coeff_map, MvPolynomial.coeff_C, if_neg (Ne.symm hs)] at this
        exact (map_eq_zero_iff _ (algebraMap K (AlgebraicClosure K)).injective).mp this
      have h0 : a.coeff 0 ≠ 0 := by
        intro h0
        have : (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) a).coeff 0 =
            (MvPolynomial.C r : MvPolynomial (Fin 2) (AlgebraicClosure K)).coeff 0 := by
          rw [hra]
        rw [MvPolynomial.coeff_map, MvPolynomial.coeff_C, if_pos rfl, h0, map_zero] at this
        exact hr.ne_zero this.symm
      have ha' : a = MvPolynomial.C (a.coeff 0) := by
        ext s
        rw [MvPolynomial.coeff_C]
        split_ifs with hs
        · rw [← hs]
        · exact hcoef s (Ne.symm hs)
      rw [ha']
      exact (Ne.isUnit h0).map MvPolynomial.C
    refine ⟨fun hg => hirr.not_isUnit (hg.map _), ?_⟩
    intro a b hab
    rcases hirr.isUnit_or_isUnit (show MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g =
        MvPolynomial.map (algebraMap K (AlgebraicClosure K)) a *
          MvPolynomial.map (algebraMap K (AlgebraicClosure K)) b by
            rw [hab, map_mul]) with ha | hb
    · exact Or.inl (hunit a ha)
    · exact Or.inr (hunit b hb)

  have s8 : ∀ (R : Polynomial K) (T : Finset K),
      ∑ a ∈ T, R.rootMultiplicity a ≤ R.natDegree := by
    intro R T
    calc ∑ a ∈ T, R.rootMultiplicity a = ∑ a ∈ T, R.roots.count a := by
          simp [Polynomial.count_roots]
      _ ≤ ∑ a ∈ T ∪ R.roots.toFinset, R.roots.count a :=
          Finset.sum_le_sum_of_subset Finset.subset_union_left
      _ = ∑ a ∈ R.roots.toFinset, R.roots.count a := by
          symm
          apply Finset.sum_subset Finset.subset_union_right
          intro x _ hx
          exact Multiset.count_eq_zero.mpr (fun h => hx (Multiset.mem_toFinset.mpr h))
      _ = Multiset.card R.roots := Multiset.toFinset_sum_count_eq _
      _ ≤ R.natDegree := Polynomial.card_roots' R

  obtain ⟨e, hcoef, heval⟩ := s1
  obtain ⟨hfk, hfd, -⟩ := s2 Φ (e Φ) (hcoef Φ)
  obtain ⟨hgk, -, hgm⟩ := s2 g (e g) (hcoef g)
  obtain ⟨hhmon, hhdeg⟩ := hgm m hdeg hmon
  rw [hdeg] at hgk
  have hhirr : Irreducible (e g) := (MulEquiv.irreducible_iff e).mpr s7
  have hndvd : ¬ e g ∣ e Φ := by
    intro hd
    apply hΦ
    simpa using map_dvd e.symm hd
  have hR0 : Polynomial.resultant (e Φ) (e g) ≠ 0 := s4 (e Φ) (e g) hhmon hhirr hndvd
  have hRdeg : (Polynomial.resultant (e Φ) (e g)).natDegree ≤ Φ.totalDegree * m :=
    s3 (e Φ) (e g) (e Φ).natDegree (e g).natDegree Φ.totalDegree m hfd (le_of_eq hhdeg) hfk hgk
  have hfib : ∀ a : K, ∑ z ∈ S with z 0 = a, (MvPolynomial.aeval
      ![algebraMap K (PowerSeries K) (z 0) + PowerSeries.X, φ z] Φ).order ≤
      ((Polynomial.resultant (e Φ) (e g)).rootMultiplicity a : ℕ∞) := by
    intro a
    have hGmon := hhmon.map (Polynomial.eval₂RingHom (algebraMap K (PowerSeries K))
      (algebraMap K (PowerSeries K) a + PowerSeries.X))
    have hGdeg : ((e g).map (Polynomial.eval₂RingHom (algebraMap K (PowerSeries K))
        (algebraMap K (PowerSeries K) a + PowerSeries.X))).natDegree = (e g).natDegree :=
      hhmon.natDegree_map _
    have hFdeg : ((e Φ).map (Polynomial.eval₂RingHom (algebraMap K (PowerSeries K))
        (algebraMap K (PowerSeries K) a + PowerSeries.X))).natDegree ≤ (e Φ).natDegree :=
      Polynomial.natDegree_map_le
    have hroot : ∀ z ∈ S.filter (fun z => z 0 = a), ((e g).map (Polynomial.eval₂RingHom
        (algebraMap K (PowerSeries K)) (algebraMap K (PowerSeries K) a + PowerSeries.X))).eval
          (φ z) = 0 := by
      intro z hz
      obtain ⟨hzS, hza⟩ := Finset.mem_filter.mp hz
      rw [heval g a (φ z), ← hza]
      exact hφg z hzS
    have hEz : ∀ z ∈ S.filter (fun z => z 0 = a), ((e Φ).map (Polynomial.eval₂RingHom
        (algebraMap K (PowerSeries K)) (algebraMap K (PowerSeries K) a + PowerSeries.X))).eval
          (φ z) = MvPolynomial.aeval
            ![algebraMap K (PowerSeries K) (z 0) + PowerSeries.X, φ z] Φ := by
      intro z hz
      obtain ⟨_, hza⟩ := Finset.mem_filter.mp hz
      rw [heval Φ a (φ z), hza]
    have hinj : Set.InjOn φ ↑(S.filter (fun z => z 0 = a)) := by
      intro z hz z' hz' hzz
      obtain ⟨hzS, hza⟩ := Finset.mem_filter.mp hz
      obtain ⟨hzS', hza'⟩ := Finset.mem_filter.mp hz'
      have h1 : z 1 = z' 1 := by rw [← hφ0 z hzS, ← hφ0 z' hzS', hzz]
      funext i
      fin_cases i
      · exact hza.trans hza'.symm
      · exact h1
    obtain ⟨c, hc⟩ := s6 _ _ (e Φ).natDegree hFdeg hGmon _ φ hinj hroot
    rw [hGdeg, Polynomial.resultant_map_map] at hc
    have hord := congrArg PowerSeries.order hc
    rw [PowerSeries.order_mul, PowerSeries.order_prod, Polynomial.coe_eval₂RingHom,
      s5 _ hR0 a] at hord
    rw [hord]
    calc ∑ z ∈ S with z 0 = a, (MvPolynomial.aeval
          ![algebraMap K (PowerSeries K) (z 0) + PowerSeries.X, φ z] Φ).order
        = ∑ z ∈ S with z 0 = a, ((-1) ^ (e Φ).natDegree * ((e Φ).map
            (Polynomial.eval₂RingHom (algebraMap K (PowerSeries K))
              (algebraMap K (PowerSeries K) a + PowerSeries.X))).eval (φ z)).order := by
          apply Finset.sum_congr rfl
          intro z hz
          rw [PowerSeries.order_mul, PowerSeries.order_zero_of_isUnit
            ((isUnit_one (M := PowerSeries K)).neg.pow _), zero_add, hEz z hz]
      _ ≤ _ := le_self_add
  have hmaps : ∀ z ∈ S, z 0 ∈ S.image (fun z => z 0) := fun z hz => Finset.mem_image_of_mem _ hz
  rw [← Finset.sum_fiberwise_of_maps_to hmaps]
  refine (Finset.sum_le_sum fun a _ => hfib a).trans ?_
  rw [← Nat.cast_sum]
  exact_mod_cast (s8 _ _).trans (hRdeg.trans (le_of_eq (mul_comm _ _)))

theorem lw_stepanov_universal_branch (K : Type u) [Field K] (m : ℕ)
    (g : MvPolynomial (Fin 2) K) (hdeg : g.totalDegree ≤ m) :
    ∃ W : PowerSeries (MvPolynomial (Fin 2) K),
      PowerSeries.constantCoeff W = 0 ∧
      MvPolynomial.aeval ![PowerSeries.C (MvPolynomial.X 0) +
          PowerSeries.C (MvPolynomial.pderiv 1 g ^ 2) * PowerSeries.X,
        PowerSeries.C (MvPolynomial.X 1) + W] g = PowerSeries.C g ∧
      ∀ (f : MvPolynomial (Fin 2) K) (l : ℕ),
        (PowerSeries.coeff l (MvPolynomial.aeval ![PowerSeries.C (MvPolynomial.X 0) +
            PowerSeries.C (MvPolynomial.pderiv 1 g ^ 2) * PowerSeries.X,
          PowerSeries.C (MvPolynomial.X 1) + W] f)).totalDegree ≤ f.totalDegree + 2 * l * m :=
by
  classical

  have sb_mono : ∀ (δ δ' : ℤ) (F : PowerSeries (MvPolynomial (Fin 2) K)), δ ≤ δ' →
      lwubSB m δ F → lwubSB m δ' F := by
    intro δ δ' F h hF k s hs
    linarith [hF k s hs]
  have sb_add : ∀ (δ : ℤ) (F G : PowerSeries (MvPolynomial (Fin 2) K)),
      lwubSB m δ F → lwubSB m δ G → lwubSB m δ (F + G) := by
    intro δ F G hF hG k s hs
    rw [map_add] at hs
    rcases Finset.mem_union.mp (MvPolynomial.support_add hs) with h | h
    · exact hF k s h
    · exact hG k s h
  have sb_neg : ∀ (δ : ℤ) (F : PowerSeries (MvPolynomial (Fin 2) K)),
      lwubSB m δ F → lwubSB m δ (-F) := by
    intro δ F hF k s hs
    rw [map_neg, MvPolynomial.support_neg] at hs
    exact hF k s hs
  have sb_sum : ∀ (δ : ℤ) {ι : Type} (S : Finset ι)
      (f : ι → PowerSeries (MvPolynomial (Fin 2) K)),
      (∀ i ∈ S, lwubSB m δ (f i)) → lwubSB m δ (∑ i ∈ S, f i) := by
    intro δ ι S f hf k s hs
    rw [map_sum] at hs
    obtain ⟨i, hi, hs'⟩ := Finset.mem_biUnion.mp (MvPolynomial.support_sum hs)
    exact hf i hi k s hs'
  have sb_mul : ∀ (δ ε : ℤ) (F G : PowerSeries (MvPolynomial (Fin 2) K)),
      lwubSB m δ F → lwubSB m ε G → lwubSB m (δ + ε) (F * G) := by
    intro δ ε F G hF hG k s hs
    rw [PowerSeries.coeff_mul] at hs
    obtain ⟨p, hp, hs1⟩ := Finset.mem_biUnion.mp (MvPolynomial.support_sum hs)
    obtain ⟨s1, h1, s2, h2, rfl⟩ := Finset.mem_add.mp (MvPolynomial.support_mul _ _ hs1)
    have e := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
    have a1 := hF _ _ h1
    have a2 := hG _ _ h2
    have e' : (k : ℤ) = (p.1 : ℤ) + (p.2 : ℤ) := by exact_mod_cast e.symm
    simp only [Finsupp.add_apply]
    push_cast at a1 a2 ⊢
    rw [e']
    linarith
  have sb_C : ∀ (d : ℕ) (r : MvPolynomial (Fin 2) K), r.totalDegree ≤ d →
      lwubSB m (d : ℤ) (PowerSeries.C r) := by
    intro d r hr k s hs
    rw [PowerSeries.coeff_C] at hs
    split_ifs at hs with hk
    · have h1 := MvPolynomial.le_totalDegree hs
      rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two] at h1
      subst hk
      have : ((s 0 + s 1 : ℕ) : ℤ) ≤ d := by exact_mod_cast h1.trans hr
      push_cast at this ⊢
      linarith
    · simp at hs
  have sb_X : lwubSB m (-(2 * (m : ℤ))) (PowerSeries.X : PowerSeries (MvPolynomial (Fin 2) K)) := by
    intro k s hs
    rw [PowerSeries.coeff_X] at hs
    split_ifs at hs with hk
    · rw [MvPolynomial.support_one, Finset.mem_singleton] at hs
      subst hs
      subst hk
      simp
    · simp at hs
  have sb_one : lwubSB m 0 (1 : PowerSeries (MvPolynomial (Fin 2) K)) := by
    have h := sb_C 0 1 (by simp)
    rw [map_one] at h
    exact_mod_cast h
  have sb_pow : ∀ (δ : ℤ) (F : PowerSeries (MvPolynomial (Fin 2) K)), lwubSB m δ F →
      ∀ n : ℕ, lwubSB m ((n : ℤ) * δ) (F ^ n) := by
    intro δ F hF n
    induction n with
    | zero => simpa using sb_one
    | succ n ih =>
      rw [pow_succ]
      exact sb_mono _ _ _ (le_of_eq (by push_cast; ring)) (sb_mul _ _ _ _ ih hF)
  have sb_aeval : ∀ (A B : PowerSeries (MvPolynomial (Fin 2) K)), lwubSB m 1 A → lwubSB m 1 B →
      ∀ f : MvPolynomial (Fin 2) K,
      lwubSB m (f.totalDegree : ℤ) (MvPolynomial.aeval ![A, B] f) := by
    intro A B hA hB f
    have key : ∀ s ∈ f.support, lwubSB m (f.totalDegree : ℤ)
        (MvPolynomial.aeval ![A, B] (MvPolynomial.monomial s (f.coeff s))) := by
      intro s hs
      rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
        Fin.prod_univ_two, PowerSeries.algebraMap_apply, MvPolynomial.algebraMap_eq]
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      have h1 := sb_mul _ _ _ _ (sb_C 0 (MvPolynomial.C (f.coeff s)) (by simp))
        (sb_mul _ _ _ _ (sb_pow _ _ hA (s 0)) (sb_pow _ _ hB (s 1)))
      refine sb_mono _ _ _ ?_ h1
      have h2 := MvPolynomial.le_totalDegree hs
      rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two] at h2
      have h3 : ((s 0 + s 1 : ℕ) : ℤ) ≤ f.totalDegree := by exact_mod_cast h2
      push_cast at h3 ⊢
      linarith
    have := sb_sum _ f.support _ key
    rwa [← map_sum, ← MvPolynomial.as_sum] at this

  have taylor : ∃ t : ℕ → ℕ → MvPolynomial (Fin 2) K,
      t 0 0 = g ∧ t 0 1 = MvPolynomial.pderiv 1 g ∧ (∀ a b, (t a b).totalDegree ≤ m) ∧
      ∀ (N : ℕ), m < N → ∀ x y : PowerSeries (MvPolynomial (Fin 2) K),
        MvPolynomial.aeval ![PowerSeries.C (MvPolynomial.X 0) + x,
            PowerSeries.C (MvPolynomial.X 1) + y] g =
          ∑ a ∈ Finset.range N, ∑ b ∈ Finset.range N,
            PowerSeries.C (t a b) * x ^ a * y ^ b := by
    refine ⟨fun a b => ∑ s ∈ g.support,
      MvPolynomial.monomial (s - (Finsupp.single 0 a + Finsupp.single 1 b))
        (g.coeff s * ((s 0).choose a : K) * ((s 1).choose b : K)), ?_, ?_, ?_, ?_⟩
    · simp only [Finsupp.single_zero, add_zero, tsub_zero, Nat.choose_zero_right, Nat.cast_one,
        mul_one]
      exact (MvPolynomial.as_sum g).symm
    · conv_rhs => rw [MvPolynomial.as_sum g]
      rw [map_sum]
      refine Finset.sum_congr rfl (fun s _ => ?_)
      rw [MvPolynomial.pderiv_monomial]
      simp only [Finsupp.single_zero, zero_add, Nat.choose_zero_right, Nat.cast_one, mul_one,
        Nat.choose_one_right]
    · intro a b
      refine MvPolynomial.totalDegree_finsetSum_le (fun s hs => ?_)
      refine (MvPolynomial.totalDegree_monomial_le _ _).trans ?_
      have h1 := MvPolynomial.le_totalDegree hs
      rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two] at h1
      rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two]
      simp only [Finsupp.tsub_apply, Finsupp.add_apply, id]
      simp [Finsupp.single_apply]
      omega
    · intro N hN x y
      have hexp : ∀ (z w : PowerSeries (MvPolynomial (Fin 2) K)) (p : ℕ), p < N →
          (w + z) ^ p = ∑ a ∈ Finset.range N, z ^ a * w ^ (p - a) * (p.choose a : PowerSeries _) := by
        intro z w p hp
        rw [add_comm, add_pow]
        apply Finset.sum_subset
        · intro a ha
          simp only [Finset.mem_range] at ha ⊢
          omega
        · intro a _ ha
          simp only [Finset.mem_range] at ha
          rw [Nat.choose_eq_zero_of_lt (by omega), Nat.cast_zero, mul_zero]
      have hclaim : ∀ s ∈ g.support,
          MvPolynomial.aeval ![PowerSeries.C (MvPolynomial.X 0) + x,
            PowerSeries.C (MvPolynomial.X 1) + y] (MvPolynomial.monomial s (g.coeff s)) =
          ∑ a ∈ Finset.range N, ∑ b ∈ Finset.range N,
            PowerSeries.C (MvPolynomial.monomial (s - (Finsupp.single 0 a + Finsupp.single 1 b))
              (g.coeff s * ((s 0).choose a : K) * ((s 1).choose b : K))) * x ^ a * y ^ b := by
        intro s hs
        have h1 := MvPolynomial.le_totalDegree hs
        rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two] at h1
        rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
          Fin.prod_univ_two, PowerSeries.algebraMap_apply, MvPolynomial.algebraMap_eq]
        simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
        rw [hexp x _ (s 0) (by omega), hexp y _ (s 1) (by omega), Finset.sum_mul_sum,
          Finset.mul_sum]
        refine Finset.sum_congr rfl (fun a _ => ?_)
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun b _ => ?_)
        rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
          Fin.prod_univ_two]
        simp only [Finsupp.tsub_apply, Finsupp.add_apply]
        simp only [Finsupp.single_apply, Fin.isValue, if_true, if_false, zero_ne_one,
          one_ne_zero, add_zero, zero_add, map_mul, map_pow, map_natCast]
        ring
      calc MvPolynomial.aeval ![PowerSeries.C (MvPolynomial.X 0) + x,
            PowerSeries.C (MvPolynomial.X 1) + y] g
          = ∑ s ∈ g.support, ∑ a ∈ Finset.range N, ∑ b ∈ Finset.range N,
            PowerSeries.C (MvPolynomial.monomial (s - (Finsupp.single 0 a + Finsupp.single 1 b))
              (g.coeff s * ((s 0).choose a : K) * ((s 1).choose b : K))) * x ^ a * y ^ b := by
            conv_lhs => rw [MvPolynomial.as_sum g]
            rw [map_sum]
            exact Finset.sum_congr rfl hclaim
        _ = ∑ a ∈ Finset.range N, ∑ s ∈ g.support, ∑ b ∈ Finset.range N,
            PowerSeries.C (MvPolynomial.monomial (s - (Finsupp.single 0 a + Finsupp.single 1 b))
              (g.coeff s * ((s 0).choose a : K) * ((s 1).choose b : K))) * x ^ a * y ^ b :=
            Finset.sum_comm
        _ = ∑ a ∈ Finset.range N, ∑ b ∈ Finset.range N, ∑ s ∈ g.support,
            PowerSeries.C (MvPolynomial.monomial (s - (Finsupp.single 0 a + Finsupp.single 1 b))
              (g.coeff s * ((s 0).choose a : K) * ((s 1).choose b : K))) * x ^ a * y ^ b :=
            Finset.sum_congr rfl (fun a _ => Finset.sum_comm)
        _ = _ := by
            simp only [map_sum, Finset.sum_mul]

  obtain ⟨t, ht00, ht01, htdeg, hTay⟩ := taylor
  set c := MvPolynomial.pderiv 1 g with hcdef
  have hc : c.totalDegree ≤ m := ht01 ▸ htdeg 0 1
  obtain ⟨r, hr⟩ : ∃ r : ℕ → ℕ → MvPolynomial (Fin 2) K,
      ∀ a b, r a b = t a b * c ^ (2 * a + b - 2) := ⟨_, fun _ _ => rfl⟩
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : PowerSeries (MvPolynomial (Fin 2) K) → PowerSeries (MvPolynomial (Fin 2) K),
      ∀ A, Ψ A = ∑ a ∈ Finset.range (m + 2), ∑ b ∈ Finset.range (m + 2),
        if 2 ≤ 2 * a + b then PowerSeries.C (r a b) * PowerSeries.X ^ a * A ^ b else 0 :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨Θ, hΘ⟩ : ∃ Θ : PowerSeries (MvPolynomial (Fin 2) K) → PowerSeries (MvPolynomial (Fin 2) K),
      ∀ Y, Θ Y = -Ψ (Y - PowerSeries.C (PowerSeries.constantCoeff Y)) := ⟨_, fun _ => rfl⟩

  have hΨX : ∀ A, PowerSeries.X ∣ A → PowerSeries.X ∣ Ψ A := by
    intro A hA
    rw [hΨ]
    refine Finset.dvd_sum (fun a _ => Finset.dvd_sum (fun b _ => ?_))
    split_ifs with hab
    · rcases Nat.eq_zero_or_pos a with ha | ha
      · subst ha
        have hb : b ≠ 0 := by omega
        exact Dvd.dvd.mul_left (dvd_pow hA hb) _
      · exact Dvd.dvd.mul_right (Dvd.dvd.mul_left (dvd_pow_self _ (by omega)) _) _
    · exact dvd_zero _
  have hΨc : ∀ (n : ℕ) (A B : PowerSeries (MvPolynomial (Fin 2) K)), PowerSeries.X ∣ A →
      PowerSeries.X ∣ B → PowerSeries.X ^ n ∣ A - B → PowerSeries.X ^ (n + 1) ∣ Ψ A - Ψ B := by
    intro n A B hA hB hAB
    rw [hΨ, hΨ, ← Finset.sum_sub_distrib]
    refine Finset.dvd_sum (fun a _ => ?_)
    rw [← Finset.sum_sub_distrib]
    refine Finset.dvd_sum (fun b _ => ?_)
    split_ifs with hab
    · rw [← mul_sub, mul_assoc]
      apply Dvd.dvd.mul_left
      rcases Nat.eq_zero_or_pos a with ha | ha
      · subst ha
        obtain ⟨b', rfl⟩ : ∃ b', b = b' + 1 := ⟨b - 1, by omega⟩
        have hb' : b' ≠ 0 := by omega
        have e : A ^ (b' + 1) - B ^ (b' + 1) = A * (A ^ b' - B ^ b') + (A - B) * B ^ b' := by ring
        rw [pow_zero, one_mul, e, pow_succ]
        refine dvd_add ?_ ?_
        · exact dvd_trans (mul_comm _ _).dvd
            (mul_dvd_mul hA (dvd_trans hAB (sub_dvd_pow_sub_pow _ _ _)))
        · exact mul_dvd_mul hAB (dvd_pow hB hb')
      · rw [pow_succ]
        exact dvd_trans (mul_comm _ _).dvd
          (mul_dvd_mul (dvd_pow_self _ (by omega)) (dvd_trans hAB (sub_dvd_pow_sub_pow _ _ _)))
    · rw [sub_zero]; exact dvd_zero _
  have hZX : ∀ Y : PowerSeries (MvPolynomial (Fin 2) K),
      PowerSeries.X ∣ Y - PowerSeries.C (PowerSeries.constantCoeff Y) := by
    intro Y
    rw [PowerSeries.X_dvd_iff, map_sub, PowerSeries.constantCoeff_C, sub_self]
  have hZc : ∀ (n : ℕ) (Y Y' : PowerSeries (MvPolynomial (Fin 2) K)), PowerSeries.X ^ n ∣ Y - Y' →
      PowerSeries.X ^ n ∣ (Y - PowerSeries.C (PowerSeries.constantCoeff Y)) -
        (Y' - PowerSeries.C (PowerSeries.constantCoeff Y')) := by
    intro n Y Y' h
    rcases Nat.eq_zero_or_pos n with hn | hn
    · subst hn; simp
    · have h1 : PowerSeries.X ∣ Y - Y' := dvd_trans (dvd_pow_self _ hn.ne') h
      rw [PowerSeries.X_dvd_iff, map_sub, sub_eq_zero] at h1
      rw [h1, sub_sub_sub_cancel_right]
      exact h
  have hΘc : ∀ (n : ℕ) (Y Y' : PowerSeries (MvPolynomial (Fin 2) K)), PowerSeries.X ^ n ∣ Y - Y' →
      PowerSeries.X ^ (n + 1) ∣ Θ Y - Θ Y' := by
    intro n Y Y' h
    rw [hΘ, hΘ, neg_sub_neg, ← neg_sub]
    exact dvd_neg.mpr (hΨc n _ _ (hZX Y) (hZX Y') (hZc n Y Y' h))

  obtain ⟨Yn, hYn⟩ : ∃ Yn : ℕ → PowerSeries (MvPolynomial (Fin 2) K), ∀ n, Yn n = Θ^[n] 0 :=
    ⟨_, fun _ => rfl⟩
  have hYsucc : ∀ n, Yn (n + 1) = Θ (Yn n) := by
    intro n
    rw [hYn, hYn, Function.iterate_succ_apply']
  have hY0' : Yn 0 = 0 := by rw [hYn]; rfl
  have hA : ∀ n, PowerSeries.X ^ n ∣ Yn (n + 1) - Yn n := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      have h := hΘc n _ _ ih
      rw [← hYsucc (n + 1), ← hYsucc n] at h
      exact h
  have hB : ∀ k j, PowerSeries.X ^ (k + 1) ∣ Yn (k + 1 + j) - Yn (k + 1) := by
    intro k j
    induction j with
    | zero => simp
    | succ j ih =>
      have e : Yn (k + 1 + (j + 1)) - Yn (k + 1) =
          (Yn (k + 1 + j + 1) - Yn (k + 1 + j)) + (Yn (k + 1 + j) - Yn (k + 1)) := by
        rw [show k + 1 + (j + 1) = k + 1 + j + 1 by omega]; ring
      rw [e]
      exact dvd_add (dvd_trans (pow_dvd_pow _ (by omega)) (hA _)) ih
  obtain ⟨Y, hYcoeff⟩ : ∃ Y : PowerSeries (MvPolynomial (Fin 2) K),
      ∀ k, PowerSeries.coeff k Y = PowerSeries.coeff k (Yn (k + 1)) :=
    ⟨PowerSeries.mk (fun k => PowerSeries.coeff k (Yn (k + 1))), fun k => PowerSeries.coeff_mk _ _⟩
  have hYYn : ∀ n, PowerSeries.X ^ n ∣ Y - Yn n := by
    intro n
    rw [PowerSeries.X_pow_dvd_iff]
    intro k hk
    rw [map_sub, hYcoeff, sub_eq_zero]
    obtain ⟨j, rfl⟩ : ∃ j, n = k + 1 + j := ⟨n - (k + 1), by omega⟩
    have := (PowerSeries.X_pow_dvd_iff.mp (hB k j)) k (by omega)
    rw [map_sub, sub_eq_zero] at this
    exact this.symm
  have hfix : Θ Y = Y := by
    ext n
    have h1 := (PowerSeries.X_pow_dvd_iff.mp (hΘc n _ _ (hYYn n))) n (by omega)
    rw [map_sub, sub_eq_zero] at h1
    rw [h1, ← hYsucc, hYcoeff]
  have hY0 : PowerSeries.constantCoeff Y = 0 := by
    have h := hΨX _ (hZX Y)
    rw [PowerSeries.X_dvd_iff] at h
    rw [← hfix, hΘ, map_neg, h, neg_zero]
  have hYeq : Y = -Ψ Y := by
    have h := hfix
    rw [hΘ, hY0, map_zero, sub_zero] at h
    exact h.symm

  have hΘw : ∀ Y' : PowerSeries (MvPolynomial (Fin 2) K), lwubSB m (-(m : ℤ)) Y' →
      lwubSB m (-(m : ℤ)) (Θ Y') := by
    intro Y' hY'
    have hZ : lwubSB m (-(m : ℤ)) (Y' - PowerSeries.C (PowerSeries.constantCoeff Y')) := by
      intro k s hs
      rw [map_sub, PowerSeries.coeff_C] at hs
      split_ifs at hs with hk
      · subst hk
        rw [PowerSeries.coeff_zero_eq_constantCoeff_apply, sub_self] at hs
        simp at hs
      · rw [sub_zero] at hs
        exact hY' k s hs
    rw [hΘ]
    apply sb_neg
    rw [hΨ]
    refine sb_sum _ _ _ (fun a _ => sb_sum _ _ _ (fun b _ => ?_))
    split_ifs with hab
    · obtain ⟨e, he⟩ : ∃ e, 2 * a + b = e + 2 := ⟨2 * a + b - 2, by omega⟩
      have hrd : (r a b).totalDegree ≤ m + e * m := by
        rw [hr, show 2 * a + b - 2 = e by omega]
        exact (MvPolynomial.totalDegree_mul _ _).trans (add_le_add (htdeg a b)
          ((MvPolynomial.totalDegree_pow _ _).trans (Nat.mul_le_mul_left _ hc)))
      have h1 := sb_mul _ _ _ _ (sb_mul _ _ _ _ (sb_C _ _ hrd) (sb_pow _ _ sb_X a))
        (sb_pow _ _ hZ b)
      refine sb_mono _ _ _ (le_of_eq ?_) h1
      have he' : (e : ℤ) + 2 = 2 * (a : ℤ) + (b : ℤ) := by exact_mod_cast he.symm
      push_cast
      linear_combination (m : ℤ) * he'
    · intro k s hs
      simp at hs
  have hYnw : ∀ n, lwubSB m (-(m : ℤ)) (Yn n) := by
    intro n
    induction n with
    | zero =>
      intro k s hs
      rw [hY0', map_zero] at hs
      simp at hs
    | succ n ih =>
      rw [hYsucc]
      exact hΘw _ ih
  have hYw : lwubSB m (-(m : ℤ)) Y := by
    intro k s hs
    rw [hYcoeff] at hs
    exact hYnw (k + 1) k s hs

  have hterm : ∀ a b, PowerSeries.C (t a b) * (PowerSeries.C (c ^ 2) * PowerSeries.X) ^ a *
        (PowerSeries.C c * Y) ^ b =
      (if a = 0 then (if b = 0 then PowerSeries.C g else 0) else 0) +
      (if a = 0 then (if b = 1 then PowerSeries.C (c ^ 2) * Y else 0) else 0) +
      PowerSeries.C (c ^ 2) *
        (if 2 ≤ 2 * a + b then PowerSeries.C (r a b) * PowerSeries.X ^ a * Y ^ b else 0) := by
    intro a b
    by_cases hab : 2 ≤ 2 * a + b
    · have hx : (if a = 0 then (if b = 0 then PowerSeries.C g else 0) else
          (0 : PowerSeries (MvPolynomial (Fin 2) K))) = 0 := by
        split_ifs <;> first | rfl | omega
      have hy : (if a = 0 then (if b = 1 then PowerSeries.C (c ^ 2) * Y else 0) else
          (0 : PowerSeries (MvPolynomial (Fin 2) K))) = 0 := by
        split_ifs <;> first | rfl | omega
      rw [hx, hy, if_pos hab, zero_add, zero_add]
      obtain ⟨e, he⟩ : ∃ e, 2 * a + b = e + 2 := ⟨2 * a + b - 2, by omega⟩
      have hre : r a b = t a b * c ^ e := by rw [hr, show 2 * a + b - 2 = e by omega]
      have hce' : (c ^ 2) ^ a * c ^ b = c ^ 2 * c ^ e := by
        rw [← pow_mul, ← pow_add, ← pow_add, he]; ring
      have hce : PowerSeries.C (c ^ 2) ^ a * PowerSeries.C c ^ b =
          PowerSeries.C (c ^ 2) * PowerSeries.C (c ^ e) := by
        rw [← map_mul PowerSeries.C (c ^ 2) (c ^ e), ← hce', map_mul,
          map_pow PowerSeries.C (c ^ 2) a, map_pow PowerSeries.C c b]
      rw [hre, map_mul PowerSeries.C (t a b) (c ^ e), mul_pow, mul_pow]
      linear_combination (PowerSeries.C (t a b) * PowerSeries.X ^ a * Y ^ b) * hce
    · have hcases : (a = 0 ∧ b = 0) ∨ (a = 0 ∧ b = 1) := by omega
      rw [if_neg hab, mul_zero, add_zero]
      rcases hcases with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · simp [ht00]
      · simp only [if_true, one_ne_zero, if_false, zero_add, pow_zero, pow_one, mul_one, ht01,
          map_pow]
        ring
  have hs1 : ∀ (F : PowerSeries (MvPolynomial (Fin 2) K)) (j : ℕ), j < m + 2 →
      ∑ a ∈ Finset.range (m + 2), ∑ b ∈ Finset.range (m + 2),
        (if a = 0 then (if b = j then F else 0) else 0) = F := by
    intro F j hj
    rw [Finset.sum_eq_single 0]
    · simp only [↓reduceIte]
      rw [Finset.sum_ite_eq', if_pos (Finset.mem_range.mpr hj)]
    · intro a _ ha
      simp [ha]
    · intro h
      exact absurd (Finset.mem_range.mpr (by omega)) h
  have hid : MvPolynomial.aeval ![PowerSeries.C (MvPolynomial.X 0) +
          PowerSeries.C (c ^ 2) * PowerSeries.X,
        PowerSeries.C (MvPolynomial.X 1) + PowerSeries.C c * Y] g = PowerSeries.C g := by
    rw [hTay (m + 2) (by omega), Finset.sum_congr rfl (fun a _ =>
      Finset.sum_congr rfl (fun b _ => hterm a b))]
    simp only [Finset.sum_add_distrib, ← Finset.mul_sum]
    rw [hs1 _ 0 (by omega), hs1 _ 1 (by omega), ← hΨ Y]
    linear_combination (PowerSeries.C (c ^ 2)) * hYeq

  have hAw : lwubSB m 1 (PowerSeries.C (MvPolynomial.X 0) + PowerSeries.C (c ^ 2) * PowerSeries.X) := by
    refine sb_add _ _ _ ?_ ?_
    · exact sb_mono _ _ _ (by norm_num) (sb_C 1 (MvPolynomial.X 0) (by rw [MvPolynomial.totalDegree_X]))
    · have h2 : (c ^ 2).totalDegree ≤ 2 * m :=
        (MvPolynomial.totalDegree_pow _ _).trans (Nat.mul_le_mul_left _ hc)
      refine sb_mono _ _ _ ?_ (sb_mul _ _ _ _ (sb_C _ _ h2) sb_X)
      push_cast
      linarith
  have hBw : lwubSB m 1 (PowerSeries.C (MvPolynomial.X 1) + PowerSeries.C c * Y) := by
    refine sb_add _ _ _ ?_ ?_
    · exact sb_mono _ _ _ (by norm_num) (sb_C 1 (MvPolynomial.X 1) (by rw [MvPolynomial.totalDegree_X]))
    · refine sb_mono _ _ _ ?_ (sb_mul _ _ _ _ (sb_C _ _ hc) hYw)
      linarith
  refine ⟨PowerSeries.C c * Y, ?_, hid, ?_⟩
  · rw [map_mul, hY0, mul_zero]
  · intro f l
    have h := sb_aeval _ _ hAw hBw f l
    refine Finset.sup_le (fun s hs => ?_)
    have h' := h s hs
    rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two]
    zify
    push_cast at h' ⊢
    linarith

theorem lw_stepanov_linear_count (K : Type u) [Field K] (m : ℕ)
    (g : MvPolynomial (Fin 2) K) (hdeg : g.totalDegree = m)
    (hmon : g.coeff (Finsupp.single 1 m) = 1)
    {ι : Type} [Fintype ι] (L : ℕ) (T : ℕ → ℕ)
    (Λ : ℕ → (ι → K) →ₗ[K] MvPolynomial (Fin 2) K)
    (hT : ∀ l < L, ∀ x, (Λ l x).totalDegree ≤ T l)
    (hcard : ∑ l ∈ Finset.range L, m * (T l + 1) < Fintype.card ι) :
    ∃ x : ι → K, x ≠ 0 ∧ ∀ l < L, g ∣ Λ l x :=
by
  classical
  have hmono : ∀ (s : Fin 2 →₀ ℕ) (c : K),
      MvPolynomial.monomial s c =
        c • (MvPolynomial.X 0 ^ (s 0) * MvPolynomial.X 1 ^ (s 1) : MvPolynomial (Fin 2) K) := by
    intro s c
    have hs : s = Finsupp.single 0 (s 0) + Finsupp.single 1 (s 1) := by
      ext i; fin_cases i <;> simp
    rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul,
      one_mul, MvPolynomial.smul_monomial, smul_eq_mul, mul_one, ← hs]
  have hsum2 : ∀ s : Fin 2 →₀ ℕ, (s.sum fun _ e => e) = s 0 + s 1 := by
    intro s
    rw [Finsupp.sum_fintype _ _ (by simp), Fin.sum_univ_two]
  obtain ⟨h, hh⟩ : ∃ h : MvPolynomial (Fin 2) K, h = g - MvPolynomial.X 1 ^ m := ⟨_, rfl⟩
  have htail : ∀ s ∈ h.support, s 1 < m ∧ s 0 + s 1 ≤ m := by
    intro s hs
    rw [MvPolynomial.mem_support_iff, hh, MvPolynomial.coeff_sub, MvPolynomial.X_pow_eq_monomial,
      MvPolynomial.coeff_monomial] at hs
    have hne : Finsupp.single 1 m ≠ s := by
      intro heq
      rw [if_pos heq, ← heq, hmon, sub_self] at hs
      exact hs rfl
    rw [if_neg hne, sub_zero] at hs
    have hle := MvPolynomial.le_totalDegree (MvPolynomial.mem_support_iff.mpr hs)
    rw [hsum2, hdeg] at hle
    refine ⟨?_, hle⟩
    by_contra hlt
    apply hne
    ext i
    fin_cases i
    · simp
      omega
    · simp
      omega
  set π := Ideal.Quotient.mkₐ K (Ideal.span {g}) with hπ
  have hπg : π g = 0 := by
    rw [hπ, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.mem_span_singleton_self g
  let V : ℕ → Submodule K (MvPolynomial (Fin 2) K ⧸ Ideal.span {g}) := fun N =>
    Submodule.span K (Set.range (fun ab : Fin (N + 1) × Fin m =>
      π (MvPolynomial.X 0 ^ (ab.1 : ℕ) * MvPolynomial.X 1 ^ (ab.2 : ℕ))))
  have hred : ∀ b a N : ℕ, a + b ≤ N →
      π (MvPolynomial.X 0 ^ a * MvPolynomial.X 1 ^ b) ∈ V N := by
    intro b
    induction b using Nat.strong_induction_on with
    | _ b ih =>
      intro a N hab
      by_cases hb : b < m
      · apply Submodule.subset_span
        exact ⟨(⟨a, by omega⟩, ⟨b, hb⟩), rfl⟩
      · obtain ⟨c, rfl⟩ : ∃ c, b = c + m := ⟨b - m, by omega⟩
        have h1 : (∑ s ∈ h.support, h.coeff s •
              (MvPolynomial.X 0 ^ (a + s 0) * MvPolynomial.X 1 ^ (c + s 1)) :
              MvPolynomial (Fin 2) K)
            = MvPolynomial.X 0 ^ a * MvPolynomial.X 1 ^ c * h := by
          conv_rhs => rw [MvPolynomial.as_sum h]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun s _ => ?_)
          rw [hmono, MvPolynomial.smul_eq_C_mul, MvPolynomial.smul_eq_C_mul]
          ring
        have hexp : (MvPolynomial.X 0 ^ a * MvPolynomial.X 1 ^ (c + m) : MvPolynomial (Fin 2) K) =
            MvPolynomial.X 0 ^ a * MvPolynomial.X 1 ^ c * g -
              ∑ s ∈ h.support, h.coeff s •
                (MvPolynomial.X 0 ^ (a + s 0) * MvPolynomial.X 1 ^ (c + s 1)) := by
          rw [h1, hh]
          ring
        rw [hexp, map_sub, map_mul, hπg, mul_zero, zero_sub, map_sum]
        refine Submodule.neg_mem _ (Submodule.sum_mem _ (fun s hs => ?_))
        rw [map_smul]
        refine Submodule.smul_mem _ _ ?_
        obtain ⟨h1, h2⟩ := htail s hs
        exact ih (c + s 1) (by omega) (a + s 0) N (by omega)
  have hpoly : ∀ N (P : MvPolynomial (Fin 2) K), P.totalDegree ≤ N → π P ∈ V N := by
    intro N P hP
    rw [MvPolynomial.as_sum P, map_sum]
    refine Submodule.sum_mem _ (fun s hs => ?_)
    rw [hmono, map_smul]
    refine Submodule.smul_mem _ _ (hred _ _ _ ?_)
    have := MvPolynomial.le_totalDegree hs
    rw [hsum2] at this
    omega
  haveI hfin : ∀ N, FiniteDimensional K (V N) := fun N =>
    FiniteDimensional.span_of_finite K (Set.finite_range _)
  have hfr : ∀ N, Module.finrank K (V N) ≤ (N + 1) * m := by
    intro N
    have := finrank_range_le_card (R := K) (b := fun ab : Fin (N + 1) × Fin m =>
      π (MvPolynomial.X 0 ^ (ab.1 : ℕ) * MvPolynomial.X 1 ^ (ab.2 : ℕ)))
    rw [Fintype.card_prod, Fintype.card_fin, Fintype.card_fin] at this
    exact this
  let Φ : (ι → K) →ₗ[K] ((l : Fin L) → V (T l)) :=
    LinearMap.pi (fun l : Fin L => (π.toLinearMap ∘ₗ Λ l).codRestrict (V (T l))
      (fun x => hpoly (T l) _ (hT l l.2 x)))
  have hdim : Module.finrank K ((l : Fin L) → V (T l)) < Module.finrank K (ι → K) := by
    rw [Module.finrank_pi_fintype, Module.finrank_fintype_fun_eq_card]
    calc ∑ l : Fin L, Module.finrank K (V (T l)) ≤ ∑ l : Fin L, m * (T l + 1) :=
          Finset.sum_le_sum (fun l _ => by rw [mul_comm]; exact hfr (T l))
      _ = ∑ l ∈ Finset.range L, m * (T l + 1) :=
          Fin.sum_univ_eq_sum_range (fun l => m * (T l + 1)) L
      _ < Fintype.card ι := hcard
  have hker := LinearMap.ker_ne_bot_of_finrank_lt hdim (f := Φ)
  obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hker
  refine ⟨x, hx0, fun l hl => ?_⟩
  have h1 := congrArg (fun y => ((y ⟨l, hl⟩ : V (T l)) : MvPolynomial (Fin 2) K ⧸ Ideal.span {g}))
    (LinearMap.mem_ker.mp hx)
  have h2 : Ideal.Quotient.mk (Ideal.span {g}) (Λ l x) = 0 := h1
  rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at h2
  exact h2

theorem lw_stepanov_frobenius_independence (K : Type u) [Field K] [Finite K]
    (ρ : MvPolynomial (Fin 2) K →ₐ[K] PowerSeries K)
    (H : Submodule K (MvPolynomial (Fin 2) K))
    (hH : ∀ h ∈ H, h ≠ 0 → (ρ h).order < (Nat.card K : ℕ∞))
    {ι : Type} [Fintype ι] (w : ι → MvPolynomial (Fin 2) K)
    (hw : LinearIndependent K (fun e => ρ (w e)))
    (h : ι → MvPolynomial (Fin 2) K) (hhH : ∀ e, h e ∈ H) (hne : ∃ e, h e ≠ 0) :
    ρ (∑ e, h e * w e ^ Nat.card K) ≠ 0 :=
by
  classical

  have s1 : ∀ (f g : PowerSeries K) (c : K),
      (f + c • g) ^ Nat.card K = f ^ Nat.card K + c • g ^ Nat.card K := by
    intro f g c
    letI : Fintype K := Fintype.ofFinite K
    haveI hp : Fact (Nat.Prime (ringChar K)) := ⟨CharP.char_is_prime K _⟩
    obtain ⟨n, hn⟩ : ∃ n : ℕ, Nat.card K = ringChar K ^ n := by
      obtain ⟨n, _, hn⟩ := FiniteField.card K (ringChar K)
      exact ⟨n, by rw [Nat.card_eq_fintype_card, hn]⟩
    haveI : CharP (PowerSeries K) (ringChar K) :=
      charP_of_injective_algebraMap (algebraMap K _).injective (ringChar K)
    have hc : c ^ Nat.card K = c := by
      rw [Nat.card_eq_fintype_card]; exact FiniteField.pow_card c
    rw [hn, add_pow_char_pow, smul_pow, ← hn, hc]

  have s2 : ∀ (q k : ℕ) (P W R : PowerSeries K), P ≠ 0 → P.order < (q : ℕ∞) →
      W.order = (k : ℕ∞) → PowerSeries.X ^ (q * (k + 1)) ∣ R → P * W ^ q + R ≠ 0 := by
    intro q k P W R hP hPq hW hR
    have hPt : P.order ≠ ⊤ := fun h => hP (PowerSeries.order_eq_top.mp h)
    obtain ⟨a, ha⟩ := ENat.ne_top_iff_exists.mp hPt
    have haq : a < q := by rw [← ha] at hPq; exact_mod_cast hPq
    have hord : (P * W ^ q).order = ((a + q * k : ℕ) : ℕ∞) := by
      rw [PowerSeries.order_mul, PowerSeries.order_pow, hW, ← ha, nsmul_eq_mul]
      push_cast; rfl
    have hc := (PowerSeries.order_eq_nat.mp hord).1
    have hlt : a + q * k < q * (k + 1) := by rw [Nat.mul_succ]; linarith
    have hRc : PowerSeries.coeff (a + q * k) R = 0 := PowerSeries.X_pow_dvd_iff.mp hR _ hlt
    intro h0
    have := congrArg (PowerSeries.coeff (a + q * k)) h0
    rw [map_add, hRc, add_zero, map_zero] at this
    exact hc this

  have s3 : ∀ (k : ℕ) (W0 V : PowerSeries K), W0.order = (k : ℕ∞) → (k : ℕ∞) ≤ V.order →
      ∃ c : K, PowerSeries.X ^ (k + 1) ∣ V - c • W0 := by
    intro k W0 V hW0 hV
    obtain ⟨hk, hlt⟩ := PowerSeries.order_eq_nat.mp hW0
    refine ⟨PowerSeries.coeff k V / PowerSeries.coeff k W0, ?_⟩
    rw [PowerSeries.X_pow_dvd_iff]
    intro i hi
    rw [map_sub, PowerSeries.coeff_smul, smul_eq_mul]
    rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | rfl
    · rw [hlt i hi, PowerSeries.coeff_of_lt_order i (lt_of_lt_of_le (by exact_mod_cast hi) hV)]
      simp
    · rw [div_mul_cancel₀ _ hk, sub_self]

  have core : ∀ (M : Submodule K (PowerSeries K)),
      (∀ x ∈ M, x ≠ 0 → x.order < (Nat.card K : ℕ∞)) →
      ∀ (S : Finset ι) (W : ι → PowerSeries K), LinearIndepOn K W (S : Set ι) →
      ∀ (P : ι → PowerSeries K), (∀ e ∈ S, P e ∈ M) → (∃ e ∈ S, P e ≠ 0) →
      ∑ e ∈ S, P e * W e ^ Nat.card K ≠ 0 := by
    intro M hM S
    induction S using Finset.strongInduction with
    | H S ih =>
    intro W hW P hP hne
    obtain ⟨e1, he1, hPe1⟩ := hne
    have hSne : S.Nonempty := ⟨e1, he1⟩
    obtain ⟨e0, he0, hmin⟩ := Finset.exists_min_image S (fun e => (W e).order.toNat) hSne
    have hfin : ∀ e ∈ S, (W e).order = ((W e).order.toNat : ℕ∞) := by
      intro e he
      have hne0 : W e ≠ 0 := hW.ne_zero he
      exact (ENat.coe_toNat (fun h => hne0 (PowerSeries.order_eq_top.mp h))).symm
    obtain ⟨k, hk⟩ : ∃ k : ℕ, k = (W e0).order.toNat := ⟨_, rfl⟩
    have hW0 : (W e0).order = (k : ℕ∞) := by rw [hk]; exact hfin e0 he0
    have hge : ∀ e ∈ S, (k : ℕ∞) ≤ (W e).order := by
      intro e he
      rw [hfin e he, hk]; exact_mod_cast hmin e he
    have hlam : ∀ e, ∃ c : K, e ∈ S → PowerSeries.X ^ (k + 1) ∣ W e - c • W e0 := by
      intro e
      by_cases he : e ∈ S
      · obtain ⟨c, hc⟩ := s3 k (W e0) (W e) hW0 (hge e he)
        exact ⟨c, fun _ => hc⟩
      · exact ⟨0, fun h => absurd h he⟩
    choose lam hlam using hlam
    obtain ⟨W', hW'⟩ : ∃ W' : ι → PowerSeries K, ∀ e, W' e = W e - lam e • W e0 :=
      ⟨_, fun _ => rfl⟩
    have hsub : S.erase e0 ⊂ S := Finset.erase_ssubset he0

    have hW'ind : LinearIndepOn K W' ((S.erase e0 : Finset ι) : Set ι) := by
      rw [linearIndepOn_finset_iff]
      intro f hf e he
      have hf' : ∑ i ∈ S.erase e0, f i • W i - (∑ i ∈ S.erase e0, f i * lam i) • W e0 = 0 := by
        calc _ = ∑ i ∈ S.erase e0, f i • W' i := by
              rw [Finset.sum_smul, ← Finset.sum_sub_distrib]
              refine Finset.sum_congr rfl (fun i _ => ?_)
              rw [hW', smul_sub, smul_smul]
          _ = 0 := hf
      let g : ι → K := fun i => if i = e0 then -(∑ i ∈ S.erase e0, f i * lam i) else f i
      have hg : ∑ i ∈ S, g i • W i = 0 := by
        rw [← Finset.add_sum_erase S _ he0]
        have h1 : ∑ i ∈ S.erase e0, g i • W i = ∑ i ∈ S.erase e0, f i • W i := by
          refine Finset.sum_congr rfl (fun i hi => ?_)
          simp [g, Finset.ne_of_mem_erase hi]
        rw [h1]
        simp only [g, ↓reduceIte]
        rw [neg_smul, neg_add_eq_sub]
        exact hf'
      have := (linearIndepOn_finset_iff.mp hW) g hg e (Finset.mem_of_mem_erase he)
      simpa [g, Finset.ne_of_mem_erase he] using this

    have hfrob : ∀ e, W e ^ Nat.card K = W' e ^ Nat.card K + lam e • W e0 ^ Nat.card K := by
      intro e
      have : W e = W' e + lam e • W e0 := by rw [hW', sub_add_cancel]
      rw [this]
      exact s1 _ _ _

    obtain ⟨Ps, hPs⟩ : ∃ x : PowerSeries K, x = P e0 + ∑ e ∈ S.erase e0, lam e • P e :=
      ⟨_, rfl⟩
    obtain ⟨R, hR⟩ : ∃ x : PowerSeries K, x = ∑ e ∈ S.erase e0, P e * W' e ^ Nat.card K :=
      ⟨_, rfl⟩
    have hsplit : ∑ e ∈ S, P e * W e ^ Nat.card K = Ps * W e0 ^ Nat.card K + R := by
      rw [hPs, hR, ← Finset.add_sum_erase S _ he0]
      have h2 : ∀ e ∈ S.erase e0, P e * W e ^ Nat.card K =
          (lam e • P e) * W e0 ^ Nat.card K + P e * W' e ^ Nat.card K := by
        intro e _
        rw [hfrob e, mul_add, mul_smul_comm, smul_mul_assoc]
        exact add_comm _ _
      rw [Finset.sum_congr rfl h2, Finset.sum_add_distrib, ← Finset.sum_mul]
      ring

    have hPsM : Ps ∈ M := by
      rw [hPs]
      exact M.add_mem (hP e0 he0)
        (M.sum_mem fun e he => M.smul_mem _ (hP e (Finset.mem_of_mem_erase he)))

    have hRdvd : PowerSeries.X ^ (Nat.card K * (k + 1)) ∣ R := by
      rw [hR]
      apply Finset.dvd_sum
      intro e he
      apply Dvd.dvd.mul_left
      rw [pow_mul']
      apply pow_dvd_pow_of_dvd
      rw [hW']
      exact hlam e (Finset.mem_of_mem_erase he)
    rw [hsplit]
    by_cases hPs0 : Ps = 0
    ·
      have hne' : ∃ e ∈ S.erase e0, P e ≠ 0 := by
        by_contra hcon
        push_neg at hcon
        have hz : ∑ e ∈ S.erase e0, lam e • P e = 0 :=
          Finset.sum_eq_zero (fun e he => by rw [hcon e he, smul_zero])
        have hP0 : P e0 = 0 := by
          rw [hPs, hz, add_zero] at hPs0
          exact hPs0
        by_cases he10 : e1 = e0
        · rw [he10] at hPe1; exact hPe1 hP0
        · exact hPe1 (hcon e1 (Finset.mem_erase.mpr ⟨he10, he1⟩))
      rw [hPs0, zero_mul, zero_add, hR]
      exact ih _ hsub W' hW'ind P (fun e he => hP e (Finset.mem_of_mem_erase he)) hne'
    ·
      exact s2 (Nat.card K) k Ps (W e0) R hPs0 (hM Ps hPsM hPs0) hW0 hRdvd

  let M : Submodule K (PowerSeries K) := Submodule.map ρ.toLinearMap H
  have hM : ∀ x ∈ M, x ≠ 0 → x.order < (Nat.card K : ℕ∞) := by
    intro x hx hx0
    obtain ⟨y, hy, rfl⟩ := Submodule.mem_map.mp hx
    have hy0 : y ≠ 0 := by
      rintro rfl
      exact hx0 (map_zero _)
    exact hH y hy hy0
  rw [map_sum]
  simp only [map_mul, map_pow]
  obtain ⟨e1, he1⟩ := hne
  refine core M hM Finset.univ (fun e => ρ (w e)) (hw.linearIndepOn _) (fun e => ρ (h e))
    (fun e _ => Submodule.mem_map_of_mem (hhH e)) ⟨e1, Finset.mem_univ _, ?_⟩
  intro h0
  have := hH (h e1) (hhH e1) he1
  rw [h0, PowerSeries.order_zero] at this
  exact absurd this (not_lt.mpr le_top)

theorem lw_upper_stepanov_aux (K : Type u) [Field K] [Finite K] (m : ℕ)
    (g : MvPolynomial (Fin 2) K) (hm : 1 ≤ m) (hdeg : g.totalDegree = m)
    (hmon : g.coeff (Finsupp.single 1 m) = 1) (hder : MvPolynomial.pderiv 1 g ≠ 0)
    (hirr : Irreducible (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g))
    (A I L : ℕ) (hL : L ≤ Nat.card K) (hA : m * (A + m) < Nat.card K)
    (hdim : L * (A + I + 2 * m) + m * L ^ 2 < m * A * (I + 1))
    (z₀ : Fin 2 → K) (hz₀ : MvPolynomial.eval z₀ g = 0)
    (hz₀' : MvPolynomial.eval z₀ (MvPolynomial.pderiv 1 g) ≠ 0) :
    ∃ (Φ : MvPolynomial (Fin 2) K) (φ : (Fin 2 → K) → PowerSeries K), ¬ g ∣ Φ ∧
      Φ.totalDegree ≤ A + m + Nat.card K * (I + m) ∧
      ∀ z : Fin 2 → K, MvPolynomial.eval z g = 0 →
        MvPolynomial.eval z (MvPolynomial.pderiv 1 g) ≠ 0 →
        PowerSeries.constantCoeff (φ z) = z 1 ∧
        MvPolynomial.aeval ![algebraMap K (PowerSeries K) (z 0) + PowerSeries.X, φ z] g = 0 ∧
        (L : ℕ∞) ≤ (MvPolynomial.aeval
          ![algebraMap K (PowerSeries K) (z 0) + PowerSeries.X, φ z] Φ).order :=
by
  classical

  have s6 : ∀ h : MvPolynomial (Fin 2) K, h ≠ 0 → MvPolynomial.degreeOf 1 h < m → ¬ g ∣ h := by
    intro h hh hdeg1
    rintro ⟨k, hk⟩
    have hg0 : g ≠ 0 := by
      rintro rfl
      rw [MvPolynomial.coeff_zero] at hmon
      exact zero_ne_one hmon
    have hk0 : k ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hk
      exact hh hk
    have hmem : Finsupp.single 1 m ∈ g.support := by
      rw [MvPolynomial.mem_support_iff, hmon]; exact one_ne_zero
    have h1 := MvPolynomial.le_degreeOf_of_mem_support 1 hmem
    rw [Finsupp.single_eq_same] at h1
    have h2 := MvPolynomial.degreeOf_mul_eq (n := 1) hg0 hk0
    rw [← hk] at h2
    omega

  have s3 : ∀ (ζ : MvPolynomial (Fin 2) K →ₐ[K] PowerSeries (MvPolynomial (Fin 2) K)),
      (∀ f, PowerSeries.constantCoeff (ζ f) = f) →
      ∀ (f w : MvPolynomial (Fin 2) K) (l : ℕ), l < Nat.card K →
      PowerSeries.coeff l (ζ (f * w ^ Nat.card K)) =
        PowerSeries.coeff l (ζ f) * w ^ Nat.card K := by
    intro ζ hζ f w l hl
    letI : Fintype K := Fintype.ofFinite K
    haveI hp : Fact (Nat.Prime (ringChar K)) := ⟨CharP.char_is_prime K _⟩
    obtain ⟨n, hn⟩ : ∃ n : ℕ, Nat.card K = ringChar K ^ n := by
      obtain ⟨n, _, hn⟩ := FiniteField.card K (ringChar K)
      exact ⟨n, by rw [Nat.card_eq_fintype_card, hn]⟩
    haveI : CharP (PowerSeries (MvPolynomial (Fin 2) K)) (ringChar K) :=
      charP_of_injective_algebraMap (algebraMap K _).injective (ringChar K)
    set r := PowerSeries.mk fun p => PowerSeries.coeff (p + 1) (ζ w) with hr
    have hw : ζ w = PowerSeries.X * r + PowerSeries.C w := by
      conv_lhs => rw [PowerSeries.eq_X_mul_shift_add_const (ζ w)]
      rw [hζ]
    have key : ζ (f * w ^ Nat.card K) = (ζ f * r ^ Nat.card K) * PowerSeries.X ^ Nat.card K +
        ζ f * PowerSeries.C (w ^ Nat.card K) := by
      rw [map_mul, map_pow, hw, hn, add_pow_char_pow, mul_pow, map_pow]
      ring
    rw [key, map_add, PowerSeries.coeff_mul_X_pow', if_neg (by omega), zero_add,
      PowerSeries.coeff_mul_C]

  have s2 : ∀ (c : MvPolynomial (Fin 2) K) (W : PowerSeries (MvPolynomial (Fin 2) K)),
      PowerSeries.constantCoeff W = 0 → ∀ (z : Fin 2 → K), MvPolynomial.eval z c ≠ 0 →
      PowerSeries.constantCoeff (PowerSeries.C (z 1) + PowerSeries.rescale
          ((MvPolynomial.eval z c)⁻¹ ^ 2) (PowerSeries.map (MvPolynomial.eval z) W)) = z 1 ∧
      ∀ (f : MvPolynomial (Fin 2) K) (l : ℕ),
        PowerSeries.coeff l (MvPolynomial.aeval
            ![algebraMap K (PowerSeries K) (z 0) + PowerSeries.X,
              PowerSeries.C (z 1) + PowerSeries.rescale ((MvPolynomial.eval z c)⁻¹ ^ 2)
                (PowerSeries.map (MvPolynomial.eval z) W)] f) =
          ((MvPolynomial.eval z c)⁻¹ ^ 2) ^ l * MvPolynomial.eval z (PowerSeries.coeff l
            (MvPolynomial.aeval ![PowerSeries.C (MvPolynomial.X 0) +
                PowerSeries.C (c ^ 2) * PowerSeries.X,
              PowerSeries.C (MvPolynomial.X 1) + W] f)) := by
    intro c W hW z hz
    set a : K := (MvPolynomial.eval z c)⁻¹ ^ 2 with ha
    have hresC : ∀ x : K, PowerSeries.rescale a (PowerSeries.C x) = PowerSeries.C x := by
      intro x
      ext n
      rw [PowerSeries.coeff_rescale, PowerSeries.coeff_C]
      split_ifs with h
      · rw [h, pow_zero, one_mul]
      · rw [mul_zero]
    have hγ : MvPolynomial.eval z c ^ 2 * a = 1 := by
      rw [ha, inv_pow, mul_inv_cancel₀ (pow_ne_zero 2 hz)]
    refine ⟨?_, ?_⟩
    · rw [map_add, PowerSeries.constantCoeff_C, ← PowerSeries.coeff_zero_eq_constantCoeff_apply,
        PowerSeries.coeff_rescale, PowerSeries.coeff_map,
        PowerSeries.coeff_zero_eq_constantCoeff_apply, hW, map_zero, mul_zero, add_zero]
    · let π : PowerSeries (MvPolynomial (Fin 2) K) →+* PowerSeries K :=
        (PowerSeries.rescale a).comp (PowerSeries.map (MvPolynomial.eval z))
      have hcomp : π.comp (MvPolynomial.aeval ![PowerSeries.C (MvPolynomial.X 0) +
                PowerSeries.C (c ^ 2) * PowerSeries.X,
              PowerSeries.C (MvPolynomial.X 1) + W] : MvPolynomial (Fin 2) K →ₐ[K]
                PowerSeries (MvPolynomial (Fin 2) K)).toRingHom =
          (MvPolynomial.aeval
            ![algebraMap K (PowerSeries K) (z 0) + PowerSeries.X,
              PowerSeries.C (z 1) + PowerSeries.rescale a
                (PowerSeries.map (MvPolynomial.eval z) W)] : MvPolynomial (Fin 2) K →ₐ[K]
                PowerSeries K).toRingHom := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
            AlgHom.coe_toRingHom]
          rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, AlgHom.commutes,
            PowerSeries.algebraMap_apply, PowerSeries.algebraMap_apply, MvPolynomial.algebraMap_eq]
          simp only [π, RingHom.coe_comp, Function.comp_apply, PowerSeries.map_C,
            MvPolynomial.eval_C, Algebra.algebraMap_self, RingHom.id_apply, hresC]
        · intro i
          fin_cases i
          · simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
              AlgHom.coe_toRingHom, MvPolynomial.aeval_X]
            simp only [π, RingHom.coe_comp, Function.comp_apply, Fin.zero_eta, Fin.isValue,
              Matrix.cons_val_zero, map_add, map_mul, PowerSeries.map_C, PowerSeries.map_X,
              MvPolynomial.eval_X, map_pow, hresC, PowerSeries.rescale_X,
              PowerSeries.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
            rw [← mul_assoc, ← map_pow, ← map_mul, hγ, map_one, one_mul]
          · simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
              AlgHom.coe_toRingHom, MvPolynomial.aeval_X]
            simp only [π, RingHom.coe_comp, Function.comp_apply, Fin.mk_one, Fin.isValue,
              Matrix.cons_val_one, Matrix.cons_val_zero, map_add,
              PowerSeries.map_C, MvPolynomial.eval_X, hresC]
      intro f l
      have := RingHom.congr_fun hcomp f
      simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
        AlgHom.coe_toRingHom] at this
      rw [← this]
      simp only [π, RingHom.coe_comp, Function.comp_apply, PowerSeries.coeff_rescale,
        PowerSeries.coeff_map]

  letI : Fintype K := Fintype.ofFinite K
  have hpow : ∀ a : K, a ^ Nat.card K = a := by
    intro a; rw [Nat.card_eq_fintype_card]; exact FiniteField.pow_card a
  obtain ⟨W, hW0, hWg, hWdeg⟩ := lw_stepanov_universal_branch K m g hdeg.le
  set ζ : MvPolynomial (Fin 2) K →ₐ[K] PowerSeries (MvPolynomial (Fin 2) K) :=
    MvPolynomial.aeval ![PowerSeries.C (MvPolynomial.X 0) +
          PowerSeries.C (MvPolynomial.pderiv 1 g ^ 2) * PowerSeries.X,
        PowerSeries.C (MvPolynomial.X 1) + W] with hζdef
  have hζ : ∀ f, PowerSeries.constantCoeff (ζ f) = f := by
    have key : (PowerSeries.constantCoeff).comp
        (ζ : MvPolynomial (Fin 2) K →+* PowerSeries (MvPolynomial (Fin 2) K)) = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.coe_toRingHom, RingHom.id_apply]
        rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, PowerSeries.algebraMap_apply,
          PowerSeries.constantCoeff_C]
      · intro i
        fin_cases i <;> simp [ζ, hW0]
    intro f
    exact RingHom.congr_fun key f
  set φ : (Fin 2 → K) → PowerSeries K := fun z => PowerSeries.C (z 1) + PowerSeries.rescale
      ((MvPolynomial.eval z (MvPolynomial.pderiv 1 g))⁻¹ ^ 2)
      (PowerSeries.map (MvPolynomial.eval z) W) with hφdef
  have hgood : ∀ z : Fin 2 → K, MvPolynomial.eval z g = 0 →
      MvPolynomial.eval z (MvPolynomial.pderiv 1 g) ≠ 0 →
      PowerSeries.constantCoeff (φ z) = z 1 ∧
      (∀ f l, PowerSeries.coeff l (MvPolynomial.aeval
          ![algebraMap K (PowerSeries K) (z 0) + PowerSeries.X, φ z] f) =
        ((MvPolynomial.eval z (MvPolynomial.pderiv 1 g))⁻¹ ^ 2) ^ l *
          MvPolynomial.eval z (PowerSeries.coeff l (ζ f))) ∧
      MvPolynomial.aeval ![algebraMap K (PowerSeries K) (z 0) + PowerSeries.X, φ z] g = 0 := by
    intro z hz hcz
    obtain ⟨h1, h2⟩ := s2 (MvPolynomial.pderiv 1 g) W hW0 z hcz
    have h2' : ∀ f l, PowerSeries.coeff l (MvPolynomial.aeval
          ![algebraMap K (PowerSeries K) (z 0) + PowerSeries.X, φ z] f) =
        ((MvPolynomial.eval z (MvPolynomial.pderiv 1 g))⁻¹ ^ 2) ^ l *
          MvPolynomial.eval z (PowerSeries.coeff l (ζ f)) := h2
    refine ⟨h1, h2', ?_⟩
    ext l
    rw [h2', hWg, PowerSeries.coeff_C]
    split_ifs <;> simp [hz]

  let e : Fin (I + 1) × Fin m → MvPolynomial (Fin 2) K := fun ε =>
    MvPolynomial.X 0 ^ (ε.1 : ℕ) * MvPolynomial.X 1 ^ (ε.2 : ℕ)
  let b : Fin A × Fin m → MvPolynomial (Fin 2) K := fun β =>
    MvPolynomial.X 0 ^ (β.1 : ℕ) * MvPolynomial.X 1 ^ (β.2 : ℕ)
  let Λ : ℕ → (((Fin (I + 1) × Fin m) × (Fin A × Fin m)) → K) →ₗ[K] MvPolynomial (Fin 2) K :=
    fun l =>
    { toFun := fun x => ∑ κ, x κ • (PowerSeries.coeff l (ζ (b κ.2)) * e κ.1)
      map_add' := by
        intro x y
        simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
      map_smul' := by
        intro r x
        simp only [Pi.smul_apply, smul_eq_mul, mul_smul, RingHom.id_apply, Finset.smul_sum] }
  have hdegXY : ∀ i j : ℕ,
      (MvPolynomial.X 0 ^ i * MvPolynomial.X 1 ^ j : MvPolynomial (Fin 2) K).totalDegree ≤ i + j := by
    intro i j
    refine (MvPolynomial.totalDegree_mul _ _).trans ?_
    rw [MvPolynomial.totalDegree_X_pow, MvPolynomial.totalDegree_X_pow]
  have hT : ∀ l < L, ∀ x, (Λ l x).totalDegree ≤ A + I + 2 * m + 2 * l * m := by
    intro l _ x
    show (∑ κ, x κ • (PowerSeries.coeff l (ζ (b κ.2)) * e κ.1)).totalDegree ≤ _
    refine MvPolynomial.totalDegree_finsetSum_le (fun κ _ => ?_)
    refine (MvPolynomial.totalDegree_smul_le _ _).trans ?_
    refine (MvPolynomial.totalDegree_mul _ _).trans ?_
    have h1 := hWdeg (b κ.2) l
    have h2 : (b κ.2).totalDegree ≤ κ.2.1 + κ.2.2 := hdegXY _ _
    have h3 : (e κ.1).totalDegree ≤ κ.1.1 + κ.1.2 := hdegXY _ _
    have := κ.2.1.isLt
    have := κ.2.2.isLt
    have := κ.1.1.isLt
    have := κ.1.2.isLt
    omega
  have hsum : ∀ N : ℕ, ∑ l ∈ Finset.range N, m * ((A + I + 2 * m + 2 * l * m) + 1) + m * m * N =
      m * N * (A + I + 2 * m + 1) + m * m * N ^ 2 := by
    intro N
    induction N with
    | zero => simp
    | succ N ih =>
      rw [Finset.sum_range_succ]
      nlinarith [ih]
  have hcard : ∑ l ∈ Finset.range L, m * ((A + I + 2 * m + 2 * l * m) + 1) <
      Fintype.card ((Fin (I + 1) × Fin m) × (Fin A × Fin m)) := by
    simp only [Fintype.card_prod, Fintype.card_fin]
    have h1 := hsum L
    have h2 : m * L ≤ m * m * L := by
      calc m * L = 1 * (m * L) := (one_mul _).symm
        _ ≤ m * (m * L) := Nat.mul_le_mul_right _ hm
        _ = m * m * L := (mul_assoc _ _ _).symm
    have h3 : m * (L * (A + I + 2 * m) + m * L ^ 2) < m * (m * A * (I + 1)) :=
      Nat.mul_lt_mul_of_pos_left hdim (by omega)
    nlinarith
  obtain ⟨x, hx0, hxg⟩ := lw_stepanov_linear_count K m g hdeg hmon L
    (fun l => A + I + 2 * m + 2 * l * m) Λ hT hcard

  let Φ : MvPolynomial (Fin 2) K :=
    ∑ κ : (Fin (I + 1) × Fin m) × (Fin A × Fin m), x κ • (b κ.2 * e κ.1 ^ Nat.card K)
  refine ⟨Φ, φ, ?_, ?_, ?_⟩
  ·
    intro hdvd
    obtain ⟨h01, h02, h03⟩ := hgood z₀ hz₀ hz₀'
    set ρ0 : MvPolynomial (Fin 2) K →ₐ[K] PowerSeries K :=
      MvPolynomial.aeval ![algebraMap K (PowerSeries K) (z₀ 0) + PowerSeries.X, φ z₀] with hρ0
    have hdag : ∀ P : MvPolynomial (Fin 2) K, P ≠ 0 → MvPolynomial.degreeOf 1 P < m →
        ρ0 P ≠ 0 ∧ (ρ0 P).order ≤ ((m * P.totalDegree : ℕ) : ℕ∞) := by
      intro P hP hdP
      have hnd := s6 P hP hdP
      have hs := lw_upper_branch_order_sum K m g hm hdeg hmon hirr {z₀} φ
        (by intro z hz; rw [Finset.mem_singleton] at hz; rw [hz]; exact h01)
        (by intro z hz; rw [Finset.mem_singleton] at hz; rw [hz]; exact h03) P hnd
      rw [Finset.sum_singleton] at hs
      have hs' : (ρ0 P).order ≤ ((m * P.totalDegree : ℕ) : ℕ∞) := hs
      refine ⟨fun h0 => ?_, hs'⟩
      rw [h0, PowerSeries.order_zero] at hs'
      exact ENat.coe_ne_top _ (top_le_iff.mp hs')
    have hmemR : ∀ (S : Set (Fin 2 →₀ ℕ)) (s : Fin 2 →₀ ℕ) (r : K), s ∈ S →
        MvPolynomial.monomial s r ∈ MvPolynomial.restrictSupport K S := by
      intro S s r hs
      rw [MvPolynomial.mem_restrictSupport_iff]
      intro s' hs'
      have := MvPolynomial.support_monomial_subset hs'
      rw [Finset.mem_singleton] at this
      rw [this]; exact hs
    have hmono : ∀ i j : ℕ, (MvPolynomial.X 0 ^ i * MvPolynomial.X 1 ^ j : MvPolynomial (Fin 2) K) =
        MvPolynomial.monomial (Finsupp.single 0 i + Finsupp.single 1 j) 1 := by
      intro i j
      rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.X_pow_eq_monomial,
        MvPolynomial.monomial_mul, one_mul]
    have hexp : ∀ i j i' j' : ℕ, (Finsupp.single (0 : Fin 2) i + Finsupp.single 1 j =
        Finsupp.single 0 i' + Finsupp.single 1 j') → i = i' ∧ j = j' := by
      intro i j i' j' h
      have h0 := congrArg (fun s => s 0) h
      have h1 := congrArg (fun s => s 1) h
      simp at h0 h1
      exact ⟨h0, h1⟩
    have hcoef : ∀ {τ : Type} [Fintype τ] (a : τ → K) (s : τ → (Fin 2 →₀ ℕ)),
        Function.Injective s → ∀ t,
        (∑ t', a t' • MvPolynomial.monomial (s t') (1 : K)).coeff (s t) = a t := by
      intro τ _ a s hs t
      rw [MvPolynomial.coeff_sum, Finset.sum_eq_single t]
      · simp [MvPolynomial.coeff_monomial]
      · intro t' _ ht'
        simp [MvPolynomial.coeff_monomial, hs.ne ht']
      · simp
    let H : Submodule K (MvPolynomial (Fin 2) K) :=
      MvPolynomial.restrictSupport K {s | s 0 < A ∧ s 1 < m}
    let Hv : Submodule K (MvPolynomial (Fin 2) K) :=
      MvPolynomial.restrictSupport K {s | s 1 < m}
    have hdegv : ∀ P ∈ Hv, MvPolynomial.degreeOf 1 P < m := by
      intro P hP
      rw [MvPolynomial.degreeOf_lt_iff (by omega)]
      intro s hs
      exact (MvPolynomial.mem_restrictSupport_iff K).mp hP hs
    have hH : ∀ h ∈ H, h ≠ 0 → (ρ0 h).order < (Nat.card K : ℕ∞) := by
      intro h hh hne
      have hsupp : ∀ s ∈ h.support, s 0 < A ∧ s 1 < m := fun s hs =>
        (MvPolynomial.mem_restrictSupport_iff K).mp hh hs
      have hdv : MvPolynomial.degreeOf 1 h < m :=
        (MvPolynomial.degreeOf_lt_iff (by omega)).mpr (fun s hs => (hsupp s hs).2)
      have htd : h.totalDegree ≤ A + m := by
        unfold MvPolynomial.totalDegree
        apply Finset.sup_le
        intro s hs
        have := hsupp s hs
        rw [Finsupp.sum_fintype _ _ (by simp), Fin.sum_univ_two]
        omega
      have h1 := (hdag h hne hdv).2
      have h2 : m * h.totalDegree < Nat.card K := lt_of_le_of_lt (Nat.mul_le_mul_left _ htd) hA
      calc (ρ0 h).order ≤ ((m * h.totalDegree : ℕ) : ℕ∞) := h1
        _ < (Nat.card K : ℕ∞) := by exact_mod_cast h2
    have he : ∀ ε : Fin (I + 1) × Fin m,
        e ε = MvPolynomial.monomial (Finsupp.single 0 (ε.1 : ℕ) + Finsupp.single 1 (ε.2 : ℕ)) 1 :=
      fun ε => hmono _ _
    have hb : ∀ β : Fin A × Fin m,
        b β = MvPolynomial.monomial (Finsupp.single 0 (β.1 : ℕ) + Finsupp.single 1 (β.2 : ℕ)) 1 :=
      fun β => hmono _ _
    have hsE : Function.Injective (fun ε : Fin (I + 1) × Fin m =>
        Finsupp.single (0 : Fin 2) (ε.1 : ℕ) + Finsupp.single 1 (ε.2 : ℕ)) := by
      intro ε ε' h
      obtain ⟨h1, h2⟩ := hexp _ _ _ _ h
      exact Prod.ext (Fin.ext h1) (Fin.ext h2)
    have hsB : Function.Injective (fun β : Fin A × Fin m =>
        Finsupp.single (0 : Fin 2) (β.1 : ℕ) + Finsupp.single 1 (β.2 : ℕ)) := by
      intro ε ε' h
      obtain ⟨h1, h2⟩ := hexp _ _ _ _ h
      exact Prod.ext (Fin.ext h1) (Fin.ext h2)
    have hw : LinearIndependent K (fun ε => ρ0 (e ε)) := by
      rw [Fintype.linearIndependent_iff]
      intro a ha ε
      let P : MvPolynomial (Fin 2) K := ∑ ε', a ε' • e ε'
      have hρP : ρ0 P = 0 := by
        simp only [P, map_sum, map_smul]
        exact ha
      have hPv : P ∈ Hv := by
        refine Submodule.sum_mem _ (fun ε' _ => Submodule.smul_mem _ _ ?_)
        rw [he]
        refine hmemR _ _ _ ?_
        simp [Fin.is_lt]
      have hP0 : P = 0 := by
        by_contra hne
        exact (hdag P hne (hdegv P hPv)).1 hρP
      have hc : P.coeff (Finsupp.single 0 (ε.1 : ℕ) + Finsupp.single 1 (ε.2 : ℕ)) = a ε := by
        simp only [P, he]
        exact hcoef a _ hsE ε
      rw [hP0, MvPolynomial.coeff_zero] at hc
      exact hc.symm
    let h : Fin (I + 1) × Fin m → MvPolynomial (Fin 2) K := fun ε => ∑ β, x (ε, β) • b β
    have hhH : ∀ ε, h ε ∈ H := by
      intro ε
      refine Submodule.sum_mem _ (fun β _ => Submodule.smul_mem _ _ ?_)
      rw [hb]
      refine hmemR _ _ _ ?_
      simp [Fin.is_lt]
    have hne : ∃ ε, h ε ≠ 0 := by
      obtain ⟨κ, hκ⟩ := Function.ne_iff.mp hx0
      refine ⟨κ.1, fun h0 => hκ ?_⟩
      have hc : (h κ.1).coeff (Finsupp.single 0 (κ.2.1 : ℕ) + Finsupp.single 1 (κ.2.2 : ℕ)) =
          x κ := by
        simp only [h, hb]
        exact hcoef (fun β => x (κ.1, β)) _ hsB κ.2
      rw [h0, MvPolynomial.coeff_zero] at hc
      rw [Pi.zero_apply]
      exact hc.symm
    have hΦ : Φ = ∑ ε, h ε * e ε ^ Nat.card K := by
      simp only [Φ, h, Fintype.sum_prod_type, Finset.sum_mul, smul_mul_assoc]
    apply lw_stepanov_frobenius_independence K ρ0 H hH e hw h hhH hne
    rw [← hΦ]
    obtain ⟨r, hr⟩ := hdvd
    rw [hr, map_mul, h03, zero_mul]
  ·
    refine MvPolynomial.totalDegree_finsetSum_le (fun κ _ => ?_)
    refine (MvPolynomial.totalDegree_smul_le _ _).trans ?_
    refine (MvPolynomial.totalDegree_mul _ _).trans ?_
    have := κ.2.1.isLt
    have := κ.2.2.isLt
    have := κ.1.1.isLt
    have := κ.1.2.isLt
    have h2 : (b κ.2).totalDegree ≤ κ.2.1 + κ.2.2 := hdegXY _ _
    have h3 : (e κ.1 ^ Nat.card K).totalDegree ≤ Nat.card K * (κ.1.1 + κ.1.2 : ℕ) :=
      (MvPolynomial.totalDegree_pow _ _).trans (Nat.mul_le_mul_left _ (hdegXY _ _))
    have h4 : Nat.card K * (κ.1.1 + κ.1.2 : ℕ) ≤ Nat.card K * (I + m) :=
      Nat.mul_le_mul_left _ (by omega)
    omega
  ·
    intro z hz hcz
    obtain ⟨h1, h2, h3⟩ := hgood z hz hcz
    refine ⟨h1, h3, ?_⟩
    apply PowerSeries.nat_le_order
    intro l hl
    rw [h2]
    have hlq : l < Nat.card K := lt_of_lt_of_le hl hL
    have hΔ : PowerSeries.coeff l (ζ Φ) =
        ∑ κ : (Fin (I + 1) × Fin m) × (Fin A × Fin m),
          x κ • (PowerSeries.coeff l (ζ (b κ.2)) * e κ.1 ^ Nat.card K) := by
      simp only [Φ, map_sum, map_smul, PowerSeries.coeff_smul]
      refine Finset.sum_congr rfl (fun κ _ => ?_)
      rw [s3 ζ hζ (b κ.2) (e κ.1) l hlq]
    have hev : MvPolynomial.eval z (PowerSeries.coeff l (ζ Φ)) =
        MvPolynomial.eval z (Λ l x) := by
      rw [hΔ]
      show _ = MvPolynomial.eval z (∑ κ, x κ • (PowerSeries.coeff l (ζ (b κ.2)) * e κ.1))
      simp only [map_sum, MvPolynomial.smul_eval, map_mul, map_pow, hpow]
    obtain ⟨r, hr⟩ := hxg l hl
    rw [hev, hr, map_mul, hz, zero_mul, mul_zero]

theorem lw_plane_curve_upper (D : ℕ) (η : ℝ) (hη : 0 < η) :
    ∃ Q₁ : ℕ, ∀ (K : Type u) [Field K] [Finite K] (g : MvPolynomial (Fin 2) K),
      g.totalDegree ≤ D →
      Irreducible (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g) →
      Q₁ ≤ Nat.card K →
      (Nat.card {z : Fin 2 → K // MvPolynomial.eval z g = 0} : ℝ) ≤
        (Nat.card K : ℝ) + η * (Nat.card K : ℝ) :=
by
  classical
  obtain ⟨M', hM'⟩ := exists_nat_gt (1 / η)
  have hMη : 1 < (M' : ℝ) * η := by
    have := (div_lt_iff₀ hη).mp hM'
    linarith
  obtain ⟨a, ha⟩ : ∃ a : ℕ, a = 4 * (M' + 1) ^ 2 * (1 + D ^ 2) + 1 := ⟨_, rfl⟩
  obtain ⟨K0, hK0⟩ : ∃ K0 : ℕ, K0 = D * a + 1 := ⟨_, rfl⟩
  refine ⟨(4 * D ^ 2 + 1) * K0 + 2 * ((2 * M' + 1) * D ^ 4 + D * a) + (D + 2), ?_⟩
  intro K _ _ g hgD hirr hQ
  have hq1 : D + 2 ≤ Nat.card K := le_trans (Nat.le_add_left _ _) hQ
  have hqA : (4 * D ^ 2 + 1) * K0 ≤ Nat.card K :=
    le_trans (le_trans (Nat.le_add_right _ _) (Nat.le_add_right _ _)) hQ
  have hq2 : 2 * ((2 * M' + 1) * D ^ 4 + D * a) ≤ Nat.card K :=
    le_trans (le_trans (Nat.le_add_left _ _) (Nat.le_add_right _ _)) hQ
  obtain ⟨k, g', hkD, hdeg', hmon', hder', hirr', hN'⟩ :=
    lw_curve_normal_form D K g hgD hirr hq1
  rw [← hN']
  obtain ⟨m, hm⟩ : ∃ m : ℕ, m = k + 1 := ⟨_, rfl⟩
  rw [← hm] at hdeg' hmon' hkD
  have hm1 : 1 ≤ m := by omega
  have hmD : m ≤ D := hkD
  have hbad := lw_upper_singular_points K m g' hm1 hdeg' hmon' hder' hirr'
  letI : Fintype K := Fintype.ofFinite K
  set S : Finset (Fin 2 → K) := Finset.univ.filter (fun z => MvPolynomial.eval z g' = 0 ∧
    ¬ MvPolynomial.eval z (MvPolynomial.pderiv 1 g') = 0) with hS
  set B : ℕ := Nat.card {z : Fin 2 → K // MvPolynomial.eval z g' = 0 ∧
      MvPolynomial.eval z (MvPolynomial.pderiv 1 g') = 0} with hB
  have hNsplit : Nat.card {z : Fin 2 → K // MvPolynomial.eval z g' = 0} = S.card + B := by
    rw [hB]
    simp only [Nat.card_eq_fintype_card, Fintype.card_subtype, hS]
    rw [← Finset.card_filter_add_card_filter_not
      (s := Finset.univ.filter (fun z : Fin 2 → K => MvPolynomial.eval z g' = 0))
      (fun z => MvPolynomial.eval z (MvPolynomial.pderiv 1 g') = 0),
      Finset.filter_filter, Finset.filter_filter, add_comm]
  rw [hNsplit]
  set q : ℕ := Nat.card K with hqdef
  have hK0pos : 0 < K0 := by omega
  have hqR1 : (1 : ℝ) ≤ q := by exact_mod_cast (show 1 ≤ q by omega)
  have hη0 : 0 ≤ η * (q : ℝ) := by positivity
  by_cases hG : S = ∅
  · have h1 : D ^ 2 ≤ a := by
      rw [ha]
      calc D ^ 2 ≤ 1 + D ^ 2 := Nat.le_add_left _ _
        _ ≤ 4 * (M' + 1) ^ 2 * (1 + D ^ 2) := Nat.le_mul_of_pos_left _ (by positivity)
        _ ≤ 4 * (M' + 1) ^ 2 * (1 + D ^ 2) + 1 := Nat.le_succ _
    have hD3 : D ^ 3 ≤ q := by
      calc D ^ 3 = D * D ^ 2 := by ring
        _ ≤ D * a := Nat.mul_le_mul_left _ h1
        _ ≤ K0 := by omega
        _ ≤ (4 * D ^ 2 + 1) * K0 := Nat.le_mul_of_pos_left _ (by positivity)
        _ ≤ q := hqA
    have hBq : S.card + B ≤ q := by
      rw [hG, Finset.card_empty, zero_add]
      exact le_trans hbad (le_trans (Nat.pow_le_pow_left hmD 3) hD3)
    have : ((S.card + B : ℕ) : ℝ) ≤ (q : ℝ) := by exact_mod_cast hBq
    push_cast at this ⊢
    linarith
  · obtain ⟨z₀, hz₀⟩ := Finset.nonempty_iff_ne_empty.mpr hG
    have hz₀' := (Finset.mem_filter.mp hz₀).2
    obtain ⟨n, hn⟩ : ∃ n : ℕ, n = q / K0 := ⟨_, rfl⟩
    have hn1 : n * K0 ≤ q := by rw [hn]; exact Nat.div_mul_le_self q K0
    have hn2 : 4 * D ^ 2 + 1 ≤ n := by rw [hn]; exact (Nat.le_div_iff_mul_le hK0pos).mpr hqA
    obtain ⟨P, hP⟩ : ∃ P : ℕ, P = 2 * M' + 1 := ⟨_, rfl⟩
    obtain ⟨A, hA⟩ : ∃ A : ℕ, A = a * n := ⟨_, rfl⟩
    obtain ⟨I, hI⟩ : ∃ I : ℕ, I = (P + 1) * n := ⟨_, rfl⟩
    obtain ⟨L, hL⟩ : ∃ L : ℕ, L = m * P * n := ⟨_, rfl⟩
    have Ra : (a : ℝ) = 4 * ((M' : ℝ) + 1) ^ 2 * (1 + (D : ℝ) ^ 2) + 1 := by
      rw [ha]; push_cast; ring
    have RP : (P : ℝ) = 2 * (M' : ℝ) + 1 := by rw [hP]; push_cast; ring
    have RA : (A : ℝ) = (a : ℝ) * n := by rw [hA]; push_cast; ring
    have RI : (I : ℝ) = ((P : ℝ) + 1) * n := by rw [hI]; push_cast; ring
    have RL : (L : ℝ) = (m : ℝ) * P * n := by rw [hL]; push_cast; ring
    have Rn1 : (n : ℝ) * ((D : ℝ) * a + 1) ≤ q := by
      have : ((n * K0 : ℕ) : ℝ) ≤ (q : ℝ) := by exact_mod_cast hn1
      rw [hK0] at this; push_cast at this; linarith
    have Rn2 : 4 * (D : ℝ) ^ 2 + 1 ≤ n := by exact_mod_cast hn2
    have Rq2 : 2 * ((P : ℝ) * (D : ℝ) ^ 4 + (D : ℝ) * a) ≤ q := by
      have : ((2 * ((2 * M' + 1) * D ^ 4 + D * a) : ℕ) : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq2
      push_cast at this; rw [RP]; linarith
    have Rm1 : (1 : ℝ) ≤ m := by exact_mod_cast hm1
    have RmD : (m : ℝ) ≤ D := by exact_mod_cast hmD
    have hM0 : (0 : ℝ) ≤ M' := Nat.cast_nonneg _
    have hD0 : (0 : ℝ) ≤ D := Nat.cast_nonneg _
    have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg _
    have hq0 : (0 : ℝ) ≤ q := Nat.cast_nonneg _
    have ha0 : (0 : ℝ) ≤ a := Nat.cast_nonneg _
    have hP1 : (1 : ℝ) ≤ P := by rw [RP]; linarith
    have hn1R : (1 : ℝ) ≤ n := by nlinarith
    have hD1 : (1 : ℝ) ≤ D := le_trans Rm1 RmD
    have haP : (a : ℝ) = ((P : ℝ) + 1) ^ 2 * (1 + (D : ℝ) ^ 2) + 1 := by rw [Ra, RP]; ring
    have hPa : (P : ℝ) ≤ a := by
      rw [haP]; nlinarith [mul_nonneg (sq_nonneg ((P : ℝ) + 1)) (sq_nonneg (D : ℝ))]
    have hmPDa : (m : ℝ) * P ≤ D * a :=
      mul_le_mul RmD hPa (by linarith) hD0
    have hC1 : L ≤ q := by
      have h : (L : ℝ) ≤ q := by
        rw [RL]
        nlinarith [mul_le_mul_of_nonneg_right hmPDa hn0]
      exact_mod_cast h
    have hC2 : m * (A + m) < q := by
      have hm2 : (m : ℝ) ^ 2 ≤ (D : ℝ) ^ 2 := pow_le_pow_left₀ (by linarith) RmD 2
      have h : (m : ℝ) * ((A : ℝ) + m) < q := by
        rw [RA]
        nlinarith [mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right RmD ha0) hn0]
      exact_mod_cast h
    have hC3 : L * (A + I + 2 * m) + m * L ^ 2 < m * A * (I + 1) := by
      have hx : (m : ℝ) * P ≤ D * ((P : ℝ) + 1) :=
        mul_le_mul RmD (by linarith) (by linarith) hD0
      have hx2 : ((m : ℝ) * P) ^ 2 ≤ ((D : ℝ) * ((P : ℝ) + 1)) ^ 2 :=
        pow_le_pow_left₀ (by nlinarith) hx 2
      have hy : (2 : ℝ) ≤ (D : ℝ) * ((P : ℝ) + 1) := by nlinarith
      have h1 : (P : ℝ) * (P + 1) + (m : ℝ) ^ 2 * P ^ 2 + 1 ≤ a := by
        rw [haP]; nlinarith
      have h2 : 2 * (m : ℝ) * P + 1 ≤ a := by
        rw [haP]
        nlinarith [mul_le_mul_of_nonneg_left hy (show (0 : ℝ) ≤ (D : ℝ) * ((P : ℝ) + 1) by
          nlinarith)]
      have e : (m : ℝ) * A * ((I : ℝ) + 1) - ((L : ℝ) * ((A : ℝ) + I + 2 * m) + m * (L : ℝ) ^ 2) =
          (m : ℝ) * ((n : ℝ) ^ 2 * (a - P * (P + 1) - (m : ℝ) ^ 2 * P ^ 2) +
            n * (a - 2 * m * P)) := by
        rw [RA, RI, RL]; ring
      have hpos : 0 < (m : ℝ) * ((n : ℝ) ^ 2 * (a - P * (P + 1) - (m : ℝ) ^ 2 * P ^ 2) +
            n * (a - 2 * m * P)) := by
        apply mul_pos (by linarith)
        exact add_pos (mul_pos (by positivity) (by linarith)) (mul_pos (by linarith) (by linarith))
      have h : (L : ℝ) * ((A : ℝ) + I + 2 * m) + m * (L : ℝ) ^ 2 < m * A * ((I : ℝ) + 1) := by
        linarith
      exact_mod_cast h
    obtain ⟨Φ, φ, hΦ, hΦdeg, hφ⟩ := lw_upper_stepanov_aux K m g' hm1 hdeg' hmon' hder' hirr'
      A I L hC1 hC2 hC3 z₀ hz₀'.1 hz₀'.2
    have hgood : ∀ z ∈ S, MvPolynomial.eval z g' = 0 ∧
        MvPolynomial.eval z (MvPolynomial.pderiv 1 g') ≠ 0 := fun z hz =>
      (Finset.mem_filter.mp hz).2
    have hsum := lw_upper_branch_order_sum K m g' hm1 hdeg' hmon' hirr' S φ
      (fun z hz => (hφ z (hgood z hz).1 (hgood z hz).2).1)
      (fun z hz => (hφ z (hgood z hz).1 (hgood z hz).2).2.1) Φ hΦ
    have hcardL : S.card * L ≤ m * Φ.totalDegree := by
      have h1 : S.card • (L : ℕ∞) ≤ ∑ z ∈ S, (MvPolynomial.aeval
          ![algebraMap K (PowerSeries K) (z 0) + PowerSeries.X, φ z] Φ).order :=
        Finset.card_nsmul_le_sum _ _ _ (fun z hz => (hφ z (hgood z hz).1 (hgood z hz).2).2.2)
      have h2 := h1.trans hsum
      rw [nsmul_eq_mul] at h2
      exact_mod_cast h2
    have hLN : L * (S.card + B) ≤ L * m ^ 3 + m * (A + m + q * (I + m)) := by
      have h3 : S.card * L ≤ m * (A + m + q * (I + m)) :=
        le_trans hcardL (Nat.mul_le_mul_left _ hΦdeg)
      calc L * (S.card + B) = S.card * L + L * B := by ring
        _ ≤ m * (A + m + q * (I + m)) + L * m ^ 3 := add_le_add h3 (Nat.mul_le_mul_left _ hbad)
        _ = L * m ^ 3 + m * (A + m + q * (I + m)) := by ring
    have hLNR : (L : ℝ) * ((S.card : ℝ) + B) ≤
        (L : ℝ) * (m : ℝ) ^ 3 + m * ((A : ℝ) + m + q * ((I : ℝ) + m)) := by
      exact_mod_cast hLN
    have hPη : 1 ≤ (P : ℝ) * η - 1 := by
      rw [RP]; nlinarith
    have hm4 : (m : ℝ) ^ 4 ≤ (D : ℝ) ^ 4 := pow_le_pow_left₀ (by linarith) RmD 4
    have hm2 : (m : ℝ) ^ 2 ≤ (D : ℝ) ^ 2 := pow_le_pow_left₀ (by linarith) RmD 2
    have hb : (L : ℝ) * (m : ℝ) ^ 3 + m * A ≤ n * q / 2 := by
      have e1 : (L : ℝ) * (m : ℝ) ^ 3 + m * A = (m : ℝ) ^ 4 * (P * n) + m * (a * n) := by
        rw [RL, RA]; ring
      rw [e1]
      have i1 := mul_le_mul_of_nonneg_right hm4 (show (0 : ℝ) ≤ P * n by positivity)
      have i2 := mul_le_mul_of_nonneg_right RmD (show (0 : ℝ) ≤ a * n by positivity)
      nlinarith [mul_le_mul_of_nonneg_left Rq2 hn0]
    have hc : (m : ℝ) * m + m * m * q ≤ n * q / 2 := by
      have i1 : (m : ℝ) * m ≤ m * m * q := le_mul_of_one_le_right (by positivity) hqR1
      have i2 : (m : ℝ) * m * q ≤ (D : ℝ) ^ 2 * q :=
        mul_le_mul_of_nonneg_right (by nlinarith) hq0
      have i3 : 4 * (D : ℝ) ^ 2 * q ≤ n * q := mul_le_mul_of_nonneg_right (by linarith) hq0
      linarith
    have ha' : (n : ℝ) * q ≤ m * n * q * ((P : ℝ) * η - 1) := by
      have i1 : (n : ℝ) * q ≤ m * (n * q) := le_mul_of_one_le_left (by positivity) Rm1
      have i2 : (m : ℝ) * (n * q) ≤ m * (n * q) * ((P : ℝ) * η - 1) :=
        le_mul_of_one_le_right (by positivity) hPη
      nlinarith
    have e2 : (L : ℝ) * ((q : ℝ) + η * q) - m * q * I = m * n * q * ((P : ℝ) * η - 1) := by
      rw [RL, RI]; ring
    have hX : (L : ℝ) * (m : ℝ) ^ 3 + m * ((A : ℝ) + m + q * ((I : ℝ) + m)) ≤
        (L : ℝ) * ((q : ℝ) + η * q) := by
      nlinarith
    have hLpos : (0 : ℝ) < L := by
      rw [RL]; positivity
    have hfin : (L : ℝ) * ((S.card : ℝ) + B) ≤ (L : ℝ) * ((q : ℝ) + η * q) := le_trans hLNR hX
    have := le_of_mul_le_mul_left hfin hLpos
    push_cast
    linarith

theorem lw_fibre_twist_identity (K : Type u) [Field K] [Finite K] (k : ℕ)
    (g : MvPolynomial (Fin 2) K) (u₀ : K) (S : Finset (AlgebraicClosure K))
    (hS : S.card = k + 1)
    (hSroot : ∀ s, MvPolynomial.aeval ![algebraMap K (AlgebraicClosure K) u₀, s] g = 0 ↔ s ∈ S) :
    k.factorial * Nat.card {v : K // MvPolynomial.eval ![u₀, v] g = 0} +
      ∑ σ ∈ Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0),
        lwTwistCount K k g σ u₀ = (k + 1).factorial :=
by
  classical
  haveI : Fintype K := Fintype.ofFinite K
  have hq : Nat.card K = Fintype.card K := Nat.card_eq_fintype_card
  have hq1 : 1 < Fintype.card K := Fintype.one_lt_card

  have hcount : ∀ τ : Equiv.Perm (Fin (k + 1)),
      k.factorial * Nat.card {j : Fin (k + 1) // τ j = j} +
        ∑ σ ∈ Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0),
          Nat.card {π : Equiv.Perm (Fin (k + 1)) // ∀ i, τ (π i) = π (σ i)} =
        (k + 1).factorial := by
    intro τ
    have h1 : ∀ σ π : Equiv.Perm (Fin (k + 1)),
        (∀ i, τ (π i) = π (σ i)) ↔ π⁻¹ * τ * π = σ := by
      intro σ π
      constructor
      · intro h
        ext i
        simp [Equiv.Perm.mul_apply, h]
      · intro h i
        rw [← h]
        simp [Equiv.Perm.mul_apply]
    have h2 : ∀ σ : Equiv.Perm (Fin (k + 1)),
        Nat.card {π : Equiv.Perm (Fin (k + 1)) // ∀ i, τ (π i) = π (σ i)} =
          (Finset.univ.filter fun π : Equiv.Perm (Fin (k + 1)) => π⁻¹ * τ * π = σ).card := by
      intro σ
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
      exact congrArg Finset.card (Finset.filter_congr (fun π _ => h1 σ π))
    have h3 : ∑ σ ∈ Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0),
          (Finset.univ.filter fun π : Equiv.Perm (Fin (k + 1)) => π⁻¹ * τ * π = σ).card =
        (Finset.univ.filter fun π : Equiv.Perm (Fin (k + 1)) => (π⁻¹ * τ * π) 0 ≠ 0).card := by
      rw [Finset.card_eq_sum_card_fiberwise (f := fun π : Equiv.Perm (Fin (k + 1)) => π⁻¹ * τ * π)
        (t := Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0))]
      · refine Finset.sum_congr rfl (fun σ hσ => ?_)
        rw [Finset.filter_filter]
        refine congrArg Finset.card (Finset.filter_congr (fun π _ => ?_))
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hσ
        constructor
        · intro h; exact ⟨by rw [h]; exact hσ, h⟩
        · intro h; exact h.2
      · intro π hπ
        simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_setOf_eq] at hπ ⊢
        exact hπ
    have h4 : (Finset.univ.filter fun π : Equiv.Perm (Fin (k + 1)) => (π⁻¹ * τ * π) 0 ≠ 0) =
        Finset.univ.filter fun π : Equiv.Perm (Fin (k + 1)) => ¬ τ (π 0) = π 0 := by
      refine Finset.filter_congr (fun π _ => ?_)
      rw [Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, ne_eq, Equiv.Perm.inv_eq_iff_eq]
    have hd : ∀ π : Equiv.Perm (Fin (k + 1)), (Equiv.Perm.decomposeFin π).1 = π 0 := by
      intro π
      have := Equiv.Perm.decomposeFin_symm_apply_zero (Equiv.Perm.decomposeFin π).1
        (Equiv.Perm.decomposeFin π).2
      rw [Prod.mk.eta, Equiv.symm_apply_apply] at this
      exact this.symm
    have hfib : ∀ j : Fin (k + 1),
        (Finset.univ.filter fun π : Equiv.Perm (Fin (k + 1)) => π 0 = j).card = k.factorial := by
      intro j
      rw [← Fintype.card_subtype]
      rw [Fintype.card_congr ((Equiv.subtypeEquiv Equiv.Perm.decomposeFin
        (fun π => by rw [hd])).trans
          (Equiv.prodSubtypeFstEquivSubtypeProd (p := fun a : Fin (k + 1) => a = j)))]
      rw [Fintype.card_prod, Fintype.card_subtype_eq, Fintype.card_perm, Fintype.card_fin, one_mul]
    have h5 : (Finset.univ.filter fun π : Equiv.Perm (Fin (k + 1)) => τ (π 0) = π 0).card =
        (Finset.univ.filter fun j : Fin (k + 1) => τ j = j).card * k.factorial := by
      rw [Finset.card_eq_sum_card_fiberwise (f := fun π : Equiv.Perm (Fin (k + 1)) => π 0)
        (t := Finset.univ.filter fun j : Fin (k + 1) => τ j = j)]
      · rw [← smul_eq_mul, ← Finset.sum_const]
        refine Finset.sum_congr rfl (fun j hj => ?_)
        rw [← hfib j, Finset.filter_filter]
        refine congrArg Finset.card (Finset.filter_congr (fun π _ => ?_))
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hj
        constructor
        · intro h; exact h.2
        · intro h; exact ⟨by rw [h]; exact hj, h⟩
      · intro π hπ
        simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_setOf_eq] at hπ ⊢
        exact hπ
    have h6 := Finset.card_filter_add_card_filter_not
      (s := (Finset.univ : Finset (Equiv.Perm (Fin (k + 1)))))
      (fun π : Equiv.Perm (Fin (k + 1)) => τ (π 0) = π 0)
    rw [Finset.card_univ, Fintype.card_perm, Fintype.card_fin] at h6
    have h7 : Nat.card {j : Fin (k + 1) // τ j = j} =
        (Finset.univ.filter fun j : Fin (k + 1) => τ j = j).card := by
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
    rw [Finset.sum_congr rfl (fun σ _ => h2 σ), h3, h4, h7, ← h6, h5, mul_comm]

  set ι := algebraMap K (AlgebraicClosure K) with hι
  have hιinj : Function.Injective ι := ι.injective
  have hfrob : ∀ x : Fin 2 → AlgebraicClosure K,
      MvPolynomial.aeval (fun i => x i ^ Nat.card K) g = (MvPolynomial.aeval x g) ^ Nat.card K := by
    intro x
    have h := DFunLike.congr_fun
      (MvPolynomial.comp_aeval x (FiniteField.frobeniusAlgHom K (AlgebraicClosure K))) g
    simp only [AlgHom.comp_apply, FiniteField.frobeniusAlgHom_apply] at h
    rw [hq]; exact h.symm
  have hpowι : ∀ v : K, (ι v) ^ Nat.card K = ι v := by
    intro v; rw [← map_pow, hq, FiniteField.pow_card]
  have hmaps : ∀ s ∈ S, s ^ Nat.card K ∈ S := by
    intro s hs
    rw [← hSroot] at hs ⊢
    have h := hfrob ![ι u₀, s]
    rw [hs, zero_pow (by omega)] at h
    have hv : (fun i => ![ι u₀, s] i ^ Nat.card K) = ![ι u₀, s ^ Nat.card K] := by
      ext i; fin_cases i
      · exact hpowι u₀
      · rfl
    rw [hv] at h
    exact h
  have hpowinj : ∀ s t : AlgebraicClosure K, s ^ Nat.card K = t ^ Nat.card K → s = t := by
    intro s t h
    have hinj := (FiniteField.frobeniusAlgHom K (AlgebraicClosure K) :
      AlgebraicClosure K →+* AlgebraicClosure K).injective
    apply hinj
    change FiniteField.frobeniusAlgHom K (AlgebraicClosure K) s =
      FiniteField.frobeniusAlgHom K (AlgebraicClosure K) t
    rw [FiniteField.frobeniusAlgHom_apply, FiniteField.frobeniusAlgHom_apply, ← hq]
    exact h
  have hfixrat : ∀ s : AlgebraicClosure K, s ^ Nat.card K = s → ∃ v : K, ι v = s := by
    intro s hs
    rw [hq] at hs
    set Q : Polynomial (AlgebraicClosure K) := Polynomial.X ^ Fintype.card K - Polynomial.X
      with hQ
    have hQ0 : Q ≠ 0 := FiniteField.X_pow_card_sub_X_ne_zero (AlgebraicClosure K) hq1
    have hQd : Q.natDegree = Fintype.card K :=
      FiniteField.X_pow_card_sub_X_natDegree_eq (AlgebraicClosure K) hq1
    have hroot : ∀ x : AlgebraicClosure K, x ^ Fintype.card K = x → x ∈ Q.roots.toFinset := by
      intro x hx
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hQ0, Polynomial.IsRoot.def, hQ,
        Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, hx, sub_self]
    have hsub : Finset.univ.image ι ⊆ Q.roots.toFinset := by
      intro x hx
      obtain ⟨v, _, rfl⟩ := Finset.mem_image.mp hx
      apply hroot
      rw [← hq]; exact hpowι v
    have hcard : Q.roots.toFinset.card ≤ (Finset.univ.image ι).card := by
      rw [Finset.card_image_of_injective _ hιinj, Finset.card_univ]
      calc Q.roots.toFinset.card ≤ Q.roots.card := Multiset.toFinset_card_le _
        _ ≤ Q.natDegree := Polynomial.card_roots' Q
        _ = Fintype.card K := hQd
    have heq := Finset.eq_of_subset_of_card_le hsub hcard
    have hs' := hroot s hs
    rw [← heq] at hs'
    obtain ⟨v, _, hv⟩ := Finset.mem_image.mp hs'
    exact ⟨v, hv⟩
  have hbridge : ∀ v : K, MvPolynomial.aeval ![ι u₀, ι v] g = ι (MvPolynomial.eval ![u₀, v] g) := by
    intro v
    have : ![ι u₀, ι v] = ι ∘ ![u₀, v] := by
      ext i; fin_cases i <;> rfl
    rw [this, MvPolynomial.aeval_algebraMap_apply]
    rfl

  obtain ⟨E, hEinj, hES, hEsurj⟩ : ∃ E : Fin (k + 1) → AlgebraicClosure K, Function.Injective E ∧
      (∀ j, E j ∈ S) ∧ ∀ s ∈ S, ∃ j, E j = s := by
    let e := Finset.equivFinOfCardEq hS
    refine ⟨fun j => (e.symm j : AlgebraicClosure K), Subtype.val_injective.comp e.symm.injective,
      fun j => (e.symm j).2, fun s hs => ⟨e ⟨s, hs⟩, by simp⟩⟩
  choose f hf using fun j => hEsurj _ (hmaps _ (hES j))
  have hfinj : Function.Injective f := by
    intro j j' h
    apply hEinj
    apply hpowinj
    rw [← hf j, ← hf j', h]
  set τ : Equiv.Perm (Fin (k + 1)) := Equiv.ofBijective f (Finite.injective_iff_bijective.mp hfinj)
    with hτ
  have hkey : ∀ j, E (τ j) = E j ^ Nat.card K := fun j => hf j

  have hfix : Nat.card {v : K // MvPolynomial.eval ![u₀, v] g = 0} =
      Nat.card {j : Fin (k + 1) // τ j = j} := by
    have hmem : ∀ v : K, MvPolynomial.eval ![u₀, v] g = 0 → ι v ∈ S := by
      intro v hv
      rw [← hSroot, hbridge, hv, map_zero]
    choose J hJ using fun (v : {v : K // MvPolynomial.eval ![u₀, v] g = 0}) =>
      hEsurj _ (hmem v.1 v.2)
    refine Nat.card_eq_of_bijective (fun v => ⟨J v, ?_⟩) ⟨?_, ?_⟩
    · apply hEinj
      rw [hkey, hJ, hpowι]
    · intro v w h
      have h' : J v = J w := congrArg Subtype.val h
      apply Subtype.ext
      apply hιinj
      rw [← hJ v, ← hJ w, h']
    · rintro ⟨j, hj⟩
      have h1 : E j ^ Nat.card K = E j := by rw [← hkey, hj]
      obtain ⟨v, hv⟩ := hfixrat _ h1
      have hv0 : MvPolynomial.eval ![u₀, v] g = 0 := by
        apply hιinj
        rw [← hbridge, map_zero, hv, hSroot]
        exact hES j
      refine ⟨⟨v, hv0⟩, Subtype.ext ?_⟩
      apply hEinj
      simp only
      rw [hJ, hv]

  have htw : ∀ σ : Equiv.Perm (Fin (k + 1)), lwTwistCount K k g σ u₀ =
      Nat.card {π : Equiv.Perm (Fin (k + 1)) // ∀ i, τ (π i) = π (σ i)} := by
    intro σ
    unfold lwTwistCount
    symm
    refine Nat.card_eq_of_bijective (fun π => ⟨fun i => E (π.1 i), ?_, ?_, ?_⟩) ⟨?_, ?_⟩
    · exact hEinj.comp π.1.injective
    · intro i; rw [hSroot]; exact hES _
    · intro i
      rw [← hkey, π.2 i]
    · intro π π' h
      have h' := congrArg Subtype.val h
      apply Subtype.ext
      ext i
      exact congrArg Fin.val (hEinj (congrFun h' i))
    · rintro ⟨r, hrinj, hrroot, hrfrob⟩
      have hrS : ∀ i, r i ∈ S := fun i => (hSroot _).mp (hrroot i)
      choose p hp using fun i => hEsurj _ (hrS i)
      have hpinj : Function.Injective p := by
        intro i i' h
        apply hrinj
        rw [← hp i, ← hp i', h]
      refine ⟨⟨Equiv.ofBijective p (Finite.injective_iff_bijective.mp hpinj), ?_⟩, ?_⟩
      · intro i
        apply hEinj
        simp only [Equiv.ofBijective_apply]
        rw [hkey, hp, hp, hrfrob]
      · apply Subtype.ext
        funext i
        simp only [Equiv.ofBijective_apply]
        exact hp i
  rw [hfix, Finset.sum_congr rfl (fun σ _ => htw σ)]
  exact hcount τ

theorem lw_coset_twist_count (k : ℕ) (H : Subgroup (Equiv.Perm (Fin (k + 1))))
    (hH : ∀ i j : Fin (k + 1), ∃ h ∈ H, h i = j) (ρ : Equiv.Perm (Fin (k + 1))) :
    ∑ σ ∈ Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0),
        Nat.card {π : Equiv.Perm (Fin (k + 1)) // ∃ h ∈ H, π * σ * π⁻¹ = h * ρ} +
      Nat.card H * k.factorial = Nat.card H * (k + 1).factorial :=
by
  classical

  set c : ℕ := (Finset.univ.filter
    (fun h : Equiv.Perm (Fin (k + 1)) => h ∈ H ∧ h 0 = 0)).card with hc
  set N : ℕ := (Finset.univ.filter (fun h : Equiv.Perm (Fin (k + 1)) => h ∈ H)).card with hNdef
  have hHN : Nat.card H = N := by
    rw [hNdef, ← Fintype.card_subtype, ← Nat.card_eq_fintype_card]

  have hfib : ∀ a b : Fin (k + 1), (Finset.univ.filter
      (fun h : Equiv.Perm (Fin (k + 1)) => h ∈ H ∧ h a = b)).card = c := by
    intro a b
    obtain ⟨ga, hgaH, rfl⟩ := hH 0 a
    obtain ⟨gb, hgbH, rfl⟩ := hH 0 b
    rw [hc]
    apply Finset.card_nbij' (fun h => gb⁻¹ * h * ga) (fun h => gb * h * ga⁻¹)
    · intro h hh
      simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_setOf_eq] at hh ⊢
      refine ⟨H.mul_mem (H.mul_mem (H.inv_mem hgbH) hh.1) hgaH, ?_⟩
      simp [Equiv.Perm.mul_apply, hh.2]
    · intro h hh
      simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_setOf_eq] at hh ⊢
      refine ⟨H.mul_mem (H.mul_mem hgbH hh.1) (H.inv_mem hgaH), ?_⟩
      simp [Equiv.Perm.mul_apply, hh.2]
    · intro h _
      group
    · intro h _
      group
  have hNc : N = (k + 1) * c := by
    rw [hNdef, Finset.card_eq_sum_card_fiberwise (f := fun h : Equiv.Perm (Fin (k + 1)) => h 0)
      (t := Finset.univ) (fun _ _ => Finset.mem_coe.mpr (Finset.mem_univ _))]
    simp only [Finset.filter_filter, hfib 0, Finset.sum_const, Finset.card_univ,
      Fintype.card_fin, smul_eq_mul]

  have hper : ∀ π : Equiv.Perm (Fin (k + 1)),
      ((Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0)).filter
        (fun σ => ∃ h ∈ H, π * σ * π⁻¹ = h * ρ)).card + c = N := by
    intro π
    have hall : (Finset.univ.filter
        (fun σ : Equiv.Perm (Fin (k + 1)) => ∃ h ∈ H, π * σ * π⁻¹ = h * ρ)).card = N := by
      rw [hNdef]
      apply Finset.card_nbij' (fun σ => π * σ * π⁻¹ * ρ⁻¹) (fun h => π⁻¹ * h * ρ * π)
      · intro σ hσ
        simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_setOf_eq] at hσ ⊢
        obtain ⟨h, hh, he⟩ := hσ
        rw [he]
        simpa using hh
      · intro h hh
        simp only [Finset.coe_filter, Finset.mem_univ, true_and, Set.mem_setOf_eq] at hh ⊢
        exact ⟨h, hh, by group⟩
      · intro σ _
        group
      · intro h _
        group
    have hfix : ((Finset.univ.filter
        (fun σ : Equiv.Perm (Fin (k + 1)) => ∃ h ∈ H, π * σ * π⁻¹ = h * ρ)).filter
          (fun σ => σ 0 = 0)).card = c := by
      rw [← hfib (ρ (π 0)) (π 0)]
      apply Finset.card_nbij' (fun σ => π * σ * π⁻¹ * ρ⁻¹) (fun h => π⁻¹ * h * ρ * π)
      · intro σ hσ
        simp only [Finset.coe_filter, Finset.mem_filter, Finset.mem_univ, true_and,
          Set.mem_setOf_eq] at hσ ⊢
        obtain ⟨⟨h, hh, he⟩, h0⟩ := hσ
        refine ⟨?_, ?_⟩
        · rw [he]
          simpa using hh
        · simp [Equiv.Perm.mul_apply, h0]
      · intro h hh
        simp only [Finset.coe_filter, Finset.mem_filter, Finset.mem_univ, true_and,
          Set.mem_setOf_eq] at hh ⊢
        refine ⟨⟨h, hh.1, by group⟩, ?_⟩
        simp [Equiv.Perm.mul_apply, hh.2]
      · intro σ _
        group
      · intro h _
        group
    have hsplit := Finset.card_filter_add_card_filter_not
      (s := Finset.univ.filter
        (fun σ : Equiv.Perm (Fin (k + 1)) => ∃ h ∈ H, π * σ * π⁻¹ = h * ρ))
      (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 = 0)
    have heq : (Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0)).filter
        (fun σ => ∃ h ∈ H, π * σ * π⁻¹ = h * ρ) =
        (Finset.univ.filter
          (fun σ : Equiv.Perm (Fin (k + 1)) => ∃ h ∈ H, π * σ * π⁻¹ = h * ρ)).filter
          (fun σ => ¬ σ 0 = 0) := by
      ext σ
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, ne_eq]
      tauto
    rw [heq]
    omega

  have hswap : ∑ σ ∈ Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0),
        Nat.card {π : Equiv.Perm (Fin (k + 1)) // ∃ h ∈ H, π * σ * π⁻¹ = h * ρ} =
      ∑ π : Equiv.Perm (Fin (k + 1)),
        ((Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0)).filter
          (fun σ => ∃ h ∈ H, π * σ * π⁻¹ = h * ρ)).card := by
    rw [Finset.sum_congr rfl (fun σ _ => by rw [Nat.card_eq_fintype_card, Fintype.card_subtype])]
    simp_rw [Finset.card_filter]
    exact Finset.sum_comm
  have htot : ∑ π : Equiv.Perm (Fin (k + 1)),
        ((Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0)).filter
          (fun σ => ∃ h ∈ H, π * σ * π⁻¹ = h * ρ)).card + (k + 1).factorial * c =
      (k + 1).factorial * N := by
    have h1 := Finset.sum_congr (s₁ := (Finset.univ : Finset (Equiv.Perm (Fin (k + 1)))))
      rfl (fun π _ => hper π)
    rw [Finset.sum_add_distrib, Finset.sum_const, Finset.sum_const, Finset.card_univ,
      Fintype.card_perm, Fintype.card_fin, smul_eq_mul, smul_eq_mul] at h1
    exact h1
  rw [hswap, hHN]
  rw [hNc] at htot ⊢
  rw [Nat.factorial_succ] at htot ⊢
  linarith

theorem lw_ev_transfer (F : Type u) [Field F] :
    (∀ P : MvPolynomial (Fin 2) F, lwtrGenEv F P =
      Polynomial.map (algebraMap (Polynomial F) (lwtrGenField F))
        (MvPolynomial.aeval (R := F)
          (![Polynomial.C Polynomial.X, Polynomial.X] : Fin 2 → Polynomial (Polynomial F)) P)) ∧
    Function.Bijective (MvPolynomial.aeval (R := F)
      (![Polynomial.C Polynomial.X, Polynomial.X] : Fin 2 → Polynomial (Polynomial F))) ∧
    Function.Injective (lwtrGenEv F) ∧
    (∀ P : MvPolynomial (Fin 2) F, Irreducible (MvPolynomial.aeval (R := F)
        (![Polynomial.C Polynomial.X, Polynomial.X] : Fin 2 → Polynomial (Polynomial F)) P) ↔
      Irreducible P) ∧
    (∀ Q : Polynomial (Polynomial F), Q.Monic →
      Irreducible (Polynomial.map (algebraMap (Polynomial F) (RatFunc F)) Q) →
      ∃ P : MvPolynomial (Fin 2) F, Irreducible P ∧
        lwtrGenEv F P = Polynomial.map (algebraMap (Polynomial F) (lwtrGenField F)) Q) :=
by
  classical
  obtain ⟨φ, hφd⟩ : ∃ φ : MvPolynomial (Fin 2) F →ₐ[F] Polynomial (Polynomial F),
      φ = MvPolynomial.aeval (R := F)
        (![Polynomial.C Polynomial.X, Polynomial.X] : Fin 2 → Polynomial (Polynomial F)) :=
    ⟨_, rfl⟩

  have hA : ∀ P : MvPolynomial (Fin 2) F, lwtrGenEv F P =
      Polynomial.map (algebraMap (Polynomial F) (lwtrGenField F)) (φ P) := by
    intro P
    rw [hφd]
    induction P using MvPolynomial.induction_on with
    | C a =>
      simp only [MvPolynomial.aeval_C, Polynomial.algebraMap_apply, Polynomial.map_C]
      rw [IsScalarTower.algebraMap_apply F (Polynomial F) (lwtrGenField F)]
      rfl
    | add p q hp hq => rw [map_add, map_add, hp, hq, Polynomial.map_add]
    | mul_X p i hp =>
      rw [map_mul, map_mul, hp, Polynomial.map_mul]
      congr 1
      fin_cases i
      · simp only [MvPolynomial.aeval_X]
        simp [Polynomial.map_C]
        rw [IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) (lwtrGenField F),
          RatFunc.algebraMap_X]
      · simp [MvPolynomial.aeval_X]

  have hB : Function.Bijective φ := by
    let inner : Polynomial F →+* MvPolynomial (Fin 2) F :=
      Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)
    let ψ : Polynomial (Polynomial F) →+* MvPolynomial (Fin 2) F :=
      Polynomial.eval₂RingHom inner (MvPolynomial.X 1)
    have h1 : ψ.comp φ.toRingHom = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp [ψ, inner, hφd, Polynomial.algebraMap_apply]
      · intro i
        fin_cases i <;> simp [ψ, inner, hφd]
    have h2inner : φ.toRingHom.comp inner = Polynomial.C := by
      apply Polynomial.ringHom_ext
      · intro b
        simp [inner, hφd, Polynomial.algebraMap_apply]
      · simp [inner, hφd]
    have h2 : φ.toRingHom.comp ψ = RingHom.id _ := by
      apply Polynomial.ringHom_ext
      · intro a
        have := congrArg (fun f => f a) h2inner
        simpa [ψ] using this
      · simp [ψ, hφd]
    refine ⟨fun p q hpq => ?_, fun Q => ⟨ψ Q, ?_⟩⟩
    · have hp := congrArg (fun f => f p) h1
      have hq := congrArg (fun f => f q) h1
      simp only [RingHom.comp_apply, RingHom.id_apply, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe] at hp hq
      rw [← hp, ← hq, hpq]
    · have := congrArg (fun f => f Q) h2
      simpa using this

  have hscal : algebraMap (Polynomial F) (lwtrGenField F) =
      (algebraMap (RatFunc F) (lwtrGenField F)).comp (algebraMap (Polynomial F) (RatFunc F)) :=
    IsScalarTower.algebraMap_eq _ _ _
  have hι : Function.Injective (algebraMap (Polynomial F) (lwtrGenField F)) := by
    rw [hscal, RingHom.coe_comp]
    exact (algebraMap (RatFunc F) (lwtrGenField F)).injective.comp (RatFunc.algebraMap_injective F)

  have hC : Function.Injective (lwtrGenEv F) := by
    intro p q hpq
    rw [hA p, hA q] at hpq
    exact hB.1 (Polynomial.map_injective _ hι hpq)

  have hD : ∀ P : MvPolynomial (Fin 2) F, Irreducible (φ P) ↔ Irreducible P := by
    intro P
    have := MulEquiv.irreducible_iff (AlgEquiv.ofBijective φ hB) (x := P)
    rw [AlgEquiv.ofBijective_apply] at this
    exact this

  have hE : ∀ Q : Polynomial (Polynomial F), Q.Monic →
      Irreducible (Polynomial.map (algebraMap (Polynomial F) (RatFunc F)) Q) →
      ∃ P : MvPolynomial (Fin 2) F, Irreducible P ∧
        lwtrGenEv F P = Polynomial.map (algebraMap (Polynomial F) (lwtrGenField F)) Q := by
    intro Q hQm hQirr
    have hQ : Irreducible Q :=
      (hQm.irreducible_iff_irreducible_map_fraction_map (K := RatFunc F)).mpr hQirr
    obtain ⟨P, hφP⟩ := hB.2 Q
    refine ⟨P, (hD P).mp (by rw [hφP]; exact hQ), ?_⟩
    rw [hA P, hφP]
  subst hφd
  exact ⟨hA, hB, hC, hD, hE⟩

theorem lw_generic_roots (K : Type u) [Field K] (k : ℕ) (g : MvPolynomial (Fin 2) K)
    (hdeg : g.totalDegree = k + 1) (hmon : g.coeff (Finsupp.single 1 (k + 1)) = 1)
    (hsep : MvPolynomial.pderiv 1 g ≠ 0)
    (hirr : Irreducible (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g)) :
    ∃ (G : Polynomial (Polynomial (AlgebraicClosure K)))
      (x : Fin (k + 1) → lwtrGenField (AlgebraicClosure K)),
      G.Monic ∧
      Irreducible (Polynomial.map
        (algebraMap (Polynomial (AlgebraicClosure K)) (RatFunc (AlgebraicClosure K))) G) ∧
      Polynomial.map (algebraMap (Polynomial (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))) G =
        lwtrGenEv (AlgebraicClosure K) (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g) ∧
      Function.Injective x ∧
      (∀ i, IsIntegral (Polynomial (AlgebraicClosure K)) (x i)) ∧
      lwtrGenEv (AlgebraicClosure K) (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g) =
        ∏ i, (Polynomial.X - Polynomial.C (x i)) :=
by
  classical
  obtain ⟨φ, hφ⟩ : ∃ φ : MvPolynomial (Fin 2) (AlgebraicClosure K) →ₐ[AlgebraicClosure K]
      Polynomial (Polynomial (AlgebraicClosure K)),
      φ = MvPolynomial.aeval (R := AlgebraicClosure K)
        (![Polynomial.C Polynomial.X, Polynomial.X] :
          Fin 2 → Polynomial (Polynomial (AlgebraicClosure K))) :=
    ⟨_, rfl⟩

  have hA : ∀ P : MvPolynomial (Fin 2) (AlgebraicClosure K), lwtrGenEv (AlgebraicClosure K) P =
      Polynomial.map (algebraMap (Polynomial (AlgebraicClosure K))
        (lwtrGenField (AlgebraicClosure K))) (φ P) := by
    intro P
    rw [hφ]
    induction P using MvPolynomial.induction_on with
    | C a =>
      simp only [MvPolynomial.aeval_C, Polynomial.algebraMap_apply, Polynomial.map_C]
      rw [IsScalarTower.algebraMap_apply (AlgebraicClosure K) (Polynomial (AlgebraicClosure K))
        (lwtrGenField (AlgebraicClosure K))]
      rfl
    | add p q hp hq => rw [map_add, map_add, hp, hq, Polynomial.map_add]
    | mul_X p i hp =>
      rw [map_mul, map_mul, hp, Polynomial.map_mul]
      congr 1
      fin_cases i
      · simp only [MvPolynomial.aeval_X]
        simp [Polynomial.map_C]
        rw [IsScalarTower.algebraMap_apply (Polynomial (AlgebraicClosure K))
          (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)),
          RatFunc.algebraMap_X]
      · simp [MvPolynomial.aeval_X]

  have hB : Function.Bijective φ := by
    let inner : Polynomial (AlgebraicClosure K) →+* MvPolynomial (Fin 2) (AlgebraicClosure K) :=
      Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)
    let ψ : Polynomial (Polynomial (AlgebraicClosure K)) →+*
        MvPolynomial (Fin 2) (AlgebraicClosure K) :=
      Polynomial.eval₂RingHom inner (MvPolynomial.X 1)
    have h1 : ψ.comp φ.toRingHom = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp [ψ, inner, hφ, Polynomial.algebraMap_apply]
      · intro i
        fin_cases i <;> simp [ψ, inner, hφ]
    have h2inner : φ.toRingHom.comp inner = Polynomial.C := by
      apply Polynomial.ringHom_ext
      · intro b
        simp [inner, hφ, Polynomial.algebraMap_apply]
      · simp [inner, hφ]
    have h2 : φ.toRingHom.comp ψ = RingHom.id _ := by
      apply Polynomial.ringHom_ext
      · intro a
        have := congrArg (fun f => f a) h2inner
        simpa [ψ] using this
      · simp [ψ, hφ]
    refine ⟨fun p q hpq => ?_, fun Q => ⟨ψ Q, ?_⟩⟩
    · have hp := congrArg (fun f => f p) h1
      have hq := congrArg (fun f => f q) h1
      simp only [RingHom.comp_apply, RingHom.id_apply, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe] at hp hq
      rw [← hp, ← hq, hpq]
    · have := congrArg (fun f => f Q) h2
      simpa using this

  have hD : ∀ P : MvPolynomial (Fin 2) (AlgebraicClosure K), Irreducible (φ P) ↔ Irreducible P := by
    intro P
    have := MulEquiv.irreducible_iff (AlgEquiv.ofBijective φ hB) (x := P)
    rw [AlgEquiv.ofBijective_apply] at this
    exact this
  set g' := MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g with hg'

  have hsupp : ∀ s ∈ g'.support, s 0 + s 1 ≤ k + 1 := by
    intro s hs
    have := MvPolynomial.le_totalDegree (MvPolynomial.support_map_subset _ _ hs)
    rw [hdeg, Finsupp.sum_fintype _ _ (by simp), Fin.sum_univ_two] at this
    exact this
  have hmon' : g'.coeff (Finsupp.single 1 (k + 1)) = 1 := by
    rw [hg', MvPolynomial.coeff_map, hmon, map_one]
  have hexp : φ g' = ∑ s ∈ g'.support,
      Polynomial.C (Polynomial.C (g'.coeff s) * Polynomial.X ^ (s 0)) * Polynomial.X ^ (s 1) := by
    rw [hφ]
    conv_lhs => rw [g'.as_sum]
    rw [map_sum]
    refine Finset.sum_congr rfl fun s _ => ?_
    rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (by simp), Fin.prod_univ_two]
    simp [Polynomial.algebraMap_apply, Polynomial.C_mul, Polynomial.C_pow]
    ring
  have hle : (φ g').natDegree ≤ k + 1 := by
    rw [hexp]
    apply Polynomial.natDegree_sum_le_of_forall_le
    intro s hs
    refine (Polynomial.natDegree_C_mul_X_pow_le _ _).trans ?_
    have := hsupp s hs
    omega
  have hcoeff : (φ g').coeff (k + 1) = 1 := by
    rw [hexp, Polynomial.finset_sum_coeff]
    simp only [Polynomial.coeff_C_mul_X_pow]
    rw [Finset.sum_eq_single (Finsupp.single 1 (k + 1))]
    · rw [hmon']
      simp
    · intro s hs hne
      rw [if_neg]
      intro h
      apply hne
      have := hsupp s hs
      ext i
      fin_cases i <;> simp [Finsupp.single_apply] <;> omega
    · intro h
      exfalso
      apply h
      rw [MvPolynomial.mem_support_iff, hmon']
      exact one_ne_zero
  have hGm : (φ g').Monic := Polynomial.monic_of_natDegree_le_of_coeff_eq_one _ hle hcoeff
  have hGd : (φ g').natDegree = k + 1 :=
    Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hle (by rw [hcoeff]; exact one_ne_zero)

  have hGirr : Irreducible (φ g') := (hD g').mpr hirr
  have hGLirr : Irreducible (Polynomial.map
      (algebraMap (Polynomial (AlgebraicClosure K)) (RatFunc (AlgebraicClosure K))) (φ g')) :=
    (Polynomial.Monic.irreducible_iff_irreducible_map_fraction_map
      (K := RatFunc (AlgebraicClosure K)) hGm).mp hGirr

  have hder : ∀ P : MvPolynomial (Fin 2) (AlgebraicClosure K),
      Polynomial.derivative (φ P) = φ (MvPolynomial.pderiv 1 P) := by
    intro P
    induction P using MvPolynomial.induction_on with
    | C a =>
      simp [hφ, Polynomial.algebraMap_apply]
    | add p q hp hq =>
      simp only [map_add, hp, hq]
    | mul_X p n hp =>
      have hXn : Polynomial.derivative (φ (MvPolynomial.X n)) =
          φ (MvPolynomial.pderiv 1 (MvPolynomial.X n)) := by
        fin_cases n <;> simp [hφ, MvPolynomial.pderiv_X, Pi.single_apply]
      rw [map_mul, Polynomial.derivative_mul, hp, hXn, Derivation.leibniz, smul_eq_mul,
        smul_eq_mul, map_add, map_mul, map_mul]
      ring
  have hpd : MvPolynomial.pderiv 1 g' ≠ 0 := by
    rw [hg', MvPolynomial.pderiv_map]
    intro h
    apply hsep
    apply MvPolynomial.map_injective _ (algebraMap K (AlgebraicClosure K)).injective
    rw [h, map_zero]
  have hdG : Polynomial.derivative (φ g') ≠ 0 := by
    rw [hder]
    intro h
    apply hpd
    apply hB.1
    rw [h, map_zero]
  have hGLsep : (Polynomial.map
      (algebraMap (Polynomial (AlgebraicClosure K)) (RatFunc (AlgebraicClosure K))) (φ g')).Separable := by
    rw [Polynomial.separable_iff_derivative_ne_zero hGLirr, Polynomial.derivative_map]
    intro h
    apply hdG
    apply Polynomial.map_injective _ (RatFunc.algebraMap_injective (AlgebraicClosure K))
    rw [h, Polynomial.map_zero]
  set GM := Polynomial.map
    (algebraMap (Polynomial (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K))) (φ g') with hGM
  have hGMsep : GM.Separable := by
    have : GM = Polynomial.map
        (algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)))
        (Polynomial.map
          (algebraMap (Polynomial (AlgebraicClosure K)) (RatFunc (AlgebraicClosure K))) (φ g')) := by
      rw [hGM, Polynomial.map_map, ← IsScalarTower.algebraMap_eq]
    rw [this]
    exact hGLsep.map
  have hGMm : GM.Monic := hGm.map _
  have hGMd : GM.natDegree = k + 1 := by rw [hGM, hGm.natDegree_map, hGd]

  have hroots : GM.roots.card = k + 1 := by
    rw [← hGMd]
    exact Polynomial.splits_iff_card_roots.mp (IsAlgClosed.splits GM)
  set l := GM.roots.toList with hl
  have hlen : l.length = k + 1 := by rw [hl, Multiset.length_toList, hroots]
  let y : Fin (k + 1) → lwtrGenField (AlgebraicClosure K) := fun i => l.get (Fin.cast hlen.symm i)
  have hfy : GM = ∏ i, (Polynomial.X - Polynomial.C (y i)) := by
    have h1 : ∏ i, (Polynomial.X - Polynomial.C (y i)) =
        ∏ j : Fin l.length, (Polynomial.X - Polynomial.C (l.get j)) :=
      Fintype.prod_equiv (finCongr hlen.symm) _ _ (fun i => rfl)
    rw [h1, ← List.prod_ofFn]
    have h2 : List.ofFn (fun j : Fin l.length => Polynomial.X - Polynomial.C (l.get j)) =
        l.map (fun a => Polynomial.X - Polynomial.C a) := by
      apply List.ext_get <;> simp
    rw [h2, ← Multiset.prod_coe, ← Multiset.map_coe, hl, Multiset.coe_toList]
    exact (Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hGMm
      (by rw [hroots, hGMd])).symm
  have hinj : Function.Injective y := by
    rw [hfy] at hGMsep
    exact Polynomial.separable_prod_X_sub_C_iff.mp hGMsep
  refine ⟨φ g', y, hGm, hGLirr, (hA g').symm, hinj, fun i => ⟨φ g', hGm, ?_⟩, (hA g').trans hfy⟩
  rw [← Polynomial.eval_map]
  change Polynomial.eval (y i) GM = 0
  rw [hfy, Polynomial.eval_prod]
  exact Finset.prod_eq_zero (Finset.mem_univ i) (by simp)

theorem lw_frobenius_lift (F : Type u) [Field F] (σF : F ≃+* F) :
    ∃ (ΦL : RatFunc F ≃+* RatFunc F) (Φ : lwtrGenField F ≃+* lwtrGenField F),
      (∀ l : RatFunc F, Φ (algebraMap (RatFunc F) (lwtrGenField F) l) =
        algebraMap (RatFunc F) (lwtrGenField F) (ΦL l)) ∧
      (∀ a : F, Φ (algebraMap F (lwtrGenField F) a) = algebraMap F (lwtrGenField F) (σF a)) ∧
      ∀ P : MvPolynomial (Fin 2) F,
        Polynomial.map (Φ : lwtrGenField F →+* lwtrGenField F) (lwtrGenEv F P) =
          lwtrGenEv F (MvPolynomial.map σF.toRingHom P) :=
by
  classical
  set eA : Polynomial F ≃+* Polynomial F := Polynomial.mapEquiv σF with heA
  set ΦL : RatFunc F ≃+* RatFunc F :=
    IsFractionRing.ringEquivOfRingEquiv (A := Polynomial F) (B := Polynomial F)
      (K := RatFunc F) (L := RatFunc F) eA with hΦLdef
  set Φ : lwtrGenField F ≃+* lwtrGenField F :=
    IsAlgClosure.equivOfEquiv (lwtrGenField F) (lwtrGenField F) ΦL with hΦdef
  have h1 : ∀ l : RatFunc F, Φ (algebraMap (RatFunc F) (lwtrGenField F) l) =
      algebraMap (RatFunc F) (lwtrGenField F) (ΦL l) := fun l =>
    IsAlgClosure.equivOfEquiv_algebraMap (lwtrGenField F) (lwtrGenField F) ΦL l
  have hL : ∀ f : Polynomial F, ΦL (algebraMap (Polynomial F) (RatFunc F) f) =
      algebraMap (Polynomial F) (RatFunc F) (Polynomial.map (σF : F →+* F) f) := by
    intro f
    rw [hΦLdef, IsFractionRing.ringEquivOfRingEquiv_algebraMap, heA, Polynomial.mapEquiv_apply]
  have hH : ∀ f : Polynomial F, Φ (algebraMap (RatFunc F) (lwtrGenField F)
      (algebraMap (Polynomial F) (RatFunc F) f)) =
      algebraMap (RatFunc F) (lwtrGenField F)
        (algebraMap (Polynomial F) (RatFunc F) (Polynomial.map (σF : F →+* F) f)) := by
    intro f
    rw [h1, hL]
  have hFM : ∀ b : F, algebraMap F (lwtrGenField F) b =
      algebraMap (RatFunc F) (lwtrGenField F)
        (algebraMap (Polynomial F) (RatFunc F) (Polynomial.C b)) := by
    intro b
    rw [IsScalarTower.algebraMap_apply F (RatFunc F) (lwtrGenField F), RatFunc.algebraMap_C,
      RatFunc.algebraMap_eq_C]
  have h2 : ∀ a : F, Φ (algebraMap F (lwtrGenField F) a) =
      algebraMap F (lwtrGenField F) (σF a) := by
    intro a
    rw [hFM a, hH, Polynomial.map_C, hFM (σF a)]
    rfl
  have hU : Φ (algebraMap (RatFunc F) (lwtrGenField F) RatFunc.X) =
      algebraMap (RatFunc F) (lwtrGenField F) RatFunc.X := by
    rw [← RatFunc.algebraMap_X, hH, Polynomial.map_X]
  refine ⟨ΦL, Φ, h1, h2, ?_⟩
  intro P
  induction P using MvPolynomial.induction_on with
  | C a =>
    rw [MvPolynomial.map_C, MvPolynomial.aeval_C, MvPolynomial.aeval_C,
      Polynomial.algebraMap_apply, Polynomial.algebraMap_apply, Polynomial.map_C]
    congr 1
    exact h2 a
  | add p q hp hq =>
    rw [map_add, Polynomial.map_add, hp, hq, map_add, map_add]
  | mul_X p n hp =>
    rw [map_mul, Polynomial.map_mul, hp, map_mul, map_mul, MvPolynomial.map_X]
    congr 1
    rw [MvPolynomial.aeval_X]
    fin_cases n
    · simp only [Fin.zero_eta, Fin.isValue, Matrix.cons_val_zero, Polynomial.map_C]
      congr 1
    · simp

theorem lw_galois_perm_data (L : Type*) (M : Type*) [Field L] [Field M] [Algebra L M] [Normal L M]
    (m : ℕ) (G : Polynomial L) (hGm : G.Monic) (hGi : Irreducible G) (x : Fin m → M)
    (hx : Function.Injective x)
    (hGx : Polynomial.map (algebraMap L M) G = ∏ i, (Polynomial.X - Polynomial.C (x i)))
    (ΦL : L ≃+* L) (Φ : M ≃+* M) (hΦL : ∀ l : L, Φ (algebraMap L M l) = algebraMap L M (ΦL l))
    (hΦG : Polynomial.map (Φ : M →+* M) (Polynomial.map (algebraMap L M) G) =
      Polynomial.map (algebraMap L M) G) :
    ∃ (H : Subgroup (Equiv.Perm (Fin m))) (ρ : Equiv.Perm (Fin m)),
      (∀ i j : Fin m, ∃ h ∈ H, h i = j) ∧ (∀ i, Φ (x i) = x (ρ i)) ∧
      (∀ h, ρ * h * ρ⁻¹ ∈ H ↔ h ∈ H) ∧
      (∀ τ : M ≃ₐ[L] M, ∃ h ∈ H, ∀ i, τ (x i) = x (h i)) ∧
      (∀ h ∈ H, ∃ τ : M ≃ₐ[L] M, ∀ i, τ (x i) = x (h i)) :=
by
  classical
  have pinv1 : ∀ (p : Equiv.Perm (Fin m)) (i : Fin m), p⁻¹ (p i) = i := fun p i => by simp
  have pinv2 : ∀ (p : Equiv.Perm (Fin m)) (i : Fin m), p (p⁻¹ i) = i := fun p i => by simp

  have hroot : ∀ k : Fin m,
      Polynomial.eval (x k) (∏ i, (Polynomial.X - Polynomial.C (x i))) = 0 := by
    intro k
    rw [Polynomial.eval_prod]
    exact Finset.prod_eq_zero (Finset.mem_univ k) (by simp)

  have hperm : ∀ ψ : M ≃+* M,
      Polynomial.map (ψ : M →+* M) (∏ i, (Polynomial.X - Polynomial.C (x i))) =
        ∏ i, (Polynomial.X - Polynomial.C (x i)) →
      ∃ σ : Equiv.Perm (Fin m), ∀ i, ψ (x i) = x (σ i) := by
    intro ψ hψ
    have hex : ∀ i, ∃ j, ψ (x i) = x j := by
      intro i
      have h0 : Polynomial.eval (ψ (x i)) (∏ j, (Polynomial.X - Polynomial.C (x j))) = 0 := by
        calc Polynomial.eval (ψ (x i)) (∏ j, (Polynomial.X - Polynomial.C (x j)))
            = Polynomial.eval (ψ (x i)) (Polynomial.map (ψ : M →+* M)
                (∏ j, (Polynomial.X - Polynomial.C (x j)))) := by rw [hψ]
          _ = ψ (Polynomial.eval (x i) (∏ j, (Polynomial.X - Polynomial.C (x j)))) := by
              rw [Polynomial.eval_map]
              exact Polynomial.eval₂_at_apply (ψ : M →+* M) (x i)
          _ = 0 := by rw [hroot i, map_zero]
      rw [Polynomial.eval_prod, Finset.prod_eq_zero_iff] at h0
      obtain ⟨j, -, hj⟩ := h0
      refine ⟨j, ?_⟩
      simpa [sub_eq_zero] using hj
    choose f hf using hex
    have hinj : Function.Injective f := by
      intro a b hab
      apply hx
      apply ψ.injective
      rw [hf a, hf b, hab]
    refine ⟨Equiv.ofBijective f (Finite.injective_iff_bijective.mp hinj), fun i => ?_⟩
    rw [Equiv.ofBijective_apply]
    exact hf i

  have hL : ∀ τ : M ≃ₐ[L] M,
      Polynomial.map ((τ : M ≃+* M) : M →+* M) (∏ i, (Polynomial.X - Polynomial.C (x i))) =
        ∏ i, (Polynomial.X - Polynomial.C (x i)) := by
    intro τ
    rw [← hGx, Polynomial.map_map]
    congr 1
    ext l
    exact τ.commutes l

  let H : Subgroup (Equiv.Perm (Fin m)) :=
    { carrier := {h | ∃ τ : M ≃ₐ[L] M, ∀ i, τ (x i) = x (h i)}
      one_mem' := ⟨1, fun i => rfl⟩
      mul_mem' := by
        rintro a b ⟨τa, ha⟩ ⟨τb, hb⟩
        refine ⟨τa * τb, fun i => ?_⟩
        rw [AlgEquiv.mul_apply, hb, ha, Equiv.Perm.mul_apply]
      inv_mem' := by
        rintro a ⟨τ, ha⟩
        refine ⟨τ⁻¹, fun i => ?_⟩
        apply τ.injective
        rw [AlgEquiv.aut_inv, AlgEquiv.apply_symm_apply, ha, pinv2] }
  have hmem : ∀ h, h ∈ H ↔ ∃ τ : M ≃ₐ[L] M, ∀ i, τ (x i) = x (h i) := fun h => Iff.rfl
  have hG1 : ∀ τ : M ≃ₐ[L] M, ∃ h ∈ H, ∀ i, τ (x i) = x (h i) := by
    intro τ
    obtain ⟨σ, hσ⟩ := hperm (τ : M ≃+* M) (hL τ)
    exact ⟨σ, (hmem σ).2 ⟨τ, fun i => hσ i⟩, fun i => hσ i⟩

  have hmin : ∀ k, minpoly L (x k) = G := by
    intro k
    refine (minpoly.eq_of_irreducible_of_monic hGi ?_ hGm).symm
    rw [← Polynomial.eval_map_algebraMap, hGx]
    exact hroot k
  have hT : ∀ i j : Fin m, ∃ h ∈ H, h i = j := by
    intro i j
    have hor : x j ∈ MulAction.orbit (M ≃ₐ[L] M) (x i) :=
      (Normal.minpoly_eq_iff_mem_orbit M).mp (by rw [hmin, hmin])
    obtain ⟨τ, hτ⟩ := MulAction.mem_orbit_iff.mp hor
    rw [AlgEquiv.smul_def] at hτ
    obtain ⟨h, hH, hh⟩ := hG1 τ
    refine ⟨h, hH, hx ?_⟩
    rw [← hh, hτ]

  obtain ⟨ρ, hρ⟩ := hperm Φ (by rw [← hGx]; exact hΦG)
  have hρinv : ∀ i, Φ.symm (x i) = x (ρ⁻¹ i) := by
    intro i
    apply Φ.injective
    rw [RingEquiv.apply_symm_apply, hρ, pinv2]
  have hΦLs : ∀ l : L, Φ.symm (algebraMap L M l) = algebraMap L M (ΦL.symm l) := by
    intro l
    apply Φ.injective
    rw [RingEquiv.apply_symm_apply, hΦL, RingEquiv.apply_symm_apply]
  have hC : ∀ h, ρ * h * ρ⁻¹ ∈ H ↔ h ∈ H := by
    intro h
    constructor
    · intro hin
      obtain ⟨τ, hτ⟩ := (hmem _).1 hin
      have hc : ∀ l : L, (Φ.trans ((τ : M ≃+* M).trans Φ.symm)) (algebraMap L M l) =
          algebraMap L M l := by
        intro l
        rw [RingEquiv.trans_apply, RingEquiv.trans_apply, hΦL]
        rw [AlgEquiv.coe_ringEquiv, AlgEquiv.commutes, hΦLs, RingEquiv.symm_apply_apply]
      refine (hmem h).2 ⟨AlgEquiv.ofRingEquiv (f := Φ.trans ((τ : M ≃+* M).trans Φ.symm)) hc,
        fun i => ?_⟩
      rw [AlgEquiv.ofRingEquiv_apply, RingEquiv.trans_apply, RingEquiv.trans_apply,
        AlgEquiv.coe_ringEquiv, hρ, hτ, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply,
        pinv1, ← hρ, RingEquiv.symm_apply_apply]
    · intro hin
      obtain ⟨τ, hτ⟩ := (hmem _).1 hin
      have hc : ∀ l : L, (Φ.symm.trans ((τ : M ≃+* M).trans Φ)) (algebraMap L M l) =
          algebraMap L M l := by
        intro l
        rw [RingEquiv.trans_apply, RingEquiv.trans_apply, hΦLs]
        rw [AlgEquiv.coe_ringEquiv, AlgEquiv.commutes, hΦL, RingEquiv.apply_symm_apply]
      refine (hmem _).2 ⟨AlgEquiv.ofRingEquiv (f := Φ.symm.trans ((τ : M ≃+* M).trans Φ)) hc,
        fun i => ?_⟩
      rw [AlgEquiv.ofRingEquiv_apply, RingEquiv.trans_apply, RingEquiv.trans_apply,
        AlgEquiv.coe_ringEquiv, hρinv, hτ, hρ, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply]
  refine ⟨H, ρ, hT, hρ, hC, hG1, fun h hh => (hmem h).1 hh⟩

theorem lw_generic_galois_setup (K : Type u) [Field K] [Fintype K] (k : ℕ)
    (g : MvPolynomial (Fin 2) K) (hdeg : g.totalDegree = k + 1)
    (hmon : g.coeff (Finsupp.single 1 (k + 1)) = 1) (hsep : MvPolynomial.pderiv 1 g ≠ 0)
    (hirr : Irreducible (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g)) :
    ∃ (x : Fin (k + 1) → lwtrGenField (AlgebraicClosure K))
      (H : Subgroup (Equiv.Perm (Fin (k + 1)))) (ρ : Equiv.Perm (Fin (k + 1)))
      (Φ : lwtrGenField (AlgebraicClosure K) ≃+* lwtrGenField (AlgebraicClosure K)),
      Function.Injective (lwtrGenEv (AlgebraicClosure K)) ∧
      Function.Injective x ∧
      (∀ i, IsIntegral (Polynomial (AlgebraicClosure K)) (x i)) ∧
      lwtrGenEv (AlgebraicClosure K) (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g) =
        ∏ i, (Polynomial.X - Polynomial.C (x i)) ∧
      (∀ i j : Fin (k + 1), ∃ h ∈ H, h i = j) ∧
      (∀ h, ρ * h * ρ⁻¹ ∈ H ↔ h ∈ H) ∧
      (∀ τ : lwtrGenField (AlgebraicClosure K) ≃ₐ[RatFunc (AlgebraicClosure K)]
          lwtrGenField (AlgebraicClosure K), ∃ h ∈ H, ∀ i, τ (x i) = x (h i)) ∧
      (∀ h ∈ H, ∃ τ : lwtrGenField (AlgebraicClosure K) ≃ₐ[RatFunc (AlgebraicClosure K)]
          lwtrGenField (AlgebraicClosure K), ∀ i, τ (x i) = x (h i)) ∧
      (∀ i, Φ (x i) = x (ρ i)) ∧
      (∀ P : MvPolynomial (Fin 2) (AlgebraicClosure K),
        Polynomial.map (Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K))
            (lwtrGenEv (AlgebraicClosure K) P) =
          lwtrGenEv (AlgebraicClosure K) (MvPolynomial.map (lwtrFrob K) P)) ∧
      (∀ a : AlgebraicClosure K,
        Φ (algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) a) =
          algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (a ^ Nat.card K)) :=
by
  classical
  obtain ⟨G, x, hGm, hGi, hGev, hx, hxint, hxg⟩ := lw_generic_roots K k g hdeg hmon hsep hirr
  obtain ⟨ΦL, Φ, hΦL, hΦc, hΦev⟩ := lw_frobenius_lift (AlgebraicClosure K)
    (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K)).toRingEquiv
  have hev := (lw_ev_transfer (AlgebraicClosure K)).2.2.1
  have hGx : Polynomial.map
      (algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)))
      (Polynomial.map (algebraMap (Polynomial (AlgebraicClosure K)) (RatFunc (AlgebraicClosure K))) G) =
      ∏ i, (Polynomial.X - Polynomial.C (x i)) := by
    rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq (Polynomial (AlgebraicClosure K))
      (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)), hGev, hxg]
  have hcomp : ((FiniteField.frobeniusAlgEquivOfAlgebraic K
      (AlgebraicClosure K)).toRingEquiv.toRingHom).comp (algebraMap K (AlgebraicClosure K)) =
      algebraMap K (AlgebraicClosure K) := by
    ext a
    exact (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K)).commutes a
  have hΦG : Polynomial.map
      (Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K))
      (Polynomial.map (algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)))
        (Polynomial.map (algebraMap (Polynomial (AlgebraicClosure K))
          (RatFunc (AlgebraicClosure K))) G)) =
      Polynomial.map (algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)))
        (Polynomial.map (algebraMap (Polynomial (AlgebraicClosure K))
          (RatFunc (AlgebraicClosure K))) G) := by
    rw [hGx, ← hxg, hΦev, MvPolynomial.map_map, hcomp]
  obtain ⟨H, ρ, hHt, hΦx, hρ, hH1, hH2⟩ := lw_galois_perm_data (RatFunc (AlgebraicClosure K))
    (lwtrGenField (AlgebraicClosure K)) (k + 1) _ (hGm.map _) hGi x hx hGx ΦL Φ hΦL hΦG
  refine ⟨x, H, ρ, Φ, hev, hx, hxint, hxg, hHt, hρ, hH1, hH2, hΦx, hΦev, ?_⟩
  intro a
  rw [hΦc a, AlgEquiv.coe_ringEquiv, FiniteField.frobeniusAlgEquivOfAlgebraic_apply,
    Nat.card_eq_fintype_card]

theorem lw_twist_vector_exists (K : Type u) [Field K] [Fintype K] (m : ℕ) (σ : Equiv.Perm (Fin m))
    (E : Type u) [Field E] [Algebra (AlgebraicClosure K) E] (W : Finset (Fin m → E))
    (hW0 : ∀ w ∈ W, w ≠ 0) (hWq : W.card < Nat.card K) :
    ∃ c : Fin m → AlgebraicClosure K, (∀ i, c i ^ Nat.card K = c (σ i)) ∧
      ∀ w ∈ W, ∑ i, algebraMap (AlgebraicClosure K) E (c i) * w i ≠ 0 :=
by
  classical

  have tL1 : ∀ n : ℕ, n ≠ 0 → ∃ Ω : Finset (AlgebraicClosure K), Ω.card = Nat.card K ^ n ∧
      ∀ b ∈ Ω, b ^ (Nat.card K ^ n) = b := by
    intro n hn
    have h1q : 1 < Fintype.card K := Fintype.one_lt_card
    rw [Nat.card_eq_fintype_card]
    have hP0 : (Polynomial.X ^ (Fintype.card K ^ n) - Polynomial.X :
        Polynomial (AlgebraicClosure K)) ≠ 0 :=
      FiniteField.X_pow_card_pow_sub_X_ne_zero _ hn h1q
    have hdeg : (Polynomial.X ^ (Fintype.card K ^ n) - Polynomial.X :
        Polynomial (AlgebraicClosure K)).natDegree = Fintype.card K ^ n :=
      FiniteField.X_pow_card_pow_sub_X_natDegree_eq _ hn h1q
    have hchar : ((Fintype.card K ^ n : ℕ) : AlgebraicClosure K) = 0 := by
      rw [Nat.cast_pow]
      have : ((Fintype.card K : ℕ) : AlgebraicClosure K) = 0 := by
        rw [← map_natCast (algebraMap K (AlgebraicClosure K)), FiniteField.cast_card_eq_zero,
          map_zero]
      rw [this, zero_pow hn]
    haveI := ringChar.charP (AlgebraicClosure K)
    have hsep : (Polynomial.X ^ (Fintype.card K ^ n) - Polynomial.X :
        Polynomial (AlgebraicClosure K)).Separable :=
      galois_poly_separable (ringChar (AlgebraicClosure K)) (Fintype.card K ^ n) (ringChar.dvd hchar)
    refine ⟨(Polynomial.X ^ (Fintype.card K ^ n) - Polynomial.X :
        Polynomial (AlgebraicClosure K)).roots.toFinset, ?_, ?_⟩
    · rw [Multiset.toFinset_card_of_nodup (Polynomial.nodup_roots hsep),
        IsAlgClosed.card_roots_eq_natDegree, hdeg]
    · intro b hb
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hP0, Polynomial.IsRoot.def] at hb
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X] at hb
      exact sub_eq_zero.mp hb

  have tL2 : ∀ (q N : ℕ), 2 ≤ q → N ≠ 0 → ∀ (a : ℕ → E), a 0 ≠ 0 → ∀ (T : Finset E),
      q ^ (N - 1) < T.card → ∃ t ∈ T, ∑ j ∈ Finset.range N, t ^ (q ^ j) * a j ≠ 0 := by
    intro q N hq hN a ha T hT
    by_contra hcon
    push_neg at hcon
    have heval : ∀ t, (∑ j ∈ Finset.range N, Polynomial.C (a j) * Polynomial.X ^ (q ^ j)).eval t =
        ∑ j ∈ Finset.range N, t ^ (q ^ j) * a j := by
      intro t
      simp only [Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_C,
        Polynomial.eval_pow, Polynomial.eval_X]
      exact Finset.sum_congr rfl fun j _ => mul_comm _ _
    have hdeg : (∑ j ∈ Finset.range N, Polynomial.C (a j) * Polynomial.X ^ (q ^ j)).natDegree ≤
        q ^ (N - 1) := by
      apply Polynomial.natDegree_sum_le_of_forall_le
      intro j hj
      refine le_trans (Polynomial.natDegree_C_mul_X_pow_le _ _) ?_
      exact Nat.pow_le_pow_right (by omega) (by rw [Finset.mem_range] at hj; omega)
    have hcoeff : (∑ j ∈ Finset.range N, Polynomial.C (a j) * Polynomial.X ^ (q ^ j)).coeff 1 =
        a 0 := by
      rw [Polynomial.finsetSum_coeff]
      simp only [Polynomial.coeff_C_mul_X_pow]
      rw [Finset.sum_eq_single 0]
      · simp
      · intro j _ hj
        have : 1 < q ^ j := Nat.one_lt_pow hj (by omega)
        rw [if_neg (by omega)]
      · intro h; exact absurd (Finset.mem_range.mpr (Nat.pos_of_ne_zero hN)) h
    have hP0 := Polynomial.eq_zero_of_natDegree_lt_card_of_eval_eq_zero'
      (∑ j ∈ Finset.range N, Polynomial.C (a j) * Polynomial.X ^ (q ^ j)) T
      (fun t ht => by rw [heval]; exact hcon t ht) (lt_of_le_of_lt hdeg hT)
    apply ha
    rw [← hcoeff, hP0, Polynomial.coeff_zero]

  have tL3 : ∀ (N : ℕ), N ≠ 0 → σ ^ N = 1 → ∀ (i0 : Fin m) (b : AlgebraicClosure K),
      b ^ (Nat.card K ^ N) = b → ∀ (i : Fin m),
      (∑ j ∈ Finset.range N, if (σ ^ j) i0 = i then b ^ (Nat.card K ^ j) else 0) ^ Nat.card K =
        ∑ j ∈ Finset.range N, if (σ ^ j) i0 = σ i then b ^ (Nat.card K ^ j) else 0 := by
    intro N hN hσ i0 b hb i
    have hφ : ∀ x : AlgebraicClosure K,
        x ^ Nat.card K = FiniteField.frobeniusAlgHom K (AlgebraicClosure K) x := by
      intro x; rw [FiniteField.coe_frobeniusAlgHom, Nat.card_eq_fintype_card]
    rw [hφ, map_sum]
    have hterm : ∀ j : ℕ, FiniteField.frobeniusAlgHom K (AlgebraicClosure K)
        (if (σ ^ j) i0 = i then b ^ (Nat.card K ^ j) else 0) =
        if (σ ^ j) i0 = i then b ^ (Nat.card K ^ (j + 1)) else 0 := by
      intro j
      split_ifs
      · rw [← hφ, ← pow_mul, ← pow_succ]
      · exact map_zero _
    simp only [hterm]
    obtain ⟨N', rfl⟩ : ∃ N', N = N' + 1 := ⟨N - 1, by omega⟩
    rw [Finset.sum_range_succ, Finset.sum_range_succ']
    have hσ1 : ∀ x, σ ((σ ^ N') x) = x := fun x => by
      show (σ * σ ^ N') x = x
      rw [← pow_succ', hσ]; rfl
    have hσ2 : ∀ x, (σ ^ N') (σ x) = x := fun x => by
      show (σ ^ N' * σ) x = x
      rw [← pow_succ, hσ]; rfl
    congr 1
    · apply Finset.sum_congr rfl
      intro j _
      have : (σ ^ (j + 1)) i0 = σ ((σ ^ j) i0) := by
        show (σ ^ (j + 1)) i0 = (σ * σ ^ j) i0
        rw [← pow_succ']
      rw [this]
      exact if_congr (σ.injective.eq_iff).symm rfl rfl
    · rw [hb]
      simp only [pow_zero, pow_one, Equiv.Perm.one_apply]
      have key : (σ ^ N') i0 = i ↔ i0 = σ i := by
        constructor
        · rintro rfl; exact (hσ1 i0).symm
        · rintro rfl; exact hσ2 i
      exact if_congr key rfl rfl

  have tL3' : ∀ (N : ℕ) (i0 : Fin m) (b : AlgebraicClosure K) (r : ℕ → ℕ) (w : Fin m → E),
      ∑ i, algebraMap (AlgebraicClosure K) E
          (∑ j ∈ Finset.range N, if (σ ^ j) i0 = i then b ^ r j else 0) * w i =
        ∑ j ∈ Finset.range N, algebraMap (AlgebraicClosure K) E b ^ r j * w ((σ ^ j) i0) := by
    intro N i0 b r w
    simp only [map_sum, apply_ite (algebraMap (AlgebraicClosure K) E), map_zero, map_pow,
      Finset.sum_mul, ite_mul, zero_mul]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j _
    rw [Fintype.sum_ite_eq]
  have h1q : 1 < Nat.card K := by rw [Nat.card_eq_fintype_card]; exact Fintype.one_lt_card
  have hfrob : ∀ x : AlgebraicClosure K,
      x ^ Nat.card K = FiniteField.frobeniusAlgHom K (AlgebraicClosure K) x := by
    intro x; rw [FiniteField.coe_frobeniusAlgHom, Nat.card_eq_fintype_card]

  have sep : ∀ w : Fin m → E, w ≠ 0 → ∃ c' : Fin m → AlgebraicClosure K,
      (∀ i, c' i ^ Nat.card K = c' (σ i)) ∧
        ∑ i, algebraMap (AlgebraicClosure K) E (c' i) * w i ≠ 0 := by
    intro w hw
    obtain ⟨i0, hi0⟩ := Function.ne_iff.mp hw
    have hN : orderOf σ ≠ 0 := (orderOf_pos σ).ne'
    have hσ : σ ^ orderOf σ = 1 := pow_orderOf_eq_one σ
    obtain ⟨Ω, hΩc, hΩ⟩ := tL1 (orderOf σ) hN
    have hTc : (Ω.image (algebraMap (AlgebraicClosure K) E)).card = Nat.card K ^ orderOf σ := by
      rw [Finset.card_image_of_injective _ (algebraMap (AlgebraicClosure K) E).injective, hΩc]
    obtain ⟨t, ht, hne⟩ := tL2 (Nat.card K) (orderOf σ) (by omega) hN
      (fun j => w ((σ ^ j) i0)) (by simpa using hi0) (Ω.image (algebraMap (AlgebraicClosure K) E))
      (by rw [hTc]; exact Nat.pow_lt_pow_right h1q (by omega))
    obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp ht
    refine ⟨fun i => ∑ j ∈ Finset.range (orderOf σ),
      if (σ ^ j) i0 = i then b ^ (Nat.card K ^ j) else 0, ?_, ?_⟩
    · intro i; exact tL3 (orderOf σ) hN hσ i0 b (hΩ b hb) i
    · rw [tL3' (orderOf σ) i0 b (fun j => Nat.card K ^ j) w]; exact hne

  have step : ∀ (V : Finset (Fin m → E)) (w0 : Fin m → E), (insert w0 V).card < Nat.card K →
      ∀ c c' : Fin m → AlgebraicClosure K, (∀ i, c i ^ Nat.card K = c (σ i)) →
      (∀ i, c' i ^ Nat.card K = c' (σ i)) →
      (∀ w ∈ V, ∑ i, algebraMap (AlgebraicClosure K) E (c i) * w i ≠ 0) →
      ∑ i, algebraMap (AlgebraicClosure K) E (c' i) * w0 i ≠ 0 →
      ∃ c'' : Fin m → AlgebraicClosure K, (∀ i, c'' i ^ Nat.card K = c'' (σ i)) ∧
        ∀ w ∈ insert w0 V, ∑ i, algebraMap (AlgebraicClosure K) E (c'' i) * w i ≠ 0 := by
    intro V w0 hcard c c' hc hc' hcW hc'0
    have haff : ∀ (l : K) (w : Fin m → E),
        ∑ i, algebraMap (AlgebraicClosure K) E
            (c i + algebraMap K (AlgebraicClosure K) l * c' i) * w i =
          (∑ i, algebraMap (AlgebraicClosure K) E (c i) * w i) +
            algebraMap (AlgebraicClosure K) E (algebraMap K (AlgebraicClosure K) l) *
              ∑ i, algebraMap (AlgebraicClosure K) E (c' i) * w i := by
      intro l w
      simp only [map_add, map_mul, add_mul, Finset.sum_add_distrib, Finset.mul_sum, mul_assoc]
    have htw : ∀ (l : K) (i : Fin m),
        (c i + algebraMap K (AlgebraicClosure K) l * c' i) ^ Nat.card K =
          c (σ i) + algebraMap K (AlgebraicClosure K) l * c' (σ i) := by
      intro l i
      rw [hfrob, map_add, map_mul, AlgHom.commutes, ← hfrob, ← hfrob, hc, hc']
    have hZ : ∀ w ∈ insert w0 V, (Finset.univ.filter (fun l : K =>
        (∑ i, algebraMap (AlgebraicClosure K) E (c i) * w i) +
          algebraMap (AlgebraicClosure K) E (algebraMap K (AlgebraicClosure K) l) *
            ∑ i, algebraMap (AlgebraicClosure K) E (c' i) * w i = 0)).card ≤ 1 := by
      intro w hw
      rw [Finset.card_le_one]
      intro l1 hl1 l2 hl2
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hl1 hl2
      have hsub : (algebraMap (AlgebraicClosure K) E (algebraMap K (AlgebraicClosure K) l1) -
          algebraMap (AlgebraicClosure K) E (algebraMap K (AlgebraicClosure K) l2)) *
            ∑ i, algebraMap (AlgebraicClosure K) E (c' i) * w i = 0 := by
        linear_combination hl1 - hl2
      rcases mul_eq_zero.mp hsub with h | h
      · exact (algebraMap K (AlgebraicClosure K)).injective
          ((algebraMap (AlgebraicClosure K) E).injective (sub_eq_zero.mp h))
      · exfalso
        rcases Finset.mem_insert.mp hw with hw' | hwW
        · subst hw'; exact hc'0 h
        · apply hcW w hwW
          rw [h, mul_zero, add_zero] at hl1
          exact hl1
    have hBad : ((insert w0 V).biUnion (fun w => Finset.univ.filter (fun l : K =>
        (∑ i, algebraMap (AlgebraicClosure K) E (c i) * w i) +
          algebraMap (AlgebraicClosure K) E (algebraMap K (AlgebraicClosure K) l) *
            ∑ i, algebraMap (AlgebraicClosure K) E (c' i) * w i = 0))).card <
        (Finset.univ : Finset K).card := by
      calc _ ≤ ∑ w ∈ insert w0 V, (Finset.univ.filter (fun l : K =>
              (∑ i, algebraMap (AlgebraicClosure K) E (c i) * w i) +
                algebraMap (AlgebraicClosure K) E (algebraMap K (AlgebraicClosure K) l) *
                  ∑ i, algebraMap (AlgebraicClosure K) E (c' i) * w i = 0)).card :=
            Finset.card_biUnion_le
        _ ≤ ∑ w ∈ insert w0 V, 1 := Finset.sum_le_sum hZ
        _ = (insert w0 V).card := (Finset.card_eq_sum_ones _).symm
        _ < Nat.card K := hcard
        _ = (Finset.univ : Finset K).card := by rw [Finset.card_univ, Nat.card_eq_fintype_card]
    obtain ⟨l, -, hl⟩ := Finset.exists_mem_notMem_of_card_lt_card hBad
    refine ⟨fun i => c i + algebraMap K (AlgebraicClosure K) l * c' i, fun i => htw l i, ?_⟩
    intro w hw
    rw [haff]
    intro h0
    apply hl
    exact Finset.mem_biUnion.mpr ⟨w, hw, Finset.mem_filter.mpr ⟨Finset.mem_univ _, h0⟩⟩

  have main : ∀ V : Finset (Fin m → E), (∀ w ∈ V, w ≠ 0) → V.card < Nat.card K →
      ∃ c : Fin m → AlgebraicClosure K, (∀ i, c i ^ Nat.card K = c (σ i)) ∧
        ∀ w ∈ V, ∑ i, algebraMap (AlgebraicClosure K) E (c i) * w i ≠ 0 := by
    intro V
    induction V using Finset.induction_on with
    | empty =>
      intro _ _
      refine ⟨0, fun i => ?_, fun w hw => absurd hw (Finset.notMem_empty w)⟩
      simp only [Pi.zero_apply]
      exact zero_pow (by omega)
    | insert w0 V hw0 ih =>
      intro hV0 hcard
      obtain ⟨c, hc, hcW⟩ := ih (fun w hw => hV0 w (Finset.mem_insert_of_mem hw))
        (lt_of_le_of_lt (Finset.card_le_card (Finset.subset_insert _ _)) hcard)
      obtain ⟨c', hc', hc'0⟩ := sep w0 (hV0 w0 (Finset.mem_insert_self _ _))
      exact step V w0 hcard c c' hc hc' hcW hc'0
  exact main W hW0 hWq

theorem lw_twisted_resolvent_poly (K : Type u) [Field K] (k : ℕ) (g : MvPolynomial (Fin 2) K)
    (hdeg : g.totalDegree = k + 1) (hmon : g.coeff (Finsupp.single 1 (k + 1)) = 1)
    (c : Fin (k + 1) → AlgebraicClosure K) :
    ∃ (R : MvPolynomial (Fin 2) (AlgebraicClosure K)) (d : Polynomial (AlgebraicClosure K)),
      R.totalDegree ≤ (k + 1).factorial ∧ d.natDegree ≤ (k + 1).factorial ^ 2 ∧
      ∀ (E : Type u) [Field E] [Algebra (AlgebraicClosure K) E] [Algebra K E]
        [IsScalarTower K (AlgebraicClosure K) E] (e : E) (y : Fin (k + 1) → E),
        MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g =
            ∏ i, (Polynomial.X - Polynomial.C (y i)) →
          MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] R = ∏ π : Equiv.Perm (Fin (k + 1)),
              (Polynomial.X - Polynomial.C (∑ i, algebraMap (AlgebraicClosure K) E (c i) * y (π i))) ∧
            Polynomial.aeval e d =
              ∏ p ∈ (Finset.univ : Finset (Equiv.Perm (Fin (k + 1)))).offDiag,
                ((∑ i, algebraMap (AlgebraicClosure K) E (c i) * y (p.1 i)) -
                  ∑ i, algebraMap (AlgebraicClosure K) E (c i) * y (p.2 i)) :=
by
  classical

  have s3 : ∀ (j : ℕ) (Ψ : MvPolynomial (Fin (k + 1)) (AlgebraicClosure K)),
      Ψ.IsSymmetric → Ψ.totalDegree ≤ j →
      ∃ Q : MvPolynomial (Fin (k + 1)) (AlgebraicClosure K),
        (∀ a ∈ Q.support, (a.sum fun i n => ((i : ℕ) + 1) * n) ≤ j) ∧
        Ψ = MvPolynomial.aeval (fun t : Fin (k + 1) =>
          MvPolynomial.esymm (Fin (k + 1)) (AlgebraicClosure K) ((t : ℕ) + 1)) Q := by
    intro j Ψ hΨ hdeg
    have hesymm : ∀ n : ℕ,
        (MvPolynomial.esymm (Fin (k + 1)) (AlgebraicClosure K) n).IsHomogeneous n := by
      intro n
      unfold MvPolynomial.esymm
      apply MvPolynomial.IsHomogeneous.sum
      intro t ht
      have := MvPolynomial.IsHomogeneous.prod t
        (fun i => (MvPolynomial.X i : MvPolynomial (Fin (k + 1)) (AlgebraicClosure K)))
        (fun _ => 1) (fun i _ => MvPolynomial.isHomogeneous_X (AlgebraicClosure K) i)
      simpa [(Finset.mem_powersetCard.mp ht).2] using this
    have hmon : ∀ (a : Fin (k + 1) →₀ ℕ) (r : AlgebraicClosure K),
        (MvPolynomial.aeval (fun t : Fin (k + 1) =>
          MvPolynomial.esymm (Fin (k + 1)) (AlgebraicClosure K) ((t : ℕ) + 1))
          (MvPolynomial.monomial a r)).IsHomogeneous (a.sum fun i n => ((i : ℕ) + 1) * n) := by
      intro a r
      rw [MvPolynomial.aeval_monomial, MvPolynomial.algebraMap_eq]
      have h1 := MvPolynomial.IsHomogeneous.prod a.support
        (fun i => MvPolynomial.esymm (Fin (k + 1)) (AlgebraicClosure K) ((i : ℕ) + 1) ^ a i)
        (fun i => ((i : ℕ) + 1) * a i)
        (fun i _ => (hesymm _).pow _)
      have h2 := (MvPolynomial.isHomogeneous_C (Fin (k + 1)) r).mul h1
      simpa [Finsupp.prod, Finsupp.sum] using h2
    obtain ⟨Q₀, hQ₀⟩ := (MvPolynomial.esymmAlgHom_fin_bijective (AlgebraicClosure K) (k + 1)).2
      ⟨Ψ, (MvPolynomial.mem_symmetricSubalgebra Ψ).2 hΨ⟩
    have hΨQ₀ : Ψ = MvPolynomial.aeval (fun t : Fin (k + 1) =>
        MvPolynomial.esymm (Fin (k + 1)) (AlgebraicClosure K) ((t : ℕ) + 1)) Q₀ := by
      have := congrArg Subtype.val hQ₀
      rw [MvPolynomial.esymmAlgHom_apply] at this
      exact this.symm
    obtain ⟨Q, hQdef⟩ : ∃ Q : MvPolynomial (Fin (k + 1)) (AlgebraicClosure K),
        Q = ∑ a ∈ Q₀.support.filter (fun a => (a.sum fun i n => ((i : ℕ) + 1) * n) ≤ j),
          MvPolynomial.monomial a (Q₀.coeff a) := ⟨_, rfl⟩
    obtain ⟨T, hTdef⟩ : ∃ T : MvPolynomial (Fin (k + 1)) (AlgebraicClosure K),
        T = ∑ a ∈ Q₀.support.filter (fun a => ¬ (a.sum fun i n => ((i : ℕ) + 1) * n) ≤ j),
          MvPolynomial.monomial a (Q₀.coeff a) := ⟨_, rfl⟩
    have hsplit : Q₀ = Q + T := by
      rw [hQdef, hTdef]
      conv_lhs => rw [MvPolynomial.as_sum Q₀]
      exact (Finset.sum_filter_add_sum_filter_not _ _ _).symm
    refine ⟨Q, ?_, ?_⟩
    · intro a ha
      rw [hQdef] at ha
      have h1 := MvPolynomial.support_sum ha
      simp only [Finset.mem_biUnion] at h1
      obtain ⟨b, hb, hab⟩ := h1
      have h2 := MvPolynomial.support_monomial_subset hab
      rw [Finset.mem_singleton] at h2
      subst h2
      exact (Finset.mem_filter.mp hb).2
    · have hD : Ψ - MvPolynomial.aeval (fun t : Fin (k + 1) =>
            MvPolynomial.esymm (Fin (k + 1)) (AlgebraicClosure K) ((t : ℕ) + 1)) Q =
          MvPolynomial.aeval (fun t : Fin (k + 1) =>
            MvPolynomial.esymm (Fin (k + 1)) (AlgebraicClosure K) ((t : ℕ) + 1)) T := by
        rw [hΨQ₀, hsplit, map_add]; ring
      have hQdeg : (MvPolynomial.aeval (fun t : Fin (k + 1) =>
          MvPolynomial.esymm (Fin (k + 1)) (AlgebraicClosure K) ((t : ℕ) + 1)) Q).totalDegree ≤ j := by
        rw [hQdef, map_sum]
        apply MvPolynomial.totalDegree_finsetSum_le
        intro a ha
        exact ((hmon a _).totalDegree_le).trans (Finset.mem_filter.mp ha).2
      have hD0 : Ψ - MvPolynomial.aeval (fun t : Fin (k + 1) =>
          MvPolynomial.esymm (Fin (k + 1)) (AlgebraicClosure K) ((t : ℕ) + 1)) Q = 0 := by
        ext d
        rw [MvPolynomial.coeff_zero]
        by_cases hd : Finsupp.degree d ≤ j
        · rw [hD, hTdef, map_sum, MvPolynomial.coeff_sum]
          apply Finset.sum_eq_zero
          intro a ha
          apply (hmon a _).coeff_eq_zero
          have := (Finset.mem_filter.mp ha).2
          omega
        · push_neg at hd
          apply MvPolynomial.coeff_eq_zero_of_totalDegree_lt
          have h3 := MvPolynomial.totalDegree_sub Ψ
            (MvPolynomial.aeval (fun t : Fin (k + 1) =>
              MvPolynomial.esymm (Fin (k + 1)) (AlgebraicClosure K) ((t : ℕ) + 1)) Q)
          have h4 : max Ψ.totalDegree (MvPolynomial.aeval (fun t : Fin (k + 1) =>
            MvPolynomial.esymm (Fin (k + 1)) (AlgebraicClosure K) ((t : ℕ) + 1)) Q).totalDegree ≤ j :=
            max_le hdeg hQdeg
          exact lt_of_le_of_lt (h3.trans h4) hd
      exact sub_eq_zero.mp hD0

  obtain ⟨Θ, hΘdef⟩ : ∃ Θ : Equiv.Perm (Fin (k + 1)) →
      MvPolynomial (Fin (k + 1)) (AlgebraicClosure K),
      Θ = fun π => ∑ i, MvPolynomial.C (c i) * MvPolynomial.X (π i) := ⟨_, rfl⟩
  have hΘdeg : ∀ π, (Θ π).totalDegree ≤ 1 := by
    intro π
    rw [hΘdef]
    apply MvPolynomial.totalDegree_finsetSum_le
    intro i _
    refine (MvPolynomial.totalDegree_mul _ _).trans ?_
    rw [MvPolynomial.totalDegree_C, MvPolynomial.totalDegree_X]
  have hΘsym : ∀ (τ π : Equiv.Perm (Fin (k + 1))), MvPolynomial.rename τ (Θ π) = Θ (τ * π) := by
    intro τ π
    simp only [hΘdef, map_sum, map_mul, MvPolynomial.rename_C, MvPolynomial.rename_X,
      Equiv.Perm.mul_apply]

  have s1 : (∏ π, (Polynomial.X - Polynomial.C (Θ π))).natDegree ≤ (k + 1).factorial ∧
      ∀ j, ((∏ π, (Polynomial.X - Polynomial.C (Θ π))).coeff j).IsSymmetric ∧
        ((∏ π, (Polynomial.X - Polynomial.C (Θ π))).coeff j).totalDegree ≤
          (k + 1).factorial - j := by
    obtain ⟨U, hUdef⟩ : ∃ U, U = ∏ π, (Polynomial.X - Polynomial.C (Θ π)) := ⟨_, rfl⟩
    rw [← hUdef]
    have hUdeg : U.natDegree ≤ (k + 1).factorial := by
      rw [hUdef]
      refine (Polynomial.natDegree_prod_le _ _).trans ?_
      simp [Fintype.card_perm]
    refine ⟨hUdeg, fun j => ⟨?_, ?_⟩⟩
    · intro τ
      have hmap : Polynomial.map (MvPolynomial.rename τ).toRingHom U = U := by
        rw [hUdef, Polynomial.map_prod]
        simp only [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C,
          AlgHom.toRingHom_eq_coe, RingHom.coe_coe, hΘsym]
        exact Fintype.prod_equiv (Equiv.mulLeft τ) _ _ (fun π => rfl)
      have := congrArg (fun p => Polynomial.coeff p j) hmap
      simpa [Polynomial.coeff_map] using this
    · by_cases hj : j ≤ (k + 1).factorial
      · have hU : U = (Multiset.map (fun t => Polynomial.X - Polynomial.C t)
            (Finset.univ.val.map Θ)).prod := by
          rw [hUdef, Finset.prod_eq_multiset_prod, Multiset.map_map]; rfl
        have hcard : (Finset.univ.val.map Θ).card = (k + 1).factorial := by
          simp [Fintype.card_perm]
        rw [hU, Multiset.prod_X_sub_C_coeff _ (by rw [hcard]; exact hj), hcard,
          Finset.esymm_map_val]
        refine (MvPolynomial.totalDegree_mul _ _).trans ?_
        have h1 : ((-1 : MvPolynomial (Fin (k + 1)) (AlgebraicClosure K)) ^
            ((k + 1).factorial - j)).totalDegree = 0 := by
          have : ((-1 : MvPolynomial (Fin (k + 1)) (AlgebraicClosure K)) ^
              ((k + 1).factorial - j)) =
              MvPolynomial.C ((-1 : AlgebraicClosure K) ^ ((k + 1).factorial - j)) := by simp
          rw [this, MvPolynomial.totalDegree_C]
        rw [h1, zero_add]
        apply MvPolynomial.totalDegree_finsetSum_le
        intro t ht
        refine (MvPolynomial.totalDegree_finsetProd _ _).trans ?_
        calc ∑ i ∈ t, (Θ i).totalDegree ≤ ∑ i ∈ t, 1 := Finset.sum_le_sum fun i _ => hΘdeg i
          _ = (k + 1).factorial - j := by
            rw [Finset.sum_const, smul_eq_mul, mul_one, (Finset.mem_powersetCard.mp ht).2]
      · push_neg at hj
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt hUdeg hj)]
        simp

  have s2 : (∏ p ∈ (Finset.univ : Finset (Equiv.Perm (Fin (k + 1)))).offDiag,
        (Θ p.1 - Θ p.2)).IsSymmetric ∧
      (∏ p ∈ (Finset.univ : Finset (Equiv.Perm (Fin (k + 1)))).offDiag,
        (Θ p.1 - Θ p.2)).totalDegree ≤ (k + 1).factorial ^ 2 := by
    constructor
    · intro τ
      rw [map_prod]
      simp only [map_sub, hΘsym]
      refine Finset.prod_nbij' (fun p => (τ * p.1, τ * p.2)) (fun p => (τ⁻¹ * p.1, τ⁻¹ * p.2))
        ?_ ?_ ?_ ?_ ?_
      · intro a ha
        simp only [Finset.mem_offDiag, Finset.mem_univ, true_and] at ha ⊢
        exact fun h => ha (mul_left_cancel h)
      · intro a ha
        simp only [Finset.mem_offDiag, Finset.mem_univ, true_and] at ha ⊢
        exact fun h => ha (mul_left_cancel h)
      · intro a _; simp
      · intro a _; simp
      · intro a _; rfl
    · refine (MvPolynomial.totalDegree_finsetProd _ _).trans ?_
      calc ∑ p ∈ (Finset.univ : Finset (Equiv.Perm (Fin (k + 1)))).offDiag,
            (Θ p.1 - Θ p.2).totalDegree
          ≤ ∑ p ∈ (Finset.univ : Finset (Equiv.Perm (Fin (k + 1)))).offDiag, 1 :=
            Finset.sum_le_sum fun p _ =>
              (MvPolynomial.totalDegree_sub _ _).trans (max_le (hΘdeg _) (hΘdeg _))
        _ = (k + 1).factorial * (k + 1).factorial - (k + 1).factorial := by
            rw [Finset.sum_const, smul_eq_mul, mul_one, Finset.offDiag_card, Finset.card_univ,
              Fintype.card_perm, Fintype.card_fin]
        _ ≤ (k + 1).factorial ^ 2 := by rw [sq]; exact Nat.sub_le _ _

  have s4 : ∃ A : Fin (k + 1) → Polynomial K, (∀ t, (A t).natDegree ≤ (t : ℕ) + 1) ∧
      ∀ (E : Type u) [Field E] [Algebra K E] (e : E) (y : Fin (k + 1) → E),
        MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g =
          ∏ i, (Polynomial.X - Polynomial.C (y i)) →
        ∀ t, Polynomial.aeval e (A t) = (Finset.univ.val.map y).esymm ((t : ℕ) + 1) := by
    obtain ⟨B, hBdef⟩ : ∃ B : ℕ → Polynomial K, B = fun b =>
        ∑ s ∈ g.support.filter (fun s => s 1 = b),
          Polynomial.C (g.coeff s) * Polynomial.X ^ (s 0) := ⟨_, rfl⟩
    have hBdeg : ∀ b, (B b).natDegree ≤ k + 1 - b := by
      intro b
      rw [hBdef]
      apply Polynomial.natDegree_sum_le_of_forall_le
      intro s hs
      obtain ⟨hs1, hs2⟩ := Finset.mem_filter.mp hs
      have h := MvPolynomial.le_totalDegree hs1
      rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two] at h
      exact (Polynomial.natDegree_C_mul_X_pow_le _ _).trans (by omega)
    have hcoeff : ∀ (E : Type u) [Field E] [Algebra K E] (e : E) (b : ℕ),
        (MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g).coeff b =
          Polynomial.aeval e (B b) := by
      intro E _ _ e b
      conv_lhs => rw [MvPolynomial.as_sum g]
      rw [hBdef, map_sum, Polynomial.finsetSum_coeff, map_sum, Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro s _
      rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (fun _ => pow_zero _),
        Fin.prod_univ_two]
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Polynomial.algebraMap_apply]
      rw [← Polynomial.C_pow, ← mul_assoc, ← Polynomial.C_mul, Polynomial.coeff_C_mul_X_pow]
      by_cases h : s 1 = b
      · rw [if_pos h.symm, if_pos h]; simp
      · rw [if_neg (Ne.symm h), if_neg h]
    refine ⟨fun t => Polynomial.C ((-1) ^ ((t : ℕ) + 1)) * B (k + 1 - ((t : ℕ) + 1)), ?_, ?_⟩
    · intro t
      refine (Polynomial.natDegree_C_mul_le _ _).trans ((hBdeg _).trans ?_)
      omega
    · intro E _ _ e y hy t
      have ht : (t : ℕ) + 1 ≤ k + 1 := t.isLt
      rw [map_mul, Polynomial.aeval_C, ← hcoeff E e, hy]
      have hprod : ∏ i, (Polynomial.X - Polynomial.C (y i)) =
          (Multiset.map (fun a => Polynomial.X - Polynomial.C a)
            (Finset.univ.val.map y)).prod := by
        rw [Finset.prod_eq_multiset_prod, Multiset.map_map]; rfl
      have hcard : (Finset.univ.val.map y).card = k + 1 := by simp
      rw [hprod, Multiset.prod_X_sub_C_coeff _ (by rw [hcard]; omega), hcard]
      have h3 : k + 1 - (k + 1 - ((t : ℕ) + 1)) = (t : ℕ) + 1 := by omega
      rw [h3, map_pow, map_neg, map_one, ← mul_assoc, ← mul_pow, neg_one_mul, neg_neg, one_pow,
        one_mul]
  obtain ⟨A, hA, hAev⟩ := s4

  have s5 : ∀ (j : ℕ) (Ψ Q : MvPolynomial (Fin (k + 1)) (AlgebraicClosure K)),
      (∀ a ∈ Q.support, (a.sum fun i n => ((i : ℕ) + 1) * n) ≤ j) →
      Ψ = MvPolynomial.aeval (fun t : Fin (k + 1) =>
        MvPolynomial.esymm (Fin (k + 1)) (AlgebraicClosure K) ((t : ℕ) + 1)) Q →
      ∃ ψ : Polynomial (AlgebraicClosure K), ψ.natDegree ≤ j ∧
        ∀ (E : Type u) [Field E] [Algebra (AlgebraicClosure K) E] [Algebra K E]
          [IsScalarTower K (AlgebraicClosure K) E] (e : E) (y : Fin (k + 1) → E),
          MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g =
            ∏ i, (Polynomial.X - Polynomial.C (y i)) →
          Polynomial.aeval e ψ = MvPolynomial.aeval y Ψ := by
    intro j Ψ Q hQ hΨ
    refine ⟨MvPolynomial.aeval (fun t => Polynomial.map (algebraMap K (AlgebraicClosure K)) (A t))
      Q, ?_, ?_⟩
    · conv_lhs => rw [MvPolynomial.as_sum Q]
      rw [map_sum]
      apply Polynomial.natDegree_sum_le_of_forall_le
      intro a ha
      rw [MvPolynomial.aeval_monomial, Polynomial.algebraMap_eq]
      refine (Polynomial.natDegree_C_mul_le _ _).trans ?_
      rw [Finsupp.prod]
      refine (Polynomial.natDegree_prod_le _ _).trans ?_
      have h := hQ a ha
      rw [Finsupp.sum] at h
      refine le_trans ?_ h
      apply Finset.sum_le_sum
      intro i _
      refine Polynomial.natDegree_pow_le.trans ?_
      rw [mul_comm ((i : ℕ) + 1)]
      exact Nat.mul_le_mul_left _ (Polynomial.natDegree_map_le.trans (hA i))
    · intro E _ _ _ _ e y hy
      rw [hΨ, MvPolynomial.comp_aeval_apply, MvPolynomial.comp_aeval_apply]
      refine congrArg (fun f => MvPolynomial.aeval f Q) ?_
      funext t
      rw [Polynomial.aeval_map_algebraMap, hAev E e y hy t,
        MvPolynomial.aeval_esymm_eq_multiset_esymm]

  have s6 : ∀ (N : ℕ) (ψ : ℕ → Polynomial (AlgebraicClosure K)),
      (∀ j, (ψ j).natDegree ≤ N - j) →
      ∃ R : MvPolynomial (Fin 2) (AlgebraicClosure K), R.totalDegree ≤ N ∧
        ∀ (E : Type u) [Field E] [Algebra (AlgebraicClosure K) E] (e : E),
          MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] R =
            ∑ j ∈ Finset.range (N + 1),
              Polynomial.C (Polynomial.aeval e (ψ j)) * Polynomial.X ^ j := by
    intro N ψ hψ
    have hdeg0 : ∀ P : Polynomial (AlgebraicClosure K),
        (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) (AlgebraicClosure K))
          P).totalDegree ≤ P.natDegree := by
      intro P
      rw [Polynomial.aeval_eq_sum_range]
      apply MvPolynomial.totalDegree_finsetSum_le
      intro i hi
      refine (MvPolynomial.totalDegree_smul_le _ _).trans ?_
      rw [MvPolynomial.totalDegree_X_pow]
      exact Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    refine ⟨∑ j ∈ Finset.range (N + 1),
      Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) (AlgebraicClosure K)) (ψ j) *
        MvPolynomial.X 1 ^ j, ?_, ?_⟩
    · apply MvPolynomial.totalDegree_finsetSum_le
      intro j hj
      have hj' := Finset.mem_range.mp hj
      refine (MvPolynomial.totalDegree_mul _ _).trans ?_
      rw [MvPolynomial.totalDegree_X_pow]
      have := (hdeg0 (ψ j)).trans (hψ j)
      omega
    · intro E _ _ e
      rw [map_sum]
      apply Finset.sum_congr rfl
      intro j _
      have h0 : MvPolynomial.aeval ![Polynomial.C e, Polynomial.X]
          (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) (AlgebraicClosure K))
            (ψ j)) = Polynomial.C (Polynomial.aeval e (ψ j)) := by
        rw [← Polynomial.aeval_algHom_apply, MvPolynomial.aeval_X]
        have := Polynomial.aeval_algHom_apply
          (Polynomial.CAlgHom (R := AlgebraicClosure K) (A := E)) e (ψ j)
        rw [Polynomial.CAlgHom_apply, Polynomial.CAlgHom_apply] at this
        simpa using this
      rw [map_mul, map_pow, h0, MvPolynomial.aeval_X]
      simp

  obtain ⟨hUdeg, hUc⟩ := s1
  obtain ⟨hΔsym, hΔdeg⟩ := s2
  have hψ : ∀ j : ℕ, ∃ ψ : Polynomial (AlgebraicClosure K),
      ψ.natDegree ≤ (k + 1).factorial - j ∧
      ∀ (E : Type u) [Field E] [Algebra (AlgebraicClosure K) E] [Algebra K E]
        [IsScalarTower K (AlgebraicClosure K) E] (e : E) (y : Fin (k + 1) → E),
        MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g =
          ∏ i, (Polynomial.X - Polynomial.C (y i)) →
        Polynomial.aeval e ψ =
          MvPolynomial.aeval y ((∏ π, (Polynomial.X - Polynomial.C (Θ π))).coeff j) := by
    intro j
    obtain ⟨Q, hQ, hΨ⟩ := s3 ((k + 1).factorial - j) _ (hUc j).1 (hUc j).2
    exact s5 _ _ Q hQ hΨ
  choose ψ hψdeg hψev using hψ
  obtain ⟨Qd, hQd, hΨd⟩ := s3 ((k + 1).factorial ^ 2) _ hΔsym hΔdeg
  obtain ⟨d, hddeg, hdev⟩ := s5 _ _ Qd hQd hΨd
  obtain ⟨R, hRdeg, hRev⟩ := s6 ((k + 1).factorial) ψ hψdeg
  refine ⟨R, d, hRdeg, hddeg, ?_⟩
  intro E _ _ _ _ e y hy
  have hφΘ : ∀ π : Equiv.Perm (Fin (k + 1)), MvPolynomial.aeval y (Θ π) =
      ∑ i, algebraMap (AlgebraicClosure K) E (c i) * y (π i) := by
    intro π
    simp only [hΘdef, map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X]
  constructor
  · rw [hRev E e]
    have hmapU : Polynomial.map (MvPolynomial.aeval y :
        MvPolynomial (Fin (k + 1)) (AlgebraicClosure K) →ₐ[AlgebraicClosure K] E).toRingHom
        (∏ π, (Polynomial.X - Polynomial.C (Θ π))) = ∏ π : Equiv.Perm (Fin (k + 1)),
          (Polynomial.X - Polynomial.C
            (∑ i, algebraMap (AlgebraicClosure K) E (c i) * y (π i))) := by
      rw [Polynomial.map_prod]
      refine Finset.prod_congr rfl fun π _ => ?_
      rw [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, ← hφΘ π]
      rfl
    rw [← hmapU]
    conv_rhs => rw [Polynomial.as_sum_range' _ ((k + 1).factorial + 1)
      (lt_of_le_of_lt (Polynomial.natDegree_map_le.trans hUdeg) (Nat.lt_succ_self _))]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Polynomial.C_mul_X_pow_eq_monomial, Polynomial.coeff_map, hψev j E e y hy]
    rfl
  · rw [hdev E e y hy, map_prod]
    refine Finset.prod_congr rfl fun p _ => ?_
    rw [map_sub, hφΘ, hφΘ]

theorem lw_sigma_resolvent (K : Type u) [Field K] [Fintype K] (k : ℕ)
    (g : MvPolynomial (Fin 2) K) (hdeg : g.totalDegree = k + 1)
    (hmon : g.coeff (Finsupp.single 1 (k + 1)) = 1)
    (x : Fin (k + 1) → lwtrGenField (AlgebraicClosure K)) (hx : Function.Injective x)
    (hxg : lwtrGenEv (AlgebraicClosure K) (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g) =
        ∏ i, (Polynomial.X - Polynomial.C (x i)))
    (hq : (k + 1).factorial ^ 2 ≤ Nat.card K) (σ : Equiv.Perm (Fin (k + 1))) :
    ∃ (c : Fin (k + 1) → AlgebraicClosure K) (R : MvPolynomial (Fin 2) (AlgebraicClosure K))
      (d : Polynomial (AlgebraicClosure K)),
      (∀ i, c i ^ Nat.card K = c (σ i)) ∧
      Function.Injective (fun π : Equiv.Perm (Fin (k + 1)) =>
        ∑ i, algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (c i) * x (π i)) ∧
      R.totalDegree ≤ (k + 1).factorial ∧ d.natDegree ≤ (k + 1).factorial ^ 2 ∧ d ≠ 0 ∧
      lwtrGenEv (AlgebraicClosure K) R = ∏ π : Equiv.Perm (Fin (k + 1)),
        (Polynomial.X - Polynomial.C
          (∑ i, algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (c i) * x (π i))) ∧
      ∀ (e : AlgebraicClosure K) (y : Fin (k + 1) → AlgebraicClosure K),
        MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g =
            ∏ i, (Polynomial.X - Polynomial.C (y i)) →
          MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] R = ∏ π : Equiv.Perm (Fin (k + 1)),
              (Polynomial.X - Polynomial.C (∑ i, c i * y (π i))) ∧
            Polynomial.aeval e d =
              ∏ p ∈ (Finset.univ : Finset (Equiv.Perm (Fin (k + 1)))).offDiag,
                ((∑ i, c i * y (p.1 i)) - ∑ i, c i * y (p.2 i)) :=
by
  classical
  have hN1 : 0 < (k + 1).factorial := Nat.factorial_pos _
  let W : Finset (Fin (k + 1) → lwtrGenField (AlgebraicClosure K)) :=
    (Finset.univ : Finset (Equiv.Perm (Fin (k + 1)))).offDiag.image
      (fun p => fun i => x (p.1 i) - x (p.2 i))
  have hWcard : W.card < Nat.card K := by
    have h1 : W.card ≤ (k + 1).factorial * (k + 1).factorial - (k + 1).factorial := by
      refine le_trans Finset.card_image_le (le_of_eq ?_)
      rw [Finset.offDiag_card, Finset.card_univ, Fintype.card_perm, Fintype.card_fin]
    have h2 : (k + 1).factorial * (k + 1).factorial - (k + 1).factorial <
        (k + 1).factorial * (k + 1).factorial :=
      Nat.sub_lt (Nat.mul_pos hN1 hN1) hN1
    rw [sq] at hq
    exact lt_of_le_of_lt h1 (lt_of_lt_of_le h2 hq)
  have hW0 : ∀ w ∈ W, w ≠ 0 := by
    intro w hw
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hw
    obtain ⟨-, -, hne⟩ := Finset.mem_offDiag.mp hp
    obtain ⟨i, hi⟩ : ∃ i, p.1 i ≠ p.2 i := by
      by_contra h
      push_neg at h
      exact hne (Equiv.ext h)
    intro h0
    have h3 := congrFun h0 i
    simp only [Pi.zero_apply, sub_eq_zero] at h3
    exact hi (hx h3)
  obtain ⟨c, hc, hcW⟩ :=
    lw_twist_vector_exists K (k + 1) σ (lwtrGenField (AlgebraicClosure K)) W hW0 hWcard
  have hθ : Function.Injective (fun π : Equiv.Perm (Fin (k + 1)) =>
      ∑ i, algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (c i) * x (π i)) := by
    intro π π' h
    by_contra hne
    have hmem : (fun i => x (π i) - x (π' i)) ∈ W :=
      Finset.mem_image.mpr ⟨(π, π'),
        Finset.mem_offDiag.mpr ⟨Finset.mem_univ _, Finset.mem_univ _, hne⟩, rfl⟩
    apply hcW _ hmem
    simp only [mul_sub, Finset.sum_sub_distrib]
    exact sub_eq_zero.mpr h
  obtain ⟨R, d, hRdeg, hddeg, hU⟩ := lw_twisted_resolvent_poly K k g hdeg hmon c
  have hgen := hU (lwtrGenField (AlgebraicClosure K))
    (algebraMap (RatFunc (AlgebraicClosure K)) (lwtrGenField (AlgebraicClosure K)) RatFunc.X) x
    ((MvPolynomial.aeval_map_algebraMap (AlgebraicClosure K) _ g).symm.trans hxg)
  obtain ⟨hR, hd⟩ := hgen
  refine ⟨c, R, d, hc, hθ, hRdeg, hddeg, ?_, hR, ?_⟩
  · intro hd0
    rw [hd0, map_zero] at hd
    refine (Finset.prod_ne_zero_iff.mpr ?_) hd.symm
    intro p hp
    obtain ⟨-, -, hne⟩ := Finset.mem_offDiag.mp hp
    exact sub_ne_zero.mpr (fun h => hne (hθ h))
  · intro e y hy
    have h2 := hU (AlgebraicClosure K) e y hy
    simpa only [Algebra.algebraMap_self, RingHom.id_apply] using h2

theorem lw_orbit_minpoly (F : Type u) [Field F] (m : ℕ) (H : Subgroup (Equiv.Perm (Fin m)))
    [DecidablePred (· ∈ H)]
    (x : Fin m → lwtrGenField F) (hxint : ∀ i, IsIntegral (Polynomial F) (x i))
    (hH1 : ∀ τ : lwtrGenField F ≃ₐ[RatFunc F] lwtrGenField F, ∃ h ∈ H, ∀ i, τ (x i) = x (h i))
    (hH2 : ∀ h ∈ H, ∃ τ : lwtrGenField F ≃ₐ[RatFunc F] lwtrGenField F, ∀ i, τ (x i) = x (h i))
    (c : Fin m → F)
    (hθ : Function.Injective (fun π : Equiv.Perm (Fin m) =>
      ∑ i, algebraMap F (lwtrGenField F) (c i) * x (π i)))
    (R : MvPolynomial (Fin 2) F)
    (hR : lwtrGenEv F R = ∏ π : Equiv.Perm (Fin m),
      (Polynomial.X - Polynomial.C (∑ i, algebraMap F (lwtrGenField F) (c i) * x (π i))))
    (π : Equiv.Perm (Fin m)) :
    ∃ P : MvPolynomial (Fin 2) F, Irreducible P ∧ P ∣ R ∧
      lwtrGenEv F P = ∏ h : H, (Polynomial.X - Polynomial.C
        (∑ i, algebraMap F (lwtrGenField F) (c i) * x (((h : Equiv.Perm (Fin m)) * π) i))) :=
by
  classical

  obtain ⟨φ, hφd⟩ : ∃ φ : MvPolynomial (Fin 2) F →ₐ[F] Polynomial (Polynomial F),
      φ = MvPolynomial.aeval (R := F)
        (![Polynomial.C Polynomial.X, Polynomial.X] : Fin 2 → Polynomial (Polynomial F)) :=
    ⟨_, rfl⟩

  have hA : ∀ P : MvPolynomial (Fin 2) F, lwtrGenEv F P =
      Polynomial.map (algebraMap (Polynomial F) (lwtrGenField F)) (φ P) := by
    intro P
    rw [hφd]
    induction P using MvPolynomial.induction_on with
    | C a =>
      simp only [MvPolynomial.aeval_C, Polynomial.algebraMap_apply, Polynomial.map_C]
      rw [IsScalarTower.algebraMap_apply F (Polynomial F) (lwtrGenField F)]
      rfl
    | add p q hp hq => rw [map_add, map_add, hp, hq, Polynomial.map_add]
    | mul_X p i hp =>
      rw [map_mul, map_mul, hp, Polynomial.map_mul]
      congr 1
      fin_cases i
      · simp only [MvPolynomial.aeval_X]
        simp [Polynomial.map_C]
        rw [IsScalarTower.algebraMap_apply (Polynomial F) (RatFunc F) (lwtrGenField F),
          RatFunc.algebraMap_X]
      · simp [MvPolynomial.aeval_X]

  have hB : Function.Bijective φ := by
    let inner : Polynomial F →+* MvPolynomial (Fin 2) F :=
      Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)
    let ψ : Polynomial (Polynomial F) →+* MvPolynomial (Fin 2) F :=
      Polynomial.eval₂RingHom inner (MvPolynomial.X 1)
    have h1 : ψ.comp φ.toRingHom = RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp [ψ, inner, hφd, Polynomial.algebraMap_apply]
      · intro i
        fin_cases i <;> simp [ψ, inner, hφd]
    have h2inner : φ.toRingHom.comp inner = Polynomial.C := by
      apply Polynomial.ringHom_ext
      · intro b
        simp [inner, hφd, Polynomial.algebraMap_apply]
      · simp [inner, hφd]
    have h2 : φ.toRingHom.comp ψ = RingHom.id _ := by
      apply Polynomial.ringHom_ext
      · intro a
        have := congrArg (fun f => f a) h2inner
        simpa [ψ] using this
      · simp [ψ, hφd]
    refine ⟨fun p q hpq => ?_, fun Q => ⟨ψ Q, ?_⟩⟩
    · have hp := congrArg (fun f => f p) h1
      have hq := congrArg (fun f => f q) h1
      simp only [RingHom.comp_apply, RingHom.id_apply, AlgHom.toRingHom_eq_coe,
        RingHom.coe_coe] at hp hq
      rw [← hp, ← hq, hpq]
    · have := congrArg (fun f => f Q) h2
      simpa using this
  obtain ⟨θ, hθd⟩ : ∃ θ : Equiv.Perm (Fin m) → lwtrGenField F,
      θ = fun π' => ∑ i, algebraMap F (lwtrGenField F) (c i) * x (π' i) := ⟨_, rfl⟩
  have hθ' : Function.Injective θ := by rw [hθd]; exact hθ
  have hR' : lwtrGenEv F R = ∏ π' : Equiv.Perm (Fin m), (Polynomial.X - Polynomial.C (θ π')) := by
    rw [hR, hθd]

  have hequiv : ∀ (τ : lwtrGenField F ≃ₐ[RatFunc F] lwtrGenField F) (h : Equiv.Perm (Fin m)),
      (∀ i, τ (x i) = x (h i)) → ∀ π', τ (θ π') = θ (h * π') := by
    intro τ h hx π'
    simp only [hθd]
    rw [map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_mul, hx, Equiv.Perm.mul_apply,
      IsScalarTower.algebraMap_apply F (RatFunc F) (lwtrGenField F), AlgEquiv.commutes]
  have hscal : algebraMap (Polynomial F) (lwtrGenField F) =
      (algebraMap (RatFunc F) (lwtrGenField F)).comp (algebraMap (Polynomial F) (RatFunc F)) :=
    IsScalarTower.algebraMap_eq _ _ _

  have hψ : Polynomial.map (algebraMap (RatFunc F) (lwtrGenField F))
      (Polynomial.map (algebraMap (Polynomial F) (RatFunc F)) (φ R)) =
      ∏ π' : Equiv.Perm (Fin m), (Polynomial.X - Polynomial.C (θ π')) := by
    rw [Polynomial.map_map, ← hscal, ← hA R, hR']

  have ht : IsIntegral (Polynomial F) (θ π) := by
    simp only [hθd]
    refine IsIntegral.sum _ fun i _ => IsIntegral.mul ?_ (hxint _)
    rw [IsScalarTower.algebraMap_apply F (Polynomial F) (lwtrGenField F)]
    exact isIntegral_algebraMap
  have htL : IsIntegral (RatFunc F) (θ π) := ht.tower_top

  have hμmonic := minpoly.monic htL
  have hμirr := minpoly.irreducible htL
  have haevψ : Polynomial.aeval (θ π)
      (Polynomial.map (algebraMap (Polynomial F) (RatFunc F)) (φ R)) = 0 := by
    rw [← Polynomial.eval_map_algebraMap, hψ, Polynomial.eval_prod]
    exact Finset.prod_eq_zero (Finset.mem_univ π) (by simp)
  have hμψ := minpoly.dvd (RatFunc F) (θ π) haevψ
  have hψsep : (Polynomial.map (algebraMap (Polynomial F) (RatFunc F)) (φ R)).Separable := by
    rw [← Polynomial.separable_map (algebraMap (RatFunc F) (lwtrGenField F)), hψ]
    exact Polynomial.separable_prod_X_sub_C_iff.mpr hθ'
  obtain ⟨μM, hμMd⟩ : ∃ p : Polynomial (lwtrGenField F),
      p = Polynomial.map (algebraMap (RatFunc F) (lwtrGenField F)) (minpoly (RatFunc F) (θ π)) :=
    ⟨_, rfl⟩
  have hμMmonic : μM.Monic := by rw [hμMd]; exact hμmonic.map _
  have hμM0 : μM ≠ 0 := hμMmonic.ne_zero
  have hnodup : μM.roots.Nodup := by
    rw [hμMd]; exact Polynomial.nodup_roots ((hψsep.of_dvd hμψ).map)

  have hmemroots : ∀ a, a ∈ μM.roots ↔ ∃ h : H, θ (↑h * π) = a := by
    intro a
    rw [Polynomial.mem_roots hμM0, Polynomial.IsRoot.def, hμMd, Polynomial.eval_map_algebraMap]
    constructor
    · intro ha
      have h1 : minpoly (RatFunc F) (θ π) = minpoly (RatFunc F) a :=
        minpoly.eq_of_irreducible_of_monic hμirr ha hμmonic
      have h2 := (Normal.minpoly_eq_iff_mem_orbit (lwtrGenField F)).mp h1.symm
      obtain ⟨τ, hτ⟩ := MulAction.mem_orbit_iff.mp h2
      obtain ⟨h, hh, hx⟩ := hH1 τ
      refine ⟨⟨h, hh⟩, ?_⟩
      show θ (h * π) = a
      rw [← hτ, AlgEquiv.smul_def]
      exact (hequiv τ h hx π).symm
    · rintro ⟨⟨h, hh⟩, rfl⟩
      obtain ⟨τ, hx⟩ := hH2 h hh
      show Polynomial.aeval (θ (h * π)) (minpoly (RatFunc F) (θ π)) = 0
      rw [← hequiv τ h hx π, Polynomial.aeval_algHom_apply, minpoly.aeval, map_zero]
  have hinj : Function.Injective (fun h : H => θ (↑h * π)) := by
    intro h1 h2 e
    exact Subtype.ext (mul_right_cancel (hθ' e))
  have hroots : μM.roots = Multiset.map (fun h : H => θ (↑h * π)) Finset.univ.val := by
    rw [Multiset.Nodup.ext hnodup (Multiset.Nodup.map hinj Finset.univ.nodup)]
    intro a
    rw [hmemroots, Multiset.mem_map]
    simp
  have hsplit : μM.roots.card = μM.natDegree :=
    Polynomial.splits_iff_card_roots.mp (IsAlgClosed.splits μM)
  have hμMprod : μM = ∏ h : H, (Polynomial.X - Polynomial.C (θ (↑h * π))) := by
    rw [← Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hμMmonic hsplit, hroots,
      Multiset.map_map, Finset.prod_eq_multiset_prod]
    rfl

  have hQmonic := minpoly.monic ht
  have hQL : minpoly (RatFunc F) (θ π) = Polynomial.map (algebraMap (Polynomial F) (RatFunc F))
      (minpoly (Polynomial F) (θ π)) :=
    minpoly.isIntegrallyClosed_eq_field_fractions' (RatFunc F) ht
  have hQirr : Irreducible (minpoly (Polynomial F) (θ π)) :=
    (hQmonic.irreducible_iff_irreducible_map_fraction_map (K := RatFunc F)).mpr
      (by rw [← hQL]; exact hμirr)
  obtain ⟨P, hφP⟩ := hB.2 (minpoly (Polynomial F) (θ π))
  have hPirr : Irreducible P := by
    apply (MulEquiv.irreducible_iff (AlgEquiv.ofBijective φ hB) (x := P)).mp
    rw [AlgEquiv.ofBijective_apply, hφP]
    exact hQirr
  have hPev' : lwtrGenEv F P = μM := by
    rw [hA P, hφP, hscal, ← Polynomial.map_map, ← hQL, hμMd]
  have hQdvd : minpoly (Polynomial F) (θ π) ∣ φ R := by
    rw [← Polynomial.map_dvd_map (algebraMap (Polynomial F) (RatFunc F))
      (RatFunc.algebraMap_injective F) hQmonic, ← hQL]
    exact hμψ
  obtain ⟨D', hD'⟩ := hQdvd
  obtain ⟨D, hD⟩ := hB.2 D'
  refine ⟨P, hPirr, ⟨D, hB.1 ?_⟩, ?_⟩
  · rw [map_mul, hD, hφP, ← hD']
  · rw [hPev', hμMprod, hθd]

theorem lw_frobenius_descent (K : Type u) [Field K] [Fintype K] (m : ℕ)
    (hev : Function.Injective (lwtrGenEv (AlgebraicClosure K)))
    (Φ : lwtrGenField (AlgebraicClosure K) ≃+* lwtrGenField (AlgebraicClosure K))
    (hΦev : ∀ P : MvPolynomial (Fin 2) (AlgebraicClosure K),
      Polynomial.map (Φ : lwtrGenField (AlgebraicClosure K) →+* lwtrGenField (AlgebraicClosure K))
          (lwtrGenEv (AlgebraicClosure K) P) =
        lwtrGenEv (AlgebraicClosure K) (MvPolynomial.map (lwtrFrob K) P))
    (hΦc : ∀ a : AlgebraicClosure K,
      Φ (algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) a) =
        algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (a ^ Nat.card K))
    (H : Subgroup (Equiv.Perm (Fin m))) [DecidablePred (· ∈ H)] (ρ : Equiv.Perm (Fin m))
    (hρ : ∀ h, ρ * h * ρ⁻¹ ∈ H ↔ h ∈ H)
    (x : Fin m → lwtrGenField (AlgebraicClosure K)) (hΦx : ∀ i, Φ (x i) = x (ρ i))
    (σ : Equiv.Perm (Fin m)) (c : Fin m → AlgebraicClosure K)
    (hc : ∀ i, c i ^ Nat.card K = c (σ i))
    (hθ : Function.Injective (fun π : Equiv.Perm (Fin m) =>
      ∑ i, algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (c i) * x (π i)))
    (R : MvPolynomial (Fin 2) (AlgebraicClosure K))
    (hR : lwtrGenEv (AlgebraicClosure K) R = ∏ π : Equiv.Perm (Fin m),
      (Polynomial.X - Polynomial.C
        (∑ i, algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (c i) * x (π i))))
    (Pf : Equiv.Perm (Fin m) → MvPolynomial (Fin 2) (AlgebraicClosure K))
    (hPf : ∀ π, Irreducible (Pf π) ∧ Pf π ∣ R ∧
      lwtrGenEv (AlgebraicClosure K) (Pf π) = ∏ h : H, (Polynomial.X - Polynomial.C
        (∑ i, algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (c i) *
          x (((h : Equiv.Perm (Fin m)) * π) i)))) :
    ∃ (n : ℕ) (P : Fin n → MvPolynomial (Fin 2) K) (T : Finset (Equiv.Perm (Fin m))),
      n * Nat.card H = Nat.card {π : Equiv.Perm (Fin m) // ∃ h ∈ H, π * σ * π⁻¹ = h * ρ} ∧
      (∀ i, (P i).totalDegree ≤ R.totalDegree ∧
        Irreducible (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) (P i))) ∧
      R = ∏ π ∈ T, Pf π ∧
      ∀ π ∈ T, (∃ i, Pf π = MvPolynomial.map (algebraMap K (AlgebraicClosure K)) (P i)) ∨
        (∃ π' ∈ T, π' ≠ π ∧ MvPolynomial.map (lwtrFrob K) (Pf π) = Pf π') :=
by
  classical

  have hfix : ∀ a : AlgebraicClosure K, a ^ Nat.card K = a →
      ∃ b : K, algebraMap K (AlgebraicClosure K) b = a := by
    intro a ha
    rw [Nat.card_eq_fintype_card] at ha
    have hQ1 : 1 < Fintype.card K := Fintype.one_lt_card
    have hfdeg : (Polynomial.X ^ Fintype.card K - Polynomial.X :
        Polynomial (AlgebraicClosure K)).natDegree = Fintype.card K :=
      FiniteField.X_pow_card_sub_X_natDegree_eq _ hQ1
    have hf0 : (Polynomial.X ^ Fintype.card K - Polynomial.X :
        Polynomial (AlgebraicClosure K)) ≠ 0 := by
      intro h
      rw [h, Polynomial.natDegree_zero] at hfdeg
      omega
    have hsub : Finset.univ.image (algebraMap K (AlgebraicClosure K)) ⊆
        (Polynomial.X ^ Fintype.card K - Polynomial.X :
          Polynomial (AlgebraicClosure K)).roots.toFinset := by
      intro y hy
      obtain ⟨b, -, rfl⟩ := Finset.mem_image.mp hy
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hf0, Polynomial.IsRoot.def,
        Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, ← map_pow,
        FiniteField.pow_card, sub_self]
    have hcard : (Polynomial.X ^ Fintype.card K - Polynomial.X :
        Polynomial (AlgebraicClosure K)).roots.toFinset.card ≤
        (Finset.univ.image (algebraMap K (AlgebraicClosure K))).card := by
      rw [Finset.card_image_of_injective _ (algebraMap K _).injective, Finset.card_univ]
      exact (Multiset.toFinset_card_le _).trans ((Polynomial.card_roots' _).trans hfdeg.le)
    have heq := Finset.eq_of_subset_of_card_le hsub hcard
    have ha' : a ∈ (Polynomial.X ^ Fintype.card K - Polynomial.X :
        Polynomial (AlgebraicClosure K)).roots.toFinset := by
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hf0, Polynomial.IsRoot.def,
        Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, ha, sub_self]
    rw [← heq] at ha'
    obtain ⟨b, -, hb⟩ := Finset.mem_image.mp ha'
    exact ⟨b, hb⟩

  have hdesc : ∀ P : MvPolynomial (Fin 2) (AlgebraicClosure K),
      MvPolynomial.map (lwtrFrob K) P = P →
      ∃ P₀ : MvPolynomial (Fin 2) K,
        MvPolynomial.map (algebraMap K (AlgebraicClosure K)) P₀ = P ∧
          P₀.totalDegree = P.totalDegree := by
    intro P hP
    have hco : ∀ n, P.coeff n ^ Nat.card K = P.coeff n := by
      intro n
      have h1 := congrArg (fun Q : MvPolynomial (Fin 2) (AlgebraicClosure K) => Q.coeff n) hP
      simp only [MvPolynomial.coeff_map] at h1
      have h2 := FiniteField.frobeniusAlgEquivOfAlgebraic_apply K (AlgebraicClosure K) (P.coeff n)
      rw [Nat.card_eq_fintype_card, ← h2]
      exact h1
    obtain ⟨P₀, hP₀⟩ : P ∈ Set.range (MvPolynomial.map (algebraMap K (AlgebraicClosure K))) := by
      rw [MvPolynomial.mem_range_map_iff_coeffs_subset]
      intro a ha
      obtain ⟨n, -, rfl⟩ := MvPolynomial.mem_coeffs_iff.mp ha
      exact hfix _ (hco n)
    refine ⟨P₀, hP₀, ?_⟩
    rw [← hP₀]
    unfold MvPolynomial.totalDegree
    rw [MvPolynomial.support_map_of_injective _ (algebraMap K _).injective]

  have h3a : ∀ π' : Equiv.Perm (Fin m),
      Φ (∑ i, algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (c i) *
        x (π' i)) =
      ∑ i, algebraMap (AlgebraicClosure K) (lwtrGenField (AlgebraicClosure K)) (c i) *
        x ((ρ * π' * σ⁻¹) i) := by
    intro π'
    rw [map_sum]
    simp only [map_mul, hΦc, hΦx, hc]
    rw [← Equiv.sum_comp σ (fun j => algebraMap (AlgebraicClosure K)
      (lwtrGenField (AlgebraicClosure K)) (c j) * x ((ρ * π' * σ⁻¹) j))]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp [Equiv.Perm.mul_apply]

  have hρ1 : ∀ h : H, ρ * (h : Equiv.Perm (Fin m)) * ρ⁻¹ ∈ H := fun h => (hρ h).2 h.2
  have hρ2 : ∀ h : H, ρ⁻¹ * (h : Equiv.Perm (Fin m)) * ρ ∈ H := fun h =>
    (hρ _).1 (by
      rw [show ρ * (ρ⁻¹ * (h : Equiv.Perm (Fin m)) * ρ) * ρ⁻¹ = h by group]
      exact h.2)
  let eH : H ≃ H :=
    { toFun := fun h => ⟨_, hρ1 h⟩
      invFun := fun h => ⟨_, hρ2 h⟩
      left_inv := fun h => Subtype.ext (by
        show ρ⁻¹ * (ρ * (h : Equiv.Perm (Fin m)) * ρ⁻¹) * ρ = h
        group)
      right_inv := fun h => Subtype.ext (by
        show ρ * (ρ⁻¹ * (h : Equiv.Perm (Fin m)) * ρ) * ρ⁻¹ = h
        group) }

  have htr : ∀ π, MvPolynomial.map (lwtrFrob K) (Pf π) = Pf (ρ * π * σ⁻¹) := by
    intro π
    apply hev
    rw [← hΦev, (hPf π).2.2, (hPf (ρ * π * σ⁻¹)).2.2, Polynomial.map_prod]
    simp only [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, RingEquiv.coe_toRingHom,
      h3a]
    refine Fintype.prod_equiv eH _ _ (fun h => ?_)
    have : ((eH h : H) : Equiv.Perm (Fin m)) * (ρ * π * σ⁻¹) =
        ρ * ((h : Equiv.Perm (Fin m)) * π) * σ⁻¹ := by
      show ρ * (h : Equiv.Perm (Fin m)) * ρ⁻¹ * (ρ * π * σ⁻¹) = _
      group
    rw [this]

  have hinvPf : ∀ π, ∀ h₀ ∈ H, Pf (h₀ * π) = Pf π := by
    intro π h₀ hh₀
    apply hev
    rw [(hPf (h₀ * π)).2.2, (hPf π).2.2]
    refine Fintype.prod_equiv (Equiv.mulRight (⟨h₀, hh₀⟩ : H)) _ _ (fun h => ?_)
    simp only [Equiv.coe_mulRight, Subgroup.coe_mul, mul_assoc]

  have hratmul : ∀ π : Equiv.Perm (Fin m), ∀ h₀ ∈ H, (∃ h ∈ H, π * σ * π⁻¹ = h * ρ) →
      ∃ h ∈ H, h₀ * π * σ * (h₀ * π)⁻¹ = h * ρ := by
    rintro π h₀ hh₀ ⟨h, hh, he⟩
    refine ⟨h₀ * h * (ρ * h₀⁻¹ * ρ⁻¹),
      H.mul_mem (H.mul_mem hh₀ hh) ((hρ _).2 (H.inv_mem hh₀)), ?_⟩
    calc h₀ * π * σ * (h₀ * π)⁻¹ = h₀ * (π * σ * π⁻¹) * h₀⁻¹ := by group
      _ = h₀ * (h * ρ) * h₀⁻¹ := by rw [he]
      _ = _ := by group

  obtain ⟨rep, hrep1, hrep2⟩ : ∃ rep : Equiv.Perm (Fin m) → Equiv.Perm (Fin m),
      (∀ π, π * (rep π)⁻¹ ∈ H) ∧ (∀ π π', π' * π⁻¹ ∈ H → rep π = rep π') := by
    refine ⟨fun π => (Quotient.mk (QuotientGroup.rightRel H) π).out, fun π => ?_,
      fun π π' h => ?_⟩
    · exact QuotientGroup.rightRel_apply.mp (Quotient.mk_out (s := QuotientGroup.rightRel H) π)
    · exact congrArg Quotient.out (Quotient.sound (QuotientGroup.rightRel_apply.mpr h))
  obtain ⟨T, hT⟩ : ∃ T : Finset (Equiv.Perm (Fin m)), ∀ r, r ∈ T ↔ ∃ π, rep π = r :=
    ⟨Finset.univ.image rep, fun r => by simp⟩
  have hrepT : ∀ π, rep π ∈ T := fun π => (hT _).2 ⟨π, rfl⟩
  have hTrep : ∀ r ∈ T, rep r = r := by
    intro r hr
    obtain ⟨π, rfl⟩ := (hT r).1 hr
    exact hrep2 (rep π) π (hrep1 π)
  have hrepmul : ∀ r ∈ T, ∀ h ∈ H, rep (h * r) = r := by
    intro r hr h hh
    rw [← hrep2 r (h * r) (by rwa [mul_inv_cancel_right]), hTrep r hr]
  obtain ⟨Trat, hTrat⟩ : ∃ Trat : Finset (Equiv.Perm (Fin m)),
      ∀ r, r ∈ Trat ↔ r ∈ T ∧ ∃ h ∈ H, r * σ * r⁻¹ = h * ρ :=
    ⟨T.filter (fun r => ∃ h ∈ H, r * σ * r⁻¹ = h * ρ), fun r => Finset.mem_filter⟩

  have hRT : R = ∏ r ∈ T, Pf r := by
    apply hev
    rw [hR, map_prod, Finset.prod_congr rfl (fun r _ => (hPf r).2.2), ← Finset.prod_product']
    refine Finset.prod_nbij' (fun π => (rep π, (⟨π * (rep π)⁻¹, hrep1 π⟩ : H)))
      (fun p => (p.2 : Equiv.Perm (Fin m)) * p.1) ?_ ?_ ?_ ?_ ?_
    · intro π _
      exact Finset.mem_product.mpr ⟨hrepT π, Finset.mem_univ _⟩
    · intro p _
      exact Finset.mem_univ _
    · intro π _
      exact inv_mul_cancel_right _ _
    · intro p hp
      have hp1 := (Finset.mem_product.mp hp).1
      have hr := hrepmul p.1 hp1 p.2 p.2.2
      refine Prod.ext hr (Subtype.ext ?_)
      show (p.2 : Equiv.Perm (Fin m)) * p.1 * (rep ((p.2 : Equiv.Perm (Fin m)) * p.1))⁻¹ = p.2
      rw [hr, mul_inv_cancel_right]
    · intro π _
      dsimp only
      rw [inv_mul_cancel_right]

  have hcount : Trat.card * Nat.card H =
      Nat.card {π : Equiv.Perm (Fin m) // ∃ h ∈ H, π * σ * π⁻¹ = h * ρ} := by
    have hrat_rep : ∀ π : Equiv.Perm (Fin m), (∃ h ∈ H, π * σ * π⁻¹ = h * ρ) → rep π ∈ Trat := by
      intro π hπ
      refine (hTrat _).2 ⟨hrepT π, ?_⟩
      have := hratmul π _ (H.inv_mem (hrep1 π)) hπ
      rwa [show (π * (rep π)⁻¹)⁻¹ * π = rep π by group] at this
    have e : {π : Equiv.Perm (Fin m) // ∃ h ∈ H, π * σ * π⁻¹ = h * ρ} ≃ (↥Trat × ↥H) :=
      { toFun := fun π => (⟨rep π.1, hrat_rep π.1 π.2⟩, ⟨π.1 * (rep π.1)⁻¹, hrep1 π.1⟩)
        invFun := fun p => ⟨(p.2 : Equiv.Perm (Fin m)) * p.1,
          hratmul p.1 p.2 p.2.2 ((hTrat _).1 p.1.2).2⟩
        left_inv := fun π => Subtype.ext (inv_mul_cancel_right _ _)
        right_inv := fun p => by
          have hr : rep ((p.2 : Equiv.Perm (Fin m)) * p.1) = p.1 :=
            hrepmul p.1 ((hTrat _).1 p.1.2).1 p.2 p.2.2
          refine Prod.ext (Subtype.ext hr) (Subtype.ext ?_)
          show (p.2 : Equiv.Perm (Fin m)) * p.1 *
            (rep ((p.2 : Equiv.Perm (Fin m)) * p.1))⁻¹ = p.2
          rw [hr, mul_inv_cancel_right] }
    rw [Nat.card_congr e, Nat.card_prod, Nat.card_eq_finsetCard]

  have hratfix : ∀ r ∈ Trat, MvPolynomial.map (lwtrFrob K) (Pf r) = Pf r := by
    intro r hr
    obtain ⟨-, h, hh, he⟩ := (hTrat r).1 hr
    rw [htr]
    have hρ' : ρ = h⁻¹ * (r * σ * r⁻¹) := by
      rw [he]; group
    have : ρ * r * σ⁻¹ = h⁻¹ * r := by
      rw [hρ']; group
    rw [this, hinvPf r h⁻¹ (H.inv_mem hh)]
  have hex : ∀ r : ↥Trat, ∃ P₀ : MvPolynomial (Fin 2) K,
      MvPolynomial.map (algebraMap K (AlgebraicClosure K)) P₀ = Pf r ∧
        P₀.totalDegree = (Pf r).totalDegree := fun r => hdesc _ (hratfix r.1 r.2)
  choose Pr hPr using hex
  have hR0 : R ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hR
    refine absurd hR (Polynomial.Monic.ne_zero ?_).symm
    exact Polynomial.monic_prod_of_monic _ _ fun π _ => Polynomial.monic_X_sub_C _
  refine ⟨Trat.card, fun i => Pr (Trat.equivFin.symm i), T, hcount, ?_, hRT, ?_⟩
  · intro i
    refine ⟨?_, ?_⟩
    · rw [(hPr _).2]
      exact MvPolynomial.totalDegree_le_of_dvd_of_isDomain (hPf _).2.1 hR0
    · rw [(hPr _).1]
      exact (hPf _).1
  · intro π hπ
    by_cases hrat : π ∈ Trat
    · left
      refine ⟨Trat.equivFin ⟨π, hrat⟩, ?_⟩
      simp only [Equiv.symm_apply_apply]
      exact ((hPr ⟨π, hrat⟩).1).symm
    · right
      refine ⟨rep (ρ * π * σ⁻¹), hrepT _, ?_, ?_⟩
      · intro heq
        apply hrat
        have h1 := hrep1 (ρ * π * σ⁻¹)
        rw [heq] at h1
        exact (hTrat π).2 ⟨hπ, _, H.inv_mem h1, by group⟩
      · rw [htr]
        have h2 := hinvPf (rep (ρ * π * σ⁻¹)) _ (hrep1 (ρ * π * σ⁻¹))
        rwa [inv_mul_cancel_right] at h2

theorem lw_good_fibre_split (K : Type u) [Field K] (k : ℕ) (g : MvPolynomial (Fin 2) K)
    (hdeg : g.totalDegree = k + 1) (hmon : g.coeff (Finsupp.single 1 (k + 1)) = 1)
    (c : Fin (k + 1) → AlgebraicClosure K) (d : Polynomial (AlgebraicClosure K))
    (hd : ∀ (e : AlgebraicClosure K) (y : Fin (k + 1) → AlgebraicClosure K),
      MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g =
          ∏ i, (Polynomial.X - Polynomial.C (y i)) →
        Polynomial.aeval e d =
          ∏ p ∈ (Finset.univ : Finset (Equiv.Perm (Fin (k + 1)))).offDiag,
            ((∑ i, c i * y (p.1 i)) - ∑ i, c i * y (p.2 i)))
    (u₀ : K) (hu₀ : Polynomial.aeval (algebraMap K (AlgebraicClosure K) u₀) d ≠ 0) :
    ∃ S : Finset (AlgebraicClosure K), S.card = k + 1 ∧
      ∀ s, MvPolynomial.aeval ![algebraMap K (AlgebraicClosure K) u₀, s] g = 0 ↔ s ∈ S :=
by
  classical

  have hfib : ∀ e : AlgebraicClosure K,
      (MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g).Monic ∧
      (MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g).natDegree = k + 1 := by
    intro e
    have hexp : MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g =
        ∑ s ∈ g.support, Polynomial.C (algebraMap K (AlgebraicClosure K) (g.coeff s) * e ^ (s 0)) *
          Polynomial.X ^ (s 1) := by
      conv_lhs => rw [g.as_sum]
      rw [map_sum]
      refine Finset.sum_congr rfl fun s _ => ?_
      rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (by simp), Fin.prod_univ_two]
      simp [Polynomial.algebraMap_apply, Polynomial.C_mul, Polynomial.C_pow]
      ring
    have hsupp : ∀ s ∈ g.support, s 0 + s 1 ≤ k + 1 := by
      intro s hs
      have := MvPolynomial.le_totalDegree hs
      rw [hdeg, Finsupp.sum_fintype _ _ (by simp), Fin.sum_univ_two] at this
      exact this
    have hle : (MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g).natDegree ≤ k + 1 := by
      rw [hexp]
      apply Polynomial.natDegree_sum_le_of_forall_le
      intro s hs
      refine (Polynomial.natDegree_C_mul_X_pow_le _ _).trans ?_
      have := hsupp s hs
      omega
    have hcoeff : (MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g).coeff (k + 1) = 1 := by
      rw [hexp, Polynomial.finset_sum_coeff]
      simp only [Polynomial.coeff_C_mul_X_pow]
      rw [Finset.sum_eq_single (Finsupp.single 1 (k + 1))]
      · rw [hmon]
        simp
      · intro s hs hne
        rw [if_neg]
        intro h
        apply hne
        have := hsupp s hs
        ext i
        fin_cases i <;> simp [Finsupp.single_apply] <;> omega
      · intro h
        exfalso
        apply h
        rw [MvPolynomial.mem_support_iff, hmon]
        exact one_ne_zero
    exact ⟨Polynomial.monic_of_natDegree_le_of_coeff_eq_one _ hle hcoeff,
      Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hle (by rw [hcoeff]; exact one_ne_zero)⟩

  have hev : ∀ a s : AlgebraicClosure K, MvPolynomial.aeval ![a, s] g =
      (MvPolynomial.aeval ![Polynomial.C a, Polynomial.X] g).eval s := by
    intro a s
    have h : ((Polynomial.aeval s).restrictScalars K).comp
        (MvPolynomial.aeval ![Polynomial.C a, Polynomial.X]) =
        MvPolynomial.aeval (R := K) ![a, s] := by
      apply MvPolynomial.algHom_ext
      intro i
      fin_cases i <;> simp
    rw [← h]
    simp [Polynomial.coe_aeval_eq_eval]
  set e := algebraMap K (AlgebraicClosure K) u₀ with he
  obtain ⟨hmonic, hnat⟩ := hfib e
  set f := MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g with hf
  have hroots : f.roots.card = k + 1 := by
    rw [← hnat]
    exact Polynomial.splits_iff_card_roots.mp (IsAlgClosed.splits f)
  set l := f.roots.toList with hl
  have hlen : l.length = k + 1 := by rw [hl, Multiset.length_toList, hroots]
  let y : Fin (k + 1) → AlgebraicClosure K := fun i => l.get (Fin.cast hlen.symm i)
  have hfy : f = ∏ i, (Polynomial.X - Polynomial.C (y i)) := by
    have h1 : ∏ i, (Polynomial.X - Polynomial.C (y i)) =
        ∏ j : Fin l.length, (Polynomial.X - Polynomial.C (l.get j)) :=
      Fintype.prod_equiv (finCongr hlen.symm) _ _ (fun i => rfl)
    rw [h1, ← List.prod_ofFn]
    have h2 : List.ofFn (fun j : Fin l.length => Polynomial.X - Polynomial.C (l.get j)) =
        l.map (fun a => Polynomial.X - Polynomial.C a) := by
      apply List.ext_get <;> simp
    rw [h2, ← Multiset.prod_coe, ← Multiset.map_coe, hl, Multiset.coe_toList]
    exact (Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hmonic
      (by rw [hroots, hnat])).symm
  have hdy := hd e y hfy
  have hne : ∏ p ∈ (Finset.univ : Finset (Equiv.Perm (Fin (k + 1)))).offDiag,
      ((∑ i, c i * y (p.1 i)) - ∑ i, c i * y (p.2 i)) ≠ 0 := by
    rw [← hdy]
    exact hu₀
  have hinj : Function.Injective y := by
    intro i j hij
    by_contra hij'
    apply hne
    apply Finset.prod_eq_zero (i := (Equiv.swap i j, 1))
    · rw [Finset.mem_offDiag]
      refine ⟨Finset.mem_univ _, Finset.mem_univ _, ?_⟩
      intro h
      have := congrArg (fun π : Equiv.Perm (Fin (k + 1)) => π i) h
      simp only [Equiv.swap_apply_left, Equiv.Perm.one_apply] at this
      exact hij' this.symm
    · rw [sub_eq_zero]
      refine Finset.sum_congr rfl fun m _ => ?_
      congr 1
      simp only [Equiv.Perm.one_apply]
      rcases eq_or_ne m i with rfl | hmi
      · rw [Equiv.swap_apply_left, hij]
      · rcases eq_or_ne m j with rfl | hmj
        · rw [Equiv.swap_apply_right, hij]
        · rw [Equiv.swap_apply_of_ne_of_ne hmi hmj]
  refine ⟨Finset.univ.image y, ?_, ?_⟩
  · rw [Finset.card_image_of_injective _ hinj, Finset.card_univ, Fintype.card_fin]
  · intro s
    rw [hev, ← hf, hfy, Polynomial.eval_prod, Finset.prod_eq_zero_iff]
    simp only [Finset.mem_univ, true_and, Finset.mem_image, Polynomial.eval_sub,
      Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero]
    exact ⟨fun ⟨i, h⟩ => ⟨i, h.symm⟩, fun ⟨i, h⟩ => ⟨i, h.symm⟩⟩

theorem lw_fibre_twist_bound (K : Type u) [Field K] [Fintype K] (k : ℕ)
    (g : MvPolynomial (Fin 2) K) (hdeg : g.totalDegree = k + 1)
    (hmon : g.coeff (Finsupp.single 1 (k + 1)) = 1) (σ : Equiv.Perm (Fin (k + 1)))
    (c : Fin (k + 1) → AlgebraicClosure K) (hc : ∀ i, c i ^ Nat.card K = c (σ i))
    (R : MvPolynomial (Fin 2) (AlgebraicClosure K)) (d : Polynomial (AlgebraicClosure K))
    (hspec : ∀ (e : AlgebraicClosure K) (y : Fin (k + 1) → AlgebraicClosure K),
      MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g =
          ∏ i, (Polynomial.X - Polynomial.C (y i)) →
        MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] R = ∏ π : Equiv.Perm (Fin (k + 1)),
            (Polynomial.X - Polynomial.C (∑ i, c i * y (π i))) ∧
          Polynomial.aeval e d =
            ∏ p ∈ (Finset.univ : Finset (Equiv.Perm (Fin (k + 1)))).offDiag,
              ((∑ i, c i * y (p.1 i)) - ∑ i, c i * y (p.2 i)))
    (n : ℕ) (P : Fin n → MvPolynomial (Fin 2) K) (T : Finset (Equiv.Perm (Fin (k + 1))))
    (Q : Equiv.Perm (Fin (k + 1)) → MvPolynomial (Fin 2) (AlgebraicClosure K))
    (hRT : R = ∏ π ∈ T, Q π)
    (hQ : ∀ π ∈ T, (∃ i, Q π = MvPolynomial.map (algebraMap K (AlgebraicClosure K)) (P i)) ∨
      (∃ π' ∈ T, π' ≠ π ∧ MvPolynomial.map (lwtrFrob K) (Q π) = Q π')) :
    (∀ u₀ : K, Polynomial.aeval (algebraMap K (AlgebraicClosure K) u₀) d ≠ 0 →
      lwTwistCount K k g σ u₀ ≤
        ∑ i, Nat.card {t : K // MvPolynomial.eval ![u₀, t] (P i) = 0}) ∧
    ∀ u₀ : K, lwTwistCount K k g σ u₀ ≤ (k + 1) ^ (k + 1) :=
by
  classical

  have hfib : ∀ e : AlgebraicClosure K,
      (MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g).Monic ∧
      (MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g).natDegree = k + 1 := by
    intro e
    have hexp : MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g =
        ∑ s ∈ g.support, Polynomial.C (algebraMap K (AlgebraicClosure K) (g.coeff s) * e ^ (s 0)) *
          Polynomial.X ^ (s 1) := by
      conv_lhs => rw [g.as_sum]
      rw [map_sum]
      refine Finset.sum_congr rfl fun s _ => ?_
      rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (by simp), Fin.prod_univ_two]
      simp [Polynomial.algebraMap_apply, Polynomial.C_mul, Polynomial.C_pow]
      ring
    have hsupp : ∀ s ∈ g.support, s 0 + s 1 ≤ k + 1 := by
      intro s hs
      have := MvPolynomial.le_totalDegree hs
      rw [hdeg, Finsupp.sum_fintype _ _ (by simp), Fin.sum_univ_two] at this
      exact this
    have hle : (MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g).natDegree ≤ k + 1 := by
      rw [hexp]
      apply Polynomial.natDegree_sum_le_of_forall_le
      intro s hs
      refine (Polynomial.natDegree_C_mul_X_pow_le _ _).trans ?_
      have := hsupp s hs
      omega
    have hcoeff : (MvPolynomial.aeval ![Polynomial.C e, Polynomial.X] g).coeff (k + 1) = 1 := by
      rw [hexp, Polynomial.finset_sum_coeff]
      simp only [Polynomial.coeff_C_mul_X_pow]
      rw [Finset.sum_eq_single (Finsupp.single 1 (k + 1))]
      · rw [hmon]
        simp
      · intro s hs hne
        rw [if_neg]
        intro h
        apply hne
        have := hsupp s hs
        ext i
        fin_cases i <;> simp [Finsupp.single_apply] <;> omega
      · intro h
        exfalso
        apply h
        rw [MvPolynomial.mem_support_iff, hmon]
        exact one_ne_zero
    exact ⟨Polynomial.monic_of_natDegree_le_of_coeff_eq_one _ hle hcoeff,
      Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hle (by rw [hcoeff]; exact one_ne_zero)⟩

  have hevK : ∀ (f : MvPolynomial (Fin 2) K) (a s : AlgebraicClosure K),
      MvPolynomial.aeval ![a, s] f =
        (MvPolynomial.aeval ![Polynomial.C a, Polynomial.X] f).eval s := by
    intro f a s
    have h : ((Polynomial.aeval s).restrictScalars K).comp
        (MvPolynomial.aeval ![Polynomial.C a, Polynomial.X]) =
        MvPolynomial.aeval (R := K) ![a, s] := by
      apply MvPolynomial.algHom_ext
      intro i
      fin_cases i <;> simp
    rw [← h]
    simp [Polynomial.coe_aeval_eq_eval]
  have hevL : ∀ (f : MvPolynomial (Fin 2) (AlgebraicClosure K)) (a s : AlgebraicClosure K),
      MvPolynomial.eval ![a, s] f =
        (MvPolynomial.aeval ![Polynomial.C a, Polynomial.X] f).eval s := by
    intro f a s
    have h : (Polynomial.aeval s).comp
        (MvPolynomial.aeval (R := AlgebraicClosure K) ![Polynomial.C a, Polynomial.X]) =
        MvPolynomial.aeval (R := AlgebraicClosure K) ![a, s] := by
      apply MvPolynomial.algHom_ext
      intro i
      fin_cases i <;> simp
    rw [← MvPolynomial.coe_aeval_eq_eval, ← h]
    simp [Polynomial.coe_aeval_eq_eval]

  have hq : Nat.card K = Fintype.card K := Nat.card_eq_fintype_card
  have hFr : ∀ a : AlgebraicClosure K, lwtrFrob K a = a ^ Nat.card K := by
    intro a
    rw [hq]
    exact FiniteField.frobeniusAlgEquivOfAlgebraic_apply K (AlgebraicClosure K) a
  have hFrι : ∀ b : K, lwtrFrob K (algebraMap K (AlgebraicClosure K) b) =
      algebraMap K (AlgebraicClosure K) b := fun b =>
    (FiniteField.frobeniusAlgEquivOfAlgebraic K (AlgebraicClosure K)).commutes b

  have hdesc : ∀ a : AlgebraicClosure K, a ^ Nat.card K = a →
      ∃ b : K, algebraMap K (AlgebraicClosure K) b = a := by
    intro a ha
    have hq1 : 1 < Fintype.card K := Fintype.one_lt_card
    obtain ⟨f, hf⟩ : ∃ f : Polynomial (AlgebraicClosure K),
        f = Polynomial.X ^ Fintype.card K - Polynomial.X := ⟨_, rfl⟩
    have hfdeg : f.natDegree = Fintype.card K := by
      rw [hf]; exact FiniteField.X_pow_card_sub_X_natDegree_eq _ hq1
    have hf0 : f ≠ 0 := by
      intro h; rw [h, Polynomial.natDegree_zero] at hfdeg; omega
    have hsub : Finset.univ.image (algebraMap K (AlgebraicClosure K)) ⊆ f.roots.toFinset := by
      intro x hx
      obtain ⟨b, -, rfl⟩ := Finset.mem_image.mp hx
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hf0, Polynomial.IsRoot.def, hf,
        Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, ← map_pow,
        FiniteField.pow_card, sub_self]
    have hcard : f.roots.toFinset.card ≤
        (Finset.univ.image (algebraMap K (AlgebraicClosure K))).card := by
      rw [Finset.card_image_of_injective _ (algebraMap K (AlgebraicClosure K)).injective,
        Finset.card_univ]
      calc f.roots.toFinset.card ≤ f.roots.card := Multiset.toFinset_card_le _
        _ ≤ f.natDegree := Polynomial.card_roots' f
        _ = _ := hfdeg
    have heq := Finset.eq_of_subset_of_card_le hsub hcard
    have ha' : a ∈ f.roots.toFinset := by
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hf0, Polynomial.IsRoot.def, hf,
        Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, ← hq, ha, sub_self]
    rw [← heq] at ha'
    obtain ⟨b, -, hb⟩ := Finset.mem_image.mp ha'
    exact ⟨b, hb⟩

  have htwist : ∀ r : Fin (k + 1) → AlgebraicClosure K, (∀ i, r i ^ Nat.card K = r (σ i)) →
      (∑ i, c i * r i) ^ Nat.card K = ∑ i, c i * r i := by
    intro r hr
    rw [← hFr (∑ i, c i * r i), map_sum]
    simp only [hFr, mul_pow, hc, hr]
    exact Equiv.sum_comp σ (fun j => c j * r j)

  have hFrEval : ∀ (u₀ t₀ : K) (Q' : MvPolynomial (Fin 2) (AlgebraicClosure K)),
      MvPolynomial.eval ![algebraMap K (AlgebraicClosure K) u₀,
          algebraMap K (AlgebraicClosure K) t₀] (MvPolynomial.map (lwtrFrob K) Q') =
        lwtrFrob K (MvPolynomial.eval ![algebraMap K (AlgebraicClosure K) u₀,
          algebraMap K (AlgebraicClosure K) t₀] Q') := by
    intro u₀ t₀ Q'
    rw [MvPolynomial.eval_map]
    show _ = lwtrFrob K (MvPolynomial.eval₂ (RingHom.id _) _ Q')
    rw [MvPolynomial.eval₂_comp_left, RingHom.comp_id]
    congr 1
    funext j
    fin_cases j
    · exact (hFrι u₀).symm
    · exact (hFrι t₀).symm
  have hιEval : ∀ (u₀ t₀ : K) (P' : MvPolynomial (Fin 2) K),
      MvPolynomial.eval ![algebraMap K (AlgebraicClosure K) u₀,
          algebraMap K (AlgebraicClosure K) t₀]
          (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) P') =
        algebraMap K (AlgebraicClosure K) (MvPolynomial.eval ![u₀, t₀] P') := by
    intro u₀ t₀ P'
    rw [MvPolynomial.eval_map]
    show _ = algebraMap K (AlgebraicClosure K) (MvPolynomial.eval₂ (RingHom.id K) _ P')
    rw [MvPolynomial.eval₂_comp_left, RingHom.comp_id]
    congr 1
    funext j
    fin_cases j <;> rfl

  have hcrux : ∀ u₀ t₀ : K,
      (∏ π ∈ T, MvPolynomial.aeval
        ![Polynomial.C (algebraMap K (AlgebraicClosure K) u₀), Polynomial.X] (Q π)).Separable →
      Polynomial.eval (algebraMap K (AlgebraicClosure K) t₀)
        (∏ π ∈ T, MvPolynomial.aeval
          ![Polynomial.C (algebraMap K (AlgebraicClosure K) u₀), Polynomial.X] (Q π)) = 0 →
      ∃ i, MvPolynomial.eval ![u₀, t₀] (P i) = 0 := by
    intro u₀ t₀ hsep hroot
    rw [Polynomial.eval_prod, Finset.prod_eq_zero_iff] at hroot
    obtain ⟨π₀, hπ₀T, hπ₀⟩ := hroot
    have h1 : MvPolynomial.eval ![algebraMap K (AlgebraicClosure K) u₀,
        algebraMap K (AlgebraicClosure K) t₀] (Q π₀) = 0 := by
      rw [hevL]; exact hπ₀
    rcases hQ π₀ hπ₀T with ⟨i, hi⟩ | ⟨π', hπ'T, hne, hmap⟩
    · refine ⟨i, ?_⟩
      rw [hi, hιEval] at h1
      exact (map_eq_zero_iff _ (algebraMap K (AlgebraicClosure K)).injective).mp h1
    · exfalso
      have h2 : Polynomial.eval (algebraMap K (AlgebraicClosure K) t₀)
          (MvPolynomial.aeval ![Polynomial.C (algebraMap K (AlgebraicClosure K) u₀),
            Polynomial.X] (Q π')) = 0 := by
        rw [← hevL, ← hmap, hFrEval, h1, map_zero]
      have hsub : ({π₀, π'} : Finset (Equiv.Perm (Fin (k + 1)))) ⊆ T := by
        intro x hx
        rw [Finset.mem_insert, Finset.mem_singleton] at hx
        rcases hx with rfl | rfl
        · exact hπ₀T
        · exact hπ'T
      have hdvd : (Polynomial.X - Polynomial.C (algebraMap K (AlgebraicClosure K) t₀)) *
          (Polynomial.X - Polynomial.C (algebraMap K (AlgebraicClosure K) t₀)) ∣
          ∏ π ∈ T, MvPolynomial.aeval
            ![Polynomial.C (algebraMap K (AlgebraicClosure K) u₀), Polynomial.X] (Q π) := by
        refine dvd_trans ?_ (Finset.prod_dvd_prod_of_subset _ _ _ hsub)
        rw [Finset.prod_pair hne.symm]
        exact mul_dvd_mul (Polynomial.dvd_iff_isRoot.mpr hπ₀) (Polynomial.dvd_iff_isRoot.mpr h2)
      exact Polynomial.not_isUnit_X_sub_C _ (hsep.squarefree _ hdvd)
  refine ⟨?_, ?_⟩
  ·
    intro u₀ hd

    have hsplit : ∀ r : Fin (k + 1) → AlgebraicClosure K, Function.Injective r →
        (∀ i, MvPolynomial.aeval ![algebraMap K (AlgebraicClosure K) u₀, r i] g = 0) →
        MvPolynomial.aeval ![Polynomial.C (algebraMap K (AlgebraicClosure K) u₀), Polynomial.X] g =
          ∏ i, (Polynomial.X - Polynomial.C (r i)) := by
      intro r hr hroot
      obtain ⟨hmonic, hnat⟩ := hfib (algebraMap K (AlgebraicClosure K) u₀)
      have hne0 := hmonic.ne_zero
      have hsub : (Finset.univ.val.map r) ≤ (MvPolynomial.aeval
          ![Polynomial.C (algebraMap K (AlgebraicClosure K) u₀), Polynomial.X] g).roots := by
        rw [Multiset.le_iff_subset (Multiset.Nodup.map hr Finset.univ.nodup)]
        intro x hx
        obtain ⟨i, -, rfl⟩ := Multiset.mem_map.mp hx
        rw [Polynomial.mem_roots hne0, Polynomial.IsRoot.def, ← hevK]
        exact hroot i
      have hcard : (MvPolynomial.aeval
          ![Polynomial.C (algebraMap K (AlgebraicClosure K) u₀), Polynomial.X] g).roots.card ≤
          (Finset.univ.val.map r).card := by
        rw [Multiset.card_map, Finset.card_val, Finset.card_univ, Fintype.card_fin, ← hnat]
        exact Polynomial.card_roots' _
      have heq := Multiset.eq_of_le_of_card_le hsub hcard
      have hprod := Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hmonic
        (by rw [← heq, Multiset.card_map, Finset.card_val, Finset.card_univ, Fintype.card_fin,
          hnat])
      rw [← hprod, ← heq, Multiset.map_map]
      rfl

    have hθinj : ∀ r : Fin (k + 1) → AlgebraicClosure K, Function.Injective r →
        (∀ i, MvPolynomial.aeval ![algebraMap K (AlgebraicClosure K) u₀, r i] g = 0) →
        Function.Injective (fun π : Equiv.Perm (Fin (k + 1)) => ∑ i, c i * r (π i)) := by
      intro r hr hroot π π' hππ'
      by_contra hne
      apply hd
      rw [(hspec _ r (hsplit r hr hroot)).2]
      exact Finset.prod_eq_zero (i := (π, π'))
        (Finset.mem_offDiag.mpr ⟨Finset.mem_univ _, Finset.mem_univ _, hne⟩)
        (sub_eq_zero.mpr hππ')

    have hgood : ∀ r : {r : Fin (k + 1) → AlgebraicClosure K // Function.Injective r ∧
        (∀ i, MvPolynomial.aeval ![algebraMap K (AlgebraicClosure K) u₀, r i] g = 0) ∧
        ∀ i, r i ^ Nat.card K = r (σ i)}, ∃ (i : Fin n) (t₀ : K),
          algebraMap K (AlgebraicClosure K) t₀ = ∑ j, c j * r.1 j ∧
          MvPolynomial.eval ![u₀, t₀] (P i) = 0 := by
      rintro ⟨r, hr, hroot, htw⟩
      obtain ⟨t₀, ht₀⟩ := hdesc _ (htwist r htw)
      have hR := (hspec _ r (hsplit r hr hroot)).1
      rw [hRT, map_prod] at hR
      obtain ⟨i, hi⟩ := hcrux u₀ t₀
        (by rw [hR]; exact Polynomial.separable_prod_X_sub_C_iff.mpr (hθinj r hr hroot))
        (by
          rw [hR, Polynomial.eval_prod]
          apply Finset.prod_eq_zero (Finset.mem_univ 1)
          rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, ht₀]
          simp only [Equiv.Perm.one_apply, sub_self])
      exact ⟨i, t₀, ht₀, hi⟩
    choose fi ft hft hfP using hgood
    let Ψ := fun r => (⟨fi r, ft r, hfP r⟩ :
      Σ i : Fin n, {t : K // MvPolynomial.eval ![u₀, t] (P i) = 0})

    have hΨ : Function.Injective Ψ := by
      rintro ⟨r, hr, hroot, htw⟩ ⟨r', hr', hroot', htw'⟩ h
      have h1 : ft ⟨r, hr, hroot, htw⟩ = ft ⟨r', hr', hroot', htw'⟩ :=
        congrArg (fun x : (Σ i : Fin n, {t : K // MvPolynomial.eval ![u₀, t] (P i) = 0}) =>
          x.2.1) h
      have hsum : ∑ j, c j * r' j = ∑ j, c j * r j :=
        (hft ⟨r', hr', hroot', htw'⟩).symm.trans
          ((congrArg (algebraMap K (AlgebraicClosure K)) h1).symm.trans
            (hft ⟨r, hr, hroot, htw⟩))
      have hg := hsplit r hr hroot
      have hrange : ∀ j, ∃ i, r' j = r i := by
        intro j
        have h0 := hroot' j
        rw [hevK, hg, Polynomial.eval_prod, Finset.prod_eq_zero_iff] at h0
        obtain ⟨i, -, hi⟩ := h0
        rw [Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_eq_zero] at hi
        exact ⟨i, hi⟩
      choose fj hfj using hrange
      have hfinj : Function.Injective fj := by
        intro a b hab
        apply hr'
        rw [hfj a, hfj b, hab]
      have hfbij := Finite.injective_iff_bijective.mp hfinj
      have hπ : Equiv.ofBijective fj hfbij = 1 := by
        apply hθinj r hr hroot
        simp only [Equiv.ofBijective_apply, Equiv.Perm.one_apply]
        rw [← hsum]
        exact Finset.sum_congr rfl fun j _ => by rw [hfj j]
      have hrr : r = r' := by
        funext j
        rw [hfj j]
        have := congrArg (fun π : Equiv.Perm (Fin (k + 1)) => π j) hπ
        simp only [Equiv.ofBijective_apply, Equiv.Perm.one_apply] at this
        rw [this]
      subst hrr
      rfl
    unfold lwTwistCount
    exact (Nat.card_le_card_of_injective Ψ hΨ).trans (le_of_eq Nat.card_sigma)
  ·
    intro u₀
    obtain ⟨hmonic, hnat⟩ := hfib (algebraMap K (AlgebraicClosure K) u₀)
    obtain ⟨fe, hfe⟩ : ∃ fe : Polynomial (AlgebraicClosure K), fe = MvPolynomial.aeval
        ![Polynomial.C (algebraMap K (AlgebraicClosure K) u₀), Polynomial.X] g := ⟨_, rfl⟩
    rw [← hfe] at hmonic hnat
    have hfe0 : fe ≠ 0 := hmonic.ne_zero
    have hZ : fe.roots.toFinset.card ≤ k + 1 :=
      (Multiset.toFinset_card_le _).trans ((Polynomial.card_roots' fe).trans hnat.le)
    let Φ : {r : Fin (k + 1) → AlgebraicClosure K // Function.Injective r ∧
        (∀ i, MvPolynomial.aeval ![algebraMap K (AlgebraicClosure K) u₀, r i] g = 0) ∧
        ∀ i, r i ^ Nat.card K = r (σ i)} → (Fin (k + 1) → fe.roots.toFinset) :=
      fun r i => ⟨r.1 i, by
        rw [Multiset.mem_toFinset, Polynomial.mem_roots hfe0, Polynomial.IsRoot.def, hfe,
          ← hevK]
        exact r.2.2.1 i⟩
    have hΦ : Function.Injective Φ := by
      intro a b h
      apply Subtype.ext
      funext i
      exact congrArg Subtype.val (congrFun h i)
    unfold lwTwistCount
    calc _ ≤ Nat.card (Fin (k + 1) → fe.roots.toFinset) := Nat.card_le_card_of_injective Φ hΦ
      _ = fe.roots.toFinset.card ^ (k + 1) := by
        rw [Nat.card_fun, Nat.card_eq_fintype_card, Fintype.card_coe, Nat.card_eq_fintype_card,
          Fintype.card_fin]
      _ ≤ (k + 1) ^ (k + 1) := Nat.pow_le_pow_left hZ _

theorem lw_twisted_resolvent_galois (D : ℕ) :
    ∃ B : ℕ, ∀ (K : Type u) [Field K] [Fintype K] (k : ℕ) (g : MvPolynomial (Fin 2) K),
      k + 1 ≤ D → g.totalDegree = k + 1 → g.coeff (Finsupp.single 1 (k + 1)) = 1 →
      MvPolynomial.pderiv 1 g ≠ 0 →
      Irreducible (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g) →
      B ≤ Nat.card K →
      Nat.card {u₀ : K // ¬ ∃ S : Finset (AlgebraicClosure K), S.card = k + 1 ∧
          ∀ s, MvPolynomial.aeval ![algebraMap K (AlgebraicClosure K) u₀, s] g = 0 ↔ s ∈ S} ≤ B ∧
      ∃ (H : Subgroup (Equiv.Perm (Fin (k + 1)))) (ρ : Equiv.Perm (Fin (k + 1))),
        (∀ i j : Fin (k + 1), ∃ h ∈ H, h i = j) ∧
        ∀ σ : Equiv.Perm (Fin (k + 1)), ∃ (n : ℕ) (P : Fin n → MvPolynomial (Fin 2) K),
          n * Nat.card H =
            Nat.card {π : Equiv.Perm (Fin (k + 1)) // ∃ h ∈ H, π * σ * π⁻¹ = h * ρ} ∧
          (∀ j, (P j).totalDegree ≤ D.factorial ∧
            Irreducible (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) (P j))) ∧
          ∑ u₀ : K, lwTwistCount K k g σ u₀ ≤
            ∑ j, Nat.card {z : Fin 2 → K // MvPolynomial.eval z (P j) = 0} + B :=
by
  classical
  refine ⟨D.factorial ^ 2 * D ^ D + 1, ?_⟩
  intro K _ _ k g hkD hdeg hmon hsep hirr hB

  have hD1 : 1 ≤ D := by omega
  have hN : (k + 1).factorial ≤ D.factorial := Nat.factorial_le hkD
  have hmm : (k + 1) ^ (k + 1) ≤ D ^ D :=
    le_trans (Nat.pow_le_pow_left hkD _) (Nat.pow_le_pow_right hD1 hkD)
  have hDD : 0 < D ^ D := pow_pos (by omega) D
  have hN2 : (k + 1).factorial ^ 2 ≤ D.factorial ^ 2 := Nat.pow_le_pow_left hN 2
  have h1 : D.factorial ^ 2 ≤ D.factorial ^ 2 * D ^ D := Nat.le_mul_of_pos_right _ hDD
  have hN2B : (k + 1).factorial ^ 2 ≤ D.factorial ^ 2 * D ^ D + 1 :=
    le_trans hN2 (le_trans h1 (Nat.le_succ _))
  have hN2mB : (k + 1).factorial ^ 2 * (k + 1) ^ (k + 1) ≤ D.factorial ^ 2 * D ^ D + 1 :=
    le_trans (Nat.mul_le_mul hN2 hmm) (Nat.le_succ _)
  have hq : (k + 1).factorial ^ 2 ≤ Nat.card K := le_trans hN2B hB

  have hroot : ∀ d : Polynomial (AlgebraicClosure K), d ≠ 0 →
      (Finset.univ.filter (fun u₀ : K =>
        Polynomial.aeval (algebraMap K (AlgebraicClosure K) u₀) d = 0)).card ≤ d.natDegree := by
    intro d hd
    calc _ ≤ d.roots.toFinset.card := by
          apply Finset.card_le_card_of_injOn (fun u₀ => algebraMap K (AlgebraicClosure K) u₀)
          · intro u₀ hu₀
            simp only [Finset.coe_filter, Finset.mem_filter, Finset.mem_univ, true_and,
              Set.mem_setOf_eq] at hu₀
            simp only [Finset.mem_coe, Multiset.mem_toFinset]
            rw [Polynomial.mem_roots hd, Polynomial.IsRoot.def]
            simpa [Polynomial.coe_aeval_eq_eval] using hu₀
          · intro a _ b _ hab
            exact (algebraMap K (AlgebraicClosure K)).injective hab
      _ ≤ d.roots.card := Multiset.toFinset_card_le _
      _ ≤ d.natDegree := Polynomial.card_roots' d

  obtain ⟨x, H, ρ, Φ, hev, hxinj, hxint, hxg, hHt, hρ, hH1, hH2, hΦx, hΦev, hΦc⟩ :=
    lw_generic_galois_setup K k g hdeg hmon hsep hirr
  refine ⟨?_, H, ρ, hHt, ?_⟩
  ·
    obtain ⟨c₁, R₁, d₁, -, -, -, hd₁deg, hd₁0, -, hspec₁⟩ :=
      lw_sigma_resolvent K k g hdeg hmon x hxinj hxg hq 1
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
    refine le_trans (Finset.card_le_card ?_) (le_trans (hroot d₁ hd₁0) (le_trans hd₁deg hN2B))
    intro u₀ hu₀
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hu₀ ⊢
    by_contra hne
    exact hu₀ (lw_good_fibre_split K k g hdeg hmon c₁ d₁ (fun e y hy => (hspec₁ e y hy).2) u₀ hne)
  ·
    intro σ
    obtain ⟨c, R, d, hc, hθ, hRdeg, hddeg, hd0, hR, hspec⟩ :=
      lw_sigma_resolvent K k g hdeg hmon x hxinj hxg hq σ
    have hPf0 := fun π : Equiv.Perm (Fin (k + 1)) =>
      lw_orbit_minpoly (AlgebraicClosure K) (k + 1) H x hxint hH1 hH2 c hθ R hR π
    choose Pf hPf using hPf0
    obtain ⟨n, P, T, hn, hP, hRT, hdich⟩ :=
      lw_frobenius_descent K (k + 1) hev Φ hΦev hΦc H ρ hρ x hΦx σ c hc hθ R hR Pf hPf
    refine ⟨n, P, hn, fun j => ⟨le_trans (hP j).1 (le_trans hRdeg hN), (hP j).2⟩, ?_⟩
    obtain ⟨hgood, hall⟩ :=
      lw_fibre_twist_bound K k g hdeg hmon σ c hc R d hspec n P T Pf hRT hdich
    have hfib : ∀ j, Nat.card {z : Fin 2 → K // MvPolynomial.eval z (P j) = 0} =
        ∑ u₀ : K, Nat.card {t : K // MvPolynomial.eval ![u₀, t] (P j) = 0} := by
      intro j
      have key : ∀ z : Fin 2 → K, ![z 0, z 1] = z := by
        intro z; ext i; fin_cases i <;> rfl
      rw [← Nat.card_sigma (β := fun u₀ : K => {t : K // MvPolynomial.eval ![u₀, t] (P j) = 0})]
      exact Nat.card_congr
        { toFun := fun z => ⟨z.1 0, z.1 1, by rw [key z.1]; exact z.2⟩
          invFun := fun p => ⟨![p.1, p.2.1], p.2.2⟩
          left_inv := fun z => Subtype.ext (key z.1)
          right_inv := fun p => rfl }
    rw [← Finset.sum_filter_add_sum_filter_not Finset.univ
      (fun u₀ : K => Polynomial.aeval (algebraMap K (AlgebraicClosure K) u₀) d = 0)]
    have hA : ∑ u₀ ∈ Finset.univ.filter (fun u₀ : K =>
          Polynomial.aeval (algebraMap K (AlgebraicClosure K) u₀) d = 0),
          lwTwistCount K k g σ u₀ ≤ (k + 1).factorial ^ 2 * (k + 1) ^ (k + 1) := by
      refine le_trans (Finset.sum_le_sum fun u₀ _ => hall u₀) ?_
      rw [Finset.sum_const, smul_eq_mul]
      exact Nat.mul_le_mul_right _ (le_trans (hroot d hd0) hddeg)
    have hC : ∑ u₀ ∈ Finset.univ.filter (fun u₀ : K =>
          ¬ Polynomial.aeval (algebraMap K (AlgebraicClosure K) u₀) d = 0),
          lwTwistCount K k g σ u₀ ≤
        ∑ j, Nat.card {z : Fin 2 → K // MvPolynomial.eval z (P j) = 0} := by
      refine le_trans (Finset.sum_le_sum fun u₀ hu => hgood u₀ (Finset.mem_filter.mp hu).2) ?_
      refine le_trans (Finset.sum_le_sum_of_subset (Finset.filter_subset _ _)) (le_of_eq ?_)
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun j _ => (hfib j).symm
    calc _ ≤ (k + 1).factorial ^ 2 * (k + 1) ^ (k + 1) +
          ∑ j, Nat.card {z : Fin 2 → K // MvPolynomial.eval z (P j) = 0} := add_le_add hA hC
      _ ≤ _ := (add_comm _ _).le.trans (Nat.add_le_add_left hN2mB _)

theorem lw_plane_curve_count (D : ℕ) (η : ℝ) (hη : 0 < η) :
    ∃ Q₀ : ℕ, ∀ (K : Type u) [Field K] [Finite K]
      (g : MvPolynomial (Fin 2) K),
      g.totalDegree ≤ D →
      Irreducible (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g) →
      Q₀ ≤ Nat.card K →
      |(Nat.card {z : Fin 2 → K // MvPolynomial.eval z g = 0} : ℝ) - (Nat.card K : ℝ)| ≤
        η * (Nat.card K : ℝ) :=
by
  classical
  obtain ⟨Qa, hQa⟩ := lw_plane_curve_upper.{u} D η hη
  have hD1 : (0 : ℝ) < (D : ℝ) + 1 := by positivity
  set e : ℝ := η / (2 * ((D : ℝ) + 1)) with he
  have he0 : 0 < e := by positivity
  have heD : e * ((D : ℝ) + 1) = η / 2 := by
    rw [he]; field_simp
  obtain ⟨Qb, hQb⟩ := lw_plane_curve_upper.{u} D.factorial e he0
  obtain ⟨B, hB⟩ := lw_twisted_resolvent_galois.{u} D
  obtain ⟨M, hM⟩ := exists_nat_gt (4 * ((D : ℝ) + 1) * (B : ℝ) / η)
  refine ⟨max (D + 2) (max B (max Qa (max Qb M))), ?_⟩
  intro K _ _ g hgD hgirr hQ
  obtain ⟨hq1, hqB, hqa, hqb, hqM⟩ : D + 2 ≤ Nat.card K ∧ B ≤ Nat.card K ∧ Qa ≤ Nat.card K ∧
      Qb ≤ Nat.card K ∧ M ≤ Nat.card K := by
    simp only [max_le_iff] at hQ
    exact hQ

  have hup := hQa K g hgD hgirr hqa

  obtain ⟨k, g', hkD, hdeg', hmon', hder', hirr', hN'⟩ :=
    lw_curve_normal_form D K g hgD hgirr hq1
  letI : Fintype K := Fintype.ofFinite K
  obtain ⟨hbad, H, ρ, hHt, hσ⟩ := hB K k g' hkD hdeg' hmon' hder' hirr' hqB
  choose n P hnH hP hT using hσ

  have hfib : Nat.card {z : Fin 2 → K // MvPolynomial.eval z g' = 0} =
      ∑ u₀ : K, Nat.card {v : K // MvPolynomial.eval ![u₀, v] g' = 0} := by
    have key : ∀ z : Fin 2 → K, ![z 0, z 1] = z := by
      intro z; ext i; fin_cases i <;> rfl
    rw [← Nat.card_sigma (β := fun u₀ : K => {v : K // MvPolynomial.eval ![u₀, v] g' = 0})]
    exact Nat.card_congr
      { toFun := fun z => ⟨z.1 0, z.1 1, by rw [key z.1]; exact z.2⟩
        invFun := fun p => ⟨![p.1, p.2.1], p.2.2⟩
        left_inv := fun z => Subtype.ext (key z.1)
        right_inv := fun p => rfl }

  have hpt : ∀ u₀ : K, (k + 1).factorial ≤
      k.factorial * Nat.card {v : K // MvPolynomial.eval ![u₀, v] g' = 0} +
        ∑ σ ∈ Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0),
          lwTwistCount K k g' σ u₀ +
        (if (∃ S : Finset (AlgebraicClosure K), S.card = k + 1 ∧
          ∀ s, MvPolynomial.aeval ![algebraMap K (AlgebraicClosure K) u₀, s] g' = 0 ↔ s ∈ S)
          then 0 else (k + 1).factorial) := by
    intro u₀
    split_ifs with hg
    · obtain ⟨S, hS, hSr⟩ := hg
      have := lw_fibre_twist_identity K k g' u₀ S hS hSr
      omega
    · omega
  have hbadsum : ∑ u₀ : K, (if (∃ S : Finset (AlgebraicClosure K), S.card = k + 1 ∧
          ∀ s, MvPolynomial.aeval ![algebraMap K (AlgebraicClosure K) u₀, s] g' = 0 ↔ s ∈ S)
          then 0 else (k + 1).factorial) ≤ B * (k + 1).factorial := by
    rw [Finset.sum_ite, Finset.sum_const_zero, zero_add, Finset.sum_const, smul_eq_mul]
    apply Nat.mul_le_mul_right
    refine le_trans (le_of_eq ?_) hbad
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
  have hmain : (k + 1).factorial * Nat.card K ≤
      k.factorial * (∑ u₀ : K, Nat.card {v : K // MvPolynomial.eval ![u₀, v] g' = 0}) +
        ∑ σ ∈ Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0),
          ∑ u₀ : K, lwTwistCount K k g' σ u₀ + B * (k + 1).factorial := by
    calc (k + 1).factorial * Nat.card K = ∑ _u₀ : K, (k + 1).factorial := by
          rw [Finset.sum_const, Finset.card_univ, smul_eq_mul, Fintype.card_eq_nat_card,
            mul_comm]
      _ ≤ _ := Finset.sum_le_sum fun u₀ _ => hpt u₀
      _ ≤ _ := by
          rw [Finset.sum_add_distrib, Finset.sum_add_distrib, ← Finset.mul_sum,
            Finset.sum_comm (s := (Finset.univ : Finset K))
              (t := Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0))]
          exact Nat.add_le_add_left hbadsum _
  have hNeq : (Nat.card {z : Fin 2 → K // MvPolynomial.eval z g = 0} : ℝ) =
      ((∑ u₀ : K, Nat.card {v : K // MvPolynomial.eval ![u₀, v] g' = 0} : ℕ) : ℝ) := by
    rw [← hfib, hN']
  have hmainR := (Nat.cast_le (α := ℝ)).mpr hmain
  simp only [Nat.cast_add, Nat.cast_mul] at hmainR
  rw [← hNeq] at hmainR

  have hHpos : 0 < Nat.card H := Nat.card_pos
  have hnsum : ∑ σ ∈ Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0), n σ +
      k.factorial = (k + 1).factorial := by
    have hcos := lw_coset_twist_count k H hHt ρ
    have h2 : (∑ σ ∈ Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0), n σ +
        k.factorial) * Nat.card H = (k + 1).factorial * Nat.card H := by
      rw [add_mul, Finset.sum_mul]
      simp only [hnH]
      rw [mul_comm k.factorial, mul_comm (k + 1).factorial]
      exact hcos
    exact Nat.eq_of_mul_eq_mul_right hHpos h2
  have hFcard : (Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0)).card ≤
      (k + 1).factorial := by
    refine le_trans (Finset.card_filter_le _ _) (le_of_eq ?_)
    rw [Finset.card_univ, Fintype.card_perm, Fintype.card_fin]

  set q : ℝ := (Nat.card K : ℝ) with hqdef
  have hq0 : 0 ≤ q := Nat.cast_nonneg _
  have hσbound : ∀ σ, ((∑ u₀ : K, lwTwistCount K k g' σ u₀ : ℕ) : ℝ) ≤
      (n σ : ℝ) * (q + e * q) + B := by
    intro σ
    have h1 : ((∑ u₀ : K, lwTwistCount K k g' σ u₀ : ℕ) : ℝ) ≤
        ∑ j, (Nat.card {z : Fin 2 → K // MvPolynomial.eval z (P σ j) = 0} : ℝ) + B := by
      exact_mod_cast hT σ
    have h2 : ∑ j, (Nat.card {z : Fin 2 → K // MvPolynomial.eval z (P σ j) = 0} : ℝ) ≤
        ∑ _j : Fin (n σ), (q + e * q) :=
      Finset.sum_le_sum fun j _ => hQb K (P σ j) (hP σ j).1 (hP σ j).2 hqb
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul] at h2
    linarith
  have hA : ((∑ σ ∈ Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0),
        ∑ u₀ : K, lwTwistCount K k g' σ u₀ : ℕ) : ℝ) ≤
      ((∑ σ ∈ Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0), n σ : ℕ) : ℝ) *
        (q + e * q) +
      ((Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0)).card : ℝ) * B := by
    rw [Nat.cast_sum, Nat.cast_sum]
    calc _ ≤ ∑ σ ∈ Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0),
          ((n σ : ℝ) * (q + e * q) + B) := Finset.sum_le_sum fun σ _ => hσbound σ
      _ = _ := by rw [Finset.sum_add_distrib, Finset.sum_mul, Finset.sum_const, nsmul_eq_mul]

  set N : ℝ := (Nat.card {z : Fin 2 → K // MvPolynomial.eval z g = 0} : ℝ) with hNdef
  set f : ℝ := (k.factorial : ℝ) with hfdef
  have hf0 : 0 < f := by rw [hfdef]; exact_mod_cast Nat.factorial_pos k
  have hm : ((k + 1).factorial : ℝ) = ((k : ℝ) + 1) * f := by
    rw [Nat.factorial_succ]; push_cast; ring
  have hnsumR : ((∑ σ ∈ Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0),
      n σ : ℕ) : ℝ) = (k : ℝ) * f := by
    have : ((∑ σ ∈ Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0),
        n σ : ℕ) : ℝ) + f = ((k + 1).factorial : ℝ) := by
      rw [hfdef]; exact_mod_cast hnsum
    rw [hm] at this
    linarith
  have hB0 : (0 : ℝ) ≤ B := Nat.cast_nonneg _
  have hFcardR : ((Finset.univ.filter (fun σ : Equiv.Perm (Fin (k + 1)) => σ 0 ≠ 0)).card : ℝ) *
      (B : ℝ) ≤ ((k : ℝ) + 1) * f * B := by
    rw [← hm]
    exact mul_le_mul_of_nonneg_right (by exact_mod_cast hFcard) hB0
  rw [hnsumR] at hA
  rw [hm] at hmainR
  have hkey : f * q ≤ f * (N + (k : ℝ) * e * q + 2 * ((k : ℝ) + 1) * B) := by
    nlinarith
  have hlow : q ≤ N + (k : ℝ) * e * q + 2 * ((k : ℝ) + 1) * B :=
    le_of_mul_le_mul_left hkey hf0
  have hkD' : (k : ℝ) + 1 ≤ D := by exact_mod_cast hkD
  have hke : (k : ℝ) * e * q ≤ η / 2 * q := by
    apply mul_le_mul_of_nonneg_right _ hq0
    rw [← heD]
    nlinarith
  have hMq : (M : ℝ) ≤ q := by rw [hqdef]; exact_mod_cast hqM
  have h4 : 4 * ((D : ℝ) + 1) * (B : ℝ) < M * η := (div_lt_iff₀ hη).mp hM
  have h5 : (M : ℝ) * η ≤ q * η := mul_le_mul_of_nonneg_right hMq hη.le
  have h6 : ((k : ℝ) + 1) * B ≤ ((D : ℝ) + 1) * B :=
    mul_le_mul_of_nonneg_right (by linarith) hB0
  rw [abs_le]
  constructor
  · nlinarith
  · linarith

theorem lw_pb_bivariate_irreducible_iff (M : Type u) [Field M] (g : MvPolynomial (Fin 2) M)
    (D : ℕ) (hD : 1 ≤ D) (hdeg : g.totalDegree ≤ D)
    (hlc : g.coeff (Finsupp.single 1 D) ≠ 0) :
    Irreducible g ↔ ∀ k l : ℕ, 1 ≤ k → 1 ≤ l → k + l = D →
      ¬ ∃ P Q : MvPolynomial (Fin 2) M, P.totalDegree ≤ k ∧ P.coeff (Finsupp.single 1 k) = 1 ∧
        Q.totalDegree ≤ l ∧ Q.coeff (Finsupp.single 1 l) = 1 ∧
        g = MvPolynomial.C (g.coeff (Finsupp.single 1 D)) * P * Q :=
by
  classical

  have hF : ∀ (p : MvPolynomial (Fin 2) M) (n : ℕ), p.coeff (Finsupp.single 1 n) ≠ 0 →
      n ≤ p.totalDegree := by
    intro p n hn
    have h := MvPolynomial.le_totalDegree (s := Finsupp.single 1 n)
      (MvPolynomial.mem_support_iff.mpr hn)
    simpa [Finsupp.sum_single_index] using h

  have hU : ∀ p : MvPolynomial (Fin 2) M, IsUnit p → p.totalDegree = 0 := by
    intro p hp
    exact ((MvPolynomial.isUnit_iff_totalDegree_of_isReduced).mp hp).2

  have hS2 : ∀ p : MvPolynomial (Fin 2) M, p ≠ 0 → ¬ IsUnit p → 1 ≤ p.totalDegree := by
    intro p hp hu
    by_contra h
    have h0 : p.totalDegree = 0 := by omega
    rw [MvPolynomial.totalDegree_eq_zero_iff_eq_C] at h0
    apply hu
    have hc : p.coeff 0 ≠ 0 := by
      intro hc
      apply hp
      rw [h0, hc, map_zero]
    rw [h0]
    exact (Ne.isUnit hc).map MvPolynomial.C

  have hS1 : ∀ (p q : MvPolynomial (Fin 2) M) (k l : ℕ), p.totalDegree ≤ k → q.totalDegree ≤ l →
      (p * q).coeff (Finsupp.single 1 (k + l)) =
        p.coeff (Finsupp.single 1 k) * q.coeff (Finsupp.single 1 l) := by
    intro p q k l hp hq
    rw [MvPolynomial.coeff_mul,
      Finset.sum_eq_single (Finsupp.single 1 k, Finsupp.single 1 l)]
    · rintro ⟨a, b⟩ hab hne
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hab
      dsimp only
      by_contra hne0
      have ha : p.coeff a ≠ 0 := left_ne_zero_of_mul hne0
      have hb : q.coeff b ≠ 0 := right_ne_zero_of_mul hne0
      have hda := MvPolynomial.le_totalDegree (MvPolynomial.mem_support_iff.mpr ha)
      have hdb := MvPolynomial.le_totalDegree (MvPolynomial.mem_support_iff.mpr hb)
      rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two] at hda hdb
      have h0 := congrArg (fun f => f 0) hab
      have h1 := congrArg (fun f => f 1) hab
      simp only [Finsupp.add_apply, Finsupp.single_apply] at h0 h1
      simp only [Fin.one_eq_zero_iff, ite_true, OfNat.ofNat_ne_one] at h0 h1
      apply hne
      have ea : a = Finsupp.single 1 k := by
        ext i
        fin_cases i
        · simp
          omega
        · simp
          omega
      have eb : b = Finsupp.single 1 l := by
        ext i
        fin_cases i
        · simp
          omega
        · simp
          omega
      rw [ea, eb]
    · intro h
      exfalso
      apply h
      rw [Finset.HasAntidiagonal.mem_antidiagonal, ← Finsupp.single_add]
  have hg0 : g ≠ 0 := by
    intro h
    apply hlc
    rw [h]
    simp
  have hgD : g.totalDegree = D := le_antisymm hdeg (hF g D hlc)
  constructor
  · rintro hirr k l hk hl hkl ⟨P, Q, hP, hP1, hQ, hQ1, hfac⟩
    rcases hirr.isUnit_or_isUnit hfac with h | h
    · have h0 := hU _ h
      have hne : (MvPolynomial.C (g.coeff (Finsupp.single 1 D)) * P).coeff
          (Finsupp.single 1 k) ≠ 0 := by
        rw [MvPolynomial.coeff_C_mul, hP1, mul_one]
        exact hlc
      have := hF _ _ hne
      omega
    · have h0 := hU _ h
      have := hF Q l (by rw [hQ1]; exact one_ne_zero)
      omega
  · intro hR
    refine irreducible_iff.mpr ⟨?_, ?_⟩
    · intro hu
      have := hU g hu
      omega
    · intro a b hab
      by_contra hcon
      rw [not_or] at hcon
      obtain ⟨hua, hub⟩ := hcon
      have ha0 : a ≠ 0 := by
        rintro rfl
        apply hg0
        rw [hab, zero_mul]
      have hb0 : b ≠ 0 := by
        rintro rfl
        apply hg0
        rw [hab, mul_zero]
      have hk := hS2 a ha0 hua
      have hl := hS2 b hb0 hub
      have hkl : a.totalDegree + b.totalDegree = D := by
        rw [← hgD, hab, MvPolynomial.totalDegree_mul_of_isDomain ha0 hb0]
      have hc := hS1 a b a.totalDegree b.totalDegree le_rfl le_rfl
      rw [← hab, hkl] at hc
      have hα0 : a.coeff (Finsupp.single 1 a.totalDegree) ≠ 0 := by
        intro h
        apply hlc
        rw [hc, h, zero_mul]
      have hβ0 : b.coeff (Finsupp.single 1 b.totalDegree) ≠ 0 := by
        intro h
        apply hlc
        rw [hc, h, mul_zero]
      apply hR a.totalDegree b.totalDegree hk hl hkl
      refine ⟨MvPolynomial.C (a.coeff (Finsupp.single 1 a.totalDegree))⁻¹ * a,
        MvPolynomial.C (b.coeff (Finsupp.single 1 b.totalDegree))⁻¹ * b, ?_, ?_, ?_, ?_, ?_⟩
      · refine le_trans (MvPolynomial.totalDegree_mul _ _) ?_
        rw [MvPolynomial.totalDegree_C, zero_add]
      · rw [MvPolynomial.coeff_C_mul]
        exact inv_mul_cancel₀ hα0
      · refine le_trans (MvPolynomial.totalDegree_mul _ _) ?_
        rw [MvPolynomial.totalDegree_C, zero_add]
      · rw [MvPolynomial.coeff_C_mul]
        exact inv_mul_cancel₀ hβ0
      · rw [hc]
        generalize a.coeff (Finsupp.single 1 a.totalDegree) = α at hα0 ⊢
        generalize b.coeff (Finsupp.single 1 b.totalDegree) = β at hβ0 ⊢
        have hone : α * β * α⁻¹ * β⁻¹ = 1 := by
          field_simp
        calc g = a * b := hab
          _ = MvPolynomial.C (α * β * α⁻¹ * β⁻¹) * (a * b) := by
            rw [hone, MvPolynomial.C_1, one_mul]
          _ = _ := by
            simp only [map_mul]
            ring

theorem lw_pb_generic_section_leading_coeff (F : Type u) [Field F] (d : ℕ)
    (f : MvPolynomial (Fin (d + 1)) F) (hf : f ≠ 0) :
    (lwGenSection F d f).totalDegree ≤ f.totalDegree ∧
      (lwGenSection F d f).coeff (Finsupp.single 1 f.totalDegree) ≠ 0 :=
by
  classical

  have bin : ∀ (P Q : MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) F)) (a b : ℕ),
      P.totalDegree ≤ a → Q.totalDegree ≤ b →
      (P * Q).coeff (Finsupp.single 1 (a + b)) =
        P.coeff (Finsupp.single 1 a) * Q.coeff (Finsupp.single 1 b) := by
    intro P Q a b hP hQ
    rw [MvPolynomial.coeff_mul]
    rw [Finset.sum_eq_single (Finsupp.single 1 a, Finsupp.single 1 b)]
    · rintro ⟨x, y⟩ hxy hne
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hxy
      simp only at hxy
      have h0 : x 0 + y 0 = 0 := by
        have := congrArg (fun g => g 0) hxy
        simpa using this
      have h1 : x 1 + y 1 = a + b := by
        have := congrArg (fun g => g 1) hxy
        simpa using this
      have hdx : (∑ i ∈ x.support, x i) = x 0 + x 1 :=
        (Finsupp.sum_fintype x (fun _ e => e) (fun _ => rfl)).trans (Fin.sum_univ_two _)
      have hdy : (∑ i ∈ y.support, y i) = y 0 + y 1 :=
        (Finsupp.sum_fintype y (fun _ e => e) (fun _ => rfl)).trans (Fin.sum_univ_two _)
      rcases lt_trichotomy (x 1) a with h | h | h
      · have hc : Q.coeff y = 0 :=
          MvPolynomial.coeff_eq_zero_of_totalDegree_lt (by rw [hdy]; omega)
        rw [hc, mul_zero]
      · exfalso
        apply hne
        have hx : x = Finsupp.single 1 a := by
          ext i
          fin_cases i <;> simp [Finsupp.single_apply] <;> omega
        have hy : y = Finsupp.single 1 b := by
          ext i
          fin_cases i <;> simp [Finsupp.single_apply] <;> omega
        rw [hx, hy]
      · have hc : P.coeff x = 0 :=
          MvPolynomial.coeff_eq_zero_of_totalDegree_lt (by rw [hdx]; omega)
        rw [hc, zero_mul]
    · intro h
      exfalso
      apply h
      rw [Finset.HasAntidiagonal.mem_antidiagonal, Finsupp.single_add]

  let ℓ : Fin (d + 1) → MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) F) := fun i =>
    MvPolynomial.C (MvPolynomial.X ((0 : Fin 3), i)) +
      MvPolynomial.X 0 * MvPolynomial.C (MvPolynomial.X ((1 : Fin 3), i)) +
      MvPolynomial.X 1 * MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), i))
  have hG : lwGenSection F d f = MvPolynomial.aeval ℓ f := rfl
  have hXC : ∀ (j : Fin 2) (r : MvPolynomial (Fin 3 × Fin (d + 1)) F),
      (MvPolynomial.X j * MvPolynomial.C r :
        MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) F)).totalDegree ≤ 1 := by
    intro j r
    calc _ ≤ (MvPolynomial.X j : MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) F)).totalDegree
          + (MvPolynomial.C r : MvPolynomial (Fin 2)
            (MvPolynomial (Fin 3 × Fin (d + 1)) F)).totalDegree := MvPolynomial.totalDegree_mul _ _
      _ = 1 := by rw [MvPolynomial.totalDegree_X, MvPolynomial.totalDegree_C]
  have hl1 : ∀ i, (ℓ i).totalDegree ≤ 1 := by
    intro i
    refine (MvPolynomial.totalDegree_add _ _).trans (max_le ((MvPolynomial.totalDegree_add _ _).trans
      (max_le ?_ (hXC _ _))) (hXC _ _))
    rw [MvPolynomial.totalDegree_C]
    omega
  have hlc : ∀ i, (ℓ i).coeff (Finsupp.single 1 1) = MvPolynomial.X ((2 : Fin 3), i) := by
    intro i
    simp only [ℓ, MvPolynomial.coeff_add, MvPolynomial.coeff_C,
      mul_comm (MvPolynomial.X _ : MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) F)),
      MvPolynomial.coeff_C_mul, MvPolynomial.coeff_X']
    have h01 : (0 : Fin 2 →₀ ℕ) ≠ Finsupp.single 1 1 := fun h => by
      have := congrArg (fun g => g 1) h
      simp at this
    simp [Finsupp.single_eq_single_iff, h01]
  have hpow : ∀ i (k : ℕ), (ℓ i ^ k).totalDegree ≤ k ∧
      (ℓ i ^ k).coeff (Finsupp.single 1 k) = MvPolynomial.X ((2 : Fin 3), i) ^ k := by
    intro i k
    induction k with
    | zero => simp
    | succ k ih =>
      refine ⟨?_, ?_⟩
      · rw [pow_succ]
        exact (MvPolynomial.totalDegree_mul _ _).trans (by have := hl1 i; omega)
      · rw [pow_succ, bin _ _ k 1 ih.1 (hl1 i), ih.2, hlc, pow_succ]
  have hprod : ∀ (m : Fin (d + 1) →₀ ℕ) (s : Finset (Fin (d + 1))),
      (∏ i ∈ s, ℓ i ^ m i).totalDegree ≤ ∑ i ∈ s, m i ∧
      (∏ i ∈ s, ℓ i ^ m i).coeff (Finsupp.single 1 (∑ i ∈ s, m i)) =
        ∏ i ∈ s, MvPolynomial.X ((2 : Fin 3), i) ^ m i := by
    intro m s
    induction s using Finset.induction_on with
    | empty => simp
    | @insert j s hj ih =>
      rw [Finset.prod_insert hj, Finset.sum_insert hj, Finset.prod_insert hj]
      refine ⟨(MvPolynomial.totalDegree_mul _ _).trans (add_le_add (hpow j (m j)).1 ih.1), ?_⟩
      rw [bin _ _ _ _ (hpow j (m j)).1 ih.1, (hpow j (m j)).2, ih.2]
  have hexp : MvPolynomial.aeval ℓ f = ∑ m ∈ f.support,
      MvPolynomial.C (MvPolynomial.C (f.coeff m)) * ∏ i, ℓ i ^ m i := by
    conv_lhs => rw [f.as_sum]
    rw [map_sum]
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [MvPolynomial.aeval_monomial, Finsupp.prod_fintype _ _ (fun i => pow_zero _),
      MvPolynomial.algebraMap_apply, MvPolynomial.algebraMap_eq]
  have hdegm : ∀ m ∈ f.support, ∑ i, m i ≤ f.totalDegree := by
    intro m hm
    rw [← Finsupp.sum_fintype m (fun _ e => e) (fun _ => rfl)]
    exact MvPolynomial.le_totalDegree hm
  have ha : (lwGenSection F d f).totalDegree ≤ f.totalDegree := by
    rw [hG, hexp]
    refine (MvPolynomial.totalDegree_finset_sum _ _).trans (Finset.sup_le fun m hm => ?_)
    refine (MvPolynomial.totalDegree_mul _ _).trans ?_
    rw [MvPolynomial.totalDegree_C, zero_add]
    exact (hprod m Finset.univ).1.trans (hdegm m hm)
  have hcoef : (lwGenSection F d f).coeff (Finsupp.single 1 f.totalDegree) =
      ∑ m ∈ f.support.filter (fun m => ∑ i, m i = f.totalDegree),
        MvPolynomial.C (f.coeff m) * ∏ i, MvPolynomial.X ((2 : Fin 3), i) ^ m i := by
    rw [hG, hexp, MvPolynomial.coeff_sum, Finset.sum_filter]
    refine Finset.sum_congr rfl fun m hm => ?_
    rw [MvPolynomial.coeff_C_mul]
    split_ifs with h
    · rw [← h, (hprod m Finset.univ).2]
    · have h1 := (hprod m Finset.univ).1
      have h2 := hdegm m hm
      have h3 : (∑ i ∈ (Finsupp.single (1 : Fin 2) f.totalDegree).support,
          (Finsupp.single (1 : Fin 2) f.totalDegree) i) = f.totalDegree := by
        rw [← Finsupp.degree_apply, Finsupp.degree_single]
      have h4 : (∏ i, ℓ i ^ m i).coeff (Finsupp.single 1 f.totalDegree) = 0 :=
        MvPolynomial.coeff_eq_zero_of_totalDegree_lt (by rw [h3]; omega)
      rw [h4, mul_zero]
  have hne : (∑ m ∈ f.support.filter (fun m => ∑ i, m i = f.totalDegree),
        MvPolynomial.C (f.coeff m) * ∏ i, MvPolynomial.X ((2 : Fin 3), i) ^ m i :
        MvPolynomial (Fin 3 × Fin (d + 1)) F) ≠ 0 := by
    have hι : Function.Injective (fun i : Fin (d + 1) => ((2 : Fin 3), i)) :=
      fun a b h => (Prod.mk.inj h).2
    have heq : (∑ m ∈ f.support.filter (fun m => ∑ i, m i = f.totalDegree),
        MvPolynomial.C (f.coeff m) * ∏ i, MvPolynomial.X ((2 : Fin 3), i) ^ m i :
        MvPolynomial (Fin 3 × Fin (d + 1)) F) =
        MvPolynomial.rename (fun i : Fin (d + 1) => ((2 : Fin 3), i))
          (∑ m ∈ f.support.filter (fun m => ∑ i, m i = f.totalDegree),
            MvPolynomial.monomial m (f.coeff m)) := by
      rw [map_sum]
      refine Finset.sum_congr rfl fun m _ => ?_
      rw [MvPolynomial.monomial_eq, Finsupp.prod_fintype _ _ (fun _ => pow_zero _), map_mul,
        MvPolynomial.rename_C, map_prod]
      simp [MvPolynomial.rename_X]
    rw [heq]
    intro h0
    have h1 := MvPolynomial.rename_injective _ hι (h0.trans (map_zero _).symm)
    obtain ⟨m₀, hm₀, hmax⟩ := Finset.exists_mem_eq_sup f.support
      (MvPolynomial.support_nonempty.mpr hf) (fun s => s.sum fun _ e => e)
    have hc := MvPolynomial.ext_iff.mp h1 m₀
    rw [MvPolynomial.coeff_sum, MvPolynomial.coeff_zero] at hc
    rw [Finset.sum_eq_single m₀] at hc
    · rw [MvPolynomial.coeff_monomial, if_pos rfl] at hc
      exact (MvPolynomial.mem_support_iff.mp hm₀) hc
    · intro b _ hb
      rw [MvPolynomial.coeff_monomial, if_neg hb]
    · intro hn
      exfalso
      apply hn
      rw [Finset.mem_filter]
      refine ⟨hm₀, ?_⟩
      rw [← Finsupp.sum_fintype m₀ (fun _ e => e) (fun _ => rfl)]
      exact hmax.symm
  refine ⟨ha, ?_⟩
  rw [hcoef]
  exact hne

theorem lw_gs_irreducible_over_fraction_field (κ : Type u) [Field κ] (d : ℕ)
    (g : MvPolynomial (Fin (d + 1)) κ) (hg : Irreducible g) :
    Irreducible (MvPolynomial.map (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
      (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ))) (lwGenSection κ d g)) :=
by
  classical

  have s4 : ∀ (A : Type u) [CommRing A] [IsDomain A] (G : MvPolynomial (Fin 2) A),
      Prime G → 1 ≤ G.totalDegree →
      Irreducible (MvPolynomial.map (algebraMap A (FractionRing A)) G) := by
    intro A _ _ G hG hdeg
    have hι : Function.Injective (algebraMap A (FractionRing A)) :=
      IsFractionRing.injective A (FractionRing A)
    have hΦ : Function.Injective
        (MvPolynomial.map (σ := Fin 2) (algebraMap A (FractionRing A))) :=
      MvPolynomial.map_injective _ hι
    have clear : ∀ P : MvPolynomial (Fin 2) (FractionRing A), ∃ b : A, b ≠ 0 ∧
        ∃ P' : MvPolynomial (Fin 2) A, MvPolynomial.C (algebraMap A (FractionRing A) b) * P =
          MvPolynomial.map (algebraMap A (FractionRing A)) P' := by
      intro P
      obtain ⟨b, hb⟩ :=
        IsLocalization.exist_integer_multiples_of_finset (nonZeroDivisors A) P.coeffs
      refine ⟨(b : A), nonZeroDivisors.ne_zero b.2, ?_⟩
      have hmem : MvPolynomial.C (algebraMap A (FractionRing A) (b : A)) * P ∈
          Set.range (MvPolynomial.map (σ := Fin 2) (algebraMap A (FractionRing A))) := by
        refine MvPolynomial.mem_range_map_iff_coeffs_subset.mpr fun c hc => ?_
        obtain ⟨n, -, rfl⟩ := MvPolynomial.mem_coeffs_iff.mp hc
        rw [MvPolynomial.coeff_C_mul]
        by_cases h0 : P.coeff n = 0
        · rw [h0, mul_zero]
          exact ⟨0, map_zero _⟩
        · obtain ⟨a, ha⟩ := hb _ (MvPolynomial.coeff_mem_coeffs n h0)
          refine ⟨a, ?_⟩
          rw [ha, Algebra.smul_def]
      obtain ⟨P', hP'⟩ := hmem
      exact ⟨P', hP'.symm⟩
    have hG0 : G ≠ 0 := hG.ne_zero
    have hdegΦ : (MvPolynomial.map (algebraMap A (FractionRing A)) G).totalDegree =
        G.totalDegree := by
      simp only [MvPolynomial.totalDegree, MvPolynomial.support_map_of_injective _ hι]
    refine irreducible_iff.mpr ⟨?_, ?_⟩
    · intro hu
      have h2 := (MvPolynomial.isUnit_iff_totalDegree_of_isReduced.mp hu).2
      rw [hdegΦ] at h2
      omega
    · intro P Q hPQ
      obtain ⟨a, ha0, P', hP'⟩ := clear P
      obtain ⟨b, hb0, Q', hQ'⟩ := clear Q
      have key : MvPolynomial.C (a * b) * G = P' * Q' := by
        apply hΦ
        simp only [map_mul, MvPolynomial.map_C, MvPolynomial.C_mul]
        rw [← hP', ← hQ', hPQ]
        ring
      have hdvd : G ∣ P' * Q' := ⟨MvPolynomial.C (a * b), by rw [← key, mul_comm]⟩
      have hab : MvPolynomial.C (a * b) ≠ (0 : MvPolynomial (Fin 2) A) := by
        rw [Ne, MvPolynomial.C_eq_zero]
        exact mul_ne_zero ha0 hb0
      have const : ∀ H W : MvPolynomial (Fin 2) A, MvPolynomial.C (a * b) = H * W →
          W = MvPolynomial.C (W.coeff 0) ∧ W.coeff 0 ≠ 0 := by
        intro H W hHW
        have hH : H ≠ 0 := by
          rintro rfl
          rw [zero_mul] at hHW
          exact hab hHW
        have hW : W ≠ 0 := by
          rintro rfl
          rw [mul_zero] at hHW
          exact hab hHW
        have hdg := MvPolynomial.totalDegree_mul_of_isDomain hH hW
        rw [← hHW, MvPolynomial.totalDegree_C] at hdg
        have hW0 : W.totalDegree = 0 := by omega
        have hWC := MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp hW0
        refine ⟨hWC, ?_⟩
        intro h
        apply hW
        rw [hWC, h, map_zero]
      have unitOf : ∀ (c : A) (Y : MvPolynomial (Fin 2) (FractionRing A))
          (W : MvPolynomial (Fin 2) A),
          MvPolynomial.C (algebraMap A (FractionRing A) c) * Y =
            MvPolynomial.map (algebraMap A (FractionRing A)) W →
          W = MvPolynomial.C (W.coeff 0) → W.coeff 0 ≠ 0 → IsUnit Y := by
        intro c Y W hY hWC hW0
        rw [hWC, MvPolynomial.map_C] at hY
        have hu : IsUnit (MvPolynomial.C (algebraMap A (FractionRing A) c) * Y) := by
          rw [hY]
          exact (Ne.isUnit ((map_ne_zero_iff _ hι).mpr hW0)).map MvPolynomial.C
        exact isUnit_of_mul_isUnit_right hu
      rcases hG.dvd_or_dvd hdvd with ⟨H, hH⟩ | ⟨H, hH⟩
      · right
        rw [hH, mul_assoc] at key
        have key2 : MvPolynomial.C (a * b) = H * Q' := by
          apply mul_left_cancel₀ hG0
          rw [mul_comm G (MvPolynomial.C (a * b)), key]
        obtain ⟨h1, h2⟩ := const H Q' key2
        exact unitOf b Q Q' hQ' h1 h2
      · left
        rw [hH] at key
        have key2 : MvPolynomial.C (a * b) = H * P' := by
          apply mul_left_cancel₀ hG0
          rw [mul_comm G (MvPolynomial.C (a * b)), key]
          ring
        obtain ⟨h1, h2⟩ := const H P' key2
        exact unitOf a P P' hP' h1 h2

  have hg0 : g ≠ 0 := hg.ne_zero
  have hD1 : 1 ≤ g.totalDegree := by
    by_contra h
    have h0 : g.totalDegree = 0 := by omega
    rw [MvPolynomial.totalDegree_eq_zero_iff_eq_C] at h0
    have hg' := hg
    rw [h0] at hg'
    by_cases hc : g.coeff 0 = 0
    · rw [hc, map_zero] at hg'
      exact not_irreducible_zero hg'
    · exact hg'.not_isUnit ((Ne.isUnit hc).map MvPolynomial.C)

  have hgp : Prime g := UniqueFactorizationMonoid.irreducible_iff_prime.mp hg

  have hinj : Function.Injective (fun i : Fin (d + 1) => ((0 : Fin 3), i)) :=
    fun i j h => (Prod.mk.inj h).2
  have s2 : Prime (MvPolynomial.rename (fun i : Fin (d + 1) => ((0 : Fin 3), i)) g) := by
    have h1 : Prime (MvPolynomial.renameEquiv κ (Equiv.ofInjective _ hinj) g) :=
      (MulEquiv.prime_iff (MvPolynomial.renameEquiv κ (Equiv.ofInjective _ hinj))).mpr hgp
    rw [MvPolynomial.renameEquiv_apply] at h1
    have h2 := (MvPolynomial.prime_rename_iff
      (Set.range (fun i : Fin (d + 1) => ((0 : Fin 3), i)))).mpr h1
    rw [MvPolynomial.rename_rename] at h2
    have h3 : (Subtype.val ∘ ⇑(Equiv.ofInjective _ hinj)) =
        (fun i : Fin (d + 1) => ((0 : Fin 3), i)) := by
      funext i
      rfl
    rw [h3] at h2
    exact h2

  obtain ⟨φm, φm_C, φm_X0, φm_Xne⟩ : ∃ φ : MvPolynomial (Fin 3 × Fin (d + 1)) κ →+*
      MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ),
      (∀ k : κ, φ (MvPolynomial.C k) = MvPolynomial.C (MvPolynomial.C k)) ∧
      (∀ i, φ (MvPolynomial.X ((0 : Fin 3), i)) =
        MvPolynomial.C (MvPolynomial.X ((0 : Fin 3), i)) -
          MvPolynomial.X 0 * MvPolynomial.C (MvPolynomial.X ((1 : Fin 3), i)) -
          MvPolynomial.X 1 * MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), i))) ∧
      (∀ (a : Fin 3) i, a ≠ 0 →
        φ (MvPolynomial.X (a, i)) = MvPolynomial.C (MvPolynomial.X (a, i))) := by
    refine ⟨(MvPolynomial.aeval (fun p : Fin 3 × Fin (d + 1) => (if p.1 = 0 then
        MvPolynomial.C (MvPolynomial.X p) -
          MvPolynomial.X 0 * MvPolynomial.C (MvPolynomial.X ((1 : Fin 3), p.2)) -
          MvPolynomial.X 1 * MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), p.2))
        else MvPolynomial.C (MvPolynomial.X p) :
          MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ)))).toRingHom,
      ?_, ?_, ?_⟩
    · intro k
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_C]
      rw [MvPolynomial.algebraMap_apply, MvPolynomial.algebraMap_eq]
    · intro i
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X]
      simp
    · intro a i ha
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X]
      simp [ha]
  obtain ⟨φp, φp_C, φp_X0, φp_Xne⟩ : ∃ φ : MvPolynomial (Fin 3 × Fin (d + 1)) κ →+*
      MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ),
      (∀ k : κ, φ (MvPolynomial.C k) = MvPolynomial.C (MvPolynomial.C k)) ∧
      (∀ i, φ (MvPolynomial.X ((0 : Fin 3), i)) =
        MvPolynomial.C (MvPolynomial.X ((0 : Fin 3), i)) +
          MvPolynomial.X 0 * MvPolynomial.C (MvPolynomial.X ((1 : Fin 3), i)) +
          MvPolynomial.X 1 * MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), i))) ∧
      (∀ (a : Fin 3) i, a ≠ 0 →
        φ (MvPolynomial.X (a, i)) = MvPolynomial.C (MvPolynomial.X (a, i))) := by
    refine ⟨(MvPolynomial.aeval (fun p : Fin 3 × Fin (d + 1) => (if p.1 = 0 then
        MvPolynomial.C (MvPolynomial.X p) +
          MvPolynomial.X 0 * MvPolynomial.C (MvPolynomial.X ((1 : Fin 3), p.2)) +
          MvPolynomial.X 1 * MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), p.2))
        else MvPolynomial.C (MvPolynomial.X p) :
          MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ)))).toRingHom,
      ?_, ?_, ?_⟩
    · intro k
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_C]
      rw [MvPolynomial.algebraMap_apply, MvPolynomial.algebraMap_eq]
    · intro i
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X]
      simp
    · intro a i ha
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X]
      simp [ha]
  obtain ⟨τm, τm_C, τm_X⟩ : ∃ τ : MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ) →+*
      MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ),
      (∀ r, τ (MvPolynomial.C r) = φm r) ∧ ∀ i, τ (MvPolynomial.X i) = MvPolynomial.X i :=
    ⟨MvPolynomial.eval₂Hom φm MvPolynomial.X, fun r => MvPolynomial.eval₂Hom_C _ _ _,
      fun i => MvPolynomial.eval₂Hom_X' _ _ _⟩
  obtain ⟨τp, τp_C, τp_X⟩ : ∃ τ : MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ) →+*
      MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ),
      (∀ r, τ (MvPolynomial.C r) = φp r) ∧ ∀ i, τ (MvPolynomial.X i) = MvPolynomial.X i :=
    ⟨MvPolynomial.eval₂Hom φp MvPolynomial.X, fun r => MvPolynomial.eval₂Hom_C _ _ _,
      fun i => MvPolynomial.eval₂Hom_X' _ _ _⟩
  have hpmR : ∀ r, τp (φm r) = MvPolynomial.C r := by
    intro r
    have h : τp.comp φm = (MvPolynomial.C : MvPolynomial (Fin 3 × Fin (d + 1)) κ →+*
        MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) := by
      apply MvPolynomial.ringHom_ext
      · intro k
        rw [RingHom.comp_apply, φm_C, τp_C, φp_C]
      · rintro ⟨a, i⟩
        rw [RingHom.comp_apply]
        by_cases ha : a = 0
        · subst ha
          rw [φm_X0, map_sub, map_sub, map_mul, map_mul, τp_C, τp_C, τp_C, τp_X, τp_X, φp_X0,
            φp_Xne 1 i (by decide), φp_Xne 2 i (by decide)]
          ring
        · rw [φm_Xne a i ha, τp_C, φp_Xne a i ha]
    exact RingHom.congr_fun h r
  have hmpR : ∀ r, τm (φp r) = MvPolynomial.C r := by
    intro r
    have h : τm.comp φp = (MvPolynomial.C : MvPolynomial (Fin 3 × Fin (d + 1)) κ →+*
        MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) := by
      apply MvPolynomial.ringHom_ext
      · intro k
        rw [RingHom.comp_apply, φp_C, τm_C, φm_C]
      · rintro ⟨a, i⟩
        rw [RingHom.comp_apply]
        by_cases ha : a = 0
        · subst ha
          rw [φp_X0, map_add, map_add, map_mul, map_mul, τm_C, τm_C, τm_C, τm_X, τm_X, φm_X0,
            φm_Xne 1 i (by decide), φm_Xne 2 i (by decide)]
          ring
        · rw [φp_Xne a i ha, τm_C, φm_Xne a i ha]
    exact RingHom.congr_fun h r
  have hpm : τp.comp τm = RingHom.id _ := by
    apply MvPolynomial.ringHom_ext
    · intro r
      rw [RingHom.comp_apply, τm_C, RingHom.id_apply, hpmR]
    · intro i
      rw [RingHom.comp_apply, τm_X, τp_X, RingHom.id_apply]
  have hmp : τm.comp τp = RingHom.id _ := by
    apply MvPolynomial.ringHom_ext
    · intro r
      rw [RingHom.comp_apply, τp_C, RingHom.id_apply, hmpR]
    · intro i
      rw [RingHom.comp_apply, τp_X, τm_X, RingHom.id_apply]
  have hB : τm (lwGenSection κ d g) =
      MvPolynomial.C (MvPolynomial.rename (fun i : Fin (d + 1) => ((0 : Fin 3), i)) g) := by
    have h : τm.comp (MvPolynomial.aeval (fun i : Fin (d + 1) =>
        (MvPolynomial.C (MvPolynomial.X ((0 : Fin 3), i)) +
          MvPolynomial.X 0 * MvPolynomial.C (MvPolynomial.X ((1 : Fin 3), i)) +
          MvPolynomial.X 1 * MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), i)) :
            MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ)))).toRingHom =
        (MvPolynomial.C : MvPolynomial (Fin 3 × Fin (d + 1)) κ →+*
          MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ)).comp
          (MvPolynomial.rename (fun i : Fin (d + 1) => ((0 : Fin 3), i))).toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro k
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.aeval_C, MvPolynomial.rename_C]
        rw [MvPolynomial.algebraMap_apply, MvPolynomial.algebraMap_eq, τm_C, φm_C]
      · intro i
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.aeval_X, MvPolynomial.rename_X]
        rw [map_add, map_add, map_mul, map_mul, τm_C, τm_C, τm_C, τm_X, τm_X, φm_X0,
          φm_Xne 1 i (by decide), φm_Xne 2 i (by decide)]
        ring
    exact RingHom.congr_fun h g
  have hG0prime : Prime (lwGenSection κ d g) := by
    refine (MulEquiv.prime_iff (RingEquiv.ofRingHom τm τp hmp hpm)).mp ?_
    show Prime (τm (lwGenSection κ d g))
    rw [hB]
    exact (MvPolynomial.prime_C_iff (Fin 2)).mpr s2

  obtain ⟨ψ, ψ_C, ψ_X0, ψ_X1, ψ_X2⟩ : ∃ ψ : MvPolynomial (Fin 3 × Fin (d + 1)) κ →+*
      MvPolynomial (Fin (d + 1)) κ,
      (∀ k : κ, ψ (MvPolynomial.C k) = MvPolynomial.C k) ∧
      (∀ i, ψ (MvPolynomial.X ((0 : Fin 3), i)) = 0) ∧
      (∀ i, ψ (MvPolynomial.X ((1 : Fin 3), i)) = MvPolynomial.X i) ∧
      (∀ i, ψ (MvPolynomial.X ((2 : Fin 3), i)) = 0) := by
    refine ⟨(MvPolynomial.aeval (fun p : Fin 3 × Fin (d + 1) => (if p.1 = 1 then
        MvPolynomial.X p.2 else 0 : MvPolynomial (Fin (d + 1)) κ))).toRingHom, ?_, ?_, ?_, ?_⟩
    · intro k
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_C]
      rw [MvPolynomial.algebraMap_eq]
    · intro i
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X]
      simp
    · intro i
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X]
      simp
    · intro i
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_X]
      simp
  obtain ⟨Ψ1, Ψ1_C, Ψ1_X⟩ : ∃ Ψ : MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ) →+*
      MvPolynomial (Fin (d + 1)) κ,
      (∀ r, Ψ (MvPolynomial.C r) = ψ r) ∧
      ∀ j, Ψ (MvPolynomial.X j) = (if j = 0 then 1 else 0) :=
    ⟨MvPolynomial.eval₂Hom ψ (fun j : Fin 2 => if j = 0 then 1 else 0),
      fun r => MvPolynomial.eval₂Hom_C _ _ _, fun j => MvPolynomial.eval₂Hom_X' _ _ _⟩
  obtain ⟨Ψ0, Ψ0_C, Ψ0_X⟩ : ∃ Ψ : MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ) →+*
      MvPolynomial (Fin (d + 1)) κ,
      (∀ r, Ψ (MvPolynomial.C r) = ψ r) ∧ ∀ j, Ψ (MvPolynomial.X j) = 0 :=
    ⟨MvPolynomial.eval₂Hom ψ (fun _ : Fin 2 => 0),
      fun r => MvPolynomial.eval₂Hom_C _ _ _, fun j => MvPolynomial.eval₂Hom_X' _ _ _⟩
  have hΨ1 : Ψ1 (lwGenSection κ d g) = g := by
    have h : Ψ1.comp (MvPolynomial.aeval (fun i : Fin (d + 1) =>
        (MvPolynomial.C (MvPolynomial.X ((0 : Fin 3), i)) +
          MvPolynomial.X 0 * MvPolynomial.C (MvPolynomial.X ((1 : Fin 3), i)) +
          MvPolynomial.X 1 * MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), i)) :
            MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ)))).toRingHom =
        RingHom.id _ := by
      apply MvPolynomial.ringHom_ext
      · intro k
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.aeval_C, RingHom.id_apply]
        rw [MvPolynomial.algebraMap_apply, MvPolynomial.algebraMap_eq, Ψ1_C, ψ_C]
      · intro i
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.aeval_X, RingHom.id_apply]
        rw [map_add, map_add, map_mul, map_mul, Ψ1_C, Ψ1_C, Ψ1_C, Ψ1_X, Ψ1_X, ψ_X0, ψ_X1, ψ_X2]
        simp
    exact RingHom.congr_fun h g
  have hΨ0 : Ψ0 (lwGenSection κ d g) = MvPolynomial.C (MvPolynomial.constantCoeff g) := by
    have h : Ψ0.comp (MvPolynomial.aeval (fun i : Fin (d + 1) =>
        (MvPolynomial.C (MvPolynomial.X ((0 : Fin 3), i)) +
          MvPolynomial.X 0 * MvPolynomial.C (MvPolynomial.X ((1 : Fin 3), i)) +
          MvPolynomial.X 1 * MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), i)) :
            MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ)))).toRingHom =
        (MvPolynomial.C : κ →+* MvPolynomial (Fin (d + 1)) κ).comp
          MvPolynomial.constantCoeff := by
      apply MvPolynomial.ringHom_ext
      · intro k
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.aeval_C, MvPolynomial.constantCoeff_C]
        rw [MvPolynomial.algebraMap_apply, MvPolynomial.algebraMap_eq, Ψ0_C, ψ_C]
      · intro i
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          MvPolynomial.aeval_X, MvPolynomial.constantCoeff_X]
        rw [map_add, map_add, map_mul, map_mul, Ψ0_C, Ψ0_C, Ψ0_C, Ψ0_X, Ψ0_X, ψ_X0, ψ_X1, ψ_X2]
        simp
    exact RingHom.congr_fun h g
  have hdeg : 1 ≤ (lwGenSection κ d g).totalDegree := by
    by_contra hlt
    have h0 : (lwGenSection κ d g).totalDegree = 0 := by omega
    have hC := MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp h0
    have e1 := hΨ1
    have e0 := hΨ0
    rw [hC, Ψ1_C] at e1
    rw [hC, Ψ0_C, e1] at e0
    have : g.totalDegree = 0 := by
      rw [e0, MvPolynomial.totalDegree_C]
    omega
  exact s4 _ _ hG0prime hdeg

theorem lw_gs_factor_coeffs_separable (κ : Type u) [Field κ] [IsAlgClosed κ] (d : ℕ)
    (g : MvPolynomial (Fin (d + 1)) κ) (hg : Irreducible g)
    (hK : Irreducible (MvPolynomial.map (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
      (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ))) (lwGenSection κ d g)))
    (L : Type u) [Field L] [Algebra (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) L]
    (k l : ℕ) (hk : 1 ≤ k) (hl : 1 ≤ l) (hkl : k + l = g.totalDegree)
    (P Q : MvPolynomial (Fin 2) L)
    (hP1 : P.totalDegree ≤ k) (hP2 : P.coeff (Finsupp.single 1 k) = 1)
    (hQ1 : Q.totalDegree ≤ l) (hQ2 : Q.coeff (Finsupp.single 1 l) = 1)
    (hfac : MvPolynomial.map
        ((algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) L).comp
          (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
            (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)))) (lwGenSection κ d g) =
      MvPolynomial.C
        (((algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) L).comp
          (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
            (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ))))
          ((lwGenSection κ d g).coeff (Finsupp.single 1 g.totalDegree))) * P * Q) :
    ∀ m, IsSeparable (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) (P.coeff m) ∧
      IsSeparable (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) (Q.coeff m) :=
by
  classical

  have hs1 : ∃ i : Fin (d + 1), MvPolynomial.pderiv i g ≠ 0 := by
    by_contra hall
    push_neg at hall
    have hdiv : ∀ m ∈ g.support, ∀ i, ((m i : ℕ) : κ) = 0 := by
      intro m hm i
      by_contra hne
      have hmi : 1 ≤ m i := by
        rcases Nat.eq_zero_or_pos (m i) with h | h
        · exact absurd (by rw [h, Nat.cast_zero]) hne
        · exact h
      have hle : Finsupp.single i 1 ≤ m := by
        intro j
        by_cases hj : j = i
        · subst hj; simpa using hmi
        · rw [Finsupp.single_apply, if_neg (Ne.symm hj)]; exact Nat.zero_le _
      have hm' : (m - Finsupp.single i 1) + Finsupp.single i 1 = m := tsub_add_cancel_of_le hle
      have h0 : ((MvPolynomial.pderiv i) g).coeff (m - Finsupp.single i 1) = 0 := by
        rw [hall i]; simp
      rw [MvPolynomial.coeff_pderiv, hm'] at h0
      have hcast : ((((m - Finsupp.single i 1 : Fin (d + 1) →₀ ℕ)) i : ℕ) : κ) + 1 =
          ((m i : ℕ) : κ) := by
        rw [Finsupp.tsub_apply, Finsupp.single_eq_same, Nat.cast_sub hmi, Nat.cast_one,
          sub_add_cancel]
      rw [hcast] at h0
      exact (MvPolynomial.mem_support_iff.mp hm) ((mul_eq_zero.mp h0).resolve_right hne)
    rcases CharP.char_is_prime_or_zero κ (ringChar κ) with hp | hp
    · haveI : Fact (ringChar κ).Prime := ⟨hp⟩
      set p := ringChar κ with hpdef
      have hroot : ∀ c : κ, ∃ z : κ, z ^ p = c := fun c => IsAlgClosed.exists_pow_nat_eq c hp.pos
      choose r hr using hroot
      set h : MvPolynomial (Fin (d + 1)) κ := ∑ m ∈ g.support,
        MvPolynomial.monomial (Finsupp.mapRange (· / p) (Nat.zero_div p) m) (r (g.coeff m))
        with hh
      have hhp : h ^ p = g := by
        rw [hh, sum_pow_char]
        conv_rhs => rw [← MvPolynomial.support_sum_monomial_coeff g]
        apply Finset.sum_congr rfl
        intro m hm
        have hm' : p • Finsupp.mapRange (· / p) (Nat.zero_div p) m = m := by
          ext i
          rw [Finsupp.smul_apply, Finsupp.mapRange_apply, smul_eq_mul]
          exact Nat.mul_div_cancel' ((ringChar.spec κ (m i)).mp (hdiv m hm i))
        rw [MvPolynomial.monomial_pow, hr, hm']
      have hgeq : g = h * h ^ (p - 1) := by
        rw [← pow_succ', Nat.sub_add_cancel hp.one_lt.le, hhp]
      have hu : IsUnit h := by
        rcases hg.isUnit_or_isUnit hgeq with hu | hu
        · exact hu
        · exact (isUnit_pow_iff (by have := hp.two_le; omega)).mp hu
      exact hg.not_isUnit (hhp ▸ hu.pow p)
    · have hm0 : ∀ m ∈ g.support, m = 0 := by
        intro m hm
        ext i
        have := (ringChar.spec κ (m i)).mp (hdiv m hm i)
        rw [hp, zero_dvd_iff] at this
        simpa using this
      have hgC : g = MvPolynomial.C (g.coeff 0) := by
        ext m
        rw [MvPolynomial.coeff_C]
        split_ifs with h
        · rw [h]
        · by_contra hne
          exact h (hm0 m (MvPolynomial.mem_support_iff.mpr hne)).symm
      have hg' := hg
      rw [hgC] at hg'
      by_cases hc : g.coeff 0 = 0
      · rw [hc, map_zero] at hg'
        exact not_irreducible_zero hg'
      · exact hg'.not_isUnit ((Ne.isUnit hc).map MvPolynomial.C)

  have hs2 : ∀ i₀ : Fin (d + 1), MvPolynomial.pderiv i₀ g ≠ 0 →
      MvPolynomial.pderiv 1 (lwGenSection κ d g) ≠ 0 := by
    intro i₀ hi₀
    set ℓ : Fin (d + 1) → MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ) :=
      fun i => MvPolynomial.C (MvPolynomial.X ((0 : Fin 3), i)) +
        MvPolynomial.X 0 * MvPolynomial.C (MvPolynomial.X ((1 : Fin 3), i)) +
        MvPolynomial.X 1 * MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), i)) with hℓ
    have hℓd : ∀ n, MvPolynomial.pderiv 1 (ℓ n) =
        MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), n)) := by
      intro n
      simp [hℓ, MvPolynomial.pderiv_X]
    have chain : ∀ h : MvPolynomial (Fin (d + 1)) κ,
        MvPolynomial.pderiv 1 (MvPolynomial.aeval ℓ h) =
          ∑ i, MvPolynomial.aeval ℓ (MvPolynomial.pderiv i h) *
            MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), i)) := by
      intro h
      induction h using MvPolynomial.induction_on with
      | C a =>
        simp [MvPolynomial.algebraMap_eq]
      | add p q hp hq =>
        simp only [map_add, hp, hq, add_mul, Finset.sum_add_distrib]
      | mul_X p n hp =>
        have hterm : ∀ i, MvPolynomial.aeval ℓ (MvPolynomial.pderiv i (p * MvPolynomial.X n)) *
            MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), i)) =
            MvPolynomial.aeval ℓ (MvPolynomial.pderiv i p) *
              MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), i)) * ℓ n +
            (if n = i then MvPolynomial.aeval ℓ p *
              MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), i)) else 0) := by
          intro i
          rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X, map_add, map_mul, map_mul,
            MvPolynomial.aeval_X]
          by_cases h : n = i
          · subst h
            rw [Pi.single_eq_same, map_one, if_pos rfl]
            ring
          · rw [Pi.single_eq_of_ne h, map_zero, if_neg h]
            ring
        rw [Finset.sum_congr rfl (fun i _ => hterm i), Finset.sum_add_distrib, Finset.sum_ite_eq,
          if_pos (Finset.mem_univ _), ← Finset.sum_mul, map_mul, MvPolynomial.aeval_X,
          MvPolynomial.pderiv_mul, hp, hℓd]
    set ε : MvPolynomial (Fin 3 × Fin (d + 1)) κ →ₐ[κ] MvPolynomial (Fin 3 × Fin (d + 1)) κ :=
      MvPolynomial.aeval (fun p : Fin 3 × Fin (d + 1) =>
        if p.1 = 2 then (if p.2 = i₀ then 1 else 0) else MvPolynomial.X p) with hε
    set Φ : MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ) →+*
        MvPolynomial (Fin 3 × Fin (d + 1)) κ :=
      MvPolynomial.eval₂Hom ε.toRingHom (fun _ => 0) with hΦ
    have hΦℓ : Φ.comp (MvPolynomial.aeval ℓ).toRingHom =
        (MvPolynomial.rename (fun i : Fin (d + 1) => ((0 : Fin 3), i))).toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro c
        simp [hΦ, hε, MvPolynomial.algebraMap_eq]
      · intro i
        simp [hΦ, hε, hℓ]
    intro h0
    have h1 := congrArg Φ h0
    rw [lwGenSection, chain, map_sum, map_zero] at h1
    have h2 : ∀ i, Φ (MvPolynomial.aeval ℓ (MvPolynomial.pderiv i g) *
        MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), i))) =
        MvPolynomial.rename (fun i : Fin (d + 1) => ((0 : Fin 3), i)) (MvPolynomial.pderiv i g) *
          (if i = i₀ then 1 else 0) := by
      intro i
      rw [map_mul]
      congr 1
      · exact RingHom.congr_fun hΦℓ _
      · simp [hΦ, hε]
    simp only [h2, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ,
      if_true] at h1
    apply hi₀
    apply MvPolynomial.rename_injective (fun i : Fin (d + 1) => ((0 : Fin 3), i))
      (fun a b h => by simpa using h)
    rw [h1, map_zero]

  have hs5 : ∀ (K : Type u) [Field K] (H : Polynomial (Polynomial K)), Irreducible H →
      Polynomial.derivative H ≠ 0 → ∃ r : Polynomial K, r ≠ 0 ∧
      ∀ a : K, r.eval a ≠ 0 → (H.map (Polynomial.evalRingHom a)).Separable := by
    intro K _ H hH hder
    have hdeg : H.natDegree ≠ 0 := by
      intro h; apply hder; rw [Polynomial.eq_C_of_natDegree_eq_zero h, Polynomial.derivative_C]
    have hprim : H.IsPrimitive := hH.isPrimitive hdeg
    have hinj : Function.Injective (algebraMap (Polynomial K) (FractionRing (Polynomial K))) :=
      IsFractionRing.injective _ _
    have hirrF : Irreducible (H.map (algebraMap (Polynomial K) (FractionRing (Polynomial K)))) :=
      (hprim.irreducible_iff_irreducible_map_fraction_map).mp hH
    have hderF : Polynomial.derivative
        (H.map (algebraMap (Polynomial K) (FractionRing (Polynomial K)))) ≠ 0 := by
      rw [Polynomial.derivative_map]
      exact (Polynomial.map_ne_zero_iff hinj).mpr hder
    have hsepF := (Polynomial.separable_iff_derivative_ne_zero hirrF).mpr hderF
    rw [Polynomial.separable_def] at hsepF
    obtain ⟨α', β', hab⟩ := hsepF
    obtain ⟨b, hbM, hb⟩ := IsLocalization.integerNormalization_spec
      (nonZeroDivisors (Polynomial K)) α'
    obtain ⟨b', hb'M, hb'⟩ := IsLocalization.integerNormalization_spec
      (nonZeroDivisors (Polynomial K)) β'
    set α₀ := IsLocalization.integerNormalization (nonZeroDivisors (Polynomial K)) α'
    set β₀ := IsLocalization.integerNormalization (nonZeroDivisors (Polynomial K)) β'
    have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hbM
    have hb'0 : b' ≠ 0 := nonZeroDivisors.ne_zero hb'M
    refine ⟨b * b', mul_ne_zero hb0 hb'0, ?_⟩
    have hrel : Polynomial.C b' * α₀ * H +
        Polynomial.C b * β₀ * Polynomial.derivative H =
        Polynomial.C (b * b') := by
      apply Polynomial.map_injective _ hinj
      simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, hb, hb',
        ← Polynomial.derivative_map, Algebra.smul_def,
        Polynomial.algebraMap_apply, map_mul]
      linear_combination
        (Polynomial.C (algebraMap (Polynomial K) (FractionRing (Polynomial K)) b') *
          Polynomial.C (algebraMap (Polynomial K) (FractionRing (Polynomial K)) b)) * hab
    intro a ha
    have hspec := congrArg (Polynomial.map (Polynomial.evalRingHom a)) hrel
    simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C,
      ← Polynomial.derivative_map] at hspec
    rw [Polynomial.separable_def]
    set e := Polynomial.evalRingHom a (b * b')
    have he : e ≠ 0 := ha
    have hCe : Polynomial.C e⁻¹ * Polynomial.C e = 1 := by
      rw [← Polynomial.C_mul, inv_mul_cancel₀ he, Polynomial.C_1]
    refine ⟨Polynomial.C e⁻¹ * (Polynomial.C (Polynomial.evalRingHom a b') *
        α₀.map (Polynomial.evalRingHom a)),
      Polynomial.C e⁻¹ * (Polynomial.C (Polynomial.evalRingHom a b) *
        β₀.map (Polynomial.evalRingHom a)), ?_⟩
    linear_combination Polynomial.C e⁻¹ * hspec + hCe

  have hs6 : ∀ (K : Type u) [Field K] [Algebra K L] (p : Polynomial K), p.Separable →
      ∀ f : Polynomial L, f.Monic → f ∣ p.map (algebraMap K L) →
      ∀ j : ℕ, IsSeparable K (f.coeff j) := by
    intro K _ _ p hp f hf hdvd j
    have hroots : ∀ ρ ∈ (f.map (algebraMap L (AlgebraicClosure L))).roots,
        ρ ∈ separableClosure K (AlgebraicClosure L) := by
      intro ρ hρ
      rw [mem_separableClosure_iff]
      have h1 : f.map (algebraMap L (AlgebraicClosure L)) ∣
          p.map (algebraMap K (AlgebraicClosure L)) := by
        rw [IsScalarTower.algebraMap_eq K L (AlgebraicClosure L), ← Polynomial.map_map]
        exact Polynomial.map_dvd _ hdvd
      have hfΩ0 : f.map (algebraMap L (AlgebraicClosure L)) ≠ 0 := (hf.map _).ne_zero
      have hr : Polynomial.aeval ρ p = 0 := by
        rw [← Polynomial.eval_map_algebraMap]
        exact Polynomial.eval_eq_zero_of_dvd_of_eval_eq_zero h1
          ((Polynomial.mem_roots hfΩ0).mp hρ)
      exact hp.of_dvd (minpoly.dvd K ρ hr)
    have hsplit : f.map (algebraMap L (AlgebraicClosure L)) =
        ((f.map (algebraMap L (AlgebraicClosure L))).roots.map
        (fun ρ => Polynomial.X - Polynomial.C ρ)).prod :=
      (Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq (hf.map _)
        (IsAlgClosed.card_roots_eq_natDegree)).symm
    have hlift : f.map (algebraMap L (AlgebraicClosure L)) ∈
        Polynomial.lifts (algebraMap (separableClosure K (AlgebraicClosure L))
          (AlgebraicClosure L)) := by
      rw [hsplit]
      refine Subsemiring.multiset_prod_mem _ _ (fun q hq => ?_)
      obtain ⟨ρ, hρ, rfl⟩ := Multiset.mem_map.mp hq
      rw [sub_eq_add_neg, ← map_neg]
      refine Subsemiring.add_mem _ (Polynomial.X_mem_lifts _) ?_
      have : -ρ ∈ separableClosure K (AlgebraicClosure L) := neg_mem (hroots ρ hρ)
      exact ⟨Polynomial.C ⟨-ρ, this⟩, by simp⟩
    rw [Polynomial.lifts_iff_coeff_lifts] at hlift
    obtain ⟨x, hx⟩ := hlift j
    rw [Polynomial.coeff_map] at hx
    have hmem : algebraMap L (AlgebraicClosure L) (f.coeff j) ∈
        separableClosure K (AlgebraicClosure L) := by
      rw [← hx]; exact x.2
    rw [mem_separableClosure_iff] at hmem
    exact IsSeparable.of_algHom K (IsScalarTower.toAlgHom K L (AlgebraicClosure L)) hmem

  have hs7 : ∀ (S : Subfield L) (e : ℕ) (π : Polynomial L), π.natDegree ≤ e →
      ∀ s : Finset L, e + 1 ≤ s.card → (∀ a ∈ s, a ∈ S) → (∀ a ∈ s, π.eval a ∈ S) →
      ∀ i, π.coeff i ∈ S := by
    intro S e
    induction e with
    | zero =>
      intro π hπ s hs hsS hval
      obtain ⟨a, ha⟩ : s.Nonempty := Finset.card_pos.mp (by omega)
      have hC := Polynomial.eq_C_of_natDegree_le_zero hπ
      intro i
      rw [hC, Polynomial.coeff_C]
      split_ifs
      · have := hval a ha
        rw [hC, Polynomial.eval_C] at this
        exact this
      · exact S.zero_mem
    | succ e ih =>
      intro π hπ s hs hsS hval
      obtain ⟨a₀, ha₀⟩ : s.Nonempty := Finset.card_pos.mp (by omega)
      obtain ⟨c, hc⟩ : ∃ c, c = π.eval a₀ := ⟨_, rfl⟩
      obtain ⟨π₁, hπ₁⟩ : ∃ π₁, π₁ = (π - Polynomial.C c) /ₘ (Polynomial.X - Polynomial.C a₀) :=
        ⟨_, rfl⟩
      have hroot : (π - Polynomial.C c).IsRoot a₀ := by
        rw [Polynomial.IsRoot.def, Polynomial.eval_sub, Polynomial.eval_C, hc, sub_self]
      have hdecomp : (Polynomial.X - Polynomial.C a₀) * π₁ = π - Polynomial.C c := by
        rw [hπ₁]; exact Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hroot
      have hdeg1 : π₁.natDegree ≤ e := by
        rw [hπ₁, Polynomial.natDegree_divByMonic _ (Polynomial.monic_X_sub_C a₀),
          Polynomial.natDegree_X_sub_C]
        have : (π - Polynomial.C c).natDegree ≤ e + 1 :=
          (Polynomial.natDegree_sub_le _ _).trans (by simp [hπ])
        omega
      have hcS : c ∈ S := hc ▸ hval a₀ ha₀
      have ha₀S : a₀ ∈ S := hsS a₀ ha₀
      have h1 := ih π₁ hdeg1 (s.erase a₀) (by rw [Finset.card_erase_of_mem ha₀]; omega)
        (fun a ha => hsS a (Finset.mem_of_mem_erase ha)) (fun a ha => by
          have hne : a - a₀ ≠ 0 := sub_ne_zero.mpr (Finset.ne_of_mem_erase ha)
          have he := congrArg (Polynomial.eval a) hdecomp
          simp only [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X,
            Polynomial.eval_C] at he
          have : π₁.eval a = (π.eval a - c) / (a - a₀) := by
            rw [eq_div_iff hne, ← he]; ring
          rw [this]
          exact S.div_mem (S.sub_mem (hval a (Finset.mem_of_mem_erase ha)) hcS)
            (S.sub_mem (hsS a (Finset.mem_of_mem_erase ha)) ha₀S))
      have hπeq : π = Polynomial.C c + (Polynomial.X * π₁ - Polynomial.C a₀ * π₁) := by
        rw [← sub_mul, hdecomp]; ring
      intro i
      rw [hπeq, Polynomial.coeff_add, Polynomial.coeff_sub, Polynomial.coeff_C_mul,
        Polynomial.coeff_C]
      refine S.add_mem ?_ (S.sub_mem ?_ (S.mul_mem ha₀S (h1 i)))
      · split_ifs
        · exact hcS
        · exact S.zero_mem
      · cases i with
        | zero => simp
        | succ i => rw [Polynomial.coeff_X_mul]; exact h1 i

  have hdecomp : ∀ m : Fin 2 →₀ ℕ, m = Finsupp.single 0 (m 0) + Finsupp.single 1 (m 1) := by
    intro m; ext x; fin_cases x <;> simp
  have hcoef : ∀ (A : Type u) [CommRing A] (F : MvPolynomial (Fin 2) A) (i j : ℕ),
      ((lwGsfsBiv A F).coeff j).coeff i = F.coeff (Finsupp.single 0 i + Finsupp.single 1 j) := by
    intro A _ F i j
    refine MvPolynomial.induction_on' F (fun m c => ?_) (fun p q hp hq => ?_)
    · have key : (m = Finsupp.single 0 i + Finsupp.single 1 j) ↔ (j = m 1 ∧ i = m 0) := by
        constructor
        · rintro rfl; simp
        · rintro ⟨h1, h0⟩; rw [h1, h0]; exact hdecomp m
      have hΨ : lwGsfsBiv A (MvPolynomial.monomial m c) =
          Polynomial.C (Polynomial.C c * Polynomial.X ^ (m 0)) * Polynomial.X ^ (m 1) := by
        rw [lwGsfsBiv, MvPolynomial.aeval_monomial,
          Finsupp.prod_fintype _ _ (fun _ => pow_zero _), Fin.prod_univ_two]
        simp [Polynomial.C_mul, Polynomial.C_pow, mul_assoc]
      rw [hΨ, Polynomial.coeff_C_mul_X_pow, MvPolynomial.coeff_monomial]
      by_cases h1 : j = m 1
      · rw [if_pos h1, Polynomial.coeff_C_mul_X_pow]
        by_cases h0 : i = m 0
        · rw [if_pos h0, if_pos (key.mpr ⟨h1, h0⟩)]
        · rw [if_neg h0, if_neg (fun h => h0 (key.mp h).2)]
      · rw [if_neg h1, Polynomial.coeff_zero, if_neg (fun h => h1 (key.mp h).1)]
    · rw [map_add, Polynomial.coeff_add, Polynomial.coeff_add, hp, hq, MvPolynomial.coeff_add]
  have hinjΨ : ∀ (A : Type u) [CommRing A], Function.Injective (lwGsfsBiv A) := by
    intro A _ F F' h
    ext m
    rw [hdecomp m, ← hcoef A F, ← hcoef A F', h]
  have hsurjΨ : ∀ (A : Type u) [CommRing A], Function.Surjective (lwGsfsBiv A) := by
    intro A _ p
    refine ⟨Polynomial.eval₂RingHom (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0))
      (MvPolynomial.X 1) p, ?_⟩
    have hc : ((lwGsfsBiv A).toRingHom.comp (Polynomial.eval₂RingHom
        (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)) (MvPolynomial.X 1))) =
        RingHom.id _ := by
      apply Polynomial.ringHom_ext'
      · apply Polynomial.ringHom_ext'
        · ext a; simp [lwGsfsBiv]
        · simp [lwGsfsBiv]
      · simp [lwGsfsBiv]
    exact RingHom.congr_fun hc p
  have hderΨ : ∀ (A : Type u) [CommRing A] (F : MvPolynomial (Fin 2) A),
      lwGsfsBiv A (MvPolynomial.pderiv 1 F) = Polynomial.derivative (lwGsfsBiv A F) := by
    intro A _ F
    ext j i
    rw [hcoef, Polynomial.coeff_derivative, ← Nat.cast_succ, Polynomial.coeff_mul_natCast, hcoef,
      MvPolynomial.coeff_pderiv, add_assoc, ← Finsupp.single_add]
    simp
  have hdeg0 : ∀ (A : Type u) [CommRing A] (F : MvPolynomial (Fin 2) A) (N i j : ℕ),
      F.totalDegree ≤ N → N < i + j →
        F.coeff (Finsupp.single 0 i + Finsupp.single 1 j) = 0 := by
    intro A _ F N i j hF hN
    by_contra hne
    have := MvPolynomial.le_totalDegree (MvPolynomial.mem_support_iff.mpr hne)
    rw [Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl), Finsupp.sum_single_index rfl,
      Finsupp.sum_single_index rfl] at this
    omega
  have hΨhigh : ∀ (A : Type u) [CommRing A] (F : MvPolynomial (Fin 2) A) (N j : ℕ),
      F.totalDegree ≤ N → N < j → (lwGsfsBiv A F).coeff j = 0 := by
    intro A _ F N j hF hj
    ext i
    rw [hcoef, hdeg0 A F N i j hF (by omega), Polynomial.coeff_zero]
  have hΨtop : ∀ (A : Type u) [CommRing A] (F : MvPolynomial (Fin 2) A) (N : ℕ),
      F.totalDegree ≤ N →
        (lwGsfsBiv A F).coeff N = Polynomial.C (F.coeff (Finsupp.single 1 N)) := by
    intro A _ F N hF
    ext i
    rw [hcoef, Polynomial.coeff_C]
    rcases Nat.eq_zero_or_pos i with rfl | hi
    · simp
    · rw [if_neg (by omega), hdeg0 A F N i N hF (by omega)]
  have hΨnat : ∀ (A : Type u) [CommRing A] (F : MvPolynomial (Fin 2) A) (N j : ℕ),
      F.totalDegree ≤ N → ((lwGsfsBiv A F).coeff j).natDegree ≤ N := by
    intro A _ F N j hF
    rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
    intro i hi
    rw [hcoef]
    exact hdeg0 A F N i j hF (by omega)
  have hΨdeg : ∀ (A : Type u) [CommRing A] (F : MvPolynomial (Fin 2) A) (N : ℕ),
      F.totalDegree ≤ N → (lwGsfsBiv A F).natDegree ≤ N := by
    intro A _ F N hF
    rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
    intro j hj
    exact hΨhigh A F N j hF hj
  have hΨmap : ∀ (A B : Type u) [CommRing A] [CommRing B] (φ : A →+* B)
      (F : MvPolynomial (Fin 2) A),
      lwGsfsBiv B (MvPolynomial.map φ F) = (lwGsfsBiv A F).map (Polynomial.mapRingHom φ) := by
    intro A B _ _ φ F
    ext j i
    rw [hcoef, MvPolynomial.coeff_map, Polynomial.coeff_map, Polynomial.coe_mapRingHom,
      Polynomial.coeff_map, hcoef]
  have hΨC : ∀ (A : Type u) [CommRing A] (x : A),
      lwGsfsBiv A (MvPolynomial.C x) = Polynomial.C (Polynomial.C x) := by
    intro A _ x
    rw [lwGsfsBiv, MvPolynomial.aeval_C, Polynomial.algebraMap_apply, Polynomial.algebraMap_apply]
    rfl

  have key : ∀ (K : Type u) [Field K] [Infinite K] [Algebra K L] (D : ℕ)
      (G : MvPolynomial (Fin 2) K),
      Irreducible G → MvPolynomial.pderiv 1 G ≠ 0 → k + l = D →
      MvPolynomial.map (algebraMap K L) G =
        MvPolynomial.C (algebraMap K L (G.coeff (Finsupp.single 1 D))) * P * Q →
      ∀ m, IsSeparable K (P.coeff m) ∧ IsSeparable K (Q.coeff m) := by
    intro K _ _ _ D G hGirr hGder hklD hfacK
    set c := G.coeff (Finsupp.single 1 D) with hc
    set H := lwGsfsBiv K G with hH
    have hHirr : Irreducible H :=
      (MulEquiv.irreducible_iff
        (AlgEquiv.ofBijective (lwGsfsBiv K) ⟨hinjΨ K, hsurjΨ K⟩) (x := G)).mpr hGirr
    have hHder : Polynomial.derivative H ≠ 0 := by
      rw [hH, ← hderΨ]
      intro h
      apply hGder
      exact hinjΨ K (h.trans (map_zero _).symm)
    obtain ⟨r, hr0, hr⟩ := hs5 K H hHirr hHder
    obtain ⟨s, hsS, hscard⟩ :=
      (Polynomial.finite_setOfPred_isRoot hr0).infinite_compl.exists_subset_card_eq (D + 1)
    have hgood : ∀ a ∈ s, r.eval a ≠ 0 := by
      intro a ha
      have := hsS ha
      simpa [Polynomial.IsRoot] using this
    set j := algebraMap K L with hj
    have hΨfac : H.map (Polynomial.mapRingHom j) =
        Polynomial.C (Polynomial.C (j c)) * lwGsfsBiv L P * lwGsfsBiv L Q := by
      have := congrArg (lwGsfsBiv L) hfacK
      rw [hΨmap K L j G, map_mul, map_mul, hΨC] at this
      exact this
    have hspec : ∀ a : K, (H.map (Polynomial.mapRingHom j)).map (Polynomial.evalRingHom (j a)) =
        (H.map (Polynomial.evalRingHom a)).map j := by
      intro a
      rw [Polynomial.map_map, Polynomial.map_map]
      congr 1
      apply RingHom.ext
      intro p
      simp only [RingHom.comp_apply, Polynomial.coe_mapRingHom, Polynomial.coe_evalRingHom]
      rw [Polynomial.eval_map, Polynomial.eval₂_at_apply]
    have hfacA : ∀ a : K, (H.map (Polynomial.evalRingHom a)).map j =
        Polynomial.C (j c) * (lwGsfsBiv L P).map (Polynomial.evalRingHom (j a)) *
          (lwGsfsBiv L Q).map (Polynomial.evalRingHom (j a)) := by
      intro a
      rw [← hspec, hΨfac, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_C]
      simp
    have side : ∀ (F : MvPolynomial (Fin 2) L) (e : ℕ), F.totalDegree ≤ e → e ≤ D →
        F.coeff (Finsupp.single 1 e) = 1 →
        (∀ a ∈ s, (lwGsfsBiv L F).map (Polynomial.evalRingHom (j a)) ∣
          (H.map (Polynomial.evalRingHom a)).map j) →
        ∀ m, IsSeparable K (F.coeff m) := by
      intro F e hFe heD hF1 hdvd
      have hsepA : ∀ a ∈ s, ∀ j' : ℕ,
          IsSeparable K (((lwGsfsBiv L F).coeff j').eval (j a)) := by
        intro a ha j'
        have hmon : ((lwGsfsBiv L F).map (Polynomial.evalRingHom (j a))).Monic := by
          refine Polynomial.monic_of_natDegree_le_of_coeff_eq_one e
            (le_trans (Polynomial.natDegree_map_le) (hΨdeg L F e hFe)) ?_
          rw [Polynomial.coeff_map, hΨtop L F e hFe, hF1]
          simp
        have := hs6 K _ (hr a (hgood a ha)) _ hmon (hdvd a ha) j'
        rwa [Polynomial.coeff_map, Polynomial.coe_evalRingHom] at this
      have hint : ∀ j' i : ℕ,
          ((lwGsfsBiv L F).coeff j').coeff i ∈ (separableClosure K L).toSubfield := by
        intro j'
        refine hs7 (separableClosure K L).toSubfield e
          ((lwGsfsBiv L F).coeff j') (hΨnat L F e j' hFe) (s.image j) ?_ ?_ ?_
        · rw [Finset.card_image_of_injective _ j.injective, hscard]
          omega
        · intro a ha
          obtain ⟨b, -, rfl⟩ := Finset.mem_image.mp ha
          rw [IntermediateField.mem_toSubfield]
          exact IntermediateField.algebraMap_mem _ b
        · intro a ha
          obtain ⟨b, hb, rfl⟩ := Finset.mem_image.mp ha
          rw [IntermediateField.mem_toSubfield, mem_separableClosure_iff]
          exact hsepA b hb j'
      intro m
      have h := hint (m 1) (m 0)
      rw [hcoef, ← hdecomp m, IntermediateField.mem_toSubfield, mem_separableClosure_iff] at h
      exact h
    intro m
    constructor
    · refine side P k hP1 (by omega) hP2 (fun a _ => ?_) m
      rw [hfacA a]
      exact Dvd.intro (Polynomial.C (j c) *
        (lwGsfsBiv L Q).map (Polynomial.evalRingHom (j a))) (by ring)
    · refine side Q l hQ1 (by omega) hQ2 (fun a _ => ?_) m
      rw [hfacA a]
      exact Dvd.intro (Polynomial.C (j c) *
        (lwGsfsBiv L P).map (Polynomial.evalRingHom (j a))) (by ring)

  have hι : Function.Injective (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
      (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ))) := IsFractionRing.injective _ _
  haveI : Infinite (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) :=
    Infinite.of_injective _ hι
  obtain ⟨i₀, hi₀⟩ := hs1
  have hv := hs2 i₀ hi₀
  refine key (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) g.totalDegree
    (MvPolynomial.map (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
      (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ))) (lwGenSection κ d g)) hK ?_ hkl ?_
  · intro h
    apply hv
    apply MvPolynomial.map_injective _ hι
    rw [← MvPolynomial.pderiv_map, h, map_zero]
  · rw [MvPolynomial.map_map, MvPolynomial.coeff_map, hfac]
    rfl

theorem lw_shear_independent (κ : Type u) [Field κ] (d : ℕ)
    (g : MvPolynomial (Fin (d + 1)) κ) (hg : Irreducible g) (hD : 1 ≤ g.totalDegree) :
    ∃ (Ω : Type u) (_ : Field Ω) (_ : Algebra κ Ω) (x B C : Fin (d + 1) → Ω) (u v : Ω),
      MvPolynomial.aeval x g = 0 ∧
      IntermediateField.adjoin κ (Set.range x ∪ Set.range B ∪ Set.range C ∪ {u, v}) = ⊤ ∧
      AlgebraicIndependent κ (fun o : Option (Fin 3 × Fin (d + 1)) => o.elim u
        (fun q => ![fun i => x i - u * B i - v * C i, B, C] q.1 q.2)) ∧
      AlgebraicIndependent (IntermediateField.adjoin κ (Set.range x ∪ {u, v}))
        (fun q : Fin 2 × Fin (d + 1) => ![B, C] q.1 q.2) :=
by
  classical

  have s0 : Function.Surjective ((MvPolynomial.mapAlgHom (Ideal.Quotient.mkₐ κ (Ideal.span {g}))).comp
      (MvPolynomial.sumAlgEquiv κ ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (Fin (d + 1))).toAlgHom) ∧
    (∀ s, MvPolynomial.mapAlgHom (Ideal.Quotient.mkₐ κ (Ideal.span {g}))
        (MvPolynomial.sumAlgEquiv κ ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (Fin (d + 1))
          (MvPolynomial.X (Sum.inl s))) = MvPolynomial.X s) ∧
    (∀ i, MvPolynomial.mapAlgHom (Ideal.Quotient.mkₐ κ (Ideal.span {g}))
        (MvPolynomial.sumAlgEquiv κ ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (Fin (d + 1))
          (MvPolynomial.X (Sum.inr i))) =
        MvPolynomial.C (Ideal.Quotient.mk (Ideal.span {g}) (MvPolynomial.X i))) ∧
    MvPolynomial.mapAlgHom (Ideal.Quotient.mkₐ κ (Ideal.span {g}))
        (MvPolynomial.sumAlgEquiv κ ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (Fin (d + 1))
          (MvPolynomial.rename Sum.inr g)) = 0 := by
    have hinl : ∀ p : MvPolynomial ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) κ,
        MvPolynomial.sumAlgEquiv κ ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (Fin (d + 1))
          (MvPolynomial.rename Sum.inl p) = MvPolynomial.map (algebraMap κ _) p := by
      intro p
      have := AlgHom.congr_fun
        (MvPolynomial.sumAlgEquiv_comp_rename_inl κ ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (Fin (d + 1))) p
      simpa [MvPolynomial.mapAlgHom_apply] using this
    have hinr : ∀ p : MvPolynomial (Fin (d + 1)) κ,
        MvPolynomial.sumAlgEquiv κ ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (Fin (d + 1))
          (MvPolynomial.rename Sum.inr p) = MvPolynomial.C p := by
      intro p
      have := AlgHom.congr_fun
        (MvPolynomial.sumAlgEquiv_comp_rename_inr κ ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (Fin (d + 1))) p
      simpa [MvPolynomial.algebraMap_eq] using this
    refine ⟨?_, ?_, ?_, ?_⟩
    · exact (MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective).comp
        (MvPolynomial.sumAlgEquiv κ ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (Fin (d + 1))).surjective
    · intro s
      have := hinl (MvPolynomial.X s)
      rw [MvPolynomial.rename_X, MvPolynomial.map_X] at this
      rw [this, MvPolynomial.mapAlgHom_apply, MvPolynomial.map_X]
    · intro i
      have := hinr (MvPolynomial.X i)
      rw [MvPolynomial.rename_X] at this
      rw [this, MvPolynomial.mapAlgHom_apply, MvPolynomial.map_C]
      rfl
    · rw [hinr, MvPolynomial.mapAlgHom_apply, MvPolynomial.map_C, MvPolynomial.C_eq_zero]
      have : Ideal.Quotient.mk (Ideal.span {g}) g = 0 := by
        rw [Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mem_span_singleton_self g
      exact this

  have s1 : ∀ (h : MvPolynomial (((Fin 2 × Fin (d + 1)) ⊕ Fin 2) ⊕ Fin (d + 1)) κ),
      MvPolynomial.mapAlgHom (Ideal.Quotient.mkₐ κ (Ideal.span {g}))
        (MvPolynomial.sumAlgEquiv κ ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (Fin (d + 1)) h) = 0 →
      ∃ q : MvPolynomial (((Fin 2 × Fin (d + 1)) ⊕ Fin 2) ⊕ Fin (d + 1)) κ,
        h = q * MvPolynomial.rename Sum.inr g := by
    intro h hh
    set e := MvPolynomial.sumAlgEquiv κ ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (Fin (d + 1)) with he
    have hinr : e (MvPolynomial.rename Sum.inr g) = MvPolynomial.C g := by
      have := AlgHom.congr_fun
        (MvPolynomial.sumAlgEquiv_comp_rename_inr κ ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (Fin (d + 1))) g
      simpa [MvPolynomial.algebraMap_eq] using this
    have hmem : e h ∈ RingHom.ker (MvPolynomial.map (σ := (Fin 2 × Fin (d + 1)) ⊕ Fin 2)
        (Ideal.Quotient.mk (Ideal.span {g}))) := by
      rw [RingHom.mem_ker]
      rw [MvPolynomial.mapAlgHom_apply] at hh
      exact hh
    rw [MvPolynomial.ker_map, Ideal.mk_ker, Ideal.map_span, Set.image_singleton,
      Ideal.mem_span_singleton'] at hmem
    obtain ⟨a, ha⟩ := hmem
    refine ⟨e.symm a, ?_⟩
    apply e.injective
    rw [map_mul, AlgEquiv.apply_symm_apply, hinr, ha]

  have s2 : ∀ (H Q : MvPolynomial (((Fin 2 × Fin (d + 1)) ⊕ Fin 2) ⊕ Fin (d + 1)) κ),
      H = Q * MvPolynomial.aeval (fun i : Fin (d + 1) =>
        (MvPolynomial.X (Sum.inr i) +
          MvPolynomial.X (Sum.inl (Sum.inr 0)) * MvPolynomial.X (Sum.inl (Sum.inl (0, i))) +
          MvPolynomial.X (Sum.inl (Sum.inr 1)) * MvPolynomial.X (Sum.inl (Sum.inl (1, i))) :
            MvPolynomial (((Fin 2 × Fin (d + 1)) ⊕ Fin 2) ⊕ Fin (d + 1)) κ)) g →
      MvPolynomial.degreeOf (Sum.inl (Sum.inr 1)) H = 0 → H = 0 := by
    intro H Q hHQ hH
    set G := MvPolynomial.aeval (fun i : Fin (d + 1) =>
        (MvPolynomial.X (Sum.inr i) +
          MvPolynomial.X (Sum.inl (Sum.inr 0)) * MvPolynomial.X (Sum.inl (Sum.inl (0, i))) +
          MvPolynomial.X (Sum.inl (Sum.inr 1)) * MvPolynomial.X (Sum.inl (Sum.inl (1, i))) :
            MvPolynomial (((Fin 2 × Fin (d + 1)) ⊕ Fin 2) ⊕ Fin (d + 1)) κ)) g with hGdef
    let sc : MvPolynomial (Fin (d + 1)) κ →
        (((Fin 2 × Fin (d + 1)) ⊕ Fin 2) ⊕ Fin (d + 1)) → MvPolynomial (Fin (d + 1)) κ :=
      fun c => Sum.elim (Sum.elim (fun p => if p.1 = 1 then MvPolynomial.X p.2 else 0)
        (fun j => if j = 1 then c else 0)) (fun _ => 0)
    have hev : ∀ c, MvPolynomial.aeval (sc c) G =
        MvPolynomial.aeval (fun i => c * MvPolynomial.X i) g := by
      intro c
      rw [hGdef, ← AlgHom.comp_apply, MvPolynomial.comp_aeval]
      congr 2
      funext i
      simp [sc]
    have hclaim : MvPolynomial.degreeOf (Sum.inl (Sum.inr 1)) G ≠ 0 := by
      intro h0
      have heq : MvPolynomial.aeval (sc 1) G = MvPolynomial.aeval (sc 0) G := by
        apply MvPolynomial.hom_congr_vars
        · ext r
          simp
        · intro i hi _
          have hne : i ≠ Sum.inl (Sum.inr 1) := by
            rintro rfl
            obtain ⟨m, hm, hmi⟩ := (MvPolynomial.mem_vars _).mp hi
            have := MvPolynomial.monomial_le_degreeOf (Sum.inl (Sum.inr 1)) hm
            rw [h0] at this
            exact (Finsupp.mem_support_iff.mp hmi) (by omega)
          rcases i with (p | j) | i
          · simp [sc]
          · have hj : j ≠ 1 := fun h => hne (by rw [h])
            simp [sc, hj]
          · simp [sc]
        · rfl
      rw [hev, hev] at heq
      simp only [one_mul, zero_mul] at heq
      rw [MvPolynomial.aeval_X_left_apply] at heq
      have h0' : MvPolynomial.aeval (fun _ : Fin (d + 1) => (0 : MvPolynomial (Fin (d + 1)) κ)) g =
          MvPolynomial.C (MvPolynomial.constantCoeff g) := by
        have := MvPolynomial.aeval_zero (R := κ) (S₁ := MvPolynomial (Fin (d + 1)) κ) g
        rw [MvPolynomial.algebraMap_eq] at this
        exact this
      rw [h0'] at heq
      have := congrArg MvPolynomial.totalDegree heq
      rw [MvPolynomial.totalDegree_C] at this
      omega
    by_contra hne
    have hQ : Q ≠ 0 := by
      rintro rfl
      exact hne (by rw [hHQ, zero_mul])
    have hG : G ≠ 0 := by
      rintro h
      exact hclaim (by rw [h]; simp)
    rw [hHQ, MvPolynomial.degreeOf_mul_eq hQ hG] at hH
    omega

  have s3 : ∀ (A : Type u) [CommRing A] [Algebra κ A]
      (Φ : MvPolynomial (((Fin 2 × Fin (d + 1)) ⊕ Fin 2) ⊕ Fin (d + 1)) κ →ₐ[κ] A)
      (x B C : Fin (d + 1) → A) (u v : A),
      (∀ i, Φ (MvPolynomial.X (Sum.inr i)) = x i) →
      (∀ i, Φ (MvPolynomial.X (Sum.inl (Sum.inl (0, i)))) = B i) →
      (∀ i, Φ (MvPolynomial.X (Sum.inl (Sum.inl (1, i)))) = C i) →
      Φ (MvPolynomial.X (Sum.inl (Sum.inr 0))) = u →
      Φ (MvPolynomial.X (Sum.inl (Sum.inr 1))) = v →
      (∀ h, Φ h = 0 → ∃ q, h = q * MvPolynomial.rename Sum.inr g) →
      AlgebraicIndependent κ (fun o : Option (Fin 3 × Fin (d + 1)) => o.elim u
          (fun q => ![fun i => x i - u * B i - v * C i, B, C] q.1 q.2)) := by
    intro A _ _ Φ x B C u v hx hB hC hu hv hker
    rw [algebraicIndependent_iff]
    intro F hF
    let σ : Option (Fin 3 × Fin (d + 1)) →
        MvPolynomial (((Fin 2 × Fin (d + 1)) ⊕ Fin 2) ⊕ Fin (d + 1)) κ :=
      fun o => o.elim (MvPolynomial.X (Sum.inl (Sum.inr 0))) (fun q =>
        ![fun i => MvPolynomial.X (Sum.inr i) -
            MvPolynomial.X (Sum.inl (Sum.inr 0)) * MvPolynomial.X (Sum.inl (Sum.inl (0, i))) -
            MvPolynomial.X (Sum.inl (Sum.inr 1)) * MvPolynomial.X (Sum.inl (Sum.inl (1, i))),
          fun i => MvPolynomial.X (Sum.inl (Sum.inl (0, i))),
          fun i => MvPolynomial.X (Sum.inl (Sum.inl (1, i)))] q.1 q.2)
    have hΦσ : (fun o => Φ (σ o)) = (fun o : Option (Fin 3 × Fin (d + 1)) => o.elim u
          (fun q => ![fun i => x i - u * B i - v * C i, B, C] q.1 q.2)) := by
      funext o
      rcases o with _ | ⟨j, i⟩
      · simp [σ, hu]
      · fin_cases j <;> simp [σ, hx, hB, hC, hu, hv]
    have h1 : Φ (MvPolynomial.aeval σ F) = 0 := by
      rw [← AlgHom.comp_apply, MvPolynomial.comp_aeval, hΦσ]
      exact hF
    obtain ⟨q, hq⟩ := hker _ h1
    let shear : Fin (d + 1) → MvPolynomial (((Fin 2 × Fin (d + 1)) ⊕ Fin 2) ⊕ Fin (d + 1)) κ :=
      fun i => MvPolynomial.X (Sum.inr i) +
            MvPolynomial.X (Sum.inl (Sum.inr 0)) * MvPolynomial.X (Sum.inl (Sum.inl (0, i))) +
            MvPolynomial.X (Sum.inl (Sum.inr 1)) * MvPolynomial.X (Sum.inl (Sum.inl (1, i)))
    let τ := MvPolynomial.aeval (R := κ)
      (Sum.elim (fun s => (MvPolynomial.X (Sum.inl s) :
        MvPolynomial (((Fin 2 × Fin (d + 1)) ⊕ Fin 2) ⊕ Fin (d + 1)) κ)) shear)
    let ι : Option (Fin 3 × Fin (d + 1)) → ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) ⊕ Fin (d + 1) :=
      fun o => o.elim (Sum.inl (Sum.inr 0)) (fun q =>
        ![fun i => Sum.inr i, fun i => Sum.inl (Sum.inl (0, i)),
          fun i => Sum.inl (Sum.inl (1, i))] q.1 q.2)
    have hτσ : (fun o => τ (σ o)) = (fun o => MvPolynomial.X (ι o)) := by
      funext o
      rcases o with _ | ⟨j, i⟩
      · simp [σ, τ, ι]
      · fin_cases j <;> simp [σ, τ, ι, shear] <;> ring
    have hτg : τ (MvPolynomial.rename Sum.inr g) = MvPolynomial.aeval shear g := by
      simp only [τ, MvPolynomial.aeval_rename, Sum.elim_comp_inr]
    have hren : MvPolynomial.rename ι F = τ q * MvPolynomial.aeval shear g := by
      have h2 : τ (MvPolynomial.aeval σ F) = MvPolynomial.rename ι F := by
        rw [← AlgHom.comp_apply, MvPolynomial.comp_aeval, hτσ,
          ← MvPolynomial.aeval_X_left_apply (MvPolynomial.rename ι F), MvPolynomial.aeval_rename]
        rfl
      rw [← h2, hq, map_mul, hτg]
    have hιinj : Function.Injective ι := by
      rintro (_ | ⟨j, i⟩) (_ | ⟨j', i'⟩) h
      · rfl
      · fin_cases j' <;> simp [ι] at h
      · fin_cases j <;> simp [ι] at h
      · fin_cases j <;> fin_cases j' <;> simp [ι] at h <;> subst h <;> rfl
    have hW : Sum.inl (Sum.inr 1) ∉ Set.range ι := by
      rintro ⟨(_ | ⟨j, i⟩), h⟩
      · simp [ι] at h
      · fin_cases j <;> simp [ι] at h
    have hdeg : MvPolynomial.degreeOf (Sum.inl (Sum.inr 1)) (MvPolynomial.rename ι F) = 0 := by
      apply Nat.le_zero.mp
      rw [MvPolynomial.degreeOf_le_iff]
      intro m hm
      rw [MvPolynomial.support_rename_of_injective hιinj, Finset.mem_image] at hm
      obtain ⟨m', -, rfl⟩ := hm
      rw [Finsupp.mapDomain_notin_range _ _ hW]
    have h0 := s2 _ (τ q) hren hdeg
    apply MvPolynomial.rename_injective ι hιinj
    rw [h0, map_zero]

  have s4 : ∀ (R Ω : Type u) [CommRing R] [Field Ω]
      [Algebra κ R] [Algebra κ Ω] [Algebra R Ω] [IsScalarTower κ R Ω]
      {ι ι' : Type} (y : ι → Ω) (z : ι' → Ω) (s : Set Ω),
      s ⊆ (Algebra.adjoin R (Set.range z) : Set Ω) →
      AlgebraicIndependent R (Sum.elim y z) →
      AlgebraicIndependent (IntermediateField.adjoin κ s) y := by
    intro R Ω _ _ _ _ _ _ ι ι' y z s hs hind
    have h2 := (AlgebraicIndependent.sumElim_iff.mp hind).2
    rw [IntermediateField.algebraicIndependent_adjoin_iff]
    have hle : Algebra.adjoin κ s ≤ (Algebra.adjoin R (Set.range z)).restrictScalars κ :=
      Algebra.adjoin_le hs
    let j : Algebra.adjoin κ s →+* Algebra.adjoin R (Set.range z) :=
      { toFun := fun a => ⟨a.1, hle a.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    refine AlgebraicIndependent.of_ringHom_of_comp_eq j (RingHom.id Ω) ?_ ?_ ?_
    · simpa using h2
    · intro a b hab
      have := congrArg Subtype.val hab
      exact Subtype.ext this
    · ext a
      rfl

  have s5 : ∀ (S Ω : Type u) [CommRing S] [Field Ω]
      [Algebra κ S] [Algebra κ Ω] [Algebra S Ω] [IsScalarTower κ S Ω] [IsFractionRing S Ω]
      {V : Type} (Ψ : MvPolynomial V κ →ₐ[κ] S), Function.Surjective Ψ →
      ∀ (t : Set Ω), (∀ w, algebraMap S Ω (Ψ (MvPolynomial.X w)) ∈ t) →
      IntermediateField.adjoin κ t = ⊤ := by
    intro S Ω _ _ _ _ _ _ _ V Ψ hΨ t ht
    have hmem : ∀ a : S, algebraMap S Ω a ∈ IntermediateField.adjoin κ t := by
      intro a
      obtain ⟨p, rfl⟩ := hΨ a
      have h1 := DFunLike.congr_fun
        (MvPolynomial.aeval_unique ((IsScalarTower.toAlgHom κ S Ω).comp Ψ)) p
      simp only [AlgHom.comp_apply, IsScalarTower.toAlgHom_apply] at h1
      rw [h1]
      apply IntermediateField.algebra_adjoin_le_adjoin κ t
      apply Algebra.adjoin_mono (s := Set.range _) (by rintro _ ⟨w, rfl⟩; exact ht w)
      rw [Algebra.adjoin_range_eq_range_aeval]
      exact ⟨p, rfl⟩
    rw [eq_top_iff]
    intro ω _
    obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective S ω
    exact IntermediateField.div_mem _ (hmem a) (hmem b)

  haveI : (Ideal.span {g}).IsPrime := (Ideal.span_singleton_prime hg.ne_zero).mpr hg.prime
  obtain ⟨hsurj, hXl, hXr, hg0⟩ := s0
  let Ψ := (MvPolynomial.mapAlgHom (Ideal.Quotient.mkₐ κ (Ideal.span {g}))).comp
      (MvPolynomial.sumAlgEquiv κ ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (Fin (d + 1))).toAlgHom
  let Φ := (IsScalarTower.toAlgHom κ
      (MvPolynomial ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g}))
      (FractionRing (MvPolynomial ((Fin 2 × Fin (d + 1)) ⊕ Fin 2)
        (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g})))).comp Ψ
  have hΦ : ∀ p, Φ p = algebraMap
      (MvPolynomial ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g}))
      (FractionRing (MvPolynomial ((Fin 2 × Fin (d + 1)) ⊕ Fin 2)
        (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g}))) (Ψ p) := fun p => rfl
  refine ⟨FractionRing (MvPolynomial ((Fin 2 × Fin (d + 1)) ⊕ Fin 2)
      (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g})), inferInstance, inferInstance,
    fun i => Φ (MvPolynomial.X (Sum.inr i)), fun i => Φ (MvPolynomial.X (Sum.inl (Sum.inl (0, i)))),
    fun i => Φ (MvPolynomial.X (Sum.inl (Sum.inl (1, i)))), Φ (MvPolynomial.X (Sum.inl (Sum.inr 0))),
    Φ (MvPolynomial.X (Sum.inl (Sum.inr 1))), ?_, ?_, ?_, ?_⟩
  ·
    have h1 : MvPolynomial.aeval (fun i => Φ (MvPolynomial.X (Sum.inr i))) g =
        Φ (MvPolynomial.rename Sum.inr g) := by
      change MvPolynomial.aeval ((fun w => Φ (MvPolynomial.X w)) ∘ Sum.inr) g = _
      rw [← MvPolynomial.aeval_rename]
      exact (DFunLike.congr_fun (MvPolynomial.aeval_unique Φ) _).symm
    rw [h1, hΦ]
    change algebraMap _ _ (MvPolynomial.mapAlgHom (Ideal.Quotient.mkₐ κ (Ideal.span {g}))
        (MvPolynomial.sumAlgEquiv κ ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (Fin (d + 1))
          (MvPolynomial.rename Sum.inr g))) = 0
    rw [hg0, map_zero]
  ·
    refine s5
      (MvPolynomial ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g}))
      (FractionRing (MvPolynomial ((Fin 2 × Fin (d + 1)) ⊕ Fin 2)
        (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g}))) Ψ hsurj _ ?_
    rintro (((⟨j, i⟩ | j) | i))
    · fin_cases j
      · exact Or.inl (Or.inl (Or.inr ⟨i, rfl⟩))
      · exact Or.inl (Or.inr ⟨i, rfl⟩)
    · fin_cases j
      · exact Or.inr (Or.inl rfl)
      · exact Or.inr (Or.inr rfl)
    · exact Or.inl (Or.inl (Or.inl ⟨i, rfl⟩))
  ·
    refine s3 _ Φ _ _ _ _ _ (fun _ => rfl) (fun _ => rfl) (fun _ => rfl) rfl rfl ?_
    intro h hh
    apply s1 h
    apply IsFractionRing.injective
      (MvPolynomial ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g}))
      (FractionRing (MvPolynomial ((Fin 2 × Fin (d + 1)) ⊕ Fin 2)
        (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g})))
    rw [map_zero]
    exact hh
  ·
    refine s4 (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g}) _
      (fun q : Fin 2 × Fin (d + 1) => ![fun i => Φ (MvPolynomial.X (Sum.inl (Sum.inl (0, i)))),
        fun i => Φ (MvPolynomial.X (Sum.inl (Sum.inl (1, i))))] q.1 q.2)
      ![Φ (MvPolynomial.X (Sum.inl (Sum.inr 0))), Φ (MvPolynomial.X (Sum.inl (Sum.inr 1)))] _ ?_ ?_
    · rintro w (⟨i, rfl⟩ | hw)
      · have : Φ (MvPolynomial.X (Sum.inr i)) =
            algebraMap (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g})
            (FractionRing (MvPolynomial ((Fin 2 × Fin (d + 1)) ⊕ Fin 2)
              (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g})))
            (Ideal.Quotient.mk (Ideal.span {g}) (MvPolynomial.X i)) := by
          rw [hΦ]
          change algebraMap _ _ (MvPolynomial.mapAlgHom (Ideal.Quotient.mkₐ κ (Ideal.span {g}))
            (MvPolynomial.sumAlgEquiv κ ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (Fin (d + 1))
              (MvPolynomial.X (Sum.inr i)))) = _
          rw [hXr i, IsScalarTower.algebraMap_apply (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g})
            (MvPolynomial ((Fin 2 × Fin (d + 1)) ⊕ Fin 2)
              (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g})), MvPolynomial.algebraMap_eq]
        show Φ (MvPolynomial.X (Sum.inr i)) ∈ _
        rw [this]
        exact Subalgebra.algebraMap_mem _ _
      · rcases hw with rfl | hw
        · exact Algebra.subset_adjoin ⟨0, rfl⟩
        · rw [Set.mem_singleton_iff] at hw
          subst hw
          exact Algebra.subset_adjoin ⟨1, rfl⟩
    · have hX := MvPolynomial.algebraicIndependent_X ((Fin 2 × Fin (d + 1)) ⊕ Fin 2)
        (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g})
      have hm := hX.map'
        (f := IsScalarTower.toAlgHom (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g})
          (MvPolynomial ((Fin 2 × Fin (d + 1)) ⊕ Fin 2) (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g}))
          (FractionRing (MvPolynomial ((Fin 2 × Fin (d + 1)) ⊕ Fin 2)
            (MvPolynomial (Fin (d + 1)) κ ⧸ Ideal.span {g}))))
        (IsFractionRing.injective _ _)
      convert hm using 1
      funext w
      rcases w with ⟨j, i⟩ | j
      · fin_cases j
        · exact congrArg (algebraMap _ _) (hXl (Sum.inl (0, i)))
        · exact congrArg (algebraMap _ _) (hXl (Sum.inl (1, i)))
      · fin_cases j
        · exact congrArg (algebraMap _ _) (hXl (Sum.inr 0))
        · exact congrArg (algebraMap _ _) (hXl (Sum.inr 1))

theorem lw_sc_adjoin_transcendental (κ : Type u) [Field κ] (E : Type u) [Field E] [Algebra κ E]
    (k M : IntermediateField κ E) (hkM : k ≤ M) (t : E) (ht : Transcendental M t)
    (hSC : ∀ ω ∈ M, IsSeparable k ω → ω ∈ k) :
    ∀ ω ∈ IntermediateField.adjoin κ ((M : Set E) ∪ {t}),
      IsSeparable (IntermediateField.adjoin κ ((k : Set E) ∪ {t})) ω →
      ω ∈ IntermediateField.adjoin κ ((k : Set E) ∪ {t}) :=
by
  classical
  intro ω hω hsep

  have hrep : ∀ (F : IntermediateField κ E) (x : E),
      x ∈ IntermediateField.adjoin κ ((F : Set E) ∪ {t}) →
      ∃ a b : Polynomial F, Polynomial.aeval t b ≠ 0 ∧
        x * Polynomial.aeval t b = Polynomial.aeval t a := by
    intro F x hx
    rw [← IntermediateField.restrictScalars_adjoin, IntermediateField.mem_restrictScalars,
      IntermediateField.mem_adjoin_simple_iff] at hx
    obtain ⟨r, s, rfl⟩ := hx
    by_cases hs : Polynomial.aeval t s = 0
    · exact ⟨0, 1, by simp, by simp [hs]⟩
    · exact ⟨r, s, hs, div_mul_cancel₀ _ hs⟩
  have hpoly : ∀ (F : IntermediateField κ E) (p : Polynomial F),
      Polynomial.aeval t p ∈ IntermediateField.adjoin κ ((F : Set E) ∪ {t}) := by
    intro F p
    rw [Polynomial.aeval_eq_sum_range]
    refine sum_mem fun i _ => ?_
    rw [Algebra.smul_def]
    refine mul_mem ?_ (pow_mem ?_ _)
    · exact IntermediateField.subset_adjoin κ _ (Or.inl (p.coeff i).2)
    · exact IntermediateField.subset_adjoin κ _ (Or.inr rfl)

  haveI hqk : ExpChar k (ringExpChar κ) :=
    expChar_of_injective_algebraMap (algebraMap κ k).injective (ringExpChar κ)
  haveI hqK : ExpChar (IntermediateField.adjoin κ ((k : Set E) ∪ {t})) (ringExpChar κ) :=
    expChar_of_injective_algebraMap
      (algebraMap κ (IntermediateField.adjoin κ ((k : Set E) ∪ {t}))).injective (ringExpChar κ)

  have hS1 : ∀ c : E, c ∈ M → IsIntegral k c → ∃ n : ℕ, c ^ (ringExpChar κ) ^ n ∈ k := by
    intro c hcM hc
    obtain ⟨g, hgsep, m, hgm⟩ := (minpoly.irreducible hc).hasSeparableContraction (ringExpChar κ)
    refine ⟨m, hSC _ (pow_mem hcM _) ?_⟩
    have h1 : Polynomial.aeval (c ^ (ringExpChar κ) ^ m) g = 0 := by
      rw [← Polynomial.expand_aeval, hgm]
      exact minpoly.aeval k c
    exact hgsep.of_dvd (minpoly.dvd k _ h1)

  have hint : IsIntegral (IntermediateField.adjoin κ ((k : Set E) ∪ {t})) ω := hsep.isIntegral
  obtain ⟨f, hf⟩ : ∃ f, f = minpoly (IntermediateField.adjoin κ ((k : Set E) ∪ {t})) ω :=
    ⟨_, rfl⟩
  have hfm : f.Monic := hf ▸ minpoly.monic hint
  have hfω : Polynomial.aeval ω f = 0 := hf ▸ minpoly.aeval _ ω
  have hrepK : ∀ j : ℕ, ∃ a b : Polynomial k, Polynomial.aeval t b ≠ 0 ∧
      ((f.coeff j : IntermediateField.adjoin κ ((k : Set E) ∪ {t})) : E) *
        Polynomial.aeval t b = Polynomial.aeval t a :=
    fun j => hrep k _ (f.coeff j).2
  choose a b hb hab using hrepK
  obtain ⟨D, hD⟩ : ∃ D : Polynomial k, D = ∏ j ∈ Finset.range f.natDegree, b j := ⟨_, rfl⟩
  obtain ⟨δ, hδ⟩ : ∃ δ : E, δ = Polynomial.aeval t D := ⟨_, rfl⟩
  have hδprod : δ = ∏ j ∈ Finset.range f.natDegree, Polynomial.aeval t (b j) := by
    rw [hδ, hD, map_prod]
  have hδ0 : δ ≠ 0 := by
    rw [hδprod]; exact Finset.prod_ne_zero_iff.mpr fun j _ => hb j
  obtain ⟨g, hg⟩ : ∃ g : Polynomial E,
      g = (f.map (algebraMap (IntermediateField.adjoin κ ((k : Set E) ∪ {t})) E)).scaleRoots δ :=
    ⟨_, rfl⟩
  have hgm : g.Monic := by
    rw [hg]; exact (Polynomial.monic_scaleRoots_iff δ).mpr (hfm.map _)
  have hgroot : Polynomial.aeval (δ * ω) g = 0 := by
    have h1 : Polynomial.aeval ω
        (f.map (algebraMap (IntermediateField.adjoin κ ((k : Set E) ∪ {t})) E)) = 0 := by
      rw [Polynomial.aeval_map_algebraMap]; exact hfω
    rw [hg]
    exact Polynomial.scaleRoots_aeval_eq_zero (r := δ) h1
  have hgc : ∀ n, g.coeff n =
      ((f.coeff n : IntermediateField.adjoin κ ((k : Set E) ∪ {t})) : E) *
        δ ^ (f.natDegree - n) := by
    intro n
    rw [hg, Polynomial.coeff_scaleRoots, Polynomial.coeff_map, Polynomial.natDegree_map]
    rfl
  have hlift : g ∈ Polynomial.lifts (Polynomial.aeval t : Polynomial k →ₐ[k] E).toRingHom := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    intro n
    rw [hgc n]
    rcases Nat.lt_or_ge n f.natDegree with hn | hn
    · refine ⟨a n * (∏ i ∈ (Finset.range f.natDegree).erase n, b i) *
        D ^ (f.natDegree - n - 1), ?_⟩
      have hmem : n ∈ Finset.range f.natDegree := Finset.mem_range.mpr hn
      have hpow : δ ^ (f.natDegree - n) = δ * δ ^ (f.natDegree - n - 1) := by
        rw [← pow_succ']; congr 1; omega
      have key : Polynomial.aeval t (b n) *
          ∏ i ∈ (Finset.range f.natDegree).erase n, Polynomial.aeval t (b i) = δ :=
        (Finset.mul_prod_erase _ (fun i => Polynomial.aeval t (b i)) hmem).trans hδprod.symm
      show Polynomial.aeval t _ = _
      rw [map_mul, map_mul, map_pow, map_prod, ← hab n, ← hδ, hpow, ← key]
      ring
    · rw [Nat.sub_eq_zero_of_le hn, pow_zero, mul_one]
      rcases hn.eq_or_lt with h | h
      · refine ⟨1, ?_⟩
        rw [← h, hfm.coeff_natDegree]
        simp
      · refine ⟨0, ?_⟩
        rw [Polynomial.coeff_eq_zero_of_natDegree_lt h]
        simp
  obtain ⟨G, hGmap, -, hGm⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hgm
  have hGw : Polynomial.eval₂ (Polynomial.aeval t : Polynomial k →ₐ[k] E).toRingHom
      (δ * ω) G = 0 := by
    rw [← Polynomial.eval_map, hGmap, ← Polynomial.coe_aeval_eq_eval]
    exact hgroot

  have hkK : ∀ y ∈ k, y ∈ IntermediateField.adjoin κ ((k : Set E) ∪ {t}) :=
    fun y hy => IntermediateField.subset_adjoin κ _ (Or.inl hy)
  have htK : t ∈ IntermediateField.adjoin κ ((k : Set E) ∪ {t}) :=
    IntermediateField.subset_adjoin κ _ (Or.inr rfl)
  have hδK : δ ∈ IntermediateField.adjoin κ ((k : Set E) ∪ {t}) := hδ ▸ hpoly k D
  have hKL : IntermediateField.adjoin κ ((k : Set E) ∪ {t}) ≤
      IntermediateField.adjoin κ ((M : Set E) ∪ {t}) :=
    IntermediateField.adjoin.mono κ _ _
      (Set.union_subset_union_left _ (SetLike.coe_subset_coe.mpr hkM))
  have hwL : δ * ω ∈ IntermediateField.adjoin κ ((M : Set E) ∪ {t}) := mul_mem (hKL hδK) hω
  obtain ⟨r, s, hs, hrs⟩ := hrep M _ hwL
  have hinj' : Function.Injective
      ((Polynomial.aeval t : Polynomial M →ₐ[M] E).toRingHom) :=
    transcendental_iff_injective.mp ht
  letI : Algebra k M := (IntermediateField.inclusion hkM).toRingHom.toAlgebra
  letI : Algebra (Polynomial k) (Polynomial M) := Polynomial.algebra k M
  haveI : IsScalarTower k M E := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hcomp : ((Polynomial.aeval t : Polynomial M →ₐ[M] E).toRingHom).comp
      (algebraMap (Polynomial k) (Polynomial M)) =
      (Polynomial.aeval t : Polynomial k →ₐ[k] E).toRingHom := by
    apply Polynomial.ringHom_ext
    · intro c
      simp [Polynomial.algebraMap_def]
      rfl
    · simp [Polynomial.algebraMap_def]
  let φ : FractionRing (Polynomial M) →+* E := IsFractionRing.lift hinj'
  have hφalg : ∀ p : Polynomial M,
      φ (algebraMap (Polynomial M) (FractionRing (Polynomial M)) p) = Polynomial.aeval t p :=
    fun p => IsFractionRing.lift_algebraMap hinj' p
  have hφcomp : φ.comp (algebraMap (Polynomial M) (FractionRing (Polynomial M))) =
      (Polynomial.aeval t : Polynomial M →ₐ[M] E).toRingHom := RingHom.ext hφalg
  obtain ⟨x, hx⟩ : ∃ x : FractionRing (Polynomial M),
      x = algebraMap (Polynomial M) (FractionRing (Polynomial M)) r /
        algebraMap (Polynomial M) (FractionRing (Polynomial M)) s := ⟨_, rfl⟩
  have hφx : φ x = δ * ω := by
    rw [hx, map_div₀, hφalg, hφalg]
    exact ((eq_div_iff hs).mpr hrs).symm
  have hxint : IsIntegral (Polynomial M) x := by
    refine ⟨G.map (algebraMap (Polynomial k) (Polynomial M)), hGm.map _, ?_⟩
    apply φ.injective
    rw [map_zero, Polynomial.hom_eval₂, Polynomial.eval₂_map, hφx, hφcomp, hcomp]
    exact hGw
  obtain ⟨P, hP⟩ := IsIntegrallyClosed.isIntegral_iff.mp hxint
  have hPw : Polynomial.aeval t P = δ * ω := by
    rw [← hφx, ← hP, hφalg]

  have hPint : IsIntegral (Polynomial k) P := by
    refine ⟨G, hGm, ?_⟩
    apply hinj'
    rw [map_zero, Polynomial.hom_eval₂, hcomp]
    show Polynomial.eval₂ _ (Polynomial.aeval t P) G = 0
    rw [hPw]
    exact hGw
  have hcoefint : ∀ i, IsIntegral k ((P.coeff i : M) : E) := fun i =>
    (hPint.coeff i).algebraMap (B := E)

  have hKPC : ∀ y ∈ IntermediateField.adjoin κ ((k : Set E) ∪ {t}),
      y ∈ perfectClosure (IntermediateField.adjoin κ ((k : Set E) ∪ {t})) E :=
    fun y hy => IntermediateField.algebraMap_mem _
      (⟨y, hy⟩ : IntermediateField.adjoin κ ((k : Set E) ∪ {t}))
  have hcPC : ∀ i, ((P.coeff i : M) : E) ∈
      perfectClosure (IntermediateField.adjoin κ ((k : Set E) ∪ {t})) E := by
    intro i
    obtain ⟨n, hn⟩ := hS1 _ (P.coeff i).2 (hcoefint i)
    exact (mem_perfectClosure_iff_pow_mem (ringExpChar κ)).mpr ⟨n, ⟨⟨_, hkK _ hn⟩, rfl⟩⟩
  have hwPC : δ * ω ∈ perfectClosure (IntermediateField.adjoin κ ((k : Set E) ∪ {t})) E := by
    rw [← hPw, Polynomial.aeval_eq_sum_range]
    refine sum_mem fun i _ => ?_
    rw [Algebra.smul_def]
    exact mul_mem (hcPC i) (pow_mem (hKPC t htK) _)
  have hωPC : ω ∈ perfectClosure (IntermediateField.adjoin κ ((k : Set E) ∪ {t})) E := by
    rw [← mul_div_cancel_left₀ ω hδ0]
    exact div_mem hwPC (hKPC δ hδK)
  have hbot : ω ∈ (⊥ : IntermediateField (IntermediateField.adjoin κ ((k : Set E) ∪ {t})) E) := by
    rw [← separableClosure_inf_perfectClosure]
    exact IntermediateField.mem_inf.mpr ⟨mem_separableClosure_iff.mpr hsep, hωPC⟩
  obtain ⟨y, hy⟩ := IntermediateField.mem_bot.mp hbot
  rw [← hy]
  exact y.2

theorem lw_finite_separable_intermediate (κ : Type u) [Field κ] (E : Type u) [Field E]
    [Algebra κ E] (F L : IntermediateField κ E) (T : Set E) (hT : T.Finite)
    (hL : L = IntermediateField.adjoin κ ((F : Set E) ∪ T)) :
    Set.Finite {Z : IntermediateField κ E | F ≤ Z ∧ Z ≤ L ∧ ∀ z ∈ Z, IsSeparable F z} :=
by
  classical

  have s1 : ∃ t ⊆ T, AlgebraicIndependent F (Subtype.val : t → E) ∧
      FiniteDimensional (IntermediateField.adjoin F t)
        (IntermediateField.adjoin (IntermediateField.adjoin F t) T) := by
    have h0 : AlgebraicIndepOn F id (∅ : Set E) :=
      algebraicIndependent_empty_type_iff.mpr (algebraMap F E).injective
    obtain ⟨t, -, ht⟩ :=
      exists_maximal_algebraicIndependent (R := F) ∅ T (Set.empty_subset _) h0
    refine ⟨t, ht.prop.2, ht.prop.1, ?_⟩
    have : Finite T := hT.to_subtype
    apply IntermediateField.finiteDimensional_adjoin
    intro x hx
    by_cases hxt : x ∈ t
    · have : IsIntegral (IntermediateField.adjoin F t)
          (algebraMap (IntermediateField.adjoin F t) E
            ⟨x, IntermediateField.subset_adjoin F t hxt⟩) :=
        isIntegral_algebraMap
      simpa using this
    · have hnot : ¬ AlgebraicIndepOn F id (insert x t) := by
        intro hi
        have := ht.2 ⟨hi, Set.insert_subset hx ht.prop.2⟩ (Set.subset_insert x t)
        exact hxt (this (Set.mem_insert x t))
      have halg : IsAlgebraic (Algebra.adjoin F (id '' t)) x := by
        by_contra h
        exact hnot (ht.prop.1.insert h)
      rw [Set.image_id] at halg
      exact (IntermediateField.isAlgebraic_adjoin_iff.mpr halg).isIntegral
  obtain ⟨t, -, ht, hfdN⟩ := s1

  have s2R : ∀ (ι : Type u) [Fintype ι] (a : ι → E), (∀ i, IsAlgebraic F (a i)) →
      LinearIndependent F a → ∀ (c : ι → E), (∀ i, c i ∈ Algebra.adjoin F t) →
      ∑ i, c i * a i = 0 → ∀ i, c i = 0 := by
    intro ι _ a ha hli c hc hsum
    have hrange : ∀ i, ∃ P : MvPolynomial t F,
        MvPolynomial.aeval (Subtype.val : t → E) P = c i := by
      intro i
      have := hc i
      rw [← Subtype.range_coe (s := t), Algebra.adjoin_range_eq_range_aeval] at this
      exact this
    choose P hP using hrange
    have haB : ∀ i, a i ∈ algebraicClosure F E := fun i => mem_algebraicClosure_iff.mpr (ha i)
    let Q : MvPolynomial t (algebraicClosure F E) := ∑ i,
      MvPolynomial.C (⟨a i, haB i⟩ : algebraicClosure F E) *
        MvPolynomial.map (algebraMap F (algebraicClosure F E)) (P i)
    have hQ : MvPolynomial.aeval (Subtype.val : t → E) Q = 0 := by
      simp only [Q, map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_map_algebraMap, hP]
      rw [← hsum]
      apply Finset.sum_congr rfl
      intro i _
      rw [mul_comm]
      rfl
    have hQ0 := ht.algebraicClosure.eq_zero_of_aeval_eq_zero Q hQ
    have hcoeff : ∀ m i, (P i).coeff m = 0 := by
      intro m
      have h1 := congrArg (fun R : MvPolynomial t (algebraicClosure F E) => R.coeff m) hQ0
      simp only [Q, MvPolynomial.coeff_sum, MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map,
        MvPolynomial.coeff_zero, Finsupp.zero_apply] at h1
      have h2 : ∑ i, (P i).coeff m • a i = 0 := by
        have h3 := congrArg (algebraMap (algebraicClosure F E) E) h1
        rw [map_sum, map_zero] at h3
        rw [← h3]
        apply Finset.sum_congr rfl
        intro i _
        rw [Algebra.smul_def, map_mul, ← IsScalarTower.algebraMap_apply, mul_comm]
        rfl
      exact Fintype.linearIndependent_iff.mp hli _ h2
    intro i
    have hPi : P i = 0 := by
      ext m
      simp [hcoeff m i]
    rw [← hP i, hPi, map_zero]

  have s2 : ∀ (ι : Type u) [Fintype ι] (a : ι → E), (∀ i, IsAlgebraic F (a i)) →
      LinearIndependent F a → LinearIndependent (IntermediateField.adjoin F t) a := by
    intro ι _ a ha hli
    rw [Fintype.linearIndependent_iff]
    intro g hg
    have hpq : ∀ i, ∃ p ∈ Algebra.adjoin F t, ∃ q ∈ Algebra.adjoin F t, q ≠ 0 ∧
        (g i : E) = p / q := by
      intro i
      obtain ⟨p, hp, q, hq, he⟩ := IntermediateField.mem_adjoin_iff_div.mp (g i).2
      by_cases hq0 : q = 0
      · exact ⟨0, zero_mem _, 1, one_mem _, one_ne_zero, by rw [he, hq0, div_zero, zero_div]⟩
      · exact ⟨p, hp, q, hq, hq0, he⟩
    choose p hp q hq hq0 he using hpq
    have hD0 : ∏ j, q j ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun j _ => hq0 j)
    have hc : ∀ i, (g i : E) * ∏ j, q j ∈ Algebra.adjoin F t := by
      intro i
      rw [he i, ← Finset.mul_prod_erase Finset.univ q (Finset.mem_univ i)]
      have : p i / q i * (q i * ∏ j ∈ Finset.univ.erase i, q j) =
          p i * (∏ j ∈ Finset.univ.erase i, q j) * (q i / q i) := by ring
      rw [this, div_self (hq0 i), mul_one]
      exact mul_mem (hp i) (prod_mem fun j _ => hq j)
    have hg' : ∑ i, (g i : E) * a i = 0 := by
      rw [← hg]
      apply Finset.sum_congr rfl
      intro i _
      rfl
    have hsum : ∑ i, ((g i : E) * ∏ j, q j) * a i = 0 := by
      calc ∑ i, ((g i : E) * ∏ j, q j) * a i = (∏ j, q j) * ∑ i, (g i : E) * a i := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro i _
            ring
        _ = 0 := by rw [hg', mul_zero]
    have h := s2R ι a ha hli _ hc hsum
    intro i
    have h1 : (g i : E) = 0 := by
      rcases mul_eq_zero.mp (h i) with h2 | h2
      · exact h2
      · exact absurd h2 hD0
    exact Subtype.ext h1

  let S : IntermediateField F E := separableClosure F E ⊓ IntermediateField.adjoin F T
  have hSM : ∀ x ∈ S, x ∈ IntermediateField.adjoin (IntermediateField.adjoin F t) T := by
    intro x hx
    have hle : IntermediateField.adjoin F T ≤
        (IntermediateField.adjoin (IntermediateField.adjoin F t) T).restrictScalars F :=
      IntermediateField.adjoin_le_iff.mpr (IntermediateField.subset_adjoin _ T)
    exact (IntermediateField.mem_restrictScalars F).mp (hle (IntermediateField.mem_inf.mp hx).2)
  have hfdS : FiniteDimensional F S := by
    have hrank : Module.rank F S ≤ ((Module.finrank (IntermediateField.adjoin F t)
        (IntermediateField.adjoin (IntermediateField.adjoin F t) T) : ℕ) : Cardinal) := by
      apply rank_le
      intro s hs
      let b : s → E := fun i => ((i : S) : E)
      have hb : LinearIndependent F b :=
        hs.map' S.val.toLinearMap (LinearMap.ker_eq_bot.mpr (fun x y hxy => Subtype.ext hxy))
      have hbalg : ∀ i, IsAlgebraic F (b i) := fun i =>
        (mem_separableClosure_iff.mp (IntermediateField.mem_inf.mp (i : S).2).1).isIntegral.isAlgebraic
      have hbN := s2 s b hbalg hb
      let b' : s → IntermediateField.adjoin (IntermediateField.adjoin F t) T :=
        fun i => ⟨b i, hSM _ (i : S).2⟩
      have hb' : LinearIndependent (IntermediateField.adjoin F t) b' :=
        LinearIndependent.of_comp
          (IntermediateField.adjoin (IntermediateField.adjoin F t) T).val.toLinearMap hbN
      have := hb'.fintype_card_le_finrank
      simpa using this
    have : Module.Free F S := Module.Free.of_divisionRing F S
    exact Module.rank_lt_aleph0_iff.mp (lt_of_le_of_lt hrank (Cardinal.natCast_lt_aleph0))

  have hsepS : Algebra.IsSeparable F S := ⟨fun x =>
    (isSeparable_map_iff S.val (fun a b h => Subtype.ext h)).mp
      (mem_separableClosure_iff.mp (IntermediateField.mem_inf.mp x.2).1)⟩
  obtain ⟨α, hα⟩ := Field.exists_primitive_element F S
  have hfin : Finite (IntermediateField F S) :=
    Field.finite_intermediateField_of_exists_primitive_element F S ⟨α, hα⟩
  have hL' : ∀ z, z ∈ L ↔ z ∈ IntermediateField.adjoin F T := by
    intro z
    rw [hL, ← IntermediateField.restrictScalars_adjoin, IntermediateField.mem_restrictScalars]
  apply Set.Finite.subset (Set.finite_range
    (fun W : IntermediateField F S => (IntermediateField.lift W).restrictScalars κ))
  rintro Z ⟨hFZ, hZL, hsep⟩
  have hZS : IntermediateField.extendScalars hFZ ≤ S := by
    intro z hz
    rw [IntermediateField.mem_extendScalars] at hz
    exact IntermediateField.mem_inf.mpr
      ⟨mem_separableClosure_iff.mpr (hsep z hz), (hL' z).mp (hZL hz)⟩
  refine ⟨IntermediateField.restrict hZS, ?_⟩
  simp only [IntermediateField.lift_restrict, IntermediateField.extendScalars_restrictScalars]

theorem lw_affine_translation_sc (κ : Type u) [Field κ] [Infinite κ] (E : Type u) [Field E]
    [Algebra κ E] (k M : IntermediateField κ E) (hkM : k ≤ M)
    (hSC : ∀ ω ∈ M, IsSeparable k ω → ω ∈ k)
    (y g₀ g₁ : E) (hg₀ : g₀ ∈ M) (hg₁ : g₁ ∈ M) (hy : Transcendental M y)
    (hind : AlgebraicIndependent k ![y, g₀ - g₁ * y, g₁])
    (hfin : Set.Finite {Z : IntermediateField κ E |
      IntermediateField.adjoin κ ((k : Set E) ∪ {y, g₀ - g₁ * y, g₁}) ≤ Z ∧
      Z ≤ IntermediateField.adjoin κ ((M : Set E) ∪ {y}) ∧
      ∀ z ∈ Z, IsSeparable (IntermediateField.adjoin κ ((k : Set E) ∪ {y, g₀ - g₁ * y, g₁})) z}) :
    ∀ ω ∈ IntermediateField.adjoin κ ((M : Set E) ∪ {y}),
      IsSeparable (IntermediateField.adjoin κ ((k : Set E) ∪ {y, g₀ - g₁ * y})) ω →
      ω ∈ IntermediateField.adjoin κ ((k : Set E) ∪ {y, g₀ - g₁ * y}) :=
by
  classical



  have sep_transport : ∀ (L T : IntermediateField κ E) (S : Set E), S ⊆ (L : Set E) →
      ∀ (τ : L →ₐ[κ] L), (∀ x : L, (x : E) ∈ S → (τ x : E) ∈ T) →
      ∀ (θ : E) (hθ : θ ∈ L), IsSeparable (IntermediateField.adjoin κ S) θ →
      IsSeparable T (τ ⟨θ, hθ⟩ : E) := by
    intro L T S hSL τ hτ θ hθ hsep
    set K := IntermediateField.adjoin κ S with hKdef
    have hKL : K ≤ L := IntermediateField.adjoin_le_iff.mpr hSL
    have hA : ∀ e (he : e ∈ K), (τ ⟨e, hKL he⟩ : E) ∈ T := by
      intro e he
      refine IntermediateField.adjoin_induction (p := fun e he => (τ ⟨e, hKL he⟩ : E) ∈ T)
        κ ?_ ?_ ?_ ?_ ?_ he
      · intro x hx
        exact hτ _ hx
      · intro c
        have : (⟨algebraMap κ E c, hKL (IntermediateField.algebraMap_mem K c)⟩ : L) =
            algebraMap κ L c := rfl
        rw [this, AlgHom.commutes]
        exact T.algebraMap_mem c
      · intro x x' hx hx' ihx ihx'
        have : (⟨x + x', hKL (add_mem hx hx')⟩ : L) = ⟨x, hKL hx⟩ + ⟨x', hKL hx'⟩ := rfl
        rw [this, map_add]
        exact add_mem ihx ihx'
      · intro x hx ih
        have : (⟨x⁻¹, hKL (inv_mem hx)⟩ : L) = (⟨x, hKL hx⟩ : L)⁻¹ := rfl
        rw [this, map_inv₀]
        exact inv_mem ih
      · intro x x' hx hx' ihx ihx'
        have : (⟨x * x', hKL (mul_mem hx hx')⟩ : L) = ⟨x, hKL hx⟩ * ⟨x', hKL hx'⟩ := rfl
        rw [this, map_mul]
        exact mul_mem ihx ihx'
    let ι : K →+* L := (IntermediateField.inclusion hKL).toRingHom
    let g : L →+* E := L.val.toRingHom.comp τ.toRingHom
    let ρ : K →+* T := RingHom.codRestrict (g.comp ι) T (fun c => hA c c.2)
    have hρ : (algebraMap T E).comp ρ = g.comp ι := RingHom.ext fun c => rfl
    have hLι : L.val.toRingHom.comp ι = algebraMap K E := RingHom.ext fun c => rfl
    set p := minpoly K θ with hp
    have hq : (p.map ρ).Separable := Polynomial.Separable.map hsep
    have h0 : Polynomial.eval₂ ι (⟨θ, hθ⟩ : L) p = 0 := by
      apply Subtype.val_injective
      have h1 := Polynomial.hom_eval₂ p ι L.val.toRingHom (⟨θ, hθ⟩ : L)
      have h2 : L.val.toRingHom (Polynomial.eval₂ ι (⟨θ, hθ⟩ : L) p) =
          ((Polynomial.eval₂ ι (⟨θ, hθ⟩ : L) p : L) : E) := rfl
      rw [← h2, h1, hLι]
      have h3 : L.val.toRingHom (⟨θ, hθ⟩ : L) = θ := rfl
      rw [h3]
      have h4 := minpoly.aeval K θ
      rw [Polynomial.aeval_def] at h4
      rw [← hp] at h4
      rw [h4]
      rfl
    have haev : Polynomial.aeval (τ ⟨θ, hθ⟩ : E) (p.map ρ) = 0 := by
      rw [Polynomial.aeval_def, Polynomial.eval₂_map, hρ]
      have h5 : (τ ⟨θ, hθ⟩ : E) = g (⟨θ, hθ⟩ : L) := rfl
      rw [h5, ← Polynomial.hom_eval₂, h0, map_zero]
    exact hq.of_dvd (minpoly.dvd T _ haev)



  have shifted : ∀ (y' ξ' g : E), AlgebraicIndependent k ![y', ξ', g] →
      ∀ (a₁ a₂ : κ), a₁ ≠ a₂ →
      Transcendental
        (IntermediateField.adjoin κ ((k : Set E) ∪ {y', ξ' - algebraMap κ E a₁ * g}))
        (ξ' - algebraMap κ E a₂ * g) := by
    intro y' ξ' g hind' a₁ a₂ ha
    set b₁ : k := algebraMap κ k a₁ with hb₁
    set b₂ : k := algebraMap κ k a₂ with hb₂
    have hδ : b₂ - b₁ ≠ 0 := by
      rw [hb₁, hb₂, ← map_sub]
      exact (map_ne_zero _).mpr (sub_ne_zero.mpr (Ne.symm ha))
    set δ : k := b₂ - b₁ with hδdef
    let Φ : MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 3) k :=
      MvPolynomial.aeval ![MvPolynomial.X 0,
        MvPolynomial.X 1 - MvPolynomial.C b₁ * MvPolynomial.X 2,
        MvPolynomial.X 1 - MvPolynomial.C b₂ * MvPolynomial.X 2]
    let Ψ : MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 3) k :=
      MvPolynomial.aeval ![MvPolynomial.X 0,
        MvPolynomial.C δ⁻¹ *
          (MvPolynomial.C b₂ * MvPolynomial.X 1 - MvPolynomial.C b₁ * MvPolynomial.X 2),
        MvPolynomial.C δ⁻¹ * (MvPolynomial.X 1 - MvPolynomial.X 2)]
    have hC : (MvPolynomial.C δ⁻¹ : MvPolynomial (Fin 3) k) *
        (MvPolynomial.C b₂ - MvPolynomial.C b₁) = 1 := by
      rw [← map_sub, ← map_mul, ← hδdef, inv_mul_cancel₀ hδ, map_one]
    have hΨΦ : Ψ.comp Φ = AlgHom.id k _ := by
      apply MvPolynomial.algHom_ext
      intro i
      fin_cases i
      · simp [Φ, Ψ]
      · simp [Φ, Ψ]
        linear_combination (MvPolynomial.X 1 : MvPolynomial (Fin 3) k) * hC
      · simp [Φ, Ψ]
        linear_combination (MvPolynomial.X 2 : MvPolynomial (Fin 3) k) * hC
    have hΦinj : Function.Injective Φ := by
      intro p q h
      have := congrArg Ψ h
      have e1 : Ψ (Φ p) = p := by rw [← AlgHom.comp_apply, hΨΦ, AlgHom.id_apply]
      have e2 : Ψ (Φ q) = q := by rw [← AlgHom.comp_apply, hΨΦ, AlgHom.id_apply]
      rw [e1, e2] at this
      exact this
    have hcomp : (MvPolynomial.aeval ![y', ξ', g]).comp Φ =
        MvPolynomial.aeval
          ![y', ξ' - algebraMap κ E a₁ * g, ξ' - algebraMap κ E a₂ * g] := by
      apply MvPolynomial.algHom_ext
      intro i
      fin_cases i
      · simp [Φ]
      · simp [Φ, b₁]
      · simp [Φ, b₂]
    have hind'' : AlgebraicIndependent k
        ![y', ξ' - algebraMap κ E a₁ * g, ξ' - algebraMap κ E a₂ * g] := by
      rw [algebraicIndependent_iff_injective_aeval, ← hcomp]
      exact (algebraicIndependent_iff_injective_aeval.mp hind').comp hΦinj
    have h2 := hind''.transcendental_adjoin (s := {0, 1}) (i := 2) (by decide)
    rw [Set.image_pair] at h2
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
      Matrix.tail_cons] at h2
    have h3 := IntermediateField.transcendental_adjoin_iff.mpr h2
    rw [← IntermediateField.restrictScalars_adjoin]
    exact h3



  have trans_adj : ∀ (P : IntermediateField κ E) (θ t : E), IsAlgebraic P θ →
      Transcendental P t →
      Transcendental (IntermediateField.adjoin κ ((P : Set E) ∪ {θ})) t := by
    intro P θ t hθ ht
    rw [← IntermediateField.restrictScalars_adjoin]
    haveI : Algebra.IsAlgebraic P (IntermediateField.adjoin P {θ}) :=
      IntermediateField.isAlgebraic_adjoin_simple hθ.isIntegral
    have h2 : Transcendental (IntermediateField.adjoin P {θ}) t := ht.extendScalars _
    exact h2



  have transl : ∀ a : κ, ∃ τ : IntermediateField.adjoin κ ((M : Set E) ∪ {y}) →ₐ[κ]
        IntermediateField.adjoin κ ((M : Set E) ∪ {y}),
      (∀ x : IntermediateField.adjoin κ ((M : Set E) ∪ {y}), (x : E) ∈ M → (τ x : E) = x) ∧
      (∀ x : IntermediateField.adjoin κ ((M : Set E) ∪ {y}), (x : E) = y →
        (τ x : E) = y + algebraMap κ E a) := by
    intro a
    have hLL' : ∀ e : E, e ∈ IntermediateField.adjoin κ ((M : Set E) ∪ {y}) ↔
        e ∈ IntermediateField.adjoin M {y} := by
      intro e
      rw [← IntermediateField.restrictScalars_adjoin]
      exact IntermediateField.mem_restrictScalars κ
    generalize hL : IntermediateField.adjoin κ ((M : Set E) ∪ {y}) = L at hLL' ⊢
    set c : M := algebraMap κ M a with hcdef
    have hc : algebraMap M E c = algebraMap κ E a := rfl
    have hy' : Transcendental M (y + algebraMap κ E a) := by
      have hy0 := hy
      rw [transcendental_iff_injective] at hy0 ⊢
      have h : ⇑(Polynomial.aeval (y + algebraMap κ E a)) =
          ⇑(Polynomial.aeval y) ∘ ⇑(Polynomial.taylor c) := by
        funext p
        simp only [Function.comp_apply, Polynomial.taylor_apply, Polynomial.aeval_comp, map_add,
          Polynomial.aeval_X, Polynomial.aeval_C, hc]
      rw [h]
      exact hy0.comp (Polynomial.taylor_injective c)
    have hu₁ : AlgebraicIndependent M (fun _ : Unit => y) :=
      algebraicIndependent_unique_type_iff.mpr hy
    have hu₂ : AlgebraicIndependent M (fun _ : Unit => y + algebraMap κ E a) :=
      algebraicIndependent_unique_type_iff.mpr hy'
    have hr₁ : IntermediateField.adjoin M (Set.range (fun _ : Unit => y)) =
        IntermediateField.adjoin M {y} := by rw [Set.range_const]
    have hr₂ : IntermediateField.adjoin M (Set.range (fun _ : Unit => y + algebraMap κ E a)) ≤
        IntermediateField.adjoin M {y} := by
      rw [Set.range_const, IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
      refine add_mem (IntermediateField.subset_adjoin M _ (Set.mem_singleton y)) ?_
      rw [← hc]
      exact IntermediateField.algebraMap_mem _ c
    let f : IntermediateField.adjoin M {y} →ₐ[M] IntermediateField.adjoin M {y} :=
      (IntermediateField.inclusion hr₂).comp (hu₂.aevalEquivField.toAlgHom.comp
        (hu₁.aevalEquivField.symm.toAlgHom.comp (IntermediateField.equivOfEq hr₁.symm).toAlgHom))
    have hfy : ∀ x : IntermediateField.adjoin M {y}, (x : E) = y →
        (f x : E) = y + algebraMap κ E a := by
      intro x hx
      have h1 : (IntermediateField.equivOfEq hr₁.symm x) = hu₁.aevalEquivField
          (algebraMap (MvPolynomial Unit M) (FractionRing (MvPolynomial Unit M))
            (MvPolynomial.X ())) := by
        apply Subtype.ext
        rw [hu₁.aevalEquivField_algebraMap_apply_coe, MvPolynomial.aeval_X]
        exact hx
      show ((hu₂.aevalEquivField (hu₁.aevalEquivField.symm
        (IntermediateField.equivOfEq hr₁.symm x)) : E)) = _
      rw [h1, AlgEquiv.symm_apply_apply, hu₂.aevalEquivField_algebraMap_apply_coe,
        MvPolynomial.aeval_X]
    have hfM : ∀ x : IntermediateField.adjoin M {y}, (x : E) ∈ M → (f x : E) = x := by
      intro x hx
      have : x = algebraMap M (IntermediateField.adjoin M {y}) ⟨x, hx⟩ := Subtype.ext rfl
      rw [this, AlgHom.commutes]
    let F : L → L := fun x => ⟨(f ⟨x, (hLL' x).mp x.2⟩ : E), (hLL' _).mpr (f _).2⟩
    have hF : ∀ x : L, ((F x : L) : E) = (f ⟨x, (hLL' x).mp x.2⟩ : E) := fun x => rfl
    have hcongr : ∀ (x : L) (z : IntermediateField.adjoin M {y}), (x : E) = z →
        (f ⟨x, (hLL' x).mp x.2⟩ : E) = f z := by
      intro x z h
      rw [show (⟨x, (hLL' x).mp x.2⟩ : IntermediateField.adjoin M {y}) = z from Subtype.ext h]
    let τ : L →ₐ[κ] L :=
      { toFun := F
        map_one' := Subtype.ext (by rw [hF, hcongr 1 1 rfl, map_one]; rfl)
        map_mul' := fun x x' => Subtype.ext (by
          rw [hF, hcongr (x * x') (⟨x, (hLL' x).mp x.2⟩ * ⟨x', (hLL' x').mp x'.2⟩) rfl, map_mul,
            MulMemClass.coe_mul, MulMemClass.coe_mul, hF, hF])
        map_zero' := Subtype.ext (by rw [hF, hcongr 0 0 rfl, map_zero]; rfl)
        map_add' := fun x x' => Subtype.ext (by
          rw [hF, hcongr (x + x') (⟨x, (hLL' x).mp x.2⟩ + ⟨x', (hLL' x').mp x'.2⟩) rfl, map_add,
            AddMemClass.coe_add, AddMemClass.coe_add, hF, hF])
        commutes' := fun r => Subtype.ext (by
          rw [hF, hcongr _ (algebraMap M (IntermediateField.adjoin M {y}) (algebraMap κ M r)) rfl,
            AlgHom.commutes]
          rfl) }
    refine ⟨τ, fun x hx => ?_, fun x hx => ?_⟩
    · show (f ⟨x, (hLL' x).mp x.2⟩ : E) = x
      exact hfM _ hx
    · show (f ⟨x, (hLL' x).mp x.2⟩ : E) = _
      exact hfy _ hx



  intro ω hω hsep
  set ξ : E := g₀ - g₁ * y with hξdef
  set L := IntermediateField.adjoin κ ((M : Set E) ∪ {y}) with hLdef
  set K₂ := IntermediateField.adjoin κ ((k : Set E) ∪ {y, ξ, g₁}) with hK₂def
  have hML : ∀ m ∈ M, m ∈ L := fun m hm => IntermediateField.subset_adjoin κ _ (Or.inl hm)
  have hyL : y ∈ L := IntermediateField.subset_adjoin κ _ (Or.inr (Set.mem_singleton y))
  have hkL : ∀ c ∈ k, c ∈ L := fun c hc => hML c (hkM hc)
  have hg₀L : g₀ ∈ L := hML _ hg₀
  have hg₁L : g₁ ∈ L := hML _ hg₁
  have hξL : ξ ∈ L := sub_mem hg₀L (mul_mem hg₁L hyL)
  choose τ hτM hτy using transl
  have hτξ : ∀ a : κ, (τ a ⟨ξ, hξL⟩ : E) = ξ - algebraMap κ E a * g₁ := by
    intro a
    have e : (⟨ξ, hξL⟩ : L) = ⟨g₀, hg₀L⟩ - ⟨g₁, hg₁L⟩ * ⟨y, hyL⟩ := Subtype.ext rfl
    rw [e, map_sub, map_mul]
    push_cast
    rw [hτM a _ hg₀, hτM a _ hg₁, hτy a _ rfl]
    simp only [ξ]
    ring
  have hτS : ∀ (a : κ) (T : IntermediateField κ E), (k : Set E) ⊆ T → y ∈ T →
      ξ - algebraMap κ E a * g₁ ∈ T →
      ∀ x : L, (x : E) ∈ ((k : Set E) ∪ {y, ξ}) → (τ a x : E) ∈ T := by
    intro a T hkT hyT hξT x hx
    rcases hx with hx | hx | hx
    · rw [hτM a x (hkM hx)]; exact hkT hx
    · rw [hτy a x hx]; exact add_mem hyT (IntermediateField.algebraMap_mem T a)
    · have hx' : x = ⟨ξ, hξL⟩ := Subtype.ext (Set.mem_singleton_iff.mp hx)
      rw [hx', hτξ a]; exact hξT
  have hS₁L : ((k : Set E) ∪ {y, ξ}) ⊆ (L : Set E) := by
    rintro z (hz | hz | hz)
    · exact hkL z hz
    · rw [hz]; exact hyL
    · rw [Set.mem_singleton_iff.mp hz]; exact hξL
  have hkK₂ : (k : Set E) ⊆ K₂ := fun z hz => IntermediateField.subset_adjoin κ _ (Or.inl hz)
  have hyK₂ : y ∈ K₂ := IntermediateField.subset_adjoin κ _ (Or.inr (Set.mem_insert _ _))
  have hξK₂ : ξ ∈ K₂ := IntermediateField.subset_adjoin κ _
    (Or.inr (Set.mem_insert_of_mem _ (Set.mem_insert _ _)))
  have hg₁K₂ : g₁ ∈ K₂ := IntermediateField.subset_adjoin κ _
    (Or.inr (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_singleton _))))
  have hK₂L : K₂ ≤ L := by
    rw [IntermediateField.adjoin_le_iff]
    rintro z (hz | hz | hz | hz)
    · exact hkL z hz
    · rw [hz]; exact hyL
    · rw [hz]; exact hξL
    · rw [Set.mem_singleton_iff.mp hz]; exact hg₁L

  have hsep₂ : ∀ a : κ, IsSeparable K₂ (τ a ⟨ω, hω⟩ : E) := fun a =>
    sep_transport L K₂ _ hS₁L (τ a)
      (hτS a K₂ hkK₂ hyK₂ (sub_mem hξK₂ (mul_mem (IntermediateField.algebraMap_mem K₂ a) hg₁K₂)))
      ω hω hsep
  have hsep₁ : ∀ a : κ, IsSeparable
      (IntermediateField.adjoin κ ((k : Set E) ∪ {y, ξ - algebraMap κ E a * g₁}))
      (τ a ⟨ω, hω⟩ : E) := fun a =>
    sep_transport L _ _ hS₁L (τ a)
      (hτS a _ (fun z hz => IntermediateField.subset_adjoin κ _ (Or.inl hz))
        (IntermediateField.subset_adjoin κ _ (Or.inr (Set.mem_insert _ _)))
        (IntermediateField.subset_adjoin κ _
          (Or.inr (Set.mem_insert_of_mem _ (Set.mem_singleton _)))))
      ω hω hsep
  have hθL : ∀ a : κ, (τ a ⟨ω, hω⟩ : E) ∈ L := fun a => (τ a ⟨ω, hω⟩).2
  have hZ : ∀ a : κ, IntermediateField.adjoin κ ((K₂ : Set E) ∪ {(τ a ⟨ω, hω⟩ : E)}) ∈
      {Z : IntermediateField κ E | K₂ ≤ Z ∧ Z ≤ L ∧ ∀ z ∈ Z, IsSeparable K₂ z} := by
    intro a
    refine ⟨fun z hz => IntermediateField.subset_adjoin κ _ (Or.inl hz), ?_, ?_⟩
    · rw [IntermediateField.adjoin_le_iff]
      exact Set.union_subset (fun z hz => hK₂L hz) (Set.singleton_subset_iff.mpr (hθL a))
    · intro z hz
      rw [← IntermediateField.restrictScalars_adjoin] at hz
      have hz' := (IntermediateField.mem_restrictScalars κ).mp hz
      haveI : Algebra.IsSeparable K₂ (IntermediateField.adjoin K₂ {(τ a ⟨ω, hω⟩ : E)}) :=
        (IntermediateField.isSeparable_adjoin_simple_iff_isSeparable K₂ E).mpr (hsep₂ a)
      exact IntermediateField.isSeparable_of_mem_isSeparable K₂ E hz'
  haveI := hfin.to_subtype
  obtain ⟨a₁, a₂, hne, heq⟩ := Finite.exists_ne_map_eq_of_infinite
    (fun a : κ => (⟨_, hZ a⟩ : {Z : IntermediateField κ E |
      K₂ ≤ Z ∧ Z ≤ L ∧ ∀ z ∈ Z, IsSeparable K₂ z}))
  have heqZ := congrArg Subtype.val heq
  simp only at heqZ

  set K₀ := IntermediateField.adjoin κ ((k : Set E) ∪ {y}) with hK₀def
  set P := IntermediateField.adjoin κ ((k : Set E) ∪ {y, ξ - algebraMap κ E a₁ * g₁}) with hPdef
  set θ₁ : E := (τ a₁ ⟨ω, hω⟩ : E) with hθ₁def
  set θ₂ : E := (τ a₂ ⟨ω, hω⟩ : E) with hθ₂def
  set ξ₁ : E := ξ - algebraMap κ E a₁ * g₁ with hξ₁def
  set ξ₂ : E := ξ - algebraMap κ E a₂ * g₁ with hξ₂def
  set N := IntermediateField.adjoin κ ((P : Set E) ∪ {θ₁}) with hNdef
  have h0 := lw_sc_adjoin_transcendental κ E k M hkM y hy hSC
  have halg : IsAlgebraic P θ₁ := (hsep₁ a₁).isIntegral.isAlgebraic
  have htrP : Transcendental P ξ₂ := shifted y ξ g₁ hind a₁ a₂ hne
  have htrN : Transcendental N ξ₂ := trans_adj P θ₁ ξ₂ halg htrP
  have hPN : P ≤ N := fun z hz => IntermediateField.subset_adjoin κ _ (Or.inl hz)
  have hK₀P : K₀ ≤ P := IntermediateField.adjoin.mono κ _ _
    (Set.union_subset_union_right _ (Set.singleton_subset_iff.mpr (Set.mem_insert _ _)))
  have hK₀N : K₀ ≤ N := le_trans hK₀P hPN
  have hξ₁L : ξ₁ ∈ L := sub_mem hξL (mul_mem (IntermediateField.algebraMap_mem L a₁) hg₁L)
  have hPL : P ≤ L := by
    rw [IntermediateField.adjoin_le_iff]
    rintro z (hz | hz | hz)
    · exact hkL z hz
    · rw [hz]; exact hyL
    · rw [Set.mem_singleton_iff.mp hz]; exact hξ₁L
  have hNL : N ≤ L := by
    rw [IntermediateField.adjoin_le_iff]
    exact Set.union_subset (fun z hz => hPL hz) (Set.singleton_subset_iff.mpr (hθL a₁))
  have hSC0N : ∀ w ∈ N, IsSeparable K₀ w → w ∈ K₀ := fun w hw hs => h0 w (hNL hw) hs
  have h1 := lw_sc_adjoin_transcendental κ E K₀ N hK₀N ξ₂ htrN hSC0N
  set NX := IntermediateField.adjoin κ ((N : Set E) ∪ {ξ₂}) with hNXdef
  have hNNX : N ≤ NX := fun z hz => IntermediateField.subset_adjoin κ _ (Or.inl hz)
  have hξ₂NX : ξ₂ ∈ NX := IntermediateField.subset_adjoin κ _ (Or.inr (Set.mem_singleton _))
  have hξ₁NX : ξ₁ ∈ NX := hNNX (hPN (IntermediateField.subset_adjoin κ _
    (Or.inr (Set.mem_insert_of_mem _ (Set.mem_singleton _)))))
  have hne' : algebraMap κ E a₂ - algebraMap κ E a₁ ≠ 0 := by
    rw [← map_sub]
    exact (map_ne_zero _).mpr (sub_ne_zero.mpr (Ne.symm hne))
  have hg₁eq : g₁ = (ξ₁ - ξ₂) * (algebraMap κ E a₂ - algebraMap κ E a₁)⁻¹ := by
    rw [eq_mul_inv_iff_mul_eq₀ hne']
    simp only [ξ₁, ξ₂]
    ring
  have hg₁NX : g₁ ∈ NX := by
    rw [hg₁eq]; exact mul_mem (sub_mem hξ₁NX hξ₂NX) (inv_mem (sub_mem
      (IntermediateField.algebraMap_mem NX a₂) (IntermediateField.algebraMap_mem NX a₁)))
  have hξNX : ξ ∈ NX := by
    have e : ξ = ξ₁ + algebraMap κ E a₁ * g₁ := by simp only [ξ₁]; ring
    rw [e]; exact add_mem hξ₁NX (mul_mem (IntermediateField.algebraMap_mem NX a₁) hg₁NX)
  have hK₀NX : K₀ ≤ NX := le_trans hK₀N hNNX
  have hkK₀ : (k : Set E) ⊆ K₀ := fun z hz => IntermediateField.subset_adjoin κ _ (Or.inl hz)
  have hyK₀ : y ∈ K₀ := IntermediateField.subset_adjoin κ _ (Or.inr (Set.mem_singleton _))
  have hK₂NX : K₂ ≤ NX := by
    rw [IntermediateField.adjoin_le_iff]
    rintro z (hz | hz | hz | hz)
    · exact hK₀NX (hkK₀ hz)
    · rw [hz]; exact hK₀NX hyK₀
    · rw [hz]; exact hξNX
    · rw [Set.mem_singleton_iff.mp hz]; exact hg₁NX
  have hθ₂NX : θ₂ ∈ NX := by
    have hθ₂Z : θ₂ ∈ IntermediateField.adjoin κ ((K₂ : Set E) ∪ {θ₂}) :=
      IntermediateField.subset_adjoin κ _ (Or.inr (Set.mem_singleton _))
    have hZle : IntermediateField.adjoin κ ((K₂ : Set E) ∪ {θ₁}) ≤ NX := by
      rw [IntermediateField.adjoin_le_iff]
      exact Set.union_subset (fun z hz => hK₂NX hz) (Set.singleton_subset_iff.mpr
        (hNNX (IntermediateField.subset_adjoin κ _ (Or.inr (Set.mem_singleton _)))))
    rw [← heqZ] at hθ₂Z
    exact hZle hθ₂Z
  have hK₀eq : IntermediateField.adjoin κ ((K₀ : Set E) ∪ {ξ₂}) =
      IntermediateField.adjoin κ ((k : Set E) ∪ {y, ξ₂}) := by
    apply le_antisymm
    · rw [IntermediateField.adjoin_le_iff]
      refine Set.union_subset ?_ (Set.singleton_subset_iff.mpr
        (IntermediateField.subset_adjoin κ _
          (Or.inr (Set.mem_insert_of_mem _ (Set.mem_singleton _)))))
      have : K₀ ≤ IntermediateField.adjoin κ ((k : Set E) ∪ {y, ξ₂}) :=
        IntermediateField.adjoin.mono κ _ _
          (Set.union_subset_union_right _ (Set.singleton_subset_iff.mpr (Set.mem_insert _ _)))
      exact fun z hz => this hz
    · rw [IntermediateField.adjoin_le_iff]
      rintro z (hz | hz | hz)
      · exact IntermediateField.subset_adjoin κ _ (Or.inl (hkK₀ hz))
      · rw [hz]; exact IntermediateField.subset_adjoin κ _ (Or.inl hyK₀)
      · rw [Set.mem_singleton_iff.mp hz]
        exact IntermediateField.subset_adjoin κ _ (Or.inr (Set.mem_singleton _))
  rw [hK₀eq] at h1
  have hθ₂K : θ₂ ∈ IntermediateField.adjoin κ ((k : Set E) ∪ {y, ξ₂}) := h1 θ₂ hθ₂NX (hsep₁ a₂)

  set K₁ := IntermediateField.adjoin κ ((k : Set E) ∪ {y, ξ}) with hK₁def
  have hW : IntermediateField.adjoin κ ((k : Set E) ∪ {y, ξ₂}) ≤
      (K₁.comap L.val).map (L.val.comp (τ a₂)) := by
    rw [IntermediateField.adjoin_le_iff]
    rintro z (hz | hz | hz)
    · refine (IntermediateField.mem_map _).mpr ⟨⟨z, hkL z hz⟩, ?_, ?_⟩
      · show z ∈ K₁
        exact IntermediateField.subset_adjoin κ _ (Or.inl hz)
      · show (τ a₂ ⟨z, hkL z hz⟩ : E) = z
        exact hτM a₂ _ (hkM hz)
    · refine (IntermediateField.mem_map _).mpr ⟨⟨y, hyL⟩ - algebraMap κ L a₂, ?_, ?_⟩
      · show y - algebraMap κ E a₂ ∈ K₁
        exact sub_mem (IntermediateField.subset_adjoin κ _ (Or.inr (Set.mem_insert _ _)))
          (IntermediateField.algebraMap_mem K₁ a₂)
      · show (τ a₂ (⟨y, hyL⟩ - algebraMap κ L a₂) : E) = z
        rw [map_sub, AlgHom.commutes]
        push_cast
        rw [hτy a₂ _ rfl, hz]
        simp
    · refine (IntermediateField.mem_map _).mpr ⟨⟨ξ, hξL⟩, ?_, ?_⟩
      · show ξ ∈ K₁
        exact IntermediateField.subset_adjoin κ _
          (Or.inr (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
      · show (τ a₂ ⟨ξ, hξL⟩ : E) = z
        rw [hτξ a₂, Set.mem_singleton_iff.mp hz]
  obtain ⟨z, hzK, hzeq⟩ := (IntermediateField.mem_map _).mp (hW hθ₂K)
  have hzeq' : τ a₂ z = τ a₂ ⟨ω, hω⟩ := Subtype.ext hzeq
  have hzω : z = ⟨ω, hω⟩ := (τ a₂).toRingHom.injective hzeq'
  have hzK' : (z : E) ∈ K₁ := hzK
  rw [hzω] at hzK'
  exact hzK'

theorem lw_shear_step_independence (κ : Type u) [Field κ] (d : ℕ) (Ω : Type u) [Field Ω]
    [Algebra κ Ω] (x B C : Fin (d + 1) → Ω) (u v : Ω)
    (hind : AlgebraicIndependent κ (fun o : Option (Fin 3 × Fin (d + 1)) => o.elim u
        (fun q => ![fun i => x i - u * B i - v * C i, B, C] q.1 q.2)))
    (hBC : AlgebraicIndependent (IntermediateField.adjoin κ (Set.range x ∪ {u, v}))
        (fun q : Fin 2 × Fin (d + 1) => ![B, C] q.1 q.2))
    (i₀ : Fin (d + 1)) :
    Transcendental (IntermediateField.adjoin κ
        (Set.range x ∪ {u, v} ∪ B '' {i | i < i₀} ∪ C '' {i | i < i₀})) (C i₀) ∧
    Transcendental (IntermediateField.adjoin κ
        (Set.range x ∪ {u, v} ∪ B '' {i | i < i₀} ∪ C '' {i | i ≤ i₀})) (B i₀) ∧
    AlgebraicIndependent (IntermediateField.adjoin κ
        ((fun i => x i - u * B i - v * C i) '' {i | i < i₀} ∪ B '' {i | i < i₀} ∪
          C '' {i | i ≤ i₀}))
      ![B i₀, x i₀ - u * B i₀ - v * C i₀, u] :=
by
  classical

  have L1 : ∀ (S0 : Set Ω) {ι : Type} (β : ι → Ω),
      AlgebraicIndependent (IntermediateField.adjoin κ S0) β →
      ∀ (s : Set ι) (i : ι), i ∉ s → ∀ (T : Set Ω), S0 ∪ β '' s = T →
      Transcendental (IntermediateField.adjoin κ T) (β i) := by
    intro S0 ι β hβ s i hi T hT halg
    subst hT
    have h1 : Transcendental (Algebra.adjoin (IntermediateField.adjoin κ S0) (β '' s)) (β i) :=
      hβ.transcendental_adjoin hi
    have h2 : Transcendental
        (IntermediateField.adjoin (IntermediateField.adjoin κ S0) (β '' s)) (β i) := by
      intro h
      exact h1 (IntermediateField.isAlgebraic_adjoin_iff.mp h)
    have hsub : ∀ w ∈ IntermediateField.adjoin κ (S0 ∪ β '' s),
        w ∈ IntermediateField.adjoin (IntermediateField.adjoin κ S0) (β '' s) := by
      intro w hw
      rw [← IntermediateField.adjoin_adjoin_left] at hw
      exact (IntermediateField.mem_restrictScalars κ).mp hw
    let f : IntermediateField.adjoin κ (S0 ∪ β '' s) →+*
        IntermediateField.adjoin (IntermediateField.adjoin κ S0) (β '' s) :=
      (algebraMap (IntermediateField.adjoin κ (S0 ∪ β '' s)) Ω).codRestrict
        (IntermediateField.adjoin (IntermediateField.adjoin κ S0) (β '' s))
        (fun w => hsub w.1 w.2)
    exact h2 (IsAlgebraic.ringHom_of_comp_eq f (RingHom.id Ω) halg f.injective
      (RingHom.ext fun w => rfl))

  have L2 : ∀ {ι : Type} (φ : ι → Ω), AlgebraicIndependent κ φ → ∀ (s : Set ι)
      (e : Fin 3 → ι), Function.Injective e → (∀ k, e k ∉ s) →
      ∀ (T : Set Ω) (y : Fin 3 → Ω), φ '' s = T → (∀ k, φ (e k) = y k) →
      AlgebraicIndependent (IntermediateField.adjoin κ T) y := by
    intro ι φ hφ s e he hes T y hT hy
    subst hT
    have hy' : φ ∘ e = y := funext hy
    subst hy'
    have h1 : AlgebraicIndependent (Algebra.adjoin κ (φ '' s)) (fun j : ↥(sᶜ) => φ j) :=
      ((AlgebraicIndependent.iff_adjoin_image s).mp hφ).2
    have h2 := h1.comp (fun k => (⟨e k, hes k⟩ : ↥(sᶜ)))
      (fun a b h => he (congrArg Subtype.val h))
    exact IntermediateField.algebraicIndependent_adjoin_iff.mpr h2
  refine ⟨?_, ?_, ?_⟩
  ·
    refine L1 (Set.range x ∪ {u, v}) (fun q : Fin 2 × Fin (d + 1) => ![B, C] q.1 q.2) hBC
      {q | q.2 < i₀} ((1 : Fin 2), i₀) (fun h => lt_irrefl i₀ h) _ ?_
    rw [Set.union_assoc (Set.range x ∪ {u, v})]
    congr 1
    ext z
    constructor
    · rintro ⟨⟨a, i⟩, hi, rfl⟩
      fin_cases a
      · exact Or.inl ⟨i, hi, rfl⟩
      · exact Or.inr ⟨i, hi, rfl⟩
    · rintro (⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩)
      · exact ⟨((0 : Fin 2), i), hi, rfl⟩
      · exact ⟨((1 : Fin 2), i), hi, rfl⟩
  ·
    refine L1 (Set.range x ∪ {u, v}) (fun q : Fin 2 × Fin (d + 1) => ![B, C] q.1 q.2) hBC
      {q | (q.1 = 0 ∧ q.2 < i₀) ∨ (q.1 = 1 ∧ q.2 ≤ i₀)} ((0 : Fin 2), i₀) ?_ _ ?_
    · rintro (⟨-, h⟩ | ⟨h, -⟩)
      · exact lt_irrefl i₀ h
      · exact (by decide : (0 : Fin 2) ≠ 1) h
    rw [Set.union_assoc (Set.range x ∪ {u, v})]
    congr 1
    ext z
    constructor
    · rintro ⟨⟨a, i⟩, hq, rfl⟩
      rcases hq with ⟨ha, hi⟩ | ⟨ha, hi⟩
      · dsimp only at ha hi
        subst ha
        exact Or.inl ⟨i, hi, rfl⟩
      · dsimp only at ha hi
        subst ha
        exact Or.inr ⟨i, hi, rfl⟩
    · rintro (⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩)
      · exact ⟨((0 : Fin 2), i), Or.inl ⟨rfl, hi⟩, rfl⟩
      · exact ⟨((1 : Fin 2), i), Or.inr ⟨rfl, hi⟩, rfl⟩
  ·
    refine L2 _ hind
      {o | ∃ q : Fin 3 × Fin (d + 1), o = some q ∧ ((q.1 ≠ 2 ∧ q.2 < i₀) ∨ (q.1 = 2 ∧ q.2 ≤ i₀))}
      ![some (1, i₀), some (0, i₀), none] ?_ ?_ _ _ ?_ ?_
    · intro a b h
      fin_cases a <;> fin_cases b <;> simp_all
    · intro k
      fin_cases k
      · rintro ⟨q, hq, hq'⟩
        change some ((1 : Fin 3), i₀) = some q at hq
        cases hq
        rcases hq' with ⟨-, h⟩ | ⟨h, -⟩
        · exact lt_irrefl i₀ h
        · exact (by decide : (1 : Fin 3) ≠ 2) h
      · rintro ⟨q, hq, hq'⟩
        change some ((0 : Fin 3), i₀) = some q at hq
        cases hq
        rcases hq' with ⟨-, h⟩ | ⟨h, -⟩
        · exact lt_irrefl i₀ h
        · exact (by decide : (0 : Fin 3) ≠ 2) h
      · rintro ⟨q, hq, -⟩
        change none = some q at hq
        cases hq
    · ext z
      constructor
      · rintro ⟨o, ⟨⟨a, i⟩, rfl, hq⟩, rfl⟩
        fin_cases a
        · rcases hq with ⟨-, hi⟩ | ⟨h2, -⟩
          · exact Or.inl (Or.inl ⟨i, hi, rfl⟩)
          · simp at h2
        · rcases hq with ⟨-, hi⟩ | ⟨h2, -⟩
          · exact Or.inl (Or.inr ⟨i, hi, rfl⟩)
          · simp at h2
        · rcases hq with ⟨h2, -⟩ | ⟨-, hi⟩
          · exact absurd rfl h2
          · exact Or.inr ⟨i, hi, rfl⟩
      · rintro ((⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩) | ⟨i, hi, rfl⟩)
        · exact ⟨some (0, i), ⟨(0, i), rfl, Or.inl ⟨by simp, hi⟩⟩, rfl⟩
        · exact ⟨some (1, i), ⟨(1, i), rfl, Or.inl ⟨by simp, hi⟩⟩, rfl⟩
        · exact ⟨some (2, i), ⟨(2, i), rfl, Or.inr ⟨rfl, hi⟩⟩, rfl⟩
    · intro k
      fin_cases k <;> rfl

theorem lw_plane_section_sc (κ : Type u) [Field κ] [IsAlgClosed κ] (d : ℕ)
    (Ω : Type u) [Field Ω] [Algebra κ Ω]
    [Algebra (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) Ω]
    (x B C : Fin (d + 1) → Ω) (u v : Ω)
    (hι : ∀ p : MvPolynomial (Fin 3 × Fin (d + 1)) κ,
      algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) Ω
        (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
          (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) p) =
      MvPolynomial.aeval (fun q : Fin 3 × Fin (d + 1) =>
        ![fun i => x i - u * B i - v * C i, B, C] q.1 q.2) p)
    (hgen : IntermediateField.adjoin κ (Set.range x ∪ Set.range B ∪ Set.range C ∪ {u, v}) = ⊤)
    (hind : AlgebraicIndependent κ (fun o : Option (Fin 3 × Fin (d + 1)) => o.elim u
        (fun q => ![fun i => x i - u * B i - v * C i, B, C] q.1 q.2)))
    (hBC : AlgebraicIndependent (IntermediateField.adjoin κ (Set.range x ∪ {u, v}))
        (fun q : Fin 2 × Fin (d + 1) => ![B, C] q.1 q.2)) :
    ∀ ω : Ω, IsSeparable (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) ω →
      ω ∈ Set.range (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) Ω) :=
by
  classical

  have hJ : ∀ S T : Set Ω, IntermediateField.adjoin κ
      ((IntermediateField.adjoin κ S : Set Ω) ∪ T) = IntermediateField.adjoin κ (S ∪ T) := by
    intro S T
    apply le_antisymm
    · rw [IntermediateField.adjoin_le_iff]
      refine Set.union_subset ?_ ?_
      · exact SetLike.coe_subset_coe.mpr
          (IntermediateField.adjoin.mono κ _ _ Set.subset_union_left)
      · exact Set.subset_union_right.trans (IntermediateField.subset_adjoin κ _)
    · exact IntermediateField.adjoin.mono κ _ _
        (Set.union_subset_union_left T (IntermediateField.subset_adjoin κ S))

  have hkle : ∀ S S2 : Set (Fin (d + 1)), S ⊆ S2 →
      IntermediateField.adjoin κ ((fun i => x i - u * B i - v * C i) '' S ∪ B '' S ∪ C '' S2) ≤
      IntermediateField.adjoin κ (Set.range x ∪ {u, v} ∪ B '' S ∪ C '' S2) := by
    intro S S2 hS
    rw [IntermediateField.adjoin_le_iff]
    rintro _ ((⟨i, hi, rfl⟩ | ⟨i, hi, rfl⟩) | ⟨i, hi, rfl⟩)
    · have hx : x i ∈ IntermediateField.adjoin κ (Set.range x ∪ {u, v} ∪ B '' S ∪ C '' S2) :=
        IntermediateField.subset_adjoin κ _ (Or.inl (Or.inl (Or.inl ⟨i, rfl⟩)))
      have hu : u ∈ IntermediateField.adjoin κ (Set.range x ∪ {u, v} ∪ B '' S ∪ C '' S2) :=
        IntermediateField.subset_adjoin κ _ (Or.inl (Or.inl (Or.inr (Set.mem_insert u {v}))))
      have hv : v ∈ IntermediateField.adjoin κ (Set.range x ∪ {u, v} ∪ B '' S ∪ C '' S2) :=
        IntermediateField.subset_adjoin κ _
          (Or.inl (Or.inl (Or.inr (Set.mem_insert_of_mem u (Set.mem_singleton v)))))
      have hB : B i ∈ IntermediateField.adjoin κ (Set.range x ∪ {u, v} ∪ B '' S ∪ C '' S2) :=
        IntermediateField.subset_adjoin κ _ (Or.inl (Or.inr ⟨i, hi, rfl⟩))
      have hC : C i ∈ IntermediateField.adjoin κ (Set.range x ∪ {u, v} ∪ B '' S ∪ C '' S2) :=
        IntermediateField.subset_adjoin κ _ (Or.inr ⟨i, hS hi, rfl⟩)
      exact sub_mem (sub_mem hx (mul_mem hu hB)) (mul_mem hv hC)
    · exact IntermediateField.subset_adjoin κ _ (Or.inl (Or.inr ⟨i, hi, rfl⟩))
    · exact IntermediateField.subset_adjoin κ _ (Or.inr ⟨i, hi, rfl⟩)

  have key : ∀ j : ℕ, j ≤ d + 1 → ∀ ω ∈ IntermediateField.adjoin κ
      (Set.range x ∪ {u, v} ∪ B '' {i : Fin (d + 1) | i.val < j} ∪
        C '' {i : Fin (d + 1) | i.val < j}),
      IsSeparable (IntermediateField.adjoin κ ((fun i => x i - u * B i - v * C i) ''
        {i : Fin (d + 1) | i.val < j} ∪ B '' {i : Fin (d + 1) | i.val < j} ∪
        C '' {i : Fin (d + 1) | i.val < j})) ω →
      ω ∈ IntermediateField.adjoin κ ((fun i => x i - u * B i - v * C i) ''
        {i : Fin (d + 1) | i.val < j} ∪ B '' {i : Fin (d + 1) | i.val < j} ∪
        C '' {i : Fin (d + 1) | i.val < j}) := by
    intro j
    induction j with
    | zero =>
      intro _ ω _ hsep
      have h0 : IntermediateField.adjoin κ ((fun i => x i - u * B i - v * C i) ''
          {i : Fin (d + 1) | i.val < 0} ∪ B '' {i : Fin (d + 1) | i.val < 0} ∪
          C '' {i : Fin (d + 1) | i.val < 0}) = ⊥ := by
        have hS : {i : Fin (d + 1) | i.val < 0} = ∅ := by
          ext i; simp
        rw [hS]
        simp only [Set.image_empty, Set.union_empty]
        exact IntermediateField.adjoin_empty κ Ω
      rw [h0] at hsep ⊢
      have hint : IsIntegral κ ω :=
        isIntegral_trans (A := (⊥ : IntermediateField κ Ω)) ω hsep.isIntegral
      rw [IntermediateField.mem_bot]
      exact minpoly.mem_range_of_degree_eq_one κ ω
        (IsAlgClosed.degree_eq_one_of_irreducible κ (minpoly.irreducible hint))
    | succ j ih =>
      intro hj ω hω hsep
      have ih' := ih (by omega)
      obtain ⟨i₀, hi₀⟩ : ∃ i₀ : Fin (d + 1), i₀.val = j := ⟨⟨j, by omega⟩, rfl⟩
      have hlt : {i : Fin (d + 1) | i < i₀} = {i : Fin (d + 1) | i.val < j} := by
        ext i; simp only [Set.mem_setOf_eq, Fin.lt_def, hi₀]
      have hle : {i : Fin (d + 1) | i ≤ i₀} = {i : Fin (d + 1) | i.val < j + 1} := by
        ext i; simp only [Set.mem_setOf_eq, Fin.le_def, hi₀]; omega
      have hins : {i : Fin (d + 1) | i.val < j + 1} =
          insert i₀ {i : Fin (d + 1) | i.val < j} := by
        ext i; simp only [Set.mem_setOf_eq, Set.mem_insert_iff, Fin.ext_iff, hi₀]; omega
      obtain ⟨T1, T2, T3⟩ := lw_shear_step_independence κ d Ω x B C u v hind hBC i₀
      rw [hlt] at T1 T2 T3
      rw [hle, hins] at T2 T3
      rw [hins] at hω hsep ⊢
      generalize {i : Fin (d + 1) | i.val < j} = S at ih' T1 T2 T3 hω hsep ⊢

      have h1 := lw_sc_adjoin_transcendental κ Ω _ _ (hkle S S subset_rfl) (C i₀) T1 ih'
      obtain ⟨GO, hGO⟩ : ∃ G : Set Ω, G = Set.range x ∪ {u, v} ∪ B '' S ∪ C '' insert i₀ S :=
        ⟨_, rfl⟩
      obtain ⟨GK, hGK⟩ : ∃ G : Set Ω, G = (fun i => x i - u * B i - v * C i) '' S ∪ B '' S ∪
          C '' insert i₀ S := ⟨_, rfl⟩
      have e1 : Set.range x ∪ {u, v} ∪ B '' S ∪ C '' S ∪ {C i₀} = GO := by
        rw [hGO, Set.image_insert_eq]; ext z
        simp only [Set.mem_union, Set.mem_insert_iff, Set.mem_singleton_iff]; tauto
      have e2 : (fun i => x i - u * B i - v * C i) '' S ∪ B '' S ∪ C '' S ∪ {C i₀} = GK := by
        rw [hGK, Set.image_insert_eq]; ext z
        simp only [Set.mem_union, Set.mem_insert_iff, Set.mem_singleton_iff]; tauto
      rw [hJ, hJ, e1, e2] at h1

      have hkM : IntermediateField.adjoin κ GK ≤ IntermediateField.adjoin κ GO := by
        rw [hGK, hGO]; exact hkle S _ (Set.subset_insert i₀ S)
      rw [← hGO] at T2
      rw [← hGK] at T3
      have hxO : x i₀ ∈ IntermediateField.adjoin κ GO :=
        IntermediateField.subset_adjoin κ _ (by rw [hGO]; exact Or.inl (Or.inl (Or.inl ⟨i₀, rfl⟩)))
      have huO : u ∈ IntermediateField.adjoin κ GO :=
        IntermediateField.subset_adjoin κ _
          (by rw [hGO]; exact Or.inl (Or.inl (Or.inr (Set.mem_insert u {v}))))
      have hvO : v ∈ IntermediateField.adjoin κ GO :=
        IntermediateField.subset_adjoin κ _ (by
          rw [hGO]; exact Or.inl (Or.inl (Or.inr (Set.mem_insert_of_mem u (Set.mem_singleton v)))))
      have hCO : C i₀ ∈ IntermediateField.adjoin κ GO :=
        IntermediateField.subset_adjoin κ _
          (by rw [hGO]; exact Or.inr ⟨i₀, Set.mem_insert i₀ S, rfl⟩)
      have hg₀ : x i₀ - v * C i₀ ∈ IntermediateField.adjoin κ GO := sub_mem hxO (mul_mem hvO hCO)
      have hξ : x i₀ - v * C i₀ - u * B i₀ = x i₀ - u * B i₀ - v * C i₀ := by ring
      have hind' : AlgebraicIndependent (IntermediateField.adjoin κ GK)
          ![B i₀, x i₀ - v * C i₀ - u * B i₀, u] := by rw [hξ]; exact T3
      have hGOfin : GO.Finite := by rw [hGO]; exact Set.toFinite _
      have hBL : B i₀ ∈ IntermediateField.adjoin κ
          ((IntermediateField.adjoin κ GO : Set Ω) ∪ {B i₀}) :=
        IntermediateField.subset_adjoin κ _ (Or.inr rfl)
      have hML : IntermediateField.adjoin κ GO ≤ IntermediateField.adjoin κ
          ((IntermediateField.adjoin κ GO : Set Ω) ∪ {B i₀}) :=
        fun z hz => IntermediateField.subset_adjoin κ _ (Or.inl hz)
      have hFL : IntermediateField.adjoin κ ((IntermediateField.adjoin κ GK : Set Ω) ∪
          {B i₀, x i₀ - v * C i₀ - u * B i₀, u}) ≤ IntermediateField.adjoin κ
          ((IntermediateField.adjoin κ GO : Set Ω) ∪ {B i₀}) := by
        rw [IntermediateField.adjoin_le_iff]
        refine Set.union_subset (fun w hw => hML (hkM hw)) ?_
        refine Set.insert_subset_iff.mpr ⟨hBL, Set.insert_subset_iff.mpr
          ⟨sub_mem (hML hg₀) (mul_mem (hML huO) hBL), Set.singleton_subset_iff.mpr (hML huO)⟩⟩
      have hL : IntermediateField.adjoin κ ((IntermediateField.adjoin κ GO : Set Ω) ∪ {B i₀}) =
          IntermediateField.adjoin κ ((IntermediateField.adjoin κ
            ((IntermediateField.adjoin κ GK : Set Ω) ∪ {B i₀, x i₀ - v * C i₀ - u * B i₀, u}) :
              Set Ω) ∪ (GO ∪ {B i₀})) := by
        apply le_antisymm
        · rw [IntermediateField.adjoin_le_iff]
          rintro z (hz | hz)
          · have hle' := IntermediateField.adjoin.mono κ GO
              ((IntermediateField.adjoin κ ((IntermediateField.adjoin κ GK : Set Ω) ∪
                {B i₀, x i₀ - v * C i₀ - u * B i₀, u}) : Set Ω) ∪ (GO ∪ {B i₀}))
              (fun w hw => Or.inr (Or.inl hw))
            exact hle' hz
          · exact IntermediateField.subset_adjoin κ _ (Or.inr (Or.inr hz))
        · rw [IntermediateField.adjoin_le_iff]
          rintro z (hz | hz | hz)
          · exact hFL hz
          · exact hML (IntermediateField.subset_adjoin κ GO hz)
          · rw [Set.mem_singleton_iff.mp hz]; exact hBL
      have hfin := lw_finite_separable_intermediate κ Ω _ _ (GO ∪ {B i₀})
        (hGOfin.union (Set.finite_singleton _)) hL
      have h3 := lw_affine_translation_sc κ Ω _ _ hkM h1 (B i₀) (x i₀ - v * C i₀) u hg₀ huO T2
        hind' hfin

      rw [hJ, hJ, hξ] at h3
      have e3 : GO ∪ {B i₀} = Set.range x ∪ {u, v} ∪ B '' insert i₀ S ∪ C '' insert i₀ S := by
        rw [hGO]; simp only [Set.image_insert_eq]; ext z
        simp only [Set.mem_union, Set.mem_insert_iff, Set.mem_singleton_iff]; tauto
      have e4 : GK ∪ {B i₀, x i₀ - u * B i₀ - v * C i₀} =
          (fun i => x i - u * B i - v * C i) '' insert i₀ S ∪ B '' insert i₀ S ∪
            C '' insert i₀ S := by
        rw [hGK]; simp only [Set.image_insert_eq]; ext z
        simp only [Set.mem_union, Set.mem_insert_iff, Set.mem_singleton_iff]; tauto
      rw [e3, e4] at h3
      exact h3 ω hω hsep

  have huniv : {i : Fin (d + 1) | i.val < d + 1} = Set.univ := by
    ext i; simp only [Set.mem_setOf_eq, Set.mem_univ, iff_true]; exact i.isLt
  obtain ⟨Gn, hGn⟩ : ∃ G : Set Ω,
      G = Set.range (fun i => x i - u * B i - v * C i) ∪ Set.range B ∪ Set.range C := ⟨_, rfl⟩
  have key2 : ∀ ω ∈ IntermediateField.adjoin κ
      (Set.range x ∪ {u, v} ∪ Set.range B ∪ Set.range C),
      IsSeparable (IntermediateField.adjoin κ Gn) ω → ω ∈ IntermediateField.adjoin κ Gn := by
    have h := key (d + 1) le_rfl
    rw [huniv, Set.image_univ, Set.image_univ, Set.image_univ, ← hGn] at h
    exact h
  have hf : ∀ p : MvPolynomial (Fin 3 × Fin (d + 1)) κ,
      MvPolynomial.aeval (fun q : Fin 3 × Fin (d + 1) =>
        ![fun i => x i - u * B i - v * C i, B, C] q.1 q.2) p ∈
      IntermediateField.adjoin κ Gn := by
    intro p
    have h1 : MvPolynomial.aeval (fun q : Fin 3 × Fin (d + 1) =>
        ![fun i => x i - u * B i - v * C i, B, C] q.1 q.2) p ∈
        Algebra.adjoin κ (Set.range (fun q : Fin 3 × Fin (d + 1) =>
          ![fun i => x i - u * B i - v * C i, B, C] q.1 q.2)) := by
      rw [Algebra.adjoin_range_eq_range_aeval]; exact ⟨p, rfl⟩
    have h2 : Algebra.adjoin κ (Set.range (fun q : Fin 3 × Fin (d + 1) =>
          ![fun i => x i - u * B i - v * C i, B, C] q.1 q.2)) ≤
        (IntermediateField.adjoin κ Gn).toSubalgebra := by
      rw [Algebra.adjoin_le_iff]
      rintro _ ⟨⟨a, i⟩, rfl⟩
      show _ ∈ IntermediateField.adjoin κ Gn
      apply IntermediateField.subset_adjoin
      rw [hGn]
      fin_cases a
      · exact Or.inl (Or.inl ⟨i, rfl⟩)
      · exact Or.inl (Or.inr ⟨i, rfl⟩)
      · exact Or.inr ⟨i, rfl⟩
    exact h2 h1
  have hrange : ∀ z : FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ),
      algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) Ω z ∈
        IntermediateField.adjoin κ Gn := by
    intro z
    obtain ⟨a, b, -, rfl⟩ :=
      IsFractionRing.div_surjective (A := MvPolynomial (Fin 3 × Fin (d + 1)) κ) z
    rw [map_div₀, hι, hι]
    exact div_mem (hf a) (hf b)
  have hsub : ∀ w ∈ IntermediateField.adjoin κ Gn,
      w ∈ Set.range (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) Ω) := by
    have hle : IntermediateField.adjoin κ Gn ≤
        (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) Ω).fieldRange.toIntermediateField
          (fun c => RingHom.mem_fieldRange.mpr
            ⟨algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
              (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) (MvPolynomial.C c),
              by rw [hι, MvPolynomial.aeval_C]⟩) := by
      rw [IntermediateField.adjoin_le_iff, hGn]
      rintro _ ((⟨i, rfl⟩ | ⟨i, rfl⟩) | ⟨i, rfl⟩)
      · exact RingHom.mem_fieldRange.mpr
          ⟨_, (hι (MvPolynomial.X ((0 : Fin 3), i))).trans (MvPolynomial.aeval_X _ _)⟩
      · exact RingHom.mem_fieldRange.mpr
          ⟨_, (hι (MvPolynomial.X ((1 : Fin 3), i))).trans (MvPolynomial.aeval_X _ _)⟩
      · exact RingHom.mem_fieldRange.mpr
          ⟨_, (hι (MvPolynomial.X ((2 : Fin 3), i))).trans (MvPolynomial.aeval_X _ _)⟩
    intro w hw
    exact (RingHom.mem_fieldRange
      (f := algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) Ω)).mp (hle hw)
  intro ω hsep
  have hω : ω ∈ IntermediateField.adjoin κ (Set.range x ∪ {u, v} ∪ Set.range B ∪ Set.range C) := by
    have e : Set.range x ∪ {u, v} ∪ Set.range B ∪ Set.range C =
        Set.range x ∪ Set.range B ∪ Set.range C ∪ {u, v} := by
      ext z; simp only [Set.mem_union]; tauto
    rw [e, hgen]; exact IntermediateField.mem_top
  letI : Algebra (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ))
      (IntermediateField.adjoin κ Gn) :=
    ((algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) Ω).codRestrict
      (IntermediateField.adjoin κ Gn) hrange).toAlgebra
  haveI : IsScalarTower (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ))
      (IntermediateField.adjoin κ Gn) Ω :=
    IsScalarTower.of_algebraMap_eq (fun z => rfl)
  exact hsub ω (key2 ω hω (IsSeparable.tower_top _ hsep))

theorem lw_sc_descent_no_factor (K Ω L : Type u) [Field K] [Field Ω] [Field L]
    [Algebra K Ω] [Algebra K L]
    (hSC : ∀ ω : Ω, IsSeparable K ω → ω ∈ Set.range (algebraMap K Ω))
    (G : MvPolynomial (Fin 2) K) (hG : Irreducible G) (D : ℕ) (hdeg : G.totalDegree ≤ D)
    (hlc : G.coeff (Finsupp.single 1 D) ≠ 0)
    (u₀ v₀ : Ω) (hroot : MvPolynomial.aeval ![u₀, v₀] G = 0) (hu₀ : Transcendental K u₀)
    (k l : ℕ) (hk : 1 ≤ k) (hl : 1 ≤ l) (hkl : k + l = D)
    (P Q : MvPolynomial (Fin 2) L)
    (hP1 : P.totalDegree ≤ k) (hP2 : P.coeff (Finsupp.single 1 k) = 1)
    (hQ1 : Q.totalDegree ≤ l) (hQ2 : Q.coeff (Finsupp.single 1 l) = 1)
    (hfac : MvPolynomial.map (algebraMap K L) G =
      MvPolynomial.C (algebraMap K L (G.coeff (Finsupp.single 1 D))) * P * Q)
    (hsep : ∀ m, IsSeparable K (P.coeff m) ∧ IsSeparable K (Q.coeff m)) : False :=
by
  classical

  have euclid : ∀ F : MvPolynomial (Fin 2) K, F.totalDegree < D →
      MvPolynomial.aeval ![u₀, v₀] F = 0 → F = 0 := by
    intro F hF hF0
    obtain ⟨lam, hlam⟩ : ∃ lam, lam = G.coeff (Finsupp.single 1 D) := ⟨_, rfl⟩
    have hlc' : lam ≠ 0 := by rw [hlam]; exact hlc
    have hD : 0 < D := lt_of_le_of_lt (Nat.zero_le _) hF
    obtain ⟨e, he_apply⟩ : ∃ e : MvPolynomial (Fin 2) K ≃ₐ[K] Polynomial (MvPolynomial (Fin 1) K),
        ∀ p, e p = MvPolynomial.finSuccEquiv K 1 (MvPolynomial.rename (Equiv.swap (0 : Fin 2) 1) p) :=
      ⟨(MvPolynomial.renameEquiv K (Equiv.swap (0 : Fin 2) 1)).trans (MvPolynomial.finSuccEquiv K 1),
        fun p => rfl⟩
    have hnat : ∀ p, (e p).natDegree = MvPolynomial.degreeOf 1 p := by
      intro p
      rw [he_apply, MvPolynomial.natDegree_finSuccEquiv]
      have := MvPolynomial.degreeOf_rename_of_injective (p := p) (Equiv.swap (0 : Fin 2) 1).injective 1
      rwa [Equiv.swap_apply_right] at this
    have heX1 : e (MvPolynomial.X 1) = Polynomial.X := by
      rw [he_apply, MvPolynomial.rename_X, Equiv.swap_apply_right, MvPolynomial.finSuccEquiv_X_zero]
    have heX0 : e (MvPolynomial.X 0) = Polynomial.C (MvPolynomial.X 0) := by
      rw [he_apply, MvPolynomial.rename_X, Equiv.swap_apply_left]
      exact MvPolynomial.finSuccEquiv_X_succ (j := 0)
    obtain ⟨H, hH⟩ : ∃ H : MvPolynomial (Fin 2) K,
        H = MvPolynomial.C lam⁻¹ * G - MvPolynomial.X 1 ^ D := ⟨_, rfl⟩
    have hHdeg : H.totalDegree ≤ D := by
      rw [hH]
      refine le_trans (MvPolynomial.totalDegree_sub _ _) (max_le ?_ ?_)
      · refine le_trans (MvPolynomial.totalDegree_mul _ _) ?_
        rw [MvPolynomial.totalDegree_C]; omega
      · rw [MvPolynomial.totalDegree_X_pow]
    have hHcoeff : H.coeff (Finsupp.single 1 D) = 0 := by
      rw [hH, MvPolynomial.coeff_sub, MvPolynomial.coeff_C_mul, ← hlam, inv_mul_cancel₀ hlc',
        MvPolynomial.coeff_X_pow, if_pos rfl, sub_self]
    have hHlt : MvPolynomial.degreeOf 1 H < D := by
      rw [MvPolynomial.degreeOf_lt_iff hD]
      intro m hm
      have h1 := le_trans (MvPolynomial.le_totalDegree hm) hHdeg
      have hsum : (m.sum fun _ e => e) = m 0 + m 1 := by
        rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two]
      rw [hsum] at h1
      by_contra hcon
      have hm1 : m 1 = D := by omega
      have hm0 : m 0 = 0 := by omega
      have hmeq : m = Finsupp.single 1 D := by
        ext j; fin_cases j <;> simp [hm0, hm1]
      rw [MvPolynomial.mem_support_iff, hmeq] at hm
      exact hm hHcoeff
    have hĝeq : e (MvPolynomial.C lam⁻¹ * G) = Polynomial.X ^ D + e H := by
      rw [hH, map_sub, map_pow, heX1]; ring
    have hlt : (e H).degree < D := by
      by_cases h0 : e H = 0
      · rw [h0, Polynomial.degree_zero]; exact WithBot.bot_lt_coe _
      · rw [Polynomial.degree_eq_natDegree h0, hnat H]; exact_mod_cast hHlt
    have hmon : (e (MvPolynomial.C lam⁻¹ * G)).Monic := by
      rw [hĝeq]; exact Polynomial.monic_X_pow_add hlt
    have hĝdeg : (e (MvPolynomial.C lam⁻¹ * G)).natDegree = D := by
      rw [hĝeq, Polynomial.natDegree_add_eq_left_of_degree_lt (by rwa [Polynomial.degree_X_pow]),
        Polynomial.natDegree_X_pow]
    have hĝirr : Irreducible (e (MvPolynomial.C lam⁻¹ * G)) := by
      rw [MulEquiv.irreducible_iff]
      exact (irreducible_isUnit_mul ((isUnit_iff_ne_zero.mpr (inv_ne_zero hlc')).map
        MvPolynomial.C)).mpr hG
    obtain ⟨j, hjdef⟩ : ∃ j : MvPolynomial (Fin 1) K →+* Ω,
        j = (MvPolynomial.aeval (fun _ : Fin 1 => u₀)).toRingHom := ⟨_, rfl⟩
    have hj : Function.Injective j := by
      rw [hjdef]
      exact algebraicIndependent_iff_injective_aeval.mp (algebraicIndependent_unique_type_iff.mpr hu₀)
    obtain ⟨J, hJ⟩ : ∃ J : FractionRing (MvPolynomial (Fin 1) K) →+* Ω,
        J.comp (algebraMap (MvPolynomial (Fin 1) K) (FractionRing (MvPolynomial (Fin 1) K))) = j :=
      ⟨IsFractionRing.lift hj, RingHom.ext fun x => IsFractionRing.lift_algebraMap hj x⟩
    letI : Algebra (FractionRing (MvPolynomial (Fin 1) K)) Ω := J.toAlgebra
    have hev : ∀ p : MvPolynomial (Fin 2) K,
        Polynomial.eval₂ j v₀ (e p) = MvPolynomial.aeval ![u₀, v₀] p := by
      intro p
      have hext : (Polynomial.eval₂RingHom j v₀).comp
          (e : MvPolynomial (Fin 2) K →+* Polynomial (MvPolynomial (Fin 1) K)) =
          (MvPolynomial.aeval ![u₀, v₀]).toRingHom := by
        apply MvPolynomial.ringHom_ext
        · intro r
          have h1 : e (MvPolynomial.C r) = Polynomial.C (MvPolynomial.C r) := by
            simpa using e.commutes r
          change Polynomial.eval₂ j v₀ (e (MvPolynomial.C r)) =
            MvPolynomial.aeval ![u₀, v₀] (MvPolynomial.C r)
          rw [h1, Polynomial.eval₂_C, MvPolynomial.aeval_C]
          rw [hjdef]
          exact MvPolynomial.aeval_C _ r
        · rw [Fin.forall_fin_two]
          constructor
          · change Polynomial.eval₂ j v₀ (e (MvPolynomial.X 0)) =
              MvPolynomial.aeval ![u₀, v₀] (MvPolynomial.X 0)
            rw [heX0, Polynomial.eval₂_C, MvPolynomial.aeval_X]
            simp [hjdef]
          · change Polynomial.eval₂ j v₀ (e (MvPolynomial.X 1)) =
              MvPolynomial.aeval ![u₀, v₀] (MvPolynomial.X 1)
            rw [heX1, Polynomial.eval₂_X, MvPolynomial.aeval_X]
            simp
      exact RingHom.congr_fun hext p
    have haeval : ∀ p : Polynomial (MvPolynomial (Fin 1) K),
        Polynomial.aeval v₀ (p.map (algebraMap _ (FractionRing (MvPolynomial (Fin 1) K)))) =
          Polynomial.eval₂ j v₀ p := by
      intro p
      rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      exact congrArg (fun φ => Polynomial.eval₂ φ v₀ p) hJ
    have hĝK_irr : Irreducible ((e (MvPolynomial.C lam⁻¹ * G)).map
        (algebraMap _ (FractionRing (MvPolynomial (Fin 1) K)))) :=
      (Polynomial.Monic.irreducible_iff_irreducible_map_fraction_map hmon).mp hĝirr
    have hĝK_mon : ((e (MvPolynomial.C lam⁻¹ * G)).map
        (algebraMap _ (FractionRing (MvPolynomial (Fin 1) K)))).Monic := hmon.map _
    have hĝroot : Polynomial.aeval v₀ ((e (MvPolynomial.C lam⁻¹ * G)).map
        (algebraMap _ (FractionRing (MvPolynomial (Fin 1) K)))) = 0 := by
      rw [haeval, hev, map_mul, MvPolynomial.aeval_C, hroot, mul_zero]
    have hmin := minpoly.eq_of_irreducible_of_monic hĝK_irr hĝroot hĝK_mon
    have hmindeg : (minpoly (FractionRing (MvPolynomial (Fin 1) K)) v₀).natDegree = D := by
      rw [← hmin, hmon.natDegree_map, hĝdeg]
    by_contra hF0'
    have heF : e F ≠ 0 := fun h => hF0' (e.injective (h.trans (map_zero e).symm))
    have hFK : (e F).map (algebraMap _ (FractionRing (MvPolynomial (Fin 1) K))) ≠ 0 := by
      rw [Ne, Polynomial.map_eq_zero_iff (IsFractionRing.injective _ _)]; exact heF
    have hFroot : Polynomial.aeval v₀
        ((e F).map (algebraMap _ (FractionRing (MvPolynomial (Fin 1) K)))) = 0 := by
      rw [haeval, hev, hF0]
    have h1 := Polynomial.natDegree_le_natDegree
      (minpoly.degree_le_of_ne_zero (FractionRing (MvPolynomial (Fin 1) K)) v₀ hFK hFroot)
    have h2 : ((e F).map (algebraMap _ (FractionRing (MvPolynomial (Fin 1) K)))).natDegree ≤
        (e F).natDegree := Polynomial.natDegree_map_le
    have h3 := MvPolynomial.degreeOf_le_totalDegree F 1
    rw [hnat F] at h2
    omega

  have minpolyDeg : ∀ θ : AlgebraicClosure Ω, IsSeparable K θ →
      (minpoly K θ).natDegree ≤ (minpoly Ω θ).natDegree := by
    intro θ hθ
    have hθint : IsIntegral K θ := hθ.isIntegral
    have hfirr : Irreducible (minpoly K θ) := minpoly.irreducible hθint
    have hfmon : (minpoly K θ).Monic := minpoly.monic hθint
    have hθΩ : IsIntegral Ω θ := IsIntegral.tower_top hθint
    have hmon : (minpoly Ω θ).Monic := minpoly.monic hθΩ
    have hdvd : minpoly Ω θ ∣ (minpoly K θ).map (algebraMap K Ω) :=
      minpoly.dvd Ω θ (by rw [Polynomial.aeval_map_algebraMap, minpoly.aeval])
    have hcoeff : ∀ j, IsSeparable K ((minpoly Ω θ).coeff j) := by
      intro j
      have hsplit := (IsAlgClosed.splits ((minpoly Ω θ).map
        (algebraMap Ω (AlgebraicClosure Ω)))).eq_prod_roots_of_monic
        (hmon.map (algebraMap Ω (AlgebraicClosure Ω)))
      have hroot' : ∀ ρ ∈ ((minpoly Ω θ).map (algebraMap Ω (AlgebraicClosure Ω))).roots,
          IsSeparable K ρ := by
        intro ρ hρ
        have h1 : (minpoly Ω θ).map (algebraMap Ω (AlgebraicClosure Ω)) ∣
            (minpoly K θ).map (algebraMap K (AlgebraicClosure Ω)) := by
          rw [IsScalarTower.algebraMap_eq K Ω (AlgebraicClosure Ω), ← Polynomial.map_map]
          exact Polynomial.map_dvd _ hdvd
        have h2 := Polynomial.eval_eq_zero_of_dvd_of_eval_eq_zero h1
          (Polynomial.mem_roots'.mp hρ).2
        have hρ' : Polynomial.aeval ρ (minpoly K θ) = 0 := by
          rw [Polynomial.aeval_def, ← Polynomial.eval_map]; exact h2
        have hm : minpoly K ρ = minpoly K θ :=
          (minpoly.eq_of_irreducible_of_monic hfirr hρ' hfmon).symm
        unfold IsSeparable
        rw [hm]
        exact hθ
      have hmem : (minpoly Ω θ).map (algebraMap Ω (AlgebraicClosure Ω)) ∈
          Polynomial.liftsRing (algebraMap (separableClosure K (AlgebraicClosure Ω))
            (AlgebraicClosure Ω)) := by
        rw [hsplit]
        apply Subring.multiset_prod_mem
        intro a ha
        obtain ⟨ρ, hρ, rfl⟩ := Multiset.mem_map.mp ha
        apply Subring.sub_mem
        · rw [← Polynomial.lifts_iff_liftsRing]; exact Polynomial.X_mem_lifts _
        · rw [← Polynomial.lifts_iff_liftsRing]
          have hρs : ρ ∈ separableClosure K (AlgebraicClosure Ω) :=
            mem_separableClosure_iff.mpr (hroot' ρ hρ)
          exact Polynomial.C_mem_lifts _ (⟨ρ, hρs⟩ : separableClosure K (AlgebraicClosure Ω))
      rw [← Polynomial.lifts_iff_liftsRing, Polynomial.lifts_iff_coeff_lifts] at hmem
      obtain ⟨c, hc⟩ := hmem j
      have hcs : IsSeparable K
          (((minpoly Ω θ).map (algebraMap Ω (AlgebraicClosure Ω))).coeff j) := by
        rw [← hc]; exact mem_separableClosure_iff.mp c.2
      rw [Polynomial.coeff_map] at hcs
      exact IsSeparable.of_algHom K (IsScalarTower.toAlgHom K Ω (AlgebraicClosure Ω)) hcs
    have hlifts : minpoly Ω θ ∈ Polynomial.lifts (algebraMap K Ω) := by
      rw [Polynomial.lifts_iff_coeff_lifts]
      intro j; exact hSC _ (hcoeff j)
    obtain ⟨h₀, hmap, hdeg₀, hmon₀⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlifts hmon
    have hdvd₀ : h₀ ∣ minpoly K θ :=
      (Polynomial.map_dvd_map (algebraMap K Ω) (algebraMap K Ω).injective hmon₀).mp
        (by rw [hmap]; exact hdvd)
    obtain ⟨c, hc⟩ := hdvd₀
    rcases hfirr.isUnit_or_isUnit hc with hu | hu
    · exfalso
      have h1 := Polynomial.natDegree_eq_zero_of_isUnit hu
      have h2 := minpoly.natDegree_pos hθΩ
      omega
    · have hfd : minpoly K θ ∣ h₀ :=
        ⟨↑hu.unit⁻¹, by rw [hc, mul_assoc, IsUnit.mul_val_inv, mul_one]⟩
      have := Polynomial.natDegree_le_of_dvd hfd hmon₀.ne_zero
      omega

  obtain ⟨K', hfd, hsepK', ⟨P', rfl⟩, ⟨Q', rfl⟩⟩ : ∃ K' : IntermediateField K L,
      FiniteDimensional K K' ∧ Algebra.IsSeparable K K' ∧
      P ∈ Set.range (MvPolynomial.map (algebraMap K' L)) ∧
      Q ∈ Set.range (MvPolynomial.map (algebraMap K' L)) := by
    set S : Set L := ↑(P.coeffs ∪ Q.coeffs) with hS
    have hSsep : ∀ x ∈ S, IsSeparable K x := by
      intro x hx
      rw [hS, Finset.coe_union, Set.mem_union] at hx
      rcases hx with hx | hx
      · obtain ⟨n, -, rfl⟩ := MvPolynomial.mem_coeffs_iff.mp hx
        exact (hsep n).1
      · obtain ⟨n, -, rfl⟩ := MvPolynomial.mem_coeffs_iff.mp hx
        exact (hsep n).2
    haveI : Finite S := (Finset.finite_toSet _).to_subtype
    refine ⟨IntermediateField.adjoin K S,
      IntermediateField.finiteDimensional_adjoin (fun x hx => (hSsep x hx).isIntegral),
      (IntermediateField.isSeparable_adjoin_iff_isSeparable K L).mpr hSsep, ?_, ?_⟩
    · refine MvPolynomial.mem_range_map_iff_coeffs_subset.mpr fun c hc => ?_
      have hc' : c ∈ IntermediateField.adjoin K S :=
        IntermediateField.subset_adjoin K S (by rw [hS]; simp [hc])
      exact ⟨⟨c, hc'⟩, rfl⟩
    · refine MvPolynomial.mem_range_map_iff_coeffs_subset.mpr fun c hc => ?_
      have hc' : c ∈ IntermediateField.adjoin K S :=
        IntermediateField.subset_adjoin K S (by rw [hS]; simp [hc])
      exact ⟨⟨c, hc'⟩, rfl⟩
  haveI := hfd
  haveI := hsepK'

  have decomp : ∀ (pb : PowerBasis K K') (R : MvPolynomial (Fin 2) K'),
      ∃ Rs : Fin pb.dim → MvPolynomial (Fin 2) K,
        (∀ s, (Rs s).totalDegree ≤ R.totalDegree) ∧
        R = ∑ s : Fin pb.dim,
          MvPolynomial.C (pb.gen ^ (s : ℕ)) * MvPolynomial.map (algebraMap K K') (Rs s) := by
    intro pb R
    refine ⟨fun s => ∑ m ∈ R.support, MvPolynomial.monomial m (pb.basis.repr (R.coeff m) s),
      ?_, ?_⟩
    · intro s
      refine le_trans (MvPolynomial.totalDegree_finsetSum _ _) (Finset.sup_le fun m hm => ?_)
      exact le_trans (MvPolynomial.totalDegree_monomial_le _ _) (MvPolynomial.le_totalDegree hm)
    · conv_lhs => rw [MvPolynomial.as_sum R]
      simp only [map_sum, MvPolynomial.map_monomial, Finset.mul_sum, MvPolynomial.C_mul_monomial]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun m _ => ?_
      rw [← map_sum (MvPolynomial.monomial m)]
      congr 1
      conv_lhs => rw [← pb.basis.sum_repr (R.coeff m)]
      refine Finset.sum_congr rfl fun s _ => ?_
      rw [Algebra.smul_def, pb.basis_eq_pow, mul_comm]
  set lam := G.coeff (Finsupp.single 1 D) with hlam
  have hinjL : Function.Injective (algebraMap K' L) := (algebraMap K' L).injective

  have hfac' : MvPolynomial.map (algebraMap K K') G =
      MvPolynomial.C (algebraMap K K' lam) * P' * Q' := by
    apply MvPolynomial.map_injective _ hinjL
    rw [MvPolynomial.map_map, ← IsScalarTower.algebraMap_eq, hfac]
    simp only [map_mul, MvPolynomial.map_C]
    rw [← IsScalarTower.algebraMap_apply]

  let M := AlgebraicClosure Ω
  let φ : K' →ₐ[K] M := IsAlgClosed.lift
  set x : Fin 2 → M := (algebraMap Ω M) ∘ ![u₀, v₀] with hx
  have heval : ∀ S : MvPolynomial (Fin 2) K,
      MvPolynomial.eval x (MvPolynomial.map (φ : K' →+* M) (MvPolynomial.map (algebraMap K K') S)) =
        algebraMap Ω M (MvPolynomial.aeval ![u₀, v₀] S) := by
    intro S
    rw [MvPolynomial.map_map, AlgHom.comp_algebraMap, MvPolynomial.eval_map,
      ← MvPolynomial.aeval_def, hx, MvPolynomial.aeval_algebraMap_apply]

  have hspec : MvPolynomial.eval x (MvPolynomial.map (φ : K' →+* M) P') = 0 ∨
      MvPolynomial.eval x (MvPolynomial.map (φ : K' →+* M) Q') = 0 := by
    have h1 : MvPolynomial.eval x (MvPolynomial.map (φ : K' →+* M)
        (MvPolynomial.map (algebraMap K K') G)) = MvPolynomial.eval x
          (MvPolynomial.map (φ : K' →+* M) (MvPolynomial.C (algebraMap K K' lam) * P' * Q')) := by
      rw [hfac']
    rw [heval G, hroot, map_zero] at h1
    simp only [map_mul, MvPolynomial.map_C, MvPolynomial.eval_C, AlgHom.coe_toRingHom,
      AlgHom.commutes] at h1
    have hlam0 : algebraMap K M lam ≠ 0 :=
      (map_ne_zero_iff _ (algebraMap K M).injective).mpr hlc
    rcases mul_eq_zero.mp h1.symm with h2 | h2
    · rcases mul_eq_zero.mp h2 with h3 | h3
      · exact absurd h3 hlam0
      · exact Or.inl h3
    · exact Or.inr h2

  have key : ∀ R : MvPolynomial (Fin 2) K', R.totalDegree < D →
      MvPolynomial.eval x (MvPolynomial.map (φ : K' →+* M) R) = 0 → R = 0 := by
    intro R hR hR0
    let pb := Field.powerBasisOfFiniteOfSeparable K K'
    obtain ⟨Rs, hRs, hReq⟩ := decomp pb R
    set θ' : M := φ pb.gen with hθ'
    set ω : Fin pb.dim → Ω := fun s => MvPolynomial.aeval ![u₀, v₀] (Rs s) with hω
    have hsum : ∑ s : Fin pb.dim, θ' ^ (s : ℕ) * algebraMap Ω M (ω s) = 0 := by
      rw [hReq] at hR0
      simpa [map_sum, heval, hθ', hω] using hR0
    set p : Polynomial Ω := ∑ s : Fin pb.dim, Polynomial.C (ω s) * Polynomial.X ^ (s : ℕ) with hp
    have hpdeg : p.degree < pb.dim := Polynomial.degree_sum_fin_lt _
    have hpev : Polynomial.aeval θ' p = 0 := by
      rw [hp, map_sum]
      refine Eq.trans (Finset.sum_congr rfl fun s _ => ?_) hsum
      rw [map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X, mul_comm]
    have hsepθ : IsSeparable K pb.gen := Algebra.IsSeparable.isSeparable K pb.gen
    have hmin : minpoly K θ' = minpoly K pb.gen := minpoly.algHom_eq φ φ.injective pb.gen
    have hsepθ' : IsSeparable K θ' := by
      unfold IsSeparable
      rw [hmin]
      exact hsepθ
    have hdim : (minpoly K θ').natDegree = pb.dim := by
      rw [hmin]; exact pb.natDegree_minpoly
    have hs2 := minpolyDeg θ' hsepθ'
    have hintΩ : IsIntegral Ω θ' := IsIntegral.tower_top hsepθ'.isIntegral
    have hp0 : p = 0 := by
      by_contra hp0
      have h1 := minpoly.degree_le_of_ne_zero Ω θ' hp0 hpev
      have h2 : (minpoly Ω θ').degree < pb.dim := lt_of_le_of_lt h1 hpdeg
      have h3 := (Polynomial.natDegree_lt_iff_degree_lt (minpoly.ne_zero hintΩ)).mpr h2
      omega
    have hω0 : ∀ s, ω s = 0 := by
      intro s
      have h := congrArg (fun q : Polynomial Ω => q.coeff s) hp0
      simp only [hp, Polynomial.finset_sum_coeff, Polynomial.coeff_C_mul_X_pow,
        Polynomial.coeff_zero] at h
      rw [Finset.sum_eq_single s] at h
      · simpa using h
      · intro b _ hb
        rw [if_neg]
        intro h'
        exact hb (Fin.ext h').symm
      · intro h'; exact absurd (Finset.mem_univ s) h'
    have hRs0 : ∀ s, Rs s = 0 := fun s =>
      euclid (Rs s) (lt_of_le_of_lt (hRs s) hR) (hω0 s)
    rw [hReq]
    simp [hRs0]
  have htd : ∀ R : MvPolynomial (Fin 2) K',
      (MvPolynomial.map (algebraMap K' L) R).totalDegree = R.totalDegree := by
    intro R
    simp only [MvPolynomial.totalDegree, MvPolynomial.support_map_of_injective _ hinjL]
  rcases hspec with h | h
  · rw [htd] at hP1
    have hP0 := key P' (by omega) h
    rw [hP0, map_zero, MvPolynomial.coeff_zero] at hP2
    exact zero_ne_one hP2
  · rw [htd] at hQ1
    have hQ0 := key Q' (by omega) h
    rw [hQ0, map_zero, MvPolynomial.coeff_zero] at hQ2
    exact zero_ne_one hQ2

theorem lw_gs_separable_factor_descends (κ : Type u) [Field κ] [IsAlgClosed κ] (d : ℕ)
    (g : MvPolynomial (Fin (d + 1)) κ) (hg : Irreducible g)
    (hK : Irreducible (MvPolynomial.map (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
      (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ))) (lwGenSection κ d g)))
    (L : Type u) [Field L] [Algebra (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) L]
    (k l : ℕ) (hk : 1 ≤ k) (hl : 1 ≤ l) (hkl : k + l = g.totalDegree)
    (P Q : MvPolynomial (Fin 2) L)
    (hP1 : P.totalDegree ≤ k) (hP2 : P.coeff (Finsupp.single 1 k) = 1)
    (hQ1 : Q.totalDegree ≤ l) (hQ2 : Q.coeff (Finsupp.single 1 l) = 1)
    (hfac : MvPolynomial.map
        ((algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) L).comp
          (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
            (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)))) (lwGenSection κ d g) =
      MvPolynomial.C
        (((algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) L).comp
          (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
            (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ))))
          ((lwGenSection κ d g).coeff (Finsupp.single 1 g.totalDegree))) * P * Q)
    (hsep : ∀ m, IsSeparable (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) (P.coeff m) ∧
      IsSeparable (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) (Q.coeff m)) :
    ∀ m, P.coeff m ∈ Set.range
        (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) L) ∧
      Q.coeff m ∈ Set.range
        (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) L) :=
by
  classical
  exfalso
  have hg0 : g ≠ 0 := hg.ne_zero
  have hD1 : 1 ≤ g.totalDegree := by omega
  obtain ⟨Ω, _, _, x, B, C, u, v, hx, hgen, hind, hBC⟩ :=
    lw_shear_independent κ d g hg hD1
  set f : Fin 3 × Fin (d + 1) → Ω :=
    fun q => ![fun i => x i - u * B i - v * C i, B, C] q.1 q.2 with hfdef
  have hf : AlgebraicIndependent κ f := hind.comp some (Option.some_injective _)
  have hinj : Function.Injective
      ((MvPolynomial.aeval f : MvPolynomial (Fin 3 × Fin (d + 1)) κ →ₐ[κ] Ω).toRingHom) :=
    algebraicIndependent_iff_injective_aeval.mp hf
  letI : Algebra (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) Ω :=
    (IsFractionRing.lift hinj).toAlgebra
  have hι : ∀ p : MvPolynomial (Fin 3 × Fin (d + 1)) κ,
      algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) Ω
        (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
          (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) p) =
      MvPolynomial.aeval f p := fun p => IsFractionRing.lift_algebraMap hinj p
  have hcomp : (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) Ω).comp
      (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
        (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ))) =
      (MvPolynomial.aeval f : MvPolynomial (Fin 3 × Fin (d + 1)) κ →ₐ[κ] Ω).toRingHom :=
    RingHom.ext hι
  have hSC := lw_plane_section_sc κ d Ω x B C u v hι hgen hind hBC

  have htr0 : Transcendental (Algebra.adjoin κ (Set.range f)) u :=
    (AlgebraicIndependent.option_iff.mp hind).2
  have htr : Transcendental (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) u := by
    intro halg
    letI : Algebra (MvPolynomial (Fin 3 × Fin (d + 1)) κ) Ω :=
      (MvPolynomial.aeval f : MvPolynomial (Fin 3 × Fin (d + 1)) κ →ₐ[κ] Ω).toRingHom.toAlgebra
    haveI : IsScalarTower (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
        (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) Ω :=
      IsScalarTower.of_algebraMap_eq (fun r => (hι r).symm)
    have hR : IsAlgebraic (MvPolynomial (Fin 3 × Fin (d + 1)) κ) u :=
      (IsFractionRing.isAlgebraic_iff (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
        (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) Ω).mpr halg
    let φ : MvPolynomial (Fin 3 × Fin (d + 1)) κ →ₐ[κ] Algebra.adjoin κ (Set.range f) :=
      (MvPolynomial.aeval f).codRestrict (Algebra.adjoin κ (Set.range f)) (fun p => by
        rw [Algebra.adjoin_range_eq_range_aeval]
        exact ⟨p, rfl⟩)
    have hφinj : Function.Injective (φ : MvPolynomial (Fin 3 × Fin (d + 1)) κ →+*
        Algebra.adjoin κ (Set.range f)) := by
      intro a b hab
      apply hinj
      have := congrArg Subtype.val hab
      exact this
    have h2 := IsAlgebraic.ringHom_of_comp_eq
      (φ : MvPolynomial (Fin 3 × Fin (d + 1)) κ →+* Algebra.adjoin κ (Set.range f))
      (RingHom.id Ω) hR hφinj (by
        ext p
        · rfl
        · rfl)
    exact htr0 h2

  have hroot : MvPolynomial.aeval ![u, v]
      (MvPolynomial.map (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
        (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ))) (lwGenSection κ d g)) = 0 := by
    rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_map, hcomp]
    have hext : (MvPolynomial.eval₂Hom
        ((MvPolynomial.aeval f : MvPolynomial (Fin 3 × Fin (d + 1)) κ →ₐ[κ] Ω).toRingHom)
          ![u, v]).comp
        (MvPolynomial.aeval (fun i : Fin (d + 1) =>
          (MvPolynomial.C (MvPolynomial.X ((0 : Fin 3), i)) +
            MvPolynomial.X 0 * MvPolynomial.C (MvPolynomial.X ((1 : Fin 3), i)) +
            MvPolynomial.X 1 * MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), i)) :
              MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) κ)))).toRingHom =
        (MvPolynomial.aeval x : MvPolynomial (Fin (d + 1)) κ →ₐ[κ] Ω).toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro c
        simp [MvPolynomial.algebraMap_eq]
      · intro i
        simp [hfdef]
        ring
    have h := RingHom.congr_fun hext g
    simp only [RingHom.comp_apply, MvPolynomial.coe_eval₂Hom, AlgHom.toRingHom_eq_coe,
      AlgHom.coe_toRingHom] at h
    rw [lwGenSection]
    exact h.trans hx
  have hφinj : Function.Injective
      ((algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) L).comp
        (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
          (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)))) :=
    (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) L).injective.comp
      (IsFractionRing.injective _ _)
  have hdeg0 : (lwGenSection κ d g).totalDegree ≤ g.totalDegree := by
    have h1 : (MvPolynomial.map
        ((algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) L).comp
          (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
            (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)))) (lwGenSection κ d g)).totalDegree
        = (lwGenSection κ d g).totalDegree := by
      simp only [MvPolynomial.totalDegree, MvPolynomial.support_map_of_injective _ hφinj]
    rw [← h1, hfac]
    calc _ ≤ (MvPolynomial.C _ * P).totalDegree + Q.totalDegree := MvPolynomial.totalDegree_mul _ _
      _ ≤ ((MvPolynomial.C _ : MvPolynomial (Fin 2) L).totalDegree + P.totalDegree) +
          Q.totalDegree := by
        gcongr
        exact MvPolynomial.totalDegree_mul _ _
      _ ≤ (0 + k) + l := by
        rw [MvPolynomial.totalDegree_C]
        omega
      _ = g.totalDegree := by omega
  have hdeg : (MvPolynomial.map (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
      (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ))) (lwGenSection κ d g)).totalDegree ≤
      g.totalDegree :=
    le_trans (Finset.sup_mono (MvPolynomial.support_map_subset _ _)) hdeg0
  have hlc : (MvPolynomial.map (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
      (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ))) (lwGenSection κ d g)).coeff
        (Finsupp.single 1 g.totalDegree) ≠ 0 := by
    rw [MvPolynomial.coeff_map]
    intro h0
    apply hK.ne_zero
    have h2 : MvPolynomial.map
        ((algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) L).comp
          (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
            (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)))) (lwGenSection κ d g) = 0 := by
      rw [hfac, RingHom.comp_apply, h0, map_zero, MvPolynomial.C_0, zero_mul, zero_mul]
    have h3 : lwGenSection κ d g = 0 :=
      MvPolynomial.map_injective _ hφinj (h2.trans (map_zero _).symm)
    rw [h3, map_zero]
  have hfac' : MvPolynomial.map
      (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) L)
      (MvPolynomial.map (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
        (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ))) (lwGenSection κ d g)) =
      MvPolynomial.C (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) L
        ((MvPolynomial.map (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) κ)
          (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ))) (lwGenSection κ d g)).coeff
            (Finsupp.single 1 g.totalDegree))) * P * Q := by
    rw [MvPolynomial.map_map, MvPolynomial.coeff_map]
    exact hfac
  exact lw_sc_descent_no_factor (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) κ)) Ω L hSC
    _ hK g.totalDegree hdeg hlc u v hroot htr k l hk hl hkl P Q hP1 hP2 hQ1 hQ2 hfac' hsep

theorem lw_pb_generic_section_abs_irreducible (F : Type u) [Field F] (d : ℕ)
    (f : MvPolynomial (Fin (d + 1)) F)
    (hf : Irreducible (MvPolynomial.map (algebraMap F (AlgebraicClosure F)) f)) :
    Irreducible (MvPolynomial.map (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) F)
      (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))))
      (lwGenSection F d f)) :=
by
  classical


  have hs2 : ∃ j : MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F) →+*
        AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F)),
      Function.Injective j ∧
      j.comp (MvPolynomial.map (algebraMap F (AlgebraicClosure F))) =
        algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) F)
          (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))) := by
    let ι : AlgebraicClosure F →ₐ[F]
        AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F)) := IsAlgClosed.lift
    letI : Algebra (AlgebraicClosure F)
        (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))) :=
      ι.toRingHom.toAlgebra
    haveI : IsScalarTower F (AlgebraicClosure F)
        (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))) :=
      IsScalarTower.of_algebraMap_eq (fun r => (ι.commutes r).symm)
    have hinj : Function.Injective (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) F)
        (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F)))) := by
      rw [IsScalarTower.algebraMap_eq (MvPolynomial (Fin 3 × Fin (d + 1)) F)
        (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))
        (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F)))]
      rw [RingHom.coe_comp]
      exact (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))
        (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F)))).injective.comp
        (IsFractionRing.injective
          (MvPolynomial (Fin 3 × Fin (d + 1)) F)
          (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F)))
    let x : Fin 3 × Fin (d + 1) →
        AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F)) :=
      fun p => algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) F)
        (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))) (MvPolynomial.X p)
    have hxF : AlgebraicIndependent F x := by
      rw [algebraicIndependent_iff_injective_aeval]
      have h : (MvPolynomial.aeval x : MvPolynomial (Fin 3 × Fin (d + 1)) F →ₐ[F] _) =
          IsScalarTower.toAlgHom F (MvPolynomial (Fin 3 × Fin (d + 1)) F)
            (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))) := by
        apply MvPolynomial.algHom_ext
        intro p
        simp [x]
      rw [h]
      exact hinj
    have hxκ : AlgebraicIndependent (AlgebraicClosure F) x :=
      (Algebra.IsAlgebraic.algebraicIndependent_iff F (AlgebraicClosure F)).mp hxF
    refine ⟨(MvPolynomial.aeval x : MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F)
        →ₐ[AlgebraicClosure F] _).toRingHom,
      algebraicIndependent_iff_injective_aeval.mp hxκ, ?_⟩
    apply MvPolynomial.ringHom_ext
    · intro r
      rw [RingHom.comp_apply, MvPolynomial.map_C]
      change (MvPolynomial.aeval x) (MvPolynomial.C _) = _
      rw [MvPolynomial.aeval_C]
      change ι (algebraMap F _ r) = _
      rw [ι.commutes, ← MvPolynomial.algebraMap_eq]
      exact IsScalarTower.algebraMap_apply F (MvPolynomial (Fin 3 × Fin (d + 1)) F) _ r
    · intro p
      simp [x]
  obtain ⟨j, hj, hjc⟩ := hs2
  set fκ := MvPolynomial.map (algebraMap F (AlgebraicClosure F)) f with hfκ

  have hf0 : fκ ≠ 0 := hf.ne_zero
  have hD1 : 1 ≤ fκ.totalDegree := by
    by_contra h
    have h0 : fκ.totalDegree = 0 := by omega
    rw [MvPolynomial.totalDegree_eq_zero_iff_eq_C] at h0
    have hf' := hf
    rw [h0] at hf'
    by_cases hc : fκ.coeff 0 = 0
    · rw [hc, map_zero] at hf'
      exact not_irreducible_zero hf'
    · exact hf'.not_isUnit ((Ne.isUnit hc).map MvPolynomial.C)
  obtain ⟨hGdeg, hlc⟩ := lw_pb_generic_section_leading_coeff (AlgebraicClosure F) d fκ hf0

  have hs6 : MvPolynomial.map (MvPolynomial.map (algebraMap F (AlgebraicClosure F)))
      (lwGenSection F d f) = lwGenSection (AlgebraicClosure F) d fκ := by
    have h : (MvPolynomial.map (MvPolynomial.map (algebraMap F (AlgebraicClosure F)))).comp
        (MvPolynomial.aeval (fun i : Fin (d + 1) =>
          (MvPolynomial.C (MvPolynomial.X ((0 : Fin 3), i)) +
            MvPolynomial.X 0 * MvPolynomial.C (MvPolynomial.X ((1 : Fin 3), i)) +
            MvPolynomial.X 1 * MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), i)) :
              MvPolynomial (Fin 2) (MvPolynomial (Fin 3 × Fin (d + 1)) F)))).toRingHom =
        (MvPolynomial.aeval (fun i : Fin (d + 1) =>
          (MvPolynomial.C (MvPolynomial.X ((0 : Fin 3), i)) +
            MvPolynomial.X 0 * MvPolynomial.C (MvPolynomial.X ((1 : Fin 3), i)) +
            MvPolynomial.X 1 * MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), i)) :
              MvPolynomial (Fin 2)
                (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F))))).toRingHom.comp
          (MvPolynomial.map (algebraMap F (AlgebraicClosure F))) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        simp [MvPolynomial.algebraMap_apply, MvPolynomial.algebraMap_eq]
      · intro i
        simp
    exact RingHom.congr_fun h f
  have htarget : MvPolynomial.map (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) F)
      (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))))
      (lwGenSection F d f) = MvPolynomial.map j (lwGenSection (AlgebraicClosure F) d fκ) := by
    rw [← hs6, MvPolynomial.map_map, hjc]

  set φ := IsFractionRing.lift
    (K := FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F))) hj with hφdef
  have hφ : φ.comp (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F))
      (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F)))) = j :=
    IsLocalization.lift_comp _
  letI : Algebra (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F)))
      (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))) := φ.toAlgebra
  have h1 : algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F)))
      (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))) = φ := rfl
  have hφinj : Function.Injective
      (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F)))
        (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F)))) := by
    rw [h1]
    exact RingHom.injective φ
  have hιinj : Function.Injective
      (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F))
        (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F)))) :=
    IsFractionRing.injective _ _
  rw [htarget, ← hφ, ← h1]
  have hdeg : (MvPolynomial.map
      ((algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F)))
        (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F)))).comp
        (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F))
          (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F)))))
      (lwGenSection (AlgebraicClosure F) d fκ)).totalDegree ≤ fκ.totalDegree := by
    refine le_trans ?_ hGdeg
    exact Finset.sup_mono (MvPolynomial.support_map_subset _ _)
  have hlc' : (MvPolynomial.map
      ((algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F)))
        (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F)))).comp
        (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F))
          (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F)))))
      (lwGenSection (AlgebraicClosure F) d fκ)).coeff (Finsupp.single 1 fκ.totalDegree) ≠ 0 := by
    rw [MvPolynomial.coeff_map, RingHom.comp_apply]
    exact (map_ne_zero_iff _ hφinj).mpr ((map_ne_zero_iff _ hιinj).mpr hlc)

  have hK := lw_gs_irreducible_over_fraction_field (AlgebraicClosure F) d fκ hf
  have hdegK : (MvPolynomial.map
      (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F))
        (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F))))
      (lwGenSection (AlgebraicClosure F) d fκ)).totalDegree ≤ fκ.totalDegree := by
    refine le_trans ?_ hGdeg
    exact Finset.sup_mono (MvPolynomial.support_map_subset _ _)
  have hlcK : (MvPolynomial.map
      (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F))
        (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F))))
      (lwGenSection (AlgebraicClosure F) d fκ)).coeff (Finsupp.single 1 fκ.totalDegree) ≠ 0 := by
    rw [MvPolynomial.coeff_map]
    exact (map_ne_zero_iff _ hιinj).mpr hlc
  have hKno := (lw_pb_bivariate_irreducible_iff _ _ fκ.totalDegree hD1 hdegK hlcK).mp hK

  rw [lw_pb_bivariate_irreducible_iff _ _ fκ.totalDegree hD1 hdeg hlc']
  intro k l hk hl hkl ⟨P, Q, hP1, hP2, hQ1, hQ2, hfac⟩
  rw [MvPolynomial.coeff_map] at hfac
  have hsep := lw_gs_factor_coeffs_separable (AlgebraicClosure F) d fκ hf hK _ k l hk hl hkl
    P Q hP1 hP2 hQ1 hQ2 hfac
  have hdesc := lw_gs_separable_factor_descends (AlgebraicClosure F) d fκ hf hK _ k l hk hl hkl
    P Q hP1 hP2 hQ1 hQ2 hfac hsep
  obtain ⟨P₀, rfl⟩ : P ∈ Set.range (MvPolynomial.map
      (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F)))
        (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))))) := by
    refine MvPolynomial.mem_range_map_iff_coeffs_subset.mpr fun c hc => ?_
    obtain ⟨n, -, rfl⟩ := MvPolynomial.mem_coeffs_iff.mp hc
    exact (hdesc n).1
  obtain ⟨Q₀, rfl⟩ : Q ∈ Set.range (MvPolynomial.map
      (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F)))
        (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))))) := by
    refine MvPolynomial.mem_range_map_iff_coeffs_subset.mpr fun c hc => ?_
    obtain ⟨n, -, rfl⟩ := MvPolynomial.mem_coeffs_iff.mp hc
    exact (hdesc n).2
  have htdP : (MvPolynomial.map
      (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F)))
        (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F)))) P₀).totalDegree =
      P₀.totalDegree := by
    simp only [MvPolynomial.totalDegree, MvPolynomial.support_map_of_injective _ hφinj]
  have htdQ : (MvPolynomial.map
      (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F)))
        (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F)))) Q₀).totalDegree =
      Q₀.totalDegree := by
    simp only [MvPolynomial.totalDegree, MvPolynomial.support_map_of_injective _ hφinj]
  rw [htdP] at hP1
  rw [htdQ] at hQ1
  rw [MvPolynomial.coeff_map] at hP2 hQ2
  have hP2' : P₀.coeff (Finsupp.single 1 k) = 1 := hφinj (by rw [hP2, map_one])
  have hQ2' : Q₀.coeff (Finsupp.single 1 l) = 1 := hφinj (by rw [hQ2, map_one])
  have hfac2 : MvPolynomial.map
      (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F)))
        (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))))
      (MvPolynomial.map
        (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F))
          (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F))))
        (lwGenSection (AlgebraicClosure F) d fκ)) =
      MvPolynomial.map
      (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F)))
        (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))))
      (MvPolynomial.C ((algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F))
          (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) (AlgebraicClosure F))))
          ((lwGenSection (AlgebraicClosure F) d fκ).coeff (Finsupp.single 1 fκ.totalDegree)))
        * P₀ * Q₀) := by
    rw [MvPolynomial.map_map, hfac]
    simp only [map_mul, MvPolynomial.map_C, RingHom.comp_apply]
  have hfac' := MvPolynomial.map_injective _ hφinj hfac2
  apply hKno k l hk hl hkl
  refine ⟨P₀, Q₀, hP1, hP2', hQ1, hQ2', ?_⟩
  rw [MvPolynomial.coeff_map]
  exact hfac'

theorem lw_pb_nullstellensatz_descent (R : Type u) [CommRing R] [IsDomain R] (N : ℕ)
    (S : Finset (MvPolynomial (Fin N) R))
    (hS : ∀ z : Fin N → AlgebraicClosure (FractionRing R), ∃ s ∈ S,
      MvPolynomial.eval₂ (algebraMap R (AlgebraicClosure (FractionRing R))) z s ≠ 0) :
    ∃ r : R, r ≠ 0 ∧ ∀ (M : Type u) [Field M] (ψ : R →+* M), ψ r ≠ 0 →
      ∀ z : Fin N → M, ∃ s ∈ S, MvPolynomial.eval₂ ψ z s ≠ 0 :=
by
  classical

  have h1 : Ideal.span ((MvPolynomial.map (algebraMap R (FractionRing R))) ''
      (S : Set (MvPolynomial (Fin N) R))) = ⊤ := by
    have hz : MvPolynomial.zeroLocus (AlgebraicClosure (FractionRing R))
        (Ideal.span ((MvPolynomial.map (algebraMap R (FractionRing R))) ''
          (S : Set (MvPolynomial (Fin N) R)))) = ∅ := by
      apply Set.eq_empty_of_forall_notMem
      intro z hz
      rw [MvPolynomial.mem_zeroLocus_iff] at hz
      obtain ⟨s, hs, hne⟩ := hS z
      apply hne
      have h := hz (MvPolynomial.map (algebraMap R (FractionRing R)) s)
        (Ideal.subset_span ⟨s, hs, rfl⟩)
      rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_map,
        ← IsScalarTower.algebraMap_eq] at h
      exact h
    have h := MvPolynomial.vanishingIdeal_zeroLocus_eq_radical
      (K := AlgebraicClosure (FractionRing R))
      (Ideal.span ((MvPolynomial.map (algebraMap R (FractionRing R))) ''
          (S : Set (MvPolynomial (Fin N) R))))
    rw [hz, MvPolynomial.vanishingIdeal_empty] at h
    exact Ideal.radical_eq_top.mp h.symm

  have h2 : ∃ r : R, r ≠ 0 ∧ MvPolynomial.C r ∈ Ideal.span (S : Set (MvPolynomial (Fin N) R)) := by
    letI : Algebra (MvPolynomial (Fin N) R) (MvPolynomial (Fin N) (FractionRing R)) :=
      MvPolynomial.algebraMvPolynomial
    haveI := MvPolynomial.isLocalization (σ := Fin N) (nonZeroDivisors R) (FractionRing R)
    have hmem : (1 : MvPolynomial (Fin N) (FractionRing R)) ∈
        Ideal.map (algebraMap (MvPolynomial (Fin N) R) (MvPolynomial (Fin N) (FractionRing R)))
          (Ideal.span (S : Set (MvPolynomial (Fin N) R))) := by
      rw [Ideal.map_span]
      show (1 : MvPolynomial (Fin N) (FractionRing R)) ∈
        Ideal.span ((MvPolynomial.map (algebraMap R (FractionRing R))) ''
          (S : Set (MvPolynomial (Fin N) R)))
      rw [h1]
      exact Submodule.mem_top
    obtain ⟨⟨⟨q, hq⟩, ⟨c', hc'⟩⟩, hx⟩ :=
      (IsLocalization.mem_map_algebraMap_iff
        (Submonoid.map (MvPolynomial.C : R →+* MvPolynomial (Fin N) R) (nonZeroDivisors R))
        (MvPolynomial (Fin N) (FractionRing R))).mp hmem
    obtain ⟨c, hc, rfl⟩ := Submonoid.mem_map.mp hc'
    refine ⟨c, nonZeroDivisors.ne_zero hc, ?_⟩
    rw [one_mul] at hx
    have hinj : Function.Injective
        (MvPolynomial.map (σ := Fin N) (algebraMap R (FractionRing R))) :=
      MvPolynomial.map_injective _ (IsFractionRing.injective R (FractionRing R))
    have : (MvPolynomial.C c : MvPolynomial (Fin N) R) = q := hinj hx
    rw [this]
    exact hq

  obtain ⟨r, hr0, hr⟩ := h2
  refine ⟨r, hr0, ?_⟩
  intro M _ ψ hψ z
  by_contra hcon
  push_neg at hcon
  apply hψ
  have hle : Ideal.span (S : Set (MvPolynomial (Fin N) R)) ≤
      RingHom.ker (MvPolynomial.eval₂Hom ψ z) := by
    rw [Ideal.span_le]
    intro s hs
    rw [SetLike.mem_coe, RingHom.mem_ker, MvPolynomial.coe_eval₂Hom]
    exact hcon s hs
  have h := hle hr
  rw [RingHom.mem_ker, MvPolynomial.eval₂Hom_C] at h
  exact h

theorem lw_pb_factorization_system (R : Type u) [CommRing R] (G : MvPolynomial (Fin 2) R)
    (D k l : ℕ) (hkl : k + l = D) (hG : G.totalDegree ≤ D) :
    ∃ (N : ℕ) (S : Finset (MvPolynomial (Fin N) R)), ∀ (M : Type u) [Field M] (ψ : R →+* M),
      (∃ z : Fin N → M, ∀ s ∈ S, MvPolynomial.eval₂ ψ z s = 0) ↔
      ∃ P Q : MvPolynomial (Fin 2) M, P.totalDegree ≤ k ∧ P.coeff (Finsupp.single 1 k) = 1 ∧
        Q.totalDegree ≤ l ∧ Q.coeff (Finsupp.single 1 l) = 1 ∧
        MvPolynomial.map ψ G = MvPolynomial.C (ψ (G.coeff (Finsupp.single 1 D))) * P * Q :=
by
  classical
  let T : ℕ → Finset (Fin 2 →₀ ℕ) := fun n =>
    (Finset.Iic (Finsupp.single 0 n + Finsupp.single 1 n)).filter
      (fun m => (m.sum fun _ e => e) ≤ n)
  have hdeg2 : ∀ m : Fin 2 →₀ ℕ, (m.sum fun _ e => e) = m 0 + m 1 := by
    intro m
    rw [Finsupp.sum_fintype _ _ (fun _ => rfl), Fin.sum_univ_two]
  have hT : ∀ n m, m ∈ T n ↔ (m.sum fun _ e => e) ≤ n := by
    intro n m
    simp only [T, Finset.mem_filter, Finset.mem_Iic, and_iff_right_iff_imp]
    intro h
    rw [hdeg2] at h
    rw [Finsupp.le_def]
    intro i
    fin_cases i <;> simp <;> omega
  have hv : ∀ n, Finsupp.single (1 : Fin 2) n ∈ T n := by
    intro n
    rw [hT, hdeg2]
    simp
  have boxA : ∀ (M : Type u) [CommRing M] (n : ℕ) (c : T n → M),
      (∑ m : T n, MvPolynomial.monomial (m : Fin 2 →₀ ℕ) (c m)).totalDegree ≤ n ∧
      (∑ m : T n, MvPolynomial.monomial (m : Fin 2 →₀ ℕ) (c m)).coeff
        (Finsupp.single 1 n) = c ⟨_, hv n⟩ := by
    intro M _ n c
    constructor
    · refine le_trans (MvPolynomial.totalDegree_finset_sum _ _) (Finset.sup_le fun m _ => ?_)
      refine le_trans (MvPolynomial.totalDegree_monomial_le _ _) ?_
      exact (hT n m).1 m.2
    · rw [MvPolynomial.coeff_sum, Finset.sum_eq_single (⟨_, hv n⟩ : T n)]
      · rw [MvPolynomial.coeff_monomial, if_pos rfl]
      · intro b _ hb
        rw [MvPolynomial.coeff_monomial, if_neg]
        intro h
        exact hb (Subtype.ext h)
      · intro h
        exact absurd (Finset.mem_univ _) h
  have boxB : ∀ (M : Type u) [CommRing M] (n : ℕ) (P : MvPolynomial (Fin 2) M),
      P.totalDegree ≤ n →
      ∑ m : T n, MvPolynomial.monomial (m : Fin 2 →₀ ℕ) (P.coeff m) = P := by
    intro M _ n P hP
    rw [Finset.sum_coe_sort (T n) (fun m => MvPolynomial.monomial m (P.coeff m))]
    conv_rhs => rw [P.as_sum]
    symm
    apply Finset.sum_subset
    · intro m hm
      rw [hT]
      exact le_trans (MvPolynomial.le_totalDegree hm) hP
    · intro m _ hm
      rw [MvPolynomial.notMem_support_iff.mp hm, map_zero]
  let Pt : MvPolynomial (Fin 2) (MvPolynomial (T k ⊕ T l) R) :=
    ∑ m : T k, MvPolynomial.monomial (m : Fin 2 →₀ ℕ) (MvPolynomial.X (Sum.inl m))
  let Qt : MvPolynomial (Fin 2) (MvPolynomial (T k ⊕ T l) R) :=
    ∑ m : T l, MvPolynomial.monomial (m : Fin 2 →₀ ℕ) (MvPolynomial.X (Sum.inr m))
  let H : MvPolynomial (Fin 2) (MvPolynomial (T k ⊕ T l) R) :=
    MvPolynomial.map MvPolynomial.C G -
      MvPolynomial.C (MvPolynomial.C (G.coeff (Finsupp.single 1 D))) * Pt * Qt
  let Sι : Finset (MvPolynomial (T k ⊕ T l) R) :=
    insert (MvPolynomial.X (Sum.inl ⟨_, hv k⟩) - 1)
      (insert (MvPolynomial.X (Sum.inr ⟨_, hv l⟩) - 1) (H.support.image fun m => H.coeff m))
  have hspec : ∀ (M : Type u) [Field M] (ψ : R →+* M) (w : T k ⊕ T l → M),
      MvPolynomial.map (MvPolynomial.eval₂Hom ψ w) H =
        MvPolynomial.map ψ G - MvPolynomial.C (ψ (G.coeff (Finsupp.single 1 D))) *
          (∑ m : T k, MvPolynomial.monomial (m : Fin 2 →₀ ℕ) (w (Sum.inl m))) *
          (∑ m : T l, MvPolynomial.monomial (m : Fin 2 →₀ ℕ) (w (Sum.inr m))) := by
    intro M _ ψ w
    simp only [H, Pt, Qt, map_sub, map_mul, map_sum, MvPolynomial.map_map,
      MvPolynomial.eval₂Hom_comp_C, MvPolynomial.map_C, MvPolynomial.map_monomial,
      MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C]
  have hzero : ∀ (M : Type u) [Field M] (ψ : R →+* M) (w : T k ⊕ T l → M),
      (∀ s ∈ Sι, MvPolynomial.eval₂ ψ w s = 0) ↔
        (w (Sum.inl ⟨_, hv k⟩) = 1 ∧ w (Sum.inr ⟨_, hv l⟩) = 1 ∧
          MvPolynomial.map (MvPolynomial.eval₂Hom ψ w) H = 0) := by
    intro M _ ψ w
    simp only [Sι, Finset.forall_mem_insert, Finset.forall_mem_image, MvPolynomial.eval₂_sub,
      MvPolynomial.eval₂_X, MvPolynomial.eval₂_one, sub_eq_zero]
    apply and_congr Iff.rfl
    apply and_congr Iff.rfl
    constructor
    · intro h
      ext m
      rw [MvPolynomial.coeff_map, MvPolynomial.coeff_zero]
      by_cases hm : m ∈ H.support
      · exact h hm
      · rw [MvPolynomial.notMem_support_iff.mp hm, map_zero]
        simp
    · intro h m _
      have : (MvPolynomial.map (MvPolynomial.eval₂Hom ψ w) H).coeff m =
          (0 : MvPolynomial (Fin 2) M).coeff m := by rw [h]
      rw [MvPolynomial.coeff_map, MvPolynomial.coeff_zero] at this
      exact this
  have hmain : ∀ (M : Type u) [Field M] (ψ : R →+* M),
      (∃ w : T k ⊕ T l → M, ∀ s ∈ Sι, MvPolynomial.eval₂ ψ w s = 0) ↔
      ∃ P Q : MvPolynomial (Fin 2) M, P.totalDegree ≤ k ∧ P.coeff (Finsupp.single 1 k) = 1 ∧
        Q.totalDegree ≤ l ∧ Q.coeff (Finsupp.single 1 l) = 1 ∧
        MvPolynomial.map ψ G = MvPolynomial.C (ψ (G.coeff (Finsupp.single 1 D))) * P * Q := by
    intro M _ ψ
    constructor
    · rintro ⟨w, hw⟩
      obtain ⟨h1, h2, h3⟩ := (hzero M ψ w).1 hw
      rw [hspec, sub_eq_zero] at h3
      obtain ⟨hPd, hPc⟩ := boxA M k (fun m => w (Sum.inl m))
      obtain ⟨hQd, hQc⟩ := boxA M l (fun m => w (Sum.inr m))
      exact ⟨_, _, hPd, hPc.trans h1, hQd, hQc.trans h2, h3⟩
    · rintro ⟨P, Q, hPd, hPc, hQd, hQc, hfac⟩
      refine ⟨Sum.elim (fun m => P.coeff m) (fun m => Q.coeff m),
        (hzero M ψ _).2 ⟨hPc, hQc, ?_⟩⟩
      rw [hspec, sub_eq_zero]
      simp only [Sum.elim_inl, Sum.elim_inr]
      rw [boxB M k P hPd, boxB M l Q hQd]
      exact hfac
  let ε := Fintype.equivFin (T k ⊕ T l)
  refine ⟨Fintype.card (T k ⊕ T l), Sι.image (MvPolynomial.rename ε), fun M _ ψ => ?_⟩
  rw [← hmain M ψ]
  simp only [Finset.forall_mem_image, MvPolynomial.eval₂_rename]
  constructor
  · rintro ⟨z, hz⟩
    exact ⟨z ∘ ε, hz⟩
  · rintro ⟨w, hw⟩
    refine ⟨w ∘ ε.symm, ?_⟩
    have hc : (w ∘ ε.symm) ∘ ε = w := by
      funext x
      simp
    rw [hc]
    exact hw

theorem lw_plane_bertini (F : Type u) [Field F] [Finite F] (d : ℕ)
    (f : MvPolynomial (Fin (d + 1)) F)
    (hf : Irreducible (MvPolynomial.map (algebraMap F (AlgebraicClosure F)) f)) :
    ∃ Φ : MvPolynomial (Fin 3 × Fin (d + 1)) F, Φ ≠ 0 ∧
      ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E] (a b c : Fin (d + 1) → E),
        MvPolynomial.aeval (fun p : Fin 3 × Fin (d + 1) => (![a, b, c] p.1) p.2) Φ ≠ 0 →
        Irreducible (MvPolynomial.map (algebraMap E (AlgebraicClosure E))
          (MvPolynomial.aeval (fun i : Fin (d + 1) =>
              MvPolynomial.C (a i) + MvPolynomial.X 0 * MvPolynomial.C (b i) +
                MvPolynomial.X 1 * MvPolynomial.C (c i)) f :
            MvPolynomial (Fin 2) E)) :=
by
  classical

  have hf0 : f ≠ 0 := by
    rintro rfl
    rw [map_zero] at hf
    exact not_irreducible_zero hf

  have hD1 : 1 ≤ f.totalDegree := by
    by_contra h
    have h0 : f.totalDegree = 0 := by omega
    rw [MvPolynomial.totalDegree_eq_zero_iff_eq_C] at h0
    rw [h0, MvPolynomial.map_C] at hf
    by_cases hc : (algebraMap F (AlgebraicClosure F)) (f.coeff 0) = 0
    · rw [hc, map_zero] at hf
      exact not_irreducible_zero hf
    · exact hf.not_isUnit ((Ne.isUnit hc).map MvPolynomial.C)

  obtain ⟨hGdeg, hlc⟩ := lw_pb_generic_section_leading_coeff F d f hf0

  have hinj : Function.Injective (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) F)
      (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F)))) := by
    rw [IsScalarTower.algebraMap_eq (MvPolynomial (Fin 3 × Fin (d + 1)) F)
      (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))
      (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F)))]
    rw [RingHom.coe_comp]
    exact (algebraMap (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))
      (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F)))).injective.comp
      (IsFractionRing.injective
        (MvPolynomial (Fin 3 × Fin (d + 1)) F) (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F)))

  have hirr := lw_pb_generic_section_abs_irreducible F d f hf

  have hr : ∀ k : ℕ, ∃ r : MvPolynomial (Fin 3 × Fin (d + 1)) F, r ≠ 0 ∧
      (1 ≤ k → k + 1 ≤ f.totalDegree → ∀ (M : Type u) [Field M]
        (ψ : MvPolynomial (Fin 3 × Fin (d + 1)) F →+* M), ψ r ≠ 0 →
        ¬ ∃ P Q : MvPolynomial (Fin 2) M, P.totalDegree ≤ k ∧
          P.coeff (Finsupp.single 1 k) = 1 ∧
          Q.totalDegree ≤ f.totalDegree - k ∧
          Q.coeff (Finsupp.single 1 (f.totalDegree - k)) = 1 ∧
          MvPolynomial.map ψ (lwGenSection F d f) =
            MvPolynomial.C (ψ ((lwGenSection F d f).coeff (Finsupp.single 1 f.totalDegree))) *
              P * Q) := by
    intro k
    by_cases hk : 1 ≤ k ∧ k + 1 ≤ f.totalDegree
    · obtain ⟨N, S, hS⟩ := lw_pb_factorization_system (MvPolynomial (Fin 3 × Fin (d + 1)) F)
        (lwGenSection F d f) f.totalDegree k (f.totalDegree - k) (by omega) hGdeg
      have hdeg' : (MvPolynomial.map (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) F)
          (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))))
          (lwGenSection F d f)).totalDegree ≤ f.totalDegree := by
        refine le_trans ?_ hGdeg
        exact Finset.sup_mono (MvPolynomial.support_map_subset _ _)
      have hlc' : (MvPolynomial.map (algebraMap (MvPolynomial (Fin 3 × Fin (d + 1)) F)
          (AlgebraicClosure (FractionRing (MvPolynomial (Fin 3 × Fin (d + 1)) F))))
          (lwGenSection F d f)).coeff (Finsupp.single 1 f.totalDegree) ≠ 0 := by
        rw [MvPolynomial.coeff_map]
        exact (map_ne_zero_iff _ hinj).mpr hlc
      obtain ⟨r, hr0, hrS⟩ := lw_pb_nullstellensatz_descent
        (MvPolynomial (Fin 3 × Fin (d + 1)) F) N S (by
          intro z
          by_contra hcon
          push_neg at hcon
          obtain ⟨P, Q, hP1, hP2, hQ1, hQ2, hfac⟩ := (hS _ _).mp ⟨z, hcon⟩
          have h4 := (lw_pb_bivariate_irreducible_iff _ _ f.totalDegree hD1 hdeg' hlc').mp hirr
            k (f.totalDegree - k) hk.1 (by omega) (by omega)
          exact h4 ⟨P, Q, hP1, hP2, hQ1, hQ2, by rw [MvPolynomial.coeff_map]; exact hfac⟩)
      refine ⟨r, hr0, fun _ _ M _ ψ hψ hPQ => ?_⟩
      obtain ⟨z, hz⟩ := (hS M ψ).mpr hPQ
      obtain ⟨s, hs, hne⟩ := hrS M ψ hψ z
      exact hne (hz s hs)
    · exact ⟨1, one_ne_zero, fun h1 h2 => absurd ⟨h1, h2⟩ hk⟩
  choose r hr0 hrP using hr

  refine ⟨(lwGenSection F d f).coeff (Finsupp.single 1 f.totalDegree) *
    ∏ k ∈ Finset.Icc 1 (f.totalDegree - 1), r k, ?_, ?_⟩
  · exact mul_ne_zero hlc (Finset.prod_ne_zero_iff.mpr fun k _ => hr0 k)
  · intro E _ _ _ a b c hΦ
    set φ : MvPolynomial (Fin 3 × Fin (d + 1)) F →ₐ[F] E :=
      MvPolynomial.aeval (fun p : Fin 3 × Fin (d + 1) => (![a, b, c] p.1) p.2) with hφ
    rw [map_mul, map_prod] at hΦ
    have hφlc := left_ne_zero_of_mul hΦ
    have hφr := Finset.prod_ne_zero_iff.mp (right_ne_zero_of_mul hΦ)

    have hs1 : MvPolynomial.map (φ : MvPolynomial (Fin 3 × Fin (d + 1)) F →+* E)
        (lwGenSection F d f) =
        (MvPolynomial.aeval (fun i : Fin (d + 1) =>
          MvPolynomial.C (a i) + MvPolynomial.X 0 * MvPolynomial.C (b i) +
            MvPolynomial.X 1 * MvPolynomial.C (c i)) f : MvPolynomial (Fin 2) E) := by
      have hext : ((MvPolynomial.mapAlgHom φ).comp (MvPolynomial.aeval (fun i : Fin (d + 1) =>
          MvPolynomial.C (MvPolynomial.X ((0 : Fin 3), i)) +
            MvPolynomial.X 0 * MvPolynomial.C (MvPolynomial.X ((1 : Fin 3), i)) +
            MvPolynomial.X 1 * MvPolynomial.C (MvPolynomial.X ((2 : Fin 3), i)))) :
          MvPolynomial (Fin (d + 1)) F →ₐ[F] MvPolynomial (Fin 2) E) =
          MvPolynomial.aeval (fun i : Fin (d + 1) =>
            MvPolynomial.C (a i) + MvPolynomial.X 0 * MvPolynomial.C (b i) +
              MvPolynomial.X 1 * MvPolynomial.C (c i)) := by
        apply MvPolynomial.algHom_ext
        intro i
        simp [hφ]
      have h := DFunLike.congr_fun hext f
      simpa [lwGenSection, MvPolynomial.mapAlgHom_apply] using h
    set ψ : MvPolynomial (Fin 3 × Fin (d + 1)) F →+* AlgebraicClosure E :=
      (algebraMap E (AlgebraicClosure E)).comp (φ : MvPolynomial (Fin 3 × Fin (d + 1)) F →+* E)
      with hψ
    have hψne : ∀ x, φ x ≠ 0 → ψ x ≠ 0 := by
      intro x hx
      rw [hψ, RingHom.comp_apply]
      exact (map_ne_zero_iff _ (algebraMap E (AlgebraicClosure E)).injective).mpr hx
    have hmap : MvPolynomial.map ψ (lwGenSection F d f) =
        MvPolynomial.map (algebraMap E (AlgebraicClosure E))
          (MvPolynomial.aeval (fun i : Fin (d + 1) =>
            MvPolynomial.C (a i) + MvPolynomial.X 0 * MvPolynomial.C (b i) +
              MvPolynomial.X 1 * MvPolynomial.C (c i)) f : MvPolynomial (Fin 2) E) := by
      rw [← hs1, MvPolynomial.map_map]
    rw [← hmap]
    have hdeg'' : (MvPolynomial.map ψ (lwGenSection F d f)).totalDegree ≤ f.totalDegree := by
      refine le_trans ?_ hGdeg
      exact Finset.sup_mono (MvPolynomial.support_map_subset _ _)
    have hlc'' : (MvPolynomial.map ψ (lwGenSection F d f)).coeff
        (Finsupp.single 1 f.totalDegree) ≠ 0 := by
      rw [MvPolynomial.coeff_map]
      exact hψne _ hφlc
    rw [lw_pb_bivariate_irreducible_iff _ _ f.totalDegree hD1 hdeg'' hlc'']
    intro k l hk hl hkl ⟨P, Q, h1, h2, h3, h4, h5⟩
    obtain rfl : l = f.totalDegree - k := by omega
    have hmem : k ∈ Finset.Icc 1 (f.totalDegree - 1) := Finset.mem_Icc.mpr ⟨hk, by omega⟩
    exact hrP k hk (by omega) _ ψ (hψne _ (hφr k hmem))
      ⟨P, Q, h1, h2, h3, h4, by rw [← MvPolynomial.coeff_map]; exact h5⟩

theorem lw_hypersurface_from_sections (F : Type u) [Field F] [Finite F] (d : ℕ)
    (f : MvPolynomial (Fin (d + 1)) F)
    (hf : Irreducible (MvPolynomial.map (algebraMap F (AlgebraicClosure F)) f))
    (Φ : MvPolynomial (Fin 3 × Fin (d + 1)) F) (hΦ : Φ ≠ 0)
    (hB : ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E] (a b c : Fin (d + 1) → E),
        MvPolynomial.aeval (fun p : Fin 3 × Fin (d + 1) => (![a, b, c] p.1) p.2) Φ ≠ 0 →
        Irreducible (MvPolynomial.map (algebraMap E (AlgebraicClosure E))
          (MvPolynomial.aeval (fun i : Fin (d + 1) =>
              MvPolynomial.C (a i) + MvPolynomial.X 0 * MvPolynomial.C (b i) +
                MvPolynomial.X 1 * MvPolynomial.C (c i)) f :
            MvPolynomial (Fin 2) E)))
    (hW : ∀ η : ℝ, 0 < η → ∃ Q₀ : ℕ, ∀ (K : Type u) [Field K] [Finite K]
        (g : MvPolynomial (Fin 2) K),
        g.totalDegree ≤ f.totalDegree →
        Irreducible (MvPolynomial.map (algebraMap K (AlgebraicClosure K)) g) →
        Q₀ ≤ Nat.card K →
        |(Nat.card {z : Fin 2 → K // MvPolynomial.eval z g = 0} : ℝ) - (Nat.card K : ℝ)| ≤
          η * (Nat.card K : ℝ))
    (ε : ℝ) (hε : 0 < ε) :
    ∃ n₀ : ℕ, ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E],
      n₀ ≤ Module.finrank F E →
      |(Nat.card {x : Fin (d + 1) → E // MvPolynomial.aeval x f = 0} : ℝ) /
          (Nat.card E : ℝ) ^ d - 1| < ε :=
by

  have s1 : ∀ {K L : Type u} [Field K] [Field L] [Algebra K L] [Finite L]
      (σ : Type) [Fintype σ] (P : MvPolynomial σ K), P ≠ 0 →
      (Nat.card {x : σ → L // MvPolynomial.aeval x P = 0} : ℝ) * (Nat.card L : ℝ) ≤
        (P.totalDegree : ℝ) * (Nat.card L : ℝ) ^ Fintype.card σ := by
    intro K L _ _ _ _ σ _ P hP
    classical
    haveI : Fintype L := Fintype.ofFinite L
    set e := Fintype.equivFin σ
    set P' := MvPolynomial.map (algebraMap K L) P with hP'def
    set P'' : MvPolynomial (Fin (Fintype.card σ)) L := MvPolynomial.rename e P' with hP''def
    have hP' : P' ≠ 0 := by
      intro h; apply hP
      apply MvPolynomial.map_injective _ (algebraMap K L).injective
      rw [map_zero]; exact h
    have hP'' : P'' ≠ 0 := by
      intro h; apply hP'
      apply MvPolynomial.rename_injective _ e.injective
      rw [map_zero]; exact h
    have hdeg' : P'.totalDegree ≤ P.totalDegree := by
      unfold MvPolynomial.totalDegree
      exact Finset.sup_mono (MvPolynomial.support_map_subset _ _)
    have hdeg'' : P''.totalDegree ≤ P.totalDegree :=
      le_trans (MvPolynomial.totalDegree_rename_le _ _) hdeg'
    have hcount : Nat.card {x : σ → L // MvPolynomial.aeval x P = 0} =
        (Finset.univ.filter
          (fun y : Fin (Fintype.card σ) → L => MvPolynomial.eval y P'' = 0)).card := by
      rw [← Fintype.card_subtype, ← Nat.card_eq_fintype_card]
      refine Nat.card_congr (Equiv.subtypeEquiv (e.arrowCongr (Equiv.refl L)) ?_)
      intro x
      simp only [hP''def, hP'def, MvPolynomial.eval_rename, MvPolynomial.eval_map,
        MvPolynomial.aeval_def]
      have : (e.arrowCongr (Equiv.refl L)) x ∘ ⇑e = x := by
        funext i; simp [Equiv.arrowCongr_apply]
      rw [this]
    have hsz := MvPolynomial.schwartz_zippel_totalDegree hP'' (Finset.univ : Finset L)
    rw [Fintype.piFinset_univ] at hsz
    rw [hcount]
    have hQ : (0:ℝ) < Fintype.card L := by exact_mod_cast Fintype.card_pos
    rw [Finset.card_univ] at hsz
    rw [Nat.card_eq_fintype_card (α := L)]
    rw [div_le_div_iff₀ (by positivity) (by positivity)] at hsz
    have hnat : (Finset.univ.filter
          (fun y : Fin (Fintype.card σ) → L => MvPolynomial.eval y P'' = 0)).card *
          Fintype.card L ≤
        P''.totalDegree * Fintype.card L ^ Fintype.card σ := by exact_mod_cast hsz
    have hnatR : ((Finset.univ.filter
          (fun y : Fin (Fintype.card σ) → L => MvPolynomial.eval y P'' = 0)).card : ℝ) *
          (Fintype.card L : ℝ) ≤
        (P''.totalDegree : ℝ) * (Fintype.card L : ℝ) ^ Fintype.card σ := by exact_mod_cast hnat
    calc _ ≤ (P''.totalDegree : ℝ) * (Fintype.card L : ℝ) ^ Fintype.card σ := hnatR
      _ ≤ _ := by gcongr

  have s2 : ∀ {E : Type u} [Field E] [Algebra F E] (a b c : Fin (d + 1) → E),
      (∀ z : Fin 2 → E, MvPolynomial.eval z (MvPolynomial.aeval (fun i : Fin (d + 1) =>
          MvPolynomial.C (a i) + MvPolynomial.X 0 * MvPolynomial.C (b i) +
            MvPolynomial.X 1 * MvPolynomial.C (c i)) f : MvPolynomial (Fin 2) E) =
          MvPolynomial.aeval (fun i => a i + z 0 * b i + z 1 * c i) f) ∧
      (MvPolynomial.aeval (fun i : Fin (d + 1) =>
          MvPolynomial.C (a i) + MvPolynomial.X 0 * MvPolynomial.C (b i) +
            MvPolynomial.X 1 * MvPolynomial.C (c i)) f : MvPolynomial (Fin 2) E).totalDegree ≤
        f.totalDegree := by
    intro E _ _ a b c
    constructor
    · intro z
      clear hf hB hW
      induction f using MvPolynomial.induction_on with
      | C r => simp [MvPolynomial.algebraMap_apply]
      | add p q hp hq => simp only [map_add, hp, hq]
      | mul_X p i hp => simp only [map_mul, hp, MvPolynomial.aeval_X, MvPolynomial.eval_add,
          MvPolynomial.eval_C, MvPolynomial.eval_X]
    · set L : Fin (d + 1) → MvPolynomial (Fin 2) E := fun i =>
          MvPolynomial.C (a i) + MvPolynomial.X 0 * MvPolynomial.C (b i) +
            MvPolynomial.X 1 * MvPolynomial.C (c i) with hLdef
      have hL : ∀ i, (L i).totalDegree ≤ 1 := by
        intro i
        refine le_trans (MvPolynomial.totalDegree_add _ _) (max_le ?_ ?_)
        · refine le_trans (MvPolynomial.totalDegree_add _ _) (max_le ?_ ?_)
          · simp
          · refine le_trans (MvPolynomial.totalDegree_mul _ _) ?_
            simp [MvPolynomial.totalDegree_X]
        · refine le_trans (MvPolynomial.totalDegree_mul _ _) ?_
          simp [MvPolynomial.totalDegree_X]
      conv_lhs => rw [f.as_sum]
      rw [map_sum]
      refine le_trans (MvPolynomial.totalDegree_finsetSum _ _) (Finset.sup_le fun s hs => ?_)
      rw [MvPolynomial.aeval_monomial]
      refine le_trans (MvPolynomial.totalDegree_mul _ _) ?_
      rw [MvPolynomial.algebraMap_apply, MvPolynomial.totalDegree_C, zero_add]
      refine le_trans (MvPolynomial.totalDegree_finsetProd _ _) ?_
      refine le_trans ?_ (MvPolynomial.le_totalDegree hs)
      rw [Finsupp.sum]
      apply Finset.sum_le_sum
      intro i _
      refine le_trans (MvPolynomial.totalDegree_pow _ _) ?_
      calc s i * (L i).totalDegree ≤ s i * 1 := Nat.mul_le_mul_left _ (hL i)
        _ = s i := mul_one _

  have s5 : ∀ (V : Type u) [AddGroup V] [Finite V] (P : V → Prop),
      Nat.card {t : V × V × V // P t.1 ∧ P (t.1 + t.2.1) ∧ P (t.1 + t.2.2)} =
        Nat.card {x : V // P x} ^ 3 := by
    intro V _ _ P
    let ψ : V × V × V ≃ V × V × V :=
      { toFun := fun t => (t.1, t.1 + t.2.1, t.1 + t.2.2)
        invFun := fun u => (u.1, -u.1 + u.2.1, -u.1 + u.2.2)
        left_inv := fun t => by simp
        right_inv := fun u => by simp }
    have e1 : {t : V × V × V // P t.1 ∧ P (t.1 + t.2.1) ∧ P (t.1 + t.2.2)} ≃
        {u : V × V × V // P u.1 ∧ (P u.2.1 ∧ P u.2.2)} :=
      Equiv.subtypeEquiv ψ (fun t => Iff.rfl)
    have e2 : {u : V × V × V // P u.1 ∧ (P u.2.1 ∧ P u.2.2)} ≃
        {x // P x} × ({x // P x} × {x // P x}) :=
      (Equiv.subtypeProdEquivProd (p := P) (q := fun w : V × V => P w.1 ∧ P w.2)).trans
        (Equiv.prodCongr (Equiv.refl _) Equiv.subtypeProdEquivProd)
    rw [Nat.card_congr (e1.trans e2), Nat.card_prod, Nat.card_prod]; ring

  have s6 : ∀ (T : Type u) [Fintype T] (S : T → ℝ) (B I : T → Prop)
      (α α' β γ : ℝ), 0 ≤ α → 0 ≤ β → 0 ≤ γ → (∀ t, 0 ≤ S t) →
      (∀ t, ¬ B t → α' ≤ S t ∧ S t ≤ α) →
      (∀ t, B t → S t ≤ β ∨ (S t ≤ γ ∧ I t)) →
      (∑ t, S t ≤ α * Fintype.card T + β * Nat.card {t // B t} + γ * Nat.card {t // I t}) ∧
      α' * ((Fintype.card T : ℝ) - Nat.card {t // B t}) ≤ ∑ t, S t := by
    intro T _ S B I α α' β γ hα hβ hγ hS hgood hbad
    classical
    have hBc : (Nat.card {t // B t} : ℝ) = ∑ t, if B t then (1:ℝ) else 0 := by
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype, Finset.sum_boole]
    have hIc : (Nat.card {t // I t} : ℝ) = ∑ t, if I t then (1:ℝ) else 0 := by
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype, Finset.sum_boole]
    have hT : (Fintype.card T : ℝ) = ∑ t : T, (1:ℝ) := by simp
    constructor
    · rw [hBc, hIc, hT, Finset.mul_sum, Finset.mul_sum, Finset.mul_sum,
        ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
      apply Finset.sum_le_sum; intro t _
      by_cases hb : B t
      · rcases hbad t hb with h | ⟨h, hi⟩
        · simp only [hb, ite_true]
          split_ifs <;> nlinarith [hS t]
        · simp only [hb, hi, ite_true]; linarith
      · obtain ⟨_, h⟩ := hgood t hb
        simp only [hb, ite_false]
        split_ifs <;> linarith
    · rw [hBc, hT, ← Finset.sum_sub_distrib, Finset.mul_sum]
      apply Finset.sum_le_sum; intro t _
      by_cases hb : B t
      · simp only [hb, ite_true, sub_self, mul_zero]; exact hS t
      · simp only [hb, ite_false, sub_zero, mul_one]; exact (hgood t hb).1

  have s7 : ∀ (Q Z B Ssum η δ DΦ : ℝ), 1 ≤ Q → 0 ≤ η → 0 ≤ δ → 0 ≤ DΦ → 0 ≤ Z →
      Ssum = Q ^ (2 * (d + 1) + 2) * Z →
      Ssum ≤ (1 + η) * Q * Q ^ (3 * (d + 1)) + δ * Q * B + Q ^ 2 * Z ^ 3 →
      (1 - η) * Q * (Q ^ (3 * (d + 1)) - B) ≤ Ssum →
      B * Q ≤ DΦ * Q ^ (3 * (d + 1)) →
      Z * Q ≤ δ * Q ^ (d + 1) →
      |Z / Q ^ d - 1| ≤ η + (δ * DΦ + δ ^ 3 + DΦ) / Q := by
    intro Q Z B Ssum η δ DΦ hQ hη hδ hD hZ he hu hl hb hz
    have hQ0 : 0 < Q := by linarith
    set R := Q ^ d with hRdef
    have hR : 0 < R := pow_pos hQ0 d
    have e1 : Q ^ (2 * (d + 1) + 2) = Q ^ 4 * R ^ 2 := by
      rw [hRdef, ← pow_mul, ← pow_add]; ring_nf
    have e2 : Q ^ (3 * (d + 1)) = Q ^ 3 * R ^ 3 := by
      rw [hRdef, ← pow_mul, ← pow_add]; ring_nf
    have e3 : Q ^ (d + 1) = Q * R := by rw [hRdef, pow_succ]; ring
    rw [e1] at he
    rw [e2] at hu hl hb
    rw [e3] at hz
    set C := δ * DΦ + δ ^ 3 + DΦ with hC
    have hC0 : 0 ≤ C := by positivity
    have hz' : Z ≤ δ * R := by
      have : Q * Z ≤ Q * (δ * R) := by nlinarith
      exact le_of_mul_le_mul_left this hQ0
    have hb' : B ≤ DΦ * Q ^ 2 * R ^ 3 := by
      have : Q * B ≤ Q * (DΦ * Q ^ 2 * R ^ 3) := by nlinarith
      exact le_of_mul_le_mul_left this hQ0
    have hZ3 : Z ^ 3 ≤ (δ * R) ^ 3 := pow_le_pow_left₀ hZ hz' 3
    have hQ3R2 : 0 < Q ^ 3 * R ^ 2 := by positivity
    have hup : Q * Z ≤ R * ((1 + η) * Q + C) := by
      have h1 : δ * Q * B ≤ δ * Q * (DΦ * Q ^ 2 * R ^ 3) :=
        mul_le_mul_of_nonneg_left hb' (by positivity)
      have h2 : Q ^ 2 * Z ^ 3 ≤ Q ^ 2 * (δ * R) ^ 3 :=
        mul_le_mul_of_nonneg_left hZ3 (by positivity)
      have h3 : Q ^ 2 * (δ * R) ^ 3 ≤ Q ^ 3 * (δ ^ 3 * R ^ 3) := by
        have : Q ^ 2 * (δ * R) ^ 3 = Q ^ 2 * (δ ^ 3 * R ^ 3) := by ring
        rw [this]
        have hh : 0 ≤ δ ^ 3 * R ^ 3 := by positivity
        have hq : Q ^ 2 ≤ Q ^ 3 := pow_le_pow_right₀ hQ (by norm_num)
        exact mul_le_mul_of_nonneg_right hq hh
      have h4 : (Q ^ 3 * R ^ 2) * (Q * Z) ≤ (Q ^ 3 * R ^ 2) * (R * ((1 + η) * Q + C)) := by
        have : (Q ^ 3 * R ^ 2) * (Q * Z) = Q ^ 4 * R ^ 2 * Z := by ring
        rw [this, ← he]
        have : (Q ^ 3 * R ^ 2) * (R * ((1 + η) * Q + C)) =
            (1 + η) * Q * (Q ^ 3 * R ^ 3) + δ * Q * (DΦ * Q ^ 2 * R ^ 3) +
              Q ^ 3 * (δ ^ 3 * R ^ 3) + DΦ * Q ^ 3 * R ^ 3 := by rw [hC]; ring
        rw [this]
        have : 0 ≤ DΦ * Q ^ 3 * R ^ 3 := by positivity
        linarith
      exact le_of_mul_le_mul_left h4 hQ3R2
    have hlow : R * (Q - η * Q - C) ≤ Q * Z := by
      by_cases hη1 : 1 ≤ η
      · have : Q - η * Q - C ≤ 0 := by nlinarith
        have : R * (Q - η * Q - C) ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hR.le this
        have : 0 ≤ Q * Z := by positivity
        linarith
      · have hη1' : η < 1 := lt_of_not_ge hη1
        have h1 : (1 - η) * Q * (Q ^ 3 * R ^ 3 - DΦ * Q ^ 2 * R ^ 3) ≤
            (1 - η) * Q * (Q ^ 3 * R ^ 3 - B) := by
          apply mul_le_mul_of_nonneg_left _ (by nlinarith)
          linarith
        have h4 : (Q ^ 3 * R ^ 2) * (R * (Q - η * Q - C)) ≤ (Q ^ 3 * R ^ 2) * (Q * Z) := by
          have : (Q ^ 3 * R ^ 2) * (Q * Z) = Q ^ 4 * R ^ 2 * Z := by ring
          rw [this, ← he]
          have : (1 - η) * Q * (Q ^ 3 * R ^ 3 - DΦ * Q ^ 2 * R ^ 3) =
              (Q ^ 3 * R ^ 2) * (R * (Q - η * Q - DΦ + η * DΦ)) := by ring
          have h5 : (Q ^ 3 * R ^ 2) * (R * (Q - η * Q - C)) ≤
              (Q ^ 3 * R ^ 2) * (R * (Q - η * Q - DΦ + η * DΦ)) := by
            apply mul_le_mul_of_nonneg_left _ hQ3R2.le
            apply mul_le_mul_of_nonneg_left _ hR.le
            rw [hC]
            have : 0 ≤ δ * DΦ := by positivity
            have : 0 ≤ δ ^ 3 := by positivity
            have : 0 ≤ η * DΦ := by positivity
            linarith
          linarith
        exact le_of_mul_le_mul_left h4 hQ3R2
    have hexp : Z / R - 1 = (Q * Z - Q * R) / (Q * R) := by
      field_simp
    have hexp2 : η + C / Q = (η * Q * R + C * R) / (Q * R) := by
      field_simp
    rw [abs_le, hexp, hexp2]
    have hQR : 0 < Q * R := by positivity
    constructor
    · rw [neg_div', div_le_div_iff_of_pos_right hQR]
      nlinarith
    · rw [div_le_div_iff_of_pos_right hQR]
      nlinarith

  have s8 : ∀ (E : Type u) (n : ℕ) (P : (Fin 3 × Fin n → E) → Prop),
      Nat.card {t : (Fin n → E) × (Fin n → E) × (Fin n → E) //
          P (fun p : Fin 3 × Fin n => (![t.1, t.2.1, t.2.2] p.1) p.2)} =
        Nat.card {x : Fin 3 × Fin n → E // P x} := by
    intro E n P
    let κ : (Fin n → E) × (Fin n → E) × (Fin n → E) ≃ (Fin 3 × Fin n → E) :=
      { toFun := fun t p => (![t.1, t.2.1, t.2.2] p.1) p.2
        invFun := fun x => (fun i => x (0, i), fun i => x (1, i), fun i => x (2, i))
        left_inv := fun t => by simp
        right_inv := fun x => by
          funext ⟨k, i⟩
          fin_cases k <;> rfl }
    exact Nat.card_congr (Equiv.subtypeEquiv κ (fun t => Iff.rfl))

  have s3 : ∀ {E : Type u} [Field E] [Algebra F E] [Fintype E],
      ∑ t : (Fin (d + 1) → E) × (Fin (d + 1) → E) × (Fin (d + 1) → E),
          Nat.card {z : Fin 2 → E //
            MvPolynomial.aeval (fun i => t.1 i + z 0 * t.2.1 i + z 1 * t.2.2 i) f = 0} =
        Nat.card E ^ (2 * (d + 1) + 2) *
          Nat.card {x : Fin (d + 1) → E // MvPolynomial.aeval x f = 0} := by
    intro E _ _ _
    classical
    have h1 : ∀ t : (Fin (d + 1) → E) × (Fin (d + 1) → E) × (Fin (d + 1) → E),
        Nat.card {z : Fin 2 → E //
            MvPolynomial.aeval (fun i => t.1 i + z 0 * t.2.1 i + z 1 * t.2.2 i) f = 0} =
        ∑ z : Fin 2 → E,
          if MvPolynomial.aeval (fun i => t.1 i + z 0 * t.2.1 i + z 1 * t.2.2 i) f = 0
          then 1 else 0 := by
      intro t
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype, Finset.card_filter]
    simp_rw [h1]
    rw [Finset.sum_comm]
    have h2 : ∀ z : Fin 2 → E,
        ∑ t : (Fin (d + 1) → E) × (Fin (d + 1) → E) × (Fin (d + 1) → E),
          (if MvPolynomial.aeval (fun i => t.1 i + z 0 * t.2.1 i + z 1 * t.2.2 i) f = 0
            then 1 else 0) =
        ∑ t : (Fin (d + 1) → E) × (Fin (d + 1) → E) × (Fin (d + 1) → E),
          (if MvPolynomial.aeval t.1 f = 0 then 1 else 0) := by
      intro z
      let ez : ((Fin (d + 1) → E) × (Fin (d + 1) → E) × (Fin (d + 1) → E)) ≃
          ((Fin (d + 1) → E) × (Fin (d + 1) → E) × (Fin (d + 1) → E)) :=
        { toFun := fun t => (fun i => t.1 i + z 0 * t.2.1 i + z 1 * t.2.2 i, t.2)
          invFun := fun t => (fun i => t.1 i - z 0 * t.2.1 i - z 1 * t.2.2 i, t.2)
          left_inv := fun t => by
            ext i <;> simp; ring
          right_inv := fun t => by
            ext i <;> simp; ring }
      exact Fintype.sum_equiv ez _ _ (fun t => rfl)
    simp_rw [h2]
    have h3 : ∑ t : (Fin (d + 1) → E) × (Fin (d + 1) → E) × (Fin (d + 1) → E),
          (if MvPolynomial.aeval t.1 f = 0 then 1 else 0) =
        ∑ x : Fin (d + 1) → E, ∑ _y : (Fin (d + 1) → E) × (Fin (d + 1) → E),
          (if MvPolynomial.aeval x f = 0 then 1 else 0) := Fintype.sum_prod_type _
    rw [h3]
    simp only [Finset.sum_const, Finset.card_univ, smul_eq_mul]
    rw [← Finset.mul_sum, Finset.sum_boole, ← Fintype.card_subtype, ← Nat.card_eq_fintype_card]
    simp only [Fintype.card_prod, Fintype.card_fun, Fintype.card_fin, Nat.card_eq_fintype_card,
      Nat.cast_id]
    ring

  classical
  set δ : ℝ := (f.totalDegree : ℝ) with hδdef
  set DΦ : ℝ := (Φ.totalDegree : ℝ) with hDdef
  set C : ℝ := δ * DΦ + δ ^ 3 + DΦ with hC
  have hδ0 : 0 ≤ δ := Nat.cast_nonneg _
  have hD0 : 0 ≤ DΦ := Nat.cast_nonneg _
  have hC0 : 0 ≤ C := by positivity
  set η : ℝ := ε / 2 with hηdef
  have hη : 0 < η := by rw [hηdef]; linarith
  obtain ⟨Q₀, hQ₀⟩ := hW η hη
  obtain ⟨M, hM⟩ := exists_nat_gt (2 * C / ε)
  refine ⟨max Q₀ M, ?_⟩
  intro E _ _ _ hn
  haveI : Finite E := Module.finite_of_finite F
  letI : Fintype E := Fintype.ofFinite E
  have hf0 : f ≠ 0 := by
    rintro rfl
    rw [map_zero] at hf
    exact not_irreducible_zero hf
  have hcardE : Nat.card E = Nat.card F ^ Module.finrank F E := Module.natCard_eq_pow_finrank
  have hF2 : 2 ≤ Nat.card F := Finite.one_lt_card
  have hEn : Module.finrank F E < Nat.card E := by
    rw [hcardE]
    exact lt_of_lt_of_le Nat.lt_two_pow_self (Nat.pow_le_pow_left hF2 _)
  have hQ₀E : Q₀ ≤ Nat.card E := by
    have := le_max_left Q₀ M
    omega
  have hME : M < Nat.card E := by
    have := le_max_right Q₀ M
    omega
  set Q : ℝ := (Nat.card E : ℝ) with hQdef
  have hQ1 : 1 ≤ Q := by
    have : 1 ≤ Nat.card E := by omega
    rw [hQdef]; exact_mod_cast this
  have hQ0 : 0 < Q := by linarith
  have hCQ : C / Q < ε / 2 := by
    rw [div_lt_iff₀ hQ0]
    have h1 : 2 * C < M * ε := (div_lt_iff₀ hε).mp hM
    have h2 : (M : ℝ) < Q := by rw [hQdef]; exact_mod_cast hME
    nlinarith
  set Z : ℕ := Nat.card {x : Fin (d + 1) → E // MvPolynomial.aeval x f = 0} with hZdef
  have hz : (Z : ℝ) * Q ≤ δ * Q ^ (d + 1) := by
    have := s1 (K := F) (L := E) (Fin (d + 1)) f hf0
    simpa only [Fintype.card_fin] using this
  set Bc : ℕ := Nat.card {t : (Fin (d + 1) → E) × (Fin (d + 1) → E) × (Fin (d + 1) → E) //
      MvPolynomial.aeval (fun p : Fin 3 × Fin (d + 1) => (![t.1, t.2.1, t.2.2] p.1) p.2) Φ = 0}
    with hBcdef
  have hb : (Bc : ℝ) * Q ≤ DΦ * Q ^ (3 * (d + 1)) := by
    have h8 := s8 E (d + 1) (fun x => MvPolynomial.aeval x Φ = 0)
    have h1 := s1 (K := F) (L := E) (Fin 3 × Fin (d + 1)) Φ hΦ
    simp only [Fintype.card_prod, Fintype.card_fin] at h1
    rw [hBcdef, h8]
    exact h1
  let S : (Fin (d + 1) → E) × (Fin (d + 1) → E) × (Fin (d + 1) → E) → ℝ := fun t =>
    (Nat.card {z : Fin 2 → E //
      MvPolynomial.aeval (fun i => t.1 i + z 0 * t.2.1 i + z 1 * t.2.2 i) f = 0} : ℝ)
  let g : (Fin (d + 1) → E) × (Fin (d + 1) → E) × (Fin (d + 1) → E) →
      MvPolynomial (Fin 2) E := fun t =>
    MvPolynomial.aeval (fun i : Fin (d + 1) =>
      MvPolynomial.C (t.1 i) + MvPolynomial.X 0 * MvPolynomial.C (t.2.1 i) +
        MvPolynomial.X 1 * MvPolynomial.C (t.2.2 i)) f
  have hSg : ∀ t, S t = (Nat.card {z : Fin 2 → E // MvPolynomial.eval z (g t) = 0} : ℝ) := by
    intro t
    have h2 := (s2 t.1 t.2.1 t.2.2).1
    simp only [S]
    congr 1
    exact Nat.card_congr (Equiv.subtypeEquivRight fun z => by rw [h2 z])
  have hgood : ∀ t, ¬ (MvPolynomial.aeval
      (fun p : Fin 3 × Fin (d + 1) => (![t.1, t.2.1, t.2.2] p.1) p.2) Φ = 0) →
      (1 - η) * Q ≤ S t ∧ S t ≤ (1 + η) * Q := by
    intro t ht
    have hirr := hB E t.1 t.2.1 t.2.2 ht
    have hdeg := (s2 t.1 t.2.1 t.2.2).2
    have hw := hQ₀ E (g t) hdeg hirr hQ₀E
    rw [← hSg t, abs_le] at hw
    constructor <;> nlinarith [hw.1, hw.2]
  have hbad : ∀ t, S t ≤ δ * Q ∨ (S t ≤ Q ^ 2 ∧ (MvPolynomial.aeval t.1 f = 0 ∧
      MvPolynomial.aeval (t.1 + t.2.1) f = 0 ∧ MvPolynomial.aeval (t.1 + t.2.2) f = 0)) := by
    intro t
    by_cases hg : g t = 0
    · right
      have hev := (s2 t.1 t.2.1 t.2.2).1
      have hzero : ∀ z : Fin 2 → E,
          MvPolynomial.aeval (fun i => t.1 i + z 0 * t.2.1 i + z 1 * t.2.2 i) f = 0 := by
        intro z
        rw [← hev z]
        show MvPolynomial.eval z (g t) = 0
        rw [hg, map_zero]
      refine ⟨?_, ?_, ?_, ?_⟩
      · have h1 := Finite.card_subtype_le (fun z : Fin 2 → E =>
          MvPolynomial.aeval (fun i => t.1 i + z 0 * t.2.1 i + z 1 * t.2.2 i) f = 0)
        rw [Nat.card_fun, Nat.card_fin] at h1
        simp only [S, hQdef]
        exact_mod_cast h1
      · have h := hzero ![0, 0]
        convert h using 3
        funext i; simp
      · have h := hzero ![1, 0]
        convert h using 3
        funext i; simp
      · have h := hzero ![0, 1]
        convert h using 3
        funext i; simp
    · left
      have h1 := s1 (K := E) (L := E) (Fin 2) (g t) hg
      have hdeg := (s2 t.1 t.2.1 t.2.2).2
      have hae : Nat.card {x : Fin 2 → E // MvPolynomial.aeval x (g t) = 0} =
          Nat.card {z : Fin 2 → E // MvPolynomial.eval z (g t) = 0} := rfl
      rw [hae, Fintype.card_fin] at h1
      rw [hSg t]
      have hdegR : ((g t).totalDegree : ℝ) ≤ δ := by rw [hδdef]; exact_mod_cast hdeg
      have h3 : (Nat.card {z : Fin 2 → E // MvPolynomial.eval z (g t) = 0} : ℝ) * Q ≤
          (δ * Q) * Q := by
        calc _ ≤ ((g t).totalDegree : ℝ) * Q ^ 2 := h1
          _ ≤ δ * Q ^ 2 := by gcongr
          _ = (δ * Q) * Q := by ring
      exact le_of_mul_le_mul_right h3 hQ0
  have hsplit := s6 ((Fin (d + 1) → E) × (Fin (d + 1) → E) × (Fin (d + 1) → E)) S
    (fun t => MvPolynomial.aeval
      (fun p : Fin 3 × Fin (d + 1) => (![t.1, t.2.1, t.2.2] p.1) p.2) Φ = 0)
    (fun t => MvPolynomial.aeval t.1 f = 0 ∧
      MvPolynomial.aeval (t.1 + t.2.1) f = 0 ∧ MvPolynomial.aeval (t.1 + t.2.2) f = 0)
    ((1 + η) * Q) ((1 - η) * Q) (δ * Q) (Q ^ 2) (by positivity) (by positivity) (by positivity)
    (fun t => Nat.cast_nonneg _) hgood (fun t _ => hbad t)
  have hT : (Fintype.card ((Fin (d + 1) → E) × (Fin (d + 1) → E) × (Fin (d + 1) → E)) : ℝ) =
      Q ^ (3 * (d + 1)) := by
    simp only [Fintype.card_prod, Fintype.card_fun, Fintype.card_fin]
    rw [hQdef, Nat.card_eq_fintype_card]
    push_cast; ring
  have hIc : (Nat.card {t : (Fin (d + 1) → E) × (Fin (d + 1) → E) × (Fin (d + 1) → E) //
      MvPolynomial.aeval t.1 f = 0 ∧
      MvPolynomial.aeval (t.1 + t.2.1) f = 0 ∧ MvPolynomial.aeval (t.1 + t.2.2) f = 0} : ℝ) =
      (Z : ℝ) ^ 3 := by
    have h5 := s5 (Fin (d + 1) → E) (fun x => MvPolynomial.aeval x f = 0)
    rw [hZdef]
    exact_mod_cast h5
  rw [hT, hIc] at hsplit
  obtain ⟨hup, hlow⟩ := hsplit
  have he : ∑ t, S t = Q ^ (2 * (d + 1) + 2) * (Z : ℝ) := by
    have h3 := congrArg (Nat.cast : ℕ → ℝ) (s3 (E := E))
    push_cast at h3
    simp only [S]
    rw [h3, hQdef, hZdef]
  have hfin := s7 Q (Z : ℝ) (Bc : ℝ) (∑ t, S t) η δ DΦ hQ1 hη.le hδ0 hD0
    (Nat.cast_nonneg _) he (by linarith) hlow hb hz
  rw [← hC] at hfin
  calc _ ≤ η + C / Q := hfin
    _ < ε := by rw [hηdef]; linarith

theorem lang_weil_asymptotic (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    (d : ℕ) [SmoothOfRelativeDimension d X.hom] (ε : ℝ) (hε : 0 < ε) :
    ∃ n₀ : ℕ, ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E],
      n₀ ≤ Module.finrank F E →
      |(Nat.card (.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) : ℝ) /
          (Nat.card F : ℝ) ^ (d * Module.finrank F E) - 1| < ε :=
by
  classical

  have hbound : ∀ (s : ℕ) (C x Q : ℝ), s ≤ d → 1 ≤ Q → 0 ≤ x → x * Q ≤ C * Q ^ s →
      0 ≤ C ∧ x / Q ^ d ≤ C / Q := by
    intro s C x Q hs hQ hx hxC
    have hQ0 : 0 < Q := by linarith
    have hQs : 0 < Q ^ s := pow_pos hQ0 s
    have hC0 : 0 ≤ C := by
      by_contra hneg
      push_neg at hneg
      have h1 : C * Q ^ s < 0 := mul_neg_of_neg_of_pos hneg hQs
      have h2 : 0 ≤ x * Q := mul_nonneg hx hQ0.le
      linarith
    refine ⟨hC0, ?_⟩
    rw [div_le_div_iff₀ (pow_pos hQ0 d) hQ0]
    calc x * Q ≤ C * Q ^ s := hxC
      _ ≤ C * Q ^ d := mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hQ hs) hC0
  have hsplit : ∀ {α : Type u} [Finite α] (P R : α → Prop),
      Nat.card {x // P x} = Nat.card {x // P x ∧ R x} + Nat.card {x // P x ∧ ¬ R x} := by
    intro α _ P R
    rw [← Nat.card_congr (Equiv.subtypeSubtypeEquivSubtypeInter P R),
      ← Nat.card_congr (Equiv.subtypeSubtypeEquivSubtypeInter P (fun x => ¬ R x)),
      ← Nat.card_sum]
    exact Nat.card_congr (Equiv.sumCompl (fun y : {x // P x} => R y.1)).symm

  obtain ⟨k, c, rel, hh, hJ, hP, hG, hH, hC⟩ := lw_affine_chart_cover F X d

  have h2 := fun i => lw_jacobian_generic_separable F d (c i) (rel i) (hJ i) (hP i)
  have hnz : ∀ i, ∀ j : Fin (d + c i), ∃ P : Polynomial (MvPolynomial (Fin d) F), P ≠ 0 ∧
      Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd (c i))).toRingHom
        (MvPolynomial.X j) P ∈ Ideal.span (Set.range (rel i)) := by
    intro i j
    obtain ⟨P, hP1, hP2⟩ := (h2 i).2.2 j
    refine ⟨P, ?_, hP1⟩
    intro hP0
    apply hP2
    rw [hP0, Polynomial.derivative_zero, Polynomial.eval₂_zero]
    exact Ideal.zero_mem _

  have h4 := fun i => lw_noether_dim F d (c i) _ (h2 i).1 (h2 i).2.1 (hnz i)
  choose s gN hs hgN using h4

  have h3 := fun i => lw_lower_dim_bound F (d + c i) (s i) _ (h2 i).1 (gN i) (hgN i) (hh i)
    (fun hm => hH i (Ideal.le_radical hm))
  choose Ci hCi using h3

  have hGmap : (Ideal.map (MvPolynomial.map (algebraMap F (AlgebraicClosure F)))
      (Ideal.span (Set.range (rel 0)))).radical.IsPrime := by
    rw [Ideal.map_span, ← Set.range_comp]
    exact hG
  obtain ⟨f, g0, D0, hfirr, hfprime, hfind, hfalg, hg0, hD0, hbij⟩ :=
    lw_birational_hypersurface F d (c 0) _ (h2 0).1 hGmap (h2 0).2.1 (h2 0).2.2

  obtain ⟨Cg, hCg⟩ := lw_lower_dim_bound F (d + c 0) (s 0) _ (h2 0).1 (gN 0) (hgN 0) g0 hg0
  obtain ⟨sD, gD, hsD, hgD⟩ := lw_noether_dim F d 1 (Ideal.span {f}) hfprime hfind hfalg
  obtain ⟨CD, hCD⟩ := lw_lower_dim_bound F (d + 1) sD (Ideal.span {f}) hfprime gD hgD D0 hD0

  obtain ⟨Φ, hΦ, hΦirr⟩ := lw_plane_bertini F d f hfirr
  obtain ⟨n₁, hn₁⟩ := lw_hypersurface_from_sections F d f hfirr Φ hΦ hΦirr
    (fun η hη => lw_plane_curve_count f.totalDegree η hη) (ε / 2) (by linarith)

  set T : ℝ := Cg + CD + ∑ i, Ci i with hT
  obtain ⟨M, hM⟩ := exists_nat_gt (2 * T / ε)
  refine ⟨max n₁ M, ?_⟩
  intro E _ _ _ hn
  haveI : Finite E := Module.finite_of_finite F
  have hq2 : (2 : ℝ) ≤ (Nat.card F : ℝ) := by
    have := Finite.one_lt_card (α := F)
    exact_mod_cast this
  have hQeq : (Nat.card E : ℝ) = (Nat.card F : ℝ) ^ Module.finrank F E := by
    rw [Module.natCard_eq_pow_finrank (K := F) (V := E)]
    push_cast
    ring
  have hden : (Nat.card F : ℝ) ^ (d * Module.finrank F E) = (Nat.card E : ℝ) ^ d := by
    rw [hQeq, ← pow_mul, mul_comm]
  rw [hden]
  set Q : ℝ := (Nat.card E : ℝ) with hQdef
  have h2n : (2 : ℝ) ^ Module.finrank F E ≤ Q := by
    rw [hQeq]
    exact pow_le_pow_left₀ (by norm_num) hq2 _
  have hQ1 : 1 ≤ Q := le_trans (one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2)) h2n
  have hQ0 : 0 < Q := by linarith
  have hQM : (M : ℝ) < Q := by
    have h1 : (M : ℝ) ≤ (Module.finrank F E : ℝ) := by
      exact_mod_cast le_trans (le_max_right n₁ M) hn
    have h2 : ((Module.finrank F E : ℕ) : ℝ) < (2 : ℝ) ^ Module.finrank F E := by
      exact_mod_cast (Nat.lt_two_pow_self (n := Module.finrank F E))
    linarith
  have hTQ : T / Q < ε / 2 := by
    rw [div_lt_iff₀ hQ0]
    have h1 : 2 * T < M * ε := (div_lt_iff₀ hε).mp hM
    have h2 : (M : ℝ) * ε < Q * ε := mul_lt_mul_of_pos_right hQM hε
    linarith
  have hTsplit : T / Q = Cg / Q + CD / Q + (∑ i, Ci i) / Q := by
    rw [hT]; ring
  set Pd : ℝ := Q ^ d with hPd
  have hPd0 : 0 < Pd := pow_pos hQ0 d

  have hZ := hn₁ E (le_trans (le_max_left n₁ M) hn)

  have hZeq : Nat.card {x : Fin (d + 1) → E // MvPolynomial.aeval x f = 0} =
      Nat.card {z : Fin (d + 1) → E //
        ∀ p ∈ Ideal.span {f}, MvPolynomial.aeval z p = 0} := by
    refine Nat.card_congr (Equiv.subtypeEquivRight fun z => ⟨fun hz p hp => ?_, fun hz => ?_⟩)
    · obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hp
      rw [map_mul, hz, mul_zero]
    · exact hz f (Ideal.mem_span_singleton_self f)
  have hZsplit := hsplit (fun z : Fin (d + 1) → E =>
      ∀ p ∈ Ideal.span {f}, MvPolynomial.aeval z p = 0)
    (fun z => MvPolynomial.aeval z D0 = 0)
  have hVsplit := hsplit (fun x : Fin (d + c 0) → E =>
      ∀ p ∈ Ideal.span (Set.range (rel 0)), MvPolynomial.aeval x p = 0)
    (fun x => MvPolynomial.aeval x g0 = 0)
  have hA := hbij E
  simp only [ne_eq] at hA
  obtain ⟨hN1, hN2⟩ := hC E

  have hbR : ∀ i, 0 ≤ Ci i ∧
      (Nat.card {x : Fin (d + c i) → E //
        (∀ p ∈ Ideal.span (Set.range (rel i)), MvPolynomial.aeval x p = 0) ∧
          MvPolynomial.aeval x (hh i) = 0} : ℝ) / Pd ≤ Ci i / Q :=
    fun i => hbound (s i) (Ci i) _ Q (hs i) hQ1 (Nat.cast_nonneg _) (hCi i E)
  have hbg := hbound (s 0) Cg _ Q (hs 0) hQ1 (Nat.cast_nonneg _) (hCg E)
  have hbD := hbound sD CD _ Q hsD hQ1 (Nat.cast_nonneg _) (hCD E)
  have hsumR : (∑ i, (Nat.card {x : Fin (d + c i) → E //
        (∀ p ∈ Ideal.span (Set.range (rel i)), MvPolynomial.aeval x p = 0) ∧
          MvPolynomial.aeval x (hh i) = 0} : ℝ)) / Pd ≤ (∑ i, Ci i) / Q := by
    rw [Finset.sum_div, Finset.sum_div]
    exact Finset.sum_le_sum fun i _ => (hbR i).2
  have hsumC : 0 ≤ (∑ i, Ci i) / Q :=
    div_nonneg (Finset.sum_nonneg fun i _ => (hbR i).1) hQ0.le
  have hCg0 : 0 ≤ Cg / Q := div_nonneg hbg.1 hQ0.le
  have hCD0 : 0 ≤ CD / Q := div_nonneg hbD.1 hQ0.le

  have rN1 : (Nat.card {x : Fin (d + c 0) → E //
        ∀ p ∈ Ideal.span (Set.range (rel 0)), MvPolynomial.aeval x p = 0} : ℝ) / Pd ≤
      (Nat.card (Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) : ℝ) / Pd :=
    div_le_div_of_nonneg_right (by exact_mod_cast hN1) hPd0.le
  have rN2 : (Nat.card (Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) : ℝ) / Pd ≤
      (Nat.card {x : Fin (d + c 0) → E //
        ∀ p ∈ Ideal.span (Set.range (rel 0)), MvPolynomial.aeval x p = 0} : ℝ) / Pd +
      (∑ i, (Nat.card {x : Fin (d + c i) → E //
        (∀ p ∈ Ideal.span (Set.range (rel i)), MvPolynomial.aeval x p = 0) ∧
          MvPolynomial.aeval x (hh i) = 0} : ℝ)) / Pd := by
    rw [← add_div]
    exact div_le_div_of_nonneg_right (by exact_mod_cast hN2) hPd0.le
  have rV : (Nat.card {x : Fin (d + c 0) → E //
        ∀ p ∈ Ideal.span (Set.range (rel 0)), MvPolynomial.aeval x p = 0} : ℝ) / Pd =
      (Nat.card {x : Fin (d + c 0) → E //
        (∀ p ∈ Ideal.span (Set.range (rel 0)), MvPolynomial.aeval x p = 0) ∧
          MvPolynomial.aeval x g0 = 0} : ℝ) / Pd +
      (Nat.card {x : Fin (d + c 0) → E //
        (∀ p ∈ Ideal.span (Set.range (rel 0)), MvPolynomial.aeval x p = 0) ∧
          ¬ MvPolynomial.aeval x g0 = 0} : ℝ) / Pd := by
    rw [← add_div, hVsplit]
    push_cast
    ring
  have rZ : (Nat.card {x : Fin (d + 1) → E // MvPolynomial.aeval x f = 0} : ℝ) / Pd =
      (Nat.card {z : Fin (d + 1) → E //
        (∀ p ∈ Ideal.span {f}, MvPolynomial.aeval z p = 0) ∧
          MvPolynomial.aeval z D0 = 0} : ℝ) / Pd +
      (Nat.card {z : Fin (d + 1) → E //
        (∀ p ∈ Ideal.span {f}, MvPolynomial.aeval z p = 0) ∧
          ¬ MvPolynomial.aeval z D0 = 0} : ℝ) / Pd := by
    rw [← add_div, hZeq, hZsplit]
    push_cast
    ring
  have rA : (Nat.card {x : Fin (d + c 0) → E //
        (∀ p ∈ Ideal.span (Set.range (rel 0)), MvPolynomial.aeval x p = 0) ∧
          ¬ MvPolynomial.aeval x g0 = 0} : ℝ) / Pd =
      (Nat.card {z : Fin (d + 1) → E //
        (∀ p ∈ Ideal.span {f}, MvPolynomial.aeval z p = 0) ∧
          ¬ MvPolynomial.aeval z D0 = 0} : ℝ) / Pd := by
    rw [hA]
  have hbg2 := hbg.2
  have hbD2 := hbD.2
  rw [← hPd] at hbg2 hbD2
  rw [← hQdef, ← hPd] at hZ
  have hB1nn : 0 ≤ (Nat.card {x : Fin (d + c 0) → E //
        (∀ p ∈ Ideal.span (Set.range (rel 0)), MvPolynomial.aeval x p = 0) ∧
          MvPolynomial.aeval x g0 = 0} : ℝ) / Pd := div_nonneg (Nat.cast_nonneg _) hPd0.le
  have hB2nn : 0 ≤ (Nat.card {z : Fin (d + 1) → E //
        (∀ p ∈ Ideal.span {f}, MvPolynomial.aeval z p = 0) ∧
          MvPolynomial.aeval z D0 = 0} : ℝ) / Pd := div_nonneg (Nat.cast_nonneg _) hPd0.le
  rw [abs_lt] at hZ ⊢
  constructor <;> linarith

theorem wc_top_twist_point_class (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n : ℕ) (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E]
    (hE : ¬ ℓ ∣ Module.finrank F E)
    (p : Over.mk (Spec.map (CommRingCat.ofHom (algebraMap F E))) ⟶ X) :
    ∃ (π : wcGeomPoint F X h ⟶ Scheme.ProEt.mk (𝟙 X.left))
      (w : Abelian.Ext (wcFreeSheaf X.left (Scheme.ProEt.mk (𝟙 X.left)))
        (wcRootTwist X.left (ℓ ^ n) d) (2 * d)),
      ∀ k : ℕ, k • (Abelian.Ext.mk₀ (wcFreeSheafMap X.left π)).comp w (zero_add (2 * d)) = 0 →
        ℓ ^ n ∣ k :=
by
  classical

  have hWE : ∀ (E' : Type u) [Field E'] [Algebra F E'] [FiniteDimensional F E'],
      WeaklyEtale (Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F E')))) := by
    intro E' _ _ _
    have : Algebra.FormallyEtale F E' := Algebra.FormallyEtale.of_isSeparable F E'
    have : Algebra.FinitePresentation F E' :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance
    have : Algebra.Etale F E' := ⟨inferInstance, inferInstance⟩
    have he : Etale (Spec.map (CommRingCat.ofHom (algebraMap F E'))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Etale)]
      exact RingHom.etale_algebraMap.mpr inferInstance
    exact etale_le_weaklyEtale _ _ _
      (MorphismProperty.of_isPullback (P := @Etale) (IsPullback.of_hasPullback X.hom _).flip he)

  have hfun : ∀ {A B C : X.left.ProEt} (a : A ⟶ B) (b : B ⟶ C),
      wcFreeSheafMap X.left a ≫ wcFreeSheafMap X.left b = wcFreeSheafMap X.left (a ≫ b) := by
    intro A B C a b
    have e : Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight (yoneda.map (a ≫ b))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
      first
        | rw [yoneda.map_comp, Functor.whiskerRight_comp]
        | (apply NatTrans.ext; funext V; simp [← Functor.map_comp])
    exact ((presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      (congrArg (presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map e)

  obtain ⟨φ, hφ⟩ : ∃ φ : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcRootTwist X.left (ℓ ^ n) d) (2 * d) →+ Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcRootTwist X.left (ℓ ^ n) d) (2 * d),
      ∀ y, φ y = (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h))).comp y
        (zero_add (2 * d)) :=
    ⟨(Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h))).precomp
      (wcRootTwist X.left (ℓ ^ n) d) (zero_add (2 * d)), fun y => by
        simp only [Abelian.Ext.precomp, Abelian.Ext.bilinearComp_apply_apply]⟩
  have hshift : ∀ {U' : X.left.ProEt} (a : wcGeomPoint F X h ⟶ U')
      (w' : Abelian.Ext (wcFreeSheaf X.left U') (wcRootTwist X.left (ℓ ^ n) d) (2 * d)),
      (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h ≫ a))).comp w' (zero_add (2 * d)) =
        φ ((Abelian.Ext.mk₀ (wcFreeSheafMap X.left a)).comp w' (zero_add (2 * d))) := by
    intro U' a w'
    rw [hφ, ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h)))
      (Abelian.Ext.mk₀ (wcFreeSheafMap X.left a)) w' (zero_add 0) (zero_add (2 * d)) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hfun]
  have hiter : ∀ {U' : X.left.ProEt} (s : ℕ → (wcGeomPoint F X h ⟶ U'))
      (_ : ∀ j, s (j + 1) = wcGeomFrob F X h ≫ s j)
      (w' : Abelian.Ext (wcFreeSheaf X.left U') (wcRootTwist X.left (ℓ ^ n) d) (2 * d)) (j : ℕ),
      (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (s j))).comp w' (zero_add (2 * d)) =
        (⇑φ)^[j] ((Abelian.Ext.mk₀ (wcFreeSheafMap X.left (s 0))).comp w' (zero_add (2 * d))) := by
    intro U' s hs w' j
    induction j with
    | zero => rfl
    | succ j ih => rw [hs j, hshift, ih, Function.iterate_succ_apply']

  obtain ⟨n₀, hn₀⟩ := lang_weil_asymptotic F X d (1 / 2) (by norm_num)

  have hdeg : ∀ R : ℕ, n₀ ≤ R → 1 ≤ R → ∃ c : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcRootTwist X.left (ℓ ^ n) d) (2 * d),
      (∀ k : ℕ, k • c = 0 → ℓ ^ n ∣ k) ∧ (⇑φ)^[R] c = c := by
    intro R hR hR1
    haveI : Fact (Nat.Prime (ringChar F)) := ⟨CharP.char_is_prime F (ringChar F)⟩
    haveI : NeZero R := ⟨by omega⟩
    haveI : FiniteDimensional F (ULift.{u} (FiniteField.Extension F (ringChar F) R)) :=
      Module.Finite.equiv (ULift.moduleEquiv (R := F)).symm
    have hER : Module.finrank F (ULift.{u} (FiniteField.Extension F (ringChar F) R)) = R := by
      rw [LinearEquiv.finrank_eq (ULift.moduleEquiv (R := F))]
      exact FiniteField.finrank_extension F (ringChar F) R
    have h1 := hn₀ (ULift.{u} (FiniteField.Extension F (ringChar F) R)) (by rw [hER]; exact hR)
    have hpos : 0 < Nat.card (Over.mk (Spec.map (CommRingCat.ofHom (algebraMap F
        (ULift.{u} (FiniteField.Extension F (ringChar F) R))))) ⟶ X) := by
      rcases Nat.eq_zero_or_pos (Nat.card (Over.mk (Spec.map (CommRingCat.ofHom (algebraMap F
        (ULift.{u} (FiniteField.Extension F (ringChar F) R))))) ⟶ X)) with h0 | h0
      · rw [h0] at h1
        norm_num at h1
      · exact h0
    obtain ⟨p'⟩ := (Nat.card_pos_iff.mp hpos).1
    have hU' := hWE (ULift.{u} (FiniteField.Extension F (ringChar F) R))
    obtain ⟨s, N, hs, hsr, -⟩ := wc_finite_ext_transfer F X h
      (ULift.{u} (FiniteField.Extension F (ringChar F) R)) hU'
    obtain ⟨w', hw'⟩ := wc_rational_point_class F X d ℓ hℓ h n
      (ULift.{u} (FiniteField.Extension F (ringChar F) R)) hU' p' (s 0)
    refine ⟨_, hw', ?_⟩
    have key := hiter s hs w' (Module.finrank F (ULift.{u} (FiniteField.Extension F (ringChar F) R)))
    rw [hsr, hER] at key
    exact key.symm

  obtain ⟨hfin, hcard⟩ := wc_top_twist_card_le F X d ℓ hℓ h n
  haveI := hfin
  obtain ⟨c₁, hc₁, hφ₁⟩ := hdeg (n₀ + 1) (by omega) (by omega)
  obtain ⟨c₂, hc₂, hφ₂⟩ := hdeg (n₀ + 2) (by omega) (by omega)

  have hord1 : ℓ ^ n ∣ addOrderOf c₁ := hc₁ _ (addOrderOf_nsmul_eq_zero c₁)
  have hord2 : ℓ ^ n ∣ addOrderOf c₂ := hc₂ _ (addOrderOf_nsmul_eq_zero c₂)
  have hopos := addOrderOf_pos c₁
  have hle : ℓ ^ n ≤ addOrderOf c₁ := Nat.le_of_dvd hopos hord1
  have hordle : addOrderOf c₁ ≤ ℓ ^ n :=
    (Nat.le_of_dvd Nat.card_pos (addOrderOf_dvd_natCard c₁)).trans hcard
  have hordeq : addOrderOf c₁ = ℓ ^ n := le_antisymm hordle hle
  have htop : AddSubgroup.zmultiples c₁ = ⊤ := by
    apply AddSubgroup.eq_top_of_le_card
    rw [Nat.card_zmultiples]
    exact hcard.trans hle
  have hmem : ∀ y, ∃ k : ℤ, k • c₁ = y := fun y =>
    AddSubgroup.mem_zmultiples_iff.mp (by rw [htop]; exact AddSubgroup.mem_top y)

  obtain ⟨u, hu⟩ := hmem (φ c₁)
  have hφu : ∀ y, φ y = u • y := by
    intro y
    obtain ⟨k, rfl⟩ := hmem y
    rw [map_zsmul, ← hu, smul_comm]
  have hφit : ∀ (j : ℕ) y, (⇑φ)^[j] y = (u ^ j) • y := by
    intro j
    induction j with
    | zero => intro y; simp
    | succ j ih =>
      intro y
      rw [Function.iterate_succ_apply', ih, hφu, smul_smul, pow_succ']

  have hdiv : ∀ (c : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcRootTwist X.left (ℓ ^ n) d) (2 * d)) (j : ℕ), ℓ ^ n ∣ addOrderOf c →
      (⇑φ)^[j] c = c → ((ℓ ^ n : ℕ) : ℤ) ∣ u ^ j - 1 := by
    intro c j hc hcj
    rw [hφit] at hcj
    have h0 : (u ^ j - 1) • c = 0 := by rw [sub_smul, one_smul, hcj, sub_self]
    exact (Int.natCast_dvd_natCast.mpr hc).trans (addOrderOf_dvd_iff_zsmul_eq_zero.mpr h0)
  have hd1 := hdiv c₁ (n₀ + 1) hord1 hφ₁
  have hd2 := hdiv c₂ (n₀ + 2) hord2 hφ₂
  have hu1 : ((ℓ ^ n : ℕ) : ℤ) ∣ u - 1 := by
    have e : u - 1 = (u ^ (n₀ + 2) - 1) - u * (u ^ (n₀ + 1) - 1) := by ring
    rw [e]
    exact dvd_sub hd2 (dvd_mul_of_dvd_right hd1 u)

  have hφc : φ c₁ = c₁ := by
    have h0 : (u - 1) • c₁ = 0 :=
      addOrderOf_dvd_iff_zsmul_eq_zero.mp (by rw [hordeq]; exact hu1)
    rw [sub_smul, one_smul, sub_eq_zero] at h0
    rw [hφu, h0]
  have hφid : ∀ y, φ y = y := by
    intro y
    obtain ⟨k, rfl⟩ := hmem y
    rw [map_zsmul, hφc]

  let π : wcGeomPoint F X h ⟶ Scheme.ProEt.mk (𝟙 X.left) :=
    MorphismProperty.Over.homMk (wcGeomPoint F X h).hom (Category.comp_id _) trivial
  have hU := hWE E
  obtain ⟨s, N, hs, hsr, hN⟩ := wc_finite_ext_transfer F X h E hU
  obtain ⟨wE, hwE⟩ := wc_rational_point_class F X d ℓ hℓ h n E hU p (s 0)
  refine ⟨π, (Abelian.Ext.mk₀ N).comp wE (zero_add (2 * d)), ?_⟩
  have hsum : ∀ m : ℕ, (Abelian.Ext.mk₀ (∑ j ∈ Finset.range m, wcFreeSheafMap X.left (s j))).comp
      wE (zero_add (2 * d)) = ∑ j ∈ Finset.range m,
        (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (s j))).comp wE (zero_add (2 * d)) := by
    intro m
    induction m with
    | zero => rw [Finset.sum_range_zero, Finset.sum_range_zero, Abelian.Ext.mk₀_zero,
        Abelian.Ext.zero_comp]
    | succ m ih => rw [Finset.sum_range_succ, Finset.sum_range_succ, Abelian.Ext.mk₀_add,
        Abelian.Ext.add_comp, ih]
  have key : (Abelian.Ext.mk₀ (wcFreeSheafMap X.left π)).comp
      ((Abelian.Ext.mk₀ N).comp wE (zero_add (2 * d))) (zero_add (2 * d)) =
      Module.finrank F E • (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (s 0))).comp wE
        (zero_add (2 * d)) := by
    rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (wcFreeSheafMap X.left π))
      (Abelian.Ext.mk₀ N) wE (zero_add 0) (zero_add (2 * d)) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hN π, hsum]
    rw [Finset.sum_congr rfl (fun j _ => (hiter s hs wE j).trans
      (Function.iterate_fixed (hφid _) j)), Finset.sum_const, Finset.card_range]
  intro k hk
  rw [key, smul_smul] at hk
  have hdvd := hwE _ hk
  have hcop : Nat.Coprime (ℓ ^ n) (Module.finrank F E) :=
    Nat.Coprime.pow_left n ((Nat.Prime.coprime_iff_not_dvd (Fact.out : Nat.Prime ℓ)).mpr hE)
  exact hcop.dvd_of_dvd_mul_right hdvd

theorem wc_top_twist_invariant (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n : ℕ) (z : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcRootTwist X.left (ℓ ^ n) d) (2 * d)) :
    (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h))).comp z (zero_add (2 * d)) = z :=
by
  classical

  have hℓ2 : 2 ≤ ℓ := (Fact.out : Nat.Prime ℓ).two_le
  obtain ⟨n₀, hn₀⟩ := lang_weil_asymptotic F X d (1 / 2) (by norm_num)
  have hrn : n₀ ≤ ℓ * n₀ + 1 := by nlinarith
  have hrℓ : ¬ ℓ ∣ ℓ * n₀ + 1 := by
    intro hd
    have h1 : ℓ ∣ 1 := (Nat.dvd_add_right (dvd_mul_right ℓ n₀)).mp hd
    have := Nat.le_of_dvd one_pos h1
    omega
  haveI : Fact (Nat.Prime (ringChar F)) := ⟨CharP.char_is_prime F (ringChar F)⟩
  haveI : NeZero (ℓ * n₀ + 1) := ⟨by omega⟩
  haveI : FiniteDimensional F (ULift.{u} (FiniteField.Extension F (ringChar F) (ℓ * n₀ + 1))) :=
    Module.Finite.equiv (ULift.moduleEquiv (R := F)).symm
  have hE : Module.finrank F (ULift.{u} (FiniteField.Extension F (ringChar F) (ℓ * n₀ + 1))) =
      ℓ * n₀ + 1 := by
    rw [LinearEquiv.finrank_eq (ULift.moduleEquiv (R := F))]
    exact FiniteField.finrank_extension F (ringChar F) (ℓ * n₀ + 1)
  have h1 := hn₀ (ULift.{u} (FiniteField.Extension F (ringChar F) (ℓ * n₀ + 1)))
    (by rw [hE]; exact hrn)
  have hpos : 0 < Nat.card (Over.mk (Spec.map (CommRingCat.ofHom (algebraMap F
      (ULift.{u} (FiniteField.Extension F (ringChar F) (ℓ * n₀ + 1)))))) ⟶ X) := by
    rcases Nat.eq_zero_or_pos (Nat.card (Over.mk (Spec.map (CommRingCat.ofHom (algebraMap F
      (ULift.{u} (FiniteField.Extension F (ringChar F) (ℓ * n₀ + 1)))))) ⟶ X)) with h0 | h0
    · rw [h0] at h1
      norm_num at h1
    · exact h0
  obtain ⟨p⟩ := (Nat.card_pos_iff.mp hpos).1

  obtain ⟨π, w, hw⟩ := wc_top_twist_point_class F X d ℓ hℓ h n
    (ULift.{u} (FiniteField.Extension F (ringChar F) (ℓ * n₀ + 1))) (by rw [hE]; exact hrℓ) p
  obtain ⟨hfin, hcard⟩ := wc_top_twist_card_le F X d ℓ hℓ h n
  obtain ⟨z₀, hz₀⟩ : ∃ z₀ : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcRootTwist X.left (ℓ ^ n) d) (2 * d),
      z₀ = (Abelian.Ext.mk₀ (wcFreeSheafMap X.left π)).comp w (zero_add (2 * d)) := ⟨_, rfl⟩

  have hleft : ∀ f : wcGeomPoint F X h ⟶ Scheme.ProEt.mk (𝟙 X.left),
      f.left = (wcGeomPoint F X h).hom :=
    fun f => (Category.comp_id f.left).symm.trans (MorphismProperty.Over.w f)
  have hgπ : wcGeomFrob F X h ≫ π = π :=
    MorphismProperty.Over.Hom.ext ((hleft _).trans (hleft π).symm)

  have hfun : ∀ {A B C : X.left.ProEt} (a : A ⟶ B) (b : B ⟶ C),
      wcFreeSheafMap X.left a ≫ wcFreeSheafMap X.left b = wcFreeSheafMap X.left (a ≫ b) := by
    intro A B C a b
    have e : Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight (yoneda.map (a ≫ b))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
      first
        | rw [yoneda.map_comp, Functor.whiskerRight_comp]
        | (apply NatTrans.ext; funext V; simp [← Functor.map_comp])
    exact ((presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      (congrArg (presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map e)

  have hfix : (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h))).comp z₀
      (zero_add (2 * d)) = z₀ := by
    rw [hz₀, ← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h)))
      (Abelian.Ext.mk₀ (wcFreeSheafMap X.left π)) w (zero_add 0) (zero_add (2 * d)) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hfun, hgπ]

  haveI := hfin
  have hopos := addOrderOf_pos z₀
  have hdvd : ℓ ^ n ∣ addOrderOf z₀ := hw _ (by rw [← hz₀]; exact addOrderOf_nsmul_eq_zero z₀)
  have hle : ℓ ^ n ≤ addOrderOf z₀ := Nat.le_of_dvd hopos hdvd
  have htop : AddSubgroup.zmultiples z₀ = ⊤ := by
    apply AddSubgroup.eq_top_of_le_card
    rw [Nat.card_zmultiples]
    exact hcard.trans hle
  have hz : z ∈ AddSubgroup.zmultiples z₀ := by rw [htop]; exact AddSubgroup.mem_top z
  obtain ⟨k, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hz

  have hlin := map_zsmul ((Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h))).precomp
    (wcRootTwist X.left (ℓ ^ n) d) (zero_add (2 * d))) k z₀
  simp only [Abelian.Ext.precomp, Abelian.Ext.bilinearComp_apply_apply] at hlin
  rw [hlin, hfix]

theorem wc_top_coh_frob_torsion (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n : ℕ) (y : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (Limits.cokernel (wcIntScalar X.left ℓ ((ℓ : ℤ_[ℓ]) ^ n))) (2 * d)) :
    (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h))).comp y (zero_add (2 * d)) =
      (Nat.card F ^ d) • y :=
by
  obtain ⟨Θ, hinj, hΘ⟩ := wc_top_twist_compare F X ℓ hℓ h n d (2 * d)
  apply hinj
  rw [hΘ, wc_top_twist_invariant F X d ℓ hℓ h n (Θ y), map_nsmul]

theorem wc_top_coh_frob_eigenvector (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :
    ∃ x : wcCoh F X h ℓ (2 * d), x ≠ 0 ∧
      wcCohFrob F X h ℓ (2 * d) x = wcCohScalar F X h ℓ (2 * d) ((Nat.card F : ℚ_[ℓ]) ^ d) x :=
by
  classical
  obtain ⟨x₀, hx₀⟩ := wc_top_coh_nonzero F X d ℓ hℓ h
  obtain ⟨hσ1, hσmul, hσadd⟩ := wc_ladic_scalar_ring X.left ℓ
  obtain ⟨G, hG⟩ : ∃ G : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcFreeSheaf X.left (wcGeomPoint F X h)) 0,
      G = Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h)) := ⟨_, rfl⟩

  have hS : ∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ (2 * d)),
      wcCohScalar F X h ℓ (2 * d) c x =
        x.comp (Abelian.Ext.mk₀ (wcLadicScalar X.left ℓ c)) (add_zero (2 * d)) := by
    intro c x
    simp only [wcCohScalar, Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
      Abelian.Ext.bilinearComp_apply_apply]
  have hFr : ∀ x : wcCoh F X h ℓ (2 * d), wcCohFrob F X h ℓ (2 * d) x =
      G.comp x (zero_add (2 * d)) := by
    intro x
    rw [hG]
    simp only [wcCohFrob, Abelian.Ext.precomp, Abelian.Ext.bilinearComp_apply_apply]
  have htor : ∀ (n : ℕ) (y : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (Limits.cokernel (wcIntScalar X.left ℓ ((ℓ : ℤ_[ℓ]) ^ n))) (2 * d)),
      G.comp y (zero_add (2 * d)) = (Nat.card F ^ d) • y := by
    intro n y
    rw [hG]
    exact wc_top_coh_frob_torsion F X d ℓ hℓ h n y

  have hSadd : ∀ (a b : ℚ_[ℓ]) (x : wcCoh F X h ℓ (2 * d)),
      wcCohScalar F X h ℓ (2 * d) (a + b) x =
        wcCohScalar F X h ℓ (2 * d) a x + wcCohScalar F X h ℓ (2 * d) b x := by
    intro a b x
    rw [hS, hS, hS, hσadd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
  have hS1 : ∀ x : wcCoh F X h ℓ (2 * d), wcCohScalar F X h ℓ (2 * d) 1 x = x := by
    intro x
    rw [hS, hσ1, Abelian.Ext.comp_mk₀_id]
  have hS0 : ∀ x : wcCoh F X h ℓ (2 * d), wcCohScalar F X h ℓ (2 * d) 0 x = 0 := by
    intro x
    have h0 := hSadd 0 0 x
    rw [add_zero] at h0
    calc wcCohScalar F X h ℓ (2 * d) 0 x
        = (wcCohScalar F X h ℓ (2 * d) 0 x + wcCohScalar F X h ℓ (2 * d) 0 x) -
            wcCohScalar F X h ℓ (2 * d) 0 x := by abel
      _ = wcCohScalar F X h ℓ (2 * d) 0 x - wcCohScalar F X h ℓ (2 * d) 0 x := by rw [← h0]
      _ = 0 := sub_self _
  have hSnat : ∀ (k : ℕ) (x : wcCoh F X h ℓ (2 * d)),
      wcCohScalar F X h ℓ (2 * d) (k : ℚ_[ℓ]) x = k • x := by
    intro k x
    induction k with
    | zero => rw [Nat.cast_zero, hS0, zero_nsmul]
    | succ k ih => rw [Nat.cast_succ, hSadd, ih, hS1, succ_nsmul]
  have hSinv : ∀ (a : ℚ_[ℓ]), a ≠ 0 → ∀ w : wcCoh F X h ℓ (2 * d),
      wcCohScalar F X h ℓ (2 * d) a⁻¹ (wcCohScalar F X h ℓ (2 * d) a w) = w := by
    intro a ha w
    rw [hS, hS, Abelian.Ext.comp_assoc w (Abelian.Ext.mk₀ (wcLadicScalar X.left ℓ a))
      (Abelian.Ext.mk₀ (wcLadicScalar X.left ℓ a⁻¹)) (add_zero _) (add_zero _) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, ← hσmul, inv_mul_cancel₀ ha, hσ1, Abelian.Ext.comp_mk₀_id]
  have hcomm : ∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ (2 * d)),
      wcCohFrob F X h ℓ (2 * d) (wcCohScalar F X h ℓ (2 * d) c x) =
        wcCohScalar F X h ℓ (2 * d) c (wcCohFrob F X h ℓ (2 * d) x) := by
    intro c x
    rw [hFr, hS, hS, hFr]
    exact (Abelian.Ext.comp_assoc G x (Abelian.Ext.mk₀ (wcLadicScalar X.left ℓ c))
      (zero_add _) (add_zero _) (by omega)).symm

  have hmain : ∀ x : wcCoh F X h ℓ (2 * d),
      wcCohFrob F X h ℓ (2 * d) x = (Nat.card F ^ d) • x := by
    intro x
    obtain ⟨N, y, hy⟩ := wc_ladic_coh_bounded_denominators F X d ℓ hℓ h (2 * d) x
    have hz : G.comp y (zero_add (2 * d)) - (Nat.card F ^ d) • y = 0 := by
      apply wc_int_coh_separated F X d ℓ hℓ h (2 * d)
      intro n
      have e1 := (Abelian.Ext.postcomp
        (Abelian.Ext.mk₀ (Limits.cokernel.π (wcIntScalar X.left ℓ ((ℓ : ℤ_[ℓ]) ^ n))))
        (wcFreeSheaf X.left (wcGeomPoint F X h)) (add_zero (2 * d))).map_sub
        (G.comp y (zero_add (2 * d))) ((Nat.card F ^ d) • y)
      have e2 := (Abelian.Ext.postcomp
        (Abelian.Ext.mk₀ (Limits.cokernel.π (wcIntScalar X.left ℓ ((ℓ : ℤ_[ℓ]) ^ n))))
        (wcFreeSheaf X.left (wcGeomPoint F X h)) (add_zero (2 * d))).map_nsmul (Nat.card F ^ d) y
      simp only [Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
        Abelian.Ext.bilinearComp_apply_apply] at e1 e2
      rw [e1, e2, Abelian.Ext.comp_assoc G y
        (Abelian.Ext.mk₀ (Limits.cokernel.π (wcIntScalar X.left ℓ ((ℓ : ℤ_[ℓ]) ^ n))))
        (zero_add _) (add_zero _) (by omega), htor, sub_self]
    have hGy : G.comp y (zero_add (2 * d)) = (Nat.card F ^ d) • y := sub_eq_zero.mp hz
    have e3 := (Abelian.Ext.postcomp (Abelian.Ext.mk₀ (wcIntToLadic X.left ℓ))
        (wcFreeSheaf X.left (wcGeomPoint F X h)) (add_zero (2 * d))).map_nsmul (Nat.card F ^ d) y
    simp only [Abelian.Ext.postcomp, AddMonoidHom.flip_apply,
      Abelian.Ext.bilinearComp_apply_apply] at e3
    have hkey : wcCohScalar F X h ℓ (2 * d) ((ℓ : ℚ_[ℓ]) ^ N) (wcCohFrob F X h ℓ (2 * d) x) =
        wcCohScalar F X h ℓ (2 * d) ((ℓ : ℚ_[ℓ]) ^ N) ((Nat.card F ^ d) • x) := by
      rw [← hcomm, map_nsmul, hy, hFr,
        ← Abelian.Ext.comp_assoc G y (Abelian.Ext.mk₀ (wcIntToLadic X.left ℓ))
          (zero_add _) (add_zero _) (by omega), hGy, e3]
    have ha : ((ℓ : ℚ_[ℓ]) ^ N) ≠ 0 :=
      pow_ne_zero _ (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
    calc wcCohFrob F X h ℓ (2 * d) x
        = wcCohScalar F X h ℓ (2 * d) ((ℓ : ℚ_[ℓ]) ^ N)⁻¹
            (wcCohScalar F X h ℓ (2 * d) ((ℓ : ℚ_[ℓ]) ^ N) (wcCohFrob F X h ℓ (2 * d) x)) :=
          (hSinv _ ha _).symm
      _ = wcCohScalar F X h ℓ (2 * d) ((ℓ : ℚ_[ℓ]) ^ N)⁻¹
            (wcCohScalar F X h ℓ (2 * d) ((ℓ : ℚ_[ℓ]) ^ N) ((Nat.card F ^ d) • x)) := by
          rw [hkey]
      _ = (Nat.card F ^ d) • x := hSinv _ ha _
  refine ⟨x₀, hx₀, ?_⟩
  rw [hmain, ← Nat.cast_pow, hSnat]

theorem wc_top_coh_frobenius (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :
    (∃ e₁ : wcCoh F X h ℓ (2 * d) ≃+ (Fin 1 → ℚ_[ℓ]),
      ∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ (2 * d)),
        e₁ (wcCohScalar F X h ℓ (2 * d) c x) = c • e₁ x) ∧
    ∀ x : wcCoh F X h ℓ (2 * d),
      wcCohFrob F X h ℓ (2 * d) x = wcCohScalar F X h ℓ (2 * d) ((Nat.card F : ℚ_[ℓ]) ^ d) x :=
by
  classical
  obtain ⟨η, hηs, hηinj⟩ := wc_top_coh_trace_injective F X d ℓ hℓ h
  obtain ⟨x₀, hx₀, hFx₀⟩ := wc_top_coh_frob_eigenvector F X d ℓ hℓ h

  have hcomm : ∀ (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ (2 * d)),
      wcCohFrob F X h ℓ (2 * d) (wcCohScalar F X h ℓ (2 * d) c x) =
        wcCohScalar F X h ℓ (2 * d) c (wcCohFrob F X h ℓ (2 * d) x) := by
    intro c x
    simp only [wcCohFrob, wcCohScalar, Abelian.Ext.precomp, Abelian.Ext.postcomp,
      AddMonoidHom.flip_apply, Abelian.Ext.bilinearComp_apply_apply]
    exact (Abelian.Ext.comp_assoc _ _ _ _ _ (by omega)).symm
  have ha₀ne : η x₀ ≠ 0 := by
    intro h0
    apply hx₀
    apply hηinj
    rw [map_zero]
    exact h0
  have hspan : ∀ y, y = wcCohScalar F X h ℓ (2 * d) (η y / η x₀) x₀ := by
    intro y
    apply hηinj
    rw [hηs, div_mul_cancel₀ _ ha₀ne]
  have hsurj : Function.Surjective η := fun a =>
    ⟨wcCohScalar F X h ℓ (2 * d) (a / η x₀) x₀, by rw [hηs, div_mul_cancel₀ _ ha₀ne]⟩
  refine ⟨⟨(AddEquiv.ofBijective η ⟨hηinj, hsurj⟩).trans
    (AddEquiv.funUnique (Fin 1) ℚ_[ℓ]).symm, ?_⟩, ?_⟩
  · intro c x
    funext t
    simp [AddEquiv.funUnique_symm_apply, hηs]
    exact hηs c x
  · intro y
    obtain ⟨b, hb⟩ : ∃ b, y = wcCohScalar F X h ℓ (2 * d) b x₀ := ⟨_, hspan y⟩
    subst hb
    apply hηinj
    simp only [hcomm, hηs, hFx₀]
    ring

theorem wc_modcoh_hm_cup_iso (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ Θ : ∀ n : ℕ, wcModCoh F X h ℓ n ≃+ wcHM (wcXbar F X) ℓ n,
      ∀ (i j k : ℕ) (hk : i + j = k) (x : wcModCoh F X h ℓ i) (y : wcModCoh F X h ℓ j),
        Θ k (wcModCup F X h ℓ i j k hk x y) = wcHMCup (wcXbar F X) ℓ i j k hk (Θ i x) (Θ j y) :=
by


  have hmem : ∀ (T : Scheme.{u}) (V : T.ProEt) (R : Sieve V),
      R ∈ Scheme.ProEt.topology T V ↔
        Sieve.functorPushforward (Scheme.ProEt.forget T ⋙ Over.forget T) R ∈
          Scheme.proetaleTopology V.left := by
    intro T V R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have hT : Scheme.ProEt.topology T =
        (Scheme.ProEt.forget T).restrictedTopology (Scheme.proetaleTopology.over T) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := T)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [hT, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl
  let S := X.left
  let U := wcGeomPoint F X h
  let εapp : ∀ V : Over U, (wcOverToSlice S U ⋙ wcSliceToOver S U).obj V ≅ V := fun V =>
    Over.isoMk (MorphismProperty.Over.isoMk (Iso.refl V.left.left)
        ((Category.id_comp _).trans (MorphismProperty.Over.w V.hom).symm))
      (MorphismProperty.Over.Hom.ext (Category.id_comp V.hom.left))
  let ε : wcOverToSlice S U ⋙ wcSliceToOver S U ≅ 𝟭 (Over U) :=
    NatIso.ofComponents εapp (fun {V V'} g => by
      apply Over.OverMorphism.ext
      apply MorphismProperty.Over.Hom.ext
      exact (Category.comp_id g.left.left).trans (Category.id_comp g.left.left).symm)
  have hmemD : ∀ (V : Over U) (R : Sieve V), R ∈ (Scheme.ProEt.topology S).over U V ↔
      Sieve.functorPushforward (Over.forget U ⋙ Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
        Scheme.proetaleTopology V.left.left := by
    intro V R
    rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_apply, hmem S V.left,
      ← Sieve.functorPushforward_comp]
  have hFc : (wcSliceToOver S U).IsCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) := by
    constructor
    intro W T hT
    rw [hmem U.left W]
    rw [hmemD] at hT
    refine GrothendieckTopology.superset_covering _ ?_ hT
    rintro Z f ⟨V', t, a, ht, rfl⟩
    refine ⟨(wcOverToSlice S U).obj V', (wcOverToSlice S U).map t, a, ?_, rfl⟩
    show T.arrows ((wcSliceToOver S U).map ((wcOverToSlice S U).map t))
    have hft : (wcSliceToOver S U).map ((wcOverToSlice S U).map t) = (εapp V').hom ≫ t := by
      apply Over.OverMorphism.ext
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp t.left.left).symm
    exact (congrArg (fun g => T.arrows g) hft).mpr (T.downward_closed ht _)
  have hGc : (wcOverToSlice S U).IsCocontinuous ((Scheme.ProEt.topology S).over U)
      (Scheme.ProEt.topology U.left) := by
    constructor
    intro V T hT
    rw [hmemD]
    rw [hmem U.left] at hT
    refine GrothendieckTopology.superset_covering _ ?_ hT
    rintro Z f ⟨W', t, a, ht, rfl⟩
    refine ⟨(wcSliceToOver S U).obj W', (wcSliceToOver S U).map t ≫ (εapp V).hom, a, ?_, ?_⟩
    · show T.arrows ((wcOverToSlice S U).map ((wcSliceToOver S U).map t ≫ (εapp V).hom))
      have hgt : (wcOverToSlice S U).map ((wcSliceToOver S U).map t ≫ (εapp V).hom) = t := by
        apply MorphismProperty.Over.Hom.ext
        exact Category.comp_id t.left
      exact (congrArg (fun g => T.arrows g) hgt).mpr ht
    · exact (congrArg (a ≫ ·) (Category.comp_id t.left)).symm
  let eqv : U.left.ProEt ≌ Over U :=
    Equivalence.mk' (wcSliceToOver S U) (wcOverToSlice S U) (Iso.refl _) ε (fun W => by
      apply Over.OverMorphism.ext
      apply MorphismProperty.Over.Hom.ext
      exact Category.comp_id (𝟙 W.left))
  haveI : eqv.functor.IsCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) := hFc
  haveI : eqv.inverse.IsCocontinuous ((Scheme.ProEt.topology S).over U)
      (Scheme.ProEt.topology U.left) := hGc
  haveI := Equivalence.isDenseSubsite_functor_of_isCocontinuous (Scheme.ProEt.topology U.left)
    ((Scheme.ProEt.topology S).over U) eqv
  haveI := Equivalence.isDenseSubsite_inverse_of_isCocontinuous (Scheme.ProEt.topology U.left)
    ((Scheme.ProEt.topology S).over U) eqv
  haveI : eqv.functor.IsContinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) := inferInstance
  haveI : eqv.inverse.IsContinuous ((Scheme.ProEt.topology S).over U)
      (Scheme.ProEt.topology U.left) := inferInstance

  let E : SheafOfModules.{u+1} (wcSliceRing F X h ℓ) ≌
      SheafOfModules.{u+1} (wcRingSheaf (wcGeomPoint F X h).left ℓ) :=
    SheafOfModules.pushforwardPushforwardEquivalence eqv
    (S := wcRingSheaf (wcGeomPoint F X h).left ℓ) (R := wcSliceRing F X h ℓ) (𝟙 _) (𝟙 _) rfl rfl
  letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F X h ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcGeomPoint F X h).left ℓ)) := HasExt.standard _
  haveI : E.functor.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint _
  haveI : E.functor.Additive := Functor.additive_of_preserves_binary_products _
  haveI : E.inverse.Additive := E.inverse_additive

  let adj : E.inverse ⊣ E.functor := E.symm.toAdjunction
  let θ : E.inverse.obj (E.functor.obj (SheafOfModules.unit (wcSliceRing F X h ℓ))) ≅
      SheafOfModules.unit (wcSliceRing F X h ℓ) :=
    (E.unitIso.app (SheafOfModules.unit (wcSliceRing F X h ℓ))).symm
  have hc : adj.unit.app (E.functor.obj (SheafOfModules.unit (wcSliceRing F X h ℓ))) ≫
      E.functor.map θ.hom = 𝟙 _ := by
    simp [adj, θ]
  have hb : ∀ n : ℕ, Function.Bijective
      (E.functor.mapExtAddHom (SheafOfModules.unit (wcSliceRing F X h ℓ))
        (SheafOfModules.unit (wcSliceRing F X h ℓ)) n) := by
    intro n
    let P : Abelian.Ext (SheafOfModules.unit (wcSliceRing F X h ℓ))
        (SheafOfModules.unit (wcSliceRing F X h ℓ)) n ≃+
        Abelian.Ext (E.inverse.obj (E.functor.obj (SheafOfModules.unit (wcSliceRing F X h ℓ))))
          (SheafOfModules.unit (wcSliceRing F X h ℓ)) n :=
      { toFun := fun x => (Abelian.Ext.mk₀ θ.hom).comp x (zero_add n)
        invFun := fun y => (Abelian.Ext.mk₀ θ.inv).comp y (zero_add n)
        left_inv := fun x => by
          simp only
          rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
        right_inv := fun y => by
          simp only
          rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
        map_add' := fun x y => Abelian.Ext.comp_add _ _ _ _ }
    have hΨ : ∀ β : Abelian.Ext (SheafOfModules.unit (wcSliceRing F X h ℓ))
        (SheafOfModules.unit (wcSliceRing F X h ℓ)) n,
        adj.extEquiv (P β) = Abelian.Ext.mapExactFunctor E.functor β := by
      intro β
      show adj.extEquiv ((Abelian.Ext.mk₀ θ.hom).comp β (zero_add n)) = _
      rw [Adjunction.extEquiv_apply, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀_assoc, hc,
        Abelian.Ext.mk₀_id_comp]
    have hcomp := (adj.extEquiv (n := n)).bijective.comp P.bijective
    convert hcomp using 1
    funext β
    rw [Functor.mapExtAddHom_apply]
    exact (hΨ β).symm
  refine ⟨fun n => (AddEquiv.ofBijective _ (hb n) :
      wcModCoh F X h ℓ n ≃+ wcHM (wcXbar F X) ℓ n), fun i j k hk x y => ?_⟩
  show E.functor.mapExtAddHom _ _ k (wcModCup F X h ℓ i j k hk x y) =
    wcHMCup (wcXbar F X) ℓ i j k hk (E.functor.mapExtAddHom _ _ i x)
      (E.functor.mapExtAddHom _ _ j y)
  simp only [wcModCup, wcHMCup, Abelian.Ext.bilinearComp_apply_apply, Functor.mapExtAddHom_apply]
  exact Abelian.Ext.mapExactFunctor_comp _ x y hk

theorem wc_pairing_right_dual {V W : Type*} [AddCommGroup V] [AddCommGroup W] {K : Type*} [Field K]
    {r r' : ℕ} (sV : K → V →+ V) (sW : K → W →+ W)
    (eV : V ≃+ (Fin r → K)) (eW : W ≃+ (Fin r' → K))
    (heV : ∀ (c : K) (x : V), eV (sV c x) = c • eV x) (heW : ∀ (c : K) (y : W), eW (sW c y) = c • eW y)
    (B : V →+ W →+ K) (hBl : ∀ (c : K) (x : V) (y : W), B (sV c x) y = c * B x y)
    (hBr : ∀ (c : K) (x : V) (y : W), B x (sW c y) = c * B x y)
    (hl : ∀ x : V, (∀ y : W, B x y = 0) → x = 0) (hr : ∀ y : W, (∀ x : V, B x y = 0) → y = 0)
    (k : Fin r) : ∃ w : W, ∀ x : V, B x w = eV x k :=
by
  classical
  have hsV : ∀ (c : K) (u : Fin r → K), eV.symm (c • u) = sV c (eV.symm u) := fun c u =>
    eV.injective (by rw [heV, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  have hsW : ∀ (c : K) (v : Fin r' → K), eW.symm (c • v) = sW c (eW.symm v) := fun c v =>
    eW.injective (by rw [heW, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  let β : (Fin r → K) →ₗ[K] (Fin r' → K) →ₗ[K] K :=
    LinearMap.mk₂ K (fun u v => B (eV.symm u) (eW.symm v))
      (fun u₁ u₂ v => by simp only [map_add, AddMonoidHom.add_apply])
      (fun c u v => by simp only [hsV, hBl, smul_eq_mul])
      (fun u v₁ v₂ => by simp only [map_add])
      (fun c u v => by simp only [hsW, hBr, smul_eq_mul])
  have hβ : ∀ u v, β u v = B (eV.symm u) (eW.symm v) := fun u v => rfl
  have hinj : Function.Injective β := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro u hu
    have h1 : eV.symm u = 0 := hl _ (fun y => by
      have h2 := LinearMap.congr_fun hu (eW y)
      rw [hβ, AddEquiv.symm_apply_apply] at h2
      simpa using h2)
    simpa using congrArg eV h1
  have hinj' : Function.Injective β.flip := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro v hv
    have h1 : eW.symm v = 0 := hr _ (fun x => by
      have h2 := LinearMap.congr_fun hv (eV x)
      rw [LinearMap.flip_apply, hβ, AddEquiv.symm_apply_apply] at h2
      simpa using h2)
    simpa using congrArg eW h1
  have : β.IsPerfPair := LinearMap.IsPerfPair.of_injective hinj hinj'
  obtain ⟨v, hv⟩ := (LinearMap.IsPerfPair.bijective_right (p := β)).2 (LinearMap.proj k)
  refine ⟨eW.symm v, fun x => ?_⟩
  have h3 := LinearMap.congr_fun hv (eV x)
  rw [LinearMap.flip_apply, hβ, AddEquiv.symm_apply_apply, LinearMap.proj_apply] at h3
  exact h3

theorem wc_hm_pull_comp {S S' S'' : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (f : S' ⟶ S) (g : S'' ⟶ S') (k : S'' ⟶ S) (hk : g ≫ f = k)
    (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg)
    (Dk : wcHMPullData k ℓ) (hDk : wcHMPullCanonical Dk) (n : ℕ) (x : wcHM S ℓ n) :
    wcHMPull Dk n x = wcHMPull Dg n (wcHMPull Df n x) :=
by
  classical
  subst hk

  have hmap : ∀ {A B : Scheme.{u}} (h : A ⟶ B) {V V' : B.ProEt} (u : V ⟶ V'),
      ((wcProEtBC h).map u).left ≫ Limits.pullback.fst V'.hom h =
        Limits.pullback.fst V.hom h ≫ u.left ∧
      ((wcProEtBC h).map u).left ≫ Limits.pullback.snd V'.hom h = Limits.pullback.snd V.hom h := by
    intro A B h V V' u
    exact ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hsnd : ∀ V : S.ProEt, (Limits.pullbackLeftPullbackSndIso V.hom f g).symm.hom ≫
      Limits.pullback.snd (Limits.pullback.snd V.hom f) g = Limits.pullback.snd V.hom (g ≫ f) := by
    intro V
    rw [Iso.symm_hom, Iso.inv_comp_eq, Limits.pullbackLeftPullbackSndIso_hom_snd]
  choose c hc using fun V : S.ProEt =>
    (⟨MorphismProperty.Over.isoMk (A := (wcProEtBC (g ≫ f)).obj V)
        (B := (wcProEtBC f ⋙ wcProEtBC g).obj V)
        (Limits.pullbackLeftPullbackSndIso V.hom f g).symm (hsnd V),
      MorphismProperty.Over.isoMk_hom_left _ _⟩ :
      ∃ c : (wcProEtBC (g ≫ f)).obj V ≅ (wcProEtBC f ⋙ wcProEtBC g).obj V,
        c.hom.left = (Limits.pullbackLeftPullbackSndIso V.hom f g).inv)
  have nat : ∀ {V V' : S.ProEt} (u : V ⟶ V'),
      (wcProEtBC (g ≫ f)).map u ≫ (c V').hom = (c V).hom ≫ (wcProEtBC f ⋙ wcProEtBC g).map u := by
    intro V V' u
    have key : ∀ (L : Limits.pullback V.hom (g ≫ f) ⟶ Limits.pullback V'.hom (g ≫ f))
        (M1 : Limits.pullback V.hom f ⟶ Limits.pullback V'.hom f)
        (M2 : Limits.pullback (Limits.pullback.snd V.hom f) g ⟶
          Limits.pullback (Limits.pullback.snd V'.hom f) g),
        L ≫ Limits.pullback.fst V'.hom (g ≫ f) = Limits.pullback.fst V.hom (g ≫ f) ≫ u.left →
        L ≫ Limits.pullback.snd V'.hom (g ≫ f) = Limits.pullback.snd V.hom (g ≫ f) →
        M1 ≫ Limits.pullback.fst V'.hom f = Limits.pullback.fst V.hom f ≫ u.left →
        M1 ≫ Limits.pullback.snd V'.hom f = Limits.pullback.snd V.hom f →
        M2 ≫ Limits.pullback.fst (Limits.pullback.snd V'.hom f) g =
          Limits.pullback.fst (Limits.pullback.snd V.hom f) g ≫ M1 →
        M2 ≫ Limits.pullback.snd (Limits.pullback.snd V'.hom f) g =
          Limits.pullback.snd (Limits.pullback.snd V.hom f) g →
        L ≫ (Limits.pullbackLeftPullbackSndIso V'.hom f g).inv =
          (Limits.pullbackLeftPullbackSndIso V.hom f g).inv ≫ M2 := by
      intro L M1 M2 hL1 hL2 hM1 _ hM2 hM2'
      rw [Iso.comp_inv_eq, Category.assoc, Iso.eq_inv_comp]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hL1, Category.assoc, Limits.pullbackLeftPullbackSndIso_hom_fst,
          reassoc_of% hM2, hM1, reassoc_of% (Limits.pullbackLeftPullbackSndIso_hom_fst V.hom f g)]
      · rw [Category.assoc, hL2, Limits.pullbackLeftPullbackSndIso_hom_snd, Category.assoc,
          Limits.pullbackLeftPullbackSndIso_hom_snd, hM2']
    apply MorphismProperty.Over.Hom.ext
    change ((wcProEtBC (g ≫ f)).map u).left ≫ (c V').hom.left =
      (c V).hom.left ≫ ((wcProEtBC g).map ((wcProEtBC f).map u)).left
    rw [hc V, hc V']
    exact key _ _ _ (hmap (g ≫ f) u).1 (hmap (g ≫ f) u).2 (hmap f u).1 (hmap f u).2
      (hmap g ((wcProEtBC f).map u)).1 (hmap g ((wcProEtBC f).map u)).2
  let α : wcProEtBC (g ≫ f) ≅ wcProEtBC f ⋙ wcProEtBC g := NatIso.ofComponents c nat
  have hα : ∀ (V : S.ProEt) (z : ↥((wcProEtBC (g ≫ f)).obj V).left),
      (Limits.pullback.fst V.hom f) ((Limits.pullback.fst (Limits.pullback.snd V.hom f) g)
        ((α.hom.app V).left z)) = (Limits.pullback.fst V.hom (g ≫ f)) z := by
    intro V z
    change (Limits.pullback.fst V.hom f) ((Limits.pullback.fst (Limits.pullback.snd V.hom f) g)
      ((c V).hom.left z)) = _
    rw [hc V]
    have key : ∀ z' : ↥(Limits.pullback V.hom (g ≫ f)),
        (Limits.pullback.fst V.hom f) ((Limits.pullback.fst (Limits.pullback.snd V.hom f) g)
          ((Limits.pullbackLeftPullbackSndIso V.hom f g).inv z')) =
        (Limits.pullback.fst V.hom (g ≫ f)) z' := by
      intro z'
      calc (Limits.pullback.fst V.hom f) ((Limits.pullback.fst (Limits.pullback.snd V.hom f) g)
            ((Limits.pullbackLeftPullbackSndIso V.hom f g).inv z'))
          = ((Limits.pullbackLeftPullbackSndIso V.hom f g).inv ≫
              Limits.pullback.fst (Limits.pullback.snd V.hom f) g ≫
                Limits.pullback.fst V.hom f) z' := rfl
        _ = (Limits.pullback.fst V.hom (g ≫ f)) z' := by
          rw [Limits.pullbackLeftPullbackSndIso_inv_fst]
    exact key z

  haveI := Df.cont
  haveI := Dg.cont
  haveI := Dk.cont
  haveI : (wcProEtBC f ⋙ wcProEtBC g).IsContinuous (Scheme.ProEt.topology S)
      (Scheme.ProEt.topology S'') :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S') _
  let τ := (Functor.sheafPushforwardContinuousNatTrans α.hom RingCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology S'')).app (wcRingSheaf S'' ℓ)
  let φfg : wcRingSheaf S ℓ ⟶ ((wcProEtBC f ⋙ wcProEtBC g).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.ProEt.topology S) (Scheme.ProEt.topology S'')).obj (wcRingSheaf S'' ℓ) :=
    Df.φ ≫ ((wcProEtBC f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).map Dg.φ
  have hcompat : φfg ≫ τ = Dk.φ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    induction V using Opposite.rec with
    | op V =>
    apply RingCat.hom_ext
    apply RingHom.ext
    intro s
    rw [hDk V s]
    apply ContinuousMap.ext
    intro z
    refine (congrArg (fun h : C(↥(Limits.pullback (Limits.pullback.snd V.hom f) g),
        ULift.{u+1} ℚ_[ℓ]) => h ((α.hom.app V).left.base z))
      (hDg ((wcProEtBC f).obj V) ((Df.φ.hom.app (Opposite.op V)).hom s :
        C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ])))).trans ?_
    refine (congrArg (fun h : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ]) =>
        h ((Limits.pullback.fst (Limits.pullback.snd V.hom f) g).base
          ((α.hom.app V).left.base z))) (hDf V s)).trans ?_
    let s' : C(↥V.left, ULift.{u+1} ℚ_[ℓ]) := s
    exact congrArg (fun p => s' p) (hα V z)
  let ι : SheafOfModules.pushforward Dg.φ ⋙ SheafOfModules.pushforward Df.φ ≅
      SheafOfModules.pushforward Dk.φ :=
    SheafOfModules.pushforwardComp Df.φ Dg.φ ≪≫
      SheafOfModules.pushforwardNatIso φfg α ≪≫ SheafOfModules.pushforwardCongr hcompat
  have θ : Dk.Φ ≅ Df.Φ ⋙ Dg.Φ := Dk.adj.leftAdjointUniq ((Df.adj.comp Dg.adj).ofNatIsoRight ι)

  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S'' ℓ)) := HasExt.standard _
  haveI := Df.additive
  haveI := Df.presLim
  haveI := Df.presColim
  haveI := Dg.additive
  haveI := Dg.presLim
  haveI := Dg.presColim
  haveI := Dk.additive
  haveI := Dk.presLim
  haveI := Dk.presColim
  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf S'' ℓ)} {a : ℕ}
      (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A B C' D' a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf S'' ℓ)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf S'' ℓ)} {a : ℕ}
      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _

  have central : ∀ (e : SheafOfModules.unit (wcRingSheaf S'' ℓ) ⟶
      SheafOfModules.unit (wcRingSheaf S'' ℓ)) (y : wcHM S'' ℓ n),
      (Abelian.Ext.mk₀ e).comp y (zero_add n) = y.comp (Abelian.Ext.mk₀ e) (add_zero n) := by
    intro e y
    have hcomm : ∀ (X : (S''.ProEt)ᵒᵖ) (a b : (wcRingSheaf S'' ℓ).obj.obj X), a * b = b * a := by
      intro X a b
      exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) _ a b
    have hext : ∃ m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf S'' ℓ)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcRingSheaf S'' ℓ)),
        m.app (SheafOfModules.unit (wcRingSheaf S'' ℓ)) = e := by
      let R := wcRingSheaf S'' ℓ
      let s := (SheafOfModules.unit R).unitHomEquiv e
      let σ : ∀ X : (S''.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
      have hσ : ∀ {X Y : (S''.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
        fun f => PresheafOfModules.sections_property s f
      let L : ∀ (M : SheafOfModules.{u+1} R) (X : (S''.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
        fun M X => ModuleCat.ofHom
          { toFun := fun x => σ X • x
            map_add' := fun x y => smul_add _ _ _
            map_smul' := fun r x => by
              simp only [RingHom.id_apply, smul_smul]
              rw [hcomm X] }
      let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
        ⟨PresheafOfModules.Hom.mk (L M) (by
          intro X Y f
          ext x
          show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
          rw [PresheafOfModules.map_smul, hσ])⟩
      refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
      · intro M N g
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro X
        ext x
        show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
        exact ((g.val.app X).hom.map_smul _ _).symm
      · apply (SheafOfModules.unit R).unitHomEquiv.injective
        apply PresheafOfModules.sections_ext
        intro X
        rw [SheafOfModules.unitHomEquiv_apply_coe]
        show σ X • (1 : R.obj.obj X) = s.1 X
        rw [smul_eq_mul, mul_one]
    have hcen : ∀ (m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf S'' ℓ)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcRingSheaf S'' ℓ))) (z : wcHM S'' ℓ n),
        (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcRingSheaf S'' ℓ)))).comp z (zero_add n) =
          z.comp (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcRingSheaf S'' ℓ)))) (add_zero n) := by
      intro m z
      have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
      simp only [Abelian.Ext.id_mapExactFunctor] at h
      exact h.symm
    obtain ⟨m, hm⟩ := hext
    subst hm
    exact hcen m y
  have gen : ∀ {Y : SheafOfModules.{u+1} (wcRingSheaf S'' ℓ)} (y : Abelian.Ext Y Y n)
      (a a' : SheafOfModules.unit (wcRingSheaf S'' ℓ) ⟶ Y)
      (b b' : Y ⟶ SheafOfModules.unit (wcRingSheaf S'' ℓ)),
      a ≫ b = 𝟙 _ → b' ≫ a' = 𝟙 _ →
      (Abelian.Ext.mk₀ a).comp (y.comp (Abelian.Ext.mk₀ b) (add_zero n)) (zero_add n) =
        (Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (add_zero n)) (zero_add n) := by
    intro Y y a a' b b' hab hba
    have ea : (a ≫ b') ≫ a' = a := by rw [Category.assoc, hba, Category.comp_id]
    have eb : b' ≫ a' ≫ b = b := by rw [← Category.assoc, hba, Category.id_comp]
    have eE : (a ≫ b') ≫ (a' ≫ b) = 𝟙 _ := by rw [← Category.assoc, ea, hab]
    have hc : (Abelian.Ext.mk₀ (a ≫ b')).comp ((Abelian.Ext.mk₀ a').comp
          (y.comp (Abelian.Ext.mk₀ b') (add_zero n)) (zero_add n)) (zero_add n) =
        ((Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (add_zero n)) (zero_add n)).comp
          (Abelian.Ext.mk₀ (a ≫ b')) (add_zero n) :=
      central _ _
    have e1 : (Abelian.Ext.mk₀ a).comp (y.comp (Abelian.Ext.mk₀ b) (add_zero n)) (zero_add n) =
        ((Abelian.Ext.mk₀ (a ≫ b')).comp ((Abelian.Ext.mk₀ a').comp
          (y.comp (Abelian.Ext.mk₀ b') (add_zero n)) (zero_add n)) (zero_add n)).comp
          (Abelian.Ext.mk₀ (a' ≫ b)) (add_zero n) := by
      rw [h2, h4, h3, ea, eb]
    rw [e1, hc, h3, eE, Abelian.Ext.comp_mk₀_id]
  show (Abelian.Ext.mk₀ Dk.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dk.Φ x).comp
      (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero n)) (zero_add n) =
    (Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ
      ((Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ x).comp
        (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n)) (zero_add n))).comp
      (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero n)) (zero_add n)
  have nat' : (Abelian.Ext.mapExactFunctor Dk.Φ x).comp
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcRingSheaf S ℓ)))) (add_zero n) =
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcRingSheaf S ℓ)))).comp
        (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Dg.Φ) x) (zero_add n) :=
    Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x θ.hom
  have step1 : (Abelian.Ext.mapExactFunctor Dk.Φ x).comp (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero n) =
      ((Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcRingSheaf S ℓ)))).comp
        (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Dg.Φ) x) (zero_add n)).comp
        (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcRingSheaf S ℓ)) ≫ Dk.μ.hom))
        (add_zero n) := by
    rw [← nat', h3, Iso.hom_inv_id_app_assoc]
  have hL : (Abelian.Ext.mk₀ Dk.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dk.Φ x).comp
      (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero n)) (zero_add n) =
      (Abelian.Ext.mk₀ (Dk.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf S ℓ)))).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Dg.Φ) x).comp
          (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcRingSheaf S ℓ)) ≫ Dk.μ.hom))
          (add_zero n)) (zero_add n) := by
    rw [step1, h4, h2]
  have hR : (Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ
      ((Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ x).comp
        (Abelian.Ext.mk₀ Df.μ.hom) (add_zero n)) (zero_add n))).comp
      (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero n)) (zero_add n) =
      (Abelian.Ext.mk₀ (Dg.μ.inv ≫ Dg.Φ.map Df.μ.inv)).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Dg.Φ) x).comp
          (Abelian.Ext.mk₀ (Dg.Φ.map Df.μ.hom ≫ Dg.μ.hom)) (add_zero n)) (zero_add n) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]
  rw [hL, hR]
  have hab : (Dk.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf S ℓ))) ≫
      (θ.inv.app (SheafOfModules.unit (wcRingSheaf S ℓ)) ≫ Dk.μ.hom) = 𝟙 _ := by
    rw [Category.assoc, Iso.hom_inv_id_app_assoc, Iso.inv_hom_id]
  have hba : (Dg.Φ.map Df.μ.hom ≫ Dg.μ.hom) ≫ (Dg.μ.inv ≫ Dg.Φ.map Df.μ.inv) =
      𝟙 (Dg.Φ.obj (Df.Φ.obj (SheafOfModules.unit (wcRingSheaf S ℓ)))) := by
    rw [Category.assoc, Iso.hom_inv_id_assoc, ← CategoryTheory.Functor.map_comp, Iso.hom_inv_id,
      CategoryTheory.Functor.map_id]
  exact gen _ _ _ _ _ hab hba

theorem wc_hm_pull_id {S : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] (k : S ⟶ S) (hk : k = 𝟙 S)
    (D : wcHMPullData k ℓ) (hD : wcHMPullCanonical D) (n : ℕ) (x : wcHM S ℓ n) :
    wcHMPull D n x = x :=
by
  classical
  subst hk

  let eV : ∀ V : S.ProEt, Limits.pullback V.hom (𝟙 S) ≅ V.left := fun V =>
    { hom := Limits.pullback.fst V.hom (𝟙 S)
      inv := Limits.pullback.lift (𝟙 V.left) V.hom (by rw [Category.id_comp, Category.comp_id])
      hom_inv_id := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, Category.comp_id, Category.id_comp]
        · rw [Category.assoc, Limits.pullback.lift_snd, Category.id_comp,
            ← Category.comp_id (Limits.pullback.snd V.hom (𝟙 S)), ← Limits.pullback.condition]
      inv_hom_id := Limits.pullback.lift_fst _ _ _ }
  let β : ∀ V : S.ProEt, (wcProEtBC (𝟙 S)).obj V ≅ (𝟭 S.ProEt).obj V := fun V =>
    MorphismProperty.Over.isoMk (eV V)
      (by
        show Limits.pullback.fst V.hom (𝟙 S) ≫ V.hom = Limits.pullback.snd V.hom (𝟙 S)
        rw [Limits.pullback.condition, Category.comp_id])
  have hβl : ∀ V : S.ProEt, (β V).hom.left = Limits.pullback.fst V.hom (𝟙 S) := fun V => rfl
  have hnat : ∀ {V W : S.ProEt} (g : V ⟶ W),
      (wcProEtBC (𝟙 S)).map g ≫ (β W).hom = (β V).hom ≫ (𝟭 S.ProEt).map g := by
    intro V W g
    apply MorphismProperty.Over.Hom.ext
    show ((wcProEtBC (𝟙 S)).map g).left ≫ Limits.pullback.fst W.hom (𝟙 S) =
      Limits.pullback.fst V.hom (𝟙 S) ≫ g.left
    exact Limits.pullback.lift_fst _ _ _
  let α : 𝟭 S.ProEt ≅ wcProEtBC (𝟙 S) := (NatIso.ofComponents β hnat).symm
  have hα : ∀ (V : S.ProEt) (z : ↥V.left),
      (Limits.pullback.fst V.hom (𝟙 S)) ((α.hom.app V).left z) = z := by
    intro V z
    have h1 : (α.hom.app V).left ≫ Limits.pullback.fst V.hom (𝟙 S) = 𝟙 V.left := by
      show (eV V).inv ≫ (eV V).hom = 𝟙 V.left
      exact (eV V).inv_hom_id
    calc (Limits.pullback.fst V.hom (𝟙 S)) ((α.hom.app V).left z)
        = ((α.hom.app V).left ≫ Limits.pullback.fst V.hom (𝟙 S)) z :=
          (Scheme.Hom.comp_apply _ _ z).symm
      _ = (𝟙 V.left : V.left ⟶ V.left) z := by rw [h1]
      _ = z := rfl

  haveI := D.cont
  let τ := (Functor.sheafPushforwardContinuousNatTrans α.hom RingCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology S)).app (wcRingSheaf S ℓ)
  have hcompat : D.φ ≫ τ = (𝟙 (wcRingSheaf S ℓ) : wcRingSheaf S ℓ ⟶
      ((𝟭 S.ProEt).sheafPushforwardContinuous RingCat.{u+1} (Scheme.ProEt.topology S)
        (Scheme.ProEt.topology S)).obj (wcRingSheaf S ℓ)) := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    induction V using Opposite.rec with
    | op V =>
    apply RingCat.hom_ext
    apply RingHom.ext
    intro s
    apply ContinuousMap.ext
    intro z
    refine (congrArg (fun g : C(↥(Limits.pullback V.hom (𝟙 S)), ULift.{u+1} ℚ_[ℓ]) =>
      g ((α.hom.app V).left.base z)) (hD V s)).trans ?_
    let s' : C(↥V.left, ULift.{u+1} ℚ_[ℓ]) := s
    exact congrArg (fun p => s' p) (hα V z)
  let ι := SheafOfModules.pushforwardNatIso D.φ α ≪≫ SheafOfModules.pushforwardCongr hcompat ≪≫
    SheafOfModules.pushforwardId (wcRingSheaf S ℓ)
  let θ : D.Φ ≅ 𝟭 (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) :=
    Adjunction.leftAdjointUniq (D.adj.ofNatIsoRight ι) Adjunction.id

  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf S ℓ)} {a : ℕ}
      (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A B C' D' a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf S ℓ)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf S ℓ)} {a : ℕ}
      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
  have key : ∀ (y : wcHM S ℓ n)
      (E E' : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ SheafOfModules.unit (wcRingSheaf S ℓ)),
      E ≫ E' = 𝟙 _ →
      (Abelian.Ext.mk₀ E).comp y (zero_add n) = y.comp (Abelian.Ext.mk₀ E) (add_zero n) →
      (Abelian.Ext.mk₀ E).comp (y.comp (Abelian.Ext.mk₀ E') (add_zero n)) (zero_add n) = y := by
    intro y E E' hEE hc
    rw [← h4, hc, h3, hEE, Abelian.Ext.comp_mk₀_id]
  show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
      (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n) = x
  have nat : (Abelian.Ext.mapExactFunctor D.Φ x).comp
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcRingSheaf S ℓ)))) (add_zero n) =
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcRingSheaf S ℓ)))).comp x (zero_add n) := by
    rw [Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x θ.hom, Abelian.Ext.id_mapExactFunctor]
  have step1 : (Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero n) =
      ((Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcRingSheaf S ℓ)))).comp x (zero_add n)).comp
        (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcRingSheaf S ℓ)) ≫ D.μ.hom))
        (add_zero n) := by
    rw [← nat, h3, Iso.hom_inv_id_app_assoc]
  rw [step1, h4, h2]
  have he2 : (D.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcRingSheaf S ℓ))) ≫
      (θ.inv.app (SheafOfModules.unit (wcRingSheaf S ℓ)) ≫ D.μ.hom) = 𝟙 _ := by
    simp only [Category.assoc, Iso.hom_inv_id_app_assoc, Iso.inv_hom_id]
  have hcentral : ∀ (e : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ SheafOfModules.unit (wcRingSheaf S ℓ))
      (y : wcHM S ℓ n),
      (Abelian.Ext.mk₀ e).comp y (zero_add n) = y.comp (Abelian.Ext.mk₀ e) (add_zero n) := by
    intro e y
    have hcomm : ∀ (X : (S.ProEt)ᵒᵖ) (a b : (wcRingSheaf S ℓ).obj.obj X), a * b = b * a := by
      intro X a b
      exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} ℚ_[ℓ]) _ a b
    have hext : ∃ m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcRingSheaf S ℓ)),
        m.app (SheafOfModules.unit (wcRingSheaf S ℓ)) = e := by
      let R := wcRingSheaf S ℓ
      let s := (SheafOfModules.unit R).unitHomEquiv e
      let σ : ∀ X : (S.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
      have hσ : ∀ {X Y : (S.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
        fun f => PresheafOfModules.sections_property s f
      let L : ∀ (M : SheafOfModules.{u+1} R) (X : (S.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
        fun M X => ModuleCat.ofHom
          { toFun := fun x => σ X • x
            map_add' := fun x y => smul_add _ _ _
            map_smul' := fun r x => by
              simp only [RingHom.id_apply, smul_smul]
              rw [hcomm X] }
      let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
        ⟨PresheafOfModules.Hom.mk (L M) (by
          intro X Y f
          ext x
          show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
          rw [PresheafOfModules.map_smul, hσ])⟩
      refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
      · intro M N g
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro X
        ext x
        show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
        exact ((g.val.app X).hom.map_smul _ _).symm
      · apply (SheafOfModules.unit R).unitHomEquiv.injective
        apply PresheafOfModules.sections_ext
        intro X
        rw [SheafOfModules.unitHomEquiv_apply_coe]
        show σ X • (1 : R.obj.obj X) = s.1 X
        rw [smul_eq_mul, mul_one]
    obtain ⟨m, hm⟩ := hext
    subst hm
    have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp y m
    simp only [Abelian.Ext.id_mapExactFunctor] at h
    exact h.symm
  exact key x _ _ he2 (hcentral _ x)

theorem wc_hm_pull_const {S S' : Scheme.{u}} {f : S' ⟶ S} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData f ℓ) (hD : wcHMPullCanonical D) (c : ℚ_[ℓ]) :
    D.μ.inv ≫ D.Φ.map (wcHMConst S ℓ c) ≫ D.μ.hom = wcHMConst S' ℓ c :=
by
  classical
  have hκ : ∀ (T : Scheme.{u}) (W : (T.ProEt)ᵒᵖ) (r : ↑((wcRingSheaf T ℓ).val.obj W)),
      ((wcHMConst T ℓ c).val.app W).hom r =
        r * (show ↑((wcRingSheaf T ℓ).val.obj W) from
          (ContinuousMap.const _ (ULift.up c) : C(↥(Opposite.unop W).left, ULift.{u+1} ℚ_[ℓ]))) := by
    intro T W r
    rfl
  have key : ∀ g : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).obj
        (SheafOfModules.unit (wcRingSheaf S' ℓ)),
      wcHMConst S ℓ c ≫ g =
        g ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map
          (wcHMConst S' ℓ c) := by
    intro g
    apply (SheafOfModules.unitHomEquiv _).injective
    apply PresheafOfModules.sections_ext
    intro X
    cases X with
    | op V =>
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    obtain ⟨a, b, hab, ha1, ha2⟩ : ∃ (a : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))
        (b : ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V)))),
        @Eq ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V)))
          ((D.φ.hom.app (Opposite.op V)).hom a) b ∧
        (∀ r : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)),
          @Eq ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V))
            (((wcHMConst S ℓ c).val.app (Opposite.op V)).hom r) (r * a)) ∧
        (∀ r : ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V))),
          @Eq ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V)))
            (((wcHMConst S' ℓ c).val.app (Opposite.op ((wcProEtBC f).obj V))).hom r) (r * b)) :=
      ⟨(ContinuousMap.const _ (ULift.up c) : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
        (ContinuousMap.const _ (ULift.up c) : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ])),
        (hD V (ContinuousMap.const _ (ULift.up c))).trans rfl, fun r => rfl, fun r => rfl⟩
    change (g.val.app (Opposite.op V)).hom (((wcHMConst S ℓ c).val.app (Opposite.op V)).hom
          (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
            (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V))))) =
        ((wcHMConst S' ℓ c).val.app (Opposite.op ((wcProEtBC f).obj V))).hom
          ((g.val.app (Opposite.op V)).hom
            (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
              (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))))
    have e1 : ((wcHMConst S ℓ c).val.app (Opposite.op V)).hom
          (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
            (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))) =
        a • (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
            (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))) := by
      have h := ha1 1
      change @Eq ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V))
        (((wcHMConst S ℓ c).val.app (Opposite.op V)).hom (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V))))
        (a * 1)
      rw [h, one_mul, mul_one]
    rw [e1, LinearMap.map_smul]
    generalize (g.val.app (Opposite.op V)).hom
      (@id ↑((SheafOfModules.unit (wcRingSheaf S ℓ)).val.obj (Opposite.op V))
        (1 : ↑((wcRingSheaf S ℓ).val.obj (Opposite.op V)))) = y
    have h2 := ha2 y
    refine Eq.trans ?_ h2.symm
    change @Eq ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V)))
      (@HMul.hMul ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V)))
        ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V)))
        ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V))) instHMul
        ((D.φ.hom.app (Opposite.op V)).hom a) y)
      (@HMul.hMul ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V)))
        ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V)))
        ↑((wcRingSheaf S' ℓ).val.obj (Opposite.op ((wcProEtBC f).obj V))) instHMul y b)
    rw [hab]
    exact @mul_comm C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ]) _ b y
  have hmate : D.Φ.map (wcHMConst S ℓ c) ≫ D.μ.hom = D.μ.hom ≫ wcHMConst S' ℓ c := by
    apply (D.adj.homEquiv _ _).injective
    rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right]
    exact key _
  rw [hmate, Iso.inv_hom_id_assoc]

theorem wc_hm_scheme_iso_equiv : ∀ {S S' : Scheme.{u}} (_e : S ≅ S') (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
    ∃ E : SheafOfModules.{u+1} (wcRingSheaf S ℓ) ≌ SheafOfModules.{u+1} (wcRingSheaf S' ℓ),
      Nonempty (E.functor.obj (SheafOfModules.unit (wcRingSheaf S ℓ)) ≅
        SheafOfModules.unit (wcRingSheaf S' ℓ)) :=
by
  intro S S' e ℓ _
  have hmem : ∀ (T : Scheme.{u}) (V : T.ProEt) (R : Sieve V),
      R ∈ Scheme.ProEt.topology T V ↔
        Sieve.functorPushforward (Scheme.ProEt.forget T ⋙ Over.forget T) R ∈
          Scheme.proetaleTopology V.left := by
    intro T V R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have hT : Scheme.ProEt.topology T =
        (Scheme.ProEt.forget T).restrictedTopology (Scheme.proetaleTopology.over T) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := T)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [hT, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl
  have hcoc : ∀ {A B : Scheme.{u}} (f : A ≅ B),
      Functor.IsCocontinuous (C := B.ProEt) (D := A.ProEt)
        (@MorphismProperty.Over.map Scheme.{u} _ @WeaklyEtale ⊤ _ B A
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition f.inv inferInstance)
        (Scheme.ProEt.topology B) (Scheme.ProEt.topology A) := by
    intro A B f
    let αf : B.ProEt ⥤ A.ProEt := @MorphismProperty.Over.map Scheme.{u} _ @WeaklyEtale ⊤ _ B A
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition f.inv inferInstance
    let βf : A.ProEt ⥤ B.ProEt := @MorphismProperty.Over.map Scheme.{u} _ @WeaklyEtale ⊤ _ A B
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition f.hom inferInstance
    show αf.IsCocontinuous (Scheme.ProEt.topology B) (Scheme.ProEt.topology A)
    constructor
    intro V T hT
    rw [hmem B V]
    rw [hmem A] at hT
    refine GrothendieckTopology.superset_covering _ ?_ hT
    rintro Z g ⟨W, t, a, ht, rfl⟩
    have hcond : t.left ≫ V.hom = (βf.obj W).hom := by
      have hw : t.left ≫ (V.hom ≫ f.inv) = W.hom := MorphismProperty.Over.w t
      have key : ∀ {X : Scheme.{u}} (k : X ⟶ B), (k ≫ f.inv) ≫ f.hom = k := fun k => by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      have key2 : t.left ≫ V.hom = t.left ≫ ((V.hom ≫ f.inv) ≫ f.hom) :=
        (congrArg (fun k => t.left ≫ k) (key V.hom)).symm
      show t.left ≫ V.hom = W.hom ≫ f.hom
      rw [← hw]
      first
        | exact key2
        | exact key2.trans (Category.assoc _ _ _).symm
    let t' : βf.obj W ⟶ V := MorphismProperty.Over.homMk t.left hcond trivial
    have hc : 𝟙 W.left ≫ W.hom = (αf.obj (βf.obj W)).hom := by
      show 𝟙 W.left ≫ W.hom = (W.hom ≫ f.hom) ≫ f.inv
      rw [Category.id_comp, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    let c : αf.obj (βf.obj W) ⟶ W := MorphismProperty.Over.homMk (𝟙 W.left) hc trivial
    have hft : αf.map t' = c ≫ t := by
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp t.left).symm
    refine ⟨βf.obj W, t', a, ?_, rfl⟩
    show T.arrows (αf.map t')
    exact (congrArg (fun k => T.arrows k) hft).mpr (T.downward_closed ht c)
  let α : S'.ProEt ⥤ S.ProEt := @MorphismProperty.Over.map Scheme.{u} _ @WeaklyEtale ⊤ _ S' S
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition e.inv inferInstance
  let β : S.ProEt ⥤ S'.ProEt := @MorphismProperty.Over.map Scheme.{u} _ @WeaklyEtale ⊤ _ S S'
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition e.hom inferInstance
  have hα : α.IsCocontinuous (Scheme.ProEt.topology S') (Scheme.ProEt.topology S) := hcoc e
  have hβ : β.IsCocontinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') := hcoc e.symm
  let unitIso : 𝟭 S'.ProEt ≅ α ⋙ β :=
    NatIso.ofComponents
      (fun V => MorphismProperty.Over.isoMk (Iso.refl V.left) (by
        show 𝟙 V.left ≫ ((V.hom ≫ e.inv) ≫ e.hom) = V.hom
        first
          | (rw [Category.id_comp, Category.assoc, Iso.inv_hom_id, Category.comp_id])
          | (erw [Category.id_comp, Category.assoc, Iso.inv_hom_id, Category.comp_id])
          | simp))
      (fun {V W} g => by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.comp_id g.left).trans (Category.id_comp g.left).symm)
  let counitIso : β ⋙ α ≅ 𝟭 S.ProEt :=
    NatIso.ofComponents
      (fun W => MorphismProperty.Over.isoMk (Iso.refl W.left) (by
        show 𝟙 W.left ≫ W.hom = (W.hom ≫ e.hom) ≫ e.inv
        first
          | (rw [Category.id_comp, Category.assoc, Iso.hom_inv_id, Category.comp_id])
          | (erw [Category.id_comp, Category.assoc, Iso.hom_inv_id, Category.comp_id])
          | simp))
      (fun {V W} g => by
        apply MorphismProperty.Over.Hom.ext
        exact (Category.comp_id g.left).trans (Category.id_comp g.left).symm)
  let eqv : S'.ProEt ≌ S.ProEt :=
    Equivalence.mk' α β unitIso counitIso (fun V => by
      apply MorphismProperty.Over.Hom.ext
      exact Category.comp_id (𝟙 V.left))
  haveI : eqv.functor.IsCocontinuous (Scheme.ProEt.topology S') (Scheme.ProEt.topology S) := hα
  haveI : eqv.inverse.IsCocontinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') := hβ
  haveI := Equivalence.isDenseSubsite_functor_of_isCocontinuous (Scheme.ProEt.topology S')
    (Scheme.ProEt.topology S) eqv
  haveI := Equivalence.isDenseSubsite_inverse_of_isCocontinuous (Scheme.ProEt.topology S')
    (Scheme.ProEt.topology S) eqv
  haveI : eqv.functor.IsContinuous (Scheme.ProEt.topology S') (Scheme.ProEt.topology S) :=
    inferInstance
  haveI : eqv.inverse.IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') :=
    inferInstance
  let φ : wcRingSheaf S' ℓ ⟶ (eqv.functor.sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology S') (Scheme.ProEt.topology S)).obj (wcRingSheaf S ℓ) := 𝟙 _
  let ψ : wcRingSheaf S ℓ ⟶ (eqv.inverse.sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).obj (wcRingSheaf S' ℓ) := 𝟙 _
  have H₁ : Functor.whiskerRight (NatTrans.op eqv.counit) (wcRingSheaf S ℓ).obj =
      ψ.hom ≫ eqv.inverse.op.whiskerLeft φ.hom := by
    rfl
  have H₂ : φ.hom ≫ eqv.functor.op.whiskerLeft ψ.hom ≫
      Functor.whiskerRight (NatTrans.op eqv.unit) (wcRingSheaf S' ℓ).obj =
        𝟙 (wcRingSheaf S' ℓ).obj := by
    rfl
  exact ⟨SheafOfModules.pushforwardPushforwardEquivalence eqv φ ψ H₁ H₂, ⟨Iso.refl _⟩⟩

theorem ext_ring_iso_of_equivalence : ∀ {𝒞 : Type*} [Category 𝒞] [Abelian 𝒞] [HasExt 𝒞]
    {𝒟 : Type*} [Category 𝒟] [Abelian 𝒟] [HasExt 𝒟]
    (E : 𝒞 ≌ 𝒟) (P : 𝒞) (Q : 𝒟) (_μ : E.functor.obj P ≅ Q),
    ∃ Θ : ∀ n : ℕ, Abelian.Ext P P n ≃+ Abelian.Ext Q Q n,
      ∀ (i j k : ℕ) (hk : i + j = k) (x : Abelian.Ext P P i) (y : Abelian.Ext P P j),
        Θ k (x.comp y hk) = (Θ i x).comp (Θ j y) hk :=
by
  intro 𝒞 _ _ _ 𝒟 _ _ _ E P Q μ
  haveI hF : E.functor.Additive := Functor.additive_of_preserves_binary_products E.functor
  haveI hG : E.inverse.Additive := Functor.additive_of_preserves_binary_products E.inverse
  have hL1 : ∀ {Z : 𝒟} {m : ℕ} (γ : Abelian.Ext (E.functor.obj P) Z m),
      (Abelian.Ext.mk₀ μ.hom).comp ((Abelian.Ext.mk₀ μ.inv).comp γ (zero_add m))
        (zero_add m) = γ := by
    intro Z m γ
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
  have hL2 : ∀ {Z : 𝒟} {m : ℕ} (γ : Abelian.Ext Q Z m),
      (Abelian.Ext.mk₀ μ.inv).comp ((Abelian.Ext.mk₀ μ.hom).comp γ (zero_add m))
        (zero_add m) = γ := by
    intro Z m γ
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  have hR1 : ∀ {Z : 𝒟} {m : ℕ} (γ : Abelian.Ext Z (E.functor.obj P) m),
      (γ.comp (Abelian.Ext.mk₀ μ.hom) (add_zero m)).comp (Abelian.Ext.mk₀ μ.inv)
        (add_zero m) = γ := by
    intro Z m γ
    rw [Abelian.Ext.comp_assoc γ _ _ (add_zero m) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
  have hR2 : ∀ {Z : 𝒟} {m : ℕ} (γ : Abelian.Ext Z Q m),
      (γ.comp (Abelian.Ext.mk₀ μ.inv) (add_zero m)).comp (Abelian.Ext.mk₀ μ.hom)
        (add_zero m) = γ := by
    intro Z m γ
    rw [Abelian.Ext.comp_assoc γ _ _ (add_zero m) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  have hFbij : ∀ n : ℕ, Function.Bijective
      (fun x : Abelian.Ext P P n => Abelian.Ext.mapExactFunctor E.functor x) := by
    intro n


    have h : ∀ (L : 𝒟 ⥤ 𝒞) (adj : L ⊣ E.functor) [L.Additive]
        [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L]
        (Pc : 𝒟) (X : 𝒞) (ε : Pc ⟶ E.functor.obj X),
        (∀ Y : 𝒞, Function.Bijective (fun f : X ⟶ Y => ε ≫ E.functor.map f)) →
        ∀ (Y : 𝒞), Function.Bijective (fun β : Abelian.Ext X Y n =>
          (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor E.functor β) (zero_add n)) := by
      intro L adj _ _ _ Pc X ε hε Y
      obtain ⟨θ, hθ⟩ : ∃ θ : L.obj Pc ⟶ X, adj.homEquiv Pc X θ = ε :=
        ⟨_, (adj.homEquiv Pc X).apply_symm_apply ε⟩
      have hbij : ∀ T : 𝒞, Function.Bijective (fun f : X ⟶ T => θ ≫ f) := by
        intro T
        have e : (fun f : X ⟶ T => θ ≫ f) =
            (adj.homEquiv Pc T).symm ∘ (fun f : X ⟶ T => ε ≫ E.functor.map f) := by
          funext f
          simp only [Function.comp_apply]
          rw [_root_.Equiv.eq_symm_apply, Adjunction.homEquiv_naturality_right, hθ]
        rw [e]
        exact (adj.homEquiv Pc T).symm.bijective.comp (hε T)
      haveI : IsIso θ := isIso_of_coyoneda_map_bijective θ hbij
      have hψ : Function.Bijective
          (fun β : Abelian.Ext X Y n => (Abelian.Ext.mk₀ θ).comp β (zero_add n)) := by
        refine Function.bijective_iff_has_inverse.mpr
          ⟨fun γ => (Abelian.Ext.mk₀ (inv θ)).comp γ (zero_add n), ?_, ?_⟩
        · intro β
          simp only
          rw [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
        · intro γ
          simp only
          rw [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      have hfac : (fun β : Abelian.Ext X Y n =>
          (Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor E.functor β) (zero_add n)) =
          adj.extEquiv ∘
            (fun β : Abelian.Ext X Y n => (Abelian.Ext.mk₀ θ).comp β (zero_add n)) := by
        funext β
        simp only [Function.comp_apply]
        rw [Adjunction.extEquiv_apply, Abelian.Ext.mapExactFunctor_comp,
          Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀_assoc,
          ← hθ, Adjunction.homEquiv_unit]
      rw [hfac]
      exact adj.extEquiv.bijective.comp hψ
    have h' := h E.inverse E.symm.toAdjunction (E.functor.obj P) P (𝟙 _) (fun Y => by
        convert E.fullyFaithfulFunctor.map_bijective P Y using 1
        funext f
        simp) P
    simpa only [Abelian.Ext.mk₀_id_comp] using h'
  let φ : ∀ n : ℕ, Abelian.Ext P P n →+ Abelian.Ext Q Q n := fun n =>
    AddMonoidHom.mk' (fun x => (Abelian.Ext.mk₀ μ.inv).comp
      ((Abelian.Ext.mapExactFunctor E.functor x).comp (Abelian.Ext.mk₀ μ.hom) (add_zero n))
      (zero_add n)) (by
        intro x y
        simp only [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp, Abelian.Ext.comp_add])
  have hφ : ∀ n, Function.Bijective (φ n) := by
    intro n
    have hRa : Function.Bijective
        (fun γ : Abelian.Ext (E.functor.obj P) (E.functor.obj P) n =>
          γ.comp (Abelian.Ext.mk₀ μ.hom) (add_zero n)) :=
      Function.bijective_iff_has_inverse.mpr
        ⟨fun δ => δ.comp (Abelian.Ext.mk₀ μ.inv) (add_zero n), fun γ => hR1 γ, fun δ => hR2 δ⟩
    have hLb : Function.Bijective
        (fun δ : Abelian.Ext (E.functor.obj P) Q n =>
          (Abelian.Ext.mk₀ μ.inv).comp δ (zero_add n)) :=
      Function.bijective_iff_has_inverse.mpr
        ⟨fun δ => (Abelian.Ext.mk₀ μ.hom).comp δ (zero_add n), fun δ => hL1 δ, fun δ => hL2 δ⟩
    exact hLb.comp (hRa.comp (hFbij n))
  refine ⟨fun n => AddEquiv.ofBijective (φ n) (hφ n), ?_⟩
  intro i j k hk x y
  subst hk
  show φ (i + j) (x.comp y rfl) = (φ i x).comp (φ j y) rfl
  simp only [φ, AddMonoidHom.mk'_apply]
  rw [Abelian.Ext.mapExactFunctor_comp]
  rw [Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ μ.inv) _ _ (zero_add i) rfl (by omega)]
  rw [Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor E.functor x) _ _ (add_zero i)
    (zero_add j) (by omega)]
  rw [hL1]
  rw [Abelian.Ext.comp_assoc (Abelian.Ext.mapExactFunctor E.functor x) _ _ rfl
    (add_zero j) (by omega)]

theorem wc_ybar_poincare_middle (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (δ : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d))
    (hδ : ∀ z : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d),
      wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) (2 * d) (4 * d) (by omega) δ z = 0) :
    δ = 0 :=
by
  classical

  let Y : Over (Spec (.of F)) := Over.mk (Limits.pullback.fst X.hom X.hom ≫ X.hom)
  haveI hsm1 : SmoothOfRelativeDimension d (Limits.pullback.fst X.hom X.hom) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
      (IsPullback.of_hasPullback X.hom X.hom).flip ‹SmoothOfRelativeDimension d X.hom›
  haveI hsmY : SmoothOfRelativeDimension (2 * d) Y.hom := by
    have h2 := smoothOfRelativeDimension_comp d d (Limits.pullback.fst X.hom X.hom) X.hom
    rw [← two_mul] at h2
    exact h2
  haveI hprY : IsProper Y.hom :=
    (inferInstance : IsProper (Limits.pullback.fst X.hom X.hom ≫ X.hom))
  haveI hgiY : GeometricallyIrreducible Y.hom :=
    GeometricallyIrreducible.comp (Limits.pullback.fst X.hom X.hom) X.hom

  have hY : WeaklyEtale (Limits.pullback.fst Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F)

  let Ψ : Limits.pullback (wcPi2 F X) (wcPi2 F X) ≅ wcXbar F Y :=
    (Limits.pullbackLeftPullbackSndIso X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) (wcPi2 F X)) ≪≫
      Limits.pullback.congrHom rfl (Limits.pullback.condition).symm ≪≫
      Limits.pullbackSymmetry _ _ ≪≫
      (Limits.pullbackRightPullbackFstIso X.hom X.hom
        (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))).symm ≪≫
      Limits.pullbackSymmetry _ _ ≪≫
      Limits.pullbackRightPullbackFstIso X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
        (Limits.pullback.fst X.hom X.hom)

  obtain ⟨E, ⟨μ⟩⟩ := wc_hm_scheme_iso_equiv Ψ ℓ
  obtain ⟨Θ₁, hΘ₁⟩ := @ext_ring_iso_of_equivalence _ _ _ (HasExt.standard _) _ _ _
    (HasExt.standard _) E _ _ μ

  obtain ⟨Θ₂, hΘ₂⟩ := wc_modcoh_hm_cup_iso F Y hY ℓ

  have s8 : ∀ (m k : ℕ) (hm : m = 2 * d) (hk : 2 * d + m = k)
      (w : wcHM (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ m),
      wcHMCup (Limits.pullback (wcPi2 F X) (wcPi2 F X)) ℓ (2 * d) m k hk δ w = 0 := by
    intro m k hm hk w
    subst hm
    obtain rfl : k = 4 * d := by omega
    exact hδ w

  have hPD := (wc_modcup_perfect F Y (2 * d) ℓ hℓ hY (2 * d) (by omega)).1
  have hδ' : (Θ₂ (2 * d)).symm (Θ₁ (2 * d) δ) = 0 := by
    apply hPD
    intro y'
    apply (Θ₂ (2 * (2 * d))).injective
    rw [map_zero, hΘ₂, AddEquiv.apply_symm_apply]
    obtain ⟨w, hw⟩ := (Θ₁ (2 * (2 * d) - 2 * d)).surjective (Θ₂ (2 * (2 * d) - 2 * d) y')
    rw [← hw]
    have key := hΘ₁ (2 * d) (2 * (2 * d) - 2 * d) (2 * (2 * d))
      (Nat.add_sub_cancel' (by omega)) δ w
    have h0 := s8 (2 * (2 * d) - 2 * d) (2 * (2 * d)) (by omega)
      (Nat.add_sub_cancel' (by omega)) w
    simp only [wcHMCup, Abelian.Ext.bilinearComp_apply_apply] at h0 ⊢
    rw [← key, h0, map_zero]
  have h1 : Θ₁ (2 * d) δ = 0 := by
    have h3 := congrArg (Θ₂ (2 * d)) hδ'
    rwa [AddEquiv.apply_symm_apply, map_zero] at h3
  exact (Θ₁ (2 * d)).injective (h1.trans (map_zero _).symm)

theorem wc_xbar_geom_point_exists (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom] :
    ∃ x₀ : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X, x₀ ≫ wcPi2 F X = 𝟙 _ :=
by
  classical

  have retr : ∀ (A : CommRingCat.{u}) [Nontrivial A]
      (φ : CommRingCat.of (AlgebraicClosure F) ⟶ A),
      φ.hom.FiniteType → ∃ ρ : A ⟶ CommRingCat.of (AlgebraicClosure F), φ ≫ ρ = 𝟙 _ := by
    intro A _ φ hφ
    obtain ⟨m, hm⟩ := Ideal.exists_maximal A
    letI := Ideal.Quotient.field m
    let ψ : AlgebraicClosure F →+* A ⧸ m := (Ideal.Quotient.mk m).comp φ.hom
    have hψ : ψ.FiniteType := RingHom.FiniteType.comp_surjective hφ Ideal.Quotient.mk_surjective
    letI : Algebra (AlgebraicClosure F) (A ⧸ m) := ψ.toAlgebra
    haveI : Algebra.FiniteType (AlgebraicClosure F) (A ⧸ m) := hψ
    haveI : Module.Finite (AlgebraicClosure F) (A ⧸ m) :=
      finite_of_finite_type_of_isJacobsonRing _ _
    haveI : Algebra.IsIntegral (AlgebraicClosure F) (A ⧸ m) := Algebra.IsIntegral.of_finite _ _
    have hbij : Function.Bijective (algebraMap (AlgebraicClosure F) (A ⧸ m)) :=
      IsAlgClosed.algebraMap_bijective_of_isIntegral
    let e := RingEquiv.ofBijective (algebraMap (AlgebraicClosure F) (A ⧸ m)) hbij
    refine ⟨CommRingCat.ofHom (e.symm.toRingHom.comp (Ideal.Quotient.mk m)), ?_⟩
    ext k
    show e.symm (Ideal.Quotient.mk m (φ k)) = k
    have hk : Ideal.Quotient.mk m (φ k) = e k := rfl
    rw [hk, RingEquiv.symm_apply_apply]

  haveI hirr : IrreducibleSpace (wcXbar F X) :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom) (K := AlgebraicClosure F)
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
      (Limits.pullback.fst _ _) (Limits.pullback.snd _ _) (IsPullback.of_hasPullback _ _)
  obtain ⟨y⟩ : Nonempty (wcXbar F X) := inferInstance

  haveI : LocallyOfFiniteType (wcPi2 F X) := by unfold wcPi2; infer_instance

  obtain ⟨z, -⟩ := (wcXbar F X).affineOpenCover.covers y
  haveI : Nontrivial ((wcXbar F X).affineOpenCover.X ((wcXbar F X).affineOpenCover.idx y)) :=
    PrimeSpectrum.nonempty_iff_nontrivial.mp ⟨z⟩

  have hφ : LocallyOfFiniteType (Spec.map (Spec.preimage
      ((wcXbar F X).affineOpenCover.f ((wcXbar F X).affineOpenCover.idx y) ≫ wcPi2 F X))) := by
    rw [Spec.map_preimage]; infer_instance
  have hφ' := (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hφ

  obtain ⟨ρ, hρ⟩ := retr _ _ hφ'

  refine ⟨Spec.map ρ ≫ (wcXbar F X).affineOpenCover.f ((wcXbar F X).affineOpenCover.idx y), ?_⟩
  rw [Category.assoc, ← Spec.map_preimage
    ((wcXbar F X).affineOpenCover.f ((wcXbar F X).affineOpenCover.idx y) ≫ wcPi2 F X),
    ← Spec.map_comp, hρ, Spec.map_id]

theorem wc_closed_supp_class_restriction_zero_of_exact {X Y : Scheme.{u}} (i : X ⟶ Y)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (D : wcHMPullData i ℓ)
    (hex : Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ))
    (n N k : ℕ) (hk : N + n = k) (θ : wcSuppExt D n) (x : wcHM Y ℓ N) :
    wcHMPull D N x = 0 → wcHMCup Y ℓ N n k hk x (wcSuppClass D n θ) = 0 :=
by
  intro hx
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) := HasExt.standard _
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  haveI : (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ).Additive :=
    Adjunction.right_adjoint_additive D.adj
  haveI : Limits.PreservesFiniteLimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ) := by
    haveI := D.adj.rightAdjoint_preservesLimits
    infer_instance
  haveI := hex
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf X ℓ)) := by
    have encl : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
        [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
        (R : Sheaf J RingCat.{u+1}), EnoughInjectives (SheafOfModules.{u+1} R) := by
      intro C _ J _ _ R
      have s2 : HasSeparator (PresheafOfModules.{u+1} R.obj) := by
        let G : C → PresheafOfModules.{u+1} R.obj := fun X =>
          (PresheafOfModules.free.{u+1} R.obj).obj (uliftYoneda.{u+1}.obj X)
        have key : ∀ (X : C) (M N : PresheafOfModules.{u+1} R.obj) (φ : M ⟶ N) (h : G X ⟶ M),
            uliftYonedaEquiv.{u+1}
              ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ N (h ≫ φ)) =
              φ.app (Opposite.op X) (uliftYonedaEquiv.{u+1}
                ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ M h)) := by
          intro X M N φ h
          rw [Adjunction.homEquiv_naturality_right, uliftYonedaEquiv_comp]
          rfl
        have hsep : (ObjectProperty.ofObj G).IsSeparating := by
          intro M N f g hfg
          apply PresheafOfModules.hom_ext
          intro Y
          obtain ⟨X⟩ := Y
          ext m
          let e := ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv
            (uliftYoneda.{u+1}.obj X) M).trans uliftYonedaEquiv.{u+1}
          have h1 := hfg _ (ObjectProperty.ofObj_apply G X) (e.symm m)
          have h2 := congrArg (fun k => uliftYonedaEquiv.{u+1}
            ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ N k)) h1
          rw [key, key] at h2
          have h3 : uliftYonedaEquiv.{u+1}
              ((PresheafOfModules.freeAdjunction.{u+1} R.obj).homEquiv _ M (e.symm m)) = m :=
            e.apply_symm_apply m
          rw [h3] at h2
          exact h2
        exact HasSeparator.mk ⟨_, hsep.isSeparator_coproduct⟩
      have h5 : AB5OfSize.{u+1, u+1} (SheafOfModules.{u+1} R) :=
        ⟨fun K _ _ =>
          haveI := HasExactColimitsOfShape.domain_of_functor K
            (PresheafOfModules.toPresheaf.{u+1} R.obj)
          (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R.obj)).hasExactColimitsOfShape K⟩
      have hs : HasSeparator (SheafOfModules.{u+1} R) :=
        HasSeparator.of_adjunction (PresheafOfModules.sheafificationAdjunction.{u+1} (𝟙 R.obj))
      exact @IsGrothendieckAbelian.enoughInjectives _ _ _
        (IsGrothendieckAbelian.mk.{u+1} (C := SheafOfModules.{u+1} R) inferInstance inferInstance
          h5 hs)
    exact encl (Scheme.ProEt.topology X) (wcRingSheaf X ℓ)

  have abs : ∀ (Φ : SheafOfModules.{u+1} (wcRingSheaf Y ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf X ℓ))
      (G : SheafOfModules.{u+1} (wcRingSheaf X ℓ) ⥤ SheafOfModules.{u+1} (wcRingSheaf Y ℓ))
      (adj : Φ ⊣ G)
      [Φ.Additive] [Limits.PreservesFiniteLimits Φ] [Limits.PreservesFiniteColimits Φ]
      [G.Additive] [Limits.PreservesFiniteLimits G] [Limits.PreservesFiniteColimits G]
      (M : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (n : ℕ)
      (N : SheafOfModules.{u+1} (wcRingSheaf X ℓ)),
      Function.Bijective (fun y : Abelian.Ext M (G.obj N) n =>
        (Abelian.Ext.mapExactFunctor Φ y).comp (Abelian.Ext.mk₀ (adj.counit.app N))
          (add_zero n)) := by
    intro Φ G adj _ _ _ _ _ _ M n
    have N1 : ∀ {N N' : SheafOfModules.{u+1} (wcRingSheaf X ℓ)} (g : N ⟶ N') {m : ℕ}
        (w : Abelian.Ext M (G.obj N) m),
        (Abelian.Ext.mapExactFunctor Φ (w.comp (Abelian.Ext.mk₀ (G.map g)) (add_zero m))).comp
          (Abelian.Ext.mk₀ (adj.counit.app N')) (add_zero m) =
        ((Abelian.Ext.mapExactFunctor Φ w).comp (Abelian.Ext.mk₀ (adj.counit.app N))
          (add_zero m)).comp (Abelian.Ext.mk₀ g) (add_zero m) := by
      intro N N' g m w
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        show Φ.map (G.map g) ≫ adj.counit.app N' = adj.counit.app N ≫ g from
          adj.counit_naturality g]
    have E : ∀ {S : ShortComplex (SheafOfModules.{u+1} (wcRingSheaf X ℓ))} (hS : S.ShortExact)
        (hGS : (S.map G).ShortExact) (hΦGS : ((S.map G).map Φ).ShortExact) {m : ℕ}
        (z : Abelian.Ext M (G.obj S.X₃) m),
        (Abelian.Ext.mapExactFunctor Φ (z.comp hGS.extClass (rfl : m + 1 = m + 1))).comp
            (Abelian.Ext.mk₀ (adj.counit.app S.X₁)) (add_zero (m + 1)) =
          ((Abelian.Ext.mapExactFunctor Φ z).comp (Abelian.Ext.mk₀ (adj.counit.app S.X₃))
            (add_zero m)).comp hS.extClass (rfl : m + 1 = m + 1) := by
      intro S hS hGS hΦGS m z
      have nat : hΦGS.extClass.comp (Abelian.Ext.mk₀ (adj.counit.app S.X₁)) (add_zero 1) =
          (Abelian.Ext.mk₀ (adj.counit.app S.X₃)).comp hS.extClass (zero_add 1) :=
        hΦGS.extClass_naturality hS (ShortComplex.homMk (adj.counit.app S.X₁)
          (adj.counit.app S.X₂) (adj.counit.app S.X₃) (adj.counit_naturality S.f).symm
          (adj.counit_naturality S.g).symm)
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
        Abelian.Ext.comp_assoc_of_third_deg_zero, nat, Abelian.Ext.comp_assoc_of_second_deg_zero]
    have tadd : ∀ (N : SheafOfModules.{u+1} (wcRingSheaf X ℓ)) (m : ℕ),
        ∃ T : Abelian.Ext M (G.obj N) m →+ Abelian.Ext (Φ.obj M) N m,
        ∀ y, T y = (Abelian.Ext.mapExactFunctor Φ y).comp (Abelian.Ext.mk₀ (adj.counit.app N))
          (add_zero m) :=
      fun N m => ⟨((Abelian.Ext.mk₀ (adj.counit.app N)).postcomp (Φ.obj M) (add_zero m)).comp
        (Φ.mapExtAddHom M (G.obj N) m), fun y => rfl⟩
    induction n with
    | zero =>
      intro N
      have key0 : ∀ f : M ⟶ G.obj N,
          (Abelian.Ext.mapExactFunctor Φ (Abelian.Ext.mk₀ f)).comp
            (Abelian.Ext.mk₀ (adj.counit.app N)) (add_zero 0) =
          Abelian.Ext.mk₀ ((adj.homEquiv M N).symm f) := by
        intro f
        rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀,
          Adjunction.homEquiv_counit]
      refine ⟨?_, ?_⟩
      · intro y₁ y₂ h
        obtain ⟨f₁, rfl⟩ := (Abelian.Ext.mk₀_bijective M (G.obj N)).2 y₁
        obtain ⟨f₂, rfl⟩ := (Abelian.Ext.mk₀_bijective M (G.obj N)).2 y₂
        beta_reduce at h
        rw [key0, key0] at h
        have h' := (Abelian.Ext.mk₀_bijective _ _).1 h
        rw [(adj.homEquiv M N).symm.injective h']
      · intro v
        obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective (Φ.obj M) N).2 v
        refine ⟨Abelian.Ext.mk₀ (adj.homEquiv M N g), ?_⟩
        beta_reduce
        rw [key0, Equiv.symm_apply_apply]
    | succ n IH =>
      have step : ∀ (S : ShortComplex (SheafOfModules.{u+1} (wcRingSheaf X ℓ)))
          (hS : S.ShortExact) (_ : Injective S.X₂),
          Function.Bijective (fun y : Abelian.Ext M (G.obj S.X₁) (n + 1) =>
            (Abelian.Ext.mapExactFunctor Φ y).comp (Abelian.Ext.mk₀ (adj.counit.app S.X₁))
              (add_zero (n + 1))) := by
        intro S hS hI
        have hGS := hS.map_of_exact G
        have hΦGS := hGS.map_of_exact Φ
        have : Injective (S.map G).X₂ := adj.map_injective S.X₂ hI
        refine ⟨?_, ?_⟩
        · have inj0 : ∀ y : Abelian.Ext M (G.obj S.X₁) (n + 1),
              (Abelian.Ext.mapExactFunctor Φ y).comp (Abelian.Ext.mk₀ (adj.counit.app S.X₁))
                (add_zero (n + 1)) = 0 → y = 0 := by
            intro y hy
            have h1 : y.comp (Abelian.Ext.mk₀ (S.map G).f) (add_zero (n + 1)) = 0 :=
              Abelian.Ext.eq_zero_of_injective _
            obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₁ M hGS y h1
              (rfl : n + 1 = n + 1)
            have h2 : ((Abelian.Ext.mapExactFunctor Φ z).comp
                (Abelian.Ext.mk₀ (adj.counit.app S.X₃)) (add_zero n)).comp hS.extClass
                  (rfl : n + 1 = n + 1) = 0 := by
              have := E hS hGS hΦGS z
              rw [hz] at this
              rw [← this]
              exact hy
            obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₃ (Φ.obj M) hS _
              (rfl : n + 1 = n + 1) h2
            obtain ⟨w', hw'⟩ := (IH S.X₂).2 w
            beta_reduce at hw'
            have h3 : (Abelian.Ext.mapExactFunctor Φ
                (w'.comp (Abelian.Ext.mk₀ (G.map S.g)) (add_zero n))).comp
                  (Abelian.Ext.mk₀ (adj.counit.app S.X₃)) (add_zero n) =
                (Abelian.Ext.mapExactFunctor Φ z).comp
                  (Abelian.Ext.mk₀ (adj.counit.app S.X₃)) (add_zero n) := by
              rw [N1, hw', hw]
            have h4 := (IH S.X₃).1 h3
            have h5 : (Abelian.Ext.mk₀ (G.map S.g)).comp hGS.extClass (zero_add 1) = 0 :=
              hGS.comp_extClass
            rw [← hz, ← h4, Abelian.Ext.comp_assoc_of_second_deg_zero, h5,
              Abelian.Ext.comp_zero]
          intro a b hab
          obtain ⟨T, hT⟩ := tadd S.X₁ (n + 1)
          have h0 : T (a - b) = 0 := by
            rw [map_sub, hT, hT]
            exact sub_eq_zero.mpr hab
          rw [hT] at h0
          exact sub_eq_zero.mp (inj0 _ h0)
        · intro v
          have h1 : v.comp (Abelian.Ext.mk₀ S.f) (add_zero (n + 1)) = 0 :=
            Abelian.Ext.eq_zero_of_injective _
          obtain ⟨u, hu⟩ := Abelian.Ext.covariant_sequence_exact₁ (Φ.obj M) hS v h1
            (rfl : n + 1 = n + 1)
          obtain ⟨z, hz⟩ := (IH S.X₃).2 u
          beta_reduce at hz
          refine ⟨z.comp hGS.extClass (rfl : n + 1 = n + 1), ?_⟩
          beta_reduce
          rw [E hS hGS hΦGS z, hz, hu]
      intro N
      exact step (ShortComplex.mk (Injective.ι N) (Limits.cokernel.π (Injective.ι N))
          (Limits.cokernel.condition _))
        (ShortComplex.ShortExact.mk'
          (ShortComplex.exact_of_g_is_cokernel _ (Limits.cokernelIsCokernel (Injective.ι N)))
          (Injective.ι_mono N) inferInstance)
        (show Injective (Injective.under N) from inferInstance)

  have htri : D.Φ.map (D.adj.homEquiv (SheafOfModules.unit (wcRingSheaf Y ℓ))
        (SheafOfModules.unit (wcRingSheaf X ℓ)) D.μ.hom) ≫
      D.adj.counit.app (SheafOfModules.unit (wcRingSheaf X ℓ)) = D.μ.hom := by
    have h1 := D.adj.homEquiv_counit (SheafOfModules.unit (wcRingSheaf Y ℓ))
      (SheafOfModules.unit (wcRingSheaf X ℓ))
      (D.adj.homEquiv (SheafOfModules.unit (wcRingSheaf Y ℓ))
        (SheafOfModules.unit (wcRingSheaf X ℓ)) D.μ.hom)
    rw [Equiv.symm_apply_apply] at h1
    exact h1.symm

  have s3 : (Abelian.Ext.mk₀ D.μ.hom).comp (wcHMPull D N x) (zero_add N) =
      (Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero N) := by
    show (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero N))
        (zero_add N)) (zero_add N) = _
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
      Abelian.Ext.mk₀_id_comp]

  have hy : x.comp (Abelian.Ext.mk₀ (D.adj.homEquiv (SheafOfModules.unit (wcRingSheaf Y ℓ))
        (SheafOfModules.unit (wcRingSheaf X ℓ)) D.μ.hom)) (add_zero N) = 0 := by
    apply (abs D.Φ (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ)
      D.adj (SheafOfModules.unit (wcRingSheaf Y ℓ)) N
      (SheafOfModules.unit (wcRingSheaf X ℓ))).1
    beta_reduce
    rw [Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.zero_comp,
      Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, htri, ← s3, hx,
      Abelian.Ext.comp_zero]
  have hy' : x.comp (Abelian.Ext.mk₀ (wcSuppUnitMap D)) (add_zero N) = 0 := hy
  show x.comp ((Abelian.Ext.mk₀ (wcSuppUnitMap D)).comp θ (zero_add n)) hk = 0
  rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, hy', Abelian.Ext.zero_comp]

theorem wc_closed_compl_proet_finite_cover {X Y : Scheme.{u}} (i : X ⟶ Y) [IsClosedImmersion i]
    [IsLocallyNoetherian Y] (U : Y.ProEt) [IsAffine U.left] :
    ∃ (n : ℕ) (W : Fin n → Y.ProEt) (w : ∀ k, W k ⟶ U),
      (∀ k, IsAffine (W k).left) ∧
      (∀ k, IsEmpty ((wcProEtBC i).obj (W k)).left) ∧
      ∀ y : U.left, y ∉ Set.range (Limits.pullback.fst U.hom i) → ∃ k, y ∈ Set.range (w k).left :=
by
  classical
  haveI hU : WeaklyEtale U.hom := U.prop
  obtain ⟨O, hO⟩ : ∃ O : Y.Opens, (O : Set Y) = (Set.range i)ᶜ :=
    ⟨⟨(Set.range i)ᶜ, (IsClosedImmersion.isClosedEmbedding i).isClosed_range.isOpen_compl⟩, rfl⟩
  have key : ∀ {Z : Scheme.{u}} (f : Z ⟶ Y) [CompactSpace Z], IsCompact (f ⁻¹' (O : Set Y)) := by
    intro Z f _
    haveI : QuasiCompact O.ι := inferInstance
    haveI : QuasiCompact (Limits.pullback.fst f O.ι) := inferInstance
    haveI : CompactSpace (Limits.pullback f O.ι : Scheme.{u}) :=
      QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst f O.ι)
    have h1 := isCompact_range (Limits.pullback.fst f O.ι).continuous
    rw [Scheme.Pullback.range_fst, Scheme.Opens.range_ι] at h1
    exact h1
  have hqc : IsCompact (U.hom ⁻¹' (O : Set Y)) :=
    @key U.left U.hom (inferInstanceAs (CompactSpace U.left))
  obtain ⟨K, hK⟩ : ∃ K : U.left.Opens, (K : Set U.left) = U.hom ⁻¹' (O : Set Y) :=
    ⟨⟨U.hom ⁻¹' (O : Set Y), O.isOpen.preimage U.hom.continuous⟩, rfl⟩
  have hKc : IsCompact (K : Set U.left) := by rw [hK]; exact hqc
  obtain ⟨s, hs, hKs⟩ := isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hKc
  obtain ⟨t, ht⟩ : ∃ t : Finset U.left.affineOpens, ∀ a, a ∈ t ↔ a ∈ s :=
    ⟨hs.toFinset, fun a => hs.mem_toFinset⟩
  obtain ⟨V, hVt, hVsurj⟩ : ∃ (V : Fin t.card → U.left.affineOpens), (∀ k, V k ∈ t) ∧
      ∀ a ∈ t, ∃ k, V k = a :=
    ⟨fun k => (t.equivFin.symm k).1, fun k => (t.equivFin.symm k).2,
     fun a ha => ⟨t.equivFin ⟨a, ha⟩, by simp⟩⟩
  have hVK : ∀ k, ((V k : U.left.Opens) : Set U.left) ⊆ U.hom ⁻¹' (O : Set Y) := by
    intro k
    rw [← hK, hKs]
    intro x hx
    simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion]
    exact ⟨V k, (ht _).mp (hVt k), hx⟩
  refine ⟨t.card, fun k => MorphismProperty.Over.mk ⊤ ((V k : U.left.Opens).ι ≫ U.hom) inferInstance,
    fun k => MorphismProperty.Over.homMk (V k : U.left.Opens).ι rfl trivial, ?_, ?_, ?_⟩
  · intro k
    exact (V k).2
  · intro k
    show IsEmpty (Limits.pullback (C := Scheme.{u}) ((V k : U.left.Opens).ι ≫ U.hom) i)
    apply Scheme.isEmpty_pullback
    rw [Set.disjoint_left]
    rintro a ⟨z, rfl⟩ ⟨x, hx⟩
    have h1 : ((V k : U.left.Opens).ι z) ∈ U.hom ⁻¹' (O : Set Y) :=
      hVK k (by rw [← Scheme.Opens.range_ι]; exact ⟨z, rfl⟩)
    rw [Set.mem_preimage, hO] at h1
    exact h1 ⟨x, by rw [hx]; rfl⟩
  · intro y hy
    rw [Scheme.Pullback.range_fst] at hy
    have hyK : y ∈ (K : Set U.left) := by
      rw [hK, Set.mem_preimage, hO]; exact hy
    rw [hKs] at hyK
    simp only [TopologicalSpace.Opens.coe_iSup, Set.mem_iUnion] at hyK
    obtain ⟨a, ha, hya⟩ := hyK
    obtain ⟨k, rfl⟩ := hVsurj a ((ht a).mpr ha)
    refine ⟨k, ?_⟩
    show y ∈ Set.range (V k : U.left.Opens).ι
    rw [Scheme.Opens.range_ι]
    exact hya

theorem wcl_indEtale_point_data : ∀ (S T : Type u) [CommRing S] [CommRing T] (τ : S →+* T), wcIndEtale τ → ∀ t : T, ∃ (n : ℕ) (f : Fin n → MvPolynomial (Fin n) S) (x : Fin n → T) (p : MvPolynomial (Fin n) S), (∀ b, MvPolynomial.eval₂ τ x (f b) = 0) ∧ IsUnit (MvPolynomial.eval₂ τ x (Matrix.of fun a b => MvPolynomial.pderiv a (f b)).det) ∧ MvPolynomial.eval₂ τ x p = t :=
by
  have hpres : ∀ (S E : Type u) [CommRing S] [CommRing E] [Algebra S E], Algebra.Etale S E → ∃ (n : ℕ) (f : Fin n → MvPolynomial (Fin n) S) (val : Fin n → E), Function.Surjective (MvPolynomial.aeval (R := S) val) ∧ RingHom.ker (MvPolynomial.aeval (R := S) val) = Ideal.span (Set.range f) ∧ ∃ g : MvPolynomial (Fin n) S, g * (Matrix.of fun a b => MvPolynomial.pderiv a (f b)).det - 1 ∈ Ideal.span (Set.range f) := by
    have wc_etale_standard_presentation : ∀ (S E : Type u) [CommRing S] [CommRing E] [Algebra S E], Algebra.Etale S E → ∃ (ι σ : Type) (_ : Fintype ι) (_ : Fintype σ) (_ : DecidableEq σ) (mp : σ → ι) (f : σ → MvPolynomial ι S) (val : ι → E), Function.Bijective mp ∧ Function.Surjective (MvPolynomial.aeval (R := S) val) ∧ RingHom.ker (MvPolynomial.aeval (R := S) val) = Ideal.span (Set.range f) ∧ ∃ g : MvPolynomial ι S, g * (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j)).det - 1 ∈ Ideal.span (Set.range f) := by
      intro S E _ _ _ hE
      haveI : Algebra.IsStandardSmoothOfRelativeDimension 0 S E :=
        Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero.mp hE
      obtain ⟨ι, σ, hσ, hι, P, hdim⟩ :=
        Algebra.IsStandardSmoothOfRelativeDimension.out (n := 0) (R := S) (S := E)
      have hdim' : Nat.card ι - Nat.card σ = 0 := hdim
      have hle : Nat.card ι ≤ Nat.card σ := Nat.sub_eq_zero_iff_le.mp hdim'
      letI : Fintype ι := Fintype.ofFinite ι
      letI : Fintype σ := Fintype.ofFinite σ
      letI : DecidableEq σ := Classical.decEq σ
      have hker : RingHom.ker (MvPolynomial.aeval (R := S) P.val) =
          Ideal.span (Set.range P.relation) :=
        (P.span_range_relation_eq_ker.trans P.ker_eq_ker_aeval_val).symm
      refine ⟨ι, σ, inferInstance, inferInstance, inferInstance, P.map, P.relation, P.val,
        P.map_inj.bijective_of_nat_card_le hle, fun s => ⟨P.σ' s, P.aeval_val_σ' s⟩, hker, ?_⟩
      have hM : (Matrix.of fun i j => MvPolynomial.pderiv (P.map i) (P.relation j)) =
          P.jacobiMatrix := by
        ext i j
        rw [Matrix.of_apply, P.jacobiMatrix_apply]
      have hJ : P.jacobian = MvPolynomial.aeval P.val
          (Matrix.of fun i j => MvPolynomial.pderiv (P.map i) (P.relation j)).det := by
        rw [P.jacobian_eq_jacobiMatrix_det, hM, Algebra.Generators.algebraMap_apply]
      have hu : IsUnit P.jacobian := P.jacobian_isUnit
      rw [hJ] at hu
      obtain ⟨y, hy⟩ := hu.exists_left_inv
      refine ⟨P.σ' y, ?_⟩
      rw [← hker, RingHom.mem_ker, map_sub, map_mul, map_one, P.aeval_val_σ', hy, sub_self]
    intro S E _ _ _ hE
    classical
    obtain ⟨ι, σ, _, _, _, mp, f, val, hmp, hsurj, hker, g, hg⟩ :=
      wc_etale_standard_presentation S E hE
    let n : ℕ := Fintype.card ι
    let e : ι ≃ Fin n := Fintype.equivFin ι
    let m : σ ≃ ι := Equiv.ofBijective mp hmp
    let τ : Fin n ≃ σ := e.symm.trans m.symm
    have hK : ∀ k, mp (τ k) = e.symm k := fun k => by
      have : m (m.symm (e.symm k)) = e.symm k := Equiv.apply_symm_apply m _
      exact this
    let val' : Fin n → E := val ∘ e.symm
    let f' : Fin n → MvPolynomial (Fin n) S := fun k => MvPolynomial.rename e (f (τ k))
    have hC : ∀ p : MvPolynomial ι S,
        MvPolynomial.aeval val' (MvPolynomial.rename e p) = MvPolynomial.aeval val p := by
      intro p
      rw [MvPolynomial.aeval_rename]
      have hv : val' ∘ ⇑e = val := by funext i; simp [val']
      rw [hv]
    have hinv : ∀ q : MvPolynomial (Fin n) S,
        MvPolynomial.rename e (MvPolynomial.rename e.symm q) = q := by
      intro q
      rw [MvPolynomial.rename_rename]
      have : (⇑e ∘ ⇑e.symm) = id := by funext x; simp
      rw [this, MvPolynomial.rename_id]
      rfl
    have hspan : ∀ x ∈ Ideal.span (Set.range f),
        MvPolynomial.rename e x ∈ Ideal.span (Set.range f') := by
      intro x hx
      have hle : Ideal.map (MvPolynomial.rename e : MvPolynomial ι S →ₐ[S] MvPolynomial (Fin n) S)
          (Ideal.span (Set.range f)) ≤ Ideal.span (Set.range f') := by
        rw [Ideal.map_span]
        apply Ideal.span_le.mpr
        rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
        apply Ideal.subset_span
        refine ⟨τ.symm j, ?_⟩
        simp [f']
      exact hle (Ideal.mem_map_of_mem _ hx)
    refine ⟨n, f', val', ?_, ?_, MvPolynomial.rename e g, ?_⟩
    · intro x
      obtain ⟨p, rfl⟩ := hsurj x
      exact ⟨_, hC p⟩
    · apply le_antisymm
      · intro q hq
        rw [RingHom.mem_ker] at hq
        have h1 : MvPolynomial.rename e.symm q ∈ RingHom.ker (MvPolynomial.aeval (R := S) val) := by
          rw [RingHom.mem_ker, ← hC, hinv]; exact hq
        rw [hker] at h1
        have h2 := hspan _ h1
        rwa [hinv] at h2
      · rw [Ideal.span_le]
        rintro _ ⟨k, rfl⟩
        rw [SetLike.mem_coe, RingHom.mem_ker]
        show MvPolynomial.aeval val' (MvPolynomial.rename e (f (τ k))) = 0
        rw [hC]
        have h3 : f (τ k) ∈ RingHom.ker (MvPolynomial.aeval (R := S) val) := by
          rw [hker]; exact Ideal.subset_span ⟨τ k, rfl⟩
        exact h3
    · have hJ : (Matrix.of fun a b => MvPolynomial.pderiv a (f' b)) =
          ((MvPolynomial.rename e : MvPolynomial ι S →ₐ[S] MvPolynomial (Fin n) S).toRingHom.mapMatrix
            (Matrix.of fun i j => MvPolynomial.pderiv (mp i) (f j))).submatrix τ τ := by
        refine Matrix.ext (fun a b => ?_)
        simp only [Matrix.of_apply, Matrix.submatrix_apply, RingHom.mapMatrix_apply, Matrix.map_apply]
        have ha : a = e (mp (τ a)) := by rw [hK]; simp
        show MvPolynomial.pderiv a (MvPolynomial.rename e (f (τ b))) = _
        conv_lhs => rw [ha]
        exact MvPolynomial.pderiv_rename e.injective (mp (τ a)) (f (τ b))
      rw [hJ, Matrix.det_submatrix_equiv_self, ← RingHom.map_det]
      have h4 := hspan _ hg
      rw [map_sub, map_mul, map_one] at h4
      exact h4
  intro S T _ _ τ hτ t
  letI : Algebra S T := τ.toAlgebra
  unfold wcIndEtale at hτ
  obtain ⟨E, _, _, hE, α, β, hαβ⟩ :=
    hτ (MvPolynomial (Fin 1) S) (MvPolynomial.aeval (fun _ : Fin 1 => t))
  obtain ⟨n, f, val, hsurj, hker, g, hg⟩ := hpres S E hE
  obtain ⟨p, hp⟩ := hsurj (α (MvPolynomial.X 0))
  have hK : ∀ q : MvPolynomial (Fin n) S,
      MvPolynomial.eval₂ τ (fun i => β (val i)) q = β (MvPolynomial.aeval val q) := by
    intro q
    show _ = (β.comp (MvPolynomial.aeval val)) q
    rw [MvPolynomial.comp_aeval, MvPolynomial.aeval_def]
    rfl
  refine ⟨n, f, fun i => β (val i), p, ?_, ?_, ?_⟩
  · intro b
    have hb : f b ∈ RingHom.ker (MvPolynomial.aeval (R := S) val) := by
      rw [hker]; exact Ideal.subset_span ⟨b, rfl⟩
    have hb' : MvPolynomial.aeval val (f b) = 0 := hb
    rw [hK, hb', map_zero]
  · have h1 : g * (Matrix.of fun a b => MvPolynomial.pderiv a (f b)).det - 1 ∈
        RingHom.ker (MvPolynomial.aeval (R := S) val) := by
      rw [hker]; exact hg
    have h1' : MvPolynomial.aeval val
        (g * (Matrix.of fun a b => MvPolynomial.pderiv a (f b)).det - 1) = 0 := h1
    rw [map_sub, map_mul, map_one, sub_eq_zero] at h1'
    have h2 := congrArg β h1'
    rw [map_mul, map_one, ← hK, ← hK] at h2
    exact IsUnit.of_mul_eq_one_right _ h2
  · rw [hK, hp]
    show (β.comp α) (MvPolynomial.X 0) = t
    rw [hαβ, MvPolynomial.aeval_X]

theorem wcl_lift_point_data : ∀ (A S T : Type u) [CommRing A] [CommRing S] [CommRing T] (π : A →+* S) (τ : S →+* T), Function.Surjective π → ∀ (n : ℕ) (f : Fin n → MvPolynomial (Fin n) S) (x : Fin n → T), (∀ b, MvPolynomial.eval₂ τ x (f b) = 0) → IsUnit (MvPolynomial.eval₂ τ x (Matrix.of fun a b => MvPolynomial.pderiv a (f b)).det) → ∃ F : Fin n → MvPolynomial (Fin n) A, (∀ b, MvPolynomial.eval₂ (τ.comp π) x (F b) = 0) ∧ IsUnit (MvPolynomial.eval₂ (τ.comp π) x (Matrix.of fun a b => MvPolynomial.pderiv a (F b)).det) ∧ ∀ p : MvPolynomial (Fin n) S, ∃ P : MvPolynomial (Fin n) A, MvPolynomial.eval₂ (τ.comp π) x P = MvPolynomial.eval₂ τ x p :=
by
  intro A S T _ _ _ π τ hπ n f x hf hJ
  have hΦ : Function.Surjective (MvPolynomial.map (σ := Fin n) π) :=
    MvPolynomial.map_surjective π hπ
  choose F hF using fun b => hΦ (f b)
  have key : ∀ Q : MvPolynomial (Fin n) A,
      MvPolynomial.eval₂ (τ.comp π) x Q = MvPolynomial.eval₂ τ x (MvPolynomial.map π Q) :=
    fun Q => (MvPolynomial.eval₂_map π x τ Q).symm
  have hmat : (MvPolynomial.map (σ := Fin n) π).mapMatrix
      (Matrix.of fun a b => MvPolynomial.pderiv a (F b))
      = Matrix.of fun a b => MvPolynomial.pderiv a (f b) := by
    rw [RingHom.mapMatrix_apply]
    ext a b
    rw [Matrix.map_apply, Matrix.of_apply, Matrix.of_apply, ← MvPolynomial.pderiv_map, hF b]
  refine ⟨F, fun b => by rw [key, hF b, hf b], ?_, fun p => ?_⟩
  · rw [key, RingHom.map_det, hmat]
    exact hJ
  · obtain ⟨P, hP⟩ := hΦ p
    exact ⟨P, by rw [key, hP]⟩

theorem wcl_standardize_point_data : ∀ (A T : Type u) [CommRing A] [CommRing T] (φ : A →+* T) (n : ℕ) (F : Fin n → MvPolynomial (Fin n) A) (x : Fin n → T), (∀ b, MvPolynomial.eval₂ φ x (F b) = 0) → IsUnit (MvPolynomial.eval₂ φ x (Matrix.of fun a b => MvPolynomial.pderiv a (F b)).det) → ∃ (F' : Fin (n + 1) → MvPolynomial (Fin (n + 1)) A) (x' : Fin (n + 1) → T), (∃ g : MvPolynomial (Fin (n + 1)) A, g * (Matrix.of fun a b => MvPolynomial.pderiv a (F' b)).det - 1 ∈ Ideal.span (Set.range F')) ∧ (∀ b, MvPolynomial.eval₂ φ x' (F' b) = 0) ∧ ∀ P : MvPolynomial (Fin n) A, ∃ P' : MvPolynomial (Fin (n + 1)) A, MvPolynomial.eval₂ φ x' P' = MvPolynomial.eval₂ φ x P :=
by
  intro A T _ _ φ n F x hF hΔ
  classical

  have s1 : ∀ p : MvPolynomial (Fin n) A,
      MvPolynomial.pderiv (0 : Fin (n + 1)) (MvPolynomial.rename Fin.succ p) = 0 := by
    intro p
    apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
    intro h
    obtain ⟨i, _, hi⟩ := Finset.mem_image.mp (MvPolynomial.vars_rename Fin.succ p h)
    exact Fin.succ_ne_zero i hi

  have hdet : (Matrix.of fun a b => MvPolynomial.pderiv a
      ((Fin.cons (MvPolynomial.X 0 * MvPolynomial.rename Fin.succ
          (Matrix.of fun a b => MvPolynomial.pderiv a (F b)).det - 1)
        (fun b => MvPolynomial.rename Fin.succ (F b)) :
          Fin (n + 1) → MvPolynomial (Fin (n + 1)) A) b)).det =
      (MvPolynomial.rename Fin.succ
        (Matrix.of fun a b => MvPolynomial.pderiv a (F b)).det) ^ 2 := by
    rw [Matrix.det_succ_row_zero, Fin.sum_univ_succ]
    have h0s : ∀ j : Fin n, (Matrix.of fun a b => MvPolynomial.pderiv a
        ((Fin.cons (MvPolynomial.X 0 * MvPolynomial.rename Fin.succ
            (Matrix.of fun a b => MvPolynomial.pderiv a (F b)).det - 1)
          (fun b => MvPolynomial.rename Fin.succ (F b)) :
            Fin (n + 1) → MvPolynomial (Fin (n + 1)) A) b)) 0 j.succ = 0 := by
      intro j
      rw [Matrix.of_apply, Fin.cons_succ, s1]
    rw [Finset.sum_eq_zero (fun j _ => by rw [h0s j, mul_zero, zero_mul]), add_zero,
      Fin.succAbove_zero]
    have hsub : (Matrix.of fun a b => MvPolynomial.pderiv a
        ((Fin.cons (MvPolynomial.X 0 * MvPolynomial.rename Fin.succ
            (Matrix.of fun a b => MvPolynomial.pderiv a (F b)).det - 1)
          (fun b => MvPolynomial.rename Fin.succ (F b)) :
            Fin (n + 1) → MvPolynomial (Fin (n + 1)) A) b)).submatrix Fin.succ Fin.succ =
        (MvPolynomial.rename Fin.succ :
          MvPolynomial (Fin n) A →ₐ[A] MvPolynomial (Fin (n + 1)) A).mapMatrix
          (Matrix.of fun a b => MvPolynomial.pderiv a (F b)) := by
      refine Matrix.ext fun a b => ?_
      rw [Matrix.submatrix_apply, Matrix.of_apply, Fin.cons_succ, AlgHom.mapMatrix_apply,
        Matrix.map_apply, Matrix.of_apply]
      exact MvPolynomial.pderiv_rename (Fin.succ_injective n) a (F b)
    rw [hsub, ← AlgHom.map_det, Matrix.of_apply, Fin.cons_zero, map_sub, Derivation.leibniz,
      Derivation.map_one_eq_zero, MvPolynomial.pderiv_X_self, s1]
    simp [sq]
  obtain ⟨v, hv⟩ := hΔ
  refine ⟨Fin.cons (MvPolynomial.X 0 * MvPolynomial.rename Fin.succ
          (Matrix.of fun a b => MvPolynomial.pderiv a (F b)).det - 1)
        (fun b => MvPolynomial.rename Fin.succ (F b)),
      Fin.cons (↑v⁻¹ : T) x, ⟨MvPolynomial.X 0 ^ 2, ?_⟩, ?_, ?_⟩
  · rw [hdet]
    have h1 : MvPolynomial.X 0 ^ 2 * (MvPolynomial.rename Fin.succ
        (Matrix.of fun a b => MvPolynomial.pderiv a (F b)).det) ^ 2 - 1 =
        (MvPolynomial.X 0 * MvPolynomial.rename Fin.succ
          (Matrix.of fun a b => MvPolynomial.pderiv a (F b)).det - 1) *
        (MvPolynomial.X 0 * MvPolynomial.rename Fin.succ
          (Matrix.of fun a b => MvPolynomial.pderiv a (F b)).det + 1) := by ring
    rw [h1]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨0, by rw [Fin.cons_zero]⟩)
  · have hx' : (Fin.cons (↑v⁻¹ : T) x : Fin (n + 1) → T) ∘ Fin.succ = x := by
      funext i
      simp
    intro b
    refine Fin.cases ?_ (fun c => ?_) b
    · rw [Fin.cons_zero, MvPolynomial.eval₂_sub, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X,
        MvPolynomial.eval₂_one, MvPolynomial.eval₂_rename, hx', ← hv, Fin.cons_zero,
        Units.inv_mul, sub_self]
    · rw [Fin.cons_succ, MvPolynomial.eval₂_rename, hx', hF]
  · intro P
    refine ⟨MvPolynomial.rename Fin.succ P, ?_⟩
    have hx' : (Fin.cons (↑v⁻¹ : T) x : Fin (n + 1) → T) ∘ Fin.succ = x := by
      funext i
      simp
    rw [MvPolynomial.eval₂_rename, hx']

theorem wcl_weaklyEtale_surj_of_point_data : ∀ (A T : Type u) [CommRing A] [CommRing T] (φ : A →+* T), (∀ t : T, ∃ (n : ℕ) (F : Fin n → MvPolynomial (Fin n) A) (x : Fin n → T) (P : MvPolynomial (Fin n) A), (∃ g : MvPolynomial (Fin n) A, g * (Matrix.of fun a b => MvPolynomial.pderiv a (F b)).det - 1 ∈ Ideal.span (Set.range F)) ∧ (∀ b, MvPolynomial.eval₂ φ x (F b) = 0) ∧ MvPolynomial.eval₂ φ x P = t) → ∃ (C₀ : Type u) (_ : CommRing C₀) (_ : Algebra A C₀) (ρ₀ : C₀ →+* T), Algebra.WeaklyEtale A C₀ ∧ Function.Surjective ρ₀ ∧ ρ₀.comp (algebraMap A C₀) = φ :=
by
  intro A T _ _ φ h
  classical
  choose n F x P hg hF hP using h
  have hInd := wc_sh_family_indEtale A T n F hg
  set K : Ideal (MvPolynomial (Σ t, Fin (n t)) A) :=
    Ideal.span (Set.range (fun p : Σ t, Fin (n t) =>
      MvPolynomial.rename (fun k : Fin (n p.1) => (⟨p.1, k⟩ : Σ t, Fin (n t))) (F p.1 p.2)))
    with hKdef
  have hW' := wc_indEtale_weaklyEtale _ hInd
  have hW : Algebra.WeaklyEtale A (MvPolynomial (Σ t, Fin (n t)) A ⧸ K) := by
    have e : (algebraMap A (MvPolynomial (Σ t, Fin (n t)) A ⧸ K)).toAlgebra =
        (inferInstance : Algebra A (MvPolynomial (Σ t, Fin (n t)) A ⧸ K)) :=
      Algebra.algebra_ext _ _ (fun r => rfl)
    rw [e] at hW'
    exact hW'
  let X : (Σ t, Fin (n t)) → T := fun p => x p.1 p.2
  have hR : ∀ (t : T) (q : MvPolynomial (Fin (n t)) A),
      MvPolynomial.eval₂Hom φ X
        (MvPolynomial.rename (fun k : Fin (n t) => (⟨t, k⟩ : Σ t, Fin (n t))) q) =
        MvPolynomial.eval₂ φ (x t) q := by
    intro t q
    rw [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_rename]
    rfl
  have hK : ∀ a ∈ K, MvPolynomial.eval₂Hom φ X a = 0 := by
    intro a ha
    have hle : K ≤ RingHom.ker (MvPolynomial.eval₂Hom φ X) := by
      rw [hKdef, Ideal.span_le]
      rintro _ ⟨p, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker]
      obtain ⟨t, b⟩ := p
      exact (hR t (F t b)).trans (hF t b)
    exact (RingHom.mem_ker).mp (hle ha)
  let ρ₀ : MvPolynomial (Σ t, Fin (n t)) A ⧸ K →+* T :=
    Ideal.Quotient.lift K (MvPolynomial.eval₂Hom φ X) hK
  refine ⟨MvPolynomial (Σ t, Fin (n t)) A ⧸ K, inferInstance, inferInstance, ρ₀, hW, ?_, ?_⟩
  · intro t
    refine ⟨Ideal.Quotient.mk K
      (MvPolynomial.rename (fun k : Fin (n t) => (⟨t, k⟩ : Σ t, Fin (n t))) (P t)), ?_⟩
    show Ideal.Quotient.lift K (MvPolynomial.eval₂Hom φ X) hK (Ideal.Quotient.mk K _) = t
    rw [Ideal.Quotient.lift_mk, hR, hP]
  · ext a
    rw [RingHom.comp_apply, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
    show Ideal.Quotient.lift K (MvPolynomial.eval₂Hom φ X) hK (Ideal.Quotient.mk K _) = φ a
    rw [Ideal.Quotient.lift_mk, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_C]

theorem wcl_localize_tensor_iso : ∀ (A Abar C₀ T : Type u) [CommRing A] [CommRing Abar] [CommRing C₀] [CommRing T] [Algebra A Abar] [Algebra A C₀] (τ : Abar →+* T) (ρ₀ : C₀ →+* T), Function.Surjective (algebraMap A Abar) → Function.Surjective ρ₀ → ρ₀.comp (algebraMap A C₀) = τ.comp (algebraMap A Abar) → Algebra.WeaklyEtale A C₀ → @Algebra.WeaklyEtale Abar T _ _ τ.toAlgebra → ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C) (ρ : C →+* T) (Θ : TensorProduct A C Abar ≃+* T), Algebra.WeaklyEtale A C ∧ ρ.comp (algebraMap A C) = τ.comp (algebraMap A Abar) ∧ (∀ c : C, Θ ((Algebra.TensorProduct.includeLeft : C →ₐ[A] TensorProduct A C Abar) c) = ρ c) ∧ ∀ a : Abar, Θ ((Algebra.TensorProduct.includeRight : Abar →ₐ[A] TensorProduct A C Abar) a) = τ a :=
by
  intro A Abar C₀ T _ _ _ _ _ _ τ ρ₀ hπ hρ₀S hρ₀ hC₀W hτW
  classical

  have s1 : ∃ (C : Type u) (_ : CommRing C) (_ : Algebra C₀ C) (ρ : C →+* T),
      Algebra.WeaklyEtale C₀ C ∧ ρ.comp (algebraMap C₀ C) = ρ₀ ∧ Function.Surjective ρ ∧
      ∀ c : C, IsUnit (ρ c) → IsUnit c := by
    let M : Submonoid C₀ := Submonoid.comap ρ₀ (IsUnit.submonoid T)
    have hM : ∀ y : M, IsUnit (ρ₀ y) := fun y =>
      (IsUnit.mem_submonoid_iff _).1 (Submonoid.mem_comap.1 y.2)
    have hρapp : ∀ x, (IsLocalization.lift (M := M) (S := Localization M) hM)
        (algebraMap C₀ (Localization M) x) = ρ₀ x := fun x => IsLocalization.lift_eq hM x
    refine ⟨Localization M, inferInstance, inferInstance,
      IsLocalization.lift (M := M) (S := Localization M) hM,
      wc_localization_weaklyEtale C₀ (Localization M) M, IsLocalization.lift_comp hM, ?_, ?_⟩
    · intro t
      obtain ⟨x, rfl⟩ := hρ₀S t
      exact ⟨algebraMap C₀ (Localization M) x, hρapp x⟩
    · intro c hc
      obtain ⟨⟨x, m⟩, rfl⟩ := IsLocalization.mk'_surjective M c
      have hspec := IsLocalization.mk'_spec (Localization M) x m
      have h1 : (IsLocalization.lift (M := M) (S := Localization M) hM)
          (IsLocalization.mk' (Localization M) x m) * ρ₀ m = ρ₀ x := by
        rw [← hρapp, ← hρapp, ← map_mul, hspec]
      have hx : IsUnit (ρ₀ x) := h1 ▸ hc.mul (hM m)
      have hxM : x ∈ M := Submonoid.mem_comap.2 ((IsUnit.mem_submonoid_iff _).2 hx)
      have hxu : IsUnit (algebraMap C₀ (Localization M) x) :=
        IsLocalization.map_units (Localization M) (⟨x, hxM⟩ : M)
      rw [← hspec] at hxu
      exact isUnit_of_mul_isUnit_left hxu
  obtain ⟨C, _, _, ρ, hCW₀, hρc, hρS, hρU⟩ := s1
  letI : Algebra A C := ((algebraMap C₀ C).comp (algebraMap A C₀)).toAlgebra
  haveI : IsScalarTower A C₀ C := IsScalarTower.of_algebraMap_eq' rfl
  have hCW : Algebra.WeaklyEtale A C := Algebra.WeaklyEtale.trans A C₀ C
  have hρA : ρ.comp (algebraMap A C) = τ.comp (algebraMap A Abar) := by
    rw [IsScalarTower.algebraMap_eq A C₀ C, ← RingHom.comp_assoc, hρc, hρ₀]

  letI : Algebra A T := (τ.comp (algebraMap A Abar)).toAlgebra
  let τA : Abar →ₐ[A] T := { τ with commutes' := fun a => rfl }
  let ρA : C →ₐ[A] T := { ρ with commutes' := fun a => RingHom.congr_fun hρA a }
  let Θ' : TensorProduct A Abar C →+* T := (Algebra.TensorProduct.productMap τA ρA).toRingHom
  have hV : ∀ (a : Abar) (c : C), Θ' (TensorProduct.tmul A a c) = τ a * ρ c := fun a c =>
    Algebra.TensorProduct.productMap_apply_tmul τA ρA a c
  have hΘS : Function.Surjective Θ' := by
    intro t
    obtain ⟨c, hc⟩ := hρS t
    exact ⟨TensorProduct.tmul A 1 c, by rw [hV, map_one, one_mul, hc]⟩
  have hiR : Function.Surjective
      (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A Abar C) :=
    Algebra.TensorProduct.includeRight_surjective _ hπ
  have hΘU : ∀ r, IsUnit (Θ' r) → IsUnit r := by
    intro r hr
    obtain ⟨c, rfl⟩ := hiR r
    rw [Algebra.TensorProduct.includeRight_apply, hV, map_one, one_mul] at hr
    exact (hρU c hr).map _

  letI : Algebra (TensorProduct A Abar C) T := Θ'.toAlgebra
  letI : Algebra Abar T := τ.toAlgebra
  haveI : IsScalarTower Abar (TensorProduct A Abar C) T := IsScalarTower.of_algebraMap_eq' (by
    ext a
    show τ a = Θ' (algebraMap Abar (TensorProduct A Abar C) a)
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self_apply, hV, map_one, mul_one])
  have hW' : Algebra.WeaklyEtale (TensorProduct A Abar C) T :=
    wc_weaklyEtale_cancel Abar _ T inferInstance hτW
  have hflat : Module.Flat (TensorProduct A Abar C) T := hW'.flat

  have hinj : Function.Injective Θ' := by
    rw [injective_iff_map_eq_zero]
    intro r hr
    have hrel : ∑ i : Fin 1, (fun _ : Fin 1 => r) i • (fun _ : Fin 1 => (1 : T)) i = 0 := by
      rw [Fin.sum_univ_one, Algebra.smul_def, mul_one]
      exact hr
    have htriv : Module.IsTrivialRelation (fun _ : Fin 1 => r) (fun _ : Fin 1 => (1 : T)) :=
      Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
    obtain ⟨κ, a, y, hy, ha⟩ := htriv
    choose s hs using fun j => hΘS (y j)
    have h1 : (1 : T) = ∑ j, a 0 j • y j := hy 0
    have hS : Θ' (∑ j, a 0 j * s j) = 1 := by
      rw [h1, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_mul, hs j, Algebra.smul_def]
      rfl
    have hSu : IsUnit (∑ j, a 0 j * s j) := hΘU _ (hS ▸ isUnit_one)
    have hrS : r * (∑ j, a 0 j * s j) = 0 := by
      rw [Finset.mul_sum]
      refine Finset.sum_eq_zero (fun j _ => ?_)
      have h2 := ha j
      rw [Fin.sum_univ_one] at h2
      have h3 : r * a 0 j = 0 := h2
      rw [← mul_assoc, h3, zero_mul]
    exact (IsUnit.mul_left_eq_zero hSu).mp hrS

  have hbij : Function.Bijective Θ' := ⟨hinj, hΘS⟩
  refine ⟨C, inferInstance, inferInstance, ρ,
    (Algebra.TensorProduct.comm A C Abar).toRingEquiv.trans
      (RingEquiv.ofBijective Θ' hbij), hCW, hρA, ?_, ?_⟩
  · intro c
    show Θ' (Algebra.TensorProduct.comm A C Abar (TensorProduct.tmul A c 1)) = ρ c
    rw [Algebra.TensorProduct.comm_tmul, hV, map_one, one_mul]
  · intro a
    show Θ' (Algebra.TensorProduct.comm A C Abar (TensorProduct.tmul A 1 a)) = τ a
    rw [Algebra.TensorProduct.comm_tmul, hV, map_one, mul_one]

theorem wc_weaklyEtale_cover_lift_along_surjection (A Abar Bbar : Type u) [CommRing A] [CommRing Abar]
    [CommRing Bbar] [Algebra A Abar] [Algebra Abar Bbar]
    (hπ : Function.Surjective (algebraMap A Abar))
    (hW : Algebra.WeaklyEtale Abar Bbar)
    (hS : Function.Surjective (PrimeSpectrum.comap (algebraMap Abar Bbar))) :
    ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C)
      (β : Bbar →+* TensorProduct A C Abar),
      Algebra.WeaklyEtale A C ∧
      β.comp (algebraMap Abar Bbar) = (Algebra.TensorProduct.includeRight : Abar →ₐ[A] TensorProduct A C Abar).toRingHom ∧
      ∀ p : PrimeSpectrum A, RingHom.ker (algebraMap A Abar) ≤ p.asIdeal →
        p ∈ Set.range (PrimeSpectrum.comap (algebraMap A C)) :=
by
  classical

  obtain ⟨T, _, _, hFF, hWT, hInd⟩ := wc_bs_weaklyEtale_indEtale_locally Abar Bbar hW
  obtain ⟨τ, hτ⟩ : ∃ τ : Abar →+* T, τ = (algebraMap Bbar T).comp (algebraMap Abar Bbar) :=
    ⟨_, rfl⟩
  rw [← hτ] at hInd

  have hτW : @Algebra.WeaklyEtale Abar T _ _ τ.toAlgebra := by
    letI : Algebra Abar T := τ.toAlgebra
    haveI := hW
    haveI := hWT
    haveI : IsScalarTower Abar Bbar T := IsScalarTower.of_algebraMap_eq' hτ
    exact Algebra.WeaklyEtale.trans Abar Bbar T
  have hτS : Function.Surjective (PrimeSpectrum.comap τ) := by
    intro p
    obtain ⟨q, hq⟩ := hS p
    haveI := hFF
    obtain ⟨r, hr⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := Bbar) (B := T) q
    refine ⟨r, PrimeSpectrum.ext ?_⟩
    rw [← hq, ← hr, hτ]
    rfl

  have hdata : ∀ t : T, ∃ (n : ℕ) (F : Fin n → MvPolynomial (Fin n) A) (x : Fin n → T)
      (P : MvPolynomial (Fin n) A),
      (∃ g : MvPolynomial (Fin n) A,
        g * (Matrix.of fun a b => MvPolynomial.pderiv a (F b)).det - 1 ∈ Ideal.span (Set.range F)) ∧
      (∀ b, MvPolynomial.eval₂ (τ.comp (algebraMap A Abar)) x (F b) = 0) ∧
      MvPolynomial.eval₂ (τ.comp (algebraMap A Abar)) x P = t := by
    intro t
    obtain ⟨n, f, x, p, hf, hJ, hp⟩ := wcl_indEtale_point_data Abar T τ hInd t
    obtain ⟨F, hF, hFJ, hlift⟩ := wcl_lift_point_data A Abar T (algebraMap A Abar) τ hπ n f x hf hJ
    obtain ⟨P, hP⟩ := hlift p
    obtain ⟨F', x', hg, hF', hold⟩ :=
      wcl_standardize_point_data A T (τ.comp (algebraMap A Abar)) n F x hF hFJ
    obtain ⟨P', hP'⟩ := hold P
    exact ⟨n + 1, F', x', P', hg, hF', by rw [hP', hP, hp]⟩

  obtain ⟨C₀, _, _, ρ₀, hC₀W, hρ₀S, hρ₀⟩ :=
    wcl_weaklyEtale_surj_of_point_data A T (τ.comp (algebraMap A Abar)) hdata

  obtain ⟨C, _, _, ρ, Θ, hCW, hρ, -, hΘR⟩ :=
    wcl_localize_tensor_iso A Abar C₀ T τ ρ₀ hπ hρ₀S hρ₀ hC₀W hτW

  refine ⟨C, inferInstance, inferInstance, Θ.symm.toRingHom.comp (algebraMap Bbar T), hCW, ?_, ?_⟩
  · ext a
    show Θ.symm (algebraMap Bbar T (algebraMap Abar Bbar a)) =
      (Algebra.TensorProduct.includeRight : Abar →ₐ[A] TensorProduct A C Abar) a
    rw [RingEquiv.symm_apply_eq, hΘR a, hτ]
    rfl
  · intro p hp
    have hpr : (Ideal.map (algebraMap A Abar) p.asIdeal).IsPrime :=
      Ideal.map_isPrime_of_surjective hπ hp
    obtain ⟨q, hq⟩ := hτS ⟨Ideal.map (algebraMap A Abar) p.asIdeal, hpr⟩
    refine ⟨PrimeSpectrum.comap ρ q, PrimeSpectrum.ext ?_⟩
    have h1 : Ideal.comap (algebraMap A C) (Ideal.comap ρ q.asIdeal) =
        Ideal.comap (algebraMap A Abar) (Ideal.comap τ q.asIdeal) := by
      rw [Ideal.comap_comap, Ideal.comap_comap, hρ]
    have h2 : Ideal.comap τ q.asIdeal = Ideal.map (algebraMap A Abar) p.asIdeal :=
      congrArg PrimeSpectrum.asIdeal hq
    show Ideal.comap (algebraMap A C) (Ideal.comap ρ q.asIdeal) = p.asIdeal
    rw [h1, h2, Ideal.comap_map_of_surjective' (algebraMap A Abar) hπ, sup_eq_left]
    exact hp

theorem wc_closed_proet_cover_extension_affine {X Y : Scheme.{u}} (i : X ⟶ Y) [IsClosedImmersion i]
    (U : Y.ProEt) [IsAffine U.left] (V' : X.ProEt) (g' : V' ⟶ (wcProEtBC i).obj U)
    (hV' : IsAffine V'.left) (hg' : Surjective g'.left)
    (hlift : ∀ (A Abar Bbar : Type u) [CommRing A] [CommRing Abar] [CommRing Bbar]
      [Algebra A Abar] [Algebra Abar Bbar],
      Function.Surjective (algebraMap A Abar) → Algebra.WeaklyEtale Abar Bbar →
      Function.Surjective (PrimeSpectrum.comap (algebraMap Abar Bbar)) →
      ∃ (C : Type u) (_ : CommRing C) (_ : Algebra A C)
        (β : Bbar →+* TensorProduct A C Abar),
        Algebra.WeaklyEtale A C ∧
        β.comp (algebraMap Abar Bbar) = (Algebra.TensorProduct.includeRight : Abar →ₐ[A] TensorProduct A C Abar).toRingHom ∧
        ∀ p : PrimeSpectrum A, RingHom.ker (algebraMap A Abar) ≤ p.asIdeal →
          p ∈ Set.range (PrimeSpectrum.comap (algebraMap A C))) :
    ∃ (W : Y.ProEt) (w : W ⟶ U) (a : (wcProEtBC i).obj W ⟶ V'),
      IsAffine W.left ∧ a ≫ g' = (wcProEtBC i).map w ∧
      ∀ y : U.left, y ∈ Set.range (Limits.pullback.fst U.hom i) → y ∈ Set.range w.left :=
by
  classical
  haveI hV'i : IsAffine V'.left := hV'

  have toSch : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
      Algebra.WeaklyEtale R' S' → WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
    intro R' S' _ _ _ hW
    have hfl : Flat (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff]
      exact hW.flat
    have hmu : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom]
      exact hW.flat_lmul'
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R' S')))) := by
      rw [diagonal_SpecMap]
      infer_instance
    exact ⟨hfl, hd⟩

  have toRing : ∀ (R' S' : Type u) [CommRing R'] [CommRing S'] [Algebra R' S'],
      WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R' S'))) → Algebra.WeaklyEtale R' S' := by
    intro R' S' _ _ _ hW
    have hfl : Module.Flat R' S' := by
      have := hW.flat
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff] at this
      exact this
    have hd := hW.flat_diagonal
    rw [diagonal_SpecMap] at hd
    have hmu : Flat (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom)) := by
      have e : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) =
          (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R' (S := S')).toRingHom) ≫
            (pullbackSpecIso R' S' S').inv) ≫ (pullbackSpecIso R' S' S').hom := by
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      haveI := hd
      infer_instance
    rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hmu
    exact Algebra.WeaklyEtale.mk hfl hmu

  have appTopWE : ∀ {X Z : Scheme.{u}} [IsAffine X] [IsAffine Z] (h : X ⟶ Z), WeaklyEtale h →
      WeaklyEtale (Spec.map h.appTop) := by
    intro X Z _ _ h hh
    have e : Spec.map h.appTop = X.isoSpec.inv ≫ h ≫ Z.isoSpec.hom := by
      rw [← Scheme.isoSpec_hom_naturality, Iso.inv_hom_id_assoc]
    rw [e]
    infer_instance
  have hinv : ∀ (S : Scheme.{u}) [IsAffine S], S.isoSpec.inv.appTop = (Scheme.ΓSpecIso Γ(S, ⊤)).inv := by
    intro S _
    rw [← Iso.comp_hom_eq_id, ← Scheme.toSpecΓ_appTop, ← Scheme.isoSpec_hom,
      ← Scheme.Hom.comp_appTop, Iso.hom_inv_id, Scheme.Hom.id_appTop]

  haveI hUaff' : IsAffine ((𝟭 Scheme.{u}).obj U.left) := inferInstanceAs (IsAffine U.left)
  haveI hjci : IsClosedImmersion (Limits.pullback.fst U.hom i) := inferInstance
  obtain ⟨hZaff, hjsurj⟩ :=
    IsClosedImmersion.isAffine_surjective_of_isAffine (Limits.pullback.fst U.hom i)
  haveI := hZaff
  obtain ⟨g0, hg0def⟩ : ∃ g0 : V'.left ⟶ Limits.pullback U.hom i, g0 = g'.left := ⟨_, rfl⟩
  have hw0 : g0 ≫ Limits.pullback.snd U.hom i = V'.hom := by
    rw [hg0def]; exact MorphismProperty.Over.w g'
  have hg0s : Surjective g0 := by rw [hg0def]; exact hg'

  have hg0 : WeaklyEtale g0 := by
    have h1 : WeaklyEtale (g0 ≫ Limits.pullback.snd U.hom i) := by
      rw [hw0]; exact V'.prop
    have h2 : WeaklyEtale (Limits.pullback.snd U.hom i) := ((wcProEtBC i).obj U).prop
    exact @WeaklyEtale.of_comp _ _ _ g0 _ h1 h2
  letI alg1 : Algebra Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤) :=
    (Limits.pullback.fst U.hom i).appTop.hom.toAlgebra
  letI alg2 : Algebra Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) := g0.appTop.hom.toAlgebra
  have hπ : Function.Surjective (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)) := hjsurj
  have hW : Algebra.WeaklyEtale Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) :=
    toRing _ _ (appTopWE g0 hg0)

  have hS : Function.Surjective
      (PrimeSpectrum.comap (algebraMap Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤))) := by
    intro Q
    obtain ⟨v, hv⟩ := hg0s.surj ((Limits.pullback U.hom i).isoSpec.inv Q)
    refine ⟨V'.left.isoSpec.hom v, ?_⟩
    have e2 : (Spec.map g0.appTop) (V'.left.isoSpec.hom v) =
        (Limits.pullback U.hom i).isoSpec.hom (g0 v) := by
      rw [← Scheme.Hom.comp_apply, Scheme.isoSpec_hom_naturality, Scheme.Hom.comp_apply]
    rw [hv] at e2
    exact e2.trans (Scheme.inv_hom_apply _ _)

  obtain ⟨C, _, _, β, hC, hβ, hcov⟩ :=
    hlift Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤) hπ hW hS

  haveI := toSch _ _ hC
  haveI := U.prop
  obtain ⟨p, hpdef⟩ : ∃ p : Spec (CommRingCat.of C) ⟶ U.left,
      p = Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C)) ≫ U.left.isoSpec.inv :=
    ⟨_, rfl⟩
  haveI hpwe : WeaklyEtale p := by rw [hpdef]; infer_instance
  have hp : p.appTop = CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C) ≫
      (Scheme.ΓSpecIso (CommRingCat.of C)).inv := by
    rw [Scheme.ΓSpecIso_inv_naturality, hpdef, Scheme.Hom.comp_appTop, hinv U.left]
    rfl

  obtain ⟨m, hmdef⟩ : ∃ m : Limits.pullback (p ≫ U.hom) i ⟶ Limits.pullback U.hom i,
      m = ((wcProEtBC i).map
        (MorphismProperty.Over.homMk p rfl trivial : Scheme.ProEt.mk (p ≫ U.hom) ⟶ U)).left :=
    ⟨_, rfl⟩
  have hsq : m ≫ Limits.pullback.fst U.hom i = Limits.pullback.fst (p ≫ U.hom) i ≫ p := by
    rw [hmdef]
    exact Limits.pullback.lift_fst _ _ _
  have hmsnd : m ≫ Limits.pullback.snd U.hom i = Limits.pullback.snd (p ≫ U.hom) i := by
    rw [hmdef]
    exact MorphismProperty.Over.w ((wcProEtBC i).map
        (MorphismProperty.Over.homMk p rfl trivial : Scheme.ProEt.mk (p ≫ U.hom) ⟶ U))
  letI alg3 : Algebra Γ(U.left, ⊤) Γ(Limits.pullback (p ≫ U.hom) i, ⊤) :=
    (m ≫ Limits.pullback.fst U.hom i).appTop.hom.toAlgebra
  have hc2 : ∀ a : Γ(U.left, ⊤), m.appTop.hom
      (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤) a) =
      algebraMap Γ(U.left, ⊤) Γ(Limits.pullback (p ≫ U.hom) i, ⊤) a := by
    intro a
    show m.appTop.hom ((Limits.pullback.fst U.hom i).appTop.hom a) =
      (m ≫ Limits.pullback.fst U.hom i).appTop.hom a
    rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
    rfl
  let c₂ : Γ(Limits.pullback U.hom i, ⊤) →ₐ[Γ(U.left, ⊤)] Γ(Limits.pullback (p ≫ U.hom) i, ⊤) :=
    { m.appTop.hom with commutes' := hc2 }
  have hc1 : ∀ a : Γ(U.left, ⊤),
      ((Scheme.ΓSpecIso (CommRingCat.of C)).inv ≫
        (Limits.pullback.fst (p ≫ U.hom) i).appTop).hom (algebraMap Γ(U.left, ⊤) C a) =
      algebraMap Γ(U.left, ⊤) Γ(Limits.pullback (p ≫ U.hom) i, ⊤) a := by
    intro a
    have e : CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C) ≫
        (Scheme.ΓSpecIso (CommRingCat.of C)).inv ≫ (Limits.pullback.fst (p ≫ U.hom) i).appTop =
        (m ≫ Limits.pullback.fst U.hom i).appTop := by
      rw [hsq, Scheme.Hom.comp_appTop, hp, Category.assoc]
    exact congrArg (fun φ => φ.hom a) e
  let c₁ : C →ₐ[Γ(U.left, ⊤)] Γ(Limits.pullback (p ≫ U.hom) i, ⊤) :=
    { ((Scheme.ΓSpecIso (CommRingCat.of C)).inv ≫
        (Limits.pullback.fst (p ≫ U.hom) i).appTop).hom with commutes' := hc1 }
  let χ := Algebra.TensorProduct.productMap c₁ c₂
  have hstar : (χ.toRingHom.comp β).comp
      (algebraMap Γ(Limits.pullback U.hom i, ⊤) Γ(V'.left, ⊤)) = m.appTop.hom := by
    rw [RingHom.comp_assoc, hβ]
    ext x
    show χ (Algebra.TensorProduct.includeRight x) = m.appTop.hom x
    rw [Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.productMap_right_apply]
    rfl
  obtain ⟨ψc, hψc⟩ : ∃ ψc : Γ(V'.left, ⊤) ⟶ Γ(Limits.pullback (p ≫ U.hom) i, ⊤),
      ψc.hom = χ.toRingHom.comp β := ⟨CommRingCat.ofHom _, rfl⟩
  obtain ⟨a₀, ha₀def⟩ : ∃ a₀ : Limits.pullback (p ≫ U.hom) i ⟶ V'.left,
      a₀ = (Limits.pullback (p ≫ U.hom) i).toSpecΓ ≫ Spec.map ψc ≫ V'.left.isoSpec.inv :=
    ⟨_, rfl⟩
  have ha₀ : a₀.appTop = ψc := by
    rw [ha₀def, Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, hinv V'.left,
      Scheme.toSpecΓ_appTop, ← Scheme.ΓSpecIso_inv_naturality, Category.assoc, Iso.inv_hom_id,
      Category.comp_id]

  have h8a : a₀ ≫ g0 = m := by
    apply ext_of_isAffine
    rw [Scheme.Hom.comp_appTop, ha₀]
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_comp, hψc]
    exact hstar
  have h8b : a₀ ≫ V'.hom = Limits.pullback.snd (p ≫ U.hom) i := by
    rw [← hw0, ← Category.assoc, h8a, hmsnd]
  refine ⟨Scheme.ProEt.mk (p ≫ U.hom), MorphismProperty.Over.homMk p rfl trivial,
    MorphismProperty.Over.homMk a₀ h8b trivial, ?_, ?_, ?_⟩
  · show IsAffine (Spec (CommRingCat.of C))
    infer_instance
  · apply MorphismProperty.Over.Hom.ext
    have e := h8a
    rw [hg0def, hmdef] at e
    exact e
  · intro y hy
    obtain ⟨z, rfl⟩ := hy
    have e1 : U.left.isoSpec.hom (Limits.pullback.fst U.hom i z) =
        (Spec.map (Limits.pullback.fst U.hom i).appTop) ((Limits.pullback U.hom i).isoSpec.hom z) := by
      rw [← Scheme.Hom.comp_apply, ← Scheme.isoSpec_hom_naturality, Scheme.Hom.comp_apply]
    have hker : RingHom.ker (algebraMap Γ(U.left, ⊤) Γ(Limits.pullback U.hom i, ⊤)) ≤
        (U.left.isoSpec.hom (Limits.pullback.fst U.hom i z)).asIdeal := by
      intro a ha
      rw [e1]
      show a ∈ Ideal.comap (Limits.pullback.fst U.hom i).appTop.hom
        ((Limits.pullback U.hom i).isoSpec.hom z).asIdeal
      rw [Ideal.mem_comap]
      have h0 : (Limits.pullback.fst U.hom i).appTop.hom a = 0 := ha
      rw [h0]
      exact zero_mem _
    obtain ⟨q, hq⟩ := hcov _ hker
    refine ⟨q, ?_⟩
    have hq' : (Spec.map (CommRingCat.ofHom (algebraMap Γ(U.left, ⊤) C))) q =
        U.left.isoSpec.hom (Limits.pullback.fst U.hom i z) := hq
    show p q = _
    subst hpdef
    exact (congrArg U.left.isoSpec.inv hq').trans (Scheme.hom_inv_apply _ _)

theorem wc_closed_pushforward_exact_of_noetherian {X Y : Scheme.{u}} (i : X ⟶ Y)
    [IsClosedImmersion i] [IsLocallyNoetherian Y] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i ℓ) :
    Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ D.cont D.φ) :=
by
  classical
  haveI hcont := D.cont

  have affine_local : ∀ (U : Y.ProEt) (R : Sieve U),
      (∀ (V : Y.ProEt) (f : V ⟶ U), IsAffine V.left → R.pullback f ∈ Scheme.ProEt.topology Y V) →
      R ∈ Scheme.ProEt.topology Y U := by
    intro U R hR
    have hU : WeaklyEtale U.hom := U.prop
    let W : U.left.affineCover.I₀ → Y.ProEt := fun j =>
      MorphismProperty.Over.mk ⊤ (U.left.affineCover.f j ≫ U.hom) inferInstance
    let e : ∀ j, W j ⟶ U := fun j =>
      MorphismProperty.Over.homMk (U.left.affineCover.f j) rfl trivial
    have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage Y).coverings U := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget Y ⋙ Over.forget Y)
        Scheme.proetalePrecoverage).coverings U
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
        U.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun j => inferInstance)⟩
    refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) R ?_
    intro Z f hf
    obtain ⟨Z', h, g', hg', rfl⟩ := hf
    rcases hg' with ⟨j⟩
    rw [Sieve.pullback_comp]
    exact GrothendieckTopology.pullback_stable _ h
      (hR (W j) (e j) (show IsAffine (U.left.affineCover.X j) by infer_instance))

  have hepi : ∀ {F F' : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}} (φ : F ⟶ F'),
      Epi φ → Epi ((@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC i) AddCommGrpCat.{u+1} _
        (Scheme.ProEt.topology Y) (Scheme.ProEt.topology X) D.cont).map φ) := by
    intro F F' φ hφ
    have hF' : Presieve.IsSheaf (Scheme.ProEt.topology X) (F'.obj ⋙ forget AddCommGrpCat.{u+1}) :=
      (isSheaf_iff_isSheaf_of_type _ _).mp ((Presheaf.isSheaf_iff_isSheaf_forget
        (Scheme.ProEt.topology X) F'.obj (forget AddCommGrpCat.{u+1})).mp F'.property)

    have hloc : ∀ (V : Y.ProEt), IsAffine V.left →
        ∀ (y' : F'.obj.obj (Opposite.op ((wcProEtBC i).obj V))),
        ∃ (n : ℕ) (Wf : Fin n → Y.ProEt) (wf : ∀ k, Wf k ⟶ V),
          Sieve.generate (Presieve.ofArrows Wf wf) ∈ Scheme.ProEt.topology Y V ∧
          ∀ k, ∃ x : F.obj.obj (Opposite.op ((wcProEtBC i).obj (Wf k))),
            φ.hom.app (Opposite.op ((wcProEtBC i).obj (Wf k))) x =
              F'.obj.map ((wcProEtBC i).map (wf k)).op y' := by
      intro V hV y'
      haveI : IsAffine V.left := hV
      haveI hGV : IsAffine ((wcProEtBC i).obj V).left := by
        show IsAffine (Limits.pullback V.hom i)
        exact (@IsClosedImmersion.isAffine_surjective_of_isAffine _ _ hV
          (Limits.pullback.fst V.hom i) _).1
      obtain ⟨V', g', x', hV', hg', hx'⟩ :=
        wc_proet_epi_affine_lift X φ hφ ((wcProEtBC i).obj V) hGV y'
      obtain ⟨W₀, w₀, a, hW₀, ha, hcov₀⟩ := wc_closed_proet_cover_extension_affine i V V' g' hV' hg'
        wc_weaklyEtale_cover_lift_along_surjection
      obtain ⟨m, W, w, hWaff, hWempty, hcovW⟩ := wc_closed_compl_proet_finite_cover i V
      refine ⟨m + 1, fun k => Fin.cases W₀ W k, fun k => Fin.cases w₀ w k, ?_, ?_⟩
      · apply proet_finite_affine_jointly_surjective_covers Y V (m + 1)
        · intro k
          refine Fin.cases ?_ (fun j => ?_) k
          · exact hW₀
          · exact hWaff j
        · intro y
          by_cases hy : y ∈ Set.range (Limits.pullback.fst V.hom i)
          · exact ⟨0, hcov₀ y hy⟩
          · obtain ⟨j, hj⟩ := hcovW y hy
            exact ⟨j.succ, hj⟩
      · intro k
        refine Fin.cases ?_ (fun j => ?_) k
        · refine ⟨F.obj.map a.op x', ?_⟩
          show φ.hom.app (Opposite.op ((wcProEtBC i).obj W₀)) (F.obj.map a.op x') =
            F'.obj.map ((wcProEtBC i).map w₀).op y'
          rw [NatTrans.naturality_apply, hx', ← ha, op_comp, Functor.map_comp,
            ConcreteCategory.comp_apply]
        · haveI : IsEmpty ((wcProEtBC i).obj (W j)).left := hWempty j
          refine ⟨0, ?_⟩
          show φ.hom.app (Opposite.op ((wcProEtBC i).obj (W j))) 0 =
            F'.obj.map ((wcProEtBC i).map (w j)).op y'
          have hbot : Presieve.IsSheafFor (F'.obj ⋙ forget AddCommGrpCat.{u+1})
              (⊥ : Presieve ((wcProEtBC i).obj (W j))) :=
            hF'.isSheafFor ⊥ (by rw [Sieve.generate_bot]; exact Scheme.ProEt.bot_mem_topology _)
          exact hbot.isSeparatedFor (fun _ _ h => h.elim) _ _ (fun _ _ h => h.elim)
            (fun _ _ h => h.elim)
    refine (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp ⟨fun {U} y => ?_⟩
    apply affine_local U
    intro V f hV
    obtain ⟨n, Wf, wf, hcov, hx⟩ := hloc V hV (F'.obj.map ((wcProEtBC i).map f).op y)
    refine GrothendieckTopology.superset_covering _ ?_ hcov
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨k⟩
    obtain ⟨x, hxk⟩ := hx k
    show ∃ t, φ.hom.app (Opposite.op ((wcProEtBC i).obj (Wf k))) t =
      F'.obj.map ((wcProEtBC i).map (wf k ≫ f)).op y
    refine ⟨x, hxk.trans ?_⟩
    show (F'.obj.map ((wcProEtBC i).map (wf k)).op) ((F'.obj.map ((wcProEtBC i).map f).op) y) =
      (F'.obj.map ((wcProEtBC i).map (wf k ≫ f)).op) y
    rw [Functor.map_comp, op_comp, Functor.map_comp]
    rfl

  haveI hPE : (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC i) AddCommGrpCat.{u+1} _
      (Scheme.ProEt.topology Y) (Scheme.ProEt.topology X) D.cont).PreservesEpimorphisms :=
    ⟨by intro A B f hf; exact hepi f hf⟩
  haveI hPH : (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC i) AddCommGrpCat.{u+1} _
      (Scheme.ProEt.topology Y) (Scheme.ProEt.topology X) D.cont).PreservesHomology :=
    Functor.preservesHomology_of_preservesEpis_and_kernels _
  haveI hPA : (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC i) AddCommGrpCat.{u+1} _
      (Scheme.ProEt.topology Y) (Scheme.ProEt.topology X) D.cont).Additive :=
    Functor.additive_of_preserves_binary_products _
  haveI hPC : Limits.PreservesFiniteColimits
      (@Functor.sheafPushforwardContinuous _ _ _ _ (wcProEtBC i) AddCommGrpCat.{u+1} _
        (Scheme.ProEt.topology Y) (Scheme.ProEt.topology X) D.cont) :=
    Functor.preservesFiniteColimits_of_preservesHomology _

  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology Y) (wcRingSheaf Y ℓ)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology X) (wcRingSheaf X ℓ)
  exact (sheafOfModules_pushforward_exact (wcProEtBC i) (wcRingSheaf Y ℓ) (wcRingSheaf X ℓ)
    D.φ).2.2

theorem wc_int_tors_toSheaf_iso (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) :
    Nonempty ((SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).obj (wcIntTors S ℓ m) ≅
      wcContSheaf S (ZMod (ℓ ^ m))) :=
by
  haveI hGC := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology S)
    (wcIntRingSheaf S ℓ)

  have hι : Nonempty ((SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).obj (wcIntUnit S ℓ) ≅
      wcIntSheaf S ℓ) := by
    let e : ∀ V : (S.ProEt)ᵒᵖ,
        C(↥V.unop.left, ULift.{u+1} ℤ_[ℓ]) ≃+ ULift.{u+1} C(↥V.unop.left, ℤ_[ℓ]) :=
      fun V =>
        { toFun := fun r => ULift.up ⟨fun t => (r t).down, continuous_uliftDown.comp r.continuous⟩
          invFun := fun w => ⟨fun t => ULift.up (w.down t), continuous_uliftUp.comp w.down.continuous⟩
          left_inv := fun _ => rfl
          right_inv := fun _ => rfl
          map_add' := fun _ _ => rfl }
    let φ : ∀ V : (S.ProEt)ᵒᵖ,
        ((SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).obj (wcIntUnit S ℓ)).obj.obj V ≅
        (wcIntSheaf S ℓ).obj.obj V :=
      fun V => (e V).toAddCommGrpIso
    refine ⟨(fullyFaithfulSheafToPresheaf _ _).preimageIso (NatIso.ofComponents φ ?_)⟩
    intro V W f
    ext r
    rfl
  obtain ⟨ι⟩ := hι

  obtain ⟨h1, -, hadd, -⟩ := wc_int_scalar_ring S ℓ
  have hnat : ∀ j : ℕ, wcIntScalar S ℓ (j : ℤ_[ℓ]) = j • 𝟙 (wcIntSheaf S ℓ) := by
    intro j
    induction j with
    | zero =>
      have h0 := hadd 0 0
      rw [add_zero] at h0
      rw [Nat.cast_zero, zero_nsmul]
      exact left_eq_add.mp h0
    | succ j ih =>
      rw [Nat.cast_succ, hadd, ih, h1, succ_nsmul]

  have hmap : (SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).map ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit S ℓ)) =
      (ℓ ^ m : ℕ) • 𝟙 ((SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).obj (wcIntUnit S ℓ)) := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]

  have hw : ((ℓ ^ m : ℕ) • 𝟙 ((SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).obj (wcIntUnit S ℓ))) ≫
      ι.hom = ι.hom ≫ ((ℓ ^ m : ℕ) • 𝟙 (wcIntSheaf S ℓ)) := by
    rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]

  obtain ⟨c⟩ := wc_int_coker_zmod S ℓ m (((ℓ ^ m : ℕ)) : ℤ_[ℓ]) (Nat.cast_pow ℓ m)
  exact ⟨Limits.PreservesCokernel.iso (SheafOfModules.toSheaf (wcIntRingSheaf S ℓ))
      ((ℓ ^ m : ℕ) • 𝟙 (wcIntUnit S ℓ)) ≪≫ Limits.cokernelIsoOfEq hmap ≪≫
    Limits.cokernel.mapIso _ _ ι ι hw ≪≫ Limits.cokernelIsoOfEq (hnat (ℓ ^ m)).symm ≪≫ c ≪≫
    Iso.refl _⟩

theorem wc_int_tors_toSheaf_zmod (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) :
