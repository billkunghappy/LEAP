    Presheaf.isLocallySurjective_toSheafify' _ P
  haveI hα's : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology S') α' :=
    Presheaf.isLocallySurjective_toSheafify' _ P'
  haveI hα'i : Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology S') α' :=
    Presheaf.isLocallyInjective_toSheafify' _ P'
  have hα'nat : ∀ {W₁ W₂ : S'.Etale} (h : W₁ ⟶ W₂) (t : ULift.{u+1} (ZMod n)),
      ((wcEtZModRing S' n).obj.map h.op).hom ((α'.app (Opposite.op W₂)).hom t) =
        (α'.app (Opposite.op W₁)).hom t := by
    intro W₁ W₂ h t
    have := congrArg (fun k => k.hom t) (α'.naturality h.op)
    exact this.symm

  have hC : ∀ (V : S.Etale) (t : ULift.{u+1} (ZMod n)),
      (E.φ.hom.app (Opposite.op V)).hom ((α.app (Opposite.op V)).hom t) =
        (α'.app (Opposite.op ((wcEtBaseChange g).obj V))).hom t := by
    intro V t
    let f₁ : ULift.{u+1} (ZMod n) →+*
        (wcEtZModRing S' n).obj.obj (Opposite.op ((wcEtBaseChange g).obj V)) :=
      (E.φ.hom.app (Opposite.op V)).hom.comp (α.app (Opposite.op V)).hom
    let f₂ : ULift.{u+1} (ZMod n) →+*
        (wcEtZModRing S' n).obj.obj (Opposite.op ((wcEtBaseChange g).obj V)) :=
      (α'.app (Opposite.op ((wcEtBaseChange g).obj V))).hom
    have key := RingHom.ext_zmod
      (f₁.comp (ULift.ringEquiv : ULift.{u+1} (ZMod n) ≃+* ZMod n).symm.toRingHom)
      (f₂.comp (ULift.ringEquiv : ULift.{u+1} (ZMod n) ≃+* ZMod n).symm.toRingHom)
    have h2 := congrArg (fun f => f t.down) key
    exact h2
  have hsurj : ∀ (V' : S'.Etale) (r' : (wcEtZModRing S' n).obj.obj (Opposite.op V')),
      ∃ T ∈ Scheme.smallEtaleTopology S' V', ∀ ⦃W' : S'.Etale⦄ (f : W' ⟶ V'),
      T.arrows f → ∃ (V : S.Etale) (a : W' ⟶ (wcEtBaseChange g).obj V)
        (r : (wcEtZModRing S n).obj.obj (Opposite.op V)),
        ((wcEtZModRing S' n).obj.map f.op).hom r' =
          ((wcEtZModRing S' n).obj.map a.op).hom ((E.φ.hom.app (Opposite.op V)).hom r) := by
    intro V' r'
    refine ⟨Presheaf.imageSieve α' r', Presheaf.imageSieve_mem _ α' r', ?_⟩
    intro W' f hf
    obtain ⟨t, ht⟩ := hf
    refine ⟨⊤_ S.Etale, hT.from W', (α.app (Opposite.op (⊤_ S.Etale))).hom t, ?_⟩
    rw [hC (⊤_ S.Etale) t, hα'nat (hT.from W') t]
    exact ht.symm
  have hcomp : ∀ {X₁ X₂ X₃ : (S'.Etale)ᵒᵖ} (p : X₁ ⟶ X₂) (q : X₂ ⟶ X₃)
      (x : (wcEtZModRing S' n).obj.obj X₁),
      ((wcEtZModRing S' n).obj.map q).hom (((wcEtZModRing S' n).obj.map p).hom x) =
        ((wcEtZModRing S' n).obj.map (p ≫ q)).hom x := by
    intro X₁ X₂ X₃ p q x
    rw [Functor.map_comp]
    rfl
  have hinj : ∀ (V' : S'.Etale) (V : S.Etale) (a : V' ⟶ (wcEtBaseChange g).obj V)
      (r : (wcEtZModRing S n).obj.obj (Opposite.op V)),
      ((wcEtZModRing S' n).obj.map a.op).hom ((E.φ.hom.app (Opposite.op V)).hom r) = 0 →
      ∃ T ∈ Scheme.smallEtaleTopology S' V', ∀ ⦃W' : S'.Etale⦄ (f : W' ⟶ V'), T.arrows f →
        ∃ (W : S.Etale) (b : W ⟶ V) (a' : W' ⟶ (wcEtBaseChange g).obj W),
          a' ≫ (wcEtBaseChange g).map b = f ≫ a ∧
            ((wcEtZModRing S n).obj.map b.op).hom r = 0 := by
    intro V' V a r hr
    let T : Sieve V' :=
      { arrows := fun W' f => ∃ (W : S.Etale) (b : W ⟶ V) (a' : W' ⟶ (wcEtBaseChange g).obj W),
          a' ≫ (wcEtBaseChange g).map b = f ≫ a ∧ ((wcEtZModRing S n).obj.map b.op).hom r = 0
        downward_closed := by
          rintro W₁ W₂ f ⟨W, b, a', e1, e2⟩ m
          exact ⟨W, b, m ≫ a', by simp only [Category.assoc, e1], e2⟩ }
    refine ⟨T, ?_, fun W' f hf => hf⟩
    have hI : Presheaf.imageSieve α r ∈ Scheme.smallEtaleTopology S V :=
      Presheaf.imageSieve_mem _ α r
    have hP1 : Sieve.pullback a (Sieve.functorPushforward (wcEtBaseChange g)
        (Presheaf.imageSieve α r)) ∈ Scheme.smallEtaleTopology S' V' :=
      (Scheme.smallEtaleTopology S').pullback_stable a (hcov.cover_preserve hI)
    apply (Scheme.smallEtaleTopology S').transitive hP1
    intro W₁ h hh
    obtain ⟨Z, c, k, hc, hk⟩ := hh
    obtain ⟨t, ht⟩ := hc
    have ht' : (α.app (Opposite.op Z)).hom t = ((wcEtZModRing S n).obj.map c.op).hom r := ht
    have hnat : ((wcEtZModRing S' n).obj.map ((wcEtBaseChange g).map c).op).hom
        ((E.φ.hom.app (Opposite.op V)).hom r) =
        (E.φ.hom.app (Opposite.op Z)).hom (((wcEtZModRing S n).obj.map c.op).hom r) := by
      have := congrArg (fun q => q.hom r) (E.φ.hom.naturality c.op)
      exact this.symm
    have key : ∀ x : (wcEtZModRing S' n).obj.obj (Opposite.op ((wcEtBaseChange g).obj V)),
        ((wcEtZModRing S' n).obj.map k.op).hom
          (((wcEtZModRing S' n).obj.map ((wcEtBaseChange g).map c).op).hom x) =
        ((wcEtZModRing S' n).obj.map h.op).hom (((wcEtZModRing S' n).obj.map a.op).hom x) := by
      intro x
      rw [hcomp, hcomp, ← op_comp, ← op_comp, hk]
    have e : (α'.app (Opposite.op W₁)).hom t = ((wcEtZModRing S' n).obj.map h.op).hom
        (((wcEtZModRing S' n).obj.map a.op).hom ((E.φ.hom.app (Opposite.op V)).hom r)) := by
      rw [← hα'nat k t, ← hC Z t, ht', ← hnat]
      exact key _
    have hzero : (α'.app (Opposite.op W₁)).hom t = (α'.app (Opposite.op W₁)).hom 0 := by
      rw [e, hr, map_zero, map_zero]
    refine (Scheme.smallEtaleTopology S').superset_covering ?_
      (Presheaf.equalizerSieve_mem _ α' t 0 hzero)
    intro W₂ m hm
    have ht0 : t = 0 := hm
    refine ⟨Z, c, m ≫ k, ?_, ?_⟩
    · simp only [Category.assoc, hk]
    · have h3 := ht'.symm
      rw [ht0, map_zero] at h3
      exact h3

  obtain ⟨ι⟩ := wc_sheafOfModules_pullback_toSheaf_iso (Scheme.smallEtaleTopology S)
    (Scheme.smallEtaleTopology S') (wcEtBaseChange g) (wcEtZModRing S n) (wcEtZModRing S' n) E.φ
    hsurj hinj E.Φ E.adj
  exact ⟨ι⟩

theorem wc_zmod_pull_data_toSheaf_iso : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} {n : ℕ} (D : wcZModPullData f n), wcZModPullCanonical D → letI := D.cont; Nonempty (D.Φ ⋙ SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S' n) ≅ SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S n) ⋙ (wcProEtBC f).sheafPullback AddCommGrpCat.{u+1} (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')) :=
by
  classical
  intro S S' f n D hD
  letI := D.cont
  obtain ⟨_, hflat⟩ := wc_proet_pullback_continuous_flat f
  have hflat' : RepresentablyFlat (wcProEtBC f) := hflat
  haveI := hflat'

  have H1 : ∀ (V : S'.ProEt) (R : Sieve V), (∀ x : ↥V.left, ∃ (W : S'.ProEt) (g : W ⟶ V),
      R.arrows g ∧ IsOpenImmersion g.left ∧ x ∈ Set.range g.left) →
      R ∈ Scheme.ProEt.topology S' V := by
    intro V R hR
    choose W g hgR hgo hgx using hR
    have hZ : Presieve.ofArrows (fun x => (W x).left) (fun x => (g x).left) ∈
        (Scheme.precoverage @IsOpenImmersion).coverings V.left :=
      (Scheme.ofArrows_mem_precoverage_iff _).mpr ⟨fun x => ⟨x, hgx x⟩, fun x => hgo x⟩
    have hP : Presieve.ofArrows W g ∈ (Scheme.ProEt.precoverage S').coverings V := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S' ⋙ Over.forget S')
        Scheme.proetalePrecoverage).coverings V
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change Presieve.ofArrows (fun x => (W x).left) (fun x => (g x).left) ∈
        Scheme.proetalePrecoverage.coverings V.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage V.left hZ, hZ.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun x => inferInstance)⟩
    refine GrothendieckTopology.superset_covering _ ?_ (Precoverage.generate_mem_toGrothendieck hP)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨x⟩
    exact hgR x

  have hsurj : ∀ (V' : S'.ProEt) (r' : C(↥V'.left, ULift.{u+1} (ZMod n))),
      ∃ T ∈ Scheme.ProEt.topology S' V', ∀ ⦃W' : S'.ProEt⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (V : S.ProEt) (a : W' ⟶ (wcProEtBC f).obj V) (r : C(↥V.left, ULift.{u+1} (ZMod n))),
          r'.comp g.left.base.hom =
            (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom := by
    intro V' r'
    let T : Sieve V' :=
      { arrows := fun W' g => ∃ (V : S.ProEt) (a : W' ⟶ (wcProEtBC f).obj V)
            (r : C(↥V.left, ULift.{u+1} (ZMod n))),
            r'.comp g.left.base.hom =
              (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom
        downward_closed := by
          rintro Y Z g ⟨V, a, r, h⟩ k
          exact ⟨V, k ≫ a, r,
            ContinuousMap.ext fun z => congrArg (fun ψ : C(_, _) => ψ (k.left.base z)) h⟩ }
    refine ⟨T, H1 V' T ?_, fun W' g hg => hg⟩
    intro x
    let U : V'.left.Opens := ⟨r' ⁻¹' {r' x}, (isOpen_discrete _).preimage r'.continuous⟩
    have hxU : x ∈ U := Set.mem_singleton (r' x)
    haveI : WeaklyEtale V'.hom := V'.prop
    let W : S'.ProEt := Scheme.ProEt.mk (U.ι ≫ V'.hom)
    let g : W ⟶ V' := MorphismProperty.Over.homMk U.ι rfl trivial
    refine ⟨W, g, ?_, (inferInstance : IsOpenImmersion U.ι), ?_⟩
    swap
    · exact (Set.ext_iff.mp (Scheme.Opens.range_ι U) x).mpr hxU
    let V : S.ProEt := Scheme.ProEt.mk (𝟙 S)
    let aL : U.toScheme ⟶ Limits.pullback (𝟙 S) f :=
      Limits.pullback.lift (U.ι ≫ V'.hom ≫ f) (U.ι ≫ V'.hom)
        (by rw [Category.comp_id, Category.assoc])
    let a : W ⟶ (wcProEtBC f).obj V :=
      MorphismProperty.Over.homMk aL (Limits.pullback.lift_snd _ _ _) trivial
    refine ⟨V, a, ContinuousMap.const _ (r' x), ?_⟩
    apply ContinuousMap.ext
    intro z
    have hz : U.ι.base z ∈ U :=
      (Set.ext_iff.mp (Scheme.Opens.range_ι U) (U.ι.base z)).mp ⟨z, rfl⟩
    exact hz

  have hinj : ∀ (V' : S'.ProEt) (V : S.ProEt) (a : V' ⟶ (wcProEtBC f).obj V)
      (r : C(↥V.left, ULift.{u+1} (ZMod n))),
      (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom = 0 →
      ∃ T ∈ Scheme.ProEt.topology S' V', ∀ ⦃W' : S'.ProEt⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (W : S.ProEt) (b : W ⟶ V) (a' : W' ⟶ (wcProEtBC f).obj W),
          a' ≫ (wcProEtBC f).map b = g ≫ a ∧ r.comp b.left.base.hom = 0 := by
    intro V' V a r hr
    refine ⟨⊤, (Scheme.ProEt.topology S').top_mem V', fun W' g _ => ?_⟩
    have ha : a.left ≫ Limits.pullback.snd V.hom f = V'.hom := Over.w a.toCommaMorphism
    have hg : g.left ≫ V'.hom = W'.hom := Over.w g.toCommaMorphism
    have hGb1 : ∀ {W : S.ProEt} (b : W ⟶ V), ((wcProEtBC f).map b).left ≫
        Limits.pullback.fst V.hom f = Limits.pullback.fst W.hom f ≫ b.left := fun b =>
      Limits.pullback.lift_fst _ _ _
    have hGb2 : ∀ {W : S.ProEt} (b : W ⟶ V), ((wcProEtBC f).map b).left ≫
        Limits.pullback.snd V.hom f = Limits.pullback.snd W.hom f := fun b =>
      Limits.pullback.lift_snd _ _ _
    let Z : V.left.Opens := ⟨r ⁻¹' {0}, (isOpen_discrete _).preimage r.continuous⟩
    haveI : WeaklyEtale V.hom := V.prop
    let W : S.ProEt := Scheme.ProEt.mk (Z.ι ≫ V.hom)
    let b : W ⟶ V := MorphismProperty.Over.homMk Z.ι rfl trivial
    have hb0 : r.comp b.left.base.hom = 0 := by
      apply ContinuousMap.ext
      intro w
      have hw : Z.ι.base w ∈ Z :=
        (Set.ext_iff.mp (Scheme.Opens.range_ι Z) (Z.ι.base w)).mp ⟨w, rfl⟩
      exact hw
    let φ : W'.left ⟶ V.left := g.left ≫ a.left ≫ Limits.pullback.fst V.hom f
    have hrange : Set.range φ.base ⊆ Set.range Z.ι.base := by
      rintro _ ⟨y, rfl⟩
      refine (Set.ext_iff.mp (Scheme.Opens.range_ι Z) _).mpr ?_
      have e := congrArg (fun ψ : C(_, ULift.{u+1} (ZMod n)) => ψ (g.left.base y)) hr
      exact e
    let m : W'.left ⟶ Z.toScheme := IsOpenImmersion.lift Z.ι φ hrange
    have hm : m ≫ Z.ι = φ := IsOpenImmersion.lift_fac _ _ _
    have hcond : Limits.pullback.fst V.hom f ≫ V.hom = Limits.pullback.snd V.hom f ≫ f :=
      Limits.pullback.condition
    have hw : m ≫ (Z.ι ≫ V.hom) = W'.hom ≫ f :=
      calc m ≫ (Z.ι ≫ V.hom) = (m ≫ Z.ι) ≫ V.hom := (Category.assoc _ _ _).symm
        _ = φ ≫ V.hom := congrArg (fun k => k ≫ V.hom) hm
        _ = g.left ≫ a.left ≫ (Limits.pullback.fst V.hom f ≫ V.hom) :=
          (Category.assoc _ _ _).trans (congrArg (fun k => g.left ≫ k) (Category.assoc _ _ _))
        _ = g.left ≫ a.left ≫ (Limits.pullback.snd V.hom f ≫ f) :=
          congrArg (fun k => g.left ≫ a.left ≫ k) hcond
        _ = g.left ≫ (a.left ≫ Limits.pullback.snd V.hom f) ≫ f :=
          congrArg (fun k => g.left ≫ k) (Category.assoc _ _ _).symm
        _ = g.left ≫ V'.hom ≫ f := congrArg (fun k => g.left ≫ k ≫ f) ha
        _ = (g.left ≫ V'.hom) ≫ f := (Category.assoc _ _ _).symm
        _ = W'.hom ≫ f := congrArg (fun k => k ≫ f) hg
    let aL' : W'.left ⟶ Limits.pullback (Z.ι ≫ V.hom) f := Limits.pullback.lift m W'.hom hw
    let a' : W' ⟶ (wcProEtBC f).obj W :=
      MorphismProperty.Over.homMk aL' (Limits.pullback.lift_snd _ _ _) trivial
    refine ⟨W, b, a', ?_, hb0⟩
    apply MorphismProperty.Over.Hom.ext
    change aL' ≫ ((wcProEtBC f).map b).left = g.left ≫ a.left
    have e1 : aL' ≫ Limits.pullback.fst W.hom f = m := Limits.pullback.lift_fst _ _ _
    have e2 : aL' ≫ Limits.pullback.snd W.hom f = W'.hom := Limits.pullback.lift_snd _ _ _
    refine Limits.pullback.hom_ext ?_ ?_
    · exact calc (aL' ≫ ((wcProEtBC f).map b).left) ≫ Limits.pullback.fst V.hom f
          = aL' ≫ (((wcProEtBC f).map b).left ≫ Limits.pullback.fst V.hom f) :=
            Category.assoc _ _ _
        _ = aL' ≫ (Limits.pullback.fst W.hom f ≫ b.left) := congrArg (fun k => aL' ≫ k) (hGb1 b)
        _ = (aL' ≫ Limits.pullback.fst W.hom f) ≫ b.left := (Category.assoc _ _ _).symm
        _ = m ≫ Z.ι := congrArg (fun k => k ≫ b.left) e1
        _ = g.left ≫ a.left ≫ Limits.pullback.fst V.hom f := hm
        _ = (g.left ≫ a.left) ≫ Limits.pullback.fst V.hom f := (Category.assoc _ _ _).symm
    · exact calc (aL' ≫ ((wcProEtBC f).map b).left) ≫ Limits.pullback.snd V.hom f
          = aL' ≫ (((wcProEtBC f).map b).left ≫ Limits.pullback.snd V.hom f) :=
            Category.assoc _ _ _
        _ = aL' ≫ Limits.pullback.snd W.hom f := congrArg (fun k => aL' ≫ k) (hGb2 b)
        _ = W'.hom := e2
        _ = g.left ≫ V'.hom := hg.symm
        _ = g.left ≫ (a.left ≫ Limits.pullback.snd V.hom f) :=
          congrArg (fun k => g.left ≫ k) ha.symm
        _ = (g.left ≫ a.left) ≫ Limits.pullback.snd V.hom f := (Category.assoc _ _ _).symm

  have hsurj' : ∀ (V' : S'.ProEt) (r' : (wcZModRingSheaf S' n).obj.obj (Opposite.op V')),
      ∃ T ∈ Scheme.ProEt.topology S' V', ∀ ⦃W' : S'.ProEt⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (V : S.ProEt) (a : W' ⟶ (wcProEtBC f).obj V)
          (r : (wcZModRingSheaf S n).obj.obj (Opposite.op V)),
          ((wcZModRingSheaf S' n).obj.map g.op).hom r' =
            ((wcZModRingSheaf S' n).obj.map a.op).hom ((D.φ.hom.app (Opposite.op V)).hom r) := by
    intro V' r'
    obtain ⟨T, hT, hTg⟩ := hsurj V' r'
    refine ⟨T, hT, fun W' g hg => ?_⟩
    obtain ⟨V, a, r, e⟩ := hTg g hg
    refine ⟨V, a, r, ?_⟩
    exact e.trans (congrArg (fun ψ : C(↥(Limits.pullback V.hom f), ULift.{u+1} (ZMod n)) =>
      ψ.comp a.left.base.hom) (hD V r)).symm
  have hinj' : ∀ (V' : S'.ProEt) (V : S.ProEt) (a : V' ⟶ (wcProEtBC f).obj V)
      (r : (wcZModRingSheaf S n).obj.obj (Opposite.op V)),
      ((wcZModRingSheaf S' n).obj.map a.op).hom ((D.φ.hom.app (Opposite.op V)).hom r) = 0 →
      ∃ T ∈ Scheme.ProEt.topology S' V', ∀ ⦃W' : S'.ProEt⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (W : S.ProEt) (b : W ⟶ V) (a' : W' ⟶ (wcProEtBC f).obj W),
          a' ≫ (wcProEtBC f).map b = g ≫ a ∧ ((wcZModRingSheaf S n).obj.map b.op).hom r = 0 := by
    intro V' V a r h0
    have h1 : (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom = 0 :=
      (congrArg (fun ψ : C(↥(Limits.pullback V.hom f), ULift.{u+1} (ZMod n)) =>
        ψ.comp a.left.base.hom) (hD V r)).symm.trans h0
    exact hinj V' V a r h1
  obtain ⟨ι⟩ := wc_sheafOfModules_pullback_toSheaf_iso (Scheme.ProEt.topology S)
    (Scheme.ProEt.topology S') (wcProEtBC f) (wcZModRingSheaf S n) (wcZModRingSheaf S' n) D.φ
    hsurj' hinj' D.Φ D.adj
  exact ⟨ι⟩

theorem wc_zmod_proet_pull_bij_of_et_pull_bij : ∀ {S S' : Scheme.{u}} (g : S' ⟶ S) [CompactSpace S] [QuasiSeparatedSpace S] [CompactSpace S'] [QuasiSeparatedSpace S'] (n : ℕ), 0 < n → ∀ (D : wcZModPullData g n), wcZModPullCanonical D → ∀ (E : wcEtPullData g n) (j : ℕ), Function.Bijective (wcEtPull E j) → Function.Bijective (wcZModPull D j) :=
by
  classical
  intro S S' g _ _ _ _ n hn D hD E j hE
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing S' n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S' n)) := HasExt.standard _
  haveI := E.additive
  haveI := E.presLim
  haveI := E.presColim
  haveI := D.additive
  haveI := D.presLim
  haveI := D.presColim
  haveI := E.cont
  haveI := D.cont



  obtain ⟨N, hNa, hNl, hNc, e, hbij, ⟨θ⟩⟩ := wc_zmod_mod_pullback_nat S n hn
  obtain ⟨N', hNa', hNl', hNc', e', hbij', ⟨θ'⟩⟩ := wc_zmod_mod_pullback_nat S' n hn
  haveI := hNa
  haveI := hNl
  haveI := hNc
  haveI := hNa'
  haveI := hNl'
  haveI := hNc'
  have hΘS := wc_zmod_et_proet_conj_bij_qcqs S n hn N e hbij (fun M => ⟨θ.app M⟩) j
  have hΘS' := wc_zmod_et_proet_conj_bij_qcqs S' n hn N' e' hbij' (fun M => ⟨θ'.app M⟩) j



  obtain ⟨_, hcontS⟩ := wc_etToProEt_flat_cont S
  obtain ⟨_, hcontS'⟩ := wc_etToProEt_flat_cont S'
