    intro p σ j j' j'' h₁ h₂
    apply WPext _ (U' j) (p + 1) (fun t => V' j (σ t)) (fun t => f' j (σ t))
    · rw [Category.assoc, hEb j j' h₁ p σ, ← Category.assoc, hEb j' j'' h₂ p σ, Category.assoc,
        L11 j j' j'' h₁ h₂, hEb j j'' (h₁.trans h₂) p σ]
    · intro t
      rw [Category.assoc, hEπ j j' h₁ p σ t, ← Category.assoc, hEπ j' j'' h₂ p σ t, Category.assoc,
        L12 j j' j'' h₁ h₂ (σ t), hEπ j j'' (h₁.trans h₂) p σ t]
  have C9 : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k),
      IsPullback (πc 0 p σ) (wcWP U V f σ).hom (wcWP (U' 0) (V' 0) (f' 0) σ).hom
        (a (l + 0)).left := by
    intro p σ
    rw [hW, hW]
    exact (WPsq _ _ U (p + 1) (fun t => V (σ t)) (fun t => f (σ t)) (U' 0) (fun t => V' 0 (σ t))
      (fun t => f' 0 (σ t)) (qU 0) (fun t => qV 0 (σ t)) (fun t => L4 0 (σ t)) (πc 0 p σ)
      (hπb 0 p σ) (hππ 0 p σ)).paste_vert (L3 0)
  have C6 : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j : ℕ),
      CompactSpace (wcWP (U' j) (V' j) (f' j) σ).left ∧
        QuasiSeparatedSpace (wcWP (U' j) (V' j) (f' j) σ).left := by
    intro p σ j
    obtain ⟨hq, hs⟩ := baseQ _ (U' j) k (V' j) (f' j) (fun i => (legs j i).1) (fun i => (legs j i).2)
      (p + 1) σ
    haveI := hq
    haveI := hs
    haveI := (L13 j).1
    haveI := (L13 j).2
    exact ⟨QuasiCompact.compactSpace_of_compactSpace
