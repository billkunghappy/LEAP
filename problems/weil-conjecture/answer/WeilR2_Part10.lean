theorem wc_et_level_colim_ok : ∀ {S : Scheme.{u}} {Uinf : S.ProEt} (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k)) (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k) (F : ∀ k : ℕ, Sheaf (Scheme.smallEtaleTopology (D.obj (Opposite.op k)).left) AddCommGrpCat.{u+1}) (φ : ∀ (k l : ℕ) (h : k ≤ l), (wcEtInv (D.map (homOfLE h).op).left).obj (F k) ⟶ F l), wcEtLevelSC1 D F φ → wcEtSysOK ({ F := F, Finf := Limits.colimit (wcEtLevelDiag D a ha F φ), φ := φ, ψ := fun k => Limits.colimit.ι (wcEtLevelDiag D a ha F φ) (AsSmall.up.obj k) } : wcEtSys D a) :=
by
  intro S Uinf D a ha F φ hSC1

  have hhom : ∀ k l (f g : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k), f = g := by
    intro k l f g
    exact Quiver.Hom.unop_inj (Subsingleton.elim _ _)
  have haL : ∀ k l (h : k ≤ l), a l ≫ D.map (homOfLE h).op = a k := by
    intro k l h
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
    exact ha k j
  have heL : ∀ k l (h : k ≤ l), (a l).left ≫ (D.map (homOfLE h).op).left = (a k).left := by
    intro k l h
    exact congrArg (fun t => t.left) (haL k l h)
  have heD : ∀ k l m (h₁ : k ≤ l) (h₂ : l ≤ m),
      (D.map (homOfLE h₂).op).left ≫ (D.map (homOfLE h₁).op).left =
        (D.map (homOfLE (h₁.trans h₂)).op).left := by
    intro k l m h₁ h₂
    have e : D.map (homOfLE h₂).op ≫ D.map (homOfLE h₁).op = D.map (homOfLE (h₁.trans h₂)).op := by
      rw [← D.map_comp, hhom _ _ ((homOfLE h₂).op ≫ (homOfLE h₁).op) (homOfLE (h₁.trans h₂)).op]
    exact congrArg (fun t => t.left) e

  have hT : ∀ (k l m : ℕ) (h₁ : k ≤ l) (h₂ : l ≤ m)
      (he₁ : (a l).left ≫ (D.map (homOfLE h₁).op).left = (a k).left)
      (he₂ : (a m).left ≫ (D.map (homOfLE h₂).op).left = (a l).left)
      (he₃ : (a m).left ≫ (D.map (homOfLE (h₁.trans h₂)).op).left = (a k).left),
      wcEtLevelTheta D a F φ k m (h₁.trans h₂) he₃ =
        wcEtLevelTheta D a F φ k l h₁ he₁ ≫ wcEtLevelTheta D a F φ l m h₂ he₂ := by
    intro k l m h₁ h₂ he₁ he₂ he₃
    have hD := heD k l m h₁ h₂
    have ca := wc_etInv_cocycle (a m).left (D.map (homOfLE h₂).op).left
      (D.map (homOfLE h₁).op).left (a l).left (D.map (homOfLE (h₁.trans h₂)).op).left (a k).left
      he₂ hD he₃ he₁ (F k)
    have hα2 := (wc_etInvComp_inv_pair (a l).left (D.map (homOfLE h₁).op).left (a k).left he₁
      (F k)).2
    have hγ1 := (wc_etInvComp_inv_pair (a m).left (D.map (homOfLE (h₁.trans h₂)).op).left
      (a k).left he₃ (F k)).1
    have hδ1 := (wc_etInvComp_inv_pair (D.map (homOfLE h₂).op).left (D.map (homOfLE h₁).op).left
      (D.map (homOfLE (h₁.trans h₂)).op).left hD (F k)).1
    have hN3 := (wc_etInvComp_natural (a m).left (D.map (homOfLE h₂).op).left (a l).left he₂
      (φ k l h₁)).2
    have hinv : ((wcEtInv (a m).left).map (wcEtInvComp (D.map (homOfLE h₂).op).left
          (D.map (homOfLE h₁).op).left (D.map (homOfLE (h₁.trans h₂)).op).left hD (F k)) ≫
        wcEtInvComp (a m).left (D.map (homOfLE (h₁.trans h₂)).op).left (a k).left he₃ (F k)) ≫
        (wcEtInvCompInv (a m).left (D.map (homOfLE (h₁.trans h₂)).op).left (a k).left he₃ (F k) ≫
          (wcEtInv (a m).left).map (wcEtInvCompInv (D.map (homOfLE h₂).op).left
            (D.map (homOfLE h₁).op).left (D.map (homOfLE (h₁.trans h₂)).op).left hD (F k))) =
        𝟙 _ := by
      rw [Category.assoc, reassoc_of% hγ1, ← Functor.map_comp, hδ1, CategoryTheory.Functor.map_id]
    have hX : wcEtInvCompInv (a l).left (D.map (homOfLE h₁).op).left (a k).left he₁ (F k) ≫
        wcEtInvCompInv (a m).left (D.map (homOfLE h₂).op).left (a l).left he₂
          ((wcEtInv (D.map (homOfLE h₁).op).left).obj (F k)) =
        wcEtInvCompInv (a m).left (D.map (homOfLE (h₁.trans h₂)).op).left (a k).left he₃ (F k) ≫
          (wcEtInv (a m).left).map (wcEtInvCompInv (D.map (homOfLE h₂).op).left
            (D.map (homOfLE h₁).op).left (D.map (homOfLE (h₁.trans h₂)).op).left hD (F k)) := by
      refine (Category.comp_id _).symm.trans ?_
      rw [← hinv]
      simp only [Category.assoc]
      rw [reassoc_of% ca, reassoc_of% hα2]
    unfold wcEtLevelTheta
    rw [← hSC1 k l m h₁ h₂ hD]
    simp only [Functor.map_comp, Category.assoc]
    rw [← reassoc_of% hN3, reassoc_of% hX]

  have hW0 : ∀ (n : ℕ)
      (he : (a (n + 1)).left ≫ (D.map (homOfLE (Nat.le_add_right n 1)).op).left = (a n).left),
      (wcEtLevelDiag D a ha F φ).map (AsSmall.up.map (homOfLE (Nat.le_add_right n 1))) =
        wcEtLevelTheta D a F φ n (n + 1) (Nat.le_add_right n 1) he := by
    intro n he
    change (Functor.ofSequence (fun k => wcEtLevelTheta D a F φ k (k + 1) (Nat.le_add_right k 1)
      (congrArg (fun t => t.left) (ha k 1)))).map (homOfLE (Nat.le_add_right n 1)) = _
    exact Functor.ofSequence_map_homOfLE_succ _ n

  have hN5' : ∀ (k l : ℕ) (h : k + 1 ≤ l)
      (he : (a l).left ≫ (D.map (homOfLE (Nat.le_of_succ_le h)).op).left = (a k).left),
      (wcEtLevelDiag D a ha F φ).map (AsSmall.up.map (homOfLE (Nat.le_of_succ_le h))) =
        wcEtLevelTheta D a F φ k l (Nat.le_of_succ_le h) he := by
    intro k l h
    induction l, h using Nat.le_induction with
    | base => intro he; exact hW0 k he
    | succ n hn ih =>
      intro he
      have hkn : k ≤ n := Nat.le_of_succ_le hn
      have hkn1 : k ≤ n + 1 := Nat.le_succ_of_le hkn
      have e1 : (wcEtLevelDiag D a ha F φ).map (AsSmall.up.map (homOfLE hkn1)) =
          (wcEtLevelDiag D a ha F φ).map (AsSmall.up.map (homOfLE hkn)) ≫
            (wcEtLevelDiag D a ha F φ).map (AsSmall.up.map (homOfLE (Nat.le_add_right n 1))) := by
        rw [← Functor.map_comp]
        exact congrArg _ (ULift.ext _ _ (Subsingleton.elim _ _))
      rw [e1, ih (heL k n hkn), hW0 n (heL n (n + 1) (Nat.le_add_right n 1))]
      exact (hT k n (n + 1) hkn (Nat.le_add_right n 1) (heL k n hkn)
        (heL n (n + 1) (Nat.le_add_right n 1)) he).symm
  have hN5 : ∀ (k l : ℕ) (h : k < l)
      (he : (a l).left ≫ (D.map (homOfLE h.le).op).left = (a k).left),
      (wcEtLevelDiag D a ha F φ).map (AsSmall.up.map (homOfLE h.le)) =
        wcEtLevelTheta D a F φ k l h.le he :=
    fun k l h he => hN5' k l h he

  have hdiag : ∀ (k : ℕ) (h : k ≤ k)
      (he : (a k).left ≫ (D.map (homOfLE h).op).left = (a k).left),
      wcEtLevelTheta D a F φ k k h he ≫
          Limits.colimit.ι (wcEtLevelDiag D a ha F φ) (AsSmall.up.obj k) =
        Limits.colimit.ι (wcEtLevelDiag D a ha F φ) (AsSmall.up.obj k) := by
    intro k h he
    have w1 := Limits.colimit.w (wcEtLevelDiag D a ha F φ)
      (AsSmall.up.map (homOfLE (Nat.le_add_right k 1)))
    rw [hW0 k (heL k (k + 1) (Nat.le_add_right k 1))] at w1
    rw [← w1]
    have hT' := hT k k (k + 1) h (Nat.le_add_right k 1) he
      (heL k (k + 1) (Nat.le_add_right k 1)) (heL k (k + 1) (Nat.le_add_right k 1))
    exact (Category.assoc _ _ _).symm.trans
      (congrArg (fun q => q ≫ Limits.colimit.ι (wcEtLevelDiag D a ha F φ) (AsSmall.up.obj (k + 1)))
        hT'.symm)
  unfold wcEtSysOK
  refine ⟨?_, ?_, ?_, ?_⟩
  ·
    exact hSC1
  ·
    intro k l h he
    rw [← Category.assoc]
    change wcEtLevelTheta D a F φ k l h he ≫
        Limits.colimit.ι (wcEtLevelDiag D a ha F φ) (AsSmall.up.obj l) =
      Limits.colimit.ι (wcEtLevelDiag D a ha F φ) (AsSmall.up.obj k)
    rcases Nat.eq_or_lt_of_le h with hkl | hlt
    · subst hkl
      exact hdiag _ h he
    · have w := Limits.colimit.w (wcEtLevelDiag D a ha F φ) (AsSmall.up.map (homOfLE hlt.le))
      rw [hN5 k l hlt he] at w
      exact w
  ·
    intro V s
    have H := (wc_et_sheaf_colimit_cocone_local Uinf.left (AsSmall.{u+1} ℕ)
      (wcEtLevelDiag D a ha F φ)).1 V s
    refine GrothendieckTopology.superset_covering _ (Sieve.generate_mono ?_) H
    rintro V' h ⟨i, t, ht⟩
    exact ⟨ULift.down i, t, ht⟩
  ·
    intro k V x hx
    have H := (wc_et_sheaf_colimit_cocone_local Uinf.left (AsSmall.{u+1} ℕ)
      (wcEtLevelDiag D a ha F φ)).2 (AsSmall.up.obj k) V x hx
    refine GrothendieckTopology.superset_covering _ (Sieve.generate_mono ?_) H
    rintro V' h ⟨j, f, hf⟩
    obtain ⟨n, rfl⟩ : ∃ n : ℕ, AsSmall.up.obj n = j := ⟨ULift.down j, rfl⟩
    have hkn : k ≤ n := leOfHom (AsSmall.down.map f)
    have hlt : k < n + 1 := Nat.lt_succ_of_le hkn
    refine ⟨n + 1, hlt.le, heL k (n + 1) hlt.le, ?_⟩
    change ((wcEtLevelTheta D a F φ k (n + 1) hlt.le (heL k (n + 1) hlt.le)).hom.app
      (Opposite.op V')).hom ((((wcEtInv (a k).left).obj (F k)).obj.map h.op).hom x) = 0
    have key : wcEtLevelTheta D a F φ k (n + 1) hlt.le (heL k (n + 1) hlt.le) =
        (wcEtLevelDiag D a ha F φ).map f ≫
          (wcEtLevelDiag D a ha F φ).map (AsSmall.up.map (homOfLE (Nat.le_add_right n 1))) := by
      rw [← hN5 k (n + 1) hlt (heL k (n + 1) hlt.le), ← Functor.map_comp]
      exact congrArg _ (ULift.ext _ _ (Subsingleton.elim _ _))
    rw [key]
    exact (congrArg (fun y => (((wcEtLevelDiag D a ha F φ).map
      (AsSmall.up.map (homOfLE (Nat.le_add_right n 1)))).hom.app (Opposite.op V')).hom y) hf).trans
      (map_zero _)

theorem wc_et_sys_colim_iso : ∀ {S : Scheme.{u}} {Uinf : S.ProEt} (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k)) (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k) (A : wcEtSys D a), wcEtSysOK A → ∃ e : Limits.colimit (wcEtLevelDiag D a ha A.F A.φ) ≅ A.Finf, ∀ k, Limits.colimit.ι (wcEtLevelDiag D a ha A.F A.φ) (AsSmall.up.obj k) ≫ e.hom = A.ψ k :=
by
  intro S Uinf D a ha A hA
  obtain ⟨hSC1, hSC2, hLC1, hLC2⟩ := hA

  have hhom : ∀ k l (f g : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k), f = g := by
    intro k l f g
    exact Quiver.Hom.unop_inj (Subsingleton.elim _ _)

  have haux : ∀ k l (h : k ≤ l), (a l).left ≫ (D.map (homOfLE h).op).left = (a k).left := by
    intro k l h
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
    exact congrArg (fun t => t.left) (ha k j)
  have heT : ∀ k l m (h₁ : k ≤ l) (h₂ : l ≤ m),
      (D.map (homOfLE h₂).op).left ≫ (D.map (homOfLE h₁).op).left =
        (D.map (homOfLE (h₁.trans h₂)).op).left := by
    intro k l m h₁ h₂
    have e : (homOfLE h₂).op ≫ (homOfLE h₁).op = (homOfLE (h₁.trans h₂)).op := hhom _ _ _ _
    rw [← e, D.map_comp]
    rfl

  have alg : ∀ {O1 O2 O3 O4 : Sheaf (Scheme.smallEtaleTopology Uinf.left) AddCommGrpCat.{u+1}}
      (ci1 : O1 ⟶ O2) (c1 : O2 ⟶ O1) (ci2 : O2 ⟶ O3) (ci3 : O1 ⟶ O4) (c3 : O4 ⟶ O1)
      (x : O3 ⟶ O4) (y : O4 ⟶ O3), x ≫ y = 𝟙 _ → ci2 ≫ x ≫ c3 = c1 → ci1 ≫ c1 = 𝟙 _ →
      c3 ≫ ci3 = 𝟙 _ → ci1 ≫ ci2 = ci3 ≫ y := by
    intro O1 O2 O3 O4 ci1 c1 ci2 ci3 c3 x y hxy hc hp1 hp3
    calc ci1 ≫ ci2 = ci1 ≫ ci2 ≫ x ≫ (c3 ≫ ci3) ≫ y := by
          rw [hp3, Category.id_comp, hxy, Category.comp_id]
      _ = ci1 ≫ (ci2 ≫ x ≫ c3) ≫ ci3 ≫ y := by simp only [Category.assoc]
      _ = ci3 ≫ y := by rw [hc, reassoc_of% hp1]

  have hθtrans : ∀ k l m (h₁ : k ≤ l) (h₂ : l ≤ m),
      wcEtLevelTheta D a A.F A.φ k m (h₁.trans h₂) (haux k m (h₁.trans h₂)) =
        wcEtLevelTheta D a A.F A.φ k l h₁ (haux k l h₁) ≫
          wcEtLevelTheta D a A.F A.φ l m h₂ (haux l m h₂) := by
    intro k l m h₁ h₂
    have hT := heT k l m h₁ h₂
    have nat := wc_etInvCompInv_natural (a m).left (D.map (homOfLE h₂).op).left (a l).left
      (haux l m h₂) (A.φ k l h₁)
    have sc := hSC1 k l m h₁ h₂ hT
    have coc := wc_etInv_cocycle (a m).left (D.map (homOfLE h₂).op).left
      (D.map (homOfLE h₁).op).left (a l).left (D.map (homOfLE (h₁.trans h₂)).op).left (a k).left
      (haux l m h₂) hT (haux k m (h₁.trans h₂)) (haux k l h₁) (A.F k)
    have p1 := wc_etInvComp_inv_pair (a l).left (D.map (homOfLE h₁).op).left (a k).left
      (haux k l h₁) (A.F k)
    have pT := wc_etInvComp_inv_pair (D.map (homOfLE h₂).op).left (D.map (homOfLE h₁).op).left
      (D.map (homOfLE (h₁.trans h₂)).op).left hT (A.F k)
    have p3 := wc_etInvComp_inv_pair (a m).left (D.map (homOfLE (h₁.trans h₂)).op).left (a k).left
      (haux k m (h₁.trans h₂)) (A.F k)
    have hxy : (wcEtInv (a m).left).map (wcEtInvComp (D.map (homOfLE h₂).op).left
        (D.map (homOfLE h₁).op).left (D.map (homOfLE (h₁.trans h₂)).op).left hT (A.F k)) ≫
        (wcEtInv (a m).left).map (wcEtInvCompInv (D.map (homOfLE h₂).op).left
        (D.map (homOfLE h₁).op).left (D.map (homOfLE (h₁.trans h₂)).op).left hT (A.F k)) = 𝟙 _ := by
      rw [← CategoryTheory.Functor.map_comp, pT.1, CategoryTheory.Functor.map_id]
    have key := alg _ _ _ _ _ _ _ hxy coc p1.2 p3.1
    unfold wcEtLevelTheta
    rw [← sc]
    simp only [CategoryTheory.Functor.map_comp, Category.assoc]
    rw [reassoc_of% nat, reassoc_of% key]

  have hbase : ∀ n, (wcEtLevelDiag D a ha A.F A.φ).map (AsSmall.up.map (homOfLE (Nat.le_succ n))) =
      wcEtLevelTheta D a A.F A.φ n (n + 1) (Nat.le_succ n) (haux n (n + 1) (Nat.le_succ n)) := by
    intro n
    exact Functor.ofSequence_map_homOfLE_succ (fun k => wcEtLevelTheta D a A.F A.φ k (k + 1)
      (Nat.le_add_right k 1) (congrArg (fun t => t.left) (ha k 1))) n

  have hdiag : ∀ k l (hkl : k + 1 ≤ l) (h : k ≤ l),
      (wcEtLevelDiag D a ha A.F A.φ).map (AsSmall.up.map (homOfLE h)) =
        wcEtLevelTheta D a A.F A.φ k l h (haux k l h) := by
    intro k l hkl
    induction l, hkl using Nat.le_induction with
    | base => intro h; exact hbase k
    | succ l hkl ih =>
      intro h
      have hkl' : k ≤ l := by omega
      have e : (homOfLE h : k ⟶ l + 1) = homOfLE hkl' ≫ homOfLE (Nat.le_succ l) :=
        Subsingleton.elim _ _
      rw [e, CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_comp, ih hkl', hbase l]
      exact (hθtrans k l (l + 1) hkl' (Nat.le_succ l)).symm
  refine Exists.elim (wc_et_local_cocone_colimit_iso Uinf.left (AsSmall.{u+1} ℕ)
    (wcEtLevelDiag D a ha A.F A.φ) A.Finf (fun i => A.ψ (AsSmall.down.obj i)) ?_ ?_ ?_
    ((wc_et_sheaf_colimit_cocone_local Uinf.left (AsSmall.{u+1} ℕ)
      (wcEtLevelDiag D a ha A.F A.φ)).1))
    (fun e he => ⟨e, fun k => he (AsSmall.up.obj k)⟩)
  ·
    rintro ⟨k⟩ ⟨l⟩ f
    have hkl : k ≤ l := leOfHom (AsSmall.down.map f)
    have hf : f = AsSmall.up.map (homOfLE hkl) := by
      first
        | rfl
        | exact ULift.ext _ _ (Subsingleton.elim _ _)
    subst hf
    rcases eq_or_lt_of_le hkl with rfl | hlt
    · have e1 : AsSmall.up.map (homOfLE hkl) = 𝟙 (AsSmall.up.obj k) := by
        rw [Subsingleton.elim (homOfLE hkl) (𝟙 k), CategoryTheory.Functor.map_id]
      have e2 : (wcEtLevelDiag D a ha A.F A.φ).map (AsSmall.up.map (homOfLE hkl)) = 𝟙 _ := by
        rw [e1, CategoryTheory.Functor.map_id]
      exact (congrArg (fun φ : (wcEtLevelDiag D a ha A.F A.φ).obj (AsSmall.up.obj k) ⟶
          (wcEtLevelDiag D a ha A.F A.φ).obj (AsSmall.up.obj k) => φ ≫ A.ψ k) e2).trans
        (Category.id_comp _)
    · have hd := hdiag k l hlt hkl
      refine (congrArg (fun φ : (wcEtLevelDiag D a ha A.F A.φ).obj (AsSmall.up.obj k) ⟶
          (wcEtLevelDiag D a ha A.F A.φ).obj (AsSmall.up.obj l) => φ ≫ A.ψ l) hd).trans ?_
      change (wcEtLevelTheta D a A.F A.φ k l hkl (haux k l hkl)) ≫ A.ψ l = A.ψ k
      unfold wcEtLevelTheta
      rw [Category.assoc]
      exact hSC2 k l hkl (haux k l hkl)
  ·
    intro V s
    refine (Scheme.smallEtaleTopology Uinf.left).superset_covering ?_ (hLC1 V s)
    apply Sieve.generate_mono
    rintro V' h ⟨k, x, hx⟩
    exact ⟨AsSmall.up.obj k, x, hx⟩
  ·
    rintro ⟨k⟩ V t ht
    refine (Scheme.smallEtaleTopology Uinf.left).superset_covering ?_ (hLC2 k V t ht)
    apply Sieve.generate_mono
    rintro V' h ⟨l, hkl, hel, h0⟩
    have hk1 : k + 1 ≤ l + 1 := by omega
    have hk : k ≤ l + 1 := by omega
    refine ⟨AsSmall.up.obj (l + 1), AsSmall.up.map (homOfLE hk), ?_⟩
    have hm := (hdiag k (l + 1) hk1 hk).trans (hθtrans k l (l + 1) hkl (Nat.le_succ l))
    have hx := congrArg (fun φ : (wcEtLevelDiag D a ha A.F A.φ).obj (AsSmall.up.obj k) ⟶
        (wcEtLevelDiag D a ha A.F A.φ).obj (AsSmall.up.obj (l + 1)) =>
      (φ.hom.app (Opposite.op V')).hom
        ((((wcEtLevelDiag D a ha A.F A.φ).obj (AsSmall.up.obj k)).obj.map h.op).hom t)) hm
    refine hx.trans ?_
    change ((wcEtLevelTheta D a A.F A.φ l (l + 1) (Nat.le_succ l)
        (haux l (l + 1) (Nat.le_succ l))).hom.app (Opposite.op V')).hom
      (((wcEtLevelTheta D a A.F A.φ k l hkl (haux k l hkl)).hom.app (Opposite.op V')).hom
        ((((wcEtInv (a k).left).obj (A.F k)).obj.map h.op).hom t)) = 0
    rw [show ((wcEtLevelTheta D a A.F A.φ k l hkl (haux k l hkl)).hom.app (Opposite.op V')).hom
        ((((wcEtInv (a k).left).obj (A.F k)).obj.map h.op).hom t) = 0 from h0, map_zero]

theorem wc_et_level_diag_natTrans : ∀ {S : Scheme.{u}} {Uinf : S.ProEt} (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k)) (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k) (F F' : ∀ k : ℕ, Sheaf (Scheme.smallEtaleTopology (D.obj (Opposite.op k)).left) AddCommGrpCat.{u+1}) (φ : ∀ (k l : ℕ) (h : k ≤ l), (wcEtInv (D.map (homOfLE h).op).left).obj (F k) ⟶ F l) (φ' : ∀ (k l : ℕ) (h : k ≤ l), (wcEtInv (D.map (homOfLE h).op).left).obj (F' k) ⟶ F' l) (u : ∀ k, F k ⟶ F' k), (∀ (k l : ℕ) (h : k ≤ l), (wcEtInv (D.map (homOfLE h).op).left).map (u k) ≫ φ' k l h = φ k l h ≫ u l) → ∃ α : wcEtLevelDiag D a ha F φ ⟶ wcEtLevelDiag D a ha F' φ', ∀ k, α.app (AsSmall.up.obj k) = (wcEtInv (a k).left).map (u k) :=
by
  intro S Uinf D a ha F F' φ φ' u hcomm

  have sq : ∀ n : ℕ,
      wcEtLevelTheta D a F φ n (n + 1) (Nat.le_add_right n 1)
          (congrArg (fun t => t.left) (ha n 1)) ≫
        (wcEtInv (a (n + 1)).left).map (u (n + 1)) =
      (wcEtInv (a n).left).map (u n) ≫
        wcEtLevelTheta D a F' φ' n (n + 1) (Nat.le_add_right n 1)
          (congrArg (fun t => t.left) (ha n 1)) := by
    intro n
    have key := (wc_etInvComp_natural (a (n + 1)).left
      (D.map (homOfLE (Nat.le_add_right n 1)).op).left (a n).left
      (congrArg (fun t => t.left) (ha n 1)) (u n)).2
    have hc := hcomm n (n + 1) (Nat.le_add_right n 1)
    unfold wcEtLevelTheta
    rw [Category.assoc, ← Functor.map_comp (wcEtInv (a (n + 1)).left)
      (φ n (n + 1) (Nat.le_add_right n 1)) (u (n + 1)), ← hc, Functor.map_comp,
      reassoc_of% key]
  let β : Functor.ofSequence (fun k => wcEtLevelTheta D a F φ k (k + 1) (Nat.le_add_right k 1)
        (congrArg (fun t => t.left) (ha k 1))) ⟶
      Functor.ofSequence (fun k => wcEtLevelTheta D a F' φ' k (k + 1) (Nat.le_add_right k 1)
        (congrArg (fun t => t.left) (ha k 1))) :=
    NatTrans.ofSequence (fun n => (wcEtInv (a n).left).map (u n)) (fun n => by
      rw [Functor.ofSequence_map_homOfLE_succ, Functor.ofSequence_map_homOfLE_succ]
      exact sq n)
  exact ⟨Functor.whiskerLeft AsSmall.down β, fun k => rfl⟩

theorem wc_et_sheaf_seq_colim_ses : ∀ (Y : Scheme.{u}) (G₁ G₂ G₃ : AsSmall.{u+1} ℕ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (α : G₁ ⟶ G₂) (β : G₂ ⟶ G₃) (wj : ∀ j, α.app j ≫ β.app j = 0) (wc : Limits.colimMap α ≫ Limits.colimMap β = 0), (∀ j, (ShortComplex.mk (α.app j) (β.app j) (wj j)).ShortExact) → (ShortComplex.mk (Limits.colimMap α) (Limits.colimMap β) wc).ShortExact :=
by
  intro Y G₁ G₂ G₃ α β wj wc h
  have hS : α ≫ β = 0 := by
    apply NatTrans.ext
    funext j
    rw [NatTrans.comp_app, wj j, NatTrans.app_zero]
  let S : ShortComplex (AsSmall.{u+1} ℕ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) :=
    ShortComplex.mk α β hS
  have : ∀ j, Mono (α.app j) := fun j => (h j).mono_f
  have : ∀ j, Epi (β.app j) := fun j => (h j).epi_g
  have hm : Mono α := NatTrans.mono_of_mono_app α
  have he : Epi β := NatTrans.epi_of_epi_app β
  have hex : S.Exact := by
    rw [ShortComplex.exact_iff_isZero_homology]
    apply Functor.isZero
    intro j
    have e := ShortComplex.mapHomologyIso S ((evaluation _ _).obj j)
    refine Limits.IsZero.of_iso ?_ e.symm
    rw [← ShortComplex.exact_iff_isZero_homology]
    exact (h j).exact
  have hSE : S.ShortExact := ShortComplex.ShortExact.mk' hex hm he
  have hmap := hSE.map_of_exact (Limits.colim)
  exact hmap

theorem wc_et_sys_injective_resolution (S : Scheme.{u}) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (A : wcEtSys D a) (hA : wcEtSysOK A) :
    ∃ (I Q : wcEtSys D a) (u : wcEtSysHom A I) (p : wcEtSysHom I Q)
      (w : ∀ k, u.f k ≫ p.f k = 0) (winf : u.finf ≫ p.finf = 0),
      wcEtSysOK I ∧ wcEtSysOK Q ∧ (∀ k, Injective (I.F k)) ∧
      (∀ k, (ShortComplex.mk (u.f k) (p.f k) (w k)).ShortExact) ∧
      (ShortComplex.mk u.finf p.finf winf).ShortExact :=
by
  classical
  have hSC1A : wcEtLevelSC1 D A.F A.φ := hA.1
  obtain ⟨I, φI, u, hSC1I, hcommu, hmono, hinj⟩ := wc_et_tower_cofree_level D A.F A.φ hSC1A
  obtain ⟨Q, φQ, p, w, hSC1Q, hcommp, hses⟩ :=
    wc_et_tower_level_cokernel D A.F I A.φ φI u hSC1I hcommu hmono
  obtain ⟨eA, heA⟩ := wc_et_sys_colim_iso D a ha A hA
  obtain ⟨αu, hαu⟩ := wc_et_level_diag_natTrans D a ha A.F I A.φ φI u hcommu
  obtain ⟨αp, hαp⟩ := wc_et_level_diag_natTrans D a ha I Q φI φQ p hcommp
  let I' : wcEtSys D a :=
    { F := I, Finf := Limits.colimit (wcEtLevelDiag D a ha I φI), φ := φI,
      ψ := fun k => Limits.colimit.ι (wcEtLevelDiag D a ha I φI) (AsSmall.up.obj k) }
  let Q' : wcEtSys D a :=
    { F := Q, Finf := Limits.colimit (wcEtLevelDiag D a ha Q φQ), φ := φQ,
      ψ := fun k => Limits.colimit.ι (wcEtLevelDiag D a ha Q φQ) (AsSmall.up.obj k) }
  have hI' : wcEtSysOK I' := wc_et_level_colim_ok D a ha I φI hSC1I
  have hQ' : wcEtSysOK Q' := wc_et_level_colim_ok D a ha Q φQ hSC1Q
  have hψu : ∀ k, (wcEtInv (a k).left).map (u k) ≫
      Limits.colimit.ι (wcEtLevelDiag D a ha I φI) (AsSmall.up.obj k) =
      A.ψ k ≫ (eA.inv ≫ Limits.colimMap αu) := by
    intro k
    have h1 : A.ψ k ≫ eA.inv =
        Limits.colimit.ι (wcEtLevelDiag D a ha A.F A.φ) (AsSmall.up.obj k) :=
      (Iso.comp_inv_eq eA).mpr (heA k).symm
    have h2 := Limits.ι_colimMap αu (AsSmall.up.obj k)
    rw [hαu k] at h2
    have h3 : (A.ψ k ≫ eA.inv) ≫ Limits.colimMap αu =
        A.ψ k ≫ (eA.inv ≫ Limits.colimMap αu) := Category.assoc _ _ _
    rw [h1] at h3
    exact h2.symm.trans h3
  have hψp : ∀ k, (wcEtInv (a k).left).map (p k) ≫
      Limits.colimit.ι (wcEtLevelDiag D a ha Q φQ) (AsSmall.up.obj k) =
      Limits.colimit.ι (wcEtLevelDiag D a ha I φI) (AsSmall.up.obj k) ≫ Limits.colimMap αp := by
    intro k
    have h2 := Limits.ι_colimMap αp (AsSmall.up.obj k)
    rw [hαp k] at h2
    exact h2.symm
  let u' : wcEtSysHom A I' :=
    { f := u, finf := eA.inv ≫ Limits.colimMap αu, comm_φ := hcommu, comm_ψ := hψu }
  let p' : wcEtSysHom I' Q' :=
    { f := p, finf := Limits.colimMap αp, comm_φ := hcommp, comm_ψ := hψp }
  have wj : ∀ j, αu.app j ≫ αp.app j = 0 := by
    intro j
    obtain ⟨k⟩ := j
    haveI := (wc_etInv_exact (a k).left).1
    change αu.app (AsSmall.up.obj k) ≫ αp.app (AsSmall.up.obj k) = 0
    have h := congrArg (fun f => (wcEtInv (a k).left).map f) (w k)
    simp only [Functor.map_comp, Functor.map_zero] at h
    rw [hαu k, hαp k]
    exact h
  have wc : Limits.colimMap αu ≫ Limits.colimMap αp = 0 := by
    apply Limits.colimit.hom_ext
    intro j
    rw [Limits.ι_colimMap_assoc, Limits.ι_colimMap, ← Category.assoc, wj j, Limits.zero_comp,
      Limits.comp_zero]
  have winf : u'.finf ≫ p'.finf = 0 := by
    change (eA.inv ≫ Limits.colimMap αu) ≫ Limits.colimMap αp = 0
    rw [Category.assoc, wc, Limits.comp_zero]
  have key : ∀ {X Y Z : Sheaf (Scheme.smallEtaleTopology Uinf.left) AddCommGrpCat.{u+1}}
      (f f' : X ⟶ Y) (g g' : Y ⟶ Z) (_ : f = f') (_ : g = g') (w₁ : f ≫ g = 0)
      (w₂ : f' ≫ g' = 0), (ShortComplex.mk f g w₁).ShortExact →
        (ShortComplex.mk f' g' w₂).ShortExact := by
    intro X Y Z f f' g g' hf hg w₁ w₂ h
    subst hf
    subst hg
    exact h
  have hlev : ∀ j, (ShortComplex.mk (αu.app j) (αp.app j) (wj j)).ShortExact := by
    intro j
    obtain ⟨k⟩ := j
    haveI := (wc_etInv_exact (a k).left).1
    haveI := (wc_etInv_exact (a k).left).2.1
    haveI := (wc_etInv_exact (a k).left).2.2
    have h1 := (hses k).map_of_exact (wcEtInv (a k).left)
    exact key _ _ _ _ (hαu k).symm (hαp k).symm _ _ h1
  have hcol := wc_et_sheaf_seq_colim_ses Uinf.left _ _ _ αu αp wj wc hlev
  have e : ShortComplex.mk (Limits.colimMap αu) (Limits.colimMap αp) wc ≅
      ShortComplex.mk u'.finf p'.finf winf :=
    ShortComplex.isoMk eA (Iso.refl _) (Iso.refl _)
      (by change eA.hom ≫ (eA.inv ≫ Limits.colimMap αu) = Limits.colimMap αu ≫ 𝟙 _; simp)
      (by change 𝟙 _ ≫ Limits.colimMap αp = Limits.colimMap αp ≫ 𝟙 _; simp)
  exact ⟨I', Q', u', p', w, winf, hI', hQ', hinj, hses, ShortComplex.shortExact_of_iso e hcol⟩

theorem wc_et_tower_basechange_system : ∀ (S : Scheme.{u}) {Uinf : S.ProEt} (D : ℕᵒᵖ ⥤ S.ProEt)
    (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k)),
    (∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k) →
    (∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k) →
    (∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left) →
    ∀ (U : Uinf.left.Etale) (l : ℕ) (U₀ : (D.obj (Opposite.op l)).left.Etale)
      (eU : U.left ⟶ U₀.left), IsPullback eU U.hom U₀.hom (a l).left →
    CompactSpace U₀.left → QuasiSeparatedSpace U₀.left →
    ∃ (G : ℕᵒᵖ ⥤ Scheme.{u}) (p : ∀ n, U.left ⟶ G.obj (Opposite.op n))
      (h : ∀ n, G.obj (Opposite.op n) ⟶ (D.obj (Opposite.op (l + n))).left),
      (∀ n, Etale (h n)) ∧ (∀ n, IsPullback (p n) U.hom (h n) (a (l + n)).left) ∧
      (∀ n j, p (n + j) ≫ G.map (homOfLE (Nat.le_add_right n j)).op = p n) ∧
      (∀ (T : Scheme.{u}) (z : ∀ n, T ⟶ G.obj (Opposite.op n)),
        (∀ n j, z (n + j) ≫ G.map (homOfLE (Nat.le_add_right n j)).op = z n) →
        ∃! z₀ : T ⟶ U.left, ∀ n, z₀ ≫ p n = z n) ∧
      (∀ n, CompactSpace (G.obj (Opposite.op n)) ∧ QuasiSeparatedSpace (G.obj (Opposite.op n))) ∧
      (∀ n j, IsAffineHom (G.map (homOfLE (Nat.le_add_right n j)).op)) ∧
      CompactSpace U.left :=
by
  intro S Uinf D a ha hlim haff U l U₀ eU hU hcU hqU
  classical

  have hhom : ∀ {m k : ℕ} (f g : (Opposite.op m : ℕᵒᵖ) ⟶ Opposite.op k), f = g :=
    fun f g => Quiver.Hom.unop_inj (Subsingleton.elim _ _)
  have hDc : ∀ {m n k : ℕ} (f : (Opposite.op m : ℕᵒᵖ) ⟶ Opposite.op n)
      (g : (Opposite.op n : ℕᵒᵖ) ⟶ Opposite.op k) (h : (Opposite.op m : ℕᵒᵖ) ⟶ Opposite.op k),
      (D.map f).left ≫ (D.map g).left = (D.map h).left := by
    intro m n k f g h
    rw [hhom h (f ≫ g), Functor.map_comp]
    rfl
  have hDD : ∀ {m n n' k : ℕ} (f : (Opposite.op m : ℕᵒᵖ) ⟶ Opposite.op n)
      (g : (Opposite.op n : ℕᵒᵖ) ⟶ Opposite.op k) (f' : (Opposite.op m : ℕᵒᵖ) ⟶ Opposite.op n')
      (g' : (Opposite.op n' : ℕᵒᵖ) ⟶ Opposite.op k),
      (D.map f).left ≫ (D.map g).left = (D.map f').left ≫ (D.map g').left :=
    fun f g f' g' => (hDc f g (f' ≫ g')).trans (hDc f' g' (f' ≫ g')).symm
  have hDid : ∀ {m : ℕ} (f : (Opposite.op m : ℕᵒᵖ) ⟶ Opposite.op m), (D.map f).left = 𝟙 _ := by
    intro m f
    rw [hhom f (𝟙 _), D.map_id]
    rfl
  have haG : ∀ {m k : ℕ} (f : (Opposite.op m : ℕᵒᵖ) ⟶ Opposite.op k),
      (a m).left ≫ (D.map f).left = (a k).left := by
    intro m k f
    have hk : k ≤ m := leOfHom f.unop
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hk
    rw [hhom f (homOfLE (Nat.le_add_right k j)).op]
    exact congrArg (fun t => t.left) (ha k j)

  obtain ⟨G, fst, snd, hG, hfst, hsnd⟩ : ∃ (G : ℕᵒᵖ ⥤ Scheme.{u})
      (fst : ∀ n, G.obj (Opposite.op n) ⟶ U₀.left)
      (snd : ∀ n, G.obj (Opposite.op n) ⟶ (D.obj (Opposite.op (l + n))).left),
      (∀ n, IsPullback (fst n) (snd n) U₀.hom (D.map (homOfLE (Nat.le_add_right l n)).op).left) ∧
      (∀ {m n : ℕ} (f : (Opposite.op m : ℕᵒᵖ) ⟶ Opposite.op n), G.map f ≫ fst n = fst m) ∧
      (∀ {m n : ℕ} (f : (Opposite.op m : ℕᵒᵖ) ⟶ Opposite.op n)
        (g : (Opposite.op (l + m) : ℕᵒᵖ) ⟶ Opposite.op (l + n)),
        G.map f ≫ snd n = snd m ≫ (D.map g).left) := by
    have hw : ∀ {X Y : ℕᵒᵖ} (f : X ⟶ Y),
        Limits.pullback.fst U₀.hom (D.map (homOfLE (Nat.le_add_right l X.unop)).op).left ≫ U₀.hom =
          (Limits.pullback.snd U₀.hom (D.map (homOfLE (Nat.le_add_right l X.unop)).op).left ≫
            (D.map (homOfLE (Nat.add_le_add_left (leOfHom f.unop) l)).op).left) ≫
            (D.map (homOfLE (Nat.le_add_right l Y.unop)).op).left := by
      intro X Y f
      rw [Category.assoc, hDc _ _ (homOfLE (Nat.le_add_right l X.unop)).op]
      exact Limits.pullback.condition
    refine ⟨{ obj := fun X => Limits.pullback U₀.hom (D.map (homOfLE (Nat.le_add_right l X.unop)).op).left
              map := fun {X Y} f => Limits.pullback.lift _ _ (hw f)
              map_id := ?_
              map_comp := ?_ },
      fun n => Limits.pullback.fst _ _, fun n => Limits.pullback.snd _ _,
      fun n => IsPullback.of_hasPullback _ _, ?_, ?_⟩
    · intro X
      apply Limits.pullback.hom_ext
      · simp only [Limits.pullback.lift_fst, Category.id_comp]
      · simp only [Limits.pullback.lift_snd, Category.id_comp]
        rw [hDid, Category.comp_id]
    · intro X Y Z f g
      apply Limits.pullback.hom_ext
      · simp only [Limits.pullback.lift_fst, Category.assoc]
      · simp only [Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc, Category.assoc]
        congr 1
        exact (hDc _ _ _).symm
    · intro m n f
      exact Limits.pullback.lift_fst _ _ _
    · intro m n f g
      refine (Limits.pullback.lift_snd _ _ _).trans ?_
      rw [hhom (homOfLE (Nat.add_le_add_left (leOfHom f.unop) l)).op g]

  have hw : ∀ n, eU ≫ U₀.hom = (U.hom ≫ (a (l + n)).left) ≫
      (D.map (homOfLE (Nat.le_add_right l n)).op).left := by
    intro n
    rw [Category.assoc, haG]
    exact hU.w
  obtain ⟨p, hp1, hp2⟩ : ∃ p : ∀ n, U.left ⟶ G.obj (Opposite.op n),
      (∀ n, p n ≫ fst n = eU) ∧ (∀ n, p n ≫ snd n = U.hom ≫ (a (l + n)).left) :=
    ⟨fun n => (hG n).lift eU (U.hom ≫ (a (l + n)).left) (hw n),
      fun n => (hG n).lift_fst _ _ _, fun n => (hG n).lift_snd _ _ _⟩
  have hpb : ∀ n, IsPullback (p n) U.hom (snd n) (a (l + n)).left := by
    intro n
    refine IsPullback.of_right ?_ (hp2 n) (hG n)
    rw [hp1 n, haG]
    exact hU
  have hpG : ∀ {m n : ℕ} (f : (Opposite.op m : ℕᵒᵖ) ⟶ Opposite.op n), p m ≫ G.map f = p n := by
    intro m n f
    apply (hG n).hom_ext
    · rw [Category.assoc, hfst, hp1, hp1]
    · rw [Category.assoc, hsnd f (homOfLE (Nat.add_le_add_left (leOfHom f.unop) l)).op,
        ← Category.assoc, hp2, hp2, Category.assoc, haG]

  have hlimG : ∀ (T : Scheme.{u}) (z : ∀ n, T ⟶ G.obj (Opposite.op n)),
      (∀ n j, z (n + j) ≫ G.map (homOfLE (Nat.le_add_right n j)).op = z n) →
      ∃! z₀ : T ⟶ U.left, ∀ n, z₀ ≫ p n = z n := by
    intro T z hz
    have hzG : ∀ {m n : ℕ} (f : (Opposite.op m : ℕᵒᵖ) ⟶ Opposite.op n), z m ≫ G.map f = z n := by
      intro m n f
      have hk : n ≤ m := leOfHom f.unop
      obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hk
      rw [hhom f (homOfLE (Nat.le_add_right n j)).op]
      exact hz n j
    have hb : ∀ n, z n ≫ fst n = z 0 ≫ fst 0 := by
      intro n
      rw [← hfst (homOfLE (Nat.zero_le n)).op, ← Category.assoc, hzG]
    have hy : ∀ k j, (z (k + j) ≫ snd (k + j) ≫
        (D.map (homOfLE (Nat.le_add_left (k + j) l)).op).left) ≫
        (D.map (homOfLE (Nat.le_add_right k j)).op).left =
        z k ≫ snd k ≫ (D.map (homOfLE (Nat.le_add_left k l)).op).left := by
      intro k j
      rw [Category.assoc, Category.assoc,
        hDD (homOfLE (Nat.le_add_left (k + j) l)).op (homOfLE (Nat.le_add_right k j)).op
          (homOfLE (Nat.add_le_add_left (Nat.le_add_right k j) l)).op
          (homOfLE (Nat.le_add_left k l)).op,
        ← Category.assoc (snd (k + j)), ← hsnd (homOfLE (Nat.le_add_right k j)).op,
        ← Category.assoc (z (k + j)), ← Category.assoc (z (k + j)), hz k j, Category.assoc]
    obtain ⟨w, hw0, hwu⟩ := hlim T
      (fun k => z k ≫ snd k ≫ (D.map (homOfLE (Nat.le_add_left k l)).op).left) hy
    have hw' : ∀ k, w ≫ (a k).left =
        z k ≫ snd k ≫ (D.map (homOfLE (Nat.le_add_left k l)).op).left := hw0
    have hsq : (z 0 ≫ fst 0) ≫ U₀.hom = w ≫ (a l).left := by
      rw [hw' l, ← hb l, Category.assoc, (hG l).w]
    refine ⟨hU.lift (z 0 ≫ fst 0) w hsq, fun n => ?_, fun m hm => ?_⟩
    · apply (hG n).hom_ext
      · rw [Category.assoc, hp1, hU.lift_fst, hb n]
      · rw [Category.assoc, hp2, ← Category.assoc, hU.lift_snd, hw' (l + n),
          ← hsnd (homOfLE (Nat.le_add_left n l)).op, ← Category.assoc, hzG]
    · apply hU.hom_ext
      · rw [hU.lift_fst, ← hp1 0, ← Category.assoc, hm]
      · rw [hU.lift_snd]
        apply hwu
        intro k
        show (m ≫ U.hom) ≫ (a k).left =
          z k ≫ snd k ≫ (D.map (homOfLE (Nat.le_add_left k l)).op).left
        rw [← haG (homOfLE (Nat.le_add_left k l)).op]
        simp only [Category.assoc]
        rw [← Category.assoc U.hom, ← hp2 k, Category.assoc, ← Category.assoc m, hm]

  have hfa : ∀ n, IsAffineHom (fst n) := fun n =>
    MorphismProperty.of_isPullback (P := @IsAffineHom) (hG n).flip (haff l n)
  have hqcG : ∀ n, CompactSpace (G.obj (Opposite.op n)) ∧
      QuasiSeparatedSpace (G.obj (Opposite.op n)) := by
    intro n
    haveI := hfa n
    haveI := hcU
    haveI := hqU
    exact ⟨QuasiCompact.compactSpace_of_compactSpace (fst n),
      quasiSeparatedSpace_of_quasiSeparated (fst n)⟩
  have haffGen : ∀ {m n : ℕ} (f : (Opposite.op m : ℕᵒᵖ) ⟶ Opposite.op n), IsAffineHom (G.map f) := by
    intro m n f
    haveI : IsAffineHom (G.map f ≫ fst n) := by
      rw [hfst]; exact hfa m
    haveI := hfa n
    exact IsAffineHom.of_comp _ (fst n)

  have hcUleft : CompactSpace U.left := by
    let G' : AsSmall.{u} ℕᵒᵖ ⥤ Scheme.{u} := AsSmall.down ⋙ G
    let c : Limits.Cone G' :=
      { pt := U.left
        π := { app := fun i => p (ULift.down i).unop
               naturality := by
                 rintro ⟨⟨m⟩⟩ ⟨⟨k⟩⟩ f
                 show 𝟙 U.left ≫ p k = p m ≫ G.map f.down
                 rw [Category.id_comp]
                 exact (hpG f.down).symm } }
    have hc : Limits.IsLimit c := Limits.IsLimit.ofExistsUnique (fun s => by
      obtain ⟨z₀, hz₀, hz₀u⟩ := hlimG s.pt (fun k => s.π.app (AsSmall.up.obj (Opposite.op k)))
        (fun k j => s.w (AsSmall.up.map (homOfLE (Nat.le_add_right k j)).op))
      refine ⟨z₀, ?_, fun m hm => hz₀u m (fun k => hm (AsSmall.up.obj (Opposite.op k)))⟩
      rintro ⟨⟨k⟩⟩
      exact hz₀ k)
    haveI : ∀ {i j : AsSmall.{u} ℕᵒᵖ} (f : i ⟶ j), IsAffineHom (G'.map f) := by
      rintro ⟨⟨m⟩⟩ ⟨⟨k⟩⟩ f
      exact haffGen f.down
    haveI : ∀ i : AsSmall.{u} ℕᵒᵖ, CompactSpace (G'.obj i) := by
      rintro ⟨⟨k⟩⟩
      exact (hqcG k).1
    exact Scheme.compactSpace_of_isLimit G' c hc
  exact ⟨G, p, snd, fun n => MorphismProperty.of_isPullback (P := @Etale) (hG n) U₀.prop, hpb,
    fun n j => hpG _, hlimG, hqcG, fun n j => haffGen _, hcUleft⟩

theorem wc_sch_tower_etale_point_descend : ∀ (G : ℕᵒᵖ ⥤ Scheme.{u}) (X : Scheme.{u})
    (p : ∀ n, X ⟶ G.obj (Opposite.op n)),
    (∀ n j, p (n + j) ≫ G.map (homOfLE (Nat.le_add_right n j)).op = p n) →
    (∀ (T : Scheme.{u}) (z : ∀ n, T ⟶ G.obj (Opposite.op n)),
      (∀ n j, z (n + j) ≫ G.map (homOfLE (Nat.le_add_right n j)).op = z n) →
      ∃! z₀ : T ⟶ X, ∀ n, z₀ ≫ p n = z n) →
    (∀ n j, IsAffineHom (G.map (homOfLE (Nat.le_add_right n j)).op)) →
    ∀ (O : Scheme.{u}) (d : O ⟶ X), Etale d → ∀ o : O,
    ∃ (n : ℕ) (E : Scheme.{u}) (c : E ⟶ G.obj (Opposite.op n))
      (j : Limits.pullback (p n) c ⟶ O) (q : ↥(Limits.pullback (p n) c)),
      IsAffine E ∧ Etale c ∧ j ≫ d = Limits.pullback.fst (p n) c ∧ j q = o :=
by
  intro G X p hp hlim haff O d hd o
  classical



  have s1 : ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ Scheme.{u})
      (π : ∀ l, X ⟶ D.obj l), (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ D.map t = π l') →
      (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ D.obj l), (∀ {l l' : Λ} (t : l ⟶ l'),
        z l ≫ D.map t = z l') → ∃! z₀ : T ⟶ X, ∀ l, z₀ ≫ π l = z l) →
      (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t)) →
      ∀ (l₀ : Λ) (A₀ : (D.obj l₀).Opens), IsAffineOpen A₀ →
      ∃ (I : Type u) (_ : SmallCategory I) (_ : IsCofiltered I) (D' : I ⥤ Scheme.{u})
        (c' : Limits.Cone D') (lev : I → Λ) (ιP : c'.pt ⟶ X) (κ : ∀ i, D'.obj i ⟶ D.obj (lev i)),
        Nonempty (Limits.IsLimit c') ∧ (∀ {i i' : I} (f : i ⟶ i'), IsAffineHom (D'.map f)) ∧
        (∀ i, IsAffine (D'.obj i)) ∧ (∀ i, IsOpenImmersion (κ i)) ∧ IsOpenImmersion ιP ∧
        (∀ i, IsPullback (c'.π.app i) ιP (κ i) (π (lev i))) ∧
        Set.range ιP = (π l₀) ⁻¹' (A₀ : Set (D.obj l₀)) := by
    intro Λ _ _ D π hc hlimD haffD l₀ A₀ hA₀
    let cn : Limits.Cone D :=
      { pt := X
        π := { app := fun l => π l
               naturality := fun l l' t => (Category.id_comp _).trans (hc t).symm } }
    have hcn : Limits.IsLimit cn := Limits.IsLimit.ofExistsUnique (fun s =>
      hlimD s.pt (fun l => s.π.app l) (fun t => s.w t))
    have hcn' : Limits.IsLimit (cn.whisker (Over.forget l₀)) :=
      (Functor.Initial.isLimitWhiskerEquiv (Over.forget l₀) cn).symm hcn
    have hres : ∀ (T : Scheme.{u}) (z : ∀ n : Over l₀, T ⟶ D.obj n.left),
        (∀ {n n' : Over l₀} (t : n ⟶ n'), z n ≫ D.map t.left = z n') →
        ∃ z₀ : T ⟶ X, (∀ n, z₀ ≫ π n.left = z n) ∧
          ∀ w : T ⟶ X, (∀ n, w ≫ π n.left = z n) → w = z₀ := by
      intro T z hz
      let s' : Limits.Cone (Over.forget l₀ ⋙ D) :=
        { pt := T
          π := { app := fun n => z n
                 naturality := fun n n' t => (Category.id_comp _).trans (hz t).symm } }
      exact ⟨hcn'.lift s', fun n => hcn'.fac s' n, fun w hw => hcn'.uniq s' w hw⟩
    have hmapcomp : ∀ {a b c : Λ} (f : a ⟶ b) (g : b ⟶ c),
        D.map (f ≫ g) = D.map f ≫ D.map g := fun f g => D.map_comp f g
    let V : ∀ n : Over l₀, (D.obj n.left).Opens := fun n => D.map n.hom ⁻¹ᵁ A₀
    have hDcomp : ∀ {n n' : Over l₀} (t : n ⟶ n'),
        D.map n.hom = D.map t.left ≫ D.map n'.hom := by
      intro n n' t
      rw [← hmapcomp, Over.w t]
    have hVeq : ∀ {n n' : Over l₀} (t : n ⟶ n'), V n = D.map t.left ⁻¹ᵁ V n' := by
      intro n n' t
      show D.map n.hom ⁻¹ᵁ A₀ = D.map t.left ⁻¹ᵁ (D.map n'.hom ⁻¹ᵁ A₀)
      rw [hDcomp t, Scheme.Hom.comp_preimage]
    have hVaff : ∀ n, IsAffineOpen (V n) := fun n =>
      @IsAffineOpen.preimage _ _ _ hA₀ (D.map n.hom) (haffD n.hom)
    obtain ⟨D', κ, hκ, hrange, hD'aff, hnat⟩ : ∃ (D' : Over l₀ ⥤ Scheme.{u})
        (κ : ∀ n, D'.obj n ⟶ D.obj n.left), (∀ n, IsOpenImmersion (κ n)) ∧
        (∀ n, Set.range (κ n) = (V n : Set (D.obj n.left))) ∧ (∀ n, IsAffine (D'.obj n)) ∧
        (∀ {n n' : Over l₀} (t : n ⟶ n'), D'.map t ≫ κ n' = κ n ≫ D.map t.left) := by
      let D'' : Over l₀ ⥤ Scheme.{u} :=
        { obj := fun n => (V n : Scheme.{u})
          map := fun {n n'} t => (D.map t.left).resLE (V n') (V n) (hVeq t).le
          map_id := fun n => by
            rw [← cancel_mono (V n).ι, Scheme.Hom.resLE_comp_ι]
            have : D.map (𝟙 n : n ⟶ n).left = 𝟙 _ := by
              rw [Over.id_left, D.map_id]
            rw [this, Category.comp_id, Category.id_comp]
          map_comp := fun {a b c} f g => by
            rw [← cancel_mono (V c).ι, Scheme.Hom.resLE_comp_ι, Category.assoc,
              Scheme.Hom.resLE_comp_ι, ← Category.assoc, Scheme.Hom.resLE_comp_ι,
              Category.assoc, Over.comp_left, hmapcomp] }
      exact ⟨D'', fun n => (V n).ι, fun n => inferInstance, fun n => Scheme.Opens.range_ι _,
        fun n => hVaff n, fun t => Scheme.Hom.resLE_comp_ι _ _⟩
    let P : X.Opens := (π l₀) ⁻¹ᵁ A₀
    have hR : ∀ n : Over l₀, (π n.left) ⁻¹' Set.range (κ n) = Set.range P.ι := by
      intro n
      ext x
      rw [Set.mem_preimage, hrange n, Scheme.Opens.range_ι]
      show D.map n.hom (π n.left x) ∈ A₀ ↔ π l₀ x ∈ A₀
      rw [← Scheme.Hom.comp_apply, hc n.hom]
    have hleg_range : ∀ n : Over l₀, Set.range (P.ι ≫ π n.left) ⊆ Set.range (κ n) := by
      rintro n _ ⟨w, rfl⟩
      have h1 : P.ι w ∈ (π n.left) ⁻¹' Set.range (κ n) := by
        rw [hR n]; exact ⟨w, rfl⟩
      rw [Scheme.Hom.comp_apply]
      exact h1
    have hlegex : ∀ n : Over l₀, ∃ g : (P : Scheme.{u}) ⟶ D'.obj n,
        g ≫ κ n = P.ι ≫ π n.left := by
      intro n
      haveI := hκ n
      exact ⟨_, IsOpenImmersion.lift_fac _ _ (hleg_range n)⟩
    choose leg hleg using hlegex
    let c' : Limits.Cone D' :=
      { pt := (P : Scheme.{u})
        π := { app := leg
               naturality := fun n n' t => by
                 haveI := hκ n'
                 simp only [Functor.const_obj_obj, Functor.const_obj_map, Category.id_comp]
                 rw [← cancel_mono (κ n'), Category.assoc, hnat t, ← Category.assoc, hleg n,
                   hleg n', Category.assoc, hc t.left] } }
    have hlimc' : Limits.IsLimit c' := by
      refine Limits.IsLimit.ofExistsUnique (fun s => ?_)
      obtain ⟨z₀, hz₀, hz₀u⟩ := hres s.pt (fun n => s.π.app n ≫ κ n) (fun {n n'} t => by
        rw [Category.assoc, ← hnat t, ← Category.assoc, s.w t])
      obtain ⟨n₀⟩ := IsCofiltered.nonempty (C := Over l₀)
      have hz₀r : Set.range z₀ ⊆ Set.range P.ι := by
        rintro _ ⟨x, rfl⟩
        have h1 : π n₀.left (z₀ x) = κ n₀ (s.π.app n₀ x) := by
          rw [← Scheme.Hom.comp_apply, hz₀ n₀, Scheme.Hom.comp_apply]
        have h2 : z₀ x ∈ (π n₀.left) ⁻¹' Set.range (κ n₀) := by
          rw [Set.mem_preimage, h1]; exact ⟨_, rfl⟩
        rw [hR n₀] at h2
        exact h2
      have hm : IsOpenImmersion.lift P.ι z₀ hz₀r ≫ P.ι = z₀ := IsOpenImmersion.lift_fac _ _ _
      refine ⟨IsOpenImmersion.lift P.ι z₀ hz₀r, fun n => ?_, fun m' hm' => ?_⟩
      · haveI := hκ n
        rw [← cancel_mono (κ n)]
        show (IsOpenImmersion.lift P.ι z₀ hz₀r ≫ leg n) ≫ κ n = s.π.app n ≫ κ n
        rw [Category.assoc, hleg n, ← Category.assoc, hm, hz₀ n]
      · rw [← cancel_mono P.ι, hm]
        apply hz₀u
        intro n
        have h2 : m' ≫ leg n = s.π.app n := hm' n
        rw [Category.assoc, ← hleg n, ← Category.assoc, h2]
    haveI : ∀ n, IsAffine (D'.obj n) := hD'aff
    refine ⟨Over l₀, inferInstance, inferInstance, D', c', fun n => n.left, P.ι, κ, ⟨hlimc'⟩,
      fun f => isAffineHom_of_isAffine _, hD'aff, hκ, inferInstance, fun n => ?_, ?_⟩
    · haveI := hκ n
      refine IsOpenImmersion.isPullback (c'.π.app n) P.ι (κ n) (π n.left) (hleg n).symm ?_
      apply SetLike.coe_injective
      rw [Scheme.Hom.coe_preimage, Scheme.Hom.coe_opensRange, Scheme.Hom.coe_opensRange]
      exact hR n
    · rw [Scheme.Opens.range_ι]
      rfl



  have glue : ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ Scheme.{u})
      (π : ∀ l, X ⟶ D.obj l), (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ D.map t = π l') →
      (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ D.obj l), (∀ {l l' : Λ} (t : l ⟶ l'),
        z l ≫ D.map t = z l') → ∃! z₀ : T ⟶ X, ∀ l, z₀ ≫ π l = z l) →
      (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t)) →
      ∃ (l : Λ) (E : Scheme.{u}) (c : E ⟶ D.obj l) (j : Limits.pullback (π l) c ⟶ O)
        (q : ↥(Limits.pullback (π l) c)),
        IsAffine E ∧ Etale c ∧ j ≫ d = Limits.pullback.fst (π l) c ∧ j q = o := by
    intro Λ _ _ D π hc hlimD haffD

    obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
    obtain ⟨A₀, hA₀, hmem, -⟩ := exists_isAffineOpen_mem_and_subset
      (U := (⊤ : (D.obj l₀).Opens)) (x := π l₀ (d o)) trivial

    obtain ⟨I, _, _, D', c', lev, ιP, κ, ⟨hlimc'⟩, haffT, haffO, hκ, hιP, hpb, hrange⟩ :=
      s1 Λ D π hc hlimD haffD l₀ A₀ hA₀
    haveI : ∀ {i i' : I} (f : i ⟶ i'), IsAffineHom (D'.map f) := fun f => haffT f
    haveI : ∀ i, IsAffine (D'.obj i) := haffO
    haveI hcpt : ∀ i, CompactSpace (D'.obj i) := fun i => inferInstance
    haveI hqs : ∀ i, QuasiSeparatedSpace (D'.obj i) := fun i => inferInstance
    haveI : IsOpenImmersion ιP := hιP
    haveI : IsAffine c'.pt := Scheme.isAffine_of_isLimit c' hlimc'

    have hu : d o ∈ Set.range ιP := by rw [hrange]; exact hmem
    have hoV : o ∈ d ⁻¹ᵁ ιP.opensRange := by
      rw [Scheme.Hom.mem_preimage, ← SetLike.mem_coe, Scheme.Hom.coe_opensRange]; exact hu
    obtain ⟨W, hW, hoW, hWV⟩ := exists_isAffineOpen_mem_and_subset hoV
    haveI : IsAffine (W : Scheme.{u}) := hW
    have hWr : Set.range (W.ι ≫ d) ⊆ Set.range ιP := by
      rintro _ ⟨w, rfl⟩
      have h1 : W.ι w ∈ d ⁻¹ᵁ ιP.opensRange :=
        (congrArg (fun x => x ∈ d ⁻¹ᵁ ιP.opensRange) (Scheme.Opens.ι_apply W w)).mpr (hWV w.2)
      have h2 : d (W.ι w) ∈ ιP.opensRange := (Scheme.Hom.mem_preimage _).mp h1
      have h3 : d (W.ι w) ∈ Set.range ιP := Eq.subset (Scheme.Hom.coe_opensRange ιP) h2
      exact Set.mem_of_eq_of_mem (Scheme.Hom.comp_apply W.ι d w) h3
    let d₀ : (W : Scheme.{u}) ⟶ c'.pt := IsOpenImmersion.lift ιP (W.ι ≫ d) hWr
    have hd₀ : d₀ ≫ ιP = W.ι ≫ d := IsOpenImmersion.lift_fac _ _ _

    haveI hdet : Etale d := hd
    have hd₀ι : Etale (d₀ ≫ ιP) := by rw [hd₀]; infer_instance
    haveI hd₀et : Etale d₀ :=
      MorphismProperty.of_postcomp (W' := @Etale) @Etale d₀ ιP inferInstance hd₀ι
    letI algPW : Algebra Γ(c'.pt, ⊤) Γ((W : Scheme.{u}), ⊤) := d₀.appTop.hom.toAlgebra
    have hEt : Algebra.Etale Γ(c'.pt, ⊤) Γ((W : Scheme.{u}), ⊤) :=
      RingHom.Etale.toAlgebra (HasRingHomProperty.appTop @Etale d₀ hd₀et)

    obtain ⟨n, fP, val, hs, hk, g₁, hg⟩ :=
      wc_sh_standard_presentation_fin Γ(c'.pt, ⊤) Γ((W : Scheme.{u}), ⊤) hEt
    let eW : (MvPolynomial (Fin n) Γ(c'.pt, ⊤) ⧸ Ideal.span (Set.range fP)) ≃ₐ[Γ(c'.pt, ⊤)]
        Γ((W : Scheme.{u}), ⊤) :=
      (Ideal.quotientEquivAlgOfEq Γ(c'.pt, ⊤) hk.symm).trans
        (Ideal.quotientKerAlgEquivOfSurjective hs)

    have hcomp : ∀ {i j k : I} (f : k ⟶ j) (h : j ⟶ i) (b : Γ(D'.obj i, ⊤)),
        (D'.map (f ≫ h)).appTop.hom b = (D'.map f).appTop.hom ((D'.map h).appTop.hom b) := by
      intro i j k f h b
      rw [Functor.map_comp, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    have hcompat : ∀ {i j : I} (f : j ⟶ i) (b : Γ(D'.obj i, ⊤)),
        (c'.π.app j).appTop.hom ((D'.map f).appTop.hom b) = (c'.π.app i).appTop.hom b := by
      intro i j f b
      rw [← c'.w f, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    have hlift : ∀ r : Γ(c'.pt, ⊤), ∃ (i : I) (b : Γ(D'.obj i, ⊤)),
        (c'.π.app i).appTop.hom b = r := by
      intro r
      obtain ⟨i, t, ht⟩ := exists_appTop_π_eq_of_isLimit D' c' hlimc' r
      exact ⟨i, t, ht.symm⟩
    have hvan : ∀ (i : I) (b : Γ(D'.obj i, ⊤)), (c'.π.app i).appTop.hom b = 0 →
        ∃ (j : I) (f : j ⟶ i), (D'.map f).appTop.hom b = 0 := by
      intro i b hb
      exact exists_appTop_map_eq_zero_of_isLimit D' c' hlimc' b hb

    obtain ⟨i, f₀, g₀, hmap, hcert⟩ := wc_colim_standard_etale_data_descend I
      (fun i => (Γ(D'.obj i, ⊤) : Type u)) Γ(c'.pt, ⊤) (fun i => (c'.π.app i).appTop.hom)
      (fun f => (D'.map f).appTop.hom) hcomp hcompat hlift hvan n fP g₁ hg

    have hAet : Algebra.Etale Γ(D'.obj i, ⊤)
        (MvPolynomial (Fin n) Γ(D'.obj i, ⊤) ⧸ Ideal.span (Set.range f₀)) :=
      wc_standard_etale_quotient Γ(D'.obj i, ⊤) id Function.bijective_id f₀ g₀ hcert

    letI algYP : Algebra Γ(D'.obj i, ⊤) Γ(c'.pt, ⊤) := (c'.π.app i).appTop.hom.toAlgebra
    obtain ⟨e4⟩ := wc_tensor_mvpoly_quotient_equiv Γ(D'.obj i, ⊤) Γ(c'.pt, ⊤) n f₀
    have hfun : (fun b => MvPolynomial.map (algebraMap Γ(D'.obj i, ⊤) Γ(c'.pt, ⊤)) (f₀ b)) = fP :=
      funext hmap
    have hideal : Ideal.span (Set.range fun b =>
        MvPolynomial.map (algebraMap Γ(D'.obj i, ⊤) Γ(c'.pt, ⊤)) (f₀ b)) =
        Ideal.span (Set.range fP) :=
      congrArg (fun s => Ideal.span (Set.range s)) hfun
    let ε := e4.trans ((Ideal.quotientEquivAlgOfEq Γ(c'.pt, ⊤) hideal).trans eW)

    obtain ⟨E₀, e, j₃, hj₃iso, hE₀aff, he, hj₃⟩ := wc_affine_etale_realize_tensor c'.pt (D'.obj i)
      (W : Scheme.{u}) (c'.π.app i) d₀
      (MvPolynomial (Fin n) Γ(D'.obj i, ⊤) ⧸ Ideal.span (Set.range f₀)) hAet (Nonempty.intro ε)

    haveI := hj₃iso
    haveI := he
    haveI := hκ i
    have H := ((IsPullback.of_hasPullback (c'.π.app i) e).flip.paste_vert (hpb i)).flip
    let j₁ := H.isoPullback.inv ≫ j₃
    have hj₁ : j₁ ≫ d₀ ≫ ιP = Limits.pullback.fst (π (lev i)) (e ≫ κ i) := by
      simp only [j₁, Category.assoc]
      rw [← Category.assoc j₃, hj₃]
      exact H.isoPullback_inv_fst
    haveI : IsIso j₁ := by simp only [j₁]; infer_instance
    obtain ⟨q, hq⟩ := Scheme.Hom.surjective j₁ ⟨o, hoW⟩

    refine ⟨lev i, E₀, e ≫ κ i, j₁ ≫ W.ι, q, hE₀aff, inferInstance, ?_, ?_⟩
    · exact (Category.assoc _ _ _).trans ((congrArg (fun k => j₁ ≫ k) hd₀.symm).trans hj₁)
    · exact (Scheme.Hom.comp_apply j₁ W.ι q).trans
        ((congrArg W.ι hq).trans (Scheme.Opens.ι_apply W ⟨o, hoW⟩))



  have hhom : ∀ {a b : ℕᵒᵖ} (f g : a ⟶ b), f = g := fun f g =>
    Quiver.Hom.unop_inj (Subsingleton.elim _ _)
  have hCA : ∀ (a b : ℕᵒᵖ) (f : a ⟶ b),
      p a.unop ≫ G.map f = p b.unop ∧ IsAffineHom (G.map f) := by
    intro a b f
    obtain ⟨a⟩ := a
    obtain ⟨b⟩ := b
    have h : b ≤ a := leOfHom f.unop
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
    rw [hhom f (homOfLE (Nat.le_add_right b j)).op]
    exact ⟨hp b j, haff b j⟩
  have hcΛ : ∀ {l l' : AsSmall.{u} ℕᵒᵖ} (t : l ⟶ l'),
      p (AsSmall.down.obj l).unop ≫ (AsSmall.down ⋙ G).map t = p (AsSmall.down.obj l').unop :=
    fun t => (hCA _ _ (AsSmall.down.map t)).1
  have haffΛ : ∀ {l l' : AsSmall.{u} ℕᵒᵖ} (t : l ⟶ l'), IsAffineHom ((AsSmall.down ⋙ G).map t) :=
    fun t => (hCA _ _ (AsSmall.down.map t)).2
  have hlimΛ : ∀ (T : Scheme.{u}) (z : ∀ l : AsSmall.{u} ℕᵒᵖ, T ⟶ (AsSmall.down ⋙ G).obj l),
      (∀ {l l' : AsSmall.{u} ℕᵒᵖ} (t : l ⟶ l'), z l ≫ (AsSmall.down ⋙ G).map t = z l') →
      ∃! z₀ : T ⟶ X, ∀ l, z₀ ≫ p (AsSmall.down.obj l).unop = z l := by
    intro T z hz
    let z' : ∀ n, T ⟶ G.obj (Opposite.op n) := fun n => z (AsSmall.up.obj (Opposite.op n))
    have hz' : ∀ n j, z' (n + j) ≫ G.map (homOfLE (Nat.le_add_right n j)).op = z' n :=
      fun n j => hz (AsSmall.up.map (homOfLE (Nat.le_add_right n j)).op)
    obtain ⟨z₀, hz₀, hu⟩ := hlim T z' hz'
    refine ⟨z₀, fun l => hz₀ (AsSmall.down.obj l).unop, fun w hw => hu w (fun n => ?_)⟩
    exact hw (AsSmall.up.obj (Opposite.op n))
  obtain ⟨l, E, c, j, q, h1, h2, h3, h4⟩ := glue (AsSmall.{u} ℕᵒᵖ) (AsSmall.down ⋙ G)
    (fun l => p (AsSmall.down.obj l).unop) hcΛ hlimΛ haffΛ
  exact ⟨(AsSmall.down.obj l).unop, E, c, j, q, h1, h2, h3, h4⟩

theorem wc_et_tower_cover_descends (S : Scheme.{u}) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left)
    (U : Uinf.left.Etale) (l : ℕ) (U₀ : (D.obj (Opposite.op l)).left.Etale)
    (eU : U.left ⟶ U₀.left) (hU : IsPullback eU U.hom U₀.hom (a l).left)
    (hcU : CompactSpace U₀.left) (hqU : QuasiSeparatedSpace U₀.left)
    (R : Sieve U) (hR : R ∈ Scheme.smallEtaleTopology Uinf.left U) :
    ∃ (l' : ℕ) (U₁ : (D.obj (Opposite.op l')).left.Etale) (eU₁ : U.left ⟶ U₁.left) (k : ℕ)
      (V : Fin k → Uinf.left.Etale) (f : ∀ i, V i ⟶ U)
      (V₀ : Fin k → (D.obj (Opposite.op l')).left.Etale) (c : ∀ i, V₀ i ⟶ U₁)
      (eV : ∀ i, (V i).left ⟶ (V₀ i).left),
      IsPullback eU₁ U.hom U₁.hom (a l').left ∧ CompactSpace U₁.left ∧
      QuasiSeparatedSpace U₁.left ∧ (∀ i, IsPullback (eV i) (f i).left (c i).left eU₁) ∧
      (∀ i, IsAffine (V₀ i).left) ∧ (∀ i, R.arrows (f i)) ∧
      ∀ x : U.left, ∃ i, x ∈ Set.range (f i).left :=
by
  classical
  obtain ⟨G, p, h, hhet, hpb, hcomp, hlimG, hqcG, haffG, hcUinf⟩ :=
    wc_et_tower_basechange_system S D a ha hlim haff U l U₀ eU hU hcU hqU

  have rebase : ∀ (n m : ℕ), n ≤ m → ∀ (E : Scheme.{u}) (c : E ⟶ G.obj (Opposite.op n)),
      IsAffine E → Etale c → ∃ (E' : Scheme.{u}) (c' : E' ⟶ G.obj (Opposite.op m))
      (r : Limits.pullback (p m) c' ⟶ Limits.pullback (p n) c),
      IsAffine E' ∧ Etale c' ∧ r ≫ Limits.pullback.fst (p n) c = Limits.pullback.fst (p m) c' ∧
      Set.range (Limits.pullback.fst (p m) c') = Set.range (Limits.pullback.fst (p n) c) := by
    intro n m hnm E c hE hc
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hnm
    have hC := hcomp n j
    have hA := haffG n j
    generalize G.map (homOfLE (Nat.le_add_right n j)).op = t at hC hA
    haveI := hA
    haveI := hc
    haveI := hE
    haveI : IsAffineHom (Limits.pullback.fst c t) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback c t).flip
        inferInstance
    have hE' : IsAffine (Limits.pullback c t) := isAffine_of_isAffineHom (Limits.pullback.fst c t)
    have hC' : ∀ x, t (p (n + j) x) = p n x := fun x => by
      rw [← Scheme.Hom.comp_apply, hC]
    have w : Limits.pullback.fst (p (n + j)) (Limits.pullback.snd c t) ≫ p n =
        (Limits.pullback.snd (p (n + j)) (Limits.pullback.snd c t) ≫ Limits.pullback.fst c t) ≫ c := by
      simp only [Category.assoc, ← hC]
      rw [Limits.pullback.condition_assoc, ← Limits.pullback.condition]
    refine ⟨Limits.pullback c t, Limits.pullback.snd c t, Limits.pullback.lift _ _ w, hE',
      inferInstance, Limits.pullback.lift_fst _ _ _, ?_⟩
    apply Set.Subset.antisymm
    · rintro _ ⟨z, rfl⟩
      refine ⟨Limits.pullback.lift _ _ w z, ?_⟩
      rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_fst]
    · rintro _ ⟨z₁, rfl⟩
      have h1 : c (Limits.pullback.snd (p n) c z₁) =
          t (p (n + j) (Limits.pullback.fst (p n) c z₁)) := by
        calc c (Limits.pullback.snd (p n) c z₁)
            = (Limits.pullback.snd (p n) c ≫ c) z₁ := (Scheme.Hom.comp_apply _ _ _).symm
          _ = (Limits.pullback.fst (p n) c ≫ p n) z₁ := by rw [Limits.pullback.condition]
          _ = p n (Limits.pullback.fst (p n) c z₁) := Scheme.Hom.comp_apply _ _ _
          _ = t (p (n + j) (Limits.pullback.fst (p n) c z₁)) := (hC' _).symm
      obtain ⟨v, -, hv2⟩ := Scheme.Pullback.exists_preimage_pullback _ _ h1
      obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := p (n + j))
        (g := Limits.pullback.snd c t) _ _ hv2.symm
      exact ⟨z, hz1⟩

  have hSurj : ∀ y : U.left, ∃ (Y : Uinf.left.Etale) (g : Y ⟶ U) (w : Y.left),
      R.arrows g ∧ g.left w = y := by
    change R ∈ Scheme.smallGrothendieckTopology @Etale Uinf.left U at hR
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Uinf.left
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
    intro y
    obtain ⟨Y, g, w, hg, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale
      Uinf.left MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ U R).mp hR y
    exact ⟨Y, g, w, hg, hw⟩
  choose Wy gy wy hgy hwy using hSurj
  have hdet : ∀ y, Etale (gy y).left := fun y =>
    MorphismProperty.of_postcomp (W' := @Etale) @Etale (gy y).left U.hom U.prop
      (by rw [MorphismProperty.Over.w (gy y)]; exact (Wy y).prop)

  have hdesc := fun y => wc_sch_tower_etale_point_descend G U.left p hcomp hlimG haffG
    (Wy y).left (gy y).left (hdet y) (wy y)
  choose nx Ex cx jjx qx hEaff hcet hjj hjq using hdesc
  let N : U.left → Set U.left := fun y => Set.range (Limits.pullback.fst (p (nx y)) (cx y))
  have hNmem : ∀ y, y ∈ N y := by
    intro y
    refine ⟨qx y, ?_⟩
    rw [← hjj y, Scheme.Hom.comp_apply, hjq y, hwy y]
  have hNopen : ∀ y, IsOpen (N y) := by
    intro y
    haveI := hcet y
    exact (Limits.pullback.fst (p (nx y)) (cx y)).isOpenMap.isOpen_range

  haveI := hcUinf
  obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover N (fun y => (hNopen y).mem_nhds (hNmem y))

  obtain ⟨M, hMle⟩ : ∃ M, ∀ y ∈ t, nx y ≤ M := ⟨t.sup nx, fun y hy => Finset.le_sup hy⟩
  have hreb := fun i : Fin t.card => rebase (nx (t.equivFin.symm i).1) M
    (hMle _ (t.equivFin.symm i).2) (Ex _) (cx _) (hEaff _) (hcet _)
  choose E' c' r hE'aff hc'et hr hrange using hreb
  haveI : Etale U.hom := U.prop
  let Vf : Fin t.card → Uinf.left.Etale := fun i =>
    MorphismProperty.Over.mk ⊤ (Limits.pullback.fst (p M) (c' i) ≫ U.hom)
      (by haveI := hc'et i; infer_instance)
  let ff : ∀ i, Vf i ⟶ U := fun i =>
    MorphismProperty.Over.homMk (Limits.pullback.fst (p M) (c' i)) rfl trivial
  have hRf : ∀ i, R.arrows (ff i) := by
    intro i
    have hm : (r i ≫ jjx (t.equivFin.symm i).1) ≫ (gy (t.equivFin.symm i).1).left =
        Limits.pullback.fst (p M) (c' i) := by
      rw [Category.assoc, hjj, hr]
    let m' : Vf i ⟶ Wy (t.equivFin.symm i).1 :=
      MorphismProperty.Over.homMk (r i ≫ jjx (t.equivFin.symm i).1)
        (by
          show _ = Limits.pullback.fst (p M) (c' i) ≫ U.hom
          rw [← MorphismProperty.Over.w (gy (t.equivFin.symm i).1), ← Category.assoc]
          exact congrArg (fun z => z ≫ U.hom) hm)
        trivial
    have he : ff i = m' ≫ gy (t.equivFin.symm i).1 := by
      apply MorphismProperty.Over.Hom.ext
      exact hm.symm
    rw [he]
    exact R.downward_closed (hgy _) m'
  refine ⟨l + M, MorphismProperty.Over.mk ⊤ (h M) (hhet M), p M, t.card, Vf, ff,
    fun i => MorphismProperty.Over.mk ⊤ (c' i ≫ h M)
      (by haveI := hc'et i; haveI := hhet M; infer_instance),
    fun i => MorphismProperty.Over.homMk (c' i) rfl trivial,
    fun i => Limits.pullback.snd (p M) (c' i),
    hpb M, (hqcG M).1, (hqcG M).2, fun i => (IsPullback.of_hasPullback (p M) (c' i)).flip,
    fun i => hE'aff i, hRf, ?_⟩
  intro x
  have hx : x ∈ ⋃ y ∈ t, N y := by rw [ht]; trivial
  obtain ⟨y, hyt, hxy⟩ := Set.mem_iUnion₂.mp hx
  refine ⟨t.equivFin ⟨y, hyt⟩, ?_⟩
  show x ∈ Set.range (Limits.pullback.fst (p M) (c' (t.equivFin ⟨y, hyt⟩)))
  rw [hrange]
  have key : ∀ z : t, z = ⟨y, hyt⟩ → x ∈ N z.1 := by
    rintro _ rfl
    exact hxy
  exact key _ (Equiv.symm_apply_apply _ _)

theorem wc_et_tower_cech_nerve (S : Scheme.{u}) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left)
    (U : Uinf.left.Etale) (k : ℕ) (V : Fin k → Uinf.left.Etale) (f : ∀ i, V i ⟶ U)
    (l : ℕ) (U₀ : (D.obj (Opposite.op l)).left.Etale)
    (V₀ : Fin k → (D.obj (Opposite.op l)).left.Etale) (c : ∀ i, V₀ i ⟶ U₀)
    (eU : U.left ⟶ U₀.left) (eV : ∀ i, (V i).left ⟶ (V₀ i).left)
    (hU : IsPullback eU U.hom U₀.hom (a l).left)
    (hV : ∀ i, IsPullback (eV i) (f i).left (c i).left eU)
    (hcU : CompactSpace U₀.left) (hqU : QuasiSeparatedSpace U₀.left)
    (hVa : ∀ i, IsAffine (V₀ i).left) :
    ∃ (U' : ∀ j, (D.obj (Opposite.op (l + j))).left.Etale)
      (V' : ∀ j, Fin k → (D.obj (Opposite.op (l + j))).left.Etale)
      (f' : ∀ j i, V' j i ⟶ U' j)
      (π : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j : ℕ),
        (wcWP U V f σ).left ⟶ (wcWP (U' j) (V' j) (f' j) σ).left)
      (e : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j j' : ℕ), j ≤ j' →
        ((wcWP (U' j') (V' j') (f' j') σ).left ⟶ (wcWP (U' j) (V' j) (f' j) σ).left)),
      (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j : ℕ),
        π p σ j ≫ (wcWP (U' j) (V' j) (f' j) σ).hom = (wcWP U V f σ).hom ≫ (a (l + j)).left) ∧
      (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j j' : ℕ) (h : j ≤ j'),
        e p σ j j' h ≫ (wcWP (U' j) (V' j) (f' j) σ).hom =
          (wcWP (U' j') (V' j') (f' j') σ).hom ≫
            (D.map (homOfLE (Nat.add_le_add_left h l)).op).left) ∧
      (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j j' : ℕ) (h : j ≤ j'),
        π p σ j' ≫ e p σ j j' h = π p σ j) ∧
      (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j j' j'' : ℕ) (h₁ : j ≤ j') (h₂ : j' ≤ j''),
        e p σ j' j'' h₂ ≫ e p σ j j' h₁ = e p σ j j'' (h₁.trans h₂)) ∧
      (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (T : Scheme.{u})
        (z : ∀ j, T ⟶ (wcWP (U' j) (V' j) (f' j) σ).left),
        (∀ (j j' : ℕ) (h : j ≤ j'), z j' ≫ e p σ j j' h = z j) →
        ∃! z₀ : T ⟶ (wcWP U V f σ).left, ∀ j, z₀ ≫ π p σ j = z j) ∧
      (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j : ℕ),
        CompactSpace (wcWP (U' j) (V' j) (f' j) σ).left ∧
          QuasiSeparatedSpace (wcWP (U' j) (V' j) (f' j) σ).left) ∧
      (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j j' : ℕ) (h : j ≤ j'),
        IsAffineHom (e p σ j j' h)) ∧
      (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k),
        CompactSpace (wcWP U V f σ).left ∧ QuasiSeparatedSpace (wcWP U V f σ).left) ∧
      (∀ (p : ℕ) (σ : Fin (p + 1) → Fin k),
        IsPullback (π p σ 0) (wcWP U V f σ).hom (wcWP (U' 0) (V' 0) (f' 0) σ).hom
          (a (l + 0)).left) ∧
      (∀ (p : ℕ) (τ : Fin (p + 2) → Fin k) (jj : Fin (p + 2)) (j : ℕ),
        (wcCechFace V f τ jj).left ≫ π p (fun t => τ (jj.succAbove t)) j =
          π (p + 1) τ j ≫ (wcCechFace (V' j) (f' j) τ jj).left) ∧
      (∀ (p : ℕ) (τ : Fin (p + 2) → Fin k) (jj : Fin (p + 2)) (j j' : ℕ) (h : j ≤ j'),
        (wcCechFace (V' j') (f' j') τ jj).left ≫ e p (fun t => τ (jj.succAbove t)) j j' h =
          e (p + 1) τ j j' h ≫ (wcCechFace (V' j) (f' j) τ jj).left) :=
by
  classical
  have WPlift : ∀ (X : Scheme.{u}) (B : X.Etale) (m : ℕ) (P : Fin m → X.Etale) (b : ∀ j, P j ⟶ B)
      (T : Scheme.{u}) (x : T ⟶ B.left) (y : ∀ j, T ⟶ (P j).left), (∀ j, y j ≫ (b j).left = x) →
      ∃! h : T ⟶ (Limits.widePullback B P b).left, h ≫ (Limits.WidePullback.base b).left = x ∧
        ∀ j, h ≫ (Limits.WidePullback.π b j).left = y j := by
    intro X B m P b T x y hy
    have hc := Limits.isLimitOfPreserves (Scheme.Etale.forget X ⋙ Over.forget X)
      (Limits.limit.isLimit (Limits.WidePullbackShape.wideCospan B P b))
    let s := Limits.WidePullbackShape.mkCone
      (F := Limits.WidePullbackShape.wideCospan B P b ⋙ (Scheme.Etale.forget X ⋙ Over.forget X))
      x y (fun j => hy j)
    obtain ⟨h, hh, hu⟩ := hc.existsUnique s
    refine ⟨h, ⟨hh none, fun j => hh (some j)⟩, fun h' hh' => hu h' ?_⟩
    rintro (_ | j)
    · exact hh'.1
    · exact hh'.2 j
  have WPext : ∀ (X : Scheme.{u}) (B : X.Etale) (m : ℕ) (P : Fin m → X.Etale) (b : ∀ j, P j ⟶ B)
      (T : Scheme.{u}) (h h' : T ⟶ (Limits.widePullback B P b).left),
      h ≫ (Limits.WidePullback.base b).left = h' ≫ (Limits.WidePullback.base b).left →
      (∀ j, h ≫ (Limits.WidePullback.π b j).left = h' ≫ (Limits.WidePullback.π b j).left) →
      h = h' := by
    intro X B m P b T h h' hb hp
    have hc := Limits.isLimitOfPreserves (Scheme.Etale.forget X ⋙ Over.forget X)
      (Limits.limit.isLimit (Limits.WidePullbackShape.wideCospan B P b))
    apply hc.hom_ext
    rintro (_ | j)
    · exact hb
    · exact hp j
  have piA : ∀ (X : Scheme.{u}) (B : X.Etale) (m : ℕ) (P : Fin m → X.Etale) (b : ∀ j, P j ⟶ B)
      (j : Fin m), (Limits.WidePullback.π b j).left ≫ (b j).left =
        (Limits.WidePullback.base b).left := by
    intro X B m P b j
    have := (Scheme.Etale.forget X ⋙ Over.forget X).congr_map (Limits.WidePullback.π_arrow b j)
    rwa [Functor.map_comp] at this
  have hL1 : ∀ (X : Scheme.{u}) {A B C' : X.Etale} (a₁ : A ⟶ B) (b₁ : B ⟶ C') (d : A ⟶ C'),
      a₁ ≫ b₁ = d → a₁.left ≫ b₁.left = d.left := by
    intro X A B C' a₁ b₁ d h
    have := (Scheme.Etale.forget X ⋙ Over.forget X).congr_map h
    rw [Functor.map_comp] at this
    exact this
  have hW : ∀ {Y : Scheme.{u}} (B : Y.Etale) (m : ℕ) (P : Fin m → Y.Etale) (b : ∀ t, P t ⟶ B),
      (Limits.widePullback B P b).hom = (Limits.WidePullback.base b).left ≫ B.hom :=
    fun B m P b => (MorphismProperty.Over.w (Limits.WidePullback.base b)).symm
  have WPsq : ∀ (X Y : Scheme.{u}) (A : X.Etale) (m : ℕ) (P : Fin m → X.Etale) (a₁ : ∀ j, P j ⟶ A)
      (B : Y.Etale) (Q : Fin m → Y.Etale) (b : ∀ j, Q j ⟶ B) (φ : A.left ⟶ B.left)
      (ψ : ∀ j, (P j).left ⟶ (Q j).left), (∀ j, IsPullback (ψ j) (a₁ j).left (b j).left φ) →
      ∀ (Φ : (Limits.widePullback A P a₁).left ⟶ (Limits.widePullback B Q b).left),
      Φ ≫ (Limits.WidePullback.base b).left = (Limits.WidePullback.base a₁).left ≫ φ →
      (∀ j, Φ ≫ (Limits.WidePullback.π b j).left = (Limits.WidePullback.π a₁ j).left ≫ ψ j) →
      IsPullback Φ (Limits.WidePullback.base a₁).left (Limits.WidePullback.base b).left φ := by
    intro X Y A m P a₁ B Q b φ ψ hψ Φ hb hp
    have hw : ∀ (s : Limits.PullbackCone (Limits.WidePullback.base b).left φ) (j : Fin m),
        (s.fst ≫ (Limits.WidePullback.π b j).left) ≫ (b j).left = s.snd ≫ φ := by
      intro s j
      rw [Category.assoc, piA Y B m Q b j]
      exact s.condition
    have ex : ∀ s : Limits.PullbackCone (Limits.WidePullback.base b).left φ,
        ∃ h : s.pt ⟶ (Limits.widePullback A P a₁).left,
          h ≫ (Limits.WidePullback.base a₁).left = s.snd ∧
          ∀ j, h ≫ (Limits.WidePullback.π a₁ j).left = (hψ j).lift _ _ (hw s j) := fun s =>
      (WPlift X A m P a₁ s.pt s.snd (fun j => (hψ j).lift _ _ (hw s j))
        (fun j => (hψ j).lift_snd _ _ _)).exists
    choose L hL1' hL2' using ex
    refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk Φ (Limits.WidePullback.base a₁).left hb) ?_
    refine Limits.PullbackCone.IsLimit.mk hb L (fun s => ?_) (fun s => hL1' s) (fun s mm hm1 hm2 => ?_)
    · change L s ≫ Φ = s.fst
      apply WPext Y B m Q b s.pt
      · rw [Category.assoc, hb, ← Category.assoc, hL1' s]
        exact s.condition.symm
      · intro j
        rw [Category.assoc, hp j, ← Category.assoc, hL2' s j]
        exact (hψ j).lift_fst _ _ _
    · change mm ≫ Φ = s.fst at hm1
      change mm ≫ (Limits.WidePullback.base a₁).left = s.snd at hm2
      apply WPext X A m P a₁ s.pt
      · rw [hm2, hL1' s]
      · intro j
        rw [hL2' s j]
        apply (hψ j).hom_ext
        · rw [(hψ j).lift_fst, Category.assoc, ← hp j, ← Category.assoc, hm1]
        · rw [(hψ j).lift_snd, Category.assoc, piA X A m P a₁ j, hm2]
  have baseQ : ∀ (X : Scheme.{u}) (U : X.Etale) (k : ℕ) (V : Fin k → X.Etale) (f : ∀ i, V i ⟶ U),
      (∀ i, QuasiCompact (f i).left) → (∀ i, QuasiSeparated (f i).left) →
      ∀ (n : ℕ) (τ : Fin n → Fin k),
      QuasiCompact (Limits.WidePullback.base (fun l => f (τ l))).left ∧
      QuasiSeparated (Limits.WidePullback.base (fun l => f (τ l))).left := by
    intro X U k V f hqc0 hqs0
    have sq : ∀ (n : ℕ) (Xs : Fin (n + 1) → X.Etale) (g : ∀ i, Xs i ⟶ U),
        IsPullback (Limits.WidePullback.lift (Limits.WidePullback.base g)
          (fun i : Fin n => Limits.WidePullback.π g i.castSucc)
          (fun i => Limits.WidePullback.π_arrow g i.castSucc) :
            Limits.widePullback U Xs g ⟶ Limits.widePullback U (fun i : Fin n => Xs i.castSucc)
              (fun i => g i.castSucc))
          (Limits.WidePullback.π g (Fin.last n))
          (Limits.WidePullback.base (fun i : Fin n => g i.castSucc)) (g (Fin.last n)) := by
      intro n Xs g
      have w : (Limits.WidePullback.lift (Limits.WidePullback.base g)
          (fun i : Fin n => Limits.WidePullback.π g i.castSucc)
          (fun i => Limits.WidePullback.π_arrow g i.castSucc) :
            Limits.widePullback U Xs g ⟶ Limits.widePullback U (fun i : Fin n => Xs i.castSucc)
              (fun i => g i.castSucc)) ≫
          Limits.WidePullback.base (fun i : Fin n => g i.castSucc) =
          Limits.WidePullback.π g (Fin.last n) ≫ g (Fin.last n) := by
        rw [Limits.WidePullback.lift_base, Limits.WidePullback.π_arrow]
      refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk _ _ w) ?_
      refine Limits.PullbackCone.IsLimit.mk w
        (fun s => Limits.WidePullback.lift (s.fst ≫ Limits.WidePullback.base _)
          (Fin.lastCases (motive := fun j => s.pt ⟶ Xs j) s.snd
            (fun i => s.fst ≫ Limits.WidePullback.π (fun i : Fin n => g i.castSucc) i))
          (fun j => by
            induction j using Fin.lastCases with
            | last => rw [Fin.lastCases_last]; exact s.condition.symm
            | cast i =>
              rw [Fin.lastCases_castSucc, Category.assoc, Limits.WidePullback.π_arrow]))
        (fun s => ?_) (fun s => ?_) (fun s m h1 h2 => ?_)
      · apply Limits.WidePullback.hom_ext
        · intro j
          rw [Category.assoc, Limits.WidePullback.lift_π, Limits.WidePullback.lift_π,
            Fin.lastCases_castSucc]
        · rw [Category.assoc, Limits.WidePullback.lift_base, Limits.WidePullback.lift_base]
      · rw [Limits.WidePullback.lift_π, Fin.lastCases_last]
      · apply Limits.WidePullback.hom_ext
        · intro j
