      (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ))

  have h : ∀ k : ℕ, ((ℓ ^ (m + k + 1) : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ)) ≫
      Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ)) = 0 := by
    intro k
    rw [show ℓ ^ (m + k + 1) = ℓ ^ (m + k) * ℓ from pow_succ ℓ (m + k), mul_nsmul,
      Preadditive.nsmul_comp, Limits.cokernel.condition, smul_zero]
  let t : ∀ k : ℕ, wcIntTors (wcXbar F X) ℓ (m + k + 1) ⟶ wcIntTors (wcXbar F X) ℓ (m + k) :=
    fun k => Limits.cokernel.desc _
      (Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ))) (h k)
  have ht : ∀ k : ℕ, Limits.cokernel.π ((ℓ ^ (m + k + 1) : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ)) ≫ t k =
      Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ)) :=
    fun k => Limits.cokernel.π_desc _ _ _

  obtain ⟨hz, hS⟩ := wc_int_unit_tower_shortExact (wcXbar F X) ℓ m t ht

  have hc : ∀ {X₁ X₂ X₃ : SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ)} {n : ℕ}
      (x : Abelian.Ext (wcIntSuppObj Dx) X₁ n) (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃),
      (x.comp (Abelian.Ext.mk₀ f) (add_zero n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
        x.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero n) := by
    intro X₁ X₂ X₃ n x f g
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]
  obtain ⟨hinj, hsurj⟩ := wc_ext_prod_bijective (wcIntSuppObj Dx)
    (∏ᶜ (fun k => wcIntTors (wcXbar F X) ℓ (m + k))) (fun k => wcIntTors (wcXbar F X) ℓ (m + k))
    (Limits.Pi.π (fun k => wcIntTors (wcXbar F X) ℓ (m + k)))
    (Limits.productIsProduct (fun k => wcIntTors (wcXbar F X) ℓ (m + k))) (2 * d)
  obtain ⟨x, hx⟩ := hsurj a
  have hxg : x.comp (Abelian.Ext.mk₀ (Limits.Pi.lift (fun k =>
      Limits.Pi.π (fun j => wcIntTors (wcXbar F X) ℓ (m + j)) k -
        Limits.Pi.π (fun j => wcIntTors (wcXbar F X) ℓ (m + j)) (k + 1) ≫ t k))) (add_zero _) = 0 := by
    apply hinj
    intro k
    rw [hc, Limits.Pi.lift_comp_π, sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg,
      Abelian.Ext.comp_add, Abelian.Ext.comp_neg, ← hc, hx k, hx (k + 1), ha k (t k) (ht k),
      add_neg_cancel]
  obtain ⟨θ, hθ⟩ := Abelian.Ext.covariant_sequence_exact₂ (wcIntSuppObj Dx) hS x hxg
  have hθ' : θ.comp (Abelian.Ext.mk₀ (Limits.Pi.lift (fun k =>
      Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ))))) (add_zero _) = x := hθ
  refine ⟨θ, fun k => ?_⟩
  calc θ.comp (Abelian.Ext.mk₀
        (Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ)))) (add_zero (2 * d))
      = θ.comp (Abelian.Ext.mk₀ (Limits.Pi.lift (fun k =>
          Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ))) ≫
          Limits.Pi.π (fun j => wcIntTors (wcXbar F X) ℓ (m + j)) k)) (add_zero (2 * d)) := by
        rw [Limits.Pi.lift_comp_π]
    _ = (θ.comp (Abelian.Ext.mk₀ (Limits.Pi.lift (fun k =>
          Limits.cokernel.π ((ℓ ^ (m + k) : ℕ) • 𝟙 (wcIntUnit (wcXbar F X) ℓ))))) (add_zero _)).comp
          (Abelian.Ext.mk₀ (Limits.Pi.π (fun j => wcIntTors (wcXbar F X) ℓ (m + j)) k))
          (add_zero _) := (hc _ _ _).symm
    _ = a k := by rw [hθ', hx k]

theorem wc_xbar_int_top_growth (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
    (∃ e : ℕ, ∀ y : Abelian.Ext (wcIntUnit (wcXbar F X) ℓ) (wcIntUnit (wcXbar F X) ℓ) (2 * d),
        (∃ r : ℕ, ℓ ^ r • y = 0) → ℓ ^ e • y = 0) ∧
    (∀ e : ℕ, ∃ m : ℕ, 1 ≤ m ∧
        ∃ b : Abelian.Ext (wcIntUnit (wcXbar F X) ℓ) (wcIntTors (wcXbar F X) ℓ m) (2 * d),
          ℓ ^ e • b ≠ 0) :=
by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _

  have h : WeaklyEtale (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F)
  letI : HasExt (SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ)) := HasExt.standard _

  obtain ⟨hσ, hτ, -, -⟩ := wc_slice_over_sites_cont X.left (wcGeomPoint F X h)
  let εapp : ∀ V : Over (wcGeomPoint F X h),
      (wcOverToSlice X.left (wcGeomPoint F X h) ⋙ wcSliceToOver X.left (wcGeomPoint F X h)).obj V ≅ V :=
    fun V =>
      Over.isoMk (MorphismProperty.Over.isoMk (Iso.refl V.left.left)
          ((Category.id_comp _).trans (MorphismProperty.Over.w V.hom).symm))
        (MorphismProperty.Over.Hom.ext (Category.id_comp V.hom.left))
  let ε : wcOverToSlice X.left (wcGeomPoint F X h) ⋙ wcSliceToOver X.left (wcGeomPoint F X h) ≅
      𝟭 (Over (wcGeomPoint F X h)) :=
    NatIso.ofComponents εapp (fun {V V'} g => by
      apply Over.OverMorphism.ext
      apply MorphismProperty.Over.Hom.ext
      exact (Category.comp_id g.left.left).trans (Category.id_comp g.left.left).symm)
  let eqv : (wcGeomPoint F X h).left.ProEt ≌ Over (wcGeomPoint F X h) :=
    Equivalence.mk' (wcSliceToOver X.left (wcGeomPoint F X h))
      (wcOverToSlice X.left (wcGeomPoint F X h)) (Iso.refl _) ε (fun W => by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact Category.comp_id (𝟙 W.left))
  haveI : eqv.functor.IsContinuous (Scheme.ProEt.topology (wcGeomPoint F X h).left)
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) := hσ
  haveI : eqv.inverse.IsContinuous ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
      (Scheme.ProEt.topology (wcGeomPoint F X h).left) := hτ
  let E : SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ) ≌
      SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ) :=
    SheafOfModules.pushforwardPushforwardEquivalence eqv
      (S := wcIntRingSheaf (wcGeomPoint F X h).left ℓ) (R := wcIntSliceRing F X h ℓ) (𝟙 _) (𝟙 _) rfl rfl
  haveI : E.functor.Additive := Functor.additive_of_preserves_binary_products _
  haveI : E.inverse.Additive := Functor.additive_of_preserves_binary_products _
  let U0 : SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ) := SheafOfModules.unit (wcIntSliceRing F X h ℓ)
  let adj : E.inverse ⊣ E.functor := E.symm.toAdjunction
  let θ : E.inverse.obj (E.functor.obj U0) ≅ U0 := (E.unitIso.app U0).symm

  have transport : ∀ (Q : SheafOfModules.{u+1} (wcIntSliceRing F X h ℓ))
      (Q' : SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ)) (ν : E.functor.obj Q ≅ Q') (n : ℕ),
      Nonempty (Abelian.Ext U0 Q n ≃+ Abelian.Ext (wcIntUnit (wcXbar F X) ℓ) Q' n) := by
    intro Q Q' ν n
    let A0 : Abelian.Ext U0 Q n ≃+ Abelian.Ext (E.inverse.obj (E.functor.obj U0)) Q n :=
      { toFun := fun x => (Abelian.Ext.mk₀ θ.hom).comp x (zero_add n)
        invFun := fun y => (Abelian.Ext.mk₀ θ.inv).comp y (zero_add n)
        left_inv := fun x => by
          simp only
          rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
        right_inv := fun y => by
          simp only
          rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
        map_add' := fun x y => Abelian.Ext.comp_add _ _ _ _ }
    let A1 : Abelian.Ext (E.inverse.obj (E.functor.obj U0)) Q n ≃+
        Abelian.Ext (E.functor.obj U0) (E.functor.obj Q) n := adj.extEquiv
    let A2 : Abelian.Ext (E.functor.obj U0) (E.functor.obj Q) n ≃+
        Abelian.Ext (E.functor.obj U0) Q' n :=
      { toFun := fun β => β.comp (Abelian.Ext.mk₀ ν.hom) (add_zero n)
        invFun := fun γ => γ.comp (Abelian.Ext.mk₀ ν.inv) (add_zero n)
        left_inv := fun β => by
          simp only
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
            Abelian.Ext.comp_mk₀_id]
        right_inv := fun γ => by
          simp only
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
            Abelian.Ext.comp_mk₀_id]
        map_add' := fun β γ => Abelian.Ext.add_comp _ _ _ _ }
    exact ⟨A0.trans (A1.trans A2)⟩

  have hcok : ∀ k : ℕ, Nonempty (E.functor.obj (Limits.cokernel (k • 𝟙 U0)) ≅
      Limits.cokernel (k • 𝟙 (wcIntUnit (wcXbar F X) ℓ))) := by
    intro k
    have hmap : E.functor.map (k • 𝟙 U0) = k • 𝟙 (E.functor.obj U0) := by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    exact ⟨Limits.PreservesCokernel.iso E.functor (k • 𝟙 U0) ≪≫ Limits.cokernelIsoOfEq hmap⟩

  obtain ⟨instM, hfin⟩ := wc_intmodcoh_fg F X d ℓ hℓ h (2 * d)
  letI := instM
  haveI := hfin
  obtain ⟨⟨e, he⟩, hprim⟩ := padic_fg_torsion_primitive ℓ (wcIntModCoh F X h ℓ (2 * d))
  obtain ⟨Ψ⟩ := transport U0 (wcIntUnit (wcXbar F X) ℓ) (Iso.refl _) (2 * d)
  refine ⟨⟨e, fun y hy => ?_⟩, fun e' => ?_⟩
  ·
    obtain ⟨r, hr⟩ := hy
    have h1 : ℓ ^ r • Ψ.symm y = 0 := by rw [← map_nsmul, hr, map_zero]
    have h2 : ℓ ^ e • Ψ.symm y = 0 := he (Ψ.symm y) ⟨r, h1⟩
    rw [← Ψ.apply_symm_apply y, ← map_nsmul, h2, map_zero]
  ·
    obtain ⟨x, hx⟩ := wc_top_coh_nonzero F X d ℓ hℓ h
    obtain ⟨T, -, -⟩ := wc_modcoh_comparison F X h ℓ
    have hx' : T (2 * d) x ≠ 0 := fun h0 =>
      hx ((T (2 * d)).injective (h0.trans (map_zero _).symm))
    obtain ⟨ι, -, hsurj, -⟩ := wc_intmodcoh_rationalization F X h ℓ
    obtain ⟨k, a, ha⟩ := hsurj (2 * d) (T (2 * d) x)
    have hnt : ∀ r : ℕ, ℓ ^ r • a ≠ 0 := by
      intro r hr
      have h1 : ℓ ^ r • ι (2 * d) a = 0 := by rw [← map_nsmul, hr, map_zero]
      have h2 : ι (2 * d) a = 0 := wc_modcoh_ell_torsionfree F X h ℓ (2 * d) r _ h1
      rw [ha] at h2
      exact hx' (wc_modcoh_ell_torsionfree F X h ℓ (2 * d) k _ h2)
    obtain ⟨s, a₀, τ, -, -, hp⟩ := hprim a hnt
    obtain ⟨ν⟩ := hcok (ℓ ^ (e' + 1))
    obtain ⟨Ψm⟩ := transport (wcTorMod F X h ℓ (e' + 1)) (wcIntTors (wcXbar F X) ℓ (e' + 1)) ν (2 * d)
    refine ⟨e' + 1, by omega, Ψm (wcTorRed F X h ℓ (e' + 1) (2 * d) a₀), fun h0 => ?_⟩
    have h1 : wcTorRed F X h ℓ (e' + 1) (2 * d) (ℓ ^ e' • a₀) = 0 := by
      apply Ψm.injective
      rw [map_nsmul, map_nsmul, h0, map_zero]
    obtain ⟨z, hz⟩ := (wc_tormod_les F X h ℓ (e' + 1) (2 * d)).1 _ h1
    exact hp e' z hz

theorem sheafOfModules_restrictScalars_exact_left_adjoint_of_localization : ∀ {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R R' : Sheaf J RingCat.{u+1}) (α : R ⟶ R') (n : ℕ),
    (∀ V : Cᵒᵖ, IsUnit (n : ↑(R'.obj.obj V))) →
    (∀ V : Cᵒᵖ, Function.Injective (α.hom.app V).hom) →
    (∀ (V : C) (t : ↑(R'.obj.obj (Opposite.op V))), ∃ T ∈ J V, ∀ ⦃W : C⦄ (g : W ⟶ V), T.arrows g →
      ∃ (m : ℕ) (a : ↑(R.obj.obj (Opposite.op W))),
        (n : ↑(R'.obj.obj (Opposite.op W))) ^ m * (R'.obj.map g.op).hom t =
          (α.hom.app (Opposite.op W)).hom a) →
    ∃ (L : SheafOfModules.{u+1} R ⥤ SheafOfModules.{u+1} R') (_ : L ⊣ SheafOfModules.restrictScalars.{u+1} α),
      L.Additive ∧ Limits.PreservesFiniteLimits L ∧ Limits.PreservesFiniteColimits L :=
by
  intro C _ J _ _ R R' α n hU hInj hLoc
  classical
  have s1 : ∀ {C : Type (u+1)} [Category.{u} C]
      (J : GrothendieckTopology C)
      (R R' : Sheaf J RingCat.{u+1}) (α : R ⟶ R') (n : ℕ),
      (∀ V : Cᵒᵖ, IsUnit (n : ↑(R'.obj.obj V))) →
      (∀ V : Cᵒᵖ, Function.Injective (α.hom.app V).hom) →
      (∀ (V : C) (t : ↑(R'.obj.obj (Opposite.op V))), ∃ T ∈ J V, ∀ ⦃W : C⦄ (g : W ⟶ V), T.arrows g →
        ∃ (m : ℕ) (a : ↑(R.obj.obj (Opposite.op W))),
          (n : ↑(R'.obj.obj (Opposite.op W))) ^ m * (R'.obj.map g.op).hom t =
            (α.hom.app (Opposite.op W)).hom a) →
      ∃ (R₀ : Cᵒᵖ ⥤ RingCat.{u+1}) (β : R.obj ⟶ R₀) (α₀ : R₀ ⟶ R'.obj),
        β ≫ α₀ = α.hom ∧
        (∀ V : Cᵒᵖ, Function.Injective (α₀.app V).hom) ∧
        Presheaf.IsLocallySurjective J α₀ ∧
        (∀ V : Cᵒᵖ, IsUnit (n : ↑(R₀.obj V))) ∧
        (∀ V : Cᵒᵖ, Function.Injective (β.app V).hom) ∧
        (∀ (V : Cᵒᵖ) (t : ↑(R₀.obj V)), ∃ (m : ℕ) (r : ↑(R.obj.obj V)),
          (n : ↑(R₀.obj V)) ^ m * t = (β.app V).hom r) := by
    intro C _ J R R' α n hU hInj hLoc
    classical
    have hcomm : ∀ (V : Cᵒᵖ) (j : ℕ) (t : ↑(R'.obj.obj V)), (n : ↑(R'.obj.obj V)) ^ j * t = t * (n : ↑(R'.obj.obj V)) ^ j :=
      fun V j t => ((Nat.cast_commute n t).pow_left j).eq
    let Sb : ∀ V : Cᵒᵖ, Subring ↑(R'.obj.obj V) := fun V =>
      { carrier := {t | ∃ (m : ℕ) (a : ↑(R.obj.obj V)), (n : ↑(R'.obj.obj V)) ^ m * t = (α.hom.app V).hom a}
        zero_mem' := ⟨0, 0, by rw [mul_zero, map_zero]⟩
        one_mem' := ⟨0, 1, by rw [pow_zero, mul_one, map_one]⟩
        add_mem' := by
          rintro t t' ⟨m, a, h⟩ ⟨m', a', h'⟩
          refine ⟨m + m', (n : ↑(R.obj.obj V)) ^ m' * a + (n : ↑(R.obj.obj V)) ^ m * a', ?_⟩
          rw [map_add, map_mul, map_mul, map_pow, map_pow, map_natCast, ← h, ← h', mul_add,
            ← mul_assoc, ← mul_assoc, ← pow_add, ← pow_add, add_comm m' m]
        neg_mem' := by
          rintro t ⟨m, a, h⟩
          exact ⟨m, -a, by rw [mul_neg, map_neg, h]⟩
        mul_mem' := by
          rintro t t' ⟨m, a, h⟩ ⟨m', a', h'⟩
          refine ⟨m + m', a * a', ?_⟩
          rw [map_mul, ← h, ← h', pow_add, mul_assoc, ← mul_assoc _ t t', hcomm V m' t, mul_assoc t,
            ← mul_assoc] }
    have hSb : ∀ (V : Cᵒᵖ) (t : ↑(R'.obj.obj V)), t ∈ Sb V ↔
        ∃ (m : ℕ) (a : ↑(R.obj.obj V)), (n : ↑(R'.obj.obj V)) ^ m * t = (α.hom.app V).hom a :=
      fun V t => Iff.rfl
    have hres : ∀ ⦃V W : Cᵒᵖ⦄ (f : V ⟶ W) (t : Sb V), (R'.obj.map f).hom t ∈ Sb W := by
      rintro V W f ⟨t, m, a, h⟩
      refine ⟨m, (R.obj.map f).hom a, ?_⟩
      have := congrArg (R'.obj.map f).hom h
      rw [map_mul, map_pow, map_natCast] at this
      rw [this]
      exact (congrArg (fun φ => φ.hom a) (α.hom.naturality f)).symm
    let R₀ : Cᵒᵖ ⥤ RingCat.{u+1} :=
      { obj := fun V => RingCat.of (Sb V)
        map := fun {V W} f => RingCat.ofHom
          (((R'.obj.map f).hom.comp (Sb V).subtype).codRestrict (Sb W) (fun t => hres f t))
        map_id := fun V => by
          ext t
          change (R'.obj.map (𝟙 V)).hom t.1 = t.1
          simp
        map_comp := fun {V W Z} f g => by
          ext t
          change (R'.obj.map (f ≫ g)).hom t.1 = (R'.obj.map g).hom ((R'.obj.map f).hom t.1)
          simp }
    let β : R.obj ⟶ R₀ :=
      { app := fun V => RingCat.ofHom ((α.hom.app V).hom.codRestrict (Sb V)
          (fun a => ⟨0, a, by rw [pow_zero, one_mul]⟩))
        naturality := fun V W f => by
          ext a
          change (α.hom.app W).hom ((R.obj.map f).hom a) = (R'.obj.map f).hom ((α.hom.app V).hom a)
          exact congrArg (fun φ => φ.hom a) (α.hom.naturality f) }
    let α₀ : R₀ ⟶ R'.obj :=
      { app := fun V => RingCat.ofHom (Sb V).subtype
        naturality := fun V W f => by
          ext t
          rfl }
    have hβapp : ∀ (V : Cᵒᵖ) (a : ↑(R.obj.obj V)), ((β.app V).hom a : ↑(R'.obj.obj V)) = (α.hom.app V).hom a :=
      fun V a => rfl
    refine ⟨R₀, β, α₀, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · ext V a
      rfl
    · intro V t t' h
      exact Subtype.ext h
    · constructor
      intro V s
      obtain ⟨T, hT, hTs⟩ := hLoc V s
      refine J.superset_covering ?_ hT
      intro W g hg
      obtain ⟨m, a, h⟩ := hTs g hg
      exact ⟨⟨(R'.obj.map g.op).hom s, m, a, h⟩, rfl⟩
    · intro V
      have hu := hU V
      refine isUnit_iff_exists.mpr ⟨⟨(hu.unit⁻¹ : (↑(R'.obj.obj V))ˣ), 1, 1, ?_⟩, ?_, ?_⟩
      · rw [pow_one, map_one]
        exact hu.mul_val_inv
      · apply Subtype.ext
        change ((n : Sb V) : ↑(R'.obj.obj V)) * _ = 1
        rw [Subring.coe_natCast]
        exact hu.mul_val_inv
      · apply Subtype.ext
        change _ * ((n : Sb V) : ↑(R'.obj.obj V)) = 1
        rw [Subring.coe_natCast]
        exact hu.val_inv_mul
    · intro V a a' h
      apply hInj V
      have := congrArg Subtype.val h
      exact this
    · rintro V ⟨t, m, a, h⟩
      refine ⟨m, a, ?_⟩
      apply Subtype.ext
      change ((n : Sb V) : ↑(R'.obj.obj V)) ^ m * t = _
      rw [Subring.coe_natCast]
      exact h
  have s2 : ∀ (A B X : Type (u+1)) [Ring A] [Ring B] [AddCommGroup X] [Module A X] (β : A →+* B) (n : ℕ),
      Function.Injective β →
      (∀ b : B, ∃ (m : ℕ) (a : A), (n : B) ^ m * b = β a) →
      ∃ ρ : B →+* AddMonoid.End (LocalizedModule (Submonoid.powers (n : ℤ)) X),
        ∀ (b : B) (m : ℕ) (a : A) (x : X) (k : ℕ), (n : B) ^ m * b = β a →
          ρ b (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k)) =
            LocalizedModule.mk (a • x) (Submonoid.pow (n : ℤ) (m + k)) := by
    intro A B X _ _ _ _ β n hβ hden
    classical
    set S := Submonoid.powers (n : ℤ) with hS

    have hzs : ∀ (j : ℕ) (x : X), (Submonoid.pow (n : ℤ) j : S) • x = ((n : A) ^ j) • x := by
      intro j x
      rw [Submonoid.smul_def, Submonoid.pow_apply, ← Int.cast_smul_eq_zsmul A]
      push_cast
      rfl
    have hpw : ∀ i j : ℕ, (Submonoid.pow (n : ℤ) i : S) * Submonoid.pow (n : ℤ) j =
        Submonoid.pow (n : ℤ) (i + j) := by
      intro i j
      apply Subtype.ext
      simp [Submonoid.pow_apply, pow_add]
    have hgen : ∀ y : LocalizedModule S X, ∃ (x : X) (k : ℕ), y = LocalizedModule.mk x (Submonoid.pow (n : ℤ) k) := by
      intro y
      induction y using LocalizedModule.induction_on with
      | h x s =>
        obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp s.2
        refine ⟨x, k, ?_⟩
        congr 1
        apply Subtype.ext
        rw [Submonoid.pow_apply]
        exact hk.symm
    have hcomm : ∀ (j : ℕ) (b : B), (n : B) ^ j * b = b * (n : B) ^ j :=
      fun j b => ((Nat.cast_commute n b).pow_left j).eq
    have hcommA : ∀ (j : ℕ) (a : A), (n : A) ^ j * a = a * (n : A) ^ j :=
      fun j a => ((Nat.cast_commute n a).pow_left j).eq

    have hI : ∀ (b : B) (m m' : ℕ) (a a' : A), (n : B) ^ m * b = β a → (n : B) ^ m' * b = β a' →
        (n : A) ^ m' * a = (n : A) ^ m * a' := by
      intro b m m' a a' h h'
      apply hβ
      rw [map_mul, map_mul, map_pow, map_pow, map_natCast, ← h, ← h', ← mul_assoc,
        ← mul_assoc, ← pow_add, ← pow_add, add_comm m' m]

    have hW : ∀ (b : B) (m m' : ℕ) (a a' : A) (x : X) (k : ℕ), (n : B) ^ m * b = β a →
        (n : B) ^ m' * b = β a' →
        (LocalizedModule.mk (a • x) (Submonoid.pow (n : ℤ) (m + k)) : LocalizedModule S X) =
          LocalizedModule.mk (a' • x) (Submonoid.pow (n : ℤ) (m' + k)) := by
      intro b m m' a a' x k h h'
      rw [LocalizedModule.mk_eq]
      refine ⟨1, ?_⟩
      rw [one_smul, one_smul, hzs, hzs, ← mul_smul, ← mul_smul, pow_add, pow_add, mul_assoc, mul_assoc,
        hcommA k a, hcommA k a', ← mul_assoc, ← mul_assoc, hI b m m' a a' h h']
    choose mb ab hab using hden
    let ρ₀ : B → AddMonoid.End (LocalizedModule S X) := fun b =>
      ((Localization.mk (1 : ℤ) (Submonoid.pow (n : ℤ) (mb b)) : Localization S) •
        LocalizedModule.map S (DistribSMul.toAddMonoidHom X (ab b)).toIntLinearMap).toAddMonoidHom
    have hF : ∀ (b : B) (m : ℕ) (a : A) (x : X) (k : ℕ), (n : B) ^ m * b = β a →
        ρ₀ b (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k)) =
          LocalizedModule.mk (a • x) (Submonoid.pow (n : ℤ) (m + k)) := by
      intro b m a x k h
      have e1 : ρ₀ b (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k)) =
          LocalizedModule.mk (ab b • x) (Submonoid.pow (n : ℤ) (mb b + k)) := by
        change (Localization.mk (1 : ℤ) (Submonoid.pow (n : ℤ) (mb b)) : Localization S) •
          LocalizedModule.map S (DistribSMul.toAddMonoidHom X (ab b)).toIntLinearMap
            (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k)) = _
        rw [LocalizedModule.map_mk, LocalizedModule.mk_smul_mk, one_smul, hpw]
        rfl
      rw [e1]
      exact hW b (mb b) m (ab b) a x k (hab b) h
    have hext : ∀ f g : AddMonoid.End (LocalizedModule S X),
        (∀ (x : X) (k : ℕ), f (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k)) =
          g (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k))) → f = g := by
      intro f g h
      apply AddMonoidHom.ext
      intro y
      obtain ⟨x, k, rfl⟩ := hgen y
      exact h x k
    let ρ : B →+* AddMonoid.End (LocalizedModule S X) :=
      { toFun := ρ₀
        map_one' := by
          apply hext
          intro x k
          rw [hF 1 0 1 x k (by rw [pow_zero, mul_one, map_one]), one_smul, zero_add]
          rfl
        map_mul' := fun b b' => by
          apply hext
          intro x k
          have h2 : (n : B) ^ (mb b + mb b') * (b * b') = β (ab b * ab b') := by
            rw [map_mul, ← hab b, ← hab b', pow_add, mul_assoc, ← mul_assoc ((n : B) ^ mb b') b b',
              hcomm (mb b') b, mul_assoc b, ← mul_assoc]
          rw [hF _ _ _ x k h2]
          change _ = ρ₀ b (ρ₀ b' (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k)))
          rw [hF b' _ _ x k (hab b'), hF b _ _ _ _ (hab b), mul_smul, add_assoc]
        map_zero' := by
          apply hext
          intro x k
          rw [hF 0 0 0 x k (by rw [mul_zero, map_zero]), zero_smul, LocalizedModule.zero_mk]
          rfl
        map_add' := fun b b' => by
          apply hext
          intro x k
          have h2 : (n : B) ^ (mb b + mb b') * (b + b') =
              β ((n : A) ^ mb b' * ab b + (n : A) ^ mb b * ab b') := by
            rw [map_add, map_mul, map_mul, map_pow, map_pow, map_natCast, ← hab b, ← hab b', mul_add,
              ← mul_assoc, ← mul_assoc, ← pow_add, ← pow_add, add_comm (mb b') (mb b)]
          rw [hF _ _ _ x k h2]
          change _ = ρ₀ b (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k)) +
            ρ₀ b' (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k))
          rw [hF b _ _ x k (hab b), hF b' _ _ x k (hab b'), LocalizedModule.mk_add_mk,
            LocalizedModule.mk_eq]
          refine ⟨1, ?_⟩
          rw [one_smul, one_smul, hpw, hzs, hzs, smul_add, hzs, hzs]
          simp only [smul_add, ← mul_smul, add_smul, mul_add, ← mul_assoc, ← pow_add]
          congr 4 <;> omega }
    exact ⟨ρ, hF⟩
  have s3 : ∀ {C : Type (u+1)} [Category.{u} C]
      (R R₀ : Cᵒᵖ ⥤ RingCat.{u+1}) (β : R ⟶ R₀) (n : ℕ),
      (∀ V : Cᵒᵖ, IsUnit (n : ↑(R₀.obj V))) →
      (∀ (V : Cᵒᵖ) (t : ↑(R₀.obj V)), ∃ (m : ℕ) (r : ↑(R.obj V)),
        (n : ↑(R₀.obj V)) ^ m * t = (β.app V).hom r) →
      ∀ (M : PresheafOfModules.{u+1} R)
      (ρ : ∀ V : Cᵒᵖ, ↑(R₀.obj V) →+* AddMonoid.End (LocalizedModule (Submonoid.powers (n : ℤ)) ↑(M.obj V))),
      (∀ (V : Cᵒᵖ) (b : ↑(R₀.obj V)) (m : ℕ) (a : ↑(R.obj V)) (x : ↑(M.obj V)) (k : ℕ),
        (n : ↑(R₀.obj V)) ^ m * b = (β.app V).hom a →
          ρ V b (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k)) =
            LocalizedModule.mk (a • x) (Submonoid.pow (n : ℤ) (m + k))) →
      ∃ (N : PresheafOfModules.{u+1} R₀) (η : M ⟶ (PresheafOfModules.restrictScalars.{u+1} β).obj N),
        (∀ (V : Cᵒᵖ) (y : ↑(N.obj V)), ∃ (k : ℕ) (x : ↑(M.obj V)),
          (n : ↑(R₀.obj V)) ^ k • y = (η.app V).hom x) ∧
        (∀ (V : Cᵒᵖ) (x : ↑(M.obj V)), (η.app V).hom x = 0 → ∃ k : ℕ, (n : ↑(R.obj V)) ^ k • x = 0) ∧
        ∀ N' : PresheafOfModules.{u+1} R₀,
          Function.Bijective (fun ψ : N ⟶ N' => η ≫ (PresheafOfModules.restrictScalars.{u+1} β).map ψ) := by
    intro C _ R R₀ β n hu hden M ρ hρf
    classical
    have hgen : ∀ (X : Type (u+1)) [AddCommGroup X] (y : LocalizedModule (Submonoid.powers (n : ℤ)) X),
        ∃ (x : X) (k : ℕ), y = LocalizedModule.mk x (Submonoid.pow (n : ℤ) k) := by
      intro X _ y
      induction y using LocalizedModule.induction_on with
      | h x s =>
        obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp s.2
        refine ⟨x, k, ?_⟩
        congr 1
        apply Subtype.ext
        rw [Submonoid.pow_apply]
        exact hk.symm
    have hzsM : ∀ (V : Cᵒᵖ) (j : ℕ) (x : ↑(M.obj V)),
        (Submonoid.pow (n : ℤ) j : Submonoid.powers (n : ℤ)) • x = ((n : ↑(R.obj V)) ^ j) • x := by
      intro V j x
      rw [Submonoid.smul_def, Submonoid.pow_apply, ← Int.cast_smul_eq_zsmul ↑(R.obj V)]
      push_cast
      rfl
    let mf : ∀ ⦃V W : Cᵒᵖ⦄ (_ : V ⟶ W), ↑(M.obj V) →+ ↑(M.obj W) := fun V W f =>
      { toFun := fun x => (M.map f).hom x
        map_zero' := map_zero _
        map_add' := map_add _ }
    have mf_apply : ∀ ⦃V W : Cᵒᵖ⦄ (f : V ⟶ W) (x : ↑(M.obj V)), mf f x = (M.map f).hom x :=
      fun V W f x => rfl
    have hid : ∀ (V : Cᵒᵖ) (x : ↑(M.obj V)), mf (𝟙 V) x = x := by
      intro V x; rw [mf_apply]; simp
    have hcomp : ∀ (V W Z : Cᵒᵖ) (f : V ⟶ W) (g : W ⟶ Z) (x : ↑(M.obj V)),
        mf (f ≫ g) x = mf g (mf f x) := by
      intro V W Z f g x; rw [mf_apply, mf_apply, mf_apply]; simp; rfl
    have mf_smul : ∀ ⦃V W : Cᵒᵖ⦄ (f : V ⟶ W) (a : ↑(R.obj V)) (x : ↑(M.obj V)),
        mf f (a • x) = (R.map f).hom a • mf f x := fun V W f a x => PresheafOfModules.map_smul M f a x
    let μ : ∀ ⦃V W : Cᵒᵖ⦄ (_ : V ⟶ W), LocalizedModule (Submonoid.powers (n : ℤ)) ↑(M.obj V) →+ LocalizedModule (Submonoid.powers (n : ℤ)) ↑(M.obj W) :=
      fun V W f => (LocalizedModule.map (Submonoid.powers (n : ℤ)) (mf f).toIntLinearMap).toAddMonoidHom
    have μ_mk : ∀ ⦃V W : Cᵒᵖ⦄ (f : V ⟶ W) (x : ↑(M.obj V)) (s : Submonoid.powers (n : ℤ)),
        μ f (LocalizedModule.mk x s) = LocalizedModule.mk (mf f x) s :=
      fun V W f x s => LocalizedModule.map_mk _ _ _ _
    let P' : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      { obj := fun V => AddCommGrpCat.of (LocalizedModule (Submonoid.powers (n : ℤ)) ↑(M.obj V))
        map := fun {V W} f => AddCommGrpCat.ofHom (μ f)
        map_id := fun V => by
          ext y
          change μ (𝟙 V) y = y
          induction y using LocalizedModule.induction_on with
          | h x s => rw [μ_mk, hid]
        map_comp := fun {V W Z} f g => by
          ext y
          change μ (f ≫ g) y = μ g (μ f y)
          induction y using LocalizedModule.induction_on with
          | h x s => rw [μ_mk, μ_mk, μ_mk, hcomp] }
    letI inst : ∀ V, Module ↑(R₀.obj V) ↑(P'.obj V) := fun V =>
      Module.compHom (LocalizedModule (Submonoid.powers (n : ℤ)) ↑(M.obj V)) (ρ V)
    have hsmul : ∀ ⦃V W : Cᵒᵖ⦄ (f : V ⟶ W) (b : ↑(R₀.obj V)) (y : ↑(P'.obj V)),
        (P'.map f).hom (b • y) = (R₀.map f).hom b • (P'.map f).hom y := by
      intro V W f b y
      obtain ⟨x, k, rfl⟩ := hgen _ y
      obtain ⟨m, a, h⟩ := hden V b
      have h' : (n : ↑(R₀.obj W)) ^ m * (R₀.map f).hom b = (β.app W).hom ((R.map f).hom a) := by
        rw [← map_natCast (R₀.map f).hom n, ← map_pow, ← map_mul, h]
        exact (congrArg (fun φ => φ.hom a) (β.naturality f)).symm
      change μ f (ρ V b (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k))) =
        ρ W ((R₀.map f).hom b) (μ f (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k)))
      rw [hρf V b m a x k h, μ_mk, μ_mk, hρf W _ m ((R.map f).hom a) _ k h']
      rw [mf_smul]
    let N : PresheafOfModules.{u+1} R₀ := PresheafOfModules.ofPresheaf P' hsmul
    have hp0 : (1 : Submonoid.powers (n : ℤ)) = Submonoid.pow (n : ℤ) 0 := by
      apply Subtype.ext
      rw [Submonoid.pow_apply]
      simp
    let ηφ : M.presheaf ⟶ ((PresheafOfModules.restrictScalars.{u+1} β).obj N).presheaf :=
      { app := fun V => AddCommGrpCat.ofHom
          (LocalizedModule.mkLinearMap (Submonoid.powers (n : ℤ)) ↑(M.obj V)).toAddMonoidHom
        naturality := fun V W f => by
          ext x
          exact (μ_mk f x 1).symm }
    let η : M ⟶ (PresheafOfModules.restrictScalars.{u+1} β).obj N :=
      PresheafOfModules.homMk ηφ (fun V r x => by
        change LocalizedModule.mk (r • x) 1 = ρ V ((β.app V).hom r) (LocalizedModule.mk x 1)
        rw [hp0, hρf V _ 0 r x 0 (by rw [pow_zero, one_mul])])
    have hP1' : ∀ (V : Cᵒᵖ) (x : ↑(M.obj V)) (k : ℕ),
        ((n : ↑(R₀.obj V)) ^ k • (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k) : ↑(N.obj V))) =
          (LocalizedModule.mk x 1 : ↑(N.obj V)) := by
      intro V x k
      change ρ V ((n : ↑(R₀.obj V)) ^ k) (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k)) =
        (LocalizedModule.mk x 1 : LocalizedModule (Submonoid.powers (n : ℤ)) ↑(M.obj V))
      rw [hρf V _ 0 ((n : ↑(R.obj V)) ^ k) x k (by rw [pow_zero, one_mul, map_pow, map_natCast]),
        zero_add, ← hzsM, LocalizedModule.mk_cancel]
    have hcommR : ∀ (V : Cᵒᵖ) (j : ℕ) (b : ↑(R₀.obj V)), (n : ↑(R₀.obj V)) ^ j * b = b * (n : ↑(R₀.obj V)) ^ j :=
      fun V j b => ((Nat.cast_commute n b).pow_left j).eq
    have hP1 : ∀ (V : Cᵒᵖ) (y : ↑(N.obj V)), ∃ (k : ℕ) (x : ↑(M.obj V)),
        (n : ↑(R₀.obj V)) ^ k • y = (η.app V).hom x := by
      intro V y
      obtain ⟨x, k, rfl⟩ := hgen (M.obj V) y
      exact ⟨k, x, hP1' V x k⟩
    refine ⟨N, η, hP1, ?_, ?_⟩
    · intro V x h0
      have h : (LocalizedModule.mk x 1 : LocalizedModule (Submonoid.powers (n : ℤ)) ↑(M.obj V)) =
          LocalizedModule.mk 0 1 := by rw [LocalizedModule.zero_mk]; exact h0
      rw [LocalizedModule.mk_eq] at h
      obtain ⟨u', hu'⟩ := h
      obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp u'.2
      refine ⟨k, ?_⟩
      have e : u' = Submonoid.pow (n : ℤ) k := by
        apply Subtype.ext
        rw [Submonoid.pow_apply]
        exact hk.symm
      rw [one_smul, one_smul, smul_zero, e, hzsM] at hu'
      exact hu'
    · intro N'
      have hcancel : ∀ (V : Cᵒᵖ) (k : ℕ) (z z' : ↑(N'.obj V)),
          (n : ↑(R₀.obj V)) ^ k • z = (n : ↑(R₀.obj V)) ^ k • z' → z = z' :=
        fun V k z z' h => ((hu V).pow k).smul_left_cancel.mp h
      constructor
      · intro ψ ψ' h
        apply PresheafOfModules.hom_ext
        intro V
        ext y
        obtain ⟨k, x, hk⟩ := hP1 V y
        apply hcancel V k
        rw [← map_smul, ← map_smul, hk]
        exact congrArg (fun φ => (φ.app V).hom x) h
      · intro g
        let gA : ∀ V : Cᵒᵖ, ↑(M.obj V) →+ ↑(N'.obj V) := fun V =>
          { toFun := fun x => (g.app V).hom x
            map_zero' := map_zero _
            map_add' := map_add _ }
        have he : ∀ (V : Cᵒᵖ) (k : ℕ) (z : ↑(N'.obj V)),
            algebraMap ℤ (Module.End ℤ ↑(N'.obj V))
              ((Submonoid.pow (n : ℤ) k : Submonoid.powers (n : ℤ)) : ℤ) z = (n : ↑(R₀.obj V)) ^ k • z := by
          intro V k z
          rw [Module.algebraMap_end_apply, Submonoid.pow_apply, ← Int.cast_smul_eq_zsmul ↑(R₀.obj V)]
          push_cast
          rfl
        have hunit : ∀ (V : Cᵒᵖ) (s : Submonoid.powers (n : ℤ)),
            IsUnit (algebraMap ℤ (Module.End ℤ ↑(N'.obj V)) (s : ℤ)) := by
          intro V s
          obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp s.2
          have e : s = Submonoid.pow (n : ℤ) k := by
            apply Subtype.ext
            rw [Submonoid.pow_apply]
            exact hk.symm
          subst e
          rw [Module.End.isUnit_iff]
          refine ⟨fun z z' h => ?_, fun z => ?_⟩
          · rw [he, he] at h
            exact hcancel V k z z' h
          · refine ⟨(((hu V).pow k).unit⁻¹ : (↑(R₀.obj V))ˣ) • z, ?_⟩
            rw [he, Units.smul_def, ← mul_smul, ((hu V).pow k).mul_val_inv, one_smul]
        let ψl : ∀ V : Cᵒᵖ, LocalizedModule (Submonoid.powers (n : ℤ)) ↑(M.obj V) →ₗ[ℤ] ↑(N'.obj V) :=
          fun V => LocalizedModule.lift (Submonoid.powers (n : ℤ)) (gA V).toIntLinearMap (hunit V)
        have hψ : ∀ (V : Cᵒᵖ) (x : ↑(M.obj V)) (k : ℕ),
            (n : ↑(R₀.obj V)) ^ k • ψl V (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k)) = gA V x := by
          intro V x k
          rw [← he]
          change _ = (1 : Module.End ℤ ↑(N'.obj V)) (gA V x)
          rw [← (hunit V (Submonoid.pow (n : ℤ) k)).mul_val_inv, Module.End.mul_apply]
          congr 1
        have hlin : ∀ (V : Cᵒᵖ) (b : ↑(R₀.obj V)) (y : ↑(N.obj V)),
            ψl V (b • y) = b • ψl V y := by
          intro V b y
          obtain ⟨x, k, rfl⟩ := hgen (M.obj V) y
          obtain ⟨m, a, h⟩ := hden V b
          change ψl V (ρ V b (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k))) = _
          rw [hρf V b m a x k h]
          apply hcancel V (m + k)
          rw [hψ, ← mul_smul, pow_add, mul_assoc, hcommR V k b, ← mul_assoc, mul_smul, hψ, h]
          exact (g.app V).hom.map_smul a x
        have hnat : ∀ ⦃V W : Cᵒᵖ⦄ (f : V ⟶ W) (y : ↑(N.obj V)),
            (N'.map f).hom (ψl V y) = ψl W (μ f y) := by
          intro V W f y
          obtain ⟨x, k, rfl⟩ := hgen (M.obj V) y
          rw [μ_mk]
          apply hcancel W k
          rw [hψ W]
          have e3 : (N'.map f).hom (gA V x) = gA W (mf f x) :=
            (PresheafOfModules.naturality_apply g f x).symm
          refine Eq.trans ?_ e3
          calc (n : ↑(R₀.obj W)) ^ k • (N'.map f).hom (ψl V (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k)))
              = (R₀.map f).hom ((n : ↑(R₀.obj V)) ^ k) •
                  (N'.map f).hom (ψl V (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k))) := by
                rw [map_pow, map_natCast]
            _ = (N'.map f).hom ((n : ↑(R₀.obj V)) ^ k •
                  ψl V (LocalizedModule.mk x (Submonoid.pow (n : ℤ) k))) :=
                (PresheafOfModules.map_smul N' f _ _).symm
            _ = (N'.map f).hom (gA V x) := by rw [hψ]
        let φ : N.presheaf ⟶ N'.presheaf :=
          { app := fun V => AddCommGrpCat.ofHom (ψl V).toAddMonoidHom
            naturality := fun V W f => by
              ext y
              exact (hnat f y).symm }
        let ψ : N ⟶ N' := PresheafOfModules.homMk φ (fun V b y => hlin V b y)
        refine ⟨ψ, ?_⟩
        ext V x
        change ψl V (LocalizedModule.mk x 1) = (g.app V).hom x
        rw [hp0]
        have := hψ V x 0
        rw [pow_zero, one_smul] at this
        exact this
  obtain ⟨R₀, β, α₀, hcomp, hα₀inj, hα₀surj, hu, hβinj, hden⟩ := s1 J R R' α n hU hInj hLoc
  haveI : Presheaf.IsLocallyInjective J α₀ := Presheaf.isLocallyInjective_of_injective J α₀ hα₀inj
  haveI : Presheaf.IsLocallySurjective J α₀ := hα₀surj
  have hM : ∀ M : PresheafOfModules.{u+1} R.obj,
      ∃ (N : PresheafOfModules.{u+1} R₀) (η : M ⟶ (PresheafOfModules.restrictScalars.{u+1} β).obj N),
        (∀ (V : Cᵒᵖ) (y : ↑(N.obj V)), ∃ (k : ℕ) (x : ↑(M.obj V)),
          (n : ↑(R₀.obj V)) ^ k • y = (η.app V).hom x) ∧
        (∀ (V : Cᵒᵖ) (x : ↑(M.obj V)), (η.app V).hom x = 0 → ∃ k : ℕ, (n : ↑(R.obj.obj V)) ^ k • x = 0) ∧
        ∀ N' : PresheafOfModules.{u+1} R₀,
          Function.Bijective (fun ψ : N ⟶ N' => η ≫ (PresheafOfModules.restrictScalars.{u+1} β).map ψ) := by
    intro M
    have hρ := fun V => s2 ↑(R.obj.obj V) ↑(R₀.obj V) ↑(M.obj V) (β.app V).hom n (hβinj V) (hden V)
    choose ρ hρf using hρ
    exact s3 R.obj R₀ β n hu hden M ρ hρf
  choose No ηo hP1 hP2 hbij using hM
  let G := PresheafOfModules.restrictScalars.{u+1} β
  let eqv : ∀ (M : PresheafOfModules.{u+1} R.obj) (N' : PresheafOfModules.{u+1} R₀),
      (No M ⟶ N') ≃ (M ⟶ G.obj N') := fun M N' => Equiv.ofBijective _ (hbij M N')
  have he : ∀ (M : PresheafOfModules.{u+1} R.obj) (N' N'' : PresheafOfModules.{u+1} R₀)
      (g : N' ⟶ N'') (h : No M ⟶ N'), eqv M N'' (h ≫ g) = eqv M N' h ≫ G.map g := by
    intro M N' N'' g h
    show ηo M ≫ G.map (h ≫ g) = (ηo M ≫ G.map h) ≫ G.map g
    rw [G.map_comp, Category.assoc]
  let T := Adjunction.leftAdjointOfEquiv eqv he
  let adjT : T ⊣ G := Adjunction.adjunctionOfEquivLeft eqv he
  haveI hmono : T.PreservesMonomorphisms := by
    constructor
    intro M M' ι hι
    have h1 : eqv M' (No M') (𝟙 (No M')) = ηo M' := by
      show ηo M' ≫ G.map (𝟙 _) = ηo M'
      rw [G.map_id, Category.comp_id]
    have hF : ηo M ≫ G.map (T.map ι) = ι ≫ ηo M' := by
      have h2 : T.map ι = (eqv M (No M')).symm (ι ≫ eqv M' (No M') (𝟙 (No M'))) :=
        Adjunction.leftAdjointOfEquiv_map eqv he ι
      rw [h1] at h2
      have h3 := (eqv M (No M')).apply_symm_apply (ι ≫ ηo M')
      rw [← h2] at h3
      exact h3
    apply PresheafOfModules.mono_of_injective
    intro V
    have hj : Function.Injective (ι.app V).hom := by
      have : Mono ((PresheafOfModules.evaluation.{u+1} R.obj V).map ι) :=
        Functor.map_mono (PresheafOfModules.evaluation.{u+1} R.obj V) ι
      exact (ModuleCat.mono_iff_injective _).mp this
    have hFV : ∀ x, ((T.map ι).app V).hom ((ηo M).app V |>.hom x) = ((ηo M').app V).hom ((ι.app V).hom x) :=
      fun x => congrArg (fun φ => (φ.app V).hom x) hF
    rw [injective_iff_map_eq_zero]
    intro y hy
    obtain ⟨k, x, hk⟩ := hP1 M V y
    have h0 : ((ηo M').app V).hom ((ι.app V).hom x) = 0 := by
      rw [← hFV, ← hk, map_smul, hy, smul_zero]
      rfl
    obtain ⟨j, hj0⟩ := hP2 M' V _ h0
    have hx : (n : ↑(R.obj.obj V)) ^ j • x = 0 := by
      apply hj
      rw [map_smul, hj0, map_zero]
    have e : (n : ↑(R₀.obj V)) ^ (j + k) • y = 0 := by
      rw [pow_add, mul_smul, hk]
      have := ((ηo M).app V).hom.map_smul ((n : ↑(R.obj.obj V)) ^ j) x
      rw [hx, map_zero] at this
      have e2 : (β.app V).hom ((n : ↑(R.obj.obj V)) ^ j) = (n : ↑(R₀.obj V)) ^ j := by
        rw [map_pow, map_natCast]
      rw [← e2]
      exact this.symm
    have := ((hu V).pow (j + k)).smul_left_cancel (x := y) (y := 0)
    rw [smul_zero] at this
    exact this.mp e
  haveI : T.Additive := adjT.left_adjoint_additive
  letI := adjT.leftAdjoint_preservesColimits.{0, 0}
  letI : T.PreservesHomology := Functor.preservesHomology_of_preservesMonos_and_cokernels T
  haveI : Limits.PreservesFiniteLimits T := Functor.preservesFiniteLimits_of_preservesHomology T
  let adj := Adjunction.restrictFullyFaithful (iC := SheafOfModules.forget.{u+1} R)
    (iD := 𝟭 (SheafOfModules.{u+1} R'))
    (L := SheafOfModules.forget.{u+1} R ⋙ T ⋙ PresheafOfModules.sheafification.{u+1} α₀)
    (R := SheafOfModules.restrictScalars.{u+1} α)
    (adjT.comp (PresheafOfModules.sheafificationAdjunction.{u+1} α₀))
    (SheafOfModules.fullyFaithfulForget R) (Functor.FullyFaithful.id _)
    (Iso.refl _)
    (Functor.isoWhiskerLeft (SheafOfModules.forget.{u+1} R')
      (eqToIso (congrArg (fun γ => PresheafOfModules.restrictScalars.{u+1} γ) hcomp)))
  letI := adj.leftAdjoint_preservesColimits.{0, 0}
  exact ⟨_, adj, adj.left_adjoint_additive, inferInstance,
    Limits.PreservesColimitsOfSize.preservesFiniteColimits _⟩

theorem wc_int_rat_ring_localization_data (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ V : (S.ProEt)ᵒᵖ, IsUnit (ℓ : ↑((wcRingSheaf S ℓ).obj.obj V))) ∧
    (∀ V : (S.ProEt)ᵒᵖ, Function.Injective ((wcIntRatRingSheafMap S ℓ).hom.app V).hom) ∧
    (∀ (V : S.ProEt) (t : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op V))),
      ∃ T ∈ Scheme.ProEt.topology S V, ∀ ⦃W : S.ProEt⦄ (g : W ⟶ V), T.arrows g →
      ∃ (m : ℕ) (a : ↑((wcIntRingSheaf S ℓ).obj.obj (Opposite.op W))),
        (ℓ : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op W))) ^ m * ((wcRingSheaf S ℓ).obj.map g.op).hom t =
          ((wcIntRatRingSheafMap S ℓ).hom.app (Opposite.op W)).hom a) :=
by
  classical
  have hq : (ℓ : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero

  have unitY : ∀ (Y : Scheme.{u}), IsUnit (ℓ : ↑((wcRingPresheaf.{u} ℓ).obj (Opposite.op Y))) := by
    intro Y
    refine isUnit_iff_exists.mpr ⟨(ContinuousMap.const (↥Y) (ULift.up (ℓ : ℚ_[ℓ])⁻¹) :
      C(↥Y, ULift.{u+1} ℚ_[ℓ])), ?_, ?_⟩
    · refine ContinuousMap.ext fun x => ULift.ext _ _ ?_
      change (ℓ : ℚ_[ℓ]) * (ℓ : ℚ_[ℓ])⁻¹ = 1
      exact mul_inv_cancel₀ hq
    · refine ContinuousMap.ext fun x => ULift.ext _ _ ?_
      change (ℓ : ℚ_[ℓ])⁻¹ * (ℓ : ℚ_[ℓ]) = 1
      exact inv_mul_cancel₀ hq

  have injY : ∀ (Y : Scheme.{u}), Function.Injective ((wcIntRatPresheafMap.{u} ℓ).app (Opposite.op Y)).hom := by
    intro Y a b hab
    refine ContinuousMap.ext fun x => ULift.ext _ _ (PadicInt.ext ?_)
    have := congrArg (fun f : C(↥Y, ULift.{u+1} ℚ_[ℓ]) => (f x).down) hab
    exact this

  have bounded : ∀ (T : Type u) [TopologicalSpace T] [CompactSpace T] (s : C(T, ULift.{u+1} ℚ_[ℓ])),
      ∃ (m : ℕ) (a : C(T, ULift.{u+1} ℤ_[ℓ])), ∀ x : T,
        (ℓ : ℚ_[ℓ]) ^ m * (s x).down = (((a x).down : ℤ_[ℓ]) : ℚ_[ℓ]) := by
    intro T _ _ s
    have hf : Continuous (fun x => (s x).down) := continuous_uliftDown.comp s.continuous
    obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn hf.continuousOn
    have h1 : (1 : ℝ) < ℓ := Nat.one_lt_cast.mpr (Fact.out : Nat.Prime ℓ).one_lt
    obtain ⟨m, hm⟩ := pow_unbounded_of_one_lt C h1
    have hb : ∀ x, ‖(ℓ : ℚ_[ℓ]) ^ m * (s x).down‖ ≤ 1 := by
      intro x
      rw [norm_mul, norm_pow, Padic.norm_p, inv_pow]
      have hpos : (0 : ℝ) < (ℓ : ℝ) ^ m := by positivity
      rw [inv_mul_le_iff₀ hpos, mul_one]
      exact (hC x (Set.mem_univ x)).trans hm.le
    refine ⟨m, ⟨fun x => ULift.up ⟨(ℓ : ℚ_[ℓ]) ^ m * (s x).down, hb x⟩, ?_⟩, fun x => rfl⟩
    exact continuous_uliftUp.comp ((continuous_const.mul hf).subtype_mk hb)
  have mulY : ∀ (Y : Scheme.{u}) (m : ℕ) (s : C(↥Y, ULift.{u+1} ℚ_[ℓ]))
      (a : C(↥Y, ULift.{u+1} ℤ_[ℓ])),
      (∀ y, (ℓ : ℚ_[ℓ]) ^ m * (s y).down = (((a y).down : ℤ_[ℓ]) : ℚ_[ℓ])) →
      (ℓ : C(↥Y, ULift.{u+1} ℚ_[ℓ])) ^ m * s =
        ((wcIntRatPresheafMap.{u} ℓ).app (Opposite.op Y)).hom a := by
    intro Y m s a h
    refine ContinuousMap.ext fun y => ULift.ext _ _ ?_
    exact h y
  refine ⟨fun V => unitY _, fun V => injY _, ?_⟩
  intro V t
  have hQ : ∀ (V : Scheme.{u}), IsAffine V → ∃ (Δ : Scheme.{u}) (δ : Δ ⟶ V), IsAffine Δ ∧
      WeaklyEtale δ ∧ Surjective δ ∧ True :=
    fun V hV => ⟨V, 𝟙 V, hV, inferInstance, inferInstance, trivial⟩

  have hcovT : Sieve.generate (fun (W : S.ProEt) (_ : W ⟶ V) => IsAffine W.left ∧ True) ∈
      Scheme.ProEt.topology S V := by
    choose Δ δ hΔa hδw hδs hΔQ using
      fun i : V.left.affineCover.I₀ => hQ (V.left.affineCover.X i) inferInstance
    have hcov := Precoverage.comp_mem_coverings (J := Scheme.proetalePrecoverage)
      V.left.affineCover.f
      ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage V.left V.left.affineCover.mem₀,
       (Scheme.ofArrows_mem_precoverage_iff _).2
         ⟨fun x => ⟨_, V.left.affineCover.covers x⟩, fun i => inferInstance⟩⟩
      (σ := fun _ => PUnit.{1}) (Y := fun i _ => Δ i) (fun i _ => δ i)
      (fun i => by
        haveI := hδs i
        haveI := hΔa i
        rw [Presieve.ofArrows_pUnit]
        exact Scheme.Hom.singleton_mem_propQCPrecoverage (hδw i))
    haveI : ∀ i, WeaklyEtale (δ i) := hδw
    let W : (Σ _ : V.left.affineCover.I₀, PUnit.{1}) → S.ProEt := fun p =>
      Scheme.ProEt.mk (δ p.1 ≫ V.left.affineCover.f p.1 ≫ V.hom)
    let a : ∀ p, W p ⟶ V := fun p =>
      MorphismProperty.Over.homMk (A := W p) (B := V) (δ p.1 ≫ V.left.affineCover.f p.1)
        (Category.assoc _ _ _) trivial
    have hmem' : Presieve.ofArrows W a ∈
        (Scheme.proetalePrecoverage.comap (Scheme.ProEt.forget S ⋙ Over.forget S)).coverings V := by
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      exact hcov
    have hmem : Presieve.ofArrows W a ∈ (Scheme.ProEt.precoverage S).coverings V := hmem'
    refine GrothendieckTopology.superset_covering _ (Sieve.generate_mono ?_)
      (Precoverage.generate_mem_toGrothendieck hmem)
    rintro _ _ ⟨p⟩
    exact ⟨hΔa p.1, hΔQ p.1⟩
  refine ⟨_, hcovT, ?_⟩
  intro W g hg
  obtain ⟨Y, h, g', ⟨hY, -⟩, rfl⟩ := hg
  haveI : IsAffine Y.left := hY
  let s0 : C(↥Y.left, ULift.{u+1} ℚ_[ℓ]) := ((wcRingSheaf S ℓ).obj.map g'.op).hom t
  obtain ⟨m, a', ha'⟩ := @bounded (↥Y.left) _ (Scheme.compactSpace_of_isAffine Y.left) s0
  have EY : (ℓ : ↑((wcRingSheaf S ℓ).obj.obj (Opposite.op Y))) ^ m *
      ((wcRingSheaf S ℓ).obj.map g'.op).hom t =
      ((wcIntRatRingSheafMap S ℓ).hom.app (Opposite.op Y)).hom a' :=
    mulY Y.left m _ a' ha'
  refine ⟨m, ((wcIntRingSheaf S ℓ).obj.map h.op).hom a', ?_⟩
  rw [op_comp, Functor.map_comp, RingCat.hom_comp, RingHom.comp_apply,
    ← map_natCast ((wcRingSheaf S ℓ).obj.map h.op).hom ℓ, ← map_pow, ← map_mul, EY]
  rfl

theorem sheafOfModules_unitRestrict_hom_bijective : ∀ {C : Type (u+1)} [Category.{u} C]
    {J : GrothendieckTopology C} (R R' : Sheaf J RingCat.{u+1}) (α : R ⟶ R')
    (Y : SheafOfModules.{u+1} R'),
    Function.Bijective (fun f : SheafOfModules.unit R' ⟶ Y =>
      wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map f) :=
by
  intro C _ J R R' α Y
  have key : ∀ (f : SheafOfModules.unit R' ⟶ Y) (V : Cᵒᵖ),
      (((SheafOfModules.restrictScalars α).obj Y).unitHomEquiv
        (wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map f)).1 V =
      (Y.unitHomEquiv f).1 V := by
    intro f V
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    simp only [wcUnitRestrict, Equiv.apply_symm_apply]
    rw [PresheafOfModules.sectionsMap_coe, SheafOfModules.unitHomEquiv_apply_coe]
    rfl
  constructor
  · intro f g hfg
    have hfg' : wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map f =
        wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map g := hfg
    apply Y.unitHomEquiv.injective
    apply PresheafOfModules.sections_ext
    intro V
    exact (key f V).symm.trans
      ((congrArg (fun h => (((SheafOfModules.restrictScalars α).obj Y).unitHomEquiv h).1 V)
        hfg').trans (key g V))
  · intro h
    let t := ((SheafOfModules.restrictScalars α).obj Y).unitHomEquiv h
    let s : Y.sections := PresheafOfModules.sectionsMk (M := Y.val) (fun V => t.1 V)
      (fun _ _ g => PresheafOfModules.sections_property t g)
    refine ⟨Y.unitHomEquiv.symm s, ?_⟩
    apply ((SheafOfModules.restrictScalars α).obj Y).unitHomEquiv.injective
    apply PresheafOfModules.sections_ext
    intro V
    refine (key _ V).trans ?_
    rw [Equiv.apply_symm_apply]
    rfl

theorem sheafOfModules_unitRestrict_image_hom_bijective : ∀ {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (R R' : Sheaf J RingCat.{u+1}) (α : R ⟶ R') (n : ℕ),
    (∀ V : Cᵒᵖ, IsUnit (n : ↑(R'.obj.obj V))) →
    (∀ (V : C) (t : ↑(R'.obj.obj (Opposite.op V))), ∃ T ∈ J V, ∀ ⦃W : C⦄ (g : W ⟶ V), T.arrows g →
      ∃ (m : ℕ) (a : ↑(R.obj.obj (Opposite.op W))),
        (n : ↑(R'.obj.obj (Opposite.op W))) ^ m * (R'.obj.map g.op).hom t =
          (α.hom.app (Opposite.op W)).hom a) →
    (∀ Y : SheafOfModules.{u+1} R', Function.Bijective (fun f : SheafOfModules.unit R' ⟶ Y =>
      wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map f)) →
    ∀ (Q : SheafOfModules.{u+1} R') (σ : SheafOfModules.unit R' ⟶ Q), Epi σ →
    ∀ Y : SheafOfModules.{u+1} R', Function.Bijective (fun f : Q ⟶ Y =>
      Limits.image.ι (wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map σ) ≫
        (SheafOfModules.restrictScalars α).map f) :=
by
  intro C _ J _ _ R R' α n hn hloc hU Q σ hσ Y

  have s1 : ∀ (V : Cᵒᵖ) (a : ↑(R.obj.obj V)),
      ((wcUnitRestrict α).val.app V).hom a = (α.hom.app V).hom a := by
    intro V a
    have h1 : ((wcUnitRestrict α).val.app V).hom (1 : R.obj.obj V) = (1 : R'.obj.obj V) := by
      rw [← SheafOfModules.unitHomEquiv_apply_coe]
      simp only [wcUnitRestrict, Equiv.apply_symm_apply]
      rfl
    have h2 : ((wcUnitRestrict α).val.app V).hom a =
        a • ((wcUnitRestrict α).val.app V).hom (1 : R.obj.obj V) := by
      calc ((wcUnitRestrict α).val.app V).hom a
          = ((wcUnitRestrict α).val.app V).hom (a * (1 : R.obj.obj V)) := by rw [mul_one]
        _ = a • ((wcUnitRestrict α).val.app V).hom (1 : R.obj.obj V) :=
          ((wcUnitRestrict α).val.app V).hom.map_smul a (1 : R.obj.obj V)
    rw [h2, h1]
    exact mul_one ((α.hom.app V).hom a)

  have s4 : ∀ {M N : SheafOfModules.{u+1} R} (f : M ⟶ N), Mono f → ∀ V : Cᵒᵖ,
      Function.Injective (f.val.app V).hom := by
    intro M N f hf V
    haveI := preservesMonomorphisms_of_preservesLimitsOfShape (SheafOfModules.forget R)
    haveI : Mono f.val := by
      rw [← SheafOfModules.forget_map]
      exact Functor.map_mono _ f
    exact PresheafOfModules.injective_of_mono f.val V
  haveI : Epi σ := hσ
  have hfac := Limits.image.fac (wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map σ)
  have hstar : ∀ f : Q ⟶ Y,
      Limits.factorThruImage (wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map σ) ≫
        (Limits.image.ι (wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map σ) ≫
          (SheafOfModules.restrictScalars α).map f) =
      wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map (σ ≫ f) := by
    intro f
    rw [← Category.assoc, hfac, Functor.map_comp, Category.assoc]
  constructor
  · intro f f' hff
    have h1 : Limits.image.ι (wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map σ) ≫
          (SheafOfModules.restrictScalars α).map f =
        Limits.image.ι (wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map σ) ≫
          (SheafOfModules.restrictScalars α).map f' := hff
    have h2 := congrArg (fun φ =>
      Limits.factorThruImage (wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map σ) ≫ φ) h1
    simp only [hstar] at h2
    exact (cancel_epi σ).1 ((hU Y).1 h2)
  · intro h
    obtain ⟨g, hg⟩ := (hU Y).2
      (Limits.factorThruImage (wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map σ) ≫ h)
    have hg' : wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map g =
        Limits.factorThruImage (wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map σ) ≫ h :=
      hg

    have loc : ∀ (W : C) (a : ↑(R.obj.obj (Opposite.op W))),
        (σ.val.app (Opposite.op W)).hom ((α.hom.app (Opposite.op W)).hom a) = 0 →
        (g.val.app (Opposite.op W)).hom ((α.hom.app (Opposite.op W)).hom a) = 0 := by
      intro W a ha
      have e1 : ((Limits.image.ι (wcUnitRestrict α ≫
            (SheafOfModules.restrictScalars α).map σ)).val.app (Opposite.op W)).hom
          (((Limits.factorThruImage (wcUnitRestrict α ≫
            (SheafOfModules.restrictScalars α).map σ)).val.app (Opposite.op W)).hom a) = 0 := by
        have := congrArg (fun φ => (φ.val.app (Opposite.op W)).hom a) hfac
        refine this.trans ?_
        show (σ.val.app (Opposite.op W)).hom (((wcUnitRestrict α).val.app (Opposite.op W)).hom a) = 0
        rw [s1]
        exact ha
      have e2 : ((Limits.factorThruImage (wcUnitRestrict α ≫
            (SheafOfModules.restrictScalars α).map σ)).val.app (Opposite.op W)).hom a = 0 :=
        s4 _ inferInstance _ (e1.trans (map_zero _).symm)
      have e3 := congrArg (fun φ => (φ.val.app (Opposite.op W)).hom a) hg'
      have e4 : (g.val.app (Opposite.op W)).hom (((wcUnitRestrict α).val.app (Opposite.op W)).hom a) =
          (h.val.app (Opposite.op W)).hom (((Limits.factorThruImage (wcUnitRestrict α ≫
            (SheafOfModules.restrictScalars α).map σ)).val.app (Opposite.op W)).hom a) := e3
      rw [e2, map_zero, s1] at e4
      exact e4

    have crux : Limits.kernel.ι σ ≫ g = 0 := by
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      rintro ⟨V₀⟩
      ext k
      show (g.val.app (Opposite.op V₀)).hom
          (((Limits.kernel.ι σ).val.app (Opposite.op V₀)).hom k) = 0
      generalize hr : ((Limits.kernel.ι σ).val.app (Opposite.op V₀)).hom k = r
      have hσr : (σ.val.app (Opposite.op V₀)).hom r = 0 := by
        rw [← hr]
        exact congrArg (fun φ => (φ.val.app (Opposite.op V₀)).hom k) (Limits.kernel.condition σ)
      obtain ⟨T, hT, hTp⟩ := hloc V₀ r
      refine (Presheaf.IsSheaf.isSeparated Y.isSheaf) V₀ T hT _ 0 ?_
      intro W w hw
      obtain ⟨m, a, ha⟩ := hTp w hw
      have hnat : ∀ (Z : SheafOfModules.{u+1} R') (φ : SheafOfModules.unit R' ⟶ Z),
          (φ.val.app (Opposite.op W)).hom ((R'.obj.map w.op).hom r) =
            (Z.val.map w.op).hom ((φ.val.app (Opposite.op V₀)).hom r) := by
        intro Z φ
        exact PresheafOfModules.naturality_apply φ.val w.op r
      have hlin : ∀ (Z : SheafOfModules.{u+1} R') (φ : SheafOfModules.unit R' ⟶ Z),
          (φ.val.app (Opposite.op W)).hom
              ((n : ↑(R'.obj.obj (Opposite.op W))) ^ m * (R'.obj.map w.op).hom r) =
            ((n : ↑(R'.obj.obj (Opposite.op W))) ^ m) •
              (φ.val.app (Opposite.op W)).hom ((R'.obj.map w.op).hom r) := by
        intro Z φ
        exact (φ.val.app (Opposite.op W)).hom.map_smul _ _
      have h3 : (σ.val.app (Opposite.op W)).hom ((R'.obj.map w.op).hom r) = 0 := by
        rw [hnat, hσr]
        exact map_zero _
      have h4 : (σ.val.app (Opposite.op W)).hom ((α.hom.app (Opposite.op W)).hom a) = 0 := by
        rw [← ha, hlin, h3]
        exact smul_zero _
      have h5 := loc W a h4
      rw [← ha, hlin] at h5
      have h6 : (g.val.app (Opposite.op W)).hom ((R'.obj.map w.op).hom r) = 0 := by
        have hu : IsUnit ((n : ↑(R'.obj.obj (Opposite.op W))) ^ m) := (hn (Opposite.op W)).pow m
        exact (hu.smul_left_cancel).1 (h5.trans (smul_zero _).symm)
      rw [hnat] at h6
      show (Y.val.map w.op).hom ((g.val.app (Opposite.op V₀)).hom r) = (Y.val.map w.op).hom 0
      exact h6.trans (map_zero _).symm
    refine ⟨Abelian.epiDesc σ g crux, ?_⟩
    show Limits.image.ι (wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map σ) ≫
      (SheafOfModules.restrictScalars α).map (Abelian.epiDesc σ g crux) = h
    apply (cancel_epi
      (Limits.factorThruImage (wcUnitRestrict α ≫ (SheafOfModules.restrictScalars α).map σ))).1
    rw [hstar, Abelian.comp_epiDesc, hg']

theorem wc_proet_int_unit_free_data (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ ε : wcFreeSheaf S (MorphismProperty.Over.mk ⊤ (𝟙 S) inferInstance) ⟶
        (SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).obj (SheafOfModules.unit (wcIntRingSheaf S ℓ)),
      ∀ M : SheafOfModules.{u+1} (wcIntRingSheaf S ℓ),
        Function.Bijective (fun f : SheafOfModules.unit (wcIntRingSheaf S ℓ) ⟶ M =>
          ε ≫ (SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).map f) :=
by
  have gen : ∀ {C : Type (u+1)} [Category.{u} C]
      (J : GrothendieckTopology C)
      [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
      (R : Sheaf J RingCat.{u+1}) (T : C), Limits.IsTerminal T →
      ∃ ε : (presheafToSheaf J AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶
          (SheafOfModules.toSheaf.{u+1} R).obj (SheafOfModules.unit R),
        ∀ M : SheafOfModules.{u+1} R,
          Function.Bijective (fun f : SheafOfModules.unit R ⟶ M =>
            ε ≫ (SheafOfModules.toSheaf.{u+1} R).map f) := by
    intro C _ J _ _ R T hT
    set P : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free with hP
    let e : ∀ X : Cᵒᵖ, P.obj X := fun X => FreeAbelianGroup.of (ULift.up (hT.from X.unop))
    have hgen : ∀ (X : Cᵒᵖ) (x : ULift.{u+1} (X.unop ⟶ T)), x = ULift.up (hT.from X.unop) :=
      fun X x => ULift.ext _ _ (hT.hom_ext _ _)
    have hPmap : ∀ ⦃X Y : Cᵒᵖ⦄ (f : X ⟶ Y), P.map f (e X) = e Y := by
      intro X Y f
      exact (FreeAbelianGroup.map_of_apply _).trans (congrArg FreeAbelianGroup.of (hgen Y _))
    have huniq : ∀ (G : Cᵒᵖ ⥤ AddCommGrpCat.{u+1}) (φ ψ : P ⟶ G),
        (∀ X : Cᵒᵖ, φ.app X (e X) = ψ.app X (e X)) → φ = ψ := by
      intro G φ ψ h
      apply NatTrans.ext
      funext X
      apply AddCommGrpCat.hom_ext
      apply FreeAbelianGroup.lift_ext
      intro x
      rw [hgen X x]
      exact h X
    let G0 : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      (PresheafOfModules.toPresheaf R.obj).obj (PresheafOfModules.unit R.obj)
    let η : P ⟶ G0 :=
      { app := fun X => AddCommGrpCat.ofHom
          (FreeAbelianGroup.lift (β := G0.obj X) (fun _ => show G0.obj X from (1 : R.obj.obj X)))
        naturality := by
          intro X Y f
          apply AddCommGrpCat.hom_ext
          apply FreeAbelianGroup.lift_ext
          intro x
          show FreeAbelianGroup.lift _ (FreeAbelianGroup.map _ (FreeAbelianGroup.of x)) =
            (G0.map f).hom (FreeAbelianGroup.lift _ (FreeAbelianGroup.of x))
          rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
            FreeAbelianGroup.lift_apply_of]
          exact ((PresheafOfModules.presheaf_map_apply_coe (PresheafOfModules.unit R.obj) f _).trans
            (PresheafOfModules.unit_map_one R.obj f)).symm }
    have hη : ∀ X : Cᵒᵖ, η.app X (e X) = (1 : R.obj.obj X) := by
      intro X
      exact FreeAbelianGroup.lift_apply_of _ _
    let adj := sheafificationAdjunction J AddCommGrpCat.{u+1}
    obtain ⟨ε, hε⟩ : ∃ ε : (presheafToSheaf J AddCommGrpCat.{u+1}).obj P ⟶
        (SheafOfModules.toSheaf.{u+1} R).obj (SheafOfModules.unit R),
        adj.homEquiv _ _ ε = η := ⟨(adj.homEquiv _ _).symm η, Equiv.apply_symm_apply _ _⟩
    refine ⟨ε, fun M => ?_⟩
    have key : ∀ f : SheafOfModules.unit R ⟶ M,
        adj.homEquiv P _ (ε ≫ (SheafOfModules.toSheaf R).map f) =
          η ≫ (PresheafOfModules.toPresheaf R.obj).map f.val := by
      intro f
      rw [Adjunction.homEquiv_naturality_right, hε]
      rfl
    have hev : ∀ (f : SheafOfModules.unit R ⟶ M) (X : Cᵒᵖ),
        (η ≫ (PresheafOfModules.toPresheaf R.obj).map f.val).app X (e X) =
          (M.unitHomEquiv f).val X := by
      intro f X
      rw [SheafOfModules.unitHomEquiv_apply_coe]
      show ((PresheafOfModules.toPresheaf R.obj).map f.val).app X (η.app X (e X)) = _
      rw [hη X]
      rfl
    constructor
    · intro f f' hff
      have h1 := congrArg (adj.homEquiv P _) hff
      simp only [key] at h1
      have h2 : M.unitHomEquiv f = M.unitHomEquiv f' := by
        apply Subtype.ext
        funext X
        exact (hev f X).symm.trans
          ((congrArg (fun φ => AddCommGrpCat.Hom.hom (φ.app X) (e X)) h1).trans (hev f' X))
      exact M.unitHomEquiv.injective h2
    · intro θ
      let ψ := adj.homEquiv P _ θ
      let s : ∀ X : Cᵒᵖ, M.val.obj X := fun X => ψ.app X (e X)
      have hs : ∀ ⦃X Y : Cᵒᵖ⦄ (f : X ⟶ Y), M.val.map f (s X) = s Y := by
        intro X Y f
        have h := congrArg (fun g => AddCommGrpCat.Hom.hom g (e X)) (ψ.naturality f)
        exact (PresheafOfModules.presheaf_map_apply_coe M.val f (s X)).symm.trans
          (h.symm.trans (congrArg (fun z => AddCommGrpCat.Hom.hom (ψ.app Y) z) (hPmap f)))
      refine ⟨M.unitHomEquiv.symm (PresheafOfModules.sectionsMk s hs), ?_⟩
      apply (adj.homEquiv P _).injective
      show adj.homEquiv P _ (ε ≫ _) = ψ
      rw [key]
      apply huniq
      intro X
      refine (hev _ X).trans ?_
      rw [Equiv.apply_symm_apply, PresheafOfModules.sectionsMk_coe]
      rfl
  have hT : Limits.IsTerminal (Scheme.ProEt.mk (𝟙 S) : S.ProEt) := by
    have huniq : ∀ (V : S.ProEt) (f g : V ⟶ Scheme.ProEt.mk (𝟙 S)), f = g := by
      intro V f g
      apply MorphismProperty.Over.Hom.ext
      have hf : f.left ≫ 𝟙 S = V.hom := MorphismProperty.Over.w f
      have hg : g.left ≫ 𝟙 S = V.hom := MorphismProperty.Over.w g
      exact (Category.comp_id f.left).symm.trans (hf.trans (hg.symm.trans (Category.comp_id g.left)))
    exact Limits.IsTerminal.ofUniqueHom (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => huniq V m _)
  obtain ⟨ε, hε⟩ := gen (Scheme.ProEt.topology S) (wcIntRingSheaf S ℓ) (Scheme.ProEt.mk (𝟙 S)) hT
  exact ⟨ε, hε⟩

theorem wc_proet_int_unit_isos (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ (ιZ : (SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).obj
          (SheafOfModules.unit (wcIntRingSheaf S ℓ)) ≅ wcIntSheaf S ℓ)
      (ιQ : (SheafOfModules.toSheaf (wcRingSheaf S ℓ)).obj
          (SheafOfModules.unit (wcRingSheaf S ℓ)) ≅ wcLadicSheaf S ℓ),
      (SheafOfModules.toSheaf (wcIntRingSheaf S ℓ)).map
          (wcUnitRestrict (wcIntRatRingSheafMap S ℓ)) ≫ ιQ.hom =
        ιZ.hom ≫ wcIntToLadic S ℓ :=
by
  let GZ := (SheafOfModules.toSheaf.{u+1} (wcIntRingSheaf S ℓ)).obj
    (SheafOfModules.unit (wcIntRingSheaf S ℓ))
  let jZ := wcIntSheaf S ℓ
  let eZ : ∀ V : (S.ProEt)ᵒᵖ, GZ.obj.obj V ≅ jZ.obj.obj V := fun V =>
    { hom := AddCommGrpCat.ofHom
        { toFun := fun r => (ULift.up ((ContinuousMap.mk ULift.down continuous_uliftDown).comp
              (r : C(↥(Opposite.unop V).left, ULift.{u+1} ℤ_[ℓ]))) :
              ULift.{u+1} C(↥(Opposite.unop V).left, ℤ_[ℓ]))
          map_zero' := ULift.ext _ _ (ContinuousMap.ext fun _ => rfl)
          map_add' := fun _ _ => ULift.ext _ _ (ContinuousMap.ext fun _ => rfl) }
      inv := AddCommGrpCat.ofHom
        { toFun := fun w => ((ContinuousMap.mk ULift.up continuous_uliftUp).comp
              (w.down : C(↥(Opposite.unop V).left, ℤ_[ℓ])) :
              C(↥(Opposite.unop V).left, ULift.{u+1} ℤ_[ℓ]))
          map_zero' := ContinuousMap.ext fun _ => rfl
          map_add' := fun _ _ => ContinuousMap.ext fun _ => rfl }
      hom_inv_id := by
        apply AddCommGrpCat.ext
        intro r
        rfl
      inv_hom_id := by
        apply AddCommGrpCat.ext
        intro w
        rfl }
  let NZ : GZ.obj ≅ jZ.obj := NatIso.ofComponents eZ (fun {V W} f => by
    apply AddCommGrpCat.ext
    intro r
    rfl)
  let ιZ : GZ ≅ jZ := ObjectProperty.isoMk _ NZ
  let G1 := (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)).obj
    (SheafOfModules.unit (wcRingSheaf S ℓ))
  let jQ := wcLadicSheaf S ℓ
  let e : ∀ V : (S.ProEt)ᵒᵖ, G1.obj.obj V ≅ jQ.obj.obj V := fun V =>
    { hom := AddCommGrpCat.ofHom
        { toFun := fun r => (ULift.up ((ContinuousMap.mk ULift.down continuous_uliftDown).comp
              (r : C(↥(Opposite.unop V).left, ULift.{u+1} ℚ_[ℓ]))) :
              ULift.{u+1} C(↥(Opposite.unop V).left, ℚ_[ℓ]))
          map_zero' := ULift.ext _ _ (ContinuousMap.ext fun _ => rfl)
          map_add' := fun _ _ => ULift.ext _ _ (ContinuousMap.ext fun _ => rfl) }
      inv := AddCommGrpCat.ofHom
        { toFun := fun w => ((ContinuousMap.mk ULift.up continuous_uliftUp).comp
              (w.down : C(↥(Opposite.unop V).left, ℚ_[ℓ])) :
              C(↥(Opposite.unop V).left, ULift.{u+1} ℚ_[ℓ]))
          map_zero' := ContinuousMap.ext fun _ => rfl
          map_add' := fun _ _ => ContinuousMap.ext fun _ => rfl }
      hom_inv_id := by
        apply AddCommGrpCat.ext
        intro r
        rfl
      inv_hom_id := by
        apply AddCommGrpCat.ext
        intro w
        rfl }
  let N : G1.obj ≅ jQ.obj := NatIso.ofComponents e (fun {V W} f => by
    apply AddCommGrpCat.ext
    intro r
    rfl)
  let ιQ : G1 ≅ jQ := ObjectProperty.isoMk _ N
  refine ⟨ιZ, ιQ, ?_⟩
  apply Sheaf.hom_ext
  apply NatTrans.ext
  funext V
  apply AddCommGrpCat.ext
  intro r
  change (_ : ULift.{u+1} C(↥(Opposite.unop V).left, ℚ_[ℓ])) = _
  apply ULift.ext
  apply ContinuousMap.ext
  intro t
  show ((((@id C(↥(Opposite.unop V).left, ULift.{u+1} ℤ_[ℓ]) r) t).down : ℤ_[ℓ]) : ℚ_[ℓ]) * 1 =
    ((((@id C(↥(Opposite.unop V).left, ULift.{u+1} ℤ_[ℓ]) r) t).down : ℤ_[ℓ]) : ℚ_[ℓ])
  exact mul_one _

theorem wc_supp_hom_twist_formula {S S' : Scheme.{u}} {f : S' ⟶ S} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData f ℓ) (hD : wcHMPullCanonical D)
    (ρ' : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ wcSuppObj D) (V : S.ProEt)
    (t : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) :
    ((ρ'.val.app (Opposite.op V)).hom t : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ])) =
      t.comp (Limits.pullback.fst V.hom f).base.hom *
        (wcSuppTwist ρ').comp (Limits.pullback.snd V.hom f).base.hom :=
by
  classical
  have hlam1 : Limits.pullback.lift f (𝟙 S') ((Category.comp_id f).trans (Category.id_comp f).symm) ≫
      Limits.pullback.fst (𝟙 S) f = f := Limits.pullback.lift_fst _ _ _
  have hlam2 : Limits.pullback.lift f (𝟙 S') ((Category.comp_id f).trans (Category.id_comp f).symm) ≫
      Limits.pullback.snd (𝟙 S) f = 𝟙 S' := Limits.pullback.lift_snd _ _ _
  let T : S.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : WeaklyEtale (𝟙 S))
  let e : V ⟶ T := MorphismProperty.Over.homMk V.hom (Category.comp_id V.hom) trivial
  let β : Limits.pullback V.hom f ⟶ Limits.pullback (𝟙 S) f := ((wcProEtBC f).map e).left
  have hβw : β ≫ Limits.pullback.snd (𝟙 S) f = Limits.pullback.snd V.hom f :=
    MorphismProperty.Over.w ((wcProEtBC f).map e)
  have hβ : β = Limits.pullback.snd V.hom f ≫
      Limits.pullback.lift f (𝟙 S') ((Category.comp_id f).trans (Category.id_comp f).symm) := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hlam1, ← hβw, Category.assoc, ← Limits.pullback.condition,
        Category.comp_id]
    · rw [Category.assoc, hlam2, Category.comp_id, hβw]

  let m1 : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ]) :=
    (ρ'.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
  let mT : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℚ_[ℓ]) :=
    (ρ'.val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℚ_[ℓ]))
  have e1 : m1 = mT.comp β.base.hom :=
    PresheafOfModules.naturality_apply ρ'.val e.op (1 : C(↥S, ULift.{u+1} ℚ_[ℓ]))

  let mt : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ]) :=
    (ρ'.val.app (Opposite.op V)).hom t
  let φt : C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ]) :=
    (D.φ.hom.app (Opposite.op V)).hom t
  have hφ : φt = t.comp (Limits.pullback.fst V.hom f).base.hom := hD V t
  have e2 : mt = t.comp (Limits.pullback.fst V.hom f).base.hom * m1 := by
    have h := (ρ'.val.app (Opposite.op V)).hom.map_smul t (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    have h' : ((ρ'.val.app (Opposite.op V)).hom (t * 1) :
          C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ])) = φt * m1 := h
    rw [hφ] at h'
    have h0 : ((ρ'.val.app (Opposite.op V)).hom (t * 1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])) :
        C(↥(Limits.pullback V.hom f), ULift.{u+1} ℚ_[ℓ])) = mt :=
      congrArg (fun x => (ρ'.val.app (Opposite.op V)).hom x) (mul_one t)
    exact h0.symm.trans h'
  have e3 : mT.comp (Limits.pullback.snd V.hom f ≫
      Limits.pullback.lift f (𝟙 S') ((Category.comp_id f).trans (Category.id_comp f).symm)).base.hom =
      (wcSuppTwist ρ').comp (Limits.pullback.snd V.hom f).base.hom :=
    ContinuousMap.ext fun _ => rfl
  show mt = _
  rw [e2, e1, hβ, e3]

theorem wc_supp_unit_twist_isUnit {S S' : Scheme.{u}} {f : S' ⟶ S} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData f ℓ) :
    ∃ c' : C(↥S', ULift.{u+1} ℚ_[ℓ]), wcSuppTwist (wcSuppUnitMap D) * c' = 1 :=
by
  classical
  letI := D.cont

  let u := SheafOfModules.unitToPushforwardObjUnit D.φ
  let ψ₁ := (D.adj.homEquiv _ _).symm u
  let h : SheafOfModules.unit (wcRingSheaf S' ℓ) ⟶ SheafOfModules.unit (wcRingSheaf S' ℓ) :=
    D.μ.inv ≫ ψ₁

  have hfac : u = wcSuppUnitMap D ≫
      (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map h := by
    have e1 : D.μ.hom ≫ h = ψ₁ := Iso.hom_inv_id_assoc _ _
    calc u = D.adj.homEquiv _ _ ψ₁ := (Equiv.apply_symm_apply _ _).symm
      _ = D.adj.homEquiv _ _ (D.μ.hom ≫ h) := by rw [e1]
      _ = D.adj.homEquiv _ _ D.μ.hom ≫
          (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map h :=
        Adjunction.homEquiv_naturality_right _ _ _
      _ = wcSuppUnitMap D ≫
          (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC f) _ _ D.cont D.φ).map h := by
        rw [Adjunction.homEquiv_unit]; rfl

  let T : S.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : WeaklyEtale (𝟙 S))
  let cT : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℚ_[ℓ]) :=
    ((wcSuppUnitMap D).val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℚ_[ℓ]))
  let a : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℚ_[ℓ]) :=
    (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom
      (1 : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℚ_[ℓ]))
  have hu1 : (u.val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℚ_[ℓ])) =
      (1 : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℚ_[ℓ])) :=
    (D.φ.hom.app (Opposite.op T)).hom.map_one
  have hev : (u.val.app (Opposite.op T)).hom (1 : C(↥S, ULift.{u+1} ℚ_[ℓ])) =
      (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom cT := by
    rw [hfac]
    rfl

  have hlin : ∀ x : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℚ_[ℓ]),
      (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom x = x * a := by
    intro x
    have e := (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom.map_smul x
      (1 : C(↥(Limits.pullback (𝟙 S) f), ULift.{u+1} ℚ_[ℓ]))
    have e2 : (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom x =
        (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom (x * 1) :=
      congrArg (fun y => (h.val.app (Opposite.op ((wcProEtBC f).obj T))).hom y) (mul_one x).symm
    exact e2.trans e
  have key : cT * a = 1 := by
    rw [← hlin cT, ← hev, hu1]

  refine ⟨a.comp (Limits.pullback.lift f (𝟙 S')
    ((Category.comp_id f).trans (Category.id_comp f).symm)).base.hom, ?_⟩
  show cT.comp (Limits.pullback.lift f (𝟙 S')
      ((Category.comp_id f).trans (Category.id_comp f).symm)).base.hom *
    a.comp (Limits.pullback.lift f (𝟙 S')
      ((Category.comp_id f).trans (Category.id_comp f).symm)).base.hom = 1
  rw [← ContinuousMap.mul_comp, key, ContinuousMap.one_comp]

theorem wc_fibre_function_local_extension {Y Z₀ : Scheme.{u}} (i : Z₀ ⟶ Y) [IsClosedImmersion i]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (U : Y.ProEt) (hU : IsAffine U.left)
    (s : C(↥(Limits.pullback U.hom i), ULift.{u+1} ℚ_[ℓ])) :
    ∃ (W : Y.ProEt) (g : W ⟶ U) (t : C(↥W.left, ULift.{u+1} ℚ_[ℓ])),
      IsAffine W.left ∧ Surjective g.left ∧
      t.comp (Limits.pullback.fst W.hom i).base.hom = s.comp ((wcProEtBC i).map g).left.base.hom :=
by
  classical
  have hℓp : Nat.Prime ℓ := Fact.out

  have wc_lc_spec_weaklyEtale : ∀ (K : Type) [TopologicalSpace K] [CompactSpace K],
      WeaklyEtale (Spec.map (CommRingCat.ofHom
        (algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))))) := by
    intro K _ _
    have hsep : ∀ φ : LocallyConstant K (ULift.{u} ℤ),
        ∃ c : TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
          (LocallyConstant K (ULift.{u} ℤ)),
        Algebra.TensorProduct.lmul' (ULift.{u} ℤ) c = 1 ∧
          c * (TensorProduct.tmul (ULift.{u} ℤ) (1 : LocallyConstant K (ULift.{u} ℤ)) φ -
            TensorProduct.tmul (ULift.{u} ℤ) φ 1) = 0 := by
      intro φ
      let s : Finset (ULift.{u} ℤ) := (LocallyConstant.range_finite φ).toFinset
      let ε : ULift.{u} ℤ → LocallyConstant K (ULift.{u} ℤ) :=
        fun v => φ.map (fun w => if w = v then (1 : ULift.{u} ℤ) else 0)
      have hε : ∀ v y, ε v y = if φ y = v then 1 else 0 := fun v y => rfl
      have F1 : ∀ v, ε v * ε v = ε v := by
        intro v
        ext y
        rw [LocallyConstant.mul_apply, hε]
        split_ifs <;> simp
      have F2 : ∀ v, ε v * φ = v • ε v := by
        intro v
        ext y
        rw [LocallyConstant.mul_apply, LocallyConstant.smul_apply, hε]
        split_ifs with h
        · rw [h, one_mul, smul_eq_mul, mul_one]
        · rw [zero_mul, smul_eq_mul, mul_zero]
      have F3 : ∑ v ∈ s, ε v = 1 := by
        ext y
        have := map_sum (LocallyConstant.evalRingHom y :
          LocallyConstant K (ULift.{u} ℤ) →+* ULift.{u} ℤ) ε s
        simp only [LocallyConstant.evalRingHom_apply] at this
        rw [this]
        simp [hε, s, Finset.sum_ite_eq]
      refine ⟨∑ v ∈ s, TensorProduct.tmul (ULift.{u} ℤ) (ε v) (ε v), ?_, ?_⟩
      · rw [map_sum]
        simp only [Algebra.TensorProduct.lmul'_apply_tmul, F1]
        exact F3
      · rw [Finset.sum_mul]
        apply Finset.sum_eq_zero
        intro v _
        rw [mul_sub, Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
          mul_one, F2, TensorProduct.smul_tmul, sub_self]
    have heq : algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ)) =
        (algebraMap ℤ (LocallyConstant K (ULift.{u} ℤ))).comp
          (ULift.ringEquiv : ULift.{u} ℤ ≃+* ℤ).toRingHom := by
      refine RingHom.ext fun x => LocallyConstant.ext fun y => ?_
      apply ULift.ext
      have e1 : (algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ)) x) y = x := rfl
      have e2 : ((algebraMap ℤ (LocallyConstant K (ULift.{u} ℤ))).comp
          (ULift.ringEquiv : ULift.{u} ℤ ≃+* ℤ).toRingHom x) y = ((x.down : ℤ) : ULift.{u} ℤ) := by
        rw [RingHom.comp_apply, eq_intCast]
        exact map_intCast (LocallyConstant.evalRingHom y :
          LocallyConstant K (ULift.{u} ℤ) →+* ULift.{u} ℤ) _
      rw [e1, e2, ULift.down_intCast, Int.cast_id]
    have hfring : (algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))).Flat := by
      rw [heq]
      refine RingHom.Flat.comp ?_ ?_
      · exact RingHom.Flat.of_bijective (ULift.ringEquiv : ULift.{u} ℤ ≃+* ℤ).bijective
      · refine RingHom.flat_algebraMap_iff.mpr ?_
        rw [IsDedekindDomain.flat_iff_torsion_eq_bot, Submodule.eq_bot_iff]
        intro x hx
        obtain ⟨a, ha⟩ := (Submodule.mem_torsion_iff x).mp hx
        have hn : (a : ℤ) ≠ 0 := nonZeroDivisors.coe_ne_zero a
        rw [Submonoid.smul_def, Algebra.smul_def] at ha
        ext y
        have h1 := congrArg (LocallyConstant.evalRingHom y :
          LocallyConstant K (ULift.{u} ℤ) →+* ULift.{u} ℤ) ha
        rw [map_mul, map_zero, eq_intCast, map_intCast, LocallyConstant.evalRingHom_apply] at h1
        have h2 := congrArg ULift.down h1
        rw [ULift.mul_down, ULift.down_intCast, ULift.zero_down, Int.cast_id] at h2
        show (x y).down = (0 : ULift.{u} ℤ).down
        rw [ULift.zero_down]
        exact (mul_eq_zero.mp h2).resolve_left hn
    have hflatμ : RingHom.Flat
        (Algebra.TensorProduct.lmul' (ULift.{u} ℤ) :
          TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
            (LocallyConstant K (ULift.{u} ℤ)) →ₐ[ULift.{u} ℤ]
              LocallyConstant K (ULift.{u} ℤ)).toRingHom := by
      let μ := (Algebra.TensorProduct.lmul' (ULift.{u} ℤ) :
          TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
            (LocallyConstant K (ULift.{u} ℤ)) →ₐ[ULift.{u} ℤ] LocallyConstant K (ULift.{u} ℤ))
      letI : Algebra (TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
          (LocallyConstant K (ULift.{u} ℤ))) (LocallyConstant K (ULift.{u} ℤ)) :=
        μ.toRingHom.toAlgebra
      let M : Submonoid (TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
          (LocallyConstant K (ULift.{u} ℤ))) :=
        Submonoid.comap μ.toRingHom (IsUnit.submonoid (LocallyConstant K (ULift.{u} ℤ)))
      have hM : ∀ y, y ∈ M ↔ IsUnit (μ y) := fun y => by
        rw [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]; rfl
      haveI : IsLocalization M (LocallyConstant K (ULift.{u} ℤ)) := by
        refine ⟨?_, ?_, ?_⟩
        · intro y
          exact (hM y.1).mp y.2
        · intro z
          refine ⟨⟨TensorProduct.tmul (ULift.{u} ℤ) z 1, 1⟩, ?_⟩
          show z * μ 1 = μ (TensorProduct.tmul (ULift.{u} ℤ) z 1)
          rw [map_one, Algebra.TensorProduct.lmul'_apply_tmul, mul_one]
        · intro x y hxy
          change μ x = μ y at hxy
          have hker : x - y ∈ Ideal.span (Set.range fun s : LocallyConstant K (ULift.{u} ℤ) =>
              TensorProduct.tmul (ULift.{u} ℤ) (1 : LocallyConstant K (ULift.{u} ℤ)) s -
                TensorProduct.tmul (ULift.{u} ℤ) s 1) := by
            rw [KaehlerDifferential.span_range_eq_ideal, KaehlerDifferential.ideal, RingHom.mem_ker,
              map_sub]
            exact sub_eq_zero.mpr hxy
          have key : ∀ a ∈ Ideal.span (Set.range fun s : LocallyConstant K (ULift.{u} ℤ) =>
              TensorProduct.tmul (ULift.{u} ℤ) (1 : LocallyConstant K (ULift.{u} ℤ)) s -
                TensorProduct.tmul (ULift.{u} ℤ) s 1),
              ∃ c ∈ M, c * a = 0 := by
            intro a ha
            induction ha using Submodule.span_induction with
            | mem a ha =>
              obtain ⟨s, rfl⟩ := ha
              obtain ⟨c, hc1, hc2⟩ := hsep s
              refine ⟨c, (hM c).mpr ?_, hc2⟩
              show IsUnit (Algebra.TensorProduct.lmul' (ULift.{u} ℤ) c)
              rw [hc1]; exact isUnit_one
            | zero => exact ⟨1, M.one_mem, mul_zero 1⟩
            | add a b _ _ ha hb =>
              obtain ⟨c1, h1, e1⟩ := ha
              obtain ⟨c2, h2, e2⟩ := hb
              exact ⟨c1 * c2, M.mul_mem h1 h2, by linear_combination c2 * e1 + c1 * e2⟩
            | smul r a _ ha =>
              obtain ⟨c, h, e⟩ := ha
              exact ⟨c, h, by rw [smul_eq_mul, mul_left_comm, e, mul_zero]⟩
          obtain ⟨c, hc, e⟩ := key _ hker
          exact ⟨⟨c, hc⟩, by rw [mul_sub] at e; exact sub_eq_zero.mp e⟩
      exact IsLocalization.flat (LocallyConstant K (ULift.{u} ℤ)) M
    have hf : Flat (Spec.map (CommRingCat.ofHom
        (algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      exact hfring
    have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom
        (algebraMap (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ)))))) := by
      rw [diagonal_SpecMap]
      haveI : Flat (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' (ULift.{u} ℤ) :
          TensorProduct (ULift.{u} ℤ) (LocallyConstant K (ULift.{u} ℤ))
            (LocallyConstant K (ULift.{u} ℤ)) →ₐ[ULift.{u} ℤ]
              LocallyConstant K (ULift.{u} ℤ)).toRingHom)) :=
        HasRingHomProperty.Spec_iff.mpr hflatμ
      infer_instance
    exact ⟨hf, hd⟩

  have wc_lc_spec_pi0 : ∀ (K : Type) [TopologicalSpace K] [CompactSpace K] [T2Space K]
      [TotallyDisconnectedSpace K],
      ∃ π0 : C(PrimeSpectrum (LocallyConstant K (ULift.{u} ℤ)), K),
        ∀ (U : Set K) (hU : IsClopen U) (q : PrimeSpectrum (LocallyConstant K (ULift.{u} ℤ))),
          π0 q ∈ U ↔ q ∈ PrimeSpectrum.basicOpen (LocallyConstant.charFn (ULift.{u} ℤ) hU) := by
    intro K _ _ _ _
    have I1 : LocallyConstant.charFn (ULift.{u} ℤ) (isClopen_univ (X := K)) = 1 := by
      ext y
      simp [LocallyConstant.coe_charFn]
    have I2 : LocallyConstant.charFn (ULift.{u} ℤ) (isClopen_empty (X := K)) = 0 := by
      ext y
      simp [LocallyConstant.coe_charFn]
    have I3 : ∀ (U V : Set K) (hU : IsClopen U) (hV : IsClopen V),
        LocallyConstant.charFn (ULift.{u} ℤ) (hU.inter hV) =
          LocallyConstant.charFn (ULift.{u} ℤ) hU * LocallyConstant.charFn (ULift.{u} ℤ) hV := by
      intro U V hU hV
      ext y
      simp only [LocallyConstant.coe_charFn, LocallyConstant.coe_mul, Pi.mul_apply,
        Set.indicator_apply, Pi.one_apply, Set.mem_inter_iff]
      split_ifs <;> simp_all
    have I5 : ∀ (U : Set K) (hU : IsClopen U),
        LocallyConstant.charFn (ULift.{u} ℤ) hU + LocallyConstant.charFn (ULift.{u} ℤ) hU.compl = 1 := by
      intro U hU
      ext y
      simp only [LocallyConstant.coe_charFn, LocallyConstant.coe_add, LocallyConstant.coe_one,
        Pi.add_apply, Pi.one_apply, Set.indicator_apply, Set.mem_compl_iff]
      split_ifs <;> simp_all
    have key : ∀ q : PrimeSpectrum (LocallyConstant K (ULift.{u} ℤ)), ∃ x : K,
        ∀ (U : Set K) (hU : IsClopen U),
          x ∈ U ↔ LocallyConstant.charFn (ULift.{u} ℤ) hU ∉ q.asIdeal := by
      intro q
      have hP := q.isPrime
      have h1 : (1 : LocallyConstant K (ULift.{u} ℤ)) ∉ q.asIdeal :=
        (Ideal.ne_top_iff_one _).mp hP.ne_top
      let 𝒰 : Set (Set K) :=
        {U | ∃ hU : IsClopen U, LocallyConstant.charFn (ULift.{u} ℤ) hU ∉ q.asIdeal}
      have hne : (⋂₀ 𝒰).Nonempty := by
        have : Nonempty 𝒰 := ⟨⟨Set.univ, isClopen_univ, by rw [I1]; exact h1⟩⟩
        apply IsCompact.nonempty_sInter_of_directed_nonempty_isCompact_isClosed
        · intro U hU V hV
          obtain ⟨hU', hu⟩ := hU
          obtain ⟨hV', hv⟩ := hV
          refine ⟨U ∩ V, ⟨hU'.inter hV', ?_⟩, Set.inter_subset_left, Set.inter_subset_right⟩
          rw [I3 U V hU' hV']
          intro hm
          rcases hP.mem_or_mem hm with h | h
          · exact hu h
          · exact hv h
        · rintro U ⟨hU', hu⟩
          rw [Set.nonempty_iff_ne_empty]
          rintro rfl
          apply hu
          have e : LocallyConstant.charFn (ULift.{u} ℤ) hU' = 0 := I2
          rw [e]
          exact Ideal.zero_mem _
        · rintro U ⟨hU', -⟩
          exact hU'.isClosed.isCompact
        · rintro U ⟨hU', -⟩
          exact hU'.isClosed
      obtain ⟨x, hx⟩ := hne
      rw [Set.mem_sInter] at hx
      refine ⟨x, fun U hU => ⟨fun hxU hm => ?_, fun hn => hx U ⟨hU, hn⟩⟩⟩
      have hc : LocallyConstant.charFn (ULift.{u} ℤ) hU.compl ∉ q.asIdeal := by
        intro hc
        apply h1
        rw [← I5 U hU]
        exact Ideal.add_mem _ hm hc
      exact hx Uᶜ ⟨hU.compl, hc⟩ hxU
    choose f hf using key
    have hcont : Continuous f := by
      rw [isTopologicalBasis_isClopen.continuous_iff]
      intro s hs
      have e : f ⁻¹' s =
          (PrimeSpectrum.basicOpen (LocallyConstant.charFn (ULift.{u} ℤ) hs) : Set _) := by
        ext q
        rw [Set.mem_preimage, hf q s hs, SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
      rw [e]
      exact PrimeSpectrum.isOpen_basicOpen
    refine ⟨⟨f, hcont⟩, fun U hU q => ?_⟩
    rw [PrimeSpectrum.mem_basicOpen]
    exact hf q U hU

  have wc_affine_lc_cover : ∀ (T : Scheme.{u}) [IsAffine T] (K : Type) [TopologicalSpace K]
      [CompactSpace K] [T2Space K] [TotallyDisconnectedSpace K],
      ∃ (P : Scheme.{u}) (p : P ⟶ T) (π : C(↥P, K)), IsAffine P ∧ WeaklyEtale p ∧
        (∀ (t : ↥T) (k : K), ∃ q : ↥P, p q = t ∧ π q = k) ∧
        ∀ (W : Set K), IsClopen W → ∃ E : Γ(P, ⊤), IsIdempotentElem E ∧
          ∀ q : ↥P, q ∈ P.basicOpen E ↔ π q ∈ W := by
    intro T _ K _ _ _ _
    let L := LocallyConstant K (ULift.{u} ℤ)
    let σ := Spec.map (CommRingCat.ofHom (algebraMap (ULift.{u} ℤ) L))
    let τ : T ⟶ Spec (CommRingCat.of (ULift.{u} ℤ)) := specULiftZIsTerminal.from T
    haveI : WeaklyEtale σ := wc_lc_spec_weaklyEtale K
    obtain ⟨π0, hπ0⟩ := wc_lc_spec_pi0 K
    let sn := Limits.pullback.snd τ σ
    let π : C(↥(Limits.pullback τ σ), K) := π0.comp sn.base.hom
    have hev : ∀ (W : Set K) (hW : IsClopen W) (k : K),
        LocallyConstant.evalRingHom k (LocallyConstant.charFn (ULift.{u} ℤ) hW) =
          if k ∈ W then 1 else 0 := by
      intro W hW k
      show (LocallyConstant.charFn (ULift.{u} ℤ) hW) k = _
      rw [LocallyConstant.coe_charFn, Set.indicator_apply]
      rfl
    refine ⟨Limits.pullback τ σ, Limits.pullback.fst τ σ, π, inferInstance, inferInstance, ?_, ?_⟩
    · intro t k
      let q₀ : ↥(Spec (CommRingCat.of L)) :=
        (PrimeSpectrum.comap (LocallyConstant.evalRingHom k) (τ t) : PrimeSpectrum L)
      have hσ : τ t = σ q₀ := by
        refine Eq.symm ((Spec.map_apply _ q₀).trans ?_)
        apply PrimeSpectrum.ext
        ext c
        exact Iff.rfl
      obtain ⟨q, hq1, hq2⟩ := Scheme.Pullback.exists_preimage_pullback t q₀ hσ
      refine ⟨q, hq1, ?_⟩
      have hπq : π q = π0 q₀ := by
        show π0 (sn q) = π0 q₀
        rw [hq2]
      rw [hπq]
      by_contra hne
      obtain ⟨W, hWc, hW1, hW2⟩ := exists_isClopen_of_totally_separated hne
      have h1 := (hπ0 W hWc q₀).mp hW1
      rw [PrimeSpectrum.mem_basicOpen] at h1
      apply h1
      show LocallyConstant.evalRingHom k (LocallyConstant.charFn (ULift.{u} ℤ) hWc) ∈ (τ t).asIdeal
      rw [hev, if_neg hW2]
      exact Ideal.zero_mem _
    · intro W hW
      have hidem : IsIdempotentElem (LocallyConstant.charFn (ULift.{u} ℤ) hW) := by
        refine LocallyConstant.ext fun x => ?_
        simp only [LocallyConstant.coe_mul, Pi.mul_apply, LocallyConstant.coe_charFn,
          Set.indicator_apply]
        split_ifs <;> simp
      refine ⟨sn.appTop ((Scheme.ΓSpecIso (CommRingCat.of L)).inv
        (LocallyConstant.charFn (ULift.{u} ℤ) hW)),
        (hidem.map (Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom).map sn.appTop.hom, fun q => ?_⟩
      rw [← Scheme.preimage_basicOpen_top]
      show sn q ∈ (Spec (CommRingCat.of L)).basicOpen _ ↔ π0 (sn q) ∈ W
      rw [basicOpen_eq_of_affine]
      exact (hπ0 W hW (sn q)).symm

  have wc_affine_localize_basicOpens : ∀ (P : Scheme.{u}) [IsAffine P] (M : Set Γ(P, ⊤)),
      ∃ (V : Scheme.{u}) (j : V ⟶ P), IsAffine V ∧ WeaklyEtale j ∧
        Set.range j = {q : ↥P | ∀ s ∈ M, q ∈ P.basicOpen s} := by
    intro P _ M
    let N := Submonoid.closure M
    let φ := CommRingCat.ofHom (algebraMap Γ(P, ⊤) (Localization N))
    have hflat : Flat (Spec.map φ) := by
      rw [HasRingHomProperty.Spec_iff (P := @Flat)]
      exact RingHom.flat_algebraMap_iff.mpr (IsLocalization.flat _ N)
    have hmono : Mono (Spec.map φ) := (inferInstance : Mono (Scheme.Spec.map φ.op))
    have hW : WeaklyEtale (Spec.map φ) := WeaklyEtale.mk hflat inferInstance
    refine ⟨Spec (CommRingCat.of (Localization N)), Spec.map φ ≫ P.isoSpec.inv, inferInstance,
      inferInstance, ?_⟩
    have hrange : ∀ p : PrimeSpectrum Γ(P, ⊤), (∃ w, Spec.map φ w = p) ↔
        Disjoint (N : Set Γ(P, ⊤)) p.asIdeal := by
      intro p
      have h := Set.ext_iff.mp (PrimeSpectrum.localization_comap_range (Localization N) N) p
      refine Iff.trans ?_ h
      constructor
      · rintro ⟨w, hw⟩
        exact ⟨w, (Spec.map_apply φ w).symm.trans hw⟩
      · rintro ⟨w, hw⟩
        exact ⟨w, (Spec.map_apply φ w).trans hw⟩
    have hdisj : ∀ p : PrimeSpectrum Γ(P, ⊤), Disjoint (N : Set Γ(P, ⊤)) p.asIdeal ↔
        ∀ s ∈ M, s ∉ p.asIdeal := by
      intro p
      rw [Set.disjoint_left]
      constructor
      · intro H s hs
        exact H (Submonoid.subset_closure hs)
      · intro H a ha
        induction ha using Submonoid.closure_induction with
        | mem x hx => exact H x hx
        | one => exact (Ideal.ne_top_iff_one _).mp p.isPrime.ne_top
        | mul x y _ _ hx hy =>
          intro hxy
          rcases (p.isPrime.mul_mem_iff_mem_or_mem).mp hxy with h | h
          · exact hx h
          · exact hy h
    have hbo : ∀ (q : P) (s : Γ(P, ⊤)), q ∈ P.basicOpen s ↔ s ∉ (P.isoSpec.hom q).asIdeal := by
      intro q s
      rw [Scheme.isoSpec_hom, ← Scheme.toSpecΓ_preimage_basicOpen]
      exact PrimeSpectrum.mem_basicOpen _ _
    ext q
    show q ∈ Set.range _ ↔ ∀ s ∈ M, q ∈ P.basicOpen s
    constructor
    · rintro ⟨w, rfl⟩ s hs
      rw [hbo]
      have e : P.isoSpec.hom ((Spec.map φ ≫ P.isoSpec.inv) w) = Spec.map φ w := by
        rw [← Scheme.Hom.comp_apply, Category.assoc, Iso.inv_hom_id, Category.comp_id]
      rw [e]
      exact (hdisj _).mp ((hrange _).mp ⟨w, rfl⟩) s hs
    · intro H
      obtain ⟨w, hw⟩ := (hrange (P.isoSpec.hom q)).mpr
        ((hdisj _).mpr (fun s hs => (hbo q s).mp (H s hs)))
      refine ⟨w, ?_⟩
      rw [Scheme.Hom.comp_apply, hw, ← Scheme.Hom.comp_apply, Iso.hom_inv_id]
      rfl

  have wc_basicOpen_one_sub_add_mul : ∀ (P : Scheme.{u}) (E c : Γ(P, ⊤)), IsIdempotentElem E →
      ∀ q : ↥P, q ∈ P.basicOpen (1 - E + E * c) ↔ (q ∈ P.basicOpen E → q ∈ P.basicOpen c) := by
    intro P E c hE q
    simp only [← Scheme.evaluation_ne_zero_iff_mem_basicOpen P q (U := ⊤) trivial, map_add,
      map_sub, map_one, map_mul]
    rcases IsIdempotentElem.iff_eq_zero_or_one.mp
        (hE.map (ConcreteCategory.hom (P.evaluation ⊤ q trivial))) with h0 | h1
    · rw [h0]; simp
    · rw [h1]; simp

  have e1 : ∀ (V Z : Scheme.{u}) [IsAffine V] (j : Z ⟶ V) [IsClosedImmersion j] (N : ℕ), 0 < N →
      ∀ (c : C(↥Z, Fin N)), ∃ (r : ℕ) (f : Fin r → Γ(V, ⊤)) (κ : Fin r → Fin N),
        (∀ v : ↥V, ∃ a, v ∈ V.basicOpen (f a)) ∧
        ∀ (z : ↥Z) (a : Fin r), j z ∈ V.basicOpen (f a) → c z = κ a := by
    intro V Z _ j _ N hN c
    let O : Fin N → Set ↥V := fun k => (j '' (c ⁻¹' {k}ᶜ))ᶜ
    have hO : ∀ k, IsOpen (O k) := fun k =>
      (j.isClosedEmbedding.isClosedMap _ ((isClosed_discrete _).preimage c.continuous)).isOpen_compl
    have hcol : ∀ k z, j z ∈ O k → c z = k := by
      intro k z hz
      by_contra hne
      exact hz ⟨z, hne, rfl⟩
    have hk : ∀ v : ↥V, ∃ k, v ∈ O k := by
      intro v
      by_cases hv : ∃ z, j z = v
      · obtain ⟨z, rfl⟩ := hv
        refine ⟨c z, ?_⟩
        rintro ⟨z', hz', hzz⟩
        have h' : z' = z := j.isClosedEmbedding.toIsEmbedding.injective hzz
        subst h'
        exact hz' (Set.mem_singleton _)
      · refine ⟨⟨0, hN⟩, ?_⟩
        rintro ⟨z', _, hzz⟩
        exact hv ⟨z', hzz⟩
    choose kv hkv using hk
    have hnb : ∀ v : ↥V, ∃ f : Γ(V, ⊤), v ∈ V.basicOpen f ∧ (V.basicOpen f : Set V) ⊆ O (kv v) := by
      intro v
      obtain ⟨U', ⟨f, rfl⟩, hv, hle⟩ := TopologicalSpace.Opens.isBasis_iff_nbhd.mp
        (isBasis_basicOpen V) (U := ⟨O (kv v), hO _⟩) (x := v) (hkv v)
      exact ⟨f, hv, fun x hx => hle hx⟩
    choose fv hfv hfvO using hnb
    obtain ⟨s, hs⟩ := isCompact_univ.elim_finite_subcover (fun v => (V.basicOpen (fv v) : Set V))
      (fun v => (V.basicOpen (fv v)).isOpen) (fun v _ => Set.mem_iUnion.mpr ⟨v, hfv v⟩)
    refine ⟨s.card, fun a => fv (s.equivFin.symm a), fun a => kv (s.equivFin.symm a),
      fun v => ?_, fun z a hz => hcol _ z (hfvO _ hz)⟩
    obtain ⟨u', hu, hvu⟩ := Set.mem_iUnion₂.mp (hs (Set.mem_univ v))
    refine ⟨s.equivFin ⟨u', hu⟩, ?_⟩
    simpa using hvu

  have e3 : ∀ (V : Scheme.{u}) [IsAffine V] (r : ℕ → ℕ) (f : ∀ m, Fin (r m) → Γ(V, ⊤)),
      (∀ (m : ℕ) (v : ↥V), ∃ a, v ∈ V.basicOpen (f m a)) →
      ∃ (W : Scheme.{u}) (q : W ⟶ V) (τ : C(↥W, ∀ m, Fin (r m))),
        IsAffine W ∧ WeaklyEtale q ∧ Function.Surjective q ∧
        ∀ (w : ↥W) (m : ℕ), q w ∈ V.basicOpen (f m (τ w m)) := by
    intro V _ r f hcov
    obtain ⟨P, p, π, hPaff, hpW, hpts, hidem⟩ := wc_affine_lc_cover V (∀ m, Fin (r m))
    haveI := hPaff
    haveI := hpW
    choose E hE hEb using hidem
    have hcl : ∀ (m : ℕ) (a : Fin (r m)),
        IsClopen ((fun k : (∀ m, Fin (r m)) => k m) ⁻¹' {a}) :=
      fun m a => (isClopen_discrete {a}).preimage (continuous_apply m)
    let b : (Σ m, Fin (r m)) → Γ(P, ⊤) := fun x =>
      1 - E _ (hcl x.1 x.2) + E _ (hcl x.1 x.2) * p.appTop (f x.1 x.2)
    obtain ⟨V', jV, hVaff, hjW, hrange⟩ := wc_affine_localize_basicOpens P (Set.range b)
    haveI := hjW
    have hmemP : ∀ (q : ↥P) (c : Γ(V, ⊤)), q ∈ P.basicOpen (p.appTop c) ↔ p q ∈ V.basicOpen c := by
      intro q c
      rw [← Scheme.preimage_basicOpen_top]
      rfl
    have hR : ∀ q : ↥P, q ∈ Set.range jV ↔ ∀ m, p q ∈ V.basicOpen (f m (π q m)) := by
      intro q
      rw [hrange]
      constructor
      · intro H m
        have h1 := (wc_basicOpen_one_sub_add_mul P _ _ (hE _ (hcl m (π q m))) q).mp
          (H (b ⟨m, π q m⟩) ⟨⟨m, π q m⟩, rfl⟩)
        exact (hmemP q _).mp (h1 ((hEb _ _ q).mpr (Set.mem_singleton (π q m))))
      · rintro H s ⟨⟨m, a⟩, rfl⟩
        refine (wc_basicOpen_one_sub_add_mul P _ _ (hE _ (hcl m a)) q).mpr ?_
        intro hq
        have ha : π q m = a := (hEb _ _ q).mp hq
        subst ha
        exact (hmemP q _).mpr (H m)
    refine ⟨V', jV ≫ p, ⟨fun w => π (jV w), π.continuous.comp jV.continuous⟩, hVaff,
      inferInstance, ?_, ?_⟩
    · intro v
      choose k hk using fun m => hcov m v
      obtain ⟨q, hpq, hπq⟩ := hpts v k
      obtain ⟨w, hw⟩ := (hR q).mpr (fun m => by rw [hpq, hπq]; exact hk m)
      exact ⟨w, by rw [Scheme.Hom.comp_apply, hw, hpq]⟩
    · intro w m
      have h := (hR (jV w)).mp ⟨w, rfl⟩ m
      rw [Scheme.Hom.comp_apply]
      exact h

  have e2 : ∀ (Z : Type u) [TopologicalSpace Z] [CompactSpace Z] (s : C(Z, ℚ_[ℓ])),
      ∃ (N : ℕ) (d : ℕ → C(Z, Fin ℓ)), ∀ z,
        HasSum (fun m => (ℓ : ℚ_[ℓ]) ^ m * (((d m z : ℕ)) : ℚ_[ℓ])) ((ℓ : ℚ_[ℓ]) ^ N * s z) := by
    intro Z _ _ s
    have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast hℓp.one_lt
    have hℓpos : 0 < ℓ := hℓp.pos
    have hℓR : (0 : ℝ) < ℓ := by exact_mod_cast hℓpos
    obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn s.continuous.continuousOn
    obtain ⟨N, hN⟩ := pow_unbounded_of_one_lt C hℓ1
    have hbd : ∀ z, ‖(ℓ : ℚ_[ℓ]) ^ N * s z‖ ≤ 1 := by
      intro z
      rw [norm_mul, Padic.norm_p_pow, zpow_neg, zpow_natCast]
      have h1 : ‖s z‖ ≤ C := hC z (Set.mem_univ _)
      have hpos : (0:ℝ) < (ℓ:ℝ) ^ N := pow_pos hℓR N
      calc ((ℓ:ℝ) ^ N)⁻¹ * ‖s z‖ ≤ ((ℓ:ℝ) ^ N)⁻¹ * (ℓ:ℝ) ^ N := by
            gcongr; linarith
        _ = 1 := inv_mul_cancel₀ hpos.ne'
    let a : Z → ℤ_[ℓ] := fun z => ⟨(ℓ : ℚ_[ℓ]) ^ N * s z, hbd z⟩
    let ρ : ℕ → Z → ℕ := fun n z => (PadicInt.toZModPow n (a z)).val
    have hρlt : ∀ n z, ρ n z < ℓ ^ n := by
      intro n z
      haveI : NeZero (ℓ ^ n) := ⟨pow_ne_zero n hℓpos.ne'⟩
      exact ZMod.val_lt _
    have hR1 : ∀ m n, m ≤ n → ∀ z, ρ m z = ρ n z % ℓ ^ m := by
      intro m n hmn z
      haveI : NeZero (ℓ ^ n) := ⟨pow_ne_zero n hℓpos.ne'⟩
      haveI : NeZero (ℓ ^ m) := ⟨pow_ne_zero m hℓpos.ne'⟩
      show (PadicInt.toZModPow m (a z)).val = (PadicInt.toZModPow n (a z)).val % ℓ ^ m
      rw [← PadicInt.cast_toZModPow m n hmn, ZMod.cast_eq_val, ZMod.val_natCast]
    have hR2 : ∀ n z, ‖a z - ((ρ n z : ℕ) : ℤ_[ℓ])‖ ≤ (ℓ:ℝ) ^ (-(n:ℤ)) := by
      intro n z
      haveI : NeZero (ℓ ^ n) := ⟨pow_ne_zero n hℓpos.ne'⟩
      rw [PadicInt.norm_le_pow_iff_mem_span_pow, ← PadicInt.ker_toZModPow, RingHom.mem_ker,
        map_sub, map_natCast]
      show PadicInt.toZModPow n (a z) - (((PadicInt.toZModPow n (a z)).val : ℕ) : ZMod (ℓ ^ n)) = 0
      rw [ZMod.natCast_zmod_val, sub_self]
    have hR3 : ∀ n, Continuous (ρ n) := by
      intro n
      rw [continuous_discrete_rng]
      intro k
      rw [isOpen_iff_forall_mem_open]
      intro z₀ hz₀
      let f : Z → ℚ_[ℓ] := fun z => (ℓ : ℚ_[ℓ]) ^ N * s z
      have hf : Continuous f := continuous_const.mul s.continuous
      have hr : (0 : ℝ) < (ℓ:ℝ) ^ (-(n:ℤ)) := zpow_pos hℓR _
      refine ⟨f ⁻¹' Metric.closedBall (f z₀) ((ℓ:ℝ) ^ (-(n:ℤ))), ?_, ?_, ?_⟩
      · intro z hz
        simp only [Set.mem_preimage, Metric.mem_closedBall, dist_eq_norm] at hz
        have h1 : ‖a z - a z₀‖ ≤ (ℓ:ℝ) ^ (-(n:ℤ)) := by
          rw [PadicInt.norm_def, PadicInt.coe_sub]; exact hz
        rw [PadicInt.norm_le_pow_iff_mem_span_pow, ← PadicInt.ker_toZModPow, RingHom.mem_ker,
          map_sub, sub_eq_zero] at h1
        show (PadicInt.toZModPow n (a z)).val ∈ ({k} : Set ℕ)
        rw [h1]
        exact hz₀
      · exact (IsUltrametricDist.isOpen_closedBall _ hr.ne').preimage hf
      · exact Metric.mem_closedBall_self hr.le
    let dig : ℕ → Z → Fin ℓ := fun m z => ⟨(ρ (m+1) z / ℓ ^ m) % ℓ, Nat.mod_lt _ hℓpos⟩
    have hdc : ∀ m, Continuous (dig m) := fun m =>
      (continuous_of_discreteTopology
        (f := fun k : ℕ => (⟨(k / ℓ ^ m) % ℓ, Nat.mod_lt _ hℓpos⟩ : Fin ℓ))).comp (hR3 (m+1))
    have hT : ∀ n z, ∑ j ∈ Finset.range n, ℓ ^ j * ((dig j z : Fin ℓ) : ℕ) = ρ n z := by
      intro n z
      induction n with
      | zero =>
        have := hρlt 0 z
        rw [pow_zero, Nat.lt_one_iff] at this
        rw [Finset.sum_range_zero, this]
      | succ n ih =>
        rw [Finset.sum_range_succ, ih]
        have h1 := hR1 n (n+1) (Nat.le_succ n) z
        have h2 : ρ (n+1) z % ℓ ^ (n+1) = ρ (n+1) z := Nat.mod_eq_of_lt (hρlt _ z)
        have h3 := Nat.mod_pow_succ (x := ρ (n+1) z) (b := ℓ) (k := n)
        show ρ n z + ℓ ^ n * ((ρ (n+1) z / ℓ ^ n) % ℓ) = ρ (n+1) z
        rw [h1, ← h3, h2]
    refine ⟨N, fun m => ⟨dig m, hdc m⟩, fun z => ?_⟩
    show HasSum (fun m => (ℓ : ℚ_[ℓ]) ^ m * (((dig m z : ℕ)) : ℚ_[ℓ])) ((ℓ : ℚ_[ℓ]) ^ N * s z)
    have hq1 : (ℓ:ℝ)⁻¹ < 1 := inv_lt_one_of_one_lt₀ hℓ1
    have hq0 : (0:ℝ) ≤ (ℓ:ℝ)⁻¹ := inv_nonneg.mpr hℓR.le
    have hnorm : ∀ m, ‖(ℓ : ℚ_[ℓ]) ^ m * (((dig m z : ℕ)) : ℚ_[ℓ])‖ ≤ ((ℓ:ℝ)⁻¹) ^ m := by
      intro m
      rw [norm_mul, norm_pow, Padic.norm_p]
      have : ‖(((dig m z : ℕ)) : ℚ_[ℓ])‖ ≤ 1 := by
        rw [← Int.cast_natCast]; exact Padic.norm_int_le_one _
      exact mul_le_of_le_one_right (pow_nonneg hq0 m) this
    have hsum : Summable (fun m => ‖(ℓ : ℚ_[ℓ]) ^ m * (((dig m z : ℕ)) : ℚ_[ℓ])‖) :=
      Summable.of_nonneg_of_le (fun m => norm_nonneg _) hnorm
        (summable_geometric_of_lt_one hq0 hq1)
    rw [hasSum_iff_tendsto_nat_of_summable_norm hsum]
    have hpart : ∀ n, ∑ i ∈ Finset.range n, (ℓ : ℚ_[ℓ]) ^ i * (((dig i z : ℕ)) : ℚ_[ℓ]) =
        ((ρ n z : ℕ) : ℚ_[ℓ]) := by
      intro n
      rw [← hT n z, Nat.cast_sum]
      simp only [Nat.cast_mul, Nat.cast_pow]
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero (fun n => norm_nonneg _) (fun n => ?_)
      (tendsto_pow_atTop_nhds_zero_of_lt_one hq0 hq1)
    rw [hpart]
    have h0 := hR2 n z
    rw [PadicInt.norm_def, PadicInt.coe_sub, PadicInt.coe_natCast] at h0
    rw [norm_sub_rev]
    refine h0.trans (le_of_eq ?_)
    rw [zpow_neg, zpow_natCast, inv_pow]

  have e5 : ∀ (W : Type u) [TopologicalSpace W] (D : ℕ → W → Fin ℓ), (∀ m, Continuous (D m)) →
      Continuous (fun w => ∑' m, (ℓ : ℚ_[ℓ]) ^ m * (((D m w : ℕ)) : ℚ_[ℓ])) := by
    intro W _ D hD
    have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast hℓp.one_lt
    have hℓR : (0 : ℝ) < ℓ := by linarith
    have hq1 : (ℓ:ℝ)⁻¹ < 1 := inv_lt_one_of_one_lt₀ hℓ1
    have hq0 : (0:ℝ) ≤ (ℓ:ℝ)⁻¹ := inv_nonneg.mpr hℓR.le
    refine continuous_tsum (u := fun m => ((ℓ:ℝ)⁻¹) ^ m) (fun m => ?_)
      (summable_geometric_of_lt_one hq0 hq1) (fun m w => ?_)
    · exact (continuous_of_discreteTopology
        (f := fun k : Fin ℓ => (ℓ : ℚ_[ℓ]) ^ m * ((k : ℕ) : ℚ_[ℓ]))).comp (hD m)
    · rw [norm_mul, norm_pow, Padic.norm_p]
      have : ‖(((D m w : ℕ)) : ℚ_[ℓ])‖ ≤ 1 := by
        rw [← Int.cast_natCast]; exact Padic.norm_int_le_one _
      exact mul_le_of_le_one_right (pow_nonneg hq0 m) this

  have e6 : ∀ {W U : Y.ProEt} (g : W ⟶ U),
      ((wcProEtBC i).map g).left ≫ Limits.pullback.fst U.hom i =
        Limits.pullback.fst W.hom i ≫ g.left := by
    intro W U g
    first
      | exact Limits.pullback.lift_fst _ _ _
      | (delta wcProEtBC
         simp only [MorphismProperty.Over.pullback_map_left, Limits.pullback.lift_fst])
      | (unfold wcProEtBC
         erw [MorphismProperty.Over.pullback_map_left]
         exact Limits.pullback.lift_fst _ _ _)

  haveI : IsAffine U.left := hU
  haveI : IsAffine ((𝟭 Scheme).obj U.left) := hU
  haveI : IsAffine (Limits.pullback U.hom i) :=
    (IsClosedImmersion.isAffine_surjective_of_isAffine (Limits.pullback.fst U.hom i)).1
  have hℓ0 : (ℓ : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hℓp.ne_zero
  obtain ⟨N, d, hd⟩ := e2 ↥(Limits.pullback U.hom i)
    ⟨fun z => (s z).down, Homeomorph.ulift.continuous.comp s.continuous⟩
  choose r f κ hcov hcol using fun m => e1 U.left (Limits.pullback U.hom i)
    (Limits.pullback.fst U.hom i) ℓ hℓp.pos (d m)
  obtain ⟨W', q, τ, hW'aff, hqW, hqsurj, hτ⟩ := e3 U.left r f hcov
  haveI := hqW
  let W : Y.ProEt := MorphismProperty.Over.mk ⊤ (q ≫ U.hom) (by haveI := U.prop; infer_instance)
  let g : W ⟶ U := MorphismProperty.Over.homMk q rfl trivial
  let D : ℕ → ↥W' → Fin ℓ := fun m w => κ m (τ w m)
  have hDc : ∀ m, Continuous (D m) := fun m =>
    continuous_of_discreteTopology.comp ((continuous_apply m).comp τ.continuous)
  let t : C(↥W.left, ULift.{u+1} ℚ_[ℓ]) :=
    ⟨fun w => ULift.up (((ℓ:ℚ_[ℓ]) ^ N)⁻¹ * ∑' m, (ℓ:ℚ_[ℓ]) ^ m * ((D m w : ℕ) : ℚ_[ℓ])),
      Homeomorph.ulift.symm.continuous.comp (continuous_const.mul (e5 W' D hDc))⟩
  have hpt : ∀ (w : ↥W') (z : ↥(Limits.pullback U.hom i)),
      (Limits.pullback.fst U.hom i) z = q w →
      ((ℓ:ℚ_[ℓ]) ^ N)⁻¹ * ∑' m, (ℓ:ℚ_[ℓ]) ^ m * ((D m w : ℕ) : ℚ_[ℓ]) = (s z).down := by
    intro w z hz
    have hdig : ∀ m, d m z = D m w := fun m =>
      hcol m z (τ w m) (by rw [hz]; exact hτ w m)
    have e1' : ∑' m, (ℓ:ℚ_[ℓ]) ^ m * ((D m w : ℕ) : ℚ_[ℓ]) =
        ∑' m, (ℓ:ℚ_[ℓ]) ^ m * ((d m z : ℕ) : ℚ_[ℓ]) :=
      tsum_congr (fun m => by rw [hdig m])
    rw [e1', (hd z).tsum_eq]
    exact inv_mul_cancel_left₀ (pow_ne_zero N hℓ0) _
  have key : ∀ z' : ↥(Limits.pullback W.hom i),
      (Limits.pullback.fst U.hom i) (((wcProEtBC i).map g).left z') =
        q ((Limits.pullback.fst W.hom i) z') := by
    intro z'
    calc (Limits.pullback.fst U.hom i) (((wcProEtBC i).map g).left z')
        = (((wcProEtBC i).map g).left ≫ Limits.pullback.fst U.hom i) z' :=
          (Scheme.Hom.comp_apply _ _ _).symm
      _ = (Limits.pullback.fst W.hom i ≫ g.left) z' := by rw [e6 g] <;> rfl
      _ = q ((Limits.pullback.fst W.hom i) z') := Scheme.Hom.comp_apply _ _ _
  refine ⟨W, g, t, hW'aff, ⟨hqsurj⟩, ?_⟩
  apply ContinuousMap.ext
  intro z'
  exact congrArg ULift.up
    (hpt ((Limits.pullback.fst W.hom i) z') (((wcProEtBC i).map g).left z') (key z'))

theorem wc_supp_unit_epi_of_noetherian {Z' Y' : Scheme.{u}} (i' : Z' ⟶ Y') [IsClosedImmersion i']
    [IsLocallyNoetherian Y'] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (D : wcHMPullData i' ℓ) (hD : wcHMPullCanonical D) :
    Epi (wcSuppUnitMap D) :=
by
  classical

  have : (SheafOfModules.toSheaf (wcRingSheaf Y' ℓ)).ReflectsEpimorphisms :=
    Functor.reflectsEpimorphisms_of_faithful _
  apply Functor.epi_of_epi_map (SheafOfModules.toSheaf (wcRingSheaf Y' ℓ))

  apply wc_proet_epi_of_affine_lift Y'
  intro U hU y

  obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit D
  let y' : C(↥(Limits.pullback U.hom i'), ULift.{u+1} ℚ_[ℓ]) := y

  obtain ⟨W, g, t, hW, hg, ht⟩ := wc_fibre_function_local_extension i' ℓ U hU
    (y' * c'.comp (Limits.pullback.snd U.hom i').base.hom)
  refine ⟨W, g, t, hW, hg, ?_⟩
  have key : ((wcProEtBC i').map g).left ≫ Limits.pullback.snd U.hom i' =
      Limits.pullback.snd W.hom i' := MorphismProperty.Over.w ((wcProEtBC i').map g)
  have hk : ∀ z, (Limits.pullback.snd U.hom i').base.hom (((wcProEtBC i').map g).left.base.hom z) =
      (Limits.pullback.snd W.hom i').base.hom z := fun z => by rw [← key]; rfl

  have h3 := wc_supp_hom_twist_formula D hD (wcSuppUnitMap D) W t
  change ((wcSuppUnitMap D).val.app (Opposite.op W)).hom t =
    y'.comp ((wcProEtBC i').map g).left.base.hom
  refine h3.trans (ContinuousMap.ext fun z => ?_)
  have e1 : t ((Limits.pullback.fst W.hom i').base.hom z) =
      y' (((wcProEtBC i').map g).left.base.hom z) *
        c' ((Limits.pullback.snd U.hom i').base.hom (((wcProEtBC i').map g).left.base.hom z)) :=
    congrArg (fun φ => φ z) ht
  have e2 : wcSuppTwist (wcSuppUnitMap D) ((Limits.pullback.snd W.hom i').base.hom z) *
      c' ((Limits.pullback.snd W.hom i').base.hom z) = 1 :=
    congrArg (fun φ => φ ((Limits.pullback.snd W.hom i').base.hom z)) hc'
  show t ((Limits.pullback.fst W.hom i').base.hom z) *
      wcSuppTwist (wcSuppUnitMap D) ((Limits.pullback.snd W.hom i').base.hom z) =
    y' (((wcProEtBC i').map g).left.base.hom z)
  rw [e1, hk z]
  linear_combination (y' (((wcProEtBC i').map g).left.base.hom z)) * e2

theorem wc_point_supp_unit_epi (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {Z : Scheme.{u}} (a : Z ⟶ wcXbar F X) (ha : IsIso (a ≫ wcPi2 F X))
    (Da : wcHMPullData a ℓ) (hDa : wcHMPullCanonical Da) :
    Epi (wcSuppUnitMap Da) :=
by
  haveI := ha
  haveI : IsClosedImmersion a := IsClosedImmersion.of_comp a (wcPi2 F X)
  haveI : IsLocallyNoetherian (wcXbar F X) :=
    LocallyOfFiniteType.isLocallyNoetherian (wcPi2 F X)
  exact wc_supp_unit_epi_of_noetherian a ℓ Da hDa

theorem wc_xbar_int_supp_rational (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (x₀ : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F X) (hx₀ : x₀ ≫ wcPi2 F X = 𝟙 _)
    (Dx : wcHMPullData x₀ ℓ) (hDx : wcHMPullCanonical Dx) :
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
    ∃ (rat : Abelian.Ext (wcIntSuppObj Dx) (wcIntUnit (wcXbar F X) ℓ) (2 * d) →+ wcSuppExt Dx (2 * d))
      (ratB : Abelian.Ext (wcIntUnit (wcXbar F X) ℓ) (wcIntUnit (wcXbar F X) ℓ) (2 * d) →+
        wcHM (wcXbar F X) ℓ (2 * d)),
