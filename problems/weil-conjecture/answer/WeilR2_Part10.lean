theorem wc_int_unit_pow_mono (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k : ℕ) :
    Mono ((ℓ ^ k : ℕ) • 𝟙 (wcIntUnit S ℓ)) :=
by
  have hN : (ℓ ^ k : ℕ) ≠ 0 := pow_ne_zero k (Fact.out : ℓ.Prime).ne_zero
  have hc : ((ℓ ^ k : ℕ) : ℤ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hN
  have key : ∀ {T : Type u} [TopologicalSpace T] (a b : C(T, ULift.{u+1} ℤ_[ℓ])),
      (ℓ ^ k : ℕ) • a = (ℓ ^ k : ℕ) • b → a = b := by
    intro T _ a b h
    ext t
    have h1 : (ℓ ^ k : ℕ) • (a t).down = (ℓ ^ k : ℕ) • (b t).down :=
      congrArg (fun g : C(T, ULift.{u+1} ℤ_[ℓ]) => (g t).down) h
    rw [nsmul_eq_mul, nsmul_eq_mul] at h1
    exact mul_left_cancel₀ hc h1
  apply Functor.mono_of_mono_map (SheafOfModules.forget (wcIntRingSheaf S ℓ))
  rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
  apply PresheafOfModules.mono_of_injective
  intro X x y hxy
  have e : ((ℓ ^ k : ℕ) • 𝟙 ((SheafOfModules.forget (wcIntRingSheaf S ℓ)).obj
      (wcIntUnit S ℓ))).app X = (ℓ ^ k : ℕ) • 𝟙 _ := by
    rw [← PresheafOfModules.evaluation_map, Functor.map_nsmul, PresheafOfModules.evaluation_map,
      PresheafOfModules.id_app]
    rfl
  rw [e] at hxy
  simp only [ModuleCat.hom_nsmul, ModuleCat.hom_id, LinearMap.smul_apply,
    LinearMap.id_apply] at hxy
  exact key (T := ↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop X))) x y hxy

theorem wc_int_unit_ext_free_equiv (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
