      ((A.F k').obj.map w'.op).hom (((A.φ k k' h).hom.app (Opposite.op E')).hom
        (wcEtInvRho (D.map (homOfLE h).op).left (A.F k) E E' e he x))
    exact (congrArg (fun y => ((A.φ k k' h).hom.app (Opposite.op E₁')).hom y)
      ((s2 (D.map (homOfLE h).op).left (A.F k) E₁ E w E₁' e₁ he₁ (e₁ ≫ w.left) H1 rfl x).trans
        ((hρ _ _ _ _ _ _ H1 H2 hc.symm x).trans
          (s1 (D.map (homOfLE h).op).left (A.F k) E E' E₁' w' e he (w'.left ≫ e) H2 rfl x).symm))).trans
      (NatTrans.naturality_apply (A.φ k k' h).hom w'.op
        (wcEtInvRho (D.map (homOfLE h).op).left (A.F k) E E' e he x))

theorem wc_etInvRho_univ_transport : ∀ {Z Y : Scheme.{u}} (g : Z ⟶ Y) (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), ∃ T : wcEtTransport g A ((wcEtInv g).obj A), (∀ (V : Y.Etale) (O : Z.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g) (x : A.obj.obj (Opposite.op V)), T.ρ V O h hh x = wcEtInvRho g A V O h hh x) ∧ wcEtTransportUniv T :=
by
  intro Z Y g A
  have lf : ∀ (V : Y.Etale) (O : Z.Etale) (h : O.left ⟶ V.left)
      (hh : h ≫ V.hom = O.hom ≫ g),
      (wcEtInvLift g V O h hh).left ≫ Limits.pullback.fst V.hom g = h :=
    fun V O h hh => Limits.pullback.lift_fst _ _ _
  have bcf : ∀ {V₁ V₂ : Y.Etale} (a : V₁ ⟶ V₂),
      ((wcEtBaseChange g).map a).left ≫ Limits.pullback.fst V₂.hom g =
        Limits.pullback.fst V₁.hom g ≫ a.left := by
    intro V₁ V₂ a; exact Limits.pullback.lift_fst _ _ _
  have LE : ∀ (V : Y.Etale) (O : Z.Etale) (k₁ k₂ : O ⟶ (wcEtBaseChange g).obj V),
      k₁.left ≫ Limits.pullback.fst V.hom g = k₂.left ≫ Limits.pullback.fst V.hom g →
        k₁ = k₂ := by
    intro V O k₁ k₂ hk
    apply MorphismProperty.Over.Hom.ext
    apply Limits.pullback.hom_ext hk
    exact (MorphismProperty.Over.w k₁).trans (MorphismProperty.Over.w k₂).symm

  have s1 : ∀ (V : Y.Etale) (O O' : Z.Etale) (k : O' ⟶ O) (h : O.left ⟶ V.left)
      (hh : h ≫ V.hom = O.hom ≫ g) (h' : O'.left ⟶ V.left) (hh' : h' ≫ V.hom = O'.hom ≫ g),
      k.left ≫ h = h' → ∀ x : A.obj.obj (Opposite.op V),
      (((wcEtInv g).obj A).obj.map k.op).hom (wcEtInvRho g A V O h hh x) =
        wcEtInvRho g A V O' h' hh' x := by
    intro V O O' k h hh h' hh' hk x
    have hl : k ≫ wcEtInvLift g V O h hh = wcEtInvLift g V O' h' hh' := by
      apply LE
      exact (Category.assoc k.left (wcEtInvLift g V O h hh).left
        (Limits.pullback.fst V.hom g)).trans
        (((congrArg (fun q => k.left ≫ q) (lf V O h hh)).trans hk).trans (lf V O' h' hh').symm)
    show ((sheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange g).op.lan.obj A.obj)).map
        k.op).hom
        (((toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange g).op.lan.obj A.obj)).app
          (Opposite.op O)).hom
          ((((wcEtBaseChange g).op.lan.obj A.obj).map (wcEtInvLift g V O h hh).op).hom
            ((((wcEtBaseChange g).op.lanUnit.app A.obj).app (Opposite.op V)).hom x))) =
      ((toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange g).op.lan.obj A.obj)).app
          (Opposite.op O')).hom
          ((((wcEtBaseChange g).op.lan.obj A.obj).map (wcEtInvLift g V O' h' hh').op).hom
            ((((wcEtBaseChange g).op.lanUnit.app A.obj).app (Opposite.op V)).hom x))
    rw [← NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology Z)
      ((wcEtBaseChange g).op.lan.obj A.obj)) k.op, ← hl, op_comp, CategoryTheory.Functor.map_comp]
    rfl

  have s2 : ∀ (V₁ V₂ : Y.Etale) (a : V₁ ⟶ V₂) (O : Z.Etale) (h : O.left ⟶ V₁.left)
      (hh : h ≫ V₁.hom = O.hom ≫ g) (h' : O.left ⟶ V₂.left) (hh' : h' ≫ V₂.hom = O.hom ≫ g),
      h ≫ a.left = h' → ∀ x : A.obj.obj (Opposite.op V₂),
      wcEtInvRho g A V₁ O h hh ((A.obj.map a.op).hom x) = wcEtInvRho g A V₂ O h' hh' x := by
    intro V₁ V₂ a O h hh h' hh' ha x
    have hl : wcEtInvLift g V₁ O h hh ≫ (wcEtBaseChange g).map a =
        wcEtInvLift g V₂ O h' hh' := by
      apply LE
      exact (Category.assoc (wcEtInvLift g V₁ O h hh).left ((wcEtBaseChange g).map a).left
        (Limits.pullback.fst V₂.hom g)).trans
        ((congrArg (fun q => (wcEtInvLift g V₁ O h hh).left ≫ q) (bcf a)).trans
        (((Category.assoc _ _ _).symm.trans (congrArg (· ≫ a.left) (lf V₁ O h hh))).trans
          (ha.trans (lf V₂ O h' hh').symm)))
    show ((toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange g).op.lan.obj A.obj)).app
          (Opposite.op O)).hom
          ((((wcEtBaseChange g).op.lan.obj A.obj).map (wcEtInvLift g V₁ O h hh).op).hom
            ((((wcEtBaseChange g).op.lanUnit.app A.obj).app (Opposite.op V₁)).hom
              ((A.obj.map a.op).hom x))) =
      ((toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange g).op.lan.obj A.obj)).app
          (Opposite.op O)).hom
          ((((wcEtBaseChange g).op.lan.obj A.obj).map (wcEtInvLift g V₂ O h' hh').op).hom
            ((((wcEtBaseChange g).op.lanUnit.app A.obj).app (Opposite.op V₂)).hom x))
    refine (congrArg (fun v => ((toSheafify (Scheme.smallEtaleTopology Z)
      ((wcEtBaseChange g).op.lan.obj A.obj)).app (Opposite.op O)).hom
        ((((wcEtBaseChange g).op.lan.obj A.obj).map (wcEtInvLift g V₁ O h hh).op).hom v))
      (NatTrans.naturality_apply ((wcEtBaseChange g).op.lanUnit.app A.obj) a.op x)).trans ?_
    rw [← hl, op_comp, CategoryTheory.Functor.map_comp]
    rfl

  have hnat : ∀ (V V' : Y.Etale) (c : V' ⟶ V) (O O' : Z.Etale) (d : O' ⟶ O)
      (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g)
      (h' : O'.left ⟶ V'.left) (hh' : h' ≫ V'.hom = O'.hom ≫ g),
      h' ≫ c.left = d.left ≫ h → ∀ x : A.obj.obj (Opposite.op V),
        wcEtInvRho g A V' O' h' hh' (A.obj.map c.op x) =
          ((wcEtInv g).obj A).obj.map d.op (wcEtInvRho g A V O h hh x) := by
    intro V V' c O O' d h hh h' hh' hc x
    have hh2 : (d.left ≫ h) ≫ V.hom = O'.hom ≫ g := by
      rw [Category.assoc, hh, ← Category.assoc, MorphismProperty.Over.w d]
    exact (s2 V' V c O' h' hh' (d.left ≫ h) hh2 hc x).trans
      (s1 V O O' d h hh (d.left ≫ h) hh2 rfl x).symm

  have gen : ∀ (V : Y.Etale) (x : A.obj.obj (Opposite.op V)),
      wcEtInvRho g A V ((wcEtBaseChange g).obj V) (Limits.pullback.fst V.hom g)
          Limits.pullback.condition x =
        ((toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange g).op.lan.obj A.obj)).app
          (Opposite.op ((wcEtBaseChange g).obj V))).hom
            ((((wcEtBaseChange g).op.lanUnit.app A.obj).app (Opposite.op V)).hom x) := by
    intro V x
    have hlift : wcEtInvLift g V ((wcEtBaseChange g).obj V) (Limits.pullback.fst V.hom g)
        Limits.pullback.condition = 𝟙 _ := by
      apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.lift_fst_snd _ _
    show ((toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange g).op.lan.obj A.obj)).app
          (Opposite.op ((wcEtBaseChange g).obj V))).hom
          ((((wcEtBaseChange g).op.lan.obj A.obj).map (wcEtInvLift g V ((wcEtBaseChange g).obj V)
            (Limits.pullback.fst V.hom g) Limits.pullback.condition).op).hom
            ((((wcEtBaseChange g).op.lanUnit.app A.obj).app (Opposite.op V)).hom x)) = _
    rw [hlift, op_id, CategoryTheory.Functor.map_id]
    rfl
  refine ⟨⟨fun V O h hh => wcEtInvRho g A V O h hh, hnat⟩, fun _ _ _ _ _ => rfl, ?_⟩
  intro G' T'

  obtain ⟨η, hη⟩ : ∃ η : A.obj ⟶ (wcEtBaseChange g).op ⋙ G'.obj,
      ∀ (V : Y.Etale) (x : A.obj.obj (Opposite.op V)),
        (η.app (Opposite.op V)).hom x = T'.ρ V ((wcEtBaseChange g).obj V)
          (Limits.pullback.fst V.hom g) Limits.pullback.condition x := by
    refine ⟨{ app := fun V => AddCommGrpCat.ofHom (T'.ρ V.unop ((wcEtBaseChange g).obj V.unop)
                (Limits.pullback.fst V.unop.hom g) Limits.pullback.condition)
              naturality := ?_ }, fun V x => rfl⟩
    intro V₁ V₂ f
    ext x
    exact T'.nat V₁.unop V₂.unop f.unop ((wcEtBaseChange g).obj V₁.unop)
      ((wcEtBaseChange g).obj V₂.unop) ((wcEtBaseChange g).map f.unop)
      (Limits.pullback.fst V₁.unop.hom g) Limits.pullback.condition
      (Limits.pullback.fst V₂.unop.hom g) Limits.pullback.condition (bcf f.unop).symm x

  obtain ⟨ψ, hψ⟩ : ∃ ψ : (wcEtBaseChange g).op.lan.obj A.obj ⟶ G'.obj,
      ∀ (V : Y.Etale) (x : A.obj.obj (Opposite.op V)),
        (ψ.app (Opposite.op ((wcEtBaseChange g).obj V))).hom
          ((((wcEtBaseChange g).op.lanUnit.app A.obj).app (Opposite.op V)).hom x) =
            (η.app (Opposite.op V)).hom x := by
    refine ⟨((wcEtBaseChange g).op.lan.obj A.obj).descOfIsLeftKanExtension
      ((wcEtBaseChange g).op.lanUnit.app A.obj) G'.obj η, fun V x => ?_⟩
    have e := Functor.descOfIsLeftKanExtension_fac_app ((wcEtBaseChange g).op.lan.obj A.obj)
      ((wcEtBaseChange g).op.lanUnit.app A.obj) G'.obj η (Opposite.op V)
    exact congrArg (fun t => t.hom x) e

  obtain ⟨φ, hφ⟩ : ∃ φ : (wcEtInv g).obj A ⟶ G',
      toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange g).op.lan.obj A.obj) ≫ φ.hom =
        ψ :=
    ⟨ObjectProperty.homMk (sheafifyLift (Scheme.smallEtaleTopology Z) ψ G'.property),
      toSheafify_sheafifyLift _ _ _⟩
  have hex : ∀ (V : Y.Etale) (O : Z.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g)
      (x : A.obj.obj (Opposite.op V)),
      (φ.hom.app (Opposite.op O)).hom (wcEtInvRho g A V O h hh x) = T'.ρ V O h hh x := by
    intro V O h hh x
    have e1 := congrArg (fun t => (t.app (Opposite.op O)).hom
      ((((wcEtBaseChange g).op.lan.obj A.obj).map (wcEtInvLift g V O h hh).op).hom
        ((((wcEtBaseChange g).op.lanUnit.app A.obj).app (Opposite.op V)).hom x))) hφ
    have e2 := NatTrans.naturality_apply ψ (wcEtInvLift g V O h hh).op
      ((((wcEtBaseChange g).op.lanUnit.app A.obj).app (Opposite.op V)).hom x)
    have e3 := T'.nat V V (𝟙 V) ((wcEtBaseChange g).obj V) O (wcEtInvLift g V O h hh)
      (Limits.pullback.fst V.hom g) Limits.pullback.condition h hh
      ((Category.comp_id h).trans (lf V O h hh).symm) x
    have e4 : A.obj.map (𝟙 V).op x = x := by simp
    calc (φ.hom.app (Opposite.op O)).hom (wcEtInvRho g A V O h hh x)
        = (ψ.app (Opposite.op O)).hom
            ((((wcEtBaseChange g).op.lan.obj A.obj).map (wcEtInvLift g V O h hh).op).hom
              ((((wcEtBaseChange g).op.lanUnit.app A.obj).app (Opposite.op V)).hom x)) := e1
      _ = (G'.obj.map (wcEtInvLift g V O h hh).op).hom
            ((ψ.app (Opposite.op ((wcEtBaseChange g).obj V))).hom
              ((((wcEtBaseChange g).op.lanUnit.app A.obj).app (Opposite.op V)).hom x)) := e2
      _ = (G'.obj.map (wcEtInvLift g V O h hh).op).hom
            (T'.ρ V ((wcEtBaseChange g).obj V) (Limits.pullback.fst V.hom g)
              Limits.pullback.condition x) := by
          rw [hψ V x, hη V x]
      _ = T'.ρ V O h hh (A.obj.map (𝟙 V).op x) := e3.symm
      _ = T'.ρ V O h hh x := by rw [e4]
  refine ⟨φ, hex, fun φ' hφ' => ?_⟩
  have key : toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange g).op.lan.obj A.obj) ≫
        φ'.hom =
      toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange g).op.lan.obj A.obj) ≫ φ.hom := by
    apply ((wcEtBaseChange g).op.lan.obj A.obj).hom_ext_of_isLeftKanExtension
      ((wcEtBaseChange g).op.lanUnit.app A.obj)
    ext V x
    have e : (φ'.hom.app (Opposite.op ((wcEtBaseChange g).obj V.unop))).hom
          (((toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange g).op.lan.obj A.obj)).app
          (Opposite.op ((wcEtBaseChange g).obj V.unop))).hom
            ((((wcEtBaseChange g).op.lanUnit.app A.obj).app (Opposite.op V.unop)).hom x)) =
        (φ.hom.app (Opposite.op ((wcEtBaseChange g).obj V.unop))).hom
          (((toSheafify (Scheme.smallEtaleTopology Z) ((wcEtBaseChange g).op.lan.obj A.obj)).app
          (Opposite.op ((wcEtBaseChange g).obj V.unop))).hom
            ((((wcEtBaseChange g).op.lanUnit.app A.obj).app (Opposite.op V.unop)).hom x)) := by
      rw [← gen]
      exact (hφ' V.unop ((wcEtBaseChange g).obj V.unop) (Limits.pullback.fst V.unop.hom g)
        Limits.pullback.condition x).trans
        (hex V.unop ((wcEtBaseChange g).obj V.unop) (Limits.pullback.fst V.unop.hom g)
          Limits.pullback.condition x).symm
    exact e
  exact Sheaf.hom_ext
    (sheafify_hom_ext (Scheme.smallEtaleTopology Z) φ'.hom φ.hom G'.property key)

theorem wc_desc_tower_eventually_in_open : ∀ (O : Scheme.{u}) (E : ℕ → Scheme.{u}) (π : ∀ j, O ⟶ E j) (e : ∀ j j' : ℕ, j ≤ j' → (E j' ⟶ E j)), (∀ j j' (h : j ≤ j'), π j' ≫ e j j' h = π j) → (∀ j j' j'' (h₁ : j ≤ j') (h₂ : j' ≤ j''), e j' j'' h₂ ≫ e j j' h₁ = e j j'' (h₁.trans h₂)) → (∀ (T : Scheme.{u}) (z : ∀ j, T ⟶ E j), (∀ j j' (h : j ≤ j'), z j' ≫ e j j' h = z j) → ∃! z₀ : T ⟶ O, ∀ j, z₀ ≫ π j = z j) → (∀ j j' (h : j ≤ j'), IsAffineHom (e j j' h)) → ∀ (j₀ : ℕ) (T : Scheme.{u}) (τ : T ⟶ E j₀), CompactSpace T → ∀ (W : Set T), IsOpen W → (∀ (y : T) (p : O), τ y = π j₀ p → y ∈ W) → ∃ (j' : ℕ) (h : j₀ ≤ j'), ∀ (y : T) (q : E j'), τ y = e j₀ j' h q → y ∈ W :=
by


  have s0 : ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ Scheme.{u}) (P : Scheme.{u}) (π : ∀ l, P ⟶ D.obj l), (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ D.map t = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ D.obj l), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ D.map t = z l') → ∃! z₀ : T ⟶ P, ∀ l, z₀ ≫ π l = z l) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t)) → ∀ (l : Λ) (T : Scheme.{u}) (τ : T ⟶ D.obj l), CompactSpace T → ∀ (O : Set T), IsOpen O → (∀ (y : T) (p : P), τ y = π l p → y ∈ O) → ∃ (l' : Λ) (t : l' ⟶ l), ∀ (y : T) (q : D.obj l'), τ y = D.map t q → y ∈ O := by
    intro Λ _ _ D P π hπ hlim haff l T τ hT O hO hOP
    let cP : Limits.Cone D := ⟨P, { app := π, naturality := fun k k' t => by simp [hπ t] }⟩
    have hL : Limits.IsLimit cP :=
      Limits.IsLimit.ofExistsUnique (fun s => hlim s.pt s.π.app (fun t => s.w t))
    have hW : Limits.IsLimit (cP.whisker (Over.forget l)) :=
      (Functor.Initial.isLimitWhiskerEquiv (Over.forget l) cP).symm hL
    have hres : ∀ (W : Scheme.{u}) (a : ∀ j : Over l, W ⟶ D.obj j.left),
        (∀ {j j' : Over l} (g : j ⟶ j'), a j ≫ D.map g.left = a j') →
        ∃! z₀ : W ⟶ P, ∀ j : Over l, z₀ ≫ π j.left = a j := by
      intro W a ha
      let sa : Limits.Cone (Over.forget l ⋙ D) :=
        ⟨W, { app := a, naturality := fun j j' g => by simp [ha g] }⟩
      exact hW.existsUnique sa
    let E : Over l ⥤ Scheme.{u} := Over.post D ⋙ Over.pullback τ ⋙ Over.forget T
    let i₀ : Over l := Over.mk (𝟙 l)
    let fst : ∀ j : Over l, E.obj j ⟶ D.obj j.left := fun j => Limits.pullback.fst (D.map j.hom) τ
    let snd : ∀ j : Over l, E.obj j ⟶ T := fun j => Limits.pullback.snd (D.map j.hom) τ
    have hcondE : ∀ j : Over l, fst j ≫ D.map j.hom = snd j ≫ τ := fun j =>
      Limits.pullback.condition
    have ext : ∀ (j : Over l) {W : Scheme.{u}} (u v : W ⟶ E.obj j), u ≫ fst j = v ≫ fst j →
        u ≫ snd j = v ≫ snd j → u = v := fun j W u v h1 h2 => Limits.pullback.hom_ext h1 h2
    have F1 : ∀ {j j' : Over l} (g : j ⟶ j'), E.map g ≫ fst j' = fst j ≫ D.map g.left := by
      intro j j' g
      have h := Over.pullback_map_left τ ((Over.post D).obj j) (k := (Over.post D).map g)
      refine (congrArg (· ≫ fst j') h).trans ?_
      exact Limits.pullback.lift_fst _ _ _
    have F2 : ∀ {j j' : Over l} (g : j ⟶ j'), E.map g ≫ snd j' = snd j := by
      intro j j' g
      exact Over.w ((Over.pullback τ).map ((Over.post D).map g))
    have hleg : ∀ j : Over l, (Limits.pullback.fst (π l) τ ≫ π j.left) ≫ D.map j.hom =
        Limits.pullback.snd (π l) τ ≫ τ := by
      intro j
      rw [Category.assoc, hπ j.hom]
      exact Limits.pullback.condition
    let leg : ∀ j : Over l, Limits.pullback (π l) τ ⟶ E.obj j := fun j =>
      Limits.pullback.lift (Limits.pullback.fst (π l) τ ≫ π j.left) (Limits.pullback.snd (π l) τ)
        (hleg j)
    have leg_fst : ∀ j : Over l, leg j ≫ fst j = Limits.pullback.fst (π l) τ ≫ π j.left :=
      fun j => Limits.pullback.lift_fst _ _ _
    have leg_snd : ∀ j : Over l, leg j ≫ snd j = Limits.pullback.snd (π l) τ :=
      fun j => Limits.pullback.lift_snd _ _ _
    have hnat : ∀ {j j' : Over l} (g : j ⟶ j'), leg j ≫ E.map g = leg j' := by
      intro j j' g
      apply ext j'
      · rw [Category.assoc, F1 g, ← Category.assoc, leg_fst, leg_fst, Category.assoc, hπ g.left]
      · rw [Category.assoc, F2 g, leg_snd, leg_snd]
    let c : Limits.Cone E := ⟨Limits.pullback (π l) τ,
      { app := leg, naturality := fun j j' g => by
          simp only [Functor.const_obj_map]
          exact ((Category.id_comp _).trans (hnat g).symm) }⟩
    have hc : Limits.IsLimit c := by
      refine Limits.IsLimit.ofExistsUnique (fun s => ?_)
      let a : ∀ j : Over l, s.pt ⟶ D.obj j.left := fun j => s.π.app j ≫ fst j
      have ha : ∀ {j j' : Over l} (g : j ⟶ j'), a j ≫ D.map g.left = a j' := by
        intro j j' g
        show (s.π.app j ≫ fst j) ≫ D.map g.left = s.π.app j' ≫ fst j'
        rw [Category.assoc, ← F1 g, ← Category.assoc, s.w g]
      obtain ⟨z₀, hz₀, hz₀u⟩ := hres s.pt a ha
      let b : s.pt ⟶ T := s.π.app i₀ ≫ snd i₀
      have hb : ∀ j : Over l, s.π.app j ≫ snd j = b := by
        intro j
        have g : j ⟶ i₀ := Over.homMk j.hom (by simp [i₀])
        show s.π.app j ≫ snd j = s.π.app i₀ ≫ snd i₀
        rw [← s.w g, Category.assoc, F2 g]
      have hcond : z₀ ≫ π l = b ≫ τ := by
        have h1 : z₀ ≫ π l = s.π.app i₀ ≫ fst i₀ := hz₀ i₀
        have h2 : fst i₀ ≫ D.map i₀.hom = snd i₀ ≫ τ := hcondE i₀
        have h3 : D.map i₀.hom = 𝟙 (D.obj l) := D.map_id l
        rw [h3] at h2
        have h4 : fst i₀ = snd i₀ ≫ τ := (Category.comp_id (fst i₀)).symm.trans h2
        show z₀ ≫ π l = (s.π.app i₀ ≫ snd i₀) ≫ τ
        rw [h1, Category.assoc, ← h4]
      refine ⟨Limits.pullback.lift z₀ b hcond, fun j => ?_, fun m hm => ?_⟩
      · change Limits.pullback.lift z₀ b hcond ≫ leg j = s.π.app j
        apply ext j
        · rw [Category.assoc, leg_fst, ← Category.assoc, Limits.pullback.lift_fst]
          exact hz₀ j
        · rw [Category.assoc, leg_snd, Limits.pullback.lift_snd, hb j]
      · have hm' : ∀ j, m ≫ leg j = s.π.app j := hm
        have e1 : m ≫ Limits.pullback.fst (π l) τ = z₀ := by
          apply hz₀u
          intro j
          rw [Category.assoc, ← leg_fst j, ← Category.assoc, hm' j]
        have e2 : m ≫ Limits.pullback.snd (π l) τ = b := by
          rw [← leg_snd i₀, ← Category.assoc, hm' i₀]
        refine Limits.pullback.hom_ext (f := π l) (g := τ) ?_ ?_
        · rw [e1, Limits.pullback.lift_fst]
        · rw [e2, Limits.pullback.lift_snd]
    have hsndAff : ∀ i : Over l, IsAffineHom (snd i) := fun i =>
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasPullback (D.map i.hom) τ) (haff i.hom)
    have hEaff : ∀ {i j : Over l} (f : i ⟶ j), IsAffineHom (E.map f) := by
      intro i j f
      have big : IsPullback (E.map f ≫ snd j) (fst i) τ (D.map f.left ≫ D.map j.hom) := by
        rw [F2 f, ← D.map_comp, Over.w f]
        exact (IsPullback.of_hasPullback (D.map i.hom) τ).flip
      have right : IsPullback (snd j) (fst j) τ (D.map j.hom) :=
        (IsPullback.of_hasPullback (D.map j.hom) τ).flip
      have sq := IsPullback.of_right big (F1 f) right
      exact MorphismProperty.of_isPullback (P := @IsAffineHom) sq.flip (haff f.left)
    have hEcpt : ∀ i : Over l, CompactSpace (E.obj i) := fun i => by
      have := hsndAff i
      have hqc : QuasiCompact (snd i) := inferInstance
      exact @QuasiCompact.compactSpace_of_compactSpace _ _ (snd i) hqc hT
    let U : (E.obj i₀).Opens := ⟨(snd i₀) ⁻¹' O, hO.preimage (snd i₀).continuous⟩
    have htop : c.π.app i₀ ⁻¹ᵁ U = ⊤ := by
      rw [eq_top_iff]
      intro x _
      change snd i₀ (leg i₀ x) ∈ O
      have e : snd i₀ (leg i₀ x) = Limits.pullback.snd (π l) τ x := by
        rw [← Scheme.Hom.comp_apply, leg_snd i₀]
      have e2 : τ (Limits.pullback.snd (π l) τ x) = π l (Limits.pullback.fst (π l) τ x) := by
        rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
      apply hOP _ (Limits.pullback.fst (π l) τ x)
      rw [e, e2]
    obtain ⟨j, fji, hj⟩ := @exists_map_eq_top (Over l) _ E c hc _ (fun f => hEaff f) hEcpt i₀ U htop
    refine ⟨j.left, j.hom, fun y q hyq => ?_⟩
    obtain ⟨z, hz1, hz2⟩ :=
      Scheme.Pullback.exists_preimage_pullback (f := D.map j.hom) (g := τ) q y hyq.symm
    have hzU : ∀ w : E.obj j, w ∈ E.map fji ⁻¹ᵁ U := by
      rw [hj]; intro w; trivial
    have hw : snd i₀ (E.map fji z) ∈ O := hzU z
    have e : snd i₀ (E.map fji z) = y :=
      (Scheme.Hom.comp_apply (E.map fji) (snd i₀) z).symm.trans
        ((congrArg (fun k : E.obj j ⟶ T => k z) (F2 fji)).trans hz2)
    rw [← e]
    exact hw
  intro O E π e hπe hee hlimE haffE j₀ T τ hT W hW hWP
  let g : ∀ n, E (n + 1) ⟶ E n := fun n => e n (n + 1) (Nat.le_succ n)
  have hsub : ∀ {a b : ℕᵒᵖ} (t t' : a ⟶ b), t = t' := fun t t' =>
    Quiver.Hom.unop_inj (Subsingleton.elim _ _)

  have s1 : ∀ (Y : Scheme.{u}) (z : ∀ j, Y ⟶ E j),
      (∀ n, z (n + 1) ≫ e n (n + 1) (Nat.le_succ n) = z n) →
      ∀ (j j' : ℕ) (h : j ≤ j'), z j' ≫ e j j' h = z j := by
    intro Y z hz
    have S : ∀ n m (hm : m < n), z n ≫ e m n hm.le = z m := by
      intro n
      induction n with
      | zero => intro m hm; exact absurd hm (Nat.not_lt_zero _)
      | succ n ih =>
        intro m hm
        rcases Nat.lt_or_ge m n with hlt | hge
        · rw [← hee m n (n + 1) hlt.le (Nat.le_succ n), ← Category.assoc]
          exact (congrArg (· ≫ e m n hlt.le) (hz n)).trans (ih m hlt)
        · obtain rfl : m = n := by omega
          exact hz m
    intro j j' h
    have h1 : z j' ≫ e j j' h = z (j' + 1) ≫ (e j' (j' + 1) (Nat.le_succ j') ≫ e j j' h) := by
      rw [← Category.assoc, hz j']
    rw [h1, hee j j' (j' + 1) h (Nat.le_succ j')]
    exact S (j' + 1) j (Nat.lt_succ_of_le h)

  have s2 : ∀ (n m : ℕ) (h : m < n) (t : (Opposite.op n : ℕᵒᵖ) ⟶ Opposite.op m),
      (Functor.ofOpSequence g).map t = e m n h.le := by
    intro n
    induction n with
    | zero => intro m h; exact absurd h (Nat.not_lt_zero _)
    | succ n ih =>
      intro m h t
      rcases Nat.lt_or_ge m n with hlt | hge
      · have ht : t = (homOfLE (Nat.le_succ n)).op ≫ (homOfLE hlt.le).op := hsub _ _
        rw [ht, Functor.map_comp, Functor.ofOpSequence_map_homOfLE_succ, ih m hlt]
        exact hee m n (n + 1) hlt.le (Nat.le_succ n)
      · obtain rfl : m = n := by omega
        have ht : t = (homOfLE (Nat.le_succ m)).op := hsub _ _
        rw [ht, Functor.ofOpSequence_map_homOfLE_succ]

  have Acase : ∀ (a b : ℕ) (t : (Opposite.op a : ℕᵒᵖ) ⟶ Opposite.op b)
      (P : ∀ (a b : ℕ), (E a ⟶ E b) → Prop), (∀ a, P a a (𝟙 _)) →
      (∀ a b (h : b < a), P a b (e b a h.le)) → P a b ((Functor.ofOpSequence g).map t) := by
    intro a b t P hid hlt
    have hle : b ≤ a := leOfHom t.unop
    rcases Nat.lt_or_ge b a with h | h
    · rw [s2 a b h t]
      exact hlt a b h
    · obtain rfl : b = a := le_antisymm hle h
      have ht : t = 𝟙 _ := hsub _ _
      subst ht
      rw [CategoryTheory.Functor.map_id]
      exact hid _
  have A1 : ∀ (a b : ℕ) (t : (Opposite.op a : ℕᵒᵖ) ⟶ Opposite.op b),
      IsAffineHom ((Functor.ofOpSequence g).map t) := fun a b t =>
    Acase a b t (fun a b f => IsAffineHom f) (fun a => (inferInstance : IsAffineHom (𝟙 (E a))))
      (fun a b h => haffE b a h.le)
  have A2 : ∀ (a b : ℕ) (t : (Opposite.op a : ℕᵒᵖ) ⟶ Opposite.op b),
      π a ≫ (Functor.ofOpSequence g).map t = π b := fun a b t =>
    Acase a b t (fun a b f => π a ≫ f = π b) (fun a => Category.comp_id _)
      (fun a b h => hπe b a h.le)
  have A3 : ∀ (a b : ℕ) (t : (Opposite.op a : ℕᵒᵖ) ⟶ Opposite.op b) (h : b ≤ a + 1),
      e a (a + 1) (Nat.le_succ a) ≫ (Functor.ofOpSequence g).map t = e b (a + 1) h :=
    fun a b t => Acase a b t
      (fun a b f => ∀ h : b ≤ a + 1, e a (a + 1) (Nat.le_succ a) ≫ f = e b (a + 1) h)
      (fun a _ => Category.comp_id _) (fun a b hb _ => hee b a (a + 1) hb.le (Nat.le_succ a))

  have hπ' : ∀ {l l' : AsSmall.{u} ℕᵒᵖ} (t : l ⟶ l'),
      π (AsSmall.down.obj l).unop ≫ (AsSmall.down ⋙ Functor.ofOpSequence g).map t =
        π (AsSmall.down.obj l').unop := fun {l l'} t =>
    A2 (AsSmall.down.obj l).unop (AsSmall.down.obj l').unop (AsSmall.down.map t)
  have haff' : ∀ {l l' : AsSmall.{u} ℕᵒᵖ} (t : l ⟶ l'),
      IsAffineHom ((AsSmall.down ⋙ Functor.ofOpSequence g).map t) := fun {l l'} t =>
    A1 (AsSmall.down.obj l).unop (AsSmall.down.obj l').unop (AsSmall.down.map t)
  have hlim' : ∀ (T' : Scheme.{u}) (z : ∀ l, T' ⟶ (AsSmall.down ⋙ Functor.ofOpSequence g).obj l),
      (∀ {l l' : AsSmall.{u} ℕᵒᵖ} (t : l ⟶ l'),
        z l ≫ (AsSmall.down ⋙ Functor.ofOpSequence g).map t = z l') →
      ∃! z₀ : T' ⟶ O, ∀ l, z₀ ≫ π (AsSmall.down.obj l).unop = z l := by
    intro T' z hz
    let zj : ∀ j, T' ⟶ E j := fun j => z (AsSmall.up.obj (Opposite.op j))
    have hsucc : ∀ n, zj (n + 1) ≫ e n (n + 1) (Nat.le_succ n) = zj n := by
      intro n
      have h1 := hz (AsSmall.up.map (homOfLE (Nat.le_succ n)).op)
      have h2 : (AsSmall.down ⋙ Functor.ofOpSequence g).map
          (AsSmall.up.map (homOfLE (Nat.le_succ n)).op) = e n (n + 1) (Nat.le_succ n) :=
        Functor.ofOpSequence_map_homOfLE_succ g n
      rw [h2] at h1
      exact h1
    obtain ⟨z₀, hz₀, huniq⟩ := hlimE T' zj (s1 T' zj hsucc)
    refine ⟨z₀, fun l => ?_, fun z₁ hz₁ => huniq z₁ (fun j => hz₁ (AsSmall.up.obj (Opposite.op j)))⟩
    obtain ⟨⟨n⟩⟩ := l
    exact hz₀ n

  obtain ⟨l', t, ht⟩ := s0 (AsSmall.{u} ℕᵒᵖ) (AsSmall.down ⋙ Functor.ofOpSequence g) O
    (fun l => π (AsSmall.down.obj l).unop) hπ' hlim' haff' (AsSmall.up.obj (Opposite.op j₀)) T τ hT
    W hW hWP
  obtain ⟨⟨n⟩⟩ := l'
  have hle : j₀ ≤ n := leOfHom (AsSmall.down.map t).unop
  refine ⟨n + 1, by omega, fun y q hyq => ht y (e n (n + 1) (Nat.le_succ n) q) ?_⟩
  have key := A3 n j₀ (AsSmall.down.map t) (by omega)
  have hc := (Scheme.Hom.comp_apply (e n (n + 1) (Nat.le_succ n))
    ((Functor.ofOpSequence g).map (AsSmall.down.map t)) q).symm.trans
    (congrArg (fun k => k q) key)
  exact hyq.trans hc.symm

theorem wc_etInvRho_eq_zero_of_locally_zero : ∀ {Z Y : Scheme.{u}} (g : Z ⟶ Y) (H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale) (O : Z.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g) (z : H.obj.obj (Opposite.op V)), (∀ q : O.left, ∃ (V₁ : Y.Etale) (c : V₁ ⟶ V) (v₁ : V₁.left), c.left v₁ = h q ∧ H.obj.map c.op z = 0) → wcEtInvRho g H V O h hh z = 0 :=
by
  intro Z Y g H V O h hh z hloc
  classical

  have hnat : ∀ (V₁ : Y.Etale) (c : V₁ ⟶ V) (O₁ : Z.Etale) (d : O₁ ⟶ O)
      (k : O₁.left ⟶ V₁.left) (hk : k ≫ V₁.hom = O₁.hom ≫ g), k ≫ c.left = d.left ≫ h →
      wcEtInvRho g H V₁ O₁ k hk (H.obj.map c.op z) =
        ((wcEtInv g).obj H).obj.map d.op (wcEtInvRho g H V O h hh z) := by
    intro V₁ c O₁ d k hk hcomm
    have hfst : ((wcEtBaseChange g).map c).left ≫ Limits.pullback.fst V.hom g =
        Limits.pullback.fst V₁.hom g ≫ c.left := (wcEtBaseChangeFst g).naturality c
    have hsnd : ((wcEtBaseChange g).map c).left ≫ Limits.pullback.snd V.hom g =
        Limits.pullback.snd V₁.hom g := MorphismProperty.Over.w ((wcEtBaseChange g).map c)
    have hkey : wcEtInvLift g V₁ O₁ k hk ≫ (wcEtBaseChange g).map c =
        d ≫ wcEtInvLift g V O h hh := by
      apply MorphismProperty.Over.Hom.ext
      show Limits.pullback.lift k O₁.hom hk ≫ ((wcEtBaseChange g).map c).left =
        d.left ≫ Limits.pullback.lift h O.hom hh
      refine Limits.pullback.hom_ext (f := V.hom) (g := g) ?_ ?_
      · exact (Category.assoc _ _ _).trans
          ((congrArg (fun t => Limits.pullback.lift k O₁.hom hk ≫ t) hfst).trans
          ((Category.assoc _ _ _).symm.trans
          ((congrArg (fun t => t ≫ c.left) (Limits.pullback.lift_fst k O₁.hom hk)).trans
          (hcomm.trans
          ((congrArg (fun t => d.left ≫ t) (Limits.pullback.lift_fst h O.hom hh)).symm.trans
          (Category.assoc _ _ _).symm)))))
      · exact (Category.assoc _ _ _).trans
          ((congrArg (fun t => Limits.pullback.lift k O₁.hom hk ≫ t) hsnd).trans
          ((Limits.pullback.lift_snd k O₁.hom hk).trans
          ((MorphismProperty.Over.w d).symm.trans
          ((congrArg (fun t => d.left ≫ t) (Limits.pullback.lift_snd h O.hom hh)).symm.trans
          (Category.assoc _ _ _).symm))))
    let τ := Scheme.smallEtaleTopology Z
    let L := (wcEtBaseChange g).op.lan.obj H.obj
    let η := (wcEtBaseChange g).op.lanUnit.app H.obj
    have e1 : H.obj.map c.op ≫ η.app (Opposite.op V₁) =
        η.app (Opposite.op V) ≫ L.map ((wcEtBaseChange g).map c).op :=
      η.naturality c.op
    have e2 : L.map ((wcEtBaseChange g).map c).op ≫ L.map (wcEtInvLift g V₁ O₁ k hk).op =
        L.map (wcEtInvLift g V O h hh).op ≫ L.map d.op := by
      rw [← Functor.map_comp, ← Functor.map_comp, ← op_comp, ← op_comp, hkey]
    have e3 : L.map d.op ≫ (toSheafify τ L).app (Opposite.op O₁) =
        (toSheafify τ L).app (Opposite.op O) ≫ (sheafify τ L).map d.op :=
      (toSheafify τ L).naturality d.op
    have key : H.obj.map c.op ≫ (η.app (Opposite.op V₁) ≫ L.map (wcEtInvLift g V₁ O₁ k hk).op ≫
        (toSheafify τ L).app (Opposite.op O₁)) =
        (η.app (Opposite.op V) ≫ L.map (wcEtInvLift g V O h hh).op ≫
          (toSheafify τ L).app (Opposite.op O)) ≫ (sheafify τ L).map d.op := by
      simp only [Category.assoc]
      rw [reassoc_of% e1, reassoc_of% e2]
      exact congrArg (fun t => η.app (Opposite.op V) ≫ L.map (wcEtInvLift g V O h hh).op ≫ t) e3
    exact congrArg (fun f => f.hom z) key

  have hnbhd : ∀ (V₁ : Y.Etale) (c : V₁ ⟶ V) (q : O.left) (v₁ : V₁.left), c.left v₁ = h q →
      ∃ (O₁ : Z.Etale) (d : O₁ ⟶ O) (k : O₁.left ⟶ V₁.left) (hk : k ≫ V₁.hom = O₁.hom ≫ g),
        k ≫ c.left = d.left ≫ h ∧ q ∈ Set.range d.left := by
    intro V₁ c q v₁ hv
    haveI : Etale V₁.hom := V₁.prop
    haveI : Etale V.hom := V.prop
    haveI : Etale O.hom := O.prop
    haveI : Etale (c.left ≫ V.hom) := by rw [MorphismProperty.Over.w c]; infer_instance
    haveI : Etale c.left := Etale.of_comp c.left V.hom
    refine ⟨MorphismProperty.Over.mk ⊤ (Limits.pullback.fst h c.left ≫ O.hom) (by infer_instance),
      MorphismProperty.Over.homMk (Limits.pullback.fst h c.left) rfl trivial,
      Limits.pullback.snd h c.left, ?_, Limits.pullback.condition.symm, ?_⟩
    · show Limits.pullback.snd h c.left ≫ V₁.hom = (Limits.pullback.fst h c.left ≫ O.hom) ≫ g
      rw [← MorphismProperty.Over.w c, ← Category.assoc, ← Limits.pullback.condition,
        Category.assoc, hh, ← Category.assoc]
    · obtain ⟨p, hp, -⟩ :=
        Scheme.Pullback.exists_preimage_pullback (f := h) (g := c.left) q v₁ hv.symm
      exact ⟨p, hp⟩

  let G := (wcEtInv g).obj H
  let σ := wcEtInvRho g H V O h hh z
  have hEtHom : ∀ {A B : Z.Etale} (c : A ⟶ B), Etale c.left := by
    intro A B c
    have hw : c.left ≫ B.hom = A.hom := MorphismProperty.Over.w c
    have h1 : Etale B.hom := B.prop
    have h2 : Etale (c.left ≫ B.hom) := by rw [hw]; exact A.prop
    exact Etale.of_comp c.left B.hom
  let S : Sieve O :=
    { arrows := fun D d => G.obj.map d.op σ = 0
      downward_closed := by
        intro D D' d hd e
        change G.obj.map (e ≫ d).op σ = 0
        rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
        rw [hd, map_zero] }
  have hS : S ∈ Scheme.smallEtaleTopology Z O := by
    change S ∈ Scheme.smallGrothendieckTopology @Etale Z O
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Z
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro p
    obtain ⟨V₁, c, v₁, hv₁, hz⟩ := hloc p
    obtain ⟨O₁, d, k, hk, hcomm, ⟨p₁, hp₁⟩⟩ := hnbhd V₁ c p v₁ hv₁
    have hd : S.arrows d := by
      change G.obj.map d.op σ = 0
      rw [← hnat V₁ c O₁ d k hk hcomm, hz, map_zero]
    exact ⟨O₁, d, p₁, hd, hEtHom d, hp₁⟩
  have hsh := (isSheaf_iff_isSheaf_of_type _ _).mp
    ((sheafCompose (Scheme.smallEtaleTopology Z) (forget AddCommGrpCat.{u+1})).obj G).2
  exact (hsh S hS).isSeparatedFor.ext (fun D d hd => by
    change G.obj.map d.op σ = G.obj.map d.op 0
    rw [map_zero]
    exact hd)

theorem wc_desc_tower_pullback_inj (S : Scheme.{u}) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left)
    (l : ℕ) (O : Uinf.left.Etale)
    (E : ∀ j : ℕ, (D.obj (Opposite.op (l + j))).left.Etale)
    (π : ∀ j, O.left ⟶ (E j).left) (e : ∀ j j' : ℕ, j ≤ j' → ((E j').left ⟶ (E j).left))
    (hπ : ∀ j, π j ≫ (E j).hom = O.hom ≫ (a (l + j)).left)
    (he : ∀ (j j' : ℕ) (h : j ≤ j'), e j j' h ≫ (E j).hom =
      (E j').hom ≫ (D.map (homOfLE (Nat.add_le_add_left h l)).op).left)
    (hπe : ∀ (j j' : ℕ) (h : j ≤ j'), π j' ≫ e j j' h = π j)
    (hee : ∀ (j j' j'' : ℕ) (h₁ : j ≤ j') (h₂ : j' ≤ j''),
      e j' j'' h₂ ≫ e j j' h₁ = e j j'' (h₁.trans h₂))
    (hlimE : ∀ (T : Scheme.{u}) (z : ∀ j, T ⟶ (E j).left),
      (∀ (j j' : ℕ) (h : j ≤ j'), z j' ≫ e j j' h = z j) →
      ∃! z₀ : T ⟶ O.left, ∀ j, z₀ ≫ π j = z j)
    (hqcE : ∀ j, CompactSpace (E j).left ∧ QuasiSeparatedSpace (E j).left)
    (haffE : ∀ (j j' : ℕ) (h : j ≤ j'), IsAffineHom (e j j' h))
    (hcO : CompactSpace O.left) (hqO : QuasiSeparatedSpace O.left)
    (j : ℕ) (H : Sheaf (Scheme.smallEtaleTopology (D.obj (Opposite.op (l + j))).left) AddCommGrpCat.{u+1})
    (z : H.obj.obj (Opposite.op (E j))) :
    wcEtInvRho (a (l + j)).left H (E j) O (π j) (hπ j) z = 0 →
    ∃ (j' : ℕ) (h : j ≤ j'), wcEtInvRho (D.map (homOfLE (Nat.add_le_add_left h l)).op).left H
      (E j) (E j') (e j j' h) (he j j' h) z = 0 :=
by
  intro hz
  obtain ⟨T₁, hT₁, hU⟩ := wc_etInvRho_univ_transport (a (l + j)).left H
  have hloc : ∀ o : O.left, ∃ (V' : (D.obj (Opposite.op (l + j))).left.Etale) (c : V' ⟶ E j)
      (v' : V'.left), c.left v' = π j o ∧ H.obj.map c.op z = 0 := by
    intro o
    refine wc_et_univ_transport_locally_injective (a (l + j)).left H _ T₁ hU (E j) O (π j) (hπ j)
      z o ?_
    rw [hT₁]
    exact hz
  obtain ⟨hopen, -⟩ := wc_etale_section_vanishing_open _ H (E j) z
  obtain ⟨j', h, hj'⟩ := wc_desc_tower_eventually_in_open O.left (fun k => (E k).left) π e hπe hee
    hlimE haffE j (E j).left (𝟙 _) (hqcE j).1 _ hopen (by
      intro y p hy
      obtain ⟨V', c, v', hv', hc⟩ := hloc p
      exact ⟨V', c, ⟨v', hv'.trans hy.symm⟩, hc⟩)
  refine ⟨j', h, ?_⟩
  apply wc_etInvRho_eq_zero_of_locally_zero
  intro q
  obtain ⟨V₁, c, ⟨v₁, hv₁⟩, hc⟩ := hj' (e j j' h q) q rfl
  exact ⟨V₁, c, v₁, hv₁, hc⟩

theorem wc_desc_tower_top_surj (S : Scheme.{u}) {Uinf : S.ProEt} (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k)) (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k) (l : ℕ) (O : Uinf.left.Etale) (E : ∀ j : ℕ, (D.obj (Opposite.op (l + j))).left.Etale) (π : ∀ j, O.left ⟶ (E j).left) (e : ∀ j j' : ℕ, j ≤ j' → ((E j').left ⟶ (E j).left)) (hπ : ∀ j, π j ≫ (E j).hom = O.hom ≫ (a (l + j)).left) (he : ∀ (j j' : ℕ) (h : j ≤ j'), e j j' h ≫ (E j).hom = (E j').hom ≫ (D.map (homOfLE (Nat.add_le_add_left h l)).op).left) (hπe : ∀ (j j' : ℕ) (h : j ≤ j'), π j' ≫ e j j' h = π j) (hee : ∀ (j j' j'' : ℕ) (h₁ : j ≤ j') (h₂ : j' ≤ j''), e j' j'' h₂ ≫ e j j' h₁ = e j j'' (h₁.trans h₂)) (hlimE : ∀ (T : Scheme.{u}) (z : ∀ j, T ⟶ (E j).left), (∀ (j j' : ℕ) (h : j ≤ j'), z j' ≫ e j j' h = z j) → ∃! z₀ : T ⟶ O.left, ∀ j, z₀ ≫ π j = z j) (hqcE : ∀ j, CompactSpace (E j).left ∧ QuasiSeparatedSpace (E j).left) (haffE : ∀ (j j' : ℕ) (h : j ≤ j'), IsAffineHom (e j j' h)) (m : ℕ) (H : Sheaf (Scheme.smallEtaleTopology (D.obj (Opposite.op (l + m))).left) AddCommGrpCat.{u+1}) (w' : ((wcEtInv (π m)).obj ((wcEtInv (E m).hom).obj H)).obj.obj (Opposite.op (wcEtTop O.left))) : ∃ (l' : ℕ) (M' : (E (m + l')).left ⟶ (E m).left) (hM : M' ≫ (E m).hom = (E (m + l')).hom ≫ (D.map (homOfLE (Nat.add_le_add_left (Nat.le_add_right m l') l)).op).left) (hπM : π (m + l') ≫ M' = π m) (y' : ((wcEtInv M').obj ((wcEtInv (E m).hom).obj H)).obj.obj (Opposite.op (wcEtTop (E (m + l')).left))), ((wcEtInvCompInv (π (m + l')) M' (π m) hπM ((wcEtInv (E m).hom).obj H)).hom.app (Opposite.op (wcEtTop O.left))).hom w' = wcEtInvRho (π (m + l')) ((wcEtInv M').obj ((wcEtInv (E m).hom).obj H)) (wcEtTop (E (m + l')).left) (wcEtTop O.left) (π (m + l')) ((Category.comp_id _).trans (Category.id_comp _).symm) y' :=
by
  classical

  have hW : ∀ n, WeaklyEtale ((E (m + n)).hom ≫ (D.obj (Opposite.op (l + (m + n)))).hom) := by
    intro n
    haveI : Etale (E (m + n)).hom := (E (m + n)).prop
    haveI : WeaklyEtale (D.obj (Opposite.op (l + (m + n)))).hom := (D.obj _).prop
    infer_instance
  let Xn : ℕ → S.ProEt := fun n =>
    MorphismProperty.Over.mk ⊤ ((E (m + n)).hom ≫ (D.obj (Opposite.op (l + (m + n)))).hom) (hW n)
  have hg_w : ∀ (j j' : ℕ) (h : j ≤ j'),
      e (m + j) (m + j') (Nat.add_le_add_left h m) ≫ (Xn j).hom = (Xn j').hom := by
    intro j j' h
    show e (m + j) (m + j') (Nat.add_le_add_left h m) ≫
        ((E (m + j)).hom ≫ (D.obj (Opposite.op (l + (m + j)))).hom) =
      (E (m + j')).hom ≫ (D.obj (Opposite.op (l + (m + j')))).hom
    rw [← Category.assoc, he, Category.assoc,
      MorphismProperty.Over.w (D.map (homOfLE (Nat.add_le_add_left
        (Nat.add_le_add_left h m) l)).op)]
  let g : ∀ j j' : ℕ, j ≤ j' → (Xn j' ⟶ Xn j) := fun j j' h =>
    MorphismProperty.Over.homMk (e (m + j) (m + j') (Nat.add_le_add_left h m)) (hg_w j j' h) trivial
  have hg : ∀ (j j' j'' : ℕ) (h₁ : j ≤ j') (h₂ : j' ≤ j''),
      g j' j'' h₂ ≫ g j j' h₁ = g j j'' (h₁.trans h₂) := by
    intro j j' j'' h₁ h₂
    apply MorphismProperty.Over.Hom.ext
    refine (MorphismProperty.Comma.comp_left _ _).trans ?_
    exact hee _ _ _ _ _
  let D' : ℕᵒᵖ ⥤ S.ProEt := Functor.ofOpSequence (fun n => g n (n + 1) (Nat.le_succ n))

  have s1 : ∀ p d : ℕ, D'.map (homOfLE (show p ≤ p + d + 1 by omega)).op =
      g p (p + d + 1) (by omega) := by
    intro p d
    induction d with
    | zero => exact Functor.ofOpSequence_map_homOfLE_succ _ p
    | succ d ih =>
      have e1 : (homOfLE (show p ≤ p + (d + 1) + 1 by omega) : p ⟶ p + (d + 1) + 1) =
          homOfLE (show p ≤ p + d + 1 by omega) ≫
            homOfLE (show p + d + 1 ≤ p + d + 1 + 1 by omega) := rfl
      have e2 : D'.map (homOfLE (show p + d + 1 ≤ p + d + 1 + 1 by omega)).op =
          g (p + d + 1) (p + d + 1 + 1) (Nat.le_succ _) :=
        Functor.ofOpSequence_map_homOfLE_succ _ _
      rw [e1, op_comp, CategoryTheory.Functor.map_comp, ih, e2]
      exact hg p (p + d + 1) (p + d + 1 + 1) (by omega) (by omega)
  let M : ∀ p q : ℕ, p ≤ q → ((E (m + q)).left ⟶ (E (m + p)).left) := fun p q h =>
    (D'.map (homOfLE h).op).left
  have Meq : ∀ (p : ℕ) (h : p ≤ p), M p p h = 𝟙 (E (m + p)).left := by
    intro p h
    exact congrArg (fun (f : D'.obj (Opposite.op p) ⟶ D'.obj (Opposite.op p)) => f.left)
      (D'.map_id (Opposite.op p))
  have Mlt : ∀ (p q : ℕ) (h : p ≤ q), p < q →
      M p q h = e (m + p) (m + q) (Nat.add_le_add_left h m) := by
    intro p q h hlt
    obtain ⟨d, rfl⟩ : ∃ d, q = p + d + 1 := ⟨q - p - 1, by omega⟩
    exact congrArg (fun (f : D'.obj (Opposite.op (p + d + 1)) ⟶ D'.obj (Opposite.op p)) => f.left)
      (s1 p d)

  have K1 : ∀ (p q : ℕ) (h : p ≤ q), π (m + q) ≫ M p q h = π (m + p) := by
    intro p q h
    rcases Nat.eq_or_lt_of_le h with rfl | hlt
    · rw [Meq]; exact Category.comp_id _
    · rw [Mlt p q h hlt]; exact hπe _ _ _
  have K2 : ∀ (p q : ℕ) (h : p ≤ q) (i : ℕ) (hi : i ≤ m + p),
      M p q h ≫ e i (m + p) hi = e i (m + q) (hi.trans (Nat.add_le_add_left h m)) := by
    intro p q h i hi
    rcases Nat.eq_or_lt_of_le h with rfl | hlt
    · rw [Meq]; exact Category.id_comp _
    · rw [Mlt p q h hlt]; exact hee _ _ _ _ _
  have K3 : ∀ (q : ℕ) (h : 0 ≤ q), M 0 q h ≫ (E m).hom =
      (E (m + q)).hom ≫
        (D.map (homOfLE (Nat.add_le_add_left (Nat.le_add_right m q) l)).op).left := by
    intro q h
    rcases Nat.eq_zero_or_pos q with rfl | hq
    · rw [Meq]
      have hD : (D.map (homOfLE (Nat.add_le_add_left (Nat.le_add_right m 0) l)).op).left =
          𝟙 (D.obj (Opposite.op (l + (m + 0)))).left :=
        congrArg (fun (f : D.obj (Opposite.op (l + (m + 0))) ⟶ D.obj (Opposite.op (l + (m + 0))))
          => f.left) (D.map_id (Opposite.op (l + (m + 0))))
      rw [hD]
      exact (Category.id_comp _).trans (Category.comp_id _).symm
    · rw [Mlt 0 q h hq]
      exact he m (m + q) (by omega)
  have K4 : ∀ (p q : ℕ) (h : p ≤ q), IsAffineHom (M p q h) := by
    intro p q h
    rcases Nat.eq_or_lt_of_le h with rfl | hlt
    · rw [Meq]; infer_instance
    · rw [Mlt p q h hlt]; exact haffE _ _ _

  have hWU : WeaklyEtale (O.hom ≫ Uinf.hom) := by
    haveI : Etale O.hom := O.prop
    haveI : WeaklyEtale Uinf.hom := Uinf.prop
    infer_instance
  let Uinf' : S.ProEt := MorphismProperty.Over.mk ⊤ (O.hom ≫ Uinf.hom) hWU
  have ha'_w : ∀ n, π (m + n) ≫ (D'.obj (Opposite.op n)).hom = Uinf'.hom := by
    intro n
    show π (m + n) ≫ ((E (m + n)).hom ≫ (D.obj (Opposite.op (l + (m + n)))).hom) =
      O.hom ≫ Uinf.hom
    rw [← Category.assoc, hπ, Category.assoc, MorphismProperty.Over.w (a (l + (m + n)))]
  let a' : ∀ n, Uinf' ⟶ D'.obj (Opposite.op n) := fun n =>
    MorphismProperty.Over.homMk (π (m + n)) (ha'_w n) trivial

  have ha' : ∀ k j, a' (k + j) ≫ D'.map (homOfLE (Nat.le_add_right k j)).op = a' k := by
    intro k j
    apply MorphismProperty.Over.Hom.ext
    refine (MorphismProperty.Comma.comp_left _ _).trans ?_
    exact K1 k (k + j) _

  have shift : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (E (m + k)).left),
      (∀ k j, z (k + j) ≫ M k (k + j) (Nat.le_add_right k j) = z k) →
      ∃! z₀ : T ⟶ O.left, ∀ k, z₀ ≫ π (m + k) = z k := by
    intro T z hz
    have hza : ∀ (k q : ℕ) (h : k ≤ q), z q ≫ M k q h = z k := by
      intro k q h
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
      exact hz k d
    have hzb : ∀ k, z k ≫ e (m + k) (m + k) le_rfl = z k := by
      intro k
      have h1 := hza k (k + 1) (Nat.le_succ k)
      rw [Mlt k (k + 1) _ (Nat.lt_succ_self k)] at h1
      calc z k ≫ e (m + k) (m + k) le_rfl
          = (z (k + 1) ≫ e (m + k) (m + (k + 1)) (Nat.add_le_add_left (Nat.le_succ k) m)) ≫
              e (m + k) (m + k) le_rfl := by rw [h1]
        _ = z k := by rw [Category.assoc, hee, h1]
    let zz : ∀ j, T ⟶ (E j).left := fun j => z j ≫ e j (m + j) (Nat.le_add_left j m)
    have hcompat : ∀ (j j' : ℕ) (h : j ≤ j'), zz j' ≫ e j j' h = zz j := by
      intro j j' h
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
      show (z (j + d) ≫ e (j + d) (m + (j + d)) (Nat.le_add_left (j + d) m)) ≫ e j (j + d) h =
        z j ≫ e j (m + j) (Nat.le_add_left j m)
      rw [Category.assoc, hee, ← K2 j (j + d) (Nat.le_add_right j d) j (Nat.le_add_left j m),
        ← Category.assoc, hza j (j + d)]
    obtain ⟨z₀, hz₀, huniq⟩ := hlimE T zz hcompat
    refine ⟨z₀, ?_, ?_⟩
    · intro k
      rw [hz₀ (m + k)]
      show z (m + k) ≫ e (m + k) (m + (m + k)) (Nat.le_add_left (m + k) m) = z k
      rw [← K2 k (m + k) (Nat.le_add_left k m) (m + k) le_rfl, ← Category.assoc,
        hza k (m + k), hzb k]
    · intro z₁ hz₁
      apply huniq
      intro j
      show z₁ ≫ π j = z j ≫ e j (m + j) (Nat.le_add_left j m)
      rw [← hπe j (m + j) (Nat.le_add_left j m), ← Category.assoc, hz₁ j]
  have hlim' : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D'.obj (Opposite.op k)).left),
      (∀ k j, z (k + j) ≫ (D'.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
      ∃! z₀ : T ⟶ Uinf'.left, ∀ k, z₀ ≫ (a' k).left = z k := by
    intro T z hz
    exact shift T z hz
  have hqc' : ∀ k, CompactSpace (D'.obj (Opposite.op k)).left ∧
      QuasiSeparatedSpace (D'.obj (Opposite.op k)).left := fun k => hqcE (m + k)
  have haff' : ∀ k j, IsAffineHom (D'.map (homOfLE (Nat.le_add_right k j)).op).left :=
    fun k j => K4 k (k + j) _

  obtain ⟨l', h0, y, hy⟩ := (wc_et_tower_pullback_sections S D' a' ha' hlim' hqc' haff' 0
    ((wcEtInv (E m).hom).obj H)).1 w'
  exact ⟨l', M 0 l' h0, K3 l' h0, K1 0 l' h0, y, hy (K1 0 l' h0)⟩

theorem wc_desc_tower_pullback_surj (S : Scheme.{u}) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left)
    (l : ℕ) (O : Uinf.left.Etale)
    (E : ∀ j : ℕ, (D.obj (Opposite.op (l + j))).left.Etale)
    (π : ∀ j, O.left ⟶ (E j).left) (e : ∀ j j' : ℕ, j ≤ j' → ((E j').left ⟶ (E j).left))
    (hπ : ∀ j, π j ≫ (E j).hom = O.hom ≫ (a (l + j)).left)
    (he : ∀ (j j' : ℕ) (h : j ≤ j'), e j j' h ≫ (E j).hom =
      (E j').hom ≫ (D.map (homOfLE (Nat.add_le_add_left h l)).op).left)
    (hπe : ∀ (j j' : ℕ) (h : j ≤ j'), π j' ≫ e j j' h = π j)
    (hee : ∀ (j j' j'' : ℕ) (h₁ : j ≤ j') (h₂ : j' ≤ j''),
      e j' j'' h₂ ≫ e j j' h₁ = e j j'' (h₁.trans h₂))
    (hlimE : ∀ (T : Scheme.{u}) (z : ∀ j, T ⟶ (E j).left),
      (∀ (j j' : ℕ) (h : j ≤ j'), z j' ≫ e j j' h = z j) →
      ∃! z₀ : T ⟶ O.left, ∀ j, z₀ ≫ π j = z j)
    (hqcE : ∀ j, CompactSpace (E j).left ∧ QuasiSeparatedSpace (E j).left)
    (haffE : ∀ (j j' : ℕ) (h : j ≤ j'), IsAffineHom (e j j' h))
    (hcO : CompactSpace O.left) (hqO : QuasiSeparatedSpace O.left)
    (m : ℕ) (H : Sheaf (Scheme.smallEtaleTopology (D.obj (Opposite.op (l + m))).left) AddCommGrpCat.{u+1})
    (w : ((wcEtInv (a (l + m)).left).obj H).obj.obj (Opposite.op O)) :
    ∃ (j' : ℕ) (h : m ≤ j')
      (y : ((wcEtInv (D.map (homOfLE (Nat.add_le_add_left h l)).op).left).obj H).obj.obj
        (Opposite.op (E j'))),
      ∀ (hc : (a (l + j')).left ≫ (D.map (homOfLE (Nat.add_le_add_left h l)).op).left =
          (a (l + m)).left),
        ((wcEtInvCompInv (a (l + j')).left (D.map (homOfLE (Nat.add_le_add_left h l)).op).left
            (a (l + m)).left hc H).hom.app (Opposite.op O)).hom w =
          wcEtInvRho (a (l + j')).left
            ((wcEtInv (D.map (homOfLE (Nat.add_le_add_left h l)).op).left).obj H)
            (E j') O (π j') (hπ j') y :=
by
  classical

  have hComp_CI : ∀ {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y) (e : Z' ⟶ Y) (he : t ≫ g = e)
      (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Z'.Etale)
      (x : ((wcEtInv t).obj ((wcEtInv g).obj A)).obj.obj (Opposite.op V)),
      ((wcEtInvCompInv t g e he A).hom.app (Opposite.op V)).hom
        (((wcEtInvComp t g e he A).hom.app (Opposite.op V)).hom x) = x := by
    intro Z' Z Y t g e he A V x
    exact congrArg (fun f => (f.hom.app (Opposite.op V)).hom x) (wc_etInvComp_inv_pair t g e he A).1
  have hCI_Comp : ∀ {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y) (e : Z' ⟶ Y) (he : t ≫ g = e)
      (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Z'.Etale)
      (x : ((wcEtInv e).obj A).obj.obj (Opposite.op V)),
      ((wcEtInvComp t g e he A).hom.app (Opposite.op V)).hom
        (((wcEtInvCompInv t g e he A).hom.app (Opposite.op V)).hom x) = x := by
    intro Z' Z Y t g e he A V x
    exact congrArg (fun f => (f.hom.app (Opposite.op V)).hom x) (wc_etInvComp_inv_pair t g e he A).2
  have hCompInj : ∀ {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y) (e : Z' ⟶ Y) (he : t ≫ g = e)
      (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Z'.Etale),
      Function.Injective ((wcEtInvComp t g e he A).hom.app (Opposite.op V)).hom := by
    intro Z' Z Y t g e he A V x x' hxx
    have h1 := congrArg ((wcEtInvCompInv t g e he A).hom.app (Opposite.op V)).hom hxx
    rwa [hComp_CI, hComp_CI] at h1

  have hσ : ∀ {Y : Scheme.{u}} (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
      (V : Y.Etale) (hh : 𝟙 V.left ≫ V.hom = (wcEtTop V.left).hom ≫ V.hom),
      Function.Bijective (wcEtInvRho V.hom A V (wcEtTop V.left) (𝟙 V.left) hh) := by
    intro Y A V hh
    obtain ⟨T, hT, hU⟩ := wc_etInvRho_univ_transport V.hom A
    have hb := wc_et_univ_transport_bijective_of_iso V.hom A _ T hU V (wcEtTop V.left) (𝟙 V.left) hh
      (IsIso.id _)
    have e0 : T.ρ V (wcEtTop V.left) (𝟙 V.left) hh =
        wcEtInvRho V.hom A V (wcEtTop V.left) (𝟙 V.left) hh :=
      AddMonoidHom.ext (fun x => hT _ _ _ hh x)
    rw [e0] at hb
    exact hb

  have hρcongr : ∀ {Z Y : Scheme.{u}} (g : Z ⟶ Y)
      (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale) (W : Z.Etale)
      (h h' : W.left ⟶ V.left) (hh : h ≫ V.hom = W.hom ≫ g) (hh' : h' ≫ V.hom = W.hom ≫ g),
      h = h' → ∀ x, wcEtInvRho g F V W h hh x = wcEtInvRho g F V W h' hh' x := by
    intro Z Y g F V W h h' hh hh' hhh x
    subst hhh
    rfl

  have chase : ∀ {Xm Xj Ui : Scheme.{u}} (H : Sheaf (Scheme.smallEtaleTopology Xm) AddCommGrpCat.{u+1})
      (aa : Ui ⟶ Xm) (aa' : Ui ⟶ Xj) (T : Xj ⟶ Xm) (hc : aa' ≫ T = aa)
      (O : Ui.Etale) (Em : Xm.Etale) (E' : Xj.Etale) (πm : O.left ⟶ Em.left) (π' : O.left ⟶ E'.left)
      (hπm : πm ≫ Em.hom = O.hom ≫ aa) (hπ' : π' ≫ E'.hom = O.hom ≫ aa')
      (M' : E'.left ⟶ Em.left) (hM : M' ≫ Em.hom = E'.hom ≫ T) (hπM : π' ≫ M' = πm)
      (w : ((wcEtInv aa).obj H).obj.obj (Opposite.op O))
      (y' : ((wcEtInv M').obj ((wcEtInv Em.hom).obj H)).obj.obj (Opposite.op (wcEtTop E'.left)))
      (hy' : ((wcEtInvCompInv π' M' πm hπM ((wcEtInv Em.hom).obj H)).hom.app
          (Opposite.op (wcEtTop O.left))).hom
          (((wcEtInvCompInv πm Em.hom (O.hom ≫ aa) hπm H).hom.app (Opposite.op (wcEtTop O.left))).hom
            (((wcEtInvComp O.hom aa (O.hom ≫ aa) rfl H).hom.app (Opposite.op (wcEtTop O.left))).hom
              (wcEtInvRho O.hom ((wcEtInv aa).obj H) O (wcEtTop O.left) (𝟙 O.left) rfl w))) =
        wcEtInvRho π' ((wcEtInv M').obj ((wcEtInv Em.hom).obj H)) (wcEtTop E'.left) (wcEtTop O.left) π'
          ((Category.comp_id _).trans (Category.id_comp _).symm) y')
      (y : ((wcEtInv T).obj H).obj.obj (Opposite.op E'))
      (hy : wcEtInvRho E'.hom ((wcEtInv T).obj H) E' (wcEtTop E'.left) (𝟙 E'.left) rfl y =
        ((wcEtInvCompInv E'.hom T (E'.hom ≫ T) rfl H).hom.app (Opposite.op (wcEtTop E'.left))).hom
          (((wcEtInvComp M' Em.hom (E'.hom ≫ T) hM H).hom.app (Opposite.op (wcEtTop E'.left))).hom y')),
      ((wcEtInvCompInv aa' T aa hc H).hom.app (Opposite.op O)).hom w =
        wcEtInvRho aa' ((wcEtInv T).obj H) E' O π' hπ' y := by
    intro Xm Xj Ui H aa aa' T hc O Em E' πm π' hπm hπ' M' hM hπM w y' hy' y hy
    have hb' : (O.hom ≫ aa') ≫ T = O.hom ≫ aa := by rw [Category.assoc, hc]
    have hc' : π' ≫ (E'.hom ≫ T) = O.hom ≫ aa := by rw [← Category.assoc, hπ', hb']
    have hhπ : π' ≫ (wcEtTop E'.left).hom = (wcEtTop O.left).hom ≫ π' :=
      (Category.comp_id _).trans (Category.id_comp _).symm
    generalize hu : wcEtInvRho O.hom ((wcEtInv aa).obj H) O (wcEtTop O.left) (𝟙 O.left) rfl w = uu
      at hy'
    generalize hv : ((wcEtInvComp O.hom aa (O.hom ≫ aa) rfl H).hom.app
      (Opposite.op (wcEtTop O.left))).hom uu = vv at hy'

    have eL1 : wcEtInvRho O.hom ((wcEtInv aa').obj ((wcEtInv T).obj H)) O (wcEtTop O.left)
        (𝟙 O.left) rfl (((wcEtInvCompInv aa' T aa hc H).hom.app (Opposite.op O)).hom w) =
        ((((wcEtInv O.hom).map (wcEtInvCompInv aa' T aa hc H)).hom.app
          (Opposite.op (wcEtTop O.left))).hom uu) := by
      rw [← hu]
      exact (wc_etInvRho_natural O.hom ((wcEtInv aa).obj H) ((wcEtInv aa').obj ((wcEtInv T).obj H))
        (wcEtInvCompInv aa' T aa hc H) O (wcEtTop O.left) (𝟙 O.left) rfl w).symm
    have eL2 : ((wcEtInvCompInv O.hom aa' (O.hom ≫ aa') rfl ((wcEtInv T).obj H)).hom.app
          (Opposite.op (wcEtTop O.left))).hom
          (((wcEtInvCompInv (O.hom ≫ aa') T (O.hom ≫ aa) hb' H).hom.app
            (Opposite.op (wcEtTop O.left))).hom vv) =
        ((((wcEtInv O.hom).map (wcEtInvCompInv aa' T aa hc H)).hom.app
          (Opposite.op (wcEtTop O.left))).hom uu) := by
      have e1 := congrArg (fun f => (f.hom.app (Opposite.op (wcEtTop O.left))).hom vv)
        (wc_etInvCompInv_assoc O.hom aa' T (O.hom ≫ aa') aa (O.hom ≫ aa) rfl hc hb' rfl H)
      refine e1.trans ?_
      show ((((wcEtInv O.hom).map (wcEtInvCompInv aa' T aa hc H)).hom.app
          (Opposite.op (wcEtTop O.left))).hom
        (((wcEtInvCompInv O.hom aa (O.hom ≫ aa) rfl H).hom.app
          (Opposite.op (wcEtTop O.left))).hom vv)) = _
      rw [← hv, hComp_CI]
    have eL3 : ((wcEtInvCompInv (O.hom ≫ aa') T (O.hom ≫ aa) hb' H).hom.app
          (Opposite.op (wcEtTop O.left))).hom vv =
        ((wcEtInvComp O.hom aa' (O.hom ≫ aa') rfl ((wcEtInv T).obj H)).hom.app
          (Opposite.op (wcEtTop O.left))).hom
          ((((wcEtInv O.hom).map (wcEtInvCompInv aa' T aa hc H)).hom.app
            (Opposite.op (wcEtTop O.left))).hom uu) := by
      rw [← eL2, hCI_Comp]

    have eR1 := (wc_etInvComp_spec O.hom aa' (O.hom ≫ aa') rfl ((wcEtInv T).obj H)).2 E' O π' hπ'
      (wcEtTop O.left) (𝟙 O.left) rfl y
    have eR4 := (wc_etInvComp_spec π' E'.hom (O.hom ≫ aa') hπ' ((wcEtInv T).obj H)).1 E'
      (wcEtTop E'.left) (𝟙 E'.left) rfl (wcEtTop O.left) π' hhπ y
    have eR5a := (wc_etInvRho_natural π' ((wcEtInv (E'.hom ≫ T)).obj H)
      ((wcEtInv E'.hom).obj ((wcEtInv T).obj H)) (wcEtInvCompInv E'.hom T (E'.hom ≫ T) rfl H)
      (wcEtTop E'.left) (wcEtTop O.left) π' hhπ
      (((wcEtInvComp M' Em.hom (E'.hom ≫ T) hM H).hom.app (Opposite.op (wcEtTop E'.left))).hom y')).symm
    have eR5b := (wc_etInvRho_natural π' ((wcEtInv M').obj ((wcEtInv Em.hom).obj H))
      ((wcEtInv (E'.hom ≫ T)).obj H) (wcEtInvComp M' Em.hom (E'.hom ≫ T) hM H)
      (wcEtTop E'.left) (wcEtTop O.left) π' hhπ y').symm
    have eR7 : ((wcEtInvCompInv π' M' πm hπM ((wcEtInv Em.hom).obj H)).hom.app
          (Opposite.op (wcEtTop O.left))).hom
          (((wcEtInvCompInv πm Em.hom (O.hom ≫ aa) hπm H).hom.app
            (Opposite.op (wcEtTop O.left))).hom vv) =
        ((((wcEtInv π').map (wcEtInvCompInv M' Em.hom (E'.hom ≫ T) hM H)).hom.app
          (Opposite.op (wcEtTop O.left))).hom
          (((wcEtInvCompInv π' (E'.hom ≫ T) (O.hom ≫ aa) hc' H).hom.app
            (Opposite.op (wcEtTop O.left))).hom vv)) :=
      congrArg (fun f => (f.hom.app (Opposite.op (wcEtTop O.left))).hom vv)
        (wc_etInvCompInv_assoc π' M' Em.hom πm (E'.hom ≫ T) (O.hom ≫ aa) hπM hM hπm hc' H)
    have eCancel : ∀ z : ((wcEtInv π').obj ((wcEtInv (E'.hom ≫ T)).obj H)).obj.obj
        (Opposite.op (wcEtTop O.left)),
        ((((wcEtInv π').map (wcEtInvComp M' Em.hom (E'.hom ≫ T) hM H)).hom.app
          (Opposite.op (wcEtTop O.left))).hom
          ((((wcEtInv π').map (wcEtInvCompInv M' Em.hom (E'.hom ≫ T) hM H)).hom.app
            (Opposite.op (wcEtTop O.left))).hom z)) = z := by
      intro z
      have e2 : (wcEtInv π').map (wcEtInvCompInv M' Em.hom (E'.hom ≫ T) hM H) ≫
          (wcEtInv π').map (wcEtInvComp M' Em.hom (E'.hom ≫ T) hM H) = 𝟙 _ := by
        rw [← CategoryTheory.Functor.map_comp, (wc_etInvComp_inv_pair M' Em.hom (E'.hom ≫ T) hM H).2,
          CategoryTheory.Functor.map_id]
      have h3 := congrArg (fun f => (f.hom.app (Opposite.op (wcEtTop O.left))).hom z) e2
      first
        | exact h3
        | simpa using h3
    have eR8 : ((wcEtInvCompInv π' E'.hom (O.hom ≫ aa') hπ' ((wcEtInv T).obj H)).hom.app
          (Opposite.op (wcEtTop O.left))).hom
          (((wcEtInvCompInv (O.hom ≫ aa') T (O.hom ≫ aa) hb' H).hom.app
            (Opposite.op (wcEtTop O.left))).hom vv) =
        ((((wcEtInv π').map (wcEtInvCompInv E'.hom T (E'.hom ≫ T) rfl H)).hom.app
          (Opposite.op (wcEtTop O.left))).hom
          (((wcEtInvCompInv π' (E'.hom ≫ T) (O.hom ≫ aa) hc' H).hom.app
            (Opposite.op (wcEtTop O.left))).hom vv)) :=
      congrArg (fun f => (f.hom.app (Opposite.op (wcEtTop O.left))).hom vv)
        (wc_etInvCompInv_assoc π' E'.hom T (O.hom ≫ aa') (E'.hom ≫ T) (O.hom ≫ aa) hπ' rfl hb' hc' H)
    have eR8' : ((wcEtInvCompInv (O.hom ≫ aa') T (O.hom ≫ aa) hb' H).hom.app
          (Opposite.op (wcEtTop O.left))).hom vv =
        ((wcEtInvComp π' E'.hom (O.hom ≫ aa') hπ' ((wcEtInv T).obj H)).hom.app
          (Opposite.op (wcEtTop O.left))).hom
        ((((wcEtInv π').map (wcEtInvCompInv E'.hom T (E'.hom ≫ T) rfl H)).hom.app
          (Opposite.op (wcEtTop O.left))).hom
          (((wcEtInvCompInv π' (E'.hom ≫ T) (O.hom ≫ aa) hc' H).hom.app
            (Opposite.op (wcEtTop O.left))).hom vv)) := by
      rw [← eR8, hCI_Comp]

    apply (hσ ((wcEtInv aa').obj ((wcEtInv T).obj H)) O rfl).1
    apply hCompInj O.hom aa' (O.hom ≫ aa') rfl ((wcEtInv T).obj H) (wcEtTop O.left)
    rw [eL1, ← eL3, ← eR1, hCI_Comp]
    refine Eq.trans ?_ (eR4.trans (hρcongr (O.hom ≫ aa') ((wcEtInv T).obj H) E' (wcEtTop O.left)
      (π' ≫ 𝟙 E'.left) (𝟙 O.left ≫ π') _ _
      ((Category.comp_id π').trans (Category.id_comp π').symm) y))
    rw [hy, eR5a, eR5b, ← hy', eR7, eCancel]
    exact eR8'

  obtain ⟨l', M', hM, hπM, y', hy'⟩ := wc_desc_tower_top_surj S D a ha l O E π e hπ he hπe hee hlimE
    hqcE haffE m H
    (((wcEtInvCompInv (π m) (E m).hom (O.hom ≫ (a (l + m)).left) (hπ m) H).hom.app
        (Opposite.op (wcEtTop O.left))).hom
      (((wcEtInvComp O.hom (a (l + m)).left (O.hom ≫ (a (l + m)).left) rfl H).hom.app
          (Opposite.op (wcEtTop O.left))).hom
        (wcEtInvRho O.hom ((wcEtInv (a (l + m)).left).obj H) O (wcEtTop O.left) (𝟙 O.left) rfl w)))
  obtain ⟨y, hy⟩ := (hσ ((wcEtInv (D.map (homOfLE (Nat.add_le_add_left
      (Nat.le_add_right m l') l)).op).left).obj H) (E (m + l')) rfl).2
    (((wcEtInvCompInv (E (m + l')).hom
        (D.map (homOfLE (Nat.add_le_add_left (Nat.le_add_right m l') l)).op).left
        ((E (m + l')).hom ≫ (D.map (homOfLE (Nat.add_le_add_left (Nat.le_add_right m l') l)).op).left)
        rfl H).hom.app (Opposite.op (wcEtTop (E (m + l')).left))).hom
      (((wcEtInvComp M' (E m).hom _ hM H).hom.app (Opposite.op (wcEtTop (E (m + l')).left))).hom y'))
  refine ⟨m + l', Nat.le_add_right m l', y, fun hc => ?_⟩
  exact chase H (a (l + m)).left (a (l + (m + l'))).left _ hc O (E m) (E (m + l')) (π m) (π (m + l'))
    (hπ m) (hπ (m + l')) M' hM hπM w y' hy' y hy

theorem wc_et_sys_descended_sections_colimit (S : Scheme.{u}) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left)
    (A : wcEtSys D a) (hA : wcEtSysOK A) (l : ℕ) (O : Uinf.left.Etale)
    (E : ∀ j : ℕ, (D.obj (Opposite.op (l + j))).left.Etale)
    (π : ∀ j, O.left ⟶ (E j).left) (e : ∀ j j' : ℕ, j ≤ j' → ((E j').left ⟶ (E j).left))
    (hπ : ∀ j, π j ≫ (E j).hom = O.hom ≫ (a (l + j)).left)
    (he : ∀ (j j' : ℕ) (h : j ≤ j'), e j j' h ≫ (E j).hom =
      (E j').hom ≫ (D.map (homOfLE (Nat.add_le_add_left h l)).op).left)
    (hπe : ∀ (j j' : ℕ) (h : j ≤ j'), π j' ≫ e j j' h = π j)
    (hee : ∀ (j j' j'' : ℕ) (h₁ : j ≤ j') (h₂ : j' ≤ j''),
      e j' j'' h₂ ≫ e j j' h₁ = e j j'' (h₁.trans h₂))
    (hlimE : ∀ (T : Scheme.{u}) (z : ∀ j, T ⟶ (E j).left),
      (∀ (j j' : ℕ) (h : j ≤ j'), z j' ≫ e j j' h = z j) →
      ∃! z₀ : T ⟶ O.left, ∀ j, z₀ ≫ π j = z j)
    (hqcE : ∀ j, CompactSpace (E j).left ∧ QuasiSeparatedSpace (E j).left)
    (haffE : ∀ (j j' : ℕ) (h : j ≤ j'), IsAffineHom (e j j' h))
    (hcO : CompactSpace O.left) (hqO : QuasiSeparatedSpace O.left) :
    (∀ s : A.Finf.obj.obj (Opposite.op O), ∃ (j : ℕ) (x : (A.F (l + j)).obj.obj (Opposite.op (E j))),
      wcSysRho A (l + j) O (E j) (π j) (hπ j) x = s) ∧
    (∀ (j : ℕ) (x : (A.F (l + j)).obj.obj (Opposite.op (E j))),
      wcSysRho A (l + j) O (E j) (π j) (hπ j) x = 0 →
      ∃ (j' : ℕ) (h : j ≤ j'), wcSysTau A (l + j) (l + j') (Nat.add_le_add_left h l) (E j) (E j')
        (e j j' h) (he j j' h) x = 0) :=
by
  classical

  have hhom : ∀ k₁ k₂ (f g : (Opposite.op k₂ : ℕᵒᵖ) ⟶ Opposite.op k₁), f = g := fun _ _ f g =>
    Quiver.Hom.unop_inj (Subsingleton.elim _ _)
  have heA : ∀ k₁ k₂ (h : k₁ ≤ k₂), (a k₂).left ≫ (D.map (homOfLE h).op).left = (a k₁).left := by
    intro k₁ k₂ h
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
    exact congrArg (fun t => t.left) (ha k₁ j)
  have heD : ∀ k₁ k₂ k₃ (h₁ : k₁ ≤ k₂) (h₂ : k₂ ≤ k₃),
      (D.map (homOfLE h₂).op).left ≫ (D.map (homOfLE h₁).op).left =
        (D.map (homOfLE (h₁.trans h₂)).op).left := by
    intro k₁ k₂ k₃ h₁ h₂
    refine (congrArg (fun t => t.left) (D.map_comp (homOfLE h₂).op (homOfLE h₁).op).symm).trans ?_
    exact congrArg (fun f => (D.map f).left) (hhom _ _ _ _)

  have hρcongr : ∀ {Z Y : Scheme.{u}} (g : Z ⟶ Y)
      (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale) (W : Z.Etale)
      (h h' : W.left ⟶ V.left) (hh : h ≫ V.hom = W.hom ≫ g) (hh' : h' ≫ V.hom = W.hom ≫ g),
      h = h' → ∀ x, wcEtInvRho g F V W h hh x = wcEtInvRho g F V W h' hh' x := by
    intro Z Y g F V W h h' hh hh' hhh x
    subst hhh
    rfl

  obtain ⟨θ, hθdef⟩ : ∃ θ : ∀ k₁ k₂, k₁ ≤ k₂ →
      ((wcEtInv (a k₁).left).obj (A.F k₁) ⟶ (wcEtInv (a k₂).left).obj (A.F k₂)),
      ∀ k₁ k₂ (h : k₁ ≤ k₂), θ k₁ k₂ h =
        wcEtInvCompInv (a k₂).left (D.map (homOfLE h).op).left (a k₁).left (heA k₁ k₂ h) (A.F k₁) ≫
          (wcEtInv (a k₂).left).map (A.φ k₁ k₂ h) := ⟨_, fun _ _ _ => rfl⟩
  have hθ : ∀ k₁ k₂ k₃ (h₁ : k₁ ≤ k₂) (h₂ : k₂ ≤ k₃),
      θ k₁ k₂ h₁ ≫ θ k₂ k₃ h₂ = θ k₁ k₃ (h₁.trans h₂) := by
    intro k₁ k₂ k₃ h₁ h₂
    have e3 := (wc_etInvCompInv_natural (a k₃).left (D.map (homOfLE h₂).op).left (a k₂).left
      (heA k₂ k₃ h₂) (A.φ k₁ k₂ h₁)).symm
    have e4 := wc_etInvCompInv_assoc (a k₃).left (D.map (homOfLE h₂).op).left
      (D.map (homOfLE h₁).op).left (a k₂).left (D.map (homOfLE (h₁.trans h₂)).op).left (a k₁).left
      (heA k₂ k₃ h₂) (heD k₁ k₂ k₃ h₁ h₂) (heA k₁ k₂ h₁) (heA k₁ k₃ (h₁.trans h₂)) (A.F k₁)
    have e1 := hA.1 k₁ k₂ k₃ h₁ h₂ (heD k₁ k₂ k₃ h₁ h₂)
    rw [hθdef, hθdef, hθdef]
    simp only [Category.assoc]
    rw [← reassoc_of% e3, reassoc_of% e4, ← Functor.map_comp, ← Functor.map_comp, e1]
  have hcone : ∀ k₁ k₂ (h : k₁ ≤ k₂), θ k₁ k₂ h ≫ A.ψ k₂ = A.ψ k₁ := by
    intro k₁ k₂ h
    rw [hθdef, Category.assoc]
    exact hA.2.1 k₁ k₂ h (heA k₁ k₂ h)
  have hLC2 : ∀ (k : ℕ) (V : Uinf.left.Etale)
      (t : ((wcEtInv (a k).left).obj (A.F k)).obj.obj (Opposite.op V)),
      ((A.ψ k).hom.app (Opposite.op V)).hom t = 0 →
      Sieve.generate (fun (V' : Uinf.left.Etale) (h : V' ⟶ V) =>
        ∃ (k₂ : ℕ) (hkl : k ≤ k₂),
          ((θ k k₂ hkl).hom.app (Opposite.op V')).hom
            ((((wcEtInv (a k).left).obj (A.F k)).obj.map h.op).hom t) = 0) ∈
        Scheme.smallEtaleTopology Uinf.left V := by
    intro k V t ht
    refine GrothendieckTopology.superset_covering _ ?_ (hA.2.2.2 k V t ht)
    refine (Sieve.generate_le_iff _ _).2 ?_
    rintro V' h ⟨k₂, hkl, he', hz⟩
    apply Sieve.le_generate
    refine ⟨k₂, hkl, ?_⟩
    rw [hθdef]
    exact hz

  obtain ⟨hBsurj, hBinj⟩ := wc_et_nat_system_sections_colim Uinf.left
    (fun k => (wcEtInv (a k).left).obj (A.F k)) θ hθ A.Finf A.ψ hcone hA.2.2.1 hLC2
    O hcO hqO
  refine ⟨fun s => ?_, fun j x hx => ?_⟩
  ·
    obtain ⟨k, w, hw⟩ := hBsurj s
    have hk : k ≤ l + k := Nat.le_add_left k l
    obtain ⟨w₁, hw₁⟩ : ∃ w₁ : ((wcEtInv (a (l + k)).left).obj (A.F (l + k))).obj.obj (Opposite.op O),
        w₁ = ((θ k (l + k) hk).hom.app (Opposite.op O)).hom w := ⟨_, rfl⟩
    have hw₁s : ((A.ψ (l + k)).hom.app (Opposite.op O)).hom w₁ = s := by
      rw [hw₁]
      exact (congrArg (fun f => (f.hom.app (Opposite.op O)).hom w) (hcone k (l + k) hk)).trans hw
    obtain ⟨j', hj', y, hy⟩ := wc_desc_tower_pullback_surj S D a ha hlim hqc haff l O E π e hπ he
      hπe hee hlimE hqcE haffE hcO hqO k (A.F (l + k)) w₁
    refine ⟨j', ((A.φ (l + k) (l + j') (Nat.add_le_add_left hj' l)).hom.app
      (Opposite.op (E j'))).hom y, ?_⟩
    have e1 := wc_etInvRho_natural (a (l + j')).left _ _
      (A.φ (l + k) (l + j') (Nat.add_le_add_left hj' l)) (E j') O (π j') (hπ j') y
    have e2 := hy (heA (l + k) (l + j') (Nat.add_le_add_left hj' l))
    have e3 := (congrArg (fun f => (f.hom.app (Opposite.op O)).hom w₁)
      (hcone (l + k) (l + j') (Nat.add_le_add_left hj' l))).trans hw₁s
    rw [hθdef] at e3
    refine (congrArg (fun z => ((A.ψ (l + j')).hom.app (Opposite.op O)).hom z) e1).symm.trans ?_
    refine (congrArg (fun z => ((A.ψ (l + j')).hom.app (Opposite.op O)).hom
      ((((wcEtInv (a (l + j')).left).map
        (A.φ (l + k) (l + j') (Nat.add_le_add_left hj' l))).hom.app (Opposite.op O)).hom z))
      e2).symm.trans ?_
    exact e3
  ·
    obtain ⟨k', hk', hk'0⟩ := hBinj (l + j)
      (wcEtInvRho (a (l + j)).left (A.F (l + j)) (E j) O (π j) (hπ j) x) hx
    obtain ⟨j₁, rfl⟩ : ∃ j₁, k' = l + j₁ := ⟨k' - l, by omega⟩
    have hjj₁ : j ≤ j₁ := by omega
    have hCIw : ((wcEtInvCompInv (a (l + j₁)).left (D.map (homOfLE hk').op).left (a (l + j)).left
        (heA (l + j) (l + j₁) hk') (A.F (l + j))).hom.app (Opposite.op O)).hom
          (wcEtInvRho (a (l + j)).left (A.F (l + j)) (E j) O (π j) (hπ j) x) =
        wcEtInvRho (a (l + j₁)).left ((wcEtInv (D.map (homOfLE hk').op).left).obj (A.F (l + j)))
          (E j₁) O (π j₁) (hπ j₁)
          (wcEtInvRho (D.map (homOfLE hk').op).left (A.F (l + j)) (E j) (E j₁) (e j j₁ hjj₁)
            (he j j₁ hjj₁) x) := by
      have h0 := (wc_etInvComp_spec (a (l + j₁)).left (D.map (homOfLE hk').op).left
        (a (l + j)).left (heA (l + j) (l + j₁) hk') (A.F (l + j))).2 (E j) (E j₁) (e j j₁ hjj₁)
        (he j j₁ hjj₁) O (π j₁) (hπ j₁) x
      refine Eq.trans ?_ h0
      congr 1
      exact hρcongr _ _ _ _ _ _ _ _ (hπe j j₁ hjj₁).symm x
    have hz : wcEtInvRho (a (l + j₁)).left (A.F (l + j₁)) (E j₁) O (π j₁) (hπ j₁)
        (wcSysTau A (l + j) (l + j₁) (Nat.add_le_add_left hjj₁ l) (E j) (E j₁) (e j j₁ hjj₁)
          (he j j₁ hjj₁) x) = 0 := by
      have e4 := wc_etInvRho_natural (a (l + j₁)).left _ _ (A.φ (l + j) (l + j₁) hk') (E j₁) O
        (π j₁) (hπ j₁)
        (wcEtInvRho (D.map (homOfLE hk').op).left (A.F (l + j)) (E j) (E j₁) (e j j₁ hjj₁)
          (he j j₁ hjj₁) x)
      refine e4.symm.trans ?_
      refine (congrArg (fun z => (((wcEtInv (a (l + j₁)).left).map
        (A.φ (l + j) (l + j₁) hk')).hom.app (Opposite.op O)).hom z) hCIw).symm.trans ?_
      rw [hθdef] at hk'0
      exact hk'0
    obtain ⟨j₂, hj₂, hj₂0⟩ := wc_desc_tower_pullback_inj S D a ha hlim hqc haff l O E π e hπ he
      hπe hee hlimE hqcE haffE hcO hqO j₁ (A.F (l + j₁))
      (wcSysTau A (l + j) (l + j₁) (Nat.add_le_add_left hjj₁ l) (E j) (E j₁) (e j j₁ hjj₁)
        (he j j₁ hjj₁) x) hz
    have h3 : wcSysTau A (l + j₁) (l + j₂) (Nat.add_le_add_left hj₂ l) (E j₁) (E j₂) (e j₁ j₂ hj₂)
        (he j₁ j₂ hj₂)
        (wcSysTau A (l + j) (l + j₁) (Nat.add_le_add_left hjj₁ l) (E j) (E j₁) (e j j₁ hjj₁)
          (he j j₁ hjj₁) x) = 0 :=
      (congrArg (fun z => ((A.φ (l + j₁) (l + j₂) (Nat.add_le_add_left hj₂ l)).hom.app
        (Opposite.op (E j₂))).hom z) hj₂0).trans (map_zero _)
    obtain ⟨R1, -, -, -⟩ := wc_et_sys_rho_calculus S D a ha A hA
    refine ⟨j₂, hjj₁.trans hj₂, ?_⟩
    exact (R1 (l + j) (l + j₁) (l + j₂) (Nat.add_le_add_left hjj₁ l) (Nat.add_le_add_left hj₂ l)
      (E j) (E j₁) (E j₂) (e j j₁ hjj₁) (he j j₁ hjj₁) (e j₁ j₂ hj₂) (he j₁ j₂ hj₂)
      (e j j₂ (hjj₁.trans hj₂)) (he j j₂ (hjj₁.trans hj₂)) (hee j j₁ j₂ hjj₁ hj₂) x).symm.trans h3

theorem wc_cechAcyclic_of_tower_levels {C' : Type (u+1)} [Category.{u} C']
    [Limits.HasFiniteWidePullbacks C'] (H : C'ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (U : C') (k : ℕ)
    (V : Fin k → C') (f : ∀ i, V i ⟶ U)
    (C : ℕ → Type (u+1)) [∀ j, Category.{u} (C j)] [∀ j, Limits.HasFiniteWidePullbacks (C j)]
    (G : ∀ j, (C j)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (U' : ∀ j, C j) (V' : ∀ j, Fin k → C j)
    (f' : ∀ j i, V' j i ⟶ U' j)
    (τ : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j j' : ℕ), j ≤ j' →
      ((G j).obj (Opposite.op (wcWP (U' j) (V' j) (f' j) σ)) →+
        (G j').obj (Opposite.op (wcWP (U' j') (V' j') (f' j') σ))))
    (ρ : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j : ℕ),
      (G j).obj (Opposite.op (wcWP (U' j) (V' j) (f' j) σ)) →+ H.obj (Opposite.op (wcWP U V f σ)))
    (T1 : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j j' : ℕ) (h : j ≤ j')
      (x : (G j).obj (Opposite.op (wcWP (U' j) (V' j) (f' j) σ))),
      ρ p σ j' (τ p σ j j' h x) = ρ p σ j x)
    (T2 : ∀ (p : ℕ) (τ' : Fin (p + 2) → Fin k) (jj : Fin (p + 2)) (j j' : ℕ) (h : j ≤ j')
      (x : (G j).obj (Opposite.op (wcWP (U' j) (V' j) (f' j) (fun t => τ' (jj.succAbove t))))),
      τ (p + 1) τ' j j' h ((G j).map (wcCechFace (V' j) (f' j) τ' jj).op x) =
        (G j').map (wcCechFace (V' j') (f' j') τ' jj).op
          (τ p (fun t => τ' (jj.succAbove t)) j j' h x))
    (T3 : ∀ (p : ℕ) (τ' : Fin (p + 2) → Fin k) (jj : Fin (p + 2)) (j : ℕ)
      (x : (G j).obj (Opposite.op (wcWP (U' j) (V' j) (f' j) (fun t => τ' (jj.succAbove t))))),
      H.map (wcCechFace V f τ' jj).op (ρ p (fun t => τ' (jj.succAbove t)) j x) =
        ρ (p + 1) τ' j ((G j).map (wcCechFace (V' j) (f' j) τ' jj).op x))
    (T4 : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (s : H.obj (Opposite.op (wcWP U V f σ))),
      ∃ (j : ℕ) (x : (G j).obj (Opposite.op (wcWP (U' j) (V' j) (f' j) σ))), ρ p σ j x = s)
    (T5 : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j : ℕ)
      (x : (G j).obj (Opposite.op (wcWP (U' j) (V' j) (f' j) σ))),
      ρ p σ j x = 0 → ∃ (j' : ℕ) (h : j ≤ j'), τ p σ j j' h x = 0)
    (T6 : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j j' j'' : ℕ) (h₁ : j ≤ j') (h₂ : j' ≤ j'')
      (x : (G j).obj (Opposite.op (wcWP (U' j) (V' j) (f' j) σ))),
      τ p σ j' j'' h₂ (τ p σ j j' h₁ x) = τ p σ j j'' (h₁.trans h₂) x)
    (T7 : ∀ j, wcCechAcyclic (G j) (V' j) (f' j)) :
    wcCechAcyclic H V f :=
by
  classical
  unfold wcCechAcyclic
  intro p c hc

  choose jf xf hxf using fun τ' : Fin (p + 2) → Fin k => T4 (p + 1) τ' (c τ')
  let J : ℕ := Finset.univ.sup jf
  have hJ : ∀ τ', jf τ' ≤ J := fun τ' => Finset.le_sup (Finset.mem_univ τ')
  obtain ⟨x1, hx1def⟩ : ∃ x1 : ∀ τ' : Fin (p + 2) → Fin k,
      (G J).obj (Opposite.op (wcWP (U' J) (V' J) (f' J) τ')),
      ∀ τ', x1 τ' = τ (p + 1) τ' (jf τ') J (hJ τ') (xf τ') := ⟨_, fun _ => rfl⟩
  have hx1 : ∀ τ', ρ (p + 1) τ' J (x1 τ') = c τ' := by
    intro τ'
    rw [hx1def]
    exact (T1 (p + 1) τ' (jf τ') J (hJ τ') (xf τ')).trans (hxf τ')

  obtain ⟨y, hydef⟩ : ∃ y : ∀ ρ' : Fin (p + 3) → Fin k,
      (G J).obj (Opposite.op (wcWP (U' J) (V' J) (f' J) ρ')),
      ∀ ρ', y ρ' = ∑ jj : Fin (p + 3), ((-1 : ℤ) ^ (jj : ℕ)) •
        (G J).map (wcCechFace (V' J) (f' J) ρ' jj).op
          (x1 (fun t => ρ' (jj.succAbove t))) := ⟨_, fun _ => rfl⟩
  have hy : ∀ ρ', ρ (p + 2) ρ' J (y ρ') = 0 := by
    intro ρ'
    rw [hydef]
    refine (map_sum _ _ _).trans ((Finset.sum_congr rfl (fun jj _ => ?_)).trans (hc ρ'))
    refine (map_zsmul _ _ _).trans (congrArg (fun z => ((-1 : ℤ) ^ (jj : ℕ)) • z) ?_)
    exact (T3 (p + 1) ρ' jj J _).symm.trans
      (congrArg (fun z => H.map (wcCechFace V f ρ' jj).op z) (hx1 _))

  choose j'f hj'f hkill using fun ρ' : Fin (p + 3) → Fin k => T5 (p + 2) ρ' J (y ρ') (hy ρ')
  let J' : ℕ := max J (Finset.univ.sup j'f)
  have hJJ' : J ≤ J' := le_max_left _ _
  have hj'J' : ∀ ρ', j'f ρ' ≤ J' := fun ρ' =>
    (Finset.le_sup (f := j'f) (Finset.mem_univ ρ')).trans (le_max_right _ _)
  have hyK : ∀ ρ', τ (p + 2) ρ' J J' hJJ' (y ρ') = 0 := by
    intro ρ'
    have e := T6 (p + 2) ρ' J (j'f ρ') J' (hj'f ρ') (hj'J' ρ') (y ρ')
    rw [hkill ρ', map_zero] at e
    exact e.symm

  obtain ⟨x2, hx2def⟩ : ∃ x2 : ∀ τ' : Fin (p + 2) → Fin k,
      (G J').obj (Opposite.op (wcWP (U' J') (V' J') (f' J') τ')),
      ∀ τ', x2 τ' = τ (p + 1) τ' J J' hJJ' (x1 τ') := ⟨_, fun _ => rfl⟩
  have hx2 : ∀ τ', ρ (p + 1) τ' J' (x2 τ') = c τ' := by
    intro τ'
    rw [hx2def]
    exact (T1 (p + 1) τ' J J' hJJ' (x1 τ')).trans (hx1 τ')
  have hcoc : ∀ ρ' : Fin (p + 3) → Fin k, ∑ jj : Fin (p + 3), ((-1 : ℤ) ^ (jj : ℕ)) •
      (G J').map (wcCechFace (V' J') (f' J') ρ' jj).op
        (x2 (fun t => ρ' (jj.succAbove t))) = 0 := by
    intro ρ'
    refine Eq.trans ?_ (hyK ρ')
    rw [hydef]
    refine Eq.trans (Finset.sum_congr rfl (fun jj _ => ?_)) (map_sum _ _ _).symm
    refine Eq.trans (congrArg (fun z => ((-1 : ℤ) ^ (jj : ℕ)) • z) ?_) (map_zsmul _ _ _).symm
    exact (congrArg (fun z => (G J').map (wcCechFace (V' J') (f' J') ρ' jj).op z)
      (hx2def _)).trans (T2 (p + 1) ρ' jj J J' hJJ' _).symm

  obtain ⟨b, hb⟩ := T7 J' p x2 hcoc

  refine ⟨fun σ => ρ p σ J' (b σ), fun τ' => ?_⟩
  rw [← hx2 τ', ← hb τ']
  refine Eq.trans (Finset.sum_congr rfl (fun jj _ => ?_)) (map_sum _ _ _).symm
  refine Eq.trans (congrArg (fun z => ((-1 : ℤ) ^ (jj : ℕ)) • z) ?_) (map_zsmul _ _ _).symm
  exact T3 p τ' jj J' _

theorem wc_et_sys_injective_colim_acyclic (S : Scheme.{u}) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left)
    (I : wcEtSys D a) (hI : wcEtSysOK I) (hinj : ∀ k, Injective (I.F k)) (m : ℕ)
    (x : wcEtSysExt Uinf.hom I.Finf (m + 1)) : x = 0 :=
by
  haveI := wc_et_enough_injectives Uinf.left
  obtain ⟨R1, R2, R3, R4⟩ := wc_et_sys_rho_calculus S D a ha I hI
  have hT : Limits.IsTerminal (wcEtTop Uinf.left) :=
    @MorphismProperty.Over.mkIdTerminal _ _ @Etale Uinf.left
      MorphismProperty.IsMultiplicative.toContainsIdentities
  have hsub := wc_et_cartan_criterion_const Uinf.left
    (fun U => ∃ (l : ℕ) (U₀ : (D.obj (Opposite.op l)).left.Etale) (eU : U.left ⟶ U₀.left),
      IsPullback eU U.hom U₀.hom (a l).left ∧ CompactSpace U₀.left ∧ QuasiSeparatedSpace U₀.left)
    (fun U k V f => ∃ (l : ℕ) (U₀ : (D.obj (Opposite.op l)).left.Etale)
      (V₀ : Fin k → (D.obj (Opposite.op l)).left.Etale) (c : ∀ i, V₀ i ⟶ U₀)
      (eU : U.left ⟶ U₀.left) (eV : ∀ i, (V i).left ⟶ (V₀ i).left),
      IsPullback eU U.hom U₀.hom (a l).left ∧ (∀ i, IsPullback (eV i) (f i).left (c i).left eU) ∧
      CompactSpace U₀.left ∧ QuasiSeparatedSpace U₀.left ∧ (∀ i, IsAffine (V₀ i).left) ∧
      ∀ x : U.left, ∃ i, x ∈ Set.range (f i).left)
    (by

      intro U k V f hC
      obtain ⟨l, U₀, V₀, c, eU, eV, -, -, -, -, -, hsurj⟩ := hC
      apply wc_etale_jointly_surjective_covers
      intro v
      obtain ⟨i, hi⟩ := hsurj v
      exact ⟨V i, f i, ⟨_, 𝟙 _, f i, Presieve.ofArrows.mk i, Category.id_comp _⟩, hi⟩)
    (by

      intro U k V f hC p σ
      obtain ⟨l, U₀, V₀, c, eU, eV, hU, hV, hcU, hqU, hVa, -⟩ := hC
      obtain ⟨U', V', f', π, e, -, -, -, -, -, h6, -, -, h9, -, -⟩ :=
        wc_et_tower_cech_nerve S D a ha hlim hqc haff U k V f l U₀ V₀ c eU eV hU hV hcU hqU hVa
      exact ⟨l + 0, wcWP (U' 0) (V' 0) (f' 0) σ, π p σ 0, h9 p σ, (h6 p σ 0).1, (h6 p σ 0).2⟩)
    (by

      intro U hB R hR
      obtain ⟨l, U₀, eU, hU, hcU, hqU⟩ := hB
      obtain ⟨l', U₁, eU₁, k, V, f, V₀, c, eV, hU₁, hcU₁, hqU₁, hV, hVa, hRf, hsurj⟩ :=
        wc_et_tower_cover_descends S D a ha hlim hqc haff U l U₀ eU hU hcU hqU R hR
      exact ⟨k, V, f, ⟨l', U₁, V₀, c, eU₁, eV, hU₁, hV, hcU₁, hqU₁, hVa, hsurj⟩, hRf⟩)
    (wcEtTop Uinf.left) hT
    ⟨0, wcEtTop (D.obj (Opposite.op 0)).left, (a 0).left, IsPullback.of_id_snd,
      (hqc 0).1, (hqc 0).2⟩
    I.Finf
    (by

      intro U k V f hC
      obtain ⟨l, U₀, V₀, c, eU, eV, hU, hV, hcU, hqU, hVa, -⟩ := hC
      obtain ⟨U', V', f', π, e, h1, h2, h3, h4, h5, h6, h7, h8, -, h10, h11⟩ :=
        wc_et_tower_cech_nerve S D a ha hlim hqc haff U k V f l U₀ V₀ c eU eV hU hV hcU hqU hVa
      refine wc_cechAcyclic_of_tower_levels I.Finf.obj U k V f
        (fun j => (D.obj (Opposite.op (l + j))).left.Etale) (fun j => (I.F (l + j)).obj) U' V' f'
        (fun p σ j j' h => wcSysTau I (l + j) (l + j') (Nat.add_le_add_left h l)
          (wcWP (U' j) (V' j) (f' j) σ) (wcWP (U' j') (V' j') (f' j') σ) (e p σ j j' h)
          (h2 p σ j j' h))
        (fun p σ j => wcSysRho I (l + j) (wcWP U V f σ) (wcWP (U' j) (V' j) (f' j) σ)
          (π p σ j) (h1 p σ j)) ?_ ?_ ?_ ?_ ?_ ?_ ?_
      ·
        intro p σ j j' h x
        exact R2 (l + j) (l + j') (Nat.add_le_add_left h l) _ _ _ _ _ _ _ _ _ (h3 p σ j j' h) x
      ·
        intro p τ' jj j j' h x
        exact R4 (l + j) (l + j') (Nat.add_le_add_left h l) _ _ _ _ _ _ _ _ _ _
          (h11 p τ' jj j j' h) x
      ·
        intro p τ' jj j x
        exact R3 (l + j) _ _ _ _ _ _ _ _ _ _ (h10 p τ' jj j) x
      ·
        intro p σ s
        exact (wc_et_sys_descended_sections_colimit S D a ha hlim hqc haff I hI l (wcWP U V f σ)
          (fun j => wcWP (U' j) (V' j) (f' j) σ) (π p σ) (e p σ) (h1 p σ) (h2 p σ) (h3 p σ)
          (h4 p σ) (h5 p σ) (h6 p σ) (h7 p σ) (h8 p σ).1 (h8 p σ).2).1 s
      ·
        intro p σ j x hx
        exact (wc_et_sys_descended_sections_colimit S D a ha hlim hqc haff I hI l (wcWP U V f σ)
          (fun j => wcWP (U' j) (V' j) (f' j) σ) (π p σ) (e p σ) (h1 p σ) (h2 p σ) (h3 p σ)
          (h4 p σ) (h5 p σ) (h6 p σ) (h7 p σ) (h8 p σ).1 (h8 p σ).2).2 j x hx
      ·
        intro p σ j j' j'' h₁ h₂ x
        exact R1 (l + j) (l + j') (l + j'') (Nat.add_le_add_left h₁ l) (Nat.add_le_add_left h₂ l)
          _ _ _ _ _ _ _ _ _ (h4 p σ j j' j'' h₁ h₂) x
      ·
        intro j
        haveI := hinj (l + j)
        exact (wc_injective_cech_acyclic (Scheme.smallEtaleTopology (D.obj (Opposite.op (l + j))).left)
          (I.F (l + j)) (V' j) (f' j)).2)
    m

  have key : ∀ {Z Y : Scheme.{u}} (g : Z ⟶ Y)
      (F : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (n : ℕ),
      (letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) :=
        HasExt.standard _
      Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Z)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F n)) →
      ∀ y : wcEtSysExt g F n, y = 0 := by
    intro Z Y g F n hs y
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) := HasExt.standard _
    obtain ⟨ε⟩ := wc_etInv_unit_const g
    have e1 : y = (Abelian.Ext.mk₀ ε.hom).comp ((Abelian.Ext.mk₀ ε.inv).comp y (zero_add n))
        (zero_add n) := by
      rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ ε.hom) (Abelian.Ext.mk₀ ε.inv) y (zero_add 0)
        (zero_add n) (by omega), Abelian.Ext.mk₀_comp_mk₀, ε.hom_inv_id,
        Abelian.Ext.mk₀_id_comp]
    have e2 : (Abelian.Ext.mk₀ ε.inv).comp y (zero_add n) = 0 :=
      @Subsingleton.elim _ hs _ _
    rw [e1, e2, Abelian.Ext.comp_zero]
  exact key Uinf.hom I.Finf (m + 1) hsub x

theorem wc_et_sys_cont_step (S : Scheme.{u}) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (A I Q : wcEtSys D a) (hA : wcEtSysOK A) (hI : wcEtSysOK I) (hQ : wcEtSysOK Q)
    (u : wcEtSysHom A I) (p : wcEtSysHom I Q)
    (w : ∀ k, u.f k ≫ p.f k = 0) (winf : u.finf ≫ p.finf = 0)
    (hS : ∀ k, (ShortComplex.mk (u.f k) (p.f k) (w k)).ShortExact)
    (hSinf : (ShortComplex.mk u.finf p.finf winf).ShortExact)
    (hinj : ∀ k, Injective (I.F k)) (n : ℕ)
    (hvan : ∀ x : wcEtSysExt Uinf.hom I.Finf (n + 1), x = 0)
    (hcI : wcEtSysCont I n) (hcQ : wcEtSysCont Q n) :
    wcEtSysCont A (n + 1) :=
by
  classical
  letI hext : ∀ X : Scheme.{u}, HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) :=
    fun X => HasExt.standard _

  have hPull : ∀ {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y) (e : Z' ⟶ Y) (he : t ≫ g = e)
      (F : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (F' : Sheaf (Scheme.smallEtaleTopology Z') AddCommGrpCat.{u+1})
      (φ : (wcEtInv t).obj F ⟶ F') (n : ℕ) [(wcEtInv t).Additive]
      [Limits.PreservesFiniteLimits (wcEtInv t)] [Limits.PreservesFiniteColimits (wcEtInv t)]
      (y : wcEtSysExt g F n),
      wcEtSysPull t g e he F F' φ n y =
        Abelian.Ext.comp (Abelian.Ext.comp (Abelian.Ext.mk₀ (wcEtInvCompInv t g e he (wcEtUnitSheaf Y)))
          (Abelian.Ext.mapExactFunctor (wcEtInv t) y) (zero_add n)) (Abelian.Ext.mk₀ φ) (add_zero n) := by
    intro Z' Z Y t g e he F F' φ n i1 i2 i3 y
    have hc : (wcEtInv t).Additive ∧ Limits.PreservesFiniteLimits (wcEtInv t) ∧
        Limits.PreservesFiniteColimits (wcEtInv t) := ⟨i1, i2, i3⟩
    simp only [wcEtSysPull, dif_pos hc, AddMonoidHom.comp_apply, Abelian.Ext.postcomp,
      Abelian.Ext.precomp, AddMonoidHom.flip_apply, Abelian.Ext.bilinearComp_apply_apply,
      Functor.mapExtAddHom_apply] <;> rfl

  have hPostMk : ∀ {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y) (e : Z' ⟶ Y) (he : t ≫ g = e)
      (F₁ F₂ : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (F₁' F₂' : Sheaf (Scheme.smallEtaleTopology Z') AddCommGrpCat.{u+1})
      (φ₁ : (wcEtInv t).obj F₁ ⟶ F₁') (φ₂ : (wcEtInv t).obj F₂ ⟶ F₂') (f : F₁ ⟶ F₂) (f' : F₁' ⟶ F₂')
      (hf : (wcEtInv t).map f ≫ φ₂ = φ₁ ≫ f') (n : ℕ) (x : wcEtSysExt g F₁ n),
      wcEtSysPull t g e he F₂ F₂' φ₂ n (Abelian.Ext.comp x (Abelian.Ext.mk₀ f) (add_zero n)) =
        Abelian.Ext.comp (wcEtSysPull t g e he F₁ F₁' φ₁ n x) (Abelian.Ext.mk₀ f') (add_zero n) := by
    intro Z' Z Y t g e he F₁ F₂ F₁' F₂' φ₁ φ₂ f f' hf n x
    haveI := (wc_etInv_exact t).1
    haveI := (wc_etInv_exact t).2.1
    haveI := (wc_etInv_exact t).2.2
    rw [hPull t g e he F₂ F₂' φ₂ n, hPull t g e he F₁ F₁' φ₁ n, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hf]

  have hPostExt : ∀ {Z' Z Y : Scheme.{u}} (t : Z' ⟶ Z) (g : Z ⟶ Y) (e : Z' ⟶ Y) (he : t ≫ g = e)
      (S₀ : ShortComplex (Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})) (hS₀ : S₀.ShortExact)
      (S₁ : ShortComplex (Sheaf (Scheme.smallEtaleTopology Z') AddCommGrpCat.{u+1}))
      (hS₁ : S₁.ShortExact)
      (φ₁ : (wcEtInv t).obj S₀.X₁ ⟶ S₁.X₁) (φ₂ : (wcEtInv t).obj S₀.X₂ ⟶ S₁.X₂)
      (φ₃ : (wcEtInv t).obj S₀.X₃ ⟶ S₁.X₃)
      (h₁₂ : (wcEtInv t).map S₀.f ≫ φ₂ = φ₁ ≫ S₁.f) (h₂₃ : (wcEtInv t).map S₀.g ≫ φ₃ = φ₂ ≫ S₁.g)
      (n : ℕ) (y : wcEtSysExt g S₀.X₃ n),
      wcEtSysPull t g e he S₀.X₁ S₁.X₁ φ₁ (n + 1) (Abelian.Ext.comp y hS₀.extClass rfl) =
        Abelian.Ext.comp (wcEtSysPull t g e he S₀.X₃ S₁.X₃ φ₃ n y) hS₁.extClass rfl := by
    intro Z' Z Y t g e he S₀ hS₀ S₁ hS₁ φ₁ φ₂ φ₃ h₁₂ h₂₃ n y
    haveI := (wc_etInv_exact t).1
    haveI := (wc_etInv_exact t).2.1
    haveI := (wc_etInv_exact t).2.2
    rw [hPull t g e he S₀.X₁ S₁.X₁ φ₁ (n + 1), hPull t g e he S₀.X₃ S₁.X₃ φ₃ n]
    have hnat := ShortComplex.ShortExact.extClass_naturality (hS₀.map_of_exact (wcEtInv t)) hS₁
      (ShortComplex.homMk φ₁ φ₂ φ₃ h₁₂.symm h₂₃.symm)
    have hnat' : (hS₀.map_of_exact (wcEtInv t)).extClass.comp (Abelian.Ext.mk₀ φ₁) (add_zero 1) =
        (Abelian.Ext.mk₀ φ₃).comp hS₁.extClass (zero_add 1) := hnat
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
      Abelian.Ext.comp_assoc_of_third_deg_zero]
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor (wcEtInv t) y), hnat',
      Abelian.Ext.comp_assoc_of_third_deg_zero
        (Abelian.Ext.mk₀ (wcEtInvCompInv t g e he (wcEtUnitSheaf Y)))
        (Abelian.Ext.mapExactFunctor (wcEtInv t) y),
      Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (wcEtInvCompInv t g e he (wcEtUnitSheaf Y))) _
        hS₁.extClass (zero_add n) rfl (by omega),
      Abelian.Ext.comp_assoc_of_second_deg_zero]

  have hComp : ∀ {Z'' Z' Z Y : Scheme.{u}} (s : Z'' ⟶ Z') (t : Z' ⟶ Z) (g : Z ⟶ Y) (st : Z'' ⟶ Z)
      (e' : Z' ⟶ Y) (e'' : Z'' ⟶ Y) (hst : s ≫ t = st) (he' : t ≫ g = e')
      (he'' : s ≫ e' = e'') (hstg : st ≫ g = e'')
      (F : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1})
      (F' : Sheaf (Scheme.smallEtaleTopology Z') AddCommGrpCat.{u+1})
      (F'' : Sheaf (Scheme.smallEtaleTopology Z'') AddCommGrpCat.{u+1})
      (φ : (wcEtInv t).obj F ⟶ F') (φ' : (wcEtInv s).obj F' ⟶ F'') (n : ℕ) (y : wcEtSysExt g F n),
      wcEtSysPull s e' e'' he'' F' F'' φ' n (wcEtSysPull t g e' he' F F' φ n y) =
        wcEtSysPull st g e'' hstg F F'' (wcEtInvCompInv s t st hst F ≫ (wcEtInv s).map φ ≫ φ') n y := by
    intro Z'' Z' Z Y s t g st e' e'' hst he' he'' hstg F F' F'' φ φ' n y
    haveI := (wc_etInv_exact t).1
    haveI := (wc_etInv_exact t).2.1
    haveI := (wc_etInv_exact t).2.2
    haveI := (wc_etInv_exact s).1
    haveI := (wc_etInv_exact s).2.1
    haveI := (wc_etInv_exact s).2.2
    haveI := (wc_etInv_exact st).1
    haveI := (wc_etInv_exact st).2.1
    haveI := (wc_etInv_exact st).2.2
    have hU : wcEtInvCompInv st g e'' hstg (wcEtUnitSheaf Y) ≫
          wcEtInvCompInv s t st hst ((wcEtInv g).obj (wcEtUnitSheaf Y)) =
        wcEtInvCompInv s e' e'' he'' (wcEtUnitSheaf Y) ≫
          (wcEtInv s).map (wcEtInvCompInv t g e' he' (wcEtUnitSheaf Y)) := by
      have h1 := wc_etInv_cocycle s t g st e' e'' hst he' he'' hstg (wcEtUnitSheaf Y)
      have p1 := wc_etInvComp_inv_pair st g e'' hstg (wcEtUnitSheaf Y)
      have p2 := wc_etInvComp_inv_pair s e' e'' he'' (wcEtUnitSheaf Y)
      have p3 := wc_etInvComp_inv_pair t g e' he' (wcEtUnitSheaf Y)
      have key : (wcEtInvCompInv s t st hst ((wcEtInv g).obj (wcEtUnitSheaf Y)) ≫
            (wcEtInv s).map (wcEtInvComp t g e' he' (wcEtUnitSheaf Y)) ≫
              wcEtInvComp s e' e'' he'' (wcEtUnitSheaf Y)) ≫
            wcEtInvCompInv s e' e'' he'' (wcEtUnitSheaf Y) ≫
              (wcEtInv s).map (wcEtInvCompInv t g e' he' (wcEtUnitSheaf Y)) =
          wcEtInvCompInv s t st hst ((wcEtInv g).obj (wcEtUnitSheaf Y)) := by
        simp only [Category.assoc]
        rw [reassoc_of% p2.1, ← CategoryTheory.Functor.map_comp, p3.1,
          CategoryTheory.Functor.map_id, Category.comp_id]
      rw [← key, h1, ← Category.assoc, p1.2, Category.id_comp]
    let τ : wcEtInv st ⟶ wcEtInv t ⋙ wcEtInv s :=
      { app := fun X => wcEtInvCompInv s t st hst X
        naturality := fun X X' f => wc_etInvCompInv_natural s t st hst f }
    have hNat : (Abelian.Ext.mapExactFunctor (wcEtInv st) y).comp
          (Abelian.Ext.mk₀ (wcEtInvCompInv s t st hst F)) (add_zero n) =
        (Abelian.Ext.mk₀ (wcEtInvCompInv s t st hst ((wcEtInv g).obj (wcEtUnitSheaf Y)))).comp
          (Abelian.Ext.mapExactFunctor (wcEtInv s) (Abelian.Ext.mapExactFunctor (wcEtInv t) y))
          (zero_add n) := by
      have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp y τ
      rw [Abelian.Ext.comp_mapExactFunctor] at h
      exact h
    rw [hPull t g e' he' F F' φ n, hPull s e' e'' he'' F' F'' φ' n, hPull st g e'' hstg F F'' _ n]
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀]
    rw [← Abelian.Ext.mk₀_comp_mk₀ (wcEtInvCompInv s t st hst F) ((wcEtInv s).map φ ≫ φ'),
      Abelian.Ext.comp_assoc_of_third_deg_zero
        (Abelian.Ext.mk₀ (wcEtInvCompInv st g e'' hstg (wcEtUnitSheaf Y)))
        (Abelian.Ext.mapExactFunctor (wcEtInv st) y) _ (zero_add n),
      ← Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor (wcEtInv st) y)
        (Abelian.Ext.mk₀ (wcEtInvCompInv s t st hst F))
        (Abelian.Ext.mk₀ ((wcEtInv s).map φ ≫ φ')) (add_zero n), hNat]
    simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, hU]

  have E1 : ∀ k l m (h₁ : k ≤ l) (h₂ : l ≤ m),
      (D.map (homOfLE h₂).op).left ≫ (D.map (homOfLE h₁).op).left =
        (D.map (homOfLE (h₁.trans h₂)).op).left := by
    intro k l m h₁ h₂
    exact (congrArg (fun f => f.left) (D.map_comp (homOfLE h₂).op (homOfLE h₁).op)).symm
  have E2 : ∀ k l (h : k ≤ l), (a l).left ≫ (D.map (homOfLE h).op).left = (a k).left := by
    intro k l h
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
    exact congrArg (fun f => f.left) (ha k j)

  have hββ : ∀ k l m (h₁ : k ≤ l) (h₂ : l ≤ m)
      (y : wcEtSysExt (D.obj (Opposite.op k)).hom (Q.F k) n),
      wcEtSysPull (D.map (homOfLE h₂).op).left (D.obj (Opposite.op l)).hom
          (D.obj (Opposite.op m)).hom (MorphismProperty.Over.w (D.map (homOfLE h₂).op))
          (Q.F l) (Q.F m) (Q.φ l m h₂) n
        (wcEtSysPull (D.map (homOfLE h₁).op).left (D.obj (Opposite.op k)).hom
          (D.obj (Opposite.op l)).hom (MorphismProperty.Over.w (D.map (homOfLE h₁).op))
          (Q.F k) (Q.F l) (Q.φ k l h₁) n y) =
      wcEtSysPull (D.map (homOfLE (h₁.trans h₂)).op).left (D.obj (Opposite.op k)).hom
          (D.obj (Opposite.op m)).hom (MorphismProperty.Over.w (D.map (homOfLE (h₁.trans h₂)).op))
          (Q.F k) (Q.F m) (Q.φ k m (h₁.trans h₂)) n y := by
    intro k l m h₁ h₂ y
    rw [hComp _ _ _ _ _ _ (E1 k l m h₁ h₂) _ _
      (MorphismProperty.Over.w (D.map (homOfLE (h₁.trans h₂)).op)),
      hQ.1 k l m h₁ h₂ (E1 k l m h₁ h₂)]
  have hβiβ : ∀ k l (h : k ≤ l) (y : wcEtSysExt (D.obj (Opposite.op k)).hom (Q.F k) n),
      wcEtSysPull (a l).left (D.obj (Opposite.op l)).hom Uinf.hom (MorphismProperty.Over.w (a l))
          (Q.F l) Q.Finf (Q.ψ l) n
        (wcEtSysPull (D.map (homOfLE h).op).left (D.obj (Opposite.op k)).hom
          (D.obj (Opposite.op l)).hom (MorphismProperty.Over.w (D.map (homOfLE h).op))
          (Q.F k) (Q.F l) (Q.φ k l h) n y) =
      wcEtSysPull (a k).left (D.obj (Opposite.op k)).hom Uinf.hom (MorphismProperty.Over.w (a k))
          (Q.F k) Q.Finf (Q.ψ k) n y := by
    intro k l h y
    rw [hComp _ _ _ _ _ _ (E2 k l h) _ _ (MorphismProperty.Over.w (a k)),
      hQ.2.1 k l h (E2 k l h)]
  have hαiα : ∀ k l (h : k ≤ l) (y : wcEtSysExt (D.obj (Opposite.op k)).hom (I.F k) n),
      wcEtSysPull (a l).left (D.obj (Opposite.op l)).hom Uinf.hom (MorphismProperty.Over.w (a l))
          (I.F l) I.Finf (I.ψ l) n
        (wcEtSysPull (D.map (homOfLE h).op).left (D.obj (Opposite.op k)).hom
          (D.obj (Opposite.op l)).hom (MorphismProperty.Over.w (D.map (homOfLE h).op))
          (I.F k) (I.F l) (I.φ k l h) n y) =
      wcEtSysPull (a k).left (D.obj (Opposite.op k)).hom Uinf.hom (MorphismProperty.Over.w (a k))
          (I.F k) I.Finf (I.ψ k) n y := by
    intro k l h y
    rw [hComp _ _ _ _ _ _ (E2 k l h) _ _ (MorphismProperty.Over.w (a k)),
      hI.2.1 k l h (E2 k l h)]

  unfold wcEtSysCont at hcI hcQ ⊢
  refine ⟨fun z => ?_, fun k c hc => ?_⟩
  · obtain ⟨yI, hyI⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hSinf z (hvan _) (rfl : n + 1 = n + 1)
    obtain ⟨k, y, hy⟩ := hcQ.1 yI
    refine ⟨k, Abelian.Ext.comp y (hS k).extClass rfl,
      (hPostExt (a k).left (D.obj (Opposite.op k)).hom Uinf.hom (MorphismProperty.Over.w (a k))
        _ (hS k) _ hSinf (A.ψ k) (I.ψ k) (Q.ψ k) (u.comm_ψ k) (p.comm_ψ k) n y).trans ?_⟩
    exact (congrArg (fun v => Abelian.Ext.comp v hSinf.extClass rfl) hy).trans hyI
  · obtain ⟨b, hb⟩ := Abelian.Ext.covariant_sequence_exact₁ _ (hS k) c
      (@Abelian.Ext.eq_zero_of_injective _ _ _ _ _ _ _ (hinj k) _) (rfl : n + 1 = n + 1)
    have h0 : Abelian.Ext.comp (wcEtSysPull (a k).left (D.obj (Opposite.op k)).hom Uinf.hom
        (MorphismProperty.Over.w (a k)) (Q.F k) Q.Finf (Q.ψ k) n b) hSinf.extClass rfl = 0 := by
      refine (hPostExt (a k).left (D.obj (Opposite.op k)).hom Uinf.hom
        (MorphismProperty.Over.w (a k)) _ (hS k) _ hSinf (A.ψ k) (I.ψ k) (Q.ψ k) (u.comm_ψ k)
        (p.comm_ψ k) n b).symm.trans ?_
      exact (congrArg (wcEtSysPull (a k).left (D.obj (Opposite.op k)).hom Uinf.hom
        (MorphismProperty.Over.w (a k)) (A.F k) A.Finf (A.ψ k) (n + 1)) hb).trans hc
    obtain ⟨xI, hxI⟩ := Abelian.Ext.covariant_sequence_exact₃ _ hSinf _ (rfl : n + 1 = n + 1) h0
    have hxI' : Abelian.Ext.comp xI (Abelian.Ext.mk₀ p.finf) (add_zero n) =
        wcEtSysPull (a k).left (D.obj (Opposite.op k)).hom Uinf.hom
          (MorphismProperty.Over.w (a k)) (Q.F k) Q.Finf (Q.ψ k) n b := hxI
    obtain ⟨m, x, hx⟩ := hcI.1 xI
    have h₁ : k ≤ k + m := Nat.le_add_right k m
    have h₂ : m ≤ k + m := Nat.le_add_left m k
    obtain ⟨c₂, hc₂⟩ : ∃ c₂ : wcEtSysExt (D.obj (Opposite.op (k + m))).hom (Q.F (k + m)) n,
        c₂ = Abelian.Ext.comp (wcEtSysPull (D.map (homOfLE h₂).op).left (D.obj (Opposite.op m)).hom
            (D.obj (Opposite.op (k + m))).hom (MorphismProperty.Over.w (D.map (homOfLE h₂).op))
            (I.F m) (I.F (k + m)) (I.φ m (k + m) h₂) n x) (Abelian.Ext.mk₀ (p.f (k + m)))
            (add_zero n) := ⟨_, rfl⟩
    obtain ⟨b1, hb1⟩ : ∃ b1 : wcEtSysExt (D.obj (Opposite.op (k + m))).hom (Q.F (k + m)) n,
        b1 = wcEtSysPull (D.map (homOfLE h₁).op).left (D.obj (Opposite.op k)).hom
            (D.obj (Opposite.op (k + m))).hom (MorphismProperty.Over.w (D.map (homOfLE h₁).op))
            (Q.F k) (Q.F (k + m)) (Q.φ k (k + m) h₁) n b := ⟨_, rfl⟩
    obtain ⟨b', hb'def⟩ : ∃ b' : wcEtSysExt (D.obj (Opposite.op (k + m))).hom (Q.F (k + m)) n,
        b' = b1 - c₂ := ⟨_, rfl⟩
    have hb' : wcEtSysPull (a (k + m)).left (D.obj (Opposite.op (k + m))).hom Uinf.hom
        (MorphismProperty.Over.w (a (k + m))) (Q.F (k + m)) Q.Finf (Q.ψ (k + m)) n b' = 0 := by
      rw [hb'def, map_sub, hb1, hβiβ k (k + m) h₁ b, hc₂,
        hPostMk (a (k + m)).left (D.obj (Opposite.op (k + m))).hom Uinf.hom
          (MorphismProperty.Over.w (a (k + m))) (I.F (k + m)) (Q.F (k + m)) I.Finf Q.Finf
          (I.ψ (k + m)) (Q.ψ (k + m)) (p.f (k + m)) p.finf (p.comm_ψ (k + m)) n _,
        hαiα m (k + m) h₂ x, hx, hxI', sub_self]
    obtain ⟨l', h₃, hl'⟩ := hcQ.2 (k + m) b' hb'
    have e1 : wcEtSysPull (D.map (homOfLE (h₁.trans h₃)).op).left (D.obj (Opposite.op k)).hom
          (D.obj (Opposite.op l')).hom (MorphismProperty.Over.w (D.map (homOfLE (h₁.trans h₃)).op))
          (Q.F k) (Q.F l') (Q.φ k l' (h₁.trans h₃)) n b =
        Abelian.Ext.comp (wcEtSysPull (D.map (homOfLE h₃).op).left (D.obj (Opposite.op (k + m))).hom
          (D.obj (Opposite.op l')).hom (MorphismProperty.Over.w (D.map (homOfLE h₃).op))
          (I.F (k + m)) (I.F l') (I.φ (k + m) l' h₃) n
          (wcEtSysPull (D.map (homOfLE h₂).op).left (D.obj (Opposite.op m)).hom
            (D.obj (Opposite.op (k + m))).hom (MorphismProperty.Over.w (D.map (homOfLE h₂).op))
            (I.F m) (I.F (k + m)) (I.φ m (k + m) h₂) n x)) (Abelian.Ext.mk₀ (p.f l')) (add_zero n) := by
      rw [← hββ k (k + m) l' h₁ h₃ b, ← hb1, sub_eq_iff_eq_add.mp hb'def.symm, map_add, hl', zero_add, hc₂,
        hPostMk (D.map (homOfLE h₃).op).left (D.obj (Opposite.op (k + m))).hom
          (D.obj (Opposite.op l')).hom (MorphismProperty.Over.w (D.map (homOfLE h₃).op))
          (I.F (k + m)) (Q.F (k + m)) (I.F l') (Q.F l') (I.φ (k + m) l' h₃) (Q.φ (k + m) l' h₃)
          (p.f (k + m)) (p.f l') (p.comm_φ (k + m) l' h₃) n _]
    have hce : (Abelian.Ext.mk₀ (p.f l')).comp (hS l').extClass (zero_add 1) = 0 :=
      (hS l').comp_extClass
    refine ⟨l', h₁.trans h₃, ?_⟩
    rw [← hb]
    refine (hPostExt (D.map (homOfLE (h₁.trans h₃)).op).left (D.obj (Opposite.op k)).hom
      (D.obj (Opposite.op l')).hom (MorphismProperty.Over.w (D.map (homOfLE (h₁.trans h₃)).op))
      _ (hS k) _ (hS l') (A.φ k l' (h₁.trans h₃)) (I.φ k l' (h₁.trans h₃)) (Q.φ k l' (h₁.trans h₃))
      (u.comm_φ k l' (h₁.trans h₃)) (p.comm_φ k l' (h₁.trans h₃)) n b).trans ?_
    refine (congrArg (fun v => Abelian.Ext.comp v (hS l').extClass rfl) e1).trans ?_
    rw [Abelian.Ext.comp_assoc_of_second_deg_zero, hce, Abelian.Ext.comp_zero]

theorem wc_etale_tower_continuity (S : Scheme.{u})
    (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left) (n : ℕ) :
    (∀ e : wcEtInvExt Uinf.hom (wcEtUnitSheaf S) G (n + 1),
      ∃ k, ∃ y : wcEtInvExt (D.obj (Opposite.op k)).hom (wcEtUnitSheaf S) G (n + 1),
        wcEtInvExtPull (a k).left (D.obj (Opposite.op k)).hom Uinf.hom
          (MorphismProperty.Over.w (a k)) (wcEtUnitSheaf S) G (n + 1) y = e) ∧
    (∀ k (y : wcEtInvExt (D.obj (Opposite.op k)).hom (wcEtUnitSheaf S) G (n + 1)),
      wcEtInvExtPull (a k).left (D.obj (Opposite.op k)).hom Uinf.hom
          (MorphismProperty.Over.w (a k)) (wcEtUnitSheaf S) G (n + 1) y = 0 →
      ∃ j, wcEtInvExtPull (D.map (homOfLE (Nat.le_add_right k j)).op).left
          (D.obj (Opposite.op k)).hom (D.obj (Opposite.op (k + j))).hom
          (MorphismProperty.Over.w (D.map (homOfLE (Nat.le_add_right k j)).op))
          (wcEtUnitSheaf S) G (n + 1) y = 0) :=
by
  have H : ∀ m (A : wcEtSys D a), wcEtSysOK A → wcEtSysCont A m := by
    intro m
    induction m with
    | zero =>
      intro A hA
      exact wc_et_sys_degree0_continuity S D a ha hlim hqc haff A hA
    | succ m ih =>
      intro A hA
      obtain ⟨I, Q, u, p, w, winf, hI, hQ, hinj, hS, hSinf⟩ :=
        wc_et_sys_injective_resolution S D a ha A hA
      exact wc_et_sys_cont_step S D a ha A I Q hA hI hQ u p w winf hS hSinf hinj m
        (wc_et_sys_injective_colim_acyclic S D a ha hlim hqc haff I hI hinj m)
        (ih I hI) (ih Q hQ)
  obtain ⟨hs, hi⟩ := H (n + 1) (wcEtBaseSys D a G) (wc_et_base_sys_ok D a G)
  refine ⟨fun e => ?_, fun k y hy => ?_⟩
  · obtain ⟨k, y, hy⟩ := hs e
    exact ⟨k, y, hy⟩
  · obtain ⟨l, h, hl⟩ := hi k y hy
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
    exact ⟨j, hl⟩

theorem wc_lfd_free_continuity (S : Scheme.{u}) (m dd : ℕ) {Uinf : S.ProEt}
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left)
    (i : ℕ) :
    (∀ x : Abelian.Ext (wcFreeSheaf S Uinf) (wcRootTwist S m dd) i,
      ∃ k, ∃ y : Abelian.Ext (wcFreeSheaf S (D.obj (Opposite.op k))) (wcRootTwist S m dd) i,
        (Abelian.Ext.mk₀ (wcFreeSheafMap S (a k))).comp y (zero_add i) = x) ∧
    (∀ k (y : Abelian.Ext (wcFreeSheaf S (D.obj (Opposite.op k))) (wcRootTwist S m dd) i),
      (Abelian.Ext.mk₀ (wcFreeSheafMap S (a k))).comp y (zero_add i) = 0 →
      ∃ j, (Abelian.Ext.mk₀ (wcFreeSheafMap S
        (D.map (homOfLE (Nat.le_add_right k j)).op))).comp y (zero_add i) = 0) :=
by
  classical
  have hA : ∀ {A B Z T : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : A ⟶ B)
      {n p q : ℕ} (z : Abelian.Ext B Z n) (w : Abelian.Ext Z T p) (h : n + p = q),
      (Abelian.Ext.mk₀ f).comp (z.comp w h) (zero_add q) =
        ((Abelian.Ext.mk₀ f).comp z (zero_add n)).comp w h := by
    intro A B Z T f n p q z w h
    exact (Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ f) z w (zero_add n) h (by omega)).symm
  obtain ⟨hcU, hqU⟩ := wc_lfd_limit_qcqs S D a ha hlim hqc haff

  have main : ∀ G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1},
      (∀ x : Abelian.Ext (wcFreeSheaf S Uinf) ((wcEpsInv S).obj G) i,
        ∃ k, ∃ y : Abelian.Ext (wcFreeSheaf S (D.obj (Opposite.op k))) ((wcEpsInv S).obj G) i,
          (Abelian.Ext.mk₀ (wcFreeSheafMap S (a k))).comp y (zero_add i) = x) ∧
      (∀ k (y : Abelian.Ext (wcFreeSheaf S (D.obj (Opposite.op k))) ((wcEpsInv S).obj G) i),
        (Abelian.Ext.mk₀ (wcFreeSheafMap S (a k))).comp y (zero_add i) = 0 →
        ∃ j, (Abelian.Ext.mk₀ (wcFreeSheafMap S
          (D.map (homOfLE (Nat.le_add_right k j)).op))).comp y (zero_add i) = 0) := by
    intro G
    cases i with
    | zero => exact wc_epsInv_tower_ext0_continuity S G D a ha hlim hqc haff
    | succ n =>
      obtain ⟨Θ, hbij, hnat⟩ := wc_etale_proet_comparison S G (n + 1)
      obtain ⟨cs, ci⟩ := wc_etale_tower_continuity S G D a ha hlim hqc haff n
      refine ⟨fun x => ?_, fun k y hy => ?_⟩
      · obtain ⟨e, rfl⟩ := (hbij Uinf hcU hqU).2 x
        obtain ⟨k, y, hy⟩ := cs e
        refine ⟨k, Θ _ y, ?_⟩
        rw [← hnat _ _ (a k) (hqc k).1 (hqc k).2 hcU hqU, hy]
      · obtain ⟨yE, rfl⟩ := (hbij _ (hqc k).1 (hqc k).2).2 y
        have h0 : wcEtInvExtPull (a k).left (D.obj (Opposite.op k)).hom Uinf.hom
            (MorphismProperty.Over.w (a k)) (wcEtUnitSheaf S) G (n + 1) yE = 0 := by
          apply (hbij Uinf hcU hqU).1
          rw [hnat _ _ (a k) (hqc k).1 (hqc k).2 hcU hqU, hy, map_zero]
        obtain ⟨j, hj⟩ := ci k yE h0
        refine ⟨j, ?_⟩
        rw [← hnat _ _ _ (hqc k).1 (hqc k).2 (hqc (k + j)).1 (hqc (k + j)).2, hj, map_zero]

  obtain ⟨G₀, ⟨e⟩⟩ := wc_root_twist_classical S m dd
  obtain ⟨hsurj, hinj⟩ := main G₀
  have hround : ∀ {A : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}
      (z : Abelian.Ext A (wcRootTwist S m dd) i),
      (z.comp (Abelian.Ext.mk₀ e.hom) (add_zero i)).comp (Abelian.Ext.mk₀ e.inv) (add_zero i) = z := by
    intro A z
    rw [Abelian.Ext.comp_assoc z (Abelian.Ext.mk₀ e.hom) (Abelian.Ext.mk₀ e.inv) (add_zero i)
      (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id, Abelian.Ext.comp_mk₀_id]
  refine ⟨fun x => ?_, fun k y hy => ?_⟩
  · obtain ⟨k, y', hy'⟩ := hsurj (x.comp (Abelian.Ext.mk₀ e.hom) (add_zero i))
    refine ⟨k, y'.comp (Abelian.Ext.mk₀ e.inv) (add_zero i), ?_⟩
    rw [hA, hy', hround]
  · obtain ⟨j, hj⟩ := hinj k (y.comp (Abelian.Ext.mk₀ e.hom) (add_zero i))
      (by rw [hA, hy, Abelian.Ext.zero_comp])
    refine ⟨j, ?_⟩
    rw [← hround y, hA, hj, Abelian.Ext.zero_comp]

theorem wc_lfd_continuity (S : Scheme.{u}) (m dd : ℕ) {B VB Uinf Vinf : S.ProEt}
    (ιB : VB ⟶ B) (hιB : IsOpenImmersion ιB.left)
    (D : ℕᵒᵖ ⥤ S.ProEt) (a : ∀ k, Uinf ⟶ D.obj (Opposite.op k))
    (b : ∀ k, D.obj (Opposite.op k) ⟶ B) (binf : Uinf ⟶ B)
    (ha : ∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k)
    (hDb : ∀ k j, D.map (homOfLE (Nat.le_add_right k j)).op ≫ b k = b (k + j))
    (hab : ∀ k, a k ≫ b k = binf)
    (hlim : ∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ Uinf.left, ∀ k, z₀ ≫ (a k).left = z k)
    (hqc : ∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left)
    (haff : ∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left)
    (V : ℕ → S.ProEt) (ι : ∀ k, V k ⟶ D.obj (Opposite.op k))
    (hι : ∀ k, IsOpenImmersion (ι k).left)
    (hrι : ∀ k, Set.range (ι k).left = (b k).left ⁻¹' Set.range ιB.left)
    (hcV : ∀ k, CompactSpace (V k).left)
    (ιinf : Vinf ⟶ Uinf) (hιinf : IsOpenImmersion ιinf.left)
    (hrinf : Set.range ιinf.left = binf.left ⁻¹' Set.range ιB.left)
    (α : ∀ k, Limits.cokernel (wcFreeSheafMap S ιinf) ⟶ Limits.cokernel (wcFreeSheafMap S (ι k)))
    (hα : ∀ k, Limits.cokernel.π (wcFreeSheafMap S ιinf) ≫ α k =
      wcFreeSheafMap S (a k) ≫ Limits.cokernel.π (wcFreeSheafMap S (ι k)))
    (pR : ∀ k j, Limits.cokernel (wcFreeSheafMap S (ι (k + j))) ⟶
      Limits.cokernel (wcFreeSheafMap S (ι k)))
    (hpR : ∀ k j, Limits.cokernel.π (wcFreeSheafMap S (ι (k + j))) ≫ pR k j =
      wcFreeSheafMap S (D.map (homOfLE (Nat.le_add_right k j)).op) ≫
        Limits.cokernel.π (wcFreeSheafMap S (ι k)))
    (i : ℕ) :
    (∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S ιinf)) (wcRootTwist S m dd) i,
      ∃ k, ∃ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S (ι k))) (wcRootTwist S m dd) i,
        (Abelian.Ext.mk₀ (α k)).comp y (zero_add i) = x) ∧
    (∀ k (y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap S (ι k))) (wcRootTwist S m dd) i),
      (Abelian.Ext.mk₀ (α k)).comp y (zero_add i) = 0 →
      ∃ j, (Abelian.Ext.mk₀ (pR k j)).comp y (zero_add i) = 0) :=
by
  classical

  have hfun : ∀ {A B C : S.ProEt} (a : A ⟶ B) (b : B ⟶ C),
      wcFreeSheafMap S a ≫ wcFreeSheafMap S b = wcFreeSheafMap S (a ≫ b) := by
    intro A B C a b
    have e : Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight (yoneda.map (a ≫ b))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
      first
        | rw [yoneda.map_comp, Functor.whiskerRight_comp]
        | (apply NatTrans.ext; funext V; simp [← Functor.map_comp])
    exact ((presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      (congrArg (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map e)
  have hpt : ∀ {P₁ P₂ P₃ : Scheme.{u}} (f : P₁ ⟶ P₂) (f' : P₂ ⟶ P₃) (f'' : P₁ ⟶ P₃),
      f ≫ f' = f'' → ∀ y, f' (f y) = f'' y := by
    intro P₁ P₂ P₃ f f' f'' e y
    rw [← e, Scheme.Hom.comp_apply]

  have hhom : ∀ k l (f g : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k), f = g := by
    intro k l f g
    exact Quiver.Hom.unop_inj (Subsingleton.elim _ _)
  have haL : ∀ k l (h : k ≤ l), a l ≫ D.map (homOfLE h).op = a k := by
    intro k l h
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
    exact ha k j
  have hbf : ∀ k l (f : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k), D.map f ≫ b k = b l := by
    intro k l f
    have h : k ≤ l := leOfHom f.unop
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
    rw [hhom _ _ f (homOfLE (Nat.le_add_right k j)).op]
    exact hDb k j

  have HV : ∀ k l (f : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k),
      Set.range ((ι l).left ≫ (D.map f).left) ⊆ Set.range (ι k).left := by
    rintro k l f _ ⟨v, rfl⟩
    rw [hrι k]
    show (b k).left ((D.map f).left ((ι l).left v)) ∈ Set.range ιB.left
    rw [hpt _ _ _ (congrArg (fun t => t.left) (hbf k l f))]
    have hv : (ι l).left v ∈ Set.range (ι l).left := ⟨v, rfl⟩
    rw [hrι l] at hv
    exact hv
  have hex : ∀ k l (f : (Opposite.op l : ℕᵒᵖ) ⟶ Opposite.op k),
      ∃ φ : V l ⟶ V k, φ ≫ ι k = ι l ≫ D.map f := by
    intro k l f
    haveI := hι k
    let L : (V l).left ⟶ (V k).left :=
      IsOpenImmersion.lift (ι k).left ((ι l).left ≫ (D.map f).left) (HV k l f)
    have hLfac : L ≫ (ι k).left = (ι l).left ≫ (D.map f).left := IsOpenImmersion.lift_fac _ _ _
    have hLw : L ≫ (V k).hom = (V l).hom := by
      rw [← MorphismProperty.Over.w (ι k), ← Category.assoc, hLfac, Category.assoc,
        MorphismProperty.Over.w (D.map f), MorphismProperty.Over.w (ι l)]
    exact ⟨MorphismProperty.Over.homMk L hLw trivial, MorphismProperty.Over.Hom.ext hLfac⟩
  choose tV htV using hex
  have hmonoL : ∀ k, Mono (ι k).left := by
    intro k
    haveI := hι k
    infer_instance
  have hmono : ∀ k {Z : S.ProEt} (g₁ g₂ : Z ⟶ V k), g₁ ≫ ι k = g₂ ≫ ι k → g₁ = g₂ := by
    intro k Z g₁ g₂ h
    haveI := hmonoL k
    apply MorphismProperty.Over.Hom.ext
    exact (cancel_mono (ι k).left).mp (congrArg (fun t => t.left) h)

  let DV : ℕᵒᵖ ⥤ S.ProEt :=
    { obj := fun k => V k.unop
      map := fun {k l} f => tV l.unop k.unop f
      map_id := by
        intro k
        apply hmono
        rw [htV, D.map_id, Category.comp_id, Category.id_comp]
      map_comp := by
        intro k l n f g
        apply hmono
        rw [htV n.unop k.unop (f ≫ g), Category.assoc, htV n.unop l.unop g, ← Category.assoc,
          htV l.unop k.unop f, Category.assoc, ← D.map_comp] }
  have hDV : ∀ k j, DV.map (homOfLE (Nat.le_add_right k j)).op ≫ ι k =
      ι (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op := fun k j => htV k (k + j) _

  have hexA : ∀ k, ∃ φ : Vinf ⟶ V k, φ ≫ ι k = ιinf ≫ a k := by
    intro k
    haveI := hι k
    have H : Set.range (ιinf.left ≫ (a k).left) ⊆ Set.range (ι k).left := by
      rintro _ ⟨v, rfl⟩
      rw [hrι k]
      show (b k).left ((a k).left (ιinf.left v)) ∈ Set.range ιB.left
      rw [hpt _ _ _ (congrArg (fun t => t.left) (hab k))]
      have hv : ιinf.left v ∈ Set.range ιinf.left := ⟨v, rfl⟩
      rw [hrinf] at hv
      exact hv
    let L : Vinf.left ⟶ (V k).left := IsOpenImmersion.lift (ι k).left (ιinf.left ≫ (a k).left) H
    have hLfac : L ≫ (ι k).left = ιinf.left ≫ (a k).left := IsOpenImmersion.lift_fac _ _ _
    have hLw : L ≫ (V k).hom = Vinf.hom := by
      rw [← MorphismProperty.Over.w (ι k), ← Category.assoc, hLfac, Category.assoc,
        MorphismProperty.Over.w (a k), MorphismProperty.Over.w ιinf]
    exact ⟨MorphismProperty.Over.homMk L hLw trivial, MorphismProperty.Over.Hom.ext hLfac⟩
  choose aV haV using hexA

  obtain ⟨haV', hlimV, hqcV, haffV⟩ := wc_lfd_open_subtower S ιB D a b binf ha hDb hab hlim hqc
    haff DV ι hι hrι hcV hDV ιinf hιinf hrinf aV haV

  have cU := wc_lfd_free_continuity S m dd D a ha hlim hqc haff
  have cV := wc_lfd_free_continuity S m dd DV aV haV' hlimV hqcV haffV

  have wkl : ∀ k l (h : k ≤ l), wcFreeSheafMap S (ι l) ≫ (wcFreeSheafMap S (D.map (homOfLE h).op) ≫
      Limits.cokernel.π (wcFreeSheafMap S (ι k))) = 0 := by
    intro k l h
    rw [← Category.assoc, hfun, ← htV k l (homOfLE h).op, ← hfun, Category.assoc,
      Limits.cokernel.condition, Limits.comp_zero]
  have hexQ : ∀ k l (h : k ≤ l), ∃ q : Limits.cokernel (wcFreeSheafMap S (ι l)) ⟶
      Limits.cokernel (wcFreeSheafMap S (ι k)),
      Limits.cokernel.π (wcFreeSheafMap S (ι l)) ≫ q =
        wcFreeSheafMap S (D.map (homOfLE h).op) ≫ Limits.cokernel.π (wcFreeSheafMap S (ι k)) :=
    fun k l h => ⟨Limits.cokernel.desc _ _ (wkl k l h), Limits.cokernel.π_desc _ _ _⟩
  choose pQ hpQπ using hexQ

  have hS : ∀ k, (ShortComplex.mk (wcFreeSheafMap S (ι k))
      (Limits.cokernel.π (wcFreeSheafMap S (ι k))) (Limits.cokernel.condition _)).ShortExact :=
    fun k => ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _)
      (wc_free_sheaf_map_mono S _ _ (ι k) (hmonoL k)) inferInstance
  have hmonoinf : Mono ιinf.left := by
    haveI := hιinf
    infer_instance
  have hSinf : (ShortComplex.mk (wcFreeSheafMap S ιinf)
      (Limits.cokernel.π (wcFreeSheafMap S ιinf)) (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _)
      (wc_free_sheaf_map_mono S _ _ ιinf hmonoinf) inferInstance
  have hfα : ∀ k, wcFreeSheafMap S (aV k) ≫ wcFreeSheafMap S (ι k) =
      wcFreeSheafMap S ιinf ≫ wcFreeSheafMap S (a k) := by
    intro k
    rw [hfun, hfun, haV k]
  have hgα : ∀ k, wcFreeSheafMap S (a k) ≫ Limits.cokernel.π (wcFreeSheafMap S (ι k)) =
      Limits.cokernel.π (wcFreeSheafMap S ιinf) ≫ α k := fun k => (hα k).symm
  have hfp : ∀ k l (h : k ≤ l), wcFreeSheafMap S (tV k l (homOfLE h).op) ≫ wcFreeSheafMap S (ι k) =
      wcFreeSheafMap S (ι l) ≫ wcFreeSheafMap S (D.map (homOfLE h).op) := by
    intro k l h
    rw [hfun, hfun, htV]
  have hgp : ∀ k l (h : k ≤ l), wcFreeSheafMap S (D.map (homOfLE h).op) ≫
      Limits.cokernel.π (wcFreeSheafMap S (ι k)) =
      Limits.cokernel.π (wcFreeSheafMap S (ι l)) ≫ pQ k l h := fun k l h => (hpQπ k l h).symm
  have haVL : ∀ k l (h : k ≤ l), aV l ≫ tV k l (homOfLE h).op = aV k := by
    intro k l h
    apply hmono k
    rw [Category.assoc, htV k l (homOfLE h).op, ← Category.assoc, haV l, Category.assoc,
      haL k l h, haV k]
  have hαA : ∀ k l (h : k ≤ l), wcFreeSheafMap S (aV l) ≫ wcFreeSheafMap S (tV k l (homOfLE h).op) =
      wcFreeSheafMap S (aV k) := by
    intro k l h
    rw [hfun, haVL k l h]
  have hαB : ∀ k l (h : k ≤ l), wcFreeSheafMap S (a l) ≫ wcFreeSheafMap S (D.map (homOfLE h).op) =
      wcFreeSheafMap S (a k) := by
    intro k l h
    rw [hfun, haL k l h]
  have hαQ : ∀ k l (h : k ≤ l), α l ≫ pQ k l h = α k := by
    intro k l h
    rw [← cancel_epi (Limits.cokernel.π (wcFreeSheafMap S ιinf)), ← Category.assoc, hα l,
      Category.assoc, hpQπ k l h, ← Category.assoc, hfun, haL k l h, hα k]
  have hpA : ∀ k l n (h₁ : k ≤ l) (h₂ : l ≤ n),
      wcFreeSheafMap S (tV l n (homOfLE h₂).op) ≫ wcFreeSheafMap S (tV k l (homOfLE h₁).op) =
        wcFreeSheafMap S (tV k n (homOfLE (h₁.trans h₂)).op) := by
    intro k l n h₁ h₂
    rw [hfun]
    congr 1
    apply hmono k
    rw [Category.assoc, htV k l (homOfLE h₁).op, ← Category.assoc, htV l n (homOfLE h₂).op,
      Category.assoc, ← D.map_comp, htV k n (homOfLE (h₁.trans h₂)).op,
      hhom _ _ ((homOfLE h₂).op ≫ (homOfLE h₁).op) (homOfLE (h₁.trans h₂)).op]
  have hpQ : ∀ k l n (h₁ : k ≤ l) (h₂ : l ≤ n),
      pQ l n h₂ ≫ pQ k l h₁ = pQ k n (h₁.trans h₂) := by
    intro k l n h₁ h₂
    rw [← cancel_epi (Limits.cokernel.π (wcFreeSheafMap S (ι n))), ← Category.assoc,
      hpQπ l n h₂, Category.assoc, hpQπ k l h₁, ← Category.assoc, hfun, ← D.map_comp,
      hpQπ k n (h₁.trans h₂),
      hhom _ _ ((homOfLE h₂).op ≫ (homOfLE h₁).op) (homOfLE (h₁.trans h₂)).op]
  have surjA : ∀ n (x : Abelian.Ext (wcFreeSheaf S Vinf) (wcRootTwist S m dd) n),
      ∃ k, ∃ y : Abelian.Ext (wcFreeSheaf S (V k)) (wcRootTwist S m dd) n,
        (Abelian.Ext.mk₀ (wcFreeSheafMap S (aV k))).comp y (zero_add n) = x :=
    fun n => (cV n).1
  have injA : ∀ n k (y : Abelian.Ext (wcFreeSheaf S (V k)) (wcRootTwist S m dd) n),
      (Abelian.Ext.mk₀ (wcFreeSheafMap S (aV k))).comp y (zero_add n) = 0 →
      ∃ l, ∃ h : k ≤ l,
        (Abelian.Ext.mk₀ (wcFreeSheafMap S (tV k l (homOfLE h).op))).comp y (zero_add n) = 0 := by
    intro n k y hy
    obtain ⟨j, hj⟩ := (cV n).2 k y hy
    exact ⟨k + j, Nat.le_add_right k j, hj⟩
  have surjB : ∀ n (x : Abelian.Ext (wcFreeSheaf S Uinf) (wcRootTwist S m dd) n),
      ∃ k, ∃ y : Abelian.Ext (wcFreeSheaf S (D.obj (Opposite.op k))) (wcRootTwist S m dd) n,
        (Abelian.Ext.mk₀ (wcFreeSheafMap S (a k))).comp y (zero_add n) = x :=
    fun n => (cU n).1
  have injB : ∀ n k (y : Abelian.Ext (wcFreeSheaf S (D.obj (Opposite.op k))) (wcRootTwist S m dd) n),
      (Abelian.Ext.mk₀ (wcFreeSheafMap S (a k))).comp y (zero_add n) = 0 →
      ∃ l, ∃ h : k ≤ l,
        (Abelian.Ext.mk₀ (wcFreeSheafMap S (D.map (homOfLE h).op))).comp y (zero_add n) = 0 := by
    intro n k y hy
    obtain ⟨j, hj⟩ := (cU n).2 k y hy
    exact ⟨k + j, Nat.le_add_right k j, hj⟩

  obtain ⟨hsurjQ, hinjQ⟩ := wc_lfd_ext_tower_five (wcRootTwist S m dd)
    (fun k => wcFreeSheaf S (V k)) (fun k => wcFreeSheaf S (D.obj (Opposite.op k)))
    (fun k => Limits.cokernel (wcFreeSheafMap S (ι k)))
    (wcFreeSheaf S Vinf) (wcFreeSheaf S Uinf) (Limits.cokernel (wcFreeSheafMap S ιinf))
    (fun k => wcFreeSheafMap S (ι k)) (fun k => Limits.cokernel.π (wcFreeSheafMap S (ι k)))
    (fun k => Limits.cokernel.condition _) hS
    (wcFreeSheafMap S ιinf) (Limits.cokernel.π (wcFreeSheafMap S ιinf))
    (Limits.cokernel.condition _) hSinf
    (fun k => wcFreeSheafMap S (aV k)) (fun k => wcFreeSheafMap S (a k)) α hfα hgα
    (fun k l h => wcFreeSheafMap S (tV k l (homOfLE h).op))
    (fun k l h => wcFreeSheafMap S (D.map (homOfLE h).op)) pQ
    hfp hgp hαA hαB hαQ hpA hpQ surjA injA surjB injB i

  refine ⟨hsurjQ, fun k y hy => ?_⟩
  obtain ⟨l, h, hl⟩ := hinjQ k y hy
  obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
  refine ⟨j, ?_⟩
  have e : pQ k (k + j) h = pR k j := by
    rw [← cancel_epi (Limits.cokernel.π (wcFreeSheafMap S (ι (k + j)))), hpQπ k (k + j) h, hpR k j]
  rw [← e]
  exact hl

theorem wc_rpc_local_frob_descent (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n : ℕ) (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E]
    (hU : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))))
    (s₀ : wcGeomPoint F X h ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt))
    (σ : Spec (.of E) ⟶ Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))))
    (hσ : σ ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) = 𝟙 _)
    (VE : X.left.ProEt) (ιE : VE ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt))
    (hιE : IsOpenImmersion ιE.left) (hrE : Set.range ιE.left = (Set.range σ)ᶜ)
    (V₀ : X.left.ProEt) (ι₀ : V₀ ⟶ wcGeomPoint F X h)
    (hι₀ : IsOpenImmersion ι₀.left) (hr₀ : Set.range ι₀.left = s₀.left ⁻¹' (Set.range σ)ᶜ)
    (q : Limits.cokernel (wcFreeSheafMap X.left ι₀) ⟶ Limits.cokernel (wcFreeSheafMap X.left ιE))
    (hq : Limits.cokernel.π (wcFreeSheafMap X.left ι₀) ≫ q =
      wcFreeSheafMap X.left s₀ ≫ Limits.cokernel.π (wcFreeSheafMap X.left ιE))
    (t : ℕ → (wcGeomPoint F X h ⟶ wcGeomPoint F X h)) (ht0 : t 0 = 𝟙 _)
    (hts : ∀ j, t (j + 1) = wcGeomFrob F X h ≫ t j)
    (hfix : t (Module.finrank F E) ≫ s₀ = s₀)
    (Φ : Limits.cokernel (wcFreeSheafMap X.left ι₀) ⟶ Limits.cokernel (wcFreeSheafMap X.left ι₀))
    (hΦ : Limits.cokernel.π (wcFreeSheafMap X.left ι₀) ≫ Φ =
      wcFreeSheafMap X.left (t (Module.finrank F E)) ≫ Limits.cokernel.π (wcFreeSheafMap X.left ι₀))
    (i : ℕ)
    (x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀)) (wcRootTwist X.left (ℓ ^ n) d) i)
    (hx : (Abelian.Ext.mk₀ Φ).comp x (zero_add i) = x) :
    ∃ g : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ιE)) (wcRootTwist X.left (ℓ ^ n) d) i,
      (Abelian.Ext.mk₀ q).comp g (zero_add i) = x :=
by
  classical

  have hfun : ∀ {A B C : X.left.ProEt} (a : A ⟶ B) (b : B ⟶ C),
      wcFreeSheafMap X.left a ≫ wcFreeSheafMap X.left b = wcFreeSheafMap X.left (a ≫ b) := by
    intro A B C a b
    have e : Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight (yoneda.map (a ≫ b))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
      first
        | rw [yoneda.map_comp, Functor.whiskerRight_comp]
        | (apply NatTrans.ext; funext V; simp [← Functor.map_comp])
    exact ((presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      (congrArg (presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map e)
  have hid : ∀ A : X.left.ProEt, wcFreeSheafMap X.left (𝟙 A) = 𝟙 _ := by
    intro A
    have e : Functor.whiskerRight (yoneda.map (𝟙 A)) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        𝟙 _ := by
      first
        | rw [yoneda.map_id, Functor.whiskerRight_id']
        | (apply NatTrans.ext; funext V; simp)
    exact (congrArg (presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map e).trans
      ((presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map_id _)

  have cdesc : ∀ {U U' V V' : X.left.ProEt} (f : U ⟶ U') (ι : V ⟶ U) (ι' : V' ⟶ U')
      (hι' : IsOpenImmersion ι'.left) (H : Set.range (ι.left ≫ f.left) ⊆ Set.range ι'.left),
      ∃ fb : Limits.cokernel (wcFreeSheafMap X.left ι) ⟶ Limits.cokernel (wcFreeSheafMap X.left ι'),
        Limits.cokernel.π (wcFreeSheafMap X.left ι) ≫ fb =
          wcFreeSheafMap X.left f ≫ Limits.cokernel.π (wcFreeSheafMap X.left ι') := by
    intro U U' V V' f ι ι' hι' H
    let L : V.left ⟶ V'.left := IsOpenImmersion.lift ι'.left (ι.left ≫ f.left) H
    have hLfac : L ≫ ι'.left = ι.left ≫ f.left := IsOpenImmersion.lift_fac _ _ H
    have hLw : L ≫ V'.hom = V.hom := by
      rw [← MorphismProperty.Over.w ι', ← Category.assoc, hLfac, Category.assoc,
        MorphismProperty.Over.w f, MorphismProperty.Over.w ι]
    let φ : V ⟶ V' := MorphismProperty.Over.homMk L hLw trivial
    have hφ : φ ≫ ι' = ι ≫ f := MorphismProperty.Over.Hom.ext hLfac
    have hw : wcFreeSheafMap X.left ι ≫ (wcFreeSheafMap X.left f ≫
        Limits.cokernel.π (wcFreeSheafMap X.left ι')) = 0 := by
      rw [← Category.assoc, hfun, ← hφ, ← hfun, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    exact ⟨Limits.cokernel.desc _ _ hw, Limits.cokernel.π_desc _ _ _⟩
  have hcomp : ∀ {W₁ A₁ W₂ A₂ W₃ A₃ : X.left.ProEt} {ι₁ : W₁ ⟶ A₁} {ι₂ : W₂ ⟶ A₂} {ι₃ : W₃ ⟶ A₃}
      {f₁ : A₁ ⟶ A₂} {f₂ : A₂ ⟶ A₃}
      {F₁ : Limits.cokernel (wcFreeSheafMap X.left ι₁) ⟶ Limits.cokernel (wcFreeSheafMap X.left ι₂)}
      {F₂ : Limits.cokernel (wcFreeSheafMap X.left ι₂) ⟶ Limits.cokernel (wcFreeSheafMap X.left ι₃)},
      Limits.cokernel.π (wcFreeSheafMap X.left ι₁) ≫ F₁ =
        wcFreeSheafMap X.left f₁ ≫ Limits.cokernel.π (wcFreeSheafMap X.left ι₂) →
      Limits.cokernel.π (wcFreeSheafMap X.left ι₂) ≫ F₂ =
        wcFreeSheafMap X.left f₂ ≫ Limits.cokernel.π (wcFreeSheafMap X.left ι₃) →
      Limits.cokernel.π (wcFreeSheafMap X.left ι₁) ≫ (F₁ ≫ F₂) =
        wcFreeSheafMap X.left (f₁ ≫ f₂) ≫ Limits.cokernel.π (wcFreeSheafMap X.left ι₃) := by
    intro W₁ A₁ W₂ A₂ W₃ A₃ ι₁ ι₂ ι₃ f₁ f₂ F₁ F₂ h1 h2
    rw [← Category.assoc, h1, Category.assoc, h2, ← Category.assoc, hfun]
  have heq : ∀ {W₁ A₁ W₃ A₃ : X.left.ProEt} {ι₁ : W₁ ⟶ A₁} {ι₃ : W₃ ⟶ A₃} {f f' : A₁ ⟶ A₃}
      {G G' : Limits.cokernel (wcFreeSheafMap X.left ι₁) ⟶ Limits.cokernel (wcFreeSheafMap X.left ι₃)},
      Limits.cokernel.π (wcFreeSheafMap X.left ι₁) ≫ G =
        wcFreeSheafMap X.left f ≫ Limits.cokernel.π (wcFreeSheafMap X.left ι₃) →
      Limits.cokernel.π (wcFreeSheafMap X.left ι₁) ≫ G' =
        wcFreeSheafMap X.left f' ≫ Limits.cokernel.π (wcFreeSheafMap X.left ι₃) →
      f = f' → G = G' := by
    intro W₁ A₁ W₃ A₃ ι₁ ι₃ f f' G G' h1 h2 hf
    rw [← cancel_epi (Limits.cokernel.π (wcFreeSheafMap X.left ι₁)), h1, h2, hf]

  obtain ⟨τ, hτ⟩ := wc_rpc_s0_factor F X h E hU s₀
  obtain ⟨D, a, b, g, V, ι, hab, hag, ha, hDb, hgD, hgN, hgb, hbs, hbe, hdeck, hfree, hι, hrι,
    hcV, hlim, hqc, haff⟩ := wc_lfd_tower F X h E hU s₀ τ hτ VE ιE hιE t ht0 hts

  have habL : ∀ k, (a k).left ≫ (b k).left = s₀.left := fun k => congrArg (fun f => f.left) (hab k)
  have hgbL : ∀ k, (g k).left ≫ (b k).left = (b k).left := fun k => congrArg (fun f => f.left) (hgb k)
  have hDbL : ∀ k j, (D.map (homOfLE (Nat.le_add_right k j)).op).left ≫ (b k).left =
      (b (k + j)).left := fun k j => congrArg (fun f => f.left) (hDb k j)
  have hpt : ∀ {P₁ P₂ P₃ : Scheme.{u}} (f : P₁ ⟶ P₂) (f' : P₂ ⟶ P₃) (f'' : P₁ ⟶ P₃),
      f ≫ f' = f'' → ∀ y, f' (f y) = f'' y := by
    intro P₁ P₂ P₃ f f' f'' e y
    rw [← e, Scheme.Hom.comp_apply]
  have hrng : ∀ {P₁ P₂ P₃ : Scheme.{u}} (u : P₁ ⟶ P₂) (f : P₂ ⟶ P₃) (T : Set P₃),
      (∀ v, f (u v) ∈ T) → Set.range (u ≫ f) ⊆ T := by
    rintro P₁ P₂ P₃ u f T hT _ ⟨v, rfl⟩
    rw [Scheme.Hom.comp_apply]
    exact hT v
  have hinE : ∀ k (w : (V k).left), (b k).left ((ι k).left w) ∈ Set.range ιE.left := by
    intro k w
    have hw : (ι k).left w ∈ Set.range (ι k).left := ⟨w, rfl⟩
    rw [hrι k] at hw
    exact hw
  have H1 : ∀ k, Set.range (ι₀.left ≫ (a k).left) ⊆ Set.range (ι k).left := by
    intro k
    rw [hrι k]
    apply hrng
    intro v
    show (b k).left ((a k).left (ι₀.left v)) ∈ Set.range ιE.left
    rw [hpt _ _ _ (habL k), hrE]
    have hv : ι₀.left v ∈ Set.range ι₀.left := ⟨v, rfl⟩
    rw [hr₀] at hv
    exact hv
  have H2 : ∀ k, Set.range ((ι k).left ≫ (g k).left) ⊆ Set.range (ι k).left := by
    intro k
    rw [hrι k]
    apply hrng
    intro v
    show (b k).left ((g k).left ((ι k).left v)) ∈ Set.range ιE.left
    rw [hpt _ _ _ (hgbL k)]
    exact hinE k v
  have H3 : ∀ k j, Set.range ((ι (k + j)).left ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left) ⊆
      Set.range (ι k).left := by
    intro k j
    rw [hrι k]
    apply hrng
    intro v
    show (b k).left ((D.map (homOfLE (Nat.le_add_right k j)).op).left ((ι (k + j)).left v)) ∈
      Set.range ιE.left
    rw [hpt _ _ _ (hDbL k j)]
    exact hinE (k + j) v
  have H4 : ∀ k, Set.range ((ι k).left ≫ (b k).left) ⊆ Set.range ιE.left :=
    fun k => hrng _ _ _ (hinE k)

  choose α hα using fun k => cdesc (a k) ι₀ (ι k) (hι k) (H1 k)
  choose gR hgR using fun k => cdesc (g k) (ι k) (ι k) (hι k) (H2 k)
  choose bR hbR using fun k => cdesc (b k) (ι k) ιE hιE (H4 k)
  choose pR hpR using fun k j =>
    cdesc (D.map (homOfLE (Nat.le_add_right k j)).op) (ι (k + j)) (ι k) (hι k) (H3 k j)

  have T1 : ∀ k, α k ≫ bR k = q := fun k => heq (hcomp (hα k) (hbR k)) hq (hab k)
  have T2 : ∀ k, Φ ≫ α k = α k ≫ gR k := fun k =>
    heq (hcomp hΦ (hα k)) (hcomp (hα k) (hgR k)) (hag k)
  have T3 : ∀ k j, α (k + j) ≫ pR k j = α k := fun k j =>
    heq (hcomp (hα (k + j)) (hpR k j)) (hα k) (ha k j)
  have T4 : ∀ k j, pR k j ≫ bR k = bR (k + j) := fun k j =>
    heq (hcomp (hpR k j) (hbR k)) (hbR (k + j)) (hDb k j)
  have T5 : ∀ k j, gR (k + j) ≫ pR k j = pR k j ≫ gR k := fun k j =>
    heq (hcomp (hgR (k + j)) (hpR k j)) (hcomp (hpR k j) (hgR k)) (hgD k j)
  have hiterπ : ∀ k m, Limits.cokernel.π (wcFreeSheafMap X.left (ι k)) ≫ wcLfdIter (gR k) m =
      wcFreeSheafMap X.left (wcLfdIter (g k) m) ≫ Limits.cokernel.π (wcFreeSheafMap X.left (ι k)) := by
    intro k m
    induction m with
    | zero =>
      show Limits.cokernel.π (wcFreeSheafMap X.left (ι k)) ≫ 𝟙 _ =
        wcFreeSheafMap X.left (𝟙 _) ≫ Limits.cokernel.π (wcFreeSheafMap X.left (ι k))
      rw [hid, Category.comp_id, Category.id_comp]
    | succ m ih => exact hcomp (hgR k) ih
  have hπid : ∀ k, Limits.cokernel.π (wcFreeSheafMap X.left (ι k)) ≫ 𝟙 _ =
      wcFreeSheafMap X.left (𝟙 _) ≫ Limits.cokernel.π (wcFreeSheafMap X.left (ι k)) := by
    intro k
    rw [hid, Category.comp_id, Category.id_comp]
  have hgRN : ∀ k, wcLfdIter (gR k) (k + 1).factorial = 𝟙 _ := fun k =>
    heq (hiterπ k _) (hπid k) (hgN k)

  have hiter_add : ∀ {A : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}} (f : A ⟶ A)
      (m c : ℕ), wcLfdIter f (m + c) = wcLfdIter f m ≫ wcLfdIter f c := by
    intro A f m c
    induction m with
    | zero => rw [Nat.zero_add]; exact (Category.id_comp _).symm
    | succ m ih =>
      rw [show m + 1 + c = (m + c) + 1 by omega]
      show f ≫ wcLfdIter f (m + c) = (f ≫ wcLfdIter f m) ≫ wcLfdIter f c
      rw [ih, Category.assoc]
  have hiter_per : ∀ {A : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}} (f : A ⟶ A)
      (N : ℕ), wcLfdIter f N = 𝟙 A → ∀ m c, wcLfdIter f (N * m + c) = wcLfdIter f c := by
    intro A f N hN m c
    induction m with
    | zero => rw [Nat.mul_zero, Nat.zero_add]
    | succ m ih =>
      rw [show N * (m + 1) + c = N + (N * m + c) by ring, hiter_add, hN, Category.id_comp, ih]
  have hsum_per : ∀ {A : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}} (f : A ⟶ A)
      (N : ℕ), wcLfdIter f N = 𝟙 A → ∀ M, ∑ c ∈ Finset.range (N * M), wcLfdIter f c =
        M • ∑ c ∈ Finset.range N, wcLfdIter f c := by
    intro A f N hN M
    induction M with
    | zero => rw [Nat.mul_zero, Finset.sum_range_zero, zero_nsmul]
    | succ M ih =>
      rw [show N * (M + 1) = N * M + N by ring, Finset.sum_range_add, ih, succ_nsmul]
      congr 1
      exact Finset.sum_congr rfl (fun c _ => hiter_per f N hN M c)
  have hitc : ∀ k j c, wcLfdIter (gR (k + j)) c ≫ pR k j = pR k j ≫ wcLfdIter (gR k) c := by
    intro k j c
    induction c with
    | zero =>
      show 𝟙 _ ≫ pR k j = pR k j ≫ 𝟙 _
      rw [Category.id_comp, Category.comp_id]
    | succ c ih =>
      show (gR (k + j) ≫ wcLfdIter (gR (k + j)) c) ≫ pR k j = pR k j ≫ (gR k ≫ wcLfdIter (gR k) c)
      rw [Category.assoc, ih, ← Category.assoc, T5, Category.assoc]

  choose trR htrS htrM hbRE w₁ w₂ hex₁ hex₂ using fun k =>
    wc_lfd_torsor_periodic X.left (b k) (g k) _ (Nat.factorial_pos _) (hgN k) (hgb k) (hbs k)
      (hbe k) (hdeck k) (hfree k) (ι k) ιE (hι k) hιE (hrι k) (gR k) (hgR k) (bR k) (hbR k)

  have T6 : ∀ k j, trR (k + j) ≫ pR k j = (k + j + 1).descFactorial j • trR k := by
    intro k j
    haveI := hbRE (k + j)
    have hNM : (k + j + 1).factorial = (k + 1).factorial * (k + j + 1).descFactorial j := by
      have := Nat.factorial_mul_descFactorial (show j ≤ k + j + 1 by omega)
      rw [show k + j + 1 - j = k + 1 by omega] at this
      exact this.symm
    rw [← cancel_epi (bR (k + j)), ← Category.assoc, htrS (k + j), Preadditive.sum_comp,
      Preadditive.comp_nsmul, ← T4 k j, Category.assoc, htrS k,
      Finset.sum_congr rfl (fun c (_ : c ∈ Finset.range (k + j + 1).factorial) => hitc k j c),
      ← Preadditive.comp_sum, hNM, hsum_per (gR k) _ (hgRN k), Preadditive.comp_nsmul]

  have hpp : ∀ {A B C' : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}} (f : A ⟶ B)
      (g' : B ⟶ C') (z : Abelian.Ext C' (wcRootTwist X.left (ℓ ^ n) d) i),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g').comp z (zero_add i)) (zero_add i) =
        (Abelian.Ext.mk₀ (f ≫ g')).comp z (zero_add i) := by
    intro A B C' f g' z
    rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ f) (Abelian.Ext.mk₀ g') z (zero_add 0)
      (zero_add i) (by omega), Abelian.Ext.mk₀_comp_mk₀]
  have hsubp : ∀ {A B : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}} (f : A ⟶ B)
      (z₁ z₂ : Abelian.Ext B (wcRootTwist X.left (ℓ ^ n) d) i),
      (Abelian.Ext.mk₀ f).comp (z₁ - z₂) (zero_add i) =
        (Abelian.Ext.mk₀ f).comp z₁ (zero_add i) - (Abelian.Ext.mk₀ f).comp z₂ (zero_add i) := by
    intro A B f z₁ z₂
    have e := ((Abelian.Ext.mk₀ f).precomp (wcRootTwist X.left (ℓ ^ n) d) (zero_add i)).map_sub z₁ z₂
    simp only [Abelian.Ext.precomp, Abelian.Ext.bilinearComp_apply_apply] at e
    exact e

  have hrinf : Set.range ι₀.left = s₀.left ⁻¹' Set.range ιE.left := by
    first
      | (rw [hrE]; exact hr₀)
      | (rw [hr₀, hrE]; rfl)
      | (rw [hrE]; convert hr₀ using 2)
      | (ext v; rw [hr₀, Set.mem_preimage, Set.mem_preimage, hrE])
  obtain ⟨hsurj, hinj⟩ := wc_lfd_continuity X.left (ℓ ^ n) d ιE hιE D a b s₀ ha hDb hab hlim hqc
    haff V ι hι hrι hcV ι₀ hι₀ hrinf α hα pR hpR i
  obtain ⟨k, x₁, hx₁⟩ := hsurj x
  have hy0 : (Abelian.Ext.mk₀ (α k)).comp
      ((Abelian.Ext.mk₀ (gR k)).comp x₁ (zero_add i) - x₁) (zero_add i) = 0 := by
    rw [hsubp, hpp, ← T2 k, ← hpp, hx₁, hx, sub_self]
  obtain ⟨j, hj⟩ := hinj k _ hy0
  obtain ⟨x₂, hx₂def⟩ : ∃ x₂ : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left (ι (k + j))))
      (wcRootTwist X.left (ℓ ^ n) d) i, x₂ = (Abelian.Ext.mk₀ (pR k j)).comp x₁ (zero_add i) :=
    ⟨_, rfl⟩
  have hx₂ : (Abelian.Ext.mk₀ (gR (k + j))).comp x₂ (zero_add i) = x₂ := by
    rw [hsubp, hpp, ← T5 k j, ← hpp, sub_eq_zero] at hj
    rw [hx₂def]
    exact hj
  have hαx₂ : (Abelian.Ext.mk₀ (α (k + j))).comp x₂ (zero_add i) = x := by
    rw [hx₂def, hpp, T3 k j, hx₁]

  have hM : (k + j + ℓ ^ n + 1).descFactorial (ℓ ^ n) • 𝟙 (wcRootTwist X.left (ℓ ^ n) d) = 0 := by
    obtain ⟨c, hc⟩ : ℓ ^ n ∣ (k + j + ℓ ^ n + 1).descFactorial (ℓ ^ n) :=
      (Nat.dvd_factorial (pow_pos (Fact.out : Nat.Prime ℓ).pos n) le_rfl).trans
        (Nat.factorial_dvd_descFactorial _ _)
    rw [hc, mul_comm, ← smul_smul, wc_lfd_root_twist_torsion, smul_zero]
  obtain ⟨w, hw⟩ := wc_lfd_abstract_cyclic_descent (trR (k + j)) (gR (k + j)) (bR (k + j))
    (trR (k + j + ℓ ^ n)) (gR (k + j + ℓ ^ n)) (bR (k + j + ℓ ^ n)) (pR (k + j) (ℓ ^ n))
    ((k + j + ℓ ^ n + 1).descFactorial (ℓ ^ n))
    (htrM (k + j)) (w₁ (k + j)) (hex₁ (k + j)) (w₂ (k + j)) (hex₂ (k + j))
    (htrM (k + j + ℓ ^ n)) (w₁ (k + j + ℓ ^ n)) (hex₁ (k + j + ℓ ^ n)) (w₂ (k + j + ℓ ^ n))
    (hex₂ (k + j + ℓ ^ n)) (hbRE (k + j + ℓ ^ n))
    (T4 (k + j) (ℓ ^ n)) (T5 (k + j) (ℓ ^ n)) (T6 (k + j) (ℓ ^ n)) hM i x₂ hx₂
  refine ⟨w, ?_⟩
  rw [← T1 (k + j + ℓ ^ n), ← hpp, hw, hpp, T3 (k + j) (ℓ ^ n), hαx₂]

theorem wc_rpc_local_class (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n : ℕ) (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E]
    (hU : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))))
    (s₀ : wcGeomPoint F X h ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt))
    (σ : Spec (.of E) ⟶ Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))))
    (hσ : σ ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) = 𝟙 _)
    (VE : X.left.ProEt) (ιE : VE ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt))
    (hιE : IsOpenImmersion ιE.left) (hrE : Set.range ιE.left = (Set.range σ)ᶜ)
    (V₀ : X.left.ProEt) (ι₀ : V₀ ⟶ wcGeomPoint F X h)
    (hι₀ : IsOpenImmersion ι₀.left) (hr₀ : Set.range ι₀.left = s₀.left ⁻¹' (Set.range σ)ᶜ)
    (q : Limits.cokernel (wcFreeSheafMap X.left ι₀) ⟶ Limits.cokernel (wcFreeSheafMap X.left ιE))
    (hq : Limits.cokernel.π (wcFreeSheafMap X.left ι₀) ≫ q =
      wcFreeSheafMap X.left s₀ ≫ Limits.cokernel.π (wcFreeSheafMap X.left ιE)) :
    ∃ g : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ιE)) (wcRootTwist X.left (ℓ ^ n) d) (2 * d),
      ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀)) (wcRootTwist X.left (ℓ ^ n) d) (2 * d),
        ∃ k : ℤ, x = k • (Abelian.Ext.mk₀ q).comp g (zero_add (2 * d)) :=
by
  classical

  have hfun : ∀ {A B C : X.left.ProEt} (a : A ⟶ B) (b : B ⟶ C),
      wcFreeSheafMap X.left a ≫ wcFreeSheafMap X.left b = wcFreeSheafMap X.left (a ≫ b) := by
    intro A B C a b
    have e : Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight (yoneda.map (a ≫ b))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
      first
        | rw [yoneda.map_comp, Functor.whiskerRight_comp]
        | (apply NatTrans.ext; funext V; simp [← Functor.map_comp])
    exact ((presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      (congrArg (presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map e)

  obtain ⟨τ, hτ⟩ := wc_rpc_s0_factor F X h E hU s₀

  obtain ⟨xb, hxb⟩ := wc_rpc_fibre_singleton F X h E hU s₀ τ hτ σ hσ
  have hpt : Set.range ι₀.left = {xb}ᶜ := by
    rw [hr₀, Set.preimage_compl, hxb]

  let t : ℕ → (wcGeomPoint F X h ⟶ wcGeomPoint F X h) :=
    fun j => Nat.rec (motive := fun _ => wcGeomPoint F X h ⟶ wcGeomPoint F X h) (𝟙 _)
      (fun _ f => wcGeomFrob F X h ≫ f) j
  have ht0 : t 0 = 𝟙 _ := rfl
  have hts : ∀ j, t (j + 1) = wcGeomFrob F X h ≫ t j := fun j => rfl
  have hfix : t (Module.finrank F E) ≫ s₀ = s₀ :=
    wc_rpc_frob_fixes_s0 F X h E hU s₀ τ hτ t ht0 hts
  set r := Module.finrank F E with hr

  have hfixL : (t r).left ≫ s₀.left = s₀.left := congrArg (fun f => f.left) hfix
  have H' : Set.range (ι₀.left ≫ (t r).left) ⊆ Set.range ι₀.left := by
    rintro _ ⟨v, rfl⟩
    rw [hr₀]
    have hv : ι₀.left v ∈ Set.range ι₀.left := ⟨v, rfl⟩
    rw [hr₀] at hv
    show s₀.left ((ι₀.left ≫ (t r).left) v) ∈ (Set.range σ)ᶜ
    rw [Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hfixL]
    exact hv
  let L : V₀.left ⟶ V₀.left := IsOpenImmersion.lift ι₀.left (ι₀.left ≫ (t r).left) H'
  have hLfac : L ≫ ι₀.left = ι₀.left ≫ (t r).left := IsOpenImmersion.lift_fac _ _ H'
  have hLw : L ≫ V₀.hom = V₀.hom := by
    rw [← MorphismProperty.Over.w ι₀, ← Category.assoc, hLfac, Category.assoc,
      MorphismProperty.Over.w (t r)]
  let φV : V₀ ⟶ V₀ := MorphismProperty.Over.homMk L hLw trivial
  have hφV : φV ≫ ι₀ = ι₀ ≫ t r := MorphismProperty.Over.Hom.ext hLfac

  have hw0 : wcFreeSheafMap X.left ι₀ ≫ (wcFreeSheafMap X.left (t r) ≫
      Limits.cokernel.π (wcFreeSheafMap X.left ι₀)) = 0 := by
    rw [← Category.assoc, hfun, ← hφV, ← hfun, Category.assoc, Limits.cokernel.condition,
      Limits.comp_zero]
  let Φ : Limits.cokernel (wcFreeSheafMap X.left ι₀) ⟶ Limits.cokernel (wcFreeSheafMap X.left ι₀) :=
    Limits.cokernel.desc (wcFreeSheafMap X.left ι₀)
      (wcFreeSheafMap X.left (t r) ≫ Limits.cokernel.π (wcFreeSheafMap X.left ι₀)) hw0
  have hΦ : Limits.cokernel.π (wcFreeSheafMap X.left ι₀) ≫ Φ =
      wcFreeSheafMap X.left (t r) ≫ Limits.cokernel.π (wcFreeSheafMap X.left ι₀) :=
    Limits.cokernel.π_desc _ _ _

  obtain ⟨y, hy⟩ := wc_rpc_geom_local_cyclic F X d ℓ hℓ h n V₀ ι₀ hι₀ xb hpt
  have hyinv := wc_rpc_local_frob_invariant F X d ℓ hℓ h n E hU s₀ σ hσ V₀ ι₀ hι₀ hr₀
    t ht0 hts hfix Φ hΦ y
  obtain ⟨g, hg⟩ := wc_rpc_local_frob_descent F X d ℓ hℓ h n E hU s₀ σ hσ VE ιE hιE hrE
    V₀ ι₀ hι₀ hr₀ q hq t ht0 hts hfix Φ hΦ (2 * d) y hyinv
  refine ⟨g, fun x => ?_⟩
  obtain ⟨k, hk⟩ := hy x
  exact ⟨k, by rw [hg]; exact hk⟩

theorem wc_top_twist_card_ge (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n : ℕ) (hn : 1 ≤ n) :
    ℓ ^ n ≤ Nat.card (Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcRootTwist X.left (ℓ ^ n) d) (2 * d)) :=
by
  classical

  obtain ⟨ρ, hinj, hsurj, hρ⟩ := wc_root_twist_slice_presheaf_map F X ℓ hℓ h n d
  obtain ⟨ψ, hψiso, hψ⟩ := wc_slice_sheafify_scaled_iso X.left (wcGeomPoint F X h)
    (wcGeomFrob F X h) (wcRootTwistPre X.left (ℓ ^ n) d) (wcZModSheaf X.left (ℓ ^ n)) ρ
    (Nat.card F ^ d) hinj hsurj hρ
  obtain ⟨Φ, hΦbij, -⟩ := wc_slice_ext_frob_transport X.left (wcGeomPoint F X h)
    (wcGeomFrob F X h) (wcRootTwist X.left (ℓ ^ n) d) (wcZModSheaf X.left (ℓ ^ n)) ψ
    (Nat.card F ^ d) hψiso hψ (2 * d)
  let E₁ := Equiv.ofBijective Φ hΦbij

  obtain ⟨E₂⟩ := wc_ext_free_slice_zmod X.left (wcGeomPoint F X h) (ℓ ^ n) (2 * d)

  let fY : (wcGeomPoint F X h).left ⟶ Spec (.of (AlgebraicClosure F)) :=
    Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
  haveI hprop : IsProper fY :=
    (show IsProper (Limits.pullback.snd X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :
        (wcGeomPoint F X h).left ⟶ Spec (.of (AlgebraicClosure F))) from inferInstance)
  obtain ⟨E₃⟩ := wc_proet_etale_comparison_zmod (AlgebraicClosure F) (wcGeomPoint F X h).left
    fY (ℓ ^ n) (2 * d)

  haveI hsm : SmoothOfRelativeDimension d fY :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
      (IsPullback.of_hasPullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) inferInstance
  haveI hirr : IrreducibleSpace (wcGeomPoint F X h).left :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom)
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
      (Limits.pullback.fst _ _) (Limits.pullback.snd _ _) (IsPullback.of_hasPullback _ _)
  have hne : ((ℓ : ℕ) : AlgebraicClosure F) ≠ 0 := by
    intro h0
    have hp : ringChar F ∣ ℓ := (CharP.cast_eq_zero_iff (AlgebraicClosure F) (ringChar F) ℓ).mp h0
    have hpp : Nat.Prime (ringChar F) := CharP.char_is_prime F (ringChar F)
    have hpl : ringChar F = ℓ := (Nat.prime_dvd_prime_iff_eq hpp (Fact.out)).mp hp
    letI := Fintype.ofFinite F
    have hc : ((Nat.card F : ℕ) : F) = 0 := by
      rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero F
    have hdvd : ringChar F ∣ Nat.card F := (ringChar.spec F _).mp hc
    exact hℓ (hpl ▸ hdvd)

  have hdim : topologicalKrullDim (wcGeomPoint F X h).left = (d : WithBot ℕ∞) :=
    le_antisymm (wc_smooth_alg_closed_dim_le (AlgebraicClosure F) (wcGeomPoint F X h).left fY d)
      (wc_smooth_irreducible_dim_ge (AlgebraicClosure F) (wcGeomPoint F X h).left fY d)

  have hge := wc_et_top_coh_card_ge (AlgebraicClosure F) (wcGeomPoint F X h).left fY d hdim ℓ
    (Fact.out : ℓ.Prime) hne n hn
  let E := E₁.trans (E₂.trans E₃)
  exact hge.trans_eq (Nat.card_congr E).symm

theorem wc_rational_point_class (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n : ℕ) (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E]
    (hU : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))))
    (p : Over.mk (Spec.map (CommRingCat.ofHom (algebraMap F E))) ⟶ X)
    (s₀ : wcGeomPoint F X h ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt)) :
    ∃ w : Abelian.Ext (wcFreeSheaf X.left (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU)) (wcRootTwist X.left (ℓ ^ n) d) (2 * d),
      ∀ k : ℕ, k • (Abelian.Ext.mk₀ (wcFreeSheafMap X.left s₀)).comp w (zero_add (2 * d)) = 0 →
        ℓ ^ n ∣ k :=
by
  classical

  rcases Nat.eq_zero_or_pos n with hn0 | hnpos
  · subst hn0
    exact ⟨0, fun k _ => by rw [pow_zero]; exact one_dvd k⟩

  have hp : p.left ≫ X.hom = 𝟙 (Spec (.of E)) ≫ Spec.map (CommRingCat.ofHom (algebraMap F E)) := by
    rw [Category.id_comp]
    exact Over.w p
  let σ : Spec (.of E) ⟶ Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) :=
    Limits.pullback.lift p.left (𝟙 _) hp
  have hσ2 : σ ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) = 𝟙 _ :=
    Limits.pullback.lift_snd _ _ _
  haveI : IsClosedImmersion
      (σ ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))) := by
    rw [hσ2]; infer_instance
  haveI : IsClosedImmersion σ :=
    IsClosedImmersion.of_comp σ (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))))
  have hclosed : IsClosed (Set.range σ) := σ.isClosedEmbedding.isClosed_range
  let O : (Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))).Opens :=
    ⟨(Set.range σ)ᶜ, hclosed.isOpen_compl⟩
  let fE := Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))
  let fF := Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
  have hVE : WeaklyEtale (O.ι ≫ fE) := by
    first
      | (haveI := hU; infer_instance)
      | exact (MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)).comp_mem
          O.ι fE inferInstance hU
  let UE : X.left.ProEt := MorphismProperty.Over.mk ⊤ fE hU
  let VE : X.left.ProEt := MorphismProperty.Over.mk ⊤ (O.ι ≫ fE) hVE
  let ιE : VE ⟶ UE := MorphismProperty.Over.homMk O.ι rfl trivial
  let O₀ : (Limits.pullback X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))).Opens := s₀.left ⁻¹ᵁ O
  have hV0 : WeaklyEtale (O₀.ι ≫ fF) := by
    first
      | (haveI := h; infer_instance)
      | exact (MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)).comp_mem
          O₀.ι fF inferInstance h
  let V₀ : X.left.ProEt := MorphismProperty.Over.mk ⊤ (O₀.ι ≫ fF) hV0
  let ι₀ : V₀ ⟶ wcGeomPoint F X h := MorphismProperty.Over.homMk O₀.ι rfl trivial
  have hs₀w : s₀.left ≫ fE = fF := MorphismProperty.Over.w s₀
  have hjw : (s₀.left ∣_ O) ≫ VE.hom = V₀.hom :=
    (Category.assoc (s₀.left ∣_ O) O.ι fE).symm.trans
      ((congrArg (fun t => t ≫ fE) (morphismRestrict_ι s₀.left O)).trans
        ((Category.assoc O₀.ι s₀.left fE).trans (congrArg (fun t => O₀.ι ≫ t) hs₀w)))
  let j : V₀ ⟶ VE := MorphismProperty.Over.homMk (s₀.left ∣_ O) hjw trivial
  have hj : j ≫ ιE = ι₀ ≫ s₀ := MorphismProperty.Over.Hom.ext (morphismRestrict_ι s₀.left O)
  have hιE : IsOpenImmersion ιE.left := by
    show IsOpenImmersion O.ι
    infer_instance
  have hrE : Set.range ιE.left = (Set.range σ)ᶜ := by
    show Set.range O.ι = _
    rw [Scheme.Opens.range_ι]
    rfl
  have hι₀ : IsOpenImmersion ι₀.left := by
    show IsOpenImmersion O₀.ι
    infer_instance
  have hr₀ : Set.range ι₀.left = s₀.left ⁻¹' (Set.range σ)ᶜ := by
    show Set.range O₀.ι = _
    rw [Scheme.Opens.range_ι]
    first
      | rfl
      | exact Scheme.Hom.coe_preimage s₀.left
  have hmono₀ : Mono ι₀.left := by
    show Mono O₀.ι
    infer_instance

  have hfun : ∀ {A B C : X.left.ProEt} (a : A ⟶ B) (b : B ⟶ C),
      wcFreeSheafMap X.left a ≫ wcFreeSheafMap X.left b = wcFreeSheafMap X.left (a ≫ b) := by
    intro A B C a b
    have e : Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight (yoneda.map (a ≫ b))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
      first
        | rw [yoneda.map_comp, Functor.whiskerRight_comp]
        | (apply NatTrans.ext; funext V; simp [← Functor.map_comp])
    exact ((presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      (congrArg (presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map e)
  have hq0 : wcFreeSheafMap X.left ι₀ ≫ (wcFreeSheafMap X.left s₀ ≫
      Limits.cokernel.π (wcFreeSheafMap X.left ιE)) = 0 :=
    calc wcFreeSheafMap X.left ι₀ ≫ (wcFreeSheafMap X.left s₀ ≫
          Limits.cokernel.π (wcFreeSheafMap X.left ιE))
        = (wcFreeSheafMap X.left ι₀ ≫ wcFreeSheafMap X.left s₀) ≫
          Limits.cokernel.π (wcFreeSheafMap X.left ιE) := (Category.assoc _ _ _).symm
      _ = wcFreeSheafMap X.left (ι₀ ≫ s₀) ≫ Limits.cokernel.π (wcFreeSheafMap X.left ιE) :=
          congrArg (fun t => t ≫ Limits.cokernel.π (wcFreeSheafMap X.left ιE)) (hfun ι₀ s₀)
      _ = wcFreeSheafMap X.left (j ≫ ιE) ≫ Limits.cokernel.π (wcFreeSheafMap X.left ιE) :=
          congrArg (fun t => wcFreeSheafMap X.left t ≫ Limits.cokernel.π (wcFreeSheafMap X.left ιE))
            hj.symm
      _ = (wcFreeSheafMap X.left j ≫ wcFreeSheafMap X.left ιE) ≫
          Limits.cokernel.π (wcFreeSheafMap X.left ιE) :=
          congrArg (fun t => t ≫ Limits.cokernel.π (wcFreeSheafMap X.left ιE)) (hfun j ιE).symm
      _ = wcFreeSheafMap X.left j ≫ (wcFreeSheafMap X.left ιE ≫
          Limits.cokernel.π (wcFreeSheafMap X.left ιE)) := Category.assoc _ _ _
      _ = wcFreeSheafMap X.left j ≫ 0 :=
          congrArg (fun t => wcFreeSheafMap X.left j ≫ t) (Limits.cokernel.condition _)
      _ = 0 := Limits.comp_zero
  let q : Limits.cokernel (wcFreeSheafMap X.left ι₀) ⟶ Limits.cokernel (wcFreeSheafMap X.left ιE) :=
    Limits.cokernel.desc (wcFreeSheafMap X.left ι₀)
      (wcFreeSheafMap X.left s₀ ≫ Limits.cokernel.π (wcFreeSheafMap X.left ιE)) hq0
  have hq : Limits.cokernel.π (wcFreeSheafMap X.left ι₀) ≫ q =
      wcFreeSheafMap X.left s₀ ≫ Limits.cokernel.π (wcFreeSheafMap X.left ιE) :=
    Limits.cokernel.π_desc _ _ _

  obtain ⟨g, hg⟩ := wc_rpc_local_class F X d ℓ hℓ h n E hU s₀ σ hσ2 VE ιE hιE hrE V₀ ι₀ hι₀ hr₀ q hq
  let c := (Abelian.Ext.mk₀ q).comp g (zero_add (2 * d))
  refine ⟨(Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap X.left ιE))).comp g (zero_add (2 * d)),
    ?_⟩
  have hy : (Abelian.Ext.mk₀ (wcFreeSheafMap X.left s₀)).comp
      ((Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap X.left ιE))).comp g (zero_add (2 * d)))
      (zero_add (2 * d)) =
      (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap X.left ι₀))).comp c (zero_add (2 * d)) := by
    rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (wcFreeSheafMap X.left s₀))
      (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap X.left ιE))) g (zero_add 0)
      (zero_add (2 * d)) (by omega), Abelian.Ext.mk₀_comp_mk₀, ← hq, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap X.left ι₀)))
      (Abelian.Ext.mk₀ q) g (zero_add 0) (zero_add (2 * d)) (by omega)]

  have hSE : (ShortComplex.mk (wcFreeSheafMap X.left ι₀) (Limits.cokernel.π (wcFreeSheafMap X.left ι₀))
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _)
      (wc_free_sheaf_map_mono X.left V₀ (wcGeomPoint F X h) ι₀ hmono₀) inferInstance
  have hsurj := wc_rpc_geom_point_surj F X d h E hU s₀
  obtain ⟨pt⟩ := (inferInstance : Nonempty (Spec (.of E)))
  obtain ⟨xb, hxb⟩ := hsurj (σ pt)
  have hne : Set.range ι₀.left ≠ Set.univ := by
    intro heq
    have hmem : xb ∈ Set.range ι₀.left := by rw [heq]; exact Set.mem_univ _
    rw [hr₀] at hmem
    exact hmem ⟨pt, hxb.symm⟩
  have hgen : ∀ x : Abelian.Ext (wcFreeSheaf X.left (wcGeomPoint F X h))
      (wcRootTwist X.left (ℓ ^ n) d) (2 * d),
      x ∈ AddSubgroup.zmultiples
        ((Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap X.left ι₀))).comp c (zero_add (2 * d))) := by
    intro x
    obtain ⟨x', hx'⟩ : ∃ x', (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap X.left ι₀))).comp x'
        (zero_add (2 * d)) = x :=
      Abelian.Ext.contravariant_sequence_exact₂ hSE (wcRootTwist X.left (ℓ ^ n) d) x
        (wc_rpc_open_top_vanishing F X d ℓ hℓ h n V₀ ι₀ hι₀ hne _)
    obtain ⟨k, hk⟩ := hg x'
    rw [AddSubgroup.mem_zmultiples_iff]
    refine ⟨k, ?_⟩
    have hlin := map_zsmul ((Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap X.left ι₀))).precomp
      (wcRootTwist X.left (ℓ ^ n) d) (zero_add (2 * d))) k c
    simp only [Abelian.Ext.precomp, Abelian.Ext.bilinearComp_apply_apply] at hlin
    rw [← hx', hk]
    exact hlin.symm

  obtain ⟨hfin, hle⟩ := wc_top_twist_card_le F X d ℓ hℓ h n
  have hge := wc_top_twist_card_ge F X d ℓ hℓ h n hnpos
  have hord := addOrderOf_eq_card_of_forall_mem_zmultiples hgen
  intro k hk
  rw [hy] at hk
  have hdvd := addOrderOf_dvd_of_nsmul_eq_zero hk
  rw [hord, le_antisymm hle hge] at hdvd
  exact hdvd

theorem lw_affine_chart_cover (F : Type u) [Finite F] [Field F]
    (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
    (d : ℕ) [SmoothOfRelativeDimension d X.hom] :
    ∃ (k : ℕ) (c : Fin (k + 1) → ℕ)
      (rel : ∀ i, Fin (c i) → MvPolynomial (Fin (d + c i)) F)
      (h : ∀ i, MvPolynomial (Fin (d + c i)) F),
      (∀ i, ∃ w : MvPolynomial (Fin (d + c i)) F,
        (Matrix.of fun a b : Fin (c i) =>
          MvPolynomial.pderiv (Fin.natAdd d b) (rel i a)).det * w - 1 ∈
            Ideal.span (Set.range (rel i))) ∧
      (∀ i, (Ideal.span (Set.range (rel i))).radical.IsPrime) ∧
      (Ideal.span (Set.range fun a =>
          MvPolynomial.map (algebraMap F (AlgebraicClosure F)) (rel 0 a))).radical.IsPrime ∧
      (∀ i, h i ∉ (Ideal.span (Set.range (rel i))).radical) ∧
      ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E],
        Nat.card {x : Fin (d + c 0) → E //
            ∀ p ∈ Ideal.span (Set.range (rel 0)), MvPolynomial.aeval x p = 0} ≤
          Nat.card (Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) ∧
        Nat.card (Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) ≤
          Nat.card {x : Fin (d + c 0) → E //
              ∀ p ∈ Ideal.span (Set.range (rel 0)), MvPolynomial.aeval x p = 0} +
            ∑ i : Fin (k + 1), Nat.card {x : Fin (d + c i) → E //
              (∀ p ∈ Ideal.span (Set.range (rel i)), MvPolynomial.aeval x p = 0) ∧
                MvPolynomial.aeval x (h i) = 0} :=
by
  classical

  have lw_chart_smooth_cover : ∀ (F : Type u) [Field F] (X : Over (Spec (.of F)))
      [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom], Nonempty X.left →
      ∃ (k : ℕ) (V : Fin (k + 1) → X.left.Opens),
        (∀ i, IsAffineOpen (V i)) ∧ (∀ i, ((V i : X.left.Opens) : Set X.left).Nonempty) ∧
        (∀ x : X.left, ∃ i, x ∈ V i) ∧
        ∀ i, RingHom.IsStandardSmoothOfRelativeDimension d
          ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ X.hom.appLE ⊤ (V i) le_top).hom := by
    intro F _ X _ d _ hne
    have hloc : ∀ x : X.left, ∃ W : X.left.Opens, IsAffineOpen W ∧ x ∈ W ∧
        RingHom.IsStandardSmoothOfRelativeDimension d
          ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ X.hom.appLE ⊤ W le_top).hom := by
      intro x
      obtain ⟨U, hU, W, hW, hxW, e, hsm⟩ :=
        SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := d)
          (f := X.hom) x
      have hUtop : U = ⊤ := by
        have hxU : X.hom x ∈ U := e hxW
        refine eq_top_iff.mpr fun y _ => ?_
        have : y = X.hom x := Subsingleton.elim (α := PrimeSpectrum F) y _
        rw [this]
        exact hxU
      subst hUtop
      refine ⟨W, hW, hxW, ?_⟩
      rw [CommRingCat.hom_comp]
      have h0 := RingHom.IsStandardSmoothOfRelativeDimension.equiv
        ((Scheme.ΓSpecIso (CommRingCat.of F)).symm.commRingCatIsoToRingEquiv)
      have := hsm.comp h0
      exact this
    choose W hWa hxW hWsm using hloc
    haveI : CompactSpace X.left := QuasiCompact.compactSpace_of_compactSpace X.hom
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun x => (W x : Set X.left))
      (fun x => (W x).isOpen) (fun x _ => Set.mem_iUnion.mpr ⟨x, hxW x⟩)
    obtain ⟨x0⟩ := hne
    have htne : t.card ≠ 0 := by
      intro h0
      rw [Finset.card_eq_zero] at h0
      have := ht (Set.mem_univ x0)
      simp [h0] at this
    obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero htne
    let σ : Fin (k + 1) → X.left := fun i => (t.equivFin.symm (Fin.cast hk.symm i)).1
    refine ⟨k, fun i => W (σ i), fun i => hWa _, fun i => ⟨σ i, hxW _⟩, ?_, fun i => hWsm _⟩
    intro x
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ x))
    refine ⟨Fin.cast hk (t.equivFin ⟨y, hy⟩), ?_⟩
    simp only [σ, Fin.cast_cast, Fin.cast_eq_self, Equiv.symm_apply_apply]
    exact hxy

  have lw_standard_smooth_poly_presentation : ∀ (F : Type u) [Field F] (d : ℕ) (A : Type u)
      [CommRing A] [Algebra F A], Algebra.IsStandardSmoothOfRelativeDimension d F A →
      ∃ (c : ℕ) (rel : Fin c → MvPolynomial (Fin (d + c)) F),
        (∃ w : MvPolynomial (Fin (d + c)) F,
          (Matrix.of fun a b : Fin c =>
            MvPolynomial.pderiv (Fin.natAdd d b) (rel a)).det * w - 1 ∈
              Ideal.span (Set.range rel)) ∧
        Nonempty ((MvPolynomial (Fin (d + c)) F ⧸ Ideal.span (Set.range rel)) ≃ₐ[F] A) := by
    intro F _ d A _ _ hsm
    obtain ⟨ι, σ, _, _, P, hP⟩ := hsm.out
    letI : Fintype σ := Fintype.ofFinite σ
    letI : Fintype ι := Fintype.ofFinite ι
    set c := Nat.card σ with hc
    have hdim : P.dimension = Nat.card ι - Nat.card σ := rfl
    have hle : Nat.card σ ≤ Nat.card ι := Nat.card_le_card_of_injective P.map P.map_inj
    have hcard : Nat.card ι = d + c := by omega
    let eσ : σ ≃ Fin c := Finite.equivFin σ
    let p : ι → Prop := fun i => i ∈ Set.range P.map
    let e2 : {i // p i} ≃ Fin c := (Equiv.ofInjective P.map P.map_inj).symm.trans eσ
    have hcompl : Nat.card {i // ¬ p i} = d := by
      have h1 := Nat.card_congr (Equiv.sumCompl p)
      rw [Nat.card_sum, Nat.card_congr e2, Nat.card_fin] at h1
      omega
    let e1 : {i // ¬ p i} ≃ Fin d := Finite.equivFinOfCardEq hcompl
    let eι : ι ≃ Fin (d + c) :=
      (((Equiv.sumCompl p).symm.trans (Equiv.sumComm _ _)).trans (Equiv.sumCongr e1 e2)).trans
        finSumFinEquiv
    have heι : ∀ s : σ, eι (P.map s) = Fin.natAdd d (eσ s) := by
      intro s
      have hp : p (P.map s) := ⟨s, rfl⟩
      simp only [eι, Equiv.trans_apply, Equiv.sumCompl_symm_apply_of_pos hp, Equiv.sumComm_apply,
        Sum.swap_inl, Equiv.sumCongr_apply, Sum.map_inr, finSumFinEquiv_apply_right]
      congr 1
      simp only [e2, Equiv.trans_apply]
      congr 1
      exact Equiv.ofInjective_symm_apply P.map_inj s
    let rel : Fin c → MvPolynomial (Fin (d + c)) F :=
      fun a => MvPolynomial.rename eι (P.relation (eσ.symm a))
    have hK : Ideal.span (Set.range rel) = Ideal.map (MvPolynomial.rename eι) P.ker := by
      rw [← P.span_range_relation_eq_ker, Ideal.map_span, ← Set.range_comp]
      congr 1
      have : rel = (⇑(MvPolynomial.rename eι) ∘ P.relation) ∘ eσ.symm := rfl
      rw [this, EquivLike.range_comp]
    have hker : ∀ q : MvPolynomial ι F, q ∈ P.ker ↔ MvPolynomial.aeval P.val q = 0 := by
      intro q
      rw [Algebra.Generators.ker_eq_ker_aeval_val, RingHom.mem_ker]
    refine ⟨c, rel, ?_, ?_⟩
    · obtain ⟨u, hu⟩ := P.jacobian_isUnit.exists_right_inv
      obtain ⟨w', hw'⟩ := P.algebraMap_surjective u
      rw [Algebra.Generators.algebraMap_apply] at hw'
      have hjac := P.jacobian_eq_jacobiMatrix_det
      rw [Algebra.Generators.algebraMap_apply] at hjac
      have hmem : P.jacobiMatrix.det * w' - 1 ∈ P.ker := by
        rw [hker, map_sub, map_mul, map_one, ← hjac, hw', hu, sub_self]
      refine ⟨MvPolynomial.rename eι w', ?_⟩
      have hM : (Matrix.of fun a b : Fin c =>
          MvPolynomial.pderiv (Fin.natAdd d b) (rel a)) =
          (MvPolynomial.rename eι : MvPolynomial ι F →ₐ[F] _).toRingHom.mapMatrix
            ((P.jacobiMatrix.transpose).submatrix eσ.symm eσ.symm) := by
        refine Matrix.ext fun a b => ?_
        simp only [Matrix.of_apply, RingHom.mapMatrix_apply, Matrix.map_apply,
          Matrix.submatrix_apply, Matrix.transpose_apply, AlgHom.toRingHom_eq_coe,
          RingHom.coe_coe]
        rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
        have hb : Fin.natAdd d b = eι (P.map (eσ.symm b)) := by
          rw [heι, Equiv.apply_symm_apply]
        rw [hb]
        exact MvPolynomial.pderiv_rename (R := F) eι.injective (P.map (eσ.symm b))
          (P.relation (eσ.symm a))
      have hdet : (Matrix.of fun a b : Fin c =>
          MvPolynomial.pderiv (Fin.natAdd d b) (rel a)).det =
          MvPolynomial.rename eι P.jacobiMatrix.det := by
        rw [hM, ← RingHom.map_det, Matrix.det_submatrix_equiv_self, Matrix.det_transpose]
        rfl
      rw [hdet, hK]
      have := Ideal.mem_map_of_mem (MvPolynomial.rename eι) hmem
      rw [map_sub, map_mul, map_one] at this
      exact this
    · let φ : MvPolynomial (Fin (d + c)) F →ₐ[F] A :=
        (MvPolynomial.aeval P.val).comp (MvPolynomial.rename eι.symm)
      have hφsurj : Function.Surjective φ := by
        intro a
        obtain ⟨q, hq⟩ := P.algebraMap_surjective a
        rw [Algebra.Generators.algebraMap_apply] at hq
        refine ⟨MvPolynomial.rename eι q, ?_⟩
        simp only [φ, AlgHom.comp_apply, MvPolynomial.rename_rename, Equiv.symm_comp_self,
          MvPolynomial.rename_id]
        exact hq
      have hφker : RingHom.ker φ = Ideal.span (Set.range rel) := by
        apply le_antisymm
        · intro x hx
          rw [RingHom.mem_ker] at hx
          have hq : MvPolynomial.rename eι.symm x ∈ P.ker := (hker _).mpr hx
          have := Ideal.mem_map_of_mem (MvPolynomial.rename eι) hq
          rw [MvPolynomial.rename_rename, Equiv.self_comp_symm, MvPolynomial.rename_id] at this
          rw [hK]
          exact this
        · rw [hK, Ideal.map_le_iff_le_comap]
          intro q hq
          rw [Ideal.mem_comap, RingHom.mem_ker]
          simp only [φ, AlgHom.comp_apply, MvPolynomial.rename_rename, Equiv.symm_comp_self,
            MvPolynomial.rename_id]
          exact (hker q).mp hq
      exact ⟨(Ideal.quotientEquivAlgOfEq F hφker.symm).trans
        (Ideal.quotientKerAlgEquivOfSurjective hφsurj)⟩

  have lw_affine_geom_nilradical_prime : ∀ (F : Type u) [Field F] (X : Over (Spec (.of F)))
      [GeometricallyIrreducible X.hom] (V : X.left.Opens), IsAffineOpen V →
      (V : Set X.left).Nonempty →
      ∀ (_ : Algebra F Γ(X.left, V)),
        algebraMap F Γ(X.left, V) =
          ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ X.hom.appLE ⊤ V le_top).hom →
        (nilradical (TensorProduct F (AlgebraicClosure F) Γ(X.left, V))).IsPrime := by
    intro F _ X _ V hV hVne alg halg
    have hT : IsAffineOpen (⊤ : (Spec (CommRingCat.of F)).Opens) := isAffineOpen_top _
    have s3 : Spec.map (CommRingCat.ofHom (algebraMap F Γ(X.left, V))) =
        hV.fromSpec ≫ X.hom := by
      have h1 := IsAffineOpen.SpecMap_appLE_fromSpec X.hom hT hV le_top
      have h2 : hT.fromSpec = Spec.map (Scheme.ΓSpecIso (CommRingCat.of F)).inv := by
        rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv]
      rw [h2] at h1
      rw [halg, CommRingCat.ofHom_hom, Spec.map_comp]
      exact h1
    haveI := hV.isOpenImmersion_fromSpec
    let y : Spec (CommRingCat.of (AlgebraicClosure F)) ⟶ Spec (CommRingCat.of F) :=
      Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))
    let pm := Limits.pullback.map (Spec.map (CommRingCat.ofHom (algebraMap F Γ(X.left, V)))) y
      X.hom y hV.fromSpec (𝟙 _) (𝟙 _) (by rw [Category.comp_id, s3])
      (by rw [Category.comp_id, Category.id_comp])
    haveI hpm : IsOpenImmersion pm :=
      MorphismProperty.pullbackMap (P := @IsOpenImmersion) hV.isOpenImmersion_fromSpec
        (inferInstanceAs (IsOpenImmersion (𝟙 _))) s3 (Category.id_comp _).symm
    let j := (pullbackSpecIso F Γ(X.left, V) (AlgebraicClosure F)).inv ≫ pm
    haveI : IsOpenImmersion j := inferInstance
    haveI hZ : IrreducibleSpace (Limits.pullback X.hom y : Scheme.{u}) :=
      GeometricallyIrreducible.geometrically_irreducibleSpace (K := AlgebraicClosure F) y
        (Limits.pullback.fst _ _) (Limits.pullback.snd _ _) (IsPullback.of_hasPullback X.hom y)
    haveI : Module.Free F Γ(X.left, V) := Module.Free.of_divisionRing F _
    haveI : Module.Flat F Γ(X.left, V) := Module.Flat.of_free
    have hne : Nonempty (PrimeSpectrum Γ(X.left, V)) := by
      obtain ⟨x, hx⟩ := hVne
      rw [← hV.range_fromSpec] at hx
      obtain ⟨p, _⟩ := hx
      exact ⟨p⟩
    haveI : Nontrivial Γ(X.left, V) := PrimeSpectrum.nonempty_iff_nontrivial.mp hne
    have hinj : Function.Injective (Algebra.TensorProduct.includeLeft :
        Γ(X.left, V) →ₐ[F] TensorProduct F Γ(X.left, V) (AlgebraicClosure F)) :=
      Algebra.TensorProduct.includeLeft_injective (algebraMap F (AlgebraicClosure F)).injective
    haveI : Nontrivial (TensorProduct F Γ(X.left, V) (AlgebraicClosure F)) := hinj.nontrivial
    haveI : Nonempty
        (Spec (CommRingCat.of (TensorProduct F Γ(X.left, V) (AlgebraicClosure F)))) :=
      PrimeSpectrum.nonempty_iff_nontrivial.mpr inferInstance
    haveI hirrT : IrreducibleSpace
        (Spec (CommRingCat.of (TensorProduct F Γ(X.left, V) (AlgebraicClosure F)))) :=
      (Scheme.Hom.isOpenEmbedding j).irreducibleSpace
    have hprime : (nilradical (TensorProduct F Γ(X.left, V) (AlgebraicClosure F))).IsPrime := by
      rw [← PrimeSpectrum.vanishingIdeal_univ]
      exact PrimeSpectrum.isIrreducible_iff_vanishingIdeal_isPrime.mp
        (IrreducibleSpace.isIrreducible_univ
          (Spec (CommRingCat.of (TensorProduct F Γ(X.left, V) (AlgebraicClosure F)))))
    let e := Algebra.TensorProduct.comm F (AlgebraicClosure F) Γ(X.left, V)
    have heq : nilradical (TensorProduct F (AlgebraicClosure F) Γ(X.left, V)) =
        Ideal.comap e (nilradical (TensorProduct F Γ(X.left, V) (AlgebraicClosure F))) := by
      ext x
      rw [Ideal.mem_comap, mem_nilradical, mem_nilradical]
      exact (IsNilpotent.map_iff e.injective).symm
    rw [heq]
    exact Ideal.comap_isPrime e _

  have lw_geom_nilradical_to_ideals : ∀ (F : Type u) [Field F] (N : ℕ)
      (I : Ideal (MvPolynomial (Fin N) F)) (A : Type u) [CommRing A] [Algebra F A],
      ((MvPolynomial (Fin N) F ⧸ I) ≃ₐ[F] A) →
      (nilradical (TensorProduct F (AlgebraicClosure F) A)).IsPrime →
      (Ideal.map (MvPolynomial.map (algebraMap F (AlgebraicClosure F))) I).radical.IsPrime ∧
        I.radical.IsPrime := by
    intro F _ N I A _ _ ε hnil
    haveI : Module.Free F A := Module.Free.of_divisionRing F A
    haveI : Module.Flat F A := Module.Flat.of_free
    have hinc : Function.Injective (Algebra.TensorProduct.includeRight :
        A →ₐ[F] TensorProduct F (AlgebraicClosure F) A) :=
      Algebra.TensorProduct.includeRight_injective (algebraMap F (AlgebraicClosure F)).injective
    have key : ∀ {R : Type u} [CommRing R] (θ : R →+* TensorProduct F (AlgebraicClosure F) A),
        (RingHom.ker θ).radical.IsPrime := by
      intro R _ θ
      haveI : (⊥ : Ideal (TensorProduct F (AlgebraicClosure F) A)).radical.IsPrime := hnil
      rw [RingHom.ker_eq_comap_bot, ← Ideal.comap_radical]
      exact Ideal.comap_isPrime θ _
    let ψ : MvPolynomial (Fin N) F →ₐ[F] A := ε.toAlgHom.comp (Ideal.Quotient.mkₐ F I)
    have hψ : ∀ p, ψ p = ε (Ideal.Quotient.mk I p) := fun p => rfl
    have hψker : RingHom.ker ψ = I := by
      ext p
      rw [RingHom.mem_ker, hψ, map_eq_zero_iff ε ε.injective, Ideal.Quotient.eq_zero_iff_mem]
    have hψsurj : Function.Surjective ψ :=
      ε.surjective.comp (Ideal.Quotient.mkₐ_surjective F I)
    constructor
    · let Θ := MvPolynomial.algebraTensorAlgEquiv (σ := Fin N) F (AlgebraicClosure F)
      let Ψ := Algebra.TensorProduct.map (AlgHom.id F (AlgebraicClosure F)) ψ
      have hΨ : RingHom.ker Ψ = Ideal.map (Algebra.TensorProduct.includeRight :
          MvPolynomial (Fin N) F →ₐ[F]
            TensorProduct F (AlgebraicClosure F) (MvPolynomial (Fin N) F)) I := by
        rw [Algebra.TensorProduct.lTensor_ker ψ hψsurj, hψker]
      let θ : MvPolynomial (Fin N) (AlgebraicClosure F) →+*
          TensorProduct F (AlgebraicClosure F) A :=
        Ψ.toRingHom.comp Θ.symm.toRingEquiv.toRingHom
      have hc : ∀ p : MvPolynomial (Fin N) F,
          Θ (Algebra.TensorProduct.includeRight p) = MvPolynomial.map (algebraMap F _) p := by
        intro p
        rw [Algebra.TensorProduct.includeRight_apply, MvPolynomial.algebraTensorAlgEquiv_tmul,
          one_smul]
      have hθ : RingHom.ker θ =
          Ideal.map (MvPolynomial.map (algebraMap F (AlgebraicClosure F))) I := by
        ext x
        rw [RingHom.mem_ker]
        show Ψ (Θ.symm x) = 0 ↔ _
        rw [← RingHom.mem_ker, hΨ]
        constructor
        · intro hx
          have hle : Ideal.map (Algebra.TensorProduct.includeRight :
              MvPolynomial (Fin N) F →ₐ[F]
                TensorProduct F (AlgebraicClosure F) (MvPolynomial (Fin N) F)) I ≤
              Ideal.comap Θ
                (Ideal.map (MvPolynomial.map (algebraMap F (AlgebraicClosure F))) I) := by
            refine Ideal.map_le_iff_le_comap.mpr ?_
            intro p hp
            rw [Ideal.mem_comap, Ideal.mem_comap, hc]
            exact Ideal.mem_map_of_mem _ hp
          have := hle hx
          rw [Ideal.mem_comap, AlgEquiv.apply_symm_apply] at this
          exact this
        · intro hx
          have hle : Ideal.map (MvPolynomial.map (algebraMap F (AlgebraicClosure F))) I ≤
              Ideal.comap Θ.symm (Ideal.map (Algebra.TensorProduct.includeRight :
              MvPolynomial (Fin N) F →ₐ[F]
                TensorProduct F (AlgebraicClosure F) (MvPolynomial (Fin N) F)) I) := by
            refine Ideal.map_le_iff_le_comap.mpr ?_
            intro p hp
            rw [Ideal.mem_comap, Ideal.mem_comap, ← hc, AlgEquiv.symm_apply_apply]
            exact Ideal.mem_map_of_mem _ hp
          exact hle hx
      have := key θ
      rwa [hθ] at this
    · let θ : MvPolynomial (Fin N) F →+* TensorProduct F (AlgebraicClosure F) A :=
        ((Algebra.TensorProduct.includeRight : A →ₐ[F] TensorProduct F (AlgebraicClosure F) A) :
          A →+* _).comp (ψ : _ →+* A)
      have hθ : RingHom.ker θ = I := by
        ext p
        rw [RingHom.mem_ker]
        show Algebra.TensorProduct.includeRight (ψ p) = 0 ↔ _
        rw [map_eq_zero_iff _ hinc, ← RingHom.mem_ker, hψker]
      have := key θ
      rwa [hθ] at this

  have lw_affine_points_basicOpen : ∀ (F : Type u) [Field F] (X : Over (Spec (.of F)))
      (V : X.left.Opens), IsAffineOpen V →
      ∀ (_ : Algebra F Γ(X.left, V)),
        algebraMap F Γ(X.left, V) =
          ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ X.hom.appLE ⊤ V le_top).hom →
      ∀ (E : Type u) [Field E] [Algebra F E],
        ∃ e : {f : Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X //
            Set.range f.left ⊆ (V : Set X.left)} ≃ (Γ(X.left, V) →ₐ[F] E),
          ∀ f (b : Γ(X.left, V)), e f b ≠ 0 →
            Set.range f.1.left ⊆ (X.left.basicOpen b : Set X.left) := by
    intro F _ X V hV alg halg E _ _
    let φ : CommRingCat.of F ⟶ Γ(X.left, V) :=
      (Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ X.hom.appLE ⊤ V le_top
    have hT : IsAffineOpen (⊤ : (Spec (CommRingCat.of F)).Opens) := isAffineOpen_top _
    have s3 : Spec.map φ = hV.fromSpec ≫ X.hom := by
      have h1 := IsAffineOpen.SpecMap_appLE_fromSpec X.hom hT hV le_top
      have h2 : hT.fromSpec = Spec.map (Scheme.ΓSpecIso (CommRingCat.of F)).inv := by
        rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv]
      rw [h2] at h1
      simp only [φ, Spec.map_comp]
      exact h1
    haveI := hV.isOpenImmersion_fromSpec
    let e1 : {f : Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X //
        Set.range f.left ⊆ (V : Set X.left)} ≃
        {ψ : Γ(X.left, V) ⟶ CommRingCat.of E // φ ≫ ψ = CommRingCat.ofHom (algebraMap F E)} :=
      { toFun := fun f => ⟨Spec.preimage (IsOpenImmersion.lift hV.fromSpec f.1.left
                  (by rw [hV.range_fromSpec]; exact f.2)), by
            apply Spec.map_injective
            rw [Spec.map_comp, Spec.map_preimage, s3, ← Category.assoc,
              IsOpenImmersion.lift_fac]
            exact Over.w f.1⟩,
        invFun := fun ψ => ⟨Over.homMk (Spec.map ψ.1 ≫ hV.fromSpec) (by
            rw [Category.assoc, ← s3, ← Spec.map_comp, ψ.2]
            rfl), by
            rintro _ ⟨x, rfl⟩
            rw [← hV.range_fromSpec]
            exact ⟨Spec.map ψ.1 x, rfl⟩⟩,
        left_inv := by
          intro f
          apply Subtype.ext
          apply Over.OverMorphism.ext
          simp only [Over.homMk_left]
          rw [Spec.map_preimage, IsOpenImmersion.lift_fac],
        right_inv := by
          intro ψ
          apply Subtype.ext
          apply Spec.map_injective
          rw [Spec.map_preimage]
          exact (IsOpenImmersion.lift_uniq _ _ _ _ rfl).symm }
    have hcomm : ∀ (ψ : {ψ : Γ(X.left, V) ⟶ CommRingCat.of E //
        φ ≫ ψ = CommRingCat.ofHom (algebraMap F E)}) (c : F),
        ψ.1.hom (algebraMap F Γ(X.left, V) c) = algebraMap F E c := by
      intro ψ c
      have := congrArg (fun h : CommRingCat.of F ⟶ CommRingCat.of E => h.hom c) ψ.2
      rw [halg]
      exact this
    have hcomm2 : ∀ (g : Γ(X.left, V) →ₐ[F] E),
        φ ≫ CommRingCat.ofHom g.toRingHom = CommRingCat.ofHom (algebraMap F E) := by
      intro g
      ext c
      have := g.commutes c
      rw [halg] at this
      exact this
    let e2 : {ψ : Γ(X.left, V) ⟶ CommRingCat.of E //
        φ ≫ ψ = CommRingCat.ofHom (algebraMap F E)} ≃ (Γ(X.left, V) →ₐ[F] E) :=
      { toFun := fun ψ => { toRingHom := ψ.1.hom, commutes' := hcomm ψ }
        invFun := fun g => ⟨CommRingCat.ofHom g.toRingHom, hcomm2 g⟩
        left_inv := fun ψ => Subtype.ext rfl
        right_inv := fun g => AlgHom.ext fun _ => rfl }
    refine ⟨e1.trans e2, ?_⟩
    intro f b hb
    rintro _ ⟨pt, rfl⟩
    set g := IsOpenImmersion.lift hV.fromSpec f.1.left
      (by rw [hV.range_fromSpec]; exact f.2) with hg
    have hfac : g ≫ hV.fromSpec = f.1.left := IsOpenImmersion.lift_fac _ _ _
    have hψ : Spec.map (Spec.preimage g) = g := Spec.map_preimage g
    have hbval : (Spec.preimage g).hom b ≠ 0 := hb
    have hmem : g pt ∈ PrimeSpectrum.basicOpen b := by
      rw [← hψ]
      refine (PrimeSpectrum.mem_basicOpen b ((Spec.map (Spec.preimage g)) pt)).mpr ?_
      have hpt : ((Spec.map (Spec.preimage g)) pt).asIdeal =
          Ideal.comap (Spec.preimage g).hom (pt : PrimeSpectrum E).asIdeal := by
        show ((Spec.map (Spec.preimage g)).base pt).asIdeal = _
        rw [Spec.map_base]
        rfl
      haveI hpr : (pt : PrimeSpectrum E).asIdeal.IsPrime := PrimeSpectrum.isPrime _
      rw [hpt, Ideal.mem_comap, Ideal.eq_bot_of_prime (pt : PrimeSpectrum E).asIdeal]
      exact hbval
    rw [← hfac, Scheme.Hom.comp_apply, ← hV.fromSpec_image_basicOpen]
    exact ⟨g pt, hmem, rfl⟩

  haveI hirr : IrreducibleSpace X.left :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (K := F) (𝟙 _) (𝟙 X.left) X.hom
      IsPullback.of_id_fst

  obtain ⟨k, V, hVa, hVne, hVcov, hVsm⟩ := lw_chart_smooth_cover F X d hirr.toNonempty

  have hchart : ∀ i : Fin (k + 1), ∃ (c : ℕ) (rel : Fin c → MvPolynomial (Fin (d + c)) F)
      (h : MvPolynomial (Fin (d + c)) F),
      (∃ w : MvPolynomial (Fin (d + c)) F,
        (Matrix.of fun a b : Fin c =>
          MvPolynomial.pderiv (Fin.natAdd d b) (rel a)).det * w - 1 ∈
            Ideal.span (Set.range rel)) ∧
      (Ideal.span (Set.range rel)).radical.IsPrime ∧
      (Ideal.span (Set.range fun a =>
          MvPolynomial.map (algebraMap F (AlgebraicClosure F)) (rel a))).radical.IsPrime ∧
      h ∉ (Ideal.span (Set.range rel)).radical ∧
      ∀ (E : Type u) [Field E] [Algebra F E],
        ∃ e : {f : Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X //
            Set.range f.left ⊆ (V i : Set X.left)} ≃
          {x : Fin (d + c) → E // ∀ p ∈ Ideal.span (Set.range rel), MvPolynomial.aeval x p = 0},
          ∀ f, MvPolynomial.aeval (e f).1 h ≠ 0 → Set.range f.1.left ⊆ (V 0 : Set X.left) := by
    intro i
    letI alg : Algebra F Γ(X.left, V i) :=
      ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ X.hom.appLE ⊤ (V i) le_top).hom.toAlgebra
    have hsm : Algebra.IsStandardSmoothOfRelativeDimension d F Γ(X.left, V i) := hVsm i

    obtain ⟨c, rel, hJ, ⟨ε⟩⟩ := lw_standard_smooth_poly_presentation F d _ hsm
    set I := Ideal.span (Set.range rel) with hI

    have hnil := lw_affine_geom_nilradical_prime F X (V i) (hVa i) (hVne i) alg rfl
    obtain ⟨hG, hP⟩ := lw_geom_nilradical_to_ideals F _ _ _ ε hnil
    rw [hI, Ideal.map_span, ← Set.range_comp] at hG

    obtain ⟨x, hxi, hx0⟩ :=
      nonempty_preirreducible_inter (V i).isOpen (V 0).isOpen (hVne i) (hVne 0)
    obtain ⟨b, hbV, hxb⟩ := (hVa i).exists_basicOpen_le (V := V i ⊓ V 0) ⟨x, ⟨hxi, hx0⟩⟩ hxi
    obtain ⟨q, hq⟩ := ε.surjective b
    obtain ⟨hpol, rfl⟩ := Ideal.Quotient.mk_surjective q
    refine ⟨c, rel, hpol, hJ, hP, hG, ?_, ?_⟩
    · intro hmem
      obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp hmem
      have hmem' : hpol ^ (n + 1) ∈ I := by
        rw [pow_succ]; exact I.mul_mem_right _ hn
      have hb0 : b ^ (n + 1) = 0 := by
        rw [← hq, ← map_pow, ← map_pow, Ideal.Quotient.eq_zero_iff_mem.mpr hmem', map_zero]
      have hbot : X.left.basicOpen b = ⊥ := by
        rw [← Scheme.basicOpen_pow X.left b (Nat.succ_pos n), hb0, Scheme.basicOpen_zero]
      have hx : x ∈ X.left.basicOpen b := hxb
      rw [hbot] at hx
      simp at hx
    · intro E _ _

      obtain ⟨e', he'⟩ := lw_affine_points_basicOpen F X (V i) (hVa i) alg rfl E

      have hev : ∀ (φ : Γ(X.left, V i) →ₐ[F] E) (p : MvPolynomial (Fin (d + c)) F),
          MvPolynomial.aeval (fun j => φ (ε (Ideal.Quotient.mk I (MvPolynomial.X j)))) p =
            φ (ε (Ideal.Quotient.mk I p)) := by
        intro φ p
        have hext : MvPolynomial.aeval (fun j => φ (ε (Ideal.Quotient.mk I (MvPolynomial.X j)))) =
            (φ.comp ε.toAlgHom).comp (Ideal.Quotient.mkₐ F I) := by
          apply MvPolynomial.algHom_ext
          intro j
          simp [Ideal.Quotient.mkₐ_eq_mk]
        exact DFunLike.congr_fun hext p
      let L : {x : Fin (d + c) → E // ∀ p ∈ I, MvPolynomial.aeval x p = 0} →
          (Γ(X.left, V i) →ₐ[F] E) := fun x =>
        (Ideal.Quotient.liftₐ I (MvPolynomial.aeval x.1) x.2).comp ε.symm.toAlgHom
      have hL : ∀ x p, L x (ε (Ideal.Quotient.mk I p)) = MvPolynomial.aeval x.1 p := by
        intro x p
        show Ideal.Quotient.liftₐ I (MvPolynomial.aeval x.1) x.2
            (ε.symm (ε (Ideal.Quotient.mk I p))) = _
        rw [AlgEquiv.symm_apply_apply]
        rfl
      let e'' : {x : Fin (d + c) → E // ∀ p ∈ I, MvPolynomial.aeval x p = 0} ≃
          (Γ(X.left, V i) →ₐ[F] E) :=
        { toFun := L
          invFun := fun φ => ⟨fun j => φ (ε (Ideal.Quotient.mk I (MvPolynomial.X j))),
            fun p hp => by
              rw [hev, Ideal.Quotient.eq_zero_iff_mem.mpr hp, map_zero, map_zero]⟩
          left_inv := fun x => by
            apply Subtype.ext
            funext j
            show L x (ε (Ideal.Quotient.mk I (MvPolynomial.X j))) = x.1 j
            rw [hL]
            simp
          right_inv := fun φ => by
            apply AlgHom.ext
            intro a
            obtain ⟨q, rfl⟩ := ε.surjective a
            obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective q
            rw [hL]
            exact hev φ p }
      refine ⟨e'.trans e''.symm, fun f hne => ?_⟩
      have h1 : e'' ((e'.trans e''.symm) f) = e' f := by
        simp only [Equiv.trans_apply, Equiv.apply_symm_apply]
      have h2 : e' f b ≠ 0 := by
        rw [← hq, ← h1]
        change L _ _ ≠ 0
        rw [hL]
        exact hne
      intro y hy
      exact SetLike.le_def.mp (hbV.trans inf_le_right) (he' f b h2 hy)
  choose c rel h hJ hP hG hH hpts using hchart
  refine ⟨k, c, rel, h, hJ, hP, hG 0, hH, ?_⟩
  intro E _ _ _
  haveI : Finite E := Module.finite_of_finite F
  choose e he using fun i => hpts i E

  have hcov : ∀ f : (Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X),
      ∃ i, Set.range f.left ⊆ (V i : Set X.left) := by
    intro f
    obtain ⟨pt⟩ : Nonempty (PrimeSpectrum E) := inferInstance
    obtain ⟨i, hi⟩ := hVcov (f.left pt)
    refine ⟨i, ?_⟩
    rintro _ ⟨y, rfl⟩
    have hy : y = pt := Subsingleton.elim (α := PrimeSpectrum E) y pt
    rw [hy]
    exact hi
  choose ι hι using hcov
  have hZ : ∀ i f (hf : Set.range f.left ⊆ (V i : Set X.left)),
      ¬ Set.range f.left ⊆ (V 0 : Set X.left) →
      MvPolynomial.aeval (e i ⟨f, hf⟩).1 (h i) = 0 := by
    intro i f hf h0
    by_contra hne
    exact h0 (he i ⟨f, hf⟩ hne)

  haveI hfin : Finite (Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) := by
    refine Finite.of_injective (β := Σ i, {x : Fin (d + c i) → E //
        ∀ p ∈ Ideal.span (Set.range (rel i)), MvPolynomial.aeval x p = 0})
      (fun f => ⟨ι f, e (ι f) ⟨f, hι f⟩⟩) ?_
    apply Function.LeftInverse.injective (g := fun s => ((e s.1).symm s.2).1)
    intro f
    simp
  constructor
  · apply Nat.card_le_card_of_injective (fun x => ((e 0).symm x).1)
    intro x y hxy
    exact (e 0).symm.injective (Subtype.ext hxy)
  · let G : (Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) →
        {x : Fin (d + c 0) → E // ∀ p ∈ Ideal.span (Set.range (rel 0)),
          MvPolynomial.aeval x p = 0} ⊕
        (Σ i, {x : Fin (d + c i) → E //
          (∀ p ∈ Ideal.span (Set.range (rel i)), MvPolynomial.aeval x p = 0) ∧
            MvPolynomial.aeval x (h i) = 0}) :=
      fun f => if h0 : Set.range f.left ⊆ (V 0 : Set X.left) then Sum.inl (e 0 ⟨f, h0⟩)
        else Sum.inr ⟨ι f, ⟨(e (ι f) ⟨f, hι f⟩).1, (e (ι f) ⟨f, hι f⟩).2,
          hZ (ι f) f (hι f) h0⟩⟩
    let L : ({x : Fin (d + c 0) → E // ∀ p ∈ Ideal.span (Set.range (rel 0)),
          MvPolynomial.aeval x p = 0} ⊕
        (Σ i, {x : Fin (d + c i) → E //
          (∀ p ∈ Ideal.span (Set.range (rel i)), MvPolynomial.aeval x p = 0) ∧
            MvPolynomial.aeval x (h i) = 0})) →
        (Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X) :=
      Sum.elim (fun x => ((e 0).symm x).1) (fun s => ((e s.1).symm ⟨s.2.1, s.2.2.1⟩).1)
    have hGinj : Function.Injective G := by
      apply Function.LeftInverse.injective (g := L)
      intro f
      by_cases h0 : Set.range f.left ⊆ (V 0 : Set X.left)
      · simp only [G, dif_pos h0, L, Sum.elim_inl, Equiv.symm_apply_apply]
      · simp only [G, dif_neg h0, L, Sum.elim_inr, Subtype.coe_eta, Equiv.symm_apply_apply]
    calc Nat.card (Over.mk (Spec.map <| CommRingCat.ofHom <| algebraMap F E) ⟶ X)
        ≤ Nat.card ({x : Fin (d + c 0) → E // ∀ p ∈ Ideal.span (Set.range (rel 0)),
          MvPolynomial.aeval x p = 0} ⊕
        (Σ i, {x : Fin (d + c i) → E //
          (∀ p ∈ Ideal.span (Set.range (rel i)), MvPolynomial.aeval x p = 0) ∧
            MvPolynomial.aeval x (h i) = 0})) := Nat.card_le_card_of_injective G hGinj
      _ = _ := by rw [Nat.card_sum, Nat.card_sigma]

theorem lw_jacobian_generic_separable (K : Type u) [Field K] (d c : ℕ)
    (rel : Fin c → MvPolynomial (Fin (d + c)) K)
    (hJ : ∃ w : MvPolynomial (Fin (d + c)) K,
      (Matrix.of fun a b : Fin c => MvPolynomial.pderiv (Fin.natAdd d b) (rel a)).det * w - 1 ∈
        Ideal.span (Set.range rel))
    (hP : (Ideal.span (Set.range rel)).radical.IsPrime) :
    (Ideal.span (Set.range rel)).IsPrime ∧
    (∀ p : MvPolynomial (Fin d) K,
        MvPolynomial.rename (Fin.castAdd c) p ∈ Ideal.span (Set.range rel) → p = 0) ∧
    ∀ j : Fin (d + c), ∃ P : Polynomial (MvPolynomial (Fin d) K),
      Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd c)).toRingHom (MvPolynomial.X j) P ∈
          Ideal.span (Set.range rel) ∧
      Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd c)).toRingHom (MvPolynomial.X j)
          (Polynomial.derivative P) ∉ Ideal.span (Set.range rel) :=
by
  classical

  have s2 : ∀ (R : Type u) [CommRing R] (g : Fin c → MvPolynomial (Fin c) R)
      (w : MvPolynomial (Fin c) R),
      (Matrix.of fun a b : Fin c => MvPolynomial.pderiv b (g a)).det * w - 1 ∈
        Ideal.span (Set.range g) →
      Algebra.Etale R (MvPolynomial (Fin c) R ⧸ Ideal.span (Set.range g)) := by
    intro R _ g w hw
    let P₀ : Algebra.PreSubmersivePresentation R
        (MvPolynomial (Fin c) R ⧸ Ideal.span (Set.range g)) (Fin c) (Fin c) :=
      Algebra.PreSubmersivePresentation.naive (v := g) id Function.injective_id
    have halg : ∀ x : P₀.Ring,
        algebraMap P₀.Ring (MvPolynomial (Fin c) R ⧸ Ideal.span (Set.range g)) x =
        Ideal.Quotient.mk (Ideal.span (Set.range g)) x := by
      intro x
      rw [Algebra.Generators.algebraMap_eq]
      have : (MvPolynomial.aeval P₀.val : MvPolynomial (Fin c) R →ₐ[R] _) =
          Ideal.Quotient.mkₐ R (Ideal.span (Set.range g)) := by
        apply MvPolynomial.algHom_ext
        intro i
        simp [P₀]
      exact congrArg (fun φ => φ x) this
    have hjac : P₀.jacobian =
        Ideal.Quotient.mk (Ideal.span (Set.range g))
          (Matrix.of fun a b : Fin c => MvPolynomial.pderiv b (g a)).det := by
      rw [P₀.jacobian_eq_jacobiMatrix_det]
      have h1 : P₀.jacobiMatrix =
          (Matrix.of fun a b : Fin c => MvPolynomial.pderiv b (g a)).transpose := by
        refine Matrix.ext fun i j => ?_
        rw [P₀.jacobiMatrix_apply]
        rfl
      rw [h1, Matrix.det_transpose]
      exact halg _
    have hunit : IsUnit P₀.jacobian := by
      rw [hjac]
      refine isUnit_iff_exists_inv.mpr ⟨Ideal.Quotient.mk _ w, ?_⟩
      rw [← map_mul, ← sub_eq_zero, ← map_one (Ideal.Quotient.mk _), ← map_sub,
        Ideal.Quotient.eq_zero_iff_mem]
      exact hw
    let P : Algebra.SubmersivePresentation R _ (Fin c) (Fin c) :=
      { P₀ with jacobian_isUnit := hunit }
    have := P.isStandardSmoothOfRelativeDimension (n := 0)
      (by simp [Algebra.Presentation.dimension])
    infer_instance

  have s3 : ∀ (R : Type u) (A : Type u) [CommRing R] [IsDomain R]
      [CommRing A] [Nontrivial A] [Algebra R A] [Algebra.Etale R A],
      Function.Injective (algebraMap R A) := by
    intro R A _ _ _ _ _ _
    have htf : Module.IsTorsionFree R A := Module.Flat.isTorsionFree
    rw [injective_iff_map_eq_zero]
    intro r hr
    by_contra hne
    have hreg := htf.isSMulRegular (IsRegular.of_ne_zero hne)
    apply one_ne_zero (α := A)
    apply hreg
    simp only [smul_zero]
    rw [← Algebra.algebraMap_eq_smul_one, hr]

  have s4 : ∀ (R : Type u) (A : Type u) [CommRing R] [IsDomain R]
      [CommRing A] [Algebra R A] [Algebra.Etale R A], IsReduced A := by
    intro R A _ _ _ _ _
    let F := FractionRing R
    have : Algebra.FormallyUnramified F (TensorProduct R F A) :=
      Algebra.FormallyUnramified.base_change F
    have : Algebra.EssFiniteType F (TensorProduct R F A) :=
      Algebra.EssFiniteType.baseChange R A F
    have : IsReduced (TensorProduct R F A) := Algebra.FormallyUnramified.isReduced_of_field F _
    have hinj : Function.Injective
        (Algebra.TensorProduct.includeRight : A →ₐ[R] TensorProduct R F A) :=
      Algebra.TensorProduct.includeRight_injective (IsFractionRing.injective R F)
    exact isReduced_of_injective _ hinj

  have s5 : ∀ (R : Type u) (A : Type u) [CommRing R] [IsDomain R]
      [CommRing A] [IsDomain A] [Algebra R A] [Algebra.Etale R A],
      Function.Injective (algebraMap R A) → ∀ a : A,
      ∃ P : Polynomial R, Polynomial.aeval a P = 0 ∧
        Polynomial.aeval a (Polynomial.derivative P) ≠ 0 := by
    intro R A _ _ _ _ _ _ hinj a
    let L := FractionRing A
    have hRL : Function.Injective (algebraMap R L) := by
      rw [IsScalarTower.algebraMap_eq R A L]
      exact (IsFractionRing.injective A L).comp hinj
    have : FaithfulSMul R L := (faithfulSMul_iff_algebraMap_injective R L).mpr hRL
    letI : Algebra (FractionRing R) L := FractionRing.liftAlgebra R L
    haveI : IsScalarTower R (FractionRing R) L := FractionRing.isScalarTower_liftAlgebra R L
    haveI : Algebra.FormallyUnramified A L :=
      Algebra.FormallyUnramified.of_isLocalization (nonZeroDivisors A)
    haveI : Algebra.FormallyUnramified R L := Algebra.FormallyUnramified.comp R A L
    haveI : Algebra.FormallyUnramified (FractionRing R) L :=
      Algebra.FormallyUnramified.of_restrictScalars R (FractionRing R) L
    haveI : Algebra.EssFiniteType A L :=
      Algebra.EssFiniteType.of_isLocalization L (nonZeroDivisors A)
    haveI : Algebra.EssFiniteType R L := Algebra.EssFiniteType.comp R A L
    haveI : Algebra.EssFiniteType (FractionRing R) L :=
      Algebra.EssFiniteType.of_comp R (FractionRing R) L
    haveI : Algebra.IsSeparable (FractionRing R) L := Algebra.FormallyUnramified.isSeparable _ _
    set α := algebraMap A L a with hα
    set μ := minpoly (FractionRing R) α with hμ
    have hsep : μ.Separable := Algebra.IsSeparable.isSeparable (FractionRing R) α
    have hroot : Polynomial.aeval α μ = 0 := minpoly.aeval _ _
    obtain ⟨b, hb, hPb⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors R) μ
    set P := IsLocalization.integerNormalization (nonZeroDivisors R) μ
    have key : ∀ Q : Polynomial R, Polynomial.aeval α Q = algebraMap A L (Polynomial.aeval a Q) :=
      fun Q => Polynomial.aeval_algebraMap_apply L a Q
    have hb0 : algebraMap R L b ≠ 0 := by
      intro h
      exact nonZeroDivisors.ne_zero hb (hRL (by rw [h, map_zero]))
    have hsm : ∀ ν : Polynomial (FractionRing R), Polynomial.aeval α (b • ν) =
        algebraMap R L b * Polynomial.aeval α ν := by
      intro ν
      rw [← algebraMap_smul (FractionRing R) b ν, Polynomial.smul_eq_C_mul, map_mul,
        Polynomial.aeval_C, ← IsScalarTower.algebraMap_apply]
    have e1 : Polynomial.aeval α P = algebraMap R L b * Polynomial.aeval α μ := by
      rw [← Polynomial.aeval_map_algebraMap (FractionRing R), hPb, hsm]
    have e2 : Polynomial.aeval α (Polynomial.derivative P) =
        algebraMap R L b * Polynomial.aeval α (Polynomial.derivative μ) := by
      rw [← Polynomial.aeval_map_algebraMap (FractionRing R), ← Polynomial.derivative_map, hPb,
        Polynomial.derivative_smul, hsm]
    refine ⟨P, ?_, ?_⟩
    · apply IsFractionRing.injective A L
      rw [← key, e1, hroot, mul_zero, map_zero]
    · intro h
      have h2 := key (Polynomial.derivative P)
      rw [h, map_zero, e2] at h2
      exact mul_ne_zero hb0 (hsep.aeval_derivative_ne_zero hroot) h2

  obtain ⟨Φ, hΦ1, hΦ2, hΦ3⟩ : ∃ Φ : MvPolynomial (Fin (d + c)) K ≃ₐ[K]
      MvPolynomial (Fin c) (MvPolynomial (Fin d) K),
      (∀ p : MvPolynomial (Fin d) K, Φ (MvPolynomial.rename (Fin.castAdd c) p) = MvPolynomial.C p) ∧
      (∀ b : Fin c, Φ (MvPolynomial.X (Fin.natAdd d b)) = MvPolynomial.X b) ∧
      (∀ (b : Fin c) (f : MvPolynomial (Fin (d + c)) K),
        MvPolynomial.pderiv b (Φ f) = Φ (MvPolynomial.pderiv (Fin.natAdd d b) f)) := by
    let e : Fin (d + c) ≃ Fin c ⊕ Fin d :=
      finSumFinEquiv.symm.trans (Equiv.sumComm (Fin d) (Fin c))
    have he1 : ∀ i : Fin d, e (Fin.castAdd c i) = Sum.inr i := by
      intro i; simp [e]
    have he2 : ∀ b : Fin c, e (Fin.natAdd d b) = Sum.inl b := by
      intro b; simp [e]
    let Φ := (MvPolynomial.renameEquiv K e).trans (MvPolynomial.sumAlgEquiv K (Fin c) (Fin d))
    have hX1 : ∀ i : Fin d, Φ (MvPolynomial.X (Fin.castAdd c i)) =
        MvPolynomial.C (MvPolynomial.X i) := by
      intro i
      show MvPolynomial.sumRingEquiv K (Fin c) (Fin d)
        (MvPolynomial.rename e (MvPolynomial.X (Fin.castAdd c i))) = _
      rw [MvPolynomial.rename_X, he1, MvPolynomial.sumRingEquiv_X_inr]
    have hX2 : ∀ b : Fin c, Φ (MvPolynomial.X (Fin.natAdd d b)) = MvPolynomial.X b := by
      intro b
      show MvPolynomial.sumRingEquiv K (Fin c) (Fin d)
        (MvPolynomial.rename e (MvPolynomial.X (Fin.natAdd d b))) = _
      rw [MvPolynomial.rename_X, he2, MvPolynomial.sumRingEquiv_X_inl]
    have h1 : ∀ p : MvPolynomial (Fin d) K,
        Φ (MvPolynomial.rename (Fin.castAdd c) p) = MvPolynomial.C p := by
      intro p
      have : (Φ.toAlgHom.comp (MvPolynomial.rename (Fin.castAdd c))) =
          (IsScalarTower.toAlgHom K (MvPolynomial (Fin d) K)
            (MvPolynomial (Fin c) (MvPolynomial (Fin d) K))) := by
        apply MvPolynomial.algHom_ext
        intro i
        simp only [AlgHom.comp_apply, MvPolynomial.rename_X, IsScalarTower.coe_toAlgHom',
          MvPolynomial.algebraMap_eq]
        exact hX1 i
      have := congrArg (fun φ => φ p) this
      simpa [MvPolynomial.algebraMap_eq] using this
    refine ⟨Φ, h1, hX2, ?_⟩
    intro b f
    induction f using MvPolynomial.induction_on with
    | C a =>
      have : Φ (MvPolynomial.C a) = MvPolynomial.C (MvPolynomial.C a) := by
        rw [← MvPolynomial.algebraMap_eq, AlgEquiv.commutes]; rfl
      rw [this, MvPolynomial.pderiv_C, MvPolynomial.pderiv_C, map_zero]
    | add p q hp hq => rw [map_add, map_add, hp, hq, map_add, map_add]
    | mul_X p n hp =>
      rw [map_mul, MvPolynomial.pderiv_mul, MvPolynomial.pderiv_mul, map_add, map_mul, map_mul, hp]
      refine congrArg (fun t => Φ ((MvPolynomial.pderiv (Fin.natAdd d b)) p) *
        Φ (MvPolynomial.X n) + Φ p * t) ?_
      refine Fin.addCases (fun i => ?_) (fun b' => ?_) n
      · rw [hX1, MvPolynomial.pderiv_X, MvPolynomial.pderiv_C, Pi.single_apply, if_neg, map_zero]
        intro h
        have := congrArg Fin.val h
        simp at this
        omega
      · rw [hX2, MvPolynomial.pderiv_X, MvPolynomial.pderiv_X, Pi.single_apply, Pi.single_apply]
        by_cases hb : b' = b
        · subst hb; simp
        · rw [if_neg hb, if_neg, map_zero]
          intro h
          apply hb
          ext
          have := congrArg Fin.val h
          simp at this
          omega

  have hmap : Ideal.map Φ (Ideal.span (Set.range rel)) =
      Ideal.span (Set.range (fun a => Φ (rel a))) := by
    rw [Ideal.map_span, ← Set.range_comp]
    rfl
  have hmem : ∀ f, f ∈ Ideal.span (Set.range rel) ↔
      Φ f ∈ Ideal.span (Set.range (fun a => Φ (rel a))) := by
    intro f
    have hc : Ideal.comap Φ (Ideal.map Φ (Ideal.span (Set.range rel))) =
        Ideal.span (Set.range rel) := Ideal.comap_map_of_bijective Φ Φ.bijective
    rw [← hmap]
    constructor
    · intro hf; exact Ideal.mem_map_of_mem _ hf
    · intro hf
      rw [← hc]
      exact hf

  haveI hEt : Algebra.Etale (MvPolynomial (Fin d) K)
      (MvPolynomial (Fin c) (MvPolynomial (Fin d) K) ⧸
        Ideal.span (Set.range (fun a => Φ (rel a)))) := by
    obtain ⟨w, hw⟩ := hJ
    have hdet : (Matrix.of fun a b : Fin c => MvPolynomial.pderiv b (Φ (rel a))).det =
        Φ (Matrix.of fun a b : Fin c => MvPolynomial.pderiv (Fin.natAdd d b) (rel a)).det := by
      have := RingHom.map_det
        (Φ : MvPolynomial (Fin (d + c)) K →+* MvPolynomial (Fin c) (MvPolynomial (Fin d) K))
        (Matrix.of fun a b : Fin c => MvPolynomial.pderiv (Fin.natAdd d b) (rel a))
      rw [show ((Φ : MvPolynomial (Fin (d + c)) K →+* MvPolynomial (Fin c) (MvPolynomial (Fin d) K))
          (Matrix.of fun a b : Fin c => MvPolynomial.pderiv (Fin.natAdd d b) (rel a)).det) =
          Φ (Matrix.of fun a b : Fin c => MvPolynomial.pderiv (Fin.natAdd d b) (rel a)).det
          from rfl] at this
      rw [this]
      congr 1
      refine Matrix.ext fun a b => ?_
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply]
      rw [hΦ3]
      rfl
    refine s2 (MvPolynomial (Fin d) K) (fun a => Φ (rel a)) (Φ w) ?_
    rw [hdet, ← map_mul, ← map_one Φ, ← map_sub]
    exact (hmem _).mp hw

  have hJtop : (1 : MvPolynomial (Fin (d + c)) K) ∉ Ideal.span (Set.range rel) := by
    intro h1
    exact hP.ne_top ((Ideal.eq_top_iff_one _).mpr (Ideal.le_radical h1))
  have hJ'top : Ideal.span (Set.range (fun a => Φ (rel a))) ≠ ⊤ := by
    intro h
    apply hJtop
    rw [hmem, map_one, h]
    exact Submodule.mem_top
  haveI : Nontrivial (MvPolynomial (Fin c) (MvPolynomial (Fin d) K) ⧸
      Ideal.span (Set.range (fun a => Φ (rel a)))) :=
    Ideal.Quotient.nontrivial_iff.mpr hJ'top
  have hinj := s3 (MvPolynomial (Fin d) K) (MvPolynomial (Fin c) (MvPolynomial (Fin d) K) ⧸
      Ideal.span (Set.range (fun a => Φ (rel a))))
  have hred := s4 (MvPolynomial (Fin d) K) (MvPolynomial (Fin c) (MvPolynomial (Fin d) K) ⧸
      Ideal.span (Set.range (fun a => Φ (rel a))))

  have hJrad : (Ideal.span (Set.range rel)).IsRadical := by
    have hJ'rad : (Ideal.span (Set.range (fun a => Φ (rel a)))).IsRadical :=
      (Ideal.isRadical_iff_quotient_reduced _).mpr hred
    have := hJ'rad.comap
      (Φ : MvPolynomial (Fin (d + c)) K →+* MvPolynomial (Fin c) (MvPolynomial (Fin d) K))
    have hc : Ideal.comap
        (Φ : MvPolynomial (Fin (d + c)) K →+* MvPolynomial (Fin c) (MvPolynomial (Fin d) K))
        (Ideal.span (Set.range (fun a => Φ (rel a)))) = Ideal.span (Set.range rel) := by
      ext f
      rw [Ideal.mem_comap, hmem]
      rfl
    rwa [hc] at this
  have hJprime : (Ideal.span (Set.range rel)).IsPrime := by
    rw [← hJrad.radical]
    exact hP
  refine ⟨hJprime, ?_, ?_⟩

  · intro p hp
    rw [hmem, hΦ1] at hp
    apply hinj
    rw [map_zero, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq,
      Ideal.Quotient.eq_zero_iff_mem]
    exact hp

  · intro j
    haveI hJ'p : (Ideal.span (Set.range (fun a => Φ (rel a)))).IsPrime := by
      rw [← hmap]
      exact Ideal.map_isPrime_of_equiv Φ
    haveI : IsDomain (MvPolynomial (Fin c) (MvPolynomial (Fin d) K) ⧸
        Ideal.span (Set.range (fun a => Φ (rel a)))) :=
      (Ideal.Quotient.isDomain_iff_prime _).mpr hJ'p
    let π : MvPolynomial (Fin (d + c)) K →+* MvPolynomial (Fin c) (MvPolynomial (Fin d) K) ⧸
        Ideal.span (Set.range (fun a => Φ (rel a))) :=
      (Ideal.Quotient.mk _).comp
        (Φ : MvPolynomial (Fin (d + c)) K →+* MvPolynomial (Fin c) (MvPolynomial (Fin d) K))
    have hπ : ∀ f, f ∈ Ideal.span (Set.range rel) ↔ π f = 0 := by
      intro f
      rw [hmem]
      exact (Ideal.Quotient.eq_zero_iff_mem).symm
    have hcomp : π.comp (MvPolynomial.rename (Fin.castAdd c)).toRingHom =
        algebraMap (MvPolynomial (Fin d) K) (MvPolynomial (Fin c) (MvPolynomial (Fin d) K) ⧸
          Ideal.span (Set.range (fun a => Φ (rel a)))) := by
      refine RingHom.ext fun p => ?_
      show Ideal.Quotient.mk _ (Φ ((MvPolynomial.rename (Fin.castAdd c)) p)) = _
      rw [hΦ1, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
    have heval : ∀ Q : Polynomial (MvPolynomial (Fin d) K),
        π (Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd c)).toRingHom (MvPolynomial.X j) Q) =
        Polynomial.aeval (π (MvPolynomial.X j)) Q := by
      intro Q
      rw [Polynomial.hom_eval₂, hcomp, Polynomial.aeval_def]
    obtain ⟨Q, hQ1, hQ2⟩ := s5 (MvPolynomial (Fin d) K)
      (MvPolynomial (Fin c) (MvPolynomial (Fin d) K) ⧸
        Ideal.span (Set.range (fun a => Φ (rel a)))) hinj (π (MvPolynomial.X j))
    refine ⟨Q, ?_, ?_⟩
    · rw [hπ, heval]; exact hQ1
    · rw [hπ, heval]; exact hQ2

theorem lw_lower_dim_bound (F : Type u) [Field F] [Finite F] (N s : ℕ)
    (I : Ideal (MvPolynomial (Fin N) F)) (hI : I.IsPrime)
    (g : MvPolynomial (Fin s) F →ₐ[F] MvPolynomial (Fin N) F ⧸ I) (hg : g.Finite)
    (h : MvPolynomial (Fin N) F) (hh : h ∉ I) :
    ∃ C : ℝ, ∀ (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E],
      (Nat.card {x : Fin N → E //
          (∀ p ∈ I, MvPolynomial.aeval x p = 0) ∧ MvPolynomial.aeval x h = 0} : ℝ) *
          (Nat.card E : ℝ) ≤ C * (Nat.card E : ℝ) ^ s :=
by
  classical

  have s1 : ∀ (R A : Type u) [CommRing R] [CommRing A] [IsDomain A]
      (f : R →+* A) (_hf : f.IsIntegral) (a : A) (_ha : a ≠ 0),
      ∃ ν : Polynomial R, ν.Monic ∧ Polynomial.eval₂ f a ν = 0 ∧ f (ν.coeff 0) ≠ 0 := by
    intro R A _ _ _ f hf a ha
    have hex : ∃ m, ∃ ν : Polynomial R, ν.Monic ∧ ν.natDegree = m ∧
        Polynomial.eval₂ f a ν = 0 := by
      obtain ⟨p, hp, hpe⟩ := hf a
      exact ⟨_, p, hp, rfl, hpe⟩
    obtain ⟨ν, hνm, hνd, hνe⟩ := Nat.find_spec hex
    refine ⟨ν, hνm, hνe, ?_⟩
    intro h0
    set m := Nat.find hex with hm
    have hm0 : m ≠ 0 := by
      intro hm0
      have : ν = 1 := Polynomial.eq_one_of_monic_natDegree_zero hνm (by omega)
      rw [this, Polynomial.eval₂_one] at hνe
      exact one_ne_zero hνe
    have hdecomp := Polynomial.divX_mul_X_add ν
    have h1 : Polynomial.eval₂ f a (Polynomial.divX ν) * a = 0 := by
      have := congrArg (Polynomial.eval₂ f a) hdecomp
      rw [Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_X, Polynomial.eval₂_C, h0,
        add_zero, hνe] at this
      exact this
    have h2 : Polynomial.eval₂ f a (Polynomial.divX ν) = 0 :=
      (mul_eq_zero.mp h1).resolve_right ha
    have hdeg : (Polynomial.divX ν).natDegree = m - 1 := by
      rw [Polynomial.natDegree_divX_eq_natDegree_tsub_one, hνd]
    have hmon : (Polynomial.divX ν).Monic := by
      unfold Polynomial.Monic Polynomial.leadingCoeff
      rw [hdeg, Polynomial.coeff_divX, Nat.sub_add_cancel (Nat.pos_of_ne_zero hm0), ← hνd]
      exact hνm.coeff_natDegree
    have := Nat.find_min' hex ⟨_, hmon, hdeg, h2⟩
    omega

  have s2 : ∀ (E : Type u) [Field E] [Finite E] (N : ℕ) (P : Fin N → Polynomial E)
      (_hP : ∀ j, P j ≠ 0),
      Nat.card {x : Fin N → E // ∀ j, (P j).eval (x j) = 0} ≤ ∏ j, (P j).natDegree := by
    intro E _ _ N P hP
    have := Fintype.ofFinite E
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
    calc (Finset.univ.filter fun x : Fin N → E => ∀ j, (P j).eval (x j) = 0).card
        ≤ (Fintype.piFinset fun j => (P j).roots.toFinset).card := by
          apply Finset.card_le_card
          intro x hx
          simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx
          rw [Fintype.mem_piFinset]
          intro j
          rw [Multiset.mem_toFinset, Polynomial.mem_roots (hP j)]
          exact hx j
      _ = ∏ j, (P j).roots.toFinset.card := Fintype.card_piFinset _
      _ ≤ ∏ j, (P j).natDegree := by
          apply Finset.prod_le_prod'
          intro j _
          exact (Multiset.toFinset_card_le _).trans (Polynomial.card_roots' _)

  have s3 : ∀ (E : Type u) [Field E] [Finite E] (N s M : ℕ) (P : (Fin N → E) → Prop)
      (Θ : (Fin N → E) → (Fin s → E)) (ν : MvPolynomial (Fin s) E) (_hν : ν ≠ 0)
      (_hvan : ∀ x, P x → MvPolynomial.eval (Θ x) ν = 0)
      (_hfib : ∀ t, Nat.card {x // P x ∧ Θ x = t} ≤ M),
      (Nat.card {x // P x} : ℝ) * (Nat.card E : ℝ) ≤
        ((M : ℝ) * (ν.totalDegree : ℝ)) * (Nat.card E : ℝ) ^ s := by
    intro E _ _ N s M P Θ ν hν hvan hfib
    have := Fintype.ofFinite E
    set q := Fintype.card E with hq
    have hqpos : 0 < q := Fintype.card_pos
    set S := Finset.univ.filter P with hS
    set Z := Finset.univ.filter (fun t : Fin s → E => MvPolynomial.eval t ν = 0) with hZ
    have hSZ := MvPolynomial.schwartz_zippel_totalDegree hν (Finset.univ : Finset E)
    rw [Fintype.piFinset_univ, Finset.card_univ, ← hq] at hSZ
    have hZb : Z.card * q ≤ ν.totalDegree * q ^ s := by
      have hq0 : (0 : NNRat) < q := by exact_mod_cast hqpos
      rw [div_le_div_iff₀ (pow_pos hq0 _) hq0] at hSZ
      have : ((Z.card * q : ℕ) : NNRat) ≤ ((ν.totalDegree * q ^ s : ℕ) : NNRat) := by
        push_cast
        convert hSZ using 2
      exact_mod_cast this
    have hfibS : ∀ b ∈ S.image Θ, (S.filter fun a => Θ a = b).card ≤ M := by
      intro b _
      have := hfib b
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype] at this
      convert this using 2
      ext a
      simp [hS]
    have hS1 := Finset.card_le_mul_card_image S M hfibS
    have himg : (S.image Θ).card ≤ Z.card := by
      apply Finset.card_le_card
      intro t ht
      obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp ht
      simp only [hS, Finset.mem_filter, Finset.mem_univ, true_and] at hx
      simp [hZ, hvan x hx]
    have hcard : Nat.card {x // P x} = S.card := by
      rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
    have hE : Nat.card E = q := Nat.card_eq_fintype_card
    have key : S.card * q ≤ M * ν.totalDegree * q ^ s := by
      calc S.card * q ≤ M * (S.image Θ).card * q := Nat.mul_le_mul_right _ hS1
        _ ≤ M * Z.card * q := by gcongr
        _ = M * (Z.card * q) := by ring
        _ ≤ M * (ν.totalDegree * q ^ s) := by gcongr
        _ = M * ν.totalDegree * q ^ s := by ring
    rw [hcard, hE]
    exact_mod_cast key

  have s4 : ∀ (τ : Fin s → MvPolynomial (Fin N) F)
      (_hτ : ∀ i, Ideal.Quotient.mk I (τ i) = g (MvPolynomial.X i))
      (q : MvPolynomial (Fin N) F) (μ : Polynomial (MvPolynomial (Fin s) F))
      (_hμ : Polynomial.eval₂ g.toRingHom (Ideal.Quotient.mk I q) μ = 0)
      (E : Type u) [CommRing E] [Algebra F E] (x : Fin N → E)
      (_hx : ∀ p ∈ I, MvPolynomial.aeval x p = 0),
      Polynomial.eval (MvPolynomial.aeval x q)
        (μ.map (MvPolynomial.aeval (fun i => MvPolynomial.aeval x (τ i))).toRingHom) = 0 := by
    intro τ hτ q μ hμ E _ _ x hx
    set φ := Ideal.Quotient.liftₐ I (MvPolynomial.aeval x) hx with hφ
    have hφmk : ∀ r, φ (Ideal.Quotient.mk I r) = MvPolynomial.aeval x r := fun r => rfl
    have hcomp : φ.comp g = MvPolynomial.aeval (fun i => MvPolynomial.aeval x (τ i)) := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [AlgHom.comp_apply, ← hτ, hφmk, MvPolynomial.aeval_X]
    have := congrArg φ hμ
    rw [map_zero, ← AlgHom.coe_toRingHom, Polynomial.hom_eval₂] at this
    rw [Polynomial.eval_map, ← hφmk, ← this]
    congr 1
    rw [← hcomp]
    rfl

  haveI : IsDomain (MvPolynomial (Fin N) F ⧸ I) := Ideal.Quotient.isDomain I
  have hint : g.toRingHom.IsIntegral := RingHom.Finite.to_isIntegral hg
  choose τ hτ using fun i : Fin s => Ideal.Quotient.mk_surjective (I := I) (g (MvPolynomial.X i))
  have hμex : ∀ j : Fin N, ∃ p : Polynomial (MvPolynomial (Fin s) F), p.Monic ∧
      Polynomial.eval₂ g.toRingHom (Ideal.Quotient.mk I (MvPolynomial.X j)) p = 0 :=
    fun j => hint (Ideal.Quotient.mk I (MvPolynomial.X j))
  choose μ hμm hμe using hμex
  have hπh : Ideal.Quotient.mk I h ≠ 0 := by
    rwa [Ne, Ideal.Quotient.eq_zero_iff_mem]
  obtain ⟨ν, _hνm, hνe, hν0⟩ := s1 _ _ g.toRingHom hint _ hπh
  have hν₀ : ν.coeff 0 ≠ 0 := by
    intro h0
    apply hν0
    rw [h0]
    exact map_zero _
  refine ⟨(∏ j, ((μ j).natDegree : ℝ)) * ((ν.coeff 0).totalDegree : ℝ), ?_⟩
  intro E _ _ _
  haveI : Finite E := Module.finite_of_finite F
  have hν' : MvPolynomial.map (algebraMap F E) (ν.coeff 0) ≠ 0 := by
    intro h0
    apply hν₀
    exact MvPolynomial.map_injective _ (algebraMap F E).injective (by rw [h0, map_zero])
  have hdeg : (MvPolynomial.map (algebraMap F E) (ν.coeff 0)).totalDegree ≤
      (ν.coeff 0).totalDegree := by
    unfold MvPolynomial.totalDegree
    exact Finset.sup_mono (MvPolynomial.support_map_subset _ _)
  have hvan : ∀ x : Fin N → E,
      ((∀ p ∈ I, MvPolynomial.aeval x p = 0) ∧ MvPolynomial.aeval x h = 0) →
      MvPolynomial.eval (fun i => MvPolynomial.aeval x (τ i))
        (MvPolynomial.map (algebraMap F E) (ν.coeff 0)) = 0 := by
    rintro x ⟨hx, hxh⟩
    have := s4 τ hτ h ν hνe E x hx
    rw [hxh, ← Polynomial.coeff_zero_eq_eval_zero, Polynomial.coeff_map] at this
    rw [MvPolynomial.eval_map, ← MvPolynomial.aeval_def]
    exact this
  have hmem : ∀ (t : Fin s → E) (y : {x : Fin N → E //
      ((∀ p ∈ I, MvPolynomial.aeval x p = 0) ∧ MvPolynomial.aeval x h = 0) ∧
        (fun i => MvPolynomial.aeval x (τ i)) = t}) (j : Fin N),
      ((μ j).map (MvPolynomial.aeval t).toRingHom).eval (y.1 j) = 0 := by
    rintro t ⟨y, ⟨hy, _⟩, ht⟩ j
    have := s4 τ hτ (MvPolynomial.X j) (μ j) (hμe j) E y hy
    rw [MvPolynomial.aeval_X, ht] at this
    exact this
  have hfib : ∀ t : Fin s → E, Nat.card {x : Fin N → E //
      ((∀ p ∈ I, MvPolynomial.aeval x p = 0) ∧ MvPolynomial.aeval x h = 0) ∧
        (fun i => MvPolynomial.aeval x (τ i)) = t} ≤ ∏ j, (μ j).natDegree := by
    intro t
    have hP' : ∀ j, ((μ j).map (MvPolynomial.aeval t).toRingHom) ≠ 0 :=
      fun j => ((hμm j).map _).ne_zero
    calc _ ≤ Nat.card {x : Fin N → E //
          ∀ j, ((μ j).map (MvPolynomial.aeval t).toRingHom).eval (x j) = 0} := by
          refine Nat.card_le_card_of_injective (fun y => ⟨y.1, hmem t y⟩) ?_
          intro a b hab
          apply Subtype.ext
          have := congrArg Subtype.val hab
          exact this
      _ ≤ ∏ j, ((μ j).map (MvPolynomial.aeval t).toRingHom).natDegree := s2 E N _ hP'
      _ = ∏ j, (μ j).natDegree := by
          apply Finset.prod_congr rfl
          intro j _
          exact (hμm j).natDegree_map _
  have key := s3 E N s (∏ j, (μ j).natDegree)
    (fun x => (∀ p ∈ I, MvPolynomial.aeval x p = 0) ∧ MvPolynomial.aeval x h = 0)
    (fun x i => MvPolynomial.aeval x (τ i)) _ hν' hvan hfib
  calc _ ≤ (((∏ j, (μ j).natDegree : ℕ) : ℝ) *
        ((MvPolynomial.map (algebraMap F E) (ν.coeff 0)).totalDegree : ℝ)) *
        (Nat.card E : ℝ) ^ s := key
    _ ≤ (((∏ j, (μ j).natDegree : ℕ) : ℝ) * ((ν.coeff 0).totalDegree : ℝ)) *
        (Nat.card E : ℝ) ^ s := by
        gcongr
    _ = _ := by rw [Nat.cast_prod]

theorem lw_noether_dim (F : Type u) [Field F] (d c : ℕ) (I : Ideal (MvPolynomial (Fin (d + c)) F))
    (hI : I.IsPrime)
    (hind : ∀ p : MvPolynomial (Fin d) F, MvPolynomial.rename (Fin.castAdd c) p ∈ I → p = 0)
    (halg : ∀ j : Fin (d + c), ∃ P : Polynomial (MvPolynomial (Fin d) F), P ≠ 0 ∧
      Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd c)).toRingHom (MvPolynomial.X j) P ∈ I) :
    ∃ (s : ℕ) (g : MvPolynomial (Fin s) F →ₐ[F] MvPolynomial (Fin (d + c)) F ⧸ I),
      s ≤ d ∧ g.Finite :=
by
  classical
  haveI := hI
  haveI : IsDomain (MvPolynomial (Fin (d + c)) F ⧸ I) := Ideal.Quotient.isDomain I
  obtain ⟨s, g, hg_inj, hg_fin⟩ :=
    exists_finite_inj_algHom_of_fg F (MvPolynomial (Fin (d + c)) F ⧸ I)
  refine ⟨s, g, ?_, hg_fin⟩
  let y : Fin d → MvPolynomial (Fin (d + c)) F ⧸ I :=
    fun k => Ideal.Quotient.mk I (MvPolynomial.X (Fin.castAdd c k))
  have hcomp : ∀ p : MvPolynomial (Fin d) F, MvPolynomial.aeval y p =
      Ideal.Quotient.mk I (MvPolynomial.rename (Fin.castAdd c) p) := by
    intro p
    have h1 : (MvPolynomial.aeval y : MvPolynomial (Fin d) F →ₐ[F] _) =
        (Ideal.Quotient.mkₐ F I).comp (MvPolynomial.rename (Fin.castAdd c)) := by
      apply MvPolynomial.algHom_ext
      intro k
      simp [y, Ideal.Quotient.mkₐ_eq_mk]
    have h2 := congrArg (fun f => f p) h1
    simpa [Ideal.Quotient.mkₐ_eq_mk] using h2
  have hy : AlgebraicIndependent F y := by
    rw [algebraicIndependent_iff_injective_aeval, injective_iff_map_eq_zero]
    intro p hp
    apply hind
    rw [hcomp] at hp
    exact Ideal.Quotient.eq_zero_iff_mem.mp hp
  have hxalg : ∀ j : Fin (d + c), IsAlgebraic (Algebra.adjoin F (Set.range y))
      (Ideal.Quotient.mk I (MvPolynomial.X j : MvPolynomial (Fin (d + c)) F)) := by
    intro j
    obtain ⟨P, hP0, hPI⟩ := halg j
    let φ := hy.aevalEquiv
    let φr : MvPolynomial (Fin d) F →+* Algebra.adjoin F (Set.range y) := φ.toRingEquiv.toRingHom
    have hφr : ∀ p, φr p = φ p := fun _ => rfl
    refine ⟨P.map φr, ?_, ?_⟩
    · intro h
      apply hP0
      have hinj : Function.Injective φr := fun a b hab => φ.injective (by simpa [hφr] using hab)
      apply Polynomial.map_injective φr hinj
      rw [Polynomial.map_zero]
      exact h
    · rw [Polynomial.aeval_def, Polynomial.eval₂_map]
      have hrc : (algebraMap (Algebra.adjoin F (Set.range y)) (MvPolynomial (Fin (d + c)) F ⧸ I)).comp
          φr = (Ideal.Quotient.mk I).comp (MvPolynomial.rename (Fin.castAdd c)).toRingHom := by
        refine RingHom.ext fun p => ?_
        rw [RingHom.comp_apply, RingHom.comp_apply, hφr, hy.algebraMap_aevalEquiv, hcomp]
        rfl
      rw [hrc, ← Polynomial.hom_eval₂]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hPI
  have halgA : Algebra.IsAlgebraic (Algebra.adjoin F (Set.range y))
      (MvPolynomial (Fin (d + c)) F ⧸ I) := by
    constructor
    intro a
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
    induction p using MvPolynomial.induction_on with
    | C r =>
      have h : Ideal.Quotient.mk I (MvPolynomial.C r) =
          algebraMap (Algebra.adjoin F (Set.range y)) (MvPolynomial (Fin (d + c)) F ⧸ I)
            (algebraMap F (Algebra.adjoin F (Set.range y)) r) := by
        rw [← IsScalarTower.algebraMap_apply]
        rfl
      rw [h]
      exact isAlgebraic_algebraMap _
    | add p q hp hq =>
      rw [map_add]
      exact hp.add hq
    | mul_X p j hp =>
      rw [map_mul]
      exact hp.mul (hxalg j)
  have hT := hy.isTranscendenceBasis_iff_isAlgebraic.mpr halgA
  have hz : AlgebraicIndependent F (fun i : Fin s => g (MvPolynomial.X i)) := by
    rw [algebraicIndependent_iff_injective_aeval]
    have h1 : (MvPolynomial.aeval fun i : Fin s => g (MvPolynomial.X i)) = g := by
      apply MvPolynomial.algHom_ext
      intro i
      simp
    rw [h1]
    exact hg_inj
  have h1 := hz.lift_cardinalMk_le_trdeg
  have h2 := hT.lift_cardinalMk_eq_trdeg
  rw [← h2] at h1
  simpa using h1

theorem lw_birational_hypersurface (F : Type u) [Field F] [Finite F] (d c : ℕ)
    (I : Ideal (MvPolynomial (Fin (d + c)) F)) (hI : I.IsPrime)
    (hG : (Ideal.map (MvPolynomial.map (algebraMap F (AlgebraicClosure F))) I).radical.IsPrime)
    (hind : ∀ p : MvPolynomial (Fin d) F, MvPolynomial.rename (Fin.castAdd c) p ∈ I → p = 0)
    (hsep : ∀ j : Fin (d + c), ∃ P : Polynomial (MvPolynomial (Fin d) F),
      Polynomial.eval₂ (MvPolynomial.rename (Fin.castAdd c)).toRingHom (MvPolynomial.X j) P ∈ I ∧
