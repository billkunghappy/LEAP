import WeilR2_Part09
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_lpgi_punct_fixed_generator (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (d : ℕ) (hd : 1 ≤ d)
    (hsm : SmoothOfRelativeDimension d (Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ)
    (T VT : X.left.ProEt) (g : T ⟶ wcGeomPoint F X h) (j : VT ⟶ T)
    (A : Type u) [CommRing A] [IsNoetherianRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : T.left ≅ Spec (.of A))
    (xb : (wcGeomPoint F X h).left) (hxbc : IsClosed ({xb} : Set (wcGeomPoint F X h).left))
    (hpre : g.left ⁻¹' {xb} = {e.inv (IsLocalRing.closedPoint A)})
    (hfib : IsIso (Limits.pullback.snd g.left ((wcGeomPoint F X h).left.fromSpecResidueField xb)))
    (hj : IsOpenImmersion j.left)
    (hrange : Set.range j.left = {e.inv (IsLocalRing.closedPoint A)}ᶜ)
    (f : Fin d → A) (hspan : Ideal.span (Set.range f) = IsLocalRing.maximalIdeal A)
    (hdim : ringKrullDim A = (d : WithBot ℕ∞))
    (hℓA : IsUnit ((ℓ : ℕ) : A))
    (φT : T ⟶ T) (φV : VT ⟶ VT) (hφV : φV ≫ j = j ≫ φT)
    (ρ : A →+* A) (hρ : e.inv ≫ φT.left ≫ e.hom = Spec.map (CommRingCat.ofHom ρ))
    (hρf : ∀ i, ρ (f i) = f i) :
    ∃ s : Abelian.Ext (wcFreeSheaf X.left VT) (wcRootTwist X.left (ℓ ^ n) d) (2 * d - 1),
      (Abelian.Ext.mk₀ (wcFreeSheafMap X.left φV)).comp s (zero_add (2 * d - 1)) = s ∧
      ∀ k : ℕ, k • s = 0 → ℓ ^ n ∣ k :=
by
  classical

  have hfun : ∀ {A₁ B₁ C₁ : X.left.ProEt} (a : A₁ ⟶ B₁) (b : B₁ ⟶ C₁),
      wcFreeSheafMap X.left a ≫ wcFreeSheafMap X.left b = wcFreeSheafMap X.left (a ≫ b) := by
    intro A₁ B₁ C₁ a b
    have e' : Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight (yoneda.map (a ≫ b))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
      rw [yoneda.map_comp, Functor.whiskerRight_comp]
    exact ((presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      (congrArg (presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map e')

  rcases Nat.eq_zero_or_pos n with hn0 | hn
  · subst hn0
    refine ⟨0, by rw [Abelian.Ext.comp_zero], fun k _ => ?_⟩
    rw [pow_zero]
    exact one_dvd k

  have hinv : ∀ (M : Sheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1})
      (fV : Fin d → Γ(VT.left, ⊤)) (hT : ⊤ ≤ wcKOpen VT.left fV (d - 1 + 1) (d - 1 + 1))
      (hfix : ∀ i, φV.left.appTop.hom (fV i) = fV i)
      (σ : Abelian.Ext (wcFreeSheaf X.left (wcVRes X.left VT (wcKOpen VT.left fV 1 1))) M d)
      (hσ : ∀ b : wcVRes X.left VT (wcKOpen VT.left fV 1 1) ⟶ wcVRes X.left VT (wcKOpen VT.left fV 1 1),
        (∀ i, b.left.appTop.hom ((wcKOpen VT.left fV 1 1).ι.appTop.hom (fV i)) =
          (wcKOpen VT.left fV 1 1).ι.appTop.hom (fV i)) →
        (Abelian.Ext.mk₀ (wcFreeSheafMap X.left b)).comp σ (zero_add d) = σ),
      (Abelian.Ext.mk₀ (wcFreeSheafMap X.left φV)).comp (wcKFinal X.left VT fV M hT σ)
          (zero_add (2 * d - 1)) = wcKFinal X.left VT fV M hT σ := by
    intro M fV hT hfix σ hσ
    have hmonoι : ∀ (Y : Scheme.{u}) (O : Y.Opens), Mono O.ι := fun Y O => inferInstance
    have hts : ∀ (Y : Scheme.{u}) (O : Y.Opens) (hO : ⊤ ≤ O), wcTopSec Y O hO ≫ O.ι = 𝟙 Y :=
      fun Y O hO => IsOpenImmersion.lift_fac _ _ _
    have hpreD : ∀ i, φV.left ⁻¹ᵁ VT.left.basicOpen (fV i) = VT.left.basicOpen (fV i) := by
      intro i
      rw [Scheme.preimage_basicOpen_top, hfix i]
    have hpres : ∀ a b, wcKOpen VT.left fV a b ≤ φV.left ⁻¹ᵁ wcKOpen VT.left fV a b := by
      rintro a b x ⟨h1, i, hi, h2⟩
      refine ⟨fun i' hi' => ?_, i, hi, ?_⟩
      · have h3 := h1 i' hi'
        rw [← hpreD i'] at h3
        exact h3
      · rw [← hpreD i] at h2
        exact h2
    have hcompat : ∀ (O O' : VT.left.Opens) (hle : O' ≤ O) (hO : O ≤ φV.left ⁻¹ᵁ O)
        (hO' : O' ≤ φV.left ⁻¹ᵁ O'),
        wcVResLE X.left VT hle ≫ wcVResEndo X.left VT φV O hO =
          wcVResEndo X.left VT φV O' hO' ≫ wcVResLE X.left VT hle := by
      intro O O' hle hO hO'
      apply MorphismProperty.Over.Hom.ext
      show VT.left.homOfLE hle ≫ φV.left.resLE O O hO = φV.left.resLE O' O' hO' ≫ VT.left.homOfLE hle
      haveI := hmonoι VT.left O
      rw [← cancel_mono O.ι]
      simp only [Category.assoc, Scheme.Hom.resLE_comp_ι, Scheme.homOfLE_ι_assoc, Scheme.homOfLE_ι]
    have hMVnat : ∀ {O₁₂ O₁ O₂ O : VT.left.Opens} (h₁ : O₁₂ ≤ O₁) (h₂ : O₁₂ ≤ O₂) (h₃ : O₁ ≤ O)
        (h₄ : O₂ ≤ O) (p₁₂ : O₁₂ ≤ φV.left ⁻¹ᵁ O₁₂) (p₁ : O₁ ≤ φV.left ⁻¹ᵁ O₁)
        (p₂ : O₂ ≤ φV.left ⁻¹ᵁ O₂) (p : O ≤ φV.left ⁻¹ᵁ O),
        (wcMVClass X.left VT h₁ h₂ h₃ h₄).comp
            (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcVResEndo X.left VT φV O₁₂ p₁₂))) (add_zero 1) =
          (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcVResEndo X.left VT φV O p))).comp
            (wcMVClass X.left VT h₁ h₂ h₃ h₄) (zero_add 1) := by
      intro O₁₂ O₁ O₂ O h₁ h₂ h₃ h₄ p₁₂ p₁ p₂ p
      by_cases hS : (wcMVComplex X.left VT h₁ h₂ h₃ h₄).ShortExact
      · have e1 : wcMVClass X.left VT h₁ h₂ h₃ h₄ = hS.extClass := by
          unfold wcMVClass
          exact dif_pos hS
        rw [e1]
        exact hS.extClass_naturality hS
          { τ₁ := wcFreeSheafMap X.left (wcVResEndo X.left VT φV O₁₂ p₁₂)
            τ₂ := Limits.biprod.map (wcFreeSheafMap X.left (wcVResEndo X.left VT φV O₁ p₁))
              (wcFreeSheafMap X.left (wcVResEndo X.left VT φV O₂ p₂))
            τ₃ := wcFreeSheafMap X.left (wcVResEndo X.left VT φV O p)
            comm₁₂ := by
              dsimp only [wcMVComplex]
              apply Limits.biprod.hom_ext
              · simp only [Category.assoc, Limits.biprod.lift_fst, Limits.biprod.map_fst,
                  Limits.biprod.lift_fst_assoc, hfun]
                rw [hcompat O₁ O₁₂ h₁ p₁ p₁₂]
              · simp only [Category.assoc, Limits.biprod.lift_snd, Limits.biprod.map_snd,
                  Limits.biprod.lift_snd_assoc, Preadditive.comp_neg, Preadditive.neg_comp, hfun]
                rw [hcompat O₂ O₁₂ h₂ p₂ p₁₂]
            comm₂₃ := by
              dsimp only [wcMVComplex]
              apply Limits.biprod.hom_ext'
              · simp only [Limits.biprod.inl_map_assoc, Limits.biprod.inl_desc,
                  Limits.biprod.inl_desc_assoc, hfun]
                rw [hcompat O O₁ h₃ p p₁]
              · simp only [Limits.biprod.inr_map_assoc, Limits.biprod.inr_desc,
                  Limits.biprod.inr_desc_assoc, hfun]
                rw [hcompat O O₂ h₄ p p₂] }
      · have e1 : wcMVClass X.left VT h₁ h₂ h₃ h₄ = 0 := by
          unfold wcMVClass
          exact dif_neg hS
        rw [e1, Abelian.Ext.zero_comp, Abelian.Ext.comp_zero]
    have hchain : ∀ (q t : ℕ)
        (x : Abelian.Ext (wcFreeSheaf X.left (wcVRes X.left VT (wcKOpen VT.left fV 1 1))) M q),
        (Abelian.Ext.mk₀ (wcFreeSheafMap X.left
            (wcVResEndo X.left VT φV _ (hpres (t + 1) (t + 1))))).comp
            (wcKChain X.left VT fV M q t x) (zero_add _) =
          wcKChain X.left VT fV M q t
            ((Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcVResEndo X.left VT φV _ (hpres 1 1)))).comp
              x (zero_add _)) := by
      intro q t
      induction t with
      | zero => intro x; rfl
      | succ t ih =>
        intro x
        simp only [wcKChain, AddMonoidHom.comp_apply, Abelian.Ext.precomp,
          Abelian.Ext.bilinearComp_apply_apply]
        rw [← ih x, ← Abelian.Ext.comp_assoc _ _ _ (zero_add 1) _ (by omega),
          ← hMVnat _ _ _ _ (hpres (t + 1) (t + 1)) (hpres (t + 1 + 1) (t + 1))
            (hpres (t + 1) (t + 1 + 1)) (hpres (t + 1 + 1) (t + 1 + 1)),
          Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add _) (by omega)]
    have hsec : φV ≫ wcVResSec X.left VT _ hT =
        wcVResSec X.left VT _ hT ≫ wcVResEndo X.left VT φV _ (hpres _ _) := by
      apply MorphismProperty.Over.Hom.ext
      show φV.left ≫ wcTopSec VT.left _ hT = wcTopSec VT.left _ hT ≫ φV.left.resLE _ _ (hpres _ _)
      haveI := hmonoι VT.left (wcKOpen VT.left fV (d - 1 + 1) (d - 1 + 1))
      rw [← cancel_mono (wcKOpen VT.left fV (d - 1 + 1) (d - 1 + 1)).ι]
      rw [Category.assoc, hts, Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc, hts,
        Category.comp_id, Category.id_comp]
    have hfixD : ∀ i, (wcVResEndo X.left VT φV _ (hpres 1 1)).left.appTop.hom
        ((wcKOpen VT.left fV 1 1).ι.appTop.hom (fV i)) =
          (wcKOpen VT.left fV 1 1).ι.appTop.hom (fV i) := by
      intro i
      have e1 := congrArg (fun q => q.appTop.hom (fV i)) (Scheme.Hom.resLE_comp_ι φV.left (hpres 1 1))
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e1
      rw [hfix i] at e1
      exact e1
    have key := hchain d (d - 1) σ
    rw [hσ _ hfixD] at key
    show (Abelian.Ext.mk₀ (wcFreeSheafMap X.left φV)).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcVResSec X.left VT _ hT))).comp
          (wcKChain X.left VT fV M d (d - 1) σ) (by omega)) (zero_add (2 * d - 1)) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcVResSec X.left VT _ hT))).comp
          (wcKChain X.left VT fV M d (d - 1) σ) (by omega)
    rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) _ (by omega), Abelian.Ext.mk₀_comp_mk₀, hfun,
      hsec, ← hfun, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add _) (by omega), key]

  have hfix : ∀ i, φV.left.appTop.hom (wcParamFn j e f i) = wcParamFn j e f i := by
    intro i
    show φV.left.appTop.hom ((j.left ≫ e.hom).appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom (f i))) =
      (j.left ≫ e.hom).appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom (f i))
    have h1 : φV.left ≫ j.left = j.left ≫ φT.left := congrArg (fun q => q.left) hφV
    have h2 : φT.left ≫ e.hom = e.hom ≫ Spec.map (CommRingCat.ofHom ρ) := by
      rw [← hρ]; simp
    have h3 : φV.left ≫ (j.left ≫ e.hom) = (j.left ≫ e.hom) ≫ Spec.map (CommRingCat.ofHom ρ) := by
      rw [← Category.assoc, h1, Category.assoc, h2, Category.assoc]
    have h3' : (j.left ≫ e.hom).appTop ≫ φV.left.appTop =
        (Spec.map (CommRingCat.ofHom ρ)).appTop ≫ (j.left ≫ e.hom).appTop := by
      rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, h3]
    have h4 := congrArg (fun q => q.hom ((Scheme.ΓSpecIso (.of A)).inv.hom (f i))) h3'
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h4
    have h5 := congrArg (fun q => q.hom (f i))
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ρ))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom, hρf] at h5
    rw [h4, ← h5]

  have hT : ⊤ ≤ wcKOpen VT.left (wcParamFn j e f) (d - 1 + 1) (d - 1 + 1) := by
    intro x _
    have hmem : ∀ i, f i ∉ ((j.left ≫ e.hom) x).asIdeal →
        x ∈ VT.left.basicOpen (wcParamFn j e f i) := by
      intro i hi
      show x ∈ VT.left.basicOpen ((j.left ≫ e.hom).appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom (f i)))
      rw [← Scheme.preimage_basicOpen_top, basicOpen_eq_of_affine]
      first
        | exact (PrimeSpectrum.mem_basicOpen _ _).mpr hi
        | exact (Scheme.Hom.mem_preimage _).mpr ((PrimeSpectrum.mem_basicOpen _ _).mpr hi)
        | (show (j.left ≫ e.hom) x ∈ PrimeSpectrum.basicOpen (f i)
           exact (PrimeSpectrum.mem_basicOpen _ _).mpr hi)
    by_contra hnot
    have hall : ∀ i, f i ∈ ((j.left ≫ e.hom) x).asIdeal := by
      intro i
      by_contra hi
      apply hnot
      exact ⟨fun i' hi' => absurd hi' (by have := i'.isLt; omega), i,
        by have := i.isLt; omega, hmem i hi⟩
    have hle : IsLocalRing.maximalIdeal A ≤ ((j.left ≫ e.hom) x).asIdeal := by
      rw [← hspan, Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      exact hall i
    have heq : ((j.left ≫ e.hom) x).asIdeal = IsLocalRing.maximalIdeal A :=
      ((IsLocalRing.maximalIdeal.isMaximal A).eq_of_le ((j.left ≫ e.hom) x).isPrime.ne_top hle).symm
    have hpt : (j.left ≫ e.hom) x = IsLocalRing.closedPoint A := PrimeSpectrum.ext heq
    have hjx : j.left x = e.inv (IsLocalRing.closedPoint A) := by
      rw [← hpt, Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, e.hom_inv_id]
      rfl
    have hr : j.left x ∈ Set.range j.left := ⟨x, rfl⟩
    rw [hrange, hjx] at hr
    exact hr rfl

  have hMV : ∀ {O₁₂ O₁ O₂ O : VT.left.Opens} (h₁ : O₁₂ ≤ O₁) (h₂ : O₁₂ ≤ O₂) (h₃ : O₁ ≤ O)
      (h₄ : O₂ ≤ O), O₁ ⊔ O₂ = O → O₁ ⊓ O₂ = O₁₂ →
        (wcMVComplex X.left VT h₁ h₂ h₃ h₄).ShortExact :=
    fun h₁ h₂ h₃ h₄ hc hi => wc_lpgfg_open_mv_ses X.left VT h₁ h₂ h₃ h₄ hc hi
  obtain ⟨σ, hσ, hnz⟩ := wc_lpgfg_symbol_order F X h d hd hsm ℓ n hn T VT g j A e xb hxbc hpre
    hfib hj hrange f hspan hdim hℓA hT hMV
  refine ⟨wcKFinal X.left VT (wcParamFn j e f) (wcRootTwist X.left (ℓ ^ n) d) hT σ,
    hinv _ _ hT hfix σ hσ, ?_⟩

  set s := wcKFinal X.left VT (wcParamFn j e f) (wcRootTwist X.left (ℓ ^ n) d) hT σ with hs
  have htors0 : (ℓ ^ n) • 𝟙 (wcRootTwist X.left (ℓ ^ n) d) = 0 := by
    have key : ∀ (B : Type u) [AddCommGroup B]
        (x : ULift.{u+1} (TensorProduct ℤ (ZMod (ℓ ^ n)) (PiTensorProduct ℤ (fun _ : Fin d => B)))),
        (ℓ ^ n) • x = 0 := by
      intro B _ x
      apply ULift.ext
      rw [ULift.smul_down, ULift.zero_down, ← Nat.cast_smul_eq_nsmul (ZMod (ℓ ^ n)), ZMod.natCast_self,
        zero_smul]
    have hpre' : (ℓ ^ n) • 𝟙 (wcRootTwistPre X.left (ℓ ^ n) d) = 0 := by
      apply NatTrans.ext
      funext U
      rw [NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero]
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      rw [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero,
        AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
      exact key _ x
    show (ℓ ^ n) • 𝟙 ((presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).obj
      (wcRootTwistPre X.left (ℓ ^ n) d)) = 0
    rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, hpre',
      CategoryTheory.Functor.map_zero]
  have hmk : ∀ (k : ℕ), Abelian.Ext.mk₀ (k • 𝟙 (wcRootTwist X.left (ℓ ^ n) d)) =
      k • Abelian.Ext.mk₀ (𝟙 (wcRootTwist X.left (ℓ ^ n) d)) := by
    intro k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, ih]
  have hcn : ∀ (y : Abelian.Ext (wcFreeSheaf X.left VT) (wcRootTwist X.left (ℓ ^ n) d) (2 * d - 1))
      (k : ℕ), y.comp (k • Abelian.Ext.mk₀ (𝟙 (wcRootTwist X.left (ℓ ^ n) d))) (add_zero _) =
        k • y.comp (Abelian.Ext.mk₀ (𝟙 (wcRootTwist X.left (ℓ ^ n) d))) (add_zero _) := by
    intro y k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.comp_zero]
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.comp_add, ih]
  have hkill : (ℓ ^ n) • s = 0 := by
    calc (ℓ ^ n) • s
        = (ℓ ^ n) • s.comp (Abelian.Ext.mk₀ (𝟙 (wcRootTwist X.left (ℓ ^ n) d))) (add_zero _) := by
          rw [Abelian.Ext.comp_mk₀_id]
      _ = s.comp ((ℓ ^ n) • Abelian.Ext.mk₀ (𝟙 (wcRootTwist X.left (ℓ ^ n) d))) (add_zero _) :=
          (hcn s (ℓ ^ n)).symm
      _ = 0 := by rw [← hmk, htors0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  have hp : Nat.Prime ℓ := Fact.out
  have hord : addOrderOf s ∣ ℓ ^ n := addOrderOf_dvd_of_nsmul_eq_zero hkill
  obtain ⟨t, ht, hteq⟩ := (Nat.dvd_prime_pow hp).1 hord
  have htn : t = n := by
    by_contra hne
    apply hnz
    have hdv : addOrderOf s ∣ ℓ ^ (n - 1) := by
      rw [hteq]
      exact pow_dvd_pow ℓ (by omega)
    exact addOrderOf_dvd_iff_nsmul_eq_zero.mp hdv
  intro k hk
  have hdk := addOrderOf_dvd_of_nsmul_eq_zero hk
  rw [hteq, htn] at hdk
  exact hdk

theorem wc_lfi_punct_geom_invariant (F : Type u) [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (d : ℕ) (hd : 1 ≤ d)
    (hsm : SmoothOfRelativeDimension d (Limits.pullback.snd X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ)
    (T VT : X.left.ProEt) (g : T ⟶ wcGeomPoint F X h) (j : VT ⟶ T)
    (A : Type u) [CommRing A] [IsNoetherianRing A] [HenselianLocalRing A]
    [IsSepClosed (IsLocalRing.ResidueField A)]
    (e : T.left ≅ Spec (.of A))
    (xb : (wcGeomPoint F X h).left) (hxbc : IsClosed ({xb} : Set (wcGeomPoint F X h).left))
    (hpre : g.left ⁻¹' {xb} = {e.inv (IsLocalRing.closedPoint A)})
    (hfib : IsIso (Limits.pullback.snd g.left ((wcGeomPoint F X h).left.fromSpecResidueField xb)))
    (hj : IsOpenImmersion j.left)
    (hrange : Set.range j.left = {e.inv (IsLocalRing.closedPoint A)}ᶜ)
    (f : Fin d → A) (hspan : Ideal.span (Set.range f) = IsLocalRing.maximalIdeal A)
    (hdim : ringKrullDim A = (d : WithBot ℕ∞))
    (hℓA : IsUnit ((ℓ : ℕ) : A))
    (φT : T ⟶ T) (φV : VT ⟶ VT) (hφV : φV ≫ j = j ≫ φT)
    (ρ : A →+* A) (hρ : e.inv ≫ φT.left ≫ e.hom = Spec.map (CommRingCat.ofHom ρ))
    (hρf : ∀ i, ρ (f i) = f i) :
    ∀ y : Abelian.Ext (wcFreeSheaf X.left VT) (wcRootTwist X.left (ℓ ^ n) d) (2 * d - 1),
      (Abelian.Ext.mk₀ (wcFreeSheafMap X.left φV)).comp y (zero_add (2 * d - 1)) = y :=
by
  obtain ⟨hfin, hcard⟩ := wc_lpgi_punct_card_le F X h d hd hsm ℓ n T VT g j A e xb hxbc hpre hfib
    hj hrange f hspan hdim hℓA
  haveI := hfin
  obtain ⟨s, hsφ, hsord⟩ := wc_lpgi_punct_fixed_generator F X h d hd hsm ℓ n T VT g j A e xb hxbc
    hpre hfib hj hrange f hspan hdim hℓA φT φV hφV ρ hρ hρf
  have hdvd : ℓ ^ n ∣ addOrderOf s := hsord _ (addOrderOf_nsmul_eq_zero s)
  have hle : ℓ ^ n ≤ addOrderOf s := Nat.le_of_dvd (addOrderOf_pos s) hdvd
  have htop : AddSubgroup.zmultiples s = ⊤ := by
    apply AddSubgroup.eq_top_of_le_card
    rw [Nat.card_zmultiples]
    exact hcard.trans hle
  intro y
  have hy : y ∈ AddSubgroup.zmultiples s := by rw [htop]; exact AddSubgroup.mem_top y
  obtain ⟨k, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hy
  have hlin := map_zsmul ((Abelian.Ext.mk₀ (wcFreeSheafMap X.left φV)).precomp
    (wcRootTwist X.left (ℓ ^ n) d) (zero_add (2 * d - 1))) k s
  simp only [Abelian.Ext.precomp, Abelian.Ext.bilinearComp_apply_apply] at hlin
  rw [hlin, hsφ]

theorem wc_rpc_lfi_untwisted_degree (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n : ℕ) (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E]
    (hU : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))))
    (s₀ : wcGeomPoint F X h ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt))
    (σ : Spec (.of E) ⟶ Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))))
    (hσ : σ ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) = 𝟙 _)
    (V₀ : X.left.ProEt) (ι₀ : V₀ ⟶ wcGeomPoint F X h)
    (hι₀ : IsOpenImmersion ι₀.left) (hr₀ : Set.range ι₀.left = s₀.left ⁻¹' (Set.range σ)ᶜ)
    (t : ℕ → (wcGeomPoint F X h ⟶ wcGeomPoint F X h)) (ht0 : t 0 = 𝟙 _)
    (hts : ∀ j, t (j + 1) = wcGeomFrob F X h ≫ t j)
    (hfix : t (Module.finrank F E) ≫ s₀ = s₀)
    (Φ : Limits.cokernel (wcFreeSheafMap X.left ι₀) ⟶ Limits.cokernel (wcFreeSheafMap X.left ι₀))
    (hΦ : Limits.cokernel.π (wcFreeSheafMap X.left ι₀) ≫ Φ =
      wcFreeSheafMap X.left (t (Module.finrank F E)) ≫ Limits.cokernel.π (wcFreeSheafMap X.left ι₀)) :
    ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀)) (wcZModSheaf X.left (ℓ ^ n)) (2 * d),
      (Abelian.Ext.mk₀ Φ).comp x (zero_add (2 * d)) = (Nat.card F ^ (d * Module.finrank F E)) • x :=
by
  classical
  intro x
  have hfun : ∀ {A B C : X.left.ProEt} (a : A ⟶ B) (b : B ⟶ C),
      wcFreeSheafMap X.left a ≫ wcFreeSheafMap X.left b = wcFreeSheafMap X.left (a ≫ b) := by
    intro A B C a b
    have e : Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
        Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
        Functor.whiskerRight (yoneda.map (a ≫ b))
          (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) := by
      first
        | rw [yoneda.map_comp, Functor.whiskerRight_comp]
        | (apply NatTrans.ext; funext V; simp [← Functor.map_comp])
    exact ((presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map_comp _ _).symm.trans
      (congrArg (presheafToSheaf (Scheme.ProEt.topology X.left) AddCommGrpCat.{u+1}).map e)
  rcases Nat.eq_zero_or_pos d with hd0 | hd
  ·
    subst hd0
    haveI hirr : IrreducibleSpace ↥(Limits.pullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
      (geometrically_iff_of_isClosedUnderIsomorphisms.mp
        (GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom))) (AlgebraicClosure F)
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))
    have hconst : ∀ (s : C(↥(Limits.pullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))), ZMod (ℓ ^ n)))
        (a b : ↥(Limits.pullback X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))), s a = s b := by
      intro s a b
      have hpc : _root_.IsPreconnected (Set.univ : Set ↥(Limits.pullback X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :=
        (IrreducibleSpace.isIrreducible_univ _).isPreirreducible.isPreconnected
      have hs := (hpc.image s s.continuous.continuousOn).subsingleton
      exact hs ⟨a, trivial, rfl⟩ ⟨b, trivial, rfl⟩
    have hsec : ∀ (a : wcGeomPoint F X h ⟶ wcGeomPoint F X h)
        (s : (wcZModSheaf X.left (ℓ ^ n)).obj.obj (Opposite.op (wcGeomPoint F X h))),
        (wcZModSheaf X.left (ℓ ^ n)).obj.map a.op s = s := by
      intro a s
      apply ULift.ext
      apply ContinuousMap.ext
      intro p
      exact hconst (ULift.down s) (a.left p) p
    have hyon : ∀ (S : Scheme.{u}) (V : S.ProEt) (g : V ⟶ V)
        (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
        (∀ t : G.obj.obj (Opposite.op V), G.obj.map g.op t = t) →
        ∀ φ : wcFreeSheaf S V ⟶ G, wcFreeSheafMap S g ≫ φ = φ := by
      intro S V g G hG φ
      let Q : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
        yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let α : Q ⟶ Q :=
        Functor.whiskerRight (yoneda.map g) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
      let adj := sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}
      let adjW := Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}
      let β : uliftYoneda.{u+1}.obj V ⟶ uliftYoneda.{u+1}.obj V := uliftYoneda.{u+1}.map g
      have hψ : ∀ ψ : Q ⟶ G.obj, α ≫ ψ = ψ := by
        intro ψ
        have key : β ≫ adjW.homEquiv (uliftYoneda.{u+1}.obj V) G.obj ψ =
            adjW.homEquiv (uliftYoneda.{u+1}.obj V) G.obj ψ := by
          apply (uliftYonedaEquiv.{u+1} (X := V) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})).injective
          have h3 := uliftYonedaEquiv_naturality.{u+1}
            (adjW.homEquiv (uliftYoneda.{u+1}.obj V) G.obj ψ) g.op
          exact h3.symm.trans (hG (uliftYonedaEquiv.{u+1} (adjW.homEquiv (uliftYoneda.{u+1}.obj V) G.obj ψ)))
        have h4 : ((Functor.whiskeringRight S.ProEtᵒᵖ (Type (u+1)) AddCommGrpCat.{u+1}).obj
            AddCommGrpCat.free).map β ≫ ψ = ψ := by
          apply (adjW.homEquiv (uliftYoneda.{u+1}.obj V) G.obj).injective
          exact (adjW.homEquiv_naturality_left β ψ).trans key
        exact h4
      have e1 := adj.homEquiv_naturality_left α φ
      apply (adj.homEquiv Q G).injective
      exact e1.trans (hψ (adj.homEquiv Q G φ))
    have h0 : ∀ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀))
        (wcZModSheaf X.left (ℓ ^ n)) 0, (Abelian.Ext.mk₀ Φ).comp y (zero_add 0) = y := by
      intro y
      have hy := Abelian.Ext.mk₀_homEquiv₀_apply y
      generalize Abelian.Ext.homEquiv₀ y = ξ at hy
      subst hy
      rw [Abelian.Ext.mk₀_comp_mk₀]
      congr 1
      apply (cancel_epi (Limits.cokernel.π (wcFreeSheafMap X.left ι₀))).mp
      rw [← Category.assoc, hΦ, Category.assoc]
      exact hyon X.left (wcGeomPoint F X h) _ _ (hsec _) _
    rw [Nat.zero_mul, pow_zero, one_smul]
    exact h0 x
  ·

    obtain ⟨ρ, hρi, hρs, hρF⟩ := wc_root_twist_slice_presheaf_map F X ℓ hℓ h n d
    obtain ⟨ψ, hψiso, hψF⟩ := wc_slice_sheafify_scaled_iso X.left (wcGeomPoint F X h)
      (wcGeomFrob F X h) (wcRootTwistPre X.left (ℓ ^ n) d) (wcZModSheaf X.left (ℓ ^ n)) ρ
      (Nat.card F ^ d) hρi hρs hρF
    have hscale : ∀ (k : ℕ) (W : Over (wcGeomPoint F X h)),
        ψ.hom.app (Opposite.op (Over.mk (W.hom ≫ t k))) =
          (Nat.card F ^ d) ^ k • ψ.hom.app (Opposite.op W) := by
      intro k
      induction k with
      | zero =>
        intro W
        rw [ht0, Category.comp_id, pow_zero, one_smul]
        rfl
      | succ k ih =>
        intro W
        have e1 := ih (Over.mk (W.hom ≫ wcGeomFrob F X h))
        have e2 := hψF W
        rw [hts k, ← Category.assoc]
        refine e1.trans ?_
        rw [pow_succ, mul_smul]
        exact congrArg (fun z => (Nat.card F ^ d) ^ k • z) e2
    have hfixL : (t (Module.finrank F E)).left ≫ s₀.left = s₀.left :=
      congrArg (fun f => f.left) hfix
    have H' : Set.range (ι₀.left ≫ (t (Module.finrank F E)).left) ⊆ Set.range ι₀.left := by
      rintro _ ⟨v, rfl⟩
      rw [hr₀]
      have hv : ι₀.left v ∈ Set.range ι₀.left := ⟨v, rfl⟩
      rw [hr₀] at hv
      show s₀.left ((ι₀.left ≫ (t (Module.finrank F E)).left) v) ∈ (Set.range σ)ᶜ
      rw [Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hfixL]
      exact hv
    let L : V₀.left ⟶ V₀.left :=
      IsOpenImmersion.lift ι₀.left (ι₀.left ≫ (t (Module.finrank F E)).left) H'
    have hLfac : L ≫ ι₀.left = ι₀.left ≫ (t (Module.finrank F E)).left :=
      IsOpenImmersion.lift_fac _ _ H'
    have hLw : L ≫ V₀.hom = V₀.hom := by
      rw [← MorphismProperty.Over.w ι₀, ← Category.assoc, hLfac, Category.assoc,
        MorphismProperty.Over.w (t (Module.finrank F E))]
    let φV : V₀ ⟶ V₀ := MorphismProperty.Over.homMk L hLw trivial
    have hφV : φV ≫ ι₀ = ι₀ ≫ t (Module.finrank F E) := MorphismProperty.Over.Hom.ext hLfac
    obtain ⟨Θ, hΘbij, hΘ⟩ := wc_lfi_coker_scaled_transport X.left (wcGeomPoint F X h) V₀ ι₀
      (t (Module.finrank F E)) φV hφV Φ hΦ (wcRootTwist X.left (ℓ ^ n) d)
      (wcZModSheaf X.left (ℓ ^ n)) ψ ((Nat.card F ^ d) ^ Module.finrank F E) hψiso
      (fun W => hscale (Module.finrank F E) W) (2 * d)

    obtain ⟨τ, hτ⟩ := wc_rpc_s0_factor F X h E hU s₀
    obtain ⟨xb, hxb⟩ := wc_rpc_fibre_singleton F X h E hU s₀ τ hτ σ hσ
    have hpt : Set.range ι₀.left = {xb}ᶜ := by
      rw [hr₀, Set.preimage_compl, hxb]
    obtain ⟨T, g, φT, A, iA, iAn, iAh, iAs, e, ρA, f, VT, j, φW, hφTg, hρ, hρf, hspan, hdim, hℓA,
      hpre, hfib, hj, hrange, hφW, hTc, hqs, hln⟩ :=
      wc_lfi_strict_nbhd F X d ℓ hℓ h E hU s₀ σ hσ t ht0 hts hfix xb hxb
    haveI hproj : Projective (wcFreeSheaf X.left T) :=
      wc_proet_free_projective_strict_local X.left T A e

    have hsm : SmoothOfRelativeDimension d (Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) := by
      haveI := smoothOfRelativeDimension_isStableUnderBaseChange d
      exact MorphismProperty.of_isPullback (IsPullback.of_hasPullback X.hom _) inferInstance
    have hxbc : IsClosed ({xb} : Set (wcGeomPoint F X h).left) := by
      haveI : IsClosedImmersion
          (σ ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))) := by
        rw [hσ]; infer_instance
      haveI : IsClosedImmersion σ :=
        IsClosedImmersion.of_comp σ
          (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))))
      rw [← hxb]
      exact σ.isClosedEmbedding.isClosed_range.preimage s₀.left.continuous

    have hsub : Set.range (j ≫ g).left ⊆ Set.range ι₀.left := by
      rintro _ ⟨v, rfl⟩
      rw [hpt]
      intro hv
      have hv1 : (j ≫ g).left v = xb := hv
      have hv2 : g.left (j.left v) = xb := by
        rw [show (j ≫ g).left = j.left ≫ g.left from rfl, Scheme.Hom.comp_apply] at hv1
        exact hv1
      have h2 : j.left v ∈ g.left ⁻¹' {xb} := hv2
      rw [hpre] at h2
      have h3 : j.left v ∈ Set.range j.left := ⟨v, rfl⟩
      rw [hrange] at h3
      exact h3 h2
    let Lg : VT.left ⟶ V₀.left := IsOpenImmersion.lift ι₀.left (j ≫ g).left hsub
    have hLg : Lg ≫ ι₀.left = (j ≫ g).left := IsOpenImmersion.lift_fac _ _ hsub
    have hLgw : Lg ≫ V₀.hom = VT.hom := by
      rw [← MorphismProperty.Over.w ι₀, ← Category.assoc, hLg]
      show (j.left ≫ g.left) ≫ (wcGeomPoint F X h).hom = VT.hom
      rw [Category.assoc, MorphismProperty.Over.w g, MorphismProperty.Over.w j]
    let gV : VT ⟶ V₀ := MorphismProperty.Over.homMk Lg hLgw trivial
    have hgV : gV ≫ ι₀ = j ≫ g := MorphismProperty.Over.Hom.ext hLg
    have hrj : Set.range j.left = g.left ⁻¹' {xb}ᶜ := by
      rw [hrange, Set.preimage_compl, hpre]
    obtain ⟨κ, hκiso, hκπ⟩ := wc_lfi_point_excision X.left (wcGeomPoint F X h) V₀ T VT ι₀ hι₀
      xb hpt g j hj hrj gV hgV hfib hTc hqs hln
    haveI := hκiso

    have hmono : Mono (wcFreeSheafMap X.left j) :=
      wc_free_sheaf_map_mono X.left VT T j (@IsOpenImmersion.mono _ _ _ hj)
    have hS : (ShortComplex.mk (wcFreeSheafMap X.left j)
        (Limits.cokernel.π (wcFreeSheafMap X.left j)) (Limits.cokernel.condition _)).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
    have hιT : wcFreeSheafMap X.left j ≫ wcFreeSheafMap X.left φT ≫
        Limits.cokernel.π (wcFreeSheafMap X.left j) = 0 := by
      rw [← Category.assoc, hfun, ← hφW, ← hfun, Category.assoc, Limits.cokernel.condition,
        Limits.comp_zero]
    obtain ⟨σT, hσT⟩ : ∃ σT : Limits.cokernel (wcFreeSheafMap X.left j) ⟶
        Limits.cokernel (wcFreeSheafMap X.left j),
        Limits.cokernel.π (wcFreeSheafMap X.left j) ≫ σT =
          wcFreeSheafMap X.left φT ≫ Limits.cokernel.π (wcFreeSheafMap X.left j) :=
      ⟨_, Limits.cokernel.π_desc _ _ hιT⟩
    have hnat : hS.extClass.comp (Abelian.Ext.mk₀ (wcFreeSheafMap X.left φW)) (add_zero 1) =
        (Abelian.Ext.mk₀ σT).comp hS.extClass (zero_add 1) :=
      hS.extClass_naturality hS
        { τ₁ := wcFreeSheafMap X.left φW
          τ₂ := wcFreeSheafMap X.left φT
          τ₃ := σT
          comm₁₂ := (hfun φW j).trans ((congrArg (wcFreeSheafMap X.left) hφW).trans
            (hfun j φT).symm)
          comm₂₃ := hσT.symm }

    have hvan : ∀ (p : ℕ) (w : Abelian.Ext (wcFreeSheaf X.left T) (wcRootTwist X.left (ℓ ^ n) d) p),
        1 ≤ p → w = 0 := by
      intro p w hp
      cases p with
      | zero => omega
      | succ k => exact Abelian.Ext.eq_zero_of_projective w
    have hm : 1 + (2 * d - 1) = 2 * d := by omega
    have hδsurj : ∀ x₃ : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left j))
        (wcRootTwist X.left (ℓ ^ n) d) (2 * d), ∃ w, hS.extClass.comp w hm = x₃ := by
      intro x₃
      exact Abelian.Ext.contravariant_sequence_exact₃ hS _ x₃ (hvan _ _ (by omega)) hm
    have hδF : ∀ w : Abelian.Ext (wcFreeSheaf X.left VT) (wcRootTwist X.left (ℓ ^ n) d) (2 * d - 1),
        (Abelian.Ext.mk₀ σT).comp (hS.extClass.comp w hm) (zero_add (2 * d)) =
          hS.extClass.comp ((Abelian.Ext.mk₀ (wcFreeSheafMap X.left φW)).comp w
            (zero_add (2 * d - 1))) hm := by
      intro w
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 1) hm (by omega), ← hnat,
        Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add (2 * d - 1)) (by omega)]

    have hkey : κ ≫ Φ = σT ≫ κ := by
      apply (cancel_epi (Limits.cokernel.π (wcFreeSheafMap X.left j))).mp
      rw [reassoc_of% hκπ, hΦ, reassoc_of% hσT, hκπ, ← Category.assoc, ← Category.assoc, hfun,
        hfun, hφTg]

    have hs4 := wc_lfi_punct_geom_invariant F X h d hd hsm ℓ n T VT g j A e xb hxbc hpre hfib
      hj hrange f hspan hdim hℓA φT φW hφW ρA hρ hρf

    have htw : ∀ z : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀))
        (wcRootTwist X.left (ℓ ^ n) d) (2 * d), (Abelian.Ext.mk₀ Φ).comp z (zero_add (2 * d)) = z := by
      intro z
      have hinjκ : ∀ a b : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀))
          (wcRootTwist X.left (ℓ ^ n) d) (2 * d),
          (Abelian.Ext.mk₀ κ).comp a (zero_add (2 * d)) = (Abelian.Ext.mk₀ κ).comp b (zero_add (2 * d)) →
            a = b := by
        intro a b hab
        have hab' := congrArg (fun w => (Abelian.Ext.mk₀ (inv κ)).comp w (zero_add (2 * d))) hab
        simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp] at hab'
        exact hab'
      apply hinjκ
      obtain ⟨w, hw⟩ := hδsurj ((Abelian.Ext.mk₀ κ).comp z (zero_add (2 * d)))
      rw [Abelian.Ext.mk₀_comp_mk₀_assoc, hkey, ← Abelian.Ext.mk₀_comp_mk₀_assoc, ← hw, hδF, hs4]

    obtain ⟨z, rfl⟩ := hΘbij.2 x
    rw [← hΘ z, htw z, ← pow_mul]

theorem wc_rpc_local_frob_invariant (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom] (d : ℕ) [SmoothOfRelativeDimension d X.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (n : ℕ) (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E]
    (hU : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))))
    (s₀ : wcGeomPoint F X h ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt))
    (σ : Spec (.of E) ⟶ Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))))
    (hσ : σ ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) = 𝟙 _)
    (V₀ : X.left.ProEt) (ι₀ : V₀ ⟶ wcGeomPoint F X h)
    (hι₀ : IsOpenImmersion ι₀.left) (hr₀ : Set.range ι₀.left = s₀.left ⁻¹' (Set.range σ)ᶜ)
    (t : ℕ → (wcGeomPoint F X h ⟶ wcGeomPoint F X h)) (ht0 : t 0 = 𝟙 _)
    (hts : ∀ j, t (j + 1) = wcGeomFrob F X h ≫ t j)
    (hfix : t (Module.finrank F E) ≫ s₀ = s₀)
    (Φ : Limits.cokernel (wcFreeSheafMap X.left ι₀) ⟶ Limits.cokernel (wcFreeSheafMap X.left ι₀))
    (hΦ : Limits.cokernel.π (wcFreeSheafMap X.left ι₀) ≫ Φ =
      wcFreeSheafMap X.left (t (Module.finrank F E)) ≫ Limits.cokernel.π (wcFreeSheafMap X.left ι₀)) :
    ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀)) (wcRootTwist X.left (ℓ ^ n) d) (2 * d),
      (Abelian.Ext.mk₀ Φ).comp x (zero_add (2 * d)) = x :=
by
  classical
  intro x

  have h5 := wc_rpc_lfi_untwisted_degree F X d ℓ hℓ h n E hU s₀ σ hσ V₀ ι₀ hι₀ hr₀
    t ht0 hts hfix Φ hΦ
  set r := Module.finrank F E with hr

  have hfixL : (t r).left ≫ s₀.left = s₀.left := congrArg (fun f => f.left) hfix
  have H' : Set.range (ι₀.left ≫ (t r).left) ⊆ Set.range ι₀.left := by
    rintro _ ⟨v, rfl⟩
    rw [hr₀]
    have hv : ι₀.left v ∈ Set.range ι₀.left := ⟨v, rfl⟩
    rw [hr₀] at hv
    show s₀.left ((ι₀.left ≫ (t r).left) v) ∈ (Set.range σ)ᶜ
    rw [Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, hfixL]
    exact hv
  let L : V₀.left ⟶ V₀.left := IsOpenImmersion.lift ι₀.left (ι₀.left ≫ (t r).left) H'
  have hLfac : L ≫ ι₀.left = ι₀.left ≫ (t r).left := IsOpenImmersion.lift_fac _ _ H'
  have hLw : L ≫ V₀.hom = V₀.hom := by
    rw [← MorphismProperty.Over.w ι₀, ← Category.assoc, hLfac, Category.assoc,
      MorphismProperty.Over.w (t r)]
  let φV : V₀ ⟶ V₀ := MorphismProperty.Over.homMk L hLw trivial
  have hφV : φV ≫ ι₀ = ι₀ ≫ t r := MorphismProperty.Over.Hom.ext hLfac

  obtain ⟨ρ, hρi, hρs, hρF⟩ := wc_root_twist_slice_presheaf_map F X ℓ hℓ h n d
  obtain ⟨ψ, hψiso, hψF⟩ := wc_slice_sheafify_scaled_iso X.left (wcGeomPoint F X h)
    (wcGeomFrob F X h) (wcRootTwistPre X.left (ℓ ^ n) d) (wcZModSheaf X.left (ℓ ^ n)) ρ
    (Nat.card F ^ d) hρi hρs hρF
  have hscale : ∀ (j : ℕ) (W : Over (wcGeomPoint F X h)),
      ψ.hom.app (Opposite.op (Over.mk (W.hom ≫ t j))) =
        (Nat.card F ^ d) ^ j • ψ.hom.app (Opposite.op W) := by
    intro j
    induction j with
    | zero =>
      intro W
      rw [ht0, Category.comp_id, pow_zero, one_smul]
      rfl
    | succ j ih =>
      intro W
      have e1 := ih (Over.mk (W.hom ≫ wcGeomFrob F X h))
      have e2 := hψF W
      rw [hts j, ← Category.assoc]
      refine e1.trans ?_
      rw [pow_succ, mul_smul]
      exact congrArg (fun z => (Nat.card F ^ d) ^ j • z) e2

  obtain ⟨Θ, hΘbij, hΘ⟩ := wc_lfi_coker_scaled_transport X.left (wcGeomPoint F X h) V₀ ι₀
    (t r) φV hφV Φ hΦ (wcRootTwist X.left (ℓ ^ n) d) (wcZModSheaf X.left (ℓ ^ n)) ψ
    ((Nat.card F ^ d) ^ r) hψiso (fun W => hscale r W) (2 * d)

  have htors0 : (ℓ ^ n) • 𝟙 (wcZModSheaf X.left (ℓ ^ n)) = 0 := by
    obtain ⟨f, hf⟩ : ∃ f : wcZModSheaf X.left (ℓ ^ n) ⟶ wcZModSheaf X.left (ℓ ^ n), f = 𝟙 _ :=
      ⟨_, rfl⟩
    rw [← hf]
    apply Sheaf.hom_ext
    have e1 : ((ℓ ^ n) • f).hom = (ℓ ^ n) • f.hom :=
      (sheafToPresheaf _ _).map_nsmul (f := f) (n := ℓ ^ n)
    rw [e1, hf]
    apply NatTrans.ext
    funext T
    rw [NatTrans.app_nsmul]
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro s
    rw [AddCommGrpCat.hom_nsmul]
    rw [AddMonoidHom.nsmul_apply]
    change (ℓ ^ n) • s = 0
    obtain ⟨g⟩ := s
    change ULift.up ((ℓ ^ n) • g) = ULift.up 0
    congr 1
    refine ContinuousMap.ext (fun p => ?_)
    have hh : ∀ (Y : Type u) [TopologicalSpace Y] (g' : C(Y, ZMod (ℓ ^ n))) (y : Y),
        ((ℓ ^ n) • g') y = 0 := fun Y _ g' y => by
      rw [ContinuousMap.smul_apply, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    exact hh _ g p
  have hmk : ∀ (k : ℕ), Abelian.Ext.mk₀ (k • 𝟙 (wcZModSheaf X.left (ℓ ^ n))) =
      k • Abelian.Ext.mk₀ (𝟙 (wcZModSheaf X.left (ℓ ^ n))) := by
    intro k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, ih]
  have hcn : ∀ (y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀))
      (wcZModSheaf X.left (ℓ ^ n)) (2 * d)) (k : ℕ),
      y.comp (k • Abelian.Ext.mk₀ (𝟙 (wcZModSheaf X.left (ℓ ^ n)))) (add_zero (2 * d)) =
        k • y.comp (Abelian.Ext.mk₀ (𝟙 (wcZModSheaf X.left (ℓ ^ n)))) (add_zero (2 * d)) := by
    intro y k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.comp_zero]
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.comp_add, ih]
  have htors : ∀ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap X.left ι₀))
      (wcZModSheaf X.left (ℓ ^ n)) (2 * d), (ℓ ^ n) • y = 0 := by
    intro y
    calc (ℓ ^ n) • y
        = (ℓ ^ n) • y.comp (Abelian.Ext.mk₀ (𝟙 (wcZModSheaf X.left (ℓ ^ n)))) (add_zero (2 * d)) := by
          rw [Abelian.Ext.comp_mk₀_id]
      _ = y.comp ((ℓ ^ n) • Abelian.Ext.mk₀ (𝟙 (wcZModSheaf X.left (ℓ ^ n)))) (add_zero (2 * d)) :=
          (hcn y (ℓ ^ n)).symm
      _ = 0 := by rw [← hmk, htors0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  set z := Θ ((Abelian.Ext.mk₀ Φ).comp x (zero_add (2 * d))) - Θ x with hz
  have hq : (Nat.card F ^ d) ^ r = Nat.card F ^ (d * r) := (pow_mul _ _ _).symm
  have hN : (Nat.card F ^ (d * r)) • z = 0 := by
    rw [hz, smul_sub, ← hq, hΘ x, h5 (Θ x), hq, sub_self]
  have hL : (ℓ ^ n) • z = 0 := htors z
  have hcop : Nat.Coprime (Nat.card F ^ (d * r)) (ℓ ^ n) :=
    Nat.Coprime.pow _ _ (Nat.Coprime.symm
      ((Nat.Prime.coprime_iff_not_dvd (Fact.out : Nat.Prime ℓ)).mpr hℓ))
  have h1 := addOrderOf_dvd_of_nsmul_eq_zero hN
  have h2 := addOrderOf_dvd_of_nsmul_eq_zero hL
  have hg := Nat.dvd_gcd h1 h2
  rw [hcop.gcd_eq_one] at hg
  have hz0 : z = 0 := AddMonoid.addOrderOf_eq_one_iff.mp (Nat.dvd_one.mp hg)
  rw [hz, sub_eq_zero] at hz0
  exact hΘbij.1 hz0

theorem wc_lfd_abstract_cyclic_descent {C : Type*} [Category C] [Abelian C] [HasExt C]
    {P R R' T : C} (tr : P ⟶ R) (g : R ⟶ R) (b : R ⟶ P)
    (tr' : P ⟶ R') (g' : R' ⟶ R') (b' : R' ⟶ P) (p : R' ⟶ R) (M : ℕ)
    (htr : Mono tr) (w₁ : tr ≫ (𝟙 R - g) = 0) (hex₁ : (ShortComplex.mk _ _ w₁).Exact)
    (w₂ : (𝟙 R - g) ≫ b = 0) (hex₂ : (ShortComplex.mk _ _ w₂).Exact)
    (htr' : Mono tr') (w₁' : tr' ≫ (𝟙 R' - g') = 0) (hex₁' : (ShortComplex.mk _ _ w₁').Exact)
    (w₂' : (𝟙 R' - g') ≫ b' = 0) (hex₂' : (ShortComplex.mk _ _ w₂').Exact) (hb' : Epi b')
    (hpb : p ≫ b = b') (hpg : g' ≫ p = p ≫ g) (hptr : tr' ≫ p = M • tr)
    (hM : M • 𝟙 T = 0) (i : ℕ) (x : Abelian.Ext R T i)
    (hx : (Abelian.Ext.mk₀ g).comp x (zero_add i) = x) :
    ∃ w : Abelian.Ext P T i,
      (Abelian.Ext.mk₀ b').comp w (zero_add i) = (Abelian.Ext.mk₀ p).comp x (zero_add i) :=
by

  have hpp : ∀ {A B C' : C} (f : A ⟶ B) (h : B ⟶ C') {n : ℕ} (z : Abelian.Ext C' T n),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ h).comp z (zero_add n)) (zero_add n) =
        (Abelian.Ext.mk₀ (f ≫ h)).comp z (zero_add n) := by
    intro A B C' f h n z
    rw [← Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ f) (Abelian.Ext.mk₀ h) z (zero_add 0)
      (zero_add n) (by omega), Abelian.Ext.mk₀_comp_mk₀]

  have s1 : ∀ {A B B' D : C} (t : A ⟶ B) (h : B ⟶ B') (c : B' ⟶ D), Mono t →
      ∀ (v₁ : t ≫ h = 0), (ShortComplex.mk _ _ v₁).Exact →
      ∀ (v₂ : h ≫ c = 0), (ShortComplex.mk _ _ v₂).Exact →
      ∃ (e : B ⟶ Limits.kernel c) (we : t ≫ e = 0),
        e ≫ Limits.kernel.ι c = h ∧ (ShortComplex.mk t e we).ShortExact := by
    intro A B B' D t h c ht v₁ hv₁ v₂ hv₂
    have we : t ≫ Limits.kernel.lift c h v₂ = 0 := by
      rw [← cancel_mono (Limits.kernel.ι c), Category.assoc, Limits.kernel.lift_ι, v₁,
        Limits.zero_comp]
    refine ⟨Limits.kernel.lift c h v₂, we, Limits.kernel.lift_ι _ _ _, ?_⟩
    have hepi : Epi (Limits.kernel.lift c h v₂) := hv₂.epi_kernelLift
    let φ : ShortComplex.mk t (Limits.kernel.lift c h v₂) we ⟶ ShortComplex.mk t h v₁ :=
      { τ₁ := 𝟙 _, τ₂ := 𝟙 _, τ₃ := Limits.kernel.ι c,
        comm₁₂ := by simp, comm₂₃ := by simp }
    have : Epi φ.τ₁ := by dsimp [φ]; infer_instance
    have : IsIso φ.τ₂ := by dsimp [φ]; infer_instance
    have : Mono φ.τ₃ := by dsimp [φ]; infer_instance
    have hexact := (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).mpr hv₁
    exact ShortComplex.ShortExact.mk' hexact ht hepi

  have hmk_nsmul : ∀ {A B : C} (f : A ⟶ B) (m : ℕ),
      Abelian.Ext.mk₀ (m • f) = m • Abelian.Ext.mk₀ f := by
    intro A B f m
    induction m with
    | zero => simp [Abelian.Ext.mk₀_zero]
    | succ m ih => rw [succ_nsmul, Abelian.Ext.mk₀_add, ih, succ_nsmul]
  have hnsmul_comp : ∀ {A B D : C} {a₁ a₂ a₃ : ℕ} (α : Abelian.Ext A B a₁)
      (β : Abelian.Ext B D a₂) (h : a₁ + a₂ = a₃) (m : ℕ),
      (m • α).comp β h = m • α.comp β h := by
    intro A B D a₁ a₂ a₃ α β h m
    induction m with
    | zero => simp
    | succ m ih => rw [succ_nsmul, Abelian.Ext.add_comp, ih, succ_nsmul]
  have hcomp_nsmul : ∀ {A B D : C} {a₁ a₂ a₃ : ℕ} (α : Abelian.Ext A B a₁)
      (β : Abelian.Ext B D a₂) (h : a₁ + a₂ = a₃) (m : ℕ),
      α.comp (m • β) h = m • α.comp β h := by
    intro A B D a₁ a₂ a₃ α β h m
    induction m with
    | zero => simp
    | succ m ih => rw [succ_nsmul, Abelian.Ext.comp_add, ih, succ_nsmul]
  have hkill : ∀ (n : ℕ) (y : Abelian.Ext P T n),
      (Abelian.Ext.mk₀ (M • 𝟙 P)).comp y (zero_add n) = 0 := by
    intro n y
    rw [hmk_nsmul, hnsmul_comp, Abelian.Ext.mk₀_id_comp]
    have hy : y = y.comp (Abelian.Ext.mk₀ (𝟙 T)) (add_zero n) := (Abelian.Ext.comp_mk₀_id y).symm
    rw [hy, ← hcomp_nsmul, ← hmk_nsmul, hM, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  obtain ⟨e, we, he, hS⟩ := s1 tr (𝟙 R - g) b htr w₁ hex₁ w₂ hex₂
  obtain ⟨e', we', he', hS'⟩ := s1 tr' (𝟙 R' - g') b' htr' w₁' hex₁' w₂' hex₂'

  have hq0 : (Limits.kernel.ι b' ≫ p) ≫ b = 0 := by
    rw [Category.assoc, hpb, Limits.kernel.condition]
  obtain ⟨q, hqι⟩ : ∃ q : Limits.kernel b' ⟶ Limits.kernel b,
      q ≫ Limits.kernel.ι b = Limits.kernel.ι b' ≫ p :=
    ⟨Limits.kernel.lift b _ hq0, Limits.kernel.lift_ι _ _ _⟩

  have h₂ : e' ≫ q = p ≫ e := by
    rw [← cancel_mono (Limits.kernel.ι b), Category.assoc, hqι, ← Category.assoc, he',
      Category.assoc, he, Preadditive.sub_comp, Preadditive.comp_sub, Category.id_comp,
      Category.comp_id, hpg]

  have hsub : (Abelian.Ext.mk₀ (𝟙 R - g)).comp x (zero_add i) = 0 := by
    have e1 : Abelian.Ext.mk₀ (𝟙 R - g) + Abelian.Ext.mk₀ g = Abelian.Ext.mk₀ (𝟙 R) := by
      rw [← Abelian.Ext.mk₀_add, sub_add_cancel]
    have e2 : (Abelian.Ext.mk₀ (𝟙 R - g) + Abelian.Ext.mk₀ g).comp x (zero_add i) =
        (Abelian.Ext.mk₀ (𝟙 R)).comp x (zero_add i) := by rw [e1]
    rw [Abelian.Ext.add_comp, Abelian.Ext.mk₀_id_comp, hx] at e2
    calc (Abelian.Ext.mk₀ (𝟙 R - g)).comp x (zero_add i)
        = ((Abelian.Ext.mk₀ (𝟙 R - g)).comp x (zero_add i) + x) - x := by abel
      _ = 0 := by rw [e2, sub_self]
  have hu : (Abelian.Ext.mk₀ e).comp
      ((Abelian.Ext.mk₀ (Limits.kernel.ι b)).comp x (zero_add i)) (zero_add i) = 0 := by
    rw [hpp, he, hsub]

  have hqu : (Abelian.Ext.mk₀ q).comp
      ((Abelian.Ext.mk₀ (Limits.kernel.ι b)).comp x (zero_add i)) (zero_add i) = 0 := by
    generalize (Abelian.Ext.mk₀ (Limits.kernel.ι b)).comp x (zero_add i) = u at hu ⊢
    clear hsub hx x
    rcases i with _ | n
    · have hepi : Epi e := hS.epi_g
      obtain ⟨φ, rfl⟩ : ∃ φ, Abelian.Ext.mk₀ φ = u :=
        ⟨Abelian.Ext.homEquiv₀ u, Abelian.Ext.mk₀_homEquiv₀_apply u⟩
      rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_eq_zero_iff] at hu
      have hφ : φ = 0 := (cancel_epi e).mp (by rw [hu, Limits.comp_zero])
      rw [hφ, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    · have hn : 1 + n = n + 1 := by omega
      obtain ⟨y, hy⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS T u hu hn
      let φ : ShortComplex.mk tr' e' we' ⟶ ShortComplex.mk tr e we :=
        { τ₁ := M • 𝟙 P, τ₂ := p, τ₃ := q,
          comm₁₂ := by
            show (M • 𝟙 P) ≫ tr = tr' ≫ p
            rw [Preadditive.nsmul_comp, Category.id_comp, hptr]
          comm₂₃ := h₂.symm }
      have hnat : hS'.extClass.comp (Abelian.Ext.mk₀ (M • 𝟙 P)) (add_zero 1) =
          (Abelian.Ext.mk₀ q).comp hS.extClass (zero_add 1) := hS'.extClass_naturality hS φ
      rw [← hy]
      calc (Abelian.Ext.mk₀ q).comp (hS.extClass.comp y hn) (zero_add (n + 1))
          = ((Abelian.Ext.mk₀ q).comp hS.extClass (zero_add 1)).comp y hn :=
            (Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ q) hS.extClass y (zero_add 1) hn
              (by omega)).symm
        _ = (hS'.extClass.comp (Abelian.Ext.mk₀ (M • 𝟙 P)) (add_zero 1)).comp y hn := by
            rw [hnat]
        _ = hS'.extClass.comp ((Abelian.Ext.mk₀ (M • 𝟙 P)).comp y (zero_add n)) hn :=
            Abelian.Ext.comp_assoc hS'.extClass (Abelian.Ext.mk₀ (M • 𝟙 P)) y (add_zero 1)
              (zero_add n) (by omega)
        _ = 0 := by rw [hkill, Abelian.Ext.comp_zero]

  have hz : (Abelian.Ext.mk₀ (Limits.kernel.ι b')).comp
      ((Abelian.Ext.mk₀ p).comp x (zero_add i)) (zero_add i) = 0 := by
    rw [hpp, ← hqι, ← hpp, hqu]

  have hS2 : (ShortComplex.mk (Limits.kernel.ι b') b' (Limits.kernel.condition b')).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel b') inferInstance hb'
  exact Abelian.Ext.contravariant_sequence_exact₂ hS2 T _ hz

theorem wc_tp_free_orbit_algebra {X : Type*} (σ : X → X) (N : ℕ) (hN : 0 < N)
    (hσN : ∀ x, σ^[N] x = x) (A : Set X) (hA : ∀ x ∈ A, σ x ∈ A)
    (hfree : ∀ x ∉ A, ∀ j : ℕ, 0 < j → j < N → σ^[j] x ≠ x) :
    (∀ p : FreeAbelianGroup X,
      p - FreeAbelianGroup.map σ p ∈ AddSubgroup.closure (FreeAbelianGroup.of '' A) →
      ∃ q : FreeAbelianGroup X,
        p - ∑ j ∈ Finset.range N, (⇑(FreeAbelianGroup.map σ))^[j] q ∈
          AddSubgroup.closure (FreeAbelianGroup.of '' A)) ∧
    (∀ p : FreeAbelianGroup X,
      ∑ j ∈ Finset.range N, (⇑(FreeAbelianGroup.map σ))^[j] p ∈
        AddSubgroup.closure (FreeAbelianGroup.of '' A) →
      ∃ q : FreeAbelianGroup X,
        p - (q - FreeAbelianGroup.map σ q) ∈ AddSubgroup.closure (FreeAbelianGroup.of '' A)) :=
by
  classical

  have hmulN : ∀ t y, σ^[N * t] y = y := by
    intro t
    induction t with
    | zero => intro y; simp
    | succ t ih =>
      intro y
      rw [show N * (t + 1) = N * t + N by ring, Function.iterate_add_apply, hσN, ih]
  have hback : ∀ y, σ^[N - 1] (σ y) = y := by
    intro y
    rw [← Function.iterate_succ_apply, show (N - 1).succ = N by omega, hσN]
  have hAit : ∀ n y, y ∈ A → σ^[n] y ∈ A := by
    intro n
    induction n with
    | zero => intro y hy; exact hy
    | succ n ih => intro y hy; rw [Function.iterate_succ_apply']; exact hA _ (ih y hy)
  have hnA : ∀ x, x ∉ A → σ x ∉ A := by
    intro x hx hσx
    apply hx
    have := hAit (N - 1) _ hσx
    rwa [hback] at this
  have hnAit : ∀ i x, x ∉ A → σ^[i] x ∉ A := by
    intro i
    induction i with
    | zero => intro x hx; exact hx
    | succ i ih => intro x hx; rw [Function.iterate_succ_apply']; exact hnA _ (ih x hx)
  have hper : ∀ j y, σ^[j] y = σ^[j % N] y := by
    intro j y
    conv_lhs => rw [← Nat.mod_add_div j N]
    rw [Function.iterate_add_apply, hmulN]

  obtain ⟨r, hr, hrσ⟩ : ∃ r : X → X, (∀ x, ∃ j, σ^[j] (r x) = x) ∧ ∀ x, r (σ x) = r x := by
    refine ⟨fun x => @Classical.epsilon X ⟨x⟩ (fun y => ∃ j, σ^[j] y = x),
      fun x => @Classical.epsilon_spec X (fun y => ∃ j, σ^[j] y = x) ⟨x, 0, rfl⟩, ?_⟩
    intro x
    have hP : (fun y => ∃ j, σ^[j] y = σ x) = (fun y => ∃ j, σ^[j] y = x) := by
      funext y
      apply propext
      constructor
      · rintro ⟨j, hj⟩
        exact ⟨N - 1 + j, by rw [Function.iterate_add_apply, hj, hback]⟩
      · rintro ⟨j, hj⟩
        exact ⟨j + 1, by rw [Function.iterate_succ_apply', hj]⟩
    show @Classical.epsilon X ⟨σ x⟩ (fun y => ∃ j, σ^[j] y = σ x) =
      @Classical.epsilon X ⟨x⟩ (fun y => ∃ j, σ^[j] y = x)
    rw [hP]

  obtain ⟨k, hk1, hk2, hk3⟩ : ∃ k : X → ℕ, (∀ x, σ^[k x] (r x) = x) ∧ (∀ x, k x < N) ∧
      (∀ x m, m < k x → σ^[m] (r x) ≠ x) := by
    refine ⟨fun x => Nat.find (hr x), fun x => Nat.find_spec (hr x), fun x => ?_,
      fun x m hm => Nat.find_min (hr x) hm⟩
    have h1 : σ^[Nat.find (hr x) % N] (r x) = x := by
      rw [← hper]; exact Nat.find_spec (hr x)
    exact lt_of_le_of_lt (Nat.find_min' (hr x) h1) (Nat.mod_lt _ hN)
  have hstep : ∀ x, x ∉ A → k (σ x) = (k x + 1) % N := by
    intro x hx
    have hkx := hk2 x
    have h2 : σ^[k (σ x)] (r x) = σ x := by
      have := hk1 (σ x); rwa [hrσ] at this
    rcases Nat.lt_or_ge (k x + 1) N with hlt | hge
    · rw [Nat.mod_eq_of_lt hlt]
      have h1 : σ^[k x + 1] (r x) = σ x := by rw [Function.iterate_succ_apply', hk1]
      rcases Nat.lt_trichotomy (k (σ x)) (k x + 1) with hlt2 | heq | hgt
      · exfalso
        rcases Nat.eq_zero_or_pos (k (σ x)) with h0 | hpos
        · rw [h0, Function.iterate_zero_apply] at h2
          have e := congrArg (σ^[N - 1 - k x]) (hk1 x)
          rw [← Function.iterate_add_apply, show N - 1 - k x + k x = N - 1 by omega, h2,
            hback] at e
          exact hfree x hx (N - 1 - k x) (by omega) (by omega) e.symm
        · have e := congrArg (σ^[N - 1]) h2
          rw [hback, ← Function.iterate_add_apply,
            show N - 1 + k (σ x) = (k (σ x) - 1) + N by omega, Function.iterate_add_apply,
            hσN] at e
          exact hk3 x (k (σ x) - 1) (by omega) e
      · exact heq
      · exfalso
        apply hk3 (σ x) (k x + 1) hgt
        rw [hrσ]; exact h1
    · have he : k x + 1 = N := by omega
      rw [he, Nat.mod_self]
      by_contra hne
      apply hk3 (σ x) 0 (Nat.pos_of_ne_zero hne)
      rw [Function.iterate_zero_apply, hrσ]
      calc r x = σ^[N] (r x) := (hσN _).symm
        _ = σ (σ^[k x] (r x)) := by rw [← he, Function.iterate_succ_apply']
        _ = σ x := by rw [hk1]
  have hcoord : ∀ x, x ∉ A → ∀ i, k (σ^[i] x) = (k x + i) % N := by
    intro x hx i
    induction i with
    | zero => rw [Function.iterate_zero_apply, Nat.add_zero, Nat.mod_eq_of_lt (hk2 x)]
    | succ i ih =>
      rw [Function.iterate_succ_apply', hstep _ (hnAit i x hx), ih, Nat.mod_add_mod,
        Nat.add_assoc]

  have hTit : ∀ j y, (⇑(FreeAbelianGroup.map σ))^[j] (FreeAbelianGroup.of y) =
      FreeAbelianGroup.of (σ^[j] y) := by
    intro j
    induction j with
    | zero => intro y; rfl
    | succ j ih =>
      intro y
      rw [Function.iterate_succ_apply', ih, FreeAbelianGroup.map_of_apply,
        Function.iterate_succ_apply']
  obtain ⟨nu, hnu⟩ : ∃ nu : FreeAbelianGroup X →+ FreeAbelianGroup X, ∀ p,
      nu p = ∑ j ∈ Finset.range N, (⇑(FreeAbelianGroup.map σ))^[j] p :=
    ⟨AddMonoidHom.mk' (fun p => ∑ j ∈ Finset.range N, (⇑(FreeAbelianGroup.map σ))^[j] p) (by
      intro a b; simp only [iterate_map_add, Finset.sum_add_distrib]), fun _ => rfl⟩
  have hnuof : ∀ y, nu (FreeAbelianGroup.of y) =
      ∑ j ∈ Finset.range N, FreeAbelianGroup.of (σ^[j] y) := by
    intro y; rw [hnu]; exact Finset.sum_congr rfl (fun j _ => hTit j y)
  obtain ⟨S, hS⟩ : ∃ S : FreeAbelianGroup X →+ FreeAbelianGroup X, ∀ y,
      S (FreeAbelianGroup.of y) =
        if y ∈ A then 0 else if k y + 1 = N then FreeAbelianGroup.of y else 0 :=
    ⟨FreeAbelianGroup.lift
      (fun y => if y ∈ A then 0 else if k y + 1 = N then FreeAbelianGroup.of y else 0),
      fun y => FreeAbelianGroup.lift_apply_of _ y⟩
  obtain ⟨W, hW⟩ : ∃ W : FreeAbelianGroup X →+ FreeAbelianGroup X, ∀ y,
      W (FreeAbelianGroup.of y) =
        if y ∈ A then 0 else ∑ i ∈ Finset.range (N - k y), FreeAbelianGroup.of (σ^[i] y) :=
    ⟨FreeAbelianGroup.lift
      (fun y => if y ∈ A then 0 else ∑ i ∈ Finset.range (N - k y), FreeAbelianGroup.of (σ^[i] y)),
      fun y => FreeAbelianGroup.lift_apply_of _ y⟩
  obtain ⟨V, hV⟩ : ∃ V : FreeAbelianGroup X →+ FreeAbelianGroup X, ∀ y,
      V (FreeAbelianGroup.of y) =
        if y ∈ A then 0 else if k y = 0 then FreeAbelianGroup.of y else 0 :=
    ⟨FreeAbelianGroup.lift
      (fun y => if y ∈ A then 0 else if k y = 0 then FreeAbelianGroup.of y else 0),
      fun y => FreeAbelianGroup.lift_apply_of _ y⟩
  have hSA : ∀ y ∈ A, S (FreeAbelianGroup.of y) = 0 := fun y hy => by rw [hS, if_pos hy]
  have hWA : ∀ y ∈ A, W (FreeAbelianGroup.of y) = 0 := fun y hy => by rw [hW, if_pos hy]
  have hVA : ∀ y ∈ A, V (FreeAbelianGroup.of y) = 0 := fun y hy => by rw [hV, if_pos hy]
  set H := AddSubgroup.closure (FreeAbelianGroup.of '' A) with hH
  have hofH : ∀ a ∈ A, FreeAbelianGroup.of a ∈ H :=
    fun a ha => AddSubgroup.subset_closure ⟨a, ha, rfl⟩
  have hWH : ∀ h ∈ H, W h = 0 := by
    intro h hh
    have hle : AddSubgroup.closure (FreeAbelianGroup.of '' A) ≤ W.ker := by
      rw [AddSubgroup.closure_le]
      rintro _ ⟨a, ha, rfl⟩
      exact AddMonoidHom.mem_ker.mpr (hWA a ha)
    exact AddMonoidHom.mem_ker.mp (hle hh)
  have hVH : ∀ h ∈ H, V h = 0 := by
    intro h hh
    have hle : AddSubgroup.closure (FreeAbelianGroup.of '' A) ≤ V.ker := by
      rw [AddSubgroup.closure_le]
      rintro _ ⟨a, ha, rfl⟩
      exact AddMonoidHom.mem_ker.mpr (hVA a ha)
    exact AddMonoidHom.mem_ker.mp (hle hh)

  have hs2 : ∀ x, x ∉ A → FreeAbelianGroup.of x =
      nu (S (FreeAbelianGroup.of x)) + W (FreeAbelianGroup.of x) -
        W (FreeAbelianGroup.map σ (FreeAbelianGroup.of x)) := by
    intro x hx
    have hσx := hnA x hx
    have hks := hstep x hx
    have hkx := hk2 x
    simp only [FreeAbelianGroup.map_of_apply, hS, hW, if_neg hx, if_neg hσx]
    have hshift : ∀ i, FreeAbelianGroup.of (σ^[i] (σ x)) = FreeAbelianGroup.of (σ^[i+1] x) := by
      intro i; rw [Function.iterate_succ_apply]
    simp only [hshift]
    rcases Nat.lt_or_ge (k x + 1) N with hlt | hge
    · rw [Nat.mod_eq_of_lt hlt] at hks
      rw [if_neg (show ¬ (k x + 1 = N) by omega), map_zero, hks,
        show N - k x = (N - (k x + 1)) + 1 by omega, Finset.sum_range_succ',
        Function.iterate_zero_apply]
      abel
    · have he : k x + 1 = N := by omega
      rw [he, Nat.mod_self] at hks
      rw [if_pos he, hks, hnuof, show N - k x = 1 by omega, Nat.sub_zero]
      have h2 : ∑ i ∈ Finset.range N, FreeAbelianGroup.of (σ^[i+1] x) =
          ∑ i ∈ Finset.range N, FreeAbelianGroup.of (σ^[i] x) := by
        have h3 := Finset.sum_range_succ' (fun i => FreeAbelianGroup.of (σ^[i] x)) N
        rw [Finset.sum_range_succ, hσN, Function.iterate_zero_apply] at h3
        exact (add_right_cancel h3).symm
      rw [h2, Finset.sum_range_one, Function.iterate_zero_apply]
      abel

  have hs3 : ∀ x, x ∉ A → FreeAbelianGroup.of x =
      W (FreeAbelianGroup.of x) - FreeAbelianGroup.map σ (W (FreeAbelianGroup.of x)) +
        V (nu (FreeAbelianGroup.of x)) := by
    intro x hx
    have hkx := hk2 x
    have hVsum : V (nu (FreeAbelianGroup.of x)) = ∑ j ∈ Finset.range N,
        (if (k x + j) % N = 0 then FreeAbelianGroup.of (σ^[j] x) else 0) := by
      rw [hnuof, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [hV, if_neg (hnAit j x hx), hcoord x hx j]
    have hmod : ∀ a, a < 2 * N → (a % N = 0 ↔ a = 0 ∨ a = N) := by
      intro a ha
      rcases Nat.lt_or_ge a N with h | h
      · rw [Nat.mod_eq_of_lt h]; omega
      · rw [Nat.mod_eq_sub_mod h, Nat.mod_eq_of_lt (show a - N < N by omega)]; omega
    have hthird : ∑ j ∈ Finset.range N,
        (if (k x + j) % N = 0 then FreeAbelianGroup.of (σ^[j] x) else 0)
        = FreeAbelianGroup.of (σ^[N - k x] x) := by
      rcases Nat.eq_zero_or_pos (k x) with h0 | hpos
      · rw [Finset.sum_eq_single_of_mem 0 (Finset.mem_range.mpr hN)]
        · rw [h0, if_pos (show (0 + 0) % N = 0 by simp), Nat.sub_zero, hσN,
            Function.iterate_zero_apply]
        · intro j hj hj0
          have hjN := Finset.mem_range.mp hj
          refine if_neg ?_
          rw [hmod (k x + j) (by omega)]
          omega
      · rw [Finset.sum_eq_single_of_mem (N - k x) (Finset.mem_range.mpr (by omega))]
        · refine if_pos ?_
          rw [hmod (k x + (N - k x)) (by omega)]
          omega
        · intro j hj hj0
          have hjN := Finset.mem_range.mp hj
          refine if_neg ?_
          rw [hmod (k x + j) (by omega)]
          omega
    have htel := Finset.sum_range_sub (fun i => FreeAbelianGroup.of (σ^[i] x)) (N - k x)
    rw [Finset.sum_sub_distrib, Function.iterate_zero_apply] at htel
    rw [hVsum, hthird, hW, if_neg hx, map_sum]
    simp only [FreeAbelianGroup.map_of_apply]
    have hshift : ∀ i, FreeAbelianGroup.of (σ (σ^[i] x)) = FreeAbelianGroup.of (σ^[i+1] x) := by
      intro i; rw [Function.iterate_succ_apply']
    simp only [hshift]
    have e : ∑ i ∈ Finset.range (N - k x), FreeAbelianGroup.of (σ^[i+1] x) =
        ∑ i ∈ Finset.range (N - k x), FreeAbelianGroup.of (σ^[i] x) +
          (FreeAbelianGroup.of (σ^[N - k x] x) - FreeAbelianGroup.of x) := by
      rw [← htel]; abel
    rw [e]
    abel
  have key1 : ∀ (z a b c : FreeAbelianGroup X), z = a + b - c → z - a - b + c = 0 := by
    intro z a b c h; rw [h]; abel
  have key2 : ∀ (z a b c : FreeAbelianGroup X), z = a - b + c → z - a + b - c = 0 := by
    intro z a b c h; rw [h]; abel

  have hD1 : ∀ p, p - nu (S p) - W p + W (FreeAbelianGroup.map σ p) ∈ H := by
    intro p
    induction p using FreeAbelianGroup.induction_on
    · simp only [map_zero, sub_zero, add_zero]; exact zero_mem _
    · next x =>
      by_cases hx : x ∈ A
      · rw [FreeAbelianGroup.map_of_apply, hSA x hx, hWA x hx, hWA _ (hA x hx), map_zero]
        simp only [sub_zero, add_zero]
        exact hofH x hx
      · rw [key1 _ _ _ _ (hs2 x hx)]; exact zero_mem _
    · next x h =>
      simp only [map_neg]
      convert neg_mem h using 1
      abel
    · next x y hx hy =>
      simp only [map_add]
      convert add_mem hx hy using 1
      abel
  have hD2 : ∀ p, p - W p + FreeAbelianGroup.map σ (W p) - V (nu p) ∈ H := by
    intro p
    induction p using FreeAbelianGroup.induction_on
    · simp only [map_zero, sub_zero, add_zero]; exact zero_mem _
    · next x =>
      by_cases hx : x ∈ A
      · rw [hWA x hx, map_zero, hnuof, map_sum,
          Finset.sum_eq_zero (fun j _ => hVA _ (hAit j x hx))]
        simp only [sub_zero, add_zero]
        exact hofH x hx
      · rw [key2 _ _ _ _ (hs3 x hx)]; exact zero_mem _
    · next x h =>
      simp only [map_neg]
      convert neg_mem h using 1
      abel
    · next x y hx hy =>
      simp only [map_add]
      convert add_mem hx hy using 1
      abel

  refine ⟨fun p hp => ⟨S p, ?_⟩, fun p hp => ⟨W p, ?_⟩⟩
  · rw [← hnu]
    have h1 := hWH _ hp
    rw [map_sub, sub_eq_zero] at h1
    have h2 := hD1 p
    rw [h1, sub_add_cancel] at h2
    exact h2
  · rw [← hnu] at hp
    have h1 := hVH _ hp
    have h2 := hD2 p
    rw [h1, sub_zero] at h2
    convert h2 using 1
    abel

theorem wc_tp_deck_local (S : Scheme.{u}) {U B : S.ProEt} (b : U ⟶ B) (g : U ⟶ U) (N : ℕ)
    (hdeck : ∀ (T : Scheme.{u}) (u₁ u₂ : T ⟶ U.left), u₁ ≫ b.left = u₂ ≫ b.left →
      ∃ O : Fin N → T.Opens, (∀ z : T, ∃! j, z ∈ O j) ∧
        ∀ j, (O j).ι ≫ u₂ = (O j).ι ≫ u₁ ≫ (wcLfdIter g (j : ℕ)).left)
    (T : S.ProEt) (u₁ u₂ : T ⟶ U) (h : u₁ ≫ b = u₂ ≫ b) :
    ∃ R : Sieve T, R ∈ Scheme.ProEt.topology S T ∧ ∀ (T' : S.ProEt) (e : T' ⟶ T), R.arrows e →
      ∃ j : ℕ, j < N ∧ e ≫ u₂ = e ≫ u₁ ≫ wcLfdIter g j :=
by
  have hb : u₁.left ≫ b.left = u₂.left ≫ b.left := congrArg (fun f => f.left) h
  obtain ⟨O, hpart, hO⟩ := hdeck T.left u₁.left u₂.left hb
  choose jz hjz _ using hpart
  haveI := T.prop
  let W' : ULift.{u+1} T.left → S.ProEt := fun i =>
    Scheme.ProEt.mk ((O (jz i.down)).ι ≫ T.hom)
  let f : ∀ i, W' i ⟶ T := fun i => MorphismProperty.Over.homMk (O (jz i.down)).ι rfl trivial
  have hcov : ∀ x : ↥T.left, ∃ (i : ULift.{u+1} T.left) (y : ↥(O (jz i.down)).toScheme),
      (O (jz i.down)).ι y = x := fun x =>
    ⟨ULift.up x, ⟨x, hjz x⟩, Scheme.Opens.ι_apply _ _⟩
  let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) T.left :=
    Scheme.Cover.mkOfCovers (P := @WeaklyEtale) (ULift.{u+1} T.left)
      (fun i => (O (jz i.down)).toScheme) (fun i => (O (jz i.down)).ι) hcov (fun i => inferInstance)
  have hqc : QuasiCompactCover 𝒰.toPreZeroHypercover :=
    @QuasiCompactCover.of_isOpenMap _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
      (fun i => (Scheme.Hom.isOpenEmbedding (O (jz i.down)).ι).isOpenMap)
  have hRb : Presieve.ofArrows (fun i : ULift.{u+1} T.left => (O (jz i.down)).toScheme)
      (fun i => (O (jz i.down)).ι) ∈ Scheme.proetalePrecoverage.coverings T.left :=
    Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc, rfl⟩
  have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget S ⋙ Over.forget S) (Y := W') f
  have hR' : Presieve.ofArrows W' f ∈ (Scheme.ProEt.precoverage S).coverings T :=
    Precoverage.mem_comap_iff.mpr (e ▸ hRb)
  have hRJ : Sieve.generate (Presieve.ofArrows W' f) ∈ (Scheme.ProEt.topology S) T :=
    Precoverage.generate_mem_toGrothendieck hR'
  have key : ∀ i : ULift.{u+1} T.left,
      f i ≫ u₂ = f i ≫ u₁ ≫ wcLfdIter g (jz i.down : ℕ) := by
    intro i
    apply MorphismProperty.Over.Hom.ext
    exact hO (jz i.down)
  refine ⟨Sieve.generate (Presieve.ofArrows W' f), hRJ, ?_⟩
  rintro T' _ ⟨Y, h', _, ⟨i⟩, rfl⟩
  exact ⟨_, (jz i.down).is_lt, by rw [Category.assoc, key i, Category.assoc]⟩

theorem wc_tp_local_middle (S : Scheme.{u}) {U B VU VB : S.ProEt} (b : U ⟶ B) (g : U ⟶ U)
    (N : ℕ)
    (hdl : ∀ (T : S.ProEt) (u₁ u₂ : T ⟶ U), u₁ ≫ b = u₂ ≫ b →
      ∃ R : Sieve T, R ∈ Scheme.ProEt.topology S T ∧ ∀ (T' : S.ProEt) (e : T' ⟶ T),
        R.arrows e → ∃ j : ℕ, j < N ∧ e ≫ u₂ = e ≫ u₁ ≫ wcLfdIter g j)
    (ιU : VU ⟶ U) (ιB : VB ⟶ B) (hr : Set.range ιU.left = b.left ⁻¹' Set.range ιB.left)
    (T : S.ProEt) (x : FreeAbelianGroup (ULift.{u+1} (T ⟶ U)))
    (hx : FreeAbelianGroup.map (fun u : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (u.down ≫ b)) x ∈
      AddSubgroup.closure (FreeAbelianGroup.of ''
        {v : ULift.{u+1} (T ⟶ B) | Set.range v.down.left ⊆ Set.range ιB.left})) :
    ∃ R : Sieve T, R ∈ Scheme.ProEt.topology S T ∧ ∀ (T' : S.ProEt) (e : T' ⟶ T), R.arrows e →
      ∃ y : FreeAbelianGroup (ULift.{u+1} (T' ⟶ U)),
        FreeAbelianGroup.map (fun u : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (e ≫ u.down)) x -
          (y - FreeAbelianGroup.map
            (fun u : ULift.{u+1} (T' ⟶ U) => ULift.up.{u+1} (u.down ≫ g)) y) ∈
        AddSubgroup.closure (FreeAbelianGroup.of ''
          {u : ULift.{u+1} (T' ⟶ U) | Set.range u.down.left ⊆ Set.range ιU.left}) :=
by
  classical

  obtain ⟨Good, hGood⟩ : ∃ P : FreeAbelianGroup (ULift.{u+1} (T ⟶ U)) → Prop, ∀ z, P z ↔
      ∃ R : Sieve T, R ∈ Scheme.ProEt.topology S T ∧ ∀ (T' : S.ProEt) (e : T' ⟶ T), R.arrows e →
        ∃ y : FreeAbelianGroup (ULift.{u+1} (T' ⟶ U)),
          FreeAbelianGroup.map (fun u : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (e ≫ u.down)) z -
            (y - FreeAbelianGroup.map
              (fun u : ULift.{u+1} (T' ⟶ U) => ULift.up.{u+1} (u.down ≫ g)) y) ∈
          AddSubgroup.closure (FreeAbelianGroup.of ''
            {u : ULift.{u+1} (T' ⟶ U) | Set.range u.down.left ⊆ Set.range ιU.left}) :=
    ⟨_, fun _ => Iff.rfl⟩

  obtain ⟨G, hG⟩ : ∃ G : AddSubgroup (FreeAbelianGroup (ULift.{u+1} (T ⟶ U))),
      ∀ z, z ∈ G ↔ Good z := by
    refine ⟨{ carrier := {z | Good z}
              zero_mem' := ?zero
              add_mem' := ?add
              neg_mem' := ?neg }, fun _ => Iff.rfl⟩
    case zero =>
      change Good 0
      rw [hGood]
      refine ⟨⊤, (Scheme.ProEt.topology S).top_mem T, fun T' e _ => ⟨0, ?_⟩⟩
      rw [map_zero, map_zero, sub_zero, sub_zero]
      exact zero_mem _
    case add =>
      intro x₁ x₂ h₁ h₂
      change Good x₁ at h₁
      change Good x₂ at h₂
      change Good (x₁ + x₂)
      rw [hGood] at h₁ h₂ ⊢
      obtain ⟨R₁, hR₁, h₁⟩ := h₁
      obtain ⟨R₂, hR₂, h₂⟩ := h₂
      refine ⟨R₁ ⊓ R₂, (Scheme.ProEt.topology S).intersection_covering hR₁ hR₂,
        fun T' e he => ?_⟩
      obtain ⟨y₁, hy₁⟩ := h₁ T' e ((Sieve.inter_apply e).mp he).1
      obtain ⟨y₂, hy₂⟩ := h₂ T' e ((Sieve.inter_apply e).mp he).2
      refine ⟨y₁ + y₂, ?_⟩
      convert add_mem hy₁ hy₂ using 1
      simp only [map_add]
      abel
    case neg =>
      intro z hz
      change Good z at hz
      change Good (-z)
      rw [hGood] at hz ⊢
      obtain ⟨R, hR, h⟩ := hz
      refine ⟨R, hR, fun T' e he => ?_⟩
      obtain ⟨y, hy⟩ := h T' e he
      refine ⟨-y, ?_⟩
      convert neg_mem hy using 1
      simp only [map_neg]
      abel

  have hZ : AddSubgroup.closure (FreeAbelianGroup.of ''
      {u : ULift.{u+1} (T ⟶ U) | Set.range u.down.left ⊆ Set.range ιU.left}) ≤ G := by
    rw [AddSubgroup.closure_le]
    rintro _ ⟨u, hu, rfl⟩
    have hu' : Set.range u.down.left ⊆ Set.range ιU.left := hu
    rw [SetLike.mem_coe, hG, hGood]
    refine ⟨⊤, (Scheme.ProEt.topology S).top_mem T, fun T' e _ => ⟨0, ?_⟩⟩
    rw [map_zero, sub_zero, sub_zero, FreeAbelianGroup.map_of_apply]
    refine AddSubgroup.subset_closure ⟨_, ?_, rfl⟩
    show Set.range (e ≫ u.down).left ⊆ Set.range ιU.left
    rintro _ ⟨t, rfl⟩
    exact hu' ⟨e.left t, rfl⟩

  have hσj : ∀ (T' : S.ProEt) (j : ℕ) (z : ULift.{u+1} (T' ⟶ U)),
      (fun u : ULift.{u+1} (T' ⟶ U) => ULift.up.{u+1} (u.down ≫ g))^[j] z =
        ULift.up (z.down ≫ wcLfdIter g j) := by
    intro T' j
    induction j with
    | zero =>
      intro z
      show z = ULift.up (z.down ≫ 𝟙 U)
      rw [Category.comp_id]
    | succ j ih =>
      intro z
      rw [Function.iterate_succ_apply, ih]
      show ULift.up ((z.down ≫ g) ≫ wcLfdIter g j) = ULift.up (z.down ≫ (g ≫ wcLfdIter g j))
      rw [Category.assoc]
  have htel : ∀ {X : Type (u+1)} (σ : X → X) (a : X) (j : ℕ),
      (∑ i ∈ Finset.range j, FreeAbelianGroup.of (σ^[i] a)) -
          FreeAbelianGroup.map σ (∑ i ∈ Finset.range j, FreeAbelianGroup.of (σ^[i] a)) =
        FreeAbelianGroup.of a - FreeAbelianGroup.of (σ^[j] a) := by
    intro X σ a j
    induction j with
    | zero => simp
    | succ j ih =>
      rw [Finset.sum_range_succ, map_add, FreeAbelianGroup.map_of_apply,
        Function.iterate_succ_apply', add_sub_add_comm, ih]
      abel

  obtain ⟨β, hβ⟩ : ∃ β : ULift.{u+1} (T ⟶ U) → ULift.{u+1} (T ⟶ B),
      β = fun u : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (u.down ≫ b) := ⟨_, rfl⟩
  have hx' : FreeAbelianGroup.map β x ∈ AddSubgroup.closure (FreeAbelianGroup.of ''
      {v : ULift.{u+1} (T ⟶ B) | Set.range v.down.left ⊆ Set.range ιB.left}) := by
    rw [hβ]; exact hx

  have hD : ∀ a a' : ULift.{u+1} (T ⟶ U), β a = β a' →
      FreeAbelianGroup.of a - FreeAbelianGroup.of a' ∈ G := by
    intro a a' h
    have hab : a.down ≫ b = a'.down ≫ b := by
      have h' := congrArg ULift.down h
      rw [hβ] at h'
      exact h'
    obtain ⟨R, hR, hRe⟩ := hdl T a.down a'.down hab
    rw [hG, hGood]
    refine ⟨R, hR, fun T' e he => ?_⟩
    obtain ⟨j, -, heq⟩ := hRe T' e he
    refine ⟨∑ i ∈ Finset.range j, FreeAbelianGroup.of
      ((fun u : ULift.{u+1} (T' ⟶ U) => ULift.up.{u+1} (u.down ≫ g))^[i]
        (ULift.up (e ≫ a.down))), ?_⟩
    have hw : (fun u : ULift.{u+1} (T' ⟶ U) => ULift.up.{u+1} (u.down ≫ g))^[j]
        (ULift.up (e ≫ a.down)) = ULift.up (e ≫ a'.down) := by
      rw [hσj]
      exact congrArg ULift.up ((Category.assoc _ _ _).trans heq.symm)
    have h0 : FreeAbelianGroup.map (fun u : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (e ≫ u.down))
        (FreeAbelianGroup.of a - FreeAbelianGroup.of a') =
        FreeAbelianGroup.of (ULift.up (e ≫ a.down)) -
          FreeAbelianGroup.of (ULift.up.{u+1} (e ≫ a'.down)) := by
      rw [map_sub, FreeAbelianGroup.map_of_apply, FreeAbelianGroup.map_of_apply]
    rw [htel (fun u : ULift.{u+1} (T' ⟶ U) => ULift.up.{u+1} (u.down ≫ g))
      (ULift.up (e ≫ a.down)) j, hw, h0, sub_self]
    exact zero_mem _

  have hker : ∀ p : FreeAbelianGroup (ULift.{u+1} (T ⟶ U)),
      FreeAbelianGroup.map β p = 0 → p ∈ G := by
    intro p hp
    rcases isEmpty_or_nonempty (ULift.{u+1} (T ⟶ U)) with hE | hE
    · have hall : ∀ q : FreeAbelianGroup (ULift.{u+1} (T ⟶ U)), q = 0 := by
        intro q
        induction q using FreeAbelianGroup.induction_on with
        | zero => rfl
        | of a => exact isEmptyElim a
        | neg a _ => exact isEmptyElim a
        | add p q hp hq => rw [hp, hq, add_zero]
      rw [hall p]
      exact zero_mem _
    · have hs : ∀ a, β (Function.invFun β (β a)) = β a := fun a => Function.invFun_eq ⟨a, rfl⟩
      have hq : ∀ q : FreeAbelianGroup (ULift.{u+1} (T ⟶ U)),
          q - FreeAbelianGroup.map (Function.invFun β ∘ β) q ∈ G := by
        intro q
        induction q using FreeAbelianGroup.induction_on with
        | zero => rw [map_zero, sub_zero]; exact zero_mem _
        | of a =>
          rw [FreeAbelianGroup.map_of_apply]
          exact hD _ _ (hs a).symm
        | neg a ih =>
          convert neg_mem ih using 1
          rw [map_neg]
          abel
        | add p q hp hq =>
          rw [map_add, add_sub_add_comm]
          exact add_mem hp hq
      have h0 : FreeAbelianGroup.map (Function.invFun β ∘ β) p = 0 := by
        rw [FreeAbelianGroup.map_comp_apply, hp, map_zero]
      have := hq p
      rwa [h0, sub_zero] at this

  have hF1 : ∀ a : ULift.{u+1} (T ⟶ U), Set.range a.down.left ⊆ Set.range ιU.left ↔
      Set.range (β a).down.left ⊆ Set.range ιB.left := by
    intro a
    rw [hβ, hr]
    constructor
    · rintro h _ ⟨t, rfl⟩
      exact h ⟨t, rfl⟩
    · rintro h _ ⟨t, rfl⟩
      exact h ⟨t, rfl⟩

  obtain ⟨lamU, hlamU⟩ : ∃ l : FreeAbelianGroup (ULift.{u+1} (T ⟶ U)) →+
      FreeAbelianGroup (ULift.{u+1} (T ⟶ U)), l = FreeAbelianGroup.lift
        (fun a : ULift.{u+1} (T ⟶ U) => if Set.range a.down.left ⊆ Set.range ιU.left then
          (0 : FreeAbelianGroup (ULift.{u+1} (T ⟶ U))) else FreeAbelianGroup.of a) := ⟨_, rfl⟩
  obtain ⟨lamB, hlamB⟩ : ∃ l : FreeAbelianGroup (ULift.{u+1} (T ⟶ B)) →+
      FreeAbelianGroup (ULift.{u+1} (T ⟶ B)), l = FreeAbelianGroup.lift
        (fun v : ULift.{u+1} (T ⟶ B) => if Set.range v.down.left ⊆ Set.range ιB.left then
          (0 : FreeAbelianGroup (ULift.{u+1} (T ⟶ B))) else FreeAbelianGroup.of v) := ⟨_, rfl⟩
  have hsubZ : ∀ p : FreeAbelianGroup (ULift.{u+1} (T ⟶ U)), p - lamU p ∈
      AddSubgroup.closure (FreeAbelianGroup.of ''
        {u : ULift.{u+1} (T ⟶ U) | Set.range u.down.left ⊆ Set.range ιU.left}) := by
    intro p
    induction p using FreeAbelianGroup.induction_on with
    | zero => rw [map_zero, sub_zero]; exact zero_mem _
    | of a =>
      rw [hlamU, FreeAbelianGroup.lift_apply_of]
      split_ifs with ha
      · rw [sub_zero]; exact AddSubgroup.subset_closure ⟨a, ha, rfl⟩
      · rw [sub_self]; exact zero_mem _
    | neg a ih =>
      convert neg_mem ih using 1
      rw [map_neg]
      abel
    | add p q hp hq =>
      rw [map_add, add_sub_add_comm]
      exact add_mem hp hq
  have hcomm : ∀ p : FreeAbelianGroup (ULift.{u+1} (T ⟶ U)),
      lamB (FreeAbelianGroup.map β p) = FreeAbelianGroup.map β (lamU p) := by
    intro p
    induction p using FreeAbelianGroup.induction_on with
    | zero => rw [map_zero, map_zero, map_zero, map_zero]
    | of a =>
      rw [FreeAbelianGroup.map_of_apply, hlamU, hlamB, FreeAbelianGroup.lift_apply_of,
        FreeAbelianGroup.lift_apply_of]
      by_cases ha : Set.range a.down.left ⊆ Set.range ιU.left
      · rw [if_pos ha, if_pos ((hF1 a).mp ha), map_zero]
      · rw [if_neg ha, if_neg (fun h => ha ((hF1 a).mpr h)), FreeAbelianGroup.map_of_apply]
    | neg a ih => rw [map_neg, map_neg, map_neg, map_neg, ih]
    | add p q hp hq => rw [map_add, map_add, map_add, map_add, hp, hq]
  have hZB : AddSubgroup.closure (FreeAbelianGroup.of ''
      {v : ULift.{u+1} (T ⟶ B) | Set.range v.down.left ⊆ Set.range ιB.left}) ≤ lamB.ker := by
    rw [AddSubgroup.closure_le]
    rintro _ ⟨v, hv, rfl⟩
    have hv' : Set.range v.down.left ⊆ Set.range ιB.left := hv
    rw [SetLike.mem_coe, AddMonoidHom.mem_ker, hlamB, FreeAbelianGroup.lift_apply_of, if_pos hv']
  have hxlam : FreeAbelianGroup.map β (lamU x) = 0 := by
    rw [← hcomm]
    exact AddMonoidHom.mem_ker.mp (hZB hx')
  have hxG : x ∈ G := by
    have := add_mem (hZ (hsubZ x)) (hker _ hxlam)
    rwa [sub_add_cancel] at this
  exact (hGood x).mp ((hG x).mp hxG)

theorem wc_tp_free_epi (S : Scheme.{u}) {U B : S.ProEt} (b : U ⟶ B)
    (hbs : Function.Surjective b.left) (hbe : Etale b.left) : Epi (wcFreeSheafMap S b) :=
by
  classical

  have s1 : ∀ {W T : S.ProEt} (q : W ⟶ T), Etale q.left → Function.Surjective q.left →
      Sieve.generate (Presieve.singleton q) ∈ Scheme.ProEt.topology S T := by
    intro W T q hqe hqs
    haveI := hqe
    have hRb : Presieve.ofArrows (fun _ : PUnit.{u+2} => W.left) (fun _ => q.left) ∈
        Scheme.proetalePrecoverage.coverings T.left :=
      Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr
        ⟨Scheme.Cover.mkOfCovers (P := @WeaklyEtale) PUnit.{u+2} (fun _ => W.left)
            (fun _ => q.left) (fun x => ⟨PUnit.unit, hqs x⟩)
            (fun _ => etale_le_weaklyEtale _ _ _ inferInstance),
          @QuasiCompactCover.of_isOpenMap _ _ _ Scheme.instJointlySurjectivePrecoverage
            (fun _ => Scheme.Hom.isOpenMap q.left), rfl⟩
    have hRJ : Sieve.generate (Presieve.ofArrows (fun _ : PUnit.{u+2} => W) (fun _ => q)) ∈
        Scheme.ProEt.topology S T :=
      Precoverage.generate_mem_toGrothendieck
        (Precoverage.mem_comap_iff.mpr
          ((Presieve.map_ofArrows (F := Scheme.ProEt.forget S ⋙ Over.forget S)
            (Y := fun _ : PUnit.{u+2} => W) (fun _ => q)) ▸ hRb))
    refine (Scheme.ProEt.topology S).superset_covering ?_ hRJ
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨_⟩
    exact Sieve.le_generate _ _ _ (Presieve.singleton_self q)

  have s2 : ∀ {T : S.ProEt} (v : T ⟶ B), ∃ (W : S.ProEt) (q₁ : W ⟶ T) (q₂ : W ⟶ U),
      Etale q₁.left ∧ Function.Surjective q₁.left ∧ q₂ ≫ b = q₁ ≫ v := by
    intro T v
    haveI := hbe
    haveI : Surjective b.left := ⟨hbs⟩
    have hp : Etale (Limits.pullback.fst v.left b.left) := inferInstance
    have hps : Surjective (Limits.pullback.fst v.left b.left) := inferInstance
    have hW : WeaklyEtale (Limits.pullback.fst v.left b.left ≫ T.hom) :=
      @MorphismProperty.comp_mem _ _ @WeaklyEtale
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition
        _ _ _ _ _ (etale_le_weaklyEtale _ _ _ hp) T.prop
    let W : S.ProEt := @Scheme.ProEt.mk S _ (Limits.pullback.fst v.left b.left ≫ T.hom) hW
    have h₂ : Limits.pullback.snd v.left b.left ≫ U.hom =
        Limits.pullback.fst v.left b.left ≫ T.hom := by
      rw [← MorphismProperty.Over.w b, ← Category.assoc, ← Limits.pullback.condition,
        Category.assoc, MorphismProperty.Over.w v]
    let q₁ : W ⟶ T := MorphismProperty.Over.homMk (Limits.pullback.fst v.left b.left) rfl trivial
    let q₂ : W ⟶ U := MorphismProperty.Over.homMk (Limits.pullback.snd v.left b.left) h₂ trivial
    refine ⟨W, q₁, q₂, hp, hps.surj, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    show Limits.pullback.snd v.left b.left ≫ b.left = Limits.pullback.fst v.left b.left ≫ v.left
    exact Limits.pullback.condition.symm

  have key : ∀ (T : S.ProEt) (s : FreeAbelianGroup (ULift.{u+1} (T ⟶ B))),
      Presheaf.imageSieve
        (Functor.whiskerRight (yoneda.map b) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) s ∈
        Scheme.ProEt.topology S T := by
    intro T s
    refine FreeAbelianGroup.induction_on s ?_ ?_ ?_ ?_
    · refine (Scheme.ProEt.topology S).superset_covering ?_ ((Scheme.ProEt.topology S).top_mem T)
      intro V i _
      refine (Presheaf.imageSieve_apply _ _ _ _).mpr ?_
      exact ⟨0, (map_zero _).trans (map_zero _).symm⟩
    · intro x
      obtain ⟨W, q₁, q₂, he, hs, hc⟩ := s2 x.down
      refine (Scheme.ProEt.topology S).superset_covering ?_ (s1 q₁ he hs)
      rw [Sieve.generate_le_iff]
      rintro _ _ ⟨⟩
      refine (Presheaf.imageSieve_apply _ _ _ _).mpr ?_
      exact ⟨FreeAbelianGroup.of (ULift.up.{u+1} q₂),
        congrArg (fun m => FreeAbelianGroup.of (ULift.up.{u+1} m)) hc⟩
    · intro x hx
      refine (Scheme.ProEt.topology S).superset_covering ?_ hx
      intro V i hi
      obtain ⟨t, ht⟩ := (Presheaf.imageSieve_apply _ _ _ _).mp hi
      refine (Presheaf.imageSieve_apply _ _ _ _).mpr ?_
      exact ⟨-t, (map_neg _ t).trans ((congrArg Neg.neg ht).trans (map_neg _ _).symm)⟩
    · intro x y hx hy
      refine (Scheme.ProEt.topology S).superset_covering ?_
        ((Scheme.ProEt.topology S).intersection_covering hx hy)
      rintro V i ⟨hi1, hi2⟩
      obtain ⟨t₁, h₁⟩ := (Presheaf.imageSieve_apply _ _ _ _).mp hi1
      obtain ⟨t₂, h₂⟩ := (Presheaf.imageSieve_apply _ _ _ _).mp hi2
      refine (Presheaf.imageSieve_apply _ _ _ _).mpr ?_
      exact ⟨t₁ + t₂, (map_add _ t₁ t₂).trans
        ((congrArg₂ (· + ·) h₁ h₂).trans (map_add _ _ _).symm)⟩

  unfold wcFreeSheafMap
  refine (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp
    ((Presheaf.isLocallySurjective_presheafToSheaf_map_iff (Scheme.ProEt.topology S) _).mpr ?_)
  exact Presheaf.IsLocallySurjective.mk (fun {T} s => key T s)

theorem wc_lfd_torsor_periodic (S : Scheme.{u}) {U B VU VB : S.ProEt}
    (b : U ⟶ B) (g : U ⟶ U) (N : ℕ) (hN : 0 < N)
    (hgN : wcLfdIter g N = 𝟙 U) (hgb : g ≫ b = b)
    (hbs : Function.Surjective b.left) (hbe : Etale b.left)
    (hdeck : ∀ (T : Scheme.{u}) (u₁ u₂ : T ⟶ U.left), u₁ ≫ b.left = u₂ ≫ b.left →
      ∃ O : Fin N → T.Opens, (∀ z : T, ∃! j, z ∈ O j) ∧
        ∀ j, (O j).ι ≫ u₂ = (O j).ι ≫ u₁ ≫ (wcLfdIter g (j : ℕ)).left)
    (hfree : ∀ (T : Scheme.{u}) (u : T ⟶ U.left) (j : ℕ), 0 < j → j < N → Nonempty T →
      u ≫ (wcLfdIter g j).left ≠ u)
    (ιU : VU ⟶ U) (ιB : VB ⟶ B) (hιU : IsOpenImmersion ιU.left) (hιB : IsOpenImmersion ιB.left)
    (hr : Set.range ιU.left = b.left ⁻¹' Set.range ιB.left)
    (gR : Limits.cokernel (wcFreeSheafMap S ιU) ⟶ Limits.cokernel (wcFreeSheafMap S ιU))
    (hgR : Limits.cokernel.π (wcFreeSheafMap S ιU) ≫ gR =
      wcFreeSheafMap S g ≫ Limits.cokernel.π (wcFreeSheafMap S ιU))
    (bR : Limits.cokernel (wcFreeSheafMap S ιU) ⟶ Limits.cokernel (wcFreeSheafMap S ιB))
    (hbR : Limits.cokernel.π (wcFreeSheafMap S ιU) ≫ bR =
      wcFreeSheafMap S b ≫ Limits.cokernel.π (wcFreeSheafMap S ιB)) :
    ∃ trR : Limits.cokernel (wcFreeSheafMap S ιB) ⟶ Limits.cokernel (wcFreeSheafMap S ιU),
      bR ≫ trR = ∑ j ∈ Finset.range N, wcLfdIter gR j ∧ Mono trR ∧ Epi bR ∧
      ∃ (w₁ : trR ≫ (𝟙 _ - gR) = 0) (w₂ : (𝟙 _ - gR) ≫ bR = 0),
        (ShortComplex.mk _ _ w₁).Exact ∧ (ShortComplex.mk _ _ w₂).Exact :=
by
  classical

  have s9 : ∀ {P P' : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (φ : P ⟶ P') (T : (S.ProEt)ᵒᵖ),
      Function.Surjective ((Limits.cokernel.π φ).app T).hom ∧
        ∀ x, ((Limits.cokernel.π φ).app T).hom x = 0 ↔ x ∈ ((φ.app T).hom).range := by
    intro P P' φ T
    constructor
    · have : Epi ((Limits.cokernel.π φ).app T) := inferInstance
      exact (AddCommGrpCat.epi_iff_surjective _).mp this
    · intro x
      constructor
      · intro hx
        have hex := (ShortComplex.exact_cokernel φ).map ((evaluation _ _).obj T)
        rw [ShortComplex.ab_exact_iff] at hex
        obtain ⟨y, hy⟩ := hex x hx
        exact ⟨y, hy⟩
      · rintro ⟨y, rfl⟩
        exact congrArg (fun ψ => (ψ.app T).hom y) (Limits.cokernel.condition φ)
  have s7 : ∀ {V W : S.ProEt} (ι : V ⟶ W),
      ∃ e : (wcTpSh S).obj (Limits.cokernel (wcTpFreeMap S ι)) ≅
          Limits.cokernel (wcFreeSheafMap S ι),
        (wcTpSh S).map (Limits.cokernel.π (wcTpFreeMap S ι)) ≫ e.hom =
          Limits.cokernel.π (wcFreeSheafMap S ι) := by
    intro V W ι
    refine ⟨Limits.PreservesCokernel.iso (wcTpSh S) (wcTpFreeMap S ι), ?_⟩
    have h1 := Limits.π_comp_cokernelComparison (wcTpFreeMap S ι) (wcTpSh S)
    rw [← Limits.PreservesCokernel.iso_inv] at h1
    exact ((Iso.comp_inv_eq _).mp h1).symm
  have s4 : ∀ {P₁ P₂ P₃ : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (f : P₁ ⟶ P₂) (g' : P₂ ⟶ P₃)
      (w : f ≫ g' = 0),
      (∀ (T : S.ProEt) (x : P₂.obj (Opposite.op T)), (g'.app (Opposite.op T)).hom x = 0 →
        ∃ R : Sieve T, R ∈ Scheme.ProEt.topology S T ∧ ∀ (T' : S.ProEt) (e : T' ⟶ T),
          R.arrows e → ∃ y : P₁.obj (Opposite.op T'),
            (f.app (Opposite.op T')).hom y = (P₂.map e.op).hom x) →
      ∀ w' : (wcTpSh S).map f ≫ (wcTpSh S).map g' = 0,
        (ShortComplex.mk ((wcTpSh S).map f) ((wcTpSh S).map g') w').Exact := by
    intro P₁ P₂ P₃ f g' w hloc w'
    have hls : Presheaf.IsLocallySurjective (Scheme.ProEt.topology S)
        (Limits.kernel.lift g' f w) := by
      refine Presheaf.IsLocallySurjective.mk (fun {T} k => ?_)
      have hx : (g'.app (Opposite.op T)).hom
          (((Limits.kernel.ι g').app (Opposite.op T)).hom k) = 0 :=
        congrArg (fun ψ => (ψ.app (Opposite.op T)).hom k) (Limits.kernel.condition g')
      obtain ⟨R, hR, hRe⟩ := hloc T _ hx
      refine (Scheme.ProEt.topology S).superset_covering ?_ hR
      intro T' e he
      obtain ⟨y, hy⟩ := hRe T' e he
      refine ⟨y, ?_⟩
      have hinj : Function.Injective ((Limits.kernel.ι g').app (Opposite.op T')).hom := by
        have : Mono ((Limits.kernel.ι g').app (Opposite.op T')) := inferInstance
        exact (AddCommGrpCat.mono_iff_injective _).mp this
      apply hinj
      have h1 := congrArg (fun ψ => (ψ.app (Opposite.op T')).hom y) (Limits.kernel.lift_ι g' f w)
      have h2 := congrArg (fun ψ => ψ.hom k) ((Limits.kernel.ι g').naturality e.op)
      exact h1.trans (hy.trans h2.symm)
    have hepi : Epi ((wcTpSh S).map (Limits.kernel.lift g' f w)) :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp
        ((Presheaf.isLocallySurjective_presheafToSheaf_map_iff (Scheme.ProEt.topology S) _).mpr hls)
    rw [ShortComplex.exact_iff_epi_kernel_lift]
    have hc : IsIso (Limits.kernelComparison g' (wcTpSh S)) := by
      rw [← Limits.PreservesKernel.iso_hom]; infer_instance
    have heq : (wcTpSh S).map (Limits.kernel.lift g' f w) ≫ Limits.kernelComparison g' (wcTpSh S) =
        Limits.kernel.lift ((wcTpSh S).map g') ((wcTpSh S).map f) w' := by
      rw [← cancel_mono (Limits.kernel.ι ((wcTpSh S).map g')), Category.assoc,
        Limits.kernelComparison_comp_ι, ← Functor.map_comp, Limits.kernel.lift_ι,
        Limits.kernel.lift_ι]
    show Epi (Limits.kernel.lift ((wcTpSh S).map g') ((wcTpSh S).map f) w')
    rw [← heq]
    exact epi_comp _ _

  have hnat : ∀ {P Q : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (α : P ⟶ Q) {T T' : S.ProEt}
      (e : T' ⟶ T) (z : P.obj (Opposite.op T)),
      (α.app (Opposite.op T')).hom ((P.map e.op).hom z) =
        (Q.map e.op).hom ((α.app (Opposite.op T)).hom z) := by
    intro P Q α T T' e z
    exact congrArg (fun h => h.hom z) (α.naturality e.op)

  have C3 : ∀ {W₁ A₁ W₂ A₂ W₃ A₃ : S.ProEt} (ι₁ : W₁ ⟶ A₁) (ι₂ : W₂ ⟶ A₂) (ι₃ : W₃ ⟶ A₃)
      (f : wcTpFree S A₁ ⟶ wcTpFree S A₂) (h : wcTpFree S A₂ ⟶ wcTpFree S A₃)
      (F : Limits.cokernel (wcFreeSheafMap S ι₁) ⟶ Limits.cokernel (wcFreeSheafMap S ι₂))
      (H : Limits.cokernel (wcFreeSheafMap S ι₂) ⟶ Limits.cokernel (wcFreeSheafMap S ι₃))
      (hF : Limits.cokernel.π (wcFreeSheafMap S ι₁) ≫ F =
        (wcTpSh S).map f ≫ Limits.cokernel.π (wcFreeSheafMap S ι₂))
      (hH : Limits.cokernel.π (wcFreeSheafMap S ι₂) ≫ H =
        (wcTpSh S).map h ≫ Limits.cokernel.π (wcFreeSheafMap S ι₃))
      (hf : ∃ φ, wcTpFreeMap S ι₁ ≫ f = φ ≫ wcTpFreeMap S ι₂)
      (hh : ∃ ψ, wcTpFreeMap S ι₂ ≫ h = ψ ≫ wcTpFreeMap S ι₃)
      (hw : f ≫ h = 0)
      (hloc : ∀ (T : S.ProEt) (x : (wcTpFree S A₂).obj (Opposite.op T)),
        (h.app (Opposite.op T)).hom x ∈ ((wcTpFreeMap S ι₃).app (Opposite.op T)).hom.range →
        ∃ R : Sieve T, R ∈ Scheme.ProEt.topology S T ∧ ∀ (T' : S.ProEt) (e : T' ⟶ T),
          R.arrows e → ∃ y : (wcTpFree S A₁).obj (Opposite.op T'),
            ((wcTpFree S A₂).map e.op).hom x - (f.app (Opposite.op T')).hom y ∈
              ((wcTpFreeMap S ι₂).app (Opposite.op T')).hom.range),
      ∃ w : F ≫ H = 0, (ShortComplex.mk F H w).Exact := by
    intro W₁ A₁ W₂ A₂ W₃ A₃ ι₁ ι₂ ι₃ f h F H hF hH hf hh hw hloc
    obtain ⟨φ, hφ⟩ := hf
    obtain ⟨ψ, hψ⟩ := hh
    have hf0 : wcTpFreeMap S ι₁ ≫ (f ≫ Limits.cokernel.π (wcTpFreeMap S ι₂)) = 0 := by
      rw [← Category.assoc, hφ, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    have hh0 : wcTpFreeMap S ι₂ ≫ (h ≫ Limits.cokernel.π (wcTpFreeMap S ι₃)) = 0 := by
      rw [← Category.assoc, hψ, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
    let fb := Limits.cokernel.desc _ _ hf0
    let hb := Limits.cokernel.desc _ _ hh0
    have hfb : Limits.cokernel.π (wcTpFreeMap S ι₁) ≫ fb = f ≫ Limits.cokernel.π (wcTpFreeMap S ι₂) :=
      Limits.cokernel.π_desc _ _ _
    have hhb : Limits.cokernel.π (wcTpFreeMap S ι₂) ≫ hb = h ≫ Limits.cokernel.π (wcTpFreeMap S ι₃) :=
      Limits.cokernel.π_desc _ _ _
    have wb : fb ≫ hb = 0 := by
      rw [← cancel_epi (Limits.cokernel.π (wcTpFreeMap S ι₁)), reassoc_of% hfb, hhb,
        ← Category.assoc, hw, Limits.zero_comp, Limits.comp_zero]
    have hS₁ := s4 fb hb wb (by
      intro T xb hxb
      obtain ⟨x, rfl⟩ := (s9 (wcTpFreeMap S ι₂) (Opposite.op T)).1 xb
      have e1 : (hb.app (Opposite.op T)).hom
          (((Limits.cokernel.π (wcTpFreeMap S ι₂)).app (Opposite.op T)).hom x) =
          ((Limits.cokernel.π (wcTpFreeMap S ι₃)).app (Opposite.op T)).hom
            ((h.app (Opposite.op T)).hom x) :=
        congrArg (fun ψ => (ψ.app (Opposite.op T)).hom x) hhb
      have hmem := ((s9 (wcTpFreeMap S ι₃) (Opposite.op T)).2 _).mp (e1.symm.trans hxb)
      obtain ⟨R, hR, hRe⟩ := hloc T x hmem
      refine ⟨R, hR, fun T' e he => ?_⟩
      obtain ⟨y, hy⟩ := hRe T' e he
      refine ⟨((Limits.cokernel.π (wcTpFreeMap S ι₁)).app (Opposite.op T')).hom y, ?_⟩
      have e2 : (fb.app (Opposite.op T')).hom
          (((Limits.cokernel.π (wcTpFreeMap S ι₁)).app (Opposite.op T')).hom y) =
          ((Limits.cokernel.π (wcTpFreeMap S ι₂)).app (Opposite.op T'))
            ((f.app (Opposite.op T')).hom y) :=
        congrArg (fun ψ => (ψ.app (Opposite.op T')).hom y) hfb
      have e3 := hnat (Limits.cokernel.π (wcTpFreeMap S ι₂)) e x
      have e4 := ((s9 (wcTpFreeMap S ι₂) (Opposite.op T')).2 _).mpr hy
      rw [map_sub, sub_eq_zero] at e4
      rw [e2, ← e3, e4])
    obtain ⟨e₁, he₁⟩ := s7 ι₁
    obtain ⟨e₂, he₂⟩ := s7 ι₂
    obtain ⟨e₃, he₃⟩ := s7 ι₃
    have c1 : e₁.hom ≫ F = (wcTpSh S).map fb ≫ e₂.hom := by
      rw [← cancel_epi ((wcTpSh S).map (Limits.cokernel.π (wcTpFreeMap S ι₁)))]
      have k1 : (wcTpSh S).map (Limits.cokernel.π (wcTpFreeMap S ι₁)) ≫ e₁.hom ≫ F =
          (wcTpSh S).map f ≫ Limits.cokernel.π (wcFreeSheafMap S ι₂) :=
        (Category.assoc _ _ _).symm.trans ((congrArg (fun x => x ≫ F) he₁).trans hF)
      have k2 : (wcTpSh S).map (Limits.cokernel.π (wcTpFreeMap S ι₁)) ≫ (wcTpSh S).map fb ≫ e₂.hom =
          (wcTpSh S).map f ≫ Limits.cokernel.π (wcFreeSheafMap S ι₂) := by
        rw [← Functor.map_comp_assoc, hfb, Functor.map_comp_assoc]
        exact congrArg (fun x => (wcTpSh S).map f ≫ x) he₂
      exact k1.trans k2.symm
    have c2 : e₂.hom ≫ H = (wcTpSh S).map hb ≫ e₃.hom := by
      rw [← cancel_epi ((wcTpSh S).map (Limits.cokernel.π (wcTpFreeMap S ι₂)))]
      have k1 : (wcTpSh S).map (Limits.cokernel.π (wcTpFreeMap S ι₂)) ≫ e₂.hom ≫ H =
          (wcTpSh S).map h ≫ Limits.cokernel.π (wcFreeSheafMap S ι₃) :=
        (Category.assoc _ _ _).symm.trans ((congrArg (fun x => x ≫ H) he₂).trans hH)
      have k2 : (wcTpSh S).map (Limits.cokernel.π (wcTpFreeMap S ι₂)) ≫ (wcTpSh S).map hb ≫ e₃.hom =
          (wcTpSh S).map h ≫ Limits.cokernel.π (wcFreeSheafMap S ι₃) := by
        rw [← Functor.map_comp_assoc, hhb, Functor.map_comp_assoc]
        exact congrArg (fun x => (wcTpSh S).map h ≫ x) he₃
      exact k1.trans k2.symm
    have wFH : F ≫ H = 0 := by
      rw [← cancel_epi e₁.hom, reassoc_of% c1, c2, ← Functor.map_comp_assoc, wb,
        Functor.map_zero, Limits.zero_comp, Limits.comp_zero]
    have w' : (wcTpSh S).map fb ≫ (wcTpSh S).map hb = 0 := by
      rw [← Functor.map_comp, wb, Functor.map_zero]
    exact ⟨wFH, ShortComplex.exact_of_iso
      (ShortComplex.isoMk (S₁ := ShortComplex.mk _ _ w') (S₂ := ShortComplex.mk F H wFH)
        e₁ e₂ e₃ c1 c2) (hS₁ w')⟩

  have hF1 : ∀ {A₁ A₂ A₃ : S.ProEt} (a : A₁ ⟶ A₂) (c : A₂ ⟶ A₃),
      wcTpFreeMap S a ≫ wcTpFreeMap S c = wcTpFreeMap S (a ≫ c) := by
    intro A₁ A₂ A₃ a c
    show Functor.whiskerRight (yoneda.map a) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ≫
      Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) =
      Functor.whiskerRight (yoneda.map (a ≫ c)) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
    rw [yoneda.map_comp, Functor.whiskerRight_comp]
  have hF0 : ∀ A₁ : S.ProEt, wcTpFreeMap S (𝟙 A₁) = 𝟙 _ := by
    intro A₁
    show Functor.whiskerRight (yoneda.map (𝟙 A₁)) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) = 𝟙 _
    rw [yoneda.map_id, Functor.whiskerRight_id']

  have hlift : ∀ {V V' W W' : S.ProEt} (f : W ⟶ W') (ι : V ⟶ W) (ι' : V' ⟶ W')
      (hι' : IsOpenImmersion ι'.left) (H : Set.range (ι.left ≫ f.left) ⊆ Set.range ι'.left),
      ∃ φ : V ⟶ V', φ ≫ ι' = ι ≫ f := by
    intro V V' W W' f ι ι' hι' H
    let L : V.left ⟶ V'.left := IsOpenImmersion.lift ι'.left (ι.left ≫ f.left) H
    have hLfac : L ≫ ι'.left = ι.left ≫ f.left := IsOpenImmersion.lift_fac _ _ H
    have hLw : L ≫ V'.hom = V.hom := by
      rw [← MorphismProperty.Over.w ι', ← Category.assoc, hLfac, Category.assoc,
        MorphismProperty.Over.w f, MorphismProperty.Over.w ι]
    exact ⟨MorphismProperty.Over.homMk L hLw trivial, MorphismProperty.Over.Hom.ext hLfac⟩

  have hs8 : ∀ {V W : S.ProEt} (ι : V ⟶ W), IsOpenImmersion ι.left → ∀ T : S.ProEt,
      (FreeAbelianGroup.map (fun v : ULift.{u+1} (T ⟶ V) => ULift.up.{u+1} (v.down ≫ ι))).range =
        AddSubgroup.closure (FreeAbelianGroup.of ''
          {w : ULift.{u+1} (T ⟶ W) | Set.range w.down.left ⊆ Set.range ι.left}) := by
    intro V W ι hι T
    apply le_antisymm
    · rintro _ ⟨x, rfl⟩
      induction x using FreeAbelianGroup.induction_on
      · rw [map_zero]; exact zero_mem _
      · rename_i v
        rw [FreeAbelianGroup.map_of_apply]
        refine AddSubgroup.subset_closure ⟨_, ?_, rfl⟩
        show Set.range (v.down ≫ ι).left ⊆ Set.range ι.left
        rintro _ ⟨t, rfl⟩
        exact ⟨_, rfl⟩
      · rename_i v ih
        rw [map_neg]; exact neg_mem ih
      · rename_i x y hx hy
        rw [map_add]; exact add_mem hx hy
    · rw [AddSubgroup.closure_le]
      rintro _ ⟨w, hw, rfl⟩
      have hw' : Set.range w.down.left ⊆ Set.range ι.left := hw
      obtain ⟨φ, hφ⟩ := hlift w.down (𝟙 T) ι hι (by rintro _ ⟨t, rfl⟩; exact hw' ⟨t, rfl⟩)
      refine ⟨FreeAbelianGroup.of (ULift.up φ), ?_⟩
      rw [FreeAbelianGroup.map_of_apply, hφ, Category.id_comp]
  have hRU : ∀ T : S.ProEt, ((wcTpFreeMap S ιU).app (Opposite.op T)).hom.range =
      AddSubgroup.closure (FreeAbelianGroup.of ''
        {w : ULift.{u+1} (T ⟶ U) | Set.range w.down.left ⊆ Set.range ιU.left}) :=
    fun T => hs8 ιU hιU T
  have hRB : ∀ T : S.ProEt, ((wcTpFreeMap S ιB).app (Opposite.op T)).hom.range =
      AddSubgroup.closure (FreeAbelianGroup.of ''
        {w : ULift.{u+1} (T ⟶ B) | Set.range w.down.left ⊆ Set.range ιB.left}) :=
    fun T => hs8 ιB hιB T

  have hgr : ∀ x, x ∈ Set.range ιU.left → g.left x ∈ Set.range ιU.left := by
    intro x hx
    rw [hr] at hx ⊢
    have hb : b.left (g.left x) = b.left x := congrArg (fun m : U ⟶ B => m.left x) hgb
    show b.left (g.left x) ∈ Set.range ιB.left
    rw [hb]; exact hx
  obtain ⟨gV, hgV⟩ := hlift g ιU ιU hιU (by rintro _ ⟨v, rfl⟩; exact hgr _ ⟨v, rfl⟩)
  obtain ⟨bV, hbV⟩ := hlift b ιU ιB hιB (by
    rintro _ ⟨v, rfl⟩
    have h : ιU.left v ∈ b.left ⁻¹' Set.range ιB.left := by rw [← hr]; exact ⟨v, rfl⟩
    exact h)

  have hiterF : ∀ j : ℕ, wcLfdIter (wcTpFreeMap S g) j = wcTpFreeMap S (wcLfdIter g j) := by
    intro j
    induction j with
    | zero => exact (hF0 U).symm
    | succ j ih =>
      show wcTpFreeMap S g ≫ wcLfdIter (wcTpFreeMap S g) j = wcTpFreeMap S (g ≫ wcLfdIter g j)
      rw [ih, hF1]
  have hGN : wcLfdIter (wcTpFreeMap S g) N = 𝟙 _ := by rw [hiterF, hgN, hF0]
  have hcomm : ∀ j : ℕ, wcLfdIter (wcTpFreeMap S g) j ≫ wcTpFreeMap S g =
      wcLfdIter (wcTpFreeMap S g) (j + 1) := by
    intro j
    induction j with
    | zero =>
      show 𝟙 _ ≫ wcTpFreeMap S g = wcTpFreeMap S g ≫ 𝟙 _
      rw [Category.id_comp, Category.comp_id]
    | succ j ih =>
      show (wcTpFreeMap S g ≫ wcLfdIter (wcTpFreeMap S g) j) ≫ wcTpFreeMap S g =
        wcTpFreeMap S g ≫ wcLfdIter (wcTpFreeMap S g) (j + 1)
      rw [Category.assoc, ih]
  have hGV : wcTpFreeMap S ιU ≫ wcTpFreeMap S g = wcTpFreeMap S gV ≫ wcTpFreeMap S ιU := by
    rw [hF1, hF1, hgV]
  have hitV : ∀ j : ℕ, wcTpFreeMap S ιU ≫ wcLfdIter (wcTpFreeMap S g) j =
      wcLfdIter (wcTpFreeMap S gV) j ≫ wcTpFreeMap S ιU := by
    intro j
    induction j with
    | zero =>
      show wcTpFreeMap S ιU ≫ 𝟙 _ = 𝟙 _ ≫ wcTpFreeMap S ιU
      rw [Category.id_comp, Category.comp_id]
    | succ j ih =>
      show wcTpFreeMap S ιU ≫ (wcTpFreeMap S g ≫ wcLfdIter (wcTpFreeMap S g) j) =
        (wcTpFreeMap S gV ≫ wcLfdIter (wcTpFreeMap S gV) j) ≫ wcTpFreeMap S ιU
      rw [← Category.assoc, hGV, Category.assoc, ih, Category.assoc]

  have hfG : wcTpFreeMap S ιU ≫ (𝟙 _ - wcTpFreeMap S g) =
      (𝟙 _ - wcTpFreeMap S gV) ≫ wcTpFreeMap S ιU := by
    rw [Preadditive.comp_sub, Preadditive.sub_comp, Category.comp_id, Category.id_comp, hGV]
  have hfb : wcTpFreeMap S ιU ≫ wcTpFreeMap S b = wcTpFreeMap S bV ≫ wcTpFreeMap S ιB := by
    rw [hF1, hF1, hbV]
  have hfν : wcTpFreeMap S ιU ≫ (∑ j ∈ Finset.range N, wcLfdIter (wcTpFreeMap S g) j) =
      (∑ j ∈ Finset.range N, wcLfdIter (wcTpFreeMap S gV) j) ≫ wcTpFreeMap S ιU := by
    rw [Preadditive.comp_sum, Preadditive.sum_comp]
    exact Finset.sum_congr rfl (fun j _ => hitV j)

  have hwA : (𝟙 _ - wcTpFreeMap S g) ≫ wcTpFreeMap S b = 0 := by
    rw [Preadditive.sub_comp, Category.id_comp, hF1, hgb, sub_self]
  have hwB : (∑ j ∈ Finset.range N, wcLfdIter (wcTpFreeMap S g) j) ≫
      (𝟙 _ - wcTpFreeMap S g) = 0 := by
    rw [Preadditive.comp_sub, Category.comp_id, Preadditive.sum_comp,
      Finset.sum_congr rfl (fun j _ => hcomm j), ← Finset.sum_sub_distrib,
      Finset.sum_range_sub', hGN]
    exact sub_self _
  have hwC : (𝟙 _ - wcTpFreeMap S g) ≫
      (∑ j ∈ Finset.range N, wcLfdIter (wcTpFreeMap S g) j) = 0 := by
    rw [Preadditive.sub_comp, Category.id_comp, Preadditive.comp_sum, ← Finset.sum_sub_distrib]
    refine (Finset.sum_range_sub' (fun j => wcLfdIter (wcTpFreeMap S g) j) N).trans ?_
    rw [hGN]
    exact sub_self _

  obtain ⟨πU, hπU⟩ : ∃ p : (wcTpSh S).obj (wcTpFree S U) ⟶ Limits.cokernel (wcFreeSheafMap S ιU),
      p = Limits.cokernel.π (wcFreeSheafMap S ιU) := ⟨_, rfl⟩
  have hgR' : πU ≫ gR = (wcTpSh S).map (wcTpFreeMap S g) ≫ πU := by
    subst hπU; exact hgR
  have hFA' : πU ≫ (𝟙 _ - gR) = (wcTpSh S).map (𝟙 _ - wcTpFreeMap S g) ≫ πU := by
    rw [Functor.map_sub, CategoryTheory.Functor.map_id, Preadditive.comp_sub, Preadditive.sub_comp,
      Category.comp_id, Category.id_comp, hgR']
  have hiterπ' : ∀ j : ℕ, πU ≫ wcLfdIter gR j =
      (wcTpSh S).map (wcLfdIter (wcTpFreeMap S g) j) ≫ πU := by
    intro j
    induction j with
    | zero =>
      show πU ≫ 𝟙 _ = (wcTpSh S).map (𝟙 _) ≫ πU
      rw [CategoryTheory.Functor.map_id, Category.comp_id, Category.id_comp]
    | succ j ih =>
      show πU ≫ (gR ≫ wcLfdIter gR j) =
        (wcTpSh S).map (wcTpFreeMap S g ≫ wcLfdIter (wcTpFreeMap S g) j) ≫ πU
      rw [← Category.assoc, hgR', Category.assoc, ih, CategoryTheory.Functor.map_comp,
        Category.assoc]
  have hFB' : πU ≫ (∑ j ∈ Finset.range N, wcLfdIter gR j) =
      (wcTpSh S).map (∑ j ∈ Finset.range N, wcLfdIter (wcTpFreeMap S g) j) ≫ πU := by
    rw [Preadditive.comp_sum, Functor.map_sum, Preadditive.sum_comp]
    exact Finset.sum_congr rfl (fun j _ => hiterπ' j)
  have hFA : Limits.cokernel.π (wcFreeSheafMap S ιU) ≫ (𝟙 _ - gR) =
      (wcTpSh S).map (𝟙 _ - wcTpFreeMap S g) ≫ Limits.cokernel.π (wcFreeSheafMap S ιU) := by
    subst hπU; exact hFA'
  have hFB : Limits.cokernel.π (wcFreeSheafMap S ιU) ≫ (∑ j ∈ Finset.range N, wcLfdIter gR j) =
      (wcTpSh S).map (∑ j ∈ Finset.range N, wcLfdIter (wcTpFreeMap S g) j) ≫
        Limits.cokernel.π (wcFreeSheafMap S ιU) := by
    subst hπU; exact hFB'

  have hom_sum : ∀ {X Y : AddCommGrpCat.{u+1}} (s : Finset ℕ) (F : ℕ → (X ⟶ Y)) (z : X),
      (∑ j ∈ s, F j).hom z = ∑ j ∈ s, (F j).hom z := by
    intro X Y s F z
    induction s using Finset.induction_on with
    | empty => simp
    | insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, AddCommGrpCat.hom_add,
        AddMonoidHom.add_apply, ih]
  have hsec : ∀ (T : S.ProEt) (j : ℕ) (q : (wcTpFree S U).obj (Opposite.op T)),
      ((wcLfdIter (wcTpFreeMap S g) j).app (Opposite.op T)).hom q =
        (⇑(FreeAbelianGroup.map (fun u : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (u.down ≫ g))))^[j] q := by
    intro T j
    induction j with
    | zero => intro q; rfl
    | succ j ih =>
      intro q
      exact (ih (((wcTpFreeMap S g).app (Opposite.op T)).hom q)).trans
        (Function.iterate_succ_apply _ _ _).symm
  have happ : ∀ T : S.ProEt,
      (∑ j ∈ Finset.range N, wcLfdIter (wcTpFreeMap S g) j).app (Opposite.op T) =
        ∑ j ∈ Finset.range N, (wcLfdIter (wcTpFreeMap S g) j).app (Opposite.op T) := by
    intro T; rw [NatTrans.app_sum]
  have hsum : ∀ (T : S.ProEt) (q : (wcTpFree S U).obj (Opposite.op T)),
      ((∑ j ∈ Finset.range N, wcLfdIter (wcTpFreeMap S g) j).app (Opposite.op T)).hom q =
        ∑ j ∈ Finset.range N,
          (⇑(FreeAbelianGroup.map (fun u : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (u.down ≫ g))))^[j] q := by
    intro T q
    rw [happ T, hom_sum]
    exact Finset.sum_congr rfl (fun j _ => hsec T j q)

  have hσj : ∀ (T : S.ProEt) (j : ℕ) (x : ULift.{u+1} (T ⟶ U)),
      (fun u : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (u.down ≫ g))^[j] x =
        ULift.up (x.down ≫ wcLfdIter g j) := by
    intro T j
    induction j with
    | zero =>
      intro x
      show x = ULift.up (x.down ≫ 𝟙 U)
      rw [Category.comp_id]
    | succ j ih =>
      intro x
      rw [Function.iterate_succ_apply, ih]
      show ULift.up ((x.down ≫ g) ≫ wcLfdIter g j) = ULift.up (x.down ≫ (g ≫ wcLfdIter g j))
      rw [Category.assoc]
  have hσN : ∀ (T : S.ProEt) (x : ULift.{u+1} (T ⟶ U)),
      (fun u : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (u.down ≫ g))^[N] x = x := by
    intro T x
    rw [hσj, hgN, Category.comp_id]
  have hA : ∀ (T : S.ProEt), ∀ x ∈ {w : ULift.{u+1} (T ⟶ U) | Set.range w.down.left ⊆ Set.range ιU.left},
      (fun u : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (u.down ≫ g)) x ∈
        {w : ULift.{u+1} (T ⟶ U) | Set.range w.down.left ⊆ Set.range ιU.left} := by
    intro T x hx
    have hx' : Set.range x.down.left ⊆ Set.range ιU.left := hx
    show Set.range (x.down ≫ g).left ⊆ Set.range ιU.left
    rintro _ ⟨t, rfl⟩
    exact hgr _ (hx' ⟨t, rfl⟩)
  have hfreeA : ∀ (T : S.ProEt),
      ∀ x ∉ {w : ULift.{u+1} (T ⟶ U) | Set.range w.down.left ⊆ Set.range ιU.left},
      ∀ j : ℕ, 0 < j → j < N →
        (fun u : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (u.down ≫ g))^[j] x ≠ x := by
    intro T x hx j hj hjN heq
    rw [hσj] at heq
    have h2 : x.down ≫ wcLfdIter g j = x.down := congrArg ULift.down heq
    have hx' : ¬ Set.range x.down.left ⊆ Set.range ιU.left := hx
    obtain ⟨_, ⟨t, rfl⟩, _⟩ := Set.not_subset.mp hx'
    exact hfree T.left x.down.left j hj hjN ⟨t⟩ (congrArg (fun m => m.left) h2)
  have s1 := fun T : S.ProEt => wc_tp_free_orbit_algebra
    (fun u : ULift.{u+1} (T ⟶ U) => ULift.up.{u+1} (u.down ≫ g)) N hN (hσN T)
    {w : ULift.{u+1} (T ⟶ U) | Set.range w.down.left ⊆ Set.range ιU.left} (hA T) (hfreeA T)

  obtain ⟨w₂, hex₂⟩ := C3 ιU ιU ιB (𝟙 _ - wcTpFreeMap S g) (wcTpFreeMap S b) (𝟙 _ - gR) bR
    hFA hbR ⟨_, hfG⟩ ⟨_, hfb⟩ hwA (by
      intro T x hx
      rw [hRB T] at hx
      obtain ⟨R, hR, hRe⟩ := wc_tp_local_middle S b g N
        (fun T u₁ u₂ h => wc_tp_deck_local S b g N hdeck T u₁ u₂ h) ιU ιB hr T x hx
      refine ⟨R, hR, fun T' e he => ?_⟩
      obtain ⟨y, hy⟩ := hRe T' e he
      rw [← hRU T'] at hy
      exact ⟨y, hy⟩)

  obtain ⟨w₃, hex₃⟩ := C3 ιU ιU ιU (∑ j ∈ Finset.range N, wcLfdIter (wcTpFreeMap S g) j)
    (𝟙 _ - wcTpFreeMap S g) (∑ j ∈ Finset.range N, wcLfdIter gR j) (𝟙 _ - gR)
    hFB hFA ⟨_, hfν⟩ ⟨_, hfG⟩ hwB (by
      intro T x hx
      rw [hRU T] at hx
      obtain ⟨q, hq⟩ := (s1 T).1 x hx
      rw [← hRU T] at hq
      obtain ⟨z, hz⟩ := AddMonoidHom.mem_range.mp hq
      refine ⟨⊤, (Scheme.ProEt.topology S).top_mem T, fun T' e _ =>
        ⟨((wcTpFree S U).map e.op).hom q, ?_⟩⟩
      refine AddMonoidHom.mem_range.mpr ⟨((wcTpFree S VU).map e.op).hom z, ?_⟩
      exact (hnat (wcTpFreeMap S ιU) e z).trans
        ((congrArg (fun t => ((wcTpFree S U).map e.op).hom t) hz).trans
          ((map_sub _ _ _).trans
            ((congrArg (fun t => ((wcTpFree S U).map e.op).hom x - ((wcTpFree S U).map e.op).hom t)
              (hsum T q).symm).trans
              (congrArg (fun t => ((wcTpFree S U).map e.op).hom x - t)
                (hnat (∑ j ∈ Finset.range N, wcLfdIter (wcTpFreeMap S g) j) e q).symm)))))

  obtain ⟨w₄, hex₄⟩ := C3 ιU ιU ιU (𝟙 _ - wcTpFreeMap S g)
    (∑ j ∈ Finset.range N, wcLfdIter (wcTpFreeMap S g) j) (𝟙 _ - gR)
    (∑ j ∈ Finset.range N, wcLfdIter gR j)
    hFA hFB ⟨_, hfG⟩ ⟨_, hfν⟩ hwC (by
      intro T x hx
      rw [hRU T, hsum T x] at hx
      obtain ⟨q, hq⟩ := (s1 T).2 x hx
      rw [← hRU T] at hq
      obtain ⟨z, hz⟩ := AddMonoidHom.mem_range.mp hq
      refine ⟨⊤, (Scheme.ProEt.topology S).top_mem T, fun T' e _ =>
        ⟨((wcTpFree S U).map e.op).hom q, ?_⟩⟩
      refine AddMonoidHom.mem_range.mpr ⟨((wcTpFree S VU).map e.op).hom z, ?_⟩
      exact (hnat (wcTpFreeMap S ιU) e z).trans
        ((congrArg (fun t => ((wcTpFree S U).map e.op).hom t) hz).trans
          ((map_sub _ _ _).trans
            (congrArg (fun t => ((wcTpFree S U).map e.op).hom x - t)
              (hnat (𝟙 _ - wcTpFreeMap S g) e q).symm))))

  have hbepi : Epi bR := by
    have h1 : Epi (wcFreeSheafMap S b) := wc_tp_free_epi S b hbs hbe
    have h2 : Epi (Limits.cokernel.π (wcFreeSheafMap S ιU) ≫ bR) := by
      rw [hbR]; exact epi_comp _ _
    exact epi_of_epi (Limits.cokernel.π (wcFreeSheafMap S ιU)) bR

  have hc := hex₂.gIsCokernel
  obtain ⟨tr, htr⟩ := Limits.CokernelCofork.IsColimit.desc' hc
    (∑ j ∈ Finset.range N, wcLfdIter gR j) w₄
  have htr' : bR ≫ tr = ∑ j ∈ Finset.range N, wcLfdIter gR j := htr
  have hmono : Mono tr := by
    refine Preadditive.mono_of_cancel_zero _ (fun {Z} z hz => ?_)
    obtain ⟨A', π, hπ, y, hy⟩ := surjective_up_to_refinements_of_epi bR z
    have hy0 : y ≫ (∑ j ∈ Finset.range N, wcLfdIter gR j) = 0 := by
      rw [← htr', ← Category.assoc, ← hy, Category.assoc, hz, Limits.comp_zero]
    obtain ⟨A'', π', hπ', w, hw⟩ := hex₄.exact_up_to_refinements y hy0
    have hw' : π' ≫ y = w ≫ (𝟙 _ - gR) := hw
    have h3 : (π' ≫ π) ≫ z = (π' ≫ π) ≫ 0 := by
      rw [Category.assoc, hy, ← Category.assoc, hw', Category.assoc, w₂, Limits.comp_zero,
        Limits.comp_zero]
    exact (cancel_epi (π' ≫ π)).mp h3
  have w₁ : tr ≫ (𝟙 _ - gR) = 0 := by
    rw [← cancel_epi bR, ← Category.assoc, htr', w₃, Limits.comp_zero]
  have hex₁ : (ShortComplex.mk _ _ w₁).Exact := by
    rw [ShortComplex.exact_iff_exact_up_to_refinements]
    intro A y hy
    obtain ⟨A', π, hπ, w, hw⟩ := hex₃.exact_up_to_refinements y hy
    have hw' : π ≫ y = w ≫ (∑ j ∈ Finset.range N, wcLfdIter gR j) := hw
    exact ⟨A', π, hπ, w ≫ bR, by rw [hw', Category.assoc, htr']⟩
  exact ⟨tr, htr', hmono, hbepi, w₁, w₂, hex₁, hex₂⟩

theorem wc_lfd_field_levels (F : Type u) [Finite F] [Field F] (E : Type u) [Field E] [Algebra F E]
    [FiniteDimensional F E] (τ : E →ₐ[F] AlgebraicClosure F) :
    ∃ L : ℕ → IntermediateField F (AlgebraicClosure F),
      (∀ k, Finite (L k)) ∧
      (∀ k (e : E), τ e ∈ L k) ∧
      (∀ k j, L k ≤ L (k + j)) ∧
      (∀ y : AlgebraicClosure F, ∃ k, y ∈ L k) ∧
      (∀ k y, y ∈ L k →
        ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) (AlgebraicClosure F) _ _ _).symm
          ^ Module.finrank F E) y ∈ L k) ∧
      (∀ k y, y ∈ L k →
        (((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) (AlgebraicClosure F) _ _ _).symm
          ^ Module.finrank F E) ^ (k + 1).factorial) y = y) ∧
      (∀ k j, 0 < j → j < (k + 1).factorial → ∃ y ∈ L k,
        (((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) (AlgebraicClosure F) _ _ _).symm
          ^ Module.finrank F E) ^ j) y ≠ y) :=
by
  classical
  set Fr := @FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) (AlgebraicClosure F)
    _ _ _ with hFr
  set q := @Fintype.card F (Fintype.ofFinite F) with hq
  set r := Module.finrank F E with hr
  have hqN : q = Nat.card F := Fintype.card_eq_nat_card
  have hq1 : 1 < q := by rw [hqN]; exact Finite.one_lt_card
  have hr0 : 0 < r := Module.finrank_pos

  have FrPow : ∀ (n : ℕ) (y : AlgebraicClosure F), (Fr ^ n) y = y ^ (q ^ n) := by
    intro n y
    have h1 := congrFun (@FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate F _ (Fintype.ofFinite F)
      (AlgebraicClosure F) _ _ _ n) y
    rw [AlgEquiv.coe_pow]
    exact h1

  have hdiv : ∀ (a b : ℕ) (y : AlgebraicClosure F), a ∣ b → y ^ (q ^ a) = y → y ^ (q ^ b) = y := by
    rintro a b y ⟨c, rfl⟩ hy
    induction c with
    | zero => simp
    | succ c ih => rw [Nat.mul_succ, pow_add, pow_mul y, ih, hy]

  have hfix : ∀ σ : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F,
      ∃ L : IntermediateField F (AlgebraicClosure F), ∀ y, y ∈ L ↔ σ y = y := by
    intro σ
    refine ⟨IntermediateField.fixedField (Subgroup.zpowers σ), fun y => ?_⟩
    rw [IntermediateField.mem_fixedField_iff]
    constructor
    · intro h
      exact h σ (Subgroup.mem_zpowers σ)
    · intro h f hf
      have hle : Subgroup.zpowers σ ≤ MulAction.stabilizer (AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) y :=
        Subgroup.zpowers_le.mpr (by rw [MulAction.mem_stabilizer_iff]; exact h)
      have h2 := hle hf
      rw [MulAction.mem_stabilizer_iff] at h2
      exact h2

  have hfin : ∀ m, 0 < m → {y : AlgebraicClosure F | y ^ (q ^ m) = y}.Finite := by
    intro m hm
    have h1 : 1 < q ^ m := Nat.one_lt_pow hm.ne' hq1
    have hP := FiniteField.X_pow_card_sub_X_ne_zero (AlgebraicClosure F) h1
    refine (Polynomial.finite_setOfPred_isRoot hP).subset ?_
    intro y hy
    simp only [Set.mem_setOf_eq] at hy ⊢
    simp [Polynomial.IsRoot.def, hy]

  have hstrict : ∀ a b, 0 < a → a < b →
      ∃ y : AlgebraicClosure F, y ^ (q ^ b) = y ∧ y ^ (q ^ a) ≠ y := by
    intro a b ha hab
    have hqa : 1 < q ^ a := Nat.one_lt_pow ha.ne' hq1
    have hqb : 1 < q ^ b := Nat.one_lt_pow (by omega) hq1
    have hPa : (Polynomial.X ^ (q ^ a) - Polynomial.X : Polynomial (AlgebraicClosure F)) ≠ 0 :=
      FiniteField.X_pow_card_sub_X_ne_zero _ hqa
    have hPb : (Polynomial.X ^ (q ^ b) - Polynomial.X : Polynomial (AlgebraicClosure F)) ≠ 0 :=
      FiniteField.X_pow_card_sub_X_ne_zero _ hqb
    have hdega : (Polynomial.X ^ (q ^ a) - Polynomial.X : Polynomial (AlgebraicClosure F)).natDegree
        = q ^ a := FiniteField.X_pow_card_sub_X_natDegree_eq _ hqa
    have hdegb : (Polynomial.X ^ (q ^ b) - Polynomial.X : Polynomial (AlgebraicClosure F)).natDegree
        = q ^ b := FiniteField.X_pow_card_sub_X_natDegree_eq _ hqb
    haveI := ringChar.charP (AlgebraicClosure F)
    have h0F : (q : F) = 0 := @FiniteField.cast_card_eq_zero F _ (Fintype.ofFinite F)
    have hq0 : ((q ^ b : ℕ) : AlgebraicClosure F) = 0 := by
      rw [Nat.cast_pow, ← map_natCast (algebraMap F (AlgebraicClosure F)), h0F, map_zero,
        zero_pow (by omega)]
    have hsep := galois_poly_separable (K := AlgebraicClosure F) (ringChar (AlgebraicClosure F))
      (q ^ b) (ringChar.dvd hq0)
    have hcb : (Polynomial.X ^ (q ^ b) - Polynomial.X :
        Polynomial (AlgebraicClosure F)).roots.toFinset.card = q ^ b := by
      rw [Multiset.toFinset_card_of_nodup (Polynomial.nodup_roots hsep),
        IsAlgClosed.card_roots_eq_natDegree, hdegb]
    have hca : (Polynomial.X ^ (q ^ a) - Polynomial.X :
        Polynomial (AlgebraicClosure F)).roots.toFinset.card ≤ q ^ a :=
      (Multiset.toFinset_card_le _).trans ((Polynomial.card_roots' _).trans hdega.le)
    have hlt : q ^ a < q ^ b := Nat.pow_lt_pow_right hq1 hab
    obtain ⟨y, hyb, hya⟩ := Finset.exists_mem_notMem_of_card_lt_card
      (s := (Polynomial.X ^ (q ^ a) - Polynomial.X : Polynomial (AlgebraicClosure F)).roots.toFinset)
      (t := (Polynomial.X ^ (q ^ b) - Polynomial.X : Polynomial (AlgebraicClosure F)).roots.toFinset)
      (by omega)
    refine ⟨y, ?_, ?_⟩
    · rw [Multiset.mem_toFinset, Polynomial.mem_roots hPb] at hyb
      simpa [Polynomial.IsRoot.def, sub_eq_zero] using hyb
    · intro h
      apply hya
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hPa]
      simp [Polynomial.IsRoot.def, h]

  have hexists : ∀ y : AlgebraicClosure F, ∃ d, 0 < d ∧ y ^ (q ^ d) = y := by
    intro y
    have hint : IsIntegral F y := (Algebra.IsAlgebraic.isAlgebraic y).isIntegral
    haveI := IntermediateField.adjoin.finiteDimensional hint
    haveI : Finite (IntermediateField.adjoin F {y}) := Module.finite_of_finite F
    letI : Fintype (IntermediateField.adjoin F {y}) := Fintype.ofFinite _
    refine ⟨Module.finrank F (IntermediateField.adjoin F {y}), Module.finrank_pos, ?_⟩
    have hc : q ^ Module.finrank F (IntermediateField.adjoin F {y}) =
        Fintype.card (IntermediateField.adjoin F {y}) := by
      rw [hqN, Fintype.card_eq_nat_card,
        Module.natCard_eq_pow_finrank (K := F) (V := IntermediateField.adjoin F {y})]
    have h := FiniteField.pow_card
      (⟨y, IntermediateField.mem_adjoin_simple_self F y⟩ : IntermediateField.adjoin F {y})
    rw [hc]
    simpa using congrArg Subtype.val h

  have hτ : ∀ e : E, (τ e) ^ (q ^ r) = τ e := by
    intro e
    haveI : Finite E := Module.finite_of_finite F
    letI : Fintype E := Fintype.ofFinite E
    have hc : q ^ r = Fintype.card E := by
      rw [hqN, Fintype.card_eq_nat_card, Module.natCard_eq_pow_finrank (K := F) (V := E)]
    rw [hc, ← map_pow, FiniteField.pow_card]

  have hγ : ∀ (n : ℕ) (y : AlgebraicClosure F), ((Fr.symm ^ r) ^ n) y = y ↔ y ^ (q ^ (r * n)) = y := by
    intro n y
    rw [← pow_mul, ← AlgEquiv.aut_inv, inv_pow, AlgEquiv.aut_inv, AlgEquiv.symm_apply_eq, FrPow]
    exact eq_comm

  choose L hL using fun k : ℕ => hfix (Fr ^ (r * (k + 1).factorial))
  have hmem : ∀ k y, y ∈ L k ↔ y ^ (q ^ (r * (k + 1).factorial)) = y := by
    intro k y
    rw [hL, FrPow]
  have hm0 : ∀ k, 0 < r * (k + 1).factorial := fun k => Nat.mul_pos hr0 (Nat.factorial_pos _)
  refine ⟨L, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro k
    exact ((hfin _ (hm0 k)).subset (fun y hy => (hmem k y).mp hy)).to_subtype
  · intro k e
    rw [hmem]
    exact hdiv r _ _ (dvd_mul_right r _) (hτ e)
  · intro k j y hy
    rw [hmem] at hy ⊢
    exact hdiv _ _ _ (Nat.mul_dvd_mul_left r (Nat.factorial_dvd_factorial (by omega))) hy
  · intro y
    obtain ⟨d, hd, hyd⟩ := hexists y
    refine ⟨d, (hmem d y).mpr (hdiv d _ y ?_ hyd)⟩
    exact Dvd.dvd.mul_left (Nat.dvd_factorial hd (Nat.le_succ d)) r
  · intro k y hy
    rw [hmem] at hy ⊢
    rw [← map_pow, hy]
  · intro k y hy
    exact (hγ _ y).mpr ((hmem k y).mp hy)
  · intro k j hj hjN
    obtain ⟨y, hyb, hya⟩ := hstrict (r * j) (r * (k + 1).factorial) (Nat.mul_pos hr0 hj)
      (Nat.mul_lt_mul_of_pos_left hjN hr0)
    refine ⟨y, (hmem k y).mpr hyb, fun h => hya ((hγ j y).mp h)⟩

theorem wc_lfd_frob_fixed_field (F : Type u) [Finite F] [Field F] (E : Type u) [Field E] [Algebra F E]
    [FiniteDimensional F E] (τ : E →ₐ[F] AlgebraicClosure F) :
    (∀ e : E, ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) (AlgebraicClosure F) _ _ _).symm
          ^ Module.finrank F E) (τ e) = τ e) ∧
    (∀ c : AlgebraicClosure F,
      ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) (AlgebraicClosure F) _ _ _).symm
          ^ Module.finrank F E) c = c → ∃ e : E, τ e = c) :=
by
  classical
  have s1 : ∀ (n : ℕ) (c : AlgebraicClosure F),
      ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) (AlgebraicClosure F) _ _ _).symm
        ^ n) c = c ↔ c ^ (Nat.card F ^ n) = c := by
    intro n c
    letI : Fintype F := Fintype.ofFinite F
    rw [← AlgEquiv.aut_inv, inv_pow, AlgEquiv.aut_inv, AlgEquiv.symm_apply_eq, AlgEquiv.coe_pow,
      FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate, Fintype.card_eq_nat_card, eq_comm]
  haveI : Finite E := Module.finite_of_finite F
  have hcard : Nat.card E = Nat.card F ^ Module.finrank F E := Module.natCard_eq_pow_finrank
  letI : Fintype E := Fintype.ofFinite E
  have hpowE : ∀ e : E, e ^ Nat.card E = e := by
    intro e
    rw [← Fintype.card_eq_nat_card]
    exact FiniteField.pow_card e
  refine ⟨fun e => ?_, fun c hc => ?_⟩
  · rw [s1, ← hcard, ← map_pow, hpowE]
  · rw [s1, ← hcard] at hc
    have hN : 1 < Nat.card E := Finite.one_lt_card
    set N := Nat.card E with hNdef
    let P : Polynomial (AlgebraicClosure F) := Polynomial.X ^ N - Polynomial.X
    have hP0 : P ≠ 0 := FiniteField.X_pow_card_sub_X_ne_zero _ hN
    have hdeg : P.natDegree = N := FiniteField.X_pow_card_sub_X_natDegree_eq _ hN
    have hinj : Function.Injective τ := τ.toRingHom.injective
    let S : Finset (AlgebraicClosure F) := Finset.univ.image τ
    have hS : S.card = N := by
      rw [Finset.card_image_of_injective _ hinj, Finset.card_univ, Fintype.card_eq_nat_card]
    have hroot : ∀ x : AlgebraicClosure F, x ^ N = x → x ∈ P.roots.toFinset := by
      intro x hx
      rw [Multiset.mem_toFinset, Polynomial.mem_roots hP0]
      simp [P, Polynomial.IsRoot, hx]
    have hsub : S ⊆ P.roots.toFinset := by
      intro x hx
      obtain ⟨e, -, rfl⟩ := Finset.mem_image.mp hx
      exact hroot _ (by rw [← map_pow, hpowE])
    have hle : P.roots.toFinset.card ≤ S.card := by
      rw [hS]
      calc _ ≤ P.roots.card := Multiset.toFinset_card_le _
        _ ≤ P.natDegree := Polynomial.card_roots' _
        _ = N := hdeg
    have heq := Finset.eq_of_subset_of_card_le hsub hle
    have hc' : c ∈ S := heq ▸ hroot c hc
    obtain ⟨e, -, he⟩ := Finset.mem_image.mp hc'
    exact ⟨e, he⟩

theorem wc_lfd_field_deck (M E : Type u) [Field M] [Finite M] [Field E] (τM : E →+* M) (γ : M →+* M) (N : ℕ)
    (hN0 : 0 < N) (hN : ∀ y, (γ ^ N) y = y) (hfree : ∀ j, 0 < j → j < N → ∃ y, (γ ^ j) y ≠ y)
    (hfix : ∀ c, γ c = c → ∃ e, τM e = c) (T : Scheme.{u}) (v₁ v₂ : T ⟶ Spec (CommRingCat.of M))
    (hv : v₁ ≫ Spec.map (CommRingCat.ofHom τM) = v₂ ≫ Spec.map (CommRingCat.ofHom τM)) :
    ∃ O : Fin N → T.Opens, (∀ z : T, ∃! j, z ∈ O j) ∧
      ∀ j : Fin N, (O j).ι ≫ v₂ = (O j).ι ≫ v₁ ≫ Spec.map (CommRingCat.ofHom (γ ^ (j : ℕ))) :=
by
  classical

  have s1 : ∀ (A : Type u) [CommRing A] {W W' : Scheme.{u}} (f : W' ⟶ W)
      (w : W ⟶ Spec (CommRingCat.of A)),
      ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ (f ≫ w).appTop).hom =
        (Scheme.Hom.appTop f).hom.comp ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ w.appTop).hom := by
    intro A _ W W' f w
    rw [Scheme.Hom.comp_appTop]; rfl

  have s2 : ∀ (A B : Type u) [CommRing A] [CommRing B] (W : Scheme.{u})
      (w : W ⟶ Spec (CommRingCat.of B)) (σ : A →+* B),
      ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ (w ≫ Spec.map (CommRingCat.ofHom σ)).appTop).hom =
        ((Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ w.appTop).hom.comp σ := by
    intro A B _ _ W w σ
    rw [Scheme.Hom.comp_appTop, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality]
    rfl

  have s3 : ∀ (A : Type u) [CommRing A] (W : Scheme.{u})
      (w₁ w₂ : W ⟶ Spec (CommRingCat.of A)),
      ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ w₁.appTop).hom =
        ((Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ w₂.appTop).hom → w₁ = w₂ := by
    intro A _ W w₁ w₂ h
    apply ext_of_isAffine
    have h' := CommRingCat.hom_ext h
    exact (cancel_epi _).mp h'

  obtain ⟨g, hg⟩ := IsCyclic.exists_monoid_generator (α := Mˣ)
  set α : M := (g : M) with hαdef
  have hα : ∀ x : M, x ≠ 0 → ∃ k : ℕ, x = α ^ k := by
    intro x hx
    obtain ⟨n, hn⟩ := Submonoid.mem_powers_iff _ _ |>.mp (hg (Units.mk0 x hx))
    refine ⟨n, ?_⟩
    have := congrArg Units.val hn
    rw [Units.val_pow_eq_pow_val, Units.val_mk0] at this
    exact this.symm

  have s8 : ∀ (S : Type u) [CommRing S] (ψ ψ' : M →+* S), ψ α = ψ' α → ψ = ψ' := by
    intro S _ ψ ψ' h
    ext y
    by_cases hy : y = 0
    · rw [hy, map_zero, map_zero]
    · obtain ⟨k, rfl⟩ := hα y hy
      rw [map_pow, map_pow, h]

  have s6 : ∀ i j : Fin N, i ≠ j → (γ ^ (i : ℕ)) α ≠ (γ ^ (j : ℕ)) α := by
    have key : ∀ a b : ℕ, a < b → b < N → (γ ^ a) α ≠ (γ ^ b) α := by
      intro a b hab hbN heq
      obtain ⟨y, hy⟩ := hfree (b - a) (by omega) (by omega)
      have hb : γ ^ b = γ ^ a * γ ^ (b - a) := by rw [← pow_add]; congr 1; omega
      have h1 : (γ ^ a) α = (γ ^ a) ((γ ^ (b - a)) α) := by
        rw [heq, hb]; rfl
      have h2 : (γ ^ (b - a)) α = α := ((γ ^ a).injective h1).symm
      apply hy
      by_cases hy0 : y = 0
      · rw [hy0, map_zero]
      · obtain ⟨k, rfl⟩ := hα y hy0
        rw [map_pow, h2]
    intro i j hij
    rcases lt_or_gt_of_ne (Fin.val_ne_of_ne hij) with h | h
    · exact key _ _ h j.2
    · exact fun e => key _ _ h i.2 e.symm

  have s4 : ∀ (R : Type u) [CommRing R] (φ₁ φ₂ : M →+* R), φ₁.comp τM = φ₂.comp τM →
      ∏ j : Fin N, (φ₂ α - φ₁ ((γ ^ (j : ℕ)) α)) = 0 := by
    intro R _ φ₁ φ₂ hφ
    set f : ℕ → Polynomial M := fun k => Polynomial.X - Polynomial.C ((γ ^ k) α) with hf
    set P : Polynomial M := ∏ k ∈ Finset.range N, f k with hP
    have hγk : ∀ k, γ ((γ ^ k) α) = (γ ^ (k+1)) α := by
      intro k; rw [pow_succ']; rfl
    have hmapγ : P.map γ = P := by
      have h1 : P.map γ = ∏ k ∈ Finset.range N, f (k+1) := by
        rw [hP, Polynomial.map_prod]
        refine Finset.prod_congr rfl (fun k _ => ?_)
        simp only [hf, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C, hγk]
      have hfN : f N = f 0 := by
        simp only [hf, hN, pow_zero]; rfl
      have h2 : (∏ k ∈ Finset.range N, f (k+1)) * f 0 = P * f 0 := by
        rw [← Finset.prod_range_succ', Finset.prod_range_succ, hP, hfN]
      rw [h1]
      exact mul_right_cancel₀ (Polynomial.X_sub_C_ne_zero _) h2
    have hcoef : ∀ n, ∃ e, τM e = P.coeff n := by
      intro n
      apply hfix
      rw [← Polynomial.coeff_map, hmapγ]
    have hmap12 : P.map φ₁ = P.map φ₂ := by
      ext n
      rw [Polynomial.coeff_map, Polynomial.coeff_map]
      obtain ⟨e, he⟩ := hcoef n
      rw [← he]
      exact RingHom.congr_fun hφ e
    have hPα : P.eval α = 0 := by
      rw [hP, Polynomial.eval_prod]
      apply Finset.prod_eq_zero (Finset.mem_range.mpr hN0)
      simp [hf]
    have hR : (P.map φ₂).eval (φ₂ α) = 0 := by
      rw [Polynomial.eval_map, Polynomial.eval₂_hom, hPα, map_zero]
    have hL : (P.map φ₁).eval (φ₂ α) = ∏ k ∈ Finset.range N, (φ₂ α - φ₁ ((γ ^ k) α)) := by
      rw [hP, Polynomial.map_prod, Polynomial.eval_prod]
      refine Finset.prod_congr rfl (fun k _ => ?_)
      simp [hf]
    rw [Fin.prod_univ_eq_prod_range (fun k => φ₂ α - φ₁ ((γ ^ k) α)) N, ← hL, hmap12, hR]

  have s5 : ∀ (c : Fin N → Γ(T, ⊤)), ∏ j, c j = 0 → (∀ i j, i ≠ j → IsUnit (c i - c j)) →
      ∃ O : Fin N → T.Opens, (∀ z : T, ∃! j, z ∈ O j) ∧
        ∀ j, (Scheme.Hom.appTop (O j).ι).hom (c j) = 0 := by
    intro c hprod hunit
    refine ⟨fun j => T.basicOpen (∏ i ∈ Finset.univ.erase j, c i), ?_, ?_⟩
    · intro z
      let gz : Γ(T, ⊤) →+* T.presheaf.stalk z := (T.presheaf.germ ⊤ z trivial).hom
      have hmem : ∀ j, z ∈ T.basicOpen (∏ i ∈ Finset.univ.erase j, c i) ↔
          ∀ i ∈ Finset.univ.erase j, IsUnit (gz (c i)) := by
        intro j
        rw [Scheme.mem_basicOpen_top]
        show IsUnit (gz (∏ i ∈ Finset.univ.erase j, c i)) ↔ _
        rw [map_prod, IsUnit.prod_iff]
      have hatmost : ∀ i k, i ≠ k → ¬ IsUnit (gz (c i)) → ¬ IsUnit (gz (c k)) → False := by
        intro i k hik hi hk
        have hu : IsUnit (gz (c i - c k)) := (hunit i k hik).map gz
        rw [map_sub, sub_eq_add_neg] at hu
        have hk' : ¬ IsUnit (-(gz (c k))) := by rwa [IsUnit.neg_iff]
        exact (IsLocalRing.nonunits_add hi hk') hu
      have hatleast : ∃ j, ¬ IsUnit (gz (c j)) := by
        by_contra hcon
        simp only [not_exists, not_not] at hcon
        have : IsUnit (∏ j, gz (c j)) := IsUnit.prod_iff.mpr (fun j _ => hcon j)
        rw [← map_prod, hprod, map_zero] at this
        exact not_isUnit_zero this
      obtain ⟨j, hj⟩ := hatleast
      refine ⟨j, (hmem j).mpr ?_, ?_⟩
      · intro i hi
        by_contra hni
        exact hatmost i j (Finset.ne_of_mem_erase hi) hni hj
      · intro k hk
        by_contra hkj
        exact hj (((hmem k).mp hk) j (Finset.mem_erase.mpr ⟨Ne.symm hkj, Finset.mem_univ _⟩))
    · intro j
      set s := ∏ i ∈ Finset.univ.erase j, c i with hs
      have hcs : c j * s = 0 := by rw [hs, Finset.mul_prod_erase _ _ (Finset.mem_univ j), hprod]
      have hunitρ : IsUnit ((Scheme.Hom.appTop (T.basicOpen s).ι).hom s) := by
        have h1 : (T.basicOpen s).ι ⁻¹ᵁ T.basicOpen s = ⊤ := Scheme.Opens.ι_preimage_self _
        rw [Scheme.Hom.preimage_basicOpen_top] at h1
        have h2 : ∀ x : (T.basicOpen s : Scheme), x ∈ (T.basicOpen s : Scheme).basicOpen
            ((Scheme.Hom.appTop (T.basicOpen s).ι).hom s) := by
          intro x; rw [h1]; trivial
        exact RingedSpace.isUnit_of_isUnit_germ _ _ _
          (fun x _ => (Scheme.mem_basicOpen_top _ _ _).mp (h2 x))
      have h2 := congrArg (Scheme.Hom.appTop (T.basicOpen s).ι).hom hcs
      rw [map_mul, map_zero] at h2
      exact (hunitρ.mul_left_eq_zero).mp h2

  set φ₁ : M →+* Γ(T, ⊤) := ((Scheme.ΓSpecIso (CommRingCat.of M)).inv ≫ v₁.appTop).hom with hφ₁
  set φ₂ : M →+* Γ(T, ⊤) := ((Scheme.ΓSpecIso (CommRingCat.of M)).inv ≫ v₂.appTop).hom with hφ₂
  have hφ : φ₁.comp τM = φ₂.comp τM := by
    have h := congrArg (fun w => ((Scheme.ΓSpecIso (CommRingCat.of E)).inv ≫ w.appTop).hom) hv
    simp only at h
    rw [s2, s2] at h
    exact h
  set c : Fin N → Γ(T, ⊤) := fun j => φ₂ α - φ₁ ((γ ^ (j : ℕ)) α) with hc
  have hprod : ∏ j, c j = 0 := s4 _ φ₁ φ₂ hφ
  have hunit : ∀ i j, i ≠ j → IsUnit (c i - c j) := by
    intro i j hij
    have e : c i - c j = φ₁ ((γ ^ (j : ℕ)) α - (γ ^ (i : ℕ)) α) := by
      simp only [hc, map_sub]; ring
    rw [e]
    exact (Ne.isUnit (sub_ne_zero.mpr (s6 i j hij).symm)).map φ₁
  obtain ⟨O, hO1, hO2⟩ := s5 c hprod hunit
  refine ⟨O, hO1, fun j => ?_⟩
  apply s3
  rw [s1, s1, s2]
  have hcomp : ((Scheme.Hom.appTop (O j).ι).hom).comp φ₂ =
      ((Scheme.Hom.appTop (O j).ι).hom).comp (φ₁.comp (γ ^ (j : ℕ))) := by
    apply s8
    have h := hO2 j
    simp only [hc, map_sub] at h
    simpa only [RingHom.comp_apply] using sub_eq_zero.mp h
  rw [← hφ₁, ← hφ₂]
  exact hcomp

theorem wc_lfd_field_limit (F : Type u) [Field F] (K : Type u) [Field K] [Algebra F K]
    (L : ℕ → IntermediateField F K) (hmono : ∀ k j, L k ≤ L (k + j)) (hcov : ∀ y : K, ∃ k, y ∈ L k)
    (T : Scheme.{u}) (w : ∀ k, T ⟶ Spec (CommRingCat.of (L k)))
    (hw : ∀ k j, w (k + j) ≫ Spec.map (CommRingCat.ofHom (IntermediateField.inclusion (hmono k j)).toRingHom) = w k) :
    ∃! w₀ : T ⟶ Spec (CommRingCat.of K), ∀ k, w₀ ≫ Spec.map (CommRingCat.ofHom (L k).val.toRingHom) = w k :=
by
  classical
  have s1 : ∀ (R : CommRingCat.{u}) (v : T ⟶ Spec R),
      T.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso R).inv ≫ Scheme.Hom.appTop v) = v := by
    intro R v
    rw [Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality, Category.assoc,
      toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
  have s2 : ∀ {R S : CommRingCat.{u}} (f : S ⟶ R) (v : T ⟶ Spec R),
      (Scheme.ΓSpecIso S).inv ≫ Scheme.Hom.appTop (v ≫ Spec.map f) =
        f ≫ (Scheme.ΓSpecIso R).inv ≫ Scheme.Hom.appTop v := by
    intro R S f v
    have e : (Scheme.ΓSpecIso S).inv ≫ Scheme.Hom.appTop (Spec.map f) =
        f ≫ (Scheme.ΓSpecIso R).inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv, Scheme.ΓSpecIso_naturality]
    rw [Scheme.Hom.comp_appTop, ← Category.assoc, e, Category.assoc]
  let ψ : ∀ k, L k →+* Γ(T, ⊤) := fun k =>
    ((Scheme.ΓSpecIso (CommRingCat.of (L k))).inv ≫ Scheme.Hom.appTop (w k)).hom
  have hψ : ∀ k j, (ψ (k + j)).comp (IntermediateField.inclusion (hmono k j)).toRingHom = ψ k := by
    intro k j
    have h := s2 (CommRingCat.ofHom (IntermediateField.inclusion (hmono k j)).toRingHom) (w (k + j))
    rw [hw k j] at h
    show _ = CommRingCat.Hom.hom ((Scheme.ΓSpecIso (CommRingCat.of (L k))).inv ≫
      Scheme.Hom.appTop (w k))
    rw [h]
    simp only [ψ, CommRingCat.hom_comp, CommRingCat.hom_ofHom]
  have hle : ∀ a b, a ≤ b → L a ≤ L b := fun a b h => by
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
    exact hmono a j
  have step : ∀ k j (y : K) (hy : y ∈ L k) (hy' : y ∈ L (k + j)),
      ψ (k + j) ⟨y, hy'⟩ = ψ k ⟨y, hy⟩ := by
    intro k j y hy hy'
    exact RingHom.congr_fun (hψ k j) ⟨y, hy⟩
  have agree : ∀ k k' (y : K) (hy : y ∈ L k) (hy' : y ∈ L k'),
      ψ k ⟨y, hy⟩ = ψ k' ⟨y, hy'⟩ := by
    intro k k' y hy hy'
    rcases le_total k k' with h | h
    · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
      exact (step k j y hy hy').symm
    · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le h
      exact step k' j y hy' hy
  choose κ hκ using hcov
  let f : K → Γ(T, ⊤) := fun y => ψ (κ y) ⟨y, hκ y⟩
  have hf : ∀ k (y : K) (hy : y ∈ L k), f y = ψ k ⟨y, hy⟩ := fun k y hy => agree _ _ _ _ _
  let χ : K →+* Γ(T, ⊤) :=
    { toFun := f
      map_one' := by
        show f 1 = 1
        rw [hf 0 1 (L 0).one_mem]
        exact map_one (ψ 0)
      map_mul' := by
        intro x y
        show f (x * y) = f x * f y
        have hx : x ∈ L (max (κ x) (κ y)) := hle _ _ (le_max_left _ _) (hκ x)
        have hy : y ∈ L (max (κ x) (κ y)) := hle _ _ (le_max_right _ _) (hκ y)
        rw [hf _ (x * y) (mul_mem hx hy), hf _ x hx, hf _ y hy]
        exact map_mul (ψ _) ⟨x, hx⟩ ⟨y, hy⟩
      map_zero' := by
        show f 0 = 0
        rw [hf 0 0 (L 0).zero_mem]
        exact map_zero (ψ 0)
      map_add' := by
        intro x y
        show f (x + y) = f x + f y
        have hx : x ∈ L (max (κ x) (κ y)) := hle _ _ (le_max_left _ _) (hκ x)
        have hy : y ∈ L (max (κ x) (κ y)) := hle _ _ (le_max_right _ _) (hκ y)
        rw [hf _ (x + y) (add_mem hx hy), hf _ x hx, hf _ y hy]
        exact map_add (ψ _) ⟨x, hx⟩ ⟨y, hy⟩ }
  have hχ : ∀ k, χ.comp (L k).val.toRingHom = ψ k := by
    intro k
    ext ⟨y, hy⟩
    exact hf k y hy
  have huniq : ∀ χ' : K →+* Γ(T, ⊤), (∀ k, χ'.comp (L k).val.toRingHom = ψ k) → χ' = χ := by
    intro χ' h
    ext y
    exact RingHom.congr_fun (h (κ y)) ⟨y, hκ y⟩
  refine ⟨T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom χ), fun k => ?_, fun w₁ hw₁ => ?_⟩
  · rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hχ k]
    exact s1 _ (w k)
  · have hall : ∀ k, ((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
        Scheme.Hom.appTop w₁).hom.comp (L k).val.toRingHom = ψ k := by
      intro k
      have h := s2 (CommRingCat.ofHom (L k).val.toRingHom) w₁
      rw [hw₁ k] at h
      show _ = CommRingCat.Hom.hom ((Scheme.ΓSpecIso (CommRingCat.of (L k))).inv ≫
        Scheme.Hom.appTop (w k))
      rw [h]
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    have hE : (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫ Scheme.Hom.appTop w₁ =
        CommRingCat.ofHom χ := by
      ext1
      rw [CommRingCat.hom_ofHom]
      exact huniq _ hall
    calc w₁ = T.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
          Scheme.Hom.appTop w₁) := (s1 _ w₁).symm
      _ = T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom χ) := by rw [hE]

theorem wc_lfd_field_rigid (M : Type u) [Field M] (T : Scheme.{u}) (hT : Nonempty T)
    (v : T ⟶ Spec (CommRingCat.of M)) (σ : M →+* M)
    (h : v ≫ Spec.map (CommRingCat.ofHom σ) = v) : σ = RingHom.id M :=
by
  haveI : Nonempty (⊤ : T.Opens) := ⟨⟨Classical.choice hT, trivial⟩⟩
  haveI := Scheme.component_nontrivial T ⊤
  have key : CommRingCat.ofHom σ ≫ ((Scheme.ΓSpecIso (CommRingCat.of M)).inv ≫ v.appTop) =
      (Scheme.ΓSpecIso (CommRingCat.of M)).inv ≫ v.appTop := by
    rw [← Category.assoc, Scheme.ΓSpecIso_inv_naturality, Category.assoc,
      ← Scheme.Hom.comp_appTop, h]
  apply RingHom.ext
  intro x
  apply RingHom.injective ((Scheme.ΓSpecIso (CommRingCat.of M)).inv ≫ v.appTop).hom
  have hx := congrArg (fun f => f.hom x) key
  simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
    RingHom.id_apply] at hx ⊢
  exact hx

theorem wc_lfd_basechange_props (F : Type u) [Field F] [Finite F] (X : Over (Spec (CommRingCat.of F)))
    (A B : Type u) [Field A] [Field B] [Algebra F A] [Algebra F B] [FiniteDimensional F A]
    [FiniteDimensional F B] (σ : A →ₐ[F] B)
    (m : Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F B))) ⟶
      Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F A))))
    (hm1 : m ≫ Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F A))) =
      Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F B))))
    (hm2 : m ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F A))) =
      Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F B))) ≫
        Spec.map (CommRingCat.ofHom σ.toRingHom)) :
    Function.Surjective m ∧ Etale m ∧ IsAffineHom m :=
by
  have hcomp : Spec.map (CommRingCat.ofHom σ.toRingHom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap F A)) =
      Spec.map (CommRingCat.ofHom (algebraMap F B)) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.toRingHom_eq_coe,
      AlgHom.comp_algebraMap]
  have hout : IsPullback (m ≫ Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F A))))
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F B)))) X.hom
      (Spec.map (CommRingCat.ofHom σ.toRingHom) ≫
        Spec.map (CommRingCat.ofHom (algebraMap F A))) := by
    rw [hm1, hcomp]
    exact IsPullback.of_hasPullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F B)))
  have hsq := (IsPullback.of_right hout hm2 (IsPullback.of_hasPullback X.hom _)).flip
  haveI : Finite A := Module.finite_of_finite F
  haveI : Finite B := Module.finite_of_finite F
  have hEt : Etale (Spec.map (CommRingCat.ofHom σ.toRingHom)) := by
    letI : Algebra A B := σ.toRingHom.toAlgebra
    haveI : Algebra.Etale A B := ⟨Algebra.FormallyEtale.of_isSeparable A B,
      Algebra.FinitePresentation.of_finiteType.mp inferInstance⟩
    exact (HasRingHomProperty.Spec_iff (P := @Etale)
      (φ := CommRingCat.ofHom σ.toRingHom)).mpr (RingHom.etale_algebraMap.mpr this)
  have hSurj : Surjective (Spec.map (CommRingCat.ofHom σ.toRingHom)) :=
    (surjective_iff _).mpr (fun _ => ⟨Classical.arbitrary _, Subsingleton.elim _ _⟩)
  have hAff : IsAffineHom (Spec.map (CommRingCat.ofHom σ.toRingHom)) := inferInstance
  have h1 : Surjective m := MorphismProperty.of_isPullback (P := @Surjective) hsq hSurj
  have h2 : Etale m := MorphismProperty.of_isPullback (P := @Etale) hsq hEt
  have h3 : IsAffineHom m := MorphismProperty.of_isPullback (P := @IsAffineHom) hsq hAff
  exact ⟨h1.surj, h2, h3⟩

theorem wc_lfd_proper_field_qcqs (A : Type u) [Field A] (Y : Scheme.{u}) (p : Y ⟶ Spec (.of A)) [IsProper p] :
    CompactSpace Y ∧ QuasiSeparatedSpace Y ∧
      ∀ (Z : Scheme.{u}) (f : Z ⟶ Y), IsOpenImmersion f → CompactSpace Z :=
by
  haveI hc : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace p
  refine ⟨hc, quasiSeparatedSpace_of_quasiSeparated p, fun Z f hf => ?_⟩
  haveI := hf
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian p
  haveI : AlgebraicGeometry.IsNoetherian Y := AlgebraicGeometry.IsNoetherian.mk
  have h1 : IsCompact (Set.range f) := TopologicalSpace.NoetherianSpace.isCompact _
  rw [← Set.image_univ, ← f.isOpenEmbedding.isInducing.isCompact_iff] at h1
  exact isCompact_univ_iff.mp h1

theorem wc_lfd_tower (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    [GeometricallyIrreducible X.hom] [IsProper X.hom]
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (E : Type u) [Field E] [Algebra F E] [FiniteDimensional F E]
    (hU : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E)))))
    (s₀ : wcGeomPoint F X h ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt))
    (τ : E →ₐ[F] AlgebraicClosure F)
    (hτ : s₀.left ≫ Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F E))) =
        Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          Spec.map (CommRingCat.ofHom τ.toRingHom))
    (VE : X.left.ProEt) (ιE : VE ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt))
    (hιE : IsOpenImmersion ιE.left)
    (t : ℕ → (wcGeomPoint F X h ⟶ wcGeomPoint F X h)) (ht0 : t 0 = 𝟙 _)
    (hts : ∀ j, t (j + 1) = wcGeomFrob F X h ≫ t j) :
    ∃ (D : ℕᵒᵖ ⥤ X.left.ProEt) (a : ∀ k, wcGeomPoint F X h ⟶ D.obj (Opposite.op k))
      (b : ∀ k, D.obj (Opposite.op k) ⟶ (MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F E)))) hU : X.left.ProEt))
      (g : ∀ k, D.obj (Opposite.op k) ⟶ D.obj (Opposite.op k))
      (V : ℕ → X.left.ProEt) (ι : ∀ k, V k ⟶ D.obj (Opposite.op k)),
      (∀ k, a k ≫ b k = s₀) ∧
      (∀ k, t (Module.finrank F E) ≫ a k = a k ≫ g k) ∧
      (∀ k j, a (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op = a k) ∧
      (∀ k j, D.map (homOfLE (Nat.le_add_right k j)).op ≫ b k = b (k + j)) ∧
      (∀ k j, g (k + j) ≫ D.map (homOfLE (Nat.le_add_right k j)).op =
        D.map (homOfLE (Nat.le_add_right k j)).op ≫ g k) ∧
      (∀ k, wcLfdIter (g k) (k + 1).factorial = 𝟙 _) ∧
      (∀ k, g k ≫ b k = b k) ∧
      (∀ k, Function.Surjective (b k).left) ∧
      (∀ k, Etale (b k).left) ∧
      (∀ k (T : Scheme.{u}) (u₁ u₂ : T ⟶ (D.obj (Opposite.op k)).left),
        u₁ ≫ (b k).left = u₂ ≫ (b k).left →
        ∃ O : Fin (k + 1).factorial → T.Opens, (∀ z : T, ∃! j, z ∈ O j) ∧
          ∀ j, (O j).ι ≫ u₂ = (O j).ι ≫ u₁ ≫ (wcLfdIter (g k) (j : ℕ)).left) ∧
      (∀ k (T : Scheme.{u}) (u : T ⟶ (D.obj (Opposite.op k)).left) (j : ℕ), 0 < j →
        j < (k + 1).factorial → Nonempty T → u ≫ (wcLfdIter (g k) j).left ≠ u) ∧
      (∀ k, IsOpenImmersion (ι k).left) ∧
      (∀ k, Set.range (ι k).left = (b k).left ⁻¹' Set.range ιE.left) ∧
      (∀ k, CompactSpace (V k).left) ∧
      (∀ (T : Scheme.{u}) (z : ∀ k, T ⟶ (D.obj (Opposite.op k)).left),
        (∀ k j, z (k + j) ≫ (D.map (homOfLE (Nat.le_add_right k j)).op).left = z k) →
        ∃! z₀ : T ⟶ (wcGeomPoint F X h).left, ∀ k, z₀ ≫ (a k).left = z k) ∧
      (∀ k, CompactSpace (D.obj (Opposite.op k)).left ∧
        QuasiSeparatedSpace (D.obj (Opposite.op k)).left) ∧
      (∀ k j, IsAffineHom (D.map (homOfLE (Nat.le_add_right k j)).op).left) :=
by
  classical
  let Fr : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F :=
    @FiniteField.frobeniusAlgEquivOfAlgebraic F _ (Fintype.ofFinite F) (AlgebraicClosure F) _ _ _
  obtain ⟨L, hLfin, hLτ, hLmono, hLcov, hLγ, hLN, hLfree⟩ := wc_lfd_field_levels F E τ
  obtain ⟨hF1, hF2⟩ := wc_lfd_frob_fixed_field F E τ
  have hfinL : ∀ k, Finite (L k) := hLfin
  have hfdL : ∀ k, FiniteDimensional F (L k) := fun k =>
    @Module.Finite.of_finite F (L k) _ _ _ (hLfin k)
  have hle : ∀ {k m : ℕ}, k ≤ m → L k ≤ L m := by
    intro k m hkm
    obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hkm
    exact hLmono k j
  let τk : ∀ k, E →ₐ[F] L k := fun k => τ.codRestrict (L k).toSubalgebra (hLτ k)
  let γk : ∀ k, L k →ₐ[F] L k := fun k =>
    (((Fr.symm ^ Module.finrank F E : AlgebraicClosure F ≃ₐ[F] AlgebraicClosure F) :
      AlgebraicClosure F →ₐ[F] AlgebraicClosure F).comp (L k).val).codRestrict (L k).toSubalgebra
      (fun y => hLγ k y y.2)

  have hPmF : ∀ {A B : Type u} {iA : Field A} {iB : Field B} {jA : Algebra F A} {jB : Algebra F B}
      (σ : A →ₐ[F] B), wcLfdTowPm F X σ ≫
        Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F A))) =
        Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F B))) := by
    intro A B iA iB jA jB σ
    exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have hPmS : ∀ {A B : Type u} {iA : Field A} {iB : Field B} {jA : Algebra F A} {jB : Algebra F B}
      (σ : A →ₐ[F] B), wcLfdTowPm F X σ ≫
        Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F A))) =
        Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F B))) ≫
          Spec.map (CommRingCat.ofHom σ.toRingHom) := by
    intro A B iA iB jA jB σ
    exact Limits.pullback.lift_snd _ _ _
  have hComp : ∀ {A B C : Type u} {iA : Field A} {iB : Field B} {iC : Field C} {jA : Algebra F A}
      {jB : Algebra F B} {jC : Algebra F C} (σ₁ : A →ₐ[F] B) (σ₂ : B →ₐ[F] C),
      wcLfdTowPm F X σ₂ ≫ wcLfdTowPm F X σ₁ = wcLfdTowPm F X (σ₂.comp σ₁) := by
    intro A B C iA iB iC jA jB jC σ₁ σ₂
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hPmF, hPmF, hPmF]
    · rw [hPmS (σ₂.comp σ₁), Category.assoc, hPmS σ₁, ← Category.assoc, hPmS σ₂, Category.assoc,
        ← Spec.map_comp] <;> rfl
  have hId : ∀ {A : Type u} {iA : Field A} {jA : Algebra F A},
      wcLfdTowPm F X (AlgHom.id F A) = 𝟙 _ := by
    intro A iA jA
    apply Limits.pullback.hom_ext
    · rw [hPmF, Category.id_comp]
    · rw [hPmS, Category.id_comp]
      show _ ≫ Spec.map (CommRingCat.ofHom (RingHom.id A)) = _
      rw [CommRingCat.ofHom_id, Spec.map_id, Category.comp_id]
  have hinclId : ∀ k (hk : L k ≤ L k), IntermediateField.inclusion hk = AlgHom.id F (L k) := by
    intro k hk; apply AlgHom.ext; intro y; rfl
  have hinclComp : ∀ {k m n : ℕ} (h1 : L k ≤ L m) (h2 : L m ≤ L n),
      (IntermediateField.inclusion h2).comp (IntermediateField.inclusion h1) =
        IntermediateField.inclusion (h1.trans h2) := by
    intro k m n h1 h2; apply AlgHom.ext; intro y; rfl
  have hWE : ∀ (E' : Type u) [Field E'] [Algebra F E'] [FiniteDimensional F E'],
      WeaklyEtale (Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F E')))) := by
    intro E' _ _ _
    have : Algebra.FormallyEtale F E' := Algebra.FormallyEtale.of_isSeparable F E'
    have : Algebra.FinitePresentation F E' :=
      Algebra.FinitePresentation.of_finiteType.mp inferInstance
    have : Algebra.Etale F E' := ⟨inferInstance, inferInstance⟩
    have he : Etale (Spec.map (CommRingCat.ofHom (algebraMap F E'))) := by
      rw [HasRingHomProperty.Spec_iff (P := @Etale)]
      exact RingHom.etale_algebraMap.mpr inferInstance
    exact etale_le_weaklyEtale _ _ _
      (MorphismProperty.of_isPullback (P := @Etale) (IsPullback.of_hasPullback X.hom _).flip he)

  have G1 : ∀ {T Q Q' S : Scheme.{u}} (z' : T ⟶ Q) (z0 : T ⟶ Q') (m : Q ⟶ Q') (f : Q ⟶ S)
      (f' : Q' ⟶ S), m ≫ f' = f → z' ≫ m = z0 → z' ≫ f = z0 ≫ f' := by
    intro T Q Q' S z' z0 m f f' hm hz
    rw [← hm, ← Category.assoc, hz]
  have G2 : ∀ {T Q Q' S S' : Scheme.{u}} (z' : T ⟶ Q) (z0 : T ⟶ Q') (m : Q ⟶ Q') (s : Q ⟶ S)
      (s' : Q' ⟶ S') (σ : S ⟶ S'), m ≫ s' = s ≫ σ → z' ≫ m = z0 → (z' ≫ s) ≫ σ = z0 ≫ s' := by
    intro T Q Q' S S' z' z0 m s s' σ hm hz
    rw [Category.assoc, ← hm, ← Category.assoc, hz]
  have G3F : ∀ {P Q R S : Scheme.{u}} (u₁ u₂ : P ⟶ Q) (m : Q ⟶ R) (f : Q ⟶ S) (f' : R ⟶ S),
      m ≫ f' = f → u₁ ≫ m = u₂ ≫ m → u₁ ≫ f = u₂ ≫ f := by
    intro P Q R S u₁ u₂ m f f' hm hu
    rw [← hm, ← Category.assoc, hu, Category.assoc]
  have G3 : ∀ {P Q R S S' : Scheme.{u}} (u₁ u₂ : P ⟶ Q) (m : Q ⟶ R) (s : Q ⟶ S) (s' : R ⟶ S')
      (σ : S ⟶ S'), m ≫ s' = s ≫ σ → u₁ ≫ m = u₂ ≫ m → (u₁ ≫ s) ≫ σ = (u₂ ≫ s) ≫ σ := by
    intro P Q R S S' u₁ u₂ m s s' σ hm hu
    rw [Category.assoc, Category.assoc, ← hm, ← Category.assoc, hu, Category.assoc]
  have G4 : ∀ {P Q S : Scheme.{u}} (u : P ⟶ Q) (m : Q ⟶ Q) (s : Q ⟶ S) (σ : S ⟶ S),
      m ≫ s = s ≫ σ → u ≫ m = u → (u ≫ s) ≫ σ = u ≫ s := by
    intro P Q S u m s σ hm hu
    rw [Category.assoc, ← hm, ← Category.assoc, hu]
  have G6 : ∀ {T Q Y S1 S2 B : Scheme.{u}} (z0 : T ⟶ Q) (f : Q ⟶ Y) (s : Q ⟶ S1) (w : T ⟶ S2)
      (v : S2 ⟶ S1) (a1 : S1 ⟶ B) (a2 : S2 ⟶ B) (g : Y ⟶ B),
      f ≫ g = s ≫ a1 → w ≫ v = z0 ≫ s → v ≫ a1 = a2 → (z0 ≫ f) ≫ g = w ≫ a2 := by
    intro T Q Y S1 S2 B z0 f s w v a1 a2 g hfg hw hva
    rw [Category.assoc, hfg, ← Category.assoc, ← hw, Category.assoc, hva]
  have H1 : ∀ {W P Q Y : Scheme.{u}} (ιO : W ⟶ P) (u₁ u₂ : P ⟶ Q) (m : Q ⟶ Q) (f : Q ⟶ Y),
      m ≫ f = f → u₁ ≫ f = u₂ ≫ f → (ιO ≫ u₂) ≫ f = (ιO ≫ u₁ ≫ m) ≫ f := by
    intro W P Q Y ιO u₁ u₂ m f hm hu
    simp only [Category.assoc, hm, hu]
  have H2 : ∀ {W P Q S : Scheme.{u}} (ιO : W ⟶ P) (u₁ u₂ : P ⟶ Q) (m : Q ⟶ Q) (s : Q ⟶ S)
      (σ σ' : S ⟶ S), m ≫ s = s ≫ σ → σ' = σ → ιO ≫ u₂ ≫ s = ιO ≫ (u₁ ≫ s) ≫ σ' →
      (ιO ≫ u₂) ≫ s = (ιO ≫ u₁ ≫ m) ≫ s := by
    intro W P Q S ιO u₁ u₂ m s σ σ' hm hσ hO
    subst hσ
    simp only [Category.assoc, hm] at hO ⊢
    exact hO

  let Dk : ℕ → X.left.ProEt := fun k =>
    MorphismProperty.Over.mk ⊤ (Limits.pullback.fst X.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (L k))))) (hWE (L k))
  let D : ℕᵒᵖ ⥤ X.left.ProEt :=
    { obj := fun n => Dk n.unop
