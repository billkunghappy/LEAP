      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))) =
      Spec.map (CommRingCat.ofHom σ) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, MvPolynomial.algebraMap_eq, hιC]

  obtain ⟨e₀, he₀iso, he₀⟩ := wc_spec_generic_geom_point_iso K Ω T ι hinj halg
  haveI := he₀iso
  have hγ : wcEtGeomPt (Spec (.of (MvPolynomial T K))) (genericPoint (Spec (.of (MvPolynomial T K)))) =
      inv e₀ ≫ Spec.map (CommRingCat.ofHom ι) := by
    rw [← he₀, IsIso.inv_hom_id_assoc]

  have w : (Limits.pullback.fst
        (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K)))))
        (wcEtGeomPt (Spec (.of (MvPolynomial T K))) (genericPoint (Spec (.of (MvPolynomial T K))))) ≫
      Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))))) ≫ g =
      (Limits.pullback.snd
        (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K)))))
        (wcEtGeomPt (Spec (.of (MvPolynomial T K))) (genericPoint (Spec (.of (MvPolynomial T K))))) ≫
        inv e₀) ≫ Spec.map (CommRingCat.ofHom σ) := by
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, Limits.pullback.condition,
      Category.assoc, hγ, ← hσ]
    simp only [Category.assoc]
  obtain ⟨Dpr⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))))) m
  obtain ⟨D1⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst
        (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K)))))
        (wcEtGeomPt (Spec (.of (MvPolynomial T K))) (genericPoint (Spec (.of (MvPolynomial T K)))))) m
  obtain ⟨Dk⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst
        (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K)))))
        (wcEtGeomPt (Spec (.of (MvPolynomial T K))) (genericPoint (Spec (.of (MvPolynomial T K))))) ≫
      Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))))) m
  obtain ⟨Dh⟩ := wc_et_zmod_pull_data_exists (hP.lift _ _ w) m
  have hk1 := wc_et_pull_comp ρ (hP.lift _ _ w) _ (hP.lift_fst _ _ w) D Dh Dk q x
  have hk2 := wc_et_pull_comp _ _ _ rfl Dpr D1 Dk q x
  have hdie : wcEtPull D1 q (wcEtPull Dpr q x) = 0 := by
    rw [← hk2, hk1, hx, map_zero]

  obtain ⟨V, v, hv, hkill⟩ := wc_et_proper_geom_point_kill_spreads
    (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K)))))
    (genericPoint (Spec (.of (MvPolynomial T K)))) m hm q (wcEtPull Dpr q x) D1 hdie
  obtain ⟨Ds⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd V.hom
    (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K)))))) m
  obtain ⟨Dc⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd V.hom
    (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))))) ≫
      Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))))) m
  have hc : wcEtPull Dc q x = 0 := by
    rw [wc_et_pull_comp _ _ _ rfl Dpr Ds Dc q x]
    exact hkill Ds

  have H : ∀ (B' : Type u) [CommRing B'] (φ : MvPolynomial T K →+* B'), φ.Etale →
      ∀ (𝔭 : Ideal B'), 𝔭.IsPrime → Ideal.comap φ 𝔭 = ⊥ → ∃ (𝔮 : Ideal B') (a : T → K),
        𝔮.IsPrime ∧ 𝔭 ≤ 𝔮 ∧ Ideal.comap φ 𝔮 = RingHom.ker (MvPolynomial.aeval a).toRingHom := by
    intro B' _ φ hφ 𝔭 h𝔭 h0
    obtain ⟨hFT, halg'⟩ := wc_etale_generic_fibre_quotient_algebraic (MvPolynomial T K) B' φ hφ 𝔭 h𝔭 h0
    exact wc_poly_domain_algebraic_prime_over_rational K T B' φ 𝔭 h𝔭 h0 hFT halg'
  obtain ⟨w', a, -, hw⟩ := wc_etale_poly_generic_closure_rational_of_alg K T H V v hv
  haveI : Etale V.hom := V.prop
  obtain ⟨tK, htK, -⟩ := wc_etale_lift_alg_closed_point K V.hom
    (Spec.map (CommRingCat.ofHom (MvPolynomial.aeval a).toRingHom)) w' hw
  have hid : (MvPolynomial.aeval a).toRingHom.comp (algebraMap K (MvPolynomial T K)) = RingHom.id K := by
    ext k
    simp
  have hsec : tK ≫ V.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))) = 𝟙 _ := by
    rw [← Category.assoc, htK, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hid, CommRingCat.ofHom_id,
      Spec.map_id]

  have c₁ : 𝟙 Z ≫ g = (g ≫ tK ≫ V.hom) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))) := by
    simp only [Category.id_comp, Category.assoc, hsec, Category.comp_id]
  have c₂ : (g ≫ tK) ≫ V.hom = Limits.pullback.lift (𝟙 Z) (g ≫ tK ≫ V.hom) c₁ ≫
      Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K)))) := by
    rw [Limits.pullback.lift_snd, Category.assoc]
  have hσZ : Limits.pullback.lift (g ≫ tK) (Limits.pullback.lift (𝟙 Z) (g ≫ tK ≫ V.hom) c₁) c₂ ≫
      (Limits.pullback.snd V.hom
        (Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))))) ≫
      Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial T K))))) = 𝟙 Z := by
    rw [Limits.pullback.lift_snd_assoc, Limits.pullback.lift_fst]
  obtain ⟨DσZ⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.lift (g ≫ tK) (Limits.pullback.lift (𝟙 Z) (g ≫ tK ≫ V.hom) c₁) c₂) m
  obtain ⟨Did⟩ := wc_et_zmod_pull_data_exists (𝟙 Z) m
  have hfin := wc_et_pull_comp _ _ _ hσZ Dc DσZ Did q x
  apply wc_et_pull_id_injective Did q x
  rw [hfin, hc, map_zero]

theorem wc_et_sepclosed_field_ext_proper_pull_bij : ∀ (k L : Type u) [Field k] [Field L] [IsSepClosed k] [IsSepClosed L] (e : k →+* L) (Y : Scheme.{u}) (f : Y ⟶ Spec (.of k)) [IsProper f] (P : Scheme.{u}) (π : P ⟶ Y) (p : P ⟶ Spec (.of L)), IsPullback π p f (Spec.map (CommRingCat.ofHom e)) → ∀ (m : ℕ), (m : k) ≠ 0 → ∀ (D : wcEtPullData π m) (q : ℕ), Function.Bijective (wcEtPull D q) :=
by
  intro k L _ _ _ _ e Y f _ P π p hP m hm D q
  classical

  have hm0 : m ≠ 0 := by
    rintro rfl
    exact hm Nat.cast_zero
  have hmk : ((m : ℕ) : AlgebraicClosure k) ≠ 0 := by
    rw [← map_natCast (algebraMap k (AlgebraicClosure k))]
    exact (map_ne_zero _).mpr hm

  obtain ⟨ε, hε⟩ : ∃ ε : AlgebraicClosure k →+* AlgebraicClosure L,
      ε.comp (algebraMap k (AlgebraicClosure k)) = (algebraMap L (AlgebraicClosure L)).comp e := by
    letI : Algebra k (AlgebraicClosure L) := ((algebraMap L (AlgebraicClosure L)).comp e).toAlgebra
    exact ⟨(IsAlgClosed.lift (M := AlgebraicClosure L) (R := k) (S := AlgebraicClosure k) :
      AlgebraicClosure k →+* AlgebraicClosure L), (AlgHom.comp_algebraMap _).trans rfl⟩
  have hSpec : Spec.map (CommRingCat.ofHom ε) ≫
        Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))) =
      Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) ≫
        Spec.map (CommRingCat.ofHom e) := by
    rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hε]

  have w : (Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L)))) ≫ π) ≫ f =
      (Limits.pullback.snd p (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L)))) ≫
        Spec.map (CommRingCat.ofHom ε)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))) := by
    rw [Category.assoc, hP.w, ← Category.assoc, Limits.pullback.condition]
    simp only [Category.assoc, hSpec]
  obtain ⟨ρ, hρ1, hρ2⟩ : ∃ ρ : Limits.pullback p (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L)))) ⟶
      Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))),
      ρ ≫ Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) =
        Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L)))) ≫ π ∧
      ρ ≫ Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))) =
        Limits.pullback.snd p (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L)))) ≫
          Spec.map (CommRingCat.ofHom ε) :=
    ⟨Limits.pullback.lift _ _ w, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hsq : IsPullback ρ
      (Limits.pullback.snd p (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L)))))
      (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))))
      (Spec.map (CommRingCat.ofHom ε)) := by
    have hout := (IsPullback.of_hasPullback p
      (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))).paste_horiz hP
    rw [← hSpec, ← hρ1] at hout
    exact IsPullback.of_right hout hρ2 (IsPullback.of_hasPullback _ _)

  obtain ⟨D1⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) m
  obtain ⟨D2⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))) m
  obtain ⟨Dρ⟩ := wc_et_zmod_pull_data_exists ρ m
  obtain ⟨Dc⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst p (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L)))) ≫ π) m

  have hb1 : Function.Bijective (wcEtPull D1 q) :=
    wc_r2gs_integral_field_ext_pull_bij k (AlgebraicClosure k) (algebraMap k (AlgebraicClosure k))
      (algebraMap_isIntegral_iff.mpr inferInstance) Y f _ _ _ (IsPullback.of_hasPullback _ _) m hm0 D1 q
  have hb2 : Function.Bijective (wcEtPull D2 q) :=
    wc_r2gs_integral_field_ext_pull_bij L (AlgebraicClosure L) (algebraMap L (AlgebraicClosure L))
      (algebraMap_isIntegral_iff.mpr inferInstance) P p _ _ _ (IsPullback.of_hasPullback _ _) m hm0 D2 q

  have hinj : Function.Injective (wcEtPull Dρ q) :=
    wc_et_alg_closed_field_ext_proper_pull_injective (AlgebraicClosure k) (AlgebraicClosure L) ε _
      (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) _ ρ _
      hsq m hm0 Dρ q
  obtain ⟨EY⟩ := wc_et_zmodext_coh_equiv
    (Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) m q
  obtain ⟨EP⟩ := wc_et_zmodext_coh_equiv
    (Limits.pullback p (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))) m q
  haveI := wc_etale_proper_finite (AlgebraicClosure k) _
    (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) m hmk q
  haveI hfinY : Finite (wcEtZModExt
      (Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) m q) :=
    Finite.of_equiv _ EY.symm
  obtain ⟨C⟩ := wc_et_coh_iso_invariance hsq.isoPullback.hom m q
  have hcard := wc_et_alg_closed_field_invariance_card (AlgebraicClosure k) _
    (Limits.pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k)))))
    (AlgebraicClosure L) (Spec.map (CommRingCat.ofHom ε)) m hmk q
  have hcardeq : Nat.card (wcEtZModExt
      (Limits.pullback p (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))) m q) =
      Nat.card (wcEtZModExt
        (Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) m q) := by
    rw [Nat.card_congr EP, ← Nat.card_congr C, hcard, Nat.card_congr EY]
  have hpos : 0 < Nat.card (wcEtZModExt
      (Limits.pullback f (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))))) m q) :=
    Nat.card_pos
  haveI : Finite (wcEtZModExt
      (Limits.pullback p (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))) m q) :=
    Nat.finite_of_card_ne_zero (by omega)
  have hbρ : Function.Bijective (wcEtPull Dρ q) := hinj.bijective_of_nat_card_le hcardeq.le

  have hc1 : ∀ x, wcEtPull Dc q x = wcEtPull D2 q (wcEtPull D q x) := fun x =>
    wc_et_pull_comp π _ _ rfl D D2 Dc q x
  have hc2 : ∀ x, wcEtPull Dc q x = wcEtPull Dρ q (wcEtPull D1 q x) := fun x =>
    wc_et_pull_comp _ ρ _ hρ1 D1 Dρ Dc q x
  have hcomp : (wcEtPull D2 q) ∘ (wcEtPull D q) = (wcEtPull Dρ q) ∘ (wcEtPull D1 q) := by
    funext x
    show wcEtPull D2 q (wcEtPull D q x) = wcEtPull Dρ q (wcEtPull D1 q x)
    rw [← hc1, hc2]
  refine (Function.Bijective.of_comp_iff' hb2 (wcEtPull D q)).mp ?_
  rw [hcomp]
  exact hbρ.comp hb1

theorem wc_zmod_proper_strict_henselian_base_pull_bij {K : Type u} [Field K] [IsSepClosed K]
    {Y P : Scheme.{u}} (f : Y ⟶ Spec (.of K)) [IsProper f] (R : CommRingCat.{u}) [HenselianLocalRing R]
    [IsSepClosed (IsLocalRing.ResidueField R)] (s : Spec R ⟶ Spec (.of K)) (q : P ⟶ Y)
    (t : P ⟶ Spec R) (hP : IsPullback q t f s) (n : ℕ) (hn : (n : K) ≠ 0)
    (D : wcZModPullData q n) (hD : wcZModPullCanonical D) (j : ℕ) :
    Function.Bijective (wcZModPull D j) :=
by
  classical

  have hn0 : n ≠ 0 := by
    rintro rfl
    exact hn Nat.cast_zero
  have hnpos : 0 < n := Nat.pos_of_ne_zero hn0
  haveI ht : IsProper t := MorphismProperty.of_isPullback (P := @IsProper) hP inferInstance
  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
  haveI : QuasiSeparatedSpace Y := quasiSeparatedSpace_of_quasiSeparated f
  haveI : CompactSpace P := QuasiCompact.compactSpace_of_compactSpace t
  haveI : QuasiSeparatedSpace P := quasiSeparatedSpace_of_quasiSeparated t

  have hPB0 := IsPullback.of_hasPullback t
    (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))
  obtain ⟨Di⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst t (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) n
  obtain ⟨E⟩ := wc_et_zmod_pull_data_exists q n
  obtain ⟨Dc⟩ := wc_et_zmod_pull_data_exists
    (Limits.pullback.fst t (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) ≫ q) n
  have hi : Function.Bijective (wcEtPull Di j) :=
    wc_r2gs_hens_closed_fibre_pull_bij R P t n hn0 wc_et_henselian_proper_vanishing _ _ _
      hPB0 Di j

  have hse : Spec.map (CommRingCat.ofHom ((IsLocalRing.residue R).comp (Spec.preimage s).hom)) =
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) ≫ s := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom, Spec.map_preimage]
  have hsq : IsPullback
      (Limits.pullback.fst t (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) ≫ q)
      (Limits.pullback.snd t (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) f
      (Spec.map (CommRingCat.ofHom ((IsLocalRing.residue R).comp (Spec.preimage s).hom))) := by
    rw [hse]
    exact hPB0.paste_horiz hP
  have hc : Function.Bijective (wcEtPull Dc j) :=
    wc_et_sepclosed_field_ext_proper_pull_bij K (IsLocalRing.ResidueField R)
      ((IsLocalRing.residue R).comp (Spec.preimage s).hom) Y f _ _ _ hsq n hn Dc j

  have hq : Function.Bijective (wcEtPull E j) := by
    refine (Function.Bijective.of_comp_iff' hi _).mp ?_
    convert hc using 1
    funext x
    exact (wc_et_pull_comp q _ _ rfl E Di Dc j x).symm

  exact wc_zmod_proet_pull_bij_of_et_pull_bij q n hnpos D hD E j hq

theorem wc_zmod_pull_comp {S S' S'' : Scheme.{u}} {n : ℕ} (f : S' ⟶ S) (g : S'' ⟶ S') (k : S'' ⟶ S)
    (hk : g ≫ f = k) (Df : wcZModPullData f n) (hDf : wcZModPullCanonical Df)
    (Dg : wcZModPullData g n) (hDg : wcZModPullCanonical Dg)
    (Dk : wcZModPullData k n) (hDk : wcZModPullCanonical Dk) (i : ℕ) (x : wcZModProEtExt S n i) :
    wcZModPull Dk i x = wcZModPull Dg i (wcZModPull Df i x) :=
by
  classical
  subst hk

  have hmap : ∀ {A B : Scheme.{u}} (h : A ⟶ B) {V V' : B.ProEt} (u : V ⟶ V'),
      ((wcProEtBC h).map u).left ≫ Limits.pullback.fst V'.hom h =
        Limits.pullback.fst V.hom h ≫ u.left ∧
      ((wcProEtBC h).map u).left ≫ Limits.pullback.snd V'.hom h = Limits.pullback.snd V.hom h := by
    intro A B h V V' u
    exact ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hsnd : ∀ V : S.ProEt, (Limits.pullbackLeftPullbackSndIso V.hom f g).symm.hom ≫
      Limits.pullback.snd (Limits.pullback.snd V.hom f) g = Limits.pullback.snd V.hom (g ≫ f) := by
    intro V
    rw [Iso.symm_hom, Iso.inv_comp_eq, Limits.pullbackLeftPullbackSndIso_hom_snd]
  choose c hc using fun V : S.ProEt =>
    (⟨MorphismProperty.Over.isoMk (A := (wcProEtBC (g ≫ f)).obj V)
        (B := (wcProEtBC f ⋙ wcProEtBC g).obj V)
        (Limits.pullbackLeftPullbackSndIso V.hom f g).symm (hsnd V),
      MorphismProperty.Over.isoMk_hom_left _ _⟩ :
      ∃ c : (wcProEtBC (g ≫ f)).obj V ≅ (wcProEtBC f ⋙ wcProEtBC g).obj V,
        c.hom.left = (Limits.pullbackLeftPullbackSndIso V.hom f g).inv)
  have nat : ∀ {V V' : S.ProEt} (u : V ⟶ V'),
      (wcProEtBC (g ≫ f)).map u ≫ (c V').hom = (c V).hom ≫ (wcProEtBC f ⋙ wcProEtBC g).map u := by
    intro V V' u
    have key : ∀ (L : Limits.pullback V.hom (g ≫ f) ⟶ Limits.pullback V'.hom (g ≫ f))
        (M1 : Limits.pullback V.hom f ⟶ Limits.pullback V'.hom f)
        (M2 : Limits.pullback (Limits.pullback.snd V.hom f) g ⟶
          Limits.pullback (Limits.pullback.snd V'.hom f) g),
        L ≫ Limits.pullback.fst V'.hom (g ≫ f) = Limits.pullback.fst V.hom (g ≫ f) ≫ u.left →
        L ≫ Limits.pullback.snd V'.hom (g ≫ f) = Limits.pullback.snd V.hom (g ≫ f) →
        M1 ≫ Limits.pullback.fst V'.hom f = Limits.pullback.fst V.hom f ≫ u.left →
        M1 ≫ Limits.pullback.snd V'.hom f = Limits.pullback.snd V.hom f →
        M2 ≫ Limits.pullback.fst (Limits.pullback.snd V'.hom f) g =
          Limits.pullback.fst (Limits.pullback.snd V.hom f) g ≫ M1 →
        M2 ≫ Limits.pullback.snd (Limits.pullback.snd V'.hom f) g =
          Limits.pullback.snd (Limits.pullback.snd V.hom f) g →
        L ≫ (Limits.pullbackLeftPullbackSndIso V'.hom f g).inv =
          (Limits.pullbackLeftPullbackSndIso V.hom f g).inv ≫ M2 := by
      intro L M1 M2 hL1 hL2 hM1 _ hM2 hM2'
      rw [Iso.comp_inv_eq, Category.assoc, Iso.eq_inv_comp]
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hL1, Category.assoc, Limits.pullbackLeftPullbackSndIso_hom_fst,
          reassoc_of% hM2, hM1, reassoc_of% (Limits.pullbackLeftPullbackSndIso_hom_fst V.hom f g)]
      · rw [Category.assoc, hL2, Limits.pullbackLeftPullbackSndIso_hom_snd, Category.assoc,
          Limits.pullbackLeftPullbackSndIso_hom_snd, hM2']
    apply MorphismProperty.Over.Hom.ext
    change ((wcProEtBC (g ≫ f)).map u).left ≫ (c V').hom.left =
      (c V).hom.left ≫ ((wcProEtBC g).map ((wcProEtBC f).map u)).left
    rw [hc V, hc V']
    exact key _ _ _ (hmap (g ≫ f) u).1 (hmap (g ≫ f) u).2 (hmap f u).1 (hmap f u).2
      (hmap g ((wcProEtBC f).map u)).1 (hmap g ((wcProEtBC f).map u)).2
  let α : wcProEtBC (g ≫ f) ≅ wcProEtBC f ⋙ wcProEtBC g := NatIso.ofComponents c nat
  have hα : ∀ (V : S.ProEt) (z : ↥((wcProEtBC (g ≫ f)).obj V).left),
      (Limits.pullback.fst V.hom f) ((Limits.pullback.fst (Limits.pullback.snd V.hom f) g)
        ((α.hom.app V).left z)) = (Limits.pullback.fst V.hom (g ≫ f)) z := by
    intro V z
    change (Limits.pullback.fst V.hom f) ((Limits.pullback.fst (Limits.pullback.snd V.hom f) g)
      ((c V).hom.left z)) = _
    rw [hc V]
    have key : ∀ z' : ↥(Limits.pullback V.hom (g ≫ f)),
        (Limits.pullback.fst V.hom f) ((Limits.pullback.fst (Limits.pullback.snd V.hom f) g)
          ((Limits.pullbackLeftPullbackSndIso V.hom f g).inv z')) =
        (Limits.pullback.fst V.hom (g ≫ f)) z' := by
      intro z'
      calc (Limits.pullback.fst V.hom f) ((Limits.pullback.fst (Limits.pullback.snd V.hom f) g)
            ((Limits.pullbackLeftPullbackSndIso V.hom f g).inv z'))
          = ((Limits.pullbackLeftPullbackSndIso V.hom f g).inv ≫
              Limits.pullback.fst (Limits.pullback.snd V.hom f) g ≫
                Limits.pullback.fst V.hom f) z' := rfl
        _ = (Limits.pullback.fst V.hom (g ≫ f)) z' := by
          rw [Limits.pullbackLeftPullbackSndIso_inv_fst]
    exact key z

  haveI := Df.cont
  haveI := Dg.cont
  haveI := Dk.cont
  haveI : (wcProEtBC f ⋙ wcProEtBC g).IsContinuous (Scheme.ProEt.topology S)
      (Scheme.ProEt.topology S'') :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S') _
  let τ := (Functor.sheafPushforwardContinuousNatTrans α.hom RingCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology S'')).app (wcZModRingSheaf S'' n)
  let φfg : wcZModRingSheaf S n ⟶ ((wcProEtBC f ⋙ wcProEtBC g).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.ProEt.topology S) (Scheme.ProEt.topology S'')).obj
        (wcZModRingSheaf S'' n) :=
    Df.φ ≫ ((wcProEtBC f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).map Dg.φ
  have hcompat : φfg ≫ τ = Dk.φ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    induction V using Opposite.rec with
    | op V =>
    apply RingCat.hom_ext
    apply RingHom.ext
    intro s
    rw [hDk V s]
    apply ContinuousMap.ext
    intro z
    refine (congrArg (fun h : C(↥(Limits.pullback (Limits.pullback.snd V.hom f) g),
        ULift.{u+1} (ZMod n)) => h ((α.hom.app V).left.base z))
      (hDg ((wcProEtBC f).obj V) ((Df.φ.hom.app (Opposite.op V)).hom s :
        C(↥(Limits.pullback V.hom f), ULift.{u+1} (ZMod n))))).trans ?_
    refine (congrArg (fun h : C(↥(Limits.pullback V.hom f), ULift.{u+1} (ZMod n)) =>
        h ((Limits.pullback.fst (Limits.pullback.snd V.hom f) g).base
          ((α.hom.app V).left.base z))) (hDf V s)).trans ?_
    let s' : C(↥V.left, ULift.{u+1} (ZMod n)) := s
    exact congrArg (fun p => s' p) (hα V z)
  let ι : SheafOfModules.pushforward Dg.φ ⋙ SheafOfModules.pushforward Df.φ ≅
      SheafOfModules.pushforward Dk.φ :=
    SheafOfModules.pushforwardComp Df.φ Dg.φ ≪≫
      SheafOfModules.pushforwardNatIso φfg α ≪≫ SheafOfModules.pushforwardCongr hcompat
  have θ : Dk.Φ ≅ Df.Φ ⋙ Dg.Φ := Dk.adj.leftAdjointUniq ((Df.adj.comp Dg.adj).ofNatIsoRight ι)

  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S' n)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S'' n)) := HasExt.standard _
  haveI := Df.additive
  haveI := Df.presLim
  haveI := Df.presColim
  haveI := Dg.additive
  haveI := Dg.presLim
  haveI := Dg.presColim
  haveI := Dk.additive
  haveI := Dk.presLim
  haveI := Dk.presColim
  have h2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcZModRingSheaf S'' n)} {a : ℕ}
      (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
      (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
        (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
    intro A B C' D' a f g z
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h3 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcZModRingSheaf S'' n)} {a : ℕ}
      (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
      (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
    intro A B C' D' a z f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have h4 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcZModRingSheaf S'' n)} {a : ℕ}
      (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
      ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
        (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
    intro A B C' D' a f z g
    exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _

  have central : ∀ (e : SheafOfModules.unit (wcZModRingSheaf S'' n) ⟶
      SheafOfModules.unit (wcZModRingSheaf S'' n)) (y : wcZModProEtExt S'' n i),
      (Abelian.Ext.mk₀ e).comp y (zero_add i) = y.comp (Abelian.Ext.mk₀ e) (add_zero i) := by
    intro e y
    have hcomm : ∀ (X : (S''.ProEt)ᵒᵖ) (a b : (wcZModRingSheaf S'' n).obj.obj X),
        a * b = b * a := by
      intro X a b
      exact @mul_comm C(↥(Opposite.unop X).left, ULift.{u+1} (ZMod n)) _ a b
    have hext : ∃ m : 𝟭 (SheafOfModules.{u+1} (wcZModRingSheaf S'' n)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcZModRingSheaf S'' n)),
        m.app (SheafOfModules.unit (wcZModRingSheaf S'' n)) = e := by
      let R := wcZModRingSheaf S'' n
      let s := (SheafOfModules.unit R).unitHomEquiv e
      let σ : ∀ X : (S''.ProEt)ᵒᵖ, R.obj.obj X := fun X => (s.1 X : R.obj.obj X)
      have hσ : ∀ {X Y : (S''.ProEt)ᵒᵖ} (f : X ⟶ Y), (R.obj.map f).hom (σ X) = σ Y :=
        fun f => PresheafOfModules.sections_property s f
      let L : ∀ (M : SheafOfModules.{u+1} R) (X : (S''.ProEt)ᵒᵖ), M.val.obj X ⟶ M.val.obj X :=
        fun M X => ModuleCat.ofHom
          { toFun := fun x => σ X • x
            map_add' := fun x y => smul_add _ _ _
            map_smul' := fun r x => by
              simp only [RingHom.id_apply, smul_smul]
              rw [hcomm X] }
      let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
        ⟨PresheafOfModules.Hom.mk (L M) (by
          intro X Y f
          ext x
          show σ Y • (M.val.map f).hom x = (M.val.map f).hom (σ X • x)
          rw [PresheafOfModules.map_smul, hσ])⟩
      refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
      · intro M N g
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro X
        ext x
        show σ X • (g.val.app X).hom x = (g.val.app X).hom (σ X • x)
        exact ((g.val.app X).hom.map_smul _ _).symm
      · apply (SheafOfModules.unit R).unitHomEquiv.injective
        apply PresheafOfModules.sections_ext
        intro X
        rw [SheafOfModules.unitHomEquiv_apply_coe]
        show σ X • (1 : R.obj.obj X) = s.1 X
        rw [smul_eq_mul, mul_one]
    have hcen : ∀ (m : 𝟭 (SheafOfModules.{u+1} (wcZModRingSheaf S'' n)) ⟶
        𝟭 (SheafOfModules.{u+1} (wcZModRingSheaf S'' n))) (z : wcZModProEtExt S'' n i),
        (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcZModRingSheaf S'' n)))).comp z
            (zero_add i) =
          z.comp (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcZModRingSheaf S'' n))))
            (add_zero i) := by
      intro m z
      have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
      simp only [Abelian.Ext.id_mapExactFunctor] at h
      exact h.symm
    obtain ⟨m, hm⟩ := hext
    subst hm
    exact hcen m y
  have gen : ∀ {Y : SheafOfModules.{u+1} (wcZModRingSheaf S'' n)} (y : Abelian.Ext Y Y i)
      (a a' : SheafOfModules.unit (wcZModRingSheaf S'' n) ⟶ Y)
      (b b' : Y ⟶ SheafOfModules.unit (wcZModRingSheaf S'' n)),
      a ≫ b = 𝟙 _ → b' ≫ a' = 𝟙 _ →
      (Abelian.Ext.mk₀ a).comp (y.comp (Abelian.Ext.mk₀ b) (add_zero i)) (zero_add i) =
        (Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (add_zero i)) (zero_add i) := by
    intro Y y a a' b b' hab hba
    have ea : (a ≫ b') ≫ a' = a := by rw [Category.assoc, hba, Category.comp_id]
    have eb : b' ≫ a' ≫ b = b := by rw [← Category.assoc, hba, Category.id_comp]
    have eE : (a ≫ b') ≫ (a' ≫ b) = 𝟙 _ := by rw [← Category.assoc, ea, hab]
    have hc : (Abelian.Ext.mk₀ (a ≫ b')).comp ((Abelian.Ext.mk₀ a').comp
          (y.comp (Abelian.Ext.mk₀ b') (add_zero i)) (zero_add i)) (zero_add i) =
        ((Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (add_zero i)) (zero_add i)).comp
          (Abelian.Ext.mk₀ (a ≫ b')) (add_zero i) :=
      central _ _
    have e1 : (Abelian.Ext.mk₀ a).comp (y.comp (Abelian.Ext.mk₀ b) (add_zero i)) (zero_add i) =
        ((Abelian.Ext.mk₀ (a ≫ b')).comp ((Abelian.Ext.mk₀ a').comp
          (y.comp (Abelian.Ext.mk₀ b') (add_zero i)) (zero_add i)) (zero_add i)).comp
          (Abelian.Ext.mk₀ (a' ≫ b)) (add_zero i) := by
      rw [h2, h4, h3, ea, eb]
    rw [e1, hc, h3, eE, Abelian.Ext.comp_mk₀_id]
  show (Abelian.Ext.mk₀ Dk.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dk.Φ x).comp
      (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero i)) (zero_add i) =
    (Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ
      ((Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ x).comp
        (Abelian.Ext.mk₀ Df.μ.hom) (add_zero i)) (zero_add i))).comp
      (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero i)) (zero_add i)
  have nat' : (Abelian.Ext.mapExactFunctor Dk.Φ x).comp
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcZModRingSheaf S n)))) (add_zero i) =
      (Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcZModRingSheaf S n)))).comp
        (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Dg.Φ) x) (zero_add i) :=
    Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp x θ.hom
  have step1 : (Abelian.Ext.mapExactFunctor Dk.Φ x).comp (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero i) =
      ((Abelian.Ext.mk₀ (θ.hom.app (SheafOfModules.unit (wcZModRingSheaf S n)))).comp
        (Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Dg.Φ) x) (zero_add i)).comp
        (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcZModRingSheaf S n)) ≫ Dk.μ.hom))
        (add_zero i) := by
    rw [← nat', h3, Iso.hom_inv_id_app_assoc]
  have hL : (Abelian.Ext.mk₀ Dk.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dk.Φ x).comp
      (Abelian.Ext.mk₀ Dk.μ.hom) (add_zero i)) (zero_add i) =
      (Abelian.Ext.mk₀ (Dk.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcZModRingSheaf S n)))).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Dg.Φ) x).comp
          (Abelian.Ext.mk₀ (θ.inv.app (SheafOfModules.unit (wcZModRingSheaf S n)) ≫ Dk.μ.hom))
          (add_zero i)) (zero_add i) := by
    rw [step1, h4, h2]
  have hR : (Abelian.Ext.mk₀ Dg.μ.inv).comp ((Abelian.Ext.mapExactFunctor Dg.Φ
      ((Abelian.Ext.mk₀ Df.μ.inv).comp ((Abelian.Ext.mapExactFunctor Df.Φ x).comp
        (Abelian.Ext.mk₀ Df.μ.hom) (add_zero i)) (zero_add i))).comp
      (Abelian.Ext.mk₀ Dg.μ.hom) (add_zero i)) (zero_add i) =
      (Abelian.Ext.mk₀ (Dg.μ.inv ≫ Dg.Φ.map Df.μ.inv)).comp
        ((Abelian.Ext.mapExactFunctor (Df.Φ ⋙ Dg.Φ) x).comp
          (Abelian.Ext.mk₀ (Dg.Φ.map Df.μ.hom ≫ Dg.μ.hom)) (add_zero i)) (zero_add i) := by
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_mapExactFunctor, h4, h3, h2]
  rw [hL, hR]
  have hab : (Dk.μ.inv ≫ θ.hom.app (SheafOfModules.unit (wcZModRingSheaf S n))) ≫
      (θ.inv.app (SheafOfModules.unit (wcZModRingSheaf S n)) ≫ Dk.μ.hom) = 𝟙 _ := by
    rw [Category.assoc, Iso.hom_inv_id_app_assoc, Iso.inv_hom_id]
  have hba : (Dg.Φ.map Df.μ.hom ≫ Dg.μ.hom) ≫ (Dg.μ.inv ≫ Dg.Φ.map Df.μ.inv) =
      𝟙 (Dg.Φ.obj (Df.Φ.obj (SheafOfModules.unit (wcZModRingSheaf S n)))) := by
    rw [Category.assoc, Iso.hom_inv_id_assoc, ← CategoryTheory.Functor.map_comp, Iso.hom_inv_id,
      CategoryTheory.Functor.map_id]
  exact gen _ _ _ _ _ hab hba

theorem wc_wlocal_clopen_nbhd_in_open (X : Scheme.{u}) [IsAffine X]
    (hc : IsClosed {x : X | IsClosed ({x} : Set X)})
    (hu : ∀ x : X, ∃! y : X, IsClosed ({y} : Set X) ∧ x ⤳ y)
    (z : X) (hz : IsClosed ({z} : Set X)) (U : Set X) (hU : IsOpen U) (hzU : z ∈ U) :
    ∃ V : Set X, IsClopen V ∧ z ∈ V ∧ V ⊆ U :=
by
  classical

  have s3 : ∀ (A : Type u) [CommRing A], IsClosed {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} → (∀ x : PrimeSpectrum A, ∃! y : PrimeSpectrum A, IsClosed ({y} : Set (PrimeSpectrum A)) ∧ x ⤳ y) → ∀ U : Set {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, IsClopen U → ∃ e : A, e * e = e ∧ ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, (m ∈ U ↔ e ∉ m.1.asIdeal) := by
    intro A _ ha hb U hU
    have hclosed : ∀ V : Set {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))},
        IsClosed V → ∀ n : Ideal A, n.IsMaximal →
        PrimeSpectrum.vanishingIdeal (Subtype.val '' V) ≤ n → ∃ m ∈ V, m.1.asIdeal = n := by
      intro V hV n hn hle
      have hVc : IsClosed (Subtype.val '' V) := (IsClosed.isClosedMap_subtype_val ha) V hV
      have hx : (⟨n, hn.isPrime⟩ : PrimeSpectrum A) ∈ PrimeSpectrum.zeroLocus
          (PrimeSpectrum.vanishingIdeal (Subtype.val '' V) : Set A) := by
        rw [PrimeSpectrum.mem_zeroLocus]
        exact fun a ha' => hle ha'
      rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hVc.closure_eq] at hx
      obtain ⟨m, hm, hmeq⟩ := hx
      exact ⟨m, hm, by rw [hmeq]⟩
    have hnc : ∀ P : Ideal A, P.IsPrime →
        P ⊔ PrimeSpectrum.vanishingIdeal (Subtype.val '' U) ≠ ⊤ →
        P ⊔ PrimeSpectrum.vanishingIdeal (Subtype.val '' Uᶜ) = ⊤ := by
      intro P hP h1
      by_contra h2
      obtain ⟨n1, hn1, hle1⟩ := Ideal.exists_le_maximal _ h1
      obtain ⟨n2, hn2, hle2⟩ := Ideal.exists_le_maximal _ h2
      obtain ⟨m1, hm1U, hm1⟩ := hclosed U hU.isClosed n1 hn1 (le_trans le_sup_right hle1)
      obtain ⟨m2, hm2U, hm2⟩ := hclosed Uᶜ hU.compl.isClosed n2 hn2 (le_trans le_sup_right hle2)
      have sp1 : (⟨P, hP⟩ : PrimeSpectrum A) ⤳ m1.1 := by
        rw [← PrimeSpectrum.le_iff_specializes, ← PrimeSpectrum.asIdeal_le_asIdeal, hm1]
        exact le_trans le_sup_left hle1
      have sp2 : (⟨P, hP⟩ : PrimeSpectrum A) ⤳ m2.1 := by
        rw [← PrimeSpectrum.le_iff_specializes, ← PrimeSpectrum.asIdeal_le_asIdeal, hm2]
        exact le_trans le_sup_left hle2
      have heq := (hb ⟨P, hP⟩).unique ⟨m1.2, sp1⟩ ⟨m2.2, sp2⟩
      have hm12 : m1 = m2 := Subtype.ext heq
      exact hm2U (hm12 ▸ hm1U)
    have havoid : ∃ i ∈ PrimeSpectrum.vanishingIdeal (Subtype.val '' U),
        ∃ j ∈ PrimeSpectrum.vanishingIdeal (Subtype.val '' Uᶜ), (1 - i) * (1 - j) = 0 := by
      set I := PrimeSpectrum.vanishingIdeal (Subtype.val '' U) with hI
      set J := PrimeSpectrum.vanishingIdeal (Subtype.val '' Uᶜ) with hJ
      let S : Submonoid A :=
        { carrier := {x | ∃ i ∈ I, ∃ j ∈ J, x = (1 - i) * (1 - j)}
          mul_mem' := by
            rintro a b ⟨i1, hi1, j1, hj1, rfl⟩ ⟨i2, hi2, j2, hj2, rfl⟩
            exact ⟨i1 + i2 - i1 * i2, I.sub_mem (I.add_mem hi1 hi2) (I.mul_mem_right i2 hi1),
              j1 + j2 - j1 * j2, J.sub_mem (J.add_mem hj1 hj2) (J.mul_mem_right j2 hj1), by ring⟩
          one_mem' := by
            show ∃ i ∈ I, ∃ j ∈ J, (1 : A) = (1 - i) * (1 - j)
            exact ⟨0, I.zero_mem, 0, J.zero_mem, by ring⟩ }
      have hS : ∀ x, x ∈ S ↔ ∃ i ∈ I, ∃ j ∈ J, x = (1 - i) * (1 - j) := fun x => Iff.rfl
      by_contra hcon
      have hdisj : Disjoint ((⊥ : Ideal A) : Set A) (S : Set A) := by
        rw [Set.disjoint_left]
        intro x hx hxS
        rw [SetLike.mem_coe, Ideal.mem_bot] at hx
        subst hx
        obtain ⟨i, hi, j, hj, h⟩ := (hS 0).1 hxS
        exact hcon ⟨i, hi, j, hj, h.symm⟩
      obtain ⟨P, hP, -, hPS⟩ := Ideal.exists_le_prime_disjoint ⊥ S hdisj
      have h1 : P ⊔ I ≠ ⊤ := by
        intro htop
        rw [Ideal.eq_top_iff_one, Submodule.mem_sup] at htop
        obtain ⟨p, hp, i, hi, hpi⟩ := htop
        have hmem : 1 - i ∈ S := (hS _).2 ⟨i, hi, 0, J.zero_mem, by ring⟩
        have hpe : 1 - i = p := by rw [← hpi]; ring
        rw [← hpe] at hp
        exact Set.disjoint_left.mp hPS (SetLike.mem_coe.mpr hp) hmem
      have h2 := hnc P hP h1
      rw [Ideal.eq_top_iff_one, Submodule.mem_sup] at h2
      obtain ⟨p, hp, j, hj, hpj⟩ := h2
      have hmem : 1 - j ∈ S := (hS _).2 ⟨0, I.zero_mem, j, hj, by ring⟩
      have hpe : 1 - j = p := by rw [← hpj]; ring
      rw [← hpe] at hp
      exact Set.disjoint_left.mp hPS (SetLike.mem_coe.mpr hp) hmem
    obtain ⟨i, hi, j, hj, hij⟩ := havoid
    have P1 : ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, m ∈ U →
        (1 - i) ∉ m.1.asIdeal ∧ (1 - j) ∈ m.1.asIdeal := by
      intro m hm
      have him : i ∈ m.1.asIdeal :=
        (PrimeSpectrum.mem_vanishingIdeal _ _).mp hi m.1 (Set.mem_image_of_mem _ hm)
      have hfn : (1 - i) ∉ m.1.asIdeal := by
        intro hfm
        apply m.1.isPrime.ne_top
        rw [Ideal.eq_top_iff_one]
        have h1 : (1 : A) = (1 - i) + i := by ring
        rw [h1]
        exact m.1.asIdeal.add_mem hfm him
      refine ⟨hfn, ?_⟩
      have h0 : (1 - i) * (1 - j) ∈ m.1.asIdeal := by rw [hij]; exact m.1.asIdeal.zero_mem
      exact (m.1.isPrime.mem_or_mem h0).resolve_left hfn
    have P2 : ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, m ∉ U →
        (1 - j) ∉ m.1.asIdeal ∧ (1 - i) ∈ m.1.asIdeal := by
      intro m hm
      have hjm : j ∈ m.1.asIdeal :=
        (PrimeSpectrum.mem_vanishingIdeal _ _).mp hj m.1
          (Set.mem_image_of_mem _ (show m ∈ Uᶜ from hm))
      have hgn : (1 - j) ∉ m.1.asIdeal := by
        intro hgm
        apply m.1.isPrime.ne_top
        rw [Ideal.eq_top_iff_one]
        have h1 : (1 : A) = (1 - j) + j := by ring
        rw [h1]
        exact m.1.asIdeal.add_mem hgm hjm
      refine ⟨hgn, ?_⟩
      have h0 : (1 - i) * (1 - j) ∈ m.1.asIdeal := by rw [hij]; exact m.1.asIdeal.zero_mem
      exact (m.1.isPrime.mem_or_mem h0).resolve_right hgn
    have hunit : IsUnit ((1 - i) + (1 - j)) := by
      by_contra hnu
      obtain ⟨N, hN, hmem⟩ := exists_max_ideal_of_mem_nonunits (mem_nonunits_iff.mpr hnu)
      let m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} :=
        ⟨⟨N, hN.isPrime⟩, (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr hN⟩
      have hmN : m.1.asIdeal = N := rfl
      by_cases hm : m ∈ U
      · obtain ⟨hf, hg⟩ := P1 m hm
        rw [hmN] at hf hg
        apply hf
        have e1 : 1 - i = ((1 - i) + (1 - j)) - (1 - j) := by ring
        rw [e1]
        exact N.sub_mem hmem hg
      · obtain ⟨hg, hf⟩ := P2 m hm
        rw [hmN] at hf hg
        apply hg
        have e1 : 1 - j = ((1 - i) + (1 - j)) - (1 - i) := by ring
        rw [e1]
        exact N.sub_mem hmem hf
    obtain ⟨u, hu⟩ := hunit
    have h1 : ((1 - i) + (1 - j)) * (↑u⁻¹ : A) = 1 := by rw [← hu, Units.mul_inv]
    refine ⟨(1 - i) * (↑u⁻¹ : A), ?_, ?_⟩
    · linear_combination (-((↑u⁻¹ : A) * (↑u⁻¹ : A))) * hij + ((1 - i) * (↑u⁻¹ : A)) * h1
    · intro m
      constructor
      · intro hm hem
        apply (P1 m hm).1
        have e1 : 1 - i = ((1 - i) * (↑u⁻¹ : A)) * ((1 - i) + (1 - j)) := by
          linear_combination (-(1 - i)) * h1
        rw [e1]
        exact m.1.asIdeal.mul_mem_right _ hem
      · intro hem
        by_contra hm
        exact hem (m.1.asIdeal.mul_mem_right _ (P2 m hm).2)

  have s1 : ∀ (A : Type u) [CommRing A], IsClosed {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} → ∀ a : A, IsClopen {m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} | a ∉ m.1.asIdeal} := by
    intro A _ hcA a
    have hopen : ∀ b : A, IsOpen {m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} | b ∉ m.1.asIdeal} :=
      fun b => (PrimeSpectrum.isOpen_basicOpen (a := b)).preimage continuous_subtype_val
    refine ⟨?_, hopen a⟩
    rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
    intro m' hm'
    have ham' : a ∈ m'.1.asIdeal := not_not.mp hm'
    have hnd : ¬ Disjoint ((PrimeSpectrum.vanishingIdeal {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} : Ideal A) : Set A)
        ((m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a : Submonoid A) : Set A) := by
      intro hdisj
      obtain ⟨P, hP, hJP, hPS⟩ := Ideal.exists_le_prime_disjoint _ _ hdisj
      have hPZ : (⟨P, hP⟩ : PrimeSpectrum A) ∈ {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} := by
        have hx : (⟨P, hP⟩ : PrimeSpectrum A) ∈ PrimeSpectrum.zeroLocus
            (PrimeSpectrum.vanishingIdeal {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} : Set A) := by
          rw [PrimeSpectrum.mem_zeroLocus]
          exact fun t ht => hJP ht
        rwa [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hcA.closure_eq] at hx
      have hPmax : P.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hPZ
      have hPle : P ≤ m'.1.asIdeal := by
        intro t ht
        by_contra htm
        have htS : t ∈ (m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a : Submonoid A) :=
          (le_sup_left : m'.1.asIdeal.primeCompl ≤ m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a) htm
        exact Set.disjoint_left.mp hPS ht htS
      have hPeq : P = m'.1.asIdeal := hPmax.eq_of_le m'.1.isPrime.ne_top hPle
      have haS : a ∈ (m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a : Submonoid A) :=
        (le_sup_right : Submonoid.powers a ≤ m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a)
          (Submonoid.mem_powers a)
      have haP : a ∈ (P : Set A) := by rw [SetLike.mem_coe, hPeq]; exact ham'
      exact Set.disjoint_left.mp hPS haP haS
    rw [Set.not_disjoint_iff] at hnd
    obtain ⟨t, htJ, htS⟩ := hnd
    obtain ⟨s, hs, w, hw, hsw⟩ := Submonoid.mem_sup.mp (SetLike.mem_coe.mp htS)
    obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hw
    refine ⟨{m | s ∉ m.1.asIdeal}, ?_, hopen s, hs⟩
    intro m hm ham
    have htm : t ∈ m.1.asIdeal :=
      (PrimeSpectrum.mem_vanishingIdeal _ _).mp (SetLike.mem_coe.mp htJ) m.1 m.2
    rw [← hsw] at htm
    rcases m.1.isPrime.mem_or_mem htm with h | h
    · exact hm h
    · exact ham (m.1.isPrime.mem_of_pow_mem k h)

  have s2 : ∀ (A : Type u) [CommRing A], (∀ x : PrimeSpectrum A, ∃ y : PrimeSpectrum A, IsClosed ({y} : Set (PrimeSpectrum A)) ∧ x ⤳ y) → ∀ (a e : A), e * e = e → (∀ y : PrimeSpectrum A, IsClosed ({y} : Set (PrimeSpectrum A)) → e ∉ y.asIdeal → a ∉ y.asIdeal) → ∀ x : PrimeSpectrum A, e ∉ x.asIdeal → a ∉ x.asIdeal := by
    intro A _ hex a e he hcl x hx hax
    obtain ⟨y, hy, hxy⟩ := hex x
    have hle : x.asIdeal ≤ y.asIdeal :=
      (PrimeSpectrum.asIdeal_le_asIdeal x y).mpr ((PrimeSpectrum.le_iff_specializes x y).mpr hxy)
    have h0 : e * (1 - e) ∈ x.asIdeal := by
      have h00 : e * (1 - e) = 0 := by rw [mul_sub, mul_one, he, sub_self]
      rw [h00]; exact x.asIdeal.zero_mem
    have h1 : 1 - e ∈ y.asIdeal := hle ((x.isPrime.mem_or_mem h0).resolve_left hx)
    have hey : e ∉ y.asIdeal := by
      intro hey
      apply y.isPrime.ne_top
      rw [Ideal.eq_top_iff_one]
      have h11 : (1 : A) = e + (1 - e) := by ring
      rw [h11]; exact y.asIdeal.add_mem hey h1
    exact hcl y hy hey (hle hax)

  let φ : X ≃ₜ PrimeSpectrum Γ(X, ⊤) := X.isoSpec.hom.homeomorph
  have K : ∀ x : X, IsClosed ({φ x} : Set (PrimeSpectrum Γ(X, ⊤))) ↔ IsClosed ({x} : Set X) := by
    intro x
    rw [show ({φ x} : Set (PrimeSpectrum Γ(X, ⊤))) = φ '' {x} from (Set.image_singleton).symm]
    exact φ.isClosed_image
  have K' : ∀ p : PrimeSpectrum Γ(X, ⊤),
      IsClosed ({p} : Set (PrimeSpectrum Γ(X, ⊤))) ↔ IsClosed ({φ.symm p} : Set X) := by
    intro p
    rw [← K, φ.apply_symm_apply]
  have hc' : IsClosed {p : PrimeSpectrum Γ(X, ⊤) | IsClosed ({p} : Set (PrimeSpectrum Γ(X, ⊤)))} := by
    have hset : {p : PrimeSpectrum Γ(X, ⊤) | IsClosed ({p} : Set (PrimeSpectrum Γ(X, ⊤)))} =
        φ.symm ⁻¹' {x : X | IsClosed ({x} : Set X)} := by
      ext p; exact K' p
    rw [hset]; exact hc.preimage φ.symm.continuous
  have hu' : ∀ p : PrimeSpectrum Γ(X, ⊤), ∃! q : PrimeSpectrum Γ(X, ⊤),
      IsClosed ({q} : Set (PrimeSpectrum Γ(X, ⊤))) ∧ p ⤳ q := by
    intro p
    obtain ⟨y, ⟨hy, hpy⟩, huniq⟩ := hu (φ.symm p)
    refine ⟨φ y, ⟨(K y).mpr hy, ?_⟩, ?_⟩
    · have hsp := hpy.map φ.continuous
      rwa [φ.apply_symm_apply] at hsp
    · rintro q ⟨hq, hpq⟩
      have h1 : φ.symm q = y := huniq _ ⟨(K' q).mp hq, hpq.map φ.symm.continuous⟩
      rw [← h1, φ.apply_symm_apply]
  have hzU' : φ z ∈ φ.symm ⁻¹' U := by
    rw [Set.mem_preimage, φ.symm_apply_apply]; exact hzU
  obtain ⟨_, ⟨a, rfl⟩, hza, haU⟩ :=
    PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hzU'
      (hU.preimage φ.symm.continuous)
  obtain ⟨e, he, heC⟩ := s3 Γ(X, ⊤) hc' hu' _ (s1 Γ(X, ⊤) hc' a)
  refine ⟨φ ⁻¹' (PrimeSpectrum.basicOpen e : Set (PrimeSpectrum Γ(X, ⊤))), ?_, ?_, ?_⟩
  · exact (PrimeSpectrum.isClopen_basicOpen_of_mul_add e (1 - e)
      (by rw [mul_sub, mul_one, he, sub_self]) (by ring)).preimage φ.continuous
  · show e ∉ (φ z).asIdeal
    exact (heC ⟨φ z, (K z).mpr hz⟩).mp hza
  · intro x hx
    have hxa : a ∉ (φ x).asIdeal :=
      s2 Γ(X, ⊤) (fun p => (hu' p).exists) a e he (fun y hy hey => (heC ⟨y, hy⟩).mpr hey) (φ x) hx
    have hxU := haU hxa
    rwa [Set.mem_preimage, φ.symm_apply_apply] at hxU

theorem wc_et_pullback_injective_limit_acyclic_qcqs : ∀ {S Z : Scheme.{u}} (g : Z ⟶ S) (L : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush g) → ∀ (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (π : ∀ l, Z ⟶ (D.obj l).left), (∀ l, π l ≫ (D.obj l).hom = g) → (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! z₀ : T ⟶ Z, ∀ l, z₀ ≫ π l = z l) → (∀ l, CompactSpace (D.obj l).left) → (∀ l, QuasiSeparatedSpace (D.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → CompactSpace Z → QuasiSeparatedSpace Z → ∀ (J : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) [Injective J] (q : ℕ), Subsingleton (wcEtExt Z (L.obj J) (q + 1)) :=
by
  intro S Z g L hadj Λ _ _ D π hπ hπc hlim hcpt hqs haff hZc hZq J _ q
  haveI := wc_et_enough_injectives Z
  obtain ⟨ρ, -, hV, hU, hlimρ⟩ := wc_et_pullback_sections_colimit g L hadj

  have hρα : ∀ (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (U : Z.Etale)
      (V : S.Etale) (α β : U.left ⟶ V.left) (hα : α ≫ V.hom = U.hom ≫ g)
      (hβ : β ≫ V.hom = U.hom ≫ g) (x : G.obj.obj (Opposite.op V)),
      α = β → ρ G U V α hα x = ρ G U V β hβ x := by
    intro G U V α β hα hβ x e
    subst e
    rfl
  have hleg : ∀ (U U' : Z.Etale) (u : U' ⟶ U) (V : S.Etale) (α : U.left ⟶ V.left),
      α ≫ V.hom = U.hom ≫ g → (u.left ≫ α) ≫ V.hom = U'.hom ≫ g := by
    intro U U' u V α h
    rw [Category.assoc, h, ← Category.assoc, MorphismProperty.Over.w u]
  have hleg' : ∀ (U : Z.Etale) (V V' : S.Etale) (w : V ⟶ V') (α : U.left ⟶ V.left),
      α ≫ V.hom = U.hom ≫ g → (α ≫ w.left) ≫ V'.hom = U.hom ≫ g := by
    intro U V V' w α h
    rw [Category.assoc, MorphismProperty.Over.w w, h]
  have hT : Limits.IsTerminal (wcEtTop Z) :=
    @MorphismProperty.Over.mkIdTerminal _ _ @Etale Z
      MorphismProperty.IsMultiplicative.toContainsIdentities
  exact wc_et_cartan_criterion_const Z
      (fun U => CompactSpace U.left ∧ QuasiSeparatedSpace U.left ∧
        ∃ (M₀ : Type u) (_ : SmallCategory M₀) (_ : IsCofiltered M₀) (D₀ : M₀ ⥤ S.Etale)
          (π₀ : ∀ l, U.left ⟶ (D₀.obj l).left),
          (∀ l, π₀ l ≫ (D₀.obj l).hom = U.hom ≫ g) ∧
          (∀ {l l' : M₀} (t : l ⟶ l'), π₀ l ≫ (D₀.map t).left = π₀ l') ∧
          (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D₀.obj l).left),
            (∀ {l l' : M₀} (t : l ⟶ l'), z l ≫ (D₀.map t).left = z l') →
            ∃! z₀ : T ⟶ U.left, ∀ l, z₀ ≫ π₀ l = z l) ∧
          (∀ l, CompactSpace (D₀.obj l).left) ∧ (∀ l, QuasiSeparatedSpace (D₀.obj l).left) ∧
          (∀ {l l' : M₀} (t : l ⟶ l'), IsAffineHom (D₀.map t).left))
      (fun U k V f => CompactSpace U.left ∧ QuasiSeparatedSpace U.left ∧
        ∃ (M₀ : Type u) (_ : SmallCategory M₀) (_ : IsCofiltered M₀) (D₀ : M₀ ⥤ S.Etale)
          (π₀ : ∀ l, U.left ⟶ (D₀.obj l).left),
          (∀ l, π₀ l ≫ (D₀.obj l).hom = U.hom ≫ g) ∧
          (∀ {l l' : M₀} (t : l ⟶ l'), π₀ l ≫ (D₀.map t).left = π₀ l') ∧
          (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (D₀.obj l).left),
            (∀ {l l' : M₀} (t : l ⟶ l'), z l ≫ (D₀.map t).left = z l') →
            ∃! z₀ : T ⟶ U.left, ∀ l, z₀ ≫ π₀ l = z l) ∧
          (∀ l, CompactSpace (D₀.obj l).left) ∧ (∀ l, QuasiSeparatedSpace (D₀.obj l).left) ∧
          (∀ {l l' : M₀} (t : l ⟶ l'), IsAffineHom (D₀.map t).left) ∧
          ∃ (m₀ : M₀) (V₀ : Fin k → S.Etale) (c : ∀ i, V₀ i ⟶ D₀.obj m₀)
            (e : ∀ i, (V i).left ⟶ (V₀ i).left),
            (∀ i, IsPullback (e i) (f i).left (c i).left (π₀ m₀)) ∧
            (∀ i, IsAffine (V₀ i).left) ∧ ∀ x : U.left, ∃ i, x ∈ Set.range (f i).left)
      (by

        intro U k V f hC
        obtain ⟨-, -, M₀, _, _, D₀, π₀, -, -, -, -, -, -, m₀, V₀, c, e, -, -, hsurj⟩ := hC
        apply wc_etale_jointly_surjective_covers
        intro v
        obtain ⟨i, hi⟩ := hsurj v
        exact ⟨V i, f i, ⟨_, 𝟙 _, f i, Presieve.ofArrows.mk i, Category.id_comp _⟩, hi⟩)
      (by

        intro U k V f hC p σ
        obtain ⟨hUc, hUq, M₀, _, _, D₀, π₀, hπ₀, hπ₀c, hlim₀, hc₀, hq₀, ha₀, m₀, V₀, c, e, hpb,
          haffV, -⟩ := hC
        obtain ⟨M, _, _, U', V', f', πW, h1, h2, h3, h4, h5, h6, h7, -⟩ :=
          wc_et_cech_nerve_limit_presentation g U M₀ D₀ π₀ hπ₀ hπ₀c m₀
            (wc_limit_restrict_over M₀ D₀ π₀ hπ₀c hlim₀ m₀) hc₀ hq₀ ha₀ hUc hUq k V f V₀ c e hpb
            haffV
        exact ⟨(h7 p σ).1, (h7 p σ).2, M, inferInstance, inferInstance, wcLevelWP U' V' f' σ,
          πW p σ, h1 p σ, h2 p σ, h3 p σ, h4 p σ, h5 p σ, h6 p σ⟩)
      (by

        intro U hB R hR
        obtain ⟨hUc, hUq, M₀, _, _, D₀, π₀, hπ₀, hπ₀c, hlim₀, hc₀, hq₀, ha₀⟩ := hB
        obtain ⟨l, k, V₀, c, U', f, e, hpb, hR', haffV, hsurj⟩ :=
          wc_et_limit_cover_descends g M₀ D₀ U π₀ hπ₀ hπ₀c hlim₀ hc₀ hq₀ ha₀ R hR
        exact ⟨k, U', f, ⟨hUc, hUq, M₀, inferInstance, inferInstance, D₀, π₀, hπ₀, hπ₀c, hlim₀,
          hc₀, hq₀, ha₀, l, V₀, c, e, hpb, haffV, hsurj⟩, hR'⟩)
      (wcEtTop Z) hT

      ⟨hZc, hZq, Λ, inferInstance, inferInstance, D, π,
        fun l => (hπ l).trans (Category.id_comp g).symm, hπc, hlim, hcpt, hqs, haff⟩
      (L.obj J)
      (by

        intro U k V f hC
        obtain ⟨hUc, hUq, M₀, _, _, D₀, π₀, hπ₀, hπ₀c, hlim₀, hc₀, hq₀, ha₀, m₀, V₀, c, e, hpb,
          haffV, -⟩ := hC
        obtain ⟨M, _, _, U', V', f', πW, h1, h2, h3, h4, h5, h6, h7, h8⟩ :=
          wc_et_cech_nerve_limit_presentation g U M₀ D₀ π₀ hπ₀ hπ₀c m₀
            (wc_limit_restrict_over M₀ D₀ π₀ hπ₀c hlim₀ m₀) hc₀ hq₀ ha₀ hUc hUq k V f V₀ c e hpb
            haffV
        refine wc_cechAcyclic_of_level_colimit J.obj (L.obj J).obj U k V f M U' V' f'
          (fun p σ n => ρ J (Limits.widePullback U (fun l => V (σ l)) (fun l => f (σ l)))
            ((wcLevelWP U' V' f' σ).obj n) (πW p σ n) (h1 p σ n)) ?_ ?_ ?_ ?_ ?_
        ·
          intro p σ n n' t x
          exact (hV J _ ((wcLevelWP U' V' f' σ).obj n) ((wcLevelWP U' V' f' σ).obj n')
              ((wcLevelWP U' V' f' σ).map t) (πW p σ n) (h1 p σ n)
              (hleg' _ _ _ ((wcLevelWP U' V' f' σ).map t) _ (h1 p σ n)) x).symm.trans
            (hρα J _ ((wcLevelWP U' V' f' σ).obj n') _ _
              (hleg' _ _ _ ((wcLevelWP U' V' f' σ).map t) _ (h1 p σ n)) (h1 p σ n') x
              (h2 p σ t))
        ·
          intro p τ j n x
          exact (hU J _ _ (wcCechFace V f τ j)
              ((wcLevelWP U' V' f' (fun l => τ (j.succAbove l))).obj n)
              (πW p (fun l => τ (j.succAbove l)) n) (h1 p (fun l => τ (j.succAbove l)) n)
              (hleg _ _ (wcCechFace V f τ j) _ _ (h1 p (fun l => τ (j.succAbove l)) n)) x).trans
            ((hρα J _ ((wcLevelWP U' V' f' (fun l => τ (j.succAbove l))).obj n) _ _
              (hleg _ _ (wcCechFace V f τ j) _ _ (h1 p (fun l => τ (j.succAbove l)) n))
              (hleg' _ ((wcLevelWP U' V' f' τ).obj n)
                ((wcLevelWP U' V' f' (fun l => τ (j.succAbove l))).obj n)
                (wcCechFace (fun i => (V' i).obj n) (fun i => (f' i).app n) τ j) _
                (h1 (p + 1) τ n)) x (h8 p τ j n)).trans
              (hV J _ ((wcLevelWP U' V' f' τ).obj n)
                ((wcLevelWP U' V' f' (fun l => τ (j.succAbove l))).obj n)
                (wcCechFace (fun i => (V' i).obj n) (fun i => (f' i).app n) τ j)
                (πW (p + 1) τ n) (h1 (p + 1) τ n)
                (hleg' _ ((wcLevelWP U' V' f' τ).obj n)
                  ((wcLevelWP U' V' f' (fun l => τ (j.succAbove l))).obj n)
                  (wcCechFace (fun i => (V' i).obj n) (fun i => (f' i).app n) τ j) _
                  (h1 (p + 1) τ n)) x))
        ·
          intro p σ s
          exact (hlimρ _ M _ (πW p σ) (h1 p σ) (h2 p σ) (h3 p σ) (h4 p σ) (h5 p σ) (h6 p σ)
            (h7 p σ).1 (h7 p σ).2).1 J s
        ·
          intro p σ n x hx
          exact (hlimρ _ M _ (πW p σ) (h1 p σ) (h2 p σ) (h3 p σ) (h4 p σ) (h5 p σ) (h6 p σ)
            (h7 p σ).1 (h7 p σ).2).2 J n x hx
        ·
          intro n
          exact (wc_injective_cech_acyclic (Scheme.smallEtaleTopology S) J
