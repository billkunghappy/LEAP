  have C1 : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j : ℕ),
      πc j p σ ≫ (wcWP (U' j) (V' j) (f' j) σ).hom = (wcWP U V f σ).hom ≫ (a (l + j)).left := by
    intro p σ j
    rw [hW, hW, ← Category.assoc, hπb j p σ, Category.assoc, L1 j, Category.assoc]
  have C2 : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j j' : ℕ) (h : j ≤ j'),
      Ec j j' h p σ ≫ (wcWP (U' j) (V' j) (f' j) σ).hom =
        (wcWP (U' j') (V' j') (f' j') σ).hom ≫ (D.map (homOfLE (Nat.add_le_add_left h l)).op).left := by
    intro p σ j j' h
    rw [hW, hW, ← Category.assoc, hEb j j' h p σ, Category.assoc, L5 j j' h, Category.assoc]
  have C3 : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) (j j' : ℕ) (h : j ≤ j'),
      πc j' p σ ≫ Ec j j' h p σ = πc j p σ := by
    intro p σ j j' h
    apply WPext _ (U' j) (p + 1) (fun t => V' j (σ t)) (fun t => f' j (σ t))
    · rw [Category.assoc, hEb j j' h p σ, ← Category.assoc, hπb j' p σ, Category.assoc, L9 j j' h,
        hπb j p σ]
    · intro t
      rw [Category.assoc, hEπ j j' h p σ t, ← Category.assoc, hππ j' p σ t, Category.assoc,
