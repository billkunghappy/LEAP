    rw [key]
    exact Equiv.bijective _

  haveI := hbcI g
  let adj : wcEtInv g ⊣ (wcEtBaseChange g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z) :=
    Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtBaseChange g)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology Y) (Scheme.smallEtaleTopology Z)

  let j : wcEtTop Z ⟶ (wcEtBaseChange g).obj (wcEtTop Y) :=
    wcEtInvLift g (wcEtTop Y) (wcEtTop Z) g ((Category.comp_id g).trans (Category.id_comp g).symm)
  let r : (wcEtBaseChange g).obj (wcEtTop Y) ⟶ wcEtTop Z :=
    MorphismProperty.Over.homMk (Limits.pullback.snd (wcEtTop Y).hom g) (Category.comp_id _) trivial
  have hjr : j ≫ r = 𝟙 _ := by
    apply MorphismProperty.Over.Hom.ext
    exact ls g (wcEtTop Y) (wcEtTop Z) g ((Category.comp_id g).trans (Category.id_comp g).symm)
  have hrj : r ≫ j = 𝟙 _ := by
    apply MorphismProperty.Over.Hom.ext
    apply Limits.pullback.hom_ext
    · exact (Category.assoc _ _ _).trans ((congrArg
        (fun q => Limits.pullback.snd (wcEtTop Y).hom g ≫ q)
        (lf g (wcEtTop Y) (wcEtTop Z) g ((Category.comp_id g).trans (Category.id_comp g).symm))).trans
        ((Limits.pullback.condition (f := (wcEtTop Y).hom) (g := g)).symm.trans
          ((Category.comp_id _).trans (Category.id_comp _).symm)))
    · exact (Category.assoc _ _ _).trans ((congrArg
        (fun q => Limits.pullback.snd (wcEtTop Y).hom g ≫ q)
        (ls g (wcEtTop Y) (wcEtTop Z) g ((Category.comp_id g).trans (Category.id_comp g).symm))).trans
        ((Category.comp_id _).trans (Category.id_comp _).symm))
  have hR : Function.Bijective (M.obj.map j.op).hom := by
