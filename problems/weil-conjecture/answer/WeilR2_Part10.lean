  choose πc hπb hππ hπf using fun j => NM U V f (U' j) (V' j) (f' j) (qU j) (qV j) (L2 j)
  choose Ec hEb hEπ hEf using fun j j' (h : j ≤ j') =>
    NM (U' j') (V' j') (f' j') (U' j) (V' j) (f' j) (rU j j' h) (rV j j' h) (L6 j j' h)
  have sqB : ∀ (p : ℕ) (σ : Fin (p + 1) → Fin k) j j' (h : j ≤ j'),
      IsPullback (Ec j j' h p σ) (Limits.WidePullback.base (fun t => f' j' (σ t))).left
