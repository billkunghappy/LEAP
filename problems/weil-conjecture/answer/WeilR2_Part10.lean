theorem wc_etInv_cocycle : ∀ {Z'' Z' Z Y : Scheme.{u}} (s : Z'' ⟶ Z') (t : Z' ⟶ Z) (g : Z ⟶ Y) (st : Z'' ⟶ Z) (e' : Z' ⟶ Y) (e'' : Z'' ⟶ Y) (hst : s ≫ t = st) (he' : t ≫ g = e') (he'' : s ≫ e' = e'') (hstg : st ≫ g = e'') (A : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), wcEtInvCompInv s t st hst ((wcEtInv g).obj A) ≫ (wcEtInv s).map (wcEtInvComp t g e' he' A) ≫ wcEtInvComp s e' e'' he'' A = wcEtInvComp st g e'' hstg A :=
by
  classical
