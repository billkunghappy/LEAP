    have hκ : ∀ {V₁ V₂ : Y.Etale} (a : V₁ ⟶ V₂),
        κ V₁ ≫ (wcEtBaseChange t).map ((wcEtBaseChange g).map a) =
          (wcEtBaseChange e).map a ≫ κ V₂ := by
      intro V₁ V₂ a
      apply LE
      exact (Category.assoc _ _ _).trans ((congrArg (fun q => (κ V₁).left ≫ q)
