    rw [hrV1, hrU1]
    exact CSq j' i
  have L9 : ∀ j j' (h : j ≤ j'), qU j' ≫ rU j j' h = qU j := by
    intro j j' h
    apply (PU j).hom_ext
    · rw [Category.assoc, hrU1, hqU1, hqU1]
    · rw [Category.assoc, L5, ← Category.assoc, L1, Category.assoc,
        hA (l + j) (l + j') (Nat.add_le_add_left h l), L1]
