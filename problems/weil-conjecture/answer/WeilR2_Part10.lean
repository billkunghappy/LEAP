    intro w
    exact (hbij (wcIntTors (wcXbar F X) ℓ m) (2 * d)).1 ((hvanP _).trans (hvanP _).symm)

  have hS : (ShortComplex.mk j (Limits.cokernel.π j) (Limits.cokernel.condition j)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel j) hj inferInstance
  obtain ⟨x, hx⟩ := Abelian.Ext.contravariant_sequence_exact₂ hS (wcIntTors (wcXbar F X) ℓ m) y
    (hvanJ _)

  have hmk : ∀ {A B : SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ)} (f : A ⟶ B) (k : ℕ),
      Abelian.Ext.mk₀ (k • f) = k • Abelian.Ext.mk₀ f := by
    intro A B f k
    induction k with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero]
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, ih]
  have hL' : ∀ {A B C : SheafOfModules.{u+1} (wcIntRingSheaf (wcXbar F X) ℓ)} {p q r : ℕ}
      (a : Abelian.Ext A B p) (b : Abelian.Ext B C q) (h : p + q = r) (k : ℕ),
