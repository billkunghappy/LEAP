      ∃ (l : ℕ) (hkl : k ≤ l), ((θ k l hkl).hom.app (Opposite.op U)).hom t = 0) :=
by
  classical
  let s : ∀ n : ℕ, H n ⟶ H (n + 1) := fun n => θ n (n + 1) (Nat.le_add_right n 1)
  let Φ : ℕ ⥤ Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1} := Functor.ofSequence s
  have hsucc : ∀ n : ℕ, Φ.map (homOfLE (Nat.le_add_right n 1)) = θ n (n + 1) (Nat.le_add_right n 1) :=
    fun n => Functor.ofSequence_map_homOfLE_succ s n

