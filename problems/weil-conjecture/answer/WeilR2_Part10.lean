    let adj := constantSheafAdj (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} hT
    let ev : ∀ X : AddCommGrpCat.{u+1}, (AddCommGrpCat.of (ULift.{u+1} ℤ) ⟶ X) ≃ X := fun X =>
      { toFun := fun φ => φ.hom (ULift.up 1)
        invFun := fun x => AddCommGrpCat.ofHom
          ((zmultiplesHom X x).comp (AddEquiv.ulift : ULift.{u+1} ℤ ≃+ ℤ).toAddMonoidHom)
        left_inv := fun φ => by
          apply AddCommGrpCat.hom_ext
          apply AddMonoidHom.ext
          rintro ⟨n⟩
          have hn : (ULift.up n : ULift.{u+1} ℤ) = n • (ULift.up 1 : ULift.{u+1} ℤ) := by
            apply ULift.ext
            simp
          change (zmultiplesHom X (φ.hom (ULift.up 1))) n = φ.hom (ULift.up n)
          rw [zmultiplesHom_apply, hn, map_zsmul]
        right_inv := fun x => by
          change (zmultiplesHom X x) (1 : ℤ) = x
          rw [zmultiplesHom_apply, one_zsmul] }
    have key : (fun g : (constantSheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M =>
          (g.hom.app (Opposite.op (wcEtTop S))).hom
            (wcConstSec S (ULift.{u+1} ℤ) (wcEtTop S) (ULift.up 1))) =
        ⇑((adj.homEquiv (AddCommGrpCat.of (ULift.{u+1} ℤ)) M).trans
          (ev (M.obj.obj (Opposite.op (wcEtTop S))))) := by
      funext g
      rfl
    rw [key]
    exact Equiv.bijective _

  have hbc : ∀ {X B : Scheme.{u}} (g : X ⟶ B),
      (wcEtBaseChange g).IsContinuous (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) := by
    have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
        (c : V₁ ⟶ V), S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology Y V := by
      intro Y V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale Y V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hcov : ∀ {X B : Scheme.{u}} (g : X ⟶ B), CoverPreserving (Scheme.smallEtaleTopology B)
        (Scheme.smallEtaleTopology X) (wcEtBaseChange g) := by
      intro X B g
      constructor
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale B V at hS
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
      have hS' := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale B
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hS
      apply hjs
      intro v
      obtain ⟨W, a, w, ha, -, hw⟩ := hS' (Limits.pullback.fst V.hom g v)
      refine ⟨(wcEtBaseChange g).obj W, (wcEtBaseChange g).map a,
        Sieve.image_mem_functorPushforward (wcEtBaseChange g) S ha, ?_⟩
      have h0 : (Limits.pullback.fst W.hom g ≫ a.left) ≫ V.hom =
          Limits.pullback.snd W.hom g ≫ g := by
        rw [Category.assoc, MorphismProperty.Over.w a]
        exact Limits.pullback.condition
      let m : Limits.pullback W.hom g ⟶ Limits.pullback V.hom g :=
        Limits.pullback.lift (Limits.pullback.fst W.hom g ≫ a.left) (Limits.pullback.snd W.hom g) h0
      have hmap : ((wcEtBaseChange g).map a).left = m := rfl
      have h1 : Limits.pullback.fst a.left (Limits.pullback.fst V.hom g) ≫ W.hom =
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
            Limits.pullback.snd V.hom g) ≫ g := by
        rw [← MorphismProperty.Over.w a, ← Category.assoc, Limits.pullback.condition,
          Category.assoc, Limits.pullback.condition, Category.assoc]
      let ψ : Limits.pullback a.left (Limits.pullback.fst V.hom g) ⟶ Limits.pullback W.hom g :=
        Limits.pullback.lift (Limits.pullback.fst a.left (Limits.pullback.fst V.hom g))
          (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) ≫
            Limits.pullback.snd V.hom g) h1
      have hψ : ψ ≫ m = Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) := by
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc,
            Limits.pullback.lift_fst, Limits.pullback.condition]
        · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd]
      obtain ⟨z, hz⟩ : ∃ z, Limits.pullback.snd a.left (Limits.pullback.fst V.hom g) z = v := by
        have hv : (v : ↥(Limits.pullback V.hom g)) ∈
            Set.range (Limits.pullback.snd a.left (Limits.pullback.fst V.hom g)) := by
          rw [Scheme.Pullback.range_snd]
          exact ⟨w, hw⟩
        exact hv
      rw [hmap]
      exact ⟨ψ z, (Scheme.Hom.comp_apply ψ m z).symm.trans (by rw [hψ]; exact hz)⟩
    intro X B g
    let Φ := wcEtBaseChange g
    haveI h1 : Limits.PreservesFiniteLimits Φ := ⟨fun J _ _ =>
      haveI : Limits.PreservesLimitsOfShape J (wcEtBaseChange g ⋙ Scheme.Etale.forget X) :=
        Limits.preservesLimitsOfShape_of_natIso
          (NatIso.ofComponents (fun _ => Iso.refl _) (fun _ => rfl) :
            Scheme.Etale.forget B ⋙ Over.pullback g ≅ wcEtBaseChange g ⋙ Scheme.Etale.forget X)
      Limits.preservesLimitsOfShape_of_reflects_of_preserves (wcEtBaseChange g)
        (Scheme.Etale.forget X)⟩
    haveI := flat_of_preservesFiniteLimits Φ
    exact Functor.isContinuous_of_coverPreserving (compatiblePreservingOfFlat _ _) (hcov g)

  have hιc : (wcEtToProEt W.left).IsContinuous (Scheme.smallEtaleTopology W.left)
      (Scheme.ProEt.topology W.left) := by
    haveI h1 : Limits.PreservesFiniteLimits (wcEtToProEt W.left) :=
      @Limits.preservesFiniteLimits_of_reflects_of_preserves _ _ _ _ _ _ (wcEtToProEt W.left)
        (Scheme.ProEt.forget W.left)
        (inferInstanceAs (Limits.PreservesFiniteLimits (Scheme.Etale.forget W.left))) inferInstance
    have hcov : CoverPreserving (Scheme.smallEtaleTopology W.left) (Scheme.ProEt.topology W.left)
        (wcEtToProEt W.left) := by
      refine ⟨fun {V} {R} hR => ?_⟩
      obtain ⟨𝒰, h₁, h, hle⟩ := (Scheme.mem_smallGrothendieckTopology V R).1 hR
      have hP : Presieve.map (wcEtToProEt W.left)
            (@Scheme.Cover.toPresieveOverProp _ _ _ _ _ 𝒰 h₁ h) ∈
          (Scheme.ProEt.precoverage W.left).coverings ((wcEtToProEt W.left).obj V) :=
        Precoverage.mem_comap_iff.2
          ((congrArg (· ∈ Scheme.proetalePrecoverage.coverings V.left)
              ((congrArg (Presieve.map (Scheme.ProEt.forget W.left ⋙ Over.forget W.left))
                (Presieve.map_ofArrows (F := wcEtToProEt W.left) _)).trans
                (Presieve.map_ofArrows (F := Scheme.ProEt.forget W.left ⋙ Over.forget W.left) _))).mpr
            (Scheme.etalePrecoverage_le_proetalePrecoverage _ 𝒰.mem₀))
      have hgen := Precoverage.generate_mem_toGrothendieck hP
      refine GrothendieckTopology.superset_covering _ ?_ hgen
      rw [Sieve.generate_le_iff]
      intro Z f hf
      cases hf with
      | of hg => exact ⟨_, _, 𝟙 _, (by apply hle; exact hg), (Category.id_comp _).symm⟩
    haveI := flat_of_preservesFiniteLimits (wcEtToProEt W.left)
    exact Functor.isContinuous_of_coverPreserving
      (compatiblePreservingOfFlat (Scheme.ProEt.topology W.left) (wcEtToProEt W.left)) hcov
  haveI : (wcEtBaseChange W.hom).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology W.left) := hbc W.hom
  haveI := hιc

  have final : ∀ (A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (a : A.obj.obj (Opposite.op W)) (b : B.obj.obj (Opposite.op W)),
      (∀ N : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
        Function.Bijective (fun φ : A ⟶ N => (φ.hom.app (Opposite.op W)).hom a)) →
      (∀ N : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
        Function.Bijective (fun φ : B ⟶ N => (φ.hom.app (Opposite.op W)).hom b)) →
      ∃ c : A ≅ B, (c.hom.hom.app (Opposite.op W)).hom a = b := by
    intro A B a b hA hB
    obtain ⟨f, hf⟩ := (hA B).2 b
    obtain ⟨g, hg⟩ := (hB A).2 a
    have hf' : (f.hom.app (Opposite.op W)).hom a = b := hf
    have hg' : (g.hom.app (Opposite.op W)).hom b = a := hg
    have hfg : f ≫ g = 𝟙 A := (hA A).1 (by
      show (g.hom.app (Opposite.op W)).hom ((f.hom.app (Opposite.op W)).hom a) = a
      rw [hf', hg'])
    have hgf : g ≫ f = 𝟙 B := (hB B).1 (by
      show (f.hom.app (Opposite.op W)).hom ((g.hom.app (Opposite.op W)).hom b) = b
      rw [hg', hf'])
    exact ⟨⟨f, g, hfg, hgf⟩, hf'⟩

  have hh₀ : W.hom ≫ (wcEtTop S).hom = (wcEtTop W.left).hom ≫ W.hom :=
    (Category.comp_id W.hom).trans (Category.id_comp W.hom).symm
  have h2 := transfer (wcEtBaseChange W.hom) (Scheme.smallEtaleTopology S)
    (Scheme.smallEtaleTopology W.left) (wcEtUnitSheaf S) (wcEtTop S)
    (wcConstSec S (ULift.{u+1} ℤ) (wcEtTop S) (ULift.up 1)) hconst
  let k' : (wcEtBaseChange W.hom).obj (wcEtTop S) ⟶ wcEtTop W.left :=
    MorphismProperty.Over.homMk (Limits.pullback.snd (𝟙 S) W.hom) (Category.comp_id _) trivial
  have hk₁ : wcEtInvLift W.hom (wcEtTop S) (wcEtTop W.left) W.hom hh₀ ≫ k' = 𝟙 _ :=
    MorphismProperty.Over.Hom.ext (by
      show Limits.pullback.lift W.hom (𝟙 W.left) hh₀ ≫ Limits.pullback.snd (𝟙 S) W.hom = 𝟙 W.left
      exact Limits.pullback.lift_snd _ _ _)
  have epb : ∀ {A B : Scheme.{u}} (g : A ⟶ B) (h : g ≫ 𝟙 B = 𝟙 A ≫ g),
      Limits.pullback.snd (𝟙 B) g ≫ Limits.pullback.lift g (𝟙 A) h = 𝟙 _ := by
    intro A B g h
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Limits.pullback.lift_fst, Category.id_comp]
      exact ((Category.comp_id _).symm.trans Limits.pullback.condition).symm
    · rw [Category.assoc, Limits.pullback.lift_snd, Category.comp_id, Category.id_comp]
  have hk₂ : k' ≫ wcEtInvLift W.hom (wcEtTop S) (wcEtTop W.left) W.hom hh₀ =
      𝟙 ((wcEtBaseChange W.hom).obj (wcEtTop S)) :=
    MorphismProperty.Over.Hom.ext (by exact epb W.hom hh₀)
  have h3 := restrict (Scheme.smallEtaleTopology W.left) ((wcEtInv W.hom).obj (wcEtUnitSheaf S))
    _ _ hk₁ hk₂ _ h2
  have hy : (wcEtInvRho W.hom (wcEtUnitSheaf S) (wcEtTop S) (wcEtTop W.left) W.hom
        ((Category.comp_id W.hom).trans (Category.id_comp W.hom).symm)
        (wcConstSec S (ULift.{u+1} ℤ) (wcEtTop S) (ULift.up 1))) =
      ((((wcEtInv W.hom).obj (wcEtUnitSheaf S)).obj.map
        (wcEtInvLift W.hom (wcEtTop S) (wcEtTop W.left) W.hom hh₀).op).hom
        (((toSheafify (Scheme.smallEtaleTopology W.left)
          ((wcEtBaseChange W.hom).op.lan.obj (wcEtUnitSheaf S).obj)).app
            (Opposite.op ((wcEtBaseChange W.hom).obj (wcEtTop S)))).hom
          ((((wcEtBaseChange W.hom).op.lanUnit.app (wcEtUnitSheaf S).obj).app
            (Opposite.op (wcEtTop S))).hom
            (wcConstSec S (ULift.{u+1} ℤ) (wcEtTop S) (ULift.up 1))))) :=
    NatTrans.naturality_apply (toSheafify (Scheme.smallEtaleTopology W.left)
      ((wcEtBaseChange W.hom).op.lan.obj (wcEtUnitSheaf S).obj))
      (wcEtInvLift W.hom (wcEtTop S) (wcEtTop W.left) W.hom hh₀).op _
  have h3' : ∀ N : Sheaf (Scheme.smallEtaleTopology W.left) AddCommGrpCat.{u+1},
      Function.Bijective (fun φ : (wcEtInv W.hom).obj (wcEtUnitSheaf S) ⟶ N =>
        (φ.hom.app (Opposite.op (wcEtTop W.left))).hom
          (wcEtInvRho W.hom (wcEtUnitSheaf S) (wcEtTop S) (wcEtTop W.left) W.hom
            ((Category.comp_id W.hom).trans (Category.id_comp W.hom).symm)
            (wcConstSec S (ULift.{u+1} ℤ) (wcEtTop S) (ULift.up 1)))) := by
    intro N
    rw [hy]
    exact h3 N
  have h4 := transfer (wcEtToProEt W.left) (Scheme.smallEtaleTopology W.left)
    (Scheme.ProEt.topology W.left) ((wcEtInv W.hom).obj (wcEtUnitSheaf S)) (wcEtTop W.left) _ h3'
  have h5 := transfer (wcSliceFunctor S W) (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)
    ((wcEpsInv W.left).obj ((wcEtInv W.hom).obj (wcEtUnitSheaf S)))
    ((wcEtToProEt W.left).obj (wcEtTop W.left)) _ h4
  let j' : (wcSliceFunctor S W).obj ((wcEtToProEt W.left).obj (wcEtTop W.left)) ⟶ W :=
    MorphismProperty.Over.homMk (𝟙 W.left) rfl trivial
  have hj₁ : wcSliceTopHom S W ≫ j' = 𝟙 W :=
    MorphismProperty.Over.Hom.ext (by
      show 𝟙 W.left ≫ 𝟙 W.left = 𝟙 W.left
      exact Category.id_comp _)
  have hj₂ : j' ≫ wcSliceTopHom S W =
      𝟙 ((wcSliceFunctor S W).obj ((wcEtToProEt W.left).obj (wcEtTop W.left))) :=
    MorphismProperty.Over.Hom.ext (by
      show 𝟙 W.left ≫ 𝟙 W.left = 𝟙 W.left
      exact Category.id_comp _)
  have h6 := restrict (Scheme.ProEt.topology S)
    ((wcSliceExt S W).obj ((wcEpsInv W.left).obj ((wcEtInv W.hom).obj (wcEtUnitSheaf S))))
    _ _ hj₁ hj₂ _ h5
  obtain ⟨c, hc⟩ := final _ _ _ _ hfree h6
  exact ⟨c, hc⟩

theorem wc_slice_sigma (S : Scheme.{u}) (W W' : S.ProEt) (t : W' ⟶ W)
    [(wcSliceFunctor S W).IsContinuous (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology S)]
    [(wcSliceFunctor S W').IsContinuous (Scheme.ProEt.topology W'.left) (Scheme.ProEt.topology S)] :
    ∃ σ : wcEtInv t.left ⋙ wcEpsInv W'.left ⋙ wcSliceExt S W' ⟶ wcEpsInv W.left ⋙ wcSliceExt S W,
