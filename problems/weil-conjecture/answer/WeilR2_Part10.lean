    exact MorphismProperty.of_isPullback (P := @IsAffineHom) (sqB p σ j j' h).flip inferInstance
  · intro p σ
    obtain ⟨hc0, hq0⟩ := C6 p σ 0
    haveI := hc0
    haveI := hq0
    haveI := (hqc (l + 0)).2
    haveI := hUinf.1
    haveI := hUinf.2
    haveI : QuasiCompact (wcWP (U' 0) (V' 0) (f' 0) σ).hom :=
      @quasiCompact_of_compactSpace _ _ (wcWP (U' 0) (V' 0) (f' 0) σ).hom hc0 (hqc (l + 0)).2
    haveI : QuasiSeparated (wcWP (U' 0) (V' 0) (f' 0) σ).hom :=
