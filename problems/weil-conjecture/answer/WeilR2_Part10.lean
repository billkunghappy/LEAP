by
  classical

  have hbc : ∀ {X B : Scheme.{u}} (g : X ⟶ B), (wcEtBaseChange g).IsContinuous
      (Scheme.smallEtaleTopology B) (Scheme.smallEtaleTopology X) := by
    have hjs : ∀ (Y : Scheme.{u}) (V : Y.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : Y.Etale)
