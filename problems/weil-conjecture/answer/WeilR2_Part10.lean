    have hs := Classical.choose_spec hψex
    unfold wcEtInvCompatInv at hs
    rw [hc]
    exact hs V₀ O₁₀ h₁₀ hh₁₀ O₂₀ h₂₀ hh₂₀ x₀

  have hρ : ∀ {Z Y : Scheme.{u}} (g : Z ⟶ Y)
      (B : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) (V : Y.Etale) (O : Z.Etale)
      (h h' : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ g) (hh' : h' ≫ V.hom = O.hom ≫ g),
      h = h' → ∀ x, wcEtInvRho g B V O h hh x = wcEtInvRho g B V O h' hh' x := by
    intro Z Y g B V O h h' hh hh' e x
    subst e
    rfl
  have hT : ∀ (k l m : ℕ) (h₁ : k ≤ l) (h₂ : l ≤ m),
      (D.map (homOfLE h₂).op).left ≫ (D.map (homOfLE h₁).op).left =
        (D.map (homOfLE (h₁.trans h₂)).op).left := by
    intro k l m h₁ h₂
    have e : (homOfLE h₂).op ≫ (homOfLE h₁).op = (homOfLE (h₁.trans h₂)).op :=
      Quiver.Hom.unop_inj (Subsingleton.elim _ _)
    rw [← e]
    exact (congrArg (fun f => f.left) (D.map_comp (homOfLE h₂).op (homOfLE h₁).op)).symm
  have hA' : ∀ (k l : ℕ) (h : k ≤ l), (a l).left ≫ (D.map (homOfLE h).op).left = (a k).left := by
    intro k l h
