        (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ M =>
          (g.hom.app (Opposite.op (wcEtTop Y))).hom
            (wcConstSec Y (ULift.{u+1} ℤ) (wcEtTop Y) (ULift.up 1))) =
        ⇑((adj.homEquiv (AddCommGrpCat.of (ULift.{u+1} ℤ)) M).trans
          (ev (M.obj.obj (Opposite.op (wcEtTop Y))))) := by
