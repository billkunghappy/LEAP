    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠
        S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (k : ℕ)
    (θr : L.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ZMod (ℓ ^ r))).over W) :
    ∃ Γ : (Fin k → ZMod (ℓ ^ r)) →+ wcCohG K (wcP1Over K) hP L 2,
      Function.Surjective Γ ∧
      ∀ (γ : W ⟶ W) (g : (Fin k → ZMod (ℓ ^ r)) →+ (Fin k → ZMod (ℓ ^ r))), γ ≫ w = w →
        (∀ (s : L.obj.obj (Opposite.op W)) (z : W.left),
          (show C(↥W.left, Fin k → ZMod (ℓ ^ r)) from
            ((θr.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
          g ((show C(↥W.left, Fin k → ZMod (ℓ ^ r)) from
            ((θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
        ∀ a, Γ (g a) = Γ a :=
by
  obtain ⟨Ub, hUb, ℰ, e, πE, hπE, hfin, het, hsE, hEc, θE, V, ι, c, hVc, hce, hcomp, hlift⟩ :=
