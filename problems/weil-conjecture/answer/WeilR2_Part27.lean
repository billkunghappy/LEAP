theorem wc_vqtt_zl_rank_bound (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (κ : Type) [Fintype κ]
    (H : Type*) [AddCommGroup H] (sc : ℚ_[ℓ] → H →+ H)
    (hsadd : ∀ (a b : ℚ_[ℓ]) (y : H), sc (a + b) y = sc a y + sc b y)
    (hsmul : ∀ (a b : ℚ_[ℓ]) (y : H), sc (a * b) y = sc a (sc b y))
    (hsone : ∀ y : H, sc 1 y = y)
    (A : Type*) [AddCommGroup A] [Module ℤ_[ℓ] A]
    (ι₀ : A →+ H) (hι₀ : ∀ (a : ℤ_[ℓ]) (z : A), ι₀ (a • z) = sc (a : ℚ_[ℓ]) (ι₀ z))
    (hspan : ∀ y : H, ∃ (n : ℕ) (z : A), (ℓ ^ n : ℕ) • y = ι₀ z)
    (B : ℕ → Type*) [∀ r, AddCommGroup (B r)] (π : ∀ r, A →+ B r)
    (hker : ∀ (r : ℕ) (z : A), π r z = 0 → ∃ z' : A, z = (ℓ ^ r : ℕ) • z')
    (hsep : ∀ z : A, (∀ r, π r z = 0) → z = 0)
    (Γ : ∀ r : ℕ, (κ → ZMod (ℓ ^ r)) →+ B r) (hΓ : ∀ r, Function.Surjective (Γ r))
    (Nz : Submodule ℤ_[ℓ] (κ → ℤ_[ℓ]))
    (hΓN : ∀ (r : ℕ) (u : κ → ℤ_[ℓ]), u ∈ Nz → Γ r (fun i => PadicInt.toZModPow r (u i)) = 0)
    (N : Submodule ℚ_[ℓ] (κ → ℚ_[ℓ])) (Q : (κ → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (κ → ℚ_[ℓ]))
    (hNz : ∀ u ∈ Nz, Q.symm (fun i => (u i : ℚ_[ℓ])) ∈ N)
    (hNq : ∀ v ∈ N, ∃ (n : ℕ) (u : κ → ℤ_[ℓ]), u ∈ Nz ∧
      (fun i => (u i : ℚ_[ℓ])) = ((ℓ : ℚ_[ℓ]) ^ n) • Q v) :
    ∀ (n : ℕ) (x : Fin n → H), (∀ c : Fin n → ℚ_[ℓ], ∑ i, sc (c i) (x i) = 0 → c = 0) →
      n ≤ Module.finrank ℚ_[ℓ] ((κ → ℚ_[ℓ]) ⧸ N) :=
by
  classical
  intro n x hx
  generalize hd : Module.finrank ℚ_[ℓ] ((κ → ℚ_[ℓ]) ⧸ N) = d
  have hℓp : ℓ.Prime := Fact.out
  have hℓ1 : 1 < ℓ := hℓp.one_lt
  have hℓ0 : ℓ ≠ 0 := hℓp.ne_zero
  have hℓR : (1 : ℝ) < ℓ := by exact_mod_cast hℓ1

  letI instH : Module ℚ_[ℓ] H :=
    { smul := fun c y => sc c y
      one_smul := hsone
      mul_smul := hsmul
      smul_zero := fun c => map_zero (sc c)
      smul_add := fun c a b => map_add (sc c) a b
      add_smul := hsadd
      zero_smul := fun y => by
        show sc 0 y = 0
        have h := hsadd 0 0 y
        rw [add_zero] at h
