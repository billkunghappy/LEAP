  have hχv : ∀ x, wcCxJMap K hP (wcSpfTruncMap I.cocomplex (ℓ ^ n) (lamI x)) ≫ χ.inv =
      χ.inv ≫ wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n) (wcCxJMap K hP (lamI x)) := fun x => by
    rw [Iso.comp_inv_eq, Category.assoc, hχu x, Iso.inv_hom_id_assoc]
  let Tχ : wcSpfTwCx (wcTruncKerRes (wcCxJ K hP I.cocomplex) (ℓ ^ n))
