  have hqβ : QuasiIso heq.hom := heq.quasiIso_hom

  obtain ⟨χ, hχlin, hχFr⟩ := wcU_sms_trunc_comparison K hP (q' ≫ Uo.ι)
    (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (ℓ ^ n) hNpos I
  have hχu : ∀ x, wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n) (wcCxJMap K hP (lamI x)) ≫ χ.hom =
      χ.hom ≫ wcCxJMap K hP (wcSpfTruncMap I.cocomplex (ℓ ^ n) (lamI x)) := fun x =>
