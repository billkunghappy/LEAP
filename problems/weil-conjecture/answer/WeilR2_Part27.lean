      ∀ x, T.α0 (FM x) = (Fr.f 0).hom (T.α0 x) + h1 (T.d0 x) := by
    have hz : ∀ j : Fin k, (D.d 0 1).hom ((Fr.f 0).hom (T.α0 (π (Pi.single j 1))) +
        h1 (T.d0 (π (Pi.single j 1)))) = T.α1 (F1 (T.d0 (π (Pi.single j 1)))) := by
      intro j
      rw [map_add, Frd, T.hc0, hH1, T.hdd, map_zero]
      abel
    have hzz : ∀ j : Fin k, T.d1 (F1 (T.d0 (π (Pi.single j 1)))) = 0 := by
      intro j; rw [hC1, T.hdd, map_zero]
    choose x' hx' using fun j => T.q1i _ (hzz j) ⟨_, hz j⟩
    have hy : ∀ j : Fin k, (D.d 0 1).hom (T.α0 (x' j) - ((Fr.f 0).hom (T.α0 (π (Pi.single j 1))) +
        h1 (T.d0 (π (Pi.single j 1))))) = 0 := by
      intro j
      rw [map_sub, hz, T.hc0, hx', sub_self]
    choose c hc hca using fun j => T.q0s _ (hy j)
    have hXd : ∀ j, T.d0 (x' j - c j) = F1 (T.d0 (π (Pi.single j 1))) := by
      intro j; rw [map_sub, hx', hc, sub_zero]
    have hXa : ∀ j, T.α0 (x' j - c j) = (Fr.f 0).hom (T.α0 (π (Pi.single j 1))) +
        h1 (T.d0 (π (Pi.single j 1))) := by
      intro j; rw [map_sub, hca, sub_sub_cancel]
    refine ⟨(Fintype.linearCombination (MonoidAlgebra ℤ_[ℓ] Γ) (fun j => x' j - c j)) ∘ₗ sec,
      fun x => ?_, fun x => ?_⟩
    · rw [LinearMap.comp_apply, Fintype.linearCombination_apply, map_sum]
      conv_rhs => rw [← hπs x, pdec (sec x), map_sum, map_sum, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_smul, map_smul, map_smul, map_smul, hXd]
    · rw [LinearMap.comp_apply, Fintype.linearCombination_apply, map_sum]
      have ea : T.α0 x = ∑ j, ((lamD (sec x j)).f 0).hom (T.α0 (π (Pi.single j 1))) := by
        conv_lhs => rw [← hπs x, pdec (sec x), map_sum, map_sum]
        exact Finset.sum_congr rfl (fun j _ => by rw [map_smul, T.hlin0])
      have eh : h1 (T.d0 x) =
          ∑ j, ((lamD (sec x j)).f 0).hom (h1 (T.d0 (π (Pi.single j 1)))) := by
        conv_lhs => rw [← hπs x, pdec (sec x), map_sum, map_sum, map_sum]
        exact Finset.sum_congr rfl (fun j _ => by rw [map_smul, map_smul, hh1])
      rw [ea, eh, map_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [T.hlin0, hXa, map_add, Frl]

  have hmat : ∀ {m n : ℕ} (g : (Fin m → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)]
      (Fin n → (MonoidAlgebra ℤ_[ℓ] Γ))) (v : Fin m → (MonoidAlgebra ℤ_[ℓ] Γ)),
      Matrix.vecMul v (LinearMap.toMatrixRight' g) = g v := by
    intro m n g v
    rw [← Matrix.toLinearMapRight'_apply]
    show LinearMap.toMatrixRight'.symm (LinearMap.toMatrixRight' g) v = g v
    rw [LinearEquiv.symm_apply_apply]
  have hcomp : ∀ {l m n : ℕ} (f : (Fin l → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)]
      (Fin m → (MonoidAlgebra ℤ_[ℓ] Γ)))
      (g : (Fin m → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)]
        (Fin n → (MonoidAlgebra ℤ_[ℓ] Γ)))
      (h : (Fin l → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)]
        (Fin n → (MonoidAlgebra ℤ_[ℓ] Γ))),
      (∀ v, g (f v) = h v) →
      LinearMap.toMatrixRight' f * LinearMap.toMatrixRight' g = LinearMap.toMatrixRight' h := by
    intro l m n f g h hfg
    rw [← LinearMap.toMatrixRight'_comp]
    congr 1
    exact LinearMap.ext hfg
  let kf : ℕ → ℕ := fun i => match i with
    | 0 => k | 1 => T.a | 2 => T.b | _ + 3 => 0
  let E0 := LinearMap.toMatrixRight' (sec ∘ₗ π)
  let D0 := LinearMap.toMatrixRight' (T.d0 ∘ₗ π)
  let D1 := LinearMap.toMatrixRight' T.d1
  let G0 := LinearMap.toMatrixRight' (sec ∘ₗ FM ∘ₗ π)
  let G1 := LinearMap.toMatrixRight' F1
  let G2 := LinearMap.toMatrixRight' F2
  let εf : ∀ i, Matrix (Fin (kf i)) (Fin (kf i)) (MonoidAlgebra ℤ_[ℓ] Γ) := fun i => match i with
    | 0 => E0 | 1 => 1 | 2 => 1 | _ + 3 => 1
  let δf : ∀ i, Matrix (Fin (kf i)) (Fin (kf (i + 1))) (MonoidAlgebra ℤ_[ℓ] Γ) :=
    fun i => match i with
    | 0 => D0 | 1 => D1 | 2 => 0 | _ + 3 => 0
  let ff : ∀ i, Matrix (Fin (kf i)) (Fin (kf i)) (MonoidAlgebra ℤ_[ℓ] Γ) := fun i => match i with
    | 0 => G0 | 1 => G1 | 2 => G2 | _ + 3 => 0
  have hE0 : E0 * E0 = E0 := hcomp _ _ _ (fun v => by simp [hπs])
  have hE0D : E0 * D0 = D0 := hcomp _ _ _ (fun v => by simp [hπs])
  have hDD : D0 * D1 = 0 := by
    rw [hcomp _ _ (0 : (Fin k → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)]
      (Fin T.b → (MonoidAlgebra ℤ_[ℓ] Γ))) (fun v => by simp [T.hdd]), map_zero]
  have hEG : E0 * G0 = G0 := hcomp _ _ _ (fun v => by simp [hπs])
  have hGE : G0 * E0 = G0 := hcomp _ _ _ (fun v => by simp [hπs])
  have hDG : D0 * G1 = G0 * D0 := by
    rw [hcomp _ _ (F1 ∘ₗ T.d0 ∘ₗ π) (fun v => rfl), hcomp _ _ (F1 ∘ₗ T.d0 ∘ₗ π)
      (fun v => by simp [hπs, hC0])]
  have hDG1 : D1 * G2 = G1 * D1 := by
    rw [hcomp _ _ (F2 ∘ₗ T.d1) (fun v => rfl), hcomp _ _ (F2 ∘ₗ T.d1) (fun v => by simp [hC1])]
  let P : wcGModel ℓ Γ :=
    { k := kf
      hk := fun i hi => by
        obtain ⟨n, rfl⟩ : ∃ n, i = n + 3 := ⟨i - 3, by omega⟩
        rfl
      ε := εf
      hε := fun i => match i with
        | 0 => hE0 | 1 => Matrix.mul_one _ | 2 => Matrix.mul_one _ | _ + 3 => Matrix.mul_one _
      δ := δf
      hδδ := fun i => match i with
        | 0 => hDD | 1 => Matrix.mul_zero _ | 2 => Matrix.zero_mul _ | _ + 3 => Matrix.zero_mul _
      hεδ := fun i => match i with
        | 0 => hE0D | 1 => Matrix.one_mul _ | 2 => Matrix.one_mul _ | _ + 3 => Matrix.one_mul _
      hδε := fun i => match i with
        | 0 => Matrix.mul_one _ | 1 => Matrix.mul_one _ | 2 => Matrix.zero_mul _
        | _ + 3 => Matrix.zero_mul _
      f := ff
      hεf := fun i => match i with
        | 0 => hEG | 1 => Matrix.one_mul _ | 2 => Matrix.one_mul _ | _ + 3 => Matrix.one_mul _
      hfε := fun i => match i with
        | 0 => hGE | 1 => Matrix.mul_one _ | 2 => Matrix.mul_one _ | _ + 3 => Matrix.mul_one _
      hδf := fun i => match i with
        | 0 => hDG | 1 => hDG1 | 2 => (Matrix.zero_mul _).trans (Matrix.mul_zero _).symm
        | _ + 3 => (Matrix.zero_mul _).trans (Matrix.mul_zero _).symm }

  have hKd : ∀ i, (wcGModelAb P).d i (i + 1) =
      AddCommGrpCat.ofHom (wcULiftHom (wcVecMulHom (P.ε i) (P.ε (i + 1)) (P.δ i) (P.hδε i))) := by
    intro i
    dsimp only [wcGModelAb]
    exact CochainComplex.of_d _ _ i
  have hsub : ∀ (n : ℕ) (x : (wcGModelAb P).X (n + 3)), x = 0 := by
    intro n x
    exact ULift.ext _ _ (Subtype.ext (funext fun i => Fin.elim0 i))
  let φf : ∀ i, (wcGModelAb P).X i ⟶ D.X i := fun i => match i with
    | 0 => AddCommGrpCat.ofHom ((T.α0.comp π.toAddMonoidHom).comp
        ((wcIdemSub E0).subtype.comp AddEquiv.ulift.toAddMonoidHom))
    | 1 => AddCommGrpCat.ofHom (T.α1.comp
        ((wcIdemSub (1 : Matrix (Fin T.a) (Fin T.a) (MonoidAlgebra ℤ_[ℓ] Γ))).subtype.comp
          AddEquiv.ulift.toAddMonoidHom))
    | 2 => AddCommGrpCat.ofHom (T.α2.comp
        ((wcIdemSub (1 : Matrix (Fin T.b) (Fin T.b) (MonoidAlgebra ℤ_[ℓ] Γ))).subtype.comp
          AddEquiv.ulift.toAddMonoidHom))
    | _ + 3 => 0
  let φ : wcGModelAb P ⟶ D := HomologicalComplex.Hom.mk φf (by
    rintro i j (rfl : i + 1 = j)
    rw [hKd i]
    match i with
    | 0 =>
      ext x
      show (D.d 0 1).hom (T.α0 (π x.down.1)) =
        T.α1 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' (T.d0 ∘ₗ π)))
      rw [hmat]
      exact T.hc0 _
    | 1 =>
      ext x
      show (D.d 1 2).hom (T.α1 x.down.1) =
        T.α2 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' T.d1))
      rw [hmat]
      exact T.hc1 _
    | 2 =>
      ext x
      show (D.d 2 3).hom (T.α2 x.down.1) = 0
      exact T.hc2 _
    | n + 3 =>
      ext x
      rw [hsub n x]
      simp only [map_zero])
  have hinj : ∀ (n : ℕ) (x : (wcGModelAb P).X n), ((wcGModelAb P).d n (n + 1)).hom x = 0 →
      ∀ y : D.X (n - 1), (φ.f n).hom x = (D.d (n - 1) n).hom y →
      ∃ x' : (wcGModelAb P).X (n - 1), ((wcGModelAb P).d (n - 1) n).hom x' = x := by
    intro n
    match n with
    | 0 =>
      intro x hx y hxy
      rw [hKd] at hx
      have h2 : T.d0 (π x.down.1) = 0 :=
        (hmat (T.d0 ∘ₗ π) x.down.1).symm.trans (congrArg (fun z => (ULift.down z).1) hx)
      rw [D.shape (0 - 1) 0 (by decide)] at hxy
      have ha : T.α0 (π x.down.1) = 0 := hxy
      have hπ0 : π x.down.1 = 0 := T.q0i _ h2 ha
      have hv : x.down.1 = 0 := by
        have hm : Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' (sec ∘ₗ π)) = x.down.1 :=
          x.down.2
        rw [hmat, LinearMap.comp_apply, hπ0, map_zero] at hm
        exact hm.symm
      refine ⟨0, ?_⟩
      rw [map_zero]
      exact (ULift.ext _ _ (Subtype.ext hv)).symm
    | 1 =>
      intro x hx y hxy
      rw [hKd] at hx
      have hd : T.d1 x.down.1 = 0 :=
        (hmat T.d1 x.down.1).symm.trans (congrArg (fun z => (ULift.down z).1) hx)
      have hxy' : (D.d 0 1).hom y = T.α1 x.down.1 := hxy.symm
      obtain ⟨m, hm⟩ := T.q1i _ hd ⟨y, hxy'⟩
      have hmem : Matrix.vecMul (sec m) (LinearMap.toMatrixRight' (sec ∘ₗ π)) = sec m := by
        rw [hmat, LinearMap.comp_apply, hπs]
      refine ⟨ULift.up ⟨sec m, hmem⟩, ?_⟩
      show ((wcGModelAb P).d 0 (0 + 1)).hom _ = x
      rw [hKd]
      apply ULift.ext
      apply Subtype.ext
      show Matrix.vecMul (sec m) (LinearMap.toMatrixRight' (T.d0 ∘ₗ π)) = x.down.1
      rw [hmat, LinearMap.comp_apply, hπs, hm]
    | 2 =>
      intro x hx y hxy
      have hxy' : (D.d 1 2).hom y = T.α2 x.down.1 := hxy.symm
      obtain ⟨p', hp'⟩ := T.q2i _ ⟨y, hxy'⟩
      refine ⟨ULift.up ⟨p', Matrix.vecMul_one p'⟩, ?_⟩
      show ((wcGModelAb P).d 1 (1 + 1)).hom _ = x
      rw [hKd]
      apply ULift.ext
      apply Subtype.ext
      show Matrix.vecMul p' (LinearMap.toMatrixRight' T.d1) = x.down.1
      rw [hmat, hp']
    | n + 3 =>
      intro x hx y hxy
      refine ⟨0, ?_⟩
      rw [map_zero]
      exact (hsub n x).symm
  have hsurj : ∀ (n : ℕ) (y : D.X n), (D.d n (n + 1)).hom y = 0 →
      ∃ x : (wcGModelAb P).X n, ((wcGModelAb P).d n (n + 1)).hom x = 0 ∧
      ∃ w : D.X (n - 1), (D.d (n - 1) n).hom w = (φ.f n).hom x - y := by
    intro n
    match n with
    | 0 =>
      intro y hy
      obtain ⟨m, hm0, hma⟩ := T.q0s y hy
      have hmem : Matrix.vecMul (sec m) (LinearMap.toMatrixRight' (sec ∘ₗ π)) = sec m := by
        rw [hmat, LinearMap.comp_apply, hπs]
      refine ⟨ULift.up ⟨sec m, hmem⟩, ?_, 0, ?_⟩
      · rw [hKd]
        apply ULift.ext
        apply Subtype.ext
        show Matrix.vecMul (sec m) (LinearMap.toMatrixRight' (T.d0 ∘ₗ π)) = 0
        rw [hmat, LinearMap.comp_apply, hπs, hm0]
      · rw [map_zero]
        show (0 : D.X 0) = T.α0 (π (sec m)) - y
        rw [hπs, hma, sub_self]
    | 1 =>
      intro y hy
      obtain ⟨p, hp, w, hw⟩ := T.q1s y hy
      refine ⟨ULift.up ⟨p, Matrix.vecMul_one p⟩, ?_, w, hw⟩
      rw [hKd]
      apply ULift.ext
      apply Subtype.ext
      show Matrix.vecMul p (LinearMap.toMatrixRight' T.d1) = 0
      rw [hmat, hp]
    | 2 =>
      intro y hy
      obtain ⟨p, w, hw⟩ := T.q2s y hy
      exact ⟨ULift.up ⟨p, Matrix.vecMul_one p⟩, hsub 0 _, w, hw⟩
    | n + 3 =>
      intro y hy
      obtain ⟨w, hw⟩ := T.qhi (n + 3) (by omega) y hy
      refine ⟨0, map_zero _, -w, ?_⟩
      rw [map_neg, hw, map_zero, zero_sub]

  have hlin : ∀ x : MonoidAlgebra ℤ_[ℓ] Γ, wcGModelSmul P x ≫ φ = φ ≫ lamD x := by
    intro r
    apply HomologicalComplex.hom_ext
    intro i
    rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f]
    match i with
    | 0 =>
      ext x
      show T.α0 (π (r • x.down.1)) = ((lamD r).f 0).hom (T.α0 (π x.down.1))
      rw [map_smul, T.hlin0]
    | 1 =>
      ext x
      show T.α1 (r • x.down.1) = ((lamD r).f 1).hom (T.α1 x.down.1)
      exact T.hlin1 _ _
    | 2 =>
      ext x
      show T.α2 (r • x.down.1) = ((lamD r).f 2).hom (T.α2 x.down.1)
      exact T.hlin2 _ _
    | n + 3 =>
      ext x
      rw [hsub n x, map_zero, map_zero]
  let hom : ∀ i j, (wcGModelAb P).X i ⟶ D.X j := fun i j => match i, j with
    | 1, 0 => AddCommGrpCat.ofHom (h1.comp
        ((wcIdemSub (1 : Matrix (Fin T.a) (Fin T.a) (MonoidAlgebra ℤ_[ℓ] Γ))).subtype.comp
          AddEquiv.ulift.toAddMonoidHom))
    | 2, 1 => AddCommGrpCat.ofHom (h2.comp
        ((wcIdemSub (1 : Matrix (Fin T.b) (Fin T.b) (MonoidAlgebra ℤ_[ℓ] Γ))).subtype.comp
          AddEquiv.ulift.toAddMonoidHom))
    | _, _ => 0
  let htpy : Homotopy (wcGModelFrob P ≫ φ) (φ ≫ Fr) :=
    { hom := hom
      zero := by
        intro i j hij
        match i, j with
        | 0, _ => rfl
        | 1, 0 => exact absurd rfl hij
        | 1, _ + 1 => rfl
        | 2, 0 => rfl
        | 2, 1 => exact absurd rfl hij
        | 2, _ + 2 => rfl
        | _ + 3, _ => rfl
      comm := by
        intro i
        match i with
        | 0 =>
          rw [Homotopy.dNext_cochainComplex, Homotopy.prevD_zero_cochainComplex, hKd]
          ext x
          show T.α0 (π (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' (sec ∘ₗ FM ∘ₗ π)))) =
            h1 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' (T.d0 ∘ₗ π))) + 0 +
              (Fr.f 0).hom (T.α0 (π x.down.1))
          rw [hmat, hmat, LinearMap.comp_apply, LinearMap.comp_apply, LinearMap.comp_apply, hπs,
            hH0, add_zero, add_comm]
        | 1 =>
          rw [Homotopy.dNext_cochainComplex, hKd,
            show prevD 1 hom = hom 1 0 ≫ D.d 0 1 from Homotopy.prevD_succ_cochainComplex hom 0]
          ext x
          show T.α1 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' F1)) =
            h2 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' T.d1)) +
              (D.d 0 1).hom (h1 x.down.1) + (Fr.f 1).hom (T.α1 x.down.1)
          rw [hmat, hmat, hH1]
          abel
        | 2 =>
          rw [Homotopy.dNext_cochainComplex, hKd,
            show prevD 2 hom = hom 2 1 ≫ D.d 1 2 from Homotopy.prevD_succ_cochainComplex hom 1]
          ext x
          show T.α2 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' F2)) =
            0 + (D.d 1 2).hom (h2 x.down.1) + (Fr.f 2).hom (T.α2 x.down.1)
          rw [hmat, hH2]
          abel
        | n + 3 =>
          ext x
          rw [hsub n x, map_zero, map_zero] }

  have hzc : ∀ (r : MonoidAlgebra ℤ_[ℓ] Γ) (i j : ℕ), hom i j = 0 →
      (wcGModelSmul P r).f i ≫ hom i j = hom i j ≫ (lamD r).f j := by
    intro r i j h
    rw [h, Limits.comp_zero, Limits.zero_comp]
  have hhomlin : ∀ (r : MonoidAlgebra ℤ_[ℓ] Γ) (i j : ℕ),
      (wcGModelSmul P r).f i ≫ hom i j = hom i j ≫ (lamD r).f j := by
    intro r i j
    match i, j with
    | 0, _ => exact hzc r _ _ rfl
    | 1, 0 =>
      ext x
      show h1 (r • x.down.1) = ((lamD r).f 0).hom (h1 x.down.1)
      exact hh1 r _
    | 1, _ + 1 => exact hzc r _ _ rfl
    | 2, 0 => exact hzc r _ _ rfl
    | 2, 1 =>
      ext x
      show h2 (r • x.down.1) = ((lamD r).f 1).hom (h2 x.down.1)
      exact hh2 r _
    | 2, _ + 2 => exact hzc r _ _ rfl
    | _ + 3, _ => exact hzc r _ _ rfl
  refine ⟨P, φ, s1 φ hinj hsurj, hlin, htpy.symm, ?_⟩
  intro r i j
  rw [Homotopy.symm_hom]
  show (wcGModelSmul P r).f i ≫ (-hom i j) = (-hom i j) ≫ (lamD r).f j
  rw [Preadditive.comp_neg, Preadditive.neg_comp, hhomlin r i j]

theorem wcU_sms_equivariant_lift (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Γ : Type u) [Group Γ]
    (P : wcGModel ℓ Γ) (D : CochainComplex AddCommGrpCat.{u+1} ℕ)
    (lamD : MonoidAlgebra ℤ_[ℓ] Γ → (D ⟶ D)) (hD : wcRingAct lamD) (N : ℕ)
    (hdiv : ∀ j (y : D.X j), ∃ z, N • z = y) (j k : ℕ)
    (f : (wcGModelAb P).X k →+ D.X j)
    (hf : ∀ x v, f (((wcGModelSmul P x).f k).hom v) = ((lamD x).f j).hom (f v)) :
    ∃ σ : (wcGModelAb P).X k →+ D.X j, (∀ v, N • σ v = f v) ∧
      ∀ x v, σ (((wcGModelSmul P x).f k).hom v) = ((lamD x).f j).hom (σ v) :=
by
  classical
  let act : MonoidAlgebra ℤ_[ℓ] Γ → (D.X j →+ D.X j) := fun x => ((lamD x).f j).hom
  have hadd : ∀ a b z, act (a + b) z = act a z + act b z := by
    intro a b z
    show ((lamD (a + b)).f j).hom z = _
    rw [hD.2.1 a b]
    rfl
  have hmul : ∀ a b z, act (a * b) z = act a (act b z) := by
    intro a b z
    show ((lamD (a * b)).f j).hom z = _
    rw [hD.2.2 a b]
    rfl
  have h0 : ∀ z, act 0 z = 0 := fun z =>
    add_left_cancel (by rw [← hadd, add_zero, add_zero] : act 0 z + act 0 z = act 0 z + 0)
  let up : wcIdemSub (P.ε k) → (wcGModelAb P).X k := fun w =>
    (ULift.up w : ULift.{u+1} (wcIdemSub (P.ε k)))
  let dn : (wcGModelAb P).X k → wcIdemSub (P.ε k) := fun v =>
    ULift.down (v : ULift.{u+1} (wcIdemSub (P.ε k)))
  let gen : Fin (P.k k) → wcIdemSub (P.ε k) := fun a =>
    ⟨Matrix.vecMul (Pi.single a 1) (P.ε k), by
      show Matrix.vecMul (Matrix.vecMul (Pi.single a 1) (P.ε k)) (P.ε k) = _
      rw [Matrix.vecMul_vecMul, P.hε k]⟩
  have hdecomp : ∀ w : wcIdemSub (P.ε k), ∑ a, wcSmulHom (w.1 a) (P.ε k) (gen a) = w := by
    intro w
    apply Subtype.ext
    rw [AddSubgroup.val_finsetSum]
    have hw : Matrix.vecMul w.1 (P.ε k) = w.1 := w.2
    calc ∑ a, ((wcSmulHom (w.1 a) (P.ε k) (gen a) : wcIdemSub (P.ε k)) : Fin (P.k k) → _)
        = ∑ a, Matrix.vecMul (Pi.single a (w.1 a)) (P.ε k) := by
          refine Finset.sum_congr rfl fun a _ => ?_
          show w.1 a • Matrix.vecMul (Pi.single a 1) (P.ε k) = _
          rw [← Matrix.smul_vecMul, ← Pi.single_smul', smul_eq_mul, mul_one]
      _ = Matrix.vecMul (∑ a, Pi.single a (w.1 a)) (P.ε k) := by rw [Matrix.sum_vecMul]
      _ = w.1 := by rw [Finset.univ_sum_single, hw]
  have hy : ∀ a, ∃ z : D.X j, N • z = f (up (gen a)) := fun a => hdiv j _
  choose y hy using hy
  have hdn : ∀ (s : Finset (Fin (P.k k))) (g : Fin (P.k k) → (wcGModelAb P).X k),
      dn (∑ a ∈ s, g a) = ∑ a ∈ s, dn (g a) := by
    intro s g
    induction s using Finset.induction_on with
    | empty => rfl
    | insert b s hb ih =>
      rw [Finset.sum_insert hb, Finset.sum_insert hb, ← ih]
      rfl
  have hinj : ∀ v w : (wcGModelAb P).X k, dn v = dn w → v = w := fun v w h => congrArg up h
  refine ⟨{ toFun := fun v => ∑ a, act ((dn v).1 a) (y a),
            map_zero' := ?_, map_add' := ?_ }, ?_, ?_⟩
  · show ∑ a, act ((dn 0).1 a) (y a) = 0
    exact Finset.sum_eq_zero fun a _ => h0 (y a)
  · intro v w
    show ∑ a, act ((dn (v + w)).1 a) (y a) =
      ∑ a, act ((dn v).1 a) (y a) + ∑ a, act ((dn w).1 a) (y a)
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [← hadd]
    rfl
  · intro v
    show N • ∑ a, act ((dn v).1 a) (y a) = f v
    rw [Finset.smul_sum]
    have e1 : ∀ a, N • act ((dn v).1 a) (y a) =
        f (((wcGModelSmul P ((dn v).1 a)).f k).hom (up (gen a))) := by
      intro a
      rw [hf, ← map_nsmul, hy a]
    rw [Finset.sum_congr rfl fun a _ => e1 a, ← map_sum]
    congr 1
    apply hinj
    rw [hdn]
    exact hdecomp (dn v)
  · intro x v
    show ∑ a, act ((dn (((wcGModelSmul P x).f k).hom v)).1 a) (y a) =
      act x (∑ a, act ((dn v).1 a) (y a))
    rw [map_sum]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [← hmul]
    rfl

theorem wcU_bk_qiso_elem {K L : CochainComplex AddCommGrpCat.{v} ℕ} (φ : K ⟶ L) :
    QuasiIso φ ↔
      ((∀ (n : ℕ) (x : K.X n), (K.d n (n + 1)).hom x = 0 → ∀ y : L.X (n - 1),
          (φ.f n).hom x = (L.d (n - 1) n).hom y → ∃ x' : K.X (n - 1), (K.d (n - 1) n).hom x' = x) ∧
       (∀ (n : ℕ) (y : L.X n), (L.d n (n + 1)).hom y = 0 → ∃ x : K.X n,
          (K.d n (n + 1)).hom x = 0 ∧ ∃ w : L.X (n - 1), (L.d (n - 1) n).hom w = (φ.f n).hom x - y)) :=
by
  classical
  have hiso : ∀ n : ℕ, QuasiIsoAt φ n ↔ IsIso (ShortComplex.homologyMap
      ((HomologicalComplex.shortComplexFunctor' AddCommGrpCat (ComplexShape.up ℕ)
        (n - 1) n (n + 1)).map φ)) := by
    intro n
    have hp : (ComplexShape.up ℕ).prev n = n - 1 := by
      rcases n with _ | m
      · exact CochainComplex.prev_nat_zero
      · exact CochainComplex.prev_nat_succ m
    have hn : (ComplexShape.up ℕ).next n = n + 1 := ComplexShape.next_eq' _ rfl
    rw [quasiIsoAt_iff' φ (n - 1) n (n + 1) hp hn, ShortComplex.quasiIso_iff]
  constructor
  · intro h
    have hI : ∀ n : ℕ, IsIso (ShortComplex.homologyMap
        ((HomologicalComplex.shortComplexFunctor' AddCommGrpCat (ComplexShape.up ℕ)
          (n - 1) n (n + 1)).map φ)) := fun n => (hiso n).mp ((quasiIso_iff φ).mp h n)
    refine ⟨?_, ?_⟩
    · intro n x hx y hxy
      haveI := hI n
      have hmono : Mono (ShortComplex.homologyMap
          ((HomologicalComplex.shortComplexFunctor' AddCommGrpCat (ComplexShape.up ℕ)
            (n - 1) n (n + 1)).map φ)) := inferInstance
      rw [ShortComplex.mono_homologyMap_iff_up_to_refinements] at hmono
      have c1 : AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun _ : PUnit.{v+1} => x)) ≫
          K.d n (n + 1) = 0 := by
        ext z
        change (K.d n (n + 1)).hom (FreeAbelianGroup.lift (fun _ : PUnit.{v+1} => x)
          (FreeAbelianGroup.of z)) = 0
        rw [FreeAbelianGroup.lift_apply_of]
        exact hx
      have c2 : AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun _ : PUnit.{v+1} => x)) ≫
          φ.f n = AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun _ : PUnit.{v+1} => y)) ≫
          L.d (n - 1) n := by
        ext z
        change (φ.f n).hom (FreeAbelianGroup.lift (fun _ : PUnit.{v+1} => x)
          (FreeAbelianGroup.of z)) = (L.d (n - 1) n).hom
            (FreeAbelianGroup.lift (fun _ : PUnit.{v+1} => y) (FreeAbelianGroup.of z))
        rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
        exact hxy
      obtain ⟨A', π, hπ, x₁, hfac⟩ := hmono
        (AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun _ : PUnit.{v+1} => x))) c1
        (AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun _ : PUnit.{v+1} => y))) c2
      obtain ⟨t, ht⟩ := (AddCommGrpCat.epi_iff_surjective π).mp hπ
        (FreeAbelianGroup.of PUnit.unit)
      refine ⟨x₁.hom t, ?_⟩
      have e := congrArg (fun f => AddCommGrpCat.Hom.hom f t) hfac
      change (FreeAbelianGroup.lift (fun _ : PUnit.{v+1} => x)) (π.hom t) =
        (K.d (n - 1) n).hom (x₁.hom t) at e
      rw [ht, FreeAbelianGroup.lift_apply_of] at e
      exact e.symm
    · intro n y hy
      haveI := hI n
      have hepi : Epi (ShortComplex.homologyMap
          ((HomologicalComplex.shortComplexFunctor' AddCommGrpCat (ComplexShape.up ℕ)
            (n - 1) n (n + 1)).map φ)) := inferInstance
      rw [ShortComplex.epi_homologyMap_iff_up_to_refinements] at hepi
      have c1 : AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun _ : PUnit.{v+1} => y)) ≫
          L.d n (n + 1) = 0 := by
        ext z
        change (L.d n (n + 1)).hom (FreeAbelianGroup.lift (fun _ : PUnit.{v+1} => y)
          (FreeAbelianGroup.of z)) = 0
        rw [FreeAbelianGroup.lift_apply_of]
        exact hy
      obtain ⟨A', π, hπ, x₂, hx₂, y₁, hfac⟩ := hepi
        (AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun _ : PUnit.{v+1} => y))) c1
      obtain ⟨t, ht⟩ := (AddCommGrpCat.epi_iff_surjective π).mp hπ
        (FreeAbelianGroup.of PUnit.unit)
      obtain ⟨w, hw⟩ : ∃ w : L.X (n - 1), w = y₁.hom t := ⟨_, rfl⟩
      refine ⟨x₂.hom t, ?_, -w, ?_⟩
      · exact congrArg (fun f => AddCommGrpCat.Hom.hom f t) hx₂
      · have e := congrArg (fun f => AddCommGrpCat.Hom.hom f t) hfac
        change (FreeAbelianGroup.lift (fun _ : PUnit.{v+1} => y)) (π.hom t) =
          (φ.f n).hom (x₂.hom t) + (L.d (n - 1) n).hom (y₁.hom t) at e
        rw [ht, FreeAbelianGroup.lift_apply_of, ← hw] at e
        rw [map_neg, e]
        abel
  · rintro ⟨hinj, hsurj⟩
    rw [quasiIso_iff]
    intro n
    rw [hiso n]
    have hmono : Mono (ShortComplex.homologyMap
        ((HomologicalComplex.shortComplexFunctor' AddCommGrpCat (ComplexShape.up ℕ)
          (n - 1) n (n + 1)).map φ)) := by
      rw [ShortComplex.mono_homologyMap_iff_up_to_refinements]
      intro A x₂ hx₂ y₁ hxy
      have hx : ∀ a, (K.d n (n + 1)).hom (x₂ a) = 0 := fun a => by
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f a) hx₂
      have hy : ∀ a, (φ.f n).hom (x₂ a) = (L.d (n - 1) n).hom (y₁ a) := fun a => by
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f a) hxy
      choose g hg using fun a => hinj n (x₂ a) (hx a) (y₁ a) (hy a)
      refine ⟨AddCommGrpCat.of (FreeAbelianGroup A),
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift id), ?_,
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift g), ?_⟩
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro a
        exact ⟨FreeAbelianGroup.of a, by simp [FreeAbelianGroup.lift_apply_of]⟩
      · ext z
        change x₂.hom (FreeAbelianGroup.lift id (FreeAbelianGroup.of z)) =
          (K.d (n - 1) n).hom (FreeAbelianGroup.lift g (FreeAbelianGroup.of z))
        rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
        exact (hg z).symm
    have hepi : Epi (ShortComplex.homologyMap
        ((HomologicalComplex.shortComplexFunctor' AddCommGrpCat (ComplexShape.up ℕ)
          (n - 1) n (n + 1)).map φ)) := by
      rw [ShortComplex.epi_homologyMap_iff_up_to_refinements]
      intro A y₂ hy₂
      have hy : ∀ a, (L.d n (n + 1)).hom (y₂ a) = 0 := fun a => by
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f a) hy₂
      choose x hx w hw using fun a => hsurj n (y₂ a) (hy a)
      refine ⟨AddCommGrpCat.of (FreeAbelianGroup A),
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift id), ?_,
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift x), ?_,
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun a => -w a)), ?_⟩
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro a
        exact ⟨FreeAbelianGroup.of a, by simp [FreeAbelianGroup.lift_apply_of]⟩
      · ext z
        change (K.d n (n + 1)).hom (FreeAbelianGroup.lift x (FreeAbelianGroup.of z)) = 0
        rw [FreeAbelianGroup.lift_apply_of]
        exact hx z
      · ext z
        have e := hw z
        change y₂.hom (FreeAbelianGroup.lift id (FreeAbelianGroup.of z)) =
          (φ.f n).hom (FreeAbelianGroup.lift x (FreeAbelianGroup.of z)) +
          (L.d (n - 1) n).hom (FreeAbelianGroup.lift (fun a => -w a) (FreeAbelianGroup.of z))
        rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of,
          FreeAbelianGroup.lift_apply_of, map_neg]
        change _ = _ + -((L.d (n - 1) n).hom (w z))
        rw [e]
        have key : ∀ (G : Type v) [AddCommGroup G] (a b : G), b = a + -(a - b) :=
          fun G _ a b => by abel
        exact key _ _ _
    exact isIso_of_mono_of_epi _

theorem wcU_bk_chase {A B : CochainComplex AddCommGrpCat.{v} ℕ} (Φ : A ⟶ B) (N : ℕ)
    (hA : ∀ k (a : A.X k), N • a = 0 → a = 0)
    (hB : ∀ k (b : B.X k), ∃ b', N • b' = b)
    (hinj : ∀ (n : ℕ) (x : A.X n), (A.d n (n + 1)).hom x = 0 → ∀ y : B.X (n - 1),
          (Φ.f n).hom x = (B.d (n - 1) n).hom y → ∃ x' : A.X (n - 1), (A.d (n - 1) n).hom x' = x)
    (hsurj : ∀ (n : ℕ) (y : B.X n), (B.d n (n + 1)).hom y = 0 → ∃ x : A.X n,
          (A.d n (n + 1)).hom x = 0 ∧ ∃ w : B.X (n - 1), (B.d (n - 1) n).hom w = (Φ.f n).hom x - y)
    (σ : ∀ k, A.X k →+ B.X k) (hσ : ∀ k a, N • σ k a = (Φ.f k).hom a) :
    (∀ k (c : B.X (k + 1)), N • c = 0 → (B.d (k + 1) (k + 2)).hom c = 0 →
      ∃ (a : A.X k) (u : A.X (k + 1)) (y : B.X k), (A.d k (k + 1)).hom a = N • u ∧ N • y = 0 ∧
        (B.d k (k + 1)).hom (σ k a) - σ (k + 1) ((A.d k (k + 1)).hom a) = c + (B.d k (k + 1)).hom y) ∧
    (∀ k (a : A.X k) (u : A.X (k + 1)) (y : B.X k), (A.d k (k + 1)).hom a = N • u → N • y = 0 →
      (B.d k (k + 1)).hom (σ k a) - σ (k + 1) ((A.d k (k + 1)).hom a) = (B.d k (k + 1)).hom y →
      ∃ (t : A.X (k - 1)) (w : A.X k), a = (A.d (k - 1) k).hom t + N • w) :=
by

  have F1 : ∀ k (x : A.X k), σ k (N • x) = (Φ.f k).hom x := fun k x => by
    rw [map_nsmul, hσ]

  have F2 : ∀ i j (x : A.X i), (B.d i j).hom ((Φ.f i).hom x) = (Φ.f j).hom ((A.d i j).hom x) := by
    intro i j x
    have hc := congrArg (fun f => f.hom x) (Φ.comm i j)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at hc
    exact hc

  have F3A : ∀ i j l (x : A.X i), (A.d j l).hom ((A.d i j).hom x) = 0 := by
    intro i j l x
    have hc := congrArg (fun f => f.hom x) (A.d_comp_d i j l)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply,
      AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] at hc
    exact hc
  have F3B : ∀ i j l (x : B.X i), (B.d j l).hom ((B.d i j).hom x) = 0 := by
    intro i j l x
    have hc := congrArg (fun f => f.hom x) (B.d_comp_d i j l)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply,
      AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] at hc
    exact hc

  have hinj' : ∀ k (x : A.X (k + 1)), (A.d (k + 1) (k + 2)).hom x = 0 → ∀ y : B.X k,
      (Φ.f (k + 1)).hom x = (B.d k (k + 1)).hom y → ∃ x' : A.X k, (A.d k (k + 1)).hom x' = x :=
    fun k x hx y hy => hinj (k + 1) x hx y hy
  have hsurj' : ∀ k (y : B.X (k + 1)), (B.d (k + 1) (k + 2)).hom y = 0 → ∃ x : A.X (k + 1),
      (A.d (k + 1) (k + 2)).hom x = 0 ∧ ∃ w : B.X k, (B.d k (k + 1)).hom w = (Φ.f (k + 1)).hom x - y :=
    fun k y hy => hsurj (k + 1) y hy
  refine ⟨?_, ?_⟩
  ·
    intro k c hNc hdc
    obtain ⟨x, hdx, w, hw⟩ := hsurj' k c hdc
    have hdNx : (A.d (k + 1) (k + 2)).hom (N • x) = 0 := by
      rw [map_nsmul, hdx, smul_zero]
    have hΦNx : (Φ.f (k + 1)).hom (N • x) = (B.d k (k + 1)).hom (N • w) := by
      rw [map_nsmul, map_nsmul, hw, smul_sub, hNc, sub_zero]
    obtain ⟨a0, ha0⟩ := hinj' k (N • x) hdNx (N • w) hΦNx
    have hdz : (B.d k (k + 1)).hom (N • w - (Φ.f k).hom a0) = 0 := by
      rw [map_sub, map_nsmul, F2, ha0, map_nsmul, hw, smul_sub, hNc, sub_zero, sub_self]
    obtain ⟨x', hdx', w', hw'⟩ := hsurj k _ hdz
    obtain ⟨v, hv⟩ := hB (k - 1) w'
    refine ⟨-(a0 + x'), -x, w - σ k (a0 + x') + (B.d (k - 1) k).hom v, ?_, ?_, ?_⟩
    · rw [map_neg, map_add, ha0, hdx', add_zero, smul_neg]
    · rw [smul_add, smul_sub, hσ, ← map_nsmul (B.d (k - 1) k).hom N v, hv, hw', map_add]
      abel
    · have e1 : (A.d k (k + 1)).hom (-(a0 + x')) = -(N • x) := by
        rw [map_neg, map_add, ha0, hdx', add_zero]
      have e2 : σ (k + 1) (-(N • x)) = -(Φ.f (k + 1)).hom x := by
        rw [map_neg, F1]
      have e3 : (B.d k (k + 1)).hom ((B.d (k - 1) k).hom v) = 0 := F3B _ _ _ v
      rw [e1, e2]
      simp only [map_neg, map_add, map_sub, hw, e3]
      abel
  ·
    intro k a u y hda hNy hP
    have hdu : (A.d (k + 1) (k + 2)).hom u = 0 := by
      apply hA
      rw [← map_nsmul, ← hda, F3A]
    have hσda : σ (k + 1) ((A.d k (k + 1)).hom a) = (Φ.f (k + 1)).hom u := by
      rw [hda, F1]
    have hΦu : (Φ.f (k + 1)).hom u = (B.d k (k + 1)).hom (σ k a - y) := by
      rw [map_sub, ← hP, hσda]
      abel
    obtain ⟨a1, ha1⟩ := hinj' k u hdu (σ k a - y) hΦu
    have hds : (B.d k (k + 1)).hom (σ k a - y - (Φ.f k).hom a1) = 0 := by
      rw [map_sub (B.d k (k + 1)).hom (σ k a - y), F2, ha1, hΦu, sub_self]
    obtain ⟨x, hdx, w', hw'⟩ := hsurj k _ hds
    have hde : (A.d k (k + 1)).hom (a - N • a1 - N • x) = 0 := by
      rw [map_sub, map_sub, map_nsmul, map_nsmul, hda, ha1, hdx, smul_zero, sub_self, sub_zero]
    have hΦe : (Φ.f k).hom (a - N • a1 - N • x) = (B.d (k - 1) k).hom (-(N • w')) := by
      rw [map_neg, map_nsmul, hw']
      simp only [map_sub, map_nsmul, smul_sub, hσ, hNy]
      abel
    obtain ⟨t, ht⟩ := hinj k _ hde _ hΦe
    refine ⟨t, a1 + x, ?_⟩
    rw [ht, smul_add]
    abel

theorem wcU_bk_descend {A B V W : CochainComplex AddCommGrpCat.{v} ℕ} (Φ : A ⟶ B) (N : ℕ)
    (σ : ∀ k, A.X k →+ B.X k) (hσ : ∀ k a, N • σ k a = (Φ.f k).hom a)
    (red : ∀ k, A.X k →+ V.X k) (hred_surj : ∀ k, Function.Surjective (red k))
    (hred_ker : ∀ k a, red k a = 0 → ∃ w, a = N • w)
    (hred_d : ∀ k a, red (k + 1) ((A.d k (k + 1)).hom a) = (V.d k (k + 1)).hom (red k a))
    (θ : ∀ k, B.X (k + 1) → W.X k)
    (hθadd : ∀ k c c', N • c = 0 → N • c' = 0 → θ k (c + c') = θ k c + θ k c')
    (hθd : ∀ k c, N • c = 0 → (W.d k (k + 1)).hom (θ k c) = θ (k + 1) ((B.d (k + 1) (k + 2)).hom c)) :
    ∃ Ψ' : V ⟶ W, ∀ k a, (Ψ'.f k).hom (red k a) =
      ((-1 : ℤ) ^ k) • θ k ((B.d k (k + 1)).hom (σ k a) - σ (k + 1) ((A.d k (k + 1)).hom a)) :=
by
  classical
  have dA2 : ∀ k (a : A.X k),
      (A.d (k + 1) (k + 1 + 1)).hom ((A.d k (k + 1)).hom a) = 0 := by
    intro k a
    have h := congrArg (fun f => f.hom a) (A.d_comp_d k (k + 1) (k + 1 + 1))
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply,
      AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] at h
    exact h
  have dB2 : ∀ k (b : B.X k),
      (B.d (k + 1) (k + 2)).hom ((B.d k (k + 1)).hom b) = 0 := by
    intro k b
    have h := congrArg (fun f => f.hom b) (B.d_comp_d k (k + 1) (k + 2))
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply,
      AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] at h
    exact h
  have hΦc : ∀ k (a : A.X k), (B.d k (k + 1)).hom ((Φ.f k).hom a) =
      (Φ.f (k + 1)).hom ((A.d k (k + 1)).hom a) := by
    intro k a
    have h := congrArg (fun f => f.hom a) (Φ.comm k (k + 1))
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at h
    exact h
  let P : ∀ k, A.X k →+ B.X (k + 1) := fun k =>
    (B.d k (k + 1)).hom.comp (σ k) - (σ (k + 1)).comp (A.d k (k + 1)).hom
  have hP : ∀ k a, P k a = (B.d k (k + 1)).hom (σ k a) - σ (k + 1) ((A.d k (k + 1)).hom a) :=
    fun _ _ => rfl
  have hwd : ∀ k a, N • P k a = 0 := by
    intro k a
    rw [hP, smul_sub, ← map_nsmul, hσ, hσ, hΦc, sub_self]
  have hsign : ∀ k a, (B.d (k + 1) (k + 2)).hom (P k a) =
      - P (k + 1) ((A.d k (k + 1)).hom a) := by
    intro k a
    rw [hP, hP, map_sub, dB2, dA2, map_zero, sub_zero, zero_sub]
  have hθ0 : ∀ k, θ k 0 = 0 := by
    intro k
    have h := hθadd k 0 0 (smul_zero _) (smul_zero _)
    rw [add_zero] at h
    simpa using h
  have hθneg : ∀ k c, N • c = 0 → θ k (-c) = - θ k c := by
    intro k c hc
    have h := hθadd k c (-c) hc (by rw [smul_neg, hc, neg_zero])
    rw [add_neg_cancel, hθ0] at h
    rw [eq_neg_iff_add_eq_zero, add_comm]
    exact h.symm
  let g : ∀ k, A.X k →+ W.X k := fun k =>
    AddMonoidHom.mk' (fun a => ((-1 : ℤ) ^ k) • θ k (P k a)) (by
      intro a b
      show ((-1 : ℤ) ^ k) • θ k (P k (a + b)) =
        ((-1 : ℤ) ^ k) • θ k (P k a) + ((-1 : ℤ) ^ k) • θ k (P k b)
      rw [map_add, hθadd k _ _ (hwd k a) (hwd k b), smul_add])
  have hg : ∀ k a, g k a = ((-1 : ℤ) ^ k) • θ k (P k a) := fun _ _ => rfl
  have hker : ∀ k a, red k a = 0 → g k a = 0 := by
    intro k a ha
    obtain ⟨w, rfl⟩ := hred_ker k a ha
    rw [hg, map_nsmul, hwd, hθ0, smul_zero]
  have hd : ∀ k a, (W.d k (k + 1)).hom (g k a) = g (k + 1) ((A.d k (k + 1)).hom a) := by
    intro k a
    rw [hg, hg, map_zsmul, hθd k _ (hwd k a), hsign, hθneg _ _ (hwd (k + 1) _), pow_succ,
      mul_smul, neg_one_smul]
  let Ψ : ∀ k, V.X k →+ W.X k := fun k =>
    (red k).liftOfRightInverse (Function.surjInv (hred_surj k))
      (Function.rightInverse_surjInv (hred_surj k)) ⟨g k, fun a ha => by
        rw [AddMonoidHom.mem_ker] at ha ⊢
        exact hker k a ha⟩
  have hΨ : ∀ k a, Ψ k (red k a) = g k a := fun k a =>
    AddMonoidHom.liftOfRightInverse_comp_apply _ _ _ _ a
  refine ⟨CochainComplex.ofHom (fun k => AddCommGrpCat.ofHom (Ψ k)) ?_, ?_⟩
  · intro k
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    obtain ⟨a, rfl⟩ := hred_surj k x
    simp only [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom, AddMonoidHom.coe_comp,
      Function.comp_apply]
    rw [hΨ, hd, ← hred_d, hΨ]
  · intro k a
    show Ψ k (red k a) = _
    rw [hΨ, hg, hP]

theorem wcU_bk_descend_qiso {A B V W : CochainComplex AddCommGrpCat.{v} ℕ} (N : ℕ)
    (σ : ∀ k, A.X k →+ B.X k)
    (red : ∀ k, A.X k →+ V.X k) (hred_surj : ∀ k, Function.Surjective (red k))
    (hred_ker : ∀ k a, red k a = 0 ↔ ∃ w, a = N • w)
    (hred_d : ∀ k a, red (k + 1) ((A.d k (k + 1)).hom a) = (V.d k (k + 1)).hom (red k a))
    (θ : ∀ k, B.X (k + 1) → W.X k)
    (hθadd : ∀ k c c', N • c = 0 → N • c' = 0 → θ k (c + c') = θ k c + θ k c')
    (hθd : ∀ k c, N • c = 0 → (W.d k (k + 1)).hom (θ k c) = θ (k + 1) ((B.d (k + 1) (k + 2)).hom c))
    (hθsurj : ∀ k (x : W.X k), ∃ c, N • c = 0 ∧ θ k c = x)
    (hθinj : ∀ k c, N • c = 0 → θ (k + 1) c = 0 → c = 0)
    (hθker0 : ∀ c : B.X 1, N • c = 0 → θ 0 c = 0 → ∃ y : B.X 0, N • y = 0 ∧ (B.d 0 1).hom y = c)
    (hθ0 : ∀ y : B.X 0, N • y = 0 → θ 0 ((B.d 0 1).hom y) = 0)
    (hS : ∀ k (c : B.X (k + 1)), N • c = 0 → (B.d (k + 1) (k + 2)).hom c = 0 →
      ∃ (a : A.X k) (u : A.X (k + 1)) (y : B.X k), (A.d k (k + 1)).hom a = N • u ∧ N • y = 0 ∧
        (B.d k (k + 1)).hom (σ k a) - σ (k + 1) ((A.d k (k + 1)).hom a) = c + (B.d k (k + 1)).hom y)
    (hI : ∀ k (a : A.X k) (u : A.X (k + 1)) (y : B.X k), (A.d k (k + 1)).hom a = N • u → N • y = 0 →
      (B.d k (k + 1)).hom (σ k a) - σ (k + 1) ((A.d k (k + 1)).hom a) = (B.d k (k + 1)).hom y →
      ∃ (t : A.X (k - 1)) (w : A.X k), a = (A.d (k - 1) k).hom t + N • w)
    (hwd : ∀ k a, N • ((B.d k (k + 1)).hom (σ k a) - σ (k + 1) ((A.d k (k + 1)).hom a)) = 0)
    (Ψ' : V ⟶ W) (hΨ' : ∀ k a, (Ψ'.f k).hom (red k a) =
      ((-1 : ℤ) ^ k) • θ k ((B.d k (k + 1)).hom (σ k a) - σ (k + 1) ((A.d k (k + 1)).hom a))) :
    (∀ (n : ℕ) (x : V.X n), (V.d n (n + 1)).hom x = 0 → ∀ y : W.X (n - 1),
        (Ψ'.f n).hom x = (W.d (n - 1) n).hom y → ∃ x' : V.X (n - 1), (V.d (n - 1) n).hom x' = x) ∧
    (∀ (n : ℕ) (y : W.X n), (W.d n (n + 1)).hom y = 0 → ∃ x : V.X n,
        (V.d n (n + 1)).hom x = 0 ∧ ∃ w : W.X (n - 1), (W.d (n - 1) n).hom w = (Ψ'.f n).hom x - y) :=
by
  have T0 : ∀ k, θ k 0 = 0 := by
    intro k
    have h := hθadd k 0 0 (smul_zero _) (smul_zero _)
    rw [add_zero] at h
    have h' : θ k 0 + θ k 0 = θ k 0 + 0 := by rw [add_zero]; exact h.symm
    exact add_left_cancel h'
  have Tneg : ∀ k (c : B.X (k + 1)), N • c = 0 → θ k (-c) = -θ k c := by
    intro k c hc
    have h := hθadd k c (-c) hc (by rw [smul_neg, hc, neg_zero])
    rw [add_neg_cancel, T0] at h
    rw [eq_neg_iff_add_eq_zero, add_comm]
    exact h.symm
  have Tsub : ∀ k (c c' : B.X (k + 1)), N • c = 0 → N • c' = 0 →
      θ k (c - c') = θ k c - θ k c' := by
    intro k c c' hc hc'
    rw [sub_eq_add_neg, hθadd k c (-c') hc (by rw [smul_neg, hc', neg_zero]), Tneg k c' hc',
      ← sub_eq_add_neg]
  have Tsgn : ∀ k (c : B.X (k + 1)) (n : ℕ), N • c = 0 →
      N • (((-1 : ℤ) ^ n) • c) = 0 ∧ θ k (((-1 : ℤ) ^ n) • c) = ((-1 : ℤ) ^ n) • θ k c := by
    intro k c n hc
    rcases neg_one_pow_eq_or ℤ n with h | h <;> rw [h]
    · rw [one_smul, one_smul]; exact ⟨hc, rfl⟩
    · rw [neg_one_smul, neg_one_smul]
      exact ⟨by rw [smul_neg, hc, neg_zero], Tneg k c hc⟩
  have Tε : ∀ (n : ℕ) {G : Type v} [AddCommGroup G] (g : G),
      ((-1 : ℤ) ^ n) • ((-1 : ℤ) ^ n) • g = g := by
    intro n G _ g
    rw [smul_smul, ← mul_pow, neg_one_mul, neg_neg, one_pow, one_smul]
  have Rk : ∀ k (u : A.X k), red k (N • u) = 0 := fun k u => (hred_ker k _).mpr ⟨u, rfl⟩
  refine ⟨?inj, ?surj⟩
  case surj =>
    intro n y hy
    obtain ⟨c, hc, rfl⟩ := hθsurj n y
    have hdc : (B.d (n + 1) (n + 2)).hom c = 0 := by
      apply hθinj n _ (by rw [← map_nsmul, hc, map_zero])
      rw [← hθd n c hc, hy]
    obtain ⟨a, u, yB, hau, hyB, hP⟩ := hS n c hc hdc
    refine ⟨((-1 : ℤ) ^ n) • red n a, ?_, ?_⟩
    · rw [map_zsmul, ← hred_d, hau, Rk, smul_zero]
    · have hx : (Ψ'.f n).hom (((-1 : ℤ) ^ n) • red n a) - θ n c =
          θ n ((B.d n (n + 1)).hom yB) := by
        rw [map_zsmul, hΨ', Tε, hP, hθadd n c _ hc (by rw [← map_nsmul, hyB, map_zero]),
          add_sub_cancel_left]
      rw [hx]
      cases n with
      | zero =>
        refine ⟨0, ?_⟩
        rw [map_zero]
        exact (hθ0 yB hyB).symm
      | succ j =>
        exact ⟨θ j yB, hθd j yB hyB⟩
  case inj =>
    intro n x hx z hz
    obtain ⟨a, rfl⟩ := hred_surj n x
    obtain ⟨u, hu⟩ := (hred_ker (n + 1) _).mp (by rw [hred_d]; exact hx)
    suffices H : ∃ yB : B.X n, N • yB = 0 ∧
        (B.d n (n + 1)).hom (σ n a) - σ (n + 1) ((A.d n (n + 1)).hom a) = (B.d n (n + 1)).hom yB by
      obtain ⟨yB, hyB, hP⟩ := H
      obtain ⟨t, w, haw⟩ := hI n a u yB hu hyB hP
      rw [haw, map_add, Rk, add_zero]
      cases n with
      | zero =>
        refine ⟨0, ?_⟩
        rw [map_zero]
        show 0 = red 0 ((A.d 0 0).hom t)
        rw [A.shape 0 0 (by simp)]
        simp
      | succ j =>
        exact ⟨red j t, (hred_d j t).symm⟩
    cases n with
    | zero =>
      have h0 : θ 0 ((B.d 0 1).hom (σ 0 a) - σ 1 ((A.d 0 1).hom a)) = 0 := by
        have e := hΨ' 0 a
        rw [hz, pow_zero, one_smul] at e
        rw [← e]
        show (W.d 0 0).hom z = 0
        rw [W.shape 0 0 (by simp)]
        rfl
      obtain ⟨yB, hyB, hd⟩ := hθker0 _ (hwd 0 a) h0
      exact ⟨yB, hyB, hd.symm⟩
    | succ j =>
      obtain ⟨c', hc', hcz⟩ := hθsurj j z
      subst hcz
      have e1 := hΨ' (j + 1) a
      rw [hz] at e1
      have e2 : (W.d j (j + 1)).hom (θ j c') = θ (j + 1) ((B.d (j + 1) (j + 1 + 1)).hom c') :=
        hθd j c' hc'
      have hdct : N • (B.d (j + 1) (j + 1 + 1)).hom c' = 0 := by
        rw [← map_nsmul, hc', map_zero]
      obtain ⟨hεt, hεθ⟩ := Tsgn (j + 1) _ (j + 1) (hwd (j + 1) a)
      have e3 : θ (j + 1) (((-1 : ℤ) ^ (j + 1)) •
          ((B.d (j + 1) (j + 1 + 1)).hom (σ (j + 1) a) -
            σ (j + 1 + 1) ((A.d (j + 1) (j + 1 + 1)).hom a)) -
          (B.d (j + 1) (j + 1 + 1)).hom c') = 0 := by
        rw [Tsub _ _ _ hεt hdct, hεθ, ← e2]
        exact sub_eq_zero.mpr e1.symm
      have e4 := hθinj j _ (by rw [smul_sub, hεt, hdct, sub_zero]) e3
      rw [sub_eq_zero] at e4
      obtain ⟨hεc, -⟩ := Tsgn j c' (j + 1) hc'
      refine ⟨((-1 : ℤ) ^ (j + 1)) • c', hεc, ?_⟩
      rw [map_zsmul, ← e4, Tε]

theorem wcU_sms_bockstein_model (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Γ : Type u) [Group Γ] [Fintype Γ]
    (n : ℕ) (hn : 1 ≤ n) (D : CochainComplex AddCommGrpCat.{u+1} ℕ)
    (lamD : MonoidAlgebra ℤ_[ℓ] Γ → (D ⟶ D)) (hD : wcRingAct lamD)
    (FrD : D ⟶ D) (hFr : ∀ x, lamD x ≫ FrD = FrD ≫ lamD x)
    (hdiv : ∀ j (y : D.X j), ∃ z, (ℓ ^ n) • z = y)
    (P : wcGModel ℓ Γ) (φ : wcGModelAb P ⟶ D) (hφ : QuasiIso φ)
    (hlin : ∀ x, wcGModelSmul P x ≫ φ = φ ≫ lamD x)
    (H : Homotopy (φ ≫ FrD) (wcGModelFrob P ≫ φ))
    (σ : ∀ k, (wcGModelAb P).X k →+ D.X k)
    (hσ : ∀ k v, (ℓ ^ n) • σ k v = (φ.f k).hom v)
    (hσl : ∀ k x v, σ k (((wcGModelSmul P x).f k).hom v) = ((lamD x).f k).hom (σ k v))
    (τ : ∀ k, (wcGModelAb P).X (k + 1) →+ D.X k)
    (hτ : ∀ k v, (ℓ ^ n) • τ k v = (H.hom (k + 1) k).hom v)
    (hτl : ∀ k x v, τ k (((wcGModelSmul P x).f (k + 1)).hom v) = ((lamD x).f k).hom (τ k v)) :
    ∃ β' : wcSmsBar P n ⟶ wcTruncKerRes D (ℓ ^ n),
      wcSmsConeExact β' ∧
      (∀ y : D.X 0, (D.d 0 1).hom y = 0 → (ℓ ^ n) • y = 0 → y = 0) ∧
      (∀ x, wcSmsBarSmul P n x ≫ β' = β' ≫ wcSpfTruncMap D (ℓ ^ n) (lamD x)) ∧
      ∃ G : Homotopy (β' ≫ wcSpfTruncMap D (ℓ ^ n) FrD) (wcSmsBarFrob P n ≫ β'),
        ∀ x i j, (wcSmsBarSmul P n x).f i ≫ G.hom i j =
          G.hom i j ≫ (wcSpfTruncMap D (ℓ ^ n) (lamD x)).f j :=
by
  classical



  have hdd : ∀ {C : CochainComplex AddCommGrpCat.{u+1} ℕ} (i j k : ℕ) (x : C.X i),
      (C.d j k).hom ((C.d i j).hom x) = 0 := by
    intro C i j k x
    have e := congrArg (fun f => f.hom x) (C.d_comp_d i j k)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply,
      AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] at e
    exact e
  have hcomm : ∀ {C E : CochainComplex AddCommGrpCat.{u+1} ℕ} (f : C ⟶ E) (i j : ℕ) (x : C.X i),
      (E.d i j).hom ((f.f i).hom x) = (f.f j).hom ((C.d i j).hom x) := by
    intro C E f i j x
    have e := congrArg (fun g => g.hom x) (f.comm i j)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at e
    exact e
  have hsq : ∀ {C : CochainComplex AddCommGrpCat.{u+1} ℕ} (f g : C ⟶ C), f ≫ g = g ≫ f →
      ∀ k (y : C.X k), (g.f k).hom ((f.f k).hom y) = (f.f k).hom ((g.f k).hom y) := by
    intro C f g hfg k y
    have e := congrArg (fun φ => (φ.f k).hom y) hfg
    simp only [HomologicalComplex.comp_f, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
      Function.comp_apply] at e
    exact e



  have hθex : ∀ M : ℕ, ∃ θ : ∀ k, D.X (k + 1) → (wcTruncKerRes D M).X k,
      (∀ k c c', M • c = 0 → M • c' = 0 → θ k (c + c') = θ k c + θ k c') ∧
      (∀ k c, M • c = 0 → ((wcTruncKerRes D M).d k (k + 1)).hom (θ k c) =
        θ (k + 1) ((D.d (k + 1) (k + 2)).hom c)) ∧
      (∀ k (x : (wcTruncKerRes D M).X k), ∃ c, M • c = 0 ∧ θ k c = x) ∧
      (∀ k c, M • c = 0 → θ (k + 1) c = 0 → c = 0) ∧
      (∀ c : D.X 1, M • c = 0 → θ 0 c = 0 → ∃ y : D.X 0, M • y = 0 ∧ (D.d 0 1).hom y = c) ∧
      (∀ y : D.X 0, M • y = 0 → θ 0 ((D.d 0 1).hom y) = 0) ∧
      (∀ (g : D ⟶ D) k c, M • c = 0 →
        ((wcSpfTruncMap D M g).f k).hom (θ k c) = θ k ((g.f (k + 1)).hom c)) := by
    intro M
    have hNh : ∀ (m : ℕ) (c : D.X m), (M • 𝟙 (D.X m)).hom c = M • c := by
      intro m c
      simp
    have hιinj : ∀ m, Function.Injective (Limits.kernel.ι (M • 𝟙 (D.X m))).hom := by
      intro m
      exact (AddCommGrpCat.mono_iff_injective _).1 inferInstance
    have hιt : ∀ m (x : ↑(Limits.kernel (M • 𝟙 (D.X m)) : AddCommGrpCat.{u+1})),
        M • (Limits.kernel.ι (M • 𝟙 (D.X m))).hom x = 0 := by
      intro m x
      have e := congrArg (fun f => f.hom x) (Limits.kernel.condition (M • 𝟙 (D.X m)))
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply, hNh,
        AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] at e
      exact e
    obtain ⟨κ, hικ⟩ : ∃ κ : ∀ m, ↑(D.X m) → ↑(Limits.kernel (M • 𝟙 (D.X m)) : AddCommGrpCat.{u+1}),
        ∀ m (c : D.X m), M • c = 0 → (Limits.kernel.ι (M • 𝟙 (D.X m))).hom (κ m c) = c := by
      refine ⟨fun m c => if hc : M • c = 0 then
        (AddCommGrpCat.kernelIsoKer (M • 𝟙 (D.X m))).inv.hom
          (⟨c, by rw [AddMonoidHom.mem_ker, hNh]; exact hc⟩ : (M • 𝟙 (D.X m)).hom.ker) else 0, ?_⟩
      intro m c hc
      dsimp only
      rw [dif_pos hc]
      exact congrArg (fun f => f.hom
        (⟨c, by rw [AddMonoidHom.mem_ker, hNh]; exact hc⟩ : (M • 𝟙 (D.X m)).hom.ker))
        (AddCommGrpCat.kernelIsoKer_inv_comp_ι (M • 𝟙 (D.X m)))
    have hκι : ∀ m (x : ↑(Limits.kernel (M • 𝟙 (D.X m)) : AddCommGrpCat.{u+1})),
        κ m ((Limits.kernel.ι (M • 𝟙 (D.X m))).hom x) = x := fun m x =>
      hιinj m (hικ m _ (hιt m x))
    have hκadd : ∀ m (c c' : D.X m), M • c = 0 → M • c' = 0 → κ m (c + c') = κ m c + κ m c' := by
      intro m c c' hc hc'
      apply hιinj m
      rw [map_add, hικ m _ (by rw [smul_add, hc, hc', add_zero]), hικ m c hc, hικ m c' hc']
    have hTD : ∀ m (x : ↑(Limits.kernel (M • 𝟙 (D.X m)) : AddCommGrpCat.{u+1})),
        (Limits.kernel.ι (M • 𝟙 (D.X (m + 1)))).hom ((wcTruncKerD D M m).hom x) =
          (D.d m (m + 1)).hom ((Limits.kernel.ι (M • 𝟙 (D.X m))).hom x) := by
      intro m x
      have e : wcTruncKerD D M m ≫ Limits.kernel.ι (M • 𝟙 (D.X (m + 1))) =
          Limits.kernel.ι (M • 𝟙 (D.X m)) ≫ D.d m (m + 1) := by
        simp [wcTruncKerD, Limits.kernel.map]
      exact congrArg (fun f => f.hom x) e
    have hKM : ∀ (g : D ⟶ D) m (x : ↑(Limits.kernel (M • 𝟙 (D.X m)) : AddCommGrpCat.{u+1})),
        (Limits.kernel.ι (M • 𝟙 (D.X m))).hom ((wcSpfKerMap D M g m).hom x) =
          (g.f m).hom ((Limits.kernel.ι (M • 𝟙 (D.X m))).hom x) := by
      intro g m x
      have e : wcSpfKerMap D M g m ≫ Limits.kernel.ι (M • 𝟙 (D.X m)) =
          Limits.kernel.ι (M • 𝟙 (D.X m)) ≫ g.f m := by
        simp [wcSpfKerMap, Limits.kernel.map]
      exact congrArg (fun f => f.hom x) e
    have htmap : ∀ {X Y : AddCommGrpCat.{u+1}} (f : X ⟶ Y) (x : X), M • x = 0 → M • f.hom x = 0 := by
      intro X Y f x hx
      rw [← map_nsmul, hx, map_zero]
    have hκd : ∀ m (c : D.X m), M • c = 0 →
        (wcTruncKerD D M m).hom (κ m c) = κ (m + 1) ((D.d m (m + 1)).hom c) := by
      intro m c hc
      apply hιinj (m + 1)
      rw [hTD, hικ m c hc, hικ (m + 1) _ (htmap _ c hc)]
    have hκg : ∀ (g : D ⟶ D) m (c : D.X m), M • c = 0 →
        (wcSpfKerMap D M g m).hom (κ m c) = κ m ((g.f m).hom c) := by
      intro g m c hc
      apply hιinj m
      rw [hKM, hικ m c hc, hικ m _ (htmap _ c hc)]
    obtain ⟨θ, hθZ, hθS⟩ : ∃ θ : ∀ k, D.X (k + 1) → (wcTruncKerRes D M).X k,
        (∀ c : D.X 1, θ 0 c = (Limits.cokernel.π (wcTruncKerD D M 0)).hom (κ 1 c)) ∧
        (∀ j (c : D.X (j + 2)), θ (j + 1) c = κ (j + 2) c) :=
      ⟨fun k => match k with
        | 0 => fun c => (Limits.cokernel.π (wcTruncKerD D M 0)).hom (κ 1 c)
        | j + 1 => fun c => κ (j + 2) c, fun c => rfl, fun j c => rfl⟩
    have hWd : ∀ k, (wcTruncKerRes D M).d k (k + 1) = wcTruncKerDiff D M k := by
      intro k
      unfold wcTruncKerRes
      simp only [CochainComplex.of_d]
    refine ⟨θ, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    ·
      intro k c c' hc hc'
      cases k with
      | zero =>
        rw [hθZ, hθZ, hθZ, hκadd 1 c c' hc hc']
        exact map_add _ _ _
      | succ j => rw [hθS, hθS, hθS]; exact hκadd (j + 2) c c' hc hc'
    ·
      intro k c hc
      cases k with
      | zero =>
        rw [hWd 0, hθZ, hθS]
        have e : Limits.cokernel.π (wcTruncKerD D M 0) ≫ wcTruncKerDiff D M 0 =
            wcTruncKerD D M 1 := Limits.cokernel.π_desc _ _ _
        exact (congrArg (fun f => f.hom (κ 1 c)) e).trans (hκd 1 c hc)
      | succ j =>
        rw [hWd (j + 1), hθS, hθS]
        exact hκd (j + 2) c hc
    ·
      intro k x
      cases k with
      | zero =>
        obtain ⟨x', hx'⟩ := (AddCommGrpCat.epi_iff_surjective
          (Limits.cokernel.π (wcTruncKerD D M 0))).1 inferInstance x
        refine ⟨(Limits.kernel.ι (M • 𝟙 (D.X 1))).hom x', hιt 1 x', ?_⟩
        rw [hθZ, hκι 1 x']
        exact hx'
      | succ j =>
        refine ⟨(Limits.kernel.ι (M • 𝟙 (D.X (j + 2)))).hom x, hιt (j + 2) x, ?_⟩
        rw [hθS]
        exact hκι (j + 2) x
    ·
      intro k c hc h
      rw [hθS] at h
      have h' : κ (k + 2) c = (0 : ↑(Limits.kernel (M • 𝟙 (D.X (k + 2))) : AddCommGrpCat.{u+1})) := h
      exact (hικ (k + 2) c hc).symm.trans
        ((congrArg (fun z => (Limits.kernel.ι (M • 𝟙 (D.X (k + 2)))).hom z) h').trans (map_zero _))
    ·
      intro c hc h
      rw [hθZ] at h
      have hex : (ShortComplex.mk (wcTruncKerD D M 0) (Limits.cokernel.π (wcTruncKerD D M 0))
          (Limits.cokernel.condition _)).Exact :=
        ShortComplex.exact_of_g_is_cokernel _ (Limits.cokernelIsCokernel _)
      obtain ⟨y', hy'⟩ := (ShortComplex.ab_exact_iff _).1 hex (κ 1 c) h
      have hy'' : (wcTruncKerD D M 0).hom y' = κ 1 c := hy'
      refine ⟨(Limits.kernel.ι (M • 𝟙 (D.X 0))).hom y', hιt 0 y', ?_⟩
      refine (hTD 0 y').symm.trans ?_
      exact (congrArg (fun z => (Limits.kernel.ι (M • 𝟙 (D.X 1))).hom z) hy'').trans (hικ 1 c hc)
    ·
      intro y hy
      rw [hθZ]
      have e1 : κ 1 ((D.d 0 1).hom y) = (wcTruncKerD D M 0).hom (κ 0 y) := (hκd 0 y hy).symm
      rw [e1]
      have e := congrArg (fun f => f.hom (κ 0 y)) (Limits.cokernel.condition (wcTruncKerD D M 0))
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply,
        AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] at e
      exact e
    ·
      intro g k c hc
      cases k with
      | zero =>
        show (wcSpfTruncMapF D M g 0).hom (θ 0 c) = θ 0 ((g.f (0 + 1)).hom c)
        rw [hθZ, hθZ]
        have e : Limits.cokernel.π (wcTruncKerD D M 0) ≫ wcSpfTruncMapF D M g 0 =
            wcSpfKerMap D M g 1 ≫ Limits.cokernel.π (wcTruncKerD D M 0) := by
          exact Limits.cokernel.π_desc _ _ _
        refine (congrArg (fun f => f.hom (κ 1 c)) e).trans ?_
        exact congrArg (fun z => (Limits.cokernel.π (wcTruncKerD D M 0)).hom z) (hκg g 1 c hc)
      | succ j =>
        show (wcSpfKerMap D M g (j + 2)).hom (θ (j + 1) c) = θ (j + 1) ((g.f (j + 1 + 1)).hom c)
        rw [hθS, hθS]
        exact hκg g (j + 2) c hc



  have hℓne : ((ℓ : ℤ_[ℓ]) ^ n) ≠ 0 :=
    pow_ne_zero n (by exact_mod_cast (Fact.out : Nat.Prime ℓ).ne_zero)
  have hR_tf : ∀ x : MonoidAlgebra ℤ_[ℓ] Γ, (ℓ ^ n) • x = 0 → x = 0 := by
    intro x hx
    have hne : ((ℓ ^ n : ℕ) : ℤ_[ℓ]) ≠ 0 := by
      exact_mod_cast pow_ne_zero n (Nat.Prime.ne_zero Fact.out)
    rw [← Nat.cast_smul_eq_nsmul ℤ_[ℓ]] at hx
    apply MonoidAlgebra.ext
    ext g
    have h1 := congrArg (fun y : MonoidAlgebra ℤ_[ℓ] Γ => y.coeff g) hx
    simp only [MonoidAlgebra.coeff_smul, MonoidAlgebra.coeff_zero, Finsupp.smul_apply, smul_eq_mul,
      Finsupp.coe_zero, Pi.zero_apply] at h1
    simp only [MonoidAlgebra.coeff_zero, Finsupp.coe_zero, Pi.zero_apply]
    exact (mul_eq_zero.mp h1).resolve_left hne
  have hR_ker : ∀ x : MonoidAlgebra ℤ_[ℓ] Γ, wcSmsRed ℓ n Γ x = 0 → ∃ c, x = (ℓ ^ n) • c := by
    intro x hx
    have hc : ∀ g, x.coeff g ∈ RingHom.ker (PadicInt.toZModPow (p := ℓ) n) := by
      intro g
      rw [RingHom.mem_ker]
      have h1 := congrArg (fun y => y.coeff g) hx
      simp only [wcSmsRed, MonoidAlgebra.coeff_mapRingHom, MonoidAlgebra.coeff_zero,
        Finsupp.coe_zero, Pi.zero_apply] at h1
      exact h1
    simp only [PadicInt.ker_toZModPow, Ideal.mem_span_singleton'] at hc
    choose q hq using hc
    have hsupp : ∀ g, q g ≠ 0 → g ∈ x.coeff.support := by
      intro g hg
      rw [Finsupp.mem_support_iff]
      intro h0
      apply hg
      have h2 := hq g
      rw [h0] at h2
      exact (mul_eq_zero.mp h2).resolve_right hℓne
