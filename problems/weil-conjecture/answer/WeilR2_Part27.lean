    (hθc : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
          θG.hom =
        θG.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map
          (wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) c)
            (continuous_const_smul c)))
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin m), W.hom z ≠ S i (IsLocalRing.closedPoint K))
    (hcov : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (hgal : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ) :
    ∃ (A : Type (u+1)) (_ : AddCommGroup A) (_ : Module ℤ_[ℓ] A)
      (ι₀ : A →+ wcCohG K (wcP1Over K) hP G 2),
      (∀ (a : ℤ_[ℓ]) (z : A),
        ι₀ (a • z) = wcCohGEnd K (wcP1Over K) hP G 2 (σ (a : ℚ_[ℓ])) (ι₀ z)) ∧
      (∀ y : wcCohG K (wcP1Over K) hP G 2, ∃ (n : ℕ) (z : A), (ℓ ^ n : ℕ) • y = ι₀ z) ∧
      ∃ (B : ℕ → Type (u+1)) (_ : ∀ r, AddCommGroup (B r)) (π : ∀ r, A →+ B r),
        (∀ (r : ℕ) (z : A), π r z = 0 → ∃ z' : A, z = (ℓ ^ r : ℕ) • z') ∧
        (∀ z : A, (∀ r, π r z = 0) → z = 0) ∧
        ∃ Γ : ∀ r : ℕ, (ι' → ZMod (ℓ ^ r)) →+ B r,
          (∀ r, Function.Surjective (Γ r)) ∧
