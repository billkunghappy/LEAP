      intro T a z
      have hh : a.left ≫ W.hom = a.left ≫ W.hom := rfl
      have hx : c (wcLtcPair a a z) = c (wcLtcPair a a z) * c (wcLtcPair a a z) :=
        hcoc T.left a.left a.left a.left hh hh hh z
      have hx1 : c (wcLtcPair a a z) = 1 :=
        mul_left_cancel (hx.symm.trans (mul_one _).symm)
      rw [hx1, inv_one]
      rfl
    have hcoc'' : ∀ (T : (wcP1Over K).left.ProEt) (a b b' : T ⟶ W) (z : T.left),
        (ULift.up (c (wcLtcPair a b' z))⁻¹ : wcH2rGam.{u} ℓ k n) =
          (ULift.up (c (wcLtcPair b b' z))⁻¹ : wcH2rGam.{u} ℓ k n) *
            (ULift.up (c (wcLtcPair a b z))⁻¹ : wcH2rGam.{u} ℓ k n) := by
      intro T a b b' z
      have h' : c (wcLtcPair a b' z) = c (wcLtcPair a b z) * c (wcLtcPair b b' z) :=
        hcoc T.left a.left b.left b'.left
          ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b).symm)
          ((MorphismProperty.Over.w b).trans (MorphismProperty.Over.w b').symm)
          ((MorphismProperty.Over.w a).trans (MorphismProperty.Over.w b').symm) z
