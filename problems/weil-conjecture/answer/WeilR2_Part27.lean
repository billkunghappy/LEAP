      (fun p k => ⟨(hbb k).1 p, wcSpfR_bar_relinj_exact ℓ n r hn ρ _ _ (hY k).1 (hY k).2.1
        (hY k).2.2 (hbb k).1 p⟩)
      (fun p k => hLE.1 _ _ _ _ (hYex k))
      (fun p => ⟨hbG.1 p, wcSpfR_bar_coker_exact K ℓ m S hS Uo hUo q' Γ α hG hα n hn r ρ
        lamF hlamF hlamFs lamG hlamG hbG.1 p⟩)
  ·
    intro i j hj y
    exact wcSpfR_ext_vanish _ _ (ℓ ^ n) hNpos _ (hC1 i) (hC5 i) j hj y

theorem wcU_spf_ntors_comparison (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (N : ℕ) (hN : 1 ≤ N)
    (𝓖 : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (C J : CochainComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) ℕ)
    (ηC : 𝓖 ⟶ C.X 0) (η : 𝓖 ⟶ J.X 0)
    (hC : wcNTorsRes K hP N 𝓖 C ηC) (hJ : wcNTorsRes K hP N 𝓖 J η) :
    ∃ μ : C ⟶ J, QuasiIso (wcCxJMap K hP μ) :=
by
  classical

  have hExt : ∀ {X Y Z T : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (a : X ⟶ Y) (b : Y ⟶ Z) (w : a ≫ b = 0), (ShortComplex.mk a b w).Exact →
      ((N : ℕ) : ℤ) • 𝟙 Z = 0 →
      (∀ (A B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
        (mm : A ⟶ B), Mono mm → ((N : ℕ) : ℤ) • 𝟙 B = 0 →
        ∀ φ : A ⟶ T, ∃ ψ : B ⟶ T, mm ≫ ψ = φ) →
      ∀ u : Y ⟶ T, a ≫ u = 0 → ∃ h : Z ⟶ T, b ≫ h = u := by
    intro X Y Z T a b w hex hZ hT u hu
    have hm : Mono (Limits.cokernel.desc a b w) :=
      (ShortComplex.exact_iff_mono_cokernel_desc (ShortComplex.mk a b w)).mp hex
    obtain ⟨h, hh⟩ := hT _ _ (Limits.cokernel.desc a b w) hm hZ (Limits.cokernel.desc a u hu)
    refine ⟨h, ?_⟩
    have h2 := congrArg (fun t => Limits.cokernel.π a ≫ t) hh
    simpa only [Limits.cokernel.π_desc_assoc, Limits.cokernel.π_desc] using h2

  have hSexOf : ∀ (S : CochainComplex
      (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) ℕ),
      (∀ i, (S.sc (i + 1)).Exact) → ∀ n,
      (ShortComplex.mk (S.d n (n + 1)) (S.d (n + 1) (n + 2)) (S.d_comp_d _ _ _)).Exact := by
    intro S hS n
    exact (S.exactAt_iff' n (n + 1) (n + 2) (CochainComplex.prev_nat_succ n)
      (CochainComplex.next ℕ (n + 1))).mp (hS n)

  have hLift : ∀ (S T : CochainComplex
      (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) ℕ)
      (ηS : 𝓖 ⟶ S.X 0), (∀ i, ((N : ℕ) : ℤ) • 𝟙 (S.X i) = 0) → Mono ηS →
      (∃ w : ηS ≫ S.d 0 1 = 0, (ShortComplex.mk ηS (S.d 0 1) w).Exact) →
      (∀ i, (S.sc (i + 1)).Exact) →
      (∀ (i : ℕ) (A B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
        (mm : A ⟶ B), Mono mm → ((N : ℕ) : ℤ) • 𝟙 B = 0 →
        ∀ φ : A ⟶ T.X i, ∃ ψ : B ⟶ T.X i, mm ≫ ψ = φ) →
      ∀ φ : 𝓖 ⟶ T.X 0, φ ≫ T.d 0 1 = 0 → ∃ f : S ⟶ T, ηS ≫ f.f 0 = φ := by
    intro S T ηS hStors hSmono hS0 hS hT φ hφ
    obtain ⟨wS, hS0ex⟩ := hS0
    have hSex := hSexOf S hS
    obtain ⟨f0, hf0⟩ := hT 0 _ _ ηS hSmono (hStors 0) φ
    have e1 : ∃ f1 : S.X 1 ⟶ T.X 1, S.d 0 1 ≫ f1 = f0 ≫ T.d 0 1 :=
      hExt ηS (S.d 0 1) wS hS0ex (hStors 1) (hT 1) (f0 ≫ T.d 0 1)
        (by rw [← Category.assoc, hf0, hφ])
    have esucc : ∀ (n : ℕ) (p : (f : S.X n ⟶ T.X n) ×' (f' : S.X (n + 1) ⟶ T.X (n + 1)) ×'
        f ≫ T.d n (n + 1) = S.d n (n + 1) ≫ f'),
        ∃ f'' : S.X (n + 2) ⟶ T.X (n + 2),
          S.d (n + 1) (n + 2) ≫ f'' = p.2.1 ≫ T.d (n + 1) (n + 2) := by
      intro n p
      refine hExt (S.d n (n + 1)) (S.d (n + 1) (n + 2)) (S.d_comp_d _ _ _) (hSex n)
        (hStors (n + 2)) (hT (n + 2)) _ ?_
      rw [← Category.assoc, ← p.2.2, Category.assoc, T.d_comp_d, Limits.comp_zero]
    refine ⟨CochainComplex.mkHom S T f0 e1.choose e1.choose_spec.symm
      (fun n p => ⟨(esucc n p).choose, (esucc n p).choose_spec.symm⟩), ?_⟩
    rw [CochainComplex.mkHom_f_0]
    exact hf0

  have hNull : ∀ (S T : CochainComplex
      (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) ℕ)
      (ηS : 𝓖 ⟶ S.X 0), (∀ i, ((N : ℕ) : ℤ) • 𝟙 (S.X i) = 0) →
      (∃ w : ηS ≫ S.d 0 1 = 0, (ShortComplex.mk ηS (S.d 0 1) w).Exact) →
      (∀ i, (S.sc (i + 1)).Exact) →
      (∀ (i : ℕ) (A B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
        (mm : A ⟶ B), Mono mm → ((N : ℕ) : ℤ) • 𝟙 B = 0 →
        ∀ φ : A ⟶ T.X i, ∃ ψ : B ⟶ T.X i, mm ≫ ψ = φ) →
      ∀ f : S ⟶ T, ηS ≫ f.f 0 = 0 → Nonempty (Homotopy f 0) := by
    intro S T ηS hStors hS0 hS hT f hf
    obtain ⟨wS, hS0ex⟩ := hS0
    have hSex := hSexOf S hS
    have e0 : ∃ h0 : S.X 1 ⟶ T.X 0, S.d 0 1 ≫ h0 = f.f 0 :=
      hExt ηS (S.d 0 1) wS hS0ex (hStors 1) (hT 0) (f.f 0) hf
    have e1 : ∃ h1 : S.X 2 ⟶ T.X 1, S.d 1 2 ≫ h1 = f.f 1 - e0.choose ≫ T.d 0 1 := by
      refine hExt (S.d 0 1) (S.d 1 2) (S.d_comp_d _ _ _) (hSex 0) (hStors 2) (hT 1) _ ?_
      rw [Preadditive.comp_sub, ← f.comm 0 1, ← Category.assoc, e0.choose_spec, sub_self]
    have esucc : ∀ (n : ℕ) (p : (h : S.X (n + 1) ⟶ T.X n) ×'
        (h' : S.X (n + 2) ⟶ T.X (n + 1)) ×'
          f.f (n + 1) = h ≫ T.d n (n + 1) + S.d (n + 1) (n + 2) ≫ h'),
        ∃ h'' : S.X (n + 3) ⟶ T.X (n + 2),
          S.d (n + 2) (n + 3) ≫ h'' = f.f (n + 2) - p.2.1 ≫ T.d (n + 1) (n + 2) := by
      intro n p
      refine hExt (S.d (n + 1) (n + 2)) (S.d (n + 2) (n + 3)) (S.d_comp_d _ _ _) (hSex (n + 1))
        (hStors (n + 3)) (hT (n + 2)) _ ?_
      have hc : S.d (n + 1) (n + 2) ≫ f.f (n + 2) = f.f (n + 1) ≫ T.d (n + 1) (n + 2) :=
        (f.comm (n + 1) (n + 2)).symm
      have hp : f.f (n + 1) ≫ T.d (n + 1) (n + 2) =
          (p.1 ≫ T.d n (n + 1) + S.d (n + 1) (n + 2) ≫ p.2.1) ≫ T.d (n + 1) (n + 2) :=
        congrArg (fun x => x ≫ T.d (n + 1) (n + 2)) p.2.2
      rw [Preadditive.comp_sub, hc, hp, Preadditive.add_comp]
      simp only [Category.assoc, HomologicalComplex.d_comp_d, Limits.comp_zero, zero_add,
        sub_self]
    exact ⟨Homotopy.mkCoinductive f e0.choose e0.choose_spec.symm e1.choose
      (by rw [e1.choose_spec]; abel)
      (fun n p => ⟨(esucc n p).choose, by rw [(esucc n p).choose_spec]; abel⟩)⟩

  obtain ⟨hC1, hC2, hC3, hC4, hC5, -⟩ := hC
  obtain ⟨hJ1, hJ2, hJ3, hJ4, hJ5, -⟩ := hJ
  obtain ⟨wC, -⟩ := id hC3
  obtain ⟨wJ, -⟩ := id hJ3
  obtain ⟨μ, hμ⟩ := hLift C J ηC hC1 hC2 hC3 hC4 hJ5 η wJ
  obtain ⟨ν, hν⟩ := hLift J C η hJ1 hJ2 hJ3 hJ4 hC5 ηC wC
  obtain ⟨H1⟩ := hNull C C ηC hC1 hC3 hC4 hC5 (μ ≫ ν - 𝟙 C) (by
    rw [HomologicalComplex.sub_f_apply, HomologicalComplex.comp_f, HomologicalComplex.id_f,
      Preadditive.comp_sub, ← Category.assoc, hμ, hν, Category.comp_id, sub_self])
  obtain ⟨H2⟩ := hNull J J η hJ1 hJ3 hJ4 hJ5 (ν ≫ μ - 𝟙 J) (by
    rw [HomologicalComplex.sub_f_apply, HomologicalComplex.comp_f, HomologicalComplex.id_f,
      Preadditive.comp_sub, ← Category.assoc, hν, hμ, Category.comp_id, sub_self])
  let e : HomotopyEquiv C J :=
    ⟨μ, ν, Homotopy.equivSubZero.symm H1, Homotopy.equivSubZero.symm H2⟩
  refine ⟨μ, ?_⟩
  have hq := HomotopyEquiv.quasiIso_hom ((preadditiveCoyoneda.obj (Opposite.op
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)))).mapHomotopyEquiv e)
  rw [Functor.mapHomotopyEquiv_hom] at hq
  exact hq

theorem wcU_strict_projection_formula (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ] [Fintype Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α)
    (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (n : ℕ) (hn : 1 ≤ n) (r : ℕ) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n)))
    (lamF : MonoidAlgebra ℤ_[ℓ] Γ → (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶ wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (hlamF : wcRingAct lamF)
    (hlamFs : ∀ (g : Γ) (a : ℤ_[ℓ]), lamF (MonoidAlgebra.single g a) =
      wcCoverScal (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ a ≫
        wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
          (α g⁻¹).hom (hα g⁻¹))
    (I : InjectiveResolution (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (lamI : MonoidAlgebra ℤ_[ℓ] Γ → (I.cocomplex ⟶ I.cocomplex))
    (hI : wcRingResSpec lamF I lamI)
    (P : wcGModel ℓ Γ) (φ : wcGModelAb P ⟶ wcCxJ K hP I.cocomplex) (hφ : QuasiIso φ)
    (hlin : ∀ x : MonoidAlgebra ℤ_[ℓ] Γ, wcGModelSmul P x ≫ φ = φ ≫ wcCxJMap K hP (lamI x))
    (H : Homotopy (φ ≫ wcCxJFrob K hP I.cocomplex) (wcGModelFrob P ≫ φ))
    (hHlin : ∀ (x : MonoidAlgebra ℤ_[ℓ] Γ) (i j : ℕ),
      (wcGModelSmul P x).f i ≫ H.hom i j = H.hom i j ≫ (wcCxJMap K hP (lamI x)).f j)
    (Q : wcLnModel (ZMod (ℓ ^ n))) (hQ : wcIsTwist ℓ n ρ P Q)
    (J : CochainComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) ℕ)
    (η : wcTwSh (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) Γ α hα
      ℓ n r ρ ⟶ J.X 0)
    (hJ : wcNTorsRes K hP (ℓ ^ n) _ J η) :
    ∃ Ψ : wcLnModelAb.{u+1} Q ⟶ wcCxJ K hP J, QuasiIso Ψ ∧
      Nonempty (Homotopy (Ψ ≫ wcCxJFrob K hP J) (wcLnModelFrob Q ≫ Ψ)) :=
by
  obtain ⟨Ψ₀, hΨ₀, ⟨H₀⟩⟩ := wcU_spf_model_side K hP ℓ hℓ m S hS Uo hUo q' Γ α hG hα n hn r ρ
    lamF hlamF hlamFs I lamI hI P φ hφ hlin H hHlin Q hQ
  obtain ⟨ηC, hC⟩ := wcU_spf_twist_res K hP ℓ hℓ m S hS Uo hUo q' Γ α hG hα n hn r ρ
    lamF hlamF hlamFs I lamI hI
  have hN : 1 ≤ ℓ ^ n := Nat.pos_of_ne_zero (pow_ne_zero _ (Fact.out : Nat.Prime ℓ).ne_zero)
  obtain ⟨μ, hμ⟩ := wcU_spf_ntors_comparison K hP (ℓ ^ n) hN _ _ J ηC η hC hJ
  refine ⟨Ψ₀ ≫ wcCxJMap K hP μ, ?_, ⟨?_⟩⟩
  · haveI := hΨ₀
    haveI := hμ
    infer_instance
  · have hnat : wcCxJMap K hP μ ≫ wcCxJFrob K hP J =
        wcCxJFrob K hP _ ≫ wcCxJMap K hP μ :=
      (NatTrans.mapHomologicalComplex _ _).naturality μ
    exact (Homotopy.ofEq (by rw [Category.assoc, hnat, ← Category.assoc])).trans
      ((H₀.compRight (wcCxJMap K hP μ)).trans (Homotopy.ofEq (Category.assoc _ _ _)))

theorem wcU_lm_tower_ses (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (L : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (lam : ℤ_[ℓ] → (L ⟶ L))
    (hlam1 : lam 1 = 𝟙 L)
    (B : ℕ → Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (p : ∀ j, L ⟶ B j) (t : ∀ j, B (j + 1) ⟶ B j)
    (hses : ∀ j, ∃ w : lam ((ℓ : ℤ_[ℓ]) ^ (j + 1)) ≫ p j = 0,
      (ShortComplex.mk _ _ w).ShortExact)
    (hsep : ∀ (T : S.ProEt) (s : L.obj.obj (Opposite.op T)),
      (∀ n : ℕ, s ∈ ((lam ((ℓ : ℤ_[ℓ]) ^ n)).hom.app (Opposite.op T)).hom.range) → s = 0)
    (hcomp : ∀ j, p (j + 1) ≫ t j = p j)
    (hlift : ∀ (T : S.ProEt) (x : ∀ j, (B j).obj.obj (Opposite.op T)),
      (∀ j, ((t j).hom.app (Opposite.op T)).hom (x (j + 1)) = x j) →
      ∃ s : L.obj.obj (Opposite.op T), ∀ j, ((p j).hom.app (Opposite.op T)).hom s = x j) :
    ∃ hz : Limits.Pi.lift p ≫
        Limits.Pi.lift (fun j => Limits.Pi.π B j - Limits.Pi.π B (j + 1) ≫ t j) = 0,
      (ShortComplex.mk _ _ hz).ShortExact :=
by
  classical

  have hsec : ∀ (T : S.ProEt),
      Function.Injective (fun (a : (Limits.piObj B).obj.obj (Opposite.op T)) (j : ℕ) =>
        ((Limits.Pi.π B j).hom.app (Opposite.op T)).hom a) ∧
      Function.Surjective (fun (a : (Limits.piObj B).obj.obj (Opposite.op T)) (j : ℕ) =>
        ((Limits.Pi.π B j).hom.app (Opposite.op T)).hom a) := by
    intro T
    let G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⥤ Type (u+1) :=
      sheafToPresheaf _ _ ⋙ (evaluation _ _).obj (Opposite.op T) ⋙ forget AddCommGrpCat.{u+1}
    have hc := Limits.isLimitOfPreserves G (Limits.productIsProduct B)
    let e := Limits.Types.isLimitEquivSections hc
    constructor
    · intro a b hab
      apply e.injective
      apply Subtype.ext
      funext j
      obtain ⟨j⟩ := j
      rw [Limits.Types.isLimitEquivSections_apply, Limits.Types.isLimitEquivSections_apply]
      exact congrFun hab j
    · intro x
      let sec : (Discrete.functor B ⋙ G).sections := ⟨fun j => x j.as, by
        intro j j' f
        obtain ⟨j⟩ := j
        obtain ⟨j'⟩ := j'
        obtain rfl : j = j' := Discrete.eq_of_hom f
        rw [show f = 𝟙 _ from Subsingleton.elim _ _, FunctorToTypes.map_id_apply]⟩
      refine ⟨e.symm sec, ?_⟩
      funext j
      exact Limits.Types.isLimitEquivSections_symm_apply hc sec ⟨j⟩

  have mono_of_inj : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (φ : X ⟶ Y),
      (∀ T : S.ProEt, Function.Injective (φ.hom.app (Opposite.op T)).hom) → Mono φ := by
    intro X Y φ h
    apply Functor.mono_of_mono_map (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    rw [NatTrans.mono_iff_mono_app]
    intro T
    rw [AddCommGrpCat.mono_iff_injective]
    exact h T.unop
  have inj_of_mono : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (φ : X ⟶ Y),
      Mono φ → ∀ T : S.ProEt, Function.Injective (φ.hom.app (Opposite.op T)).hom := by
    intro X Y φ h T
    have h1 : Mono ((sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map φ) :=
      inferInstance
    have h2 := (NatTrans.mono_iff_mono_app _).mp h1 (Opposite.op T)
    exact (AddCommGrpCat.mono_iff_injective _).mp h2

  have epi_of_surj : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (φ : X ⟶ Y),
      (∀ T : S.ProEt, Function.Surjective (φ.hom.app (Opposite.op T)).hom) → Epi φ := by
    intro X Y φ h
    apply wc_proet_epi_of_affine_lift S φ
    intro U hU y
    obtain ⟨x, hx⟩ := h U y
    refine ⟨U, 𝟙 U, x, hU, ?_, ?_⟩
    · exact (inferInstance : Surjective (𝟙 U.left))
    · have e : Y.obj.map (𝟙 U).op y = y := by simp
      rw [e]
      exact hx

  have ses_sec : ∀ (X : ShortComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})),
      X.ShortExact → ∀ (T : S.ProEt) (x : X.X₂.obj.obj (Opposite.op T)),
      (X.g.hom.app (Opposite.op T)).hom x = 0 →
      ∃ y : X.X₁.obj.obj (Opposite.op T), (X.f.hom.app (Opposite.op T)).hom y = x := by
    intro X hX T x hx
    let F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⥤ AddCommGrpCat.{u+1} :=
      sheafToPresheaf _ _ ⋙ (evaluation _ _).obj (Opposite.op T)
    have h1 : (X.map F).Exact :=
      hX.exact.map_of_mono_of_preservesKernel F hX.mono_f inferInstance
    exact (ShortComplex.ab_exact_iff _).mp h1 x hx

  set g := Limits.Pi.lift (fun j => Limits.Pi.π B j - Limits.Pi.π B (j + 1) ≫ t j) with hg

  have hz : Limits.Pi.lift p ≫ g = 0 := by
    apply Limits.Pi.hom_ext
    intro j
    rw [Category.assoc, hg, Limits.Pi.lift_comp_π, Preadditive.comp_sub, Limits.Pi.lift_comp_π,
      ← Category.assoc, Limits.Pi.lift_comp_π, hcomp, sub_self, Limits.zero_comp]

  have hF : ∀ (T : S.ProEt) (j : ℕ) (a : L.obj.obj (Opposite.op T)),
      ((Limits.Pi.π B j).hom.app (Opposite.op T)).hom
        (((Limits.Pi.lift p).hom.app (Opposite.op T)).hom a) =
      ((p j).hom.app (Opposite.op T)).hom a := by
    intro T j a
    show ((Limits.Pi.lift p ≫ Limits.Pi.π B j).hom.app (Opposite.op T)).hom a = _
    rw [Limits.Pi.lift_comp_π]
  have hG : ∀ (T : S.ProEt) (j : ℕ) (b : (Limits.piObj B).obj.obj (Opposite.op T)),
      ((Limits.Pi.π B j).hom.app (Opposite.op T)).hom ((g.hom.app (Opposite.op T)).hom b) =
      ((Limits.Pi.π B j).hom.app (Opposite.op T)).hom b -
        ((t j).hom.app (Opposite.op T)).hom
          (((Limits.Pi.π B (j + 1)).hom.app (Opposite.op T)).hom b) := by
    intro T j b
    show ((g ≫ Limits.Pi.π B j).hom.app (Opposite.op T)).hom b = _
    rw [hg, Limits.Pi.lift_comp_π]
    rfl

  have hepi_t : ∀ j, Epi (t j) := by
    intro j
    obtain ⟨w, hX⟩ := hses j
    have h1 : Epi (p j) := hX.epi_g
    have h2 : Epi (p (j + 1) ≫ t j) := by rw [hcomp]; exact h1
    exact epi_of_epi (p (j + 1)) (t j)

  have hmono : Mono (Limits.Pi.lift p) := by
    apply mono_of_inj
    intro T
    rw [injective_iff_map_eq_zero]
    intro a ha
    have hpa : ∀ j, ((p j).hom.app (Opposite.op T)).hom a = 0 := by
      intro j
      rw [← hF T j a, ha, map_zero]
    apply hsep T a
    intro n
    cases n with
    | zero =>
      rw [pow_zero, hlam1]
      exact AddMonoidHom.mem_range.mpr ⟨a, rfl⟩
    | succ j =>
      obtain ⟨w, hX⟩ := hses j
      obtain ⟨y, hy⟩ := ses_sec _ hX T a (hpa j)
      exact AddMonoidHom.mem_range.mpr ⟨y, hy⟩

  have hexact : (ShortComplex.mk _ _ hz).Exact := by
    rw [ShortComplex.exact_iff_epi_kernel_lift]
    apply epi_of_surj
    intro T k
    have hgb : (g.hom.app (Opposite.op T)).hom
        (((Limits.kernel.ι g).hom.app (Opposite.op T)).hom k) = 0 := by
      show ((Limits.kernel.ι g ≫ g).hom.app (Opposite.op T)).hom k = 0
      rw [Limits.kernel.condition]
      rfl
    let b := ((Limits.kernel.ι g).hom.app (Opposite.op T)).hom k
    let x : ∀ j, (B j).obj.obj (Opposite.op T) := fun j =>
      ((Limits.Pi.π B j).hom.app (Opposite.op T)).hom b
    have hx : ∀ j, ((t j).hom.app (Opposite.op T)).hom (x (j + 1)) = x j := by
      intro j
      have h := hG T j b
      rw [hgb, map_zero] at h
      exact (sub_eq_zero.mp h.symm).symm
    obtain ⟨s, hs⟩ := hlift T x hx
    have hfs : ((Limits.Pi.lift p).hom.app (Opposite.op T)).hom s = b :=
      (hsec T).1 (funext fun j => (hF T j s).trans (hs j))
    refine ⟨s, ?_⟩
    apply inj_of_mono (Limits.kernel.ι g) inferInstance T
    show ((Limits.kernel.lift g (Limits.Pi.lift p) hz ≫ Limits.kernel.ι g).hom.app
      (Opposite.op T)).hom s = _
    rw [Limits.kernel.lift_ι]
    exact hfs

  have hepi : Epi g := by
    apply wc_proet_epi_of_affine_lift S g
    intro U hU y
    have hyp := fun j => wc_proet_epi_affine_lift S (t j) (hepi_t j)
    choose V' c x hV' hc hx using hyp
    let yj : ∀ j, (B j).obj.obj (Opposite.op U) := fun j =>
      ((Limits.Pi.π B j).hom.app (Opposite.op U)).hom y
    let seq : ∀ j : ℕ, Σ' (V : S.ProEt) (_ : IsAffine V.left) (_ : V ⟶ U),
        (B j).obj.obj (Opposite.op V) :=
      fun j => Nat.rec (motive := fun j => Σ' (V : S.ProEt) (_ : IsAffine V.left) (_ : V ⟶ U),
          (B j).obj.obj (Opposite.op V))
        ⟨U, hU, 𝟙 U, 0⟩
        (fun j s => ⟨V' j s.1 s.2.1 (s.2.2.2 - ((B j).obj.map s.2.2.1.op).hom (yj j)),
          hV' j _ _ _,
          c j s.1 s.2.1 (s.2.2.2 - ((B j).obj.map s.2.2.1.op).hom (yj j)) ≫ s.2.2.1,
          x j s.1 s.2.1 (s.2.2.2 - ((B j).obj.map s.2.2.1.op).hom (yj j))⟩) j
    let V : ℕ → S.ProEt := fun j => (seq j).1
    let ρ : ∀ j, V j ⟶ U := fun j => (seq j).2.2.1
    let z : ∀ j, (B j).obj.obj (Opposite.op (V j)) := fun j => (seq j).2.2.2
    let w : ∀ j, (B j).obj.obj (Opposite.op (V j)) := fun j =>
      z j - ((B j).obj.map (ρ j).op).hom (yj j)
    let cc : ∀ j, V (j + 1) ⟶ V j := fun j => c j (V j) (seq j).2.1 (w j)
    have hVa : ∀ j, IsAffine (V j).left := fun j => (seq j).2.1
    have hcc : ∀ j, Surjective (cc j).left := fun j => hc j _ _ _
    have hxs : ∀ j, ((t j).hom.app (Opposite.op (V (j + 1)))).hom (z (j + 1)) =
        ((B j).obj.map (cc j).op).hom (w j) := fun j => hx j _ _ _
    obtain ⟨W, q, hW, hq, hq0⟩ := wc_proet_affine_tower_limit S V cc hVa hcc
    have hqρ : ∀ j, q j ≫ ρ j = q 0 := by
      intro j
      induction j with
      | zero => exact Category.comp_id _
      | succ j ih =>
        show q (j + 1) ≫ (cc j ≫ ρ j) = q 0
        rw [← Category.assoc, hq j, ih]
    obtain ⟨Z, hZ⟩ := (hsec W).2 (fun j => ((B j).obj.map (q j).op).hom (z j))
    refine ⟨W, q 0, Z, hW, hq0, ?_⟩
    apply (hsec W).1
    funext j
    have e1 : ((Limits.Pi.π B j).hom.app (Opposite.op W)).hom Z =
        ((B j).obj.map (q j).op).hom (z j) := congrFun hZ j
    have e2 : ((Limits.Pi.π B (j + 1)).hom.app (Opposite.op W)).hom Z =
        ((B (j + 1)).obj.map (q (j + 1)).op).hom (z (j + 1)) := congrFun hZ (j + 1)
    have n1 : ((t j).hom.app (Opposite.op W)).hom
        (((B (j + 1)).obj.map (q (j + 1)).op).hom (z (j + 1))) =
        ((B j).obj.map (q (j + 1)).op).hom
          (((t j).hom.app (Opposite.op (V (j + 1)))).hom (z (j + 1))) :=
      NatTrans.naturality_apply (t j).hom (q (j + 1)).op (z (j + 1))
    have n2 : ((Limits.Pi.π B j).hom.app (Opposite.op W)).hom
        (((Limits.piObj B).obj.map (q 0).op).hom y) =
        ((B j).obj.map (q 0).op).hom (yj j) :=
      NatTrans.naturality_apply (Limits.Pi.π B j).hom (q 0).op y
    have r1 : ∀ v : (B j).obj.obj (Opposite.op (V j)),
        ((B j).obj.map (q (j + 1)).op).hom (((B j).obj.map (cc j).op).hom v) =
        ((B j).obj.map (q j).op).hom v := by
      intro v
      rw [← hq j, op_comp, Functor.map_comp]
      rfl
    have r2 : ∀ v : (B j).obj.obj (Opposite.op U),
        ((B j).obj.map (q j).op).hom (((B j).obj.map (ρ j).op).hom v) =
        ((B j).obj.map (q 0).op).hom v := by
      intro v
      rw [← hqρ j, op_comp, Functor.map_comp]
      rfl
    show ((Limits.Pi.π B j).hom.app (Opposite.op W)).hom ((g.hom.app (Opposite.op W)).hom Z) =
      ((Limits.Pi.π B j).hom.app (Opposite.op W)).hom
        (((Limits.piObj B).obj.map (q 0).op).hom y)
    rw [hG W j Z, e1, e2, n1, n2, hxs j, r1]
    show ((B j).obj.map (q j).op).hom (z j) -
      ((B j).obj.map (q j).op).hom (z j - ((B j).obj.map (ρ j).op).hom (yj j)) = _
    rw [map_sub, r2, sub_sub_cancel]
  exact ⟨hz, ShortComplex.ShortExact.mk' hexact hmono hepi⟩

theorem wcU_lm_ext_tower_sep {C : Type*} [Category C] [Abelian C] [HasExt C] [EnoughInjectives C]
    [Limits.HasLimitsOfShape (Discrete ℕ) C] [HasExactLimitsOfShape (Discrete ℕ) C]
    (P Y : C) (B : ℕ → C) (p : ∀ j, Y ⟶ B j) (t : ∀ j, B (j + 1) ⟶ B j)
    (hz : Limits.Pi.lift p ≫
      Limits.Pi.lift (fun j => Limits.Pi.π B j - Limits.Pi.π B (j + 1) ≫ t j) = 0)
    (hses : (ShortComplex.mk _ _ hz).ShortExact)
    (hfin : ∀ j k, Finite (Abelian.Ext P (B j) k)) :
    ∀ (N : ℕ) (x : Abelian.Ext P Y N),
      (∀ j, x.comp (Abelian.Ext.mk₀ (p j)) (add_zero N) = 0) → x = 0 :=
by
  classical
  intro N x hx
  have hprod := fun M => wc_ext_prod_bijective P (∏ᶜ B) B (Limits.Pi.π B)
    (Limits.productIsProduct B) M

  have hlim1 : ∀ (k : ℕ) (w : ∀ j, Abelian.Ext P (B j) k),
      ∃ v : ∀ j, Abelian.Ext P (B j) k,
      ∀ j, w j = v j - (v (j + 1)).comp (Abelian.Ext.mk₀ (t j)) (add_zero k) := by
    intro k w
    obtain ⟨s, hs⟩ := @nonempty_sections_of_finite_inverse_system ℕ _ _
      (Functor.ofOpSequence (X := fun j => Abelian.Ext P (B j) k)
        (fun j => TypeCat.ofHom (fun a => w j + a.comp (Abelian.Ext.mk₀ (t j)) (add_zero k))))
      (fun j => hfin j.unop k) (fun j => ⟨(0 : Abelian.Ext P (B j.unop) k)⟩)
    refine ⟨fun j => (s (Opposite.op j) : Abelian.Ext P (B j) k), fun j => ?_⟩
    have h1 := hs (homOfLE (Nat.le_succ j)).op
    rw [Functor.ofOpSequence_map_homOfLE_succ] at h1
    exact eq_sub_of_add_eq h1
  have hfπ : ∀ j, Limits.Pi.lift p ≫ Limits.Pi.π B j = p j := fun j => by simp
  have hgπ : ∀ j, Limits.Pi.lift (fun j => Limits.Pi.π B j - Limits.Pi.π B (j + 1) ≫ t j) ≫
      Limits.Pi.π B j = Limits.Pi.π B j - Limits.Pi.π B (j + 1) ≫ t j := fun j => by simp

  have hxf : x.comp (Abelian.Ext.mk₀ (ShortComplex.mk _ _ hz).f) (add_zero N) = 0 := by
    apply (hprod N).1
    intro j
    change (x.comp (Abelian.Ext.mk₀ (Limits.Pi.lift p)) (add_zero N)).comp
      (Abelian.Ext.mk₀ (Limits.Pi.π B j)) (add_zero N) = 0
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero N) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hfπ]
    exact hx j
  have hsubmk : ∀ {A B : C} (a b : A ⟶ B),
      Abelian.Ext.mk₀ (a - b) = Abelian.Ext.mk₀ a - Abelian.Ext.mk₀ b := by
    intro A B a b
    rw [sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg, ← sub_eq_add_neg]
  have hcompsub : ∀ {A B D : C} {q : ℕ}
      (α : Abelian.Ext A B q) (β₁ β₂ : Abelian.Ext B D 0),
      α.comp (β₁ - β₂) (add_zero q) = α.comp β₁ (add_zero q) - α.comp β₂ (add_zero q) := by
    intro A B D q α β₁ β₂
    rw [sub_eq_add_neg, Abelian.Ext.comp_add, Abelian.Ext.comp_neg, ← sub_eq_add_neg]
  cases N with
  | zero =>
    haveI : Mono (ShortComplex.mk _ _ hz).f := hses.mono_f
    apply Abelian.Ext.postcomp_mk₀_injective_of_mono P (ShortComplex.mk _ _ hz).f
    rw [map_zero]
    exact hxf
  | succ k =>
    obtain ⟨z, hz'⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hses x hxf (n₀ := k) rfl
    obtain ⟨v, hv⟩ := hlim1 k (fun j => z.comp (Abelian.Ext.mk₀ (Limits.Pi.π B j)) (add_zero k))
    obtain ⟨W, hW⟩ := (hprod k).2 v
    have hWg : W.comp (Abelian.Ext.mk₀ (ShortComplex.mk _ _ hz).g) (add_zero k) = z := by
      rw [← sub_eq_zero]
      apply (hprod k).1
      intro j
      rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg]
      change (W.comp (Abelian.Ext.mk₀ (Limits.Pi.lift
          (fun j => Limits.Pi.π B j - Limits.Pi.π B (j + 1) ≫ t j))) (add_zero k)).comp
          (Abelian.Ext.mk₀ (Limits.Pi.π B j)) (add_zero k) - _ = 0
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero k) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, hgπ, hsubmk, hcompsub,
        ← Abelian.Ext.mk₀_comp_mk₀,
        ← Abelian.Ext.comp_assoc _ _ _ (add_zero k) (add_zero 0) (by omega), hW, hW, hv j,
        sub_self]
    have hce : (Abelian.Ext.mk₀ (ShortComplex.mk _ _ hz).g).comp
        hses.extClass (zero_add 1) = 0 := hses.comp_extClass
    rw [← hz', ← hWg, Abelian.Ext.comp_assoc _ _ _ (add_zero k) (zero_add 1) (by omega), hce,
      Abelian.Ext.comp_zero]

theorem wcU_lm_ext_fg_of_sep {C : Type*} [Category C] [Abelian C] [HasExt C]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (P L : C) (lam : ℤ_[ℓ] → (L ⟶ L)) (hlam : wcRingAct lam)
    (B : ℕ → C) (p : ∀ j, L ⟶ B j)
    (hkill : ∀ j, lam ((ℓ : ℤ_[ℓ]) ^ (j + 1)) ≫ p j = 0)
    (h1 : ∃ w : lam ((ℓ : ℤ_[ℓ]) ^ 1) ≫ p 0 = 0, (ShortComplex.mk _ _ w).ShortExact)
    (hfin0 : ∀ i, Finite (Abelian.Ext P (B 0) i))
    (hvanB : ∀ j i, 3 ≤ i → ∀ y : Abelian.Ext P (B j) i, y = 0)
    (hsep : ∀ (N : ℕ) (x : Abelian.Ext P L N),
      (∀ j, x.comp (Abelian.Ext.mk₀ (p j)) (add_zero N) = 0) → x = 0) :
    (∀ N, ∃ (k : ℕ) (e : Fin k → Abelian.Ext P L N), ∀ x : Abelian.Ext P L N,
      ∃ c : Fin k → ℤ_[ℓ], x = ∑ i, (e i).comp (Abelian.Ext.mk₀ (lam (c i))) (add_zero N)) ∧
    (∀ N, 3 ≤ N → ∀ x : Abelian.Ext P L N, x = 0) :=
by
  classical
  obtain ⟨hl1, hladd, hlmul⟩ := hlam
  have h0 : lam 0 = 0 := by
    have h := hladd 0 0
    rw [add_zero] at h
    have h' : lam 0 + 0 = lam 0 + lam 0 := by rw [add_zero]; exact h
    exact (add_left_cancel h').symm
  refine ⟨fun N => ?_, fun N hN x => hsep N x (fun j => hvanB j N hN _)⟩

  letI inst : Module ℤ_[ℓ] (Abelian.Ext P L N) :=
    { smul := fun c x => x.comp (Abelian.Ext.mk₀ (lam c)) (add_zero N)
      one_smul := fun x => by
        show x.comp (Abelian.Ext.mk₀ (lam 1)) (add_zero N) = x
        rw [hl1]
        exact Abelian.Ext.comp_mk₀_id x
      mul_smul := fun a b x => by
        show x.comp (Abelian.Ext.mk₀ (lam (a * b))) (add_zero N) =
          (x.comp (Abelian.Ext.mk₀ (lam b)) (add_zero N)).comp
            (Abelian.Ext.mk₀ (lam a)) (add_zero N)
        rw [hlmul a b, ← Abelian.Ext.mk₀_comp_mk₀]
        exact (Abelian.Ext.comp_assoc _ _ _ (add_zero N) (zero_add 0) (by omega)).symm
      smul_zero := fun c => by
        show (0 : Abelian.Ext P L N).comp (Abelian.Ext.mk₀ (lam c)) (add_zero N) = 0
        exact Abelian.Ext.zero_comp _ _ _ _ _
      smul_add := fun c x y => by
        show (x + y).comp (Abelian.Ext.mk₀ (lam c)) (add_zero N) =
          x.comp (Abelian.Ext.mk₀ (lam c)) (add_zero N) +
            y.comp (Abelian.Ext.mk₀ (lam c)) (add_zero N)
        exact Abelian.Ext.add_comp _ _ _ _
      add_smul := fun a b x => by
        show x.comp (Abelian.Ext.mk₀ (lam (a + b))) (add_zero N) =
          x.comp (Abelian.Ext.mk₀ (lam a)) (add_zero N) +
            x.comp (Abelian.Ext.mk₀ (lam b)) (add_zero N)
        rw [hladd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
      zero_smul := fun x => by
        show x.comp (Abelian.Ext.mk₀ (lam 0)) (add_zero N) = 0
        rw [h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] }
  have hsmul : ∀ (c : ℤ_[ℓ]) (x : Abelian.Ext P L N),
      c • x = x.comp (Abelian.Ext.mk₀ (lam c)) (add_zero N) := fun c x => rfl

  have hreps : ∃ T : Finset (Abelian.Ext P L N), ∀ m : Abelian.Ext P L N,
      ∃ t ∈ T, ∃ m' : Abelian.Ext P L N, m = t + (ℓ : ℤ_[ℓ]) • m' := by
    haveI := hfin0 N
    haveI : Fintype (Abelian.Ext P (B 0) N) := Fintype.ofFinite _
    let ρ : Abelian.Ext P L N → Abelian.Ext P (B 0) N :=
      fun m => m.comp (Abelian.Ext.mk₀ (p 0)) (add_zero N)
    let sec : Abelian.Ext P (B 0) N → Abelian.Ext P L N :=
      fun y => if h : ∃ m, ρ m = y then h.choose else 0
    refine ⟨Finset.univ.image sec, fun m =>
      ⟨sec (ρ m), Finset.mem_image_of_mem _ (Finset.mem_univ _), ?_⟩⟩
    have hsec : ρ (sec (ρ m)) = ρ m := by
      have h : ∃ m', ρ m' = ρ m := ⟨m, rfl⟩
      show ρ (if h : ∃ m', ρ m' = ρ m then h.choose else 0) = ρ m
      rw [dif_pos h]
      exact h.choose_spec
    obtain ⟨w, hw⟩ := h1
    have hz : (m - sec (ρ m)).comp (Abelian.Ext.mk₀ (p 0)) (add_zero N) = 0 := by
      rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp]
      change ρ m + -ρ (sec (ρ m)) = 0
      rw [hsec, add_neg_cancel]
    obtain ⟨m', hm'⟩ : ∃ m' : Abelian.Ext P L N,
        m'.comp (Abelian.Ext.mk₀ (lam ((ℓ : ℤ_[ℓ]) ^ 1))) (add_zero N) = m - sec (ρ m) :=
      Abelian.Ext.covariant_sequence_exact₂ P hw (m - sec (ρ m)) hz
    refine ⟨m', ?_⟩
    have e2 : ((ℓ : ℤ_[ℓ]) ^ 1) • m' = m - sec (ρ m) := hm'
    have e1 : (ℓ : ℤ_[ℓ]) • m' = ((ℓ : ℤ_[ℓ]) ^ 1) • m' :=
      congrArg (fun c : ℤ_[ℓ] => c • m') (pow_one (ℓ : ℤ_[ℓ])).symm
    rw [e1, e2]
    abel

  have hdiv : ∀ w : ℕ → Abelian.Ext P L N, (∀ n, w n = (ℓ : ℤ_[ℓ]) • w (n + 1)) → w 0 = 0 := by
    intro w hw
    have ha : ∀ j : ℕ, w 0 = ((ℓ : ℤ_[ℓ]) ^ (j + 1)) • w (j + 1) := by
      intro j
      induction j with
      | zero => rw [zero_add, pow_one]; exact hw 0
      | succ j ih => rw [ih, hw (j + 1), smul_smul, ← pow_succ]
    apply hsep N (w 0)
    intro j
    rw [ha j, hsmul, Abelian.Ext.comp_assoc _ _ _ (add_zero N) (zero_add 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hkill j, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]

  have nak : Module.Finite ℤ_[ℓ] (Abelian.Ext P L N) := by
    obtain ⟨T, hT⟩ := hreps
    have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := by exact_mod_cast (Fact.out : Nat.Prime ℓ).one_lt
    have hsum : ∀ c : ℕ → ℤ_[ℓ], Summable (fun j => (ℓ : ℤ_[ℓ]) ^ j * c j) := by
      intro c
      refine Summable.of_norm_bounded (g := fun j : ℕ => ((ℓ : ℝ)⁻¹) ^ j)
        (summable_geometric_of_lt_one (by positivity) (inv_lt_one_of_one_lt₀ hℓ1)) ?_
      intro j
      calc ‖(ℓ : ℤ_[ℓ]) ^ j * c j‖ ≤ ‖(ℓ : ℤ_[ℓ]) ^ j‖ * ‖c j‖ := norm_mul_le _ _
        _ ≤ ‖(ℓ : ℤ_[ℓ]) ^ j‖ * 1 :=
            mul_le_mul_of_nonneg_left (PadicInt.norm_le_one _) (norm_nonneg _)
        _ = ((ℓ : ℝ)⁻¹) ^ j := by rw [mul_one, norm_pow, PadicInt.norm_p]
    obtain ⟨A, hA⟩ : ∃ A : (ℕ → ℤ_[ℓ]) → ℤ_[ℓ], ∀ c : ℕ → ℤ_[ℓ],
        A c = c 0 + (ℓ : ℤ_[ℓ]) * A (fun j => c (j + 1)) := by
      refine ⟨fun c => ∑' j, (ℓ : ℤ_[ℓ]) ^ j * c j, fun c => ?_⟩
      show ∑' j, (ℓ : ℤ_[ℓ]) ^ j * c j = c 0 + (ℓ : ℤ_[ℓ]) * ∑' j, (ℓ : ℤ_[ℓ]) ^ j * c (j + 1)
      rw [(hsum c).tsum_eq_zero_add, pow_zero, one_mul,
        ← (hsum (fun j => c (j + 1))).tsum_mul_left]
      congr 1
      apply tsum_congr
      intro j
      ring
    choose dig hdigT nxt hnxt using hT
    rw [Module.finite_def]
    refine ⟨T, ?_⟩
    rw [eq_top_iff]
    intro m _
    obtain ⟨μ, hμ0, hμ⟩ : ∃ μ : ℕ → Abelian.Ext P L N, μ 0 = m ∧ ∀ n, μ (n + 1) = nxt (μ n) :=
      ⟨fun n => nxt^[n] m, rfl, fun n => Function.iterate_succ_apply' nxt n m⟩
    obtain ⟨κ, hκ⟩ : ∃ κ : ℕ → Abelian.Ext P L N → ℤ_[ℓ], ∀ n s,
        κ n s = (if dig (μ n) = s then (1 : ℤ_[ℓ]) else 0) + (ℓ : ℤ_[ℓ]) * κ (n + 1) s := by
      refine ⟨fun n s => A (fun j => if dig (μ (n + j)) = s then (1 : ℤ_[ℓ]) else 0),
        fun n s => ?_⟩
      have h1 := hA (fun j => if dig (μ (n + j)) = s then (1 : ℤ_[ℓ]) else 0)
      have e : (fun j => if dig (μ (n + (j + 1))) = s then (1 : ℤ_[ℓ]) else 0) =
          (fun j => if dig (μ (n + 1 + j)) = s then (1 : ℤ_[ℓ]) else 0) := by
        funext j
        rw [show n + (j + 1) = n + 1 + j by omega]
      beta_reduce at h1
      rw [add_zero, e] at h1
      exact h1
    have hsplit : ∀ n, ∑ s ∈ T, κ n s • s =
        dig (μ n) + (ℓ : ℤ_[ℓ]) • ∑ s ∈ T, κ (n + 1) s • s := by
      intro n
      have h3 : ∑ s ∈ T, (if dig (μ n) = s then (1 : ℤ_[ℓ]) else 0) • s = dig (μ n) := by
        simp only [ite_smul, one_smul, zero_smul]
        rw [Finset.sum_ite_eq, if_pos (hdigT (μ n))]
      rw [Finset.sum_congr rfl (fun s _ => by rw [hκ n s]), Finset.smul_sum]
      simp only [add_smul, mul_smul, Finset.sum_add_distrib, h3]
    have hw : ∀ n, μ n - ∑ s ∈ T, κ n s • s =
        (ℓ : ℤ_[ℓ]) • (μ (n + 1) - ∑ s ∈ T, κ (n + 1) s • s) := by
      intro n
      have h2 : μ n = dig (μ n) + (ℓ : ℤ_[ℓ]) • μ (n + 1) := by rw [hμ n]; exact hnxt (μ n)
      rw [hsplit n, smul_sub]
      generalize dig (μ n) = d at h2 ⊢
      rw [h2]
      abel
    have h0' : μ 0 - ∑ s ∈ T, κ 0 s • s = 0 := hdiv (fun n => μ n - ∑ s ∈ T, κ n s • s) hw
    rw [hμ0, sub_eq_zero] at h0'
    rw [h0']
    exact Submodule.sum_smul_mem _ _ (fun s hs => Submodule.subset_span hs)

  obtain ⟨k, e, he⟩ := Module.Finite.exists_fin (R := ℤ_[ℓ]) (M := Abelian.Ext P L N)
  refine ⟨k, e, fun x => ?_⟩
  have hx : x ∈ Submodule.span ℤ_[ℓ] (Set.range e) := by rw [he]; exact Submodule.mem_top
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ_[ℓ]).mp hx
  exact ⟨c, hc.symm⟩

theorem wcU_lm_ext_finite_of_lnmodel (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (N : ℕ) (hN : 1 ≤ N)
    (𝓖 : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (J : CochainComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) ℕ)
    (η : 𝓖 ⟶ J.X 0) (hJ : wcNTorsRes K hP N 𝓖 J η)
    (Q : wcLnModel (ZMod N)) (Ψ : wcLnModelAb.{u+1} Q ⟶ wcCxJ K hP J) (hΨ : QuasiIso Ψ) :
    ∀ i : ℕ, Finite (Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
        𝓖 i) ∧
      (3 ≤ i → ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
        𝓖 i, y = 0) :=
by
  classical

  have hIsoExt : ∀ (P A B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (e : A ≅ B) (r : ℕ), Nonempty (Abelian.Ext P A r ≃ Abelian.Ext P B r) := by
    intro P A B e r
    exact ⟨{ toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero r)
             invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero r)
             left_inv := fun x => by
               simp only
               rw [Abelian.Ext.comp_assoc _ _ _ (add_zero r) (add_zero 0) (by omega),
                 Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
             right_inv := fun y => by
               simp only
               rw [Abelian.Ext.comp_assoc _ _ _ (add_zero r) (add_zero 0) (by omega),
                 Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }⟩

  have hAR : ∀ (P : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (Kc : CochainComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) ℕ),
      (∀ n : ℕ, Kc.ExactAt (n + 1)) → (∀ n k : ℕ, Subsingleton (Abelian.Ext P (Kc.X n) (k + 1))) →
      ∀ q : ℕ, Nonempty ((((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj Kc).homology q ≃ Abelian.Ext P (Kc.homology 0) q) := by
    intro P Kc hex hacyc q
    have hG : ∀ (i j k : ℕ) (hi : (ComplexShape.up ℕ).prev j = i)
        (hk : (ComplexShape.up ℕ).next j = k)
        (Y : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) (r : ℕ)
        (δ : (P ⟶ Kc.cycles j) →+ Abelian.Ext P Y r), Function.Surjective δ →
        (∀ y, δ y = 0 ↔ ∃ x : P ⟶ Kc.X i, x ≫ Kc.d i j = y ≫ Kc.iCycles j) →
        Nonempty ((((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj Kc).homology j ≃ Abelian.Ext P Y r) := by
      intro i j k hi hk Y r δ hδ hker
      let C := ((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj Kc
      let T := C.sc' i j k
      let e1 : C.homology j ≃+ T.homology :=
        (C.homologyIsoSc' i j k hi hk).addCommGroupIsoToAddEquiv
      let e2 : T.homology ≃+ (T.g.hom.ker ⧸ T.abToCycles.range) :=
        T.abHomologyIso.addCommGroupIsoToAddEquiv
      have hmem : ∀ z : P ⟶ Kc.cycles j, (z ≫ Kc.iCycles j : T.X₂) ∈ T.g.hom.ker := by
        intro z
        change (z ≫ Kc.iCycles j) ≫ Kc.d j k = 0
        simp
      let Φ : (P ⟶ Kc.cycles j) →+ T.g.hom.ker :=
        AddMonoidHom.mk' (fun z => ⟨(z ≫ Kc.iCycles j : T.X₂), hmem z⟩) (by
          intro a b
          apply Subtype.ext
          change (a + b) ≫ Kc.iCycles j = a ≫ Kc.iCycles j + b ≫ Kc.iCycles j
          exact Preadditive.add_comp _ _ _ _ _ _)
      have hΦ : Function.Bijective Φ := by
        constructor
        · intro a b hab
          have h1 : a ≫ Kc.iCycles j = b ≫ Kc.iCycles j := congrArg Subtype.val hab
          exact (cancel_mono (Kc.iCycles j)).mp h1
        · intro v
          have hv : (show P ⟶ Kc.X j from v.1) ≫ Kc.d j k = 0 := v.2
          refine ⟨Kc.liftCycles (show P ⟶ Kc.X j from v.1) k hk hv, ?_⟩
          apply Subtype.ext
          exact Kc.liftCycles_i _ _ _ _
      let Φe := AddEquiv.ofBijective Φ hΦ
      let θ : T.g.hom.ker →+ Abelian.Ext P Y r := δ.comp Φe.symm.toAddMonoidHom
      have hθ : Function.Surjective θ := by
        intro m
        obtain ⟨y, rfl⟩ := hδ m
        refine ⟨Φe y, ?_⟩
        simp [θ]
      have hrange : T.abToCycles.range = θ.ker := by
        ext v
        rw [AddMonoidHom.mem_range, AddMonoidHom.mem_ker]
        have hv : Φ (Φe.symm v) = v := Φe.apply_symm_apply v
        have h2 : (Φe.symm v) ≫ Kc.iCycles j = (show P ⟶ Kc.X j from v.1) :=
          congrArg Subtype.val hv
        change _ ↔ δ (Φe.symm v) = 0
        rw [hker]
        constructor
        · rintro ⟨x, hx⟩
          refine ⟨x, ?_⟩
          have h1 : x ≫ Kc.d i j = (show P ⟶ Kc.X j from v.1) := congrArg Subtype.val hx
          rw [h1, h2]
        · rintro ⟨x, hx⟩
          refine ⟨x, ?_⟩
          apply Subtype.ext
          change x ≫ Kc.d i j = (show P ⟶ Kc.X j from v.1)
          rw [hx, h2]
      exact ⟨(e1.trans (e2.trans ((QuotientAddGroup.quotientAddEquivOfEq hrange).trans
        (QuotientAddGroup.quotientKerEquivOfSurjective θ hθ)))).toEquiv⟩
    have hw : ∀ n : ℕ, Kc.iCycles n ≫ Kc.toCycles n (n + 1) = 0 := by
      intro n
      rw [← cancel_mono (Kc.iCycles (n + 1)), Category.assoc, Kc.toCycles_i, Kc.iCycles_d,
        Limits.zero_comp]
    have hSE : ∀ n : ℕ,
        (ShortComplex.mk (Kc.iCycles n) (Kc.toCycles n (n + 1)) (hw n)).ShortExact := by
      intro n
      have hex' := (Kc.exactAt_iff' n (n + 1) (n + 1 + 1) (CochainComplex.prev_nat_succ n)
        (CochainComplex.next ℕ (n + 1))).mp (hex n)
      have hepi : Epi (Kc.toCycles n (n + 1)) := by
        have h1 : Epi (Kc.toCycles n (n + 1) ≫ (Kc.cyclesIsoSc' n (n + 1) (n + 1 + 1)
            (CochainComplex.prev_nat_succ n) (CochainComplex.next ℕ (n + 1))).hom) := by
          rw [Kc.toCycles_cyclesIsoSc'_hom]
          exact hex'.epi_toCycles
        exact (epi_comp_iff_of_isIso _ _).mp h1
      have hlim : Limits.IsLimit (Limits.KernelFork.ofι (Kc.iCycles n) (hw n)) :=
        Limits.KernelFork.IsLimit.ofι _ _
          (fun g' hg' => Kc.liftCycles g' (n + 1) (CochainComplex.next ℕ n) (by
            rw [← Kc.toCycles_i n (n + 1), ← Category.assoc, hg', Limits.zero_comp]))
          (fun g' hg' => Kc.liftCycles_i _ _ _ _)
          (fun g' hg' m hm => by
            rw [← cancel_mono (Kc.iCycles n), hm, Kc.liftCycles_i])
      exact ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ hlim)
        inferInstance hepi
    let e := CochainComplex.isoHomologyπ₀ Kc
    have hE : ∀ r : ℕ, Nonempty (Abelian.Ext P (Kc.cycles 0) r ≃
        Abelian.Ext P (Kc.homology 0) r) := fun r => hIsoExt P _ _ e r
    have hs2 : ∀ (S : ShortComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left)
          AddCommGrpCat.{u+1})) (hS : S.ShortExact),
        (∀ k : ℕ, Subsingleton (Abelian.Ext P S.X₂ (k + 1))) → ∀ j : ℕ,
        Nonempty (Abelian.Ext P S.X₃ (j + 1) ≃ Abelian.Ext P S.X₁ (j + 1 + 1)) := by
      intro S hS hS2 j
      let δ : Abelian.Ext P S.X₃ (j + 1) →+ Abelian.Ext P S.X₁ (j + 1 + 1) :=
        hS.extClass.postcomp P rfl
      have hδ : Function.Bijective δ := by
        constructor
        · rw [injective_iff_map_eq_zero]
          intro x hx
          obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS x rfl hx
          have h0 : x₂ = 0 := @Subsingleton.elim _ (hS2 j) _ _
          rw [← hx₂, h0, Abelian.Ext.zero_comp]
        · intro y
          have h0 : y.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
            @Subsingleton.elim _ (hS2 (j + 1)) _ _
          obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS y h0 (n₀ := j + 1) rfl
          exact ⟨x₃, hx₃⟩
      exact ⟨Equiv.ofBijective δ hδ⟩
    have hT : ∀ m j a : ℕ, a = j + 1 + m →
        Nonempty (Abelian.Ext P (Kc.cycles m) (j + 1) ≃ Abelian.Ext P (Kc.cycles 0) a) := by
      intro m
      induction m with
      | zero => intro j a ha; subst ha; exact ⟨Equiv.refl _⟩
      | succ m ih =>
        intro j a ha
        obtain ⟨e1⟩ := hs2 _ (hSE m) (hacyc m) j
        obtain ⟨e2⟩ := ih (j + 1) a (by omega)
        exact ⟨e1.trans e2⟩
    cases q with
    | zero =>
      let δ : (P ⟶ Kc.cycles 0) →+ Abelian.Ext P (Kc.homology 0) 0 :=
        AddMonoidHom.mk' (fun y => Abelian.Ext.mk₀ (y ≫ e.hom)) (by
          intro a b
          rw [Preadditive.add_comp, Abelian.Ext.mk₀_add])
      have hinj : ∀ y : P ⟶ Kc.cycles 0, δ y = 0 → y = 0 := by
        intro y hy
        have h1 : Abelian.Ext.mk₀ (y ≫ e.hom) = Abelian.Ext.mk₀ (0 : P ⟶ Kc.homology 0) := by
          rw [Abelian.Ext.mk₀_zero]; exact hy
        rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at h1
        have h2 : y ≫ e.hom = 0 := Abelian.Ext.homEquiv₀.symm.injective h1
        rw [← cancel_mono e.hom, h2, Limits.zero_comp]
      refine hG 0 0 1 CochainComplex.prev_nat_zero (CochainComplex.next ℕ 0) _ _ δ ?_ ?_
      · intro z
        refine ⟨Abelian.Ext.homEquiv₀ z ≫ e.inv, ?_⟩
        change Abelian.Ext.mk₀ ((Abelian.Ext.homEquiv₀ z ≫ e.inv) ≫ e.hom) = z
        rw [Category.assoc, Iso.inv_hom_id, Category.comp_id, Abelian.Ext.mk₀_homEquiv₀_apply]
      · intro y
        constructor
        · intro hy
          rw [hinj y hy]
          exact ⟨0, by simp⟩
        · rintro ⟨x, hx⟩
          have hd : Kc.d 0 0 = 0 := Kc.shape 0 0 (by simp)
          rw [hd, Limits.comp_zero] at hx
          have hy : y = 0 := by
            rw [← cancel_mono (Kc.iCycles 0), ← hx, Limits.zero_comp]
          rw [hy, map_zero]
    | succ q =>
      let S := ShortComplex.mk (Kc.iCycles q) (Kc.toCycles q (q + 1)) (hw q)
      have hS : S.ShortExact := hSE q
      let δ : (P ⟶ Kc.cycles (q + 1)) →+ Abelian.Ext P (Kc.cycles q) 1 :=
        AddMonoidHom.mk' (fun y => (Abelian.Ext.mk₀ y).comp hS.extClass (zero_add 1)) (by
          intro a b
          rw [Abelian.Ext.mk₀_add, Abelian.Ext.add_comp])
      have hδs : Function.Surjective δ := by
        intro y
        have h0 : y.comp (Abelian.Ext.mk₀ S.f) (add_zero 1) = 0 :=
          @Subsingleton.elim _ (hacyc q 0) _ _
        obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS y h0 (n₀ := 0) (zero_add 1)
        refine ⟨Abelian.Ext.homEquiv₀ x₃, ?_⟩
        change (Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ x₃)).comp hS.extClass (zero_add 1) = y
        rw [Abelian.Ext.mk₀_homEquiv₀_apply]
        exact hx₃
      have hδk : ∀ y, δ y = 0 ↔
          ∃ x : P ⟶ Kc.X q, x ≫ Kc.d q (q + 1) = y ≫ Kc.iCycles (q + 1) := by
        intro y
        constructor
        · intro hy
          obtain ⟨x₂, hx₂⟩ :=
            Abelian.Ext.covariant_sequence_exact₃ P hS (Abelian.Ext.mk₀ y) (zero_add 1) hy
          refine ⟨Abelian.Ext.homEquiv₀ x₂, ?_⟩
          rw [← Abelian.Ext.mk₀_homEquiv₀_apply x₂, Abelian.Ext.mk₀_comp_mk₀] at hx₂
          rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at hx₂
          have h2 := Abelian.Ext.homEquiv₀.symm.injective hx₂
          rw [← Kc.toCycles_i q (q + 1), ← Category.assoc]
          change (Abelian.Ext.homEquiv₀ x₂ ≫ S.g) ≫ _ = _
          rw [h2]
        · rintro ⟨x, hx⟩
          have h1 : x ≫ S.g = y := by
            rw [← cancel_mono (Kc.iCycles (q + 1)), ← hx]
            change (x ≫ Kc.toCycles q (q + 1)) ≫ _ = _
            rw [Category.assoc, Kc.toCycles_i]
          change (Abelian.Ext.mk₀ y).comp hS.extClass (zero_add 1) = 0
          rw [← h1, ← Abelian.Ext.mk₀_comp_mk₀,
            Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega), hS.comp_extClass,
            Abelian.Ext.comp_zero]
      obtain ⟨e1⟩ := hG q (q + 1) (q + 1 + 1) (CochainComplex.prev_nat_succ q)
        (CochainComplex.next ℕ (q + 1)) _ _ δ hδs hδk
      obtain ⟨e2⟩ := hT q 0 (q + 1) (by omega)
      obtain ⟨e3⟩ := hE (q + 1)
      exact ⟨e1.trans (e2.trans e3)⟩

  obtain ⟨-, hmono, ⟨w, hex0⟩, hR4, -, hR6⟩ := hJ
  have hex : ∀ n : ℕ, J.ExactAt (n + 1) := fun n => (J.exactAt_iff (n + 1)).mpr (hR4 n)
  have hacyc : ∀ n k : ℕ, Subsingleton (Abelian.Ext (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP)) (J.X n) (k + 1)) := fun n k =>
    ⟨fun a b => (hR6 n (k + 1) (by omega) a).trans (hR6 n (k + 1) (by omega) b).symm⟩

  haveI := hmono
  have h₀ : Limits.IsLimit (Limits.KernelFork.ofι η w) := hex0.fIsKernel
  let e₀ : J.homology 0 ≅ 𝓖 := (CochainComplex.isoHomologyπ₀ J).symm ≪≫
    Limits.IsLimit.conePointUniqueUpToIso (J.cyclesIsKernel 0 1 (CochainComplex.next ℕ 0)) h₀

  haveI : NeZero N := ⟨by omega⟩
  have hXfin : ∀ q, Finite ((wcLnModelAb.{u+1} Q).X q) := by
    intro q
    change Finite (ULift.{u+1} (wcIdemSub (Q.ε q)))
    infer_instance
  have hXsub : ∀ q, 3 ≤ q → Subsingleton ((wcLnModelAb.{u+1} Q).X q) := by
    intro q hq
    change Subsingleton (ULift.{u+1} (wcIdemSub (Q.ε q)))
    have hk := Q.hk q hq
    constructor
    intro a b
    apply ULift.ext
    apply Subtype.ext
    funext x
    exfalso
    have := x.2
    omega
  have hHfin : ∀ q, Finite ((wcLnModelAb.{u+1} Q).homology q) := by
    intro q
    have hi : Function.Injective ((wcLnModelAb.{u+1} Q).iCycles q) :=
      (AddCommGrpCat.mono_iff_injective _).mp inferInstance
    have hs : Function.Surjective ((wcLnModelAb.{u+1} Q).homologyπ q) :=
      (AddCommGrpCat.epi_iff_surjective _).mp inferInstance
    haveI := hXfin q
    haveI : Finite ((wcLnModelAb.{u+1} Q).cycles q) := Finite.of_injective _ hi
    exact Finite.of_surjective _ hs
  have hHsub : ∀ q, 3 ≤ q → Subsingleton ((wcLnModelAb.{u+1} Q).homology q) := by
    intro q hq
    have hi : Function.Injective ((wcLnModelAb.{u+1} Q).iCycles q) :=
      (AddCommGrpCat.mono_iff_injective _).mp inferInstance
    have hs : Function.Surjective ((wcLnModelAb.{u+1} Q).homologyπ q) :=
      (AddCommGrpCat.epi_iff_surjective _).mp inferInstance
    haveI := hXsub q hq
    haveI : Subsingleton ((wcLnModelAb.{u+1} Q).cycles q) := hi.subsingleton
    constructor
    intro a b
    obtain ⟨a', rfl⟩ := hs a
    obtain ⟨b', rfl⟩ := hs b
    rw [Subsingleton.elim a' b']

  intro i
  haveI := hΨ
  let e₁ : (wcLnModelAb.{u+1} Q).homology i ≃ (wcCxJ K hP J).homology i :=
    (asIso (HomologicalComplex.homologyMap Ψ i)).addCommGroupIsoToAddEquiv.toEquiv
  obtain ⟨E₂⟩ := hAR _ J hex hacyc i
  obtain ⟨E₃⟩ := hIsoExt (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) _ _ e₀ i
  let eAll : (wcLnModelAb.{u+1} Q).homology i ≃
      Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) 𝓖 i :=
    e₁.trans (E₂.trans E₃)
  refine ⟨?_, ?_⟩
  · haveI := hHfin i
    exact Finite.of_equiv _ eAll
  · intro h3 y
    haveI := hHsub i h3
    haveI : Subsingleton (Abelian.Ext (wcFreeSheaf (wcP1Over K).left
        (wcGeomPoint K (wcP1Over K) hP)) 𝓖 i) := eAll.symm.subsingleton
    exact Subsingleton.elim y 0

theorem wcU_lm_head_projective (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (S : Scheme.{u})
    (P L : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (lamL : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} → (L ⟶ L)) (hlamL : wcRingAct lamL)
    (hmono : Mono (lamL (MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ]))))
    (I : InjectiveResolution L)
    (lamI : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} → (I.cocomplex ⟶ I.cocomplex))
    (hI : wcRingResSpec lamL I lamI)
    (T : wcThreeTermModel (((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex)
      (fun c => ((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
        (ComplexShape.up ℕ)).map (lamI c))) :
    Module.Projective (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) T.M :=
by
  classical
  let aug : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} →ₐ[ℤ_[ℓ]] ℤ_[ℓ] :=
    MonoidAlgebra.lift ℤ_[ℓ] ℤ_[ℓ] PUnit.{u+1} 1
  have haug_single : ∀ a : ℤ_[ℓ], aug (MonoidAlgebra.single PUnit.unit a) = a := by
    intro a
    simp [aug, MonoidAlgebra.lift_single]
  have haug_eq : ∀ c : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1},
      c = MonoidAlgebra.single PUnit.unit (aug c) := by
    intro c
    induction c using MonoidAlgebra.induction_linear with
    | zero => simp
    | add f g hf hg => rw [map_add, MonoidAlgebra.single_add, ← hf, ← hg]
    | single a b => rw [haug_single]
  have haug_inj : Function.Injective aug := fun c c' h => by
    rw [haug_eq c, haug_eq c', h]
  haveI : IsDomain (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) := Function.Injective.isDomain aug haug_inj
  haveI : IsPrincipalIdealRing (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) :=
    IsPrincipalIdealRing.of_surjective
      (MonoidAlgebra.singleOneRingHom (R := ℤ_[ℓ]) (M := PUnit.{u+1}))
      (fun c => ⟨aug c, (haug_eq c).symm⟩)
  have hℓ0 : (ℓ : ℤ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr (Fact.out : ℓ.Prime).ne_zero
  have hsc : ∀ c : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1},
      MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ]) * c = 0 → c = 0 := by
    intro c h
    have h2 := congrArg aug h
    rw [map_mul, haug_single, map_zero] at h2
    have h3 : aug c = 0 := (mul_eq_zero.mp h2).resolve_left hℓ0
    rw [haug_eq c, h3, MonoidAlgebra.single_zero]

  have htf : ∀ y : T.M, MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ]) • y = 0 → y = 0 := by
    intro y hy
    have hd0 : T.d0 y = 0 := by
      have h1 : MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ]) • T.d0 y = 0 := by
        rw [← LinearMap.map_smul, hy, map_zero]
      funext i
      exact hsc _ (congrFun h1 i)
    let g : P ⟶ I.cocomplex.X 0 := T.α0 y
    have hgc : g ≫ I.cocomplex.d 0 1 = 0 := by
      have h := T.hc0 y
      rw [hd0, map_zero] at h
      exact h
    let ι0 : L ⟶ I.cocomplex.X 0 := I.ι.f 0
    haveI hι0 : Mono ι0 := by
      show Mono (I.ι.f 0)
      infer_instance
    have hs : ι0 ≫ (lamI (MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ]))).f 0 =
        lamL (MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ])) ≫ ι0 :=
      hI.2.1 (MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ]))
    let t : P ⟶ L := I.exact₀.lift g hgc
    have ht : t ≫ ι0 = g := I.exact₀.lift_f g hgc
    have h0 : g ≫ (lamI (MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ]))).f 0 = 0 := by
      have h := T.hlin0 (MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ])) y
      rw [hy, map_zero] at h
      exact h.symm
    have h1 : (t ≫ lamL (MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ]))) ≫ ι0 =
        0 ≫ ι0 := by
      rw [Category.assoc, ← hs, ← Category.assoc, ht, Limits.zero_comp]
      exact h0
    have h2 : t ≫ lamL (MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ])) =
        0 ≫ lamL (MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ])) := by
      rw [(cancel_mono ι0).mp h1, Limits.zero_comp]
    haveI := hmono
    have ht0 : t = 0 := (cancel_mono (lamL (MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ])))).mp h2
    have hg0 : g = 0 := by
      rw [← ht, ht0, Limits.zero_comp]
    exact T.q0i y hd0 hg0

  have hind : ∀ (k : ℕ) (m : T.M),
      MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ]) ^ k • m = 0 → m = 0 := by
    intro k
    induction k with
    | zero => intro m h; rwa [pow_zero, one_smul] at h
    | succ k ih =>
      intro m h
      rw [pow_succ', mul_smul] at h
      exact ih m (htf _ h)
  haveI : Module.Finite (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) T.M := T.fin
  haveI : Module.IsTorsionFree (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) T.M := by
    rw [Module.isTorsionFree_iff_smul_eq_zero]
    intro r m hrm
    by_cases hr : r = 0
    · exact Or.inl hr
    right
    have ha : aug r ≠ 0 := fun h => hr (by rw [haug_eq r, h, MonoidAlgebra.single_zero])
    have hr' : r = MonoidAlgebra.single PUnit.unit ((PadicInt.unitCoeff ha : ℤ_[ℓ])) *
        MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ]) ^ (aug r).valuation := by
      rw [MonoidAlgebra.single_pow, MonoidAlgebra.single_mul_single,
        ← PadicInt.unitCoeff_spec ha]
      exact haug_eq r
    have hunit : IsUnit (MonoidAlgebra.single PUnit.unit
        ((PadicInt.unitCoeff ha : ℤ_[ℓ]))) := by
      refine isUnit_iff_exists_inv.mpr
        ⟨MonoidAlgebra.single PUnit.unit (((PadicInt.unitCoeff ha)⁻¹ : ℤ_[ℓ]ˣ) : ℤ_[ℓ]), ?_⟩
      rw [MonoidAlgebra.single_mul_single, Units.mul_inv (PadicInt.unitCoeff ha)]
      rfl
    rw [hr', mul_smul] at hrm
    exact hind _ m (hunit.smul_eq_zero.mp hrm)
  haveI : Module.Free (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) T.M :=
    Module.free_of_finite_type_torsion_free'
  exact Module.Projective.of_free

theorem wc_gmodel_linear_of_projective_head (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Γ : Type u) [Group Γ]
    (D : CochainComplex AddCommGrpCat.{u+1} ℕ) (lamD : MonoidAlgebra ℤ_[ℓ] Γ → (D ⟶ D))
    (hD : wcRingAct lamD) (Fr : D ⟶ D) (hFr : ∀ r, lamD r ≫ Fr = Fr ≫ lamD r)
    (T : wcThreeTermModel D lamD) (hT : Module.Projective (MonoidAlgebra ℤ_[ℓ] Γ) T.M) :
    ∃ (P : wcGModel ℓ Γ) (φ : wcGModelAb P ⟶ D), QuasiIso φ ∧
      (∀ r, wcGModelSmul P r ≫ φ = φ ≫ lamD r) ∧
      ∃ h : Homotopy (φ ≫ Fr) (wcGModelFrob P ≫ φ),
        ∀ r i j, (wcGModelSmul P r).f i ≫ h.hom i j = h.hom i j ≫ (lamD r).f j :=
by
  classical
  have s1 : ∀ {K L : CochainComplex AddCommGrpCat.{u+1} ℕ} (φ : K ⟶ L),
      (∀ (n : ℕ) (x : K.X n), (K.d n (n + 1)).hom x = 0 → ∀ y : L.X (n - 1),
        (φ.f n).hom x = (L.d (n - 1) n).hom y → ∃ x' : K.X (n - 1), (K.d (n - 1) n).hom x' = x) →
      (∀ (n : ℕ) (y : L.X n), (L.d n (n + 1)).hom y = 0 → ∃ x : K.X n,
        (K.d n (n + 1)).hom x = 0 ∧ ∃ w : L.X (n - 1), (L.d (n - 1) n).hom w = (φ.f n).hom x - y) →
      QuasiIso φ := by
    intro K L φ hinj hsurj
    rw [quasiIso_iff]
    intro n
    have hp : (ComplexShape.up ℕ).prev n = n - 1 := by
      rcases n with _ | m
      · exact CochainComplex.prev_nat_zero
      · exact CochainComplex.prev_nat_succ m
    have hn : (ComplexShape.up ℕ).next n = n + 1 := ComplexShape.next_eq' _ rfl
    rw [quasiIsoAt_iff' φ (n - 1) n (n + 1) hp hn, ShortComplex.quasiIso_iff]
    have hmono : Mono (ShortComplex.homologyMap
        ((HomologicalComplex.shortComplexFunctor' AddCommGrpCat (ComplexShape.up ℕ)
          (n - 1) n (n + 1)).map φ)) := by
      rw [ShortComplex.mono_homologyMap_iff_up_to_refinements]
      intro A x₂ hx₂ y₁ hxy
      have hx : ∀ a, (K.d n (n + 1)).hom (x₂ a) = 0 := fun a => by
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f a) hx₂
      have hy : ∀ a, (φ.f n).hom (x₂ a) = (L.d (n - 1) n).hom (y₁ a) := fun a => by
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f a) hxy
      choose g hg using fun a => hinj n (x₂ a) (hx a) (y₁ a) (hy a)
      refine ⟨AddCommGrpCat.of (FreeAbelianGroup A),
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift id), ?_,
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift g), ?_⟩
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro a
        exact ⟨FreeAbelianGroup.of a, by simp [FreeAbelianGroup.lift_apply_of]⟩
      · ext z
        change x₂.hom (FreeAbelianGroup.lift id (FreeAbelianGroup.of z)) =
          (K.d (n - 1) n).hom (FreeAbelianGroup.lift g (FreeAbelianGroup.of z))
        rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
        exact (hg z).symm
    have hepi : Epi (ShortComplex.homologyMap
        ((HomologicalComplex.shortComplexFunctor' AddCommGrpCat (ComplexShape.up ℕ)
          (n - 1) n (n + 1)).map φ)) := by
      rw [ShortComplex.epi_homologyMap_iff_up_to_refinements]
      intro A y₂ hy₂
      have hy : ∀ a, (L.d n (n + 1)).hom (y₂ a) = 0 := fun a => by
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f a) hy₂
      choose x hx w hw using fun a => hsurj n (y₂ a) (hy a)
      refine ⟨AddCommGrpCat.of (FreeAbelianGroup A),
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift id), ?_,
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift x), ?_,
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun a => -w a)), ?_⟩
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro a
        exact ⟨FreeAbelianGroup.of a, by simp [FreeAbelianGroup.lift_apply_of]⟩
      · ext z
        change (K.d n (n + 1)).hom (FreeAbelianGroup.lift x (FreeAbelianGroup.of z)) = 0
        rw [FreeAbelianGroup.lift_apply_of]
        exact hx z
      · ext z
        have e := hw z
        change y₂.hom (FreeAbelianGroup.lift id (FreeAbelianGroup.of z)) =
          (φ.f n).hom (FreeAbelianGroup.lift x (FreeAbelianGroup.of z)) +
          (L.d (n - 1) n).hom (FreeAbelianGroup.lift (fun a => -w a) (FreeAbelianGroup.of z))
        rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of,
          FreeAbelianGroup.lift_apply_of, map_neg]
        change _ = _ + -((L.d (n - 1) n).hom (w z))
        rw [e]
        have key : ∀ (G : Type (u+1)) [AddCommGroup G] (a b : G), b = a + -(a - b) :=
          fun G _ a b => by abel
        exact key _ _ _
    exact isIso_of_mono_of_epi _

  have lmul : ∀ (m : ℕ) (a b : (MonoidAlgebra ℤ_[ℓ] Γ)) (x : D.X m),
      ((lamD (a * b)).f m).hom x = ((lamD a).f m).hom (((lamD b).f m).hom x) := by
    intro m a b x
    rw [hD.2.2 a b, HomologicalComplex.comp_f]
    rfl
  have ladd : ∀ (m : ℕ) (a b : (MonoidAlgebra ℤ_[ℓ] Γ)) (x : D.X m),
      ((lamD (a + b)).f m).hom x = ((lamD a).f m).hom x + ((lamD b).f m).hom x := by
    intro m a b x
    rw [hD.2.1 a b, HomologicalComplex.add_f_apply]
    rfl
  have l0 : ∀ (m : ℕ) (x : D.X m), ((lamD 0).f m).hom x = 0 := by
    intro m x
    have h := ladd m 0 0 x
    rw [add_zero] at h
    exact left_eq_add.mp h |>.symm ▸ rfl
  have ld : ∀ (m m' : ℕ) (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (x : D.X m),
      (D.d m m').hom (((lamD r).f m).hom x) = ((lamD r).f m').hom ((D.d m m').hom x) := by
    intro m m' r x
    have h := congrArg (fun f => AddCommGrpCat.Hom.hom f x) ((lamD r).comm m m')
    exact h
  have Frl : ∀ (m : ℕ) (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (x : D.X m),
      (Fr.f m).hom (((lamD r).f m).hom x) = ((lamD r).f m).hom ((Fr.f m).hom x) := by
    intro m r x
    have h := congrArg (fun f => AddCommGrpCat.Hom.hom (HomologicalComplex.Hom.f f m) x) (hFr r)
    exact h
  have Frd : ∀ (m m' : ℕ) (x : D.X m),
      (D.d m m').hom ((Fr.f m).hom x) = (Fr.f m').hom ((D.d m m').hom x) := by
    intro m m' x
    have h := congrArg (fun f => AddCommGrpCat.Hom.hom f x) (Fr.comm m m')
    exact h
  have pdec : ∀ {n : ℕ} (p : Fin n → (MonoidAlgebra ℤ_[ℓ] Γ)), p = ∑ j, p j • Pi.single j (1 : (MonoidAlgebra ℤ_[ℓ] Γ)) := by
    intro n p
    conv_lhs => rw [← Finset.univ_sum_single p]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [← Pi.single_smul', smul_eq_mul, mul_one]
  have dec : ∀ {n : ℕ} (m : ℕ) (α : (Fin n → (MonoidAlgebra ℤ_[ℓ] Γ)) →+ D.X m),
      (∀ (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (p : Fin n → (MonoidAlgebra ℤ_[ℓ] Γ)), α (r • p) = ((lamD r).f m).hom (α p)) →
      ∀ p, α p = ∑ j, ((lamD (p j)).f m).hom (α (Pi.single j 1)) := by
    intro n m α hα p
    conv_lhs => rw [pdec p]
    rw [map_sum]
    exact Finset.sum_congr rfl (fun j _ => hα _ _)

  have mkH : ∀ {n : ℕ} (m : ℕ) (w : Fin n → D.X m), ∃ h : (Fin n → (MonoidAlgebra ℤ_[ℓ] Γ)) →+ D.X m,
      (∀ p, h p = ∑ j, ((lamD (p j)).f m).hom (w j)) ∧
      (∀ (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (p : Fin n → (MonoidAlgebra ℤ_[ℓ] Γ)), h (r • p) = ((lamD r).f m).hom (h p)) := by
    intro n m w
    refine ⟨{ toFun := fun p => ∑ j, ((lamD (p j)).f m).hom (w j)
              map_zero' := ?_
              map_add' := ?_ }, fun p => rfl, ?_⟩
    · simp only [Pi.zero_apply]
      exact Finset.sum_eq_zero (fun j _ => l0 m _)
    · intro p q
      simp only [Pi.add_apply]
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun j _ => ladd m _ _ _)
    · intro r p
      simp only [AddMonoidHom.coe_mk, ZeroHom.coe_mk, Pi.smul_apply, smul_eq_mul]
      rw [map_sum]
      exact Finset.sum_congr rfl (fun j _ => lmul m _ _ _)

  obtain ⟨F2, h2, hh2, hH2⟩ : ∃ (F2 : (Fin T.b → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)] (Fin T.b → (MonoidAlgebra ℤ_[ℓ] Γ))) (h2 : (Fin T.b → (MonoidAlgebra ℤ_[ℓ] Γ)) →+ D.X 1),
      (∀ (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (p : Fin T.b → (MonoidAlgebra ℤ_[ℓ] Γ)), h2 (r • p) = ((lamD r).f 1).hom (h2 p)) ∧
      ∀ p, T.α2 (F2 p) = (Fr.f 2).hom (T.α2 p) + (D.d 1 2).hom (h2 p) := by
    have cyc : ∀ j : Fin T.b, (D.d 2 3).hom ((Fr.f 2).hom (T.α2 (Pi.single j 1))) = 0 := by
      intro j
      rw [Frd, T.hc2, map_zero]
    choose P w hw using fun j => T.q2s _ (cyc j)
    obtain ⟨h2, hh2e, hh2⟩ := mkH 1 w
    refine ⟨Fintype.linearCombination (MonoidAlgebra ℤ_[ℓ] Γ) P, h2, hh2, fun p => ?_⟩
    rw [Fintype.linearCombination_apply, map_sum, dec 2 T.α2 T.hlin2 p, map_sum, hh2e, map_sum,
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [T.hlin2, Frl, ld, ← map_add, hw j, add_sub_cancel]


  obtain ⟨F1, h1, hh1, hC1, hH1⟩ : ∃ (F1 : (Fin T.a → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)] (Fin T.a → (MonoidAlgebra ℤ_[ℓ] Γ)))
      (h1 : (Fin T.a → (MonoidAlgebra ℤ_[ℓ] Γ)) →+ D.X 0),
      (∀ (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (p : Fin T.a → (MonoidAlgebra ℤ_[ℓ] Γ)), h1 (r • p) = ((lamD r).f 0).hom (h1 p)) ∧
      (∀ p, T.d1 (F1 p) = F2 (T.d1 p)) ∧
      ∀ p, T.α1 (F1 p) = (Fr.f 1).hom (T.α1 p) + h2 (T.d1 p) + (D.d 0 1).hom (h1 p) := by
    have hz : ∀ i : Fin T.a, (D.d 1 2).hom ((Fr.f 1).hom (T.α1 (Pi.single i 1)) +
        h2 (T.d1 (Pi.single i 1))) = T.α2 (F2 (T.d1 (Pi.single i 1))) := by
      intro i
      rw [map_add, Frd, T.hc1, hH2]
      try abel
    choose u hu using fun i => T.q2i _ ⟨_, hz i⟩
    have hy : ∀ i : Fin T.a, (D.d 1 2).hom (T.α1 (u i) - ((Fr.f 1).hom (T.α1 (Pi.single i 1)) +
        h2 (T.d1 (Pi.single i 1)))) = 0 := by
      intro i
      rw [map_sub, hz, T.hc1, hu, sub_self]
    choose c hc w hw using fun i => T.q1s _ (hy i)
    obtain ⟨h1, hh1e, hh1⟩ := mkH 0 (fun i => -w i)
    have hPd : ∀ i, T.d1 (u i - c i) = F2 (T.d1 (Pi.single i 1)) := by
      intro i; rw [map_sub, hu, hc, sub_zero]
    have hPa : ∀ i, T.α1 (u i - c i) = (Fr.f 1).hom (T.α1 (Pi.single i 1)) +
        h2 (T.d1 (Pi.single i 1)) + (D.d 0 1).hom (-w i) := by
      intro i
      rw [map_neg, hw, map_sub]
      abel
    have hdl : ∀ p : Fin T.a → (MonoidAlgebra ℤ_[ℓ] Γ), T.d1 p = ∑ i, p i • T.d1 (Pi.single i 1) := by
      intro p
      conv_lhs => rw [pdec p]
      rw [map_sum]
      exact Finset.sum_congr rfl (fun i _ => map_smul _ _ _)
    refine ⟨Fintype.linearCombination (MonoidAlgebra ℤ_[ℓ] Γ) (fun i => u i - c i), h1, hh1, fun p => ?_, fun p => ?_⟩
    · rw [Fintype.linearCombination_apply, map_sum, hdl p, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_smul, map_smul, hPd]
    · have hsl : ∀ (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (q : Fin T.a → (MonoidAlgebra ℤ_[ℓ] Γ)), (h2.comp T.d1.toAddMonoidHom) (r • q) =
          ((lamD r).f 1).hom ((h2.comp T.d1.toAddMonoidHom) q) := by
        intro r q
        simp only [AddMonoidHom.coe_comp, Function.comp_apply, LinearMap.toAddMonoidHom_coe,
          map_smul]
        exact hh2 r _
      have e2 := dec 1 (h2.comp T.d1.toAddMonoidHom) hsl p
      simp only [AddMonoidHom.coe_comp, Function.comp_apply, LinearMap.toAddMonoidHom_coe] at e2
      rw [Fintype.linearCombination_apply, map_sum, dec 1 T.α1 T.hlin1 p, e2, hh1e, map_sum,
        map_sum, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [T.hlin1, hPa, map_add, map_add, Frl, ld]


  haveI := T.fin
  obtain ⟨k, π, hπ⟩ := Module.Finite.exists_fin' (MonoidAlgebra ℤ_[ℓ] Γ) T.M
  obtain ⟨sec, hsec⟩ := Module.projective_lifting_property π LinearMap.id hπ
  have hπs : ∀ x, π (sec x) = x := fun x => congrArg (fun f => f x) hsec

  obtain ⟨FM, hC0, hH0⟩ : ∃ FM : T.M →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)] T.M,
      (∀ x, T.d0 (FM x) = F1 (T.d0 x)) ∧
      ∀ x, T.α0 (FM x) = (Fr.f 0).hom (T.α0 x) + h1 (T.d0 x) := by
    have hz : ∀ j : Fin k, (D.d 0 1).hom ((Fr.f 0).hom (T.α0 (π (Pi.single j 1))) +
        h1 (T.d0 (π (Pi.single j 1)))) = T.α1 (F1 (T.d0 (π (Pi.single j 1)))) := by
      intro j
      rw [map_add, Frd, T.hc0, hH1, T.hdd, map_zero]
      abel
    have hzz : ∀ j : Fin k, T.d1 (F1 (T.d0 (π (Pi.single j 1)))) = 0 := by
      intro j; rw [hC1, T.hdd, map_zero]
    choose x' hx' using fun j => T.q1i _ (hzz j) ⟨_, hz j⟩
    have hy : ∀ j : Fin k, (D.d 0 1).hom (T.α0 (x' j) - ((Fr.f 0).hom (T.α0 (π (Pi.single j 1))) +
        h1 (T.d0 (π (Pi.single j 1))))) = 0 := by
      intro j
      rw [map_sub, hz, T.hc0, hx', sub_self]
    choose c hc hca using fun j => T.q0s _ (hy j)
    have hXd : ∀ j, T.d0 (x' j - c j) = F1 (T.d0 (π (Pi.single j 1))) := by
      intro j; rw [map_sub, hx', hc, sub_zero]
    have hXa : ∀ j, T.α0 (x' j - c j) = (Fr.f 0).hom (T.α0 (π (Pi.single j 1))) +
        h1 (T.d0 (π (Pi.single j 1))) := by
      intro j; rw [map_sub, hca, sub_sub_cancel]
    refine ⟨(Fintype.linearCombination (MonoidAlgebra ℤ_[ℓ] Γ) (fun j => x' j - c j)) ∘ₗ sec, fun x => ?_, fun x => ?_⟩
    · rw [LinearMap.comp_apply, Fintype.linearCombination_apply, map_sum]
      conv_rhs => rw [← hπs x, pdec (sec x), map_sum, map_sum, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_smul, map_smul, map_smul, map_smul, hXd]
    · rw [LinearMap.comp_apply, Fintype.linearCombination_apply, map_sum]
      have ea : T.α0 x = ∑ j, ((lamD (sec x j)).f 0).hom (T.α0 (π (Pi.single j 1))) := by
        conv_lhs => rw [← hπs x, pdec (sec x), map_sum, map_sum]
        exact Finset.sum_congr rfl (fun j _ => by rw [map_smul, T.hlin0])
      have eh : h1 (T.d0 x) = ∑ j, ((lamD (sec x j)).f 0).hom (h1 (T.d0 (π (Pi.single j 1)))) := by
        conv_lhs => rw [← hπs x, pdec (sec x), map_sum, map_sum, map_sum]
        exact Finset.sum_congr rfl (fun j _ => by rw [map_smul, map_smul, hh1])
      rw [ea, eh, map_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [T.hlin0, hXa, map_add, Frl]

  have hmat : ∀ {m n : ℕ} (g : (Fin m → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)] (Fin n → (MonoidAlgebra ℤ_[ℓ] Γ))) (v : Fin m → (MonoidAlgebra ℤ_[ℓ] Γ)),
      Matrix.vecMul v (LinearMap.toMatrixRight' g) = g v := by
    intro m n g v
    rw [← Matrix.toLinearMapRight'_apply]
    show LinearMap.toMatrixRight'.symm (LinearMap.toMatrixRight' g) v = g v
    rw [LinearEquiv.symm_apply_apply]
  have hcomp : ∀ {l m n : ℕ} (f : (Fin l → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)] (Fin m → (MonoidAlgebra ℤ_[ℓ] Γ)))
      (g : (Fin m → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)] (Fin n → (MonoidAlgebra ℤ_[ℓ] Γ))) (h : (Fin l → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)] (Fin n → (MonoidAlgebra ℤ_[ℓ] Γ))),
      (∀ v, g (f v) = h v) →
      LinearMap.toMatrixRight' f * LinearMap.toMatrixRight' g = LinearMap.toMatrixRight' h := by
    intro l m n f g h hfg
    rw [← LinearMap.toMatrixRight'_comp]
    congr 1
    exact LinearMap.ext hfg
  let kf : ℕ → ℕ := fun i => match i with
    | 0 => k | 1 => T.a | 2 => T.b | _ + 3 => 0
  let E0 := LinearMap.toMatrixRight' (sec ∘ₗ π)
  let D0 := LinearMap.toMatrixRight' (T.d0 ∘ₗ π)
  let D1 := LinearMap.toMatrixRight' T.d1
  let G0 := LinearMap.toMatrixRight' (sec ∘ₗ FM ∘ₗ π)
  let G1 := LinearMap.toMatrixRight' F1
  let G2 := LinearMap.toMatrixRight' F2
  let εf : ∀ i, Matrix (Fin (kf i)) (Fin (kf i)) (MonoidAlgebra ℤ_[ℓ] Γ) := fun i => match i with
    | 0 => E0 | 1 => 1 | 2 => 1 | _ + 3 => 1
  let δf : ∀ i, Matrix (Fin (kf i)) (Fin (kf (i + 1))) (MonoidAlgebra ℤ_[ℓ] Γ) := fun i => match i with
    | 0 => D0 | 1 => D1 | 2 => 0 | _ + 3 => 0
  let ff : ∀ i, Matrix (Fin (kf i)) (Fin (kf i)) (MonoidAlgebra ℤ_[ℓ] Γ) := fun i => match i with
    | 0 => G0 | 1 => G1 | 2 => G2 | _ + 3 => 0
  have hE0 : E0 * E0 = E0 := hcomp _ _ _ (fun v => by simp [hπs])
  have hE0D : E0 * D0 = D0 := hcomp _ _ _ (fun v => by simp [hπs])
  have hDD : D0 * D1 = 0 := by
    rw [hcomp _ _ (0 : (Fin k → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)] (Fin T.b → (MonoidAlgebra ℤ_[ℓ] Γ))) (fun v => by simp [T.hdd]), map_zero]
  have hEG : E0 * G0 = G0 := hcomp _ _ _ (fun v => by simp [hπs])
  have hGE : G0 * E0 = G0 := hcomp _ _ _ (fun v => by simp [hπs])
  have hDG : D0 * G1 = G0 * D0 := by
    rw [hcomp _ _ (F1 ∘ₗ T.d0 ∘ₗ π) (fun v => rfl), hcomp _ _ (F1 ∘ₗ T.d0 ∘ₗ π)
      (fun v => by simp [hπs, hC0])]
  have hDG1 : D1 * G2 = G1 * D1 := by
    rw [hcomp _ _ (F2 ∘ₗ T.d1) (fun v => rfl), hcomp _ _ (F2 ∘ₗ T.d1) (fun v => by simp [hC1])]
  let P : wcGModel ℓ Γ :=
    { k := kf
      hk := fun i hi => by
        obtain ⟨n, rfl⟩ : ∃ n, i = n + 3 := ⟨i - 3, by omega⟩
        rfl
      ε := εf
      hε := fun i => match i with
        | 0 => hE0 | 1 => Matrix.mul_one _ | 2 => Matrix.mul_one _ | _ + 3 => Matrix.mul_one _
      δ := δf
      hδδ := fun i => match i with
        | 0 => hDD | 1 => Matrix.mul_zero _ | 2 => Matrix.zero_mul _ | _ + 3 => Matrix.zero_mul _
      hεδ := fun i => match i with
        | 0 => hE0D | 1 => Matrix.one_mul _ | 2 => Matrix.one_mul _ | _ + 3 => Matrix.one_mul _
      hδε := fun i => match i with
        | 0 => Matrix.mul_one _ | 1 => Matrix.mul_one _ | 2 => Matrix.zero_mul _
        | _ + 3 => Matrix.zero_mul _
      f := ff
      hεf := fun i => match i with
        | 0 => hEG | 1 => Matrix.one_mul _ | 2 => Matrix.one_mul _ | _ + 3 => Matrix.one_mul _
      hfε := fun i => match i with
        | 0 => hGE | 1 => Matrix.mul_one _ | 2 => Matrix.mul_one _ | _ + 3 => Matrix.mul_one _
      hδf := fun i => match i with
        | 0 => hDG | 1 => hDG1 | 2 => (Matrix.zero_mul _).trans (Matrix.mul_zero _).symm
        | _ + 3 => (Matrix.zero_mul _).trans (Matrix.mul_zero _).symm }


  have hKd : ∀ i, (wcGModelAb P).d i (i + 1) =
      AddCommGrpCat.ofHom (wcULiftHom (wcVecMulHom (P.ε i) (P.ε (i + 1)) (P.δ i) (P.hδε i))) := by
    intro i
    dsimp only [wcGModelAb]
    exact CochainComplex.of_d _ _ i
  have hsub : ∀ (n : ℕ) (x : (wcGModelAb P).X (n + 3)), x = 0 := by
    intro n x
    exact ULift.ext _ _ (Subtype.ext (funext fun i => Fin.elim0 i))
  let φf : ∀ i, (wcGModelAb P).X i ⟶ D.X i := fun i => match i with
    | 0 => AddCommGrpCat.ofHom ((T.α0.comp π.toAddMonoidHom).comp
        ((wcIdemSub E0).subtype.comp AddEquiv.ulift.toAddMonoidHom))
    | 1 => AddCommGrpCat.ofHom (T.α1.comp
        ((wcIdemSub (1 : Matrix (Fin T.a) (Fin T.a) (MonoidAlgebra ℤ_[ℓ] Γ))).subtype.comp
          AddEquiv.ulift.toAddMonoidHom))
    | 2 => AddCommGrpCat.ofHom (T.α2.comp
        ((wcIdemSub (1 : Matrix (Fin T.b) (Fin T.b) (MonoidAlgebra ℤ_[ℓ] Γ))).subtype.comp
          AddEquiv.ulift.toAddMonoidHom))
    | _ + 3 => 0
  let φ : wcGModelAb P ⟶ D := HomologicalComplex.Hom.mk φf (by
    rintro i j (rfl : i + 1 = j)
    rw [hKd i]
    match i with
    | 0 =>
      ext x
      show (D.d 0 1).hom (T.α0 (π x.down.1)) =
        T.α1 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' (T.d0 ∘ₗ π)))
      rw [hmat]
      exact T.hc0 _
    | 1 =>
      ext x
      show (D.d 1 2).hom (T.α1 x.down.1) =
        T.α2 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' T.d1))
      rw [hmat]
      exact T.hc1 _
    | 2 =>
      ext x
      show (D.d 2 3).hom (T.α2 x.down.1) = 0
      exact T.hc2 _
    | n + 3 =>
      ext x
      rw [hsub n x]
      simp only [map_zero])
  have hinj : ∀ (n : ℕ) (x : (wcGModelAb P).X n), ((wcGModelAb P).d n (n + 1)).hom x = 0 →
      ∀ y : D.X (n - 1), (φ.f n).hom x = (D.d (n - 1) n).hom y →
      ∃ x' : (wcGModelAb P).X (n - 1), ((wcGModelAb P).d (n - 1) n).hom x' = x := by
    intro n
    match n with
    | 0 =>
      intro x hx y hxy
      rw [hKd] at hx
      have h2 : T.d0 (π x.down.1) = 0 :=
        (hmat (T.d0 ∘ₗ π) x.down.1).symm.trans (congrArg (fun z => (ULift.down z).1) hx)
      rw [D.shape (0 - 1) 0 (by decide)] at hxy
      have ha : T.α0 (π x.down.1) = 0 := hxy
      have hπ0 : π x.down.1 = 0 := T.q0i _ h2 ha
      have hv : x.down.1 = 0 := by
        have hm : Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' (sec ∘ₗ π)) = x.down.1 :=
          x.down.2
        rw [hmat, LinearMap.comp_apply, hπ0, map_zero] at hm
        exact hm.symm
      refine ⟨0, ?_⟩
      rw [map_zero]
      exact (ULift.ext _ _ (Subtype.ext hv)).symm
    | 1 =>
      intro x hx y hxy
      rw [hKd] at hx
      have hd : T.d1 x.down.1 = 0 :=
        (hmat T.d1 x.down.1).symm.trans (congrArg (fun z => (ULift.down z).1) hx)
      have hxy' : (D.d 0 1).hom y = T.α1 x.down.1 := hxy.symm
      obtain ⟨m, hm⟩ := T.q1i _ hd ⟨y, hxy'⟩
      have hmem : Matrix.vecMul (sec m) (LinearMap.toMatrixRight' (sec ∘ₗ π)) = sec m := by
        rw [hmat, LinearMap.comp_apply, hπs]
      refine ⟨ULift.up ⟨sec m, hmem⟩, ?_⟩
      show ((wcGModelAb P).d 0 (0 + 1)).hom _ = x
      rw [hKd]
      apply ULift.ext
      apply Subtype.ext
      show Matrix.vecMul (sec m) (LinearMap.toMatrixRight' (T.d0 ∘ₗ π)) = x.down.1
      rw [hmat, LinearMap.comp_apply, hπs, hm]
    | 2 =>
      intro x hx y hxy
      have hxy' : (D.d 1 2).hom y = T.α2 x.down.1 := hxy.symm
      obtain ⟨p', hp'⟩ := T.q2i _ ⟨y, hxy'⟩
      refine ⟨ULift.up ⟨p', Matrix.vecMul_one p'⟩, ?_⟩
      show ((wcGModelAb P).d 1 (1 + 1)).hom _ = x
      rw [hKd]
      apply ULift.ext
      apply Subtype.ext
      show Matrix.vecMul p' (LinearMap.toMatrixRight' T.d1) = x.down.1
      rw [hmat, hp']
    | n + 3 =>
      intro x hx y hxy
      refine ⟨0, ?_⟩
      rw [map_zero]
      exact (hsub n x).symm
  have hsurj : ∀ (n : ℕ) (y : D.X n), (D.d n (n + 1)).hom y = 0 →
      ∃ x : (wcGModelAb P).X n, ((wcGModelAb P).d n (n + 1)).hom x = 0 ∧
      ∃ w : D.X (n - 1), (D.d (n - 1) n).hom w = (φ.f n).hom x - y := by
    intro n
    match n with
    | 0 =>
      intro y hy
      obtain ⟨m, hm0, hma⟩ := T.q0s y hy
      have hmem : Matrix.vecMul (sec m) (LinearMap.toMatrixRight' (sec ∘ₗ π)) = sec m := by
        rw [hmat, LinearMap.comp_apply, hπs]
      refine ⟨ULift.up ⟨sec m, hmem⟩, ?_, 0, ?_⟩
      · rw [hKd]
        apply ULift.ext
        apply Subtype.ext
        show Matrix.vecMul (sec m) (LinearMap.toMatrixRight' (T.d0 ∘ₗ π)) = 0
        rw [hmat, LinearMap.comp_apply, hπs, hm0]
      · rw [map_zero]
        show (0 : D.X 0) = T.α0 (π (sec m)) - y
        rw [hπs, hma, sub_self]
    | 1 =>
      intro y hy
      obtain ⟨p, hp, w, hw⟩ := T.q1s y hy
      refine ⟨ULift.up ⟨p, Matrix.vecMul_one p⟩, ?_, w, hw⟩
      rw [hKd]
      apply ULift.ext
      apply Subtype.ext
      show Matrix.vecMul p (LinearMap.toMatrixRight' T.d1) = 0
      rw [hmat, hp]
    | 2 =>
      intro y hy
      obtain ⟨p, w, hw⟩ := T.q2s y hy
      exact ⟨ULift.up ⟨p, Matrix.vecMul_one p⟩, hsub 0 _, w, hw⟩
    | n + 3 =>
      intro y hy
      obtain ⟨w, hw⟩ := T.qhi (n + 3) (by omega) y hy
      refine ⟨0, map_zero _, -w, ?_⟩
      rw [map_neg, hw, map_zero, zero_sub]

  have hlinφ : ∀ r : MonoidAlgebra ℤ_[ℓ] Γ, wcGModelSmul P r ≫ φ = φ ≫ lamD r := by
    intro r
    apply HomologicalComplex.hom_ext
    intro i
    rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f]
    match i with
    | 0 =>
      ext x
      show T.α0 (π (r • x.down.1)) = ((lamD r).f 0).hom (T.α0 (π x.down.1))
      rw [map_smul, T.hlin0]
    | 1 =>
      ext x
      show T.α1 (r • x.down.1) = ((lamD r).f 1).hom (T.α1 x.down.1)
      exact T.hlin1 _ _
    | 2 =>
      ext x
      show T.α2 (r • x.down.1) = ((lamD r).f 2).hom (T.α2 x.down.1)
      exact T.hlin2 _ _
    | n + 3 =>
      ext x
      rw [hsub n x, map_zero, map_zero]
  let hom : ∀ i j, (wcGModelAb P).X i ⟶ D.X j := fun i j => match i, j with
    | 1, 0 => AddCommGrpCat.ofHom (h1.comp
        ((wcIdemSub (1 : Matrix (Fin T.a) (Fin T.a) (MonoidAlgebra ℤ_[ℓ] Γ))).subtype.comp
          AddEquiv.ulift.toAddMonoidHom))
    | 2, 1 => AddCommGrpCat.ofHom (h2.comp
        ((wcIdemSub (1 : Matrix (Fin T.b) (Fin T.b) (MonoidAlgebra ℤ_[ℓ] Γ))).subtype.comp
          AddEquiv.ulift.toAddMonoidHom))
    | _, _ => 0

  have hhom : ∀ (r : MonoidAlgebra ℤ_[ℓ] Γ) (i j : ℕ),
      (wcGModelSmul P r).f i ≫ hom i j = hom i j ≫ (lamD r).f j := by
    intro r i j
    have z : ∀ i j, hom i j = 0 →
        (wcGModelSmul P r).f i ≫ hom i j = hom i j ≫ (lamD r).f j := by
      intro i j h
      rw [h, Limits.comp_zero, Limits.zero_comp]
    match i, j with
    | 0, _ => exact z _ _ rfl
    | 1, 0 =>
      ext x
      show h1 (r • x.down.1) = ((lamD r).f 0).hom (h1 x.down.1)
      exact hh1 r _
    | 1, _ + 1 => exact z _ _ rfl
    | 2, 0 => exact z _ _ rfl
    | 2, 1 =>
      ext x
      show h2 (r • x.down.1) = ((lamD r).f 1).hom (h2 x.down.1)
      exact hh2 r _
    | 2, _ + 2 => exact z _ _ rfl
    | _ + 3, _ => exact z _ _ rfl
  let htpy : Homotopy (wcGModelFrob P ≫ φ) (φ ≫ Fr) :=
    { hom := hom
      zero := by
        intro i j hij
        match i, j with
        | 0, _ => rfl
        | 1, 0 => exact absurd rfl hij
        | 1, _ + 1 => rfl
        | 2, 0 => rfl
        | 2, 1 => exact absurd rfl hij
        | 2, _ + 2 => rfl
        | _ + 3, _ => rfl
      comm := by
        intro i
        match i with
        | 0 =>
          rw [Homotopy.dNext_cochainComplex, Homotopy.prevD_zero_cochainComplex, hKd]
          ext x
          show T.α0 (π (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' (sec ∘ₗ FM ∘ₗ π)))) =
            h1 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' (T.d0 ∘ₗ π))) + 0 +
              (Fr.f 0).hom (T.α0 (π x.down.1))
          rw [hmat, hmat, LinearMap.comp_apply, LinearMap.comp_apply, LinearMap.comp_apply, hπs,
            hH0, add_zero, add_comm]
        | 1 =>
          rw [Homotopy.dNext_cochainComplex, hKd,
            show prevD 1 hom = hom 1 0 ≫ D.d 0 1 from Homotopy.prevD_succ_cochainComplex hom 0]
          ext x
          show T.α1 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' F1)) =
            h2 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' T.d1)) +
              (D.d 0 1).hom (h1 x.down.1) + (Fr.f 1).hom (T.α1 x.down.1)
          rw [hmat, hmat, hH1]
          abel
        | 2 =>
          rw [Homotopy.dNext_cochainComplex, hKd,
            show prevD 2 hom = hom 2 1 ≫ D.d 1 2 from Homotopy.prevD_succ_cochainComplex hom 1]
          ext x
          show T.α2 (Matrix.vecMul x.down.1 (LinearMap.toMatrixRight' F2)) =
            0 + (D.d 1 2).hom (h2 x.down.1) + (Fr.f 2).hom (T.α2 x.down.1)
          rw [hmat, hH2]
          abel
        | n + 3 =>
          ext x
          rw [hsub n x, map_zero, map_zero] }
  refine ⟨P, φ, s1 φ hinj hsurj, hlinφ, htpy.symm, fun r i j => ?_⟩
  have e : htpy.symm.hom i j = -hom i j := Homotopy.symm_hom htpy i j
  rw [e, Preadditive.comp_neg, Preadditive.neg_comp]
  exact congrArg Neg.neg (hhom r i j)

theorem wcU_bk_trunc_interface (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (L : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (I : InjectiveResolution L) (N : ℕ) (hN : 1 ≤ N) (hLN : Mono (N • 𝟙 L)) :
    (∀ k (b : (wcCxJ K hP I.cocomplex).X k), ∃ b', N • b' = b) ∧
    ∃ θ : ∀ k, (wcCxJ K hP I.cocomplex).X (k + 1) →
        (wcCxJ K hP (wcTruncKerRes I.cocomplex N)).X k,
      (∀ k c c', N • c = 0 → N • c' = 0 → θ k (c + c') = θ k c + θ k c') ∧
      (∀ k c, N • c = 0 → ((wcCxJ K hP (wcTruncKerRes I.cocomplex N)).d k (k + 1)).hom (θ k c) =
          θ (k + 1) (((wcCxJ K hP I.cocomplex).d (k + 1) (k + 2)).hom c)) ∧
      (∀ k (x : (wcCxJ K hP (wcTruncKerRes I.cocomplex N)).X k), ∃ c, N • c = 0 ∧ θ k c = x) ∧
      (∀ k c, N • c = 0 → θ (k + 1) c = 0 → c = 0) ∧
      (∀ c, N • c = 0 → θ 0 c = 0 → ∃ y : (wcCxJ K hP I.cocomplex).X 0, N • y = 0 ∧
          ((wcCxJ K hP I.cocomplex).d 0 1).hom y = c) ∧
      (∀ y : (wcCxJ K hP I.cocomplex).X 0, N • y = 0 →
          θ 0 (((wcCxJ K hP I.cocomplex).d 0 1).hom y) = 0) ∧
      (∀ k c, N • c = 0 → ((wcCxJFrob K hP (wcTruncKerRes I.cocomplex N)).f k).hom (θ k c) =
          θ k (((wcCxJFrob K hP I.cocomplex).f (k + 1)).hom c)) :=
by
  classical
  have hN0 : 0 < N := by omega
  have hcomm : ∀ {A B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (f : A ⟶ B), f ≫ (N • 𝟙 B) = (N • 𝟙 A) ≫ f := by
    intro A B f
    rw [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
  have htor : ∀ {A B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (f : A ⟶ B), N • f = 0 ↔ f ≫ (N • 𝟙 B) = 0 := by
    intro A B f
    rw [Preadditive.comp_nsmul, Category.comp_id]
  have hfree : ∀ (n : ℕ), 0 < n → Mono (n • 𝟙 ((presheafToSheaf
      (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}).obj
      (yoneda.obj (wcGeomPoint K (wcP1Over K) hP) ⋙ uliftFunctor.{u+1, u} ⋙
        AddCommGrpCat.free))) := by
    intro n hn
    have tf : ∀ (X : Type (u+1)) (a b : FreeAbelianGroup X), n • a = n • b → a = b := by
      intro X a b hab
      apply (FreeAbelianGroup.equivFinsupp X).injective
      ext x
      have hx := congrArg (fun z => FreeAbelianGroup.equivFinsupp X z x) hab
      simp only [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul] at hx
      exact Int.eq_of_mul_eq_mul_left (by exact_mod_cast hn.ne') hx
    have hmono : Mono (n • 𝟙 (yoneda.obj (wcGeomPoint K (wcP1Over K) hP) ⋙
        uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)) := by
      have : ∀ V, Mono ((n • 𝟙 (yoneda.obj (wcGeomPoint K (wcP1Over K) hP) ⋙
          uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app V) := by
        intro V
        rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.mono_iff_injective]
        intro a b hab
        simp only [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddMonoidHom.nsmul_apply,
          AddMonoidHom.id_apply] at hab
        exact tf _ a b hab
      exact NatTrans.mono_of_mono_app _
    have := Functor.map_mono (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
      AddCommGrpCat.{u+1})
      (n • 𝟙 (yoneda.obj (wcGeomPoint K (wcP1Over K) hP) ⋙ uliftFunctor.{u+1, u} ⋙
        AddCommGrpCat.free))
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id] at this
    exact this
  haveI hPm : Mono (N • 𝟙 (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))) :=
    hfree N hN0

  have hdiv : ∀ k (b : wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) ⟶
      I.cocomplex.X k), ∃ b' : wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) ⟶
      I.cocomplex.X k, N • b' = b := by
    intro k b
    haveI := I.injective k
    refine ⟨Injective.factorThru b
      (N • 𝟙 (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))), ?_⟩
    calc N • Injective.factorThru b
          (N • 𝟙 (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)))
        = (N • 𝟙 (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))) ≫
            Injective.factorThru b
              (N • 𝟙 (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))) := by
          rw [Preadditive.nsmul_comp, Category.id_comp]
      _ = b := Injective.comp_factorThru _ _

  let ι : ∀ k, Limits.kernel (N • 𝟙 (I.cocomplex.X k)) ⟶ I.cocomplex.X k :=
    fun k => Limits.kernel.ι (N • 𝟙 (I.cocomplex.X k))
  have hιn : ∀ k, ι k ≫ (N • 𝟙 (I.cocomplex.X k)) = 0 := fun k => Limits.kernel.condition _
  let D : ∀ k, Limits.kernel (N • 𝟙 (I.cocomplex.X k)) ⟶
      Limits.kernel (N • 𝟙 (I.cocomplex.X (k + 1))) := fun k => wcTruncKerD I.cocomplex N k
  have hDι : ∀ k, D k ≫ ι (k + 1) = ι k ≫ I.cocomplex.d k (k + 1) := fun k => by
    simp [D, ι, wcTruncKerD, Limits.kernel.map]
  have hDι0 : D 0 ≫ ι 1 = ι 0 ≫ I.cocomplex.d 0 1 := hDι 0
  let p : Limits.kernel (N • 𝟙 (I.cocomplex.X 1)) ⟶ Limits.cokernel (D 0) :=
    Limits.cokernel.π (D 0)
  have hDp : D 0 ≫ p = 0 := Limits.cokernel.condition _
  have hJd0 : (wcTruncKerRes I.cocomplex N).d 0 1 = wcTruncKerDiff I.cocomplex N 0 :=
    CochainComplex.of_d (wcTruncKerX I.cocomplex N) (wcTruncKerDiff I.cocomplex N) 0
  have hJdS : ∀ k, (wcTruncKerRes I.cocomplex N).d (k + 1) (k + 2) = D (k + 2) := fun k =>
    CochainComplex.of_d _ _ (k + 1)
  have hpδ : p ≫ ((wcTruncKerRes I.cocomplex N).d 0 1 :
      Limits.cokernel (D 0) ⟶ Limits.kernel (N • 𝟙 (I.cocomplex.X 2))) = D 1 := by
    rw [hJd0]
    exact Limits.cokernel.π_desc _ _ _

  let i0 : L ⟶ I.cocomplex.X 0 :=
    (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 L).inv ≫ I.ι.f 0
  haveI : Mono i0 := mono_comp _ _
  have hi0comm : i0 ≫ (N • 𝟙 (I.cocomplex.X 0)) = (N • 𝟙 L) ≫ i0 := hcomm i0
  have hY0 : ∀ {A : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (y : A ⟶ I.cocomplex.X 0), y ≫ I.cocomplex.d 0 1 = 0 → ∃ x : A ⟶ L, x ≫ i0 = y := by
    intro A y hy
    refine ⟨I.exact₀.lift y hy ≫
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 L).hom, ?_⟩
    simp only [i0, Category.assoc, Iso.hom_inv_id_assoc]
    exact I.exact₀.lift_f y hy

  haveI hD0 : Mono (D 0) := by
    apply Preadditive.mono_of_cancel_zero
    intro A g hg
    have h1 : (g ≫ ι 0) ≫ I.cocomplex.d 0 1 = 0 := by
      rw [Category.assoc, ← hDι0, ← Category.assoc, hg, Limits.zero_comp]
    obtain ⟨x, hx⟩ := hY0 _ h1
    have h2 : (x ≫ (N • 𝟙 L)) ≫ i0 = 0 := by
      rw [Category.assoc, ← hi0comm, ← Category.assoc, hx, Category.assoc, hιn, Limits.comp_zero]
    have h3 : x ≫ (N • 𝟙 L) = 0 := (cancel_mono i0).mp (by rw [h2, Limits.zero_comp])
    have h4 : x = 0 := (cancel_mono (N • 𝟙 L)).mp (by rw [h3, Limits.zero_comp])
    rw [← cancel_mono (ι 0), Limits.zero_comp, ← hx, h4, Limits.zero_comp]
  have hTk : ∀ k, N • 𝟙 (Limits.kernel (N • 𝟙 (I.cocomplex.X k))) = 0 := by
    intro k
    rw [← cancel_mono (ι k), Limits.zero_comp, ← hcomm]
    exact hιn k

  haveI := I.injective 0
  have hψ0 : Injective.factorThru (ι 0) (D 0) ≫ (N • 𝟙 (I.cocomplex.X 0)) = 0 := by
    rw [hcomm, hTk 1, Limits.zero_comp]
  let r : Limits.kernel (N • 𝟙 (I.cocomplex.X 1)) ⟶ Limits.kernel (N • 𝟙 (I.cocomplex.X 0)) :=
    Limits.kernel.lift _ _ hψ0
  have hr : D 0 ≫ r = 𝟙 _ := by
    rw [← cancel_mono (ι 0), Category.assoc, Category.id_comp]
    simp only [r, ι, Limits.kernel.lift_ι]
    exact Injective.comp_factorThru _ _
  have he : D 0 ≫ (𝟙 _ - r ≫ D 0) = 0 := by
    rw [Preadditive.comp_sub, Category.comp_id, ← Category.assoc, hr, Category.id_comp, sub_self]
  let s : Limits.cokernel (D 0) ⟶ Limits.kernel (N • 𝟙 (I.cocomplex.X 1)) :=
    Limits.cokernel.desc (D 0) _ he
  have hps : p ≫ s = 𝟙 _ - r ≫ D 0 := Limits.cokernel.π_desc _ _ _
  have hsp : s ≫ p = 𝟙 _ := by
    rw [← cancel_epi p, Category.comp_id, ← Category.assoc, hps]
    rw [Preadditive.sub_comp, Category.id_comp, Category.assoc, hDp,
      Limits.comp_zero, sub_zero]

  have key : ∀ (P' : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (Fr' : P' ⟶ P'),
      (∀ k (c c' : P' ⟶ I.cocomplex.X (k + 1)), N • c = 0 → N • c' = 0 →
        wcBkTruncTheta P' I.cocomplex N k (c + c') =
          wcBkTruncTheta P' I.cocomplex N k c + wcBkTruncTheta P' I.cocomplex N k c') ∧
      (∀ k (c : P' ⟶ I.cocomplex.X (k + 1)), N • c = 0 →
        wcBkTruncTheta P' I.cocomplex N k c ≫ (wcTruncKerRes I.cocomplex N).d k (k + 1) =
          wcBkTruncTheta P' I.cocomplex N (k + 1) (c ≫ I.cocomplex.d (k + 1) (k + 2))) ∧
      (∀ k (x : P' ⟶ (wcTruncKerRes I.cocomplex N).X k), ∃ c : P' ⟶ I.cocomplex.X (k + 1),
        N • c = 0 ∧ wcBkTruncTheta P' I.cocomplex N k c = x) ∧
      (∀ k (c : P' ⟶ I.cocomplex.X (k + 2)), N • c = 0 →
        wcBkTruncTheta P' I.cocomplex N (k + 1) c = 0 → c = 0) ∧
      (∀ c : P' ⟶ I.cocomplex.X 1, N • c = 0 → wcBkTruncTheta P' I.cocomplex N 0 c = 0 →
        ∃ y : P' ⟶ I.cocomplex.X 0, N • y = 0 ∧ y ≫ I.cocomplex.d 0 1 = c) ∧
      (∀ y : P' ⟶ I.cocomplex.X 0, N • y = 0 →
        wcBkTruncTheta P' I.cocomplex N 0 (y ≫ I.cocomplex.d 0 1) = 0) ∧
      (∀ k (c : P' ⟶ I.cocomplex.X (k + 1)), N • c = 0 →
        Fr' ≫ wcBkTruncTheta P' I.cocomplex N k c =
          wcBkTruncTheta P' I.cocomplex N k (Fr' ≫ c)) := by
    intro P' Fr'
    have hT0 : ∀ (c : P' ⟶ I.cocomplex.X 1) (hc : c ≫ (N • 𝟙 (I.cocomplex.X 1)) = 0),
        wcBkTruncTheta P' I.cocomplex N 0 c = Limits.kernel.lift _ c hc ≫ p :=
      fun c hc => dif_pos hc
    have hTS : ∀ j (c : P' ⟶ I.cocomplex.X (j + 2))
        (hc : c ≫ (N • 𝟙 (I.cocomplex.X (j + 2))) = 0),
        wcBkTruncTheta P' I.cocomplex N (j + 1) c = Limits.kernel.lift _ c hc :=
      fun j c hc => dif_pos hc
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    ·
      intro k c c' hc hc'
      have h1 := (htor c).1 hc
      have h2 := (htor c').1 hc'
      have h3 : (c + c') ≫ (N • 𝟙 (I.cocomplex.X (k + 1))) = 0 := by
        rw [Preadditive.add_comp, h1, h2, add_zero]
      have hl : Limits.kernel.lift _ (c + c') h3 =
          Limits.kernel.lift _ c h1 + Limits.kernel.lift _ c' h2 := by
        rw [← cancel_mono (ι (k + 1)), Preadditive.add_comp]
        simp only [ι, Limits.kernel.lift_ι]
      cases k with
      | zero =>
        rw [hT0 _ h3, hT0 _ h1, hT0 _ h2, hl, Preadditive.add_comp]
        rfl
      | succ j =>
        rw [hTS j _ h3, hTS j _ h1, hTS j _ h2, hl]
        rfl
    ·
      intro k c hc
      have h1 := (htor c).1 hc
      have h2 : (c ≫ I.cocomplex.d (k + 1) (k + 2)) ≫ (N • 𝟙 (I.cocomplex.X (k + 2))) = 0 := by
        rw [Category.assoc, hcomm, ← Category.assoc, h1, Limits.zero_comp]
      have hl : Limits.kernel.lift _ c h1 ≫ D (k + 1) =
          Limits.kernel.lift _ (c ≫ I.cocomplex.d (k + 1) (k + 2)) h2 := by
        rw [← cancel_mono (ι (k + 2))]
        simp [D, ι, wcTruncKerD, Limits.kernel.map]
      cases k with
      | zero =>
        rw [hT0 c h1, hTS 0 _ h2]
        exact (Category.assoc (Limits.kernel.lift _ c h1) p
          ((wcTruncKerRes I.cocomplex N).d 0 1)).trans
          ((congrArg (fun g => Limits.kernel.lift _ c h1 ≫ g) hpδ).trans hl)
      | succ j =>
        rw [hTS j c h1, hJdS j, hTS (j + 1) _ h2]
        exact hl
    ·
      intro k x
      cases k with
      | zero =>
        change P' ⟶ Limits.cokernel (D 0) at x
        have h1 : (x ≫ s ≫ ι 1) ≫ (N • 𝟙 (I.cocomplex.X 1)) = 0 := by
          simp only [Category.assoc, hιn, Limits.comp_zero]
        refine ⟨x ≫ s ≫ ι 1, (htor _).2 h1, ?_⟩
        have hl : Limits.kernel.lift _ (x ≫ s ≫ ι 1) h1 = x ≫ s :=
          (cancel_mono (ι 1)).1 (by simp only [ι, Limits.kernel.lift_ι, Category.assoc])
        rw [hT0 _ h1, hl]
        exact (Category.assoc x s p).trans
          ((congrArg (fun g => x ≫ g) hsp).trans (Category.comp_id x))
      | succ j =>
        change P' ⟶ Limits.kernel (N • 𝟙 (I.cocomplex.X (j + 2))) at x
        have h1 : (x ≫ ι (j + 2)) ≫ (N • 𝟙 (I.cocomplex.X (j + 2))) = 0 := by
          simp only [Category.assoc, hιn, Limits.comp_zero]
        refine ⟨x ≫ ι (j + 2), (htor _).2 h1, ?_⟩
        rw [hTS j _ h1]
        exact (cancel_mono (ι (j + 2))).1 (by simp only [ι, Limits.kernel.lift_ι])
    ·
      intro k c hc h0
      have h1 := (htor c).1 hc
      rw [hTS k c h1] at h0
      calc c = Limits.kernel.lift _ c h1 ≫ ι (k + 2) := (Limits.kernel.lift_ι _ _ _).symm
        _ = 0 := by rw [h0]; exact Limits.zero_comp
    ·
      intro c hc h0
      have h1 := (htor c).1 hc
      rw [hT0 c h1] at h0
      have hz : Limits.kernel.lift _ c h1 = Limits.kernel.lift _ c h1 ≫ r ≫ D 0 := by
        have e : Limits.kernel.lift _ c h1 ≫ (p ≫ s) = 0 := by
          rw [← Category.assoc, h0]
          exact Limits.zero_comp
        rw [hps, Preadditive.comp_sub, Category.comp_id, sub_eq_zero] at e
        exact e
      have hy : (Limits.kernel.lift _ c h1 ≫ r ≫ ι 0) ≫ (N • 𝟙 (I.cocomplex.X 0)) = 0 := by
        simp only [Category.assoc, hιn, Limits.comp_zero]
      refine ⟨Limits.kernel.lift _ c h1 ≫ r ≫ ι 0, (htor _).2 hy, ?_⟩
      calc (Limits.kernel.lift _ c h1 ≫ r ≫ ι 0) ≫ I.cocomplex.d 0 1
          = Limits.kernel.lift _ c h1 ≫ r ≫ (ι 0 ≫ I.cocomplex.d 0 1) := by
            simp only [Category.assoc]
        _ = (Limits.kernel.lift _ c h1 ≫ r ≫ D 0) ≫ ι 1 := by
            rw [← hDι0]; simp only [Category.assoc]
        _ = Limits.kernel.lift _ c h1 ≫ ι 1 := by rw [← hz]
        _ = c := Limits.kernel.lift_ι _ _ _
    ·
      intro y hy
      have h1 := (htor y).1 hy
      have h2 : (y ≫ I.cocomplex.d 0 1) ≫ (N • 𝟙 (I.cocomplex.X 1)) = 0 := by
        rw [Category.assoc, hcomm, ← Category.assoc, h1, Limits.zero_comp]
      have hl : Limits.kernel.lift _ (y ≫ I.cocomplex.d 0 1) h2 =
          Limits.kernel.lift _ y h1 ≫ D 0 := by
        rw [← cancel_mono (ι 1), Category.assoc, hDι0, ← Category.assoc]
        simp only [ι, Limits.kernel.lift_ι]
      rw [hT0 _ h2, hl]
      exact (Category.assoc _ _ _).trans
        ((congrArg (fun g => Limits.kernel.lift _ y h1 ≫ g) hDp).trans Limits.comp_zero)
    ·
      intro k c hc
      have h1 := (htor c).1 hc
      have h2 : (Fr' ≫ c) ≫ (N • 𝟙 (I.cocomplex.X (k + 1))) = 0 := by
        rw [Category.assoc, h1, Limits.comp_zero]
      have hl : Limits.kernel.lift _ (Fr' ≫ c) h2 = Fr' ≫ Limits.kernel.lift _ c h1 := by
        rw [← cancel_mono (ι (k + 1)), Category.assoc]
        simp only [ι, Limits.kernel.lift_ι]
      cases k with
      | zero =>
        rw [hT0 c h1, hT0 _ h2, hl, Category.assoc]
        rfl
      | succ j =>
        rw [hTS j c h1, hTS j _ h2, hl]
        rfl
  obtain ⟨hA, hB, hC, hD', hE, hF, hG⟩ := key
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
    (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP))
  refine ⟨fun k b => hdiv k b, fun k c => wcBkTruncTheta
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) I.cocomplex N k c,
    ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro k c c' hc hc'
    exact hA k c c' hc hc'
  · intro k c hc
    exact hB k c hc
  · intro k x
    exact hC k x
  · intro k c hc h0
    exact hD' k c hc h0
  · intro c hc h0
    exact hE c hc h0
  · intro y hy
    exact hF y hy
  · intro k c hc
    exact hG k c hc

theorem wcU_bk_descend_htpy {A B V W : CochainComplex AddCommGrpCat.{v} ℕ} (Φ : A ⟶ B) (N : ℕ)
    (σ : ∀ k, A.X k →+ B.X k) (hσ : ∀ k a, N • σ k a = (Φ.f k).hom a)
    (red : ∀ k, A.X k →+ V.X k) (hred_surj : ∀ k, Function.Surjective (red k))
    (hred_ker : ∀ k a, red k a = 0 → ∃ w, a = N • w)
    (hred_d : ∀ k a, red (k + 1) ((A.d k (k + 1)).hom a) = (V.d k (k + 1)).hom (red k a))
    (θ : ∀ k, B.X (k + 1) → W.X k)
    (hθadd : ∀ k c c', N • c = 0 → N • c' = 0 → θ k (c + c') = θ k c + θ k c')
    (hθd : ∀ k c, N • c = 0 → (W.d k (k + 1)).hom (θ k c) = θ (k + 1) ((B.d (k + 1) (k + 2)).hom c))
    (hθ0 : ∀ y : B.X 0, N • y = 0 → θ 0 ((B.d 0 1).hom y) = 0)
    (Ψ' : V ⟶ W) (hΨ' : ∀ k a, (Ψ'.f k).hom (red k a) =
      ((-1 : ℤ) ^ k) • θ k ((B.d k (k + 1)).hom (σ k a) - σ (k + 1) ((A.d k (k + 1)).hom a)))
    (fA : A ⟶ A) (FB : B ⟶ B) (fV : V ⟶ V) (FW : W ⟶ W)
    (hredF : ∀ k a, red k ((fA.f k).hom a) = (fV.f k).hom (red k a))
    (hθF : ∀ k c, N • c = 0 → (FW.f k).hom (θ k c) = θ k ((FB.f (k + 1)).hom c))
    (h : Homotopy (Φ ≫ FB) (fA ≫ Φ))
    (τ : ∀ k, A.X (k + 1) →+ B.X k) (hτ : ∀ k a, N • τ k a = (h.hom (k + 1) k).hom a) :
    Nonempty (Homotopy (Ψ' ≫ FW) (fV ≫ Ψ')) :=
by
  classical

  have hdd : ∀ {C : CochainComplex AddCommGrpCat.{v} ℕ} (i j k : ℕ) (x : C.X i),
      (C.d j k).hom ((C.d i j).hom x) = 0 := by
    intro C i j k x
    have e := congrArg (fun f => f.hom x) (C.d_comp_d i j k)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply,
      AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] at e
    exact e
  have hcomm : ∀ {C D : CochainComplex AddCommGrpCat.{v} ℕ} (f : C ⟶ D) (i j : ℕ) (x : C.X i),
      (D.d i j).hom ((f.f i).hom x) = (f.f j).hom ((C.d i j).hom x) := by
    intro C D f i j x
    have e := congrArg (fun g => g.hom x) (f.comm i j)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at e
    exact e

  have hcs : ∀ j (a : A.X (j + 1)), (FB.f (j + 1)).hom ((Φ.f (j + 1)).hom a) =
      (h.hom (j + 1 + 1) (j + 1)).hom ((A.d (j + 1) (j + 1 + 1)).hom a) +
        (B.d j (j + 1)).hom ((h.hom (j + 1) j).hom a) + (Φ.f (j + 1)).hom ((fA.f (j + 1)).hom a) := by
    intro j a
    have e := h.comm (j + 1)
    rw [dNext_eq h.hom (show (ComplexShape.up ℕ).Rel (j + 1) (j + 1 + 1) from rfl),
      prevD_eq h.hom (show (ComplexShape.up ℕ).Rel j (j + 1) from rfl)] at e
    have e2 := congrArg (fun f => f.hom a) e
    simp only [HomologicalComplex.comp_f, AddCommGrpCat.hom_add, AddCommGrpCat.hom_comp,
      AddMonoidHom.add_apply, AddMonoidHom.coe_comp, Function.comp_apply] at e2
    exact e2
  have hc0 : ∀ a : A.X 0, (FB.f 0).hom ((Φ.f 0).hom a) =
      (h.hom (0 + 1) 0).hom ((A.d 0 (0 + 1)).hom a) + (Φ.f 0).hom ((fA.f 0).hom a) := by
    intro a
    have e := h.comm 0
    rw [dNext_eq h.hom (show (ComplexShape.up ℕ).Rel 0 (0 + 1) from rfl),
      Homotopy.prevD_zero_cochainComplex, add_zero] at e
    have e2 := congrArg (fun f => f.hom a) e
    simp only [HomologicalComplex.comp_f, AddCommGrpCat.hom_add, AddCommGrpCat.hom_comp,
      AddMonoidHom.add_apply, AddMonoidHom.coe_comp, Function.comp_apply] at e2
    exact e2

  have hθz : ∀ k, θ k 0 = 0 := by
    intro k
    have e := hθadd k 0 0 (smul_zero N) (smul_zero N)
    rw [add_zero] at e
    have e2 : θ k 0 + θ k 0 = θ k 0 + 0 := by rw [add_zero]; exact e.symm
    exact add_left_cancel e2
  have hθneg : ∀ k c, N • c = 0 → θ k (-c) = -θ k c := by
    intro k c hc
    have hc' : N • (-c) = 0 := by rw [smul_neg, hc, neg_zero]
    have e := hθadd k c (-c) hc hc'
    rw [(by abel : c + -c = 0), hθz] at e
    exact (neg_eq_of_add_eq_zero_right e.symm).symm
  have hθsub : ∀ k c c', N • c = 0 → N • c' = 0 → θ k (c - c') = θ k c - θ k c' := by
    intro k c c' hc hc'
    have hc'' : N • (-c') = 0 := by rw [smul_neg, hc', neg_zero]
    rw [sub_eq_add_neg, hθadd k c (-c') hc hc'', hθneg k c' hc', ← sub_eq_add_neg]

  obtain ⟨P, hP⟩ : ∃ P : ∀ k, A.X k →+ B.X (k + 1), ∀ k a,
      P k a = (B.d k (k + 1)).hom (σ k a) - σ (k + 1) ((A.d k (k + 1)).hom a) :=
    ⟨fun k => (B.d k (k + 1)).hom.comp (σ k) - (σ (k + 1)).comp (A.d k (k + 1)).hom,
      fun k a => rfl⟩
  obtain ⟨ε0, hε0⟩ : ∃ ε0 : A.X 0 →+ B.X 0, ∀ a,
      ε0 a = (FB.f 0).hom (σ 0 a) - σ 0 ((fA.f 0).hom a) - τ 0 ((A.d 0 (0 + 1)).hom a) :=
    ⟨(FB.f 0).hom.comp (σ 0) - (σ 0).comp (fA.f 0).hom - (τ 0).comp (A.d 0 (0 + 1)).hom,
      fun a => rfl⟩
  obtain ⟨εs, hεs⟩ : ∃ εs : ∀ j, A.X (j + 1) →+ B.X (j + 1), ∀ j a,
      εs j a = (FB.f (j + 1)).hom (σ (j + 1) a) - σ (j + 1) ((fA.f (j + 1)).hom a)
        - (B.d j (j + 1)).hom (τ j a) - τ (j + 1) ((A.d (j + 1) (j + 1 + 1)).hom a) :=
    ⟨fun j => (FB.f (j + 1)).hom.comp (σ (j + 1)) - (σ (j + 1)).comp (fA.f (j + 1)).hom
        - (B.d j (j + 1)).hom.comp (τ j) - (τ (j + 1)).comp (A.d (j + 1) (j + 1 + 1)).hom,
      fun j a => rfl⟩

  have tP : ∀ k a, N • P k a = 0 := by
    intro k a
    rw [hP, smul_sub, ← map_nsmul, hσ, hσ, hcomm Φ, sub_self]
  have tε0 : ∀ a, N • ε0 a = 0 := by
    intro a
    rw [hε0, smul_sub, smul_sub, ← map_nsmul (FB.f 0).hom, hσ, hσ, hτ, hc0]
    abel
  have tεs : ∀ j a, N • εs j a = 0 := by
    intro j a
    rw [hεs, smul_sub, smul_sub, smul_sub, ← map_nsmul (FB.f (j + 1)).hom, hσ, hσ,
      ← map_nsmul (B.d j (j + 1)).hom, hτ, hτ, hcs]
    abel
  have tmap : ∀ {X Y : AddCommGrpCat.{v}} (f : X ⟶ Y) (x : X), N • x = 0 → N • f.hom x = 0 := by
    intro X Y f x hx
    rw [← map_nsmul, hx, map_zero]

  have key_s : ∀ j (a : A.X (j + 1)),
      (FB.f (j + 1 + 1)).hom (P (j + 1) a) - P (j + 1) ((fA.f (j + 1)).hom a) =
        (B.d (j + 1) (j + 2)).hom (εs j a) - εs (j + 1) ((A.d (j + 1) (j + 1 + 1)).hom a) := by
    intro j a
    simp only [hP, hεs, map_sub, map_zero, hdd, ← hcomm FB, ← hcomm fA]
    abel
  have key_0 : ∀ a : A.X 0,
      (FB.f (0 + 1)).hom (P 0 a) - P 0 ((fA.f 0).hom a) =
        (B.d 0 1).hom (ε0 a) - εs 0 ((A.d 0 (0 + 1)).hom a) := by
    intro a
    simp only [hP, hεs, hε0, map_sub, map_zero, hdd, ← hcomm FB, ← hcomm fA]
    abel

  have hgadd : ∀ j (a b : A.X (j + 1)), ((-1 : ℤ) ^ (j + 1)) • θ j (εs j (a + b)) =
      ((-1 : ℤ) ^ (j + 1)) • θ j (εs j a) + ((-1 : ℤ) ^ (j + 1)) • θ j (εs j b) := by
    intro j a b
    rw [map_add, hθadd j _ _ (tεs j a) (tεs j b), smul_add]
  obtain ⟨G, hG⟩ : ∃ G : ∀ j, V.X (j + 1) →+ W.X j, ∀ j a,
      G j (red (j + 1) a) = ((-1 : ℤ) ^ (j + 1)) • θ j (εs j a) := by
    refine ⟨fun j => (red (j + 1)).liftOfRightInverse (Function.surjInv (hred_surj (j + 1)))
      (Function.rightInverse_surjInv _)
      ⟨AddMonoidHom.mk' (fun a => ((-1 : ℤ) ^ (j + 1)) • θ j (εs j a)) (hgadd j), ?_⟩, ?_⟩
    · intro x hx
      rw [AddMonoidHom.mem_ker] at hx ⊢
      obtain ⟨w, rfl⟩ := hred_ker _ _ hx
      show ((-1 : ℤ) ^ (j + 1)) • θ j (εs j (N • w)) = 0
      rw [map_nsmul, tεs, hθz, smul_zero]
    · intro j a
      rw [AddMonoidHom.liftOfRightInverse_comp_apply]
      rfl
  obtain ⟨hfun, hfun_apply⟩ : ∃ hfun : ∀ i j, (ComplexShape.up ℕ).Rel j i → (V.X i ⟶ W.X j),
      ∀ j (r : (ComplexShape.up ℕ).Rel j (j + 1)) (y : V.X (j + 1)),
        (hfun (j + 1) j r).hom y = G j y := by
    refine ⟨fun i j hij => (V.XIsoOfEq hij).inv ≫ AddCommGrpCat.ofHom (G j), ?_⟩
    intro j r y
    simp

  have hLHS : ∀ k a, ((Ψ' ≫ FW - fV ≫ Ψ').f k).hom (red k a) =
      ((-1 : ℤ) ^ k) • θ k ((FB.f (k + 1)).hom (P k a) - P k ((fA.f k).hom a)) := by
    intro k a
    have e1 : ((Ψ' ≫ FW - fV ≫ Ψ').f k).hom (red k a) =
        (FW.f k).hom ((Ψ'.f k).hom (red k a)) - (Ψ'.f k).hom ((fV.f k).hom (red k a)) := by
      simp [HomologicalComplex.sub_f_apply]
    rw [e1, ← hredF, hΨ', hΨ', ← hP, ← hP, map_zsmul, hθF k _ (tP k a), ← smul_sub,
      ← hθsub k _ _ (tmap _ _ (tP k a)) (tP k _)]
  have heq : Ψ' ≫ FW - fV ≫ Ψ' = Homotopy.nullHomotopicMap' hfun := by
    apply HomologicalComplex.hom_ext
    intro k
    refine AddCommGrpCat.ext (fun x => ?_)
    obtain ⟨a, rfl⟩ := hred_surj k x
    show ((Ψ' ≫ FW - fV ≫ Ψ').f k).hom (red k a) =
      ((Homotopy.nullHomotopicMap' hfun).f k).hom (red k a)
    rw [hLHS]
    cases k with
    | zero =>
      rw [Homotopy.nullHomotopicMap'_f_of_not_rel_right
        (show (ComplexShape.up ℕ).Rel 0 (0 + 1) from rfl) (fun l hl => Nat.succ_ne_zero l hl)]
      rw [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply, hfun_apply,
        ← hred_d, hG, key_0, hθsub 0 _ _ (tmap _ _ (tε0 a)) (tεs 0 _), hθ0 _ (tε0 a)]
      simp
    | succ j =>
      rw [Homotopy.nullHomotopicMap'_f (show (ComplexShape.up ℕ).Rel j (j + 1) from rfl)
        (show (ComplexShape.up ℕ).Rel (j + 1) (j + 1 + 1) from rfl)]
      rw [AddCommGrpCat.hom_add, AddMonoidHom.add_apply, AddCommGrpCat.hom_comp,
        AddMonoidHom.coe_comp, Function.comp_apply, AddCommGrpCat.hom_comp,
        AddMonoidHom.coe_comp, Function.comp_apply, hfun_apply, hfun_apply, ← hred_d, hG, hG,
        map_zsmul, hθd j _ (tεs j a), key_s,
        hθsub (j + 1) _ _ (tmap _ _ (tεs j a)) (tεs (j + 1) _),
        pow_succ (-1 : ℤ) (j + 1), mul_neg_one, neg_smul, smul_sub]
      abel
  exact ⟨Homotopy.equivSubZero.symm ((Homotopy.ofEq heq).trans (Homotopy.nullHomotopy' hfun))⟩

theorem wcU_bk_red (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) (M : wcGModel ℓ PUnit.{u+1})
    (Q' : wcLnModel (ZMod (ℓ ^ n)))
    (hQ' : wcIsTwist ℓ n (1 : PUnit.{u+1} →* GL (Fin 1) (ZMod (ℓ ^ n))) M Q') :
    (∀ k (a : (wcGModelAb M).X k), (ℓ ^ n) • a = 0 → a = 0) ∧
    ∃ red : ∀ k, (wcGModelAb M).X k →+ (wcLnModelAb.{u+1} Q').X k,
      (∀ k, Function.Surjective (red k)) ∧
      (∀ k a, red k a = 0 ↔ ∃ w, a = (ℓ ^ n) • w) ∧
      (∀ k a, red (k + 1) (((wcGModelAb M).d k (k + 1)).hom a) =
        ((wcLnModelAb.{u+1} Q').d k (k + 1)).hom (red k a)) ∧
      (∀ k a, red k (((wcGModelFrob M).f k).hom a) = ((wcLnModelFrob.{u+1} Q').f k).hom (red k a)) :=
by
  classical

  let aug : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} →ₐ[ℤ_[ℓ]] ℤ_[ℓ] :=
    MonoidAlgebra.lift ℤ_[ℓ] ℤ_[ℓ] PUnit.{u+1} 1
  have haug_single : ∀ a : ℤ_[ℓ], aug (MonoidAlgebra.single PUnit.unit a) = a := by
    intro a
    simp [aug, MonoidAlgebra.lift_single]
  have haug_eq : ∀ c : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1},
      c = MonoidAlgebra.single PUnit.unit (aug c) := by
    intro c
    induction c using MonoidAlgebra.induction_linear with
    | zero => simp
    | add f g hf hg => rw [map_add, MonoidAlgebra.single_add, ← hf, ← hg]
    | single a b => rw [haug_single]
  have hcoeff : ∀ (x : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) (g : PUnit.{u+1}), x.coeff g = aug x := by
    intro x g
    cases g
    conv_lhs => rw [haug_eq x]
    simp [MonoidAlgebra.coeff_single]

  let ρ : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} →+* ZMod (ℓ ^ n) :=
    (PadicInt.toZModPow n).comp (aug : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} →+* ℤ_[ℓ])
  have hrho : ∀ (z : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) (p q : Fin 1),
      wcRhoRed ℓ n (1 : PUnit.{u+1} →* GL (Fin 1) (ZMod (ℓ ^ n))) z p q =
        PadicInt.toZModPow n (aug z) := by
    intro z p q
    obtain rfl : p = q := Subsingleton.elim p q
    simp [wcRhoRed, hcoeff]

  have htf : ∀ x : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}, (ℓ ^ n) • x = 0 → x = 0 := by
    intro x hx
    have h1 : aug ((ℓ ^ n) • x) = 0 := by rw [hx, map_zero]
    rw [map_nsmul, nsmul_eq_mul] at h1
    have hne : ((ℓ ^ n : ℕ) : ℤ_[ℓ]) ≠ 0 := by
      exact_mod_cast pow_ne_zero n (Nat.Prime.ne_zero Fact.out)
    have h2 : aug x = 0 := (mul_eq_zero.mp h1).resolve_left hne
    rw [haug_eq x, h2, MonoidAlgebra.single_zero]
  have hkerR : ∀ x : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}, ρ x = 0 →
      ∃ c : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}, x = (ℓ ^ n) • c := by
    intro x hx
    have hmem : aug x ∈ RingHom.ker (PadicInt.toZModPow (p := ℓ) n) := RingHom.mem_ker.mpr hx
    rw [PadicInt.ker_toZModPow, Ideal.mem_span_singleton'] at hmem
    obtain ⟨c0, hc0⟩ := hmem
    refine ⟨MonoidAlgebra.single PUnit.unit c0, ?_⟩
    rw [MonoidAlgebra.smul_single]
    conv_lhs => rw [haug_eq x]
    congr 1
    rw [← hc0, nsmul_eq_mul]
    push_cast
    ring

  have hvm : ∀ {a a' c c' : ℕ} (ea : Fin a' ≃ Fin a) (eb : Fin c' ≃ Fin c)
      (A : Matrix (Fin a) (Fin c) (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}))
      (A' : Matrix (Fin a') (Fin c') (ZMod (ℓ ^ n)))
      (hA : ∀ x y, A' x y = ρ (A (ea x) (eb y)))
      (v : Fin a → MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) (y : Fin c'),
      ρ (Matrix.vecMul v A (eb y)) = Matrix.vecMul (fun x => ρ (v (ea x))) A' y := by
    intro a a' c c' ea eb A A' hA v y
    show ρ (∑ i, v i * A i (eb y)) = ∑ x, ρ (v (ea x)) * A' x y
    rw [map_sum]
    simp only [map_mul, hA]
    exact (Equiv.sum_comp ea (fun i => ρ (v i) * ρ (A i (eb y)))).symm

  obtain ⟨b, hbε, hbδ, hbf⟩ := hQ'
  let e : ∀ i, Fin (Q'.k i) ≃ Fin (M.k i) := fun i =>
    (b i).trans (Equiv.prodUnique (Fin (M.k i)) (Fin 1))
  have hε' : ∀ i x y, Q'.ε i x y = ρ (M.ε i (e i x) (e i y)) := by
    intro i x y
    rw [hbε]
    exact hrho _ _ _
  have hδ' : ∀ i x y, Q'.δ i x y = ρ (M.δ i (e i x) (e (i + 1) y)) := by
    intro i x y
    rw [hbδ]
    exact hrho _ _ _
  have hf' : ∀ i x y, Q'.f i x y = ρ (M.f i (e i x) (e i y)) := by
    intro i x y
    rw [hbf]
    exact hrho _ _ _

  have hmem : ∀ k (v : wcIdemSub (M.ε k)),
      (fun x => ρ ((v : Fin (M.k k) → MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) (e k x))) ∈
        wcIdemSub (Q'.ε k) := by
    intro k v
    show Matrix.vecMul (fun x => ρ ((v : Fin (M.k k) → MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) (e k x)))
      (Q'.ε k) = fun x => ρ ((v : Fin (M.k k) → MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) (e k x))
    funext y
    rw [← hvm (e k) (e k) (M.ε k) (Q'.ε k) (hε' k) _ y]
    have hv : Matrix.vecMul (v : Fin (M.k k) → MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) (M.ε k) =
      (v : Fin (M.k k) → MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) := v.2
    rw [hv]
  let red : ∀ k, (wcGModelAb M).X k →+ (wcLnModelAb.{u+1} Q').X k := fun k =>
    AddMonoidHom.mk' (fun a => (ULift.up ⟨fun x => ρ ((ULift.down a : wcIdemSub (M.ε k)).1 (e k x)),
        hmem k (ULift.down a)⟩ : ULift.{u+1} (wcIdemSub (Q'.ε k))))
      (fun a a' => ULift.ext _ _ (Subtype.ext (funext fun x =>
        map_add ρ ((ULift.down a : wcIdemSub (M.ε k)).1 (e k x))
          ((ULift.down a' : wcIdemSub (M.ε k)).1 (e k x)))))
  have extM : ∀ k (a a' : (wcGModelAb M).X k),
      (∀ j, (ULift.down a : wcIdemSub (M.ε k)).1 j = (ULift.down a' : wcIdemSub (M.ε k)).1 j) →
        a = a' :=
    fun k a a' h => ULift.ext _ _ (Subtype.ext (funext h))
  have extQ : ∀ k (a a' : (wcLnModelAb.{u+1} Q').X k),
      (∀ j, (ULift.down a : wcIdemSub (Q'.ε k)).1 j = (ULift.down a' : wcIdemSub (Q'.ε k)).1 j) →
        a = a' :=
    fun k a a' h => ULift.ext _ _ (Subtype.ext (funext h))
  refine ⟨?_, red, ?_, ?_, ?_, ?_⟩
  ·
    intro k a h
    apply extM
    intro j
    show (ULift.down a : wcIdemSub (M.ε k)).1 j = 0
    apply htf
    exact congrArg (fun z : (wcGModelAb M).X k => (ULift.down z : wcIdemSub (M.ε k)).1 j) h
  ·
    intro k w
    let s := Function.surjInv (ZMod.ringHom_surjective (PadicInt.toZModPow (p := ℓ) n))
    have hs : ∀ z, PadicInt.toZModPow n (s z) = z := fun z => Function.surjInv_eq _ z
    let uu : Fin (M.k k) → MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} := fun i =>
      MonoidAlgebra.single PUnit.unit (s ((ULift.down w : wcIdemSub (Q'.ε k)).1 ((e k).symm i)))
    have hvmem : Matrix.vecMul uu (M.ε k) ∈ wcIdemSub (M.ε k) := by
      show Matrix.vecMul (Matrix.vecMul uu (M.ε k)) (M.ε k) = Matrix.vecMul uu (M.ε k)
      rw [Matrix.vecMul_vecMul, M.hε k]
    refine ⟨(ULift.up ⟨Matrix.vecMul uu (M.ε k), hvmem⟩ : ULift.{u+1} (wcIdemSub (M.ε k))), ?_⟩
    apply extQ
    intro y
    show ρ (Matrix.vecMul uu (M.ε k) (e k y)) = (ULift.down w : wcIdemSub (Q'.ε k)).1 y
    rw [hvm (e k) (e k) (M.ε k) (Q'.ε k) (hε' k) uu y]
    have hu : (fun x => ρ (uu (e k x))) = (ULift.down w : wcIdemSub (Q'.ε k)).1 := by
      funext x
      show PadicInt.toZModPow n (aug (MonoidAlgebra.single PUnit.unit
        (s ((ULift.down w : wcIdemSub (Q'.ε k)).1 ((e k).symm (e k x)))))) =
        (ULift.down w : wcIdemSub (Q'.ε k)).1 x
      rw [haug_single, hs, Equiv.symm_apply_apply]
    rw [hu]
    have hw : Matrix.vecMul (ULift.down w : wcIdemSub (Q'.ε k)).1 (Q'.ε k) =
      (ULift.down w : wcIdemSub (Q'.ε k)).1 := (ULift.down w : wcIdemSub (Q'.ε k)).2
    exact congrFun hw y
  ·
    intro k a
    constructor
    · intro h
      have h0 : ∀ j, ρ ((ULift.down a : wcIdemSub (M.ε k)).1 j) = 0 := by
        intro j
        have h1 := congrArg (fun z : (wcLnModelAb.{u+1} Q').X k =>
          (ULift.down z : wcIdemSub (Q'.ε k)).1 ((e k).symm j)) h
        change ρ ((ULift.down a : wcIdemSub (M.ε k)).1 (e k ((e k).symm j))) = 0 at h1
        rwa [Equiv.apply_symm_apply] at h1
      choose c hc using fun j => hkerR _ (h0 j)
      have hcmem : Matrix.vecMul c (M.ε k) ∈ wcIdemSub (M.ε k) := by
        show Matrix.vecMul (Matrix.vecMul c (M.ε k)) (M.ε k) = Matrix.vecMul c (M.ε k)
        rw [Matrix.vecMul_vecMul, M.hε k]
      refine ⟨(ULift.up ⟨Matrix.vecMul c (M.ε k), hcmem⟩ : ULift.{u+1} (wcIdemSub (M.ε k))), ?_⟩
      apply extM
      intro j
      show (ULift.down a : wcIdemSub (M.ε k)).1 j = (ℓ ^ n) • Matrix.vecMul c (M.ε k) j
      have hca : (ℓ ^ n) • c = (ULift.down a : wcIdemSub (M.ε k)).1 :=
        funext fun j => (hc j).symm
      have ha : Matrix.vecMul (ULift.down a : wcIdemSub (M.ε k)).1 (M.ε k) =
        (ULift.down a : wcIdemSub (M.ε k)).1 := (ULift.down a : wcIdemSub (M.ε k)).2
      rw [show (ℓ ^ n) • Matrix.vecMul c (M.ε k) j = ((ℓ ^ n) • Matrix.vecMul c (M.ε k)) j from rfl,
        ← Matrix.smul_vecMul, hca, ha]
    · rintro ⟨w, rfl⟩
      rw [map_nsmul]
      apply extQ
      intro x
      show (ℓ ^ n) • ρ ((ULift.down w : wcIdemSub (M.ε k)).1 (e k x)) = 0
      rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  ·
    intro k a
    have hd : (wcGModelAb M).d k (k + 1) = AddCommGrpCat.ofHom
        (wcULiftHom (wcVecMulHom (M.ε k) (M.ε (k + 1)) (M.δ k) (M.hδε k))) :=
      by unfold wcGModelAb; simp only [CochainComplex.of_d]
    have hdQ : (wcLnModelAb.{u+1} Q').d k (k + 1) = AddCommGrpCat.ofHom
        (wcULiftHom (wcVecMulHom (Q'.ε k) (Q'.ε (k + 1)) (Q'.δ k) (Q'.hδε k))) :=
      by unfold wcLnModelAb; simp only [CochainComplex.of_d]
    rw [hd, hdQ]
    apply extQ
    intro y
    show ρ (Matrix.vecMul (ULift.down a : wcIdemSub (M.ε k)).1 (M.δ k) (e (k + 1) y)) =
      Matrix.vecMul (fun x => ρ ((ULift.down a : wcIdemSub (M.ε k)).1 (e k x))) (Q'.δ k) y
    exact hvm (e k) (e (k + 1)) (M.δ k) (Q'.δ k) (hδ' k) _ y
  ·
    intro k a
    apply extQ
    intro y
    show ρ (Matrix.vecMul (ULift.down a : wcIdemSub (M.ε k)).1 (M.f k) (e k y)) =
      Matrix.vecMul (fun x => ρ ((ULift.down a : wcIdemSub (M.ε k)).1 (e k x))) (Q'.f k) y
    exact hvm (e k) (e k) (M.f k) (Q'.f k) (hf' k) _ y

theorem wcU_bk_linear_lift (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {Γ : Type u} [Group Γ] (M : wcGModel ℓ Γ)
    (D : CochainComplex AddCommGrpCat.{u+1} ℕ) (lamD : MonoidAlgebra ℤ_[ℓ] Γ → (D ⟶ D))
    (hadd : ∀ a b, lamD (a + b) = lamD a + lamD b) (N : ℕ) (k j : ℕ)
    (g : (wcGModelAb M).X k ⟶ D.X j)
    (hg : ∀ c, (wcGModelSmul M c).f k ≫ g = g ≫ (lamD c).f j)
    (hdiv : ∀ b : D.X j, ∃ b', N • b' = b) :
    ∃ s : (wcGModelAb M).X k →+ D.X j, ∀ a, N • s a = g.hom a :=
by
  classical
  let vecH : (wcGModelAb M).X k →+ (Fin (M.k k) → MonoidAlgebra ℤ_[ℓ] Γ) :=
    (wcIdemSub (M.ε k)).subtype.comp
      (AddEquiv.ulift : ULift.{u+1} (wcIdemSub (M.ε k)) ≃+ _).toAddMonoidHom
  have hinj : ∀ a b : (wcGModelAb M).X k, vecH a = vecH b → a = b := by
    intro a b h
    exact ULift.ext _ _ (Subtype.ext h)
  have hsm : ∀ c (x : (wcGModelAb M).X k),
      vecH (((wcGModelSmul M c).f k).hom x) = c • vecH x := fun c x => rfl
  have hmemb : ∀ a : (wcGModelAb M).X k, Matrix.vecMul (vecH a) (M.ε k) = vecH a :=
    fun a => (show ULift.{u+1} (wcIdemSub (M.ε k)) from a).down.2
  have hmem : ∀ i, Matrix.vecMul (Matrix.vecMul (Pi.single i (1 : MonoidAlgebra ℤ_[ℓ] Γ))
      (M.ε k)) (M.ε k) = Matrix.vecMul (Pi.single i 1) (M.ε k) := by
    intro i; rw [Matrix.vecMul_vecMul, M.hε k]
  let r : Fin (M.k k) → (wcGModelAb M).X k := fun i =>
    (ULift.up ⟨Matrix.vecMul (Pi.single i 1) (M.ε k), hmem i⟩ : ULift.{u+1} (wcIdemSub (M.ε k)))
  have hr : ∀ i, vecH (r i) = M.ε k i := by
    intro i
    show Matrix.vecMul (Pi.single i 1) (M.ε k) = M.ε k i
    rw [Matrix.single_vecMul, one_smul]
    rfl
  have hg' : ∀ c (a : (wcGModelAb M).X k),
      g.hom (((wcGModelSmul M c).f k).hom a) = ((lamD c).f j).hom (g.hom a) := by
    intro c a
    exact congrArg (fun f => AddCommGrpCat.Hom.hom f a) (hg c)
  choose y hy using fun i => hdiv (g.hom (r i))
  let s : (wcGModelAb M).X k →+ D.X j :=
    AddMonoidHom.mk' (fun a => ∑ i, ((lamD (vecH a i)).f j).hom (y i)) (by
      intro a b
      simp only [map_add, Pi.add_apply, hadd, HomologicalComplex.add_f_apply,
        AddCommGrpCat.hom_add_apply, Finset.sum_add_distrib])
  refine ⟨s, fun a => ?_⟩
  have hdec : a = ∑ i, ((wcGModelSmul M (vecH a i)).f k).hom (r i) := by
    apply hinj
    rw [map_sum]
    simp only [hsm, hr]
    rw [← Matrix.vecMul_eq_sum]
    exact (hmemb a).symm
  have e1 : ∀ i, N • ((lamD (vecH a i)).f j).hom (y i) =
      g.hom (((wcGModelSmul M (vecH a i)).f k).hom (r i)) := by
    intro i
    rw [← map_nsmul, hy, hg']
  show N • (∑ i, ((lamD (vecH a i)).f j).hom (y i)) = g.hom a
  rw [Finset.smul_sum, Finset.sum_congr rfl (fun i _ => e1 i), ← map_sum, ← hdec]

theorem wcU_lm_bockstein_model (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (L : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (lamL : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} → (L ⟶ L)) (hlamL : wcRingAct lamL)
    (I : InjectiveResolution L)
    (lamI : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} → (I.cocomplex ⟶ I.cocomplex))
    (hI : wcRingResSpec lamL I lamI)
    (n : ℕ) (hn : 1 ≤ n) (hLN : Mono ((ℓ ^ n : ℕ) • 𝟙 L))
    (M : wcGModel ℓ PUnit.{u+1}) (φ : wcGModelAb M ⟶ wcCxJ K hP I.cocomplex) (hφ : QuasiIso φ)
    (hlin : ∀ c, wcGModelSmul M c ≫ φ = φ ≫ wcCxJMap K hP (lamI c))
    (h : Homotopy (φ ≫ wcCxJFrob K hP I.cocomplex) (wcGModelFrob M ≫ φ))
    (hhlin : ∀ c i j, (wcGModelSmul M c).f i ≫ h.hom i j = h.hom i j ≫
      (wcCxJMap K hP (lamI c)).f j)
    (Q' : wcLnModel (ZMod (ℓ ^ n)))
    (hQ' : wcIsTwist ℓ n (1 : PUnit.{u+1} →* GL (Fin 1) (ZMod (ℓ ^ n))) M Q') :
    ∃ Ψ' : wcLnModelAb Q' ⟶ wcCxJ K hP (wcTruncKerRes I.cocomplex (ℓ ^ n)), QuasiIso Ψ' ∧
      Nonempty (Homotopy (Ψ' ≫ wcCxJFrob K hP (wcTruncKerRes I.cocomplex (ℓ ^ n)))
        (wcLnModelFrob Q' ≫ Ψ')) :=
by
  classical

  have hN : 1 ≤ ℓ ^ n := Nat.one_le_pow _ _ (Nat.Prime.pos Fact.out)

  obtain ⟨hdivB, θ, hθadd, hθd, hθsurj, hθinj, hθker0, hθ0, hθF⟩ :=
    wcU_bk_trunc_interface K hP L I (ℓ ^ n) hN hLN

  obtain ⟨hA, red, hred_surj, hred_ker, hred_d, hredF⟩ := wcU_bk_red ℓ n M Q' hQ'

  let lamD : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} → (wcCxJ K hP I.cocomplex ⟶ wcCxJ K hP I.cocomplex) :=
    fun c => wcCxJMap K hP (lamI c)
  have hadd : ∀ a b, lamD (a + b) = lamD a + lamD b := by
    intro a b
    show wcCxJMap K hP (lamI (a + b)) = wcCxJMap K hP (lamI a) + wcCxJMap K hP (lamI b)
    rw [hI.1.2.1 a b]
    exact Functor.map_add _
  have hgσ : ∀ k c, (wcGModelSmul M c).f k ≫ φ.f k = φ.f k ≫ (lamD c).f k := by
    intro k c
    have e := HomologicalComplex.congr_hom (hlin c) k
    rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f] at e
    exact e
  choose σ hσ using fun k => wcU_bk_linear_lift ℓ M (wcCxJ K hP I.cocomplex) lamD hadd (ℓ ^ n)
    k k (φ.f k) (hgσ k) (hdivB k)
  choose τ hτ using fun k => wcU_bk_linear_lift ℓ M (wcCxJ K hP I.cocomplex) lamD hadd (ℓ ^ n)
    (k + 1) k (h.hom (k + 1) k) (fun c => hhlin c (k + 1) k) (hdivB k)

  obtain ⟨hinj, hsurj⟩ := (wcU_bk_qiso_elem φ).mp hφ

  obtain ⟨hS, hIc⟩ := wcU_bk_chase φ (ℓ ^ n) hA hdivB hinj hsurj σ hσ

  obtain ⟨Ψ', hΨ'⟩ := wcU_bk_descend φ (ℓ ^ n) σ hσ red hred_surj
    (fun k a => (hred_ker k a).mp) hred_d θ hθadd hθd

  have hwd : ∀ k a, (ℓ ^ n) • (((wcCxJ K hP I.cocomplex).d k (k + 1)).hom (σ k a) -
      σ (k + 1) (((wcGModelAb M).d k (k + 1)).hom a)) = 0 := by
    intro k a
    have hc := congrArg (fun f => f.hom a) (φ.comm k (k + 1))
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at hc
    rw [smul_sub, ← map_nsmul, hσ, hσ, hc, sub_self]
  have hqiso : QuasiIso Ψ' := (wcU_bk_qiso_elem Ψ').mpr
    (wcU_bk_descend_qiso (ℓ ^ n) σ red hred_surj hred_ker hred_d θ hθadd hθd hθsurj hθinj
      hθker0 hθ0 hS hIc hwd Ψ' hΨ')

  have hhtpy := wcU_bk_descend_htpy φ (ℓ ^ n) σ hσ red hred_surj
    (fun k a => (hred_ker k a).mp) hred_d θ hθadd hθd hθ0 Ψ' hΨ'
    (wcGModelFrob M) (wcCxJFrob K hP I.cocomplex) (wcLnModelFrob Q')
    (wcCxJFrob K hP (wcTruncKerRes I.cocomplex (ℓ ^ n))) hredF hθF h τ hτ

  exact ⟨Ψ', hqiso, hhtpy⟩

theorem wcU_lattice_mod_model (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G) (hlisse : wcLisseOffS K hP ℓ m S G σ)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    (r : ℕ) (V : ℕ → Scheme.{u}) (q' : (n : ℕ) → V n ⟶ Uo.toScheme) (Γ : ℕ → Type u)
    [∀ n, Group (Γ n)] (α : (n : ℕ) → Γ n →* Aut (V n))
    (ρ : (n : ℕ) → Γ n →* GL (Fin r) (ZMod (ℓ ^ n)))
    (hCOV : ∀ n, 1 ≤ n → wcGalCover (q' n) (Γ n) (α n))
    (hα' : ∀ (n : ℕ) (γ : Γ n), (α n γ).hom ≫ q' n ≫ Uo.ι = q' n ≫ Uo.ι)
    (L : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (ι : L ⟶ G) (lam : ℤ_[ℓ] → (L ⟶ L))
    (π : (n : ℕ) → (L ⟶ wcTwSh (q' n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
      (Γ n) (α n) (hα' n) ℓ n r (ρ n)))
    (τ : (n : ℕ) → (wcTwSh (q' (n + 1) ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Γ (n + 1)) (α (n + 1))
        (hα' (n + 1)) ℓ (n + 1) r (ρ (n + 1)) ⟶
      wcTwSh (q' n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
        (Γ n) (α n) (hα' n) ℓ n r (ρ n)))
    (hD : wcLatticeData K ℓ m S G σ Uo r V q' Γ α ρ hα' L ι lam π τ)
    (hT : wcCokerTorsion K hP ℓ ι) :
    ∃ M : wcGModel ℓ PUnit.{u+1},
      (∃ Ψ : wcGModelAb M ⟶ wcCx K hP L, QuasiIso Ψ ∧
        Nonempty (Homotopy (Ψ ≫ wcCxFrob K hP L) (wcGModelFrob M ≫ Ψ))) ∧
      ∀ n, 1 ≤ n →
        ∃ (J : CochainComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left)
              AddCommGrpCat.{u+1}) ℕ)
          (η : wcTwSh (q' n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
              (Γ n) (α n) (hα' n) ℓ n r (ρ n) ⟶ J.X 0),
          wcNTorsRes K hP (ℓ ^ n) _ J η ∧
          ∃ Q' : wcLnModel (ZMod (ℓ ^ n)),
            wcIsTwist ℓ n (1 : PUnit.{u+1} →* GL (Fin 1) (ZMod (ℓ ^ n))) M Q' ∧
            ∃ Ψ' : wcLnModelAb Q' ⟶ wcCxJ K hP J, QuasiIso Ψ' ∧
              Nonempty (Homotopy (Ψ' ≫ wcCxJFrob K hP J) (wcLnModelFrob Q' ≫ Ψ')) :=
by
  classical
  obtain ⟨⟨T1a, T1b, T1c, T1d⟩, Tι, T3U, T4, T5, T6a, T6b⟩ := hD

  let aug : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} →ₐ[ℤ_[ℓ]] ℤ_[ℓ] :=
    MonoidAlgebra.lift ℤ_[ℓ] ℤ_[ℓ] PUnit.{u+1} 1
  have haug_single : ∀ a : ℤ_[ℓ], aug (MonoidAlgebra.single PUnit.unit a) = a := by
    intro a
    simp [aug, MonoidAlgebra.lift_single]
  have haug_eq : ∀ c : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1},
      c = MonoidAlgebra.single PUnit.unit (aug c) := by
    intro c
    induction c using MonoidAlgebra.induction_linear with
    | zero => simp
    | add f g hf hg => rw [map_add, MonoidAlgebra.single_add, ← hf, ← hg]
    | single a b => rw [haug_single]

  have hlam0 : lam 0 = 0 := by
    have h := T1b 0 0
    rw [add_zero] at h
    simpa using h
  have hlamNat : ∀ k : ℕ, lam (k : ℤ_[ℓ]) = k • 𝟙 L := by
    intro k
    induction k with
    | zero => rw [Nat.cast_zero, hlam0, zero_smul]
    | succ k ih => rw [Nat.cast_succ, T1b, ih, T1a, succ_nsmul]
  have hlamPow : ∀ n : ℕ, lam ((ℓ : ℤ_[ℓ]) ^ n) = (ℓ ^ n : ℕ) • 𝟙 L := by
    intro n
    rw [← hlamNat, Nat.cast_pow]
  have hsesN : ∀ n, 1 ≤ n → ∃ w : ((ℓ ^ n : ℕ) • 𝟙 L) ≫ π n = 0,
      (ShortComplex.mk ((ℓ ^ n : ℕ) • 𝟙 L) (π n) w).ShortExact := by
    intro n hn
    obtain ⟨w, hw⟩ := T4 n hn
    have key : ∀ (f : L ⟶ L), f = (ℓ ^ n : ℕ) • 𝟙 L → ∀ (w : f ≫ π n = 0),
        (ShortComplex.mk f (π n) w).ShortExact →
        ∃ w' : ((ℓ ^ n : ℕ) • 𝟙 L) ≫ π n = 0,
          (ShortComplex.mk ((ℓ ^ n : ℕ) • 𝟙 L) (π n) w').ShortExact := by
      rintro f rfl w h
      exact ⟨w, h⟩
    exact key _ (hlamPow n) w hw

  have hlamR : wcRingAct (fun c : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} => lam (aug c)) := by
    refine ⟨?_, ?_, ?_⟩
    · show lam (aug 1) = 𝟙 L
      rw [map_one, T1a]
    · intro a b
      show lam (aug (a + b)) = lam (aug a) + lam (aug b)
      rw [map_add, T1b]
    · intro a b
      show lam (aug (a * b)) = lam (aug b) ≫ lam (aug a)
      rw [map_mul, T1c]
  have hR : ∀ (n : ℕ) (c : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}), 0 < n →
      (n : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) * c = 0 → c = 0 := by
    intro n c hn h
    have h2 := congrArg aug h
    rw [map_mul, map_natCast, map_zero] at h2
    have h3 : aug c = 0 :=
      (mul_eq_zero.mp h2).resolve_left (by exact_mod_cast hn.ne')
    rw [haug_eq c, h3, MonoidAlgebra.single_zero]
  obtain ⟨I, lamI, hI⟩ := wc_ring_injective_resolution (wcP1Over K).left
    (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) hR L (fun c => lam (aug c)) hlamR
  have hlamD : wcRingAct (fun c => ((preadditiveCoyoneda.obj (Opposite.op
      (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex
        (ComplexShape.up ℕ)).map (lamI c)) := by
    obtain ⟨h1, hadd, hmul⟩ := hI.1
    refine ⟨?_, ?_, ?_⟩
    · simp only [h1, CategoryTheory.Functor.map_id]
    · intro a b
      simp only [hadd, CategoryTheory.Functor.map_add]
    · intro a b
      simp only [hmul, CategoryTheory.Functor.map_comp]
  have hFr : ∀ c, ((preadditiveCoyoneda.obj (Opposite.op
      (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex
        (ComplexShape.up ℕ)).map (lamI c) ≫ wcCxJFrob K hP I.cocomplex =
      wcCxJFrob K hP I.cocomplex ≫ ((preadditiveCoyoneda.obj (Opposite.op
      (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex
        (ComplexShape.up ℕ)).map (lamI c) := fun c =>
    NatTrans.mapHomologicalComplex_naturality _ _

  have hJres : ∀ n, 1 ≤ n → ∃ η : wcTwSh (q' n ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Γ n) (α n) (hα' n) ℓ n r (ρ n) ⟶
        (wcTruncKerRes I.cocomplex (ℓ ^ n)).X 0,
      wcNTorsRes K hP (ℓ ^ n) _ (wcTruncKerRes I.cocomplex (ℓ ^ n)) η := fun n hn =>
    wcU_lm_trunc_ker_res K hP L _ I (ℓ ^ n)
      (Nat.one_le_pow _ _ (Nat.Prime.pos Fact.out)) (π n) (hsesN n hn)

  have hfinTw : ∀ n, 1 ≤ n → ∀ i : ℕ,
      Finite (Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
        (wcTwSh (q' n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
          (Γ n) (α n) (hα' n) ℓ n r (ρ n)) i) ∧
      (3 ≤ i → ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
        (wcTwSh (q' n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
          (Γ n) (α n) (hα' n) ℓ n r (ρ n)) i, y = 0) := by
    intro n hn
    haveI : Finite (Γ n) := (hCOV n hn).1
    letI : Fintype (Γ n) := Fintype.ofFinite (Γ n)
    obtain ⟨lamF, hlamF, hlamFs, I₀, lamI₀, hI₀, P₀, φ₀, hφ₀, hlin₀, ⟨H₀, hH₀⟩, -⟩ :=
      wcU_strict_linear_model_exists K hP ℓ hℓ m S hS Uo hUo (q' n) (Γ n) (α n) (hCOV n hn)
        (hα' n)
    obtain ⟨Q, hQ⟩ := wcU_twist_exists ℓ n (ρ n) P₀
    obtain ⟨η, hη⟩ := hJres n hn
    obtain ⟨Ψ, hΨ, -⟩ := wcU_strict_projection_formula K hP ℓ hℓ m S hS Uo hUo (q' n) (Γ n)
      (α n) (hCOV n hn) (hα' n) n hn r (ρ n) lamF hlamF hlamFs I₀ lamI₀ hI₀ P₀ φ₀ hφ₀ hlin₀
      H₀ hH₀ Q hQ _ η hη
    exact wcU_lm_ext_finite_of_lnmodel K hP (ℓ ^ n)
      (Nat.one_le_pow _ _ (Nat.Prime.pos Fact.out)) _ _ η hη Q Ψ hΨ

  obtain ⟨hz, hses⟩ := wcU_lm_tower_ses (wcP1Over K).left ℓ L lam T1a
    (fun j => wcTwSh (q' (j + 1) ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
      (Γ (j + 1)) (α (j + 1)) (hα' (j + 1)) ℓ (j + 1) r (ρ (j + 1)))
    (fun j => π (j + 1)) (fun j => τ (j + 1))
    (fun j => T4 (j + 1) (by omega)) T5 (fun j => T6a (j + 1) (by omega))
    (by
      intro T x hx
      let x' : ∀ n, ((wcTwSh (q' n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
          (Γ n) (α n) (hα' n) ℓ n r (ρ n)).obj.obj (Opposite.op T)) := fun n =>
        match n with
        | 0 => 0
        | j + 1 => x j
      have hx' : ∀ n, 1 ≤ n → ((τ n).hom.app (Opposite.op T)).hom (x' (n + 1)) = x' n := by
        intro n hn
        obtain ⟨j, rfl⟩ : ∃ j, n = j + 1 := ⟨n - 1, by omega⟩
        exact hx j
      obtain ⟨s, hs⟩ := T6b T x' hx'
      exact ⟨s, fun j => hs (j + 1) (by omega)⟩)
  haveI := wc_proet_products_exact (wcP1Over K).left
  have hsep := wcU_lm_ext_tower_sep
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) L _ _ _ hz hses
    (fun j k => (hfinTw (j + 1) (by omega) k).1)
  obtain ⟨hfg, hvan⟩ := wcU_lm_ext_fg_of_sep ℓ
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) L lam ⟨T1a, T1b, T1c⟩
    (fun j => wcTwSh (q' (j + 1) ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
      (Γ (j + 1)) (α (j + 1)) (hα' (j + 1)) ℓ (j + 1) r (ρ (j + 1)))
    (fun j => π (j + 1))
    (fun j => (T4 (j + 1) (by omega)).fst) (T4 1 le_rfl)
    (fun i => (hfinTw 1 le_rfl i).1)
    (fun j i hi y => (hfinTw (j + 1) (by omega) i).2 hi y) hsep
  have hfv := wc_fgvan_of_ext_fg (fun c => lam (aug c)) I lamI hI.2.1
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
    (by
      intro N
      obtain ⟨k, e, he⟩ := hfg N
      refine ⟨k, e, fun x => ?_⟩
      obtain ⟨c, hc⟩ := he x
      refine ⟨fun i => MonoidAlgebra.single PUnit.unit (c i), ?_⟩
      rw [hc]
      simp only [haug_single])
    hvan
  obtain ⟨T⟩ := wc_three_term_model_exists ℓ PUnit.{u+1} _ _ hlamD hfv
  have hmono : Mono ((fun c : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} => lam (aug c))
      (MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ]))) := by
    obtain ⟨w, hw⟩ := T4 1 le_rfl
    have hm1 := hw.mono_f
    simp only [pow_one] at hm1
    show Mono (lam (aug (MonoidAlgebra.single PUnit.unit (ℓ : ℤ_[ℓ]))))
    rw [haug_single]
    exact hm1
  have hTproj := wcU_lm_head_projective ℓ (wcP1Over K).left
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) L _ hlamR hmono I lamI hI T
  obtain ⟨M, φ, hφ, hlin, h, hhlin⟩ := wc_gmodel_linear_of_projective_head ℓ PUnit.{u+1} _ _
    hlamD (wcCxJFrob K hP I.cocomplex) hFr T hTproj
  refine ⟨M, ?_, ?_⟩
  ·
    let c := (InjectiveResolution.homotopyEquiv I (injectiveResolution L)).hom
    have hqc : QuasiIso (((preadditiveCoyoneda.obj (Opposite.op
        (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex
          (ComplexShape.up ℕ)).map c) :=
      ((preadditiveCoyoneda.obj (Opposite.op
        (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)))).mapHomotopyEquiv
        (InjectiveResolution.homotopyEquiv I (injectiveResolution L))).quasiIso_hom
    have hnat : ((preadditiveCoyoneda.obj (Opposite.op
        (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex
          (ComplexShape.up ℕ)).map c ≫ wcCxFrob K hP L =
        wcCxJFrob K hP I.cocomplex ≫ ((preadditiveCoyoneda.obj (Opposite.op
        (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex
          (ComplexShape.up ℕ)).map c :=
      NatTrans.mapHomologicalComplex_naturality _ _
    haveI := hφ
    haveI := hqc
    let Ec := ((preadditiveCoyoneda.obj (Opposite.op
        (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex
          (ComplexShape.up ℕ)).map c
    have e1 : (φ ≫ Ec) ≫ wcCxFrob K hP L = (φ ≫ wcCxJFrob K hP I.cocomplex) ≫ Ec :=
      (Category.assoc φ Ec (wcCxFrob K hP L)).trans
        ((congrArg (fun g => φ ≫ g) hnat).trans
          (Category.assoc φ (wcCxJFrob K hP I.cocomplex) Ec).symm)
    have e2 : (wcGModelFrob M ≫ φ) ≫ Ec = wcGModelFrob M ≫ φ ≫ Ec := by
      simp only [Category.assoc]
    exact ⟨φ ≫ Ec, quasiIso_comp (hφ := hφ) (hφ' := hqc) _ _,
      ⟨(Homotopy.ofEq e1).trans ((h.compRight Ec).trans (Homotopy.ofEq e2))⟩⟩
  · intro n hn
    obtain ⟨η, hη⟩ := hJres n hn
    obtain ⟨Q', hQ'⟩ := wcU_twist_exists ℓ n (1 : PUnit.{u+1} →* GL (Fin 1) (ZMod (ℓ ^ n))) M
    have hLN : Mono ((ℓ ^ n : ℕ) • 𝟙 L) := by
      obtain ⟨w, hw⟩ := hsesN n hn
      exact hw.mono_f
    obtain ⟨Ψ', hΨ', hF'⟩ := wcU_lm_bockstein_model K hP ℓ L _ hlamR I lamI hI n hn hLN M φ hφ
      hlin h hhlin Q' hQ'
    exact ⟨_, η, hη, Q', hQ', Ψ', hΨ', hF'⟩

theorem wcU_lattice_model_trace (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (h0 : ∀ y : wcCohG K (wcP1Over K) hP G 0, y = 0)
    (h2 : ∀ y : wcCohG K (wcP1Over K) hP G 2, y = 0)
    (r₁ : ℕ) (e₁ : wcCohG K (wcP1Over K) hP G 1 ≃+ (Fin r₁ → ℚ_[ℓ]))
    (he₁ : ∀ (c : ℚ_[ℓ]) (y : wcCohG K (wcP1Over K) hP G 1),
      e₁ (wcCohGEnd K (wcP1Over K) hP G 1 (σ c) y) = c • e₁ y)
    (L : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (ι : L ⟶ G) (lam : ℤ_[ℓ] → (L ⟶ L)) (hl1 : lam 1 = 𝟙 L)
    (hladd : ∀ a b : ℤ_[ℓ], lam (a + b) = lam a + lam b)
    (hlmul : ∀ a b : ℤ_[ℓ], lam (a * b) = lam b ≫ lam a)
    (hlι : ∀ a : ℤ_[ℓ], lam a ≫ ι = ι ≫ σ (a : ℚ_[ℓ]))
    (hι : Mono ι) (hT : wcCokerTorsion K hP ℓ ι)
    (e : ℕ) (he : 1 ≤ e) (t : ℤ_[ℓ])
    (ht : (t : ℚ_[ℓ]) = ((wcAddEquivMatrix e₁ (wcCohGFrob K (wcP1Over K) hP G 1)) ^ e).trace)
    (M : wcGModel ℓ PUnit.{u+1}) (Ψ : wcGModelAb M ⟶ wcCx K hP L) (hΨ : QuasiIso Ψ)
    (hFr : Nonempty (Homotopy (Ψ ≫ wcCxFrob K hP L) (wcGModelFrob M ≫ Ψ))) :
    wcGModelHS M e PUnit.unit = -t :=
by
  classical
  have hp : (ℓ : ℚ_[ℓ]) ≠ 0 := by
    exact_mod_cast (Fact.out : ℓ.Prime).ne_zero
  have hpk : ∀ k : ℕ, ((ℓ : ℚ_[ℓ]) ^ k) ≠ 0 := fun k => pow_ne_zero k hp
  have hcompH : ∀ {A B C : AddCommGrpCat.{u+1}} (f : A ⟶ B) (g : B ⟶ C) (x : A),
      (f ≫ g).hom x = g.hom (f.hom x) := fun f g x => rfl
  have hidH : ∀ {A : AddCommGrpCat.{u+1}} (x : A), (𝟙 A : A ⟶ A).hom x = x := fun x => rfl



  have c1 : ∀ {H : Type (u+1)} [AddCommGroup H] {r₁ r₂ : ℕ} (ι₁ : H →+ (Fin r₁ → ℚ_[ℓ]))
      (ι₂ : H →+ (Fin r₂ → ℚ_[ℓ])), wcRatCoord ℓ ι₁ →
      (∀ x, ι₂ x = 0 ↔ ∃ k : ℕ, (ℓ ^ k : ℕ) • x = 0) →
      (∀ v : Fin r₂ → ℚ_[ℓ], ∃ (k : ℕ) (x : H), ((ℓ : ℚ_[ℓ]) ^ k) • v = ι₂ x) →
      (∀ (x : H) (a : ℤ_[ℓ]), ∃ y, ι₂ y = ((a : ℚ_[ℓ])) • ι₂ x) →
      ∀ (T : H →+ H) (A₁ : Matrix (Fin r₁) (Fin r₁) ℚ_[ℓ]) (A₂ : Matrix (Fin r₂) (Fin r₂) ℚ_[ℓ]),
      (∀ x, ι₁ (T x) = A₁.mulVec (ι₁ x)) → (∀ x, ι₂ (T x) = A₂.mulVec (ι₂ x)) →
      A₁.trace = A₂.trace := by
    intro H _ r₁ r₂ ι₁ ι₂ h₁ h₂a h₂b h₂c T A₁ A₂ hA₁ hA₂
    obtain ⟨h1a, h1b, h1c, h1d⟩ := h₁
    have hns1 : ∀ (k : ℕ) (x : H), ι₁ ((ℓ ^ k : ℕ) • x) = ((ℓ : ℚ_[ℓ]) ^ k) • ι₁ x := by
      intro k x
      rw [map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], Nat.cast_pow]
    have hns2 : ∀ (k : ℕ) (x : H), ι₂ ((ℓ ^ k : ℕ) • x) = ((ℓ : ℚ_[ℓ]) ^ k) • ι₂ x := by
      intro k x
      rw [map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], Nat.cast_pow]
    have hK : ∀ x, ι₁ x = 0 ↔ ι₂ x = 0 := fun x => (h1a x).trans (h₂a x).symm

    have h2d : ∀ x, (∀ k : ℕ, ∃ y, ι₂ x = ((ℓ : ℚ_[ℓ]) ^ k) • ι₂ y) → ι₂ x = 0 := by
      intro x hx
      rw [← hK]
      apply h1d x
      intro k
      obtain ⟨y, hy⟩ := hx k
      refine ⟨y, ?_⟩
      have h0 : ι₂ (x - (ℓ ^ k : ℕ) • y) = 0 := by rw [map_sub, hns2, hy, sub_self]
      rw [← hK, map_sub, hns1, sub_eq_zero] at h0
      exact h0

    have hcompat : ∀ (x y : H) (a : ℤ_[ℓ]), ι₁ y = (a : ℚ_[ℓ]) • ι₁ x →
        ι₂ y = (a : ℚ_[ℓ]) • ι₂ x := by
      intro x y a hy
      obtain ⟨y₂, hy₂⟩ := h₂c x a
      have hd : ι₂ (y - y₂) = 0 := by
        apply h2d
        intro N
        obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp (PadicInt.appr_spec N a)
        have hau : (a : ℚ_[ℓ]) = ((a.appr N : ℕ) : ℚ_[ℓ]) + (u : ℚ_[ℓ]) * (ℓ : ℚ_[ℓ]) ^ N := by
          have h' := congrArg (fun z : ℤ_[ℓ] => (z : ℚ_[ℓ])) hu
          simp only [PadicInt.coe_mul, PadicInt.coe_sub, PadicInt.coe_pow,
            PadicInt.coe_natCast] at h'
          linear_combination -h'
        obtain ⟨z₁, hz₁⟩ := h1c x u
        obtain ⟨z₂, hz₂⟩ := h₂c x u
        refine ⟨z₁ - z₂, ?_⟩
        have e1 : ι₁ (y - (a.appr N) • x - (ℓ ^ N : ℕ) • z₁) = 0 := by
          rw [map_sub, map_sub, map_nsmul, hns1, hy, hz₁, hau, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ]]
          module
        rw [hK, map_sub, map_sub, map_nsmul, hns2, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ]] at e1
        have hy2 : ι₂ y = ((a.appr N : ℕ) : ℚ_[ℓ]) • ι₂ x + ((ℓ : ℚ_[ℓ]) ^ N) • ι₂ z₁ := by
          rw [← sub_eq_zero, ← e1]; abel
        rw [map_sub, map_sub, hy2, hy₂, hz₂, hau]
        module
      rw [map_sub, sub_eq_zero] at hd
      rw [hd, hy₂]

    choose kf xf hkf using h1b
    let φ : (Fin r₁ → ℚ_[ℓ]) → (Fin r₂ → ℚ_[ℓ]) := fun v =>
      (((ℓ : ℚ_[ℓ]) ^ kf v)⁻¹) • ι₂ (xf v)
    have hW : ∀ v (k : ℕ) (x : H), ((ℓ : ℚ_[ℓ]) ^ k) • v = ι₁ x →
        ((ℓ : ℚ_[ℓ]) ^ k) • φ v = ι₂ x := by
      intro v k x hx
      have h0 : ι₁ ((ℓ ^ k : ℕ) • xf v - (ℓ ^ kf v : ℕ) • x) = 0 := by
        rw [map_sub, hns1, hns1, ← hkf v, ← hx, smul_smul, smul_smul, mul_comm, sub_self]
      rw [hK, map_sub, hns2, hns2, sub_eq_zero] at h0
      show ((ℓ : ℚ_[ℓ]) ^ k) • (((ℓ : ℚ_[ℓ]) ^ kf v)⁻¹) • ι₂ (xf v) = ι₂ x
      rw [smul_comm, h0, inv_smul_smul₀ (hpk _)]
    have hcanc : ∀ (k : ℕ) (v w : Fin r₂ → ℚ_[ℓ]),
        ((ℓ : ℚ_[ℓ]) ^ k) • v = ((ℓ : ℚ_[ℓ]) ^ k) • w → v = w :=
      fun k v w h => smul_right_injective _ (hpk k) h
    have hadd : ∀ v w, φ (v + w) = φ v + φ w := by
      intro v w
      apply hcanc (kf v + kf w)
      rw [hW (v + w) (kf v + kf w) ((ℓ ^ kf w : ℕ) • xf v + (ℓ ^ kf v : ℕ) • xf w)]
      · rw [map_add, hns2, hns2, ← hW v _ _ (hkf v), ← hW w _ _ (hkf w)]
        module
      · rw [map_add, hns1, hns1, ← hkf v, ← hkf w]
        module
    have hsmulZ : ∀ (a : ℤ_[ℓ]) v, φ ((a : ℚ_[ℓ]) • v) = (a : ℚ_[ℓ]) • φ v := by
      intro a v
      obtain ⟨y, hy⟩ := h1c (xf v) a
      apply hcanc (kf v)
      rw [hW ((a : ℚ_[ℓ]) • v) (kf v) y, hcompat (xf v) y a hy, ← hW v _ _ (hkf v), smul_comm]
      rw [hy, ← hkf v, smul_comm]
    have hsmul : ∀ (c : ℚ_[ℓ]) v, φ (c • v) = c • φ v := by
      intro c v
      obtain ⟨a, b, hb, hab⟩ := IsFractionRing.div_surjective (A := ℤ_[ℓ]) c
      have hb0 : b ≠ 0 := nonZeroDivisors.ne_zero hb
      have hbq : (b : ℚ_[ℓ]) ≠ 0 := fun h => hb0 (PadicInt.ext (h.trans PadicInt.coe_zero.symm))
      have hcb : c * (b : ℚ_[ℓ]) = (a : ℚ_[ℓ]) := by
        rw [← hab]
        change (a : ℚ_[ℓ]) / (b : ℚ_[ℓ]) * (b : ℚ_[ℓ]) = (a : ℚ_[ℓ])
        field_simp
      apply smul_right_injective _ hbq
      show (b : ℚ_[ℓ]) • φ (c • v) = (b : ℚ_[ℓ]) • c • φ v
      rw [← hsmulZ, smul_smul, smul_smul, mul_comm, hcb, hsmulZ]
    let φL : (Fin r₁ → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r₂ → ℚ_[ℓ]) :=
      { toFun := φ
        map_add' := hadd
        map_smul' := hsmul }
    have hinj : Function.Injective φL := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro v hv
      have h1 := hW v _ _ (hkf v)
      change φ v = 0 at hv
      rw [hv, smul_zero, eq_comm, ← hK, ← hkf v] at h1
      exact (smul_eq_zero.mp h1).resolve_left (hpk _)
    have hsurj : Function.Surjective φL := by
      intro w
      obtain ⟨k, x, hx⟩ := h₂b w
      refine ⟨(((ℓ : ℚ_[ℓ]) ^ k)⁻¹) • ι₁ x, ?_⟩
      apply hcanc k
      change ((ℓ : ℚ_[ℓ]) ^ k) • φ _ = _
      rw [hW _ k x (smul_inv_smul₀ (hpk k) _), hx]
    let φE := LinearEquiv.ofBijective φL ⟨hinj, hsurj⟩
    have hint : ∀ v, φ (A₁.mulVec v) = A₂.mulVec (φ v) := by
      intro v
      apply hcanc (kf v)
      rw [hW (A₁.mulVec v) (kf v) (T (xf v))]
      · rw [hA₂, ← hW v _ _ (hkf v), Matrix.mulVec_smul]
      · rw [hA₁, ← hkf v, Matrix.mulVec_smul]
    have hconj : Matrix.toLin' A₂ = φE.conj (Matrix.toLin' A₁) := by
      apply LinearMap.ext
      intro w
      rw [LinearEquiv.conj_apply]
      obtain ⟨v, rfl⟩ := φE.surjective w
      simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply,
        Matrix.toLin'_apply]
      exact (hint v).symm
    rw [← Matrix.trace_toLin'_eq A₂, hconj, LinearMap.trace_conj', Matrix.trace_toLin'_eq]



  have c2 : ∀ {H : Type (u+1)} [AddCommGroup H] {r : ℕ} (ιc : H →+ (Fin r → ℚ_[ℓ])),
      wcRatCoord ℓ ιc → (∀ x : H, ∃ k : ℕ, (ℓ ^ k : ℕ) • x = 0) →
      ∀ (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]), A.trace = 0 := by
    intro H _ r ιc hιc htor A
    have hr : r = 0 := by
      by_contra hr
      obtain ⟨j⟩ : Nonempty (Fin r) := ⟨⟨0, Nat.pos_of_ne_zero hr⟩⟩
      obtain ⟨k, x, hx⟩ := hιc.2.1 (Pi.single j 1)
      have h0 : ιc x = 0 := (hιc.1 x).mpr (htor x)
      rw [h0] at hx
      have h1 := (smul_eq_zero.mp hx).resolve_left (pow_ne_zero k hp)
      have h2 := congrFun h1 j
      simp at h2
    subst hr
    simp [Matrix.trace]



  have h1u : (MonoidAlgebra.single (PUnit.unit⁻¹ : PUnit.{u+1}) (1 : ℤ_[ℓ])) = 1 :=
    MonoidAlgebra.one_def.symm
  have hAct : wcGModelAct M PUnit.unit = 𝟙 (wcGModelAb M) := by
    have hv : ∀ i (v : wcIdemSub (M.ε i)),
        wcSmulHom (MonoidAlgebra.single (PUnit.unit⁻¹ : PUnit.{u+1}) (1 : ℤ_[ℓ])) (M.ε i) v = v := by
      intro i v
      apply Subtype.ext
      show (MonoidAlgebra.single (PUnit.unit⁻¹ : PUnit.{u+1}) (1 : ℤ_[ℓ])) •
        (v : Fin (M.k i) → MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) = v
      rw [h1u, one_smul]
    refine HomologicalComplex.hom_ext _ _ (fun i => ?_)
    refine AddCommGrpCat.ext (fun x => ?_)
    apply ULift.ext
    exact hv i (ULift.down x)
  have hHT : wcGModelTr M e PUnit.unit = wcGModelHS M e PUnit.unit := by
    unfold wcGModelTr wcGModelHS
    refine Finset.sum_congr rfl (fun i _ => ?_)
    congr 1
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Fintype.sum_unique]
    have h11 : MonoidAlgebra.single (PUnit.unit⁻¹ : PUnit.{u+1}) (1 : ℤ_[ℓ]) *
        MonoidAlgebra.single (default : PUnit.{u+1}) (1 : ℤ_[ℓ]) = 1 := by
      rw [MonoidAlgebra.single_mul_single, one_mul]
      rw [mul_one]
      exact h1u
    rw [h11, one_mul]



  obtain ⟨r, ιh, Ah, hRC, hInt, hTr⟩ := wc_gmodel_hopf_coords ℓ PUnit.{u+1} M e he PUnit.unit



  have c5 : ∀ i : ℕ, ∃ κ : (wcGModelAb M).homology i ≃+ wcCohG K (wcP1Over K) hP L i,
      ∀ (n : ℕ) (x : (wcGModelAb M).homology i),
        κ ((HomologicalComplex.homologyMap (wcCxIter (wcGModelFrob M) n) i).hom x) =
          (⇑(wcCohGFrob K (wcP1Over K) hP L i))^[n] (κ x) := by
    intro i
    obtain ⟨θ, hθ⟩ := wc_cx_homology_cohG K hP L i
    haveI : IsIso (HomologicalComplex.homologyMap Ψ i) :=
      (quasiIsoAt_iff_isIso_homologyMap Ψ i).mp (QuasiIso.quasiIsoAt i)
    let η := (asIso (HomologicalComplex.homologyMap Ψ i)).addCommGroupIsoToAddEquiv
    have hstep : ∀ x, (HomologicalComplex.homologyMap (wcCxFrob K hP L) i).hom
        ((HomologicalComplex.homologyMap Ψ i).hom x) =
        (HomologicalComplex.homologyMap Ψ i).hom
          ((HomologicalComplex.homologyMap (wcGModelFrob M) i).hom x) := by
      intro x
      have h := Homotopy.homologyMap_eq hFr.some i
      rw [HomologicalComplex.homologyMap_comp, HomologicalComplex.homologyMap_comp] at h
      have h' := congrArg (fun f => f.hom x) h
      simpa only [hcompH] using h'
    have hiter : ∀ (n : ℕ) x, (HomologicalComplex.homologyMap Ψ i).hom
        ((HomologicalComplex.homologyMap (wcCxIter (wcGModelFrob M) n) i).hom x) =
        (HomologicalComplex.homologyMap (wcCxIter (wcCxFrob K hP L) n) i).hom
          ((HomologicalComplex.homologyMap Ψ i).hom x) := by
      intro n
      induction n with
      | zero =>
        intro x
        rw [wcCxIter.eq_1, wcCxIter.eq_1, HomologicalComplex.homologyMap_id,
          HomologicalComplex.homologyMap_id, hidH, hidH]
      | succ n ih =>
        intro x
        rw [wcCxIter.eq_2, wcCxIter.eq_2, HomologicalComplex.homologyMap_comp,
          HomologicalComplex.homologyMap_comp, hcompH, hcompH, ← hstep, ih]
    have hEnd : ∀ y, wcCohGEnd K (wcP1Over K) hP L i (𝟙 L) y = y := fun y =>
      Abelian.Ext.comp_mk₀_id y
    have hid : ∀ z, (HomologicalComplex.homologyMap (wcCxMap K hP (𝟙 L)) i).hom z = z := by
      intro z
      apply θ.injective
      have h := hθ (𝟙 L) 0 z
      rw [wcCxIter.eq_1, Category.comp_id, Function.iterate_zero, id_eq, hEnd] at h
      exact h
    have hFrL : ∀ (n : ℕ) z, θ ((HomologicalComplex.homologyMap
        (wcCxIter (wcCxFrob K hP L) n) i).hom z) =
        (⇑(wcCohGFrob K (wcP1Over K) hP L i))^[n] (θ z) := by
      intro n z
      have h := hθ (𝟙 L) n z
      rw [HomologicalComplex.homologyMap_comp, hcompH, hid, hEnd] at h
      exact h
    refine ⟨η.trans θ, fun n x => ?_⟩
    show θ ((HomologicalComplex.homologyMap Ψ i).hom
        ((HomologicalComplex.homologyMap (wcCxIter (wcGModelFrob M) n) i).hom x)) =
      (⇑(wcCohGFrob K (wcP1Over K) hP L i))^[n] (θ ((HomologicalComplex.homologyMap Ψ i).hom x))
    rw [hiter, hFrL]



  have hS : (ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) hι inferInstance
  have htrans : ∀ {n₀ n₁ : ℕ} (hn : n₀ + 1 = n₁)
      (x₃ : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
        (Limits.cokernel ι) n₀) (k : ℕ),
      (ℓ ^ k) • x₃ = 0 → (ℓ ^ k) • (x₃.comp hS.extClass hn) = 0 := by
    intro n₀ n₁ hn x₃ k hk
    have h := map_nsmul (hS.extClass.postcomp
      (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) hn) (ℓ ^ k) x₃
    rw [hk, map_zero] at h
    exact h.symm
  have hL0 : ∀ y : wcCohG K (wcP1Over K) hP L 0, y = 0 := by
    intro y
    rw [← Abelian.Ext.mk₀_addEquiv₀_apply y]
    have h1 : (Abelian.Ext.mk₀ (Abelian.Ext.addEquiv₀ y)).comp (Abelian.Ext.mk₀ ι) (add_zero 0)
        = 0 := h0 _
    rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_eq_zero_iff] at h1
    have h2 : Abelian.Ext.addEquiv₀ y = 0 := by
      rw [← cancel_mono ι, h1, Limits.zero_comp]
    rw [h2, Abelian.Ext.mk₀_zero]
  have hL2 : ∀ y : wcCohG K (wcP1Over K) hP L 2, ∃ k : ℕ, (ℓ ^ k) • y = 0 := by
    intro y
    have hy : y.comp (Abelian.Ext.mk₀ ι) (add_zero 2) = 0 := h2 _
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS y hy
      (show 1 + 1 = 2 from rfl)
    obtain ⟨k, hk⟩ := hT.2 x₃
    exact ⟨k, by rw [← hx₃]; exact htrans _ x₃ k hk⟩
  have hker : ∀ x : wcCohG K (wcP1Over K) hP L 1,
      x.comp (Abelian.Ext.mk₀ ι) (add_zero 1) = 0 → ∃ k : ℕ, (ℓ ^ k) • x = 0 := by
    intro x hx
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS x hx (zero_add 1)
    obtain ⟨k, hk⟩ := hT.1 x₃
    exact ⟨k, by rw [← hx₃]; exact htrans _ x₃ k hk⟩
  have hden : ∀ y : wcCohG K (wcP1Over K) hP G 1, ∃ (k : ℕ) (x : wcCohG K (wcP1Over K) hP L 1),
      x.comp (Abelian.Ext.mk₀ ι) (add_zero 1) = (ℓ ^ k) • y := by
    intro y
    obtain ⟨k, hk⟩ := hT.2 (y.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ι)) (add_zero 1))
    have h1 : ((ℓ ^ k) • y).comp (Abelian.Ext.mk₀ (Limits.cokernel.π ι)) (add_zero 1) = 0 := by
      have h := map_nsmul ((Abelian.Ext.mk₀ (Limits.cokernel.π ι)).postcomp
        (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) (add_zero 1)) (ℓ ^ k) y
      exact h.trans hk
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS ((ℓ ^ k) • y) h1
    exact ⟨k, x₁, hx₁⟩



  have hΦG : ∀ (c : ℚ_[ℓ]) (x : wcCohG K (wcP1Over K) hP G 1),
      wcCohGFrob K (wcP1Over K) hP G 1 (wcCohGEnd K (wcP1Over K) hP G 1 (σ c) x) =
        wcCohGEnd K (wcP1Over K) hP G 1 (σ c) (wcCohGFrob K (wcP1Over K) hP G 1 x) := by
    intro c x
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP))).comp
        (x.comp (Abelian.Ext.mk₀ (σ c)) (add_zero 1)) (zero_add 1) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP))).comp
        x (zero_add 1)).comp (Abelian.Ext.mk₀ (σ c)) (add_zero 1)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_zero 1) (by omega)).symm
  have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r₁ → ℚ_[ℓ]),
      e₁.symm (c • v) = wcCohGEnd K (wcP1Over K) hP G 1 (σ c) (e₁.symm v) := fun c v =>
    e₁.injective (by rw [he₁, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  let LA : (Fin r₁ → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r₁ → ℚ_[ℓ]) :=
    { toFun := fun v => e₁ (wcCohGFrob K (wcP1Over K) hP G 1 (e₁.symm v))
      map_add' := fun v w => by simp only [map_add]
      map_smul' := fun c v => by simp only [hes, hΦG, he₁, RingHom.id_apply] }
  have hA : wcAddEquivMatrix e₁ (wcCohGFrob K (wcP1Over K) hP G 1) = LinearMap.toMatrix' LA := by
    ext a b
    rw [LinearMap.toMatrix'_apply]
    rfl
  have hmat : ∀ (k : ℕ) (y : wcCohG K (wcP1Over K) hP G 1),
      e₁ ((⇑(wcCohGFrob K (wcP1Over K) hP G 1))^[k] y) =
        ((wcAddEquivMatrix e₁ (wcCohGFrob K (wcP1Over K) hP G 1)) ^ k).mulVec (e₁ y) := by
    intro k
    induction k with
    | zero => intro y; simp
    | succ k ih =>
      intro y
      rw [pow_succ', ← Matrix.mulVec_mulVec, ← ih, hA, LinearMap.toMatrix'_mulVec]
      show e₁ ((⇑(wcCohGFrob K (wcP1Over K) hP G 1))^[k+1] y) =
        e₁ (wcCohGFrob K (wcP1Over K) hP G 1
          (e₁.symm (e₁ ((⇑(wcCohGFrob K (wcP1Over K) hP G 1))^[k] y))))
      rw [AddEquiv.symm_apply_apply, Function.iterate_succ_apply']



  let ιs : wcCohG K (wcP1Over K) hP L 1 →+ wcCohG K (wcP1Over K) hP G 1 :=
    (Abelian.Ext.mk₀ ι).postcomp _ (add_zero 1)
  have hsemi : ∀ x, ιs (wcCohGFrob K (wcP1Over K) hP L 1 x) =
      wcCohGFrob K (wcP1Over K) hP G 1 (ιs x) := by
    intro x
    show ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP))).comp
        x (zero_add 1)).comp (Abelian.Ext.mk₀ ι) (add_zero 1) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP))).comp
        (x.comp (Abelian.Ext.mk₀ ι) (add_zero 1)) (zero_add 1)
    exact Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_zero 1) (by omega)
  have hsemik : ∀ (k : ℕ) x, ιs ((⇑(wcCohGFrob K (wcP1Over K) hP L 1))^[k] x) =
      (⇑(wcCohGFrob K (wcP1Over K) hP G 1))^[k] (ιs x) := by
    intro k
    induction k with
    | zero => intro x; rfl
    | succ k ih =>
      intro x
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', hsemi, ih]
  have hlamcomp : ∀ (x : wcCohG K (wcP1Over K) hP L 1) (a : ℤ_[ℓ]),
      ιs (x.comp (Abelian.Ext.mk₀ (lam a)) (add_zero 1)) =
        wcCohGEnd K (wcP1Over K) hP G 1 (σ (a : ℚ_[ℓ])) (ιs x) := by
    intro x a
    show (x.comp (Abelian.Ext.mk₀ (lam a)) (add_zero 1)).comp (Abelian.Ext.mk₀ ι) (add_zero 1) =
      (x.comp (Abelian.Ext.mk₀ ι) (add_zero 1)).comp (Abelian.Ext.mk₀ (σ (a : ℚ_[ℓ]))) (add_zero 1)
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (show 1 + 0 + 0 = 1 from rfl),
      Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (show 1 + 0 + 0 = 1 from rfl),
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hlι]



  obtain ⟨κ₀, -⟩ := c5 0
  obtain ⟨κ₁, hκ₁⟩ := c5 1
  obtain ⟨κ₂, -⟩ := c5 2
  have htor0 : ∀ x : (wcGModelAb M).homology 0, ∃ k : ℕ, (ℓ ^ k : ℕ) • x = 0 := by
    intro x
    refine ⟨0, ?_⟩
    have hx : x = 0 := κ₀.injective ((hL0 _).trans (map_zero κ₀).symm)
    rw [hx, smul_zero]
  have htor2 : ∀ x : (wcGModelAb M).homology 2, ∃ k : ℕ, (ℓ ^ k : ℕ) • x = 0 := by
    intro x
    obtain ⟨k, hk⟩ := hL2 (κ₂ x)
    refine ⟨k, κ₂.injective ?_⟩
    rw [map_nsmul, hk, map_zero]
  let j : (wcGModelAb M).homology 1 →+ (Fin r₁ → ℚ_[ℓ]) :=
    (e₁.toAddMonoidHom.comp ιs).comp κ₁.toAddMonoidHom
  have hj : ∀ x, j x = e₁ (ιs (κ₁ x)) := fun x => rfl
  have jRC1 : ∀ x, j x = 0 ↔ ∃ k : ℕ, (ℓ ^ k : ℕ) • x = 0 := by
    intro x
    constructor
    · intro hx
      rw [hj] at hx
      have h1 : ιs (κ₁ x) = 0 := e₁.injective (hx.trans (map_zero e₁).symm)
      obtain ⟨k, hk⟩ := hker (κ₁ x) h1
      exact ⟨k, κ₁.injective (by rw [map_nsmul, hk, map_zero])⟩
    · rintro ⟨k, hk⟩
      have h1 : (ℓ ^ k : ℕ) • j x = 0 := by rw [← map_nsmul, hk, map_zero]
      rw [← Nat.cast_smul_eq_nsmul ℚ_[ℓ], Nat.cast_pow] at h1
      exact (smul_eq_zero.mp h1).resolve_left (pow_ne_zero k hp)
  have jRC2 : ∀ v : Fin r₁ → ℚ_[ℓ], ∃ (k : ℕ) (x : (wcGModelAb M).homology 1),
      ((ℓ : ℚ_[ℓ]) ^ k) • v = j x := by
    intro v
    obtain ⟨k, x, hx⟩ := hden (e₁.symm v)
    refine ⟨k, κ₁.symm x, ?_⟩
    rw [hj, AddEquiv.apply_symm_apply]
    change ((ℓ : ℚ_[ℓ]) ^ k) • v = e₁ (x.comp (Abelian.Ext.mk₀ ι) (add_zero 1))
    rw [hx, map_nsmul, AddEquiv.apply_symm_apply, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], Nat.cast_pow]
  have jRC3 : ∀ (x : (wcGModelAb M).homology 1) (a : ℤ_[ℓ]), ∃ y, j y = (a : ℚ_[ℓ]) • j x := by
    intro x a
    refine ⟨κ₁.symm ((κ₁ x).comp (Abelian.Ext.mk₀ (lam a)) (add_zero 1)), ?_⟩
    rw [hj, hj, AddEquiv.apply_symm_apply, hlamcomp, he₁]
  have jT : ∀ x, j ((HomologicalComplex.homologyMap (wcCxIter (wcGModelFrob M) e) 1).hom x) =
      ((wcAddEquivMatrix e₁ (wcCohGFrob K (wcP1Over K) hP G 1)) ^ e).mulVec (j x) := by
    intro x
    rw [hj, hj, hκ₁, hsemik, hmat]
  have hInt1 := hInt 1 (by norm_num)
  rw [hAct, Category.id_comp] at hInt1
  have htr1 : (Ah 1).trace = (t : ℚ_[ℓ]) := by
    rw [ht]
    exact c1 (ιh 1) j (hRC 1 (by norm_num)) jRC1 jRC2 jRC3 _ (Ah 1) _ hInt1 jT
  have htr0 : (Ah 0).trace = 0 := c2 (ιh 0) (hRC 0 (by norm_num)) htor0 (Ah 0)
  have htr2 : (Ah 2).trace = 0 := c2 (ιh 2) (hRC 2 (by norm_num)) htor2 (Ah 2)
  rw [hHT] at hTr
  apply PadicInt.ext
  rw [PadicInt.coe_neg, hTr]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, htr0, htr1, htr2]
  ring

theorem wcU_classsum_transfer (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {Γ : Type u} [Group Γ] [Fintype Γ]
    (P P₀ : wcGModel ℓ Γ) (e : ℕ) (hTr : ∀ γ : Γ, wcGModelTr P e γ = wcGModelTr P₀ e γ)
    {Λ : Type*} [CommRing Λ] (red : ℤ_[ℓ] →+* Λ) (χ : Γ → Λ)
    (hχ : ∀ g h : Γ, χ (h * g * h⁻¹) = χ g) :
    ∑ g : Γ, red (wcGModelHS P e g) * χ g = ∑ g : Γ, red (wcGModelHS P₀ e g) * χ g :=
by
  classical

  have hunf : ∀ (Q : wcGModel ℓ Γ) (γ : Γ),
      wcGModelTr Q e γ = ∑ τ : Γ, wcGModelHS Q e (τ⁻¹ * γ * τ) := by
    intro Q γ
    have hc : ∀ (x : MonoidAlgebra ℤ_[ℓ] Γ) (τ : Γ),
        (MonoidAlgebra.single γ⁻¹ (1 : ℤ_[ℓ]) * MonoidAlgebra.single τ 1 * x).coeff τ =
          x.coeff (τ⁻¹ * γ * τ) := by
      intro x τ
      rw [MonoidAlgebra.single_mul_single, MonoidAlgebra.coeff_single_mul_apply, one_mul,
        one_mul]
      congr 1
      group
    simp only [wcGModelTr, wcGModelHS, hc, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Finset.sum_comm]
  obtain ⟨D, hDdef⟩ : ∃ D : Γ → ℤ_[ℓ], ∀ g, D g = wcGModelHS P e g - wcGModelHS P₀ e g :=
    ⟨_, fun _ => rfl⟩
  have hD : ∀ γ : Γ, ∑ τ : Γ, D (τ⁻¹ * γ * τ) = 0 := by
    intro γ
    simp only [hDdef, Finset.sum_sub_distrib]
    rw [← hunf P γ, ← hunf P₀ γ, hTr γ, sub_self]
  obtain ⟨cl, hmem⟩ : ∃ cl : Γ → Finset Γ, ∀ γ g, g ∈ cl γ ↔ ∃ τ, τ * γ * τ⁻¹ = g :=
    ⟨fun γ => Finset.univ.image (fun τ => τ * γ * τ⁻¹), fun γ g => by simp⟩

  have hS : ∀ γ, ∑ g ∈ cl γ, D g = 0 := by
    intro γ
    have h0 : ∑ τ : Γ, ∑ x ∈ cl γ, D (τ⁻¹ * x * τ) = 0 := by
      rw [Finset.sum_comm]
      exact Finset.sum_eq_zero (fun x _ => hD x)
    have hperm : ∀ τ : Γ, ∑ x ∈ cl γ, D (τ⁻¹ * x * τ) = ∑ g ∈ cl γ, D g := by
      intro τ
      apply Finset.sum_nbij' (fun x => τ⁻¹ * x * τ) (fun y => τ * y * τ⁻¹)
      · intro x hx
        obtain ⟨σ, rfl⟩ := (hmem γ x).mp hx
        exact (hmem γ _).mpr ⟨τ⁻¹ * σ, by group⟩
      · intro y hy
        obtain ⟨σ, rfl⟩ := (hmem γ y).mp hy
        exact (hmem γ _).mpr ⟨τ * σ, by group⟩
      · intro x _
        group
      · intro y _
        group
      · intro x _
        rfl
    simp only [hperm, Finset.sum_const, Finset.card_univ, nsmul_eq_mul] at h0
    have hc : (Fintype.card Γ : ℤ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr Fintype.card_ne_zero
    exact (mul_eq_zero.mp h0).resolve_left hc
  have hS' : ∀ γ, ∑ g ∈ cl γ, red (D g) = 0 := by
    intro γ
    rw [← map_sum, hS γ, map_zero]

  have hpair : ∑ g : Γ, red (D g) * χ g = 0 := by
    rw [← Finset.sum_fiberwise Finset.univ (fun g => ConjClasses.mk g)]
    refine Finset.sum_eq_zero (fun c _ => ?_)
    obtain ⟨γ₀, rfl⟩ := ConjClasses.mk_surjective c
    have key : ∀ s : Finset Γ, (∀ g, g ∈ s ↔ g ∈ cl γ₀) →
        ∑ g ∈ s, red (D g) * χ g = 0 := by
      intro s hs
      have hs' : s = cl γ₀ := Finset.ext hs
      subst hs'
      have h2 : ∑ g ∈ cl γ₀, red (D g) * χ g = ∑ g ∈ cl γ₀, red (D g) * χ γ₀ := by
        refine Finset.sum_congr rfl (fun g hg => ?_)
        obtain ⟨τ, rfl⟩ := (hmem γ₀ g).mp hg
        rw [hχ]
      rw [h2, ← Finset.sum_mul, hS' γ₀, zero_mul]
    apply key
    intro g
    rw [Finset.mem_filter, hmem, ConjClasses.mk_eq_mk_iff_isConj, isConj_comm, isConj_iff]
    simp
  rw [← sub_eq_zero, ← Finset.sum_sub_distrib]
  refine (Finset.sum_congr rfl (fun g _ => ?_)).trans hpair
  rw [hDdef, map_sub, sub_mul]

theorem wc_latticeU_H1_congruence (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G) (hlisse : wcLisseOffS K hP ℓ m S G σ)
    (h0 : ∀ y : wcCohG K (wcP1Over K) hP G 0, y = 0)
    (h2 : ∀ y : wcCohG K (wcP1Over K) hP G 2, y = 0)
    (r₁ : ℕ) (e₁ : wcCohG K (wcP1Over K) hP G 1 ≃+ (Fin r₁ → ℚ_[ℓ]))
    (he₁ : ∀ (c : ℚ_[ℓ]) (y : wcCohG K (wcP1Over K) hP G 1),
      e₁ (wcCohGEnd K (wcP1Over K) hP G 1 (σ c) y) = c • e₁ y)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    (e : ℕ) (he : 1 ≤ e)
    (r : ℕ) (V : ℕ → Scheme.{u}) (q' : (n : ℕ) → V n ⟶ Uo.toScheme) (Γ : ℕ → Type u)
    [∀ n, Group (Γ n)] (α : (n : ℕ) → Γ n →* Aut (V n))
    (ρ : (n : ℕ) → Γ n →* GL (Fin r) (ZMod (ℓ ^ n)))
    (hCOV : ∀ n, 1 ≤ n → wcGalCover (q' n) (Γ n) (α n))
    (hLT : wcLatticeTowerU K hP ℓ m S G σ Uo r V q' Γ α ρ)
    (t : ℤ_[ℓ])
    (ht : (t : ℚ_[ℓ]) = ((wcAddEquivMatrix e₁ (wcCohGFrob K (wcP1Over K) hP G 1)) ^ e).trace) :
    ∀ n, 1 ≤ n → ∀ (hα : ∀ γ, (α n γ).hom ≫ q' n ≫ Uo.ι = q' n ≫ Uo.ι) [Fintype (Γ n)]
        (P : wcGModel ℓ (Γ n)),
        wcIsModel K hP (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (q' n ≫ Uo.ι)
          (Γ n) (α n) hα P →
        PadicInt.toZModPow n (-t) =
          ∑ g : Γ n, PadicInt.toZModPow n (wcGModelHS P e g) *
            ((ρ n g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))).trace :=
by
  classical
  intro n hn hα _ P hPM
  obtain ⟨hα', L, ι, lam, π, τ, hD, hT⟩ := hLT
  obtain ⟨M, ⟨Ψ, hΨ, hFr⟩, hmod⟩ := wcU_lattice_mod_model K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul
    hzero hlisse Uo hUo r V q' Γ α ρ hCOV hα' L ι lam π τ hD hT
  have hHS : wcGModelHS M e PUnit.unit = -t :=
    wcU_lattice_model_trace K hP ℓ G σ hσ1 hσadd hσmul h0 h2 r₁ e₁ he₁ L ι lam hD.1.1
      hD.1.2.1 hD.1.2.2.1 hD.1.2.2.2 hD.2.1 hT e he t ht M Ψ hΨ hFr
  obtain ⟨J, η, hJ, Q', hQ', Ψ', hΨ', hF'⟩ := hmod n hn

  obtain ⟨lamF, hlamF, hlamFs, I, lamI, hI, P₀, φ, hφ, hlin, ⟨H, hHlin⟩, hM₀⟩ :=
    wcU_strict_linear_model_exists K hP ℓ hℓ m S hS Uo hUo (q' n) (Γ n) (α n) (hCOV n hn) hα
  obtain ⟨Q, hQ⟩ := wcU_twist_exists ℓ n (ρ n) P₀
  obtain ⟨ΨT, hΨT, hFT⟩ := wcU_strict_projection_formula K hP ℓ hℓ m S hS Uo hUo (q' n) (Γ n)
    (α n) (hCOV n hn) hα n hn r (ρ n) lamF hlamF hlamFs I lamI hI P₀ φ hφ hlin H hHlin Q hQ
    J η hJ
  have hW : ∀ i (x : (wcCxJ K hP J).X i), (ℓ ^ n) • x = 0 := by
    intro i x
    let y : wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) ⟶ J.X i := x
    have h1 := hJ.1 i
    have hy : (((ℓ ^ n : ℕ) : ℤ) • y) = 0 := by
      rw [← Category.comp_id y, ← Preadditive.comp_zsmul, h1, Limits.comp_zero]
    rw [natCast_zsmul] at hy
    exact hy
  obtain ⟨χ, χ', h1, h2, h3⟩ := wcU_lnmodel_htpy_equiv (ℓ ^ n) Q Q' (wcCxJ K hP J) hW
    (wcCxJFrob K hP J) ΨT Ψ' hΨT hΨ' hFT hF'
  have htr := wcU_lnmodel_trace_invariant (ℓ ^ n) Q Q' χ χ' h1 h2 h3 e he
  rw [wcU_twist_model_trace ℓ n (ρ n) P₀ Q hQ e, wcU_twist_model_trace ℓ n 1 M Q' hQ' e] at htr
  have hP₀ : PadicInt.toZModPow n (-t) =
      ∑ g : Γ n, PadicInt.toZModPow n (wcGModelHS P₀ e g) *
        ((ρ n g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))).trace := by
    rw [htr, Fintype.sum_unique]
    show _ = PadicInt.toZModPow n (wcGModelHS M e PUnit.unit) * _
    rw [hHS]
    simp

  have hTr : ∀ γ : Γ n, wcGModelTr P e γ = wcGModelTr P₀ e γ := by
    intro γ
    have e1 := wc_cover_lefschetz K hP ℓ hℓ m S hS Uo hUo (q' n) (Γ n) (α n) (hCOV n hn) hα P
      hPM e he γ
    have e2 := wc_cover_lefschetz K hP ℓ hℓ m S hS Uo hUo (q' n) (Γ n) (α n) (hCOV n hn) hα P₀
      hM₀ e he γ
    exact Subtype.val_injective (e1.trans e2.symm)
  have hχ : ∀ g h : Γ n, ((ρ n (h * g * h⁻¹) : GL (Fin r) (ZMod (ℓ ^ n))) :
      Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))).trace =
      ((ρ n g : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))).trace := by
    intro g h
    rw [map_mul, map_mul, map_inv, Units.val_mul, Units.val_mul, Matrix.trace_mul_comm,
      ← mul_assoc, Units.inv_mul, one_mul]
  have htrans := wcU_classsum_transfer ℓ P P₀ e hTr (PadicInt.toZModPow n)
    (fun g => ((ρ n g : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))).trace)
    hχ
  rw [hP₀]
  exact htrans.symm

theorem wc_lisse_tower_exists (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G) (hlisse : wcLisseOffS K hP ℓ m S G σ)
    (h0 : ∀ y : wcCohG K (wcP1Over K) hP G 0, y = 0)
    (h2 : ∀ y : wcCohG K (wcP1Over K) hP G 2, y = 0)
    (r₁ : ℕ) (e₁ : wcCohG K (wcP1Over K) hP G 1 ≃+ (Fin r₁ → ℚ_[ℓ]))
    (he₁ : ∀ (c : ℚ_[ℓ]) (y : wcCohG K (wcP1Over K) hP G 1),
      e₁ (wcCohGEnd K (wcP1Over K) hP G 1 (σ c) y) = c • e₁ y)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    (e : ℕ) (he : 1 ≤ e) :
    ∃ (r : ℕ) (V : ℕ → Scheme.{u}) (q' : (n : ℕ) → V n ⟶ Uo.toScheme) (Γ : ℕ → Type u)
      (_ : ∀ n, Group (Γ n)) (α : (n : ℕ) → Γ n →* Aut (V n))
      (ρ : (n : ℕ) → Γ n →* GL (Fin r) (ZMod (ℓ ^ n))) (t : ℤ_[ℓ]),
      (∀ n, 1 ≤ n → wcGalCover (q' n) (Γ n) (α n)) ∧
      ((t : ℚ_[ℓ]) = ((wcAddEquivMatrix e₁ (wcCohGFrob K (wcP1Over K) hP G 1)) ^ e).trace) ∧
      (∀ n, 1 ≤ n → ∀ (hα : ∀ γ, (α n γ).hom ≫ q' n ≫ Uo.ι = q' n ≫ Uo.ι) [Fintype (Γ n)]
        (P : wcGModel ℓ (Γ n)),
        wcIsModel K hP (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (q' n ≫ Uo.ι)
          (Γ n) (α n) hα P →
        PadicInt.toZModPow n (-t) =
          ∑ g : Γ n, PadicInt.toZModPow n (wcGModelHS P e g) *
            ((ρ n g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))).trace) ∧
      (∀ d : ℕ, ∀ x ∈ wcOffS K m S d, ∀ b : wcStalkBasis K ℓ G σ x d, ∀ k : ℕ,
        ∃ T : ℤ_[ℓ], (T : ℚ_[ℓ]) = (wcStalkMat b ^ k).trace) ∧
      (∀ n, 1 ≤ n → ∀ d ∈ e.divisors, ∀ x ∈ wcOffS K m S d, ∀ b : wcStalkBasis K ℓ G σ x d,
        ∀ (v : Spec (.of (AlgebraicClosure K)) ⟶ V n) (g : Γ n),
          v ≫ q' n ≫ Uo.ι ≫ (wcP1Over K).hom = wcKbarPt K →
          (v ≫ q' n ≫ Uo.ι) (IsLocalRing.closedPoint (AlgebraicClosure K)) = x →
          wcFrE K e ≫ v ≫ (α n g).hom = v →
          ∀ T : ℤ_[ℓ], (T : ℚ_[ℓ]) = (wcStalkMat b ^ (e / d)).trace →
            PadicInt.toZModPow n T = ((ρ n g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))).trace) :=
by
  obtain ⟨r, V, q', Γ, hgrp, α, ρ, hCOV, hα, L, ι, lam, π, τ, hD⟩ :=
    wc_latticeU_tower_construct K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero hlisse Uo hUo
  have hT : wcCokerTorsion K hP ℓ ι :=
    wc_lattice_coker_coh_torsion K hP ℓ m S hS G σ hσ1 hσadd hzero Uo hUo L ι hD.2.1 hD.2.2.1
  have hLT : wcLatticeTowerU K hP ℓ m S G σ Uo r V q' Γ α ρ :=
    ⟨hα, L, ι, lam, π, τ, hD, hT⟩
  obtain ⟨t, ht⟩ := wc_latticeU_trace_integral K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero hlisse
    h0 h2 r₁ e₁ he₁ Uo hUo e he r V q' Γ α ρ hCOV hLT
  obtain ⟨hINT, hST⟩ := wc_latticeU_stalk_traces K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero
    hlisse Uo hUo e he r V q' Γ α ρ hCOV hLT
  exact ⟨r, V, q', Γ, hgrp, α, ρ, t, hCOV, ht,
    wc_latticeU_H1_congruence K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero hlisse h0 h2 r₁ e₁ he₁
      Uo hUo e he r V q' Γ α ρ hCOV hLT t ht, hINT, hST⟩

theorem wc_P1_jshriek_trace_formula (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G) (hlisse : wcLisseOffS K hP ℓ m S G σ)
    (h0 : ∀ y : wcCohG K (wcP1Over K) hP G 0, y = 0)
    (h2 : ∀ y : wcCohG K (wcP1Over K) hP G 2, y = 0)
    (r₁ : ℕ) (e₁ : wcCohG K (wcP1Over K) hP G 1 ≃+ (Fin r₁ → ℚ_[ℓ]))
    (he₁ : ∀ (c : ℚ_[ℓ]) (y : wcCohG K (wcP1Over K) hP G 1),
      e₁ (wcCohGEnd K (wcP1Over K) hP G 1 (σ c) y) = c • e₁ y)
    (np : ℕ → ℕ) (pt : (d : ℕ) → Fin (np d) → (wcP1Over K).left)
    (hnp : ∀ d, np d = Nat.card (wcOffS K m S d))
    (hpt : ∀ d i, pt d i ∈ wcOffS K m S d) (hinj : ∀ d, Function.Injective (pt d)) :
    ∀ e : ℕ, 1 ≤ e →
      ∑ d ∈ e.divisors, ∑ i : Fin (np d),
          (d : AlgebraicClosure ℚ_[ℓ]) * ((wcStalkLoc K ℓ G σ (pt d i) d).map (· ^ (e / d))).sum =
        -(((wcAddEquivMatrix e₁ (wcCohGFrob K (wcP1Over K) hP G 1)).charpoly.aroots
            (AlgebraicClosure ℚ_[ℓ])).map (· ^ e)).sum :=
by
  classical
  intro e he
  obtain ⟨Uo, hUo⟩ := wc_P1_offS_open K m S hS
  obtain ⟨r, V, q', Γ, hgrp, α, ρ, t, hCOV, ht, hH1, hINT, hST⟩ :=
    wc_lisse_tower_exists K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero hlisse h0 h2 r₁ e₁ he₁
      Uo hUo e he
  have SB := wc_stalk_basis_exists K hP ℓ m S G σ hlisse
  obtain ⟨hfin, hdiv, hsum⟩ := wc_offS_fixed_points_regroup K m S hS np pt hnp hpt hinj e he

  have hdu : ∀ (x : (wcP1Over K).left) (d d' : ℕ), x ∈ wcOffS K m S d →
      x ∈ wcOffS K m S d' → d = d' := fun x d d' h h' => h.2.1.2.symm.trans h'.2.1.2
  let Tof : (wcP1Over K).left → ℤ_[ℓ] := fun x =>
    if h : ∃ d, d ∈ e.divisors ∧ x ∈ wcOffS K m S d then
      Classical.choose (hINT h.choose x h.choose_spec.2 (SB h.choose x h.choose_spec.2).some
        (e / h.choose))
    else 0
  have hTof : ∀ d ∈ e.divisors, ∀ x (hx : x ∈ wcOffS K m S d),
      (Tof x : ℚ_[ℓ]) = (wcStalkMat (SB d x hx).some ^ (e / d)).trace := by
    intro d hd x hx
    have hex : ∃ d, d ∈ e.divisors ∧ x ∈ wcOffS K m S d := ⟨d, hd, hx⟩
    have key : ∀ (d' : ℕ) (hd' : d' ∈ e.divisors ∧ x ∈ wcOffS K m S d'), d' = d →
        ((Classical.choose (hINT d' x hd'.2 (SB d' x hd'.2).some (e / d')) : ℤ_[ℓ]) : ℚ_[ℓ]) =
          (wcStalkMat (SB d x hx).some ^ (e / d)).trace := by
      intro d' hd' hdd
      subst hdd
      exact Classical.choose_spec (hINT d' x hd'.2 (SB d' x hd'.2).some (e / d'))
    show ((if h : ∃ d, d ∈ e.divisors ∧ x ∈ wcOffS K m S d then
      Classical.choose (hINT h.choose x h.choose_spec.2 (SB h.choose x h.choose_spec.2).some
        (e / h.choose)) else 0 : ℤ_[ℓ]) : ℚ_[ℓ]) = _
    rw [dif_pos hex]
    exact key hex.choose hex.choose_spec (hdu x _ _ hex.choose_spec.2 hx)

  letI : Fintype ↥(wcFixedOffS K m S e) := hfin.fintype
  have hFrκ : wcFrE K e ≫ wcKbarPt K = wcKbarPt K := by
    rw [wcFrE, wcKbarPt, ← Spec.map_comp]
    congr 1
    ext x
    exact AlgEquiv.commutes _ x

  have hcong : ∀ n : ℕ, PadicInt.toZModPow n (-t) =
      PadicInt.toZModPow n (∑ b : ↥(wcFixedOffS K m S e),
        Tof (b.1 (IsLocalRing.closedPoint (AlgebraicClosure K)))) := by
    intro n
    rcases Nat.eq_zero_or_pos n with hn0 | hn
    · subst hn0
      haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
      exact Subsingleton.elim _ _
    have hG := hCOV n hn
    obtain ⟨hfinΓ, -, -, -, hα0, -⟩ := hCOV n hn
    letI : Fintype (Γ n) := Fintype.ofFinite _
    have hα : ∀ γ, (α n γ).hom ≫ q' n ≫ Uo.ι = q' n ≫ Uo.ι := fun γ => by
      rw [← Category.assoc, hα0 γ]
    obtain ⟨P, hPM⟩ := wc_cover_model_exists K hP ℓ hℓ m S hS Uo hUo (q' n) (Γ n) (α n) hG hα
    have hlef := wc_cover_lefschetz K hP ℓ hℓ m S hS Uo hUo (q' n) (Γ n) (α n) hG hα P hPM e he
    have hH1n := hH1 n hn hα P hPM
    obtain ⟨hGa, hGb⟩ := wc_galcover_points (q' n) (Γ n) (α n) hG
    have hcomp : ∀ a b : Γ n, (α n a).hom ≫ (α n b).hom = (α n (b * a)).hom := by
      intro a b
      rw [map_mul, Aut.Aut_mul_def]
      rfl
    have hone : (α n 1).hom = 𝟙 _ := by
      rw [map_one]
      rfl
    let Y := {y : Spec (.of (AlgebraicClosure K)) ⟶ V n //
      y ≫ q' n ≫ Uo.ι ≫ (wcP1Over K).hom = wcKbarPt K ∧
        ∃ g, wcFrE K e ≫ y ≫ (α n g).hom = y}
    let act : Γ n → Y → Y := fun g y => ⟨y.1 ≫ (α n g).hom, by
      refine ⟨?_, ?_⟩
      · have h' : (α n g).hom ≫ q' n ≫ Uo.ι ≫ (wcP1Over K).hom =
            q' n ≫ Uo.ι ≫ (wcP1Over K).hom := by rw [← Category.assoc, hα0 g]
        rw [Category.assoc, h']
        exact y.2.1
      · obtain ⟨g0, hg0⟩ := y.2.2
        refine ⟨g * g0 * g⁻¹, ?_⟩
        rw [← hcomp, ← hcomp]
        simp only [Category.assoc]
        rw [← Category.assoc (α n g).hom, hcomp, inv_mul_cancel, hone, Category.id_comp]
        rw [← Category.assoc (wcFrE K e), ← Category.assoc, Category.assoc (wcFrE K e), hg0]⟩
    let Φ : Y → Y := fun y => ⟨wcFrE K e ≫ y.1, by
      refine ⟨?_, ?_⟩
      · rw [Category.assoc, y.2.1, hFrκ]
      · obtain ⟨g0, hg0⟩ := y.2.2
        exact ⟨g0, by rw [Category.assoc, hg0]⟩⟩
    let B := ↥(wcFixedOffS K m S e)
    let π : Y → B := fun y => ⟨y.1 ≫ q' n ≫ Uo.ι, by
      refine ⟨?_, ?_, ?_⟩
      · rw [Category.assoc, Category.assoc]
        exact y.2.1
      · obtain ⟨g0, hg0⟩ := y.2.2
        conv_rhs => rw [← hg0]
        simp only [Category.assoc]
        rw [hα]
      · intro i hi
        have hmem : (y.1 ≫ q' n ≫ Uo.ι) (IsLocalRing.closedPoint (AlgebraicClosure K)) ∈ Uo := by
          have e1 : (y.1 ≫ q' n ≫ Uo.ι) (IsLocalRing.closedPoint (AlgebraicClosure K)) =
              Uo.ι ((y.1 ≫ q' n) (IsLocalRing.closedPoint (AlgebraicClosure K))) := by
            first | rfl | simp
          have h2 : Uo.ι ((y.1 ≫ q' n) (IsLocalRing.closedPoint (AlgebraicClosure K))) ∈
              Set.range Uo.ι := ⟨_, rfl⟩
          rw [Scheme.Opens.range_ι] at h2
          rw [e1]
          exact h2
        exact ((hUo _).mp hmem i) hi⟩
    have hact1 : ∀ y, act 1 y = y := fun y => Subtype.ext (by
      show y.1 ≫ (α n 1).hom = y.1
      rw [hone, Category.comp_id])
    have hactmul : ∀ g h y, act (g * h) y = act g (act h y) := fun g h y => Subtype.ext (by
      show y.1 ≫ (α n (g * h)).hom = (y.1 ≫ (α n h).hom) ≫ (α n g).hom
      rw [Category.assoc, hcomp])
    have hfree : ∀ g y, act g y = y → g = 1 := by
      intro g y hgy
      obtain ⟨γ, _, huniq⟩ := hGa (AlgebraicClosure K) y.1 y.1 rfl
      have h1 := huniq 1 (by show y.1 = y.1 ≫ (α n 1).hom; rw [hone, Category.comp_id])
      have h2 := huniq g (congrArg Subtype.val hgy).symm
      rw [h1, h2]
    have hΦ : ∀ g y, Φ (act g y) = act g (Φ y) := fun g y => Subtype.ext (by
      show wcFrE K e ≫ y.1 ≫ (α n g).hom = (wcFrE K e ≫ y.1) ≫ (α n g).hom
      rw [Category.assoc])
    have hfix : ∀ y, ∃ g, act g (Φ y) = y := by
      intro y
      obtain ⟨g0, hg0⟩ := y.2.2
      exact ⟨g0, Subtype.ext (by
        show (wcFrE K e ≫ y.1) ≫ (α n g0).hom = y.1
        rw [Category.assoc, hg0])⟩
    have hιmono : Mono Uo.ι := inferInstance
    have hπfib : ∀ y y', π y = π y' ↔ ∃ g, y' = act g y := by
      intro y y'
      constructor
      · intro h
        have h1 : (y.1 ≫ q' n) ≫ Uo.ι = (y'.1 ≫ q' n) ≫ Uo.ι := by
          simpa only [Category.assoc] using congrArg Subtype.val h
        have h2 := (cancel_mono Uo.ι).mp h1
        obtain ⟨γ, hγ, -⟩ := hGa (AlgebraicClosure K) y.1 y'.1
          (by simpa only [Category.assoc] using h2)
        exact ⟨γ, Subtype.ext hγ⟩
      · rintro ⟨g, rfl⟩
        apply Subtype.ext
        show y.1 ≫ q' n ≫ Uo.ι = (y.1 ≫ (α n g).hom) ≫ q' n ≫ Uo.ι
        rw [Category.assoc, hα]
    have hπ : Function.Surjective π := by
      intro b
      obtain ⟨u, hu1, hu2, hu3⟩ := b
      have hrange : Set.range u.base ⊆ Set.range Uo.ι.base := by
        rintro _ ⟨z, rfl⟩
        rw [Scheme.Opens.range_ι]
        have hz : z = IsLocalRing.closedPoint (AlgebraicClosure K) := Subsingleton.elim _ _
        apply (hUo _).mpr
        rw [hz]
        exact hu3
      let u' := IsOpenImmersion.lift Uo.ι u hrange
      have hu' : u' ≫ Uo.ι = u := IsOpenImmersion.lift_fac _ _ _
      obtain ⟨y0, hy0⟩ := hGb (AlgebraicClosure K) u'
      have hsame : (wcFrE K e ≫ y0) ≫ q' n = y0 ≫ q' n := by
        apply (cancel_mono Uo.ι).mp
        simp only [Category.assoc]
        rw [← Category.assoc y0, hy0, hu', hu2]
      obtain ⟨γ, hγ, -⟩ := hGa (AlgebraicClosure K) (wcFrE K e ≫ y0) y0 hsame
      refine ⟨⟨y0, ?_, γ, ?_⟩, ?_⟩
      · rw [← Category.assoc y0, hy0, ← Category.assoc, hu', hu1]
      · rw [← Category.assoc]; exact hγ.symm
      · apply Subtype.ext
        show y0 ≫ q' n ≫ Uo.ι = u
        rw [← Category.assoc, hy0, hu']
    haveI : Finite Y := by
      refine Finite.of_surjective (fun p : B × Γ n => act p.2 (Function.surjInv hπ p.1)) ?_
      intro y
      obtain ⟨g, hg⟩ := (hπfib (Function.surjInv hπ (π y)) y).mp
        (Function.surjInv_eq hπ (π y))
      exact ⟨(π y, g), hg.symm⟩
    letI : Fintype Y := Fintype.ofFinite Y

    have hTr : ∀ γ : Γ n, wcGModelTr P e γ = ∑ τ : Γ n, wcGModelHS P e (τ⁻¹ * γ * τ) := by
      intro γ
      have hc : ∀ (x : MonoidAlgebra ℤ_[ℓ] (Γ n)) (τ : Γ n),
          (MonoidAlgebra.single γ⁻¹ (1 : ℤ_[ℓ]) * MonoidAlgebra.single τ 1 * x).coeff τ =
            x.coeff (τ⁻¹ * γ * τ) := by
        intro x τ
        rw [MonoidAlgebra.single_mul_single, MonoidAlgebra.coeff_single_mul_apply, one_mul,
          one_mul]
        congr 1
        group
      simp only [wcGModelTr, wcGModelHS, hc, Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Finset.sum_comm]
    have hHyp : ∀ γ : Γ n, ∑ τ : Γ n, wcGModelHS P e (τ⁻¹ * γ * τ) =
        ((Finset.univ.filter (fun y => act γ (Φ y) = y)).card : ℤ_[ℓ]) := by
      intro γ
      rw [← hTr]
      have hcard : Nat.card {v : Spec (.of (AlgebraicClosure K)) ⟶ V n //
          v ≫ q' n ≫ Uo.ι ≫ (wcP1Over K).hom = wcKbarPt K ∧
          wcFrE K e ≫ v ≫ (α n γ).hom = v} =
          (Finset.univ.filter (fun y => act γ (Φ y) = y)).card := by
        rw [← Fintype.card_subtype, ← Nat.card_eq_fintype_card]
        apply Nat.card_congr
        exact
          { toFun := fun v => ⟨⟨v.1, v.2.1, γ, v.2.2⟩, Subtype.ext (by
              show (wcFrE K e ≫ v.1) ≫ (α n γ).hom = v.1
              rw [Category.assoc]; exact v.2.2)⟩
            invFun := fun y => ⟨y.1.1, y.1.2.1, by
              have := congrArg Subtype.val y.2
              change (wcFrE K e ≫ y.1.1) ≫ (α n γ).hom = y.1.1 at this
              rw [Category.assoc] at this
              exact this⟩
            left_inv := fun v => rfl
            right_inv := fun y => rfl }
      apply Subtype.val_injective
      change ((wcGModelTr P e γ : ℤ_[ℓ]) : ℚ_[ℓ]) =
        ((((Finset.univ.filter (fun y => act γ (Φ y) = y)).card : ℕ) : ℤ_[ℓ]) : ℚ_[ℓ])
      rw [hlef γ, PadicInt.coe_natCast, hcard]
    have hχ : ∀ g h : Γ n, ((ρ n (h * g * h⁻¹) : GL (Fin r) (ZMod (ℓ ^ n))) :
        Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))).trace =
        ((ρ n g : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))).trace := by
      intro g h
      rw [map_mul, map_mul, map_inv, Units.val_mul, Units.val_mul, Matrix.trace_mul_comm,
        ← mul_assoc, Units.inv_mul, one_mul]
    have hw : ∀ (y : Y) (g : Γ n), act g (Φ y) = y →
        PadicInt.toZModPow n (Tof ((π y).1 (IsLocalRing.closedPoint (AlgebraicClosure K)))) =
          ((ρ n g : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))).trace := by
      intro y g hyg
      obtain ⟨d, hd, hx⟩ := hdiv (π y).1 (π y).2
      have hfr : wcFrE K e ≫ y.1 ≫ (α n g).hom = y.1 := by
        have := congrArg Subtype.val hyg
        change (wcFrE K e ≫ y.1) ≫ (α n g).hom = y.1 at this
        rw [Category.assoc] at this
        exact this
      exact hST n hn d hd _ hx (SB d _ hx).some y.1 g y.2.1 rfl hfr _ (hTof d hd _ hx)
    have hreg := wc_hattori_free_class_regroup act hact1 hactmul hfree Φ hΦ hfix π hπ hπfib
      (wcGModelHS P e) hHyp (PadicInt.toZModPow n)
      (fun g => ((ρ n g : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))).trace)
      hχ (fun b => PadicInt.toZModPow n (Tof (b.1 (IsLocalRing.closedPoint (AlgebraicClosure K)))))
      hw
    rw [hH1n, hreg, map_sum]

  have hlim : -t = ∑ b : ↥(wcFixedOffS K m S e),
      Tof (b.1 (IsLocalRing.closedPoint (AlgebraicClosure K))) :=
    PadicInt.ext_of_toZModPow.mp hcong
  have hfs : ∑ᶠ u ∈ wcFixedOffS K m S e, Tof (u (IsLocalRing.closedPoint (AlgebraicClosure K))) =
      ∑ b : ↥(wcFixedOffS K m S e), Tof (b.1 (IsLocalRing.closedPoint (AlgebraicClosure K))) := by
    rw [← finsum_set_coe_eq_finsum_mem, finsum_eq_sum_of_fintype]

  let ι : ℤ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ] :=
    (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])).comp (PadicInt.Coe.ringHom (p := ℓ))
  have hloc : ∀ d ∈ e.divisors, ∀ i : Fin (np d),
      ((wcStalkLoc K ℓ G σ (pt d i) d).map (· ^ (e / d))).sum = ι (Tof (pt d i)) := by
    intro d hd i
    have hx := hpt d i
    have h1 : wcStalkLoc K ℓ G σ (pt d i) d =
        (wcStalkMat (SB d (pt d i) hx).some).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
      unfold wcStalkLoc
      rw [dif_pos (SB d (pt d i) hx)]
      rfl
    rw [h1, wc_aroots_pow_sum_trace, ← hTof d hd _ hx]
    rfl
  have hL : ∑ d ∈ e.divisors, ∑ i : Fin (np d),
      (d : AlgebraicClosure ℚ_[ℓ]) * ((wcStalkLoc K ℓ G σ (pt d i) d).map (· ^ (e / d))).sum =
      ι (∑ d ∈ e.divisors, ∑ i : Fin (np d), d • Tof (pt d i)) := by
    rw [map_sum]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    rw [map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hloc d hd i, map_nsmul, nsmul_eq_mul]
  rw [hL, ← hsum ℤ_[ℓ] Tof, hfs, ← hlim, wc_aroots_pow_sum_trace, ← ht, map_neg]
  rfl

theorem wc_ses_ext_charpoly_additive (X : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (P : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (Fr : P ⟶ P)
    (Sc : ShortComplex (Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}))
    (hSc : Sc.ShortExact)
    (s₁ : ℚ_[ℓ] → (Sc.X₁ ⟶ Sc.X₁)) (s₂ : ℚ_[ℓ] → (Sc.X₂ ⟶ Sc.X₂))
    (s₃ : ℚ_[ℓ] → (Sc.X₃ ⟶ Sc.X₃))
    (h₁₂ : ∀ c : ℚ_[ℓ], s₁ c ≫ Sc.f = Sc.f ≫ s₂ c)
    (h₂₃ : ∀ c : ℚ_[ℓ], s₂ c ≫ Sc.g = Sc.g ≫ s₃ c)
    (hs1 : s₁ 1 = 𝟙 _) (hsadd : ∀ a b : ℚ_[ℓ], s₁ (a + b) = s₁ a + s₁ b)
    (hsmul : ∀ a b : ℚ_[ℓ], s₁ (a * b) = s₁ b ≫ s₁ a)
    (h0 : ∀ y : Abelian.Ext P Sc.X₂ 0, y = 0) (h2 : ∀ y : Abelian.Ext P Sc.X₂ 2, y = 0)
    (h1Q : ∀ y : Abelian.Ext P Sc.X₃ 1, y = 0)
    (rQ : ℕ) (eQ : Abelian.Ext P Sc.X₃ 0 ≃+ (Fin rQ → ℚ_[ℓ]))
    (heQ : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext P Sc.X₃ 0),
      eQ ((Abelian.Ext.mk₀ (s₃ c)).postcomp P (add_zero 0) y) = c • eQ y)
    (r₂ : ℕ) (e₂ : Abelian.Ext P Sc.X₂ 1 ≃+ (Fin r₂ → ℚ_[ℓ]))
    (he₂ : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext P Sc.X₂ 1),
      e₂ ((Abelian.Ext.mk₀ (s₂ c)).postcomp P (add_zero 1) y) = c • e₂ y) :
    (∀ y : Abelian.Ext P Sc.X₁ 0, y = 0) ∧ (∀ y : Abelian.Ext P Sc.X₁ 2, y = 0) ∧
    ∃ (r : ℕ) (e' : Abelian.Ext P Sc.X₁ 1 ≃+ (Fin r → ℚ_[ℓ])),
      (∀ (c : ℚ_[ℓ]) (y : Abelian.Ext P Sc.X₁ 1),
        e' ((Abelian.Ext.mk₀ (s₁ c)).postcomp P (add_zero 1) y) = c • e' y) ∧
      (wcAddEquivMatrix e' ((Abelian.Ext.mk₀ Fr).precomp Sc.X₁ (zero_add 1))).charpoly.aroots
          (AlgebraicClosure ℚ_[ℓ]) =
        (wcAddEquivMatrix eQ ((Abelian.Ext.mk₀ Fr).precomp Sc.X₃ (zero_add 0))).charpoly.aroots
          (AlgebraicClosure ℚ_[ℓ]) +
        (wcAddEquivMatrix e₂ ((Abelian.Ext.mk₀ Fr).precomp Sc.X₂ (zero_add 1))).charpoly.aroots
          (AlgebraicClosure ℚ_[ℓ]) :=
by
  classical

  have hMdef : ∀ {V : Type (u+1)} [AddCommGroup V] {r : ℕ} (e : V ≃+ (Fin r → ℚ_[ℓ]))
      (Φ : V →+ V) (a b : Fin r),
      wcAddEquivMatrix e Φ a b = e (Φ (e.symm (Pi.single b 1))) a := by
    intros; rfl
  have s3 : ∀ {V₁ V₂ V₃ : Type (u+1)} [AddCommGroup V₁] [AddCommGroup V₂] [AddCommGroup V₃]
      {r₁ r₃ : ℕ} (e₁ : V₁ ≃+ (Fin r₁ → ℚ_[ℓ])) (e₂ : V₂ ≃+ (Fin (r₁ + r₃) → ℚ_[ℓ]))
      (e₃ : V₃ ≃+ (Fin r₃ → ℚ_[ℓ]))
      (Φ₁ : V₁ →+ V₁) (Φ₂ : V₂ →+ V₂) (Φ₃ : V₃ →+ V₃) (δ : V₁ →+ V₂) (p : V₂ →+ V₃)
      (hδΦ : ∀ x : V₁, δ (Φ₁ x) = Φ₂ (δ x)) (hpΦ : ∀ y : V₂, p (Φ₂ y) = Φ₃ (p y))
      (hδe : ∀ x : V₁, e₂ (δ x) = Fin.append (e₁ x) 0)
      (hpe : ∀ (y : V₂) (i : Fin r₃), e₂ y (Fin.natAdd r₁ i) = e₃ (p y) i),
      (wcAddEquivMatrix e₂ Φ₂).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) =
        (wcAddEquivMatrix e₁ Φ₁).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) +
        (wcAddEquivMatrix e₃ Φ₃).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    intro V₁ V₂ V₃ _ _ _ r₁ r₃ e₁ e₂ e₃ Φ₁ Φ₂ Φ₃ δ p hδΦ hpΦ hδe hpe
    have hsingL : ∀ j : Fin r₁, Fin.append (Pi.single j (1 : ℚ_[ℓ])) (0 : Fin r₃ → ℚ_[ℓ]) =
        Pi.single (Fin.castAdd r₃ j) 1 := by
      intro j
      funext m
      induction m using Fin.addCases with
      | left i =>
        rw [Fin.append_left]
        by_cases hij : i = j
        · subst hij; simp
        · rw [Pi.single_eq_of_ne hij, Pi.single_eq_of_ne
            (fun h => hij (by simpa [Fin.ext_iff] using h))]
      | right k =>
        rw [Fin.append_right, Pi.zero_apply, Pi.single_eq_of_ne]
        intro h
        have hj := j.isLt
        simp only [Fin.ext_iff, Fin.val_natAdd, Fin.val_castAdd] at h
        omega
    have hsingR : ∀ k i : Fin r₃,
        (Pi.single (Fin.natAdd r₁ k) (1 : ℚ_[ℓ]) : Fin (r₁ + r₃) → ℚ_[ℓ]) (Fin.natAdd r₁ i) =
          (Pi.single k (1 : ℚ_[ℓ]) : Fin r₃ → ℚ_[ℓ]) i := by
      intro k i
      by_cases hik : i = k
      · subst hik; simp
      · rw [Pi.single_eq_of_ne hik, Pi.single_eq_of_ne
          (fun h => hik (by simpa [Fin.ext_iff] using h))]
    have hcolL : ∀ j : Fin r₁, e₂.symm (Pi.single (Fin.castAdd r₃ j) 1) =
        δ (e₁.symm (Pi.single j 1)) := by
      intro j
      rw [AddEquiv.symm_apply_eq, hδe, AddEquiv.apply_symm_apply, hsingL]
    have hcolR : ∀ k : Fin r₃, p (e₂.symm (Pi.single (Fin.natAdd r₁ k) 1)) =
        e₃.symm (Pi.single k 1) := by
      intro k
      rw [AddEquiv.eq_symm_apply]
      funext i
      rw [← hpe, AddEquiv.apply_symm_apply, hsingR]
    have h11 : ∀ i j, wcAddEquivMatrix e₂ Φ₂ (Fin.castAdd r₃ i) (Fin.castAdd r₃ j) =
        wcAddEquivMatrix e₁ Φ₁ i j := by
      intro i j
      rw [hMdef, hMdef, hcolL, ← hδΦ, hδe, Fin.append_left]
    have h21 : ∀ (i : Fin r₃) (j : Fin r₁),
        wcAddEquivMatrix e₂ Φ₂ (Fin.natAdd r₁ i) (Fin.castAdd r₃ j) = 0 := by
      intro i j
      rw [hMdef, hcolL, ← hδΦ, hδe, Fin.append_right, Pi.zero_apply]
    have h22 : ∀ i k, wcAddEquivMatrix e₂ Φ₂ (Fin.natAdd r₁ i) (Fin.natAdd r₁ k) =
        wcAddEquivMatrix e₃ Φ₃ i k := by
      intro i k
      rw [hMdef, hMdef, hpe, hpΦ, hcolR]
    have hN : Matrix.reindex finSumFinEquiv.symm finSumFinEquiv.symm (wcAddEquivMatrix e₂ Φ₂) =
        Matrix.fromBlocks (wcAddEquivMatrix e₁ Φ₁)
          (Matrix.of fun i k => wcAddEquivMatrix e₂ Φ₂ (Fin.castAdd r₃ i) (Fin.natAdd r₁ k)) 0
          (wcAddEquivMatrix e₃ Φ₃) := by
      ext (i | i) (j | j)
      · simp only [Matrix.reindex_apply, Equiv.symm_symm, Matrix.submatrix_apply,
          finSumFinEquiv_apply_left, Matrix.fromBlocks_apply₁₁]
        exact h11 i j
      · simp only [Matrix.reindex_apply, Equiv.symm_symm, Matrix.submatrix_apply,
          finSumFinEquiv_apply_left, finSumFinEquiv_apply_right, Matrix.fromBlocks_apply₁₂,
          Matrix.of_apply]
      · simp only [Matrix.reindex_apply, Equiv.symm_symm, Matrix.submatrix_apply,
          finSumFinEquiv_apply_left, finSumFinEquiv_apply_right, Matrix.fromBlocks_apply₂₁,
          Matrix.zero_apply]
        exact h21 i j
      · simp only [Matrix.reindex_apply, Equiv.symm_symm, Matrix.submatrix_apply,
          finSumFinEquiv_apply_right, Matrix.fromBlocks_apply₂₂]
        exact h22 i j
    have hchar : (wcAddEquivMatrix e₂ Φ₂).charpoly =
        (wcAddEquivMatrix e₁ Φ₁).charpoly * (wcAddEquivMatrix e₃ Φ₃).charpoly := by
      rw [← Matrix.charpoly_reindex finSumFinEquiv.symm (wcAddEquivMatrix e₂ Φ₂), hN,
        Matrix.charpoly_fromBlocks_zero₂₁]
    rw [hchar, Polynomial.aroots_mul
      ((Matrix.charpoly_monic _).mul (Matrix.charpoly_monic _)).ne_zero]

  have s2 : ∀ {V₁ V₂ V₃ : Type (u+1)} [AddCommGroup V₁] [AddCommGroup V₂] [AddCommGroup V₃]
      (σ₁ : ℚ_[ℓ] → V₁ →+ V₁) (σ₂ : ℚ_[ℓ] → V₂ →+ V₂) (σ₃ : ℚ_[ℓ] → V₃ →+ V₃)
      (δ : V₁ →+ V₂) (p : V₂ →+ V₃) (hδ : Function.Injective δ)
      (hex : ∀ y : V₂, p y = 0 → ∃ x, δ x = y) (hpδ : ∀ x : V₁, p (δ x) = 0)
      (hp : Function.Surjective p)
      (hδσ : ∀ (c : ℚ_[ℓ]) (x : V₁), δ (σ₁ c x) = σ₂ c (δ x))
      (hpσ : ∀ (c : ℚ_[ℓ]) (y : V₂), p (σ₂ c y) = σ₃ c (p y))
      (hσadd : ∀ (a b : ℚ_[ℓ]) (y : V₂), σ₂ (a + b) y = σ₂ a y + σ₂ b y)
      (hσmul : ∀ (a b : ℚ_[ℓ]) (y : V₂), σ₂ (a * b) y = σ₂ a (σ₂ b y))
      (r₁ r₃ : ℕ) (e₁ : V₁ ≃+ (Fin r₁ → ℚ_[ℓ]))
      (he₁ : ∀ (c : ℚ_[ℓ]) (x : V₁), e₁ (σ₁ c x) = c • e₁ x)
      (e₃ : V₃ ≃+ (Fin r₃ → ℚ_[ℓ])) (he₃ : ∀ (c : ℚ_[ℓ]) (z : V₃), e₃ (σ₃ c z) = c • e₃ z),
      ∃ e₂ : V₂ ≃+ (Fin (r₁ + r₃) → ℚ_[ℓ]),
        (∀ (c : ℚ_[ℓ]) (y : V₂), e₂ (σ₂ c y) = c • e₂ y) ∧
        (∀ x : V₁, e₂ (δ x) = Fin.append (e₁ x) 0) ∧
        (∀ (y : V₂) (i : Fin r₃), e₂ y (Fin.natAdd r₁ i) = e₃ (p y) i) := by
    intro V₁ V₂ V₃ _ _ _ σ₁ σ₂ σ₃ δ p hδ hex hpδ hp hδσ hpσ hσadd hσmul r₁ r₃ e₁ he₁ e₃ he₃
    have hσ0 : ∀ y : V₂, σ₂ 0 y = 0 := by
      intro y
      have h := hσadd 0 0 y
      rw [add_zero] at h
      have h' : σ₂ 0 y + σ₂ 0 y = σ₂ 0 y + 0 := by rw [add_zero]; exact h.symm
      exact add_left_cancel h'
    have he₁s : ∀ (c : ℚ_[ℓ]) (w : Fin r₁ → ℚ_[ℓ]), e₁.symm (c • w) = σ₁ c (e₁.symm w) :=
      fun c w => e₁.injective (by rw [he₁, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    have he₃s : ∀ (c : ℚ_[ℓ]) (w : Fin r₃ → ℚ_[ℓ]), e₃.symm (c • w) = σ₃ c (e₃.symm w) :=
      fun c w => e₃.injective (by rw [he₃, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    choose t ht using fun k : Fin r₃ => hp (e₃.symm (Pi.single k 1))
    have hsum : ∀ b : Fin r₃ → ℚ_[ℓ], p (∑ k, σ₂ (b k) (t k)) = e₃.symm b := by
      intro b
      rw [map_sum]
      have h1 : ∀ k, p (σ₂ (b k) (t k)) = e₃.symm (b k • Pi.single k 1) := by
        intro k; rw [hpσ, ht, he₃s]
      rw [Finset.sum_congr rfl (fun k _ => h1 k), ← map_sum e₃.symm]
      congr 1
      funext i
      simp [Finset.sum_apply, Pi.single_apply]
    let θf : (Fin (r₁ + r₃) → ℚ_[ℓ]) → V₂ := fun v =>
      δ (e₁.symm (fun i => v (Fin.castAdd r₃ i))) + ∑ k, σ₂ (v (Fin.natAdd r₁ k)) (t k)
    have hpθ : ∀ v, p (θf v) = e₃.symm (fun k => v (Fin.natAdd r₁ k)) := by
      intro v
      show p (δ _ + _) = _
      rw [map_add, hpδ, zero_add, hsum]
    have θadd : ∀ v w, θf (v + w) = θf v + θf w := by
      intro v w
      have h1 : (fun i => (v + w) (Fin.castAdd r₃ i)) =
          (fun i => v (Fin.castAdd r₃ i)) + (fun i => w (Fin.castAdd r₃ i)) := rfl
      show δ (e₁.symm (fun i => (v + w) (Fin.castAdd r₃ i))) +
          ∑ k, σ₂ ((v + w) (Fin.natAdd r₁ k)) (t k) =
        (δ (e₁.symm (fun i => v (Fin.castAdd r₃ i))) + ∑ k, σ₂ (v (Fin.natAdd r₁ k)) (t k)) +
        (δ (e₁.symm (fun i => w (Fin.castAdd r₃ i))) + ∑ k, σ₂ (w (Fin.natAdd r₁ k)) (t k))
      rw [h1, map_add, map_add]
      simp only [Pi.add_apply, hσadd, Finset.sum_add_distrib]
      abel
    have θsmul : ∀ (c : ℚ_[ℓ]) v, θf (c • v) = σ₂ c (θf v) := by
      intro c v
      have h1 : (fun i => (c • v) (Fin.castAdd r₃ i)) = c • (fun i => v (Fin.castAdd r₃ i)) := rfl
      show δ (e₁.symm (fun i => (c • v) (Fin.castAdd r₃ i))) +
          ∑ k, σ₂ ((c • v) (Fin.natAdd r₁ k)) (t k) =
        σ₂ c (δ (e₁.symm (fun i => v (Fin.castAdd r₃ i))) + ∑ k, σ₂ (v (Fin.natAdd r₁ k)) (t k))
      rw [h1, he₁s, hδσ, map_add, map_sum]
      congr 1
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [Pi.smul_apply, smul_eq_mul, hσmul]
    have θinj : ∀ v, θf v = 0 → v = 0 := by
      intro v hv
      have hb : (fun k => v (Fin.natAdd r₁ k)) = 0 := by
        have h1 := hpθ v
        rw [hv, map_zero] at h1
        exact e₃.symm.injective (h1.symm.trans (map_zero e₃.symm).symm)
      have hb' : ∀ k, v (Fin.natAdd r₁ k) = 0 := fun k => congrFun hb k
      have ha : (fun i => v (Fin.castAdd r₃ i)) = 0 := by
        have hs : ∑ k, σ₂ (v (Fin.natAdd r₁ k)) (t k) = 0 :=
          Finset.sum_eq_zero (fun k _ => by rw [hb' k, hσ0])
        have h2 : θf v = δ (e₁.symm (fun i => v (Fin.castAdd r₃ i))) := by
          show _ + _ = _
          rw [hs, add_zero]
        rw [h2] at hv
        have h3 : e₁.symm (fun i => v (Fin.castAdd r₃ i)) = 0 := hδ (hv.trans (map_zero δ).symm)
        exact e₁.symm.injective (h3.trans (map_zero e₁.symm).symm)
      funext j
      induction j using Fin.addCases with
      | left i => exact congrFun ha i
      | right k => exact hb' k
    have θsurj : ∀ y, ∃ v, θf v = y := by
      intro y
      obtain ⟨x, hx⟩ := hex (y - ∑ k, σ₂ (e₃ (p y) k) (t k))
        (by rw [map_sub, hsum, AddEquiv.symm_apply_apply, sub_self])
      refine ⟨Fin.append (e₁ x) (e₃ (p y)), ?_⟩
      show δ (e₁.symm (fun i => Fin.append (e₁ x) (e₃ (p y)) (Fin.castAdd r₃ i))) +
        ∑ k, σ₂ (Fin.append (e₁ x) (e₃ (p y)) (Fin.natAdd r₁ k)) (t k) = y
      simp only [Fin.append_left, Fin.append_right]
      rw [show (fun i => e₁ x i) = e₁ x from rfl, AddEquiv.symm_apply_apply, hx]
      abel
    let θ : (Fin (r₁ + r₃) → ℚ_[ℓ]) →+ V₂ := AddMonoidHom.mk' θf θadd
    have hbij : Function.Bijective θ := by
      constructor
      · rw [injective_iff_map_eq_zero]
        intro v hv
        exact θinj v hv
      · intro y
        obtain ⟨v, hv⟩ := θsurj y
        exact ⟨v, hv⟩
    let E := AddEquiv.ofBijective θ hbij
    have hE : ∀ v, E v = θf v := fun v => rfl
    refine ⟨E.symm, ?_, ?_, ?_⟩
    · intro c y
      rw [AddEquiv.symm_apply_eq, hE, θsmul]
      congr 1
      rw [← hE, AddEquiv.apply_symm_apply]
    · intro x
      rw [AddEquiv.symm_apply_eq, hE]
      show δ x = δ (e₁.symm (fun i => Fin.append (e₁ x) 0 (Fin.castAdd r₃ i))) +
        ∑ k, σ₂ (Fin.append (e₁ x) (0 : Fin r₃ → ℚ_[ℓ]) (Fin.natAdd r₁ k)) (t k)
      simp only [Fin.append_left, Fin.append_right, Pi.zero_apply, hσ0, Finset.sum_const_zero,
        add_zero]
      rw [show (fun i => e₁ x i) = e₁ x from rfl, AddEquiv.symm_apply_apply]
    · intro y i
      have h1 := hpθ (E.symm y)
      rw [← hE, AddEquiv.apply_symm_apply] at h1
      rw [h1, AddEquiv.apply_symm_apply]

  have hpost : ∀ {Y Z : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}} {n a b : ℕ}
      (β : Abelian.Ext Y Z n) (h : a + n = b) (x : Abelian.Ext P Y a),
      β.postcomp P h x = x.comp β h := fun _ _ _ => rfl
  have hpre : ∀ {W Y Z : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}} {n a b : ℕ}
      (α : Abelian.Ext W Y n) (h : n + a = b) (x : Abelian.Ext Y Z a),
      α.precomp Z h x = α.comp x h := fun _ _ _ => rfl
  have hfm : Mono Sc.f := hSc.mono_f
  have hA : ∀ y : Abelian.Ext P Sc.X₁ 0, y = 0 := by
    intro y
    rw [← Abelian.Ext.mk₀_homEquiv₀_apply y]
    have h := h0 (Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ y ≫ Sc.f))
    rw [Abelian.Ext.mk₀_eq_zero_iff] at h
    have h' : Abelian.Ext.homEquiv₀ y = 0 :=
      (cancel_mono Sc.f).mp (h.trans Limits.zero_comp.symm)
    rw [h', Abelian.Ext.mk₀_zero]
  have hB : ∀ y : Abelian.Ext P Sc.X₁ 2, y = 0 := by
    intro x
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hSc x (h2 _)
      (show 1 + 1 = 2 from rfl)
    rw [← hx₃, h1Q x₃, Abelian.Ext.zero_comp]
  have hδinj : Function.Injective (hSc.extClass.postcomp P (zero_add 1)) := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    rw [hpost] at hx
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hSc x (zero_add 1) hx
    rw [← hx₂, h0 x₂, Abelian.Ext.zero_comp]
  have hex : ∀ y : Abelian.Ext P Sc.X₁ 1, (Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero 1) y = 0 →
      ∃ x, hSc.extClass.postcomp P (zero_add 1) x = y := by
    intro y hy
    rw [hpost] at hy
    obtain ⟨x, hx⟩ := Abelian.Ext.covariant_sequence_exact₁ P hSc y hy (zero_add 1)
    exact ⟨x, by rw [hpost]; exact hx⟩
  have hpδ : ∀ x : Abelian.Ext P Sc.X₃ 0, (Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero 1)
      (hSc.extClass.postcomp P (zero_add 1) x) = 0 := by
    intro x
    simp only [hpost]
    rw [Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_zero 1) (by omega), hSc.extClass_comp,
      Abelian.Ext.comp_zero]
  have hsurj : Function.Surjective ((Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero 1)) := by
    intro y
    obtain ⟨x, hx⟩ := Abelian.Ext.covariant_sequence_exact₂ P hSc y (h1Q _)
    exact ⟨x, by rw [hpost]; exact hx⟩
  have hδΦ : ∀ x : Abelian.Ext P Sc.X₃ 0, hSc.extClass.postcomp P (zero_add 1)
      ((Abelian.Ext.mk₀ Fr).precomp Sc.X₃ (zero_add 0) x) =
      (Abelian.Ext.mk₀ Fr).precomp Sc.X₁ (zero_add 1) (hSc.extClass.postcomp P (zero_add 1) x) := by
    intro x
    simp only [hpost, hpre]
    exact Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 1) (by omega)
  have hpΦ : ∀ y : Abelian.Ext P Sc.X₁ 1, (Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero 1)
      ((Abelian.Ext.mk₀ Fr).precomp Sc.X₁ (zero_add 1) y) =
      (Abelian.Ext.mk₀ Fr).precomp Sc.X₂ (zero_add 1)
        ((Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero 1) y) := by
    intro y
    simp only [hpost, hpre]
    exact Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_zero 1) (by omega)
  have hδσ : ∀ (c : ℚ_[ℓ]) (x : Abelian.Ext P Sc.X₃ 0),
      hSc.extClass.postcomp P (zero_add 1) ((Abelian.Ext.mk₀ (s₃ c)).postcomp P (add_zero 0) x) =
      (Abelian.Ext.mk₀ (s₁ c)).postcomp P (add_zero 1) (hSc.extClass.postcomp P (zero_add 1) x) := by
    intro c x
    simp only [hpost]
    have hnat : hSc.extClass.comp (Abelian.Ext.mk₀ (s₁ c)) (add_zero 1) =
        (Abelian.Ext.mk₀ (s₃ c)).comp hSc.extClass (zero_add 1) :=
      hSc.extClass_naturality hSc (ShortComplex.Hom.mk (s₁ c) (s₂ c) (s₃ c) (h₁₂ c) (h₂₃ c))
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_zero 1) (by omega), hnat]
  have hpσ : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext P Sc.X₁ 1),
      (Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero 1) ((Abelian.Ext.mk₀ (s₁ c)).postcomp P (add_zero 1) y) =
      (Abelian.Ext.mk₀ (s₂ c)).postcomp P (add_zero 1) ((Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero 1) y) := by
    intro c y
    simp only [hpost]
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, h₁₂]
  have hσadd : ∀ (a b : ℚ_[ℓ]) (y : Abelian.Ext P Sc.X₁ 1),
      (Abelian.Ext.mk₀ (s₁ (a + b))).postcomp P (add_zero 1) y =
      (Abelian.Ext.mk₀ (s₁ a)).postcomp P (add_zero 1) y +
        (Abelian.Ext.mk₀ (s₁ b)).postcomp P (add_zero 1) y := by
    intro a b y
    simp only [hpost]
    rw [hsadd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
  have hσmul : ∀ (a b : ℚ_[ℓ]) (y : Abelian.Ext P Sc.X₁ 1),
      (Abelian.Ext.mk₀ (s₁ (a * b))).postcomp P (add_zero 1) y =
      (Abelian.Ext.mk₀ (s₁ a)).postcomp P (add_zero 1)
        ((Abelian.Ext.mk₀ (s₁ b)).postcomp P (add_zero 1) y) := by
    intro a b y
    simp only [hpost]
    rw [hsmul, ← Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega)]

  obtain ⟨e', he's, hδe, hpe⟩ := s2
    (fun c => (Abelian.Ext.mk₀ (s₃ c)).postcomp P (add_zero 0))
    (fun c => (Abelian.Ext.mk₀ (s₁ c)).postcomp P (add_zero 1))
    (fun c => (Abelian.Ext.mk₀ (s₂ c)).postcomp P (add_zero 1))
    (hSc.extClass.postcomp P (zero_add 1)) ((Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero 1))
    hδinj hex hpδ hsurj hδσ hpσ hσadd hσmul rQ r₂ eQ heQ e₂ he₂
  refine ⟨hA, hB, rQ + r₂, e', fun c y => he's c y, ?_⟩
  exact s3 eQ e' e₂ ((Abelian.Ext.mk₀ Fr).precomp Sc.X₃ (zero_add 0))
    ((Abelian.Ext.mk₀ Fr).precomp Sc.X₁ (zero_add 1))
    ((Abelian.Ext.mk₀ Fr).precomp Sc.X₂ (zero_add 1))
    (hSc.extClass.postcomp P (zero_add 1)) ((Abelian.Ext.mk₀ Sc.f).postcomp P (add_zero 1))
    hδΦ hpΦ hδe hpe

theorem wc_pencil_VQ_P1_trace_formula (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n))
    (h0 : ∀ y : wcCohG F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 0, y = 0)
    (h2 : ∀ y : wcCohG F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 2, y = 0)
    (r₁ : ℕ) (e₁ : wcCohG F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 ≃+ (Fin r₁ → ℚ_[ℓ]))
    (he₁ : ∀ (c : ℚ_[ℓ]) (y : wcCohG F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1),
      e₁ (wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c) y) =
        c • e₁ y) :
    ∀ e : ℕ, 1 ≤ e →
      ∑ d ∈ e.divisors, ∑ i : Fin (wcPencilNp D d),
          (d : AlgebraicClosure ℚ_[ℓ]) * ((wcPencilLocIdx D ℓ hP d i).map (· ^ (e / d))).sum +
        ∑ j : Fin D.m,
          ((wcPencilLoc D ℓ hP (D.S j (IsLocalRing.closedPoint F'')) 1).map (· ^ e)).sum =
      -(((wcAddEquivMatrix e₁ (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1)).charpoly.aroots
          (AlgebraicClosure ℚ_[ℓ])).map (· ^ e)).sum :=
by
  classical
  intro e he

  obtain ⟨hzero, ψ, hψ, hψ1, hψadd, hψmul⟩ :=
    wc_pencil_KS_stable F' F'' Y n hn hn2 D ℓ hℓ hP hNI

  have hσQwd : ∀ c : ℚ_[ℓ], (wcPencilKS D ℓ hP).arrow ≫ (wcPencilVQScalar D ℓ hP c ≫
      Limits.cokernel.π (wcPencilKS D ℓ hP).arrow) = 0 := by
    intro c
    rw [← Category.assoc, ← hψ c, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  let σQ : ℚ_[ℓ] → (Limits.cokernel (wcPencilKS D ℓ hP).arrow ⟶
      Limits.cokernel (wcPencilKS D ℓ hP).arrow) := fun c =>
    Limits.cokernel.desc (wcPencilKS D ℓ hP).arrow
      (wcPencilVQScalar D ℓ hP c ≫ Limits.cokernel.π (wcPencilKS D ℓ hP).arrow) (hσQwd c)
  have hσQ : ∀ c : ℚ_[ℓ], Limits.cokernel.π (wcPencilKS D ℓ hP).arrow ≫ σQ c =
      wcPencilVQScalar D ℓ hP c ≫ Limits.cokernel.π (wcPencilKS D ℓ hP).arrow := fun c =>
    Limits.cokernel.π_desc _ _ _

  have hSc : (ShortComplex.mk (wcPencilKS D ℓ hP).arrow
      (Limits.cokernel.π (wcPencilKS D ℓ hP).arrow)
      (Limits.cokernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) inferInstance inferInstance

  obtain ⟨hQ1, rQ, eQ, heQ, hQroots⟩ :=
    wc_pencil_KS_quotient_punctual F' F'' Y n hn hn2 D ℓ hℓ hP hNI σQ hσQ

  obtain ⟨hK0, hK2, rK, eK, heK, hKroots⟩ :=
    wc_ses_ext_charpoly_additive (wcP1Over F'').left ℓ
      (wcFreeSheaf (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP))
      (wcFreeSheafMap (wcP1Over F'').left (wcGeomFrob F'' (wcP1Over F'') hP))
      (ShortComplex.mk (wcPencilKS D ℓ hP).arrow
        (Limits.cokernel.π (wcPencilKS D ℓ hP).arrow) (Limits.cokernel.condition _))
      hSc ψ (wcPencilVQScalar D ℓ hP) σQ hψ (fun c => (hσQ c).symm) hψ1 hψadd hψmul
      h0 h2 hQ1 rQ eQ heQ r₁ e₁ he₁
  have hKroots' : (wcAddEquivMatrix eK (wcCohGFrob F'' (wcP1Over F'') hP
      (Subobject.underlying.obj (wcPencilKS D ℓ hP)) 1)).charpoly.aroots
        (AlgebraicClosure ℚ_[ℓ]) =
      (∑ j : Fin D.m, wcPencilLoc D ℓ hP (D.S j (IsLocalRing.closedPoint F'')) 1) +
      (wcAddEquivMatrix e₁ (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1)).charpoly.aroots
        (AlgebraicClosure ℚ_[ℓ]) := by
    rw [← hQroots]
    exact hKroots

  have hlisse := wc_pencil_KS_lisse F' F'' Y n hn hn2 D ℓ hℓ hP hNI ψ hψ
  have hstalk := wc_pencil_KS_stalks_off_S F' F'' Y n hn hn2 D ℓ hℓ hP hNI ψ hψ

  have hpt : ∀ (d : ℕ) (i : Fin (wcPencilNp D d)), wcPencilPt D d i ∈ wcOffS F'' D.m D.S d := by
    intro d i
    have hpos : 0 < Nat.card (wcPencilOffS D d) := lt_of_le_of_lt (Nat.zero_le _) i.isLt
    obtain ⟨_, hfin⟩ := Nat.card_pos_iff.mp hpos
    have hmemS := ((@Finite.equivFin _ hfin).symm i).2
    have heq : wcPencilPt D d i = ((@Finite.equivFin _ hfin).symm i).1 := by
      rw [wcPencilPt, dif_pos hfin]
    rw [heq]
    exact hmemS
  have hinj : ∀ d : ℕ, Function.Injective (wcPencilPt D d) := by
    intro d i j hij
    have hpos : 0 < Nat.card (wcPencilOffS D d) := lt_of_le_of_lt (Nat.zero_le _) i.isLt
    obtain ⟨_, hfin⟩ := Nat.card_pos_iff.mp hpos
    have heq : ∀ k, wcPencilPt D d k = ((@Finite.equivFin _ hfin).symm k).1 := fun k => by
      rw [wcPencilPt, dif_pos hfin]
    rw [heq i, heq j] at hij
    exact (@Finite.equivFin _ hfin).symm.injective (Subtype.ext hij)

  have key := wc_P1_jshriek_trace_formula F'' hP ℓ hℓ D.m D.S D.hS
    (Subobject.underlying.obj (wcPencilKS D ℓ hP)) ψ hψ1 hψadd hψmul hzero hlisse hK0 hK2
    rK eK heK (wcPencilNp D) (wcPencilPt D) (fun d => rfl) hpt hinj e he

  have hU : ∑ d ∈ e.divisors, ∑ i : Fin (wcPencilNp D d),
        (d : AlgebraicClosure ℚ_[ℓ]) * ((wcPencilLocIdx D ℓ hP d i).map (· ^ (e / d))).sum =
      ∑ d ∈ e.divisors, ∑ i : Fin (wcPencilNp D d),
        (d : AlgebraicClosure ℚ_[ℓ]) * ((wcStalkLoc F'' ℓ
          (Subobject.underlying.obj (wcPencilKS D ℓ hP)) ψ (wcPencilPt D d i) d).map
            (· ^ (e / d))).sum := by
    apply Finset.sum_congr rfl
    intro d hd
    apply Finset.sum_congr rfl
    intro i _
    have hd1 : 1 ≤ d := Nat.pos_of_mem_divisors hd
    rw [hstalk d hd1 _ (hpt d i)]
    rfl
  have hsum : ((∑ j : Fin D.m, wcPencilLoc D ℓ hP (D.S j (IsLocalRing.closedPoint F'')) 1).map
        (· ^ e)).sum =
      ∑ j : Fin D.m,
        ((wcPencilLoc D ℓ hP (D.S j (IsLocalRing.closedPoint F'')) 1).map (· ^ e)).sum :=
    map_sum ((Multiset.sumAddMonoidHom).comp
      (Multiset.mapAddMonoidHom (fun z : AlgebraicClosure ℚ_[ℓ] => z ^ e)))
      (fun j : Fin D.m => wcPencilLoc D ℓ hP (D.S j (IsLocalRing.closedPoint F'')) 1)
      Finset.univ
  have hKp : (((wcAddEquivMatrix eK (wcCohGFrob F'' (wcP1Over F'') hP
      (Subobject.underlying.obj (wcPencilKS D ℓ hP)) 1)).charpoly.aroots
        (AlgebraicClosure ℚ_[ℓ])).map (· ^ e)).sum =
      ((∑ j : Fin D.m, wcPencilLoc D ℓ hP (D.S j (IsLocalRing.closedPoint F'')) 1).map
        (· ^ e)).sum +
      (((wcAddEquivMatrix e₁ (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1)).charpoly.aroots
        (AlgebraicClosure ℚ_[ℓ])).map (· ^ e)).sum := by
    rw [hKroots', Multiset.map_add, Multiset.sum_add]
  linear_combination hU + key - hKp - hsum

theorem wc_vqtt_frame_toolkit (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ)
    (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hΓ : ∀ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h ∈ Γ ↔
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ])) :
    (∀ (γ : W ⟶ W) (g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcVQFrame D ℓ hP W r θ γ g → wcVQFrame D ℓ hP W r θ γ g' → g = g') ∧
    (∀ γ : W ⟶ W, γ ≫ w = w →
      ∃ h ∈ Γ, wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ])) :=
by
  classical
  obtain ⟨_, _, hconn, _, _, hgal, _, _, _, _⟩ := hB
  obtain ⟨z₀⟩ := @ConnectedSpace.toNonempty _ _ hconn
  have hsurj : ∀ v : Fin r → ℚ_[ℓ], ∃ x : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op W),
      ∀ z : W.left, (show C(↥W.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom x).down) z = v := by
    intro v
    have key : ∀ y, (θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
        ((θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y) = y := by
      intro y
      change ((θ.inv ≫ θ.hom).hom.app (Opposite.op (Over.mk (𝟙 W)))).hom y = y
      rw [θ.inv_hom_id]
      rfl
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
      (ULift.up (ContinuousMap.const ↥W.left v)), ?_⟩
    intro z
    erw [key]
    rfl
  choose A hA using fun γ : W ⟶ W =>
    wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcPencilVQ D ℓ hP) W hconn r θ γ
  have hex : ∀ γ : W ⟶ W, wcVQFrame D ℓ hP W r θ γ (LinearMap.toMatrix' (A γ)) := by
    intro γ s z
    rw [LinearMap.toMatrix'_mulVec]
    exact hA γ W (𝟙 W) γ (Category.id_comp γ).symm s z
  have hval : ∀ (γ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]), wcVQFrame D ℓ hP W r θ γ g →
      ∀ v, g.mulVec v = A γ v := by
    intro γ g hg v
    obtain ⟨x, hx⟩ := hsurj v
    have h1 := hg x z₀
    have h2 := hA γ W (𝟙 W) γ (Category.id_comp γ).symm x z₀
    rw [hx] at h1 h2
    exact h1.symm.trans h2
  have huniq : ∀ (γ : W ⟶ W) (g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcVQFrame D ℓ hP W r θ γ g → wcVQFrame D ℓ hP W r θ γ g' → g = g' := by
    intro γ g g' hg hg'
    apply Matrix.toLin'.injective
    refine LinearMap.ext fun v => ?_
    rw [Matrix.toLin'_apply, Matrix.toLin'_apply, hval γ g hg v, hval γ g' hg' v]
  have hcomp : ∀ (a b : W ⟶ W) (g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      wcVQFrame D ℓ hP W r θ a g → wcVQFrame D ℓ hP W r θ b g' →
      wcVQFrame D ℓ hP W r θ (a ≫ b) (g' * g) := by
    intro a b g g' hg hg' s z
    refine (hA b W a (a ≫ b) rfl s z).trans ?_
    rw [← hval b g' hg', hg s z, Matrix.mulVec_mulVec]
  have hid : wcVQFrame D ℓ hP W r θ (𝟙 W) 1 := fun s z => (Matrix.one_mulVec _).symm
  refine ⟨huniq, ?_⟩
  intro γ hγ
  obtain ⟨γ', _, he⟩ := hgal W γ (𝟙 W) hconn (by rw [hγ, Category.id_comp])
  have hc := hcomp γ γ' _ _ (hex γ) (hex γ')
  rw [← he] at hc
  have hM'M : LinearMap.toMatrix' (A γ') * LinearMap.toMatrix' (A γ) = 1 :=
    huniq _ _ _ hc hid
  have hMM' : LinearMap.toMatrix' (A γ) * LinearMap.toMatrix' (A γ') = 1 :=
    mul_eq_one_comm.mp hM'M
  let h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ :=
    ⟨LinearMap.toMatrix' (A γ), LinearMap.toMatrix' (A γ'), hMM', hM'M⟩
  exact ⟨h, (hΓ h).mpr ⟨γ, hγ, hex γ⟩, hex γ⟩

theorem wc_vqtt_cup_form_exact (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n))
    (hhom : ∀ φ : (Subobject.underlying.obj (wcPencilE D ℓ hP)).over (wcGeomPoint F'' (wcP1Over F'') hP) ⟶
        (wcContSheaf (wcP1Over F'').left ℚ_[ℓ]).over (wcGeomPoint F'' (wcP1Over F'') hP), φ = 0)
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ)
    (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (Φ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hΦ : wcVQFrame D ℓ hP W r θ φ (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (hΓ : ∀ h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ, h ∈ Γ ↔
      ∃ γ : W ⟶ W, γ ≫ w = w ∧ wcVQFrame D ℓ hP W r θ γ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ])) :
    ∃ J : Matrix (Fin r) (Fin r) ℚ_[ℓ], J.transpose = -J ∧ IsUnit J.det ∧
      (∀ h ∈ Γ, (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
        (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = J) ∧
      ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
        ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
          ((Nat.card F'' : ℚ_[ℓ]) ^ (n - 1)) • J :=
by
  classical
  obtain ⟨hθc, -, hconn, hoffW, hcov, hgal, hφw, -, -, -⟩ := hB
  haveI := hconn

  have hcancel1 : ∀ (T : Over W) (s : ((wcPencilVQ D ℓ hP).over W).obj.obj (Opposite.op T)),
      (θ.inv.hom.app (Opposite.op T)).hom ((θ.hom.hom.app (Opposite.op T)).hom s) = s := by
    intro T s
    exact congrArg (fun m => (m.hom.app (Opposite.op T)).hom s) θ.hom_inv_id
  have hcancel2 : ∀ (T : Over W)
      (x : ((wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W).obj.obj (Opposite.op T)),
      (θ.hom.hom.app (Opposite.op T)).hom ((θ.inv.hom.app (Opposite.op T)).hom x) = x := by
