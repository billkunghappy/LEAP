        rw [← Scheme.isoSpec_hom, Scheme.isoSpec_Spec_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id]
      calc Proj.fromOfGlobalSections _ F hF ≫ (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) 0))))
          = (Proj.fromOfGlobalSections _ F hF ≫
              Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)) ≫
              Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0))) :=
            (Category.assoc _ _ _).symm
        _ = V.toSpecΓ ≫ (Spec.map (CommRingCat.ofHom (F.comp (algebraMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)
              (MvPolynomial (Fin (N + 1)) K)))) ≫
              Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 0)))) := by
            rw [h1, Category.assoc]
        _ = V.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso (.of K)).inv ≫ fV.appTop) := by
            rw [← Spec.map_comp, hc]
        _ = (V.toSpecΓ ≫ Spec.map fV.appTop) ≫ Spec.map (Scheme.ΓSpecIso (.of K)).inv := by
            rw [Spec.map_comp, Category.assoc]
        _ = fV ≫ ((Spec (.of K)).toSpecΓ ≫ Spec.map (Scheme.ΓSpecIso (.of K)).inv) := by
            rw [← Scheme.toSpecΓ_naturality, Category.assoc]
        _ = fV := by rw [h2, Category.comp_id]
    · rw [← hFX J]
      exact Proj.fromOfGlobalSections_preimage_basicOpen _ F hF Nat.one_pos (hX J)
    · have hy : (MvPolynomial.X L : MvPolynomial (Fin (N + 1)) K) ∈
          MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (1 • 1) := by
        rw [one_smul]
        exact hX L
      have h := s3 (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) V F hF Nat.one_pos (hX J) 1
        (MvPolynomial.X L) hy
      rw [hFX, hFX, pow_one] at h
      have e := congrArg (V.presheaf.map (homOfLE hO).op) h
      rw [map_mul, hres, hres] at e
      exact e

  intro K _ N
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) := MvPolynomial.gradedAlgebra
  have hX : ∀ k : Fin (N + 1), (MvPolynomial.X k : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun k =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
  refine ⟨wcSgD K N 0, wcSgE K N 0, ?_, ?_, ?_, ?_⟩
  · exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X 0) (hX 0) Nat.one_pos
  · have h1 : HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (hX 0) 1
        (MvPolynomial.X 0) (hX 0) = 1 := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one,
        ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      exact ⟨1, by simp⟩
    show Proj.awayToSection _ _ _ = 1
    rw [h1, map_one]
  · intro t
    refine Subring.closure_mono ?_ (S1 K N 0 t)
    rintro _ (⟨L, rfl⟩ | ⟨c, rfl⟩)
    · exact Or.inr ⟨L, rfl⟩
    · exact Or.inl ⟨c, rfl⟩
  · intro V fV s hs0
    have hspan : Ideal.span (Set.range s) = ⊤ :=
      Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨0, rfl⟩) (by rw [hs0]; exact isUnit_one)
    obtain ⟨φ, hstr, hpre, hrel⟩ := S3 K N V fV s hspan
    have hφ : ⊤ ≤ φ ⁻¹ᵁ wcSgD K N 0 := by
      rw [hpre 0, hs0, Scheme.basicOpen_of_isUnit _ isUnit_one]
    refine ⟨φ, hφ, hstr, fun L => ?_⟩
    have h := hrel 0 L ⊤ hφ
    have hid : ∀ x : Γ(V, ⊤), V.presheaf.map (homOfLE (le_top : (⊤ : V.Opens) ≤ ⊤)).op x = x := by
      intro x
      rw [show (homOfLE (le_top : (⊤ : V.Opens) ≤ ⊤)).op = 𝟙 _ from rfl,
        CategoryTheory.Functor.map_id]
      rfl
    rw [hid, hid, hs0, mul_one] at h
    exact h

theorem wcpa_dj_cf_sp_graph_image_model : ∀ (k : Type u) [Field k] (X' : Scheme.{u}) [AlgebraicGeometry.IsIntegral X'] (sX' : X' ⟶ Spec (.of k)) (m : ℕ) (y : Fin m → X'.presheaf.stalk (genericPoint X')), wcpaDjIsProjOver k sX' → ∃ (Γ Q : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Γ) (_ : AlgebraicGeometry.IsIntegral Q) (α₁ : Γ ⟶ X') (sQ : Q ⟶ Spec (.of k)) (g : Γ ⟶ Q) (h : g (genericPoint Γ) ⤳ genericPoint Q) (e : Γ.presheaf.stalk (genericPoint Γ) ≃+* X'.presheaf.stalk (genericPoint X')), g ≫ sQ = α₁ ≫ sX' ∧ wcpaDjIsProjOver k (α₁ ≫ sX') ∧ wcpaDjIsProjOver k sQ ∧ IsProper α₁ ∧ Surjective α₁ ∧ (∃ V : X'.Opens, V ≠ ⊥ ∧ IsFinite (α₁ ∣_ V)) ∧ (∀ c : k, e ((Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom (((Scheme.ΓSpecIso (.of k)).inv ≫ sQ.appTop ≫ Q.presheaf.germ ⊤ (genericPoint Q) trivial).hom c)) = ((Scheme.ΓSpecIso (.of k)).inv ≫ sX'.appTop ≫ X'.presheaf.germ ⊤ (genericPoint X') trivial).hom c) ∧ letI : Algebra k (X'.presheaf.stalk (genericPoint X')) := ((Scheme.ΓSpecIso (.of k)).inv ≫ sX'.appTop ≫ X'.presheaf.germ ⊤ (genericPoint X') trivial).hom.toAlgebra; Set.range (fun a => e ((Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom a)) = ((IntermediateField.adjoin k (Set.range y) : IntermediateField k _) : Set (X'.presheaf.stalk (genericPoint X'))) :=
by
  intro k _ X' _ sX' m y hP
  classical
  haveI : IsProper sX' := wcpa_dj_proj_proper k sX' hP

  have wcpa_dj_cf_gim_affine_germ_chart : ∀ (X : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] (m : ℕ) (y : Fin m → X.presheaf.stalk (genericPoint X)), ∃ (W : X.Opens) (r : Fin m → Γ(X, W)) (hW : genericPoint X ∈ W), IsAffineOpen W ∧ ∀ i, (X.presheaf.germ W (genericPoint X) hW).hom (r i) = y i := by
    intro X _ m y
    choose U hU s hs using fun i => X.presheaf.exists_germ_eq (y i)
    have hmem : genericPoint X ∈ (Finset.univ.inf U : X.Opens) := by
      have : genericPoint X ∈ ((Finset.univ.inf U : X.Opens) : Set X) := by
        rw [TopologicalSpace.Opens.coe_finset_inf]
        have h2 : ({genericPoint X} : Set X) ≤ Finset.univ.inf (SetLike.coe ∘ U) :=
          Finset.le_inf (fun i _ => Set.singleton_subset_iff.mpr (hU i))
        exact h2 rfl
      exact this
    obtain ⟨W, hWaff, hW, hWsub⟩ := exists_isAffineOpen_mem_and_subset hmem
    have hle : ∀ i, W ≤ U i := fun i x hx =>
      (Finset.inf_le (Finset.mem_univ i) : Finset.univ.inf U ≤ U i) (hWsub hx)
    refine ⟨W, fun i => (X.presheaf.map (homOfLE (hle i)).op).hom (s i), hW, hWaff, ?_⟩
    intro i
    rw [TopCat.Presheaf.germ_res_apply]
    exact hs i

  have wcpa_dj_cf_gim_integral_of_dense_inj : ∀ (W Γ : Scheme.{u}) [AlgebraicGeometry.IsIntegral W] (δ : W ⟶ Γ), DenseRange δ → (∀ U : Γ.Opens, Function.Injective (δ.app U)) → AlgebraicGeometry.IsIntegral Γ ∧ IrreducibleSpace Γ := by
    intro W Γ _ δ hd hi
    haveI : AlgebraicGeometry.IsReduced Γ := ⟨fun U => isReduced_of_injective (δ.app U).hom (hi U)⟩
    haveI : IrreducibleSpace Γ := by
      rw [irreducibleSpace_def]
      have h := ((irreducibleSpace_def W).mp inferInstance).image δ δ.continuous.continuousOn
      rw [Set.top_eq_univ, Set.image_univ] at h
      have h2 := h.closure
      rw [hd.closure_range] at h2
      rw [Set.top_eq_univ]
      exact h2
    exact ⟨isIntegral_of_irreducibleSpace_of_isReduced Γ, inferInstance⟩

  have wcpa_dj_cf_gim_generic_point_dense : ∀ (X Y : Scheme.{u}) [IrreducibleSpace X] [IrreducibleSpace Y] (f : X ⟶ Y), DenseRange f → f (genericPoint X) = genericPoint Y := by
    intro X Y _ _ f hf
    have h1 := (genericPoint_spec X).image f.continuous
    rw [Set.image_univ, hf.closure_range] at h1
    exact h1.eq (genericPoint_spec Y)

  have wcpa_dj_cf_gim_range_adjoin : ∀ (k : Type u) [Field k] (R B A K : Type u) [CommRing R] [CommRing B] [Field A] [Field K] [Algebra k K] (ρ : R →+* B) (γB : B →+* A) (cR : k →+* R) (m : ℕ) (e : Fin (m + 1) → R) (Φ : A →+* K) (y : Fin m → K), Function.Surjective ρ → (∀ z : A, ∃ b₁ b₂ : B, z = γB b₁ / γB b₂) → (∀ t : R, t ∈ Subring.closure (Set.range cR ∪ Set.range e)) → (∀ c : k, Φ (γB (ρ (cR c))) = algebraMap k K c) → Φ (γB (ρ (e 0))) = 1 → (∀ i : Fin m, Φ (γB (ρ (e i.succ))) = y i) → Set.range Φ = ((IntermediateField.adjoin k (Set.range y) : IntermediateField k K) : Set K) := by
    intro k _ R B A K _ _ _ _ _ ρ γB cR m e Φ y hρ hfrac hgen hc he0 hey
    set F := IntermediateField.adjoin k (Set.range y) with hF
    have hθ : ∀ t : R, Φ (γB (ρ t)) ∈ F := by
      intro t
      let θ : R →+* K := Φ.comp (γB.comp ρ)
      have hS : Subring.closure (Set.range cR ∪ Set.range e) ≤ F.toSubalgebra.toSubring.comap θ := by
        rw [Subring.closure_le]
        rintro x (⟨c, rfl⟩ | ⟨j, rfl⟩)
        · show Φ (γB (ρ (cR c))) ∈ F
          rw [hc]; exact F.algebraMap_mem c
        · show Φ (γB (ρ (e j))) ∈ F
          cases j using Fin.cases with
          | zero => rw [he0]; exact F.one_mem
          | succ i => rw [hey]; exact IntermediateField.subset_adjoin k _ ⟨i, rfl⟩
      exact hS (hgen t)
    ext z
    constructor
    · rintro ⟨a, rfl⟩
      obtain ⟨b₁, b₂, rfl⟩ := hfrac a
      obtain ⟨t₁, rfl⟩ := hρ b₁
      obtain ⟨t₂, rfl⟩ := hρ b₂
      rw [map_div₀]
      exact F.div_mem (hθ t₁) (hθ t₂)
    · intro hz
      have hle : F ≤ (Φ.fieldRange).toIntermediateField
          (fun c => RingHom.mem_fieldRange.mpr ⟨_, hc c⟩) := by
        rw [hF, IntermediateField.adjoin_le_iff]
        rintro _ ⟨i, rfl⟩
        exact RingHom.mem_fieldRange.mpr ⟨_, hey i⟩
      exact RingHom.mem_fieldRange.mp (hle hz)

  have wcpa_dj_cf_gim_proj_transport : ∀ (k : Type u) [Field k] (X' Z : Scheme.{u}) (sX' : X' ⟶ Spec (.of k)) (m : ℕ) (ι : Z ⟶ Limits.pullback sX' (wcProjKStr k m)), IsClosedImmersion ι → wcpaDjIsProjOver k sX' → wcpaDjIsProjOver k (ι ≫ Limits.pullback.fst sX' (wcProjKStr k m) ≫ sX') := by
    intro k _ X' Z sX' m ι hι hP
    obtain ⟨N, j, hj, hjs⟩ := hP
    obtain ⟨N', σ, hσ, hσs⟩ := wc_pp_segre k N m
    haveI : MorphismProperty.IsStableUnderComposition @IsClosedImmersion :=
      ⟨fun f g hf hg => by haveI := hf; haveI := hg; infer_instance⟩
    have hμ := MorphismProperty.pullbackMap (P := @IsClosedImmersion) (f := sX')
      (g := wcProjKStr k m) (f' := wcProjKStr k N) (g' := wcProjKStr k m) (i₁ := j)
      (i₂ := 𝟙 _) hj (inferInstance : IsClosedImmersion (𝟙 (wcProjK k m))) hjs.symm
      (Category.id_comp _).symm
    haveI := hμ
    haveI := hσ
    haveI := hι
    refine ⟨N', ι ≫ Limits.pullback.map sX' (wcProjKStr k m) (wcProjKStr k N) (wcProjKStr k m) j
      (𝟙 _) (𝟙 _) _ _ ≫ σ, inferInstance, ?_⟩
    simp only [Category.assoc]
    rw [hσs, Limits.pullback.lift_fst_assoc, Category.assoc, hjs]

  have wcpa_dj_cf_gim_graph_closure : ∀ (k : Type u) [Field k] (X' : Scheme.{u}) [AlgebraicGeometry.IsIntegral X'] (sX' : X' ⟶ Spec (.of k)) [IsProper sX'] (m : ℕ) (W : X'.Opens) (φ : (W : Scheme.{u}) ⟶ wcProjK k m), IsAffineOpen W → W ≠ ⊥ → φ ≫ wcProjKStr k m = W.ι ≫ sX' → ∃ (Γ : Scheme.{u}) (ιΓ : Γ ⟶ Limits.pullback sX' (wcProjKStr k m)) (δ : (W : Scheme.{u}) ⟶ Γ), IsClosedImmersion ιΓ ∧ δ ≫ ιΓ ≫ Limits.pullback.fst sX' (wcProjKStr k m) = W.ι ∧ δ ≫ ιΓ ≫ Limits.pullback.snd sX' (wcProjKStr k m) = φ ∧ IsProper (ιΓ ≫ Limits.pullback.fst sX' (wcProjKStr k m)) ∧ Surjective (ιΓ ≫ Limits.pullback.fst sX' (wcProjKStr k m)) ∧ IsIso ((ιΓ ≫ Limits.pullback.fst sX' (wcProjKStr k m)) ∣_ W) ∧ DenseRange δ ∧ ∀ U : Γ.Opens, Function.Injective (δ.app U) := by
    intro k _ X' _ sX' _ m W φ hWaff hWbot hφ
    haveI := wc_proj_space_isProper k m
    haveI : IsLocallyNoetherian X' := LocallyOfFiniteType.isLocallyNoetherian sX'
    haveI : IsAffine (W : Scheme.{u}) := hWaff
    haveI : IsNoetherian (W : Scheme.{u}) := ⟨⟩
    let γ := Limits.pullback.lift W.ι φ hφ.symm
    haveI : QuasiCompact γ := inferInstance
    obtain ⟨hinj, hdense⟩ := wc_toImage_injective_dense _ _ γ
    have hγ : γ.toImage ≫ γ.imageι = γ := Scheme.Hom.toImage_imageι γ
    have h1 : γ.toImage ≫ γ.imageι ≫ Limits.pullback.fst sX' (wcProjKStr k m) = W.ι := by
      rw [← Category.assoc, hγ]; exact Limits.pullback.lift_fst _ _ _
    have h2 : γ.toImage ≫ γ.imageι ≫ Limits.pullback.snd sX' (wcProjKStr k m) = φ := by
      rw [← Category.assoc, hγ]; exact Limits.pullback.lift_snd _ _ _
    haveI hαp : IsProper (γ.imageι ≫ Limits.pullback.fst sX' (wcProjKStr k m)) := inferInstance
    have hiso := wc_isIso_restrict_of_section _ _
      (γ.imageι ≫ Limits.pullback.fst sX' (wcProjKStr k m)) W γ.toImage hinj h1
    have hsurj : Surjective (γ.imageι ≫ Limits.pullback.fst sX' (wcProjKStr k m)) := by
      constructor
      have hcl : IsClosed (Set.range (γ.imageι ≫ Limits.pullback.fst sX' (wcProjKStr k m))) :=
        (γ.imageι ≫ Limits.pullback.fst sX' (wcProjKStr k m)).isClosedMap.isClosed_range
      have hsub : (W : Set X') ⊆
          Set.range (γ.imageι ≫ Limits.pullback.fst sX' (wcProjKStr k m)) := by
        rw [← Scheme.Opens.range_ι W]
        rintro _ ⟨w, rfl⟩
        refine ⟨γ.toImage w, ?_⟩
        rw [← Scheme.Hom.comp_apply, h1]
      have hd : Dense (W : Set X') :=
        W.isOpen.dense ((TopologicalSpace.Opens.ne_bot_iff_nonempty W).mp hWbot)
      have hr : Set.range (γ.imageι ≫ Limits.pullback.fst sX' (wcProjKStr k m)) = Set.univ := by
        have := hd.closure_eq
        apply Set.eq_univ_of_univ_subset
        rw [← this]
        exact closure_minimal hsub hcl
      intro x
      have : x ∈ Set.range (γ.imageι ≫ Limits.pullback.fst sX' (wcProjKStr k m)) := by
        rw [hr]; trivial
      exact this
    exact ⟨γ.image, γ.imageι, γ.toImage, inferInstance, h1, h2, hαp, hsurj, hiso, hdense, hinj⟩

  have wcpa_dj_cf_gim_function_field_equiv : ∀ (X' Γ Q W : Scheme.{u}) [AlgebraicGeometry.IsIntegral X'] [AlgebraicGeometry.IsIntegral Γ] [AlgebraicGeometry.IsIntegral Q] [AlgebraicGeometry.IsIntegral W] (ι : W ⟶ X') [IsOpenImmersion ι] (δ : W ⟶ Γ) (α₁ : Γ ⟶ X') (g : Γ ⟶ Q), δ ≫ α₁ = ι → ι (genericPoint W) = genericPoint X' → δ (genericPoint W) = genericPoint Γ → g (genericPoint Γ) = genericPoint Q → ∃ (h : g (genericPoint Γ) ⤳ genericPoint Q) (e : Γ.presheaf.stalk (genericPoint Γ) ≃+* X'.presheaf.stalk (genericPoint X')), ∀ (U : Q.Opens) (V : X'.Opens) (hU : genericPoint Q ∈ U) (hV : genericPoint X' ∈ V) (hU' : ⊤ ≤ (δ ≫ g) ⁻¹ᵁ U) (hV' : ⊤ ≤ ι ⁻¹ᵁ V) (a : Γ(Q, U)) (b : Γ(X', V)), (δ ≫ g).appLE U ⊤ hU' a = ι.appLE V ⊤ hV' b → e ((Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom ((Q.presheaf.germ U (genericPoint Q) hU).hom a)) = (X'.presheaf.germ V (genericPoint X') hV).hom b := by
    intro X' Γ Q W _ _ _ _ ι _ δ α₁ g hδα hι hδ hg
    have germ_rule : ∀ {T T' : Scheme.{u}} (f : T ⟶ T') (t : T) (t' : T') (h : f t ⤳ t')
        (U : T'.Opens) (ht' : t' ∈ U) (a : Γ(T', U)),
        (T'.presheaf.stalkSpecializes h ≫ f.stalkMap t).hom ((T'.presheaf.germ U t' ht').hom a) =
          (T.presheaf.germ (f ⁻¹ᵁ U) t (show t ∈ f ⁻¹ᵁ U from h.mem_open U.isOpen ht')).hom
            (f.app U a) := by
      intro T T' f t t' h U ht' a
      have := congrArg (fun φ => φ.hom a) (show T'.presheaf.germ U t' ht' ≫
          T'.presheaf.stalkSpecializes h ≫ f.stalkMap t =
          f.app U ≫ T.presheaf.germ (f ⁻¹ᵁ U) t (show t ∈ f ⁻¹ᵁ U from h.mem_open U.isOpen ht') from by
        rw [← Category.assoc, TopCat.Presheaf.germ_stalkSpecializes, Scheme.Hom.germ_stalkMap])
      simpa only [CommRingCat.comp_apply] using this
    have germ_top : ∀ {T T' : Scheme.{u}} (f : T ⟶ T') (t : T) (U : T'.Opens) (hU : ⊤ ≤ f ⁻¹ᵁ U)
        (a : Γ(T', U)), (T.presheaf.germ ⊤ t (show t ∈ (⊤ : T.Opens) from trivial)).hom (f.appLE U ⊤ hU a) =
          (T.presheaf.germ (f ⁻¹ᵁ U) t (hU trivial)).hom (f.app U a) := by
      intro T T' f t U hU a
      rw [Scheme.Hom.appLE, CommRingCat.comp_apply]
      exact TopCat.Presheaf.germ_res_apply _ _ _ _ _
    subst hδα
    have h₁ : (δ ≫ α₁) (genericPoint W) ⤳ genericPoint X' := Specializes.of_eq hι
    have h₂ : δ (genericPoint W) ⤳ genericPoint Γ := Specializes.of_eq hδ
    have h₃ : α₁ (genericPoint Γ) ⤳ genericPoint X' := by
      apply Specializes.of_eq
      rw [← hδ, ← Scheme.Hom.comp_apply, hι]
    have hbij : ∀ (x : X') (h : (δ ≫ α₁) (genericPoint W) ⤳ x), (δ ≫ α₁) (genericPoint W) = x →
        Function.Bijective (X'.presheaf.stalkSpecializes h ≫ (δ ≫ α₁).stalkMap (genericPoint W)).hom := by
      intro x h hx
      subst hx
      rw [TopCat.Presheaf.stalkSpecializes_refl, Category.id_comp]
      exact ConcreteCategory.bijective_of_isIso _
    have hψ₁ := hbij _ h₁ hι
    have hm : X'.presheaf.stalkSpecializes h₁ ≫ (δ ≫ α₁).stalkMap (genericPoint W) =
        (X'.presheaf.stalkSpecializes h₃ ≫ α₁.stalkMap (genericPoint Γ)) ≫
          (Γ.presheaf.stalkSpecializes h₂ ≫ δ.stalkMap (genericPoint W)) := by
      apply TopCat.Presheaf.stalk_hom_ext
      intro V hV
      ext b
      show (X'.presheaf.stalkSpecializes h₁ ≫ (δ ≫ α₁).stalkMap (genericPoint W)).hom
          ((X'.presheaf.germ V _ hV).hom b) =
        (Γ.presheaf.stalkSpecializes h₂ ≫ δ.stalkMap (genericPoint W)).hom
          ((X'.presheaf.stalkSpecializes h₃ ≫ α₁.stalkMap (genericPoint Γ)).hom
            ((X'.presheaf.germ V _ hV).hom b))
      rw [germ_rule, germ_rule, germ_rule]
      rfl
    have hfac : ∀ z, (X'.presheaf.stalkSpecializes h₁ ≫ (δ ≫ α₁).stalkMap (genericPoint W)).hom z =
        (Γ.presheaf.stalkSpecializes h₂ ≫ δ.stalkMap (genericPoint W)).hom
          ((X'.presheaf.stalkSpecializes h₃ ≫ α₁.stalkMap (genericPoint Γ)).hom z) := by
      intro z
      rw [hm]
      rfl
    have hψ₂inj : Function.Injective (Γ.presheaf.stalkSpecializes h₂ ≫ δ.stalkMap (genericPoint W)).hom :=
      RingHom.injective _
    have hψ₂surj : Function.Surjective (Γ.presheaf.stalkSpecializes h₂ ≫ δ.stalkMap (genericPoint W)).hom := by
      intro w
      obtain ⟨z, rfl⟩ := hψ₁.2 w
      exact ⟨_, (hfac z).symm⟩
    let e := (RingEquiv.ofBijective _ ⟨hψ₂inj, hψ₂surj⟩).trans (RingEquiv.ofBijective _ hψ₁).symm
    have hψe : ∀ x, (X'.presheaf.stalkSpecializes h₁ ≫ (δ ≫ α₁).stalkMap (genericPoint W)).hom (e x) =
        (Γ.presheaf.stalkSpecializes h₂ ≫ δ.stalkMap (genericPoint W)).hom x :=
      fun x => (RingEquiv.ofBijective _ hψ₁).apply_symm_apply _
    refine ⟨Specializes.of_eq hg, e, ?_⟩
    intro U V hU hV hU' hV' a b hab
    apply hψ₁.1
    rw [hψe, germ_rule, germ_rule, germ_rule, ← germ_top (δ ≫ α₁) (genericPoint W) V hV' b, ← hab,
      germ_top]
    rfl

  have key1 : ∀ {A B S : Scheme.{u}} (f : A ⟶ B) (t : B ⟶ S) (hf : ⊤ ≤ f ⁻¹ᵁ ⊤) (x : Γ(S, ⊤)),
      (f.appLE ⊤ ⊤ hf).hom (t.appTop.hom x) = (f ≫ t).appTop.hom x := by
    intro A B S f t hf x
    rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply]
    show (f.appLE ⊤ (f ⁻¹ᵁ ⊤) le_rfl).hom _ = _
    rw [Scheme.Hom.appLE_eq_app]
    rfl

  obtain ⟨W, r, hW, hWaff, hgerm⟩ := wcpa_dj_cf_gim_affine_germ_chart X' m y
  haveI hWne : Nonempty W := ⟨⟨genericPoint X', hW⟩⟩
  have hWbot : W ≠ ⊥ := by
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]; exact ⟨_, hW⟩
  haveI : AlgebraicGeometry.IsIntegral (W : Scheme.{u}) := inferInstance
  have hV' : ⊤ ≤ W.ι ⁻¹ᵁ W := (Scheme.Opens.ι_preimage_self W).ge

  obtain ⟨C, ξ, hCaff, hξ0, hgen, hUP⟩ := wcpa_dj_cf_gim_proj_chart k m
  let s : Fin (m + 1) → Γ((W : Scheme.{u}), ⊤) :=
    Fin.cons (1 : Γ((W : Scheme.{u}), ⊤)) (fun i => W.ι.appLE W ⊤ hV' (r i))
  obtain ⟨φ, hφC, hφstr, hφξ⟩ := hUP (W : Scheme.{u}) (W.ι ≫ sX') s (Fin.cons_zero _ _)

  obtain ⟨Γ, ιΓ, δ, hιΓ, hδ1, hδ2, hαp, hαs, hαiso, hδdense, hδinj⟩ :=
    wcpa_dj_cf_gim_graph_closure k X' sX' m W φ hWaff hWbot hφstr
  haveI := hιΓ
  haveI hΓint : AlgebraicGeometry.IsIntegral Γ :=
    (wcpa_dj_cf_gim_integral_of_dense_inj (W : Scheme.{u}) Γ δ hδdense hδinj).1
  set α₁ := ιΓ ≫ Limits.pullback.fst sX' (wcProjKStr k m) with hα₁
  set g₀ := ιΓ ≫ Limits.pullback.snd sX' (wcProjKStr k m) with hg₀
  have hg₀str : g₀ ≫ wcProjKStr k m = α₁ ≫ sX' := by
    simp only [hg₀, hα₁, Category.assoc, Limits.pullback.condition]
  haveI : IsProper α₁ := hαp
  haveI : IsProper (g₀ ≫ wcProjKStr k m) := by rw [hg₀str]; infer_instance
  haveI : IsProper g₀ := IsProper.of_comp g₀ (wcProjKStr k m)
  haveI : QuasiCompact g₀ := inferInstance
  obtain ⟨hginj, hgdense⟩ := wc_toImage_injective_dense Γ (wcProjK k m) g₀
  set Q := g₀.image with hQ
  set g := g₀.toImage with hg
  set ιQ := g₀.imageι with hιQ
  haveI hQint : AlgebraicGeometry.IsIntegral Q :=
    (wcpa_dj_cf_gim_integral_of_dense_inj Γ Q g hgdense hginj).1
  set sQ := ιQ ≫ wcProjKStr k m with hsQ
  have hgιQ : g ≫ ιQ = g₀ := Scheme.Hom.toImage_imageι g₀
  have hgsQ : g ≫ sQ = α₁ ≫ sX' := by
    rw [hsQ, ← Category.assoc, hgιQ, hg₀str]
  have hPΓ : wcpaDjIsProjOver k (α₁ ≫ sX') := by
    have := wcpa_dj_cf_gim_proj_transport k X' Γ sX' m ιΓ hιΓ hP
    simpa only [hα₁, Category.assoc] using this
  have hPQ : wcpaDjIsProjOver k sQ := ⟨m, ιQ, inferInstance, rfl⟩
  have hφ' : δ ≫ g ≫ ιQ = φ := by rw [hgιQ]; exact hδ2

  have hWgen : W.ι (genericPoint (W : Scheme.{u})) = genericPoint X' := by
    apply wcpa_dj_cf_gim_generic_point_dense
    unfold DenseRange
    rw [Scheme.Opens.range_ι]
    exact W.isOpen.dense ⟨_, hW⟩
  have hδgen : δ (genericPoint (W : Scheme.{u})) = genericPoint Γ :=
    wcpa_dj_cf_gim_generic_point_dense _ _ δ hδdense
  have hggen : g (genericPoint Γ) = genericPoint Q :=
    wcpa_dj_cf_gim_generic_point_dense _ _ g hgdense
  obtain ⟨h, e, he⟩ := wcpa_dj_cf_gim_function_field_equiv X' Γ Q (W : Scheme.{u}) W.ι δ α₁ g
    hδ1 hWgen hδgen hggen

  have hk0 : ∀ c : k, e ((Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom
      ((Q.presheaf.germ ⊤ (genericPoint Q) trivial).hom
        (sQ.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom c)))) =
      (X'.presheaf.germ ⊤ (genericPoint X') trivial).hom
        (sX'.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom c)) := by
    intro c
    refine he ⊤ ⊤ trivial trivial (fun _ _ => trivial) (fun _ _ => trivial) _ _ ?_
    have h1 := key1 (δ ≫ g) sQ (fun _ _ => trivial) ((Scheme.ΓSpecIso (.of k)).inv.hom c)
    have h2 := key1 W.ι sX' (fun _ _ => trivial) ((Scheme.ΓSpecIso (.of k)).inv.hom c)
    have h3 : (δ ≫ g) ≫ sQ = W.ι ≫ sX' := by
      rw [Category.assoc, hgsQ, ← Category.assoc, hδ1]
    rw [h3] at h1
    exact h1.trans h2.symm
  have hk : ∀ c : k, e ((Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom
      (((Scheme.ΓSpecIso (.of k)).inv ≫ sQ.appTop ≫ Q.presheaf.germ ⊤ (genericPoint Q) trivial).hom c)) =
      ((Scheme.ΓSpecIso (.of k)).inv ≫ sX'.appTop ≫ X'.presheaf.germ ⊤ (genericPoint X') trivial).hom c :=
    fun c => hk0 c
  refine ⟨Γ, Q, hΓint, hQint, α₁, sQ, g, h, e, hgsQ, hPΓ, hPQ, hαp, hαs, ⟨W, hWbot, ?_⟩, hk, ?_⟩
  · haveI := hαiso
    infer_instance

  letI algK : Algebra k (X'.presheaf.stalk (genericPoint X')) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ sX'.appTop ≫
      X'.presheaf.germ ⊤ (genericPoint X') trivial).hom.toAlgebra
  have hQ₀aff : IsAffineOpen (ιQ ⁻¹ᵁ C) := hCaff.preimage ιQ
  have hU' : ⊤ ≤ (δ ≫ g) ⁻¹ᵁ (ιQ ⁻¹ᵁ C) := by
    intro x _
    have hx := hφC (show x ∈ (⊤ : (W : Scheme.{u}).Opens) from trivial)
    rw [← hφ'] at hx
    exact hx
  have hηQ : genericPoint Q ∈ ιQ ⁻¹ᵁ C := by
    have hx := hU' (show genericPoint (W : Scheme.{u}) ∈ (⊤ : (W : Scheme.{u}).Opens) from trivial)
    have hx' : g (δ (genericPoint (W : Scheme.{u}))) ∈ ιQ ⁻¹ᵁ C := hx
    rw [hδgen, hggen] at hx'
    exact hx'
  haveI : Nonempty (ιQ ⁻¹ᵁ C) := ⟨⟨_, hηQ⟩⟩
  have hap : ∀ (f₁ f₂ : (W : Scheme.{u}) ⟶ wcProjK k m) (_ : f₁ = f₂) (h₁ : ⊤ ≤ f₁ ⁻¹ᵁ C)
      (h₂ : ⊤ ≤ f₂ ⁻¹ᵁ C) (x : Γ(wcProjK k m, C)), f₁.appLE C ⊤ h₁ x = f₂.appLE C ⊤ h₂ x := by
    intro f₁ f₂ hf h₁ h₂ x
    subst hf
    rfl
  have hres := wcpa_dj_cf_gim_range_adjoin k Γ(wcProjK k m, C) Γ(Q, ιQ ⁻¹ᵁ C)
    (Q.presheaf.stalk (genericPoint Q)) (X'.presheaf.stalk (genericPoint X'))
    (ιQ.app C).hom (Q.presheaf.germ (ιQ ⁻¹ᵁ C) (genericPoint Q) hηQ).hom
    (((wcProjK k m).presheaf.map (homOfLE (le_top : C ≤ ⊤)).op).hom.comp
      ((wcProjKStr k m).appTop.hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom))
    m ξ (e.toRingHom.comp (Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom) y
    (Scheme.Hom.app_surjective ιQ C hCaff)
    (by
      intro z
      haveI := functionField_isFractionRing_of_isAffineOpen Q (ιQ ⁻¹ᵁ C) hQ₀aff
      obtain ⟨x, y', _, hxy⟩ := IsFractionRing.div_surjective (A := Γ(Q, ιQ ⁻¹ᵁ C))
        (K := Q.functionField) z
      exact ⟨x, y', hxy.symm⟩)
    hgen
    (by
      intro c
      have h1 : (Q.presheaf.germ (ιQ ⁻¹ᵁ C) (genericPoint Q) hηQ).hom ((ιQ.app C).hom
          (((wcProjK k m).presheaf.map (homOfLE (le_top : C ≤ ⊤)).op).hom
            ((wcProjKStr k m).appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom c)))) =
          (Q.presheaf.germ ⊤ (genericPoint Q) trivial).hom
            (sQ.appTop.hom ((Scheme.ΓSpecIso (.of k)).inv.hom c)) := by
        rw [← CommRingCat.comp_apply ((wcProjK k m).presheaf.map (homOfLE (le_top : C ≤ ⊤)).op)
          (ιQ.app C), Scheme.Hom.naturality, CommRingCat.comp_apply,
          TopCat.Presheaf.germ_res_apply, hsQ, Scheme.Hom.comp_appTop]
        rfl
      simp only [RingHom.comp_apply]
      rw [h1]
      exact hk0 c)
    (by
      rw [hξ0]
      simp)
    (by
      intro i
      have hEq : (δ ≫ g).appLE (ιQ ⁻¹ᵁ C) ⊤ hU' ((ιQ.app C) (ξ i.succ)) =
          W.ι.appLE W ⊤ hV' (r i) := by
        have e1 : (δ ≫ g).appLE (ιQ ⁻¹ᵁ C) ⊤ hU' ((ιQ.app C) (ξ i.succ)) =
            ((δ ≫ g) ≫ ιQ).appLE C ⊤ hU' (ξ i.succ) := by
          rw [Scheme.Hom.comp_appLE]
          rfl
        rw [e1, hap ((δ ≫ g) ≫ ιQ) φ (by rw [Category.assoc, hφ']) hU' hφC, hφξ]
        exact Fin.cons_succ _ _ _
      have hr := he (ιQ ⁻¹ᵁ C) W hηQ hW hU' hV' _ _ hEq
      rw [← hgerm i]
      exact hr)
  exact hres

theorem wcpa_dj_cf_sp_generic_fibre_geom : ∀ (Γ Q : Scheme.{u}) [AlgebraicGeometry.IsIntegral Γ] [AlgebraicGeometry.IsIntegral Q] (g : Γ ⟶ Q) (h : g (genericPoint Γ) ⤳ genericPoint Q), (letI : Algebra (Q.presheaf.stalk (genericPoint Q)) (Γ.presheaf.stalk (genericPoint Γ)) := (Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom.toAlgebra; ∀ (Ω : Type u) [Field Ω] [Algebra (Q.presheaf.stalk (genericPoint Q)) Ω], IsDomain (TensorProduct (Q.presheaf.stalk (genericPoint Q)) (Γ.presheaf.stalk (genericPoint Γ)) Ω)) → GeometricallyIrreducible (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q))) ∧ GeometricallyReduced (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q))) :=
by
  intro Γ Q _ _ g h hdom

  have S1 : ∀ {Γ Q T : Scheme.{u}} (g : Γ ⟶ Q) (ι : T ⟶ Q), (∀ (Ω : Type u) [Field Ω] (y : Spec (.of Ω) ⟶ T) (Z : Scheme.{u}) (p : Z ⟶ Γ) (q : Z ⟶ Spec (.of Ω)), IsPullback p q g (y ≫ ι) → AlgebraicGeometry.IsIntegral Z) → GeometricallyIrreducible (Limits.pullback.snd g ι) ∧ GeometricallyReduced (Limits.pullback.snd g ι) := by
    intro Γ Q T g ι H
    refine ⟨⟨fun K _ y Z fst snd hpb => ?_⟩, ⟨fun K _ y Z fst snd hpb => ?_⟩⟩
    · haveI := H K y Z (fst ≫ Limits.pullback.fst g ι) snd
        (hpb.paste_horiz (IsPullback.of_hasPullback g ι))
      infer_instance
    · haveI := H K y Z (fst ≫ Limits.pullback.fst g ι) snd
        (hpb.paste_horiz (IsPullback.of_hasPullback g ι))
      infer_instance

  have S2 : ∀ (A B F K Ω : Type u) [CommRing A] [CommRing B] [Field F] [Field K] [Field Ω] (α : A →+* B) (β : A →+* F) (φ : F →+* K) (γ : B →+* K) (ω : F →+* Ω), (letI := β.toAlgebra; IsFractionRing A F) → Function.Injective γ → γ.comp α = φ.comp β → (letI := φ.toAlgebra; letI := ω.toAlgebra; IsDomain (TensorProduct F K Ω)) → id (letI := α.toAlgebra; letI := (ω.comp β).toAlgebra; IsDomain (TensorProduct A B Ω)) := by
    intro A B F K Ω _ _ _ _ _ α β φ γ ω hfrac hγ hsq hdom
    letI : Algebra A B := α.toAlgebra
    letI : Algebra A F := β.toAlgebra
    letI : Algebra F K := φ.toAlgebra
    letI : Algebra F Ω := ω.toAlgebra
    letI : Algebra A Ω := (ω.comp β).toAlgebra
    letI : Algebra A K := (φ.comp β).toAlgebra
    haveI : IsScalarTower A F Ω := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsScalarTower A F K := IsScalarTower.of_algebraMap_eq' rfl
    haveI : IsFractionRing A F := hfrac
    haveI : IsDomain (TensorProduct F K Ω) := hdom
    letI : Algebra B (TensorProduct A F B) := Algebra.TensorProduct.rightAlgebra
    haveI hloc : IsLocalization (Algebra.algebraMapSubmonoid B (nonZeroDivisors A))
        (TensorProduct A F B) :=
      IsLocalization.tensorRight F (nonZeroDivisors A)
    have hcomm : ∀ a : A, γ (algebraMap A B a) = algebraMap A K a := fun a =>
      congrArg (fun f : A →+* K => f a) hsq
    let γA : B →ₐ[A] K := AlgHom.mk γ hcomm
    let lam : TensorProduct A F B →ₐ[F] K :=
      Algebra.TensorProduct.lift (Algebra.ofId F K) γA (fun _ _ => Commute.all _ _)
    have hlam : Function.Injective lam := by
      have := IsLocalization.injective_of_map_algebraMap_zero
        (M := Algebra.algebraMapSubmonoid B (nonZeroDivisors A)) (S := TensorProduct A F B)
        lam.toRingHom ?_
      · exact this
      intro b hb
      have h1 : algebraMap B (TensorProduct A F B) b = (1 : F) ⊗ₜ b := rfl
      rw [h1] at hb ⊢
      have h2 : lam.toRingHom ((1 : F) ⊗ₜ b) = γ b := by
        change lam ((1 : F) ⊗ₜ b) = γ b
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        rfl
      rw [h2] at hb
      have : b = 0 := hγ (by rw [hb, map_zero])
      rw [this, TensorProduct.tmul_zero]
    let μ := Algebra.TensorProduct.map (AlgHom.id F Ω) lam
    have hμ : Function.Injective μ := by
      have heq : ⇑μ = ⇑(LinearMap.lTensor Ω lam.toLinearMap) := by
        funext x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul w l => simp [μ]
        | add x y hx hy => simp only [map_add, hx, hy]
      rw [heq]
      exact Module.Flat.lTensor_preserves_injective_linearMap _ hlam
    let cb := Algebra.TensorProduct.cancelBaseChange A F F Ω B
    let cA := Algebra.TensorProduct.comm A B Ω
    let cF := Algebra.TensorProduct.comm F Ω K
    let Θ : TensorProduct A B Ω →+* TensorProduct F K Ω :=
      (cF.toRingEquiv.toRingHom.comp μ.toRingHom).comp
        (cb.symm.toRingEquiv.toRingHom.comp cA.toRingEquiv.toRingHom)
    have hΘ : Function.Injective Θ := by
      intro x y hxy
      apply cA.injective
      apply cb.symm.injective
      apply hμ
      apply cF.injective
      exact hxy
    exact Function.Injective.isDomain Θ hΘ

  have S3 : ∀ {Γ Q Z : Scheme.{u}} (g : Γ ⟶ Q) (Ω : Type u) [Field Ω] (c : Spec (.of Ω) ⟶ Q) (p : Z ⟶ Γ) (q : Z ⟶ Spec (.of Ω)), IsPullback p q g c → ∀ (U : Q.Opens) (hU : IsAffineOpen U) (V : Γ.Opens), IsAffineOpen V → ∀ (e : V ≤ g ⁻¹ᵁ U) (ψ : Γ(Q, U) ⟶ CommRingCat.of Ω), c = Spec.map ψ ≫ hU.fromSpec → (letI := (g.appLE U V e).hom.toAlgebra; letI := ψ.hom.toAlgebra; IsDomain (TensorProduct Γ(Q, U) Γ(Γ, V) Ω)) → id (AlgebraicGeometry.IsIntegral (p ⁻¹ᵁ V).toScheme) := by
    intro Γ Q Z g Ω _ c p q G U hU V hV e ψ hc hT
    letI : Algebra Γ(Q, U) Γ(Γ, V) := (g.appLE U V e).hom.toAlgebra
    letI : Algebra Γ(Q, U) Ω := ψ.hom.toAlgebra
    haveI : IsDomain (TensorProduct Γ(Q, U) Γ(Γ, V) Ω) := hT
    have H1 := isPullback_SpecMap_of_isPushout _ _ _ _
      (CommRingCat.isPushout_tensorProduct Γ(Q, U) Γ(Γ, V) Ω)
    have hmono : ∀ {P X Y W M : Scheme.{u}} {fst : P ⟶ X} {snd : P ⟶ Y} {f₁ : X ⟶ W}
        {f₂ : Y ⟶ W} (i : W ⟶ M) [Mono i], IsPullback fst snd f₁ f₂ →
        IsPullback fst snd (f₁ ≫ i) (f₂ ≫ i) := by
      intro P X Y W M fst snd f₁ f₂ i _ H
      refine IsPullback.mk' (by rw [← Category.assoc, H.w, Category.assoc])
        (fun T φ φ' h1 h2 => H.hom_ext h1 h2) (fun T a b hab => ?_)
      have hab' : a ≫ f₁ = b ≫ f₂ := by
        rw [← cancel_mono i]; simpa only [Category.assoc] using hab
      exact ⟨H.lift a b hab', H.lift_fst a b hab', H.lift_snd a b hab'⟩
    have H2 := hmono hU.fromSpec H1
    have e1 : Spec.map (CommRingCat.ofHom (algebraMap Γ(Q, U) Γ(Γ, V))) ≫ hU.fromSpec =
        hV.fromSpec ≫ g :=
      IsAffineOpen.SpecMap_appLE_fromSpec g hU hV e
    have e2 : Spec.map (CommRingCat.ofHom (algebraMap Γ(Q, U) Ω)) ≫ hU.fromSpec = c := hc.symm
    rw [e1, e2] at H2
    have H3 := (isPullback_morphismRestrict p V).paste_vert G
    have H4 : IsPullback ((p ∣_ V) ≫ hV.isoSpec.hom) ((p ⁻¹ᵁ V).ι ≫ q) (hV.fromSpec ≫ g) c := by
      refine IsPullback.of_iso H3 (Iso.refl _) hV.isoSpec (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
      · simp
      · simp
      · rw [← IsAffineOpen.isoSpec_inv_ι hV]; simp
      · simp
    let ε := IsPullback.isoIsPullback _ _ H2 H4
    haveI : Nonempty (p ⁻¹ᵁ V).toScheme := by
      obtain ⟨x⟩ := (inferInstance :
        Nonempty (Spec (CommRingCat.of (TensorProduct Γ(Q, U) Γ(Γ, V) Ω))))
      exact ⟨ε.hom x⟩
    exact isIntegral_of_isOpenImmersion ε.inv

  have S4 : ∀ {Γ Q : Scheme.{u}} [AlgebraicGeometry.IsIntegral Γ] [AlgebraicGeometry.IsIntegral Q] (g : Γ ⟶ Q) (h : g (genericPoint Γ) ⤳ genericPoint Q) (U : Q.Opens) (hηU : genericPoint Q ∈ U) (V : Γ.Opens) (hηV : genericPoint Γ ∈ V) (e : V ≤ g ⁻¹ᵁ U), g.appLE U V e ≫ Γ.presheaf.germ V (genericPoint Γ) hηV = Q.presheaf.germ U (genericPoint Q) hηU ≫ Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ) := by
    intro Γ Q _ _ g h U hηU V hηV e
    rw [← Category.assoc, TopCat.Presheaf.germ_stalkSpecializes, Scheme.Hom.germ_stalkMap,
      Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]

  have S5 : ∀ (X : Type u) [TopologicalSpace X] (ι : Type u) (W : ι → Set X), (∀ i, IsOpen (W i)) → (∀ i, IsIrreducible (W i)) → (∀ x : X, ∃ i, x ∈ W i) → Nonempty ι → (∀ i j, (W i ∩ W j).Nonempty) → id (IrreducibleSpace X) := by
    intro X _ ι W hO hI hC hne hP
    rw [irreducibleSpace_def]
    obtain ⟨i₀⟩ := hne
    refine ⟨?_, ?_⟩
    · obtain ⟨x, _⟩ := (hI i₀).nonempty
      exact ⟨x, trivial⟩
    · intro u v hu hv ⟨a, _, ha⟩ ⟨b, _, hb⟩
      obtain ⟨i, hai⟩ := hC a
      obtain ⟨j, hbj⟩ := hC b
      obtain ⟨c, hci, hcu, hcj⟩ := (hI i).2 u (W j) hu (hO j) ⟨a, hai, ha⟩ (hP i j)
      obtain ⟨d, _, hdu, hdv⟩ := (hI j).2 u v hu hv ⟨c, hcj, hcu⟩ ⟨b, hbj, hb⟩
      exact ⟨d, trivial, hdu, hdv⟩

  have S6 : ∀ (Γ Z : Scheme.{u}) [AlgebraicGeometry.IsIntegral Γ] (p : Z ⟶ Γ) (O : Γ.Opens), genericPoint Γ ∈ O → (∀ z : Z, p z ∈ O) → (∀ V : Γ.Opens, IsAffineOpen V → V ≤ O → genericPoint Γ ∈ V → AlgebraicGeometry.IsIntegral (p ⁻¹ᵁ V).toScheme) → id (AlgebraicGeometry.IsIntegral Z) := by
    intro Γ Z _ p O hηO hpO hI
    have hgen : ∀ W : Γ.Opens, ∀ x, x ∈ W → genericPoint Γ ∈ W := fun W x hx =>
      ((genericPoint_spec Γ).mem_open_set_iff W.isOpen).mpr ⟨x, trivial, hx⟩
    let ι := {V : Γ.Opens // IsAffineOpen V ∧ V ≤ O ∧ genericPoint Γ ∈ V}
    let W : ι → Set Z := fun V => (p ⁻¹ᵁ V.1 : Set Z)
    have hcov : ∀ z : Z, ∃ V : ι, z ∈ W V := by
      intro z
      obtain ⟨V, hV, hzV, hVO⟩ := exists_isAffineOpen_mem_and_subset (hpO z)
      exact ⟨⟨V, hV, hVO, hgen V _ hzV⟩, hzV⟩
    have hirr : IrreducibleSpace Z := by
      refine S5 Z ι W (fun V => (p ⁻¹ᵁ V.1).isOpen) (fun V => ?_) hcov ?_ ?_
      · haveI := hI V.1 V.2.1 V.2.2.1 V.2.2.2
        exact isIrreducible_iff_irreducibleSpace.mpr
          (inferInstance : IrreducibleSpace (p ⁻¹ᵁ V.1).toScheme)
      · obtain ⟨V, hV, hzV, hVO⟩ := exists_isAffineOpen_mem_and_subset hηO
        exact ⟨⟨V, hV, hVO, hzV⟩⟩
      · intro V₁ V₂
        have hmem : genericPoint Γ ∈ V₁.1 ⊓ V₂.1 := ⟨V₁.2.2.2, V₂.2.2.2⟩
        obtain ⟨V₃, hV₃, hη₃, h₃⟩ := exists_isAffineOpen_mem_and_subset hmem
        haveI := hI V₃ hV₃ (fun x hx => V₁.2.2.1 (h₃ hx).1) hη₃
        obtain ⟨⟨z, hz⟩⟩ := (inferInstance : Nonempty (p ⁻¹ᵁ V₃).toScheme)
        exact ⟨z, (h₃ hz).1, (h₃ hz).2⟩
    have hred : IsReduced Z := by
      haveI hst : ∀ z : Z, _root_.IsReduced (Z.presheaf.stalk z) := by
        intro z
        obtain ⟨V, hzV⟩ := hcov z
        haveI := hI V.1 V.2.1 V.2.2.1 V.2.2.2
        haveI : _root_.IsReduced ((p ⁻¹ᵁ V.1).toScheme.presheaf.stalk ⟨z, hzV⟩) :=
          isReduced_stalk_of_isReduced _ _
        let e := Scheme.Opens.stalkIso (p ⁻¹ᵁ V.1) ⟨z, hzV⟩
        have hinj : Function.Injective e.inv.hom := by
          intro a b hab
          have := congrArg e.hom.hom hab
          simpa [← CommRingCat.comp_apply] using this
        exact isReduced_of_injective e.inv.hom hinj
      exact isReduced_of_isReduced_stalk Z
    exact isIntegral_of_irreducibleSpace_of_isReduced Z

  refine S1 g (Q.fromSpecStalk (genericPoint Q)) ?_
  intro Ω _ y Z p q G
  let ψ₀ : Q.presheaf.stalk (genericPoint Q) ⟶ CommRingCat.of Ω := Spec.preimage y
  obtain ⟨U, hU, hηU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (x := genericPoint Q) (U := ⊤) trivial
  have hc : y ≫ Q.fromSpecStalk (genericPoint Q) =
      Spec.map (Q.presheaf.germ U (genericPoint Q) hηU ≫ ψ₀) ≫ hU.fromSpec := by
    rw [← IsAffineOpen.fromSpecStalk_eq_fromSpecStalk hU hηU, IsAffineOpen.fromSpecStalk,
      Spec.map_comp, Category.assoc]
    congr 1
    exact (Spec.map_preimage y).symm
  have hgU : g (genericPoint Γ) ∈ U := h.mem_open U.isOpen hηU
  have hpO : ∀ z : Z, p z ∈ g ⁻¹ᵁ U := by
    intro z
    have h1 : g (p z) = hU.fromSpec
        ((q ≫ Spec.map (Q.presheaf.germ U (genericPoint Q) hηU ≫ ψ₀)) z) := by
      rw [← Scheme.Hom.comp_apply p g, G.w, hc]
      simp only [Scheme.Hom.comp_apply]
    have h2 : g (p z) ∈ Set.range hU.fromSpec := ⟨_, h1.symm⟩
    rw [hU.range_fromSpec] at h2
    exact h2
  refine S6 Γ Z p (g ⁻¹ᵁ U) hgU hpO ?_
  intro V hV hVO hηV
  refine S3 g Ω _ p q G U hU V hV hVO _ hc ?_
  have hfrac : (letI := (Q.presheaf.germ U (genericPoint Q) hηU).hom.toAlgebra;
      IsFractionRing Γ(Q, U) (Q.presheaf.stalk (genericPoint Q))) := by
    letI : Nonempty U := ⟨⟨_, hηU⟩⟩
    exact functionField_isFractionRing_of_isAffineOpen Q U hU
  have hγ : Function.Injective (Γ.presheaf.germ V (genericPoint Γ) hηV).hom := by
    letI : Nonempty V := ⟨⟨_, hηV⟩⟩
    letI := (Γ.presheaf.germ V _ hηV).hom.toAlgebra
    haveI : IsFractionRing Γ(Γ, V) (Γ.presheaf.stalk (genericPoint Γ)) :=
      functionField_isFractionRing_of_isAffineOpen Γ V hV
    exact IsFractionRing.injective Γ(Γ, V) (Γ.presheaf.stalk (genericPoint Γ))
  have hsq : (Γ.presheaf.germ V (genericPoint Γ) hηV).hom.comp (g.appLE U V hVO).hom =
      (Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom.comp
        (Q.presheaf.germ U (genericPoint Q) hηU).hom :=
    congrArg CommRingCat.Hom.hom (S4 g h U hηU V hηV hVO)
  exact S2 Γ(Q, U) Γ(Γ, V) (Q.presheaf.stalk (genericPoint Q))
    (Γ.presheaf.stalk (genericPoint Γ)) Ω (g.appLE U V hVO).hom
    (Q.presheaf.germ U (genericPoint Q) hηU).hom
    (Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom
    (Γ.presheaf.germ V (genericPoint Γ) hηV).hom ψ₀.hom hfrac hγ hsq
    (@hdom Ω _ ψ₀.hom.toAlgebra)

theorem wcpa_dj_cf_sp_field_transport : ∀ (k : Type u) [Field k] (A B K : Type u) [Field A] [Field B] [Field K] [Algebra k A] [Algebra k K] (φ : A →+* B) (e : B ≃+* K) (L : IntermediateField k K) (d : ℕ), (∀ c : k, e (φ (algebraMap k A c)) = algebraMap k K c) → Set.range (fun a => e (φ a)) = (L : Set K) → (∀ x : K, IsAlgebraic L x → x ∈ Set.range (algebraMap L K)) → Algebra.IsSeparablyGenerated L K → (∃ S : Finset K, IntermediateField.adjoin L (S : Set K) = ⊤) → (∃ t' : Fin d → L, IsTranscendenceBasis k t') → letI : Algebra A B := φ.toAlgebra; (∀ x : B, IsAlgebraic A x → x ∈ Set.range (algebraMap A B)) ∧ Algebra.IsSeparablyGenerated A B ∧ (∃ S : Finset B, IntermediateField.adjoin A (S : Set B) = ⊤) ∧ ∃ t'' : Fin d → A, IsTranscendenceBasis k t'' :=
by
  intro k _ A B K _ _ _ _ _ φ e L d hk hrange hac hsep hfg htb
  letI algAB : Algebra A B := φ.toAlgebra
  classical

  have hmem : ∀ a : A, ((e : B →+* K).comp φ) a ∈ L := by
    intro a
    have h : e (φ a) ∈ (L : Set K) := hrange ▸ ⟨a, rfl⟩
    exact h
  let ψ : A →+* L := ((e : B →+* K).comp φ).codRestrict L hmem
  have hψ : ∀ a, (ψ a : K) = e (φ a) := fun a => rfl
  have hψbij : Function.Bijective ψ := by
    refine ⟨ψ.injective, ?_⟩
    intro z
    have hz : (z : K) ∈ Set.range (fun a => e (φ a)) := by rw [hrange]; exact z.2
    obtain ⟨a, ha⟩ := hz
    exact ⟨a, Subtype.ext (by rw [hψ]; exact ha)⟩
  let ε : A ≃+* L := RingEquiv.ofBijective ψ hψbij
  have hε : ∀ a, (ε a : K) = e (φ a) := fun a => rfl
  have hsqp : ∀ a : A, algebraMap L K (ε a) = e (algebraMap A B a) := fun a => hε a
  have hεk : ∀ c : k, ε (algebraMap k A c) = algebraMap k L c := by
    intro c
    apply Subtype.ext
    rw [hε, hk, IntermediateField.coe_algebraMap_apply]
  let εk : A ≃ₐ[k] L := AlgEquiv.ofRingEquiv (f := ε) hεk

  have himg : ∀ s : Set B, (e : B → K) '' (IntermediateField.adjoin A s : Set B) =
      (IntermediateField.adjoin L ((e : B → K) '' s) : Set K) := by
    intro s
    have h1 : (IntermediateField.adjoin A s : Set B) =
        (Subfield.closure (Set.range (algebraMap A B) ∪ s) : Set B) := by
      rw [← IntermediateField.adjoin_toSubfield]; rfl
    have h2 : (IntermediateField.adjoin L ((e : B → K) '' s) : Set K) =
        (Subfield.closure (Set.range (algebraMap L K) ∪ (e : B → K) '' s) : Set K) := by
      rw [← IntermediateField.adjoin_toSubfield]; rfl
    have h3 : (e : B → K) '' Set.range (algebraMap A B) = Set.range (algebraMap L K) := by
      rw [← Set.range_comp]
      ext y
      constructor
      · rintro ⟨a, rfl⟩
        exact ⟨ε a, hsqp a⟩
      · rintro ⟨z, rfl⟩
        obtain ⟨a, rfl⟩ := ε.surjective z
        exact ⟨a, (hsqp a).symm⟩
    rw [h1, h2, ← h3, ← Set.image_union]
    have h4 := congrArg (fun S : Subfield K => (S : Set K))
      (RingHom.map_field_closure (e : B →+* K) (Set.range (algebraMap A B) ∪ s))
    simp only [Subfield.coe_map, RingEquiv.coe_toRingHom] at h4
    exact h4

  have hAI : ∀ {ι : Type u} (y : ι → B),
      AlgebraicIndependent L (fun i => e (y i)) ↔ AlgebraicIndependent A y := fun y =>
    algebraicIndependent_ringHom_iff_of_comp_eq ε e e.injective (RingHom.ext fun a => hsqp a)

  have htb_pull : ∀ {ι : Type u} (x : ι → B),
      IsTranscendenceBasis L (fun i => e (x i)) → IsTranscendenceBasis A x := by
    intro ι x hx
    refine ⟨(hAI x).mp hx.1, ?_⟩
    intro s hs hxs
    have h1 : AlgebraicIndependent L (fun i : s => e (i : B)) := (hAI (fun i : s => (i : B))).mpr hs
    have h2 : AlgebraicIndepOn L id ((e : B → K) '' s) :=
      (algebraicIndependent_equiv (Equiv.Set.image e s e.injective)
        (f := fun j : ((e : B → K) '' s : Set K) => (j : K))).mp h1
    have h3 : Set.range (fun i => e (x i)) ⊆ (e : B → K) '' s := by
      rintro _ ⟨i, rfl⟩
      exact ⟨x i, hxs ⟨i, rfl⟩, rfl⟩
    have h4 := hx.2 _ h2 h3
    have h5 : (e : B → K) '' Set.range x = (e : B → K) '' s := by
      rw [← Set.range_comp]; exact h4
    exact Set.image_injective.mpr e.injective h5

  have G1 : ∀ x : B, IsAlgebraic A x → x ∈ Set.range (algebraMap A B) := by
    intro x hx
    have h1 : IsAlgebraic L (e x) :=
      (isAlgebraic_ringHom_iff_of_comp_eq ε e e.injective (RingHom.ext fun a => hsqp a)).mpr hx
    obtain ⟨z, hz⟩ := hac _ h1
    obtain ⟨a, rfl⟩ := ε.surjective z
    refine ⟨a, e.injective ?_⟩
    rw [← hsqp a, hz]

  have G3 : ∃ S : Finset B, IntermediateField.adjoin A (S : Set B) = ⊤ := by
    obtain ⟨S, hS⟩ := hfg
    refine ⟨S.image e.symm, ?_⟩
    have h1 := himg ((S.image e.symm : Finset B) : Set B)
    have h2 : (e : B → K) '' ((S.image e.symm : Finset B) : Set B) = (S : Set K) := by
      rw [Finset.coe_image, Set.image_image]
      simp
    rw [h2, hS, IntermediateField.coe_top] at h1
    rw [eq_top_iff]
    intro b _
    have hb : e b ∈ (e : B → K) ''
        (IntermediateField.adjoin A ((S.image e.symm : Finset B) : Set B) : Set B) := by
      rw [h1]; trivial
    obtain ⟨b', hb', hbb⟩ := hb
    rw [← e.injective hbb]
    exact hb'

  have G2 : Algebra.IsSeparablyGenerated A B := by
    obtain ⟨s, hs, hss⟩ := hsep.isSeparable
    haveI := hss
    refine ⟨⟨(e : B → K) ⁻¹' s, ?_, ?_⟩⟩
    · refine htb_pull (Subtype.val : ((e : B → K) ⁻¹' s) → B) ?_
      let σ : ((e : B → K) ⁻¹' s) ≃ s := e.toEquiv.subtypeEquiv (fun b => Iff.rfl)
      have hσ : ((Subtype.val : s → K) ∘ σ) = fun i : ((e : B → K) ⁻¹' s) => e (i : B) := by
        funext i; rfl
      have h0 := (isTranscendenceBasis_equiv σ (R := L) (f := (Subtype.val : s → K))).mpr hs
      rw [hσ] at h0
      exact h0
    · have h1 := himg ((e : B → K) ⁻¹' s)
      rw [Set.image_preimage_eq s e.surjective] at h1
      have hmem1 : ∀ z : IntermediateField.adjoin L s,
          ((e.symm : K →+* B).comp (algebraMap (IntermediateField.adjoin L s) K)) z ∈
            IntermediateField.adjoin A ((e : B → K) ⁻¹' s) := by
        intro z
        have hz : (z : K) ∈ (e : B → K) ''
            (IntermediateField.adjoin A ((e : B → K) ⁻¹' s) : Set B) := by
          rw [h1]; exact z.2
        obtain ⟨b, hb, hbz⟩ := hz
        show e.symm (z : K) ∈ _
        rw [← hbz, e.symm_apply_apply]
        exact hb
      let ψ₁ := ((e.symm : K →+* B).comp (algebraMap (IntermediateField.adjoin L s) K)).codRestrict
        (IntermediateField.adjoin A ((e : B → K) ⁻¹' s)) hmem1
      have hψ₁ : Function.Bijective ψ₁ := by
        refine ⟨ψ₁.injective, ?_⟩
        intro w
        have hw : e (w : B) ∈ (IntermediateField.adjoin L s : Set K) := by
          rw [← h1]; exact ⟨w, w.2, rfl⟩
        refine ⟨⟨e w, hw⟩, Subtype.ext ?_⟩
        show e.symm (e (w : B)) = w
        exact e.symm_apply_apply _
      exact Algebra.IsSeparable.of_equiv_equiv (RingEquiv.ofBijective ψ₁ hψ₁) e.symm
        (RingHom.ext fun z => rfl)

  obtain ⟨t', ht'⟩ := htb
  exact ⟨G1, G2, G3, εk.symm ∘ t', εk.symm.isTranscendenceBasis ht'⟩

theorem wcpa_dj_cf_separable_projection : ∀ (k : Type u) [Field k] [Finite k] (X' : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X'] (sX' : X' ⟶ Spec (.of k)) (d : ℕ),
    wcpaDjIsProjOver k sX' → topologicalKrullDim X' = ((d + 1 : ℕ) : WithBot ℕ∞) →
    ∃ (Γ Q : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Γ) (_ : AlgebraicGeometry.IsIntegral Q)
      (α₁ : Γ ⟶ X') (sQ : Q ⟶ Spec (.of k)) (g : Γ ⟶ Q),
      g ≫ sQ = α₁ ≫ sX' ∧ wcpaDjIsProjOver k (α₁ ≫ sX') ∧ wcpaDjIsProjOver k sQ ∧
      IsProper α₁ ∧ Surjective α₁ ∧ (∃ V : X'.Opens, V ≠ ⊥ ∧ IsFinite (α₁ ∣_ V)) ∧
      topologicalKrullDim Q = (d : WithBot ℕ∞) ∧
      GeometricallyIrreducible (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q))) ∧
      GeometricallyReduced (Limits.pullback.snd g (Q.fromSpecStalk (genericPoint Q))) :=
by
  intro k _ _ X' _ sX' d hP hX
  classical
  haveI : IsProper sX' := wcpa_dj_proj_proper k sX' hP
  letI algK : Algebra k (X'.presheaf.stalk (genericPoint X')) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ sX'.appTop ≫
      X'.presheaf.germ ⊤ (genericPoint X') trivial).hom.toAlgebra
  obtain ⟨⟨S, hS⟩, n, t, ht, hn⟩ := wcpa_dj_cf_sp_function_field_trdeg k X' sX'
  have hnd : n = d + 1 := by
    rw [hX] at hn
    exact_mod_cast hn.symm
  subst hnd
  obtain ⟨m, y, ⟨t', ht'⟩, hac, hsep, hfg⟩ :=
    wcpa_dj_cf_sp_stein_subfield wcpa_dj_cf_sp_alg_closure_finite k
      (X'.presheaf.stalk (genericPoint X')) d ⟨S, hS⟩ ⟨t, ht⟩
  obtain ⟨Γ, Q, iΓ, iQ, α₁, sQ, g, h, e, hg, hPΓ, hPQ, hα₁p, hα₁s, hα₁f, hk, hrange⟩ :=
    wcpa_dj_cf_sp_graph_image_model k X' sX' m y hP
  haveI := iΓ
  haveI := iQ
  letI algA : Algebra k (Q.presheaf.stalk (genericPoint Q)) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ sQ.appTop ≫
      Q.presheaf.germ ⊤ (genericPoint Q) trivial).hom.toAlgebra
  obtain ⟨hac', hsep', hfg', t'', ht''⟩ :=
    wcpa_dj_cf_sp_field_transport k (Q.presheaf.stalk (genericPoint Q))
      (Γ.presheaf.stalk (genericPoint Γ)) (X'.presheaf.stalk (genericPoint X'))
      (Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom e
      (IntermediateField.adjoin k (Set.range y)) d hk hrange hac hsep hfg ⟨t', ht'⟩

  haveI : IsProper sQ := wcpa_dj_proj_proper k sQ hPQ
  obtain ⟨_, n', τ, hτ, hn'⟩ := wcpa_dj_cf_sp_function_field_trdeg k Q sQ
  have hcard := hτ.lift_cardinalMk_eq ht''
  simp only [Cardinal.mk_fin, Cardinal.lift_natCast, Nat.cast_inj] at hcard
  have hQd : topologicalKrullDim Q = (d : WithBot ℕ∞) := by
    rw [hn', hcard]

  letI : Algebra (Q.presheaf.stalk (genericPoint Q)) (Γ.presheaf.stalk (genericPoint Γ)) :=
    (Q.presheaf.stalkSpecializes h ≫ g.stalkMap (genericPoint Γ)).hom.toAlgebra
  have h4 := wcpa_dj_cf_sp_tensor_reduced _ _ hsep' hfg'
  have h5 := wcpa_dj_cf_sp_tensor_domain_finite _ _ hac' h4
  have h6 := wcpa_dj_cf_sp_tensor_domain_all _ _ h5
  obtain ⟨hGI, hGR⟩ := wcpa_dj_cf_sp_generic_fibre_geom Γ Q g h h6
  exact ⟨Γ, Q, iΓ, iQ, α₁, sQ, g, hg, hPΓ, hPQ, hα₁p, hα₁s, hα₁f, hQd, hGI, hGR⟩

