  have tRR : ∀ p, wcSpfBarR A lamA ρ p ≫ wcSpfBarR A lamA ρ (p + 1) =
      wcSpfBarR A lamA ρ p ≫ wcSpfBarM A lamA ρ (p + 1) (Fin.last p) := by
    intro p
    have : NeZero (ℓ ^ n) := ⟨pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero⟩
    have hN : (ℓ ^ n) • 𝟙 A = 0 := by rw [← natCast_zsmul]; exact htor
    have TC : ∀ {X : 𝒜} (φ : X ⟶ A) (u v : ℕ), (u : ZMod (ℓ ^ n)) = v → u • φ = v • φ := by
      intro X φ u v huv
      have hφ : (ℓ ^ n) • φ = 0 := by
        rw [← Category.comp_id φ, ← Preadditive.comp_nsmul, hN, Limits.comp_zero]
      have hm := (ZMod.natCast_eq_natCast_iff' u v (ℓ ^ n)).mp huv
      rw [← Nat.mod_add_div u (ℓ ^ n), ← Nat.mod_add_div v (ℓ ^ n), add_nsmul, add_nsmul,
