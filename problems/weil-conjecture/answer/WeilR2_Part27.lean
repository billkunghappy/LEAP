      hom_inv_id := by rw [tw.1]; exact tw.2.2 _ _ χ.hom_inv_id
      inv_hom_id := by rw [tw.1]; exact tw.2.2 _ _ χ.inv_hom_id }

  have hFrY : ∀ x, wcCxJMap K hP (wcSpfTruncMap I.cocomplex (ℓ ^ n) (lamI x)) ≫
      wcCxJFrob K hP (wcTruncKerRes I.cocomplex (ℓ ^ n)) =
      wcCxJFrob K hP (wcTruncKerRes I.cocomplex (ℓ ^ n)) ≫
        wcCxJMap K hP (wcSpfTruncMap I.cocomplex (ℓ ^ n) (lamI x)) := fun x =>
    (NatTrans.mapHomologicalComplex _ _).naturality _
  obtain ⟨e, he⟩ := wcU_sms_tw_E_iso K hP ρ (wcTruncKerRes I.cocomplex (ℓ ^ n))
    (fun x => wcSpfTruncMap I.cocomplex (ℓ ^ n) (lamI x)) hFrY

  obtain ⟨Θ, hΘ⟩ := wcU_sms_twist_iso ℓ n ρ P Q hQ hAF

  have hEinv : e.symm.hom ≫ wcCxJFrob K hP (wcSpfTwCx (wcTruncKerRes I.cocomplex (ℓ ^ n))
        (fun x => wcSpfTruncMap I.cocomplex (ℓ ^ n) (lamI x)) ρ) =
      wcSmsTwMap ρ (wcCxJFrob K hP (wcTruncKerRes I.cocomplex (ℓ ^ n))) hFrY ≫ e.symm.hom := by
    rw [Iso.symm_hom, Iso.inv_comp_eq, ← Category.assoc, he, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  have hFrW : ∀ x, wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n) (wcCxJMap K hP (lamI x)) ≫
      wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n) (wcCxJFrob K hP I.cocomplex) =
      wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n) (wcCxJFrob K hP I.cocomplex) ≫
        wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n) (wcCxJMap K hP (lamI x)) := fun x => by
    rw [← hTf.2.1, hFr x, hTf.2.1]
  have hb : Tχ.hom ≫ wcSmsTwMap ρ (wcCxJFrob K hP (wcTruncKerRes I.cocomplex (ℓ ^ n))) hFrY =
      wcSmsTwMap ρ (wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n) (wcCxJFrob K hP I.cocomplex))
        hFrW ≫ Tχ.hom := by
    show wcSmsTwMap ρ χ.hom hχu ≫ _ = _ ≫ wcSmsTwMap ρ χ.hom hχu
    rw [tw.1, tw.1]
    exact tw.2.1 _ _ _ _ hχFr
  have hu1 : ∀ x, wcSmsBarSmul P n x ≫ (β' ≫ wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n)
      (wcCxJFrob K hP I.cocomplex)) = (β' ≫ wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n)
      (wcCxJFrob K hP I.cocomplex)) ≫
        wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n) (wcCxJMap K hP (lamI x)) := fun x => by
    rw [← Category.assoc, hβlin, Category.assoc, hFrW, Category.assoc]
  have hu2 : ∀ x, wcSmsBarSmul P n x ≫ (wcSmsBarFrob P n ≫ β') = (wcSmsBarFrob P n ≫ β') ≫
        wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n) (wcCxJMap K hP (lamI x)) := fun x => by
    rw [← Category.assoc, hAF, Category.assoc, hβlin, Category.assoc]
  obtain ⟨hc0⟩ := wcU_sms_tw_htpy ρ _ _ _ _ hu1 hu2 G hG
  have hc : Homotopy (wcSmsTwMap ρ β' hβlin ≫ wcSmsTwMap ρ
        (wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n) (wcCxJFrob K hP I.cocomplex)) hFrW)
      (wcSmsTwMap ρ (wcSmsBarFrob P n) hAF ≫ wcSmsTwMap ρ β' hβlin) :=
    (Homotopy.ofEq (tw.1 _ _ _ _)).trans (hc0.trans (Homotopy.ofEq (tw.1 _ _ _ _).symm))
  haveI := hqβ
  have qiso : ∀ {A B : CochainComplex AddCommGrpCat.{u+1} ℕ} (f : A ≅ B), QuasiIso f.hom :=
    fun f => inferInstance
  have q1 : QuasiIso Θ.hom := qiso Θ
  have q3 : QuasiIso Tχ.hom := qiso Tχ
  have q4 : QuasiIso e.symm.hom := qiso e.symm
  have q34 : QuasiIso (Tχ.hom ≫ e.symm.hom) := quasiIso_comp _ _
  have q234 : QuasiIso (heq.hom ≫ Tχ.hom ≫ e.symm.hom) := quasiIso_comp _ _
  have q1234 : QuasiIso (Θ.hom ≫ heq.hom ≫ Tχ.hom ≫ e.symm.hom) := quasiIso_comp _ _
  refine ⟨Θ.hom ≫ heq.hom ≫ Tχ.hom ≫ e.symm.hom, q1234, ⟨?_⟩⟩
  refine (Homotopy.ofEq ?_).trans
    ((((hc.compRight (Tχ.hom ≫ e.symm.hom)).compLeft Θ.hom)).trans (Homotopy.ofEq ?_))
  · show (Θ.hom ≫ wcSmsTwMap ρ β' hβlin ≫ Tχ.hom ≫ e.symm.hom) ≫ _ = _
    simp only [Category.assoc]
    rw [hEinv, reassoc_of% hb]
  · show Θ.hom ≫ (wcSmsTwMap ρ (wcSmsBarFrob P n) hAF ≫ wcSmsTwMap ρ β' hβlin) ≫ _ =
