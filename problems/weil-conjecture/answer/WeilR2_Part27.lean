    have hgg : ∀ z : W.left, g' z = g := by
      intro z
      refine AddMonoidHom.ext fun a => ?_
      let cA : ((wcContSheaf (wcP1Over K).left (Fin k → ZMod (ℓ ^ r))).over W).obj.obj
          (Opposite.op (Over.mk (𝟙 W))) := ULift.up (ContinuousMap.const ↥W.left a)
      let s : L.obj.obj (Opposite.op W) := (θr.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom cA
      have hs : (θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s = cA := invhom _ cA
      have ha : (show C(↥W.left, Fin k → ZMod (ℓ ^ r)) from
          ((θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z = a := by
        rw [hs]
        rfl
      have h3 : (show C(↥W.left, Fin k → ZMod (ℓ ^ r)) from
            ((θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W ≫ γ)))).hom s).down) z =
          (show C(↥W.left, Fin k → ZMod (ℓ ^ r)) from
            ((θr.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z := by
        rw [Category.id_comp]
      calc g' z a = g' ((𝟙 W : W ⟶ W).left z) ((show C(↥W.left, Fin k → ZMod (ℓ ^ r)) from
            ((θr.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z) := by
            rw [ha]
            rfl
        _ = _ := (hβpt W (𝟙 W) s z).symm
        _ = _ := h3
        _ = _ := hfr s z
        _ = g a := by rw [ha]
    intro V₁ v x z
    rw [hβpt V₁ v x z, hgg]
  refine hΓinv V c (γ' ≫ c) g hVc ?_ ?_ a'
