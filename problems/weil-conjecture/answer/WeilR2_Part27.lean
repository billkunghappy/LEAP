        · exact Set.disjoint_sdiff_right
        · exact Set.union_sdiff_cancel (Set.singleton_subset_iff.mpr hd)
      choose C hCo hCf using hsplit
      refine ⟨⟨fun x => ∑ d, (C d).indicator (fun _ => c d) x,
        continuous_finsetSum _ (fun d _ => (hCo d).continuous_indicator continuous_const)⟩, ?_⟩
