  have hy' : (z.comp (Abelian.Ext.mk₀ e) (add_zero 2)).comp (Abelian.Ext.mk₀ mq) (add_zero 2) = 0 := by
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 2) (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀,
