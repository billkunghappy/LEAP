theorem wcU_lm_trunc_ker_res (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (L 𝓖 : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (I : InjectiveResolution L) (N : ℕ) (hN : 1 ≤ N) (π : L ⟶ 𝓖)
    (hses : ∃ w : (N • 𝟙 L) ≫ π = 0, (ShortComplex.mk (N • 𝟙 L) π w).ShortExact) :
    ∃ η : 𝓖 ⟶ (wcTruncKerRes I.cocomplex N).X 0,
      wcNTorsRes K hP N 𝓖 (wcTruncKerRes I.cocomplex N) η :=
by
  classical
  obtain ⟨hw, hS⟩ := hses
  have hN0 : 0 < N := by omega
  haveI hmonoL : Mono (N • 𝟙 L) := hS.mono_f
  haveI hepiπ : Epi π := hS.epi_g

  have hcomm : ∀ {A B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (f : A ⟶ B), f ≫ (N • 𝟙 B) = (N • 𝟙 A) ≫ f := by
    intro A B f
    rw [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
  have hepi : ∀ k, Epi (N • 𝟙 (I.cocomplex.X k)) := fun k => by
    haveI := I.injective k
    exact sheaf_injective_nsmul_epi _ (I.cocomplex.X k) N hN0
  have hPm : Mono (N • 𝟙 (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))) :=
    sheaf_free_yoneda_nsmul_mono _ _ N hN0

  let ι : ∀ k, Limits.kernel (N • 𝟙 (I.cocomplex.X k)) ⟶ I.cocomplex.X k :=
    fun k => Limits.kernel.ι (N • 𝟙 (I.cocomplex.X k))
  have hιn : ∀ k, ι k ≫ (N • 𝟙 (I.cocomplex.X k)) = 0 := fun k => Limits.kernel.condition _
  let D : ∀ k, Limits.kernel (N • 𝟙 (I.cocomplex.X k)) ⟶
      Limits.kernel (N • 𝟙 (I.cocomplex.X (k + 1))) := fun k => wcTruncKerD I.cocomplex N k
  have hDι : ∀ k, D k ≫ ι (k + 1) = ι k ≫ I.cocomplex.d k (k + 1) := fun k => by
    simp [D, ι, wcTruncKerD, Limits.kernel.map]
  have hDι0 : D 0 ≫ ι 1 = ι 0 ≫ I.cocomplex.d 0 1 := hDι 0
  have hDι1 : D 1 ≫ ι 2 = ι 1 ≫ I.cocomplex.d 1 2 := hDι 1
  let p : Limits.kernel (N • 𝟙 (I.cocomplex.X 1)) ⟶ Limits.cokernel (D 0) :=
    Limits.cokernel.π (D 0)
  have hDp : D 0 ≫ p = 0 := Limits.cokernel.condition _
  have hJd0 : (wcTruncKerRes I.cocomplex N).d 0 1 = wcTruncKerDiff I.cocomplex N 0 :=
    CochainComplex.of_d (wcTruncKerX I.cocomplex N) (wcTruncKerDiff I.cocomplex N) 0
  have hJdS : ∀ k, (wcTruncKerRes I.cocomplex N).d (k + 1) (k + 2) = D (k + 2) := fun k =>
    CochainComplex.of_d _ _ (k + 1)
  have hpδ0 : p ≫ ((wcTruncKerRes I.cocomplex N).d 0 1 :
      Limits.cokernel (D 0) ⟶ Limits.kernel (N • 𝟙 (I.cocomplex.X 2))) = D 1 := by
    rw [hJd0]
    exact Limits.cokernel.π_desc _ _ _
  let δ : Limits.cokernel (D 0) ⟶ Limits.kernel (N • 𝟙 (I.cocomplex.X 2)) :=
    (wcTruncKerRes I.cocomplex N).d 0 1
  have hpδ : p ≫ δ = D 1 := hpδ0

  let i0 : L ⟶ I.cocomplex.X 0 :=
    (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 L).inv ≫ I.ι.f 0
  haveI : Mono i0 := mono_comp _ _
  have hi0d : i0 ≫ I.cocomplex.d 0 1 = 0 := by
    simp only [i0, Category.assoc, InjectiveResolution.ι_f_zero_comp_complex_d, Limits.comp_zero]
  have hi0comm : i0 ≫ (N • 𝟙 (I.cocomplex.X 0)) = (N • 𝟙 L) ≫ i0 := hcomm i0
  have hY0 : ∀ {A : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (y : A ⟶ I.cocomplex.X 0), y ≫ I.cocomplex.d 0 1 = 0 → ∃ x : A ⟶ L, x ≫ i0 = y := by
    intro A y hy
    refine ⟨I.exact₀.lift y hy ≫
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 L).hom, ?_⟩
    simp only [i0, Category.assoc, Iso.hom_inv_id_assoc]
    exact I.exact₀.lift_f y hy

  haveI hD0 : Mono (D 0) := by
    apply Preadditive.mono_of_cancel_zero
    intro A g hg
    have h1 : (g ≫ ι 0) ≫ I.cocomplex.d 0 1 = 0 := by
      rw [Category.assoc, ← hDι0, ← Category.assoc, hg, Limits.zero_comp]
    obtain ⟨x, hx⟩ := hY0 _ h1
    have h2 : (x ≫ (N • 𝟙 L)) ≫ i0 = 0 := by
      rw [Category.assoc, ← hi0comm, ← Category.assoc, hx, Category.assoc, hιn, Limits.comp_zero]
    have h3 : x ≫ (N • 𝟙 L) = 0 := (cancel_mono i0).mp (by rw [h2, Limits.zero_comp])
    have h4 : x = 0 := (cancel_mono (N • 𝟙 L)).mp (by rw [h3, Limits.zero_comp])
    rw [← cancel_mono (ι 0), Limits.zero_comp, ← hx, h4, Limits.zero_comp]

  have hTk : ∀ k, N • 𝟙 (Limits.kernel (N • 𝟙 (I.cocomplex.X k))) = 0 := by
    intro k
    rw [← cancel_mono (ι k), Limits.zero_comp, ← hcomm]
    exact hιn k
  have hTQ : N • 𝟙 (Limits.cokernel (D 0)) = 0 := by
    rw [← cancel_epi p, Limits.comp_zero, hcomm, hTk 1, Limits.zero_comp]
  have hIk : ∀ k (A B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (mm : A ⟶ B), Mono mm → N • 𝟙 B = 0 →
      ∀ φ : A ⟶ Limits.kernel (N • 𝟙 (I.cocomplex.X k)), ∃ ψ, mm ≫ ψ = φ := by
    intro k A B mm hmm hB φ
    haveI := I.injective k
    have hψ0 : Injective.factorThru (φ ≫ ι k) mm ≫ (N • 𝟙 (I.cocomplex.X k)) = 0 := by
      rw [hcomm, hB, Limits.zero_comp]
    refine ⟨Limits.kernel.lift _ _ hψ0, ?_⟩
    rw [← cancel_mono (ι k), Category.assoc]
    simp only [ι, Limits.kernel.lift_ι]
    exact Injective.comp_factorThru _ _
  obtain ⟨r, hr⟩ := hIk 0 _ _ (D 0) hD0 (hTk 1) (𝟙 _)
  have he : D 0 ≫ (𝟙 _ - r ≫ D 0) = 0 := by
    rw [Preadditive.comp_sub, Category.comp_id, ← Category.assoc, hr, Category.id_comp, sub_self]
  let s : Limits.cokernel (D 0) ⟶ Limits.kernel (N • 𝟙 (I.cocomplex.X 1)) :=
    Limits.cokernel.desc (D 0) _ he
  have hsp : s ≫ p = 𝟙 _ := by
    rw [← cancel_epi p, Category.comp_id, ← Category.assoc]
    simp only [s, p, Limits.cokernel.π_desc]
    rw [Preadditive.sub_comp, Category.id_comp, Category.assoc, Limits.cokernel.condition,
      Limits.comp_zero, sub_zero]

  have hExtK : ∀ k j (x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP)) (Limits.kernel (N • 𝟙 (I.cocomplex.X k))) (j + 1)),
      x = 0 := by
    intro k j x
    haveI := I.injective k
    exact wc_exact_kernel_nsmul_ext_vanish (𝟭 _) _ _ (Iso.refl _) N hPm (I.cocomplex.X k)
      (hepi k) (fun k' x' => Abelian.Ext.eq_zero_of_injective x') j x
  have hExtQ : ∀ j (y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP)) (Limits.cokernel (D 0)) (j + 1)), y = 0 := by
    intro j y
    have h1 : y = (y.comp (Abelian.Ext.mk₀ s) (add_zero _)).comp (Abelian.Ext.mk₀ p)
        (add_zero _) := by
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero _) (add_zero _),
        Abelian.Ext.mk₀_comp_mk₀, hsp, Abelian.Ext.comp_mk₀_id]
    rw [h1, hExtK 1 j (y.comp _ _), Abelian.Ext.zero_comp]

  have hG : ∀ (m : ℕ) {A : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (x : A ⟶ Limits.kernel (N • 𝟙 (I.cocomplex.X (m + 2)))), x ≫ D (m + 2) = 0 →
      ∃ (A' : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
        (πr : A' ⟶ A) (_ : Epi πr) (c : A' ⟶ Limits.kernel (N • 𝟙 (I.cocomplex.X (m + 1)))),
        πr ≫ x = c ≫ D (m + 1) := by
    intro m A x hx
    have h1 : (x ≫ ι (m + 2)) ≫ I.cocomplex.d (m + 2) (m + 3) = 0 := by
      rw [Category.assoc, ← hDι (m + 2), ← Category.assoc, hx, Limits.zero_comp]
    obtain ⟨A1, π1, hπ1, z, hz⟩ := (I.exact_succ (m + 1)).exact_up_to_refinements _ h1
    have hz' : π1 ≫ x ≫ ι (m + 2) = z ≫ I.cocomplex.d (m + 1) (m + 2) := hz
    have h2 : (z ≫ (N • 𝟙 _)) ≫ I.cocomplex.d (m + 1) (m + 2) = 0 := by
      rw [Category.assoc, ← hcomm, ← Category.assoc, ← hz', Category.assoc, Category.assoc,
        hιn, Limits.comp_zero, Limits.comp_zero]
    obtain ⟨A2, π2, hπ2, z0, hz0⟩ := (I.exact_succ m).exact_up_to_refinements _ h2
    have hz0' : π2 ≫ z ≫ (N • 𝟙 _) = z0 ≫ I.cocomplex.d m (m + 1) := hz0
    obtain ⟨A3, π3, hπ3, z0', hz0''⟩ := surjective_up_to_refinements_of_epi
      (N • 𝟙 (I.cocomplex.X m)) z0
    have hc : (π3 ≫ π2 ≫ z - z0' ≫ I.cocomplex.d m (m + 1)) ≫ (N • 𝟙 _) = 0 := by
      rw [Preadditive.sub_comp, Category.assoc, Category.assoc, hz0', Category.assoc,
        hcomm (I.cocomplex.d m (m + 1)), ← Category.assoc z0', ← hz0'', Category.assoc, sub_self]
    refine ⟨A3, π3 ≫ π2 ≫ π1, inferInstance, Limits.kernel.lift _ _ hc, ?_⟩
    have hDι' : D (m + 1) ≫ ι (m + 2) = ι (m + 1) ≫ I.cocomplex.d (m + 1) (m + 2) := hDι (m + 1)
    have hlift : Limits.kernel.lift _ _ hc ≫ ι (m + 1) =
        π3 ≫ π2 ≫ z - z0' ≫ I.cocomplex.d m (m + 1) := Limits.kernel.lift_ι _ _ _
    rw [← cancel_mono (ι (m + 2)), Category.assoc (Limits.kernel.lift _ _ hc), hDι',
      ← Category.assoc (Limits.kernel.lift _ _ hc), hlift, Preadditive.sub_comp,
      Category.assoc z0', HomologicalComplex.d_comp_d, Limits.comp_zero, sub_zero]
    simp only [Category.assoc]
    rw [hz']

  let fst : Limits.pullback (N • 𝟙 (I.cocomplex.X 0)) i0 ⟶ I.cocomplex.X 0 :=
    Limits.pullback.fst _ _
  let snd : Limits.pullback (N • 𝟙 (I.cocomplex.X 0)) i0 ⟶ L := Limits.pullback.snd _ _
  have hcond : fst ≫ (N • 𝟙 (I.cocomplex.X 0)) = snd ≫ i0 := Limits.pullback.condition
  haveI hsnd : Epi snd := by
    haveI := hepi 0
    exact Abelian.epi_pullback_of_epi_f _ _
  have hu : (fst ≫ I.cocomplex.d 0 1) ≫ (N • 𝟙 (I.cocomplex.X 1)) = 0 := by
    rw [Category.assoc, hcomm (I.cocomplex.d 0 1), ← Category.assoc, hcond, Category.assoc,
      hi0d, Limits.comp_zero]
  let u' : Limits.pullback (N • 𝟙 (I.cocomplex.X 0)) i0 ⟶
      Limits.kernel (N • 𝟙 (I.cocomplex.X 1)) := Limits.kernel.lift _ _ hu
  have hu'ι : u' ≫ ι 1 = fst ≫ I.cocomplex.d 0 1 := Limits.kernel.lift_ι _ _ _
  have hθ'z : Limits.kernel.ι snd ≫ (u' ≫ p) = 0 := by
    have hw : (Limits.kernel.ι snd ≫ fst) ≫ (N • 𝟙 (I.cocomplex.X 0)) = 0 := by
      rw [Category.assoc, hcond, ← Category.assoc, Limits.kernel.condition, Limits.zero_comp]
    have h2 : Limits.kernel.ι snd ≫ u' = Limits.kernel.lift _ _ hw ≫ D 0 := by
      rw [← cancel_mono (ι 1), Category.assoc, Category.assoc, hu'ι, hDι0, ← Category.assoc
        (Limits.kernel.lift _ _ hw)]
      simp only [ι, Limits.kernel.lift_ι, Category.assoc]
    rw [← Category.assoc, h2, Category.assoc, hDp, Limits.comp_zero]
  let θ : L ⟶ Limits.cokernel (D 0) := Abelian.epiDesc snd (u' ≫ p) hθ'z
  have hsθ : snd ≫ θ = u' ≫ p := Abelian.comp_epiDesc _ _ _
  have hθn : (N • 𝟙 L) ≫ θ = 0 := by
    let sL : L ⟶ Limits.pullback (N • 𝟙 (I.cocomplex.X 0)) i0 :=
      Limits.pullback.lift i0 (N • 𝟙 L) hi0comm
    have h1 : sL ≫ u' = 0 := by
      rw [← cancel_mono (ι 1), Category.assoc, hu'ι, Limits.zero_comp, ← Category.assoc]
      simp only [sL, fst, Limits.pullback.lift_fst]
      exact hi0d
    have h2 : N • 𝟙 L = sL ≫ snd := (Limits.pullback.lift_snd _ _ _).symm
    rw [h2, Category.assoc, hsθ, ← Category.assoc, h1, Limits.zero_comp]
  obtain ⟨η, hπη⟩ := Limits.CokernelCofork.IsColimit.desc' hS.gIsCokernel θ hθn
  have hπη' : π ≫ η = θ := hπη

  have hu'D : u' ≫ D 1 = 0 := by
    rw [← cancel_mono (ι 2), Category.assoc, hDι1, ← Category.assoc, hu'ι, Category.assoc,
      HomologicalComplex.d_comp_d, Limits.comp_zero, Limits.zero_comp]
  have hθδ : θ ≫ δ = 0 := by
    rw [← cancel_epi snd, Limits.comp_zero, ← Category.assoc, hsθ, Category.assoc, hpδ]
    exact hu'D
  have hηδ' : η ≫ δ = 0 := by
    rw [← cancel_epi π, Limits.comp_zero, ← Category.assoc, hπη']
    exact hθδ
  have hηδ : η ≫ (wcTruncKerRes I.cocomplex N).d 0 1 = 0 := hηδ'

  have hmonoη : Mono η := by
    apply Preadditive.mono_of_cancel_zero
    intro A g hg
    obtain ⟨A1, π1, hπ1, x, hx⟩ := surjective_up_to_refinements_of_epi π g
    obtain ⟨A2, π2, hπ2, q, hq⟩ := surjective_up_to_refinements_of_epi snd x
    have h3 : (q ≫ u') ≫ p = 0 := by
      calc (q ≫ u') ≫ p = q ≫ snd ≫ θ := by rw [hsθ, Category.assoc]
        _ = π2 ≫ x ≫ π ≫ η := by rw [hπη', ← Category.assoc, ← hq, Category.assoc]
        _ = π2 ≫ π1 ≫ g ≫ η := by rw [← Category.assoc x, ← hx, Category.assoc]
        _ = 0 := by rw [hg, Limits.comp_zero, Limits.comp_zero]
    obtain ⟨A3, π3, hπ3, w, hw'⟩ :=
      (ShortComplex.exact_cokernel (D 0)).exact_up_to_refinements (q ≫ u') h3
    have hw'' : π3 ≫ q ≫ u' = w ≫ D 0 := hw'
    have hyd : (π3 ≫ q ≫ fst - w ≫ ι 0) ≫ I.cocomplex.d 0 1 = 0 := by
      have e : (π3 ≫ q ≫ fst) ≫ I.cocomplex.d 0 1 = (w ≫ ι 0) ≫ I.cocomplex.d 0 1 := by
        calc (π3 ≫ q ≫ fst) ≫ I.cocomplex.d 0 1 = (π3 ≫ q ≫ u') ≫ ι 1 := by
              simp only [Category.assoc, hu'ι]
          _ = (w ≫ D 0) ≫ ι 1 := by rw [hw'']
          _ = (w ≫ ι 0) ≫ I.cocomplex.d 0 1 := by simp only [Category.assoc, hDι0]
      rw [Preadditive.sub_comp, e, sub_self]
    obtain ⟨x4, hx4⟩ := hY0 _ hyd
    have h5 : π3 ≫ q ≫ snd = x4 ≫ (N • 𝟙 L) := by
      rw [← cancel_mono i0]
      calc (π3 ≫ q ≫ snd) ≫ i0 = (π3 ≫ q ≫ fst) ≫ (N • 𝟙 (I.cocomplex.X 0)) := by
            simp only [Category.assoc, hcond]
        _ = (π3 ≫ q ≫ fst - w ≫ ι 0) ≫ (N • 𝟙 (I.cocomplex.X 0)) := by
            rw [Preadditive.sub_comp, Category.assoc w, hιn, Limits.comp_zero, sub_zero]
        _ = (x4 ≫ (N • 𝟙 L)) ≫ i0 := by rw [← hx4, Category.assoc, hi0comm, Category.assoc]
    have h6 : π3 ≫ π2 ≫ π1 ≫ g = 0 := by
      have e1 : π3 ≫ π2 ≫ π1 ≫ g = (π3 ≫ q ≫ snd) ≫ π := by
        rw [hx, ← Category.assoc π2, hq]
        simp only [Category.assoc]
      rw [e1, h5, Category.assoc, hw, Limits.comp_zero]
    apply (cancel_epi π1).mp
    apply (cancel_epi π2).mp
    apply (cancel_epi π3).mp
    rw [Limits.comp_zero, Limits.comp_zero, Limits.comp_zero]
    exact h6

  have hexact : (ShortComplex.mk η ((wcTruncKerRes I.cocomplex N).d 0 1) hηδ).Exact := by
    rw [ShortComplex.exact_iff_exact_up_to_refinements]
    intro A x hx
    have hx' : x ≫ δ = 0 := hx
    obtain ⟨A1, π1, hπ1, x', hx1⟩ := surjective_up_to_refinements_of_epi p x
    have h1 : x' ≫ D 1 = 0 := by
      rw [← hpδ, ← Category.assoc, ← hx1, Category.assoc, hx', Limits.comp_zero]
    have h2 : (x' ≫ ι 1) ≫ I.cocomplex.d 1 2 = 0 := by
      rw [Category.assoc, ← hDι1, ← Category.assoc, h1, Limits.zero_comp]
    obtain ⟨A2, π2, hπ2, z, hz⟩ := (I.exact_succ 0).exact_up_to_refinements _ h2
    have hz' : π2 ≫ x' ≫ ι 1 = z ≫ I.cocomplex.d 0 1 := hz
    have h3 : (z ≫ (N • 𝟙 _)) ≫ I.cocomplex.d 0 1 = 0 := by
      rw [Category.assoc, ← hcomm, ← Category.assoc, ← hz', Category.assoc, Category.assoc,
        hιn, Limits.comp_zero, Limits.comp_zero]
    obtain ⟨x0, hx0⟩ := hY0 _ h3
    let q : A2 ⟶ Limits.pullback (N • 𝟙 (I.cocomplex.X 0)) i0 :=
      Limits.pullback.lift z x0 hx0.symm
    have hqf : q ≫ fst = z := Limits.pullback.lift_fst _ _ _
    have hqs : q ≫ snd = x0 := Limits.pullback.lift_snd _ _ _
    have hqu : q ≫ u' = π2 ≫ x' := by
      rw [← cancel_mono (ι 1), Category.assoc, hu'ι, ← Category.assoc, hqf, ← hz',
        Category.assoc]
    refine ⟨A2, π2 ≫ π1, inferInstance, x0 ≫ π, ?_⟩
    show (π2 ≫ π1) ≫ x = (x0 ≫ π) ≫ η
    rw [Category.assoc, hx1, ← Category.assoc, ← hqu, Category.assoc, ← hsθ, ← Category.assoc,
      hqs, Category.assoc, hπη']

  refine ⟨η, ?_, hmonoη, ⟨hηδ, hexact⟩, ?_, ?_, ?_⟩
  · intro i
    rw [natCast_zsmul]
    cases i with
    | zero => exact hTQ
    | succ k => exact hTk (k + 2)
  · intro i
    show (wcTruncKerRes I.cocomplex N).ExactAt (i + 1)
    rw [HomologicalComplex.exactAt_iff' _ i (i + 1) (i + 2) (by simp) (by simp),
      ShortComplex.exact_iff_exact_up_to_refinements]
    intro A x hx
    cases i with
    | zero =>
      have hx' : (x : A ⟶ Limits.kernel (N • 𝟙 (I.cocomplex.X 2))) ≫ D 2 = 0 := by
        have := hx
        simp only [HomologicalComplex.shortComplexFunctor'_obj_g] at this
        rw [hJdS 0] at this
        exact this
      obtain ⟨A', πr, hπr, c, hc⟩ := hG 0 x hx'
      refine ⟨A', πr, hπr, c ≫ p, ?_⟩
      show πr ≫ x = (c ≫ p) ≫ δ
      rw [Category.assoc, hpδ]
      exact hc
    | succ k =>
      have hx' : (x : A ⟶ Limits.kernel (N • 𝟙 (I.cocomplex.X (k + 3)))) ≫ D (k + 3) = 0 := by
        have := hx
        simp only [HomologicalComplex.shortComplexFunctor'_obj_g] at this
        rw [hJdS (k + 1)] at this
        exact this
      obtain ⟨A', πr, hπr, c, hc⟩ := hG (k + 1) x hx'
      refine ⟨A', πr, hπr, c, ?_⟩
      simp only [HomologicalComplex.shortComplexFunctor'_obj_f]
      rw [hJdS k]
      exact hc
  · intro i A B mm hmm hB φ
    rw [natCast_zsmul] at hB
    cases i with
    | zero =>
      obtain ⟨ψ1, hψ1⟩ := hIk 1 A B mm hmm hB
        ((φ : A ⟶ Limits.cokernel (D 0)) ≫ s)
      refine ⟨ψ1 ≫ p, ?_⟩
      have e : mm ≫ ψ1 ≫ p = ((φ : A ⟶ Limits.cokernel (D 0)) ≫ s) ≫ p :=
        (Category.assoc _ _ _).symm.trans (congrArg (fun t => t ≫ p) hψ1)
      have e2 : ((φ : A ⟶ Limits.cokernel (D 0)) ≫ s) ≫ p = φ :=
        (Category.assoc _ _ _).trans
          ((congrArg (fun t => (φ : A ⟶ Limits.cokernel (D 0)) ≫ t) hsp).trans
            (Category.comp_id _))
      exact e.trans e2
    | succ k => exact hIk (k + 2) A B mm hmm hB φ
  · intro i j hj y
    obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
    cases i with
    | zero => exact hExtQ j' y
    | succ k => exact hExtK (k + 2) j' y

theorem wcSpfR_trunc_relinj {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {R : Type*} [Ring R]
    (L : 𝒜) (lamL : R → (L ⟶ L)) (I : InjectiveResolution L)
    (lamI : R → (I.cocomplex ⟶ I.cocomplex)) (hI : wcRingResSpec lamL I lamI)
    (N : ℕ) (hN : 1 ≤ N) (hmono : Mono (N • 𝟙 L)) :
    ∀ k, wcRingAct (fun x => (wcSpfTruncMap I.cocomplex N (lamI x)).f k) ∧
      ((N : ℕ) : ℤ) • 𝟙 ((wcTruncKerRes I.cocomplex N).X k) = 0 ∧
      wcSpfRelInj N (fun x => (wcSpfTruncMap I.cocomplex N (lamI x)).f k) :=
by
  classical

  have hcomm : ∀ {A B : 𝒜} (f : A ⟶ B), f ≫ (N • 𝟙 B) = (N • 𝟙 A) ≫ f := by
    intro A B f
    rw [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]

  have hKM : ∀ (g : I.cocomplex ⟶ I.cocomplex) (j : ℕ),
      wcSpfKerMap I.cocomplex N g j ≫ Limits.kernel.ι (N • 𝟙 (I.cocomplex.X j)) =
        Limits.kernel.ι (N • 𝟙 (I.cocomplex.X j)) ≫ g.f j := fun g j =>
    Limits.kernel.lift_ι _ _ _
  have hKMa : ∀ (g : I.cocomplex ⟶ I.cocomplex) (j : ℕ) {Z : 𝒜} (h : I.cocomplex.X j ⟶ Z),
      wcSpfKerMap I.cocomplex N g j ≫ Limits.kernel.ι (N • 𝟙 (I.cocomplex.X j)) ≫ h =
        Limits.kernel.ι (N • 𝟙 (I.cocomplex.X j)) ≫ g.f j ≫ h := fun g j Z h => by
    rw [← Category.assoc, hKM, Category.assoc]
  have hKD : ∀ j : ℕ, wcTruncKerD I.cocomplex N j ≫ Limits.kernel.ι (N • 𝟙 (I.cocomplex.X (j + 1))) =
      Limits.kernel.ι (N • 𝟙 (I.cocomplex.X j)) ≫ I.cocomplex.d j (j + 1) := fun j =>
    Limits.kernel.lift_ι _ _ _
  have hKDa : ∀ (j : ℕ) {Z : 𝒜} (h : I.cocomplex.X (j + 1) ⟶ Z),
      wcTruncKerD I.cocomplex N j ≫ Limits.kernel.ι (N • 𝟙 (I.cocomplex.X (j + 1))) ≫ h =
        Limits.kernel.ι (N • 𝟙 (I.cocomplex.X j)) ≫ I.cocomplex.d j (j + 1) ≫ h :=
    fun j Z h => by
      rw [← Category.assoc, hKD, Category.assoc]

  have s1 : ∀ j, wcRingAct (fun x => wcSpfKerMap I.cocomplex N (lamI x) j) := by
    intro j
    refine ⟨?_, ?_, ?_⟩
    · show wcSpfKerMap I.cocomplex N (lamI 1) j = 𝟙 _
      rw [← cancel_mono (Limits.kernel.ι (N • 𝟙 (I.cocomplex.X j))), hKM, hI.1.1,
        HomologicalComplex.id_f, Category.comp_id, Category.id_comp]
    · intro a b
      show wcSpfKerMap I.cocomplex N (lamI (a + b)) j =
        wcSpfKerMap I.cocomplex N (lamI a) j + wcSpfKerMap I.cocomplex N (lamI b) j
      rw [← cancel_mono (Limits.kernel.ι (N • 𝟙 (I.cocomplex.X j))), Preadditive.add_comp,
        hKM, hKM, hKM, hI.1.2.1, HomologicalComplex.add_f_apply, Preadditive.comp_add]
    · intro a b
      show wcSpfKerMap I.cocomplex N (lamI (a * b)) j =
        wcSpfKerMap I.cocomplex N (lamI b) j ≫ wcSpfKerMap I.cocomplex N (lamI a) j
      rw [← cancel_mono (Limits.kernel.ι (N • 𝟙 (I.cocomplex.X j))), Category.assoc, hKM,
        hKM, hKMa, hI.1.2.2, HomologicalComplex.comp_f]
  have s1D : ∀ (j : ℕ) (x : R), wcTruncKerD I.cocomplex N j ≫
      wcSpfKerMap I.cocomplex N (lamI x) (j + 1) =
      wcSpfKerMap I.cocomplex N (lamI x) j ≫ wcTruncKerD I.cocomplex N j := by
    intro j x
    rw [← cancel_mono (Limits.kernel.ι (N • 𝟙 (I.cocomplex.X (j + 1)))), Category.assoc,
      Category.assoc, hKM, hKD, hKDa, hKMa, HomologicalComplex.Hom.comm]

  have s2t : ∀ j, ((N : ℕ) : ℤ) • 𝟙 (Limits.kernel (N • 𝟙 (I.cocomplex.X j))) = 0 := by
    intro j
    rw [natCast_zsmul, ← cancel_mono (Limits.kernel.ι (N • 𝟙 (I.cocomplex.X j))),
      Limits.zero_comp, ← hcomm]
    exact Limits.kernel.condition _
  have s2r : ∀ j, wcSpfRelInj N (fun x => wcSpfKerMap I.cocomplex N (lamI x) j) := by
    intro j W' W i hi hW lamW' lamW hW' hWa hiq g hg
    haveI : Mono i := hi
    have hg2 : ∀ x, lamW' x ≫ g = g ≫ wcSpfKerMap I.cocomplex N (lamI x) j := hg
    have hg' : ∀ x, lamW' x ≫ (g ≫ Limits.kernel.ι (N • 𝟙 (I.cocomplex.X j))) =
        (g ≫ Limits.kernel.ι (N • 𝟙 (I.cocomplex.X j))) ≫ (lamI x).f j := by
      intro x
      rw [← Category.assoc, hg2 x, Category.assoc, hKM, Category.assoc]
    obtain ⟨h', hh'1, hh'2⟩ := hI.2.2 j i lamW' lamW hW' hWa hiq _ hg'
    have hWn : N • 𝟙 W = 0 := by rw [← natCast_zsmul]; exact hW
    have hh'0 : h' ≫ (N • 𝟙 (I.cocomplex.X j)) = 0 := by
      rw [hcomm, hWn, Limits.zero_comp]
    refine ⟨Limits.kernel.lift _ h' hh'0, ?_, ?_⟩
    · rw [← cancel_mono (Limits.kernel.ι (N • 𝟙 (I.cocomplex.X j))), Category.assoc,
        Limits.kernel.lift_ι, hh'1]
    · intro x
      show lamW x ≫ Limits.kernel.lift _ h' hh'0 =
        Limits.kernel.lift _ h' hh'0 ≫ wcSpfKerMap I.cocomplex N (lamI x) j
      rw [← cancel_mono (Limits.kernel.ι (N • 𝟙 (I.cocomplex.X j))), Category.assoc,
        Limits.kernel.lift_ι, Category.assoc, hKM, ← Category.assoc, Limits.kernel.lift_ι, hh'2]

  have hKD0 : wcTruncKerD I.cocomplex N 0 ≫ Limits.kernel.ι (N • 𝟙 (I.cocomplex.X 1)) =
      Limits.kernel.ι (N • 𝟙 (I.cocomplex.X 0)) ≫ I.cocomplex.d 0 1 := hKD 0
  have hD0 : Mono (wcTruncKerD I.cocomplex N 0) := by
    let i0 : L ⟶ I.cocomplex.X 0 :=
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 L).inv ≫ I.ι.f 0
    haveI : Mono i0 := mono_comp _ _
    have hi0comm : i0 ≫ (N • 𝟙 (I.cocomplex.X 0)) = (N • 𝟙 L) ≫ i0 := hcomm i0
    have hY0 : ∀ {A : 𝒜} (y : A ⟶ I.cocomplex.X 0), y ≫ I.cocomplex.d 0 1 = 0 →
        ∃ x : A ⟶ L, x ≫ i0 = y := by
      intro A y hy
      refine ⟨I.exact₀.lift y hy ≫
        (HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 L).hom, ?_⟩
      simp only [i0, Category.assoc, Iso.hom_inv_id_assoc]
      exact I.exact₀.lift_f y hy
    apply Preadditive.mono_of_cancel_zero
    intro A g hg
    have h1 : (g ≫ Limits.kernel.ι (N • 𝟙 (I.cocomplex.X 0))) ≫ I.cocomplex.d 0 1 = 0 := by
      rw [Category.assoc, ← hKD0, ← Category.assoc, hg, Limits.zero_comp]
    obtain ⟨x, hx⟩ := hY0 _ h1
    have h2 : (x ≫ (N • 𝟙 L)) ≫ i0 = 0 := by
      rw [Category.assoc, ← hi0comm, ← Category.assoc, hx, Category.assoc,
        Limits.kernel.condition, Limits.comp_zero]
    have h3 : x ≫ (N • 𝟙 L) = 0 := (cancel_mono i0).mp (by rw [h2, Limits.zero_comp])
    have h4 : x = 0 := (cancel_mono (N • 𝟙 L)).mp (by rw [h3, Limits.zero_comp])
    rw [← cancel_mono (Limits.kernel.ι (N • 𝟙 (I.cocomplex.X 0))), Limits.zero_comp, ← hx, h4,
      Limits.zero_comp]

  have s4 : ∀ {K0 K1 : 𝒜} (D : K0 ⟶ K1), Mono D →
      ∀ (lam0 : R → (K0 ⟶ K0)) (lam1 : R → (K1 ⟶ K1)),
      wcRingAct lam0 → wcRingAct lam1 → (∀ x, D ≫ lam1 x = lam0 x ≫ D) →
      ((N : ℕ) : ℤ) • 𝟙 K1 = 0 → wcSpfRelInj N lam0 → wcSpfRelInj N lam1 →
      ∀ (lamQ : R → (Limits.cokernel D ⟶ Limits.cokernel D)),
      (∀ x, Limits.cokernel.π D ≫ lamQ x = lam1 x ≫ Limits.cokernel.π D) →
      wcRingAct lamQ ∧ ((N : ℕ) : ℤ) • 𝟙 (Limits.cokernel D) = 0 ∧ wcSpfRelInj N lamQ := by
    intro K0 K1 D hD lam0 lam1 h0 h1 hDeq ht1 hr0 hr1 lamQ hQ
    have hact : wcRingAct lamQ := by
      refine ⟨?_, ?_, ?_⟩
      · apply (cancel_epi (Limits.cokernel.π D)).1
        rw [hQ 1, h1.1, Category.id_comp, Category.comp_id]
      · intro a b
        apply (cancel_epi (Limits.cokernel.π D)).1
        rw [hQ (a + b), h1.2.1, Preadditive.comp_add, hQ a, hQ b, Preadditive.add_comp]
      · intro a b
        apply (cancel_epi (Limits.cokernel.π D)).1
        rw [hQ (a * b), h1.2.2, Category.assoc, ← hQ a, ← Category.assoc, ← hQ b,
          Category.assoc]

    obtain ⟨ρ0, hρD, hρeq⟩ := hr0 D hD ht1 lam0 lam1 h0 h1 (fun x => (hDeq x).symm) (𝟙 K0)
      (fun x => by rw [Category.comp_id, Category.id_comp])
    have he : D ≫ (𝟙 K1 - ρ0 ≫ D) = 0 := by
      rw [Preadditive.comp_sub, Category.comp_id, ← Category.assoc, hρD, Category.id_comp,
        sub_self]
    let s : Limits.cokernel D ⟶ K1 := Limits.cokernel.desc D _ he
    have hπs : Limits.cokernel.π D ≫ s = 𝟙 K1 - ρ0 ≫ D := Limits.cokernel.π_desc _ _ _
    have hsπ : s ≫ Limits.cokernel.π D = 𝟙 _ := by
      apply (cancel_epi (Limits.cokernel.π D)).1
      rw [← Category.assoc, hπs, Preadditive.sub_comp, Category.id_comp, Category.assoc,
        Limits.cokernel.condition, Limits.comp_zero, sub_zero, Category.comp_id]
    have hseq : ∀ x, lamQ x ≫ s = s ≫ lam1 x := by
      intro x
      apply (cancel_epi (Limits.cokernel.π D)).1
      rw [← Category.assoc, hQ x, Category.assoc, hπs, ← Category.assoc, hπs,
        Preadditive.comp_sub, Preadditive.sub_comp, Category.comp_id, Category.id_comp,
        ← Category.assoc, hρeq x, Category.assoc, Category.assoc, ← hDeq x]
    refine ⟨hact, ?_, ?_⟩
    · apply (cancel_epi (Limits.cokernel.π D)).1
      rw [Preadditive.comp_zsmul, Category.comp_id, Limits.comp_zero,
        ← Category.id_comp (Limits.cokernel.π D), ← Preadditive.zsmul_comp, ht1,
        Limits.zero_comp]
    · intro W' W i hi hW lamW' lamW hW' hWa hiq g hg
      obtain ⟨h1', hh1, hh2⟩ := hr1 i hi hW lamW' lamW hW' hWa hiq (g ≫ s) (fun x => by
        rw [← Category.assoc, hg x, Category.assoc, hseq x, Category.assoc])
      refine ⟨h1' ≫ Limits.cokernel.π D, ?_, ?_⟩
      · rw [← Category.assoc, hh1, Category.assoc, hsπ, Category.comp_id]
      · intro x
        rw [← Category.assoc, hh2 x, Category.assoc, Category.assoc, ← hQ x]

  intro k
  cases k with
  | zero =>
    exact s4 (wcTruncKerD I.cocomplex N 0) hD0
      (fun x => wcSpfKerMap I.cocomplex N (lamI x) 0)
      (fun x => wcSpfKerMap I.cocomplex N (lamI x) 1) (s1 0) (s1 1) (fun x => s1D 0 x)
      (s2t 1) (s2r 0) (s2r 1)
      (fun x => (wcSpfTruncMap I.cocomplex N (lamI x)).f 0)
      (fun x => Limits.cokernel.π_desc _ _ _)
  | succ k =>
    exact ⟨s1 (k + 2), s2t (k + 2), s2r (k + 2)⟩

theorem wcSpfR_tw_relinj {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {Γ : Type u} [Group Γ] [Fintype Γ] (n r : ℕ) (hn : 1 ≤ n)
    (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (A : 𝒜) (lamA : MonoidAlgebra ℤ_[ℓ] Γ → (A ⟶ A))
    (hlam : wcRingAct lamA) (htor : ((ℓ ^ n : ℕ) : ℤ) • 𝟙 A = 0)
    (hrel : wcSpfRelInj (ℓ ^ n) lamA) :
    ∀ (B' B : 𝒜) (mm : B' ⟶ B), Mono mm → ((ℓ ^ n : ℕ) : ℤ) • 𝟙 B = 0 →
      ∀ φ : B' ⟶ wcSpfTw A lamA ρ, ∃ ψ : B ⟶ wcSpfTw A lamA ρ, mm ≫ ψ = φ :=
by
  intro B' B mm hmm hB φ
  haveI : Fact (1 < ℓ ^ n) := ⟨Nat.one_lt_pow (by omega) (Fact.out : ℓ.Prime).one_lt⟩
  haveI : NeZero (ℓ ^ n) := ⟨(pow_pos (Fact.out : ℓ.Prime).pos n).ne'⟩

  have htc : ∀ {Y Z : 𝒜} (f : Y ⟶ Z), (ℓ ^ n) • 𝟙 Z = 0 → (ℓ ^ n) • f = 0 := by
    intro Y Z f hZ
    rw [← Category.comp_id f, ← Preadditive.comp_nsmul, hZ, Limits.comp_zero]
  have modF : ∀ {Y Z : 𝒜} (f : Y ⟶ Z), (ℓ ^ n) • f = 0 → ∀ m : ℕ, m • f = (m % ℓ ^ n) • f := by
    intro Y Z f hf m
    have hk : ∀ k : ℕ, (ℓ ^ n * k) • f = 0 := by
      intro k
      induction k with
      | zero => rw [Nat.mul_zero, zero_nsmul]
      | succ k ih => rw [Nat.mul_succ, add_nsmul, ih, hf, add_zero]
    conv_lhs => rw [← Nat.mod_add_div m (ℓ ^ n)]
    rw [add_nsmul, hk, add_zero]
  have hWt : ∀ (X : 𝒜), (ℓ ^ n) • 𝟙 X = 0 → (ℓ ^ n) • 𝟙 (∏ᶜ fun _ : Fin r => X) = 0 := by
    intro X hX
    apply Limits.Pi.hom_ext
    intro j
    rw [Preadditive.nsmul_comp, Category.id_comp, Limits.zero_comp]
    exact htc _ hX
  have hBn : (ℓ ^ n) • 𝟙 B = 0 := by rwa [natCast_zsmul] at hB
  have htorn : (ℓ ^ n) • 𝟙 A = 0 := by rwa [natCast_zsmul] at htor
  have hB'n : (ℓ ^ n) • 𝟙 B' = 0 := by
    haveI : Mono mm := hmm
    refine (cancel_mono mm).1 ?_
    rw [Preadditive.nsmul_comp, Category.id_comp, Limits.zero_comp]
    exact htc mm hBn

  have L0 : ∀ {Z : 𝒜} (lam : MonoidAlgebra ℤ_[ℓ] Γ → (Z ⟶ Z)), wcRingAct lam → lam 0 = 0 := by
    intro Z lam h
    have e := h.2.1 0 0
    rw [add_zero] at e
    calc lam 0 = lam 0 + lam 0 - lam 0 := by rw [add_sub_cancel_right]
      _ = 0 := by rw [← e, sub_self]
  have SF : ∀ {Z : 𝒜} (lam : MonoidAlgebra ℤ_[ℓ] Γ → (Z ⟶ Z)), wcRingAct lam →
      (ℓ ^ n) • 𝟙 Z = 0 → ∀ a : ℤ_[ℓ],
      lam (MonoidAlgebra.single 1 a) = (PadicInt.toZModPow (p := ℓ) n a).val • 𝟙 Z := by
    intro Z lam h hZ a
    have lamN : ∀ k : ℕ, lam (k : MonoidAlgebra ℤ_[ℓ] Γ) = k • 𝟙 Z := by
      intro k
      induction k with
      | zero => rw [Nat.cast_zero, L0 lam h, zero_nsmul]
      | succ k ih => rw [Nat.cast_succ, h.2.1, ih, h.1, succ_nsmul]
    obtain ⟨k, hk⟩ : ∃ k : ℕ, k = (PadicInt.toZModPow (p := ℓ) n a).val := ⟨_, rfl⟩
    have hker : a - (k : ℤ_[ℓ]) ∈ RingHom.ker (PadicInt.toZModPow (p := ℓ) n) := by
      rw [RingHom.mem_ker, map_sub, map_natCast, hk, ZMod.natCast_zmod_val, sub_self]
    rw [PadicInt.ker_toZModPow] at hker
    obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp hker
    have ha : a = (k : ℤ_[ℓ]) + t * ((ℓ ^ n : ℕ) : ℤ_[ℓ]) := by
      rw [Nat.cast_pow, ht]; ring
    have hs : MonoidAlgebra.single (1 : Γ) a = (k : MonoidAlgebra ℤ_[ℓ] Γ) +
        MonoidAlgebra.single 1 t * ((ℓ ^ n : ℕ) : MonoidAlgebra ℤ_[ℓ] Γ) := by
      rw [MonoidAlgebra.natCast_def, MonoidAlgebra.natCast_def, MonoidAlgebra.single_mul_single,
        mul_one, ← MonoidAlgebra.single_add, ← ha]
    rw [hs, h.2.1, h.2.2, lamN, lamN, hZ, Limits.zero_comp, add_zero, hk]
  have SG : ∀ {Z : 𝒜} (lam : MonoidAlgebra ℤ_[ℓ] Γ → (Z ⟶ Z)), wcRingAct lam →
      (ℓ ^ n) • 𝟙 Z = 0 → ∀ (g : Γ) (a : ℤ_[ℓ]), lam (MonoidAlgebra.single g a) =
        (PadicInt.toZModPow (p := ℓ) n a).val • lam (MonoidAlgebra.single g 1) := by
    intro Z lam h hZ g a
    have e : MonoidAlgebra.single g a = MonoidAlgebra.single 1 a * MonoidAlgebra.single g 1 := by
      rw [MonoidAlgebra.single_mul_single, one_mul, mul_one]
    rw [e, h.2.2, SF lam h hZ, Preadditive.comp_nsmul, Category.comp_id]
  have EQ : ∀ {X Y : 𝒜} (lamX : MonoidAlgebra ℤ_[ℓ] Γ → (X ⟶ X))
      (lamY : MonoidAlgebra ℤ_[ℓ] Γ → (Y ⟶ Y)), wcRingAct lamX → wcRingAct lamY →
      (ℓ ^ n) • 𝟙 X = 0 → (ℓ ^ n) • 𝟙 Y = 0 → ∀ f : X ⟶ Y,
      (∀ g : Γ, lamX (MonoidAlgebra.single g 1) ≫ f = f ≫ lamY (MonoidAlgebra.single g 1)) →
      ∀ x, lamX x ≫ f = f ≫ lamY x := by
    intro X Y lamX lamY hX hY htX htY f hf x
    refine MonoidAlgebra.induction_linear x ?_ ?_ ?_
    · rw [L0 lamX hX, L0 lamY hY, Limits.zero_comp, Limits.comp_zero]
    · intro x y ihx ihy
      rw [hX.2.1, hY.2.1, Preadditive.add_comp, Preadditive.comp_add, ihx, ihy]
    · intro g a
      rw [SG lamX hX htX, SG lamY hY htY, Preadditive.nsmul_comp, Preadditive.comp_nsmul, hf]

  have MAT : ∀ (X : 𝒜), (ℓ ^ n) • 𝟙 X = 0 → ∃ lamW : MonoidAlgebra ℤ_[ℓ] Γ →
      ((∏ᶜ fun _ : Fin r => X) ⟶ ∏ᶜ fun _ : Fin r => X),
      wcRingAct lamW ∧ ∀ (g : Γ) (i : Fin r),
        lamW (MonoidAlgebra.single g 1) ≫ Limits.Pi.π (fun _ : Fin r => X) i =
        ∑ j : Fin r, ((ρ g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) i j).val •
          Limits.Pi.π (fun _ : Fin r => X) j := by
    intro X hX
    obtain ⟨act, hact⟩ : ∃ act : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)) →
        ((∏ᶜ fun _ : Fin r => X) ⟶ ∏ᶜ fun _ : Fin r => X), ∀ P i,
        act P ≫ Limits.Pi.π (fun _ : Fin r => X) i =
          ∑ j, (P i j).val • Limits.Pi.π (fun _ : Fin r => X) j :=
      ⟨fun P => Limits.Pi.lift (fun i => ∑ j, (P i j).val • Limits.Pi.π (fun _ : Fin r => X) j),
        fun P i => by simp⟩
    obtain ⟨M, hM⟩ : ∃ M : MonoidAlgebra ℤ_[ℓ] Γ →+* Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)),
        ∀ g : Γ, M (MonoidAlgebra.single g 1) = (ρ g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) :=
      ⟨MonoidAlgebra.liftNCRingHom ((Matrix.scalar (Fin r)).comp (PadicInt.toZModPow (p := ℓ) n))
        ((Units.coeHom _).comp ρ) (fun x y => Matrix.scalar_commute _ (fun r' => Commute.all _ _) _),
        fun g => by rw [MonoidAlgebra.liftNCRingHom_single]; simp⟩
    have act1 : act 1 = 𝟙 _ := by
      apply Limits.Pi.hom_ext
      intro i
      rw [hact, Category.id_comp, Finset.sum_eq_single i]
      · rw [Matrix.one_apply_eq, ZMod.val_one, one_nsmul]
      · intro j _ hj
        rw [Matrix.one_apply_ne (fun h => hj h.symm), ZMod.val_zero, zero_nsmul]
      · intro h; exact absurd (Finset.mem_univ i) h
    have actadd : ∀ P Q, act (P + Q) = act P + act Q := by
      intro P Q
      apply Limits.Pi.hom_ext
      intro i
      rw [hact, Preadditive.add_comp, hact, hact, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [Matrix.add_apply, ZMod.val_add, ← modF _ (htc (Limits.Pi.π (fun _ : Fin r => X) j) hX),
        add_nsmul]
    have actmul : ∀ P Q, act P ≫ act Q = act (Q * P) := by
      intro P Q
      apply Limits.Pi.hom_ext
      intro i
      rw [Category.assoc, hact, hact, Preadditive.comp_sum]
      simp_rw [Preadditive.comp_nsmul, hact, Finset.smul_sum, smul_smul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [← Finset.sum_smul]
      have e : (Q * P) i k = ((∑ j, (Q i j).val * (P j k).val : ℕ) : ZMod (ℓ ^ n)) := by
        rw [Matrix.mul_apply, Nat.cast_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [Nat.cast_mul, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
      rw [e, ZMod.val_natCast]
      exact modF _ (htc (Limits.Pi.π (fun _ : Fin r => X) k) hX) _
    refine ⟨fun x => act (M x), ⟨?_, ?_, ?_⟩, ?_⟩
    · dsimp only; rw [map_one, act1]
    · intro a b; dsimp only; rw [map_add, actadd]
    · intro a b; dsimp only; rw [map_mul, actmul]
    · intro g i; dsimp only; rw [hM, hact]

  obtain ⟨ι, hι⟩ : ∃ ι : wcSpfTw A lamA ρ ⟶ ∏ᶜ fun _ : Fin r => A,
      ι = Limits.kernel.ι (wcSpfTwD A lamA ρ) := ⟨_, rfl⟩
  have hιc : ι ≫ wcSpfTwD A lamA ρ = 0 := by rw [hι]; exact Limits.kernel.condition _
  have hT : ∀ (g : Γ) (j : Fin r),
      φ ≫ ι ≫ Limits.Pi.π (fun _ : Fin r => A) j ≫ lamA (MonoidAlgebra.single g 1) =
      ∑ i, ((ρ g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) i j).val •
        (φ ≫ ι ≫ Limits.Pi.π (fun _ : Fin r => A) i) := by
    intro g j
    have h1 := congrArg (fun z => φ ≫ z ≫ Limits.Pi.π
      (fun _ : Fin (Fintype.card Γ) × Fin r => A) (Fintype.equivFin Γ g, j)) hιc
    simp only [wcSpfTwD, Category.assoc, Limits.Pi.lift_comp_π, Limits.zero_comp, Limits.comp_zero,
      Preadditive.comp_sub, Preadditive.comp_sum, Preadditive.comp_nsmul, Equiv.symm_apply_apply,
      wcSpfRhoEnt] at h1
    exact sub_eq_zero.mp h1

  obtain ⟨lamW', hlamW', hW'g⟩ := MAT B' hB'n
  obtain ⟨lamW, hlamW, hWg⟩ := MAT B hBn
  have hW'g' : ∀ (g : Γ) (i : Fin r) {Z : 𝒜} (h : B' ⟶ Z),
      lamW' (MonoidAlgebra.single g 1) ≫ Limits.Pi.π (fun _ : Fin r => B') i ≫ h =
      (∑ j : Fin r, ((ρ g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) i j).val •
          Limits.Pi.π (fun _ : Fin r => B') j) ≫ h := by
    intro g i Z h; rw [← Category.assoc, hW'g]
  obtain ⟨Φ', hΦ'⟩ : ∃ Φ' : (∏ᶜ fun _ : Fin r => B') ⟶ A,
      Φ' = ∑ j, Limits.Pi.π (fun _ : Fin r => B') j ≫ φ ≫ ι ≫ Limits.Pi.π (fun _ : Fin r => A) j :=
    ⟨_, rfl⟩
  have hΦ'g : ∀ g : Γ, lamW' (MonoidAlgebra.single g 1) ≫ Φ' =
      Φ' ≫ lamA (MonoidAlgebra.single g 1) := by
    intro g
    rw [hΦ', Preadditive.comp_sum, Preadditive.sum_comp]
    simp only [Category.assoc, hT, Preadditive.comp_sum, Preadditive.comp_nsmul, hW'g',
      Preadditive.sum_comp, Preadditive.nsmul_comp]
    exact Finset.sum_comm
  have hΦ'x := EQ lamW' lamA hlamW' hlam (hWt B' hB'n) htorn Φ' hΦ'g

  haveI : Mono mm := hmm
  have hmono : Mono (Limits.Pi.map (fun _ : Fin r => mm)) := Limits.Pi.map_mono _
  have hmg : ∀ g : Γ, lamW' (MonoidAlgebra.single g 1) ≫ Limits.Pi.map (fun _ : Fin r => mm) =
      Limits.Pi.map (fun _ : Fin r => mm) ≫ lamW (MonoidAlgebra.single g 1) := by
    intro g
    apply Limits.Pi.hom_ext
    intro i
    simp only [Category.assoc, Limits.Pi.map_π, hWg, hW'g', Preadditive.comp_sum,
      Preadditive.comp_nsmul, Preadditive.sum_comp, Preadditive.nsmul_comp]
  have hmx := EQ lamW' lamW hlamW' hlamW (hWt B' hB'n) (hWt B hBn) _ hmg

  obtain ⟨Φ, hE1, hE2⟩ := hrel (Limits.Pi.map (fun _ : Fin r => mm)) hmono
    (by rw [natCast_zsmul]; exact hWt B hBn) lamW' lamW hlamW' hlamW hmx Φ' hΦ'x

  obtain ⟨sig, hsig⟩ : ∃ sig : ∀ (X : 𝒜) (j : Fin r), X ⟶ ∏ᶜ fun _ : Fin r => X,
      ∀ X j k, sig X j ≫ Limits.Pi.π (fun _ : Fin r => X) k = if k = j then 𝟙 X else 0 :=
    ⟨fun X j => Limits.Pi.lift (fun k => if k = j then 𝟙 X else 0), fun X j k => by simp⟩
  have hσρ : ∀ (g : Γ) (j : Fin r), sig B j ≫ lamW (MonoidAlgebra.single g 1) =
      ∑ i, ((ρ g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) i j).val • sig B i := by
    intro g j
    apply Limits.Pi.hom_ext
    intro k
    rw [Category.assoc, hWg, Preadditive.comp_sum, Preadditive.sum_comp]
    simp only [Preadditive.comp_nsmul, Preadditive.nsmul_comp, hsig, smul_ite, smul_zero,
      Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ, if_true]
  have hσρ' : ∀ (g : Γ) (j : Fin r) {Z : 𝒜} (h : (∏ᶜ fun _ : Fin r => B) ⟶ Z),
      sig B j ≫ lamW (MonoidAlgebra.single g 1) ≫ h =
      (∑ i, ((ρ g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) i j).val • sig B i) ≫ h := by
    intro g j Z h; rw [← Category.assoc, hσρ]
  obtain ⟨ψ₀, hψ₀⟩ : ∃ ψ₀ : B ⟶ ∏ᶜ fun _ : Fin r => A,
      ∀ j, ψ₀ ≫ Limits.Pi.π (fun _ : Fin r => A) j = sig B j ≫ Φ :=
    ⟨Limits.Pi.lift (fun j => sig B j ≫ Φ), fun j => by simp⟩
  have hψ₀' : ∀ j {Z : 𝒜} (h : A ⟶ Z),
      ψ₀ ≫ Limits.Pi.π (fun _ : Fin r => A) j ≫ h = sig B j ≫ Φ ≫ h := by
    intro j Z h; rw [← Category.assoc, hψ₀, Category.assoc]
  have hψ0 : ψ₀ ≫ wcSpfTwD A lamA ρ = 0 := by
    apply Limits.Pi.hom_ext
    rintro ⟨a, j⟩
    simp only [wcSpfTwD, Category.assoc, Limits.Pi.lift_comp_π, Limits.zero_comp,
      Preadditive.comp_sub, Preadditive.comp_sum, Preadditive.comp_nsmul, hψ₀, hψ₀', ← hE2, hσρ',
      wcSpfRhoEnt, Preadditive.sum_comp, Preadditive.nsmul_comp, sub_self]
  have hσmm : ∀ j, mm ≫ sig B j = sig B' j ≫ Limits.Pi.map (fun _ : Fin r => mm) := by
    intro j
    apply Limits.Pi.hom_ext
    intro k
    rw [Category.assoc, Category.assoc, hsig, Limits.Pi.map_π, ← Category.assoc, hsig]
    split_ifs <;> simp
  obtain ⟨ψ, hψ⟩ : ∃ ψ : B ⟶ wcSpfTw A lamA ρ, ψ ≫ ι = ψ₀ :=
    ⟨Limits.kernel.lift (wcSpfTwD A lamA ρ) ψ₀ hψ0, by rw [hι]; exact Limits.kernel.lift_ι _ _ _⟩
  have hιm : Mono ι := by rw [hι]; exact Limits.equalizer.ι_mono
  refine ⟨ψ, ?_⟩
  apply (cancel_mono ι).1
  rw [Category.assoc, hψ]
  apply Limits.Pi.hom_ext
  intro j
  rw [Category.assoc, hψ₀, ← Category.assoc mm, hσmm, Category.assoc, hE1, hΦ',
    Preadditive.comp_sum, Finset.sum_eq_single j]
  · rw [← Category.assoc, hsig, if_pos rfl, Category.id_comp, Category.assoc]
  · intro l _ hl
    rw [← Category.assoc, hsig, if_neg hl, Limits.zero_comp]
  · intro h; exact absurd (Finset.mem_univ j) h

theorem wcSpfR_ext_vanish (S : Scheme.{u}) (U : S.ProEt) (N : ℕ) (hN : 0 < N)
    (A : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (hA : ((N : ℕ) : ℤ) • 𝟙 A = 0)
    (hrel : ∀ (B' B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (mm : B' ⟶ B),
      Mono mm → ((N : ℕ) : ℤ) • 𝟙 B = 0 → ∀ φ : B' ⟶ A, ∃ ψ : B ⟶ A, mm ≫ ψ = φ) :
    ∀ j, 1 ≤ j → ∀ y : Abelian.Ext (wcFreeSheaf S U) A j, y = 0 :=
by
  intro j hj y
  have hA' : N • 𝟙 A = 0 := by rw [← natCast_zsmul]; exact hA
  have hcomm : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : X ⟶ Y),
      f ≫ (N • 𝟙 Y) = (N • 𝟙 X) ≫ f := by
    intro X Y f
    rw [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
  let E := Injective.under A
  let e : A ⟶ E := Injective.ι A
  have he : e ≫ (N • 𝟙 E) = 0 := by rw [hcomm, hA', Limits.zero_comp]
  let e' : A ⟶ Limits.kernel (N • 𝟙 E) := Limits.kernel.lift (N • 𝟙 E) e he
  have he'ι : e' ≫ Limits.kernel.ι (N • 𝟙 E) = e := Limits.kernel.lift_ι _ _ _
  haveI : Mono e' := mono_of_mono_fac he'ι
  have hTk : ((N : ℕ) : ℤ) • 𝟙 (Limits.kernel (N • 𝟙 E)) = 0 := by
    rw [natCast_zsmul]
    rw [← cancel_mono (Limits.kernel.ι (N • 𝟙 E)), Limits.zero_comp, ← hcomm,
      Limits.kernel.condition]
  obtain ⟨t, het⟩ := hrel A (Limits.kernel (N • 𝟙 E)) e' inferInstance hTk (𝟙 A)
  have hPm : Mono (N • 𝟙 (wcFreeSheaf S U)) :=
    sheaf_free_yoneda_nsmul_mono (Scheme.ProEt.topology S) U N hN
  have hepiE : Epi (N • 𝟙 E) := sheaf_injective_nsmul_epi (Scheme.ProEt.topology S) E N hN
  have hK : ∀ (k : ℕ) (x : Abelian.Ext (wcFreeSheaf S U) (Limits.kernel (N • 𝟙 E)) (k + 1)),
      x = 0 := fun k x =>
    wc_exact_kernel_nsmul_ext_vanish (𝟭 _) _ _ (Iso.refl _) N hPm E hepiE
      (fun k' x' => Abelian.Ext.eq_zero_of_injective x') k x
  obtain ⟨j', rfl⟩ : ∃ j', j = j' + 1 := ⟨j - 1, by omega⟩
  have h1 : y = (y.comp (Abelian.Ext.mk₀ e') (add_zero _)).comp (Abelian.Ext.mk₀ t)
      (add_zero _) := by
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero _) (add_zero _),
      Abelian.Ext.mk₀_comp_mk₀, het, Abelian.Ext.comp_mk₀_id]
  rw [h1, hK j' (y.comp _ _), Abelian.Ext.zero_comp]

theorem wcSpfR_bockstein_eta {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {R : Type*} [Ring R]
    (L : 𝒜) (lamL : R → (L ⟶ L)) (I : InjectiveResolution L)
    (lamI : R → (I.cocomplex ⟶ I.cocomplex)) (hI : wcRingResSpec lamL I lamI)
    (N : ℕ) (hN : 1 ≤ N) (hmono : Mono (N • 𝟙 L)) (hepi : ∀ k, Epi (N • 𝟙 (I.cocomplex.X k)))
    (lamG : R → (Limits.cokernel (N • 𝟙 L) ⟶ Limits.cokernel (N • 𝟙 L)))
    (hlamG : ∀ x, Limits.cokernel.π (N • 𝟙 L) ≫ lamG x = lamL x ≫ Limits.cokernel.π (N • 𝟙 L)) :
    ∃ η : Limits.cokernel (N • 𝟙 L) ⟶ (wcTruncKerRes I.cocomplex N).X 0, Mono η ∧
      (∃ w : η ≫ (wcTruncKerRes I.cocomplex N).d 0 1 = 0, (ShortComplex.mk _ _ w).Exact) ∧
      ∀ x, lamG x ≫ η = η ≫ (wcSpfTruncMap I.cocomplex N (lamI x)).f 0 :=
by
  classical

  have hcomm : ∀ {A B : 𝒜} (f : A ⟶ B), f ≫ (N • 𝟙 B) = (N • 𝟙 A) ≫ f := by
    intro A B f
    rw [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]

  let ι : ∀ k, Limits.kernel (N • 𝟙 (I.cocomplex.X k)) ⟶ I.cocomplex.X k :=
    fun k => Limits.kernel.ι (N • 𝟙 (I.cocomplex.X k))
  have hιn : ∀ k, ι k ≫ (N • 𝟙 (I.cocomplex.X k)) = 0 := fun k => Limits.kernel.condition _
  let D : ∀ k, Limits.kernel (N • 𝟙 (I.cocomplex.X k)) ⟶
      Limits.kernel (N • 𝟙 (I.cocomplex.X (k + 1))) := fun k => wcTruncKerD I.cocomplex N k
  have hDι : ∀ k, D k ≫ ι (k + 1) = ι k ≫ I.cocomplex.d k (k + 1) := fun k => by
    simp [D, ι, wcTruncKerD, Limits.kernel.map]
  have hDι0 : D 0 ≫ ι 1 = ι 0 ≫ I.cocomplex.d 0 1 := hDι 0
  have hDι1 : D 1 ≫ ι 2 = ι 1 ≫ I.cocomplex.d 1 2 := hDι 1
  let p : Limits.kernel (N • 𝟙 (I.cocomplex.X 1)) ⟶ Limits.cokernel (D 0) :=
    Limits.cokernel.π (D 0)
  have hDp : D 0 ≫ p = 0 := Limits.cokernel.condition _
  have hJd0 : (wcTruncKerRes I.cocomplex N).d 0 1 = wcTruncKerDiff I.cocomplex N 0 :=
    CochainComplex.of_d (wcTruncKerX I.cocomplex N) (wcTruncKerDiff I.cocomplex N) 0
  have hpδ0 : p ≫ ((wcTruncKerRes I.cocomplex N).d 0 1 :
      Limits.cokernel (D 0) ⟶ Limits.kernel (N • 𝟙 (I.cocomplex.X 2))) = D 1 := by
    rw [hJd0]
    exact Limits.cokernel.π_desc _ _ _
  let δ : Limits.cokernel (D 0) ⟶ Limits.kernel (N • 𝟙 (I.cocomplex.X 2)) :=
    (wcTruncKerRes I.cocomplex N).d 0 1
  have hpδ : p ≫ δ = D 1 := hpδ0

  let π : L ⟶ Limits.cokernel (N • 𝟙 L) := Limits.cokernel.π (N • 𝟙 L)
  haveI hπepi : Epi π := by
    show Epi (Limits.cokernel.π (N • 𝟙 L))
    infer_instance
  have hπc : (N • 𝟙 L) ≫ π = 0 := Limits.cokernel.condition _
  have hlamG' : ∀ x, π ≫ lamG x = lamL x ≫ π := hlamG

  let i0 : L ⟶ I.cocomplex.X 0 := I.ι.f 0
  haveI : Mono i0 := by
    show Mono (I.ι.f 0)
    infer_instance
  have hi0d : i0 ≫ I.cocomplex.d 0 1 = 0 := I.ι_f_zero_comp_complex_d
  have hi0comm : i0 ≫ (N • 𝟙 (I.cocomplex.X 0)) = (N • 𝟙 L) ≫ i0 := hcomm i0
  have hY0 : ∀ {A : 𝒜} (y : A ⟶ I.cocomplex.X 0), y ≫ I.cocomplex.d 0 1 = 0 →
      ∃ x : A ⟶ L, x ≫ i0 = y := by
    intro A y hy
    exact ⟨I.exact₀.lift y hy, I.exact₀.lift_f y hy⟩
  have hi0lam : ∀ x, i0 ≫ (lamI x).f 0 = lamL x ≫ i0 := fun x => hI.2.1 x
  let T0 : R → (Limits.cokernel (D 0) ⟶ Limits.cokernel (D 0)) :=
    fun x => (wcSpfTruncMap I.cocomplex N (lamI x)).f 0

  let fst : Limits.pullback (N • 𝟙 (I.cocomplex.X 0)) i0 ⟶ I.cocomplex.X 0 :=
    Limits.pullback.fst _ _
  let snd : Limits.pullback (N • 𝟙 (I.cocomplex.X 0)) i0 ⟶ L := Limits.pullback.snd _ _
  have hcond : fst ≫ (N • 𝟙 (I.cocomplex.X 0)) = snd ≫ i0 := Limits.pullback.condition
  haveI hsnd : Epi snd := by
    haveI := hepi 0
    exact Abelian.epi_pullback_of_epi_f _ _
  have hu : (fst ≫ I.cocomplex.d 0 1) ≫ (N • 𝟙 (I.cocomplex.X 1)) = 0 := by
    rw [Category.assoc, hcomm (I.cocomplex.d 0 1), ← Category.assoc, hcond, Category.assoc,
      hi0d, Limits.comp_zero]
  let u' : Limits.pullback (N • 𝟙 (I.cocomplex.X 0)) i0 ⟶
      Limits.kernel (N • 𝟙 (I.cocomplex.X 1)) := Limits.kernel.lift _ _ hu
  have hu'ι : u' ≫ ι 1 = fst ≫ I.cocomplex.d 0 1 := Limits.kernel.lift_ι _ _ _
  have hθ'z : Limits.kernel.ι snd ≫ (u' ≫ p) = 0 := by
    have hw : (Limits.kernel.ι snd ≫ fst) ≫ (N • 𝟙 (I.cocomplex.X 0)) = 0 := by
      rw [Category.assoc, hcond, ← Category.assoc, Limits.kernel.condition, Limits.zero_comp]
    have h2 : Limits.kernel.ι snd ≫ u' = Limits.kernel.lift _ _ hw ≫ D 0 := by
      rw [← cancel_mono (ι 1), Category.assoc, Category.assoc, hu'ι, hDι0, ← Category.assoc
        (Limits.kernel.lift _ _ hw)]
      simp only [ι, Limits.kernel.lift_ι, Category.assoc]
    rw [← Category.assoc, h2, Category.assoc, hDp, Limits.comp_zero]
  let θ : L ⟶ Limits.cokernel (D 0) := Abelian.epiDesc snd (u' ≫ p) hθ'z
  have hsθ : snd ≫ θ = u' ≫ p := Abelian.comp_epiDesc _ _ _
  have hθn : (N • 𝟙 L) ≫ θ = 0 := by
    let sL : L ⟶ Limits.pullback (N • 𝟙 (I.cocomplex.X 0)) i0 :=
      Limits.pullback.lift i0 (N • 𝟙 L) hi0comm
    have h1 : sL ≫ u' = 0 := by
      rw [← cancel_mono (ι 1), Category.assoc, hu'ι, Limits.zero_comp, ← Category.assoc]
      simp only [sL, fst, Limits.pullback.lift_fst]
      exact hi0d
    have h2 : N • 𝟙 L = sL ≫ snd := (Limits.pullback.lift_snd _ _ _).symm
    rw [h2, Category.assoc, hsθ, ← Category.assoc, h1, Limits.zero_comp]
  obtain ⟨η, hπη⟩ : ∃ η : Limits.cokernel (N • 𝟙 L) ⟶ Limits.cokernel (D 0),
      π ≫ η = θ := ⟨Limits.cokernel.desc _ θ hθn, Limits.cokernel.π_desc _ _ _⟩
  have hπη' : π ≫ η = θ := hπη

  have hu'D : u' ≫ D 1 = 0 := by
    rw [← cancel_mono (ι 2), Category.assoc, hDι1, ← Category.assoc, hu'ι, Category.assoc,
      HomologicalComplex.d_comp_d, Limits.comp_zero, Limits.zero_comp]
  have hθδ : θ ≫ δ = 0 := by
    rw [← cancel_epi snd, Limits.comp_zero, ← Category.assoc, hsθ, Category.assoc, hpδ]
    exact hu'D
  have hηδ' : η ≫ δ = 0 := by
    rw [← cancel_epi π, Limits.comp_zero, ← Category.assoc, hπη']
    exact hθδ
  have hηδ : η ≫ (wcTruncKerRes I.cocomplex N).d 0 1 = 0 := hηδ'

  have hmonoη : Mono η := by
    apply Preadditive.mono_of_cancel_zero
    intro A g hg
    obtain ⟨A1, π1, hπ1, x, hx⟩ := surjective_up_to_refinements_of_epi π g
    obtain ⟨A2, π2, hπ2, q, hq⟩ := surjective_up_to_refinements_of_epi snd x
    have h3 : (q ≫ u') ≫ p = 0 := by
      calc (q ≫ u') ≫ p = q ≫ snd ≫ θ := by rw [hsθ, Category.assoc]
        _ = π2 ≫ x ≫ π ≫ η := by rw [hπη', ← Category.assoc, ← hq, Category.assoc]
        _ = π2 ≫ π1 ≫ g ≫ η := by rw [← Category.assoc x, ← hx, Category.assoc]
        _ = 0 := by rw [hg, Limits.comp_zero, Limits.comp_zero]
    obtain ⟨A3, π3, hπ3, w, hw'⟩ :=
      (ShortComplex.exact_cokernel (D 0)).exact_up_to_refinements (q ≫ u') h3
    have hw'' : π3 ≫ q ≫ u' = w ≫ D 0 := hw'
    have hyd : (π3 ≫ q ≫ fst - w ≫ ι 0) ≫ I.cocomplex.d 0 1 = 0 := by
      have e : (π3 ≫ q ≫ fst) ≫ I.cocomplex.d 0 1 = (w ≫ ι 0) ≫ I.cocomplex.d 0 1 := by
        calc (π3 ≫ q ≫ fst) ≫ I.cocomplex.d 0 1 = (π3 ≫ q ≫ u') ≫ ι 1 := by
              simp only [Category.assoc, hu'ι]
          _ = (w ≫ D 0) ≫ ι 1 := by rw [hw'']
          _ = (w ≫ ι 0) ≫ I.cocomplex.d 0 1 := by simp only [Category.assoc, hDι0]
      rw [Preadditive.sub_comp, e, sub_self]
    obtain ⟨x4, hx4⟩ := hY0 _ hyd
    have h5 : π3 ≫ q ≫ snd = x4 ≫ (N • 𝟙 L) := by
      rw [← cancel_mono i0]
      calc (π3 ≫ q ≫ snd) ≫ i0 = (π3 ≫ q ≫ fst) ≫ (N • 𝟙 (I.cocomplex.X 0)) := by
            simp only [Category.assoc, hcond]
        _ = (π3 ≫ q ≫ fst - w ≫ ι 0) ≫ (N • 𝟙 (I.cocomplex.X 0)) := by
            rw [Preadditive.sub_comp, Category.assoc w, hιn, Limits.comp_zero, sub_zero]
        _ = (x4 ≫ (N • 𝟙 L)) ≫ i0 := by rw [← hx4, Category.assoc, hi0comm, Category.assoc]
    have h6 : π3 ≫ π2 ≫ π1 ≫ g = 0 := by
      have e1 : π3 ≫ π2 ≫ π1 ≫ g = (π3 ≫ q ≫ snd) ≫ π := by
        rw [hx, ← Category.assoc π2, hq]
        simp only [Category.assoc]
      rw [e1, h5, Category.assoc, hπc, Limits.comp_zero]
    apply (cancel_epi π1).mp
    apply (cancel_epi π2).mp
    apply (cancel_epi π3).mp
    rw [Limits.comp_zero, Limits.comp_zero, Limits.comp_zero]
    exact h6

  have hexK : ∀ {A : 𝒜} (x : A ⟶ Limits.cokernel (D 0)), x ≫ δ = 0 →
      ∃ (A' : 𝒜) (π' : A' ⟶ A) (_ : Epi π') (y : A' ⟶ Limits.cokernel (N • 𝟙 L)),
        π' ≫ x = y ≫ η := by
    intro A x hx'
    obtain ⟨A1, π1, hπ1, x', hx1⟩ := surjective_up_to_refinements_of_epi p x
    have h1 : x' ≫ D 1 = 0 := by
      rw [← hpδ, ← Category.assoc, ← hx1, Category.assoc, hx', Limits.comp_zero]
    have h2 : (x' ≫ ι 1) ≫ I.cocomplex.d 1 2 = 0 := by
      rw [Category.assoc, ← hDι1, ← Category.assoc, h1, Limits.zero_comp]
    obtain ⟨A2, π2, hπ2, z, hz⟩ := (I.exact_succ 0).exact_up_to_refinements _ h2
    have hz' : π2 ≫ x' ≫ ι 1 = z ≫ I.cocomplex.d 0 1 := hz
    have h3 : (z ≫ (N • 𝟙 (I.cocomplex.X 0))) ≫ I.cocomplex.d 0 1 = 0 := by
      rw [Category.assoc, ← hcomm, ← Category.assoc, ← hz', Category.assoc, Category.assoc,
        hιn, Limits.comp_zero, Limits.comp_zero]
    obtain ⟨x0, hx0⟩ := hY0 _ h3
    let q : A2 ⟶ Limits.pullback (N • 𝟙 (I.cocomplex.X 0)) i0 :=
      Limits.pullback.lift z x0 hx0.symm
    have hqf : q ≫ fst = z := Limits.pullback.lift_fst _ _ _
    have hqs : q ≫ snd = x0 := Limits.pullback.lift_snd _ _ _
    have hqu : q ≫ u' = π2 ≫ x' := by
      rw [← cancel_mono (ι 1), Category.assoc, hu'ι, ← Category.assoc, hqf, ← hz',
        Category.assoc]
    refine ⟨A2, π2 ≫ π1, inferInstance, x0 ≫ π, ?_⟩
    rw [Category.assoc, hx1, ← Category.assoc, ← hqu, Category.assoc, ← hsθ, ← Category.assoc,
      hqs, Category.assoc, hπη']
  have hexact : (ShortComplex.mk η ((wcTruncKerRes I.cocomplex N).d 0 1) hηδ).Exact := by
    rw [ShortComplex.exact_iff_exact_up_to_refinements]
    intro A x hx
    exact hexK x hx

  have hequiv : ∀ x, lamG x ≫ η = η ≫ (wcSpfTruncMap I.cocomplex N (lamI x)).f 0 := by
    intro x
    have hw : (fst ≫ (lamI x).f 0) ≫ (N • 𝟙 (I.cocomplex.X 0)) = (snd ≫ lamL x) ≫ i0 := by
      rw [Category.assoc, hcomm ((lamI x).f 0), ← Category.assoc, hcond]
      simp only [Category.assoc, hi0lam x]
    let lamPb : Limits.pullback (N • 𝟙 (I.cocomplex.X 0)) i0 ⟶
        Limits.pullback (N • 𝟙 (I.cocomplex.X 0)) i0 :=
      Limits.pullback.lift (fst ≫ (lamI x).f 0) (snd ≫ lamL x) hw
    have hPf : lamPb ≫ fst = fst ≫ (lamI x).f 0 := Limits.pullback.lift_fst _ _ _
    have hPs : lamPb ≫ snd = snd ≫ lamL x := Limits.pullback.lift_snd _ _ _
    have hKM : wcSpfKerMap I.cocomplex N (lamI x) 1 ≫ ι 1 = ι 1 ≫ (lamI x).f 1 :=
      Limits.kernel.lift_ι _ _ _
    have hPu : lamPb ≫ u' = u' ≫ wcSpfKerMap I.cocomplex N (lamI x) 1 := by
      rw [← cancel_mono (ι 1)]
      calc (lamPb ≫ u') ≫ ι 1 = lamPb ≫ fst ≫ I.cocomplex.d 0 1 := by
            rw [Category.assoc, hu'ι]
        _ = fst ≫ (lamI x).f 0 ≫ I.cocomplex.d 0 1 := by
            rw [← Category.assoc, hPf, Category.assoc]
        _ = fst ≫ I.cocomplex.d 0 1 ≫ (lamI x).f 1 := by
            rw [HomologicalComplex.Hom.comm]
        _ = (u' ≫ wcSpfKerMap I.cocomplex N (lamI x) 1) ≫ ι 1 := by
            rw [Category.assoc, hKM, ← Category.assoc u', hu'ι, Category.assoc]
    have hpT : p ≫ T0 x = wcSpfKerMap I.cocomplex N (lamI x) 1 ≫ p := by
      show p ≫ wcSpfTruncMapF I.cocomplex N (lamI x) 0 = _
      exact Limits.cokernel.π_desc _ _ _
    have hθT : lamL x ≫ θ = θ ≫ T0 x := by
      rw [← cancel_epi snd]
      calc snd ≫ lamL x ≫ θ = lamPb ≫ snd ≫ θ := by
            rw [← Category.assoc, ← hPs, Category.assoc]
        _ = lamPb ≫ u' ≫ p := by rw [hsθ]
        _ = u' ≫ wcSpfKerMap I.cocomplex N (lamI x) 1 ≫ p := by
            rw [← Category.assoc, hPu, Category.assoc]
        _ = u' ≫ p ≫ T0 x := by rw [hpT]
        _ = snd ≫ θ ≫ T0 x := by
            rw [← Category.assoc, ← hsθ, Category.assoc]
    show lamG x ≫ η = η ≫ T0 x
    rw [← cancel_epi π]
    calc π ≫ lamG x ≫ η = lamL x ≫ π ≫ η := by
          rw [← Category.assoc, hlamG' x, Category.assoc]
      _ = lamL x ≫ θ := by rw [hπη']
      _ = θ ≫ T0 x := hθT
      _ = π ≫ η ≫ T0 x := by
          rw [← Category.assoc, hπη']
  exact ⟨η, hmonoη, ⟨hηδ, hexact⟩, hequiv⟩

theorem wcSpfR_tw_left_exact {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] :
    (∀ (ι : Type) [Finite ι] {A B C' : 𝒜} (f : A ⟶ B) (g : B ⟶ C') (w : f ≫ g = 0),
      (ShortComplex.mk f g w).Exact →
      ∃ w' : Limits.Pi.map (fun _ : ι => f) ≫ Limits.Pi.map (fun _ : ι => g) = 0,
        (ShortComplex.mk _ _ w').Exact) ∧
    (∀ (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {Γ : Type u} [Group Γ] [Fintype Γ] {n r : ℕ}
      (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) {A B C' : 𝒜}
      (lamA : MonoidAlgebra ℤ_[ℓ] Γ → (A ⟶ A)) (lamB : MonoidAlgebra ℤ_[ℓ] Γ → (B ⟶ B))
      (lamC : MonoidAlgebra ℤ_[ℓ] Γ → (C' ⟶ C')) (f : A ⟶ B) (g : B ⟶ C')
      (hf : ∀ γ : Γ, lamA (MonoidAlgebra.single γ 1) ≫ f = f ≫ lamB (MonoidAlgebra.single γ 1))
      (hg : ∀ γ : Γ, lamB (MonoidAlgebra.single γ 1) ≫ g = g ≫ lamC (MonoidAlgebra.single γ 1))
      (w : f ≫ g = 0), Mono f → (ShortComplex.mk f g w).Exact →
      Mono (wcSpfTwMap lamA lamB ρ f hf) ∧
      ∃ w' : wcSpfTwMap lamA lamB ρ f hf ≫ wcSpfTwMap lamB lamC ρ g hg = 0,
        (ShortComplex.mk _ _ w').Exact) :=
by
  have part1 : ∀ (ι : Type) [Finite ι] {A B C' : 𝒜} (f : A ⟶ B) (g : B ⟶ C') (w : f ≫ g = 0),
      (ShortComplex.mk f g w).Exact →
      ∃ w' : Limits.Pi.map (fun _ : ι => f) ≫ Limits.Pi.map (fun _ : ι => g) = 0,
        (ShortComplex.mk _ _ w').Exact := by
    intro ι _ A B C' f g w hex
    have w' : Limits.Pi.map (fun _ : ι => f) ≫ Limits.Pi.map (fun _ : ι => g) = 0 := by
      apply Limits.Pi.hom_ext
      intro i
      simp only [Category.assoc, Limits.Pi.map_π, Limits.Pi.map_π_assoc, w,
        Limits.comp_zero, Limits.zero_comp]
    refine ⟨w', ?_⟩
    haveI : Limits.HasFiniteBiproducts 𝒜 := Abelian.hasFiniteBiproducts
    haveI := Limits.hasBiproductsOfShape_finite (J := ι) 𝒜
    haveI hk : Epi (Limits.kernel.lift g f w) := hex.epi_kernelLift
    haveI hPk : Epi (Limits.Pi.map (fun _ : ι => Limits.kernel.lift g f w)) := inferInstance
    rw [ShortComplex.exact_iff_exact_up_to_refinements]
    intro X x₂ hx
    dsimp at hx
    have hxi : ∀ i, (x₂ ≫ Limits.Pi.π (fun _ : ι => B) i) ≫ g = 0 := by
      intro i
      have := congrArg (fun z => z ≫ Limits.Pi.π (fun _ : ι => C') i) hx
      simp only [Category.assoc, Limits.Pi.map_π, Limits.zero_comp] at this
      rw [Category.assoc]
      exact this
    obtain ⟨A', π, hπ, x₁, hfac⟩ := surjective_up_to_refinements_of_epi
      (Limits.Pi.map (fun _ : ι => Limits.kernel.lift g f w))
      (Limits.Pi.lift (fun i => Limits.kernel.lift g (x₂ ≫ Limits.Pi.π (fun _ : ι => B) i) (hxi i)))
    refine ⟨A', π, hπ, x₁, ?_⟩
    dsimp
    apply Limits.Pi.hom_ext
    intro i
    have h1 := congrArg (fun z => z ≫ Limits.Pi.π (fun _ : ι => Limits.kernel g) i ≫
      Limits.kernel.ι g) hfac
    simp only [Category.assoc, Limits.Pi.lift_comp_π_assoc, Limits.kernel.lift_ι,
      Limits.Pi.map_π_assoc] at h1
    simp only [Category.assoc, Limits.Pi.map_π]
    exact h1
  refine ⟨part1, ?_⟩
  intro ℓ _ Γ _ _ n r ρ A B C' lamA lamB lamC f g hf hg w hfm hex
  obtain ⟨ιA, hιA⟩ : ∃ ιA : wcSpfTw A lamA ρ ⟶ ∏ᶜ (fun _ : Fin r => A),
      ιA = Limits.kernel.ι (wcSpfTwD A lamA ρ) := ⟨_, rfl⟩
  obtain ⟨ιB, hιB⟩ : ∃ ιB : wcSpfTw B lamB ρ ⟶ ∏ᶜ (fun _ : Fin r => B),
      ιB = Limits.kernel.ι (wcSpfTwD B lamB ρ) := ⟨_, rfl⟩
  obtain ⟨ιC, hιC⟩ : ∃ ιC : wcSpfTw C' lamC ρ ⟶ ∏ᶜ (fun _ : Fin r => C'),
      ιC = Limits.kernel.ι (wcSpfTwD C' lamC ρ) := ⟨_, rfl⟩
  haveI hmA : Mono ιA := by rw [hιA]; exact Limits.equalizer.ι_mono
  haveI hmB : Mono ιB := by rw [hιB]; exact Limits.equalizer.ι_mono
  haveI hmC : Mono ιC := by rw [hιC]; exact Limits.equalizer.ι_mono
  have hcB : ιB ≫ wcSpfTwD B lamB ρ = 0 := by rw [hιB]; exact Limits.kernel.condition _
  have hTf : wcSpfTwMap lamA lamB ρ f hf ≫ ιB = ιA ≫ Limits.Pi.map (fun _ : Fin r => f) := by
    rw [hιA, hιB]; exact Limits.kernel.lift_ι _ _ _
  have hTg : wcSpfTwMap lamB lamC ρ g hg ≫ ιC = ιB ≫ Limits.Pi.map (fun _ : Fin r => g) := by
    rw [hιB, hιC]; exact Limits.kernel.lift_ι _ _ _
  have hmono : Mono (wcSpfTwMap lamA lamB ρ f hf) := by
    haveI : Mono (Limits.Pi.map (fun _ : Fin r => f)) := inferInstance
    exact mono_of_mono_fac hTf
  have hsqf : wcSpfTwD A lamA ρ ≫ Limits.Pi.map (fun _ : Fin (Fintype.card Γ) × Fin r => f) =
      Limits.Pi.map (fun _ : Fin r => f) ≫ wcSpfTwD B lamB ρ := by
    apply Limits.Pi.hom_ext
    intro aj
    simp only [wcSpfTwD, Category.assoc, Limits.Pi.lift_comp_π, Limits.Pi.map_π,
      Limits.Pi.map_π_assoc, Limits.Pi.lift_comp_π_assoc, Preadditive.sub_comp,
      Preadditive.comp_sub, Preadditive.sum_comp, Preadditive.comp_sum,
      Preadditive.nsmul_comp, Preadditive.comp_nsmul, hf]
  obtain ⟨w0, hex0⟩ := part1 (Fin r) f g w hex
  have w' : wcSpfTwMap lamA lamB ρ f hf ≫ wcSpfTwMap lamB lamC ρ g hg = 0 := by
    refine (cancel_mono ιC).1 ?_
    rw [Category.assoc, hTg, ← Category.assoc, hTf, Category.assoc, w0, Limits.comp_zero,
      Limits.zero_comp]
  refine ⟨hmono, w', ?_⟩
  rw [ShortComplex.exact_iff_exact_up_to_refinements]
  intro X x hx
  change X ⟶ wcSpfTw B lamB ρ at x
  change x ≫ wcSpfTwMap lamB lamC ρ g hg = 0 at hx
  have hx' : (x ≫ ιB) ≫ Limits.Pi.map (fun _ : Fin r => g) = 0 := by
    rw [Category.assoc, ← hTg, ← Category.assoc, hx, Limits.zero_comp]
  obtain ⟨A', π, hπ, y, hy⟩ := hex0.exact_up_to_refinements (x ≫ ιB) hx'
  change A' ⟶ ∏ᶜ (fun _ : Fin r => A) at y
  change π ≫ x ≫ ιB = y ≫ Limits.Pi.map (fun _ : Fin r => f) at hy
  have hyD : y ≫ wcSpfTwD A lamA ρ = 0 := by
    haveI : Mono (Limits.Pi.map (fun _ : Fin (Fintype.card Γ) × Fin r => f)) := inferInstance
    refine (cancel_mono (Limits.Pi.map (fun _ : Fin (Fintype.card Γ) × Fin r => f))).1 ?_
    rw [Limits.zero_comp, Category.assoc, hsqf, ← Category.assoc, ← hy, Category.assoc,
      Category.assoc, hcB, Limits.comp_zero, Limits.comp_zero]
  obtain ⟨y', hy'⟩ : ∃ y' : A' ⟶ wcSpfTw A lamA ρ, y' ≫ ιA = y :=
    ⟨Limits.kernel.lift _ y hyD, by rw [hιA]; exact Limits.kernel.lift_ι _ _ _⟩
  refine ⟨A', π, hπ, y', ?_⟩
  change π ≫ x = y' ≫ wcSpfTwMap lamA lamB ρ f hf
  refine (cancel_mono ιB).1 ?_
  rw [← hy'] at hy
  simp only [Category.assoc, hTf]
  simpa only [Category.assoc] using hy

theorem wcSpfR_tci_coker_red {X V : Scheme.{u}} (q : V ⟶ X) (Z : Set X) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (n : ℕ) :
    ∃ e : Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf q Z ℓ)) ≅
        (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).obj (wcSpfQPre q Z ℓ n),
      Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf q Z ℓ)) ≫ e.hom =
        (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
          (wcSpfRedP q Z ℓ n) :=
by
  classical
  have hℓ : ℓ.Prime := Fact.out
  have : NeZero (ℓ ^ n) := ⟨pow_ne_zero n hℓ.ne_zero⟩

  have memP : ∀ (F : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (T : (X.ProEt)ᵒᵖ)
      (_ : ∀ t, T.unop.hom t ∉ Z) (v : F.obj T),
      v ∈ wcExtZeroSub F (fun T : X.ProEt => ∀ t, T.hom t ∉ Z) T := by
    intro F T hp v
    show v ∈ (⨆ _ : (∀ t, T.unop.hom t ∉ Z), (⊤ : AddSubgroup (F.obj T)))
    rw [iSup_pos hp]; exact AddSubgroup.mem_top _
  have memN : ∀ (F : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (T : (X.ProEt)ᵒᵖ)
      (_ : ¬ ∀ t, T.unop.hom t ∉ Z) (v : F.obj T),
      v ∈ wcExtZeroSub F (fun T : X.ProEt => ∀ t, T.hom t ∉ Z) T → v = 0 := by
    intro F T hp v hv
    change v ∈ (⨆ _ : (∀ t, T.unop.hom t ∉ Z), (⊤ : AddSubgroup (F.obj T))) at hv
    rw [iSup_neg hp, AddSubgroup.mem_bot] at hv
    exact hv

  have hN : ∀ (T : (X.ProEt)ᵒᵖ) (x : (wcCcPre q Z ℓ).obj T),
      (((ℓ ^ n : ℕ) • 𝟙 (wcCcPre q Z ℓ)).app T).hom x = (ℓ ^ n : ℕ) • x := by
    intro T x
    rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id]
    rfl
  have hval : ∀ (T : (X.ProEt)ᵒᵖ) (x : (wcCcPre q Z ℓ).obj T) y,
      DFunLike.coe (F := C((wcPbFun q).obj T.unop, ℤ_[ℓ]))
        (((ℓ ^ n : ℕ) • x : (wcCcPre q Z ℓ).obj T).1.down) y =
        ((ℓ ^ n : ℕ) : ℤ_[ℓ]) * DFunLike.coe (F := C((wcPbFun q).obj T.unop, ℤ_[ℓ])) x.1.down y := by
    intro T x y
    change (ℓ ^ n : ℕ) • DFunLike.coe (F := C((wcPbFun q).obj T.unop, ℤ_[ℓ])) x.1.down y = _
    exact nsmul_eq_mul _ _
  have hred : ∀ (T : (X.ProEt)ᵒᵖ) (x : (wcCcPre q Z ℓ).obj T) y,
      DFunLike.coe (F := C((wcPbFun q).obj T.unop, ZMod (ℓ ^ n)))
        ((((wcSpfRedP q Z ℓ n).app T).hom x).1.down) y =
        PadicInt.toZModPow n (DFunLike.coe (F := C((wcPbFun q).obj T.unop, ℤ_[ℓ])) x.1.down y) :=
    fun _ _ _ => rfl

  have hA : ∀ a : ℤ_[ℓ], PadicInt.toZModPow n (((ℓ ^ n : ℕ) : ℤ_[ℓ]) * a) = 0 := by
    intro a
    rw [map_mul, map_natCast, ZMod.natCast_self, zero_mul]
  have hB : ∀ k : ZMod (ℓ ^ n), PadicInt.toZModPow n ((k.val : ℕ) : ℤ_[ℓ]) = k := by
    intro k
    rw [map_natCast, ZMod.natCast_zmod_val]
  have hL : ((ℓ : ℚ_[ℓ]) ^ n) ≠ 0 := pow_ne_zero _ (Nat.cast_ne_zero.2 hℓ.ne_zero)
  have hE : ∀ a : ℤ_[ℓ], PadicInt.toZModPow n a = 0 → ‖(a : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ n‖ ≤ 1 := by
    intro a ha
    have hmem : a ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ n} := by
      rw [← PadicInt.ker_toZModPow, RingHom.mem_ker]; exact ha
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hmem
    have hc' : (a : ℚ_[ℓ]) = (c : ℚ_[ℓ]) * (ℓ : ℚ_[ℓ]) ^ n := by
      rw [← hc, PadicInt.coe_mul, PadicInt.coe_pow, PadicInt.coe_natCast]
    rw [hc', mul_div_cancel_right₀ _ hL]
    exact PadicInt.norm_le_one c
  have hD : ∀ (a b : ℤ_[ℓ]), (b : ℚ_[ℓ]) = (a : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ n →
      ((ℓ ^ n : ℕ) : ℤ_[ℓ]) * b = a := by
    intro a b hb
    apply PadicInt.ext
    rw [PadicInt.coe_mul, PadicInt.coe_natCast, hb, Nat.cast_pow, mul_div_cancel₀ _ hL]

  have w : ((ℓ ^ n : ℕ) • 𝟙 (wcCcPre q Z ℓ)) ≫ wcSpfRedP q Z ℓ n = 0 := by
    apply NatTrans.ext; funext T; apply AddCommGrpCat.ext; intro x
    change ((wcSpfRedP q Z ℓ n).app T).hom ((((ℓ ^ n : ℕ) • 𝟙 (wcCcPre q Z ℓ)).app T).hom x) = 0
    refine (congrArg _ (hN T x)).trans ?_
    apply Subtype.ext; apply ULift.ext; apply ContinuousMap.ext; intro y
    refine (hred T _ y).trans ?_
    refine (congrArg _ (hval T x y)).trans ?_
    exact hA _

  have exactT : ∀ (T : (X.ProEt)ᵒᵖ) (x : (wcCcPre q Z ℓ).obj T),
      ((wcSpfRedP q Z ℓ n).app T).hom x = 0 →
      ∃ y, (((ℓ ^ n : ℕ) • 𝟙 (wcCcPre q Z ℓ)).app T).hom y = x := by
    intro T x hx
    by_cases hp : ∀ t, T.unop.hom t ∉ Z
    · let f0 : C((wcPbFun q).obj T.unop, ℤ_[ℓ]) := x.1.down
      have hdiv : ∀ y0, PadicInt.toZModPow n (f0 y0) = 0 := by
        intro y0
        have h1 := congrArg (fun z : (wcSpfQPre q Z ℓ n).obj T =>
          DFunLike.coe (F := C((wcPbFun q).obj T.unop, ZMod (ℓ ^ n))) z.1.down y0) hx
        exact h1
      have hbd : ∀ y0, ‖(f0 y0 : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ n‖ ≤ 1 := fun y0 => hE _ (hdiv y0)
      let g : C((wcPbFun q).obj T.unop, ℤ_[ℓ]) :=
        ⟨fun y0 => ⟨(f0 y0 : ℚ_[ℓ]) / (ℓ : ℚ_[ℓ]) ^ n, hbd y0⟩,
          Continuous.subtype_mk
            ((continuous_subtype_val.comp f0.continuous).div_const _) _⟩
      refine ⟨⟨⟨g⟩, memP _ T hp _⟩, ?_⟩
      refine (hN T _).trans ?_
      apply Subtype.ext; apply ULift.ext; apply ContinuousMap.ext; intro y0
      refine (hval T _ y0).trans ?_
      exact hD (f0 y0) (g y0) rfl
    · have hx0 : x = 0 := Subtype.ext (memN _ T hp x.1 x.2)
      exact ⟨0, by rw [hx0, map_zero]⟩

  have surjT : ∀ (T : (X.ProEt)ᵒᵖ) (z : (wcSpfQPre q Z ℓ n).obj T),
      ∃ x, ((wcSpfRedP q Z ℓ n).app T).hom x = z := by
    intro T z
    by_cases hp : ∀ t, T.unop.hom t ∉ Z
    · let z0 : C((wcPbFun q).obj T.unop, ZMod (ℓ ^ n)) := z.1.down
      let g : C((wcPbFun q).obj T.unop, ℤ_[ℓ]) :=
        ⟨fun y => (((z0 y).val : ℕ) : ℤ_[ℓ]),
          (continuous_of_discreteTopology (f := fun k : ZMod (ℓ ^ n) => ((k.val : ℕ) : ℤ_[ℓ]))).comp
            z0.continuous⟩
      refine ⟨⟨⟨g⟩, memP _ T hp _⟩, ?_⟩
      apply Subtype.ext; apply ULift.ext; apply ContinuousMap.ext; intro y
      refine (hred T _ y).trans ?_
      exact hB (z0 y)
    · have hz0 : z = 0 := Subtype.ext (memN _ T hp z.1 z.2)
      exact ⟨0, by rw [hz0, map_zero]⟩

  have hcolP : Limits.IsColimit (Limits.CokernelCofork.ofπ (wcSpfRedP q Z ℓ n) w) := by
    apply Limits.evaluationJointlyReflectsColimits
    intro T
    refine (Limits.isColimitMapCoconeCoforkEquiv' ((evaluation _ _).obj T) w).symm ?_
    have hS : (ShortComplex.mk (((evaluation (X.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj T).map
        ((ℓ ^ n : ℕ) • 𝟙 (wcCcPre q Z ℓ)))
        (((evaluation (X.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj T).map (wcSpfRedP q Z ℓ n))
        (by rw [← Functor.map_comp, w, Functor.map_zero])).Exact := by
      rw [ShortComplex.ab_exact_iff]
      exact exactT T
    have : Epi (((evaluation (X.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj T).map
        (wcSpfRedP q Z ℓ n)) := by
      rw [AddCommGrpCat.epi_iff_surjective]
      exact surjT T
    exact hS.gIsCokernel

  have hcolS := Limits.isColimitMapCoconeCoforkEquiv'
    (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) w
    (Limits.isColimitOfPreserves
      (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) hcolP)
  have hf : (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
      ((ℓ ^ n : ℕ) • 𝟙 (wcCcPre q Z ℓ)) = (ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf q Z ℓ) := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rfl
  have key : ∀ (f' : wcCoverSheaf q Z ℓ ⟶ wcCoverSheaf q Z ℓ),
      (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
        ((ℓ ^ n : ℕ) • 𝟙 (wcCcPre q Z ℓ)) = f' →
      ∃ w'' : f' ≫ (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
          (wcSpfRedP q Z ℓ n) = 0,
        Nonempty (Limits.IsColimit (Limits.CokernelCofork.ofπ
          ((presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
            (wcSpfRedP q Z ℓ n)) w'')) := by
    rintro _ rfl
    exact ⟨_, ⟨hcolS⟩⟩
  obtain ⟨w'', ⟨hc⟩⟩ := key _ hf
  refine ⟨(Limits.cokernelIsCokernel ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf q Z ℓ))).coconePointUniqueUpToIso
    hc, ?_⟩
  exact Limits.IsColimit.comp_coconePointUniqueUpToIso_hom
    (Limits.cokernelIsCokernel ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf q Z ℓ))) hc
    Limits.WalkingParallelPair.one

theorem wcSpfR_tci_fan_limit {X V : Scheme.{u}} (q : V ⟶ X) (Z : Set X) (ℓ n r : ℕ) :
    Nonempty (Limits.IsLimit (Limits.Fan.mk (wcSpfQrPre q Z ℓ n r)
      (fun j : Fin r => wcSpfQPrj q Z ℓ n r j))) :=
by
  classical

  have s1 : ∀ {J : Type} {f : J → AddCommGrpCat.{u+1}} (c : Limits.Fan f),
      (∀ x x' : c.pt, (∀ j, (c.proj j).hom x = (c.proj j).hom x') → x = x') →
      (∀ y : (j : J) → f j, ∃ x : c.pt, ∀ j, (c.proj j).hom x = y j) →
      Nonempty (Limits.IsLimit c) := by
    intro J f c hinj hsurj
    let L : (s : Limits.Fan f) → s.pt → c.pt := fun s x =>
      (hsurj (fun j => (s.proj j).hom x)).choose
    have hL : ∀ (s : Limits.Fan f) (x : s.pt) (j : J), (c.proj j).hom (L s x) = (s.proj j).hom x :=
      fun s x j => (hsurj (fun j => (s.proj j).hom x)).choose_spec j
    have hadd : ∀ (s : Limits.Fan f) (x x' : s.pt), L s (x + x') = L s x + L s x' := by
      intro s x x'
      apply hinj
      intro j
      rw [map_add, hL, hL, hL, map_add]
    refine ⟨Limits.Fan.IsLimit.mk c
      (fun s => AddCommGrpCat.ofHom (AddMonoidHom.mk' (L s) (hadd s))) ?_ ?_⟩
    · intro s j
      ext x
      simp only [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom, AddMonoidHom.coe_comp,
        Function.comp_apply, AddMonoidHom.mk'_apply]
      exact hL s x j
    · intro s m hm
      ext x
      simp only [AddCommGrpCat.hom_ofHom, AddMonoidHom.mk'_apply]
      apply hinj
      intro j
      rw [hL, ← hm j]
      rfl

  have s2 : ∀ (T : (X.ProEt)ᵒᵖ) (x x' : (wcSpfQrPre q Z ℓ n r).obj T),
      (∀ j : Fin r, ((wcSpfQPrj q Z ℓ n r j).app T).hom x =
        ((wcSpfQPrj q Z ℓ n r j).app T).hom x') → x = x' := by
    intro T x x' h
    apply Subtype.ext
    apply ULift.ext
    apply ContinuousMap.ext
    intro y
    funext j
    have := congrArg (fun z : (wcSpfQPre q Z ℓ n).obj T =>
      (show C(↥(Opposite.unop ((wcPbFun q).op.obj T)), ZMod (ℓ ^ n)) from z.1.down) y) (h j)
    exact this

  have s3 : ∀ (T : (X.ProEt)ᵒᵖ) (y : Fin r → (wcSpfQPre q Z ℓ n).obj T),
      ∃ x : (wcSpfQrPre q Z ℓ n r).obj T,
        ∀ j, ((wcSpfQPrj q Z ℓ n r j).app T).hom x = y j := by
    intro T y
    let G := ContinuousMap.pi (fun j => (y j).1.down)
    have hmem : (ULift.up G : (wcTwBase q ℓ n r).obj T) ∈
        wcExtZeroSub (wcTwBase q ℓ n r) (fun T : X.ProEt => ∀ t, T.hom t ∉ Z) T := by
      show (ULift.up G : (wcTwBase q ℓ n r).obj T) ∈ (⨆ _ : (∀ t, T.unop.hom t ∉ Z),
        (⊤ : AddSubgroup ((wcTwBase q ℓ n r).obj T)))
      by_cases hp : ∀ t, T.unop.hom t ∉ Z
      · rw [iSup_pos hp]
        exact AddSubgroup.mem_top _
      · have h0 : ∀ j, (y j).1 = 0 := by
          intro j
          have h1 : (y j).1 ∈ (⨆ _ : (∀ t, T.unop.hom t ∉ Z),
              (⊤ : AddSubgroup ((((wcPbFun q).op ⋙ continuousMapPresheafAb.{0, u} (ZMod (ℓ ^ n)) ⋙
                AddCommGrpCat.uliftFunctor.{u+1, u})).obj T))) := (y j).2
          rw [iSup_neg hp] at h1
          exact (AddSubgroup.mem_bot).mp h1
        have hG : G = 0 := by
          apply ContinuousMap.ext
          intro t
          funext j
          change (show C(↥(Opposite.unop ((wcPbFun q).op.obj T)), ZMod (ℓ ^ n)) from
            (y j).1.down) t = 0
          rw [h0 j]
          rfl
        have hz : (ULift.up G : (wcTwBase q ℓ n r).obj T) = 0 := by
          rw [hG]
          rfl
        rw [hz]
        exact AddSubgroup.zero_mem _
    refine ⟨(⟨ULift.up G, hmem⟩ : (wcSpfQrPre q Z ℓ n r).obj T), fun j => ?_⟩
    apply Subtype.ext
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    rfl

  refine ⟨Limits.evaluationJointlyReflectsLimits _ (fun T => ?_)⟩
  refine (Limits.isLimitMapConeFanMkEquiv ((evaluation _ _).obj T)
    (fun _ : Fin r => wcSpfQPre q Z ℓ n) (fun j => wcSpfQPrj q Z ℓ n r j)).symm ?_
  exact (s1 _ (fun x x' h => s2 T x x' h) (fun y => s3 T y)).some

theorem wcSpfR_tci_eq_joint_kernel {X V : Scheme.{u}} (q : V ⟶ X) (Z : Set X) (Γ : Type u)
    [Group Γ] [Fintype Γ] (α : Γ →* Aut V) (hα : ∀ g, (α g).hom ≫ q = q) (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (n r : ℕ) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) :
    Mono (wcSpfTwIncl q Z Γ α hα ℓ n r ρ) ∧
    (∀ (a : Fin (Fintype.card Γ)) (k : Fin r),
      wcSpfTwIncl q Z Γ α hα ℓ n r ρ ≫ wcSpfQPrj q Z ℓ n r k ≫
          wcSpfQActP q Z ℓ n (α ((Fintype.equivFin Γ).symm a)⁻¹).hom (hα _) =
        ∑ i : Fin r, wcSpfRhoEnt ρ a i k •
          (wcSpfTwIncl q Z Γ α hα ℓ n r ρ ≫ wcSpfQPrj q Z ℓ n r i)) ∧
    (∀ (W : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (h : W ⟶ wcSpfQrPre q Z ℓ n r),
      (∀ (a : Fin (Fintype.card Γ)) (k : Fin r),
        h ≫ wcSpfQPrj q Z ℓ n r k ≫
            wcSpfQActP q Z ℓ n (α ((Fintype.equivFin Γ).symm a)⁻¹).hom (hα _) =
          ∑ i : Fin r, wcSpfRhoEnt ρ a i k • (h ≫ wcSpfQPrj q Z ℓ n r i)) →
      ∃ l : W ⟶ wcSpfTwPre q Z Γ α hα ℓ n r ρ, l ≫ wcSpfTwIncl q Z Γ α hα ℓ n r ρ = h) :=
by
  classical
  haveI : NeZero (ℓ ^ n) := ⟨pow_ne_zero n (Fact.out : Nat.Prime ℓ).ne_zero⟩
  let A : Γ → (wcTwBase q ℓ n r ⟶ wcTwBase q ℓ n r) := fun g =>
    Functor.whiskerRight (NatTrans.op (wcPbAct q (α g).hom (hα g)))
      (continuousMapPresheafAb.{0, u} (Fin r → ZMod (ℓ ^ n)) ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u})
  let B : Γ → (wcTwBase q ℓ n r ⟶ wcTwBase q ℓ n r) := fun g =>
    wcTwMatAct q ℓ n r (((ρ g)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) :
      Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))

  have s2 : ∀ (g : Γ) (v : Fin r → ZMod (ℓ ^ n)) (k : Fin r),
      ∑ i : Fin r, ((ρ g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) i k).val • v i =
        Matrix.vecMul v (((ρ g⁻¹)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) :
          Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) k := by
    intro g v k
    rw [map_inv, inv_inv]
    simp only [Matrix.vecMul, dotProduct]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [nsmul_eq_mul, ZMod.natCast_zmod_val, mul_comm]

  have hevalA : ∀ {W : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (h : W ⟶ wcSpfQrPre q Z ℓ n r)
      (T : (X.ProEt)ᵒᵖ) (w : W.obj T) (σ : V ⟶ V) (hσ : σ ≫ q = q) (k : Fin r)
      (y : (wcPbFun q).obj T.unop),
      (@id C(↥((wcPbFun q).obj T.unop), ZMod (ℓ ^ n))
          (((h ≫ wcSpfQPrj q Z ℓ n r k ≫ wcSpfQActP q Z ℓ n σ hσ).app T).hom w).1.down) y =
        (@id C(↥((wcPbFun q).obj T.unop), Fin r → ZMod (ℓ ^ n)) ((h.app T).hom w).1.down)
          ((wcPbAct q σ hσ).app T.unop y) k := by
    intros; rfl

  have hsum : ∀ {W : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (h : W ⟶ wcSpfQrPre q Z ℓ n r)
      (T : (X.ProEt)ᵒᵖ) (w : W.obj T) (y : (wcPbFun q).obj T.unop) (c : Fin r → ℕ),
      (@id C(↥((wcPbFun q).obj T.unop), ZMod (ℓ ^ n))
          (((∑ i : Fin r, c i • (h ≫ wcSpfQPrj q Z ℓ n r i)).app T).hom w).1.down) y =
        ∑ i : Fin r, c i • (@id C(↥((wcPbFun q).obj T.unop), Fin r → ZMod (ℓ ^ n))
          ((h.app T).hom w).1.down) y i := by
    intro W h T w y c
    let E : (W ⟶ wcSpfQPre q Z ℓ n) →+ ZMod (ℓ ^ n) :=
      { toFun := fun f => (@id C(↥((wcPbFun q).obj T.unop), ZMod (ℓ ^ n))
          ((f.app T).hom w).1.down) y
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    show E (∑ i : Fin r, c i • (h ≫ wcSpfQPrj q Z ℓ n r i)) = _
    rw [map_sum]
    simp only [map_nsmul]
    rfl

  have extQ : ∀ {W : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (f f' : W ⟶ wcSpfQPre q Z ℓ n),
      (∀ (T : (X.ProEt)ᵒᵖ) (w : W.obj T) (y : (wcPbFun q).obj T.unop),
        (@id C(↥((wcPbFun q).obj T.unop), ZMod (ℓ ^ n)) ((f.app T).hom w).1.down) y =
          (@id C(↥((wcPbFun q).obj T.unop), ZMod (ℓ ^ n)) ((f'.app T).hom w).1.down) y) →
      f = f' := by
    intro W f f' H
    apply NatTrans.ext; funext T; apply AddCommGrpCat.ext; intro w
    apply Subtype.ext; apply ULift.ext; apply ContinuousMap.ext; intro y
    exact H T w y

  have hmem : ∀ (T : (X.ProEt)ᵒᵖ) (m : (wcTwBase q ℓ n r).obj T),
      m ∈ wcTwEqSub (wcTwBase q ℓ n r) A B T ↔ ∀ (g : Γ) (y : (wcPbFun q).obj T.unop),
        (@id C(↥((wcPbFun q).obj T.unop), Fin r → ZMod (ℓ ^ n)) m.down)
            ((wcPbAct q (α g).hom (hα g)).app T.unop y) =
          Matrix.vecMul ((@id C(↥((wcPbFun q).obj T.unop), Fin r → ZMod (ℓ ^ n)) m.down) y)
            (((ρ g)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) := by
    intro T m
    rw [wcTwEqSub, AddSubgroup.mem_iInf]
    refine forall_congr' (fun g => ?_)
    rw [AddMonoidHom.mem_ker, AddCommGrpCat.hom_sub, AddMonoidHom.sub_apply, sub_eq_zero]
    constructor
    · intro h y
      exact congrArg (fun z : (wcTwBase q ℓ n r).obj T =>
        (@id C(↥((wcPbFun q).obj T.unop), Fin r → ZMod (ℓ ^ n)) z.down) y) h
    · intro h
      apply ULift.ext
      apply ContinuousMap.ext
      intro y
      exact h y

  have hM : Mono (wcSpfTwIncl q Z Γ α hα ℓ n r ρ) := by
    haveI : ∀ T, Mono ((wcSpfTwIncl q Z Γ α hα ℓ n r ρ).app T) := fun T =>
      (AddCommGrpCat.mono_iff_injective _).2 (fun x x' hxx => by
        have h1 : x.1.1 = x'.1.1 :=
          congrArg (fun z : (wcSpfQrPre q Z ℓ n r).obj T => z.1) hxx
        exact Subtype.ext (Subtype.ext h1))
    exact NatTrans.mono_of_mono_app _
  refine ⟨hM, ?_, ?_⟩
  ·
    intro a k
    apply extQ
    intro T x y
    rw [hevalA, hsum]
    have hm := (hmem T (((wcSpfTwIncl q Z Γ α hα ℓ n r ρ).app T).hom x).1).1 x.1.2
      ((Fintype.equivFin Γ).symm a)⁻¹ y
    exact (congrFun hm k).trans (s2 _ _ k).symm
  ·
    intro W h Hyp
    have hmemh : ∀ (T : (X.ProEt)ᵒᵖ) (w : W.obj T),
        ((h.app T).hom w).1 ∈ wcTwEqSub (wcTwBase q ℓ n r) A B T := by
      intro T w
      rw [hmem]
      intro g y
      funext k
      obtain ⟨a, ha⟩ := (Fintype.equivFin Γ).symm.surjective g⁻¹
      have hg : g = ((Fintype.equivFin Γ).symm a)⁻¹ := by rw [ha, inv_inv]
      subst hg
      have H := congrArg (fun f : W ⟶ wcSpfQPre q Z ℓ n =>
        (@id C(↥((wcPbFun q).obj T.unop), ZMod (ℓ ^ n)) ((f.app T).hom w).1.down) y) (Hyp a k)
      beta_reduce at H
      rw [hevalA, hsum] at H
      exact H.trans (s2 _ _ k)
    let lapp : ∀ T, W.obj T ⟶ (wcSpfTwPre q Z Γ α hα ℓ n r ρ).obj T := fun T =>
      AddCommGrpCat.ofHom (AddMonoidHom.codRestrict
        ((AddMonoidHom.codRestrict
          ((wcExtZeroSub (wcTwBase q ℓ n r) (fun T : X.ProEt => ∀ t, T.hom t ∉ Z) T).subtype.comp
            (h.app T).hom) (wcTwEqSub (wcTwBase q ℓ n r) A B T) (hmemh T)) :
          W.obj T →+ (wcTwEqPre (wcTwBase q ℓ n r) A B).obj T)
        (wcExtZeroSub (wcTwEqPre (wcTwBase q ℓ n r) A B)
          (fun T : X.ProEt => ∀ t, T.hom t ∉ Z) T)
        (fun w => by
          by_cases hT : ∀ t, T.unop.hom t ∉ Z
          · exact AddSubgroup.mem_iSup_of_mem hT (AddSubgroup.mem_top _)
          · have hx : ((h.app T).hom w).1 ∈ (⨆ _ : (∀ t, T.unop.hom t ∉ Z),
                (⊤ : AddSubgroup ((wcTwBase q ℓ n r).obj T))) := ((h.app T).hom w).2
            rw [iSup_neg hT, AddSubgroup.mem_bot] at hx
            have h0 : ∀ z : ↑((wcTwEqPre (wcTwBase q ℓ n r) A B).obj T), z.1 = 0 →
                z ∈ wcExtZeroSub (wcTwEqPre (wcTwBase q ℓ n r) A B)
                  (fun T : X.ProEt => ∀ t, T.hom t ∉ Z) T := by
              intro z hz
              have hz0 : z = 0 := Subtype.ext hz
              rw [hz0]; exact AddSubgroup.zero_mem _
            exact h0 _ hx))
    refine ⟨{ app := lapp, naturality := ?_ }, ?_⟩
    · intro T T' f
      apply AddCommGrpCat.ext; intro w
      apply Subtype.ext; apply Subtype.ext
      exact congrArg (fun φ => (φ.hom w).1) (h.naturality f)
    · apply NatTrans.ext; funext T; apply AddCommGrpCat.ext; intro w
      apply Subtype.ext; rfl

theorem wcSpfR_tw_coker_iso (K : Type u) [Field K] [Finite K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ] [Fintype Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α)
    (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (n : ℕ) (hn : 1 ≤ n) (r : ℕ) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n)))
    (lamF : MonoidAlgebra ℤ_[ℓ] Γ → (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶ wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (hlamF : wcRingAct lamF)
    (hlamFs : ∀ (g : Γ) (a : ℤ_[ℓ]), lamF (MonoidAlgebra.single g a) =
      wcCoverScal (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ a ≫
        wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
          (α g⁻¹).hom (hα g⁻¹))
    (lamG : MonoidAlgebra ℤ_[ℓ] Γ → (Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)) ⟶
      Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))))
    (hlamG : ∀ x, Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)) ≫ lamG x =
      lamF x ≫ Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))) :
    Nonempty (wcTwSh (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) Γ α hα
      ℓ n r ρ ≅ wcSpfTw (Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))) lamG ρ) :=
by
  classical
  have key : ∀ {X : Scheme.{u}} (q : V ⟶ X) (Z : Set X) (hα : ∀ γ, (α γ).hom ≫ q = q)
      (lamF : MonoidAlgebra ℤ_[ℓ] Γ → (wcCoverSheaf q Z ℓ ⟶ wcCoverSheaf q Z ℓ))
      (hlamFs : ∀ (g : Γ) (a : ℤ_[ℓ]), lamF (MonoidAlgebra.single g a) =
        wcCoverScal q Z ℓ a ≫ wcCoverAct q Z ℓ (α g⁻¹).hom (hα g⁻¹))
      (lamG : MonoidAlgebra ℤ_[ℓ] Γ → (Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf q Z ℓ)) ⟶
        Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf q Z ℓ))))
      (hlamG : ∀ x, Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf q Z ℓ)) ≫ lamG x =
        lamF x ≫ Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf q Z ℓ))),
      Nonempty (wcTwSh q Z Γ α hα ℓ n r ρ ≅
        wcSpfTw (Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf q Z ℓ))) lamG ρ) := by
    intro X q Z hα lamF hlamFs lamG hlamG

    have hscalP : wcCcScalP q Z ℓ 1 = 𝟙 _ := by
      apply NatTrans.ext; funext T; apply AddCommGrpCat.ext; intro x
      apply Subtype.ext; apply ULift.ext; apply ContinuousMap.ext; intro y
      first
        | exact one_smul ℤ_[ℓ] _
        | simp [wcCcScalP, wcExtZeroMap]
    have hscal : wcCoverScal q Z ℓ 1 = 𝟙 _ := by
      have h0 : wcCoverScal q Z ℓ 1 =
          (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
            (wcCcScalP q Z ℓ 1) := rfl
      rw [h0, hscalP]
      exact (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map_id _
    have hact : ∀ g : Γ, lamF (MonoidAlgebra.single g 1) =
        (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
          (wcCcActP q Z ℓ (α g⁻¹).hom (hα g⁻¹)) := by
      intro g
      rw [hlamFs g 1, hscal, Category.id_comp]
      rfl

    have hred : ∀ (σ : V ⟶ V) (hσ : σ ≫ q = q), wcSpfRedP q Z ℓ n ≫ wcSpfQActP q Z ℓ n σ hσ =
        wcCcActP q Z ℓ σ hσ ≫ wcSpfRedP q Z ℓ n := by
      intro σ hσ
      apply NatTrans.ext; funext T; apply AddCommGrpCat.ext; intro x
      apply Subtype.ext; apply ULift.ext; apply ContinuousMap.ext; intro y
      rfl

    obtain ⟨e, he⟩ := wcSpfR_tci_coker_red q Z ℓ n
    have hG3 : ∀ g : Γ, e.hom ≫ (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
        (wcSpfQActP q Z ℓ n (α g⁻¹).hom (hα g⁻¹)) = lamG (MonoidAlgebra.single g 1) ≫ e.hom := by
      intro g
      apply (cancel_epi (Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf q Z ℓ)))).1
      have e1 : (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
            (wcSpfRedP q Z ℓ n) ≫
          (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
            (wcSpfQActP q Z ℓ n (α g⁻¹).hom (hα g⁻¹)) =
          (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
            (wcCcActP q Z ℓ (α g⁻¹).hom (hα g⁻¹)) ≫
          (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
            (wcSpfRedP q Z ℓ n) := by
        rw [← Functor.map_comp, ← Functor.map_comp, hred]
      rw [← Category.assoc, he]
      refine e1.trans ?_
      have e2 : (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
            (wcCcActP q Z ℓ (α g⁻¹).hom (hα g⁻¹)) ≫
          (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
            (wcSpfRedP q Z ℓ n) = lamF (MonoidAlgebra.single g 1) ≫
            (Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf q Z ℓ)) ≫ e.hom) := by
        rw [he, hact g]
        rfl
      refine e2.trans ?_
      rw [← Category.assoc, ← hlamG, Category.assoc]

    let lamQ : MonoidAlgebra ℤ_[ℓ] Γ → (wcSpfQPre q Z ℓ n ⟶ wcSpfQPre q Z ℓ n) := fun x =>
      if h : ∃ g : Γ, x = MonoidAlgebra.single g 1 then
        wcSpfQActP q Z ℓ n (α h.choose⁻¹).hom (hα h.choose⁻¹) else 0
    have hcongr : ∀ g1 g2 : Γ, g1 = g2 → wcSpfQActP q Z ℓ n (α g1⁻¹).hom (hα g1⁻¹) =
        wcSpfQActP q Z ℓ n (α g2⁻¹).hom (hα g2⁻¹) := by
      rintro _ _ rfl; rfl
    have hlamQ : ∀ g : Γ, lamQ (MonoidAlgebra.single g 1) =
        wcSpfQActP q Z ℓ n (α g⁻¹).hom (hα g⁻¹) := by
      intro g
      have h : ∃ g' : Γ, MonoidAlgebra.single g (1 : ℤ_[ℓ]) = MonoidAlgebra.single g' 1 :=
        ⟨g, rfl⟩
      have hc : h.choose = g :=
        (MonoidAlgebra.single_left_injective (one_ne_zero : (1 : ℤ_[ℓ]) ≠ 0) h.choose_spec).symm
      show (if h' : ∃ g' : Γ, MonoidAlgebra.single g (1 : ℤ_[ℓ]) = MonoidAlgebra.single g' 1 then
        wcSpfQActP q Z ℓ n (α h'.choose⁻¹).hom (hα h'.choose⁻¹) else 0) = _
      rw [dif_pos h]
      exact hcongr _ _ hc
    have hG3' : ∀ g : Γ, e.hom ≫ (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
        (lamQ (MonoidAlgebra.single g 1)) = lamG (MonoidAlgebra.single g 1) ≫ e.hom := by
      intro g
      rw [hlamQ g]
      exact hG3 g

    obtain ⟨hmono, h1, h2⟩ := wcSpfR_tci_eq_joint_kernel q Z Γ α hα ℓ n r ρ
    have hprj := (wcSpfR_tci_fan_limit q Z ℓ n r).some
    let φ : wcSpfQrPre q Z ℓ n r ⟶ ∏ᶜ (fun _ : Fin r => wcSpfQPre q Z ℓ n) :=
      Limits.Pi.lift (fun j => wcSpfQPrj q Z ℓ n r j)
    let ψ : (∏ᶜ (fun _ : Fin r => wcSpfQPre q Z ℓ n)) ⟶ wcSpfQrPre q Z ℓ n r :=
      hprj.lift (Limits.Fan.mk _ (fun j => Limits.Pi.π (fun _ : Fin r => wcSpfQPre q Z ℓ n) j))
    have hψ : ∀ j, ψ ≫ wcSpfQPrj q Z ℓ n r j =
        Limits.Pi.π (fun _ : Fin r => wcSpfQPre q Z ℓ n) j :=
      fun j => hprj.fac _ ⟨j⟩
    have hψ' : ∀ j {Y : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (x : wcSpfQPre q Z ℓ n ⟶ Y),
        ψ ≫ wcSpfQPrj q Z ℓ n r j ≫ x =
          Limits.Pi.π (fun _ : Fin r => wcSpfQPre q Z ℓ n) j ≫ x := by
      intro j Y x; rw [← Category.assoc, hψ]
    have hφπ : ∀ j, φ ≫ Limits.Pi.π (fun _ : Fin r => wcSpfQPre q Z ℓ n) j =
        wcSpfQPrj q Z ℓ n r j :=
      fun j => Limits.Pi.lift_comp_π _ _
    have hφπ' : ∀ j {Y : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (x : wcSpfQPre q Z ℓ n ⟶ Y),
        φ ≫ Limits.Pi.π (fun _ : Fin r => wcSpfQPre q Z ℓ n) j ≫ x =
          wcSpfQPrj q Z ℓ n r j ≫ x := by
      intro j Y x; rw [← Category.assoc, hφπ]
    have hψφ : ψ ≫ φ = 𝟙 _ := by
      apply Limits.Pi.hom_ext; intro j
      rw [Category.assoc, hφπ, hψ, Category.id_comp]
    have hφψ : φ ≫ ψ = 𝟙 _ := by
      apply Limits.Fan.IsLimit.hom_ext hprj; intro j
      show (φ ≫ ψ) ≫ wcSpfQPrj q Z ℓ n r j = 𝟙 _ ≫ wcSpfQPrj q Z ℓ n r j
      rw [Category.assoc, hψ, hφπ, Category.id_comp]
    have hD : ∀ {W : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
        (h : W ⟶ ∏ᶜ (fun _ : Fin r => wcSpfQPre q Z ℓ n))
        (a : Fin (Fintype.card Γ)) (k : Fin r),
        h ≫ wcSpfTwD (wcSpfQPre q Z ℓ n) lamQ ρ ≫
            Limits.Pi.π (fun _ : Fin (Fintype.card Γ) × Fin r => wcSpfQPre q Z ℓ n) (a, k) =
          h ≫ Limits.Pi.π (fun _ : Fin r => wcSpfQPre q Z ℓ n) k ≫
              wcSpfQActP q Z ℓ n (α ((Fintype.equivFin Γ).symm a)⁻¹).hom (hα _) -
            ∑ i : Fin r, wcSpfRhoEnt ρ a i k •
              (h ≫ Limits.Pi.π (fun _ : Fin r => wcSpfQPre q Z ℓ n) i) := by
      intro W h a k
      simp only [wcSpfTwD, Limits.Pi.lift_comp_π, hlamQ, Preadditive.comp_sub,
        Preadditive.comp_sum, Preadditive.comp_nsmul]
    have hκ : (wcSpfTwIncl q Z Γ α hα ℓ n r ρ ≫ φ) ≫ wcSpfTwD (wcSpfQPre q Z ℓ n) lamQ ρ = 0 := by
      apply Limits.Pi.hom_ext; rintro ⟨a, k⟩
      have e1 := hD (wcSpfTwIncl q Z Γ α hα ℓ n r ρ ≫ φ) a k
      simp only [Category.assoc, Limits.zero_comp] at e1 ⊢
      rw [e1]
      simp only [hφπ, hφπ']
      rw [h1 a k, sub_self]
    have hh : ∀ {W' : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
        (g' : W' ⟶ ∏ᶜ (fun _ : Fin r => wcSpfQPre q Z ℓ n))
        (_ : g' ≫ wcSpfTwD (wcSpfQPre q Z ℓ n) lamQ ρ = 0) (a : Fin (Fintype.card Γ)) (k : Fin r),
        (g' ≫ ψ) ≫ wcSpfQPrj q Z ℓ n r k ≫
            wcSpfQActP q Z ℓ n (α ((Fintype.equivFin Γ).symm a)⁻¹).hom (hα _) =
          ∑ i : Fin r, wcSpfRhoEnt ρ a i k • ((g' ≫ ψ) ≫ wcSpfQPrj q Z ℓ n r i) := by
      intro W' g' eq' a k
      have e0 : g' ≫ wcSpfTwD (wcSpfQPre q Z ℓ n) lamQ ρ ≫
          Limits.Pi.π (fun _ : Fin (Fintype.card Γ) × Fin r => wcSpfQPre q Z ℓ n) (a, k) = 0 := by
        rw [reassoc_of% eq', Limits.zero_comp]
      have e1 := (hD g' a k).symm.trans e0
      simp only [Category.assoc, hψ, hψ']
      exact sub_eq_zero.mp e1
    haveI := hmono
    let isl : Limits.IsLimit (Limits.KernelFork.ofι (wcSpfTwIncl q Z Γ α hα ℓ n r ρ ≫ φ) hκ) :=
      Limits.KernelFork.IsLimit.ofι _ hκ
        (fun g' eq' => (h2 _ (g' ≫ ψ) (hh g' eq')).choose)
        (fun g' eq' => by
          rw [← Category.assoc, (h2 _ (g' ≫ ψ) (hh g' eq')).choose_spec, Category.assoc, hψφ,
            Category.comp_id])
        (fun g' eq' m hm => by
          apply (cancel_mono (wcSpfTwIncl q Z Γ α hα ℓ n r ρ)).1
          rw [(h2 _ (g' ≫ ψ) (hh g' eq')).choose_spec, ← hm]
          simp only [Category.assoc, hφψ, Category.comp_id])
    let τ₁ := isl.conePointUniqueUpToIso
      (Limits.kernelIsKernel (wcSpfTwD (wcSpfQPre q Z ℓ n) lamQ ρ))

    have hcomm2 : (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map
          (wcSpfTwD (wcSpfQPre q Z ℓ n) lamQ ρ) ≫
        (Limits.PreservesProduct.iso (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
          (fun _ : Fin (Fintype.card Γ) × Fin r => wcSpfQPre q Z ℓ n)).hom =
        (Limits.PreservesProduct.iso (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
          (fun _ : Fin r => wcSpfQPre q Z ℓ n)).hom ≫
        wcSpfTwD ((presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).obj
            (wcSpfQPre q Z ℓ n))
          (fun x => (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map (lamQ x))
          ρ := by
      apply Limits.Pi.hom_ext; rintro ⟨a, k⟩
      simp only [Category.assoc, Limits.PreservesProduct.iso_hom, Limits.piComparison_comp_π]
      rw [← Functor.map_comp]
      simp only [wcSpfTwD, Limits.Pi.lift_comp_π, Functor.map_sub, Functor.map_sum,
        Functor.map_nsmul, Functor.map_comp, Preadditive.comp_sub, Preadditive.comp_sum,
        Preadditive.comp_nsmul, Limits.piComparison_comp_π_assoc, Limits.piComparison_comp_π]
    let τ₂ := Limits.PreservesKernel.iso
        (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
        (wcSpfTwD (wcSpfQPre q Z ℓ n) lamQ ρ) ≪≫
      Limits.kernel.mapIso _ _ _ _ hcomm2

    have hcomm3 : wcSpfTwD (Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf q Z ℓ))) lamG ρ ≫
        (asIso (Limits.Pi.map (fun _ : Fin (Fintype.card Γ) × Fin r => e.hom))).hom =
        (asIso (Limits.Pi.map (fun _ : Fin r => e.hom))).hom ≫
        wcSpfTwD ((presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).obj
            (wcSpfQPre q Z ℓ n))
          (fun x => (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map (lamQ x))
          ρ := by
      apply Limits.Pi.hom_ext; rintro ⟨a, k⟩
      simp only [asIso_hom, Category.assoc, Limits.Pi.map_π, wcSpfTwD, Limits.Pi.lift_comp_π,
        Limits.Pi.lift_comp_π_assoc, Preadditive.sub_comp, Preadditive.comp_sub,
        Preadditive.sum_comp, Preadditive.comp_sum, Preadditive.nsmul_comp, Preadditive.comp_nsmul,
        Limits.Pi.map_π_assoc, hG3']
    let τ₃ := Limits.kernel.mapIso _ _ _ _ hcomm3
    exact ⟨(presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).mapIso τ₁ ≪≫
      τ₂ ≪≫ τ₃.symm⟩
  exact key (q' ≫ Uo.ι) _ hα lamF hlamFs lamG hlamG

theorem wcSpfR_staircase {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜]
    (D : ℕ → ℕ → 𝒜) (dh : ∀ p k, D p k ⟶ D p (k + 1)) (dv : ∀ p k, D p k ⟶ D (p + 1) k)
    (hcomm : ∀ p k, dh p k ≫ dv p (k + 1) = dv p k ≫ dh (p + 1) k)
    (T : CochainComplex 𝒜 ℕ) (ε : ∀ k, T.X k ⟶ D 0 k)
    (hε : ∀ k, T.d k (k + 1) ≫ ε (k + 1) = ε k ≫ dh 0 k) (hεm : ∀ k, Mono (ε k))
    (hεx : ∀ k, ∃ w : ε k ≫ dv 0 k = 0, (ShortComplex.mk _ _ w).Exact)
    (G : ℕ → 𝒜) (dG : ∀ p, G p ⟶ G (p + 1)) (η : ∀ p, G p ⟶ D p 0)
    (hη : ∀ p, dG p ≫ η (p + 1) = η p ≫ dv p 0) (hηm : ∀ p, Mono (η p))
    (hηx : ∀ p, ∃ w : η p ≫ dh p 0 = 0, (ShortComplex.mk _ _ w).Exact)
    (hcol : ∀ p k, ∃ w : dv p k ≫ dv (p + 1) k = 0, (ShortComplex.mk _ _ w).Exact)
    (hrow : ∀ p k, ∃ w : dh p k ≫ dh p (k + 1) = 0, (ShortComplex.mk _ _ w).Exact)
    (hG : ∀ p, ∃ w : dG p ≫ dG (p + 1) = 0, (ShortComplex.mk _ _ w).Exact) :
    ∀ p, (T.sc (p + 1)).Exact :=
by

  have base : ∀ (p : ℕ) (A : 𝒜) (a : A ⟶ D p (0 + 1)), a ≫ dh p (0 + 1) = 0 →
      a ≫ dv p (0 + 1) = 0 → ∃ (A' : 𝒜) (π : A' ⟶ A) (_ : Epi π) (b : A' ⟶ D p 0),
        b ≫ dv p 0 = 0 ∧ b ≫ dh p 0 = π ≫ a := by
    intro p A a ha1 ha2
    obtain ⟨_, hr⟩ := hrow p 0
    obtain ⟨A₁, π₁, hπ₁, b₀, hb₀⟩ := hr.exact_up_to_refinements a ha1
    have hb₀' : π₁ ≫ a = b₀ ≫ dh p 0 := hb₀
    obtain ⟨wc, -⟩ := hcol p 0
    have hc1 : (b₀ ≫ dv p 0) ≫ dh (p + 1) 0 = 0 := by
      rw [Category.assoc, ← hcomm p 0, ← Category.assoc, ← hb₀', Category.assoc, ha2,
        Limits.comp_zero]
    obtain ⟨_, hηe⟩ := hηx (p + 1)
    obtain ⟨A₂, π₂, hπ₂, g, hg⟩ := hηe.exact_up_to_refinements (b₀ ≫ dv p 0) hc1
    have hg' : π₂ ≫ b₀ ≫ dv p 0 = g ≫ η (p + 1) := hg
    have hg0 : g ≫ dG (p + 1) = 0 := by
      have := hηm (p + 1 + 1)
      refine (cancel_mono (η (p + 1 + 1))).1 ?_
      rw [Limits.zero_comp, Category.assoc, hη (p + 1), ← Category.assoc, ← hg']
      simp only [Category.assoc, wc, Limits.comp_zero]
    obtain ⟨_, hGe⟩ := hG p
    obtain ⟨A₃, π₃, hπ₃, h, hh⟩ := hGe.exact_up_to_refinements g hg0
    have hh' : π₃ ≫ g = h ≫ dG p := hh
    obtain ⟨wη0, -⟩ := hηx p
    refine ⟨A₃, π₃ ≫ π₂ ≫ π₁, inferInstance, π₃ ≫ π₂ ≫ b₀ - h ≫ η p, ?_, ?_⟩
    · rw [Preadditive.sub_comp, sub_eq_zero]
      simp only [Category.assoc]
      rw [hg', ← hη p, ← Category.assoc h, ← hh', Category.assoc]
    · simp only [Preadditive.sub_comp, Category.assoc, wη0, Limits.comp_zero, sub_zero, ← hb₀']

  have step : ∀ k : ℕ, (∀ (p : ℕ) (A : 𝒜) (a : A ⟶ D p (k + 1)), a ≫ dh p (k + 1) = 0 →
        a ≫ dv p (k + 1) = 0 → ∃ (A' : 𝒜) (π : A' ⟶ A) (_ : Epi π) (b : A' ⟶ D p k),
          b ≫ dv p k = 0 ∧ b ≫ dh p k = π ≫ a) →
      ∀ (p : ℕ) (A : 𝒜) (a : A ⟶ D p (k + 1 + 1)), a ≫ dh p (k + 1 + 1) = 0 →
        a ≫ dv p (k + 1 + 1) = 0 → ∃ (A' : 𝒜) (π : A' ⟶ A) (_ : Epi π) (b : A' ⟶ D p (k + 1)),
          b ≫ dv p (k + 1) = 0 ∧ b ≫ dh p (k + 1) = π ≫ a := by
    intro k IH p A a ha1 ha2
    obtain ⟨_, hr⟩ := hrow p (k + 1)
    obtain ⟨A₁, π₁, hπ₁, b₀, hb₀⟩ := hr.exact_up_to_refinements a ha1
    have hb₀' : π₁ ≫ a = b₀ ≫ dh p (k + 1) := hb₀
    obtain ⟨wc, -⟩ := hcol p (k + 1)
    have hc1 : (b₀ ≫ dv p (k + 1)) ≫ dh (p + 1) (k + 1) = 0 := by
      rw [Category.assoc, ← hcomm p (k + 1), ← Category.assoc, ← hb₀', Category.assoc, ha2,
        Limits.comp_zero]
    have hc2 : (b₀ ≫ dv p (k + 1)) ≫ dv (p + 1) (k + 1) = 0 := by
      rw [Category.assoc, wc, Limits.comp_zero]
    obtain ⟨A₂, π₂, hπ₂, e, he1, he2⟩ := IH (p + 1) A₁ (b₀ ≫ dv p (k + 1)) hc1 hc2
    obtain ⟨_, hce⟩ := hcol p k
    obtain ⟨A₃, π₃, hπ₃, f, hf⟩ := hce.exact_up_to_refinements e he1
    have hf' : π₃ ≫ e = f ≫ dv p k := hf
    obtain ⟨wr0, -⟩ := hrow p k
    refine ⟨A₃, π₃ ≫ π₂ ≫ π₁, inferInstance, π₃ ≫ π₂ ≫ b₀ - f ≫ dh p k, ?_, ?_⟩
    · rw [Preadditive.sub_comp, sub_eq_zero]
      simp only [Category.assoc]
      rw [hcomm p k, ← Category.assoc f, ← hf', Category.assoc, he2]
    · simp only [Preadditive.sub_comp, Category.assoc, wr0, Limits.comp_zero, sub_zero, ← hb₀']

  have stair : ∀ (k p : ℕ) (A : 𝒜) (a : A ⟶ D p (k + 1)), a ≫ dh p (k + 1) = 0 →
      a ≫ dv p (k + 1) = 0 → ∃ (A' : 𝒜) (π : A' ⟶ A) (_ : Epi π) (b : A' ⟶ D p k),
        b ≫ dv p k = 0 ∧ b ≫ dh p k = π ≫ a := by
    intro k
    induction k with
    | zero => exact base
    | succ k ih => exact step k ih

  intro p
  rw [← HomologicalComplex.exactAt_iff, HomologicalComplex.exactAt_iff' T p (p + 1) (p + 1 + 1)
    (CochainComplex.prev_nat_succ p) (CochainComplex.next ℕ (p + 1)),
    ShortComplex.exact_iff_exact_up_to_refinements]
  intro A (x : A ⟶ T.X (p + 1)) hx
  have hx' : x ≫ T.d (p + 1) (p + 1 + 1) = 0 := hx
  obtain ⟨wε, -⟩ := hεx (p + 1)
  have ha1 : (x ≫ ε (p + 1)) ≫ dh 0 (p + 1) = 0 := by
    rw [Category.assoc, ← hε (p + 1), ← Category.assoc, hx', Limits.zero_comp]
  have ha2 : (x ≫ ε (p + 1)) ≫ dv 0 (p + 1) = 0 := by
    rw [Category.assoc, wε, Limits.comp_zero]
  obtain ⟨A', π, hπ, b, hb1, hb2⟩ := stair p 0 A (x ≫ ε (p + 1)) ha1 ha2
  obtain ⟨_, hεe⟩ := hεx p
  obtain ⟨A'', π', hπ', y, hy⟩ := hεe.exact_up_to_refinements b hb1
  have hy' : π' ≫ b = y ≫ ε p := hy
  refine ⟨A'', π' ≫ π, inferInstance, y, ?_⟩
  show (π' ≫ π) ≫ x = y ≫ T.d p (p + 1)
  have := hεm (p + 1)
  refine (cancel_mono (ε (p + 1))).1 ?_
  rw [Category.assoc y, hε p, ← Category.assoc y, ← hy']
  simp only [Category.assoc, hb2]

theorem wcSpfR_bar_basic {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {Γ : Type u} [Group Γ] [Fintype Γ] (n r : ℕ) (hn : 1 ≤ n)
    (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (A : 𝒜) (lamA : MonoidAlgebra ℤ_[ℓ] Γ → (A ⟶ A))
    (hlam : wcRingAct lamA) (htor : ((ℓ ^ n : ℕ) : ℤ) • 𝟙 A = 0) :
    (∀ p, wcSpfBarD A lamA ρ p ≫ wcSpfBarD A lamA ρ (p + 1) = 0) ∧
    Mono (wcSpfBarEps A lamA ρ) ∧
    ∃ w : wcSpfBarEps A lamA ρ ≫ wcSpfBarD A lamA ρ 0 = 0, (ShortComplex.mk _ _ w).Exact :=
by
  have hdeg0 : Mono (wcSpfBarEps A lamA ρ) ∧
      ∃ w : wcSpfBarEps A lamA ρ ≫ wcSpfBarD A lamA ρ 0 = 0, (ShortComplex.mk _ _ w).Exact := by
    obtain ⟨E0, hE0⟩ : ∃ E0 : (∏ᶜ fun _ : Fin r => A) ≅ wcSpfBar A lamA ρ 0,
        ∀ fj, E0.hom ≫ Limits.Pi.π (fun _ : (Fin 0 → Fin (Fintype.card Γ)) × Fin r => A) fj =
          Limits.Pi.π (fun _ : Fin r => A) fj.2 :=
      ⟨{ hom := Limits.Pi.lift (fun fj : (Fin 0 → Fin (Fintype.card Γ)) × Fin r =>
            Limits.Pi.π (fun _ : Fin r => A) fj.2)
         inv := Limits.Pi.lift (fun j : Fin r =>
            Limits.Pi.π (fun _ : (Fin 0 → Fin (Fintype.card Γ)) × Fin r => A) (fun i => i.elim0, j))
         hom_inv_id := by
           apply Limits.Pi.hom_ext; intro j
           rw [Category.assoc, Limits.Pi.lift_comp_π, Limits.Pi.lift_comp_π, Category.id_comp]
         inv_hom_id := by
           apply Limits.Pi.hom_ext; intro fj
           obtain ⟨x, j⟩ := fj
           have hx : x = (fun i => i.elim0) := Subsingleton.elim _ _
           subst hx
           rw [Category.assoc, Limits.Pi.lift_comp_π, Limits.Pi.lift_comp_π, Category.id_comp] },
        fun fj => Limits.Pi.lift_comp_π _ _⟩
    obtain ⟨E1, hE1⟩ : ∃ E1 : (∏ᶜ fun _ : Fin (Fintype.card Γ) × Fin r => A) ≅ wcSpfBar A lamA ρ 1,
        ∀ fj, E1.hom ≫ Limits.Pi.π (fun _ : (Fin 1 → Fin (Fintype.card Γ)) × Fin r => A) fj =
          Limits.Pi.π (fun _ : Fin (Fintype.card Γ) × Fin r => A) (fj.1 0, fj.2) :=
      ⟨{ hom := Limits.Pi.lift (fun fj : (Fin 1 → Fin (Fintype.card Γ)) × Fin r =>
            Limits.Pi.π (fun _ : Fin (Fintype.card Γ) × Fin r => A) (fj.1 0, fj.2))
         inv := Limits.Pi.lift (fun aj : Fin (Fintype.card Γ) × Fin r =>
            Limits.Pi.π (fun _ : (Fin 1 → Fin (Fintype.card Γ)) × Fin r => A) (fun _ => aj.1, aj.2))
         hom_inv_id := by
           apply Limits.Pi.hom_ext; intro aj
           rw [Category.assoc, Limits.Pi.lift_comp_π, Limits.Pi.lift_comp_π, Category.id_comp]
         inv_hom_id := by
           apply Limits.Pi.hom_ext; intro fj
           obtain ⟨x, j⟩ := fj
           have hx : (fun _ => x 0) = x := funext fun i => by rw [Fin.fin_one_eq_zero i]
           rw [Category.assoc, Limits.Pi.lift_comp_π, Limits.Pi.lift_comp_π, Category.id_comp]
           dsimp only
           rw [hx] },
