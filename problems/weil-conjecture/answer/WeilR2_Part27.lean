      Limits.kernel.ι (wcSpfTwD ((wcSmsBar P n).X k) (fun x => (wcSmsBarSmul P n x).f k) ρ) =
      Limits.kernel.ι (wcSpfTwD ((wcSmsBar P n).X k) (fun x => (wcSmsBarSmul P n x).f k) ρ) ≫
        Limits.Pi.map (fun _ => (wcSmsBarFrob P n).f k) := Limits.kernel.lift_ι _ _ _
  erw [Category.assoc, hTF, Category.assoc]
  apply Limits.Pi.hom_ext
  intro j
  simp only [Category.assoc, Limits.Pi.map_π]
  rw [reassoc_of% (he k j), he k j]
  apply AddCommGrpCat.hom_ext
  refine AddMonoidHom.ext fun w => ?_
  apply hVPinj k
  simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
  rw [hFP, hFwd, hFwd, hFQ, Matrix.vecMul_vecMul, ← Matrix.map_mul, P.hεf,
    s1 (b k) (b k) (P.f k) (Q.f k) (hbf k),
    s1 (b k) (b k) (P.ε k) (Q.ε k) (hbε k), Matrix.vecMul_vecMul, Q.hfε]

theorem wcU_sms_trunc_comparison (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    {V : Scheme.{u}} (q : V ⟶ (wcP1Over K).left) (Z : Set (wcP1Over K).left)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (N : ℕ) (hN : 1 ≤ N)
    (I : InjectiveResolution (wcCoverSheaf q Z ℓ)) :
    ∃ χ : wcTruncKerRes (wcCxJ K hP I.cocomplex) N ≅ wcCxJ K hP (wcTruncKerRes I.cocomplex N),
      (∀ g : I.cocomplex ⟶ I.cocomplex, χ.hom ≫ wcCxJMap K hP (wcSpfTruncMap I.cocomplex N g) =
        wcSpfTruncMap _ N (wcCxJMap K hP g) ≫ χ.hom) ∧
      χ.hom ≫ wcCxJFrob K hP (wcTruncKerRes I.cocomplex N) =
        wcSpfTruncMap _ N (wcCxJFrob K hP I.cocomplex) ≫ χ.hom :=
by
  classical
  have hC : Mono (N • 𝟙 (wcCoverSheaf q Z ℓ)) := by
    have hn : 0 < N := hN
    have hn' : (N : ℤ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hn.ne'
    have key : ∀ (Y : Scheme.{u}) (w : ULift.{u+1} C(Y, ℤ_[ℓ])), N • w = 0 → w = 0 := by
      intro Y w h
      apply ULift.ext
      ext y
      have h0 : N • w.down = 0 := congrArg ULift.down h
      have h1 : (N • w.down) y = 0 := by rw [h0]; rfl
      rw [ContinuousMap.smul_apply, nsmul_eq_mul] at h1
      exact (mul_eq_zero.mp h1).resolve_left hn'
    set P := wcExtZeroPre (wcCoverBasePre q ℓ) (fun T : (wcP1Over K).left.ProEt => ∀ t, T.hom t ∉ Z)
        (fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _)
      with hPdef
    have happ : ∀ T, Mono ((N • 𝟙 P).app T) := by
      intro T
      rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.mono_iff_injective,
        injective_iff_map_eq_zero]
      intro x hx
      have hx' : N • x = 0 := hx
      apply Subtype.ext
      have h2 : N • (x.1 : ULift.{u+1} C((wcPbFun q).obj T.unop, ℤ_[ℓ])) = 0 := by
        have := congrArg Subtype.val hx'
        exact this
      exact key ((wcPbFun q).obj T.unop) x.1 h2
    have hPmono : Mono (N • 𝟙 P) := NatTrans.mono_of_mono_app _
    have e : (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}).map
        (N • 𝟙 P) = N • 𝟙 ((presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
          AddCommGrpCat.{u+1}).obj P) := by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    have hm : Mono ((presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1}).map (N • 𝟙 P)) := Functor.map_mono _ _
    rw [e] at hm
    exact hm
  have gen : ∀ (E : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1} ⥤
        AddCommGrpCat.{u+1}) [E.Additive] [Limits.PreservesFiniteLimits E] (θ : E ⟶ E)
      {A : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (I : InjectiveResolution A) (hA : Mono (N • 𝟙 A)),
      ∃ χ : wcTruncKerRes ((E.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex) N ≅
          (E.mapHomologicalComplex (ComplexShape.up ℕ)).obj (wcTruncKerRes I.cocomplex N),
        (∀ g : I.cocomplex ⟶ I.cocomplex,
          χ.hom ≫ (E.mapHomologicalComplex (ComplexShape.up ℕ)).map (wcSpfTruncMap I.cocomplex N g) =
          wcSpfTruncMap _ N ((E.mapHomologicalComplex (ComplexShape.up ℕ)).map g) ≫ χ.hom) ∧
        χ.hom ≫ (NatTrans.mapHomologicalComplex θ (ComplexShape.up ℕ)).app
            (wcTruncKerRes I.cocomplex N) =
          wcSpfTruncMap _ N ((NatTrans.mapHomologicalComplex θ (ComplexShape.up ℕ)).app
            I.cocomplex) ≫ χ.hom := by
    intro E _ _ θ A I hA
    classical

    have hιN : ∀ (X : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}),
        N • Limits.kernel.ι (N • 𝟙 X) = 0 := by
      intro X
      have h := Limits.kernel.condition (N • 𝟙 X)
      rwa [Preadditive.comp_nsmul, Category.comp_id] at h
    have hvN : ∀ {X X' : AddCommGrpCat.{u+1}} (v : X ⟶ X'), (N • 𝟙 X) ≫ v = v ≫ (N • 𝟙 X') := by
      intro X X' v
      rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
    set Y := I.cocomplex with hYdef
    set D := (E.mapHomologicalComplex (ComplexShape.up ℕ)).obj Y with hDdef
    have hι : ∀ k, wcTruncKerD Y N k ≫ Limits.kernel.ι (N • 𝟙 (Y.X (k + 1))) =
        Limits.kernel.ι (N • 𝟙 (Y.X k)) ≫ Y.d k (k + 1) := fun k => by
      simp [wcTruncKerD, Limits.kernel.map]
    have hιg : ∀ (g : Y ⟶ Y) k, wcSpfKerMap Y N g k ≫ Limits.kernel.ι (N • 𝟙 (Y.X k)) =
        Limits.kernel.ι (N • 𝟙 (Y.X k)) ≫ g.f k := fun g k => by
      simp [wcSpfKerMap, Limits.kernel.map]

    have hκ : Mono (wcTruncKerD Y N 0) := by
      apply Preadditive.mono_of_cancel_zero
      intro P t ht
      have h1 : (t ≫ Limits.kernel.ι (N • 𝟙 (Y.X 0))) ≫ Y.d 0 1 = 0 := by
        rw [Category.assoc, ← hι 0, ← Category.assoc, ht, Limits.zero_comp]
      have hu := I.exact₀.lift_f (t ≫ Limits.kernel.ι (N • 𝟙 (Y.X 0))) h1
      set u := I.exact₀.lift (t ≫ Limits.kernel.ι (N • 𝟙 (Y.X 0))) h1 with hudef
      have h2 : (N • u) ≫ I.ι.f 0 = 0 := by
        rw [Preadditive.nsmul_comp]
        rw [hu, ← Preadditive.comp_nsmul, hιN, Limits.comp_zero]
      have hNu : N • u = 0 := Limits.zero_of_comp_mono (I.ι.f 0) h2
      have hA' : Mono (N • 𝟙 (((CochainComplex.single₀ _).obj A).X 0)) := hA
      have hu0 : u = 0 := by
        apply Limits.zero_of_comp_mono (N • 𝟙 (((CochainComplex.single₀ _).obj A).X 0))
        rw [Preadditive.comp_nsmul, Category.comp_id]
        exact hNu
      have h3 : t ≫ Limits.kernel.ι (N • 𝟙 (Y.X 0)) = 0 := by
        rw [← hu]
        change u ≫ I.ι.f 0 = 0
        rw [hu0, Limits.zero_comp]
      exact Limits.zero_of_comp_mono _ h3

    have hK1 : N • 𝟙 (Limits.kernel (N • 𝟙 (Y.X (0 + 1)))) = 0 := by
      apply Limits.zero_of_comp_mono (Limits.kernel.ι (N • 𝟙 (Y.X (0 + 1))))
      rw [Preadditive.nsmul_comp, Category.id_comp, hιN]
    obtain ⟨ψ, hψ⟩ : ∃ ψ : Limits.kernel (N • 𝟙 (Y.X (0 + 1))) ⟶ Y.X 0,
        wcTruncKerD Y N 0 ≫ ψ = Limits.kernel.ι (N • 𝟙 (Y.X 0)) :=
      ⟨Injective.factorThru _ _, Injective.comp_factorThru _ _⟩
    have hψN : ψ ≫ (N • 𝟙 (Y.X 0)) = 0 := by
      have h : (N • 𝟙 _) ≫ ψ = 0 := by rw [hK1, Limits.zero_comp]
      rw [Preadditive.nsmul_comp, Category.id_comp] at h
      rw [Preadditive.comp_nsmul, Category.comp_id]
      exact h
    set r := Limits.kernel.lift (N • 𝟙 (Y.X 0)) ψ hψN with hrdef
    have hr : wcTruncKerD Y N 0 ≫ r = 𝟙 _ := by
      apply (cancel_mono (Limits.kernel.ι (N • 𝟙 (Y.X 0)))).1
      rw [Category.assoc, Limits.kernel.lift_ι, hψ, Category.id_comp]
    set κ₀ := wcTruncKerD Y N 0 with hκ₀def
    have hσw : κ₀ ≫ (𝟙 _ - r ≫ κ₀) = 0 := by
      rw [Preadditive.comp_sub, Category.comp_id, ← Category.assoc, hr, Category.id_comp, sub_self]
    set σ := Limits.cokernel.desc κ₀ (𝟙 _ - r ≫ κ₀) hσw with hσdef
    have hπσ : Limits.cokernel.π κ₀ ≫ σ = 𝟙 _ - r ≫ κ₀ := Limits.cokernel.π_desc _ _ _
    have hσπ : σ ≫ Limits.cokernel.π κ₀ = 𝟙 _ := by
      apply (cancel_epi (Limits.cokernel.π κ₀)).1
      rw [← Category.assoc, hπσ, Preadditive.sub_comp, Category.id_comp, Category.assoc,
        Limits.cokernel.condition, Limits.comp_zero, sub_zero, Category.comp_id]

    have hEN : ∀ X : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}, E.map (N • 𝟙 X) = N • 𝟙 (E.obj X) := fun X => by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    let e : ∀ X : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}, Limits.kernel (N • 𝟙 (E.obj X)) ≅ E.obj (Limits.kernel (N • 𝟙 X)) :=
      fun X => (Limits.kernelIsoOfEq (hEN X)).symm ≪≫ (Limits.PreservesKernel.iso E (N • 𝟙 X)).symm
    have he1 : ∀ X, (e X).hom ≫ E.map (Limits.kernel.ι (N • 𝟙 X)) =
        Limits.kernel.ι (N • 𝟙 (E.obj X)) := fun X => by
      simp only [e, Iso.trans_hom, Iso.symm_hom, Category.assoc, Limits.PreservesKernel.iso_inv_ι,
        Limits.kernelIsoOfEq_inv_comp_ι]
    have hEι : ∀ X, Mono (E.map (Limits.kernel.ι (N • 𝟙 X))) := fun X => by
      have h : E.map (Limits.kernel.ι (N • 𝟙 X)) = (e X).inv ≫ Limits.kernel.ι (N • 𝟙 (E.obj X)) := by
        rw [← he1, Iso.inv_hom_id_assoc]
      rw [h]
      infer_instance
    have he2 : ∀ (X X' : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) (w : E.obj (Limits.kernel (N • 𝟙 X)) ⟶ E.obj (Limits.kernel (N • 𝟙 X')))
        (v : E.obj X ⟶ E.obj X'),
        w ≫ E.map (Limits.kernel.ι (N • 𝟙 X')) = E.map (Limits.kernel.ι (N • 𝟙 X)) ≫ v →
        (e X).hom ≫ w = Limits.kernel.map (N • 𝟙 (E.obj X)) (N • 𝟙 (E.obj X')) v v (hvN v) ≫
          (e X').hom := by
      intro X X' w v h
      apply (cancel_mono (E.map (Limits.kernel.ι (N • 𝟙 X')))).1
      rw [Category.assoc, h, ← Category.assoc, he1, Category.assoc, he1]
      simp [Limits.kernel.map]

    have KD : ∀ k, (e (Y.X k)).hom ≫ E.map (wcTruncKerD Y N k) =
        wcTruncKerD D N k ≫ (e (Y.X (k + 1))).hom := fun k =>
      he2 _ _ _ (E.map (Y.d k (k + 1))) (by rw [← E.map_comp, ← E.map_comp, hι])
    have KG : ∀ (g : Y ⟶ Y) k, (e (Y.X k)).hom ≫ E.map (wcSpfKerMap Y N g k) =
        wcSpfKerMap D N ((E.mapHomologicalComplex (ComplexShape.up ℕ)).map g) k ≫
          (e (Y.X k)).hom := fun g k =>
      he2 _ _ _ (E.map (g.f k)) (by rw [← E.map_comp, ← E.map_comp, hιg])
    have KT : ∀ k, (e (Y.X k)).hom ≫ θ.app (Limits.kernel (N • 𝟙 (Y.X k))) =
        wcSpfKerMap D N ((NatTrans.mapHomologicalComplex θ (ComplexShape.up ℕ)).app Y) k ≫
          (e (Y.X k)).hom := fun k =>
      he2 _ _ _ (θ.app (Y.X k)) (θ.naturality _).symm

    set κD := wcTruncKerD D N 0 with hκDdef
    have h0w : κD ≫ (e (Y.X (0 + 1))).hom ≫ E.map (Limits.cokernel.π κ₀) = 0 := by
      rw [← Category.assoc, ← KD 0, Category.assoc, ← E.map_comp, Limits.cokernel.condition,
        E.map_zero, Limits.comp_zero]
    set χ₀ := Limits.cokernel.desc κD ((e (Y.X (0 + 1))).hom ≫ E.map (Limits.cokernel.π κ₀)) h0w
      with hχ₀def
    set ψ₀ := E.map σ ≫ (e (Y.X (0 + 1))).inv ≫ Limits.cokernel.π κD with hψ₀def
    have hEκ : E.map κ₀ ≫ (e (Y.X (0 + 1))).inv = (e (Y.X 0)).inv ≫ κD := by
      rw [Iso.comp_inv_eq, Category.assoc, ← KD 0, Iso.inv_hom_id_assoc]
    have hχψ : χ₀ ≫ ψ₀ = 𝟙 _ := by
      apply (cancel_epi (Limits.cokernel.π κD)).1
      rw [Limits.cokernel.π_desc_assoc, Category.comp_id, hψ₀def, Category.assoc,
        ← E.map_comp_assoc, hπσ, E.map_sub, E.map_id, E.map_comp]
      simp only [Preadditive.sub_comp, Preadditive.comp_sub, Category.id_comp, Category.assoc,
        Iso.hom_inv_id_assoc]
      rw [reassoc_of% hEκ, Limits.cokernel.condition, Limits.comp_zero, Limits.comp_zero,
        Limits.comp_zero, sub_zero]
    have hψχ : ψ₀ ≫ χ₀ = 𝟙 _ := by
      rw [hψ₀def, Category.assoc, Category.assoc, Limits.cokernel.π_desc, Iso.inv_hom_id_assoc,
        ← E.map_comp, hσπ, E.map_id]
    let c0 : Limits.cokernel κD ≅ E.obj (Limits.cokernel κ₀) := ⟨χ₀, ψ₀, hχψ, hψχ⟩

    have KD1 : (e (Y.X (0 + 1))).hom ≫ E.map (wcTruncKerD Y N 1) =
        wcTruncKerD D N 1 ≫ (e (Y.X 2)).hom := KD 1
    have hdT : ∀ k, (wcTruncKerRes Y N).d k (k + 1) = wcTruncKerDiff Y N k := fun k => by
      simp only [wcTruncKerRes, CochainComplex.of_d]
    have hdD : ∀ k, (wcTruncKerRes D N).d k (k + 1) = wcTruncKerDiff D N k := fun k => by
      simp only [wcTruncKerRes, CochainComplex.of_d]
    let c : ∀ i, (wcTruncKerRes D N).X i ≅
        ((E.mapHomologicalComplex (ComplexShape.up ℕ)).obj (wcTruncKerRes Y N)).X i :=
      fun i => match i with
        | 0 => c0
        | k + 1 => e (Y.X (k + 2))
    have sq : ∀ i j, (ComplexShape.up ℕ).Rel i j → (c i).hom ≫
        ((E.mapHomologicalComplex (ComplexShape.up ℕ)).obj (wcTruncKerRes Y N)).d i j =
        (wcTruncKerRes D N).d i j ≫ (c j).hom := by
      rintro i j (rfl : i + 1 = j)
      cases i with
      | zero =>
        show χ₀ ≫ E.map ((wcTruncKerRes Y N).d 0 (0 + 1)) =
          (wcTruncKerRes D N).d 0 (0 + 1) ≫ (e (Y.X 2)).hom
        rw [hdT 0, hdD 0]
        show χ₀ ≫ E.map (Limits.cokernel.desc κ₀ (wcTruncKerD Y N 1) _) =
          Limits.cokernel.desc κD (wcTruncKerD D N 1) _ ≫ (e (Y.X 2)).hom
        apply (cancel_epi (Limits.cokernel.π κD)).1
        rw [Limits.cokernel.π_desc_assoc, Category.assoc, ← E.map_comp, Limits.cokernel.π_desc,
          Limits.cokernel.π_desc_assoc, KD1]
      | succ k =>
        show (e (Y.X (k + 2))).hom ≫ E.map ((wcTruncKerRes Y N).d (k + 1) (k + 1 + 1)) =
          (wcTruncKerRes D N).d (k + 1) (k + 1 + 1) ≫ (e (Y.X (k + 1 + 2))).hom
        rw [hdT (k + 1), hdD (k + 1)]
        exact KD (k + 2)
    let χ := HomologicalComplex.Hom.isoOfComponents c sq
    have deg0 : ∀ (a : Limits.cokernel κD ⟶ Limits.cokernel κD)
        (b : E.obj (Limits.cokernel κ₀) ⟶ E.obj (Limits.cokernel κ₀))
        (mD : Limits.kernel (N • 𝟙 (D.X (0 + 1))) ⟶ Limits.kernel (N • 𝟙 (D.X (0 + 1))))
        (mY : E.obj (Limits.kernel (N • 𝟙 (Y.X (0 + 1)))) ⟶
          E.obj (Limits.kernel (N • 𝟙 (Y.X (0 + 1))))),
        Limits.cokernel.π κD ≫ a = mD ≫ Limits.cokernel.π κD →
        E.map (Limits.cokernel.π κ₀) ≫ b = mY ≫ E.map (Limits.cokernel.π κ₀) →
        (e (Y.X (0 + 1))).hom ≫ mY = mD ≫ (e (Y.X (0 + 1))).hom →
        χ₀ ≫ b = a ≫ χ₀ := by
      intro a b mD mY ha hb hm
      apply (cancel_epi (Limits.cokernel.π κD)).1
      rw [Limits.cokernel.π_desc_assoc, Category.assoc, hb, reassoc_of% hm, reassoc_of% ha,
        Limits.cokernel.π_desc]
    refine ⟨χ, ?_, ?_⟩
    · intro g
      apply HomologicalComplex.hom_ext
      intro i
      rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f]
      cases i with
      | zero =>
        refine deg0 _ _ (wcSpfKerMap D N ((E.mapHomologicalComplex (ComplexShape.up ℕ)).map g) 1)
          (E.map (wcSpfKerMap Y N g 1)) ?_ ?_ (KG g 1)
        · show Limits.cokernel.π κD ≫ wcSpfTruncMapF D N _ 0 = _
          simp only [wcSpfTruncMapF]
          exact Limits.cokernel.π_desc _ _ _
        · have h : Limits.cokernel.π κ₀ ≫ wcSpfTruncMapF Y N g 0 =
              wcSpfKerMap Y N g 1 ≫ Limits.cokernel.π κ₀ := by
            simp only [wcSpfTruncMapF]
            exact Limits.cokernel.π_desc _ _ _
          exact (E.map_comp _ _).symm.trans ((congrArg E.map h).trans (E.map_comp _ _))
      | succ k =>
        show (e (Y.X (k + 2))).hom ≫ E.map (wcSpfKerMap Y N g (k + 2)) =
          wcSpfKerMap D N ((E.mapHomologicalComplex (ComplexShape.up ℕ)).map g) (k + 2) ≫
            (e (Y.X (k + 2))).hom
        exact KG g (k + 2)
    · apply HomologicalComplex.hom_ext
      intro i
      rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f]
      cases i with
      | zero =>
        refine deg0 _ _
          (wcSpfKerMap D N ((NatTrans.mapHomologicalComplex θ (ComplexShape.up ℕ)).app Y) 1)
          (θ.app (Limits.kernel (N • 𝟙 (Y.X 1)))) ?_ ?_ (KT 1)
        · show Limits.cokernel.π κD ≫ wcSpfTruncMapF D N _ 0 = _
          simp only [wcSpfTruncMapF]
          exact Limits.cokernel.π_desc _ _ _
        · exact θ.naturality (Limits.cokernel.π κ₀)
      | succ k =>
        show (e (Y.X (k + 2))).hom ≫ θ.app (Limits.kernel (N • 𝟙 (Y.X (k + 2)))) =
          wcSpfKerMap D N ((NatTrans.mapHomologicalComplex θ (ComplexShape.up ℕ)).app Y) (k + 2) ≫
            (e (Y.X (k + 2))).hom
        exact KT (k + 2)

  exact gen (preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP))))
    (preadditiveCoyoneda.map
      (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)).op) I hC

theorem wcU_spf_model_side (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ] [Fintype Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α)
    (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (n : ℕ) (hn : 1 ≤ n) (r : ℕ) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n)))
    (lamF : MonoidAlgebra ℤ_[ℓ] Γ → (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶ wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (hlamF : wcRingAct lamF)
    (hlamFs : ∀ (g : Γ) (a : ℤ_[ℓ]), lamF (MonoidAlgebra.single g a) =
      wcCoverScal (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ a ≫
        wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
          (α g⁻¹).hom (hα g⁻¹))
    (I : InjectiveResolution (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (lamI : MonoidAlgebra ℤ_[ℓ] Γ → (I.cocomplex ⟶ I.cocomplex))
    (hI : wcRingResSpec lamF I lamI)
