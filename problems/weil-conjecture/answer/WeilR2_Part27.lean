      (Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J))) W hWqc hWs ℓ n k θr c hc
      htr q α hG hα fr hfr htrans ρ hρ
    obtain ⟨hinj, hls⟩ := wc_h2r_level_map_offS_props (wcP1Over K).left
