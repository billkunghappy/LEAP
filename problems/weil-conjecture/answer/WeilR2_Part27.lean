        e'.injective (by rw [he', AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
      let LA : (Fin r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) :=
        { toFun := fun v => e' (wcCohGFrob K (wcP1Over K) hP G i (e'.symm v))
          map_add' := fun v w => by simp only [map_add]
          map_smul' := fun c v => by simp only [hes, hΦG, he', RingHom.id_apply] }
      have hA : wcAddEquivMatrix e' (wcCohGFrob K (wcP1Over K) hP G i) =
          LinearMap.toMatrix' LA := by
        ext a b
        rw [LinearMap.toMatrix'_apply]
        rfl
      have hmat : ∀ (k : ℕ) (y : wcCohG K (wcP1Over K) hP G i),
          e' ((⇑(wcCohGFrob K (wcP1Over K) hP G i))^[k] y) =
            ((wcAddEquivMatrix e' (wcCohGFrob K (wcP1Over K) hP G i)) ^ k).mulVec (e' y) := by
        intro k
        induction k with
        | zero => intro y; simp
        | succ k ih =>
          intro y
          rw [pow_succ', ← Matrix.mulVec_mulVec, ← ih, hA, LinearMap.toMatrix'_mulVec]
          show e' ((⇑(wcCohGFrob K (wcP1Over K) hP G i))^[k+1] y) =
            e' (wcCohGFrob K (wcP1Over K) hP G i
              (e'.symm (e' ((⇑(wcCohGFrob K (wcP1Over K) hP G i))^[k] y))))
          rw [AddEquiv.symm_apply_apply, Function.iterate_succ_apply']
      let ιs : wcCohG K (wcP1Over K) hP L i →+ wcCohG K (wcP1Over K) hP G i :=
        (Abelian.Ext.mk₀ ι).postcomp _ (add_zero i)
      have hsemi : ∀ x, ιs (wcCohGFrob K (wcP1Over K) hP L i x) =
          wcCohGFrob K (wcP1Over K) hP G i (ιs x) := by
        intro x
        show ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left
            (wcGeomFrob K (wcP1Over K) hP))).comp x (zero_add i)).comp
            (Abelian.Ext.mk₀ ι) (add_zero i) =
          (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left
            (wcGeomFrob K (wcP1Over K) hP))).comp
            (x.comp (Abelian.Ext.mk₀ ι) (add_zero i)) (zero_add i)
        exact Abelian.Ext.comp_assoc _ _ _ (zero_add i) (add_zero i) (by omega)
      have hsemik : ∀ (k : ℕ) x, ιs ((⇑(wcCohGFrob K (wcP1Over K) hP L i))^[k] x) =
          (⇑(wcCohGFrob K (wcP1Over K) hP G i))^[k] (ιs x) := by
        intro k
        induction k with
        | zero => intro x; rfl
        | succ k ih =>
          intro x
          rw [Function.iterate_succ_apply', Function.iterate_succ_apply', hsemi, ih]
      have hlamcomp : ∀ (x : wcCohG K (wcP1Over K) hP L i) (a : ℤ_[ℓ]),
          ιs (x.comp (Abelian.Ext.mk₀ (lam a)) (add_zero i)) =
            wcCohGEnd K (wcP1Over K) hP G i (σ (a : ℚ_[ℓ])) (ιs x) := by
        intro x a
        show (x.comp (Abelian.Ext.mk₀ (lam a)) (add_zero i)).comp (Abelian.Ext.mk₀ ι)
            (add_zero i) =
          (x.comp (Abelian.Ext.mk₀ ι) (add_zero i)).comp (Abelian.Ext.mk₀ (σ (a : ℚ_[ℓ])))
            (add_zero i)
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
          Abelian.Ext.comp_assoc _ _ _ (add_zero i) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hlι]
      obtain ⟨κ, hκ⟩ := c5 i
      let j : (wcGModelAb M).homology i →+ (Fin r' → ℚ_[ℓ]) :=
        (e'.toAddMonoidHom.comp ιs).comp κ.toAddMonoidHom
      have hj : ∀ x, j x = e' (ιs (κ x)) := fun x => rfl
      have jRC1 : ∀ x, j x = 0 ↔ ∃ k : ℕ, (ℓ ^ k : ℕ) • x = 0 := by
        intro x
        constructor
        · intro hx
          rw [hj] at hx
          have h1 : ιs (κ x) = 0 := e'.injective (hx.trans (map_zero e').symm)
          obtain ⟨k, hk⟩ := hker i (κ x) h1
          exact ⟨k, κ.injective (by rw [map_nsmul, hk, map_zero])⟩
        · rintro ⟨k, hk⟩
          have h1 : (ℓ ^ k : ℕ) • j x = 0 := by rw [← map_nsmul, hk, map_zero]
          rw [← Nat.cast_smul_eq_nsmul ℚ_[ℓ], Nat.cast_pow] at h1
          exact (smul_eq_zero.mp h1).resolve_left (pow_ne_zero k hp)
      have jRC2 : ∀ v : Fin r' → ℚ_[ℓ], ∃ (k : ℕ) (x : (wcGModelAb M).homology i),
          ((ℓ : ℚ_[ℓ]) ^ k) • v = j x := by
        intro v
        obtain ⟨k, x, hx⟩ := hrat i (e'.symm v)
        refine ⟨k, κ.symm x, ?_⟩
        rw [hj, AddEquiv.apply_symm_apply]
        change ((ℓ : ℚ_[ℓ]) ^ k) • v = e' (x.comp (Abelian.Ext.mk₀ ι) (add_zero i))
        rw [← hx, map_nsmul, AddEquiv.apply_symm_apply, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ],
          Nat.cast_pow]
      have jRC3 : ∀ (x : (wcGModelAb M).homology i) (a : ℤ_[ℓ]),
          ∃ y, j y = (a : ℚ_[ℓ]) • j x := by
        intro x a
        refine ⟨κ.symm ((κ x).comp (Abelian.Ext.mk₀ (lam a)) (add_zero i)), ?_⟩
        rw [hj, hj, AddEquiv.apply_symm_apply, hlamcomp, he']
      have jT : ∀ x, j ((HomologicalComplex.homologyMap (wcCxIter (wcGModelFrob M) e) i).hom x) =
          ((wcAddEquivMatrix e' (wcCohGFrob K (wcP1Over K) hP G i)) ^ e).mulVec (j x) := by
        intro x
        rw [hj, hj, hκ, hsemik, hmat]
      have hInti := hInt i hi
      rw [hAct, Category.id_comp] at hInti
      exact c1 (ιh i) j (hRC i hi) jRC1 jRC2 jRC3 _ (Ah i) _ hInti jT
    obtain ⟨κ₀, -⟩ := c5 0
    have htor0 : ∀ x : (wcGModelAb M).homology 0, ∃ k : ℕ, (ℓ ^ k : ℕ) • x = 0 := by
      intro x
      refine ⟨0, ?_⟩
      have hx : x = 0 := κ₀.injective ((hL0 _).trans (map_zero κ₀).symm)
      rw [hx, smul_zero]
    have htr0 : (Ah 0).trace = 0 := c2 (ιh 0) (hRC 0 (by norm_num)) htor0 (Ah 0)
    have htr1 := deg 1 (by norm_num) r₁ e₁ he₁
    have htr2 := deg 2 (by norm_num) r₂ e₂ he₂
    rw [← hHT, hTr]
    simp only [Finset.sum_range_succ, Finset.sum_range_zero, htr0, ← htr1, ← htr2]
    ring
  exact main _ J.arrow inferInstance τ hτ kerJ ratJ Ψ hΨ hΨF

theorem wc_h2st_bounded_denominators (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (σ : ℚ_[ℓ] → (G ⟶ G))
    (W : S.ProEt) (hWqc : QuasiCompact W.hom) (k : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫ θ.hom =
      θ.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
        (wcConstScalar S ℓ k c))
    (Pm : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])) (J : Subobject G)
    (hJ : ∀ (V : S.ProEt) (s : G.obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : S.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖Pm ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1)
    (V : S.ProEt) (hV : CompactSpace V.left) :
    ∀ s : G.obj.obj (Opposite.op V), ∃ (N : ℕ) (t : (Subobject.underlying.obj J).obj.obj (Opposite.op V)),
      (J.arrow.hom.app (Opposite.op V)).hom t = ((σ ((ℓ : ℚ_[ℓ]) ^ N)).hom.app (Opposite.op V)).hom s :=
by
  classical
  intro s

  have hVe : WeaklyEtale V.hom := V.prop
  have hWe : WeaklyEtale W.hom := W.prop
  have hWq : QuasiCompact W.hom := hWqc
  have hfq : QuasiCompact (Limits.pullback.fst V.hom W.hom) := by infer_instance
  let T : S.ProEt := Scheme.ProEt.mk (Limits.pullback.fst V.hom W.hom ≫ V.hom)
  let a : T ⟶ V := MorphismProperty.Over.homMk (Limits.pullback.fst V.hom W.hom) rfl trivial
  let b' : T ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd V.hom W.hom)
    Limits.pullback.condition.symm trivial
  have hT : CompactSpace T.left :=
    @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.fst V.hom W.hom) hfq hV
  have huniv : ∀ (V' : S.ProEt) (c : V' ⟶ V) (b : V' ⟶ W),
      ∃ u : V' ⟶ T, u ≫ a = c ∧ u ≫ b' = b := by
    intro V' c b
    have h : c.left ≫ V.hom = b.left ≫ W.hom :=
      (MorphismProperty.Over.w c).trans (MorphismProperty.Over.w b).symm
    refine ⟨MorphismProperty.Over.homMk (Limits.pullback.lift c.left b.left h)
      ((Limits.pullback.lift_fst_assoc _ _ h _).trans (MorphismProperty.Over.w c)) trivial, ?_, ?_⟩
    · apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.lift_fst _ _ h
    · apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.lift_snd _ _ h

  have hres : ∀ (V' : S.ProEt) (u : V' ⟶ T) (c : V' ⟶ V) (b : V' ⟶ W), u ≫ a = c → u ≫ b' = b →
      ∀ (x : G.obj.obj (Opposite.op V)) (z : V'.left),
      (show C(↥V'.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom x)).down) z =
      (show C(↥T.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b'))).hom ((G.obj.map a.op).hom x)).down) (u.left z) := by
    intro V' u c b hc hb x z
    subst hc hb
    have hnat := congrArg (fun f => AddCommGrpCat.Hom.hom f ((G.obj.map a.op).hom x))
      (θ.hom.hom.naturality (Over.homMk u rfl : Over.mk (u ≫ b') ⟶ Over.mk b').op)
    have e : (G.obj.map (u ≫ a).op).hom x = (G.obj.map u.op).hom ((G.obj.map a.op).hom x) := by
      rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply]
    rw [e]
    exact congrArg (fun y => (show C(↥V'.left, Fin k → ℚ_[ℓ]) from ULift.down y) z) hnat

  have key : ∀ f₀ : C(↥T.left, Fin k → ℚ_[ℓ]), ∃ N : ℕ, ∀ (z : T.left) (i : Fin k),
      ‖(ℓ : ℚ_[ℓ]) ^ N * Pm (f₀ z) i‖ ≤ 1 := by
    intro f₀
    have hg : Continuous (fun z => Pm (f₀ z)) :=
      (LinearMap.continuous_of_finiteDimensional
        (Pm : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))).comp f₀.continuous
    obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn hg.continuousOn
    have hl1 : (1 : ℝ) < ℓ := Nat.one_lt_cast.mpr (Fact.out : ℓ.Prime).one_lt
    obtain ⟨N, hN⟩ := pow_unbounded_of_one_lt C hl1
    refine ⟨N, fun z i => ?_⟩
    rw [norm_mul, norm_pow, Padic.norm_p, inv_pow]
    have h1 : ‖Pm (f₀ z) i‖ ≤ C := (norm_le_pi_norm _ i).trans (hC z (Set.mem_univ _))
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ N := by positivity
    calc ((ℓ : ℝ) ^ N)⁻¹ * ‖Pm (f₀ z) i‖ ≤ ((ℓ : ℝ) ^ N)⁻¹ * (ℓ : ℝ) ^ N :=
          mul_le_mul_of_nonneg_left (h1.trans hN.le) (by positivity)
      _ = 1 := inv_mul_cancel₀ hpos.ne'

  have hframe : ∀ (c : ℚ_[ℓ]) (V : S.ProEt) (b : V ⟶ W)
      (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
            (((σ c).hom.app (Opposite.op V)).hom x)).down) z =
        c • (show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z := by
    intro c V b x z
    have h : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          (((σ c).hom.app (Opposite.op V)).hom x) =
        ((wcConstScalar S ℓ k c).hom.app (Opposite.op V)).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x) :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk b))).hom x) (hθ c)
    rw [h]
    rfl

  obtain ⟨N, hN⟩ := key (show C(↥T.left, Fin k → ℚ_[ℓ]) from
    ((θ.hom.hom.app (Opposite.op (Over.mk b'))).hom ((G.obj.map a.op).hom s)).down)
  obtain ⟨t, ht⟩ := (hJ V (((σ ((ℓ : ℚ_[ℓ]) ^ N)).hom.app (Opposite.op V)).hom s)).mpr (by
    intro V' c b z i
    obtain ⟨u, hc, hb⟩ := huniv V' c b
    have hnat : (G.obj.map c.op).hom (((σ ((ℓ : ℚ_[ℓ]) ^ N)).hom.app (Opposite.op V)).hom s) =
        ((σ ((ℓ : ℚ_[ℓ]) ^ N)).hom.app (Opposite.op V')).hom ((G.obj.map c.op).hom s) :=
      (NatTrans.naturality_apply (σ ((ℓ : ℚ_[ℓ]) ^ N)).hom c.op _).symm
    rw [hnat, hframe, LinearEquiv.map_smul, Pi.smul_apply, smul_eq_mul, hres V' u c b hc hb s z]
    exact hN (u.left z) i)
  exact ⟨N, t, ht⟩

theorem wc_h2r_stalk_traces (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP) (k : ℕ)
    (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (Pm : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])) (J : Subobject G)
    (hF : wcH2Frame K hP ℓ m S G σ W w k θ Pm J)
    (e : ℕ) (he : 1 ≤ e)
    (r : ℕ) (V : ℕ → Scheme.{u}) (q' : (n : ℕ) → V n ⟶ Uo.toScheme) (Γ : ℕ → Type u)
    [∀ n, Group (Γ n)] (α : (n : ℕ) → Γ n →* Aut (V n))
    (ρ : (n : ℕ) → Γ n →* GL (Fin r) (ZMod (ℓ ^ n)))
    (hCOV : ∀ n, 1 ≤ n → wcGalCover (q' n) (Γ n) (α n))
    (hLk : wcH2LinkR K ℓ m S G J Uo r V q' Γ α ρ) :
    (∀ d : ℕ, ∀ x ∈ wcOffS K m S d, ∀ b : wcStalkBasis K ℓ G σ x d, ∀ k : ℕ,
        ∃ T : ℤ_[ℓ], (T : ℚ_[ℓ]) = (wcStalkMat b ^ k).trace) ∧
      (∀ n, 1 ≤ n → ∀ d ∈ e.divisors, ∀ x ∈ wcOffS K m S d, ∀ b : wcStalkBasis K ℓ G σ x d,
        ∀ (v : Spec (.of (AlgebraicClosure K)) ⟶ V n) (g : Γ n),
          v ≫ q' n ≫ Uo.ι ≫ (wcP1Over K).hom = wcKbarPt K →
          (v ≫ q' n ≫ Uo.ι) (IsLocalRing.closedPoint (AlgebraicClosure K)) = x →
          wcFrE K e ≫ v ≫ (α n g).hom = v →
          ∀ T : ℤ_[ℓ], (T : ℚ_[ℓ]) = (wcStalkMat b ^ (e / d)).trace →
            PadicInt.toZModPow n T = ((ρ n g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))).trace) :=
by
  classical
  obtain ⟨hqc, hconn, hoff, hsurj, hθ, hint, hJ⟩ := hF
  obtain ⟨hα, hmu⟩ := hLk
  obtain ⟨τ, hτ⟩ := wc_lcfa_lattice_int_stable K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero W w
    hqc hconn hoff hsurj k θ hθ Pm hint J hJ
  obtain ⟨ev, hevpost, hevpre⟩ := wc_free_ext0_eval (wcP1Over K).left

  have hinj : ∀ X : ((wcP1Over K).left.ProEt)ᵒᵖ,
      Function.Injective (J.arrow.hom.app X).hom := by
    intro X
    exact (AddCommGrpCat.mono_iff_injective _).mp
      (Functor.map_mono (sheafToPresheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1} ⋙ (evaluation _ AddCommGrpCat.{u+1}).obj X) J.arrow)
  have hτ1 : τ 1 = 𝟙 _ := by
    apply (cancel_mono J.arrow).mp
    rw [hτ, PadicInt.coe_one, hσ1, Category.comp_id, Category.id_comp]
  have hτadd : ∀ a c : ℤ_[ℓ], τ (a + c) = τ a + τ c := by
    intro a c
    apply (cancel_mono J.arrow).mp
    rw [hτ, Preadditive.add_comp, hτ, hτ, PadicInt.coe_add, hσadd, Preadditive.comp_add]
  have hτmul : ∀ a c : ℤ_[ℓ], τ (a * c) = τ c ≫ τ a := by
    intro a c
    apply (cancel_mono J.arrow).mp
    rw [hτ, Category.assoc, hτ, ← Category.assoc, hτ, Category.assoc, PadicInt.coe_mul, hσmul]
  have hσ0 : σ 0 = 0 := by
    have h := hσadd 0 0
    rw [add_zero] at h
    calc σ 0 = (σ 0 + σ 0) - σ 0 := by abel
      _ = σ 0 - σ 0 := by rw [← h]
      _ = 0 := sub_self _
  have hσnat : ∀ n : ℕ, σ (n : ℚ_[ℓ]) = n • 𝟙 G := by
    intro n
    induction n with
    | zero => rw [Nat.cast_zero, hσ0, zero_smul]
    | succ n ih => rw [Nat.cast_succ, hσadd, ih, hσ1, succ_nsmul]
  have hiτ : ∀ n : ℕ, ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J)) = τ ((ℓ : ℤ_[ℓ]) ^ n) := by
    intro n
    apply (cancel_mono J.arrow).mp
    rw [hτ, Preadditive.nsmul_comp, Category.id_comp, PadicInt.coe_pow, PadicInt.coe_natCast,
      ← Nat.cast_pow, hσnat, Preadditive.comp_nsmul, Category.comp_id]
  have himono : ∀ n : ℕ, Mono ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J)) := by
    intro n
    have hc : ((ℓ ^ n : ℕ) : ℚ_[ℓ]) ≠ 0 := by
      exact_mod_cast (pow_ne_zero n (Fact.out : ℓ.Prime).ne_zero)
    haveI : IsSplitMono (σ ((ℓ ^ n : ℕ) : ℚ_[ℓ])) :=
      IsSplitMono.mk' ⟨σ (((ℓ ^ n : ℕ) : ℚ_[ℓ]))⁻¹, by rw [← hσmul, inv_mul_cancel₀ hc, hσ1]⟩
    have h : ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J)) ≫ J.arrow =
        J.arrow ≫ σ ((ℓ ^ n : ℕ) : ℚ_[ℓ]) := by
      rw [hσnat, Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
    haveI : Mono (((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J)) ≫ J.arrow) := by
      rw [h]; infer_instance
    exact mono_of_mono _ J.arrow
  have hWqc : QuasiCompact W.hom := by
    rw [← MorphismProperty.Over.w w]
    haveI := hqc
    haveI : QuasiCompact (wcGeomPoint K (wcP1Over K) hP).hom := by
      show QuasiCompact (Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      infer_instance
    infer_instance
  have hframe : ∀ (c : ℚ_[ℓ]) (V' : (wcP1Over K).left.ProEt) (b : V' ⟶ W)
      (x : G.obj.obj (Opposite.op V')) (z : V'.left),
      (show C(↥V'.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
