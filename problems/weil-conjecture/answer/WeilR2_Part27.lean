theorem wc_latticeU_stalk_traces (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G) (hlisse : wcLisseOffS K hP ℓ m S G σ)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    (e : ℕ) (he : 1 ≤ e)
    (r : ℕ) (V : ℕ → Scheme.{u}) (q' : (n : ℕ) → V n ⟶ Uo.toScheme) (Γ : ℕ → Type u)
    [∀ n, Group (Γ n)] (α : (n : ℕ) → Γ n →* Aut (V n))
    (ρ : (n : ℕ) → Γ n →* GL (Fin r) (ZMod (ℓ ^ n)))
    (hCOV : ∀ n, 1 ≤ n → wcGalCover (q' n) (Γ n) (α n))
    (hLT : wcLatticeTowerU K hP ℓ m S G σ Uo r V q' Γ α ρ) :
    (∀ d : ℕ, ∀ x ∈ wcOffS K m S d, ∀ b : wcStalkBasis K ℓ G σ x d, ∀ k : ℕ,
        ∃ T : ℤ_[ℓ], (T : ℚ_[ℓ]) = (wcStalkMat b ^ k).trace) ∧
      (∀ n, 1 ≤ n → ∀ d ∈ e.divisors, ∀ x ∈ wcOffS K m S d, ∀ b : wcStalkBasis K ℓ G σ x d,
        ∀ (v : Spec (.of (AlgebraicClosure K)) ⟶ V n) (g : Γ n),
          v ≫ q' n ≫ Uo.ι ≫ (wcP1Over K).hom = wcKbarPt K →
          (v ≫ q' n ≫ Uo.ι) (IsLocalRing.closedPoint (AlgebraicClosure K)) = x →
          wcFrE K e ≫ v ≫ (α n g).hom = v →
          ∀ T : ℤ_[ℓ], (T : ℚ_[ℓ]) = (wcStalkMat b ^ (e / d)).trace →
            PadicInt.toZModPow n T = ((ρ n g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))).trace) :=
by
  classical
  obtain ⟨hα, L, ι, lam, π, τ, ⟨⟨hl1, hladd, hlmul, hlι⟩, hmono, hden, hses, hsep, -, -⟩, -⟩ :=
    hLT
  obtain ⟨ev, hevpost, hevpre⟩ := wc_free_ext0_eval (wcP1Over K).left
  have main : ∀ d : ℕ, ∀ x ∈ wcOffS K m S d, ∀ b : wcStalkBasis K ℓ G σ x d,
      ∃ B : Matrix (Fin r) (Fin r) ℤ_[ℓ],
        (∀ k : ℕ, (wcStalkMat b ^ k).trace = (((B ^ k).trace : ℤ_[ℓ]) : ℚ_[ℓ])) ∧
        ∀ n : ℕ, 1 ≤ n → ∀ (k : ℕ) (Rm : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))
          (θ : (wcTwSh (q' n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
            (Γ n) (α n) (hα n) ℓ n r (ρ n)).obj.obj (Opposite.op b.N.V) ≃+ (Fin r → ZMod (ℓ ^ n))),
          (∀ s, θ ((⇑((wcTwSh (q' n ≫ Uo.ι)
            (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
            (Γ n) (α n) (hα n) ℓ n r (ρ n)).obj.map b.N.φ.op).hom)^[k] s) =
              Matrix.vecMul (θ s) Rm) →
          PadicInt.toZModPow n (B ^ k).trace = Rm.trace := by
    intro d x hx b
    letI := b.N.ringA
    haveI := b.N.hensA
    haveI := b.N.sepA
    haveI hproj : Projective (wcFreeSheaf (wcP1Over K).left b.N.V) :=
      wc_proet_free_projective_strict_local _ b.N.V b.N.A b.N.e

    have hNU : ∀ t : b.N.V.left,
        b.N.V.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)) := by
      intro t
      have h1 : b.N.e.hom t ⤳ IsLocalRing.closedPoint b.N.A :=
        IsLocalRing.specializes_closedPoint (R := b.N.A) (b.N.e.hom t)
      have h2 : b.N.e.inv (b.N.e.hom t) ⤳ b.N.e.inv (IsLocalRing.closedPoint b.N.A) :=
        h1.map (Scheme.Hom.continuous b.N.e.inv)
      rw [Scheme.hom_inv_apply] at h2
      have h3 : b.N.V.hom t ⤳ x := by
        have := h2.map (Scheme.Hom.continuous b.N.V.hom)
        rwa [b.N.hx] at this
      have hxU : x ∈ Uo := (hUo x).mpr hx.2.2
      have htU : b.N.V.hom t ∈ Uo := h3.mem_open Uo.isOpen hxU
      rintro ⟨i, hi⟩
      exact (hUo _).mp htU i hi.symm

    let act : ℤ_[ℓ] → (L.obj.obj (Opposite.op b.N.V) →+ L.obj.obj (Opposite.op b.N.V)) :=
      fun a => ((lam a).hom.app (Opposite.op b.N.V)).hom
    have h1 : act 1 = AddMonoidHom.id _ := by
      ext y
      show ((lam 1).hom.app (Opposite.op b.N.V)).hom y = y
      rw [hl1]
      rfl
    have hadd : ∀ a c : ℤ_[ℓ], act (a + c) = act a + act c := by
      intro a c
      ext y
      show ((lam (a + c)).hom.app (Opposite.op b.N.V)).hom y = _
      rw [hladd]
      rfl
    have hmul : ∀ (a c : ℤ_[ℓ]) (y : L.obj.obj (Opposite.op b.N.V)),
        act (a * c) y = act a (act c y) := by
      intro a c y
      show ((lam (a * c)).hom.app (Opposite.op b.N.V)).hom y = _
      rw [hlmul]
      rfl

    have hsec : ∀ n : ℕ, 1 ≤ n →
        Function.Surjective ((π n).hom.app (Opposite.op b.N.V)).hom ∧
        ∀ y, ((π n).hom.app (Opposite.op b.N.V)).hom y = 0 ↔
          ∃ z, act ((ℓ : ℤ_[ℓ]) ^ n) z = y := by
      intro n hn
      obtain ⟨w, hSE⟩ := hses n hn
      haveI := hSE.mono_f
      haveI := hSE.epi_g
      refine ⟨?_, ?_⟩
      · intro c
        set y := (ev b.N.V _).symm c with hy
        set γ := Abelian.Ext.homEquiv₀ y with hγ
        refine ⟨ev b.N.V L (Abelian.Ext.mk₀ (Projective.factorThru γ (π n))), ?_⟩
        rw [← hevpost]
        have h2 : (Abelian.Ext.mk₀ (π n)).postcomp (wcFreeSheaf (wcP1Over K).left b.N.V)
            (add_zero 0) (Abelian.Ext.mk₀ (Projective.factorThru γ (π n))) = y := by
          show (Abelian.Ext.mk₀ (Projective.factorThru γ (π n))).comp (Abelian.Ext.mk₀ (π n))
            (add_zero 0) = y
          rw [Abelian.Ext.mk₀_comp_mk₀, Projective.factorThru_comp, hγ,
            ← Abelian.Ext.homEquiv₀_symm_apply, Equiv.symm_apply_apply]
        rw [h2, hy, AddEquiv.apply_symm_apply]
      · intro y
        constructor
        · intro hy0
          have hE := hSE.exact.map_of_mono_of_preservesKernel
            (sheafToPresheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1} ⋙
              (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op b.N.V))
            hSE.mono_f inferInstance
          obtain ⟨z, hz⟩ := (ShortComplex.ab_exact_iff _).mp hE y hy0
          exact ⟨z, hz⟩
        · rintro ⟨z, rfl⟩
          exact congrArg (fun f => (f.hom.app (Opposite.op b.N.V)).hom z) w

    obtain ⟨β, hβ⟩ := wc_padic_lattice_free_of_reductions ℓ act h1 hadd hmul r
      (by
        intro n hn
        obtain ⟨θn⟩ := wc_twsh_sections_strict_local_free K m S hS Uo hUo (q' n) (Γ n) (α n)
          (hCOV n hn) (hα n) ℓ n r (ρ n) hn d x hx b.N
        obtain ⟨hsurj, hker⟩ := hsec n hn
        refine ⟨θn.toAddMonoidHom.comp ((π n).hom.app (Opposite.op b.N.V)).hom,
          θn.surjective.comp hsurj, ?_⟩
        intro y
        rw [← hker y]
        simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom]
        exact θn.map_eq_zero_iff)
      (fun y hy => hsep b.N.V y (fun n => by
        obtain ⟨z, hz⟩ := hy n
        exact ⟨z, hz⟩))

    let F : L.obj.obj (Opposite.op b.N.V) →+ L.obj.obj (Opposite.op b.N.V) :=
      (L.obj.map b.N.φ.op).hom
    have hF : ∀ (a : ℤ_[ℓ]) (y : L.obj.obj (Opposite.op b.N.V)), F (act a y) = act a (F y) :=
      fun a y => (congrArg (fun f => f.hom y) ((lam a).hom.naturality b.N.φ.op)).symm

    let j : L.obj.obj (Opposite.op b.N.V) →+
        Abelian.Ext (wcFreeSheaf (wcP1Over K).left b.N.V) G 0 :=
      (ev b.N.V G).symm.toAddMonoidHom.comp (ι.hom.app (Opposite.op b.N.V)).hom
    have hιinj : Function.Injective (ι.hom.app (Opposite.op b.N.V)).hom :=
      (AddCommGrpCat.mono_iff_injective (ι.hom.app (Opposite.op b.N.V))).mp
        (Functor.map_mono (sheafToPresheaf (Scheme.ProEt.topology (wcP1Over K).left)
          AddCommGrpCat.{u+1} ⋙ (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op b.N.V)) ι)
    have hj : Function.Injective j := (ev b.N.V G).symm.injective.comp hιinj
    have hjev : ∀ y, ev b.N.V G (j y) = (ι.hom.app (Opposite.op b.N.V)).hom y := fun y =>
      AddEquiv.apply_symm_apply _ _
    have hjs : ∀ (a : ℤ_[ℓ]) (y : L.obj.obj (Opposite.op b.N.V)),
        j (act a y) = (Abelian.Ext.mk₀ (σ (a : ℚ_[ℓ]))).postcomp
          (wcFreeSheaf (wcP1Over K).left b.N.V) (add_zero 0) (j y) := by
      intro a y
      apply (ev b.N.V G).injective
      rw [hevpost, hjev, hjev]
      exact congrArg (fun f => (f.hom.app (Opposite.op b.N.V)).hom y) (hlι a)
    have hcpt : CompactSpace b.N.V.left :=
      (Scheme.Hom.homeomorph b.N.e.inv).compactSpace
    have hden' : ∀ w : Abelian.Ext (wcFreeSheaf (wcP1Over K).left b.N.V) G 0,
        ∃ (k : ℕ) (y : L.obj.obj (Opposite.op b.N.V)),
          j y = (Abelian.Ext.mk₀ (σ ((ℓ : ℚ_[ℓ]) ^ k))).postcomp
            (wcFreeSheaf (wcP1Over K).left b.N.V) (add_zero 0) w := by
      intro w
      obtain ⟨k, y, hy⟩ := hden b.N.V hcpt hNU (ev b.N.V G w)
      refine ⟨k, y, ?_⟩
      apply (ev b.N.V G).injective
      rw [hevpost, hjev]
      exact hy
    have hΦ : ∀ y : L.obj.obj (Opposite.op b.N.V),
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left b.N.φ)).precomp G (zero_add 0) (j y) =
          j (F y) := by
      intro y
      apply (ev b.N.V G).injective
      rw [hevpre, hjev, hjev]
      exact (congrArg (fun f => f.hom y) (ι.hom.naturality b.N.φ.op)).symm
    have hrat := wc_lattice_rational_trace_eq ℓ act r b.r β hβ F hF b.e
      (fun c => (Abelian.Ext.mk₀ (σ c)).postcomp (wcFreeSheaf (wcP1Over K).left b.N.V)
        (add_zero 0)) b.he j hj hjs hden'
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left b.N.φ)).precomp G (zero_add 0)) hΦ
    refine ⟨wcAddEquivMatrix β F, fun k => hrat k, ?_⟩
    intro n hn k Rm θ hθ
    obtain ⟨hsurj, hker⟩ := hsec n hn
