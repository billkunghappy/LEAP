import WeilR2_Part26
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_ltl_chart_sieve (K : Type u) [Field K] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (T : (wcP1Over K).left.ProEt) :
    ∃ R : Sieve T, R ∈ Scheme.ProEt.topology (wcP1Over K).left T ∧
      ∀ (T' : (wcP1Over K).left.ProEt) (h : T' ⟶ T), R.arrows h →
        ∃ (T₀ : (wcP1Over K).left.ProEt) (k : T' ⟶ T₀) (h₀ : T₀ ⟶ T) (B : Type u)
          (_ : CommRing B) (e : T₀.left ≅ Spec (.of B)) (g : B), h = k ≫ h₀ ∧
          ∀ y : T₀.left, T₀.hom y ∈ Set.range (fun i => S i (IsLocalRing.closedPoint K)) ↔
            g ∈ (e.hom y).asIdeal :=
by
  classical

  have hZc : IsClosed (Set.range (fun i => S i (IsLocalRing.closedPoint K))) := by
    have h := (wc_P1_sections_closed_generize K m S hS).1
    convert h using 1
    ext p
    simp only [Set.mem_range, Set.mem_setOf_eq]
    exact ⟨fun ⟨i, hi⟩ => ⟨i, hi.symm⟩, fun ⟨i, hi⟩ => ⟨i, hi.symm⟩⟩

  have hpid : ∀ C : Set (PrimeSpectrum (Polynomial K)), IsClosed C →
      ∃ f : Polynomial K, ∀ y : PrimeSpectrum (Polynomial K), y ∈ C ↔ f ∈ y.asIdeal := by
    intro C hC
    refine ⟨Submodule.IsPrincipal.generator (PrimeSpectrum.vanishingIdeal C), fun y => ?_⟩
    have h1 := Ideal.span_singleton_generator (PrimeSpectrum.vanishingIdeal C)
    have hcl : PrimeSpectrum.zeroLocus
        (PrimeSpectrum.vanishingIdeal C : Set (Polynomial K)) = C := by
      rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hC.closure_eq]
    have hy : y ∈ C ↔ (PrimeSpectrum.vanishingIdeal C : Set (Polynomial K)) ⊆ y.asIdeal := by
      rw [← PrimeSpectrum.mem_zeroLocus, hcl]
    rw [hy, ← Ideal.span_singleton_le_iff_mem, h1]
    exact Iff.rfl

  have hchart : ∀ (Y : (wcP1Over K).left.ProEt) (x : Y.left),
      ∃ (V : (wcP1Over K).left.ProEt) (h : V ⟶ Y), IsOpenImmersion h.left ∧
        x ∈ Set.range h.left ∧ ∃ (B : Type u) (_ : CommRing B) (e : V.left ≅ Spec (.of B)) (g : B),
          ∀ y : V.left, V.hom y ∈ Set.range (fun i => S i (IsLocalRing.closedPoint K)) ↔
            g ∈ (e.hom y).asIdeal := by
    intro Y x
    obtain ⟨B, _, φ, ψ, j, hφ, hx, hj, hcomm, -⟩ := wc_proet_P1_affine_chart K Y x
    obtain ⟨f, hf⟩ := hpid (show Set (PrimeSpectrum (Polynomial K)) from
      j ⁻¹' Set.range (fun i => S i (IsLocalRing.closedPoint K))) (hZc.preimage j.continuous)
    haveI := hφ
    haveI : WeaklyEtale Y.hom := Y.prop
    have e : ∀ y, (φ ≫ Y.hom) y = j ((Spec.map (CommRingCat.ofHom ψ)) y) := fun y => by
      rw [hcomm]; rfl
    refine ⟨Scheme.ProEt.mk (φ ≫ Y.hom),
      MorphismProperty.Over.homMk (A := Scheme.ProEt.mk (φ ≫ Y.hom)) (B := Y) φ rfl trivial,
      hφ, hx, B, inferInstance, Iso.refl _, ψ f, fun y => ?_⟩
    show (φ ≫ Y.hom) y ∈ Set.range (fun i => S i (IsLocalRing.closedPoint K)) ↔ ψ f ∈ y.asIdeal
    rw [e y]
    exact hf ((Spec.map (CommRingCat.ofHom ψ)) y)

  have hcover : ∀ (Y : (wcP1Over K).left.ProEt), IsAffine Y.left →
      ∃ (n : ℕ) (V : Fin n → (wcP1Over K).left.ProEt) (h : ∀ i, V i ⟶ Y),
        Sieve.generate (Presieve.ofArrows V h) ∈ Scheme.ProEt.topology (wcP1Over K).left Y ∧
        ∀ i, ∃ (B : Type u) (_ : CommRing B) (e : (V i).left ≅ Spec (.of B)) (g : B),
          ∀ y : (V i).left, (V i).hom y ∈ Set.range (fun i => S i (IsLocalRing.closedPoint K)) ↔
            g ∈ (e.hom y).asIdeal := by
    intro Y hY
    haveI := hY
    choose V h hopen hmem hPr using hchart Y
    obtain ⟨t, ht⟩ := CompactSpace.elim_nhds_subcover (fun x => Set.range (h x).left)
      (fun x => by
        haveI := hopen x
        exact (h x).left.isOpenEmbedding.isOpen_range.mem_nhds (hmem x))
    refine ⟨t.card, fun i => V (t.equivFin.symm i).1, fun i => h (t.equivFin.symm i).1, ?_,
      fun i => hPr _⟩
    apply wc_proet_open_family_covers
    · intro i
      haveI := hopen (t.equivFin.symm i).1
      exact (h _).left.isOpenEmbedding.isOpenMap
    · intro z
      have hz : z ∈ ⋃ x ∈ t, Set.range (h x).left := by rw [ht]; trivial
      obtain ⟨x, hx, hzx⟩ := Set.mem_iUnion₂.mp hz
      refine ⟨t.equivFin ⟨x, hx⟩, ?_⟩
      have hs : t.equivFin.symm (t.equivFin ⟨x, hx⟩) = ⟨x, hx⟩ := Equiv.symm_apply_apply _ _
      rw [hs]
      exact hzx

  let R : Sieve T :=
    { arrows := fun T' h => ∃ (T₀ : (wcP1Over K).left.ProEt) (k : T' ⟶ T₀) (h₀ : T₀ ⟶ T)
          (B : Type u) (_ : CommRing B) (e : T₀.left ≅ Spec (.of B)) (g : B), h = k ≫ h₀ ∧
          ∀ y : T₀.left, T₀.hom y ∈ Set.range (fun i => S i (IsLocalRing.closedPoint K)) ↔
            g ∈ (e.hom y).asIdeal
      downward_closed := by
        intro Y₁ Z₁ f₁ hf₁ g₁
        obtain ⟨T₀, k, h₀, B, hB, e, g, hk, hg⟩ := hf₁
        exact ⟨T₀, g₁ ≫ k, h₀, B, hB, e, g, by rw [hk, Category.assoc], hg⟩ }
  refine ⟨R, ?_, fun T' h hh => hh⟩
  have hA := wc_proet_cover_of_affine_local (fun _ => True)
    (fun V hV => ⟨V, 𝟙 V, hV, inferInstance, inferInstance, trivial⟩) T
  refine (Scheme.ProEt.topology (wcP1Over K).left).transitive hA R ?_
  intro Y f hf
  obtain ⟨Y', w, a₀, ⟨hY', -⟩, rfl⟩ := hf
  rw [Sieve.pullback_comp]
  apply (Scheme.ProEt.topology (wcP1Over K).left).pullback_stable
  obtain ⟨n, V, h, hcov, hPr⟩ := hcover Y' hY'
  apply (Scheme.ProEt.topology (wcP1Over K).left).superset_covering _ hcov
  rw [Sieve.generate_le_iff]
  rintro _ _ ⟨i⟩
  obtain ⟨B, hB, e, g, hg⟩ := hPr i
  exact ⟨V i, 𝟙 _, h i ≫ a₀, B, hB, e, g, (Category.id_comp _).symm, hg⟩

theorem wc_ltc_lattice_lim (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G)
    (W : (wcP1Over K).left.ProEt) (r : ℕ)
    (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology (wcP1Over K).left).overPullback
          AddCommGrpCat.{u+1} W).map (σ c) ≫ θ.hom =
        θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback
          AddCommGrpCat.{u+1} W).map (wcConstScalar (wcP1Over K).left ℓ r c))
    (hWqc : QuasiCompact W.hom)
    (hWU : ∀ z : W.left, W.hom z ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)))
    (hWs : ∀ p : (wcP1Over K).left, p ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)) →
        ∃ z : W.left, W.hom z = p)
    (N : ↥(Limits.pullback W.hom W.hom) → GL (Fin r) ℤ_[ℓ])
    (hNlc : ∀ n : ℕ, IsLocallyConstant (fun x => wcLtcRed.{u} ℓ n r (N x)))
    (hTR : ∀ (T : (wcP1Over K).left.ProEt) (a b : T ⟶ W) (s : G.obj.obj (Opposite.op T))
          (z : T.left),
        wcLtcVal θ a s z = Matrix.vecMul (wcLtcVal θ b s z)
          ((N (wcLtcPair a b z) : Matrix (Fin r) (Fin r) ℤ_[ℓ]).map
            (fun x : ℤ_[ℓ] => (x : ℚ_[ℓ]))))
    (L : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (ι : L ⟶ G) (lam : ℤ_[ℓ] → (L ⟶ L)) (hlam1 : lam 1 = 𝟙 L)
    (hlamadd : ∀ a b : ℤ_[ℓ], lam (a + b) = lam a + lam b)
    (hlamι : ∀ a : ℤ_[ℓ], lam a ≫ ι = ι ≫ σ (a : ℚ_[ℓ])) (hmono : Mono ι)
    (hL : ∀ (T : (wcP1Over K).left.ProEt) (s : G.obj.obj (Opposite.op T)),
        (∃ t, (ι.hom.app (Opposite.op T)).hom t = s) ↔
          ∃ R : Sieve T, R ∈ Scheme.ProEt.topology (wcP1Over K).left T ∧
            ∀ (T' : (wcP1Over K).left.ProEt) (g : T' ⟶ T), R.arrows g →
              ((∀ t, T'.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))) ∧
                ∀ (T'' : (wcP1Over K).left.ProEt) (h : T'' ⟶ T') (b : T'' ⟶ W) (z : T''.left)
                  (i : Fin r), ‖wcLtcVal θ b ((G.obj.map (h ≫ g).op).hom s) z i‖ ≤ 1) ∨
              (G.obj.map g.op).hom s = 0)
    (Q : ℕ → Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (π : ∀ n, L ⟶ Q n) (τ : ∀ n, Q (n + 1) ⟶ Q n)
    (hex : ∀ n, 1 ≤ n → ∃ w : lam ((ℓ : ℤ_[ℓ]) ^ n) ≫ π n = 0, (ShortComplex.mk _ _ w).ShortExact)
    (hτ : ∀ n, 1 ≤ n → π (n + 1) ≫ τ n = π n) :
    ∀ (T : (wcP1Over K).left.ProEt) (x : ∀ n, (Q n).obj.obj (Opposite.op T)),
      (∀ n, 1 ≤ n → ((τ n).hom.app (Opposite.op T)).hom (x (n + 1)) = x n) →
      ∃ s : L.obj.obj (Opposite.op T), ∀ n, 1 ≤ n → ((π n).hom.app (Opposite.op T)).hom s = x n :=
by

  have nat : ∀ {A B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (φ : A ⟶ B) {T T' : (wcP1Over K).left.ProEt} (h : T' ⟶ T) (y : A.obj.obj (Opposite.op T)),
      (φ.hom.app (Opposite.op T')).hom ((A.obj.map h.op).hom y) =
        (B.obj.map h.op).hom ((φ.hom.app (Opposite.op T)).hom y) := by
    intro A B φ T T' h y
    have e := congrArg (fun f => f.hom y) (φ.hom.naturality h.op)
    simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] using e
  have fcomp : ∀ (A : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      {T T' T'' : (wcP1Over K).left.ProEt} (k : T'' ⟶ T') (h : T' ⟶ T)
      (y : A.obj.obj (Opposite.op T)),
      (A.obj.map (k ≫ h).op).hom y = (A.obj.map k.op).hom ((A.obj.map h.op).hom y) := by
    intro A T T' T'' k h y
    rw [op_comp, Functor.map_comp]
    rfl

  have hPB : ∀ (P P₁ P₂ : (wcP1Over K).left.ProEt) (g₁ : P₁ ⟶ P) (g₂ : P₂ ⟶ P)
      (p₁ : P₁.left) (p₂ : P₂.left), g₁.left p₁ = g₂.left p₂ →
      ∃ (P₁₂ : (wcP1Over K).left.ProEt) (k₁ : P₁₂ ⟶ P₁) (k₂ : P₁₂ ⟶ P₂) (q : P₁₂.left),
        k₁ ≫ g₁ = k₂ ≫ g₂ ∧ k₁.left q = p₁ ∧ k₂.left q = p₂ :=
    fun P P₁ P₂ g₁ g₂ p₁ p₂ h => wc_ltl_pt_pullback (wcP1Over K).left g₁ g₂ p₁ p₂ h

  obtain ⟨hINT, hINTc⟩ := wc_ltl_int (wcP1Over K).left
    (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ r G σ W θ hθ hWU N hTR L ι hL

  have hL' : ∀ (T : (wcP1Over K).left.ProEt) (t : L.obj.obj (Opposite.op T)), ∃ R : Sieve T,
      R ∈ Scheme.ProEt.topology (wcP1Over K).left T ∧
        ∀ (T' : (wcP1Over K).left.ProEt) (g : T' ⟶ T), R.arrows g →
          (∀ t', T'.hom t' ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))) ∨
            (G.obj.map g.op).hom ((ι.hom.app (Opposite.op T)).hom t) = 0 := by
    intro T t
    obtain ⟨R, hR, hRg⟩ := (hL T _).mp ⟨t, rfl⟩
    exact ⟨R, hR, fun T' g hg => (hRg T' g hg).imp (fun h => h.1) id⟩

  have hLOC := wc_ltl_loc (wcP1Over K).left
    (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ G L ι lam hL' Q π hex
  have huniq := wc_ltl_uniq (wcP1Over K).left
    (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ r G σ W θ hθ hWqc hWs L ι lam
    hlamι hmono hL' hINT Q π hex
  have hGLUE := wc_ltl_glue (wcP1Over K).left L Q π huniq

  have hU : ∀ (T : (wcP1Over K).left.ProEt),
      (∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))) →
      ∀ (x : ∀ n, (Q n).obj.obj (Opposite.op T)),
      (∀ n, 1 ≤ n → ((τ n).hom.app (Opposite.op T)).hom (x (n + 1)) = x n) →
      ∃ s : L.obj.obj (Opposite.op T),
        ∀ n, 1 ≤ n → ((π n).hom.app (Opposite.op T)).hom s = x n := by
    intro T hT x hx
    obtain ⟨P, p, b, hcov, -, -, -⟩ := wc_ltc_W_cover (wcP1Over K).left
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) W hWqc hWs T hT
    obtain ⟨s, hs⟩ := wc_ltl_lift_W (wcP1Over K).left ℓ r G σ W θ hθ L ι lam hlamι hmono
      hINT hINTc Q π τ hex hτ hPB P b (fun n => ((Q n).obj.map p.op).hom (x n)) (by
        intro n hn
        try dsimp only
        rw [nat, hx n hn])
    refine hGLUE T x _ hcov ?_
    intro T' h hh
    obtain ⟨T'', k, f, hf, rfl⟩ := hh
    cases hf
    exact ⟨(L.obj.map k.op).hom s, fun n hn => by rw [nat, hs n hn, fcomp]⟩

  have hCH := wc_ltl_lift_chart (wcP1Over K).left
    (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ r G σ W θ hθ hWqc hWs L ι lam
    hlamι hmono hINT Q π τ hex hPB hLOC huniq hGLUE hU

  intro T x hx
  obtain ⟨R, hR, hRf⟩ := wc_ltl_chart_sieve K m S hS T
  refine hGLUE T x R hR ?_
  intro T' h hh
  obtain ⟨T₀, k, h₀, B, hB, e, g, rfl, hg⟩ := hRf T' h hh
  obtain ⟨s₀, hs₀⟩ := hCH T₀ B e g hg (fun n => ((Q n).obj.map h₀.op).hom (x n)) (by
    intro n hn
    try dsimp only
    rw [nat, hx n hn])
  exact ⟨(L.obj.map k.op).hom s₀, fun n hn => by rw [nat, hs₀ n hn, fcomp]⟩

theorem wc_latticeU_tower_construct (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G) (hlisse : wcLisseOffS K hP ℓ m S G σ)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K)) :
    ∃ (r : ℕ) (V : ℕ → Scheme.{u}) (q' : (n : ℕ) → V n ⟶ Uo.toScheme) (Γ : ℕ → Type u)
      (_ : ∀ n, Group (Γ n)) (α : (n : ℕ) → Γ n →* Aut (V n))
      (ρ : (n : ℕ) → Γ n →* GL (Fin r) (ZMod (ℓ ^ n))),
      (∀ n, 1 ≤ n → wcGalCover (q' n) (Γ n) (α n)) ∧
      ∃ (hα : ∀ n γ, (α n γ).hom ≫ q' n ≫ Uo.ι = q' n ≫ Uo.ι)
        (L : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
        (ι : L ⟶ G) (lam : ℤ_[ℓ] → (L ⟶ L))
        (π : ∀ n, L ⟶ wcTwSh (q' n ≫ Uo.ι)
          (Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Γ n) (α n) (hα n) ℓ n r (ρ n))
        (τ : ∀ n, wcTwSh (q' (n + 1) ≫ Uo.ι)
            (Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Γ (n + 1)) (α (n + 1))
            (hα (n + 1)) ℓ (n + 1) r (ρ (n + 1)) ⟶
          wcTwSh (q' n ≫ Uo.ι)
            (Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Γ n) (α n) (hα n) ℓ n r (ρ n)),
        wcLatticeData K ℓ m S G σ Uo r V q' Γ α ρ hα L ι lam π τ :=
by
  obtain ⟨W, r, θ, N, hθ, hWqc, hWU, hWs, hNlc, hTR, hNdiag, hNcoc⟩ :=
    wc_ltc_integral_trivialization K hP ℓ m S hS G σ hσ1 hσadd hσmul hlisse
  have hin : ∀ z : W.left, W.hom z ∈ Uo := fun z =>
    (hUo _).mpr (fun i h => hWU z ⟨i, h.symm⟩)
  have hsurj : ∀ p : (wcP1Over K).left, p ∈ Uo → ∃ z : W.left, W.hom z = p := fun p hp =>
    hWs p (by rintro ⟨i, hi⟩; exact (hUo p).mp hp i hi.symm)
  have hB : ∀ n : ℕ, ∃ (V : Scheme.{u}) (q : V ⟶ Uo.toScheme)
      (α : wcLtcGam.{u} ℓ r n →* Aut V) (fr : W.left ⟶ V),
      fr ≫ q ≫ Uo.ι = W.hom ∧ wcGalCover q (wcLtcGam.{u} ℓ r n) α ∧
      ∀ (T : (wcP1Over K).left.ProEt) (a b : T ⟶ W) (γ : wcLtcGam.{u} ℓ r n),
        (∀ z : T.left, wcLtcRed.{u} ℓ n r (N (wcLtcPair a b z)) = γ) →
        b.left ≫ fr = a.left ≫ fr ≫ (α γ).hom := by
    intro n
    haveI : NeZero (ℓ ^ n) := ⟨pow_ne_zero n (Fact.out : Nat.Prime ℓ).ne_zero⟩
    haveI : Finite (GL (Fin r) (ZMod (ℓ ^ n))) :=
      Finite.of_injective (fun u : GL (Fin r) (ZMod (ℓ ^ n)) => (u : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))))
        Units.val_injective
    haveI : Finite (wcLtcGam.{u} ℓ r n) :=
      (Finite.of_equiv _ Equiv.ulift.symm : Finite (ULift.{u} (GL (Fin r) (ZMod (ℓ ^ n)))))
    exact wc_ltc_finite_torsor_descent Uo W hWqc hin hsurj
      (wcLtcGam.{u} ℓ r n) (fun x => wcLtcRed.{u} ℓ n r (N x)) (hNlc n)
      (fun T a z => by rw [hNdiag, map_one]) (fun T a b b' z => by rw [hNcoc T a b b' z, map_mul])
  choose V q α fr hf hcov htrans using hB
  have hα : ∀ n γ, (α n γ).hom ≫ q n ≫ Uo.ι = q n ≫ Uo.ι := by
    intro n γ
    obtain ⟨-, -, -, -, h, -⟩ := hcov n
    rw [← Category.assoc, h γ]
  obtain ⟨L, ι, lam, π, τ, hT1, hmono, hT3, hT4, hT5, hT6a, hL⟩ :=
    wc_ltc_lattice_core K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero Uo hUo W r θ hθ hWqc hWU hWs
      N hNlc hTR hNdiag hNcoc V q α hα fr hf (fun n _ => hcov n) htrans
  have h0 := wc_ltc_lattice_lim K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero W r θ hθ hWqc hWU hWs N hNlc hTR L ι lam hT1.1 hT1.2.1 hT1.2.2.2 hmono hL
  have h1 := h0 (fun n => wcTwSh (q n ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) (wcLtcGam.{u} ℓ r n) (α n) (hα n) ℓ n r (wcLtcRho.{u} ℓ r n))
  have h2 := h1 π
  have h3 := h2 τ
  have h4 := h3 hT4
  have hT6b := h4 hT6a
  exact ⟨r, V, q, fun n => wcLtcGam.{u} ℓ r n, fun n => wcLtcGamGroup.{u} ℓ r n, α,
    fun n => wcLtcRho.{u} ℓ r n, fun n _ => hcov n, hα, L, ι, lam, π, τ,
    hT1, hmono, hT3, hT4, hT5, hT6a, hT6b⟩

theorem wc_coker_sections_torsion_offZ : ∀ (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) (σ : ℚ_[ℓ] → (G ⟶ G)), σ 1 = 𝟙 G → (∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b) → ∀ (L : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) (ι : L ⟶ G), (∀ T : (wcP1Over K).left.ProEt, CompactSpace T.left → (∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))) → ∀ s : G.obj.obj (Opposite.op T), ∃ (k : ℕ) (s' : L.obj.obj (Opposite.op T)), (ι.hom.app (Opposite.op T)).hom s' = ((σ ((ℓ : ℚ_[ℓ]) ^ k)).hom.app (Opposite.op T)).hom s) → ∀ T : (wcP1Over K).left.ProEt, CompactSpace T.left → QuasiSeparatedSpace T.left → (∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))) → ∀ q : (Limits.cokernel ι).obj.obj (Opposite.op T), ∃ k : ℕ, (ℓ ^ k) • q = 0 :=
by
  intro K _ ℓ _ m S G σ hσ1 hσadd L ι hT3U T hc hqs hav q
  classical

  have hσ0 : σ 0 = 0 := by
    have h := hσadd 0 0
    rw [add_zero] at h
    exact left_eq_add.mp h
  have hσnat : ∀ n : ℕ, σ (n : ℚ_[ℓ]) = n • 𝟙 G := by
    intro n
    induction n with
    | zero => rw [Nat.cast_zero, hσ0, zero_nsmul]
    | succ n ih => rw [Nat.cast_succ, hσadd, ih, hσ1, succ_nsmul]
  have hσapp : ∀ (k : ℕ) (U : (wcP1Over K).left.ProEt) (s : G.obj.obj (Opposite.op U)),
      ((σ ((ℓ : ℚ_[ℓ]) ^ k)).hom.app (Opposite.op U)).hom s = (ℓ ^ k) • s := by
    intro k U s
    rw [← Nat.cast_pow, hσnat]
    generalize ℓ ^ k = n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [succ_nsmul, Sheaf.Hom.add_app, AddCommGrpCat.hom_add, AddMonoidHom.add_apply, ih,
        succ_nsmul]
      rfl

  have refine_lemma : ∀ (Sch : Scheme.{u}) (U : Sch.ProEt) [CompactSpace U.left]
      [QuasiSeparatedSpace U.left]
      (R : Sieve U), R ∈ Scheme.ProEt.topology Sch U →
      ∃ (k : ℕ) (V : Fin k → Sch.ProEt) (f : ∀ j, V j ⟶ U), (∀ j, R.arrows (f j)) ∧
        (∀ j, IsAffine (V j).left) ∧
        Sieve.generate (Presieve.ofArrows V f) ∈ Scheme.ProEt.topology Sch U := by
    intro Sch U _ _ R hR
    have fact : ∀ {Z : Scheme.{u}} (g : Z ⟶ U.left),
        (Sieve.overEquiv ((Scheme.ProEt.forget Sch).obj U)
          (Sieve.functorPushforward (Scheme.ProEt.forget Sch) R)).arrows g →
        ∃ (W : Sch.ProEt) (f : W ⟶ U) (e : Z ⟶ W.left), R.arrows f ∧ g = e ≫ f.left := by
      intro Z g hg
      have hg' := (Sieve.overEquiv_iff _ g).mp hg
      obtain ⟨W, φ, ψ, hφ, heq⟩ := hg'
      refine ⟨W, φ, ψ.left, hφ, ?_⟩
      have := congrArg CommaMorphism.left heq
      simp only [Over.homMk_left, Over.comp_left] at this
      exact this
    have hS : Sieve.overEquiv ((Scheme.ProEt.forget Sch).obj U)
        (Sieve.functorPushforward (Scheme.ProEt.forget Sch) R) ∈ Scheme.proetaleTopology U.left :=
      (GrothendieckTopology.mem_over_iff _ _).mp ((CoverPreserving.of_isContinuous
        (Scheme.ProEt.forget Sch) (Scheme.ProEt.topology Sch) (Scheme.proetaleTopology.over Sch)).cover_preserve hR)
    obtain ⟨R', hR', hle⟩ :=
      (Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition (J := Scheme.proetalePrecoverage)).mp hS
    obtain ⟨𝒰, h𝒰, hR'eq⟩ := (Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover).mp hR'
    haveI := h𝒰
    have hmem : ∀ j, (Sieve.overEquiv ((Scheme.ProEt.forget Sch).obj U)
        (Sieve.functorPushforward (Scheme.ProEt.forget Sch) R)).arrows (𝒰.f j) := by
      intro j
      apply hle
      rw [hR'eq]
      exact Presieve.ofArrows.mk j
    choose W f e hf he using fun j => fact (𝒰.f j) (hmem j)
    have hcpt : IsCompact ((⊤ : U.left.Opens) : Set U.left) := by
      rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ
    obtain ⟨n, c, V, hV, hUeq⟩ :=
      QuasiCompactCover.exists_isAffineOpen_of_isCompact 𝒰.toPreZeroHypercover hcpt
    have hwe : ∀ i, WeaklyEtale ((V i).ι ≫ 𝒰.f (c i)) := fun i => by
      haveI := Scheme.Cover.map_prop 𝒰 (c i)
      infer_instance
    have hwe' : ∀ i, WeaklyEtale (((V i).ι ≫ 𝒰.f (c i)) ≫ U.hom) := fun i => by
      haveI := hwe i
      haveI := U.prop
      infer_instance
    let Vo : Fin n → Sch.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (((V i).ι ≫ 𝒰.f (c i)) ≫ U.hom) (hwe' i)
    let fo : ∀ i, Vo i ⟶ U := fun i =>
      MorphismProperty.Over.homMk ((V i).ι ≫ 𝒰.f (c i)) rfl trivial
    have hq : ∀ i, QuasiCompact ((V i).ι ≫ 𝒰.f (c i)) := fun i => by
      haveI : IsAffine (V i).toScheme := hV i
      exact quasiCompact_of_compactSpace _
    have hs : ∀ x : U.left, ∃ j y, ((V j).ι ≫ 𝒰.f (c j)) y = x := by
      intro x
      have hx : x ∈ ((⊤ : U.left.Opens) : Set U.left) := trivial
      rw [← hUeq] at hx
      obtain ⟨i, z, hz, hzx⟩ := Set.mem_iUnion.mp hx
      refine ⟨i, ⟨z, hz⟩, ?_⟩
      refine (Scheme.Hom.comp_apply (V i).ι (𝒰.f (c i)) ⟨z, hz⟩).trans ?_
      rw [Scheme.Opens.ι_apply]
      exact hzx
    have H : Presieve.ofArrows (fun i => (V i).toScheme) (fun i => (V i).ι ≫ 𝒰.f (c i)) ∈
        Scheme.proetalePrecoverage.coverings U.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
        (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) _ _ hs (fun _ => trivial)) _ hq
          (inferInstanceAs (Finite (Fin n)))),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hwe⟩⟩
    have H' : Presieve.ofArrows (fun i => (Vo i).left) (fun i => (fo i).left) ∈
        Scheme.proetalePrecoverage.coverings U.left := H
    refine ⟨n, Vo, fo, fun i => ?_, fun i => hV i, ?_⟩
    · have hk : ((V i).ι ≫ e (c i)) ≫ (W (c i)).hom = (Vo i).hom := by
        change _ = ((V i).ι ≫ 𝒰.f (c i)) ≫ U.hom
        rw [he (c i)]
        simp only [Category.assoc]
        rw [MorphismProperty.Over.w (f (c i))]
      let k : Vo i ⟶ W (c i) := MorphismProperty.Over.homMk ((V i).ι ≫ e (c i)) hk trivial
      have hkf : k ≫ f (c i) = fo i := by
        apply MorphismProperty.Over.Hom.ext
        change ((V i).ι ≫ e (c i)) ≫ (f (c i)).left = (V i).ι ≫ 𝒰.f (c i)
        rw [he (c i), Category.assoc]
      rw [← hkf]
      exact R.downward_closed (hf (c i)) k
    · exact Precoverage.generate_mem_toGrothendieck
        (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H'))

  have hR : Presheaf.imageSieve (Limits.cokernel.π ι).hom q ∈
      Scheme.ProEt.topology (wcP1Over K).left T := by
    haveI : Sheaf.IsLocallySurjective (Limits.cokernel.π ι) :=
      (Sheaf.isLocallySurjective_iff_epi' _ (Limits.cokernel.π ι)).mpr inferInstance
    exact Presheaf.imageSieve_mem _ (Limits.cokernel.π ι).hom q
  haveI := hc
  haveI := hqs
  obtain ⟨N, V, f, hRf, haff, hcov⟩ := refine_lemma (wcP1Over K).left T _ hR

  have hloc : ∀ j, ∃ k : ℕ, (ℓ ^ k) • ((Limits.cokernel ι).obj.map (f j).op) q = 0 := by
    intro j
    obtain ⟨g, hg⟩ := hRf j
    haveI : IsAffine (V j).left := haff j
    have hVav : ∀ t, (V j).hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)) := by
      intro t
      have e : (V j).hom t = T.hom ((f j).left t) := by
        rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w (f j)]
      rw [e]
      exact hav _
    obtain ⟨k, s', hs'⟩ := hT3U (V j) inferInstance hVav g
    refine ⟨k, ?_⟩
    rw [hσapp] at hs'
    have e1 : (ℓ ^ k) • ((Limits.cokernel ι).obj.map (f j).op) q =
        ((Limits.cokernel.π ι).hom.app (Opposite.op (V j))) ((ℓ ^ k) • g) := by
      rw [map_nsmul, hg]
    have e2 : ((Limits.cokernel.π ι).hom.app (Opposite.op (V j))).hom ((ℓ ^ k) • g) = 0 := by
      rw [← hs']
      change ((ι ≫ Limits.cokernel.π ι).hom.app (Opposite.op (V j))).hom s' = 0
      rw [Limits.cokernel.condition ι]
      simp
    rw [e1]
    exact e2

  choose kk hkk using hloc
  refine ⟨∑ i, kk i, ?_⟩
  have hres : ∀ j, ((Limits.cokernel ι).obj.map (f j).op) ((ℓ ^ ∑ i, kk i) • q) = 0 := by
    intro j
    have hle : kk j ≤ ∑ i, kk i :=
      Finset.single_le_sum (fun i _ => Nat.zero_le (kk i)) (Finset.mem_univ j)
    rw [map_nsmul, ← pow_sub_mul_pow ℓ hle, mul_nsmul', hkk j, nsmul_zero]

  refine Sheaf.isSeparated (Limits.cokernel ι) T _ hcov _ _ ?_
  rintro Y g ⟨Y', h, g', ⟨j⟩, rfl⟩
  rw [map_zero, op_comp, Functor.map_comp, ConcreteCategory.comp_apply, hres j, map_zero]

theorem wc_proet_ext_le_one_torsion_of_qcqs_sections : ∀ (S : Scheme.{u}) (T : S.ProEt) [CompactSpace T.left] [QuasiSeparatedSpace T.left] (Q : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (ℓ : ℕ), (∀ (W : S.ProEt) (b : W ⟶ T), CompactSpace W.left → QuasiSeparatedSpace W.left → ∀ q : Q.obj.obj (Opposite.op W), ∃ k : ℕ, (ℓ ^ k) • q = 0) → (∀ z : Abelian.Ext (wcFreeSheaf S T) Q 0, ∃ k : ℕ, (ℓ ^ k) • z = 0) ∧ (∀ z : Abelian.Ext (wcFreeSheaf S T) Q 1, ∃ k : ℕ, (ℓ ^ k) • z = 0) :=
by
  intro S T _ _ Q ℓ htor
  classical

  obtain ⟨ev, hpost, -⟩ : ∃ ev : ∀ (V : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
        Abelian.Ext (wcFreeSheaf S V) G 0 ≃+ G.obj.obj (Opposite.op V),
      (∀ (V : S.ProEt) (G H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (g : G ⟶ H)
          (y : Abelian.Ext (wcFreeSheaf S V) G 0),
        ev V H ((Abelian.Ext.mk₀ g).postcomp (wcFreeSheaf S V) (add_zero 0) y) =
          (g.hom.app (Opposite.op V)).hom (ev V G y)) ∧
      (∀ (V V' : S.ProEt) (a : V' ⟶ V) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
          (y : Abelian.Ext (wcFreeSheaf S V) G 0),
        ev V' G ((Abelian.Ext.mk₀ (wcFreeSheafMap S a)).precomp G (zero_add 0) y) =
          (G.obj.map a.op).hom (ev V G y)) := by
    have Y : ∃ η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T),
        (∀ (T : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
            (s : G.obj.obj (Opposite.op T)),
          ∃! g : wcFreeSheaf S T ⟶ G, (g.hom.app (Opposite.op T)).hom (η T) = s) ∧
        ∀ (T T' : S.ProEt) (c : T' ⟶ T),
          ((wcFreeSheafMap S c).hom.app (Opposite.op T')).hom (η T') =
            ((wcFreeSheaf S T).obj.map c.op).hom (η T) := by
      let J := Scheme.ProEt.topology S
      let η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T) :=
        fun T => ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
          (Opposite.op T)).hom (FreeAbelianGroup.of (ULift.up (𝟙 T)))
      let e : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}),
          (wcFreeSheaf S T ⟶ G) ≃ G.obj.obj (Opposite.op T) := fun T G =>
        ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) G).trans
          (((Adjunction.whiskerRight (S.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
              (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G.obj).trans
            (uliftYonedaEquiv.{u+1} (X := T) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})))
      have he : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}) (g : wcFreeSheaf S T ⟶ G),
          e T G g = (g.hom.app (Opposite.op T)).hom (η T) := fun _ _ _ => rfl
      refine ⟨η, fun T G s => ⟨(e T G).symm s, ?_, fun g hg => (e T G).injective ?_⟩, fun T T' c => ?_⟩
      · exact (he T G _).symm.trans (Equiv.apply_symm_apply _ _)
      · exact (he T G g).trans (hg.trans (Equiv.apply_symm_apply _ _).symm)
      · let P := yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
        let P' := yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
        let w : P' ⟶ P := Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
        let x' : P'.obj (Opposite.op T') := FreeAbelianGroup.of (ULift.up (𝟙 T'))
        let x : P.obj (Opposite.op T) := FreeAbelianGroup.of (ULift.up (𝟙 T))
        have h1 : ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
            (Opposite.op T')).hom x') = ((toSheafify J P).app (Opposite.op T')).hom
              ((w.app (Opposite.op T')).hom x') :=
          (ConcreteCategory.congr_hom
            (congrArg (fun φ => φ.app (Opposite.op T')) (toSheafify_naturality J w)) x').symm
        have h2 : (w.app (Opposite.op T')).hom x' = (P.map c.op).hom x := by
          change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) =
            FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
          refine (FreeAbelianGroup.map_of_apply _).trans
            (Eq.trans ?_ (FreeAbelianGroup.map_of_apply _).symm)
          congr 1
        have hn : ((toSheafify J P).app (Opposite.op T')).hom ((P.map c.op).hom x) =
            ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x) :=
          NatTrans.naturality_apply (toSheafify J P) c.op x
        change ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
            (Opposite.op T')).hom x') =
          ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x)
        rw [h1, h2, hn]
    obtain ⟨η, hη₁, hη₂⟩ := Y
    let E : ∀ (V : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
        (wcFreeSheaf S V ⟶ G) →+ G.obj.obj (Opposite.op V) :=
      fun V G => AddMonoidHom.mk' (fun φ => (φ.hom.app (Opposite.op V)).hom (η V))
        (fun φ ψ => by simp only [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply])
    have hE : ∀ V G, Function.Bijective (E V G) := by
      intro V G
      refine ⟨fun φ ψ h => ?_, fun s => ?_⟩
      · exact (hη₁ V G (E V G φ)).unique rfl h.symm
      · obtain ⟨g, hg, _⟩ := hη₁ V G s
        exact ⟨g, hg⟩
    let ev : ∀ (V : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
        Abelian.Ext (wcFreeSheaf S V) G 0 ≃+ G.obj.obj (Opposite.op V) :=
      fun V G => Abelian.Ext.addEquiv₀.trans (AddEquiv.ofBijective (E V G) (hE V G))
    have hev : ∀ (V : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (f : wcFreeSheaf S V ⟶ G),
        ev V G (Abelian.Ext.mk₀ f) = (f.hom.app (Opposite.op V)).hom (η V) := by
      intro V G f
      have h1 : Abelian.Ext.addEquiv₀ (Abelian.Ext.mk₀ f) = f := by
        rw [← Abelian.Ext.addEquiv₀_symm_apply, AddEquiv.apply_symm_apply]
      show E V G (Abelian.Ext.addEquiv₀ (Abelian.Ext.mk₀ f)) = _
      rw [h1]
      rfl
    refine ⟨ev, ?_, ?_⟩
    · intro V G H g y
      obtain ⟨φ, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
      show ev V H ((Abelian.Ext.mk₀ φ).comp (Abelian.Ext.mk₀ g) (add_zero 0)) = _
      rw [Abelian.Ext.mk₀_comp_mk₀, hev, hev]
      rfl
    · intro V V' a G y
      obtain ⟨φ, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
      show ev V' G ((Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp (Abelian.Ext.mk₀ φ) (zero_add 0)) = _
      rw [Abelian.Ext.mk₀_comp_mk₀, hev, hev]
      have h1 : ((wcFreeSheafMap S a ≫ φ).hom.app (Opposite.op V')).hom (η V') =
          (φ.hom.app (Opposite.op V')).hom
            (((wcFreeSheafMap S a).hom.app (Opposite.op V')).hom (η V')) := rfl
      rw [h1, hη₂ V V' a]
      exact NatTrans.naturality_apply φ.hom a.op (η V)

  have hA : ∀ z : Abelian.Ext (wcFreeSheaf S T) Q 0, ∃ k : ℕ, (ℓ ^ k) • z = 0 := by
    intro z
    obtain ⟨k, hk⟩ := htor T (𝟙 T) inferInstance inferInstance (ev T Q z)
    refine ⟨k, (ev T Q).injective ?_⟩
    rw [map_nsmul, hk, map_zero]

  have compF : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) {A B D : S.ProEt}
      (a : A ⟶ B) (b : B ⟶ D) (y : F.obj.obj (Opposite.op D)),
      (F.obj.map a.op).hom ((F.obj.map b.op).hom y) = (F.obj.map (a ≫ b).op).hom y := by
    intro F A B D a b y
    rw [op_comp, Functor.map_comp]
    all_goals rfl

  have glue : ∀ (F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) {U : S.ProEt} {N : ℕ}
      (V : Fin N → S.ProEt) (f : ∀ a, V a ⟶ U),
      Sieve.generate (Presieve.ofArrows V f) ∈ Scheme.ProEt.topology S U →
      (∀ t : ∀ a, F.obj.obj (Opposite.op (V a)),
        (∀ a b, (F.obj.map (Limits.pullback.fst (f a) (f b)).op).hom (t a) =
          (F.obj.map (Limits.pullback.snd (f a) (f b)).op).hom (t b)) →
        ∃ s : F.obj.obj (Opposite.op U), ∀ a, (F.obj.map (f a).op).hom s = t a) ∧
      (∀ s s' : F.obj.obj (Opposite.op U),
        (∀ a, (F.obj.map (f a).op).hom s = (F.obj.map (f a).op).hom s') → s = s') := by
    intro F U N V f hcov
    have hP : Presieve.IsSheaf (Scheme.ProEt.topology S)
        ((sheafCompose (Scheme.ProEt.topology S) (forget AddCommGrpCat.{u+1})).obj F).obj :=
      (isSheaf_iff_isSheaf_of_type _ _).mp
        ((sheafCompose (Scheme.ProEt.topology S) (forget AddCommGrpCat.{u+1})).obj F).2
    have hsf := (Presieve.isSheafFor_arrows_iff
      ((sheafCompose (Scheme.ProEt.topology S) (forget AddCommGrpCat.{u+1})).obj F).obj f).mp
        (hP.isSheafFor _ hcov)
    refine ⟨fun t ht => ?_, fun s s' hss => ?_⟩
    · obtain ⟨s, hs, -⟩ := hsf t (by
        intro a b Z ga gb h
        obtain ⟨l, hl1, hl2⟩ : ∃ l : Z ⟶ Limits.pullback (f a) (f b),
            l ≫ Limits.pullback.fst (f a) (f b) = ga ∧ l ≫ Limits.pullback.snd (f a) (f b) = gb :=
          ⟨Limits.pullback.lift ga gb h, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
        show (F.obj.map ga.op).hom (t a) = (F.obj.map gb.op).hom (t b)
        rw [← hl1, ← hl2, ← compF, ← compF, ht a b])
      exact ⟨s, hs⟩
    · apply (hP.isSheafFor _ hcov).isSeparatedFor.ext
      intro Z g hg
      rcases hg with ⟨a⟩
      exact hss a

  have refin : ∀ (R : Sieve T), R ∈ Scheme.ProEt.topology S T →
      ∃ (k : ℕ) (V : Fin k → S.ProEt) (f : ∀ j, V j ⟶ T), (∀ j, R.arrows (f j)) ∧
        (∀ j, IsAffine (V j).left) ∧
        Sieve.generate (Presieve.ofArrows V f) ∈ Scheme.ProEt.topology S T := by
    intro R hR
    have fact : ∀ {Z : Scheme.{u}} (g : Z ⟶ T.left),
        (Sieve.overEquiv ((Scheme.ProEt.forget S).obj T)
          (Sieve.functorPushforward (Scheme.ProEt.forget S) R)).arrows g →
        ∃ (W : S.ProEt) (f : W ⟶ T) (e : Z ⟶ W.left), R.arrows f ∧ g = e ≫ f.left := by
      intro Z g hg
      have hg' := (Sieve.overEquiv_iff _ g).mp hg
      obtain ⟨W, φ, ψ, hφ, heq⟩ := hg'
      refine ⟨W, φ, ψ.left, hφ, ?_⟩
      have := congrArg CommaMorphism.left heq
      simp only [Over.homMk_left, Over.comp_left] at this
      exact this
    have hS : Sieve.overEquiv ((Scheme.ProEt.forget S).obj T)
        (Sieve.functorPushforward (Scheme.ProEt.forget S) R) ∈ Scheme.proetaleTopology T.left :=
      (GrothendieckTopology.mem_over_iff _ _).mp ((CoverPreserving.of_isContinuous
        (Scheme.ProEt.forget S) (Scheme.ProEt.topology S) (Scheme.proetaleTopology.over S)).cover_preserve hR)
    obtain ⟨R', hR', hle⟩ :=
      (Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition (J := Scheme.proetalePrecoverage)).mp hS
    obtain ⟨𝒰, h𝒰, hR'eq⟩ := (Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover).mp hR'
    haveI := h𝒰
    have hmem : ∀ j, (Sieve.overEquiv ((Scheme.ProEt.forget S).obj T)
        (Sieve.functorPushforward (Scheme.ProEt.forget S) R)).arrows (𝒰.f j) := by
      intro j
      apply hle
      rw [hR'eq]
      exact Presieve.ofArrows.mk j
    choose W f e hf he using fun j => fact (𝒰.f j) (hmem j)
    have hcpt : IsCompact ((⊤ : T.left.Opens) : Set T.left) := by
      rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ
    obtain ⟨n, c, V, hV, hUeq⟩ :=
      QuasiCompactCover.exists_isAffineOpen_of_isCompact 𝒰.toPreZeroHypercover hcpt
    have hwe : ∀ i, WeaklyEtale ((V i).ι ≫ 𝒰.f (c i)) := fun i => by
      haveI := Scheme.Cover.map_prop 𝒰 (c i)
      infer_instance
    have hwe' : ∀ i, WeaklyEtale (((V i).ι ≫ 𝒰.f (c i)) ≫ T.hom) := fun i => by
      haveI := hwe i
      haveI := T.prop
      infer_instance
    let Vo : Fin n → S.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (((V i).ι ≫ 𝒰.f (c i)) ≫ T.hom) (hwe' i)
    let fo : ∀ i, Vo i ⟶ T := fun i =>
      MorphismProperty.Over.homMk ((V i).ι ≫ 𝒰.f (c i)) rfl trivial
    have hq : ∀ i, QuasiCompact ((V i).ι ≫ 𝒰.f (c i)) := fun i => by
      haveI : IsAffine (V i).toScheme := hV i
      exact quasiCompact_of_compactSpace _
    have hs : ∀ x : T.left, ∃ j y, ((V j).ι ≫ 𝒰.f (c j)) y = x := by
      intro x
      have hx : x ∈ ((⊤ : T.left.Opens) : Set T.left) := trivial
      rw [← hUeq] at hx
      obtain ⟨i, z, hz, hzx⟩ := Set.mem_iUnion.mp hx
      refine ⟨i, ⟨z, hz⟩, ?_⟩
      refine (Scheme.Hom.comp_apply (V i).ι (𝒰.f (c i)) ⟨z, hz⟩).trans ?_
      rw [Scheme.Opens.ι_apply]
      exact hzx
    have H : Presieve.ofArrows (fun i => (V i).toScheme) (fun i => (V i).ι ≫ 𝒰.f (c i)) ∈
        Scheme.proetalePrecoverage.coverings T.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
        (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) _ _ hs (fun _ => trivial)) _ hq
          (inferInstanceAs (Finite (Fin n)))),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hwe⟩⟩
    have H' : Presieve.ofArrows (fun i => (Vo i).left) (fun i => (fo i).left) ∈
        Scheme.proetalePrecoverage.coverings T.left := H
    refine ⟨n, Vo, fo, fun i => ?_, fun i => hV i, ?_⟩
    · have hk : ((V i).ι ≫ e (c i)) ≫ (W (c i)).hom = (Vo i).hom := by
        change _ = ((V i).ι ≫ 𝒰.f (c i)) ≫ T.hom
        rw [he (c i)]
        simp only [Category.assoc]
        rw [MorphismProperty.Over.w (f (c i))]
      let k : Vo i ⟶ W (c i) := MorphismProperty.Over.homMk ((V i).ι ≫ e (c i)) hk trivial
      have hkf : k ≫ f (c i) = fo i := by
        apply MorphismProperty.Over.Hom.ext
        change ((V i).ι ≫ e (c i)) ≫ (f (c i)).left = (V i).ι ≫ 𝒰.f (c i)
        rw [he (c i), Category.assoc]
      rw [← hkf]
      exact R.downward_closed (hf (c i)) k
    · exact Precoverage.generate_mem_toGrothendieck
        (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H'))

  have pbqcqs : ∀ {U V W : S.ProEt} (f : V ⟶ U) (g : W ⟶ U)
      [QuasiSeparatedSpace U.left] [CompactSpace V.left] [QuasiSeparatedSpace V.left]
      [CompactSpace W.left] [QuasiSeparatedSpace W.left],
      CompactSpace (Limits.pullback f g).left ∧ QuasiSeparatedSpace (Limits.pullback f g).left := by
    intro U V W f g _ _ _ _ _
    have sq : IsPullback (Limits.pullback.fst f g).left (Limits.pullback.snd f g).left
        f.left g.left :=
      (Scheme.ProEt.forget S ⋙ Over.forget S).map_isPullback (IsPullback.of_hasPullback f g)
    haveI hqc : QuasiCompact (Limits.pullback.snd f g).left :=
      MorphismProperty.of_isPullback (P := @QuasiCompact) sq (quasiCompact_of_compactSpace f.left)
    haveI hqs : QuasiSeparated (Limits.pullback.snd f g).left :=
      MorphismProperty.of_isPullback (P := @QuasiSeparated) sq
        (QuasiSeparated.of_quasiSeparatedSpace f.left)
    exact ⟨QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd f g).left,
      quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.snd f g).left⟩

  obtain ⟨I, Q', j, π, w, hSE, hI⟩ : ∃ (I Q' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (j : Q ⟶ I) (π : I ⟶ Q') (w : j ≫ π = 0), (ShortComplex.mk j π w).ShortExact ∧ Injective I :=
    ⟨Injective.under Q, Limits.cokernel (Injective.ι Q), Injective.ι Q,
      Limits.cokernel.π (Injective.ι Q), Limits.cokernel.condition (Injective.ι Q),
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel (Injective.ι Q)) inferInstance
        inferInstance, inferInstance⟩
  haveI : Epi π := hSE.epi_g
  have hker : ∀ (W : S.ProEt) (y : I.obj.obj (Opposite.op W)),
      (π.hom.app (Opposite.op W)).hom y = 0 → ∃ x, (j.hom.app (Opposite.op W)).hom x = y := by
    intro W y hy
    have hE := hSE.exact.map_of_mono_of_preservesKernel
      (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
        (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op W)) hSE.mono_f inferInstance
    obtain ⟨x, hx⟩ := (ShortComplex.ab_exact_iff _).mp hE y hy
    exact ⟨x, hx⟩
  have hsurj : ∀ (W : S.ProEt) (q : Q'.obj.obj (Opposite.op W)),
      Presheaf.imageSieve π.hom q ∈ Scheme.ProEt.topology S W := by
    intro W q
    haveI : Sheaf.IsLocallySurjective π :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} π).mpr inferInstance
    exact Presheaf.imageSieve_mem (Scheme.ProEt.topology S) π.hom q
  have natπ : ∀ {X Y : S.ProEt} (g : Y ⟶ X) (x : I.obj.obj (Opposite.op X)),
      (π.hom.app (Opposite.op Y)).hom ((I.obj.map g.op).hom x) =
        (Q'.obj.map g.op).hom ((π.hom.app (Opposite.op X)).hom x) :=
    fun g x => NatTrans.naturality_apply π.hom g.op x

  have hlift : ∀ q' : Q'.obj.obj (Opposite.op T), ∃ (k : ℕ) (s : I.obj.obj (Opposite.op T)),
      (π.hom.app (Opposite.op T)).hom s = (ℓ ^ k) • q' := by
    intro q'
    obtain ⟨N, V, f, hRf, hVaff, hcov⟩ := refin (Presheaf.imageSieve π.hom q') (hsurj T q')
    have hloc : ∀ a, ∃ t : I.obj.obj (Opposite.op (V a)),
        (π.hom.app (Opposite.op (V a))).hom t = (Q'.obj.map (f a).op).hom q' := by
      intro a
      have h := hRf a
      rw [Presheaf.imageSieve_apply] at h
      obtain ⟨x, hx⟩ := h
      exact ⟨x, hx⟩
    choose t ht using hloc
    have hcocyc : ∀ a b, ∃ d : Q.obj.obj (Opposite.op (Limits.pullback (f a) (f b))),
        (j.hom.app (Opposite.op (Limits.pullback (f a) (f b)))).hom d =
          (I.obj.map (Limits.pullback.fst (f a) (f b)).op).hom (t a) -
            (I.obj.map (Limits.pullback.snd (f a) (f b)).op).hom (t b) := by
      intro a b
      apply hker
      rw [map_sub, natπ, natπ, ht a, ht b, compF, compF, Limits.pullback.condition, sub_self]
    choose d hd using hcocyc
    have htd : ∀ a b, ∃ k : ℕ, (ℓ ^ k) • d a b = 0 := by
      intro a b
      haveI := hVaff a
      haveI := hVaff b
      obtain ⟨h1, h2⟩ := pbqcqs (f a) (f b)
      exact htor _ (Limits.pullback.fst (f a) (f b) ≫ f a) h1 h2 (d a b)
    choose k hk using htd
    obtain ⟨K, hkK⟩ : ∃ K : ℕ, ∀ a b, k a b ≤ K :=
      ⟨∑ a, ∑ b, k a b, fun a b =>
        (Finset.single_le_sum (f := fun b => k a b) (fun _ _ => Nat.zero_le _)
          (Finset.mem_univ b)).trans
        (Finset.single_le_sum (f := fun a => ∑ b, k a b) (fun _ _ => Nat.zero_le _)
          (Finset.mem_univ a))⟩
    have hKd : ∀ a b, (ℓ ^ K) • d a b = 0 := by
      intro a b
      obtain ⟨m, hm⟩ := Nat.exists_eq_add_of_le (hkK a b)
      rw [hm, pow_add, mul_comm, mul_smul, hk, smul_zero]
    have hcompat : ∀ a b, (I.obj.map (Limits.pullback.fst (f a) (f b)).op).hom ((ℓ ^ K) • t a) =
        (I.obj.map (Limits.pullback.snd (f a) (f b)).op).hom ((ℓ ^ K) • t b) := by
      intro a b
      have h1 : (ℓ ^ K) • (j.hom.app (Opposite.op (Limits.pullback (f a) (f b)))).hom (d a b) = 0 := by
        rw [← map_nsmul, hKd a b, map_zero]
      rw [hd a b, smul_sub, sub_eq_zero] at h1
      rw [map_nsmul, map_nsmul]
      exact h1
    obtain ⟨s, hs⟩ := (glue I V f hcov).1 (fun a => (ℓ ^ K) • t a) hcompat
    refine ⟨K, s, (glue Q' V f hcov).2 _ _ (fun a => ?_)⟩
    have hsa : (I.obj.map (f a).op).hom s = (ℓ ^ K) • t a := hs a
    rw [← natπ, hsa, map_nsmul, ht a, map_nsmul]

  have nsmul_comp : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {a b c : ℕ}
      (α : Abelian.Ext X Y a) (β : Abelian.Ext Y Z b) (h : a + b = c) (n : ℕ),
      (n • α).comp β h = n • α.comp β h := by
    intro X Y Z a b c α β h n
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.zero_comp]
    | succ n ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.add_comp, ih]
  have hB : ∀ z : Abelian.Ext (wcFreeSheaf S T) Q 1, ∃ k : ℕ, (ℓ ^ k) • z = 0 := by
    intro z
    haveI := hI
    have hz0 : z.comp (Abelian.Ext.mk₀ (ShortComplex.mk j π w).f) (add_zero 1) = 0 :=
      Abelian.Ext.eq_zero_of_injective (I := I) (n := 0) _
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ (wcFreeSheaf S T) hSE z hz0 (zero_add 1)
    obtain ⟨k, s, hs⟩ := hlift (ev T Q' x₃)
    refine ⟨k, ?_⟩
    have hy : (Abelian.Ext.mk₀ π).postcomp (wcFreeSheaf S T) (add_zero 0) ((ev T I).symm s) =
        (ℓ ^ k) • x₃ := by
      apply (ev T Q').injective
      rw [hpost, AddEquiv.apply_symm_apply, hs, map_nsmul]
    have hy' : ((ev T I).symm s).comp (Abelian.Ext.mk₀ π) (add_zero 0) = (ℓ ^ k) • x₃ := hy
    have hce : (Abelian.Ext.mk₀ π).comp hSE.extClass (zero_add 1) = 0 := hSE.comp_extClass
    rw [← hx₃, ← nsmul_comp, ← hy',
      Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by norm_num), hce,
      Abelian.Ext.comp_zero]
  exact ⟨hA, hB⟩

theorem wc_P1_punct_coker_ext_le_one_torsion : ∀ (F'' : Type u) [Field F''] [Finite F''] (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) (m : ℕ) (S : Fin m → (Spec (.of F'') ⟶ (wcP1Over F'').left)), (∀ i, S i ≫ (wcP1Over F'').hom = 𝟙 _) → ∀ (ℓ : ℕ) (Q : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}), wcZeroAtS F'' m S Q → (∀ V : (wcP1Over F'').left.ProEt, CompactSpace V.left → QuasiSeparatedSpace V.left → (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint F'')) → ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over F'').left V) Q 0, ∃ k : ℕ, (ℓ ^ k) • y = 0) → ∀ (i0 : Fin m) (j : ℕ), j ≤ 1 → ∀ x : Abelian.Ext (Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left (wcPunctIncl F'' (S i0) hP))) Q j, ∃ k : ℕ, (ℓ ^ k) • x = 0 :=
by
  classical
  intro F'' _ _ hP m S hS ℓ Q hQZ htor0 i0 j hj x
  obtain ⟨V₀, g₀, φ₀, A, iA₁, iA₂, iA₃, e, ε, hv, -, hε, -⟩ :=
    wc_P1bar_strict_local_nbhd F'' (S i0) (hS i0) hP
  obtain ⟨κ, hκ, -⟩ := wc_strict_nbhd_punct_excision F'' (S i0) (hS i0) hP V₀ g₀ A e ε hv hε
  haveI := hκ
  haveI hproj : Projective (wcFreeSheaf (wcP1Over F'').left V₀) :=
    wc_proet_free_projective_strict_local (wcP1Over F'').left V₀ A e

  have hclosedS : ∀ i : Fin m, IsClosed ({S i (IsLocalRing.closedPoint F'')} :
      Set (wcP1Over F'').left) := by
    intro i
    haveI : IsClosedImmersion (S i) := isClosedImmersion_of_comp_eq_id _ (S i) (hS i)
    have hrange : Set.range (S i) = {S i (IsLocalRing.closedPoint F'')} := by
      ext z
      constructor
      · rintro ⟨a, rfl⟩
        rw [Subsingleton.elim a (IsLocalRing.closedPoint F'')]
        exact Set.mem_singleton _
      · intro hz
        rw [Set.mem_singleton_iff.mp hz]
        exact ⟨_, rfl⟩
    rw [← hrange]
    exact (S i).isClosedEmbedding.isClosed_range
  have hVT : ∀ (t : (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' (S i0)) V₀).left)
      (i : Fin m), (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' (S i0)) V₀).hom t ≠
        S i (IsLocalRing.closedPoint F'') := by
    intro t i h
    set p := Limits.pullback.snd (wcPunctOpen F'' (S i0)).ι V₀.hom t with hp
    have h1 : (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' (S i0)) V₀).hom t = V₀.hom p := by
      first
        | exact Scheme.Hom.comp_apply (Limits.pullback.snd (wcPunctOpen F'' (S i0)).ι V₀.hom)
            V₀.hom t
        | rfl
    have h2 : V₀.hom p ∈ (wcPunctOpen F'' (S i0) : Set (wcP1Over F'').left) := by
      have key : ∀ q : ↥(Limits.pullback (wcPunctOpen F'' (S i0)).ι V₀.hom),
          (Limits.pullback.snd (wcPunctOpen F'' (S i0)).ι V₀.hom ≫ V₀.hom) q ∈
            (wcPunctOpen F'' (S i0) : Set (wcP1Over F'').left) := by
        intro q
        rw [← Limits.pullback.condition, Scheme.Hom.comp_apply,
          ← Scheme.Opens.range_ι (wcPunctOpen F'' (S i0))]
        exact Set.mem_range_self _
      have k2 := key t
      rw [← h1]
      exact k2
    have h3 : p ⤳ e.inv (IsLocalRing.closedPoint A) := by
      have := (IsLocalRing.specializes_closedPoint (e.hom p)).map e.inv.continuous
      rwa [Scheme.hom_inv_apply] at this
    have h4 : V₀.hom p ⤳ S i0 (IsLocalRing.closedPoint F'') := by
      rw [← hv]; exact h3.map V₀.hom.continuous
    have h5 : S i0 (IsLocalRing.closedPoint F'') ∈
        closure {S i (IsLocalRing.closedPoint F'')} := by
      rw [← h, h1]; exact specializes_iff_mem_closure.mp h4
    rw [(hclosedS i).closure_eq] at h5
    have h6 : V₀.hom p = S i0 (IsLocalRing.closedPoint F'') := by
      rw [← h1, h, ← Set.mem_singleton_iff.mp h5]
    have h7 : V₀.hom p ∈ ((closure {S i0 (IsLocalRing.closedPoint F'')})ᶜ :
        Set (wcP1Over F'').left) := h2
    exact h7 (by rw [h6]; exact subset_closure (Set.mem_singleton _))

  haveI : IsAffine V₀.left := IsAffine.of_isIso e.hom
  have hqcqs : CompactSpace (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' (S i0)) V₀).left ∧
      QuasiSeparatedSpace (wcOpenRestr (wcP1Over F'').left (wcPunctOpen F'' (S i0)) V₀).left := by
    haveI hprop : IsProper (wcProjKStr F'' 1) := wc_proj_space_isProper F'' 1
    haveI : IsLocallyNoetherian (wcP1Over F'').left :=
      LocallyOfFiniteType.isLocallyNoetherian (wcProjKStr F'' 1)
    haveI : CompactSpace (wcP1Over F'').left :=
      QuasiCompact.compactSpace_of_compactSpace (wcProjKStr F'' 1)
    haveI : AlgebraicGeometry.IsNoetherian (wcP1Over F'').left := AlgebraicGeometry.IsNoetherian.mk
    haveI : TopologicalSpace.NoetherianSpace (wcP1Over F'').left :=
      AlgebraicGeometry.IsNoetherian.noetherianSpace
    haveI : QuasiSeparatedSpace (wcP1Over F'').left := IsLocallyNoetherian.quasiSeparatedSpace
    haveI : CompactSpace (wcPunctOpen F'' (S i0)).toScheme :=
      isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact _)
    haveI : QuasiCompact (wcPunctOpen F'' (S i0)).ι := quasiCompact_of_compactSpace _
    change CompactSpace ↥(Limits.pullback (wcPunctOpen F'' (S i0)).ι V₀.hom) ∧
      QuasiSeparatedSpace ↥(Limits.pullback (wcPunctOpen F'' (S i0)).ι V₀.hom)
    haveI : CompactSpace ↥((𝟭 Scheme).obj V₀.left) := (inferInstance : CompactSpace V₀.left)
    haveI : QuasiSeparatedSpace ↥((𝟭 Scheme).obj V₀.left) :=
      (inferInstance : QuasiSeparatedSpace V₀.left)
    exact ⟨QuasiCompact.compactSpace_of_compactSpace
        (Limits.pullback.snd (wcPunctOpen F'' (S i0)).ι V₀.hom),
      quasiSeparatedSpace_of_quasiSeparated
        (Limits.pullback.snd (wcPunctOpen F'' (S i0)).ι V₀.hom)⟩

  have hmonoL : Mono (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' (S i0)) V₀).left := by
    change Mono (Limits.pullback.snd (wcPunctOpen F'' (S i0)).ι V₀.hom)
    exact IsOpenImmersion.mono _
  have hmono := wc_free_sheaf_map_mono (wcP1Over F'').left _ _
    (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' (S i0)) V₀) hmonoL
  have hSE := ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel (wcFreeSheafMap
    (wcP1Over F'').left (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' (S i0)) V₀)))
    hmono inferInstance

  have hcompn : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1}}
      {a b c : ℕ} (α : Abelian.Ext X Y a) (β : Abelian.Ext Y Z b) (h : a + b = c) (n : ℕ),
      α.comp (n • β) h = n • α.comp β h := by
    intro X Y Z a b c α β h n
    induction n with
    | zero => simp [Abelian.Ext.comp_zero]
    | succ n ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.comp_add, ih]

  have h0 : ∀ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left
      (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' (S i0)) V₀))) Q 0, y = 0 := by
    intro y
    obtain ⟨φ, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
    have hz : (Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left
        (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' (S i0)) V₀)))).comp
        (Abelian.Ext.mk₀ φ) (zero_add 0) = 0 := hQZ i0 V₀ A e hv _
    rw [Abelian.Ext.mk₀_comp_mk₀] at hz
    have h1 : Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left
        (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' (S i0)) V₀)) ≫ φ = 0 :=
      (Abelian.Ext.mk₀_bijective _ _).1 (hz.trans (Abelian.Ext.mk₀_zero _ _).symm)
    have h2 : φ = 0 := (cancel_epi _).1 (h1.trans Limits.comp_zero.symm)
    rw [h2, Abelian.Ext.mk₀_zero]

  have h1 : ∀ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left
      (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' (S i0)) V₀))) Q 1,
      ∃ k : ℕ, (ℓ ^ k) • y = 0 := by
    intro y
    have hz := Abelian.Ext.eq_zero_of_projective (n := 0)
      ((Abelian.Ext.mk₀ (Limits.cokernel.π (wcFreeSheafMap (wcP1Over F'').left
        (wcOpenRestrIncl (wcP1Over F'').left (wcPunctOpen F'' (S i0)) V₀)))).comp y
        (zero_add 1))
    obtain ⟨y₁, hy₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hSE Q y hz
      (n₀ := 0) (by omega)
    obtain ⟨k, hk⟩ := htor0 _ hqcqs.1 hqcqs.2 hVT y₁
    exact ⟨k, by rw [← hy₁, ← hcompn, hk, Abelian.Ext.comp_zero]⟩

  have hinv : ∀ (n : ℕ) (z : Abelian.Ext (Limits.cokernel (wcFreeSheafMap (wcP1Over F'').left
      (wcPunctIncl F'' (S i0) hP))) Q n),
      z = (Abelian.Ext.mk₀ (inv κ)).comp ((Abelian.Ext.mk₀ κ).comp z (zero_add n))
        (zero_add n) := by
    intro n z
    calc z = (Abelian.Ext.mk₀ (𝟙 _)).comp z (zero_add n) :=
          (Abelian.Ext.mk₀_id_comp z).symm
      _ = (Abelian.Ext.mk₀ (inv κ ≫ κ)).comp z (zero_add n) := by rw [IsIso.inv_hom_id]
      _ = (Abelian.Ext.mk₀ (inv κ)).comp ((Abelian.Ext.mk₀ κ).comp z (zero_add n))
            (zero_add n) := (Abelian.Ext.mk₀_comp_mk₀_assoc _ _ _).symm
  rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hj with rfl | rfl
  · refine ⟨0, ?_⟩
    rw [pow_zero, one_smul, hinv 0 x, h0 ((Abelian.Ext.mk₀ κ).comp x (zero_add 0)),
      Abelian.Ext.comp_zero]
  · obtain ⟨k, hk⟩ := h1 ((Abelian.Ext.mk₀ κ).comp x (zero_add 1))
    refine ⟨k, ?_⟩
    rw [hinv 1 x, ← hcompn, hk, Abelian.Ext.comp_zero]

theorem wc_P1bar_open_qcqs : ∀ (F'' : Type u) [Field F''] (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))) (T : (wcP1Over F'').left.ProEt) (g : T ⟶ wcGeomPoint F'' (wcP1Over F'') hP), IsOpenImmersion g.left → CompactSpace T.left ∧ QuasiSeparatedSpace T.left :=
by
  intro F'' _ hP T g hg
  have hprop0 : IsProper (wcProjKStr F'' 1) := by
    letI := @MvPolynomial.gradedAlgebra (Fin (1+1)) F'' _
    letI : IsScalarTower F'' ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0)
        (MvPolynomial (Fin (1+1)) F'') :=
      IsScalarTower.of_algebraMap_eq (R := F'')
        (S := (MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0)
        (A := MvPolynomial (Fin (1+1)) F'') (fun r => rfl)
    haveI : Algebra.FiniteType ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0)
        (MvPolynomial (Fin (1+1)) F'') :=
      Algebra.FiniteType.of_restrictScalars_finiteType F'' _ _
    haveI : IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'')) :=
      inferInstance
    have hbij : Function.Bijective
        (algebraMap F'' ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0)) := by
      constructor
      · intro a b hab
        have h := congrArg (fun x : (MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0 =>
          (x : MvPolynomial (Fin (1+1)) F'')) hab
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq] at h
        exact MvPolynomial.C_injective _ _ h
      · intro x
        have hx : (x : MvPolynomial (Fin (1+1)) F'').IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule 0 _).mp x.2
        have ht : (x : MvPolynomial (Fin (1+1)) F'').totalDegree = 0 :=
          Nat.le_zero.mp hx.totalDegree_le
        refine ⟨(x : MvPolynomial (Fin (1+1)) F'').coeff 0, Subtype.ext ?_⟩
        simp only [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp ht).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap F'' ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0))) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      exact hbij
    show IsProper (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap F'' ((MvPolynomial.homogeneousSubmodule (Fin (1+1)) F'') 0))))
    infer_instance
  haveI hprop : IsProper (wcP1Over F'').hom := hprop0
  haveI hpropS : IsProper (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (IsPullback.of_hasPullback (wcP1Over F'').hom _) inferInstance
  haveI hlft : LocallyOfFiniteType (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := inferInstance
  have hqsep : QuasiSeparated (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := by
    haveI := hpropS; infer_instance
  have hqs : QuasiSeparatedSpace (wcGeomPoint F'' (wcP1Over F'') hP).left :=
    @quasiSeparatedSpace_of_quasiSeparated _ _ (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) inferInstance hqsep
  have hln : IsLocallyNoetherian (wcGeomPoint F'' (wcP1Over F'') hP).left :=
    @LocallyOfFiniteType.isLocallyNoetherian _ _ (Limits.pullback.snd (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hlft inferInstance
  have hT : CompactSpace T.left := by
    haveI hqc : QuasiCompact (Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) := by
      first
        | exact @instQuasiCompactOfUniversallyClosed _ _ _ hpropS.toUniversallyClosed
        | exact @instQuasiCompactOfUniversallyClosed _ _ _ inferInstance
        | (haveI := hpropS; infer_instance)
    haveI hcpt : CompactSpace (wcGeomPoint F'' (wcP1Over F'') hP).left :=
      @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.snd (wcP1Over F'').hom
        (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) hqc inferInstance
    haveI := hln
    haveI : AlgebraicGeometry.IsNoetherian (wcGeomPoint F'' (wcP1Over F'') hP).left :=
      AlgebraicGeometry.IsNoetherian.mk
    haveI := hg
    have hc : IsCompact (Set.range g.left) := TopologicalSpace.NoetherianSpace.isCompact _
    have hind := (Scheme.Hom.isOpenEmbedding g.left).isInducing
    rw [← Set.image_univ, ← hind.isCompact_iff] at hc
    exact isCompact_univ_iff.mp hc
  have hqsT : QuasiSeparatedSpace T.left := by
    haveI := hqs
    haveI := hg
    exact (Scheme.Hom.isOpenEmbedding g.left).quasiSeparatedSpace
  exact ⟨hT, hqsT⟩

theorem wc_lattice_coker_coh_torsion (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hzero : wcZeroAtS K m S G)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    (L : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) (ι : L ⟶ G)
    (hι : Mono ι)
    (hT3U : ∀ T : (wcP1Over K).left.ProEt, CompactSpace T.left →
      (∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K))) →
      ∀ s : G.obj.obj (Opposite.op T),
      ∃ (k : ℕ) (s' : L.obj.obj (Opposite.op T)),
        (ι.hom.app (Opposite.op T)).hom s' = ((σ ((ℓ : ℚ_[ℓ]) ^ k)).hom.app (Opposite.op T)).hom s) :
    wcCokerTorsion K hP ℓ ι :=
by
  classical

  have hcomp_nsmul : ∀ {A B C : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (a : Abelian.Ext A B 0) {n : ℕ} (b : Abelian.Ext B C n) (k : ℕ),
      a.comp (k • b) (zero_add n) = k • a.comp b (zero_add n) := by
    intro A B C a n b k
    induction k with
    | zero => simp [Abelian.Ext.comp_zero]
    | succ k ih => rw [succ_nsmul, succ_nsmul, Abelian.Ext.comp_add, ih]

  have hQZ : wcZeroAtS K m S (Limits.cokernel ι) := by
    intro i V A _ _ _ e hv y
    haveI : Projective (wcFreeSheaf (wcP1Over K).left V) :=
      wc_proet_free_projective_strict_local (wcP1Over K).left V A e
    have hψ := Projective.factorThru_comp (Abelian.Ext.homEquiv₀ y) (Limits.cokernel.π ι)
    have h0 := hzero i V A e hv
      (Abelian.Ext.mk₀ (Projective.factorThru (Abelian.Ext.homEquiv₀ y) (Limits.cokernel.π ι)))
    have hψ0 : Projective.factorThru (Abelian.Ext.homEquiv₀ y) (Limits.cokernel.π ι) = 0 := by
      apply Abelian.Ext.homEquiv₀.symm.injective
      rw [Abelian.Ext.homEquiv₀_symm_apply, Abelian.Ext.homEquiv₀_symm_apply, Abelian.Ext.mk₀_zero]
      exact h0
    rw [← Abelian.Ext.mk₀_homEquiv₀_apply y, ← hψ, hψ0, Limits.zero_comp, Abelian.Ext.mk₀_zero]

  have hsec := wc_coker_sections_torsion_offZ K ℓ m S G σ hσ1 hσadd L ι hT3U

  have hbase : ∀ T : (wcP1Over K).left.ProEt, CompactSpace T.left → QuasiSeparatedSpace T.left →
      (∀ (t : T.left) (i : Fin m), T.hom t ≠ S i (IsLocalRing.closedPoint K)) →
      ∀ j : ℕ, j ≤ 1 → ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left T) (Limits.cokernel ι) j,
        ∃ k : ℕ, (ℓ ^ k) • x = 0 := by
    intro T hc hq hav
    have H := @wc_proet_ext_le_one_torsion_of_qcqs_sections (wcP1Over K).left T hc hq
      (Limits.cokernel ι) ℓ
      (fun W b hW hW' q => hsec W hW hW' (by
        rintro w ⟨i, hi⟩
        have hw : W.hom w = S i (IsLocalRing.closedPoint K) := hi.symm
        apply hav (b.left w) i
        rw [← hw, ← MorphismProperty.Over.w b, Scheme.Hom.comp_apply]) q)
    intro j hj x
    interval_cases j
    · exact H.1 x
    · exact H.2 x

  have htor0 : ∀ V : (wcP1Over K).left.ProEt, CompactSpace V.left → QuasiSeparatedSpace V.left →
      (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
      ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left V) (Limits.cokernel ι) 0,
        ∃ k : ℕ, (ℓ ^ k) • y = 0 :=
    fun V hc hq hav y => hbase V hc hq hav 0 (Nat.zero_le _) y

  have hT'O : ∀ (O : (wcP1Over K).left.Opens) (T : (wcP1Over K).left.ProEt)
      (t' : (wcOpenRestr (wcP1Over K).left O T).left),
      (wcOpenRestr (wcP1Over K).left O T).hom t' ∈ (O : Set (wcP1Over K).left) := by
    intro O T t'
    have key : ∀ p : ↥(Limits.pullback O.ι T.hom),
        (Limits.pullback.snd O.ι T.hom ≫ T.hom) p ∈ (O : Set (wcP1Over K).left) := by
      intro p
      rw [← Limits.pullback.condition, Scheme.Hom.comp_apply, ← Scheme.Opens.range_ι O]
      exact Set.mem_range_self _
    exact key t'

  have hnotO : ∀ u0 : Spec (.of K) ⟶ (wcP1Over K).left,
      u0 (IsLocalRing.closedPoint K) ∉ (wcPunctOpen K u0 : Set (wcP1Over K).left) := by
    intro u0 h
    have h' : u0 (IsLocalRing.closedPoint K) ∈
        (closure {u0 (IsLocalRing.closedPoint K)})ᶜ := h
    exact h' (subset_closure (Set.mem_singleton _))

  let H : (wcP1Over K).left.ProEt → Finset (Fin m) := fun T =>
    Finset.univ.filter (fun i => ∃ t : T.left, T.hom t = S i (IsLocalRing.closedPoint K))
  have hmemH : ∀ (T : (wcP1Over K).left.ProEt) (i : Fin m),
      i ∈ H T ↔ ∃ t : T.left, T.hom t = S i (IsLocalRing.closedPoint K) := by
    intro T i
    simp only [H, Finset.mem_filter, Finset.mem_univ, true_and]
  have hcardlt : ∀ (T : (wcP1Over K).left.ProEt) (i0 : Fin m) (t0 : T.left),
      T.hom t0 = S i0 (IsLocalRing.closedPoint K) →
      (H (wcOpenRestr (wcP1Over K).left (wcPunctOpen K (S i0)) T)).card < (H T).card := by
    intro T i0 t0 ht0
    have hsub : H (wcOpenRestr (wcP1Over K).left (wcPunctOpen K (S i0)) T) ⊆ H T := by
      intro i hi
      rw [hmemH] at hi ⊢
      obtain ⟨t', ht'⟩ := hi
      refine ⟨(wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) T).left t', ?_⟩
      rw [← ht', ← MorphismProperty.Over.w
        (wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) T), Scheme.Hom.comp_apply]
    have hi0 : i0 ∈ H T := (hmemH T i0).mpr ⟨t0, ht0⟩
    have hi0' : i0 ∉ H (wcOpenRestr (wcP1Over K).left (wcPunctOpen K (S i0)) T) := by
      intro hi
      rw [hmemH] at hi
      obtain ⟨t', ht'⟩ := hi
      have h1 := hT'O (wcPunctOpen K (S i0)) T t'
      rw [ht'] at h1
      exact hnotO (S i0) h1
    exact Finset.card_lt_card ((Finset.ssubset_iff_of_subset hsub).mpr ⟨i0, hi0, hi0'⟩)

  have hoi : ∀ (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP),
      IsOpenImmersion g.left → ∀ O : (wcP1Over K).left.Opens,
      IsOpenImmersion (wcOpenRestrIncl (wcP1Over K).left O T ≫ g).left := by
    intro T g hg O
    have e : (wcOpenRestrIncl (wcP1Over K).left O T ≫ g).left =
        Limits.pullback.snd O.ι T.hom ≫ g.left := rfl
    rw [e]
    haveI := hg
    haveI hsnd : IsOpenImmersion (Limits.pullback.snd O.ι T.hom) := by
      first
        | infer_instance
        | exact MorphismProperty.pullback_snd (P := @IsOpenImmersion) _ _ inferInstance
    exact @IsOpenImmersion.comp _ _ _ _ _ hsnd hg

  have hstep : ∀ (T : (wcP1Over K).left.ProEt) (g : T ⟶ wcGeomPoint K (wcP1Over K) hP),
      IsOpenImmersion g.left → ∀ (i0 : Fin m) (t0 : T.left),
      T.hom t0 = S i0 (IsLocalRing.closedPoint K) → ∀ j : ℕ, j ≤ 1 →
      (∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left
        (wcOpenRestr (wcP1Over K).left (wcPunctOpen K (S i0)) T)) (Limits.cokernel ι) j,
          ∃ k : ℕ, (ℓ ^ k) • y = 0) →
      ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left T) (Limits.cokernel ι) j,
        ∃ k : ℕ, (ℓ ^ k) • y = 0 := by
    intro T g hg i0 t0 ht0 j hj IH'
    have hcok : ∀ y : Abelian.Ext (Limits.cokernel (wcFreeSheafMap (wcP1Over K).left
        (wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) T))) (Limits.cokernel ι) j,
        ∃ k : ℕ, (ℓ ^ k) • y = 0 := by
      intro y
      obtain ⟨κ, hκ, -⟩ := wc_P1bar_open_punct_excision K (S i0) (hS i0) hP T g hg ⟨t0, ht0⟩
      haveI := hκ
      obtain ⟨b, hb⟩ := wc_P1_punct_coker_ext_le_one_torsion K hP m S hS ℓ (Limits.cokernel ι)
        hQZ htor0 i0 j hj ((Abelian.Ext.mk₀ (inv κ)).comp y (zero_add j))
      refine ⟨b, ?_⟩
      have hy : y = (Abelian.Ext.mk₀ κ).comp ((Abelian.Ext.mk₀ (inv κ)).comp y (zero_add j))
          (zero_add j) := by
        rw [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
      rw [hy, ← hcomp_nsmul, hb, Abelian.Ext.comp_zero]
    have hmonoL : Mono (wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) T).left := by
      change Mono (Limits.pullback.snd (wcPunctOpen K (S i0)).ι T.hom)
      exact IsOpenImmersion.mono _
    have hmono := wc_free_sheaf_map_mono (wcP1Over K).left _ _
      (wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) T) hmonoL
    have hSE := ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel (wcFreeSheafMap
      (wcP1Over K).left (wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) T)))
      hmono inferInstance
    intro x
    obtain ⟨a, ha⟩ := IH' ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left
        (wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) T))).comp x (zero_add j))
    rw [← hcomp_nsmul] at ha
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₂ hSE (Limits.cokernel ι)
      ((ℓ ^ a) • x) ha
    obtain ⟨b, hb⟩ := hcok x₁
    refine ⟨b + a, ?_⟩
    rw [pow_add, ← smul_smul, ← hx₁, ← hcomp_nsmul, hb, Abelian.Ext.comp_zero]

  have claim : ∀ N : ℕ, ∀ (T : (wcP1Over K).left.ProEt)
      (g : T ⟶ wcGeomPoint K (wcP1Over K) hP), IsOpenImmersion g.left → (H T).card ≤ N →
      ∀ j : ℕ, j ≤ 1 → ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left T) (Limits.cokernel ι) j,
        ∃ k : ℕ, (ℓ ^ k) • y = 0 := by
    intro N
    induction N with
    | zero =>
      intro T g hg hcard j hj y
      obtain ⟨hc, hq⟩ := wc_P1bar_open_qcqs K hP T g hg
      refine hbase T hc hq ?_ j hj y
      intro t i hti
      have hmem : i ∈ H T := (hmemH T i).mpr ⟨t, hti⟩
      have := Finset.card_pos.mpr ⟨i, hmem⟩
      omega
    | succ N ih =>
      intro T g hg hcard j hj
      by_cases hav : ∀ (t : T.left) (i : Fin m), T.hom t ≠ S i (IsLocalRing.closedPoint K)
      · obtain ⟨hc, hq⟩ := wc_P1bar_open_qcqs K hP T g hg
        exact hbase T hc hq hav j hj
      push_neg at hav
      obtain ⟨t0, i0, ht0⟩ := hav
      apply hstep T g hg i0 t0 ht0 j hj
      refine ih _ (wcOpenRestrIncl (wcP1Over K).left (wcPunctOpen K (S i0)) T ≫ g)
        (hoi T g hg _) ?_ j hj
      have := hcardlt T i0 t0 ht0
      omega

  have hid : IsOpenImmersion (𝟙 (wcGeomPoint K (wcP1Over K) hP) : wcGeomPoint K (wcP1Over K) hP ⟶ _).left := by
    show IsOpenImmersion (𝟙 (wcGeomPoint K (wcP1Over K) hP).left)
    infer_instance
  have hcardm : (H (wcGeomPoint K (wcP1Over K) hP)).card ≤ m :=
    (Finset.card_le_univ _).trans (Fintype.card_fin m).le
  unfold wcCokerTorsion
  exact ⟨fun z => claim m _ (𝟙 _) hid hcardm 0 (Nat.zero_le _) z,
    fun z => claim m _ (𝟙 _) hid hcardm 1 le_rfl z⟩

theorem wc_padic_lattice_free_of_reductions (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {M : Type*}
    [AddCommGroup M] (act : ℤ_[ℓ] → (M →+ M)) (h1 : act 1 = AddMonoidHom.id M)
    (hadd : ∀ a b : ℤ_[ℓ], act (a + b) = act a + act b)
    (hmul : ∀ (a b : ℤ_[ℓ]) (x : M), act (a * b) x = act a (act b x))
    (r : ℕ)
    (hred : ∀ n : ℕ, 1 ≤ n → ∃ p : M →+ (Fin r → ZMod (ℓ ^ n)), Function.Surjective p ∧
      ∀ x, p x = 0 ↔ ∃ y, act ((ℓ : ℤ_[ℓ]) ^ n) y = x)
    (hsep : ∀ x : M, (∀ n : ℕ, ∃ y, act ((ℓ : ℤ_[ℓ]) ^ n) y = x) → x = 0) :
    ∃ β : M ≃+ (Fin r → ℤ_[ℓ]), ∀ (a : ℤ_[ℓ]) (x : M), β (act a x) = a • β x :=
by
  classical
  have hℓ : ℓ.Prime := Fact.out

  have hact0 : act 0 = 0 := by
    have h := hadd 0 0
    rw [add_zero] at h
    exact add_left_cancel (a := act 0) (by rw [add_zero]; exact h.symm)

  have hactnat : ∀ (k : ℕ) (x : M), act (k : ℤ_[ℓ]) x = k • x := by
    intro k x
    induction k with
    | zero => simp [hact0]
    | succ k ih =>
      rw [Nat.cast_succ, hadd, AddMonoidHom.add_apply, ih, h1, AddMonoidHom.id_apply, succ_nsmul]

  have hsemi : ∀ (n : ℕ) (p : M →+ (Fin r → ZMod (ℓ ^ n))),
      (∀ x, p x = 0 ↔ ∃ y, act ((ℓ : ℤ_[ℓ]) ^ n) y = x) →
      ∀ (a : ℤ_[ℓ]) (x : M), p (act a x) = PadicInt.toZModPow n a • p x := by
    intro n p hker a x
    have : NeZero (ℓ ^ n) := ⟨pow_ne_zero n hℓ.ne_zero⟩
    generalize ht : PadicInt.toZModPow n a = t
    have hmem : a - (t.val : ℤ_[ℓ]) ∈ RingHom.ker (PadicInt.toZModPow (p := ℓ) n) := by
      rw [RingHom.mem_ker, map_sub, ht, map_natCast, ZMod.natCast_zmod_val, sub_self]
    rw [PadicInt.ker_toZModPow, Ideal.mem_span_singleton'] at hmem
    obtain ⟨b, hb⟩ := hmem
    have ha : a = (t.val : ℤ_[ℓ]) + (ℓ : ℤ_[ℓ]) ^ n * b := by linear_combination -hb
    have hk : p (act ((ℓ : ℤ_[ℓ]) ^ n) (act b x)) = 0 := (hker _).mpr ⟨_, rfl⟩
    have e1 : act a x = t.val • x + act ((ℓ : ℤ_[ℓ]) ^ n) (act b x) := by
      rw [ha, hadd, AddMonoidHom.add_apply, hmul, hactnat]
    rw [e1, map_add, hk, add_zero, map_nsmul, ← Nat.cast_smul_eq_nsmul (ZMod (ℓ ^ n)),
      ZMod.natCast_zmod_val]

  obtain ⟨p₁, hp₁s, hp₁k⟩ := hred 1 le_rfl
  choose e he using fun i : Fin r => hp₁s (Pi.single i 1)
  let φ : (Fin r → ℤ_[ℓ]) →+ M :=
    { toFun := fun c => ∑ i, act (c i) (e i)
      map_zero' := by simp [hact0]
      map_add' := fun c c' => by
        simp only [Pi.add_apply, hadd, AddMonoidHom.add_apply, Finset.sum_add_distrib] }
  have hφ : ∀ c, φ c = ∑ i, act (c i) (e i) := fun c => rfl

  have hφsmul : ∀ (a : ℤ_[ℓ]) c, act a (φ c) = φ (a • c) := by
    intro a c
    rw [hφ, hφ, map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Pi.smul_apply, smul_eq_mul, hmul]

  have hform : ∀ (n : ℕ) (p : M →+ (Fin r → ZMod (ℓ ^ n))),
      (∀ x, p x = 0 ↔ ∃ y, act ((ℓ : ℤ_[ℓ]) ^ n) y = x) →
      ∀ c, p (φ c) = ∑ i, PadicInt.toZModPow n (c i) • p (e i) := by
    intro n p hker c
    rw [hφ, map_sum]
    exact Finset.sum_congr rfl (fun i _ => hsemi n p hker (c i) (e i))

  have happ1 : ∀ x : M, ∃ (c : Fin r → ℤ_[ℓ]) (y : M), x = φ c + act (ℓ : ℤ_[ℓ]) y := by
    intro x
    have : NeZero (ℓ ^ 1) := ⟨pow_ne_zero 1 hℓ.ne_zero⟩
    refine ⟨fun i => ((p₁ x i).val : ℤ_[ℓ]), ?_⟩
    have hz : p₁ (x - φ (fun i => ((p₁ x i).val : ℤ_[ℓ]))) = 0 := by
      rw [map_sub, hform 1 p₁ hp₁k, sub_eq_zero]
      simp only [map_natCast, ZMod.natCast_zmod_val, he]
      ext j
      simp [Finset.sum_apply, Pi.single_apply]
    obtain ⟨y, hy⟩ := (hp₁k _).mp hz
    refine ⟨y, ?_⟩
    rw [pow_one] at hy
    rw [hy]
    abel

  have happ : ∀ (n : ℕ) (x : M), ∃ (c : Fin r → ℤ_[ℓ]) (y : M),
      x = φ c + act ((ℓ : ℤ_[ℓ]) ^ n) y := by
    intro n
    induction n with
    | zero =>
      intro x
      exact ⟨0, x, by rw [map_zero, zero_add, pow_zero, h1, AddMonoidHom.id_apply]⟩
    | succ n ih =>
      intro x
      obtain ⟨c, y, hxy⟩ := ih x
      obtain ⟨c', y', hy⟩ := happ1 y
      refine ⟨c + (ℓ : ℤ_[ℓ]) ^ n • c', y', ?_⟩
      rw [hxy, hy, map_add (act _), hφsmul, ← hmul, ← pow_succ, map_add φ]
      abel

  have hkey : ∀ (n : ℕ) (c : Fin r → ℤ_[ℓ]), (∃ y, act ((ℓ : ℤ_[ℓ]) ^ n) y = φ c) →
      ∀ i, PadicInt.toZModPow n (c i) = 0 := by
    intro n c hc i
    rcases Nat.eq_zero_or_pos n with hn0 | hn
    · subst hn0
      have : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
      exact Subsingleton.elim _ _
    obtain ⟨p, hps, hpk⟩ := hred n hn
    have : NeZero (ℓ ^ n) := ⟨pow_ne_zero n hℓ.ne_zero⟩
    have hsurj : Function.Surjective
        (fun v : Fin r → ZMod (ℓ ^ n) => ∑ i, v i • p (e i)) := by
      intro w
      obtain ⟨x, rfl⟩ := hps w
      obtain ⟨c', y, hxy⟩ := happ n x
      refine ⟨fun i => PadicInt.toZModPow n (c' i), ?_⟩
      have hk : p (act ((ℓ : ℤ_[ℓ]) ^ n) y) = 0 := (hpk _).mpr ⟨y, rfl⟩
      rw [hxy, map_add, hk, add_zero, hform n p hpk]
    have hinj := Finite.injective_iff_surjective.mpr hsurj
    have h0 : (fun v : Fin r → ZMod (ℓ ^ n) => ∑ i, v i • p (e i))
          (fun i => PadicInt.toZModPow n (c i)) =
        (fun v : Fin r → ZMod (ℓ ^ n) => ∑ i, v i • p (e i)) 0 := by
      simp only [Pi.zero_apply, zero_smul, Finset.sum_const_zero]
      rw [← hform n p hpk c]
      exact (hpk _).mpr hc
    have := congrFun (hinj h0) i
    simpa using this

  have hφinj : Function.Injective φ := by
    rw [injective_iff_map_eq_zero]
    intro c hc
    funext i
    apply PadicInt.ext_of_toZModPow.mp
    intro n
    rw [hkey n c ⟨0, by rw [map_zero, hc]⟩ i, Pi.zero_apply, map_zero]

  have hφsurj : Function.Surjective φ := by
    intro x
    choose c y hxy using fun n => happ n x
    have hcomp : ∀ m n : ℕ, m ≤ n → ∀ i,
        PadicInt.toZModPow m (c n i) = PadicInt.toZModPow m (c m i) := by
      intro m n hmn i
      have hd : ∃ w, act ((ℓ : ℤ_[ℓ]) ^ m) w = φ (c n - c m) := by
        refine ⟨y m - act ((ℓ : ℤ_[ℓ]) ^ (n - m)) (y n), ?_⟩
        rw [map_sub (act _), ← hmul, ← pow_add, Nat.add_sub_cancel' hmn, map_sub φ,
          eq_sub_of_add_eq (hxy n).symm, eq_sub_of_add_eq (hxy m).symm]
        abel
      have := hkey m (c n - c m) hd i
      rwa [Pi.sub_apply, map_sub, sub_eq_zero] at this
    have hI : ∀ m : ℕ, ((IsLocalRing.maximalIdeal ℤ_[ℓ]) ^ m • ⊤ : Submodule ℤ_[ℓ] ℤ_[ℓ]) =
        RingHom.ker (PadicInt.toZModPow (p := ℓ) m) := by
      intro m
      rw [Ideal.smul_eq_mul, Ideal.mul_top, PadicInt.maximalIdeal_eq_span_p,
        Ideal.span_singleton_pow, PadicInt.ker_toZModPow]
    have hlim : ∀ i, ∃ L : ℤ_[ℓ], ∀ n,
        PadicInt.toZModPow n L = PadicInt.toZModPow n (c n i) := by
      intro i
      have hpc : IsPrecomplete (IsLocalRing.maximalIdeal ℤ_[ℓ]) ℤ_[ℓ] := inferInstance
      obtain ⟨L, hL⟩ := IsPrecomplete.prec hpc (f := fun n => c n i) (fun {m n} hmn => by
          rw [SModEq.sub_mem, hI, RingHom.mem_ker, map_sub, sub_eq_zero]
          exact (hcomp m n hmn i).symm)
      refine ⟨L, fun n => ?_⟩
      have := hL n
      rw [SModEq.sub_mem, hI, RingHom.mem_ker, map_sub, sub_eq_zero] at this
      exact this.symm
    choose L hL using hlim
    refine ⟨L, ?_⟩
    have hsub : x - φ L = 0 := by
      apply hsep
      intro n
      rcases Nat.eq_zero_or_pos n with hn0 | hn
      · subst hn0
        exact ⟨x - φ L, by rw [pow_zero, h1, AddMonoidHom.id_apply]⟩
      obtain ⟨p, hps, hpk⟩ := hred n hn
      apply (hpk _).mp
      have hk : p (act ((ℓ : ℤ_[ℓ]) ^ n) (y n)) = 0 := (hpk _).mpr ⟨y n, rfl⟩
      rw [map_sub, hxy n, map_add, hk, add_zero, hform n p hpk, hform n p hpk, sub_eq_zero]
      exact Finset.sum_congr rfl (fun i _ => by rw [hL i n])
    exact (sub_eq_zero.mp hsub).symm

  let β0 := AddEquiv.ofBijective φ ⟨hφinj, hφsurj⟩
  have hβ : ∀ z, β0 z = φ z := fun z => rfl
  refine ⟨β0.symm, fun a x => ?_⟩
  apply β0.injective
  rw [AddEquiv.apply_symm_apply, hβ, ← hφsmul, ← hβ, AddEquiv.apply_symm_apply]

theorem wc_lattice_trace_mod_reduction (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {M : Type*} [AddCommGroup M]
    (act : ℤ_[ℓ] → (M →+ M)) (r n : ℕ) (β : M ≃+ (Fin r → ℤ_[ℓ]))
    (hβ : ∀ (a : ℤ_[ℓ]) (x : M), β (act a x) = a • β x)
    (F : M →+ M) (hF : ∀ (a : ℤ_[ℓ]) (x : M), F (act a x) = act a (F x))
    (p : M →+ (Fin r → ZMod (ℓ ^ n))) (hp : Function.Surjective p)
    (hker : ∀ x, p x = 0 ↔ ∃ y, act ((ℓ : ℤ_[ℓ]) ^ n) y = x)
    (k : ℕ) (Rm : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))
    (hR : ∀ x, p ((⇑F)^[k] x) = Matrix.vecMul (p x) Rm) :
    PadicInt.toZModPow n ((wcAddEquivMatrix β F) ^ k).trace = Rm.trace :=
by
  classical
  set red : ℤ_[ℓ] →+* ZMod (ℓ ^ n) := PadicInt.toZModPow n with hred
  set B := wcAddEquivMatrix β F with hBdef

  have hes : ∀ (c : ℤ_[ℓ]) (v : Fin r → ℤ_[ℓ]), β.symm (c • v) = act c (β.symm v) := fun c v =>
    β.injective (by rw [hβ, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  let L : (Fin r → ℤ_[ℓ]) →ₗ[ℤ_[ℓ]] (Fin r → ℤ_[ℓ]) :=
    { toFun := fun v => β (F (β.symm v))
      map_add' := fun v w => by simp only [map_add]
      map_smul' := fun c v => by simp only [hes, hF, hβ, RingHom.id_apply] }
  have hA : B = LinearMap.toMatrix' L := by
    ext a b
    rw [LinearMap.toMatrix'_apply]
    rfl
  have hAk : ∀ (j : ℕ) (v : Fin r → ℤ_[ℓ]), (B ^ j).mulVec v = β ((⇑F)^[j] (β.symm v)) := by
    intro j
    induction j with
    | zero => intro v; simp
    | succ j ih =>
      intro v
      rw [pow_succ', ← Matrix.mulVec_mulVec, ih, hA, LinearMap.toMatrix'_mulVec]
      show β (F (β.symm (β ((⇑F)^[j] (β.symm v))))) = _
      rw [AddEquiv.symm_apply_apply, Function.iterate_succ_apply']

  have hkill : ∀ w : Fin r → ℤ_[ℓ], p (β.symm (((ℓ : ℤ_[ℓ]) ^ n) • w)) = 0 := by
    intro w
    rw [hes]
    exact (hker _).mpr ⟨β.symm w, rfl⟩
  have hl : ((ℓ : ZMod (ℓ ^ n))) ^ n = 0 := by
    rw [← Nat.cast_pow, ZMod.natCast_self]
  have hsemi : ∀ (a : ℤ_[ℓ]) (v : Fin r → ℤ_[ℓ]),
      p (β.symm (a • v)) = red a • p (β.symm v) := by
    intro a v
    have hspec := PadicInt.appr_spec n a
    generalize a.appr n = N at hspec
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hspec
    have ha : a = (N : ℤ_[ℓ]) + ((ℓ : ℤ_[ℓ]) ^ n) * c := by linear_combination -hc
    subst ha
    have e1 : β.symm (((N : ℤ_[ℓ]) + (ℓ : ℤ_[ℓ]) ^ n * c) • v)
        = N • β.symm v + β.symm (((ℓ : ℤ_[ℓ]) ^ n) • (c • v)) := by
      rw [add_smul, mul_smul, map_add, Nat.cast_smul_eq_nsmul, map_nsmul]
    have e2 : red ((N : ℤ_[ℓ]) + (ℓ : ℤ_[ℓ]) ^ n * c) = (N : ZMod (ℓ ^ n)) := by
      rw [map_add, map_mul, map_pow, map_natCast, map_natCast, hl, zero_mul, add_zero]
    rw [e1, map_add, hkill, add_zero, map_nsmul, e2, Nat.cast_smul_eq_nsmul]
  set U : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)) :=
    Matrix.of fun i j => p (β.symm (Pi.single i 1)) j with hU
  have hcoord : ∀ u : Fin r → ℤ_[ℓ], p (β.symm u) = Matrix.vecMul (fun i => red (u i)) U := by
    intro u
    conv_lhs => rw [← Finset.univ_sum_single u]
    rw [map_sum, map_sum]
    have hsi : ∀ i, p (β.symm (Pi.single i (u i))) = red (u i) • p (β.symm (Pi.single i 1)) := by
      intro i
      rw [← hsemi]
      congr 2
      ext t
      simp [Pi.single_apply]
    simp_rw [hsi]
    ext j
    simp [Matrix.vecMul, dotProduct, Finset.sum_apply, hU]

  have hUsurj : ∀ y : Fin r → ZMod (ℓ ^ n), ∃ w, Matrix.vecMul w U = y := by
    intro y
    obtain ⟨x, rfl⟩ := hp y
    exact ⟨fun i => red (β x i), by rw [← hcoord, AddEquiv.symm_apply_apply]⟩
  choose w hw using fun i : Fin r => hUsurj (Pi.single i 1)
  set W : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)) := Matrix.of w with hW
  have hWU : W * U = 1 := by
    ext i j
    have h1 := congrFun (hw i) j
    simp only [Matrix.vecMul, dotProduct] at h1
    rw [Matrix.mul_apply, Matrix.one_apply]
    simp only [hW, Matrix.of_apply]
    rw [h1, Pi.single_apply]
    by_cases h : i = j
    · subst h; simp
    · simp [h, Ne.symm h]
  have hUW : U * W = 1 := mul_eq_one_comm.mp hWU

  have hint : ((B ^ k).map red).transpose * U = U * Rm := by
    ext i j
    have h1 : p ((⇑F)^[k] (β.symm (Pi.single i 1)))
        = Matrix.vecMul (fun t => red ((B ^ k) t i)) U := by
      rw [← AddEquiv.symm_apply_apply β ((⇑F)^[k] (β.symm (Pi.single i 1))), ← hAk, hcoord]
      congr 1
      funext t
      simp [Matrix.mulVec, dotProduct, Pi.single_apply]
    have h2 := congrFun (hR (β.symm (Pi.single i 1))) j
    rw [h1] at h2
    simp only [Matrix.vecMul, dotProduct] at h2
    rw [Matrix.mul_apply, Matrix.mul_apply]
    simp only [Matrix.transpose_apply, Matrix.map_apply]
    rw [h2]
    simp [hU]
  have htr : ((B ^ k).map red).trace = Rm.trace := by
    have hRm : Rm = W * (((B ^ k).map red).transpose * U) := by
      rw [hint, ← Matrix.mul_assoc, hWU, Matrix.one_mul]
    rw [hRm, Matrix.trace_mul_comm, Matrix.mul_assoc, hUW, Matrix.mul_one, Matrix.trace_transpose]
  rw [← htr]
  simp only [Matrix.trace, map_sum]
  rfl

theorem wc_lattice_rational_trace_eq (ℓ : ℕ) [Fact (Nat.Prime ℓ)] {M W : Type*} [AddCommGroup M]
    [AddCommGroup W] (act : ℤ_[ℓ] → (M →+ M)) (r R : ℕ) (β : M ≃+ (Fin r → ℤ_[ℓ]))
    (hβ : ∀ (a : ℤ_[ℓ]) (x : M), β (act a x) = a • β x)
    (F : M →+ M) (hF : ∀ (a : ℤ_[ℓ]) (x : M), F (act a x) = act a (F x))
    (b : W ≃+ (Fin R → ℚ_[ℓ])) (s : ℚ_[ℓ] → (W →+ W))
    (hb : ∀ (c : ℚ_[ℓ]) (w : W), b (s c w) = c • b w)
    (j : M →+ W) (hj : Function.Injective j)
    (hjs : ∀ (a : ℤ_[ℓ]) (x : M), j (act a x) = s (a : ℚ_[ℓ]) (j x))
    (hden : ∀ w : W, ∃ (k : ℕ) (x : M), j x = s ((ℓ : ℚ_[ℓ]) ^ k) w)
    (Φ : W →+ W) (hΦ : ∀ x : M, Φ (j x) = j (F x)) :
    ∀ k : ℕ, ((wcAddEquivMatrix b Φ) ^ k).trace =
      ((((wcAddEquivMatrix β F) ^ k).trace : ℤ_[ℓ]) : ℚ_[ℓ]) :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out
  have hℓ0 : (ℓ : ℚ_[ℓ]) ≠ 0 := by exact_mod_cast hℓp.ne_zero

  have hN : ∀ (n : ℕ) (w : W), s (n : ℚ_[ℓ]) w = n • w := by
    intro n w
    apply b.injective
    rw [hb, map_nsmul, Nat.cast_smul_eq_nsmul]
  have hS : ∀ (c c' : ℚ_[ℓ]) (w : W), s (c * c') w = s c (s c' w) := by
    intro c c' w
    apply b.injective
    rw [hb, hb, hb, mul_smul]
  have hT : ∀ (n : ℕ), n ≠ 0 → ∀ w w' : W, n • w = n • w' → w = w' := by
    intro n hn w w' h
    apply b.injective
    have h1 : (n : ℚ_[ℓ]) • (b w - b w') = 0 := by
      rw [smul_sub, Nat.cast_smul_eq_nsmul, Nat.cast_smul_eq_nsmul, ← map_nsmul b n w,
        ← map_nsmul b n w', h, sub_self]
    rcases smul_eq_zero.mp h1 with h2 | h2
    · exact absurd h2 (by exact_mod_cast hn)
    · exact sub_eq_zero.mp h2

  have hclr : ∀ c : ℚ_[ℓ], ∃ (K : ℕ) (a : ℤ_[ℓ]), (a : ℚ_[ℓ]) = (ℓ : ℚ_[ℓ]) ^ K * c := by
    intro c
    have h1 : (1 : ℝ) < ℓ := by exact_mod_cast hℓp.one_lt
    obtain ⟨K, hK⟩ := pow_unbounded_of_one_lt ‖c‖ h1
    refine ⟨K, ⟨(ℓ : ℚ_[ℓ]) ^ K * c, ?_⟩, rfl⟩
    have hp : (0 : ℝ) < (ℓ : ℝ) ^ K := by positivity
    rw [norm_mul, norm_pow, Padic.norm_p]
    calc ((ℓ : ℝ)⁻¹) ^ K * ‖c‖ = ‖c‖ / (ℓ : ℝ) ^ K := by rw [inv_pow]; ring
      _ ≤ 1 := by rw [div_le_one hp]; exact hK.le

  have hKey : ∀ (c : ℚ_[ℓ]) (w : W), Φ (s c w) = s c (Φ w) := by
    intro c w
    obtain ⟨k, x, hx⟩ := hden w
    obtain ⟨K, a, ha⟩ := hclr c
    have hn : ℓ ^ (k + K) ≠ 0 := pow_ne_zero _ hℓp.ne_zero
    have hsc : ((ℓ ^ (k + K) : ℕ) : ℚ_[ℓ]) * c = (a : ℚ_[ℓ]) * (ℓ : ℚ_[ℓ]) ^ k := by
      rw [ha]; push_cast; ring
    have hpow : ∀ v : W, s ((ℓ : ℚ_[ℓ]) ^ k) v = (ℓ ^ k) • v := by
      intro v; rw [← hN, Nat.cast_pow]
    apply hT _ hn
    calc (ℓ ^ (k + K)) • Φ (s c w) = Φ (s ((ℓ ^ (k + K) : ℕ) : ℚ_[ℓ]) (s c w)) := by
          rw [hN, map_nsmul]
      _ = Φ (s (a : ℚ_[ℓ]) (s ((ℓ : ℚ_[ℓ]) ^ k) w)) := by rw [← hS, ← hS, hsc]
      _ = Φ (s (a : ℚ_[ℓ]) (j x)) := by rw [hx]
      _ = j (act a (F x)) := by rw [← hjs, hΦ, hF]
      _ = s (a : ℚ_[ℓ]) (Φ (j x)) := by rw [hjs, hΦ]
      _ = s (a : ℚ_[ℓ]) (s ((ℓ : ℚ_[ℓ]) ^ k) (Φ w)) := by rw [hx, hpow, hpow, map_nsmul]
      _ = s ((ℓ ^ (k + K) : ℕ) : ℚ_[ℓ]) (s c (Φ w)) := by rw [← hS, ← hS, hsc]
      _ = (ℓ ^ (k + K)) • s c (Φ w) := by rw [hN]

  have hes : ∀ (c : ℚ_[ℓ]) (y : Fin R → ℚ_[ℓ]), b.symm (c • y) = s c (b.symm y) := fun c y =>
    b.injective (by rw [hb, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  let LA : (Fin R → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin R → ℚ_[ℓ]) :=
    { toFun := fun y => b (Φ (b.symm y))
      map_add' := fun v w => by simp only [map_add]
      map_smul' := fun c v => by simp only [hes, hKey, hb, RingHom.id_apply] }
  have hA : wcAddEquivMatrix b Φ = LinearMap.toMatrix' LA := by
    ext a c
    rw [LinearMap.toMatrix'_apply]
    rfl
  have hesβ : ∀ (a : ℤ_[ℓ]) (u : Fin r → ℤ_[ℓ]), β.symm (a • u) = act a (β.symm u) :=
    fun a u => β.injective (by rw [hβ, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  let LB : (Fin r → ℤ_[ℓ]) →ₗ[ℤ_[ℓ]] (Fin r → ℤ_[ℓ]) :=
    { toFun := fun u => β (F (β.symm u))
      map_add' := fun v w => by simp only [map_add]
      map_smul' := fun c v => by simp only [hesβ, hF, hβ, RingHom.id_apply] }
  have hB : wcAddEquivMatrix β F = LinearMap.toMatrix' LB := by
    ext a c
    rw [LinearMap.toMatrix'_apply]
    rfl

  set P : Matrix (Fin R) (Fin r) ℚ_[ℓ] :=
    Matrix.of fun a i => b (j (β.symm (Pi.single i 1))) a with hPdef
  have hP : ∀ u : Fin r → ℤ_[ℓ],
      b (j (β.symm u)) = P.mulVec (fun i => ((u i : ℤ_[ℓ]) : ℚ_[ℓ])) := by
    intro u
    have hu : u = ∑ i, u i • (Pi.single i (1 : ℤ_[ℓ]) : Fin r → ℤ_[ℓ]) := by
      ext t
      simp [Pi.single_apply]
    conv_lhs => rw [hu]
    rw [map_sum, map_sum, map_sum]
    ext a
    simp only [hesβ, hjs, hb, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Matrix.mulVec,
      dotProduct, hPdef, Matrix.of_apply]
    exact Finset.sum_congr rfl (fun i _ => mul_comm _ _)
  have hinj : ∀ v : Fin r → ℚ_[ℓ], P.mulVec v = 0 → v = 0 := by
    intro v hv
    choose K a ha using fun i => hclr (v i)
    obtain ⟨u, hu⟩ : ∃ u : Fin r → ℤ_[ℓ],
        (fun i => ((u i : ℤ_[ℓ]) : ℚ_[ℓ])) = (ℓ : ℚ_[ℓ]) ^ (∑ i, K i) • v := by
      refine ⟨fun i => (ℓ : ℤ_[ℓ]) ^ ((∑ i, K i) - K i) * a i, ?_⟩
      ext i
      have hKi : K i ≤ ∑ i, K i :=
        Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ i)
      simp only [PadicInt.coe_mul, PadicInt.coe_pow, PadicInt.coe_natCast, ha, Pi.smul_apply,
        smul_eq_mul]
      rw [← mul_assoc, ← pow_add, Nat.sub_add_cancel hKi]
    have h0 : b (j (β.symm u)) = 0 := by
      rw [hP, hu, Matrix.mulVec_smul, hv, smul_zero]
    have h1 : β.symm u = 0 :=
      hj (by rw [map_zero]; exact b.injective (by rw [h0, map_zero]))
    have h2 : u = 0 := by
      have := congrArg β h1
      rwa [AddEquiv.apply_symm_apply, map_zero] at this
    rw [h2] at hu
    ext i
    have h3 := congrFun hu i
    simp only [Pi.zero_apply, PadicInt.coe_zero, Pi.smul_apply, smul_eq_mul] at h3
    exact (mul_eq_zero.mp h3.symm).resolve_left (pow_ne_zero _ hℓ0)
  have hsurj : ∀ y : Fin R → ℚ_[ℓ], ∃ v, P.mulVec v = y := by
    intro y
    obtain ⟨k, x, hx⟩ := hden (b.symm y)
    refine ⟨((ℓ : ℚ_[ℓ]) ^ k)⁻¹ • (fun i => ((β x i : ℤ_[ℓ]) : ℚ_[ℓ])), ?_⟩
    have h1 := hP (β x)
    rw [AddEquiv.symm_apply_apply, hx, hb, AddEquiv.apply_symm_apply] at h1
    rw [Matrix.mulVec_smul, ← h1, inv_smul_smul₀ (pow_ne_zero _ hℓ0)]
  have hbij : Function.Bijective (Matrix.toLin' P) := by
    constructor
    · intro v w hvw
      rw [Matrix.toLin'_apply, Matrix.toLin'_apply] at hvw
      have := hinj (v - w) (by rw [Matrix.mulVec_sub, hvw, sub_self])
      exact sub_eq_zero.mp this
    · intro y
      obtain ⟨v, hv⟩ := hsurj y
      exact ⟨v, by rw [Matrix.toLin'_apply]; exact hv⟩
  obtain ⟨E, hE⟩ : ∃ E : (Fin r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin R → ℚ_[ℓ]), ∀ v, E v = P.mulVec v :=
    ⟨LinearEquiv.ofBijective (Matrix.toLin' P) hbij, fun v => Matrix.toLin'_apply P v⟩
  obtain ⟨P', hP'v⟩ : ∃ P' : Matrix (Fin r) (Fin R) ℚ_[ℓ], ∀ y, P'.mulVec y = E.symm y :=
    ⟨LinearMap.toMatrix' E.symm.toLinearMap, fun y => LinearMap.toMatrix'_mulVec _ _⟩
  have h2 : P * P' = 1 := by
    apply Matrix.toLin'.injective
    apply LinearMap.ext
    intro y
    rw [Matrix.toLin'_one, Matrix.toLin'_apply, ← Matrix.mulVec_mulVec, hP'v, ← hE,
      LinearEquiv.apply_symm_apply, LinearMap.id_apply]
  have h1 : P' * P = 1 := by
    apply Matrix.toLin'.injective
    apply LinearMap.ext
    intro v
    rw [Matrix.toLin'_one, Matrix.toLin'_apply, ← Matrix.mulVec_mulVec, ← hE, hP'v,
      LinearEquiv.symm_apply_apply, LinearMap.id_apply]

  have hvec : ∀ u : Fin r → ℤ_[ℓ],
      (wcAddEquivMatrix b Φ * P).mulVec (fun i => ((u i : ℤ_[ℓ]) : ℚ_[ℓ])) =
        (P * (wcAddEquivMatrix β F).map (PadicInt.Coe.ringHom (p := ℓ))).mulVec
          (fun i => ((u i : ℤ_[ℓ]) : ℚ_[ℓ])) := by
    intro u
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, ← hP, hA, LinearMap.toMatrix'_mulVec]
    show b (Φ (b.symm (b (j (β.symm u))))) = _
    rw [AddEquiv.symm_apply_apply, hΦ]
    have e1 : ((wcAddEquivMatrix β F).map (PadicInt.Coe.ringHom (p := ℓ))).mulVec
        (fun i => ((u i : ℤ_[ℓ]) : ℚ_[ℓ])) =
          fun i => ((β (F (β.symm u)) i : ℤ_[ℓ]) : ℚ_[ℓ]) := by
      funext i
      rw [show β (F (β.symm u)) = (wcAddEquivMatrix β F).mulVec u by
        rw [hB, LinearMap.toMatrix'_mulVec]; rfl]
      exact (RingHom.map_mulVec (PadicInt.Coe.ringHom (p := ℓ)) (wcAddEquivMatrix β F) u i).symm
    rw [e1, ← hP, AddEquiv.symm_apply_apply]
  have hsingle : ∀ i : Fin r,
      (fun t => (((Pi.single i (1 : ℤ_[ℓ]) : Fin r → ℤ_[ℓ]) t : ℤ_[ℓ]) : ℚ_[ℓ])) =
        (Pi.single i (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ]) := by
    intro i
    funext t
    rw [Pi.single_apply, Pi.single_apply]
    split_ifs <;> simp
  have hext : ∀ (X : Matrix (Fin R) (Fin r) ℚ_[ℓ]) (a : Fin R) (i : Fin r),
      (X.mulVec (Pi.single i (1 : ℚ_[ℓ]) : Fin r → ℚ_[ℓ])) a = X a i := by
    intro X a i
    simp [Matrix.mulVec, dotProduct, Pi.single_apply]
  have hAP : wcAddEquivMatrix b Φ * P =
      P * (wcAddEquivMatrix β F).map (PadicInt.Coe.ringHom (p := ℓ)) := by
    ext a i
    have h := hvec (Pi.single i 1)
    rw [hsingle] at h
    rw [← hext (wcAddEquivMatrix b Φ * P), ← hext (P * _), h]
  have hpowP : ∀ k : ℕ, (wcAddEquivMatrix b Φ) ^ k * P =
      P * ((wcAddEquivMatrix β F).map (PadicInt.Coe.ringHom (p := ℓ))) ^ k := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [pow_succ, pow_succ, Matrix.mul_assoc, hAP, ← Matrix.mul_assoc, ih, Matrix.mul_assoc]
  intro k
  calc ((wcAddEquivMatrix b Φ) ^ k).trace
      = ((wcAddEquivMatrix b Φ) ^ k * (P * P')).trace := by rw [h2, Matrix.mul_one]
    _ = (P * (((wcAddEquivMatrix β F).map (PadicInt.Coe.ringHom (p := ℓ))) ^ k * P')).trace := by
        rw [← Matrix.mul_assoc, hpowP, Matrix.mul_assoc]
    _ = ((((wcAddEquivMatrix β F).map (PadicInt.Coe.ringHom (p := ℓ))) ^ k * P') * P).trace :=
        Matrix.trace_mul_comm _ _
    _ = (((wcAddEquivMatrix β F).map (PadicInt.Coe.ringHom (p := ℓ))) ^ k).trace := by
        rw [Matrix.mul_assoc, h1, Matrix.mul_one]
    _ = ((((wcAddEquivMatrix β F) ^ k).trace : ℤ_[ℓ]) : ℚ_[ℓ]) := by
        rw [← Matrix.map_pow]
        exact (AddMonoidHom.map_trace (PadicInt.Coe.ringHom (p := ℓ)).toAddMonoidHom _).symm

theorem wc_twsh_sections_strict_local_free (K : Type u) [Field K] [Finite K] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ] (α : Γ →* Aut V)
    (hG : wcGalCover q' Γ α) (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (ℓ n r : ℕ) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (hn : 1 ≤ n)
    (d : ℕ) (x : (wcP1Over K).left) (hx : x ∈ wcOffS K m S d) (N : wcFrobNbhd K x d) :
    Nonempty ((wcTwSh (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
      Γ α hα ℓ n r ρ).obj.obj (Opposite.op N.V) ≃+ (Fin r → ZMod (ℓ ^ n))) :=
by
  classical
  letI := N.ringA
  haveI := N.hensA
  haveI := N.sepA

  have hbijGen : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)] (W : (wcP1Over K).left.ProEt)
      (e : W.left ≅ Spec (.of A)) (P : ((wcP1Over K).left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      Function.Bijective
        ((toSheafify (Scheme.ProEt.topology (wcP1Over K).left) P).app (Opposite.op W)).hom := by
    intro A _ _ _ W e
    have hid : ∀ (S : Scheme.{u}) (V : S.ProEt), Nonempty (V.left ≅ Spec (.of A)) →
        ∀ T : Sieve V, T ∈ Scheme.ProEt.topology S V → T.arrows (𝟙 V) := by
      intro S
      have s6 : ∀ (R E : Type u) [CommRing R] [CommRing E] [Algebra R E],
          WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R E))) →
            Algebra.WeaklyEtale R E := by
        intro R E _ _ _ hW
        have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R E))) := hW.flat
        have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R E)))) :=
          hW.flat_diagonal
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
          RingHom.flat_algebraMap_iff] at hf
        rw [diagonal_SpecMap] at hd
        have hd' : Flat (Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.lmul' R (S := E)).toRingHom)) := by
          have heq : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) =
              (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) ≫
                (pullbackSpecIso R E E).inv) ≫ (pullbackSpecIso R E E).hom := by
            rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
          rw [heq]
          infer_instance
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hd'
        exact ⟨hf, hd'⟩
      have s7 : ∀ (E : Type u) [CommRing E] [Algebra A E],
          Algebra.WeaklyEtale A E → ∀ (p : Ideal E) [p.IsPrime],
          p.comap (algebraMap A E) = IsLocalRing.maximalIdeal A → Nonempty (E →ₐ[A] A) := by
        intro E _ _ hAE p _ hp
        haveI : Algebra.WeaklyEtale E (Localization.AtPrime p) :=
          wc_localization_weaklyEtale E (Localization.AtPrime p) p.primeCompl
        haveI := hAE
        haveI : Algebra.WeaklyEtale A (Localization.AtPrime p) := Algebra.WeaklyEtale.trans A E _
        have hloc : IsLocalHom (algebraMap A (Localization.AtPrime p)) := by
          have h1 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
              (algebraMap A (Localization.AtPrime p)) = IsLocalRing.maximalIdeal A := by
            rw [IsScalarTower.algebraMap_eq A E (Localization.AtPrime p), ← Ideal.comap_comap]
            have h2 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
                (algebraMap E (Localization.AtPrime p)) = p :=
              Localization.AtPrime.under_maximalIdeal
            rw [h2, hp]
          exact ((IsLocalRing.local_hom_TFAE (algebraMap A (Localization.AtPrime p))).out 1 5).mpr h1
        have hbij := wc_olivier A (Localization.AtPrime p) inferInstance inferInstance hloc
          inferInstance
        let eqv : A ≃ₐ[A] Localization.AtPrime p := AlgEquiv.ofBijective (Algebra.ofId A _) hbij
        exact ⟨eqv.symm.toAlgHom.comp (IsScalarTower.toAlgHom A E (Localization.AtPrime p))⟩
      have s5 : ∀ {U V : Scheme.{u}} (e : U ≅ Spec (.of A)) (g : V ⟶ U) [WeaklyEtale g] (v : V),
          e.hom (g v) = IsLocalRing.closedPoint A → ∃ σ : U ⟶ V, σ ≫ g = 𝟙 U := by
        intro U V e g _ v hv
        obtain ⟨E, ι, hι, hvι, -⟩ :=
          Scheme.exists_affine_mem_range_and_range_subset (U := (⊤ : V.Opens)) (x := v) trivial
        obtain ⟨w, hw⟩ := hvι
        have := hι
        let h : Spec E ⟶ Spec (.of A) := ι ≫ g ≫ e.hom
        have hWh : WeaklyEtale h := inferInstance
        let φ : CommRingCat.of A ⟶ E := Spec.preimage h
        have hφ : Spec.map φ = h := Spec.map_preimage h
        letI : Algebra A E := (CommRingCat.Hom.hom φ).toAlgebra
        have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap A E))) := by
          change WeaklyEtale (Spec.map φ)
          rw [hφ]
          exact hWh
        have hAE : Algebra.WeaklyEtale A E := s6 A E hW'
        let p : PrimeSpectrum E := w
        have hq : (p.asIdeal).comap (algebraMap A E) = IsLocalRing.maximalIdeal A := by
          have h1 : (Spec.map φ) w = IsLocalRing.closedPoint A := by
            rw [hφ]
            show e.hom (g (ι w)) = _
            rw [hw, hv]
          exact congrArg PrimeSpectrum.asIdeal h1
        obtain ⟨τ⟩ := s7 E hAE p.asIdeal hq
        let τ' : E ⟶ CommRingCat.of A := CommRingCat.ofHom (τ : E →+* A)
        have hret : φ ≫ τ' = 𝟙 _ := by
          ext r
          exact τ.commutes r
        refine ⟨e.hom ≫ Spec.map τ' ≫ ι, ?_⟩
        rw [← cancel_mono e.hom]
        simp only [Category.assoc, Category.id_comp]
        have h3 : ι ≫ g ≫ e.hom = Spec.map φ := hφ.symm
        rw [h3, ← Spec.map_comp, hret, Spec.map_id, Category.comp_id]
      have s4 : ∀ (U : S.ProEt) (R : Presieve U), R ∈ (Scheme.ProEt.precoverage S).coverings U →
          ∀ (W : S.ProEt) (a : W ⟶ U), Nonempty (W.left ≅ Spec (.of A)) →
          ∃ (Y : S.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), R g ∧ h ≫ g = a := by
        intro U R hR W a ⟨eW⟩
        have hR' : Presieve.map (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
            (Scheme.precoverage @WeaklyEtale).coverings U.left := hR.2
        obtain ⟨Y', g', hg', y', hy'⟩ :=
          (Scheme.instJointlySurjectivePrecoverage (P := @WeaklyEtale)).exists_eq _ hR'
            (a.left (eW.inv (IsLocalRing.closedPoint A)))
        obtain ⟨Y, hY, g, hg, hgg⟩ := Presieve.map_iff.mp hg'
        subst hY
        have hgl : g.left = g' := hgg.trans (by simp only [eqToHom_refl]; exact Category.id_comp _)
        haveI : WeaklyEtale U.hom := U.prop
        haveI : WeaklyEtale (g.left ≫ U.hom) := by
          rw [MorphismProperty.Over.w g]; exact Y.prop
        haveI : WeaklyEtale g.left := WeaklyEtale.of_comp g.left U.hom
        obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := a.left) (g := g.left)
          (eW.inv (IsLocalRing.closedPoint A)) y' (by rw [hgl]; exact hy'.symm)
        obtain ⟨σ, hσ⟩ := s5 eW (Limits.pullback.fst a.left g.left) z (by
          rw [hz1]
          change (eW.inv ≫ eW.hom) (IsLocalRing.closedPoint A) = _
          rw [Iso.inv_hom_id]
          rfl)
        have hh₀ : (σ ≫ Limits.pullback.snd a.left g.left) ≫ g.left = a.left := by
          rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hσ, Category.id_comp]
        refine ⟨Y, g, MorphismProperty.Over.homMk (σ ≫ Limits.pullback.snd a.left g.left) ?_ trivial,
          hg, ?_⟩
        · rw [← MorphismProperty.Over.w g, ← Category.assoc, hh₀, MorphismProperty.Over.w a]
        · apply MorphismProperty.Over.Hom.ext
          exact hh₀
      have s3 : ∀ (P : S.ProEt → Prop),
          (∀ (U : S.ProEt) (R : Presieve U), R ∈ (Scheme.ProEt.precoverage S).coverings U →
            ∀ (W : S.ProEt) (a : W ⟶ U), P W →
              ∃ (Y : S.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), R g ∧ h ≫ g = a) →
          ∀ (U : S.ProEt) (T : Sieve U), T ∈ Scheme.ProEt.topology S U →
            ∀ (W : S.ProEt) (a : W ⟶ U), P W → T.arrows a := by
        intro P hK
        let JP : GrothendieckTopology S.ProEt :=
          GrothendieckTopology.mk
            (fun U => {T : Sieve U | ∀ (W : S.ProEt) (a : W ⟶ U), P W → T.arrows a})
            (by
              intro U W a _
              trivial)
            (by
              intro U Y T f hT W a hW
              rw [Sieve.pullback_apply]
              exact hT W (a ≫ f) hW)
            (by
              intro U T hT R hR W a hW
              have h1 := hR (hT W a hW) W (𝟙 W) hW
              rw [Sieve.pullback_apply, Category.id_comp] at h1
              exact h1)
        have hle : Scheme.ProEt.topology S ≤ JP := by
          rw [Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
          intro U R hR
          show ∀ (W : S.ProEt) (a : W ⟶ U), P W → (Sieve.generate R).arrows a
          intro W a hW
          obtain ⟨Y, g, h, hg, hhg⟩ := hK U R hR W a hW
          exact ⟨Y, h, g, hg, hhg⟩
        intro U T hT W a hW
        have h1 : T ∈ JP U := GrothendieckTopology.le_def.mp hle U hT
        exact h1 W a hW
      intro V hV T hT
      exact s3 (fun W => Nonempty (W.left ≅ Spec (.of A))) s4 V T hT V (𝟙 V) hV
    intro P
    have hW := hid _ W ⟨e⟩
    constructor
    · intro x y hxy
      have h1 := Presheaf.equalizerSieve_mem (Scheme.ProEt.topology (wcP1Over K).left)
        (toSheafify (Scheme.ProEt.topology (wcP1Over K).left) P) x y hxy
      have h2 := hW _ h1
      rw [Presheaf.equalizerSieve_apply] at h2
      simpa using h2
    · intro s
      have h1 := Presheaf.imageSieve_mem (Scheme.ProEt.topology (wcP1Over K).left)
        (toSheafify (Scheme.ProEt.topology (wcP1Over K).left) P) (U := Opposite.op W) s
      have h2 := hW _ h1
      rw [Presheaf.imageSieve_apply] at h2
      obtain ⟨t, ht⟩ := h2
      exact ⟨t, ht.trans (by simp)⟩

  have resGen : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] (W Q : Scheme.{u})
      (e : W ≅ Spec (.of A)) (f : Q ⟶ W) [IsFinite f],
      Function.Bijective (fun (h : C(↥Q, Fin r → ZMod (ℓ ^ n)))
        (z : {z : Q // e.hom (f z) = IsLocalRing.closedPoint A}) => h z.1) := by
    intro A _ _ W Q e f _
    obtain ⟨g, hg⟩ : ∃ g : Q ⟶ Spec (.of A), g = f ≫ e.hom := ⟨_, rfl⟩
    haveI : IsFinite g := by rw [hg]; infer_instance
    have hgapp : ∀ z : Q, g z = e.hom (f z) := by
      intro z; rw [hg]; exact Scheme.Hom.comp_apply _ _ _
    have memFib : ∀ z : Q, z ∈ g ⁻¹' {IsLocalRing.closedPoint A} ↔
        e.hom (f z) = IsLocalRing.closedPoint A := by
      intro z
      exact ⟨fun h => (hgapp z).symm.trans h, fun h => (hgapp z).trans h⟩
    have hFibfin : (g ⁻¹' {IsLocalRing.closedPoint A}).Finite :=
      Scheme.Hom.finite_preimage_singleton g _
    have hclosed : IsClosed ({IsLocalRing.closedPoint A} : Set (Spec (.of A))) :=
      IsLocalRing.isClosed_singleton_closedPoint A
    have s1gen : ∀ (s : ↥(Spec (.of A))), IsClosed ({s} : Set ↥(Spec (.of A))) →
        ∀ x : Q, g x = s → IsClosed ({x} : Set Q) := by
      intro s hs x hx
      have hF : IsClosed (g ⁻¹' {s}) := hs.preimage g.continuous
      have : DiscreteTopology ↥(g.fiber s) := inferInstance
      have : DiscreteTopology ↥(g ⁻¹' {s}) := (Scheme.Hom.fiberHomeo g s).discreteTopology
      have hxF : x ∈ g ⁻¹' {s} := hx
      have h1 := (isClosed_discrete ({⟨x, hxF⟩} : Set ↥(g ⁻¹' {s}))).trans hF
      rwa [Set.image_singleton] at h1
