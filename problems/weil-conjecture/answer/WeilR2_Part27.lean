    have s2 : ∀ q : Q, ∃ y : Q, g y = IsLocalRing.closedPoint A ∧ q ⤳ y := by
      intro q
      have hZ : IsClosed (g '' closure {q}) := g.isClosedMap _ isClosed_closure
      have hq : g q ∈ g '' closure {q} := Set.mem_image_of_mem _ (subset_closure rfl)
      obtain ⟨y, hy, hgy⟩ := (IsLocalRing.specializes_closedPoint (g q)).mem_closed hZ hq
