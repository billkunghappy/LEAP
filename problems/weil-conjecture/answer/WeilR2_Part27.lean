        wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n) (wcCxJMap K hP (lamI x)) := fun x => by
    rw [← Category.assoc, hγ, Category.assoc, hβlin, Category.assoc]
  obtain ⟨h₁T⟩ := wcU_sms_tw_htpy ρ _ _ (β' ≫ γ) (𝟙 _) hβγ (hid _) h₁ hh₁
  obtain ⟨h₂T⟩ := wcU_sms_tw_htpy ρ _ _ (γ ≫ β') (𝟙 _) hγβ (hid _) h₂ hh₂
  let heq : HomotopyEquiv
      (wcSpfTwCx (wcSmsBar P n) (wcSmsBarSmul P n) ρ)
      (wcSpfTwCx (wcTruncKerRes (wcCxJ K hP I.cocomplex) (ℓ ^ n))
        (fun x => wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n) (wcCxJMap K hP (lamI x))) ρ) :=
    { hom := wcSmsTwMap ρ β' hβlin
