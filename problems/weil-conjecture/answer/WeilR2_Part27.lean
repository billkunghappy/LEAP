  obtain ⟨β', hcone, h0, hβlin, G, hG⟩ := wcU_sms_bockstein_model ℓ Γ n hn
    (wcCxJ K hP I.cocomplex) (fun x => wcCxJMap K hP (lamI x)) hD (wcCxJFrob K hP I.cocomplex) hFr
