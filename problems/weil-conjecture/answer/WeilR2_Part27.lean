  refine ⟨fun l => lamψ (φl l), hlamσ, hlamF, ?_⟩

  intro a ha
  by_contra hne
  obtain ⟨U, hUdef⟩ : ∃ U : ι' → ℚ_[ℓ], U = ∑ l, a l • T l := ⟨_, rfl⟩
  have hU0 : U ≠ 0 := by
