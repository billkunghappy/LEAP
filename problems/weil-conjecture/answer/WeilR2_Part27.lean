          (FW.f k).hom ((Ψ'.f k).hom (red k a)) - (Ψ'.f k).hom ((fV.f k).hom (red k a)) := by
        simp [HomologicalComplex.sub_f_apply]
      rw [e1, ← hredF, hΨ', hΨ', ← hP, ← hP, map_zsmul, hθF k _ (tP k a), ← smul_sub,
        ← hθsub k _ _ (tmap _ _ (tP k a)) (tP k _)]
    have heq : Ψ' ≫ FW - fV ≫ Ψ' = Homotopy.nullHomotopicMap' hfun := by
      apply HomologicalComplex.hom_ext
      intro k
      refine AddCommGrpCat.ext (fun x => ?_)
      obtain ⟨a, rfl⟩ := hred_surj k x
      show ((Ψ' ≫ FW - fV ≫ Ψ').f k).hom (red k a) =
        ((Homotopy.nullHomotopicMap' hfun).f k).hom (red k a)
      rw [hLHS]
      cases k with
      | zero =>
        rw [Homotopy.nullHomotopicMap'_f_of_not_rel_right
          (show (ComplexShape.up ℕ).Rel 0 (0 + 1) from rfl) (fun l hl => Nat.succ_ne_zero l hl)]
        rw [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply, hfun_apply,
          ← hred_d, hG, key_0, hθsub 0 _ _ (tmap _ _ (tε0 a)) (tεs 0 _), hθ0 _ (tε0 a)]
        simp
      | succ j =>
        rw [Homotopy.nullHomotopicMap'_f (show (ComplexShape.up ℕ).Rel j (j + 1) from rfl)
          (show (ComplexShape.up ℕ).Rel (j + 1) (j + 1 + 1) from rfl)]
        rw [AddCommGrpCat.hom_add, AddMonoidHom.add_apply, AddCommGrpCat.hom_comp,
          AddMonoidHom.coe_comp, Function.comp_apply, AddCommGrpCat.hom_comp,
          AddMonoidHom.coe_comp, Function.comp_apply, hfun_apply, hfun_apply, ← hred_d, hG, hG,
          map_zsmul, hθd j _ (tεs j a), key_s,
          hθsub (j + 1) _ _ (tmap _ _ (tεs j a)) (tεs (j + 1) _),
          pow_succ (-1 : ℤ) (j + 1), mul_neg_one, neg_smul, smul_sub]
        abel
    refine ⟨Homotopy.equivSubZero.symm ((Homotopy.ofEq heq).trans (Homotopy.nullHomotopy' hfun)), ?_⟩
    intro x i j
    by_cases hr : (ComplexShape.up ℕ).Rel j i
    · obtain rfl : j + 1 = i := hr
      have hGc : (Homotopy.equivSubZero.symm ((Homotopy.ofEq heq).trans
          (Homotopy.nullHomotopy' hfun))).hom (j + 1) j =
            hfun (j + 1) j (show (ComplexShape.up ℕ).Rel j (j + 1) from rfl) := by
        show (0 : V.X (j + 1) ⟶ W.X j) + (Homotopy.nullHomotopy' hfun).hom (j + 1) j = _
        rw [zero_add]
        exact dif_pos rfl
      rw [hGc]
      refine AddCommGrpCat.ext (fun y => ?_)
      obtain ⟨a, rfl⟩ := hred_surj (j + 1) y
      show (hfun (j + 1) j (show (ComplexShape.up ℕ).Rel j (j + 1) from rfl)).hom
          (((lamV x).f (j + 1)).hom (red (j + 1) a)) =
        ((lamW x).f j).hom ((hfun (j + 1) j (show (ComplexShape.up ℕ).Rel j (j + 1) from rfl)).hom
          (red (j + 1) a))
      rw [← hredl, hfun_apply, hfun_apply, hG, hG, map_zsmul, hθl j x _ (tεs j a), hεl j x a]
    · rw [Homotopy.zero _ i j hr, Limits.comp_zero, Limits.zero_comp]



  obtain ⟨θ, hθadd, hθd, hθsurj, hθinj, hθker0, hθ0, hθnat⟩ := hθex (ℓ ^ n)
  obtain ⟨hinj, hsurj⟩ := (wcU_bk_qiso_elem φ).mp hφ
  obtain ⟨hS, hI⟩ := wcU_bk_chase φ (ℓ ^ n) hA hdiv hinj hsurj σ hσ
  obtain ⟨β', hβ⟩ := wcU_bk_descend φ (ℓ ^ n) σ hσ red hred_surj
    (fun k a => (hred_ker k a).mp) hred_d θ hθadd hθd
  have hwd : ∀ k a, (ℓ ^ n) • ((D.d k (k + 1)).hom (σ k a) -
      σ (k + 1) (((wcGModelAb P).d k (k + 1)).hom a)) = 0 := by
    intro k a
    rw [smul_sub, ← map_nsmul, hσ, hσ, hcomm φ, sub_self]
  have hq : QuasiIso β' := (wcU_bk_qiso_elem β').mpr
    (wcU_bk_descend_qiso (ℓ ^ n) σ red hred_surj hred_ker hred_d θ hθadd hθd hθsurj hθinj
      hθker0 hθ0 hS hI hwd β' hβ)
  have hcone : wcSmsConeExact β' := wcU_ab_quasiIso_cone_exact _ _ β' hq

  have h0 : ∀ y : D.X 0, (D.d 0 1).hom y = 0 → (ℓ ^ n) • y = 0 → y = 0 := by
    intro y hy hNy
    obtain ⟨x, hx, w, hw⟩ := hsurj 0 y hy
    have hD0 : D.d (0 - 1) 0 = 0 := D.shape _ _ (by change ¬ (0 - 1 + 1 = 0); omega)
    have hA0 : (wcGModelAb P).d (0 - 1) 0 = 0 :=
      (wcGModelAb P).shape _ _ (by change ¬ (0 - 1 + 1 = 0); omega)
    rw [hD0] at hw
    simp only [AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] at hw
    have hφx : (φ.f 0).hom x = y := (sub_eq_zero.mp hw.symm)
    obtain ⟨x', hx'⟩ := hinj 0 ((ℓ ^ n) • x) (by rw [map_nsmul, hx, smul_zero]) 0
      (by rw [map_nsmul, hφx, hNy, map_zero])
    rw [hA0] at hx'
    simp only [AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] at hx'
    have hx0 : x = 0 := hA 0 x hx'.symm
    rw [← hφx, hx0, map_zero]

  have hβlin : ∀ x, wcSmsBarSmul P n x ≫ β' = β' ≫ wcSpfTruncMap D (ℓ ^ n) (lamD x) := by
    intro x
    apply HomologicalComplex.hom_ext
    intro k
    refine AddCommGrpCat.ext (fun y => ?_)
    obtain ⟨a, rfl⟩ := hred_surj k y
    show (β'.f k).hom (((wcSmsBarSmul P n x).f k).hom (red k a)) =
      ((wcSpfTruncMap D (ℓ ^ n) (lamD x)).f k).hom ((β'.f k).hom (red k a))
    rw [← hredl, hβ, hβ, map_zsmul, hσl k x a, hcomm (wcGModelSmul P x) k (k + 1) a,
      hσl (k + 1) x, hcomm (lamD x), ← map_sub, ← hθnat (lamD x) k _ (hwd k a)]

  obtain ⟨G, hG⟩ := hHtpy φ (ℓ ^ n) σ hσ red hred_surj (fun k a => (hred_ker k a).mp) hred_d
    θ hθadd hθd hθ0 β' hβ (wcGModelFrob P) FrD (wcSmsBarFrob P n) (wcSpfTruncMap D (ℓ ^ n) FrD)
    hredF (hθnat FrD) H τ hτ (wcGModelSmul P) lamD (wcSmsBarSmul P n)
    (fun x => wcSpfTruncMap D (ℓ ^ n) (lamD x)) hfA hFr hσl hτl hredl
    (fun k x c hc => hθnat (lamD x) k c hc)
  exact ⟨β', hcone, h0, hβlin, G, hG⟩

theorem wcU_sms_relinj_htpy_equiv {R : Type u} [Ring R] (N : ℕ)
    {X Y : CochainComplex AddCommGrpCat.{u+1} ℕ} (lamX : R → (X ⟶ X)) (lamY : R → (Y ⟶ Y))
    (hX : wcRingAct lamX) (hY : wcRingAct lamY)
    (hXN : ∀ k (x : X.X k), N • x = 0) (hYN : ∀ k (y : Y.X k), N • y = 0)
    (hXI : ∀ k, wcSmsRelInj lamX N k) (hYI : ∀ k, wcSmsRelInj lamY N k)
    (β : X ⟶ Y) (hβ : ∀ x, lamX x ≫ β = β ≫ lamY x) (hc : wcSmsConeExact β) :
    ∃ (γ : Y ⟶ X) (_ : ∀ x, lamY x ≫ γ = γ ≫ lamX x)
      (h₁ : Homotopy (β ≫ γ) (𝟙 X)) (h₂ : Homotopy (γ ≫ β) (𝟙 Y)),
      (∀ x i j, (lamX x).f i ≫ h₁.hom i j = h₁.hom i j ≫ (lamX x).f j) ∧
      (∀ x i j, (lamY x).f i ≫ h₂.hom i j = h₂.hom i j ≫ (lamY x).f j) :=
by

  have EA : ∀ {Z : CochainComplex AddCommGrpCat.{u+1} ℕ}
      (lamZ : R → (Z ⟶ Z)) (k : ℕ), wcSmsRelInj lamZ N k →
      ∀ {V P : Type (u+1)} [AddCommGroup V] [AddCommGroup P] (ρV : R → V →+ V) (ρP : R → P →+ P),
        (∀ p, ρP 1 p = p) → (∀ a b p, ρP (a + b) p = ρP a p + ρP b p) →
        (∀ a b p, ρP (a * b) p = ρP a (ρP b p)) → (∀ p : P, N • p = 0) →
        ∀ (f : V →+ P), (∀ r v, f (ρV r v) = ρP r (f v)) →
        ∀ (φ : V →+ Z.X k), (∀ r v, φ (ρV r v) = ((lamZ r).f k).hom (φ v)) →
        (∀ v, f v = 0 → φ v = 0) →
        ∃ h : P →+ Z.X k, (∀ r p, h (ρP r p) = ((lamZ r).f k).hom (h p)) ∧
          ∀ v, h (f v) = φ v := by
    intro Z lamZ k hI V P _ _ ρV ρP h1 hadd hmul hN f hf φ hφ hker
    let ρh : R →+* AddMonoid.End P :=
      { toFun := ρP
        map_one' := AddMonoidHom.ext h1
        map_mul' := fun a b => AddMonoidHom.ext (hmul a b)
        map_zero' := AddMonoidHom.ext fun p => by
          have := hadd 0 0 p
          rw [add_zero] at this
          show ρP 0 p = 0
          simpa using this
        map_add' := fun a b => AddMonoidHom.ext (hadd a b) }
    letI : Module R P := Module.compHom P ρh
    have hsm : ∀ (r : R) (p : P), r • p = ρP r p := fun _ _ => rfl
    let S : Submodule R P :=
      { carrier := Set.range f
        add_mem' := by
          rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
          exact ⟨a + b, map_add f a b⟩
        zero_mem' := ⟨0, map_zero f⟩
        smul_mem' := by
          rintro r _ ⟨v, rfl⟩
          exact ⟨ρV r v, by rw [hf, hsm]⟩ }
    have hS : ∀ s : S, ∃ v, f v = s.1 := fun s => s.2
    choose c hc using hS
    have key : ∀ (s : S) (v : V), f v = s.1 → φ (c s) = φ v := by
      intro s v hv
      have := hker (c s - v) (by rw [map_sub, hc, hv, sub_self])
      rwa [map_sub, sub_eq_zero] at this
    let g : S →+ Z.X k :=
      { toFun := fun s => φ (c s)
        map_zero' := (key 0 0 (by rw [map_zero]; rfl)).trans (map_zero φ)
        map_add' := fun s t => by
          have := key (s + t) (c s + c t) (by rw [map_add, hc, hc]; rfl)
          rw [this, map_add] }
    have hg : ∀ s, g s = φ (c s) := fun _ => rfl
    have hglin : wcChmpLamLin lamZ k (N := ↥(ModuleCat.of R S)) g := by
      intro r s
      show g (r • s) = _
      rw [hg, hg, key (r • s) (ρV r (c s)) (by rw [hf, hc]; rfl), hφ]
    obtain ⟨h, hhlin, hh⟩ := hI (ModuleCat.of R S) (ModuleCat.of R P) (ModuleCat.ofHom S.subtype)
      Subtype.val_injective hN g hglin
    refine ⟨h, fun r p => hhlin r p, fun v => ?_⟩
    have := hh ⟨f v, v, rfl⟩
    exact this.trans ((hg _).trans (key _ v rfl))

  have EXT : ∀ (s0 : X.X 1 × Y.X 0 →+ X.X 0)
      (t : ∀ k : ℕ, X.X (k + 1 + 1) × Y.X (k + 1) →+ X.X (k + 1) × Y.X k),
      (∀ (r : R) (x : X.X 1) (y : Y.X 0),
        s0 (((lamX r).f 1).hom x, ((lamY r).f 0).hom y) = ((lamX r).f 0).hom (s0 (x, y))) →
      (∀ (k : ℕ) (r : R) (x : X.X (k + 1 + 1)) (y : Y.X (k + 1)),
        t k (((lamX r).f (k + 1 + 1)).hom x, ((lamY r).f (k + 1)).hom y) =
          (((lamX r).f (k + 1)).hom (t k (x, y)).1, ((lamY r).f k).hom (t k (x, y)).2)) →
      (∀ x : X.X 0, s0 (-(X.d 0 1).hom x, (β.f 0).hom x) = x) →
      (∀ (x : X.X 1) (y : Y.X 0),
        t 0 (-(X.d 1 (1 + 1)).hom x, (β.f 1).hom x + (Y.d 0 1).hom y) +
          (-(X.d 0 1).hom (s0 (x, y)), (β.f 0).hom (s0 (x, y))) = (x, y)) →
      (∀ (k : ℕ) (x : X.X (k + 1 + 1)) (y : Y.X (k + 1)),
        t (k + 1) (-(X.d (k + 1 + 1) (k + 1 + 1 + 1)).hom x,
            (β.f (k + 1 + 1)).hom x + (Y.d (k + 1) (k + 1 + 1)).hom y) +
          (-(X.d (k + 1) (k + 1 + 1)).hom (t k (x, y)).1,
            (β.f (k + 1)).hom (t k (x, y)).1 + (Y.d k (k + 1)).hom (t k (x, y)).2) = (x, y)) →
      ∃ (γ : Y ⟶ X) (_ : ∀ x, lamY x ≫ γ = γ ≫ lamX x)
        (h₁ : Homotopy (β ≫ γ) (𝟙 X)) (h₂ : Homotopy (γ ≫ β) (𝟙 Y)),
        (∀ x i j, (lamX x).f i ≫ h₁.hom i j = h₁.hom i j ≫ (lamX x).f j) ∧
        (∀ x i j, (lamY x).f i ≫ h₂.hom i j = h₂.hom i j ≫ (lamY x).f j) := by
    intro s0 t hs0 ht hS hT0 hT
    have s0s : ∀ x y, s0 (x, y) = s0 (x, 0) + s0 (0, y) := fun x y => by
      rw [← map_add, Prod.mk_add_mk, add_zero, zero_add]
    have ts : ∀ k x y, t k (x, y) = t k (x, 0) + t k (0, y) := fun k x y => by
      rw [← map_add, Prod.mk_add_mk, add_zero, zero_add]
    have H1_0 : ∀ x : X.X 0, s0 (0, (β.f 0).hom x) = s0 ((X.d 0 1).hom x, 0) + x := by
      intro x
      have h := hS x
      rw [s0s, show ((-(X.d 0 1).hom x, (0 : Y.X 0)) : X.X 1 × Y.X 0) = -((X.d 0 1).hom x, 0) by
        simp, map_neg] at h
      have e : s0 (0, (β.f 0).hom x) =
          (-s0 ((X.d 0 1).hom x, 0) + s0 (0, (β.f 0).hom x)) + s0 ((X.d 0 1).hom x, 0) := by abel
      rw [e, h]; abel
    have T0y : ∀ y : Y.X 0, (t 0 (0, (Y.d 0 1).hom y)).1 = (X.d 0 1).hom (s0 (0, y)) ∧
        (t 0 (0, (Y.d 0 1).hom y)).2 + (β.f 0).hom (s0 (0, y)) = y := by
      intro y
      have h := hT0 0 y
      simp only [map_zero, neg_zero, zero_add, Prod.ext_iff, Prod.fst_add, Prod.snd_add] at h
      exact ⟨by rw [← sub_eq_zero, sub_eq_add_neg]; exact h.1, h.2⟩
    have T0x : ∀ x : X.X 1, (t 0 (0, (β.f 1).hom x)).1 =
        (t 0 ((X.d 1 (1 + 1)).hom x, 0)).1 + (X.d 0 1).hom (s0 (x, 0)) + x := by
      intro x
      have h := hT0 x 0
      simp only [map_zero, add_zero, Prod.ext_iff, Prod.fst_add] at h
      have h1 := h.1
      rw [ts, show ((-(X.d 1 (1 + 1)).hom x, (0 : Y.X 1)) : X.X (0 + 1 + 1) × Y.X (0 + 1)) =
        -((X.d 1 (1 + 1)).hom x, 0) by simp, map_neg] at h1
      simp only [Prod.fst_add, Prod.fst_neg] at h1
      have e : (t 0 (0, (β.f 1).hom x)).1 =
          (-(t 0 ((X.d 1 (1 + 1)).hom x, 0)).1 + (t 0 (0, (β.f 1).hom x)).1 +
            -(X.d 0 1).hom (s0 (x, 0))) +
          (t 0 ((X.d 1 (1 + 1)).hom x, 0)).1 + (X.d 0 1).hom (s0 (x, 0)) := by abel
      rw [e, h1]; abel
    have TSy : ∀ k (y : Y.X (k + 1)),
        (t (k + 1) (0, (Y.d (k + 1) (k + 1 + 1)).hom y)).1 =
          (X.d (k + 1) (k + 1 + 1)).hom (t k (0, y)).1 ∧
        (t (k + 1) (0, (Y.d (k + 1) (k + 1 + 1)).hom y)).2 + (β.f (k + 1)).hom (t k (0, y)).1 +
          (Y.d k (k + 1)).hom (t k (0, y)).2 = y := by
      intro k y
      have h := hT k 0 y
      simp only [map_zero, neg_zero, zero_add, Prod.ext_iff, Prod.fst_add, Prod.snd_add] at h
      refine ⟨by rw [← sub_eq_zero, sub_eq_add_neg]; exact h.1, by rw [add_assoc]; exact h.2⟩
    have TSx : ∀ k (x : X.X (k + 1 + 1)), (t (k + 1) (0, (β.f (k + 1 + 1)).hom x)).1 =
        (t (k + 1) ((X.d (k + 1 + 1) (k + 1 + 1 + 1)).hom x, 0)).1 +
          (X.d (k + 1) (k + 1 + 1)).hom (t k (x, 0)).1 + x := by
      intro k x
      have h := hT k x 0
      simp only [map_zero, add_zero, Prod.ext_iff, Prod.fst_add] at h
      have h1 := h.1
      rw [ts, show ((-(X.d (k + 1 + 1) (k + 1 + 1 + 1)).hom x, (0 : Y.X (k + 1 + 1))) :
          X.X (k + 1 + 1 + 1) × Y.X (k + 1 + 1)) = -((X.d (k + 1 + 1) (k + 1 + 1 + 1)).hom x, 0) by
        simp, map_neg] at h1
      simp only [Prod.fst_add, Prod.fst_neg] at h1
      have e : (t (k + 1) (0, (β.f (k + 1 + 1)).hom x)).1 =
          (-(t (k + 1) ((X.d (k + 1 + 1) (k + 1 + 1 + 1)).hom x, 0)).1 +
            (t (k + 1) (0, (β.f (k + 1 + 1)).hom x)).1 +
            -(X.d (k + 1) (k + 1 + 1)).hom (t k (x, 0)).1) +
          (t (k + 1) ((X.d (k + 1 + 1) (k + 1 + 1 + 1)).hom x, 0)).1 +
            (X.d (k + 1) (k + 1 + 1)).hom (t k (x, 0)).1 := by abel
      rw [e, h1]; abel
    have elem : ∀ {A B : AddCommGrpCat.{u+1}} (f g : A ⟶ B), (∀ x, f.hom x = g.hom x) → f = g :=
      fun f g h => AddCommGrpCat.ext h
    let γc : ∀ i, Y.X i →+ X.X i := fun i => match i with
      | 0 => s0.comp (AddMonoidHom.inr _ _)
      | k + 1 => (AddMonoidHom.fst _ _).comp ((t k).comp (AddMonoidHom.inr _ _))
    let pc : ∀ j, X.X (j + 1) →+ X.X j := fun j => match j with
      | 0 => s0.comp (AddMonoidHom.inl _ _)
      | k + 1 => (AddMonoidHom.fst _ _).comp ((t k).comp (AddMonoidHom.inl _ _))
    let hc : ∀ j, Y.X (j + 1) →+ Y.X j := fun j =>
      (AddMonoidHom.snd _ _).comp ((t j).comp (AddMonoidHom.inr _ _))
    have γc0 : ∀ y, γc 0 y = s0 (0, y) := fun _ => rfl
    have γcS : ∀ k y, γc (k + 1) y = (t k (0, y)).1 := fun _ _ => rfl
    have pc0 : ∀ x, pc 0 x = s0 (x, 0) := fun _ => rfl
    have pcS : ∀ k x, pc (k + 1) x = (t k (x, 0)).1 := fun _ _ => rfl
    have hcE : ∀ k y, hc k y = (t k (0, y)).2 := fun _ _ => rfl
    let γ : Y ⟶ X :=
      { f := fun i => AddCommGrpCat.ofHom (γc i)
        comm' := by
          rintro i j rfl
          refine elem _ _ fun y => ?_
          simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, AddCommGrpCat.hom_ofHom]
          cases i with
          | zero => rw [γc0, γcS]; exact (T0y y).1.symm
          | succ k => rw [γcS, γcS]; exact (TSy k y).1.symm }
    have γf : ∀ i y, (γ.f i).hom y = γc i y := fun _ _ => rfl
    have hγlin : ∀ r, lamY r ≫ γ = γ ≫ lamX r := by
      intro r
      ext i : 1
      refine elem _ _ fun y => ?_
      simp only [HomologicalComplex.comp_f, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, γf]
      cases i with
      | zero =>
        rw [γc0, γc0, ← hs0, map_zero]
      | succ k =>
        rw [γcS, γcS]
        have := ht k r 0 y
        rw [map_zero] at this
        rw [this]
    let H1 : ∀ i j, X.X i ⟶ X.X j := fun i j =>
      if h : i = j + 1 then (X.XIsoOfEq h).hom ≫ AddCommGrpCat.ofHom (pc j) else 0
    let H2 : ∀ i j, Y.X i ⟶ Y.X j := fun i j =>
      if h : i = j + 1 then (Y.XIsoOfEq h).hom ≫ (-AddCommGrpCat.ofHom (hc j)) else 0
    have H1e : ∀ j, H1 (j + 1) j = AddCommGrpCat.ofHom (pc j) := by
      intro j
      show (if h : j + 1 = j + 1 then _ else _) = _
      rw [dif_pos rfl, HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, Category.id_comp]
    have H2e : ∀ j, H2 (j + 1) j = -AddCommGrpCat.ofHom (hc j) := by
      intro j
      show (if h : j + 1 = j + 1 then _ else _) = _
      rw [dif_pos rfl, HomologicalComplex.XIsoOfEq_rfl, Iso.refl_hom, Category.id_comp]
    have H1z : ∀ i j, ¬ (ComplexShape.up ℕ).Rel j i → H1 i j = 0 := by
      intro i j hij
      exact dif_neg (fun h => hij h.symm)
    have H2z : ∀ i j, ¬ (ComplexShape.up ℕ).Rel j i → H2 i j = 0 := by
      intro i j hij
      exact dif_neg (fun h => hij h.symm)
    have c1 : ∀ i, (β ≫ γ).f i = dNext i H1 + prevD i H1 + HomologicalComplex.Hom.f (𝟙 X) i := by
      intro i
      rw [Homotopy.dNext_cochainComplex, H1e]
      rcases i with _ | _ | k
      · rw [Homotopy.prevD_zero_cochainComplex]
        refine elem _ _ fun x => ?_
        simp only [HomologicalComplex.comp_f, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
          AddCommGrpCat.hom_add, AddMonoidHom.add_apply, AddCommGrpCat.hom_ofHom,
          AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply, HomologicalComplex.id_f,
          AddCommGrpCat.hom_id, AddMonoidHom.id_apply, γf, γc0, pc0, add_zero]
        exact H1_0 x
      · rw [Homotopy.prevD_succ_cochainComplex, H1e]
        refine elem _ _ fun x => ?_
        simp only [HomologicalComplex.comp_f, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
          AddCommGrpCat.hom_add, AddMonoidHom.add_apply, AddCommGrpCat.hom_ofHom,
          HomologicalComplex.id_f, AddCommGrpCat.hom_id, AddMonoidHom.id_apply, γf, γcS, pc0, pcS]
        exact T0x x
      · rw [Homotopy.prevD_succ_cochainComplex, H1e]
        refine elem _ _ fun x => ?_
        simp only [HomologicalComplex.comp_f, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
          AddCommGrpCat.hom_add, AddMonoidHom.add_apply, AddCommGrpCat.hom_ofHom,
          HomologicalComplex.id_f, AddCommGrpCat.hom_id, AddMonoidHom.id_apply, γf, γcS, pcS]
        exact TSx k x
    have c2 : ∀ i, (γ ≫ β).f i = dNext i H2 + prevD i H2 + HomologicalComplex.Hom.f (𝟙 Y) i := by
      intro i
      rw [Homotopy.dNext_cochainComplex, H2e]
      rcases i with _ | k
      · rw [Homotopy.prevD_zero_cochainComplex]
        refine elem _ _ fun y => ?_
        simp only [HomologicalComplex.comp_f, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
          AddCommGrpCat.hom_add, AddMonoidHom.add_apply, AddCommGrpCat.hom_ofHom,
          AddCommGrpCat.hom_neg, AddMonoidHom.neg_apply,
          AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply, HomologicalComplex.id_f,
          AddCommGrpCat.hom_id, AddMonoidHom.id_apply, γf, γc0, hcE, add_zero]
        have := (T0y y).2
        rw [← sub_eq_zero]
        convert sub_eq_zero.mpr this using 1
        abel
      · rw [Homotopy.prevD_succ_cochainComplex, H2e]
        refine elem _ _ fun y => ?_
        simp only [HomologicalComplex.comp_f, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
          AddCommGrpCat.hom_add, AddMonoidHom.add_apply, AddCommGrpCat.hom_ofHom,
          AddCommGrpCat.hom_neg, AddMonoidHom.neg_apply, map_neg,
          HomologicalComplex.id_f, AddCommGrpCat.hom_id, AddMonoidHom.id_apply, γf, γcS, hcE]
        have := (TSy k y).2
        rw [← sub_eq_zero]
        convert sub_eq_zero.mpr this using 1
        abel
    refine ⟨γ, hγlin, ⟨H1, H1z, c1⟩, ⟨H2, H2z, c2⟩, ?_, ?_⟩
    · intro r i j
      show (lamX r).f i ≫ H1 i j = H1 i j ≫ (lamX r).f j
      by_cases h : i = j + 1
      · subst h
        rw [H1e]
        refine elem _ _ fun x => ?_
        simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, AddCommGrpCat.hom_ofHom]
        cases j with
        | zero => rw [pc0, pc0, ← hs0, map_zero]
        | succ k =>
          rw [pcS, pcS]
          have := ht k r x 0
          rw [map_zero] at this
          rw [this]
      · rw [show H1 i j = 0 from dif_neg h, Limits.comp_zero, Limits.zero_comp]
    · intro r i j
      show (lamY r).f i ≫ H2 i j = H2 i j ≫ (lamY r).f j
      by_cases h : i = j + 1
      · subst h
        rw [H2e]
        refine elem _ _ fun y => ?_
        simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, AddCommGrpCat.hom_ofHom,
          AddCommGrpCat.hom_neg, AddMonoidHom.neg_apply, map_neg, hcE]
        have := ht j r 0 y
        rw [map_zero] at this
        rw [this]
      · rw [show H2 i j = 0 from dif_neg h, Limits.comp_zero, Limits.zero_comp]

  obtain ⟨CE0, CES, INJ0⟩ := hc
  have act1X : ∀ j (x : X.X j), ((lamX 1).f j).hom x = x := fun j x => by rw [hX.1]; rfl
  have act1Y : ∀ j (y : Y.X j), ((lamY 1).f j).hom y = y := fun j y => by rw [hY.1]; rfl
  have actaX : ∀ a b j (x : X.X j), ((lamX (a + b)).f j).hom x =
      ((lamX a).f j).hom x + ((lamX b).f j).hom x := fun a b j x => by rw [hX.2.1]; rfl
  have actaY : ∀ a b j (y : Y.X j), ((lamY (a + b)).f j).hom y =
      ((lamY a).f j).hom y + ((lamY b).f j).hom y := fun a b j y => by rw [hY.2.1]; rfl
  have actmX : ∀ a b j (x : X.X j), ((lamX (a * b)).f j).hom x =
      ((lamX a).f j).hom (((lamX b).f j).hom x) := fun a b j x => by rw [hX.2.2]; rfl
  have actmY : ∀ a b j (y : Y.X j), ((lamY (a * b)).f j).hom y =
      ((lamY a).f j).hom (((lamY b).f j).hom y) := fun a b j y => by rw [hY.2.2]; rfl
  have dXe : ∀ r i j (x : X.X i), (X.d i j).hom (((lamX r).f i).hom x) =
      ((lamX r).f j).hom ((X.d i j).hom x) := fun r i j x =>
    (congrArg (fun g => g.hom x) ((lamX r).comm i j))
  have dYe : ∀ r i j (y : Y.X i), (Y.d i j).hom (((lamY r).f i).hom y) =
      ((lamY r).f j).hom ((Y.d i j).hom y) := fun r i j y =>
    (congrArg (fun g => g.hom y) ((lamY r).comm i j))
  have βe : ∀ r j (x : X.X j), (β.f j).hom (((lamX r).f j).hom x) =
      ((lamY r).f j).hom ((β.f j).hom x) := fun r j x =>
    congrArg (fun g : X ⟶ Y => (g.f j).hom x) (hβ r)
  have ddX : ∀ i j k (x : X.X i), (X.d j k).hom ((X.d i j).hom x) = 0 := fun i j k x => by
    rw [← AddCommGrpCat.comp_apply, HomologicalComplex.d_comp_d]; rfl
  have ddY : ∀ i j k (y : Y.X i), (Y.d j k).hom ((Y.d i j).hom y) = 0 := fun i j k y => by
    rw [← AddCommGrpCat.comp_apply, HomologicalComplex.d_comp_d]; rfl
  have βd : ∀ i j (x : X.X i), (β.f j).hom ((X.d i j).hom x) = (Y.d i j).hom ((β.f i).hom x) :=
    fun i j x => by
      rw [← AddCommGrpCat.comp_apply, ← AddCommGrpCat.comp_apply, HomologicalComplex.Hom.comm]
  obtain ⟨ρ, ρap⟩ : ∃ ρ : ∀ a b, R → (X.X a × Y.X b →+ X.X a × Y.X b),
      ∀ a b r p, ρ a b r p = (((lamX r).f a).hom p.1, ((lamY r).f b).hom p.2) :=
    ⟨fun a b r => AddMonoidHom.prodMap ((lamX r).f a).hom ((lamY r).f b).hom,
      fun _ _ _ _ => rfl⟩
  obtain ⟨e, eap⟩ : ∃ e : X.X 0 →+ X.X (0 + 1) × Y.X 0,
      ∀ x, e x = (-(X.d 0 (0 + 1)).hom x, (β.f 0).hom x) :=
    ⟨AddMonoidHom.prod (-(X.d 0 (0 + 1)).hom) (β.f 0).hom, fun _ => rfl⟩
  obtain ⟨D, Dap⟩ : ∃ D : ∀ j, (X.X (j + 1) × Y.X j →+ X.X (j + 1 + 1) × Y.X (j + 1)),
      ∀ j x y, D j (x, y) = (-(X.d (j + 1) (j + 1 + 1)).hom x,
        (β.f (j + 1)).hom x + (Y.d j (j + 1)).hom y) :=
    ⟨fun j => AddMonoidHom.prod ((-(X.d (j + 1) (j + 1 + 1)).hom).comp (AddMonoidHom.fst _ _))
      (((β.f (j + 1)).hom.comp (AddMonoidHom.fst _ _)) +
        ((Y.d j (j + 1)).hom.comp (AddMonoidHom.snd _ _))), fun _ _ _ => rfl⟩
  have ρ1 : ∀ a b (p : X.X a × Y.X b), ρ a b 1 p = p := fun a b p => by
    rw [ρap, act1X, act1Y]
  have ρa : ∀ a b r s (p : X.X a × Y.X b), ρ a b (r + s) p = ρ a b r p + ρ a b s p :=
    fun a b r s p => by rw [ρap, ρap, ρap, actaX, actaY]; rfl
  have ρm : ∀ a b r s (p : X.X a × Y.X b), ρ a b (r * s) p = ρ a b r (ρ a b s p) :=
    fun a b r s p => by rw [ρap, ρap, ρap, actmX, actmY]
  have ρN : ∀ a b (p : X.X a × Y.X b), N • p = 0 := fun a b p =>
    Prod.ext (by rw [Prod.smul_fst]; exact hXN _ _) (by rw [Prod.smul_snd]; exact hYN _ _)
  have ee : ∀ r (x : X.X 0), e (((lamX r).f 0).hom x) = ρ (0 + 1) 0 r (e x) := fun r x => by
    rw [eap, eap, ρap, dXe, βe, map_neg]
  have De : ∀ j r (p : X.X (j + 1) × Y.X j),
      D j (ρ (j + 1) j r p) = ρ (j + 1 + 1) (j + 1) r (D j p) := by
    rintro j r ⟨x, y⟩
    rw [ρap, Dap, Dap, ρap, dXe, βe, dYe, map_neg, map_add]
  have D0e : ∀ x, D 0 (e x) = 0 := fun x => by
    rw [eap, Dap, map_neg, neg_neg, ddX, map_neg, βd, neg_add_cancel]; rfl
  have DD : ∀ j p, D (j + 1) (D j p) = 0 := by
    rintro j ⟨x, y⟩
    rw [Dap, Dap, map_neg, neg_neg, ddX, map_neg, map_add, βd, ddY, add_zero, neg_add_cancel]; rfl
  have einj : ∀ x, e x = 0 → x = 0 := fun x hx => by
    rw [eap, Prod.mk_eq_zero, neg_eq_zero] at hx
    exact INJ0 x hx.1 hx.2
  have kerD0 : ∀ p, D 0 p = 0 → ∃ x, e x = p := by
    rintro ⟨x, y⟩ hp
    rw [Dap, Prod.mk_eq_zero, neg_eq_zero, add_eq_zero_iff_eq_neg, ← map_neg] at hp
    obtain ⟨b, hb1, hb2⟩ := CE0 x (-y) hp.1 hp.2
    refine ⟨-b, ?_⟩
    rw [eap, map_neg, map_neg, neg_neg, hb2, neg_neg]
    exact Prod.ext hb1 rfl
  have kerDS : ∀ j p, D (j + 1) p = 0 → ∃ m, D j m = p := by
    rintro j ⟨x, y⟩ hp
    rw [Dap, Prod.mk_eq_zero, neg_eq_zero, add_eq_zero_iff_eq_neg, ← map_neg] at hp
    obtain ⟨b, w, hb1, hb2⟩ := CES j x (-y) hp.1 hp.2
    refine ⟨(-b, -w), ?_⟩
    rw [Dap, map_neg, map_neg, neg_neg, map_neg, ← neg_add, hb2, neg_neg]
    exact Prod.ext hb1 rfl
  have EXTD : ∀ j (φ : X.X (j + 1) × Y.X j →+ X.X (j + 1) × Y.X j),
      (∀ r p, φ (ρ (j + 1) j r p) = ρ (j + 1) j r (φ p)) → (∀ p, D j p = 0 → φ p = 0) →
      ∃ τ : X.X (j + 1 + 1) × Y.X (j + 1) →+ X.X (j + 1) × Y.X j,
        (∀ r p, τ (ρ (j + 1 + 1) (j + 1) r p) = ρ (j + 1) j r (τ p)) ∧ ∀ p, τ (D j p) = φ p := by
    intro j φ hφ hφ0
    obtain ⟨h₁, h₁l, h₁e⟩ := EA lamX (j + 1) (hXI (j + 1)) (ρ (j + 1) j) (ρ (j + 1 + 1) (j + 1))
      (ρ1 _ _) (ρa _ _) (ρm _ _) (ρN _ _) (D j) (De j) ((AddMonoidHom.fst _ _).comp φ)
      (fun r p => by
        show (φ (ρ (j + 1) j r p)).1 = _
        rw [hφ, ρap]; rfl)
      (fun p hp => by
        show (φ p).1 = 0
        rw [hφ0 p hp]; rfl)
    obtain ⟨h₂, h₂l, h₂e⟩ := EA lamY j (hYI j) (ρ (j + 1) j) (ρ (j + 1 + 1) (j + 1))
      (ρ1 _ _) (ρa _ _) (ρm _ _) (ρN _ _) (D j) (De j) ((AddMonoidHom.snd _ _).comp φ)
      (fun r p => by
        show (φ (ρ (j + 1) j r p)).2 = _
        rw [hφ, ρap]; rfl)
      (fun p hp => by
        show (φ p).2 = 0
        rw [hφ0 p hp]; rfl)
    refine ⟨AddMonoidHom.prod h₁ h₂, fun r p => ?_, fun p => Prod.ext (h₁e p) (h₂e p)⟩
    rw [ρap (j + 1) j r]
    exact Prod.ext (h₁l r p) (h₂l r p)
  obtain ⟨s0, hs0l, hs0e⟩ := EA lamX 0 (hXI 0) (fun r => ((lamX r).f 0).hom) (ρ (0 + 1) 0)
    (ρ1 _ _) (ρa _ _) (ρm _ _) (ρN _ _) e ee (AddMonoidHom.id _) (fun _ _ => rfl)
    (fun v hv => einj v hv)
  obtain ⟨t0, ht0l, ht0e⟩ := EXTD 0 (AddMonoidHom.id _ - e.comp s0)
    (fun r p => by
      simp only [AddMonoidHom.sub_apply, AddMonoidHom.id_apply, AddMonoidHom.comp_apply]
      rw [hs0l, ee, map_sub])
    (fun p hp => by
      obtain ⟨x, rfl⟩ := kerD0 p hp
      simp only [AddMonoidHom.sub_apply, AddMonoidHom.id_apply, AddMonoidHom.comp_apply]
      rw [hs0e, AddMonoidHom.id_apply, sub_self])
  let St : ℕ → Type (u + 1) := fun k =>
    {τ : X.X (k + 1 + 1) × Y.X (k + 1) →+ X.X (k + 1) × Y.X k //
      (∀ r p, τ (ρ (k + 1 + 1) (k + 1) r p) = ρ (k + 1) k r (τ p)) ∧
        ∀ p, D k (τ (D k p)) = D k p}
  have stepEx : ∀ k (σ : St k), ∃ σ' : St (k + 1), ∀ p,
      σ'.1 (D (k + 1) p) + D k (σ.1 p) = p := by
    intro k σ
    obtain ⟨τ', hτ'l, hτ'e⟩ := EXTD (k + 1) (AddMonoidHom.id _ - (D k).comp σ.1)
      (fun r p => by
        simp only [AddMonoidHom.sub_apply, AddMonoidHom.id_apply, AddMonoidHom.comp_apply]
        rw [σ.2.1, De, map_sub])
      (fun p hp => by
        obtain ⟨m, rfl⟩ := kerDS k p hp
        simp only [AddMonoidHom.sub_apply, AddMonoidHom.id_apply, AddMonoidHom.comp_apply]
        rw [σ.2.2, sub_self])
    refine ⟨⟨τ', hτ'l, fun p => ?_⟩, fun p => ?_⟩
    · rw [hτ'e]
      simp only [AddMonoidHom.sub_apply, AddMonoidHom.id_apply, AddMonoidHom.comp_apply]
      rw [map_sub, DD, sub_zero]
    · show τ' _ + _ = p
      rw [hτ'e]
      simp only [AddMonoidHom.sub_apply, AddMonoidHom.id_apply, AddMonoidHom.comp_apply]
      exact sub_add_cancel _ _
  choose step hstep using stepEx
  let base : St 0 := ⟨t0, ht0l, fun p => by
    rw [ht0e]
    simp only [AddMonoidHom.sub_apply, AddMonoidHom.id_apply, AddMonoidHom.comp_apply]
    rw [map_sub, D0e, sub_zero]⟩
  let seq : ∀ k, St k := fun k => Nat.rec (motive := fun k => St k) base (fun k σ => step k σ) k
  refine EXT s0 (fun k => (seq k).1) (fun r x y => ?_) (fun k r x y => ?_) (fun x => ?_)
    (fun x y => ?_) (fun k x y => ?_)
  · have := hs0l r (x, y)
    rw [ρap] at this
    exact this
  · have := (seq k).2.1 r (x, y)
    rw [ρap, ρap] at this
    exact this
  · have := hs0e x
    rw [eap] at this
    exact this
  · have := ht0e (x, y)
    simp only [AddMonoidHom.sub_apply, AddMonoidHom.id_apply, AddMonoidHom.comp_apply] at this
    rw [Dap, eap] at this
    show t0 _ + _ = _
    rw [this]
    exact sub_add_cancel _ _
  · have := hstep k (seq k) (x, y)
    rw [Dap, Dap] at this
    exact this

theorem wcU_sms_bar_relinj (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Γ : Type u) [Group Γ] [Fintype Γ]
    (n : ℕ) (hn : 1 ≤ n) (P : wcGModel ℓ Γ) :
    wcRingAct (wcSmsBarSmul P n) ∧ (∀ k (v : (wcSmsBar P n).X k), (ℓ ^ n) • v = 0) ∧
    (∀ x, wcSmsBarSmul P n x ≫ wcSmsBarFrob P n = wcSmsBarFrob P n ≫ wcSmsBarSmul P n x) ∧
    ∀ k, wcSmsRelInj (wcSmsBarSmul P n) (ℓ ^ n) k :=
by
  classical
  haveI hNZ : NeZero (ℓ ^ n) := ⟨pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero⟩

  have s4 : ∀ (N : ℕ) (hN : 0 < N) {A B : Type (u+1)} [AddCommGroup A] [AddCommGroup B]
      (i : A →+ B) (hi : Function.Injective i) (hB : ∀ b : B, N • b = 0) (θ : A →+ ZMod N),
      ∃ Θ : B →+ ZMod N, ∀ a, Θ (i a) = θ a := by
    intro N hN A B _ _ i hi hB θ
    haveI : NeZero N := ⟨hN.ne'⟩
    have hj : Function.Injective (ZMod.toAddCircle (N := N)) := ZMod.toAddCircle_injective N
    have hBaer : Module.Baer ℤ UnitAddCircle := Module.Baer.of_divisible _
    obtain ⟨Φ, hΦ⟩ := Module.Baer.extension_property hBaer i.toIntLinearMap hi
      ((ZMod.toAddCircle (N := N)).comp θ).toIntLinearMap
    have himg : ∀ y : UnitAddCircle, N • y = 0 → ∃ k : ZMod N, ZMod.toAddCircle k = y := by
      intro y hy
      obtain ⟨x, rfl⟩ : ∃ x : ℝ, (x : UnitAddCircle) = y := QuotientAddGroup.mk_surjective y
      rw [← AddCircle.coe_nsmul, AddCircle.coe_eq_zero_iff] at hy
      obtain ⟨z, hz⟩ := hy
      refine ⟨(z : ZMod N), ?_⟩
      rw [ZMod.toAddCircle_intCast]
      congr 1
      have hN' : (N : ℝ) ≠ 0 := by exact_mod_cast hN.ne'
      rw [zsmul_eq_mul, mul_one, nsmul_eq_mul] at hz
      rw [hz]
      field_simp
    have hΦN : ∀ b, N • Φ b = 0 := fun b => by rw [← map_nsmul, hB, map_zero]
    choose k hk using fun b => himg (Φ b) (hΦN b)
    refine ⟨{ toFun := k
              map_zero' := hj (by rw [hk, map_zero, map_zero])
              map_add' := fun x y => hj (by rw [map_add, hk, hk, hk, map_add]) }, fun a => hj ?_⟩
    show ZMod.toAddCircle (k (i a)) = ZMod.toAddCircle (θ a)
    rw [hk]
    have := LinearMap.congr_fun hΦ a
    simpa using this

  have s5 : ∀ (A B : ModuleCat.{u+1} (MonoidAlgebra ℤ_[ℓ] Γ)) (i : A ⟶ B)
      (hB : ∀ b : B, (ℓ ^ n) • b = 0)
      (g : A →+ MonoidAlgebra (ZMod (ℓ ^ n)) Γ)
      (hg : ∀ (r : MonoidAlgebra ℤ_[ℓ] Γ) (a : A), g (r • a) = wcSmsRed ℓ n Γ r * g a)
      (Θ : B →+ ZMod (ℓ ^ n)) (hΘ : ∀ a : A, Θ (i.hom a) = (g a).coeff 1),
      ∃ h : B →+ MonoidAlgebra (ZMod (ℓ ^ n)) Γ,
        (∀ (r : MonoidAlgebra ℤ_[ℓ] Γ) (b : B), h (r • b) = wcSmsRed ℓ n Γ r * h b) ∧
        ∀ a : A, h (i.hom a) = g a := by
    intro A B i hB g hg Θ hΘ
    have hred : ∀ (γ : Γ) (c : ℤ_[ℓ]), wcSmsRed ℓ n Γ (MonoidAlgebra.single γ c) =
        MonoidAlgebra.single γ (PadicInt.toZModPow n c) := fun γ c =>
      MonoidAlgebra.mapRingHom_single _ _ _
    let ψ : B →+ MonoidAlgebra (ZMod (ℓ ^ n)) Γ :=
      { toFun := fun b => ∑ t : Γ,
          MonoidAlgebra.single t (Θ (MonoidAlgebra.single t⁻¹ (1 : ℤ_[ℓ]) • b))
        map_zero' := by simp
        map_add' := fun x y => by
          simp only [smul_add, map_add, MonoidAlgebra.single_add, Finset.sum_add_distrib] }
    have hCF : ∀ b t, (ψ b).coeff t = Θ (MonoidAlgebra.single t⁻¹ (1 : ℤ_[ℓ]) • b) := by
      intro b t
      simp [ψ, MonoidAlgebra.coeff_sum, Finsupp.finset_sum_apply, MonoidAlgebra.coeff_single,
        Finsupp.single_apply]
    have stepA : ∀ (γ : Γ) (c : ℤ_[ℓ]) (b : B), MonoidAlgebra.single γ c • b =
        (PadicInt.toZModPow n c).val • (MonoidAlgebra.single γ (1 : ℤ_[ℓ]) • b) := by
      intro γ c b
      have hmem : c - ((PadicInt.toZModPow n c).val : ℤ_[ℓ]) ∈
          RingHom.ker (PadicInt.toZModPow (p := ℓ) n) := by
        rw [RingHom.mem_ker, map_sub, map_natCast, ZMod.natCast_zmod_val, sub_self]
      rw [PadicInt.ker_toZModPow, Ideal.mem_span_singleton'] at hmem
      obtain ⟨t, ht⟩ := hmem
      have hc : c = ((PadicInt.toZModPow n c).val : ℤ_[ℓ]) + ((ℓ ^ n : ℕ) : ℤ_[ℓ]) * t := by
        push_cast; rw [mul_comm, ht]; ring
      have hs : MonoidAlgebra.single γ c =
          (((PadicInt.toZModPow n c).val : ℕ) : MonoidAlgebra ℤ_[ℓ] Γ) * MonoidAlgebra.single γ 1 +
          ((ℓ ^ n : ℕ) : MonoidAlgebra ℤ_[ℓ] Γ) * MonoidAlgebra.single γ t := by
        rw [MonoidAlgebra.natCast_def, MonoidAlgebra.natCast_def, MonoidAlgebra.single_mul_single,
          MonoidAlgebra.single_mul_single, one_mul, mul_one, ← MonoidAlgebra.single_add, ← hc]
      rw [hs, add_smul, mul_smul, mul_smul, Nat.cast_smul_eq_nsmul, Nat.cast_smul_eq_nsmul, hB,
        add_zero]
    refine ⟨ψ, ?_, ?_⟩
    · intro r b
      induction r using MonoidAlgebra.induction_linear with
      | zero => simp
      | add x y hx hy => rw [add_smul, map_add, hx, hy, map_add, add_mul]
      | single γ c =>
        apply MonoidAlgebra.ext
        ext t
        rw [hCF, hred, MonoidAlgebra.coeff_single_mul_apply, hCF,
          ← mul_smul, MonoidAlgebra.single_mul_single, one_mul, stepA, map_nsmul, nsmul_eq_mul,
          ZMod.natCast_zmod_val, mul_inv_rev, inv_inv]
    · intro a
      apply MonoidAlgebra.ext
      ext t
      rw [hCF, ← i.hom.map_smul, hΘ, hg, hred,
        RingHom.map_one (PadicInt.toZModPow (p := ℓ) n),
        MonoidAlgebra.coeff_single_mul_apply, one_mul, inv_inv, mul_one]

  let E : ∀ k, (wcSmsBar P n).X k →+ (Fin (P.k k) → MonoidAlgebra (ZMod (ℓ ^ n)) Γ) :=
    fun k => (wcIdemSub ((P.ε k).map (wcSmsRed ℓ n Γ))).subtype.comp
      (AddEquiv.ulift (α := ↥(wcIdemSub ((P.ε k).map (wcSmsRed ℓ n Γ))))).toAddMonoidHom
  have hEinj : ∀ k, Function.Injective (E k) := fun k a b h => ULift.ext _ _ (Subtype.ext h)
  have hES : ∀ x k (y : (wcSmsBar P n).X k),
      E k (((wcSmsBarSmul P n x).f k).hom y) = wcSmsRed ℓ n Γ x • E k y := fun _ _ _ => rfl
  have hEF : ∀ k (y : (wcSmsBar P n).X k),
      E k (((wcSmsBarFrob P n).f k).hom y) =
        Matrix.vecMul (E k y) ((P.f k).map (wcSmsRed ℓ n Γ)) := fun _ _ => rfl
  have hEmem : ∀ k (y : (wcSmsBar P n).X k),
      Matrix.vecMul (E k y) ((P.ε k).map (wcSmsRed ℓ n Γ)) = E k y := fun k y =>
    (ULift.down (α := ↥(wcIdemSub ((P.ε k).map (wcSmsRed ℓ n Γ)))) y).2
  have hlift : ∀ k {M : Type (u+1)} [AddCommGroup M]
      (F : M →+ (Fin (P.k k) → MonoidAlgebra (ZMod (ℓ ^ n)) Γ))
      (hF : ∀ b, Matrix.vecMul (F b) ((P.ε k).map (wcSmsRed ℓ n Γ)) = F b),
      ∃ h : M →+ (wcSmsBar P n).X k, ∀ b, E k (h b) = F b := by
    intro k M _ F hF
    exact ⟨(AddEquiv.ulift (α := ↥(wcIdemSub ((P.ε k).map (wcSmsRed ℓ n Γ))))).symm.toAddMonoidHom.comp
      (F.codRestrict (wcIdemSub ((P.ε k).map (wcSmsRed ℓ n Γ))) hF), fun b => rfl⟩
  clear_value E
  have hext : ∀ f g : wcSmsBar P n ⟶ wcSmsBar P n,
      (∀ k y, E k ((f.f k).hom y) = E k ((g.f k).hom y)) → f = g := fun f g h =>
    HomologicalComplex.hom_ext _ _ (fun k => AddCommGrpCat.ext (fun y => hEinj k (h k y)))
  refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_, ?_⟩
  ·
    apply hext
    intro k y
    rw [hES, map_one, one_smul]
    rfl
  ·
    intro a b
    apply hext
    intro k y
    rw [HomologicalComplex.add_f_apply, AddCommGrpCat.hom_add, AddMonoidHom.add_apply, map_add,
      hES, hES, hES, map_add, add_smul]
  ·
    intro a b
    apply hext
    intro k y
    rw [HomologicalComplex.comp_f, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, hES, hES, hES,
      map_mul, mul_smul]
  ·
    intro k v
    apply hEinj k
    rw [map_nsmul, map_zero]
    funext a
    rw [Pi.smul_apply, nsmul_eq_mul, MonoidAlgebra.natCast_def, ZMod.natCast_self,
      MonoidAlgebra.single_zero, zero_mul]
    rfl
  ·
    intro x
    apply hext
    intro k y
    rw [HomologicalComplex.comp_f, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, hEF, hES,
      HomologicalComplex.comp_f, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, hES, hEF,
      Matrix.smul_vecMul]
  ·
    intro k A B i hi hB g hg
    let ga : Fin (P.k k) → (A →+ MonoidAlgebra (ZMod (ℓ ^ n)) Γ) := fun a =>
      (Pi.evalAddMonoidHom (fun _ => MonoidAlgebra (ZMod (ℓ ^ n)) Γ) a).comp ((E k).comp g)
    have hga : ∀ a (r : MonoidAlgebra ℤ_[ℓ] Γ) (x : A),
        ga a (r • x) = wcSmsRed ℓ n Γ r * ga a x := by
      intro a r x
      show E k (g (r • x)) a = wcSmsRed ℓ n Γ r * E k (g x) a
      rw [hg r x, hES]
      rfl
    have hex : ∀ a, ∃ h : B →+ MonoidAlgebra (ZMod (ℓ ^ n)) Γ,
        (∀ (r : MonoidAlgebra ℤ_[ℓ] Γ) (b : B), h (r • b) = wcSmsRed ℓ n Γ r * h b) ∧
        ∀ x : A, h (i.hom x) = ga a x := by
      intro a
      let θ : A →+ ZMod (ℓ ^ n) :=
        (Finsupp.applyAddHom (1 : Γ)).comp
          ((MonoidAlgebra.coeffAddEquiv).toAddMonoidHom.comp (ga a))
      obtain ⟨Θ, hΘ⟩ := s4 (ℓ ^ n) (pow_pos (Fact.out : ℓ.Prime).pos n) i.hom.toAddMonoidHom hi
        hB θ
      exact s5 A B i hB (ga a) (hga a) Θ (fun x => hΘ x)
    choose ψ hψlin hψext using hex
    let F : B →+ (Fin (P.k k) → MonoidAlgebra (ZMod (ℓ ^ n)) Γ) :=
      { toFun := fun b => Matrix.vecMul (fun a => ψ a b) ((P.ε k).map (wcSmsRed ℓ n Γ))
        map_zero' := by
          show Matrix.vecMul (fun a => ψ a 0) ((P.ε k).map (wcSmsRed ℓ n Γ)) = 0
          simp only [map_zero]
          exact Matrix.zero_vecMul _
        map_add' := fun x y => by
          simp only [map_add]
          rw [← Matrix.add_vecMul]
          rfl }
    have hF : ∀ b, Matrix.vecMul (F b) ((P.ε k).map (wcSmsRed ℓ n Γ)) = F b := by
      intro b
      show Matrix.vecMul (Matrix.vecMul (fun a => ψ a b) ((P.ε k).map (wcSmsRed ℓ n Γ)))
          ((P.ε k).map (wcSmsRed ℓ n Γ)) = _
      rw [Matrix.vecMul_vecMul, ← Matrix.map_mul, P.hε k]
      rfl
    obtain ⟨h, hh⟩ := hlift k F hF
    refine ⟨h, ?_, ?_⟩
    · intro r b
      apply hEinj k
      rw [hh, hES, hh]
      show Matrix.vecMul (fun a => ψ a (r • b)) ((P.ε k).map (wcSmsRed ℓ n Γ)) =
        wcSmsRed ℓ n Γ r • Matrix.vecMul (fun a => ψ a b) ((P.ε k).map (wcSmsRed ℓ n Γ))
      rw [← Matrix.smul_vecMul]
      congr 1
      funext a
      rw [hψlin]
      rfl
    · intro x
      apply hEinj k
      rw [hh]
      show Matrix.vecMul (fun a => ψ a (i.hom x)) ((P.ε k).map (wcSmsRed ℓ n Γ)) = E k (g x)
      have hfun : (fun a => ψ a (i.hom x)) = E k (g x) := funext fun a => hψext a x
      rw [hfun, hEmem]

theorem wcU_sms_trunc_relinj {R : Type u} [Ring R] (D : CochainComplex AddCommGrpCat.{u+1} ℕ)
    (lamD : R → (D ⟶ D)) (hD : wcRingAct lamD) (hI : ∀ k, wcChmpInjD lamD k) (N : ℕ)
    (hN : 1 ≤ N) (h0 : ∀ y : D.X 0, (D.d 0 1).hom y = 0 → N • y = 0 → y = 0) :
    (∀ k (w : (wcTruncKerRes D N).X k), N • w = 0) ∧
    ∀ k, wcSmsRelInj (fun x => wcSpfTruncMap D N (lamD x)) N k :=
by
  classical

  have hι_inj : ∀ m, Function.Injective (Limits.kernel.ι (N • 𝟙 (D.X m))).hom := fun m =>
    (AddCommGrpCat.mono_iff_injective _).1 inferInstance
  have hK2 : ∀ m (z : (Limits.kernel (N • 𝟙 (D.X m)) : AddCommGrpCat.{u+1})),
      N • (Limits.kernel.ι (N • 𝟙 (D.X m))).hom z = 0 := by
    intro m z
    have h : ((Limits.kernel.ι (N • 𝟙 (D.X m))) ≫ (N • 𝟙 (D.X m))).hom z = 0 := by
      rw [Limits.kernel.condition]; rfl
    first | exact h | simpa using h
  have hT : ∀ m (z : (Limits.kernel (N • 𝟙 (D.X m)) : AddCommGrpCat.{u+1})), N • z = 0 := fun m z =>
    hι_inj m (by rw [map_nsmul, hK2, map_zero])
  have hK3 : ∀ m x, wcSpfKerMap D N (lamD x) m ≫ Limits.kernel.ι (N • 𝟙 (D.X m)) =
      Limits.kernel.ι (N • 𝟙 (D.X m)) ≫ (lamD x).f m := by
    intro m x
    dsimp only [wcSpfKerMap, Limits.kernel.map]
    exact Limits.kernel.lift_ι _ _ _
  have hK3e : ∀ m x (z : (Limits.kernel (N • 𝟙 (D.X m)) : AddCommGrpCat.{u+1})),
      (Limits.kernel.ι (N • 𝟙 (D.X m))).hom ((wcSpfKerMap D N (lamD x) m).hom z) =
        ((lamD x).f m).hom ((Limits.kernel.ι (N • 𝟙 (D.X m))).hom z) := fun m x z =>
    congrArg (fun f => AddCommGrpCat.Hom.hom f z) (hK3 m x)
  have hK4 : wcTruncKerD D N 0 ≫ Limits.kernel.ι (N • 𝟙 (D.X 1)) =
      Limits.kernel.ι (N • 𝟙 (D.X 0)) ≫ D.d 0 1 := by
    dsimp only [wcTruncKerD, Limits.kernel.map]
    exact Limits.kernel.lift_ι _ _ _
  have hK4e : ∀ z : (Limits.kernel (N • 𝟙 (D.X 0)) : AddCommGrpCat.{u+1}),
      (Limits.kernel.ι (N • 𝟙 (D.X 1))).hom ((wcTruncKerD D N 0).hom z) =
        (D.d 0 1).hom ((Limits.kernel.ι (N • 𝟙 (D.X 0))).hom z) := fun z =>
    congrArg (fun f => AddCommGrpCat.Hom.hom f z) hK4

  have KRI : ∀ m, ∀ (A B : ModuleCat.{u+1} R) (i : A ⟶ B), Function.Injective i.hom →
      (∀ b : B, N • b = 0) →
      ∀ g : A →+ (Limits.kernel (N • 𝟙 (D.X m)) : AddCommGrpCat.{u+1}),
      (∀ (x : R) (a : A), g (x • a) = (wcSpfKerMap D N (lamD x) m).hom (g a)) →
      ∃ h : B →+ (Limits.kernel (N • 𝟙 (D.X m)) : AddCommGrpCat.{u+1}),
        (∀ (x : R) (b : B), h (x • b) = (wcSpfKerMap D N (lamD x) m).hom (h b)) ∧
        ∀ a : A, h (i.hom a) = g a := by
    intro m A B i hi hB g hg
    obtain ⟨h', hh'l, hh'e⟩ := hI m A B i hi ((Limits.kernel.ι (N • 𝟙 (D.X m))).hom.comp g)
      (by
        intro x a
        show (Limits.kernel.ι (N • 𝟙 (D.X m))).hom (g (x • a)) =
          ((lamD x).f m).hom ((Limits.kernel.ι (N • 𝟙 (D.X m))).hom (g a))
        rw [hg, hK3e])
    have hh'N : ∀ b, N • h' b = 0 := fun b => by rw [← map_nsmul, hB, map_zero]
    have hlift : (AddCommGrpCat.ofHom h' : AddCommGrpCat.of B ⟶ D.X m) ≫ (N • 𝟙 (D.X m)) = 0 :=
      AddCommGrpCat.ext fun b => by first | exact hh'N b | simpa using hh'N b
    have hφ : ∀ b : B, (Limits.kernel.ι (N • 𝟙 (D.X m))).hom
        ((Limits.kernel.lift (N • 𝟙 (D.X m)) _ hlift).hom b) = h' b := fun b =>
      congrArg (fun f => AddCommGrpCat.Hom.hom f b) (Limits.kernel.lift_ι (N • 𝟙 (D.X m)) _ hlift)
    refine ⟨(Limits.kernel.lift (N • 𝟙 (D.X m)) _ hlift).hom, ?_, ?_⟩
    · intro x b
      apply hι_inj m
      rw [hφ, hK3e, hφ]
      exact hh'l x b
    · intro a
      apply hι_inj m
      rw [hφ]
      exact hh'e a
  refine ⟨?_, ?_⟩
  ·
    intro k
    cases k with
    | zero =>
      intro w
      have hπs : Function.Surjective (Limits.cokernel.π (wcTruncKerD D N 0)).hom :=
        (AddCommGrpCat.epi_iff_surjective _).1 inferInstance
      obtain ⟨y, rfl⟩ := hπs w
      show N • (Limits.cokernel.π (wcTruncKerD D N 0)).hom y = 0
      rw [← map_nsmul, hT 1 y, map_zero]
    | succ k =>
      intro w
      exact hT (k + 2) w
  · intro k
    cases k with
    | succ k =>
      intro A B i hi hB g hg
      exact KRI (k + 2) A B i hi hB g hg
    | zero =>

      have hκ1 : ∀ m, wcSpfKerMap D N (lamD 1) m = 𝟙 _ := fun m => by
        rw [← cancel_mono (Limits.kernel.ι (N • 𝟙 (D.X m))), hK3, hD.1, HomologicalComplex.id_f,
          Category.id_comp, Category.comp_id]
      have hκadd : ∀ m a b, wcSpfKerMap D N (lamD (a + b)) m =
          wcSpfKerMap D N (lamD a) m + wcSpfKerMap D N (lamD b) m := fun m a b => by
        rw [← cancel_mono (Limits.kernel.ι (N • 𝟙 (D.X m))), hK3, Preadditive.add_comp, hK3, hK3,
          hD.2.1, HomologicalComplex.add_f_apply, Preadditive.comp_add]
      have hκmul : ∀ m a b, wcSpfKerMap D N (lamD (a * b)) m =
          wcSpfKerMap D N (lamD b) m ≫ wcSpfKerMap D N (lamD a) m := fun m a b => by
        rw [← cancel_mono (Limits.kernel.ι (N • 𝟙 (D.X m))), hK3, Category.assoc, hK3,
          ← Category.assoc, hK3, Category.assoc, hD.2.2, HomologicalComplex.comp_f]
      have hκ0 : ∀ m, wcSpfKerMap D N (lamD 0) m = 0 := fun m => by
        have h := hκadd m 0 0
        rw [add_zero] at h
        exact add_left_cancel (h.symm.trans (add_zero _).symm)
      have hjlin : ∀ x, wcTruncKerD D N 0 ≫ wcSpfKerMap D N (lamD x) 1 =
          wcSpfKerMap D N (lamD x) 0 ≫ wcTruncKerD D N 0 := fun x => by
        rw [← cancel_mono (Limits.kernel.ι (N • 𝟙 (D.X 1))), Category.assoc, hK3,
          reassoc_of% hK4, Category.assoc, hK4, reassoc_of% (hK3 0 x), (lamD x).comm 0 1]
      have hjlin_e : ∀ x (z : (Limits.kernel (N • 𝟙 (D.X 0)) : AddCommGrpCat.{u+1})),
          (wcSpfKerMap D N (lamD x) 1).hom ((wcTruncKerD D N 0).hom z) =
            (wcTruncKerD D N 0).hom ((wcSpfKerMap D N (lamD x) 0).hom z) := fun x z =>
        congrArg (fun f => AddCommGrpCat.Hom.hom f z) (hjlin x)
      let φ : ∀ m, R →+* AddMonoid.End ↑(Limits.kernel (N • 𝟙 (D.X m))) := fun m =>
        { toFun := fun x => ((wcSpfKerMap D N (lamD x) m).hom : AddMonoid.End _)
          map_one' := AddMonoidHom.ext fun z => by
            show (wcSpfKerMap D N (lamD 1) m).hom z = z
            rw [hκ1] <;> rfl
          map_mul' := fun a b => AddMonoidHom.ext fun z => by
            show (wcSpfKerMap D N (lamD (a * b)) m).hom z =
              (wcSpfKerMap D N (lamD a) m).hom ((wcSpfKerMap D N (lamD b) m).hom z)
            rw [hκmul] <;> rfl
          map_zero' := AddMonoidHom.ext fun z => by
            show (wcSpfKerMap D N (lamD 0) m).hom z = 0
            rw [hκ0] <;> rfl
          map_add' := fun a b => AddMonoidHom.ext fun z => by
            show (wcSpfKerMap D N (lamD (a + b)) m).hom z =
              (wcSpfKerMap D N (lamD a) m).hom z + (wcSpfKerMap D N (lamD b) m).hom z
            rw [hκadd] <;> rfl }

      obtain ⟨r, hr, hrl⟩ : ∃ r : Limits.kernel (N • 𝟙 (D.X 1)) ⟶ Limits.kernel (N • 𝟙 (D.X 0)),
          wcTruncKerD D N 0 ≫ r = 𝟙 _ ∧
            ∀ x : R, wcSpfKerMap D N (lamD x) 1 ≫ r = r ≫ wcSpfKerMap D N (lamD x) 0 := by
        letI M0 : Module R ↑(Limits.kernel (N • 𝟙 (D.X 0))) := Module.compHom _ (φ 0)
        letI M1 : Module R ↑(Limits.kernel (N • 𝟙 (D.X 1))) := Module.compHom _ (φ 1)
        let i : ModuleCat.of R ↑(Limits.kernel (N • 𝟙 (D.X 0))) ⟶
            ModuleCat.of R ↑(Limits.kernel (N • 𝟙 (D.X 1))) :=
          ModuleCat.ofHom
            { toFun := (wcTruncKerD D N 0).hom
              map_add' := map_add _
              map_smul' := fun x z => (hjlin_e x z).symm }
        have hi : Function.Injective i.hom := by
          rw [injective_iff_map_eq_zero]
          intro z hz
          have hz' : (wcTruncKerD D N 0).hom z = 0 := hz
          apply hι_inj 0
          rw [map_zero]
          apply h0
          · rw [← hK4e, hz', map_zero]
          · exact hK2 0 z
        obtain ⟨r', hr'l, hr'e⟩ := KRI 0 _ _ i hi (fun b => hT 1 b)
          { toFun := fun a => a, map_zero' := rfl, map_add' := fun _ _ => rfl } (fun x a => rfl)
        refine ⟨AddCommGrpCat.ofHom r', ?_, fun x => ?_⟩
        · exact AddCommGrpCat.ext fun z => hr'e z
        · exact AddCommGrpCat.ext fun y => hr'l x y

      have he : wcTruncKerD D N 0 ≫ (𝟙 _ - r ≫ wcTruncKerD D N 0) = 0 := by
        rw [Preadditive.comp_sub, Category.comp_id, ← Category.assoc, hr, Category.id_comp,
          sub_self]
      obtain ⟨s, hS1⟩ : ∃ s : Limits.cokernel (wcTruncKerD D N 0) ⟶ Limits.kernel (N • 𝟙 (D.X 1)),
          Limits.cokernel.π (wcTruncKerD D N 0) ≫ s = 𝟙 _ - r ≫ wcTruncKerD D N 0 :=
        ⟨_, Limits.cokernel.π_desc _ _ he⟩
      have hS2 : s ≫ Limits.cokernel.π (wcTruncKerD D N 0) = 𝟙 _ := by
        rw [← cancel_epi (Limits.cokernel.π (wcTruncKerD D N 0)), ← Category.assoc, hS1,
          Preadditive.sub_comp, Category.id_comp, Category.assoc, Limits.cokernel.condition,
          Limits.comp_zero, sub_zero, Category.comp_id]
      let μ : ∀ x : R, Limits.cokernel (wcTruncKerD D N 0) ⟶ Limits.cokernel (wcTruncKerD D N 0) :=
        fun x => (wcSpfTruncMap D N (lamD x)).f 0
      have hC3 : ∀ x, Limits.cokernel.π (wcTruncKerD D N 0) ≫ μ x =
          wcSpfKerMap D N (lamD x) 1 ≫ Limits.cokernel.π (wcTruncKerD D N 0) := fun x => by
        show Limits.cokernel.π (wcTruncKerD D N 0) ≫ wcSpfTruncMapF D N (lamD x) 0 = _
        exact Limits.cokernel.π_desc _ _ _
      have hS3 : ∀ x, μ x ≫ s = s ≫ wcSpfKerMap D N (lamD x) 1 :=
          fun x => by
        rw [← cancel_epi (Limits.cokernel.π (wcTruncKerD D N 0)), reassoc_of% (hC3 x), hS1,
          ← Category.assoc, hS1, Preadditive.comp_sub, Preadditive.sub_comp, Category.comp_id,
          Category.id_comp, ← Category.assoc, hrl x, Category.assoc, Category.assoc, ← hjlin x]
      intro A B i hi hB g hg
      obtain ⟨h', hh'l, hh'e⟩ := KRI 1 A B i hi hB (s.hom.comp g) (fun x a => by
        show s.hom (g (x • a)) = (wcSpfKerMap D N (lamD x) 1).hom (s.hom (g a))
        rw [hg x a]
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f (g a)) (hS3 x))
      refine ⟨(Limits.cokernel.π (wcTruncKerD D N 0)).hom.comp h', fun x b => ?_, fun a => ?_⟩
      · show (Limits.cokernel.π (wcTruncKerD D N 0)).hom (h' (x • b)) =
          ((wcSpfTruncMap D N (lamD x)).f 0).hom ((Limits.cokernel.π (wcTruncKerD D N 0)).hom (h' b))
        rw [hh'l x b]
        exact (congrArg (fun f => AddCommGrpCat.Hom.hom f (h' b)) (hC3 x)).symm
      · show (Limits.cokernel.π (wcTruncKerD D N 0)).hom (h' (i.hom a)) = g a
        rw [hh'e a]
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f (g a)) hS2

theorem wcU_sms_trunc_map_func {C : Type*} [Category C] [Abelian C] (Y : CochainComplex C ℕ)
    (N : ℕ) :
    wcSpfTruncMap Y N (𝟙 Y) = 𝟙 _ ∧
    (∀ g g' : Y ⟶ Y, wcSpfTruncMap Y N (g ≫ g') = wcSpfTruncMap Y N g ≫ wcSpfTruncMap Y N g') ∧
    (∀ g g' : Y ⟶ Y, wcSpfTruncMap Y N (g + g') = wcSpfTruncMap Y N g + wcSpfTruncMap Y N g') :=
by
  have hK1 : ∀ j, wcSpfKerMap Y N (𝟙 Y) j = 𝟙 _ := fun j => by
    apply Limits.equalizer.hom_ext
    simp [wcSpfKerMap, Limits.kernel.map]
  have hK2 : ∀ (g g' : Y ⟶ Y) j,
      wcSpfKerMap Y N (g ≫ g') j = wcSpfKerMap Y N g j ≫ wcSpfKerMap Y N g' j := fun g g' j => by
    apply Limits.equalizer.hom_ext
    simp [wcSpfKerMap, Limits.kernel.map]
  have hK3 : ∀ (g g' : Y ⟶ Y) j,
      wcSpfKerMap Y N (g + g') j = wcSpfKerMap Y N g j + wcSpfKerMap Y N g' j := fun g g' j => by
    apply Limits.equalizer.hom_ext
    simp [wcSpfKerMap, Limits.kernel.map]
  have hC1 : ∀ {A B : C} (f : A ⟶ B) (P : A ⟶ A) (Q : B ⟶ B) (hP : P = 𝟙 A) (hQ : Q = 𝟙 B)
      (w : f ≫ Q = P ≫ f), Limits.cokernel.map f f P Q w = 𝟙 _ := by
    intro A B f P Q hP hQ w
    subst hP hQ
    apply Limits.coequalizer.hom_ext
    simp [Limits.cokernel.map]
  have hC2 : ∀ {A B : C} (f : A ⟶ B) (P p p' : A ⟶ A) (Q q q' : B ⟶ B)
      (hP : P = p ≫ p') (hQ : Q = q ≫ q') (w : f ≫ Q = P ≫ f) (w1 : f ≫ q = p ≫ f)
      (w2 : f ≫ q' = p' ≫ f),
      Limits.cokernel.map f f P Q w =
        Limits.cokernel.map f f p q w1 ≫ Limits.cokernel.map f f p' q' w2 := by
    intro A B f P p p' Q q q' hP hQ w w1 w2
    subst hP hQ
    apply Limits.coequalizer.hom_ext
    simp [Limits.cokernel.map]
  have hC3 : ∀ {A B : C} (f : A ⟶ B) (P p p' : A ⟶ A) (Q q q' : B ⟶ B)
      (hP : P = p + p') (hQ : Q = q + q') (w : f ≫ Q = P ≫ f) (w1 : f ≫ q = p ≫ f)
      (w2 : f ≫ q' = p' ≫ f),
      Limits.cokernel.map f f P Q w =
        Limits.cokernel.map f f p q w1 + Limits.cokernel.map f f p' q' w2 := by
    intro A B f P p p' Q q q' hP hQ w w1 w2
    subst hP hQ
    apply Limits.coequalizer.hom_ext
    simp [Limits.cokernel.map]
  refine ⟨?_, fun g g' => ?_, fun g g' => ?_⟩
  · ext k
    cases k with
    | zero =>
      show wcSpfTruncMapF Y N (𝟙 Y) 0 = 𝟙 _
      simp only [wcSpfTruncMapF]
      exact hC1 _ _ _ (hK1 0) (hK1 1) _
    | succ k =>
      show wcSpfTruncMapF Y N (𝟙 Y) (k + 1) = 𝟙 _
      exact hK1 (k + 2)
  · ext k
    cases k with
    | zero =>
      show wcSpfTruncMapF Y N (g ≫ g') 0 = wcSpfTruncMapF Y N g 0 ≫ wcSpfTruncMapF Y N g' 0
      simp only [wcSpfTruncMapF]
      exact hC2 _ _ _ _ _ _ _ (hK2 g g' 0) (hK2 g g' 1) _ _ _
    | succ k =>
      show wcSpfTruncMapF Y N (g ≫ g') (k + 1) =
        wcSpfTruncMapF Y N g (k + 1) ≫ wcSpfTruncMapF Y N g' (k + 1)
      exact hK2 g g' (k + 2)
  · ext k
    cases k with
    | zero =>
      show wcSpfTruncMapF Y N (g + g') 0 = wcSpfTruncMapF Y N g 0 + wcSpfTruncMapF Y N g' 0
      simp only [wcSpfTruncMapF]
      exact hC3 _ _ _ _ _ _ _ (hK3 g g' 0) (hK3 g g' 1) _ _ _
    | succ k =>
      show wcSpfTruncMapF Y N (g + g') (k + 1) =
        wcSpfTruncMapF Y N g (k + 1) + wcSpfTruncMapF Y N g' (k + 1)
      exact hK3 g g' (k + 2)

theorem wcU_sms_tw_htpy {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {Γ : Type u} [Group Γ] [Fintype Γ] {n r : ℕ} (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n)))
    {Y Y' : CochainComplex 𝒜 ℕ} (lamY : MonoidAlgebra ℤ_[ℓ] Γ → (Y ⟶ Y))
    (lamY' : MonoidAlgebra ℤ_[ℓ] Γ → (Y' ⟶ Y')) (u u' : Y ⟶ Y')
    (hu : ∀ x, lamY x ≫ u = u ≫ lamY' x) (hu' : ∀ x, lamY x ≫ u' = u' ≫ lamY' x)
    (h : Homotopy u u') (hh : ∀ x i j, (lamY x).f i ≫ h.hom i j = h.hom i j ≫ (lamY' x).f j) :
    Nonempty (Homotopy (wcSmsTwMap ρ u hu) (wcSmsTwMap ρ u' hu')) :=
by
  obtain ⟨ιY, ιY', H, mY', dY, dY', kUu, kUu', kH⟩ :
      ∃ (ιY : ∀ k, (wcSpfTwCx Y lamY ρ).X k ⟶ ∏ᶜ (fun _ : Fin r => Y.X k))
        (ιY' : ∀ k, (wcSpfTwCx Y' lamY' ρ).X k ⟶ ∏ᶜ (fun _ : Fin r => Y'.X k))
        (H : ∀ i j, (wcSpfTwCx Y lamY ρ).X i ⟶ (wcSpfTwCx Y' lamY' ρ).X j),
        (∀ k, Mono (ιY' k)) ∧
        (∀ k, (wcSpfTwCx Y lamY ρ).d k (k + 1) ≫ ιY (k + 1) =
          ιY k ≫ Limits.Pi.map (fun _ => Y.d k (k + 1))) ∧
        (∀ k, (wcSpfTwCx Y' lamY' ρ).d k (k + 1) ≫ ιY' (k + 1) =
          ιY' k ≫ Limits.Pi.map (fun _ => Y'.d k (k + 1))) ∧
        (∀ k, (wcSmsTwMap ρ u hu).f k ≫ ιY' k = ιY k ≫ Limits.Pi.map (fun _ => u.f k)) ∧
        (∀ k, (wcSmsTwMap ρ u' hu').f k ≫ ιY' k = ιY k ≫ Limits.Pi.map (fun _ => u'.f k)) ∧
        (∀ i j, H i j ≫ ιY' j = ιY i ≫ Limits.Pi.map (fun _ => h.hom i j)) := by
    refine ⟨fun k => Limits.kernel.ι (wcSpfTwD (Y.X k) (fun x => (lamY x).f k) ρ),
      fun k => Limits.kernel.ι (wcSpfTwD (Y'.X k) (fun x => (lamY' x).f k) ρ),
      fun i j => Limits.kernel.map (wcSpfTwD (Y.X i) (fun x => (lamY x).f i) ρ)
        (wcSpfTwD (Y'.X j) (fun x => (lamY' x).f j) ρ)
        (Limits.Pi.map (fun _ => h.hom i j)) (Limits.Pi.map (fun _ => h.hom i j)) (by
          apply Limits.Pi.hom_ext
          intro aj
          simp only [wcSpfTwD, Category.assoc, Limits.Pi.lift_comp_π, Limits.Pi.map_π,
            Limits.Pi.map_π_assoc, Limits.Pi.lift_comp_π_assoc, Preadditive.sub_comp,
            Preadditive.comp_sub, Preadditive.sum_comp, Preadditive.comp_sum,
            Preadditive.nsmul_comp, Preadditive.comp_nsmul, hh]),
      fun k => Limits.equalizer.ι_mono, ?_, ?_,
      fun k => Limits.kernel.lift_ι _ _ _, fun k => Limits.kernel.lift_ι _ _ _,
      fun i j => Limits.kernel.lift_ι _ _ _⟩
    · intro k
      dsimp only [wcSpfTwCx]
      erw [CochainComplex.of_d]
      exact Limits.kernel.lift_ι _ _ _
    · intro k
      dsimp only [wcSpfTwCx]
      erw [CochainComplex.of_d]
      exact Limits.kernel.lift_ι _ _ _
  refine ⟨{ hom := H, zero := ?_, comm := ?_ }⟩
  · intro i j hij
    have h0 : h.hom i j = 0 := h.zero i j hij
    haveI := mY' j
    refine (cancel_mono (ιY' j)).1 ?_
    rw [kH, Limits.zero_comp]
    apply Limits.Pi.hom_ext
    intro b
    simp only [Category.assoc, Limits.Pi.map_π, h0, Limits.comp_zero, Limits.zero_comp]
  · intro i
    have e1 : ∀ b, dNext i H ≫ ιY' i ≫ Limits.Pi.π (fun _ : Fin r => Y'.X i) b =
        ιY i ≫ Limits.Pi.π (fun _ : Fin r => Y.X i) b ≫ dNext i h.hom := by
      intro b
      rw [dNext_eq H (show (ComplexShape.up ℕ).Rel i (i + 1) from rfl),
        dNext_eq h.hom (show (ComplexShape.up ℕ).Rel i (i + 1) from rfl)]
      simp only [Category.assoc]
      rw [reassoc_of% (kH (i + 1) i), reassoc_of% (dY i)]
      simp only [Limits.Pi.map_π, Limits.Pi.map_π_assoc]
    have e2 : ∀ b, prevD i H ≫ ιY' i ≫ Limits.Pi.π (fun _ : Fin r => Y'.X i) b =
        ιY i ≫ Limits.Pi.π (fun _ : Fin r => Y.X i) b ≫ prevD i h.hom := by
      intro b
      cases i with
      | zero =>
        simp only [Homotopy.prevD_zero_cochainComplex, Limits.zero_comp, Limits.comp_zero]
      | succ k =>
        rw [prevD_eq H (show (ComplexShape.up ℕ).Rel k (k + 1) from rfl),
          prevD_eq h.hom (show (ComplexShape.up ℕ).Rel k (k + 1) from rfl)]
        simp only [Category.assoc]
        rw [reassoc_of% (dY' k), reassoc_of% (kH (k + 1) k)]
        simp only [Limits.Pi.map_π, Limits.Pi.map_π_assoc]
    have e3 : ∀ b, (wcSmsTwMap ρ u' hu').f i ≫ ιY' i ≫
          Limits.Pi.π (fun _ : Fin r => Y'.X i) b =
        ιY i ≫ Limits.Pi.π (fun _ : Fin r => Y.X i) b ≫ u'.f i := by
      intro b
      rw [reassoc_of% (kUu' i), Limits.Pi.map_π]
    haveI := mY' i
    refine (cancel_mono (ιY' i)).1 ?_
    apply Limits.Pi.hom_ext
    intro b
    simp only [Preadditive.add_comp, Category.assoc, e1, e2, e3]
    rw [reassoc_of% (kUu i), Limits.Pi.map_π, h.comm i]
    simp only [Preadditive.comp_add]

theorem wcU_sms_tw_E_iso (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {Γ : Type u} [Group Γ] [Fintype Γ] {n r : ℕ}
    (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n)))
    (Y : CochainComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) ℕ)
    (lamY : MonoidAlgebra ℤ_[ℓ] Γ → (Y ⟶ Y))
    (hFr : ∀ x, wcCxJMap K hP (lamY x) ≫ wcCxJFrob K hP Y = wcCxJFrob K hP Y ≫ wcCxJMap K hP (lamY x)) :
    ∃ e : wcCxJ K hP (wcSpfTwCx Y lamY ρ) ≅
        wcSpfTwCx (wcCxJ K hP Y) (fun x => wcCxJMap K hP (lamY x)) ρ,
      e.hom ≫ wcSmsTwMap ρ (wcCxJFrob K hP Y) hFr = wcCxJFrob K hP (wcSpfTwCx Y lamY ρ) ≫ e.hom :=
by
  have key : ∀ (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1} ⥤
      AddCommGrpCat.{u+1}) [G.Additive] [Limits.PreservesFiniteLimits G] (θ : G ⟶ G)
      (hFr' : ∀ x, (G.mapHomologicalComplex (ComplexShape.up ℕ)).map (lamY x) ≫
          (NatTrans.mapHomologicalComplex θ (ComplexShape.up ℕ)).app Y =
        (NatTrans.mapHomologicalComplex θ (ComplexShape.up ℕ)).app Y ≫
          (G.mapHomologicalComplex (ComplexShape.up ℕ)).map (lamY x)),
      ∃ e : (G.mapHomologicalComplex (ComplexShape.up ℕ)).obj (wcSpfTwCx Y lamY ρ) ≅
          wcSpfTwCx ((G.mapHomologicalComplex (ComplexShape.up ℕ)).obj Y)
            (fun x => (G.mapHomologicalComplex (ComplexShape.up ℕ)).map (lamY x)) ρ,
        e.hom ≫ wcSmsTwMap ρ ((NatTrans.mapHomologicalComplex θ (ComplexShape.up ℕ)).app Y) hFr' =
          (NatTrans.mapHomologicalComplex θ (ComplexShape.up ℕ)).app (wcSpfTwCx Y lamY ρ) ≫
            e.hom := by
    intro G _ _ θ hFr'

    have s1a : ∀ {A B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
        (g : A ⟶ B),
        G.map (Limits.Pi.map (fun _ : Fin r => g)) ≫ Limits.piComparison G (fun _ : Fin r => B) =
          Limits.piComparison G (fun _ : Fin r => A) ≫
            Limits.Pi.map (fun _ : Fin r => G.map g) := by
      intro A B g
      apply Limits.Pi.hom_ext
      intro b
      simp only [Category.assoc, Limits.piComparison_comp_π, Limits.Pi.map_π,
        Limits.piComparison_comp_π_assoc, ← Functor.map_comp]

    have s1b : ∀ (A : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}),
        θ.app (∏ᶜ fun _ : Fin r => A) ≫ Limits.piComparison G (fun _ : Fin r => A) =
          Limits.piComparison G (fun _ : Fin r => A) ≫
            Limits.Pi.map (fun _ : Fin r => θ.app A) := by
      intro A
      apply Limits.Pi.hom_ext
      intro b
      simp only [Category.assoc, Limits.piComparison_comp_π, Limits.Pi.map_π,
        Limits.piComparison_comp_π_assoc, NatTrans.naturality]

    have s2 : ∀ (A : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
        (lam : MonoidAlgebra ℤ_[ℓ] Γ → (A ⟶ A))
        (lam' : MonoidAlgebra ℤ_[ℓ] Γ → (G.obj A ⟶ G.obj A)), (∀ x, lam' x = G.map (lam x)) →
        ∃ e : G.obj (Limits.kernel (wcSpfTwD A lam ρ)) ≅
            Limits.kernel (wcSpfTwD (G.obj A) lam' ρ),
          e.hom ≫ Limits.kernel.ι (wcSpfTwD (G.obj A) lam' ρ) =
            G.map (Limits.kernel.ι (wcSpfTwD A lam ρ)) ≫
              Limits.piComparison G (fun _ : Fin r => A) := by
      intro A lam lam' hlam
      have sq : G.map (wcSpfTwD A lam ρ) ≫
            (Limits.PreservesProduct.iso G (fun _ : Fin (Fintype.card Γ) × Fin r => A)).hom =
          (Limits.PreservesProduct.iso G (fun _ : Fin r => A)).hom ≫
            wcSpfTwD (G.obj A) lam' ρ := by
        rw [Limits.PreservesProduct.iso_hom, Limits.PreservesProduct.iso_hom]
        apply Limits.Pi.hom_ext
        intro aj
        rw [Category.assoc, Limits.piComparison_comp_π, ← G.map_comp, Category.assoc]
        simp only [wcSpfTwD, Limits.Pi.lift_comp_π, Functor.map_sub,
          Functor.map_sum, Functor.map_nsmul, Functor.map_comp, Preadditive.comp_sub,
          Preadditive.comp_sum, Preadditive.comp_nsmul, Limits.piComparison_comp_π_assoc,
          Limits.piComparison_comp_π, hlam]
      refine ⟨Limits.PreservesKernel.iso G (wcSpfTwD A lam ρ) ≪≫
        Limits.kernel.mapIso _ _ _ _ sq, ?_⟩
      rw [Iso.trans_hom, Category.assoc, Limits.kernel.mapIso_hom, Limits.kernel.lift_ι,
        Limits.PreservesKernel.iso_hom, Limits.PreservesProduct.iso_hom,
        Limits.kernelComparison_comp_ι_assoc]

    choose e he using fun k => s2 (Y.X k) (fun x => (lamY x).f k)
      (fun x => ((G.mapHomologicalComplex (ComplexShape.up ℕ)).map (lamY x)).f k) (fun x => rfl)
    have hdA : ∀ (Z : CochainComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left)
          AddCommGrpCat.{u+1}) ℕ) (lamZ : MonoidAlgebra ℤ_[ℓ] Γ → (Z ⟶ Z)) (k : ℕ),
        (wcSpfTwCx Z lamZ ρ).d k (k + 1) ≫
          Limits.kernel.ι (wcSpfTwD (Z.X (k + 1)) (fun x => (lamZ x).f (k + 1)) ρ) =
        Limits.kernel.ι (wcSpfTwD (Z.X k) (fun x => (lamZ x).f k) ρ) ≫
          Limits.Pi.map (fun _ => Z.d k (k + 1)) := fun Z lamZ k => by
      dsimp only [wcSpfTwCx]
      erw [CochainComplex.of_d]
      exact Limits.kernel.lift_ι _ _ _
    have hdB : ∀ (Z : CochainComplex AddCommGrpCat.{u+1} ℕ)
        (lamZ : MonoidAlgebra ℤ_[ℓ] Γ → (Z ⟶ Z)) (k : ℕ),
        (wcSpfTwCx Z lamZ ρ).d k (k + 1) ≫
          Limits.kernel.ι (wcSpfTwD (Z.X (k + 1)) (fun x => (lamZ x).f (k + 1)) ρ) =
        Limits.kernel.ι (wcSpfTwD (Z.X k) (fun x => (lamZ x).f k) ρ) ≫
          Limits.Pi.map (fun _ => Z.d k (k + 1)) := fun Z lamZ k => by
      dsimp only [wcSpfTwCx]
      erw [CochainComplex.of_d]
      exact Limits.kernel.lift_ι _ _ _
    have chn : ∀ {K0 K0' K1 K1' P0' P1' : AddCommGrpCat.{u+1}} (ι0' : K0' ⟶ P0')
        (ι1' : K1' ⟶ P1') (_ : Mono ι1')
        (A : K0 ⟶ K0') (B : K1 ⟶ K1') (dA : K0 ⟶ K1) (dB : K0' ⟶ K1') (pd' : P0' ⟶ P1')
        (x0 : K0 ⟶ P0') (x1 : K1 ⟶ P1'), dB ≫ ι1' = ι0' ≫ pd' → A ≫ ι0' = x0 →
        B ≫ ι1' = x1 → x0 ≫ pd' = dA ≫ x1 → A ≫ dB = dA ≫ B := by
      intro K0 K0' K1 K1' P0' P1' ι0' ι1' _ A B dA dB pd' x0 x1 hdB' hA hB h
      refine (cancel_mono ι1').1 ?_
      rw [Category.assoc, hdB', ← Category.assoc, hA, h, Category.assoc, hB]
    have frob : ∀ {K0 K' P' : AddCommGrpCat.{u+1}} (ι' : K' ⟶ P') (_ : Mono ι')
        (A : K0 ⟶ K') (M' : K' ⟶ K') (M : K0 ⟶ K0) (p' : P' ⟶ P') (x : K0 ⟶ P'),
        M' ≫ ι' = ι' ≫ p' → A ≫ ι' = x → x ≫ p' = M ≫ x → A ≫ M' = M ≫ A := by
      intro K0 K' P' ι' _ A M' M p' x hM' hA h
      refine (cancel_mono ι').1 ?_
      rw [Category.assoc, hM', ← Category.assoc, hA, h, Category.assoc, hA]
    have hc : ∀ i j, (ComplexShape.up ℕ).Rel i j →
        (e i).hom ≫ (wcSpfTwCx ((G.mapHomologicalComplex (ComplexShape.up ℕ)).obj Y)
          (fun x => (G.mapHomologicalComplex (ComplexShape.up ℕ)).map (lamY x)) ρ).d i j =
        ((G.mapHomologicalComplex (ComplexShape.up ℕ)).obj (wcSpfTwCx Y lamY ρ)).d i j ≫
          (e j).hom := by
      rintro i j (rfl : i + 1 = j)
      have h : (G.map (Limits.kernel.ι (wcSpfTwD (Y.X i) (fun x => (lamY x).f i) ρ)) ≫
          Limits.piComparison G (fun _ : Fin r => Y.X i)) ≫
            Limits.Pi.map (fun _ : Fin r => G.map (Y.d i (i + 1))) =
          G.map ((wcSpfTwCx Y lamY ρ).d i (i + 1)) ≫
            G.map (Limits.kernel.ι (wcSpfTwD (Y.X (i + 1)) (fun x => (lamY x).f (i + 1)) ρ)) ≫
              Limits.piComparison G (fun _ : Fin r => Y.X (i + 1)) := by
        rw [Category.assoc, ← s1a, ← G.map_comp_assoc, ← hdA Y lamY i]
        exact Functor.map_comp_assoc G ((wcSpfTwCx Y lamY ρ).d i (i + 1))
          (Limits.kernel.ι (wcSpfTwD (Y.X (i + 1)) (fun x => (lamY x).f (i + 1)) ρ)) _
      exact chn _ _ Limits.equalizer.ι_mono _ _ _ _ _ _ _ (hdB _ _ i) (he i) (he (i + 1)) h
    refine ⟨HomologicalComplex.Hom.isoOfComponents (fun k => e k) hc, ?_⟩
    apply HomologicalComplex.hom_ext
    intro k
    rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f]
    have hT : θ.app (Limits.kernel (wcSpfTwD (Y.X k) (fun x => (lamY x).f k) ρ)) ≫
        G.map (Limits.kernel.ι (wcSpfTwD (Y.X k) (fun x => (lamY x).f k) ρ)) ≫
          Limits.piComparison G (fun _ : Fin r => Y.X k) =
        (G.map (Limits.kernel.ι (wcSpfTwD (Y.X k) (fun x => (lamY x).f k) ρ)) ≫
          Limits.piComparison G (fun _ : Fin r => Y.X k)) ≫
            Limits.Pi.map (fun _ : Fin r => θ.app (Y.X k)) := by
      rw [Category.assoc, ← s1b, NatTrans.naturality_assoc]
    exact frob _ Limits.equalizer.ι_mono (e k).hom _ _ _ _ (Limits.kernel.lift_ι _ _ _) (he k)
      hT.symm
  exact key (preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP))))
    (preadditiveCoyoneda.map
      (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)).op) hFr

theorem wcU_sms_twist_iso (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) {Γ : Type u} [Group Γ] [Fintype Γ]
    {r : ℕ} (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (P : wcGModel ℓ Γ)
    (Q : wcLnModel (ZMod (ℓ ^ n))) (hQ : wcIsTwist ℓ n ρ P Q)
    (hf : ∀ x, wcSmsBarSmul P n x ≫ wcSmsBarFrob P n = wcSmsBarFrob P n ≫ wcSmsBarSmul P n x) :
    ∃ Θ : wcLnModelAb.{u+1} Q ≅ wcSpfTwCx (wcSmsBar P n) (fun x => wcSmsBarSmul P n x) ρ,
      Θ.hom ≫ wcSmsTwMap ρ (wcSmsBarFrob P n) hf = wcLnModelFrob Q ≫ Θ.hom :=
by
  classical
  have hcoef : ∀ {p q : ℕ} (b : Fin q ≃ Fin p × Fin r) (w : Fin q → ZMod (ℓ ^ n)) (j : Fin r)
      (a : Fin p) (g : Γ), (wcSmsTheta ℓ n ρ b w j a).coeff g = ∑ i : Fin r, w (b.symm (a, i)) *
        ((ρ g⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) i j := by
    intro p q b w j a g
    simp [wcSmsTheta, MonoidAlgebra.coeff_sum, Finsupp.single_apply]
  have hcs : ∀ {ι : Type} (s : Finset ι) (f : ι → MonoidAlgebra (ZMod (ℓ ^ n)) Γ) (g : Γ),
      (∑ i ∈ s, f i).coeff g = ∑ i ∈ s, (f i).coeff g := by
    intro ι s f g
    rw [MonoidAlgebra.coeff_sum, Finsupp.finset_sum_apply]
