  have hu : ∀ a, (ρ a ≫ f a) ≫ I.cocomplex.d q (q + 1) = 0 := by
    intro a
    rw [Category.assoc, hf a, Limits.comp_zero]

  have hsum : ∑ a, ρ a ≫ f a = k ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev q) q := by
    apply (ev (I.cocomplex.X q)).injective
    rw [hevsum]
    simp only [hnat, hρ, hk]
    exact hcy

  have hcongr : ∀ (g g' : P₀ ⟶ I.cocomplex.X q) (hg : g ≫ I.cocomplex.d q (q + 1) = 0)
      (hg' : g' ≫ I.cocomplex.d q (q + 1) = 0), g = g' →
      I.extMk g (q + 1) rfl hg = I.extMk g' (q + 1) rfl hg' := by
    intro g g' hg hg' h
    subst h
    rfl
  have hext_sum : ∀ (s : Finset (Fin m)) (hs : (∑ a ∈ s, ρ a ≫ f a) ≫ I.cocomplex.d q (q + 1) = 0),
      ∑ a ∈ s, I.extMk (ρ a ≫ f a) (q + 1) rfl (hu a) =
        I.extMk (∑ a ∈ s, ρ a ≫ f a) (q + 1) rfl hs := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      intro hs
      rw [Finset.sum_empty, hcongr _ 0 hs (by rw [Limits.zero_comp]) Finset.sum_empty,
        I.extMk_zero]
    | insert b s hb ih =>
      intro hs
      have hs' : (∑ a ∈ s, ρ a ≫ f a) ≫ I.cocomplex.d q (q + 1) = 0 := by
        rw [Preadditive.sum_comp]
        exact Finset.sum_eq_zero (fun a _ => hu a)
      rw [Finset.sum_insert hb, ih hs', I.add_extMk]
      exact hcongr _ _ _ _ (by rw [Finset.sum_insert hb])
  have hcob : ∀ (n : ℕ) (g : P₀ ⟶ I.cocomplex.X n) (hg : g ≫ I.cocomplex.d n (n + 1) = 0)
      (k' : P₀ ⟶ I.cocomplex.X ((ComplexShape.up ℕ).prev n)),
      g = k' ≫ I.cocomplex.d ((ComplexShape.up ℕ).prev n) n →
      I.extMk g (n + 1) rfl hg = 0 := by
    intro n
    cases n with
    | zero =>
      intro g hg k' hk'
      have hd : I.cocomplex.d ((ComplexShape.up ℕ).prev 0) 0 = 0 :=
        I.cocomplex.shape _ _ (by rw [ComplexShape.up_Rel]; omega)
      have hg0 : g = 0 := by rw [hk', hd, Limits.comp_zero]
      subst hg0
      exact I.extMk_zero _ _
    | succ p =>
      intro g hg k' hk'
      rw [I.extMk_eq_zero_iff g (p + 1 + 1) rfl hg p rfl]
      refine ⟨k' ≫ (I.cocomplex.XIsoOfEq (CochainComplex.prev_nat_succ p)).hom, ?_⟩
      rw [Category.assoc, HomologicalComplex.XIsoOfEq_hom_comp_d, ← hk']
  have hs_univ : (∑ a, ρ a ≫ f a) ≫ I.cocomplex.d q (q + 1) = 0 := by
    rw [Preadditive.sum_comp]
    exact Finset.sum_eq_zero (fun a _ => hu a)
  have hvan : ∑ a, (Abelian.Ext.mk₀ (ρ a)).comp (wcHMPull D2 q (e a)) (zero_add q) = 0 := by
    have h1 : ∀ a, (Abelian.Ext.mk₀ (ρ a)).comp (wcHMPull D2 q (e a)) (zero_add q) =
        I.extMk (ρ a ≫ f a) (q + 1) rfl (hu a) := by
      intro a
      rw [← hfe a, I.mk₀_comp_extMk]
    rw [Finset.sum_congr rfl (fun a _ => h1 a), hext_sum Finset.univ hs_univ]
    exact hcob q _ hs_univ k hsum

  obtain ⟨DV, hDV⟩ := wc_hm_pull_data_exists ((wcProEtBC q₁).obj W).hom ℓ
  obtain ⟨D', hD'⟩ := wc_hm_pull_data_exists (((wcProEtBC q₁).obj W).hom ≫ q₂) ℓ
  obtain ⟨Θ, hΘ⟩ := wc_proet_free_slice_module_ext P ℓ ((wcProEtBC q₁).obj W) P₀ ev hnat hadd
    DV hDV q
  have hκ : ∑ a, (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC q₁).obj W).left ℓ
      (ContinuousMap.comp (c a : C(↥W.left, ULift.{u+1} ℚ_[ℓ]))
        (Limits.pullback.fst W.hom q₁).base.hom))).comp
      (wcHMPull D' q (e a)) (zero_add q) = 0 := by
    have h2 := congrArg Θ hvan
    rw [map_sum, map_zero] at h2
    refine (Finset.sum_congr rfl (fun a _ => ?_)).trans h2
    rw [hρdef a]
    refine Eq.trans ?_ (hΘ _ _).symm
    rw [wc_hm_pull_comp q₂ ((wcProEtBC q₁).obj W).hom _ rfl D2 hD2 DV hDV D' hD' q (e a),
      hD1 W (c a)]
    rfl

  have hfun0 : ∀ (S : Scheme.{u}), wcHMFun S ℓ 0 = 0 := by
    intro S
    apply (SheafOfModules.unitHomEquiv _).injective
    apply PresheafOfModules.sections_ext
    intro V
    simp only [wcHMFun, Equiv.apply_symm_apply]
    rw [SheafOfModules.unitHomEquiv_apply_coe]
    exact ContinuousMap.ext (fun x => rfl)
  have hκ0 : ∑ a, (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC q₁).obj W).left ℓ
      (ContinuousMap.comp ((0 : Fin m → C(↥W.left, ULift.{u+1} ℚ_[ℓ])) a)
        (Limits.pullback.fst W.hom q₁).base.hom))).comp
      (wcHMPull D' q (e a)) (zero_add q) = 0 := by
    refine Finset.sum_eq_zero (fun a _ => ?_)
    have h0 : ContinuousMap.comp ((0 : Fin m → C(↥W.left, ULift.{u+1} ℚ_[ℓ])) a)
        (Limits.pullback.fst W.hom q₁).base.hom = 0 :=
      ContinuousMap.ext (fun _ => rfl)
    have hz : ∀ (r : C(↥((wcProEtBC q₁).obj W).left, ULift.{u+1} ℚ_[ℓ]))
        (z : wcHM ((wcProEtBC q₁).obj W).left ℓ q),
        r = 0 → (Abelian.Ext.mk₀ (wcHMFun ((wcProEtBC q₁).obj W).left ℓ r)).comp z
          (zero_add q) = 0 := by
      intro r z hr
      subst hr
      rw [hfun0, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
    exact hz _ _ h0
  have hinj := (wc_prod_wcontr_kunneth F Y₁ Y₂ d₁ d₂ ℓ hℓ P q₁ q₂ hq q m e he W hW D' hD').injective
  have hc : (c : Fin m → C(↥W.left, ULift.{u+1} ℚ_[ℓ])) = 0 :=
    hinj (hκ.trans hκ0.symm)
  intro a
  exact congrFun hc a

theorem wc_prod_local_kunneth (F : Type u) [Finite F] [Field F] (Y₁ Y₂ : Over (Spec (.of F)))
    [GeometricallyIrreducible Y₁.hom] [IsProper Y₁.hom] (d₁ : ℕ) [SmoothOfRelativeDimension d₁ Y₁.hom]
    [GeometricallyIrreducible Y₂.hom] [IsProper Y₂.hom] (d₂ : ℕ) [SmoothOfRelativeDimension d₂ Y₂.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (P : Scheme.{u}) (q₁ : P ⟶ wcXbar F Y₁) (q₂ : P ⟶ wcXbar F Y₂)
    (hq : IsPullback q₁ q₂ (wcPi2 F Y₁) (wcPi2 F Y₂))
    (D1 : wcHMPullData q₁ ℓ) (hD1 : wcHMPullCanonical D1)
    (D2 : wcHMPullData q₂ ℓ) (hD2 : wcHMPullCanonical D2)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf P ℓ)))
    (q m : ℕ) (e : Fin m → wcHM (wcXbar F Y₂) ℓ q)
    (he : Function.Bijective
      (fun c : Fin m → ℚ_[ℓ] => ∑ a, wcHMScalar (wcXbar F Y₂) ℓ q (c a) (e a)))
    (f : Fin m → (SheafOfModules.unit (wcRingSheaf P ℓ) ⟶ I.cocomplex.X q))
    (hf : ∀ a, f a ≫ I.cocomplex.d q (q + 1) = 0)
    (hfe : ∀ a, @InjectiveResolution.extMk _ _ _ (HasExt.standard _) _ _ I q (f a) (q + 1) rfl (hf a) =
      wcHMPull D2 q (e a)) :
    (∀ (W : (wcXbar F Y₁).ProEt)
        (s : (I.cocomplex.X q).val.obj (Opposite.op ((wcProEtBC q₁).obj W))),
        ((I.cocomplex.d q (q + 1)).val.app (Opposite.op ((wcProEtBC q₁).obj W))).hom s = 0 →
        Sieve.generate (fun (W' : (wcXbar F Y₁).ProEt) (g : W' ⟶ W) =>
          ∃ (c : Fin m → (wcRingSheaf (wcXbar F Y₁) ℓ).obj.obj (Opposite.op W'))
            (y : (I.cocomplex.X ((ComplexShape.up ℕ).prev q)).val.obj
              (Opposite.op ((wcProEtBC q₁).obj W'))),
            ((I.cocomplex.X q).val.map ((wcProEtBC q₁).map g).op).hom s =
              ∑ a, ((f a).val.app (Opposite.op ((wcProEtBC q₁).obj W'))).hom
                ((D1.φ.hom.app (Opposite.op W')).hom (c a)) +
              ((I.cocomplex.d ((ComplexShape.up ℕ).prev q) q).val.app
                (Opposite.op ((wcProEtBC q₁).obj W'))).hom y) ∈
          Scheme.ProEt.topology (wcXbar F Y₁) W) ∧
    (∀ (W : (wcXbar F Y₁).ProEt) (c : Fin m → (wcRingSheaf (wcXbar F Y₁) ℓ).obj.obj (Opposite.op W))
        (y : (I.cocomplex.X ((ComplexShape.up ℕ).prev q)).val.obj
          (Opposite.op ((wcProEtBC q₁).obj W))),
        ∑ a, ((f a).val.app (Opposite.op ((wcProEtBC q₁).obj W))).hom
          ((D1.φ.hom.app (Opposite.op W)).hom (c a)) =
          ((I.cocomplex.d ((ComplexShape.up ℕ).prev q) q).val.app
            (Opposite.op ((wcProEtBC q₁).obj W))).hom y →
        Sieve.generate (fun (W' : (wcXbar F Y₁).ProEt) (g : W' ⟶ W) =>
          ∀ a, ((wcRingSheaf (wcXbar F Y₁) ℓ).obj.map g.op).hom (c a) = 0) ∈
          Scheme.ProEt.topology (wcXbar F Y₁) W) :=
by
  classical

  have hcov : ∀ W : (wcXbar F Y₁).ProEt,
      Sieve.generate (fun (W' : (wcXbar F Y₁).ProEt) (_ : W' ⟶ W) =>
        IsAffine W'.left ∧ IsClosed {x : W'.left | IsClosed ({x} : Set W'.left)} ∧
          (∀ x : W'.left, ∃! y : W'.left, IsClosed ({y} : Set W'.left) ∧ x ⤳ y) ∧
          ExtremallyDisconnected {x : W'.left | IsClosed ({x} : Set W'.left)} ∧
          (∀ x : W'.left, IsClosed ({x} : Set W'.left) →
            HenselianLocalRing (W'.left.presheaf.stalk x) ∧ IsSepClosed (W'.left.residueField x))) ∈
        Scheme.ProEt.topology (wcXbar F Y₁) W := by
    intro W
    refine wc_proet_cover_of_affine_local (fun Δ : Scheme.{u} =>
      IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, IsClosed ({x} : Set Δ) →
          HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x))) ?_ W
    intro V hV
    obtain ⟨Δ, δ, h1, h2, h3, h4, h5, h6, h7⟩ := wc_exists_wcontractible_cover V hV
    exact ⟨Δ, δ, h1, h2, h3, h4, h5, h6, h7⟩
  refine ⟨fun W s hs => ?_, fun W c y hcy => ?_⟩
  ·
    refine (Scheme.ProEt.topology (wcXbar F Y₁)).superset_covering ?_ (hcov W)
    rw [Sieve.generate_le_iff]
    intro W' g hg
    have hs' : ((I.cocomplex.d q (q + 1)).val.app (Opposite.op ((wcProEtBC q₁).obj W'))).hom
        (((I.cocomplex.X q).val.map ((wcProEtBC q₁).map g).op).hom s) = 0 := by
      refine (PresheafOfModules.naturality_apply (I.cocomplex.d q (q + 1)).val
        ((wcProEtBC q₁).map g).op s).trans ?_
      show ((I.cocomplex.X (q + 1)).val.map ((wcProEtBC q₁).map g).op).hom
        (((I.cocomplex.d q (q + 1)).val.app (Opposite.op ((wcProEtBC q₁).obj W))).hom s) = 0
      rw [hs, map_zero]
    exact ⟨W', 𝟙 _, g,
      wc_prod_wcontr_kunneth_gen F Y₁ Y₂ d₁ d₂ ℓ hℓ P q₁ q₂ hq D1 hD1 D2 hD2 I q m e he f hf hfe
        W' hg _ hs',
      Category.id_comp g⟩
  ·
    refine (Scheme.ProEt.topology (wcXbar F Y₁)).superset_covering ?_ (hcov W)
    rw [Sieve.generate_le_iff]
    intro W' g hg
    refine ⟨W', 𝟙 _, g, ?_, Category.id_comp g⟩
    have key : ∀ a, ((f a).val.app (Opposite.op ((wcProEtBC q₁).obj W'))).hom
        ((D1.φ.hom.app (Opposite.op W')).hom
          (((wcRingSheaf (wcXbar F Y₁) ℓ).obj.map g.op).hom (c a))) =
        ((I.cocomplex.X q).val.map ((wcProEtBC q₁).map g).op).hom
          (((f a).val.app (Opposite.op ((wcProEtBC q₁).obj W))).hom
            ((D1.φ.hom.app (Opposite.op W)).hom (c a))) := by
      intro a
      have h1 : (D1.φ.hom.app (Opposite.op W')).hom
          (((wcRingSheaf (wcXbar F Y₁) ℓ).obj.map g.op).hom (c a)) =
          ((wcRingSheaf P ℓ).obj.map ((wcProEtBC q₁).map g).op).hom
            ((D1.φ.hom.app (Opposite.op W)).hom (c a)) :=
        NatTrans.naturality_apply D1.φ.hom g.op (c a)
      rw [h1]
      exact PresheafOfModules.naturality_apply (f a).val ((wcProEtBC q₁).map g).op
        ((D1.φ.hom.app (Opposite.op W)).hom (c a))
    have hd : ((I.cocomplex.d ((ComplexShape.up ℕ).prev q) q).val.app
        (Opposite.op ((wcProEtBC q₁).obj W'))).hom
        (((I.cocomplex.X ((ComplexShape.up ℕ).prev q)).val.map ((wcProEtBC q₁).map g).op).hom y) =
        ((I.cocomplex.X q).val.map ((wcProEtBC q₁).map g).op).hom
          (((I.cocomplex.d ((ComplexShape.up ℕ).prev q) q).val.app
            (Opposite.op ((wcProEtBC q₁).obj W))).hom y) :=
      PresheafOfModules.naturality_apply _ _ _
    refine wc_prod_wcontr_kunneth_ind F Y₁ Y₂ d₁ d₂ ℓ hℓ P q₁ q₂ hq D1 hD1 D2 hD2 I q m e he f hf hfe
      W' hg
      (fun a => ((wcRingSheaf (wcXbar F Y₁) ℓ).obj.map g.op).hom (c a))
      (((I.cocomplex.X ((ComplexShape.up ℕ).prev q)).val.map ((wcProEtBC q₁).map g).op).hom y) ?_
    beta_reduce
    rw [hd, ← hcy, map_sum]
    exact Finset.sum_congr rfl (fun a _ => key a)

theorem pushforward_homology_sigma_isIso {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
    {J : GrothendieckTopology C} {K : GrothendieckTopology D} (G : C ⥤ D) [G.IsContinuous J K]
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    [HasSheafify K AddCommGrpCat.{u+1}] [K.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (S : Sheaf J RingCat.{u+1}) (R : Sheaf K RingCat.{u+1})
    (φ : S ⟶ (G.sheafPushforwardContinuous RingCat.{u+1} J K).obj R)
    [(SheafOfModules.pushforward.{u+1} φ).Additive]
    (Kc : CochainComplex (SheafOfModules.{u+1} R) ℕ) (q m : ℕ)
    (f : Fin m → (SheafOfModules.unit R ⟶ Kc.X q))
    (hcyc : ∀ a, f a ≫ Kc.d q (q + 1) = 0)
    (u : Fin m → (SheafOfModules.unit S ⟶
      (((SheafOfModules.pushforward.{u+1} φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj Kc).X q))
    (hu : ∀ a, u a ≫ (((SheafOfModules.pushforward.{u+1} φ).mapHomologicalComplex
      (ComplexShape.up ℕ)).obj Kc).d q (q + 1) = 0)
    (huf : ∀ a, u a = SheafOfModules.unitToPushforwardObjUnit φ ≫
      (SheafOfModules.pushforward.{u+1} φ).map (f a))
    (hgen : ∀ (W : C) (s : (Kc.X q).val.obj (Opposite.op (G.obj W))),
        ((Kc.d q (q + 1)).val.app (Opposite.op (G.obj W))).hom s = 0 →
        Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∃ (c : Fin m → S.obj.obj (Opposite.op W'))
            (y : (Kc.X ((ComplexShape.up ℕ).prev q)).val.obj (Opposite.op (G.obj W'))),
            ((Kc.X q).val.map (G.map g).op).hom s =
              ∑ a, ((f a).val.app (Opposite.op (G.obj W'))).hom
                ((φ.hom.app (Opposite.op W')).hom (c a)) +
              ((Kc.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op (G.obj W'))).hom y) ∈ J W)
    (hind : ∀ (W : C) (c : Fin m → S.obj.obj (Opposite.op W))
        (y : (Kc.X ((ComplexShape.up ℕ).prev q)).val.obj (Opposite.op (G.obj W))),
        ∑ a, ((f a).val.app (Opposite.op (G.obj W))).hom ((φ.hom.app (Opposite.op W)).hom (c a)) =
          ((Kc.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op (G.obj W))).hom y →
        Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∀ a, (S.obj.map g.op).hom (c a) = 0) ∈ J W) :
    IsIso (Limits.Sigma.desc (fun a : Fin m =>
      (((SheafOfModules.pushforward.{u+1} φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj Kc).liftCycles
        (u a) (q + 1) (by simp) (hu a) ≫
      (((SheafOfModules.pushforward.{u+1} φ).mapHomologicalComplex (ComplexShape.up ℕ)).obj Kc).homologyπ q)) :=
by
  classical

  have hcomp : ∀ {M N L : SheafOfModules.{u+1} S} (p : M ⟶ N) (p' : N ⟶ L) (V : Cᵒᵖ)
      (x : M.val.obj V), ((p ≫ p').val.app V).hom x = (p'.val.app V).hom ((p.val.app V).hom x) :=
    fun _ _ _ _ => rfl
  have hnat : ∀ {M N : SheafOfModules.{u+1} S} (p : M ⟶ N) {W W' : C} (g : W' ⟶ W)
      (x : M.val.obj (Opposite.op W)),
      (p.val.app (Opposite.op W')).hom ((M.val.map g.op).hom x) =
        (N.val.map g.op).hom ((p.val.app (Opposite.op W)).hom x) :=
    fun p _ _ g x => PresheafOfModules.naturality_apply p.val g.op x
  have hMmap : ∀ {M : SheafOfModules.{u+1} S} {W Y Z : C} (h₀ : Y ⟶ W) (g' : Z ⟶ Y)
      (x : M.val.obj (Opposite.op W)),
      (M.val.map (g' ≫ h₀).op).hom x = (M.val.map g'.op).hom ((M.val.map h₀.op).hom x) := by
    intro M W Y Z h₀ g' x
    rw [op_comp, PresheafOfModules.map_comp]
    rfl
  have hSmap : ∀ {W Y Z : C} (h₀ : Y ⟶ W) (g' : Z ⟶ Y) (x : S.obj.obj (Opposite.op W)),
      (S.obj.map (g' ≫ h₀).op).hom x = (S.obj.map g'.op).hom ((S.obj.map h₀.op).hom x) := by
    intro W Y Z h₀ g' x
    rw [op_comp, Functor.map_comp]
    rfl
  have hmono : ∀ {M N : SheafOfModules.{u+1} S} (p : M ⟶ N) [Mono p] (W : C),
      Function.Injective (p.val.app (Opposite.op W)).hom := by
    intro M N p _ W
    have h1 : Mono ((SheafOfModules.forget.{u+1} S ⋙
        PresheafOfModules.evaluation.{u+1} S.obj (Opposite.op W)).map p) := Functor.map_mono _ p
    exact (ModuleCat.mono_iff_injective _).1 h1
  have hTS : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} S) := by
    constructor
    intro I _ _
    constructor
    intro K
    let adj := PresheafOfModules.sheafificationAdjunction (J := J) (𝟙 S.obj)
    haveI : IsIso adj.counit := inferInstance
    haveI hP : Limits.PreservesColimitsOfShape I
        (PresheafOfModules.sheafification (J := J) (𝟙 S.obj) ⋙ SheafOfModules.toSheaf.{u+1} S) :=
      Limits.preservesColimitsOfShape_of_natIso
        (PresheafOfModules.sheafificationCompToSheaf (J := J) (𝟙 S.obj)).symm
    let K₀ := K ⋙ (SheafOfModules.forget S ⋙ PresheafOfModules.restrictScalars (𝟙 S.obj))
    let c₀ := Limits.colimit.cocone K₀
    let h₀ : Limits.IsColimit c₀ := Limits.colimit.isColimit K₀
    have ht : Limits.IsColimit
        ((PresheafOfModules.sheafification (J := J) (𝟙 S.obj)).mapCocone c₀) :=
      Limits.isColimitOfPreserves _ h₀
    have ht' : Limits.IsColimit ((SheafOfModules.toSheaf.{u+1} S).mapCocone
        ((PresheafOfModules.sheafification (J := J) (𝟙 S.obj)).mapCocone c₀)) :=
      Limits.IsColimit.ofIsoColimit
        (Limits.isColimitOfPreserves
          (PresheafOfModules.sheafification (J := J) (𝟙 S.obj) ⋙ SheafOfModules.toSheaf.{u+1} S) h₀)
        (Functor.mapCoconeMapCocone c₀).symm
    haveI : Limits.PreservesColimit (K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 S.obj))
        (SheafOfModules.toSheaf.{u+1} S) :=
      Limits.preservesColimit_of_preserves_colimit_cocone ht ht'
    let e : K₀ ⋙ PresheafOfModules.sheafification (J := J) (𝟙 S.obj) ≅ K :=
      Functor.associator _ _ _ ≪≫ Functor.isoWhiskerLeft K (asIso adj.counit) ≪≫
        Functor.rightUnitor K
    exact Limits.preservesColimit_of_iso_diagram _ e
  have hepi : ∀ {M N : SheafOfModules.{u+1} S} (p : M ⟶ N) [Epi p] (W : C)
      (s : N.val.obj (Opposite.op W)),
      Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∃ t : M.val.obj (Opposite.op W'),
        (p.val.app (Opposite.op W')).hom t = (N.val.map g.op).hom s) ∈ J W := by
    intro M N p _ W s
    have := hTS
    have h1 : Epi ((SheafOfModules.toSheaf.{u+1} S).map p) := inferInstance
    have h2 := (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1}
      ((SheafOfModules.toSheaf.{u+1} S).map p)).2 h1
    have : Presheaf.IsLocallySurjective J ((SheafOfModules.toSheaf.{u+1} S).map p).hom := h2
    have h3 := Presheaf.imageSieve_mem J ((SheafOfModules.toSheaf.{u+1} S).map p).hom
      (U := Opposite.op W) s
    refine J.superset_covering ?_ h3
    intro W' g hg
    obtain ⟨t, ht⟩ := hg
    exact ⟨_, 𝟙 _, g, ⟨t, ht⟩, Category.id_comp _⟩
  have hker : ∀ (T : ShortComplex (SheafOfModules.{u+1} S)), T.Exact → Mono T.f → ∀ (W : C)
      (x₂ : T.X₂.val.obj (Opposite.op W)), (T.g.val.app (Opposite.op W)).hom x₂ = 0 →
      ∃ x₁ : T.X₁.val.obj (Opposite.op W), (T.f.val.app (Opposite.op W)).hom x₁ = x₂ := by
    intro T hT hf W x₂ hx
    have hE := hT.map_of_mono_of_preservesKernel (SheafOfModules.forget.{u+1} S ⋙
      PresheafOfModules.evaluation.{u+1} S.obj (Opposite.op W)) hf inferInstance
    exact (ShortComplex.moduleCat_exact_iff _).1 hE x₂ hx
  have hexact : ∀ (T : ShortComplex (SheafOfModules.{u+1} S)), T.Exact → ∀ (W : C)
      (x₂ : T.X₂.val.obj (Opposite.op W)), (T.g.val.app (Opposite.op W)).hom x₂ = 0 →
      Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∃ x₁ : T.X₁.val.obj (Opposite.op W'),
        (T.f.val.app (Opposite.op W')).hom x₁ = (T.X₂.val.map g.op).hom x₂) ∈ J W := by
    intro T hT W x₂ hx
    obtain ⟨z, hz⟩ := hker (ShortComplex.mk T.iCycles T.g T.iCycles_g)
      (ShortComplex.exact_of_f_is_kernel _ T.cyclesIsKernel) inferInstance W x₂ hx
    have := hT.epi_toCycles
    refine J.superset_covering ?_ (hepi T.toCycles W z)
    rw [Sieve.generate_le_iff]
    rintro W' g ⟨t, ht⟩
    apply Sieve.le_generate
    refine ⟨t, ?_⟩
    rw [← T.toCycles_i, hcomp, ht, hnat]
    exact congrArg _ hz
  have htrans : ∀ (W : C) (P₁ P₂ : Presieve W), Sieve.generate P₁ ∈ J W →
      (∀ (Y : C) (g₀ : Y ⟶ W), P₁ g₀ →
        Sieve.generate (fun (Y' : C) (g' : Y' ⟶ Y) => P₂ (g' ≫ g₀)) ∈ J Y) →
      Sieve.generate P₂ ∈ J W := by
    intro W P₁ P₂ h1 h2
    refine J.transitive h1 _ ?_
    intro Y' f hf
    obtain ⟨Y, k, g₀, hg₀, rfl⟩ := hf
    have h3 : Sieve.generate (fun (Y'' : C) (g' : Y'' ⟶ Y) => P₂ (g' ≫ g₀)) ≤
        (Sieve.generate P₂).pullback g₀ := by
      rw [Sieve.generate_le_iff]
      intro Y'' g' hg'
      exact ⟨_, 𝟙 _, g' ≫ g₀, hg', Category.id_comp _⟩
    have h4 := J.superset_covering h3 (h2 Y g₀ hg₀)
    rw [Sieve.pullback_comp]
    exact J.pullback_stable k h4
  have hsep : ∀ (W : C) (x : S.obj.obj (Opposite.op W)),
      Sieve.generate (fun (W' : C) (g : W' ⟶ W) => (S.obj.map g.op).hom x = 0) ∈ J W → x = 0 := by
    intro W x hx
    apply (Sheaf.isSeparated S) W _ hx x 0
    intro Y f hf
    obtain ⟨Z, k, k₀, hk₀, rfl⟩ := hf
    show (S.obj.map (k ≫ k₀).op).hom x = (S.obj.map (k ≫ k₀).op).hom 0
    rw [map_zero, hSmap, hk₀, map_zero]

  have hinjG : ∀ (P : CochainComplex (SheafOfModules.{u+1} S) ℕ)
      (g : Fin m → (SheafOfModules.unit S ⟶ P.X q)) (hg : ∀ a, g a ≫ P.d q (q + 1) = 0),
      (∀ (W : C) (c : Fin m → S.obj.obj (Opposite.op W))
        (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj (Opposite.op W)),
        ∑ a, ((g a).val.app (Opposite.op W)).hom (c a) =
          ((P.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op W)).hom y →
        Sieve.generate (fun (W' : C) (h : W' ⟶ W) => ∀ a, (S.obj.map h.op).hom (c a) = 0) ∈ J W) →
      ∀ (W : C) (c : Fin m → S.obj.obj (Opposite.op W)),
        ∑ a, (((P.liftCycles (g a) (q + 1) (by simp) (hg a) ≫ P.homologyπ q).val.app
          (Opposite.op W)).hom (c a)) = 0 → c = 0 := by
    intro P g hg H2 W c hc
    have hLi : ∀ a (V : Cᵒᵖ) (x : (SheafOfModules.unit S).val.obj V),
        ((P.iCycles q).val.app V).hom
          (((P.liftCycles (g a) (q + 1) (by simp) (hg a)).val.app V).hom x) =
        ((g a).val.app V).hom x := by
      intro a V x
      rw [← hcomp, P.liftCycles_i]
    have hTi : ∀ (V : Cᵒᵖ) (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj V),
        ((P.iCycles q).val.app V).hom
          (((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app V).hom y) =
        ((P.d ((ComplexShape.up ℕ).prev q) q).val.app V).hom y := by
      intro V y
      rw [← hcomp, P.toCycles_i]
    obtain ⟨z, hz⟩ : ∃ z : (P.cycles q).val.obj (Opposite.op W), z =
        ∑ a, ((P.liftCycles (g a) (q + 1) (by simp) (hg a)).val.app (Opposite.op W)).hom (c a) :=
      ⟨_, rfl⟩
    have hπz : ((P.homologyπ q).val.app (Opposite.op W)).hom z = 0 := by
      rw [hz, map_sum, ← hc]
      rfl
    have hTex := ShortComplex.exact_of_g_is_cokernel
      (ShortComplex.mk (P.toCycles ((ComplexShape.up ℕ).prev q) q) (P.homologyπ q)
        (P.toCycles_comp_homologyπ _ q)) (P.homologyIsCokernel _ q rfl)
    have hP₂ : Sieve.generate (fun (W' : C) (k : W' ⟶ W) =>
        ∀ a, (S.obj.map k.op).hom (c a) = 0) ∈ J W := by
      apply htrans W _ _ (hexact _ hTex W z hπz)
      rintro Y h₀ ⟨y, hy⟩
      have hd : ∑ a, ((g a).val.app (Opposite.op Y)).hom ((S.obj.map h₀.op).hom (c a)) =
          ((P.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op Y)).hom y := by
        rw [← hTi]
        erw [hy]
        rw [hnat, hz, map_sum, map_sum]
        apply Finset.sum_congr rfl
        intro a _
        exact (hnat (g a) h₀ (c a)).trans (congrArg _ (hLi a _ (c a)).symm)
      refine J.superset_covering ?_ (H2 Y _ y hd)
      rw [Sieve.generate_le_iff]
      intro Z g' hg'
      apply Sieve.le_generate
      intro a
      rw [hSmap]
      exact hg' a
    funext a
    apply hsep W (c a)
    refine J.superset_covering ?_ hP₂
    rw [Sieve.generate_le_iff]
    intro Z k hk
    apply Sieve.le_generate
    exact hk a

  have hlocG : ∀ (P : CochainComplex (SheafOfModules.{u+1} S) ℕ)
      (g : Fin m → (SheafOfModules.unit S ⟶ P.X q)) (hg : ∀ a, g a ≫ P.d q (q + 1) = 0),
      (∀ (W : C) (s : (P.X q).val.obj (Opposite.op W)),
        ((P.d q (q + 1)).val.app (Opposite.op W)).hom s = 0 →
        Sieve.generate (fun (W' : C) (h : W' ⟶ W) => ∃ (c : Fin m → S.obj.obj (Opposite.op W'))
            (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj (Opposite.op W')),
            ((P.X q).val.map h.op).hom s =
              ∑ a, ((g a).val.app (Opposite.op W')).hom (c a) +
              ((P.d ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op W')).hom y) ∈ J W) →
      ∀ (W : C) (x : (P.homology q).val.obj (Opposite.op W)),
        Sieve.generate (fun (W' : C) (h : W' ⟶ W) => ∃ c : Fin m → S.obj.obj (Opposite.op W'),
          ((P.homology q).val.map h.op).hom x =
            ∑ a, (((P.liftCycles (g a) (q + 1) (by simp) (hg a) ≫ P.homologyπ q).val.app
              (Opposite.op W')).hom (c a))) ∈ J W := by
    intro P g hg H3 W x
    have hLi : ∀ a (V : Cᵒᵖ) (x : (SheafOfModules.unit S).val.obj V),
        ((P.iCycles q).val.app V).hom
          (((P.liftCycles (g a) (q + 1) (by simp) (hg a)).val.app V).hom x) =
        ((g a).val.app V).hom x := by
      intro a V x
      rw [← hcomp, P.liftCycles_i]
    have hTi : ∀ (V : Cᵒᵖ) (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj V),
        ((P.iCycles q).val.app V).hom
          (((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app V).hom y) =
        ((P.d ((ComplexShape.up ℕ).prev q) q).val.app V).hom y := by
      intro V y
      rw [← hcomp, P.toCycles_i]
    have hTπ : ∀ (V : Cᵒᵖ) (y : (P.X ((ComplexShape.up ℕ).prev q)).val.obj V),
        ((P.homologyπ q).val.app V).hom
          (((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app V).hom y) = 0 := by
      intro V y
      rw [← hcomp, P.toCycles_comp_homologyπ]
      rfl
    apply htrans W _ _ (hepi (P.homologyπ q) W x)
    rintro Y h₀ ⟨z, hz⟩
    have hs : ((P.d q (q + 1)).val.app (Opposite.op Y)).hom
        (((P.iCycles q).val.app (Opposite.op Y)).hom z) = 0 := by
      rw [← hcomp, P.iCycles_d]
      rfl
    refine J.superset_covering ?_ (H3 Y _ hs)
    rw [Sieve.generate_le_iff]
    rintro Z h' ⟨c, y, hcy⟩
    apply Sieve.le_generate
    refine ⟨c, ?_⟩
    have hw : ((P.cycles q).val.map h'.op).hom z =
        ∑ a, ((P.liftCycles (g a) (q + 1) (by simp) (hg a)).val.app (Opposite.op Z)).hom (c a) +
          ((P.toCycles ((ComplexShape.up ℕ).prev q) q).val.app (Opposite.op Z)).hom y := by
      apply hmono (P.iCycles q) Z
      rw [map_add, map_sum, hnat, hcy, hTi]
      congr 1
      apply Finset.sum_congr rfl
      intro a _
      exact (hLi a _ (c a)).symm
    rw [hMmap, ← hz, ← hnat, hw, map_add, map_sum, hTπ, add_zero]
    rfl

  have hsplit : ∀ (M : SheafOfModules.{u+1} S) (ι : Fin m → (SheafOfModules.unit S ⟶ M)),
      (∀ (W : C) (c : Fin m → S.obj.obj (Opposite.op W)),
        ∑ a, ((ι a).val.app (Opposite.op W)).hom (c a) = 0 → c = 0) →
      (∀ (W : C) (s : M.val.obj (Opposite.op W)),
        Sieve.generate (fun (W' : C) (g : W' ⟶ W) => ∃ c : Fin m → S.obj.obj (Opposite.op W'),
          (M.val.map g.op).hom s = ∑ a, ((ι a).val.app (Opposite.op W')).hom (c a)) ∈ J W) →
      ∃ ρ : Fin m → (M ⟶ SheafOfModules.unit S),
        (∀ a b : Fin m, ι a ≫ ρ b = if a = b then 𝟙 _ else 0) ∧ ∑ a, ρ a ≫ ι a = 𝟙 M := by
    intro M ι hinj hloc
    have hE_comp : ∀ {A B E : SheafOfModules.{u+1} S} (f : A ⟶ B) (g : B ⟶ E) (X : Cᵒᵖ)
        (x : A.val.obj X), ((f ≫ g).val.app X).hom x = (g.val.app X).hom ((f.val.app X).hom x) :=
      fun _ _ _ _ => rfl
    have hE_zero : ∀ {A B : SheafOfModules.{u+1} S} (X : Cᵒᵖ) (x : A.val.obj X),
        ((0 : A ⟶ B).val.app X).hom x = 0 := by
      intro A B X x
      have h1 := (SheafOfModules.forget S ⋙ PresheafOfModules.evaluation S.obj X).map_zero A B
      have h2 : ((SheafOfModules.forget S ⋙ PresheafOfModules.evaluation S.obj X).map
          (0 : A ⟶ B)).hom x = ((0 : (SheafOfModules.forget S ⋙
            PresheafOfModules.evaluation S.obj X).obj A ⟶ _)).hom x := by rw [h1]
      exact h2
    have hE_sum : ∀ {A B : SheafOfModules.{u+1} S} (f : Fin m → (A ⟶ B)) (X : Cᵒᵖ)
        (x : A.val.obj X), ((∑ a, f a).val.app X).hom x = ∑ a, ((f a).val.app X).hom x := by
      intro A B f X x
      have h1 := (SheafOfModules.forget S ⋙ PresheafOfModules.evaluation S.obj X).map_sum f
        Finset.univ
      have h2 : ((SheafOfModules.forget S ⋙ PresheafOfModules.evaluation S.obj X).map
          (∑ a, f a)).hom x = (∑ a, (SheafOfModules.forget S ⋙
            PresheafOfModules.evaluation S.obj X).map (f a)).hom x := by rw [h1]
      rw [ModuleCat.hom_sum] at h2
      refine h2.trans ?_
      exact LinearMap.sum_apply _ _ _
    have s2 : ∀ (N : SheafOfModules.{u+1} S) (h : M ⟶ N), (∀ a, ι a ≫ h = 0) → h = 0 := by
      intro N h hh
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      obtain ⟨W⟩ := X
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro s
      rw [hE_zero]
      have hsepN := Sheaf.isSeparated (⟨N.val.presheaf, N.isSheaf⟩ : Sheaf J AddCommGrpCat.{u+1})
      refine hsepN W _ (hloc W s) ((h.val.app (Opposite.op W)).hom s) 0 ?_
      rintro Y f ⟨W', k, g, ⟨c, hc⟩, rfl⟩
      have e2 : (M.val.map (k ≫ g).op).hom s = (M.val.map k.op).hom ((M.val.map g.op).hom s) := by
        rw [op_comp, PresheafOfModules.map_comp]
        rfl
      have e3 : (h.val.app (Opposite.op W')).hom ((M.val.map g.op).hom s) = 0 := by
        rw [hc, map_sum]
        refine Finset.sum_eq_zero (fun a _ => ?_)
        have hz := hE_zero (A := SheafOfModules.unit S) (B := N) (Opposite.op W') (c a)
        exact (hE_comp (ι a) h _ (c a)).symm.trans (by rw [hh a]; exact hz)
      have e4 : (h.val.app (Opposite.op Y)).hom ((M.val.map (k ≫ g).op).hom s) = 0 := by
        rw [e2]
        exact (PresheafOfModules.naturality_apply h.val k.op _).trans
          ((congrArg (N.val.map k.op).hom e3).trans (map_zero _))
      change (N.val.map (k ≫ g).op).hom ((h.val.app _).hom s) = (N.val.map (k ≫ g).op).hom 0
      exact ((PresheafOfModules.naturality_apply h.val (k ≫ g).op s).symm.trans e4).trans
        (map_zero _).symm
    have s3 : ∀ (N : SheafOfModules.{u+1} S) (g : Fin m → (N ⟶ SheafOfModules.unit S)),
        ∑ a, g a ≫ ι a = 0 → ∀ a, g a = 0 := by
      intro N g hg a
      apply SheafOfModules.hom_ext
      apply PresheafOfModules.hom_ext
      intro X
      obtain ⟨W⟩ := X
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro n
      rw [hE_zero]
      have hsum : ((∑ b, g b ≫ ι b).val.app (Opposite.op W)).hom n =
          ∑ b, ((g b ≫ ι b).val.app (Opposite.op W)).hom n := hE_sum (fun b => g b ≫ ι b) _ n
      rw [hg, hE_zero] at hsum
      have hc := hinj W (fun b => ((g b).val.app (Opposite.op W)).hom n) hsum.symm
      exact congrFun hc a
    letI : Limits.HasFiniteBiproducts (SheafOfModules.{u+1} S) :=
      Limits.HasFiniteBiproducts.of_hasFiniteProducts
    obtain ⟨Φ, hΦ1, hΦ2⟩ : ∃ Φ : Limits.biproduct (fun _ : Fin m => SheafOfModules.unit S) ⟶ M,
        (∀ a, Limits.biproduct.ι _ a ≫ Φ = ι a) ∧
          Φ = ∑ a, Limits.biproduct.π _ a ≫ ι a :=
      ⟨Limits.biproduct.desc ι, fun a => Limits.biproduct.ι_desc ι a, Limits.biproduct.desc_eq⟩
    haveI : Epi Φ := Preadditive.epi_of_cancel_zero Φ (fun {N} h hh => s2 N h (fun a => by
      rw [← hΦ1 a, Category.assoc, hh, Limits.comp_zero]))
    haveI : Mono Φ := Preadditive.mono_of_cancel_zero Φ (fun {N} g hg => by
      have h1 : ∑ a, (g ≫ Limits.biproduct.π _ a) ≫ ι a = 0 := by
        simp only [Category.assoc]
        rw [← Preadditive.comp_sum, ← hΦ2, hg]
      have h2 := s3 N (fun a => g ≫ Limits.biproduct.π _ a) h1
      apply Limits.biproduct.hom_ext
      intro a
      rw [Limits.zero_comp]
      exact h2 a)
    haveI : IsIso Φ := isIso_of_mono_of_epi Φ
    refine ⟨fun b => inv Φ ≫ Limits.biproduct.π _ b, ?_, ?_⟩
    · intro a b
      rw [← hΦ1 a, Category.assoc, IsIso.hom_inv_id_assoc]
      split_ifs with hab
      · subst hab
        exact Limits.biproduct.ι_π_self _ _
      · exact Limits.biproduct.ι_π_ne _ hab
    · simp only [Category.assoc]
      rw [← Preadditive.comp_sum, ← hΦ2, IsIso.inv_hom_id]

  have husec : ∀ a (W : C) (x : S.obj.obj (Opposite.op W)),
      ((u a).val.app (Opposite.op W)).hom x =
        ((f a).val.app (Opposite.op (G.obj W))).hom ((φ.hom.app (Opposite.op W)).hom x) := by
    intro a W x
    rw [huf a]
    rfl
  have hinj := hinjG _ u hu (by
    intro W c y h
    apply hind W c y
    exact (Finset.sum_congr rfl fun a _ => (husec a W (c a)).symm).trans h)
  have hloc := hlocG _ u hu (by
    intro W s hs
    refine J.superset_covering ?_ (hgen W s hs)
    rw [Sieve.generate_le_iff]
    rintro W' k ⟨c, y, hcy⟩
    apply Sieve.le_generate
    refine ⟨c, y, ?_⟩
    rw [Finset.sum_congr rfl fun a _ => husec a W' (c a)]
    exact hcy)
  obtain ⟨ρ, h1, h2⟩ := hsplit _ _ hinj hloc
  refine ⟨⟨∑ a, ρ a ≫ Limits.Sigma.ι (fun _ : Fin m => SheafOfModules.unit S) a, ?_, ?_⟩⟩
  · apply Limits.Sigma.hom_ext
    intro b
    rw [Limits.Sigma.ι_comp_desc_assoc, Category.comp_id, Preadditive.comp_sum]
    simp only [← Category.assoc, h1]
    rw [Finset.sum_eq_single b]
    · simp
    · intro a _ hab
      rw [if_neg (Ne.symm hab), Limits.zero_comp]
    · intro hb
      exact absurd (Finset.mem_univ b) hb
  · rw [Preadditive.sum_comp]
    simp only [Category.assoc, Limits.Sigma.ι_comp_desc]
    exact h2

theorem wc_prod_pullback_preconnected (F : Type u) [Finite F] [Field F] (Y₁ Y₂ : Over (Spec (.of F)))
    [GeometricallyIrreducible Y₁.hom] [IsProper Y₁.hom] (d₁ : ℕ) [SmoothOfRelativeDimension d₁ Y₁.hom]
    [GeometricallyIrreducible Y₂.hom] [IsProper Y₂.hom] (d₂ : ℕ) [SmoothOfRelativeDimension d₂ Y₂.hom]
    (P : Scheme.{u}) (q₁ : P ⟶ wcXbar F Y₁) (q₂ : P ⟶ wcXbar F Y₂)
    (hq : IsPullback q₁ q₂ (wcPi2 F Y₁) (wcPi2 F Y₂)) : PreconnectedSpace P :=
by
  haveI hGI1 : GeometricallyIrreducible (wcPi2 F Y₁) :=
    inferInstanceAs (GeometricallyIrreducible (Limits.pullback.snd Y₁.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
  haveI hUO1 : UniversallyOpen (wcPi2 F Y₁) :=
    inferInstanceAs (UniversallyOpen (Limits.pullback.snd Y₁.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
  haveI hGI2 : GeometricallyIrreducible (wcPi2 F Y₂) :=
    inferInstanceAs (GeometricallyIrreducible (Limits.pullback.snd Y₂.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
  haveI hUO2 : UniversallyOpen (wcPi2 F Y₂) :=
    inferInstanceAs (UniversallyOpen (Limits.pullback.snd Y₂.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
  haveI hGIq : GeometricallyIrreducible q₂ :=
    MorphismProperty.of_isPullback (P := @GeometricallyIrreducible) hq hGI1
  haveI hUOq : UniversallyOpen q₂ :=
    MorphismProperty.of_isPullback (P := @UniversallyOpen) hq hUO1
  haveI : IrreducibleSpace (Spec (.of (AlgebraicClosure F))) := inferInstance
  haveI : IrreducibleSpace (wcXbar F Y₂) :=
    GeometricallyIrreducible.irreducibleSpace (wcPi2 F Y₂) (wcPi2 F Y₂).isOpenMap
  haveI : IrreducibleSpace P :=
    GeometricallyIrreducible.irreducibleSpace q₂ q₂.isOpenMap
  exact PreirreducibleSpace.preconnectedSpace P

theorem wc_prod_kunneth_span (F : Type u) [Finite F] [Field F] (Y₁ Y₂ : Over (Spec (.of F)))
    [GeometricallyIrreducible Y₁.hom] [IsProper Y₁.hom] (d₁ : ℕ) [SmoothOfRelativeDimension d₁ Y₁.hom]
    [GeometricallyIrreducible Y₂.hom] [IsProper Y₂.hom] (d₂ : ℕ) [SmoothOfRelativeDimension d₂ Y₂.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (P : Scheme.{u}) (q₁ : P ⟶ wcXbar F Y₁) (q₂ : P ⟶ wcXbar F Y₂)
    (hq : IsPullback q₁ q₂ (wcPi2 F Y₁) (wcPi2 F Y₂))
    (D1 : wcHMPullData q₁ ℓ) (hD1 : wcHMPullCanonical D1)
    (D2 : wcHMPullData q₂ ℓ) (hD2 : wcHMPullCanonical D2)
    (n : ℕ) (y : wcHM P ℓ n) :
    y ∈ AddSubgroup.closure {w | ∃ (t : ℚ_[ℓ]) (j : ℕ) (hj : j ≤ n)
        (a : wcHM (wcXbar F Y₁) ℓ j) (b : wcHM (wcXbar F Y₂) ℓ (n - j)),
        w = wcHMScalar P ℓ n t
          (wcHMCup P ℓ j (n - j) n (by omega) (wcHMPull D1 j a) (wcHMPull D2 (n - j) b))} :=
by
  classical

  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf P ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F Y₁) ℓ)) := HasExt.standard _
  haveI := D1.additive
  haveI := D1.presLim
  haveI := D1.presColim
  haveI := D1.cont
  letI : (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC q₁) _ _ D1.cont D1.φ).Additive :=
    @Adjunction.right_adjoint_additive _ _ _ _ _ _ _ _ D1.adj D1.additive
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F Y₁) ℓ)) :=
    sheafOfModules_enoughInjectives _ _
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcRingSheaf P ℓ)) :=
    sheafOfModules_enoughInjectives _ _
  obtain ⟨I⟩ : Nonempty (InjectiveResolution (SheafOfModules.unit (wcRingSheaf P ℓ))) :=
    ⟨InjectiveResolution.of _⟩

  have h₂ : WeaklyEtale (Limits.pullback.fst Y₂.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F)
  obtain ⟨T, hTs, -⟩ := wc_hm_comparison F Y₂ h₂ ℓ
  have hbasis : ∀ q : ℕ, ∃ (rq : ℕ) (eq' : Fin rq → wcHM (wcXbar F Y₂) ℓ q),
      Function.Bijective
        (fun c : Fin rq → ℚ_[ℓ] => ∑ a, wcHMScalar (wcXbar F Y₂) ℓ q (c a) (eq' a)) := by
    intro q
    obtain ⟨m, eC, heC⟩ := wc_coh_finite F Y₂ d₂ ℓ hℓ h₂ q
    have hTinv : ∀ (c : ℚ_[ℓ]) (z : wcHM (wcXbar F Y₂) ℓ q),
        (T q).symm (wcHMScalar (wcXbar F Y₂) ℓ q c z) =
          wcCohScalar F Y₂ h₂ ℓ q c ((T q).symm z) := by
      intro c z
      apply (T q).injective
      rw [AddEquiv.apply_symm_apply, hTs, AddEquiv.apply_symm_apply]
    obtain ⟨eq, heqdef⟩ : ∃ eq : wcHM (wcXbar F Y₂) ℓ q ≃+ (Fin m → ℚ_[ℓ]),
        ∀ x, eq x = eC ((T q).symm x) := ⟨(T q).symm.trans eC, fun _ => rfl⟩
    have heq : ∀ (c : ℚ_[ℓ]) (x : wcHM (wcXbar F Y₂) ℓ q),
        eq (wcHMScalar (wcXbar F Y₂) ℓ q c x) = c • eq x := by
      intro c x
      rw [heqdef, heqdef, hTinv, heC]
    obtain ⟨e, hedef⟩ : ∃ e : Fin m → wcHM (wcXbar F Y₂) ℓ q,
        ∀ a, e a = eq.symm (Pi.single a 1) := ⟨_, fun _ => rfl⟩
    have hβ : ∀ c : Fin m → ℚ_[ℓ],
        eq (∑ a, wcHMScalar (wcXbar F Y₂) ℓ q (c a) (e a)) = c := by
      intro c
      rw [map_sum]
      simp only [heq, hedef, AddEquiv.apply_symm_apply]
      funext b
      simp [Finset.sum_apply, Pi.single_apply]
    refine ⟨m, e, fun c c' hcc => ?_, fun x => ⟨eq x, ?_⟩⟩
    · have h1 := congrArg eq hcc
      simp only at h1
      rw [hβ, hβ] at h1
      exact h1
    · apply eq.injective
      simp only
      rw [hβ]
  choose r e he using hbasis
  choose f hf hfe using fun (k : ℕ) (a : Fin (r k)) =>
    I.extMk_surjective (wcHMPull D2 k (e k a)) (k + 1) rfl

  obtain ⟨g, hgdef⟩ : ∃ g : ∀ k, Fin (r k) →
      (D1.Φ.obj (SheafOfModules.unit (wcRingSheaf (wcXbar F Y₁) ℓ)) ⟶ I.cocomplex.X k),
      ∀ k a, g k a = (D1.adj.homEquiv _ _).symm (SheafOfModules.unitToPushforwardObjUnit D1.φ ≫
        (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC q₁) _ _ D1.cont D1.φ).map (f k a)) :=
    ⟨_, fun _ _ => rfl⟩
  have hg : ∀ k (a : Fin (r k)), g k a ≫ I.cocomplex.d k (k + 1) = 0 := by
    intro k a
    rw [hgdef, ← Adjunction.homEquiv_naturality_right_symm, Category.assoc, ← Functor.map_comp,
      hf, Functor.map_zero, Limits.comp_zero, Adjunction.homEquiv_counit, Functor.map_zero,
      Limits.zero_comp]
  have hf' : ∀ k (a : Fin (r k)), D1.adj.homEquiv _ _ (g k a) ≫
      (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC q₁) _ _ D1.cont D1.φ).mapHomologicalComplex
        (ComplexShape.up ℕ)).obj I.cocomplex).d k (k + 1) = 0 := by
    intro k a
    rw [hgdef, Equiv.apply_symm_apply, Functor.mapHomologicalComplex_obj_d, Category.assoc,
      ← Functor.map_comp, hf, Functor.map_zero, Limits.comp_zero]

  have hLHall := wc_ext_leray_hirsch D1.Φ
    (@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC q₁) _ _ D1.cont D1.φ) D1.adj
    (SheafOfModules.unit (wcRingSheaf (wcXbar F Y₁) ℓ)) (SheafOfModules.unit (wcRingSheaf P ℓ))
    I (n + 1) r g hg hf' (fun k _ => by
      obtain ⟨hgen, hind⟩ := wc_prod_local_kunneth F Y₁ Y₂ d₁ d₂ ℓ hℓ P q₁ q₂ hq D1 hD1 D2 hD2 I
        k (r k) (e k) (he k) (f k) (hf k) (hfe k)
      exact pushforward_homology_sigma_isIso (wcProEtBC q₁) (wcRingSheaf (wcXbar F Y₁) ℓ)
        (wcRingSheaf P ℓ) D1.φ I.cocomplex k (r k) (f k) (hf k)
        (fun a => D1.adj.homEquiv _ _ (g k a)) (hf' k)
        (fun a => by rw [hgdef, Equiv.apply_symm_apply]) hgen hind)
    n (Nat.lt_succ_self n)

  have _hpin := hLHall.2 ℤ
  have hLH := hLHall.1

  obtain ⟨κ', hκ'def⟩ : ∃ κ' : D1.Φ.obj (SheafOfModules.unit (wcRingSheaf (wcXbar F Y₁) ℓ)) ⟶
      SheafOfModules.unit (wcRingSheaf P ℓ),
      κ' = (D1.adj.homEquiv _ _).symm (SheafOfModules.unitToPushforwardObjUnit D1.φ) := ⟨_, rfl⟩
  haveI : PreconnectedSpace P := wc_prod_pullback_preconnected F Y₁ Y₂ d₁ d₂ P q₁ q₂ hq
  obtain ⟨t, ht⟩ := wc_hm_unit_end_const P ℓ (D1.μ.inv ≫ κ')
  have hκ'mk : Abelian.Ext.mk₀ κ' = (Abelian.Ext.mk₀ D1.μ.hom).comp
      (Abelian.Ext.mk₀ (wcHMConst P ℓ t)) (zero_add 0) := by
    rw [Abelian.Ext.mk₀_comp_mk₀, ← ht, Iso.hom_inv_id_assoc]
  have hext : ∀ k (i : Fin (r k)), I.extMk (g k i) (k + 1) rfl (hg k i) =
      (Abelian.Ext.mk₀ κ').comp (I.extMk (f k i) (k + 1) rfl (hf k i)) (zero_add _) := by
    intro k i
    rw [InjectiveResolution.mk₀_comp_extMk]
    have e1 : g k i = κ' ≫ f k i := by
      rw [hgdef, hκ'def, Adjunction.homEquiv_naturality_right_symm]
    have key : ∀ (φ₁ φ₂ : D1.Φ.obj (SheafOfModules.unit (wcRingSheaf (wcXbar F Y₁) ℓ)) ⟶
        I.cocomplex.X k) (h₁ : φ₁ ≫ I.cocomplex.d k (k + 1) = 0)
        (h₂ : φ₂ ≫ I.cocomplex.d k (k + 1) = 0),
        φ₁ = φ₂ → I.extMk φ₁ (k + 1) rfl h₁ = I.extMk φ₂ (k + 1) rfl h₂ := by
      rintro _ _ _ _ rfl
      rfl
    exact key _ _ _ _ e1

  have hy : y = (Abelian.Ext.mk₀ D1.μ.inv).precomp (SheafOfModules.unit (wcRingSheaf P ℓ))
      (zero_add n) ((Abelian.Ext.mk₀ D1.μ.hom).comp y (zero_add n)) := by
    show y = (Abelian.Ext.mk₀ D1.μ.inv).comp ((Abelian.Ext.mk₀ D1.μ.hom).comp y (zero_add n))
      (zero_add n)
    rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
      Abelian.Ext.mk₀_id_comp]
  have hx0 : (Abelian.Ext.mk₀ D1.μ.hom).comp y (zero_add n) ∈
      (⊤ : AddSubgroup (Abelian.Ext (D1.Φ.obj (SheafOfModules.unit (wcRingSheaf (wcXbar F Y₁) ℓ)))
        (SheafOfModules.unit (wcRingSheaf P ℓ)) n)) := AddSubgroup.mem_top _
  rw [← hLH] at hx0
  rw [hy]
  refine (AddSubgroup.mem_comap (f := (Abelian.Ext.mk₀ D1.μ.inv).precomp
    (SheafOfModules.unit (wcRingSheaf P ℓ)) (zero_add n))).mp ?_
  refine (AddSubgroup.closure_le _).mpr ?_ hx0

  rintro z ⟨a, k, h, i, b, rfl⟩
  obtain rfl : k = n - a := by omega
  rw [SetLike.mem_coe, AddSubgroup.mem_comap]
  show (Abelian.Ext.mk₀ D1.μ.inv).comp ((Abelian.Ext.mapExactFunctor D1.Φ b).comp
    (I.extMk (g (n - a) i) (n - a + 1) rfl (hg (n - a) i)) h) (zero_add n) ∈ _
  apply AddSubgroup.subset_closure
  refine ⟨t, a, by omega, b, e (n - a) i, ?_⟩
  have hU1 : ∀ (p p' : ℕ) (hpp : p + p' = n) (x : wcHM P ℓ p) (x' : wcHM P ℓ p'),
      wcHMCup P ℓ p p' n hpp x x' = x.comp x' hpp := fun _ _ _ _ _ => rfl
  have hU2 : ∀ x : wcHM P ℓ n,
      wcHMScalar P ℓ n t x = x.comp (Abelian.Ext.mk₀ (wcHMConst P ℓ t)) (add_zero n) :=
    fun _ => rfl
  have hU3 : wcHMPull D1 a b = (Abelian.Ext.mk₀ D1.μ.inv).comp
      ((Abelian.Ext.mapExactFunctor D1.Φ b).comp (Abelian.Ext.mk₀ D1.μ.hom) (add_zero a))
      (zero_add a) := rfl
  rw [hext, hfe, hκ'mk]
  generalize wcHMPull D2 (n - a) (e (n - a) i) = w
  rw [Abelian.Ext.comp_assoc_of_second_deg_zero,
    wc_hm_unit_end_central P ℓ (wcHMConst P ℓ t) (n - a) w, hU2, hU1, hU3,
    Abelian.Ext.comp_assoc_of_third_deg_zero,
    Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D1.μ.inv)
      ((Abelian.Ext.mapExactFunctor D1.Φ b).comp (Abelian.Ext.mk₀ D1.μ.hom) (add_zero a))
      (w.comp (Abelian.Ext.mk₀ (wcHMConst P ℓ t)) (add_zero (n - a))) (zero_add a) h (by omega),
    Abelian.Ext.comp_assoc_of_second_deg_zero]

theorem wc_prod_fibre_projection (F : Type u) [Finite F] [Field F] (Y₁ Y₂ : Over (Spec (.of F)))
    [GeometricallyIrreducible Y₁.hom] [IsProper Y₁.hom] (d₁ : ℕ) [SmoothOfRelativeDimension d₁ Y₁.hom]
    [GeometricallyIrreducible Y₂.hom] [IsProper Y₂.hom] (d₂ : ℕ) [SmoothOfRelativeDimension d₂ Y₂.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (P : Scheme.{u}) (q₁ : P ⟶ wcXbar F Y₁) (q₂ : P ⟶ wcXbar F Y₂)
    (hq : IsPullback q₁ q₂ (wcPi2 F Y₁) (wcPi2 F Y₂))
    (D1 : wcHMPullData q₁ ℓ) (hD1 : wcHMPullCanonical D1)
    (D2 : wcHMPullData q₂ ℓ) (hD2 : wcHMPullCanonical D2)
    (a₀ : Spec (.of (AlgebraicClosure F)) ⟶ wcXbar F Y₁) (ha₀ : a₀ ≫ wcPi2 F Y₁ = 𝟙 _)
    (i : wcXbar F Y₂ ⟶ P) (hi1 : i ≫ q₁ = wcPi2 F Y₂ ≫ a₀) (hi2 : i ≫ q₂ = 𝟙 _)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (ω : wcHM (wcXbar F Y₁) ℓ (2 * d₁)) (y : wcHM P ℓ (2 * d₂)) :
    wcHMCup P ℓ (2 * d₁) (2 * d₂) (2 * d₁ + 2 * d₂) rfl (wcHMPull D1 (2 * d₁) ω) y =
      wcHMCup P ℓ (2 * d₁) (2 * d₂) (2 * d₁ + 2 * d₂) rfl (wcHMPull D1 (2 * d₁) ω)
        (wcHMPull D2 (2 * d₂) (wcHMPull Di (2 * d₂) y)) :=
by
  classical

  have hassoc : ∀ (S : Scheme.{u}) (a₁ a₂ a₃ a₁₂ a₂₃ a : ℕ) (h₁₂ : a₁ + a₂ = a₁₂)
      (h₂₃ : a₂ + a₃ = a₂₃) (h1 : a₁₂ + a₃ = a) (h2 : a₁ + a₂₃ = a)
      (x : wcHM S ℓ a₁) (y : wcHM S ℓ a₂) (z : wcHM S ℓ a₃),
      wcHMCup S ℓ a₁₂ a₃ a h1 (wcHMCup S ℓ a₁ a₂ a₁₂ h₁₂ x y) z =
        wcHMCup S ℓ a₁ a₂₃ a h2 x (wcHMCup S ℓ a₂ a₃ a₂₃ h₂₃ y z) := by
    intro S a₁ a₂ a₃ a₁₂ a₂₃ a h₁₂ h₂₃ h1 h2 x y z
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    simp only [wcHMCup, Abelian.Ext.bilinearComp_apply_apply]
    exact Abelian.Ext.comp_assoc x y z h₁₂ h₂₃ (by omega)

  have hscR : ∀ (S : Scheme.{u}) (p q r : ℕ) (h : p + q = r) (x : wcHM S ℓ p) (w : wcHM S ℓ q)
      (t : ℚ_[ℓ]), wcHMCup S ℓ p q r h x (wcHMScalar S ℓ q t w) =
        wcHMScalar S ℓ r t (wcHMCup S ℓ p q r h x w) := by
    intro S p q r h x w t
    exact (hassoc S p q 0 r q r h (add_zero q) (add_zero r) h x w
      (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst S ℓ t))).symm

  have F1 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (hD : wcHMPullCanonical D)
      (n : ℕ) (t : ℚ_[ℓ]) (x : wcHM S ℓ n),
      wcHMPull D n (wcHMScalar S ℓ n t x) = wcHMScalar S' ℓ n t (wcHMPull D n x) := by
    intro S S' f D hD n t x
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    have hk : D.Φ.map (wcHMConst S ℓ t) ≫ D.μ.hom = D.μ.hom ≫ wcHMConst S' ℓ t := by
      rw [← wc_hm_pull_const D hD t, Iso.hom_inv_id_assoc]
    have e2 : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf S' ℓ)} (z : Abelian.Ext A B n)
        (a : B ⟶ C') (b : C' ⟶ D'),
        (z.comp (Abelian.Ext.mk₀ a) (add_zero n)).comp (Abelian.Ext.mk₀ b) (add_zero n) =
          z.comp (Abelian.Ext.mk₀ (a ≫ b)) (add_zero n) := by
      intro A B C' D' z a b
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    have e3 := Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mk₀ D.μ.inv)
      ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero n))
      (Abelian.Ext.mk₀ (wcHMConst S' ℓ t)) (zero_add n)
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (x.comp (Abelian.Ext.mk₀ (wcHMConst S ℓ t)) (add_zero n))).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n)).comp
        (Abelian.Ext.mk₀ (wcHMConst S' ℓ t)) (add_zero n)
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀, e2, e3, e2, hk]

  have F3 : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (p q r : ℕ) (h : p + q = r)
      (x : wcHM S ℓ p) (y : wcHM S ℓ q),
      wcHMPull D r (wcHMCup S ℓ p q r h x y) =
        wcHMCup S' ℓ p q r h (wcHMPull D p x) (wcHMPull D q y) := by
    intro S S' f D p q r h x y
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ (x.comp y h)).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero r)) (zero_add r) =
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero p)) (zero_add p)).comp
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)) h
    have i1 := Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ D.μ.inv)
      ((Abelian.Ext.mapExactFunctor D.Φ x).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero p))
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)) (zero_add p) h
      (by omega : 0 + p + q = r)
    have i2 := Abelian.Ext.comp_assoc_of_second_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x)
      (Abelian.Ext.mk₀ D.μ.hom)
      ((Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ y).comp
        (Abelian.Ext.mk₀ D.μ.hom) (add_zero q)) (zero_add q)) h
    have i3 : (Abelian.Ext.mk₀ D.μ.hom).comp ((Abelian.Ext.mk₀ D.μ.inv).comp
        ((Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero q))
        (zero_add q)) (zero_add q) =
        (Abelian.Ext.mapExactFunctor D.Φ y).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero q) := by
      rw [← Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
        Abelian.Ext.mk₀_id_comp]
    have i4 := Abelian.Ext.comp_assoc_of_third_deg_zero (Abelian.Ext.mapExactFunctor D.Φ x)
      (Abelian.Ext.mapExactFunctor D.Φ y) (Abelian.Ext.mk₀ D.μ.hom) h
    rw [Abelian.Ext.mapExactFunctor_comp, i1, i2, i3, ← i4]

  have hpc : ∀ {S S' : Scheme.{u}} {f : S' ⟶ S} (D : wcHMPullData f ℓ) (hD : wcHMPullCanonical D)
      (c : ℚ_[ℓ]),
      wcHMPull D 0 (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst S ℓ c)) =
        @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst S' ℓ c) := by
    intro S S' f D hD c
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    show (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        (Abelian.Ext.mk₀ (wcHMConst S ℓ c))).comp (Abelian.Ext.mk₀ D.μ.hom) (add_zero 0))
        (zero_add 0) = Abelian.Ext.mk₀ (wcHMConst S' ℓ c)
    rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀,
      wc_hm_pull_const D hD c]

  have hvan : ∀ (X : Over (Spec (.of F))) [GeometricallyIrreducible X.hom] [IsProper X.hom]
      (d : ℕ) [SmoothOfRelativeDimension d X.hom] (n : ℕ), 2 * d < n →
      ∀ x : wcHM (wcXbar F X) ℓ n, x = 0 := by
    intro X _ _ d _ n hn x
    have h : WeaklyEtale (Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
        (wc_weaklyEtale_algebraicClosure F)
    obtain ⟨T, -, -⟩ := wc_hm_comparison F X h ℓ
    have h0 := wc_coh_vanishing F X d ℓ hℓ h n hn ((T n).symm x)
    calc x = T n ((T n).symm x) := (AddEquiv.apply_symm_apply _ _).symm
      _ = 0 := by rw [h0, map_zero]

  have hpt : ∀ j : ℕ, 1 ≤ j → ∀ x : wcHM (Spec (.of (AlgebraicClosure F))) ℓ j, x = 0 := by
    intro j hj x
    haveI : IsProper (Over.mk (𝟙 (Spec (.of F)))).hom :=
      show IsProper (𝟙 (Spec (.of F))) from inferInstance
    haveI : SmoothOfRelativeDimension 0 (Over.mk (𝟙 (Spec (.of F)))).hom :=
      show SmoothOfRelativeDimension 0 (𝟙 (Spec (.of F))) from inferInstance
    haveI : IsIso (Over.mk (𝟙 (Spec (.of F)))).hom :=
      show IsIso (𝟙 (Spec (.of F))) from inferInstance
    haveI : GeometricallyIrreducible (Over.mk (𝟙 (Spec (.of F)))).hom := by
      constructor
      intro K _ yK Z fst snd hpb
      let lft : Spec (.of K) ⟶ Z := hpb.lift yK (𝟙 _) (by simp)
      have e : snd ≫ lft = 𝟙 Z := by
        apply hpb.hom_ext
        · rw [Category.assoc, hpb.lift_fst, Category.id_comp, ← hpb.w]
          simp
        · rw [Category.assoc, hpb.lift_snd, Category.comp_id, Category.id_comp]
      have hs : Function.Surjective lft := fun z =>
        ⟨snd z, by rw [← Scheme.Hom.comp_apply, e] <;> first | rfl | simp⟩
      exact Function.Surjective.irreducibleSpace lft.continuous hs
    haveI : IsIso (wcPi2 F (Over.mk (𝟙 (Spec (.of F))))) :=
      Limits.pullback_snd_iso_of_left_iso _ _
    obtain ⟨De, hDe⟩ := wc_hm_pull_data_exists (wcPi2 F (Over.mk (𝟙 (Spec (.of F))))) ℓ
    obtain ⟨De', hDe'⟩ :=
      wc_hm_pull_data_exists (inv (wcPi2 F (Over.mk (𝟙 (Spec (.of F)))))) ℓ
    obtain ⟨D0, hD0⟩ := wc_hm_pull_data_exists (𝟙 (Spec (.of (AlgebraicClosure F)))) ℓ
    have h1 := wc_hm_pull_comp (wcPi2 F (Over.mk (𝟙 (Spec (.of F)))))
      (inv (wcPi2 F (Over.mk (𝟙 (Spec (.of F)))))) (𝟙 _) (IsIso.inv_hom_id _)
      De hDe De' hDe' D0 hD0 j x
    rw [wc_hm_pull_id _ rfl D0 hD0,
      hvan (Over.mk (𝟙 (Spec (.of F)))) 0 j (by omega) (wcHMPull De j x), map_zero] at h1
    exact h1

  have hdeg0 : ∀ a : wcHM (wcXbar F Y₁) ℓ 0, ∃ s : ℚ_[ℓ],
      a = @Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst (wcXbar F Y₁) ℓ s) := by
    intro a
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F Y₁) ℓ)) := HasExt.standard _
    obtain ⟨e, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 a
    haveI : IrreducibleSpace (wcXbar F Y₁) :=
      GeometricallyIrreducible.geometrically_irreducibleSpace (f := Y₁.hom)
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) _ _
        (IsPullback.of_hasPullback _ _)
    obtain ⟨s, rfl⟩ := wc_hm_unit_end_const (wcXbar F Y₁) ℓ e
    exact ⟨s, rfl⟩

  obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists (i ≫ q₁) ℓ
  obtain ⟨Da, hDa⟩ := wc_hm_pull_data_exists a₀ ℓ
  obtain ⟨Dπ, hDπ⟩ := wc_hm_pull_data_exists (wcPi2 F Y₂) ℓ
  obtain ⟨Did, hDid⟩ := wc_hm_pull_data_exists (𝟙 (wcXbar F Y₂)) ℓ
  have R2 : ∀ (n : ℕ) (z : wcHM (wcXbar F Y₂) ℓ n), wcHMPull Di n (wcHMPull D2 n z) = z :=
    fun n z => (wc_hm_pull_comp q₂ i (𝟙 _) hi2 D2 hD2 Di hDi Did hDid n z).symm.trans
      (wc_hm_pull_id _ rfl Did hDid n z)
  have R1 : ∀ (n : ℕ) (a : wcHM (wcXbar F Y₁) ℓ n),
      wcHMPull Di n (wcHMPull D1 n a) = wcHMPull Dπ n (wcHMPull Da n a) :=
    fun n a => (wc_hm_pull_comp q₁ i (i ≫ q₁) rfl D1 hD1 Di hDi Dk hDk n a).symm.trans
      (wc_hm_pull_comp a₀ (wcPi2 F Y₂) (i ≫ q₁) hi1.symm Da hDa Dπ hDπ Dk hDk n a)

  have hspan := wc_prod_kunneth_span F Y₁ Y₂ d₁ d₂ ℓ hℓ P q₁ q₂ hq D1 hD1 D2 hD2 (2 * d₂) y
  refine AddSubgroup.closure_induction
    (p := fun x _ => wcHMCup P ℓ (2 * d₁) (2 * d₂) (2 * d₁ + 2 * d₂) rfl
        (wcHMPull D1 (2 * d₁) ω) x =
      wcHMCup P ℓ (2 * d₁) (2 * d₂) (2 * d₁ + 2 * d₂) rfl (wcHMPull D1 (2 * d₁) ω)
        (wcHMPull D2 (2 * d₂) (wcHMPull Di (2 * d₂) x))) ?_ ?_ ?_ ?_ hspan
  · rintro w ⟨t, j, hj, a, b, rfl⟩
    beta_reduce
    rcases Nat.eq_zero_or_pos j with rfl | hjpos
    ·
      obtain ⟨s, rfl⟩ := hdeg0 a
      have hz : wcHMPull D2 (2 * d₂) (wcHMScalar (wcXbar F Y₂) ℓ (2 * d₂) t
          (wcHMCup (wcXbar F Y₂) ℓ 0 (2 * d₂ - 0) (2 * d₂) (by omega)
            (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst (wcXbar F Y₂) ℓ s)) b)) =
          wcHMScalar P ℓ (2 * d₂) t (wcHMCup P ℓ 0 (2 * d₂ - 0) (2 * d₂) (by omega)
            (wcHMPull D1 0
              (@Abelian.Ext.mk₀ _ _ _ (HasExt.standard _) _ _ (wcHMConst (wcXbar F Y₁) ℓ s)))
            (wcHMPull D2 (2 * d₂ - 0) b)) := by
        rw [F1 D2 hD2, F3 D2, hpc D2 hD2, hpc D1 hD1]
      rw [← hz, R2]
    ·
      have hL0 : wcHMCup P ℓ (2 * d₁) (2 * d₂) (2 * d₁ + 2 * d₂) rfl (wcHMPull D1 (2 * d₁) ω)
          (wcHMScalar P ℓ (2 * d₂) t (wcHMCup P ℓ j (2 * d₂ - j) (2 * d₂) (by omega)
            (wcHMPull D1 j a) (wcHMPull D2 (2 * d₂ - j) b))) = 0 := by
        rw [hscR, ← hassoc P (2 * d₁) j (2 * d₂ - j) (2 * d₁ + j) (2 * d₂) (2 * d₁ + 2 * d₂) rfl
          (by omega) (by omega) rfl, ← F3 D1 (2 * d₁) j (2 * d₁ + j) rfl ω a,
          hvan Y₁ d₁ (2 * d₁ + j) (by omega) (wcHMCup (wcXbar F Y₁) ℓ (2 * d₁) j (2 * d₁ + j) rfl ω a)]
        simp only [map_zero, AddMonoidHom.zero_apply]
      have hR0 : wcHMPull Di (2 * d₂) (wcHMScalar P ℓ (2 * d₂) t (wcHMCup P ℓ j (2 * d₂ - j)
          (2 * d₂) (by omega) (wcHMPull D1 j a) (wcHMPull D2 (2 * d₂ - j) b))) = 0 := by
        rw [F1 Di hDi, F3 Di, R1, hpt j (by omega) (wcHMPull Da j a)]
        simp only [map_zero, AddMonoidHom.zero_apply]
      rw [hL0, hR0]
      simp only [map_zero]
  · beta_reduce
    simp only [map_zero]
  · intro x z _ _ hx hz
    beta_reduce at hx hz ⊢
    simp only [map_add]
    rw [hx, hz]
  · intro x _ hx
    beta_reduce at hx ⊢
    simp only [map_neg]
    rw [hx]

theorem wc_kunneth_top_nonvanishing (F' : Type u) [Finite F'] [Field F'] (Y₁ Y₂ : Over (Spec (.of F')))
    [GeometricallyIrreducible Y₁.hom] [IsProper Y₁.hom] (d₁ : ℕ) [SmoothOfRelativeDimension d₁ Y₁.hom]
    [GeometricallyIrreducible Y₂.hom] [IsProper Y₂.hom] (d₂ : ℕ) [SmoothOfRelativeDimension d₂ Y₂.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F')
    (h₁ : WeaklyEtale (Limits.pullback.fst Y₁.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
    (h₂ : WeaklyEtale (Limits.pullback.fst Y₂.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
    (hW : WeaklyEtale (Limits.pullback.fst
          (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
    (t₁ : wcModCoh F' Y₁ h₁ ℓ (2 * d₁)) (t₂ : wcModCoh F' Y₂ h₂ ℓ (2 * d₂)) :
    t₁ ≠ 0 → t₂ ≠ 0 →
      wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
        (2 * d₁) (2 * d₂) (2 * d₁ + 2 * d₂) rfl
        (wcModPull F' (wcProdPr1 F' Y₁ Y₂) hW h₁ ℓ (2 * d₁) t₁)
        (wcModPull F' (wcProdPr2 F' Y₁ Y₂) hW h₂ ℓ (2 * d₂) t₂) ≠ 0 :=
by
  classical
  intro ht₁ ht₂

  haveI : SmoothOfRelativeDimension d₂ (Limits.pullback.fst Y₁.hom Y₂.hom) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d₂)
      (IsPullback.of_hasPullback Y₁.hom Y₂.hom).flip inferInstance
  haveI iS : SmoothOfRelativeDimension (d₂ + d₁)
      (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom :=
    smoothOfRelativeDimension_comp d₂ d₁ (Limits.pullback.fst Y₁.hom Y₂.hom) Y₁.hom
  haveI iGI : GeometricallyIrreducible (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom :=
    GeometricallyIrreducible.comp (Limits.pullback.fst Y₁.hom Y₂.hom) Y₁.hom
  haveI iP : IsProper (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom :=
    inferInstanceAs (IsProper (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom))

  have hPD : ∀ x : wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ (2 * d₁),
      (∀ y : wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ (2 * d₂),
        wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
          (2 * d₁) (2 * d₂) (2 * d₁ + 2 * d₂) rfl x y = 0) → x = 0 := by
    have key : ∀ (b N : ℕ) (hb : b = 2 * (d₂ + d₁) - 2 * d₁) (hN : N = 2 * (d₂ + d₁))
        (hk : 2 * d₁ + b = N)
        (x : wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ (2 * d₁)),
        (∀ y : wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ b,
          wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
            (2 * d₁) b N hk x y = 0) → x = 0 := by
      intro b N hb hN hk x hx
      subst hb
      subst hN
      exact (wc_modcup_perfect F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom))
        (d₂ + d₁) ℓ hℓ hW (2 * d₁) (by omega)).1 x hx
    exact key (2 * d₂) (2 * d₁ + 2 * d₂) (by omega) (by omega) rfl

  obtain ⟨T₂, hT₂s, -⟩ := wc_modcoh_comparison_frob F' Y₂ h₂ ℓ
  obtain ⟨η, hηs, hηi⟩ := wc_top_coh_trace_injective F' Y₂ d₂ ℓ hℓ h₂
  have hT₂s' : ∀ (c : ℚ_[ℓ]) (v : wcModCoh F' Y₂ h₂ ℓ (2 * d₂)),
      (T₂ (2 * d₂)).symm (wcModScalar F' Y₂ h₂ ℓ (2 * d₂) c v) =
        wcCohScalar F' Y₂ h₂ ℓ (2 * d₂) c ((T₂ (2 * d₂)).symm v) := fun c v =>
    (T₂ (2 * d₂)).injective (by rw [hT₂s, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  have hline : ∀ u : wcModCoh F' Y₂ h₂ ℓ (2 * d₂),
      ∃ c : ℚ_[ℓ], u = wcModScalar F' Y₂ h₂ ℓ (2 * d₂) c t₂ := by
    intro u
    have hε0 : η ((T₂ (2 * d₂)).symm t₂) ≠ 0 := by
      intro h0
      apply ht₂
      have h1 : (T₂ (2 * d₂)).symm t₂ = 0 := hηi (h0.trans (map_zero η).symm)
      exact (AddEquiv.map_eq_zero_iff _).mp h1
    refine ⟨η ((T₂ (2 * d₂)).symm u) / η ((T₂ (2 * d₂)).symm t₂), ?_⟩
    apply (T₂ (2 * d₂)).symm.injective
    apply hηi
    rw [hT₂s', hηs, div_mul_cancel₀ _ hε0]

  have pullScalar : ∀ {X Y : Over (Spec (.of F'))} (p : X ⟶ Y)
      (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
      (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
      (n : ℕ) (c : ℚ_[ℓ]) (u : wcModCoh F' Y hY ℓ n),
      wcModPull F' p hX hY ℓ n (wcModScalar F' Y hY ℓ n c u) =
        wcModScalar F' X hX ℓ n c (wcModPull F' p hX hY ℓ n u) := by
    intro X Y p hX hY n c u
    unfold wcModPull
    split_ifs with hP
    · haveI := hP.fst
      haveI := hP.snd.fst
      haveI := hP.snd.snd.1
      haveI := hP.snd.snd.2.1
      haveI := hP.snd.snd.2.2.1
      haveI := hP.snd.snd.2.2.2.1
      letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F' Y hY ℓ)) := HasExt.standard _
      letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F' X hX ℓ)) := HasExt.standard _
      have hC := hP.snd.snd.2.2.2.2 c
      have hSY : ∀ v : wcModCoh F' Y hY ℓ n, wcModScalar F' Y hY ℓ n c v =
          v.comp (Abelian.Ext.mk₀ (wcModConst F' Y hY ℓ c)) (add_zero n) := fun _ => rfl
      have hSX : ∀ v : wcModCoh F' X hX ℓ n, wcModScalar F' X hX ℓ n c v =
          v.comp (Abelian.Ext.mk₀ (wcModConst F' X hX ℓ c)) (add_zero n) := fun _ => rfl
      simp only [AddMonoidHom.mk'_apply]
      rw [hSY, hSX, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
      simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hC]
    · simp

  have hcupS : ∀ (c : ℚ_[ℓ])
      (x : wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ (2 * d₁))
      (y : wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ (2 * d₂)),
      wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
          (2 * d₁) (2 * d₂) (2 * d₁ + 2 * d₂) rfl x
          (wcModScalar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ (2 * d₂) c y) =
        wcModScalar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
          (2 * d₁ + 2 * d₂) c
          (wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
            (2 * d₁) (2 * d₂) (2 * d₁ + 2 * d₂) rfl x y) := by
    intro c x y
    letI : HasExt (SheafOfModules.{u+1}
      (wcSliceRing F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ)) :=
      HasExt.standard _
    have hU1 : ∀ {i' j' k' : ℕ} (hk' : i' + j' = k')
        (a' : wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ i')
        (b' : wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ j'),
        wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ i' j' k' hk' a' b' =
          a'.comp b' hk' := fun _ _ _ => rfl
    have hU2 : ∀ (n' : ℕ)
        (a' : wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n'),
        wcModScalar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n' c a' =
          a'.comp (Abelian.Ext.mk₀ (wcModConst F'
            (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ c)) (add_zero n') :=
      fun _ _ => rfl
    rw [hU1, hU1, hU2, hU2,
      Abelian.Ext.comp_assoc x y (Abelian.Ext.mk₀ (wcModConst F'
        (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ c)) rfl (add_zero _)
        (by omega)]

  obtain ⟨Θ, hΘmul, hΘpull⟩ := wc_modPull_hm_transport F' ℓ
  have hOK₁ := wc_modPullOK_holds F' (wcProdPr1 F' Y₁ Y₂) hW h₁ ℓ
  have hOK₂ := wc_modPullOK_holds F' (wcProdPr2 F' Y₁ Y₂) hW h₂ ℓ

  obtain ⟨r₁, h11, h12⟩ : ∃ r₁ : wcXbar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) ⟶
        wcXbar F' Y₁,
      r₁ ≫ Limits.pullback.fst Y₁.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) =
        Limits.pullback.fst (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫
          Limits.pullback.fst Y₁.hom Y₂.hom ∧
      r₁ ≫ Limits.pullback.snd Y₁.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) =
        Limits.pullback.snd (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) :=
    ⟨Limits.pullback.lift
      (Limits.pullback.fst (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫
        Limits.pullback.fst Y₁.hom Y₂.hom)
      (Limits.pullback.snd (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))
      (by rw [Category.assoc]; exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hc12 : Limits.pullback.snd Y₁.hom Y₂.hom ≫ Y₂.hom =
      Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom := Limits.pullback.condition.symm
  obtain ⟨r₂, h21, h22⟩ : ∃ r₂ : wcXbar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) ⟶
        wcXbar F' Y₂,
      r₂ ≫ Limits.pullback.fst Y₂.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) =
        Limits.pullback.fst (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫
          Limits.pullback.snd Y₁.hom Y₂.hom ∧
      r₂ ≫ Limits.pullback.snd Y₂.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) =
        Limits.pullback.snd (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) :=
    ⟨Limits.pullback.lift
      (Limits.pullback.fst (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))) ≫
        Limits.pullback.snd Y₁.hom Y₂.hom)
      (Limits.pullback.snd (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))
      (by rw [Category.assoc, hc12]; exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hq := wc_prod_xbar_isPullback F' Y₁ Y₂ r₁ r₂ h11 h12 h21 h22
  obtain ⟨a₀, ha₀⟩ := wc_xbar_geom_point_exists F' Y₁ d₁
  obtain ⟨b₀, hb₀⟩ := wc_xbar_geom_point_exists F' Y₂ d₂
  obtain ⟨ib, hi1, hi2⟩ : ∃ ib : wcXbar F' Y₂ ⟶
        wcXbar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)),
      ib ≫ r₁ = wcPi2 F' Y₂ ≫ a₀ ∧ ib ≫ r₂ = 𝟙 _ :=
    ⟨hq.lift (wcPi2 F' Y₂ ≫ a₀) (𝟙 _)
      (by rw [Category.assoc, ha₀, Category.comp_id, Category.id_comp]),
      hq.lift_fst _ _ _, hq.lift_snd _ _ _⟩
  obtain ⟨sb, hs1⟩ : ∃ sb : wcXbar F' Y₁ ⟶
        wcXbar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)),
      sb ≫ r₁ = 𝟙 _ :=
    ⟨hq.lift (𝟙 _) (wcPi2 F' Y₁ ≫ b₀)
      (by rw [Category.id_comp, Category.assoc, hb₀, Category.comp_id]),
      hq.lift_fst _ _ _⟩
  obtain ⟨Dr1, hDr1⟩ := wc_hm_pull_data_exists r₁ ℓ
  obtain ⟨Dr2, hDr2⟩ := wc_hm_pull_data_exists r₂ ℓ
  obtain ⟨Di, hDi⟩ := wc_hm_pull_data_exists ib ℓ
  obtain ⟨Ds, hDs⟩ := wc_hm_pull_data_exists sb ℓ
  obtain ⟨Did, hDid⟩ := wc_hm_pull_data_exists (𝟙 (wcXbar F' Y₁)) ℓ
  have hΘ1 : ∀ u : wcModCoh F' Y₁ h₁ ℓ (2 * d₁),
      Θ (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW (2 * d₁)
          (wcModPull F' (wcProdPr1 F' Y₁ Y₂) hW h₁ ℓ (2 * d₁) u) =
        wcHMPull Dr1 (2 * d₁) (Θ Y₁ h₁ (2 * d₁) u) :=
    hΘpull _ Y₁ (wcProdPr1 F' Y₁ Y₂) hW h₁ r₁ h11 h12 Dr1 hDr1 hOK₁ (2 * d₁)
  have hΘ2 : ∀ u : wcModCoh F' Y₂ h₂ ℓ (2 * d₂),
      Θ (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW (2 * d₂)
          (wcModPull F' (wcProdPr2 F' Y₁ Y₂) hW h₂ ℓ (2 * d₂) u) =
        wcHMPull Dr2 (2 * d₂) (Θ Y₂ h₂ (2 * d₂) u) :=
    hΘpull _ Y₂ (wcProdPr2 F' Y₁ Y₂) hW h₂ r₂ h21 h22 Dr2 hDr2 hOK₂ (2 * d₂)

  have hR1 : ∀ x : wcHM (wcXbar F' Y₁) ℓ (2 * d₁),
      wcHMPull Ds (2 * d₁) (wcHMPull Dr1 (2 * d₁) x) = x := by
    intro x
    rw [← wc_hm_pull_comp r₁ sb (𝟙 _) hs1 Dr1 hDr1 Ds hDs Did hDid (2 * d₁) x]
    exact wc_hm_pull_id (𝟙 _) rfl Did hDid (2 * d₁) x
  have hφ1 : wcModPull F' (wcProdPr1 F' Y₁ Y₂) hW h₁ ℓ (2 * d₁) t₁ ≠ 0 := by
    intro h0
    apply ht₁
    have e1 : wcHMPull Dr1 (2 * d₁) (Θ Y₁ h₁ (2 * d₁) t₁) = 0 := by
      rw [← hΘ1, h0, map_zero]
    have e2 : Θ Y₁ h₁ (2 * d₁) t₁ = 0 := by
      rw [← hR1 (Θ Y₁ h₁ (2 * d₁) t₁), e1, map_zero]
    exact (AddEquiv.map_eq_zero_iff _).mp e2

  obtain ⟨z, hz⟩ : ∃ z : wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
        (2 * d₂),
      wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
        (2 * d₁) (2 * d₂) (2 * d₁ + 2 * d₂) rfl
        (wcModPull F' (wcProdPr1 F' Y₁ Y₂) hW h₁ ℓ (2 * d₁) t₁) z ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    exact hφ1 (hPD _ hcon)

  have hcrux := wc_prod_fibre_projection F' Y₁ Y₂ d₁ d₂ ℓ hℓ _ r₁ r₂ hq Dr1 hDr1 Dr2 hDr2
    a₀ ha₀ ib hi1 hi2 Di hDi (Θ Y₁ h₁ (2 * d₁) t₁)
    (Θ (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW (2 * d₂) z)
  have hzeq : wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
        (2 * d₁) (2 * d₂) (2 * d₁ + 2 * d₂) rfl
        (wcModPull F' (wcProdPr1 F' Y₁ Y₂) hW h₁ ℓ (2 * d₁) t₁) z =
      wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
        (2 * d₁) (2 * d₂) (2 * d₁ + 2 * d₂) rfl
        (wcModPull F' (wcProdPr1 F' Y₁ Y₂) hW h₁ ℓ (2 * d₁) t₁)
        (wcModPull F' (wcProdPr2 F' Y₁ Y₂) hW h₂ ℓ (2 * d₂)
          ((Θ Y₂ h₂ (2 * d₂)).symm (wcHMPull Di (2 * d₂)
            (Θ (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW (2 * d₂) z)))) := by
    apply (Θ (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW (2 * d₁ + 2 * d₂)).injective
    rw [hΘmul, hΘmul, hΘ1, hΘ2, AddEquiv.apply_symm_apply]
    exact hcrux

  obtain ⟨c, hc⟩ := hline ((Θ Y₂ h₂ (2 * d₂)).symm (wcHMPull Di (2 * d₂)
    (Θ (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW (2 * d₂) z)))
  intro hzero
  apply hz
  rw [hzeq, hc, pullScalar, hcupS, hzero, map_zero]

theorem wc_kunneth_top_package (F' : Type u) [Finite F'] [Field F'] (Y₁ Y₂ : Over (Spec (.of F')))
    [GeometricallyIrreducible Y₁.hom] [IsProper Y₁.hom] (d₁ : ℕ) [SmoothOfRelativeDimension d₁ Y₁.hom]
    [GeometricallyIrreducible Y₂.hom] [IsProper Y₂.hom] (d₂ : ℕ) [SmoothOfRelativeDimension d₂ Y₂.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F')
    (h₁ : WeaklyEtale (Limits.pullback.fst Y₁.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
    (h₂ : WeaklyEtale (Limits.pullback.fst Y₂.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
    (hW : WeaklyEtale (Limits.pullback.fst
          (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))) :
    ∃ (T₁ : ∀ n : ℕ, wcCoh F' Y₁ h₁ ℓ n ≃+ wcModCoh F' Y₁ h₁ ℓ n)
      (T₂ : ∀ n : ℕ, wcCoh F' Y₂ h₂ ℓ n ≃+ wcModCoh F' Y₂ h₂ ℓ n)
      (TW : ∀ n : ℕ, wcCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n ≃+
        wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n)
      (φ₁ : ∀ n : ℕ, wcModCoh F' Y₁ h₁ ℓ n →+
        wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n)
      (φ₂ : ∀ n : ℕ, wcModCoh F' Y₂ h₂ ℓ n →+
        wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n),
      (∀ (n : ℕ) (c : ℚ_[ℓ]) (x : wcCoh F' Y₁ h₁ ℓ n),
        T₁ n (wcCohScalar F' Y₁ h₁ ℓ n c x) = wcModScalar F' Y₁ h₁ ℓ n c (T₁ n x)) ∧
      (∀ (n : ℕ) (c : ℚ_[ℓ]) (x : wcCoh F' Y₂ h₂ ℓ n),
        T₂ n (wcCohScalar F' Y₂ h₂ ℓ n c x) = wcModScalar F' Y₂ h₂ ℓ n c (T₂ n x)) ∧
      (∀ (n : ℕ) (c : ℚ_[ℓ])
          (x : wcCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n),
        TW n (wcCohScalar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n c x) =
          wcModScalar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n c (TW n x)) ∧
      (∀ (n : ℕ) (c : ℚ_[ℓ]) (u : wcModCoh F' Y₁ h₁ ℓ n),
        φ₁ n (wcModScalar F' Y₁ h₁ ℓ n c u) =
          wcModScalar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n c (φ₁ n u)) ∧
      (∀ (n : ℕ) (c : ℚ_[ℓ]) (u : wcModCoh F' Y₂ h₂ ℓ n),
        φ₂ n (wcModScalar F' Y₂ h₂ ℓ n c u) =
          wcModScalar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n c (φ₂ n u)) ∧
      (∀ (i j k : ℕ) (hk : i + j = k) (u : wcModCoh F' Y₁ h₁ ℓ i) (v : wcModCoh F' Y₁ h₁ ℓ j),
        φ₁ k (wcModCup F' Y₁ h₁ ℓ i j k hk u v) =
          wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ i j k hk
            (φ₁ i u) (φ₁ j v)) ∧
      (∀ (i j k : ℕ) (hk : i + j = k) (u : wcModCoh F' Y₂ h₂ ℓ i) (v : wcModCoh F' Y₂ h₂ ℓ j),
        φ₂ k (wcModCup F' Y₂ h₂ ℓ i j k hk u v) =
          wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ i j k hk
            (φ₂ i u) (φ₂ j v)) ∧
      (∀ (i j k : ℕ) (hk : i + j = k) (x : wcCoh F' Y₁ h₁ ℓ i) (y : wcCoh F' Y₂ h₂ ℓ j),
        wcCohFrob F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ k
            ((TW k).symm (wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
              i j k hk (φ₁ i (T₁ i x)) (φ₂ j (T₂ j y)))) =
          (TW k).symm (wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
            i j k hk (φ₁ i (T₁ i (wcCohFrob F' Y₁ h₁ ℓ i x)))
            (φ₂ j (T₂ j (wcCohFrob F' Y₂ h₂ ℓ j y))))) ∧
      (∀ (t₁ : wcModCoh F' Y₁ h₁ ℓ (2 * d₁)) (t₂ : wcModCoh F' Y₂ h₂ ℓ (2 * d₂)),
        t₁ ≠ 0 → t₂ ≠ 0 →
        wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
          (2 * d₁) (2 * d₂) (2 * d₁ + 2 * d₂) rfl (φ₁ (2 * d₁) t₁) (φ₂ (2 * d₂) t₂) ≠ 0) :=
by
  classical

  have frobMul : ∀ (X : Over (Spec (.of F')))
      (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
      (i j k : ℕ) (hk : i + j = k) (u : wcModCoh F' X hX ℓ i) (v : wcModCoh F' X hX ℓ j),
      wcModFrob F' X hX ℓ k (wcModCup F' X hX ℓ i j k hk u v) =
        wcModCup F' X hX ℓ i j k hk (wcModFrob F' X hX ℓ i u) (wcModFrob F' X hX ℓ j v) := by
    intro X hX i j k hk u v
    unfold wcModFrob
    split_ifs with hΨ
    · haveI := hΨ.1
      haveI := hΨ.2.1
      haveI := hΨ.2.2
      letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F' X hX ℓ)) := HasExt.standard _
      exact Abelian.Ext.mapExactFunctor_comp
        (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F' X hX ℓ)) u v hk
    · simp

  have pullScalar : ∀ {X Y : Over (Spec (.of F'))} (p : X ⟶ Y)
      (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
      (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
      (n : ℕ) (c : ℚ_[ℓ]) (u : wcModCoh F' Y hY ℓ n),
      wcModPull F' p hX hY ℓ n (wcModScalar F' Y hY ℓ n c u) =
        wcModScalar F' X hX ℓ n c (wcModPull F' p hX hY ℓ n u) := by
    intro X Y p hX hY n c u
    unfold wcModPull
    split_ifs with hP
    · haveI := hP.fst
      haveI := hP.snd.fst
      haveI := hP.snd.snd.1
      haveI := hP.snd.snd.2.1
      haveI := hP.snd.snd.2.2.1
      haveI := hP.snd.snd.2.2.2.1
      letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F' Y hY ℓ)) := HasExt.standard _
      letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F' X hX ℓ)) := HasExt.standard _
      have hC := hP.snd.snd.2.2.2.2 c
      have hSY : ∀ v : wcModCoh F' Y hY ℓ n, wcModScalar F' Y hY ℓ n c v =
          v.comp (Abelian.Ext.mk₀ (wcModConst F' Y hY ℓ c)) (add_zero n) := fun _ => rfl
      have hSX : ∀ v : wcModCoh F' X hX ℓ n, wcModScalar F' X hX ℓ n c v =
          v.comp (Abelian.Ext.mk₀ (wcModConst F' X hX ℓ c)) (add_zero n) := fun _ => rfl
      simp only [AddMonoidHom.mk'_apply]
      rw [hSY, hSX, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
      simp only [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hC]
    · simp

  have pullCup : ∀ {X Y : Over (Spec (.of F'))} (p : X ⟶ Y)
      (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
      (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
      (i j k : ℕ) (hk : i + j = k) (u : wcModCoh F' Y hY ℓ i) (v : wcModCoh F' Y hY ℓ j),
      wcModPull F' p hX hY ℓ k (wcModCup F' Y hY ℓ i j k hk u v) =
        wcModCup F' X hX ℓ i j k hk (wcModPull F' p hX hY ℓ i u) (wcModPull F' p hX hY ℓ j v) := by
    intro X Y p hX hY i j k hk u v
    unfold wcModPull
    split_ifs with hP
    · haveI := hP.fst
      haveI := hP.snd.fst
      haveI := hP.snd.snd.1
      haveI := hP.snd.snd.2.1
      haveI := hP.snd.snd.2.2.1
      haveI := hP.snd.snd.2.2.2.1
      letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F' Y hY ℓ)) := HasExt.standard _
      letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F' X hX ℓ)) := HasExt.standard _
      have hcY : wcModCup F' Y hY ℓ i j k hk u v = u.comp v hk := rfl
      have hcX : ∀ (x : wcModCoh F' X hX ℓ i) (y : wcModCoh F' X hX ℓ j),
          wcModCup F' X hX ℓ i j k hk x y = x.comp y hk := fun _ _ => rfl
      simp only [AddMonoidHom.mk'_apply]
      rw [hcY, hcX, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.comp_assoc_of_third_deg_zero,
        Abelian.Ext.comp_assoc _ _ _ (zero_add i) hk (show 0 + i + j = k by omega),
        Abelian.Ext.comp_assoc _ _ _ (add_zero i) (zero_add j) (show i + 0 + j = k by omega),
        Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
    · simp

  obtain ⟨T₁, hT₁s, hT₁F⟩ := wc_modcoh_comparison_frob F' Y₁ h₁ ℓ
  obtain ⟨T₂, hT₂s, hT₂F⟩ := wc_modcoh_comparison_frob F' Y₂ h₂ ℓ
  obtain ⟨TW, hTWs, hTWF⟩ :=
    wc_modcoh_comparison_frob F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
  have hFrW : ∀ (k : ℕ)
      (w : wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ k),
      wcCohFrob F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ k ((TW k).symm w) =
        (TW k).symm (wcModFrob F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ k w) :=
    fun k w => (TW k).injective (by rw [hTWF, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  refine ⟨T₁, T₂, TW, fun n => wcModPull F' (wcProdPr1 F' Y₁ Y₂) hW h₁ ℓ n,
    fun n => wcModPull F' (wcProdPr2 F' Y₁ Y₂) hW h₂ ℓ n, hT₁s, hT₂s, hTWs,
    fun n c u => pullScalar (wcProdPr1 F' Y₁ Y₂) hW h₁ n c u,
    fun n c u => pullScalar (wcProdPr2 F' Y₁ Y₂) hW h₂ n c u,
    fun i j k hk u v => pullCup (wcProdPr1 F' Y₁ Y₂) hW h₁ i j k hk u v,
    fun i j k hk u v => pullCup (wcProdPr2 F' Y₁ Y₂) hW h₂ i j k hk u v, ?_,
    fun t₁ t₂ ht₁ ht₂ => wc_kunneth_top_nonvanishing F' Y₁ Y₂ d₁ d₂ ℓ hℓ h₁ h₂ hW t₁ t₂ ht₁ ht₂⟩
  intro i j k hk x y
  dsimp only
  rw [hFrW, frobMul, ← wc_modPull_frob, ← wc_modPull_frob, hT₁F, hT₂F]

theorem wc_kunneth_external_cup (F' : Type u) [Finite F'] [Field F'] (Y₁ Y₂ : Over (Spec (.of F')))
    [GeometricallyIrreducible Y₁.hom] [IsProper Y₁.hom] (d₁ : ℕ) [SmoothOfRelativeDimension d₁ Y₁.hom]
    [GeometricallyIrreducible Y₂.hom] [IsProper Y₂.hom] (d₂ : ℕ) [SmoothOfRelativeDimension d₂ Y₂.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F')
    (h₁ : WeaklyEtale (Limits.pullback.fst Y₁.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
    (h₂ : WeaklyEtale (Limits.pullback.fst Y₂.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
    (hW : WeaklyEtale (Limits.pullback.fst
          (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
    (a b n : ℕ) (hn : a + b = n) :
    ∃ M : wcCoh F' Y₁ h₁ ℓ a →+ wcCoh F' Y₂ h₂ ℓ b →+
        wcCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n,
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F' Y₁ h₁ ℓ a) (y : wcCoh F' Y₂ h₂ ℓ b),
        M (wcCohScalar F' Y₁ h₁ ℓ a c x) y =
          wcCohScalar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n c (M x y)) ∧
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F' Y₁ h₁ ℓ a) (y : wcCoh F' Y₂ h₂ ℓ b),
        M x (wcCohScalar F' Y₂ h₂ ℓ b c y) =
          wcCohScalar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n c (M x y)) ∧
      (∀ (x : wcCoh F' Y₁ h₁ ℓ a) (y : wcCoh F' Y₂ h₂ ℓ b),
        M (wcCohFrob F' Y₁ h₁ ℓ a x) (wcCohFrob F' Y₂ h₂ ℓ b y) =
          wcCohFrob F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n (M x y)) ∧
      ∀ (r₁ : ℕ) (e₁ : wcCoh F' Y₁ h₁ ℓ a ≃+ (Fin r₁ → ℚ_[ℓ])),
        (∀ (c : ℚ_[ℓ]) (x : wcCoh F' Y₁ h₁ ℓ a), e₁ (wcCohScalar F' Y₁ h₁ ℓ a c x) = c • e₁ x) →
      ∀ (r₂ : ℕ) (e₂ : wcCoh F' Y₂ h₂ ℓ b ≃+ (Fin r₂ → ℚ_[ℓ])),
        (∀ (c : ℚ_[ℓ]) (x : wcCoh F' Y₂ h₂ ℓ b), e₂ (wcCohScalar F' Y₂ h₂ ℓ b c x) = c • e₂ x) →
      ∀ c : Fin r₁ → Fin r₂ → ℚ_[ℓ],
        (∑ p, ∑ q, wcCohScalar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n
            (c p q) (M (e₁.symm (Pi.single p 1)) (e₂.symm (Pi.single q 1)))) = 0 →
        c = 0 :=
by

  have s6 : ∀ (X : Over (Spec (.of F'))) (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
      (i j k : ℕ) (hk : i + j = k) (c' : ℚ_[ℓ]) (x : wcModCoh F' X hX ℓ i) (y : wcModCoh F' X hX ℓ j),
      wcModCup F' X hX ℓ i j k hk (wcModScalar F' X hX ℓ i c' x) y =
          wcModScalar F' X hX ℓ k c' (wcModCup F' X hX ℓ i j k hk x y) ∧
      wcModCup F' X hX ℓ i j k hk x (wcModScalar F' X hX ℓ j c' y) =
          wcModScalar F' X hX ℓ k c' (wcModCup F' X hX ℓ i j k hk x y) := by
    intro X hX i j k hk c' x y
    letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F' X hX ℓ)) := HasExt.standard _
    have hcent : ∀ (τ : 𝟭 (SheafOfModules.{u+1} (wcSliceRing F' X hX ℓ)) ⟶ 𝟭 _)
        {A B : SheafOfModules.{u+1} (wcSliceRing F' X hX ℓ)} {m : ℕ} (α : Abelian.Ext A B m),
        (Abelian.Ext.mk₀ (τ.app A)).comp α (zero_add m) =
          α.comp (Abelian.Ext.mk₀ (τ.app B)) (add_zero m) := by
      intro τ A B m α
      let hmod : ∀ A' B' : SheafOfModules.{u+1} (wcSliceRing F' X hX ℓ),
          Module (CatCenter (SheafOfModules.{u+1} (wcSliceRing F' X hX ℓ))) (A' ⟶ B') := fun A' B' =>
        { one_smul := fun f => by rw [CatCenter.smul_eq]; exact Category.comp_id f
          mul_smul := fun a b f => by
            rw [CatCenter.smul_eq, CatCenter.smul_eq, CatCenter.smul_eq, CatCenter.mul_app,
              Category.assoc, CatCenter.naturality a (b.app B')]
          smul_zero := fun a => by rw [CatCenter.smul_eq, Limits.zero_comp]
          smul_add := fun a f g => by
            rw [CatCenter.smul_eq, CatCenter.smul_eq, CatCenter.smul_eq, Preadditive.add_comp]
          add_smul := fun a b f => by
            rw [CatCenter.smul_eq, CatCenter.smul_eq, CatCenter.smul_eq]
            exact Preadditive.comp_add _ _ _ _ _ _
          zero_smul := fun f => by
            rw [CatCenter.smul_eq]
            exact Limits.comp_zero }
      letI : Linear (CatCenter (SheafOfModules.{u+1} (wcSliceRing F' X hX ℓ)))
          (SheafOfModules.{u+1} (wcSliceRing F' X hX ℓ)) :=
        { homModule := hmod
          smul_comp := fun A' B' D r f g => by
            rw [CatCenter.smul_eq, CatCenter.smul_eq, Category.assoc, Category.assoc,
              CatCenter.naturality r g]
          comp_smul := fun A' B' D f r g => by
            rw [CatCenter.smul_eq, CatCenter.smul_eq, Category.assoc] }
      let z : CatCenter (SheafOfModules.{u+1} (wcSliceRing F' X hX ℓ)) := τ
      have h1 : τ.app A = z • 𝟙 A := by
        rw [CatCenter.smul_eq, Category.id_comp]
        try rfl
      have h2 : τ.app B = z • 𝟙 B := by
        rw [CatCenter.smul_eq, Category.id_comp]
        try rfl
      rw [h1, h2, Abelian.Ext.mk₀_smul, Abelian.Ext.mk₀_smul, Abelian.Ext.smul_comp,
        Abelian.Ext.comp_smul]
      exact congrArg (z • ·) ((Abelian.Ext.mk₀_id_comp α).trans (Abelian.Ext.comp_mk₀_id α).symm)
    have hconst : ∃ τ : 𝟭 (SheafOfModules.{u+1} (wcSliceRing F' X hX ℓ)) ⟶ 𝟭 _,
        τ.app (SheafOfModules.unit (wcSliceRing F' X hX ℓ)) = wcModConst F' X hX ℓ c' := by
      let cV : ∀ V, ↑((wcSliceRing F' X hX ℓ).obj.obj V) := fun V =>
        (ContinuousMap.const _ (ULift.up c') : C(↥((Opposite.unop V).left.left), ULift.{u+1} ℚ_[ℓ]))
      have hcomm : ∀ V (r : ↑((wcSliceRing F' X hX ℓ).obj.obj V)), cV V * r = r * cV V := by
        intro V r
        exact @mul_comm C(↥((Opposite.unop V).left.left), ULift.{u+1} ℚ_[ℓ]) _ (cV V) r
      have hres : ∀ ⦃V W⦄ (f : V ⟶ W), ((wcSliceRing F' X hX ℓ).obj.map f).hom (cV V) = cV W :=
        fun _ _ _ => rfl
      let τapp : ∀ M : SheafOfModules.{u+1} (wcSliceRing F' X hX ℓ), M ⟶ M := fun M =>
        ⟨PresheafOfModules.homMk
          { app := fun V => AddCommGrpCat.ofHom (DistribSMul.toAddMonoidHom (M.val.obj V) (cV V))
            naturality := fun V W f => by
              ext m
              have hm := M.val.map_smul f (cV V) m
              rw [hres f] at hm
              exact hm.symm }
          (fun V r m => by
            change cV V • (r • m) = r • (cV V • m)
            rw [smul_smul, smul_smul, hcomm])⟩
      refine ⟨{ app := τapp, naturality := ?_ }, ?_⟩
      · intro M N φ
        apply SheafOfModules.hom_ext
        apply PresheafOfModules.hom_ext
        intro V
        ext m
        change cV V • (φ.val.app V).hom m = (φ.val.app V).hom (cV V • m)
        exact ((φ.val.app V).hom.map_smul (cV V) m).symm
      · show τapp (SheafOfModules.unit (wcSliceRing F' X hX ℓ)) = wcModConst F' X hX ℓ c'
        rw [wcModConst, Equiv.eq_symm_apply]
        apply Subtype.ext
        funext V
        rw [SheafOfModules.unitHomEquiv_apply_coe]
        exact mul_one (cV V)
    have hU1 : ∀ {i' j' k' : ℕ} (hk' : i' + j' = k') (a' : wcModCoh F' X hX ℓ i')
        (b' : wcModCoh F' X hX ℓ j'), wcModCup F' X hX ℓ i' j' k' hk' a' b' = a'.comp b' hk' :=
      fun _ _ _ => rfl
    have hU2 : ∀ (n' : ℕ) (a' : wcModCoh F' X hX ℓ n'),
        wcModScalar F' X hX ℓ n' c' a' =
          a'.comp (Abelian.Ext.mk₀ (wcModConst F' X hX ℓ c')) (add_zero n') := fun _ _ => rfl
    obtain ⟨τ, hτ⟩ := hconst
    have hc := hcent τ y
    rw [hτ] at hc
    refine ⟨?_, ?_⟩
    · rw [hU1, hU1, hU2, hU2,
        Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ (wcModConst F' X hX ℓ c')) y (add_zero i)
          (zero_add j) (by omega),
        Abelian.Ext.comp_assoc x y (Abelian.Ext.mk₀ (wcModConst F' X hX ℓ c')) hk (add_zero j)
          (by omega), hc]
    · rw [hU1, hU1, hU2, hU2,
        Abelian.Ext.comp_assoc x y (Abelian.Ext.mk₀ (wcModConst F' X hX ℓ c')) hk (add_zero j)
          (by omega)]

  have G6 : ∀ (X : Over (Spec (.of F'))) (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
      (i : ℕ) (c' : ℚ_[ℓ]) (x : wcCoh F' X hX ℓ i),
      c' ≠ 0 → wcCohScalar F' X hX ℓ i c' x = 0 → x = 0 := by
    intro X hX i c' x hc' hx
    obtain ⟨h1, hmul, -⟩ := wc_ladic_scalar_ring X.left ℓ
    have key : wcCohScalar F' X hX ℓ i c'⁻¹ (wcCohScalar F' X hX ℓ i c' x) = x := by
      show (x.comp (Abelian.Ext.mk₀ (wcLadicScalar X.left ℓ c')) (add_zero i)).comp
          (Abelian.Ext.mk₀ (wcLadicScalar X.left ℓ c'⁻¹)) (add_zero i) = x
      rw [Abelian.Ext.comp_assoc x _ _ (add_zero i) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, ← hmul, inv_mul_cancel₀ hc', h1, Abelian.Ext.comp_mk₀_id]
    rw [← key, hx, map_zero]

  have dual : ∀ (X : Over (Spec (.of F'))) (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
      (i j : ℕ) {r : ℕ} (e : wcModCoh F' X hX ℓ j ≃+ (Fin r → ℚ_[ℓ]))
      (_he : ∀ (c' : ℚ_[ℓ]) (y : wcModCoh F' X hX ℓ j),
        e (wcModScalar F' X hX ℓ j c' y) = c' • e y)
      (B : wcModCoh F' X hX ℓ i →+ wcModCoh F' X hX ℓ j →+ ℚ_[ℓ])
      (_hBU : ∀ (c' : ℚ_[ℓ]) (x : wcModCoh F' X hX ℓ i) (y : wcModCoh F' X hX ℓ j),
        B (wcModScalar F' X hX ℓ i c' x) y = c' * B x y)
      (_hBV : ∀ (c' : ℚ_[ℓ]) (x : wcModCoh F' X hX ℓ i) (y : wcModCoh F' X hX ℓ j),
        B x (wcModScalar F' X hX ℓ j c' y) = c' * B x y)
      (_hnd : ∀ y : wcModCoh F' X hX ℓ j, (∀ x, B x y = 0) → y = 0),
      ∀ p : Fin r, ∃ x : wcModCoh F' X hX ℓ i,
        ∀ q : Fin r, B x (e.symm (Pi.single q 1)) = if q = p then 1 else 0 := by
    intro X hX i j r e he B hBU hBV hnd p
    have hsingle : ∀ q : Fin r, (fun j' => if q = j' then (1 : ℚ_[ℓ]) else 0) = Pi.single q 1 := by
      intro q
      funext j'
      by_cases hqj : q = j'
      · subst hqj
        simp
      · simp [Pi.single_apply, hqj, Ne.symm hqj]
    let S : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]) :=
      { carrier := Set.range (fun x : wcModCoh F' X hX ℓ i => fun q => B x (e.symm (Pi.single q 1)))
        add_mem' := by
          rintro _ _ ⟨x, rfl⟩ ⟨x', rfl⟩
          exact ⟨x + x', by funext q; simp only [map_add, AddMonoidHom.add_apply, Pi.add_apply]⟩
        zero_mem' := ⟨0, by funext q; simp only [map_zero, AddMonoidHom.zero_apply, Pi.zero_apply]⟩
        smul_mem' := by
          rintro c' _ ⟨x, rfl⟩
          exact ⟨wcModScalar F' X hX ℓ i c' x, by
            funext q; simp only [hBU, Pi.smul_apply, smul_eq_mul]⟩ }
    have hS : S = ⊤ := by
      by_contra hne
      obtain ⟨f, hf0, hfS⟩ := Submodule.exists_le_ker_of_lt_top S (lt_top_iff_ne_top.mpr hne)
      obtain ⟨w, hw⟩ : ∃ w : Fin r → ℚ_[ℓ], ∀ q, w q = f (Pi.single q 1) := ⟨_, fun _ => rfl⟩
      have hv : ∀ x : wcModCoh F' X hX ℓ i,
          B x (∑ q, wcModScalar F' X hX ℓ j (w q) (e.symm (Pi.single q 1))) = 0 := by
        intro x
        have hmem : (fun q => B x (e.symm (Pi.single q 1))) ∈ S := ⟨x, rfl⟩
        have h0 := hfS hmem
        rw [LinearMap.mem_ker, LinearMap.pi_apply_eq_sum_univ] at h0
        rw [map_sum]
        refine Eq.trans (Finset.sum_congr rfl (fun q _ => ?_)) h0
        rw [hBV, hsingle q, hw q, smul_eq_mul, mul_comm]
      have hv0 := hnd _ hv
      have hew : e (∑ q, wcModScalar F' X hX ℓ j (w q) (e.symm (Pi.single q 1))) = w := by
        rw [map_sum]
        simp only [he, AddEquiv.apply_symm_apply]
        funext q'
        simp [Finset.sum_apply, Pi.single_apply]
      rw [hv0, map_zero] at hew
      apply hf0
      apply LinearMap.ext
      intro x
      rw [LinearMap.pi_apply_eq_sum_univ, LinearMap.zero_apply]
      refine Finset.sum_eq_zero (fun q _ => ?_)
      rw [hsingle q, ← hw q, ← hew, Pi.zero_apply, smul_zero]
    have hmem : Pi.single p (1 : ℚ_[ℓ]) ∈ S := by
      rw [hS]
      exact Submodule.mem_top
    obtain ⟨x, hx⟩ := hmem
    refine ⟨x, fun q => ?_⟩
    have hxq := congrFun hx q
    dsimp only at hxq
    rw [hxq, Pi.single_apply]

  obtain ⟨T₁, T₂, TW, φ₁, φ₂, hT₁, hT₂, hTW, hφ₁s, hφ₂s, hφ₁m, hφ₂m, hFr, htop⟩ :=
    wc_kunneth_top_package F' Y₁ Y₂ d₁ d₂ ℓ hℓ h₁ h₂ hW
  have s6W := s6 (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW
  have assocW : ∀ {i j k ij jk ijk : ℕ} (h1 : i + j = ij) (h2 : j + k = jk) (h3 : ij + k = ijk)
      (h4 : i + jk = ijk)
      (x : wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ i)
      (y : wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ j)
      (z : wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ k),
      wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ ij k ijk h3
          (wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ i j ij h1 x y) z =
        wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ i jk ijk h4 x
          (wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ j k jk h2 y z) := by
    intro i j k ij jk ijk h1 h2 h3 h4 x y z
    letI : HasExt (SheafOfModules.{u+1}
      (wcSliceRing F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ)) :=
      HasExt.standard _
    exact Abelian.Ext.comp_assoc x y z h1 h2 (by omega)
  have hTWs : ∀ (k : ℕ) (c' : ℚ_[ℓ])
      (v : wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ k),
      (TW k).symm (wcModScalar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ k c' v) =
        wcCohScalar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ k c'
          ((TW k).symm v) := fun k c' v =>
    (TW k).injective (by rw [hTW, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  have hT₁s : ∀ (k : ℕ) (c' : ℚ_[ℓ]) (v : wcModCoh F' Y₁ h₁ ℓ k),
      (T₁ k).symm (wcModScalar F' Y₁ h₁ ℓ k c' v) = wcCohScalar F' Y₁ h₁ ℓ k c' ((T₁ k).symm v) :=
    fun k c' v => (T₁ k).injective (by rw [hT₁, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  have hT₂s : ∀ (k : ℕ) (c' : ℚ_[ℓ]) (v : wcModCoh F' Y₂ h₂ ℓ k),
      (T₂ k).symm (wcModScalar F' Y₂ h₂ ℓ k c' v) = wcCohScalar F' Y₂ h₂ ℓ k c' ((T₂ k).symm v) :=
    fun k c' v => (T₂ k).injective (by rw [hT₂, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])

  obtain ⟨M, hM⟩ : ∃ M : wcCoh F' Y₁ h₁ ℓ a →+ wcCoh F' Y₂ h₂ ℓ b →+
        wcCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n,
      ∀ x y, M x y = (TW n).symm (wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom))
        hW ℓ a b n hn (φ₁ a (T₁ a x)) (φ₂ b (T₂ b y))) :=
    ⟨(((wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ a b n hn).comp
        ((φ₁ a).comp (T₁ a).toAddMonoidHom)).compl₂ ((φ₂ b).comp (T₂ b).toAddMonoidHom)).compr₂
        (TW n).symm.toAddMonoidHom, fun _ _ => rfl⟩
  refine ⟨M, ?_, ?_, ?_, ?_⟩
  · intro c' x y
    rw [hM, hM, hT₁, hφ₁s, (s6W a b n hn c' _ _).1, hTWs]
  · intro c' x y
    rw [hM, hM, hT₂, hφ₂s, (s6W a b n hn c' _ _).2, hTWs]
  · intro x y
    rw [hM, hM]
    exact (hFr a b n hn x y).symm
  · intro r₁ e₁ he₁ r₂ e₂ he₂ c hc
    by_cases ha : 2 * d₁ < a
    · have hz := wc_coh_vanishing F' Y₁ d₁ ℓ hℓ h₁ a ha
      funext p
      exfalso
      have h1 : e₁ (e₁.symm (Pi.single p 1)) = Pi.single p 1 := AddEquiv.apply_symm_apply _ _
      rw [hz (e₁.symm (Pi.single p 1)), map_zero] at h1
      have h2 := congrFun h1 p
      simp at h2
    by_cases hb : 2 * d₂ < b
    · have hz := wc_coh_vanishing F' Y₂ d₂ ℓ hℓ h₂ b hb
      funext p q
      exfalso
      have h1 : e₂ (e₂.symm (Pi.single q 1)) = Pi.single q 1 := AddEquiv.apply_symm_apply _ _
      rw [hz (e₂.symm (Pi.single q 1)), map_zero] at h1
      have h2 := congrFun h1 q
      simp at h2
    push_neg at ha hb
    obtain ⟨A, hA, rfl⟩ : ∃ A, A ≤ 2 * d₁ ∧ a = 2 * d₁ - A := ⟨2 * d₁ - a, by omega, by omega⟩
    rcases Nat.eq_zero_or_pos r₁ with hr₁ | hr₁
    · subst hr₁
      funext p
      exact p.elim0
    rcases Nat.eq_zero_or_pos r₂ with hr₂ | hr₂
    · subst hr₂
      funext p q
      exact q.elim0
    obtain ⟨η₁, hη₁s, hη₁i⟩ := wc_top_coh_trace_injective F' Y₁ d₁ ℓ hℓ h₁
    obtain ⟨η₂, hη₂s, hη₂i⟩ := wc_top_coh_trace_injective F' Y₂ d₂ ℓ hℓ h₂
    obtain ⟨-, hpr₁⟩ := wc_modcup_perfect F' Y₁ d₁ ℓ hℓ h₁ A hA
    obtain ⟨hpl₂, -⟩ := wc_modcup_perfect F' Y₂ d₂ ℓ hℓ h₂ b hb

    obtain ⟨ε₁, hε₁⟩ : ∃ ε : wcModCoh F' Y₁ h₁ ℓ (2 * d₁) →+ ℚ_[ℓ],
        ∀ v, ε v = η₁ ((T₁ (2 * d₁)).symm v) := ⟨η₁.comp (T₁ (2 * d₁)).symm.toAddMonoidHom, fun _ => rfl⟩
    obtain ⟨ε₂, hε₂⟩ : ∃ ε : wcModCoh F' Y₂ h₂ ℓ (2 * d₂) →+ ℚ_[ℓ],
        ∀ v, ε v = η₂ ((T₂ (2 * d₂)).symm v) := ⟨η₂.comp (T₂ (2 * d₂)).symm.toAddMonoidHom, fun _ => rfl⟩
    have hε₁s : ∀ (c' : ℚ_[ℓ]) v, ε₁ (wcModScalar F' Y₁ h₁ ℓ (2 * d₁) c' v) = c' * ε₁ v := by
      intro c' v
      rw [hε₁, hε₁, hT₁s, hη₁s]
    have hε₂s : ∀ (c' : ℚ_[ℓ]) v, ε₂ (wcModScalar F' Y₂ h₂ ℓ (2 * d₂) c' v) = c' * ε₂ v := by
      intro c' v
      rw [hε₂, hε₂, hT₂s, hη₂s]
    have hε₁i : Function.Injective ε₁ := by
      intro v w hvw
      rw [hε₁, hε₁] at hvw
      exact (T₁ _).symm.injective (hη₁i hvw)
    have hε₂i : Function.Injective ε₂ := by
      intro v w hvw
      rw [hε₂, hε₂] at hvw
      exact (T₂ _).symm.injective (hη₂i hvw)

    obtain ⟨B₁, hB₁⟩ : ∃ B : wcModCoh F' Y₁ h₁ ℓ A →+ wcModCoh F' Y₁ h₁ ℓ (2 * d₁ - A) →+ ℚ_[ℓ],
        ∀ x y, B x y = ε₁ (wcModCup F' Y₁ h₁ ℓ A (2 * d₁ - A) (2 * d₁) (Nat.add_sub_cancel' hA) x y) :=
      ⟨(wcModCup F' Y₁ h₁ ℓ A (2 * d₁ - A) (2 * d₁) (Nat.add_sub_cancel' hA)).compr₂ ε₁,
        fun _ _ => rfl⟩
    have hdual₁ := dual Y₁ h₁ A (2 * d₁ - A) ((T₁ (2 * d₁ - A)).symm.trans e₁)
      (fun c' v => by rw [AddEquiv.trans_apply, AddEquiv.trans_apply, hT₁s, he₁]) B₁
      (fun c' x y => by
        rw [hB₁, hB₁, (s6 Y₁ h₁ A (2 * d₁ - A) (2 * d₁) (Nat.add_sub_cancel' hA) c' x y).1, hε₁s])
      (fun c' x y => by
        rw [hB₁, hB₁, (s6 Y₁ h₁ A (2 * d₁ - A) (2 * d₁) (Nat.add_sub_cancel' hA) c' x y).2, hε₁s])
      (fun y hy => hpr₁ y (fun x => hε₁i (by rw [map_zero, ← hB₁]; exact hy x)))
    choose β' hβ' using hdual₁
    have hβ'' : ∀ r p : Fin r₁, ε₁ (wcModCup F' Y₁ h₁ ℓ A (2 * d₁ - A) (2 * d₁)
        (Nat.add_sub_cancel' hA) (β' r) (T₁ (2 * d₁ - A) (e₁.symm (Pi.single p 1)))) =
          if p = r then 1 else 0 := by
      intro r p
      have := hβ' r p
      rwa [hB₁, AddEquiv.symm_trans_apply, AddEquiv.symm_symm] at this
    obtain ⟨t₁, ht₁⟩ : ∃ t, t = wcModCup F' Y₁ h₁ ℓ A (2 * d₁ - A) (2 * d₁) (Nat.add_sub_cancel' hA)
        (β' ⟨0, hr₁⟩) (T₁ (2 * d₁ - A) (e₁.symm (Pi.single ⟨0, hr₁⟩ 1))) := ⟨_, rfl⟩
    have hεt₁ : ε₁ t₁ = 1 := by rw [ht₁, hβ'' ⟨0, hr₁⟩ ⟨0, hr₁⟩, if_pos rfl]
    have ht₁0 : t₁ ≠ 0 := fun h0 => by
      rw [h0, map_zero] at hεt₁
      exact zero_ne_one hεt₁
    have hβ : ∀ r p : Fin r₁, wcModCup F' Y₁ h₁ ℓ A (2 * d₁ - A) (2 * d₁)
        (Nat.add_sub_cancel' hA) (β' r) (T₁ (2 * d₁ - A) (e₁.symm (Pi.single p 1))) =
          if p = r then t₁ else 0 := by
      intro r p
      apply hε₁i
      rw [hβ'' r p]
      split_ifs
      · rw [hεt₁]
      · rw [map_zero]

    obtain ⟨B₂, hB₂⟩ : ∃ B : wcModCoh F' Y₂ h₂ ℓ (2 * d₂ - b) →+ wcModCoh F' Y₂ h₂ ℓ b →+ ℚ_[ℓ],
        ∀ x y, B x y = ε₂ (wcModCup F' Y₂ h₂ ℓ b (2 * d₂ - b) (2 * d₂) (Nat.add_sub_cancel' hb) y x) :=
      ⟨((wcModCup F' Y₂ h₂ ℓ b (2 * d₂ - b) (2 * d₂) (Nat.add_sub_cancel' hb)).compr₂ ε₂).flip,
        fun _ _ => rfl⟩
    have hdual₂ := dual Y₂ h₂ (2 * d₂ - b) b ((T₂ b).symm.trans e₂)
      (fun c' v => by rw [AddEquiv.trans_apply, AddEquiv.trans_apply, hT₂s, he₂]) B₂
      (fun c' x y => by
        rw [hB₂, hB₂, (s6 Y₂ h₂ b (2 * d₂ - b) (2 * d₂) (Nat.add_sub_cancel' hb) c' y x).2, hε₂s])
      (fun c' x y => by
        rw [hB₂, hB₂, (s6 Y₂ h₂ b (2 * d₂ - b) (2 * d₂) (Nat.add_sub_cancel' hb) c' y x).1, hε₂s])
      (fun y hy => hpl₂ y (fun x => hε₂i (by rw [map_zero, ← hB₂]; exact hy x)))
    choose γ' hγ' using hdual₂
    have hγ'' : ∀ (s q : Fin r₂), ε₂ (wcModCup F' Y₂ h₂ ℓ b (2 * d₂ - b) (2 * d₂)
        (Nat.add_sub_cancel' hb) (T₂ b (e₂.symm (Pi.single q 1))) (γ' s)) =
          if q = s then 1 else 0 := by
      intro s q
      have := hγ' s q
      rwa [hB₂, AddEquiv.symm_trans_apply, AddEquiv.symm_symm] at this
    obtain ⟨t₂, ht₂⟩ : ∃ t, t = wcModCup F' Y₂ h₂ ℓ b (2 * d₂ - b) (2 * d₂) (Nat.add_sub_cancel' hb)
        (T₂ b (e₂.symm (Pi.single ⟨0, hr₂⟩ 1))) (γ' ⟨0, hr₂⟩) := ⟨_, rfl⟩
    have hεt₂ : ε₂ t₂ = 1 := by rw [ht₂, hγ'' ⟨0, hr₂⟩ ⟨0, hr₂⟩, if_pos rfl]
    have ht₂0 : t₂ ≠ 0 := fun h0 => by
      rw [h0, map_zero] at hεt₂
      exact zero_ne_one hεt₂
    have hγ : ∀ (q s : Fin r₂), wcModCup F' Y₂ h₂ ℓ b (2 * d₂ - b) (2 * d₂)
        (Nat.add_sub_cancel' hb) (T₂ b (e₂.symm (Pi.single q 1))) (γ' s) =
          if q = s then t₂ else 0 := by
      intro q s
      apply hε₂i
      rw [hγ'' s q]
      split_ifs
      · rw [hεt₂]
      · rw [map_zero]

    have hc' : ∑ p, ∑ q, wcModScalar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n
        (c p q) (wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
          (2 * d₁ - A) b n hn (φ₁ (2 * d₁ - A) (T₁ (2 * d₁ - A) (e₁.symm (Pi.single p 1))))
          (φ₂ b (T₂ b (e₂.symm (Pi.single q 1))))) = 0 := by
      have := congrArg (TW n) hc
      rw [map_zero, map_sum] at this
      simpa only [map_sum, hTW, hM, AddEquiv.apply_symm_apply] using this

    have hN : A + n + (2 * d₂ - b) = 2 * d₁ + 2 * d₂ := by omega
    funext r s
    show c r s = 0
    obtain ⟨L, hL⟩ : ∃ L : wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ n →+
        wcModCoh F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ (2 * d₁ + 2 * d₂),
        ∀ R, L R = wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
          (A + n) (2 * d₂ - b) (2 * d₁ + 2 * d₂) hN
          (wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ A n (A + n) rfl
            (φ₁ A (β' r)) R) (φ₂ (2 * d₂ - b) (γ' s)) :=
      ⟨((wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
          (A + n) (2 * d₂ - b) (2 * d₁ + 2 * d₂) hN).flip (φ₂ (2 * d₂ - b) (γ' s))).comp
        (wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ A n (A + n) rfl
          (φ₁ A (β' r))), fun _ => rfl⟩
    have hLs : ∀ (c' : ℚ_[ℓ]) R, L (wcModScalar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫
        Y₁.hom)) hW ℓ n c' R) = wcModScalar F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫
          Y₁.hom)) hW ℓ (2 * d₁ + 2 * d₂) c' (L R) := by
      intro c' R
      rw [hL, hL, (s6W A n (A + n) rfl c' _ R).2, (s6W (A + n) (2 * d₂ - b) _ hN c' _ _).1]
    have hterm : ∀ (p : Fin r₁) (q : Fin r₂),
        L (wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW ℓ
          (2 * d₁ - A) b n hn (φ₁ (2 * d₁ - A) (T₁ (2 * d₁ - A) (e₁.symm (Pi.single p 1))))
          (φ₂ b (T₂ b (e₂.symm (Pi.single q 1))))) =
        if p = r then (if q = s then wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫
          Y₁.hom)) hW ℓ (2 * d₁) (2 * d₂) (2 * d₁ + 2 * d₂) rfl (φ₁ (2 * d₁) t₁) (φ₂ (2 * d₂) t₂)
          else 0) else 0 := by
      intro p q
      rw [hL, ← assocW (Nat.add_sub_cancel' hA) hn (show 2 * d₁ + b = A + n by omega) rfl,
        assocW (show 2 * d₁ + b = A + n by omega) (Nat.add_sub_cancel' hb) hN
          (show 2 * d₁ + 2 * d₂ = 2 * d₁ + 2 * d₂ from rfl),
        ← hφ₁m A (2 * d₁ - A) (2 * d₁) (Nat.add_sub_cancel' hA) (β' r)
          (T₁ (2 * d₁ - A) (e₁.symm (Pi.single p 1))),
        ← hφ₂m b (2 * d₂ - b) (2 * d₂) (Nat.add_sub_cancel' hb) (T₂ b (e₂.symm (Pi.single q 1)))
          (γ' s), hβ r p, hγ q s]
      split_ifs <;> first | rfl | simp only [map_zero, AddMonoidHom.zero_apply]
    have hsum := congrArg L hc'
    rw [map_sum, map_zero] at hsum
    simp only [map_sum, hLs, hterm] at hsum
    rw [Finset.sum_eq_single r (fun p _ hp => by simp [hp]) (fun hr => absurd (Finset.mem_univ r) hr),
      Finset.sum_eq_single s (fun q _ hq => by simp [hq]) (fun hs => absurd (Finset.mem_univ s) hs),
      if_pos rfl, if_pos rfl] at hsum
    by_contra hne
    have hz : (TW (2 * d₁ + 2 * d₂)).symm (wcModCup F' (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫
        Y₁.hom)) hW ℓ (2 * d₁) (2 * d₂) (2 * d₁ + 2 * d₂) rfl (φ₁ (2 * d₁) t₁) (φ₂ (2 * d₂) t₂)) = 0 :=
      G6 (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) hW (2 * d₁ + 2 * d₂) (c r s) _ hne
        (by rw [← hTWs, hsum, map_zero])
    exact htop t₁ t₂ ht₁0 ht₂0 ((AddEquiv.map_eq_zero_iff _).mp hz)

theorem wc_kunneth_power_eigen (F' : Type u) [Finite F'] [Field F'] (Y : Over (Spec (.of F')))
    [GeometricallyIrreducible Y.hom] [IsProper Y.hom] (d : ℕ) [SmoothOfRelativeDimension d Y.hom]
    (N : ℕ) (j : Y.left ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
      MvPolynomial.gradedAlgebra)
    (hj : IsClosedImmersion j)
    (hjY : j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))) = Y.hom)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F')
    (h : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
    (k : ℕ) (hk : 1 ≤ k) :
    ∃ (W : Over (Spec (.of F'))) (_ : GeometricallyIrreducible W.hom) (_ : IsProper W.hom)
      (_ : SmoothOfRelativeDimension (k * d) W.hom) (N' : ℕ)
      (jW : W.left ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F')
        MvPolynomial.gradedAlgebra),
      IsClosedImmersion jW ∧
      jW ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F')
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F' 0))) = W.hom ∧
      ∀ (hW : WeaklyEtale (Limits.pullback.fst W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))),
      ∀ (r : ℕ) (e : wcCoh F' Y h ℓ d ≃+ (Fin r → ℚ_[ℓ])),
        (∀ (c : ℚ_[ℓ]) (x : wcCoh F' Y h ℓ d), e (wcCohScalar F' Y h ℓ d c x) = c • e x) →
      ∀ (rW : ℕ) (eW : wcCoh F' W hW ℓ (k * d) ≃+ (Fin rW → ℚ_[ℓ])),
        (∀ (c : ℚ_[ℓ]) (x : wcCoh F' W hW ℓ (k * d)),
          eW (wcCohScalar F' W hW ℓ (k * d) c x) = c • eW x) →
      ∀ μ ∈ (wcAddEquivMatrix e (wcCohFrob F' Y h ℓ d)).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
        μ ^ k ∈ (wcAddEquivMatrix eW (wcCohFrob F' W hW ℓ (k * d))).charpoly.aroots
          (AlgebraicClosure ℚ_[ℓ]) :=
by
  classical

  have s9 : ∀ (F₀ : Type u) [Field F₀] [Finite F₀] (X₀ : Over (Spec (.of F₀)))
      (h₀ : WeaklyEtale (Limits.pullback.fst X₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F₀ (AlgebraicClosure F₀))))))
      (i : ℕ) (c : ℚ_[ℓ]) (x : wcCoh F₀ X₀ h₀ ℓ i),
      wcCohFrob F₀ X₀ h₀ ℓ i (wcCohScalar F₀ X₀ h₀ ℓ i c x) =
        wcCohScalar F₀ X₀ h₀ ℓ i c (wcCohFrob F₀ X₀ h₀ ℓ i x) := by
    intro F₀ _ _ X₀ h₀ i c x
    show (Abelian.Ext.mk₀ (wcFreeSheafMap X₀.left (wcGeomFrob F₀ X₀ h₀))).comp
        (x.comp (Abelian.Ext.mk₀ (wcLadicScalar X₀.left ℓ c)) (add_zero i)) (zero_add i) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap X₀.left (wcGeomFrob F₀ X₀ h₀))).comp x (zero_add i)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar X₀.left ℓ c)) (add_zero i)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add i) (add_zero i) (by omega)).symm

  have s4 : ∀ {ι κ : Type} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]
      (A : Matrix ι ι ℚ_[ℓ]) (B : Matrix κ κ ℚ_[ℓ]) (P : Matrix κ ι ℚ_[ℓ]),
      (∀ v : ι → ℚ_[ℓ], P.mulVec v = 0 → v = 0) → P * A = B * P →
      ∀ μ ∈ A.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
        μ ∈ B.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    intro ι κ _ _ _ _ A B P hP hPA μ hμ
    set f : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ] := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hf
    have hker : LinearMap.ker (Matrix.toLin' P) = ⊥ := by
      rw [LinearMap.ker_eq_bot']
      intro v hv
      exact hP v (by rwa [Matrix.toLin'_apply] at hv)
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective _ hker
    have hQP : LinearMap.toMatrix' g * P = 1 := by
      have := congrArg LinearMap.toMatrix' hg
      rwa [LinearMap.toMatrix'_comp, LinearMap.toMatrix'_toLin', LinearMap.toMatrix'_id] at this
    have hQPL : (LinearMap.toMatrix' g).map f * P.map f = 1 := by
      rw [← Matrix.map_mul, hQP, Matrix.map_one _ (map_zero f) (map_one f)]
    have hPAL : P.map f * A.map f = B.map f * P.map f := by
      rw [← Matrix.map_mul, ← Matrix.map_mul, hPA]
    rw [Polynomial.mem_aroots] at hμ
    obtain ⟨_, hμ⟩ := hμ
    have hdet : (Matrix.scalar ι μ - A.map f).det = 0 := by
      rw [← Matrix.eval_charpoly, Matrix.charpoly_map, Polynomial.eval_map, ← Polynomial.aeval_def]
      exact hμ
    obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hAv : (A.map f).mulVec v = μ • v := by
      rw [Matrix.sub_mulVec, sub_eq_zero] at hv
      rw [← hv, Matrix.scalar_apply]
      ext x
      simp [Matrix.mulVec_diagonal]
    have hw0 : (P.map f).mulVec v ≠ 0 := by
      intro hw
      apply hv0
      have e1 : ((LinearMap.toMatrix' g).map f).mulVec ((P.map f).mulVec v) = v := by
        rw [Matrix.mulVec_mulVec, hQPL, Matrix.one_mulVec]
      rw [← e1, hw, Matrix.mulVec_zero]
    have hBw : (B.map f).mulVec ((P.map f).mulVec v) = μ • (P.map f).mulVec v := by
      rw [Matrix.mulVec_mulVec, ← hPAL, ← Matrix.mulVec_mulVec, hAv, Matrix.mulVec_smul]
    have hdet' : (Matrix.scalar κ μ - B.map f).det = 0 := by
      apply Matrix.exists_mulVec_eq_zero_iff.mp
      refine ⟨(P.map f).mulVec v, hw0, ?_⟩
      rw [Matrix.sub_mulVec, hBw, Matrix.scalar_apply, sub_eq_zero]
      ext x
      simp [Matrix.mulVec_diagonal]
    rw [Polynomial.mem_aroots]
    refine ⟨(Matrix.charpoly_monic B).ne_zero, ?_⟩
    rw [Polynomial.aeval_def, ← Polynomial.eval_map, ← Matrix.charpoly_map, Matrix.eval_charpoly]
    exact hdet'

  have s3 : ∀ {r₁ r₂ : ℕ} (A₁ : Matrix (Fin r₁) (Fin r₁) ℚ_[ℓ])
      (A₂ : Matrix (Fin r₂) (Fin r₂) ℚ_[ℓ]),
      ∀ μ ∈ A₁.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
      ∀ ν ∈ A₂.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
        μ * ν ∈ (Matrix.kroneckerMap (· * ·) A₁ A₂).charpoly.aroots
          (AlgebraicClosure ℚ_[ℓ]) := by
    intro r₁ r₂ A₁ A₂ μ hμ ν hν
    set f : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ] := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hf
    have eig : ∀ {m : ℕ} (A : Matrix (Fin m) (Fin m) ℚ_[ℓ]) (μ : AlgebraicClosure ℚ_[ℓ]),
        μ ∈ A.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) →
        ∃ v : Fin m → AlgebraicClosure ℚ_[ℓ], v ≠ 0 ∧ (A.map f).mulVec v = μ • v := by
      intro m A μ hμ
      rw [Polynomial.mem_aroots] at hμ
      obtain ⟨_, hμ⟩ := hμ
      have hdet : (Matrix.scalar (Fin m) μ - A.map f).det = 0 := by
        rw [← Matrix.eval_charpoly, Matrix.charpoly_map, Polynomial.eval_map,
          ← Polynomial.aeval_def]
        exact hμ
      obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
      refine ⟨v, hv0, ?_⟩
      rw [Matrix.sub_mulVec, sub_eq_zero] at hv
      rw [← hv, Matrix.scalar_apply]
      ext x
      simp [Matrix.mulVec_diagonal]
    obtain ⟨v, hv0, hv⟩ := eig A₁ μ hμ
    obtain ⟨w, hw0, hw⟩ := eig A₂ ν hν
    obtain ⟨u, hu⟩ : ∃ u : Fin r₁ × Fin r₂ → AlgebraicClosure ℚ_[ℓ],
        ∀ pq, u pq = v pq.1 * w pq.2 := ⟨fun pq => v pq.1 * w pq.2, fun _ => rfl⟩
    have hmap : (Matrix.kroneckerMap (· * ·) A₁ A₂).map f =
        Matrix.kroneckerMap (· * ·) (A₁.map f) (A₂.map f) := by
      ext a b
      simp [Matrix.kroneckerMap_apply, map_mul]
    have hKu : (Matrix.kroneckerMap (· * ·) (A₁.map f) (A₂.map f)).mulVec u = (μ * ν) • u := by
      ext ⟨p, q⟩
      have e1 := congrFun hv p
      have e2 := congrFun hw q
      simp only [Matrix.mulVec, dotProduct, Pi.smul_apply, smul_eq_mul] at e1 e2 ⊢
      rw [Fintype.sum_prod_type]
      simp only [Matrix.kroneckerMap_apply, hu]
      calc ∑ x, ∑ y, A₁.map f p x * A₂.map f q y * (v x * w y)
          = (∑ x, A₁.map f p x * v x) * (∑ y, A₂.map f q y * w y) := by
            rw [Finset.sum_mul_sum]
            exact Finset.sum_congr rfl (fun x _ => Finset.sum_congr rfl (fun y _ => by ring))
        _ = μ * ν * (v p * w q) := by rw [e1, e2]; ring
    have hu0 : u ≠ 0 := by
      obtain ⟨p, hp⟩ := Function.ne_iff.mp hv0
      obtain ⟨q, hq⟩ := Function.ne_iff.mp hw0
      intro h0
      have h1 := congrFun h0 (p, q)
      rw [hu] at h1
      exact mul_ne_zero hp hq h1
    have hdet' : (Matrix.scalar (Fin r₁ × Fin r₂) (μ * ν) -
        (Matrix.kroneckerMap (· * ·) A₁ A₂).map f).det = 0 := by
      apply Matrix.exists_mulVec_eq_zero_iff.mp
      refine ⟨u, hu0, ?_⟩
      rw [hmap, Matrix.sub_mulVec, hKu, Matrix.scalar_apply, sub_eq_zero]
      ext x
      simp [Matrix.mulVec_diagonal]
    rw [Polynomial.mem_aroots]
    refine ⟨(Matrix.charpoly_monic _).ne_zero, ?_⟩
    rw [Polynomial.aeval_def, ← Polynomial.eval_map, ← Matrix.charpoly_map, Matrix.eval_charpoly]
    exact hdet'

  have s2 : ∀ {V₁ V₂ V : Type (u+1)} [AddCommGroup V₁] [AddCommGroup V₂] [AddCommGroup V]
      {r₁ r₂ r : ℕ}
      (e₁ : V₁ ≃+ (Fin r₁ → ℚ_[ℓ])) (e₂ : V₂ ≃+ (Fin r₂ → ℚ_[ℓ])) (e : V ≃+ (Fin r → ℚ_[ℓ]))
      (s₁ : ℚ_[ℓ] → V₁ →+ V₁) (s₂ : ℚ_[ℓ] → V₂ →+ V₂) (s : ℚ_[ℓ] → V →+ V)
      (he₁ : ∀ (c : ℚ_[ℓ]) (x : V₁), e₁ (s₁ c x) = c • e₁ x)
      (he₂ : ∀ (c : ℚ_[ℓ]) (x : V₂), e₂ (s₂ c x) = c • e₂ x)
      (he : ∀ (c : ℚ_[ℓ]) (x : V), e (s c x) = c • e x)
      (Φ₁ : V₁ →+ V₁) (Φ₂ : V₂ →+ V₂) (Φ : V →+ V)
      (hΦ : ∀ (c : ℚ_[ℓ]) (x : V), Φ (s c x) = s c (Φ x))
      (M : V₁ →+ V₂ →+ V)
      (hM₁ : ∀ (c : ℚ_[ℓ]) (x : V₁) (y : V₂), M (s₁ c x) y = s c (M x y))
      (hM₂ : ∀ (c : ℚ_[ℓ]) (x : V₁) (y : V₂), M x (s₂ c y) = s c (M x y))
      (hMΦ : ∀ (x : V₁) (y : V₂), M (Φ₁ x) (Φ₂ y) = Φ (M x y))
      (hind : ∀ c : Fin r₁ → Fin r₂ → ℚ_[ℓ],
        (∑ p, ∑ q, s (c p q) (M (e₁.symm (Pi.single p 1)) (e₂.symm (Pi.single q 1)))) = 0 →
          c = 0),
      ∃ P : Matrix (Fin r) (Fin r₁ × Fin r₂) ℚ_[ℓ],
        (∀ v : Fin r₁ × Fin r₂ → ℚ_[ℓ], P.mulVec v = 0 → v = 0) ∧
        P * Matrix.kroneckerMap (· * ·) (wcAddEquivMatrix e₁ Φ₁) (wcAddEquivMatrix e₂ Φ₂) =
          wcAddEquivMatrix e Φ * P := by
    intro V₁ V₂ V _ _ _ r₁ r₂ r e₁ e₂ e s₁ s₂ s he₁ he₂ he Φ₁ Φ₂ Φ hΦ M hM₁ hM₂ hMΦ hind
    have expand : ∀ {W : Type (u+1)} [AddCommGroup W] {m : ℕ} (E : W ≃+ (Fin m → ℚ_[ℓ]))
        (S : ℚ_[ℓ] → W →+ W), (∀ (c : ℚ_[ℓ]) (x : W), E (S c x) = c • E x) →
        ∀ v : Fin m → ℚ_[ℓ], E.symm v = ∑ t, S (v t) (E.symm (Pi.single t 1)) := by
      intro W _ m E S hE v
      apply E.injective
      rw [AddEquiv.apply_symm_apply, map_sum]
      simp only [hE, AddEquiv.apply_symm_apply]
      ext i
      simp [Finset.sum_apply, Pi.single_apply]
    have hcol : ∀ {W : Type (u+1)} [AddCommGroup W] {m : ℕ} (E : W ≃+ (Fin m → ℚ_[ℓ]))
        (S : ℚ_[ℓ] → W →+ W), (∀ (c : ℚ_[ℓ]) (x : W), E (S c x) = c • E x) →
        ∀ (Ψ : W →+ W) (p : Fin m), Ψ (E.symm (Pi.single p 1)) =
          ∑ p', S (wcAddEquivMatrix E Ψ p' p) (E.symm (Pi.single p' 1)) := by
      intro W _ m E S hE Ψ p
      apply E.injective
      rw [map_sum]
      simp only [hE, AddEquiv.apply_symm_apply]
      ext i
      simp [Finset.sum_apply, Pi.single_apply, wcAddEquivMatrix]
    have hBmul : ∀ w : Fin r → ℚ_[ℓ], (wcAddEquivMatrix e Φ).mulVec w = e (Φ (e.symm w)) := by
      intro w
      rw [expand e s he w, map_sum, map_sum]
      simp only [hΦ, he]
      ext i
      simp only [Matrix.mulVec, dotProduct, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
        wcAddEquivMatrix, Matrix.of_apply]
      exact Finset.sum_congr rfl (fun t _ => mul_comm _ _)
    obtain ⟨P, hP⟩ : ∃ P : Matrix (Fin r) (Fin r₁ × Fin r₂) ℚ_[ℓ], ∀ t pq,
        P t pq = e (M (e₁.symm (Pi.single pq.1 1)) (e₂.symm (Pi.single pq.2 1))) t :=
      ⟨Matrix.of fun t pq => e (M (e₁.symm (Pi.single pq.1 1)) (e₂.symm (Pi.single pq.2 1))) t,
        fun _ _ => rfl⟩
    refine ⟨P, ?_, ?_⟩
    · intro v hv
      have key : e (∑ p, ∑ q, s (v (p, q))
          (M (e₁.symm (Pi.single p 1)) (e₂.symm (Pi.single q 1)))) = 0 := by
        rw [← hv]
        ext i
        simp only [map_sum, he, Matrix.mulVec, dotProduct, hP, Finset.sum_apply, Pi.smul_apply,
          smul_eq_mul, Fintype.sum_prod_type]
        exact Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => mul_comm _ _))
      have h0 := hind (fun p q => v (p, q)) (e.injective (key.trans (map_zero e).symm))
      funext pq
      exact congrFun (congrFun h0 pq.1) pq.2
    · ext i ⟨p, q⟩
      have hR : (wcAddEquivMatrix e Φ * P) i (p, q) =
          e (Φ (M (e₁.symm (Pi.single p 1)) (e₂.symm (Pi.single q 1)))) i := by
        have h1 := congrFun (hBmul (e (M (e₁.symm (Pi.single p 1)) (e₂.symm (Pi.single q 1))))) i
        rw [AddEquiv.symm_apply_apply] at h1
        rw [← h1, Matrix.mul_apply]
        simp only [Matrix.mulVec, dotProduct, hP]
      rw [hR, ← hMΦ, hcol e₁ s₁ he₁ Φ₁ p, hcol e₂ s₂ he₂ Φ₂ q, Matrix.mul_apply,
        Fintype.sum_prod_type]
      simp only [map_sum, AddMonoidHom.finsetSum_apply, hM₁, hM₂, he, Finset.sum_apply,
        Pi.smul_apply, smul_eq_mul, hP, Matrix.kroneckerMap_apply]
      rw [Finset.sum_comm (s := (Finset.univ : Finset (Fin r₂))) (t := (Finset.univ : Finset (Fin r₁)))]
      refine Finset.sum_congr rfl ?_
      intro p' _
      refine Finset.sum_congr rfl ?_
      intro q' _
      ring

  have s5 : ∀ {V V' : Type (u+1)} [AddCommGroup V] [AddCommGroup V'] {r r' : ℕ}
      (e : V ≃+ (Fin r → ℚ_[ℓ])) (e' : V' ≃+ (Fin r' → ℚ_[ℓ]))
      (s : ℚ_[ℓ] → V →+ V) (s' : ℚ_[ℓ] → V' →+ V')
      (he : ∀ (c : ℚ_[ℓ]) (x : V), e (s c x) = c • e x)
      (he' : ∀ (c : ℚ_[ℓ]) (x : V'), e' (s' c x) = c • e' x)
      (Φ : V →+ V) (Φ' : V' →+ V')
      (hΦ : ∀ (c : ℚ_[ℓ]) (x : V), Φ (s c x) = s c (Φ x))
      (hΦ' : ∀ (c : ℚ_[ℓ]) (x : V'), Φ' (s' c x) = s' c (Φ' x))
      (ψ : V →+ V') (hψ : Function.Injective ψ)
      (hψs : ∀ (c : ℚ_[ℓ]) (x : V), ψ (s c x) = s' c (ψ x))
      (m : ℕ) (hψΦ : ∀ x : V, ψ ((⇑Φ)^[m] x) = Φ' (ψ x)),
      ∃ P : Matrix (Fin r') (Fin r) ℚ_[ℓ], (∀ v : Fin r → ℚ_[ℓ], P.mulVec v = 0 → v = 0) ∧
        P * (wcAddEquivMatrix e Φ) ^ m = wcAddEquivMatrix e' Φ' * P := by
    intro V V' _ _ r r' e e' s s' he he' Φ Φ' hΦ hΦ' ψ hψ hψs m hψΦ
    have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), e.symm (c • v) = s c (e.symm v) := fun c v =>
      e.injective (by rw [he, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    have hes' : ∀ (c : ℚ_[ℓ]) (v : Fin r' → ℚ_[ℓ]), e'.symm (c • v) = s' c (e'.symm v) :=
      fun c v => e'.injective (by rw [he', AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    let LA : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) :=
      { toFun := fun v => e (Φ (e.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes, hΦ, he, RingHom.id_apply] }
    let LB : (Fin r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) :=
      { toFun := fun v => e' (Φ' (e'.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes', hΦ', he', RingHom.id_apply] }
    let LP : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) :=
      { toFun := fun v => e' (ψ (e.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes, hψs, he', RingHom.id_apply] }
    have hA : wcAddEquivMatrix e Φ = LinearMap.toMatrix' LA := by
      ext a b
      rw [LinearMap.toMatrix'_apply]
      rfl
    have hB : wcAddEquivMatrix e' Φ' = LinearMap.toMatrix' LB := by
      ext a b
      rw [LinearMap.toMatrix'_apply]
      rfl
    have hAk : ∀ (k : ℕ) (v : Fin r → ℚ_[ℓ]),
        ((wcAddEquivMatrix e Φ) ^ k).mulVec v = e ((⇑Φ)^[k] (e.symm v)) := by
      intro k
      induction k with
      | zero => intro v; simp
      | succ k ih =>
        intro v
        rw [pow_succ', ← Matrix.mulVec_mulVec, ih, hA, LinearMap.toMatrix'_mulVec]
        show e (Φ (e.symm (e ((⇑Φ)^[k] (e.symm v))))) = _
        rw [AddEquiv.symm_apply_apply, Function.iterate_succ_apply']
    refine ⟨LinearMap.toMatrix' LP, ?_, ?_⟩
    · intro v hv
      rw [LinearMap.toMatrix'_mulVec] at hv
      change e' (ψ (e.symm v)) = 0 at hv
      have h1 : ψ (e.symm v) = 0 := e'.injective (hv.trans (map_zero e').symm)
      have h2 : e.symm v = 0 := hψ (h1.trans (map_zero ψ).symm)
      rw [← AddEquiv.apply_symm_apply e v, h2, map_zero]
    · apply Matrix.toLin'.injective
      apply LinearMap.ext
      intro v
      rw [Matrix.toLin'_apply, Matrix.toLin'_apply, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
        hAk, hB, LinearMap.toMatrix'_mulVec, LinearMap.toMatrix'_mulVec, LinearMap.toMatrix'_mulVec]
      show e' (ψ (e.symm (e ((⇑Φ)^[m] (e.symm v))))) = e' (Φ' (e'.symm (e' (ψ (e.symm v)))))
      rw [AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply, hψΦ]

  induction k, hk using Nat.le_induction with
  | base =>

    haveI : SmoothOfRelativeDimension (1 * d) Y.hom := by rw [one_mul]; infer_instance
    refine ⟨Y, inferInstance, inferInstance, inferInstance, N, j, hj, hjY, ?_⟩
    intro hW r e he rW eW heW μ hμ
    rw [pow_one]
    have key : ∀ (n : ℕ) (hn : d = n) (rW : ℕ) (eW : wcCoh F' Y hW ℓ n ≃+ (Fin rW → ℚ_[ℓ])),
        (∀ (c : ℚ_[ℓ]) (x : wcCoh F' Y hW ℓ n), eW (wcCohScalar F' Y hW ℓ n c x) = c • eW x) →
        μ ∈ (wcAddEquivMatrix eW (wcCohFrob F' Y hW ℓ n)).charpoly.aroots
          (AlgebraicClosure ℚ_[ℓ]) := by
      intro n hn rW eW heW
      subst hn
      obtain ⟨P, hPinj, hPA⟩ := s5 e eW (wcCohScalar F' Y h ℓ d) (wcCohScalar F' Y hW ℓ d) he heW
        (wcCohFrob F' Y h ℓ d) (wcCohFrob F' Y hW ℓ d) (s9 F' Y h d) (s9 F' Y hW d)
        (AddMonoidHom.id _) (fun _ _ hab => hab) (fun _ _ => rfl) 1
        (fun x => by rw [Function.iterate_one]; rfl)
      rw [pow_one] at hPA
      exact s4 _ _ P hPinj hPA μ hμ
    exact key (1 * d) (one_mul d).symm rW eW heW
  | succ k hk ih =>

    obtain ⟨W, iGI, iP, iS, N', jW, hjW, hjWY, hcoh⟩ := ih
    haveI : SmoothOfRelativeDimension d (Limits.pullback.fst W.hom Y.hom) :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension d)
        (IsPullback.of_hasPullback W.hom Y.hom).flip inferInstance
    have iS' : SmoothOfRelativeDimension ((k + 1) * d)
        (Over.mk (Limits.pullback.fst W.hom Y.hom ≫ W.hom)).hom :=
      (show d + k * d = (k + 1) * d by ring) ▸
        smoothOfRelativeDimension_comp d (k * d) (Limits.pullback.fst W.hom Y.hom) W.hom
    have iGI' : GeometricallyIrreducible (Over.mk (Limits.pullback.fst W.hom Y.hom ≫ W.hom)).hom :=
      GeometricallyIrreducible.comp (Limits.pullback.fst W.hom Y.hom) W.hom
    have iP' : IsProper (Over.mk (Limits.pullback.fst W.hom Y.hom ≫ W.hom)).hom :=
      inferInstanceAs (IsProper (Limits.pullback.fst W.hom Y.hom ≫ W.hom))
    obtain ⟨N'', σ, hσ, hσπ⟩ := wc_segre_proj_closed_immersion F' N' N
    haveI : MorphismProperty.IsStableUnderComposition @IsClosedImmersion :=
      ⟨fun f g hf hg => by haveI := hf; haveI := hg; infer_instance⟩
    have w₁ := (Category.comp_id W.hom).trans hjWY.symm
    have w₂ := (Category.comp_id Y.hom).trans hjY.symm
    have hfst : Limits.pullback.map W.hom Y.hom _ _ jW j (𝟙 _) w₁ w₂ ≫ Limits.pullback.fst _ _ =
        Limits.pullback.fst W.hom Y.hom ≫ jW := Limits.pullback.lift_fst _ _ _
    have hι : IsClosedImmersion (Limits.pullback.map W.hom Y.hom _ _ jW j (𝟙 _) w₁ w₂) :=
      MorphismProperty.pullbackMap (P := @IsClosedImmersion) hjW hj hjWY.symm hjY.symm
    refine ⟨Over.mk (Limits.pullback.fst W.hom Y.hom ≫ W.hom), iGI', iP', iS', N'',
      Limits.pullback.map W.hom Y.hom _ _ jW j (𝟙 _) w₁ w₂ ≫ σ, ?_, ?_, ?_⟩
    · haveI := hι
      haveI := hσ
      infer_instance
    · rw [Category.assoc, hσπ, ← Category.assoc, hfst, Category.assoc, hjWY]
      rfl
    · intro hW' r e he rW' eW' heW' μ hμ
      have hW : WeaklyEtale (Limits.pullback.fst W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :=
        MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
          (wc_weaklyEtale_algebraicClosure F')
      obtain ⟨rW, eW, heW⟩ := wc_coh_finite F' W (k * d) ℓ hℓ hW (k * d)
      have hμk := hcoh hW r e he rW eW heW μ hμ
      obtain ⟨M, hM₁, hM₂, hMΦ, hind⟩ := wc_kunneth_external_cup F' W Y (k * d) d ℓ hℓ hW h hW'
        (k * d) d ((k + 1) * d) (by ring)
      obtain ⟨P, hPinj, hPK⟩ := s2 eW e eW' (wcCohScalar F' W hW ℓ (k * d))
        (wcCohScalar F' Y h ℓ d) (wcCohScalar F' _ hW' ℓ ((k + 1) * d)) heW he heW'
        (wcCohFrob F' W hW ℓ (k * d)) (wcCohFrob F' Y h ℓ d) (wcCohFrob F' _ hW' ℓ ((k + 1) * d))
        (s9 F' _ hW' ((k + 1) * d)) M hM₁ hM₂ hMΦ (hind rW eW heW r e he)
      have hprod := s3 _ _ (μ ^ k) hμk μ hμ
      rw [pow_succ]
      exact s4 _ _ P hPinj hPK _ hprod

theorem wc_product_projective_space (F' : Type u) [Finite F'] [Field F'] (Y : Over (Spec (.of F')))
    [GeometricallyIrreducible Y.hom] [IsProper Y.hom] (d : ℕ) [SmoothOfRelativeDimension d Y.hom]
    (N : ℕ) (j : Y.left ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
      MvPolynomial.gradedAlgebra)
    (hj : IsClosedImmersion j)
    (hjY : j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))) = Y.hom)
    (n : ℕ) (hn : d ≤ n) :
    ∃ (W : Over (Spec (.of F'))) (_ : GeometricallyIrreducible W.hom) (_ : IsProper W.hom)
      (_ : SmoothOfRelativeDimension n W.hom) (p : W ⟶ Y) (s : Y ⟶ W), s ≫ p = 𝟙 Y ∧
      ∃ (N' : ℕ) (jW : W.left ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F')
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion jW ∧
        jW ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F')
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F' 0))) = W.hom :=
by
  classical

  have hprop := wc_pp_proper F' (n - d)
  have hcov := wc_pp_basicOpen_cover F' (n - d)
  obtain ⟨pt, hpt, hptU⟩ := wc_pp_rational_point F' (n - d)
  haveI hZL : IsZariskiLocalAtSource (@SmoothOfRelativeDimension.{u} (n - d)) :=
    HasRingHomProperty.instIsZariskiLocalAtSource

  have hsm : SmoothOfRelativeDimension (n - d)
      (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (n - d + 1)) F')
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (n - d + 1)) F' 0)))) := by
    refine IsZariskiLocalAtSource.of_iSup_eq_top (P := @SmoothOfRelativeDimension.{u} (n - d))
      _ hcov ?_
    intro a
    obtain ⟨e, he⟩ := wc_pp_dehomogenize_ringEquiv F' (n - d) a
    obtain ⟨φ, hφ⟩ := wc_pp_chart_iso F' (n - d) a e he
    rw [hφ]
    have hA := AffineSpace.smoothOfRelativeDimension (ULift.{u} (Fin (n - d))) (Spec (.of F'))
    rw [Nat.card_ulift, Nat.card_fin] at hA
    exact IsZariskiLocalAtSource.comp hA φ.hom

  have hgi : GeometricallyIrreducible
      (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (n - d + 1)) F')
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (n - d + 1)) F' 0)))) := by
    refine wc_pp_geomIrred_of_charts _ _ (0 : Fin (n - d + 1)) hcov ?_ ?_
    · intro a
      obtain ⟨e, he⟩ := wc_pp_dehomogenize_ringEquiv F' (n - d) a
      obtain ⟨φ, hφ⟩ := wc_pp_chart_iso F' (n - d) a e he
      exact ⟨_, _, inferInstance, φ, hφ⟩
    · intro a
      obtain ⟨x⟩ := (inferInstance : Nonempty (Spec (.of F')))
      refine ⟨pt x, ?_, ?_⟩
      · have hx : x ∈ pt ⁻¹ᵁ (@Proj.basicOpen _ _ _ _ _
            (MvPolynomial.homogeneousSubmodule (Fin (n - d + 1)) F') MvPolynomial.gradedAlgebra
            (MvPolynomial.X a)) := by rw [hptU a]; trivial
        exact hx
      · have hx : x ∈ pt ⁻¹ᵁ (@Proj.basicOpen _ _ _ _ _
            (MvPolynomial.homogeneousSubmodule (Fin (n - d + 1)) F') MvPolynomial.gradedAlgebra
            (MvPolynomial.X 0)) := by rw [hptU 0]; trivial
        exact hx

  set q := (@Proj.toSpecZero _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (n - d + 1)) F') MvPolynomial.gradedAlgebra ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (n - d + 1)) F' 0)))) with hqdef
  obtain ⟨N', σ, hσ, hσK⟩ := wc_pp_segre F' N (n - d)
  haveI := hprop
  haveI := hsm
  haveI := hgi
  haveI := hj
  haveI := hσ

  have hsmf : SmoothOfRelativeDimension (n - d) (Limits.pullback.fst Y.hom q) :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension (n - d))
      (IsPullback.of_hasPullback Y.hom q).flip hsm
  have hGIW : GeometricallyIrreducible (Limits.pullback.fst Y.hom q ≫ Y.hom) :=
    GeometricallyIrreducible.comp _ _
  have hPW : IsProper (Limits.pullback.fst Y.hom q ≫ Y.hom) := inferInstance
  have hSW : SmoothOfRelativeDimension n (Limits.pullback.fst Y.hom q ≫ Y.hom) := by
    have := smoothOfRelativeDimension_comp (n - d) d (Limits.pullback.fst Y.hom q) Y.hom
    rwa [Nat.sub_add_cancel hn] at this
  have hw : 𝟙 Y.left ≫ Y.hom = (Y.hom ≫ pt) ≫ q := by
    rw [Category.assoc, hpt, Category.comp_id, Category.id_comp]
  have hlf : Limits.pullback.lift (𝟙 Y.left) (Y.hom ≫ pt) hw ≫ Limits.pullback.fst Y.hom q =
      𝟙 Y.left := Limits.pullback.lift_fst _ _ _
  have hlf2 : Limits.pullback.lift (𝟙 Y.left) (Y.hom ≫ pt) hw ≫
      (Limits.pullback.fst Y.hom q ≫ Y.hom) = Y.hom := by
    rw [← Category.assoc, hlf, Category.id_comp]
  haveI hCI : MorphismProperty.IsStableUnderComposition @IsClosedImmersion.{u} :=
    ⟨fun f g hf hg => @IsClosedImmersion.comp _ _ _ f g hf hg⟩
  refine ⟨Over.mk (Limits.pullback.fst Y.hom q ≫ Y.hom), hGIW, hPW, hSW,
    Over.homMk (Limits.pullback.fst Y.hom q) rfl,
    Over.homMk (Limits.pullback.lift (𝟙 Y.left) (Y.hom ≫ pt) hw) hlf2, ?_, ?_⟩
  · apply Over.OverMorphism.ext
    rw [Over.comp_left, Over.id_left]
    exact hlf
  · have e1 : Y.hom = j ≫ (@Proj.toSpecZero _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F') MvPolynomial.gradedAlgebra ≫
        Spec.map (CommRingCat.ofHom
          (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0)))) := hjY.symm
    have e2 : q = 𝟙 _ ≫ q := (Category.id_comp q).symm
    have hmap := MorphismProperty.pullbackMap (P := @IsClosedImmersion.{u}) hj
      (inferInstance : IsClosedImmersion (𝟙 _)) e1 e2
    haveI := hmap
    refine ⟨N', _ ≫ σ, @IsClosedImmersion.comp _ _ _ _ σ hmap hσ, ?_⟩
    show _ = Limits.pullback.fst Y.hom q ≫ Y.hom
    rw [Category.assoc, hσK]
    first
      | (erw [Limits.pullback.lift_fst_assoc]; rw [Category.assoc, hjY])
      | simp [Limits.pullback.map, hjY]

theorem wc_ladic_retraction_data {A B : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ A) (hgf : g ≫ f = 𝟙 B)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [(wcProEtPullback f).IsContinuous (Scheme.ProEt.topology B) (Scheme.ProEt.topology A)]
    [(wcProEtPullback g).IsContinuous (Scheme.ProEt.topology A) (Scheme.ProEt.topology B)] :
    ∃ (ρ₁ : wcLadicSheaf B ℓ ⟶ ((wcProEtPullback f).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology B) (Scheme.ProEt.topology A)).obj (wcLadicSheaf A ℓ))
      (ρ₂ : wcLadicSheaf A ℓ ⟶ ((wcProEtPullback g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology A) (Scheme.ProEt.topology B)).obj (wcLadicSheaf B ℓ))
      (e : (wcProEtPullback g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology A) (Scheme.ProEt.topology B) ⋙
          (wcProEtPullback f).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology B) (Scheme.ProEt.topology A) ≅ 𝟭 _),
      ρ₁ ≫ ((wcProEtPullback f).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology B) (Scheme.ProEt.topology A)).map ρ₂ ≫
          e.hom.app (wcLadicSheaf B ℓ) = 𝟙 _ ∧
      ∀ c : ℚ_[ℓ], wcLadicScalar B ℓ c ≫ ρ₁ = ρ₁ ≫
        ((wcProEtPullback f).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology B) (Scheme.ProEt.topology A)).map (wcLadicScalar A ℓ c) :=
by
  classical

  have s1 : ∀ {A' B' : Scheme.{u}} (h : A' ⟶ B'),
      ∃ α : wcProEtPullback h ⋙ Scheme.ProEt.forget A' ⋙ Over.forget A' ⟶
          Scheme.ProEt.forget B' ⋙ Over.forget B',
        ∀ U : B'.ProEt, α.app U = Limits.pullback.fst U.hom h := by
    intro A' B' h
    refine ⟨{ app := fun U => Limits.pullback.fst U.hom h, naturality := ?_ }, fun U => rfl⟩
    intro U V v
    have w : (Limits.pullback.fst U.hom h ≫ v.left) ≫ V.hom = Limits.pullback.snd U.hom h ≫ h := by
      rw [Category.assoc, MorphismProperty.Over.w v]
      exact Limits.pullback.condition
    show Limits.pullback.lift (Limits.pullback.fst U.hom h ≫ v.left) (Limits.pullback.snd U.hom h) w ≫
        Limits.pullback.fst V.hom h = Limits.pullback.fst U.hom h ≫ v.left
    exact Limits.pullback.lift_fst _ _ _
  obtain ⟨αf, hαf⟩ := s1 f
  obtain ⟨αg, hαg⟩ := s1 g
  have natg : ∀ {U V : A.ProEt} (v : U ⟶ V),
      ((wcProEtPullback g).map v).left ≫ αg.app V = αg.app U ≫ v.left :=
    fun v => αg.naturality v
  have natf : ∀ {U V : B.ProEt} (v : U ⟶ V),
      ((wcProEtPullback f).map v).left ≫ αf.app V = αf.app U ≫ v.left :=
    fun v => αf.naturality v

  have gen0 : ∀ {X : Scheme.{u}} (x : X ⟶ B),
      ∃ k : X ⟶ Limits.pullback (Limits.pullback.snd x f) g,
        k ≫ (Limits.pullback.fst (Limits.pullback.snd x f) g ≫ Limits.pullback.fst x f) = 𝟙 X ∧
        (Limits.pullback.fst (Limits.pullback.snd x f) g ≫ Limits.pullback.fst x f) ≫ k = 𝟙 _ ∧
        (Limits.pullback.fst (Limits.pullback.snd x f) g ≫ Limits.pullback.fst x f) ≫ x =
          Limits.pullback.snd (Limits.pullback.snd x f) g := by
    intro X x
    have w1 : 𝟙 X ≫ x = (x ≫ g) ≫ f := by
      rw [Category.id_comp, Category.assoc, hgf, Category.comp_id]
    have w2 : Limits.pullback.lift (𝟙 X) (x ≫ g) w1 ≫ Limits.pullback.snd x f = x ≫ g :=
      Limits.pullback.lift_snd _ _ _
    have hK : (Limits.pullback.fst (Limits.pullback.snd x f) g ≫ Limits.pullback.fst x f) ≫ x =
        Limits.pullback.snd (Limits.pullback.snd x f) g := by
      rw [Category.assoc, Limits.pullback.condition (f := x) (g := f), ← Category.assoc,
        Limits.pullback.condition (f := Limits.pullback.snd x f) (g := g), Category.assoc, hgf,
        Category.comp_id]
    refine ⟨Limits.pullback.lift (Limits.pullback.lift (𝟙 X) (x ≫ g) w1) x w2, ?_, ?_, hK⟩
    · rw [Limits.pullback.lift_fst_assoc, Limits.pullback.lift_fst]
    · apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, Category.id_comp]
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, Limits.pullback.lift_fst, Category.comp_id]
        · rw [Category.assoc, Limits.pullback.lift_snd, ← Category.assoc, hK,
            Limits.pullback.condition (f := Limits.pullback.snd x f) (g := g)]
      · rw [Category.assoc, Limits.pullback.lift_snd, Category.id_comp]
        exact hK
  have gen : ∀ U : B.ProEt,
      ∃ k : U.left ⟶ ((wcProEtPullback g).obj ((wcProEtPullback f).obj U)).left,
        k ≫ (αg.app ((wcProEtPullback f).obj U) ≫ αf.app U) = 𝟙 U.left ∧
        (αg.app ((wcProEtPullback f).obj U) ≫ αf.app U) ≫ k = 𝟙 _ ∧
        (αg.app ((wcProEtPullback f).obj U) ≫ αf.app U) ≫ U.hom =
          ((wcProEtPullback g).obj ((wcProEtPullback f).obj U)).hom := by
    intro U
    rw [hαg, hαf]
    exact gen0 U.hom
  choose k hk1 hk2 hk3 using gen
  let isoU : ∀ U : B.ProEt, ((wcProEtPullback f ⋙ wcProEtPullback g).obj U).left ≅
      ((𝟭 B.ProEt).obj U).left := fun U =>
    { hom := αg.app ((wcProEtPullback f).obj U) ≫ αf.app U
      inv := k U
      hom_inv_id := hk2 U
      inv_hom_id := hk1 U }
  have comm4 : ∀ {P Q R S T Z : Scheme.{u}} (x : P ⟶ Q) (a : Q ⟶ R) (b : R ⟶ T)
      (a' : P ⟶ S) (y : S ⟶ R) (b' : S ⟶ Z) (z : Z ⟶ T),
      x ≫ a = a' ≫ y → y ≫ b = b' ≫ z → x ≫ a ≫ b = (a' ≫ b') ≫ z := by
    intro P Q R S T Z x a b a' y b' z h1 h2
    rw [← Category.assoc, h1, Category.assoc, h2, Category.assoc]
  let η : wcProEtPullback f ⋙ wcProEtPullback g ≅ 𝟭 B.ProEt :=
    NatIso.ofComponents (fun U => MorphismProperty.Over.isoMk (isoU U) (hk3 U)) (by
      intro U V v
      apply MorphismProperty.Over.Hom.ext
      show ((wcProEtPullback g).map ((wcProEtPullback f).map v)).left ≫
          (αg.app ((wcProEtPullback f).obj V) ≫ αf.app V) =
        (αg.app ((wcProEtPullback f).obj U) ≫ αf.app U) ≫ v.left
      exact comm4 _ _ _ _ _ _ _ (natg ((wcProEtPullback f).map v)) (natf v))
  have hη : ∀ U : B.ProEt,
      (η.inv.app U).left ≫ αg.app ((wcProEtPullback f).obj U) ≫ αf.app U = 𝟙 U.left :=
    fun U => hk1 U

  refine ⟨ObjectProperty.homMk (Functor.whiskerRight (NatTrans.op αf)
        (continuousMapPresheafAb.{0, u} ℚ_[ℓ] ⋙ AddCommGrpCat.uliftFunctor.{u+1, u})),
    ObjectProperty.homMk (Functor.whiskerRight (NatTrans.op αg)
        (continuousMapPresheafAb.{0, u} ℚ_[ℓ] ⋙ AddCommGrpCat.uliftFunctor.{u+1, u})),
    Functor.sheafPushforwardContinuousComp' η AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology B) (Scheme.ProEt.topology A) (Scheme.ProEt.topology B) ≪≫
        Functor.sheafPushforwardContinuousId AddCommGrpCat.{u+1} (Scheme.ProEt.topology B), ?_, ?_⟩
  ·
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    show (continuousMapPresheafAb.{0, u} ℚ_[ℓ] ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map
          (αf.app U.unop).op ≫
        (continuousMapPresheafAb.{0, u} ℚ_[ℓ] ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map
          (αg.app ((wcProEtPullback f).obj U.unop)).op ≫
        ((continuousMapPresheafAb.{0, u} ℚ_[ℓ] ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}).map
          ((η.inv.app U.unop).left).op ≫ 𝟙 _) = 𝟙 _
    have genR : ∀ (G : Scheme.{u}ᵒᵖ ⥤ AddCommGrpCat.{u+1}) {P Q R : Scheme.{u}}
        (a : Q ⟶ P) (b : R ⟶ Q) (k' : P ⟶ R), k' ≫ b ≫ a = 𝟙 P →
        G.map a.op ≫ G.map b.op ≫ (G.map k'.op ≫ 𝟙 _) = 𝟙 _ := by
      intro G P Q R a b k' h
      rw [Category.comp_id, ← G.map_comp, ← G.map_comp, ← op_comp, ← op_comp, Category.assoc, h,
        op_id, G.map_id]
    exact genR _ _ _ _ (hη U.unop)
  ·
    intro c
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rfl

theorem wc_pullback_retract_injective (F' : Type u) [Finite F'] [Field F'] (Y W : Over (Spec (.of F')))
    (p : W ⟶ Y) (s : Y ⟶ W) (hsp : s ≫ p = 𝟙 Y) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
    (hW : WeaklyEtale (Limits.pullback.fst W.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))))
    (i : ℕ) :
    ∃ ψ : wcCoh F' Y hY ℓ i →+ wcCoh F' W hW ℓ i, Function.Injective ψ ∧
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F' Y hY ℓ i),
        ψ (wcCohScalar F' Y hY ℓ i c x) = wcCohScalar F' W hW ℓ i c (ψ x)) ∧
      ∀ x : wcCoh F' Y hY ℓ i, ψ (wcCohFrob F' Y hY ℓ i x) = wcCohFrob F' W hW ℓ i (ψ x) :=
by
  classical

  have hgf : s.left ≫ p.left = 𝟙 Y.left := by
    have h := congrArg (fun k => CommaMorphism.left k) hsp
    simpa using h

  obtain ⟨hcf, hff⟩ := wc_proet_pullback_continuous_flat p.left
  obtain ⟨hcg, hfg⟩ := wc_proet_pullback_continuous_flat s.left
  haveI := hcf
  haveI := hff
  haveI := hcg
  haveI := hfg

  let Lp := (wcProEtPullback p.left).sheafPullback AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology Y.left) (Scheme.ProEt.topology W.left)
  let Rp := (wcProEtPullback p.left).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology Y.left) (Scheme.ProEt.topology W.left)
  let adjp : Lp ⊣ Rp := (wcProEtPullback p.left).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology Y.left) (Scheme.ProEt.topology W.left)
  let Ls := (wcProEtPullback s.left).sheafPullback AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology Y.left)
  let Rs := (wcProEtPullback s.left).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology Y.left)
  let adjs : Ls ⊣ Rs := (wcProEtPullback s.left).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology W.left) (Scheme.ProEt.topology Y.left)

  haveI : Limits.PreservesFiniteLimits Lp :=
    wc_sheafPullback_preservesFiniteLimits_of_flat (Scheme.ProEt.topology Y.left)
      (Scheme.ProEt.topology W.left) (wcProEtPullback p.left)
  haveI : Limits.PreservesFiniteLimits Ls :=
    wc_sheafPullback_preservesFiniteLimits_of_flat (Scheme.ProEt.topology W.left)
      (Scheme.ProEt.topology Y.left) (wcProEtPullback s.left)
  haveI : Limits.PreservesColimitsOfSize.{0, 0} Lp := adjp.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits Lp :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits Lp
  haveI : Limits.PreservesColimitsOfSize.{0, 0} Ls := adjs.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits Ls :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits Ls
  haveI : Limits.PreservesLimitsOfSize.{0, 0} Rp := adjp.rightAdjoint_preservesLimits
  haveI : Limits.PreservesLimitsOfSize.{0, 0} Rs := adjs.rightAdjoint_preservesLimits
  haveI : Rp.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint Rp
  haveI : Rs.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint Rs
  haveI : Rp.Additive := Functor.additive_of_preserves_binary_products Rp
  haveI : Rs.Additive := Functor.additive_of_preserves_binary_products Rs
  haveI : Lp.Additive := adjp.left_adjoint_additive
  haveI : Ls.Additive := adjs.left_adjoint_additive

  obtain ⟨ρ₁, ρ₂, e, hρ, hsc⟩ := wc_ladic_retraction_data p.left s.left hgf ℓ

  obtain ⟨θ, hθ⟩ := wc_sheafPullback_free_natIso (Scheme.ProEt.topology Y.left)
    (Scheme.ProEt.topology W.left) (wcProEtPullback p.left) Lp adjp
  obtain ⟨eg, heg⟩ := wc_geomPoint_pullback_iso F' Y W p hY hW
  let θY : Lp.obj (wcFreeSheaf Y.left (wcGeomPoint F' Y hY)) ≅
      wcFreeSheaf W.left ((wcProEtPullback p.left).obj (wcGeomPoint F' Y hY)) :=
    θ (wcGeomPoint F' Y hY)
  let egF : wcFreeSheaf W.left (wcGeomPoint F' W hW) ≅
      wcFreeSheaf W.left ((wcProEtPullback p.left).obj (wcGeomPoint F' Y hY)) :=
    (presheafToSheaf (Scheme.ProEt.topology W.left) AddCommGrpCat.{u+1}).mapIso
      (Functor.isoWhiskerRight (yoneda.mapIso eg) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
  have hegF : egF.hom = wcFreeSheafMap W.left eg.hom := rfl
  let a : wcFreeSheaf W.left (wcGeomPoint F' W hW) ≅
      Lp.obj (wcFreeSheaf Y.left (wcGeomPoint F' Y hY)) := egF ≪≫ θY.symm
  have ha : a.hom = egF.hom ≫ θY.inv := rfl

  set r : Lp.obj (wcLadicSheaf Y.left ℓ) ⟶ wcLadicSheaf W.left ℓ :=
    (adjp.homEquiv _ _).symm ρ₁ with hr
  set r' : Ls.obj (wcLadicSheaf W.left ℓ) ⟶ wcLadicSheaf Y.left ℓ :=
    (adjs.homEquiv _ _).symm ρ₂ with hr'

  let ψ : wcCoh F' Y hY ℓ i →+ wcCoh F' W hW ℓ i :=
    ((Abelian.Ext.mk₀ a.hom).precomp _ (zero_add i)).comp
      (((Abelian.Ext.mk₀ r).postcomp _ (add_zero i)).comp
        (Lp.mapExtAddHom (wcFreeSheaf Y.left (wcGeomPoint F' Y hY)) (wcLadicSheaf Y.left ℓ) i))
  have hψ : ∀ x : wcCoh F' Y hY ℓ i, ψ x = (Abelian.Ext.mk₀ a.hom).comp
      ((Abelian.Ext.mapExactFunctor Lp x).comp (Abelian.Ext.mk₀ r) (add_zero i)) (zero_add i) := by
    intro x
    first
      | rfl
      | (simp only [ψ, AddMonoidHom.comp_apply, Functor.mapExtAddHom_apply]; done)
      | (simp only [ψ, AddMonoidHom.comp_apply, Functor.mapExtAddHom_apply]; rfl)
  refine ⟨ψ, ?_, ?_, ?_⟩
  ·
    have tauGen : ∀ (Q : Sheaf (Scheme.ProEt.topology Y.left) AddCommGrpCat.{u+1})
        (Q' : Sheaf (Scheme.ProEt.topology W.left) AddCommGrpCat.{u+1})
        (ρp : Q ⟶ Rp.obj Q') (ρs : Q' ⟶ Rs.obj Q), ρp ≫ Rp.map ρs ≫ e.hom.app Q = 𝟙 Q →
        ∃ τ : Lp ⋙ Ls ⟶ 𝟭 _, (∀ X, IsIso (τ.app X)) ∧
          Ls.map ((adjp.homEquiv _ _).symm ρp) ≫ (adjs.homEquiv _ _).symm ρs = τ.app Q := by
      intro Q Q' ρp ρs hρQ
      let adj₁ : Lp ⋙ Ls ⊣ 𝟭 _ := (adjp.comp adjs).ofNatIsoRight e
      haveI : IsIso adj₁.counit := adj₁.counit_isIso_of_R_fully_faithful
      refine ⟨(Functor.leftUnitor _).inv ≫ adj₁.counit, fun X => ?_, ?_⟩
      · simp only [NatTrans.comp_app, Functor.leftUnitor_inv_app, Category.id_comp]
        infer_instance
      · simp only [NatTrans.comp_app, Functor.leftUnitor_inv_app, Category.id_comp]
        have h1 : adj₁.counit.app Q = (adj₁.homEquiv Q Q).symm (𝟙 Q) := by
          rw [Adjunction.homEquiv_counit]; simp
        rw [h1, Equiv.eq_symm_apply]
        have h2 : adj₁.homEquiv Q Q (Ls.map ((adjp.homEquiv _ _).symm ρp) ≫
              (adjs.homEquiv _ _).symm ρs) =
            (adjp.comp adjs).homEquiv Q Q (Ls.map ((adjp.homEquiv _ _).symm ρp) ≫
              (adjs.homEquiv _ _).symm ρs) ≫ e.hom.app Q := by
          rw [Adjunction.homEquiv_unit, Adjunction.homEquiv_unit]
          dsimp [adj₁, Adjunction.ofNatIsoRight]
          simp only [Category.assoc]
          congr 1
          exact (e.hom.naturality _).symm
        rw [h2, Adjunction.comp_homEquiv]
        simp only [Equiv.trans_apply]
        rw [Adjunction.homEquiv_naturality_left, Equiv.apply_symm_apply,
          Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply, Category.assoc, hρQ]
    obtain ⟨τ, hτiso, hτQ⟩ : ∃ τ : Lp ⋙ Ls ⟶ 𝟭 _, (∀ X, IsIso (τ.app X)) ∧
        Ls.map r ≫ r' = τ.app (wcLadicSheaf Y.left ℓ) := tauGen _ _ ρ₁ ρ₂ hρ
    have key : ∀ z : wcCoh F' Y hY ℓ i,
        (Abelian.Ext.mk₀ (Ls.map a.inv)).comp ((Abelian.Ext.mapExactFunctor Ls
          ((Abelian.Ext.mk₀ a.hom).comp ((Abelian.Ext.mapExactFunctor Lp z).comp
            (Abelian.Ext.mk₀ r) (add_zero i)) (zero_add i))).comp (Abelian.Ext.mk₀ r') (add_zero i))
            (zero_add i) =
          (Abelian.Ext.mk₀ (τ.app (wcFreeSheaf Y.left (wcGeomPoint F' Y hY)))).comp z (zero_add i) := by
      intro z
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀_assoc,
        ← CategoryTheory.Functor.map_comp, Iso.inv_hom_id, CategoryTheory.Functor.map_id,
        Abelian.Ext.mk₀_id_comp,
        Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hτQ,
        ← Abelian.Ext.comp_mapExactFunctor, Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp,
        Abelian.Ext.id_mapExactFunctor]
    intro x y hxy
    rw [hψ, hψ] at hxy
    have h2 : (Abelian.Ext.mk₀ (τ.app (wcFreeSheaf Y.left (wcGeomPoint F' Y hY)))).comp x
          (zero_add i) =
        (Abelian.Ext.mk₀ (τ.app (wcFreeSheaf Y.left (wcGeomPoint F' Y hY)))).comp y
          (zero_add i) := by
      rw [← key x, ← key y]
      exact congrArg (fun w => (Abelian.Ext.mk₀ (Ls.map a.inv)).comp
        ((Abelian.Ext.mapExactFunctor Ls w).comp (Abelian.Ext.mk₀ r') (add_zero i)) (zero_add i))
        hxy
    haveI := hτiso (wcFreeSheaf Y.left (wcGeomPoint F' Y hY))
    have h3 := congrArg (fun w => (Abelian.Ext.mk₀
      (inv (τ.app (wcFreeSheaf Y.left (wcGeomPoint F' Y hY))))).comp w (zero_add i)) h2
    simpa only [Abelian.Ext.mk₀_comp_mk₀_assoc, IsIso.inv_hom_id, Abelian.Ext.mk₀_id_comp] using h3
  ·
    intro c x
    have hcomm : Lp.map (wcLadicScalar Y.left ℓ c) ≫ r = r ≫ wcLadicScalar W.left ℓ c := by
      rw [hr, ← Adjunction.homEquiv_naturality_left_symm, hsc c,
        Adjunction.homEquiv_naturality_right_symm]
    show ψ (x.comp (Abelian.Ext.mk₀ (wcLadicScalar Y.left ℓ c)) (add_zero i)) =
      (ψ x).comp (Abelian.Ext.mk₀ (wcLadicScalar W.left ℓ c)) (add_zero i)
    rw [hψ, hψ]
    simp only [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    rw [hcomm]
  ·
    intro x
    have hFcomp : ∀ {S : Scheme.{u}} {U V V' : S.ProEt} (f : U ⟶ V) (g : V ⟶ V'),
        wcFreeSheafMap S (f ≫ g) = wcFreeSheafMap S f ≫ wcFreeSheafMap S g := by
      intro S U V V' f g
      unfold wcFreeSheafMap
      rw [CategoryTheory.Functor.map_comp yoneda, Functor.whiskerRight_comp]
      exact CategoryTheory.Functor.map_comp _ _ _
    have hθ' : Lp.map (wcFreeSheafMap Y.left (wcGeomFrob F' Y hY)) ≫ θY.hom =
        θY.hom ≫ wcFreeSheafMap W.left ((wcProEtPullback p.left).map (wcGeomFrob F' Y hY)) :=
      hθ (wcGeomFrob F' Y hY)
    have hθinv : θY.inv ≫ Lp.map (wcFreeSheafMap Y.left (wcGeomFrob F' Y hY)) =
        wcFreeSheafMap W.left ((wcProEtPullback p.left).map (wcGeomFrob F' Y hY)) ≫ θY.inv := by
      rw [Iso.inv_comp_eq, ← Category.assoc, ← hθ', Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    have hfrob : a.hom ≫ Lp.map (wcFreeSheafMap Y.left (wcGeomFrob F' Y hY)) =
        wcFreeSheafMap W.left (wcGeomFrob F' W hW) ≫ a.hom := by
      rw [ha, Category.assoc, hθinv, ← Category.assoc, hegF,
        ← hFcomp eg.hom, heg, hFcomp, Category.assoc]
    show ψ ((Abelian.Ext.mk₀ (wcFreeSheafMap Y.left (wcGeomFrob F' Y hY))).comp x (zero_add i)) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap W.left (wcGeomFrob F' W hW))).comp (ψ x) (zero_add i)
    rw [hψ, hψ]
    simp only [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc]
    rw [hfrob]

theorem wc_purity_projective (F' : Type u) [Finite F'] [Field F'] (Y : Over (Spec (.of F')))
    [GeometricallyIrreducible Y.hom] [IsProper Y.hom] (d : ℕ) [SmoothOfRelativeDimension d Y.hom]
    (N : ℕ) (j : Y.left ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
      MvPolynomial.gradedAlgebra)
    (hj : IsClosedImmersion j)
    (hjY : j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))) = Y.hom)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F')
    (h : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))) :
    ∀ i ≤ 2 * d, ∀ (r : ℕ) (e : wcCoh F' Y h ℓ i ≃+ (Fin r → ℚ_[ℓ])),
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F' Y h ℓ i), e (wcCohScalar F' Y h ℓ i c x) = c • e x) →
      ∀ μ ∈ (wcAddEquivMatrix e (wcCohFrob F' Y h ℓ i)).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
      ∀ ι : AlgebraicClosure ℚ_[ℓ] ≃+* ℂ, ‖ι μ‖ = √((Nat.card F' : ℝ) ^ i) :=
by
  classical

  have s6 : ∀ (F₀ : Type u) [Field F₀] [Finite F₀] (X₀ : Over (Spec (.of F₀)))
      (h₀ : WeaklyEtale (Limits.pullback.fst X₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F₀ (AlgebraicClosure F₀))))))
      (i : ℕ) (c : ℚ_[ℓ]) (x : wcCoh F₀ X₀ h₀ ℓ i),
      wcCohFrob F₀ X₀ h₀ ℓ i (wcCohScalar F₀ X₀ h₀ ℓ i c x) =
        wcCohScalar F₀ X₀ h₀ ℓ i c (wcCohFrob F₀ X₀ h₀ ℓ i x) := by
    intro F₀ _ _ X₀ h₀ i c x
    show (Abelian.Ext.mk₀ (wcFreeSheafMap X₀.left (wcGeomFrob F₀ X₀ h₀))).comp
        (x.comp (Abelian.Ext.mk₀ (wcLadicScalar X₀.left ℓ c)) (add_zero i)) (zero_add i) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap X₀.left (wcGeomFrob F₀ X₀ h₀))).comp x (zero_add i)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar X₀.left ℓ c)) (add_zero i)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add i) (add_zero i) (by omega)).symm

  have s4 : ∀ {r r' : ℕ} (m : ℕ) (A : Matrix (Fin r) (Fin r) ℚ_[ℓ])
      (B : Matrix (Fin r') (Fin r') ℚ_[ℓ]) (P : Matrix (Fin r') (Fin r) ℚ_[ℓ]),
      (∀ v : Fin r → ℚ_[ℓ], P.mulVec v = 0 → v = 0) → P * A ^ m = B * P →
      ∀ μ ∈ A.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
        μ ^ m ∈ B.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    intro r r' m A B P hP hPA μ hμ
    set f : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ] := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hf
    have hker : LinearMap.ker (Matrix.toLin' P) = ⊥ := by
      rw [LinearMap.ker_eq_bot']
      intro v hv
      exact hP v (by rwa [Matrix.toLin'_apply] at hv)
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective _ hker
    have hQP : LinearMap.toMatrix' g * P = 1 := by
      have := congrArg LinearMap.toMatrix' hg
      rwa [LinearMap.toMatrix'_comp, LinearMap.toMatrix'_toLin', LinearMap.toMatrix'_id] at this
    have hQPL : (LinearMap.toMatrix' g).map f * P.map f = 1 := by
      rw [← Matrix.map_mul, hQP, Matrix.map_one _ (map_zero f) (map_one f)]
    have hPAL : P.map f * A.map f ^ m = B.map f * P.map f := by
      rw [← Matrix.map_pow, ← Matrix.map_mul, ← Matrix.map_mul, hPA]
    rw [Polynomial.mem_aroots] at hμ
    obtain ⟨_, hμ⟩ := hμ
    have hdet : (Matrix.scalar (Fin r) μ - A.map f).det = 0 := by
      rw [← Matrix.eval_charpoly, Matrix.charpoly_map, Polynomial.eval_map, ← Polynomial.aeval_def]
      exact hμ
    obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hAv : (A.map f).mulVec v = μ • v := by
      rw [Matrix.sub_mulVec, sub_eq_zero] at hv
      rw [← hv, Matrix.scalar_apply]
      ext x
      simp [Matrix.mulVec_diagonal]
    have hAkv : ∀ k : ℕ, (A.map f ^ k).mulVec v = μ ^ k • v := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ (A.map f), ← Matrix.mulVec_mulVec, hAv, Matrix.mulVec_smul, ih, smul_smul,
          ← pow_succ']
    have hw0 : (P.map f).mulVec v ≠ 0 := by
      intro hw
      apply hv0
      have e1 : ((LinearMap.toMatrix' g).map f).mulVec ((P.map f).mulVec v) = v := by
        rw [Matrix.mulVec_mulVec, hQPL, Matrix.one_mulVec]
      rw [← e1, hw, Matrix.mulVec_zero]
    have hBw : (B.map f).mulVec ((P.map f).mulVec v) = μ ^ m • (P.map f).mulVec v := by
      rw [Matrix.mulVec_mulVec, ← hPAL, ← Matrix.mulVec_mulVec, hAkv, Matrix.mulVec_smul]
    have hdet' : (Matrix.scalar (Fin r') (μ ^ m) - B.map f).det = 0 := by
      apply Matrix.exists_mulVec_eq_zero_iff.mp
      refine ⟨(P.map f).mulVec v, hw0, ?_⟩
      rw [Matrix.sub_mulVec, hBw, Matrix.scalar_apply, sub_eq_zero]
      ext x
      simp [Matrix.mulVec_diagonal]
    rw [Polynomial.mem_aroots]
    refine ⟨(Matrix.charpoly_monic B).ne_zero, ?_⟩
    rw [Polynomial.aeval_def, ← Polynomial.eval_map, ← Matrix.charpoly_map, Matrix.eval_charpoly]
    exact hdet'

  have s5 : ∀ {V V' : Type (u+1)} [AddCommGroup V] [AddCommGroup V'] {r r' : ℕ}
      (e : V ≃+ (Fin r → ℚ_[ℓ])) (e' : V' ≃+ (Fin r' → ℚ_[ℓ]))
      (s : ℚ_[ℓ] → V →+ V) (s' : ℚ_[ℓ] → V' →+ V')
      (he : ∀ (c : ℚ_[ℓ]) (x : V), e (s c x) = c • e x)
      (he' : ∀ (c : ℚ_[ℓ]) (x : V'), e' (s' c x) = c • e' x)
      (Φ : V →+ V) (Φ' : V' →+ V')
      (hΦ : ∀ (c : ℚ_[ℓ]) (x : V), Φ (s c x) = s c (Φ x))
      (hΦ' : ∀ (c : ℚ_[ℓ]) (x : V'), Φ' (s' c x) = s' c (Φ' x))
      (ψ : V →+ V') (hψ : Function.Injective ψ)
      (hψs : ∀ (c : ℚ_[ℓ]) (x : V), ψ (s c x) = s' c (ψ x))
      (m : ℕ) (hψΦ : ∀ x : V, ψ ((⇑Φ)^[m] x) = Φ' (ψ x)),
      ∃ P : Matrix (Fin r') (Fin r) ℚ_[ℓ], (∀ v : Fin r → ℚ_[ℓ], P.mulVec v = 0 → v = 0) ∧
        P * (wcAddEquivMatrix e Φ) ^ m = wcAddEquivMatrix e' Φ' * P := by
    intro V V' _ _ r r' e e' s s' he he' Φ Φ' hΦ hΦ' ψ hψ hψs m hψΦ
    have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), e.symm (c • v) = s c (e.symm v) := fun c v =>
      e.injective (by rw [he, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    have hes' : ∀ (c : ℚ_[ℓ]) (v : Fin r' → ℚ_[ℓ]), e'.symm (c • v) = s' c (e'.symm v) :=
      fun c v => e'.injective (by rw [he', AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    let LA : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) :=
      { toFun := fun v => e (Φ (e.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes, hΦ, he, RingHom.id_apply] }
    let LB : (Fin r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) :=
      { toFun := fun v => e' (Φ' (e'.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes', hΦ', he', RingHom.id_apply] }
    let LP : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) :=
      { toFun := fun v => e' (ψ (e.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes, hψs, he', RingHom.id_apply] }
    have hA : wcAddEquivMatrix e Φ = LinearMap.toMatrix' LA := by
      ext a b
      rw [LinearMap.toMatrix'_apply]
      rfl
    have hB : wcAddEquivMatrix e' Φ' = LinearMap.toMatrix' LB := by
      ext a b
      rw [LinearMap.toMatrix'_apply]
      rfl
    have hAk : ∀ (k : ℕ) (v : Fin r → ℚ_[ℓ]),
        ((wcAddEquivMatrix e Φ) ^ k).mulVec v = e ((⇑Φ)^[k] (e.symm v)) := by
      intro k
      induction k with
      | zero => intro v; simp
      | succ k ih =>
        intro v
        rw [pow_succ', ← Matrix.mulVec_mulVec, ih, hA, LinearMap.toMatrix'_mulVec]
        show e (Φ (e.symm (e ((⇑Φ)^[k] (e.symm v))))) = _
        rw [AddEquiv.symm_apply_apply, Function.iterate_succ_apply']
    refine ⟨LinearMap.toMatrix' LP, ?_, ?_⟩
    · intro v hv
      rw [LinearMap.toMatrix'_mulVec] at hv
      change e' (ψ (e.symm v)) = 0 at hv
      have h1 : ψ (e.symm v) = 0 := e'.injective (hv.trans (map_zero e').symm)
      have h2 : e.symm v = 0 := hψ (h1.trans (map_zero ψ).symm)
      rw [← AddEquiv.apply_symm_apply e v, h2, map_zero]
    · apply Matrix.toLin'.injective
      apply LinearMap.ext
      intro v
      rw [Matrix.toLin'_apply, Matrix.toLin'_apply, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
        hAk, hB, LinearMap.toMatrix'_mulVec, LinearMap.toMatrix'_mulVec, LinearMap.toMatrix'_mulVec]
      show e' (ψ (e.symm (e ((⇑Φ)^[m] (e.symm v))))) = e' (Φ' (e'.symm (e' (ψ (e.symm v)))))
      rw [AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply, hψΦ]

  have key : ∀ q x y : ℝ, 0 < x → x < y →
      (∀ t : ℕ, 1 ≤ t → y ^ (4 * t) ≤ q * x ^ (4 * t)) → False := by
    intro q x y hx hxy H
    set z := y / x - 1 with hz
    have hz0 : 0 < z := by
      rw [hz, sub_pos, lt_div_iff₀ hx]; linarith
    obtain ⟨T, hT⟩ := exists_nat_gt (q / (4 * z))
    have h1 := H (T + 1) (by omega)
    have hb := one_add_mul_le_pow (show (-2 : ℝ) ≤ z by linarith) (4 * (T + 1))
    have h1z : 1 + z = y / x := by rw [hz]; ring
    rw [h1z, div_pow] at hb
    have hxp : 0 < x ^ (4 * (T + 1)) := pow_pos hx _
    rw [le_div_iff₀ hxp] at hb
    have h2 : (1 + ((4 * (T + 1) : ℕ) : ℝ) * z) ≤ q := le_of_mul_le_mul_right (hb.trans h1) hxp
    have hT' : q < 4 * z * T := by
      rw [div_lt_iff₀ (by positivity)] at hT; linarith
    push_cast at h2
    nlinarith
  have real_eq : ∀ (a b q : ℝ), 0 ≤ a → 0 < b →
      (∀ t : ℕ, 1 ≤ t → a ^ (4 * t) ≤ q * b ^ (4 * t) ∧ b ^ (4 * t) ≤ q * a ^ (4 * t)) →
      a = b := by
    intro a b q ha hb H
    have ha0 : 0 < a := by
      rcases ha.lt_or_eq with h0 | h0
      · exact h0
      · exfalso
        have h3 := (H 1 le_rfl).2
        rw [← h0, zero_pow (by norm_num), mul_zero] at h3
        have h4 : 0 < b ^ (4 * 1) := pow_pos hb _
        linarith
    rcases lt_trichotomy a b with h0 | h0 | h0
    · exact (key q a b ha0 h0 (fun t ht => (H t ht).2)).elim
    · exact h0
    · exact (key q b a hb h0 (fun t ht => (H t ht).1)).elim

  have pair : ∀ {r r' : ℕ} (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (B : Matrix (Fin r') (Fin r') ℚ_[ℓ])
      (P : Matrix (Fin r) (Fin r') ℚ_[ℓ]) (c : ℚ_[ℓ]), c ≠ 0 →
      (∀ v : Fin r → ℚ_[ℓ], Matrix.vecMul v P = 0 → v = 0) → A.transpose * P * B = c • P →
      ∀ μ ∈ A.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
        μ ≠ 0 ∧ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) c / μ ∈
          B.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    intro r r' A B P c hc hP hrel μ hμ
    set f : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ] := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hf
    set Q := P.transpose with hQdef
    have hker : LinearMap.ker (Matrix.toLin' Q) = ⊥ := by
      rw [LinearMap.ker_eq_bot']
      intro v hv
      rw [Matrix.toLin'_apply, hQdef, Matrix.mulVec_transpose] at hv
      exact hP v hv
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective _ hker
    have hGQ : LinearMap.toMatrix' g * Q = 1 := by
      have := congrArg LinearMap.toMatrix' hg
      rwa [LinearMap.toMatrix'_comp, LinearMap.toMatrix'_toLin', LinearMap.toMatrix'_id] at this
    have hGQL : (LinearMap.toMatrix' g).map f * Q.map f = 1 := by
      rw [← Matrix.map_mul, hGQ, Matrix.map_one _ (map_zero f) (map_one f)]
    have hrel' : B.transpose * Q * A = c • Q := by
      have := congrArg Matrix.transpose hrel
      rw [Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_transpose,
        Matrix.transpose_smul] at this
      rw [hQdef, Matrix.mul_assoc]
      exact this
    have hrelL : B.transpose.map f * Q.map f * A.map f = f c • Q.map f := by
      rw [← Matrix.map_mul, ← Matrix.map_mul, hrel']
      ext x y
      simp
    rw [Polynomial.mem_aroots] at hμ
    obtain ⟨_, hμ⟩ := hμ
    have hdet : (Matrix.scalar (Fin r) μ - A.map f).det = 0 := by
      rw [← Matrix.eval_charpoly, Matrix.charpoly_map, Polynomial.eval_map, ← Polynomial.aeval_def]
      exact hμ
    obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hAv : (A.map f).mulVec v = μ • v := by
      rw [Matrix.sub_mulVec, sub_eq_zero] at hv
      rw [← hv, Matrix.scalar_apply]
      ext x
      simp [Matrix.mulVec_diagonal]
    have hw0 : (Q.map f).mulVec v ≠ 0 := by
      intro h0
      apply hv0
      have e1 : ((LinearMap.toMatrix' g).map f).mulVec ((Q.map f).mulVec v) = v := by
        rw [Matrix.mulVec_mulVec, hGQL, Matrix.one_mulVec]
      rw [← e1, h0, Matrix.mulVec_zero]
    have hBw : μ • (B.transpose.map f).mulVec ((Q.map f).mulVec v) = f c • (Q.map f).mulVec v := by
      have h5 : (B.transpose.map f * Q.map f * A.map f).mulVec v = (f c • Q.map f).mulVec v := by
        rw [hrelL]
      rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hAv, Matrix.mulVec_smul,
        Matrix.mulVec_smul, Matrix.smul_mulVec] at h5
      exact h5
    have hfc : f c ≠ 0 := (map_ne_zero f).mpr hc
    have hμ0 : μ ≠ 0 := by
      intro h0
      rw [h0, zero_smul] at hBw
      exact hw0 ((smul_eq_zero.mp hBw.symm).resolve_left hfc)
    refine ⟨hμ0, ?_⟩
    have hBw' : (B.transpose.map f).mulVec ((Q.map f).mulVec v) =
        (f c / μ) • (Q.map f).mulVec v := by
      rw [div_eq_inv_mul, mul_smul, ← hBw, smul_smul, inv_mul_cancel₀ hμ0, one_smul]
    have hdet' : (Matrix.scalar (Fin r') (f c / μ) - B.transpose.map f).det = 0 := by
      apply Matrix.exists_mulVec_eq_zero_iff.mp
      refine ⟨(Q.map f).mulVec v, hw0, ?_⟩
      rw [Matrix.sub_mulVec, hBw', Matrix.scalar_apply, sub_eq_zero]
      ext x
      simp [Matrix.mulVec_diagonal]
    rw [Polynomial.mem_aroots]
    refine ⟨(Matrix.charpoly_monic B).ne_zero, ?_⟩
    rw [Polynomial.aeval_def, ← Polynomial.eval_map, ← Matrix.charpoly_map,
      ← Matrix.charpoly_transpose (B.map f), ← Matrix.transpose_map, Matrix.eval_charpoly]
    exact hdet'
  have hq2 : 2 ≤ Nat.card F' := Finite.one_lt_card
  have hqpos : (0 : ℝ) < (Nat.card F' : ℝ) := by exact_mod_cast (by omega : 0 < Nat.card F')

  have hG : ∀ i : ℕ, d ≤ i → ∀ (r : ℕ) (e : wcCoh F' Y h ℓ i ≃+ (Fin r → ℚ_[ℓ])),
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F' Y h ℓ i), e (wcCohScalar F' Y h ℓ i c x) = c • e x) →
      ∀ μ ∈ (wcAddEquivMatrix e (wcCohFrob F' Y h ℓ i)).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
      ∀ ι : AlgebraicClosure ℚ_[ℓ] ≃+* ℂ, ‖ι μ‖ = √((Nat.card F' : ℝ) ^ i) := by
    intro i hdi r e he μ hμ ι
    obtain ⟨W, _, _, _, p, s, hsp, N', jW, hjW, hjWY⟩ :=
      wc_product_projective_space F' Y d N j hj hjY i hdi
    have hW : WeaklyEtale (Limits.pullback.fst W.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :=
      MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
        (wc_weaklyEtale_algebraicClosure F')
    obtain ⟨ψ, hψ, hψs, hψΦ⟩ := wc_pullback_retract_injective F' Y W p s hsp ℓ h hW i
    obtain ⟨rW, eW, heW⟩ := wc_coh_finite F' W i ℓ hℓ hW i
    obtain ⟨P, hPinj, hPA⟩ := s5 e eW (wcCohScalar F' Y h ℓ i) (wcCohScalar F' W hW ℓ i) he heW
      (wcCohFrob F' Y h ℓ i) (wcCohFrob F' W hW ℓ i) (s6 F' Y h i) (s6 F' W hW i) ψ hψ hψs 1
      (fun x => by rw [Function.iterate_one]; exact hψΦ x)
    have hμW : μ ∈ (wcAddEquivMatrix eW (wcCohFrob F' W hW ℓ i)).charpoly.aroots
        (AlgebraicClosure ℚ_[ℓ]) := by
      have := s4 1 _ _ P hPinj hPA μ hμ
      rwa [pow_one] at this
    have hqi : (0 : ℝ) ≤ (Nat.card F' : ℝ) ^ i := by positivity
    have hbpos : 0 < √((Nat.card F' : ℝ) ^ i) := Real.sqrt_pos.mpr (pow_pos hqpos i)
    have hbound : ∀ t : ℕ, 1 ≤ t →
        ‖ι μ‖ ^ (4 * t) ≤ (Nat.card F' : ℝ) * √((Nat.card F' : ℝ) ^ i) ^ (4 * t) ∧
        √((Nat.card F' : ℝ) ^ i) ^ (4 * t) ≤ (Nat.card F' : ℝ) * ‖ι μ‖ ^ (4 * t) := by
      intro t ht
      obtain ⟨V, _, _, _, N'', jV, hjV, hjVW, hkun⟩ :=
        wc_kunneth_power_eigen F' W i N' jW hjW hjWY ℓ hℓ hW (2 * t) (by omega)
      have hV : WeaklyEtale (Limits.pullback.fst V.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F'))))) :=
        MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
          (wc_weaklyEtale_algebraicClosure F')
      obtain ⟨rV, eV, heV⟩ := wc_coh_finite F' V (2 * t * i) ℓ hℓ hV (2 * t * i)
      have hμk := hkun hV rW eW heW rV eV heV μ hμW
      have hb := wc_middle_weak_bound F' V (2 * t * i) ⟨t * i, by ring⟩ N'' jV hjV hjVW ℓ hℓ hV
        rV eV heV (μ ^ (2 * t)) hμk ι
      rw [map_pow, norm_pow, ← pow_mul] at hb
      have e1 : 2 * t * 2 = 4 * t := by ring
      have e2 : √((Nat.card F' : ℝ) ^ i) ^ (4 * t) = (Nat.card F' : ℝ) ^ (2 * t * i) := by
        rw [show 4 * t = 2 * (2 * t) by ring, pow_mul, Real.sq_sqrt hqi, ← pow_mul,
          mul_comm i (2 * t)]
      rw [e1] at hb
      rw [e2]
      exact ⟨hb.2, hb.1⟩
    exact real_eq ‖ι μ‖ _ _ (norm_nonneg _) hbpos hbound

  intro i hi r e he μ hμ ι
  rcases le_or_gt d i with hdi | hid
  ·
    exact hG i hdi r e he μ hμ ι
  ·
    obtain ⟨hone, htop⟩ := wc_top_coh_frobenius F' Y d ℓ hℓ h
    obtain ⟨r', e', he'⟩ := wc_coh_finite F' Y d ℓ hℓ h (2 * d - i)
    obtain ⟨P, hPB, hPl, _⟩ := wc_poincare_duality F' Y d ℓ hℓ h hone htop i hi r r' e e' he he'
    have hc : ((Nat.card F' : ℚ_[ℓ]) ^ d) ≠ 0 :=
      pow_ne_zero _ (Nat.cast_ne_zero.mpr (by omega))
    obtain ⟨hμ0, hν⟩ := pair _ _ P _ hc hPl hPB μ hμ
    have hν' := hG (2 * d - i) (by omega) r' e' he' _ hν ι
    rw [map_div₀] at hν'
    have hιc : ι (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F' : ℚ_[ℓ]) ^ d)) =
        (Nat.card F' : ℂ) ^ d := by
      simp only [map_pow, map_natCast]
    rw [hιc, norm_div, norm_pow, Complex.norm_natCast] at hν'
    have hιμ : ι μ ≠ 0 := (map_ne_zero ι).mpr hμ0
    have hpos : 0 < ‖ι μ‖ := norm_pos_iff.mpr hιμ
    have hs : 0 < √((Nat.card F' : ℝ) ^ (2 * d - i)) := Real.sqrt_pos.mpr (pow_pos hqpos _)
    have k1 : (Nat.card F' : ℝ) ^ d = ‖ι μ‖ * √((Nat.card F' : ℝ) ^ (2 * d - i)) := by
      rw [div_eq_iff hpos.ne'] at hν'
      rw [hν', mul_comm]
    have k2 : √((Nat.card F' : ℝ) ^ i) * √((Nat.card F' : ℝ) ^ (2 * d - i)) =
        (Nat.card F' : ℝ) ^ d := by
      rw [← Real.sqrt_mul (by positivity), ← pow_add, show i + (2 * d - i) = d * 2 by omega,
        pow_mul, Real.sqrt_sq (by positivity)]
    exact mul_right_cancel₀ hs.ne' (k1.symm.trans k2.symm)

theorem wcpa_dj_dim_finite : ∀ (k : Type u) [Field k] (X : Scheme.{u}) [AlgebraicGeometry.IsIntegral X]
    (sX : X ⟶ Spec (.of k)) [IsProper sX], ∃ d : ℕ, topologicalKrullDim X = (d : WithBot ℕ∞) :=
by
  intro k _ X _ sX _
  classical

  have s1 : ∀ (T : Type u) [TopologicalSpace T] {ι : Type u} (U : ι → Set T) (N : ℕ),
      (∀ i, IsOpen (U i)) → (∀ x : T, ∃ i, x ∈ U i) →
      (∀ i, topologicalKrullDim ↥(U i) ≤ (N : WithBot ℕ∞)) →
      topologicalKrullDim T ≤ (N : WithBot ℕ∞) := by
    intro T _ ι U N hU hcov hdim
    show Order.krullDim _ ≤ _
    refine iSup_le (fun p => ?_)
    obtain ⟨x, hx⟩ := (p 0).isIrreducible.nonempty
    obtain ⟨i, hi⟩ := hcov x
    have hemb := (hU i).isOpenEmbedding_subtypeVal
    have hxj : ∀ j, x ∈ (p j : Set T) := fun j =>
      (SetLike.coe_subset_coe.mpr (p.monotone (Fin.zero_le j))) hx
    let q : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds ↥(U i) := fun j =>
      ⟨Subtype.val ⁻¹' (p j : Set T),
        (p j).isIrreducible.preimage hemb ⟨x, hxj j, by rw [Subtype.range_coe]; exact hi⟩,
        (p j).isClosed.preimage continuous_subtype_val⟩
    have hq : StrictMono q := by
      rw [Fin.strictMono_iff_lt_succ]
      intro j
      have hab : p (Fin.castSucc j) < p j.succ := p.step j
      have hab' : (p (Fin.castSucc j) : Set T) ⊂ p j.succ := SetLike.coe_ssubset_coe.mpr hab
      rw [← SetLike.coe_ssubset_coe]
      show Subtype.val ⁻¹' (p (Fin.castSucc j) : Set T) ⊂ Subtype.val ⁻¹' (p j.succ : Set T)
      refine ⟨Set.preimage_mono hab'.1, fun hsub => hab'.2 ?_⟩
      have h1 : (p j.succ : Set T) ∩ U i ⊆ (p (Fin.castSucc j) : Set T) := by
        intro y ⟨hyB, hyU⟩
        exact hsub (show (⟨y, hyU⟩ : U i) ∈ Subtype.val ⁻¹' (p j.succ : Set T) from hyB)
      have h2 : (p j.succ : Set T) ⊆ closure ((p j.succ : Set T) ∩ U i) :=
        subset_closure_inter_of_isPreirreducible_of_isOpen (p j.succ).isIrreducible.isPreirreducible
          (hU i) ⟨x, hxj _, hi⟩
      exact h2.trans (closure_minimal h1 (p (Fin.castSucc j)).isClosed)
    exact (Order.LTSeries.length_le_krullDim (LTSeries.mk p.length q hq) :
      (p.length : WithBot ℕ∞) ≤ topologicalKrullDim (U i)).trans (hdim i)

  have s2 : ∀ (A : Type u) [CommRing A] (f : k →+* A), f.FiniteType →
      ∃ n : ℕ, ringKrullDim A ≤ (n : WithBot ℕ∞) := by
    intro A _ f hf
    letI := f.toAlgebra
    haveI : Algebra.FiniteType k A := hf
    obtain ⟨n, g, hg⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp this
    refine ⟨n, ?_⟩
    calc ringKrullDim A ≤ ringKrullDim (MvPolynomial (Fin n) k) :=
          ringKrullDim_le_of_surjective (g : MvPolynomial (Fin n) k →+* A) hg
      _ = (n : WithBot ℕ∞) := by
        rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
          ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add]
        rfl

  have s3 : ∀ (U : X.Opens), IsAffineOpen U →
      ∃ n : ℕ, topologicalKrullDim ↥(U : Set X) ≤ (n : WithBot ℕ∞) := by
    intro U hU
    have e1 : topologicalKrullDim ↥(Spec Γ(X, U)) = topologicalKrullDim ↥(U : Set X) :=
      IsHomeomorph.topologicalKrullDim_eq _
        ((Scheme.Hom.isOpenEmbedding hU.fromSpec).isEmbedding.toHomeomorph.trans
          (Homeomorph.setCongr hU.range_fromSpec)).isHomeomorph
    have e2 : topologicalKrullDim ↥(Spec Γ(X, U)) = ringKrullDim Γ(X, U) :=
      PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim _
    obtain ⟨n, hn⟩ := s2 Γ(X, U) _
      (RingHom.FiniteType.comp (LocallyOfFiniteType.finiteType_appLE sX
        (isAffineOpen_top (Spec (.of k))) hU (by rw [Scheme.Hom.preimage_top]; exact le_top))
        (RingHom.FiniteType.of_surjective _
          (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of k)).inv).2))
    exact ⟨n, by rw [← e1, e2]; exact hn⟩

  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace sX
  have hnb : ∀ x : X, ∃ V : X.Opens, IsAffineOpen V ∧ x ∈ V := by
    intro x
    obtain ⟨V, hV, hxV, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens X)) (show x ∈ (⊤ : X.Opens) from trivial)
    exact ⟨V, hV, hxV⟩
  choose V hV hxV using hnb
  choose n hn using fun x => s3 (V x) (hV x)
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover (fun x => (V x : Set X))
    (fun x => (V x).isOpen) (fun y _ => Set.mem_iUnion.mpr ⟨y, hxV y⟩)
  have hup : topologicalKrullDim X ≤ ((t.sup n : ℕ) : WithBot ℕ∞) := by
    refine s1 X (ι := ↥t) (fun i => (V i.1 : Set X)) (t.sup n) (fun i => (V i.1).isOpen) ?_ ?_
    · intro y
      have := ht (Set.mem_univ y)
      simp only [Set.mem_iUnion] at this
      obtain ⟨x, hx, hy⟩ := this
      exact ⟨⟨x, hx⟩, hy⟩
    · intro i
      exact (hn i.1).trans (Nat.cast_le.mpr (Finset.le_sup i.2))
  haveI : Nonempty (TopologicalSpace.IrreducibleCloseds X) :=
    ⟨⟨Set.univ, IrreducibleSpace.isIrreducible_univ X, isClosed_univ⟩⟩
  have hlo : (0 : WithBot ℕ∞) ≤ topologicalKrullDim X := Order.krullDim_nonneg
  generalize topologicalKrullDim X = D at hup hlo ⊢
  induction D using WithBot.recBotCoe with
  | bot => exact absurd hlo (by simp)
  | coe e =>
    induction e using ENat.recTopCoe with
    | top =>
      exfalso
      rw [← WithBot.coe_natCast, WithBot.coe_le_coe, top_le_iff] at hup
      exact ENat.natCast_ne_top _ hup
    | coe d => exact ⟨d, rfl⟩

theorem wcpa_dj_proj_proper : ∀ (k : Type u) [Field k] {Y : Scheme.{u}} (s : Y ⟶ Spec (.of k)),
    wcpaDjIsProjOver k s → IsProper s :=
by
  intro k _ Y s hs
  obtain ⟨N, j, hj, rfl⟩ := hs
  haveI := hj
  haveI hst : IsScalarTower k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))
      (MvPolynomial (Fin (N + 1)) k) :=
    IsScalarTower.of_algebraMap_eq
      (S := ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) (fun c => by
        rw [SetLike.GradeZero.algebraMap_apply]
        exact (SetLike.GradeZero.coe_algebraMap
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) c).symm)
  haveI : Algebra.FiniteType (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))
      (MvPolynomial (Fin (N + 1)) k) :=
    Algebra.FiniteType.of_restrictScalars_finiteType k _ _
  haveI : IsProper (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
      MvPolynomial.gradedAlgebra) := inferInstance
  have hkey : ∀ c : k, ((algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) c :
      ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) : MvPolynomial (Fin (N + 1)) k) =
      MvPolynomial.C c := by
    intro c
    rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
  have hbij : Function.Bijective
      (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) := by
    constructor
    · intro a b hab
      have h1 := congrArg (fun x : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) =>
        (x : MvPolynomial (Fin (N + 1)) k)) hab
      simp only [hkey] at h1
      exact MvPolynomial.C_injective _ _ h1
    · intro p
      have hp : (p : MvPolynomial (Fin (N + 1)) k).IsHomogeneous 0 :=
        (MvPolynomial.mem_homogeneousSubmodule _ _).mp p.2
      have htd : (p : MvPolynomial (Fin (N + 1)) k).totalDegree = 0 :=
        Nat.le_zero.mp hp.totalDegree_le
      refine ⟨(p : MvPolynomial (Fin (N + 1)) k).coeff 0, Subtype.ext ?_⟩
      rw [hkey]
      exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp htd).symm
  haveI : IsIso (CommRingCat.ofHom
      (algebraMap k (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)))) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr hbij
  infer_instance

theorem wcpa_dj_alteration_comp : ∀ {X Y W : Scheme.{u}} [AlgebraicGeometry.IsIntegral X]
    [AlgebraicGeometry.IsIntegral Y] (φ : Y ⟶ X) (ψ : W ⟶ Y), IsProper φ → Surjective φ →
    Surjective ψ → (∃ V : X.Opens, V ≠ ⊥ ∧ IsFinite (φ ∣_ V)) →
    (∃ V : Y.Opens, V ≠ ⊥ ∧ IsFinite (ψ ∣_ V)) →
    Surjective (ψ ≫ φ) ∧ ∃ V : X.Opens, V ≠ ⊥ ∧ IsFinite ((ψ ≫ φ) ∣_ V) :=
by
  intro X Y W _ _ φ ψ hφp hφs hψs ⟨V, hV0, hVfin⟩ ⟨V', hV'0, hV'fin⟩
  haveI := hφp
  haveI := hφs
  haveI := hψs
  refine ⟨inferInstance, ?_⟩

  have rmono : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (U U₁ : B.Opens), U ≤ U₁ →
      IsFinite (f ∣_ U₁) → IsFinite (f ∣_ U) := by
    intro A B f U U₁ hUV h
    have hR : MorphismProperty.RespectsIso (@IsFinite : MorphismProperty Scheme.{u}) :=
      MorphismProperty.respectsIso_of_isStableUnderComposition
        (fun _ _ f (_ : MorphismProperty.isomorphisms Scheme f) => (inferInstance : IsFinite f))
    have heq : U₁.ι ''ᵁ (U₁.ι ⁻¹ᵁ U) = U := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hUV
    have e := morphismRestrictRestrict f U₁ (U₁.ι ⁻¹ᵁ U) ≪≫ morphismRestrictEq f heq
    exact (MorphismProperty.arrow_mk_iso_iff (@IsFinite : MorphismProperty Scheme.{u}) e).mp
      inferInstance

  have hgen : ∀ (T : Scheme.{u}) [IrreducibleSpace T] (U : T.Opens), U ≠ ⊥ →
      genericPoint T ∈ U := by
    intro T _ U hU
    obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hU
    exact (genericPoint_specializes x).mem_open U.isOpen hx
  have hηmap : φ (genericPoint Y) = genericPoint X := by
    have h1 := (genericPoint_spec Y).image φ.continuous
    simp only [Set.image_univ_of_surjective φ.surjective, closure_univ] at h1
    have h2 := genericPoint_spec X
    exact h1.eq h2
  have hC : IsClosed (φ '' (V' : Set Y)ᶜ) := φ.isClosedMap _ V'.isOpen.isClosed_compl

  have hnot : genericPoint X ∉ φ '' (V' : Set Y)ᶜ := by
    rintro ⟨z, hz, hzη⟩
    have hηV : genericPoint X ∈ V := hgen X V hV0
    have hzS : z ∈ φ ⁻¹ᵁ V := by rw [Scheme.Hom.mem_preimage, hzη]; exact hηV
    have haS : genericPoint Y ∈ φ ⁻¹ᵁ V := by rw [Scheme.Hom.mem_preimage, hηmap]; exact hηV
    let a : (φ ⁻¹ᵁ V).toScheme := ⟨genericPoint Y, haS⟩
    let b : (φ ⁻¹ᵁ V).toScheme := ⟨z, hzS⟩
    have hab : (φ ∣_ V) a = (φ ∣_ V) b := by
      apply Subtype.ext
      exact (morphismRestrict_base_coe φ V a).trans
        (hηmap.trans (hzη.symm.trans (morphismRestrict_base_coe φ V b).symm))
    have hsp : a ⤳ b := by
      apply ((φ ⁻¹ᵁ V).ι.isOpenEmbedding.isInducing.specializes_iff).mp
      have e1 : (φ ⁻¹ᵁ V).ι a = genericPoint Y := Scheme.Opens.ι_apply _ _
      have e2 : (φ ⁻¹ᵁ V).ι b = z := Scheme.Opens.ι_apply _ _
      rw [e1, e2]
      exact genericPoint_specializes z
    haveI : DiscreteTopology ((φ ∣_ V) ⁻¹' {(φ ∣_ V) a}) :=
      ((φ ∣_ V).isDiscrete_preimage_singleton ((φ ∣_ V) a)).to_subtype
    have hsp' : (⟨a, rfl⟩ : ((φ ∣_ V) ⁻¹' {(φ ∣_ V) a})) ⤳ ⟨b, hab.symm⟩ :=
      (subtype_specializes_iff _ _).mpr hsp
    have hab' : a = b := congrArg Subtype.val hsp'.eq
    have hzY : genericPoint Y = z := congrArg Subtype.val hab'
    exact hz (hzY ▸ hgen Y V' hV'0)
  let O : X.Opens := ⟨(φ '' (V' : Set Y)ᶜ)ᶜ, hC.isOpen_compl⟩
  refine ⟨V ⊓ O, ?_, ?_⟩
  · rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
    exact ⟨genericPoint X, TopologicalSpace.Opens.mem_inf.mpr ⟨hgen X V hV0, hnot⟩⟩
  · rw [morphismRestrict_comp]
    have hle : φ ⁻¹ᵁ (V ⊓ O) ≤ V' := by
      intro y hy
      have hy' : φ y ∈ V ⊓ O := hy
      by_contra hyV
      exact (TopologicalSpace.Opens.mem_inf.mp hy').2 ⟨y, hyV, rfl⟩
    have h1 := rmono ψ _ _ hle hV'fin
    have h2 := rmono φ (V ⊓ O) V inf_le_left hVfin
    exact MorphismProperty.comp_mem (@IsFinite) _ _ h1 h2

theorem wcpa_dj_alteration_dim_eq : ∀ (k : Type u) [Field k] (Y X : Scheme.{u})
    [AlgebraicGeometry.IsIntegral Y] [AlgebraicGeometry.IsIntegral X] (sY : Y ⟶ Spec (.of k))
    (sX : X ⟶ Spec (.of k)) [IsProper sY] [IsProper sX] (φ : Y ⟶ X), φ ≫ sX = sY → Surjective φ →
    (∃ V : X.Opens, V ≠ ⊥ ∧ IsFinite (φ ∣_ V)) → topologicalKrullDim Y = topologicalKrullDim X :=
by

  have s1 : ∀ (R S : Type u) [CommRing R] [CommRing S] [Algebra R S] [Algebra.IsIntegral R S],
      Function.Injective (algebraMap R S) → ringKrullDim S = ringKrullDim R := by
    intro R S _ _ _ _ hinj
    apply le_antisymm
    · apply Order.krullDim_le_of_strictMono (PrimeSpectrum.comap (algebraMap R S))
      intro p q hpq
      exact Ideal.IsIntegral.under_lt_under (R := R) (show p.asIdeal < q.asIdeal from hpq)
    · have key : ∀ p : LTSeries (PrimeSpectrum R), ∃ q : LTSeries (PrimeSpectrum S),
          q.length = p.length ∧ q.last.asIdeal.under R = p.last.asIdeal := by
        intro p
        induction p using RelSeries.inductionOn' with
        | singleton P =>
          obtain ⟨Q, -, hQ, hQP⟩ := Ideal.exists_ideal_over_prime_of_isIntegral P.asIdeal
            (⊥ : Ideal S) (by
              rw [Ideal.under, Ideal.comap_bot_of_injective _ hinj]; exact bot_le)
          exact ⟨RelSeries.singleton _ ⟨Q, hQ⟩, rfl, hQP⟩
        | snoc p P' hlt ih =>
          obtain ⟨q, hlen, hlast⟩ := ih
          obtain ⟨Q', hge, hQ', hQ'P⟩ := Ideal.exists_ideal_over_prime_of_isIntegral P'.asIdeal
            q.last.asIdeal (by rw [hlast]; exact le_of_lt hlt)
          have hlt' : q.last < (⟨Q', hQ'⟩ : PrimeSpectrum S) := by
            refine lt_of_le_of_ne hge ?_
            intro heq
            have h1 : q.last.asIdeal = Q' := congrArg PrimeSpectrum.asIdeal heq
            have h2 : p.last.asIdeal = P'.asIdeal := by rw [← hlast, ← hQ'P, h1]
            exact (ne_of_lt hlt) (PrimeSpectrum.ext h2)
          exact ⟨q.snoc ⟨Q', hQ'⟩ hlt', by simp [hlen], by simpa using hQ'P⟩
      unfold ringKrullDim Order.krullDim
      apply iSup_le
      intro p
      obtain ⟨q, hlen, -⟩ := key p
      rw [← hlen]
      exact Order.LTSeries.length_le_krullDim q

  have s2 : ∀ (k A : Type u) [Field k] [CommRing A] [IsDomain A] [Algebra k A] (s : ℕ)
      (g : MvPolynomial (Fin s) k →ₐ[k] A), Function.Injective g → g.Finite →
      Algebra.trdeg k A = s := by
    intro k A _ _ _ _ s g hg hfin
    letI : Algebra (MvPolynomial (Fin s) k) A := g.toRingHom.toAlgebra
    haveI : IsScalarTower k (MvPolynomial (Fin s) k) A :=
      IsScalarTower.of_algebraMap_eq' (g.comp_algebraMap).symm
    haveI : FaithfulSMul k (MvPolynomial (Fin s) k) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr (MvPolynomial.C_injective _ _)
    haveI : FaithfulSMul (MvPolynomial (Fin s) k) A :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr hg
    haveI : Module.Finite (MvPolynomial (Fin s) k) A := hfin
    haveI : Algebra.IsIntegral (MvPolynomial (Fin s) k) A := Algebra.IsIntegral.of_finite _ _
    have h0 : Algebra.trdeg (MvPolynomial (Fin s) k) A = 0 :=
      trdeg_eq_zero_iff.mpr Algebra.IsIntegral.isAlgebraic
    have h1 := lift_trdeg_add_eq k (MvPolynomial (Fin s) k) A
    rw [Cardinal.lift_id, Cardinal.lift_id, Cardinal.lift_id, h0, add_zero,
      MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fin, Cardinal.lift_natCast] at h1
    exact h1.symm

  have s7 : ∀ (k A : Type u) [Field k] [CommRing A] [IsDomain A] [Algebra k A]
      [Algebra.FiniteType k A],
      ∃ n : ℕ, ringKrullDim A = (n : WithBot ℕ∞) ∧ Algebra.trdeg k A = (n : Cardinal.{u}) := by
    intro k A _ _ _ _ _
    obtain ⟨s, g, hg, hfin⟩ := exists_finite_inj_algHom_of_fg k A
    refine ⟨s, ?_, s2 k A s g hg hfin⟩
    letI : Algebra (MvPolynomial (Fin s) k) A := g.toRingHom.toAlgebra
    haveI : Module.Finite (MvPolynomial (Fin s) k) A := hfin
    haveI : Algebra.IsIntegral (MvPolynomial (Fin s) k) A := Algebra.IsIntegral.of_finite _ _
    rw [s1 (MvPolynomial (Fin s) k) A hg, MvPolynomial.ringKrullDim_of_isNoetherianRing,
      ringKrullDim_eq_zero_of_field, ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add]
    rfl

  have s4 : ∀ (T : Type u) [TopologicalSpace T] (n : WithBot ℕ∞),
      (∀ x : T, ∃ W : Set T, IsOpen W ∧ x ∈ W ∧ topologicalKrullDim W ≤ n) →
      topologicalKrullDim T ≤ n := by
    intro T _ n H
    unfold topologicalKrullDim Order.krullDim
    apply iSup_le
    intro p
    obtain ⟨x, hx⟩ := (p 0).isIrreducible.nonempty
    obtain ⟨W, hWo, hxW, hWd⟩ := H x
    have hmem : ∀ i, x ∈ (p i : Set T) := fun i =>
      (p.monotone (Fin.zero_le i)) hx
    let f : Fin (p.length + 1) → TopologicalSpace.IrreducibleCloseds W := fun i =>
      ⟨Subtype.val ⁻¹' (p i : Set T),
          (p i).isIrreducible.preimage (hWo.isOpenEmbedding_subtypeVal)
            ⟨x, hmem i, ⟨⟨x, hxW⟩, rfl⟩⟩,
          (p i).isClosed.preimage continuous_subtype_val⟩
    have hf : ∀ i, (f i : Set W) = Subtype.val ⁻¹' (p i : Set T) := fun i => rfl
    have hstep : ∀ i : Fin p.length, f i.castSucc < f i.succ := by
      intro i
      have hlt : p i.castSucc < p i.succ := p.step i
      have hle : (p i.castSucc : Set T) ⊆ (p i.succ : Set T) := le_of_lt hlt
      refine lt_of_le_of_ne ?_ ?_
      · show (f i.castSucc : Set W) ⊆ (f i.succ : Set W)
        rw [hf, hf]
        exact Set.preimage_mono hle
      · intro heq
        apply (ne_of_lt hlt)
        have heq' : (Subtype.val : W → T) ⁻¹' (p i.castSucc : Set T) =
            (Subtype.val : W → T) ⁻¹' (p i.succ : Set T) := by
          rw [← hf, ← hf, heq]
        apply le_antisymm (le_of_lt hlt)
        show (p i.succ : Set T) ⊆ (p i.castSucc : Set T)
        intro y hy
        have h1 : (p i.succ : Set T) ⊆ closure ((p i.succ : Set T) ∩ W) :=
          subset_closure_inter_of_isPreirreducible_of_isOpen
            (p i.succ).isIrreducible.isPreirreducible hWo ⟨x, hmem _, hxW⟩
        have h2 : (p i.succ : Set T) ∩ W ⊆ (p i.castSucc : Set T) := by
          rintro z ⟨hz1, hz2⟩
          have : (⟨z, hz2⟩ : W) ∈ Subtype.val ⁻¹' (p i.succ : Set T) := hz1
          rw [← heq'] at this
          exact this
        exact (closure_minimal h2 (p i.castSucc).isClosed) (h1 hy)
    let q : LTSeries (TopologicalSpace.IrreducibleCloseds W) :=
      { length := p.length
        toFun := f
        step := hstep }
    have := Order.LTSeries.length_le_krullDim q
    exact le_trans this hWd

  have s5 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (V : Y.Opens), IsFinite (f ∣_ V) →
      ∀ U : Y.Opens, IsAffineOpen U → U ≤ V → IsAffineOpen (f ⁻¹ᵁ U) ∧ (f.app U).hom.Finite := by
    intro X Y f V hf U hU hUV
    have hU' : IsAffineOpen (V.ι ⁻¹ᵁ U) :=
      hU.preimage_of_isOpenImmersion V.ι (by rw [Scheme.Opens.opensRange_ι]; exact hUV)
    have himg : V.ι ''ᵁ (V.ι ⁻¹ᵁ U) = U := by
      rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι]
      exact inf_eq_right.mpr hUV
    have key : ∀ y, V.ι ((f ∣_ V) y) = f ((f ⁻¹ᵁ V).ι y) := fun y => by
      rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
    have hpre : (f ⁻¹ᵁ V).ι ''ᵁ ((f ∣_ V) ⁻¹ᵁ (V.ι ⁻¹ᵁ U)) = f ⁻¹ᵁ U := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        show f ((f ⁻¹ᵁ V).ι y) ∈ U
        rw [← key]
        exact hy
      · intro hx
        have hxV : x ∈ f ⁻¹ᵁ V := hUV hx
        obtain ⟨y, hy⟩ : ∃ y, (f ⁻¹ᵁ V).ι y = x := ⟨⟨x, hxV⟩, rfl⟩
        refine ⟨y, ?_, hy⟩
        show V.ι ((f ∣_ V) y) ∈ U
        rw [key, hy]
        exact hx
    have hfa := IsFinite.finite_app (f ∣_ V) (V.ι ⁻¹ᵁ U) hU'
    rw [morphismRestrict_app'] at hfa
    constructor
    · have h1 : IsAffineOpen ((f ∣_ V) ⁻¹ᵁ (V.ι ⁻¹ᵁ U)) :=
        IsAffineHom.isAffine_preimage _ hU'
      have h2 := h1.image_of_isOpenImmersion (f ⁻¹ᵁ V).ι
      rw [hpre] at h2
      exact h2
    · have gen : ∀ (W : Y.Opens) (W' : X.Opens) (hW : W = U) (hW' : W' = f ⁻¹ᵁ U)
          (e : W' ≤ f ⁻¹ᵁ W), (f.appLE W W' e).hom.Finite → (f.app U).hom.Finite := by
        rintro W W' rfl rfl e h
        rw [Scheme.Hom.app_eq_appLE]
        exact h
      exact gen _ _ himg hpre _ hfa

  have s6 : ∀ (k : Type u) [Field k] (T : Scheme.{u}) (s : T ⟶ Spec (.of k))
      [LocallyOfFiniteType s] (U : T.Opens), IsAffineOpen U →
      ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ s.appTop ≫
        T.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.FiniteType := by
    intro k _ T s _ U hU
    have h := HasRingHomProperty.appLE @LocallyOfFiniteType s inferInstance
      ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ (by simp)
    have e : s.appTop ≫ T.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op =
        s.appLE ⊤ U (by simp) := rfl
    rw [e, CommRingCat.hom_comp]
    refine RingHom.FiniteType.comp h (RingHom.FiniteType.of_surjective _ ?_)
    intro x
    refine ⟨(Scheme.ΓSpecIso (CommRingCat.of k)).hom x, ?_⟩
    rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]

  have s3 : ∀ (F : Type u) [Field F] (W : Scheme.{u}) [AlgebraicGeometry.IsIntegral W]
      (s : W ⟶ Spec (.of F)) (U : W.Opens), IsAffineOpen U → U ≠ ⊥ →
      @Algebra.trdeg F Γ(W, U) _ _ ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ s.appTop ≫
        W.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.toAlgebra =
      @Algebra.trdeg F W.functionField _ _ ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ s.appTop ≫
        W.presheaf.germ ⊤ (genericPoint W) trivial).hom.toAlgebra := by
    intro F _ W _ s U hU hne
    haveI : Nonempty U := by
      obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hne
      exact ⟨⟨x, hx⟩⟩
    letI iA : Algebra F Γ(W, U) := ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ s.appTop ≫
        W.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.toAlgebra
    letI iK : Algebra F W.functionField := ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ s.appTop ≫
        W.presheaf.germ ⊤ (genericPoint W) trivial).hom.toAlgebra
    haveI : IsFractionRing Γ(W, U) W.functionField :=
      functionField_isFractionRing_of_isAffineOpen W U hU
    haveI : IsScalarTower F Γ(W, U) W.functionField := by
      apply IsScalarTower.of_algebraMap_eq'
      show ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ s.appTop ≫
        W.presheaf.germ ⊤ (genericPoint W) trivial).hom =
        (W.germToFunctionField U).hom.comp ((Scheme.ΓSpecIso (CommRingCat.of F)).inv ≫ s.appTop ≫
        W.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
      rw [← CommRingCat.hom_comp]
      congr 1
      rw [Category.assoc, Category.assoc, Scheme.germToFunctionField, TopCat.Presheaf.germ_res]
    haveI : FaithfulSMul F Γ(W, U) :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr (RingHom.injective _)
    haveI : FaithfulSMul Γ(W, U) W.functionField :=
      (faithfulSMul_iff_algebraMap_injective _ _).mpr (IsFractionRing.injective _ _)
    have h0 : Algebra.trdeg Γ(W, U) W.functionField = 0 :=
      trdeg_eq_zero_iff.mpr (IsLocalization.isAlgebraic _ (nonZeroDivisors Γ(W, U)))
    have h1 := lift_trdeg_add_eq F Γ(W, U) W.functionField
    rw [Cardinal.lift_id, Cardinal.lift_id, Cardinal.lift_id, h0, add_zero] at h1
    exact h1

  have s8 : ∀ (k : Type u) [Field k] (T : Scheme.{u}) [AlgebraicGeometry.IsIntegral T]
      (s : T ⟶ Spec (.of k)) [LocallyOfFiniteType s], ∃ n : ℕ,
      (∀ U : T.Opens, IsAffineOpen U → U ≠ ⊥ → ringKrullDim Γ(T, U) = (n : WithBot ℕ∞)) ∧
      topologicalKrullDim T = (n : WithBot ℕ∞) := by
    intro k _ T _ s _
    have hnU : ∀ U : T.Opens, IsAffineOpen U → U ≠ ⊥ → ∃ m : ℕ,
        ringKrullDim Γ(T, U) = (m : WithBot ℕ∞) ∧
        @Algebra.trdeg k Γ(T, U) _ _ ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ s.appTop ≫
          T.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.toAlgebra = (m : Cardinal.{u}) := by
      intro U hU hne
      haveI : Nonempty U := by
        obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mp hne
        exact ⟨⟨x, hx⟩⟩
      haveI : IsDomain Γ(T, U) := IsIntegral.component_integral U
      letI : Algebra k Γ(T, U) := ((Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ s.appTop ≫
          T.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.toAlgebra
      haveI : Algebra.FiniteType k Γ(T, U) := s6 k T s U hU
      exact s7 k Γ(T, U)
    have hdimU : ∀ U : T.Opens, IsAffineOpen U →
        topologicalKrullDim (U : Set T) = ringKrullDim Γ(T, U) := fun U hU =>
      (IsHomeomorph.topologicalKrullDim_eq _ (Scheme.homeoOfIso hU.isoSpec).isHomeomorph).trans
        (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim Γ(T, U))
    obtain ⟨x₀⟩ := (AlgebraicGeometry.IsIntegral.nonempty : Nonempty T)
    obtain ⟨U₀, hU₀, hx₀, -⟩ :=
      exists_isAffineOpen_mem_and_subset (show x₀ ∈ (⊤ : T.Opens) from trivial)
    have hU₀ne : U₀ ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U₀).mpr ⟨x₀, hx₀⟩
    obtain ⟨n, hn1, hn2⟩ := hnU U₀ hU₀ hU₀ne
    have hall : ∀ U : T.Opens, IsAffineOpen U → U ≠ ⊥ →
        ringKrullDim Γ(T, U) = (n : WithBot ℕ∞) := by
      intro U hU hne
      obtain ⟨m, hm1, hm2⟩ := hnU U hU hne
      have h3 := (s3 k T s U hU hne).trans (s3 k T s U₀ hU₀ hU₀ne).symm
      rw [hm2, hn2] at h3
      have hmn : m = n := by exact_mod_cast h3
      rw [hm1, hmn]
    refine ⟨n, hall, le_antisymm ?_ ?_⟩
    · apply s4 T (n : WithBot ℕ∞)
      intro x
      obtain ⟨W, hW, hxW, -⟩ :=
        exists_isAffineOpen_mem_and_subset (show x ∈ (⊤ : T.Opens) from trivial)
      refine ⟨W, W.isOpen, hxW, ?_⟩
      rw [hdimU W hW, hall W hW ((TopologicalSpace.Opens.ne_bot_iff_nonempty W).mpr ⟨x, hxW⟩)]
    · rw [← hn1, ← hdimU U₀ hU₀]
      exact topologicalKrullDim_subspace_le T U₀

  intro k _ Y X _ _ sY sX _ _ φ _ hsurj hV
  obtain ⟨V, hV, hfin⟩ := hV
  obtain ⟨x, hx⟩ := (TopologicalSpace.Opens.ne_bot_iff_nonempty V).mp hV
  obtain ⟨U, hU, hxU, hUV⟩ := exists_isAffineOpen_mem_and_subset hx
  obtain ⟨hU', hfinU⟩ := s5 φ V hfin U hU hUV
  obtain ⟨y, hy⟩ := φ.surjective x
  have hUne : U ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty U).mpr ⟨x, hxU⟩
  have hU'ne : φ ⁻¹ᵁ U ≠ ⊥ := (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr
    ⟨y, (Scheme.Hom.mem_preimage φ).mpr (hy ▸ hxU)⟩
  haveI := isReduced_of_isIntegral X
  have hinj : Function.Injective (φ.app U).hom := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    have hb : X.basicOpen a = ⊥ := by
      have h1 := Scheme.preimage_basicOpen φ a
      have ha' : (ConcreteCategory.hom (φ.app U)) a = 0 := ha
      rw [ha', Scheme.basicOpen_zero] at h1
      rw [eq_bot_iff]
      intro x' hx'
      obtain ⟨y', hy'⟩ := φ.surjective x'
      have h2 : y' ∈ φ ⁻¹ᵁ X.basicOpen a := (Scheme.Hom.mem_preimage φ).mpr (hy' ▸ hx')
      rw [h1] at h2
      simp at h2
    exact (basicOpen_eq_bot_iff a).mp hb
  letI : Algebra Γ(X, U) Γ(Y, φ ⁻¹ᵁ U) := (φ.app U).hom.toAlgebra
  haveI : Module.Finite Γ(X, U) Γ(Y, φ ⁻¹ᵁ U) := hfinU
  haveI : Algebra.IsIntegral Γ(X, U) Γ(Y, φ ⁻¹ᵁ U) := Algebra.IsIntegral.of_finite _ _
  have hdim := s1 Γ(X, U) Γ(Y, φ ⁻¹ᵁ U) hinj
  obtain ⟨nY, hY1, hY2⟩ := s8 k Y sY
  obtain ⟨nX, hX1, hX2⟩ := s8 k X sX
  rw [hY2, hX2, ← hY1 _ hU' hU'ne, ← hX1 _ hU hUne]
  exact hdim

theorem wcpa_dj_base_case : ∀ (k : Type u) [Field k] [Finite k] (X : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X] (sX : X ⟶ Spec (.of k)) [IsProper sX],
    topologicalKrullDim X = ((0 : ℕ) : WithBot ℕ∞) →
    ∀ E : Set X, IsClosed E → E ≠ Set.univ → wcpaDjSNCAlteration k X sX E :=
by
  intro k _ _ X _ sX _ hdim E hE hEne
  classical

  have hpt : ∀ x : X, x = genericPoint X := by
    have hle : Order.krullDim (TopologicalSpace.IrreducibleCloseds X) ≤ 0 := by
      have h0 : topologicalKrullDim X = Order.krullDim (TopologicalSpace.IrreducibleCloseds X) := rfl
      rw [← h0, hdim, Nat.cast_zero]
    have hmax := Order.krullDim_nonpos_iff_forall_isMax.mp hle
    intro x
    let Z₁ : TopologicalSpace.IrreducibleCloseds X :=
      ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
    let Z₂ : TopologicalSpace.IrreducibleCloseds X :=
      ⟨Set.univ, IrreducibleSpace.isIrreducible_univ X, isClosed_univ⟩
    have h12 : Z₁ ≤ Z₂ := fun _ _ => Set.mem_univ _
    have h21 : Z₂ ≤ Z₁ := hmax Z₁ h12
    have hcl : closure ({x} : Set X) = Set.univ := Set.univ_subset_iff.mp h21
    have hg : IsGenericPoint x Set.univ := hcl
    exact hg.eq (genericPoint_spec X)

  have hEempty : ∀ z : X, z ∉ E := by
    intro z hz
    apply hEne
    apply Set.eq_univ_of_forall
    intro x
    rw [hpt x, ← hpt z]
    exact hz

  have hfield : ∀ y : X, IsField (X.presheaf.stalk y) := by
    intro y
    rw [hpt y]
    exact Field.toIsField X.functionField

  have hreg : ∀ y : X, IsRegularLocalRing (X.presheaf.stalk y) := by
    intro y
    have hF := hfield y
    have hm : IsLocalRing.maximalIdeal (X.presheaf.stalk y) = ⊥ :=
      IsLocalRing.isField_iff_maximalIdeal_eq.mp hF
    have hd : ringKrullDim (X.presheaf.stalk y) = 0 := ringKrullDim_eq_zero_of_isField hF
    haveI : IsNoetherianRing (X.presheaf.stalk y) := by
      refine ⟨fun I => ?_⟩
      by_cases hI : I = ⊥
      · rw [hI]; exact Submodule.fg_bot
      · obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI
        have hxu : IsUnit x := by
          obtain ⟨b, hb⟩ := hF.mul_inv_cancel hx0
          exact ⟨⟨x, b, hb, by rw [mul_comm]; exact hb⟩, rfl⟩
        rw [Ideal.eq_top_of_isUnit_mem I hx hxu]
        exact ⟨{1}, by simp⟩
    exact IsRegularLocalRing.mk (by rw [hm, Submodule.spanFinrank_bot, hd, Nat.cast_zero])

  have hsnc : wcpaDjSNCSet X ∅ := by
    refine ⟨0, fun _ => ∅, fun i => i.elim0, by simp, ?_⟩
    intro y
    refine ⟨0, Fin.elim0, ?_, ?_, fun i => i.1.elim0, fun i => i.1.elim0, fun i => i.1.elim0⟩
    · rw [ringKrullDim_eq_zero_of_isField (hfield y), Nat.cast_zero]
    · rw [Set.range_eq_empty, Ideal.span_empty,
        IsLocalRing.isField_iff_maximalIdeal_eq.mp (hfield y)]

  haveI hAff : IsAffine X := by
    obtain ⟨U, hU, hxU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens X)) (show genericPoint X ∈ (⊤ : X.Opens) from trivial)
    have hUtop : U = ⊤ := eq_top_iff.mpr (fun x _ => by rw [hpt x]; exact hxU)
    have h : IsAffineOpen (⊤ : X.Opens) := hUtop ▸ hU
    haveI : IsAffine (⊤ : X.Opens) := h
    exact IsAffine.of_isIso X.topIso.inv

  obtain ⟨φ₀, hφ₀⟩ : ∃ φ₀ : CommRingCat.of k ⟶ Γ(X, ⊤),
      φ₀ = (Scheme.ΓSpecIso (CommRingCat.of k)).inv ≫ sX.appTop := ⟨_, rfl⟩
  have hfin : φ₀.hom.Finite := by
    rw [hφ₀, CommRingCat.hom_comp]
    refine RingHom.Finite.comp (finite_appTop_of_universallyClosed k sX)
      (RingHom.Finite.of_surjective _ ?_)
    intro y
    exact ⟨(Scheme.ΓSpecIso (CommRingCat.of k)).hom y, by simp⟩
  letI : Algebra k Γ(X, ⊤) := φ₀.hom.toAlgebra
  haveI : Module.Finite k Γ(X, ⊤) := hfin
  obtain ⟨N, ρ, hρ⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp
    (inferInstance : Algebra.FiniteType k Γ(X, ⊤))
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) :=
    MvPolynomial.gradedAlgebra
  have hX0 : (MvPolynomial.X 0 : MvPolynomial (Fin (N + 1)) k) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k 0)
  have hdeg : ∀ i : Fin N, (MvPolynomial.X i.succ : MvPolynomial (Fin (N + 1)) k) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k (1 • 1) := by
    intro i
    rw [smul_eq_mul, mul_one]
    exact (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X k _)

  obtain ⟨ψ, hψs, hψc⟩ : ∃ ψ : HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X 0) →+* Γ(X, ⊤),
      Function.Surjective ψ ∧ ∀ c : k, ψ (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (Submonoid.powers (MvPolynomial.X 0))
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) c)) = φ₀.hom c := by
    obtain ⟨e, heC, he0, heX⟩ : ∃ e : MvPolynomial (Fin (N + 1)) k →+* Γ(X, ⊤),
        (∀ c : k, e (MvPolynomial.C c) = φ₀.hom c) ∧ e (MvPolynomial.X 0) = 1 ∧
        ∀ i : Fin N, e (MvPolynomial.X i.succ) = ρ (MvPolynomial.X i) :=
      ⟨MvPolynomial.eval₂Hom φ₀.hom (Fin.cons 1 (fun i => ρ (MvPolynomial.X i))),
        fun c => MvPolynomial.eval₂Hom_C _ _ c,
        by rw [MvPolynomial.eval₂Hom_X']; rfl,
        fun i => by rw [MvPolynomial.eval₂Hom_X']; rfl⟩
    have hu : IsUnit (e (MvPolynomial.X 0)) := by rw [he0]; exact isUnit_one
    obtain ⟨lf, hlf⟩ : ∃ lf : Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (N + 1)) k)
        →+* Γ(X, ⊤), ∀ a, lf (algebraMap _ _ a) = e a :=
      ⟨IsLocalization.Away.lift (MvPolynomial.X 0) hu, IsLocalization.Away.lift_eq _ hu⟩
    have hC : ∀ c : k, lf (algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X 0))
        (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (N + 1)) k))
        (HomogeneousLocalization.fromZeroRingHom
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (Submonoid.powers (MvPolynomial.X 0))
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) c))) = φ₀.hom c := by
      intro c
      have h1 : algebraMap (HomogeneousLocalization.Away
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X 0))
          (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (N + 1)) k))
          (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (Submonoid.powers (MvPolynomial.X 0))
          (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) c)) =
          algebraMap (MvPolynomial (Fin (N + 1)) k)
            (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (N + 1)) k))
            (MvPolynomial.C c) := by
        rw [HomogeneousLocalization.algebraMap_apply, ← Localization.mk_one_eq_algebraMap]
        have h2 : ((algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) c :
            ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) :
              MvPolynomial (Fin (N + 1)) k) = MvPolynomial.C c := by
          rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
        rw [← h2]
        rfl
      rw [h1, hlf, heC]
    have hXi : ∀ i : Fin N, lf (algebraMap (HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X 0))
        (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (N + 1)) k))
        (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
          hX0 1 (MvPolynomial.X i.succ) (hdeg i))) = ρ (MvPolynomial.X i) := by
      intro i
      rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk]
      have hs := IsLocalization.mk'_spec
        (Localization.Away (MvPolynomial.X 0 : MvPolynomial (Fin (N + 1)) k))
        (MvPolynomial.X i.succ)
        (⟨MvPolynomial.X 0 ^ 1, pow_mem (Submonoid.mem_powers _) 1⟩ :
          Submonoid.powers (MvPolynomial.X 0 : MvPolynomial (Fin (N + 1)) k))
      rw [← Localization.mk_eq_mk'_apply] at hs
      have hs2 := congrArg lf hs
      rw [map_mul, hlf, hlf] at hs2
      simp only [map_pow, he0, one_pow, mul_one] at hs2
      rw [hs2, heX]
    obtain ⟨ι, hιC, hιX⟩ : ∃ ι : MvPolynomial (Fin N) k →+* HomogeneousLocalization.Away
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X 0),
        (∀ c : k, ι (MvPolynomial.C c) = HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (Submonoid.powers (MvPolynomial.X 0))
          (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0) c)) ∧
        ∀ i : Fin N, ι (MvPolynomial.X i) = HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) hX0 1 (MvPolynomial.X i.succ)
          (hdeg i) :=
      ⟨MvPolynomial.eval₂Hom ((HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
          (Submonoid.powers (MvPolynomial.X 0))).comp
          (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)))
          (fun i => HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) hX0 1 (MvPolynomial.X i.succ)
            (hdeg i)),
        fun c => MvPolynomial.eval₂Hom_C _ _ c, fun i => MvPolynomial.eval₂Hom_X' _ _ i⟩
    have hcomp : (lf.comp (algebraMap _ _)).comp ι = ρ.toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro c
        rw [RingHom.comp_apply, hιC, RingHom.comp_apply, hC, AlgHom.toRingHom_eq_coe,
          RingHom.coe_coe, ← MvPolynomial.algebraMap_eq, AlgHom.commutes]
        rfl
      · intro i
        rw [RingHom.comp_apply, hιX, RingHom.comp_apply, hXi]
        rfl
    refine ⟨lf.comp (algebraMap _ _), ?_, fun c => by rw [RingHom.comp_apply, hC]⟩
    intro y
    obtain ⟨p, rfl⟩ := hρ y
    exact ⟨ι p, by rw [← RingHom.comp_apply, hcomp]; rfl⟩

  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom ψ)) :=
    IsClosedImmersion.spec_of_surjective _ hψs
  obtain ⟨j, hj⟩ : ∃ j : X ⟶ Proj (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k),
      j = X.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom ψ) ≫
        Proj.awayι (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) (MvPolynomial.X 0)
          hX0 Nat.one_pos := ⟨_, rfl⟩
  have hstr : j ≫ Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))) = sX := by
    have hring : (CommRingCat.ofHom
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)) ≫
        CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom
          (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k)
          (Submonoid.powers (MvPolynomial.X 0)))) ≫ CommRingCat.ofHom ψ = φ₀ := by
      ext c
      exact hψc c
    rw [hj, Category.assoc, Category.assoc, Proj.awayι_toSpecZero_assoc, ← Spec.map_comp,
      ← Spec.map_comp, hring, hφ₀, Spec.map_comp, ← Category.assoc,
      Scheme.isoSpec_hom_naturality, Category.assoc, Scheme.isoSpec_Spec_hom, ← Spec.map_comp,
      Iso.inv_hom_id, Spec.map_id, Category.comp_id]
  haveI : IsPreimmersion j := by rw [hj]; infer_instance
  haveI : IsProper (j ≫ Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0)))) := by
    rw [hstr]; infer_instance
  haveI : IsProper j := IsProper.of_comp j
    (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k) ≫
      Spec.map (CommRingCat.ofHom
        (algebraMap k ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) k 0))))
  have hci : IsClosedImmersion j :=
    IsClosedImmersion.of_isPreimmersion j (Scheme.Hom.isClosedMap j).isClosed_range

  refine ⟨X, inferInstance, sX, 𝟙 X, Category.id_comp sX, inferInstance, hreg, inferInstance,
    inferInstance, ⟨⊤, ?_, ?_⟩, ⟨N, j, hci, hstr⟩, ∅, hsnc, fun z hz => hEempty _ hz⟩
  · exact (TopologicalSpace.Opens.ne_bot_iff_nonempty _).mpr ⟨genericPoint X, trivial⟩
  · rw [morphismRestrict_id]
    first
      | exact inferInstanceAs (IsFinite (𝟙 _))
      | exact (fun (Y : Scheme.{u}) => (inferInstance : IsFinite (𝟙 Y))) _
      | (haveI : IsIso (𝟙 ((𝟙 X ⁻¹ᵁ (⊤ : X.Opens)) : Scheme.{u})) := inferInstance; infer_instance)

theorem wcpa_dj_cf_chow_projective : ∀ (k : Type u) [Field k] (X : Scheme.{u})
    [AlgebraicGeometry.IsIntegral X] (sX : X ⟶ Spec (.of k)) [IsProper sX],
    ∃ (X' : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral X') (α₀ : X' ⟶ X),
      wcpaDjIsProjOver k (α₀ ≫ sX) ∧ IsProper α₀ ∧ Surjective α₀ ∧
      ∃ V : X.Opens, V ≠ ⊥ ∧ IsFinite (α₀ ∣_ V) :=
by
  intro K _ Y _ f _

  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace f
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian f
  haveI : IsNoetherian Y := ⟨⟩
  obtain ⟨r, U, hUaff, hUcov, hUdense⟩ := wc_chow_dense_affine_charts Y
  let W : Y.Opens := ⨅ i, U i
  have hWcoe : (W : Set Y) = ⋂ i, (U i : Set Y) := TopologicalSpace.Opens.coe_iInf U
  have hWdense : Dense (W : Set Y) := by rw [hWcoe]; exact hUdense
  have hWU : ∀ i, W ≤ U i := fun i => iInf_le U i
  have hgen := fun i => wc_chow_affine_generators K Y f (U i) (hUaff i)
  choose n a ha0 hagen using hgen
  have hcard : 0 < Fintype.card (∀ i, Fin (n i + 1)) := Fintype.card_pos
  let N : ℕ := Fintype.card (∀ i, Fin (n i + 1)) - 1
  let κ : Fin (N + 1) ≃ (∀ i, Fin (n i + 1)) :=
    (Fintype.equivFinOfCardEq (by omega : Fintype.card (∀ i, Fin (n i + 1)) = N + 1)).symm
  obtain ⟨C, e, hCcov, hCaff, hCbo, UP⟩ := wc_projK_coords K N
  have hψU : ∀ i, W.ι ⁻¹ᵁ U i = ⊤ := by
    intro i
    apply top_le_iff.mp
    intro x _
    show W.ι x ∈ (U i : Set Y)
    have hx : W.ι x ∈ Set.range W.ι := ⟨x, rfl⟩
    rw [Scheme.Opens.range_ι] at hx
    exact hWU i hx
  let s : Fin (N + 1) → Γ((W : Scheme.{u}), ⊤) :=
    fun L => ∏ i, W.ι.appLE (U i) ⊤ (hψU i).ge (a i (κ L i))
  have hs1 : s (κ.symm 0) = 1 := by
    simp only [s, Equiv.apply_symm_apply, Pi.zero_apply, ha0, map_one, Finset.prod_const_one]
  have hspan : Ideal.span (Set.range s) = ⊤ := by
    rw [Ideal.eq_top_iff_one]
    exact Ideal.subset_span ⟨κ.symm 0, hs1⟩
  obtain ⟨φ, hφstr, hφC, hrel⟩ := UP (W : Scheme.{u}) (W.ι ≫ f) s hspan
  haveI := wc_proj_space_isProper K N
  let γ : (W : Scheme.{u}) ⟶ Limits.pullback f (wcProjKStr K N) :=
    Limits.pullback.lift W.ι φ hφstr.symm
  haveI : CompactSpace (W : Scheme.{u}) :=
    isCompact_iff_compactSpace.mp (TopologicalSpace.NoetherianSpace.isCompact (W : Set Y))
  haveI : IsNoetherian (W : Scheme.{u}) := ⟨⟩
  haveI : QuasiCompact γ := inferInstance
  let ιQ := γ.imageι
  let δ := γ.toImage
  have hδι : δ ≫ ιQ = γ := Scheme.Hom.toImage_imageι γ
  let π : γ.image ⟶ Y := ιQ ≫ Limits.pullback.fst f (wcProjKStr K N)
  let g : γ.image ⟶ wcProjK K N := ιQ ≫ Limits.pullback.snd f (wcProjKStr K N)
  have hδπ : δ ≫ π = W.ι := by
    show δ ≫ ιQ ≫ Limits.pullback.fst f (wcProjKStr K N) = W.ι
    rw [← Category.assoc, hδι]
    exact Limits.pullback.lift_fst _ _ _
  have hδg : δ ≫ g = φ := by
    show δ ≫ ιQ ≫ Limits.pullback.snd f (wcProjKStr K N) = φ
    rw [← Category.assoc, hδι]
    exact Limits.pullback.lift_snd _ _ _
  obtain ⟨hinj, hdense⟩ := wc_toImage_injective_dense _ _ γ
  haveI hπprop : IsProper π := by
    show IsProper (ιQ ≫ Limits.pullback.fst f (wcProjKStr K N))
    infer_instance
  have hiso : IsIso (π ∣_ W) := wc_isIso_restrict_of_section _ Y π W δ hinj hδπ
  have hgf : π ≫ f = g ≫ wcProjKStr K N := by
    show (ιQ ≫ Limits.pullback.fst f (wcProjKStr K N)) ≫ f =
      (ιQ ≫ Limits.pullback.snd f (wcProjKStr K N)) ≫ wcProjKStr K N
    rw [Category.assoc, Category.assoc, Limits.pullback.condition]
  haveI hgprop : IsProper g := by
    show IsProper (ιQ ≫ Limits.pullback.snd f (wcProjKStr K N))
    infer_instance
  have hrange : IsClosed (Set.range g) := g.isClosedMap.isClosed_range
  have hπcov : ∀ z : γ.image, ∃ i, π z ∈ U i := by
    intro z
    have hz : π z ∈ (⊤ : Y.Opens) := trivial
    rw [← hUcov] at hz
    exact TopologicalSpace.Opens.mem_iSup.mp hz
  have hcov := wc_chow_charts_cover_K Y γ.image (W : Scheme.{u}) (wcProjK K N) π g δ W.ι φ r U n a
    N κ C e s hψU hinj hδπ hδg ha0 (fun L => rfl) hφC hrel hCcov hCbo hπcov
  have hchart : ∀ J ∈ {J : Fin (N + 1) | ∃ i, κ J i = 0}, IsClosedImmersion (g ∣_ C J) := by
    rintro J ⟨i, hi⟩
    obtain ⟨hGaff, hGgen⟩ := wc_closed_in_product_chart_gen (Spec (.of K)) Y (wcProjK K N)
      γ.image f (wcProjKStr K N) ιQ (U i) (C J) (hUaff i) (hCaff J)
    have hkey := wc_chow_key_identity Y γ.image (W : Scheme.{u}) (wcProjK K N) π g δ W.ι φ r U n a
      N κ C e s hψU hinj hδπ hδg ha0 (fun L => rfl) hφC hrel i J hi
    have hsurj := wc_chart_sections_from_target K Y γ.image (wcProjK K N) f (wcProjKStr K N) π g
      (U i) (C J) (n i) (a i) (fun k => e J (κ.symm (Function.update (κ J) i k))) hgf hGgen
      (hagen i) hkey
    have hpre : (δ ≫ π) ⁻¹ᵁ U i = ⊤ := by rw [hδπ]; exact hψU i
    exact wc_chart_closed_immersion_of_surj Y γ.image (W : Scheme.{u}) (wcProjK K N) π g δ (U i)
      (C J) hdense hpre (hCaff J) hGaff hsurj
  haveI hgci : IsClosedImmersion g :=
    wc_closed_immersion_of_chart_cover γ.image (wcProjK K N) g N C _ hrange hcov hchart
  haveI := hiso

  haveI hYne : Nonempty Y := IsIntegral.nonempty
  have hW0 : W ≠ ⊥ := by
    rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
    exact hWdense.nonempty

  haveI hWne : Nonempty (W : Scheme.{u}) := by
    obtain ⟨x, hx⟩ := hWdense.nonempty
    have hx' : x ∈ Set.range W.ι := by rw [Scheme.Opens.range_ι]; exact hx
    obtain ⟨w, _⟩ := hx'
    exact ⟨w⟩
  haveI hWirr : IrreducibleSpace (W : Scheme.{u}) :=
    Topology.IsOpenEmbedding.irreducibleSpace W.ι.isOpenEmbedding
  haveI hY'irr : IrreducibleSpace γ.image := by
    rw [irreducibleSpace_def]
    have h1 : IsIrreducible (Set.range δ) := by
      rw [← Set.image_univ]
      exact (IrreducibleSpace.isIrreducible_univ _).image _ δ.continuous.continuousOn
    have h2 := h1.closure
    rw [hdense.closure_range] at h2
    exact h2

  haveI hπs : Surjective π := by
    refine ⟨?_⟩
    have hcl : IsClosed (Set.range π) := π.isClosedMap.isClosed_range
    have hsub : (W : Set Y) ⊆ Set.range π := by
      intro x hx
      have hx' : x ∈ Set.range W.ι := by rw [Scheme.Opens.range_ι]; exact hx
      obtain ⟨w, rfl⟩ := hx'
      exact ⟨δ w, by rw [← Scheme.Hom.comp_apply, hδπ]⟩
    rw [← Set.range_eq_univ]
    apply Set.eq_univ_of_univ_subset
    rw [← hWdense.closure_eq]
    exact closure_minimal hsub hcl

  let J : γ.image.IdealSheafData := (⊥ : γ.image.IdealSheafData).radical
  have h2 : Set.range J.subschemeι = Set.univ := by
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.support_radical,
      Scheme.IdealSheafData.support_bot, TopologicalSpace.Closeds.coe_top]
  have hring : ∀ V : γ.image.affineOpens, _root_.IsReduced (Γ(γ.image, V) ⧸ J.ideal V) := fun V =>
    (Ideal.isRadical_iff_quotient_reduced _).mp
      (by
        show ((⊥ : γ.image.IdealSheafData).radical.ideal V).IsRadical
        rw [Scheme.IdealSheafData.radical_ideal]
        exact Ideal.radical_isRadical _)
  have hpieces : ∀ i, IsReduced (J.subschemeCover.openCover.X i) :=
    fun (V : γ.image.affineOpens) => by
      haveI := hring V
      exact (inferInstance :
        IsReduced (Spec (CommRingCat.of (Γ(γ.image, (V : γ.image.Opens)) ⧸ J.ideal V))))
  haveI hRred : IsReduced J.subscheme := IsReduced.of_openCover _ J.subschemeCover.openCover
  have hrs : Function.Surjective J.subschemeι := Set.range_eq_univ.mp h2
  haveI hrsurj : Surjective J.subschemeι := ⟨hrs⟩
  haveI hRne : Nonempty J.subscheme := by
    obtain ⟨y⟩ := (inferInstance : Nonempty γ.image)
    obtain ⟨z, _⟩ := hrs y
    exact ⟨z⟩
  haveI hRirr : IrreducibleSpace J.subscheme :=
    Topology.IsOpenEmbedding.irreducibleSpace
      (J.subschemeι.isClosedEmbedding.isEmbedding.isOpenEmbedding_of_surjective hrs)
  haveI hRint : AlgebraicGeometry.IsIntegral J.subscheme :=
    isIntegral_of_irreducibleSpace_of_isReduced J.subscheme

  refine ⟨J.subscheme, hRint, J.subschemeι ≫ π, ?_, inferInstance, inferInstance, W, hW0, ?_⟩
  · refine ⟨N, J.subschemeι ≫ g, inferInstance, ?_⟩
    show (J.subschemeι ≫ g) ≫ wcProjKStr K N = (J.subschemeι ≫ π) ≫ f
    simp only [Category.assoc, hgf]
  · rw [morphismRestrict_comp]
    haveI hci : IsClosedImmersion (J.subschemeι ∣_ π ⁻¹ᵁ W) := inferInstance
    haveI hf1 : IsFinite (J.subschemeι ∣_ π ⁻¹ᵁ W) := inferInstance
    haveI hf2 : IsFinite (π ∣_ W) := inferInstance
    exact MorphismProperty.comp_mem @IsFinite _ _ hf1 hf2

theorem wcpa_dj_cf_sp_alg_closure_finite : ∀ (F : Type u) [Field F] (K : Type u) [Field K] [Algebra F K], (∃ S : Finset K, IntermediateField.adjoin F (S : Set K) = ⊤) → FiniteDimensional F (algebraicClosure F K) :=
by
  intro F _ K _ _ ⟨S, hS⟩
  classical

  have s1 : ∃ t : Set K, t ⊆ (S : Set K) ∧ AlgebraicIndependent F (Subtype.val : t → K) ∧
      Algebra.IsAlgebraic (Algebra.adjoin F t) K := by
    haveI : Algebra.IsAlgebraic (Algebra.adjoin F (S : Set K)) K := by
      constructor
      intro x
      have hx : x ∈ IntermediateField.adjoin F (S : Set K) := by rw [hS]; trivial
      obtain ⟨r, hr, s, hs, rfl⟩ := IntermediateField.mem_adjoin_iff_div.mp hx
      by_cases h0 : s = 0
      · rw [h0, div_zero]; exact isAlgebraic_zero
      · refine IsAlgebraic.of_mul (y := s) (mem_nonZeroDivisors_of_ne_zero h0) ?_ ?_
        · exact isAlgebraic_algebraMap (⟨s, hs⟩ : Algebra.adjoin F (S : Set K))
        · have e : s * (r / s) = r := by field_simp
          rw [e]
          exact isAlgebraic_algebraMap (⟨r, hr⟩ : Algebra.adjoin F (S : Set K))
    obtain ⟨t, htS, ht⟩ := exists_isTranscendenceBasis_subset (R := F) (A := K) (S : Set K)
    refine ⟨t, htS, ht.1, ?_⟩
    have := ht.isAlgebraic
    rwa [Subtype.range_coe] at this

  have s2 : ∀ t : Set K, t ⊆ (S : Set K) → Algebra.IsAlgebraic (Algebra.adjoin F t) K →
      FiniteDimensional (IntermediateField.adjoin F t) K := by
    intro t htS halg
    have hint : ∀ x : K, _root_.IsIntegral (IntermediateField.adjoin F t) x := fun x =>
      (IntermediateField.isAlgebraic_adjoin_iff.mpr (halg.isAlgebraic x)).isIntegral
    have htop : IntermediateField.adjoin (IntermediateField.adjoin F t) (S : Set K) = ⊤ := by
      apply IntermediateField.restrictScalars_injective F
      rw [IntermediateField.adjoin_adjoin_left, Set.union_eq_right.mpr htS, hS,
        IntermediateField.restrictScalars_top]
    have h : FiniteDimensional (IntermediateField.adjoin F t)
        (IntermediateField.adjoin (IntermediateField.adjoin F t) (S : Set K)) :=
      IntermediateField.finiteDimensional_adjoin (fun x _ => hint x)
    rw [htop] at h
    exact LinearEquiv.finiteDimensional
      (IntermediateField.topEquiv (F := IntermediateField.adjoin F t) (E := K)).toLinearEquiv

  have s3 : ∀ t : Set K, AlgebraicIndependent F (Subtype.val : t → K) →
      ∀ (κ : Type u) (ℓ : κ → algebraicClosure F K), LinearIndependent F ℓ →
      LinearIndependent (Algebra.adjoin F t) (fun j => (ℓ j : K)) := by
    intro t hx κ ℓ hℓ
    have hL : AlgebraicIndependent (algebraicClosure F K) (Subtype.val : t → K) :=
      hx.extendScalars (algebraicClosure F K)
    rw [algebraicIndependent_iff] at hL
    rw [linearIndependent_iff'] at hℓ ⊢
    intro s g hg
    have hP : ∀ j, ∃ P : MvPolynomial t F,
        MvPolynomial.aeval (Subtype.val : t → K) P = (g j : K) := by
      intro j
      have hmem : (g j : K) ∈ (MvPolynomial.aeval (R := F) (Subtype.val : t → K)).range := by
        rw [← Algebra.adjoin_range_eq_range_aeval F, Subtype.range_coe]
        exact (g j).2
      obtain ⟨P, hP⟩ := hmem
      exact ⟨P, hP⟩
    choose P hP using hP
    have hQ0 : (∑ j ∈ s, MvPolynomial.C (ℓ j) *
        MvPolynomial.map (algebraMap F (algebraicClosure F K)) (P j)) = 0 := by
      apply hL
      rw [map_sum]
      have : ∀ j ∈ s, MvPolynomial.aeval (Subtype.val : t → K) (MvPolynomial.C (ℓ j) *
          MvPolynomial.map (algebraMap F (algebraicClosure F K)) (P j)) = g j • (ℓ j : K) := by
        intro j _
        rw [map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_map_algebraMap, hP]
        show _ = (g j : K) * (ℓ j : K)
        rw [mul_comm]
        rfl
      rw [Finset.sum_congr rfl this]
      exact hg
    have hc : ∀ m : t →₀ ℕ, ∀ j ∈ s, (P j).coeff m = 0 := by
      intro m
      have h0 := congrArg (fun p : MvPolynomial t (algebraicClosure F K) => p.coeff m) hQ0
      simp only [MvPolynomial.coeff_sum] at h0
      have hsum : ∑ j ∈ s, (P j).coeff m • ℓ j = 0 := by
        refine Eq.trans ?_ (h0.trans (by simp))
        apply Finset.sum_congr rfl
        intro j _
        rw [MvPolynomial.coeff_C_mul, MvPolynomial.coeff_map, Algebra.smul_def, mul_comm]
      exact hℓ s (fun j => (P j).coeff m) hsum
    intro j hj
    have hPj : P j = 0 := by
      ext m
      rw [hc m j hj]
      simp
    apply Subtype.ext
    rw [← hP j, hPj, map_zero]
    rfl

  have s4 : ∀ (t : Set K) (κ : Type u) (v : κ → K), LinearIndependent (Algebra.adjoin F t) v →
      LinearIndependent (IntermediateField.adjoin F t) v := by
    intro t κ v hv
    rw [linearIndependent_iff'] at hv ⊢
    intro s e he
    have hrd : ∀ j, ∃ r ∈ Algebra.adjoin F t, ∃ d ∈ Algebra.adjoin F t,
        d ≠ 0 ∧ (e j : K) = r / d := by
      intro j
      obtain ⟨r, hr, d, hd, h⟩ := IntermediateField.mem_adjoin_iff_div.mp (e j).2
      by_cases h0 : d = 0
      · refine ⟨0, Subalgebra.zero_mem _, 1, Subalgebra.one_mem _, one_ne_zero, ?_⟩
        rw [h, h0, div_zero, zero_div]
      · exact ⟨r, hr, d, hd, h0, h⟩
    choose r hr d hd hd0 hrd using hrd
    have hD0 : (∏ i ∈ s, d i) ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hd0 i)
    have hc : ∀ j ∈ s, (e j : K) * (∏ i ∈ s, d i) = r j * ∏ i ∈ s.erase j, d i := by
      intro j hj
      rw [← Finset.mul_prod_erase s d hj, hrd j]
      field_simp [hd0 j]
    have hcmem : ∀ j, r j * ∏ i ∈ s.erase j, d i ∈ Algebra.adjoin F t := fun j =>
      Subalgebra.mul_mem _ (hr j) (Subalgebra.prod_mem _ (fun i _ => hd i))
    let g : κ → Algebra.adjoin F t := fun j => ⟨r j * ∏ i ∈ s.erase j, d i, hcmem j⟩
    have hg : ∑ j ∈ s, g j • v j = 0 := by
      have : ∑ j ∈ s, g j • v j = (∏ i ∈ s, d i) * ∑ j ∈ s, e j • v j := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro j hj
        show (r j * ∏ i ∈ s.erase j, d i) * v j = (∏ i ∈ s, d i) * ((e j : K) * v j)
        rw [← hc j hj]
        ring
      rw [this, he, mul_zero]
    intro j hj
    have h1 := hv s g hg j hj
    have h2 : (e j : K) * (∏ i ∈ s, d i) = 0 := by
      rw [hc j hj]
      exact congrArg Subtype.val h1
    apply Subtype.ext
    exact (mul_eq_zero.mp h2).resolve_right hD0

  obtain ⟨t, htS, hind, halg⟩ := s1
  haveI hfin : FiniteDimensional (IntermediateField.adjoin F t) K := s2 t htS halg
  have hrank : Module.rank F (algebraicClosure F K) ≤
      ((Module.finrank (IntermediateField.adjoin F t) K : ℕ) : Cardinal) := by
    apply rank_le
    intro b hb
    have h3 := s4 t _ _ (s3 t hind b (fun i => (i : algebraicClosure F K)) hb)
    have := h3.fintype_card_le_finrank
    rwa [Fintype.card_coe] at this
  have hlt : Module.rank F (algebraicClosure F K) < Cardinal.aleph0 :=
    lt_of_le_of_lt hrank (Cardinal.natCast_lt_aleph0)
  exact Module.rank_lt_aleph0_iff.mp hlt

theorem wcpa_dj_cf_sp_stein_subfield : (∀ (F : Type u) [Field F] (K : Type u) [Field K] [Algebra F K], (∃ S : Finset K, IntermediateField.adjoin F (S : Set K) = ⊤) → FiniteDimensional F (algebraicClosure F K)) → ∀ (k : Type u) [Field k] [PerfectField k] (K : Type u) [Field K] [Algebra k K] (d : ℕ), (∃ S : Finset K, IntermediateField.adjoin k (S : Set K) = ⊤) → (∃ t : Fin (d + 1) → K, IsTranscendenceBasis k t) → ∃ (m : ℕ) (y : Fin m → K), (∃ t' : Fin d → IntermediateField.adjoin k (Set.range y), IsTranscendenceBasis k t') ∧ (∀ x : K, IsAlgebraic (IntermediateField.adjoin k (Set.range y)) x → x ∈ Set.range (algebraMap (IntermediateField.adjoin k (Set.range y)) K)) ∧ Algebra.IsSeparablyGenerated (IntermediateField.adjoin k (Set.range y)) K ∧ ∃ S : Finset K, IntermediateField.adjoin (IntermediateField.adjoin k (Set.range y)) (S : Set K) = ⊤ :=
by
  intro H2 k _ _ K _ _ d hSfg htb
  classical

  have mono : ∀ (E₁ : IntermediateField k K) (F : Type u) [Field F] [Algebra F K]
      (E₂ : IntermediateField F K), (∀ x ∈ E₁, x ∈ E₂) → ∀ x : K,
      (IsAlgebraic E₁ x → IsAlgebraic E₂ x) ∧ (IsSeparable E₁ x → IsSeparable E₂ x) := by
    intro E₁ F _ _ E₂ h x
    let j : E₁ →+* E₂ :=
      { toFun := fun a => ⟨(a : K), h a a.2⟩
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    letI : Algebra E₁ E₂ := j.toAlgebra
    haveI : IsScalarTower E₁ E₂ K := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    have hj : Function.Injective (algebraMap E₁ E₂) := by
      intro a b hab
      apply Subtype.ext
      have := congrArg (fun q : E₂ => (q : K)) hab
      exact this
    exact ⟨fun hx => hx.extendScalars hj, fun hx => hx.tower_top E₂⟩

  obtain ⟨S, hS⟩ := hSfg
  haveI : Algebra.EssFiniteType k K := IntermediateField.fg_top_iff.mp
    (IntermediateField.fg_def.mpr ⟨(S : Set K), S.finite_toSet, hS⟩)
  obtain ⟨s, hs, hsep⟩ := (Algebra.isSeparablyGenerated_iff k K).mp inferInstance
  obtain ⟨t, ht⟩ := htb
  have hcard := hs.lift_cardinalMk_eq ht
  rw [Cardinal.mk_fin, Cardinal.lift_natCast, Cardinal.lift_eq_nat_iff] at hcard
  obtain ⟨e⟩ := Cardinal.mk_eq_nat_iff.mp hcard
  set v : Fin (d + 1) → K := Subtype.val ∘ e.symm with hvdef
  have hv : IsTranscendenceBasis k v := hs.comp_equiv e.symm
  have hrange : Set.range v = s := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      exact (e.symm i).2
    · intro hx
      exact ⟨e ⟨x, hx⟩, by simp [v]⟩
  rw [← hrange] at hsep

  have fg : ∀ E : IntermediateField k K, IntermediateField.adjoin E (S : Set K) = ⊤ := by
    intro E
    rw [eq_top_iff]
    intro x _
    have h1 : IntermediateField.adjoin k (S : Set K) ≤
        (IntermediateField.adjoin E (S : Set K)).restrictScalars k :=
      IntermediateField.adjoin_le_iff.mpr (fun y hy => IntermediateField.subset_adjoin E _ hy)
    have hx : x ∈ IntermediateField.adjoin k (S : Set K) := by
      rw [hS]; exact IntermediateField.mem_top
    exact h1 hx

  set w : Fin d → K := fun i => v (Fin.castSucc i) with hwdef
  set τ : K := v (Fin.last d) with hτdef
  set M : IntermediateField k K := IntermediateField.adjoin k (Set.range w) with hMdef
  have hfin : FiniteDimensional M (algebraicClosure M K) := H2 M K ⟨S, fg M⟩

  set A : IntermediateField M K := algebraicClosure M K with hAdef
  set n : ℕ := Module.finrank M A with hndef
  let b : Module.Basis (Fin n) M A := Module.finBasis M A
  set z : Fin n → K := fun j => ((b j : A) : K) with hzdef
  set y : Fin (d + n) → K := Fin.append w z with hydef
  set L : IntermediateField k K := IntermediateField.adjoin k (Set.range y) with hLdef
  have hwL : ∀ i, w i ∈ L := fun i =>
    IntermediateField.subset_adjoin k _ ⟨Fin.castAdd n i, Fin.append_left w z i⟩
  have hzL : ∀ j, z j ∈ L := fun j =>
    IntermediateField.subset_adjoin k _ ⟨Fin.natAdd d j, Fin.append_right w z j⟩
  have hML : ∀ x ∈ M, x ∈ L := by
    intro x hx
    have h1 : M ≤ L := IntermediateField.adjoin_le_iff.mpr (by
      rintro _ ⟨i, rfl⟩
      exact hwL i)
    exact h1 hx
  have hAL : ∀ x : K, IsAlgebraic M x → x ∈ L := by
    intro x hx
    have hxA : x ∈ A := mem_algebraicClosure_iff.mpr hx
    have key : ∀ a : A, (a : K) ∈ L := by
      intro a
      rw [← b.sum_repr a]
      rw [IntermediateField.coe_sum]
      refine L.sum_mem (fun j _ => ?_)
      rw [IntermediateField.coe_smul, Algebra.smul_def]
      exact L.mul_mem (hML _ (b.repr a j).2) (hzL j)
    exact key ⟨x, hxA⟩
  have hLA : ∀ x ∈ L, IsAlgebraic M x := by
    intro x hx
    have h1 : L ≤ A.restrictScalars k := by
      rw [IntermediateField.adjoin_le_iff]
      rintro _ ⟨i, rfl⟩
      induction i using Fin.addCases with
      | left i =>
        rw [hydef, Fin.append_left]
        have hwM : w i ∈ M := IntermediateField.subset_adjoin k _ ⟨i, rfl⟩
        exact mem_algebraicClosure_iff.mpr (isAlgebraic_algebraMap (⟨w i, hwM⟩ : M))
      | right j =>
        rw [hydef, Fin.append_right]
        exact (b j).2
    exact mem_algebraicClosure_iff.mp (h1 hx)

  have tower : ∀ x : K, IsAlgebraic L x → IsAlgebraic M x := by
    intro x hx
    haveI : Algebra.IsAlgebraic M (IntermediateField.adjoin M (L : Set K)) :=
      (IntermediateField.isAlgebraic_adjoin_iff_isAlgebraic M K).mpr hLA
    have hx' : IsAlgebraic (IntermediateField.adjoin M (L : Set K)) x :=
      (mono L M (IntermediateField.adjoin M (L : Set K))
        (fun y hy => IntermediateField.subset_adjoin M _ hy) x).1 hx
    exact IsAlgebraic.restrictScalars M hx'

  have hτM : Transcendental M τ := by
    have h1 := hv.1.transcendental_adjoin (s := Set.range Fin.castSucc) (i := Fin.last d)
      (by rintro ⟨j, hj⟩; exact Fin.castSucc_ne_last j hj)
    rw [← Set.range_comp] at h1
    exact IntermediateField.transcendental_adjoin_iff.mpr h1
  have hτL : Transcendental L τ := fun hA => hτM (tower τ hA)

  refine ⟨d + n, y, ?_, ?_, ?_, ⟨S, fg L⟩⟩
  ·
    have hwind : AlgebraicIndependent k w := hv.1.comp Fin.castSucc (Fin.castSucc_injective d)
    let t' : Fin d → L := fun i => ⟨w i, hwL i⟩
    have hind : AlgebraicIndependent k t' := AlgebraicIndependent.of_comp L.val hwind
    refine ⟨t', (hind.isTranscendenceBasis_iff_isAlgebraic).mpr ⟨fun x => ?_⟩⟩
    have h1 : IsAlgebraic (Algebra.adjoin k (Set.range w)) (x : K) :=
      IntermediateField.isAlgebraic_adjoin_iff.mp (hLA x x.2)
    have hmap : Subalgebra.map L.val (Algebra.adjoin k (Set.range t')) =
        Algebra.adjoin k (Set.range w) := by
      rw [AlgHom.map_adjoin, ← Set.range_comp]
      rfl
    let f := ((Algebra.adjoin k (Set.range t')).equivMapOfInjective L.val
      (IntermediateField.val L).injective).trans (Subalgebra.equivOfEq _ _ hmap)
    exact (isAlgebraic_ringHom_iff_of_comp_eq f L.val (IntermediateField.val L).injective
      (RingHom.ext fun _ => rfl)).mp h1
  ·
    intro x hx
    exact ⟨⟨x, hAL x (tower x hx)⟩, rfl⟩
  ·
    haveI := hsep
    have hsub : ∀ x ∈ IntermediateField.adjoin k (Set.range v),
        x ∈ IntermediateField.adjoin L ({τ} : Set K) := by
      intro x hx
      have h1 : IntermediateField.adjoin k (Set.range v) ≤
          (IntermediateField.adjoin L ({τ} : Set K)).restrictScalars k := by
        rw [IntermediateField.adjoin_le_iff]
        rintro _ ⟨i, rfl⟩
        induction i using Fin.lastCases with
        | last => exact IntermediateField.subset_adjoin L _ rfl
        | cast j =>
          exact (IntermediateField.adjoin L ({τ} : Set K)).algebraMap_mem ⟨w j, hwL j⟩
      exact h1 hx
    haveI hsep' : Algebra.IsSeparable (IntermediateField.adjoin L ({τ} : Set K)) K :=
      ⟨fun x => (mono _ L _ hsub x).2 (Algebra.IsSeparable.isSeparable _ x)⟩
    refine Algebra.IsSeparablyGenerated.mk ⟨{τ}, ?_, hsep'⟩
    have hind : AlgebraicIndependent L (Subtype.val : ({τ} : Set K) → K) :=
      algebraicIndependent_unique_type_iff.mpr hτL
    refine (hind.isTranscendenceBasis_iff_isAlgebraic).mpr ?_
    rw [Subtype.range_coe]
    exact ⟨fun x => IntermediateField.isAlgebraic_adjoin_iff.mp
      (Algebra.IsSeparable.isSeparable _ x).isIntegral.isAlgebraic⟩

theorem wcpa_dj_cf_sp_tensor_reduced : ∀ (A B : Type u) [Field A] [Field B] [Algebra A B], Algebra.IsSeparablyGenerated A B → (∃ S : Finset B, IntermediateField.adjoin A (S : Set B) = ⊤) → ∀ (A' : Type u) [Field A'] [Algebra A A'] [FiniteDimensional A A'], _root_.IsReduced (TensorProduct A B A') :=
by

  have s2 : ∀ (A : Type u) [Field A] (ι : Type u) (A' : Type u) [Field A'] [Algebra A A'],
      IsDomain (TensorProduct A (FractionRing (MvPolynomial ι A)) A') := by
    intro A _ ι A' _ _
    let φ : TensorProduct A (MvPolynomial ι A) A' ≃+* MvPolynomial ι A' :=
      (Algebra.TensorProduct.comm A (MvPolynomial ι A) A').toRingEquiv.trans
        (MvPolynomial.algebraTensorAlgEquiv A A').toRingEquiv
    haveI hT : IsDomain (TensorProduct A (MvPolynomial ι A) A') :=
      MulEquiv.isDomain (MvPolynomial ι A') φ.toMulEquiv
    have hφ : ∀ p : MvPolynomial ι A,
        φ (algebraMap (MvPolynomial ι A) (TensorProduct A (MvPolynomial ι A) A') p) =
          MvPolynomial.map (algebraMap A A') p := by
      intro p
      simp [φ, Algebra.TensorProduct.algebraMap_apply]
    have hle : Algebra.algebraMapSubmonoid (TensorProduct A (MvPolynomial ι A) A')
        (nonZeroDivisors (MvPolynomial ι A)) ≤
          nonZeroDivisors (TensorProduct A (MvPolynomial ι A) A') := by
      rintro _ ⟨p, hp, rfl⟩
      apply mem_nonZeroDivisors_of_ne_zero
      intro h0
      have h1 := hφ p
      rw [h0, map_zero] at h1
      have h2 : p = 0 :=
        MvPolynomial.map_injective _ (algebraMap A A').injective (by rw [← h1, map_zero])
      exact nonZeroDivisors.ne_zero hp h2
    letI : Algebra (TensorProduct A (MvPolynomial ι A) A') (TensorProduct (MvPolynomial ι A)
        (FractionRing (MvPolynomial ι A)) (TensorProduct A (MvPolynomial ι A) A')) :=
      Algebra.TensorProduct.rightAlgebra
    haveI := IsLocalization.tensorRight (R := MvPolynomial ι A)
      (S := TensorProduct A (MvPolynomial ι A) A') (FractionRing (MvPolynomial ι A))
      (nonZeroDivisors (MvPolynomial ι A))
    haveI : IsDomain (TensorProduct (MvPolynomial ι A) (FractionRing (MvPolynomial ι A))
        (TensorProduct A (MvPolynomial ι A) A')) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors (TensorProduct (MvPolynomial ι A)
        (FractionRing (MvPolynomial ι A)) (TensorProduct A (MvPolynomial ι A) A')) hle
    exact MulEquiv.isDomain _ (Algebra.TensorProduct.cancelBaseChange A (MvPolynomial ι A)
      (FractionRing (MvPolynomial ι A)) (FractionRing (MvPolynomial ι A)) A').symm.toMulEquiv

  have s3 : ∀ (A B : Type u) [Field A] [Field B] [Algebra A B] (s : Set B),
      Algebra.IsSeparable (IntermediateField.adjoin A s) B →
      (∃ S : Finset B, IntermediateField.adjoin A (S : Set B) = ⊤) →
      FiniteDimensional (IntermediateField.adjoin A s) B := by
    intro A B _ _ _ s hsep ⟨S, hS⟩
    have h1 : IntermediateField.adjoin (IntermediateField.adjoin A s) (S : Set B) = ⊤ :=
      IntermediateField.adjoin_eq_top_of_adjoin_eq_top A hS
    haveI : FiniteDimensional (IntermediateField.adjoin A s)
        (IntermediateField.adjoin (IntermediateField.adjoin A s) (S : Set B)) :=
      IntermediateField.finiteDimensional_adjoin
        (fun x _ => Algebra.IsSeparable.isIntegral (IntermediateField.adjoin A s) x)
    exact LinearEquiv.finiteDimensional
      ((IntermediateField.equivOfEq h1).trans IntermediateField.topEquiv).toLinearEquiv

  have s4 : ∀ (E B R : Type u) [Field E] [Field B] [Algebra E B] [Field R] [Algebra E R],
      Algebra.IsSeparable E B → FiniteDimensional E B → _root_.IsReduced (TensorProduct E B R) := by
    intro E B R _ _ _ _ _ hsep hfin
    haveI := hsep
    haveI := Algebra.FormallyUnramified.of_isSeparable E B
    haveI : Algebra.FormallyUnramified R (TensorProduct E R B) :=
      Algebra.FormallyUnramified.base_change R
    haveI : Module.Finite R (TensorProduct E R B) := Module.Finite.base_change E R B
    haveI : Algebra.FiniteType R (TensorProduct E R B) :=
      Module.Finite.finiteType (TensorProduct E R B)
    haveI : Algebra.EssFiniteType R (TensorProduct E R B) :=
      Algebra.EssFiniteType.of_finiteType R (TensorProduct E R B)
    haveI := Algebra.FormallyUnramified.isReduced_of_field R (TensorProduct E R B)
    exact isReduced_of_injective (Algebra.TensorProduct.comm E B R).toRingHom
      (Algebra.TensorProduct.comm E B R).injective

  intro A B _ _ _ hgen hfg A' _ _ _
  obtain ⟨s, hs, hsep⟩ := (Algebra.isSeparablyGenerated_iff A B).mp hgen
  haveI := s2 A s A'
  haveI hdom : IsDomain (TensorProduct A (IntermediateField.adjoin A s) A') :=
    MulEquiv.isDomain _ (Algebra.TensorProduct.congr
      ((hs.1.aevalEquivField.trans (IntermediateField.equivOfEq (by rw [Subtype.range_coe]) :
        IntermediateField.adjoin A (Set.range (Subtype.val : s → B)) ≃ₐ[A]
          IntermediateField.adjoin A s)).symm) (AlgEquiv.refl : A' ≃ₐ[A] A')).toMulEquiv
  haveI : Module.Finite (IntermediateField.adjoin A s)
      (TensorProduct A (IntermediateField.adjoin A s) A') :=
    Module.Finite.base_change A (IntermediateField.adjoin A s) A'
  haveI : IsArtinianRing (TensorProduct A (IntermediateField.adjoin A s) A') :=
    IsArtinianRing.of_finite (IntermediateField.adjoin A s)
      (TensorProduct A (IntermediateField.adjoin A s) A')
  have hF : IsField (TensorProduct A (IntermediateField.adjoin A s) A') :=
    IsArtinianRing.isField_of_isDomain (TensorProduct A (IntermediateField.adjoin A s) A')
  have hfin := s3 A B s hsep hfg
  letI : Field (TensorProduct A (IntermediateField.adjoin A s) A') := hF.toField
  haveI hred := s4 (IntermediateField.adjoin A s) B
    (TensorProduct A (IntermediateField.adjoin A s) A') hsep hfin
  exact isReduced_of_injective
    (Algebra.TensorProduct.cancelBaseChange A (IntermediateField.adjoin A s)
      (IntermediateField.adjoin A s) B A').symm.toRingHom
    (Algebra.TensorProduct.cancelBaseChange A (IntermediateField.adjoin A s)
      (IntermediateField.adjoin A s) B A').symm.injective

theorem wcpa_dj_cf_sp_tensor_domain_finite : ∀ (A B : Type u) [Field A] [Field B] [Algebra A B], (∀ x : B, IsAlgebraic A x → x ∈ Set.range (algebraMap A B)) → (∀ (A' : Type u) [Field A'] [Algebra A A'] [FiniteDimensional A A'], _root_.IsReduced (TensorProduct A B A')) → ∀ (A' : Type u) [Field A'] [Algebra A A'] [FiniteDimensional A A'], IsDomain (TensorProduct A B A') :=
by
  set_option synthInstance.maxHeartbeats 400000 in
  intro A B _ _ _ hA hred A' _ _ _
  classical
  haveI hdomA : IsDomain A := DivisionRing.isDomain
  haveI hdomB : IsDomain B := DivisionRing.isDomain
  haveI hdomA' : IsDomain A' := DivisionRing.isDomain

  have s4 : ∀ (R : Type u) [CommRing R] [Nontrivial R] [_root_.IsReduced R],
      Subsingleton (PrimeSpectrum R) → IsDomain R := by
    intro R _ _ _ h
    obtain ⟨M, hM⟩ := Ideal.exists_maximal R
    have key : ∀ x ∈ M, x = 0 := by
      intro x hx
      apply IsNilpotent.eq_zero
      rw [nilpotent_iff_mem_prime]
      intro J hJ
      have h1 : (⟨J, hJ⟩ : PrimeSpectrum R) = ⟨M, hM.isPrime⟩ := Subsingleton.elim _ _
      have hJM : J = M := congrArg PrimeSpectrum.asIdeal h1
      rw [hJM]; exact hx
    have : NoZeroDivisors R := ⟨fun {x y} hxy => by
      have h2 : x * y ∈ M := hxy ▸ M.zero_mem
      rcases hM.isPrime.mem_or_mem h2 with h3 | h3
      · exact Or.inl (key x h3)
      · exact Or.inr (key y h3)⟩
    exact NoZeroDivisors.to_isDomain R

  have s1 : ∀ f : Polynomial A, f.Monic → Irreducible f →
      Irreducible (f.map (algebraMap A B)) := by
    intro f hf hirr
    set ι := algebraMap A B with hιdef
    have hι : Function.Injective ι := ι.injective
    have hdesc : ∀ g : Polynomial B, g.Monic → g ∣ f.map ι →
        ∃ g₀ : Polynomial A, g₀.map ι = g ∧ g₀.Monic := by
      intro g hg hdvd
      have h1 := integralClosure.mem_lifts_of_monic_of_dvd_map B hf hg hdvd
      have h2 : g ∈ Polynomial.lifts ι := by
        rw [Polynomial.lifts_iff_coeff_lifts] at h1 ⊢
        intro n
        obtain ⟨c, hc⟩ := h1 n
        have h3 : IsIntegral A (g.coeff n) := by rw [← hc]; exact c.2
        exact hA _ h3.isAlgebraic
      obtain ⟨g₀, hg₀, -, hm⟩ := Polynomial.lifts_and_degree_eq_and_monic h2 hg
      exact ⟨g₀, hg₀, hm⟩
    have hmap : (f.map ι).Monic := hf.map ι
    have hf1 : f ≠ 1 := fun h => hirr.not_isUnit (h ▸ isUnit_one)
    have hne1 : f.map ι ≠ 1 := by
      intro h
      exact hf1 (Polynomial.map_injective ι hι (by rw [h, Polynomial.map_one]))
    rw [Polynomial.irreducible_of_monic hmap hne1]
    intro g h hg hh hgh
    obtain ⟨g₀, rfl, hg₀⟩ := hdesc g hg ⟨h, hgh.symm⟩
    obtain ⟨h₀, rfl, hh₀⟩ := hdesc h hh ⟨_, (hgh.symm.trans (mul_comm _ _))⟩
    have e : g₀ * h₀ = f := Polynomial.map_injective ι hι (by rw [Polynomial.map_mul, hgh])
    rcases (Polynomial.irreducible_of_monic hf hf1).mp hirr g₀ h₀ hg₀ hh₀ e with h | h
    · left; rw [h, Polynomial.map_one]
    · right; rw [h, Polynomial.map_one]

  have s2 : ∀ (S : Type u) [Field S] [Algebra A S] [FiniteDimensional A S]
      [Algebra.IsSeparable A S], IsField (TensorProduct A B S) := by
    intro S _ _ _ _
    haveI hdomS : IsDomain S := DivisionRing.isDomain
    obtain ⟨θ, hθ⟩ := Field.exists_primitive_element A S
    have hθi : IsIntegral A θ := IsIntegral.of_finite A θ
    set f := minpoly A θ with hfdef
    have hfm : f.Monic := minpoly.monic hθi
    have hfi : Irreducible f := minpoly.irreducible hθi
    have hdeg : f.natDegree = Module.finrank A S := by
      rw [hfdef, ← IntermediateField.adjoin.finrank hθi, hθ, IntermediateField.finrank_top']
    set g := f.map (algebraMap A B) with hgdef
    haveI : Fact (Irreducible g) := ⟨s1 f hfm hfi⟩
    have hg0 : g ≠ 0 := (hfm.map _).ne_zero
    have hKdim : Module.finrank B (AdjoinRoot g) = Module.finrank A S := by
      rw [(AdjoinRoot.powerBasis hg0).finrank, AdjoinRoot.powerBasis_dim, hgdef,
        Polynomial.natDegree_map_eq_of_injective (algebraMap A B).injective, hdeg]
    haveI : FiniteDimensional B (AdjoinRoot g) := (AdjoinRoot.powerBasis hg0).finite
    haveI : Module.Free A S := Module.Free.of_divisionRing A S
    have hTdim : Module.finrank B (TensorProduct A B S) = Module.finrank A S :=
      Module.finrank_baseChange (R := B) (S := A) (M' := S)
    haveI : Nontrivial (TensorProduct A B S) :=
      Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain A B S
        (algebraMap A B).injective (algebraMap A S).injective
    have hx : Polynomial.eval₂ (algebraMap B (TensorProduct A B S))
        (Algebra.TensorProduct.includeRight θ) g = 0 := by
      rw [hgdef, Polynomial.eval₂_map, ← IsScalarTower.algebraMap_eq, ← Polynomial.aeval_def,
        Polynomial.aeval_algHom_apply, minpoly.aeval, map_zero]
    let φ : AdjoinRoot g →ₐ[B] TensorProduct A B S :=
      AdjoinRoot.liftAlgHom g (Algebra.ofId B _) (Algebra.TensorProduct.includeRight θ) hx
    have hinj : Function.Injective φ := φ.toRingHom.injective
    have hsurj : Function.Surjective φ.toLinearMap :=
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (hKdim.trans hTdim.symm)).mp hinj
    let e := AlgEquiv.ofBijective φ ⟨hinj, hsurj⟩
    exact MulEquiv.isField (Field.toIsField (AdjoinRoot g)) e.symm.toMulEquiv

  have s3 : ∀ (S : Type u) [Field S] [Algebra A S] [Algebra S A'] [IsScalarTower A S A']
      [IsPurelyInseparable S A'], IsField (TensorProduct A B S) →
      Subsingleton (PrimeSpectrum (TensorProduct A B A')) := by
    intro S _ _ _ _ _ hS
    have hR : IsField (TensorProduct A S B) :=
      MulEquiv.isField hS (Algebra.TensorProduct.comm A S B).toMulEquiv
    have hspecR : Subsingleton (PrimeSpectrum (TensorProduct A S B)) := by
      constructor
      intro p q
      have hbot : ∀ P : PrimeSpectrum (TensorProduct A S B), P.asIdeal = ⊥ := by
        intro P
        rw [eq_bot_iff]
        intro x hx
        by_contra hx0
        obtain ⟨y, hy⟩ := hR.mul_inv_cancel hx0
        exact P.2.ne_top ((Ideal.eq_top_iff_one _).mpr (hy ▸ P.asIdeal.mul_mem_right y hx))
      exact PrimeSpectrum.ext ((hbot p).trans (hbot q).symm)
    have hT : Subsingleton (PrimeSpectrum (TensorProduct S (TensorProduct A S B) A')) :=
      (PrimeSpectrum.isHomeomorph_comap_of_isPurelyInseparable S A'
        (TensorProduct A S B)).bijective.injective.subsingleton
    let E : TensorProduct A B A' ≃+* TensorProduct S (TensorProduct A S B) A' :=
      ((Algebra.TensorProduct.comm A B A').toRingEquiv.trans
        (Algebra.TensorProduct.cancelBaseChange A S A' A' B).symm.toRingEquiv).trans
        (Algebra.TensorProduct.comm S A' (TensorProduct A S B)).toRingEquiv
    exact (PrimeSpectrum.comap_injective_of_surjective
      (E.symm : TensorProduct S (TensorProduct A S B) A' →+* TensorProduct A B A')
      E.symm.surjective).subsingleton

  haveI : FiniteDimensional A (separableClosure A A') :=
    IntermediateField.finiteDimensional_left _
  haveI : Algebra.IsSeparable A (separableClosure A A') := separableClosure.isSeparable A A'
  haveI : Algebra.IsAlgebraic A A' := Algebra.IsAlgebraic.of_finite A A'
  haveI : IsPurelyInseparable (separableClosure A A') A' :=
    separableClosure.isPurelyInseparable A A'
  have hspec := s3 (separableClosure A A') (s2 (separableClosure A A'))
  haveI : Nontrivial (TensorProduct A B A') :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain A B A'
      (algebraMap A B).injective (algebraMap A A').injective
  haveI := hred A'
  exact s4 _ hspec

theorem wcpa_dj_cf_sp_tensor_domain_all : ∀ (A B : Type u) [Field A] [Field B] [Algebra A B], (∀ (A' : Type u) [Field A'] [Algebra A A'] [FiniteDimensional A A'], IsDomain (TensorProduct A B A')) → ∀ (Ω : Type u) [Field Ω] [Algebra A Ω], IsDomain (TensorProduct A B Ω) :=
by
  intro A B _ _ _ h Ω _ _
  classical

  have coords : ∀ (N P : Type u) [CommRing N] [Algebra A N] [CommRing P] [Algebra A P]
      (f : N →ₐ[A] P) (z : TensorProduct A B N),
      TensorProduct.equivFinsuppOfBasisLeft (Module.Basis.ofVectorSpace A B)
          (Algebra.TensorProduct.map (AlgHom.id A B) f z) =
        Finsupp.mapRange f (map_zero f)
          (TensorProduct.equivFinsuppOfBasisLeft (Module.Basis.ofVectorSpace A B) z) := by
    intro N P _ _ _ _ f z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | tmul b₀ n =>
      rw [Algebra.TensorProduct.map_tmul, TensorProduct.equivFinsuppOfBasisLeft_apply_tmul,
        TensorProduct.equivFinsuppOfBasisLeft_apply_tmul]
      ext i
      simp only [Finsupp.mapRange_apply, AlgHom.id_apply, map_smul]
    | add x y hx hy =>
      rw [map_add, map_add, hx, hy, map_add, Finsupp.mapRange_add (map_add f)]
  haveI : Nontrivial (TensorProduct A B Ω) :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_isDomain A B Ω
      (algebraMap A B).injective (algebraMap A Ω).injective
  haveI : NoZeroDivisors (TensorProduct A B Ω) := by
    refine ⟨fun {x y} hxy => ?_⟩
    by_contra hne
    rw [not_or] at hne
    obtain ⟨hx0, hy0⟩ := hne
    obtain ⟨S, hS⟩ := TensorProduct.exists_finset x
    obtain ⟨T, hT⟩ := TensorProduct.exists_finset y
    set s : Finset Ω := S.image Prod.snd ∪ T.image Prod.snd with hs
    set C := Algebra.adjoin A (s : Set Ω) with hC
    have hSmem : ∀ i ∈ S, i.2 ∈ C := fun i hi =>
      Algebra.subset_adjoin (Finset.mem_coe.mpr
        (Finset.mem_union_left _ (Finset.mem_image_of_mem _ hi)))
    have hTmem : ∀ i ∈ T, i.2 ∈ C := fun i hi =>
      Algebra.subset_adjoin (Finset.mem_coe.mpr
        (Finset.mem_union_right _ (Finset.mem_image_of_mem _ hi)))
    obtain ⟨xC, hxC⟩ : ∃ xC : TensorProduct A B C,
        Algebra.TensorProduct.map (AlgHom.id A B) C.val xC = x := by
      refine ⟨∑ i ∈ S.attach, i.1.1 ⊗ₜ[A] (⟨i.1.2, hSmem i.1 i.2⟩ : C), ?_⟩
      rw [map_sum]
      simp only [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, Subalgebra.coe_val]
      rw [hS]
      exact Finset.sum_attach S (fun i => i.1 ⊗ₜ[A] i.2)
    obtain ⟨yC, hyC⟩ : ∃ yC : TensorProduct A B C,
        Algebra.TensorProduct.map (AlgHom.id A B) C.val yC = y := by
      refine ⟨∑ i ∈ T.attach, i.1.1 ⊗ₜ[A] (⟨i.1.2, hTmem i.1 i.2⟩ : C), ?_⟩
      rw [map_sum]
      simp only [Algebra.TensorProduct.map_tmul, AlgHom.id_apply, Subalgebra.coe_val]
      rw [hT]
      exact Finset.sum_attach T (fun i => i.1 ⊗ₜ[A] i.2)

    have hlin : ∀ z : TensorProduct A B C,
        Algebra.TensorProduct.map (AlgHom.id A B) C.val z =
          LinearMap.lTensor B (C.val.toLinearMap) z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul a c => simp
      | add a b ha hb => rw [map_add, map_add, ha, hb]
    have hinj : Function.Injective (Algebra.TensorProduct.map (AlgHom.id A B) C.val) := by
      intro a b hab
      rw [hlin, hlin] at hab
      exact Module.Flat.lTensor_preserves_injective_linearMap (C.val.toLinearMap)
        Subtype.val_injective hab
    have hxyC : xC * yC = 0 := hinj (by rw [map_mul, hxC, hyC, map_zero, hxy])
    have hxC0 : xC ≠ 0 := fun h0 => hx0 (by rw [← hxC, h0, map_zero])
    have hyC0 : yC ≠ 0 := fun h0 => hy0 (by rw [← hyC, h0, map_zero])
    obtain ⟨l, hl⟩ : ∃ l, (TensorProduct.equivFinsuppOfBasisLeft
        (Module.Basis.ofVectorSpace A B) xC) l ≠ 0 := by
      by_contra hc
      push_neg at hc
      apply hxC0
      apply (TensorProduct.equivFinsuppOfBasisLeft (Module.Basis.ofVectorSpace A B)).injective
      rw [map_zero]
      exact Finsupp.ext hc
    obtain ⟨m, hm⟩ : ∃ m, (TensorProduct.equivFinsuppOfBasisLeft
        (Module.Basis.ofVectorSpace A B) yC) m ≠ 0 := by
      by_contra hc
      push_neg at hc
      apply hyC0
      apply (TensorProduct.equivFinsuppOfBasisLeft (Module.Basis.ofVectorSpace A B)).injective
      rw [map_zero]
      exact Finsupp.ext hc
    have hc : (TensorProduct.equivFinsuppOfBasisLeft (Module.Basis.ofVectorSpace A B) xC) l *
        (TensorProduct.equivFinsuppOfBasisLeft (Module.Basis.ofVectorSpace A B) yC) m ≠ 0 :=
      mul_ne_zero hl hm

    haveI : Algebra.FiniteType A C :=
      (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset s)
    haveI : IsJacobsonRing C := isJacobsonRing_of_finiteType (A := A)
    have hbot : (⊥ : Ideal C).jacobson = ⊥ := IsJacobsonRing.out' _ Ideal.isRadical_bot
    obtain ⟨M, hMmax, hcM⟩ : ∃ M : Ideal C, M.IsMaximal ∧
        (TensorProduct.equivFinsuppOfBasisLeft (Module.Basis.ofVectorSpace A B) xC) l *
        (TensorProduct.equivFinsuppOfBasisLeft (Module.Basis.ofVectorSpace A B) yC) m ∉ M := by
      by_contra hcon
      push_neg at hcon
      apply hc
      have hmem : (TensorProduct.equivFinsuppOfBasisLeft (Module.Basis.ofVectorSpace A B) xC) l *
          (TensorProduct.equivFinsuppOfBasisLeft (Module.Basis.ofVectorSpace A B) yC) m ∈
            (⊥ : Ideal C).jacobson := by
        rw [Ideal.jacobson.eq_1, Ideal.mem_sInf]
        intro J hJ
        exact hcon J hJ.2
      rw [hbot] at hmem
      exact (Submodule.mem_bot _).mp hmem
    have hlM : (TensorProduct.equivFinsuppOfBasisLeft (Module.Basis.ofVectorSpace A B) xC) l ∉ M :=
      fun h' => hcM (M.mul_mem_right _ h')
    have hmM : (TensorProduct.equivFinsuppOfBasisLeft (Module.Basis.ofVectorSpace A B) yC) m ∉ M :=
      fun h' => hcM (M.mul_mem_left _ h')
    have key : ∀ (z : TensorProduct A B C) (j : Module.Basis.ofVectorSpaceIndex A B),
        (TensorProduct.equivFinsuppOfBasisLeft (Module.Basis.ofVectorSpace A B)
          (Algebra.TensorProduct.map (AlgHom.id A B) (Ideal.Quotient.mkₐ A M) z)) j =
        Ideal.Quotient.mk M
          ((TensorProduct.equivFinsuppOfBasisLeft (Module.Basis.ofVectorSpace A B) z) j) := by
      intro z j
      rw [coords C (C ⧸ M) (Ideal.Quotient.mkₐ A M) z, Finsupp.mapRange_apply,
        Ideal.Quotient.mkₐ_eq_mk]
    have hπx : Algebra.TensorProduct.map (AlgHom.id A B) (Ideal.Quotient.mkₐ A M) xC ≠ 0 := by
      intro h0
      have h1 := key xC l
      rw [h0, map_zero, Finsupp.coe_zero, Pi.zero_apply] at h1
      exact hlM (Ideal.Quotient.eq_zero_iff_mem.mp h1.symm)
    have hπy : Algebra.TensorProduct.map (AlgHom.id A B) (Ideal.Quotient.mkₐ A M) yC ≠ 0 := by
      intro h0
      have h1 := key yC m
      rw [h0, map_zero, Finsupp.coe_zero, Pi.zero_apply] at h1
      exact hmM (Ideal.Quotient.eq_zero_iff_mem.mp h1.symm)
    have hprod : Algebra.TensorProduct.map (AlgHom.id A B) (Ideal.Quotient.mkₐ A M) xC *
        Algebra.TensorProduct.map (AlgHom.id A B) (Ideal.Quotient.mkₐ A M) yC = 0 := by
      rw [← map_mul, hxyC, map_zero]
    haveI := hMmax
    letI : Field (C ⧸ M) := Ideal.Quotient.field M
    haveI : Algebra.FiniteType A (C ⧸ M) :=
      Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ A M) (Ideal.Quotient.mkₐ_surjective A M)
    haveI : Module.Finite A (C ⧸ M) := finite_of_finite_type_of_isJacobsonRing A (C ⧸ M)
    haveI hdom := h (C ⧸ M)
    exact mul_ne_zero hπx hπy hprod
  exact NoZeroDivisors.to_isDomain _

theorem wcpa_dj_cf_gim_proj_chart : ∀ (K : Type u) [Field K] (N : ℕ), ∃ (C : (wcProjK K N).Opens) (e : Fin (N + 1) → Γ(wcProjK K N, C)), IsAffineOpen C ∧ e 0 = 1 ∧ (∀ t : Γ(wcProjK K N, C), t ∈ Subring.closure (Set.range (((wcProjK K N).presheaf.map (homOfLE (le_top : C ≤ ⊤)).op).hom.comp ((wcProjKStr K N).appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom)) ∪ Set.range e)) ∧ ∀ (V : Scheme.{u}) (fV : V ⟶ Spec (.of K)) (s : Fin (N + 1) → Γ(V, ⊤)), s 0 = 1 → ∃ (φ : V ⟶ wcProjK K N) (hφ : ⊤ ≤ φ ⁻¹ᵁ C), φ ≫ wcProjKStr K N = fV ∧ ∀ L, φ.appLE C ⊤ hφ (e L) = s L :=
by
  have hres : ∀ (X : Scheme.{u}) (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(X, A)),
      X.presheaf.map (homOfLE h2).op (X.presheaf.map (homOfLE h1).op x) =
        X.presheaf.map (homOfLE h3).op x := by
    intro X A B C h1 h2 h3 x
    rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl

  have S1 : ∀ (K : Type u) [Field K] (n : ℕ) (J : Fin (n + 1)) (x : Γ(wcProjK K n, wcSgD K n J)),
      x ∈ Subring.closure (Set.range (wcSgE K n J) ∪ Set.range (fun c : K => (wcProjK K n).presheaf.map
        (homOfLE (le_top : wcSgD K n J ≤ ⊤)).op ((wcProjKStr K n).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))) := by
    intro K _ n
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    intro J x
    have GEN : ∀ (k : Fin (n + 1)) (d : ℕ) (F : MvPolynomial (Fin (n + 1)) K)
        (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (d • 1)),
        MvPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X k))).comp
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))
          (fun l => HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) 1
            (MvPolynomial.X l) (hX l)) F =
        HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) d F hF := by
      intro k d F hF
      have hFh : F.IsHomogeneous d := by
        have := (MvPolynomial.mem_homogeneousSubmodule (d • 1) F).mp hF
        simpa using this
      have scale : ∀ {L : Type u} [CommRing L] (χ : K →+* L) (g : Fin (n + 1) → L) (t : L),
          MvPolynomial.eval₂ χ (fun l => g l * t) F = t ^ d * MvPolynomial.eval₂ χ g F := by
        intro L _ χ g t
        rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun e he => ?_)
        have hdeg : ∑ i ∈ e.support, e i = d := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp he) (hFh.coeff_eq_zero hne)
        simp_rw [mul_pow]
        rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
        ring
      apply HomogeneousLocalization.val_injective
      rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply,
        MvPolynomial.eval₂_comp_left, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      calc _ = MvPolynomial.eval₂
            ((algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))).comp
              MvPolynomial.C)
            (fun l => algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))
              (MvPolynomial.X l) * Localization.mk 1 (⟨MvPolynomial.X k ^ 1, ⟨1, rfl⟩⟩ :
                Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))) F := by
            congr 1
            funext l
            simp only [Function.comp_apply, HomogeneousLocalization.algebraMap_apply,
              HomogeneousLocalization.Away.val_mk, ← Localization.mk_one_eq_algebraMap,
              Localization.mk_mul, mul_one, one_mul]
        _ = _ := by
            rw [scale]
            have h2 := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))))
              MvPolynomial.C MvPolynomial.X F
            rw [MvPolynomial.eval₂_eta] at h2
            rw [show (fun l => algebraMap (MvPolynomial (Fin (n + 1)) K)
