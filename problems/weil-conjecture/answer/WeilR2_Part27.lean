        ((θr.hom.hom.app (Opposite.op (Over.mk (v ≫ γ)))).hom x).down) z =
      g ((show C(↥V₁.left, Fin k → ZMod (ℓ ^ r)) from
        ((θr.hom.hom.app (Opposite.op (Over.mk v))).hom x).down) z) := by
