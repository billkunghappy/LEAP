by
  classical
  have hhom := wc_pencil_E_hom_const_zero_nm F' F'' Y n hn hn2 D hNM ℓ hℓ hP hNI
  obtain ⟨W, w, r, θ, φ, hB⟩ := wc_vqm_galois_frame_exists F' F'' Y n hn hn2 D ℓ hℓ hP hNI
  obtain ⟨Γ, Φ, hΦ, hΓ, hnorm, -, -, -⟩ :=
    wc_vqm_frame_group F' F'' Y n hn hn2 D ℓ hℓ hP W w r θ φ hB
  obtain ⟨e, J, he, hJ, hJdet, hΓJ, hΦeJ, hall⟩ :=
    wc_vqtt_frame_cup_tensor_trace F' F'' Y n hn hn2 D ℓ hℓ hP hNI hhom W w r θ φ hB Γ Φ hΦ hΓ
  obtain ⟨m, v₀, ε, Ts, hT, hF, hspan, hgen⟩ :=
    wc_vqm_vanishing_system_hz F' F'' Y n hn hn2 D ℓ hℓ hP hNI hhom W w r θ φ hB Γ Φ hΦ hΓ
      J hJ hJdet hΓJ
  have hq0 : ((Nat.card F'' : ℚ_[ℓ]) ^ (n - 1)) ≠ 0 :=
    pow_ne_zero _ (Nat.cast_ne_zero.mpr Finite.card_pos.ne')

  obtain ⟨μ, hμ, hΦJ⟩ : ∃ μ : ℚ_[ℓ], μ ≠ 0 ∧
      (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J * (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
        μ • J := by
    rcases he with rfl | rfl
    · refine ⟨_, hq0, ?_⟩
      simpa using hΦeJ
    · refine ⟨((Nat.card F'' : ℚ_[ℓ]) ^ (n - 1))⁻¹, inv_ne_zero hq0, ?_⟩
      rw [zpow_neg_one] at hΦeJ
      have hXΦ : ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
          (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = 1 := Φ.inv_mul
      have key : (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose *
          (((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
            ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ])) *
          (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = J := by
        calc _ = (((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
              (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ])).transpose * J *
              (((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
              (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ])) := by
              rw [Matrix.transpose_mul]
              simp only [Matrix.mul_assoc]
          _ = J := by rw [hXΦ]; simp
      rw [hΦeJ, Matrix.mul_smul, Matrix.smul_mul] at key
      conv_rhs => rw [← key]
      rw [smul_smul, inv_mul_cancel₀ hq0, one_smul]
  obtain ⟨t, b, P, P', hPP', hP'P, hJb, hΦb, hΦib, m₀, happrox⟩ :=
    wc_vqtt_block_frame_coordinates ℓ r m J Γ Φ μ v₀ ε Ts hJ hJdet hnorm hΓJ hμ hΦJ hT hF hspan
      hgen
  have hPdet : IsUnit P.det := Matrix.isUnit_det_of_right_inverse hPP'
  have h1 : P'.transpose * P.transpose = 1 := by
    rw [← Matrix.transpose_mul, hPP', Matrix.transpose_one]
  refine ⟨r, t, b, P.transpose * J * P,
    {s | s.transpose * (P.transpose * J * P) * s = P.transpose * J * P ∧
      (∀ p q, b p ≠ b q → s p q = 0) ∧
      ∀ a a', ‖s a a' - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a a'‖ ≤ (ℓ : ℝ) ^ (-(m₀ : ℤ))},
    P' * ((Φ ^ e : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * P,
    ?_, ?_, hJb, ⟨m₀, fun s hs1 hs2 hs3 => ⟨hs1, hs2, hs3⟩⟩, ?_, ?_, ?_⟩
  · rw [Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_transpose, hJ]
    simp [Matrix.mul_assoc]
  · rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
    exact (hPdet.mul hJdet).mul hPdet
  · rcases he with rfl | rfl
    · simpa using hΦb
    · rw [zpow_neg_one]
      exact hΦib
  · calc (P' * ((Φ ^ e : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
            P).transpose * (P.transpose * J * P) *
          (P' * ((Φ ^ e : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * P)
        = P.transpose *
            (((Φ ^ e : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose *
              (P'.transpose * P.transpose) * J * (P * P') *
              ((Φ ^ e : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ])) * P := by
          rw [Matrix.transpose_mul, Matrix.transpose_mul]
          simp only [Matrix.mul_assoc]
      _ = P.transpose *
            (((Φ ^ e : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose *
              J * ((Φ ^ e : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ])) * P := by
          rw [h1, hPP', Matrix.mul_one, Matrix.mul_one]
      _ = ((Nat.card F'' : ℚ_[ℓ]) ^ (n - 1)) • (P.transpose * J * P) := by
          rw [hΦeJ, Matrix.mul_smul, Matrix.smul_mul]
  · intro k hk
    obtain ⟨N, T₀, A, Hk, hlin, hinv, hA, htr⟩ := hall k hk
    obtain ⟨c7a, c7b, c7c, c7d⟩ := wc_vqtt_tensor_transport_closure ℓ r k N P P' hPP' hP'P T₀
    refine ⟨N, fun l i => ∑ j, T₀ l j * ∏ a, P (j a) (i a), A, Hk, c7a hlin, ?_, ?_, htr⟩
    · intro l s hs i
      obtain ⟨hs1, hs2, hs3⟩ := hs
