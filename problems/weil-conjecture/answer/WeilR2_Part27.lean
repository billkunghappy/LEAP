      rw [hkq] at hb
      simp only [Nat.cast_pow, norm_mul, norm_inv, norm_pow, Padic.norm_p, inv_pow, inv_inv] at hb
      have hkn : ‖(k : ℚ_[ℓ])‖ ≤ (ℓ : ℝ) ^ (-(r : ℤ)) := by
        rw [zpow_neg, zpow_natCast, inv_eq_one_div, le_div_iff₀ (by positivity)]
        have e : (ℓ : ℝ) ^ (r + (c + m + K)) =
            (ℓ : ℝ) ^ r * (ℓ : ℝ) ^ c * (ℓ : ℝ) ^ m * (ℓ : ℝ) ^ K := by
          rw [pow_add, pow_add, pow_add]; ring
        rw [e] at hb
        have hc0 : (ℓ : ℝ) ^ c ≠ 0 := by positivity
        have hm0 : (ℓ : ℝ) ^ m ≠ 0 := by positivity
        have hK0 : (0 : ℝ) < (ℓ : ℝ) ^ K := by positivity
        have e2 : (ℓ : ℝ) ^ r * (ℓ : ℝ) ^ c * (ℓ : ℝ) ^ m * (ℓ : ℝ) ^ K *
            (((ℓ : ℝ) ^ c)⁻¹ * (‖(k : ℚ_[ℓ])‖ * ((ℓ : ℝ) ^ m)⁻¹)) =
            (ℓ : ℝ) ^ K * (‖(k : ℚ_[ℓ])‖ * (ℓ : ℝ) ^ r) := by
          calc _ = ((ℓ : ℝ) ^ K * (‖(k : ℚ_[ℓ])‖ * (ℓ : ℝ) ^ r)) * ((ℓ : ℝ) ^ c * ((ℓ : ℝ) ^ c)⁻¹)
                * ((ℓ : ℝ) ^ m * ((ℓ : ℝ) ^ m)⁻¹) := by ring
            _ = _ := by rw [mul_inv_cancel₀ hc0, mul_inv_cancel₀ hm0]; ring
        rw [e2] at hb
        exact le_of_mul_le_mul_left (by rw [mul_one]; exact hb) hK0
      have hdvd := (Padic.norm_int_le_pow_iff_dvd k r).mp hkn
      have hlt : |k| < (ℓ : ℤ) ^ r := by
        have h1 : ((a i : ℕ) : ℤ) < (ℓ : ℤ) ^ r := by exact_mod_cast (a i).isLt
        have h2 : ((a' i : ℕ) : ℤ) < (ℓ : ℤ) ^ r := by exact_mod_cast (a' i).isLt
        have h3 : (0 : ℤ) ≤ ((a i : ℕ) : ℤ) := by positivity
        have h4 : (0 : ℤ) ≤ ((a' i : ℕ) : ℤ) := by positivity
        rw [abs_lt]
        constructor <;> linarith
      have hk0 := Int.eq_zero_of_abs_lt_dvd hdvd hlt
      apply Fin.ext
      omega
    have hc := Fintype.card_le_of_injective τ hinj
    simp only [Fintype.card_fun, Fintype.card_fin] at hc
    rw [← pow_mul, ← pow_mul] at hc
    exact (Nat.pow_le_pow_iff_right hℓ1).mp hc
  by_contra hlt
  push_neg at hlt
  have h1 := hcount ((c + m + K) * d + 1)
  nlinarith [Nat.mul_le_mul_left ((c + m + K) * d + 1) hlt]

theorem wc_vqtt_H2_coinv_surj (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (hm : 1 ≤ m) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hzero : wcZeroAtS K m S G)
    (ι' : Type) [Fintype ι'] [DecidableEq ι']
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (θG : G.over W ≅ (wcContSheaf (wcP1Over K).left (ι' → ℚ_[ℓ])).over W)
    (hθc : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
          θG.hom =
        θG.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map
          (wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) c)
            (continuous_const_smul c)))
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin m), W.hom z ≠ S i (IsLocalRing.closedPoint K))
    (hcov : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (hgal : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ) :
    ∃ Pr : (ι' → ℚ_[ℓ]) →+ wcCohG K (wcP1Over K) hP G 2,
      Function.Surjective Pr ∧
      (∀ (c : ℚ_[ℓ]) (v : ι' → ℚ_[ℓ]),
        Pr (c • v) = wcCohGEnd K (wcP1Over K) hP G 2 (σ c) (Pr v)) ∧
      ∀ (γ : W ⟶ W) (g : Matrix ι' ι' ℚ_[ℓ]), γ ≫ w = w →
        (∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
          (show C(↥W.left, ι' → ℚ_[ℓ]) from ((θG.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
          g.mulVec ((show C(↥W.left, ι' → ℚ_[ℓ]) from
            ((θG.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
        ∀ v, Pr (g.mulVec v) = Pr v :=
by
  classical

  have hs := wc_vqtt_H2_scalar_module K hP ℓ hℓ m hm S hS G σ ι' W w θG hθc hqc hcov

  have key : ∀ (N : Submodule ℚ_[ℓ] (ι' → ℚ_[ℓ])),
      (∀ (n : ℕ) (x : Fin n → wcCohG K (wcP1Over K) hP G 2),
        (∀ c : Fin n → ℚ_[ℓ], ∑ i, wcCohGEnd K (wcP1Over K) hP G 2 (σ (c i)) (x i) = 0 → c = 0) →
        n ≤ Module.finrank ℚ_[ℓ] ((ι' → ℚ_[ℓ]) ⧸ N)) →
      ∃ Pr : (ι' → ℚ_[ℓ]) →+ wcCohG K (wcP1Over K) hP G 2,
        Function.Surjective Pr ∧
        (∀ (c : ℚ_[ℓ]) (v : ι' → ℚ_[ℓ]),
          Pr (c • v) = wcCohGEnd K (wcP1Over K) hP G 2 (σ c) (Pr v)) ∧
        ∀ v ∈ N, Pr v = 0 := by
    intro N hb
    letI inst : Module ℚ_[ℓ] (wcCohG K (wcP1Over K) hP G 2) :=
      { smul := fun c y => wcCohGEnd K (wcP1Over K) hP G 2 (σ c) y
        one_smul := fun y => (hs 0 0 y).2.2
        mul_smul := fun a b y => (hs a b y).2.1
        smul_zero := fun a => map_zero _
        smul_add := fun a x y => map_add _ x y
        add_smul := fun a b y => (hs a b y).1
        zero_smul := fun y => by
          show wcCohGEnd K (wcP1Over K) hP G 2 (σ 0) y = 0
          have h := (hs 0 0 y).1
          rw [add_zero] at h
          calc wcCohGEnd K (wcP1Over K) hP G 2 (σ 0) y
              = wcCohGEnd K (wcP1Over K) hP G 2 (σ 0) y + wcCohGEnd K (wcP1Over K) hP G 2 (σ 0) y
                  - wcCohGEnd K (wcP1Over K) hP G 2 (σ 0) y := by abel
            _ = wcCohGEnd K (wcP1Over K) hP G 2 (σ 0) y
                  - wcCohGEnd K (wcP1Over K) hP G 2 (σ 0) y := by rw [← h]
            _ = 0 := sub_self _ }
    have hli : ∀ (n : ℕ) (x : Fin n → wcCohG K (wcP1Over K) hP G 2),
        LinearIndependent ℚ_[ℓ] x → n ≤ Module.finrank ℚ_[ℓ] ((ι' → ℚ_[ℓ]) ⧸ N) := by
      intro n x hx
      apply hb n x
      intro c hc
      funext i
      exact (Fintype.linearIndependent_iff.mp hx) c hc i
    have hrank : Module.rank ℚ_[ℓ] (wcCohG K (wcP1Over K) hP G 2) ≤
        ((Module.finrank ℚ_[ℓ] ((ι' → ℚ_[ℓ]) ⧸ N) : ℕ) : Cardinal) := by
      apply rank_le
      intro s hs'
      exact hli s.card _ (hs'.comp _ s.equivFin.symm.injective)
    have hlt : Module.rank ℚ_[ℓ] (wcCohG K (wcP1Over K) hP G 2) < Cardinal.aleph0 :=
      lt_of_le_of_lt hrank (by first | exact Cardinal.natCast_lt_aleph0 | exact Cardinal.nat_lt_aleph0 _)
    haveI : FiniteDimensional ℚ_[ℓ] (wcCohG K (wcP1Over K) hP G 2) := by
      first
      | exact Module.rank_lt_aleph0_iff.mp hlt
      | exact FiniteDimensional.of_rank_lt_aleph0 hlt
      | exact Module.finite_of_rank_lt_aleph0 hlt
    let bH := Module.finBasis ℚ_[ℓ] (wcCohG K (wcP1Over K) hP G 2)
    let bQ := Module.finBasis ℚ_[ℓ] ((ι' → ℚ_[ℓ]) ⧸ N)
    have hed : Module.finrank ℚ_[ℓ] (wcCohG K (wcP1Over K) hP G 2) ≤
        Module.finrank ℚ_[ℓ] ((ι' → ℚ_[ℓ]) ⧸ N) := hli _ _ bH.linearIndependent
    let L : ((ι' → ℚ_[ℓ]) ⧸ N) →ₗ[ℚ_[ℓ]] wcCohG K (wcP1Over K) hP G 2 :=
      bQ.constr ℚ_[ℓ] (fun i => if h : (i : ℕ) < Module.finrank ℚ_[ℓ]
        (wcCohG K (wcP1Over K) hP G 2) then bH ⟨i, h⟩ else 0)
    have hLb : ∀ j : Fin (Module.finrank ℚ_[ℓ] (wcCohG K (wcP1Over K) hP G 2)),
        L (bQ ⟨j, lt_of_lt_of_le j.2 hed⟩) = bH j := by
      intro j
      show (bQ.constr ℚ_[ℓ] _) (bQ _) = _
      rw [Module.Basis.constr_basis]
      first
      | exact dif_pos j.2
      | simp
    have hLs : Function.Surjective L := by
      rw [← LinearMap.range_eq_top]
      apply eq_top_iff.mpr
      rw [← bH.span_eq, Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, LinearMap.mem_range]
      exact ⟨_, hLb j⟩
    refine ⟨(L.comp N.mkQ).toAddMonoidHom, ?_, ?_, ?_⟩
    · intro y
      obtain ⟨q, rfl⟩ := hLs y
      obtain ⟨v, rfl⟩ := N.mkQ_surjective q
      exact ⟨v, rfl⟩
    · intro c v
      exact (L.comp N.mkQ).map_smul c v
    · intro v hv
      show L (N.mkQ v) = 0
      rw [Submodule.mkQ_apply, (Submodule.Quotient.mk_eq_zero N).mpr hv, map_zero]

  obtain ⟨A, instA, instMA, ι₀, hι₀, hspan, B, instB, π, hker, hsep, Γ, hΓ, Nz, hΓN, Q,
    hNz, hNq⟩ :=
    wc_vqtt_H2_lattice_levels K hP ℓ hℓ m hm S hS G σ hzero ι' W w θG hθc hqc hconn hoff hcov hgal

  have hbound := wc_vqtt_zl_rank_bound ℓ ι' (wcCohG K (wcP1Over K) hP G 2)
    (fun c => wcCohGEnd K (wcP1Over K) hP G 2 (σ c))
    (fun a b y => (hs a b y).1) (fun a b y => (hs a b y).2.1) (fun y => (hs 0 0 y).2.2)
    A ι₀ hι₀ hspan B π hker hsep Γ hΓ Nz hΓN _ Q hNz hNq
  obtain ⟨Pr, hsurj, hlin, hker0⟩ := key _ hbound
  refine ⟨Pr, hsurj, hlin, ?_⟩
  intro γ g hγ hg v
  have h0 := hker0 (g.mulVec v - v) (Submodule.subset_span ⟨γ, g, v, hγ, hg, rfl⟩)
  rw [map_sub, sub_eq_zero] at h0
  exact h0

theorem wc_vqtt_slice_hom_rigid (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left)
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (a : wcGeomPoint K (wcP1Over K) hP ⟶ wcGeomPoint K (wcP1Over K) hP)
    (ψ₁ ψ₂ : G.over (wcGeomPoint K (wcP1Over K) hP) ⟶
        (wcLadicSheaf (wcP1Over K).left ℓ).over (wcGeomPoint K (wcP1Over K) hP))
    (hagree : ∀ (V : (wcP1Over K).left.ProEt) (h' : V ⟶ W) (y : G.obj.obj (Opposite.op V))
      (z : V.left),
      (show C(↥V.left, ℚ_[ℓ]) from
        ((ψ₁.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom y).down) z =
      (show C(↥V.left, ℚ_[ℓ]) from
        ((ψ₂.hom.app (Opposite.op (Over.mk ((h' ≫ w) ≫ a)))).hom y).down) z) :
    ∀ V : Over (wcGeomPoint K (wcP1Over K) hP),
      ψ₁.hom.app (Opposite.op V) = ψ₂.hom.app (Opposite.op (Over.mk (V.hom ≫ a))) :=
by

  have hclosed : ∀ i, IsClosed ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left) := by
    intro i
    haveI : IsSeparated (wcP1Over K).hom := by
      first
        | infer_instance
        | (show IsSeparated (_ ≫ _); infer_instance)
    haveI : IsClosedImmersion (S i ≫ (wcP1Over K).hom) := by
      rw [hS i]; infer_instance
    haveI : IsClosedImmersion (S i) := IsClosedImmersion.of_comp (S i) (wcP1Over K).hom
    have hr : IsClosed (Set.range (S i)) := (S i).isClosedEmbedding.isClosed_range
    have hrange : Set.range (S i) = {S i (IsLocalRing.closedPoint K)} := by
      ext y
      constructor
      · rintro ⟨z, rfl⟩
        rw [Subsingleton.elim z (IsLocalRing.closedPoint K)]
        rfl
      · rintro rfl
        exact ⟨_, rfl⟩
    rwa [hrange] at hr

  have hlift : ∀ (T : (wcP1Over K).left.ProEt) (t : T ⟶ wcGeomPoint K (wcP1Over K) hP)
      (τ : T.left), (∀ i, T.hom τ ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ (V : (wcP1Over K).left.ProEt) (h : V ⟶ T) (h' : V ⟶ W) (v : V.left),
        h' ≫ w = h ≫ t ∧ h.left v = τ := by
    intro T t τ hτ
    let U' : (wcP1Over K).left.Opens :=
      ⟨⋂ i, ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left)ᶜ,
        isOpen_iInter_of_finite (fun i => (hclosed i).isOpen_compl)⟩
    let O : T.left.Opens := T.hom ⁻¹ᵁ U'
    have hmemO : ∀ x : T.left, x ∈ O ↔ ∀ i, T.hom x ≠ S i (IsLocalRing.closedPoint K) := by
      intro x
      change T.hom x ∈ ⋂ i, ({S i (IsLocalRing.closedPoint K)} : Set (wcP1Over K).left)ᶜ ↔ _
      exact Set.mem_iInter.trans (forall_congr' fun i => Iff.rfl)
    have hrangeO : ∀ x : T.left, x ∈ O → ∃ y : O.toScheme, O.ι y = x := by
      intro x hx
      have hx' : x ∈ Set.range O.ι := by
        rw [Scheme.Opens.range_ι]; exact hx
      exact hx'
    haveI := hqc
    haveI hWp : WeaklyEtale W.hom := W.prop
    haveI hUp : WeaklyEtale (wcGeomPoint K (wcP1Over K) hP).hom :=
      (wcGeomPoint K (wcP1Over K) hP).prop
    haveI hwU : WeaklyEtale (w.left ≫ (wcGeomPoint K (wcP1Over K) hP).hom) := by
      rw [MorphismProperty.Over.w w]; exact hWp
    haveI : WeaklyEtale w.left := WeaklyEtale.of_comp w.left (wcGeomPoint K (wcP1Over K) hP).hom
    haveI hTp : WeaklyEtale T.hom := T.prop
    haveI hOw : WeaklyEtale O.ι := by
      first
        | exact etale_le_weaklyEtale _ (inferInstance : Etale O.ι)
        | exact etale_le_weaklyEtale _ _ _ (inferInstance : Etale O.ι)
        | infer_instance
    haveI hfst : WeaklyEtale (Limits.pullback.fst (O.ι ≫ t.left) w.left) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst (O.ι ≫ t.left) w.left ≫ O.ι ≫ T.hom) :=
      inferInstance
    let V : (wcP1Over K).left.ProEt :=
      Scheme.ProEt.mk (Limits.pullback.fst (O.ι ≫ t.left) w.left ≫ O.ι ≫ T.hom)
    let h : V ⟶ T := MorphismProperty.Over.homMk
      (Limits.pullback.fst (O.ι ≫ t.left) w.left ≫ O.ι) (Category.assoc _ _ _) trivial
    have hb : Limits.pullback.snd (O.ι ≫ t.left) w.left ≫ W.hom =
        Limits.pullback.fst (O.ι ≫ t.left) w.left ≫ O.ι ≫ T.hom := by
      rw [← MorphismProperty.Over.w w, ← MorphismProperty.Over.w t, ← Category.assoc,
        ← Limits.pullback.condition]
      simp only [Category.assoc]
    let h' : V ⟶ W := MorphismProperty.Over.homMk (Limits.pullback.snd (O.ι ≫ t.left) w.left) hb
      trivial
    have hcomm : h' ≫ w = h ≫ t := by
      apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition.symm.trans (Category.assoc _ _ _).symm
    have hpt : ∀ v : V.left, h.left v = O.ι (Limits.pullback.fst (O.ι ≫ t.left) w.left v) := by
      intro v
      show (Limits.pullback.fst (O.ι ≫ t.left) w.left ≫ O.ι) v = _
      first
        | rfl
        | simp only [Scheme.Hom.comp_apply]
    have hπs : Function.Surjective (Limits.pullback.fst (O.ι ≫ t.left) w.left) := by
      intro x
      have hx : O.ι x ∈ O := (Scheme.Opens.range_ι O).subset ⟨x, rfl⟩
      have e1 : (wcGeomPoint K (wcP1Over K) hP).hom ((O.ι ≫ t.left) x) = T.hom (O.ι x) := by
        have h1 : t.left ≫ (wcGeomPoint K (wcP1Over K) hP).hom = T.hom :=
          MorphismProperty.Over.w t
        have h2 := congrArg (fun f => f (O.ι x)) h1
        simpa only [Scheme.Hom.comp_apply] using h2
      have hu : ∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom ((O.ι ≫ t.left) x) ≠
          S i (IsLocalRing.closedPoint K) := by
        rw [e1]; exact (hmemO _).mp hx
      obtain ⟨z, hz⟩ := hsurj _ hu
      obtain ⟨v, hv, -⟩ := Scheme.Pullback.exists_preimage_pullback x z hz.symm
      exact ⟨v, hv⟩
    obtain ⟨y, hy⟩ := hrangeO τ ((hmemO τ).mpr hτ)
    obtain ⟨v, hv⟩ := hπs y
    refine ⟨V, h, h', v, hcomm, ?_⟩
    rw [hpt v, hv, hy]

  have hnat : ∀ (ψ : G.over (wcGeomPoint K (wcP1Over K) hP) ⟶
        (wcLadicSheaf (wcP1Over K).left ℓ).over (wcGeomPoint K (wcP1Over K) hP))
      (X : Over (wcGeomPoint K (wcP1Over K) hP)) (V' : (wcP1Over K).left.ProEt)
      (h : V' ⟶ X.left) (s : G.obj.obj (Opposite.op X.left)) (v : V'.left),
      (show C(↥X.left.left, ℚ_[ℓ]) from ((ψ.hom.app (Opposite.op X)).hom s).down) (h.left v) =
      (show C(↥V'.left, ℚ_[ℓ]) from
        ((ψ.hom.app (Opposite.op (Over.mk (h ≫ X.hom)))).hom ((G.obj.map h.op).hom s)).down) v := by
    intro ψ X V' h s v
    have e := congrArg (fun f => (show C(↥V'.left, ℚ_[ℓ]) from (f.hom s).down) v)
      (ψ.hom.naturality (Over.homMk h : Over.mk (h ≫ X.hom) ⟶ X).op)
    exact e.symm

  have htr : ∀ (ψ : G.over (wcGeomPoint K (wcP1Over K) hP) ⟶
        (wcLadicSheaf (wcP1Over K).left ℓ).over (wcGeomPoint K (wcP1Over K) hP))
      (V' : (wcP1Over K).left.ProEt) (X Y : V' ⟶ wcGeomPoint K (wcP1Over K) hP), X = Y →
      ∀ (y : G.obj.obj (Opposite.op V')) (v : V'.left),
      (show C(↥V'.left, ℚ_[ℓ]) from ((ψ.hom.app (Opposite.op (Over.mk X))).hom y).down) v =
      (show C(↥V'.left, ℚ_[ℓ]) from ((ψ.hom.app (Opposite.op (Over.mk Y))).hom y).down) v := by
    rintro ψ V' X Y rfl y v
    rfl
  intro V
  apply AddCommGrpCat.ext
  intro s
  apply ULift.ext
  apply ContinuousMap.ext
  intro τ
  change (show C(↥V.left.left, ℚ_[ℓ]) from ((ψ₁.hom.app (Opposite.op V)).hom s).down) τ =
    (show C(↥V.left.left, ℚ_[ℓ]) from
      ((ψ₂.hom.app (Opposite.op (Over.mk (V.hom ≫ a)))).hom s).down) τ
  set f₁ : C(↥V.left.left, ℚ_[ℓ]) := ((ψ₁.hom.app (Opposite.op V)).hom s).down with hf₁
  set f₂ : C(↥V.left.left, ℚ_[ℓ]) :=
    ((ψ₂.hom.app (Opposite.op (Over.mk (V.hom ≫ a)))).hom s).down with hf₂
  have hoff : ∀ y : V.left.left, (∀ i, V.left.hom y ≠ S i (IsLocalRing.closedPoint K)) →
      f₁ y = f₂ y := by
    intro y hy
    obtain ⟨V', h, h', v, hcomm, hv⟩ := hlift V.left V.hom y hy
    rw [← hv]
    have n1 := hnat ψ₁ V V' h s v
    have n2 := hnat ψ₂ (Over.mk (V.hom ≫ a)) V' h s v
    have t1 := htr ψ₁ V' (h' ≫ w) (h ≫ V.hom) hcomm ((G.obj.map h.op).hom s) v
    have t2 := htr ψ₂ V' ((h' ≫ w) ≫ a) (h ≫ (V.hom ≫ a))
      (by rw [hcomm, Category.assoc]) ((G.obj.map h.op).hom s) v
    have hg := hagree V' h' ((G.obj.map h.op).hom s) v
    exact n1.trans (t1.symm.trans (hg.trans (t2.trans n2.symm)))
  have hgen : ∀ (T : (wcP1Over K).left.ProEt) (x : T.left),
      ∃ y ∈ {τ : T.left | ∀ i, T.hom τ ≠ S i (IsLocalRing.closedPoint K)}, y ⤳ x := by
    intro T x
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      MvPolynomial.gradedAlgebra
    have hprime : (⊥ : HomogeneousIdeal
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)).toIdeal.IsPrime := by
      rw [HomogeneousIdeal.toIdeal_bot]
      exact Ideal.isPrime_bot
    have hirr : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        ≤ ⊥ := by
      intro h
      have hX0 := HomogeneousIdeal.mem_irrelevant_of_mem
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (i := 1) Nat.one_pos
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
          (MvPolynomial.isHomogeneous_X K (0 : Fin (1 + 1))))
      have h0 := h hX0
      rw [← HomogeneousIdeal.mem_iff, HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at h0
      exact MvPolynomial.X_ne_zero (0 : Fin (1 + 1)) h0
    let η : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      ⟨⊥, hprime, hirr⟩
    have hcl : ∀ y : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K),
        y ∈ closure ({η} : Set _) := fun y =>
      (ProjectiveSpectrum.le_iff_mem_closure _ η y).mp
        ((ProjectiveSpectrum.as_ideal_le_as_ideal _ η y).mp bot_le)
    let ηP : (wcP1Over K).left := η
    have hspec : ∀ y : (wcP1Over K).left, ηP ⤳ y := fun y =>
      specializes_iff_mem_closure.mpr (hcl y)
    have hX0h : ∀ x ∈ ({MvPolynomial.X (0 : Fin (1 + 1))} : Set (MvPolynomial (Fin (1 + 1)) K)),
        SetLike.IsHomogeneousElem (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) x := by
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact ⟨1, (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
        (MvPolynomial.isHomogeneous_X K (0 : Fin (1 + 1)))⟩
    let I0 : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      ⟨Ideal.span {MvPolynomial.X (0 : Fin (1 + 1))},
        Ideal.homogeneous_span (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) _ hX0h⟩
    have hI0toIdeal : I0.toIdeal = Ideal.span {MvPolynomial.X (0 : Fin (1 + 1))} := rfl
    have hprime0 : I0.toIdeal.IsPrime := by
      rw [hI0toIdeal]
      exact (Ideal.span_singleton_prime (MvPolynomial.X_ne_zero _)).mpr MvPolynomial.X_prime
    have hirr0 : ¬ HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K)
        ≤ I0 := by
      intro h
      have hX1 := HomogeneousIdeal.mem_irrelevant_of_mem
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) (i := 1) Nat.one_pos
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr
          (MvPolynomial.isHomogeneous_X K (1 : Fin (1 + 1))))
      have h1 := h hX1
      rw [← HomogeneousIdeal.mem_iff, hI0toIdeal, Ideal.mem_span_singleton,
        MvPolynomial.X_dvd_X] at h1
      exact absurd h1 (by decide)
    let p : ProjectiveSpectrum (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) :=
      ⟨I0, hprime0, hirr0⟩
    have hηp : η ≠ p := by
      intro hEq
      have e := congrArg (fun q : ProjectiveSpectrum
        (MvPolynomial.homogeneousSubmodule (Fin (1 + 1)) K) => q.asHomogeneousIdeal.toIdeal) hEq
      have hmem : MvPolynomial.X (0 : Fin (1 + 1)) ∈ p.asHomogeneousIdeal.toIdeal := by
        show MvPolynomial.X (0 : Fin (1 + 1)) ∈ I0.toIdeal
        rw [hI0toIdeal]
        exact Ideal.subset_span (Set.mem_singleton _)
      have e' : η.asHomogeneousIdeal.toIdeal = p.asHomogeneousIdeal.toIdeal := e
      rw [← e'] at hmem
      have hb : η.asHomogeneousIdeal.toIdeal = ⊥ := HomogeneousIdeal.toIdeal_bot
      rw [hb, Ideal.mem_bot] at hmem
      exact MvPolynomial.X_ne_zero _ hmem
    let pP : (wcP1Over K).left := p
    have hηpP : ηP ≠ pP := hηp
    have hηS : ∀ i, ηP ≠ S i (IsLocalRing.closedPoint K) := by
      intro i hEq
      have h1 : pP ∈ closure ({ηP} : Set (wcP1Over K).left) :=
        specializes_iff_mem_closure.mp (hspec pP)
      rw [hEq, (hclosed i).closure_eq, Set.mem_singleton_iff] at h1
      exact hηpP (hEq.trans h1.symm)
    haveI hTwe : WeaklyEtale T.hom := T.prop
    haveI hTfl : Flat T.hom := inferInstance
    obtain ⟨t', ht't, hη⟩ := Flat.generalizingMap T.hom (hspec (T.hom x))
    refine ⟨t', ?_, ht't⟩
    intro i
    rw [hη]
    exact hηS i
  obtain ⟨y, hyoff, hyτ⟩ := hgen V.left τ
  have e1 : f₁ y = f₁ τ := (hyτ.map f₁.continuous).eq
  have e2 : f₂ y = f₂ τ := (hyτ.map f₂.continuous).eq
  rw [← e1, ← e2]
  exact hoff y hyoff

theorem wc_vqtt_slice_ext_calculus (S : Scheme.{u}) (U : S.ProEt) (n : ℕ) :
    letI : HasExt (Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}) := HasExt.standard _
    ∃ Θ : ∀ (Y Y' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}),
        (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y ⟶
          ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y') →
        (Abelian.Ext (wcFreeSheaf S U) Y n →+ Abelian.Ext (wcFreeSheaf S U) Y' n),
      (∀ Y Y' (ψ₁ ψ₂ : ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y ⟶
          ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y') y,
        Θ Y Y' (ψ₁ + ψ₂) y = Θ Y Y' ψ₁ y + Θ Y Y' ψ₂ y) ∧
      (∀ Y Y' Y'' (ψ : ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y ⟶
          ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y') (f : Y' ⟶ Y'') y,
        Θ Y Y'' (ψ ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map f) y =
          (Θ Y Y' ψ y).comp (Abelian.Ext.mk₀ f) (add_zero n)) ∧
      (∀ Y₀ Y Y' (g : Y₀ ⟶ Y)
          (ψ : ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y ⟶
          ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y') y,
        Θ Y₀ Y' (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).map g ≫ ψ) y =
          Θ Y Y' ψ (y.comp (Abelian.Ext.mk₀ g) (add_zero n))) ∧
      (∀ (a : U ⟶ U) Y Y'
          (ψ ψa : ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y ⟶
          ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y'),
        (∀ V : Over U, ψa.hom.app (Opposite.op V) =
          ψ.hom.app (Opposite.op (Over.mk (V.hom ≫ a)))) →
        ∀ y, Θ Y Y' ψa ((Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp y (zero_add n)) =
          (Abelian.Ext.mk₀ (wcFreeSheafMap S a)).comp (Θ Y Y' ψ y) (zero_add n)) ∧
      (∀ Y Y' (ψ : ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y ⟶
          ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y'),
        (∀ x' : Abelian.Ext ((presheafToSheaf ((Scheme.ProEt.topology S).over U)
              AddCommGrpCat.{u+1}).obj
              (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
            (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y') n,
          ∃ x : Abelian.Ext ((presheafToSheaf ((Scheme.ProEt.topology S).over U)
              AddCommGrpCat.{u+1}).obj
              (yoneda.obj (Over.mk (𝟙 U)) ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free))
            (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y) n,
            x.comp (Abelian.Ext.mk₀ ψ) (add_zero n) = x') →
        Function.Surjective (Θ Y Y' ψ)) :=
by
  letI hExtD : HasExt (Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}) :=
    HasExt.standard _

  have hLadj : ∃ (L : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1} ⥤
        Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (_ : L ⊣ (Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U),
      L.Additive ∧ Limits.PreservesFiniteLimits L ∧ Limits.PreservesFiniteColimits L := by
    have hfinal : ∀ W : S.ProEt, ∃ (I : Type u)
        (D : Discrete I ⥤ CostructuredArrow (Over.forget U).op (Opposite.op W)), D.Final := by
      intro W
      obtain ⟨D, hD⟩ : ∃ D : Discrete (W ⟶ U) ⥤
          CostructuredArrow (Over.forget U).op (Opposite.op W),
          ∀ f, D.obj ⟨f⟩ = CostructuredArrow.mk (Y := Opposite.op (Over.mk f)) (𝟙 W).op :=
        ⟨Discrete.functor (fun f => CostructuredArrow.mk (Y := Opposite.op (Over.mk f)) (𝟙 W).op),
          fun f => rfl⟩
      have key : ∀ (c : CostructuredArrow (Over.forget U).op (Opposite.op W)) (f : W ⟶ U)
          (k : c.left ⟶ Opposite.op (Over.mk f))
          (hk : (Over.forget U).op.map k ≫ (𝟙 W).op = c.hom),
          (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom ∧
            f = Quiver.Hom.unop c.hom ≫ c.left.unop.hom := by
        intro c f k hk
        have h0 : 𝟙 W ≫ (Over.forget U).map k.unop = c.hom.unop := congrArg Quiver.Hom.unop hk
        have h1 : (Quiver.Hom.unop k).left = Quiver.Hom.unop c.hom :=
          (Category.id_comp _).symm.trans h0
        refine ⟨h1, ?_⟩
        have hw : (Quiver.Hom.unop k).left ≫ c.left.unop.hom = (Over.mk f).hom :=
          Over.w k.unop
        exact hw.symm.trans (congrArg (· ≫ c.left.unop.hom) h1)
      refine ⟨W ⟶ U, D, Functor.Final.mk (fun c => ?_)⟩
      have hext : ∀ (f : W ⟶ U) (h h' : c ⟶ D.obj ⟨f⟩), h = h' := by
        intro f h h'
        refine (cancel_mono (eqToHom (hD f))).1 ?_
        apply CostructuredArrow.hom_ext
        apply Quiver.Hom.unop_inj
        apply Over.OverMorphism.ext
        exact (key c f (h ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.trans
          (key c f (h' ≫ eqToHom (hD f)).left (CostructuredArrow.w _)).1.symm
      let fc : W ⟶ U := Quiver.Hom.unop c.hom ≫ c.left.unop.hom
      obtain ⟨κc, hκc⟩ : ∃ κc : Over.mk fc ⟶ c.left.unop,
          κc.left = Quiver.Hom.unop c.hom :=
        ⟨Over.homMk (Quiver.Hom.unop c.hom) rfl, rfl⟩
      have hw : (Over.forget U).op.map κc.op ≫ (𝟙 W).op = c.hom := by
        apply Quiver.Hom.unop_inj
        exact (Category.id_comp _).trans hκc
      let φc : c ⟶ D.obj ⟨fc⟩ :=
        CostructuredArrow.homMk (f := c)
          (f' := CostructuredArrow.mk (Y := Opposite.op (Over.mk fc)) (𝟙 W).op)
          κc.op hw ≫ eqToHom (hD fc).symm
      have hto : ∀ s : StructuredArrow c D, s.right.as = fc := fun s =>
        (key c s.right.as (s.hom ≫ eqToHom (hD s.right.as)).left (CostructuredArrow.w _)).2
      let tc : StructuredArrow c D := StructuredArrow.mk (Y := ⟨fc⟩) φc
      exact isConnected_of_isTerminal _ (Limits.IsTerminal.ofUniqueHom (X := tc)
        (fun s => StructuredArrow.homMk (Discrete.eqToHom (hto s)) (hext _ _ _))
        (fun s m => StructuredArrow.ext _ _ (Subsingleton.elim _ _)))
    have lan_eval_iso : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D] (L : C ⥤ D)
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F] (Y : D),
        Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
            (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
          (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
            Limits.colim) := by
      intro C D _ _ L _ _ Y
      refine ⟨NatIso.ofComponents (fun F => L.leftKanExtensionObjIsoColimit F Y) ?_⟩
      intro F₁ F₂ φ
      have hnat : ∀ j : CostructuredArrow L Y,
          (L.leftKanExtension F₁).map j.hom ≫ (L.lan.map φ).app Y =
          (L.lan.map φ).app (L.obj j.left) ≫ (L.leftKanExtension F₂).map j.hom :=
        fun j => (L.lan.map φ).naturality j.hom
      have hfac : ∀ j : CostructuredArrow L Y,
          (L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left) =
          φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left := fun j =>
        Functor.descOfIsLeftKanExtension_fac_app (L.leftKanExtension F₁)
          (L.leftKanExtensionUnit F₁) (L.leftKanExtension F₂) (φ ≫ L.leftKanExtensionUnit F₂) j.left
      refine (Iso.inv_comp_eq _).1 ?_
      apply Limits.colimit.hom_ext
      intro j
      have key : (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
          (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom =
          φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
        calc (L.leftKanExtensionUnit F₁).app j.left ≫ (L.leftKanExtension F₁).map j.hom ≫
              (L.lan.map φ).app Y ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom
            = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.leftKanExtension F₁).map j.hom ≫
              (L.lan.map φ).app Y) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _).symm
          _ = (L.leftKanExtensionUnit F₁).app j.left ≫ ((L.lan.map φ).app (L.obj j.left) ≫
              (L.leftKanExtension F₂).map j.hom) ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg (fun k => (L.leftKanExtensionUnit F₁).app j.left ≫ k ≫
                (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hnat j)
          _ = ((L.leftKanExtensionUnit F₁).app j.left ≫ (L.lan.map φ).app (L.obj j.left)) ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              (congrArg ((L.leftKanExtensionUnit F₁).app j.left ≫ ·) (Category.assoc _ _ _)).trans
                (Category.assoc _ _ _).symm
          _ = (φ.app j.left ≫ (L.leftKanExtensionUnit F₂).app j.left) ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom :=
              congrArg (· ≫ (L.leftKanExtension F₂).map j.hom ≫
                (L.leftKanExtensionObjIsoColimit F₂ Y).hom) (hfac j)
          _ = φ.app j.left ≫ ((L.leftKanExtensionUnit F₂).app j.left ≫
              (L.leftKanExtension F₂).map j.hom ≫ (L.leftKanExtensionObjIsoColimit F₂ Y).hom) :=
              Category.assoc _ _ _
          _ = φ.app j.left ≫ Limits.colimit.ι (CostructuredArrow.proj L Y ⋙ F₂) j :=
              congrArg (φ.app j.left ≫ ·) (Functor.ι_leftKanExtensionObjIsoColimit_hom L F₂ Y j)
      erw [Functor.ι_leftKanExtensionObjIsoColimit_inv_assoc, Limits.ι_colimMap]
      exact key
    have lan_pfl : ∀ {C D : Type (u+1)} [Category.{u} C]
        [Category.{u} D] (L : C ⥤ D)
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasPointwiseLeftKanExtension F]
        [∀ F : C ⥤ AddCommGrpCat.{u+1}, L.HasLeftKanExtension F],
        (∀ Y : D, Nonempty ((L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) ⋙
            (evaluation D AddCommGrpCat.{u+1}).obj Y ≅
          (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
            Limits.colim)) →
        (∀ Y : D, ∃ (I : Type u) (G : Discrete I ⥤ CostructuredArrow L Y), G.Final) →
        Limits.PreservesFiniteLimits
          (L.lan : (C ⥤ AddCommGrpCat.{u+1}) ⥤ (D ⥤ AddCommGrpCat.{u+1})) := by
      intro C D _ _ L _ _ hiso' hfin
      constructor
      intro J _ _
      apply Limits.preservesLimitsOfShape_of_evaluation
      intro Y
      obtain ⟨θ⟩ := hiso' Y
      obtain ⟨I, G, hG⟩ := hfin Y
      haveI : HasExactColimitsOfShape (Discrete I) AddCommGrpCat.{u+1} :=
        HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1}
          (Discrete.equivalence (Equiv.ulift : ULift.{u+1} I ≃ I))
      let e2 : (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
          ((Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj G ⋙ Limits.colim) ≅
          (Functor.whiskeringLeft _ _ AddCommGrpCat.{u+1}).obj (CostructuredArrow.proj L Y) ⋙
            Limits.colim :=
        Functor.isoWhiskerLeft _ (Functor.Final.colimIso G)
      exact Limits.preservesLimitsOfShape_of_natIso (e2 ≪≫ θ.symm)
    haveI hlan : Limits.PreservesFiniteLimits ((Over.forget U).op.lan :
        ((Over U)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) ⥤ ((S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})) :=
      lan_pfl (Over.forget U).op (fun Y => lan_eval_iso (Over.forget U).op Y)
        (fun Y => hfinal Y.unop)
    let G := (Over.forget U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
    let F := (Over.forget U).sheafPullback AddCommGrpCat.{u+1}
      ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
    let adj : F ⊣ G := (Over.forget U).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
      ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S)
    haveI : Limits.PreservesColimitsOfSize.{0, 0} F := adj.leftAdjoint_preservesColimits
    haveI : Limits.PreservesFiniteColimits F :=
      Limits.PreservesColimitsOfSize.preservesFiniteColimits F
    haveI : G.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint G
    haveI : G.Additive := Functor.additive_of_preserves_binary_products G
    haveI : F.Additive := adj.left_adjoint_additive
    haveI : Limits.PreservesFiniteLimits F := by
      show Limits.PreservesFiniteLimits ((Over.forget U).sheafPullback AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology S).over U) (Scheme.ProEt.topology S))
      infer_instance
    exact ⟨F, adj, inferInstance, inferInstance, inferInstance⟩

  have hpush : ∀ {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
      (J : GrothendieckTopology C) (K : GrothendieckTopology D) (G : C ⥤ D)
      [G.IsContinuous J K] [G.IsCocontinuous J K],
      (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).Additive ∧
      Limits.PreservesFiniteColimits (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K) := by
    intro C D _ _ J K G _ _
    have adj := G.sheafAdjunctionCocontinuous AddCommGrpCat.{u+1} J K
    have := adj.leftAdjoint_preservesColimits.{0, 0}
    have : (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).IsLeftAdjoint := adj.isLeftAdjoint
    have := Functor.preservesZeroMorphisms_of_isLeftAdjoint
      (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K)
    have := Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts
      (G.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K)
    exact ⟨Functor.additive_of_preservesBinaryBiproducts _,
      Limits.PreservesColimitsOfSize.preservesFiniteColimits _⟩

  have yon1 : ∀ {C : Type (u+1)} [Category.{u} C] (J : GrothendieckTopology C)
