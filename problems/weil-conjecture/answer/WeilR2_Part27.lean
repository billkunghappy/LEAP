    simp only [wcSpfMerge]
    split_ifs <;> simp only [Fin.val_succ, Fin.val_castSucc] at * <;>
      simp only [Equiv.symm_apply_apply, hF, Fin.val_succ, Fin.val_castSucc] <;>
      first
        | omega
        | exact congrArg F (by omega)
        | exact congrArg₂ (· * ·) (congrArg F (by omega)) (congrArg F (by omega))
  have iM4 : ∀ (p : ℕ) (f : Fin (p + 2) → Fin (Fintype.card Γ)) (a b : Fin p), a ≤ b →
      wcSpfMerge Γ (wcSpfMerge Γ f b.succ) a = wcSpfMerge Γ (wcSpfMerge Γ f a.castSucc) b := by
    intro p f a b hab; funext i
    have hab' : (a : ℕ) ≤ b := hab
    clear hab
    apply (Fintype.equivFin Γ).symm.injective
    obtain ⟨F, hF⟩ : ∃ F : ℕ → Γ, ∀ x : Fin (p + 2), (Fintype.equivFin Γ).symm (f x) = F x :=
      ⟨fun m => if h : m < p + 2 then (Fintype.equivFin Γ).symm (f ⟨m, h⟩) else 1,
        fun x => by simp [x.is_lt]⟩
    simp only [wcSpfMerge]
    split_ifs <;> simp only [Fin.val_succ, Fin.val_castSucc] at * <;>
      simp only [Equiv.symm_apply_apply, hF, Fin.val_succ, Fin.val_castSucc, mul_assoc] <;>
      first
        | omega
        | exact congrArg F (by omega)
        | exact congrArg₂ (· * ·) (congrArg F (by omega)) (congrArg F (by omega))
        | exact congrArg₂ (· * ·) (congrArg F (by omega))
            (congrArg₂ (· * ·) (congrArg F (by omega)) (congrArg F (by omega)))

  have tL1 : ∀ p, wcSpfBarL A lamA ρ p ≫ wcSpfBarM A lamA ρ (p + 1) 0 =
      wcSpfBarL A lamA ρ p ≫ wcSpfBarL A lamA ρ (p + 1) := by
    intro p
    apply Limits.Pi.hom_ext; rintro ⟨f, j⟩
    have e1 : (fun i : Fin p => wcSpfMerge Γ f 0 i.succ) = fun i => f i.succ.succ := by
      funext i; simp [wcSpfMerge]
    have e2 : wcSpfMerge Γ f 0 0 = Fintype.equivFin Γ ((Fintype.equivFin Γ).symm (f 0) *
        (Fintype.equivFin Γ).symm (f (Fin.succ 0))) := by simp [wcSpfMerge]
    simp only [wcSpfBarL, wcSpfBarM, Category.assoc, Limits.Pi.lift_comp_π,
      Limits.Pi.lift_comp_π_assoc]
    rw [e1, e2, Equiv.symm_apply_apply, ← hlam.2.2, MonoidAlgebra.single_mul_single, one_mul]
