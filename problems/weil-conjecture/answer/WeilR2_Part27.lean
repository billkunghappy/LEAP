      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left b.N.φ)).precomp G (zero_add 0)) hΦ
    refine ⟨wcAddEquivMatrix β F, fun i => hrat i, ?_⟩
    intro n hn i Rm θt hθt
    obtain ⟨pn, hsurjn, hker, hsc⟩ := hsec n hn
    refine wc_lattice_trace_mod_reduction ℓ act r n β hβ F hF
      (θt.toAddMonoidHom.comp pn) (θt.surjective.comp hsurjn) ?_ i Rm ?_
    · intro y
      rw [← hker y]
      simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom]
      exact θt.map_eq_zero_iff
    · intro y
      simp only [AddMonoidHom.coe_comp, Function.comp_apply, AddEquiv.coe_toAddMonoidHom]
      rw [(hsc.iterate_right i) y]
      exact hθt _
  refine ⟨?_, ?_⟩
  · intro d x hx b i
    obtain ⟨B, hB, -⟩ := main d x hx b
    exact ⟨(B ^ i).trace, (hB i).symm⟩
  · intro n hn d hd x hx b v g hv1 hv2 hv3 T hT
    obtain ⟨B, hB, hmod⟩ := main d x hx b
    obtain ⟨θt, Rm, htr, hθt⟩ := wc_twsh_stalk_frobenius_eval K m S hS Uo hUo (q' n) (Γ n) (α n)
      (hCOV n hn) (hα n) ℓ n r (ρ n) hn d x hx b.N e (Nat.mem_divisors.mp hd).1 v g hv1 hv2 hv3
    have hTB : T = (B ^ (e / d)).trace := PadicInt.ext (hT.trans (hB (e / d)))
    rw [hTB, hmod n hn (e / d) Rm θt hθt, htr]

theorem wc_h2_twsheaf_torsion {X V : Scheme.{u}} (q : V ⟶ X) (Z : Set X) (Γ : Type u) [Group Γ]
    (α : Γ →* Aut V) (hα : ∀ g, (α g).hom ≫ q = q) (ℓ n r : ℕ)
    (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) :
    ((ℓ ^ n : ℕ) : ℤ) • 𝟙 (wcH2TwSheaf q Z Γ α hα ℓ n r ρ) = 0 :=
by
  have hbase : ∀ (Y : Type u) [TopologicalSpace Y]
      (a : ULift.{u+1} C(Y, Fin r → ZMod (ℓ ^ n))), (ℓ ^ n : ℕ) • a = 0 := by
    intro Y _ a
    apply ULift.ext
    rw [ULift.smul_down, ULift.zero_down]
    ext y i
    rw [ContinuousMap.nsmul_apply, ContinuousMap.zero_apply, Pi.smul_apply, Pi.zero_apply,
      nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  have hsub : ∀ (A : AddCommGrpCat.{u+1}) (H : AddSubgroup A),
      (∀ a : A, (ℓ ^ n : ℕ) • a = 0) → ∀ h : AddCommGrpCat.of H, (ℓ ^ n : ℕ) • h = 0 := by
    intro A H hA h
    apply Subtype.ext
    rw [AddSubgroup.coe_nsmul, AddSubgroup.coe_zero]
    exact hA _
  have gen : ∀ (P : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ (T : (X.ProEt)ᵒᵖ) (x : P.obj T), (ℓ ^ n : ℕ) • x = 0) →
      (ℓ ^ n : ℕ) • 𝟙 ((presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).obj P)
        = 0 := by
    intro P hP
    have hpre : (ℓ ^ n : ℕ) • 𝟙 P = 0 := by
      apply NatTrans.ext
      funext U
      rw [NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero]
      apply AddCommGrpCat.hom_ext
      apply AddMonoidHom.ext
      intro x
      rw [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero,
        AddMonoidHom.nsmul_apply, AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
      exact hP _ x
    rw [← CategoryTheory.Functor.map_id, ← CategoryTheory.Functor.map_nsmul, hpre,
      CategoryTheory.Functor.map_zero]
  rw [natCast_zsmul]
  unfold wcH2TwSheaf
  apply gen
  intro T x
  refine hsub _ _ (hsub _ _ ?_) x
  intro a
  exact hbase _ a

theorem wc_h2_tors_res_exists (K : Type u) [Field K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (N : ℕ) (hN : 1 ≤ N)
    (𝓖 : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (h𝓖 : ((N : ℕ) : ℤ) • 𝟙 𝓖 = 0) :
    ∃ (J : CochainComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) ℕ)
      (η : 𝓖 ⟶ J.X 0), wcNTorsRes K hP N 𝓖 J η :=
by
  have hNpos : 0 < N := by omega
  have hG : N • 𝟙 𝓖 = 0 := by rw [← natCast_zsmul]; exact h𝓖

  have kT : ∀ Z : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1},
      N • 𝟙 (Limits.kernel (N • 𝟙 Z)) = 0 := by
    intro Z
    apply (cancel_mono (Limits.kernel.ι (N • 𝟙 Z))).mp
    calc (N • 𝟙 _) ≫ Limits.kernel.ι (N • 𝟙 Z) = Limits.kernel.ι (N • 𝟙 Z) ≫ (N • 𝟙 Z) := by
          rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
      _ = 0 ≫ Limits.kernel.ι (N • 𝟙 Z) := by rw [Limits.kernel.condition, Limits.zero_comp]
  have kT' : ∀ Y : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1},
      N • 𝟙 (wcNtT N Y) = 0 := fun Y => kT _

  have cT : ∀ {A B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (f : A ⟶ B), N • 𝟙 B = 0 → N • 𝟙 (Limits.cokernel f) = 0 := by
    intro A B f hB
    apply (cancel_epi (Limits.cokernel.π f)).mp
    calc Limits.cokernel.π f ≫ (N • 𝟙 _) = (N • 𝟙 B) ≫ Limits.cokernel.π f := by
          rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
      _ = Limits.cokernel.π f ≫ 0 := by rw [hB, Limits.zero_comp, Limits.comp_zero]

  have εM : ∀ Y : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1},
      N • 𝟙 Y = 0 → Mono (wcNtEps N Y) := by
    intro Y hY
    haveI : IsIso (Limits.cokernel.π (N • 𝟙 Y)) := Limits.cokernel.π_of_zero hY
    unfold wcNtEps
    exact @mono_comp _ _ _ _ _ _ inferInstance _
      (mono_of_mono_fac (Limits.kernel.lift_ι _ _ _))

  have Ex : ∀ (S : ShortComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left)
      AddCommGrpCat.{u+1})) (f : S.X₁ ⟶ S.X₂) (m : Limits.cokernel f ⟶ S.X₃), Mono m →
      S.f = f → S.g = Limits.cokernel.π f ≫ m → S.Exact := by
    intro S f m hm hf hg
    let φ : ShortComplex.mk f (Limits.cokernel.π f) (Limits.cokernel.condition f) ⟶ S :=
      { τ₁ := 𝟙 _
        τ₂ := 𝟙 _
        τ₃ := m
        comm₁₂ := by simp [hf]
        comm₂₃ := by simp [hg] }
    haveI : Epi φ.τ₁ := by dsimp [φ]; infer_instance
    haveI : IsIso φ.τ₂ := by dsimp [φ]; infer_instance
    haveI : Mono φ.τ₃ := by dsimp [φ]; infer_instance
    exact (ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ).mp (ShortComplex.exact_cokernel f)

  have relInj : ∀ (E : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      [Injective E] (A B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (mm : A ⟶ B) [Mono mm], N • 𝟙 B = 0 →
      ∀ φ : A ⟶ Limits.kernel (N • 𝟙 E), ∃ ψ : B ⟶ Limits.kernel (N • 𝟙 E), mm ≫ ψ = φ := by
    intro E _ A B mm _ hB φ
    have h0 : Injective.factorThru (φ ≫ Limits.kernel.ι _) mm ≫ (N • 𝟙 E) = 0 := by
      calc Injective.factorThru (φ ≫ Limits.kernel.ι _) mm ≫ (N • 𝟙 E)
          = (N • 𝟙 B) ≫ Injective.factorThru (φ ≫ Limits.kernel.ι _) mm := by
            rw [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
        _ = 0 := by rw [hB, Limits.zero_comp]
    refine ⟨Limits.kernel.lift _ _ h0, ?_⟩
    apply (cancel_mono (Limits.kernel.ι (N • 𝟙 E))).mp
    rw [Category.assoc, Limits.kernel.lift_ι, Injective.comp_factorThru]

  refine ⟨wcNtCx N 𝓖, wcNtEps N 𝓖, ?_, εM 𝓖 hG, ?_, ?_, ?_, ?_⟩
  ·
    intro i
    rw [natCast_zsmul]
    exact kT' _
  ·
    have hd : ∀ j, (wcNtCx N 𝓖).d j (j + 1) = (wcNtSeq N 𝓖 (j + 1)).2.2 := by
      intro j
      exact CochainComplex.of_d (α := ℕ)
        (fun i => wcNtT N (wcNtSeq N 𝓖 i).2.1) (fun i => (wcNtSeq N 𝓖 (i + 1)).2.2) j
    have hd0 : (wcNtCx N 𝓖).d 0 1 = (wcNtSeq N 𝓖 1).2.2 := hd 0
    have w : wcNtEps N 𝓖 ≫ (wcNtCx N 𝓖).d 0 1 = 0 := by
      rw [hd0]
      show wcNtEps N 𝓖 ≫ (Limits.cokernel.π (wcNtEps N 𝓖) ≫ wcNtEps N _) = 0
      rw [Limits.cokernel.condition_assoc, Limits.zero_comp]
    refine ⟨w, ?_⟩
    exact Ex (ShortComplex.mk (wcNtEps N 𝓖) ((wcNtCx N 𝓖).d 0 1) w) (wcNtEps N 𝓖)
      (wcNtEps N (Limits.cokernel (wcNtEps N 𝓖))) (εM _ (cT _ (kT' _))) rfl (hd0.trans rfl)
  ·
    intro i
    have hd : ∀ j, (wcNtCx N 𝓖).d j (j + 1) = (wcNtSeq N 𝓖 (j + 1)).2.2 := by
      intro j
      exact CochainComplex.of_d (α := ℕ)
        (fun i => wcNtT N (wcNtSeq N 𝓖 i).2.1) (fun i => (wcNtSeq N 𝓖 (i + 1)).2.2) j
    show (wcNtCx N 𝓖).ExactAt (i + 1)
    rw [HomologicalComplex.exactAt_iff' (wcNtCx N 𝓖) i (i + 1) (i + 1 + 1)
      (CochainComplex.prev_nat_succ i) (CochainComplex.next ℕ (i + 1))]
    exact Ex ((wcNtCx N 𝓖).sc' i (i + 1) (i + 1 + 1)) (wcNtSeq N 𝓖 (i + 1)).2.2
      (wcNtEps N (Limits.cokernel (wcNtSeq N 𝓖 (i + 1)).2.2)) (εM _ (cT _ (kT' _)))
      (hd i) ((hd (i + 1)).trans rfl)
  ·
    intro i A B mm hmm hB φ
    rw [natCast_zsmul] at hB
    exact relInj (Injective.under (Limits.cokernel (N • 𝟙 (wcNtSeq N 𝓖 i).2.1))) A B mm hB φ
  ·
    intro i j hj y
    obtain ⟨k, rfl⟩ : ∃ k, j = k + 1 := ⟨j - 1, by omega⟩
    exact wc_exact_kernel_nsmul_ext_vanish
      (𝟭 (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}))
      (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
      (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) (Iso.refl _) N
      (sheaf_free_yoneda_nsmul_mono (Scheme.ProEt.topology (wcP1Over K).left)
        (wcGeomPoint K (wcP1Over K) hP) N hNpos)
      (Injective.under (Limits.cokernel (N • 𝟙 (wcNtSeq N 𝓖 i).2.1)))
      (sheaf_injective_nsmul_epi _ _ N hNpos) (fun k y => Abelian.Ext.eq_zero_of_injective y) k y

theorem wc_h2tt_strict_linear_model (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ] [Fintype Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α)
    (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι) :
    ∃ (lamF : MonoidAlgebra ℤ_[ℓ] Γ → (wcCoverSheaf (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶ wcCoverSheaf (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
      (I : InjectiveResolution (wcCoverSheaf (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
      (lamI : MonoidAlgebra ℤ_[ℓ] Γ → (I.cocomplex ⟶ I.cocomplex))
      (P₀ : wcGModel ℓ Γ) (φ : wcGModelAb P₀ ⟶ wcCxJ K hP I.cocomplex)
      (H : Homotopy (wcGModelFrob P₀ ≫ φ) (φ ≫ wcCxJFrob K hP I.cocomplex)),
      wcRingAct lamF ∧
      (∀ (g : Γ) (a : ℤ_[ℓ]), lamF (MonoidAlgebra.single g a) =
        wcCoverScal (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ a ≫
          wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
            (α g⁻¹).hom (hα g⁻¹)) ∧
      wcRingResSpec lamF I lamI ∧
      QuasiIso φ ∧
      (∀ x : MonoidAlgebra ℤ_[ℓ] Γ, wcGModelSmul P₀ x ≫ φ = φ ≫ wcCxJMap K hP (lamI x)) ∧
      (∀ (x : MonoidAlgebra ℤ_[ℓ] Γ) (i j : ℕ),
        (wcGModelSmul P₀ x).f i ≫ H.hom i j = H.hom i j ≫ (wcCxJMap K hP (lamI x)).f j) ∧
      wcIsModel K hP (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (q' ≫ Uo.ι)
        Γ α hα P₀ :=
by
  classical
  haveI : Finite Γ := hG.1
  set q : V ⟶ (wcP1Over K).left := q' ≫ Uo.ι with hqdef
  set Z : Set (wcP1Over K).left := Set.range (fun i => S i (IsLocalRing.closedPoint K)) with hZdef
  set 𝓕 := wcCoverSheaf q Z ℓ with h𝓕
  set E := (preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
    (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex (ComplexShape.up ℕ) with hEdef
  set 𝔉 := NatTrans.mapHomologicalComplex (preadditiveCoyoneda.map
    (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)).op)
    (ComplexShape.up ℕ) with h𝔉def

  obtain ⟨lamF, hLact, hLsing, hL1⟩ := wc_cover_sheaf_ring_action q Z ℓ Γ α hα

  have hR : ∀ (n : ℕ) (r : MonoidAlgebra ℤ_[ℓ] Γ), 0 < n →
      (n : MonoidAlgebra ℤ_[ℓ] Γ) * r = 0 → r = 0 := by
    intro n r hn h
    rw [← nsmul_eq_mul] at h
    exact (smul_eq_zero.mp h).resolve_left hn.ne'

  obtain ⟨I, lamI, hI⟩ := wc_ring_injective_resolution (wcP1Over K).left
    (MonoidAlgebra ℤ_[ℓ] Γ) hR _ lamF hLact
  have hI' := hI
  obtain ⟨hIact, hI0, -⟩ := hI'
  have hIact' := hIact
  obtain ⟨hIone, hIadd, hImul⟩ := hIact'

  have hLD : wcRingAct (fun r => E.map (lamI r)) := by
    refine ⟨?_, ?_, ?_⟩
    · show E.map (lamI 1) = 𝟙 _
      rw [hIone, CategoryTheory.Functor.map_id]
    · intro a b
      show E.map (lamI (a + b)) = E.map (lamI a) + E.map (lamI b)
      rw [hIadd, Functor.map_add]
    · intro a b
      show E.map (lamI (a * b)) = E.map (lamI b) ≫ E.map (lamI a)
      rw [hImul, Functor.map_comp]
  have hFr : ∀ r, (fun r => E.map (lamI r)) r ≫ 𝔉.app I.cocomplex =
      𝔉.app I.cocomplex ≫ (fun r => E.map (lamI r)) r := fun r => 𝔉.naturality (lamI r)

  have hfv := wc_cover_coh_fg_van K hP ℓ hℓ m S hS Uo hUo q' Γ α hG hα lamF hLact hLsing I lamI hI
  obtain ⟨T⟩ := wc_three_term_model_exists ℓ Γ (E.obj I.cocomplex) (fun r => E.map (lamI r))
    hLD hfv
  have hproj := wc_cover_model_head_projective K hP ℓ hℓ m S hS Uo hUo q' Γ α hG hα lamF hLact
    hLsing I lamI hI T
  obtain ⟨P₀, φ, hq, hlin, h, hhlin⟩ := wc_gmodel_linear_of_projective_head ℓ Γ (E.obj I.cocomplex)
    (fun r => E.map (lamI r)) hLD (𝔉.app I.cocomplex) hFr T hproj

  have hcongr : ∀ (a a' : V ⟶ V) (_ : a = a') (ha : a ≫ q = q) (ha' : a' ≫ q = q),
      wcCoverAct q Z ℓ a ha = wcCoverAct q Z ℓ a' ha' := by
    rintro a _ rfl _ _
    rfl
  have hLinv : ∀ γ : Γ, lamF (MonoidAlgebra.single γ⁻¹ 1) =
      wcCoverAct q Z ℓ (α γ).hom (hα γ) := fun γ =>
    (hL1 γ⁻¹).trans (hcongr _ _ (by rw [inv_inv]) _ _)
  let I₀ := injectiveResolution 𝓕
  let Θ : E.obj I.cocomplex ⟶ wcCx K hP 𝓕 := E.map (InjectiveResolution.desc (𝟙 𝓕) I₀ I)
  have hΘq : QuasiIso Θ := by
    have h' := HomotopyEquiv.quasiIso_hom
      ((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
        (wcGeomPoint K (wcP1Over K) hP)))).mapHomotopyEquiv (I.homotopyEquiv I₀))
    rw [Functor.mapHomotopyEquiv_hom] at h'
    exact h'
  have hΘF : Θ ≫ wcCxFrob K hP 𝓕 = 𝔉.app I.cocomplex ≫ Θ :=
    NatTrans.mapHomologicalComplex_naturality _ _
  have hΘA : ∀ γ : Γ, Homotopy (Θ ≫ wcCxMap K hP (wcCoverAct q Z ℓ (α γ).hom (hα γ)))
      (E.map (lamI (MonoidAlgebra.single γ⁻¹ 1)) ≫ Θ) := by
    intro γ
    have h1 : I.ι ≫ (InjectiveResolution.desc (𝟙 𝓕) I₀ I ≫
        InjectiveResolution.desc (wcCoverAct q Z ℓ (α γ).hom (hα γ)) I₀ I₀) =
        (CochainComplex.single₀ _).map (wcCoverAct q Z ℓ (α γ).hom (hα γ)) ≫ I₀.ι := by
      rw [← Category.assoc, InjectiveResolution.desc_commutes, Category.assoc,
        InjectiveResolution.desc_commutes, ← Category.assoc, ← Functor.map_comp,
        Category.id_comp]
    have h2 : I.ι ≫ (lamI (MonoidAlgebra.single γ⁻¹ 1) ≫ InjectiveResolution.desc (𝟙 𝓕) I₀ I) =
        (CochainComplex.single₀ _).map (wcCoverAct q Z ℓ (α γ).hom (hα γ)) ≫ I₀.ι := by
      apply HomologicalComplex.from_single_hom_ext
      simp only [HomologicalComplex.comp_f]
      have h3 : lamF (MonoidAlgebra.single γ⁻¹ 1) ≫ I.ι.f 0 ≫
          (InjectiveResolution.desc (𝟙 𝓕) I₀ I).f 0 =
          wcCoverAct q Z ℓ (α γ).hom (hα γ) ≫ I₀.ι.f 0 := by
        have h4 := InjectiveResolution.desc_commutes_zero (𝟙 𝓕) I₀ I
        have h5 : (𝟙 𝓕 ≫ I₀.ι.f 0 : 𝓕 ⟶ I₀.cocomplex.X 0) = I₀.ι.f 0 := Category.id_comp _
        refine (congrArg (fun t => lamF (MonoidAlgebra.single γ⁻¹ 1) ≫ t) (h4.trans h5)).trans ?_
        exact congrArg (fun t => t ≫ I₀.ι.f 0) (hLinv γ)
      rw [← Category.assoc, hI0 (MonoidAlgebra.single γ⁻¹ 1)]
      refine ((Category.assoc _ _ _).trans h3).trans ?_
      first
        | rfl
        | (erw [CochainComplex.single₀_map_f_zero]; rfl)
        | simp
    have hh := InjectiveResolution.descHomotopy (wcCoverAct q Z ℓ (α γ).hom (hα γ)) _ _ h1 h2
    have hE := (preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
        (wcGeomPoint K (wcP1Over K) hP)))).mapHomotopy hh
    refine (Homotopy.ofEq ?_).trans (hE.trans (Homotopy.ofEq ?_))
    · exact (Functor.map_comp _ _ _).symm
    · exact Functor.map_comp _ _ _
  have hM₀ : wcIsModel K hP Z ℓ q Γ α hα P₀ := by
    refine ⟨φ ≫ Θ, ?_, ⟨?_⟩, fun γ => ⟨?_⟩⟩
    · haveI := hq
      exact quasiIso_comp φ Θ
    · refine (Homotopy.ofEq ?_).trans ((h.compRight Θ).trans (Homotopy.ofEq ?_))
      · rw [Category.assoc, hΘF, ← Category.assoc]
      · rw [Category.assoc]
    · have hA' : wcGModelAct P₀ γ ≫ φ = φ ≫ E.map (lamI (MonoidAlgebra.single γ⁻¹ 1)) :=
        hlin (MonoidAlgebra.single γ⁻¹ 1)
      refine (Homotopy.ofEq (Category.assoc _ _ _)).trans
        (((hΘA γ).compLeft φ).trans (Homotopy.ofEq ?_))
      rw [← Category.assoc, ← hA', Category.assoc]

  refine ⟨lamF, I, lamI, P₀, φ, h.symm, hLact, hLsing, hI, hq, fun x => hlin x, ?_, hM₀⟩
  intro x i j
  rw [Homotopy.symm_hom]
  show (wcGModelSmul P₀ x).f i ≫ (-h.hom i j) = (-h.hom i j) ≫ (E.map (lamI x)).f j
  rw [Preadditive.comp_neg, Preadditive.neg_comp, hhlin x i j]

theorem wc_h2tt_twist_projection (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ] [Fintype Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α)
    (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (lamF : MonoidAlgebra ℤ_[ℓ] Γ → (wcCoverSheaf (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶ wcCoverSheaf (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (hlamF : wcRingAct lamF)
    (hlamFs : ∀ (g : Γ) (a : ℤ_[ℓ]), lamF (MonoidAlgebra.single g a) =
        wcCoverScal (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ a ≫
          wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
            (α g⁻¹).hom (hα g⁻¹))
    (I : InjectiveResolution (wcCoverSheaf (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (lamI : MonoidAlgebra ℤ_[ℓ] Γ → (I.cocomplex ⟶ I.cocomplex))
    (hI : wcRingResSpec lamF I lamI)
    (P₀ : wcGModel ℓ Γ) (φ : wcGModelAb P₀ ⟶ wcCxJ K hP I.cocomplex)
    (H : Homotopy (wcGModelFrob P₀ ≫ φ) (φ ≫ wcCxJFrob K hP I.cocomplex))
    (hφ : QuasiIso φ)
    (hφs : ∀ x : MonoidAlgebra ℤ_[ℓ] Γ, wcGModelSmul P₀ x ≫ φ = φ ≫ wcCxJMap K hP (lamI x))
    (hHs : ∀ (x : MonoidAlgebra ℤ_[ℓ] Γ) (i j : ℕ),
        (wcGModelSmul P₀ x).f i ≫ H.hom i j = H.hom i j ≫ (wcCxJMap K hP (lamI x)).f j)
    (hM₀ : wcIsModel K hP (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (q' ≫ Uo.ι)
        Γ α hα P₀)
    (n : ℕ) (hn : 1 ≤ n) (r : ℕ) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n)))
    (J' : CochainComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) ℕ)
    (η : wcH2TwSheaf (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
      Γ α hα ℓ n r ρ ⟶ J'.X 0)
    (hJ : wcNTorsRes K hP (ℓ ^ n) _ J' η) :
    ∃ Q₀ : wcLnModel (ZMod (ℓ ^ n)), wcIsTwist ℓ n ρ P₀ Q₀ ∧
      ∃ Ψ₀ : wcLnModelAb.{u+1} Q₀ ⟶ wcCxJ K hP J', QuasiIso Ψ₀ ∧
        Nonempty (Homotopy (Ψ₀ ≫ wcCxJFrob K hP J') (wcLnModelFrob Q₀ ≫ Ψ₀)) :=
by
  obtain ⟨Q₀, hQ₀⟩ := wcU_twist_exists ℓ n ρ P₀
  have hH' : ∀ (x : MonoidAlgebra ℤ_[ℓ] Γ) (i j : ℕ),
      (wcGModelSmul P₀ x).f i ≫ H.symm.hom i j =
        H.symm.hom i j ≫ (wcCxJMap K hP (lamI x)).f j := by
    intro x i j
    rw [Homotopy.symm_hom, Preadditive.comp_neg, Preadditive.neg_comp, hHs x i j]
  obtain ⟨Ψ₀, hΨ₀, hΨ₀F⟩ := wcU_strict_projection_formula K hP ℓ hℓ m S hS Uo hUo q' Γ α hG hα
    n hn r ρ lamF hlamF hlamFs I lamI hI P₀ φ hφ hφs H.symm hH' Q₀ hQ₀ J' η hJ
  exact ⟨Q₀, hQ₀, Ψ₀, hΨ₀, hΨ₀F⟩

theorem wc_h2_twist_trace_formula (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ] [Fintype Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α)
    (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (n : ℕ) (hn : 1 ≤ n) (r : ℕ) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n)))
    (P : wcGModel ℓ Γ)
    (hM : wcIsModel K hP (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (q' ≫ Uo.ι)
      Γ α hα P)
    (J' : CochainComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) ℕ)
    (η : wcH2TwSheaf (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
      Γ α hα ℓ n r ρ ⟶ J'.X 0)
    (hJ : wcNTorsRes K hP (ℓ ^ n) _ J' η)
    (Q' : wcLnModel (ZMod (ℓ ^ n))) (Ψ' : wcLnModelAb.{u+1} Q' ⟶ wcCxJ K hP J')
    (hΨ' : QuasiIso Ψ')
    (hΨ'F : Nonempty (Homotopy (Ψ' ≫ wcCxJFrob K hP J') (wcLnModelFrob Q' ≫ Ψ')))
    (e : ℕ) (he : 1 ≤ e) :
    wcLnTr Q' e = ∑ g : Γ, PadicInt.toZModPow n (wcGModelHS P e g) *
      ((ρ g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))).trace :=
by
  classical

  obtain ⟨lamF, I, lamI, P₀, φ, H, hlamF, hlamFs, hI, hφ, hφs, hHs, hM₀⟩ :=
    wc_h2tt_strict_linear_model K hP ℓ hℓ m S hS Uo hUo q' Γ α hG hα

  obtain ⟨Q₀, hQ₀, Ψ₀, hΨ₀, hΨ₀F⟩ :=
    wc_h2tt_twist_projection K hP ℓ hℓ m S hS Uo hUo q' Γ α hG hα lamF hlamF hlamFs I lamI hI
      P₀ φ H hφ hφs hHs hM₀ n hn r ρ J' η hJ

  have hW : ∀ i (x : (wcCxJ K hP J').X i), (ℓ ^ n) • x = 0 := by
    intro i x
    let y : wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) ⟶ J'.X i := x
    have h1 : ((ℓ ^ n : ℕ) : ℤ) • 𝟙 (J'.X i) = 0 := hJ.1 i
    have h2 : (ℓ ^ n) • y = 0 := by
      have h3 : (ℓ ^ n) • y = y ≫ ((ℓ ^ n : ℕ) • 𝟙 (J'.X i)) := by
        rw [Preadditive.comp_nsmul, Category.comp_id]
      rw [h3, ← natCast_zsmul, h1, Limits.comp_zero]
    exact h2

  obtain ⟨χ, χ', h1, h2, h3⟩ := wcU_lnmodel_htpy_equiv (ℓ ^ n) Q' Q₀ (wcCxJ K hP J') hW
    (wcCxJFrob K hP J') Ψ' Ψ₀ hΨ' hΨ₀ hΨ'F hΨ₀F
  have hA := wcU_lnmodel_trace_invariant (ℓ ^ n) Q' Q₀ χ χ' h1 h2 h3 e he
  have hB := wcU_twist_model_trace ℓ n ρ P₀ Q₀ hQ₀ e
  rw [hA, hB]

  have hT : ∀ γ : Γ, wcGModelTr P e γ = wcGModelTr P₀ e γ := by
    intro γ
    apply Subtype.val_injective
    change ((wcGModelTr P e γ : ℤ_[ℓ]) : ℚ_[ℓ]) = ((wcGModelTr P₀ e γ : ℤ_[ℓ]) : ℚ_[ℓ])
    rw [wc_cover_lefschetz K hP ℓ hℓ m S hS Uo hUo q' Γ α hG hα P hM e he γ,
      wc_cover_lefschetz K hP ℓ hℓ m S hS Uo hUo q' Γ α hG hα P₀ hM₀ e he γ]

  have hTr : ∀ (P' : wcGModel ℓ Γ) (γ : Γ),
      wcGModelTr P' e γ = ∑ τ : Γ, wcGModelHS P' e (τ⁻¹ * γ * τ) := by
    intro P' γ
    have hc : ∀ (x : MonoidAlgebra ℤ_[ℓ] Γ) (τ : Γ),
        (MonoidAlgebra.single γ⁻¹ (1 : ℤ_[ℓ]) * MonoidAlgebra.single τ 1 * x).coeff τ =
          x.coeff (τ⁻¹ * γ * τ) := by
      intro x τ
      rw [MonoidAlgebra.single_mul_single, MonoidAlgebra.coeff_single_mul_apply, one_mul,
        one_mul]
      congr 1
      group
    simp only [wcGModelTr, wcGModelHS, hc, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Finset.sum_comm]

  have hχ : ∀ g h : Γ, ((ρ (h * g * h⁻¹) : GL (Fin r) (ZMod (ℓ ^ n))) :
      Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))).trace =
      ((ρ g : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))).trace := by
    intro g h
    rw [map_mul, map_mul, map_inv, Units.val_mul, Units.val_mul, Matrix.trace_mul_comm,
      ← mul_assoc, Units.inv_mul, one_mul]

  haveI : NeZero (ℓ ^ n) := ⟨pow_ne_zero _ (Nat.Prime.ne_zero Fact.out)⟩
  set red : ℤ_[ℓ] →+* ZMod (ℓ ^ n) := PadicInt.toZModPow n with hred
  set ch : Γ → ZMod (ℓ ^ n) := fun g =>
    ((ρ g : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))).trace with hch
  set chL : Γ → ℤ_[ℓ] := fun g => ((ch g).val : ℤ_[ℓ]) with hchL
  have hredL : ∀ g, red (chL g) = ch g := by
    intro g
    simp only [hchL, map_natCast, ZMod.natCast_zmod_val]
  have hchL_conj : ∀ g τ : Γ, chL (τ⁻¹ * g * τ) = chL g := by
    intro g τ
    have := hχ g τ⁻¹
    rw [inv_inv] at this
    simp only [hchL, hch, this]
  set c : Γ → ℤ_[ℓ] := fun g => wcGModelHS P₀ e g - wcGModelHS P e g with hc
  set X : ℤ_[ℓ] := ∑ g, c g * chL g with hX
  have hreidx : ∀ τ : Γ, ∑ g, c (τ⁻¹ * g * τ) * chL g = X := by
    intro τ
    let eτ : Γ ≃ Γ :=
      { toFun := fun g => τ⁻¹ * g * τ
        invFun := fun g => τ * g * τ⁻¹
        left_inv := fun g => by group
        right_inv := fun g => by group }
    rw [hX]
    exact Fintype.sum_equiv eτ _ _ (fun g => by
      show c (τ⁻¹ * g * τ) * chL g = c (τ⁻¹ * g * τ) * chL (τ⁻¹ * g * τ)
      rw [hchL_conj])
  have hsumτ : ∀ g : Γ, ∑ τ : Γ, c (τ⁻¹ * g * τ) = 0 := by
    intro g
    simp only [hc, Finset.sum_sub_distrib]
    rw [← hTr P₀ g, ← hTr P g, hT g, sub_self]
  have hcardX : (Fintype.card Γ : ℤ_[ℓ]) * X = 0 := by
    have e1 : ∑ τ : Γ, ∑ g, c (τ⁻¹ * g * τ) * chL g = (Fintype.card Γ : ℤ_[ℓ]) * X := by
      rw [Finset.sum_congr rfl (fun τ _ => hreidx τ), Finset.sum_const, Finset.card_univ,
        nsmul_eq_mul]
    rw [← e1, Finset.sum_comm]
    apply Finset.sum_eq_zero
    intro g _
    rw [← Finset.sum_mul, hsumτ g, zero_mul]
  have hcard0 : (Fintype.card Γ : ℤ_[ℓ]) ≠ 0 := by
    exact_mod_cast (Fintype.card_pos (α := Γ)).ne'
  have hX0 : X = 0 := (mul_eq_zero.mp hcardX).resolve_left hcard0
  rw [← sub_eq_zero, ← Finset.sum_sub_distrib]
  calc ∑ g : Γ, (red (wcGModelHS P₀ e g) * ch g - red (wcGModelHS P e g) * ch g)
      = red X := by
        rw [hX, map_sum]
        refine Finset.sum_congr rfl (fun g _ => ?_)
        rw [map_mul, hredL, hc, map_sub, sub_mul]
    _ = 0 := by rw [hX0, map_zero]

theorem wc_h2_punit_model_HS_eq (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (𝓕 : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (M M₁ : wcGModel ℓ PUnit.{u+1})
    (Ψ : wcGModelAb M ⟶ wcCx K hP 𝓕) (Ψ₁ : wcGModelAb M₁ ⟶ wcCx K hP 𝓕)
    (hΨ : QuasiIso Ψ) (hΨ₁ : QuasiIso Ψ₁)
    (hΨF : Nonempty (Homotopy (Ψ ≫ wcCxFrob K hP 𝓕) (wcGModelFrob M ≫ Ψ)))
    (hΨ₁F : Nonempty (Homotopy (Ψ₁ ≫ wcCxFrob K hP 𝓕) (wcGModelFrob M₁ ≫ Ψ₁)))
    (e : ℕ) (he : 1 ≤ e) :
    wcGModelHS M e PUnit.unit = wcGModelHS M₁ e PUnit.unit :=
by
  classical
  have hpne : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have hl0 : (ℓ : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hpne
  have hlk : ∀ k : ℕ, ((ℓ ^ k : ℕ) : ℚ_[ℓ]) ≠ 0 := fun k => by
    exact_mod_cast pow_ne_zero k hpne



  have s1 : ∀ {H H' : Type (u+1)} [AddCommGroup H] [AddCommGroup H'] {r s : ℕ}
      (ιM : H →+ (Fin r → ℚ_[ℓ])) (ιN : H' →+ (Fin s → ℚ_[ℓ])), wcRatCoord ℓ ιM →
      wcRatCoord ℓ ιN →
      ∀ φ : H →+ H', ∃ B : Matrix (Fin s) (Fin r) ℚ_[ℓ], ∀ x, ιN (φ x) = B.mulVec (ιM x) := by
    intro H H' _ _ r s ιM ιN hM hN φ
    obtain ⟨hM1, hM2, hM3, hM4⟩ := hM
    obtain ⟨hN1, hN2, hN3, hN4⟩ := hN

    have W : ∀ u, ιM u = 0 → ιN (φ u) = 0 := by
      intro u hu
      obtain ⟨k, hk⟩ := (hM1 u).mp hu
      have h1' : ιN (φ ((ℓ ^ k : ℕ) • u)) = 0 := by rw [hk, map_zero, map_zero]
      rw [map_nsmul, map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ]] at h1'
      exact (smul_eq_zero.mp h1').resolve_left (hlk k)
    have W' : ∀ y y', ιM y = ιM y' → ιN (φ y) = ιN (φ y') := by
      intro y y' h
      have := W (y - y') (by rw [map_sub, h, sub_self])
      rwa [map_sub, map_sub, sub_eq_zero] at this

    have Z : ∀ (x y) (c : ℤ_[ℓ]), ιM y = (c : ℚ_[ℓ]) • ιM x →
        ιN (φ y) = (c : ℚ_[ℓ]) • ιN (φ x) := by
      intro x y c hy
      obtain ⟨z, hz⟩ := hN3 (φ x) c
      have key : ιN (φ y - z) = 0 := by
        apply hN4
        intro k
        obtain ⟨ck, hck⟩ := Ideal.mem_span_singleton'.mp (PadicInt.appr_spec k c)
        have hc : (c : ℚ_[ℓ]) = ((c.appr k : ℕ) : ℚ_[ℓ]) + (ck : ℚ_[ℓ]) * (ℓ : ℚ_[ℓ]) ^ k := by
          have := congrArg (fun t : ℤ_[ℓ] => (t : ℚ_[ℓ])) hck
          push_cast at this
          linear_combination -this
        obtain ⟨yk, hyk⟩ := hM3 x ck
        obtain ⟨zk, hzk⟩ := hN3 (φ x) ck
        have e1 : ιM y = ιM (c.appr k • x + (ℓ ^ k : ℕ) • yk) := by
          rw [map_add, map_nsmul, map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ],
            ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], hyk, hy, hc]
          push_cast
          module
        have e3 : ιN (φ y) = ((c.appr k : ℕ) : ℚ_[ℓ]) • ιN (φ x) +
            (ℓ : ℚ_[ℓ]) ^ k • ιN (φ yk) := by
          rw [W' _ _ e1, map_add, map_add, map_nsmul, map_nsmul, map_nsmul, map_nsmul,
            ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], Nat.cast_pow]
        refine ⟨φ yk - zk, ?_⟩
        simp only [map_sub]
        rw [e3, hz, hzk, hc]
        module
      rw [map_sub, sub_eq_zero] at key
      rw [key, hz]

    have S : ∀ (y) (xs : Fin r → H) (cs : Fin r → ℤ_[ℓ]),
        ιM y = ∑ j, (cs j : ℚ_[ℓ]) • ιM (xs j) →
        ιN (φ y) = ∑ j, (cs j : ℚ_[ℓ]) • ιN (φ (xs j)) := by
      intro y xs cs hy
      choose ys hys using fun j => hM3 (xs j) (cs j)
      have h1' : ιM y = ιM (∑ j, ys j) := by
        rw [hy, map_sum]
        exact Finset.sum_congr rfl (fun j _ => (hys j).symm)
      rw [W' _ _ h1', map_sum, map_sum]
      exact Finset.sum_congr rfl (fun j _ => Z (xs j) (ys j) (cs j) (hys j))

    choose kk xx hxx using fun j : Fin r => hM2 (Pi.single j 1)
    obtain ⟨B, hB⟩ : ∃ B : Matrix (Fin s) (Fin r) ℚ_[ℓ],
        B = Matrix.of fun i j => ((ℓ : ℚ_[ℓ]) ^ kk j)⁻¹ * ιN (φ (xx j)) i := ⟨_, rfl⟩
    have hcol : ∀ j, B.mulVec (ιM (xx j)) = ιN (φ (xx j)) := by
      intro j
      rw [← hxx j, Matrix.mulVec_smul]
      ext i
      simp only [hB, Pi.smul_apply, smul_eq_mul, Matrix.mulVec, dotProduct, Pi.single_apply,
        mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ,
        if_true, Matrix.of_apply]
      field_simp
    refine ⟨B, fun x => ?_⟩
    have hnl : ‖(ℓ : ℚ_[ℓ])‖ < 1 := Padic.norm_p_lt_one
    have hn0 : 0 ≤ ‖(ℓ : ℚ_[ℓ])‖ := norm_nonneg _
    have hex : ∀ q : ℚ_[ℓ], ∃ n : ℕ, ‖(ℓ : ℚ_[ℓ])‖ ^ n * ‖q‖ ≤ 1 := by
      intro q
      rcases eq_or_lt_of_le (norm_nonneg q) with h | h
      · exact ⟨0, by rw [← h]; simp⟩
      · obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one (inv_pos.mpr h) hnl
        exact ⟨n, (le_div_iff₀ h).mp (by rw [one_div]; exact hn.le)⟩
    choose mm hmm using fun j => hex (((ℓ : ℚ_[ℓ]) ^ kk j)⁻¹ * ιM x j)
    set m := ∑ j, mm j with hm
    have hbound : ∀ j, ‖(ℓ : ℚ_[ℓ]) ^ m * (((ℓ : ℚ_[ℓ]) ^ kk j)⁻¹ * ιM x j)‖ ≤ 1 := by
      intro j
      rw [norm_mul, norm_pow]
      refine le_trans (mul_le_mul_of_nonneg_right (pow_le_pow_of_le_one hn0 hnl.le
        (Finset.single_le_sum (fun _ _ => Nat.zero_le _) (Finset.mem_univ j))) (norm_nonneg _))
        (hmm j)
    obtain ⟨cc, hcc⟩ : ∃ cc : Fin r → ℤ_[ℓ], ∀ j, (cc j : ℚ_[ℓ]) =
        (ℓ : ℚ_[ℓ]) ^ m * (((ℓ : ℚ_[ℓ]) ^ kk j)⁻¹ * ιM x j) :=
      ⟨fun j => ⟨_, hbound j⟩, fun j => rfl⟩
    have hv : ιM ((ℓ ^ m : ℕ) • x) = ∑ j, (cc j : ℚ_[ℓ]) • ιM (xx j) := by
      rw [map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ]]
      ext i
      simp only [← hxx, hcc, Pi.smul_apply, Finset.sum_apply, smul_eq_mul, Pi.single_apply,
        mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.sum_ite_eq', Finset.mem_univ,
        if_true]
      push_cast
      field_simp
    have e1 : ιN (φ ((ℓ ^ m : ℕ) • x)) = (ℓ : ℚ_[ℓ]) ^ m • ιN (φ x) := by
      rw [map_nsmul, map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], Nat.cast_pow]
    have e2 : ιM ((ℓ ^ m : ℕ) • x) = (ℓ : ℚ_[ℓ]) ^ m • ιM x := by
      rw [map_nsmul, ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], Nat.cast_pow]
    have hfin : (ℓ : ℚ_[ℓ]) ^ m • ιN (φ x) = (ℓ : ℚ_[ℓ]) ^ m • B.mulVec (ιM x) := by
      rw [← e1, S _ xx cc hv, ← Matrix.mulVec_smul, ← e2, hv, Matrix.mulVec_sum]
      simp only [Matrix.mulVec_smul, hcol]
    exact (smul_right_inj (pow_ne_zero m hl0)).mp hfin



  have s2 : ∀ {H : Type (u+1)} [AddCommGroup H] {r n : ℕ} (ι : H →+ (Fin r → ℚ_[ℓ])),
      wcRatCoord ℓ ι → ∀ (B₁ B₂ : Matrix (Fin n) (Fin r) ℚ_[ℓ]),
      (∀ x, B₁.mulVec (ι x) = B₂.mulVec (ι x)) → B₁ = B₂ := by
    intro H _ r n ι hι B₁ B₂ h
    obtain ⟨-, h2', -, -⟩ := hι
    apply Matrix.ext_of_mulVec_single
    intro j
    obtain ⟨k, x, hx⟩ := h2' (Pi.single j 1)
    have := h x
    rw [← hx, Matrix.mulVec_smul, Matrix.mulVec_smul] at this
    exact (smul_right_inj (pow_ne_zero k hl0)).mp this



  have s5 : ∀ {H H' : Type (u+1)} [AddCommGroup H] [AddCommGroup H'] {r s : ℕ}
      (ι : H →+ (Fin r → ℚ_[ℓ])) (ι' : H' →+ (Fin s → ℚ_[ℓ])),
      wcRatCoord ℓ ι → wcRatCoord ℓ ι' →
      ∀ (Φ : H → H) (Φ' : H' → H') (A : Matrix (Fin r) (Fin r) ℚ_[ℓ])
        (A' : Matrix (Fin s) (Fin s) ℚ_[ℓ]),
      (∀ x, ι (Φ x) = A.mulVec (ι x)) → (∀ y, ι' (Φ' y) = A'.mulVec (ι' y)) →
      ∀ (φ : H → H') (ψ : H' → H), (∀ x, ψ (φ x) = x) → (∀ y, φ (ψ y) = y) →
      (∀ x, φ (Φ x) = Φ' (φ x)) →
      ∀ (B : Matrix (Fin s) (Fin r) ℚ_[ℓ]) (B' : Matrix (Fin r) (Fin s) ℚ_[ℓ]),
      (∀ x, ι' (φ x) = B.mulVec (ι x)) → (∀ y, ι (ψ y) = B'.mulVec (ι' y)) →
      A.trace = A'.trace := by
    intro H H' _ _ r s ι ι' hι hι' Φ Φ' A A' hA hA' φ ψ hψφ hφψ hφΦ B B' hB hB'
    have h1 : B' * B = 1 := s2 ι hι _ _ (fun x => by
      rw [← Matrix.mulVec_mulVec, ← hB x, ← hB' (φ x), hψφ, Matrix.one_mulVec])
    have h2 : B * B' = 1 := s2 ι' hι' _ _ (fun y => by
      rw [← Matrix.mulVec_mulVec, ← hB' y, ← hB (ψ y), hφψ, Matrix.one_mulVec])
    have h3 : B * A = A' * B := s2 ι hι _ _ (fun x => by
      rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, ← hA x, ← hB (Φ x), hφΦ, hA', hB x])
    calc A.trace = (A * (B' * B)).trace := by rw [h1, Matrix.mul_one]
      _ = ((A * B') * B).trace := by rw [Matrix.mul_assoc]
      _ = (B * (A * B')).trace := Matrix.trace_mul_comm _ _
      _ = ((B * A) * B').trace := by rw [Matrix.mul_assoc]
      _ = ((A' * B) * B').trace := by rw [h3]
      _ = (A' * (B * B')).trace := by rw [Matrix.mul_assoc]
      _ = A'.trace := by rw [h2, Matrix.mul_one]



  have hsingle : (MonoidAlgebra.single (PUnit.unit⁻¹ : PUnit.{u+1}) (1 : ℤ_[ℓ])) = 1 := by
    rw [MonoidAlgebra.one_def]
  have hsingle' : (MonoidAlgebra.single (PUnit.unit : PUnit.{u+1}) (1 : ℤ_[ℓ])) = 1 := by
    rw [MonoidAlgebra.one_def]
  have hAct : ∀ P : wcGModel ℓ PUnit.{u+1}, wcGModelAct P PUnit.unit = 𝟙 _ := by
    intro P
    apply HomologicalComplex.hom_ext
    intro i
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    apply Subtype.ext
    show (MonoidAlgebra.single (PUnit.unit⁻¹ : PUnit.{u+1}) (1 : ℤ_[ℓ])) • x.down.1 = x.down.1
    rw [hsingle, one_smul]
  have hTr : ∀ (P : wcGModel ℓ PUnit.{u+1}) (e : ℕ),
      wcGModelTr P e PUnit.unit = wcGModelHS P e PUnit.unit := by
    intro P e
    unfold wcGModelTr wcGModelHS
    refine Finset.sum_congr rfl (fun i _ => ?_)
    congr 1
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Fintype.sum_unique]
    show (MonoidAlgebra.single (PUnit.unit⁻¹ : PUnit.{u+1}) (1 : ℤ_[ℓ]) *
        MonoidAlgebra.single (PUnit.unit : PUnit.{u+1}) (1 : ℤ_[ℓ]) * (P.f i ^ e) j j).coeff
          PUnit.unit = ((P.f i ^ e) j j).coeff PUnit.unit
    simp only [hsingle, hsingle', one_mul]



  have hIt : ∀ {X Y : CochainComplex AddCommGrpCat.{u+1} ℕ} (f : X ⟶ Y) (a : X ⟶ X) (b : Y ⟶ Y),
      Homotopy (f ≫ b) (a ≫ f) → ∀ n : ℕ,
        Nonempty (Homotopy (f ≫ wcCxIter b n) (wcCxIter a n ≫ f)) := by
    intro X Y f a b h n
    induction n with
    | zero => exact ⟨Homotopy.ofEq (by simp only [wcCxIter, Category.comp_id, Category.id_comp])⟩
    | succ n ih =>
      obtain ⟨H⟩ := ih
      have e1 : f ≫ wcCxIter b (n + 1) = (f ≫ wcCxIter b n) ≫ b := by
        simp only [wcCxIter, Category.assoc]
      have e2 : (wcCxIter a n ≫ f) ≫ b = wcCxIter a n ≫ (f ≫ b) := Category.assoc _ _ _
      have e3 : wcCxIter a n ≫ (a ≫ f) = wcCxIter a (n + 1) ≫ f := by
        simp only [wcCxIter, Category.assoc]
      exact ⟨(Homotopy.ofEq e1).trans ((H.compRight b).trans ((Homotopy.ofEq e2).trans
        ((h.compLeft (wcCxIter a n)).trans (Homotopy.ofEq e3))))⟩



  have alg : ∀ {X₀ X₁ Y : AddCommGrpCat.{u+1}} (a : X₀ ⟶ Y) (a₁ : X₁ ⟶ Y) [IsIso a] [IsIso a₁]
      (T : X₀ ⟶ X₀) (T₁ : X₁ ⟶ X₁) (TC : Y ⟶ Y), a ≫ TC = T ≫ a → a₁ ≫ TC = T₁ ≫ a₁ →
      (a ≫ inv a₁) ≫ (a₁ ≫ inv a) = 𝟙 _ ∧ (a₁ ≫ inv a) ≫ (a ≫ inv a₁) = 𝟙 _ ∧
        T ≫ (a ≫ inv a₁) = (a ≫ inv a₁) ≫ T₁ := by
    intro X₀ X₁ Y a a₁ _ _ T T₁ TC E E₁
    have E₁' : TC ≫ inv a₁ = inv a₁ ≫ T₁ := by
      rw [← cancel_epi a₁, IsIso.hom_inv_id_assoc, ← Category.assoc, E₁, Category.assoc,
        IsIso.hom_inv_id, Category.comp_id]
    refine ⟨by simp, by simp, ?_⟩
    rw [← Category.assoc, ← E, Category.assoc, E₁', Category.assoc]



  obtain ⟨r, ι, A, hι, hA, htr⟩ := wc_gmodel_hopf_coords ℓ PUnit.{u+1} M e he PUnit.unit
  obtain ⟨r₁, ι₁, A₁, hι₁, hA₁, htr₁⟩ := wc_gmodel_hopf_coords ℓ PUnit.{u+1} M₁ e he PUnit.unit
  simp only [hAct, Category.id_comp] at hA hA₁
  rw [← hTr M e, ← hTr M₁ e]
  apply PadicInt.ext
  rw [htr, htr₁]
  refine Finset.sum_congr rfl (fun i hi => ?_)
  have hi' : i < 3 := Finset.mem_range.mp hi
  congr 1
  obtain ⟨H⟩ := hIt Ψ (wcGModelFrob M) (wcCxFrob K hP 𝓕) hΨF.some e
  obtain ⟨H₁⟩ := hIt Ψ₁ (wcGModelFrob M₁) (wcCxFrob K hP 𝓕) hΨ₁F.some e
  have E : HomologicalComplex.homologyMap Ψ i ≫
      HomologicalComplex.homologyMap (wcCxIter (wcCxFrob K hP 𝓕) e) i =
      HomologicalComplex.homologyMap (wcCxIter (wcGModelFrob M) e) i ≫
        HomologicalComplex.homologyMap Ψ i := by
    rw [← HomologicalComplex.homologyMap_comp, ← HomologicalComplex.homologyMap_comp]
    exact H.homologyMap_eq i
  have E₁ : HomologicalComplex.homologyMap Ψ₁ i ≫
      HomologicalComplex.homologyMap (wcCxIter (wcCxFrob K hP 𝓕) e) i =
      HomologicalComplex.homologyMap (wcCxIter (wcGModelFrob M₁) e) i ≫
        HomologicalComplex.homologyMap Ψ₁ i := by
    rw [← HomologicalComplex.homologyMap_comp, ← HomologicalComplex.homologyMap_comp]
    exact H₁.homologyMap_eq i
  haveI : IsIso (HomologicalComplex.homologyMap Ψ i) :=
    (quasiIsoAt_iff_isIso_homologyMap Ψ i).mp ((quasiIso_iff Ψ).mp hΨ i)
  haveI : IsIso (HomologicalComplex.homologyMap Ψ₁ i) :=
    (quasiIsoAt_iff_isIso_homologyMap Ψ₁ i).mp ((quasiIso_iff Ψ₁).mp hΨ₁ i)
  obtain ⟨h1, h2, h3⟩ := alg (HomologicalComplex.homologyMap Ψ i)
    (HomologicalComplex.homologyMap Ψ₁ i) _ _ _ E E₁
  obtain ⟨B, hB⟩ := s1 (ι i) (ι₁ i) (hι i hi') (hι₁ i hi')
    (HomologicalComplex.homologyMap Ψ i ≫ inv (HomologicalComplex.homologyMap Ψ₁ i)).hom
  obtain ⟨B', hB'⟩ := s1 (ι₁ i) (ι i) (hι₁ i hi') (hι i hi')
    (HomologicalComplex.homologyMap Ψ₁ i ≫ inv (HomologicalComplex.homologyMap Ψ i)).hom
  exact s5 (ι i) (ι₁ i) (hι i hi') (hι₁ i hi')
    (HomologicalComplex.homologyMap (wcCxIter (wcGModelFrob M) e) i).hom
    (HomologicalComplex.homologyMap (wcCxIter (wcGModelFrob M₁) e) i).hom
    (A i) (A₁ i) (hA i hi') (hA₁ i hi')
    (HomologicalComplex.homologyMap Ψ i ≫ inv (HomologicalComplex.homologyMap Ψ₁ i)).hom
    (HomologicalComplex.homologyMap Ψ₁ i ≫ inv (HomologicalComplex.homologyMap Ψ i)).hom
    (fun x => congrArg (fun g => g.hom x) h1) (fun y => congrArg (fun g => g.hom y) h2)
    (fun x => congrArg (fun g => g.hom x) h3) B B' hB hB'

theorem wc_h2rc_lattice_reduction (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G)
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP) (k : ℕ)
    (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (Pm : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])) (J : Subobject G)
    (hF : wcH2Frame K hP ℓ m S G σ W w k θ Pm J)
    (n : ℕ) (hn : 1 ≤ n) :
    ∃ M₁ : wcGModel ℓ PUnit.{u+1},
      (∃ Ψ₁ : wcGModelAb M₁ ⟶ wcCx K hP (Subobject.underlying.obj J), QuasiIso Ψ₁ ∧
        Nonempty (Homotopy (Ψ₁ ≫ wcCxFrob K hP (Subobject.underlying.obj J))
          (wcGModelFrob M₁ ≫ Ψ₁))) ∧
      ∃ (J₂ : CochainComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left)
          AddCommGrpCat.{u+1}) ℕ)
        (η₂ : Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J)) ⟶ J₂.X 0),
        wcNTorsRes K hP (ℓ ^ n) _ J₂ η₂ ∧
        ∃ Q' : wcLnModel (ZMod (ℓ ^ n)),
          wcIsTwist ℓ n (1 : PUnit.{u+1} →* GL (Fin 1) (ZMod (ℓ ^ n))) M₁ Q' ∧
          ∃ Ψ₂ : wcLnModelAb.{u+1} Q' ⟶ wcCxJ K hP J₂, QuasiIso Ψ₂ ∧
            Nonempty (Homotopy (Ψ₂ ≫ wcCxJFrob K hP J₂) (wcLnModelFrob Q' ≫ Ψ₂)) :=
by
  classical
  obtain ⟨hqc, hconn, hoff, hsurj, hθ, hint, hJ⟩ := hF
  have hℓpos : 0 < ℓ := (Fact.out : ℓ.Prime).pos

  obtain ⟨τ, hτ⟩ := wc_lcfa_lattice_int_stable K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero W w
    hqc hconn hoff hsurj k θ hθ Pm hint J hJ
  have hτ1 : τ 1 = 𝟙 _ := by
    rw [← cancel_mono J.arrow, hτ, PadicInt.coe_one, hσ1, Category.id_comp, Category.comp_id]
  have hτadd : ∀ a b, τ (a + b) = τ a + τ b := by
    intro a b
    rw [← cancel_mono J.arrow, hτ (a + b), PadicInt.coe_add, hσadd, Preadditive.comp_add,
      Preadditive.add_comp, hτ a, hτ b]
  have hτmul : ∀ a b, τ (a * b) = τ b ≫ τ a := by
    intro a b
    rw [← cancel_mono J.arrow, Category.assoc, hτ a, reassoc_of% (hτ b), hτ (a * b),
      PadicInt.coe_mul, hσmul]
  have hτact : wcRingAct τ := ⟨hτ1, hτadd, hτmul⟩

  have hσmono : ∀ c : ℚ_[ℓ], c ≠ 0 → Mono (σ c) := by
    intro c hc
    have h : σ c ≫ σ c⁻¹ = 𝟙 G := by rw [← hσmul, inv_mul_cancel₀ hc, hσ1]
    haveI : IsSplitMono (σ c) := IsSplitMono.mk' ⟨σ c⁻¹, h⟩
    infer_instance
  have hτmono : ∀ c : ℤ_[ℓ], c ≠ 0 → Mono (τ c) := by
    intro c hc
    have hc' : (c : ℚ_[ℓ]) ≠ 0 := by rwa [Ne, PadicInt.coe_eq_zero]
    haveI := hσmono _ hc'
    haveI : Mono (τ c ≫ J.arrow) := by rw [hτ]; infer_instance
    exact mono_of_mono _ J.arrow
  have hτnat : ∀ n : ℕ, τ (n : ℤ_[ℓ]) = n • 𝟙 _ := by
    intro n
    induction n with
    | zero =>
      have h := hτadd 0 0
      rw [add_zero] at h
      simpa using h
    | succ n ih => rw [Nat.cast_succ, hτadd, ih, hτ1, succ_nsmul]
  have hℓmono : ∀ r : ℕ, Mono ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)) := by
    intro r
    rw [← hτnat]
    exact hτmono _ (Nat.cast_ne_zero.mpr (pow_ne_zero _ hℓpos.ne'))

  obtain ⟨ev, hev1, hev2⟩ : ∃ ev : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} →+* ℤ_[ℓ],
      (∀ r, algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) (ev r) = r) ∧
      ∀ c, ev (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) c) = c := by
    refine ⟨(MonoidAlgebra.lift ℤ_[ℓ] ℤ_[ℓ] PUnit.{u+1} 1).toRingHom, ?_, ?_⟩
    · intro r
      show algebraMap _ _ (MonoidAlgebra.lift ℤ_[ℓ] ℤ_[ℓ] PUnit.{u+1} 1 r) = r
      induction r using MonoidAlgebra.induction_linear with
      | zero => simp
      | add x y hx hy => rw [map_add, map_add, hx, hy]
      | single g a =>
        rw [MonoidAlgebra.lift_single]
        simp
    · intro c
      show MonoidAlgebra.lift ℤ_[ℓ] ℤ_[ℓ] PUnit.{u+1} 1 (algebraMap _ _ c) = c
      rw [AlgHom.commutes]
      rfl
  obtain ⟨lamJ, hlamJdef⟩ : ∃ f : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} →
      (Subobject.underlying.obj J ⟶ Subobject.underlying.obj J), ∀ r, f r = τ (ev r) :=
    ⟨fun r => τ (ev r), fun _ => rfl⟩
  have hlamJ : wcRingAct lamJ := by
    refine ⟨?_, ?_, ?_⟩
    · simp only [hlamJdef, map_one, hτ1]
    · intro a b
      simp only [hlamJdef, map_add, hτadd]
    · intro a b
      simp only [hlamJdef, map_mul, hτmul]
  have hlamJmono : ∀ r : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}, r ≠ 0 → Mono (lamJ r) := by
    intro r hr
    rw [hlamJdef]
    apply hτmono
    intro h0
    apply hr
    rw [← hev1 r, h0, map_zero]
  have hlamJalg : ∀ c : ℤ_[ℓ], lamJ (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) c) = τ c := by
    intro c
    rw [hlamJdef, hev2]

  have hR : ∀ (n : ℕ) (r : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}), 0 < n →
      (n : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) * r = 0 → r = 0 := by
    intro n r hn h
    have h2 := congrArg ev h
    rw [map_mul, map_natCast, map_zero] at h2
    have h3 : ev r = 0 := (mul_eq_zero.mp h2).resolve_left (Nat.cast_ne_zero.mpr hn.ne')
    rw [← hev1 r, h3, map_zero]
  obtain ⟨I, lamI, hspec⟩ := wc_ring_injective_resolution (wcP1Over K).left
    (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) hR (Subobject.underlying.obj J) lamJ hlamJ
  have hspec' := hspec
  obtain ⟨hIact, hI0, -⟩ := hspec'
  obtain ⟨hIone, hIadd, hImul⟩ := hIact

  set E := (preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
    (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex (ComplexShape.up ℕ) with hEdef
  set 𝔉 := NatTrans.mapHomologicalComplex (preadditiveCoyoneda.map
    (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)).op)
    (ComplexShape.up ℕ) with h𝔉def
  have hLD : wcRingAct (fun r => E.map (lamI r)) := by
    refine ⟨?_, ?_, ?_⟩
    · show E.map (lamI 1) = 𝟙 _
      rw [hIone, CategoryTheory.Functor.map_id]
    · intro a b
      show E.map (lamI (a + b)) = E.map (lamI a) + E.map (lamI b)
      rw [hIadd, Functor.map_add]
    · intro a b
      show E.map (lamI (a * b)) = E.map (lamI b) ≫ E.map (lamI a)
      rw [hImul, Functor.map_comp]
  have hFr : ∀ r, (fun r => E.map (lamI r)) r ≫ 𝔉.app I.cocomplex =
      𝔉.app I.cocomplex ≫ (fun r => E.map (lamI r)) r := fun r => 𝔉.naturality (lamI r)

  have hmodfin := wc_lcfa_mod_finite K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero W w
    hqc hconn hoff hsurj k θ hθ Pm hint J hJ
  have hLr : ∀ r : ℕ, (ℓ ^ r : ℕ) •
      𝟙 (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))) = 0 := by
    intro r
    have h1 := Limits.cokernel.condition ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))
    rw [Preadditive.nsmul_comp, Category.id_comp] at h1
    rw [← cancel_epi (Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))),
      Limits.comp_zero, Preadditive.comp_nsmul, Category.comp_id]
    exact h1
  have hne : Nonempty W.left := @ConnectedSpace.toNonempty _ _ hconn
  have h7a : ∀ (r j : ℕ), 3 ≤ j → ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP))
      (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))) j, x = 0 := by
    intro r j hj x
    obtain ⟨θr, -⟩ := wc_qclift_level_frame K hP ℓ G W hne k θ Pm hint J hJ r
    exact wc_h2im_torsion_ext_high_vanish K ℓ hℓ hP m S hS _ r (hLr r) W w hqc hconn hsurj k θr
      j hj x
  have hvanJ : ∀ n, 3 ≤ n → ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP)) (Subobject.underlying.obj J) n, x = 0 := by
    intro n hn x
    obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
    have hfin' : ∀ r : ℕ, Finite (Abelian.Ext (wcFreeSheaf (wcP1Over K).left
        (wcGeomPoint K (wcP1Over K) hP))
        (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))) n') := by
      intro r
      rcases (show n' = 2 ∨ 3 ≤ n' by omega) with h | h
      · subst h
        exact hmodfin r 2 le_rfl
      · haveI : Subsingleton (Abelian.Ext (wcFreeSheaf (wcP1Over K).left
            (wcGeomPoint K (wcP1Over K) hP))
            (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))) n') :=
          ⟨fun a b => by rw [h7a r n' h a, h7a r n' h b]⟩
        exact Finite.of_subsingleton
    exact wc_h2im_int_separated_succ K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero W w
      hqc hconn hoff hsurj k θ hθ Pm hint J hJ n' hfin' x (fun r => h7a r (n' + 1) hn _)
  have hsep : ∀ n, n ≤ 2 → ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP)) (Subobject.underlying.obj J) n,
      (∀ r : ℕ, x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π
        ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)))) (add_zero n) = 0) → x = 0 := by
    intro n hn x hx
    rcases n with _ | n
    · exact wc_h2im_H0_separated K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero W w
        hqc hconn hoff hsurj k θ hθ Pm hint J hJ x hx
    · exact wc_lcfa_int_separated K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero W w
        hqc hconn hoff hsurj k θ hθ Pm hint J hJ (fun r i hi => hmodfin r i (by omega))
        (n + 1) (by omega) hn x hx
  have hfg : ∀ n, ∃ (k' : ℕ) (e : Fin k' → Abelian.Ext (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP)) (Subobject.underlying.obj J) n),
      ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left
        (wcGeomPoint K (wcP1Over K) hP)) (Subobject.underlying.obj J) n,
      ∃ c : Fin k' → MonoidAlgebra ℤ_[ℓ] PUnit.{u+1},
        x = ∑ i, (e i).comp (Abelian.Ext.mk₀ (lamJ (c i))) (add_zero n) := by
    intro n
    rcases (show n ≤ 2 ∨ 3 ≤ n by omega) with hn | hn
    · obtain ⟨k', e', he'⟩ := wc_h2im_ext_fg_of_mod_sep ℓ
        (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
        (Subobject.underlying.obj J) τ hτact (hℓmono 1) n (hmodfin 1 n hn) (hsep n hn)
      refine ⟨k', e', fun x => ?_⟩
      obtain ⟨c, hc⟩ := he' x
      refine ⟨fun i => algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) (c i), ?_⟩
      simp only [hlamJalg]
      exact hc
    · refine ⟨0, Fin.elim0, fun x => ⟨Fin.elim0, ?_⟩⟩
      rw [hvanJ n hn x, Finset.univ_eq_empty, Finset.sum_empty]

  have hfv := wc_fgvan_of_ext_fg lamJ I lamI hI0
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) hfg hvanJ

  obtain ⟨T⟩ := wc_three_term_model_exists ℓ PUnit.{u+1} (E.obj I.cocomplex)
    (fun r => E.map (lamI r)) hLD hfv
  have htf := wc_h2im_head_torsion_free (wcP1Over K).left ℓ (Subobject.underlying.obj J)
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) lamJ hlamJmono I lamI hI0 T
  haveI : Module.Finite (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) T.M := T.fin
  have hproj := wc_h2im_punit_tf_projective ℓ T.M htf
  obtain ⟨M, φ, hφ, hlin, h, hhlin⟩ := wc_gmodel_linear_of_projective_head ℓ PUnit.{u+1}
    (E.obj I.cocomplex) (fun r => E.map (lamI r)) hLD (𝔉.app I.cocomplex) hFr T hproj

  let c := InjectiveResolution.homotopyEquiv I (injectiveResolution (Subobject.underlying.obj J))
  have hEc : QuasiIso (E.map c.hom) := by
    have h := HomotopyEquiv.quasiIso_hom
      ((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
        (wcGeomPoint K (wcP1Over K) hP)))).mapHomotopyEquiv c)
    rw [Functor.mapHomotopyEquiv_hom] at h
    exact h
  have nat : E.map c.hom ≫ 𝔉.app (injectiveResolution (Subobject.underlying.obj J)).cocomplex =
      𝔉.app I.cocomplex ≫ E.map c.hom := 𝔉.naturality c.hom
  have hΨ₁ : QuasiIso (φ ≫ E.map c.hom) := by
    haveI := hφ
    haveI := hEc
    exact quasiIso_comp (φ := φ) (φ' := E.map c.hom)
  have H₁ : Homotopy ((φ ≫ E.map c.hom) ≫ wcCxFrob K hP (Subobject.underlying.obj J))
      (wcGModelFrob M ≫ (φ ≫ E.map c.hom)) := by
    refine (Homotopy.ofEq ?_).trans ((h.compRight (E.map c.hom)).trans (Homotopy.ofEq ?_))
    · exact (Category.assoc _ _ _).trans ((congrArg (φ ≫ ·) nat).trans (Category.assoc _ _ _).symm)
    · exact Category.assoc _ _ _

  have hLN := hℓmono n
  have hses : ∃ w : ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J)) ≫
      Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J)) = 0,
      (ShortComplex.mk _ _ w).ShortExact :=
    ⟨Limits.cokernel.condition _,
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hLN inferInstance⟩
  have hN : 1 ≤ ℓ ^ n := Nat.one_le_pow n ℓ hℓpos
  obtain ⟨η₂, h₂⟩ := wcU_lm_trunc_ker_res K hP (Subobject.underlying.obj J)
    (Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J))) I (ℓ ^ n) hN
    (Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J))) hses

  obtain ⟨Q', hQ'⟩ := wcU_twist_exists ℓ n (1 : PUnit.{u+1} →* GL (Fin 1) (ZMod (ℓ ^ n))) M
  obtain ⟨Ψ₂, hΨ₂, hΨ₂F⟩ := wcU_lm_bockstein_model K hP ℓ (Subobject.underlying.obj J) lamJ hlamJ
    I lamI hspec n hn hLN M φ hφ hlin h hhlin Q' hQ'
  exact ⟨M, ⟨φ ≫ E.map c.hom, hΨ₁, ⟨H₁⟩⟩, wcTruncKerRes I.cocomplex (ℓ ^ n), η₂, h₂, Q', hQ',
    Ψ₂, hΨ₂, hΨ₂F⟩

theorem wc_h2rc_res_map_quasiIso (X : Scheme.{u})
    (P A B : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
    (J₁ J₂ : CochainComplex (Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) ℕ)
    (η₁ : A ⟶ J₁.X 0) (η₂ : B ⟶ J₂.X 0) (lam : A ⟶ B) (μ : J₁ ⟶ J₂)
    (hμ : η₁ ≫ μ.f 0 = lam ≫ η₂) (hm₁ : Mono η₁) (hm₂ : Mono η₂)
    (he₁ : ∃ w : η₁ ≫ J₁.d 0 1 = 0, (ShortComplex.mk η₁ (J₁.d 0 1) w).Exact)
    (he₂ : ∃ w : η₂ ≫ J₂.d 0 1 = 0, (ShortComplex.mk η₂ (J₂.d 0 1) w).Exact)
    (hx₁ : ∀ i, (J₁.sc (i + 1)).Exact) (hx₂ : ∀ i, (J₂.sc (i + 1)).Exact)
    (ha₁ : ∀ (i j : ℕ), 1 ≤ j → ∀ y : Abelian.Ext P (J₁.X i) j, y = 0)
    (ha₂ : ∀ (i j : ℕ), 1 ≤ j → ∀ y : Abelian.Ext P (J₂.X i) j, y = 0)
    (hlam : ∀ q : ℕ, Function.Bijective
      (fun x : Abelian.Ext P A q => x.comp (Abelian.Ext.mk₀ lam) (add_zero q))) :
    QuasiIso (((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
      (ComplexShape.up ℕ)).map μ) :=
by
  classical

  have s1 : ∀ {K L : CochainComplex AddCommGrpCat.{u+1} ℕ} (φ : K ⟶ L),
      (∀ (n : ℕ) (x : K.X n), (K.d n (n + 1)).hom x = 0 → ∀ y : L.X (n - 1),
        (φ.f n).hom x = (L.d (n - 1) n).hom y → ∃ x' : K.X (n - 1), (K.d (n - 1) n).hom x' = x) →
      (∀ (n : ℕ) (y : L.X n), (L.d n (n + 1)).hom y = 0 → ∃ x : K.X n,
        (K.d n (n + 1)).hom x = 0 ∧ ∃ w : L.X (n - 1), (L.d (n - 1) n).hom w = (φ.f n).hom x - y) →
      QuasiIso φ := by
    intro K L φ hinj hsurj
    rw [quasiIso_iff]
    intro n
    have hp : (ComplexShape.up ℕ).prev n = n - 1 := by
      rcases n with _ | m
      · exact CochainComplex.prev_nat_zero
      · exact CochainComplex.prev_nat_succ m
    have hn : (ComplexShape.up ℕ).next n = n + 1 := ComplexShape.next_eq' _ rfl
    rw [quasiIsoAt_iff' φ (n - 1) n (n + 1) hp hn, ShortComplex.quasiIso_iff]
    have hmono : Mono (ShortComplex.homologyMap
        ((HomologicalComplex.shortComplexFunctor' AddCommGrpCat (ComplexShape.up ℕ)
          (n - 1) n (n + 1)).map φ)) := by
      rw [ShortComplex.mono_homologyMap_iff_up_to_refinements]
      intro A x₂ hx₂ y₁ hxy
      have hx : ∀ a, (K.d n (n + 1)).hom (x₂ a) = 0 := fun a => by
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f a) hx₂
      have hy : ∀ a, (φ.f n).hom (x₂ a) = (L.d (n - 1) n).hom (y₁ a) := fun a => by
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f a) hxy
      choose g hg using fun a => hinj n (x₂ a) (hx a) (y₁ a) (hy a)
      refine ⟨AddCommGrpCat.of (FreeAbelianGroup A),
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift id), ?_,
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift g), ?_⟩
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro a
        exact ⟨FreeAbelianGroup.of a, by simp [FreeAbelianGroup.lift_apply_of]⟩
      · ext z
        change x₂.hom (FreeAbelianGroup.lift id (FreeAbelianGroup.of z)) =
          (K.d (n - 1) n).hom (FreeAbelianGroup.lift g (FreeAbelianGroup.of z))
        rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
        exact (hg z).symm
    have hepi : Epi (ShortComplex.homologyMap
        ((HomologicalComplex.shortComplexFunctor' AddCommGrpCat (ComplexShape.up ℕ)
          (n - 1) n (n + 1)).map φ)) := by
      rw [ShortComplex.epi_homologyMap_iff_up_to_refinements]
      intro A y₂ hy₂
      have hy : ∀ a, (L.d n (n + 1)).hom (y₂ a) = 0 := fun a => by
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f a) hy₂
      choose x hx w hw using fun a => hsurj n (y₂ a) (hy a)
      refine ⟨AddCommGrpCat.of (FreeAbelianGroup A),
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift id), ?_,
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift x), ?_,
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun a => -w a)), ?_⟩
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro a
        exact ⟨FreeAbelianGroup.of a, by simp [FreeAbelianGroup.lift_apply_of]⟩
      · ext z
        change (K.d n (n + 1)).hom (FreeAbelianGroup.lift x (FreeAbelianGroup.of z)) = 0
        rw [FreeAbelianGroup.lift_apply_of]
        exact hx z
      · ext z
        have e := hw z
        change y₂.hom (FreeAbelianGroup.lift id (FreeAbelianGroup.of z)) =
          (φ.f n).hom (FreeAbelianGroup.lift x (FreeAbelianGroup.of z)) +
          (L.d (n - 1) n).hom (FreeAbelianGroup.lift (fun a => -w a) (FreeAbelianGroup.of z))
        rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of,
          FreeAbelianGroup.lift_apply_of, map_neg]
        change _ = _ + -((L.d (n - 1) n).hom (w z))
        rw [e]
        have key : ∀ (G : Type (u+1)) [AddCommGroup G] (a b : G), b = a + -(a - b) :=
          fun G _ a b => by abel
        exact key _ _ _
    exact isIso_of_mono_of_epi _

  have s2 : ∀ {S : ShortComplex (Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})}
      (hS : S.ShortExact),
      (∀ (j : ℕ), 1 ≤ j → ∀ y : Abelian.Ext P S.X₂ j, y = 0) →
      (∀ q : ℕ, Function.Surjective
        (fun y : Abelian.Ext P S.X₃ q => y.comp hS.extClass (rfl : q + 1 = q + 1))) ∧
      (∀ q : ℕ, 1 ≤ q → Function.Injective
        (fun y : Abelian.Ext P S.X₃ q => y.comp hS.extClass (rfl : q + 1 = q + 1))) ∧
      (∀ g : P ⟶ S.X₃, (Abelian.Ext.mk₀ g).comp hS.extClass (rfl : 0 + 1 = 0 + 1) = 0 ↔
        ∃ g' : P ⟶ S.X₂, g' ≫ S.g = g) := by
    intro S hS hacyc
    refine ⟨fun q z => ?_, fun q hq y₁ y₂ h => ?_, fun g => ⟨fun h => ?_, fun ⟨g', hg'⟩ => ?_⟩⟩
    · obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS z
        (hacyc (q + 1) (by omega) _) (rfl : q + 1 = q + 1)
      exact ⟨x₃, hx₃⟩
    · have h' : y₁.comp hS.extClass (rfl : q + 1 = q + 1) =
          y₂.comp hS.extClass (rfl : q + 1 = q + 1) := h
      have hδ : (y₁ - y₂).comp hS.extClass (rfl : q + 1 = q + 1) = 0 := by
        rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, h', add_neg_cancel]
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS (y₁ - y₂) rfl hδ
      rw [hacyc q hq x₂, Abelian.Ext.zero_comp] at hx₂
      exact sub_eq_zero.mp hx₂.symm
    · obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS (Abelian.Ext.mk₀ g) rfl h
      obtain ⟨g', rfl⟩ := (Abelian.Ext.mk₀_bijective P S.X₂).2 x₂
      rw [Abelian.Ext.mk₀_comp_mk₀] at hx₂
      exact ⟨g', (Abelian.Ext.mk₀_bijective P S.X₃).1 hx₂⟩
    · rw [← hg', ← Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega), hS.comp_extClass,
        Abelian.Ext.comp_zero]

  have s3 : ∀ (J : CochainComplex (Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) ℕ),
      (∀ i, (J.sc (i + 1)).Exact) → ∀ (i : ℕ)
      (p : J.X i ⟶ Limits.kernel (J.d (i + 1) (i + 1 + 1))),
      p ≫ Limits.kernel.ι (J.d (i + 1) (i + 1 + 1)) = J.d i (i + 1) →
      ∃ w : Limits.kernel.ι (J.d i (i + 1)) ≫ p = 0, (ShortComplex.mk _ _ w).ShortExact := by
    intro J hx i p hp
    have w : Limits.kernel.ι (J.d i (i + 1)) ≫ p = 0 := by
      rw [← cancel_mono (Limits.kernel.ι (J.d (i + 1) (i + 1 + 1))), Category.assoc, hp,
        Limits.kernel.condition, Limits.zero_comp]
    refine ⟨w, ?_⟩
    have hS' : (J.sc' i (i + 1) (i + 1 + 1)).Exact :=
      (J.exactAt_iff' i (i + 1) (i + 1 + 1) (CochainComplex.prev_nat_succ i)
        (CochainComplex.next ℕ (i + 1))).1 (hx i)
    have hpl : p = Limits.kernel.lift (J.d (i + 1) (i + 1 + 1)) (J.d i (i + 1))
        (J.d_comp_d i (i + 1) (i + 1 + 1)) := by
      rw [← cancel_mono (Limits.kernel.ι (J.d (i + 1) (i + 1 + 1))), hp, Limits.kernel.lift_ι]
    have hepi : Epi p := by
      rw [hpl]
      exact hS'.epi_kernelLift
    have hmono : Mono (Limits.kernel.ι (J.d i (i + 1))) := inferInstance
    refine ShortComplex.ShortExact.mk' ?_ hmono hepi
    let φ : ShortComplex.mk _ _ w ⟶
        ShortComplex.mk (Limits.kernel.ι (J.d i (i + 1))) (J.d i (i + 1))
          (Limits.kernel.condition _) :=
      { τ₁ := 𝟙 _
        τ₂ := 𝟙 _
        τ₃ := Limits.kernel.ι (J.d (i + 1) (i + 1 + 1))
        comm₁₂ := by simp
        comm₂₃ := by simp [hp] }
    haveI : Epi φ.τ₁ := by show Epi (𝟙 _); infer_instance
    haveI : IsIso φ.τ₂ := by show IsIso (𝟙 _); infer_instance
    haveI : Mono φ.τ₃ := by show Mono (Limits.kernel.ι _); infer_instance
    rw [ShortComplex.exact_iff_of_epi_of_isIso_of_mono φ]
    exact ShortComplex.exact_kernel _

  have s4 : ∀ {S₁ S₂ : ShortComplex (Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})}
      (h₁ : S₁.ShortExact) (h₂ : S₂.ShortExact) (f : S₁ ⟶ S₂)
      (q : ℕ) (y : Abelian.Ext P S₁.X₃ q),
      (y.comp (Abelian.Ext.mk₀ f.τ₃) (add_zero q)).comp h₂.extClass (rfl : q + 1 = q + 1) =
        (y.comp h₁.extClass (rfl : q + 1 = q + 1)).comp (Abelian.Ext.mk₀ f.τ₁)
          (add_zero (q + 1)) := by
    intro S₁ S₂ h₁ h₂ f q y
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (zero_add 1) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (rfl : q + 1 = q + 1) (add_zero 1) (by omega),
      h₁.extClass_naturality h₂ f]

  have isoBij : ∀ {Y Y' : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}} (φ : Y ⟶ Y')
      [IsIso φ] (q : ℕ), Function.Bijective
      (fun y : Abelian.Ext P Y q => y.comp (Abelian.Ext.mk₀ φ) (add_zero q)) := by
    intro Y Y' φ _ q
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun y => y.comp (Abelian.Ext.mk₀ (inv φ)) (add_zero q), fun y => ?_, fun y => ?_⟩
    · show (y.comp (Abelian.Ext.mk₀ φ) (add_zero q)).comp (Abelian.Ext.mk₀ (inv φ)) (add_zero q) = y
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · show (y.comp (Abelian.Ext.mk₀ (inv φ)) (add_zero q)).comp (Abelian.Ext.mk₀ φ) (add_zero q) = y
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.comp_mk₀_id]

  obtain ⟨μZ, hμZ⟩ : ∃ μZ : ∀ n, Limits.kernel (J₁.d n (n + 1)) ⟶ Limits.kernel (J₂.d n (n + 1)),
      ∀ n, μZ n ≫ Limits.kernel.ι (J₂.d n (n + 1)) = Limits.kernel.ι (J₁.d n (n + 1)) ≫ μ.f n :=
    ⟨fun n => Limits.kernel.map (J₁.d n (n + 1)) (J₂.d n (n + 1)) (μ.f n) (μ.f (n + 1))
      (μ.comm n (n + 1)).symm, fun n => Limits.kernel.lift_ι _ _ _⟩

  obtain ⟨p₁, hp₁⟩ : ∃ p : ∀ n, J₁.X n ⟶ Limits.kernel (J₁.d (n + 1) (n + 1 + 1)),
      ∀ n, p n ≫ Limits.kernel.ι (J₁.d (n + 1) (n + 1 + 1)) = J₁.d n (n + 1) :=
    ⟨fun n => Limits.kernel.lift _ (J₁.d n (n + 1)) (J₁.d_comp_d _ _ _),
      fun n => Limits.kernel.lift_ι _ _ _⟩
  obtain ⟨p₂, hp₂⟩ : ∃ p : ∀ n, J₂.X n ⟶ Limits.kernel (J₂.d (n + 1) (n + 1 + 1)),
      ∀ n, p n ≫ Limits.kernel.ι (J₂.d (n + 1) (n + 1 + 1)) = J₂.d n (n + 1) :=
    ⟨fun n => Limits.kernel.lift _ (J₂.d n (n + 1)) (J₂.d_comp_d _ _ _),
      fun n => Limits.kernel.lift_ι _ _ _⟩
  choose w₁ hS₁ using fun n => s3 J₁ hx₁ n (p₁ n) (hp₁ n)
  choose w₂ hS₂ using fun n => s3 J₂ hx₂ n (p₂ n) (hp₂ n)

  have natδ : ∀ (n q : ℕ) (y : Abelian.Ext P (Limits.kernel (J₁.d (n + 1) (n + 1 + 1))) q),
      (y.comp (Abelian.Ext.mk₀ (μZ (n + 1))) (add_zero q)).comp (hS₂ n).extClass
          (rfl : q + 1 = q + 1) =
        (y.comp (hS₁ n).extClass (rfl : q + 1 = q + 1)).comp (Abelian.Ext.mk₀ (μZ n))
          (add_zero (q + 1)) := by
    intro n q y
    have c₂ : μ.f n ≫ p₂ n = p₁ n ≫ μZ (n + 1) := by
      rw [← cancel_mono (Limits.kernel.ι (J₂.d (n + 1) (n + 1 + 1))), Category.assoc, hp₂,
        Category.assoc, hμZ, ← Category.assoc, hp₁]
      exact μ.comm n (n + 1)
    exact s4 (hS₁ n) (hS₂ n)
      { τ₁ := μZ n, τ₂ := μ.f n, τ₃ := μZ (n + 1), comm₁₂ := hμZ n, comm₂₃ := c₂ } q y

  have hΦ0 : ∀ q : ℕ, Function.Bijective
      (fun y : Abelian.Ext P (Limits.kernel (J₁.d 0 (0 + 1))) q =>
        y.comp (Abelian.Ext.mk₀ (μZ 0)) (add_zero q)) := by
    obtain ⟨wa, exa⟩ := he₁
    obtain ⟨wb, exb⟩ := he₂
    obtain ⟨e₁, he₁ι⟩ : ∃ e : A ⟶ Limits.kernel (J₁.d 0 (0 + 1)),
        e ≫ Limits.kernel.ι (J₁.d 0 (0 + 1)) = η₁ := ⟨Limits.kernel.lift _ η₁ wa,
          Limits.kernel.lift_ι _ _ _⟩
    obtain ⟨e₂, he₂ι⟩ : ∃ e : B ⟶ Limits.kernel (J₂.d 0 (0 + 1)),
        e ≫ Limits.kernel.ι (J₂.d 0 (0 + 1)) = η₂ := ⟨Limits.kernel.lift _ η₂ wb,
          Limits.kernel.lift_ι _ _ _⟩
    have iso₁ : IsIso e₁ := by
      have hm : Mono e₁ := by
        have : Mono (e₁ ≫ Limits.kernel.ι (J₁.d 0 (0 + 1))) := by rw [he₁ι]; exact hm₁
        exact mono_of_mono e₁ (Limits.kernel.ι (J₁.d 0 (0 + 1)))
      have he : Epi e₁ := by
        have h := exa.epi_kernelLift
        have heq : e₁ = Limits.kernel.lift (J₁.d 0 1) η₁ wa := by
          rw [← cancel_mono (Limits.kernel.ι (J₁.d 0 (0 + 1))), he₁ι]
          exact (Limits.kernel.lift_ι _ _ _).symm
        rw [heq]
        exact h
      exact isIso_of_mono_of_epi e₁
    have iso₂ : IsIso e₂ := by
      have hm : Mono e₂ := by
        have : Mono (e₂ ≫ Limits.kernel.ι (J₂.d 0 (0 + 1))) := by rw [he₂ι]; exact hm₂
        exact mono_of_mono e₂ (Limits.kernel.ι (J₂.d 0 (0 + 1)))
      have he : Epi e₂ := by
        have h := exb.epi_kernelLift
        have heq : e₂ = Limits.kernel.lift (J₂.d 0 1) η₂ wb := by
          rw [← cancel_mono (Limits.kernel.ι (J₂.d 0 (0 + 1))), he₂ι]
          exact (Limits.kernel.lift_ι _ _ _).symm
        rw [heq]
        exact h
      exact isIso_of_mono_of_epi e₂
    have hsq : e₁ ≫ μZ 0 = lam ≫ e₂ := by
      rw [← cancel_mono (Limits.kernel.ι (J₂.d 0 (0 + 1))), Category.assoc, hμZ,
        ← Category.assoc, he₁ι, Category.assoc, he₂ι, hμ]
    have hμZ0 : μZ 0 = inv e₁ ≫ lam ≫ e₂ := by
      rw [← hsq, IsIso.inv_hom_id_assoc]
    intro q
    have hfun : (fun y : Abelian.Ext P (Limits.kernel (J₁.d 0 (0 + 1))) q =>
        y.comp (Abelian.Ext.mk₀ (μZ 0)) (add_zero q)) =
        (fun y : Abelian.Ext P B q => y.comp (Abelian.Ext.mk₀ e₂) (add_zero q)) ∘
        (fun y : Abelian.Ext P A q => y.comp (Abelian.Ext.mk₀ lam) (add_zero q)) ∘
        (fun y : Abelian.Ext P (Limits.kernel (J₁.d 0 (0 + 1))) q =>
          y.comp (Abelian.Ext.mk₀ (inv e₁)) (add_zero q)) := by
      funext y
      simp only [Function.comp_apply]
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
        Abelian.Ext.comp_assoc _ _ _ (add_zero q) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hμZ0]
    rw [hfun]
    exact (isoBij e₂ q).comp ((hlam q).comp (isoBij (inv e₁) q))

  have hΦpos : ∀ (n q : ℕ), 1 ≤ q → Function.Bijective
      (fun y : Abelian.Ext P (Limits.kernel (J₁.d n (n + 1))) q =>
        y.comp (Abelian.Ext.mk₀ (μZ n)) (add_zero q)) := by
    intro n
    induction n with
    | zero => intro q _; exact hΦ0 q
    | succ n ih =>
      intro q hq
      obtain ⟨δ₁surj, δ₁inj, -⟩ := s2 (hS₁ n) (ha₁ n)
      obtain ⟨δ₂surj, δ₂inj, -⟩ := s2 (hS₂ n) (ha₂ n)
      have ihq := ih (q + 1) (by omega)
      refine ⟨fun y y' h => ?_, fun z => ?_⟩
      · have h' : y.comp (Abelian.Ext.mk₀ (μZ (n + 1))) (add_zero q) =
            y'.comp (Abelian.Ext.mk₀ (μZ (n + 1))) (add_zero q) := h
        have h2 := congrArg (fun t => t.comp (hS₂ n).extClass (rfl : q + 1 = q + 1)) h'
        simp only at h2
        rw [natδ, natδ] at h2
        exact δ₁inj q hq (ihq.1 h2)
      · obtain ⟨u, hu⟩ := ihq.2 (z.comp (hS₂ n).extClass (rfl : q + 1 = q + 1))
        obtain ⟨y, hy⟩ := δ₁surj q u
        refine ⟨y, δ₂inj q hq ?_⟩
        show (y.comp (Abelian.Ext.mk₀ (μZ (n + 1))) (add_zero q)).comp (hS₂ n).extClass
            (rfl : q + 1 = q + 1) = z.comp (hS₂ n).extClass (rfl : q + 1 = q + 1)
        rw [natδ]
        have hy' : y.comp (hS₁ n).extClass (rfl : q + 1 = q + 1) = u := hy
        rw [hy']
        exact hu

  have auxInj : ∀ (m : ℕ) (x : P ⟶ J₁.X (m + 1)), x ≫ J₁.d (m + 1) (m + 1 + 1) = 0 →
      ∀ y : P ⟶ J₂.X m, x ≫ μ.f (m + 1) = y ≫ J₂.d m (m + 1) →
      ∃ x' : P ⟶ J₁.X m, x' ≫ J₁.d m (m + 1) = x := by
    intro m x hx y hxy
    obtain ⟨-, -, hc₁⟩ := s2 (hS₁ m) (ha₁ m)
    obtain ⟨-, -, hc₂⟩ := s2 (hS₂ m) (ha₂ m)
    have h1 : Limits.kernel.lift (J₁.d (m + 1) (m + 1 + 1)) x hx ≫ μZ (m + 1) = y ≫ p₂ m := by
      rw [← cancel_mono (Limits.kernel.ι (J₂.d (m + 1) (m + 1 + 1))), Category.assoc,
        hμZ (m + 1), ← Category.assoc, Limits.kernel.lift_ι, Category.assoc, hp₂ m]
      exact hxy
    have h2 : (Abelian.Ext.mk₀ (y ≫ p₂ m)).comp (hS₂ m).extClass (rfl : 0 + 1 = 0 + 1) = 0 :=
      (hc₂ _).2 ⟨y, rfl⟩
    have h3 := natδ m 0 (Abelian.Ext.mk₀ (Limits.kernel.lift (J₁.d (m + 1) (m + 1 + 1)) x hx))
    rw [Abelian.Ext.mk₀_comp_mk₀, h1, h2] at h3
    have h4 : ((Abelian.Ext.mk₀ (Limits.kernel.lift (J₁.d (m + 1) (m + 1 + 1)) x hx)).comp
        (hS₁ m).extClass (rfl : 0 + 1 = 0 + 1) :
          Abelian.Ext P (Limits.kernel (J₁.d m (m + 1))) 1) = 0 := by
      apply (hΦpos m 1 le_rfl).1
      show ((Abelian.Ext.mk₀ (Limits.kernel.lift (J₁.d (m + 1) (m + 1 + 1)) x hx)).comp
        (hS₁ m).extClass (rfl : 0 + 1 = 0 + 1)).comp (Abelian.Ext.mk₀ (μZ m)) (add_zero 1) =
        (0 : Abelian.Ext P (Limits.kernel (J₁.d m (m + 1))) 1).comp
          (Abelian.Ext.mk₀ (μZ m)) (add_zero 1)
      rw [Abelian.Ext.zero_comp]
      exact h3.symm
    obtain ⟨g', hg'⟩ := (hc₁ _).1 h4
    have hg'' : g' ≫ p₁ m = Limits.kernel.lift (J₁.d (m + 1) (m + 1 + 1)) x hx := hg'
    refine ⟨g', ?_⟩
    rw [← hp₁ m, ← Category.assoc, hg'', Limits.kernel.lift_ι]
  have auxSurj : ∀ (m : ℕ) (y : P ⟶ J₂.X (m + 1)), y ≫ J₂.d (m + 1) (m + 1 + 1) = 0 →
      ∃ x : P ⟶ J₁.X (m + 1), x ≫ J₁.d (m + 1) (m + 1 + 1) = 0 ∧
        ∃ w : P ⟶ J₂.X m, w ≫ J₂.d m (m + 1) = x ≫ μ.f (m + 1) - y := by
    intro m y hy
    obtain ⟨δ₁surj, -, -⟩ := s2 (hS₁ m) (ha₁ m)
    obtain ⟨-, -, hc₂⟩ := s2 (hS₂ m) (ha₂ m)
    obtain ⟨u, hu⟩ := (hΦpos m 1 le_rfl).2
      ((Abelian.Ext.mk₀ (Limits.kernel.lift (J₂.d (m + 1) (m + 1 + 1)) y hy)).comp
        (hS₂ m).extClass (rfl : 0 + 1 = 0 + 1))
    obtain ⟨z, hz⟩ := δ₁surj 0 u
    obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective P _).2 z
    have hz' : (Abelian.Ext.mk₀ g).comp (hS₁ m).extClass (rfl : 0 + 1 = 0 + 1) = u := hz
    have e1 : (Abelian.Ext.mk₀ (g ≫ μZ (m + 1))).comp (hS₂ m).extClass (rfl : 0 + 1 = 0 + 1) =
        (Abelian.Ext.mk₀ (Limits.kernel.lift (J₂.d (m + 1) (m + 1 + 1)) y hy)).comp
          (hS₂ m).extClass (rfl : 0 + 1 = 0 + 1) := by
      rw [← Abelian.Ext.mk₀_comp_mk₀, natδ, hz']
      exact hu
    have e2 : (Abelian.Ext.mk₀ (g ≫ μZ (m + 1) -
        Limits.kernel.lift (J₂.d (m + 1) (m + 1 + 1)) y hy)).comp (hS₂ m).extClass
          (rfl : 0 + 1 = 0 + 1) = 0 := by
      rw [sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp, Abelian.Ext.mk₀_neg,
        Abelian.Ext.neg_comp, e1, add_neg_cancel]
    obtain ⟨w, hw⟩ := (hc₂ _).1 e2
    have hw' : w ≫ p₂ m = g ≫ μZ (m + 1) -
        Limits.kernel.lift (J₂.d (m + 1) (m + 1 + 1)) y hy := hw
    refine ⟨g ≫ Limits.kernel.ι (J₁.d (m + 1) (m + 1 + 1)), ?_, w, ?_⟩
    · rw [Category.assoc, Limits.kernel.condition, Limits.comp_zero]
    · rw [← hp₂ m, ← Category.assoc, hw', Preadditive.sub_comp, Category.assoc, hμZ (m + 1),
        Limits.kernel.lift_ι, Category.assoc]
  have hinj : ∀ (n : ℕ) (x : P ⟶ J₁.X n), x ≫ J₁.d n (n + 1) = 0 → ∀ y : P ⟶ J₂.X (n - 1),
      x ≫ μ.f n = y ≫ J₂.d (n - 1) n → ∃ x' : P ⟶ J₁.X (n - 1), x' ≫ J₁.d (n - 1) n = x := by
    intro n
    rcases n with _ | m
    · intro x hx y hxy
      rw [J₂.shape (0 - 1) 0 (by decide), Limits.comp_zero] at hxy
      have h1 : Limits.kernel.lift (J₁.d 0 (0 + 1)) x hx ≫ μZ 0 = 0 := by
        rw [← cancel_mono (Limits.kernel.ι (J₂.d 0 (0 + 1))), Category.assoc, hμZ 0,
          ← Category.assoc, Limits.kernel.lift_ι, hxy, Limits.zero_comp]
      have h2 : Abelian.Ext.mk₀ (Limits.kernel.lift (J₁.d 0 (0 + 1)) x hx) = 0 := by
        apply (hΦ0 0).1
        show (Abelian.Ext.mk₀ (Limits.kernel.lift (J₁.d 0 (0 + 1)) x hx)).comp
          (Abelian.Ext.mk₀ (μZ 0)) (add_zero 0) =
          (0 : Abelian.Ext P (Limits.kernel (J₁.d 0 (0 + 1))) 0).comp
            (Abelian.Ext.mk₀ (μZ 0)) (add_zero 0)
        rw [Abelian.Ext.mk₀_comp_mk₀, h1, Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
      have h3 : Limits.kernel.lift (J₁.d 0 (0 + 1)) x hx = 0 :=
        (Abelian.Ext.mk₀_bijective P _).1 (h2.trans (Abelian.Ext.mk₀_zero _ _).symm)
      refine ⟨0, ?_⟩
      rw [Limits.zero_comp, ← Limits.kernel.lift_ι (J₁.d 0 (0 + 1)) x hx, h3, Limits.zero_comp]
    · intro x hx y hxy
      exact auxInj m x hx y hxy
  have hsurj : ∀ (n : ℕ) (y : P ⟶ J₂.X n), y ≫ J₂.d n (n + 1) = 0 → ∃ x : P ⟶ J₁.X n,
      x ≫ J₁.d n (n + 1) = 0 ∧ ∃ w : P ⟶ J₂.X (n - 1), w ≫ J₂.d (n - 1) n = x ≫ μ.f n - y := by
    intro n
    rcases n with _ | m
    · intro y hy
      obtain ⟨z, hz⟩ := (hΦ0 0).2 (Abelian.Ext.mk₀ (Limits.kernel.lift (J₂.d 0 (0 + 1)) y hy))
      obtain ⟨g, rfl⟩ := (Abelian.Ext.mk₀_bijective P _).2 z
      have hz' : (Abelian.Ext.mk₀ g).comp (Abelian.Ext.mk₀ (μZ 0)) (add_zero 0) =
          Abelian.Ext.mk₀ (Limits.kernel.lift (J₂.d 0 (0 + 1)) y hy) := hz
      rw [Abelian.Ext.mk₀_comp_mk₀] at hz'
      have hg := (Abelian.Ext.mk₀_bijective P _).1 hz'
      refine ⟨g ≫ Limits.kernel.ι (J₁.d 0 (0 + 1)), ?_, 0, ?_⟩
      · rw [Category.assoc, Limits.kernel.condition, Limits.comp_zero]
      · rw [Limits.zero_comp, Category.assoc, ← hμZ 0, ← Category.assoc, hg,
          Limits.kernel.lift_ι, sub_self]
    · intro y hy
      exact auxSurj m y hy

  refine s1 _ (fun n x hx y hxy => ?_) (fun n y hy => ?_)
  · obtain ⟨x', hx'⟩ := hinj n x hx y hxy
    exact ⟨x', hx'⟩
  · obtain ⟨x, hx, w, hw⟩ := hsurj n y hy
    exact ⟨x, hx, w, hw⟩

theorem wc_h2rc_ext_bij_of_offS (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (A B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) (lam : A ⟶ B)
    (hA : wcZeroAtS K m S A) (hB : wcZeroAtS K m S B)
    (hlam : ∀ (T : (wcP1Over K).left.ProEt),
      (∀ (t : T.left) (i : Fin m), T.hom t ≠ S i (IsLocalRing.closedPoint K)) →
      (∀ s : (Limits.kernel lam).obj.obj (Opposite.op T), s = 0) ∧
      (∀ s : (Limits.cokernel lam).obj.obj (Opposite.op T), s = 0)) :
    ∀ q : ℕ, Function.Bijective
      (fun x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) A q =>
        x.comp (Abelian.Ext.mk₀ lam) (add_zero q)) :=
by
  intro q

  have hzK : wcZeroAtS K m S (Limits.kernel lam) := by
    intro i V R _ _ _ e hv y
    obtain ⟨f, rfl⟩ : ∃ f, Abelian.Ext.mk₀ f = y := ⟨_, Abelian.Ext.mk₀_addEquiv₀_apply y⟩
    have h0 : f ≫ Limits.kernel.ι lam = 0 := by
      apply (Abelian.Ext.mk₀_bijective _ _).1
      rw [Abelian.Ext.mk₀_zero]
      exact hA i V R e hv _
    have h1 : f = 0 := by
      rw [← cancel_mono (Limits.kernel.ι lam), h0, Limits.zero_comp]
    rw [h1, Abelian.Ext.mk₀_zero]
  have hzC : wcZeroAtS K m S (Limits.cokernel lam) := by
    intro i V R _ _ _ e hv y
    haveI := wc_proet_free_projective_strict_local (wcP1Over K).left V R e
    obtain ⟨f, rfl⟩ : ∃ f, Abelian.Ext.mk₀ f = y := ⟨_, Abelian.Ext.mk₀_addEquiv₀_apply y⟩
    have ht := Projective.factorThru_comp f (Limits.cokernel.π lam)
    have h1 : Projective.factorThru f (Limits.cokernel.π lam) = 0 := by
      apply (Abelian.Ext.mk₀_bijective _ _).1
      rw [Abelian.Ext.mk₀_zero]
      exact hB i V R e hv _
    rw [← ht, h1, Limits.zero_comp, Abelian.Ext.mk₀_zero]

  have huniq : ∀ (i : Fin m) (p p' : (wcGeomPoint K (wcP1Over K) hP).left),
      (wcGeomPoint K (wcP1Over K) hP).hom p = S i (IsLocalRing.closedPoint K) →
      (wcGeomPoint K (wcP1Over K) hP).hom p' = S i (IsLocalRing.closedPoint K) →
      p = p' := by
    intro i p p' hp hp'
    obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      (g := S i) p (IsLocalRing.closedPoint K) hp
    obtain ⟨z', hz1', -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      (g := S i) p' (IsLocalRing.closedPoint K) hp'
    haveI : IsIso (S i ≫ (wcP1Over K).hom) := by rw [hS i]; infer_instance
    let e := Limits.pullbackSymmetry (Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (S i) ≪≫
      Limits.pullbackRightPullbackFstIso (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) (S i) ≪≫
      asIso (Limits.pullback.snd (S i ≫ (wcP1Over K).hom)
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
    have hsub : Subsingleton (Spec (.of (AlgebraicClosure K))) := by
      show Subsingleton (PrimeSpectrum (AlgebraicClosure K))
      infer_instance
    have hzz : z = z' := e.hom.isOpenEmbedding.injective (Subsingleton.elim _ _)
    rw [← hz1, ← hz1', hzz]
  obtain ⟨ev, -, -⟩ := wc_free_ext0_eval (wcP1Over K).left

  have hdeg0 : ∀ (Q : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}),
      wcZeroAtS K m S Q →
      (∀ (T : (wcP1Over K).left.ProEt),
        (∀ (t : T.left) (i : Fin m), T.hom t ≠ S i (IsLocalRing.closedPoint K)) →
        ∀ s : Q.obj.obj (Opposite.op T), s = 0) →
      ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) Q 0,
        x = 0 := by
    intro Q hQ hoff x
    refine wc_P1_geom_section_zero_of_local K hP Q m S hS huniq x ?_ ?_
    · intro V g hV
      apply (ev V Q).injective
      rw [map_zero]
      exact hoff V hV _
    · intro i
      obtain ⟨V₀, g₀, -, R, _, _, _, e, -, hv, -⟩ := wc_P1bar_strict_local_nbhd K (S i) (hS i) hP
      exact ⟨V₀, g₀, e.inv (IsLocalRing.closedPoint R), hv, hQ i V₀ R e hv _⟩

  have hall : ∀ (Q : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}),
      wcZeroAtS K m S Q →
      (∀ (T : (wcP1Over K).left.ProEt),
        (∀ (t : T.left) (i : Fin m), T.hom t ≠ S i (IsLocalRing.closedPoint K)) →
        ∀ s : Q.obj.obj (Opposite.op T), s = 0) →
      ∀ n : ℕ, Subsingleton
        (Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) Q n) := by
    intro Q hQ hoff n
    have h : ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left
        (wcGeomPoint K (wcP1Over K) hP)) Q n, x = 0 := by
      rcases n with _ | k
      · exact hdeg0 Q hQ hoff
      · exact wc_proet_P1_finite_supp_ext_vanish K hP m S hS Q hoff (k + 1) (Nat.succ_pos k)
    exact ⟨fun a b => (h a).trans (h b).symm⟩
  exact wc_ext_postcomp_bij_of_ker_coker_acyclic _ A B lam
    (hall _ hzK (fun T hT => (hlam T hT).1)) (hall _ hzC (fun T hT => (hlam T hT).2)) q

theorem wc_h2rc_twsheaf_strict_zero {X V : Scheme.{u}} (q : V ⟶ X) (Z : Set X) (Γ : Type u)
    [Group Γ] (α : Γ →* Aut V) (hα : ∀ g, (α g).hom ≫ q = q) (ℓ n r : ℕ)
    (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (T : X.ProEt)
    (R : Type u) [CommRing R] [HenselianLocalRing R] [IsSepClosed (IsLocalRing.ResidueField R)]
    (e : T.left ≅ Spec (.of R)) (hT : T.hom (e.inv (IsLocalRing.closedPoint R)) ∈ Z) :
    ∀ y : Abelian.Ext (wcFreeSheaf X T) (wcH2TwSheaf q Z Γ α hα ℓ n r ρ) 0, y = 0 :=
by
  classical

  have hid : ∀ (S : Scheme.{u}) (V : S.ProEt), Nonempty (V.left ≅ Spec (.of R)) →
      ∀ T : Sieve V, T ∈ Scheme.ProEt.topology S V → T.arrows (𝟙 V) := by
    intro S
    have s6 : ∀ (R E : Type u) [CommRing R] [CommRing E] [Algebra R E],
        WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R E))) →
          Algebra.WeaklyEtale R E := by
      intro R E _ _ _ hW
      have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R E))) := hW.flat
      have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R E)))) :=
        hW.flat_diagonal
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff] at hf
      rw [diagonal_SpecMap] at hd
      have hd' : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' R (S := E)).toRingHom)) := by
        have heq : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) =
            (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) ≫
              (pullbackSpecIso R E E).inv) ≫ (pullbackSpecIso R E E).hom := by
          rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
        rw [heq]
        infer_instance
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hd'
      exact ⟨hf, hd'⟩
    have s7 : ∀ (E : Type u) [CommRing E] [Algebra R E],
        Algebra.WeaklyEtale R E → ∀ (p : Ideal E) [p.IsPrime],
        p.comap (algebraMap R E) = IsLocalRing.maximalIdeal R → Nonempty (E →ₐ[R] R) := by
      intro E _ _ hAE p _ hp
      haveI : Algebra.WeaklyEtale E (Localization.AtPrime p) :=
        wc_localization_weaklyEtale E (Localization.AtPrime p) p.primeCompl
      haveI := hAE
      haveI : Algebra.WeaklyEtale R (Localization.AtPrime p) := Algebra.WeaklyEtale.trans R E _
      have hloc : IsLocalHom (algebraMap R (Localization.AtPrime p)) := by
        have h1 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
            (algebraMap R (Localization.AtPrime p)) = IsLocalRing.maximalIdeal R := by
          rw [IsScalarTower.algebraMap_eq R E (Localization.AtPrime p), ← Ideal.comap_comap]
          have h2 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
              (algebraMap E (Localization.AtPrime p)) = p :=
            Localization.AtPrime.under_maximalIdeal
          rw [h2, hp]
        exact ((IsLocalRing.local_hom_TFAE (algebraMap R (Localization.AtPrime p))).out 1 5).mpr h1
      have hbij := wc_olivier R (Localization.AtPrime p) inferInstance inferInstance hloc
        inferInstance
      let eqv : R ≃ₐ[R] Localization.AtPrime p := AlgEquiv.ofBijective (Algebra.ofId R _) hbij
      exact ⟨eqv.symm.toAlgHom.comp (IsScalarTower.toAlgHom R E (Localization.AtPrime p))⟩
    have s5 : ∀ {U V : Scheme.{u}} (e : U ≅ Spec (.of R)) (g : V ⟶ U) [WeaklyEtale g] (v : V),
        e.hom (g v) = IsLocalRing.closedPoint R → ∃ σ : U ⟶ V, σ ≫ g = 𝟙 U := by
      intro U V e g _ v hv
      obtain ⟨E, ι, hι, hvι, -⟩ :=
        Scheme.exists_affine_mem_range_and_range_subset (U := (⊤ : V.Opens)) (x := v) trivial
      obtain ⟨w, hw⟩ := hvι
      have := hι
      let h : Spec E ⟶ Spec (.of R) := ι ≫ g ≫ e.hom
      have hWh : WeaklyEtale h := inferInstance
      let φ : CommRingCat.of R ⟶ E := Spec.preimage h
      have hφ : Spec.map φ = h := Spec.map_preimage h
      letI : Algebra R E := (CommRingCat.Hom.hom φ).toAlgebra
      have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R E))) := by
        change WeaklyEtale (Spec.map φ)
        rw [hφ]
        exact hWh
      have hAE : Algebra.WeaklyEtale R E := s6 R E hW'
      let p : PrimeSpectrum E := w
      have hq : (p.asIdeal).comap (algebraMap R E) = IsLocalRing.maximalIdeal R := by
        have h1 : (Spec.map φ) w = IsLocalRing.closedPoint R := by
          rw [hφ]
          show e.hom (g (ι w)) = _
          rw [hw, hv]
        exact congrArg PrimeSpectrum.asIdeal h1
      obtain ⟨τ⟩ := s7 E hAE p.asIdeal hq
      let τ' : E ⟶ CommRingCat.of R := CommRingCat.ofHom (τ : E →+* R)
      have hret : φ ≫ τ' = 𝟙 _ := by
        ext x
        exact τ.commutes x
      refine ⟨e.hom ≫ Spec.map τ' ≫ ι, ?_⟩
      rw [← cancel_mono e.hom]
      simp only [Category.assoc, Category.id_comp]
      have h3 : ι ≫ g ≫ e.hom = Spec.map φ := hφ.symm
      rw [h3, ← Spec.map_comp, hret, Spec.map_id, Category.comp_id]
    have s4 : ∀ (U : S.ProEt) (Rr : Presieve U), Rr ∈ (Scheme.ProEt.precoverage S).coverings U →
        ∀ (W : S.ProEt) (a : W ⟶ U), Nonempty (W.left ≅ Spec (.of R)) →
        ∃ (Y : S.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), Rr g ∧ h ≫ g = a := by
      intro U Rr hR W a ⟨eW⟩
      have hR' : Presieve.map (Scheme.ProEt.forget S ⋙ Over.forget S) Rr ∈
          (Scheme.precoverage @WeaklyEtale).coverings U.left := hR.2
      obtain ⟨Y', g', hg', y', hy'⟩ :=
        (Scheme.instJointlySurjectivePrecoverage (P := @WeaklyEtale)).exists_eq _ hR'
          (a.left (eW.inv (IsLocalRing.closedPoint R)))
      obtain ⟨Y, hY, g, hg, hgg⟩ := Presieve.map_iff.mp hg'
      subst hY
      have hgl : g.left = g' := hgg.trans (by simp only [eqToHom_refl]; exact Category.id_comp _)
      haveI : WeaklyEtale U.hom := U.prop
      haveI : WeaklyEtale (g.left ≫ U.hom) := by
        rw [MorphismProperty.Over.w g]; exact Y.prop
      haveI : WeaklyEtale g.left := WeaklyEtale.of_comp g.left U.hom
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := a.left) (g := g.left)
        (eW.inv (IsLocalRing.closedPoint R)) y' (by rw [hgl]; exact hy'.symm)
      obtain ⟨σ, hσ⟩ := s5 eW (Limits.pullback.fst a.left g.left) z (by
        rw [hz1]
        change (eW.inv ≫ eW.hom) (IsLocalRing.closedPoint R) = _
        rw [Iso.inv_hom_id]
        rfl)
      have hh₀ : (σ ≫ Limits.pullback.snd a.left g.left) ≫ g.left = a.left := by
        rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hσ, Category.id_comp]
      refine ⟨Y, g, MorphismProperty.Over.homMk (σ ≫ Limits.pullback.snd a.left g.left) ?_ trivial,
        hg, ?_⟩
      · rw [← MorphismProperty.Over.w g, ← Category.assoc, hh₀, MorphismProperty.Over.w a]
      · apply MorphismProperty.Over.Hom.ext
        exact hh₀
    have s3 : ∀ (P : S.ProEt → Prop),
        (∀ (U : S.ProEt) (Rr : Presieve U), Rr ∈ (Scheme.ProEt.precoverage S).coverings U →
          ∀ (W : S.ProEt) (a : W ⟶ U), P W →
            ∃ (Y : S.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), Rr g ∧ h ≫ g = a) →
        ∀ (U : S.ProEt) (T : Sieve U), T ∈ Scheme.ProEt.topology S U →
          ∀ (W : S.ProEt) (a : W ⟶ U), P W → T.arrows a := by
      intro P hK
      let JP : GrothendieckTopology S.ProEt :=
        GrothendieckTopology.mk
          (fun U => {T : Sieve U | ∀ (W : S.ProEt) (a : W ⟶ U), P W → T.arrows a})
          (by
            intro U W a _
            trivial)
          (by
            intro U Y T f hT W a hW
            rw [Sieve.pullback_apply]
            exact hT W (a ≫ f) hW)
          (by
            intro U T hT Rs hR W a hW
            have h1 := hR (hT W a hW) W (𝟙 W) hW
            rw [Sieve.pullback_apply, Category.id_comp] at h1
            exact h1)
      have hle : Scheme.ProEt.topology S ≤ JP := by
        rw [Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
        intro U Rr hR
        show ∀ (W : S.ProEt) (a : W ⟶ U), P W → (Sieve.generate Rr).arrows a
        intro W a hW
        obtain ⟨Y, g, h, hg, hhg⟩ := hK U Rr hR W a hW
        exact ⟨Y, h, g, hg, hhg⟩
      intro U T hT W a hW
      have h1 : T ∈ JP U := GrothendieckTopology.le_def.mp hle U hT
      exact h1 W a hW
    intro V hV T hT
    exact s3 (fun W => Nonempty (W.left ≅ Spec (.of R))) s4 V T hT V (𝟙 V) hV
  have hT1 := hid X T ⟨e⟩

  have hsurj : ∀ P : (X.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1},
      Function.Surjective
        ((toSheafify (Scheme.ProEt.topology X) P).app (Opposite.op T)).hom := by
    intro P s
    have h1 := Presheaf.imageSieve_mem (Scheme.ProEt.topology X)
      (toSheafify (Scheme.ProEt.topology X) P) (U := Opposite.op T) s
    have h2 := hT1 _ h1
    rw [Presheaf.imageSieve_apply] at h2
    obtain ⟨t, ht⟩ := h2
    exact ⟨t, ht.trans (by simp)⟩

  let EqF := wcH2EqPre (wcH2TwBase q ℓ n r)
    (fun g : Γ => Functor.whiskerRight (NatTrans.op (wcPbAct q (α g).hom (hα g)))
      (continuousMapPresheafAb.{0, u} (Fin r → ZMod (ℓ ^ n)) ⋙
        AddCommGrpCat.uliftFunctor.{u+1, u}))
    (fun g : Γ => wcH2TwMat q ℓ n r
      (((ρ g)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))))
  let PF := wcExtZeroPre EqF
    (fun T : X.ProEt => ∀ t, T.hom t ∉ Z)
    (fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _)
  have hTw : wcH2TwSheaf q Z Γ α hα ℓ n r ρ =
      (presheafToSheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).obj PF := rfl

  have hF0 : ∀ s : (wcH2TwSheaf q Z Γ α hα ℓ n r ρ).obj.obj (Opposite.op T), s = 0 := by
    rw [hTw]
    intro s
    obtain ⟨⟨x1, hx1⟩, hxs⟩ := (hsurj PF) s
    subst hxs
    have hn : ¬ (∀ t, T.hom t ∉ Z) :=
      fun h => h (e.inv (IsLocalRing.closedPoint R)) hT
    have hmem : x1 ∈ (⨆ _ : (∀ t, T.hom t ∉ Z),
        (⊤ : AddSubgroup (EqF.obj (Opposite.op T)))) := hx1
    rw [iSup_neg hn, AddSubgroup.mem_bot] at hmem
    subst hmem
    exact map_zero _

  intro y
  obtain ⟨f, rfl⟩ := (Abelian.Ext.mk₀_bijective (wcFreeSheaf X T)
    (wcH2TwSheaf q Z Γ α hα ℓ n r ρ)).2 y
  obtain ⟨ev, -, hev0⟩ := proet_free_sheaf_hom_equiv X T
  have hf : f = 0 := by
    apply (ev (wcH2TwSheaf q Z Γ α hα ℓ n r ρ)).injective
    rw [hev0]
    exact hF0 _
  subst hf
  exact Abelian.Ext.mk₀_zero _ _

theorem wc_h2r_H1_congruence (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP) (k : ℕ)
    (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (Pm : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])) (J : Subobject G)
    (hF : wcH2Frame K hP ℓ m S G σ W w k θ Pm J)
    (e : ℕ) (he : 1 ≤ e)
    (r : ℕ) (V : ℕ → Scheme.{u}) (q' : (n : ℕ) → V n ⟶ Uo.toScheme) (Γ : ℕ → Type u)
    [∀ n, Group (Γ n)] (α : (n : ℕ) → Γ n →* Aut (V n))
    (ρ : (n : ℕ) → Γ n →* GL (Fin r) (ZMod (ℓ ^ n)))
    (hCOV : ∀ n, 1 ≤ n → wcGalCover (q' n) (Γ n) (α n))
    (hLk : wcH2LinkR K ℓ m S G J Uo r V q' Γ α ρ)
    (M : wcGModel ℓ PUnit.{u+1}) (Ψ : wcGModelAb M ⟶ wcCx K hP (Subobject.underlying.obj J))
    (hΨ : QuasiIso Ψ)
    (hΨF : Nonempty (Homotopy (Ψ ≫ wcCxFrob K hP (Subobject.underlying.obj J))
      (wcGModelFrob M ≫ Ψ))) :
    ∀ n, 1 ≤ n → ∀ (hα : ∀ γ, (α n γ).hom ≫ q' n ≫ Uo.ι = q' n ≫ Uo.ι) [Fintype (Γ n)]
      (P : wcGModel ℓ (Γ n)),
      wcIsModel K hP (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (q' n ≫ Uo.ι)
        (Γ n) (α n) hα P →
      PadicInt.toZModPow n (wcGModelHS M e PUnit.unit) =
        ∑ g : Γ n, PadicInt.toZModPow n (wcGModelHS P e g) *
          ((ρ n g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))).trace :=
by
  classical
  intro n hn hα _ P hPM
  obtain ⟨hα', hlink⟩ := hLk
  obtain ⟨mu, hmu⟩ := hlink n hn

  have hT := wc_h2_twsheaf_torsion (q' n ≫ Uo.ι)
    (Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Γ n) (α n) hα ℓ n r (ρ n)
  have hpos : 1 ≤ ℓ ^ n := Nat.one_le_pow _ _ (Nat.Prime.pos Fact.out)
  obtain ⟨J₁, η₁, h₁⟩ := wc_h2_tors_res_exists K hP (ℓ ^ n) hpos _ hT

  obtain ⟨M₁, ⟨Ψ₁, hΨ₁, hΨ₁F⟩, J₂, η₂, h₂, Q', hQ', Ψ₂, hΨ₂, hΨ₂F⟩ :=
    wc_h2rc_lattice_reduction K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero W w k θ Pm J hF n hn

  have hzT : wcZeroAtS K m S (wcH2TwSheaf (q' n ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) (Γ n) (α n) hα ℓ n r (ρ n)) := by
    intro i V A _ _ _ e hv
    exact wc_h2rc_twsheaf_strict_zero (q' n ≫ Uo.ι) _ (Γ n) (α n) hα ℓ n r (ρ n) V A e ⟨i, hv.symm⟩

  have hzL : wcZeroAtS K m S (Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J))) := by
    intro i V A _ _ _ e hv y
    haveI := wc_proet_free_projective_strict_local (wcP1Over K).left V A e
    obtain ⟨f, rfl⟩ : ∃ f, Abelian.Ext.mk₀ f = y := ⟨_, Abelian.Ext.mk₀_addEquiv₀_apply y⟩
    have ht := Projective.factorThru_comp f
      (Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J)))
    have h0 : Projective.factorThru f
        (Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J))) ≫ J.arrow = 0 := by
      apply (Abelian.Ext.mk₀_bijective _ _).1
      rw [Abelian.Ext.mk₀_zero]
      exact hzero i V A e hv _
    have h1 : Projective.factorThru f
        (Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J))) = 0 := by
      rw [← cancel_mono J.arrow, h0, Limits.zero_comp]
    rw [← ht, h1, Limits.zero_comp, Abelian.Ext.mk₀_zero]

  have hbij := wc_h2rc_ext_bij_of_offS K hP m S hS _ _ mu hzT hzL hmu

  obtain ⟨R1₁, R2₁, ⟨w₁, ex₁⟩, R4₁, -, -⟩ := id h₁
  obtain ⟨-, -, ⟨w₂, -⟩, -, R5₂, -⟩ := id h₂
  obtain ⟨ν0, hν0⟩ := R5₂ 0 _ _ η₁ R2₁ (R1₁ 0) (mu ≫ η₂)
  haveI hmm0 : Mono (Limits.cokernel.desc η₁ (J₁.d 0 1) w₁) := ex₁.mono_cokernelDesc
  have hφ0 : η₁ ≫ ν0 ≫ J₂.d 0 1 = 0 := by
    rw [← Category.assoc, hν0, Category.assoc, w₂, Limits.comp_zero]
  obtain ⟨ν1, hν1⟩ := R5₂ 1 _ _ (Limits.cokernel.desc η₁ (J₁.d 0 1) w₁) hmm0 (R1₁ 1)
    (Limits.cokernel.desc η₁ (ν0 ≫ J₂.d 0 1) hφ0)
  have hsq1 : J₁.d 0 1 ≫ ν1 = ν0 ≫ J₂.d 0 1 := by
    have := congrArg (fun t => Limits.cokernel.π η₁ ≫ t) hν1
    simpa only [Limits.cokernel.π_desc_assoc, Limits.cokernel.π_desc] using this
  have hstep : ∀ (i : ℕ) (f : J₁.X i ⟶ J₂.X i) (f' : J₁.X (i + 1) ⟶ J₂.X (i + 1)),
      f ≫ J₂.d i (i + 1) = J₁.d i (i + 1) ≫ f' →
      ∃ f'' : J₁.X (i + 2) ⟶ J₂.X (i + 2),
        f' ≫ J₂.d (i + 1) (i + 2) = J₁.d (i + 1) (i + 2) ≫ f'' := by
    intro i f f' hff
    have hS' : (J₁.sc' i (i + 1) (i + 2)).Exact :=
      (J₁.exactAt_iff' i (i + 1) (i + 2) (CochainComplex.prev_nat_succ i)
        (CochainComplex.next ℕ (i + 1))).1 (R4₁ i)
    have hw : J₁.d i (i + 1) ≫ J₁.d (i + 1) (i + 2) = 0 := J₁.d_comp_d _ _ _
    haveI : Mono (Limits.cokernel.desc (J₁.d i (i + 1)) (J₁.d (i + 1) (i + 2)) hw) :=
      hS'.mono_cokernelDesc
    have hφ : J₁.d i (i + 1) ≫ f' ≫ J₂.d (i + 1) (i + 2) = 0 := by
      rw [← Category.assoc, ← hff, Category.assoc, J₂.d_comp_d, Limits.comp_zero]
    obtain ⟨f'', hf''⟩ := R5₂ (i + 2) _ _
      (Limits.cokernel.desc (J₁.d i (i + 1)) (J₁.d (i + 1) (i + 2)) hw) inferInstance
      (R1₁ (i + 2)) (Limits.cokernel.desc _ _ hφ)
    refine ⟨f'', ?_⟩
    have := congrArg (fun t => Limits.cokernel.π (J₁.d i (i + 1)) ≫ t) hf''
    simp only [Limits.cokernel.π_desc_assoc, Limits.cokernel.π_desc] at this
    exact this.symm
  obtain ⟨ν, hνη⟩ : ∃ ν : J₁ ⟶ J₂, η₁ ≫ ν.f 0 = mu ≫ η₂ :=
    ⟨CochainComplex.mkHom J₁ J₂ ν0 ν1 hsq1.symm
      (fun i p => ⟨(hstep i p.1 p.2.1 p.2.2).choose, (hstep i p.1 p.2.1 p.2.2).choose_spec⟩),
      by rw [CochainComplex.mkHom_f_0]; exact hν0⟩

  have hν := wc_h2rc_res_map_quasiIso (wcP1Over K).left
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) _ _ J₁ J₂ η₁ η₂ mu ν hνη
    h₁.2.1 h₂.2.1 h₁.2.2.1 h₂.2.2.1 h₁.2.2.2.1 h₂.2.2.2.1 h₁.2.2.2.2.2 h₂.2.2.2.2.2 hbij

  have hTor : ∀ (J' : CochainComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left)
      AddCommGrpCat.{u+1}) ℕ), (∀ i, ((ℓ ^ n : ℕ) : ℤ) • 𝟙 (J'.X i) = 0) →
      ∀ i (x : (wcCxJ K hP J').X i), (ℓ ^ n) • x = 0 := by
    intro J' h1' i x
    let y : wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) ⟶ J'.X i := x
    have h2 : (ℓ ^ n) • y = 0 := by
      have h3 : (ℓ ^ n) • y = y ≫ ((ℓ ^ n : ℕ) • 𝟙 (J'.X i)) := by
        rw [Preadditive.comp_nsmul, Category.comp_id]
      rw [h3, ← natCast_zsmul, h1' i, Limits.comp_zero]
    exact h2
  have hB := hTor J₁ h₁.1
  have hW := hTor J₂ h₂.1

  have key : ∀ (Eν : wcCxJ K hP J₁ ⟶ wcCxJ K hP J₂), QuasiIso Eν →
      Eν ≫ wcCxJFrob K hP J₂ = wcCxJFrob K hP J₁ ≫ Eν →
      ∃ χ : wcLnModelAb.{u+1} Q' ⟶ wcCxJ K hP J₁, QuasiIso χ ∧
        Nonempty (Homotopy (χ ≫ wcCxJFrob K hP J₁) (wcLnModelFrob Q' ≫ χ)) := by
    intro Eν hEν hEνF
    obtain ⟨hCE0, hCES, hINJ0⟩ := wcU_ab_quasiIso_cone_exact _ _ Eν hEν
    obtain ⟨χ, ⟨hχ⟩⟩ := wcU_lnmodel_lift_htpy (ℓ ^ n) Q' _ _ hB hW Eν hCE0 hCES Ψ₂
    refine ⟨χ, ?_, ?_⟩
    · haveI := hEν
      haveI : QuasiIso (χ ≫ Eν) := by
        rw [quasiIso_iff]
        intro i
        rw [quasiIsoAt_iff_isIso_homologyMap, Homotopy.homologyMap_eq hχ i]
        exact (quasiIsoAt_iff_isIso_homologyMap Ψ₂ i).1 ((quasiIso_iff Ψ₂).1 hΨ₂ i)
      exact quasiIso_of_comp_right χ Eν
    · obtain ⟨H2⟩ := hΨ₂F
      have H : Homotopy ((χ ≫ wcCxJFrob K hP J₁) ≫ Eν) ((wcLnModelFrob Q' ≫ χ) ≫ Eν) :=
        ((((Homotopy.ofEq (by simp only [Category.assoc, hEνF])).trans
          (hχ.compRight (wcCxJFrob K hP J₂))).trans H2).trans
          (hχ.symm.compLeft (wcLnModelFrob Q'))).trans (Homotopy.ofEq (Category.assoc _ _ _).symm)
      exact wcU_lnmodel_htpy_cancel (ℓ ^ n) Q' _ _ hB hW Eν hCE0 hCES hINJ0 _ _ H
  obtain ⟨χ, hχ, hχF⟩ := key _ hν
    (CategoryTheory.NatTrans.mapHomologicalComplex_naturality
      (preadditiveCoyoneda.map
        (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)).op) ν)

  have h1 := wc_h2_twist_trace_formula K hP ℓ hℓ m S hS Uo hUo (q' n) (Γ n) (α n) (hCOV n hn)
    hα n hn r (ρ n) P hPM J₁ η₁ h₁ Q' χ hχ hχF e he
  have h2 := wcU_twist_model_trace ℓ n (1 : PUnit.{u+1} →* GL (Fin 1) (ZMod (ℓ ^ n))) M₁ Q' hQ' e
  have h3 := wc_h2_punit_model_HS_eq K hP ℓ _ M M₁ Ψ Ψ₁ hΨ hΨ₁ hΨF hΨ₁F e he
  rw [← h1, h2, Fintype.sum_unique, h3]
  simp

theorem wc_lisse_tower_exists_h2 (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G) (hlisse : wcLisseOffS K hP ℓ m S G σ)
    (h0 : ∀ y : wcCohG K (wcP1Over K) hP G 0, y = 0)
    (r₁ : ℕ) (e₁ : wcCohG K (wcP1Over K) hP G 1 ≃+ (Fin r₁ → ℚ_[ℓ]))
    (he₁ : ∀ (c : ℚ_[ℓ]) (y : wcCohG K (wcP1Over K) hP G 1),
      e₁ (wcCohGEnd K (wcP1Over K) hP G 1 (σ c) y) = c • e₁ y)
    (r₂ : ℕ) (e₂ : wcCohG K (wcP1Over K) hP G 2 ≃+ (Fin r₂ → ℚ_[ℓ]))
    (he₂ : ∀ (c : ℚ_[ℓ]) (y : wcCohG K (wcP1Over K) hP G 2),
      e₂ (wcCohGEnd K (wcP1Over K) hP G 2 (σ c) y) = c • e₂ y)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    (e : ℕ) (he : 1 ≤ e) :
    ∃ (r : ℕ) (V : ℕ → Scheme.{u}) (q' : (n : ℕ) → V n ⟶ Uo.toScheme) (Γ : ℕ → Type u)
      (_ : ∀ n, Group (Γ n)) (α : (n : ℕ) → Γ n →* Aut (V n))
      (ρ : (n : ℕ) → Γ n →* GL (Fin r) (ZMod (ℓ ^ n))) (t : ℤ_[ℓ]),
      (∀ n, 1 ≤ n → wcGalCover (q' n) (Γ n) (α n)) ∧
      ((t : ℚ_[ℓ]) = ((wcAddEquivMatrix e₂ (wcCohGFrob K (wcP1Over K) hP G 2)) ^ e).trace -
        ((wcAddEquivMatrix e₁ (wcCohGFrob K (wcP1Over K) hP G 1)) ^ e).trace) ∧
      (∀ n, 1 ≤ n → ∀ (hα : ∀ γ, (α n γ).hom ≫ q' n ≫ Uo.ι = q' n ≫ Uo.ι) [Fintype (Γ n)]
        (P : wcGModel ℓ (Γ n)),
        wcIsModel K hP (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (q' n ≫ Uo.ι)
          (Γ n) (α n) hα P →
        PadicInt.toZModPow n t =
          ∑ g : Γ n, PadicInt.toZModPow n (wcGModelHS P e g) *
            ((ρ n g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))).trace) ∧
      (∀ d : ℕ, ∀ x ∈ wcOffS K m S d, ∀ b : wcStalkBasis K ℓ G σ x d, ∀ k : ℕ,
        ∃ T : ℤ_[ℓ], (T : ℚ_[ℓ]) = (wcStalkMat b ^ k).trace) ∧
      (∀ n, 1 ≤ n → ∀ d ∈ e.divisors, ∀ x ∈ wcOffS K m S d, ∀ b : wcStalkBasis K ℓ G σ x d,
        ∀ (v : Spec (.of (AlgebraicClosure K)) ⟶ V n) (g : Γ n),
          v ≫ q' n ≫ Uo.ι ≫ (wcP1Over K).hom = wcKbarPt K →
          (v ≫ q' n ≫ Uo.ι) (IsLocalRing.closedPoint (AlgebraicClosure K)) = x →
          wcFrE K e ≫ v ≫ (α n g).hom = v →
          ∀ T : ℤ_[ℓ], (T : ℚ_[ℓ]) = (wcStalkMat b ^ (e / d)).trace →
            PadicInt.toZModPow n T = ((ρ n g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))).trace) :=
by
  obtain ⟨W, w, k, hqc, hconn, hoff, hsurj, θ, hθ⟩ := hlisse
  obtain ⟨Pm, hint⟩ := wc_qclift_transition_lattice K hP m S ℓ G W w hqc hconn hsurj k θ
  obtain ⟨J, hJ⟩ := wc_qclift_integral_subsheaf (wcP1Over K).left G W k ℓ θ Pm
  have hF : wcH2Frame K hP ℓ m S G σ W w k θ Pm J :=
    ⟨hqc, hconn, hoff, hsurj, hθ, hint, hJ⟩
  obtain ⟨r, V, q', Γ, hgrp, α, ρ, hCOV, hLk⟩ :=
    wc_h2r_tower_construct K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero Uo hUo W w k θ Pm J hF
  obtain ⟨M, Ψ, hΨ, hΨF⟩ :=
    wc_h2_integral_model K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero W w k θ Pm J hF
  obtain ⟨hINT, hST⟩ :=
    wc_h2r_stalk_traces K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero Uo hUo W w k θ Pm J hF
      e he r V q' Γ α ρ hCOV hLk
  exact ⟨r, V, q', Γ, hgrp, α, ρ, wcGModelHS M e PUnit.unit, hCOV,
    wc_h2_model_trace K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero W w k θ Pm J hF h0
      r₁ e₁ he₁ r₂ e₂ he₂ e he M Ψ hΨ hΨF,
    wc_h2r_H1_congruence K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero Uo hUo W w k θ Pm J hF
      e he r V q' Γ α ρ hCOV hLk M Ψ hΨ hΨF,
    hINT, hST⟩

theorem wc_P1_jshriek_trace_formula_h2 (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G) (hlisse : wcLisseOffS K hP ℓ m S G σ)
    (h0 : ∀ y : wcCohG K (wcP1Over K) hP G 0, y = 0)
    (r₁ : ℕ) (e₁ : wcCohG K (wcP1Over K) hP G 1 ≃+ (Fin r₁ → ℚ_[ℓ]))
    (he₁ : ∀ (c : ℚ_[ℓ]) (y : wcCohG K (wcP1Over K) hP G 1),
      e₁ (wcCohGEnd K (wcP1Over K) hP G 1 (σ c) y) = c • e₁ y)
    (r₂ : ℕ) (e₂ : wcCohG K (wcP1Over K) hP G 2 ≃+ (Fin r₂ → ℚ_[ℓ]))
    (he₂ : ∀ (c : ℚ_[ℓ]) (y : wcCohG K (wcP1Over K) hP G 2),
      e₂ (wcCohGEnd K (wcP1Over K) hP G 2 (σ c) y) = c • e₂ y)
    (np : ℕ → ℕ) (pt : (d : ℕ) → Fin (np d) → (wcP1Over K).left)
    (hnp : ∀ d, np d = Nat.card (wcOffS K m S d))
    (hpt : ∀ d i, pt d i ∈ wcOffS K m S d) (hinj : ∀ d, Function.Injective (pt d)) :
    ∀ e : ℕ, 1 ≤ e →
      ∑ d ∈ e.divisors, ∑ i : Fin (np d),
          (d : AlgebraicClosure ℚ_[ℓ]) * ((wcStalkLoc K ℓ G σ (pt d i) d).map (· ^ (e / d))).sum =
        (((wcAddEquivMatrix e₂ (wcCohGFrob K (wcP1Over K) hP G 2)).charpoly.aroots
            (AlgebraicClosure ℚ_[ℓ])).map (· ^ e)).sum -
        (((wcAddEquivMatrix e₁ (wcCohGFrob K (wcP1Over K) hP G 1)).charpoly.aroots
            (AlgebraicClosure ℚ_[ℓ])).map (· ^ e)).sum :=
by
  classical
  intro e he
  obtain ⟨Uo, hUo⟩ := wc_P1_offS_open K m S hS
  obtain ⟨r, V, q', Γ, hgrp, α, ρ, t, hCOV, ht, hH1, hINT, hST⟩ :=
    wc_lisse_tower_exists_h2 K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero hlisse h0 r₁ e₁ he₁
      r₂ e₂ he₂ Uo hUo e he
  have SB := wc_stalk_basis_exists K hP ℓ m S G σ hlisse
  obtain ⟨hfin, hdiv, hsum⟩ := wc_offS_fixed_points_regroup K m S hS np pt hnp hpt hinj e he

  have hdu : ∀ (x : (wcP1Over K).left) (d d' : ℕ), x ∈ wcOffS K m S d →
      x ∈ wcOffS K m S d' → d = d' := fun x d d' h h' => h.2.1.2.symm.trans h'.2.1.2
  let Tof : (wcP1Over K).left → ℤ_[ℓ] := fun x =>
    if h : ∃ d, d ∈ e.divisors ∧ x ∈ wcOffS K m S d then
      Classical.choose (hINT h.choose x h.choose_spec.2 (SB h.choose x h.choose_spec.2).some
        (e / h.choose))
    else 0
  have hTof : ∀ d ∈ e.divisors, ∀ x (hx : x ∈ wcOffS K m S d),
      (Tof x : ℚ_[ℓ]) = (wcStalkMat (SB d x hx).some ^ (e / d)).trace := by
    intro d hd x hx
    have hex : ∃ d, d ∈ e.divisors ∧ x ∈ wcOffS K m S d := ⟨d, hd, hx⟩
    have key : ∀ (d' : ℕ) (hd' : d' ∈ e.divisors ∧ x ∈ wcOffS K m S d'), d' = d →
        ((Classical.choose (hINT d' x hd'.2 (SB d' x hd'.2).some (e / d')) : ℤ_[ℓ]) : ℚ_[ℓ]) =
          (wcStalkMat (SB d x hx).some ^ (e / d)).trace := by
      intro d' hd' hdd
      subst hdd
      exact Classical.choose_spec (hINT d' x hd'.2 (SB d' x hd'.2).some (e / d'))
    show ((if h : ∃ d, d ∈ e.divisors ∧ x ∈ wcOffS K m S d then
      Classical.choose (hINT h.choose x h.choose_spec.2 (SB h.choose x h.choose_spec.2).some
        (e / h.choose)) else 0 : ℤ_[ℓ]) : ℚ_[ℓ]) = _
    rw [dif_pos hex]
    exact key hex.choose hex.choose_spec (hdu x _ _ hex.choose_spec.2 hx)

  letI : Fintype ↥(wcFixedOffS K m S e) := hfin.fintype
  have hFrκ : wcFrE K e ≫ wcKbarPt K = wcKbarPt K := by
    rw [wcFrE, wcKbarPt, ← Spec.map_comp]
    congr 1
    ext x
    exact AlgEquiv.commutes _ x

  have hcong : ∀ n : ℕ, PadicInt.toZModPow n t =
      PadicInt.toZModPow n (∑ b : ↥(wcFixedOffS K m S e),
        Tof (b.1 (IsLocalRing.closedPoint (AlgebraicClosure K)))) := by
    intro n
    rcases Nat.eq_zero_or_pos n with hn0 | hn
    · subst hn0
      haveI : Subsingleton (ZMod (ℓ ^ 0)) := ZMod.subsingleton_iff.mpr (pow_zero ℓ)
      exact Subsingleton.elim _ _
    have hG := hCOV n hn
    obtain ⟨hfinΓ, -, -, -, hα0, -⟩ := hCOV n hn
    letI : Fintype (Γ n) := Fintype.ofFinite _
    have hα : ∀ γ, (α n γ).hom ≫ q' n ≫ Uo.ι = q' n ≫ Uo.ι := fun γ => by
      rw [← Category.assoc, hα0 γ]
    obtain ⟨P, hPM⟩ := wc_cover_model_exists K hP ℓ hℓ m S hS Uo hUo (q' n) (Γ n) (α n) hG hα
    have hlef := wc_cover_lefschetz K hP ℓ hℓ m S hS Uo hUo (q' n) (Γ n) (α n) hG hα P hPM e he
    have hH1n := hH1 n hn hα P hPM
    obtain ⟨hGa, hGb⟩ := wc_galcover_points (q' n) (Γ n) (α n) hG
    have hcomp : ∀ a b : Γ n, (α n a).hom ≫ (α n b).hom = (α n (b * a)).hom := by
      intro a b
      rw [map_mul, Aut.Aut_mul_def]
      rfl
    have hone : (α n 1).hom = 𝟙 _ := by
      rw [map_one]
      rfl
    let Y := {y : Spec (.of (AlgebraicClosure K)) ⟶ V n //
      y ≫ q' n ≫ Uo.ι ≫ (wcP1Over K).hom = wcKbarPt K ∧
        ∃ g, wcFrE K e ≫ y ≫ (α n g).hom = y}
    let act : Γ n → Y → Y := fun g y => ⟨y.1 ≫ (α n g).hom, by
      refine ⟨?_, ?_⟩
      · have h' : (α n g).hom ≫ q' n ≫ Uo.ι ≫ (wcP1Over K).hom =
            q' n ≫ Uo.ι ≫ (wcP1Over K).hom := by rw [← Category.assoc, hα0 g]
        rw [Category.assoc, h']
        exact y.2.1
      · obtain ⟨g0, hg0⟩ := y.2.2
        refine ⟨g * g0 * g⁻¹, ?_⟩
        rw [← hcomp, ← hcomp]
        simp only [Category.assoc]
        rw [← Category.assoc (α n g).hom, hcomp, inv_mul_cancel, hone, Category.id_comp]
        rw [← Category.assoc (wcFrE K e), ← Category.assoc, Category.assoc (wcFrE K e), hg0]⟩
    let Φ : Y → Y := fun y => ⟨wcFrE K e ≫ y.1, by
      refine ⟨?_, ?_⟩
      · rw [Category.assoc, y.2.1, hFrκ]
      · obtain ⟨g0, hg0⟩ := y.2.2
        exact ⟨g0, by rw [Category.assoc, hg0]⟩⟩
    let B := ↥(wcFixedOffS K m S e)
    let π : Y → B := fun y => ⟨y.1 ≫ q' n ≫ Uo.ι, by
      refine ⟨?_, ?_, ?_⟩
      · rw [Category.assoc, Category.assoc]
        exact y.2.1
      · obtain ⟨g0, hg0⟩ := y.2.2
        conv_rhs => rw [← hg0]
        simp only [Category.assoc]
        rw [hα]
      · intro i hi
        have hmem : (y.1 ≫ q' n ≫ Uo.ι) (IsLocalRing.closedPoint (AlgebraicClosure K)) ∈ Uo := by
          have e1 : (y.1 ≫ q' n ≫ Uo.ι) (IsLocalRing.closedPoint (AlgebraicClosure K)) =
              Uo.ι ((y.1 ≫ q' n) (IsLocalRing.closedPoint (AlgebraicClosure K))) := by
            first | rfl | simp
          have h2 : Uo.ι ((y.1 ≫ q' n) (IsLocalRing.closedPoint (AlgebraicClosure K))) ∈
              Set.range Uo.ι := ⟨_, rfl⟩
          rw [Scheme.Opens.range_ι] at h2
          rw [e1]
          exact h2
        exact ((hUo _).mp hmem i) hi⟩
    have hact1 : ∀ y, act 1 y = y := fun y => Subtype.ext (by
      show y.1 ≫ (α n 1).hom = y.1
      rw [hone, Category.comp_id])
    have hactmul : ∀ g h y, act (g * h) y = act g (act h y) := fun g h y => Subtype.ext (by
      show y.1 ≫ (α n (g * h)).hom = (y.1 ≫ (α n h).hom) ≫ (α n g).hom
      rw [Category.assoc, hcomp])
    have hfree : ∀ g y, act g y = y → g = 1 := by
      intro g y hgy
      obtain ⟨γ, _, huniq⟩ := hGa (AlgebraicClosure K) y.1 y.1 rfl
      have h1 := huniq 1 (by show y.1 = y.1 ≫ (α n 1).hom; rw [hone, Category.comp_id])
      have h2 := huniq g (congrArg Subtype.val hgy).symm
      rw [h1, h2]
    have hΦ : ∀ g y, Φ (act g y) = act g (Φ y) := fun g y => Subtype.ext (by
      show wcFrE K e ≫ y.1 ≫ (α n g).hom = (wcFrE K e ≫ y.1) ≫ (α n g).hom
      rw [Category.assoc])
    have hfix : ∀ y, ∃ g, act g (Φ y) = y := by
      intro y
      obtain ⟨g0, hg0⟩ := y.2.2
      exact ⟨g0, Subtype.ext (by
        show (wcFrE K e ≫ y.1) ≫ (α n g0).hom = y.1
        rw [Category.assoc, hg0])⟩
    have hιmono : Mono Uo.ι := inferInstance
    have hπfib : ∀ y y', π y = π y' ↔ ∃ g, y' = act g y := by
      intro y y'
      constructor
      · intro h
        have h1 : (y.1 ≫ q' n) ≫ Uo.ι = (y'.1 ≫ q' n) ≫ Uo.ι := by
          simpa only [Category.assoc] using congrArg Subtype.val h
        have h2 := (cancel_mono Uo.ι).mp h1
        obtain ⟨γ, hγ, -⟩ := hGa (AlgebraicClosure K) y.1 y'.1
          (by simpa only [Category.assoc] using h2)
        exact ⟨γ, Subtype.ext hγ⟩
      · rintro ⟨g, rfl⟩
        apply Subtype.ext
        show y.1 ≫ q' n ≫ Uo.ι = (y.1 ≫ (α n g).hom) ≫ q' n ≫ Uo.ι
        rw [Category.assoc, hα]
    have hπ : Function.Surjective π := by
      intro b
      obtain ⟨u, hu1, hu2, hu3⟩ := b
      have hrange : Set.range u.base ⊆ Set.range Uo.ι.base := by
        rintro _ ⟨z, rfl⟩
        rw [Scheme.Opens.range_ι]
        have hz : z = IsLocalRing.closedPoint (AlgebraicClosure K) := Subsingleton.elim _ _
        apply (hUo _).mpr
        rw [hz]
        exact hu3
      let u' := IsOpenImmersion.lift Uo.ι u hrange
      have hu' : u' ≫ Uo.ι = u := IsOpenImmersion.lift_fac _ _ _
      obtain ⟨y0, hy0⟩ := hGb (AlgebraicClosure K) u'
      have hsame : (wcFrE K e ≫ y0) ≫ q' n = y0 ≫ q' n := by
        apply (cancel_mono Uo.ι).mp
        simp only [Category.assoc]
        rw [← Category.assoc y0, hy0, hu', hu2]
      obtain ⟨γ, hγ, -⟩ := hGa (AlgebraicClosure K) (wcFrE K e ≫ y0) y0 hsame
      refine ⟨⟨y0, ?_, γ, ?_⟩, ?_⟩
      · rw [← Category.assoc y0, hy0, ← Category.assoc, hu', hu1]
      · rw [← Category.assoc]; exact hγ.symm
      · apply Subtype.ext
        show y0 ≫ q' n ≫ Uo.ι = u
        rw [← Category.assoc, hy0, hu']
    haveI : Finite Y := by
      refine Finite.of_surjective (fun p : B × Γ n => act p.2 (Function.surjInv hπ p.1)) ?_
      intro y
      obtain ⟨g, hg⟩ := (hπfib (Function.surjInv hπ (π y)) y).mp
        (Function.surjInv_eq hπ (π y))
      exact ⟨(π y, g), hg.symm⟩
    letI : Fintype Y := Fintype.ofFinite Y

    have hTr : ∀ γ : Γ n, wcGModelTr P e γ = ∑ τ : Γ n, wcGModelHS P e (τ⁻¹ * γ * τ) := by
      intro γ
      have hc : ∀ (x : MonoidAlgebra ℤ_[ℓ] (Γ n)) (τ : Γ n),
          (MonoidAlgebra.single γ⁻¹ (1 : ℤ_[ℓ]) * MonoidAlgebra.single τ 1 * x).coeff τ =
            x.coeff (τ⁻¹ * γ * τ) := by
        intro x τ
        rw [MonoidAlgebra.single_mul_single, MonoidAlgebra.coeff_single_mul_apply, one_mul,
          one_mul]
        congr 1
        group
      simp only [wcGModelTr, wcGModelHS, hc, Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Finset.sum_comm]
    have hHyp : ∀ γ : Γ n, ∑ τ : Γ n, wcGModelHS P e (τ⁻¹ * γ * τ) =
        ((Finset.univ.filter (fun y => act γ (Φ y) = y)).card : ℤ_[ℓ]) := by
      intro γ
      rw [← hTr]
      have hcard : Nat.card {v : Spec (.of (AlgebraicClosure K)) ⟶ V n //
          v ≫ q' n ≫ Uo.ι ≫ (wcP1Over K).hom = wcKbarPt K ∧
          wcFrE K e ≫ v ≫ (α n γ).hom = v} =
          (Finset.univ.filter (fun y => act γ (Φ y) = y)).card := by
        rw [← Fintype.card_subtype, ← Nat.card_eq_fintype_card]
        apply Nat.card_congr
        exact
          { toFun := fun v => ⟨⟨v.1, v.2.1, γ, v.2.2⟩, Subtype.ext (by
              show (wcFrE K e ≫ v.1) ≫ (α n γ).hom = v.1
              rw [Category.assoc]; exact v.2.2)⟩
            invFun := fun y => ⟨y.1.1, y.1.2.1, by
              have := congrArg Subtype.val y.2
              change (wcFrE K e ≫ y.1.1) ≫ (α n γ).hom = y.1.1 at this
              rw [Category.assoc] at this
              exact this⟩
            left_inv := fun v => rfl
            right_inv := fun y => rfl }
      apply Subtype.val_injective
      change ((wcGModelTr P e γ : ℤ_[ℓ]) : ℚ_[ℓ]) =
        ((((Finset.univ.filter (fun y => act γ (Φ y) = y)).card : ℕ) : ℤ_[ℓ]) : ℚ_[ℓ])
      rw [hlef γ, PadicInt.coe_natCast, hcard]
    have hχ : ∀ g h : Γ n, ((ρ n (h * g * h⁻¹) : GL (Fin r) (ZMod (ℓ ^ n))) :
        Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))).trace =
        ((ρ n g : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))).trace := by
      intro g h
      rw [map_mul, map_mul, map_inv, Units.val_mul, Units.val_mul, Matrix.trace_mul_comm,
        ← mul_assoc, Units.inv_mul, one_mul]
    have hw : ∀ (y : Y) (g : Γ n), act g (Φ y) = y →
        PadicInt.toZModPow n (Tof ((π y).1 (IsLocalRing.closedPoint (AlgebraicClosure K)))) =
          ((ρ n g : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))).trace := by
      intro y g hyg
      obtain ⟨d, hd, hx⟩ := hdiv (π y).1 (π y).2
      have hfr : wcFrE K e ≫ y.1 ≫ (α n g).hom = y.1 := by
        have := congrArg Subtype.val hyg
        change (wcFrE K e ≫ y.1) ≫ (α n g).hom = y.1 at this
        rw [Category.assoc] at this
        exact this
      exact hST n hn d hd _ hx (SB d _ hx).some y.1 g y.2.1 rfl hfr _ (hTof d hd _ hx)
    have hreg := wc_hattori_free_class_regroup act hact1 hactmul hfree Φ hΦ hfix π hπ hπfib
      (wcGModelHS P e) hHyp (PadicInt.toZModPow n)
      (fun g => ((ρ n g : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))).trace)
      hχ (fun b => PadicInt.toZModPow n (Tof (b.1 (IsLocalRing.closedPoint (AlgebraicClosure K)))))
      hw
    rw [hH1n, hreg, map_sum]

  have hlim : t = ∑ b : ↥(wcFixedOffS K m S e),
      Tof (b.1 (IsLocalRing.closedPoint (AlgebraicClosure K))) :=
    PadicInt.ext_of_toZModPow.mp hcong
  have hfs : ∑ᶠ u ∈ wcFixedOffS K m S e, Tof (u (IsLocalRing.closedPoint (AlgebraicClosure K))) =
      ∑ b : ↥(wcFixedOffS K m S e), Tof (b.1 (IsLocalRing.closedPoint (AlgebraicClosure K))) := by
    rw [← finsum_set_coe_eq_finsum_mem, finsum_eq_sum_of_fintype]

  let ι : ℤ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ] :=
    (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])).comp (PadicInt.Coe.ringHom (p := ℓ))
  have hloc : ∀ d ∈ e.divisors, ∀ i : Fin (np d),
      ((wcStalkLoc K ℓ G σ (pt d i) d).map (· ^ (e / d))).sum = ι (Tof (pt d i)) := by
    intro d hd i
    have hx := hpt d i
    have h1 : wcStalkLoc K ℓ G σ (pt d i) d =
        (wcStalkMat (SB d (pt d i) hx).some).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
      unfold wcStalkLoc
      rw [dif_pos (SB d (pt d i) hx)]
      rfl
    rw [h1, wc_aroots_pow_sum_trace, ← hTof d hd _ hx]
    rfl
  have hL : ∑ d ∈ e.divisors, ∑ i : Fin (np d),
      (d : AlgebraicClosure ℚ_[ℓ]) * ((wcStalkLoc K ℓ G σ (pt d i) d).map (· ^ (e / d))).sum =
      ι (∑ d ∈ e.divisors, ∑ i : Fin (np d), d • Tof (pt d i)) := by
    rw [map_sum]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    rw [map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [hloc d hd i, map_nsmul, nsmul_eq_mul]
  rw [hL, ← hsum ℤ_[ℓ] Tof, hfs, ← hlim,
    wc_aroots_pow_sum_trace ℓ (wcAddEquivMatrix e₂ (wcCohGFrob K (wcP1Over K) hP G 2)) e,
    wc_aroots_pow_sum_trace ℓ (wcAddEquivMatrix e₁ (wcCohGFrob K (wcP1Over K) hP G 1)) e,
    ← map_sub, ← ht]
  rfl

theorem wc_vqtt_H2_scalar_module (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (hm : 1 ≤ m) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G))
    (ι' : Type) [Fintype ι'] [DecidableEq ι']
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (θG : G.over W ≅ (wcContSheaf (wcP1Over K).left (ι' → ℚ_[ℓ])).over W)
    (hθc : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
          θG.hom =
        θG.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map
          (wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) c)
            (continuous_const_smul c)))
    (hqc : QuasiCompact w.left)
    (hcov : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p) :
    ∀ (a b : ℚ_[ℓ]) (y : wcCohG K (wcP1Over K) hP G 2),
      wcCohGEnd K (wcP1Over K) hP G 2 (σ (a + b)) y =
          wcCohGEnd K (wcP1Over K) hP G 2 (σ a) y + wcCohGEnd K (wcP1Over K) hP G 2 (σ b) y ∧
        wcCohGEnd K (wcP1Over K) hP G 2 (σ (a * b)) y =
          wcCohGEnd K (wcP1Over K) hP G 2 (σ a) (wcCohGEnd K (wcP1Over K) hP G 2 (σ b) y) ∧
        wcCohGEnd K (wcP1Over K) hP G 2 (σ 1) y = y :=
by
  classical
  set F := (Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W with hF
  haveI : Limits.PreservesFiniteColimits F := by
    have hpc : Limits.PreservesColimitsOfSize.{0, 0} F :=
      (Functor.sheafAdjunctionCocontinuous (Over.forget W) AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology (wcP1Over K).left).over W)
        (Scheme.ProEt.topology (wcP1Over K).left)).leftAdjoint_preservesColimits
    exact Limits.PreservesColimitsOfSize.preservesFiniteColimits F
  haveI : F.Additive := Functor.additive_of_preserves_binary_products _

  have s1 : ∀ (G' : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (δ : G ⟶ G'), F.map δ = 0 →
      ∀ y : wcCohG K (wcP1Over K) hP G 2, y.comp (Abelian.Ext.mk₀ δ) (add_zero 2) = 0 := by
    intro G' δ hδ y
    have hfac : Abelian.Ext.mk₀ δ = (Abelian.Ext.mk₀ (Limits.factorThruImage δ)).comp
        (Abelian.Ext.mk₀ (Limits.image.ι δ)) (zero_add 0) := by
      rw [Abelian.Ext.mk₀_comp_mk₀, Limits.image.fac]
    have hFe : F.map (Limits.factorThruImage δ) = 0 := by
      rw [← cancel_mono (F.map (Limits.image.ι δ)), ← F.map_comp, Limits.image.fac, hδ,
        Limits.zero_comp]
    have hI : Limits.IsZero (F.obj (Limits.image δ)) := by
      rw [Limits.IsZero.iff_id_eq_zero, ← cancel_epi (F.map (Limits.factorThruImage δ)), hFe]
      simp
    have hoff := wc_P1_offS_sections_zero_of_over_zero K hP m S W w hqc hcov (Limits.image δ) hI
    have hvan := wc_proet_P1_finite_supp_ext_vanish K hP m S hS (Limits.image δ) hoff 2
      (by norm_num)
    rw [hfac, ← Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ (Limits.factorThruImage δ))
      (Abelian.Ext.mk₀ (Limits.image.ι δ)) (add_zero 2) (zero_add 0) (by omega),
      hvan (y.comp (Abelian.Ext.mk₀ (Limits.factorThruImage δ)) (add_zero 2)),
      Abelian.Ext.zero_comp]

  have hsum : ∀ a b : ℚ_[ℓ],
      wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) (a + b))
          (continuous_const_smul (a + b)) =
        wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) a)
          (continuous_const_smul a) +
        wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) b)
          (continuous_const_smul b) := by
    intro a b
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply]
    apply ULift.ext
    apply ContinuousMap.ext
    intro p
    exact add_smul a b _
  have hcomp : ∀ a b : ℚ_[ℓ],
      wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) b)
          (continuous_const_smul b) ≫
        wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) a)
          (continuous_const_smul a) =
      wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) (a * b))
          (continuous_const_smul (a * b)) := by
    intro a b
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply]
    apply ULift.ext
    apply ContinuousMap.ext
    intro p
    exact smul_smul a b _
  have hone : wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) 1)
      (continuous_const_smul 1) = 𝟙 _ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    apply ContinuousMap.ext
    intro p
    exact one_smul ℚ_[ℓ] _

  have hθ2 : ∀ c : ℚ_[ℓ], F.map (σ c) ≫ θG.hom = θG.hom ≫ F.map
      (wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) c)
        (continuous_const_smul c)) := hθc
  have cancel : ∀ δ : G ⟶ G, F.map δ ≫ θG.hom = 0 → F.map δ = 0 := by
    intro δ h
    rw [← cancel_mono θG.hom, h, Limits.zero_comp]
  have hθc' : ∀ (c : ℚ_[ℓ]) {Z : Sheaf ((Scheme.ProEt.topology (wcP1Over K).left).over W)
      AddCommGrpCat.{u+1}}
      (h : (wcContSheaf (wcP1Over K).left (ι' → ℚ_[ℓ])).over W ⟶ Z),
      F.map (σ c) ≫ θG.hom ≫ h = θG.hom ≫ F.map
        (wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) c)
          (continuous_const_smul c)) ≫ h := by
    intro c Z h
    rw [← Category.assoc, hθ2, Category.assoc]
  have hA : ∀ a b : ℚ_[ℓ], F.map (σ (a + b) - σ a - σ b) = 0 := by
    intro a b
    apply cancel
    have e : F.map (σ (a + b) - σ a - σ b) ≫ θG.hom = θG.hom ≫ F.map
        (wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) (a + b))
          (continuous_const_smul (a + b)) -
        wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) a)
          (continuous_const_smul a) -
        wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) b)
          (continuous_const_smul b)) := by
      rw [Functor.map_sub, Functor.map_sub, Functor.map_sub, Functor.map_sub,
        Preadditive.sub_comp, Preadditive.sub_comp, Preadditive.comp_sub, Preadditive.comp_sub,
        hθ2, hθ2, hθ2]
    rw [e, hsum a b, add_sub_cancel_left, sub_self, Functor.map_zero, Limits.comp_zero]
  have hM : ∀ a b : ℚ_[ℓ], F.map (σ b ≫ σ a - σ (a * b)) = 0 := by
    intro a b
    apply cancel
    have e : F.map (σ b ≫ σ a - σ (a * b)) ≫ θG.hom = θG.hom ≫ F.map
        (wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) b)
          (continuous_const_smul b) ≫
        wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) a)
          (continuous_const_smul a) -
        wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) (a * b))
          (continuous_const_smul (a * b))) := by
      rw [Functor.map_sub, Functor.map_sub, Functor.map_comp, Functor.map_comp,
        Preadditive.sub_comp, Preadditive.comp_sub, Category.assoc, hθ2, hθ2, hθc']
    rw [e, hcomp a b, sub_self, Functor.map_zero, Limits.comp_zero]
  have hO : F.map (σ 1 - 𝟙 G) = 0 := by
    apply cancel
    have hid : F.map (𝟙 G) = 𝟙 _ := F.map_id G
    have hid2 : F.map (𝟙 (wcContSheaf (wcP1Over K).left (ι' → ℚ_[ℓ]))) = 𝟙 _ := F.map_id _
    have e : F.map (σ 1 - 𝟙 G) ≫ θG.hom = θG.hom ≫ F.map
        (wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) 1)
          (continuous_const_smul 1) - 𝟙 _) := by
      rw [Functor.map_sub, Functor.map_sub, Preadditive.sub_comp, Preadditive.comp_sub,
        hθ2, hid, hid2, Category.id_comp, Category.comp_id]
      rfl
    rw [e, hone, sub_self, Functor.map_zero, Limits.comp_zero]

  have hpost : ∀ (f : G ⟶ G) (y : wcCohG K (wcP1Over K) hP G 2),
      wcCohGEnd K (wcP1Over K) hP G 2 f y = y.comp (Abelian.Ext.mk₀ f) (add_zero 2) :=
    fun f y => rfl
  intro a b y
  refine ⟨?_, ?_, ?_⟩
  · simp only [hpost]
    have h1 : σ (a + b) = (σ (a + b) - σ a - σ b) + (σ a + σ b) := by abel
    rw [h1, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, s1 G _ (hA a b) y, zero_add,
      Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
  · simp only [hpost]
    rw [Abelian.Ext.comp_assoc y (Abelian.Ext.mk₀ (σ b)) (Abelian.Ext.mk₀ (σ a)) (add_zero 2)
      (zero_add 0) (by omega), Abelian.Ext.mk₀_comp_mk₀]
    have h2 : σ b ≫ σ a = (σ b ≫ σ a - σ (a * b)) + σ (a * b) := (sub_add_cancel _ _).symm
    rw [h2, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, s1 G _ (hM a b) y, zero_add]
  · simp only [hpost]
    have h3 : σ 1 = (σ 1 - 𝟙 G) + 𝟙 G := (sub_add_cancel _ _).symm
    rw [h3, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, s1 G _ hO y, zero_add,
      Abelian.Ext.comp_mk₀_id]

theorem wc_vqtt_frame_reindex (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt)
    (ι' : Type) [Fintype ι'] (k : ℕ) (e : ι' ≃ Fin k)
    (θG : G.over W ≅ (wcContSheaf S (ι' → ℚ_[ℓ])).over W) :
    ∃ θ : G.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W,
      ∀ (V : S.ProEt) (b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left) (j : Fin k),
        (show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z j =
        (show C(↥V.left, ι' → ℚ_[ℓ]) from
          ((θG.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z (e.symm j) :=
by
  let ρ : (ι' → ℚ_[ℓ]) →+ (Fin k → ℚ_[ℓ]) :=
    { toFun := fun v j => v (e.symm j), map_zero' := rfl, map_add' := fun _ _ => rfl }
  let ρ' : (Fin k → ℚ_[ℓ]) →+ (ι' → ℚ_[ℓ]) :=
    { toFun := fun w i => w (e i), map_zero' := rfl, map_add' := fun _ _ => rfl }
  have hρ : Continuous ρ := continuous_pi (fun j => continuous_apply (e.symm j))
  have hρ' : Continuous ρ' := continuous_pi (fun i => continuous_apply (e i))
  let c := wcContSheafMap S ρ hρ
  let c' := wcContSheafMap S ρ' hρ'
  have h1 : c ≫ c' = 𝟙 _ := by
    apply Sheaf.hom_ext
    ext U y
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    funext i
    exact congrArg (fun a => (show C(↥(Opposite.unop U).left, ι' → ℚ_[ℓ]) from y.down) t a)
      (e.symm_apply_apply i)
  have h2 : c' ≫ c = 𝟙 _ := by
    apply Sheaf.hom_ext
    ext U y
    apply ULift.ext
    apply ContinuousMap.ext
    intro t
    funext j
    exact congrArg (fun a => (show C(↥(Opposite.unop U).left, Fin k → ℚ_[ℓ]) from y.down) t a)
      (e.apply_symm_apply j)
  let κ : wcContSheaf S (ι' → ℚ_[ℓ]) ≅ wcContSheaf S (Fin k → ℚ_[ℓ]) := ⟨c, c', h1, h2⟩
  refine ⟨θG ≪≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).mapIso κ, ?_⟩
  intro V b x z j
  rfl

theorem wc_vqtt_J_scalar_restrict (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt) (k : ℕ)
    (θ : G.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W)
    (P : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (J : Subobject G)
    (hJ : ∀ (V : S.ProEt) (s : G.obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : S.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖P ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1)
    (f : G ⟶ G) (a : ℤ_[ℓ])
    (hf : ∀ (V : S.ProEt) (b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((f.hom.app (Opposite.op V)).hom x)).down) z =
      (a : ℚ_[ℓ]) • (show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) :
    ∃ τ : Subobject.underlying.obj J ⟶ Subobject.underlying.obj J, τ ≫ J.arrow = J.arrow ≫ f :=
by
  classical

  have hιinj : ∀ V : S.ProEt, Function.Injective (J.arrow.hom.app (Opposite.op V)).hom := by
    intro V
    haveI h1 : Mono J.arrow.hom :=
      Functor.map_mono (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) J.arrow
    haveI h2 : Mono (J.arrow.hom.app (Opposite.op V)) := (NatTrans.mono_iff_mono_app _).mp h1 _
    exact (AddCommGrpCat.mono_iff_injective _).mp h2

  have hsec : ∀ (V : S.ProEt) (t : (Subobject.underlying.obj J).obj.obj (Opposite.op V)),
      ∃ t', (J.arrow.hom.app (Opposite.op V)).hom t' =
        (f.hom.app (Opposite.op V)).hom ((J.arrow.hom.app (Opposite.op V)).hom t) := by
    intro V t
    refine (hJ V _).mpr ?_
    intro V' c b z i
    have hnat : (G.obj.map c.op).hom ((f.hom.app (Opposite.op V)).hom
          ((J.arrow.hom.app (Opposite.op V)).hom t)) =
        (f.hom.app (Opposite.op V')).hom ((G.obj.map c.op).hom
          ((J.arrow.hom.app (Opposite.op V)).hom t)) :=
      (congrArg (fun φ => φ.hom ((J.arrow.hom.app (Opposite.op V)).hom t))
        (f.hom.naturality c.op)).symm
    rw [hnat, hf V' b _ z, LinearEquiv.map_smul, Pi.smul_apply, smul_eq_mul, norm_mul]
    have hA : ‖(a : ℚ_[ℓ])‖ ≤ 1 := PadicInt.norm_le_one a
    have hY := (hJ V ((J.arrow.hom.app (Opposite.op V)).hom t)).mp ⟨t, rfl⟩ V' c b z i
    exact mul_le_one₀ hA (norm_nonneg _) hY
  choose τf hτf using hsec

  have hadd : ∀ (V : S.ProEt) (x y : (Subobject.underlying.obj J).obj.obj (Opposite.op V)),
      τf V (x + y) = τf V x + τf V y := by
    intro V x y
    apply hιinj V
    rw [hτf, map_add, map_add, map_add, hτf, hτf]

  let α : (Subobject.underlying.obj J).obj ⟶ (Subobject.underlying.obj J).obj :=
    { app := fun U => AddCommGrpCat.ofHom (AddMonoidHom.mk' (τf U.unop) (hadd U.unop))
      naturality := by
        intro U U' g
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro x
        show τf U'.unop (((Subobject.underlying.obj J).obj.map g).hom x) =
          ((Subobject.underlying.obj J).obj.map g).hom (τf U.unop x)
        apply hιinj U'.unop
        have hJn : ∀ y : (Subobject.underlying.obj J).obj.obj (Opposite.op U.unop),
            (J.arrow.hom.app (Opposite.op U'.unop)).hom
              (((Subobject.underlying.obj J).obj.map g).hom y) =
            (G.obj.map g).hom ((J.arrow.hom.app (Opposite.op U.unop)).hom y) := fun y =>
          congrArg (fun φ => φ.hom y) (J.arrow.hom.naturality g)
        have hfn : ∀ y : G.obj.obj (Opposite.op U.unop),
            (f.hom.app (Opposite.op U'.unop)).hom ((G.obj.map g).hom y) =
            (G.obj.map g).hom ((f.hom.app (Opposite.op U.unop)).hom y) := fun y =>
          congrArg (fun φ => φ.hom y) (f.hom.naturality g)
        rw [hτf, hJn, hfn, ← hτf, hJn] }
  let τ : Subobject.underlying.obj J ⟶ Subobject.underlying.obj J := ObjectProperty.homMk α
  refine ⟨τ, ?_⟩
  apply Sheaf.hom_ext
  apply NatTrans.ext
  funext U
  apply AddCommGrpCat.hom_ext
  apply AddMonoidHom.ext
  intro x
  show (J.arrow.hom.app (Opposite.op U.unop)).hom (τf U.unop x) =
    (f.hom.app (Opposite.op U.unop)).hom ((J.arrow.hom.app (Opposite.op U.unop)).hom x)
  exact hτf U.unop x

theorem wc_vqtt_ext_comp_zero_of_over_zero (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left)
    (hcov : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (X Y Z : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (δ : X ⟶ Y) (μ : Y ⟶ Z) [Mono μ]
    (hδ : ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map
      (δ ≫ μ) = 0)
    (j : ℕ) (hj : 1 ≤ j) :
    ∀ x : wcCohG K (wcP1Over K) hP X j, x.comp (Abelian.Ext.mk₀ δ) (add_zero j) = 0 :=
by
  classical
  set F := (Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W with hF
  haveI : Limits.PreservesFiniteColimits F := by
    have hpc : Limits.PreservesColimitsOfSize.{0, 0} F :=
      (Functor.sheafAdjunctionCocontinuous (Over.forget W) AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology (wcP1Over K).left).over W)
        (Scheme.ProEt.topology (wcP1Over K).left)).leftAdjoint_preservesColimits
    exact Limits.PreservesColimitsOfSize.preservesFiniteColimits F
  haveI : F.Additive := Functor.additive_of_preserves_binary_products _
  have hδ' : F.map (δ ≫ μ) = 0 := hδ
  have hFδ : F.map δ = 0 := by
    rw [← cancel_mono (F.map μ), ← F.map_comp, hδ', Limits.zero_comp]
  intro x
  have hfac : Abelian.Ext.mk₀ δ = (Abelian.Ext.mk₀ (Limits.factorThruImage δ)).comp
      (Abelian.Ext.mk₀ (Limits.image.ι δ)) (zero_add 0) := by
    rw [Abelian.Ext.mk₀_comp_mk₀, Limits.image.fac]
  have hFe : F.map (Limits.factorThruImage δ) = 0 := by
    rw [← cancel_mono (F.map (Limits.image.ι δ)), ← F.map_comp, Limits.image.fac, hFδ,
      Limits.zero_comp]
  have hI : Limits.IsZero (F.obj (Limits.image δ)) := by
    rw [Limits.IsZero.iff_id_eq_zero, ← cancel_epi (F.map (Limits.factorThruImage δ)), hFe]
    simp
  have hoff := wc_P1_offS_sections_zero_of_over_zero K hP m S W w hqc hcov (Limits.image δ) hI
  have hvan := wc_proet_P1_finite_supp_ext_vanish K hP m S hS (Limits.image δ) hoff j hj
  rw [hfac, ← Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ (Limits.factorThruImage δ))
    (Abelian.Ext.mk₀ (Limits.image.ι δ)) (add_zero j) (zero_add 0) (by omega),
    hvan (x.comp (Abelian.Ext.mk₀ (Limits.factorThruImage δ)) (add_zero j)),
    Abelian.Ext.zero_comp]

theorem wc_vqtt_scalar_defects_over_zero (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (σ : ℚ_[ℓ] → (G ⟶ G))
    (ι' : Type) [Fintype ι'] (W : S.ProEt)
    (θG : G.over W ≅ (wcContSheaf S (ι' → ℚ_[ℓ])).over W)
    (hθc : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫ θG.hom =
        θG.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
          (wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) c) (continuous_const_smul c))) :
    ∀ a b : ℚ_[ℓ],
      ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map (σ (a + b) - σ a - σ b) = 0 ∧
      ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map (σ (a * b) - σ b ≫ σ a) = 0 ∧
      ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map (σ 1 - 𝟙 G) = 0 :=
by
  classical
  set F := (Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W with hF
  haveI : Limits.PreservesFiniteColimits F := by
    have hpc : Limits.PreservesColimitsOfSize.{0, 0} F :=
      (Functor.sheafAdjunctionCocontinuous (Over.forget W) AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology S).over W)
        (Scheme.ProEt.topology S)).leftAdjoint_preservesColimits
    exact Limits.PreservesColimitsOfSize.preservesFiniteColimits F
  haveI : F.Additive := Functor.additive_of_preserves_binary_products _

  have hsum : ∀ a b : ℚ_[ℓ],
      wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) (a + b))
          (continuous_const_smul (a + b)) =
        wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) a)
          (continuous_const_smul a) +
        wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) b)
          (continuous_const_smul b) := by
    intro a b
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply]
    apply ULift.ext
    apply ContinuousMap.ext
    intro p
    exact add_smul a b _
  have hcomp : ∀ a b : ℚ_[ℓ],
      wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) b)
          (continuous_const_smul b) ≫
        wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) a)
          (continuous_const_smul a) =
      wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) (a * b))
          (continuous_const_smul (a * b)) := by
    intro a b
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply]
    apply ULift.ext
    apply ContinuousMap.ext
    intro p
    exact smul_smul a b _
  have hone : wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) 1)
      (continuous_const_smul 1) = 𝟙 _ := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    apply ContinuousMap.ext
    intro p
    exact one_smul ℚ_[ℓ] _

  have hθ2 : ∀ c : ℚ_[ℓ], F.map (σ c) ≫ θG.hom = θG.hom ≫ F.map
      (wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) c)
        (continuous_const_smul c)) := hθc
  have cancel : ∀ δ : G ⟶ G, F.map δ ≫ θG.hom = 0 → F.map δ = 0 := by
    intro δ h
    rw [← cancel_mono θG.hom, h, Limits.zero_comp]
  have hθc' : ∀ (c : ℚ_[ℓ]) {Z : Sheaf ((Scheme.ProEt.topology S).over W)
      AddCommGrpCat.{u+1}}
      (h : (wcContSheaf S (ι' → ℚ_[ℓ])).over W ⟶ Z),
      F.map (σ c) ≫ θG.hom ≫ h = θG.hom ≫ F.map
        (wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) c)
          (continuous_const_smul c)) ≫ h := by
    intro c Z h
    rw [← Category.assoc, hθ2, Category.assoc]
  have hA : ∀ a b : ℚ_[ℓ], F.map (σ (a + b) - σ a - σ b) = 0 := by
    intro a b
    apply cancel
    have e : F.map (σ (a + b) - σ a - σ b) ≫ θG.hom = θG.hom ≫ F.map
        (wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) (a + b))
          (continuous_const_smul (a + b)) -
        wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) a)
          (continuous_const_smul a) -
        wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) b)
          (continuous_const_smul b)) := by
      rw [Functor.map_sub, Functor.map_sub, Functor.map_sub, Functor.map_sub,
        Preadditive.sub_comp, Preadditive.sub_comp, Preadditive.comp_sub, Preadditive.comp_sub,
        hθ2, hθ2, hθ2]
    rw [e, hsum a b, add_sub_cancel_left, sub_self, Functor.map_zero, Limits.comp_zero]
  have hM : ∀ a b : ℚ_[ℓ], F.map (σ (a * b) - σ b ≫ σ a) = 0 := by
    intro a b
    apply cancel
    have e : F.map (σ (a * b) - σ b ≫ σ a) ≫ θG.hom = θG.hom ≫ F.map
        (wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) (a * b))
          (continuous_const_smul (a * b)) -
        wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) b)
          (continuous_const_smul b) ≫
        wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) a)
          (continuous_const_smul a)) := by
      rw [Functor.map_sub, Functor.map_sub, Functor.map_comp, Functor.map_comp,
        Preadditive.sub_comp, Preadditive.comp_sub, Category.assoc, hθ2, hθ2, hθc']
    rw [e, hcomp a b, sub_self, Functor.map_zero, Limits.comp_zero]
  have hO : F.map (σ 1 - 𝟙 G) = 0 := by
    apply cancel
    have hid : F.map (𝟙 G) = 𝟙 _ := F.map_id G
    have hid2 : F.map (𝟙 (wcContSheaf S (ι' → ℚ_[ℓ]))) = 𝟙 _ := F.map_id _
    have e : F.map (σ 1 - 𝟙 G) ≫ θG.hom = θG.hom ≫ F.map
        (wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) 1)
          (continuous_const_smul 1) - 𝟙 _) := by
      rw [Functor.map_sub, Functor.map_sub, Preadditive.sub_comp, Preadditive.comp_sub,
        hθ2, hid, hid2, Category.id_comp, Category.comp_id]
      rfl
    rw [e, hone, sub_self, Functor.map_zero, Limits.comp_zero]
  intro a b
  exact ⟨hA a b, hM a b, hO⟩

theorem wc_vqtt_ext_rationalize_gen (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP) (k : ℕ)
    (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (hqc : QuasiCompact w.left)
    (P : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (J : Subobject G)
    (hJ : ∀ (V : (wcP1Over K).left.ProEt) (s : G.obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : (wcP1Over K).left.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖P ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1) :
    ∀ y : wcCohG K (wcP1Over K) hP G 2,
      ∃ (N : ℕ) (y₀ : wcCohG K (wcP1Over K) hP (Subobject.underlying.obj J) 2),
        (ℓ ^ N : ℕ) • y = y₀.comp (Abelian.Ext.mk₀ J.arrow) (add_zero 2) :=
by
  classical
  intro y

  haveI hprop : IsProper (wcP1Over K).hom := wc_proj_space_isProper K 1
  haveI hprop' : IsProper (Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
    IsProper.instSndScheme _ _
  have hqc0 : QuasiCompact (Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) := inferInstance
  have hqs0 : QuasiSeparated (Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) := inferInstance
  haveI : CompactSpace (wcGeomPoint K (wcP1Over K) hP).left :=
    @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) hqc0 _
  haveI : QuasiSeparatedSpace (wcGeomPoint K (wcP1Over K) hP).left :=
    @quasiSeparatedSpace_of_quasiSeparated _ _ (Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) _ hqs0
  have hW : QuasiCompact W.hom := by
    have hwB : w.left ≫ (wcGeomPoint K (wcP1Over K) hP).hom = W.hom := MorphismProperty.Over.w w
    haveI : QuasiCompact (wcGeomPoint K (wcP1Over K) hP).hom := by
      show QuasiCompact (Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      infer_instance
    haveI := hqc
    rw [← hwB]
    infer_instance

  have hbd : ∀ (V : (wcP1Over K).left.ProEt), CompactSpace V.left →
      ∀ s : G.obj.obj (Opposite.op V),
      ∃ (m : ℕ) (t : (Subobject.underlying.obj J).obj.obj (Opposite.op V)),
        (J.arrow.hom.app (Opposite.op V)).hom t = (ℓ ^ m : ℕ) • s := by
    intro V hV s
    haveI := hV
    haveI := hW
    haveI hVp : WeaklyEtale V.hom := V.prop
    haveI hWp : WeaklyEtale W.hom := W.prop
    let p₁ := Limits.pullback.fst V.hom W.hom
    let p₂ := Limits.pullback.snd V.hom W.hom
    haveI : WeaklyEtale p₁ := inferInstance
    haveI : WeaklyEtale (p₁ ≫ V.hom) := inferInstance
    let Zl : (wcP1Over K).left.ProEt := Scheme.ProEt.mk (p₁ ≫ V.hom)
    have e₂ : p₂ ≫ W.hom = Zl.hom := by
      show p₂ ≫ W.hom = p₁ ≫ V.hom
      exact Limits.pullback.condition.symm
    let P₁ : Zl ⟶ V := MorphismProperty.Over.homMk p₁ rfl trivial
    let P₂ : Zl ⟶ W := MorphismProperty.Over.homMk p₂ e₂ trivial
    haveI hqp : QuasiCompact p₁ := inferInstance
    haveI hZc : CompactSpace (Limits.pullback V.hom W.hom : Scheme) :=
      @QuasiCompact.compactSpace_of_compactSpace _ _ p₁ hqp hV
    haveI hZc' : CompactSpace ↥Zl.left := hZc
    let s₁ : G.obj.obj (Opposite.op Zl) :=
      (G.obj.map P₁.op).hom s
    let σ : C(↥Zl.left, Fin k → ℚ_[ℓ]) :=
      (show C(↥Zl.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk P₂))).hom s₁).down)
    obtain ⟨C, hC⟩ := (isCompact_univ (X := ↥Zl.left)).exists_bound_of_continuousOn
      ((LinearMap.continuous_of_finiteDimensional P.toLinearMap).comp σ.continuous).continuousOn
    have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := Nat.one_lt_cast.mpr (Fact.out : Nat.Prime ℓ).one_lt
    obtain ⟨m, hm⟩ := pow_unbounded_of_one_lt C hℓ1
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ m := pow_pos (by linarith) m
    refine ⟨m, (hJ V ((ℓ ^ m : ℕ) • s)).2 ?_⟩
    intro V' c b z i
    have hcV : c.left ≫ V.hom = V'.hom := MorphismProperty.Over.w c
    have hbW : b.left ≫ W.hom = V'.hom := MorphismProperty.Over.w b
    let h : V'.left ⟶ Limits.pullback V.hom W.hom :=
      Limits.pullback.lift c.left b.left (hcV.trans hbW.symm)
    have hh1 : h ≫ p₁ = c.left := Limits.pullback.lift_fst _ _ _
    have hh2 : h ≫ p₂ = b.left := Limits.pullback.lift_snd _ _ _
    have eh : h ≫ Zl.hom = V'.hom := by
      show h ≫ p₁ ≫ V.hom = V'.hom
      rw [← Category.assoc, hh1, hcV]
    let Ht : V' ⟶ Zl := MorphismProperty.Over.homMk h eh trivial
    have hHt1 : Ht ≫ P₁ = c := MorphismProperty.Over.Hom.ext (by exact hh1)
    have hHt2 : Ht ≫ P₂ = b := MorphismProperty.Over.Hom.ext (by exact hh2)
    let a : (Over.mk b : Over W) ⟶ Over.mk P₂ := Over.homMk Ht hHt2
    have hN : (show C(↥V'.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          (((G.over W).obj.map a.op).hom s₁)).down) z = σ (h z) := by
      have N2 := congrArg (fun F : (G.over W).obj.obj
            (Opposite.op (Over.mk P₂)) ⟶
          ((wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W).obj.obj
            (Opposite.op (Over.mk b : Over W)) => F.hom s₁)
        (θ.hom.hom.naturality a.op)
      exact congrArg (fun y : ULift.{u+1} C(↥V'.left, Fin k → ℚ_[ℓ]) => y.down z) N2
    have hsec : (G.obj.map c.op).hom s =
        ((G.over W).obj.map a.op).hom s₁ := by
      have e := congrArg (fun φ => φ.hom s) (G.obj.map_comp P₁.op Ht.op)
      rw [← op_comp, hHt1] at e
      exact e
    have e1 : (G.obj.map c.op).hom ((ℓ ^ m : ℕ) • s) =
        (ℓ ^ m : ℕ) • ((G.over W).obj.map a.op).hom s₁ := by
      rw [map_nsmul]
      exact congrArg (fun x => (ℓ ^ m : ℕ) • x) hsec
    have e2 : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom
        ((G.obj.map c.op).hom ((ℓ ^ m : ℕ) • s)) =
        (ℓ ^ m : ℕ) • (θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          (((G.over W).obj.map a.op).hom s₁) := by
      rw [e1, map_nsmul]
    have key : P ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          ((G.obj.map c.op).hom ((ℓ ^ m : ℕ) • s))).down) z) =
        (ℓ ^ m : ℕ) • P (σ (h z)) := by
      rw [e2, ← map_nsmul P]
      congr 1
      rw [← hN]
      rfl
    have hb2 : ‖P (σ (h z))‖ ≤ C := hC (h z) (Set.mem_univ _)
    have hb3 := norm_le_pi_norm (P (σ (h z))) i
    rw [key, Pi.smul_apply, nsmul_eq_mul, norm_mul, Nat.cast_pow, Padic.norm_p_pow, zpow_neg,
      zpow_natCast, inv_mul_le_iff₀ hpos, mul_one]
    linarith

  have hns : ∀ (X : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (m : ℕ) (U : ((wcP1Over K).left.ProEt)ᵒᵖ) (x : (X.obj.obj U : Type (u+1))),
      (m • 𝟙 X).hom.app U x = m • x := by
    intro X m U x
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul]; rfl
    | succ m ih =>
      rw [succ_nsmul, Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, ih, succ_nsmul]
      rfl
  have hmono : Monotone (fun n : ℕ =>
      (Subobject.pullback ((ℓ ^ n : ℕ) • 𝟙 G)).obj J) := by
    apply monotone_nat_of_le_succ
    intro n
    show (Subobject.pullback ((ℓ ^ n : ℕ) • 𝟙 G)).obj J ≤
      (Subobject.pullback ((ℓ ^ (n + 1) : ℕ) • 𝟙 G)).obj J
    have hPn := Subobject.isPullback ((ℓ ^ n : ℕ) • 𝟙 G) J
    have hPn1 := Subobject.isPullback ((ℓ ^ (n + 1) : ℕ) • 𝟙 G) J
    have hw := hPn.w
    have heq : (Subobject.pullbackπ ((ℓ ^ n : ℕ) • 𝟙 G) J ≫
        (ℓ • 𝟙 (Subobject.underlying.obj J))) ≫ J.arrow =
        ((Subobject.pullback ((ℓ ^ n : ℕ) • 𝟙 G)).obj J).arrow ≫
          ((ℓ ^ (n + 1) : ℕ) • 𝟙 G) := by
      calc (Subobject.pullbackπ ((ℓ ^ n : ℕ) • 𝟙 G) J ≫
          (ℓ • 𝟙 (Subobject.underlying.obj J))) ≫ J.arrow
          = ℓ • (Subobject.pullbackπ ((ℓ ^ n : ℕ) • 𝟙 G) J ≫
              J.arrow) := by
            rw [Category.assoc, Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul]
        _ = ℓ • (((Subobject.pullback ((ℓ ^ n : ℕ) • 𝟙 G)).obj J).arrow ≫
              ((ℓ ^ n : ℕ) • 𝟙 G)) := by rw [hw]
        _ = _ := by
            rw [Preadditive.comp_nsmul, Preadditive.comp_nsmul, Category.comp_id,
              smul_smul, pow_succ']
    exact Subobject.le_of_comm (hPn1.lift _ _ heq) (hPn1.lift_snd _ _ _)
  let κ : (Monotone.functor hmono ⋙ Subobject.underlying) ⟶
      (Functor.const ℕ).obj G :=
    { app := fun n =>
        ((Subobject.pullback ((ℓ ^ n : ℕ) • 𝟙 G)).obj J).arrow
      naturality := fun n n' f => by
        erw [Category.comp_id]
        exact Subobject.underlying_arrow _ }
  haveI hcol : Limits.HasColimitsOfShape ℕ
      (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) := inferInstance
  haveI hcolF : Limits.HasColimit (Monotone.functor hmono ⋙ Subobject.underlying) :=
    Limits.HasColimitsOfShape.has_colimit _
  haveI hex : HasExactColimitsOfShape ℕ
      (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _
      (Scheme.ProEt.topology (wcP1Over K).left) _ _ _
      (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
        (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))
  have crit : ∀ (T : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (D : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (κ : D ⟶ (Functor.const ℕ).obj T), (∀ n, Mono (κ.app n)) →
      Epi (Limits.colimit.desc D (Limits.Cocone.mk T κ)) →
      Nonempty (Limits.IsColimit (Limits.Cocone.mk T κ)) := by
    intro T D κ hmono hepi
    haveI : Mono κ := NatTrans.mono_of_mono_app κ
    haveI : Mono (Limits.colimMap κ) := Functor.map_mono Limits.colim κ
    let e : Limits.colimit ((Functor.const ℕ).obj T) ≅ T :=
      (Limits.colimit.isColimit ((Functor.const ℕ).obj T)).coconePointUniqueUpToIso
        (Limits.isColimitConstCocone ℕ T)
    have he : ∀ n, Limits.colimit.ι ((Functor.const ℕ).obj T) n ≫ e.hom = 𝟙 T := fun n =>
      (Limits.colimit.isColimit ((Functor.const ℕ).obj T)).comp_coconePointUniqueUpToIso_hom
        (Limits.isColimitConstCocone ℕ T) n
    have hD : Limits.colimit.desc D (Limits.Cocone.mk T κ) = Limits.colimMap κ ≫ e.hom := by
      apply Limits.colimit.hom_ext
      intro n
      rw [Limits.colimit.ι_desc, Limits.ι_colimMap_assoc, he]
      exact (Category.comp_id (κ.app n)).symm
    haveI : Mono (Limits.colimMap κ ≫ e.hom) := mono_comp _ _
    haveI : Mono (Limits.colimit.desc D (Limits.Cocone.mk T κ)) := by
      rw [hD]; infer_instance
    haveI : IsIso (Limits.colimit.desc D (Limits.Cocone.mk T κ)) := isIso_of_mono_of_epi _
    haveI : IsIso ((Limits.colimit.isColimit D).desc (Limits.Cocone.mk T κ)) := by
      rw [Limits.colimit.isColimit_desc]; infer_instance
    exact ⟨Limits.IsColimit.ofPointIso (Limits.colimit.isColimit D)⟩
  have affine_sieve : ∀ (V : (wcP1Over K).left.ProEt) (R : Sieve V),
      (∀ (W₁ : (wcP1Over K).left.ProEt) (f : W₁ ⟶ V), IsAffine W₁.left → R.arrows f) →
      R ∈ Scheme.ProEt.topology (wcP1Over K).left V := by
    intro V R hR
    have hV : WeaklyEtale V.hom := V.prop
    let W₁ : V.left.affineCover.I₀ → (wcP1Over K).left.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (V.left.affineCover.f i ≫ V.hom) inferInstance
    let g : ∀ i, W₁ i ⟶ V := fun i =>
      MorphismProperty.Over.homMk (V.left.affineCover.f i) rfl trivial
    have hPc : Presieve.ofArrows W₁ g ∈
        (Scheme.ProEt.precoverage (wcP1Over K).left).coverings V := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget (wcP1Over K).left ⋙
        Over.forget (wcP1Over K).left) Scheme.proetalePrecoverage).coverings V
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change V.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings V.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage V.left V.left.affineCover.mem₀,
        V.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
    refine GrothendieckTopology.superset_covering _ ?_
      (Precoverage.generate_mem_toGrothendieck hPc)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨i⟩
    exact hR (W₁ i) (g i) (show IsAffine (V.left.affineCover.X i) by infer_instance)
  have hmonoκ : ∀ n, Mono (κ.app n) := fun n => Subobject.arrow_mono _
  have hepi : Epi (Limits.colimit.desc (Monotone.functor hmono ⋙ Subobject.underlying)
      (Limits.Cocone.mk _ κ)) := by
    have hls : Presheaf.IsLocallySurjective (Scheme.ProEt.topology (wcP1Over K).left)
        (Limits.colimit.desc (Monotone.functor hmono ⋙ Subobject.underlying)
          (Limits.Cocone.mk _ κ)).hom := by
      refine ⟨fun {V} s => ?_⟩
      apply affine_sieve V
      intro W₁ f hW₁
      haveI : CompactSpace W₁.left := inferInstance
      obtain ⟨m, t, ht⟩ := hbd W₁ inferInstance
        ((G.obj.map f.op).hom s)
      obtain ⟨e, hnat, -⟩ := proet_free_sheaf_hom_equiv (wcP1Over K).left W₁
      let gs := (e G).symm
        ((G.obj.map f.op).hom s)
      let gt := (e (Subobject.underlying.obj J)).symm t
      have hcomm : gt ≫ J.arrow = gs ≫ ((ℓ ^ m : ℕ) • 𝟙 G) := by
        apply (e G).injective
        rw [hnat, hnat, Equiv.apply_symm_apply, Equiv.apply_symm_apply, hns]
        exact ht
      have hPm := Subobject.isPullback ((ℓ ^ m : ℕ) • 𝟙 G) J
      let g' := hPm.lift gt gs hcomm
      have hg' : g' ≫ κ.app m = gs := hPm.lift_snd _ _ _
      refine ⟨(Limits.colimit.ι (Monotone.functor hmono ⋙ Subobject.underlying) m).hom.app
        (Opposite.op W₁) (e _ g'), ?_⟩
      change (Limits.colimit.ι (Monotone.functor hmono ⋙ Subobject.underlying) m ≫
          Limits.colimit.desc (Monotone.functor hmono ⋙ Subobject.underlying)
            (Limits.Cocone.mk _ κ)).hom.app (Opposite.op W₁) (e _ g') = _
      rw [Limits.colimit.ι_desc]
      change (κ.app m).hom.app (Opposite.op W₁) (e _ g') = _
      rw [← hnat, hg']
      exact Equiv.apply_symm_apply (e G) _
    exact (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp hls
  obtain ⟨hκ⟩ := crit _ _ κ hmonoκ hepi

  have H0 : ∀ (D : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (c : Limits.Cocone D), Limits.IsColimit c →
      ∀ g : wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) ⟶ c.pt,
        ∃ (n : ℕ) (g' : wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) ⟶
          D.obj n), g = g' ≫ c.ι.app n :=
    fun D c hc => (proet_free_hom_seq_colimit (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP) D c hc).1
  have H1lift : ∀ D : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1},
      ∃ (I : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
        (α : D ⟶ I), Mono α ∧ ∀ (c : Limits.Cocone I), Limits.IsColimit c →
          ∀ (k : ℕ) (x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left
            (wcGeomPoint K (wcP1Over K) hP)) c.pt (k + 1)), x = 0 := by
    intro D
    obtain ⟨I, α, hα, hI⟩ := injective_tower_of_tower D
    exact ⟨I, α, hα, fun c hc k x => proet_ext_colimit_injectives_vanish (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP) I hI c hc k x⟩
  have s7 : ∀ {X Y : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      {n : ℕ} (x : Abelian.Ext X Y n) (m : ℕ),
      x.comp (Abelian.Ext.mk₀ (m • 𝟙 Y)) (add_zero n) = m • x := by
    intro X Y n x m
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ m ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
        Abelian.Ext.comp_mk₀_id]
  obtain ⟨N, y', hy⟩ := ext_seq_colimit_lift_of_acyclic
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) H0 H1lift 2
    _ (Limits.Cocone.mk _ κ) hκ y
  refine ⟨N, y'.comp (Abelian.Ext.mk₀
    (Subobject.pullbackπ ((ℓ ^ N : ℕ) • 𝟙 G) J)) (add_zero 2), ?_⟩
  have hw := (Subobject.isPullback ((ℓ ^ N : ℕ) • 𝟙 G) J).w
  rw [← s7 y (ℓ ^ N), hy, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
    Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hw]

theorem wc_vqtt_J_level_kernel (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left)
    (hcov : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (k : ℕ) (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (P : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (hint : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
      ∀ i, ‖P ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1)
    (J : Subobject G)
    (hJ : ∀ (V : (wcP1Over K).left.ProEt) (s : G.obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : (wcP1Over K).left.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖P ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1) :
    ∀ (r : ℕ) (z : wcCohG K (wcP1Over K) hP (Subobject.underlying.obj J) 2),
      z.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))))
        (add_zero 2) = 0 →
      ∃ z' : wcCohG K (wcP1Over K) hP (Subobject.underlying.obj J) 2, z = (ℓ ^ r : ℕ) • z' :=
by

  have s1 : ∀ (X A : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (n d : ℕ), (∀ x : Abelian.Ext X (Limits.kernel (n • 𝟙 A)) (d + 1), x = 0) →
      ∀ z : Abelian.Ext X A d,
        z.comp (Abelian.Ext.mk₀ (Limits.cokernel.π (n • 𝟙 A))) (add_zero d) = 0 →
        ∃ z' : Abelian.Ext X A d, z = n • z' := by
    intro X A n d hvan z hz
    have H : ∀ (m : ℕ) (y : Abelian.Ext X A d),
        y.comp (Abelian.Ext.mk₀ (m • 𝟙 A)) (add_zero d) = m • y := by
      intro m y
      induction m with
      | zero => rw [zero_smul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero, zero_smul]
      | succ m ih =>
        rw [succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih, Abelian.Ext.comp_mk₀_id,
          succ_nsmul]
    let S₁ : ShortComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) :=
      ShortComplex.mk (Limits.kernel.ι (Limits.cokernel.π (n • 𝟙 A)))
        (Limits.cokernel.π (n • 𝟙 A)) (Limits.kernel.condition _)
    have hS₁ : S₁.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel S₁ (Limits.kernelIsKernel _))
        inferInstance inferInstance
    have hz₂ : Limits.kernel.ι (n • 𝟙 A) ≫ Abelian.factorThruImage (n • 𝟙 A) = 0 := by
      rw [← cancel_mono (Abelian.image.ι (n • 𝟙 A)), Category.assoc, Abelian.image.fac,
        Limits.kernel.condition, Limits.zero_comp]
    let S₂ : ShortComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) :=
      ShortComplex.mk (Limits.kernel.ι (n • 𝟙 A)) (Abelian.factorThruImage (n • 𝟙 A)) hz₂
    have hS₂ : S₂.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel S₂
        (Limits.isKernelOfComp (Abelian.image.ι (n • 𝟙 A)) (n • 𝟙 A) (Limits.kernelIsKernel _) hz₂
          (Abelian.image.fac _))) inferInstance inferInstance
    obtain ⟨x, hx⟩ := Abelian.Ext.covariant_sequence_exact₂ X hS₁ z hz
    have h3 : x.comp hS₂.extClass (rfl : d + 1 = d + 1) = 0 := hvan _
    obtain ⟨z', hz'⟩ := Abelian.Ext.covariant_sequence_exact₃ X hS₂ x rfl h3
    have hx' : x.comp (Abelian.Ext.mk₀ (Abelian.image.ι (n • 𝟙 A))) (add_zero d) = z := hx
    have hz'' : z'.comp (Abelian.Ext.mk₀ (Abelian.factorThruImage (n • 𝟙 A))) (add_zero d) = x :=
      hz'
    refine ⟨z', ?_⟩
    rw [← hx', ← hz'', Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Abelian.image.fac, H]

  have s2 : ∀ (n : ℕ), n ≠ 0 →
      ∀ (L : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}),
      (L.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℤ_[ℓ])).over W) →
      Limits.IsZero ((Limits.kernel (n • 𝟙 L)).over W) := by
    intro n hn L ψ
    have hall : ∀ (U : (Over W)ᵒᵖ)
        (s : (Limits.kernel (n • 𝟙 L)).obj.obj (Opposite.op U.unop.left)), s = 0 := by
      intro U s
      have hmono : Mono ((Limits.kernel.ι (n • 𝟙 L)).hom.app (Opposite.op U.unop.left)) := by
        have : Mono (Limits.kernel.ι (n • 𝟙 L)).hom :=
          (Sheaf.Hom.mono_iff_presheaf_mono (Scheme.ProEt.topology (wcP1Over K).left)
            AddCommGrpCat.{u+1} _).1 inferInstance
        exact (NatTrans.mono_iff_mono_app _).1 this _
      have hinj : Function.Injective
          ((Limits.kernel.ι (n • 𝟙 L)).hom.app (Opposite.op U.unop.left)).hom :=
        (AddCommGrpCat.mono_iff_injective _).mp hmono
      set y := ((Limits.kernel.ι (n • 𝟙 L)).hom.app (Opposite.op U.unop.left)).hom s with hy
      have hny : n • y = 0 := by
        have h1 := congrArg (fun f => ((sheafToPresheaf (Scheme.ProEt.topology (wcP1Over K).left)
          AddCommGrpCat.{u+1}).map f).app (Opposite.op U.unop.left))
          (Limits.kernel.condition (n • 𝟙 L))
        simp only [Functor.map_comp, Functor.map_nsmul, Functor.map_zero,
          NatTrans.comp_app, NatTrans.app_nsmul, NatTrans.app_zero] at h1
        have h2 := congrArg (fun f => f.hom s) h1
        simpa using h2
      let ψU := ((sheafToPresheaf ((Scheme.ProEt.topology (wcP1Over K).left).over W)
        AddCommGrpCat.{u+1}).mapIso ψ).app U
      have hψinj : Function.Injective ψU.hom.hom :=
        ψU.addCommGroupIsoToAddEquiv.injective
      let y' : ((sheafToPresheaf ((Scheme.ProEt.topology (wcP1Over K).left).over W)
        AddCommGrpCat.{u+1}).obj (L.over W)).obj U := y
      have hny' : n • y' = 0 := hny
      set f := ψU.hom.hom y' with hf
      have hnf : n • f = 0 := by rw [hf, ← map_nsmul, hny', map_zero]
      have hg : n • (show C(↥U.unop.left.left, Fin k → ℤ_[ℓ]) from f.down) = 0 :=
        congrArg ULift.down hnf
      have hg0 : (show C(↥U.unop.left.left, Fin k → ℤ_[ℓ]) from f.down) = 0 := by
        ext p i
        have h1 := congrFun (DFunLike.congr_fun hg p) i
        simp only [ContinuousMap.coe_nsmul, Pi.smul_apply, ContinuousMap.coe_zero, Pi.zero_apply,
          nsmul_eq_mul] at h1 ⊢
        exact (mul_eq_zero.mp h1).resolve_left (Nat.cast_ne_zero.mpr hn)
      have hf0 : f = 0 := ULift.ext _ _ hg0
      have hy0 : y' = 0 := hψinj (by rw [map_zero]; exact hf0)
      exact hinj (by rw [map_zero]; exact hy0)
    rw [Limits.IsZero.iff_id_eq_zero]
    apply Sheaf.hom_ext
    ext U s
    exact (hall U _).trans (hall U _).symm

  intro r z hz
  have hn : ℓ ^ r ≠ 0 := pow_ne_zero r (Fact.out : ℓ.Prime).ne_zero
  obtain ⟨ψ, -⟩ := wc_qclift_integral_frame (wcP1Over K).left ℓ G W k θ P hint J hJ
  have hZ := s2 (ℓ ^ r) hn (Subobject.underlying.obj J) ψ
  have hK := wc_P1_offS_sections_zero_of_over_zero K hP m S W w hqc hcov _ hZ
