  refine ⟨AddEquiv.ofBijective θh ⟨hθinj, hθsurj⟩,
    ((ρ g : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))), rfl, ?_⟩
  intro s
  refine (hiter (e / d) s z₀).trans ?_
  rw [e2, hΨeq']
  show Matrix.vecMul (Ψ s z₀) _ = Matrix.vecMul (Ψ s z₀) _
