        refine (cancel_mono ιC).1 ?_
        rw [Category.assoc, hb, reassoc_of% ha, hp, hc]
      refine ab _ _ _ Limits.equalizer.ι_mono _ _ _ _ _ _ (twF u hu k) (twF v hv k) (twF (u ≫ v) _ k) ?_
