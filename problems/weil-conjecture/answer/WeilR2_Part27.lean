  obtain ⟨hAct, hAN, hAF, hAI⟩ := wcU_sms_bar_relinj ℓ Γ n hn P
  have hInj : ∀ k, wcChmpInjD (fun x => wcCxJMap K hP (lamI x)) k := fun k =>
    wc_chmp_res_ring_injective (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)
