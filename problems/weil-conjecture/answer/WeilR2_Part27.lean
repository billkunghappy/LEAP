  have hbd : ∀ (V : (wcP1Over K).left.ProEt), CompactSpace V.left →
      ∀ s : G.obj.obj (Opposite.op V),
      ∃ (e₀ : ℕ) (t : (Subobject.underlying.obj J).obj.obj (Opposite.op V)),
        (J.arrow.hom.app (Opposite.op V)).hom t = (ℓ ^ e₀ : ℕ) • s := by
    intro V hV s
    haveI := hV
    haveI := hW
    haveI hVp : WeaklyEtale V.hom := V.prop
    haveI hWp : WeaklyEtale W.hom := W.prop
    let p₁ := Limits.pullback.fst V.hom W.hom
    let p₂ := Limits.pullback.snd V.hom W.hom
    haveI : WeaklyEtale p₁ := inferInstance
    haveI : WeaklyEtale (p₁ ≫ V.hom) := inferInstance
    let Zl : (wcP1Over K).left.ProEt := Scheme.ProEt.mk (p₁ ≫ V.hom)
    have e₂ : p₂ ≫ W.hom = Zl.hom := by
      show p₂ ≫ W.hom = p₁ ≫ V.hom
      exact Limits.pullback.condition.symm
    let P₁ : Zl ⟶ V := MorphismProperty.Over.homMk p₁ rfl trivial
    let P₂ : Zl ⟶ W := MorphismProperty.Over.homMk p₂ e₂ trivial
    haveI hqp : QuasiCompact p₁ := inferInstance
    haveI hZc : CompactSpace (Limits.pullback V.hom W.hom : Scheme) :=
      @QuasiCompact.compactSpace_of_compactSpace _ _ p₁ hqp hV
    haveI hZc' : CompactSpace ↥Zl.left := hZc
    let s₁ : G.obj.obj (Opposite.op Zl) :=
      (G.obj.map P₁.op).hom s
    let fz : C(↥Zl.left, Fin k → ℚ_[ℓ]) :=
      (show C(↥Zl.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk P₂))).hom s₁).down)
    obtain ⟨C, hC⟩ := (isCompact_univ (X := ↥Zl.left)).exists_bound_of_continuousOn
      ((LinearMap.continuous_of_finiteDimensional Pm.toLinearMap).comp fz.continuous).continuousOn
    have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := Nat.one_lt_cast.mpr (Fact.out : Nat.Prime ℓ).one_lt
    obtain ⟨e₀, he₀⟩ := pow_unbounded_of_one_lt C hℓ1
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ e₀ := pow_pos (by linarith) e₀
    refine ⟨e₀, (hJ V ((ℓ ^ e₀ : ℕ) • s)).2 ?_⟩
    intro V' c b z ι
    have hcV : c.left ≫ V.hom = V'.hom := MorphismProperty.Over.w c
    have hbW : b.left ≫ W.hom = V'.hom := MorphismProperty.Over.w b
    let h : V'.left ⟶ Limits.pullback V.hom W.hom :=
      Limits.pullback.lift c.left b.left (hcV.trans hbW.symm)
    have hh1 : h ≫ p₁ = c.left := Limits.pullback.lift_fst _ _ _
    have hh2 : h ≫ p₂ = b.left := Limits.pullback.lift_snd _ _ _
    have eh : h ≫ Zl.hom = V'.hom := by
