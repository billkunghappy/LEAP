    refine ⟨?_, ?_⟩
    · intro h₁ h₂ hh
      ext q
      obtain ⟨y, hy, hqy⟩ := s2 q
      have e1 : h₁ q = h₁ y := (hqy.map h₁.continuous).eq
      have e2 : h₂ q = h₂ y := (hqy.map h₂.continuous).eq
      have e3 : h₁ y = h₂ y := congrFun hh ⟨y, (memFib y).1 hy⟩
      rw [e1, e2, e3]
    · intro c
      have hDfin : Finite {z : Q // e.hom (f z) = IsLocalRing.closedPoint A} := by
        haveI := hFibfin.to_subtype
        exact Finite.of_equiv _ (Equiv.subtypeEquivRight memFib)
      haveI := Fintype.ofFinite {z : Q // e.hom (f z) = IsLocalRing.closedPoint A}
      have hsplit : ∀ d : {z : Q // e.hom (f z) = IsLocalRing.closedPoint A},
