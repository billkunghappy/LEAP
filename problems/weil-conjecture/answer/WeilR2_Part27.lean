        fun l => f l.castSucc.castSucc := by
      funext l
      have h := l.is_lt
      simp only [wcSpfMerge, Fin.val_last, Fin.val_castSucc]
      rw [if_pos h]
    simp only [wcSpfBarM, wcSpfBarR, Category.assoc, Limits.Pi.lift_comp_π,
      Preadditive.comp_sum, Preadditive.comp_nsmul]
    rw [e2, e3]
    simp only [wcSpfRhoEnt, Equiv.symm_apply_apply]
    exact key _ _ j _
  have hdec : ∀ p, wcSpfBarD A lamA ρ p = wcSpfBarL A lamA ρ p +
      ∑ k : Fin p, ((-1 : ℤ) ^ ((k : ℕ) + 1)) • wcSpfBarM A lamA ρ p k +
      ((-1 : ℤ) ^ (p + 1)) • wcSpfBarR A lamA ρ p := by
    intro p
    apply Limits.Pi.hom_ext; intro fj
    simp only [wcSpfBarD, wcSpfBarL, wcSpfBarM, wcSpfBarR, Preadditive.add_comp,
      Preadditive.sum_comp, Preadditive.zsmul_comp, Limits.Pi.lift_comp_π]
  refine ⟨fun p => ?_, hdeg0.1, hdeg0.2⟩
  rw [hdec p, hdec (p + 1)]
  exact gen_d2 (fun q => wcSpfBar A lamA ρ q) (wcSpfBarL A lamA ρ) (wcSpfBarR A lamA ρ)
    (wcSpfBarM A lamA ρ) tL1 tL2 tL3 tM4 tM5 tRR p

theorem wcSpfR_bar_natural {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {Γ : Type u} [Group Γ] [Fintype Γ] {n r : ℕ} (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n)))
    {A B : 𝒜} (lamA : MonoidAlgebra ℤ_[ℓ] Γ → (A ⟶ A)) (lamB : MonoidAlgebra ℤ_[ℓ] Γ → (B ⟶ B))
    (f : A ⟶ B)
    (hf : ∀ g : Γ, lamA (MonoidAlgebra.single g 1) ≫ f = f ≫ lamB (MonoidAlgebra.single g 1)) :
    (∀ p, (Limits.Pi.map (fun _ => f) : wcSpfBar A lamA ρ p ⟶ wcSpfBar B lamB ρ p) ≫
        wcSpfBarD B lamB ρ p =
      wcSpfBarD A lamA ρ p ≫
        (Limits.Pi.map (fun _ => f) : wcSpfBar A lamA ρ (p + 1) ⟶ wcSpfBar B lamB ρ (p + 1))) ∧
    wcSpfTwMap lamA lamB ρ f hf ≫ wcSpfBarEps B lamB ρ =
      wcSpfBarEps A lamA ρ ≫ (Limits.Pi.map (fun _ => f) : wcSpfBar A lamA ρ 0 ⟶ wcSpfBar B lamB ρ 0) :=
by
  refine ⟨fun p => ?_, ?_⟩
  · apply Limits.Pi.hom_ext
    intro fj
    simp only [wcSpfBarD, Category.assoc, Limits.Pi.lift_comp_π, Limits.Pi.map_π,
      Limits.Pi.map_π_assoc, Limits.Pi.lift_comp_π_assoc, Preadditive.add_comp,
      Preadditive.comp_add, Preadditive.sum_comp, Preadditive.comp_sum, Preadditive.zsmul_comp,
      Preadditive.comp_zsmul, Preadditive.nsmul_comp, Preadditive.comp_nsmul, hf]
  · apply Limits.Pi.hom_ext
    intro fj
    have hF : wcSpfTwMap lamA lamB ρ f hf ≫ Limits.kernel.ι (wcSpfTwD B lamB ρ) =
        Limits.kernel.ι (wcSpfTwD A lamA ρ) ≫ Limits.Pi.map (fun _ => f) :=
      Limits.kernel.lift_ι _ _ _
    have key : ∀ {T T' PA PB QA QB : 𝒜} (M : T ⟶ T') (ιA : T ⟶ PA) (ιB : T' ⟶ PB)
        (mP : PA ⟶ PB) (LA : PA ⟶ QA) (LB : PB ⟶ QB) (mQ : QA ⟶ QB) (πA : QA ⟶ A)
        (πB : QB ⟶ B) (pA : PA ⟶ A) (pB : PB ⟶ B), M ≫ ιB = ιA ≫ mP → LB ≫ πB = pB →
        LA ≫ πA = pA → mP ≫ pB = pA ≫ f → mQ ≫ πB = πA ≫ f →
        (M ≫ (ιB ≫ LB)) ≫ πB = ((ιA ≫ LA) ≫ mQ) ≫ πB := by
      intro T T' PA PB QA QB M ιA ιB mP LA LB mQ πA πB pA pB hM hB hA hP hQ
      simp only [Category.assoc, hB, reassoc_of% hM, hP, hQ, reassoc_of% hA]
    exact key (wcSpfTwMap lamA lamB ρ f hf) (Limits.kernel.ι (wcSpfTwD A lamA ρ))
      (Limits.kernel.ι (wcSpfTwD B lamB ρ)) (Limits.Pi.map (fun _ : Fin r => f))
      (Limits.Pi.lift (fun fj : (Fin 0 → Fin (Fintype.card Γ)) × Fin r =>
        Limits.Pi.π (fun _ : Fin r => A) fj.2))
      (Limits.Pi.lift (fun fj : (Fin 0 → Fin (Fintype.card Γ)) × Fin r =>
        Limits.Pi.π (fun _ : Fin r => B) fj.2))
      (Limits.Pi.map (fun _ : (Fin 0 → Fin (Fintype.card Γ)) × Fin r => f))
      (Limits.Pi.π (fun _ : (Fin 0 → Fin (Fintype.card Γ)) × Fin r => A) fj)
      (Limits.Pi.π (fun _ : (Fin 0 → Fin (Fintype.card Γ)) × Fin r => B) fj)
      (Limits.Pi.π (fun _ : Fin r => A) fj.2) (Limits.Pi.π (fun _ : Fin r => B) fj.2)
      hF (Limits.Pi.lift_comp_π _ _) (Limits.Pi.lift_comp_π _ _) (Limits.Pi.map_π _ _)
      (Limits.Pi.map_π _ _)

theorem wcSpfR_bar_relinj_exact {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    {Γ : Type u} [Group Γ] [Fintype Γ] (n r : ℕ) (hn : 1 ≤ n)
    (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (A : 𝒜) (lamA : MonoidAlgebra ℤ_[ℓ] Γ → (A ⟶ A))
    (hlam : wcRingAct lamA) (htor : ((ℓ ^ n : ℕ) : ℤ) • 𝟙 A = 0)
    (hrel : wcSpfRelInj (ℓ ^ n) lamA)
    (hdd : ∀ p, wcSpfBarD A lamA ρ p ≫ wcSpfBarD A lamA ρ (p + 1) = 0) :
    ∀ p, (ShortComplex.mk _ _ (hdd p)).Exact :=
by
  classical

  have hlam0 : lamA 0 = 0 := by
    have h := hlam.2.1 0 0
    rw [add_zero] at h
    simpa using h
  obtain ⟨σ, hσ⟩ : ∃ σ : ℤ_[ℓ] → (A ⟶ A), ∀ a, σ a = lamA (MonoidAlgebra.single 1 a) :=
    ⟨_, fun _ => rfl⟩
  have hσ0 : σ 0 = 0 := by rw [hσ, MonoidAlgebra.single_zero, hlam0]
  have hσ1 : σ 1 = 𝟙 A := by rw [hσ, ← MonoidAlgebra.one_def, hlam.1]
  have hσadd : ∀ a b, σ (a + b) = σ a + σ b := by
    intro a b; rw [hσ, hσ, hσ, MonoidAlgebra.single_add, hlam.2.1]
  have hσmul : ∀ a b, σ (a * b) = σ b ≫ σ a := by
    intro a b; rw [hσ, hσ, hσ, ← hlam.2.2, MonoidAlgebra.single_mul_single, mul_one]

  obtain ⟨lamC, hlamC⟩ : ∃ lamC : MonoidAlgebra ℤ_[ℓ] Γ →
      ((∏ᶜ fun _ : Γ => A) ⟶ (∏ᶜ fun _ : Γ => A)), ∀ x h,
      lamC x ≫ Limits.Pi.π (fun _ : Γ => A) h =
        ∑ g : Γ, Limits.Pi.π (fun _ : Γ => A) (h * g) ≫ σ (x.coeff g) :=
    ⟨fun x => Limits.Pi.lift (fun h => ∑ g : Γ, Limits.Pi.π (fun _ : Γ => A) (h * g) ≫
      σ (x.coeff g)), fun x h => by simp only [Limits.Pi.lift_comp_π]⟩
  have hF1 : ∀ (g : Γ) (a : ℤ_[ℓ]) (h : Γ), lamC (MonoidAlgebra.single g a) ≫
      Limits.Pi.π (fun _ : Γ => A) h = Limits.Pi.π (fun _ : Γ => A) (h * g) ≫ σ a := by
    intro g a h
    rw [hlamC, Finset.sum_eq_single g]
    · rw [MonoidAlgebra.coeff_single_apply, if_pos rfl]
    · intro g' _ hg'
      rw [MonoidAlgebra.coeff_single_apply, if_neg (Ne.symm hg'), hσ0, Limits.comp_zero]
    · intro hg; exact absurd (Finset.mem_univ g) hg
  have hC1 : ∀ g h : Γ, lamC (MonoidAlgebra.single g 1) ≫ Limits.Pi.π (fun _ : Γ => A) h =
      Limits.Pi.π (fun _ : Γ => A) (h * g) := fun g h => by
    rw [hF1, hσ1, Category.comp_id]
  have hlamCadd : ∀ x y, lamC (x + y) = lamC x + lamC y := by
    intro x y
    apply Limits.Pi.hom_ext
    intro h
    rw [Preadditive.add_comp, hlamC, hlamC, hlamC, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun g _ => ?_)
    simp only [MonoidAlgebra.coeff_add, Finsupp.add_apply, Pi.add_apply]
    rw [hσadd, Preadditive.comp_add]
  have hlamC0 : lamC 0 = 0 := by
    have h := hlamCadd 0 0
    rw [add_zero] at h
    simpa using h
  have hlamC1 : lamC 1 = 𝟙 _ := by
    apply Limits.Pi.hom_ext
    intro h
    rw [MonoidAlgebra.one_def, hF1, mul_one, hσ1, Category.comp_id, Category.id_comp]
  have hlamCmul : ∀ x y, lamC (x * y) = lamC y ≫ lamC x := by
    intro x
    induction x using MonoidAlgebra.induction_linear with
    | zero => intro y; rw [zero_mul, hlamC0, Limits.comp_zero]
    | add x x' hx hx' =>
      intro y; rw [add_mul, hlamCadd, hx, hx', hlamCadd, Preadditive.comp_add]
    | single g a =>
      intro y
      induction y using MonoidAlgebra.induction_linear with
      | zero => rw [mul_zero, hlamC0, Limits.zero_comp]
      | add y y' hy hy' => rw [mul_add, hlamCadd, hy, hy', hlamCadd, Preadditive.add_comp]
      | single g' b =>
        rw [MonoidAlgebra.single_mul_single]
        apply Limits.Pi.hom_ext
        intro h
        rw [hF1, Category.assoc, hF1, reassoc_of% (hF1 g' b (h * g)), ← hσmul, mul_assoc]
  have hlamCact : wcRingAct lamC := ⟨hlamC1, hlamCadd, hlamCmul⟩
  have hCtor : ((ℓ ^ n : ℕ) : ℤ) • 𝟙 (∏ᶜ fun _ : Γ => A) = 0 := by
    apply Limits.Pi.hom_ext
    intro h
    rw [Preadditive.zsmul_comp, Category.id_comp, Limits.zero_comp,
      ← Category.comp_id (Limits.Pi.π (fun _ : Γ => A) h), ← Preadditive.comp_zsmul, htor,
      Limits.comp_zero]

  obtain ⟨i, hi⟩ : ∃ i : A ⟶ ∏ᶜ fun _ : Γ => A, ∀ h,
      i ≫ Limits.Pi.π (fun _ : Γ => A) h = lamA (MonoidAlgebra.single h 1) :=
    ⟨Limits.Pi.lift (fun h => lamA (MonoidAlgebra.single h 1)), fun h => by
      simp only [Limits.Pi.lift_comp_π]⟩
  have hi1 : i ≫ Limits.Pi.π (fun _ : Γ => A) 1 = 𝟙 A := by
    rw [hi, ← MonoidAlgebra.one_def, hlam.1]
  have himono : Mono i := mono_of_mono_fac hi1
  have hE : ∀ x, lamA x ≫ i = i ≫ lamC x := by
    intro x
    induction x using MonoidAlgebra.induction_linear with
    | zero => rw [hlam0, hlamC0, Limits.zero_comp, Limits.comp_zero]
    | add x y hx hy =>
      rw [hlam.2.1, hlamCadd, Preadditive.add_comp, Preadditive.comp_add, hx, hy]
    | single g a =>
      apply Limits.Pi.hom_ext
      intro h
      rw [Category.assoc, Category.assoc, hi, hF1, reassoc_of% (hi (h * g)), hσ, ← hlam.2.2,
        ← hlam.2.2, MonoidAlgebra.single_mul_single, MonoidAlgebra.single_mul_single]
      simp only [one_mul, mul_one]
  obtain ⟨ret, hir, hret⟩ := hrel i himono hCtor lamA lamC hlam hlamCact hE (𝟙 A)
    (fun x => by rw [Category.comp_id, Category.id_comp])

  have hm0 : ∀ {q : ℕ} (a : Fin (Fintype.card Γ)) (u : Fin (q + 1) → Fin (Fintype.card Γ)),
      wcSpfMerge Γ (Fin.cons a u : Fin (q + 2) → Fin (Fintype.card Γ)) 0 =
        Fin.cons (Fintype.equivFin Γ ((Fintype.equivFin Γ).symm a *
          (Fintype.equivFin Γ).symm (u 0))) (fun i => u i.succ) := by
    intro q a u
    funext k
    induction k using Fin.cases with
    | zero => simp [wcSpfMerge]
    | succ k => simp [wcSpfMerge]
  have hmS : ∀ {q : ℕ} (a : Fin (Fintype.card Γ)) (u : Fin (q + 1) → Fin (Fintype.card Γ))
      (k : Fin q), wcSpfMerge Γ (Fin.cons a u : Fin (q + 2) → Fin (Fintype.card Γ)) k.succ =
        Fin.cons a (wcSpfMerge Γ u k) := by
    intro q a u k
    funext m
    induction m using Fin.cases with
    | zero => simp [wcSpfMerge]
    | succ m => simp [wcSpfMerge, ← Fin.succ_castSucc]
  have hinit : ∀ {q : ℕ} (a : Fin (Fintype.card Γ)) (u : Fin (q + 1) → Fin (Fintype.card Γ)),
      (fun l : Fin (q + 1) => (Fin.cons a u : Fin (q + 2) → Fin (Fintype.card Γ)) l.castSucc) =
        Fin.cons a (fun l : Fin q => u l.castSucc) := by
    intro q a u
    funext m
    induction m using Fin.cases with
    | zero => simp
    | succ m => simp [← Fin.succ_castSucc]

  obtain ⟨s, hs⟩ : ∃ s : ∀ q : ℕ, wcSpfBar (∏ᶜ fun _ : Γ => A) lamC ρ (q + 1) ⟶
      wcSpfBar (∏ᶜ fun _ : Γ => A) lamC ρ q,
      ∀ (q : ℕ) (u : Fin q → Fin (Fintype.card Γ)) (j : Fin r) (h : Γ),
        s q ≫ Limits.Pi.π (fun _ : (Fin q → Fin (Fintype.card Γ)) × Fin r =>
          (∏ᶜ fun _ : Γ => A)) (u, j) ≫ Limits.Pi.π (fun _ : Γ => A) h =
        Limits.Pi.π (fun _ : (Fin (q + 1) → Fin (Fintype.card Γ)) × Fin r =>
          (∏ᶜ fun _ : Γ => A))
          ((Fin.cons (Fintype.equivFin Γ h) u : Fin (q + 1) → Fin (Fintype.card Γ)), j) ≫
          Limits.Pi.π (fun _ : Γ => A) 1 :=
    ⟨fun q => Limits.Pi.lift (fun uj : (Fin q → Fin (Fintype.card Γ)) × Fin r =>
      Limits.Pi.lift (fun h : Γ => Limits.Pi.π
        (fun _ : (Fin (q + 1) → Fin (Fintype.card Γ)) × Fin r => (∏ᶜ fun _ : Γ => A))
        ((Fin.cons (Fintype.equivFin Γ h) uj.1 : Fin (q + 1) → Fin (Fintype.card Γ)), uj.2) ≫
        Limits.Pi.π (fun _ : Γ => A) 1)),
     fun q u j h => by simp only [← Category.assoc, Limits.Pi.lift_comp_π]⟩
  have hdπ : ∀ (q : ℕ) (u : Fin (q + 1) → Fin (Fintype.card Γ)) (j : Fin r),
      wcSpfBarD (∏ᶜ fun _ : Γ => A) lamC ρ q ≫
        Limits.Pi.π (fun _ : (Fin (q + 1) → Fin (Fintype.card Γ)) × Fin r =>
          (∏ᶜ fun _ : Γ => A)) (u, j) =
      Limits.Pi.π (fun _ : (Fin q → Fin (Fintype.card Γ)) × Fin r => (∏ᶜ fun _ : Γ => A))
          (fun i => u i.succ, j) ≫
        lamC (MonoidAlgebra.single ((Fintype.equivFin Γ).symm (u 0)) 1) +
      ∑ k : Fin q, ((-1 : ℤ) ^ ((k : ℕ) + 1)) •
        Limits.Pi.π (fun _ : (Fin q → Fin (Fintype.card Γ)) × Fin r => (∏ᶜ fun _ : Γ => A))
          (wcSpfMerge Γ u k, j) +
      ((-1 : ℤ) ^ (q + 1)) • ∑ i : Fin r, wcSpfRhoEnt ρ (u (Fin.last q)) i j •
        Limits.Pi.π (fun _ : (Fin q → Fin (Fintype.card Γ)) × Fin r => (∏ᶜ fun _ : Γ => A))
          (fun l => u l.castSucc, i) :=
    fun q u j => by
      first
        | exact Limits.Pi.lift_comp_π _ _
        | simp only [wcSpfBarD, Limits.Pi.lift_comp_π]
  have hcontr : ∀ p : ℕ, s p ≫ wcSpfBarD (∏ᶜ fun _ : Γ => A) lamC ρ p +
      wcSpfBarD (∏ᶜ fun _ : Γ => A) lamC ρ (p + 1) ≫ s (p + 1) = 𝟙 _ := by
    intro p
    apply Limits.Pi.hom_ext
    rintro ⟨f, j⟩
    apply Limits.Pi.hom_ext
    intro h
    simp only [Category.assoc, Preadditive.add_comp, Category.id_comp]
    rw [reassoc_of% (hdπ p f j), hs (p + 1) f j h,
      reassoc_of% (hdπ (p + 1) (Fin.cons (Fintype.equivFin Γ h) f) j),
      hinit (Fintype.equivFin Γ h) f, Fin.sum_univ_succ]
    simp only [Preadditive.add_comp, Preadditive.comp_add, Preadditive.sum_comp,
      Preadditive.comp_sum, Preadditive.zsmul_comp, Preadditive.comp_zsmul,
      Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.assoc, hC1, hs, hm0, hmS,
      Fin.cons_zero, Fin.cons_succ, Fin.cons_last, Equiv.symm_apply_apply, one_mul,
      Fin.val_zero, Fin.val_succ]
    simp only [pow_succ, pow_zero, one_mul, mul_neg, mul_one, neg_neg, neg_smul, one_smul,
      Finset.sum_neg_distrib, zero_add]
    abel

  have hnat : ∀ {B B' : 𝒜} (lB : MonoidAlgebra ℤ_[ℓ] Γ → (B ⟶ B))
      (lB' : MonoidAlgebra ℤ_[ℓ] Γ → (B' ⟶ B')) (f : B ⟶ B')
      (_ : ∀ g : Γ, lB (MonoidAlgebra.single g 1) ≫ f = f ≫ lB' (MonoidAlgebra.single g 1))
      (p : ℕ), (Limits.Pi.map (fun _ => f) : wcSpfBar B lB ρ p ⟶ wcSpfBar B' lB' ρ p) ≫
        wcSpfBarD B' lB' ρ p =
      wcSpfBarD B lB ρ p ≫
        (Limits.Pi.map (fun _ => f) : wcSpfBar B lB ρ (p + 1) ⟶ wcSpfBar B' lB' ρ (p + 1)) := by
    intro B B' lB lB' f hf p
    apply Limits.Pi.hom_ext
    intro fj
    simp only [wcSpfBarD, Category.assoc, Limits.Pi.lift_comp_π, Limits.Pi.map_π,
      Limits.Pi.map_π_assoc, Limits.Pi.lift_comp_π_assoc, Preadditive.add_comp,
      Preadditive.comp_add, Preadditive.sum_comp, Preadditive.comp_sum, Preadditive.zsmul_comp,
      Preadditive.comp_zsmul, Preadditive.nsmul_comp, Preadditive.comp_nsmul, hf]
  have hNi := hnat lamA lamC i (fun g => hE _)
  have hNr := hnat lamC lamA ret (fun g => hret _)
  have hIR : ∀ q, (Limits.Pi.map (fun _ => i) : wcSpfBar A lamA ρ q ⟶
      wcSpfBar (∏ᶜ fun _ : Γ => A) lamC ρ q) ≫
      (Limits.Pi.map (fun _ => ret) : wcSpfBar (∏ᶜ fun _ : Γ => A) lamC ρ q ⟶
        wcSpfBar A lamA ρ q) = 𝟙 _ := by
    intro q
    rw [Limits.Pi.map_comp_map, hir, Limits.Pi.map_id]
  intro p
  rw [ShortComplex.exact_iff_exact_up_to_refinements]
  intro X x₂ hx₂
  change x₂ ≫ wcSpfBarD A lamA ρ (p + 1) = 0 at hx₂
  refine ⟨X, 𝟙 X, inferInstance, x₂ ≫ (Limits.Pi.map (fun _ => i) : wcSpfBar A lamA ρ (p + 1) ⟶
      wcSpfBar (∏ᶜ fun _ : Γ => A) lamC ρ (p + 1)) ≫ s p ≫
      (Limits.Pi.map (fun _ => ret) : wcSpfBar (∏ᶜ fun _ : Γ => A) lamC ρ p ⟶
        wcSpfBar A lamA ρ p), ?_⟩
  change 𝟙 X ≫ x₂ = _ ≫ wcSpfBarD A lamA ρ p
  have hsd : s p ≫ wcSpfBarD (∏ᶜ fun _ : Γ => A) lamC ρ p =
      𝟙 _ - wcSpfBarD (∏ᶜ fun _ : Γ => A) lamC ρ (p + 1) ≫ s (p + 1) :=
    eq_sub_of_add_eq (hcontr p)
  rw [Category.id_comp]
  simp only [Category.assoc]
  rw [hNr p, reassoc_of% hsd, Preadditive.sub_comp, Category.id_comp, Category.assoc,
    Preadditive.comp_sub, Preadditive.comp_sub, hIR (p + 1), reassoc_of% (hNi (p + 1)),
    reassoc_of% hx₂, Limits.zero_comp, Category.comp_id, sub_zero]

theorem wcSpfC_coind_homotopy : ∀ {ℓ : ℕ} {Γ : Type u} [Group Γ] [Fintype Γ] {n r : ℕ}
    (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) {M A : Type*} [AddCommGroup M] [AddCommGroup A]
    (act : Γ → (M →+ M)) (hact : ∀ g h : Γ, act (g * h) = (act g).comp (act h))
    (πA : M →+ A) (hbij : Function.Bijective (fun (x : M) (g : Γ) => πA (act g x))),
    ∃ s : ∀ q : ℕ, (((Fin (q + 1) → Fin (Fintype.card Γ)) × Fin r) → M) →+
        (((Fin q → Fin (Fintype.card Γ)) × Fin r) → M),
      ∀ (q : ℕ) (ψ : (Fin (q + 1) → Fin (Fintype.card Γ)) × Fin r → M),
        ψ = wcSpfModBarD act ρ q (s q ψ) + s (q + 1) (wcSpfModBarD act ρ (q + 1) ψ) :=
by
  intro ℓ Γ _ _ n r ρ M A _ _ act hact πA hbij
  classical

  let Φ : M →+ (Γ → A) := AddMonoidHom.mk' (fun x g => πA (act g x))
    (fun x y => by funext g; simp only [map_add, Pi.add_apply])
  have hΦb : Function.Bijective Φ := hbij
  let Φe : M ≃+ (Γ → A) := AddEquiv.ofBijective Φ hΦb
  have Φ1 : ∀ (φ : Γ → A) (g : Γ), πA (act g (Φe.symm φ)) = φ g := by
    intro φ g
    exact congrFun (Φe.apply_symm_apply φ) g
  have Φ2 : ∀ x y : M, (∀ g, πA (act g x) = πA (act g y)) → x = y := by
    intro x y h
    exact hbij.1 (funext h)
  have hact' : ∀ (g h : Γ) (x : M), act g (act h x) = act (g * h) x := by
    intro g h x
    rw [hact]
    rfl

  let s : ∀ q : ℕ, (((Fin (q + 1) → Fin (Fintype.card Γ)) × Fin r) → M) →+
      (((Fin q → Fin (Fintype.card Γ)) × Fin r) → M) := fun q =>
    AddMonoidHom.mk' (fun ψ fj => Φe.symm (fun h => πA (ψ ((Fin.cons (Fintype.equivFin Γ h) fj.1 :
        Fin (q + 1) → Fin (Fintype.card Γ)), fj.2))))
      (fun ψ ψ' => by
        funext fj
        simp only [Pi.add_apply, map_add]
        rw [← map_add]
        rfl)
  have KEY : ∀ (q : ℕ) (ψ : (Fin (q + 1) → Fin (Fintype.card Γ)) × Fin r → M)
      (f : Fin q → Fin (Fintype.card Γ)) (j : Fin r) (g : Γ),
      πA (act g (s q ψ (f, j))) =
        πA (ψ ((Fin.cons (Fintype.equivFin Γ g) f : Fin (q + 1) → Fin (Fintype.card Γ)), j)) := by
    intro q ψ f j g
    exact Φ1 _ g

  have hm0 : ∀ {q : ℕ} (a : Fin (Fintype.card Γ)) (f : Fin (q + 1) → Fin (Fintype.card Γ)),
      wcSpfMerge Γ (Fin.cons a f : Fin (q + 2) → Fin (Fintype.card Γ)) 0 =
        Fin.cons (Fintype.equivFin Γ ((Fintype.equivFin Γ).symm a * (Fintype.equivFin Γ).symm (f 0)))
          (fun i => f i.succ) := by
    intro q a f
    funext k
    induction k using Fin.cases with
    | zero => simp [wcSpfMerge]
    | succ k => simp [wcSpfMerge]
  have hS : ∀ {q : ℕ} (a : Fin (Fintype.card Γ)) (f : Fin (q + 1) → Fin (Fintype.card Γ))
      (k : Fin q), wcSpfMerge Γ (Fin.cons a f : Fin (q + 2) → Fin (Fintype.card Γ)) k.succ =
        Fin.cons a (wcSpfMerge Γ f k) := by
    intro q a f k
    funext m
    induction m using Fin.cases with
    | zero => simp [wcSpfMerge]
    | succ m => simp [wcSpfMerge, ← Fin.succ_castSucc]
  have hI : ∀ {q : ℕ} (a : Fin (Fintype.card Γ)) (f : Fin (q + 1) → Fin (Fintype.card Γ))
      (l : Fin (q + 1)), (Fin.cons a f : Fin (q + 2) → Fin (Fintype.card Γ)) l.castSucc =
        (Fin.cons a (fun l : Fin q => f l.castSucc) : Fin (q + 1) → Fin (Fintype.card Γ)) l := by
    intro q a f l
    induction l using Fin.cases with
    | zero => simp
    | succ m => simp [← Fin.succ_castSucc]
  have hL : ∀ {q : ℕ} (a : Fin (Fintype.card Γ)) (f : Fin (q + 1) → Fin (Fintype.card Γ)),
      (Fin.cons a f : Fin (q + 2) → Fin (Fintype.card Γ)) (Fin.last (q + 1)) = f (Fin.last q) := by
    intro q a f
    rw [← Fin.succ_last, Fin.cons_succ]
  have hsgn : ∀ m : ℕ, (-1 : ℤ) ^ (m + 1 + 1) = -(-1 : ℤ) ^ (m + 1) := by
    intro m
    ring

  have c2 : ∀ (q : ℕ) (ψ : (Fin (q + 1) → Fin (Fintype.card Γ)) × Fin r → M)
      (a : Fin (Fintype.card Γ)) (f : Fin (q + 1) → Fin (Fintype.card Γ)) (j : Fin r),
      wcSpfModBarD act ρ (q + 1) ψ ((Fin.cons a f : Fin (q + 2) → Fin (Fintype.card Γ)), j) =
        act ((Fintype.equivFin Γ).symm a) (ψ (f, j)) -
        ψ (Fin.cons (Fintype.equivFin Γ ((Fintype.equivFin Γ).symm a * (Fintype.equivFin Γ).symm (f 0)))
          (fun i => f i.succ), j) -
        ∑ k : Fin q, ((-1 : ℤ) ^ ((k : ℕ) + 1)) • ψ (Fin.cons a (wcSpfMerge Γ f k), j) -
        ((-1 : ℤ) ^ (q + 1)) • ∑ i : Fin r, wcSpfRhoEnt ρ (f (Fin.last q)) i j •
          ψ (Fin.cons a (fun l : Fin q => f l.castSucc), i) := by
    intro q ψ a f j
    simp only [wcSpfModBarD, Fin.cons_zero, Fin.cons_succ, Fin.sum_univ_succ, hm0, hS, hI, hL,
      Fin.val_zero, Fin.val_succ, hsgn, zero_add, pow_one, neg_smul, one_smul,
      Finset.sum_neg_distrib]
    abel

  refine ⟨s, fun q ψ => ?_⟩
  funext fj
  obtain ⟨f, j⟩ := fj
  rw [Pi.add_apply]
  apply Φ2
  intro g
  rw [map_add (act g), map_add πA, KEY (q + 1) (wcSpfModBarD act ρ (q + 1) ψ) f j g, c2,
    Equiv.symm_apply_apply]
  simp only [wcSpfModBarD, map_add, map_sub, map_sum, map_zsmul, map_nsmul, hact', KEY]
  abel

theorem wcSpfC_sc_exact_of_imageSieve : ∀ (Y : Scheme.{u})
    (S : ShortComplex (Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})),
    (∀ (T : Y.ProEt) (x : S.X₂.obj.obj (Opposite.op T)),
      (S.g.hom.app (Opposite.op T)).hom x = 0 →
      Presheaf.imageSieve S.f.hom x ∈ Scheme.ProEt.topology Y T) → S.Exact :=
by
  intro Y S hS
  have hz : ∀ (A B : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (T : (Y.ProEt)ᵒᵖ)
      (a : A.obj.obj T), ((0 : A ⟶ B).hom.app T).hom a = 0 := by
    intro A B T a
    have h := congrArg (fun φ : A ⟶ B => (φ.hom.app T).hom a) (add_zero (0 : A ⟶ B))
    simp only [Sheaf.Hom.add_app, AddCommGrpCat.hom_add, AddMonoidHom.add_apply] at h
    simpa using h
  rw [ShortComplex.exact_iff_epi_toCycles]
  have hinj : ∀ T' : (Y.ProEt)ᵒᵖ, Function.Injective (S.iCycles.hom.app T').hom := by
    intro T'
    have h1 : Mono S.iCycles.hom := (sheafToPresheaf _ _).map_mono S.iCycles
    have h2 : Mono (S.iCycles.hom.app T') := (NatTrans.mono_iff_mono_app _).mp h1 T'
    exact (AddCommGrpCat.mono_iff_injective _).mp h2
  have : Sheaf.IsLocallySurjective S.toCycles := by
    rw [← Sheaf.isLocallySurjective_sheafToPresheaf_map_iff]
    refine Presheaf.IsLocallySurjective.mk (fun {U} c => ?_)
    have hx : (S.g.hom.app (Opposite.op U)).hom ((S.iCycles.hom.app (Opposite.op U)).hom c) = 0 := by
      have := congrArg (fun φ => (φ.hom.app (Opposite.op U)).hom c) S.iCycles_g
      exact this.trans (hz _ _ _ c)
    refine (Scheme.ProEt.topology Y).superset_covering ?_ (hS U _ hx)
    intro V g hg
    rw [Presheaf.imageSieve_apply] at hg ⊢
    obtain ⟨t, ht⟩ := hg
    refine ⟨t, hinj _ ?_⟩
    have e1 := congrArg (fun φ => (φ.hom.app (Opposite.op V)).hom t) S.toCycles_i
    refine e1.trans (ht.trans ?_)
    exact (NatTrans.naturality_apply S.iCycles.hom g.op c).symm
  exact Sheaf.epi_of_isLocallySurjective _

theorem wcSpfC_epi_tuple_lift : ∀ (Y : Scheme.{u}) (P : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
    (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
    (π : (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P ⟶ G) [Epi π]
    (T : Y.ProEt) (ι : Type) [Fintype ι] (x : ι → G.obj.obj (Opposite.op T)),
    ∃ R : Sieve T, R ∈ Scheme.ProEt.topology Y T ∧ ∀ (T' : Y.ProEt) (f : T' ⟶ T), R.arrows f →
      ∃ y : ι → P.obj (Opposite.op T'), ∀ i,
        (π.hom.app (Opposite.op T')).hom
          (((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op T')).hom (y i)) =
        (G.obj.map f.op).hom (x i) :=
by
  classical
  intro Y P G π _ T ι _ x
  haveI h1 : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y)
      (toSheafify (Scheme.ProEt.topology Y) P) := inferInstance
  haveI h2 : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y) π.hom :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} π).mpr inferInstance
  haveI h3 : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y)
      (toSheafify (Scheme.ProEt.topology Y) P ≫ π.hom) :=
    Presheaf.isLocallySurjective_comp (Scheme.ProEt.topology Y)
      (toSheafify (Scheme.ProEt.topology Y) P) π.hom
  have s5 : ∀ (n : ℕ) (x' : Fin n → G.obj.obj (Opposite.op T)),
      ∃ R : Sieve T, R ∈ Scheme.ProEt.topology Y T ∧ ∀ (T' : Y.ProEt) (f : T' ⟶ T), R.arrows f →
        ∃ y : Fin n → P.obj (Opposite.op T'), ∀ j,
          ((toSheafify (Scheme.ProEt.topology Y) P ≫ π.hom).app (Opposite.op T')).hom (y j) =
            (G.obj.map f.op).hom (x' j) := by
    intro n
    induction n with
    | zero =>
      intro x'
      exact ⟨⊤, (Scheme.ProEt.topology Y).top_mem T, fun T' f _ => ⟨Fin.elim0, fun j => Fin.elim0 j⟩⟩
    | succ n ih =>
      intro x'
      obtain ⟨Sv', hSv', hlift'⟩ := ih (fun j => x' j.succ)
      have h0 := Presheaf.imageSieve_mem (Scheme.ProEt.topology Y)
        (toSheafify (Scheme.ProEt.topology Y) P ≫ π.hom) (x' 0)
      refine ⟨_ ⊓ Sv', (Scheme.ProEt.topology Y).intersection_covering h0 hSv', fun T' f hf => ?_⟩
      obtain ⟨hf0, hf1⟩ := hf
      rw [Presheaf.imageSieve_apply] at hf0
      obtain ⟨y0, hy0⟩ := hf0
      obtain ⟨y', hy'⟩ := hlift' T' f hf1
      refine ⟨Fin.cons y0 y', fun j => ?_⟩
      rcases Fin.eq_zero_or_eq_succ j with rfl | ⟨k, rfl⟩
      · exact hy0
      · exact hy' k
  let e := Fintype.equivFin ι
  obtain ⟨R, hR, hlift⟩ := s5 (Fintype.card ι) (fun j => x (e.symm j))
  refine ⟨R, hR, fun T' f hf => ?_⟩
  obtain ⟨y', hy'⟩ := hlift T' f hf
  refine ⟨fun i => y' (e i), fun i => ?_⟩
  have := hy' (e i)
  rw [Equiv.symm_apply_apply] at this
  exact this

theorem wcSpfC_ker_tuple_div : ∀ (Y : Scheme.{u}) (P : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
    (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
    (π : (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P ⟶ G) (N : ℕ)
    (hdiv : ∀ (W : Y.ProEt)
      (y : ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P).obj.obj
        (Opposite.op W)),
      (π.hom.app (Opposite.op W)).hom y = 0 → ∃ x, y = N • x)
    (T : Y.ProEt) (ι : Type) [Fintype ι] (w : ι → P.obj (Opposite.op T))
    (hw : ∀ i, (π.hom.app (Opposite.op T)).hom
      (((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op T)).hom (w i)) = 0),
    ∃ R : Sieve T, R ∈ Scheme.ProEt.topology Y T ∧ ∀ (T' : Y.ProEt) (f : T' ⟶ T), R.arrows f →
      ∃ v : ι → P.obj (Opposite.op T'), ∀ i, (P.map f.op).hom (w i) = N • v i :=
by
  intro Y P G π N hdiv T ι _ w hw
  classical

  have s1 : ∀ (w0 : P.obj (Opposite.op T))
      (x : ((presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P).obj.obj
        (Opposite.op T)),
      ((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op T)).hom w0 = N • x →
      ∃ R : Sieve T, R ∈ Scheme.ProEt.topology Y T ∧ ∀ (T' : Y.ProEt) (f : T' ⟶ T),
        R.arrows f → ∃ v : P.obj (Opposite.op T'), (P.map f.op).hom w0 = N • v := by
    intro w0 x hx
    let Rdiv : Sieve T :=
      { arrows := fun T' f => ∃ v : P.obj (Opposite.op T'), (P.map f.op).hom w0 = N • v
        downward_closed := by
          rintro T' T'' f ⟨v, hv⟩ h
          refine ⟨(P.map h.op).hom v, ?_⟩
          rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, hv,
            map_nsmul] }
    refine ⟨Rdiv, ?_, fun _ _ hf => hf⟩
    refine (Scheme.ProEt.topology Y).transitive
      (Presheaf.imageSieve_mem (Scheme.ProEt.topology Y)
        (toSheafify (Scheme.ProEt.topology Y) P) x) Rdiv ?_
    intro T' f hf
    obtain ⟨v0, hv0⟩ := hf
    have hv0' : ((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op T')).hom v0 =
        ((sheafify (Scheme.ProEt.topology Y) P).map f.op).hom x := hv0
    have nat : ((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op T')).hom
          ((P.map f.op).hom w0) =
        ((sheafify (Scheme.ProEt.topology Y) P).map f.op).hom
          (((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op T)).hom w0) :=
      NatTrans.naturality_apply (toSheafify (Scheme.ProEt.topology Y) P) f.op w0
    set d : P.obj (Opposite.op T') := (P.map f.op).hom w0 - N • v0 with hd_def
    have hd : ((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op T')).hom d =
        ((toSheafify (Scheme.ProEt.topology Y) P).app (Opposite.op T')).hom 0 := by
      rw [hd_def, map_sub, map_nsmul, nat, hv0', hx, map_nsmul, sub_self, map_zero]
    have hE := Presheaf.equalizerSieve_mem (Scheme.ProEt.topology Y)
      (toSheafify (Scheme.ProEt.topology Y) P) d 0 hd
    refine (Scheme.ProEt.topology Y).superset_covering ?_ hE
    intro T'' h hh
    have hh' : (P.map h.op).hom d = (P.map h.op).hom 0 := hh
    rw [map_zero, hd_def, map_sub, map_nsmul, sub_eq_zero] at hh'
    show ∃ v : P.obj (Opposite.op T''), (P.map (h ≫ f).op).hom w0 = N • v
    refine ⟨(P.map h.op).hom v0, ?_⟩
    rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, hh']

  have hloc : ∀ i, ∃ R : Sieve T, R ∈ Scheme.ProEt.topology Y T ∧ ∀ (T' : Y.ProEt)
      (f : T' ⟶ T), R.arrows f → ∃ v : P.obj (Opposite.op T'), (P.map f.op).hom (w i) = N • v := by
    intro i
    obtain ⟨x, hx⟩ := hdiv T _ (hw i)
    exact s1 (w i) x hx
  choose Rs hRs hQ using hloc

  have key : ∀ s : Finset ι, ∃ R : Sieve T, R ∈ Scheme.ProEt.topology Y T ∧
      ∀ (T' : Y.ProEt) (f : T' ⟶ T), R.arrows f → ∀ i ∈ s,
        ∃ v : P.obj (Opposite.op T'), (P.map f.op).hom (w i) = N • v := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      exact ⟨⊤, (Scheme.ProEt.topology Y).top_mem T, fun _ _ _ i hi => absurd hi (by simp)⟩
    | insert a s ha ih =>
      obtain ⟨R, hR, hRQ⟩ := ih
      refine ⟨R ⊓ Rs a, (Scheme.ProEt.topology Y).intersection_covering hR (hRs a), ?_⟩
      intro T' f hf i hi
      rw [Sieve.inter_apply] at hf
      rcases Finset.mem_insert.mp hi with rfl | hi'
      · exact hQ i T' f hf.2
      · exact hRQ T' f hf.1 i hi'
  obtain ⟨R, hR, hRQ⟩ := key Finset.univ
  refine ⟨R, hR, fun T' f hf => ?_⟩
  have hall := fun i => hRQ T' f hf i (Finset.mem_univ i)
  choose v hv using hall
  exact ⟨v, hv⟩

theorem wcSpfC_prod_sections : ∀ (Y : Scheme.{u}) (ι : Type) [Finite ι]
    (F : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (T : Y.ProEt),
    (∀ x x' : (∏ᶜ fun _ : ι => F).obj.obj (Opposite.op T),
      (∀ i, ((Limits.Pi.π (fun _ : ι => F) i).hom.app (Opposite.op T)).hom x =
        ((Limits.Pi.π (fun _ : ι => F) i).hom.app (Opposite.op T)).hom x') → x = x') ∧
    (∀ y : ι → F.obj.obj (Opposite.op T), ∃ x : (∏ᶜ fun _ : ι => F).obj.obj (Opposite.op T),
      ∀ i, ((Limits.Pi.π (fun _ : ι => F) i).hom.app (Opposite.op T)).hom x = y i) :=
by
  intro Y ι _ F T
  classical
  letI : Fintype ι := Fintype.ofFinite ι
  have hz : ∀ (A B : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (U : (Y.ProEt)ᵒᵖ)
      (a : A.obj.obj U), ((0 : A ⟶ B).hom.app U).hom a = 0 := by
    intro A B U a
    have h := congrArg (fun φ : A ⟶ B => (φ.hom.app U).hom a) (add_zero (0 : A ⟶ B))
    simp only [Sheaf.Hom.add_app, AddCommGrpCat.hom_add, AddMonoidHom.add_apply] at h
    simpa using h
  have hsum : ∀ (A B : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
      (s : Finset ι) (f : ι → (A ⟶ B)) (U : (Y.ProEt)ᵒᵖ) (a : A.obj.obj U),
      ((∑ i ∈ s, f i).hom.app U).hom a = ∑ i ∈ s, ((f i).hom.app U).hom a := by
    intro A B s f U a
    induction s using Finset.induction_on with
    | empty => rw [Finset.sum_empty, Finset.sum_empty]; exact hz A B U a
    | insert i s hi ih =>
      rw [Finset.sum_insert hi, Finset.sum_insert hi, Sheaf.Hom.add_app, AddCommGrpCat.hom_add,
        AddMonoidHom.add_apply, ih]
  let inj : ι → (F ⟶ ∏ᶜ fun _ : ι => F) := fun i =>
    Limits.Pi.lift (fun j : ι => (if i = j then 𝟙 F else (0 : F ⟶ F)))
  have I1 : ∀ i k, inj i ≫ Limits.Pi.π (fun _ : ι => F) k = if i = k then 𝟙 F else 0 := by
    intro i k
    exact Limits.Pi.lift_comp_π _ _
  have I2 : ∑ i, Limits.Pi.π (fun _ : ι => F) i ≫ inj i = 𝟙 (∏ᶜ fun _ : ι => F) := by
    apply Limits.Pi.hom_ext
    intro k
    rw [Preadditive.sum_comp, Category.id_comp]
    simp only [Category.assoc, I1]
    rw [Finset.sum_eq_single k]
    · rw [if_pos rfl, Category.comp_id]
    · intro i _ hik; rw [if_neg hik, Limits.comp_zero]
    · intro hk; exact absurd (Finset.mem_univ k) hk
  have e : ∀ x : (∏ᶜ fun _ : ι => F).obj.obj (Opposite.op T), x = ∑ i,
      ((inj i).hom.app (Opposite.op T)).hom
        (((Limits.Pi.π (fun _ : ι => F) i).hom.app (Opposite.op T)).hom x) := by
    intro x
    have := congrArg (fun φ : (∏ᶜ fun _ : ι => F) ⟶ (∏ᶜ fun _ : ι => F) =>
      (φ.hom.app (Opposite.op T)).hom x) I2
    rw [hsum] at this
    exact this.symm
  refine ⟨fun x x' h => ?_, fun y => ?_⟩
  · rw [e x, e x']
    simp only [h]
  · refine ⟨∑ i, ((inj i).hom.app (Opposite.op T)).hom (y i), fun k => ?_⟩
    rw [map_sum, Finset.sum_eq_single k]
    · have h1 := congrArg (fun φ : F ⟶ F => (φ.hom.app (Opposite.op T)).hom (y k)) (I1 k k)
      rw [if_pos rfl] at h1
      exact h1
    · intro i _ hik
      have h1 := congrArg (fun φ : F ⟶ F => (φ.hom.app (Opposite.op T)).hom (y i)) (I1 i k)
      rw [if_neg hik] at h1
      exact h1.trans (hz _ _ _ _)
    · intro hk; exact absurd (Finset.mem_univ k) hk

theorem wcSpfC_bar_sections : ∀ (Y : Scheme.{u}) {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {Γ : Type u}
    [Group Γ] [Fintype Γ] {n r : ℕ} (F : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
    (lam : MonoidAlgebra ℤ_[ℓ] Γ → (F ⟶ F)) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (p : ℕ)
    (T : Y.ProEt) (x : (wcSpfBar F lam ρ p).obj.obj (Opposite.op T)),
    (fun fj : (Fin (p + 1) → Fin (Fintype.card Γ)) × Fin r =>
      ((Limits.Pi.π (fun _ : (Fin (p + 1) → Fin (Fintype.card Γ)) × Fin r => F) fj).hom.app
        (Opposite.op T)).hom (((wcSpfBarD F lam ρ p).hom.app (Opposite.op T)).hom x)) =
    wcSpfModBarD (fun g => ((lam (MonoidAlgebra.single g 1)).hom.app (Opposite.op T)).hom) ρ p
      (fun k => ((Limits.Pi.π (fun _ : (Fin p → Fin (Fintype.card Γ)) × Fin r => F) k).hom.app
        (Opposite.op T)).hom x) :=
by
  intro Y ℓ _ Γ _ _ n r F lam ρ p T x
  funext fj
  let Ev : ∀ (A B : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}),
      (A ⟶ B) →+ (A.obj.obj (Opposite.op T) →+ B.obj.obj (Opposite.op T)) := fun A B =>
    AddMonoidHom.mk' (fun φ => (φ.hom.app (Opposite.op T)).hom)
      (fun φ ψ => by ext a; simp [Sheaf.Hom.add_app])
  have hEv : ∀ (A B : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (φ : A ⟶ B) a,
      Ev A B φ a = (φ.hom.app (Opposite.op T)).hom a := fun _ _ _ _ => rfl
  have hcomp : ∀ (A B C : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
      (φ : A ⟶ B) (ψ : B ⟶ C) a, Ev A C (φ ≫ ψ) a = Ev B C ψ (Ev A B φ a) :=
    fun _ _ _ _ _ _ => rfl
  have h1 : ((Limits.Pi.π (fun _ : (Fin (p + 1) → Fin (Fintype.card Γ)) × Fin r => F) fj).hom.app
        (Opposite.op T)).hom (((wcSpfBarD F lam ρ p).hom.app (Opposite.op T)).hom x) =
      Ev _ _ (wcSpfBarD F lam ρ p ≫
        Limits.Pi.π (fun _ : (Fin (p + 1) → Fin (Fintype.card Γ)) × Fin r => F) fj) x := rfl
  rw [h1, wcSpfBarD, Limits.Pi.lift_comp_π]
  simp only [map_add, map_sum, map_zsmul, map_nsmul, AddMonoidHom.add_apply,
    AddMonoidHom.finsetSum_apply, AddMonoidHom.zsmul_apply, AddMonoidHom.nsmul_apply, hcomp]
  simp only [hEv]
  rfl

theorem wcSpfC_local_bar_exact : ∀ (Y : Scheme.{u}) {ℓ : ℕ} {Γ : Type u} [Group Γ] [Fintype Γ]
    {n r : ℕ} (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (N : ℕ)
    (P : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
    (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
    (aP : Γ → (P ⟶ P)) (aG : Γ → (G ⟶ G)) (θ : P ⟶ G.obj)
    (hθa : ∀ g : Γ, aP g ≫ θ = θ ≫ (aG g).hom)
    (hθN : ∀ (T : Y.ProEt) (m : P.obj (Opposite.op T)), (θ.app (Opposite.op T)).hom (N • m) = 0)
    (hlift : ∀ (T : Y.ProEt) (ι : Type) [Fintype ι] (x : ι → G.obj.obj (Opposite.op T)),
      ∃ R : Sieve T, R ∈ Scheme.ProEt.topology Y T ∧ ∀ (T' : Y.ProEt) (f : T' ⟶ T), R.arrows f →
        ∃ y : ι → P.obj (Opposite.op T'), ∀ i,
          (θ.app (Opposite.op T')).hom (y i) = (G.obj.map f.op).hom (x i))
    (hker : ∀ (T : Y.ProEt) (ι : Type) [Fintype ι] (w : ι → P.obj (Opposite.op T)),
      (∀ i, (θ.app (Opposite.op T)).hom (w i) = 0) →
      ∃ R : Sieve T, R ∈ Scheme.ProEt.topology Y T ∧ ∀ (T' : Y.ProEt) (f : T' ⟶ T), R.arrows f →
        ∃ v : ι → P.obj (Opposite.op T'), ∀ i, (P.map f.op).hom (w i) = N • v i)
    (𝒯 : Y.ProEt → Prop)
    (hcov : ∀ T : Y.ProEt, Subsingleton (P.obj (Opposite.op T)) ∨
      ∃ R : Sieve T, R ∈ Scheme.ProEt.topology Y T ∧
        ∀ (T' : Y.ProEt) (f : T' ⟶ T), R.arrows f → 𝒯 T')
    (hhtpy : ∀ T : Y.ProEt, 𝒯 T → ∃ s : ∀ q : ℕ,
      (((Fin (q + 1) → Fin (Fintype.card Γ)) × Fin r) → P.obj (Opposite.op T)) →+
        (((Fin q → Fin (Fintype.card Γ)) × Fin r) → P.obj (Opposite.op T)),
      ∀ (q : ℕ) (ψ : (Fin (q + 1) → Fin (Fintype.card Γ)) × Fin r → P.obj (Opposite.op T)),
        ψ = wcSpfModBarD (fun g => ((aP g).app (Opposite.op T)).hom) ρ q (s q ψ) +
          s (q + 1) (wcSpfModBarD (fun g => ((aP g).app (Opposite.op T)).hom) ρ (q + 1) ψ))
    (p : ℕ) (T : Y.ProEt)
    (x : (Fin (p + 1) → Fin (Fintype.card Γ)) × Fin r → G.obj.obj (Opposite.op T))
    (hx : wcSpfModBarD (fun g => ((aG g).hom.app (Opposite.op T)).hom) ρ (p + 1) x = 0),
    ∃ R : Sieve T, R ∈ Scheme.ProEt.topology Y T ∧ ∀ (T'' : Y.ProEt) (g : T'' ⟶ T), R.arrows g →
      ∃ z : (Fin p → Fin (Fintype.card Γ)) × Fin r → G.obj.obj (Opposite.op T''),
        wcSpfModBarD (fun γ => ((aG γ).hom.app (Opposite.op T'')).hom) ρ p z =
          fun i => (G.obj.map g.op).hom (x i) :=
by
  intro Y ℓ Γ _ _ n r ρ N P G aP aG θ hθa hθN hlift hker 𝒯 hcov hhtpy p T x hx
  classical

  have nat : ∀ {M M' : Type (u+1)} [AddCommGroup M] [AddCommGroup M']
      (act : Γ → (M →+ M)) (act' : Γ → (M' →+ M')) (φ : M →+ M')
      (_hφ : ∀ (g : Γ) (m : M), φ (act g m) = act' g (φ m)) (q : ℕ)
      (u : (Fin q → Fin (Fintype.card Γ)) × Fin r → M),
      (fun i => φ (wcSpfModBarD act ρ q u i)) = wcSpfModBarD act' ρ q (fun i => φ (u i)) := by
    intro M M' _ _ act act' φ hφ q u
    funext fj
    simp only [wcSpfModBarD, map_add, map_sum, map_zsmul, map_nsmul, hφ]
  have hc : ∀ {A B C : AddCommGrpCat.{u+1}} (f : A ⟶ B) (g : B ⟶ C) (a : A),
      (f ≫ g).hom a = g.hom (f.hom a) := fun _ _ _ => rfl

  have Nθ : ∀ (T₁ : Y.ProEt) (q : ℕ)
      (u : (Fin q → Fin (Fintype.card Γ)) × Fin r → P.obj (Opposite.op T₁)),
      (fun i => (θ.app (Opposite.op T₁)).hom
        (wcSpfModBarD (fun g => ((aP g).app (Opposite.op T₁)).hom) ρ q u i)) =
        wcSpfModBarD (fun g => ((aG g).hom.app (Opposite.op T₁)).hom) ρ q
          (fun i => (θ.app (Opposite.op T₁)).hom (u i)) := by
    intro T₁ q u
    refine nat _ _ _ (fun g m => ?_) q u
    have := congrArg (fun φ' => (φ'.app (Opposite.op T₁)).hom m) (hθa g)
    simpa only [NatTrans.comp_app, hc] using this

  have NG : ∀ (T₁ T₂ : Y.ProEt) (f : T₂ ⟶ T₁) (q : ℕ)
      (u : (Fin q → Fin (Fintype.card Γ)) × Fin r → G.obj.obj (Opposite.op T₁)),
      (fun i => (G.obj.map f.op).hom
        (wcSpfModBarD (fun g => ((aG g).hom.app (Opposite.op T₁)).hom) ρ q u i)) =
        wcSpfModBarD (fun g => ((aG g).hom.app (Opposite.op T₂)).hom) ρ q
          (fun i => (G.obj.map f.op).hom (u i)) := by
    intro T₁ T₂ f q u
    refine nat _ _ _ (fun g m => ?_) q u
    have := congrArg (fun φ' => φ'.hom m) ((aG g).hom.naturality f.op)
    simp only [hc] at this
    exact this.symm

  have NP : ∀ (T₁ T₂ : Y.ProEt) (f : T₂ ⟶ T₁) (q : ℕ)
      (u : (Fin q → Fin (Fintype.card Γ)) × Fin r → P.obj (Opposite.op T₁)),
      (fun i => (P.map f.op).hom
        (wcSpfModBarD (fun g => ((aP g).app (Opposite.op T₁)).hom) ρ q u i)) =
        wcSpfModBarD (fun g => ((aP g).app (Opposite.op T₂)).hom) ρ q
          (fun i => (P.map f.op).hom (u i)) := by
    intro T₁ T₂ f q u
    refine nat _ _ _ (fun g m => ?_) q u
    have := congrArg (fun φ' => φ'.hom m) ((aP g).naturality f.op)
    simp only [hc] at this
    exact this.symm

  have θnat : ∀ (T₁ T₂ : Y.ProEt) (f : T₂ ⟶ T₁) (m : P.obj (Opposite.op T₁)),
      (θ.app (Opposite.op T₂)).hom ((P.map f.op).hom m) =
        (G.obj.map f.op).hom ((θ.app (Opposite.op T₁)).hom m) := by
    intro T₁ T₂ f m
    have := congrArg (fun φ' => φ'.hom m) (θ.naturality f.op)
    simp only [hc] at this
    exact this

  have hcomp : ∀ (T₁ T₂ T₃ : Y.ProEt) (f : T₂ ⟶ T₁) (h : T₃ ⟶ T₂)
      (a : G.obj.obj (Opposite.op T₁)),
      (G.obj.map h.op).hom ((G.obj.map f.op).hom a) = (G.obj.map (h ≫ f).op).hom a := by
    intro T₁ T₂ T₃ f h a
    rw [op_comp, Functor.map_comp, hc]

  have NG0 : ∀ (T₁ : Y.ProEt) (q : ℕ),
      wcSpfModBarD (fun g => ((aG g).hom.app (Opposite.op T₁)).hom) ρ q (fun _ => 0) =
        fun _ => 0 := by
    intro T₁ q
    funext fj
    simp [wcSpfModBarD]

  let Rg : Sieve T :=
    { arrows := fun T'' g => ∃ z : (Fin p → Fin (Fintype.card Γ)) × Fin r →
          G.obj.obj (Opposite.op T''),
        wcSpfModBarD (fun γ => ((aG γ).hom.app (Opposite.op T'')).hom) ρ p z =
          fun i => (G.obj.map g.op).hom (x i)
      downward_closed := by
        intro T'' T''' g hg h
        obtain ⟨z, hz⟩ := hg
        refine ⟨fun i => (G.obj.map h.op).hom (z i), ?_⟩
        rw [← NG T'' T''' h p z, hz]
        funext i
        exact hcomp T T'' T''' g h (x i) }
  refine ⟨Rg, ?_, fun T'' g hg => hg⟩
  obtain ⟨R₀, hR₀, hy₀⟩ := hlift T _ x
  refine (Scheme.ProEt.topology Y).transitive hR₀ Rg ?_
  intro T' f hf
  obtain ⟨y, hy⟩ := hy₀ T' f hf
  rcases hcov T' with hsub | ⟨R₁, hR₁, h𝒯⟩
  ·
    have hfx : ∀ i, (G.obj.map f.op).hom (x i) = 0 := by
      intro i
      rw [← hy i, Subsingleton.elim (y i) 0, map_zero]
    have hfR : Rg.arrows f := ⟨fun _ => 0, by
      rw [NG0 T' p]
      funext i
      exact (hfx i).symm⟩
    rw [Sieve.pullback_eq_top_of_mem Rg hfR]
    exact (Scheme.ProEt.topology Y).top_mem T'
  ·
    have hθw : ∀ i, (θ.app (Opposite.op T')).hom
        (wcSpfModBarD (fun g => ((aP g).app (Opposite.op T')).hom) ρ (p + 1) y i) = 0 := by
      intro i
      have e1 := congrFun (Nθ T' (p + 1) y) i
      have e2 := congrFun (NG T T' f (p + 1) x) i
      try simp only at e1 e2
      rw [e1]
      have e3 : (fun i => (θ.app (Opposite.op T')).hom (y i)) =
          fun i => (G.obj.map f.op).hom (x i) := funext hy
      rw [e3, ← e2, hx, Pi.zero_apply, map_zero]
    obtain ⟨R₂, hR₂, hv₀⟩ := hker T' _ _ hθw
    refine (Scheme.ProEt.topology Y).superset_covering ?_
      ((Scheme.ProEt.topology Y).intersection_covering hR₁ hR₂)
    intro T'' h hh
    rw [Sieve.inter_apply] at hh
    obtain ⟨h₁, h₂⟩ := hh
    show Rg.arrows (h ≫ f)
    obtain ⟨s, hs⟩ := hhtpy T'' (h𝒯 T'' h h₁)
    obtain ⟨v, hv⟩ := hv₀ T'' h h₂
    obtain ⟨ψ, hψ⟩ : ∃ ψ : (Fin (p + 1) → Fin (Fintype.card Γ)) × Fin r →
        P.obj (Opposite.op T''), ψ = fun i => (P.map h.op).hom (y i) := ⟨_, rfl⟩
    have hv' : wcSpfModBarD (fun g => ((aP g).app (Opposite.op T'')).hom) ρ (p + 1) ψ =
        N • v := by
      rw [hψ, ← NP T' T'' h (p + 1) y]
      funext i
      rw [hv i, Pi.smul_apply]
    have hstar := hs p ψ
    rw [hv', map_nsmul] at hstar
    refine ⟨fun i => (θ.app (Opposite.op T'')).hom (s p ψ i), ?_⟩
    rw [← Nθ T'' p (s p ψ)]
    funext i
    have e := congrFun hstar i
    rw [Pi.add_apply, Pi.smul_apply] at e
    have e' := congrArg (θ.app (Opposite.op T'')).hom e
    rw [map_add, hθN, add_zero] at e'
    rw [← e']
    have hψi : ψ i = (P.map h.op).hom (y i) := by rw [hψ]
    rw [hψi, θnat T' T'' h, hy i, hcomp T T' T'' f h]

theorem wcSpfR_bar_coker_exact (K : Type u) [Field K] [Finite K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ] [Fintype Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α)
    (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (n : ℕ) (hn : 1 ≤ n) (r : ℕ) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n)))
    (lamF : MonoidAlgebra ℤ_[ℓ] Γ → (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶ wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
    (hlamF : wcRingAct lamF)
    (hlamFs : ∀ (g : Γ) (a : ℤ_[ℓ]), lamF (MonoidAlgebra.single g a) =
      wcCoverScal (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ a ≫
        wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
          (α g⁻¹).hom (hα g⁻¹))
    (lamG : MonoidAlgebra ℤ_[ℓ] Γ → (Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)) ⟶
      Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))))
    (hlamG : ∀ x, Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)) ≫ lamG x =
      lamF x ≫ Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)))
    (hdd : ∀ p, wcSpfBarD (Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))) lamG ρ p ≫
      wcSpfBarD (Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))) lamG ρ (p + 1) = 0) :
    ∀ p, (ShortComplex.mk _ _ (hdd p)).Exact :=
by
  classical
  obtain ⟨lamP, hlamP, hFP, hPg, -⟩ := wc_cover_presheaf_ring_action K ℓ m S hS Uo hUo q' Γ α
    hG hα lamF hlamF hlamFs

  have hz : ∀ (A B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (T : ((wcP1Over K).left.ProEt)ᵒᵖ) (a : A.obj.obj T), ((0 : A ⟶ B).hom.app T).hom a = 0 := by
    intro A B T a
    have h := congrArg (fun φ : A ⟶ B => (φ.hom.app T).hom a) (add_zero (0 : A ⟶ B))
    simp only [Sheaf.Hom.add_app, AddCommGrpCat.hom_add, AddMonoidHom.add_apply] at h
    simpa using h
  have hns : ∀ (A B : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (φ : A ⟶ B) (N : ℕ) (T : ((wcP1Over K).left.ProEt)ᵒᵖ) (a : A.obj.obj T),
      ((N • φ).hom.app T).hom a = N • (φ.hom.app T).hom a := by
    intro A B φ N T a
    induction N with
    | zero => rw [zero_nsmul, zero_nsmul]; exact hz A B T a
    | succ k ih =>
      rw [succ_nsmul, succ_nsmul, Sheaf.Hom.add_app, AddCommGrpCat.hom_add,
        AddMonoidHom.add_apply, ih]

  have final : ∀ (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (lam : MonoidAlgebra ℤ_[ℓ] Γ → (G ⟶ G))
      (hdd' : ∀ p, wcSpfBarD G lam ρ p ≫ wcSpfBarD G lam ρ (p + 1) = 0),
      (∀ (p : ℕ) (T : (wcP1Over K).left.ProEt)
        (x : (Fin (p + 1) → Fin (Fintype.card Γ)) × Fin r → G.obj.obj (Opposite.op T)),
        wcSpfModBarD (fun g => ((lam (MonoidAlgebra.single g 1)).hom.app (Opposite.op T)).hom)
          ρ (p + 1) x = 0 →
        ∃ R : Sieve T, R ∈ Scheme.ProEt.topology (wcP1Over K).left T ∧
          ∀ (T'' : (wcP1Over K).left.ProEt) (g : T'' ⟶ T), R.arrows g →
            ∃ z : (Fin p → Fin (Fintype.card Γ)) × Fin r → G.obj.obj (Opposite.op T''),
              wcSpfModBarD (fun γ => ((lam (MonoidAlgebra.single γ 1)).hom.app
                (Opposite.op T'')).hom) ρ p z = fun i => (G.obj.map g.op).hom (x i)) →
      ∀ p, (ShortComplex.mk _ _ (hdd' p)).Exact := by
    intro G lam hdd' hloc p
    apply wcSpfC_sc_exact_of_imageSieve (wcP1Over K).left
    intro T x hx
    have hx' : ((wcSpfBarD G lam ρ (p + 1)).hom.app (Opposite.op T)).hom x = 0 := hx
    have h0 : wcSpfModBarD (fun g => ((lam (MonoidAlgebra.single g 1)).hom.app
        (Opposite.op T)).hom) ρ (p + 1)
        (fun k => ((Limits.Pi.π (fun _ : (Fin (p + 1) → Fin (Fintype.card Γ)) × Fin r => G)
          k).hom.app (Opposite.op T)).hom x) = 0 := by
      refine (wcSpfC_bar_sections (wcP1Over K).left G lam ρ (p + 1) T x).symm.trans ?_
      funext fj
      exact (congrArg ((Limits.Pi.π (fun _ : (Fin (p + 1 + 1) → Fin (Fintype.card Γ)) × Fin r =>
        G) fj).hom.app (Opposite.op T)).hom hx').trans (map_zero _)
    obtain ⟨R, hR, hRz⟩ := hloc p T _ h0
    refine (Scheme.ProEt.topology (wcP1Over K).left).superset_covering ?_ hR
    intro T'' g hg
    obtain ⟨z, hz'⟩ := hRz T'' g hg
    rw [Presheaf.imageSieve_apply]
    obtain ⟨u, hu⟩ := (wcSpfC_prod_sections (wcP1Over K).left
      ((Fin p → Fin (Fintype.card Γ)) × Fin r) G T'').2 z
    refine ⟨u, ?_⟩
    apply (wcSpfC_prod_sections (wcP1Over K).left
      ((Fin (p + 1) → Fin (Fintype.card Γ)) × Fin r) G T'').1
    intro fj
    have e1 := congrFun (wcSpfC_bar_sections (wcP1Over K).left G lam ρ p T'' u) fj
    have hu' : (fun k => ((Limits.Pi.π (fun _ : (Fin p → Fin (Fintype.card Γ)) × Fin r => G)
        k).hom.app (Opposite.op T'')).hom u) = z := funext hu
    rw [hu', hz'] at e1
    exact e1.trans (NatTrans.naturality_apply (Limits.Pi.π
      (fun _ : (Fin (p + 1) → Fin (Fintype.card Γ)) × Fin r => G) fj).hom g.op x).symm

  have generic2 : ∀ (P : ((wcP1Over K).left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})
      (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (π : (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1}).obj P ⟶ G)
      (_ : Epi π) (N : ℕ)
      (hNπ : (N • 𝟙 ((presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1}).obj P)) ≫ π = 0)
      (hdiv : ∀ (W : (wcP1Over K).left.ProEt)
        (y : ((presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
          AddCommGrpCat.{u+1}).obj P).obj.obj (Opposite.op W)),
        (π.hom.app (Opposite.op W)).hom y = 0 → ∃ x, y = N • x)
      (lamP : MonoidAlgebra ℤ_[ℓ] Γ → (P ⟶ P)) (hlamP : wcRingAct lamP)
      (lamG : MonoidAlgebra ℤ_[ℓ] Γ → (G ⟶ G))
      (hcomm : ∀ x, (presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1}).map (lamP x) ≫ π = π ≫ lamG x)
      (𝒯 : (wcP1Over K).left.ProEt → Prop)
      (hcov : ∀ T : (wcP1Over K).left.ProEt, Subsingleton (P.obj (Opposite.op T)) ∨
        ∃ R : Sieve T, R ∈ Scheme.ProEt.topology (wcP1Over K).left T ∧
          ∀ (T' : (wcP1Over K).left.ProEt) (f : T' ⟶ T), R.arrows f → 𝒯 T')
      (hcoind : ∀ T : (wcP1Over K).left.ProEt, 𝒯 T → ∃ (A : Type u) (_ : AddCommGroup A)
        (πA : P.obj (Opposite.op T) →+ A), Function.Bijective
          (fun (x : P.obj (Opposite.op T)) (g : Γ) =>
            πA (((lamP (MonoidAlgebra.single g 1)).app (Opposite.op T)).hom x)))
      (p : ℕ) (T : (wcP1Over K).left.ProEt)
      (x : (Fin (p + 1) → Fin (Fintype.card Γ)) × Fin r → G.obj.obj (Opposite.op T)),
      wcSpfModBarD (fun g => ((lamG (MonoidAlgebra.single g 1)).hom.app (Opposite.op T)).hom)
        ρ (p + 1) x = 0 →
      ∃ R : Sieve T, R ∈ Scheme.ProEt.topology (wcP1Over K).left T ∧
        ∀ (T'' : (wcP1Over K).left.ProEt) (g : T'' ⟶ T), R.arrows g →
          ∃ z : (Fin p → Fin (Fintype.card Γ)) × Fin r → G.obj.obj (Opposite.op T''),
            wcSpfModBarD (fun γ => ((lamG (MonoidAlgebra.single γ 1)).hom.app
              (Opposite.op T'')).hom) ρ p z = fun i => (G.obj.map g.op).hom (x i) := by
    intro P G π hepi N hNπ hdiv lamP hlamP lamG hcomm 𝒯 hcov hcoind
    have hθa : ∀ g : Γ, lamP (MonoidAlgebra.single g 1) ≫
        (toSheafify (Scheme.ProEt.topology (wcP1Over K).left) P ≫ π.hom) =
