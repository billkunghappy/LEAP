      rw [h1, hEq (a.comp (Abelian.Ext.mk₀ φ.hom) (add_zero q)), Abelian.Ext.zero_comp]
    obtain ⟨T1⟩ := wc_slice_geom_ext_transfer (wcP1Over F'').left
      (wcGeomPoint F'' (wcP1Over F'') hP) (Limits.kernel Ψ) q
    exact T1.injective ((hKq _).trans (hKq _).symm)

  have hN : ∀ v : Abelian.Ext Z0 (Limits.biproduct (fun _ : Fin k => Zm (Over.mk e))) j,
      v = 0 := by
    intro v
    let eK : Limits.kernel (0 : Limits.biproduct (fun _ : Fin k => Zm (Over.mk e)) ⟶
        ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
          (wcGeomPoint F'' (wcP1Over F'') hP)).obj L) ≅
        Limits.biproduct (fun _ : Fin k => Zm (Over.mk e)) := Limits.kernelZeroIsoSource
    have h1 : v = (v.comp (Abelian.Ext.mk₀ eK.inv) (add_zero j)).comp
        (Abelian.Ext.mk₀ eK.hom) (add_zero j) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, eK.inv_hom_id,
        Abelian.Ext.comp_mk₀_id]
    rw [h1, hKer 0 j hj (v.comp (Abelian.Ext.mk₀ eK.inv) (add_zero j)), Abelian.Ext.zero_comp]

  generalize hf : (∑ i : Fin k, Limits.biproduct.π (fun _ : Fin k =>
      Zm (Over.mk e)) i ≫ ψ (Pi.single i 1)) = f at hψloc
  have hC : ∀ y : Abelian.Ext Z0 (Limits.cokernel f) j, y = 0 :=
    wc_qcfin_slice_supp_vanish F'' hP m S hS Ub hUb (Limits.cokernel f) hψloc j (by omega)
  obtain ⟨Φ⟩ : Nonempty (Abelian.Ext (wcFreeSheaf (wcP1Over F'').left
      (wcGeomPoint F'' (wcP1Over F'') hP)) L j ≃+
      Abelian.Ext Z0
        (((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1}
          (wcGeomPoint F'' (wcP1Over F'') hP)).obj L) j) :=
    wc_proet_free_slice_ext_equiv (wcP1Over F'').left (wcGeomPoint F'' (wcP1Over F'') hP) L j
  have hS2 : (ShortComplex.mk (Limits.kernel.ι (Limits.cokernel.π f)) (Limits.cokernel.π f)
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (Limits.cokernel.π f))
      inferInstance inferInstance
  obtain ⟨w', hw⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hS2 (Φ x) (hC _)
  have hw' : w'.comp (Abelian.Ext.mk₀ (Limits.kernel.ι (Limits.cokernel.π f))) (add_zero j) =
      Φ x := hw
  have hS1 : (ShortComplex.mk
      (Limits.kernel.ι (Limits.kernel.lift (Limits.cokernel.π f) f (Limits.cokernel.condition f)))
      (Limits.kernel.lift (Limits.cokernel.π f) f (Limits.cokernel.condition f))
      (Limits.kernel.condition _)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance inferInstance
  have hR' : ∀ y : Abelian.Ext Z0
      (Limits.kernel (Limits.kernel.lift (Limits.cokernel.π f) f
        (Limits.cokernel.condition f))) (j + 1), y = 0 := by
    intro y
    let eK : Limits.kernel (Limits.kernel.lift (Limits.cokernel.π f) f
        (Limits.cokernel.condition f)) ≅ Limits.kernel f :=
      (Limits.kernelCompMono (Limits.kernel.lift (Limits.cokernel.π f) f
        (Limits.cokernel.condition f)) (Limits.kernel.ι (Limits.cokernel.π f))).symm ≪≫
        Limits.kernelIsoOfEq (Limits.kernel.lift_ι _ _ _)
    have h1 : y = (y.comp (Abelian.Ext.mk₀ eK.hom) (add_zero (j + 1))).comp
        (Abelian.Ext.mk₀ eK.inv) (add_zero (j + 1)) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, eK.hom_inv_id,
        Abelian.Ext.comp_mk₀_id]
    rw [h1, hKer f (j + 1) (by omega) (y.comp (Abelian.Ext.mk₀ eK.hom) (add_zero (j + 1))),
      Abelian.Ext.zero_comp]
  obtain ⟨v, hv⟩ := Abelian.Ext.covariant_sequence_exact₃ _ hS1 w' (show j + 1 = j + 1 from rfl)
    (hR' _)
  have hv' : v.comp (Abelian.Ext.mk₀
      (Limits.kernel.lift (Limits.cokernel.π f) f (Limits.cokernel.condition f)))
      (add_zero j) = w' := hv
  rw [hN v, Abelian.Ext.zero_comp] at hv'
  have hΦx : Φ x = 0 := by
    rw [← hw', ← hv', Abelian.Ext.zero_comp]
  exact Φ.injective (hΦx.trans (map_zero Φ).symm)

theorem wc_h2im_int_separated_succ (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G)
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin m), W.hom z ≠ S i (IsLocalRing.closedPoint K))
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (k : ℕ) (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫ θ.hom =
      θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map
        (wcConstScalar (wcP1Over K).left ℓ k c))
    (Pm : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (hint : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
      ∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1)
    (J : Subobject G)
    (hJ : ∀ (V : (wcP1Over K).left.ProEt) (s : G.obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : (wcP1Over K).left.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖Pm ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1)
    (n : ℕ) (hfin : ∀ r : ℕ, Finite (Abelian.Ext (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP))
      (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))) n)) :
    ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
      (Subobject.underlying.obj J) (n + 1),
      (∀ r : ℕ, x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π
        ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)))) (add_zero (n + 1)) = 0) → x = 0 :=
by
  classical
  intro x hx
  haveI := wc_proet_products_exact (wcP1Over K).left

  let Jo := Subobject.underlying.obj J
  let P0 := wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)
  let B : ℕ → Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1} :=
    fun r => Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 Jo)
  let π : ∀ r, Jo ⟶ B r := fun r => Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 Jo)
  have hπ : ∀ r, ((ℓ ^ r : ℕ) • π r) = 0 := by
    intro r
    have h := Limits.cokernel.condition ((ℓ ^ r : ℕ) • 𝟙 Jo)
    rwa [Preadditive.nsmul_comp, Category.id_comp] at h
  have hc0 : ∀ r, ((ℓ ^ (r + 1) : ℕ) • 𝟙 Jo) ≫ π r = 0 := by
    intro r
    rw [Preadditive.nsmul_comp, Category.id_comp, pow_succ', mul_smul, hπ r, smul_zero]
  let c : ∀ r, B (r + 1) ⟶ B r := fun r => Limits.cokernel.desc _ (π r) (hc0 r)
  have hc : ∀ r, π (r + 1) ≫ c r = π r := fun r => Limits.cokernel.π_desc _ _ _
  have hcepi : ∀ r, Epi (c r) := by
    intro r
    haveI : Epi (π (r + 1) ≫ c r) := by rw [hc r]; infer_instance
    exact epi_of_epi (π (r + 1)) (c r)
  let Yt := ∏ᶜ B
  let pr : ∀ n, Yt ⟶ B n := fun n => Limits.Pi.π B n
  have hY : Limits.IsLimit (Limits.Fan.mk Yt pr) := Limits.productIsProduct B
  let T : Yt ⟶ Yt := Limits.Pi.lift (fun n => pr n - pr (n + 1) ≫ c n)
  have hT : ∀ n, T ≫ pr n = pr n - pr (n + 1) ≫ c n := fun n => by simp [T, pr]
  let ι : Jo ⟶ Yt := Limits.Pi.lift π
  have hιpr : ∀ n, ι ≫ pr n = π n := fun n => by simp [ι, pr]
  have hι : ι ≫ T = 0 := by
    apply Limits.Pi.hom_ext
    intro n
    rw [Category.assoc, Limits.zero_comp]
    change ι ≫ T ≫ pr n = 0
    rw [hT n, Preadditive.comp_sub, hιpr, ← Category.assoc, hιpr, hc, sub_self]

  let c' : ∀ k m, m ≤ k → (B k ⟶ B m) := fun k m h => (Functor.ofOpSequence c).map (homOfLE h).op
  have hcomp : ∀ k j m (h1 : m ≤ j) (h2 : j ≤ k), c' k j h2 ≫ c' j m h1 = c' k m (h1.trans h2) := by
    intro k j m h1 h2
    exact ((Functor.ofOpSequence c).map_comp (homOfLE h2).op (homOfLE h1).op).symm
  have hsucc : ∀ m, c' (m + 1) m (Nat.le_succ m) = c m := fun m =>
    Functor.ofOpSequence_map_homOfLE_succ c m
  have hepi : ∀ d m, Epi (c' (m + d) m (Nat.le_add_right m d)) := by
    intro d
    induction d with
    | zero =>
      intro m
      have : c' (m + 0) m (Nat.le_add_right m 0) = 𝟙 _ :=
        (Functor.ofOpSequence c).map_id (Opposite.op m)
      rw [this]
      infer_instance
    | succ d ih =>
      intro m
      have e1 := hcomp (m + (d + 1)) (m + d) m (Nat.le_add_right m d) (by omega)
      have e2 : c' (m + (d + 1)) (m + d) (by omega) = c (m + d) := hsucc (m + d)
      rw [← e1, e2]
      haveI := ih m
      haveI := hcepi (m + d)
      infer_instance
  have hepi' : ∀ k m (h : m ≤ k), Epi (c' k m h) := by
    intro k m h
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
    exact hepi d m
  have htop : ∀ {X Y' : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (f : X ⟶ Y'), Epi f → Limits.imageSubobject f = ⊤ := by
    intro X Y' f hf
    haveI : Epi (Limits.imageSubobject f).arrow := by
      have := Limits.imageSubobject_arrow_comp f
      exact epi_of_epi_fac this
    haveI : IsIso (Limits.imageSubobject f).arrow := isIso_of_mono_of_epi _
    exact Subobject.eq_top_of_isIso_arrow _
  have hML : ∀ m, ∃ m', ∃ hm : m ≤ m', ∀ k (hk : m' ≤ k),
      Limits.imageSubobject (c' k m (hm.trans hk)) = Limits.imageSubobject (c' m' m hm) :=
    fun m => ⟨m, le_refl m, fun k hk => by rw [htop _ (hepi' _ _ _), htop _ (hepi' _ _ _)]⟩
  have hTepi : Epi T := wc_proet_ML_tower_shift_epi (wcP1Over K).left Yt B pr hY c' hcomp hML T
    (fun m => by rw [hsucc]; exact hT m)
  set qq := Limits.kernel.lift T ι hι with hqdef

  have hdef : ∀ (V : (wcP1Over K).left.ProEt),
      (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
      (∀ s : (Limits.kernel qq).obj.obj (Opposite.op V), s = 0) ∧
      (∀ s : (Limits.cokernel qq).obj.obj (Opposite.op V), s = 0) := by
    intro V hV
    obtain ⟨ψ, -⟩ := wc_qclift_integral_frame (wcP1Over K).left ℓ G W k θ Pm hint J hJ
    obtain ⟨Ym, Bm, red, cst, prm, incl, shift, hred, hcst, ⟨hYm⟩, hincl, hshift, hses⟩ :=
      wc_contSheaf_intvec_tower_model (wcP1Over K).left ℓ k
    haveI : Limits.PreservesFiniteColimits
        ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W) := by
      have hpc : Limits.PreservesColimitsOfSize.{0, 0}
          ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W) :=
        (Functor.sheafAdjunctionCocontinuous (Over.forget W) AddCommGrpCat.{u+1}
          ((Scheme.ProEt.topology (wcP1Over K).left).over W)
          (Scheme.ProEt.topology (wcP1Over K).left)).leftAdjoint_preservesColimits
      exact Limits.PreservesColimitsOfSize.preservesFiniteColimits
          ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W)
    haveI : ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).Additive :=
      Functor.additive_of_preserves_binary_products _
    obtain ⟨hK, hC⟩ := wc_tower_defect_isZero_of_exact_functor
      ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W) ℓ
      Jo Yt pr hY c hc T hT ι hιpr hι
      (wcContSheaf (wcP1Over K).left (Fin k → ℤ_[ℓ])) Ym Bm red hred cst hcst prm hYm incl hincl
      shift hshift hses ψ
    exact ⟨wc_P1_offS_sections_zero_of_over_zero K hP m S W w hqc hsurj _ hK V hV,
      wc_P1_offS_sections_zero_of_over_zero K hP m S W w hqc hsurj _ hC V hV⟩

  have hKpos : ∀ j : ℕ, 1 ≤ j → ∀ y : Abelian.Ext P0 (Limits.kernel qq) j, y = 0 :=
    fun j hj => wc_proet_P1_finite_supp_ext_vanish K hP m S hS _ (fun V hV => (hdef V hV).1) j hj
  have hCpos : ∀ j : ℕ, 1 ≤ j → ∀ y : Abelian.Ext P0 (Limits.cokernel qq) j, y = 0 :=
    fun j hj => wc_proet_P1_finite_supp_ext_vanish K hP m S hS _ (fun V hV => (hdef V hV).2) j hj

  have hS4 : ∀ (V : (wcP1Over K).left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)) (i : Fin m),
      V.hom (e.inv (IsLocalRing.closedPoint A)) = S i (IsLocalRing.closedPoint K) →
      ∀ f : wcFreeSheaf (wcP1Over K).left V ⟶ Limits.cokernel qq, f = 0 := by
    intro V A _ _ _ e i hv f
    haveI := wc_proet_free_projective_strict_local (wcP1Over K).left V A e
    have hG0 : ∀ g : wcFreeSheaf (wcP1Over K).left V ⟶ G, g = 0 := by
      intro g
      apply (Abelian.Ext.mk₀_bijective _ _).1
      rw [Abelian.Ext.mk₀_zero]
      exact hzero i V A e hv _
    have hJ0 : ∀ g : wcFreeSheaf (wcP1Over K).left V ⟶ Jo, g = 0 := by
      intro g
      rw [← cancel_mono J.arrow, Limits.zero_comp]
      exact hG0 _
    have hB0 : ∀ r (h : wcFreeSheaf (wcP1Over K).left V ⟶ B r), h = 0 := by
      intro r h
      rw [← Projective.factorThru_comp h (π r), hJ0 (Projective.factorThru h (π r)),
        Limits.zero_comp]
    have h1 : Projective.factorThru f (Limits.cokernel.π qq) ≫ Limits.kernel.ι T = 0 := by
      apply Limits.Fan.IsLimit.hom_ext hY
      intro r
      rw [Limits.zero_comp]
      exact hB0 r _
    have h2 : Projective.factorThru f (Limits.cokernel.π qq) = 0 := by
      rw [← cancel_mono (Limits.kernel.ι T), h1, Limits.zero_comp]
    rw [← Projective.factorThru_comp f (Limits.cokernel.π qq), h2, Limits.zero_comp]

  have hC0 : ∀ y : Abelian.Ext P0 (Limits.cokernel qq) 0, y = 0 := by
    intro y
    have huniq : ∀ (i : Fin m) (p p' : (wcGeomPoint K (wcP1Over K) hP).left),
        (wcGeomPoint K (wcP1Over K) hP).hom p = S i (IsLocalRing.closedPoint K) →
        (wcGeomPoint K (wcP1Over K) hP).hom p' = S i (IsLocalRing.closedPoint K) →
        p = p' := by
      intro i p p' hp hp'
      obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
        (g := S i) p (IsLocalRing.closedPoint K) hp
      obtain ⟨z', hz1', -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
        (g := S i) p' (IsLocalRing.closedPoint K) hp'
      haveI : IsIso (S i ≫ (wcP1Over K).hom) := by rw [hS i]; infer_instance
      let e := Limits.pullbackSymmetry (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (S i) ≪≫
        Limits.pullbackRightPullbackFstIso (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) (S i) ≪≫
        asIso (Limits.pullback.snd (S i ≫ (wcP1Over K).hom)
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      have hsub : Subsingleton (Spec (.of (AlgebraicClosure K))) := by
        show Subsingleton (PrimeSpectrum (AlgebraicClosure K))
        infer_instance
      have hzz : z = z' := e.hom.isOpenEmbedding.injective (Subsingleton.elim _ _)
      rw [← hz1, ← hz1', hzz]
    have hloc : ∀ i : Fin m, ∃ (V : (wcP1Over K).left.ProEt)
        (g : V ⟶ wcGeomPoint K (wcP1Over K) hP) (v : V.left),
        V.hom v = S i (IsLocalRing.closedPoint K) ∧
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left g)).comp y (zero_add 0) = 0 := by
      intro i
      obtain ⟨V₀, g₀, -, A, _, _, _, e, -, hv, -⟩ := wc_P1bar_strict_local_nbhd K (S i) (hS i) hP
      refine ⟨V₀, g₀, e.inv (IsLocalRing.closedPoint A), hv, ?_⟩
      have hy0 : ∀ yy : Abelian.Ext (wcFreeSheaf (wcP1Over K).left V₀) (Limits.cokernel qq) 0,
          yy = 0 := by
        intro yy
        rw [← Abelian.Ext.mk₀_addEquiv₀_apply yy, hS4 V₀ A e i hv (Abelian.Ext.addEquiv₀ yy),
          Abelian.Ext.mk₀_zero]
      exact hy0 _
    obtain ⟨x₀, rfl⟩ : ∃ x₀, Abelian.Ext.mk₀ x₀ = y := ⟨_, Abelian.Ext.mk₀_addEquiv₀_apply y⟩
    obtain ⟨η, hη1, hη2⟩ := wc_proet_free_sheaf_yoneda (wcP1Over K).left
    have hy : ∀ (V : (wcP1Over K).left.ProEt) (g : V ⟶ wcGeomPoint K (wcP1Over K) hP),
        (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left g)).comp (Abelian.Ext.mk₀ x₀)
          (zero_add 0) = 0 := by
      intro V g hV
      rw [Abelian.Ext.mk₀_comp_mk₀]
      have h0 : wcFreeSheafMap (wcP1Over K).left g ≫ x₀ = 0 := by
        obtain ⟨g', -, hg'⟩ := hη1 V (Limits.cokernel qq) 0
        have a1 := hg' (wcFreeSheafMap (wcP1Over K).left g ≫ x₀) ((hdef V hV).2 _)
        have a2 := hg' 0 (by simp)
        rw [a1, a2]
      rw [h0, Abelian.Ext.mk₀_zero]
    exact wc_P1_geom_section_zero_of_local K hP (Limits.cokernel qq) m S hS huniq _ hy hloc

  have hfinB : ∀ r, Finite (Abelian.Ext P0 (B r) n) := fun r => hfin r
  have hK : ∀ y : Abelian.Ext P0 (Limits.kernel qq) (n + 1), y = 0 := hKpos (n + 1) (by omega)
  have hCall : ∀ j : ℕ, ∀ y : Abelian.Ext P0 (Limits.cokernel qq) j, y = 0 := by
    intro j
    rcases j with _ | j
    · exact hC0
    · exact hCpos (j + 1) (by omega)
  have hC : ∀ y : Abelian.Ext P0 (Limits.cokernel qq) n, y = 0 := hCall n
  have hprod := fun N => wc_ext_prod_bijective P0 Yt B pr hY N
  have hz' : ∀ r, x.comp (Abelian.Ext.mk₀ (ι ≫ pr r)) (add_zero (n + 1)) = 0 := by
    intro r
    rw [hιpr r]
    exact hx r
  have hsubmk : ∀ {A A' : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (a b : A ⟶ A'), Abelian.Ext.mk₀ (a - b) = Abelian.Ext.mk₀ a - Abelian.Ext.mk₀ b := by
    intro A A' a b
    rw [sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg, ← sub_eq_add_neg]
  have hcompsub : ∀ {A A' A'' : Sheaf (Scheme.ProEt.topology (wcP1Over K).left)
      AddCommGrpCat.{u+1}} {p : ℕ} (α : Abelian.Ext A A' p) (β₁ β₂ : Abelian.Ext A' A'' 0),
      α.comp (β₁ - β₂) (add_zero p) = α.comp β₁ (add_zero p) - α.comp β₂ (add_zero p) := by
    intro A A' A'' p α β₁ β₂
    rw [sub_eq_add_neg, Abelian.Ext.comp_add, Abelian.Ext.comp_neg, ← sub_eq_add_neg]
  have hqf : qq ≫ Limits.kernel.ι T = ι := Limits.kernel.lift_ι _ _ _
  have hS1 : (ShortComplex.mk (Limits.kernel.ι T) T (Limits.kernel.condition T)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel T) inferInstance hTepi
  have hxι : x.comp (Abelian.Ext.mk₀ ι) (add_zero (n + 1)) = 0 := by
    apply (hprod (n + 1)).1
    intro r
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (n + 1)) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]
    exact hz' r
  have hz1' : (x.comp (Abelian.Ext.mk₀ qq) (add_zero (n + 1))).comp
      (Abelian.Ext.mk₀ (Limits.kernel.ι T)) (add_zero (n + 1)) = 0 := by
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (n + 1)) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hqf]
    exact hxι
  obtain ⟨w1, hw1⟩ := Abelian.Ext.covariant_sequence_exact₁ P0 hS1 _ hz1' (n₀ := n) rfl
  have hlim1 : ∃ v : ∀ r, Abelian.Ext P0 (B r) n, ∀ r,
      w1.comp (Abelian.Ext.mk₀ (pr r)) (add_zero n) =
        v r - (v (r + 1)).comp (Abelian.Ext.mk₀ (c r)) (add_zero n) := by
    let E : ℕ → Type _ := fun r => Abelian.Ext P0 (B r) n
    obtain ⟨s, hs⟩ := @nonempty_sections_of_finite_inverse_system ℕ _ _
      (Functor.ofOpSequence (X := E)
        (fun r => TypeCat.ofHom (fun a => w1.comp (Abelian.Ext.mk₀ (pr r)) (add_zero n) +
          a.comp (Abelian.Ext.mk₀ (c r)) (add_zero n))))
      (fun j => hfinB j.unop) (fun j => ⟨(0 : E j.unop)⟩)
    refine ⟨fun r => (s (Opposite.op r) : E r), fun r => ?_⟩
    have h1 := hs (homOfLE (Nat.le_succ r)).op
    rw [Functor.ofOpSequence_map_homOfLE_succ] at h1
    exact eq_sub_of_add_eq h1
  obtain ⟨v, hv⟩ := hlim1
  obtain ⟨V1, hV1⟩ := (hprod n).2 v
  have hVT : V1.comp (Abelian.Ext.mk₀ T) (add_zero n) = w1 := by
    rw [← sub_eq_zero]
    apply (hprod n).1
    intro r
    have hpost : ∀ (a b : Abelian.Ext P0 Yt n),
        (a - b).comp (Abelian.Ext.mk₀ (pr r)) (add_zero n) =
        a.comp (Abelian.Ext.mk₀ (pr r)) (add_zero n) -
          b.comp (Abelian.Ext.mk₀ (pr r)) (add_zero n) := by
      intro a b
      rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg]
    rw [hpost, Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hT r, hsubmk, hcompsub, ← Abelian.Ext.mk₀_comp_mk₀,
      ← Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega), hV1, hV1, hv r,
      sub_self]
  have hz1 : x.comp (Abelian.Ext.mk₀ qq) (add_zero (n + 1)) = 0 := by
    rw [← hw1, ← hVT, Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 1) (by omega),
      hS1.comp_extClass, Abelian.Ext.comp_zero]
  set mm := Limits.kernel.ι (Limits.cokernel.π qq) with hmdef
  set e := Limits.kernel.lift (Limits.cokernel.π qq) qq (Limits.cokernel.condition qq) with hedef
  have hem : e ≫ mm = qq := Limits.kernel.lift_ι _ _ _
  haveI he : Epi e := inferInstanceAs (Epi (Abelian.factorThruImage qq))
  have hS3 : (ShortComplex.mk mm (Limits.cokernel.π mm) (Limits.cokernel.condition mm)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel mm) inferInstance inferInstance
  have hy' : (x.comp (Abelian.Ext.mk₀ e) (add_zero (n + 1))).comp (Abelian.Ext.mk₀ mm)
      (add_zero (n + 1)) = 0 := by
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (n + 1)) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hem]
    exact hz1
  obtain ⟨u1, hu1⟩ := Abelian.Ext.covariant_sequence_exact₁ P0 hS3 _ hy' (n₀ := n) rfl
  have hmq : mm ≫ Limits.cokernel.π qq = 0 := by
    rw [← cancel_epi e, ← Category.assoc, hem, Limits.cokernel.condition, Limits.comp_zero]
  have hqm : qq ≫ Limits.cokernel.π mm = 0 := by
    have h := congrArg (· ≫ Limits.cokernel.π mm) hem
    rw [← h, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  let φ' := Limits.cokernel.desc mm (Limits.cokernel.π qq) hmq
  let ψ' := Limits.cokernel.desc qq (Limits.cokernel.π mm) hqm
  have hφψ : φ' ≫ ψ' = 𝟙 _ := by
    apply Limits.coequalizer.hom_ext
    simp [φ', ψ']
  have hu0 : u1 = 0 := by
    have e1 := Abelian.Ext.comp_mk₀_id u1
    rw [← hφψ, ← Abelian.Ext.mk₀_comp_mk₀,
      ← Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
      hC (u1.comp (Abelian.Ext.mk₀ φ') (add_zero n)), Abelian.Ext.zero_comp] at e1
    exact e1.symm
  have hy : x.comp (Abelian.Ext.mk₀ e) (add_zero (n + 1)) = 0 := by
    rw [← hu1, hu0, Abelian.Ext.zero_comp]
  have hS4' : (ShortComplex.mk (Limits.kernel.ι e) e (Limits.kernel.condition e)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel e) inferInstance he
  obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P0 hS4' x hy
  have hke : Limits.kernel.ι e ≫ qq = 0 := by
    have h := congrArg (Limits.kernel.ι e ≫ ·) hem
    rw [← h, ← Category.assoc, Limits.kernel.condition, Limits.zero_comp]
  let φ := Limits.kernel.lift qq (Limits.kernel.ι e) hke
  have hφ : φ ≫ Limits.kernel.ι qq = Limits.kernel.ι e := Limits.kernel.lift_ι _ _ _
  calc x = x₁.comp (Abelian.Ext.mk₀ (Limits.kernel.ι e)) (add_zero (n + 1)) := hx₁.symm
    _ = (x₁.comp (Abelian.Ext.mk₀ φ) (add_zero (n + 1))).comp
          (Abelian.Ext.mk₀ (Limits.kernel.ι qq)) (add_zero (n + 1)) := by
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (n + 1)) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, hφ]
    _ = 0 := by rw [hK (x₁.comp (Abelian.Ext.mk₀ φ) (add_zero (n + 1))), Abelian.Ext.zero_comp]

theorem wc_h2im_H0_separated (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G)
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin m), W.hom z ≠ S i (IsLocalRing.closedPoint K))
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (k : ℕ) (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫ θ.hom =
      θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map
        (wcConstScalar (wcP1Over K).left ℓ k c))
    (Pm : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (hint : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
      ∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1)
    (J : Subobject G)
    (hJ : ∀ (V : (wcP1Over K).left.ProEt) (s : G.obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : (wcP1Over K).left.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖Pm ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1) :
    ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
      (Subobject.underlying.obj J) 0,
      (∀ r : ℕ, x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π
        ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)))) (add_zero 0) = 0) → x = 0 :=
by
  classical
  intro x hx
  have hℓpos : 0 < ℓ := (Fact.out : ℓ.Prime).pos

  have hσmono : ∀ c : ℚ_[ℓ], c ≠ 0 → Mono (σ c) := by
    intro c hc
    have h : σ c ≫ σ c⁻¹ = 𝟙 G := by rw [← hσmul, inv_mul_cancel₀ hc, hσ1]
    haveI : IsSplitMono (σ c) := IsSplitMono.mk' ⟨σ c⁻¹, h⟩
    infer_instance
  have hσnat : ∀ n : ℕ, σ (n : ℚ_[ℓ]) = n • 𝟙 G := by
    intro n
    induction n with
    | zero =>
      have h := hσadd 0 0
      rw [add_zero] at h
      simpa using h
    | succ n ih => rw [Nat.cast_succ, hσadd, ih, hσ1, succ_nsmul]
  have hmono : ∀ r : ℕ, Mono ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)) := by
    intro r
    have hc : ((ℓ ^ r : ℕ) : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr (pow_ne_zero _ hℓpos.ne')
    haveI := hσmono _ hc
    have e : ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)) ≫ J.arrow =
        J.arrow ≫ σ ((ℓ ^ r : ℕ) : ℚ_[ℓ]) := by
      rw [hσnat, Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp,
        Category.comp_id]
    haveI : Mono (((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)) ≫ J.arrow) := by
      rw [e]; infer_instance
    exact mono_of_mono _ J.arrow

  obtain ⟨x₀, rfl⟩ : ∃ x₀, Abelian.Ext.mk₀ x₀ = x := ⟨_, Abelian.Ext.mk₀_addEquiv₀_apply x⟩
  have hdiv : ∀ r : ℕ, ∃ y : wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) ⟶
      Subobject.underlying.obj J, x₀ = (ℓ ^ r : ℕ) • y := by
    intro r
    have h0 : x₀ ≫ Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)) = 0 := by
      apply (Abelian.Ext.mk₀_bijective _ _).1
      have := hx r
      rw [Abelian.Ext.mk₀_comp_mk₀] at this
      rw [this, Abelian.Ext.mk₀_zero]
    haveI := hmono r
    have hex := ShortComplex.exact_cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))
    refine ⟨hex.lift x₀ h0, ?_⟩
    have := hex.lift_f x₀ h0
    rw [Preadditive.comp_nsmul, Category.comp_id] at this
    exact this.symm
  obtain ⟨x₁, hx₁⟩ : ∃ x₁, x₁ = x₀ ≫ J.arrow := ⟨_, rfl⟩
  obtain ⟨η, hη1, hη2⟩ := wc_proet_free_sheaf_yoneda (wcP1Over K).left

  have hdivσ : ∀ r : ℕ, ∃ t : G.obj.obj (Opposite.op (wcGeomPoint K (wcP1Over K) hP)),
      (∃ u, (J.arrow.hom.app (Opposite.op (wcGeomPoint K (wcP1Over K) hP))).hom u = t) ∧
      (x₁.hom.app (Opposite.op (wcGeomPoint K (wcP1Over K) hP))).hom
        (η (wcGeomPoint K (wcP1Over K) hP)) = (ℓ ^ r : ℕ) • t := by
    intro r
    obtain ⟨y, hy⟩ := hdiv r
    refine ⟨_, ⟨(y.hom.app (Opposite.op (wcGeomPoint K (wcP1Over K) hP))).hom
      (η (wcGeomPoint K (wcP1Over K) hP)), rfl⟩, ?_⟩
    have e1 : x₁ = (ℓ ^ r : ℕ) • (y ≫ J.arrow) := by rw [hx₁, hy, Preadditive.nsmul_comp]
    rw [e1]
    have e2 : ((ℓ ^ r : ℕ) • (y ≫ J.arrow)).hom = (ℓ ^ r : ℕ) • (y ≫ J.arrow).hom := by
      first
        | exact (sheafToPresheaf _ _).map_nsmul
        | rfl
    rw [e2, NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul, AddMonoidHom.nsmul_apply]
    rfl

  have frame : ∀ s : G.obj.obj (Opposite.op W),
      (∀ r : ℕ, ∃ t : G.obj.obj (Opposite.op W), s = (ℓ ^ r : ℕ) • t ∧
        ∀ (z : W.left) (i : Fin k), ‖Pm ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom t).down) z) i‖ ≤ 1) → s = 0 := by
    intro s hs
    have hev : ∀ (a : G.obj.obj (Opposite.op W)) (n : ℕ) (z : W.left),
        (show C(↥W.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom (n • a)).down) z =
        n • (show C(↥W.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom a).down) z := by
      intro a n z
      have h := map_nsmul (θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom n a
      exact congrArg (fun b => (show C(↥W.left, Fin k → ℚ_[ℓ]) from b.down) z) h
    have hf : ∀ (z : W.left) (i : Fin k), Pm ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z) i = 0 := by
      intro z i
      by_contra hne
      have hpos := norm_pos_iff.mpr hne
      obtain ⟨r, hr⟩ := exists_pow_lt_of_lt_one hpos (Padic.norm_p_lt_one (p := ℓ))
      obtain ⟨t, hst, ht⟩ := hs r
      have key : Pm ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z) i =
          ((ℓ ^ r : ℕ) : ℚ_[ℓ]) * Pm ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom t).down) z) i := by
        rw [hst, hev, map_nsmul, Pi.smul_apply, nsmul_eq_mul]
      have hb : ‖Pm ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z) i‖ ≤
          ‖(ℓ : ℚ_[ℓ])‖ ^ r := by
        rw [key, norm_mul, Nat.cast_pow, norm_pow]
        exact mul_le_of_le_one_right (pow_nonneg (norm_nonneg _) _) (ht z i)
      exact absurd hr (not_lt.mpr hb)
    have hz' : (show C(↥W.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) = 0 :=
      ContinuousMap.ext fun z => Pm.map_eq_zero_iff.mp (funext (hf z))
    have hz : (θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s = 0 := ULift.down_injective hz'
    have hinv : (θ.inv.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) = s := by
      have := congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s) θ.hom_inv_id
      exact this
    exact hinv.symm.trans (by
      rw [hz]
      first
        | exact map_zero _
        | (rw [map_zero]; rfl))
  have hW : (G.obj.map w.op).hom ((x₁.hom.app (Opposite.op (wcGeomPoint K (wcP1Over K) hP))).hom
      (η (wcGeomPoint K (wcP1Over K) hP))) = 0 := by
    apply frame
    intro r
    obtain ⟨t, ⟨u, hu⟩, ht⟩ := hdivσ r
    refine ⟨(G.obj.map w.op).hom t, ?_, ?_⟩
    · rw [ht, map_nsmul]
    · intro z i
      exact (hJ _ t).mp ⟨u, hu⟩ W w (𝟙 W) z i

  have huniq : ∀ (i : Fin m) (p p' : (wcGeomPoint K (wcP1Over K) hP).left),
      (wcGeomPoint K (wcP1Over K) hP).hom p = S i (IsLocalRing.closedPoint K) →
      (wcGeomPoint K (wcP1Over K) hP).hom p' = S i (IsLocalRing.closedPoint K) →
      p = p' := by
    intro i p p' hp hp'
    obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      (g := S i) p (IsLocalRing.closedPoint K) hp
    obtain ⟨z', hz1', -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      (g := S i) p' (IsLocalRing.closedPoint K) hp'
    haveI : IsIso (S i ≫ (wcP1Over K).hom) := by rw [hS i]; infer_instance
    let e := Limits.pullbackSymmetry (Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (S i) ≪≫
      Limits.pullbackRightPullbackFstIso (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) (S i) ≪≫
      asIso (Limits.pullback.snd (S i ≫ (wcP1Over K).hom)
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
    have hsub : Subsingleton (Spec (.of (AlgebraicClosure K))) := by
      show Subsingleton (PrimeSpectrum (AlgebraicClosure K))
      infer_instance
    have hzz : z = z' := e.hom.isOpenEmbedding.injective (Subsingleton.elim _ _)
    rw [← hz1, ← hz1', hzz]

  have hloc : ∀ i : Fin m, ∃ (V : (wcP1Over K).left.ProEt)
      (g : V ⟶ wcGeomPoint K (wcP1Over K) hP) (v : V.left),
      V.hom v = S i (IsLocalRing.closedPoint K) ∧
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left g)).comp (Abelian.Ext.mk₀ x₁)
        (zero_add 0) = 0 := by
    intro i
    obtain ⟨V₀, g₀, -, A, _, _, _, e, -, hv, -⟩ := wc_P1bar_strict_local_nbhd K (S i) (hS i) hP
    exact ⟨V₀, g₀, e.inv (IsLocalRing.closedPoint A), hv, hzero i V₀ A e hv _⟩

  have hz0 : ∀ (V : (wcP1Over K).left.ProEt) (g : V ⟶ wcGeomPoint K (wcP1Over K) hP),
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left g)).comp (Abelian.Ext.mk₀ x₁)
        (zero_add 0) = 0 ↔ wcFreeSheafMap (wcP1Over K).left g ≫ x₁ = 0 := by
    intro V g
    rw [Abelian.Ext.mk₀_comp_mk₀]
    constructor
    · intro h
      apply (Abelian.Ext.mk₀_bijective _ _).1
      rw [h, Abelian.Ext.mk₀_zero]
    · intro h
      rw [h, Abelian.Ext.mk₀_zero]
  have hsec : ∀ (V : (wcP1Over K).left.ProEt) (g : V ⟶ wcGeomPoint K (wcP1Over K) hP),
      ((wcFreeSheafMap (wcP1Over K).left g ≫ x₁).hom.app (Opposite.op V)).hom (η V) =
        (G.obj.map g.op).hom
          ((x₁.hom.app (Opposite.op (wcGeomPoint K (wcP1Over K) hP))).hom
            (η (wcGeomPoint K (wcP1Over K) hP))) := by
    intro V g
    have h1 := congrArg (fun φ => AddCommGrpCat.Hom.hom φ (η (wcGeomPoint K (wcP1Over K) hP)))
      (x₁.hom.naturality g.op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at h1
    change (x₁.hom.app (Opposite.op V)).hom
      (((wcFreeSheafMap (wcP1Over K).left g).hom.app (Opposite.op V)).hom (η V)) = _
    rw [hη2 (wcGeomPoint K (wcP1Over K) hP) V g]
    exact h1
  have star : ∀ (V : (wcP1Over K).left.ProEt) (g : V ⟶ wcGeomPoint K (wcP1Over K) hP),
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left g)).comp (Abelian.Ext.mk₀ x₁)
        (zero_add 0) = 0 ↔
      (G.obj.map g.op).hom
          ((x₁.hom.app (Opposite.op (wcGeomPoint K (wcP1Over K) hP))).hom
            (η (wcGeomPoint K (wcP1Over K) hP))) = 0 := by
    intro V g
    rw [hz0, ← hsec]
    constructor
    · intro h
      rw [h]
      simp
    · intro h
      obtain ⟨g', _, hg'⟩ := hη1 V G 0
      have a1 := hg' (wcFreeSheafMap (wcP1Over K).left g ≫ x₁) h
      have a2 := hg' 0 (by simp)
      rw [a1, a2]
  have lift : ∀ (V : (wcP1Over K).left.ProEt) (g : V ⟶ wcGeomPoint K (wcP1Over K) hP)
      (p : V.left), (∀ i : Fin m, V.hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = g.left p := by
    intro V g p hp
    apply hsurj
    intro i
    have e : (wcGeomPoint K (wcP1Over K) hP).hom (g.left p) = V.hom p := by
      rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w g]
    rw [e]
    exact hp i
  have hy : ∀ (V : (wcP1Over K).left.ProEt) (g : V ⟶ wcGeomPoint K (wcP1Over K) hP),
      (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left g)).comp (Abelian.Ext.mk₀ x₁)
        (zero_add 0) = 0 := by
    intro V g hV
    exact (star V g).2 (wc_proet_section_zero_of_qc_image (wcP1Over K).left G
      (wcGeomPoint K (wcP1Over K) hP) W w hqc _ hW V g (fun p => lift V g p (hV p)))
  have hfin := wc_P1_geom_section_zero_of_local K hP G m S hS huniq (Abelian.Ext.mk₀ x₁) hy hloc
  have hx1 : x₁ = 0 := (Abelian.Ext.mk₀_bijective _ _).1 (by rw [hfin, Abelian.Ext.mk₀_zero])
  have hx0 : x₀ = 0 := by
    rw [← cancel_mono J.arrow, ← hx₁, hx1, Limits.zero_comp]
  rw [hx0, Abelian.Ext.mk₀_zero]

theorem wc_h2im_ext_fg_of_mod_sep {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] [HasExt 𝒜]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (P A : 𝒜) (τ : ℤ_[ℓ] → (A ⟶ A)) (hτ : wcRingAct τ)
    (hmono : Mono ((ℓ ^ 1 : ℕ) • 𝟙 A)) (n : ℕ)
    (hfin : Finite (Abelian.Ext P (Limits.cokernel ((ℓ ^ 1 : ℕ) • 𝟙 A)) n))
    (hsep : ∀ x : Abelian.Ext P A n,
      (∀ r : ℕ, x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 A))) (add_zero n) = 0) →
      x = 0) :
    ∃ (k : ℕ) (e : Fin k → Abelian.Ext P A n), ∀ x : Abelian.Ext P A n,
      ∃ c : Fin k → ℤ_[ℓ], x = ∑ i, (e i).comp (Abelian.Ext.mk₀ (τ (c i))) (add_zero n) :=
by
  classical
  obtain ⟨inst, hsmul⟩ := wc_ext_scalar_module τ hτ P n
  letI := inst
  obtain ⟨h1, hadd, hmul⟩ := hτ
  have hτ0 : τ 0 = 0 := by
    have h := hadd 0 0
    rw [add_zero] at h
    have h' : τ 0 + 0 = τ 0 + τ 0 := by rw [add_zero]; exact h
    exact (add_left_cancel h').symm
  have hnat : ∀ m : ℕ, τ (m : ℤ_[ℓ]) = m • 𝟙 A := by
    intro m
    induction m with
    | zero => rw [Nat.cast_zero, hτ0, zero_nsmul]
    | succ m ih => rw [Nat.cast_succ, hadd, ih, h1, succ_nsmul]
  have hpow : ∀ (r : ℕ) (x : Abelian.Ext P A n),
      (ℓ : ℤ_[ℓ]) ^ r • x = x.comp (Abelian.Ext.mk₀ ((ℓ ^ r : ℕ) • 𝟙 A)) (add_zero n) := by
    intro r x
    rw [← Nat.cast_pow, hsmul, hnat]
  have hl : ∀ x : Abelian.Ext P A n,
      (ℓ : ℤ_[ℓ]) • x = x.comp (Abelian.Ext.mk₀ ((ℓ ^ 1 : ℕ) • 𝟙 A)) (add_zero n) := by
    intro x
    rw [← hpow 1 x, pow_one]
  let S₁ := ShortComplex.mk ((ℓ ^ 1 : ℕ) • 𝟙 A) (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 A))
    (Limits.cokernel.condition _)
  have hS₁ : S₁.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel _) hmono inferInstance
  have s5 : ∃ T : Finset (Abelian.Ext P A n), ∀ m : Abelian.Ext P A n,
      ∃ t ∈ T, ∃ m' : Abelian.Ext P A n, m = t + (ℓ : ℤ_[ℓ]) • m' := by
    haveI := Fintype.ofFinite (Abelian.Ext P (Limits.cokernel ((ℓ ^ 1 : ℕ) • 𝟙 A)) n)
    let ρ : Abelian.Ext P A n → Abelian.Ext P (Limits.cokernel ((ℓ ^ 1 : ℕ) • 𝟙 A)) n :=
      fun x => x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 A))) (add_zero n)
    let g : Abelian.Ext P (Limits.cokernel ((ℓ ^ 1 : ℕ) • 𝟙 A)) n → Abelian.Ext P A n :=
      fun y => if h : ∃ x, ρ x = y then h.choose else 0
    refine ⟨Finset.univ.image g, fun m => ?_⟩
    refine ⟨g (ρ m), Finset.mem_image_of_mem g (Finset.mem_univ _), ?_⟩
    have hex : ∃ x, ρ x = ρ m := ⟨m, rfl⟩
    have hg : ρ (g (ρ m)) = ρ m := by
      simp only [g, dif_pos hex]
      exact hex.choose_spec
    have h0 : (m - g (ρ m)).comp (Abelian.Ext.mk₀ S₁.g) (add_zero n) = 0 := by
      show (m - g (ρ m)).comp
        (Abelian.Ext.mk₀ (Limits.cokernel.π ((ℓ ^ 1 : ℕ) • 𝟙 A))) (add_zero n) = 0
      rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp]
      change ρ m + -ρ (g (ρ m)) = 0
      rw [hg, add_neg_cancel]
    obtain ⟨m', hm'⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS₁ (m - g (ρ m)) h0
    refine ⟨m', ?_⟩
    rw [hl]
    have : m'.comp (Abelian.Ext.mk₀ ((ℓ ^ 1 : ℕ) • 𝟙 A)) (add_zero n) = m - g (ρ m) := hm'
    rw [this]
    abel
  have s6 : ∀ w : ℕ → Abelian.Ext P A n, (∀ j, w j = (ℓ : ℤ_[ℓ]) • w (j + 1)) → w 0 = 0 := by
    intro w hw
    have hr : ∀ r : ℕ, w 0 = (ℓ : ℤ_[ℓ]) ^ r • w r := by
      intro r
      induction r with
      | zero => rw [pow_zero, one_smul]
      | succ r ih => rw [ih, hw r, smul_smul, ← pow_succ]
    apply hsep
    intro r
    rw [hr r, hpow r, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
      Limits.cokernel.condition, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  haveI hfg : Module.Finite ℤ_[ℓ] (Abelian.Ext P A n) :=
    padic_fg_of_mod_ell_reps ℓ (Abelian.Ext P A n) s5 s6
  obtain ⟨k, e, he⟩ := Module.Finite.exists_fin (R := ℤ_[ℓ]) (M := Abelian.Ext P A n)
  refine ⟨k, e, fun x => ?_⟩
  have hx : x ∈ Submodule.span ℤ_[ℓ] (Set.range e) := by rw [he]; exact Submodule.mem_top
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℤ_[ℓ]).mp hx
  refine ⟨c, ?_⟩
  rw [← hc]
  exact Finset.sum_congr rfl (fun i _ => hsmul (c i) (e i))

theorem wc_h2im_head_torsion_free (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (A P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (lamA : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} → (A ⟶ A))
    (hmono : ∀ r : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}, r ≠ 0 → Mono (lamA r))
    (I : InjectiveResolution A) (lamI : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} → (I.cocomplex ⟶ I.cocomplex))
    (hI0 : ∀ r, I.ι.f 0 ≫ (lamI r).f 0 = lamA r ≫ I.ι.f 0)
    (T : wcThreeTermModel (((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj I.cocomplex)
        (fun r => ((preadditiveCoyoneda.obj (Opposite.op P)).mapHomologicalComplex
          (ComplexShape.up ℕ)).map (lamI r))) :
    ∀ (a : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) (x : T.M), a • x = 0 → a = 0 ∨ x = 0 :=
by
  intro a x hax
  by_cases ha : a = 0
  · exact Or.inl ha
  right
  haveI : Mono (lamA a) := hmono a ha
  have hd0 : T.d0 x = 0 := by
    have h1 : a • T.d0 x = 0 := by rw [← map_smul, hax, map_zero]
    funext i
    have h2 := congrFun h1 i
    rw [Pi.smul_apply, smul_eq_mul] at h2
    exact (mul_eq_zero.mp h2).resolve_left ha
  obtain ⟨φ, hφdef⟩ : ∃ φ : P ⟶ I.cocomplex.X 0, φ = T.α0 x := ⟨_, rfl⟩
  have hφ : φ ≫ I.cocomplex.d 0 1 = 0 := by
    have h := T.hc0 x
    rw [hd0, map_zero] at h
    rw [hφdef]
    exact h
  have hφa : φ ≫ (lamI a).f 0 = 0 := by
    have h := T.hlin0 a x
    rw [hax, map_zero] at h
    rw [hφdef]
    exact h.symm
  have hIm : Mono (I.ι.f 0) := inferInstance
  obtain ⟨ι0, hι0m, ⟨ψ, hψ⟩, hcomm⟩ : ∃ ι0 : A ⟶ I.cocomplex.X 0, Mono ι0 ∧
      (∃ ψ : P ⟶ A, ψ ≫ ι0 = φ) ∧ ι0 ≫ (lamI a).f 0 = lamA a ≫ ι0 :=
    ⟨I.ι.f 0, hIm, ⟨I.exact₀.lift φ hφ, I.exact₀.lift_f φ hφ⟩, hI0 a⟩
  have h3 : (ψ ≫ lamA a) ≫ ι0 = 0 := by
    rw [Category.assoc, ← hcomm, ← Category.assoc, hψ, hφa]
  have h4 : ψ ≫ lamA a = 0 := Limits.zero_of_comp_mono ι0 h3
  have h5 : ψ = 0 := Limits.zero_of_comp_mono (lamA a) h4
  have hφ0 : φ = 0 := by
    rw [← hψ, h5, Limits.zero_comp]
  exact T.q0i x hd0 (hφdef ▸ hφ0)

theorem wc_h2im_punit_tf_projective (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (M : Type*) [AddCommGroup M]
    [Module (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) M] [Module.Finite (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) M]
    (htf : ∀ (a : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) (x : M), a • x = 0 → a = 0 ∨ x = 0) :
    Module.Projective (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) M :=
by
  classical
  have hsurj : Function.Surjective (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1})) := by
    intro x
    induction x using MonoidAlgebra.induction_linear with
    | zero => exact ⟨0, map_zero _⟩
    | add x y hx hy =>
      obtain ⟨a, ha⟩ := hx
      obtain ⟨b, hb⟩ := hy
      exact ⟨a + b, by rw [map_add, ha, hb]⟩
    | single m r =>
      refine ⟨r, ?_⟩
      rw [MonoidAlgebra.coe_algebraMap]
      rfl
  have : IsDomain (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) := inferInstance
  have : IsPrincipalIdealRing (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) :=
    IsPrincipalIdealRing.of_surjective _ hsurj
  have : Module.IsTorsionFree (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) M :=
    Module.isTorsionFree_iff_smul_eq_zero.mpr htf
  have : Module.Free (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) M := Module.free_of_finite_type_torsion_free'
  exact Module.Projective.of_free

theorem wc_h2_integral_model (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G)
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP) (k : ℕ)
    (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (Pm : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])) (J : Subobject G)
    (hF : wcH2Frame K hP ℓ m S G σ W w k θ Pm J) :
    ∃ (M : wcGModel ℓ PUnit.{u+1}) (Ψ : wcGModelAb M ⟶ wcCx K hP (Subobject.underlying.obj J)),
      QuasiIso Ψ ∧
      Nonempty (Homotopy (Ψ ≫ wcCxFrob K hP (Subobject.underlying.obj J)) (wcGModelFrob M ≫ Ψ)) :=
by
  classical
  obtain ⟨hqc, hconn, hoff, hsurj, hθ, hint, hJ⟩ := hF
  have hℓpos : 0 < ℓ := (Fact.out : ℓ.Prime).pos

  obtain ⟨τ, hτ⟩ := wc_lcfa_lattice_int_stable K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero W w
    hqc hconn hoff hsurj k θ hθ Pm hint J hJ
  have hτ1 : τ 1 = 𝟙 _ := by
    rw [← cancel_mono J.arrow, hτ, PadicInt.coe_one, hσ1, Category.id_comp, Category.comp_id]
  have hτadd : ∀ a b, τ (a + b) = τ a + τ b := by
    intro a b
    rw [← cancel_mono J.arrow, hτ (a + b), PadicInt.coe_add, hσadd, Preadditive.comp_add,
      Preadditive.add_comp, hτ a, hτ b]
  have hτmul : ∀ a b, τ (a * b) = τ b ≫ τ a := by
    intro a b
    rw [← cancel_mono J.arrow, Category.assoc, hτ a, reassoc_of% (hτ b), hτ (a * b),
      PadicInt.coe_mul, hσmul]
  have hτact : wcRingAct τ := ⟨hτ1, hτadd, hτmul⟩

  have hσmono : ∀ c : ℚ_[ℓ], c ≠ 0 → Mono (σ c) := by
    intro c hc
    have h : σ c ≫ σ c⁻¹ = 𝟙 G := by rw [← hσmul, inv_mul_cancel₀ hc, hσ1]
    haveI : IsSplitMono (σ c) := IsSplitMono.mk' ⟨σ c⁻¹, h⟩
    infer_instance
  have hτmono : ∀ c : ℤ_[ℓ], c ≠ 0 → Mono (τ c) := by
    intro c hc
    have hc' : (c : ℚ_[ℓ]) ≠ 0 := by rwa [Ne, PadicInt.coe_eq_zero]
    haveI := hσmono _ hc'
    haveI : Mono (τ c ≫ J.arrow) := by rw [hτ]; infer_instance
    exact mono_of_mono _ J.arrow
  have hτnat : ∀ n : ℕ, τ (n : ℤ_[ℓ]) = n • 𝟙 _ := by
    intro n
    induction n with
    | zero =>
      have h := hτadd 0 0
      rw [add_zero] at h
      simpa using h
    | succ n ih => rw [Nat.cast_succ, hτadd, ih, hτ1, succ_nsmul]
  have hℓmono : ∀ r : ℕ, Mono ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)) := by
    intro r
    rw [← hτnat]
    exact hτmono _ (Nat.cast_ne_zero.mpr (pow_ne_zero _ hℓpos.ne'))

  obtain ⟨ev, hev1, hev2⟩ : ∃ ev : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} →+* ℤ_[ℓ],
      (∀ r, algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) (ev r) = r) ∧
      ∀ c, ev (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) c) = c := by
    refine ⟨(MonoidAlgebra.lift ℤ_[ℓ] ℤ_[ℓ] PUnit.{u+1} 1).toRingHom, ?_, ?_⟩
    · intro r
      show algebraMap _ _ (MonoidAlgebra.lift ℤ_[ℓ] ℤ_[ℓ] PUnit.{u+1} 1 r) = r
      induction r using MonoidAlgebra.induction_linear with
      | zero => simp
      | add x y hx hy => rw [map_add, map_add, hx, hy]
      | single g a =>
        rw [MonoidAlgebra.lift_single]
        simp
    · intro c
      show MonoidAlgebra.lift ℤ_[ℓ] ℤ_[ℓ] PUnit.{u+1} 1 (algebraMap _ _ c) = c
      rw [AlgHom.commutes]
      rfl
  obtain ⟨lamJ, hlamJdef⟩ : ∃ f : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1} →
      (Subobject.underlying.obj J ⟶ Subobject.underlying.obj J), ∀ r, f r = τ (ev r) :=
    ⟨fun r => τ (ev r), fun _ => rfl⟩
  have hlamJ : wcRingAct lamJ := by
    refine ⟨?_, ?_, ?_⟩
    · simp only [hlamJdef, map_one, hτ1]
    · intro a b
      simp only [hlamJdef, map_add, hτadd]
    · intro a b
      simp only [hlamJdef, map_mul, hτmul]
  have hlamJmono : ∀ r : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}, r ≠ 0 → Mono (lamJ r) := by
    intro r hr
    rw [hlamJdef]
    apply hτmono
    intro h0
    apply hr
    rw [← hev1 r, h0, map_zero]
  have hlamJalg : ∀ c : ℤ_[ℓ], lamJ (algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) c) = τ c := by
    intro c
    rw [hlamJdef, hev2]

  have hR : ∀ (n : ℕ) (r : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}), 0 < n →
      (n : MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) * r = 0 → r = 0 := by
    intro n r hn h
    have h2 := congrArg ev h
    rw [map_mul, map_natCast, map_zero] at h2
    have h3 : ev r = 0 := (mul_eq_zero.mp h2).resolve_left (Nat.cast_ne_zero.mpr hn.ne')
    rw [← hev1 r, h3, map_zero]
  obtain ⟨I, lamI, hspec⟩ := wc_ring_injective_resolution (wcP1Over K).left
    (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) hR (Subobject.underlying.obj J) lamJ hlamJ
  obtain ⟨hIact, hI0, -⟩ := hspec
  obtain ⟨hIone, hIadd, hImul⟩ := hIact

  set E := (preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
    (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex (ComplexShape.up ℕ) with hEdef
  set 𝔉 := NatTrans.mapHomologicalComplex (preadditiveCoyoneda.map
    (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)).op)
    (ComplexShape.up ℕ) with h𝔉def
  have hLD : wcRingAct (fun r => E.map (lamI r)) := by
    refine ⟨?_, ?_, ?_⟩
    · show E.map (lamI 1) = 𝟙 _
      rw [hIone, CategoryTheory.Functor.map_id]
    · intro a b
      show E.map (lamI (a + b)) = E.map (lamI a) + E.map (lamI b)
      rw [hIadd, Functor.map_add]
    · intro a b
      show E.map (lamI (a * b)) = E.map (lamI b) ≫ E.map (lamI a)
      rw [hImul, Functor.map_comp]
  have hFr : ∀ r, (fun r => E.map (lamI r)) r ≫ 𝔉.app I.cocomplex =
      𝔉.app I.cocomplex ≫ (fun r => E.map (lamI r)) r := fun r => 𝔉.naturality (lamI r)

  have hmodfin := wc_lcfa_mod_finite K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero W w
    hqc hconn hoff hsurj k θ hθ Pm hint J hJ
  have hLr : ∀ r : ℕ, (ℓ ^ r : ℕ) •
      𝟙 (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))) = 0 := by
    intro r
    have h1 := Limits.cokernel.condition ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))
    rw [Preadditive.nsmul_comp, Category.id_comp] at h1
    rw [← cancel_epi (Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))),
      Limits.comp_zero, Preadditive.comp_nsmul, Category.comp_id]
    exact h1
  have hne : Nonempty W.left := @ConnectedSpace.toNonempty _ _ hconn

  have h7a : ∀ (r j : ℕ), 3 ≤ j → ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP))
      (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))) j, x = 0 := by
    intro r j hj x
    obtain ⟨θr, -⟩ := wc_qclift_level_frame K hP ℓ G W hne k θ Pm hint J hJ r
    exact wc_h2im_torsion_ext_high_vanish K ℓ hℓ hP m S hS _ r (hLr r) W w hqc hconn hsurj k θr
      j hj x

  have hvanJ : ∀ n, 3 ≤ n → ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP)) (Subobject.underlying.obj J) n, x = 0 := by
    intro n hn x
    obtain ⟨n', rfl⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
    have hfin' : ∀ r : ℕ, Finite (Abelian.Ext (wcFreeSheaf (wcP1Over K).left
        (wcGeomPoint K (wcP1Over K) hP))
        (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))) n') := by
      intro r
      rcases (show n' = 2 ∨ 3 ≤ n' by omega) with h | h
      · subst h
        exact hmodfin r 2 le_rfl
      · haveI : Subsingleton (Abelian.Ext (wcFreeSheaf (wcP1Over K).left
            (wcGeomPoint K (wcP1Over K) hP))
            (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))) n') :=
          ⟨fun a b => by rw [h7a r n' h a, h7a r n' h b]⟩
        exact Finite.of_subsingleton
    exact wc_h2im_int_separated_succ K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero W w
      hqc hconn hoff hsurj k θ hθ Pm hint J hJ n' hfin' x (fun r => h7a r (n' + 1) hn _)

  have hsep : ∀ n, n ≤ 2 → ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP)) (Subobject.underlying.obj J) n,
      (∀ r : ℕ, x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π
        ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)))) (add_zero n) = 0) → x = 0 := by
    intro n hn x hx
    rcases n with _ | n
    · exact wc_h2im_H0_separated K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero W w
        hqc hconn hoff hsurj k θ hθ Pm hint J hJ x hx
    · exact wc_lcfa_int_separated K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero W w
        hqc hconn hoff hsurj k θ hθ Pm hint J hJ (fun r i hi => hmodfin r i (by omega))
        (n + 1) (by omega) hn x hx

  have hfg : ∀ n, ∃ (k' : ℕ) (e : Fin k' → Abelian.Ext (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP)) (Subobject.underlying.obj J) n),
      ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left
        (wcGeomPoint K (wcP1Over K) hP)) (Subobject.underlying.obj J) n,
      ∃ c : Fin k' → MonoidAlgebra ℤ_[ℓ] PUnit.{u+1},
        x = ∑ i, (e i).comp (Abelian.Ext.mk₀ (lamJ (c i))) (add_zero n) := by
    intro n
    rcases (show n ≤ 2 ∨ 3 ≤ n by omega) with hn | hn
    · obtain ⟨k', e', he'⟩ := wc_h2im_ext_fg_of_mod_sep ℓ
        (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
        (Subobject.underlying.obj J) τ hτact (hℓmono 1) n (hmodfin 1 n hn) (hsep n hn)
      refine ⟨k', e', fun x => ?_⟩
      obtain ⟨c, hc⟩ := he' x
      refine ⟨fun i => algebraMap ℤ_[ℓ] (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) (c i), ?_⟩
      simp only [hlamJalg]
      exact hc
    · refine ⟨0, Fin.elim0, fun x => ⟨Fin.elim0, ?_⟩⟩
      rw [hvanJ n hn x, Finset.univ_eq_empty, Finset.sum_empty]

  have hfv := wc_fgvan_of_ext_fg lamJ I lamI hI0
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) hfg hvanJ

  obtain ⟨T⟩ := wc_three_term_model_exists ℓ PUnit.{u+1} (E.obj I.cocomplex)
    (fun r => E.map (lamI r)) hLD hfv
  have htf := wc_h2im_head_torsion_free (wcP1Over K).left ℓ (Subobject.underlying.obj J)
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) lamJ hlamJmono I lamI hI0 T
  haveI : Module.Finite (MonoidAlgebra ℤ_[ℓ] PUnit.{u+1}) T.M := T.fin
  have hproj := wc_h2im_punit_tf_projective ℓ T.M htf
  obtain ⟨M, φ, hq, -, ⟨h'⟩⟩ := wc_gmodel_of_projective_head ℓ PUnit.{u+1} (E.obj I.cocomplex)
    (fun r => E.map (lamI r)) hLD (𝔉.app I.cocomplex) hFr T hproj

  let c := InjectiveResolution.homotopyEquiv I (injectiveResolution (Subobject.underlying.obj J))
  have hEc : QuasiIso (E.map c.hom) := by
    have h := HomotopyEquiv.quasiIso_hom
      ((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
        (wcGeomPoint K (wcP1Over K) hP)))).mapHomotopyEquiv c)
    rw [Functor.mapHomotopyEquiv_hom] at h
    exact h
  have nat : E.map c.hom ≫ 𝔉.app (injectiveResolution (Subobject.underlying.obj J)).cocomplex =
      𝔉.app I.cocomplex ≫ E.map c.hom := 𝔉.naturality c.hom
  refine ⟨M, φ ≫ E.map c.hom, ?_, ⟨?_⟩⟩
  · haveI := hq
    haveI := hEc
    exact quasiIso_comp (φ := φ) (φ' := E.map c.hom)
  · refine (Homotopy.ofEq ?_).trans ((h'.symm.compRight (E.map c.hom)).trans (Homotopy.ofEq ?_))
    · exact (Category.assoc _ _ _).trans ((congrArg (φ ≫ ·) nat).trans (Category.assoc _ _ _).symm)
    · exact Category.assoc _ _ _

theorem wc_lcfa_rationalize_kernel (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G)
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin m), W.hom z ≠ S i (IsLocalRing.closedPoint K))
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (k : ℕ) (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫ θ.hom =
      θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map
        (wcConstScalar (wcP1Over K).left ℓ k c))
    (Pm : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (hint : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
      ∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1)
    (J : Subobject G)
    (hJ : ∀ (V : (wcP1Over K).left.ProEt) (s : G.obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : (wcP1Over K).left.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖Pm ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1) :
    ∀ (i : ℕ) (x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
        (Subobject.underlying.obj J) i),
      x.comp (Abelian.Ext.mk₀ J.arrow) (add_zero i) = 0 → ∃ N : ℕ, (ℓ ^ N : ℕ) • x = 0 :=
by
  classical
  intro i x hx


  have hKer : ∀ (S : Scheme.{u}) (U : S.ProEt) [CompactSpace U.left] [QuasiSeparatedSpace U.left]
      (j : ℕ) (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (n : ℕ)
      (y : Abelian.Ext (wcFreeSheaf S U) (G.obj n) j),
      y.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G n)) (add_zero j) = 0 →
      ∃ (m : ℕ) (hnm : n ≤ m), y.comp (Abelian.Ext.mk₀ (G.map (homOfLE hnm))) (add_zero j) = 0 := by
    intro S U _ _ j
    haveI hex : HasExactColimitsOfShape ℕ (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
      @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _ (Scheme.ProEt.topology S) _ _ _
        (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
          (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))
    have H0 : ∀ (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (c : Limits.Cocone G), Limits.IsColimit c →
        ∀ g : wcFreeSheaf S U ⟶ c.pt, ∃ (n : ℕ) (g' : wcFreeSheaf S U ⟶ G.obj n),
          g = g' ≫ c.ι.app n :=
      fun G c hc => (proet_free_hom_seq_colimit S U G c hc).1
    have H0' : ∀ (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (c : Limits.Cocone G), Limits.IsColimit c →
        ∀ (n : ℕ) (g' : wcFreeSheaf S U ⟶ G.obj n), g' ≫ c.ι.app n = 0 →
          ∃ (m : ℕ) (hnm : n ≤ m), g' ≫ G.map (homOfLE hnm) = 0 :=
      fun G c hc => (proet_free_hom_seq_colimit S U G c hc).2
    have H1 : ∀ G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
        ∃ (I : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (α : G ⟶ I),
          Mono α ∧ (∀ n, Injective (I.obj n)) ∧ ∀ (c : Limits.Cocone I), Limits.IsColimit c →
            ∀ (k : ℕ) (x : Abelian.Ext (wcFreeSheaf S U) c.pt (k + 1)), x = 0 := by
      intro G
      obtain ⟨I, α, hα, hI⟩ := injective_tower_of_tower G
      exact ⟨I, α, hα, hI, fun c hc k x => proet_ext_colimit_injectives_vanish S U I hI c hc k x⟩
    have hinj0 : ∀ {A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (a b : A ⟶ B),
        (Abelian.Ext.mk₀ a : Abelian.Ext A B 0) = Abelian.Ext.mk₀ b → a = b := by
      intro A B a b h
      rw [← Abelian.Ext.homEquiv₀_symm_apply, ← Abelian.Ext.homEquiv₀_symm_apply] at h
      exact Abelian.Ext.homEquiv₀.symm.injective h
    induction j with
    | zero =>
      intro G n y hy
      have hg : Abelian.Ext.homEquiv₀ y ≫ Limits.colimit.ι G n = 0 := by
        rw [← Abelian.Ext.mk₀_eq_zero_iff, ← Abelian.Ext.mk₀_comp_mk₀,
          Abelian.Ext.mk₀_homEquiv₀_apply]
        exact hy
      obtain ⟨m, hnm, hm⟩ :=
        H0' G (Limits.colimit.cocone G) (Limits.colimit.isColimit G) n _ hg
      refine ⟨m, hnm, ?_⟩
      rw [← Abelian.Ext.mk₀_homEquiv₀_apply y, Abelian.Ext.mk₀_comp_mk₀, hm, Abelian.Ext.mk₀_zero]
    | succ j ih =>
      intro G n y hy
      obtain ⟨I, α, hα, hinj, hvan⟩ := H1 G
      let S' : ShortComplex (ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
        ShortComplex.mk α (Limits.cokernel.π α) (Limits.cokernel.condition α)
      have hS : S'.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel α) hα inferInstance
      have hSc : (S'.map Limits.colim).ShortExact := hS.map_of_exact Limits.colim
      have hSn : (S'.map ((evaluation ℕ _).obj n)).ShortExact := hS.map_of_exact _
      have hyα : y.comp (Abelian.Ext.mk₀ (S'.map ((evaluation ℕ _).obj n)).f) (add_zero _) = 0 := by
        haveI : Injective (S'.map ((evaluation ℕ _).obj n)).X₂ := hinj n
        exact Abelian.Ext.eq_zero_of_injective _
      obtain ⟨z, hz⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hSn y hyα (n₀ := j) rfl
      let φ : S'.map ((evaluation ℕ _).obj n) ⟶ S'.map Limits.colim :=
        ShortComplex.homMk (Limits.colimit.ι G n) (Limits.colimit.ι I n)
          (Limits.colimit.ι (Limits.cokernel α) n)
          (Limits.colimit.ι_map α n) (Limits.colimit.ι_map _ n)
      have hnat : hSn.extClass.comp (Abelian.Ext.mk₀ (Limits.colimit.ι G n)) (add_zero 1) =
          (Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) n)).comp hSc.extClass
            (zero_add 1) := hSn.extClass_naturality hSc φ
      have hz' : (z.comp (Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) n))
          (add_zero j)).comp hSc.extClass rfl = 0 := by
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero j) (zero_add 1) (by omega), ← hnat,
          ← Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega), hz]
        exact hy
      obtain ⟨w, hw⟩ := Abelian.Ext.covariant_sequence_exact₃ _ hSc _ rfl hz'
      have hD : ∃ (M : ℕ) (hnM : n ≤ M) (u : Abelian.Ext (wcFreeSheaf S U) (I.obj M) j),
          z.comp (Abelian.Ext.mk₀ ((Limits.cokernel α).map (homOfLE hnM))) (add_zero j) =
            u.comp (Abelian.Ext.mk₀ ((Limits.cokernel.π α).app M)) (add_zero j) := by
        cases j with
        | succ k =>
          have hw0 : w = 0 := hvan (Limits.colimit.cocone I) (Limits.colimit.isColimit I) k w
          have hz'0 : z.comp (Abelian.Ext.mk₀ (Limits.colimit.ι (Limits.cokernel α) n))
              (add_zero _) = 0 := by
            rw [← hw, hw0, Abelian.Ext.zero_comp]
          obtain ⟨M, hnM, hM⟩ := ih (Limits.cokernel α) n z hz'0
          exact ⟨M, hnM, 0, hM.trans (by rw [Abelian.Ext.zero_comp])⟩
        | zero =>
          obtain ⟨z₀, rfl⟩ : ∃ z₀, z = Abelian.Ext.mk₀ z₀ :=
            ⟨_, (Abelian.Ext.mk₀_homEquiv₀_apply z).symm⟩
          obtain ⟨w₀, rfl⟩ : ∃ w₀, w = Abelian.Ext.mk₀ w₀ :=
            ⟨_, (Abelian.Ext.mk₀_homEquiv₀_apply w).symm⟩
          rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀] at hw
          have hE : w₀ ≫ Limits.colim.map (Limits.cokernel.π α) =
              z₀ ≫ Limits.colimit.ι (Limits.cokernel α) n := hinj0 _ _ hw
          obtain ⟨n', w', hw'⟩ := H0 I (Limits.colimit.cocone I) (Limits.colimit.isColimit I) w₀
          have hw'' : w₀ = w' ≫ Limits.colimit.ι I n' := hw'
          obtain ⟨N, hnN, hn'N⟩ : ∃ N, n ≤ N ∧ n' ≤ N :=
            ⟨max n n', le_max_left _ _, le_max_right _ _⟩
          have e1 : z₀ ≫ (Limits.cokernel α).map (homOfLE hnN) ≫
              Limits.colimit.ι (Limits.cokernel α) N =
              z₀ ≫ Limits.colimit.ι (Limits.cokernel α) n := by
            rw [Limits.colimit.w]
          have e2 : w' ≫ I.map (homOfLE hn'N) ≫ (Limits.cokernel.π α).app N ≫
              Limits.colimit.ι (Limits.cokernel α) N =
              w₀ ≫ Limits.colim.map (Limits.cokernel.π α) := by
            rw [← Limits.colimit.ι_map, Limits.colimit.w_assoc, hw'', Category.assoc]
          have hd : (z₀ ≫ (Limits.cokernel α).map (homOfLE hnN) -
              w' ≫ I.map (homOfLE hn'N) ≫ (Limits.cokernel.π α).app N) ≫
              Limits.colimit.ι (Limits.cokernel α) N = 0 := by
            simp only [Preadditive.sub_comp, Category.assoc]
            rw [e1, e2, hE, sub_self]
          obtain ⟨M, hNM, hM⟩ := H0' (Limits.cokernel α) (Limits.colimit.cocone _)
            (Limits.colimit.isColimit _) N _ hd
          refine ⟨M, hnN.trans hNM,
            Abelian.Ext.mk₀ (w' ≫ I.map (homOfLE (hn'N.trans hNM))), ?_⟩
          rw [Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀]
          congr 1
          have q1 : (Limits.cokernel α).map (homOfLE (hnN.trans hNM)) =
              (Limits.cokernel α).map (homOfLE hnN) ≫ (Limits.cokernel α).map (homOfLE hNM) := by
            rw [← Functor.map_comp, homOfLE_comp]
          have q2 : I.map (homOfLE (hn'N.trans hNM)) =
              I.map (homOfLE hn'N) ≫ I.map (homOfLE hNM) := by
            rw [← Functor.map_comp, homOfLE_comp]
          have q3 : (Limits.cokernel.π α).app N ≫ (Limits.cokernel α).map (homOfLE hNM) =
              I.map (homOfLE hNM) ≫ (Limits.cokernel.π α).app M :=
            ((Limits.cokernel.π α).naturality (homOfLE hNM)).symm
          rw [Preadditive.sub_comp, sub_eq_zero] at hM
          rw [q1, q2]
          simp only [Category.assoc] at hM ⊢
          rw [hM, q3]
      obtain ⟨M, hnM, u, hu⟩ := hD
      have hSM : (S'.map ((evaluation ℕ _).obj M)).ShortExact := hS.map_of_exact _
      let ψ : S'.map ((evaluation ℕ _).obj n) ⟶ S'.map ((evaluation ℕ _).obj M) :=
        ShortComplex.homMk (G.map (homOfLE hnM)) (I.map (homOfLE hnM))
          ((Limits.cokernel α).map (homOfLE hnM))
          (α.naturality (homOfLE hnM)) ((Limits.cokernel.π α).naturality (homOfLE hnM))
      have hnat' : hSn.extClass.comp (Abelian.Ext.mk₀ (G.map (homOfLE hnM))) (add_zero 1) =
          (Abelian.Ext.mk₀ ((Limits.cokernel α).map (homOfLE hnM))).comp hSM.extClass
            (zero_add 1) := hSn.extClass_naturality hSM ψ
      have h0 : (Abelian.Ext.mk₀ ((Limits.cokernel.π α).app M)).comp hSM.extClass (zero_add 1) = 0 :=
        hSM.comp_extClass
      refine ⟨M, hnM, ?_⟩
