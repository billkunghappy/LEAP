  have hAσ : ∀ l (c : ℚ_[ℓ]),
      ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1}
        (wcGeomPoint K (wcP1Over K) hP)).map (σ c) ≫ φl l = φl l ≫ scal c := by
    intro l c
    have hσθ : ∀ (V : (wcP1Over K).left.ProEt) (h' : V ⟶ W) (y : G.obj.obj (Opposite.op V))
        (z : V.left), gv V h' (((σ c).hom.app (Opposite.op V)).hom y) z = c • gv V h' y z :=
      fun V h' y z => congrArg (fun F => (show C(↥V.left, ι' → ℚ_[ℓ]) from
