        (wcGeomPoint K (wcP1Over K) hP)).map (σ c) ≫ φl l) (φl l ≫ scal c) (by
      intro V h' y z
      rw [Category.comp_id]
      calc E V (h' ≫ w) y z (((Scheme.ProEt.topology (wcP1Over K).left).overPullback
              AddCommGrpCat.{u+1} (wcGeomPoint K (wcP1Over K) hP)).map (σ c) ≫ φl l)
          = E V (h' ≫ w) (((σ c).hom.app (Opposite.op V)).hom y) z (φl l) := rfl
        _ = ∑ i, T l i * gv V h' (((σ c).hom.app (Opposite.op V)).hom y) z i := hEφ _ _ _ _ _
