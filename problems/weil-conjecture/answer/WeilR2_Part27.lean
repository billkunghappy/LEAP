  have hTf := wcU_sms_trunc_map_func (wcCxJ K hP I.cocomplex) (ℓ ^ n)
  have hWact : wcRingAct (fun x => wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n)
      (wcCxJMap K hP (lamI x))) :=
    ⟨by show wcSpfTruncMap _ _ (wcCxJMap K hP (lamI 1)) = _; rw [hD1]; exact hTf.1,
