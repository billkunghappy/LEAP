  have tL3 : ∀ p, wcSpfBarL A lamA ρ p ≫ wcSpfBarR A lamA ρ (p + 1) =
      wcSpfBarR A lamA ρ p ≫ wcSpfBarL A lamA ρ (p + 1) := by
    intro p
    apply Limits.Pi.hom_ext; rintro ⟨f, j⟩
    simp only [wcSpfBarL, wcSpfBarR, Category.assoc, Limits.Pi.lift_comp_π,
      Limits.Pi.lift_comp_π_assoc, Preadditive.comp_sum, Preadditive.sum_comp,
      Preadditive.comp_nsmul, Preadditive.nsmul_comp, Fin.succ_last, Fin.succ_castSucc,
