      (hCOV n hn) (hα n) ℓ n r (ρ n) hn d x hx b.N e (Nat.mem_divisors.mp hd).1 v g hv1 hv2 hv3
    have hTB : T = (B ^ (e / d)).trace := PadicInt.ext (hT.trans (hB (e / d)))
    rw [hTB, hmod n hn (e / d) Rm θ hθ, htr]

theorem wc_lcfa_lattice_int_stable (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G)
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin m), W.hom z ≠ S i (IsLocalRing.closedPoint K))
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (k : ℕ) (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫ θ.hom =
      θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map
        (wcConstScalar (wcP1Over K).left ℓ k c))
    (Pm : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (hint : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
      ∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1)
    (J : Subobject G)
    (hJ : ∀ (V : (wcP1Over K).left.ProEt) (s : G.obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : (wcP1Over K).left.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖Pm ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1) :
    ∃ τ : ℤ_[ℓ] → (Subobject.underlying.obj J ⟶ Subobject.underlying.obj J),
      ∀ c : ℤ_[ℓ], τ c ≫ J.arrow = J.arrow ≫ σ (c : ℚ_[ℓ]) :=
by
  classical

  have hinj : ∀ X : ((wcP1Over K).left.ProEt)ᵒᵖ,
      Function.Injective (J.arrow.hom.app X).hom := by
    intro X
    exact (AddCommGrpCat.mono_iff_injective _).mp
      (Functor.map_mono (sheafToPresheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1} ⋙ (evaluation _ AddCommGrpCat.{u+1}).obj X) J.arrow)

  have hframe : ∀ (c : ℚ_[ℓ]) (V : (wcP1Over K).left.ProEt) (b : V ⟶ W)
      (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
            (((σ c).hom.app (Opposite.op V)).hom x)).down) z =
        c • (show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z := by
    intro c V b x z
    have h : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          (((σ c).hom.app (Opposite.op V)).hom x) =
        ((wcConstScalar (wcP1Over K).left ℓ k c).hom.app (Opposite.op V)).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x) :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk b))).hom x) (hθ c)
    rw [h]
    rfl

  have hstab : ∀ (c : ℤ_[ℓ]) (X : ((wcP1Over K).left.ProEt)ᵒᵖ)
      (t : (Subobject.underlying.obj J).obj.obj X),
      ∃ t', (J.arrow.hom.app X).hom t' =
        ((σ (c : ℚ_[ℓ])).hom.app X).hom ((J.arrow.hom.app X).hom t) := by
    intro c X t
    refine (hJ X.unop _).mpr ?_
    intro V' c' b z i
    have hnat : (G.obj.map c'.op).hom (((σ (c : ℚ_[ℓ])).hom.app X).hom
        ((J.arrow.hom.app X).hom t)) =
        ((σ (c : ℚ_[ℓ])).hom.app (Opposite.op V')).hom
          ((G.obj.map c'.op).hom ((J.arrow.hom.app X).hom t)) :=
      (NatTrans.naturality_apply (σ (c : ℚ_[ℓ])).hom c'.op _).symm
    rw [hnat, hframe, LinearEquiv.map_smul, Pi.smul_apply, smul_eq_mul, norm_mul]
    have h1 : ‖(c : ℚ_[ℓ])‖ ≤ 1 := by
      rw [← PadicInt.norm_def]; exact PadicInt.norm_le_one c
    have h2 := (hJ X.unop ((J.arrow.hom.app X).hom t)).mp ⟨t, rfl⟩ V' c' b z i
    calc _ ≤ 1 * 1 := mul_le_mul h1 h2 (norm_nonneg _) zero_le_one
      _ = 1 := one_mul 1

  have hlift : ∀ c : ℤ_[ℓ], ∃ φ : Subobject.underlying.obj J ⟶ Subobject.underlying.obj J,
      φ ≫ J.arrow = J.arrow ≫ σ (c : ℚ_[ℓ]) := by
    intro c
    choose φ₀ hφ₀ using hstab c
    have hadd : ∀ X (a a' : (Subobject.underlying.obj J).obj.obj X),
        φ₀ X (a + a') = φ₀ X a + φ₀ X a' := by
      intro X a a'
      apply hinj X
      rw [map_add, hφ₀, hφ₀, hφ₀, map_add, map_add]
    let α : (Subobject.underlying.obj J).obj ⟶ (Subobject.underlying.obj J).obj :=
      { app := fun X => AddCommGrpCat.ofHom (AddMonoidHom.mk' (φ₀ X) (hadd X))
        naturality := by
          intro X Y d
          ext y
          apply hinj Y
          change (J.arrow.hom.app Y).hom (φ₀ Y (((Subobject.underlying.obj J).obj.map d).hom y)) =
            (J.arrow.hom.app Y).hom (((Subobject.underlying.obj J).obj.map d).hom (φ₀ X y))
          have e2 : (J.arrow.hom.app Y).hom (((Subobject.underlying.obj J).obj.map d).hom y) =
              (G.obj.map d).hom ((J.arrow.hom.app X).hom y) :=
            NatTrans.naturality_apply J.arrow.hom d y
          have e3 : ((σ (c : ℚ_[ℓ])).hom.app Y).hom ((G.obj.map d).hom ((J.arrow.hom.app X).hom y)) =
              (G.obj.map d).hom (((σ (c : ℚ_[ℓ])).hom.app X).hom ((J.arrow.hom.app X).hom y)) :=
            NatTrans.naturality_apply (σ (c : ℚ_[ℓ])).hom d _
          have e4 : (J.arrow.hom.app Y).hom
              (((Subobject.underlying.obj J).obj.map d).hom (φ₀ X y)) =
              (G.obj.map d).hom ((J.arrow.hom.app X).hom (φ₀ X y)) :=
            NatTrans.naturality_apply J.arrow.hom d _
          rw [hφ₀, e2, e3, e4, hφ₀] }
    refine ⟨ObjectProperty.homMk α, ?_⟩
    apply Sheaf.hom_ext
    ext X y
    exact hφ₀ X y
  choose τ hτ using hlift
  exact ⟨τ, hτ⟩

theorem wc_lcfa_rationalize (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G)
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin m), W.hom z ≠ S i (IsLocalRing.closedPoint K))
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (k : ℕ) (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫ θ.hom =
      θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map
        (wcConstScalar (wcP1Over K).left ℓ k c))
    (Pm : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (hint : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
      ∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1)
    (J : Subobject G)
    (hJ : ∀ (V : (wcP1Over K).left.ProEt) (s : G.obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : (wcP1Over K).left.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖Pm ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1) :
    ∀ (i : ℕ) (y : wcCohG K (wcP1Over K) hP G i), ∃ (N : ℕ)
      (y₀ : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
        (Subobject.underlying.obj J) i),
      (ℓ ^ N : ℕ) • y = y₀.comp (Abelian.Ext.mk₀ J.arrow) (add_zero i) :=
by
  classical
  intro i y

  haveI hprop : IsProper (wcP1Over K).hom := wc_proj_space_isProper K 1
  haveI hprop' : IsProper (Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) :=
    IsProper.instSndScheme _ _
  have hqc0 : QuasiCompact (Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) := inferInstance
  have hqs0 : QuasiSeparated (Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) := inferInstance
  haveI : CompactSpace (wcGeomPoint K (wcP1Over K) hP).left :=
    @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) hqc0 _
  haveI : QuasiSeparatedSpace (wcGeomPoint K (wcP1Over K) hP).left :=
    @quasiSeparatedSpace_of_quasiSeparated _ _ (Limits.pullback.snd (wcP1Over K).hom
      (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) _ hqs0
  have hW : QuasiCompact W.hom := by
    have hwB : w.left ≫ (wcGeomPoint K (wcP1Over K) hP).hom = W.hom := MorphismProperty.Over.w w
    haveI : QuasiCompact (wcGeomPoint K (wcP1Over K) hP).hom := by
      show QuasiCompact (Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      infer_instance
    haveI := hqc
    rw [← hwB]
    infer_instance

  have hbd : ∀ (V : (wcP1Over K).left.ProEt), CompactSpace V.left →
      ∀ s : G.obj.obj (Opposite.op V),
      ∃ (e₀ : ℕ) (t : (Subobject.underlying.obj J).obj.obj (Opposite.op V)),
        (J.arrow.hom.app (Opposite.op V)).hom t = (ℓ ^ e₀ : ℕ) • s := by
    intro V hV s
    haveI := hV
    haveI := hW
    haveI hVp : WeaklyEtale V.hom := V.prop
    haveI hWp : WeaklyEtale W.hom := W.prop
    let p₁ := Limits.pullback.fst V.hom W.hom
    let p₂ := Limits.pullback.snd V.hom W.hom
    haveI : WeaklyEtale p₁ := inferInstance
    haveI : WeaklyEtale (p₁ ≫ V.hom) := inferInstance
    let Zl : (wcP1Over K).left.ProEt := Scheme.ProEt.mk (p₁ ≫ V.hom)
    have e₂ : p₂ ≫ W.hom = Zl.hom := by
      show p₂ ≫ W.hom = p₁ ≫ V.hom
      exact Limits.pullback.condition.symm
    let P₁ : Zl ⟶ V := MorphismProperty.Over.homMk p₁ rfl trivial
    let P₂ : Zl ⟶ W := MorphismProperty.Over.homMk p₂ e₂ trivial
    haveI hqp : QuasiCompact p₁ := inferInstance
    haveI hZc : CompactSpace (Limits.pullback V.hom W.hom : Scheme) :=
      @QuasiCompact.compactSpace_of_compactSpace _ _ p₁ hqp hV
    haveI hZc' : CompactSpace ↥Zl.left := hZc
    let s₁ : G.obj.obj (Opposite.op Zl) :=
      (G.obj.map P₁.op).hom s
    let fz : C(↥Zl.left, Fin k → ℚ_[ℓ]) :=
      (show C(↥Zl.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk P₂))).hom s₁).down)
    obtain ⟨C, hC⟩ := (isCompact_univ (X := ↥Zl.left)).exists_bound_of_continuousOn
      ((LinearMap.continuous_of_finiteDimensional Pm.toLinearMap).comp fz.continuous).continuousOn
    have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := Nat.one_lt_cast.mpr (Fact.out : Nat.Prime ℓ).one_lt
    obtain ⟨e₀, he₀⟩ := pow_unbounded_of_one_lt C hℓ1
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ e₀ := pow_pos (by linarith) e₀
    refine ⟨e₀, (hJ V ((ℓ ^ e₀ : ℕ) • s)).2 ?_⟩
    intro V' c b z ι
    have hcV : c.left ≫ V.hom = V'.hom := MorphismProperty.Over.w c
    have hbW : b.left ≫ W.hom = V'.hom := MorphismProperty.Over.w b
    let h : V'.left ⟶ Limits.pullback V.hom W.hom :=
      Limits.pullback.lift c.left b.left (hcV.trans hbW.symm)
    have hh1 : h ≫ p₁ = c.left := Limits.pullback.lift_fst _ _ _
    have hh2 : h ≫ p₂ = b.left := Limits.pullback.lift_snd _ _ _
    have eh : h ≫ Zl.hom = V'.hom := by
      show h ≫ p₁ ≫ V.hom = V'.hom
      rw [← Category.assoc, hh1, hcV]
    let Ht : V' ⟶ Zl := MorphismProperty.Over.homMk h eh trivial
    have hHt1 : Ht ≫ P₁ = c := MorphismProperty.Over.Hom.ext (by exact hh1)
    have hHt2 : Ht ≫ P₂ = b := MorphismProperty.Over.Hom.ext (by exact hh2)
    let a : (Over.mk b : Over W) ⟶ Over.mk P₂ := Over.homMk Ht hHt2
    have hN : (show C(↥V'.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          (((G.over W).obj.map a.op).hom s₁)).down) z = fz (h z) := by
      have N2 := congrArg (fun F : (G.over W).obj.obj
            (Opposite.op (Over.mk P₂)) ⟶
          ((wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W).obj.obj
            (Opposite.op (Over.mk b : Over W)) => F.hom s₁)
        (θ.hom.hom.naturality a.op)
      exact congrArg (fun y : ULift.{u+1} C(↥V'.left, Fin k → ℚ_[ℓ]) => y.down z) N2
    have hsec : (G.obj.map c.op).hom s =
        ((G.over W).obj.map a.op).hom s₁ := by
      have e := congrArg (fun φ => φ.hom s) (G.obj.map_comp P₁.op Ht.op)
      rw [← op_comp, hHt1] at e
      exact e
    have e1 : (G.obj.map c.op).hom ((ℓ ^ e₀ : ℕ) • s) =
        (ℓ ^ e₀ : ℕ) • ((G.over W).obj.map a.op).hom s₁ := by
      rw [map_nsmul]
      exact congrArg (fun x => (ℓ ^ e₀ : ℕ) • x) hsec
    have e2 : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom
        ((G.obj.map c.op).hom ((ℓ ^ e₀ : ℕ) • s)) =
        (ℓ ^ e₀ : ℕ) • (θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          (((G.over W).obj.map a.op).hom s₁) := by
      rw [e1, map_nsmul]
    have key : Pm ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          ((G.obj.map c.op).hom ((ℓ ^ e₀ : ℕ) • s))).down) z) =
        (ℓ ^ e₀ : ℕ) • Pm (fz (h z)) := by
      rw [e2, ← map_nsmul Pm]
      congr 1
      rw [← hN]
      rfl
    have hb2 : ‖Pm (fz (h z))‖ ≤ C := hC (h z) (Set.mem_univ _)
    have hb3 := norm_le_pi_norm (Pm (fz (h z))) ι
    rw [key, Pi.smul_apply, nsmul_eq_mul, norm_mul, Nat.cast_pow, Padic.norm_p_pow, zpow_neg,
      zpow_natCast, inv_mul_le_iff₀ hpos, mul_one]
    linarith

  have hns : ∀ (X : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (e₀ : ℕ) (U : ((wcP1Over K).left.ProEt)ᵒᵖ) (x : (X.obj.obj U : Type (u+1))),
      (e₀ • 𝟙 X).hom.app U x = e₀ • x := by
    intro X e₀ U x
    induction e₀ with
    | zero => rw [zero_nsmul, zero_nsmul]; rfl
    | succ e₀ ih =>
      rw [succ_nsmul, Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, ih, succ_nsmul]
      rfl
  have hmono : Monotone (fun n : ℕ =>
      (Subobject.pullback ((ℓ ^ n : ℕ) • 𝟙 G)).obj J) := by
    apply monotone_nat_of_le_succ
    intro n
    show (Subobject.pullback ((ℓ ^ n : ℕ) • 𝟙 G)).obj J ≤
      (Subobject.pullback ((ℓ ^ (n + 1) : ℕ) • 𝟙 G)).obj J
    have hPn := Subobject.isPullback ((ℓ ^ n : ℕ) • 𝟙 G) J
    have hPn1 := Subobject.isPullback ((ℓ ^ (n + 1) : ℕ) • 𝟙 G) J
    have hw := hPn.w
    have heq : (Subobject.pullbackπ ((ℓ ^ n : ℕ) • 𝟙 G) J ≫
        (ℓ • 𝟙 (Subobject.underlying.obj J))) ≫ J.arrow =
        ((Subobject.pullback ((ℓ ^ n : ℕ) • 𝟙 G)).obj J).arrow ≫
          ((ℓ ^ (n + 1) : ℕ) • 𝟙 G) := by
      calc (Subobject.pullbackπ ((ℓ ^ n : ℕ) • 𝟙 G) J ≫
          (ℓ • 𝟙 (Subobject.underlying.obj J))) ≫ J.arrow
          = ℓ • (Subobject.pullbackπ ((ℓ ^ n : ℕ) • 𝟙 G) J ≫
              J.arrow) := by
            rw [Category.assoc, Preadditive.nsmul_comp, Category.id_comp, Preadditive.comp_nsmul]
        _ = ℓ • (((Subobject.pullback ((ℓ ^ n : ℕ) • 𝟙 G)).obj J).arrow ≫
              ((ℓ ^ n : ℕ) • 𝟙 G)) := by rw [hw]
        _ = _ := by
            rw [Preadditive.comp_nsmul, Preadditive.comp_nsmul, Category.comp_id,
              smul_smul, pow_succ']
    exact Subobject.le_of_comm (hPn1.lift _ _ heq) (hPn1.lift_snd _ _ _)
  let κ : (Monotone.functor hmono ⋙ Subobject.underlying) ⟶
      (Functor.const ℕ).obj G :=
    { app := fun n =>
        ((Subobject.pullback ((ℓ ^ n : ℕ) • 𝟙 G)).obj J).arrow
      naturality := fun n n' f => by
        erw [Category.comp_id]
        exact Subobject.underlying_arrow _ }
  haveI hcol : Limits.HasColimitsOfShape ℕ
      (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) := inferInstance
  haveI hcolF : Limits.HasColimit (Monotone.functor hmono ⋙ Subobject.underlying) :=
    Limits.HasColimitsOfShape.has_colimit _
  haveI hex : HasExactColimitsOfShape ℕ
      (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _
      (Scheme.ProEt.topology (wcP1Over K).left) _ _ _
      (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
        (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))
  have crit : ∀ (T : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (Dg : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (κ : Dg ⟶ (Functor.const ℕ).obj T), (∀ n, Mono (κ.app n)) →
      Epi (Limits.colimit.desc Dg (Limits.Cocone.mk T κ)) →
      Nonempty (Limits.IsColimit (Limits.Cocone.mk T κ)) := by
    intro T Dg κ hmono hepi
    haveI : Mono κ := NatTrans.mono_of_mono_app κ
    haveI : Mono (Limits.colimMap κ) := Functor.map_mono Limits.colim κ
    let e : Limits.colimit ((Functor.const ℕ).obj T) ≅ T :=
      (Limits.colimit.isColimit ((Functor.const ℕ).obj T)).coconePointUniqueUpToIso
        (Limits.isColimitConstCocone ℕ T)
    have he : ∀ n, Limits.colimit.ι ((Functor.const ℕ).obj T) n ≫ e.hom = 𝟙 T := fun n =>
      (Limits.colimit.isColimit ((Functor.const ℕ).obj T)).comp_coconePointUniqueUpToIso_hom
        (Limits.isColimitConstCocone ℕ T) n
    have hD : Limits.colimit.desc Dg (Limits.Cocone.mk T κ) = Limits.colimMap κ ≫ e.hom := by
      apply Limits.colimit.hom_ext
      intro n
      rw [Limits.colimit.ι_desc, Limits.ι_colimMap_assoc, he]
      exact (Category.comp_id (κ.app n)).symm
    haveI : Mono (Limits.colimMap κ ≫ e.hom) := mono_comp _ _
    haveI : Mono (Limits.colimit.desc Dg (Limits.Cocone.mk T κ)) := by
      rw [hD]; infer_instance
    haveI : IsIso (Limits.colimit.desc Dg (Limits.Cocone.mk T κ)) := isIso_of_mono_of_epi _
    haveI : IsIso ((Limits.colimit.isColimit Dg).desc (Limits.Cocone.mk T κ)) := by
      rw [Limits.colimit.isColimit_desc]; infer_instance
    exact ⟨Limits.IsColimit.ofPointIso (Limits.colimit.isColimit Dg)⟩
  have affine_sieve : ∀ (V : (wcP1Over K).left.ProEt) (R : Sieve V),
      (∀ (W₁ : (wcP1Over K).left.ProEt) (f : W₁ ⟶ V), IsAffine W₁.left → R.arrows f) →
      R ∈ Scheme.ProEt.topology (wcP1Over K).left V := by
    intro V R hR
    have hV : WeaklyEtale V.hom := V.prop
    let W₁ : V.left.affineCover.I₀ → (wcP1Over K).left.ProEt := fun i =>
      MorphismProperty.Over.mk ⊤ (V.left.affineCover.f i ≫ V.hom) inferInstance
    let g : ∀ i, W₁ i ⟶ V := fun i =>
      MorphismProperty.Over.homMk (V.left.affineCover.f i) rfl trivial
    have hPc : Presieve.ofArrows W₁ g ∈
        (Scheme.ProEt.precoverage (wcP1Over K).left).coverings V := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget (wcP1Over K).left ⋙
        Over.forget (wcP1Over K).left) Scheme.proetalePrecoverage).coverings V
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change V.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings V.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage V.left V.left.affineCover.mem₀,
        V.left.affineCover.mem₀.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
    refine GrothendieckTopology.superset_covering _ ?_
      (Precoverage.generate_mem_toGrothendieck hPc)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨i⟩
    exact hR (W₁ i) (g i) (show IsAffine (V.left.affineCover.X i) by infer_instance)
  have hmonoκ : ∀ n, Mono (κ.app n) := fun n => Subobject.arrow_mono _
  have hepi : Epi (Limits.colimit.desc (Monotone.functor hmono ⋙ Subobject.underlying)
      (Limits.Cocone.mk _ κ)) := by
    have hls : Presheaf.IsLocallySurjective (Scheme.ProEt.topology (wcP1Over K).left)
        (Limits.colimit.desc (Monotone.functor hmono ⋙ Subobject.underlying)
          (Limits.Cocone.mk _ κ)).hom := by
      refine ⟨fun {V} s => ?_⟩
      apply affine_sieve V
      intro W₁ f hW₁
      haveI : CompactSpace W₁.left := inferInstance
      obtain ⟨e₀, t, ht⟩ := hbd W₁ inferInstance
        ((G.obj.map f.op).hom s)
      obtain ⟨e, hnat, -⟩ := proet_free_sheaf_hom_equiv (wcP1Over K).left W₁
      let gs := (e G).symm
        ((G.obj.map f.op).hom s)
      let gt := (e (Subobject.underlying.obj J)).symm t
      have hcomm : gt ≫ J.arrow = gs ≫ ((ℓ ^ e₀ : ℕ) • 𝟙 G) := by
        apply (e G).injective
        rw [hnat, hnat, Equiv.apply_symm_apply, Equiv.apply_symm_apply, hns]
        exact ht
      have hPm := Subobject.isPullback ((ℓ ^ e₀ : ℕ) • 𝟙 G) J
      let g' := hPm.lift gt gs hcomm
      have hg' : g' ≫ κ.app e₀ = gs := hPm.lift_snd _ _ _
      refine ⟨(Limits.colimit.ι (Monotone.functor hmono ⋙ Subobject.underlying) e₀).hom.app
        (Opposite.op W₁) (e _ g'), ?_⟩
      change (Limits.colimit.ι (Monotone.functor hmono ⋙ Subobject.underlying) e₀ ≫
          Limits.colimit.desc (Monotone.functor hmono ⋙ Subobject.underlying)
            (Limits.Cocone.mk _ κ)).hom.app (Opposite.op W₁) (e _ g') = _
      rw [Limits.colimit.ι_desc]
      change (κ.app e₀).hom.app (Opposite.op W₁) (e _ g') = _
      rw [← hnat, hg']
      exact Equiv.apply_symm_apply (e G) _
    exact (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp hls
  obtain ⟨hκ⟩ := crit _ _ κ hmonoκ hepi

  have H0 : ∀ (Dg : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (c : Limits.Cocone Dg), Limits.IsColimit c →
      ∀ g : wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) ⟶ c.pt,
        ∃ (n : ℕ) (g' : wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) ⟶
          Dg.obj n), g = g' ≫ c.ι.app n :=
    fun Dg c hc => (proet_free_hom_seq_colimit (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP) Dg c hc).1
  have H1lift : ∀ Dg : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1},
      ∃ (I : ℕ ⥤ Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
        (α : Dg ⟶ I), Mono α ∧ ∀ (c : Limits.Cocone I), Limits.IsColimit c →
          ∀ (k : ℕ) (x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left
            (wcGeomPoint K (wcP1Over K) hP)) c.pt (k + 1)), x = 0 := by
    intro Dg
    obtain ⟨I, α, hα, hI⟩ := injective_tower_of_tower Dg
    exact ⟨I, α, hα, fun c hc k x => proet_ext_colimit_injectives_vanish (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP) I hI c hc k x⟩
  have s7 : ∀ {X Y : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      {n : ℕ} (x : Abelian.Ext X Y n) (e₀ : ℕ),
      x.comp (Abelian.Ext.mk₀ (e₀ • 𝟙 Y)) (add_zero n) = e₀ • x := by
    intro X Y n x e₀
    induction e₀ with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ e₀ ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
        Abelian.Ext.comp_mk₀_id]
  obtain ⟨N, y', hy⟩ := ext_seq_colimit_lift_of_acyclic
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) H0 H1lift i
    _ (Limits.Cocone.mk _ κ) hκ y
  refine ⟨N, y'.comp (Abelian.Ext.mk₀
    (Subobject.pullbackπ ((ℓ ^ N : ℕ) • 𝟙 G) J)) (add_zero i), ?_⟩
  have hw := (Subobject.isPullback ((ℓ ^ N : ℕ) • 𝟙 G) J).w
  rw [← s7 y (ℓ ^ N), hy, Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
    Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hw]

theorem wc_lcfa_mod_finite (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G)
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin m), W.hom z ≠ S i (IsLocalRing.closedPoint K))
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (k : ℕ) (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫ θ.hom =
      θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map
        (wcConstScalar (wcP1Over K).left ℓ k c))
    (Pm : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (hint : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
      ∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1)
    (J : Subobject G)
    (hJ : ∀ (V : (wcP1Over K).left.ProEt) (s : G.obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : (wcP1Over K).left.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖Pm ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1) :
    ∀ (r i : ℕ), i ≤ 2 → Finite (Abelian.Ext (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP))
      (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))) i) :=
by
  classical
  intro r i hi
  haveI : NeZero (ℓ ^ r) := ⟨pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero⟩
  have hne : Nonempty W.left := @ConnectedSpace.toNonempty _ _ hconn
  obtain ⟨θr, -⟩ := wc_qclift_level_frame K hP ℓ G W hne k θ Pm hint J hJ r
  set L := Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)) with hLdef

  have hL : (ℓ ^ r : ℕ) • 𝟙 L = 0 := by
    have hπ := Limits.cokernel.condition ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))
    rw [Preadditive.nsmul_comp, Category.id_comp] at hπ
    apply (cancel_epi (Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)))).1
    rw [Preadditive.comp_nsmul, Category.comp_id, hπ, Limits.comp_zero]
  rcases (by omega : i = 0 ∨ i = 1 ∨ i = 2) with rfl | rfl | rfl
  ·

    have hzL : wcZeroAtS K m S L := by
      intro i V A _ _ _ e hv y
      haveI := wc_proet_free_projective_strict_local (wcP1Over K).left V A e
      obtain ⟨f, rfl⟩ : ∃ f, Abelian.Ext.mk₀ f = y := ⟨_, Abelian.Ext.mk₀_addEquiv₀_apply y⟩
      have ht := Projective.factorThru_comp f
        (Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)))
      have h0 : Projective.factorThru f
          (Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))) ≫ J.arrow = 0 := by
        apply (Abelian.Ext.mk₀_bijective _ _).1
        rw [Abelian.Ext.mk₀_zero]
        exact hzero i V A e hv _
      have h1 : Projective.factorThru f
          (Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))) = 0 := by
        rw [← cancel_mono J.arrow, h0, Limits.zero_comp]
      rw [← ht, h1, Limits.zero_comp, Abelian.Ext.mk₀_zero]

    obtain ⟨Ub, hUb, -⟩ := wc_qcfin_frame_fet_descent K hP m S hS L ℓ r W w hqc hconn hsurj k θr
    let U' : (wcP1Over K).left.ProEt :=
      MorphismProperty.Over.mk ⊤ (Ub.ι ≫ (wcGeomPoint K (wcP1Over K) hP).hom)
        (@MorphismProperty.comp_mem _ _ @WeaklyEtale
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition
          _ _ _ _ _ (etale_le_weaklyEtale _ _ _ inferInstance) (wcGeomPoint K (wcP1Over K) hP).prop)
    let u' : U' ⟶ wcGeomPoint K (wcP1Over K) hP := MorphismProperty.Over.homMk Ub.ι rfl trivial
    have hUbmem : ∀ v : Ub.toScheme, Ub.ι v ∈ Ub := by
      intro v
      rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι]
      exact ⟨v, rfl⟩
    haveI hNoeth : AlgebraicGeometry.IsNoetherian Ub.toScheme :=
      (wc_P1bar_open_finite_noetherian_sep K hP Ub Ub.toScheme (𝟙 _) inferInstance).1
    have hV : TopologicalSpace.NoetherianSpace U'.left :=
      (inferInstance : TopologicalSpace.NoetherianSpace Ub.toScheme)
    have havoid : ∀ (v : U'.left) (i : Fin m), U'.hom v ≠ S i (IsLocalRing.closedPoint K) := by
      intro v i
      have h1 := (hUb _).1 (hUbmem v) i
      have h2 : U'.hom v = (wcGeomPoint K (wcP1Over K) hP).hom (Ub.ι v) := by
        show (Ub.ι ≫ (wcGeomPoint K (wcP1Over K) hP).hom) v = _
        first
          | rfl
          | exact Scheme.Hom.comp_apply _ _ _
          | exact Scheme.Hom.comp_apply _ _ _ _ _
          | simp
      rw [h2]
      exact h1
    haveI hfinU : Finite (L.obj.obj (Opposite.op U')) :=
      wc_qclift_sections_finite_off_points K hP m S L W w hqc hsurj (Fin k → ZMod (ℓ ^ r)) θr
        U' hV havoid
    obtain ⟨eH, -, -⟩ := proet_free_sheaf_hom_equiv (wcP1Over K).left U'
    haveI hfinHom : Finite (wcFreeSheaf (wcP1Over K).left U' ⟶ L) := Finite.of_equiv _ (eH L).symm
    haveI hfinExt : Finite (Abelian.Ext (wcFreeSheaf (wcP1Over K).left U') L 0) :=
      Finite.of_equiv _ Abelian.Ext.homEquiv₀.symm

    let ρ := (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left u')).precomp L (zero_add 0)

    have huniq : ∀ (i : Fin m) (p p' : (wcGeomPoint K (wcP1Over K) hP).left),
        (wcGeomPoint K (wcP1Over K) hP).hom p = S i (IsLocalRing.closedPoint K) →
        (wcGeomPoint K (wcP1Over K) hP).hom p' = S i (IsLocalRing.closedPoint K) →
        p = p' := by
      intro i p p' hp hp'
      obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
        (g := S i) p (IsLocalRing.closedPoint K) hp
      obtain ⟨z', hz1', -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
        (g := S i) p' (IsLocalRing.closedPoint K) hp'
      haveI : IsIso (S i ≫ (wcP1Over K).hom) := by rw [hS i]; infer_instance
      let e := Limits.pullbackSymmetry (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (S i) ≪≫
        Limits.pullbackRightPullbackFstIso (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) (S i) ≪≫
        asIso (Limits.pullback.snd (S i ≫ (wcP1Over K).hom)
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      have hsub : Subsingleton (Spec (.of (AlgebraicClosure K))) := by
        show Subsingleton (PrimeSpectrum (AlgebraicClosure K))
        infer_instance
      have hzz : z = z' := e.hom.isOpenEmbedding.injective (Subsingleton.elim _ _)
      rw [← hz1, ← hz1', hzz]
    have hloc : ∀ (y : wcCohG K (wcP1Over K) hP L 0) (i : Fin m), ∃ (V : (wcP1Over K).left.ProEt)
        (g : V ⟶ wcGeomPoint K (wcP1Over K) hP) (v : V.left),
        V.hom v = S i (IsLocalRing.closedPoint K) ∧
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left g)).comp y (zero_add 0) = 0 := by
      intro y i
      obtain ⟨V₀, g₀, -, A, _, _, _, e, -, hv, -⟩ := wc_P1bar_strict_local_nbhd K (S i) (hS i) hP
      exact ⟨V₀, g₀, e.inv (IsLocalRing.closedPoint A), hv, hzL i V₀ A e hv _⟩
    let Fr : (wcP1Over K).left.ProEt ⥤
        Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1} :=
      yoneda ⋙ (Functor.whiskeringRight _ _ _).obj (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⋙
        presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}
    have hinj : Function.Injective ρ := by
      rw [injective_iff_map_eq_zero]
      intro y hy0
      have hy0' : (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left u')).comp y (zero_add 0) = 0 :=
        hy0
      refine wc_P1_geom_section_zero_of_local K hP L m S hS huniq y ?_ (hloc y)
      intro V g hVoff
      have hsub : Set.range g.left ⊆ Set.range Ub.ι := by
        rintro _ ⟨v, rfl⟩
        rw [Scheme.Opens.range_ι]
        apply (hUb _).2
        intro i
        have e : (wcGeomPoint K (wcP1Over K) hP).hom (g.left v) = V.hom v := by
          rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w g]
        rw [e]
        exact hVoff v i
      let h0 : V.left ⟶ Ub.toScheme := IsOpenImmersion.lift Ub.ι g.left hsub
      have hh0 : h0 ≫ Ub.ι = g.left := IsOpenImmersion.lift_fac _ _ _
      have hw : h0 ≫ U'.hom = V.hom := by
        show h0 ≫ (Ub.ι ≫ (wcGeomPoint K (wcP1Over K) hP).hom) = V.hom
        rw [← Category.assoc, hh0]
        exact MorphismProperty.Over.w g
      let h : V ⟶ U' := MorphismProperty.Over.homMk h0 hw trivial
      have hhu : h ≫ u' = g :=
        MorphismProperty.Over.Hom.ext (by exact hh0)
      have hfc : wcFreeSheafMap (wcP1Over K).left g =
          wcFreeSheafMap (wcP1Over K).left h ≫ wcFreeSheafMap (wcP1Over K).left u' := by
        rw [← hhu]
        exact Fr.map_comp h u'
      rw [hfc, ← Abelian.Ext.mk₀_comp_mk₀,
        Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 0) (by omega), hy0',
        Abelian.Ext.comp_zero]
    exact Finite.of_injective ρ hinj
  ·

    have dedup : ∃ (m' : ℕ) (S' : Fin m' → (Spec (.of K) ⟶ (wcP1Over K).left)),
        (∀ j, S' j ≫ (wcP1Over K).hom = 𝟙 _) ∧
        Function.Injective (fun j => S' j (IsLocalRing.closedPoint K)) ∧
        (∀ i, ∃ j, S' j (IsLocalRing.closedPoint K) = S i (IsLocalRing.closedPoint K)) := by
      let T : Finset (wcP1Over K).left :=
        Finset.univ.image (fun i => S i (IsLocalRing.closedPoint K))
      have hmem : ∀ j : Fin T.card, ∃ i : Fin m,
          S i (IsLocalRing.closedPoint K) = (T.equivFin.symm j).1 := by
        intro j
        have h := (T.equivFin.symm j).2
        obtain ⟨i, -, hi⟩ := Finset.mem_image.mp h
        exact ⟨i, hi⟩
      choose idx hidx using hmem
      refine ⟨T.card, fun j => S (idx j), fun j => hS (idx j), ?_, ?_⟩
      · intro j j' h
        simp only at h
        rw [hidx, hidx] at h
        exact T.equivFin.symm.injective (Subtype.ext h)
      · intro i
        refine ⟨T.equivFin ⟨S i (IsLocalRing.closedPoint K),
          Finset.mem_image_of_mem _ (Finset.mem_univ i)⟩, ?_⟩
        show S (idx _) (IsLocalRing.closedPoint K) = _
        rw [hidx, Equiv.symm_apply_apply]
    obtain ⟨m', S', hS', hSinj, hcov⟩ := dedup
    have hsurj' : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
        (∀ j : Fin m', (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S' j (IsLocalRing.closedPoint K)) →
        ∃ z : W.left, w.left z = p := by
      intro p hp
      apply hsurj p
      intro i h
      obtain ⟨j, hj⟩ := hcov i
      exact hp j (h.trans hj.symm)

    obtain ⟨U, ι, x, e0, u', hu', hrange, hclosed, hstep⟩ :=
      wc_P1bar_point_removal_chain K hP m' S' hS' hSinj
    have H : ∀ d, d ≤ m' →
        Finite (Abelian.Ext (wcFreeSheaf (wcP1Over K).left (U (m' - d))) L 1) := by
      intro d
      induction d with
      | zero =>
        intro _
        rw [Nat.sub_zero]
        exact wc_qclift_open_ext1_finite K ℓ hℓ hP m' S' hS' L r hL W w hqc hconn hsurj' k θr
          (U m') u' hu' hrange
      | succ d ih =>
        intro hd
        have ih' := ih (by omega)
        generalize hgi : m' - (d + 1) = i
        have hi : i < m' := by omega
        have hi1 : i + 1 = m' - d := by omega
        obtain ⟨hoi, hri, hln, hqs, hsep, hiff⟩ := hstep i hi
        have hV : Finite (Abelian.Ext (wcFreeSheaf (wcP1Over K).left (U (i + 1))) L 1) := by
          rw [hi1]; exact ih'
        refine wc_proet_ext1_finite_of_point_removal (wcP1Over K).left (U i) (U (i + 1)) (ι i)
          (x i) hoi hri hln hqs hsep L ?_ hV
        intro T g hT hpts
        refine wc_qclift_sections_finite_off_points K hP m' S' L W w hqc hsurj'
          (Fin k → ZMod (ℓ ^ r)) θr T hT ?_
        intro t j hj
        have hy := hpts t
        have hgw : g.left ≫ (U i).hom = T.hom := by simpa using g.w
        have hw : (U i).hom (g.left t) = T.hom t := by
          rw [← hgw, Scheme.Hom.comp_apply]
        have hspec : (U i).hom (g.left t) ⤳ (U i).hom (x i) :=
          hy.2.map (U i).hom.continuous
        rw [(hiff (x i)).2 rfl, hw, hj] at hspec
        have heq : S' ⟨i, hi⟩ (IsLocalRing.closedPoint K) =
            S' j (IsLocalRing.closedPoint K) := by
          have hmem := specializes_iff_mem_closure.mp hspec
          rw [(hclosed j).closure_eq] at hmem
          exact hmem
        apply hy.1
        apply (hiff (g.left t)).1
        rw [hw, hj, heq]
    have H0 := H m' le_rfl
    rw [Nat.sub_self] at H0

    let Fr : (wcP1Over K).left.ProEt ⥤
        Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1} :=
      yoneda ⋙ (Functor.whiskeringRight _ _ _).obj (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⋙
        presheafToSheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}
    have hfin0 : Finite (Abelian.Ext (Fr.obj (U 0)) L 1) := H0
    let eF := Fr.mapIso e0
    have key : ∀ z : Abelian.Ext (Fr.obj (wcGeomPoint K (wcP1Over K) hP)) L 1,
        (Abelian.Ext.mk₀ eF.inv).comp ((Abelian.Ext.mk₀ eF.hom).comp z (zero_add 1))
          (zero_add 1) = z := by
      intro z
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 1) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, eF.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    refine Finite.of_injective (β := Abelian.Ext (Fr.obj (U 0)) L 1)
      (fun z => (Abelian.Ext.mk₀ eF.hom).comp z (zero_add 1)) ?_
    intro z1 z2 h
    rw [← key z1, ← key z2]
    exact congrArg (fun y => (Abelian.Ext.mk₀ eF.inv).comp y (zero_add 1)) h
  ·
    obtain ⟨Ub, hUb, ℰ, e, πE, hπE, hfin, het, hsurjE, hEconn, θE, -⟩ :=
      wc_qcfin_frame_fet_descent K hP m S hS L ℓ r W w hqc hconn hsurj k θr
    obtain ⟨Γ, hΓ, -⟩ := wc_qcfin_fet_coinv_surj K ℓ hℓ hP m S hS L r hL k Ub hUb ℰ e πE hπE
      hfin het hsurjE hEconn θE
    exact Finite.of_surjective Γ hΓ

theorem wc_lcfa_int_separated (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G)
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin m), W.hom z ≠ S i (IsLocalRing.closedPoint K))
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (k : ℕ) (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫ θ.hom =
      θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map
        (wcConstScalar (wcP1Over K).left ℓ k c))
    (Pm : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (hint : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
      ∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1)
    (J : Subobject G)
    (hJ : ∀ (V : (wcP1Over K).left.ProEt) (s : G.obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : (wcP1Over K).left.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖Pm ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1)
    (hfin : ∀ r i : ℕ, i ≤ 1 → Finite (Abelian.Ext (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP))
      (Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J))) i)) :
    ∀ (i : ℕ), 1 ≤ i → i ≤ 2 → ∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP)) (Subobject.underlying.obj J) i,
      (∀ r : ℕ, x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π
        ((ℓ ^ r : ℕ) • 𝟙 (Subobject.underlying.obj J)))) (add_zero i) = 0) → x = 0 :=
by
  classical
  intro i hi1 hi2 x hx
  haveI := wc_proet_products_exact (wcP1Over K).left

  let Jo := Subobject.underlying.obj J
  let P0 := wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)
  let B : ℕ → Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1} :=
    fun r => Limits.cokernel ((ℓ ^ r : ℕ) • 𝟙 Jo)
  let π : ∀ r, Jo ⟶ B r := fun r => Limits.cokernel.π ((ℓ ^ r : ℕ) • 𝟙 Jo)
  have hπ : ∀ r, ((ℓ ^ r : ℕ) • π r) = 0 := by
    intro r
    have h := Limits.cokernel.condition ((ℓ ^ r : ℕ) • 𝟙 Jo)
    rwa [Preadditive.nsmul_comp, Category.id_comp] at h
  have hc0 : ∀ r, ((ℓ ^ (r + 1) : ℕ) • 𝟙 Jo) ≫ π r = 0 := by
    intro r
    rw [Preadditive.nsmul_comp, Category.id_comp, pow_succ', mul_smul, hπ r, smul_zero]
  let c : ∀ r, B (r + 1) ⟶ B r := fun r => Limits.cokernel.desc _ (π r) (hc0 r)
  have hc : ∀ r, π (r + 1) ≫ c r = π r := fun r => Limits.cokernel.π_desc _ _ _
  have hcepi : ∀ r, Epi (c r) := by
    intro r
    haveI : Epi (π (r + 1) ≫ c r) := by rw [hc r]; infer_instance
    exact epi_of_epi (π (r + 1)) (c r)
  let Yt := ∏ᶜ B
  let pr : ∀ n, Yt ⟶ B n := fun n => Limits.Pi.π B n
  have hY : Limits.IsLimit (Limits.Fan.mk Yt pr) := Limits.productIsProduct B
  let T : Yt ⟶ Yt := Limits.Pi.lift (fun n => pr n - pr (n + 1) ≫ c n)
  have hT : ∀ n, T ≫ pr n = pr n - pr (n + 1) ≫ c n := fun n => by simp [T, pr]
  let ι : Jo ⟶ Yt := Limits.Pi.lift π
  have hιpr : ∀ n, ι ≫ pr n = π n := fun n => by simp [ι, pr]
  have hι : ι ≫ T = 0 := by
    apply Limits.Pi.hom_ext
    intro n
    rw [Category.assoc, Limits.zero_comp]
    change ι ≫ T ≫ pr n = 0
    rw [hT n, Preadditive.comp_sub, hιpr, ← Category.assoc, hιpr, hc, sub_self]

  let c' : ∀ k m, m ≤ k → (B k ⟶ B m) := fun k m h => (Functor.ofOpSequence c).map (homOfLE h).op
  have hcomp : ∀ k j m (h1 : m ≤ j) (h2 : j ≤ k), c' k j h2 ≫ c' j m h1 = c' k m (h1.trans h2) := by
    intro k j m h1 h2
    exact ((Functor.ofOpSequence c).map_comp (homOfLE h2).op (homOfLE h1).op).symm
  have hsucc : ∀ m, c' (m + 1) m (Nat.le_succ m) = c m := fun m =>
    Functor.ofOpSequence_map_homOfLE_succ c m
  have hepi : ∀ d m, Epi (c' (m + d) m (Nat.le_add_right m d)) := by
    intro d
    induction d with
    | zero =>
      intro m
      have : c' (m + 0) m (Nat.le_add_right m 0) = 𝟙 _ :=
        (Functor.ofOpSequence c).map_id (Opposite.op m)
      rw [this]
      infer_instance
    | succ d ih =>
      intro m
      have e1 := hcomp (m + (d + 1)) (m + d) m (Nat.le_add_right m d) (by omega)
      have e2 : c' (m + (d + 1)) (m + d) (by omega) = c (m + d) := hsucc (m + d)
      rw [← e1, e2]
      haveI := ih m
      haveI := hcepi (m + d)
      infer_instance
  have hepi' : ∀ k m (h : m ≤ k), Epi (c' k m h) := by
    intro k m h
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
    exact hepi d m
  have htop : ∀ {X Y' : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (f : X ⟶ Y'), Epi f → Limits.imageSubobject f = ⊤ := by
    intro X Y' f hf
    haveI : Epi (Limits.imageSubobject f).arrow := by
      have := Limits.imageSubobject_arrow_comp f
      exact epi_of_epi_fac this
    haveI : IsIso (Limits.imageSubobject f).arrow := isIso_of_mono_of_epi _
    exact Subobject.eq_top_of_isIso_arrow _
  have hML : ∀ m, ∃ m', ∃ hm : m ≤ m', ∀ k (hk : m' ≤ k),
      Limits.imageSubobject (c' k m (hm.trans hk)) = Limits.imageSubobject (c' m' m hm) :=
    fun m => ⟨m, le_refl m, fun k hk => by rw [htop _ (hepi' _ _ _), htop _ (hepi' _ _ _)]⟩
  have hTepi : Epi T := wc_proet_ML_tower_shift_epi (wcP1Over K).left Yt B pr hY c' hcomp hML T
    (fun m => by rw [hsucc]; exact hT m)
  set qq := Limits.kernel.lift T ι hι with hqdef

  have hdef : ∀ (V : (wcP1Over K).left.ProEt),
      (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
      (∀ s : (Limits.kernel qq).obj.obj (Opposite.op V), s = 0) ∧
      (∀ s : (Limits.cokernel qq).obj.obj (Opposite.op V), s = 0) := by
    intro V hV
    obtain ⟨ψ, -⟩ := wc_qclift_integral_frame (wcP1Over K).left ℓ G W k θ Pm hint J hJ
    obtain ⟨Ym, Bm, red, cst, prm, incl, shift, hred, hcst, ⟨hYm⟩, hincl, hshift, hses⟩ :=
      wc_contSheaf_intvec_tower_model (wcP1Over K).left ℓ k
    haveI : Limits.PreservesFiniteColimits
        ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W) := by
      have hpc : Limits.PreservesColimitsOfSize.{0, 0}
          ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W) :=
        (Functor.sheafAdjunctionCocontinuous (Over.forget W) AddCommGrpCat.{u+1}
          ((Scheme.ProEt.topology (wcP1Over K).left).over W)
          (Scheme.ProEt.topology (wcP1Over K).left)).leftAdjoint_preservesColimits
      exact Limits.PreservesColimitsOfSize.preservesFiniteColimits
          ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W)
    haveI : ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).Additive :=
      Functor.additive_of_preserves_binary_products _
    obtain ⟨hK, hC⟩ := wc_tower_defect_isZero_of_exact_functor
      ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W) ℓ
      Jo Yt pr hY c hc T hT ι hιpr hι
      (wcContSheaf (wcP1Over K).left (Fin k → ℤ_[ℓ])) Ym Bm red hred cst hcst prm hYm incl hincl
      shift hshift hses ψ
    exact ⟨wc_P1_offS_sections_zero_of_over_zero K hP m S W w hqc hsurj _ hK V hV,
      wc_P1_offS_sections_zero_of_over_zero K hP m S W w hqc hsurj _ hC V hV⟩

  have hKpos : ∀ j : ℕ, 1 ≤ j → ∀ y : Abelian.Ext P0 (Limits.kernel qq) j, y = 0 :=
    fun j hj => wc_proet_P1_finite_supp_ext_vanish K hP m S hS _ (fun V hV => (hdef V hV).1) j hj
  have hCpos : ∀ j : ℕ, 1 ≤ j → ∀ y : Abelian.Ext P0 (Limits.cokernel qq) j, y = 0 :=
    fun j hj => wc_proet_P1_finite_supp_ext_vanish K hP m S hS _ (fun V hV => (hdef V hV).2) j hj

  have hS4 : ∀ (V : (wcP1Over K).left.ProEt) (A : Type u) [CommRing A] [HenselianLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)] (e : V.left ≅ Spec (.of A)) (i : Fin m),
      V.hom (e.inv (IsLocalRing.closedPoint A)) = S i (IsLocalRing.closedPoint K) →
      ∀ f : wcFreeSheaf (wcP1Over K).left V ⟶ Limits.cokernel qq, f = 0 := by
    intro V A _ _ _ e i hv f
    haveI := wc_proet_free_projective_strict_local (wcP1Over K).left V A e
    have hG0 : ∀ g : wcFreeSheaf (wcP1Over K).left V ⟶ G, g = 0 := by
      intro g
      apply (Abelian.Ext.mk₀_bijective _ _).1
      rw [Abelian.Ext.mk₀_zero]
      exact hzero i V A e hv _
    have hJ0 : ∀ g : wcFreeSheaf (wcP1Over K).left V ⟶ Jo, g = 0 := by
      intro g
      rw [← cancel_mono J.arrow, Limits.zero_comp]
      exact hG0 _
    have hB0 : ∀ r (h : wcFreeSheaf (wcP1Over K).left V ⟶ B r), h = 0 := by
      intro r h
      rw [← Projective.factorThru_comp h (π r), hJ0 (Projective.factorThru h (π r)),
        Limits.zero_comp]
    have h1 : Projective.factorThru f (Limits.cokernel.π qq) ≫ Limits.kernel.ι T = 0 := by
      apply Limits.Fan.IsLimit.hom_ext hY
      intro r
      rw [Limits.zero_comp]
      exact hB0 r _
    have h2 : Projective.factorThru f (Limits.cokernel.π qq) = 0 := by
      rw [← cancel_mono (Limits.kernel.ι T), h1, Limits.zero_comp]
    rw [← Projective.factorThru_comp f (Limits.cokernel.π qq), h2, Limits.zero_comp]

  have hC0 : ∀ y : Abelian.Ext P0 (Limits.cokernel qq) 0, y = 0 := by
    intro y
    have huniq : ∀ (i : Fin m) (p p' : (wcGeomPoint K (wcP1Over K) hP).left),
        (wcGeomPoint K (wcP1Over K) hP).hom p = S i (IsLocalRing.closedPoint K) →
        (wcGeomPoint K (wcP1Over K) hP).hom p' = S i (IsLocalRing.closedPoint K) →
        p = p' := by
      intro i p p' hp hp'
      obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
        (g := S i) p (IsLocalRing.closedPoint K) hp
      obtain ⟨z', hz1', -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
        (g := S i) p' (IsLocalRing.closedPoint K) hp'
      haveI : IsIso (S i ≫ (wcP1Over K).hom) := by rw [hS i]; infer_instance
      let e := Limits.pullbackSymmetry (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (S i) ≪≫
        Limits.pullbackRightPullbackFstIso (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) (S i) ≪≫
        asIso (Limits.pullback.snd (S i ≫ (wcP1Over K).hom)
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      have hsub : Subsingleton (Spec (.of (AlgebraicClosure K))) := by
        show Subsingleton (PrimeSpectrum (AlgebraicClosure K))
        infer_instance
      have hzz : z = z' := e.hom.isOpenEmbedding.injective (Subsingleton.elim _ _)
      rw [← hz1, ← hz1', hzz]
    have hloc : ∀ i : Fin m, ∃ (V : (wcP1Over K).left.ProEt)
        (g : V ⟶ wcGeomPoint K (wcP1Over K) hP) (v : V.left),
        V.hom v = S i (IsLocalRing.closedPoint K) ∧
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left g)).comp y (zero_add 0) = 0 := by
      intro i
      obtain ⟨V₀, g₀, -, A, _, _, _, e, -, hv, -⟩ := wc_P1bar_strict_local_nbhd K (S i) (hS i) hP
      refine ⟨V₀, g₀, e.inv (IsLocalRing.closedPoint A), hv, ?_⟩
      have hy0 : ∀ yy : Abelian.Ext (wcFreeSheaf (wcP1Over K).left V₀) (Limits.cokernel qq) 0,
          yy = 0 := by
        intro yy
        rw [← Abelian.Ext.mk₀_addEquiv₀_apply yy, hS4 V₀ A e i hv (Abelian.Ext.addEquiv₀ yy),
          Abelian.Ext.mk₀_zero]
      exact hy0 _
    obtain ⟨x₀, rfl⟩ : ∃ x₀, Abelian.Ext.mk₀ x₀ = y := ⟨_, Abelian.Ext.mk₀_addEquiv₀_apply y⟩
    obtain ⟨η, hη1, hη2⟩ := wc_proet_free_sheaf_yoneda (wcP1Over K).left
    have hy : ∀ (V : (wcP1Over K).left.ProEt) (g : V ⟶ wcGeomPoint K (wcP1Over K) hP),
        (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
        (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left g)).comp (Abelian.Ext.mk₀ x₀)
          (zero_add 0) = 0 := by
      intro V g hV
      rw [Abelian.Ext.mk₀_comp_mk₀]
      have h0 : wcFreeSheafMap (wcP1Over K).left g ≫ x₀ = 0 := by
        obtain ⟨g', -, hg'⟩ := hη1 V (Limits.cokernel qq) 0
        have a1 := hg' (wcFreeSheafMap (wcP1Over K).left g ≫ x₀) ((hdef V hV).2 _)
        have a2 := hg' 0 (by simp)
        rw [a1, a2]
      rw [h0, Abelian.Ext.mk₀_zero]
    exact wc_P1_geom_section_zero_of_local K hP (Limits.cokernel qq) m S hS huniq _ hy hloc

  obtain ⟨n, rfl⟩ : ∃ n, i = n + 1 := ⟨i - 1, by omega⟩
  have hfinB : ∀ r, Finite (Abelian.Ext P0 (B r) n) := fun r => hfin r n (by omega)
  have hK : ∀ y : Abelian.Ext P0 (Limits.kernel qq) (n + 1), y = 0 := hKpos (n + 1) (by omega)
  have hC : ∀ y : Abelian.Ext P0 (Limits.cokernel qq) n, y = 0 := by
    rcases n with _ | n
    · exact hC0
    · exact hCpos (n + 1) (by omega)
  have hprod := fun N => wc_ext_prod_bijective P0 Yt B pr hY N
  have hz' : ∀ r, x.comp (Abelian.Ext.mk₀ (ι ≫ pr r)) (add_zero (n + 1)) = 0 := by
    intro r
    rw [hιpr r]
    exact hx r
  have hsubmk : ∀ {A A' : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}}
      (a b : A ⟶ A'), Abelian.Ext.mk₀ (a - b) = Abelian.Ext.mk₀ a - Abelian.Ext.mk₀ b := by
    intro A A' a b
    rw [sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg, ← sub_eq_add_neg]
  have hcompsub : ∀ {A A' A'' : Sheaf (Scheme.ProEt.topology (wcP1Over K).left)
      AddCommGrpCat.{u+1}} {p : ℕ} (α : Abelian.Ext A A' p) (β₁ β₂ : Abelian.Ext A' A'' 0),
      α.comp (β₁ - β₂) (add_zero p) = α.comp β₁ (add_zero p) - α.comp β₂ (add_zero p) := by
    intro A A' A'' p α β₁ β₂
    rw [sub_eq_add_neg, Abelian.Ext.comp_add, Abelian.Ext.comp_neg, ← sub_eq_add_neg]
  have hqf : qq ≫ Limits.kernel.ι T = ι := Limits.kernel.lift_ι _ _ _
  have hS1 : (ShortComplex.mk (Limits.kernel.ι T) T (Limits.kernel.condition T)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel T) inferInstance hTepi
  have hxι : x.comp (Abelian.Ext.mk₀ ι) (add_zero (n + 1)) = 0 := by
    apply (hprod (n + 1)).1
    intro r
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (n + 1)) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]
    exact hz' r
  have hz1' : (x.comp (Abelian.Ext.mk₀ qq) (add_zero (n + 1))).comp
      (Abelian.Ext.mk₀ (Limits.kernel.ι T)) (add_zero (n + 1)) = 0 := by
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (n + 1)) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hqf]
    exact hxι
  obtain ⟨w1, hw1⟩ := Abelian.Ext.covariant_sequence_exact₁ P0 hS1 _ hz1' (n₀ := n) rfl
  have hlim1 : ∃ v : ∀ r, Abelian.Ext P0 (B r) n, ∀ r,
      w1.comp (Abelian.Ext.mk₀ (pr r)) (add_zero n) =
        v r - (v (r + 1)).comp (Abelian.Ext.mk₀ (c r)) (add_zero n) := by
    let E : ℕ → Type _ := fun r => Abelian.Ext P0 (B r) n
    obtain ⟨s, hs⟩ := @nonempty_sections_of_finite_inverse_system ℕ _ _
      (Functor.ofOpSequence (X := E)
        (fun r => TypeCat.ofHom (fun a => w1.comp (Abelian.Ext.mk₀ (pr r)) (add_zero n) +
          a.comp (Abelian.Ext.mk₀ (c r)) (add_zero n))))
      (fun j => hfinB j.unop) (fun j => ⟨(0 : E j.unop)⟩)
    refine ⟨fun r => (s (Opposite.op r) : E r), fun r => ?_⟩
    have h1 := hs (homOfLE (Nat.le_succ r)).op
    rw [Functor.ofOpSequence_map_homOfLE_succ] at h1
    exact eq_sub_of_add_eq h1
  obtain ⟨v, hv⟩ := hlim1
  obtain ⟨V1, hV1⟩ := (hprod n).2 v
  have hVT : V1.comp (Abelian.Ext.mk₀ T) (add_zero n) = w1 := by
    rw [← sub_eq_zero]
    apply (hprod n).1
    intro r
    have hpost : ∀ (a b : Abelian.Ext P0 Yt n),
        (a - b).comp (Abelian.Ext.mk₀ (pr r)) (add_zero n) =
        a.comp (Abelian.Ext.mk₀ (pr r)) (add_zero n) -
          b.comp (Abelian.Ext.mk₀ (pr r)) (add_zero n) := by
      intro a b
      rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg]
    rw [hpost, Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hT r, hsubmk, hcompsub, ← Abelian.Ext.mk₀_comp_mk₀,
      ← Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega), hV1, hV1, hv r,
      sub_self]
  have hz1 : x.comp (Abelian.Ext.mk₀ qq) (add_zero (n + 1)) = 0 := by
    rw [← hw1, ← hVT, Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 1) (by omega),
      hS1.comp_extClass, Abelian.Ext.comp_zero]
  set mm := Limits.kernel.ι (Limits.cokernel.π qq) with hmdef
  set e := Limits.kernel.lift (Limits.cokernel.π qq) qq (Limits.cokernel.condition qq) with hedef
  have hem : e ≫ mm = qq := Limits.kernel.lift_ι _ _ _
  haveI he : Epi e := inferInstanceAs (Epi (Abelian.factorThruImage qq))
  have hS3 : (ShortComplex.mk mm (Limits.cokernel.π mm) (Limits.cokernel.condition mm)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel mm) inferInstance inferInstance
  have hy' : (x.comp (Abelian.Ext.mk₀ e) (add_zero (n + 1))).comp (Abelian.Ext.mk₀ mm)
      (add_zero (n + 1)) = 0 := by
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (n + 1)) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, hem]
    exact hz1
  obtain ⟨u1, hu1⟩ := Abelian.Ext.covariant_sequence_exact₁ P0 hS3 _ hy' (n₀ := n) rfl
  have hmq : mm ≫ Limits.cokernel.π qq = 0 := by
    rw [← cancel_epi e, ← Category.assoc, hem, Limits.cokernel.condition, Limits.comp_zero]
  have hqm : qq ≫ Limits.cokernel.π mm = 0 := by
    have h := congrArg (· ≫ Limits.cokernel.π mm) hem
    rw [← h, Category.assoc, Limits.cokernel.condition, Limits.comp_zero]
  let φ' := Limits.cokernel.desc mm (Limits.cokernel.π qq) hmq
  let ψ' := Limits.cokernel.desc qq (Limits.cokernel.π mm) hqm
  have hφψ : φ' ≫ ψ' = 𝟙 _ := by
    apply Limits.coequalizer.hom_ext
    simp [φ', ψ']
  have hu0 : u1 = 0 := by
    have e1 := Abelian.Ext.comp_mk₀_id u1
    rw [← hφψ, ← Abelian.Ext.mk₀_comp_mk₀,
      ← Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega),
      hC (u1.comp (Abelian.Ext.mk₀ φ') (add_zero n)), Abelian.Ext.zero_comp] at e1
    exact e1.symm
  have hy : x.comp (Abelian.Ext.mk₀ e) (add_zero (n + 1)) = 0 := by
    rw [← hu1, hu0, Abelian.Ext.zero_comp]
  have hS4' : (ShortComplex.mk (Limits.kernel.ι e) e (Limits.kernel.condition e)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel e) inferInstance he
  obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P0 hS4' x hy
  have hke : Limits.kernel.ι e ≫ qq = 0 := by
    have h := congrArg (Limits.kernel.ι e ≫ ·) hem
    rw [← h, ← Category.assoc, Limits.kernel.condition, Limits.zero_comp]
  let φ := Limits.kernel.lift qq (Limits.kernel.ι e) hke
  have hφ : φ ≫ Limits.kernel.ι qq = Limits.kernel.ι e := Limits.kernel.lift_ι _ _ _
  calc x = x₁.comp (Abelian.Ext.mk₀ (Limits.kernel.ι e)) (add_zero (n + 1)) := hx₁.symm
    _ = (x₁.comp (Abelian.Ext.mk₀ φ) (add_zero (n + 1))).comp
          (Abelian.Ext.mk₀ (Limits.kernel.ι qq)) (add_zero (n + 1)) := by
        rw [Abelian.Ext.comp_assoc _ _ _ (add_zero (n + 1)) (add_zero 0) (by omega),
          Abelian.Ext.mk₀_comp_mk₀, hφ]
    _ = 0 := by rw [hK (x₁.comp (Abelian.Ext.mk₀ φ) (add_zero (n + 1))), Abelian.Ext.zero_comp]

theorem wc_latticeU_trace_integral (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G) (hlisse : wcLisseOffS K hP ℓ m S G σ)
    (h0 : ∀ y : wcCohG K (wcP1Over K) hP G 0, y = 0)
    (h2 : ∀ y : wcCohG K (wcP1Over K) hP G 2, y = 0)
    (r₁ : ℕ) (e₁ : wcCohG K (wcP1Over K) hP G 1 ≃+ (Fin r₁ → ℚ_[ℓ]))
    (he₁ : ∀ (c : ℚ_[ℓ]) (y : wcCohG K (wcP1Over K) hP G 1),
      e₁ (wcCohGEnd K (wcP1Over K) hP G 1 (σ c) y) = c • e₁ y)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    (e : ℕ) (he : 1 ≤ e)
    (r : ℕ) (V : ℕ → Scheme.{u}) (q' : (n : ℕ) → V n ⟶ Uo.toScheme) (Γ : ℕ → Type u)
    [∀ n, Group (Γ n)] (α : (n : ℕ) → Γ n →* Aut (V n))
    (ρ : (n : ℕ) → Γ n →* GL (Fin r) (ZMod (ℓ ^ n)))
    (hCOV : ∀ n, 1 ≤ n → wcGalCover (q' n) (Γ n) (α n))
    (hLT : wcLatticeTowerU K hP ℓ m S G σ Uo r V q' Γ α ρ) :
    ∃ t : ℤ_[ℓ],
      (t : ℚ_[ℓ]) = ((wcAddEquivMatrix e₁ (wcCohGFrob K (wcP1Over K) hP G 1)) ^ e).trace :=
by
  classical

  obtain ⟨W, w, k, hqc, hconn, hoff, hsurj, hTh⟩ := hlisse
  obtain ⟨θ, hθ⟩ := hTh

  obtain ⟨Pm, hint⟩ := wc_qclift_transition_lattice K hP m S ℓ G W w hqc hconn hsurj k θ
  obtain ⟨J, hJ⟩ := wc_qclift_integral_subsheaf (wcP1Over K).left G W k ℓ θ Pm
  obtain ⟨τ, hτ⟩ := wc_lcfa_lattice_int_stable K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero
    W w hqc hconn hoff hsurj k θ hθ Pm hint J hJ
  have s5 := wc_lcfa_rationalize K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero
    W w hqc hconn hoff hsurj k θ hθ Pm hint J hJ
  have s6 := wc_lcfa_mod_finite K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero
    W w hqc hconn hoff hsurj k θ hθ Pm hint J hJ
  have s7 := wc_lcfa_int_separated K hP ℓ hℓ m S hS G σ hσ1 hσadd hσmul hzero
    W w hqc hconn hoff hsurj k θ hθ Pm hint J hJ (fun r j hj => s6 r j (by omega))

  have smod : ∀ (R : Type) [Ring R]
      (X : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (s : R → (X ⟶ X)), s 1 = 𝟙 X → (∀ a b, s (a * b) = s b ≫ s a) →
      (∀ a b, s (a + b) = s a + s b) →
      (∀ x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) X 1,
          x.comp (Abelian.Ext.mk₀ (s 1)) (add_zero 1) = x) ∧
      (∀ a b (x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) X 1),
          x.comp (Abelian.Ext.mk₀ (s (a * b))) (add_zero 1) =
          (x.comp (Abelian.Ext.mk₀ (s b)) (add_zero 1)).comp (Abelian.Ext.mk₀ (s a)) (add_zero 1)) ∧
      (∀ a b (x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) X 1),
          x.comp (Abelian.Ext.mk₀ (s (a + b))) (add_zero 1) =
          x.comp (Abelian.Ext.mk₀ (s a)) (add_zero 1) +
            x.comp (Abelian.Ext.mk₀ (s b)) (add_zero 1)) := by
    intro R _ X s h1 hmul hadd
    refine ⟨fun x => ?_, fun a b x => ?_, fun a b x => ?_⟩
    · rw [h1, Abelian.Ext.comp_mk₀_id]
    · rw [hmul, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0)
        (by omega)]
    · rw [hadd, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add]
  have hnsmulExt : ∀ (X : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (n : ℕ)
      (x : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) X 1),
      x.comp (Abelian.Ext.mk₀ (n • 𝟙 X)) (add_zero 1) = n • x := by
    intro X n x
    induction n with
    | zero => rw [zero_nsmul, zero_nsmul, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
    | succ n ih =>
      rw [succ_nsmul, succ_nsmul, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, ih,
        Abelian.Ext.comp_mk₀_id]
  have hτ1 : τ 1 = 𝟙 _ := by
    rw [← cancel_mono J.arrow, hτ, PadicInt.coe_one, hσ1, Category.comp_id, Category.id_comp]
  have hτmul : ∀ a b : ℤ_[ℓ], τ (a * b) = τ b ≫ τ a := by
    intro a b
    rw [← cancel_mono J.arrow, Category.assoc, hτ a, ← Category.assoc, hτ b, Category.assoc,
      hτ (a * b), PadicInt.coe_mul, hσmul]
  have hτadd : ∀ a b : ℤ_[ℓ], τ (a + b) = τ a + τ b := by
    intro a b
    rw [← cancel_mono J.arrow, Preadditive.add_comp, hτ (a + b), hτ a, hτ b, PadicInt.coe_add,
      hσadd, Preadditive.comp_add]
  have hσ0 : σ 0 = 0 := by
    have h := hσadd 0 0
    rw [add_zero] at h
    calc σ 0 = σ 0 + σ 0 - σ 0 := by abel
      _ = σ 0 - σ 0 := by rw [← h]
      _ = 0 := sub_self _
  have hσnat : ∀ n : ℕ, σ (n : ℚ_[ℓ]) = n • 𝟙 G := by
    intro n
    induction n with
    | zero => rw [Nat.cast_zero, hσ0, zero_nsmul]
    | succ n ih => rw [Nat.cast_succ, hσadd, ih, hσ1, succ_nsmul]
  set f : Subobject.underlying.obj J ⟶ Subobject.underlying.obj J := (ℓ ^ 1 : ℕ) • 𝟙 _ with hf
  have hl0 : ((ℓ ^ 1 : ℕ) : ℚ_[ℓ]) ≠ 0 :=
    Nat.cast_ne_zero.mpr (pow_ne_zero _ (Fact.out : Nat.Prime ℓ).ne_zero)
  haveI hiso : IsIso (σ ((ℓ ^ 1 : ℕ) : ℚ_[ℓ])) :=
    ⟨⟨σ ((ℓ ^ 1 : ℕ) : ℚ_[ℓ])⁻¹, by rw [← hσmul, inv_mul_cancel₀ hl0, hσ1],
      by rw [← hσmul, mul_inv_cancel₀ hl0, hσ1]⟩⟩
  have hfa : f ≫ J.arrow = J.arrow ≫ σ ((ℓ ^ 1 : ℕ) : ℚ_[ℓ]) := by
    rw [hσnat, hf, Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp,
      Category.comp_id]
  haveI : Mono (f ≫ J.arrow) := by rw [hfa]; infer_instance
  haveI hmono : Mono f := mono_of_mono f J.arrow
  obtain ⟨A1, Amul, Aadd⟩ := smod ℤ_[ℓ] (Subobject.underlying.obj J) τ hτ1 hτmul hτadd
  let M := Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
    (Subobject.underlying.obj J) 1
  letI smulM : SMul ℤ_[ℓ] M := ⟨fun a x => x.comp (Abelian.Ext.mk₀ (τ a)) (add_zero 1)⟩
  letI modM : Module ℤ_[ℓ] M := Module.ofMinimalAxioms
    (fun a x y => Abelian.Ext.add_comp x y _ _)
    (fun a b x => Aadd a b x)
    (fun a b x => Amul a b x)
    (fun x => A1 x)
  haveI hfin : Finite (Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
      (Limits.cokernel f) 1) := s6 1 1 (by norm_num)
  have hsm : ∀ m' : M, (ℓ : ℤ_[ℓ]) • m' = m'.comp (Abelian.Ext.mk₀ f) (add_zero 1) := by
    intro m'
    rw [Nat.cast_smul_eq_nsmul, hf, hnsmulExt, pow_one]
  have hTr : ∃ T : Finset M, ∀ x : M, ∃ t ∈ T, ∃ m' : M, x = t + (ℓ : ℤ_[ℓ]) • m' := by
    let SC : ShortComplex (Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1}) :=
      ShortComplex.mk f (Limits.cokernel.π f) (Limits.cokernel.condition f)
    have hSC : SC.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel f) hmono inferInstance
    let β : M → Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
        (Limits.cokernel f) 1 :=
      fun x => x.comp (Abelian.Ext.mk₀ (Limits.cokernel.π f)) (add_zero 1)
    have hfr : (Set.range β).Finite := Set.toFinite _
    let pre : Abelian.Ext (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))
        (Limits.cokernel f) 1 → M :=
      fun y => if hy : ∃ x, β x = y then hy.choose else 0
    refine ⟨hfr.toFinset.image pre, fun x => ?_⟩
    refine ⟨pre (β x), Finset.mem_image_of_mem _ (hfr.mem_toFinset.mpr ⟨x, rfl⟩), ?_⟩
    have hpre : β (pre (β x)) = β x := by
      have hy : ∃ x', β x' = β x := ⟨x, rfl⟩
      simp only [pre, dif_pos hy]
      exact hy.choose_spec
    have hsub := map_sub ((Abelian.Ext.mk₀ (Limits.cokernel.π f)).postcomp
      (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) (add_zero 1)) x (pre (β x))
    have h0' : (x - pre (β x)).comp (Abelian.Ext.mk₀ SC.g) (add_zero 1) = 0 := by
      change ((Abelian.Ext.mk₀ (Limits.cokernel.π f)).postcomp
        (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) (add_zero 1))
          (x - pre (β x)) = 0
      rw [hsub]
      exact sub_eq_zero.mpr hpre.symm
    obtain ⟨m', hm'⟩ := Abelian.Ext.covariant_sequence_exact₂ _ hSC (x - pre (β x)) h0'
    refine ⟨m', ?_⟩
    rw [hsm m']
    change x = pre (β x) + m'.comp (Abelian.Ext.mk₀ SC.f) (add_zero 1)
    rw [hm']
    abel
  have hD : ∀ ws : ℕ → M, (∀ n, ws n = (ℓ : ℤ_[ℓ]) • ws (n + 1)) → ws 0 = 0 := by
    intro ws hws
    have hpow : ∀ n : ℕ, ws 0 = ((ℓ : ℤ_[ℓ]) ^ n) • ws n := by
      intro n
      induction n with
      | zero => rw [pow_zero, one_smul]
      | succ n ih => rw [ih, hws n, ← mul_smul, ← pow_succ]
    apply s7 1 le_rfl (by norm_num) (ws 0)
    intro n
    rw [hpow n, ← Nat.cast_pow, Nat.cast_smul_eq_nsmul,
      ← hnsmulExt (Subobject.underlying.obj J) (ℓ ^ n) (ws n),
      Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Limits.cokernel.condition, Abelian.Ext.mk₀_zero,
      Abelian.Ext.comp_zero]
  haveI hMfin : Module.Finite ℤ_[ℓ] M := padic_fg_of_mod_ell_reps ℓ M hTr hD

  let φ : M →+ wcCohG K (wcP1Over K) hP G 1 := (Abelian.Ext.mk₀ J.arrow).postcomp
    (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)) (add_zero 1)
  have hφ' : ∀ (a : ℤ_[ℓ]) (x : M),
      φ (a • x) = wcCohGEnd K (wcP1Over K) hP G 1 (σ (a : ℚ_[ℓ])) (φ x) := by
    intro a x
    change ((x.comp (Abelian.Ext.mk₀ (τ a)) (add_zero 1)).comp
        (Abelian.Ext.mk₀ J.arrow) (add_zero 1)) =
      (x.comp (Abelian.Ext.mk₀ J.arrow) (add_zero 1)).comp
        (Abelian.Ext.mk₀ (σ (a : ℚ_[ℓ]))) (add_zero 1)
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hτ]

  let Fr := wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)
  let T : M →ₗ[ℤ_[ℓ]] M :=
    { toFun := fun x => (Abelian.Ext.mk₀ Fr).comp x (zero_add 1)
      map_add' := fun x y => Abelian.Ext.comp_add _ x y _
      map_smul' := fun a x => by
        show (Abelian.Ext.mk₀ Fr).comp (x.comp (Abelian.Ext.mk₀ (τ a)) (add_zero 1)) (zero_add 1) =
          ((Abelian.Ext.mk₀ Fr).comp x (zero_add 1)).comp (Abelian.Ext.mk₀ (τ a)) (add_zero 1)
        exact (Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_zero 1) (by omega)).symm }

  have hT : ∀ x : M, wcCohGFrob K (wcP1Over K) hP G 1 (φ x) = φ (T x) := by
    intro x
    show (Abelian.Ext.mk₀ Fr).comp (x.comp (Abelian.Ext.mk₀ J.arrow) (add_zero 1)) (zero_add 1) =
      ((Abelian.Ext.mk₀ Fr).comp x (zero_add 1)).comp (Abelian.Ext.mk₀ J.arrow) (add_zero 1)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_zero 1) (by omega)).symm

  have hcommσ : ∀ (c : ℚ_[ℓ]) (y : wcCohG K (wcP1Over K) hP G 1),
      wcCohGFrob K (wcP1Over K) hP G 1 (wcCohGEnd K (wcP1Over K) hP G 1 (σ c) y) =
        wcCohGEnd K (wcP1Over K) hP G 1 (σ c) (wcCohGFrob K (wcP1Over K) hP G 1 y) := by
    intro c y
    show (Abelian.Ext.mk₀ Fr).comp (y.comp (Abelian.Ext.mk₀ (σ c)) (add_zero 1)) (zero_add 1) =
      ((Abelian.Ext.mk₀ Fr).comp y (zero_add 1)).comp (Abelian.Ext.mk₀ (σ c)) (add_zero 1)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add 1) (add_zero 1) (by omega)).symm
  have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r₁ → ℚ_[ℓ]),
      e₁.symm (c • v) = wcCohGEnd K (wcP1Over K) hP G 1 (σ c) (e₁.symm v) := fun c v =>
    e₁.injective (by rw [he₁, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])

  have hspan : ∀ y : wcCohG K (wcP1Over K) hP G 1, ∃ (N : ℕ) (x : M), (ℓ ^ N : ℕ) • y = φ x := by
    intro y
    obtain ⟨N, y₀, hy⟩ := s5 1 y
    exact ⟨N, y₀, hy⟩

  let Φ := wcCohGFrob K (wcP1Over K) hP G 1
  let LA : (Fin r₁ → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r₁ → ℚ_[ℓ]) :=
    { toFun := fun v => e₁ (Φ (e₁.symm v))
      map_add' := fun v w => by simp only [map_add]
      map_smul' := fun c v => by
        simp only [RingHom.id_apply]
        rw [hes, hcommσ, he₁] }
  have hA : wcAddEquivMatrix e₁ Φ = LinearMap.toMatrix' LA := by
    ext a b
    rw [LinearMap.toMatrix'_apply]
    rfl
  let ψ : M →ₗ[ℤ_[ℓ]] (Fin r₁ → ℚ_[ℓ]) :=
    { toFun := fun x => e₁ (φ x)
      map_add' := fun x y => by simp only [map_add]
      map_smul' := fun a x => by
        simp only [RingHom.id_apply]
        rw [hφ', he₁]
        exact algebraMap_smul ℚ_[ℓ] a (e₁ (φ x)) }
  let L := LinearMap.range ψ
  let b := Module.finBasis ℤ_[ℓ] L
  let v : Fin (Module.finrank ℤ_[ℓ] L) → (Fin r₁ → ℚ_[ℓ]) := fun j => ((b j : L) : Fin r₁ → ℚ_[ℓ])
  have hliZ : LinearIndependent ℤ_[ℓ] v :=
    b.linearIndependent.map' L.subtype (Submodule.ker_subtype L)
  have hli : LinearIndependent ℚ_[ℓ] v := (LinearIndependent.iff_fractionRing ℤ_[ℓ] ℚ_[ℓ]).mp hliZ
  have hmemL : ∀ y : L, (y : Fin r₁ → ℚ_[ℓ]) ∈ Submodule.span ℚ_[ℓ] (Set.range v) := by
    intro y
    have hy := b.sum_repr y
    rw [← hy, Submodule.coe_sum]
    refine Submodule.sum_mem _ (fun j _ => ?_)
    rw [Submodule.coe_smul_of_tower, ← algebraMap_smul ℚ_[ℓ]]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
  have hsp : ⊤ ≤ Submodule.span ℚ_[ℓ] (Set.range v) := by
    intro w _
    obtain ⟨N, x, hx⟩ := hspan (e₁.symm w)
    have hx' : (ℓ ^ N : ℕ) • w = ψ x := by
      have h := congrArg e₁ hx
      rw [map_nsmul, AddEquiv.apply_symm_apply] at h
      exact h
    have hl : ((ℓ ^ N : ℕ) : ℚ_[ℓ]) ≠ 0 :=
      Nat.cast_ne_zero.mpr (pow_ne_zero _ (Fact.out : Nat.Prime ℓ).ne_zero)
    have hw : w = ((ℓ ^ N : ℕ) : ℚ_[ℓ])⁻¹ • ψ x := by
      rw [← hx', ← Nat.cast_smul_eq_nsmul ℚ_[ℓ], smul_smul, inv_mul_cancel₀ hl, one_smul]
    rw [hw]
    exact Submodule.smul_mem _ _ (hmemL ⟨ψ x, x, rfl⟩)
  let bQ := Module.Basis.mk hli hsp
  have hLA : ∀ y ∈ L, (LA.restrictScalars ℤ_[ℓ]) y ∈ L := by
    rintro _ ⟨x, rfl⟩
    refine ⟨T x, ?_⟩
    show e₁ (φ (T x)) = e₁ (Φ (e₁.symm (e₁ (φ x))))
    rw [AddEquiv.symm_apply_apply, hT]
  let B₀ : L →ₗ[ℤ_[ℓ]] L := (LA.restrictScalars ℤ_[ℓ]).restrict hLA
  let Bm := LinearMap.toMatrix b b B₀
  have hcol : ∀ j, LA (bQ j) = ∑ i, ((b.repr (B₀ (b j)) i : ℤ_[ℓ]) : ℚ_[ℓ]) • bQ i := by
    intro j
    have h1 : LA (bQ j) = ((B₀ (b j) : L) : Fin r₁ → ℚ_[ℓ]) := by
      rw [Module.Basis.mk_apply]; rfl
    rw [h1]
    conv_lhs => rw [← b.sum_repr (B₀ (b j))]
    rw [Submodule.coe_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [Submodule.coe_smul_of_tower, Module.Basis.mk_apply, ← algebraMap_smul ℚ_[ℓ]]
    rfl
  have hkey : LinearMap.toMatrix bQ bQ LA = Bm.map (PadicInt.Coe.ringHom (p := ℓ)) := by
    ext i j
    rw [LinearMap.toMatrix_apply, hcol j, Module.Basis.repr_sum_self, Matrix.map_apply,
      show Bm i j = b.repr (B₀ (b j)) i from LinearMap.toMatrix_apply b b B₀ i j]
    rfl
  have h1 : (LinearMap.toMatrix' LA ^ e).trace = LinearMap.trace ℚ_[ℓ] _ (LA ^ e) := by
    rw [← LinearMap.toMatrix_eq_toMatrix', LinearMap.toMatrix_pow,
      ← LinearMap.trace_eq_matrix_trace]
  have h2 : LinearMap.trace ℚ_[ℓ] _ (LA ^ e) =
      ((Bm ^ e).map (PadicInt.Coe.ringHom (p := ℓ))).trace := by
    rw [LinearMap.trace_eq_matrix_trace ℚ_[ℓ] bQ, ← LinearMap.toMatrix_pow, hkey, Matrix.map_pow]
  refine ⟨(Bm ^ e).trace, ?_⟩
  rw [hA, h1, h2]
  exact AddMonoidHom.map_trace (PadicInt.Coe.ringHom (p := ℓ)) (Bm ^ e)

theorem wcU_twist_exists (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) {Γ : Type u} [Group Γ] [Fintype Γ]
    {r : ℕ} (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (P : wcGModel ℓ Γ) :
    ∃ Q : wcLnModel (ZMod (ℓ ^ n)), wcIsTwist ℓ n ρ P Q :=
by
  classical
  set φ := wcRhoRed ℓ n ρ with hφdef
  have hzero : φ 0 = 0 := by
    simp [hφdef, wcRhoRed]
  have hadd : ∀ x y, φ (x + y) = φ x + φ y := by
    intro x y
    simp only [hφdef, wcRhoRed, MonoidAlgebra.coeff_add, Finsupp.add_apply, map_add, add_smul,
      Finset.sum_add_distrib]
  have hc : ∀ (x y : MonoidAlgebra ℤ_[ℓ] Γ) (g : Γ),
      (x * y).coeff g = ∑ h, x.coeff h * y.coeff (h⁻¹ * g) := by
    intro x y g
    rw [MonoidAlgebra.coeff_mul_apply_left]
    exact Finsupp.sum_fintype _ _ (fun _ => zero_mul _)
  have hmul : ∀ x y, φ (x * y) = φ x * φ y := by
    intro x y
    simp only [hφdef, wcRhoRed]
    rw [Finset.sum_mul_sum]
    simp_rw [hc, map_sum, map_mul, Finset.sum_smul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun h _ => ?_)
    rw [← Equiv.sum_comp (Equiv.mulLeft h)]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    simp only [Equiv.coe_mulLeft, inv_mul_cancel_left, map_mul, Units.val_mul,
      smul_mul_smul_comm]
  have hsum : ∀ (b : ℕ) (u : Fin b → MonoidAlgebra ℤ_[ℓ] Γ), φ (∑ j, u j) = ∑ j, φ (u j) := by
    intro b u
    let φA : MonoidAlgebra ℤ_[ℓ] Γ →+ Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)) :=
      { toFun := φ, map_zero' := hzero, map_add' := hadd }
    exact map_sum φA u Finset.univ
  let B : ∀ a b : ℕ, Matrix (Fin a) (Fin b) (MonoidAlgebra ℤ_[ℓ] Γ) →
      Matrix (Fin (a * r)) (Fin (b * r)) (ZMod (ℓ ^ n)) :=
    fun a b M => Matrix.of fun x y => φ (M (finProdFinEquiv.symm x).1 (finProdFinEquiv.symm y).1)
      (finProdFinEquiv.symm x).2 (finProdFinEquiv.symm y).2
  have hB0 : ∀ a b, B a b 0 = 0 := by
    intro a b
    ext x y
    simp only [B, Matrix.of_apply, Matrix.zero_apply, hzero]
  have hB : ∀ (a b c : ℕ) (M : Matrix (Fin a) (Fin b) (MonoidAlgebra ℤ_[ℓ] Γ))
      (N : Matrix (Fin b) (Fin c) (MonoidAlgebra ℤ_[ℓ] Γ)),
      B a c (M * N) = B a b M * B b c N := by
    intro a b c M N
    ext x z
    simp only [B, Matrix.of_apply, Matrix.mul_apply]
    rw [hsum]
    simp only [hmul, Matrix.sum_apply, Matrix.mul_apply]
    rw [← (finProdFinEquiv (m := b) (n := r)).sum_comp, Fintype.sum_prod_type]
    simp only [Equiv.symm_apply_apply]
  refine ⟨{ k := fun i => P.k i * r
            hk := fun i hi => by simp [P.hk i hi]
            ε := fun i => B _ _ (P.ε i)
            hε := fun i => (hB _ _ _ _ _).symm.trans (congrArg (B _ _) (P.hε i))
            δ := fun i => B _ _ (P.δ i)
            hδδ := fun i => (hB _ _ _ _ _).symm.trans
              ((congrArg (B _ _) (P.hδδ i)).trans (hB0 _ _))
            hεδ := fun i => (hB _ _ _ _ _).symm.trans (congrArg (B _ _) (P.hεδ i))
            hδε := fun i => (hB _ _ _ _ _).symm.trans (congrArg (B _ _) (P.hδε i))
            f := fun i => B _ _ (P.f i)
            hεf := fun i => (hB _ _ _ _ _).symm.trans (congrArg (B _ _) (P.hεf i))
            hfε := fun i => (hB _ _ _ _ _).symm.trans (congrArg (B _ _) (P.hfε i))
            hδf := fun i => (hB _ _ _ _ _).symm.trans
              ((congrArg (B _ _) (P.hδf i)).trans (hB _ _ _ _ _)) },
    fun i => finProdFinEquiv.symm, fun i x y => rfl, fun i x y => rfl, fun i x y => rfl⟩

theorem wcU_twist_model_trace (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) {Γ : Type u} [Group Γ]
    [Fintype Γ] {r : ℕ} (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (P : wcGModel ℓ Γ)
    (Q : wcLnModel (ZMod (ℓ ^ n))) (hQ : wcIsTwist ℓ n ρ P Q) (e : ℕ) :
    wcLnTr Q e = ∑ g : Γ, PadicInt.toZModPow n (wcGModelHS P e g) *
      ((ρ g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))).trace :=
by
  classical
  obtain ⟨b, -, -, hf⟩ := hQ
  have hRadd : ∀ x y, wcRhoRed ℓ n ρ (x + y) = wcRhoRed ℓ n ρ x + wcRhoRed ℓ n ρ y := by
    intro x y
    simp only [wcRhoRed, MonoidAlgebra.coeff_add, Finsupp.add_apply, map_add, add_smul,
      Finset.sum_add_distrib]
  have hR0 : wcRhoRed ℓ n ρ 0 = 0 := by
    simp [wcRhoRed]
  have hRs : ∀ (g : Γ) (a : ℤ_[ℓ]), wcRhoRed ℓ n ρ (MonoidAlgebra.single g a) =
      PadicInt.toZModPow n a • ((ρ g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))) := by
    intro g a
    unfold wcRhoRed
    rw [Finset.sum_eq_single g]
    · simp [MonoidAlgebra.coeff_single]
    · intro h _ hne
      simp [MonoidAlgebra.coeff_single, Ne.symm hne]
    · simp
  have hR1 : wcRhoRed ℓ n ρ 1 = 1 := by
    rw [MonoidAlgebra.one_def, hRs]
    simp
  have hRmul : ∀ x y, wcRhoRed ℓ n ρ (x * y) = wcRhoRed ℓ n ρ x * wcRhoRed ℓ n ρ y := by
    intro x y
    induction x using MonoidAlgebra.induction_linear with
    | zero => rw [zero_mul, hR0, zero_mul]
    | add x₁ x₂ h₁ h₂ => rw [add_mul, hRadd, hRadd, h₁, h₂, add_mul]
    | single g a =>
      induction y using MonoidAlgebra.induction_linear with
      | zero => rw [mul_zero, hR0, mul_zero]
      | add y₁ y₂ h₁ h₂ => rw [mul_add, hRadd, hRadd, h₁, h₂, mul_add]
      | single h c =>
        rw [MonoidAlgebra.single_mul_single, hRs, hRs, hRs, map_mul, map_mul, Units.val_mul,
          smul_mul_smul_comm]
  let Rh : MonoidAlgebra ℤ_[ℓ] Γ →+* Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)) :=
    { toFun := wcRhoRed ℓ n ρ
      map_one' := hR1
      map_mul' := hRmul
      map_zero' := hR0
      map_add' := hRadd }
  have hRtr : ∀ x, (wcRhoRed ℓ n ρ x).trace = ∑ g : Γ, PadicInt.toZModPow n (x.coeff g) *
      ((ρ g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))).trace := by
    intro x
    simp only [wcRhoRed, Matrix.trace_sum, Matrix.trace_smul, smul_eq_mul]
  have hpow : ∀ i x y, (Q.f i ^ e) x y =
      wcRhoRed ℓ n ρ ((P.f i ^ e) (b i x).1 (b i y).1) (b i x).2 (b i y).2 := by
    intro i
    let Ψ : Matrix (Fin (P.k i)) (Fin (P.k i)) (MonoidAlgebra ℤ_[ℓ] Γ) →+*
        Matrix (Fin (Q.k i)) (Fin (Q.k i)) (ZMod (ℓ ^ n)) :=
      ((Matrix.reindexAlgEquiv (ZMod (ℓ ^ n)) (ZMod (ℓ ^ n)) (b i).symm).toRingEquiv.toRingHom.comp
        (Matrix.compRingEquiv (Fin (P.k i)) (Fin r) (ZMod (ℓ ^ n))).toRingHom).comp Rh.mapMatrix
    have hΨ : ∀ X x y, Ψ X x y = wcRhoRed ℓ n ρ (X (b i x).1 (b i y).1) (b i x).2 (b i y).2 := by
      intro X x y
      rfl
    have hQf : Q.f i = Ψ (P.f i) := by
      ext x y
      rw [hf, hΨ]
    intro x y
    rw [hQf, ← map_pow, hΨ]
  have htr : ∀ i, ((Q.f i) ^ e).trace = ∑ j : Fin (P.k i), ∑ g : Γ,
      PadicInt.toZModPow n (((P.f i ^ e) j j).coeff g) *
        ((ρ g : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))).trace := by
    intro i
    have h1 : ((Q.f i) ^ e).trace = ∑ x : Fin (Q.k i),
        (fun p : Fin (P.k i) × Fin r => wcRhoRed ℓ n ρ ((P.f i ^ e) p.1 p.1) p.2 p.2) (b i x) := by
      simp only [Matrix.trace, Matrix.diag, hpow i]
    rw [h1, Equiv.sum_comp (b i) (fun p : Fin (P.k i) × Fin r =>
      wcRhoRed ℓ n ρ ((P.f i ^ e) p.1 p.1) p.2 p.2), Fintype.sum_prod_type]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [← hRtr]
    rfl
  unfold wcLnTr wcGModelHS
  simp only [htr, map_sum, map_mul, map_pow, map_neg, map_one, Finset.mul_sum, Finset.sum_mul]
  conv_rhs => rw [Finset.sum_comm]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  conv_rhs => rw [Finset.sum_comm]
  refine Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun g _ => ?_))
  ring

theorem wcU_ab_quasiIso_cone_exact (B W : CochainComplex AddCommGrpCat.{u+1} ℕ) (Ψ' : B ⟶ W)
    (hΨ' : QuasiIso Ψ') :
    (∀ (β : B.X 1) (γ : W.X 0), (B.d 1 2).hom β = 0 → (Ψ'.f 1).hom β = (W.d 0 1).hom γ →
      ∃ b : B.X 0, (B.d 0 1).hom b = β ∧ (Ψ'.f 0).hom b = γ) ∧
    (∀ (n : ℕ) (β : B.X (n + 2)) (γ : W.X (n + 1)), (B.d (n + 2) (n + 3)).hom β = 0 →
      (Ψ'.f (n + 2)).hom β = (W.d (n + 1) (n + 2)).hom γ →
      ∃ (b : B.X (n + 1)) (w : W.X n), (B.d (n + 1) (n + 2)).hom b = β ∧
        (Ψ'.f (n + 1)).hom b + (W.d n (n + 1)).hom w = γ) ∧
    (∀ b : B.X 0, (B.d 0 1).hom b = 0 → (Ψ'.f 0).hom b = 0 → b = 0) :=
by

  let T : AddCommGrpCat.{u+1} := AddCommGrpCat.of (ULift.{u+1} ℤ)
  let hat : ∀ (X : AddCommGrpCat.{u+1}) (_ : X), T ⟶ X := fun X x =>
    AddCommGrpCat.ofHom ((zmultiplesHom X x).comp AddEquiv.ulift.toAddMonoidHom)
  have hat_apply : ∀ (X : AddCommGrpCat.{u+1}) (x : X) (n : ℤ),
      (hat X x).hom (ULift.up n) = n • x := by
    intro X x n; rfl
  have T1 : ∀ (X Y : AddCommGrpCat.{u+1}) (g : X ⟶ Y) (x : X), g.hom x = 0 →
      hat X x ≫ g = 0 := by
    intro X Y g x hx
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨n⟩
    rw [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, hat_apply, map_zsmul, hx, smul_zero,
      AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply]
  have T2 : ∀ (X Y Z : AddCommGrpCat.{u+1}) (g : X ⟶ Z) (h : Y ⟶ Z) (x : X) (y : Y),
      g.hom x = h.hom y → hat X x ≫ g = hat Y y ≫ h := by
    intro X Y Z g h x y hxy
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    rintro ⟨n⟩
    rw [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, hat_apply, map_zsmul, hxy,
      AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, hat_apply, map_zsmul]
  have hiso : ∀ j, IsIso (HomologicalComplex.homologyMap Ψ' j) := by
    intro j
    haveI := hΨ'
    exact (quasiIsoAt_iff_isIso_homologyMap Ψ' j).mp (QuasiIso.quasiIsoAt j)

  have inj : ∀ (i j : ℕ), (ComplexShape.up ℕ).prev j = i → ∀ (b : B.X j) (w : W.X i),
      (B.d j (j + 1)).hom b = 0 → (Ψ'.f j).hom b = (W.d i j).hom w →
      ∃ b' : B.X i, (B.d i j).hom b' = b := by
    intro i j hij b w hb hw
    have hmono : Mono (HomologicalComplex.homologyMap Ψ' j) := by
      haveI := hiso j; infer_instance
    obtain ⟨A', π, hπ, x₁, hx⟩ :=
      (HomologicalComplex.mono_homologyMap_iff_up_to_refinements Ψ' i j (j + 1) hij
        (CochainComplex.next ℕ j)).mp hmono (hat _ b) (T1 _ _ _ b hb) (hat _ w)
        (T2 _ _ _ _ _ b w hw)
    obtain ⟨t, ht⟩ := (AddCommGrpCat.epi_iff_surjective π).mp hπ (ULift.up 1)
    refine ⟨x₁.hom t, ?_⟩
    have h := congrArg (fun f => f.hom t) hx
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, ht, hat_apply, one_zsmul] at h
    exact h.symm

  have surj : ∀ (i j : ℕ), (ComplexShape.up ℕ).prev j = i → ∀ (w : W.X j),
      (W.d j (j + 1)).hom w = 0 →
      ∃ (b : B.X j) (w' : W.X i), (B.d j (j + 1)).hom b = 0 ∧
        (Ψ'.f j).hom b + (W.d i j).hom w' = w := by
    intro i j hij w hw
    have hepi : Epi (HomologicalComplex.homologyMap Ψ' j) := by
      haveI := hiso j; infer_instance
    obtain ⟨A', π, hπ, x₂, hx₂, y₁, hxy⟩ :=
      (HomologicalComplex.epi_homologyMap_iff_up_to_refinements Ψ' i j (j + 1) hij
        (CochainComplex.next ℕ j)).mp hepi (hat _ w) (T1 _ _ _ w hw)
    obtain ⟨t, ht⟩ := (AddCommGrpCat.epi_iff_surjective π).mp hπ (ULift.up 1)
    refine ⟨x₂.hom t, y₁.hom t, ?_, ?_⟩
    · have h := congrArg (fun f => f.hom t) hx₂
      simpa only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, AddCommGrpCat.hom_zero,
        AddMonoidHom.zero_apply] using h
    · have h := congrArg (fun f => f.hom t) hxy
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, ht, hat_apply, one_zsmul,
        AddCommGrpCat.hom_add, AddMonoidHom.add_apply] at h
      exact h.symm
  have hB00 : B.d 0 0 = 0 := B.shape 0 0 (by simp)
  have hW00 : W.d 0 0 = 0 := W.shape 0 0 (by simp)
  refine ⟨?_, ?_, ?_⟩
  ·
    intro β γ hβ hγ
    obtain ⟨b₁, hb₁⟩ := inj 0 1 (CochainComplex.prev_nat_succ 0) β γ hβ hγ
    have hcyc : (W.d 0 (0 + 1)).hom (γ - (Ψ'.f 0).hom b₁) = 0 := by
      have hc := congrArg (fun f => f.hom b₁) (Ψ'.comm 0 1)
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at hc
      show (W.d 0 1).hom (γ - (Ψ'.f 0).hom b₁) = 0
      rw [map_sub, hc, hb₁, hγ, sub_self]
    obtain ⟨b₂, w', hb₂, hw'⟩ := surj 0 0 CochainComplex.prev_nat_zero _ hcyc
    rw [hW00, AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply, add_zero] at hw'
    refine ⟨b₁ + b₂, ?_, ?_⟩
    · rw [map_add, hb₁]
      have : (B.d 0 1).hom b₂ = 0 := hb₂
      rw [this, add_zero]
    · rw [map_add, hw']
      abel
  ·
    intro n β γ hβ hγ
    obtain ⟨b₁, hb₁⟩ := inj (n + 1) (n + 2) (CochainComplex.prev_nat_succ (n + 1)) β γ hβ hγ
    have hcyc : (W.d (n + 1) (n + 1 + 1)).hom (γ - (Ψ'.f (n + 1)).hom b₁) = 0 := by
      have hc := congrArg (fun f => f.hom b₁) (Ψ'.comm (n + 1) (n + 2))
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at hc
      show (W.d (n + 1) (n + 2)).hom (γ - (Ψ'.f (n + 1)).hom b₁) = 0
      rw [map_sub, hc, hb₁, hγ, sub_self]
    obtain ⟨b₂, w', hb₂, hw'⟩ := surj n (n + 1) (CochainComplex.prev_nat_succ n) _ hcyc
    refine ⟨b₁ + b₂, w', ?_, ?_⟩
    · rw [map_add, hb₁]
      have : (B.d (n + 1) (n + 2)).hom b₂ = 0 := hb₂
      rw [this, add_zero]
    · rw [map_add, add_assoc, hw']
      abel
  ·
    intro b hb h0
    obtain ⟨b', hb'⟩ := inj 0 0 CochainComplex.prev_nat_zero b 0 hb
      (by rw [map_zero]; exact h0)
    rw [hB00, AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] at hb'
    exact hb'.symm

theorem wcU_lnmodel_lift_htpy (N : ℕ) (Q : wcLnModel (ZMod N))
    (B W : CochainComplex AddCommGrpCat.{u+1} ℕ) (hB : ∀ i (x : B.X i), N • x = 0)
    (hW : ∀ i (x : W.X i), N • x = 0) (Ψ' : B ⟶ W)
    (hCE0 : ∀ (β : B.X 1) (γ : W.X 0), (B.d 1 2).hom β = 0 → (Ψ'.f 1).hom β = (W.d 0 1).hom γ →
      ∃ b : B.X 0, (B.d 0 1).hom b = β ∧ (Ψ'.f 0).hom b = γ)
    (hCES : ∀ (n : ℕ) (β : B.X (n + 2)) (γ : W.X (n + 1)), (B.d (n + 2) (n + 3)).hom β = 0 →
      (Ψ'.f (n + 2)).hom β = (W.d (n + 1) (n + 2)).hom γ →
      ∃ (b : B.X (n + 1)) (w : W.X n), (B.d (n + 1) (n + 2)).hom b = β ∧
        (Ψ'.f (n + 1)).hom b + (W.d n (n + 1)).hom w = γ)
    (φ : wcLnModelAb.{u+1} Q ⟶ W) :
    ∃ χ : wcLnModelAb.{u+1} Q ⟶ B, Nonempty (Homotopy (χ ≫ Ψ') φ) :=
by
  classical

  have FL : ∀ (i : ℕ) (X Y : Type (u+1)) [AddCommGroup X] [AddCommGroup Y], (∀ x : X, N • x = 0) →
      ∀ (p : X →+ Y) (φ : ULift.{u+1} (wcIdemSub (Q.ε i)) →+ Y), (∀ v, ∃ x, p x = φ v) →
      ∃ φ' : ULift.{u+1} (wcIdemSub (Q.ε i)) →+ X, ∀ v, p (φ' v) = φ v := by
    intro i X Y _ _ hX p φ hφ
    have hrow : ∀ j : Fin (Q.k i),
        Matrix.vecMul (fun c => Q.ε i j c) (Q.ε i) = fun c => Q.ε i j c := by
      intro j
      funext c
      have h := congrFun (congrFun (Q.hε i) j) c
      rw [Matrix.mul_apply] at h
      simpa [Matrix.vecMul, dotProduct] using h
    let r : Fin (Q.k i) → wcIdemSub (Q.ε i) := fun j => ⟨fun c => Q.ε i j c, hrow j⟩
    have hdec : ∀ v : wcIdemSub (Q.ε i),
        v = ∑ j, (((v : Fin (Q.k i) → ZMod N) j).cast : ℤ) • r j := by
      intro v
      apply Subtype.ext
      rw [AddSubgroup.val_finsetSum]
      funext c
      rw [Finset.sum_apply]
      have hv : Matrix.vecMul (v : Fin (Q.k i) → ZMod N) (Q.ε i) = v := v.2
      conv_lhs => rw [← hv]
      simp only [Matrix.vecMul, dotProduct, AddSubgroup.coe_zsmul, Pi.smul_apply, zsmul_eq_mul,
        ZMod.intCast_zmod_cast, r]
    choose a ha using fun j => hφ (ULift.up (r j))
    let fj : Fin (Q.k i) → ZMod N →+ X := fun j => ZMod.lift N ⟨zmultiplesHom X (a j), by
      rw [zmultiplesHom_apply, natCast_zsmul]; exact hX _⟩
    have hfj : ∀ j (z : ℤ), fj j (z : ZMod N) = z • a j := by
      intro j z
      simp only [fj, ZMod.lift_coe, zmultiplesHom_apply]
    refine ⟨∑ j, (fj j).comp ((Pi.evalAddMonoidHom (fun _ => ZMod N) j).comp
      ((wcIdemSub (Q.ε i)).subtype.comp AddEquiv.ulift.toAddMonoidHom)), ?_⟩
    intro v
    rw [AddMonoidHom.finset_sum_apply, map_sum]
    have hφv : φ v = φ (AddEquiv.ulift.symm
        (∑ j, ((((AddEquiv.ulift v : wcIdemSub (Q.ε i)) : Fin (Q.k i) → ZMod N) j).cast : ℤ) • r j)) := by
      rw [← hdec]
      rfl
    rw [hφv, map_sum, map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    simp only [AddMonoidHom.comp_apply, Pi.evalAddMonoidHom_apply, AddSubgroup.coe_subtype,
      AddEquiv.coe_toAddMonoidHom]
    conv_lhs => rw [← ZMod.intCast_zmod_cast
      (((AddEquiv.ulift v : wcIdemSub (Q.ε i)) : Fin (Q.k i) → ZMod N) j)]
    rw [hfj, map_zsmul, map_zsmul, map_zsmul, ha]
    rfl

  have hsub : ∀ n, Subsingleton ((wcLnModelAb.{u+1} Q).X (n + 3)) := by
    intro n
    show Subsingleton (ULift.{u+1} (wcIdemSub (Q.ε (n + 3))))
    constructor
    intro x y
    apply ULift.ext
    apply Subtype.ext
    funext j
    exact absurd j.2 (by have := Q.hk (n + 3) (by omega); omega)

  have main : ∀ (A : CochainComplex AddCommGrpCat.{u+1} ℕ), (∀ n, Subsingleton (A.X (n + 3))) →
      (∀ (i : ℕ) (X Y : Type (u+1)) [AddCommGroup X] [AddCommGroup Y], (∀ x : X, N • x = 0) →
        ∀ (p : X →+ Y) (φ : A.X i →+ Y), (∀ v, ∃ x, p x = φ v) →
        ∃ φ' : A.X i →+ X, ∀ v, p (φ' v) = φ v) →
      ∀ (φ : A ⟶ W), ∃ χ : A ⟶ B, Nonempty (Homotopy (χ ≫ Ψ') φ) := by
    intro A hsubA FLA φ
    have cmW : ∀ (i j : ℕ) (v : A.X i),
        (W.d i j).hom ((φ.f i).hom v) = (φ.f j).hom ((A.d i j).hom v) := by
      intro i j v
      have := congrArg (fun h : A.X i ⟶ W.X j => h.hom v) (φ.comm i j)
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at this
      exact this
    have dd : ∀ (i j k : ℕ) (v : A.X i), (A.d j k).hom ((A.d i j).hom v) = 0 := by
      intro i j k v
      have := congrArg (fun h : A.X i ⟶ A.X k => h.hom v) (A.d_comp_d i j k)
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply,
        AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] at this
      exact this
    haveI h3 : Subsingleton (A.X 3) := hsubA 0
    have hd23 : ∀ v : A.X 2, (A.d 2 3).hom v = 0 := fun v => Subsingleton.elim _ _

    obtain ⟨φ2, hφ2⟩ := FLA 2 (B.X 2 × W.X 1) (B.X 3 × W.X 2)
      (fun x => Prod.ext (by rw [Prod.smul_fst]; exact hB 2 x.1)
        (by rw [Prod.smul_snd]; exact hW 1 x.2))
      (((B.d 2 3).hom.comp (AddMonoidHom.fst _ _)).prod
        ((Ψ'.f 2).hom.comp (AddMonoidHom.fst _ _) + (W.d 1 2).hom.comp (AddMonoidHom.snd _ _)))
      ((0 : A.X 2 →+ B.X 3).prod (φ.f 2).hom)
      (by
        intro v
        have pre1 : (B.d 3 4).hom (0 : B.X 3) = 0 := map_zero _
        have pre2 : (Ψ'.f 3).hom (0 : B.X 3) = (W.d 2 3).hom ((φ.f 2).hom v) := by
          rw [map_zero, cmW 2 3 v, hd23, map_zero]
        obtain ⟨b, w, h1, h2⟩ := hCES 1 (0 : B.X 3) ((φ.f 2).hom v) pre1 pre2
        exact ⟨(b, w), Prod.ext h1 h2⟩)
    let c2 : A.X 2 →+ B.X 2 := (AddMonoidHom.fst _ _).comp φ2
    let h2 : A.X 2 →+ W.X 1 := (AddMonoidHom.snd _ _).comp φ2
    have E2a : ∀ v, (B.d 2 3).hom (c2 v) = 0 :=
      fun v => congrArg Prod.fst (hφ2 v)
    have E2b : ∀ v, (Ψ'.f 2).hom (c2 v) + (W.d 1 2).hom (h2 v) = (φ.f 2).hom v :=
      fun v => congrArg Prod.snd (hφ2 v)

    obtain ⟨φ1, hφ1⟩ := FLA 1 (B.X 1 × W.X 0) (B.X 2 × W.X 1)
      (fun x => Prod.ext (by rw [Prod.smul_fst]; exact hB 1 x.1)
        (by rw [Prod.smul_snd]; exact hW 0 x.2))
      (((B.d 1 2).hom.comp (AddMonoidHom.fst _ _)).prod
        ((Ψ'.f 1).hom.comp (AddMonoidHom.fst _ _) + (W.d 0 1).hom.comp (AddMonoidHom.snd _ _)))
      ((c2.comp (A.d 1 2).hom).prod ((φ.f 1).hom - h2.comp (A.d 1 2).hom))
      (by
        intro v
        have pre1 : (B.d 2 3).hom (c2 ((A.d 1 2).hom v)) = 0 := E2a _
        have pre2 : (Ψ'.f 2).hom (c2 ((A.d 1 2).hom v)) =
            (W.d 1 2).hom ((φ.f 1).hom v - h2 ((A.d 1 2).hom v)) := by
          rw [map_sub, cmW 1 2 v, ← E2b ((A.d 1 2).hom v)]
          abel
        obtain ⟨b, w, e1, e2⟩ := hCES 0 (c2 ((A.d 1 2).hom v))
          ((φ.f 1).hom v - h2 ((A.d 1 2).hom v)) pre1 pre2
        exact ⟨(b, w), Prod.ext e1 e2⟩)
    let c1 : A.X 1 →+ B.X 1 := (AddMonoidHom.fst _ _).comp φ1
    let h1 : A.X 1 →+ W.X 0 := (AddMonoidHom.snd _ _).comp φ1
    have E1a : ∀ v, (B.d 1 2).hom (c1 v) = c2 ((A.d 1 2).hom v) :=
      fun v => congrArg Prod.fst (hφ1 v)
    have E1b : ∀ v, (Ψ'.f 1).hom (c1 v) + (W.d 0 1).hom (h1 v) =
        (φ.f 1).hom v - h2 ((A.d 1 2).hom v) :=
      fun v => congrArg Prod.snd (hφ1 v)

    obtain ⟨φ0, hφ0⟩ := FLA 0 (B.X 0) (B.X 1 × W.X 0) (hB 0)
      ((B.d 0 1).hom.prod (Ψ'.f 0).hom)
      ((c1.comp (A.d 0 1).hom).prod ((φ.f 0).hom - h1.comp (A.d 0 1).hom))
      (by
        intro v
        have pre1 : (B.d 1 2).hom (c1 ((A.d 0 1).hom v)) = 0 := by
          rw [E1a, dd, map_zero]
        have pre2 : (Ψ'.f 1).hom (c1 ((A.d 0 1).hom v)) =
            (W.d 0 1).hom ((φ.f 0).hom v - h1 ((A.d 0 1).hom v)) := by
          have e := E1b ((A.d 0 1).hom v)
          rw [dd, map_zero, sub_zero] at e
          rw [map_sub, cmW 0 1 v, ← e]
          abel
        obtain ⟨b, e1, e2⟩ := hCE0 _ _ pre1 pre2
        exact ⟨b, Prod.ext e1 e2⟩)
    have E0a : ∀ v, (B.d 0 1).hom (φ0 v) = c1 ((A.d 0 1).hom v) :=
      fun v => congrArg Prod.fst (hφ0 v)
    have E0b : ∀ v, (Ψ'.f 0).hom (φ0 v) = (φ.f 0).hom v - h1 ((A.d 0 1).hom v) :=
      fun v => congrArg Prod.snd (hφ0 v)

    let F : ∀ i, A.X i ⟶ B.X i := fun i =>
      match i with
      | 0 => AddCommGrpCat.ofHom φ0
      | 1 => AddCommGrpCat.ofHom c1
      | 2 => AddCommGrpCat.ofHom c2
      | _ + 3 => 0
    have hF : ∀ i j, (ComplexShape.up ℕ).Rel i j → F i ≫ B.d i j = A.d i j ≫ F j := by
      intro i j hij
      simp only [ComplexShape.up_Rel] at hij
      subst hij
      match i with
      | 0 =>
        show AddCommGrpCat.ofHom φ0 ≫ B.d 0 1 = A.d 0 1 ≫ AddCommGrpCat.ofHom c1
        ext v
        simp only [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom, AddMonoidHom.coe_comp,
          Function.comp_apply]
        exact E0a v
      | 1 =>
        show AddCommGrpCat.ofHom c1 ≫ B.d 1 2 = A.d 1 2 ≫ AddCommGrpCat.ofHom c2
        ext v
        simp only [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom, AddMonoidHom.coe_comp,
          Function.comp_apply]
        exact E1a v
      | 2 =>
        show AddCommGrpCat.ofHom c2 ≫ B.d 2 3 = A.d 2 3 ≫ 0
        rw [Limits.comp_zero]
        ext v
        simp only [AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom, AddMonoidHom.coe_comp,
          Function.comp_apply, AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply]
        exact E2a v
      | n + 3 =>
        haveI := hsubA n
        exact Limits.IsZero.eq_of_src (AddCommGrpCat.isZero_of_subsingleton _) _ _
    let χ : A ⟶ B := { f := F, comm' := hF }

    let hom : ∀ i j, A.X i ⟶ W.X j := fun i j =>
      match i, j with
      | 1, 0 => AddCommGrpCat.ofHom h1
      | 2, 1 => AddCommGrpCat.ofHom h2
      | _, _ => 0
    have H : Homotopy φ (χ ≫ Ψ') := by
      refine { hom := hom, zero := ?_, comm := ?_ }
      · intro i j hij
        rcases i with _ | _ | _ | i <;> rcases j with _ | _ | j <;>
          first | rfl | (exfalso; exact hij rfl)
      · intro i
        match i with
        | 0 =>
          rw [show dNext 0 hom = A.d 0 1 ≫ hom 1 0 from Homotopy.dNext_cochainComplex hom 0,
            Homotopy.prevD_zero_cochainComplex]
          show φ.f 0 = A.d 0 1 ≫ AddCommGrpCat.ofHom h1 + 0 + AddCommGrpCat.ofHom φ0 ≫ Ψ'.f 0
          ext v
          simp only [AddCommGrpCat.hom_add, AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom,
            AddCommGrpCat.hom_zero, AddMonoidHom.add_apply, AddMonoidHom.coe_comp,
            Function.comp_apply, AddMonoidHom.zero_apply, add_zero]
          rw [E0b]
          abel
        | 1 =>
          rw [show dNext 1 hom = A.d 1 2 ≫ hom 2 1 from Homotopy.dNext_cochainComplex hom 1,
            show prevD 1 hom = hom 1 0 ≫ W.d 0 1 from Homotopy.prevD_succ_cochainComplex hom 0]
          show φ.f 1 = A.d 1 2 ≫ AddCommGrpCat.ofHom h2 + AddCommGrpCat.ofHom h1 ≫ W.d 0 1 +
            AddCommGrpCat.ofHom c1 ≫ Ψ'.f 1
          ext v
          simp only [AddCommGrpCat.hom_add, AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom,
            AddMonoidHom.add_apply, AddMonoidHom.coe_comp, Function.comp_apply]
          have e := E1b v
          rw [eq_sub_iff_add_eq] at e
          rw [← e]
          abel
        | 2 =>
          rw [show dNext 2 hom = A.d 2 3 ≫ hom 3 2 from Homotopy.dNext_cochainComplex hom 2,
            show prevD 2 hom = hom 2 1 ≫ W.d 1 2 from Homotopy.prevD_succ_cochainComplex hom 1]
          show φ.f 2 = A.d 2 3 ≫ 0 + AddCommGrpCat.ofHom h2 ≫ W.d 1 2 +
            AddCommGrpCat.ofHom c2 ≫ Ψ'.f 2
          rw [Limits.comp_zero, zero_add]
          ext v
          simp only [AddCommGrpCat.hom_add, AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom,
            AddMonoidHom.add_apply, AddMonoidHom.coe_comp, Function.comp_apply]
          rw [← E2b v]
          abel
        | n + 3 =>
          haveI := hsubA n
          exact Limits.IsZero.eq_of_src (AddCommGrpCat.isZero_of_subsingleton _) _ _
    exact ⟨χ, ⟨H.symm⟩⟩
  exact main _ hsub FL φ

theorem wcU_lnmodel_htpy_cancel (N : ℕ) (Q : wcLnModel (ZMod N))
    (B W : CochainComplex AddCommGrpCat.{u+1} ℕ) (hB : ∀ i (x : B.X i), N • x = 0)
    (hW : ∀ i (x : W.X i), N • x = 0) (Ψ' : B ⟶ W)
    (hCE0 : ∀ (β : B.X 1) (γ : W.X 0), (B.d 1 2).hom β = 0 → (Ψ'.f 1).hom β = (W.d 0 1).hom γ →
      ∃ b : B.X 0, (B.d 0 1).hom b = β ∧ (Ψ'.f 0).hom b = γ)
    (hCES : ∀ (n : ℕ) (β : B.X (n + 2)) (γ : W.X (n + 1)), (B.d (n + 2) (n + 3)).hom β = 0 →
      (Ψ'.f (n + 2)).hom β = (W.d (n + 1) (n + 2)).hom γ →
      ∃ (b : B.X (n + 1)) (w : W.X n), (B.d (n + 1) (n + 2)).hom b = β ∧
        (Ψ'.f (n + 1)).hom b + (W.d n (n + 1)).hom w = γ)
    (hINJ0 : ∀ b : B.X 0, (B.d 0 1).hom b = 0 → (Ψ'.f 0).hom b = 0 → b = 0)
    (f g : wcLnModelAb.{u+1} Q ⟶ B) (H : Homotopy (f ≫ Ψ') (g ≫ Ψ')) :
    Nonempty (Homotopy f g) :=
by
  classical

  have FL : ∀ (i : ℕ) (X Y : Type (u+1)) [AddCommGroup X] [AddCommGroup Y], (∀ x : X, N • x = 0) →
      ∀ (p : X →+ Y) (φ : ULift.{u+1} (wcIdemSub (Q.ε i)) →+ Y), (∀ v, ∃ x, p x = φ v) →
      ∃ φ' : ULift.{u+1} (wcIdemSub (Q.ε i)) →+ X, ∀ v, p (φ' v) = φ v := by
    intro i X Y _ _ hX p φ hφ
    have hrow : ∀ j : Fin (Q.k i),
        Matrix.vecMul (fun c => Q.ε i j c) (Q.ε i) = fun c => Q.ε i j c := by
      intro j
      funext c
      have h := congrFun (congrFun (Q.hε i) j) c
      rw [Matrix.mul_apply] at h
      simpa [Matrix.vecMul, dotProduct] using h
    let r : Fin (Q.k i) → wcIdemSub (Q.ε i) := fun j => ⟨fun c => Q.ε i j c, hrow j⟩
    have hdec : ∀ v : wcIdemSub (Q.ε i),
        v = ∑ j, (((v : Fin (Q.k i) → ZMod N) j).cast : ℤ) • r j := by
      intro v
      apply Subtype.ext
      rw [AddSubgroup.val_finsetSum]
      funext c
      rw [Finset.sum_apply]
      have hv : Matrix.vecMul (v : Fin (Q.k i) → ZMod N) (Q.ε i) = v := v.2
      conv_lhs => rw [← hv]
      simp only [Matrix.vecMul, dotProduct, AddSubgroup.coe_zsmul, Pi.smul_apply, zsmul_eq_mul,
        ZMod.intCast_zmod_cast, r]
    choose a ha using fun j => hφ (ULift.up (r j))
    let fj : Fin (Q.k i) → ZMod N →+ X := fun j => ZMod.lift N ⟨zmultiplesHom X (a j), by
      rw [zmultiplesHom_apply, natCast_zsmul]; exact hX _⟩
    have hfj : ∀ j (z : ℤ), fj j (z : ZMod N) = z • a j := by
      intro j z
      simp only [fj, ZMod.lift_coe, zmultiplesHom_apply]
    refine ⟨∑ j, (fj j).comp ((Pi.evalAddMonoidHom (fun _ => ZMod N) j).comp
      ((wcIdemSub (Q.ε i)).subtype.comp AddEquiv.ulift.toAddMonoidHom)), ?_⟩
    intro v
    rw [AddMonoidHom.finset_sum_apply, map_sum]
    have hφv : φ v = φ (AddEquiv.ulift.symm
        (∑ j, ((((AddEquiv.ulift v : wcIdemSub (Q.ε i)) : Fin (Q.k i) → ZMod N) j).cast : ℤ) • r j)) := by
      rw [← hdec]
      rfl
    rw [hφv, map_sum, map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    simp only [AddMonoidHom.comp_apply, Pi.evalAddMonoidHom_apply, AddSubgroup.coe_subtype,
      AddEquiv.coe_toAddMonoidHom]
    conv_lhs => rw [← ZMod.intCast_zmod_cast
      (((AddEquiv.ulift v : wcIdemSub (Q.ε i)) : Fin (Q.k i) → ZMod N) j)]
    rw [hfj, map_zsmul, map_zsmul, map_zsmul, ha]
    rfl

  have hsub : ∀ n, Subsingleton ((wcLnModelAb.{u+1} Q).X (n + 3)) := by
    intro n
    show Subsingleton (ULift.{u+1} (wcIdemSub (Q.ε (n + 3))))
    constructor
    intro x y
    apply ULift.ext
    apply Subtype.ext
    funext j
    exact absurd j.2 (by have := Q.hk (n + 3) (by omega); omega)

  have main : ∀ (A : CochainComplex AddCommGrpCat.{u+1} ℕ), (∀ n, Subsingleton (A.X (n + 3))) →
      (∀ (i : ℕ) (X Y : Type (u+1)) [AddCommGroup X] [AddCommGroup Y], (∀ x : X, N • x = 0) →
        ∀ (p : X →+ Y) (φ : A.X i →+ Y), (∀ v, ∃ x, p x = φ v) →
        ∃ φ' : A.X i →+ X, ∀ v, p (φ' v) = φ v) →
      ∀ (f g : A ⟶ B), Homotopy (f ≫ Ψ') (g ≫ Ψ') → Nonempty (Homotopy f g) := by
    intro A hsubA FLA f g H
    have cm : ∀ (φ : A ⟶ B) (i j : ℕ) (v : A.X i),
        (B.d i j).hom ((φ.f i).hom v) = (φ.f j).hom ((A.d i j).hom v) := by
      intro φ i j v
      have := congrArg (fun h : A.X i ⟶ B.X j => h.hom v) (φ.comm i j)
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at this
      exact this
    have dd : ∀ (i j k : ℕ) (v : A.X i), (A.d j k).hom ((A.d i j).hom v) = 0 := by
      intro i j k v
      have := congrArg (fun h : A.X i ⟶ A.X k => h.hom v) (A.d_comp_d i j k)
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply,
        AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply] at this
      exact this
    have E0 : ∀ v : A.X 0, (Ψ'.f 0).hom ((f.f 0).hom v) =
        (H.hom 1 0).hom ((A.d 0 1).hom v) + (Ψ'.f 0).hom ((g.f 0).hom v) := by
      intro v
      have h := H.comm 0
      rw [Homotopy.dNext_cochainComplex, Homotopy.prevD_zero_cochainComplex, add_zero] at h
      have := congrArg (fun h : A.X 0 ⟶ W.X 0 => h.hom v) h
      simp only [HomologicalComplex.comp_f, AddCommGrpCat.hom_comp, AddCommGrpCat.hom_add,
        AddMonoidHom.coe_comp, Function.comp_apply, AddMonoidHom.add_apply] at this
      exact this
    have ES : ∀ (n : ℕ) (v : A.X (n + 1)), (Ψ'.f (n + 1)).hom ((f.f (n + 1)).hom v) =
        (H.hom (n + 1 + 1) (n + 1)).hom ((A.d (n + 1) (n + 1 + 1)).hom v) +
        (W.d n (n + 1)).hom ((H.hom (n + 1) n).hom v) +
          (Ψ'.f (n + 1)).hom ((g.f (n + 1)).hom v) := by
      intro n v
      have h := H.comm (n + 1)
      rw [Homotopy.dNext_cochainComplex, Homotopy.prevD_succ_cochainComplex] at h
      have := congrArg (fun h : A.X (n + 1) ⟶ W.X (n + 1) => h.hom v) h
      simp only [HomologicalComplex.comp_f, AddCommGrpCat.hom_comp, AddCommGrpCat.hom_add,
        AddMonoidHom.coe_comp, Function.comp_apply, AddMonoidHom.add_apply] at this
      exact this

    haveI h3 : Subsingleton (A.X 3) := hsubA 0
    have hd23 : ∀ v : A.X 2, (A.d 2 3).hom v = 0 := fun v => Subsingleton.elim _ _
    have E2 : ∀ v : A.X 2, (Ψ'.f 2).hom ((f.f 2).hom v - (g.f 2).hom v) =
        (W.d 1 2).hom ((H.hom 2 1).hom v) := by
      intro v
      have h : (Ψ'.f 2).hom ((f.f 2).hom v) = (H.hom 3 2).hom ((A.d 2 3).hom v) +
          (W.d 1 2).hom ((H.hom 2 1).hom v) + (Ψ'.f 2).hom ((g.f 2).hom v) := ES 1 v
      rw [map_sub, h, hd23, map_zero, zero_add, add_sub_cancel_right]
    obtain ⟨φ2, hφ2⟩ := FLA 2 (B.X 1 × W.X 0) (B.X 2 × W.X 1)
      (fun x => Prod.ext (by rw [Prod.smul_fst]; exact hB 1 x.1)
        (by rw [Prod.smul_snd]; exact hW 0 x.2))
      (((B.d 1 2).hom.comp (AddMonoidHom.fst _ _)).prod
        ((Ψ'.f 1).hom.comp (AddMonoidHom.fst _ _) + (W.d 0 1).hom.comp (AddMonoidHom.snd _ _)))
      (((f.f 2).hom - (g.f 2).hom).prod (H.hom 2 1).hom)
      (by
        intro v
        have pre1 : (B.d 2 3).hom ((f.f 2).hom v - (g.f 2).hom v) = 0 := by
          rw [map_sub, cm f 2 3 v, cm g 2 3 v, hd23, map_zero, map_zero, sub_zero]
        obtain ⟨b, w, h1, h2⟩ := hCES 0 ((f.f 2).hom v - (g.f 2).hom v) ((H.hom 2 1).hom v)
          pre1 (E2 v)
        exact ⟨(b, w), Prod.ext h1 h2⟩)
    let s2 : A.X 2 →+ B.X 1 := (AddMonoidHom.fst _ _).comp φ2
    let t2 : A.X 2 →+ W.X 0 := (AddMonoidHom.snd _ _).comp φ2
    have D12 : ∀ v, (B.d 1 2).hom (s2 v) = (f.f 2).hom v - (g.f 2).hom v :=
      fun v => congrArg Prod.fst (hφ2 v)
    have D22 : ∀ v, (Ψ'.f 1).hom (s2 v) + (W.d 0 1).hom (t2 v) = (H.hom 2 1).hom v :=
      fun v => congrArg Prod.snd (hφ2 v)

    obtain ⟨φ1, hφ1⟩ := FLA 1 (B.X 0) (B.X 1 × W.X 0) (hB 0)
      ((B.d 0 1).hom.prod (Ψ'.f 0).hom)
      (((f.f 1).hom - (g.f 1).hom - s2.comp (A.d 1 2).hom).prod
        ((H.hom 1 0).hom + t2.comp (A.d 1 2).hom))
      (by
        intro v
        have pre1 : (B.d 1 2).hom ((f.f 1).hom v - (g.f 1).hom v - s2 ((A.d 1 2).hom v)) = 0 := by
          rw [map_sub, map_sub, cm f 1 2 v, cm g 1 2 v, D12]
          abel
        have pre2 : (Ψ'.f 1).hom ((f.f 1).hom v - (g.f 1).hom v - s2 ((A.d 1 2).hom v)) =
            (W.d 0 1).hom ((H.hom 1 0).hom v + t2 ((A.d 1 2).hom v)) := by
          have e1 : (Ψ'.f 1).hom ((f.f 1).hom v) = (H.hom 2 1).hom ((A.d 1 2).hom v) +
              (W.d 0 1).hom ((H.hom 1 0).hom v) + (Ψ'.f 1).hom ((g.f 1).hom v) := ES 0 v
          have e2 := D22 ((A.d 1 2).hom v)
          rw [map_sub, map_sub, map_add, e1, ← e2]
          abel
        obtain ⟨b, h1, h2⟩ := hCE0 _ _ pre1 pre2
        exact ⟨b, Prod.ext h1 h2⟩)
    have D11 : ∀ v, (B.d 0 1).hom (φ1 v) = (f.f 1).hom v - (g.f 1).hom v - s2 ((A.d 1 2).hom v) :=
      fun v => congrArg Prod.fst (hφ1 v)
    have D21 : ∀ v, (Ψ'.f 0).hom (φ1 v) = (H.hom 1 0).hom v + t2 ((A.d 1 2).hom v) :=
      fun v => congrArg Prod.snd (hφ1 v)

    have D0 : ∀ v : A.X 0, (f.f 0).hom v = φ1 ((A.d 0 1).hom v) + (g.f 0).hom v := by
      intro v
      have h0 := hINJ0 ((f.f 0).hom v - (g.f 0).hom v - φ1 ((A.d 0 1).hom v))
        (by rw [map_sub, map_sub, cm f 0 1 v, cm g 0 1 v, D11, dd, map_zero]; abel)
        (by rw [map_sub, map_sub, E0, D21, dd, map_zero]; abel)
      rw [sub_eq_zero] at h0
      rw [← h0]
      abel

    let hom : ∀ i j, A.X i ⟶ B.X j := fun i j =>
      match i, j with
      | 1, 0 => AddCommGrpCat.ofHom φ1
      | 2, 1 => AddCommGrpCat.ofHom s2
      | _, _ => 0
    refine ⟨{ hom := hom, zero := ?_, comm := ?_ }⟩
    · intro i j hij
      rcases i with _ | _ | _ | i <;> rcases j with _ | _ | j <;>
        first | rfl | (exfalso; exact hij rfl)
    · intro i
      match i with
      | 0 =>
        rw [show dNext 0 hom = A.d 0 1 ≫ hom 1 0 from Homotopy.dNext_cochainComplex hom 0,
          Homotopy.prevD_zero_cochainComplex]
        show f.f 0 = A.d 0 1 ≫ AddCommGrpCat.ofHom φ1 + 0 + g.f 0
        ext v
        simp only [AddCommGrpCat.hom_add, AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom,
          AddCommGrpCat.hom_zero, AddMonoidHom.add_apply, AddMonoidHom.coe_comp,
          Function.comp_apply, AddMonoidHom.zero_apply, add_zero]
        exact D0 v
      | 1 =>
        rw [show dNext 1 hom = A.d 1 2 ≫ hom 2 1 from Homotopy.dNext_cochainComplex hom 1,
          show prevD 1 hom = hom 1 0 ≫ B.d 0 1 from Homotopy.prevD_succ_cochainComplex hom 0]
        show f.f 1 = A.d 1 2 ≫ AddCommGrpCat.ofHom s2 + AddCommGrpCat.ofHom φ1 ≫ B.d 0 1 + g.f 1
        ext v
        simp only [AddCommGrpCat.hom_add, AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom,
          AddMonoidHom.add_apply, AddMonoidHom.coe_comp, Function.comp_apply]
        rw [D11]
        abel
      | 2 =>
        rw [show dNext 2 hom = A.d 2 3 ≫ hom 3 2 from Homotopy.dNext_cochainComplex hom 2,
          show prevD 2 hom = hom 2 1 ≫ B.d 1 2 from Homotopy.prevD_succ_cochainComplex hom 1]
        show f.f 2 = A.d 2 3 ≫ 0 + AddCommGrpCat.ofHom s2 ≫ B.d 1 2 + g.f 2
        rw [Limits.comp_zero, zero_add]
        ext v
        simp only [AddCommGrpCat.hom_add, AddCommGrpCat.hom_comp, AddCommGrpCat.hom_ofHom,
          AddMonoidHom.add_apply, AddMonoidHom.coe_comp, Function.comp_apply]
        rw [D12]
        abel
      | n + 3 =>
        haveI := hsubA n
        exact Limits.IsZero.eq_of_src (AddCommGrpCat.isZero_of_subsingleton _) _ _
  exact main _ hsub FL f g H

theorem wcU_lnmodel_htpy_equiv (N : ℕ) (Q Q' : wcLnModel (ZMod N))
    (W : CochainComplex AddCommGrpCat.{u+1} ℕ) (hW : ∀ i (x : W.X i), N • x = 0)
    (FW : W ⟶ W) (Ψ : wcLnModelAb.{u+1} Q ⟶ W) (Ψ' : wcLnModelAb.{u+1} Q' ⟶ W)
    (hΨ : QuasiIso Ψ) (hΨ' : QuasiIso Ψ')
    (hF : Nonempty (Homotopy (Ψ ≫ FW) (wcLnModelFrob.{u+1} Q ≫ Ψ)))
    (hF' : Nonempty (Homotopy (Ψ' ≫ FW) (wcLnModelFrob.{u+1} Q' ≫ Ψ'))) :
    ∃ (χ : wcLnModelAb.{u+1} Q ⟶ wcLnModelAb.{u+1} Q')
      (χ' : wcLnModelAb.{u+1} Q' ⟶ wcLnModelAb.{u+1} Q),
      Nonempty (Homotopy (χ ≫ wcLnModelFrob.{u+1} Q') (wcLnModelFrob.{u+1} Q ≫ χ)) ∧
      Nonempty (Homotopy (χ ≫ χ') (𝟙 _)) ∧ Nonempty (Homotopy (χ' ≫ χ) (𝟙 _)) :=
by

  have hT : ∀ (P : wcLnModel (ZMod N)) (i : ℕ) (x : (wcLnModelAb.{u+1} P).X i), N • x = 0 := by
    intro P i x
    change (N • (x : ULift.{u+1} (wcIdemSub (P.ε i)))) = 0
    apply ULift.ext
    apply Subtype.ext
    funext j
    change N • ((x.down : wcIdemSub (P.ε i)) : Fin (P.k i) → ZMod N) j = 0
    rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  have hA := hT Q
  have hA' := hT Q'

  obtain ⟨CE0, CES, INJ0⟩ := wcU_ab_quasiIso_cone_exact _ W Ψ hΨ
  obtain ⟨CE0', CES', INJ0'⟩ := wcU_ab_quasiIso_cone_exact _ W Ψ' hΨ'

  obtain ⟨χ, ⟨H1⟩⟩ := wcU_lnmodel_lift_htpy N Q _ W hA' hW Ψ' CE0' CES' Ψ
  obtain ⟨χ', ⟨H2⟩⟩ := wcU_lnmodel_lift_htpy N Q' _ W hA hW Ψ CE0 CES Ψ'
  obtain ⟨h⟩ := hF
  obtain ⟨h'⟩ := hF'
  refine ⟨χ, χ', ?_, ?_, ?_⟩
  · exact wcU_lnmodel_htpy_cancel N Q _ W hA' hW Ψ' CE0' CES' INJ0' _ _
      ((Homotopy.ofEq (Category.assoc _ _ _)).trans ((h'.symm.compLeft χ).trans
        ((Homotopy.ofEq (Category.assoc _ _ _).symm).trans ((H1.compRight FW).trans
          (h.trans ((H1.symm.compLeft (wcLnModelFrob.{u+1} Q)).trans
            (Homotopy.ofEq (Category.assoc _ _ _).symm)))))))
  · exact wcU_lnmodel_htpy_cancel N Q _ W hA hW Ψ CE0 CES INJ0 _ _
      ((Homotopy.ofEq (Category.assoc _ _ _)).trans ((H2.compLeft χ).trans
        (H1.trans (Homotopy.ofEq (Category.id_comp Ψ).symm))))
  · exact wcU_lnmodel_htpy_cancel N Q' _ W hA' hW Ψ' CE0' CES' INJ0' _ _
      ((Homotopy.ofEq (Category.assoc _ _ _)).trans ((H1.compLeft χ').trans
        (H2.trans (Homotopy.ofEq (Category.id_comp Ψ').symm))))

theorem wcU_lnmodel_trace_invariant (N : ℕ) (Q Q' : wcLnModel (ZMod N))
    (χ : wcLnModelAb.{u+1} Q ⟶ wcLnModelAb.{u+1} Q')
    (χ' : wcLnModelAb.{u+1} Q' ⟶ wcLnModelAb.{u+1} Q)
    (h1 : Nonempty (Homotopy (χ ≫ wcLnModelFrob Q') (wcLnModelFrob Q ≫ χ)))
    (h2 : Nonempty (Homotopy (χ ≫ χ') (𝟙 _))) (h3 : Nonempty (Homotopy (χ' ≫ χ) (𝟙 _)))
    (e : ℕ) (he : 1 ≤ e) : wcLnTr Q e = wcLnTr Q' e :=
by
  classical
  obtain ⟨H1⟩ := h1
  obtain ⟨H2⟩ := h2
  obtain ⟨H3⟩ := h3



  have ext_vec : ∀ {a b : ℕ} (M M' : Matrix (Fin a) (Fin b) (ZMod N)),
      (∀ v, Matrix.vecMul v M = Matrix.vecMul v M') → M = M' := by
    intro a b M M' h
    ext r c
    have := congrFun (h (Pi.single r 1)) c
    simpa [Matrix.single_one_vecMul] using this
  have uniq : ∀ {a b : ℕ} (εa : Matrix (Fin a) (Fin a) (ZMod N))
      (M M' : Matrix (Fin a) (Fin b) (ZMod N)),
      εa * εa = εa → εa * M = M → εa * M' = M' →
      (∀ v : Fin a → ZMod N, Matrix.vecMul v εa = v →
        Matrix.vecMul v M = Matrix.vecMul v M') → M = M' := by
    intro a b εa M M' hε hM hM' h
    apply ext_vec
    intro v
    have hv : Matrix.vecMul (Matrix.vecMul v εa) εa = Matrix.vecMul v εa := by
      rw [Matrix.vecMul_vecMul, hε]
    have h' := h _ hv
    rw [Matrix.vecMul_vecMul, Matrix.vecMul_vecMul, hM, hM'] at h'
    exact h'
  have rep1 : ∀ {a b : ℕ} (εa : Matrix (Fin a) (Fin a) (ZMod N))
      (εb : Matrix (Fin b) (Fin b) (ZMod N)), εa * εa = εa →
      ∀ φ : wcIdemSub εa →+ wcIdemSub εb, ∃ M : Matrix (Fin a) (Fin b) (ZMod N),
        εa * M = M ∧ ∀ w : wcIdemSub εa,
          ((φ w : wcIdemSub εb) : Fin b → ZMod N) = Matrix.vecMul (w : Fin a → ZMod N) M := by
    intro a b εa εb hε φ
    let proj : (Fin a → ZMod N) →+ wcIdemSub εa :=
      AddMonoidHom.mk' (fun v => ⟨Matrix.vecMul v εa, by
          show Matrix.vecMul (Matrix.vecMul v εa) εa = Matrix.vecMul v εa
          rw [Matrix.vecMul_vecMul, hε]⟩)
        (fun v w => Subtype.ext (Matrix.add_vecMul εa v w))
    let g : (Fin a → ZMod N) →+ (Fin b → ZMod N) := (wcIdemSub εb).subtype.comp (φ.comp proj)
    let gL := g.toZModLinearMap N
    have hg : ∀ v, Matrix.vecMul v (LinearMap.toMatrix' gL).transpose = g v := by
      intro v
      rw [Matrix.vecMul_transpose, LinearMap.toMatrix'_mulVec]
      rfl
    have hproj : ∀ w : wcIdemSub εa, proj (w : Fin a → ZMod N) = w := by
      intro w
      apply Subtype.ext
      exact w.2
    refine ⟨(LinearMap.toMatrix' gL).transpose, ?_, ?_⟩
    · apply ext_vec
      intro v
      rw [← Matrix.vecMul_vecMul, hg, hg]
      have hpv : proj (Matrix.vecMul v εa) = proj v := Subtype.ext (by
        show Matrix.vecMul (Matrix.vecMul v εa) εa = Matrix.vecMul v εa
        rw [Matrix.vecMul_vecMul, hε])
      show ((φ (proj (Matrix.vecMul v εa)) : wcIdemSub εb) : Fin b → ZMod N) =
        ((φ (proj v) : wcIdemSub εb) : Fin b → ZMod N)
      rw [hpv]
    · intro w
      rw [hg]
      show ((φ w : wcIdemSub εb) : Fin b → ZMod N) =
        ((φ (proj (w : Fin a → ZMod N)) : wcIdemSub εb) : Fin b → ZMod N)
      rw [hproj]



  have repX : ∀ {P P' : wcLnModel (ZMod N)} {i j : ℕ}
      (φ : (wcLnModelAb.{u+1} P).X i ⟶ (wcLnModelAb.{u+1} P').X j),
      ∃ M : Matrix (Fin (P.k i)) (Fin (P'.k j)) (ZMod N), P.ε i * M = M ∧ wcLnRepr φ M := by
    intro P P' i j φ
    let φ' : wcIdemSub (P.ε i) →+ wcIdemSub (P'.ε j) :=
      AddMonoidHom.mk' (fun w => ULift.down (φ.hom (ULift.up w : (wcLnModelAb.{u+1} P).X i)))
        (fun v w => congrArg ULift.down
          (map_add φ.hom (ULift.up v : (wcLnModelAb.{u+1} P).X i) (ULift.up w)))
    obtain ⟨M, hM1, hM2⟩ := rep1 (P.ε i) (P'.ε j) (P.hε i) φ'
    exact ⟨M, hM1, hM2⟩
  have Rcomp : ∀ {P1 P2 P3 : wcLnModel (ZMod N)} {i j l : ℕ}
      {φ : (wcLnModelAb.{u+1} P1).X i ⟶ (wcLnModelAb.{u+1} P2).X j}
      {ψ : (wcLnModelAb.{u+1} P2).X j ⟶ (wcLnModelAb.{u+1} P3).X l}
      {M : Matrix (Fin (P1.k i)) (Fin (P2.k j)) (ZMod N)}
      {M' : Matrix (Fin (P2.k j)) (Fin (P3.k l)) (ZMod N)},
      wcLnRepr φ M → wcLnRepr ψ M' → wcLnRepr (φ ≫ ψ) (M * M') := by
    intro P1 P2 P3 i j l φ ψ M M' hφ hψ w
    have h2 := hψ (ULift.down (φ.hom (ULift.up w : (wcLnModelAb.{u+1} P1).X i)))
    rw [hφ w, Matrix.vecMul_vecMul] at h2
    exact h2
  have Radd : ∀ {P P' : wcLnModel (ZMod N)} {i j : ℕ}
      {φ ψ : (wcLnModelAb.{u+1} P).X i ⟶ (wcLnModelAb.{u+1} P').X j}
      {M M' : Matrix (Fin (P.k i)) (Fin (P'.k j)) (ZMod N)},
      wcLnRepr φ M → wcLnRepr ψ M' → wcLnRepr (φ + ψ) (M + M') := by
    intro P P' i j φ ψ M M' hφ hψ w
    rw [Matrix.vecMul_add, ← hφ w, ← hψ w]
    rfl
  have Rd : ∀ (P : wcLnModel (ZMod N)) (i : ℕ),
      wcLnRepr ((wcLnModelAb.{u+1} P).d i (i + 1)) (P.δ i) := by
    intro P i w
    have hd : (wcLnModelAb.{u+1} P).d i (i + 1) = AddCommGrpCat.ofHom
        (wcULiftHom (wcVecMulHom (P.ε i) (P.ε (i + 1)) (P.δ i) (P.hδε i))) := by
      unfold wcLnModelAb
      first
        | exact CochainComplex.of_d (V := AddCommGrpCat.{u+1}) (α := ℕ) _ _ i
        | erw [CochainComplex.of_d]
        | simp [CochainComplex.of]
    rw [hd]
    rfl
  have Rf : ∀ (P : wcLnModel (ZMod N)) (i : ℕ),
      wcLnRepr ((wcLnModelFrob.{u+1} P).f i) (P.f i) := by
    intro P i w
    rfl
  have Rid : ∀ (P : wcLnModel (ZMod N)) (i : ℕ),
      wcLnRepr ((𝟙 (wcLnModelAb.{u+1} P) : wcLnModelAb.{u+1} P ⟶ wcLnModelAb.{u+1} P).f i)
        (P.ε i) := by
    intro P i w
    exact (show Matrix.vecMul (w : Fin (P.k i) → ZMod N) (P.ε i) = w from w.2).symm
  have chain : ∀ {P P' : wcLnModel (ZMod N)} (φ : wcLnModelAb.{u+1} P ⟶ wcLnModelAb.{u+1} P'),
      ∃ X : ∀ i, Matrix (Fin (P.k i)) (Fin (P'.k i)) (ZMod N),
        (∀ i, P.ε i * X i = X i) ∧ (∀ i, wcLnRepr (φ.f i) (X i)) ∧
        ∀ i, X i * P'.δ i = P.δ i * X (i + 1) := by
    intro P P' φ
    choose X hXn hX using fun i => repX (φ.f i)
    refine ⟨X, hXn, hX, fun i => ?_⟩
    have hc := φ.comm i (i + 1)
    have r1 : wcLnRepr ((wcLnModelAb.{u+1} P).d i (i + 1) ≫ φ.f (i + 1)) (P.δ i * X (i + 1)) :=
      Rcomp (Rd P i) (hX (i + 1))
    have r2 : wcLnRepr (φ.f i ≫ (wcLnModelAb.{u+1} P').d i (i + 1)) (X i * P'.δ i) :=
      Rcomp (hX i) (Rd P' i)
    rw [hc] at r2
    refine uniq (P.ε i) (X i * P'.δ i) (P.δ i * X (i + 1)) (P.hε i) ?_ ?_ ?_
    · rw [← Matrix.mul_assoc, hXn]
    · rw [← Matrix.mul_assoc, P.hεδ]
    · intro v hv
      exact (r2 ⟨v, hv⟩).symm.trans (r1 ⟨v, hv⟩)
  have htpy : ∀ {P P' : wcLnModel (ZMod N)} (φ ψ : wcLnModelAb.{u+1} P ⟶ wcLnModelAb.{u+1} P')
      (Φ Ψ : ∀ i, Matrix (Fin (P.k i)) (Fin (P'.k i)) (ZMod N)),
      (∀ i, P.ε i * Φ i = Φ i) → (∀ i, P.ε i * Ψ i = Ψ i) →
      (∀ i, wcLnRepr (φ.f i) (Φ i)) → (∀ i, wcLnRepr (ψ.f i) (Ψ i)) → Homotopy φ ψ →
      ∃ H : ∀ i, Matrix (Fin (P.k (i + 1))) (Fin (P'.k i)) (ZMod N),
        Φ 0 = P.δ 0 * H 0 + Ψ 0 ∧
        ∀ i, Φ (i + 1) = P.δ (i + 1) * H (i + 1) + H i * P'.δ i + Ψ (i + 1) := by
    intro P P' φ ψ Φ Ψ hΦn hΨn hΦ hΨ h
    choose H hHn hH using fun i => repX (h.hom (i + 1) i)
    refine ⟨H, ?_, ?_⟩
    · have hc := h.comm 0
      rw [Homotopy.dNext_cochainComplex, Homotopy.prevD_zero_cochainComplex, add_zero] at hc
      have hr : wcLnRepr (φ.f 0) (P.δ 0 * H 0 + Ψ 0) := by
        rw [hc]; exact Radd (Rcomp (Rd P 0) (hH 0)) (hΨ 0)
      refine uniq (P.ε 0) (Φ 0) (P.δ 0 * H 0 + Ψ 0) (P.hε 0) (hΦn 0) ?_ ?_
      · rw [Matrix.mul_add, ← Matrix.mul_assoc, P.hεδ, hΨn]
      · intro v hv
        exact (hΦ 0 ⟨v, hv⟩).symm.trans (hr ⟨v, hv⟩)
    · intro i
      have hc := h.comm (i + 1)
      rw [Homotopy.dNext_cochainComplex, Homotopy.prevD_succ_cochainComplex] at hc
      have hr : wcLnRepr (φ.f (i + 1))
          (P.δ (i + 1) * H (i + 1) + H i * P'.δ i + Ψ (i + 1)) := by
        rw [hc]
        exact Radd (Radd (Rcomp (Rd P (i + 1)) (hH (i + 1))) (Rcomp (hH i) (Rd P' i))) (hΨ (i + 1))
      refine uniq (P.ε (i + 1)) (Φ (i + 1))
        (P.δ (i + 1) * H (i + 1) + H i * P'.δ i + Ψ (i + 1)) (P.hε (i + 1)) (hΦn (i + 1)) ?_ ?_
      · rw [Matrix.mul_add, Matrix.mul_add, ← Matrix.mul_assoc (P.ε (i + 1)) (P.δ (i + 1)),
          P.hεδ, ← Matrix.mul_assoc (P.ε (i + 1)) (H i), hHn i, hΨn]
      · intro v hv
        exact (hΦ (i + 1) ⟨v, hv⟩).symm.trans (hr ⟨v, hv⟩)



  obtain ⟨X, hXn, hX, -⟩ := chain χ
  obtain ⟨Y, hYn, hYr, hY⟩ := chain χ'
  obtain ⟨A, hA0, hA⟩ := htpy (χ ≫ χ') (𝟙 _) (fun i => X i * Y i) Q.ε
    (fun i => by show Q.ε i * (X i * Y i) = X i * Y i; rw [← Matrix.mul_assoc, hXn])
    Q.hε (fun i => Rcomp (hX i) (hYr i)) (fun i => Rid Q i) H2
  obtain ⟨B, hB0, hB⟩ := htpy (χ' ≫ χ) (𝟙 _) (fun i => Y i * X i) Q'.ε
    (fun i => by show Q'.ε i * (Y i * X i) = Y i * X i; rw [← Matrix.mul_assoc, hYn])
    Q'.hε (fun i => Rcomp (hYr i) (hX i)) (fun i => Rid Q' i) H3
  obtain ⟨C, hC0, hC⟩ := htpy (χ ≫ wcLnModelFrob Q') (wcLnModelFrob Q ≫ χ)
    (fun i => X i * Q'.f i) (fun i => Q.f i * X i)
    (fun i => by show Q.ε i * (X i * Q'.f i) = X i * Q'.f i; rw [← Matrix.mul_assoc, hXn])
    (fun i => by show Q.ε i * (Q.f i * X i) = Q.f i * X i; rw [← Matrix.mul_assoc, Q.hεf])
    (fun i => Rcomp (hX i) (Rf Q' i)) (fun i => Rcomp (Rf Q i) (hX i)) H1
  have hC0' : X 0 * Q'.f 0 = Q.δ 0 * C 0 + Q.f 0 * X 0 := hC0
  have hC' : ∀ i, X (i + 1) * Q'.f (i + 1) =
      Q.δ (i + 1) * C (i + 1) + C i * Q'.δ i + Q.f (i + 1) * X (i + 1) := hC



  have cm : ∀ (P : wcLnModel (ZMod N)) (i n : ℕ), P.f i ^ n * P.δ i = P.δ i * P.f (i + 1) ^ n := by
    intro P i n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, Matrix.mul_assoc, ← P.hδf, ← Matrix.mul_assoc, ih, Matrix.mul_assoc, ← pow_succ]
  have pw : ∀ n : ℕ, ∃ D : ∀ i, Matrix (Fin (Q.k (i + 1))) (Fin (Q'.k i)) (ZMod N),
      X 0 * Q'.f 0 ^ n = Q.δ 0 * D 0 + Q.f 0 ^ n * X 0 ∧
      ∀ i, X (i + 1) * Q'.f (i + 1) ^ n =
        Q.δ (i + 1) * D (i + 1) + D i * Q'.δ i + Q.f (i + 1) ^ n * X (i + 1) := by
    intro n
    induction n with
    | zero => exact ⟨0, by simp, fun i => by simp⟩
    | succ n ih =>
      obtain ⟨D, hD0, hD⟩ := ih
      refine ⟨fun i => D i * Q'.f i + Q.f (i + 1) ^ n * C i, ?_, fun i => ?_⟩
      · show X 0 * Q'.f 0 ^ (n + 1) =
          Q.δ 0 * (D 0 * Q'.f 0 + Q.f (0 + 1) ^ n * C 0) + Q.f 0 ^ (n + 1) * X 0
        have e1 : Q.f 0 ^ n * (Q.δ 0 * C 0) = Q.δ 0 * (Q.f (0 + 1) ^ n * C 0) := by
          rw [← Matrix.mul_assoc, cm, Matrix.mul_assoc]
        have e2 : Q.f 0 ^ n * (Q.f 0 * X 0) = Q.f 0 ^ (n + 1) * X 0 := by
          rw [← Matrix.mul_assoc, ← pow_succ]
        calc X 0 * Q'.f 0 ^ (n + 1) = (X 0 * Q'.f 0 ^ n) * Q'.f 0 := by
              rw [pow_succ, Matrix.mul_assoc]
          _ = (Q.δ 0 * D 0 + Q.f 0 ^ n * X 0) * Q'.f 0 := by rw [hD0]
          _ = Q.δ 0 * (D 0 * Q'.f 0) + Q.f 0 ^ n * (X 0 * Q'.f 0) := by
              rw [Matrix.add_mul, Matrix.mul_assoc, Matrix.mul_assoc]
          _ = Q.δ 0 * (D 0 * Q'.f 0) + (Q.f 0 ^ n * (Q.δ 0 * C 0) + Q.f 0 ^ n * (Q.f 0 * X 0)) := by
              rw [hC0', Matrix.mul_add]
          _ = Q.δ 0 * (D 0 * Q'.f 0 + Q.f (0 + 1) ^ n * C 0) + Q.f 0 ^ (n + 1) * X 0 := by
              rw [e1, e2, Matrix.mul_add]; abel
      · show X (i + 1) * Q'.f (i + 1) ^ (n + 1) =
          Q.δ (i + 1) * (D (i + 1) * Q'.f (i + 1) + Q.f (i + 1 + 1) ^ n * C (i + 1)) +
            (D i * Q'.f i + Q.f (i + 1) ^ n * C i) * Q'.δ i + Q.f (i + 1) ^ (n + 1) * X (i + 1)
        have e1 : Q.f (i + 1) ^ n * (Q.δ (i + 1) * C (i + 1)) =
            Q.δ (i + 1) * (Q.f (i + 1 + 1) ^ n * C (i + 1)) := by
          rw [← Matrix.mul_assoc, cm, Matrix.mul_assoc]
        have e2 : Q.f (i + 1) ^ n * (Q.f (i + 1) * X (i + 1)) = Q.f (i + 1) ^ (n + 1) * X (i + 1) := by
          rw [← Matrix.mul_assoc, ← pow_succ]
        have e3 : Q.f (i + 1) ^ n * (C i * Q'.δ i) = (Q.f (i + 1) ^ n * C i) * Q'.δ i := by
          rw [Matrix.mul_assoc]
        have e4 : D i * (Q'.f i * Q'.δ i) = (D i * Q'.f i) * Q'.δ i := by
          rw [Matrix.mul_assoc]
        calc X (i + 1) * Q'.f (i + 1) ^ (n + 1) = (X (i + 1) * Q'.f (i + 1) ^ n) * Q'.f (i + 1) := by
              rw [pow_succ, Matrix.mul_assoc]
          _ = (Q.δ (i + 1) * D (i + 1) + D i * Q'.δ i + Q.f (i + 1) ^ n * X (i + 1)) * Q'.f (i + 1) := by
              rw [hD i]
          _ = Q.δ (i + 1) * (D (i + 1) * Q'.f (i + 1)) + D i * (Q'.δ i * Q'.f (i + 1)) +
                Q.f (i + 1) ^ n * (X (i + 1) * Q'.f (i + 1)) := by
              rw [Matrix.add_mul, Matrix.add_mul, Matrix.mul_assoc, Matrix.mul_assoc, Matrix.mul_assoc]
          _ = Q.δ (i + 1) * (D (i + 1) * Q'.f (i + 1)) + D i * (Q'.f i * Q'.δ i) +
                (Q.f (i + 1) ^ n * (Q.δ (i + 1) * C (i + 1)) + Q.f (i + 1) ^ n * (C i * Q'.δ i) +
                  Q.f (i + 1) ^ n * (Q.f (i + 1) * X (i + 1))) := by
              rw [Q'.hδf i, hC' i, Matrix.mul_add, Matrix.mul_add]
          _ = _ := by
              rw [e1, e2, e3, e4, Matrix.mul_add, Matrix.add_mul]; abel
  obtain ⟨D, hD0, hD⟩ := pw e



  have absQ : ∀ (P : wcLnModel (ZMod N)) (i : ℕ), P.ε i * P.f i ^ e = P.f i ^ e := by
    intro P i
    obtain ⟨m, rfl⟩ : ∃ m, e = m + 1 := ⟨e - 1, by omega⟩
    rw [pow_succ', ← Matrix.mul_assoc, P.hεf]
  have zmul : ∀ (P : wcLnModel (ZMod N)) {m p : ℕ} (U : Matrix (Fin m) (Fin (P.k (2 + 1))) (ZMod N))
      (V : Matrix (Fin (P.k (2 + 1))) (Fin p) (ZMod N)), U * V = 0 := by
    intro P m p U V
    have h0 : P.k (2 + 1) = 0 := P.hk 3 le_rfl
    haveI : IsEmpty (Fin (P.k (2 + 1))) := by rw [h0]; infer_instance
    ext a b
    simp [Matrix.mul_apply]
  have shift : ∀ (P : wcLnModel (ZMod N)) (i : ℕ) (Bm : Matrix (Fin (P.k (i + 1))) (Fin (P.k i)) (ZMod N)),
      (Bm * P.δ i * P.f (i + 1) ^ e).trace = (P.δ i * Bm * P.f i ^ e).trace := by
    intro P i Bm
    rw [Matrix.mul_assoc Bm, Matrix.trace_mul_comm Bm, ← cm P i e, Matrix.mul_assoc (P.f i ^ e),
      Matrix.trace_mul_comm (P.f i ^ e)]
  have hTr : ∀ P : wcLnModel (ZMod N), wcLnTr P e =
      (P.f 0 ^ e).trace - (P.f 1 ^ e).trace + (P.f 2 ^ e).trace := by
    intro P
    simp only [wcLnTr, Finset.sum_range_succ, Finset.sum_range_zero]
    ring

  have hA0' : X 0 * Y 0 = Q.δ 0 * A 0 + Q.ε 0 := hA0
  have hA1' : X 1 * Y 1 = Q.δ 1 * A 1 + A 0 * Q.δ 0 + Q.ε 1 := hA 0
  have hA2' : X 2 * Y 2 = Q.δ 2 * A 2 + A 1 * Q.δ 1 + Q.ε 2 := hA 1
  have F1 : (X 0 * Y 0 * Q.f 0 ^ e).trace =
      (Q.δ 0 * A 0 * Q.f 0 ^ e).trace + (Q.f 0 ^ e).trace := by
    rw [hA0', Matrix.add_mul, Matrix.trace_add, absQ]
  have F2 : (X 1 * Y 1 * Q.f 1 ^ e).trace = (Q.δ 1 * A 1 * Q.f 1 ^ e).trace +
      (A 0 * Q.δ 0 * Q.f 1 ^ e).trace + (Q.f 1 ^ e).trace := by
    rw [hA1', Matrix.add_mul, Matrix.add_mul, Matrix.trace_add, Matrix.trace_add, absQ]
  have F3 : (X 2 * Y 2 * Q.f 2 ^ e).trace = (Q.δ 2 * A 2 * Q.f 2 ^ e).trace +
      (A 1 * Q.δ 1 * Q.f 2 ^ e).trace + (Q.f 2 ^ e).trace := by
    rw [hA2', Matrix.add_mul, Matrix.add_mul, Matrix.trace_add, Matrix.trace_add, absQ]
  have F4 : (A 0 * Q.δ 0 * Q.f 1 ^ e).trace = (Q.δ 0 * A 0 * Q.f 0 ^ e).trace := shift Q 0 (A 0)
  have F5 : (A 1 * Q.δ 1 * Q.f 2 ^ e).trace = (Q.δ 1 * A 1 * Q.f 1 ^ e).trace := shift Q 1 (A 1)
  have F6 : (Q.δ 2 * A 2 * Q.f 2 ^ e).trace = 0 := by
    rw [zmul Q (Q.δ 2) (A 2)]; simp

  have hB0' : Y 0 * X 0 = Q'.δ 0 * B 0 + Q'.ε 0 := hB0
  have hB1' : Y 1 * X 1 = Q'.δ 1 * B 1 + B 0 * Q'.δ 0 + Q'.ε 1 := hB 0
  have hB2' : Y 2 * X 2 = Q'.δ 2 * B 2 + B 1 * Q'.δ 1 + Q'.ε 2 := hB 1
  have E1 : (Y 0 * X 0 * Q'.f 0 ^ e).trace =
      (Q'.δ 0 * B 0 * Q'.f 0 ^ e).trace + (Q'.f 0 ^ e).trace := by
    rw [hB0', Matrix.add_mul, Matrix.trace_add, absQ]
  have E2 : (Y 1 * X 1 * Q'.f 1 ^ e).trace = (Q'.δ 1 * B 1 * Q'.f 1 ^ e).trace +
      (B 0 * Q'.δ 0 * Q'.f 1 ^ e).trace + (Q'.f 1 ^ e).trace := by
    rw [hB1', Matrix.add_mul, Matrix.add_mul, Matrix.trace_add, Matrix.trace_add, absQ]
  have E3 : (Y 2 * X 2 * Q'.f 2 ^ e).trace = (Q'.δ 2 * B 2 * Q'.f 2 ^ e).trace +
      (B 1 * Q'.δ 1 * Q'.f 2 ^ e).trace + (Q'.f 2 ^ e).trace := by
    rw [hB2', Matrix.add_mul, Matrix.add_mul, Matrix.trace_add, Matrix.trace_add, absQ]
  have E4 : (B 0 * Q'.δ 0 * Q'.f 1 ^ e).trace = (Q'.δ 0 * B 0 * Q'.f 0 ^ e).trace := shift Q' 0 (B 0)
  have E5 : (B 1 * Q'.δ 1 * Q'.f 2 ^ e).trace = (Q'.δ 1 * B 1 * Q'.f 1 ^ e).trace := shift Q' 1 (B 1)
  have E6 : (Q'.δ 2 * B 2 * Q'.f 2 ^ e).trace = 0 := by
    rw [zmul Q' (Q'.δ 2) (B 2)]; simp

  have hD0' : X 0 * Q'.f 0 ^ e = Q.δ 0 * D 0 + Q.f 0 ^ e * X 0 := hD0
  have hD1' : X 1 * Q'.f 1 ^ e = Q.δ 1 * D 1 + D 0 * Q'.δ 0 + Q.f 1 ^ e * X 1 := hD 0
  have hD2' : X 2 * Q'.f 2 ^ e = Q.δ 2 * D 2 + D 1 * Q'.δ 1 + Q.f 2 ^ e * X 2 := hD 1
  have hY0' : Y 0 * Q.δ 0 = Q'.δ 0 * Y 1 := hY 0
  have hY1' : Y 1 * Q.δ 1 = Q'.δ 1 * Y 2 := hY 1
  have G0 : (Y 0 * X 0 * Q'.f 0 ^ e).trace = (Q.δ 0 * D 0 * Y 0).trace +
      (X 0 * Y 0 * Q.f 0 ^ e).trace := by
    rw [Matrix.mul_assoc (Y 0), Matrix.trace_mul_comm (Y 0), hD0', Matrix.add_mul, Matrix.trace_add,
      Matrix.mul_assoc (Q.f 0 ^ e), Matrix.trace_mul_comm (Q.f 0 ^ e)]
  have G1 : (Y 1 * X 1 * Q'.f 1 ^ e).trace = (Q.δ 1 * D 1 * Y 1).trace +
      (D 0 * Q'.δ 0 * Y 1).trace + (X 1 * Y 1 * Q.f 1 ^ e).trace := by
    rw [Matrix.mul_assoc (Y 1), Matrix.trace_mul_comm (Y 1), hD1', Matrix.add_mul, Matrix.add_mul,
      Matrix.trace_add, Matrix.trace_add,
      Matrix.mul_assoc (Q.f 1 ^ e), Matrix.trace_mul_comm (Q.f 1 ^ e)]
  have G2 : (Y 2 * X 2 * Q'.f 2 ^ e).trace = (Q.δ 2 * D 2 * Y 2).trace +
      (D 1 * Q'.δ 1 * Y 2).trace + (X 2 * Y 2 * Q.f 2 ^ e).trace := by
    rw [Matrix.mul_assoc (Y 2), Matrix.trace_mul_comm (Y 2), hD2', Matrix.add_mul, Matrix.add_mul,
      Matrix.trace_add, Matrix.trace_add,
      Matrix.mul_assoc (Q.f 2 ^ e), Matrix.trace_mul_comm (Q.f 2 ^ e)]
  have K0 : (D 0 * Q'.δ 0 * Y 1).trace = (Q.δ 0 * D 0 * Y 0).trace := by
    rw [Matrix.mul_assoc (D 0), ← hY0', ← Matrix.mul_assoc (D 0), Matrix.trace_mul_comm (D 0 * Y 0),
      Matrix.mul_assoc (Q.δ 0)]
  have K1 : (D 1 * Q'.δ 1 * Y 2).trace = (Q.δ 1 * D 1 * Y 1).trace := by
    rw [Matrix.mul_assoc (D 1), ← hY1', ← Matrix.mul_assoc (D 1), Matrix.trace_mul_comm (D 1 * Y 1),
      Matrix.mul_assoc (Q.δ 1)]
  have Z2 : (Q.δ 2 * D 2 * Y 2).trace = 0 := by
    rw [zmul Q (Q.δ 2) (D 2)]; simp
  rw [hTr Q, hTr Q']
  linear_combination (-F1 + F2 - F3 + F4 - F5 - F6) - (-E1 + E2 - E3 + E4 - E5 - E6) -
    (G0 - G1 + G2 - K0 + K1 + Z2)

theorem wcU_strict_linear_model_exists (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ] [Fintype Γ]
    (α : Γ →* Aut V) (hG : wcGalCover q' Γ α)
    (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι) :
    ∃ (lamF : MonoidAlgebra ℤ_[ℓ] Γ → (wcCoverSheaf (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶ wcCoverSheaf (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
      (_ : wcRingAct lamF)
      (_ : ∀ (g : Γ) (a : ℤ_[ℓ]), lamF (MonoidAlgebra.single g a) =
        wcCoverScal (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ a ≫
          wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
            (α g⁻¹).hom (hα g⁻¹))
      (I : InjectiveResolution (wcCoverSheaf (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ))
      (lamI : MonoidAlgebra ℤ_[ℓ] Γ → (I.cocomplex ⟶ I.cocomplex))
      (_ : wcRingResSpec lamF I lamI)
      (P : wcGModel ℓ Γ) (φ : wcGModelAb P ⟶ wcCxJ K hP I.cocomplex),
      QuasiIso φ ∧
      (∀ x : MonoidAlgebra ℤ_[ℓ] Γ, wcGModelSmul P x ≫ φ = φ ≫ wcCxJMap K hP (lamI x)) ∧
      (∃ H : Homotopy (φ ≫ wcCxJFrob K hP I.cocomplex) (wcGModelFrob P ≫ φ),
        ∀ (x : MonoidAlgebra ℤ_[ℓ] Γ) (i j : ℕ),
          (wcGModelSmul P x).f i ≫ H.hom i j = H.hom i j ≫ (wcCxJMap K hP (lamI x)).f j) ∧
      wcIsModel K hP (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (q' ≫ Uo.ι)
        Γ α hα P :=
by
  classical
  suffices s7 : ∀ (D : CochainComplex AddCommGrpCat.{u+1} ℕ)
      (lamD : MonoidAlgebra ℤ_[ℓ] Γ → (D ⟶ D))
      (hD : wcRingAct lamD) (Fr : D ⟶ D) (hFr : ∀ r, lamD r ≫ Fr = Fr ≫ lamD r)
      (T : wcThreeTermModel D lamD) (hT : Module.Projective (MonoidAlgebra ℤ_[ℓ] Γ) T.M),
      ∃ (P : wcGModel ℓ Γ) (φ : wcGModelAb P ⟶ D), QuasiIso φ ∧
        (∀ x : MonoidAlgebra ℤ_[ℓ] Γ, wcGModelSmul P x ≫ φ = φ ≫ lamD x) ∧
        ∃ H : Homotopy (φ ≫ Fr) (wcGModelFrob P ≫ φ),
          ∀ (x : MonoidAlgebra ℤ_[ℓ] Γ) (i j : ℕ),
            (wcGModelSmul P x).f i ≫ H.hom i j = H.hom i j ≫ (lamD x).f j by
    haveI : Finite Γ := inferInstance
    set E := (preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
      (wcGeomPoint K (wcP1Over K) hP)))).mapHomologicalComplex (ComplexShape.up ℕ) with hEdef
    set 𝔉 := NatTrans.mapHomologicalComplex (preadditiveCoyoneda.map
      (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP)).op)
      (ComplexShape.up ℕ) with h𝔉def

    obtain ⟨lamF, hLact, hLsing, hL1⟩ := wc_cover_sheaf_ring_action (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ Γ α hα

    have hR : ∀ (n : ℕ) (r : MonoidAlgebra ℤ_[ℓ] Γ), 0 < n →
        (n : MonoidAlgebra ℤ_[ℓ] Γ) * r = 0 → r = 0 := by
      intro n r hn h
      rw [← nsmul_eq_mul] at h
      exact (smul_eq_zero.mp h).resolve_left hn.ne'
    obtain ⟨I, lamI, hI⟩ := wc_ring_injective_resolution (wcP1Over K).left
      (MonoidAlgebra ℤ_[ℓ] Γ) hR _ lamF hLact
    have hI' := hI
    obtain ⟨hIact, hI0, -⟩ := hI'
    obtain ⟨hIone, hIadd, hImul⟩ := hIact

    have hLD : wcRingAct (fun r => E.map (lamI r)) := by
      refine ⟨?_, ?_, ?_⟩
      · show E.map (lamI 1) = 𝟙 _
        rw [hIone, CategoryTheory.Functor.map_id]
      · intro a b
        show E.map (lamI (a + b)) = E.map (lamI a) + E.map (lamI b)
        rw [hIadd, Functor.map_add]
      · intro a b
        show E.map (lamI (a * b)) = E.map (lamI b) ≫ E.map (lamI a)
        rw [hImul, Functor.map_comp]
    have hFr : ∀ r, (fun r => E.map (lamI r)) r ≫ 𝔉.app I.cocomplex =
        𝔉.app I.cocomplex ≫ (fun r => E.map (lamI r)) r := fun r => 𝔉.naturality (lamI r)

    have hfv := wc_cover_coh_fg_van K hP ℓ hℓ m S hS Uo hUo q' Γ α hG hα lamF hLact hLsing I
      lamI hI
    obtain ⟨T⟩ := wc_three_term_model_exists ℓ Γ (E.obj I.cocomplex) (fun r => E.map (lamI r))
      hLD hfv
    have hproj := wc_cover_model_head_projective K hP ℓ hℓ m S hS Uo hUo q' Γ α hG hα lamF
      hLact hLsing I lamI hI T

    obtain ⟨P, φ, hq, hlin, H, hHlin⟩ := s7 (E.obj I.cocomplex) (fun r => E.map (lamI r)) hLD
      (𝔉.app I.cocomplex) hFr T hproj

    have hcongr : ∀ (a a' : V ⟶ V) (_ : a = a') (ha : a ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
        (ha' : a' ≫ q' ≫ Uo.ι = q' ≫ Uo.ι),
        wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ a ha =
          wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ a'
            ha' := by
      rintro a _ rfl _ _
      rfl
    have hLinv : ∀ γ : Γ, lamF (MonoidAlgebra.single γ⁻¹ 1) =
        wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
          (α γ).hom (hα γ) := by
      intro γ
      rw [hL1 γ⁻¹]
      exact hcongr _ _ (by rw [inv_inv]) _ _
    let I₀ := injectiveResolution (wcCoverSheaf (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)
    let Θ : E.obj I.cocomplex ⟶ wcCx K hP (wcCoverSheaf (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ) :=
      E.map (InjectiveResolution.desc (𝟙 _) I₀ I)
    have hΘq : QuasiIso Θ := by
      have h := HomotopyEquiv.quasiIso_hom
        ((preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
          (wcGeomPoint K (wcP1Over K) hP)))).mapHomotopyEquiv (I.homotopyEquiv I₀))
      rw [Functor.mapHomotopyEquiv_hom] at h
      exact h
    have hΘF : Θ ≫ wcCxFrob K hP (wcCoverSheaf (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ) = 𝔉.app I.cocomplex ≫ Θ :=
      NatTrans.mapHomologicalComplex_naturality _ _
    have hΘA : ∀ γ : Γ, Homotopy (Θ ≫ wcCxMap K hP (wcCoverAct (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (α γ).hom (hα γ)))
        (E.map (lamI (MonoidAlgebra.single γ⁻¹ 1)) ≫ Θ) := by
      intro γ
      have h1 : I.ι ≫ (InjectiveResolution.desc (𝟙 _) I₀ I ≫
          InjectiveResolution.desc (wcCoverAct (q' ≫ Uo.ι)
            (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (α γ).hom (hα γ)) I₀ I₀) =
          (CochainComplex.single₀ _).map (wcCoverAct (q' ≫ Uo.ι)
            (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (α γ).hom (hα γ)) ≫
            I₀.ι := by
        rw [← Category.assoc, InjectiveResolution.desc_commutes, Category.assoc,
          InjectiveResolution.desc_commutes, ← Category.assoc, ← Functor.map_comp,
          Category.id_comp]
      have h2 : I.ι ≫ (lamI (MonoidAlgebra.single γ⁻¹ 1) ≫ InjectiveResolution.desc (𝟙 _) I₀ I) =
          (CochainComplex.single₀ _).map (wcCoverAct (q' ≫ Uo.ι)
            (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (α γ).hom (hα γ)) ≫
            I₀.ι := by
        apply HomologicalComplex.from_single_hom_ext
        simp only [HomologicalComplex.comp_f]
        have h3 : lamF (MonoidAlgebra.single γ⁻¹ 1) ≫ I.ι.f 0 ≫
            (InjectiveResolution.desc (𝟙 _) I₀ I).f 0 =
            wcCoverAct (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ
              (α γ).hom (hα γ) ≫ I₀.ι.f 0 := by
          have h4 := InjectiveResolution.desc_commutes_zero (𝟙 (wcCoverSheaf (q' ≫ Uo.ι)
            (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ)) I₀ I
          have h5 : (𝟙 _ ≫ I₀.ι.f 0 : wcCoverSheaf (q' ≫ Uo.ι)
              (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ ⟶ I₀.cocomplex.X 0) =
              I₀.ι.f 0 := Category.id_comp _
          refine (congrArg (fun t => lamF (MonoidAlgebra.single γ⁻¹ 1) ≫ t) (h4.trans h5)).trans ?_
          exact congrArg (fun t => t ≫ I₀.ι.f 0) (hLinv γ)
        rw [← Category.assoc, hI0 (MonoidAlgebra.single γ⁻¹ 1)]
        refine ((Category.assoc _ _ _).trans h3).trans ?_
        first
          | rfl
          | (erw [CochainComplex.single₀_map_f_zero]; rfl)
          | simp
      have hh := InjectiveResolution.descHomotopy (wcCoverAct (q' ≫ Uo.ι)
        (Set.range (fun i => S i (IsLocalRing.closedPoint K))) ℓ (α γ).hom (hα γ)) _ _ h1 h2
      have hE := (preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf (wcP1Over K).left
          (wcGeomPoint K (wcP1Over K) hP)))).mapHomotopy hh
      refine (Homotopy.ofEq ?_).trans (hE.trans (Homotopy.ofEq ?_))
      · exact (Functor.map_comp _ _ _).symm
      · exact Functor.map_comp _ _ _

    refine ⟨lamF, hLact, hLsing, I, lamI, hI, P, φ, hq, hlin, ⟨H, hHlin⟩, ?_⟩
    refine ⟨φ ≫ Θ, quasiIso_comp φ Θ, ⟨?_⟩, fun γ => ⟨?_⟩⟩
    · refine (Homotopy.ofEq ?_).trans ((H.compRight Θ).trans (Homotopy.ofEq ?_))
      · rw [Category.assoc, hΘF, ← Category.assoc]
      · rw [Category.assoc]
    · refine (Homotopy.ofEq (Category.assoc _ _ _)).trans
        (((hΘA γ).compLeft φ).trans (Homotopy.ofEq ?_))
      have hA : wcGModelAct P γ ≫ φ = φ ≫ E.map (lamI (MonoidAlgebra.single γ⁻¹ 1)) := hlin _
      rw [← Category.assoc, ← hA, Category.assoc]

  intro D lamD hD Fr hFr T hT
  have s1 : ∀ {K L : CochainComplex AddCommGrpCat.{u+1} ℕ} (φ : K ⟶ L),
      (∀ (n : ℕ) (x : K.X n), (K.d n (n + 1)).hom x = 0 → ∀ y : L.X (n - 1),
        (φ.f n).hom x = (L.d (n - 1) n).hom y → ∃ x' : K.X (n - 1), (K.d (n - 1) n).hom x' = x) →
      (∀ (n : ℕ) (y : L.X n), (L.d n (n + 1)).hom y = 0 → ∃ x : K.X n,
        (K.d n (n + 1)).hom x = 0 ∧ ∃ w : L.X (n - 1), (L.d (n - 1) n).hom w = (φ.f n).hom x - y) →
      QuasiIso φ := by
    intro K L φ hinj hsurj
    rw [quasiIso_iff]
    intro n
    have hp : (ComplexShape.up ℕ).prev n = n - 1 := by
      rcases n with _ | m
      · exact CochainComplex.prev_nat_zero
      · exact CochainComplex.prev_nat_succ m
    have hn : (ComplexShape.up ℕ).next n = n + 1 := ComplexShape.next_eq' _ rfl
    rw [quasiIsoAt_iff' φ (n - 1) n (n + 1) hp hn, ShortComplex.quasiIso_iff]
    have hmono : Mono (ShortComplex.homologyMap
        ((HomologicalComplex.shortComplexFunctor' AddCommGrpCat (ComplexShape.up ℕ)
          (n - 1) n (n + 1)).map φ)) := by
      rw [ShortComplex.mono_homologyMap_iff_up_to_refinements]
      intro A x₂ hx₂ y₁ hxy
      have hx : ∀ a, (K.d n (n + 1)).hom (x₂ a) = 0 := fun a => by
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f a) hx₂
      have hy : ∀ a, (φ.f n).hom (x₂ a) = (L.d (n - 1) n).hom (y₁ a) := fun a => by
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f a) hxy
      choose g hg using fun a => hinj n (x₂ a) (hx a) (y₁ a) (hy a)
      refine ⟨AddCommGrpCat.of (FreeAbelianGroup A),
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift id), ?_,
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift g), ?_⟩
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro a
        exact ⟨FreeAbelianGroup.of a, by simp [FreeAbelianGroup.lift_apply_of]⟩
      · ext z
        change x₂.hom (FreeAbelianGroup.lift id (FreeAbelianGroup.of z)) =
          (K.d (n - 1) n).hom (FreeAbelianGroup.lift g (FreeAbelianGroup.of z))
        rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
        exact (hg z).symm
    have hepi : Epi (ShortComplex.homologyMap
        ((HomologicalComplex.shortComplexFunctor' AddCommGrpCat (ComplexShape.up ℕ)
          (n - 1) n (n + 1)).map φ)) := by
      rw [ShortComplex.epi_homologyMap_iff_up_to_refinements]
      intro A y₂ hy₂
      have hy : ∀ a, (L.d n (n + 1)).hom (y₂ a) = 0 := fun a => by
        exact congrArg (fun f => AddCommGrpCat.Hom.hom f a) hy₂
      choose x hx w hw using fun a => hsurj n (y₂ a) (hy a)
      refine ⟨AddCommGrpCat.of (FreeAbelianGroup A),
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift id), ?_,
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift x), ?_,
        AddCommGrpCat.ofHom (FreeAbelianGroup.lift (fun a => -w a)), ?_⟩
      · rw [AddCommGrpCat.epi_iff_surjective]
        intro a
        exact ⟨FreeAbelianGroup.of a, by simp [FreeAbelianGroup.lift_apply_of]⟩
      · ext z
        change (K.d n (n + 1)).hom (FreeAbelianGroup.lift x (FreeAbelianGroup.of z)) = 0
        rw [FreeAbelianGroup.lift_apply_of]
        exact hx z
      · ext z
        have e := hw z
        change y₂.hom (FreeAbelianGroup.lift id (FreeAbelianGroup.of z)) =
          (φ.f n).hom (FreeAbelianGroup.lift x (FreeAbelianGroup.of z)) +
          (L.d (n - 1) n).hom (FreeAbelianGroup.lift (fun a => -w a) (FreeAbelianGroup.of z))
        rw [FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of,
          FreeAbelianGroup.lift_apply_of, map_neg]
        change _ = _ + -((L.d (n - 1) n).hom (w z))
        rw [e]
        have key : ∀ (G : Type (u+1)) [AddCommGroup G] (a b : G), b = a + -(a - b) :=
          fun G _ a b => by abel
        exact key _ _ _
    exact isIso_of_mono_of_epi _

  have lmul : ∀ (m : ℕ) (a b : (MonoidAlgebra ℤ_[ℓ] Γ)) (x : D.X m),
      ((lamD (a * b)).f m).hom x = ((lamD a).f m).hom (((lamD b).f m).hom x) := by
    intro m a b x
    rw [hD.2.2 a b, HomologicalComplex.comp_f]
    rfl
  have ladd : ∀ (m : ℕ) (a b : (MonoidAlgebra ℤ_[ℓ] Γ)) (x : D.X m),
      ((lamD (a + b)).f m).hom x = ((lamD a).f m).hom x + ((lamD b).f m).hom x := by
    intro m a b x
    rw [hD.2.1 a b, HomologicalComplex.add_f_apply]
    rfl
  have l0 : ∀ (m : ℕ) (x : D.X m), ((lamD 0).f m).hom x = 0 := by
    intro m x
    have h := ladd m 0 0 x
    rw [add_zero] at h
    exact left_eq_add.mp h |>.symm ▸ rfl
  have ld : ∀ (m m' : ℕ) (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (x : D.X m),
      (D.d m m').hom (((lamD r).f m).hom x) = ((lamD r).f m').hom ((D.d m m').hom x) := by
    intro m m' r x
    have h := congrArg (fun f => AddCommGrpCat.Hom.hom f x) ((lamD r).comm m m')
    exact h
  have Frl : ∀ (m : ℕ) (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (x : D.X m),
      (Fr.f m).hom (((lamD r).f m).hom x) = ((lamD r).f m).hom ((Fr.f m).hom x) := by
    intro m r x
    have h := congrArg (fun f => AddCommGrpCat.Hom.hom (HomologicalComplex.Hom.f f m) x) (hFr r)
    exact h
  have Frd : ∀ (m m' : ℕ) (x : D.X m),
      (D.d m m').hom ((Fr.f m).hom x) = (Fr.f m').hom ((D.d m m').hom x) := by
    intro m m' x
    have h := congrArg (fun f => AddCommGrpCat.Hom.hom f x) (Fr.comm m m')
    exact h
  have pdec : ∀ {n : ℕ} (p : Fin n → (MonoidAlgebra ℤ_[ℓ] Γ)),
      p = ∑ j, p j • Pi.single j (1 : (MonoidAlgebra ℤ_[ℓ] Γ)) := by
    intro n p
    conv_lhs => rw [← Finset.univ_sum_single p]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [← Pi.single_smul', smul_eq_mul, mul_one]
  have dec : ∀ {n : ℕ} (m : ℕ) (α : (Fin n → (MonoidAlgebra ℤ_[ℓ] Γ)) →+ D.X m),
      (∀ (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (p : Fin n → (MonoidAlgebra ℤ_[ℓ] Γ)),
        α (r • p) = ((lamD r).f m).hom (α p)) →
      ∀ p, α p = ∑ j, ((lamD (p j)).f m).hom (α (Pi.single j 1)) := by
    intro n m α hα p
    conv_lhs => rw [pdec p]
    rw [map_sum]
    exact Finset.sum_congr rfl (fun j _ => hα _ _)
  have mkH : ∀ {n : ℕ} (m : ℕ) (w : Fin n → D.X m),
      ∃ h : (Fin n → (MonoidAlgebra ℤ_[ℓ] Γ)) →+ D.X m,
      (∀ p, h p = ∑ j, ((lamD (p j)).f m).hom (w j)) ∧
      (∀ (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (p : Fin n → (MonoidAlgebra ℤ_[ℓ] Γ)),
        h (r • p) = ((lamD r).f m).hom (h p)) := by
    intro n m w
    refine ⟨{ toFun := fun p => ∑ j, ((lamD (p j)).f m).hom (w j)
              map_zero' := ?_
              map_add' := ?_ }, fun p => rfl, ?_⟩
    · simp only [Pi.zero_apply]
      exact Finset.sum_eq_zero (fun j _ => l0 m _)
    · intro p q
      simp only [Pi.add_apply]
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun j _ => ladd m _ _ _)
    · intro r p
      simp only [AddMonoidHom.coe_mk, ZeroHom.coe_mk, Pi.smul_apply, smul_eq_mul]
      rw [map_sum]
      exact Finset.sum_congr rfl (fun j _ => lmul m _ _ _)

  obtain ⟨F2, h2, hh2, hH2⟩ : ∃ (F2 : (Fin T.b → (MonoidAlgebra ℤ_[ℓ] Γ)) →ₗ[(MonoidAlgebra ℤ_[ℓ] Γ)]
      (Fin T.b → (MonoidAlgebra ℤ_[ℓ] Γ))) (h2 : (Fin T.b → (MonoidAlgebra ℤ_[ℓ] Γ)) →+ D.X 1),
      (∀ (r : (MonoidAlgebra ℤ_[ℓ] Γ)) (p : Fin T.b → (MonoidAlgebra ℤ_[ℓ] Γ)),
        h2 (r • p) = ((lamD r).f 1).hom (h2 p)) ∧
      ∀ p, T.α2 (F2 p) = (Fr.f 2).hom (T.α2 p) + (D.d 1 2).hom (h2 p) := by
    have cyc : ∀ j : Fin T.b, (D.d 2 3).hom ((Fr.f 2).hom (T.α2 (Pi.single j 1))) = 0 := by
