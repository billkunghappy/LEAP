        fun _ => U i := by
      funext t; exact hS (g t) (hgS t) i
    rw [hconst] at hlim
    exact tendsto_nhds_unique hlim tendsto_const_nhds

theorem wc_pencil_VQ_block_monodromy_tensor_trace_nm (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∃ (r t : ℕ) (b : Fin r → Fin t) (J : Matrix (Fin r) (Fin r) ℚ_[ℓ])
        (G : Set (Matrix (Fin r) (Fin r) ℚ_[ℓ])) (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      J.transpose = -J ∧ IsUnit J.det ∧ (∀ p q, b p ≠ b q → J p q = 0) ∧
      (∃ m : ℕ, ∀ s : Matrix (Fin r) (Fin r) ℚ_[ℓ], s.transpose * J * s = J →
          (∀ p q, b p ≠ b q → s p q = 0) →
          (∀ a a', ‖s a a' - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a a'‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ))) →
          s ∈ G) ∧
      (∀ p q, b p ≠ b q → Φ p q = 0) ∧
      Φ.transpose * J * Φ = ((Nat.card F'' : ℚ_[ℓ]) ^ (n - 1)) • J ∧
      ∀ k : ℕ, 1 ≤ k → ∃ (N : ℕ) (T : Fin N → (Fin (2 * k) → Fin r) → ℚ_[ℓ])
          (A : Matrix (Fin N) (Fin N) ℚ_[ℓ]) (Hk : Multiset (AlgebraicClosure ℚ_[ℓ])),
        LinearIndependent ℚ_[ℓ] T ∧
        (∀ l, ∀ g ∈ G, ∀ i, ∑ j, T l j * ∏ a, g (j a) (i a) = T l i) ∧
        (∀ l i, ∑ j, T l j * ∏ a, Φ (j a) (i a) = ∑ l', A l' l * T l' i) ∧
