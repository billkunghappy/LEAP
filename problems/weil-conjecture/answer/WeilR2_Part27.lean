        (fun x => wcSpfTruncMap I.cocomplex (ℓ ^ n) (lamI x)) ρ)) (wcLnModelFrob Q ≫ Ψ₀)) :=
by
  classical
  have hNpos : 0 < ℓ ^ n := pow_pos (Fact.out : Nat.Prime ℓ).pos n

  haveI hmono : Mono ((ℓ ^ n) • 𝟙 (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP))) :=
    sheaf_free_yoneda_nsmul_mono (Scheme.ProEt.topology (wcP1Over K).left)
      (wcGeomPoint K (wcP1Over K) hP) (ℓ ^ n) hNpos
  have hdiv : ∀ j (y : (wcCxJ K hP I.cocomplex).X j), ∃ z, (ℓ ^ n) • z = y := by
    intro j y
    let y' : wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) ⟶ I.cocomplex.X j := y
    have h1 := Injective.comp_factorThru y'
      ((ℓ ^ n) • 𝟙 (wcFreeSheaf (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)))
    rw [Preadditive.nsmul_comp, Category.id_comp] at h1
    exact ⟨_, h1⟩

  have hD1 : wcCxJMap K hP (lamI 1) = 𝟙 _ := by
    unfold wcCxJMap; rw [hI.1.1, CategoryTheory.Functor.map_id]; rfl
  have hD2 : ∀ a b, wcCxJMap K hP (lamI (a + b)) = wcCxJMap K hP (lamI a) + wcCxJMap K hP (lamI b) := by
    intro a b; unfold wcCxJMap; rw [hI.1.2.1, CategoryTheory.Functor.map_add]; rfl
  have hD3 : ∀ a b, wcCxJMap K hP (lamI (a * b)) = wcCxJMap K hP (lamI b) ≫ wcCxJMap K hP (lamI a) := by
    intro a b; unfold wcCxJMap; rw [hI.1.2.2, CategoryTheory.Functor.map_comp]; rfl
  have hD : wcRingAct (fun x => wcCxJMap K hP (lamI x)) := ⟨hD1, hD2, hD3⟩
  have hFr : ∀ x, wcCxJMap K hP (lamI x) ≫ wcCxJFrob K hP I.cocomplex =
      wcCxJFrob K hP I.cocomplex ≫ wcCxJMap K hP (lamI x) := fun x =>
    (NatTrans.mapHomologicalComplex _ _).naturality (lamI x)

  choose σ hσ hσl using fun k => wcU_sms_equivariant_lift ℓ Γ P (wcCxJ K hP I.cocomplex)
    (fun x => wcCxJMap K hP (lamI x)) hD (ℓ ^ n) hdiv k k (φ.f k).hom
    (fun x v => congrArg (fun g : wcGModelAb P ⟶ wcCxJ K hP I.cocomplex => (g.f k).hom v) (hlin x))
  choose τ hτ hτl using fun k => wcU_sms_equivariant_lift ℓ Γ P (wcCxJ K hP I.cocomplex)
    (fun x => wcCxJMap K hP (lamI x)) hD (ℓ ^ n) hdiv k (k + 1) (H.hom (k + 1) k).hom
