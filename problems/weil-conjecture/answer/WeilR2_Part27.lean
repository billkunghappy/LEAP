    obtain ⟨hα0, -⟩ := hG.2.2.2.2
    have hα : ∀ γ, (α γ).hom ≫ q ≫ Uo.ι = q ≫ Uo.ι := fun γ => by
      rw [← Category.assoc, hα0 γ]
    have htr : ∀ (Z' : (wcP1Over K).left.ProEt) (a b : Z' ⟶ W)
