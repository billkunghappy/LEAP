        Multiplicative.toAdd (c (wcLtcPair a b z))
          ((show C(↥Z'.left, Fin k → ZMod (ℓ ^ n)) from
            ((θr.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z))
    {Uo : X.Opens} {V : Scheme.{u}} (q : V ⟶ Uo.toScheme)
    (α : wcH2rGam.{u} ℓ k n →* Aut V) (hG : wcGalCover q (wcH2rGam.{u} ℓ k n) α)
    (hα : ∀ g, (α g).hom ≫ q ≫ Uo.ι = q ≫ Uo.ι)
    (fr : W.left ⟶ V) (hfr : fr ≫ q ≫ Uo.ι = W.hom)
    (htrans : ∀ (T : X.ProEt) (a b : T ⟶ W) (γ : wcH2rGam.{u} ℓ k n),
      (∀ z : T.left, (ULift.up (c (wcLtcPair a b z))⁻¹ : wcH2rGam.{u} ℓ k n) = γ) →
        b.left ≫ fr = a.left ≫ fr ≫ (α γ).hom)
    (ρ : wcH2rGam.{u} ℓ k n →* GL (Fin k) (ZMod (ℓ ^ n)))
    (hρ : ∀ (g : wcH2rGam.{u} ℓ k n) (v : Fin k → ZMod (ℓ ^ n)),
      Matrix.vecMul v (((ρ g)⁻¹ : GL (Fin k) (ZMod (ℓ ^ n))) : Matrix (Fin k) (Fin k) (ZMod (ℓ ^ n))) =
        Multiplicative.toAdd (ULift.down g) v) :
    ∃ μ0 : wcH2rPre (q ≫ Uo.ι) Z (wcH2rGam.{u} ℓ k n) α hα ℓ n k ρ ⟶ L.obj,
      ∀ (T : X.ProEt) (_ : ∀ t, T.hom t ∉ Z)
        (φ : (wcH2rPre (q ≫ Uo.ι) Z (wcH2rGam.{u} ℓ k n) α hα ℓ n k ρ).obj (Opposite.op T))
        (T' : X.ProEt) (cc : T' ⟶ T) (b' : T' ⟶ W) (z : T'.left),
        (show C(↥T'.left, Fin k → ZMod (ℓ ^ n)) from
            ((θr.hom.hom.app (Opposite.op (Over.mk b'))).hom
              ((L.obj.map cc.op).hom ((μ0.app (Opposite.op T)).hom φ))).down) z =
          (Subtype.val (Subtype.val φ) :
              ULift.{u+1} C(↥(Limits.pullback T.hom (q ≫ Uo.ι)), Fin k → ZMod (ℓ ^ n))).down
            (Limits.pullback.lift cc.left (b'.left ≫ fr)
              (by rw [Category.assoc, hfr, MorphismProperty.Over.w cc, MorphismProperty.Over.w b'])
              z) :=
by
  classical
  obtain ⟨h5a, h5b, h5c⟩ :=
    wc_h2r_lpm_pre_sections_facts (q ≫ Uo.ι) Z (wcH2rGam.{u} ℓ k n) α hα ℓ n k ρ
  let lam : ∀ (T T' : X.ProEt) (_ : T' ⟶ T) (_ : T' ⟶ W),
      T'.left ⟶ Limits.pullback T.hom (q ≫ Uo.ι) :=
    fun T T' cc b' => Limits.pullback.lift cc.left (b'.left ≫ fr)
      (by rw [Category.assoc, hfr, MorphismProperty.Over.w cc, MorphismProperty.Over.w b'])
  let D : ∀ T : X.ProEt,
      (wcH2rPre (q ≫ Uo.ι) Z (wcH2rGam.{u} ℓ k n) α hα ℓ n k ρ).obj (Opposite.op T) →
        L.obj.obj (Opposite.op T) → Prop :=
    fun T φ x => ∀ (T' : X.ProEt) (cc : T' ⟶ T) (b' : T' ⟶ W) (z : T'.left),
      (show C(↥T'.left, Fin k → ZMod (ℓ ^ n)) from
          ((θr.hom.hom.app (Opposite.op (Over.mk b'))).hom ((L.obj.map cc.op).hom x)).down) z =
        (Subtype.val (Subtype.val φ) :
            ULift.{u+1} C(↥(Limits.pullback T.hom (q ≫ Uo.ι)), Fin k → ZMod (ℓ ^ n))).down
          (lam T T' cc b' z)
  have hex : ∀ T : X.ProEt, (∀ t, T.hom t ∉ Z) →
      ∀ φ : (wcH2rPre (q ≫ Uo.ι) Z (wcH2rGam.{u} ℓ k n) α hα ℓ n k ρ).obj (Opposite.op T),
        ∃! x : L.obj.obj (Opposite.op T), D T φ x := by
    intro T hT φ
    let F0 : C(↥(Limits.pullback T.hom (q ≫ Uo.ι)), Fin k → ZMod (ℓ ^ n)) :=
      (Subtype.val (Subtype.val φ) :
        ULift.{u+1} C(↥(Limits.pullback T.hom (q ≫ Uo.ι)), Fin k → ZMod (ℓ ^ n))).down
    exact wc_h2r_lpm_described_section X Z L W hWqc hWs (Fin k → ZMod (ℓ ^ n)) θr c htr T hT
      (fun T' cc b' => F0.comp ⟨fun z => lam T T' cc b' z, (lam T T' cc b').continuous⟩)
      (by
        intro T' T'' d cc b' z
        show F0 (lam T T'' (d ≫ cc) (d ≫ b') z) = F0 (lam T T' cc b' (d.left z))
        have e : lam T T'' (d ≫ cc) (d ≫ b') = d.left ≫ lam T T' cc b' := by
          apply Limits.pullback.hom_ext
          · exact (Limits.pullback.lift_fst _ _ _).trans
              ((congrArg (fun m => d.left ≫ m) (Limits.pullback.lift_fst cc.left (b'.left ≫ fr) _)).symm.trans
                (Category.assoc _ _ _).symm)
          · exact (Limits.pullback.lift_snd _ _ _).trans ((Category.assoc d.left b'.left fr).trans
              ((congrArg (fun m => d.left ≫ m) (Limits.pullback.lift_snd cc.left (b'.left ≫ fr) _)).symm.trans
                (Category.assoc _ _ _).symm))
        rw [e, Scheme.Hom.comp_apply])
      (by
        intro T' cc b₁ b₂ z
        exact wc_h2r_lpm_frame_value_transition X W ℓ n k c hc q α hα fr hfr htrans ρ hρ T F0
          (fun γ y => h5a T φ γ y) T' cc b₁ b₂ z)
  have hadd : ∀ T : X.ProEt, (∀ t, T.hom t ∉ Z) →
      ∀ (φ φ' : (wcH2rPre (q ≫ Uo.ι) Z (wcH2rGam.{u} ℓ k n) α hα ℓ n k ρ).obj (Opposite.op T))
        (x x' : L.obj.obj (Opposite.op T)),
        D T φ x → D T φ' x' → D T (φ + φ') (x + x') := by
    intro T _ φ φ' x x' hx hx' T' cc b' z
    have e1 := hx T' cc b' z
    have e2 := hx' T' cc b' z
    have e3 : (θr.hom.hom.app (Opposite.op (Over.mk b'))).hom ((L.obj.map cc.op).hom (x + x')) =
        (θr.hom.hom.app (Opposite.op (Over.mk b'))).hom ((L.obj.map cc.op).hom x) +
          (θr.hom.hom.app (Opposite.op (Over.mk b'))).hom ((L.obj.map cc.op).hom x') := by
      rw [map_add]
      exact map_add (θr.hom.hom.app (Opposite.op (Over.mk b'))).hom _ _
    show (show C(↥T'.left, Fin k → ZMod (ℓ ^ n)) from
          ((θr.hom.hom.app (Opposite.op (Over.mk b'))).hom ((L.obj.map cc.op).hom (x + x'))).down) z = _
    rw [e3]
    exact congrArg₂ (· + ·) e1 e2
  have hnat : ∀ {T T' : X.ProEt} (g : T' ⟶ T), (∀ t, T.hom t ∉ Z) →
      ∀ (φ : (wcH2rPre (q ≫ Uo.ι) Z (wcH2rGam.{u} ℓ k n) α hα ℓ n k ρ).obj (Opposite.op T))
        (x : L.obj.obj (Opposite.op T)),
        D T φ x → D T'
          (((wcH2rPre (q ≫ Uo.ι) Z (wcH2rGam.{u} ℓ k n) α hα ℓ n k ρ).map g.op).hom φ)
          ((L.obj.map g.op).hom x) := by
    intro T T' g _ φ x hx T'' cc b' z
    have e1 := hx T'' (cc ≫ g) b' z
    have e2 : (L.obj.map cc.op).hom ((L.obj.map g.op).hom x) = (L.obj.map (cc ≫ g).op).hom x := by
      rw [op_comp, Functor.map_comp]; rfl
    have e3 : lam T T'' (cc ≫ g) b' = lam T' T'' cc b' ≫
        Limits.pullback.map T'.hom (q ≫ Uo.ι) T.hom (q ≫ Uo.ι) g.left (𝟙 V) (𝟙 X)
          ((Category.comp_id _).trans (MorphismProperty.Over.w g).symm) (by simp) := by
      apply Limits.pullback.hom_ext
      · refine Eq.trans ?_ (Category.assoc _ _ _).symm
        exact (Limits.pullback.lift_fst _ _ _).trans
          ((congrArg (fun m => lam T' T'' cc b' ≫ m) (Limits.pullback.lift_fst _ _ _)).trans
            ((Category.assoc _ _ _).symm.trans
              (congrArg (fun m => m ≫ g.left) (Limits.pullback.lift_fst _ _ _)))).symm
      · refine Eq.trans ?_ (Category.assoc _ _ _).symm
        exact (Limits.pullback.lift_snd _ _ _).trans
          ((congrArg (fun m => lam T' T'' cc b' ≫ m)
              ((Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _))).trans
            (Limits.pullback.lift_snd _ _ _)).symm
    show (show C(↥T''.left, Fin k → ZMod (ℓ ^ n)) from
          ((θr.hom.hom.app (Opposite.op (Over.mk b'))).hom
            ((L.obj.map cc.op).hom ((L.obj.map g.op).hom x))).down) z = _
    rw [e2]
    refine e1.trans ?_
    rw [h5b T T' g φ (lam T' T'' cc b' z), e3, Scheme.Hom.comp_apply]
  obtain ⟨μ0, hμ⟩ := wc_h2r_lpm_presheaf_hom_of_unique_rel
    (wcH2rPre (q ≫ Uo.ι) Z (wcH2rGam.{u} ℓ k n) α hα ℓ n k ρ) L.obj
    (fun T : X.ProEt => ∀ t, T.hom t ∉ Z)
    (fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _)
    D hex hadd hnat h5c
  exact ⟨μ0, fun T hT φ T' cc b' z => hμ T hT φ T' cc b' z⟩

theorem wc_h2r_level_map_offS_props (X : Scheme.{u}) (Z : Set X)
    (L : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1})
    (W : X.ProEt) (hWqc : QuasiCompact W.hom) (hWs : ∀ p : X, p ∉ Z → ∃ z : W.left, W.hom z = p)
    (ℓ n k : ℕ) [Fact (Nat.Prime ℓ)]
    (θr : L.over W ≅ (wcContSheaf X (Fin k → ZMod (ℓ ^ n))).over W)
    {Uo : X.Opens} {V : Scheme.{u}} (q : V ⟶ Uo.toScheme)
    (α : wcH2rGam.{u} ℓ k n →* Aut V) (hG : wcGalCover q (wcH2rGam.{u} ℓ k n) α)
    (hα : ∀ g, (α g).hom ≫ q ≫ Uo.ι = q ≫ Uo.ι)
    (fr : W.left ⟶ V) (hfr : fr ≫ q ≫ Uo.ι = W.hom)
    (ρ : wcH2rGam.{u} ℓ k n →* GL (Fin k) (ZMod (ℓ ^ n)))
    (hρ : ∀ (g : wcH2rGam.{u} ℓ k n) (v : Fin k → ZMod (ℓ ^ n)),
      Matrix.vecMul v (((ρ g)⁻¹ : GL (Fin k) (ZMod (ℓ ^ n))) : Matrix (Fin k) (Fin k) (ZMod (ℓ ^ n))) =
        Multiplicative.toAdd (ULift.down g) v)
    (μ0 : wcH2rPre (q ≫ Uo.ι) Z (wcH2rGam.{u} ℓ k n) α hα ℓ n k ρ ⟶ L.obj)
    (hχ : ∀ (T : X.ProEt) (_ : ∀ t, T.hom t ∉ Z)
        (φ : (wcH2rPre (q ≫ Uo.ι) Z (wcH2rGam.{u} ℓ k n) α hα ℓ n k ρ).obj (Opposite.op T))
        (T' : X.ProEt) (cc : T' ⟶ T) (b' : T' ⟶ W) (z : T'.left),
        (show C(↥T'.left, Fin k → ZMod (ℓ ^ n)) from
            ((θr.hom.hom.app (Opposite.op (Over.mk b'))).hom
              ((L.obj.map cc.op).hom ((μ0.app (Opposite.op T)).hom φ))).down) z =
          (Subtype.val (Subtype.val φ) :
              ULift.{u+1} C(↥(Limits.pullback T.hom (q ≫ Uo.ι)), Fin k → ZMod (ℓ ^ n))).down
            (Limits.pullback.lift cc.left (b'.left ≫ fr)
              (by rw [Category.assoc, hfr, MorphismProperty.Over.w cc, MorphismProperty.Over.w b'])
              z)) :
    (∀ T : X.ProEt, (∀ t, T.hom t ∉ Z) → Function.Injective (μ0.app (Opposite.op T)).hom) ∧
      ∀ T : X.ProEt, (∀ t, T.hom t ∉ Z) → ∀ x : L.obj.obj (Opposite.op T), ∃ R : Sieve T,
        R ∈ Scheme.ProEt.topology X T ∧ ∀ (T' : X.ProEt) (g : T' ⟶ T), R.arrows g →
          ∃ e, (μ0.app (Opposite.op T')).hom e = (L.obj.map g.op).hom x :=
by
  classical

  have hpart : ∀ (W : Scheme.{u}) (h : W ⟶ X) (t : W ⟶ V) (ht : h = t ≫ q ≫ Uo.ι),
      (∀ z : ↥(Limits.pullback h (q ≫ Uo.ι)), ∃! γ : wcH2rGam.{u} ℓ k n,
        z ∈ Set.range ⇑(Limits.pullback.lift (𝟙 W)
        (t ≫ (α γ).hom) (by rw [Category.id_comp, ht, Category.assoc, hα γ]) :
          W ⟶ Limits.pullback h (q ≫ Uo.ι))) ∧
      ∀ γ : wcH2rGam.{u} ℓ k n, Topology.IsOpenEmbedding ⇑(Limits.pullback.lift (𝟙 W)
        (t ≫ (α γ).hom)
        (by rw [Category.id_comp, ht, Category.assoc, hα γ]) : W ⟶ Limits.pullback h (q ≫ Uo.ι)) := by
    intro W h t ht
    obtain ⟨hfin, -, -, -, hα', hiso⟩ := hG
    haveI : Finite (wcH2rGam.{u} ℓ k n) := hfin

    open CategoryTheory.Limits in
    have s1 : ∀ {X W V T₀ : Scheme.{u}} (q' : V ⟶ W) (ι : W ⟶ X) [Mono ι] (Γ : Type u) [Finite Γ]
        (β : Γ → (V ⟶ V)) (hβ : ∀ γ, β γ ≫ q' = q')
        (_ : IsIso (Sigma.desc (fun γ : Γ => pullback.lift (β γ) (𝟙 V)
          ((hβ γ).trans (Category.id_comp q').symm)) : ∐ (fun _ : Γ => V) ⟶ pullback q' q'))
        (h : T₀ ⟶ X) (t : T₀ ⟶ V) (_ : h = t ≫ q' ≫ ι)
        (s : Γ → (T₀ ⟶ pullback h (q' ≫ ι)))
        (_ : ∀ γ, s γ ≫ pullback.fst h (q' ≫ ι) = 𝟙 T₀)
        (_ : ∀ γ, s γ ≫ pullback.snd h (q' ≫ ι) = t ≫ β γ),
        IsIso (Sigma.desc s) := by
      intro X W V T₀ q' ι _ Γ _ β hβ hiso h t ht s hs1 hs2
      let a : Cofan (fun _ : Γ => V) := Cofan.mk (pullback q' q') (fun γ => pullback.lift (β γ) (𝟙 V)
          ((hβ γ).trans (Category.id_comp q').symm))
      have hc : IsColimit a := ((Cofan.nonempty_isColimit_iff_isIso_sigmaDesc a).mpr hiso).some
      have hau : IsUniversalColimit a := FinitaryPreExtensive.isUniversal_finiteCoproducts hc
      have w₀ : pullback.snd h (q' ≫ ι) ≫ q' = (pullback.fst h (q' ≫ ι) ≫ t) ≫ q' := by
        apply (cancel_mono ι).mp
        simp only [Category.assoc]
        rw [← ht]
        exact pullback.condition.symm
      let p₂ : pullback h (q' ≫ ι) ⟶ pullback q' q' :=
        pullback.lift (pullback.snd h (q' ≫ ι)) (pullback.fst h (q' ≫ ι) ≫ t) w₀
      have hp₂f : p₂ ≫ pullback.fst q' q' = pullback.snd h (q' ≫ ι) := pullback.lift_fst _ _ _
      have hp₂s : p₂ ≫ pullback.snd q' q' = pullback.fst h (q' ≫ ι) ≫ t := pullback.lift_snd _ _ _
      have h₀ : IsPullback (pullback.fst h (q' ≫ ι)) p₂ t (pullback.snd q' q') := by
        refine IsPullback.of_isLimit (c := PullbackCone.mk (pullback.fst h (q' ≫ ι)) p₂ hp₂s.symm) ?_
        have w₁ : ∀ c : PullbackCone t (pullback.snd q' q'),
            c.fst ≫ h = (c.snd ≫ pullback.fst q' q') ≫ q' ≫ ι := by
          intro c
          have hc' := c.condition
          calc c.fst ≫ h = (c.fst ≫ t) ≫ q' ≫ ι := by rw [ht, Category.assoc]
            _ = (c.snd ≫ pullback.snd q' q') ≫ q' ≫ ι := by rw [hc']
            _ = (c.snd ≫ pullback.fst q' q') ≫ q' ≫ ι := by
              simp only [Category.assoc, pullback.condition_assoc]
        refine PullbackCone.IsLimit.mk _
          (fun c => pullback.lift c.fst (c.snd ≫ pullback.fst q' q') (w₁ c)) ?_ ?_ ?_
        · intro c
          exact pullback.lift_fst _ _ _
        · intro c
          apply pullback.hom_ext
          · rw [Category.assoc, hp₂f, pullback.lift_snd]
          · rw [Category.assoc, hp₂s, ← Category.assoc, pullback.lift_fst]
            exact c.condition
        · intro c m hm1 hm2
          apply pullback.hom_ext
          · rw [pullback.lift_fst]
            exact hm1
          · rw [pullback.lift_snd, ← hp₂f, ← Category.assoc]
            exact congrArg (· ≫ pullback.fst q' q') hm2
      let d : Cofan (fun _ : Γ => T₀) := Cofan.mk (pullback h (q' ≫ ι)) s
      have hd := hau.nonempty_isColimit_of_isPullback_left (fun _ => 𝟙 V) (pullback.snd q' q') t
        (fun _ => 𝟙 T₀) (fun _ => t) (fun _ => IsPullback.id_horiz t) h₀ d (Iso.refl _)
        (fun γ => pullback.lift_snd _ _ _)
        (fun γ => by
          show s γ ≫ 𝟙 _ ≫ _ = _
          rw [Category.id_comp]
          exact hs1 γ)
        (fun γ => by
          show s γ ≫ 𝟙 _ ≫ p₂ = t ≫ pullback.lift (β γ) (𝟙 V) _
          rw [Category.id_comp]
          apply pullback.hom_ext
          · rw [Category.assoc, hp₂f, hs2, Category.assoc, pullback.lift_fst]
          · rw [Category.assoc, hp₂s, ← Category.assoc, hs1, Category.assoc, pullback.lift_snd,
              Category.id_comp, Category.comp_id])
