  have hpin : ∀ t : (wcRq D.f ℓ (2 * (n - 1))).obj.obj (Opposite.op W),
      ((wcRq D.f ℓ (2 * (n - 1))).obj.map ι.op).hom
        (((wcRq D.f ℓ (2 * (n - 1))).obj.map φ.op).hom t) =
      ((wcRqScalar D.f ℓ (2 * (n - 1)) ((Nat.card F'' : ℚ_[ℓ]) ^ (n - 1))).hom.app
        (Opposite.op N.V)).hom (((wcRq D.f ℓ (2 * (n - 1))).obj.map ι.op).hom t) := by
    intro t
    have e1 : ((wcRq D.f ℓ (2 * (n - 1))).obj.map ι.op).hom
        (((wcRq D.f ℓ (2 * (n - 1))).obj.map φ.op).hom t) =
        ((wcRq D.f ℓ (2 * (n - 1))).obj.map (ι ≫ φ).op).hom t := by
      rw [op_comp, Functor.map_comp] <;> rfl
    have e2 : ((wcRq D.f ℓ (2 * (n - 1))).obj.map ((N.φ ≫ ι) ≫ γ₁).op).hom t =
        ((wcRq D.f ℓ (2 * (n - 1))).obj.map N.φ.op).hom
          (((wcRq D.f ℓ (2 * (n - 1))).obj.map ι.op).hom
            (((wcRq D.f ℓ (2 * (n - 1))).obj.map γ₁.op).hom t)) := by
      rw [op_comp, op_comp, Functor.map_comp, Functor.map_comp] <;> rfl
    rw [e1, hrel, e2, hdeck₁, hNφ]

  have hpullΦ := hpullgen φ Φ hΦ
  have hrelΦ : ∀ x y, β x y = (Nat.card F'' : ℚ_[ℓ]) ^ (n - 1) *
      β ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x)
      ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec y) := by
    intro x y
    have e1 := hB'nat W W hoffW hoffW φ (c ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x))
      (c ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec y))
    rw [hpullΦ x, hpullΦ y] at e1
    rw [hres, hres, e1, hpin, hLsc]

  have hΦP : ∀ v : Fin r → ℚ_[ℓ], (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec
      (((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec v) = v := by
    intro v
    rw [Matrix.mulVec_mulVec, ← Units.val_mul, mul_inv_cancel, Units.val_one, Matrix.one_mulVec]
  have hrel' : ∀ x y,
      β (((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x)
        (((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec y) =
      (Nat.card F'' : ℚ_[ℓ]) ^ (n - 1) * β x y := by
    intro x y
    rw [hrelΦ, hΦP, hΦP]
  have hcomp : β.compl₁₂
      (Matrix.toLin' ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
      (Matrix.toLin' ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ])) =
      ((Nat.card F'' : ℚ_[ℓ]) ^ (n - 1)) • β :=
    LinearMap.ext₂ (fun x y => by
      rw [LinearMap.compl₁₂_apply, Matrix.toLin'_apply, Matrix.toLin'_apply, hrel',
        LinearMap.smul_apply, LinearMap.smul_apply, smul_eq_mul])
  have key := LinearMap.toMatrix₂'_compl₁₂ β
    (Matrix.toLin' ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
    (Matrix.toLin' ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
  rw [hcomp, LinearMap.toMatrix'_toLin', map_smul] at key
  refine ⟨J, hJt, hJdet, hΓJ, ?_⟩
  rw [hJdef]
  exact key.symm

theorem wc_vqtt_m_pos (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    1 ≤ D.m :=
by
  classical
  by_contra hlt
  have hm0 : D.m = 0 := by omega
  have hv : ∀ i : Fin D.m, False := fun i => by have := i.isLt; omega
  obtain ⟨W, w, r, θ, φ, hB⟩ := wc_vqm_galois_frame_exists F' F'' Y n hn hn2 D ℓ hℓ hP hNI
  obtain ⟨_hθc, hqc, hconn, hoff, hcov, hgal, -⟩ := hB
  have hsurj : ∀ p : (wcGeomPoint F'' (wcP1Over F'') hP).left, ∃ z : W.left, w.left z = p :=
    fun p => hcov p (fun i => (hv i).elim)
  have htriv := wc_proet_P1_offS_frames_trivial F'' hP ℓ D.m D.S D.hS (wcPencilVQ D ℓ hP) W w r θ
    hqc hconn hoff hcov hgal (fun i => (hv i).elim)
  have hfix : ∀ (V : (wcP1Over F'').left.ProEt), ConnectedSpace V.left → ∀ (h₁ h₂ : V ⟶ W)
      (x : (wcPencilVQ D ℓ hP).obj.obj (Opposite.op V)), h₁ ≫ w = h₂ ≫ w →
      (θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x =
        (θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x := by
    intro V hV h₁ h₂ x h12
    obtain ⟨γ, hγw, hγ⟩ := hgal V h₁ h₂ hV h12
    obtain ⟨A, hA⟩ := wc_proet_deck_frame_linear (wcP1Over F'').left ℓ (wcPencilVQ D ℓ hP) W
      hconn r θ γ
    have hAid : A = LinearMap.id :=
      htriv γ A hγw (fun s z => hA W (𝟙 W) γ (CategoryTheory.Category.id_comp γ).symm s z)
    have hpt : ∀ z : V.left, (show C(↥V.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk h₂))).hom x).down) z =
        (show C(↥V.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk h₁))).hom x).down) z := by
      intro z
      rw [hA V h₁ h₂ hγ x z, hAid, LinearMap.id_apply]
    exact ULift.ext _ _ (ContinuousMap.ext (fun z => (hpt z).symm))
  obtain ⟨θ₀⟩ := wc_proet_frame_fixed_descent (wcP1Over F'').left ℓ
    (wcGeomPoint F'' (wcP1Over F'') hP) W w hqc hsurj (wcPencilVQ D ℓ hP) r θ hfix
  have hGC : wcPencilGC F'' hP ℓ (wcPencilVQ D ℓ hP) := ⟨r, ⟨θ₀⟩⟩
  have hvan := wc_P1_H1_geomConst_vanish F'' hP ℓ hℓ (wcPencilVQ D ℓ hP) hGC
  obtain ⟨β, ⟨r₁, e₁, _he₁, hmem⟩, _hβ⟩ := hNI
  rcases Nat.eq_zero_or_pos r₁ with h0 | hpos
  · subst h0
    rw [Matrix.charpoly_isEmpty, Polynomial.aroots_one] at hmem
    exact Multiset.notMem_zero β hmem
  · have h1 : (Pi.single (⟨0, hpos⟩ : Fin r₁) (1 : ℚ_[ℓ]) : Fin r₁ → ℚ_[ℓ]) = 0 := by
      rw [← AddEquiv.apply_symm_apply e₁ (Pi.single _ 1), hvan (e₁.symm _), map_zero]
    have h2 := congrFun h1 ⟨0, hpos⟩
    rw [Pi.single_eq_same, Pi.zero_apply] at h2
    exact one_ne_zero h2

theorem wc_vqtt_r_pos (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ) :
    1 ≤ r :=
by
  classical
  by_contra hlt
  push_neg at hlt
  obtain rfl : r = 0 := by omega
  obtain ⟨_hθc, hqc, _hconn, _hoff, hcov, _hgal, _hφw, -, -, -⟩ := hB
  have hsub : ∀ X, Subsingleton
      (((wcContSheaf (wcP1Over F'').left (Fin 0 → ℚ_[ℓ])).over W).obj.obj X) := by
    intro X
    constructor
    intro x y
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    exact Subsingleton.elim _ _
  have hZ0 : Limits.IsZero ((wcContSheaf (wcP1Over F'').left (Fin 0 → ℚ_[ℓ])).over W) := by
    rw [Limits.IsZero.iff_id_eq_zero]
    apply Sheaf.hom_ext
    ext X x
    exact (hsub X).elim _ _
  have hZ : Limits.IsZero ((wcPencilVQ D ℓ hP).over W) := Limits.IsZero.of_iso hZ0 θ
  have hK := wc_P1_offS_sections_zero_of_over_zero F'' hP D.m D.S W w hqc hcov
    (wcPencilVQ D ℓ hP) hZ
  have hH1 := wc_proet_P1_finite_supp_ext_vanish F'' hP D.m D.S D.hS (wcPencilVQ D ℓ hP) hK 1 le_rfl
  obtain ⟨β, ⟨r', e, -, hβ⟩, -⟩ := hNI
  have hr' : r' = 0 := by
    by_contra hne
    have hpos : 0 < r' := Nat.pos_of_ne_zero hne
    have h1 := e.apply_symm_apply (Pi.single (⟨0, hpos⟩ : Fin r') (1 : ℚ_[ℓ]))
    rw [hH1 (e.symm _), map_zero] at h1
    have h2 := congrFun h1 ⟨0, hpos⟩
    simp at h2
  subst hr'
  have hc : (wcAddEquivMatrix e
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1)).charpoly = 1 := by
    rw [Matrix.charpoly, Matrix.det_isEmpty]
  rw [hc, Polynomial.aroots_one] at hβ
  exact Multiset.notMem_zero _ hβ

theorem wc_tsh_hom_sheaf_exists (S : Scheme.{u})
    (A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :
    ∃ (H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (e : ∀ T : S.ProEt, H.obj.obj (Opposite.op T) ≃+ (A.over T ⟶ B.over T))
      (post : (B ⟶ B) → (H ⟶ H)),
      (∀ (T T' : S.ProEt) (a : T' ⟶ T) (x : H.obj.obj (Opposite.op T)) (U : Over T'),
        (e T' ((H.obj.map a.op).hom x)).hom.app (Opposite.op U) =
          (e T x).hom.app (Opposite.op ((Over.map a).obj U))) ∧
      (∀ (β : B ⟶ B) (T : S.ProEt) (x : H.obj.obj (Opposite.op T)),
        e T (((post β).hom.app (Opposite.op T)).hom x) =
          e T x ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} T).map β) ∧
      post (𝟙 B) = 𝟙 H ∧ (∀ β β' : B ⟶ B, post (β ≫ β') = post β ≫ post β') ∧
      (∀ β β' : B ⟶ B, post (β + β') = post β + post β') :=
by
  let P : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    { obj := fun X => AddCommGrpCat.of
        ((Over.forget X.unop).op ⋙ A.obj ⟶ (Over.forget X.unop).op ⋙ B.obj)
      map := fun {X Y} g => AddCommGrpCat.ofHom
        (AddMonoidHom.mk' (fun x => (presheafHom A.obj B.obj).map g x) (fun _ _ => rfl))
      map_id := fun X => AddCommGrpCat.ext
        (fun x => Functor.map_id_apply (presheafHom A.obj B.obj) X x)
      map_comp := fun f g => AddCommGrpCat.ext
        (fun x => Functor.map_comp_apply (presheafHom A.obj B.obj) f g x) }
  have hP : Presheaf.IsSheaf (Scheme.ProEt.topology S) P := by
    let i : P ⋙ forget AddCommGrpCat.{u+1} ≅ presheafHom A.obj B.obj :=
      NatIso.ofComponents (fun X => Iso.refl _) (by intros; rfl)
    exact (Presheaf.isSheaf_iff_isSheaf_forget _ P (forget AddCommGrpCat.{u+1})).mpr
      ((Presheaf.isSheaf_of_iso_iff i).mpr (Presheaf.IsSheaf.hom A.obj B.obj B.property))
  let H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} := ⟨P, hP⟩
  let e : ∀ T : S.ProEt, H.obj.obj (Opposite.op T) ≃+ (A.over T ⟶ B.over T) := fun T =>
    { toFun := fun x => ObjectProperty.homMk x
      invFun := fun φ => φ.hom
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_add' := fun _ _ => rfl }
  let postApp : (B ⟶ B) → ∀ X : (S.ProEt)ᵒᵖ, P.obj X ⟶ P.obj X := fun β X =>
    AddCommGrpCat.ofHom (AddMonoidHom.mk'
      (fun x => x ≫ Functor.whiskerLeft (Over.forget X.unop).op β.hom)
      (fun x y => Preadditive.add_comp _ _ _ x y _))
  let postNat : (B ⟶ B) → (P ⟶ P) := fun β =>
    { app := postApp β
      naturality := fun X Y g => by
        apply AddCommGrpCat.ext
        intro x
        rfl }
  let post : (B ⟶ B) → (H ⟶ H) := fun β => ObjectProperty.homMk (postNat β)
  refine ⟨H, e, post, fun _ _ _ _ _ => rfl, fun _ _ _ => rfl, ?_, ?_, ?_⟩
  · apply Sheaf.hom_ext
    apply NatTrans.ext
    funext X
    apply AddCommGrpCat.ext
    intro x
    apply NatTrans.ext
    funext U
    show x.app U ≫ 𝟙 _ = x.app U
    exact Category.comp_id _
  · intro β β'
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext X
    apply AddCommGrpCat.ext
    intro x
    apply NatTrans.ext
    funext U
    show x.app U ≫ (β.hom.app _ ≫ β'.hom.app _) = (x.app U ≫ β.hom.app _) ≫ β'.hom.app _
    exact (Category.assoc _ _ _).symm
  · intro β β'
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext X
    apply AddCommGrpCat.ext
    intro x
    rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply]
    apply NatTrans.ext
    funext U
    show x.app U ≫ (β.hom.app _ + β'.hom.app _) = x.app U ≫ β.hom.app _ + x.app U ≫ β'.hom.app _
    exact Preadditive.comp_add _ _ _ _ _ _

theorem wc_tsh_cont_over_hom_rigid (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    (ιa ιb : Type) [Fintype ιa] [DecidableEq ιa] [Fintype ιb] [DecidableEq ιb]
    (φ : (wcContSheaf S (ιa → ℚ_[ℓ])).over V ⟶ (wcContSheaf S (ιb → ℚ_[ℓ])).over V) :
    ∃ M : V.left → Matrix ιb ιa ℚ_[ℓ], (∀ i j, Continuous fun v => M v i j) ∧
      ∀ (T : Over V) (f : (wcContSheaf S (ιa → ℚ_[ℓ])).obj.obj (Opposite.op T.left)) (t : T.left.left),
        (show C(↥T.left.left, ιb → ℚ_[ℓ]) from ((φ.hom.app (Opposite.op T)).hom f).down) t =
          (M (T.hom.left t)).mulVec ((show C(↥T.left.left, ιa → ℚ_[ℓ]) from f.down) t) :=
by
  classical

  have hfin : ∀ (a b : ℕ)
      (φ₀ : (wcContSheaf S (Fin a → ℚ_[ℓ])).over V ⟶ (wcContSheaf S (Fin b → ℚ_[ℓ])).over V),
      ∃ M : V.left → Matrix (Fin b) (Fin a) ℚ_[ℓ], (∀ i j, Continuous fun v => M v i j) ∧
        ∀ (T : Over V) (f : (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op T.left))
          (t : T.left.left),
          (show C(↥T.left.left, Fin b → ℚ_[ℓ]) from ((φ₀.hom.app (Opposite.op T)).hom f).down) t =
            (M (T.hom.left t)).mulVec ((show C(↥T.left.left, Fin a → ℚ_[ℓ]) from f.down) t) := by
    intro a b φ₀

    obtain ⟨G, hG⟩ := wc_contSheaf_over_hom_padic_pointwise S ℓ a b V φ₀

    have hlin : ∀ (v : V.left) (c : ℚ_[ℓ]) (y : Fin a → ℚ_[ℓ]), G v (c • y) = c • G v y := by
      intro v c y
      haveI : WeaklyEtale (V.left.fromSpecStalk v) := wc_fromSpecStalk_weaklyEtale V.left v
      haveI : WeaklyEtale (V.left.fromSpecStalk v ≫ V.hom) := by
        have := V.prop
        infer_instance
      let V' : S.ProEt := Scheme.ProEt.mk (V.left.fromSpecStalk v ≫ V.hom)
      let p : V' ⟶ V := MorphismProperty.Over.homMk (V.left.fromSpecStalk v) rfl trivial
      let t₀ : V'.left := IsLocalRing.closedPoint (V.left.presheaf.stalk v)
      have hp : p.left t₀ = v := Scheme.fromSpecStalk_closedPoint
      have hconn : ConnectedSpace V'.left := by
        show ConnectedSpace (Spec (V.left.presheaf.stalk v))
        refine { isPreconnected_univ := ?_, toNonempty := ⟨IsLocalRing.closedPoint _⟩ }
        refine _root_.isPreconnected_of_forall
          (IsLocalRing.closedPoint (V.left.presheaf.stalk v)) ?_
        intro y _
        exact ⟨closure {y}, Set.subset_univ _,
          (IsLocalRing.specializes_closedPoint y).mem_closure, subset_closure rfl,
          isPreconnected_singleton.closure⟩
      let φ' : (wcContSheaf S (Fin a → ℚ_[ℓ])).over V' ⟶ (wcContSheaf S (Fin b → ℚ_[ℓ])).over V' :=
        ObjectProperty.homMk (Functor.whiskerLeft (Over.map p).op φ₀.hom :
          ((wcContSheaf S (Fin a → ℚ_[ℓ])).over V').obj ⟶
            ((wcContSheaf S (Fin b → ℚ_[ℓ])).over V').obj)
      obtain ⟨A, hA⟩ := wc_contSheaf_over_hom_linear S ℓ V' hconn a b φ'
      have hstar : ∀ y' : Fin a → ℚ_[ℓ], G v y' = A y' := by
        intro y'
        let T₀ : Over V' := Over.mk (𝟙 V')
        let κ : (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op T₀.left) :=
          (show (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op V') from
            ULift.up (ContinuousMap.const ↥V'.left y'))
        have h1 := congrArg (fun ψ => (show C(↥V'.left, Fin b → ℚ_[ℓ]) from
          ((ψ.hom.app (Opposite.op T₀)).hom κ).down) t₀) hA
        have h2 := hG ((Over.map p).obj T₀) κ t₀
        have e : ((Over.map p).obj T₀).hom.left t₀ = v := by
          show (𝟙 V' ≫ p).left t₀ = v
          rw [Category.id_comp]
          exact hp
        exact (congrArg (fun w => G w y') e).symm.trans (h2.symm.trans (h1.trans rfl))
      rw [hstar, hstar]
      exact map_smul A c y
    let L : V.left → ((Fin a → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin b → ℚ_[ℓ])) := fun v =>
      { toFun := G v
        map_add' := (G v).map_add
        map_smul' := hlin v }
    refine ⟨fun v => LinearMap.toMatrix' (L v), ?_, ?_⟩
    · intro i j
      let T1 : Over V := Over.mk (𝟙 V)
      let e : Fin a → ℚ_[ℓ] := Pi.single j 1
      let κ : (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op T1.left) :=
        (show (wcContSheaf S (Fin a → ℚ_[ℓ])).obj.obj (Opposite.op V) from
          ULift.up (ContinuousMap.const ↥V.left e))
      let F : C(↥V.left, Fin b → ℚ_[ℓ]) :=
        (show C(↥T1.left.left, Fin b → ℚ_[ℓ]) from ((φ₀.hom.app (Opposite.op T1)).hom κ).down)
      have hF : ∀ w : V.left, F w = G w e := fun w => hG T1 κ w
      have hfun : (fun v => LinearMap.toMatrix' (L v) i j) = fun v => F v i := by
        funext v
        rw [LinearMap.toMatrix'_apply]
        exact (congrFun (hF v) i).symm
      rw [hfun]
      exact (continuous_apply i).comp F.continuous
    · intro T f t
      exact (hG T f t).trans (LinearMap.toMatrix'_mulVec (L (T.hom.left t)) _).symm

  let ea : ιa ≃ Fin (Fintype.card ιa) := Fintype.equivFin ιa
  let eb : ιb ≃ Fin (Fintype.card ιb) := Fintype.equivFin ιb
  let ρa' : (Fin (Fintype.card ιa) → ℚ_[ℓ]) →+ (ιa → ℚ_[ℓ]) :=
    AddMonoidHom.mk' (fun y => y ∘ ea) (fun _ _ => rfl)
  have hρa' : Continuous ρa' := continuous_pi fun k => continuous_apply (ea k)
  let ρb : (ιb → ℚ_[ℓ]) →+ (Fin (Fintype.card ιb) → ℚ_[ℓ]) :=
    AddMonoidHom.mk' (fun x => x ∘ eb.symm) (fun _ _ => rfl)
  have hρb : Continuous ρb := continuous_pi fun k => continuous_apply (eb.symm k)
  let ρa : (ιa → ℚ_[ℓ]) →+ (Fin (Fintype.card ιa) → ℚ_[ℓ]) :=
    AddMonoidHom.mk' (fun x => x ∘ ea.symm) (fun _ _ => rfl)
  have hρa : Continuous ρa := continuous_pi fun k => continuous_apply (ea.symm k)
  let φ₀ : (wcContSheaf S (Fin (Fintype.card ιa) → ℚ_[ℓ])).over V ⟶
      (wcContSheaf S (Fin (Fintype.card ιb) → ℚ_[ℓ])).over V :=
    ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap S ρa' hρa') ≫ φ ≫
      ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} V).map
        (wcContSheafMap S ρb hρb)
  obtain ⟨M₀, hM₀c, hM₀⟩ := hfin _ _ φ₀
  refine ⟨fun v i j => M₀ v (eb i) (ea j), fun i j => hM₀c (eb i) (ea j), ?_⟩
  intro T f t
  let F : (wcContSheaf S (Fin (Fintype.card ιa) → ℚ_[ℓ])).obj.obj (Opposite.op T.left) :=
    (show (wcContSheaf S (Fin (Fintype.card ιa) → ℚ_[ℓ])).obj.obj (Opposite.op T.left) from
      ULift.up (AddMonoidHom.compLeftContinuous (↥T.left.left) ρa hρa
        (show C(↥T.left.left, ιa → ℚ_[ℓ]) from f.down)))
  have h1 := hM₀ T F t
  have hFf : (show (wcContSheaf S (ιa → ℚ_[ℓ])).obj.obj (Opposite.op T.left) from
      ULift.up (AddMonoidHom.compLeftContinuous (↥T.left.left) ρa' hρa'
        (show C(↥T.left.left, Fin (Fintype.card ιa) → ℚ_[ℓ]) from F.down))) = f := by
    apply ULift.ext
    apply ContinuousMap.ext
    intro s
    funext k
    show (show C(↥T.left.left, ιa → ℚ_[ℓ]) from f.down) s (ea.symm (ea k)) =
      (show C(↥T.left.left, ιa → ℚ_[ℓ]) from f.down) s k
    rw [Equiv.symm_apply_apply]
  have key : ∀ k, (show C(↥T.left.left, Fin (Fintype.card ιb) → ℚ_[ℓ]) from
      ((φ₀.hom.app (Opposite.op T)).hom F).down) t k =
      (show C(↥T.left.left, ιb → ℚ_[ℓ]) from ((φ.hom.app (Opposite.op T)).hom f).down) t
        (eb.symm k) := by
    intro k
    exact congrArg (fun g => (show C(↥T.left.left, ιb → ℚ_[ℓ]) from
      ((φ.hom.app (Opposite.op T)).hom g).down) t (eb.symm k)) hFf
  funext i
  have h3 := congrFun h1 (eb i)
  rw [key, Equiv.symm_apply_apply] at h3
  refine h3.trans ?_
  show ∑ k, M₀ (T.hom.left t) (eb i) k *
      (show C(↥T.left.left, ιa → ℚ_[ℓ]) from f.down) t (ea.symm k) =
    ∑ j, M₀ (T.hom.left t) (eb i) (ea j) * (show C(↥T.left.left, ιa → ℚ_[ℓ]) from f.down) t j
  exact (Fintype.sum_equiv ea _ _ (fun j => by rw [Equiv.symm_apply_apply])).symm

theorem wc_tsh_cont_over_hom_of_matrix (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (V : S.ProEt)
    (ιa ιb : Type) [Fintype ιa] [DecidableEq ιa] [Fintype ιb] [DecidableEq ιb]
    (M : V.left → Matrix ιb ιa ℚ_[ℓ]) (hM : ∀ i j, Continuous fun v => M v i j) :
    ∃ φ : (wcContSheaf S (ιa → ℚ_[ℓ])).over V ⟶ (wcContSheaf S (ιb → ℚ_[ℓ])).over V,
      ∀ (T : Over V) (f : (wcContSheaf S (ιa → ℚ_[ℓ])).obj.obj (Opposite.op T.left)) (t : T.left.left),
        (show C(↥T.left.left, ιb → ℚ_[ℓ]) from ((φ.hom.app (Opposite.op T)).hom f).down) t =
          (M (T.hom.left t)).mulVec ((show C(↥T.left.left, ιa → ℚ_[ℓ]) from f.down) t) :=
by
  have hMc : Continuous M := continuous_matrix hM
  let Φ : ∀ T : Over V, (wcContSheaf S (ιa → ℚ_[ℓ])).obj.obj (Opposite.op T.left) →
      C(↥T.left.left, ιb → ℚ_[ℓ]) := fun T f =>
    ⟨fun t => (M (T.hom.left t)).mulVec ((show C(↥T.left.left, ιa → ℚ_[ℓ]) from f.down) t),
      Continuous.matrix_mulVec (hMc.comp T.hom.left.continuous)
        (show C(↥T.left.left, ιa → ℚ_[ℓ]) from f.down).continuous⟩
  have hadd : ∀ (T : Over V) (f f' : (wcContSheaf S (ιa → ℚ_[ℓ])).obj.obj (Opposite.op T.left)),
      Φ T (f + f') = Φ T f + Φ T f' := by
    intro T f f'
    exact ContinuousMap.ext (fun t => Matrix.mulVec_add _ _ _)
  have hnat : ∀ (T T' : Over V) (c : T' ⟶ T)
      (f : (wcContSheaf S (ιa → ℚ_[ℓ])).obj.obj (Opposite.op T.left)) (z : T'.left.left),
      Φ T' (((wcContSheaf S (ιa → ℚ_[ℓ])).obj.map c.left.op).hom f) z = Φ T f (c.left.left z) := by
    intro T T' c f z
    have hw : T'.hom.left z = T.hom.left (c.left.left z) := by
      rw [← Over.w c]
      rfl
    show (M (T'.hom.left z)).mulVec _ = (M (T.hom.left (c.left.left z))).mulVec _
    rw [hw]
    rfl
  refine ⟨ObjectProperty.homMk
    ({ app := fun T => AddCommGrpCat.ofHom
          (AddMonoidHom.mk'
            (fun f : (wcContSheaf S (ιa → ℚ_[ℓ])).obj.obj (Opposite.op T.unop.left) =>
              (ULift.up (Φ T.unop f) : ULift.{u+1} C(↥T.unop.left.left, ιb → ℚ_[ℓ])))
            (fun f f' => congrArg ULift.up (hadd T.unop f f')))
       naturality := fun X Y g => by
         ext f
         apply ULift.ext
         exact ContinuousMap.ext (fun z => hnat X.unop Y.unop g.unop f z) } :
      ((wcContSheaf S (ιa → ℚ_[ℓ])).over V).obj ⟶ ((wcContSheaf S (ιb → ℚ_[ℓ])).over V).obj), ?_⟩
  intro T f t
  rfl

theorem wc_tsh_over_hom_transport (S : Scheme.{u})
    (A B C D : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt)
    (θA : A.over W ≅ C.over W) (θB : B.over W ≅ D.over W) :
    (∀ (U : Over W) (φ : A.over U.left ⟶ B.over U.left),
      ∃ Ψ : C.over U.left ⟶ D.over U.left,
        ∀ (Y : Over U.left) (g : Y.left ⟶ W), Y.hom ≫ U.hom = g →
          ∀ a : A.obj.obj (Opposite.op Y.left),
            (Ψ.hom.app (Opposite.op Y)).hom ((θA.hom.hom.app (Opposite.op (Over.mk g))).hom a) =
              (θB.hom.hom.app (Opposite.op (Over.mk g))).hom ((φ.hom.app (Opposite.op Y)).hom a)) ∧
    (∀ (U : Over W) (Ψ : C.over U.left ⟶ D.over U.left),
      ∃ φ : A.over U.left ⟶ B.over U.left,
        ∀ (Y : Over U.left) (g : Y.left ⟶ W), Y.hom ≫ U.hom = g →
          ∀ a : A.obj.obj (Opposite.op Y.left),
            (Ψ.hom.app (Opposite.op Y)).hom ((θA.hom.hom.app (Opposite.op (Over.mk g))).hom a) =
              (θB.hom.hom.app (Opposite.op (Over.mk g))).hom ((φ.hom.app (Opposite.op Y)).hom a)) :=
by
  refine ⟨fun U φ => ?_, fun U Ψ => ?_⟩
  · let Ψ' : (C.over U.left).obj ⟶ (D.over U.left).obj :=
      Functor.whiskerLeft (Over.map U.hom).op θA.inv.hom ≫ φ.hom ≫
        Functor.whiskerLeft (Over.map U.hom).op θB.hom.hom
    refine ⟨ObjectProperty.homMk Ψ', ?_⟩
    intro Y g hg a
    subst hg
    have h2 : (θA.inv.hom.app (Opposite.op (Over.mk (Y.hom ≫ U.hom)))).hom
        ((θA.hom.hom.app (Opposite.op (Over.mk (Y.hom ≫ U.hom)))).hom a) = a :=
      congrArg (fun ψ => (ψ.hom.app (Opposite.op (Over.mk (Y.hom ≫ U.hom)))).hom a) θA.hom_inv_id
    exact congrArg (fun y => (θB.hom.hom.app (Opposite.op (Over.mk (Y.hom ≫ U.hom)))).hom
      ((φ.hom.app (Opposite.op Y)).hom y)) h2
  · let φ' : (A.over U.left).obj ⟶ (B.over U.left).obj :=
      Functor.whiskerLeft (Over.map U.hom).op θA.hom.hom ≫ Ψ.hom ≫
        Functor.whiskerLeft (Over.map U.hom).op θB.inv.hom
    refine ⟨ObjectProperty.homMk φ', ?_⟩
    intro Y g hg a
    subst hg
    have h3 := congrArg (fun ψ => (ψ.hom.app (Opposite.op (Over.mk (Y.hom ≫ U.hom)))).hom
      ((Ψ.hom.app (Opposite.op Y)).hom
        ((θA.hom.hom.app (Opposite.op (Over.mk (Y.hom ≫ U.hom)))).hom a))) θB.inv_hom_id
    exact h3.symm

theorem wc_tsh_iso_of_bij_family (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt)
    (ι : Type) [Fintype ι] [DecidableEq ι]
    (F : ∀ U : Over W, H.obj.obj (Opposite.op U.left) → C(↥U.left.left, ι → ℚ_[ℓ]))
    (hadd : ∀ (U : Over W) (s s' : H.obj.obj (Opposite.op U.left)), F U (s + s') = F U s + F U s')
    (hnat : ∀ (U U' : Over W) (c : U' ⟶ U) (s : H.obj.obj (Opposite.op U.left)) (z : U'.left.left),
      F U' ((H.obj.map c.left.op).hom s) z = F U s (c.left.left z))
    (hbij : ∀ U : Over W, Function.Bijective (F U)) :
    ∃ θ : H.over W ≅ (wcContSheaf S (ι → ℚ_[ℓ])).over W,
      ∀ (U : Over W) (s : H.obj.obj (Opposite.op U.left)) (z : U.left.left),
        (show C(↥U.left.left, ι → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op U)).hom s).down) z = F U s z :=
by
  classical
  let φ : H.over W ⟶ (wcContSheaf S (ι → ℚ_[ℓ])).over W := ObjectProperty.homMk
    ({ app := fun T => AddCommGrpCat.ofHom
          (AddMonoidHom.mk'
            (fun s : H.obj.obj (Opposite.op T.unop.left) =>
              (ULift.up (F T.unop s) : ULift.{u+1} C(↥T.unop.left.left, ι → ℚ_[ℓ])))
            (fun s s' => congrArg ULift.up (hadd T.unop s s')))
       naturality := fun X Y g => by
          ext s
          apply ULift.ext
          exact ContinuousMap.ext (fun z => hnat X.unop Y.unop g.unop s z) } :
      (H.over W).obj ⟶ ((wcContSheaf S (ι → ℚ_[ℓ])).over W).obj)
  have hc : ∀ X, IsIso (φ.hom.app X) := by
    intro X
    have hb : Function.Bijective ((forget AddCommGrpCat).map (φ.hom.app X)) := by
      constructor
      · intro a b hab
        apply (hbij X.unop).1
        exact congrArg ULift.down hab
      · intro y
        obtain ⟨s, hs⟩ := (hbij X.unop).2 y.down
        exact ⟨s, ULift.ext _ _ hs⟩
    have : IsIso ((forget AddCommGrpCat).map (φ.hom.app X)) := (isIso_iff_bijective _).mpr hb
    exact isIso_of_reflects_iso _ (forget AddCommGrpCat)
  have : IsIso ((sheafToPresheaf _ AddCommGrpCat.{u+1}).map φ) :=
    @NatIso.isIso_of_isIso_app _ _ _ _ _ _ _ hc
  haveI : IsIso φ := isIso_of_reflects_iso _ (sheafToPresheaf _ AddCommGrpCat.{u+1})
  exact ⟨asIso φ, fun U s z => rfl⟩

theorem wc_tsh_matchar_unique (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt)
    (ιa ιb : Type) [Fintype ιa] [DecidableEq ιa] [Fintype ιb] [DecidableEq ιb]
    (θA : A.over W ≅ (wcContSheaf S (ιa → ℚ_[ℓ])).over W)
    (θB : B.over W ≅ (wcContSheaf S (ιb → ℚ_[ℓ])).over W) :
    (∀ (U : Over W) (φ : A.over U.left ⟶ B.over U.left) (M M' : U.left.left → Matrix ιb ιa ℚ_[ℓ]),
      wcHomMatChar S ℓ A B W ιa ιb θA θB U φ M → wcHomMatChar S ℓ A B W ιa ιb θA θB U φ M' → M = M') ∧
    (∀ (U : Over W) (φ φ' : A.over U.left ⟶ B.over U.left) (M : U.left.left → Matrix ιb ιa ℚ_[ℓ]),
      wcHomMatChar S ℓ A B W ιa ιb θA θB U φ M → wcHomMatChar S ℓ A B W ιa ιb θA θB U φ' M → φ = φ') :=
by
  refine ⟨?_, ?_⟩
  · intro U φ M M' hM hM'
    funext t
    apply Matrix.ext_of_mulVec_single
    intro j
    let c : (wcContSheaf S (ιa → ℚ_[ℓ])).obj.obj (Opposite.op U.left) :=
      ULift.up (ContinuousMap.const U.left.left (Pi.single j 1))
    let Y : Over U.left := Over.mk (𝟙 U.left)
    let a : A.obj.obj (Opposite.op U.left) :=
      (θA.inv.hom.app (Opposite.op (Over.mk U.hom))).hom c
    have ha : (θA.hom.hom.app (Opposite.op (Over.mk U.hom))).hom
        ((θA.inv.hom.app (Opposite.op (Over.mk U.hom))).hom c) = c :=
      congrArg (fun f => (f.hom.app (Opposite.op (Over.mk U.hom))).hom c) θA.inv_hom_id
    have key : ∀ N : U.left.left → Matrix ιb ιa ℚ_[ℓ],
        wcHomMatChar S ℓ A B W ιa ιb θA θB U φ N →
        (show C(↥U.left.left, ιb → ℚ_[ℓ]) from
          ((θB.hom.hom.app (Opposite.op (Over.mk U.hom))).hom
            ((φ.hom.app (Opposite.op Y)).hom a)).down) t = (N t).mulVec (Pi.single j 1) := by
      intro N hN
      have h := hN Y U.hom (Category.id_comp _) a t
      refine h.trans ?_
      exact congrArg (fun v => (N t).mulVec v)
        (congrArg (fun y : (wcContSheaf S (ιa → ℚ_[ℓ])).obj.obj (Opposite.op U.left) =>
          (show C(↥U.left.left, ιa → ℚ_[ℓ]) from y.down) t) ha)
    exact (key M hM).symm.trans (key M' hM')
  · intro U φ φ' M hM hM'
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext Yop
    rcases Yop with ⟨Y⟩
    apply AddCommGrpCat.ext
    intro a
    have key : (θB.hom.hom.app (Opposite.op (Over.mk (Y.hom ≫ U.hom)))).hom
          ((φ.hom.app (Opposite.op Y)).hom a) =
        (θB.hom.hom.app (Opposite.op (Over.mk (Y.hom ≫ U.hom)))).hom
          ((φ'.hom.app (Opposite.op Y)).hom a) := by
      apply ULift.ext
      apply ContinuousMap.ext
      intro t
      exact (hM Y _ rfl a t).trans (hM' Y _ rfl a t).symm
    have hl : ∀ x : B.obj.obj (Opposite.op Y.left),
        (θB.inv.hom.app (Opposite.op (Over.mk (Y.hom ≫ U.hom)))).hom
          ((θB.hom.hom.app (Opposite.op (Over.mk (Y.hom ≫ U.hom)))).hom x) = x := fun x =>
      congrArg (fun f => (f.hom.app (Opposite.op (Over.mk (Y.hom ≫ U.hom)))).hom x) θB.hom_inv_id
    exact (hl ((φ.hom.app (Opposite.op Y)).hom a)).symm.trans
      ((congrArg (θB.inv.hom.app (Opposite.op (Over.mk (Y.hom ≫ U.hom)))).hom key).trans
        (hl ((φ'.hom.app (Opposite.op Y)).hom a)))

theorem wc_tsh_matchar_ops (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt)
    (ιa ιb : Type) [Fintype ιa] [DecidableEq ιa] [Fintype ιb] [DecidableEq ιb]
    (θA : A.over W ≅ (wcContSheaf S (ιa → ℚ_[ℓ])).over W)
    (θB : B.over W ≅ (wcContSheaf S (ιb → ℚ_[ℓ])).over W) :
    (∀ (U : Over W) (φ φ' : A.over U.left ⟶ B.over U.left) (M M' : U.left.left → Matrix ιb ιa ℚ_[ℓ]),
      wcHomMatChar S ℓ A B W ιa ιb θA θB U φ M → wcHomMatChar S ℓ A B W ιa ιb θA θB U φ' M' →
        wcHomMatChar S ℓ A B W ιa ιb θA θB U (φ + φ') (fun t => M t + M' t)) ∧
    (∀ (U U' : Over W) (c : U' ⟶ U) (φ : A.over U.left ⟶ B.over U.left)
      (φ' : A.over U'.left ⟶ B.over U'.left),
      (∀ (Y : Over U'.left) (a : A.obj.obj (Opposite.op Y.left)),
        (φ'.hom.app (Opposite.op Y)).hom a = (φ.hom.app (Opposite.op ((Over.map c.left).obj Y))).hom a) →
      ∀ M : U.left.left → Matrix ιb ιa ℚ_[ℓ],
        wcHomMatChar S ℓ A B W ιa ιb θA θB U φ M →
          wcHomMatChar S ℓ A B W ιa ιb θA θB U' φ' (fun t => M (c.left.left t))) ∧
    (∀ (β : B ⟶ B) (c : ℚ_[ℓ]),
      ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map β ≫ θB.hom =
        θB.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
          (wcContSheafMap S (DistribSMul.toAddMonoidHom (ιb → ℚ_[ℓ]) c) (continuous_const_smul c)) →
      ∀ (U : Over W) (φ : A.over U.left ⟶ B.over U.left) (M : U.left.left → Matrix ιb ιa ℚ_[ℓ]),
        wcHomMatChar S ℓ A B W ιa ιb θA θB U φ M →
          wcHomMatChar S ℓ A B W ιa ιb θA θB U
            (φ ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U.left).map β)
            (fun t => c • M t)) :=
by
  refine ⟨?_, ?_, ?_⟩
  · intro U φ φ' M M' hM hM' Y g hg a t
    have h1 := hM Y g hg a t
    have h2 := hM' Y g hg a t
    have e : ((φ + φ').hom.app (Opposite.op Y)).hom a =
        (φ.hom.app (Opposite.op Y)).hom a + (φ'.hom.app (Opposite.op Y)).hom a := rfl
    have e2 := (congrArg (fun b => (show C(↥Y.left.left, ιb → ℚ_[ℓ]) from
      ((θB.hom.hom.app (Opposite.op (Over.mk g))).hom b).down) t) e)
    have e3 := (congrArg (fun b => (show C(↥Y.left.left, ιb → ℚ_[ℓ]) from b.down) t)
      (map_add (θB.hom.hom.app (Opposite.op (Over.mk g))).hom
        ((φ.hom.app (Opposite.op Y)).hom a) ((φ'.hom.app (Opposite.op Y)).hom a)))
    refine (e2.trans e3).trans ?_
    exact (congrArg₂ (· + ·) h1 h2).trans (Matrix.add_mulVec _ _ _).symm
  · intro U U' c φ φ' hφ M hM Y g hg a t
    have hg' : ((Over.map c.left).obj Y).hom ≫ U.hom = g := by
      rw [Over.map_obj_hom, Category.assoc, Over.w c]; exact hg
    rw [hφ Y a]
    exact hM ((Over.map c.left).obj Y) g hg' a t
  · intro β c hβ U φ M hM Y g hg a t
    have h1 := congrArg (fun F => (show C(↥Y.left.left, ιb → ℚ_[ℓ]) from
      ((F.hom.app (Opposite.op (Over.mk g))).hom ((φ.hom.app (Opposite.op Y)).hom a)).down) t) hβ
    have h2 := hM Y g hg a t
    refine h1.trans ?_
    change c • ((show C(↥Y.left.left, ιb → ℚ_[ℓ]) from
        ((θB.hom.hom.app (Opposite.op (Over.mk g))).hom ((φ.hom.app (Opposite.op Y)).hom a)).down) t) = _
    rw [h2]
    exact (Matrix.smul_mulVec _ _ _).symm

theorem wc_tsh_matchar_frame (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (A B : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt)
    (ιa ιb : Type) [Fintype ιa] [DecidableEq ιa] [Fintype ιb] [DecidableEq ιb]
    (θA : A.over W ≅ (wcContSheaf S (ιa → ℚ_[ℓ])).over W)
    (θB : B.over W ≅ (wcContSheaf S (ιb → ℚ_[ℓ])).over W)
    (γ : W ⟶ W) (g g' : Matrix ιa ιa ℚ_[ℓ]) (h : Matrix ιb ιb ℚ_[ℓ]) (hg : g' * g = 1)
    (hA : ∀ (V : S.ProEt) (f : V ⟶ W) (s : A.obj.obj (Opposite.op V)) (z : V.left),
      (show C(↥V.left, ιa → ℚ_[ℓ]) from
        ((θA.hom.hom.app (Opposite.op (Over.mk (f ≫ γ)))).hom s).down) z =
      g.mulVec ((show C(↥V.left, ιa → ℚ_[ℓ]) from
        ((θA.hom.hom.app (Opposite.op (Over.mk f))).hom s).down) z))
    (hB : ∀ (V : S.ProEt) (f : V ⟶ W) (s : B.obj.obj (Opposite.op V)) (z : V.left),
      (show C(↥V.left, ιb → ℚ_[ℓ]) from
        ((θB.hom.hom.app (Opposite.op (Over.mk (f ≫ γ)))).hom s).down) z =
      h.mulVec ((show C(↥V.left, ιb → ℚ_[ℓ]) from
        ((θB.hom.hom.app (Opposite.op (Over.mk f))).hom s).down) z))
    (V : S.ProEt) (f : V ⟶ W) (φ : A.over V ⟶ B.over V) (M : V.left → Matrix ιb ιa ℚ_[ℓ])
    (hM : wcHomMatChar S ℓ A B W ιa ιb θA θB (Over.mk f) φ M) :
    wcHomMatChar S ℓ A B W ιa ιb θA θB (Over.mk (f ≫ γ)) φ (fun t => h * M t * g') :=
by
  intro Y g₀ hg₀ a t
  have hg₁ : g₀ = (Y.hom ≫ f) ≫ γ := hg₀.symm.trans (Category.assoc Y.hom f γ).symm
  subst hg₁
  have hb := hB Y.left (Y.hom ≫ f) ((φ.hom.app (Opposite.op Y)).hom a) t
  have hm := hM Y (Y.hom ≫ f) rfl a t
  have ha := hA Y.left (Y.hom ≫ f) a t
  refine hb.trans ((congrArg h.mulVec hm).trans ?_)
  refine Eq.trans ?_ (congrArg (h * M (Y.hom.left t) * g').mulVec ha).symm
  rw [Matrix.mulVec_mulVec, Matrix.mulVec_mulVec, Matrix.mul_assoc (h * M (Y.hom.left t)) g' g,
    hg, Matrix.mul_one]

theorem wc_tsh_hom_sheaf_triv (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (A B H : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt)
    (ιa ιb : Type) [Fintype ιa] [DecidableEq ιa] [Fintype ιb] [DecidableEq ιb]
    (θA : A.over W ≅ (wcContSheaf S (ιa → ℚ_[ℓ])).over W)
    (θB : B.over W ≅ (wcContSheaf S (ιb → ℚ_[ℓ])).over W)
    (e : ∀ T : S.ProEt, H.obj.obj (Opposite.op T) ≃+ (A.over T ⟶ B.over T))
    (he : ∀ (T T' : S.ProEt) (a : T' ⟶ T) (x : H.obj.obj (Opposite.op T)) (U : Over T'),
      (e T' ((H.obj.map a.op).hom x)).hom.app (Opposite.op U) =
        (e T x).hom.app (Opposite.op ((Over.map a).obj U)))
    (post : (B ⟶ B) → (H ⟶ H))
    (hpost : ∀ (β : B ⟶ B) (T : S.ProEt) (x : H.obj.obj (Opposite.op T)),
      e T (((post β).hom.app (Opposite.op T)).hom x) =
        e T x ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} T).map β) :
    ∃ θH : H.over W ≅ (wcContSheaf S (ιb × ιa → ℚ_[ℓ])).over W,
      (∀ (β : B ⟶ B) (c : ℚ_[ℓ]),
        ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map β ≫ θB.hom =
          θB.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
            (wcContSheafMap S (DistribSMul.toAddMonoidHom (ιb → ℚ_[ℓ]) c) (continuous_const_smul c)) →
        ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map (post β) ≫ θH.hom =
          θH.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
            (wcContSheafMap S (DistribSMul.toAddMonoidHom (ιb × ιa → ℚ_[ℓ]) c)
              (continuous_const_smul c))) ∧
      ∀ (γ : W ⟶ W) (g g' : Matrix ιa ιa ℚ_[ℓ]) (h : Matrix ιb ιb ℚ_[ℓ]), g * g' = 1 → g' * g = 1 →
        (∀ (V : S.ProEt) (f : V ⟶ W) (s : A.obj.obj (Opposite.op V)) (z : V.left),
          (show C(↥V.left, ιa → ℚ_[ℓ]) from
            ((θA.hom.hom.app (Opposite.op (Over.mk (f ≫ γ)))).hom s).down) z =
          g.mulVec ((show C(↥V.left, ιa → ℚ_[ℓ]) from
            ((θA.hom.hom.app (Opposite.op (Over.mk f))).hom s).down) z)) →
        (∀ (V : S.ProEt) (f : V ⟶ W) (s : B.obj.obj (Opposite.op V)) (z : V.left),
          (show C(↥V.left, ιb → ℚ_[ℓ]) from
            ((θB.hom.hom.app (Opposite.op (Over.mk (f ≫ γ)))).hom s).down) z =
          h.mulVec ((show C(↥V.left, ιb → ℚ_[ℓ]) from
            ((θB.hom.hom.app (Opposite.op (Over.mk f))).hom s).down) z)) →
        ∀ (V : S.ProEt) (f : V ⟶ W) (s : H.obj.obj (Opposite.op V)) (z : V.left),
          (show C(↥V.left, ιb × ιa → ℚ_[ℓ]) from
            ((θH.hom.hom.app (Opposite.op (Over.mk (f ≫ γ)))).hom s).down) z =
          (Matrix.of fun (x y : ιb × ιa) => h x.1 y.1 * g' y.2 x.2).mulVec
            ((show C(↥V.left, ιb × ιa → ℚ_[ℓ]) from
              ((θH.hom.hom.app (Opposite.op (Over.mk f))).hom s).down) z) :=
by
  classical
  obtain ⟨hU1, hU2⟩ := wc_tsh_matchar_unique S ℓ A B W ιa ιb θA θB
  obtain ⟨hOadd, hOres, hOpost⟩ := wc_tsh_matchar_ops S ℓ A B W ιa ιb θA θB
  obtain ⟨hT1, hT2⟩ := wc_tsh_over_hom_transport S A B (wcContSheaf S (ιa → ℚ_[ℓ]))
    (wcContSheaf S (ιb → ℚ_[ℓ])) W θA θB

  have G1 : ∀ (U : Over W) (x : H.obj.obj (Opposite.op U.left)),
      ∃ M : U.left.left → Matrix ιb ιa ℚ_[ℓ], (∀ i j, Continuous fun v => M v i j) ∧
        wcHomMatChar S ℓ A B W ιa ιb θA θB U (e U.left x) M := by
    intro U x
    obtain ⟨Ψ, hΨ⟩ := hT1 U (e U.left x)
    obtain ⟨M, hMc, hM⟩ := wc_tsh_cont_over_hom_rigid S ℓ U.left ιa ιb Ψ
    refine ⟨M, hMc, ?_⟩
    intro Y g hg a t
    rw [← hΨ Y g hg a]
    exact hM Y _ t
  choose Mx hMxc hMx using G1

  let F : ∀ U : Over W, H.obj.obj (Opposite.op U.left) → C(↥U.left.left, ιb × ιa → ℚ_[ℓ]) :=
    fun U x => ⟨fun t q => Mx U x t q.1 q.2, continuous_pi (fun q => hMxc U x q.1 q.2)⟩

  have hadd : ∀ (U : Over W) (s s' : H.obj.obj (Opposite.op U.left)),
      F U (s + s') = F U s + F U s' := by
    intro U s s'
    have h1 : wcHomMatChar S ℓ A B W ιa ιb θA θB U (e U.left (s + s'))
        (fun t => Mx U s t + Mx U s' t) := by
      rw [map_add]
      exact hOadd U _ _ _ _ (hMx U s) (hMx U s')
    have h2 := hU1 U _ _ _ (hMx U (s + s')) h1
    ext t q
    exact congrFun (congrFun (congrFun h2 t) q.1) q.2

  have hnat : ∀ (U U' : Over W) (c : U' ⟶ U) (s : H.obj.obj (Opposite.op U.left))
      (z : U'.left.left), F U' ((H.obj.map c.left.op).hom s) z = F U s (c.left.left z) := by
    intro U U' c s z
    have h1 := hOres U U' c (e U.left s) (e U'.left ((H.obj.map c.left.op).hom s))
      (fun Y a => congrArg (fun m => AddCommGrpCat.Hom.hom m a) (he U.left U'.left c.left s Y))
      (Mx U s) (hMx U s)
    have h2 := hU1 U' _ _ _ (hMx U' _) h1
    funext q
    exact congrFun (congrFun (congrFun h2 z) q.1) q.2

  have hbij : ∀ U : Over W, Function.Bijective (F U) := by
    intro U
    constructor
    · intro x x' hxx'
      have hM : Mx U x = Mx U x' := by
        funext t i j
        exact congrArg (fun G : C(↥U.left.left, ιb × ιa → ℚ_[ℓ]) => G t (i, j)) hxx'
      have hx' : wcHomMatChar S ℓ A B W ιa ιb θA θB U (e U.left x') (Mx U x) := by
        rw [hM]; exact hMx U x'
      exact (e U.left).injective (hU2 U _ _ _ (hMx U x) hx')
    · intro G
      let M : U.left.left → Matrix ιb ιa ℚ_[ℓ] := fun t i j => G t (i, j)
      have hMc : ∀ i j, Continuous fun v => M v i j := fun i j =>
        (continuous_apply (i, j)).comp G.continuous
      obtain ⟨Ψ, hΨ⟩ := wc_tsh_cont_over_hom_of_matrix S ℓ U.left ιa ιb M hMc
      obtain ⟨φ, hφ⟩ := hT2 U Ψ
      have hchar : wcHomMatChar S ℓ A B W ιa ιb θA θB U φ M := by
        intro Y g hg a t
        rw [← hφ Y g hg a]
        exact hΨ Y _ t
      refine ⟨(e U.left).symm φ, ?_⟩
      have h1 : wcHomMatChar S ℓ A B W ιa ιb θA θB U (e U.left ((e U.left).symm φ)) M := by
        rw [AddEquiv.apply_symm_apply]; exact hchar
      have h2 := hU1 U _ _ _ (hMx U _) h1
      ext t q
      exact congrFun (congrFun (congrFun h2 t) q.1) q.2

  obtain ⟨θH, hθH⟩ := wc_tsh_iso_of_bij_family S ℓ H W (ιb × ιa) F hadd hnat hbij
  refine ⟨θH, ?_, ?_⟩

  · intro β c hβ
    have keyP : ∀ (U : Over W) (x : H.obj.obj (Opposite.op U.left)),
        Mx U (((post β).hom.app (Opposite.op U.left)).hom x) = fun t => c • Mx U x t := by
      intro U x
      have h1 : wcHomMatChar S ℓ A B W ιa ιb θA θB U
          (e U.left (((post β).hom.app (Opposite.op U.left)).hom x)) (fun t => c • Mx U x t) := by
        rw [hpost β U.left x]
        exact hOpost β c hβ U _ _ (hMx U x)
      exact hU1 U _ _ _ (hMx U _) h1
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    rcases U with ⟨U⟩
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    apply ContinuousMap.ext
    intro z
    funext q
    change (show C(↥U.left.left, ιb × ιa → ℚ_[ℓ]) from ((θH.hom.hom.app (Opposite.op U)).hom
        (((post β).hom.app (Opposite.op U.left)).hom x)).down) z q =
      c • ((show C(↥U.left.left, ιb × ιa → ℚ_[ℓ]) from
        ((θH.hom.hom.app (Opposite.op U)).hom x).down) z q)
    rw [hθH U _ z, hθH U x z]
    exact congrFun (congrFun (congrFun (keyP U x) z) q.1) q.2

  · intro γ g g' h _hgg' hg'g hA hB V f s z
    have h1 := wc_tsh_matchar_frame S ℓ A B W ιa ιb θA θB γ g g' h hg'g hA hB V f (e V s)
      (Mx (Over.mk f) s) (hMx (Over.mk f) s)
    have h2 := hU1 (Over.mk (f ≫ γ)) _ _ _ (hMx (Over.mk (f ≫ γ)) s) h1
    have kron : ∀ N : Matrix ιb ιa ℚ_[ℓ],
        (Matrix.of fun (x y : ιb × ιa) => h x.1 y.1 * g' y.2 x.2).mulVec
          (fun q : ιb × ιa => N q.1 q.2) = fun q : ιb × ιa => (h * N * g') q.1 q.2 := by
      intro N
      funext q
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Matrix.mul_apply,
        Fintype.sum_prod_type, Finset.sum_mul]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl (fun _ _ => Finset.sum_congr rfl (fun _ _ => by ring))
    have e1 := hθH (Over.mk (f ≫ γ)) s z
    have e2 := hθH (Over.mk f) s z
    have e3 : F (Over.mk (f ≫ γ)) s z =
        fun q : ιb × ιa => (h * Mx (Over.mk f) s z * g') q.1 q.2 := by
      funext q
      exact congrFun (congrFun (congrFun h2 z) q.1) q.2
    refine e1.trans (Eq.trans ?_ (congrArg (fun v =>
      (Matrix.of fun (x y : ιb × ιa) => h x.1 y.1 * g' y.2 x.2).mulVec v) e2.symm))
    exact e3.trans (kron _).symm

theorem wc_tsh_frame_upgrade (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt) (hW : ConnectedSpace W.left)
    (k : ℕ) (θ : G.over W ≅ (wcContSheaf S (Fin k → ℚ_[ℓ])).over W) (γ : W ⟶ W)
    (M : Matrix (Fin k) (Fin k) ℚ_[ℓ])
    (hM : ∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
      (show C(↥W.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
        M.mulVec ((show C(↥W.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) :
    (∀ (V : S.ProEt) (f : V ⟶ W) (s : G.obj.obj (Opposite.op V)) (z : V.left),
      (show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk (f ≫ γ)))).hom s).down) z =
        M.mulVec ((show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk f))).hom s).down) z)) ∧
    ∃ M' : Matrix (Fin k) (Fin k) ℚ_[ℓ], M * M' = 1 ∧ M' * M = 1 :=
by
  classical
  obtain ⟨A, hA⟩ := wc_proet_deck_frame_linear S ℓ G W hW k θ γ
  have hconst : ∀ (f : W ⟶ W) (v : Fin k → ℚ_[ℓ]), ∃ s : G.obj.obj (Opposite.op W),
      ∀ z : W.left, (show C(↥W.left, Fin k → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk f))).hom s).down) z = v := by
    intro f v
    let t : ((wcContSheaf S (Fin k → ℚ_[ℓ])).over W).obj.obj (Opposite.op (Over.mk f)) :=
      ULift.up (ContinuousMap.const _ v)
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk f))).hom t, fun z => ?_⟩
    have h2 : (θ.hom.hom.app (Opposite.op (Over.mk f))).hom
        ((θ.inv.hom.app (Opposite.op (Over.mk f))).hom t) = t :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk f))).hom t) θ.inv_hom_id
    exact (congrArg (fun y => (show C(↥W.left, Fin k → ℚ_[ℓ]) from y.down) z) h2).trans rfl
  obtain ⟨z₀⟩ := hW.toNonempty
  have key : ∀ v, A v = M.mulVec v := by
    intro v
    obtain ⟨s, hs⟩ := hconst (𝟙 W) v
    have e1 := hA W (𝟙 W) γ (Category.id_comp γ).symm s z₀
    have e2 := hM s z₀
    rw [← hs z₀]
    exact e1.symm.trans e2
  refine ⟨fun V f s z => (hA V f (f ≫ γ) rfl s z).trans (key _), ?_⟩
  have hsurj : Function.Surjective M.mulVec := by
    intro v
    obtain ⟨s, hs⟩ := hconst γ v
    exact ⟨_, (hM s z₀).symm.trans (hs z₀)⟩
  have hU : IsUnit M := Matrix.mulVec_surjective_iff_isUnit.mp hsurj
  have hd : IsUnit M.det := (Matrix.isUnit_iff_isUnit_det M).mp hU
  exact ⟨M⁻¹, Matrix.mul_nonsing_inv M hd, Matrix.nonsing_inv_mul M hd⟩

theorem wc_tsh_reindex (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt)
    (ι ι' : Type) [Fintype ι] [DecidableEq ι] [Fintype ι'] [DecidableEq ι'] (eq : ι ≃ ι')
    (θ : G.over W ≅ (wcContSheaf S (ι → ℚ_[ℓ])).over W) :
    ∃ θ' : G.over W ≅ (wcContSheaf S (ι' → ℚ_[ℓ])).over W,
      (∀ (β : G ⟶ G) (c : ℚ_[ℓ]),
        ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map β ≫ θ.hom =
          θ.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
            (wcContSheafMap S (DistribSMul.toAddMonoidHom (ι → ℚ_[ℓ]) c) (continuous_const_smul c)) →
        ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map β ≫ θ'.hom =
          θ'.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
            (wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) c) (continuous_const_smul c))) ∧
      ∀ (γ : W ⟶ W) (X : Matrix ι ι ℚ_[ℓ]),
        (∀ (V : S.ProEt) (f : V ⟶ W) (s : G.obj.obj (Opposite.op V)) (z : V.left),
          (show C(↥V.left, ι → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk (f ≫ γ)))).hom s).down) z =
            X.mulVec ((show C(↥V.left, ι → ℚ_[ℓ]) from
              ((θ.hom.hom.app (Opposite.op (Over.mk f))).hom s).down) z)) →
        ∀ (V : S.ProEt) (f : V ⟶ W) (s : G.obj.obj (Opposite.op V)) (z : V.left),
          (show C(↥V.left, ι' → ℚ_[ℓ]) from ((θ'.hom.hom.app (Opposite.op (Over.mk (f ≫ γ)))).hom s).down) z =
            (Matrix.of fun (q q' : ι') => X (eq.symm q) (eq.symm q')).mulVec
              ((show C(↥V.left, ι' → ℚ_[ℓ]) from
                ((θ'.hom.hom.app (Opposite.op (Over.mk f))).hom s).down) z) :=
by
  classical
  let φ : (ι → ℚ_[ℓ]) →+ (ι' → ℚ_[ℓ]) :=
    { toFun := fun v q => v (eq.symm q), map_zero' := rfl, map_add' := fun _ _ => rfl }
  let ψ : (ι' → ℚ_[ℓ]) →+ (ι → ℚ_[ℓ]) :=
    { toFun := fun w i => w (eq i), map_zero' := rfl, map_add' := fun _ _ => rfl }
  have hφ : Continuous φ := continuous_pi (fun q => continuous_apply (eq.symm q))
  have hψ : Continuous ψ := continuous_pi (fun i => continuous_apply (eq i))
  let ρ : wcContSheaf S (ι → ℚ_[ℓ]) ≅ wcContSheaf S (ι' → ℚ_[ℓ]) :=
    { hom := wcContSheafMap S φ hφ
      inv := wcContSheafMap S ψ hψ
      hom_inv_id := by
        apply Sheaf.hom_ext
        apply NatTrans.ext
        funext U
        apply AddCommGrpCat.ext
        intro x
        apply ULift.ext
        apply ContinuousMap.ext
        intro a
        funext i
        exact congrArg (fun j => (show C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
          (Opposite.unop U)), ι → ℚ_[ℓ]) from x.down) a j) (eq.symm_apply_apply i)
      inv_hom_id := by
        apply Sheaf.hom_ext
        apply NatTrans.ext
        funext U
        apply AddCommGrpCat.ext
        intro x
        apply ULift.ext
        apply ContinuousMap.ext
        intro a
        funext q
        exact congrArg (fun j => (show C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj
          (Opposite.unop U)), ι' → ℚ_[ℓ]) from x.down) a j) (eq.apply_symm_apply q) }
  have hs : ∀ c : ℚ_[ℓ],
      wcContSheafMap S (DistribSMul.toAddMonoidHom (ι → ℚ_[ℓ]) c) (continuous_const_smul c) ≫
          ρ.hom =
        ρ.hom ≫
          wcContSheafMap S (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) c) (continuous_const_smul c) := by
    intro c
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext U
    apply AddCommGrpCat.ext
    intro x
    apply ULift.ext
    apply ContinuousMap.ext
    intro a
    funext q
    rfl
  refine ⟨θ ≪≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).mapIso ρ, ?_, ?_⟩
  · intro β c h
    rw [Iso.trans_hom, Functor.mapIso_hom, ← Category.assoc, h, Category.assoc,
      ← Functor.map_comp, hs c, Functor.map_comp, Category.assoc]
  · intro γ X hX V f s z
    have hA : (show C(↥V.left, ι' → ℚ_[ℓ]) from
        (((θ ≪≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).mapIso ρ).hom.hom.app
          (Opposite.op (Over.mk (f ≫ γ)))).hom s).down) z =
        fun q => (show C(↥V.left, ι → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (f ≫ γ)))).hom s).down) z (eq.symm q) := rfl
    have hB : (show C(↥V.left, ι' → ℚ_[ℓ]) from
        (((θ ≪≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).mapIso ρ).hom.hom.app
          (Opposite.op (Over.mk f))).hom s).down) z =
        fun q => (show C(↥V.left, ι → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk f))).hom s).down) z (eq.symm q) := rfl
    rw [hA, hB, hX V f s z]
    funext q
    simp only [Matrix.mulVec, dotProduct, Matrix.of_apply]
    exact (Equiv.sum_comp eq.symm _).symm

theorem wc_tsh_tensor_power_triv (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (R : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (W : S.ProEt)
    (hW : ConnectedSpace W.left) (r : ℕ)
    (θ : R.over W ≅ (wcContSheaf S (Fin r → ℚ_[ℓ])).over W) (n : ℕ) :
    ∃ (G₀ : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (σ₀ : ℚ_[ℓ] → (G₀ ⟶ G₀))
      (θ₀ : G₀.over W ≅ (wcContSheaf S ((Fin n → Fin r) → ℚ_[ℓ])).over W),
      σ₀ 1 = 𝟙 G₀ ∧ (∀ a b : ℚ_[ℓ], σ₀ (a + b) = σ₀ a + σ₀ b) ∧
      (∀ a b : ℚ_[ℓ], σ₀ (a * b) = σ₀ b ≫ σ₀ a) ∧
      (∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map (σ₀ c) ≫
          θ₀.hom =
        θ₀.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
          (wcContSheafMap S (DistribSMul.toAddMonoidHom ((Fin n → Fin r) → ℚ_[ℓ]) c)
            (continuous_const_smul c))) ∧
      (∃ N : ℕ, wcScalarTriv S ℓ G₀ σ₀ W N) ∧
      ∀ (γ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
        (∀ (s : R.obj.obj (Opposite.op W)) (z : W.left),
          (show C(↥W.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
          g.mulVec ((show C(↥W.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
        ∀ (s : G₀.obj.obj (Opposite.op W)) (z : W.left),
          (show C(↥W.left, (Fin n → Fin r) → ℚ_[ℓ]) from
            ((θ₀.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
          (Matrix.of fun (i j : Fin n → Fin r) => ∏ a, g (i a) (j a)).mulVec
            ((show C(↥W.left, (Fin n → Fin r) → ℚ_[ℓ]) from
              ((θ₀.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z) :=
by

  have key : ∀ {A B : Type} [AddCommGroup A] [TopologicalSpace A] [IsTopologicalAddGroup A]
      [AddCommGroup B] [TopologicalSpace B] [IsTopologicalAddGroup B]
      (φ : A →+ B) (hφ : Continuous φ) (U : (S.ProEt)ᵒᵖ)
      (x : ((wcContSheaf S A).obj.obj U : Type (u+1))),
      (wcContSheafMap S φ hφ).hom.app U x =
        (ULift.up (AddMonoidHom.compLeftContinuous
          (↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U))) φ hφ
          (ULift.down x : C(↥((Scheme.ProEt.forget S ⋙ Over.forget S).obj (Opposite.unop U)), A))) : _) := by
    intro A B _ _ _ _ _ _ φ hφ U x
    rfl

  obtain ⟨Hd, ed, postd, hed, hpostd, -, -, -⟩ :=
    wc_tsh_hom_sheaf_exists S R (wcContSheaf S (Unit → ℚ_[ℓ]))
  obtain ⟨θd, -, hθdF⟩ := wc_tsh_hom_sheaf_triv S ℓ R (wcContSheaf S (Unit → ℚ_[ℓ])) Hd W
    (Fin r) Unit θ (Iso.refl _) ed hed postd hpostd

  have h1u : ∀ a b : Unit, (1 : Matrix Unit Unit ℚ_[ℓ]) a b = 1 := fun a b => by
    rw [Subsingleton.elim a b]; exact Matrix.one_apply_eq b
  have hKinv : ∀ g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ], g * g' = 1 → g' * g = 1 →
      (Matrix.of fun (x y : Unit × Fin r) => (1 : Matrix Unit Unit ℚ_[ℓ]) x.1 y.1 * g' y.2 x.2) *
        (Matrix.of fun (x y : Unit × Fin r) => g y.2 x.2) = 1 ∧
      (Matrix.of fun (x y : Unit × Fin r) => g y.2 x.2) *
        (Matrix.of fun (x y : Unit × Fin r) => (1 : Matrix Unit Unit ℚ_[ℓ]) x.1 y.1 * g' y.2 x.2) = 1 := by
    intro g g' h1 h2
    have hone : ∀ (M : Matrix (Fin r) (Fin r) ℚ_[ℓ]), M = 1 → ∀ p q : Fin r,
        M q p = (1 : Matrix (Unit × Fin r) (Unit × Fin r) ℚ_[ℓ]) ((), p) ((), q) := by
      intro M hM p q
      rw [hM]
      by_cases hpq : p = q
      · subst hpq; simp
      · rw [Matrix.one_apply_ne (Ne.symm hpq), Matrix.one_apply_ne (by simp [hpq])]
    constructor
    · ext ⟨⟨⟩, p⟩ ⟨⟨⟩, q⟩
      rw [← hone (g * g') h1 p q, Matrix.mul_apply, Matrix.mul_apply, Fintype.sum_prod_type,
        Fintype.sum_unique]
      simp only [Matrix.of_apply, h1u, one_mul]
      exact Finset.sum_congr rfl (fun t _ => mul_comm _ _)
    · ext ⟨⟨⟩, p⟩ ⟨⟨⟩, q⟩
      rw [← hone (g' * g) h2 p q, Matrix.mul_apply, Matrix.mul_apply, Fintype.sum_prod_type,
        Fintype.sum_unique]
      simp only [Matrix.of_apply, h1u, one_mul]
      exact Finset.sum_congr rfl (fun t _ => mul_comm _ _)

  have Q : ∀ m : ℕ, ∃ (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (σ : ℚ_[ℓ] → (G ⟶ G))
      (θG : G.over W ≅ (wcContSheaf S ((Fin m → Fin r) → ℚ_[ℓ])).over W),
      σ 1 = 𝟙 G ∧ (∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b) ∧
      (∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a) ∧
      (∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
          θG.hom =
        θG.hom ≫ ((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} W).map
          (wcContSheafMap S (DistribSMul.toAddMonoidHom ((Fin m → Fin r) → ℚ_[ℓ]) c)
            (continuous_const_smul c))) ∧
      ∀ (γ : W ⟶ W) (g g' : Matrix (Fin r) (Fin r) ℚ_[ℓ]), g * g' = 1 → g' * g = 1 →
        (∀ (V : S.ProEt) (f : V ⟶ W) (s : R.obj.obj (Opposite.op V)) (z : V.left),
          (show C(↥V.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk (f ≫ γ)))).hom s).down) z =
          g.mulVec ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk f))).hom s).down) z)) →
        ∀ (V : S.ProEt) (f : V ⟶ W) (s : G.obj.obj (Opposite.op V)) (z : V.left),
          (show C(↥V.left, (Fin m → Fin r) → ℚ_[ℓ]) from
            ((θG.hom.hom.app (Opposite.op (Over.mk (f ≫ γ)))).hom s).down) z =
          (Matrix.of fun (i j : Fin m → Fin r) => ∏ a, g (i a) (j a)).mulVec
            ((show C(↥V.left, (Fin m → Fin r) → ℚ_[ℓ]) from
              ((θG.hom.hom.app (Opposite.op (Over.mk f))).hom s).down) z) := by
    intro m
    induction m with
    | zero =>
      refine ⟨wcContSheaf S ((Fin 0 → Fin r) → ℚ_[ℓ]),
        fun c => wcContSheafMap S (DistribSMul.toAddMonoidHom ((Fin 0 → Fin r) → ℚ_[ℓ]) c)
          (continuous_const_smul c), Iso.refl _, ?_, ?_, ?_, ?_, ?_⟩
      · apply Sheaf.hom_ext
        apply NatTrans.ext
        funext U
        apply AddCommGrpCat.ext
        intro x
        beta_reduce
        apply ULift.ext
        apply ContinuousMap.ext
        intro a
        first
          | (change ((1 : ℚ_[ℓ]) • _ : (Fin 0 → Fin r) → ℚ_[ℓ]) = _; exact one_smul _ _)
          | (erw [key]; exact one_smul _ _)
      · intro a b
        apply Sheaf.hom_ext
        apply NatTrans.ext
        funext U
        apply AddCommGrpCat.ext
        intro x
        beta_reduce
        rw [Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply]
        apply ULift.ext
        apply ContinuousMap.ext
        intro y
        exact add_smul (M := (Fin 0 → Fin r) → ℚ_[ℓ]) a b _
      · intro a b
        apply Sheaf.hom_ext
        apply NatTrans.ext
        funext U
        apply AddCommGrpCat.ext
        intro x
        beta_reduce
        rw [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app, CategoryTheory.comp_apply]
        apply ULift.ext
        apply ContinuousMap.ext
        intro y
        exact mul_smul (α := ℚ_[ℓ]) (β := (Fin 0 → Fin r) → ℚ_[ℓ]) a b _
      · intro c
        rw [Iso.refl_hom, Category.comp_id, Category.id_comp]
      · intro γ g g' _ _ _ V f s z
        have hg0 : (Matrix.of fun (i j : Fin 0 → Fin r) => ∏ a, g (i a) (j a)) = 1 := by
          ext i j
          rw [Subsingleton.elim i j]
          simp
        rw [hg0, Matrix.one_mulVec]
        rfl
    | succ m ih =>
      obtain ⟨Gm, σm, θm, hm1, hmadd, hmmul, hmsc, hmfr⟩ := ih
      obtain ⟨H, e, post, he, hpost, hpost1, hpostcomp, hpostadd⟩ :=
        wc_tsh_hom_sheaf_exists S Hd Gm
      obtain ⟨θH, hθHsc, hθHF⟩ := wc_tsh_hom_sheaf_triv S ℓ Hd Gm H W (Unit × Fin r)
        (Fin m → Fin r) θd θm e he post hpost
      let eqv : (Fin m → Fin r) × (Unit × Fin r) ≃ (Fin (m + 1) → Fin r) :=
        { toFun := fun x => Fin.snoc (α := fun _ => Fin r) x.1 x.2.2
          invFun := fun q => (Fin.init q, ((), q (Fin.last m)))
          left_inv := fun x => by
            obtain ⟨i, ⟨⟩, p⟩ := x
            simp [Fin.init_snoc, Fin.snoc_last]
          right_inv := fun q => by simp [Fin.snoc_init_self] }
      obtain ⟨θ', hθ'sc, hθ'F⟩ := wc_tsh_reindex S ℓ H W ((Fin m → Fin r) × (Unit × Fin r))
        (Fin (m + 1) → Fin r) eqv θH
      refine ⟨H, fun c => post (σm c), θ', ?_, ?_, ?_, ?_, ?_⟩
      · show post (σm 1) = 𝟙 H
        rw [hm1, hpost1]
      · intro a b
        show post (σm (a + b)) = post (σm a) + post (σm b)
        rw [hmadd, hpostadd]
      · intro a b
        show post (σm (a * b)) = post (σm b) ≫ post (σm a)
        rw [hmmul, hpostcomp]
      · intro c
        exact hθ'sc (post (σm c)) c (hθHsc (σm c) c (hmsc c))
      · intro γ g g' hgg' hg'g hA
        have hK := hθdF γ g g' 1 hgg' hg'g hA (fun V f s z => by rw [Matrix.one_mulVec]; rfl)
        obtain ⟨hKK', hK'K⟩ := hKinv g g' hgg' hg'g
        have hX := hθHF γ _ _ _ hKK' hK'K hK (hmfr γ g g' hgg' hg'g hA)
        have hY := hθ'F γ _ hX
        intro V f s z
        refine (hY V f s z).trans ?_
        congr 1
        ext q q'
        simp only [Matrix.of_apply]
        rw [Fin.prod_univ_castSucc]
        rfl

  obtain ⟨G₀, σ₀, θ₀, h1, hadd, hmul, hsc, hfr⟩ := Q n
  obtain ⟨θ'', hsc'', -⟩ := wc_tsh_reindex S ℓ G₀ W (Fin n → Fin r)
    (Fin (Fintype.card (Fin n → Fin r))) (Fintype.equivFin _) θ₀
  refine ⟨G₀, σ₀, θ₀, h1, hadd, hmul, hsc, ⟨Fintype.card (Fin n → Fin r), ?_⟩, ?_⟩
  · unfold wcScalarTriv
    exact ⟨θ'', fun c => hsc'' (σ₀ c) c (hsc c)⟩
  · intro γ g hWF s z
    obtain ⟨hAF, g', hgg', hg'g⟩ := wc_tsh_frame_upgrade S ℓ R W hW r θ γ g hWF
    have h := hfr γ g g' hgg' hg'g hAF W (𝟙 W) s z
    rw [Category.id_comp] at h
    exact h

theorem wc_tsh_ext_zero (K : Type u) [Field K] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (G₀ : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ₀ : ℚ_[ℓ] → (G₀ ⟶ G₀)) :
    ∃ (M : Subobject G₀)
      (σ : ℚ_[ℓ] → (Subobject.underlying.obj M ⟶ Subobject.underlying.obj M)),
      wcZeroAtS K m S (Subobject.underlying.obj M) ∧
      (∀ c, σ c ≫ M.arrow = M.arrow ≫ σ₀ c) ∧
      ∀ T : (wcP1Over K).left.ProEt,
        (∀ (t : T.left) (i : Fin m), T.hom t ≠ S i (IsLocalRing.closedPoint K)) →
        Function.Bijective (M.arrow.hom.app (Opposite.op T)).hom :=
by
  classical

  have hFact : ∀ (S : Scheme.{u}) (A : Type u) [CommRing A] [HenselianLocalRing A]
      [IsSepClosed (IsLocalRing.ResidueField A)]
      (U : S.ProEt) (T : Sieve U), T ∈ Scheme.ProEt.topology S U →
      ∀ (W : S.ProEt) (a : W ⟶ U) (_ : W.left ≅ Spec (.of A)), T.arrows a := by
    intro S A _ _ _
    have s6 : ∀ (R E : Type u) [CommRing R] [CommRing E] [Algebra R E],
        WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R E))) →
          Algebra.WeaklyEtale R E := by
      intro R E _ _ _ hW
      have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R E))) := hW.flat
      have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R E)))) :=
        hW.flat_diagonal
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
        RingHom.flat_algebraMap_iff] at hf
      rw [diagonal_SpecMap] at hd
      have hd' : Flat (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.lmul' R (S := E)).toRingHom)) := by
        have heq : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) =
            (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) ≫
              (pullbackSpecIso R E E).inv) ≫ (pullbackSpecIso R E E).hom := by
          rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
        rw [heq]
        infer_instance
      rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hd'
      exact ⟨hf, hd'⟩
    have s7 : ∀ (E : Type u) [CommRing E] [Algebra A E],
        Algebra.WeaklyEtale A E → ∀ (p : Ideal E) [p.IsPrime],
        p.comap (algebraMap A E) = IsLocalRing.maximalIdeal A → Nonempty (E →ₐ[A] A) := by
      intro E _ _ hAE p _ hp
      haveI : Algebra.WeaklyEtale E (Localization.AtPrime p) :=
        wc_localization_weaklyEtale E (Localization.AtPrime p) p.primeCompl
      haveI := hAE
      haveI : Algebra.WeaklyEtale A (Localization.AtPrime p) := Algebra.WeaklyEtale.trans A E _
      have hloc : IsLocalHom (algebraMap A (Localization.AtPrime p)) := by
        have h1 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
            (algebraMap A (Localization.AtPrime p)) = IsLocalRing.maximalIdeal A := by
          rw [IsScalarTower.algebraMap_eq A E (Localization.AtPrime p), ← Ideal.comap_comap]
          have h2 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
              (algebraMap E (Localization.AtPrime p)) = p :=
            Localization.AtPrime.under_maximalIdeal
          rw [h2, hp]
        exact ((IsLocalRing.local_hom_TFAE (algebraMap A (Localization.AtPrime p))).out 1 5).mpr h1
      have hbij := wc_olivier A (Localization.AtPrime p) inferInstance inferInstance hloc
        inferInstance
      let eqv : A ≃ₐ[A] Localization.AtPrime p := AlgEquiv.ofBijective (Algebra.ofId A _) hbij
      exact ⟨eqv.symm.toAlgHom.comp (IsScalarTower.toAlgHom A E (Localization.AtPrime p))⟩
    have s5 : ∀ {U V : Scheme.{u}} (e : U ≅ Spec (.of A)) (g : V ⟶ U) [WeaklyEtale g] (v : V),
        e.hom (g v) = IsLocalRing.closedPoint A → ∃ σ : U ⟶ V, σ ≫ g = 𝟙 U := by
      intro U V e g _ v hv
      obtain ⟨E, ι, hι, hvι, -⟩ :=
        Scheme.exists_affine_mem_range_and_range_subset (U := (⊤ : V.Opens)) (x := v) trivial
      obtain ⟨w, hw⟩ := hvι
      have := hι
      let h : Spec E ⟶ Spec (.of A) := ι ≫ g ≫ e.hom
      have hWh : WeaklyEtale h := inferInstance
      let φ : CommRingCat.of A ⟶ E := Spec.preimage h
      have hφ : Spec.map φ = h := Spec.map_preimage h
      letI : Algebra A E := (CommRingCat.Hom.hom φ).toAlgebra
      have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap A E))) := by
        change WeaklyEtale (Spec.map φ)
        rw [hφ]
        exact hWh
      have hAE : Algebra.WeaklyEtale A E := s6 A E hW'
      let p : PrimeSpectrum E := w
      have hq : (p.asIdeal).comap (algebraMap A E) = IsLocalRing.maximalIdeal A := by
        have h1 : (Spec.map φ) w = IsLocalRing.closedPoint A := by
          rw [hφ]
          show e.hom (g (ι w)) = _
          rw [hw, hv]
        exact congrArg PrimeSpectrum.asIdeal h1
      obtain ⟨τ⟩ := s7 E hAE p.asIdeal hq
      let τ' : E ⟶ CommRingCat.of A := CommRingCat.ofHom (τ : E →+* A)
      have hret : φ ≫ τ' = 𝟙 _ := by
        ext r
        exact τ.commutes r
      refine ⟨e.hom ≫ Spec.map τ' ≫ ι, ?_⟩
      rw [← cancel_mono e.hom]
      simp only [Category.assoc, Category.id_comp]
      have h3 : ι ≫ g ≫ e.hom = Spec.map φ := hφ.symm
      rw [h3, ← Spec.map_comp, hret, Spec.map_id, Category.comp_id]
    have s4 : ∀ (U : S.ProEt) (R : Presieve U), R ∈ (Scheme.ProEt.precoverage S).coverings U →
        ∀ (W : S.ProEt) (a : W ⟶ U), Nonempty (W.left ≅ Spec (.of A)) →
        ∃ (Y : S.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), R g ∧ h ≫ g = a := by
      intro U R hR W a ⟨eW⟩
      have hR' : Presieve.map (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
          (Scheme.precoverage @WeaklyEtale).coverings U.left := hR.2
      obtain ⟨Y', g', hg', y', hy'⟩ :=
        (Scheme.instJointlySurjectivePrecoverage (P := @WeaklyEtale)).exists_eq _ hR'
          (a.left (eW.inv (IsLocalRing.closedPoint A)))
      obtain ⟨Y, hY, g, hg, hgg⟩ := Presieve.map_iff.mp hg'
      subst hY
      have hgl : g.left = g' := hgg.trans (by simp only [eqToHom_refl]; exact Category.id_comp _)
      haveI : WeaklyEtale U.hom := U.prop
      haveI : WeaklyEtale (g.left ≫ U.hom) := by
        rw [MorphismProperty.Over.w g]; exact Y.prop
      haveI : WeaklyEtale g.left := WeaklyEtale.of_comp g.left U.hom
      obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := a.left) (g := g.left)
        (eW.inv (IsLocalRing.closedPoint A)) y' (by rw [hgl]; exact hy'.symm)
      obtain ⟨σ, hσ⟩ := s5 eW (Limits.pullback.fst a.left g.left) z (by
        rw [hz1]
        change (eW.inv ≫ eW.hom) (IsLocalRing.closedPoint A) = _
        rw [Iso.inv_hom_id]
        rfl)
      have hh₀ : (σ ≫ Limits.pullback.snd a.left g.left) ≫ g.left = a.left := by
        rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hσ, Category.id_comp]
      refine ⟨Y, g, MorphismProperty.Over.homMk (σ ≫ Limits.pullback.snd a.left g.left) ?_ trivial,
        hg, ?_⟩
      · rw [← MorphismProperty.Over.w g, ← Category.assoc, hh₀, MorphismProperty.Over.w a]
      · apply MorphismProperty.Over.Hom.ext
        exact hh₀
    have s3 : ∀ (P : S.ProEt → Prop),
        (∀ (U : S.ProEt) (R : Presieve U), R ∈ (Scheme.ProEt.precoverage S).coverings U →
          ∀ (W : S.ProEt) (a : W ⟶ U), P W →
            ∃ (Y : S.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), R g ∧ h ≫ g = a) →
        ∀ (U : S.ProEt) (T : Sieve U), T ∈ Scheme.ProEt.topology S U →
          ∀ (W : S.ProEt) (a : W ⟶ U), P W → T.arrows a := by
      intro P hK
      let JP : GrothendieckTopology S.ProEt :=
        GrothendieckTopology.mk
          (fun U => {T : Sieve U | ∀ (W : S.ProEt) (a : W ⟶ U), P W → T.arrows a})
          (by
            intro U W a _
            trivial)
          (by
            intro U Y T f hT W a hW
            rw [Sieve.pullback_apply]
            exact hT W (a ≫ f) hW)
          (by
            intro U T hT R hR W a hW
            have h1 := hR (hT W a hW) W (𝟙 W) hW
            rw [Sieve.pullback_apply, Category.id_comp] at h1
            exact h1)
      have hle : Scheme.ProEt.topology S ≤ JP := by
        rw [Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
        intro U R hR
        show ∀ (W : S.ProEt) (a : W ⟶ U), P W → (Sieve.generate R).arrows a
        intro W a hW
        obtain ⟨Y, g, h, hg, hhg⟩ := hK U R hR W a hW
        exact ⟨Y, h, g, hg, hhg⟩
      intro U T hT W a hW
      have h1 : T ∈ JP U := GrothendieckTopology.le_def.mp hle U hT
      exact h1 W a hW
    intro U T hT W a e
    exact s3 (fun W => Nonempty (W.left ≅ Spec (.of A))) s4 U T hT W a ⟨e⟩


  have hSub : ∀ (S : Scheme.{u}) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (H : ∀ U : (S.ProEt)ᵒᵖ, AddSubgroup (G.obj.obj U)),
      (∀ {U V : (S.ProEt)ᵒᵖ} (f : U ⟶ V) (x : G.obj.obj U), x ∈ H U → G.obj.map f x ∈ H V) →
      (∀ (X : S.ProEt) (x : G.obj.obj (Opposite.op X)) (R : Sieve X),
        R ∈ Scheme.ProEt.topology S X →
        (∀ (Y : S.ProEt) (f : Y ⟶ X), R.arrows f → G.obj.map f.op x ∈ H (Opposite.op Y)) →
        x ∈ H (Opposite.op X)) →
      ∃ M : Subobject G,
        (∀ U : (S.ProEt)ᵒᵖ, Function.Injective (M.arrow.hom.app U)) ∧
        (∀ (U : (S.ProEt)ᵒᵖ) (x : (Subobject.underlying.obj M).obj.obj U),
          M.arrow.hom.app U x ∈ H U) ∧
        (∀ (X : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (g : X ⟶ G),
          (∀ (U : (S.ProEt)ᵒᵖ) (x : X.obj.obj U), g.hom.app U x ∈ H U) →
          ∃ g' : X ⟶ Subobject.underlying.obj M, g' ≫ M.arrow = g) ∧
        (∀ (U : (S.ProEt)ᵒᵖ) (x : G.obj.obj U), x ∈ H U →
          ∃ y : (Subobject.underlying.obj M).obj.obj U, M.arrow.hom.app U y = x) := by
    intro S G H hres hloc
    let Mp : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
      { obj := fun U => AddCommGrpCat.of (H U)
        map := fun {U V} f => AddCommGrpCat.ofHom
          (AddMonoidHom.codRestrict (((G.obj.map f).hom).comp (H U).subtype) (H V)
            (fun x => hres f x.1 x.2))
        map_id := by
          intro U
          ext x
          show (G.obj.map (𝟙 U)) x.1 = x.1
          simp
        map_comp := by
          intro U V W f g
          ext x
          show (G.obj.map (f ≫ g)) x.1 = (G.obj.map g) ((G.obj.map f) x.1)
          simp }
    let ιp : Mp ⟶ G.obj :=
      { app := fun U => AddCommGrpCat.ofHom (H U).subtype
        naturality := by
          intro U V f
          ext x
          rfl }
    have hιp : Mono ιp := by
      rw [NatTrans.mono_iff_mono_app]
      intro U
      rw [AddCommGrpCat.mono_iff_injective]
      exact Subtype.val_injective
    have hMp : Presheaf.IsSheaf (Scheme.ProEt.topology S) Mp := by
      have hF : Presieve.IsSheaf (Scheme.ProEt.topology S) (G.obj ⋙ forget AddCommGrpCat) :=
        (isSheaf_iff_isSheaf_of_type _ _).mp
          ((Presheaf.isSheaf_iff_isSheaf_forget _ G.obj (forget AddCommGrpCat)).mp G.property)
      let G' : Subfunctor (G.obj ⋙ forget AddCommGrpCat) :=
        { obj := fun U => (H U : Set (G.obj.obj U))
          map := by
            intro U V f x hx
            exact hres f x hx }
      have hG' : Presieve.IsSheaf (Scheme.ProEt.topology S) G'.toFunctor := by
        rw [Subfunctor.isSheaf_iff G' hF]
        intro U s hs
        exact hloc U.unop s _ hs (fun Y f hf => hf)
      rw [Presheaf.isSheaf_iff_isSheaf_forget _ Mp (forget AddCommGrpCat),
        isSheaf_iff_isSheaf_of_type]
      refine Presieve.isSheaf_iso _ ?_ hG'
      exact NatIso.ofComponents
        (fun U => Equiv.toIso (X := G'.toFunctor.obj U) (Y := (Mp ⋙ forget AddCommGrpCat).obj U)
          { toFun := fun x => (show (Mp ⋙ forget AddCommGrpCat).obj U from (⟨x.1, x.2⟩ : H U))
            invFun := fun x => (show G'.toFunctor.obj U from ⟨(x : H U).1, (x : H U).2⟩)
            left_inv := fun _ => rfl
            right_inv := fun _ => rfl })
        (by intros; rfl)
    let N : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} := ⟨Mp, hMp⟩
    let ι : N ⟶ G := ObjectProperty.homMk ιp
    have : Mono ι.hom := hιp
    have : Mono ι := Sheaf.Hom.mono_of_presheaf_mono _ _ ι
    have harr : ∀ (U : (S.ProEt)ᵒᵖ) (y : (Subobject.underlying.obj (Subobject.mk ι)).obj.obj U),
        (Subobject.mk ι).arrow.hom.app U y =
          ι.hom.app U ((Subobject.underlyingIso ι).hom.hom.app U y) := by
      intro U y
      rw [← Subobject.underlyingIso_hom_comp_eq_mk ι]
      rfl
    refine ⟨Subobject.mk ι, ?_, ?_, ?_, ?_⟩
    · intro U
      have h1 : Mono ((sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map
          (Subobject.mk ι).arrow) := Functor.map_mono _ _
      have h2 : Mono ((Subobject.mk ι).arrow.hom) := h1
      rw [NatTrans.mono_iff_mono_app] at h2
      exact (AddCommGrpCat.mono_iff_injective _).mp (h2 U)
    · intro U x
      rw [← Subobject.underlyingIso_hom_comp_eq_mk ι]
      exact ((Subobject.underlyingIso ι).hom.hom.app U x).2
    · intro X g hg
      let gp : X.obj ⟶ Mp :=
        { app := fun U => AddCommGrpCat.ofHom
            (AddMonoidHom.codRestrict (g.hom.app U).hom (H U) (hg U))
          naturality := by
            intro U V f
            ext x
            exact NatTrans.naturality_apply g.hom f x }
      refine ⟨ObjectProperty.homMk gp ≫ (Subobject.underlyingIso ι).inv, ?_⟩
      rw [← Subobject.underlyingIso_hom_comp_eq_mk ι]
      simp only [Category.assoc, Iso.inv_hom_id_assoc]
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext U
      apply AddCommGrpCat.ext
      intro x
      rfl
    · intro U x hx
      let z : N.obj.obj U := (show N.obj.obj U from (⟨x, hx⟩ : H U))
      refine ⟨(Subobject.underlyingIso ι).inv.hom.app U z, ?_⟩
      have h2 : (Subobject.underlyingIso ι).hom.hom.app U
          ((Subobject.underlyingIso ι).inv.hom.app U z) = z :=
        congrArg (fun φ => φ.hom.app U z) (Subobject.underlyingIso ι).inv_hom_id
      rw [harr, h2]
      rfl

  let H : ∀ U : ((wcP1Over K).left.ProEt)ᵒᵖ, AddSubgroup (G₀.obj.obj U) :=
    fun U =>
    { carrier := {x | ∀ (i : Fin m) (W : (wcP1Over K).left.ProEt) (A : Type u) [CommRing A]
          [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
          (e : W.left ≅ Spec (.of A)),
          W.hom (e.inv (IsLocalRing.closedPoint A)) = S i (IsLocalRing.closedPoint K) →
          ∀ f : W ⟶ U.unop, G₀.obj.map f.op x = 0}
      zero_mem' := by
        intro i W A _ _ _ e hW f
        exact map_zero _
      add_mem' := by
        intro a b ha hb i W A _ _ _ e hW f
        rw [map_add, ha i W A e hW f, hb i W A e hW f, add_zero]
      neg_mem' := by
        intro a ha i W A _ _ _ e hW f
        rw [map_neg, ha i W A e hW f, neg_zero] }
  have hres : ∀ {U V : ((wcP1Over K).left.ProEt)ᵒᵖ} (f : U ⟶ V)
      (x : G₀.obj.obj U), x ∈ H U → G₀.obj.map f x ∈ H V := by
    intro U V f x hx i W A _ _ _ e hW g
    have h1 := hx i W A e hW (g ≫ f.unop)
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply] at h1
    exact h1
  have hloc : ∀ (X : (wcP1Over K).left.ProEt) (x : G₀.obj.obj (Opposite.op X))
      (R : Sieve X), R ∈ Scheme.ProEt.topology (wcP1Over K).left X →
      (∀ (Y : (wcP1Over K).left.ProEt) (f : Y ⟶ X), R.arrows f →
        G₀.obj.map f.op x ∈ H (Opposite.op Y)) →
      x ∈ H (Opposite.op X) := by
    intro X x R hR hfam i W A _ _ _ e hW f
    have hRf : R.arrows f := hFact _ A X R hR W f e
    have h1 := hfam W f hRf i W A e hW (𝟙 W)
    rw [op_id, CategoryTheory.Functor.map_id, ConcreteCategory.id_apply] at h1
    exact h1
  obtain ⟨M, hinj, hland, hlift, hsurj⟩ := hSub _ G₀ H hres hloc

  have hσex : ∀ c : ℚ_[ℓ], ∃ s : Subobject.underlying.obj M ⟶ Subobject.underlying.obj M,
      s ≫ M.arrow = M.arrow ≫ σ₀ c := by
    intro c
    apply hlift
    intro U y i W A _ _ _ e hW f
    show G₀.obj.map f.op ((σ₀ c).hom.app U (M.arrow.hom.app U y)) = 0
    rw [← NatTrans.naturality_apply, hland U y i W A e hW f, map_zero]
  choose σ hσ using hσex
  obtain ⟨ev, -, -⟩ := wc_free_ext0_eval (wcP1Over K).left
  refine ⟨M, σ, ?_, hσ, ?_⟩
  ·
    intro i V A _ _ _ e hV y
    have hz : ev V _ y = 0 := by
      apply hinj (Opposite.op V)
      rw [map_zero]
      have h1 := hland (Opposite.op V) (ev V _ y) i V A e hV (𝟙 V)
      rw [op_id, CategoryTheory.Functor.map_id, ConcreteCategory.id_apply] at h1
      exact h1
    exact (ev V _).injective (hz.trans (map_zero _).symm)
  ·
    intro T hT
    have hall : ∀ x : G₀.obj.obj (Opposite.op T), x ∈ H (Opposite.op T) := by
      intro x i W A _ _ _ e hW f
      exfalso
      apply hT (f.left (e.inv (IsLocalRing.closedPoint A))) i
      rw [← hW]
      have hw := MorphismProperty.Over.w f
      first
        | (rw [← hw]; rfl)
        | (rw [← hw, Scheme.Hom.comp_apply])
        | simp [← hw]
    exact ⟨hinj _, fun x => hsurj _ x (hall x)⟩

theorem wc_tsh_stalk_trace (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hW : ConnectedSpace W.left)
    (hcov : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (hgal : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ)
    (φ : W ⟶ W) (hφw : φ ≫ w = w ≫ wcGeomFrob K (wcP1Over K) hP)
    (d : ℕ) (hd : 1 ≤ d) (x : (wcP1Over K).left) (hx : x ∈ wcP1ClosedPt K d)
    (hxS : ∀ i, x ≠ S i (IsLocalRing.closedPoint K)) :
    ∃ σW : W ⟶ W, ∀ (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
      (σ : ℚ_[ℓ] → (G ⟶ G)) (ι' : Type) [Fintype ι'] [DecidableEq ι']
      (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (ι' → ℚ_[ℓ])).over W),
      (∀ c : ℚ_[ℓ],
        ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
            θ.hom =
          θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map
            (wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) c)
              (continuous_const_smul c))) →
      (∃ g : Matrix ι' ι' ℚ_[ℓ], ∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
        (show C(↥W.left, ι' → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk σW))).hom s).down) z =
        g.mulVec ((show C(↥W.left, ι' → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) ∧
      ∀ g : Matrix ι' ι' ℚ_[ℓ], (∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
        (show C(↥W.left, ι' → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk σW))).hom s).down) z =
        g.mulVec ((show C(↥W.left, ι' → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
        ∃ g' : Matrix ι' ι' ℚ_[ℓ], g * g' = 1 ∧ ∀ j : ℕ,
          ((wcStalkLoc K ℓ G σ x d).map (· ^ j)).sum =
            algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((g' ^ j).trace) :=
by

  obtain ⟨N₀⟩ := wc_P1_frob_nbhd_exists K d hd x hx
  letI := N₀.ringA
  haveI := N₀.hensA
  haveI := N₀.sepA
  let v₀ : N₀.V.left := N₀.e.inv (IsLocalRing.closedPoint N₀.A)
  have hspec : ∀ v : N₀.V.left, v ⤳ v₀ := by
    intro v
    have h1 : N₀.e.hom v ⤳ (IsLocalRing.closedPoint N₀.A : Spec (.of N₀.A)) :=
      IsLocalRing.specializes_closedPoint (R := N₀.A) (N₀.e.hom v)
    have h2 : N₀.e.inv (N₀.e.hom v) ⤳ v₀ := h1.map (Scheme.Hom.continuous N₀.e.inv)
    rwa [Scheme.hom_inv_apply] at h2
  have hpre : _root_.IsPreconnected (Set.univ : Set N₀.V.left) :=
    isPreconnected_of_forall v₀ (fun y _ => ⟨closure {y}, Set.subset_univ _,
      specializes_iff_mem_closure.mp (hspec y), subset_closure (Set.mem_singleton y),
      isPreconnected_singleton.closure⟩)
  haveI hconnV : ConnectedSpace N₀.V.left :=
    { toPreconnectedSpace := ⟨hpre⟩, toNonempty := ⟨v₀⟩ }
  obtain ⟨g₀⟩ := wc_P1_strict_local_geomPoint_map K hP N₀.V N₀.A N₀.e
  have hp : (wcGeomPoint K (wcP1Over K) hP).hom (g₀.left v₀) = x := by
    have h1 := Scheme.Hom.comp_apply g₀.left (wcGeomPoint K (wcP1Over K) hP).hom v₀
    rw [← h1, MorphismProperty.Over.w g₀]
    exact N₀.hx
  obtain ⟨z, hz⟩ := hcov (g₀.left v₀) (fun i h => hxS i (hp.symm.trans h))
  obtain ⟨ι₀, hι₀⟩ := wc_P1bar_strict_local_lift K hP W w N₀.V g₀ N₀.A N₀.e ⟨z, hz⟩
  have hd1 : ∀ n : ℕ, ((fun γ : W ⟶ W => γ ≫ φ)^[n] (𝟙 W)) ≫ w =
      (fun k : W ⟶ wcGeomPoint K (wcP1Over K) hP => k ≫ wcGeomFrob K (wcP1Over K) hP)^[n] w := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', Category.assoc, hφw,
        ← Category.assoc, ih]
  have hd2 : ∀ (n : ℕ) (a : N₀.V ⟶ W) (b : W ⟶ wcGeomPoint K (wcP1Over K) hP),
      (fun k : N₀.V ⟶ wcGeomPoint K (wcP1Over K) hP => k ≫ wcGeomFrob K (wcP1Over K) hP)^[n]
          (a ≫ b) =
        a ≫ (fun k : W ⟶ wcGeomPoint K (wcP1Over K) hP =>
          k ≫ wcGeomFrob K (wcP1Over K) hP)^[n] b := by
    intro n a b
    induction n with
    | zero => rfl
    | succ n ih =>
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih, Category.assoc]
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : W ⟶ W, Φ ≫ w =
      (fun k : W ⟶ wcGeomPoint K (wcP1Over K) hP => k ≫ wcGeomFrob K (wcP1Over K) hP)^[d] w :=
    ⟨_, hd1 d⟩
  have heq : (ι₀ ≫ Φ) ≫ w = (N₀.φ ≫ ι₀) ≫ w := by
    rw [Category.assoc, hΦ, ← hd2, hι₀, Category.assoc, hι₀,
      wc_frobNbhd_geomFrob_equivariant K hP x d N₀ g₀]
  obtain ⟨δ, -, hδ⟩ := hgal N₀.V (ι₀ ≫ Φ) (N₀.φ ≫ ι₀) hconnV heq
  obtain ⟨σW, hσ⟩ : ∃ σW : W ⟶ W, N₀.φ ≫ ι₀ = ι₀ ≫ σW :=
    ⟨Φ ≫ δ, by rw [hδ, Category.assoc]⟩
  refine ⟨σW, ?_⟩
  intro G σ ι' _ _ θ hθc

  let τ : ∀ (V : (wcP1Over K).left.ProEt) (f : V ⟶ W), G.obj.obj (Opposite.op V) →
      C(↥V.left, ι' → ℚ_[ℓ]) := fun V f s =>
    (show C(↥V.left, ι' → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk f))).hom s).down)

  let k := Fintype.card ι'
  let e : ι' ≃ Fin k := Fintype.equivFin ι'
  let ρe : (ι' → ℚ_[ℓ]) ≃+ (Fin k → ℚ_[ℓ]) :=
    { toFun := fun v q => v (e.symm q)
      invFun := fun v i => v (e i)
      left_inv := fun v => funext fun i => by simp
      right_inv := fun v => funext fun q => by simp
      map_add' := fun _ _ => rfl }
  have hρ : Continuous (ρe.toAddMonoidHom : (ι' → ℚ_[ℓ]) → (Fin k → ℚ_[ℓ])) :=
    continuous_pi fun q => continuous_apply (e.symm q)
  have hρ' : Continuous (ρe.symm.toAddMonoidHom : (Fin k → ℚ_[ℓ]) → (ι' → ℚ_[ℓ])) :=
    continuous_pi fun i => continuous_apply (e i)
  let ρIso : wcContSheaf (wcP1Over K).left (ι' → ℚ_[ℓ]) ≅
      wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ]) :=
    { hom := wcContSheafMap (wcP1Over K).left ρe.toAddMonoidHom hρ
      inv := wcContSheafMap (wcP1Over K).left ρe.symm.toAddMonoidHom hρ'
      hom_inv_id := by
        apply Sheaf.hom_ext
        apply NatTrans.ext
        funext U
        refine ConcreteCategory.hom_ext _ _ (fun s => ?_)
        apply ULift.ext
        apply ContinuousMap.ext
        intro y
        exact ρe.symm_apply_apply
          ((show C(↥(Opposite.unop U).left, ι' → ℚ_[ℓ]) from s.down) y)
      inv_hom_id := by
        apply Sheaf.hom_ext
        apply NatTrans.ext
        funext U
        refine ConcreteCategory.hom_ext _ _ (fun s => ?_)
        apply ULift.ext
        apply ContinuousMap.ext
        intro y
        exact ρe.apply_symm_apply
          ((show C(↥(Opposite.unop U).left, Fin k → ℚ_[ℓ]) from s.down) y) }
  let θ' : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W :=
    θ ≪≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).mapIso ρIso
  let τ' : ∀ (V : (wcP1Over K).left.ProEt) (f : V ⟶ W), G.obj.obj (Opposite.op V) →
      C(↥V.left, Fin k → ℚ_[ℓ]) := fun V f s =>
    (show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ'.hom.hom.app (Opposite.op (Over.mk f))).hom s).down)
  have hval : ∀ (V : (wcP1Over K).left.ProEt) (f : V ⟶ W) (s : G.obj.obj (Opposite.op V))
      (y : V.left), τ' V f s y = ρe (τ V f s y) := fun _ _ _ _ => rfl

  obtain ⟨A, hA⟩ := wc_proet_deck_frame_linear (wcP1Over K).left ℓ G W hW k θ' σW
  let g₀ : Matrix ι' ι' ℚ_[ℓ] := Matrix.of fun i j => LinearMap.toMatrix' A (e i) (e j)
  have hkey : ∀ v : ι' → ℚ_[ℓ], ρe (g₀.mulVec v) = (LinearMap.toMatrix' A).mulVec (ρe v) := by
    intro v
    funext q
    show ∑ j, LinearMap.toMatrix' A (e (e.symm q)) (e j) * v j =
      ∑ q', LinearMap.toMatrix' A q q' * v (e.symm q')
    rw [Equiv.apply_symm_apply, ← Equiv.sum_comp e (fun q' => LinearMap.toMatrix' A q q' * v (e.symm q'))]
    simp only [Equiv.symm_apply_apply]
  have AF0 : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W), b = a ≫ σW →
      ∀ (s : G.obj.obj (Opposite.op V)) (y : V.left), τ V b s y = g₀.mulVec (τ V a s y) := by
    intro V a b hb s y
    apply ρe.injective
    rw [hkey, ← hval, ← hval, LinearMap.toMatrix'_mulVec]
    exact hA V a b hb s y
  refine ⟨⟨g₀, fun s y => AF0 W (𝟙 W) σW (Category.id_comp σW).symm s y⟩, ?_⟩

  intro g hg
  obtain ⟨z₀⟩ := hW.toNonempty
  let τe : (W ⟶ W) → (G.obj.obj (Opposite.op W) ≃+ ULift.{u+1} C(↥W.left, ι' → ℚ_[ℓ])) :=
    fun γ => (((sheafToPresheaf _ _).mapIso θ).app (Opposite.op (Over.mk γ))).addCommGroupIsoToAddEquiv
  have hτe : ∀ (γ : W ⟶ W) (s : G.obj.obj (Opposite.op W)), (τe γ s).down = τ W γ s :=
    fun _ _ => rfl
  have hconstsec : ∀ (γ : W ⟶ W) (v : ι' → ℚ_[ℓ]),
      τ W γ ((τe γ).symm (ULift.up (ContinuousMap.const _ v))) z₀ = v := by
    intro γ v
    rw [← hτe, AddEquiv.apply_symm_apply]
    rfl
  have hmv : ∀ v, g.mulVec v = g₀.mulVec v := by
    intro v
    have h1 : τ W σW ((τe (𝟙 W)).symm (ULift.up (ContinuousMap.const _ v))) z₀ =
        g.mulVec (τ W (𝟙 W) ((τe (𝟙 W)).symm (ULift.up (ContinuousMap.const _ v))) z₀) :=
      hg _ z₀
    have h2 := AF0 W (𝟙 W) σW (Category.id_comp σW).symm
      ((τe (𝟙 W)).symm (ULift.up (ContinuousMap.const _ v))) z₀
    rw [hconstsec] at h1 h2
    exact h1.symm.trans h2
  have hgg₀ : g = g₀ := by
    ext i j
    have := congrFun (hmv (Pi.single j 1)) i
    simpa [Matrix.mulVec_single_one] using this
  have AFg : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W), b = a ≫ σW →
      ∀ (s : G.obj.obj (Opposite.op V)) (y : V.left), τ V b s y = g.mulVec (τ V a s y) := by
    intro V a b hb s y
    rw [hgg₀]
    exact AF0 V a b hb s y
  have hsurj : Function.Surjective g.mulVec := by
    intro v
    refine ⟨τ W (𝟙 W) ((τe σW).symm (ULift.up (ContinuousMap.const _ v))) z₀, ?_⟩
    have h1 : τ W σW ((τe σW).symm (ULift.up (ContinuousMap.const _ v))) z₀ =
        g.mulVec (τ W (𝟙 W) ((τe σW).symm (ULift.up (ContinuousMap.const _ v))) z₀) :=
      hg _ z₀
    rw [hconstsec] at h1
    exact h1.symm
  have hunit : IsUnit g.det :=
    (Matrix.isUnit_iff_isUnit_det g).mp (Matrix.mulVec_surjective_iff_isUnit.mp hsurj)
  have hgg' : g * g⁻¹ = 1 := Matrix.mul_nonsing_inv g hunit
  have hg'g : g⁻¹ * g = 1 := Matrix.nonsing_inv_mul g hunit

  let X₀ : Over W := Over.mk ι₀
  let X₁ : Over W := Over.mk (N₀.φ ≫ ι₀)
  let hX : X₁ ⟶ X₀ := Over.homMk N₀.φ rfl
  have hconst : ∀ (f : C(N₀.V.left, ι' → ℚ_[ℓ])) (y : N₀.V.left), f y = f v₀ :=
    fun f y => ((hspec y).map f.continuous).eq
  let τeN : G.obj.obj (Opposite.op N₀.V) ≃+ ULift.{u+1} C(N₀.V.left, ι' → ℚ_[ℓ]) :=
    (((sheafToPresheaf _ _).mapIso θ).app (Opposite.op X₀)).addCommGroupIsoToAddEquiv
  let ev : ULift.{u+1} C(N₀.V.left, ι' → ℚ_[ℓ]) ≃+ (ι' → ℚ_[ℓ]) :=
    { toFun := fun F => F.down v₀
      invFun := fun m => ULift.up (ContinuousMap.const _ m)
      left_inv := fun F => ULift.ext _ _ (ContinuousMap.ext fun y => (hconst F.down y).symm)
      right_inv := fun m => rfl
      map_add' := fun F F' => rfl }
  let β : G.obj.obj (Opposite.op N₀.V) ≃+ (ι' → ℚ_[ℓ]) := τeN.trans ev
  have hβ : ∀ s, β s = τ N₀.V ι₀ s v₀ := fun _ => rfl
  have hscal : ∀ (c : ℚ_[ℓ]) (s : G.obj.obj (Opposite.op N₀.V)),
      β (((σ c).hom.app (Opposite.op N₀.V)).hom s) = c • β s := by
    intro c s
    have h1 := NatTrans.congr_app (congrArg (fun f => f.hom) (hθc c)) (Opposite.op X₀)
    have h2 := congrArg ULift.down (ConcreteCategory.congr_hom h1 s)
    have h3 := congrArg (fun f : C(N₀.V.left, ι' → ℚ_[ℓ]) => f v₀) h2
    exact h3
  have key : ∀ s : G.obj.obj (Opposite.op N₀.V),
      τ N₀.V (N₀.φ ≫ ι₀) ((G.obj.map N₀.φ.op).hom s) = (τ N₀.V ι₀ s).comp N₀.φ.left.base.hom := by
    intro s
    exact congrArg ULift.down
      (congrArg (fun f => AddCommGrpCat.Hom.hom f s) (θ.hom.hom.naturality hX.op))
  have hstar : ∀ s : G.obj.obj (Opposite.op N₀.V),
      g.mulVec (β ((G.obj.map N₀.φ.op).hom s)) = β s := by
    intro s
    have e1 := AFg N₀.V ι₀ (N₀.φ ≫ ι₀) hσ ((G.obj.map N₀.φ.op).hom s) v₀
    have e2 := congrArg (fun f : C(N₀.V.left, ι' → ℚ_[ℓ]) => f v₀) (key s)
    rw [hβ, hβ]
    calc g.mulVec (τ N₀.V ι₀ ((G.obj.map N₀.φ.op).hom s) v₀)
        = τ N₀.V (N₀.φ ≫ ι₀) ((G.obj.map N₀.φ.op).hom s) v₀ := e1.symm
      _ = τ N₀.V ι₀ s (N₀.φ.left.base.hom v₀) := e2
      _ = τ N₀.V ι₀ s v₀ := hconst _ _
  have hfrob : ∀ s : G.obj.obj (Opposite.op N₀.V),
      β ((G.obj.map N₀.φ.op).hom s) = g⁻¹.mulVec (β s) := by
    intro s
    rw [← hstar s, Matrix.mulVec_mulVec, hg'g, Matrix.one_mulVec]
  let J := Scheme.ProEt.topology (wcP1Over K).left
  let P := yoneda.obj N₀.V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
  let η : (wcFreeSheaf (wcP1Over K).left N₀.V).obj.obj (Opposite.op N₀.V) :=
    ((toSheafify J P).app (Opposite.op N₀.V)).hom (FreeAbelianGroup.of (ULift.up (𝟙 N₀.V)))
  let eqv : (wcFreeSheaf (wcP1Over K).left N₀.V ⟶ G) ≃ G.obj.obj (Opposite.op N₀.V) :=
    ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv P G).trans
      (((Adjunction.whiskerRight ((wcP1Over K).left.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj N₀.V ⋙ uliftFunctor.{u+1, u}) G.obj).trans
        (uliftYonedaEquiv.{u+1} (X := N₀.V)
          (F := G.obj ⋙ forget AddCommGrpCat.{u+1})))
  have heqv : ∀ h : wcFreeSheaf (wcP1Over K).left N₀.V ⟶ G,
      eqv h = (h.hom.app (Opposite.op N₀.V)).hom η :=
    fun _ => rfl
  have hadd : ∀ h h' : wcFreeSheaf (wcP1Over K).left N₀.V ⟶ G,
      eqv (h + h') = eqv h + eqv h' := by
    intro h h'
    rw [heqv, heqv, heqv]
    first
      | rfl
      | simp [Sheaf.Hom.add_app]
      | simp
  let eqvA : (wcFreeSheaf (wcP1Over K).left N₀.V ⟶ G) ≃+ G.obj.obj (Opposite.op N₀.V) :=
    AddEquiv.mk' eqv hadd
  have hnat : ((wcFreeSheafMap (wcP1Over K).left N₀.φ).hom.app (Opposite.op N₀.V)).hom η =
      ((wcFreeSheaf (wcP1Over K).left N₀.V).obj.map N₀.φ.op).hom η := by
    let w' : P ⟶ P :=
      Functor.whiskerRight (yoneda.map N₀.φ) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
    let x' : P.obj (Opposite.op N₀.V) := FreeAbelianGroup.of (ULift.up (𝟙 N₀.V))
    have h1 : ((sheafifyMap J w').app (Opposite.op N₀.V)).hom (((toSheafify J P).app
        (Opposite.op N₀.V)).hom x') = ((toSheafify J P).app (Opposite.op N₀.V)).hom
          ((w'.app (Opposite.op N₀.V)).hom x') :=
      (ConcreteCategory.congr_hom
        (congrArg (fun ψ => ψ.app (Opposite.op N₀.V)) (toSheafify_naturality J w')) x').symm
    have h2 : (w'.app (Opposite.op N₀.V)).hom x' = (P.map N₀.φ.op).hom x' := by
      change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) =
        FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
      refine (FreeAbelianGroup.map_of_apply _).trans
        (Eq.trans ?_ (FreeAbelianGroup.map_of_apply _).symm)
      congr 1
    have hn : ((toSheafify J P).app (Opposite.op N₀.V)).hom ((P.map N₀.φ.op).hom x') =
        ((sheafify J P).map N₀.φ.op).hom (((toSheafify J P).app (Opposite.op N₀.V)).hom x') :=
      NatTrans.naturality_apply (toSheafify J P) N₀.φ.op x'
    change ((sheafifyMap J w').app (Opposite.op N₀.V)).hom (((toSheafify J P).app
        (Opposite.op N₀.V)).hom x') =
      ((sheafify J P).map N₀.φ.op).hom (((toSheafify J P).app (Opposite.op N₀.V)).hom x')
    rw [h1, h2, hn]
  have hnatG : ∀ h : wcFreeSheaf (wcP1Over K).left N₀.V ⟶ G,
      eqv (wcFreeSheafMap (wcP1Over K).left N₀.φ ≫ h) =
        (G.obj.map N₀.φ.op).hom (eqv h) := by
    intro h
    rw [heqv, heqv]
    change (h.hom.app (Opposite.op N₀.V)).hom
      (((wcFreeSheafMap (wcP1Over K).left N₀.φ).hom.app (Opposite.op N₀.V)).hom η) = _
    rw [hnat]
    exact NatTrans.naturality_apply h.hom N₀.φ.op η
  have hpostG : ∀ (ψ : G ⟶ G) (h : wcFreeSheaf (wcP1Over K).left N₀.V ⟶ G),
      eqv (h ≫ ψ) = (ψ.hom.app (Opposite.op N₀.V)).hom (eqv h) := by
    intro ψ h
    rw [heqv, heqv]
    rfl
  let E0 : Abelian.Ext (wcFreeSheaf (wcP1Over K).left N₀.V) G 0 ≃+
      (wcFreeSheaf (wcP1Over K).left N₀.V ⟶ G) := Abelian.Ext.addEquiv₀
  have hE0 : ∀ h : wcFreeSheaf (wcP1Over K).left N₀.V ⟶ G,
      E0 (Abelian.Ext.mk₀ h) = h := by
    intro h
    apply (Abelian.Ext.mk₀_bijective _ _).1
    exact Abelian.Ext.mk₀_addEquiv₀_apply _
  let b : Abelian.Ext (wcFreeSheaf (wcP1Over K).left N₀.V) G 0 ≃+ (Fin k → ℚ_[ℓ]) :=
    E0.trans (eqvA.trans (β.trans ρe))
  have hb : ∀ h : wcFreeSheaf (wcP1Over K).left N₀.V ⟶ G,
      b (Abelian.Ext.mk₀ h) = ρe (β (eqv h)) := by
    intro h
    show ρe (β (eqvA (E0 (Abelian.Ext.mk₀ h)))) = ρe (β (eqv h))
    rw [hE0]
    rfl
  have hbs : ∀ (c : ℚ_[ℓ]) (y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left N₀.V) G 0),
      b ((Abelian.Ext.mk₀ (σ c)).postcomp (wcFreeSheaf (wcP1Over K).left N₀.V) (add_zero 0) y) =
        c • b y := by
    intro c y
    obtain ⟨h, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
    have hp : (Abelian.Ext.mk₀ (σ c)).postcomp (wcFreeSheaf (wcP1Over K).left N₀.V) (add_zero 0)
        (Abelian.Ext.mk₀ h) = Abelian.Ext.mk₀ (h ≫ σ c) :=
      Abelian.Ext.mk₀_comp_mk₀ _ _
    rw [hp, hb, hb, hpostG, hscal]
    rfl
  have hbΦ : ∀ y : Abelian.Ext (wcFreeSheaf (wcP1Over K).left N₀.V) G 0,
      b ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left N₀.φ)).precomp G (zero_add 0) y) =
        ρe (g⁻¹.mulVec (ρe.symm (b y))) := by
    intro y
    obtain ⟨h, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 y
    have hp : (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left N₀.φ)).precomp G (zero_add 0)
        (Abelian.Ext.mk₀ h) = Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left N₀.φ ≫ h) :=
      Abelian.Ext.mk₀_comp_mk₀ _ _
    rw [hp, hb, hb, hnatG, hfrob, AddEquiv.symm_apply_apply]
  have hmat : wcAddEquivMatrix b ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left N₀.φ)).precomp
      G (zero_add 0)) = Matrix.reindex e e g⁻¹ := by
    ext a c
    unfold wcAddEquivMatrix
    rw [Matrix.of_apply, hbΦ, AddEquiv.apply_symm_apply]
    show (g⁻¹.mulVec (fun i => (Pi.single c (1 : ℚ_[ℓ]) : Fin k → ℚ_[ℓ]) (e i))) (e.symm a) =
      g⁻¹ (e.symm a) (e.symm c)
    have hs : (fun i => (Pi.single c (1 : ℚ_[ℓ]) : Fin k → ℚ_[ℓ]) (e i)) =
        Pi.single (e.symm c) 1 := by
      funext i
      simp only [Pi.single_apply, Equiv.apply_eq_iff_eq_symm_apply]
    rw [hs, Matrix.mulVec_single_one]
    rfl

  refine ⟨g⁻¹, hgg', fun j => ?_⟩
  have hbas : Nonempty (wcStalkBasis K ℓ G σ x d) := ⟨⟨N₀, k, b, hbs⟩⟩
  have hloc : wcStalkLoc K ℓ G σ x d =
      (Matrix.reindex e e g⁻¹).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    unfold wcStalkLoc
    rw [dif_pos hbas, wc_stalkLoc_basis_indep K ℓ G σ x d hbas.some ⟨N₀, k, b, hbs⟩]
    exact congrArg (fun M => M.charpoly.aroots (AlgebraicClosure ℚ_[ℓ])) hmat
  have hpow : (Matrix.reindex e e g⁻¹) ^ j = Matrix.reindex e e (g⁻¹ ^ j) := by
    have := map_pow (Matrix.reindexAlgEquiv ℚ_[ℓ] ℚ_[ℓ] e) g⁻¹ j
    simpa [Matrix.coe_reindexAlgEquiv] using this.symm
  have htr : ∀ X : Matrix ι' ι' ℚ_[ℓ], (Matrix.reindex e e X).trace = X.trace := by
    intro X
    simp only [Matrix.trace, Matrix.diag, Matrix.reindex_apply, Matrix.submatrix_apply]
    exact Equiv.sum_comp e.symm (fun i => X i i)
  rw [hloc, wc_aroots_pow_sum_trace, hpow, htr]

theorem wc_vqtt_tensor_sheaf (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (W : (wcP1Over F'').left.ProEt) (w : W ⟶ wcGeomPoint F'' (wcP1Over F'') hP) (r : ℕ)
    (θ : (wcPencilVQ D ℓ hP).over W ≅ (wcContSheaf (wcP1Over F'').left (Fin r → ℚ_[ℓ])).over W)
    (φ : W ⟶ W) (hB : wcVQGalFrame D ℓ hP W w r θ φ) (hr : 1 ≤ r) (k : ℕ) (hk : 1 ≤ k) :
    ∃ (G : Sheaf (Scheme.ProEt.topology (wcP1Over F'').left) AddCommGrpCat.{u+1})
      (σ : ℚ_[ℓ] → (G ⟶ G))
      (θG : G.over W ≅ (wcContSheaf (wcP1Over F'').left ((Fin (2 * k) → Fin r) → ℚ_[ℓ])).over W),
      σ 1 = 𝟙 G ∧ (∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b) ∧
      (∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a) ∧
      wcZeroAtS F'' D.m D.S G ∧ wcLisseOffS F'' hP ℓ D.m D.S G σ ∧
      (∀ c : ℚ_[ℓ],
        ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
            θG.hom =
          θG.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
            (wcContSheafMap (wcP1Over F'').left
              (DistribSMul.toAddMonoidHom ((Fin (2 * k) → Fin r) → ℚ_[ℓ]) c)
              (continuous_const_smul c))) ∧
      (∀ (γ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]), wcVQFrame D ℓ hP W r θ γ g →
        ∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
          (show C(↥W.left, (Fin (2 * k) → Fin r) → ℚ_[ℓ]) from
            ((θG.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
          (Matrix.of fun (i j : Fin (2 * k) → Fin r) => ∏ a, g (i a) (j a)).mulVec
            ((show C(↥W.left, (Fin (2 * k) → Fin r) → ℚ_[ℓ]) from
              ((θG.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) ∧
      (∀ d : ℕ, 1 ≤ d → ∀ x ∈ wcPencilOffS D d, ∀ j : ℕ, 1 ≤ j →
        ((wcStalkLoc F'' ℓ G σ x d).map (· ^ j)).sum =
          ((wcPencilLoc D ℓ hP x d).map (· ^ j)).sum ^ (2 * k)) :=
by
  classical
  obtain ⟨hθc, hqc, hconn, hoff, hcov, hgal, hφw, -, -, -⟩ := hB

  obtain ⟨G₀, σ₀, θ₀, h1, hadd, hmul, h₀c, ⟨N₀, t₀, ht₀⟩, hfr₀⟩ :=
    wc_tsh_tensor_power_triv (wcP1Over F'').left ℓ (wcPencilVQ D ℓ hP) W hconn r θ (2 * k)

  obtain ⟨M, σ, hzero, hsq, hbij⟩ := wc_tsh_ext_zero F'' ℓ D.m D.S G₀ σ₀

  have kmul : ∀ (X Y : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      (Matrix.of fun (i j : Fin (2 * k) → Fin r) => ∏ a, (X * Y) (i a) (j a)) =
        (Matrix.of fun (i j : Fin (2 * k) → Fin r) => ∏ a, X (i a) (j a)) *
          (Matrix.of fun (i j : Fin (2 * k) → Fin r) => ∏ a, Y (i a) (j a)) := by
    intro X Y
    ext i j
    simp only [Matrix.of_apply, Matrix.mul_apply]
    rw [Fintype.prod_sum]
    exact Finset.sum_congr rfl (fun p _ => Finset.prod_mul_distrib)
  have kone : (Matrix.of fun (i j : Fin (2 * k) → Fin r) =>
      ∏ a, (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (i a) (j a)) = 1 := by
    ext i j
    simp only [Matrix.of_apply, Matrix.one_apply]
    by_cases h : i = j
    · subst h; simp
    · rw [if_neg h]
      obtain ⟨a, ha⟩ := Function.ne_iff.mp h
      exact Finset.prod_eq_zero (Finset.mem_univ a) (if_neg ha)
  have ktr : ∀ (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (m : ℕ),
      ((Matrix.of fun (i j : Fin (2 * k) → Fin r) => ∏ a, X (i a) (j a)) ^ m).trace =
        ((X ^ m).trace) ^ (2 * k) := by
    intro X m
    have hpow : (Matrix.of fun (i j : Fin (2 * k) → Fin r) => ∏ a, X (i a) (j a)) ^ m =
        Matrix.of fun (i j : Fin (2 * k) → Fin r) => ∏ a, (X ^ m) (i a) (j a) := by
      induction m with
      | zero => rw [pow_zero, pow_zero, kone]
      | succ m ih => rw [pow_succ, ih, pow_succ, kmul]
    rw [hpow]
    have h1 := Fintype.prod_sum (fun (_ : Fin (2 * k)) (b : Fin r) => (X ^ m) b b)
    simp only [Matrix.trace, Matrix.diag, Matrix.of_apply]
    rw [← h1, Finset.prod_const, Finset.card_univ, Fintype.card_fin]

  haveI hiso : IsIso (((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
      AddCommGrpCat.{u+1} W).map M.arrow) := by
    have hc : ∀ X, IsIso ((((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
        AddCommGrpCat.{u+1} W).map M.arrow).hom.app X) := by
      intro X
      have hb : Function.Bijective (M.arrow.hom.app (Opposite.op X.unop.left)).hom := by
        apply hbij
        intro t i
        have hw := MorphismProperty.Over.w X.unop.hom
        have ht : X.unop.left.hom t = W.hom (X.unop.hom.left t) := by
          first
            | (rw [← hw]; rfl)
            | (rw [← hw, Scheme.Hom.comp_apply])
            | simp [← hw]
        rw [ht]
        exact hoff _ i
      have : IsIso ((forget AddCommGrpCat).map ((((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
          AddCommGrpCat.{u+1} W).map M.arrow).hom.app X)) :=
        (isIso_iff_bijective _).mpr hb
      exact isIso_of_reflects_iso _ (forget AddCommGrpCat)
    have : IsIso ((sheafToPresheaf _ AddCommGrpCat.{u+1}).map
        (((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
          M.arrow)) :=
      @NatIso.isIso_of_isIso_app _ _ _ _ _ _ _ hc
    exact isIso_of_reflects_iso _ (sheafToPresheaf _ AddCommGrpCat.{u+1})

  obtain ⟨θG, hθG⟩ : ∃ θG : (Subobject.underlying.obj M).over W ≅
      (wcContSheaf (wcP1Over F'').left ((Fin (2 * k) → Fin r) → ℚ_[ℓ])).over W,
      θG = asIso (((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
        AddCommGrpCat.{u+1} W).map M.arrow) ≪≫ θ₀ := ⟨_, rfl⟩
  have hcompat : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
          θG.hom =
        θG.hom ≫ ((Scheme.ProEt.topology (wcP1Over F'').left).overPullback AddCommGrpCat.{u+1} W).map
          (wcContSheafMap (wcP1Over F'').left
            (DistribSMul.toAddMonoidHom ((Fin (2 * k) → Fin r) → ℚ_[ℓ]) c)
            (continuous_const_smul c)) := by
    intro c
    subst hθG
    simp only [Iso.trans_hom, asIso_hom, Category.assoc]
    rw [← h₀c]
    simp only [← Functor.map_comp_assoc, hsq]
  have hframe : ∀ (γ : W ⟶ W) (g : Matrix (Fin r) (Fin r) ℚ_[ℓ]), wcVQFrame D ℓ hP W r θ γ g →
      ∀ (s : (Subobject.underlying.obj M).obj.obj (Opposite.op W)) (z : W.left),
        (show C(↥W.left, (Fin (2 * k) → Fin r) → ℚ_[ℓ]) from
          ((θG.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
        (Matrix.of fun (i j : Fin (2 * k) → Fin r) => ∏ a, g (i a) (j a)).mulVec
          ((show C(↥W.left, (Fin (2 * k) → Fin r) → ℚ_[ℓ]) from
            ((θG.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z) := by
    intro γ g hg s z
    subst hθG
    exact hfr₀ γ g hg (M.arrow.hom.app (Opposite.op W) s) z
  refine ⟨Subobject.underlying.obj M, σ, θG, ?_, ?_, ?_, hzero, ?_, hcompat, hframe, ?_⟩
  ·
    rw [← cancel_mono M.arrow, hsq, h1, Category.id_comp, Category.comp_id]
  · intro a b
    rw [← cancel_mono M.arrow, hsq, hadd, Preadditive.comp_add, Preadditive.add_comp, hsq, hsq]
  · intro a b
    rw [← cancel_mono M.arrow, hsq, hmul]
    simp only [Category.assoc, hsq]
    simp only [← Category.assoc, hsq]
  ·
    refine ⟨W, w, N₀, hqc, hconn, hoff, hcov,
      asIso (((Scheme.ProEt.topology (wcP1Over F'').left).overPullback
        AddCommGrpCat.{u+1} W).map M.arrow) ≪≫ t₀, ?_⟩
    intro c
    simp only [Iso.trans_hom, asIso_hom, Category.assoc]
    rw [← ht₀]
    simp only [← Functor.map_comp_assoc, hsq]
  ·
    intro d hd x hx j hj
    obtain ⟨_, hxc, hxS⟩ := hx
    obtain ⟨σW, hσW⟩ :=
      wc_tsh_stalk_trace F'' hP ℓ D.m D.S W w hconn hcov hgal φ hφw d hd x hxc hxS
    obtain ⟨⟨g, hg⟩, hVinv⟩ := hσW (wcPencilVQ D ℓ hP) (wcPencilVQScalar D ℓ hP) (Fin r) θ hθc
    obtain ⟨g', hgg', hVtr⟩ := hVinv g hg
    obtain ⟨-, hGinv⟩ := hσW (Subobject.underlying.obj M) σ (Fin (2 * k) → Fin r) θG hcompat
    obtain ⟨g'', hgg'', hGtr⟩ := hGinv _ (hframe σW g hg)
    have hinv1 : (Matrix.of fun (i j : Fin (2 * k) → Fin r) => ∏ a, g' (i a) (j a)) *
        (Matrix.of fun (i j : Fin (2 * k) → Fin r) => ∏ a, g (i a) (j a)) = 1 := by
      rw [← kmul, mul_eq_one_comm.mp hgg', kone]
    have hg'' : g'' = Matrix.of fun (i j : Fin (2 * k) → Fin r) => ∏ a, g' (i a) (j a) := by
      calc g'' = ((Matrix.of fun (i j : Fin (2 * k) → Fin r) => ∏ a, g' (i a) (j a)) *
            (Matrix.of fun (i j : Fin (2 * k) → Fin r) => ∏ a, g (i a) (j a))) * g'' := by
              rw [hinv1, Matrix.one_mul]
        _ = (Matrix.of fun (i j : Fin (2 * k) → Fin r) => ∏ a, g' (i a) (j a)) *
            ((Matrix.of fun (i j : Fin (2 * k) → Fin r) => ∏ a, g (i a) (j a)) * g'') := by
              rw [Matrix.mul_assoc]
        _ = Matrix.of fun (i j : Fin (2 * k) → Fin r) => ∏ a, g' (i a) (j a) := by
              rw [hgg'', Matrix.mul_one]
    have hPE : wcPencilLoc D ℓ hP x d =
        wcStalkLoc F'' ℓ (wcPencilVQ D ℓ hP) (wcPencilVQScalar D ℓ hP) x d := by
      unfold wcPencilLoc wcStalkLoc
      by_cases hb : Nonempty (wcPencilStalkBasis D ℓ hP x d)
      · have hb' : Nonempty (wcStalkBasis F'' ℓ (wcPencilVQ D ℓ hP) (wcPencilVQScalar D ℓ hP) x d) :=
          ⟨⟨hb.some.N, hb.some.r, hb.some.e, hb.some.he⟩⟩
        rw [dif_pos hb, dif_pos hb']
        exact wc_stalkLoc_basis_indep F'' ℓ (wcPencilVQ D ℓ hP) (wcPencilVQScalar D ℓ hP) x d
          ⟨hb.some.N, hb.some.r, hb.some.e, hb.some.he⟩ hb'.some
      · have hb' : ¬ Nonempty
            (wcStalkBasis F'' ℓ (wcPencilVQ D ℓ hP) (wcPencilVQScalar D ℓ hP) x d) :=
          fun ⟨b⟩ => hb ⟨⟨b.N, b.r, b.e, b.he⟩⟩
        rw [dif_neg hb, dif_neg hb']
    rw [hGtr j, hPE, hVtr j, hg'', ktr g' j, map_pow]

theorem wc_lcf_H0_vanish (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (m : ℕ) (hm : 1 ≤ m) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G))
    (hzero : wcZeroAtS K m S G) (hlisse : wcLisseOffS K hP ℓ m S G σ) :
    ∀ y : wcCohG K (wcP1Over K) hP G 0, y = 0 :=
by
  classical
  intro y

  have huniq : ∀ (i : Fin m) (p p' : (wcGeomPoint K (wcP1Over K) hP).left),
      (wcGeomPoint K (wcP1Over K) hP).hom p = S i (IsLocalRing.closedPoint K) →
      (wcGeomPoint K (wcP1Over K) hP).hom p' = S i (IsLocalRing.closedPoint K) →
      p = p' := by
    intro i p p' hp hp'
    obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      (g := S i) p (IsLocalRing.closedPoint K) hp
    obtain ⟨z', hz1', -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
      (g := S i) p' (IsLocalRing.closedPoint K) hp'
    haveI : IsIso (S i ≫ (wcP1Over K).hom) := by rw [hS i]; infer_instance
    let e := Limits.pullbackSymmetry (Limits.pullback.fst (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))) (S i) ≪≫
      Limits.pullbackRightPullbackFstIso (wcP1Over K).hom
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))) (S i) ≪≫
      asIso (Limits.pullback.snd (S i ≫ (wcP1Over K).hom)
        (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K)))))
    have hsub : Subsingleton (Spec (.of (AlgebraicClosure K))) := by
      show Subsingleton (PrimeSpectrum (AlgebraicClosure K))
      infer_instance
    have hzz : z = z' := e.hom.isOpenEmbedding.injective (Subsingleton.elim _ _)
    rw [← hz1, ← hz1', hzz]

  have hloc : ∀ i : Fin m, ∃ (V : (wcP1Over K).left.ProEt)
      (g : V ⟶ wcGeomPoint K (wcP1Over K) hP) (v : V.left),
      V.hom v = S i (IsLocalRing.closedPoint K) ∧
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left g)).comp y (zero_add 0) = 0 := by
    intro i
    obtain ⟨V₀, g₀, -, A, _, _, _, e, -, hv, -⟩ := wc_P1bar_strict_local_nbhd K (S i) (hS i) hP
    exact ⟨V₀, g₀, e.inv (IsLocalRing.closedPoint A), hv, hzero i V₀ A e hv _⟩

  obtain ⟨x₀, rfl⟩ : ∃ x₀, Abelian.Ext.mk₀ x₀ = y := ⟨_, Abelian.Ext.mk₀_addEquiv₀_apply y⟩
  obtain ⟨η, hη1, hη2⟩ := wc_proet_free_sheaf_yoneda (wcP1Over K).left
  have hz0 : ∀ (V : (wcP1Over K).left.ProEt) (g : V ⟶ wcGeomPoint K (wcP1Over K) hP),
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left g)).comp (Abelian.Ext.mk₀ x₀)
        (zero_add 0) = 0 ↔ wcFreeSheafMap (wcP1Over K).left g ≫ x₀ = 0 := by
    intro V g
    rw [Abelian.Ext.mk₀_comp_mk₀]
    constructor
    · intro h
      apply (Abelian.Ext.mk₀_bijective _ _).1
      rw [h, Abelian.Ext.mk₀_zero]
    · intro h
      rw [h, Abelian.Ext.mk₀_zero]
  have hsec : ∀ (V : (wcP1Over K).left.ProEt) (g : V ⟶ wcGeomPoint K (wcP1Over K) hP),
      ((wcFreeSheafMap (wcP1Over K).left g ≫ x₀).hom.app (Opposite.op V)).hom (η V) =
        (G.obj.map g.op).hom
          ((x₀.hom.app (Opposite.op (wcGeomPoint K (wcP1Over K) hP))).hom
            (η (wcGeomPoint K (wcP1Over K) hP))) := by
    intro V g
    have h1 := congrArg (fun φ => AddCommGrpCat.Hom.hom φ (η (wcGeomPoint K (wcP1Over K) hP)))
      (x₀.hom.naturality g.op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at h1
    change (x₀.hom.app (Opposite.op V)).hom
      (((wcFreeSheafMap (wcP1Over K).left g).hom.app (Opposite.op V)).hom (η V)) = _
    rw [hη2 (wcGeomPoint K (wcP1Over K) hP) V g]
    exact h1
  have star : ∀ (V : (wcP1Over K).left.ProEt) (g : V ⟶ wcGeomPoint K (wcP1Over K) hP),
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left g)).comp (Abelian.Ext.mk₀ x₀)
        (zero_add 0) = 0 ↔
      (G.obj.map g.op).hom
          ((x₀.hom.app (Opposite.op (wcGeomPoint K (wcP1Over K) hP))).hom
            (η (wcGeomPoint K (wcP1Over K) hP))) = 0 := by
    intro V g
    rw [hz0, ← hsec]
    constructor
    · intro h
      rw [h]
      simp
    · intro h
      obtain ⟨g', _, hg'⟩ := hη1 V G 0
      have a1 := hg' (wcFreeSheafMap (wcP1Over K).left g ≫ x₀) h
      have a2 := hg' 0 (by simp)
      rw [a1, a2]

  obtain ⟨W, w, r, hqc, hconn, -, hsurj, θ, -⟩ := hlisse
  have lift : ∀ (V : (wcP1Over K).left.ProEt) (g : V ⟶ wcGeomPoint K (wcP1Over K) hP)
      (p : V.left), (∀ i : Fin m, V.hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = g.left p := by
    intro V g p hp
    apply hsurj
    intro i
    have e : (wcGeomPoint K (wcP1Over K) hP).hom (g.left p) = V.hom p := by
      rw [← Scheme.Hom.comp_apply, MorphismProperty.Over.w g]
    rw [e]
    exact hp i

  obtain ⟨V₁, g₁, v₁, hv₁, hx₁⟩ := hloc ⟨0, hm⟩
  have hs₁ := (star V₁ g₁).1 hx₁
  obtain ⟨t', -, ht'⟩ := (wc_P1_sections_closed_generize K m S hS).2 V₁ v₁ ⟨⟨0, hm⟩, hv₁⟩
  have ht'off : ∀ i : Fin m, V₁.hom t' ≠ S i (IsLocalRing.closedPoint K) :=
    fun i h => ht' ⟨i, h⟩
  obtain ⟨z₀, hz₀⟩ := lift V₁ g₁ t' ht'off
  have hW := wc_proet_rigid_on_connected_constant (wcP1Over K).left G ℓ r
    (wcGeomPoint K (wcP1Over K) hP) W w hconn θ _ V₁ g₁ t' z₀ hz₀.symm hs₁
  have hy : ∀ (V : (wcP1Over K).left.ProEt) (g : V ⟶ wcGeomPoint K (wcP1Over K) hP),
      (∀ (v : V.left) (i : Fin m), V.hom v ≠ S i (IsLocalRing.closedPoint K)) →
      (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left g)).comp (Abelian.Ext.mk₀ x₀)
        (zero_add 0) = 0 := by
    intro V g hV
    exact (star V g).2 (wc_proet_section_zero_of_qc_image (wcP1Over K).left G
      (wcGeomPoint K (wcP1Over K) hP) W w hqc _ hW V g (fun p => lift V g p (hV p)))
  exact wc_P1_geom_section_zero_of_local K hP G m S hS huniq _ hy hloc

theorem wc_lcf_lattice_int_stable (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (hm : 1 ≤ m) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G)
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin m), W.hom z ≠ S i (IsLocalRing.closedPoint K))
    (hsurj : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (k : ℕ) (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (hθ : ∀ c : ℚ_[ℓ], ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫ θ.hom =
      θ.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map
        (wcConstScalar (wcP1Over K).left ℓ k c))
    (Pm : (Fin k → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ]))
    (hint : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W) (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
      ∀ i, ‖Pm ((show C(↥V.left, Fin k → ℚ_[ℓ]) from ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1)
    (J : Subobject G)
    (hJ : ∀ (V : (wcP1Over K).left.ProEt) (s : G.obj.obj (Opposite.op V)),
      (∃ t, (J.arrow.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : (wcP1Over K).left.ProEt) (c : V' ⟶ V) (b : V' ⟶ W) (z : V'.left) (i : Fin k),
          ‖Pm ((show C(↥V'.left, Fin k → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1) :
    ∃ τ : ℤ_[ℓ] → (Subobject.underlying.obj J ⟶ Subobject.underlying.obj J),
      ∀ c : ℤ_[ℓ], τ c ≫ J.arrow = J.arrow ≫ σ (c : ℚ_[ℓ]) :=
by
  classical

  have hinj : ∀ X : ((wcP1Over K).left.ProEt)ᵒᵖ,
      Function.Injective (J.arrow.hom.app X).hom := by
    intro X
    exact (AddCommGrpCat.mono_iff_injective _).mp
      (Functor.map_mono (sheafToPresheaf (Scheme.ProEt.topology (wcP1Over K).left)
        AddCommGrpCat.{u+1} ⋙ (evaluation _ AddCommGrpCat.{u+1}).obj X) J.arrow)

  have hframe : ∀ (c : ℚ_[ℓ]) (V : (wcP1Over K).left.ProEt) (b : V ⟶ W)
      (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom
            (((σ c).hom.app (Opposite.op V)).hom x)).down) z =
        c • (show C(↥V.left, Fin k → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z := by
    intro c V b x z
    have h : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom
          (((σ c).hom.app (Opposite.op V)).hom x) =
        ((wcConstScalar (wcP1Over K).left ℓ k c).hom.app (Opposite.op V)).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x) :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk b))).hom x) (hθ c)
    rw [h]
    rfl

  have hstab : ∀ (c : ℤ_[ℓ]) (X : ((wcP1Over K).left.ProEt)ᵒᵖ)
      (t : (Subobject.underlying.obj J).obj.obj X),
      ∃ t', (J.arrow.hom.app X).hom t' =
        ((σ (c : ℚ_[ℓ])).hom.app X).hom ((J.arrow.hom.app X).hom t) := by
    intro c X t
    refine (hJ X.unop _).mpr ?_
    intro V' c' b z i
    have hnat : (G.obj.map c'.op).hom (((σ (c : ℚ_[ℓ])).hom.app X).hom
        ((J.arrow.hom.app X).hom t)) =
        ((σ (c : ℚ_[ℓ])).hom.app (Opposite.op V')).hom
          ((G.obj.map c'.op).hom ((J.arrow.hom.app X).hom t)) :=
      (NatTrans.naturality_apply (σ (c : ℚ_[ℓ])).hom c'.op _).symm
    rw [hnat, hframe, LinearEquiv.map_smul, Pi.smul_apply, smul_eq_mul, norm_mul]
    have h1 : ‖(c : ℚ_[ℓ])‖ ≤ 1 := by
      rw [← PadicInt.norm_def]; exact PadicInt.norm_le_one c
    have h2 := (hJ X.unop ((J.arrow.hom.app X).hom t)).mp ⟨t, rfl⟩ V' c' b z i
    calc _ ≤ 1 * 1 := mul_le_mul h1 h2 (norm_nonneg _) zero_le_one
      _ = 1 := one_mul 1

  have hlift : ∀ c : ℤ_[ℓ], ∃ φ : Subobject.underlying.obj J ⟶ Subobject.underlying.obj J,
      φ ≫ J.arrow = J.arrow ≫ σ (c : ℚ_[ℓ]) := by
    intro c
    choose φ₀ hφ₀ using hstab c
    have hadd : ∀ X (a a' : (Subobject.underlying.obj J).obj.obj X),
        φ₀ X (a + a') = φ₀ X a + φ₀ X a' := by
      intro X a a'
      apply hinj X
      rw [map_add, hφ₀, hφ₀, hφ₀, map_add, map_add]
    let α : (Subobject.underlying.obj J).obj ⟶ (Subobject.underlying.obj J).obj :=
      { app := fun X => AddCommGrpCat.ofHom (AddMonoidHom.mk' (φ₀ X) (hadd X))
        naturality := by
          intro X Y d
          ext y
          apply hinj Y
          change (J.arrow.hom.app Y).hom (φ₀ Y (((Subobject.underlying.obj J).obj.map d).hom y)) =
            (J.arrow.hom.app Y).hom (((Subobject.underlying.obj J).obj.map d).hom (φ₀ X y))
          have e2 : (J.arrow.hom.app Y).hom (((Subobject.underlying.obj J).obj.map d).hom y) =
              (G.obj.map d).hom ((J.arrow.hom.app X).hom y) :=
            NatTrans.naturality_apply J.arrow.hom d y
          have e3 : ((σ (c : ℚ_[ℓ])).hom.app Y).hom ((G.obj.map d).hom ((J.arrow.hom.app X).hom y)) =
              (G.obj.map d).hom (((σ (c : ℚ_[ℓ])).hom.app X).hom ((J.arrow.hom.app X).hom y)) :=
            NatTrans.naturality_apply (σ (c : ℚ_[ℓ])).hom d _
          have e4 : (J.arrow.hom.app Y).hom
              (((Subobject.underlying.obj J).obj.map d).hom (φ₀ X y)) =
              (G.obj.map d).hom ((J.arrow.hom.app X).hom (φ₀ X y)) :=
            NatTrans.naturality_apply J.arrow.hom d _
          rw [hφ₀, e2, e3, e4, hφ₀] }
    refine ⟨ObjectProperty.homMk α, ?_⟩
    apply Sheaf.hom_ext
    ext X y
    exact hφ₀ X y
  choose τ hτ using hlift
  exact ⟨τ, hτ⟩

theorem wc_lcf_rationalize (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (hm : 1 ≤ m) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hσ1 : σ 1 = 𝟙 G) (hσadd : ∀ a b : ℚ_[ℓ], σ (a + b) = σ a + σ b)
    (hσmul : ∀ a b : ℚ_[ℓ], σ (a * b) = σ b ≫ σ a)
    (hzero : wcZeroAtS K m S G)
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
