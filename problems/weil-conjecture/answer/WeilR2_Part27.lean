    apply hΦinj
    apply hres.1
    funext z
    show Φ x z.1 = Φ y z.1
    rw [heqD (Φ x) (hΦeq x) z.1 z.2, heqD (Φ y) (hΦeq y) z.1 z.2, hxy']
  have hevsurj : Function.Surjective evm := by
    intro w
    obtain ⟨φ, hφ⟩ := hres.2 (fun z => Matrix.vecMul w (M (γof z.1 z.2)))
    have hφD : ∀ (z : ↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)))
        (hz : N.e.hom (Limits.pullback.fst N.V.hom (q' ≫ Uo.ι) z) = IsLocalRing.closedPoint N.A),
        φ z = Matrix.vecMul w (M (γof z hz)) := fun z hz => congrFun hφ ⟨z, hz⟩
    have hequiv : ∀ (g : Γ) (z : ↥(Limits.pullback N.V.hom (q' ≫ Uo.ι))),
        φ (act g z) = Matrix.vecMul (φ z) (M g) := by
      intro g
      let φ₁ : C(↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)), Fin r → ZMod (ℓ ^ n)) :=
        φ.comp ⟨act g, Scheme.Hom.continuous _⟩
      let φ₂ : C(↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)), Fin r → ZMod (ℓ ^ n)) :=
        ⟨fun z => Matrix.vecMul (φ z) (M g),
          (continuous_of_discreteTopology (f := fun v : Fin r → ZMod (ℓ ^ n) =>
            Matrix.vecMul v (M g))).comp φ.continuous⟩
      have h12 : φ₁ = φ₂ := by
        apply hres.1
        funext z
        show φ (act g z.1) = Matrix.vecMul (φ z.1) (M g)
        have hz' := hDp g z.1 z.2
        have hγ : γof (act g z.1) hz' = g * γof z.1 z.2 := by
          apply (htors _ hz').unique (hγof _ hz')
          rw [hmul, hγof z.1 z.2]
        rw [hφD _ hz', hφD z.1 z.2, hγ, hM, Matrix.vecMul_vecMul]
      intro z
      exact congrArg (fun f => f z) h12
    obtain ⟨x, hx⟩ := hΦrange φ hequiv
    refine ⟨x, ?_⟩
    show Φ x z₀ = w
    rw [hx, hφD z₀ hz₀, hγ0, hM1, Matrix.vecMul_one]
  exact ⟨(AddEquiv.ofBijective _
    (hbijGen N.A N.V N.e Pz)).symm.trans (AddEquiv.ofBijective evm ⟨hevinj, hevsurj⟩)⟩

theorem wc_twsh_strict_local_sections_model (K : Type u) [Field K] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ] (α : Γ →* Aut V)
    (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι) (ℓ n r : ℕ)
    (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (d : ℕ) (x : (wcP1Over K).left)
    (hx : x ∈ wcOffS K m S d) (N : wcFrobNbhd K x d) :
    ∃ Ψ : (wcTwSh (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
        Γ α hα ℓ n r ρ).obj.obj (Opposite.op N.V) →+
        C(↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)), Fin r → ZMod (ℓ ^ n)),
      Function.Injective Ψ ∧
      (∀ s (γ : Γ) z, Ψ s (Limits.pullback.map N.V.hom (q' ≫ Uo.ι) N.V.hom (q' ≫ Uo.ι) (𝟙 _)
          (α γ).hom (𝟙 _) (by simp) (by rw [Category.comp_id]; exact (hα γ).symm) z) =
        Matrix.vecMul (Ψ s z)
          (((ρ γ)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))) ∧
      (∀ h : C(↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)), Fin r → ZMod (ℓ ^ n)),
        (∀ (γ : Γ) z, h (Limits.pullback.map N.V.hom (q' ≫ Uo.ι) N.V.hom (q' ≫ Uo.ι) (𝟙 _)
            (α γ).hom (𝟙 _) (by simp) (by rw [Category.comp_id]; exact (hα γ).symm) z) =
          Matrix.vecMul (h z)
            (((ρ γ)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))) →
        ∃ s, Ψ s = h) ∧
      ∀ s z, Ψ (((wcTwSh (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
          Γ α hα ℓ n r ρ).obj.map N.φ.op).hom s) z =
        Ψ s (Limits.pullback.map N.V.hom (q' ≫ Uo.ι) N.V.hom (q' ≫ Uo.ι) N.φ.left (𝟙 V) (𝟙 _)
          (by rw [Category.comp_id]; exact (MorphismProperty.Over.w N.φ).symm) (by simp) z) :=
by
  classical

  have key : ∀ (A : Type u) [instA : CommRing A] [henA : HenselianLocalRing A]
      [sepA : IsSepClosed (IsLocalRing.ResidueField A)] (W : (wcP1Over K).left.ProEt)
      (e : W.left ≅ Spec (.of A)) (P : ((wcP1Over K).left.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      Function.Bijective
        ((toSheafify (Scheme.ProEt.topology (wcP1Over K).left) P).app (Opposite.op W)).hom := by
    intro A instA henA sepA W e
    have hid : ∀ (S : Scheme.{u}) (V : S.ProEt), Nonempty (V.left ≅ Spec (.of A)) →
        ∀ T : Sieve V, T ∈ Scheme.ProEt.topology S V → T.arrows (𝟙 V) := by
      intro S
      have s6 : ∀ (R E : Type u) [CommRing R] [CommRing E] [Algebra R E],
          WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap R E))) →
            Algebra.WeaklyEtale R E := by
        intro R E _ _ _ hW
        have hf : Flat (Spec.map (CommRingCat.ofHom (algebraMap R E))) := hW.flat
        have hd : Flat (Limits.pullback.diagonal (Spec.map (CommRingCat.ofHom (algebraMap R E)))) :=
          hW.flat_diagonal
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom,
          RingHom.flat_algebraMap_iff] at hf
        rw [diagonal_SpecMap] at hd
        have hd' : Flat (Spec.map (CommRingCat.ofHom
            (Algebra.TensorProduct.lmul' R (S := E)).toRingHom)) := by
          have heq : Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) =
              (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.lmul' R (S := E)).toRingHom) ≫
                (pullbackSpecIso R E E).inv) ≫ (pullbackSpecIso R E E).hom := by
            rw [Category.assoc, Iso.inv_hom_id, Category.comp_id]
          rw [heq]
          infer_instance
        rw [HasRingHomProperty.Spec_iff (P := @Flat), CommRingCat.hom_ofHom] at hd'
        exact ⟨hf, hd'⟩
      have s7 : ∀ (E : Type u) [CommRing E] [Algebra A E],
          Algebra.WeaklyEtale A E → ∀ (p : Ideal E) [p.IsPrime],
          p.comap (algebraMap A E) = IsLocalRing.maximalIdeal A → Nonempty (E →ₐ[A] A) := by
        intro E _ _ hAE p _ hp
        haveI : Algebra.WeaklyEtale E (Localization.AtPrime p) :=
          wc_localization_weaklyEtale E (Localization.AtPrime p) p.primeCompl
        haveI := hAE
        haveI : Algebra.WeaklyEtale A (Localization.AtPrime p) := Algebra.WeaklyEtale.trans A E _
        have hloc : IsLocalHom (algebraMap A (Localization.AtPrime p)) := by
          have h1 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
              (algebraMap A (Localization.AtPrime p)) = IsLocalRing.maximalIdeal A := by
            rw [IsScalarTower.algebraMap_eq A E (Localization.AtPrime p), ← Ideal.comap_comap]
            have h2 : (IsLocalRing.maximalIdeal (Localization.AtPrime p)).comap
                (algebraMap E (Localization.AtPrime p)) = p :=
              Localization.AtPrime.under_maximalIdeal
            rw [h2, hp]
          exact ((IsLocalRing.local_hom_TFAE (algebraMap A (Localization.AtPrime p))).out 1 5).mpr h1
        have hbij := wc_olivier A (Localization.AtPrime p) inferInstance inferInstance hloc
          inferInstance
        let eqv : A ≃ₐ[A] Localization.AtPrime p := AlgEquiv.ofBijective (Algebra.ofId A _) hbij
        exact ⟨eqv.symm.toAlgHom.comp (IsScalarTower.toAlgHom A E (Localization.AtPrime p))⟩
      have s5 : ∀ {U V : Scheme.{u}} (e : U ≅ Spec (.of A)) (g : V ⟶ U) [WeaklyEtale g] (v : V),
          e.hom (g v) = IsLocalRing.closedPoint A → ∃ σ : U ⟶ V, σ ≫ g = 𝟙 U := by
        intro U V e g _ v hv
        obtain ⟨E, ι, hι, hvι, -⟩ :=
          Scheme.exists_affine_mem_range_and_range_subset (U := (⊤ : V.Opens)) (x := v) trivial
        obtain ⟨w, hw⟩ := hvι
        have := hι
        let h : Spec E ⟶ Spec (.of A) := ι ≫ g ≫ e.hom
        have hWh : WeaklyEtale h := inferInstance
        let φ : CommRingCat.of A ⟶ E := Spec.preimage h
        have hφ : Spec.map φ = h := Spec.map_preimage h
        letI : Algebra A E := (CommRingCat.Hom.hom φ).toAlgebra
        have hW' : WeaklyEtale (Spec.map (CommRingCat.ofHom (algebraMap A E))) := by
          change WeaklyEtale (Spec.map φ)
          rw [hφ]
          exact hWh
        have hAE : Algebra.WeaklyEtale A E := s6 A E hW'
        let p : PrimeSpectrum E := w
        have hq : (p.asIdeal).comap (algebraMap A E) = IsLocalRing.maximalIdeal A := by
          have h1 : (Spec.map φ) w = IsLocalRing.closedPoint A := by
            rw [hφ]
            show e.hom (g (ι w)) = _
            rw [hw, hv]
          exact congrArg PrimeSpectrum.asIdeal h1
        obtain ⟨τ⟩ := s7 E hAE p.asIdeal hq
        let τ' : E ⟶ CommRingCat.of A := CommRingCat.ofHom (τ : E →+* A)
        have hret : φ ≫ τ' = 𝟙 _ := by
          ext r
          exact τ.commutes r
        refine ⟨e.hom ≫ Spec.map τ' ≫ ι, ?_⟩
        rw [← cancel_mono e.hom]
        simp only [Category.assoc, Category.id_comp]
        have h3 : ι ≫ g ≫ e.hom = Spec.map φ := hφ.symm
        rw [h3, ← Spec.map_comp, hret, Spec.map_id, Category.comp_id]
      have s4 : ∀ (U : S.ProEt) (R : Presieve U), R ∈ (Scheme.ProEt.precoverage S).coverings U →
          ∀ (W : S.ProEt) (a : W ⟶ U), Nonempty (W.left ≅ Spec (.of A)) →
          ∃ (Y : S.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), R g ∧ h ≫ g = a := by
        intro U R hR W a ⟨eW⟩
        have hR' : Presieve.map (Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
            (Scheme.precoverage @WeaklyEtale).coverings U.left := hR.2
        obtain ⟨Y', g', hg', y', hy'⟩ :=
          (Scheme.instJointlySurjectivePrecoverage (P := @WeaklyEtale)).exists_eq _ hR'
            (a.left (eW.inv (IsLocalRing.closedPoint A)))
        obtain ⟨Y, hY, g, hg, hgg⟩ := Presieve.map_iff.mp hg'
        subst hY
        have hgl : g.left = g' := hgg.trans (by simp only [eqToHom_refl]; exact Category.id_comp _)
        haveI : WeaklyEtale U.hom := U.prop
        haveI : WeaklyEtale (g.left ≫ U.hom) := by
          rw [MorphismProperty.Over.w g]; exact Y.prop
        haveI : WeaklyEtale g.left := WeaklyEtale.of_comp g.left U.hom
        obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := a.left) (g := g.left)
          (eW.inv (IsLocalRing.closedPoint A)) y' (by rw [hgl]; exact hy'.symm)
        obtain ⟨σ, hσ⟩ := s5 eW (Limits.pullback.fst a.left g.left) z (by
          rw [hz1]
          change (eW.inv ≫ eW.hom) (IsLocalRing.closedPoint A) = _
          rw [Iso.inv_hom_id]
          rfl)
        have hh₀ : (σ ≫ Limits.pullback.snd a.left g.left) ≫ g.left = a.left := by
          rw [Category.assoc, ← Limits.pullback.condition, ← Category.assoc, hσ, Category.id_comp]
        refine ⟨Y, g, MorphismProperty.Over.homMk (σ ≫ Limits.pullback.snd a.left g.left) ?_ trivial,
          hg, ?_⟩
        · rw [← MorphismProperty.Over.w g, ← Category.assoc, hh₀, MorphismProperty.Over.w a]
        · apply MorphismProperty.Over.Hom.ext
          exact hh₀
      have s3 : ∀ (P : S.ProEt → Prop),
          (∀ (U : S.ProEt) (R : Presieve U), R ∈ (Scheme.ProEt.precoverage S).coverings U →
            ∀ (W : S.ProEt) (a : W ⟶ U), P W →
              ∃ (Y : S.ProEt) (g : Y ⟶ U) (h : W ⟶ Y), R g ∧ h ≫ g = a) →
          ∀ (U : S.ProEt) (T : Sieve U), T ∈ Scheme.ProEt.topology S U →
            ∀ (W : S.ProEt) (a : W ⟶ U), P W → T.arrows a := by
        intro P hK
        let JP : GrothendieckTopology S.ProEt :=
          GrothendieckTopology.mk
            (fun U => {T : Sieve U | ∀ (W : S.ProEt) (a : W ⟶ U), P W → T.arrows a})
            (by
              intro U W a _
              trivial)
            (by
              intro U Y T f hT W a hW
              rw [Sieve.pullback_apply]
              exact hT W (a ≫ f) hW)
            (by
              intro U T hT R hR W a hW
              have h1 := hR (hT W a hW) W (𝟙 W) hW
              rw [Sieve.pullback_apply, Category.id_comp] at h1
              exact h1)
        have hle : Scheme.ProEt.topology S ≤ JP := by
          rw [Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
          intro U R hR
          show ∀ (W : S.ProEt) (a : W ⟶ U), P W → (Sieve.generate R).arrows a
          intro W a hW
          obtain ⟨Y, g, h, hg, hhg⟩ := hK U R hR W a hW
          exact ⟨Y, h, g, hg, hhg⟩
        intro U T hT W a hW
        have h1 : T ∈ JP U := GrothendieckTopology.le_def.mp hle U hT
        exact h1 W a hW
      intro V hV T hT
      exact s3 (fun W => Nonempty (W.left ≅ Spec (.of A))) s4 V T hT V (𝟙 V) hV
    intro P
    have hW := hid _ W ⟨e⟩
    constructor
    · intro x y hxy
      have h1 := Presheaf.equalizerSieve_mem (Scheme.ProEt.topology (wcP1Over K).left)
        (toSheafify (Scheme.ProEt.topology (wcP1Over K).left) P) x y hxy
      have h2 := hW _ h1
      rw [Presheaf.equalizerSieve_apply] at h2
      simpa using h2
    · intro s
      have h1 := Presheaf.imageSieve_mem (Scheme.ProEt.topology (wcP1Over K).left)
        (toSheafify (Scheme.ProEt.topology (wcP1Over K).left) P) (U := Opposite.op W) s
      have h2 := hW _ h1
      rw [Presheaf.imageSieve_apply] at h2
      obtain ⟨t, ht⟩ := h2
      exact ⟨t, ht.trans (by simp)⟩

  letI := N.ringA
  haveI := N.hensA
  haveI := N.sepA
  have pW : ∀ t : N.V.left,
      N.V.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)) := by
    intro t
    have h1 : N.e.hom t ⤳ IsLocalRing.closedPoint N.A :=
      IsLocalRing.specializes_closedPoint (R := N.A) (N.e.hom t)
    have h2 : N.e.inv (N.e.hom t) ⤳ N.e.inv (IsLocalRing.closedPoint N.A) :=
      h1.map (Scheme.Hom.continuous N.e.inv)
    rw [Scheme.hom_inv_apply] at h2
    have h3 : N.V.hom t ⤳ x := by
      have := h2.map (Scheme.Hom.continuous N.V.hom)
      rwa [N.hx] at this
    have hxU : x ∈ Uo := (hUo x).mpr hx.2.2
    have htU : N.V.hom t ∈ Uo := h3.mem_open Uo.isOpen hxU
    rintro ⟨i, hi⟩
    exact (hUo _).mp htU i hi.symm

  let a := fun g : Γ => Functor.whiskerRight (NatTrans.op (wcPbAct (q' ≫ Uo.ι) (α g).hom (hα g)))
    (continuousMapPresheafAb.{0, u} (Fin r → ZMod (ℓ ^ n)) ⋙ AddCommGrpCat.uliftFunctor.{u+1, u})
  let b := fun g : Γ => wcTwMatAct (q' ≫ Uo.ι) ℓ n r
    (((ρ g)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))
  let Pz := wcExtZeroPre (wcTwEqPre (wcTwBase (q' ≫ Uo.ι) ℓ n r) a b)
    (fun T : (wcP1Over K).left.ProEt =>
      ∀ t, T.hom t ∉ Set.range (fun i => S i (IsLocalRing.closedPoint K)))
    (fun g h t => by rw [← MorphismProperty.Over.w g, Scheme.Hom.comp_apply]; exact h _)
  have hT := key N.A N.V N.e Pz
  let Θ₀ : ↑(Pz.obj (Opposite.op N.V)) →+
      C(↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)), Fin r → ZMod (ℓ ^ n)) :=
    { toFun := fun x => (Subtype.val (Subtype.val x) :
        ULift.{u+1} C(↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)), Fin r → ZMod (ℓ ^ n))).down
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : (wcTwSh (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
        Γ α hα ℓ n r ρ).obj.obj (Opposite.op N.V) →+
        C(↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)), Fin r → ZMod (ℓ ^ n)),
      ∀ x : ↑(Pz.obj (Opposite.op N.V)),
        Ψ (((toSheafify (Scheme.ProEt.topology (wcP1Over K).left) Pz).app (Opposite.op N.V)).hom x) =
          (Subtype.val (Subtype.val x) :
            ULift.{u+1} C(↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)), Fin r → ZMod (ℓ ^ n))).down :=
    ⟨Θ₀.comp (AddEquiv.ofBijective _ hT).symm.toAddMonoidHom,
      fun x => congrArg Θ₀ ((AddEquiv.ofBijective _ hT).symm_apply_apply x)⟩

  have hmemiff : ∀ u : ULift.{u+1} C(↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)), Fin r → ZMod (ℓ ^ n)),
      (u : (wcTwBase (q' ≫ Uo.ι) ℓ n r).obj (Opposite.op N.V)) ∈
        wcTwEqSub (wcTwBase (q' ≫ Uo.ι) ℓ n r) a b (Opposite.op N.V) ↔
      ∀ (γ : Γ) z, u.down (Limits.pullback.map N.V.hom (q' ≫ Uo.ι) N.V.hom (q' ≫ Uo.ι) (𝟙 _)
          (α γ).hom (𝟙 _) (by simp) (by rw [Category.comp_id]; exact (hα γ).symm) z) =
        Matrix.vecMul (u.down z)
          (((ρ γ)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) := by
    intro u
    refine AddSubgroup.mem_iInf.trans (forall_congr' (fun γ => ?_))
    refine AddMonoidHom.mem_ker.trans ?_
    refine (sub_eq_zero (a := ((a γ).app (Opposite.op N.V)).hom u)
      (b := ((b γ).app (Opposite.op N.V)).hom u)).trans ?_
    constructor
    · intro h z
      exact congrArg (fun w : ULift.{u+1} C(↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)),
        Fin r → ZMod (ℓ ^ n)) => w.down z) h
    · intro h
      exact ULift.ext _ _ (ContinuousMap.ext h)
  refine ⟨Ψ, ?_, ?_, ?_, ?_⟩

  · intro s s' hss
    obtain ⟨x, rfl⟩ := hT.2 s
    obtain ⟨x', rfl⟩ := hT.2 s'
    rw [hΨ, hΨ] at hss
    have hxx : x = x' := by
      apply Subtype.ext
      apply Subtype.ext
      exact ULift.ext _ _ hss
    rw [hxx]

  · intro s γ z
    obtain ⟨x, rfl⟩ := hT.2 s
    rw [hΨ]
    exact (hmemiff _).mp (Subtype.val x).2 γ z

  · intro h hh
    have hu : (ULift.up h : (wcTwBase (q' ≫ Uo.ι) ℓ n r).obj (Opposite.op N.V)) ∈
        wcTwEqSub (wcTwBase (q' ≫ Uo.ι) ℓ n r) a b (Opposite.op N.V) := (hmemiff (ULift.up h)).mpr hh
    let x : ↑(Pz.obj (Opposite.op N.V)) := Subtype.mk (Subtype.mk (ULift.up h) hu)
      (AddSubgroup.mem_iSup_of_mem pW (AddSubgroup.mem_top _))
    exact ⟨((toSheafify (Scheme.ProEt.topology (wcP1Over K).left) Pz).app (Opposite.op N.V)).hom x,
      hΨ x⟩

  · intro s z
    obtain ⟨x, rfl⟩ := hT.2 s
    have hnat : ((wcTwSh (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
          Γ α hα ℓ n r ρ).obj.map N.φ.op).hom
          (((toSheafify (Scheme.ProEt.topology (wcP1Over K).left) Pz).app (Opposite.op N.V)).hom x) =
        ((toSheafify (Scheme.ProEt.topology (wcP1Over K).left) Pz).app (Opposite.op N.V)).hom
          ((Pz.map N.φ.op).hom x) :=
      (congrArg (fun f => f.hom x)
        ((toSheafify (Scheme.ProEt.topology (wcP1Over K).left) Pz).naturality N.φ.op)).symm
    rw [hnat, hΨ, hΨ]
    have e2 := Over.pullback_map_left (q' ≫ Uo.ι) ((Scheme.ProEt.forget (wcP1Over K).left).obj N.V)
      (k := (Scheme.ProEt.forget (wcP1Over K).left).map N.φ)
    have hφQ' : ((wcPbFun (q' ≫ Uo.ι)).map N.φ :
        Limits.pullback N.V.hom (q' ≫ Uo.ι) ⟶ Limits.pullback N.V.hom (q' ≫ Uo.ι)) =
        Limits.pullback.map N.V.hom (q' ≫ Uo.ι) N.V.hom (q' ≫ Uo.ι) N.φ.left (𝟙 V) (𝟙 _)
          (by rw [Category.comp_id]; exact (MorphismProperty.Over.w N.φ).symm) (by simp) := by
      apply Limits.pullback.hom_ext
      · refine ((congrArg (fun f => f ≫ Limits.pullback.fst N.V.hom (q' ≫ Uo.ι)) e2).trans
          (Limits.pullback.lift_fst _ _ _)).trans ?_
        exact (Limits.pullback.lift_fst _ _ _).symm
      · refine ((congrArg (fun f => f ≫ Limits.pullback.snd N.V.hom (q' ≫ Uo.ι)) e2).trans
          (Limits.pullback.lift_snd _ _ _)).trans ?_
        exact ((Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)).symm
    exact congrArg (fun f : Limits.pullback N.V.hom (q' ≫ Uo.ι) ⟶ Limits.pullback N.V.hom (q' ≫ Uo.ι) =>
      (Subtype.val (Subtype.val x) :
        ULift.{u+1} C(↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)), Fin r → ZMod (ℓ ^ n))).down (f z)) hφQ'

theorem wc_finite_henselian_fibre_restrict_bij_discrete (A : Type u) [CommRing A]
    [HenselianLocalRing A] (W Q : Scheme.{u}) (e : W ≅ Spec (.of A)) (f : Q ⟶ W) [IsFinite f]
    (M : Type) [TopologicalSpace M] [DiscreteTopology M] [Nonempty M] :
    Function.Bijective (fun (h : C(↥Q, M)) (z : {z : Q // e.hom (f z) = IsLocalRing.closedPoint A}) =>
      h z.1) :=
by
  classical
  obtain ⟨hfin, hinj2, hsurj2⟩ := wc_finite_henselian_fibre_contfun_bij A W Q e f 2
  haveI := hfin
  constructor
  ·
    intro h₁ h₂ hh
    let χ₀ : M × M → ℤ_[2] := fun ab => if ab.1 = ab.2 then 1 else 0
    let χ : C(↥Q, ℤ_[2]) := ⟨fun p => χ₀ (h₁ p, h₂ p),
      (continuous_of_discreteTopology (f := χ₀)).comp (h₁.continuous.prodMk h₂.continuous)⟩
    have hχ : χ = ContinuousMap.const _ 1 := by
      apply hinj2
      funext z
      have hz : h₁ z.1 = h₂ z.1 := congrFun hh z
      show χ₀ (h₁ z.1, h₂ z.1) = 1
      simp [χ₀, hz]
    ext p
    by_contra hne
    have h1 : χ p = 1 := by rw [hχ]; rfl
    have h0 : χ p = 0 := by
      show χ₀ (h₁ p, h₂ p) = 0
      simp [χ₀, hne]
    rw [h1] at h0
    exact one_ne_zero h0
  ·
    set Fib := {z : Q // e.hom (f z) = IsLocalRing.closedPoint A} with hFib
    intro t
    have hg : ∀ z : Fib, ∃ g : C(↥Q, ℤ_[2]), ∀ z' : Fib,
        g z'.1 = if z' = z then (1 : ℤ_[2]) else 0 := by
      intro z
      obtain ⟨g, hg⟩ := hsurj2 (fun z' => if z' = z then (1 : ℤ_[2]) else 0)
      exact ⟨g, fun z' => congrFun hg z'⟩
    choose g hg using hg
    set B : Set ℤ_[2] := Metric.ball (1 : ℤ_[2]) 1 with hB
    have hBc : IsClopen B := IsUltrametricDist.isClopen_ball (1 : ℤ_[2]) 1
    have h1B : (1 : ℤ_[2]) ∈ B := Metric.mem_ball_self one_pos
    have h0B : (0 : ℤ_[2]) ∉ B := by
      rw [hB, Metric.mem_ball, dist_eq_norm, zero_sub, norm_neg, norm_one]
      exact lt_irrefl 1
    let Φ : ↥Q → (Fib → Bool) := fun p z => decide (g z p ∈ B)
    have hΦc : Continuous Φ := by
      apply continuous_pi
      intro z
      have hU : IsClopen ((g z) ⁻¹' B) := hBc.preimage (g z).continuous
      apply continuous_discrete_rng.mpr
      intro b
      cases b
      · have : (fun p => decide (g z p ∈ B)) ⁻¹' {false} = ((g z) ⁻¹' B)ᶜ := by
          ext p; simp
        rw [this]; exact hU.compl.isOpen
      · have : (fun p => decide (g z p ∈ B)) ⁻¹' {true} = (g z) ⁻¹' B := by
          ext p; simp
        rw [this]; exact hU.isOpen
    let ι : Fib → (Fib → Bool) := fun z z' => decide (z' = z)
    have hΦι : ∀ z : Fib, Φ z.1 = ι z := by
      intro z
      funext z'
      show decide (g z' z.1 ∈ B) = decide (z' = z)
      rw [hg z' z]
      by_cases h : z = z'
      · subst h; simp [h1B]
      · have h' : ¬ z' = z := fun h'' => h h''.symm
        simp [h, h', h0B]
    have hι : Function.Injective ι := by
      intro z₁ z₂ h
      have := congrFun h z₁
      simp only [ι, decide_true] at this
      exact (of_decide_eq_true this.symm)
    obtain ⟨m₀⟩ := (inferInstance : Nonempty M)
    let F : (Fib → Bool) → M := Function.extend ι t (fun _ => m₀)
    have hFc : Continuous F := continuous_of_discreteTopology
    refine ⟨⟨F ∘ Φ, hFc.comp hΦc⟩, ?_⟩
    funext z
    exact (congrArg F (hΦι z)).trans (hι.extend_apply t (fun _ => m₀) z)

theorem wc_galcover_strict_local_fibre_torsor {W X U V : Scheme.{u}} (ι : U ⟶ X) [IsOpenImmersion ι]
    (q' : V ⟶ U) (Γ : Type u) [Group Γ] (α : Γ →* Aut V) (hG : wcGalCover q' Γ α)
    (hα : ∀ γ, (α γ).hom ≫ q' ≫ ι = q' ≫ ι) (f : W ⟶ X)
    [IsFinite (Limits.pullback.fst f (q' ≫ ι))] [Etale (Limits.pullback.fst f (q' ≫ ι))]
    (A : Type u) [CommRing A] [IsLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (eW : W ≅ Spec (.of A)) (z₀ : ↥(Limits.pullback f (q' ≫ ι)))
    (hz₀ : eW.hom (Limits.pullback.fst f (q' ≫ ι) z₀) = IsLocalRing.closedPoint A) :
    (∀ γ γ' : Γ, Limits.pullback.map f (q' ≫ ι) f (q' ≫ ι) (𝟙 _) (α γ).hom (𝟙 _) (by simp)
        (by rw [Category.comp_id]; exact (hα γ).symm) z₀ =
      Limits.pullback.map f (q' ≫ ι) f (q' ≫ ι) (𝟙 _) (α γ').hom (𝟙 _) (by simp)
        (by rw [Category.comp_id]; exact (hα γ').symm) z₀ → γ = γ') ∧
    ∀ z : ↥(Limits.pullback f (q' ≫ ι)),
      eW.hom (Limits.pullback.fst f (q' ≫ ι) z) = IsLocalRing.closedPoint A →
      ∃ γ : Γ, Limits.pullback.map f (q' ≫ ι) f (q' ≫ ι) (𝟙 _) (α γ).hom (𝟙 _) (by simp)
        (by rw [Category.comp_id]; exact (hα γ).symm) z₀ = z :=
by
  classical
  have hpts := (wc_galcover_points q' Γ α hG).1
  obtain ⟨_, _, _, _, hα₀, _⟩ := hG

  have s5 : ∀ {E S : Scheme.{u}} (e : E ⟶ S) [Etale e] (x₀ x : E), e x = e x₀ →
      IsSepClosed (S.residueField (e x₀)) →
      ∃ zt : Spec (E.residueField x₀) ⟶ E, zt ≫ e = E.fromSpecResidueField x₀ ≫ e ∧
        zt (IsLocalRing.closedPoint (E.residueField x₀)) = x := by
    intro E S e _ x₀ x h hs
    have hs1 : IsSepClosed (S.residueField (e x)) := by rw [h]; exact hs
    have hb := wc_etale_residue_surj_of_sepClosed e x hs1
    have hbinj : Function.Injective (e.residueFieldMap x).hom := (e.residueFieldMap x).hom.injective
    let eb := RingEquiv.ofBijective (e.residueFieldMap x).hom ⟨hbinj, hb⟩
    let c : E.residueField x ⟶ E.residueField x₀ :=
      CommRingCat.ofHom eb.symm.toRingHom ≫ (Scheme.residueFieldCongr h).hom ≫
        e.residueFieldMap x₀
    have h1 : e.residueFieldMap x ≫ CommRingCat.ofHom eb.symm.toRingHom = 𝟙 _ := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro t
      exact eb.symm_apply_apply t
    have hbc : e.residueFieldMap x ≫ c = (Scheme.residueFieldCongr h).hom ≫ e.residueFieldMap x₀ := by
      show e.residueFieldMap x ≫ (CommRingCat.ofHom eb.symm.toRingHom ≫
        (Scheme.residueFieldCongr h).hom ≫ e.residueFieldMap x₀) = _
      exact (Category.assoc _ _ _).symm.trans
        ((congrArg (fun t => t ≫ (Scheme.residueFieldCongr h).hom ≫ e.residueFieldMap x₀) h1).trans
          (Category.id_comp _))
    refine ⟨Spec.map c ≫ E.fromSpecResidueField x, ?_, ?_⟩
    · rw [Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField e x,
        ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField e x₀, ← Category.assoc,
        ← Spec.map_comp, hbc, Spec.map_comp, Category.assoc,
        Scheme.residueFieldCongr_fromSpecResidueField]
    · exact (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply x _)

  obtain ⟨act, hact⟩ : ∃ act : Γ → (Limits.pullback f (q' ≫ ι) ⟶ Limits.pullback f (q' ≫ ι)),
      ∀ γ, act γ = Limits.pullback.map f (q' ≫ ι) f (q' ≫ ι) (𝟙 _) (α γ).hom (𝟙 _) (by simp)
        (by rw [Category.comp_id]; exact (hα γ).symm) := ⟨_, fun _ => rfl⟩
  have hact1 : ∀ γ, act γ ≫ Limits.pullback.fst f (q' ≫ ι) = Limits.pullback.fst f (q' ≫ ι) := by
    intro γ
    rw [hact]
    simp only [Limits.pullback.map, Limits.pullback.lift_fst, Category.comp_id]
  have hact2 : ∀ γ, act γ ≫ Limits.pullback.snd f (q' ≫ ι) =
      Limits.pullback.snd f (q' ≫ ι) ≫ (α γ).hom := by
    intro γ
    rw [hact]
    simp only [Limits.pullback.map, Limits.pullback.lift_snd]

  have hfib_eq : ∀ t t' : W, eW.hom t = IsLocalRing.closedPoint A →
      eW.hom t' = IsLocalRing.closedPoint A → t = t' := by
    intro t t' h h'
    have := congrArg eW.inv (h.trans h'.symm)
    rwa [Scheme.hom_inv_apply, Scheme.hom_inv_apply] at this
  have hsep : ∀ t : W, eW.hom t = IsLocalRing.closedPoint A → IsSepClosed (W.residueField t) := by
    intro t ht
    have hcl : IsClosed ({t} : Set W) := by
      have : ({t} : Set W) = eW.hom ⁻¹' {IsLocalRing.closedPoint A} := by
        ext t'
        simp only [Set.mem_singleton_iff, Set.mem_preimage]
        constructor
        · rintro rfl; exact ht
        · intro h; exact hfib_eq t' t h ht
      rw [this]
      exact (IsLocalRing.isClosed_singleton_closedPoint A).preimage (Scheme.Hom.continuous eW.hom)
    exact wc_lft_closed_point_residue_sepclosed A W eW.hom t hcl ht
  have hfst0 : IsSepClosed (W.residueField (Limits.pullback.fst f (q' ≫ ι) z₀)) := hsep _ hz₀
  have hev : ∀ {T : Scheme.{u}} (g : Limits.pullback f (q' ≫ ι) ⟶ T)
      (s : ↥(Spec ((Limits.pullback f (q' ≫ ι)).residueField z₀))),
      ((Limits.pullback f (q' ≫ ι)).fromSpecResidueField z₀ ≫ g) s = g z₀ := by
    intro T g s
    exact (Scheme.Hom.comp_apply _ _ _).trans
      (congrArg g (Scheme.fromSpecResidueField_apply z₀ s))
  refine ⟨fun γ γ' h => ?_, fun z hz => ?_⟩
  ·
    rw [← hact γ, ← hact γ'] at h
    have h12 : (Limits.pullback f (q' ≫ ι)).fromSpecResidueField z₀ ≫ act γ =
        (Limits.pullback f (q' ≫ ι)).fromSpecResidueField z₀ ≫ act γ' := by
      apply wc_finite_point_eq_of_sepClosed (Limits.pullback.fst f (q' ≫ ι))
        ((Limits.pullback f (q' ≫ ι)).residueField z₀) _ _ (Limits.pullback.fst f (q' ≫ ι) z₀)
      · rw [Category.assoc, Category.assoc, hact1, hact1]
      · exact (hev (act γ) _).trans (h.trans (hev (act γ') _).symm)
      · exact (congrArg (Limits.pullback.fst f (q' ≫ ι)) (hev (act γ) _)).trans
          (by rw [← Scheme.Hom.comp_apply, hact1])
      · exact hfst0
    have hy : (Limits.pullback f (q' ≫ ι)).fromSpecResidueField z₀ ≫
        Limits.pullback.snd f (q' ≫ ι) ≫ (α γ).hom =
        (Limits.pullback f (q' ≫ ι)).fromSpecResidueField z₀ ≫
        Limits.pullback.snd f (q' ≫ ι) ≫ (α γ').hom := by
      rw [← hact2, ← hact2, ← Category.assoc, ← Category.assoc, h12]
    have hex := hpts ((Limits.pullback f (q' ≫ ι)).residueField z₀)
      ((Limits.pullback f (q' ≫ ι)).fromSpecResidueField z₀ ≫ Limits.pullback.snd f (q' ≫ ι))
      ((Limits.pullback f (q' ≫ ι)).fromSpecResidueField z₀ ≫
        Limits.pullback.snd f (q' ≫ ι) ≫ (α γ).hom)
      (by simp only [Category.assoc, hα₀ γ])
    exact hex.unique (by simp only [Category.assoc]) (by simp only [Category.assoc]; exact hy)
  ·
    have hzz : Limits.pullback.fst f (q' ≫ ι) z = Limits.pullback.fst f (q' ≫ ι) z₀ :=
      hfib_eq _ _ hz hz₀
    obtain ⟨zt, hzt1, hzt2⟩ := s5 (Limits.pullback.fst f (q' ≫ ι)) z₀ z hzz hfst0
    have hcomm : ((Limits.pullback f (q' ≫ ι)).fromSpecResidueField z₀ ≫
        Limits.pullback.snd f (q' ≫ ι)) ≫ q' = (zt ≫ Limits.pullback.snd f (q' ≫ ι)) ≫ q' := by
      rw [← cancel_mono ι]
      simp only [Category.assoc]
      rw [← Limits.pullback.condition, reassoc_of% hzt1]
    obtain ⟨γ, hγ, -⟩ := hpts ((Limits.pullback f (q' ≫ ι)).residueField z₀) _ _ hcomm
    have hzt : zt = (Limits.pullback f (q' ≫ ι)).fromSpecResidueField z₀ ≫ act γ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hact1, hzt1]
      · rw [Category.assoc, hact2, hγ, Category.assoc]
    refine ⟨γ, ?_⟩
    rw [← hact γ]
    rw [hzt] at hzt2
    exact (hev (act γ) _).symm.trans hzt2

theorem wc_frobNbhd_residue_frob_inverse (K : Type u) [Field K] (x : (wcP1Over K).left) (d : ℕ)
    (N : wcFrobNbhd K x d) :
    letI := N.ringA; haveI := N.hensA;
    ∃ ψb : IsLocalRing.ResidueField N.A →+* IsLocalRing.ResidueField N.A,
      (∀ b, ψb b ^ (Nat.card K ^ d) = b) ∧
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue N.A)) ≫ N.e.inv ≫ N.φ.left =
        Spec.map (CommRingCat.ofHom ψb) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue N.A)) ≫
          N.e.inv :=
by
  letI := N.ringA
  haveI := N.hensA
  have s1 : ∀ a ∈ IsLocalRing.maximalIdeal N.A, N.ψ a ∈ IsLocalRing.maximalIdeal N.A := by
    intro a ha
    have h1 := N.hfrob a
    have h2 : N.ψ a ^ (Nat.card K ^ d) ∈ IsLocalRing.maximalIdeal N.A := by
      have := Ideal.add_mem _ h1 ha
      rwa [sub_add_cancel] at this
    exact (IsLocalRing.maximalIdeal.isMaximal N.A).isPrime.mem_of_pow_mem _ h2
  haveI hloc : IsLocalHom N.ψ := by
    refine IsLocalHom.mk (fun a ha => ?_)
    by_contra hna
    have hm : a ∈ IsLocalRing.maximalIdeal N.A := by
      rwa [← IsLocalRing.notMem_maximalIdeal, not_not] at hna
    exact (IsLocalRing.notMem_maximalIdeal.mpr ha) (s1 a hm)
  refine ⟨IsLocalRing.ResidueField.map N.ψ, ?_, ?_⟩
  · intro b
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective b
    rw [IsLocalRing.ResidueField.map_residue, ← map_pow, ← sub_eq_zero, ← map_sub,
      IsLocalRing.residue_eq_zero_iff]
    exact N.hfrob a
  · have s5 : N.e.inv ≫ N.φ.left = Spec.map (CommRingCat.ofHom N.ψ) ≫ N.e.inv := by
      rw [Iso.eq_comp_inv, Category.assoc]
      exact N.hψ
    rw [s5, ← Category.assoc, ← Spec.map_comp, ← Category.assoc, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
      IsLocalRing.ResidueField.map_comp_residue]

theorem wc_frobNbhd_kbar_point_transport (K : Type u) [Field K] [Finite K] (x : (wcP1Over K).left)
    (d : ℕ) (hd : d ≠ 0) (hx : x ∈ wcP1ClosedPt K d) (N : wcFrobNbhd K x d) {V : Scheme.{u}}
    (q : V ⟶ (wcP1Over K).left) (v : Spec (.of (AlgebraicClosure K)) ⟶ V)
    (hv2 : (v ≫ q) (IsLocalRing.closedPoint (AlgebraicClosure K)) = x) (e : ℕ) (b : V ⟶ V)
    (hv3 : wcFrE K e ≫ v ≫ b = v) :
    letI := N.ringA; haveI := N.hensA;
    ∃ (σ : IsLocalRing.ResidueField N.A →+* IsLocalRing.ResidueField N.A)
      (y₀ : Spec (.of (IsLocalRing.ResidueField N.A)) ⟶ V),
      (∀ t, σ t = t ^ (Nat.card K ^ e)) ∧
      y₀ ≫ q = Spec.map (CommRingCat.ofHom (IsLocalRing.residue N.A)) ≫ N.e.inv ≫ N.V.hom ∧
      Spec.map (CommRingCat.ofHom σ) ≫ y₀ ≫ b = y₀ :=
by
  classical
  letI := N.ringA
  haveI := N.hensA
  haveI := N.sepA

  have factor : ∀ (L : Type u) [Field L] (y : (wcP1Over K).left)
      (p : Spec (CommRingCat.of L) ⟶ (wcP1Over K).left),
      p (IsLocalRing.closedPoint L) = y →
      ∃ j : (wcP1Over K).left.residueField y ⟶ CommRingCat.of L,
        p = Spec.map j ≫ (wcP1Over K).left.fromSpecResidueField y := by
    intro L _ y p hp
    have h1 := Scheme.SpecToEquivOfField_apply_fst L (wcP1Over K).left p
    have h2 : p = (Scheme.SpecToEquivOfField L (wcP1Over K).left).symm
        (Scheme.SpecToEquivOfField L (wcP1Over K).left p) := (Equiv.symm_apply_apply _ _).symm
    generalize Scheme.SpecToEquivOfField L (wcP1Over K).left p = f at h1 h2
    obtain ⟨y', j'⟩ := f
    have h3 : y' = y := h1.trans hp
    subst h3
    exact ⟨j', by rw [h2, Scheme.SpecToEquivOfField_symm_apply]⟩

  have hp2 : (Spec.map (CommRingCat.ofHom (IsLocalRing.residue N.A)) ≫ N.e.inv ≫ N.V.hom)
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField N.A)) = x := by
    have h : (Spec.map (CommRingCat.ofHom (IsLocalRing.residue N.A)))
        (IsLocalRing.closedPoint (IsLocalRing.ResidueField N.A)) = IsLocalRing.closedPoint N.A :=
      IsLocalRing.PrimeSpectrum.comap_residue N.A _
    refine (Scheme.Hom.comp_apply _ _ _).trans ?_
    refine (Scheme.Hom.comp_apply _ _ _).trans ?_
    refine (congrArg (fun t => N.V.hom (N.e.inv t)) h).trans ?_
    exact N.hx

  haveI hfin : Finite ((wcP1Over K).left.residueField x) := by
    obtain ⟨-, h⟩ := hx
    letI : Module K ((wcP1Over K).left.residueField x) :=
      (((wcP1Over K).left.residue x).hom.comp (wcLdpConst K (wcP1Over K).hom x)).toModule
    have hpos : 0 < Module.finrank K ((wcP1Over K).left.residueField x) := by
      rw [h]; omega
    haveI := Module.finite_of_finrank_pos hpos
    exact Module.finite_of_finite K

  have hpow : ∀ a : AlgebraicClosure K, ∃ n : ℕ, 1 < n ∧ a ^ n = a := by
    intro a
    haveI : FiniteDimensional K (IntermediateField.adjoin K {a}) :=
      IntermediateField.adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral a)
    haveI : Finite (IntermediateField.adjoin K {a}) := Module.finite_of_finite K
    letI : Fintype (IntermediateField.adjoin K {a}) := Fintype.ofFinite _
    refine ⟨Fintype.card (IntermediateField.adjoin K {a}), Fintype.one_lt_card, ?_⟩
    have h := FiniteField.pow_card
      (⟨a, IntermediateField.mem_adjoin_simple_self K a⟩ : IntermediateField.adjoin K {a})
    simpa using congrArg (fun z : IntermediateField.adjoin K {a} => (z : AlgebraicClosure K)) h
  obtain ⟨j₁, hj₁⟩ := factor (AlgebraicClosure K) x (v ≫ q) hv2
  obtain ⟨j₂, hj₂⟩ := factor (IsLocalRing.ResidueField N.A) x _ hp2

  obtain ⟨τ, hτ⟩ : ∃ τ : AlgebraicClosure K →+* IsLocalRing.ResidueField N.A,
      τ.comp j₁.hom = j₂.hom := by
    letI : Algebra ((wcP1Over K).left.residueField x) (AlgebraicClosure K) := j₁.hom.toAlgebra
    letI : Algebra ((wcP1Over K).left.residueField x) (IsLocalRing.ResidueField N.A) :=
      j₂.hom.toAlgebra
    haveI : Algebra.IsAlgebraic ((wcP1Over K).left.residueField x) (AlgebraicClosure K) := by
      constructor
      intro a
      obtain ⟨n, hn, han⟩ := hpow a
      refine ⟨Polynomial.X ^ n - Polynomial.X, FiniteField.X_pow_card_sub_X_ne_zero _ hn, ?_⟩
      simp [han]
    haveI : PerfectField ((wcP1Over K).left.residueField x) := PerfectField.ofFinite
    haveI : Algebra.IsSeparable ((wcP1Over K).left.residueField x) (AlgebraicClosure K) :=
      Algebra.IsAlgebraic.isSeparable_of_perfectField
    let τ' : AlgebraicClosure K →ₐ[(wcP1Over K).left.residueField x]
        IsLocalRing.ResidueField N.A := IsSepClosed.lift
    refine ⟨(τ' : AlgebraicClosure K →+* IsLocalRing.ResidueField N.A), ?_⟩
    ext c
    exact τ'.commutes c
  have hjj : j₁ ≫ CommRingCat.ofHom τ = j₂ := by
    ext c
    exact RingHom.congr_fun hτ c

  obtain ⟨σ, hσ⟩ : ∃ σ : IsLocalRing.ResidueField N.A →+* IsLocalRing.ResidueField N.A,
      ∀ t, σ t = t ^ (Nat.card K ^ e) := by
    letI : Algebra K (IsLocalRing.ResidueField N.A) :=
      (τ.comp (algebraMap K (AlgebraicClosure K))).toAlgebra
    letI : Fintype K := Fintype.ofFinite K
    refine ⟨((FiniteField.frobeniusAlgHom K (IsLocalRing.ResidueField N.A) ^ e :
      IsLocalRing.ResidueField N.A →ₐ[K] IsLocalRing.ResidueField N.A) :
        IsLocalRing.ResidueField N.A →+* IsLocalRing.ResidueField N.A), fun t => ?_⟩
    rw [Nat.card_eq_fintype_card]
    show (FiniteField.frobeniusAlgHom K (IsLocalRing.ResidueField N.A) ^ e) t = _
    rw [AlgHom.coe_pow, FiniteField.coe_frobeniusAlgHom, pow_iterate]

  have hFr : ∀ (n : ℕ) (a : AlgebraicClosure K),
      (@FiniteField.frobeniusAlgEquivOfAlgebraic K _ (Fintype.ofFinite K)
        (AlgebraicClosure K) _ _ _ ^ n) a = a ^ (Nat.card K ^ n) := by
    intro n
    induction n with
    | zero => intro a; simp
    | succ n ih =>
      intro a
      rw [pow_succ', AlgEquiv.mul_apply, ih, FiniteField.frobeniusAlgEquivOfAlgebraic_apply,
        ← pow_mul, @Nat.card_eq_fintype_card K (Fintype.ofFinite K), pow_succ]
  have hint : Spec.map (CommRingCat.ofHom τ) ≫ wcFrE K e =
      Spec.map (CommRingCat.ofHom σ) ≫ Spec.map (CommRingCat.ofHom τ) := by
    unfold wcFrE
    rw [← Spec.map_comp, ← Spec.map_comp]
    congr 1
    ext a
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply, hσ,
      RingHom.coe_coe]
    rw [hFr, map_pow]

  refine ⟨σ, Spec.map (CommRingCat.ofHom τ) ≫ v, hσ, ?_, ?_⟩
  · rw [Category.assoc, hj₁, ← Category.assoc, ← Spec.map_comp, hjj, hj₂]
  · simp only [Category.assoc]
    rw [← Category.assoc, ← hint, Category.assoc, hv3]

theorem wc_pullback_frob_twisted_fibre_point {S W V : Scheme.{u}} (f : W ⟶ S) (q : V ⟶ S)
    (φ : W ⟶ W) (hφ : φ ≫ f = f) (a : V ⟶ V) (ha : a ≫ q = q) (L : Type u) [Field L]
    (cb : Spec (.of L) ⟶ W) (y₀ : Spec (.of L) ⟶ V) (hy : cb ≫ f = y₀ ≫ q) (ψb σ : L →+* L)
    (hc : cb ≫ φ = Spec.map (CommRingCat.ofHom ψb) ≫ cb) (k : ℕ) (hσ : ∀ t, (ψb ^ k) (σ t) = t)
    (hk : Spec.map (CommRingCat.ofHom σ) ≫ y₀ = y₀ ≫ a) :
    ∃ z₀ : ↥(Limits.pullback f q), Limits.pullback.fst f q z₀ = cb (IsLocalRing.closedPoint L) ∧
      (⇑(Limits.pullback.map f q f q φ (𝟙 V) (𝟙 S) (by rw [Category.comp_id, hφ]) (by simp)))^[k] z₀ =
        Limits.pullback.map f q f q (𝟙 W) a (𝟙 S) (by simp) (by rw [Category.comp_id, ha]) z₀ :=
by
  set Φ := Limits.pullback.map f q f q φ (𝟙 V) (𝟙 S) (by rw [Category.comp_id, hφ]) (by simp)
    with hΦ
  set A := Limits.pullback.map f q f q (𝟙 W) a (𝟙 S) (by simp) (by rw [Category.comp_id, ha])
    with hA
  have hΦf : Φ ≫ Limits.pullback.fst f q = Limits.pullback.fst f q ≫ φ :=
    Limits.pullback.lift_fst _ _ _
  have hΦs : Φ ≫ Limits.pullback.snd f q = Limits.pullback.snd f q :=
    (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
  have hAf : A ≫ Limits.pullback.fst f q = Limits.pullback.fst f q :=
    (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have hAs : A ≫ Limits.pullback.snd f q = Limits.pullback.snd f q ≫ a :=
    Limits.pullback.lift_snd _ _ _
  have hSp : ∀ g₁ g₂ : L →+* L, Spec.map (CommRingCat.ofHom g₂) ≫ Spec.map (CommRingCat.ofHom g₁)
      = Spec.map (CommRingCat.ofHom (g₂ * g₁)) := by
    intro g₁ g₂
    rw [RingHom.mul_def, CommRingCat.ofHom_comp, Spec.map_comp]
  have hSp1 : Spec.map (CommRingCat.ofHom (1 : L →+* L)) = 𝟙 _ := by
    rw [RingHom.one_def, CommRingCat.ofHom_id, Spec.map_id]
  set zt := Limits.pullback.lift cb y₀ hy with hzt
  have hztf : zt ≫ Limits.pullback.fst f q = cb := Limits.pullback.lift_fst _ _ _
  have hzts : zt ≫ Limits.pullback.snd f q = y₀ := Limits.pullback.lift_snd _ _ _
  suffices H : ∀ x : ↥(Spec (.of L)), ∃ z₀ : ↥(Limits.pullback f q),
      Limits.pullback.fst f q z₀ = cb x ∧ (⇑Φ)^[k] z₀ = A z₀ from
    H (IsLocalRing.closedPoint L)
  intro x
  refine ⟨zt x, ?_, ?_⟩
  · rw [← Scheme.Hom.comp_apply, hztf]
  · have inv : ∀ j : ℕ, ∃ g : Spec (.of L) ⟶ Limits.pullback f q,
        g x = (⇑Φ)^[j] (zt x) ∧
        g ≫ Limits.pullback.fst f q = Spec.map (CommRingCat.ofHom (ψb ^ j)) ≫ cb ∧
        g ≫ Limits.pullback.snd f q = y₀ := by
      intro j
      induction j with
      | zero =>
        exact ⟨zt, rfl, by rw [pow_zero, hSp1, Category.id_comp, hztf], hzts⟩
      | succ j ih =>
        obtain ⟨g, h1, h2, h3⟩ := ih
        refine ⟨g ≫ Φ, ?_, ?_, ?_⟩
        · rw [Scheme.Hom.comp_apply, h1, Function.iterate_succ_apply']
        · rw [Category.assoc, hΦf, ← Category.assoc, h2, Category.assoc, hc, ← Category.assoc,
            hSp, ← pow_succ]
        · rw [Category.assoc, hΦs, h3]
    obtain ⟨g, h1, h2, h3⟩ := inv k
    have hcomp : (ψb ^ k) * σ = 1 := RingHom.ext fun t => by
      rw [RingHom.mul_def, RingHom.comp_apply, hσ]
      rfl
    have hh : g = Spec.map (CommRingCat.ofHom (ψb ^ k)) ≫ zt ≫ A := by
      apply Limits.pullback.hom_ext
      · rw [h2, Category.assoc, Category.assoc, hAf, hztf]
      · rw [h3, Category.assoc, Category.assoc, hAs, ← Category.assoc zt, hzts, ← hk,
          ← Category.assoc, hSp, hcomp, hSp1, Category.id_comp]
    have hpt : (Spec.map (CommRingCat.ofHom (ψb ^ k))) x = x := Subsingleton.elim _ _
    rw [← h1, hh, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply, hpt]

theorem wc_pullback_fst_finite_etale_of_open_factor {W X U V : Scheme.{u}} (ι : U ⟶ X)
    [IsOpenImmersion ι] (q' : V ⟶ U) [IsFinite q'] [Etale q'] (f : W ⟶ X) (f' : W ⟶ U)
    (hf : f' ≫ ι = f) :
    IsFinite (Limits.pullback.fst f (q' ≫ ι)) ∧ Etale (Limits.pullback.fst f (q' ≫ ι)) :=
by
  subst hf
  have hcomm : Limits.pullback.fst (f' ≫ ι) (q' ≫ ι) ≫ f' =
      Limits.pullback.snd (f' ≫ ι) (q' ≫ ι) ≫ q' := by
    rw [← cancel_mono ι]
    simp only [Category.assoc]
    exact Limits.pullback.condition
  have hR : IsPullback (𝟙 W) f' (f' ≫ ι) ι := by
    have h := IsPullback.paste_vert (IsPullback.of_id_fst (f := f'))
      ((mono_iff_isPullback ι).1 inferInstance)
    rw [Category.comp_id] at h
    exact h
  have hO : IsPullback (Limits.pullback.fst (f' ≫ ι) (q' ≫ ι) ≫ 𝟙 W)
      (Limits.pullback.snd (f' ≫ ι) (q' ≫ ι)) (f' ≫ ι) (q' ≫ ι) := by
    rw [Category.comp_id]
    exact IsPullback.of_hasPullback _ _
  have hsq := IsPullback.of_right hO hcomm hR
  exact ⟨MorphismProperty.of_isPullback (P := @IsFinite) hsq.flip inferInstance,
    MorphismProperty.of_isPullback (P := @Etale) hsq.flip inferInstance⟩

theorem wc_twsh_stalk_frobenius_eval (K : Type u) [Field K] [Finite K] (m : ℕ)
    (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left)) (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (Uo : (wcP1Over K).left.Opens)
    (hUo : ∀ p : (wcP1Over K).left, p ∈ Uo ↔ ∀ i, p ≠ S i (IsLocalRing.closedPoint K))
    {V : Scheme.{u}} (q' : V ⟶ Uo.toScheme) (Γ : Type u) [Group Γ] (α : Γ →* Aut V)
    (hG : wcGalCover q' Γ α) (hα : ∀ γ, (α γ).hom ≫ q' ≫ Uo.ι = q' ≫ Uo.ι)
    (ℓ n r : ℕ) (ρ : Γ →* GL (Fin r) (ZMod (ℓ ^ n))) (hn : 1 ≤ n)
    (d : ℕ) (x : (wcP1Over K).left) (hx : x ∈ wcOffS K m S d) (N : wcFrobNbhd K x d)
    (e : ℕ) (hde : d ∣ e) (v : Spec (.of (AlgebraicClosure K)) ⟶ V) (g : Γ)
    (hv1 : v ≫ q' ≫ Uo.ι ≫ (wcP1Over K).hom = wcKbarPt K)
    (hv2 : (v ≫ q' ≫ Uo.ι) (IsLocalRing.closedPoint (AlgebraicClosure K)) = x)
    (hv3 : wcFrE K e ≫ v ≫ (α g).hom = v) :
    ∃ (θ : (wcTwSh (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
        Γ α hα ℓ n r ρ).obj.obj (Opposite.op N.V) ≃+ (Fin r → ZMod (ℓ ^ n)))
      (Rm : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))),
      Rm.trace = ((ρ g : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))).trace ∧
      ∀ s, θ ((⇑((wcTwSh (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
        Γ α hα ℓ n r ρ).obj.map N.φ.op).hom)^[e / d] s) = Matrix.vecMul (θ s) Rm :=
by
  classical
  letI := N.ringA
  haveI := N.hensA
  haveI := N.sepA
  have hG0 := hG
  obtain ⟨_, hfin, het, -, -, -⟩ := hG0

  have htU : ∀ t : N.V.left, N.V.hom t ∈ Uo := by
    intro t
    have h1 : N.e.hom t ⤳ IsLocalRing.closedPoint N.A :=
      IsLocalRing.specializes_closedPoint (R := N.A) (N.e.hom t)
    have h2 : N.e.inv (N.e.hom t) ⤳ N.e.inv (IsLocalRing.closedPoint N.A) :=
      h1.map (Scheme.Hom.continuous N.e.inv)
    rw [Scheme.hom_inv_apply] at h2
    have h3 : N.V.hom t ⤳ x := by
      have := h2.map (Scheme.Hom.continuous N.V.hom)
      rwa [N.hx] at this
    exact h3.mem_open Uo.isOpen ((hUo x).mpr hx.2.2)
  have hr : Set.range N.V.hom ⊆ Set.range Uo.ι := by
    rintro _ ⟨t, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact htU t
  have hf' : IsOpenImmersion.lift Uo.ι N.V.hom hr ≫ Uo.ι = N.V.hom :=
    IsOpenImmersion.lift_fac _ _ _
  haveI := hfin
  haveI := het
  obtain ⟨hFfin, hFet⟩ := wc_pullback_fst_finite_etale_of_open_factor Uo.ι q' N.V.hom
    (IsOpenImmersion.lift Uo.ι N.V.hom hr) hf'
  haveI := hFfin
  haveI := hFet

  obtain ⟨Ψ, hΨinj, hΨeq, hΨsurj, hΨF⟩ :=
    wc_twsh_strict_local_sections_model K m S Uo hUo q' Γ α hα ℓ n r ρ d x hx N

  obtain ⟨ψb, hψb, hc4⟩ := wc_frobNbhd_residue_frob_inverse K x d N
  obtain ⟨σ, y₀, hσ, hy, hk0⟩ := wc_frobNbhd_kbar_point_transport K x d hx.1 hx.2.1 N
    (q' ≫ Uo.ι) v hv2 e (α g).hom hv3
  have hcomp : ∀ a b : Γ, (α a).hom ≫ (α b).hom = (α (b * a)).hom := by
    intro a b
    rw [map_mul, Aut.Aut_mul_def]
    rfl
  have hone : (α 1).hom = 𝟙 _ := by
    rw [map_one]
    rfl
  have hk : Spec.map (CommRingCat.ofHom σ) ≫ y₀ = y₀ ≫ (α g⁻¹).hom := by
    have h := congrArg (fun t => t ≫ (α g⁻¹).hom) hk0
    simp only [Category.assoc, hcomp, inv_mul_cancel, hone, Category.comp_id] at h
    exact h

  obtain ⟨c, hc'⟩ := hde
  have hkd : e / d = c := by
    rw [hc']
    exact Nat.mul_div_cancel_left c (Nat.pos_of_ne_zero hx.1)
  have hQ : Nat.card K ^ e = (Nat.card K ^ d) ^ c := by rw [hc', pow_mul]
  have hψpow : ∀ (j : ℕ) (t : IsLocalRing.ResidueField N.A),
      (⇑ψb)^[j] (t ^ ((Nat.card K ^ d) ^ j)) = t := by
    intro j
    induction j with
    | zero => intro t; simp
    | succ j ih =>
      intro t
      rw [Function.iterate_succ_apply, pow_succ (Nat.card K ^ d) j, pow_mul t, map_pow, hψb, ih]
  have hσ' : ∀ t, (ψb ^ (e / d)) (σ t) = t := by
    intro t
    rw [hkd, RingHom.coe_pow, hσ, hQ, hψpow]

  obtain ⟨z₀, hz₀fst, hz₀⟩ := wc_pullback_frob_twisted_fibre_point N.V.hom (q' ≫ Uo.ι) N.φ.left
    (MorphismProperty.Over.w N.φ) (α g⁻¹).hom (hα g⁻¹) (IsLocalRing.ResidueField N.A)
    (Spec.map (CommRingCat.ofHom (IsLocalRing.residue N.A)) ≫ N.e.inv) y₀
    ((Category.assoc _ _ _).trans hy.symm) ψb σ ((Category.assoc _ _ _).trans hc4) (e / d) hσ' hk
  have hz₀F : N.e.hom (Limits.pullback.fst N.V.hom (q' ≫ Uo.ι) z₀) =
      IsLocalRing.closedPoint N.A := by
    rw [hz₀fst]
    exact (congrArg N.e.hom (Scheme.Hom.comp_apply _ _ _)).trans
      ((Scheme.inv_hom_apply _ _).trans (IsLocalRing.PrimeSpectrum.comap_residue N.A _))

  obtain ⟨act, hact⟩ : ∃ act : Γ → ↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)) →
      ↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)), ∀ γ z, act γ z =
        Limits.pullback.map N.V.hom (q' ≫ Uo.ι) N.V.hom (q' ≫ Uo.ι) (𝟙 _) (α γ).hom (𝟙 _)
          (by simp) (by rw [Category.comp_id]; exact (hα γ).symm) z := ⟨_, fun _ _ => rfl⟩
  obtain ⟨Φf, hΦf⟩ : ∃ Φf : ↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)) →
      ↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)), ∀ z, Φf z =
        Limits.pullback.map N.V.hom (q' ≫ Uo.ι) N.V.hom (q' ≫ Uo.ι) N.φ.left (𝟙 V) (𝟙 _)
          (by rw [Category.comp_id]; exact (MorphismProperty.Over.w N.φ).symm) (by simp) z := ⟨_, fun _ => rfl⟩
  have hM1 : ∀ γ : Γ, Limits.pullback.map N.V.hom (q' ≫ Uo.ι) N.V.hom (q' ≫ Uo.ι) (𝟙 _)
      (α γ).hom (𝟙 _) (by simp) (by rw [Category.comp_id]; exact (hα γ).symm) ≫
        Limits.pullback.fst N.V.hom (q' ≫ Uo.ι) = Limits.pullback.fst N.V.hom (q' ≫ Uo.ι) := by
    intro γ
    simp only [Limits.pullback.map, Limits.pullback.lift_fst, Category.comp_id]
  have hM2 : ∀ γ δ : Γ, Limits.pullback.map N.V.hom (q' ≫ Uo.ι) N.V.hom (q' ≫ Uo.ι) (𝟙 _)
      (α δ).hom (𝟙 _) (by simp) (by rw [Category.comp_id]; exact (hα δ).symm) ≫
      Limits.pullback.map N.V.hom (q' ≫ Uo.ι) N.V.hom (q' ≫ Uo.ι) (𝟙 _)
      (α γ).hom (𝟙 _) (by simp) (by rw [Category.comp_id]; exact (hα γ).symm) =
      Limits.pullback.map N.V.hom (q' ≫ Uo.ι) N.V.hom (q' ≫ Uo.ι) (𝟙 _)
      (α (γ * δ)).hom (𝟙 _) (by simp) (by rw [Category.comp_id]; exact (hα (γ * δ)).symm) := by
    intro γ δ
    apply Limits.pullback.hom_ext
    · simp only [Limits.pullback.map, Category.assoc, Limits.pullback.lift_fst,
        Limits.pullback.lift_fst_assoc, Category.comp_id]
    · simp only [Limits.pullback.map, Category.assoc, Limits.pullback.lift_snd,
        Limits.pullback.lift_snd_assoc, hcomp]
  have hM3 : Limits.pullback.map N.V.hom (q' ≫ Uo.ι) N.V.hom (q' ≫ Uo.ι) (𝟙 _)
      (α 1).hom (𝟙 _) (by simp) (by rw [Category.comp_id]; exact (hα 1).symm) = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · simp only [Limits.pullback.map, Limits.pullback.lift_fst, Category.comp_id,
        Category.id_comp]
    · simp only [Limits.pullback.map, Limits.pullback.lift_snd, hone, Category.comp_id,
        Category.id_comp]
  have hfstact : ∀ γ z, Limits.pullback.fst N.V.hom (q' ≫ Uo.ι) (act γ z) =
      Limits.pullback.fst N.V.hom (q' ≫ Uo.ι) z := by
    intro γ z
    rw [hact, ← Scheme.Hom.comp_apply, hM1]
  have hactmul : ∀ γ δ z, act γ (act δ z) = act (γ * δ) z := by
    intro γ δ z
    rw [hact, hact, hact, ← Scheme.Hom.comp_apply, hM2]
  have hact1 : ∀ z, act 1 z = z := by
    intro z
    rw [hact, hM3]
    rfl
  have hactc : ∀ γ, Continuous (act γ) := by
    intro γ
    have : act γ = fun z => Limits.pullback.map N.V.hom (q' ≫ Uo.ι) N.V.hom (q' ≫ Uo.ι) (𝟙 _)
        (α γ).hom (𝟙 _) (by simp) (by rw [Category.comp_id]; exact (hα γ).symm) z :=
      funext (hact γ)
    rw [this]
    exact Scheme.Hom.continuous _
  have hΨeq' : ∀ s γ z, Ψ s (act γ z) = Matrix.vecMul (Ψ s z)
      (((ρ γ)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) :=
    fun s γ z => (congrArg (Ψ s) (hact γ z)).trans (hΨeq s γ z)
  have hΨF' : ∀ s z, Ψ (((wcTwSh (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
      Γ α hα ℓ n r ρ).obj.map N.φ.op).hom s) z = Ψ s (Φf z) :=
    fun s z => (hΨF s z).trans (congrArg (Ψ s) (hΦf z)).symm

  obtain ⟨htinj, htsurj⟩ := wc_galcover_strict_local_fibre_torsor Uo.ι q' Γ α hG hα N.V.hom
    N.A N.e z₀ hz₀F
  have htinj' : ∀ γ γ', act γ z₀ = act γ' z₀ → γ = γ' := fun γ γ' h =>
    htinj γ γ' ((hact γ z₀).symm.trans (h.trans (hact γ' z₀)))
  have htsurj' : ∀ z, N.e.hom (Limits.pullback.fst N.V.hom (q' ≫ Uo.ι) z) =
      IsLocalRing.closedPoint N.A → ∃ γ, act γ z₀ = z := fun z hz => by
    obtain ⟨γ, hγ⟩ := htsurj z hz
    exact ⟨γ, (hact γ z₀).trans hγ⟩
  have hfib : ∀ γ, N.e.hom (Limits.pullback.fst N.V.hom (q' ≫ Uo.ι) (act γ z₀)) =
      IsLocalRing.closedPoint N.A := fun γ => by rw [hfstact]; exact hz₀F
  have hres := wc_finite_henselian_fibre_restrict_bij_discrete N.A N.V.left
    (Limits.pullback N.V.hom (q' ≫ Uo.ι)) N.e (Limits.pullback.fst N.V.hom (q' ≫ Uo.ι))
    (Fin r → ZMod (ℓ ^ n))

  let θh : (wcTwSh (q' ≫ Uo.ι) (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
      Γ α hα ℓ n r ρ).obj.obj (Opposite.op N.V) →+ (Fin r → ZMod (ℓ ^ n)) :=
    { toFun := fun s => Ψ s z₀
      map_zero' := by simp only [map_zero, ContinuousMap.zero_apply]
      map_add' := fun a b => by simp only [map_add, ContinuousMap.add_apply] }
  have hθinj : Function.Injective θh := by
    rw [injective_iff_map_eq_zero]
    intro s hs
    have hs' : Ψ s z₀ = 0 := hs
    apply hΨinj
    rw [map_zero]
    apply hres.1
    funext ⟨z, hz⟩
    obtain ⟨γ, rfl⟩ := htsurj' z hz
    show Ψ s (act γ z₀) = (0 : C(_, _)) (act γ z₀)
    rw [hΨeq', hs', Matrix.zero_vecMul, ContinuousMap.zero_apply]
  have hθsurj : Function.Surjective θh := by
    intro w
    let t : {z : ↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)) //
        N.e.hom (Limits.pullback.fst N.V.hom (q' ≫ Uo.ι) z) = IsLocalRing.closedPoint N.A} →
        (Fin r → ZMod (ℓ ^ n)) := fun z => Matrix.vecMul w
      (((ρ (Classical.choose (htsurj' z.1 z.2)))⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) :
        Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n)))
    obtain ⟨h, hh⟩ := hres.2 t
    have hh' : ∀ γ, h (act γ z₀) = Matrix.vecMul w
        (((ρ γ)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) := by
      intro γ
      have h1 := congrFun hh ⟨act γ z₀, hfib γ⟩
      have h2 : Classical.choose (htsurj' (act γ z₀) (hfib γ)) = γ :=
        htinj' _ _ (Classical.choose_spec (htsurj' (act γ z₀) (hfib γ)))
      refine h1.trans ?_
      show Matrix.vecMul w (((ρ (Classical.choose (htsurj' (act γ z₀) (hfib γ))))⁻¹ :
        GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) = _
      rw [h2]
    have heq : ∀ γ z, h (act γ z) = Matrix.vecMul (h z)
        (((ρ γ)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) := by
      intro γ
      let h1 : C(↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)), Fin r → ZMod (ℓ ^ n)) :=
        ⟨fun z => h (act γ z), h.continuous.comp (hactc γ)⟩
      let h2 : C(↥(Limits.pullback N.V.hom (q' ≫ Uo.ι)), Fin r → ZMod (ℓ ^ n)) :=
        ⟨fun z => Matrix.vecMul (h z)
          (((ρ γ)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))),
          (continuous_of_discreteTopology (f := fun u : Fin r → ZMod (ℓ ^ n) => Matrix.vecMul u
            (((ρ γ)⁻¹ : GL (Fin r) (ZMod (ℓ ^ n))) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))))).comp
            h.continuous⟩
