        rw [ha, hp, Category.comp_id, Category.id_comp]
      refine ab _ Limits.equalizer.ι_mono _ _ (twF _ hu k) ?_
      apply Limits.Pi.hom_ext
      intro i
      simp only [Limits.Pi.map_π, HomologicalComplex.id_f, Category.comp_id, Category.id_comp]
  have hid : ∀ {Y : CochainComplex AddCommGrpCat.{u+1} ℕ} (lamY : MonoidAlgebra ℤ_[ℓ] Γ → (Y ⟶ Y)),
      ∀ x, lamY x ≫ 𝟙 Y = 𝟙 Y ≫ lamY x := fun _ x => by
    rw [Category.comp_id, Category.id_comp]
  have hβγ : ∀ x, wcSmsBarSmul P n x ≫ (β' ≫ γ) = (β' ≫ γ) ≫ wcSmsBarSmul P n x := fun x => by
    rw [← Category.assoc, hβlin, Category.assoc, hγ, Category.assoc]
  have hγβ : ∀ x, wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n) (wcCxJMap K hP (lamI x)) ≫
