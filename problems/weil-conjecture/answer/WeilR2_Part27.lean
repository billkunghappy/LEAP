      (Fin k → ZMod (ℓ ^ r)) (Fin k → ZMod (ℓ ^ r)) W β
    have hβ : ∀ (V₁ : (wcP1Over K).left.ProEt) (v : V₁ ⟶ W) (x : L.obj.obj (Opposite.op V₁)),
