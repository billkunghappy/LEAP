    exact wc_pencil_VQ_local_rationality_nm F' F'' Y n hn hn2 D hNM ℓ hℓ hP hNI d hd _ hxC hxS m
  · intro d x
    obtain ⟨hd, hxC, hxS⟩ := hpt d x
    exact (hloc d hd _ hxC hxS).2
