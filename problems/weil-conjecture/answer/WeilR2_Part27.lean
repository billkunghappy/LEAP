    have hEps : wcSpfBarEps A lamA ρ = Limits.kernel.ι (wcSpfTwD A lamA ρ) ≫ E0.hom := by
      apply Limits.Pi.hom_ext; intro fj
      refine Eq.trans ?_ (Category.assoc _ _ _).symm
      rw [hE0]
      unfold wcSpfBarEps
      exact (Category.assoc _ _ _).trans
        (congrArg (fun z => Limits.kernel.ι (wcSpfTwD A lamA ρ) ≫ z) (Limits.Pi.lift_comp_π _ fj))
    have hsq : E0.hom ≫ wcSpfBarD A lamA ρ 0 = wcSpfTwD A lamA ρ ≫ E1.hom := by
      apply Limits.Pi.hom_ext; intro fj
      rw [Category.assoc, Category.assoc, hE1]
      simp only [wcSpfBarD, wcSpfTwD, Limits.Pi.lift_comp_π, Preadditive.comp_add,
        Preadditive.comp_sum, Preadditive.comp_zsmul, Preadditive.comp_nsmul, ← Category.assoc,
        hE0, Finset.univ_eq_empty, Finset.sum_empty, add_zero, Fin.last_zero, zero_add, pow_one,
        neg_smul, one_smul, sub_eq_add_neg, Preadditive.comp_neg]
    have gen : ∀ {K P0 P0' P1 P1' : 𝒜} (ι : K ⟶ P0) (_ : Mono ι) (T : P0 ⟶ P1)
        (hι : ι ≫ T = 0) (_ : (ShortComplex.mk ι T hι).Exact) (E0 : P0 ≅ P0') (E1 : P1 ≅ P1')
        (D : P0' ⟶ P1') (_ : E0.hom ≫ D = T ≫ E1.hom) (eps : K ⟶ P0') (_ : eps = ι ≫ E0.hom),
        Mono eps ∧ ∃ w : eps ≫ D = 0, (ShortComplex.mk _ _ w).Exact := by
      intro K P0 P0' P1 P1' ι hm T hι hex E0 E1 D hsq eps heps
      subst heps
      have w : (ι ≫ E0.hom) ≫ D = 0 := by
        rw [Category.assoc, hsq, ← Category.assoc, hι, Limits.zero_comp]
      refine ⟨mono_comp _ _, w, ?_⟩
      refine (ShortComplex.exact_iff_of_iso (ShortComplex.isoMk (S₁ := ShortComplex.mk _ _ hι)
        (S₂ := ShortComplex.mk _ _ w) (Iso.refl _) E0 E1 ?_ ?_)).1 hex
      · dsimp; rw [Category.id_comp]
      · exact hsq
    exact gen (Limits.kernel.ι (wcSpfTwD A lamA ρ)) Limits.equalizer.ι_mono _
      (Limits.kernel.condition _) (ShortComplex.exact_kernel _) E0 E1 _ hsq
      (wcSpfBarEps A lamA ρ) hEps

  have gen_d2 : ∀ (X : ℕ → 𝒜) (L R : ∀ p, X p ⟶ X (p + 1)) (M : ∀ p, Fin p → (X p ⟶ X (p + 1))),
      (∀ p, L p ≫ M (p + 1) 0 = L p ≫ L (p + 1)) →
      (∀ p (k : Fin p), L p ≫ M (p + 1) k.succ = M p k ≫ L (p + 1)) →
      (∀ p, L p ≫ R (p + 1) = R p ≫ L (p + 1)) →
      (∀ p (a b : Fin p), a ≤ b → M p a ≫ M (p + 1) b.succ = M p b ≫ M (p + 1) a.castSucc) →
      (∀ p (a : Fin p), M p a ≫ R (p + 1) = R p ≫ M (p + 1) a.castSucc) →
      (∀ p, R p ≫ R (p + 1) = R p ≫ M (p + 1) (Fin.last p)) → ∀ (p : ℕ),
      (L p + ∑ k : Fin p, ((-1 : ℤ) ^ ((k : ℕ) + 1)) • M p k + ((-1 : ℤ) ^ (p + 1)) • R p) ≫
        (L (p + 1) + ∑ k : Fin (p + 1), ((-1 : ℤ) ^ ((k : ℕ) + 1)) • M (p + 1) k +
          ((-1 : ℤ) ^ (p + 1 + 1)) • R (p + 1)) = 0 := by
    intro X L R M h1 h2 h3 h4 h5 h6 p
    let δ : ∀ q, Fin (q + 2) → (X q ⟶ X (q + 1)) := fun q =>
      Fin.cases (motive := fun _ => X q ⟶ X (q + 1)) (L q)
        (Fin.lastCases (motive := fun _ => X q ⟶ X (q + 1)) (R q) (M q))
    have eL : ∀ q, δ q 0 = L q := fun q => rfl
    have eM : ∀ q (k : Fin q), δ q k.castSucc.succ = M q k := fun q k => by
      simp only [δ, Fin.cases_succ, Fin.lastCases_castSucc]
    have eR : ∀ q, δ q (Fin.last (q + 1)) = R q := fun q => by
      simp only [δ]
      rw [← Fin.succ_last, Fin.cases_succ, Fin.lastCases_last]
    have hsum : ∀ q, L q + ∑ k : Fin q, ((-1 : ℤ) ^ ((k : ℕ) + 1)) • M q k +
        ((-1 : ℤ) ^ (q + 1)) • R q = ∑ i : Fin (q + 2), ((-1 : ℤ) ^ (i : ℕ)) • δ q i := by
      intro q
      rw [Fin.sum_univ_succ, Fin.sum_univ_castSucc]
      simp only [eL, eM, Fin.succ_last, eR, Fin.val_zero, Fin.val_succ, Fin.val_castSucc,
        Fin.val_last, pow_zero, one_smul, add_assoc]
    have hcos : ∀ q (i j : Fin (q + 2)), i ≤ j →
        δ q i ≫ δ (q + 1) j.succ = δ q j ≫ δ (q + 1) i.castSucc := by
      intro q i j hij
      have hv := Fin.le_def.mp hij
      rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨i', rfl⟩
      · have ei : (0 : Fin (q + 2)).castSucc = 0 := rfl
        rw [ei, eL, eL]
        rcases Fin.eq_zero_or_eq_succ j with rfl | ⟨j', rfl⟩
        · have ej : (0 : Fin (q + 2)).succ = ((0 : Fin (q + 1)).castSucc).succ := rfl
          rw [ej, eM, eL]; exact h1 q
        · rcases Fin.eq_castSucc_or_eq_last j' with ⟨k, rfl⟩ | rfl
          · have ej : k.castSucc.succ.succ = (k.succ.castSucc).succ := by rw [Fin.succ_castSucc]
            rw [ej, eM, eM]; exact h2 q k
          · rw [Fin.succ_last, Fin.succ_last, eR, eR]; exact h3 q
      · rcases Fin.eq_castSucc_or_eq_last i' with ⟨a, rfl⟩ | rfl
        · have ei : a.castSucc.succ.castSucc = (a.castSucc.castSucc).succ := Fin.ext (by simp)
          rw [ei, eM, eM]
          rcases Fin.eq_zero_or_eq_succ j with rfl | ⟨j', rfl⟩
          · simp at hv
          · rcases Fin.eq_castSucc_or_eq_last j' with ⟨b, rfl⟩ | rfl
            · have ej : b.castSucc.succ.succ = (b.succ.castSucc).succ := by
                rw [Fin.succ_castSucc]
              rw [ej, eM, eM]
              apply h4
              rw [Fin.le_def]
              simp only [Fin.val_succ, Fin.val_castSucc] at hv
              omega
            · rw [Fin.succ_last, Fin.succ_last, eR, eR]; exact h5 q a
        · have ei : (Fin.last q).succ.castSucc = ((Fin.last q).castSucc).succ := by
            rw [Fin.succ_castSucc]
          rw [ei, eM, Fin.succ_last, eR]
          rcases Fin.eq_zero_or_eq_succ j with rfl | ⟨j', rfl⟩
          · simp at hv
          · rcases Fin.eq_castSucc_or_eq_last j' with ⟨b, rfl⟩ | rfl
            · simp only [Fin.val_succ, Fin.val_castSucc, Fin.val_last] at hv
              omega
            · rw [Fin.succ_last, Fin.succ_last, eR]; erw [eR]; exact h6 q
    rw [hsum p, hsum (p + 1), Preadditive.sum_comp]
    simp only [Preadditive.comp_sum, Preadditive.zsmul_comp,
      Preadditive.comp_zsmul, smul_smul]
    rw [← Finset.sum_product', Finset.univ_product_univ]
    let S := Finset.univ.filter fun ij : Fin (p + 2) × Fin (p + 3) => (ij.2 : ℕ) ≤ (ij.1 : ℕ)
    rw [← Finset.sum_add_sum_compl S, ← eq_neg_iff_add_eq_zero,
      ← Finset.sum_neg_distrib]
    let φ : ∀ ij : Fin (p + 2) × Fin (p + 3), ij ∈ S → Fin (p + 2) × Fin (p + 3) :=
      fun ij hij =>
        (Fin.castLT ij.2 (lt_of_le_of_lt (Finset.mem_filter.mp hij).right (Fin.is_lt ij.1)),
          ij.1.succ)
    apply Finset.sum_bij φ
    · intro ij hij
      simp_rw [S, Finset.compl_filter, Finset.mem_filter, Finset.mem_univ, true_and] at hij ⊢
      simp only [φ, Fin.val_succ, Fin.val_castLT]
      omega
    · rintro ⟨i, j⟩ hij ⟨i', j'⟩ hij' h
      rw [Prod.mk_inj]
      exact ⟨by simpa [φ] using congr_arg Prod.snd h,
        by simpa [φ, Fin.castSucc_castLT] using congr_arg Fin.castSucc (congr_arg Prod.fst h)⟩
    · rintro ⟨i', j'⟩ hij'
      simp_rw [S, Finset.compl_filter, Finset.mem_filter, Finset.mem_univ, true_and,
        not_le] at hij'
      refine ⟨(j'.pred ?_, Fin.castSucc i'), ?_, ?_⟩
      · rintro rfl
        simp only [Fin.val_zero, not_lt_zero] at hij'
      · simp only [S, Finset.mem_filter, Finset.mem_univ, true_and, Fin.val_castSucc,
          Fin.val_pred]
        omega
      · simp only [φ, Fin.castLT_castSucc, Fin.succ_pred]
    · rintro ⟨i, j⟩ hij
      have hji : (j : ℕ) ≤ (i : ℕ) := (Finset.mem_filter.mp hij).2
      have hlt : (j : ℕ) < p + 2 := lt_of_le_of_lt hji i.is_lt
      simp only [φ]
      rw [hcos p (j.castLT hlt) i (by rw [Fin.le_def]; simpa using hji), Fin.castSucc_castLT,
        ← neg_smul]
      congr 1
      simp only [Fin.val_succ, Fin.val_castLT, pow_succ]
      ring

  have iL2 : ∀ (p : ℕ) (f : Fin (p + 2) → Fin (Fintype.card Γ)) (k : Fin p),
      (fun i : Fin p => wcSpfMerge Γ f k.succ i.succ) = wcSpfMerge Γ (fun i => f i.succ) k := by
    intro p f k; funext i
    apply (Fintype.equivFin Γ).symm.injective
    obtain ⟨F, hF⟩ : ∃ F : ℕ → Γ, ∀ x : Fin (p + 2), (Fintype.equivFin Γ).symm (f x) = F x :=
      ⟨fun m => if h : m < p + 2 then (Fintype.equivFin Γ).symm (f ⟨m, h⟩) else 1,
        fun x => by simp [x.is_lt]⟩
    simp only [wcSpfMerge]
    split_ifs <;> simp only [Fin.val_succ, Fin.val_castSucc] at * <;>
      simp only [Equiv.symm_apply_apply, hF, Fin.val_succ, Fin.val_castSucc] <;>
      first
        | omega
        | exact congrArg F (by omega)
        | exact congrArg₂ (· * ·) (congrArg F (by omega)) (congrArg F (by omega))
