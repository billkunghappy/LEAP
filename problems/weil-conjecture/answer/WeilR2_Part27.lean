    have e3 := e2 c ι (Category.id_comp c).symm (Category.id_comp ι).symm
    have e4 : (show C(↥V.left, Fin k → ZMod (ℓ ^ r)) from
          ((θr.hom.hom.app (Opposite.op (Over.mk (γ' ≫ ι)))).hom x).down) z =
        (show C(↥V.left, Fin k → ZMod (ℓ ^ r)) from
          ((θr.hom.hom.app (Opposite.op (Over.mk (ι ≫ γ)))).hom x).down) z := by
      rw [hγ']
    refine e1.trans (e4.trans ((hext V ι x z).trans ?_))
    rw [e3]

theorem wc_vqtt_H2_lattice_levels (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
