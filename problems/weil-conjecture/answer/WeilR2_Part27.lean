theorem wc_pencil_H1_trace_data (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (α : AlgebraicClosure ℚ_[ℓ])
    (hα : wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 1)) 1 (wcRqScalar D.f ℓ (n - 1) c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 1)) 1) α) :
    (∃ k : ℕ, 1 ≤ k ∧ α ^ (2 * k) =
      algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ (n * k))) ∨
    ∃ (k : ℕ) (_ : 1 ≤ k) (r : ℕ) (T : wcPureTraceData ℓ (Nat.card F'' ^ k) (n - 1) r),
      α ^ k ∈ T.H :=
by
  rcases wc_pencil_H1_devissage F' F'' Y n hn hn2 D ℓ hℓ hP α hα with hA | hV
  · exact Or.inl hA
  · by_cases hsq : α ^ 2 = algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)
    · refine Or.inl ⟨1, le_rfl, ?_⟩
      rw [mul_one, mul_one]
      exact hsq
    · obtain ⟨r, T, hT⟩ :=
        wc_pencil_VQ_trace_datum_nonisotropic F' F'' Y n hn hn2 D hNM ℓ hℓ hP α hV hsq
      refine Or.inr ⟨1, le_rfl, r, ?_⟩
      rw [pow_one, pow_one]
      exact ⟨T, hT⟩

theorem wc_pencil_H1_bound (F' F'' : Type u) [Field F'] [Field F''] [Finite F''] [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (α : AlgebraicClosure ℚ_[ℓ])
    (hα : wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 1)) 1 (wcRqScalar D.f ℓ (n - 1) c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcRq D.f ℓ (n - 1)) 1) α) :
    ∀ ι : AlgebraicClosure ℚ_[ℓ] ≃+* ℂ,
      ‖ι α‖ ^ 2 ≤ (Nat.card F'' : ℝ) * (Nat.card F'' : ℝ) ^ n :=
by
  intro ι
  have hq2 : 2 ≤ Nat.card F'' := Finite.one_lt_card
  have hq1 : (1 : ℝ) ≤ (Nat.card F'' : ℝ) := by exact_mod_cast (by omega : 1 ≤ Nat.card F'')
  have hqpos : (0 : ℝ) < (Nat.card F'' : ℝ) := by linarith
  have hQ : (0 : ℝ) ≤ (Nat.card F'' : ℝ) * (Nat.card F'' : ℝ) ^ n := by positivity
  rcases wc_pencil_H1_trace_data F' F'' Y n hn hn2 D hNM ℓ hℓ hP α hα with
    ⟨k, hk, hA⟩ | ⟨k, hk, r, T, hT⟩
  ·
    have hk0 : k ≠ 0 := by omega
    have hιc : ι (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ (n * k))) =
        (Nat.card F'' : ℂ) ^ (n * k) := by
      simp only [map_pow, map_natCast]
    have h1 : (‖ι α‖ ^ 2) ^ k = ((Nat.card F'' : ℝ) ^ n) ^ k := by
      rw [← pow_mul, ← norm_pow, ← map_pow, hA, hιc, norm_pow, Complex.norm_natCast, pow_mul]
    have h2 : ‖ι α‖ ^ 2 = (Nat.card F'' : ℝ) ^ n :=
      (pow_left_inj₀ (by positivity) (by positivity) hk0).mp h1
    rw [h2]
    exact le_mul_of_one_le_left (by positivity) hq1
  ·
    have hk0 : k ≠ 0 := by omega
    have hq0 : 1 ≤ Nat.card F'' ^ k := Nat.one_le_pow _ _ (by omega)
    have hpure := wc_trace_data_local_purity ℓ _ _ _ hq0 T
    have hsum := wc_trace_data_H1c_sum_bound ℓ _ _ _ hq0 T ι
      (fun d hd x γ hγ => hpure d hd x γ hγ ι)
    have hR : 0 < √(((Nat.card F'' ^ k : ℕ) : ℝ) ^ (n - 1 + 2)) :=
      Real.sqrt_pos.mpr (by positivity)
    have hmem : ι (α ^ k) ∈ T.H.map (fun z => ι z) := Multiset.mem_map_of_mem _ hT
    have hb := wc_powersum_root_bound (T.H.map (fun z => ι z)) _ _ hR hsum _ hmem
    have e1 : (‖ι α‖ ^ 2) ^ k = ‖ι (α ^ k)‖ ^ 2 := by
      rw [map_pow, norm_pow, ← pow_mul, ← pow_mul, mul_comm]
    have e2 : √(((Nat.card F'' ^ k : ℕ) : ℝ) ^ (n - 1 + 2)) ^ 2 =
        ((Nat.card F'' : ℝ) * (Nat.card F'' : ℝ) ^ n) ^ k := by
      rw [Real.sq_sqrt (by positivity), show n - 1 + 2 = n + 1 by omega, Nat.cast_pow,
        mul_pow, pow_succ, ← pow_mul, ← pow_mul, mul_comm k n, mul_comm]
    have h3 : (‖ι α‖ ^ 2) ^ k ≤ ((Nat.card F'' : ℝ) * (Nat.card F'' : ℝ) ^ n) ^ k := by
      rw [e1, ← e2]
      exact pow_le_pow_left₀ (norm_nonneg _) hb 2
    exact (pow_le_pow_iff_left₀ (by positivity) hQ hk0).mp h3

theorem wc_upper_bound_lefschetz_step (F' : Type u) [Finite F'] [Field F']
    (Y : Over (Spec (.of F'))) [GeometricallyIrreducible Y.hom] [IsProper Y.hom] (n : ℕ)
    [SmoothOfRelativeDimension n Y.hom] (hn : Even n) (hn2 : 2 ≤ n)
    (N : ℕ) (j : Y.left ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
      MvPolynomial.gradedAlgebra)
    (hj : IsClosedImmersion j)
    (hjY : j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))) = Y.hom)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F')
    (h : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))) :
    ∀ (r : ℕ) (e : wcCoh F' Y h ℓ n ≃+ (Fin r → ℚ_[ℓ])),
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F' Y h ℓ n), e (wcCohScalar F' Y h ℓ n c x) = c • e x) →
      ∀ μ ∈ (wcAddEquivMatrix e (wcCohFrob F' Y h ℓ n)).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
      ∃ k : ℕ, 1 ≤ k ∧
        ((∀ ι : AlgebraicClosure ℚ_[ℓ] ≃+* ℂ,
            ‖ι μ‖ ^ (2 * k) ≤ (Nat.card F' : ℝ) ^ k * ((Nat.card F' : ℝ) ^ k) ^ n) ∨
          ∃ (F'' : Type u) (_ : Field F'') (_ : Finite F''), Nat.card F'' = Nat.card F' ^ k ∧
            ∃ (Z : Over (Spec (.of F''))) (_ : GeometricallyIrreducible Z.hom)
              (_ : IsProper Z.hom) (_ : SmoothOfRelativeDimension (n - 2) Z.hom) (N' : ℕ)
              (jZ : Z.left ⟶ @Proj _ _ _ _ _
                (MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F'') MvPolynomial.gradedAlgebra),
              IsClosedImmersion jZ ∧
              jZ ≫ @Proj.toSpecZero _ _ _ _ _
                  (MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F'') MvPolynomial.gradedAlgebra ≫
                Spec.map (CommRingCat.ofHom (algebraMap F''
                  ↥(MvPolynomial.homogeneousSubmodule (Fin (N' + 1)) F'' 0))) = Z.hom ∧
              ∀ (hZ : WeaklyEtale (Limits.pullback.fst Z.hom
                  (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))),
                ∃ (rZ : ℕ) (eZ : wcCoh F'' Z hZ ℓ (n - 2) ≃+ (Fin rZ → ℚ_[ℓ])),
                  (∀ (c : ℚ_[ℓ]) (x : wcCoh F'' Z hZ ℓ (n - 2)),
                    eZ (wcCohScalar F'' Z hZ ℓ (n - 2) c x) = c • eZ x) ∧
                  ∃ β ∈ (wcAddEquivMatrix eZ (wcCohFrob F'' Z hZ ℓ (n - 2))).charpoly.aroots
                      (AlgebraicClosure ℚ_[ℓ]),
                    μ ^ k = algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])
                      ((Nat.card F' : ℚ_[ℓ]) ^ k) * β) :=
by
  classical
  have s6 : ∀ (F₀ : Type u) [Field F₀] [Finite F₀] (X₀ : Over (Spec (.of F₀)))
      (h₀ : WeaklyEtale (Limits.pullback.fst X₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F₀ (AlgebraicClosure F₀))))))
      (i : ℕ) (c : ℚ_[ℓ]) (x : wcCoh F₀ X₀ h₀ ℓ i),
      wcCohFrob F₀ X₀ h₀ ℓ i (wcCohScalar F₀ X₀ h₀ ℓ i c x) =
        wcCohScalar F₀ X₀ h₀ ℓ i c (wcCohFrob F₀ X₀ h₀ ℓ i x) := by
    intro F₀ _ _ X₀ h₀ i c x
    show (Abelian.Ext.mk₀ (wcFreeSheafMap X₀.left (wcGeomFrob F₀ X₀ h₀))).comp
        (x.comp (Abelian.Ext.mk₀ (wcLadicScalar X₀.left ℓ c)) (add_zero i)) (zero_add i) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap X₀.left (wcGeomFrob F₀ X₀ h₀))).comp x (zero_add i)).comp
        (Abelian.Ext.mk₀ (wcLadicScalar X₀.left ℓ c)) (add_zero i)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add i) (add_zero i) (by omega)).symm
  have s4 : ∀ {r r' : ℕ} (m : ℕ) (A : Matrix (Fin r) (Fin r) ℚ_[ℓ])
      (B : Matrix (Fin r') (Fin r') ℚ_[ℓ]) (P : Matrix (Fin r') (Fin r) ℚ_[ℓ]),
      (∀ v : Fin r → ℚ_[ℓ], P.mulVec v = 0 → v = 0) → P * A ^ m = B * P →
      ∀ μ ∈ A.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
        μ ^ m ∈ B.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    intro r r' m A B P hP hPA μ hμ
    set f : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ] := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hf
    have hker : LinearMap.ker (Matrix.toLin' P) = ⊥ := by
      rw [LinearMap.ker_eq_bot']
      intro v hv
      exact hP v (by rwa [Matrix.toLin'_apply] at hv)
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective _ hker
    have hQP : LinearMap.toMatrix' g * P = 1 := by
      have := congrArg LinearMap.toMatrix' hg
      rwa [LinearMap.toMatrix'_comp, LinearMap.toMatrix'_toLin', LinearMap.toMatrix'_id] at this
    have hQPL : (LinearMap.toMatrix' g).map f * P.map f = 1 := by
      rw [← Matrix.map_mul, hQP, Matrix.map_one _ (map_zero f) (map_one f)]
    have hPAL : P.map f * A.map f ^ m = B.map f * P.map f := by
      rw [← Matrix.map_pow, ← Matrix.map_mul, ← Matrix.map_mul, hPA]
    rw [Polynomial.mem_aroots] at hμ
    obtain ⟨_, hμ⟩ := hμ
    have hdet : (Matrix.scalar (Fin r) μ - A.map f).det = 0 := by
      rw [← Matrix.eval_charpoly, Matrix.charpoly_map, Polynomial.eval_map, ← Polynomial.aeval_def]
      exact hμ
    obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hAv : (A.map f).mulVec v = μ • v := by
      rw [Matrix.sub_mulVec, sub_eq_zero] at hv
      rw [← hv, Matrix.scalar_apply]
      ext x
      simp [Matrix.mulVec_diagonal]
    have hAkv : ∀ k : ℕ, (A.map f ^ k).mulVec v = μ ^ k • v := by
      intro k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ (A.map f), ← Matrix.mulVec_mulVec, hAv, Matrix.mulVec_smul, ih, smul_smul,
          ← pow_succ']
    have hw0 : (P.map f).mulVec v ≠ 0 := by
      intro hw
      apply hv0
      have e1 : ((LinearMap.toMatrix' g).map f).mulVec ((P.map f).mulVec v) = v := by
        rw [Matrix.mulVec_mulVec, hQPL, Matrix.one_mulVec]
      rw [← e1, hw, Matrix.mulVec_zero]
    have hBw : (B.map f).mulVec ((P.map f).mulVec v) = μ ^ m • (P.map f).mulVec v := by
      rw [Matrix.mulVec_mulVec, ← hPAL, ← Matrix.mulVec_mulVec, hAkv, Matrix.mulVec_smul]
    have hdet' : (Matrix.scalar (Fin r') (μ ^ m) - B.map f).det = 0 := by
      apply Matrix.exists_mulVec_eq_zero_iff.mp
      refine ⟨(P.map f).mulVec v, hw0, ?_⟩
      rw [Matrix.sub_mulVec, hBw, Matrix.scalar_apply, sub_eq_zero]
      ext x
      simp [Matrix.mulVec_diagonal]
    rw [Polynomial.mem_aroots]
    refine ⟨(Matrix.charpoly_monic B).ne_zero, ?_⟩
    rw [Polynomial.aeval_def, ← Polynomial.eval_map, ← Matrix.charpoly_map, Matrix.eval_charpoly]
    exact hdet'
  have s5 : ∀ {V V' : Type (u+1)} [AddCommGroup V] [AddCommGroup V'] {r r' : ℕ}
      (e : V ≃+ (Fin r → ℚ_[ℓ])) (e' : V' ≃+ (Fin r' → ℚ_[ℓ]))
      (s : ℚ_[ℓ] → V →+ V) (s' : ℚ_[ℓ] → V' →+ V')
      (he : ∀ (c : ℚ_[ℓ]) (x : V), e (s c x) = c • e x)
      (he' : ∀ (c : ℚ_[ℓ]) (x : V'), e' (s' c x) = c • e' x)
      (Φ : V →+ V) (Φ' : V' →+ V')
      (hΦ : ∀ (c : ℚ_[ℓ]) (x : V), Φ (s c x) = s c (Φ x))
      (hΦ' : ∀ (c : ℚ_[ℓ]) (x : V'), Φ' (s' c x) = s' c (Φ' x))
      (ψ : V →+ V') (hψ : Function.Injective ψ)
      (hψs : ∀ (c : ℚ_[ℓ]) (x : V), ψ (s c x) = s' c (ψ x))
      (m : ℕ) (hψΦ : ∀ x : V, ψ ((⇑Φ)^[m] x) = Φ' (ψ x)),
      ∃ P : Matrix (Fin r') (Fin r) ℚ_[ℓ], (∀ v : Fin r → ℚ_[ℓ], P.mulVec v = 0 → v = 0) ∧
        P * (wcAddEquivMatrix e Φ) ^ m = wcAddEquivMatrix e' Φ' * P := by
    intro V V' _ _ r r' e e' s s' he he' Φ Φ' hΦ hΦ' ψ hψ hψs m hψΦ
    have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]), e.symm (c • v) = s c (e.symm v) := fun c v =>
      e.injective (by rw [he, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    have hes' : ∀ (c : ℚ_[ℓ]) (v : Fin r' → ℚ_[ℓ]), e'.symm (c • v) = s' c (e'.symm v) :=
      fun c v => e'.injective (by rw [he', AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
    let LA : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]) :=
      { toFun := fun v => e (Φ (e.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes, hΦ, he, RingHom.id_apply] }
    let LB : (Fin r' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) :=
      { toFun := fun v => e' (Φ' (e'.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes', hΦ', he', RingHom.id_apply] }
    let LP : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r' → ℚ_[ℓ]) :=
      { toFun := fun v => e' (ψ (e.symm v))
        map_add' := fun v w => by simp only [map_add]
        map_smul' := fun c v => by simp only [hes, hψs, he', RingHom.id_apply] }
    have hA : wcAddEquivMatrix e Φ = LinearMap.toMatrix' LA := by
      ext a b
      rw [LinearMap.toMatrix'_apply]
      rfl
    have hB : wcAddEquivMatrix e' Φ' = LinearMap.toMatrix' LB := by
      ext a b
      rw [LinearMap.toMatrix'_apply]
      rfl
    have hAk : ∀ (k : ℕ) (v : Fin r → ℚ_[ℓ]),
        ((wcAddEquivMatrix e Φ) ^ k).mulVec v = e ((⇑Φ)^[k] (e.symm v)) := by
      intro k
      induction k with
      | zero => intro v; simp
      | succ k ih =>
        intro v
        rw [pow_succ', ← Matrix.mulVec_mulVec, ih, hA, LinearMap.toMatrix'_mulVec]
        show e (Φ (e.symm (e ((⇑Φ)^[k] (e.symm v))))) = _
        rw [AddEquiv.symm_apply_apply, Function.iterate_succ_apply']
    refine ⟨LinearMap.toMatrix' LP, ?_, ?_⟩
    · intro v hv
      rw [LinearMap.toMatrix'_mulVec] at hv
      change e' (ψ (e.symm v)) = 0 at hv
      have h1 : ψ (e.symm v) = 0 := e'.injective (hv.trans (map_zero e').symm)
      have h2 : e.symm v = 0 := hψ (h1.trans (map_zero ψ).symm)
      rw [← AddEquiv.apply_symm_apply e v, h2, map_zero]
    · apply Matrix.toLin'.injective
      apply LinearMap.ext
      intro v
      rw [Matrix.toLin'_apply, Matrix.toLin'_apply, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec,
        hAk, hB, LinearMap.toMatrix'_mulVec, LinearMap.toMatrix'_mulVec, LinearMap.toMatrix'_mulVec]
      show e' (ψ (e.symm (e ((⇑Φ)^[m] (e.symm v))))) = e' (Φ' (e'.symm (e' (ψ (e.symm v)))))
      rw [AddEquiv.symm_apply_apply, AddEquiv.symm_apply_apply, hψΦ]
  intro r e he μ hμ

  obtain ⟨F'', _, _, _, D, hNM⟩ := wc_lefschetz_datum_no_mixed_exists F' Y n hn hn2 N j hj hjY
  set k := Module.finrank F' F'' with hkdef
  have hk : 0 < k := Module.finrank_pos
  have hq'' : Nat.card F'' = Nat.card F' ^ k := Module.natCard_eq_pow_finrank
  have hℓ'' : ¬ ℓ ∣ Nat.card F'' := by
    rw [hq'']
    intro hd
    exact hℓ ((Fact.out : ℓ.Prime).dvd_of_dvd_pow hd)
  haveI := D.gi
  haveI := D.proper
  haveI := D.smooth
  have ht : WeaklyEtale (Limits.pullback.fst D.Yt.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')
  have hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
      (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
      (wc_weaklyEtale_algebraicClosure F'')

  obtain ⟨ψ, hψ, hψs, hψΦ⟩ :=
    wc_pullback_injective F' Y n ℓ hℓ h F'' D.Yt D.b D.hb D.bsurj D.bfin ht n
  obtain ⟨r', e', he'⟩ := wc_coh_finite F'' D.Yt n ℓ hℓ'' ht n
  obtain ⟨P, hPinj, hPA⟩ := s5 e e' (wcCohScalar F' Y h ℓ n) (wcCohScalar F'' D.Yt ht ℓ n) he he'
    (wcCohFrob F' Y h ℓ n) (wcCohFrob F'' D.Yt ht ℓ n) (s6 F' Y h n) (s6 F'' D.Yt ht n) ψ hψ hψs k
    hψΦ
  have hμk := s4 k _ _ P hPinj hPA μ hμ
  have hEig : wcIsEigen ℓ (wcCohScalar F'' D.Yt ht ℓ n) (wcCohFrob F'' D.Yt ht ℓ n) (μ ^ k) :=
    ⟨r', e', he', hμk⟩

  obtain ⟨p, hp, hpE⟩ := wc_pencil_leray_eigen F' F'' Y n hn2 D ℓ hℓ'' ht hP (μ ^ k) hEig
  have key : (4 ≤ n ∧ ∀ (hZ : WeaklyEtale (Limits.pullback.fst D.Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F'')))))),
        ∃ (rZ : ℕ) (eZ : wcCoh F'' D.Z hZ ℓ (n - 2) ≃+ (Fin rZ → ℚ_[ℓ])),
          (∀ (c : ℚ_[ℓ]) (x : wcCoh F'' D.Z hZ ℓ (n - 2)),
            eZ (wcCohScalar F'' D.Z hZ ℓ (n - 2) c x) = c • eZ x) ∧
          ∃ β ∈ (wcAddEquivMatrix eZ (wcCohFrob F'' D.Z hZ ℓ (n - 2))).charpoly.aroots
              (AlgebraicClosure ℚ_[ℓ]),
            μ ^ k = algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) (Nat.card F'' : ℚ_[ℓ]) * β) ∨
      ∀ ι : AlgebraicClosure ℚ_[ℓ] ≃+* ℂ,
        ‖ι (μ ^ k)‖ ^ 2 ≤ (Nat.card F'' : ℝ) * (Nat.card F'' : ℝ) ^ n := by
    have hp' : p = 0 ∨ p = 1 ∨ p = 2 := by omega
    rcases hp' with rfl | rfl | rfl
    · exact wc_pencil_edge_zero F' F'' Y n hn hn2 D ℓ hℓ'' hP (μ ^ k) hpE
    · exact Or.inr (wc_pencil_H1_bound F' F'' Y n hn hn2 D hNM ℓ hℓ'' hP (μ ^ k) hpE)
    · exact wc_pencil_edge_two F' F'' Y n hn hn2 D ℓ hℓ'' hP (μ ^ k) hpE
  refine ⟨k, hk, ?_⟩
  rcases key with ⟨h4, hT⟩ | hU
  · right
    have hgiZ : GeometricallyIrreducible D.Z.hom := D.Zgi h4
    refine ⟨F'', ?_⟩
    refine ⟨‹Field F''›, ?_⟩
    refine ⟨‹Finite F''›, ?_⟩
    refine ⟨hq'', ?_⟩
    refine ⟨D.Z, hgiZ, D.Zproper, D.Zsmooth, D.N', D.jZ, D.hjZ, D.hjZY, ?_⟩
    intro hZ
    obtain ⟨rZ, eZ, heZ, β, hβ, hμβ⟩ := hT hZ
    refine ⟨rZ, eZ, heZ, β, hβ, ?_⟩
    rw [hμβ, hq'', Nat.cast_pow]
  · left
    intro ι
    have hb := hU ι
    rw [map_pow, norm_pow, ← pow_mul, hq'', Nat.cast_pow] at hb
    rw [mul_comm 2 k]
    exact hb

theorem wc_middle_weak_bound (F' : Type u) [Finite F'] [Field F'] (Y : Over (Spec (.of F')))
    [GeometricallyIrreducible Y.hom] [IsProper Y.hom] (n : ℕ) [SmoothOfRelativeDimension n Y.hom]
    (hn : Even n)
    (N : ℕ) (j : Y.left ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
      MvPolynomial.gradedAlgebra)
    (hj : IsClosedImmersion j)
    (hjY : j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F')
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap F' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) F' 0))) = Y.hom)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F')
    (h : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F' (AlgebraicClosure F')))))) :
    ∀ (r : ℕ) (e : wcCoh F' Y h ℓ n ≃+ (Fin r → ℚ_[ℓ])),
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F' Y h ℓ n), e (wcCohScalar F' Y h ℓ n c x) = c • e x) →
      ∀ μ ∈ (wcAddEquivMatrix e (wcCohFrob F' Y h ℓ n)).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
      ∀ ι : AlgebraicClosure ℚ_[ℓ] ≃+* ℂ,
        (Nat.card F' : ℝ) ^ n ≤ (Nat.card F' : ℝ) * ‖ι μ‖ ^ 2 ∧
        ‖ι μ‖ ^ 2 ≤ (Nat.card F' : ℝ) * (Nat.card F' : ℝ) ^ n :=
by

  have pair : ∀ {r r' : ℕ} (A : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (B : Matrix (Fin r') (Fin r') ℚ_[ℓ])
      (P : Matrix (Fin r) (Fin r') ℚ_[ℓ]) (c : ℚ_[ℓ]), c ≠ 0 →
      (∀ v : Fin r → ℚ_[ℓ], Matrix.vecMul v P = 0 → v = 0) → A.transpose * P * B = c • P →
      ∀ μ ∈ A.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
        μ ≠ 0 ∧ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) c / μ ∈
          B.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) := by
    intro r r' A B P c hc hP hrel μ hμ
    set f : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ] := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hf
    set Q := P.transpose with hQdef
    have hker : LinearMap.ker (Matrix.toLin' Q) = ⊥ := by
      rw [LinearMap.ker_eq_bot']
      intro v hv
      rw [Matrix.toLin'_apply, hQdef, Matrix.mulVec_transpose] at hv
      exact hP v hv
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective _ hker
    have hGQ : LinearMap.toMatrix' g * Q = 1 := by
      have := congrArg LinearMap.toMatrix' hg
      rwa [LinearMap.toMatrix'_comp, LinearMap.toMatrix'_toLin', LinearMap.toMatrix'_id] at this
    have hGQL : (LinearMap.toMatrix' g).map f * Q.map f = 1 := by
      rw [← Matrix.map_mul, hGQ, Matrix.map_one _ (map_zero f) (map_one f)]
    have hrel' : B.transpose * Q * A = c • Q := by
      have := congrArg Matrix.transpose hrel
      rw [Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_transpose,
        Matrix.transpose_smul] at this
      rw [hQdef, Matrix.mul_assoc]
      exact this
    have hrelL : B.transpose.map f * Q.map f * A.map f = f c • Q.map f := by
      rw [← Matrix.map_mul, ← Matrix.map_mul, hrel']
      ext x y
      simp
    rw [Polynomial.mem_aroots] at hμ
    obtain ⟨_, hμ⟩ := hμ
    have hdet : (Matrix.scalar (Fin r) μ - A.map f).det = 0 := by
      rw [← Matrix.eval_charpoly, Matrix.charpoly_map, Polynomial.eval_map, ← Polynomial.aeval_def]
      exact hμ
    obtain ⟨v, hv0, hv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hAv : (A.map f).mulVec v = μ • v := by
      rw [Matrix.sub_mulVec, sub_eq_zero] at hv
      rw [← hv, Matrix.scalar_apply]
      ext x
      simp [Matrix.mulVec_diagonal]
    have hw0 : (Q.map f).mulVec v ≠ 0 := by
      intro h0
      apply hv0
      have e1 : ((LinearMap.toMatrix' g).map f).mulVec ((Q.map f).mulVec v) = v := by
        rw [Matrix.mulVec_mulVec, hGQL, Matrix.one_mulVec]
      rw [← e1, h0, Matrix.mulVec_zero]
    have hBw : μ • (B.transpose.map f).mulVec ((Q.map f).mulVec v) = f c • (Q.map f).mulVec v := by
      have h5 : (B.transpose.map f * Q.map f * A.map f).mulVec v = (f c • Q.map f).mulVec v := by
        rw [hrelL]
      rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hAv, Matrix.mulVec_smul,
        Matrix.mulVec_smul, Matrix.smul_mulVec] at h5
      exact h5
    have hfc : f c ≠ 0 := (map_ne_zero f).mpr hc
    have hμ0 : μ ≠ 0 := by
      intro h0
      rw [h0, zero_smul] at hBw
      exact hw0 ((smul_eq_zero.mp hBw.symm).resolve_left hfc)
    refine ⟨hμ0, ?_⟩
    have hBw' : (B.transpose.map f).mulVec ((Q.map f).mulVec v) =
        (f c / μ) • (Q.map f).mulVec v := by
      rw [div_eq_inv_mul, mul_smul, ← hBw, smul_smul, inv_mul_cancel₀ hμ0, one_smul]
    have hdet' : (Matrix.scalar (Fin r') (f c / μ) - B.transpose.map f).det = 0 := by
      apply Matrix.exists_mulVec_eq_zero_iff.mp
      refine ⟨(Q.map f).mulVec v, hw0, ?_⟩
      rw [Matrix.sub_mulVec, hBw', Matrix.scalar_apply, sub_eq_zero]
      ext x
      simp [Matrix.mulVec_diagonal]
    rw [Polynomial.mem_aroots]
    refine ⟨(Matrix.charpoly_monic B).ne_zero, ?_⟩
    rw [Polynomial.aeval_def, ← Polynomial.eval_map, ← Matrix.charpoly_map,
      ← Matrix.charpoly_transpose (B.map f), ← Matrix.transpose_map, Matrix.eval_charpoly]
    exact hdet'

  have hU : ∀ m : ℕ, ∀ (F₀ : Type u) [Finite F₀] [Field F₀] (Y₀ : Over (Spec (.of F₀)))
      [GeometricallyIrreducible Y₀.hom] [IsProper Y₀.hom] [SmoothOfRelativeDimension m Y₀.hom],
      Even m → ∀ (N₀ : ℕ) (j₀ : Y₀.left ⟶ @Proj _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) F₀) MvPolynomial.gradedAlgebra),
      IsClosedImmersion j₀ →
      j₀ ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) F₀)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap F₀ ↥(MvPolynomial.homogeneousSubmodule (Fin (N₀ + 1)) F₀ 0))) = Y₀.hom →
      ∀ (h₀ : WeaklyEtale (Limits.pullback.fst Y₀.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F₀ (AlgebraicClosure F₀)))))),
      ¬ ℓ ∣ Nat.card F₀ → ∀ i : ℕ, i = m →
      ∀ (r : ℕ) (e : wcCoh F₀ Y₀ h₀ ℓ i ≃+ (Fin r → ℚ_[ℓ])),
      (∀ (c : ℚ_[ℓ]) (x : wcCoh F₀ Y₀ h₀ ℓ i), e (wcCohScalar F₀ Y₀ h₀ ℓ i c x) = c • e x) →
      ∀ μ ∈ (wcAddEquivMatrix e (wcCohFrob F₀ Y₀ h₀ ℓ i)).charpoly.aroots (AlgebraicClosure ℚ_[ℓ]),
      ∀ ι : AlgebraicClosure ℚ_[ℓ] ≃+* ℂ,
        ‖ι μ‖ ^ 2 ≤ (Nat.card F₀ : ℝ) * (Nat.card F₀ : ℝ) ^ m := by
    intro m
    induction m using Nat.strong_induction_on with
    | _ m ih =>
    intro F₀ _ _ Y₀ _ _ _ hm N₀ j₀ hj₀ hj₀Y h₀ hℓ₀ i hi r e he μ hμ ι
    subst i
    have hq0 : 2 ≤ Nat.card F₀ := Finite.one_lt_card
    have hQ : (0 : ℝ) < (Nat.card F₀ : ℝ) := by exact_mod_cast (by omega : 0 < Nat.card F₀)
    rcases Nat.eq_zero_or_pos m with hm0 | hmpos
    ·
      subst hm0
      have hA : wcAddEquivMatrix e (wcCohFrob F₀ Y₀ h₀ ℓ 0) = 1 := by
        ext a b
        simp [wcAddEquivMatrix, wc_coh_zero_frob_id, Pi.single_apply, Matrix.one_apply]
      rw [hA, Matrix.charpoly_one, Polynomial.mem_aroots] at hμ
      obtain ⟨_, hev⟩ := hμ
      rw [map_pow, map_sub, Polynomial.aeval_X, map_one] at hev
      have hμ1 : μ = 1 := by
        generalize Fintype.card (Fin r) = t at hev
        rcases Nat.eq_zero_or_pos t with ht | ht
        · rw [ht, pow_zero] at hev
          exact absurd hev one_ne_zero
        · exact sub_eq_zero.mp ((pow_eq_zero_iff ht.ne').mp hev)
      rw [hμ1, map_one, norm_one, one_pow, pow_zero, mul_one]
      exact_mod_cast (by omega : 1 ≤ Nat.card F₀)
    ·
      have hm2 : 2 ≤ m := by obtain ⟨t, ht⟩ := hm; omega
      obtain ⟨k, hk, hcase⟩ :=
        wc_upper_bound_lefschetz_step F₀ Y₀ m hm hm2 N₀ j₀ hj₀ hj₀Y ℓ hℓ₀ h₀ r e he μ hμ
      have hk0 : k ≠ 0 := by omega

      have root : ‖ι μ‖ ^ (2 * k) ≤ (Nat.card F₀ : ℝ) ^ k * ((Nat.card F₀ : ℝ) ^ k) ^ m →
          ‖ι μ‖ ^ 2 ≤ (Nat.card F₀ : ℝ) * (Nat.card F₀ : ℝ) ^ m := by
        intro hb
        have e1 : ‖ι μ‖ ^ (2 * k) = (‖ι μ‖ ^ 2) ^ k := pow_mul _ _ _
        have e2 : (Nat.card F₀ : ℝ) ^ k * ((Nat.card F₀ : ℝ) ^ k) ^ m =
            ((Nat.card F₀ : ℝ) * (Nat.card F₀ : ℝ) ^ m) ^ k := by
          rw [mul_pow, ← pow_mul, ← pow_mul, mul_comm k m]
        rw [e1, e2] at hb
        exact (pow_le_pow_iff_left₀ (by positivity) (by positivity) hk0).mp hb
      apply root
      rcases hcase with hU' | ⟨F'', _, _, hcard, Z, _, _, _, N', jZ, hjZ, hjZY, hZall⟩
      · exact hU' ι
      · have hZ : WeaklyEtale (Limits.pullback.fst Z.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))) :=
          MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback _ _).flip
            (wc_weaklyEtale_algebraicClosure F'')
        obtain ⟨rZ, eZ, heZ, β, hβ, hμβ⟩ := hZall hZ
        have hℓ'' : ¬ ℓ ∣ Nat.card F'' := by
          rw [hcard]
          intro hd
          exact hℓ₀ ((Fact.out : ℓ.Prime).dvd_of_dvd_pow hd)
        have hev2 : Even (m - 2) := (Nat.even_sub hm2).mpr (iff_of_true hm even_two)
        have hIH := ih (m - 2) (by omega) F'' Z hev2 N' jZ hjZ hjZY hZ hℓ'' (m - 2) rfl
          rZ eZ heZ β hβ ι
        rw [hcard, Nat.cast_pow] at hIH
        have hιμ : ι μ ^ k = (Nat.card F₀ : ℂ) ^ k * ι β := by
          have := congrArg ι hμβ
          simp only [map_pow, map_mul, map_natCast] at this
          exact this
        have hnorm : ‖ι μ‖ ^ k = (Nat.card F₀ : ℝ) ^ k * ‖ι β‖ := by
          rw [← norm_pow, hιμ, norm_mul, norm_pow, Complex.norm_natCast]
        have hpow : ((Nat.card F₀ : ℝ) ^ k) ^ m =
            ((Nat.card F₀ : ℝ) ^ k) ^ (m - 2) * ((Nat.card F₀ : ℝ) ^ k) ^ 2 := by
          rw [← pow_add]
          congr 1
          omega

        calc ‖ι μ‖ ^ (2 * k) = (‖ι μ‖ ^ k) ^ 2 := by rw [mul_comm, pow_mul]
          _ = ((Nat.card F₀ : ℝ) ^ k) ^ 2 * ‖ι β‖ ^ 2 := by rw [hnorm, mul_pow]
          _ ≤ ((Nat.card F₀ : ℝ) ^ k) ^ 2 *
              ((Nat.card F₀ : ℝ) ^ k * ((Nat.card F₀ : ℝ) ^ k) ^ (m - 2)) :=
            mul_le_mul_of_nonneg_left hIH (by positivity)
          _ = (Nat.card F₀ : ℝ) ^ k * ((Nat.card F₀ : ℝ) ^ k) ^ m := by
            rw [hpow]
            ring
  intro r e he μ hμ ι
  have hq2 : 2 ≤ Nat.card F' := Finite.one_lt_card
  have hqpos : (0 : ℝ) < (Nat.card F' : ℝ) := by exact_mod_cast (by omega : 0 < Nat.card F')

  refine ⟨?_, hU n F' Y hn N j hj hjY h hℓ n rfl r e he μ hμ ι⟩
  obtain ⟨hone, htop⟩ := wc_top_coh_frobenius F' Y n ℓ hℓ h
  obtain ⟨r', e', he'⟩ := wc_coh_finite F' Y n ℓ hℓ h (2 * n - n)
  obtain ⟨P, hPB, hPl, _⟩ :=
    wc_poincare_duality F' Y n ℓ hℓ h hone htop n (by omega) r r' e e' he he'
  have hc : ((Nat.card F' : ℚ_[ℓ]) ^ n) ≠ 0 :=
    pow_ne_zero _ (Nat.cast_ne_zero.mpr (by omega))
  obtain ⟨hμ0, hν⟩ := pair _ _ P _ hc hPl hPB μ hμ
  have hν' := hU n F' Y hn N j hj hjY h hℓ (2 * n - n) (by omega) r' e' he' _ hν ι
  have hιc : ι (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F' : ℚ_[ℓ]) ^ n)) =
      (Nat.card F' : ℂ) ^ n := by
    simp only [map_pow, map_natCast]
  rw [map_div₀, hιc, norm_div, norm_pow, Complex.norm_natCast] at hν'
  have hpos : 0 < ‖ι μ‖ := norm_pos_iff.mpr ((map_ne_zero ι).mpr hμ0)
  rw [div_pow, div_le_iff₀ (pow_pos hpos 2)] at hν'
  have hqn : 0 < (Nat.card F' : ℝ) ^ n := pow_pos hqpos n
  have h3 : (Nat.card F' : ℝ) ^ n * (Nat.card F' : ℝ) ^ n ≤
      (Nat.card F' : ℝ) ^ n * ((Nat.card F' : ℝ) * ‖ι μ‖ ^ 2) := by nlinarith [hν']
  exact le_of_mul_le_mul_left h3 hqn

theorem wc_modcoh_comparison_frob (F : Type u) [Finite F] [Field F] (X : Over (Spec (.of F)))
    (h : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ T : ∀ n : ℕ, wcCoh F X h ℓ n ≃+ wcModCoh F X h ℓ n,
      (∀ (n : ℕ) (c : ℚ_[ℓ]) (x : wcCoh F X h ℓ n),
        T n (wcCohScalar F X h ℓ n c x) = wcModScalar F X h ℓ n c (T n x)) ∧
      (∀ (n : ℕ) (x : wcCoh F X h ℓ n),
        T n (wcCohFrob F X h ℓ n x) = wcModFrob F X h ℓ n (T n x)) :=
by
  classical
  letI hD : HasExt (Sheaf ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
      AddCommGrpCat.{u+1}) := HasExt.standard _
  letI hM : HasExt (SheafOfModules.{u+1} (wcSliceRing F X h ℓ)) := HasExt.standard _

  obtain ⟨Z, ε₁, ε₂, ρ, H1, H2, F1, F2⟩ := wc_slice_free_data F X h ℓ
  obtain ⟨ι, I1, I2⟩ := wc_slice_ladic_unit_iso F X h ℓ

  obtain ⟨hjA, hjC⟩ := sheafPushforward_additive_finiteColimits
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (Scheme.ProEt.topology X.left)
    (Over.forget (wcGeomPoint F X h))
  obtain ⟨hΦA, hΦC⟩ := sheafPushforward_additive_finiteColimits
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h))
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (Over.map (wcGeomFrob F X h))
  have hGC := sheafOfModules_toSheaf_preservesFiniteColimits
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (wcSliceRing F X h ℓ)
  obtain ⟨hΨA, hΨL, hΨC⟩ := sheafOfModules_pushforward_exact (Over.map (wcGeomFrob F X h))
    (wcSliceRing F X h ℓ) (wcSliceRing F X h ℓ) (wcFrobRingMap F X h ℓ)
  obtain ⟨L₁, adj₁, hL₁A, hL₁L, hL₁C⟩ :=
    proet_overPullback_exact_left_adjoint X.left (wcGeomPoint F X h)
  have hunit : ∀ (V : (Over (wcGeomPoint F X h))ᵒᵖ) (m : ℕ), m ≠ 0 →
      IsUnit (m : ↑((wcSliceRing F X h ℓ).obj.obj V)) := by
    intro V m hm
    have hm' : (m : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hm
    change IsUnit (m : C(↥((Opposite.unop V).left.left), ULift.{u+1} ℚ_[ℓ]))
    refine isUnit_iff_exists_inv.mpr ⟨ContinuousMap.const _ (ULift.up ((m : ℚ_[ℓ])⁻¹)), ?_⟩
    refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
    simp [hm']
  obtain ⟨L₂, adj₂, hL₂A, hL₂L, hL₂C⟩ := sheafOfModules_toSheaf_exact_left_adjoint
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X h)) (wcSliceRing F X h ℓ) hunit

  obtain ⟨Am, hAm⟩ : ∃ Am : ∀ n, wcCoh F X h ℓ n →+ Abelian.Ext Z
      (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).obj
        (wcLadicSheaf X.left ℓ)) n,
      ∀ n x, Am n x = (Abelian.Ext.mk₀ ε₁).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x)
          (zero_add n) :=
    ⟨fun n => AddMonoidHom.mk' (fun x => (Abelian.Ext.mk₀ ε₁).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x)
          (zero_add n))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]), fun _ _ => rfl⟩
  obtain ⟨Bm, hBm⟩ : ∃ Bm : ∀ n, wcModCoh F X h ℓ n →+ Abelian.Ext Z
      ((SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).obj (SheafOfModules.unit (wcSliceRing F X h ℓ))) n,
      ∀ n β, Bm n β = (Abelian.Ext.mk₀ ε₂).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) β) (zero_add n) :=
    ⟨fun n => AddMonoidHom.mk' (fun β => (Abelian.Ext.mk₀ ε₂).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) β) (zero_add n))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.comp_add]), fun _ _ => rfl⟩
  obtain ⟨Pe, hPe⟩ : ∃ Pe : ∀ n, Abelian.Ext Z
      (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).obj
        (wcLadicSheaf X.left ℓ)) n ≃+ Abelian.Ext Z
      ((SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).obj (SheafOfModules.unit (wcSliceRing F X h ℓ))) n,
      ∀ n z, Pe n z = z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero n) :=
    ⟨fun n =>
      { toFun := fun z => z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero n)
        invFun := fun z => z.comp (Abelian.Ext.mk₀ ι.hom) (add_zero n)
        left_inv := fun z => by
          change (z.comp (Abelian.Ext.mk₀ ι.inv) (add_zero n)).comp (Abelian.Ext.mk₀ ι.hom)
            (add_zero n) = z
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id,
            Abelian.Ext.comp_mk₀_id]
        right_inv := fun z => by
          change (z.comp (Abelian.Ext.mk₀ ι.hom) (add_zero n)).comp (Abelian.Ext.mk₀ ι.inv)
            (add_zero n) = z
          rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id,
            Abelian.Ext.comp_mk₀_id]
        map_add' := fun a b => Abelian.Ext.add_comp _ _ _ _ }, fun _ _ => rfl⟩
  have hA : ∀ n, Function.Bijective (Am n) := by
    intro n
    have e : (⇑(Am n)) = fun x => (Abelian.Ext.mk₀ ε₁).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x)
          (zero_add n) := funext (hAm n)
    rw [e]
    exact ext_transfer_of_hom_bijective L₁
      ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) adj₁
      Z (wcFreeSheaf X.left (wcGeomPoint F X h)) ε₁ H1 (wcLadicSheaf X.left ℓ) n
  have hB : ∀ n, Function.Bijective (Bm n) := by
    intro n
    have e : (⇑(Bm n)) = fun β => (Abelian.Ext.mk₀ ε₂).comp (Abelian.Ext.mapExactFunctor
        (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) β) (zero_add n) := funext (hBm n)
    rw [e]
    exact ext_transfer_of_hom_bijective L₂ (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) adj₂
      Z (SheafOfModules.unit (wcSliceRing F X h ℓ)) ε₂ H2 (SheafOfModules.unit (wcSliceRing F X h ℓ)) n
  obtain ⟨T, hT⟩ : ∃ T : ∀ n, wcCoh F X h ℓ n ≃+ wcModCoh F X h ℓ n,
      ∀ n x, Bm n (T n x) = Pe n (Am n x) :=
    ⟨fun n => (AddEquiv.ofBijective (Am n) (hA n)).trans
        ((Pe n).trans (AddEquiv.ofBijective (Bm n) (hB n)).symm),
      fun n x => AddEquiv.ofBijective_apply_symm_apply (Bm n) (hB n)⟩

  obtain ⟨φ, hφ⟩ : ∃ φ : ∀ n, wcModCoh F X h ℓ n → wcModCoh F X h ℓ n,
      ∀ n β, φ n β = Abelian.Ext.mapExactFunctor
        (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X h ℓ)) β :=
    ⟨fun n β => Abelian.Ext.mapExactFunctor
        (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X h ℓ)) β,
      fun _ _ => rfl⟩
  have hφF : ∀ n (β : wcModCoh F X h ℓ n), wcModFrob F X h ℓ n β = φ n β := by
    intro n β
    unfold wcModFrob
    split_ifs with hΨ
    · exact (hφ n β).symm
    · exact absurd ⟨hΨA, hΨL, hΨC⟩ hΨ
  have hΦj : ∀ n (x : wcCoh F X h ℓ n),
      Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Abelian.Ext.mapExactFunctor
          ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x) =
      Abelian.Ext.mapExactFunctor
          ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x := by
    intro n x
    rw [← Abelian.Ext.comp_mapExactFunctor]
    rfl
  have hGΨ : ∀ n (β : wcModCoh F X h ℓ n),
      Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ))
        (Abelian.Ext.mapExactFunctor
          (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X h ℓ)) β) =
      Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Abelian.Ext.mapExactFunctor (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)) β) := by
    intro n β
    rw [← Abelian.Ext.comp_mapExactFunctor, ← Abelian.Ext.comp_mapExactFunctor]
    rfl
  have hΦι : ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1}
      (wcGeomFrob F X h)).map ι.inv = ι.inv :=
    congrArg Iso.inv (Iso.ext (α := ((Scheme.ProEt.topology X.left).overMapPullback
      AddCommGrpCat.{u+1} (wcGeomFrob F X h)).mapIso ι) (β := ι) I2)
  have hι : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).map
        (wcLadicScalar X.left ℓ c) ≫ ι.inv =
      ι.inv ≫ (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).map (wcModConst F X h ℓ c) := by
    intro c
    rw [Iso.eq_inv_comp, ← Category.assoc, ← I1, Category.assoc, Iso.hom_inv_id, Category.comp_id]

  have hAF : ∀ n (x : wcCoh F X h ℓ n), Am n (wcCohFrob F X h ℓ n x) =
      (Abelian.Ext.mk₀ ρ).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Am n x)) (zero_add n) := by
    intro n x
    have hfx : wcCohFrob F X h ℓ n x =
        (Abelian.Ext.mk₀ (wcFreeSheafMap X.left (wcGeomFrob F X h))).comp x (zero_add n) := rfl
    have s1 : Am n (wcCohFrob F X h ℓ n x) = (Abelian.Ext.mk₀ (ε₁ ≫
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).map
          (wcFreeSheafMap X.left (wcGeomFrob F X h)))).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)) x)
          (zero_add n) := by
      rw [hfx, hAm, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
        Abelian.Ext.mk₀_comp_mk₀_assoc]
    rw [F1] at s1
    rw [s1, hAm, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc]
    exact congrArg (fun y => (Abelian.Ext.mk₀ (ρ ≫ ((Scheme.ProEt.topology X.left).overMapPullback
      AddCommGrpCat.{u+1} (wcGeomFrob F X h)).map ε₁)).comp y (zero_add n)) (hΦj n x).symm
  have hBΨ : ∀ n (β : wcModCoh F X h ℓ n), Bm n (φ n β) =
      (Abelian.Ext.mk₀ ρ).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Bm n β)) (zero_add n) := by
    intro n β
    have hGφ := (congrArg (Abelian.Ext.mapExactFunctor
      (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ))) (hφ n β)).trans (hGΨ n β)
    rw [hBm, hBm, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.mk₀_comp_mk₀_assoc, ← F2]
    exact congrArg (fun y => (Abelian.Ext.mk₀ ε₂).comp y (zero_add n)) hGφ
  have hAP : ∀ n (x : wcCoh F X h ℓ n), Pe n (Am n (wcCohFrob F X h ℓ n x)) =
      (Abelian.Ext.mk₀ ρ).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Pe n (Am n x))) (zero_add n) := by
    intro n x
    rw [hPe, hPe, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      ← Abelian.Ext.comp_assoc_of_third_deg_zero, hAF]
    exact congrArg (fun g => ((Abelian.Ext.mk₀ ρ).comp (Abelian.Ext.mapExactFunctor
        ((Scheme.ProEt.topology X.left).overMapPullback AddCommGrpCat.{u+1} (wcGeomFrob F X h))
        (Am n x)) (zero_add n)).comp (Abelian.Ext.mk₀ g) (add_zero n)) hΦι.symm
  refine ⟨T, ?_, ?_⟩
  · intro n c x
    apply (hB n).1
    rw [hT]
    have e1 : Am n (wcCohScalar F X h ℓ n c x) = (Am n x).comp (Abelian.Ext.mk₀
        (((Scheme.ProEt.topology X.left).overPullback AddCommGrpCat.{u+1} (wcGeomPoint F X h)).map
          (wcLadicScalar X.left ℓ c))) (add_zero n) := by
      have hsc : wcCohScalar F X h ℓ n c x =
          x.comp (Abelian.Ext.mk₀ (wcLadicScalar X.left ℓ c)) (add_zero n) := rfl
      rw [hsc, hAm, hAm, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
      exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
    have e2 : ∀ β : wcModCoh F X h ℓ n, Bm n (wcModScalar F X h ℓ n c β) =
        (Bm n β).comp (Abelian.Ext.mk₀
          ((SheafOfModules.toSheaf.{u+1} (wcSliceRing F X h ℓ)).map (wcModConst F X h ℓ c))) (add_zero n) := by
      intro β
      have hSc : wcModScalar F X h ℓ n c β =
          β.comp (Abelian.Ext.mk₀ (wcModConst F X h ℓ c)) (add_zero n) := rfl
      rw [hSc, hBm, hBm, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀]
      exact (Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _).symm
    rw [e1, e2, hT, hPe, hPe, Abelian.Ext.comp_assoc_of_third_deg_zero,
      Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀,
      hι]
  · intro n x
    apply (hB n).1
    rw [hφF, hT, hBΨ, hT]
    exact hAP n x

theorem wc_sliceBC_frob_square : ∀ (F : Type u) [Finite F] [Field F] {X Y : Over (Spec (.of F))} (p : X ⟶ Y)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))),
    ∃ κ : wcSliceBC F p hX hY ⋙ Over.map (wcGeomFrob F X hX) ⟶ Over.map (wcGeomFrob F Y hY) ⋙ wcSliceBC F p hX hY,
      ∀ V : Over (wcGeomPoint F Y hY), (κ.app V).left.left ≫
        wcSliceProj F p hX hY ((Over.map (wcGeomFrob F Y hY)).obj V) = wcSliceProj F p hX hY V :=
by
  intro F _ _ X Y p hX hY

  have G1 : ∀ (Z : Over (Spec (.of F))) (hZ : WeaklyEtale (Limits.pullback.fst Z.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))),
      (wcGeomFrob F Z hZ).left ≫ Limits.pullback.fst Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
        Limits.pullback.fst Z.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :=
    fun Z hZ => (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have G2 : ∀ (Z : Over (Spec (.of F))) (hZ : WeaklyEtale (Limits.pullback.fst Z.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))),
      (wcGeomFrob F Z hZ).left ≫ Limits.pullback.snd Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
        Limits.pullback.snd Z.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
          Spec.map (CommRingCat.ofHom ((@FiniteField.frobeniusAlgEquivOfAlgebraic F _
            (Fintype.ofFinite F) (AlgebraicClosure F) _ _ _).symm :
              AlgebraicClosure F →+* AlgebraicClosure F)) :=
    fun Z hZ => Limits.pullback.lift_snd _ _ _

  let jp : Limits.pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ⟶
      Limits.pullback Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :=
    Limits.pullback.lift
      (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
        p.left)
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (by rw [Category.assoc, Over.w p, Limits.pullback.condition])
  have J1 : (wcGeomPointMap F p hX hY).left ≫
      (Limits.pullback.snd (wcGeomPoint F Y hY).hom p.left :
        Limits.pullback (wcGeomPoint F Y hY).hom p.left ⟶ X.left) =
      Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :=
    Limits.pullback.lift_snd _ _ _
  have J2 : (wcGeomPointMap F p hX hY).left ≫
      (Limits.pullback.fst (wcGeomPoint F Y hY).hom p.left :
        Limits.pullback (wcGeomPoint F Y hY).hom p.left ⟶ (wcGeomPoint F Y hY).left) = jp :=
    Limits.pullback.lift_fst _ _ _
  have J3 : jp ≫ Limits.pullback.fst Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
        p.left :=
    Limits.pullback.lift_fst _ _ _
  have J4 : jp ≫ Limits.pullback.snd Y.hom
      (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) :=
    Limits.pullback.lift_snd _ _ _
  have U1 : ((wcProEtPullback p.left).map (wcGeomFrob F Y hY)).left ≫
      (Limits.pullback.fst (wcGeomPoint F Y hY).hom p.left :
        Limits.pullback (wcGeomPoint F Y hY).hom p.left ⟶ (wcGeomPoint F Y hY).left) =
      (Limits.pullback.fst (wcGeomPoint F Y hY).hom p.left :
        Limits.pullback (wcGeomPoint F Y hY).hom p.left ⟶ (wcGeomPoint F Y hY).left) ≫
        (wcGeomFrob F Y hY).left :=
    Limits.pullback.lift_fst _ _ _
  have U2 : ((wcProEtPullback p.left).map (wcGeomFrob F Y hY)).left ≫
      (Limits.pullback.snd (wcGeomPoint F Y hY).hom p.left :
        Limits.pullback (wcGeomPoint F Y hY).hom p.left ⟶ X.left) =
      (Limits.pullback.snd (wcGeomPoint F Y hY).hom p.left :
        Limits.pullback (wcGeomPoint F Y hY).hom p.left ⟶ X.left) :=
    Limits.pullback.lift_snd _ _ _

  have K : jp ≫ (wcGeomFrob F Y hY).left = (wcGeomFrob F X hX).left ≫ jp := by
    refine Limits.pullback.hom_ext (f := Y.hom)
      (g := Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ?_ ?_
    · exact (Category.assoc _ _ _).trans ((whisker_eq _ (G1 Y hY)).trans (J3.trans
        ((eq_whisker (G1 X hX) _).symm.trans ((Category.assoc _ _ _).trans
          ((whisker_eq _ J3).symm.trans (Category.assoc _ _ _).symm)))))
    · exact (Category.assoc _ _ _).trans ((whisker_eq _ (G2 Y hY)).trans
        ((Category.assoc _ _ _).symm.trans ((eq_whisker J4 _).trans ((G2 X hX).symm.trans
          ((whisker_eq _ J4).symm.trans (Category.assoc _ _ _).symm)))))

  have L3f : wcGeomPointMap F p hX hY ≫ (wcProEtPullback p.left).map (wcGeomFrob F Y hY) =
      wcGeomFrob F X hX ≫ wcGeomPointMap F p hX hY := by
    apply MorphismProperty.Over.Hom.ext
    show (wcGeomPointMap F p hX hY).left ≫ ((wcProEtPullback p.left).map (wcGeomFrob F Y hY)).left =
      (wcGeomFrob F X hX).left ≫ (wcGeomPointMap F p hX hY).left
    refine Limits.pullback.hom_ext (f := (wcGeomPoint F Y hY).hom) (g := p.left) ?_ ?_
    · exact (Category.assoc _ _ _).trans ((whisker_eq _ U1).trans ((Category.assoc _ _ _).symm.trans
        ((eq_whisker J2 _).trans (K.trans ((whisker_eq _ J2).symm.trans
          (Category.assoc _ _ _).symm)))))
    · exact (Category.assoc _ _ _).trans ((whisker_eq _ U2).trans (J1.trans ((G1 X hX).symm.trans
        ((whisker_eq _ J1).symm.trans (Category.assoc _ _ _).symm))))

  have wV : ∀ V : Over (wcGeomPoint F Y hY),
      Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V).hom (wcGeomPointMap F p hX hY) ≫
        ((Over.post (wcProEtPullback p.left)).obj ((Over.map (wcGeomFrob F Y hY)).obj V)).hom =
      (Limits.pullback.snd ((Over.post (wcProEtPullback p.left)).obj V).hom
          (wcGeomPointMap F p hX hY) ≫ wcGeomFrob F X hX) ≫ wcGeomPointMap F p hX hY := by
    intro V
    exact (whisker_eq _ ((wcProEtPullback p.left).map_comp V.hom (wcGeomFrob F Y hY))).trans
      ((Category.assoc _ _ _).symm.trans ((eq_whisker Limits.pullback.condition _).trans
        ((Category.assoc _ _ _).trans ((whisker_eq _ L3f).trans (Category.assoc _ _ _).symm))))
  let k : ∀ V : Over (wcGeomPoint F Y hY),
      ((wcSliceBC F p hX hY ⋙ Over.map (wcGeomFrob F X hX)).obj V).left ⟶
        ((Over.map (wcGeomFrob F Y hY) ⋙ wcSliceBC F p hX hY).obj V).left := fun V =>
    Limits.pullback.lift
      (Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V).hom (wcGeomPointMap F p hX hY))
      (Limits.pullback.snd ((Over.post (wcProEtPullback p.left)).obj V).hom
        (wcGeomPointMap F p hX hY) ≫ wcGeomFrob F X hX) (wV V)
  have kf : ∀ V : Over (wcGeomPoint F Y hY), k V ≫
      Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj
        ((Over.map (wcGeomFrob F Y hY)).obj V)).hom (wcGeomPointMap F p hX hY) =
      Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V).hom
        (wcGeomPointMap F p hX hY) :=
    fun V => Limits.pullback.lift_fst _ _ _
  have ks : ∀ V : Over (wcGeomPoint F Y hY), k V ≫
      Limits.pullback.snd ((Over.post (wcProEtPullback p.left)).obj
        ((Over.map (wcGeomFrob F Y hY)).obj V)).hom (wcGeomPointMap F p hX hY) =
      Limits.pullback.snd ((Over.post (wcProEtPullback p.left)).obj V).hom
        (wcGeomPointMap F p hX hY) ≫ wcGeomFrob F X hX :=
    fun V => Limits.pullback.lift_snd _ _ _
  refine ⟨{ app := fun V => Over.homMk (k V) (ks V), naturality := ?_ }, ?_⟩
  · intro V V' f
    apply Over.OverMorphism.ext
    show ((wcSliceBC F p hX hY ⋙ Over.map (wcGeomFrob F X hX)).map f).left ≫ k V' =
      k V ≫ ((Over.map (wcGeomFrob F Y hY) ⋙ wcSliceBC F p hX hY).map f).left
    have h1 : ((wcSliceBC F p hX hY ⋙ Over.map (wcGeomFrob F X hX)).map f).left ≫
        Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V').hom
          (wcGeomPointMap F p hX hY) =
        Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V).hom
          (wcGeomPointMap F p hX hY) ≫ (wcProEtPullback p.left).map f.left :=
      Limits.pullback.lift_fst _ _ _
    have h1' : ((wcSliceBC F p hX hY ⋙ Over.map (wcGeomFrob F X hX)).map f).left ≫
        Limits.pullback.snd ((Over.post (wcProEtPullback p.left)).obj V').hom
          (wcGeomPointMap F p hX hY) =
        Limits.pullback.snd ((Over.post (wcProEtPullback p.left)).obj V).hom
          (wcGeomPointMap F p hX hY) :=
      Limits.pullback.lift_snd _ _ _
    have h2 : ((Over.map (wcGeomFrob F Y hY) ⋙ wcSliceBC F p hX hY).map f).left ≫
        Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj
          ((Over.map (wcGeomFrob F Y hY)).obj V')).hom (wcGeomPointMap F p hX hY) =
        Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj
          ((Over.map (wcGeomFrob F Y hY)).obj V)).hom (wcGeomPointMap F p hX hY) ≫
          (wcProEtPullback p.left).map f.left :=
      Limits.pullback.lift_fst _ _ _
    have h2' : ((Over.map (wcGeomFrob F Y hY) ⋙ wcSliceBC F p hX hY).map f).left ≫
        Limits.pullback.snd ((Over.post (wcProEtPullback p.left)).obj
          ((Over.map (wcGeomFrob F Y hY)).obj V')).hom (wcGeomPointMap F p hX hY) =
        Limits.pullback.snd ((Over.post (wcProEtPullback p.left)).obj
          ((Over.map (wcGeomFrob F Y hY)).obj V)).hom (wcGeomPointMap F p hX hY) :=
      Limits.pullback.lift_snd _ _ _
    refine Limits.pullback.hom_ext
      (f := ((Over.post (wcProEtPullback p.left)).obj ((Over.map (wcGeomFrob F Y hY)).obj V')).hom)
      (g := wcGeomPointMap F p hX hY) ?_ ?_
    · exact (Category.assoc _ _ _).trans ((whisker_eq _ (kf V')).trans (h1.trans
        ((eq_whisker (kf V) _).symm.trans ((Category.assoc _ _ _).trans
          ((whisker_eq _ h2).symm.trans (Category.assoc _ _ _).symm)))))
    · exact (Category.assoc _ _ _).trans ((whisker_eq _ (ks V')).trans
        ((Category.assoc _ _ _).symm.trans ((eq_whisker h1' _).trans ((ks V).symm.trans
          ((whisker_eq _ h2').symm.trans (Category.assoc _ _ _).symm)))))
  · intro V
    show (k V).left ≫ ((Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj
        ((Over.map (wcGeomFrob F Y hY)).obj V)).hom (wcGeomPointMap F p hX hY)).left ≫
        (Limits.pullback.fst V.left.hom p.left : Limits.pullback V.left.hom p.left ⟶ V.left.left)) =
      (Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V).hom
        (wcGeomPointMap F p hX hY)).left ≫
        (Limits.pullback.fst V.left.hom p.left : Limits.pullback V.left.hom p.left ⟶ V.left.left)
    exact (Category.assoc _ _ _).symm.trans (eq_whisker (congrArg (fun g => g.left) (kf V)) _)

theorem wc_modPull_frob_beta : ∀ (F : Type u) [Finite F] [Field F] {X Y : Over (Spec (.of F))} (p : X ⟶ Y)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [(wcSliceBC F p hX hY).IsContinuous ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX))]
    (κ : wcSliceBC F p hX hY ⋙ Over.map (wcGeomFrob F X hX) ⟶ Over.map (wcGeomFrob F Y hY) ⋙ wcSliceBC F p hX hY),
    (∀ V : Over (wcGeomPoint F Y hY), (κ.app V).left.left ≫
        wcSliceProj F p hX hY ((Over.map (wcGeomFrob F Y hY)).obj V) = wcSliceProj F p hX hY V) →
    ∃ β : SheafOfModules.pushforward.{u+1} (wcSliceRingMap F p hX hY ℓ) ⋙
        SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Y hY ℓ) ⟶
      SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ) ⋙
        SheafOfModules.pushforward.{u+1} (wcSliceRingMap F p hX hY ℓ),
      (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Y hY ℓ)).map
          (SheafOfModules.unitToPushforwardObjUnit (wcSliceRingMap F p hX hY ℓ)) ≫
        β.app (SheafOfModules.unit (wcSliceRing F X hX ℓ)) =
      SheafOfModules.unitToPushforwardObjUnit (wcSliceRingMap F p hX hY ℓ) :=
by
  intro F _ _ X Y p hX hY ℓ _ _ κ hκ

  have hR : ∀ (V₀ : Over (wcGeomPoint F Y hY))
      (r : ↑((wcSliceRing F Y hY ℓ).obj.obj (Opposite.op V₀))),
      ((wcSliceRing F X hX ℓ).obj.map (κ.app V₀).op).hom
          ((wcSliceRingMap F p hX hY ℓ).hom.app
            (Opposite.op ((Over.map (wcGeomFrob F Y hY)).obj V₀)) r) =
        (wcSliceRingMap F p hX hY ℓ).hom.app (Opposite.op V₀) r := by
    intro V₀ r
    let r' : C(↥V₀.left.left, ULift.{u+1} ℚ_[ℓ]) := r
    apply ContinuousMap.ext
    intro x
    exact congrArg (fun f => r' (f.base x)) (hκ V₀)
  let βapp : ∀ M : SheafOfModules.{u+1} (wcSliceRing F X hX ℓ),
      (SheafOfModules.pushforward.{u+1} (wcSliceRingMap F p hX hY ℓ) ⋙
        SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Y hY ℓ)).obj M ⟶
      (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ) ⋙
        SheafOfModules.pushforward.{u+1} (wcSliceRingMap F p hX hY ℓ)).obj M := fun M =>
    ⟨PresheafOfModules.homMk
      { app := fun V => M.val.presheaf.map (κ.app V.unop).op
        naturality := fun V W f => by
          change M.val.presheaf.map ((wcSliceBC F p hX hY).map
                ((Over.map (wcGeomFrob F Y hY)).map f.unop)).op ≫
              M.val.presheaf.map (κ.app W.unop).op =
            M.val.presheaf.map (κ.app V.unop).op ≫
              M.val.presheaf.map ((Over.map (wcGeomFrob F X hX)).map
                ((wcSliceBC F p hX hY).map f.unop)).op
          rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp, ← op_comp,
            ← op_comp]
          exact congrArg (fun g => M.val.presheaf.map g.op) (κ.naturality f.unop).symm }
      (fun V r m => by
        have h1 := PresheafOfModules.map_smul M.val (κ.app V.unop).op
          ((wcSliceRingMap F p hX hY ℓ).hom.app
            (Opposite.op ((Over.map (wcGeomFrob F Y hY)).obj V.unop)) r) m
        rw [hR V.unop r] at h1
        exact h1)⟩
  refine ⟨{ app := βapp, naturality := ?_ }, ?_⟩
  · intro M N h
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    ext m
    exact (PresheafOfModules.naturality_apply h.val (κ.app V.unop).op m).symm
  · apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    refine ModuleCat.hom_ext (LinearMap.ext fun r => ?_)
    exact hR V.unop r

theorem wc_modPull_frob (F : Type u) [Finite F] [Field F] {X Y : Over (Spec (.of F))} (p : X ⟶ Y)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n : ℕ) (u : wcModCoh F Y hY ℓ n) :
    wcModPull F p hX hY ℓ n (wcModFrob F Y hY ℓ n u) =
      wcModFrob F X hX ℓ n (wcModPull F p hX hY ℓ n u) :=
by
  classical

  have hΨ : ∀ (Z : Over (Spec (.of F))) (hZ : WeaklyEtale (Limits.pullback.fst Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))),
      (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Z hZ ℓ)).Additive ∧
      Limits.PreservesFiniteLimits (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Z hZ ℓ)) ∧
      Limits.PreservesFiniteColimits (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Z hZ ℓ)) := by
    intro Z hZ
    obtain ⟨hΦA, hΦC⟩ := sheafPushforward_additive_finiteColimits
      ((Scheme.ProEt.topology Z.left).over (wcGeomPoint F Z hZ))
      ((Scheme.ProEt.topology Z.left).over (wcGeomPoint F Z hZ)) (Over.map (wcGeomFrob F Z hZ))
    have hGC := sheafOfModules_toSheaf_preservesFiniteColimits
      ((Scheme.ProEt.topology Z.left).over (wcGeomPoint F Z hZ)) (wcSliceRing F Z hZ ℓ)
    exact sheafOfModules_pushforward_exact (Over.map (wcGeomFrob F Z hZ))
      (wcSliceRing F Z hZ ℓ) (wcSliceRing F Z hZ ℓ) (wcFrobRingMap F Z hZ ℓ)
  have hΨY := hΨ Y hY
  have hΨX := hΨ X hX
  by_cases hP : wcModPullOK F p hX hY ℓ
  swap
  · have h0 : wcModPull F p hX hY ℓ n = 0 := by
      unfold wcModPull
      exact dif_neg hP
    rw [h0, AddMonoidHom.zero_apply, AddMonoidHom.zero_apply, map_zero]
  haveI := hP.fst
  haveI := hP.snd.fst
  haveI := hP.snd.snd.1
  haveI := hP.snd.snd.2.1
  haveI := hP.snd.snd.2.2.1
  haveI := hP.snd.snd.2.2.2.1
  haveI := hΨY.1
  haveI := hΨY.2.1
  haveI := hΨY.2.2
  haveI := hΨX.1
  haveI := hΨX.2.1
  haveI := hΨX.2.2
  letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F Y hY ℓ)) := HasExt.standard _
  letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F X hX ℓ)) := HasExt.standard _
  have ePull : ∀ v : wcModCoh F Y hY ℓ n, wcModPull F p hX hY ℓ n v =
      (Abelian.Ext.mk₀ (inv (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ)))).comp
        ((Abelian.Ext.mapExactFunctor (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ)) v).comp
          (Abelian.Ext.mk₀ (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ)))
          (add_zero n)) (zero_add n) := by
    intro v
    unfold wcModPull
    rw [dif_pos hP]
    rfl
  have eFY : ∀ v : wcModCoh F Y hY ℓ n, wcModFrob F Y hY ℓ n v =
      (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Y hY ℓ)) v :
        wcModCoh F Y hY ℓ n) := by
    intro v
    unfold wcModFrob
    rw [dif_pos hΨY]
    rfl
  have eFX : ∀ v : wcModCoh F X hX ℓ n, wcModFrob F X hX ℓ n v =
      (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ)) v :
        wcModCoh F X hX ℓ n) := by
    intro v
    unfold wcModFrob
    rw [dif_pos hΨX]
    rfl

  obtain ⟨κ, hκ⟩ := wc_sliceBC_frob_square F p hX hY
  obtain ⟨β, hK⟩ := wc_modPull_frob_beta F p hX hY ℓ κ hκ

  obtain ⟨θ, hθ⟩ : ∃ θ : SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Y hY ℓ) ⋙
        SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ) ⟶
      SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ) ⋙
        SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ),
      θ = ((mateEquiv (SheafOfModules.pullbackPushforwardAdjunction (wcSliceRingMap F p hX hY ℓ))
        (SheafOfModules.pullbackPushforwardAdjunction (wcSliceRingMap F p hX hY ℓ))).symm
          (TwoSquare.mk _ _ _ _ β)).natTrans := ⟨_, rfl⟩

  have s7 : ∀ (c : SheafOfModules.{u+1} (wcSliceRing F Y hY ℓ))
      (d : SheafOfModules.{u+1} (wcSliceRing F X hX ℓ))
      (f : (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ)).obj c ⟶ d),
      (SheafOfModules.pullbackPushforwardAdjunction (wcSliceRingMap F p hX hY ℓ)).homEquiv
          ((SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Y hY ℓ)).obj c)
          ((SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ)).obj d)
          (θ.app c ≫ (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ)).map f) =
        (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Y hY ℓ)).map
          ((SheafOfModules.pullbackPushforwardAdjunction (wcSliceRingMap F p hX hY ℓ)).homEquiv c d f) ≫
          β.app d := by
    intro c d f
    have hu := unit_mateEquiv (SheafOfModules.pullbackPushforwardAdjunction (wcSliceRingMap F p hX hY ℓ))
      (SheafOfModules.pullbackPushforwardAdjunction (wcSliceRingMap F p hX hY ℓ))
      ((mateEquiv (SheafOfModules.pullbackPushforwardAdjunction (wcSliceRingMap F p hX hY ℓ))
        (SheafOfModules.pullbackPushforwardAdjunction (wcSliceRingMap F p hX hY ℓ))).symm
          (TwoSquare.mk _ _ _ _ β)) c
    rw [Equiv.apply_symm_apply] at hu
    have h1 : (SheafOfModules.pullbackPushforwardAdjunction (wcSliceRingMap F p hX hY ℓ)).unit.app
          ((SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Y hY ℓ)).obj c) ≫
        (SheafOfModules.pushforward.{u+1} (wcSliceRingMap F p hX hY ℓ)).map (θ.app c) =
        (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Y hY ℓ)).map
          ((SheafOfModules.pullbackPushforwardAdjunction (wcSliceRingMap F p hX hY ℓ)).unit.app c) ≫
          β.app ((SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ)).obj c) := by
      rw [hθ]
      exact hu.symm
    have h2 : β.app ((SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ)).obj c) ≫
        (SheafOfModules.pushforward.{u+1} (wcSliceRingMap F p hX hY ℓ)).map
          ((SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ)).map f) =
        (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Y hY ℓ)).map
          ((SheafOfModules.pushforward.{u+1} (wcSliceRingMap F p hX hY ℓ)).map f) ≫ β.app d :=
      (β.naturality f).symm
    rw [Adjunction.homEquiv_unit, Adjunction.homEquiv_unit, Functor.map_comp, Functor.map_comp,
      ← Category.assoc, h1]
    simp only [Category.assoc]
    rw [h2]

  have hη : (SheafOfModules.pullbackPushforwardAdjunction (wcSliceRingMap F p hX hY ℓ)).homEquiv
      (SheafOfModules.unit (wcSliceRing F Y hY ℓ)) (SheafOfModules.unit (wcSliceRing F X hX ℓ))
      (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ)) =
      SheafOfModules.unitToPushforwardObjUnit (wcSliceRingMap F p hX hY ℓ) :=
    SheafOfModules.pullbackPushforwardAdjunction_homEquiv_pullbackObjUnitToUnit _
  have H : θ.app (SheafOfModules.unit (wcSliceRing F Y hY ℓ)) ≫
      (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ)).map
        (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ)) =
      SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ) := by
    apply ((SheafOfModules.pullbackPushforwardAdjunction (wcSliceRingMap F p hX hY ℓ)).homEquiv
      ((SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Y hY ℓ)).obj
        (SheafOfModules.unit (wcSliceRing F Y hY ℓ)))
      ((SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ)).obj
        (SheafOfModules.unit (wcSliceRing F X hX ℓ)))).injective
    rw [s7, hη, hK]
    exact hη.symm


  have key : ∀ (c : SheafOfModules.{u+1} (wcSliceRing F Y hY ℓ))
      (d : SheafOfModules.{u+1} (wcSliceRing F X hX ℓ))
      (ν : (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ)).obj c ⟶ d)
      (ν' : (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ)).obj
          ((SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Y hY ℓ)).obj c) ⟶
        (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ)).obj d)
      [IsIso ν] [IsIso ν'],
      θ.app c ≫ (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ)).map ν = ν' →
      ∀ w : Abelian.Ext c c n,
      (Abelian.Ext.mk₀ (inv ν')).comp
        ((Abelian.Ext.mapExactFunctor (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ))
          (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Y hY ℓ)) w)).comp
          (Abelian.Ext.mk₀ ν') (add_zero n)) (zero_add n) =
      Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ))
        ((Abelian.Ext.mk₀ (inv ν)).comp
          ((Abelian.Ext.mapExactFunctor (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ)) w).comp
            (Abelian.Ext.mk₀ ν) (add_zero n)) (zero_add n)) := by
    intro c d ν ν' _ _ hH w
    have hΨid : (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ)).map ν ≫
        (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ)).map (inv ν) = 𝟙 _ := by
      rw [← CategoryTheory.Functor.map_comp, IsIso.hom_inv_id, CategoryTheory.Functor.map_id]
    have H' : inv ν' ≫ θ.app c =
        (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ)).map (inv ν) := by
      have h1 : inv ν' ≫ (θ.app c ≫
          (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ)).map ν) ≫
          (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ)).map (inv ν) =
          inv ν' ≫ ν' ≫ (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ)).map (inv ν) := by
        rw [hH]
      rw [Category.assoc, hΨid, IsIso.inv_hom_id_assoc] at h1
      erw [Category.comp_id] at h1
      exact h1
    have hb : Abelian.Ext.mk₀ ν' = (Abelian.Ext.mk₀ (θ.app c)).comp
        (Abelian.Ext.mk₀ ((SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ)).map ν))
        (add_zero 0) := by
      rw [Abelian.Ext.mk₀_comp_mk₀, hH]
    have hnat := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp w θ
    rw [Abelian.Ext.comp_mapExactFunctor, Abelian.Ext.comp_mapExactFunctor] at hnat
    have s1 : (Abelian.Ext.mapExactFunctor (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ))
          (Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F Y hY ℓ)) w)).comp
          (Abelian.Ext.mk₀ ν') (add_zero n) =
        (Abelian.Ext.mk₀ (θ.app c)).comp
          ((Abelian.Ext.mapExactFunctor (SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ))
            (Abelian.Ext.mapExactFunctor (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ)) w)).comp
            (Abelian.Ext.mk₀ ((SheafOfModules.pushforward.{u+1} (wcFrobRingMap F X hX ℓ)).map ν))
            (add_zero n)) (zero_add n) := by
      rw [hb, ← Abelian.Ext.comp_assoc_of_third_deg_zero, hnat]
      exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
      Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀, s1,
      Abelian.Ext.mk₀_comp_mk₀_assoc, H']
  have hνiso : IsIso (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ)) :=
    hP.snd.snd.2.2.2.1
  rw [ePull, ePull, eFX, eFY]
  exact @key (SheafOfModules.unit (wcSliceRing F Y hY ℓ)) (SheafOfModules.unit (wcSliceRing F X hX ℓ))
    (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ))
    (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ)) hνiso hνiso H u

theorem wc_sliceBC_comparison (F : Type u) [Field F] {X Y : Over (Spec (.of F))} (p : X ⟶ Y)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (pb : wcXbar F X ⟶ wcXbar F Y)
    (h1 : pb ≫ Limits.pullback.fst Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫ p.left)
    (h2 : pb ≫ Limits.pullback.snd Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :
    ∃ κ : wcSliceBC F p hX hY ≅
        wcOverToSlice Y.left (wcGeomPoint F Y hY) ⋙ wcProEtBC pb ⋙
          wcSliceToOver X.left (wcGeomPoint F X hX),
      ∀ V : Over (wcGeomPoint F Y hY),
        (κ.hom.app V).left.left ≫ Limits.pullback.fst V.hom.left pb = wcSliceProj F p hX hY V :=
by
  classical

  have congrPB : ∀ {P X' Y' Z' : Scheme.{u}} {a a' : P ⟶ X'} {b : P ⟶ Y'} {c : X' ⟶ Z'}
      {d d' : Y' ⟶ Z'}, a = a' → d = d' → IsPullback a b c d → IsPullback a' b c d' := by
    intro _ _ _ _ _ _ _ _ _ _ ha hd h
    subst ha
    subst hd
    exact h

  have hA : (wcGeomPointMap F p hX hY).left ≫
      Limits.pullback.fst (Limits.pullback.fst Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) p.left = pb := by
    refine (Limits.pullback.lift_fst _ _ _).trans ?_
    apply Limits.pullback.hom_ext
    · exact (Limits.pullback.lift_fst _ _ _).trans h1.symm
    · exact (Limits.pullback.lift_snd _ _ _).trans h2.symm

  have F1 : ∀ V : Over (wcGeomPoint F Y hY),
      IsPullback
        (Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V).hom
          (wcGeomPointMap F p hX hY)).left
        ((wcSliceBC F p hX hY).obj V).hom.left
        ((wcProEtPullback p.left).map V.hom).left (wcGeomPointMap F p hX hY).left := by
    intro V
    exact (Scheme.ProEt.forget X.left ⋙ Over.forget X.left).map_isPullback
      (IsPullback.of_hasPullback ((Over.post (wcProEtPullback p.left)).obj V).hom
        (wcGeomPointMap F p hX hY))

  have F2 : ∀ V : Over (wcGeomPoint F Y hY),
      IsPullback ((wcProEtPullback p.left).map V.hom).left
        (Limits.pullback.fst V.left.hom p.left)
        (Limits.pullback.fst (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) p.left)
        V.hom.left := by
    intro V
    have hm1 : ((wcProEtPullback p.left).map V.hom).left ≫
        Limits.pullback.fst (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) p.left =
        Limits.pullback.fst V.left.hom p.left ≫ V.hom.left := Limits.pullback.lift_fst _ _ _
    have hm2 : ((wcProEtPullback p.left).map V.hom).left ≫
        Limits.pullback.snd (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) p.left =
        Limits.pullback.snd V.left.hom p.left := Limits.pullback.lift_snd _ _ _
    have hw : V.hom.left ≫ Limits.pullback.fst Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) = V.left.hom :=
      MorphismProperty.Over.w V.hom
    exact IsPullback.of_right
      (congrPB hm2.symm hw.symm (IsPullback.of_hasPullback V.left.hom p.left).flip) hm1
      (IsPullback.of_hasPullback _ _).flip

  have Sq : ∀ V : Over (wcGeomPoint F Y hY),
      IsPullback (wcSliceProj F p hX hY V) ((wcSliceBC F p hX hY).obj V).hom.left V.hom.left pb :=
    fun V => congrPB rfl hA (IsPullback.paste_horiz (F1 V) (F2 V).flip)

  let ι : ∀ V : Over (wcGeomPoint F Y hY),
      ((wcSliceBC F p hX hY).obj V).left.left ≅ Limits.pullback V.hom.left pb :=
    fun V => (Sq V).isoPullback
  have hι1 : ∀ V : Over (wcGeomPoint F Y hY),
      (ι V).hom ≫ Limits.pullback.fst V.hom.left pb = wcSliceProj F p hX hY V :=
    fun V => (Sq V).isoPullback_hom_fst
  have hι2 : ∀ V : Over (wcGeomPoint F Y hY),
      (ι V).hom ≫ Limits.pullback.snd V.hom.left pb = ((wcSliceBC F p hX hY).obj V).hom.left :=
    fun V => (Sq V).isoPullback_hom_snd
  let e : ∀ V : Over (wcGeomPoint F Y hY), ((wcSliceBC F p hX hY).obj V).left ≅
      ((wcOverToSlice Y.left (wcGeomPoint F Y hY) ⋙ wcProEtBC pb ⋙
          wcSliceToOver X.left (wcGeomPoint F X hX)).obj V).left :=
    fun V => MorphismProperty.Over.isoMk (ι V) (by
      show (ι V).hom ≫ (Limits.pullback.snd V.hom.left pb ≫ Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) =
        ((wcSliceBC F p hX hY).obj V).left.hom
      rw [← Category.assoc, hι2 V]
      exact MorphismProperty.Over.w ((wcSliceBC F p hX hY).obj V).hom)
  let κc : ∀ V : Over (wcGeomPoint F Y hY), (wcSliceBC F p hX hY).obj V ≅
      (wcOverToSlice Y.left (wcGeomPoint F Y hY) ⋙ wcProEtBC pb ⋙
          wcSliceToOver X.left (wcGeomPoint F X hX)).obj V :=
    fun V => Over.isoMk (e V) (by
      apply MorphismProperty.Over.Hom.ext
      show (ι V).hom ≫ Limits.pullback.snd V.hom.left pb = ((wcSliceBC F p hX hY).obj V).hom.left
      exact hι2 V)

  have key : ∀ {V₁ V₂ : Over (wcGeomPoint F Y hY)} (k : V₁ ⟶ V₂),
      wcSliceProj F p hX hY V₁ ≫ k.left.left =
        ((wcSliceBC F p hX hY).map k).left.left ≫ wcSliceProj F p hX hY V₂ := by
    intro V₁ V₂ k
    have h1 : ((wcSliceBC F p hX hY).map k).left ≫
        Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V₂).hom
          (wcGeomPointMap F p hX hY) =
        Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V₁).hom
          (wcGeomPointMap F p hX hY) ≫ (wcProEtPullback p.left).map k.left :=
      Limits.pullback.lift_fst _ _ _
    have h2 : ((wcSliceBC F p hX hY).map k).left.left ≫
        (Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V₂).hom
          (wcGeomPointMap F p hX hY)).left =
        (Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V₁).hom
          (wcGeomPointMap F p hX hY)).left ≫ ((wcProEtPullback p.left).map k.left).left :=
      congrArg (fun f => f.left) h1
    have h3 : ((wcProEtPullback p.left).map k.left).left ≫
        (Limits.pullback.fst V₂.left.hom p.left : Limits.pullback V₂.left.hom p.left ⟶ _) =
        (Limits.pullback.fst V₁.left.hom p.left :
          Limits.pullback V₁.left.hom p.left ⟶ _) ≫ k.left.left :=
      Limits.pullback.lift_fst _ _ _
    exact (Category.assoc _ _ _).trans ((congrArg (fun g => _ ≫ g) h3.symm).trans
      (((Category.assoc _ _ _).symm.trans (congrArg (fun g => g ≫ _) h2.symm)).trans
        (Category.assoc _ _ _)))
  have hs : ∀ {V₁ V₂ : Over (wcGeomPoint F Y hY)} (k : V₁ ⟶ V₂),
      ((wcSliceBC F p hX hY).map k).left.left ≫ ((wcSliceBC F p hX hY).obj V₂).hom.left =
        ((wcSliceBC F p hX hY).obj V₁).hom.left :=
    fun k => congrArg (fun f => f.left) (Over.w ((wcSliceBC F p hX hY).map k))
  have nat : ∀ {V₁ V₂ : Over (wcGeomPoint F Y hY)} (k : V₁ ⟶ V₂),
      (wcSliceBC F p hX hY).map k ≫ (κc V₂).hom =
        (κc V₁).hom ≫ (wcOverToSlice Y.left (wcGeomPoint F Y hY) ⋙ wcProEtBC pb ⋙
          wcSliceToOver X.left (wcGeomPoint F X hX)).map k := by
    intro V₁ V₂ k
    have hc1 : ((wcProEtBC pb).map ((wcOverToSlice Y.left (wcGeomPoint F Y hY)).map k)).left ≫
        Limits.pullback.fst V₂.hom.left pb = Limits.pullback.fst V₁.hom.left pb ≫ k.left.left :=
      Limits.pullback.lift_fst _ _ _
    have hc2 : ((wcProEtBC pb).map ((wcOverToSlice Y.left (wcGeomPoint F Y hY)).map k)).left ≫
        Limits.pullback.snd V₂.hom.left pb = Limits.pullback.snd V₁.hom.left pb :=
      Limits.pullback.lift_snd _ _ _
    apply Over.OverMorphism.ext
    apply MorphismProperty.Over.Hom.ext
    show ((wcSliceBC F p hX hY).map k).left.left ≫ (ι V₂).hom =
      (ι V₁).hom ≫ ((wcProEtBC pb).map ((wcOverToSlice Y.left (wcGeomPoint F Y hY)).map k)).left
    apply Limits.pullback.hom_ext
    · exact (Category.assoc _ _ _).trans ((congrArg (fun g => _ ≫ g) (hι1 V₂)).trans
        ((key k).symm.trans ((congrArg (fun g => g ≫ _) (hι1 V₁)).symm.trans
          ((Category.assoc _ _ _).trans ((congrArg (fun g => _ ≫ g) hc1).symm.trans
            (Category.assoc _ _ _).symm)))))
    · exact (Category.assoc _ _ _).trans ((congrArg (fun g => _ ≫ g) (hι2 V₂)).trans
        ((hs k).trans ((hι2 V₁).symm.trans ((congrArg (fun g => _ ≫ g) hc2).symm.trans
          (Category.assoc _ _ _).symm))))
  refine ⟨NatIso.ofComponents κc nat, fun V => ?_⟩
  exact hι1 V

theorem wc_sliceBC_continuous_flat (F : Type u) [Field F] {X Y : Over (Spec (.of F))} (p : X ⟶ Y)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) :
    (wcSliceBC F p hX hY).IsContinuous ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX)) ∧
    RepresentablyFlat (wcSliceBC F p hX hY) :=
by
  classical

  let pb : wcXbar F X ⟶ wcXbar F Y :=
    Limits.pullback.lift
      (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
        p.left)
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (by rw [Category.assoc, Over.w p, Limits.pullback.condition])
  obtain ⟨κ, -⟩ := wc_sliceBC_comparison F p hX hY pb (Limits.pullback.lift_fst _ _ _)
    (Limits.pullback.lift_snd _ _ _)

  obtain ⟨hST_X, -, -, -⟩ := wc_slice_over_sites_cont X.left (wcGeomPoint F X hX)
  obtain ⟨-, hOS_Y, -, -⟩ := wc_slice_over_sites_cont Y.left (wcGeomPoint F Y hY)
  obtain ⟨hc, hf⟩ := wc_proet_pullback_continuous_flat pb
  haveI hc' : (wcProEtBC pb).IsContinuous (Scheme.ProEt.topology (wcGeomPoint F Y hY).left)
      (Scheme.ProEt.topology (wcGeomPoint F X hX).left) := hc
  haveI hf' : RepresentablyFlat (wcProEtBC pb) := hf
  haveI := hST_X
  haveI := hOS_Y

  have h23 : (wcProEtBC pb ⋙ wcSliceToOver X.left (wcGeomPoint F X hX)).IsContinuous
      (Scheme.ProEt.topology (wcGeomPoint F Y hY).left)
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX)) :=
    @Functor.isContinuous_comp _ _ _ _ _ _ (wcProEtBC pb) (wcSliceToOver X.left (wcGeomPoint F X hX))
      (Scheme.ProEt.topology (wcGeomPoint F Y hY).left)
      (Scheme.ProEt.topology (wcGeomPoint F X hX).left)
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX)) hc' hST_X
  have h123 : (wcOverToSlice Y.left (wcGeomPoint F Y hY) ⋙ wcProEtBC pb ⋙
      wcSliceToOver X.left (wcGeomPoint F X hX)).IsContinuous
      ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX)) :=
    @Functor.isContinuous_comp _ _ _ _ _ _ (wcOverToSlice Y.left (wcGeomPoint F Y hY))
      (wcProEtBC pb ⋙ wcSliceToOver X.left (wcGeomPoint F X hX))
      ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      (Scheme.ProEt.topology (wcGeomPoint F Y hY).left)
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX)) hOS_Y h23

  let eqvOf : ∀ (S : Scheme.{u}) (U : S.ProEt), U.left.ProEt ≌ Over U := fun S U =>
    Equivalence.mk' (wcSliceToOver S U) (wcOverToSlice S U) (Iso.refl _)
      (NatIso.ofComponents (fun V =>
        Over.isoMk (MorphismProperty.Over.isoMk (Iso.refl V.left.left)
            ((Category.id_comp _).trans (MorphismProperty.Over.w V.hom).symm))
          (MorphismProperty.Over.Hom.ext (Category.id_comp V.hom.left)))
        (fun {V V'} g => by
          apply Over.OverMorphism.ext
          apply MorphismProperty.Over.Hom.ext
          exact (Category.comp_id g.left.left).trans (Category.id_comp g.left.left).symm))
      (fun W => by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact Category.comp_id (𝟙 W.left))
  haveI hRA_OS : (wcOverToSlice Y.left (wcGeomPoint F Y hY)).IsRightAdjoint :=
    (eqvOf Y.left (wcGeomPoint F Y hY)).isRightAdjoint_inverse
  haveI hRA_ST : (wcSliceToOver X.left (wcGeomPoint F X hX)).IsRightAdjoint :=
    (eqvOf X.left (wcGeomPoint F X hX)).isRightAdjoint_functor
  have fOS : RepresentablyFlat (wcOverToSlice Y.left (wcGeomPoint F Y hY)) :=
    RepresentablyFlat.of_isRightAdjoint (wcOverToSlice Y.left (wcGeomPoint F Y hY))
  have fST : RepresentablyFlat (wcSliceToOver X.left (wcGeomPoint F X hX)) :=
    RepresentablyFlat.of_isRightAdjoint (wcSliceToOver X.left (wcGeomPoint F X hX))

  have f23 : RepresentablyFlat (wcProEtBC pb ⋙ wcSliceToOver X.left (wcGeomPoint F X hX)) :=
    @RepresentablyFlat.comp _ _ _ _ _ _ (wcProEtBC pb) (wcSliceToOver X.left (wcGeomPoint F X hX))
      hf' fST
  have f123 : RepresentablyFlat (wcOverToSlice Y.left (wcGeomPoint F Y hY) ⋙ wcProEtBC pb ⋙
      wcSliceToOver X.left (wcGeomPoint F X hX)) :=
    @RepresentablyFlat.comp _ _ _ _ _ _ (wcOverToSlice Y.left (wcGeomPoint F Y hY))
      (wcProEtBC pb ⋙ wcSliceToOver X.left (wcGeomPoint F X hX)) fOS f23

  exact ⟨@Functor.isContinuous_of_iso _ _ _ _ _ _ κ.symm
      ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX)) h123,
    @RepresentablyFlat.of_iso _ _ _ _ _ f123 _ κ.symm⟩

theorem wc_slice_contfun_locally_bijective (F : Type u) [Field F] {X Y : Over (Spec (.of F))}
    (p : X ⟶ Y)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    (∀ (V' : Over (wcGeomPoint F X hX)) (r' : C(↥V'.left.left, ULift.{u+1} ℚ_[ℓ])),
      ∃ T ∈ (Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX) V',
        ∀ ⦃W' : Over (wcGeomPoint F X hX)⦄ (g : W' ⟶ V'), T.arrows g →
          ∃ (V : Over (wcGeomPoint F Y hY)) (a : W' ⟶ (wcSliceBC F p hX hY).obj V)
            (r : C(↥V.left.left, ULift.{u+1} ℚ_[ℓ])),
            r'.comp g.left.left.base.hom =
              (r.comp (wcSliceProj F p hX hY V).base.hom).comp a.left.left.base.hom) ∧
    (∀ (V' : Over (wcGeomPoint F X hX)) (V : Over (wcGeomPoint F Y hY))
      (a : V' ⟶ (wcSliceBC F p hX hY).obj V) (r : C(↥V.left.left, ULift.{u+1} ℚ_[ℓ])),
      (r.comp (wcSliceProj F p hX hY V).base.hom).comp a.left.left.base.hom = 0 →
      ∃ T ∈ (Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX) V',
        ∀ ⦃W' : Over (wcGeomPoint F X hX)⦄ (g : W' ⟶ V'), T.arrows g →
          ∃ (W : Over (wcGeomPoint F Y hY)) (b : W ⟶ V) (a' : W' ⟶ (wcSliceBC F p hX hY).obj W),
            a' ≫ (wcSliceBC F p hX hY).map b = g ≫ a ∧ r.comp b.left.left.base.hom = 0) :=
by
  classical

  let pb : wcXbar F X ⟶ wcXbar F Y :=
    Limits.pullback.lift
      (Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
        p.left)
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
      (by rw [Category.assoc, Over.w p, Limits.pullback.condition])
  obtain ⟨κ, hκ⟩ := wc_sliceBC_comparison F p hX hY pb (Limits.pullback.lift_fst _ _ _)
    (Limits.pullback.lift_snd _ _ _)
  obtain ⟨B1, B2⟩ := wc_proet_contfun_pullback_locally_bijective pb ℓ
  haveI hcoc : (wcOverToSlice X.left (wcGeomPoint F X hX)).IsCocontinuous
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX))
      (Scheme.ProEt.topology (wcGeomPoint F X hX).left) :=
    (wc_slice_over_sites_cont X.left (wcGeomPoint F X hX)).2.2.2

  let εX : ∀ V : Over (wcGeomPoint F X hX),
      (wcSliceToOver X.left (wcGeomPoint F X hX)).obj
        ((wcOverToSlice X.left (wcGeomPoint F X hX)).obj V) ≅ V := fun V =>
    Over.isoMk (MorphismProperty.Over.isoMk (Iso.refl V.left.left)
        ((Category.id_comp _).trans (MorphismProperty.Over.w V.hom).symm))
      (MorphismProperty.Over.Hom.ext (Category.id_comp V.hom.left))
  let εY : ∀ V : Over (wcGeomPoint F Y hY),
      (wcSliceToOver Y.left (wcGeomPoint F Y hY)).obj
        ((wcOverToSlice Y.left (wcGeomPoint F Y hY)).obj V) ≅ V := fun V =>
    Over.isoMk (MorphismProperty.Over.isoMk (Iso.refl V.left.left)
        ((Category.id_comp _).trans (MorphismProperty.Over.w V.hom).symm))
      (MorphismProperty.Over.Hom.ext (Category.id_comp V.hom.left))

  have G2 : ∀ {A B C : Scheme.{u}} (i : A ⟶ B) (h : B ⟶ A) (f : A ⟶ C) (pr : B ⟶ C),
      h ≫ f = pr → i ≫ h = 𝟙 A → i ≫ pr = f := by
    intro A B C i h f pr hp e
    rw [← hp, ← Category.assoc, e, Category.id_comp]
  have G3 : ∀ {A B C D : Scheme.{u}} (x : A ⟶ B) (y : B ⟶ C) (z : C ⟶ D) (w : B ⟶ D),
      y ≫ z = w → (x ≫ y) ≫ z = x ≫ w := by
    intro A B C D x y z w h
    rw [Category.assoc, h]
  have G1 : ∀ {A B C D : Scheme.{u}} (x : A ⟶ B) (y : B ⟶ C) (z : C ⟶ D) (w : B ⟶ D),
      y ≫ z = w → (𝟙 A ≫ x ≫ y) ≫ z = x ≫ w := by
    intro A B C D x y z w h
    rw [Category.id_comp, Category.assoc, h]
  have G4 : ∀ {A A' P Q R S : Scheme.{u}} (a0 : A ⟶ P) (ki : P ⟶ Q) (kh : Q ⟶ P) (gb : Q ⟶ R)
      (bc : P ⟶ S) (kiV : S ⟶ R) (gl : A ⟶ A') (al : A' ⟶ R) (khV : R ⟶ S),
      gb = kh ≫ bc ≫ kiV → ki ≫ kh = 𝟙 P → a0 ≫ bc = gl ≫ al ≫ khV → khV ≫ kiV = 𝟙 R →
      (𝟙 A ≫ a0 ≫ ki) ≫ gb = gl ≫ al := by
    intro A A' P Q R S a0 ki kh gb bc kiV gl al khV hgb e1 hd e2
    subst hgb
    calc (𝟙 A ≫ a0 ≫ ki) ≫ kh ≫ bc ≫ kiV = a0 ≫ (ki ≫ kh) ≫ bc ≫ kiV := by
          simp only [Category.id_comp, Category.assoc]
      _ = (a0 ≫ bc) ≫ kiV := by rw [e1, Category.id_comp, Category.assoc]
      _ = gl ≫ al ≫ (khV ≫ kiV) := by rw [hd]; simp only [Category.assoc]
      _ = gl ≫ al := by rw [e2, Category.comp_id]
  have hinvhom : ∀ V : Over (wcGeomPoint F Y hY),
      (κ.inv.app V).left.left ≫ (κ.hom.app V).left.left = 𝟙 _ := fun V =>
    congrArg (fun k => k.left.left) (κ.inv_hom_id_app V)
  have hhominv : ∀ V : Over (wcGeomPoint F Y hY),
      (κ.hom.app V).left.left ≫ (κ.inv.app V).left.left = 𝟙 _ := fun V =>
    congrArg (fun k => k.left.left) (κ.hom_inv_id_app V)
  have hκ' : ∀ V : Over (wcGeomPoint F Y hY),
      (κ.inv.app V).left.left ≫ wcSliceProj F p hX hY V = Limits.pullback.fst V.hom.left pb :=
    fun V => G2 _ _ _ _ (hκ V) (hinvhom V)
  refine ⟨?_, ?_⟩
  ·
    intro V' r'
    obtain ⟨T'', hT'', P''⟩ := B1 ((wcOverToSlice X.left (wcGeomPoint F X hX)).obj V') r'
    refine ⟨Sieve.functorPullback (wcOverToSlice X.left (wcGeomPoint F X hX)) T'',
      Functor.cover_lift (wcOverToSlice X.left (wcGeomPoint F X hX))
        ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX))
        (Scheme.ProEt.topology (wcGeomPoint F X hX).left) hT'', ?_⟩
    intro W' g hg
    obtain ⟨V0, a'', r0, hstar⟩ := P'' ((wcOverToSlice X.left (wcGeomPoint F X hX)).map g) hg
    refine ⟨(wcSliceToOver Y.left (wcGeomPoint F Y hY)).obj V0,
