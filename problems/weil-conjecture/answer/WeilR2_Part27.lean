            ∑ i, ((ρ x : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) i m).val • φ i =
          ∑ i, ((ρ (x * y) : Matrix (Fin r) (Fin r) (ZMod (ℓ ^ n))) i j).val • φ i := by
      intro X x y j φ
      simp_rw [Finset.smul_sum, smul_smul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [← Finset.sum_smul]
      apply TC
      rw [ZMod.natCast_zmod_val, map_mul, Units.val_mul, Matrix.mul_apply, Nat.cast_sum]
      refine Finset.sum_congr rfl (fun m _ => ?_)
      rw [Nat.cast_mul, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val, mul_comm]
    apply Limits.Pi.hom_ext; rintro ⟨f, j⟩
    have e2 : wcSpfMerge Γ f (Fin.last p) (Fin.last p) = Fintype.equivFin Γ
        ((Fintype.equivFin Γ).symm (f (Fin.last p).castSucc) *
          (Fintype.equivFin Γ).symm (f (Fin.last (p + 1)))) := by
      simp [wcSpfMerge, Fin.succ_last]
