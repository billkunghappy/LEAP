theorem wc_slice_pullback_const (F : Type u) [Field F] {X Y : Over (Spec (.of F))} (p : X ⟶ Y)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [(wcSliceBC F p hX hY).IsContinuous ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX))]
    [(SheafOfModules.pushforward.{u+1} (wcSliceRingMap F p hX hY ℓ)).IsRightAdjoint]
    (c : ℚ_[ℓ]) :
    (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ)).map (wcModConst F Y hY ℓ c) ≫
        SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ) =
      SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ) ≫ wcModConst F X hX ℓ c :=
by
  classical
  have key : ∀ g : SheafOfModules.unit (wcSliceRing F Y hY ℓ) ⟶
      (SheafOfModules.pushforward.{u+1} (wcSliceRingMap F p hX hY ℓ)).obj
        (SheafOfModules.unit (wcSliceRing F X hX ℓ)),
      wcModConst F Y hY ℓ c ≫ g =
        g ≫ (SheafOfModules.pushforward.{u+1} (wcSliceRingMap F p hX hY ℓ)).map
          (wcModConst F X hX ℓ c) := by
    intro g
    apply (SheafOfModules.unitHomEquiv _).injective
    apply PresheafOfModules.sections_ext
    intro W
    cases W with
    | op V =>
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    obtain ⟨a, b, hab, ha1, ha2⟩ : ∃ (a : ↑((wcSliceRing F Y hY ℓ).obj.obj (Opposite.op V)))
        (b : ↑((wcSliceRing F X hX ℓ).obj.obj (Opposite.op ((wcSliceBC F p hX hY).obj V)))),
        @Eq ↑((wcSliceRing F X hX ℓ).obj.obj (Opposite.op ((wcSliceBC F p hX hY).obj V)))
          (((wcSliceRingMap F p hX hY ℓ).hom.app (Opposite.op V)).hom a) b ∧
        (∀ r : ↑((wcSliceRing F Y hY ℓ).obj.obj (Opposite.op V)),
          @Eq ↑((wcSliceRing F Y hY ℓ).obj.obj (Opposite.op V))
            (((wcModConst F Y hY ℓ c).val.app (Opposite.op V)).hom r) (r * a)) ∧
        (∀ r : ↑((wcSliceRing F X hX ℓ).obj.obj (Opposite.op ((wcSliceBC F p hX hY).obj V))),
          @Eq ↑((wcSliceRing F X hX ℓ).obj.obj (Opposite.op ((wcSliceBC F p hX hY).obj V)))
            (((wcModConst F X hX ℓ c).val.app (Opposite.op ((wcSliceBC F p hX hY).obj V))).hom r)
            (r * b)) :=
      ⟨(ContinuousMap.const _ (ULift.up c) : C(↥V.left.left, ULift.{u+1} ℚ_[ℓ])),
        (ContinuousMap.const _ (ULift.up c) :
          C(↥((wcSliceBC F p hX hY).obj V).left.left, ULift.{u+1} ℚ_[ℓ])),
        rfl, fun r => rfl, fun r => rfl⟩
    change (g.val.app (Opposite.op V)).hom (((wcModConst F Y hY ℓ c).val.app (Opposite.op V)).hom
          (@id ↑((SheafOfModules.unit (wcSliceRing F Y hY ℓ)).val.obj (Opposite.op V))
            (1 : ↑((wcSliceRing F Y hY ℓ).obj.obj (Opposite.op V))))) =
        ((wcModConst F X hX ℓ c).val.app (Opposite.op ((wcSliceBC F p hX hY).obj V))).hom
          ((g.val.app (Opposite.op V)).hom
            (@id ↑((SheafOfModules.unit (wcSliceRing F Y hY ℓ)).val.obj (Opposite.op V))
              (1 : ↑((wcSliceRing F Y hY ℓ).obj.obj (Opposite.op V)))))
    have e1 : ((wcModConst F Y hY ℓ c).val.app (Opposite.op V)).hom
          (@id ↑((SheafOfModules.unit (wcSliceRing F Y hY ℓ)).val.obj (Opposite.op V))
            (1 : ↑((wcSliceRing F Y hY ℓ).obj.obj (Opposite.op V)))) =
        a • (@id ↑((SheafOfModules.unit (wcSliceRing F Y hY ℓ)).val.obj (Opposite.op V))
            (1 : ↑((wcSliceRing F Y hY ℓ).obj.obj (Opposite.op V)))) := by
      have h := ha1 1
      change @Eq ↑((wcSliceRing F Y hY ℓ).obj.obj (Opposite.op V))
        (((wcModConst F Y hY ℓ c).val.app (Opposite.op V)).hom
          (1 : ↑((wcSliceRing F Y hY ℓ).obj.obj (Opposite.op V))))
        (a * 1)
      rw [h, one_mul, mul_one]
    rw [e1, LinearMap.map_smul]
    generalize (g.val.app (Opposite.op V)).hom
      (@id ↑((SheafOfModules.unit (wcSliceRing F Y hY ℓ)).val.obj (Opposite.op V))
        (1 : ↑((wcSliceRing F Y hY ℓ).obj.obj (Opposite.op V)))) = y
    have h2 := ha2 y
    refine Eq.trans ?_ h2.symm
    change @Eq ↑((wcSliceRing F X hX ℓ).obj.obj (Opposite.op ((wcSliceBC F p hX hY).obj V)))
      (@HMul.hMul ↑((wcSliceRing F X hX ℓ).obj.obj (Opposite.op ((wcSliceBC F p hX hY).obj V)))
        ↑((wcSliceRing F X hX ℓ).obj.obj (Opposite.op ((wcSliceBC F p hX hY).obj V)))
        ↑((wcSliceRing F X hX ℓ).obj.obj (Opposite.op ((wcSliceBC F p hX hY).obj V))) instHMul
        (((wcSliceRingMap F p hX hY ℓ).hom.app (Opposite.op V)).hom a) y)
      (@HMul.hMul ↑((wcSliceRing F X hX ℓ).obj.obj (Opposite.op ((wcSliceBC F p hX hY).obj V)))
        ↑((wcSliceRing F X hX ℓ).obj.obj (Opposite.op ((wcSliceBC F p hX hY).obj V)))
        ↑((wcSliceRing F X hX ℓ).obj.obj (Opposite.op ((wcSliceBC F p hX hY).obj V))) instHMul y b)
    rw [hab]
    exact @mul_comm C(↥((wcSliceBC F p hX hY).obj V).left.left, ULift.{u+1} ℚ_[ℓ]) _ b y
  apply ((SheafOfModules.pullbackPushforwardAdjunction (wcSliceRingMap F p hX hY ℓ)).homEquiv
    _ _).injective
  rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right]
  exact key _

theorem wc_modPullOK_holds (F : Type u) [Field F] {X Y : Over (Spec (.of F))} (p : X ⟶ Y)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    wcModPullOK F p hX hY ℓ :=
by
  classical

  obtain ⟨hcont, hflat⟩ := wc_sliceBC_continuous_flat F p hX hY
  letI := hcont
  haveI := hflat

  haveI : (PresheafOfModules.pushforward.{u+1} (wcSliceRingMap F p hX hY ℓ).hom).IsRightAdjoint :=
    wc_presheafOfModules_pushforward_isRightAdjoint _ _
  haveI hRA : (SheafOfModules.pushforward.{u+1} (wcSliceRingMap F p hX hY ℓ)).IsRightAdjoint :=
    inferInstance
  let Φ := SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ)
  let adj : Φ ⊣ SheafOfModules.pushforward.{u+1} (wcSliceRingMap F p hX hY ℓ) :=
    SheafOfModules.pullbackPushforwardAdjunction _

  haveI : Φ.IsLeftAdjoint := adj.isLeftAdjoint
  haveI : Φ.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isLeftAdjoint Φ
  haveI : Limits.PreservesColimitsOfSize.{0, 0} Φ := adj.leftAdjoint_preservesColimits
  haveI hcol : Limits.PreservesFiniteColimits Φ :=
    Limits.PreservesColimitsOfSize.preservesFiniteColimits Φ
  haveI : Limits.PreservesBinaryBiproducts Φ :=
    Limits.preservesBinaryBiproducts_of_preservesBinaryCoproducts Φ
  haveI hadd : Φ.Additive := Functor.additive_of_preservesBinaryBiproducts Φ

  obtain ⟨hs, hi⟩ := wc_slice_contfun_locally_bijective F p hX hY ℓ
  obtain ⟨ι⟩ := wc_sheafOfModules_pullback_toSheaf_iso
    ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX)) (wcSliceBC F p hX hY)
    (wcSliceRing F Y hY ℓ) (wcSliceRing F X hX ℓ) (wcSliceRingMap F p hX hY ℓ) hs hi Φ adj
  haveI := wc_sheafPullback_preservesFiniteLimits_of_flat
    ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
    ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX)) (wcSliceBC F p hX hY)
  haveI : Limits.PreservesFiniteLimits (SheafOfModules.toSheaf.{u+1} (wcSliceRing F Y hY ℓ) ⋙
      (wcSliceBC F p hX hY).sheafPullback AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
        ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX))) :=
    Limits.comp_preservesFiniteLimits _ _
  haveI : Limits.PreservesFiniteLimits (Φ ⋙ SheafOfModules.toSheaf.{u+1} (wcSliceRing F X hX ℓ)) :=
    Limits.preservesFiniteLimits_of_natIso ι.symm
  haveI hlim : Limits.PreservesFiniteLimits Φ :=
    Limits.preservesFiniteLimits_of_reflects_of_preserves Φ
      (SheafOfModules.toSheaf.{u+1} (wcSliceRing F X hX ℓ))

  haveI : (wcSliceBC F p hX hY).Final := final_of_representablyFlat _
  have hiso : IsIso (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ)) :=
    inferInstance

  exact ⟨hcont, hRA, hadd, hlim, hcol, hiso, fun c => wc_slice_pullback_const F p hX hY ℓ c⟩

theorem wc_sliceBC_overToSlice_iso (F : Type u) [Field F] {X Y : Over (Spec (.of F))} (p : X ⟶ Y)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (pb : wcXbar F X ⟶ wcXbar F Y)
    (h1 : pb ≫ Limits.pullback.fst Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      Limits.pullback.fst X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫ p.left)
    (h2 : pb ≫ Limits.pullback.snd Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      Limits.pullback.snd X.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :
    ∃ α : wcOverToSlice Y.left (wcGeomPoint F Y hY) ⋙ wcProEtBC pb ≅
        wcSliceBC F p hX hY ⋙ wcOverToSlice X.left (wcGeomPoint F X hX),
      ∀ V : Over (wcGeomPoint F Y hY),
        (α.hom.app V).left ≫ wcSliceProj F p hX hY V =
          Limits.pullback.fst ((wcOverToSlice Y.left (wcGeomPoint F Y hY)).obj V).hom pb :=
by
  classical
  have congrPB : ∀ {P X' Y' Z' : Scheme.{u}} {a a' : P ⟶ X'} {b : P ⟶ Y'} {c : X' ⟶ Z'}
      {d d' : Y' ⟶ Z'}, a = a' → d = d' → IsPullback a b c d → IsPullback a' b c d' := by
    intro _ _ _ _ _ _ _ _ _ _ ha hd h
    subst ha
    subst hd
    exact h
  have hA : (wcGeomPointMap F p hX hY).left ≫
      Limits.pullback.fst (Limits.pullback.fst Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) p.left = pb := by
    refine (Limits.pullback.lift_fst _ _ _).trans ?_
    apply Limits.pullback.hom_ext
    · exact (Limits.pullback.lift_fst _ _ _).trans h1.symm
    · exact (Limits.pullback.lift_snd _ _ _).trans h2.symm
  have F1 : ∀ V : Over (wcGeomPoint F Y hY),
      IsPullback
        (Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V).hom
          (wcGeomPointMap F p hX hY)).left
        ((wcSliceBC F p hX hY).obj V).hom.left
        ((wcProEtPullback p.left).map V.hom).left (wcGeomPointMap F p hX hY).left := by
    intro V
    exact (Scheme.ProEt.forget X.left ⋙ Over.forget X.left).map_isPullback
      (IsPullback.of_hasPullback ((Over.post (wcProEtPullback p.left)).obj V).hom
        (wcGeomPointMap F p hX hY))
  have F2 : ∀ V : Over (wcGeomPoint F Y hY),
      IsPullback ((wcProEtPullback p.left).map V.hom).left
        (Limits.pullback.fst V.left.hom p.left)
        (Limits.pullback.fst (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) p.left)
        V.hom.left := by
    intro V
    have hm1 : ((wcProEtPullback p.left).map V.hom).left ≫
        Limits.pullback.fst (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) p.left =
        Limits.pullback.fst V.left.hom p.left ≫ V.hom.left := Limits.pullback.lift_fst _ _ _
    have hm2 : ((wcProEtPullback p.left).map V.hom).left ≫
        Limits.pullback.snd (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) p.left =
        Limits.pullback.snd V.left.hom p.left := Limits.pullback.lift_snd _ _ _
    have hw : V.hom.left ≫ Limits.pullback.fst Y.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) = V.left.hom :=
      MorphismProperty.Over.w V.hom
    exact IsPullback.of_right
      (congrPB hm2.symm hw.symm (IsPullback.of_hasPullback V.left.hom p.left).flip) hm1
      (IsPullback.of_hasPullback _ _).flip
  have Sq : ∀ V : Over (wcGeomPoint F Y hY),
      IsPullback (wcSliceProj F p hX hY V) ((wcSliceBC F p hX hY).obj V).hom.left V.hom.left pb :=
    fun V => congrPB rfl hA (IsPullback.paste_horiz (F1 V) (F2 V).flip)
  let ι : ∀ V : Over (wcGeomPoint F Y hY),
      ((wcSliceBC F p hX hY).obj V).left.left ≅ Limits.pullback V.hom.left pb :=
    fun V => (Sq V).isoPullback
  have hinv1 : ∀ V : Over (wcGeomPoint F Y hY),
      (ι V).inv ≫ wcSliceProj F p hX hY V = Limits.pullback.fst V.hom.left pb :=
    fun V => (Sq V).isoPullback_inv_fst
  have hinv2 : ∀ V : Over (wcGeomPoint F Y hY),
      (ι V).inv ≫ ((wcSliceBC F p hX hY).obj V).hom.left = Limits.pullback.snd V.hom.left pb :=
    fun V => (Sq V).isoPullback_inv_snd
  let β : ∀ V : Over (wcGeomPoint F Y hY),
      (wcOverToSlice Y.left (wcGeomPoint F Y hY) ⋙ wcProEtBC pb).obj V ≅
        (wcSliceBC F p hX hY ⋙ wcOverToSlice X.left (wcGeomPoint F X hX)).obj V :=
    fun V => MorphismProperty.Over.isoMk (ι V).symm (by
      show (ι V).inv ≫ ((wcSliceBC F p hX hY).obj V).hom.left = Limits.pullback.snd V.hom.left pb
      exact hinv2 V)
  have key : ∀ {V₁ V₂ : Over (wcGeomPoint F Y hY)} (k : V₁ ⟶ V₂),
      wcSliceProj F p hX hY V₁ ≫ k.left.left =
        ((wcSliceBC F p hX hY).map k).left.left ≫ wcSliceProj F p hX hY V₂ := by
    intro V₁ V₂ k
    have h1 : ((wcSliceBC F p hX hY).map k).left ≫
        Limits.pullback.fst ((Over.post (wcProEtPullback p.left)).obj V₂).hom
