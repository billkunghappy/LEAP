    obtain ⟨ψΓ, hψΓ⟩ : ∃ f : ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} a).obj
        (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y) ⟶
        ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} a).obj
        (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj Y'), f = ψa :=
      ⟨ψa, rfl⟩
    have hΓψ : ((Scheme.ProEt.topology S).overMapPullback AddCommGrpCat.{u+1} a).map ψ = ψΓ := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext V
      rw [hψΓ]
      exact (hψa V.unop).symm
    apply (hΨbij Y').1
    rw [hK, hstar, hstar, hK, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      hΓψ, ← Abelian.Ext.comp_assoc_of_third_deg_zero, hψΓ]
    rfl
  ·
    intro Y Y' ψ hs z
    obtain ⟨x, hx⟩ := hs (Ψ Y' z)
    obtain ⟨y, hy⟩ := (hΨbij Y).2 x
    refine ⟨y, (hΨbij Y').1 ?_⟩
    rw [hK, hy, hx]

theorem wcvs_coker_offS_sections_zero (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (hqc : QuasiCompact w.left)
    (hcov : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (k : ℕ) (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (μ : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] ℚ_[ℓ]) (hμ : μ ≠ 0)
    (ψ : G.over (wcGeomPoint K (wcP1Over K) hP) ⟶
        (wcLadicSheaf (wcP1Over K).left ℓ).over (wcGeomPoint K (wcP1Over K) hP))
    (hψ : ∀ (V : (wcP1Over K).left.ProEt) (h' : V ⟶ W) (y : G.obj.obj (Opposite.op V))
      (z : V.left),
      (show C(↥V.left, ℚ_[ℓ]) from
        ((ψ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom y).down) z =
        μ (wcContEval (wcP1Over K).left V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y) z))
    (Ub : (wcGeomPoint K (wcP1Over K) hP).left.Opens)
    (hUb : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left, p ∈ Ub ↔
        ∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) :
    ∀ (V' : Over (wcGeomPoint K (wcP1Over K) hP)), (∀ v : V'.left.left, V'.hom.left v ∈ Ub) →
      ∀ s : (Limits.cokernel ψ).obj.obj (Opposite.op V'), s = 0 :=
by
  intro V' hV' s

  obtain ⟨u0, hu0⟩ : ∃ u0, μ u0 ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    exact hμ (LinearMap.ext hcon)
  have hμv0 : μ ((μ u0)⁻¹ • u0) = 1 := by
    rw [map_smul, smul_eq_mul, inv_mul_cancel₀ hu0]
  have hsurj : ∀ (V : (wcP1Over K).left.ProEt) (h' : V ⟶ W) (f : C(↥V.left, ℚ_[ℓ])),
      ∃ y : G.obj.obj (Opposite.op V),
        (show C(↥V.left, ℚ_[ℓ]) from
          ((ψ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom y).down) = f := by
    intro V h' f
    let F0 : C(↥V.left, Fin k → ℚ_[ℓ]) :=
      ⟨fun z => f z • ((μ u0)⁻¹ • u0), f.continuous.smul continuous_const⟩
    let F : ((wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W).obj.obj
        (Opposite.op (Over.mk h')) := (⟨F0⟩ : ULift.{u+1} C(↥V.left, Fin k → ℚ_[ℓ]))
    refine ⟨(θ.inv.hom.app (Opposite.op (Over.mk h'))).hom F, ?_⟩
    have h1 : (θ.hom.hom.app (Opposite.op (Over.mk h'))).hom
        ((θ.inv.hom.app (Opposite.op (Over.mk h'))).hom F) = F :=
      congrArg (fun φ => (φ.hom.app (Opposite.op (Over.mk h'))).hom F) θ.inv_hom_id
    have h2 : ∀ z : V.left, wcContEval (wcP1Over K).left V ((θ.hom.hom.app
        (Opposite.op (Over.mk h'))).hom ((θ.inv.hom.app (Opposite.op (Over.mk h'))).hom F)) z =
        f z • ((μ u0)⁻¹ • u0) := by
      intro z
      unfold wcContEval
      rw [h1]
      rfl
    ext z
    refine (hψ V h' _ z).trans ?_
    rw [h2 z, map_smul, hμv0, smul_eq_mul, mul_one]

  have hdetect : ∀ (V'' : Over (wcGeomPoint K (wcP1Over K) hP)),
      (∀ v : V''.left.left, V''.hom.left v ∈ Ub) →
      ∀ (s'' : (Limits.cokernel ψ).obj.obj (Opposite.op V'')),
      (∀ (V : (wcP1Over K).left.ProEt) (h' : V ⟶ W) (t : Over.mk (h' ≫ w) ⟶ V''),
        ((Limits.cokernel ψ).obj.map t.op).hom s'' = 0) → s'' = 0 := by
    intro V'' hV s'' H
    haveI := hqc
    haveI hWp : WeaklyEtale W.hom := W.prop
    haveI hUp : WeaklyEtale (wcGeomPoint K (wcP1Over K) hP).hom :=
      (wcGeomPoint K (wcP1Over K) hP).prop
    haveI hVp : WeaklyEtale V''.left.hom := V''.left.prop
    haveI hwU : WeaklyEtale (w.left ≫ (wcGeomPoint K (wcP1Over K) hP).hom) := by
      rw [MorphismProperty.Over.w w]; exact hWp
    haveI : WeaklyEtale w.left := WeaklyEtale.of_comp w.left (wcGeomPoint K (wcP1Over K) hP).hom
    haveI hfst : WeaklyEtale (Limits.pullback.fst V''.hom.left w.left) := inferInstance
    haveI hfstq : QuasiCompact (Limits.pullback.fst V''.hom.left w.left) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst V''.hom.left w.left ≫ V''.left.hom) := inferInstance
    let T : (wcP1Over K).left.ProEt :=
      Scheme.ProEt.mk (Limits.pullback.fst V''.hom.left w.left ≫ V''.left.hom)
    let a : T ⟶ V''.left :=
      MorphismProperty.Over.homMk (Limits.pullback.fst V''.hom.left w.left) rfl trivial
    have hb : Limits.pullback.snd V''.hom.left w.left ≫ W.hom =
        Limits.pullback.fst V''.hom.left w.left ≫ V''.left.hom := by
      rw [← MorphismProperty.Over.w w, ← MorphismProperty.Over.w V''.hom, ← Category.assoc,
        ← Category.assoc, Limits.pullback.condition]
    let b : T ⟶ W :=
      MorphismProperty.Over.homMk (Limits.pullback.snd V''.hom.left w.left) hb trivial
    have hsq : a ≫ V''.hom = b ≫ w := by
      apply MorphismProperty.Over.Hom.ext
      exact Limits.pullback.condition
    let t : Over.mk (b ≫ w) ⟶ V'' := Over.homMk a hsq
    have ht := H T b t
    have hsurj' : ∀ x : V''.left.left, ∃ (_ : PUnit.{u+2}) (y : T.left), a.left y = x := by
      intro q
      have hq := (hUb _).mp (hV q)
      obtain ⟨z, hz⟩ := hcov _ hq
      obtain ⟨τ, hτ, -⟩ := Scheme.Pullback.exists_preimage_pullback q z hz.symm
      exact ⟨PUnit.unit, τ, hτ⟩
    haveI hae : WeaklyEtale a.left := hfst
    haveI haq : QuasiCompact a.left := hfstq
    let 𝒰 : Scheme.Cover (Scheme.precoverage @WeaklyEtale) V''.left.left :=
      Scheme.Cover.mkOfCovers (P := @WeaklyEtale) PUnit.{u+2} (fun _ => T.left) (fun _ => a.left)
        hsurj' (fun _ => hae)
    have hqc𝒰 : QuasiCompactCover 𝒰.toPreZeroHypercover :=
      @QuasiCompactCover.of_finite _ _ 𝒰 Scheme.instJointlySurjectivePrecoverage
        (fun _ => haq) (inferInstanceAs (Finite PUnit.{u+2}))
    have hR : Presieve.ofArrows (fun _ : PUnit.{u+2} => T.left) (fun _ => a.left) ∈
        Scheme.proetalePrecoverage.coverings V''.left.left :=
      Scheme.mem_propQCPrecoverage_iff_exists_quasiCompactCover.mpr ⟨𝒰, hqc𝒰, rfl⟩
    have e := Presieve.map_ofArrows (F := Scheme.ProEt.forget (wcP1Over K).left ⋙
      Over.forget (wcP1Over K).left) (Y := fun _ : PUnit.{u+2} => T) (fun _ => a)
    have hR' : Presieve.ofArrows (fun _ : PUnit.{u+2} => T) (fun _ => a) ∈
        (Scheme.ProEt.precoverage (wcP1Over K).left).coverings V''.left :=
      Precoverage.mem_comap_iff.mpr (e ▸ hR)
    have hRJ : Sieve.generate (Presieve.ofArrows (fun _ : PUnit.{u+2} => T) (fun _ => a)) ∈
        (Scheme.ProEt.topology (wcP1Over K).left) V''.left :=
      Precoverage.generate_mem_toGrothendieck hR'
    have hS0 := GrothendieckTopology.overEquiv_symm_mem_over
      (Scheme.ProEt.topology (wcP1Over K).left) V'' _ hRJ
    refine Sheaf.isSeparated (Limits.cokernel ψ) V'' _ hS0 s'' 0 ?_
    intro Z f hf
    rw [Sieve.overEquiv_symm_iff] at hf
    obtain ⟨Y', e0, g0, hg0, he0⟩ := hf
    rcases hg0 with ⟨i⟩
    have he' : e0 ≫ (b ≫ w) = Z.hom := by
      rw [← hsq, ← Category.assoc, he0, Over.w f]
    let e' : Z ⟶ Over.mk (b ≫ w) := Over.homMk e0 he'
    have hf' : f = e' ≫ t := Over.OverMorphism.ext he0.symm
    rw [hf', op_comp, Functor.map_comp, ConcreteCategory.comp_apply, ConcreteCategory.comp_apply]
    change ((Limits.cokernel ψ).obj.map e'.op).hom (((Limits.cokernel ψ).obj.map t.op).hom s'') =
      ((Limits.cokernel ψ).obj.map e'.op).hom (((Limits.cokernel ψ).obj.map t.op).hom 0)
    rw [ht, map_zero, map_zero, map_zero]

  have hR : Presheaf.imageSieve (Limits.cokernel.π ψ).hom s ∈
      ((Scheme.ProEt.topology (wcP1Over K).left).over (wcGeomPoint K (wcP1Over K) hP)) V' := by
    haveI : Sheaf.IsLocallySurjective (Limits.cokernel.π ψ) :=
      (Sheaf.isLocallySurjective_iff_epi' _ (Limits.cokernel.π ψ)).mpr inferInstance
    exact Presheaf.imageSieve_mem _ (Limits.cokernel.π ψ).hom s
  refine Sheaf.isSeparated (Limits.cokernel ψ) V' _ hR s 0 ?_
  rintro V'' g ⟨lam, hlam⟩

  have hV'' : ∀ v : V''.left.left, V''.hom.left v ∈ Ub := by
    intro v
    have e2 : V''.hom.left = g.left.left ≫ V'.hom.left := by
      rw [← Over.w g]; rfl
    rw [e2, Scheme.Hom.comp_apply]
    exact hV' _
  have hz := hdetect V'' hV'' (((Limits.cokernel ψ).obj.map g.op).hom s) (by
    intro V h' t
    obtain ⟨y, hy⟩ := hsurj V h' (show C(↥V.left, ℚ_[ℓ]) from
      ((((wcLadicSheaf (wcP1Over K).left ℓ).over (wcGeomPoint K (wcP1Over K) hP)).obj.map
        t.op).hom lam).down)
    have hy' : (ψ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom y =
        (((wcLadicSheaf (wcP1Over K).left ℓ).over (wcGeomPoint K (wcP1Over K) hP)).obj.map
          t.op).hom lam := ULift.ext _ _ hy
    have e1 : ((Limits.cokernel ψ).obj.map t.op).hom (((Limits.cokernel ψ).obj.map g.op).hom s) =
        ((Limits.cokernel.π ψ).hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom
          ((((wcLadicSheaf (wcP1Over K).left ℓ).over (wcGeomPoint K (wcP1Over K) hP)).obj.map
            t.op).hom lam) := by
      rw [← hlam]
      exact (NatTrans.naturality_apply (Limits.cokernel.π ψ).hom t.op lam).symm
    rw [e1, ← hy']
    change ((ψ ≫ Limits.cokernel.π ψ).hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom y = 0
    rw [Limits.cokernel.condition ψ]
    rfl)
  rw [hz, map_zero]

theorem wcvs_kernel_frame (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (k : ℕ) (θ : G.over W ≅ (wcContSheaf (wcP1Over K).left (Fin k → ℚ_[ℓ])).over W)
    (μ : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] ℚ_[ℓ]) (hμ : μ ≠ 0)
    (ψ : G.over (wcGeomPoint K (wcP1Over K) hP) ⟶
        (wcLadicSheaf (wcP1Over K).left ℓ).over (wcGeomPoint K (wcP1Over K) hP))
    (hψ : ∀ (V : (wcP1Over K).left.ProEt) (h' : V ⟶ W) (y : G.obj.obj (Opposite.op V))
      (z : V.left),
      (show C(↥V.left, ℚ_[ℓ]) from
        ((ψ.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom y).down) z =
        μ (wcContEval (wcP1Over K).left V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y) z)) :
    ∃ r : ℕ, Nonempty ((Limits.kernel ψ).over (Over.mk w) ≅
      (((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1}
        (wcGeomPoint K (wcP1Over K) hP)).obj
          (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ]))).over (Over.mk w)) :=
by
  classical

  obtain ⟨r, Pm, Qm, hPQ, hμQ, hQP, hPc, hQc⟩ : ∃ (r : ℕ)
      (Pm : (Fin k → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]))
      (Qm : (Fin r → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin k → ℚ_[ℓ])),
      (∀ u, Pm (Qm u) = u) ∧ (∀ u, μ (Qm u) = 0) ∧ (∀ v, μ v = 0 → Qm (Pm v) = v) ∧
      Continuous Pm ∧ Continuous Qm := by
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective (LinearMap.ker μ).subtype
      (Submodule.ker_subtype _)
    let b := (Module.finBasis ℚ_[ℓ] (LinearMap.ker μ)).equivFun
    refine ⟨_, b.toLinearMap ∘ₗ g, (LinearMap.ker μ).subtype ∘ₗ b.symm.toLinearMap, ?_, ?_, ?_,
      LinearMap.continuous_on_pi _, LinearMap.continuous_on_pi _⟩
    · intro u
      have h1 : g ((b.symm u : LinearMap.ker μ) : Fin k → ℚ_[ℓ]) = b.symm u :=
        LinearMap.congr_fun hg (b.symm u)
      show b (g ((b.symm u : LinearMap.ker μ) : Fin k → ℚ_[ℓ])) = u
      rw [h1, LinearEquiv.apply_symm_apply]
    · intro u
      exact LinearMap.mem_ker.mp (b.symm u).2
    · intro v hv
      have h2 : g v = ⟨v, hv⟩ := LinearMap.congr_fun hg ⟨v, hv⟩
      show ((b.symm (b (g v)) : LinearMap.ker μ) : Fin k → ℚ_[ℓ]) = v
      rw [h2, LinearEquiv.symm_apply_apply]
  let Pmap := wcContSheafMap (wcP1Over K).left Pm.toAddMonoidHom hPc
  let Qmap := wcContSheafMap (wcP1Over K).left Qm.toAddMonoidHom hQc

  have hψ'' : ∀ (V : (wcP1Over K).left.ProEt) (h : V ⟶ W)
      (f : V ⟶ wcGeomPoint K (wcP1Over K) hP) (_ : h ≫ w = f)
      (y : G.obj.obj (Opposite.op V)) (z : V.left),
      (show C(↥V.left, ℚ_[ℓ]) from ((ψ.hom.app (Opposite.op (Over.mk f))).hom y).down) z =
        μ (wcContEval (wcP1Over K).left V
          ((θ.hom.hom.app (Opposite.op (Over.mk h))).hom y) z) := by
    intro V h f heq y z
    subst heq
    exact hψ V h y z
  have hψ' : ∀ (Y : Over (wcGeomPoint K (wcP1Over K) hP)) (h : Y.left ⟶ W) (_ : h ≫ w = Y.hom)
      (y : G.obj.obj (Opposite.op Y.left)) (z : Y.left.left),
      (show C(↥Y.left.left, ℚ_[ℓ]) from ((ψ.hom.app (Opposite.op Y)).hom y).down) z =
        μ (wcContEval (wcP1Over K).left Y.left
          ((θ.hom.hom.app (Opposite.op (Over.mk h))).hom y) z) :=
    fun Y h heq y z => hψ'' Y.left h Y.hom heq y z

  have hker : ∀ (Y : Over (wcGeomPoint K (wcP1Over K) hP)),
      Function.Injective ((Limits.kernel.ι ψ).hom.app (Opposite.op Y)).hom ∧
      (∀ s, (ψ.hom.app (Opposite.op Y)).hom
          (((Limits.kernel.ι ψ).hom.app (Opposite.op Y)).hom s) = 0) ∧
      (∀ y, (ψ.hom.app (Opposite.op Y)).hom y = 0 →
          ∃ s, ((Limits.kernel.ι ψ).hom.app (Opposite.op Y)).hom s = y) := by
    intro Y
    let E := sheafToPresheaf ((Scheme.ProEt.topology (wcP1Over K).left).over
        (wcGeomPoint K (wcP1Over K) hP)) AddCommGrpCat.{u+1} ⋙
      (evaluation _ AddCommGrpCat.{u+1}).obj (Opposite.op Y)
    refine ⟨?_, ?_, ?_⟩
    · have hm : Mono (E.map (Limits.kernel.ι ψ)) := E.map_mono _
      exact (AddCommGrpCat.mono_iff_injective _).mp hm
    · intro s
      have h1 := congrArg E.map (Limits.kernel.condition ψ)
      rw [E.map_comp, E.map_zero] at h1
      exact ConcreteCategory.congr_hom h1 s
    · intro y hy
      let y₁ := (AddCommGrpCat.kernelIsoKer (E.map ψ)).inv.hom ⟨y, hy⟩
      refine ⟨(Limits.PreservesKernel.iso E ψ).inv.hom y₁, ?_⟩
      have e1 := ConcreteCategory.congr_hom (Limits.PreservesKernel.iso_inv_ι E ψ) y₁
      have e2 := ConcreteCategory.congr_hom
        (AddCommGrpCat.kernelIsoKer_inv_comp_ι (E.map ψ)) ⟨y, hy⟩
      exact e1.trans e2

  have hbij : ∀ X : Over (Over.mk w), Function.Bijective
      (fun s : (Limits.kernel ψ).obj.obj (Opposite.op X.left) =>
        (Pmap.hom.app (Opposite.op X.left.left)).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk X.hom.left))).hom
            (((Limits.kernel.ι ψ).hom.app (Opposite.op X.left)).hom s))) := by
    intro X
    obtain ⟨hinj, hzero, hlift⟩ := hker X.left
    have hψX := hψ' X.left X.hom.left (Over.w X.hom)
    have hθ1 : ∀ y, (θ.inv.hom.app (Opposite.op (Over.mk X.hom.left))).hom
        ((θ.hom.hom.app (Opposite.op (Over.mk X.hom.left))).hom y) = y := fun y =>
      ConcreteCategory.congr_hom
        (congrArg (fun f => f.hom.app (Opposite.op (Over.mk X.hom.left))) θ.hom_inv_id) y
    have hθ2 : ∀ F, (θ.hom.hom.app (Opposite.op (Over.mk X.hom.left))).hom
        ((θ.inv.hom.app (Opposite.op (Over.mk X.hom.left))).hom F) = F := fun F =>
      ConcreteCategory.congr_hom
        (congrArg (fun f => f.hom.app (Opposite.op (Over.mk X.hom.left))) θ.inv_hom_id) F
    have hval : ∀ s z, μ (wcContEval (wcP1Over K).left X.left.left
        ((θ.hom.hom.app (Opposite.op (Over.mk X.hom.left))).hom
          (((Limits.kernel.ι ψ).hom.app (Opposite.op X.left)).hom s)) z) = 0 := by
      intro s z
      refine (hψX (((Limits.kernel.ι ψ).hom.app (Opposite.op X.left)).hom s) z).symm.trans ?_
      rw [hzero s]
      rfl
    constructor
    · intro s s' hss
      have hpt : ∀ z, Pm (wcContEval (wcP1Over K).left X.left.left
          ((θ.hom.hom.app (Opposite.op (Over.mk X.hom.left))).hom
            (((Limits.kernel.ι ψ).hom.app (Opposite.op X.left)).hom s)) z) =
          Pm (wcContEval (wcP1Over K).left X.left.left
          ((θ.hom.hom.app (Opposite.op (Over.mk X.hom.left))).hom
            (((Limits.kernel.ι ψ).hom.app (Opposite.op X.left)).hom s')) z) := fun z =>
        congrArg (fun t => wcContEval (wcP1Over K).left X.left.left t z) hss
      have hθeq : (θ.hom.hom.app (Opposite.op (Over.mk X.hom.left))).hom
            (((Limits.kernel.ι ψ).hom.app (Opposite.op X.left)).hom s) =
          (θ.hom.hom.app (Opposite.op (Over.mk X.hom.left))).hom
            (((Limits.kernel.ι ψ).hom.app (Opposite.op X.left)).hom s') := by
        apply ULift.ext
        apply ContinuousMap.ext
        intro z
        exact (hQP _ (hval s z)).symm.trans ((congrArg Qm (hpt z)).trans (hQP _ (hval s' z)))
      apply hinj
      exact (hθ1 _).symm.trans ((congrArg (θ.inv.hom.app (Opposite.op (Over.mk X.hom.left))).hom
        hθeq).trans (hθ1 _))
    · intro f
      let F := (Qmap.hom.app (Opposite.op X.left.left)).hom f
      let y := (θ.inv.hom.app (Opposite.op (Over.mk X.hom.left))).hom F
      have hθy : (θ.hom.hom.app (Opposite.op (Over.mk X.hom.left))).hom y = F := hθ2 F
      have hψy : (ψ.hom.app (Opposite.op X.left)).hom y = 0 := by
        apply ULift.ext
        apply ContinuousMap.ext
        intro z
        have h1 := hψX y z
        rw [hθy] at h1
        exact h1.trans (hμQ (wcContEval (wcP1Over K).left X.left.left f z))
      obtain ⟨s, hs⟩ := hlift y hψy
      refine ⟨s, ?_⟩
      beta_reduce
      rw [hs, hθy]
      apply ULift.ext
      apply ContinuousMap.ext
      intro z
      exact hPQ _

  let α : ((Limits.kernel ψ).over (Over.mk w)).obj ⟶
      ((((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1}
        (wcGeomPoint K (wcP1Over K) hP)).obj
          (wcContSheaf (wcP1Over K).left (Fin r → ℚ_[ℓ]))).over (Over.mk w)).obj :=
    { app := fun X => (Limits.kernel.ι ψ).hom.app (Opposite.op X.unop.left) ≫
          θ.hom.hom.app (Opposite.op (Over.mk X.unop.hom.left)) ≫
          Pmap.hom.app (Opposite.op X.unop.left.left)
      naturality := by
        intro X X' f
        ext s
        have hγ : f.unop.left.left ≫ X.unop.hom.left = X'.unop.hom.left := by
          rw [← Over.comp_left, Over.w f.unop]
        let β : Over.mk X'.unop.hom.left ⟶ Over.mk X.unop.hom.left :=
          Over.homMk f.unop.left.left hγ
        have e1 := NatTrans.naturality_apply (Limits.kernel.ι ψ).hom f.unop.left.op s
        have e2 := NatTrans.naturality_apply θ.hom.hom β.op
          (((Limits.kernel.ι ψ).hom.app (Opposite.op X.unop.left)).hom s)
        have e3 := NatTrans.naturality_apply Pmap.hom f.unop.left.left.op
          ((θ.hom.hom.app (Opposite.op (Over.mk X.unop.hom.left))).hom
            (((Limits.kernel.ι ψ).hom.app (Opposite.op X.unop.left)).hom s))
        exact (congrArg (fun t => (Pmap.hom.app (Opposite.op X'.unop.left.left)).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk X'.unop.hom.left))).hom t)) e1).trans
          ((congrArg (fun t => (Pmap.hom.app (Opposite.op X'.unop.left.left)).hom t) e2).trans
            e3) }

  haveI : ∀ X, IsIso (α.app X) := fun X =>
    (ConcreteCategory.isIso_iff_bijective _).mpr (hbij X.unop)
  haveI : IsIso α := NatIso.isIso_of_isIso_app α
  exact ⟨r, ⟨ObjectProperty.isoMk _ (asIso α)⟩⟩

theorem wcvs_offS_part (S : Scheme.{u}) (U : S.ProEt) (Ub : U.left.Opens)
    (M : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}) :
    ∃ (A : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}) (α : A ⟶ M),
      Mono α ∧
      (∀ (V' : Over U), (∀ v : V'.left.left, V'.hom.left v ∈ Ub) →
        ∀ s : (Limits.cokernel α).obj.obj (Opposite.op V'), s = 0) ∧
      wcvsSuppJ S U Ub A ∧
      (∀ (V' : Over U), (∀ v : V'.left.left, V'.hom.left v ∈ Ub) →
        IsIso ((((Scheme.ProEt.topology S).over U).overPullback AddCommGrpCat.{u+1} V').map α)) :=
by
  classical

  have hoff : ∀ {V' V'' : Over U} (g : V'' ⟶ V'), (∀ v : V'.left.left, V'.hom.left v ∈ Ub) →
      ∀ v : V''.left.left, V''.hom.left v ∈ Ub := by
    intro V' V'' g hV' v
    have e2 : V''.hom.left = g.left.left ≫ V'.hom.left := by
      rw [← Over.w g]; rfl
    rw [e2, Scheme.Hom.comp_apply]
    exact hV' _

  obtain ⟨Cond, hCond⟩ : ∃ Cond : ∀ T : Over U, M.obj.obj (Opposite.op T) → Prop,
      ∀ T s, Cond T s ↔ ∃ R : Sieve T, R ∈ ((Scheme.ProEt.topology S).over U) T ∧
        ∀ (V'' : Over U) (g : V'' ⟶ T), R.arrows g →
          (∀ v : V''.left.left, V''.hom.left v ∈ Ub) ∨ (M.obj.map g.op).hom s = 0 :=
    ⟨_, fun _ _ => Iff.rfl⟩
  have hres : ∀ (T T' : Over U) (k : T' ⟶ T) (s : M.obj.obj (Opposite.op T)),
      Cond T s → Cond T' ((M.obj.map k.op).hom s) := by
    intro T T' k s hs
    rw [hCond] at hs ⊢
    obtain ⟨R, hR, hp⟩ := hs
    refine ⟨R.pullback k, ((Scheme.ProEt.topology S).over U).pullback_stable k hR, ?_⟩
    intro V'' g hg
    rcases hp V'' (g ≫ k) hg with h | h
    · exact Or.inl h
    · right
      have e : (M.obj.map g.op).hom ((M.obj.map k.op).hom s) =
          (M.obj.map (g ≫ k).op).hom s := by
        rw [op_comp, M.obj.map_comp]
        rfl
      rw [e]
      exact h
  have hloc : ∀ (T : Over U) (s : M.obj.obj (Opposite.op T)) (R : Sieve T),
      R ∈ ((Scheme.ProEt.topology S).over U) T →
      (∀ (Y : Over U) (f : Y ⟶ T), R.arrows f → Cond Y ((M.obj.map f.op).hom s)) →
      Cond T s := by
    intro T s R hR H
    have H' := fun (Y : Over U) (f : Y ⟶ T) (hf : R.arrows f) => (hCond _ _).mp (H Y f hf)
    choose R' hR'J hR'p using H'
    rw [hCond]
    refine ⟨Sieve.bind R.arrows R', ((Scheme.ProEt.topology S).over U).bind_covering hR hR'J, ?_⟩
    intro Z h hh
    obtain ⟨Y, g, f, hf, hg, rfl⟩ := hh
    rcases hR'p Y f hf Z g hg with h1 | h1
    · exact Or.inl h1
    · right
      have e : (M.obj.map (g ≫ f).op).hom s = (M.obj.map g.op).hom ((M.obj.map f.op).hom s) := by
        rw [op_comp, M.obj.map_comp]
        rfl
      rw [e]
      exact h1
  let Q : ∀ T : Over U, AddSubgroup (M.obj.obj (Opposite.op T)) := fun T =>
    { carrier := {s | Cond T s}
      zero_mem' := by
        show Cond T 0
        rw [hCond]
        exact ⟨⊤, ((Scheme.ProEt.topology S).over U).top_mem T,
          fun V'' g _ => Or.inr (map_zero _)⟩
      add_mem' := by
        intro a b ha hb
        change Cond T a at ha
        change Cond T b at hb
        show Cond T (a + b)
        rw [hCond] at ha hb ⊢
        obtain ⟨R₁, h₁, p₁⟩ := ha
        obtain ⟨R₂, h₂, p₂⟩ := hb
        refine ⟨R₁ ⊓ R₂, ((Scheme.ProEt.topology S).over U).intersection_covering h₁ h₂, ?_⟩
        intro V'' g hg
        rcases p₁ V'' g hg.1 with o | z1
        · exact Or.inl o
        rcases p₂ V'' g hg.2 with o | z2
        · exact Or.inl o
        right
        rw [map_add, z1, z2, add_zero]
      neg_mem' := by
        intro a ha
        change Cond T a at ha
        show Cond T (-a)
        rw [hCond] at ha ⊢
        obtain ⟨R₁, h₁, p₁⟩ := ha
        refine ⟨R₁, h₁, ?_⟩
        intro V'' g hg
        rcases p₁ V'' g hg with o | z1
        · exact Or.inl o
        right
        rw [map_neg, z1, neg_zero] }
  let P : (Over U)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    { obj := fun T => AddCommGrpCat.of (Q T.unop)
      map := fun {T T'} g => AddCommGrpCat.ofHom (AddMonoidHom.codRestrict
        ((M.obj.map g).hom.comp (Q T.unop).subtype) (Q T'.unop)
          (fun x => hres T.unop T'.unop g.unop x.1 x.2))
      map_id := fun T => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro x
        apply Subtype.ext
        change M.obj.map (𝟙 T) x.1 = x.1
        rw [M.obj.map_id]
        rfl
      map_comp := fun {T T' T''} f g => by
        apply AddCommGrpCat.hom_ext
        apply AddMonoidHom.ext
        intro x
        apply Subtype.ext
        change M.obj.map (f ≫ g) x.1 = M.obj.map g (M.obj.map f x.1)
        rw [M.obj.map_comp]
        rfl }
  let α : P ⟶ M.obj :=
    { app := fun T => AddCommGrpCat.ofHom (Q T.unop).subtype
      naturality := fun _ _ _ => rfl }
  have hGt : Presieve.IsSheaf ((Scheme.ProEt.topology S).over U)
      (M.obj ⋙ forget AddCommGrpCat.{u+1}) :=
    (isSheaf_iff_isSheaf_of_type _ _).mp
      ((Presheaf.isSheaf_iff_isSheaf_forget _ _ (forget AddCommGrpCat.{u+1})).mp M.property)
  have hPt : Presieve.IsSheaf ((Scheme.ProEt.topology S).over U)
      (P ⋙ forget AddCommGrpCat.{u+1}) := by
    intro T R hR x hx
    let y : Presieve.FamilyOfElements (M.obj ⋙ forget AddCommGrpCat.{u+1}) (R : Presieve T) :=
      fun Y f hf => (x f hf).1
    have hy : y.Compatible := by
      intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
      exact congrArg Subtype.val (hx g₁ g₂ h₁ h₂ comm)
    obtain ⟨t, ht, htu⟩ := hGt R hR y hy
    have htQ : t ∈ Q T := hloc T t R hR (fun Y f hf => by
      have e : (M.obj.map f.op).hom t = (x f hf).1 := ht f hf
      rw [e]
      exact (x f hf).2)
    refine ⟨⟨t, htQ⟩, ?_, ?_⟩
    · intro Y f hf
      apply Subtype.ext
      exact ht f hf
    · intro t' ht'
      apply Subtype.ext
      apply htu
      intro Y f hf
      exact congrArg Subtype.val (ht' f hf)
  have hP : Presheaf.IsSheaf ((Scheme.ProEt.topology S).over U) P :=
    (Presheaf.isSheaf_iff_isSheaf_forget _ _ (forget AddCommGrpCat.{u+1})).mpr
      ((isSheaf_iff_isSheaf_of_type _ _).mpr hPt)
  let Ps : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1} := ⟨P, hP⟩
  let ι : Ps ⟶ M := ObjectProperty.homMk α
  haveI : ∀ T, Mono (α.app T) := fun T =>
    (AddCommGrpCat.mono_iff_injective _).mpr (AddSubgroup.subtype_injective _)
  haveI hαmono : Mono α := NatTrans.mono_of_mono_app α
  have hmono : Mono ι :=
    Functor.mono_of_mono_map (sheafToPresheaf ((Scheme.ProEt.topology S).over U)
      AddCommGrpCat.{u+1}) hαmono

  have hsupp : wcvsSuppJ S U Ub Ps := by
    intro V' s
    have hs : Cond V' (s : ↥(Q V')).1 := (s : ↥(Q V')).2
    rw [hCond] at hs
    obtain ⟨R, hR, hp⟩ := hs
    refine ⟨R, hR, fun V'' g hg => ?_⟩
    rcases hp V'' g hg with o | z
    · exact Or.inl o
    · right
      apply Subtype.ext
      exact z

  have hbij : ∀ V' : Over U, (∀ v : V'.left.left, V'.hom.left v ∈ Ub) →
      Function.Bijective (ι.hom.app (Opposite.op V')).hom := by
    intro V' hV'
    refine ⟨fun a b h => Subtype.ext h, fun m => ?_⟩
    have hm : Cond V' m := by
      rw [hCond]
      exact ⟨⊤, ((Scheme.ProEt.topology S).over U).top_mem V',
        fun V'' g _ => Or.inl (hoff g hV')⟩
    exact ⟨(⟨m, hm⟩ : ↥(Q V')), rfl⟩

  have hcok : ∀ (V' : Over U), (∀ v : V'.left.left, V'.hom.left v ∈ Ub) →
      ∀ s : (Limits.cokernel ι).obj.obj (Opposite.op V'), s = 0 := by
    intro V' hV' s
    have hR : Presheaf.imageSieve (Limits.cokernel.π ι).hom s ∈
        ((Scheme.ProEt.topology S).over U) V' := by
      haveI : Sheaf.IsLocallySurjective (Limits.cokernel.π ι) :=
        (Sheaf.isLocallySurjective_iff_epi' _ (Limits.cokernel.π ι)).mpr inferInstance
      exact Presheaf.imageSieve_mem _ (Limits.cokernel.π ι).hom s
    refine Sheaf.isSeparated (Limits.cokernel ι) V' _ hR s 0 ?_
    rintro V'' g ⟨lam, hlam⟩
    obtain ⟨a, ha⟩ := (hbij V'' (hoff g hV')).2 lam
    have hz : ((Limits.cokernel ι).obj.map g.op).hom s = 0 := by
      rw [← hlam, ← ha]
      change ((ι ≫ Limits.cokernel.π ι).hom.app (Opposite.op V'')).hom a = 0
      rw [Limits.cokernel.condition ι]
      rfl
    rw [hz, map_zero]

  have hiso : ∀ (V' : Over U), (∀ v : V'.left.left, V'.hom.left v ∈ Ub) →
      IsIso ((((Scheme.ProEt.topology S).over U).overPullback AddCommGrpCat.{u+1} V').map ι) := by
    intro V' hV'
    have h2 : IsIso ((sheafToPresheaf (((Scheme.ProEt.topology S).over U).over V')
        AddCommGrpCat.{u+1}).map
        ((((Scheme.ProEt.topology S).over U).overPullback AddCommGrpCat.{u+1} V').map ι)) := by
      refine (NatTrans.isIso_iff_isIso_app _).mpr (fun X => ?_)
      have hX : ∀ v : X.unop.left.left.left, X.unop.left.hom.left v ∈ Ub := hoff X.unop.hom hV'
      exact (ConcreteCategory.isIso_iff_bijective _).mpr (hbij _ hX)
    exact (fullyFaithfulSheafToPresheaf _ _).isIso_of_isIso_map _
  exact ⟨Ps, ι, hmono, hcok, hsupp, hiso⟩

theorem wcvs_geom_transport (S : Scheme.{u}) (U : S.ProEt)
    [(wcSliceToOver S U).IsContinuous (Scheme.ProEt.topology U.left) ((Scheme.ProEt.topology S).over U)]
    (Ub : U.left.Opens) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r : ℕ)
    (A : Sheaf ((Scheme.ProEt.topology S).over U) AddCommGrpCat.{u+1}) (V' : Over U)
    (θA : A.over V' ≅ (((Scheme.ProEt.topology S).overPullback AddCommGrpCat.{u+1} U).obj
      (wcContSheaf S (Fin r → ℚ_[ℓ]))).over V')
    (hA : wcvsSuppJ S U Ub A) :
    Nonempty ((((wcSliceToOver S U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) ((Scheme.ProEt.topology S).over U)).obj A).over
          ((wcOverToSlice S U).obj V') ≅
        (wcContSheaf U.left (Fin r → ℚ_[ℓ])).over ((wcOverToSlice S U).obj V')) ∧
      wcvsSuppY U.left Ub (((wcSliceToOver S U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) ((Scheme.ProEt.topology S).over U)).obj A) :=
by

  let εapp : ∀ V : Over U, (wcOverToSlice S U ⋙ wcSliceToOver S U).obj V ≅ V := fun V =>
    Over.isoMk (MorphismProperty.Over.isoMk (Iso.refl V.left.left)
        ((Category.id_comp _).trans (MorphismProperty.Over.w V.hom).symm))
      (MorphismProperty.Over.Hom.ext (Category.id_comp V.hom.left))

  let Φ : Over ((wcOverToSlice S U).obj V') ⥤ Over V' :=
    Over.post (wcSliceToOver S U) ⋙ Over.map (εapp V').hom
  have hI : Nonempty ((((wcSliceToOver S U).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology U.left) ((Scheme.ProEt.topology S).over U)).obj A).over
          ((wcOverToSlice S U).obj V') ≅
        (wcContSheaf U.left (Fin r → ℚ_[ℓ])).over ((wcOverToSlice S U).obj V')) := by
    refine ⟨(fullyFaithfulSheafToPresheaf _ _).preimageIso ?_⟩
    exact Functor.isoWhiskerLeft Φ.op ((sheafToPresheaf _ _).mapIso θA)

  have hmem : ∀ (T : Scheme.{u}) (V : T.ProEt) (R : Sieve V),
      R ∈ Scheme.ProEt.topology T V ↔
        Sieve.functorPushforward (Scheme.ProEt.forget T ⋙ Over.forget T) R ∈
          Scheme.proetaleTopology V.left := by
    intro T V R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have hT : Scheme.ProEt.topology T =
        (Scheme.ProEt.forget T).restrictedTopology (Scheme.proetaleTopology.over T) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := T)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [hT, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl
  have hmemD : ∀ (V : Over U) (R : Sieve V), R ∈ (Scheme.ProEt.topology S).over U V ↔
      Sieve.functorPushforward (Over.forget U ⋙ Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
        Scheme.proetaleTopology V.left.left := by
    intro V R
    rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_apply, hmem S V.left,
      ← Sieve.functorPushforward_comp]
  have hFc : (wcSliceToOver S U).IsCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) := by
    constructor
    intro W T hT
    rw [hmem U.left W]
    rw [hmemD] at hT
    refine GrothendieckTopology.superset_covering _ ?_ hT
    rintro Z f ⟨V'', t, a, ht, rfl⟩
    refine ⟨(wcOverToSlice S U).obj V'', (wcOverToSlice S U).map t, a, ?_, rfl⟩
    show T.arrows ((wcSliceToOver S U).map ((wcOverToSlice S U).map t))
    have hft : (wcSliceToOver S U).map ((wcOverToSlice S U).map t) = (εapp V'').hom ≫ t := by
      apply Over.OverMorphism.ext
      apply MorphismProperty.Over.Hom.ext
      exact (Category.id_comp t.left.left).symm
    exact (congrArg (fun g => T.arrows g) hft).mpr (T.downward_closed ht _)
  refine ⟨hI, ?_⟩
  intro V s
  obtain ⟨R₀, hR₀, H⟩ := hA ((wcSliceToOver S U).obj V) s
  refine ⟨Sieve.functorPullback (wcSliceToOver S U) R₀,
    @Functor.IsCocontinuous.cover_lift _ _ _ _ (wcSliceToOver S U) (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) hFc V R₀ hR₀, ?_⟩
  intro V'' g hg
  exact H _ ((wcSliceToOver S U).map g) hg

theorem wcvs_lat_affine_W_cover : ∀ (Y : Scheme.{u}) (Ub : Y.Opens) (W' : Y.ProEt),
    QuasiCompact W'.hom → (∀ p : Y, p ∈ Ub → ∃ z : W'.left, W'.hom z = p) →
    ∀ (V : Y.ProEt), (∀ v : V.left, V.hom v ∈ Ub) →
      Sieve.generate (fun (T : Y.ProEt) (_ : T ⟶ V) => IsAffine T.left ∧ Nonempty (T ⟶ W')) ∈
        Scheme.ProEt.topology Y V :=
by
  classical
  intro Y Ub W' hqc hcov V hV

  have crit : ∀ (U : Y.ProEt) (R : Sieve U),
      (∀ (W : Y.ProEt) (v : W ⟶ U), IsAffine W.left →
        ∃ (m : ℕ) (W₁ : Fin m → Y.ProEt) (e : ∀ j, W₁ j ⟶ W),
          (∀ j, IsAffine (W₁ j).left) ∧ (∀ y : W.left, ∃ j, y ∈ Set.range (e j).left) ∧
          ∀ j, R.arrows (e j ≫ v)) →
      R ∈ Scheme.ProEt.topology Y U := by
    intro U R hR
    have fin_covers : ∀ (U : Y.ProEt) [QuasiSeparatedSpace U.left] (n : ℕ) (W : Fin n → Y.ProEt)
        (h : ∀ i, W i ⟶ U), (∀ i, IsAffine (W i).left) →
        (∀ x : U.left, ∃ i, x ∈ Set.range (h i).left) →
        Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology Y U := by
      intro U _ n W h hA hJ
      have hs : ∀ x : U.left, ∃ j y, (h j).left y = x := by
        intro x
        obtain ⟨j, y, hy⟩ := hJ x
        exact ⟨j, y, hy⟩
      have hq : ∀ i, QuasiCompact (h i).left := fun i => by
        haveI := hA i
        exact quasiCompact_of_compactSpace _
      have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
        have h1 : WeaklyEtale ((h i).left ≫ U.hom) := by
          rw [MorphismProperty.Over.w (h i)]
          exact (W i).prop
        haveI := U.prop
        exact @WeaklyEtale.of_comp _ _ _ (h i).left U.hom h1 U.prop
      have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
          Scheme.proetalePrecoverage.coverings U.left :=
        ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (@QuasiCompactCover.of_finite _ _
          (Scheme.Cover.mkOfCovers (P := ⊤) (Fin n) (fun i => (W i).left) (fun i => (h i).left)
            hs (fun _ => trivial)) _ hq
            (inferInstanceAs (Finite (Fin n)))),
          (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
            ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
      exact Precoverage.generate_mem_toGrothendieck
        (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))
    have affine_local : ∀ (U : Y.ProEt) (T : Sieve U),
        (∀ (V : Y.ProEt) (f : V ⟶ U), IsAffine V.left →
          T.pullback f ∈ Scheme.ProEt.topology Y V) →
        T ∈ Scheme.ProEt.topology Y U := by
      intro U T hT
      have hU : WeaklyEtale U.hom := U.prop
      let W : U.left.affineCover.I₀ → Y.ProEt := fun i =>
        MorphismProperty.Over.mk ⊤ (U.left.affineCover.f i ≫ U.hom) inferInstance
      let e : ∀ i, W i ⟶ U := fun i =>
        MorphismProperty.Over.homMk (U.left.affineCover.f i) rfl trivial
      have hP : Presieve.ofArrows W e ∈ (Scheme.ProEt.precoverage Y).coverings U := by
        show _ ∈ (Precoverage.comap (Scheme.ProEt.forget Y ⋙ Over.forget Y)
          Scheme.proetalePrecoverage).coverings U
        rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
        change U.left.affineCover.presieve₀ ∈ Scheme.proetalePrecoverage.coverings U.left
        exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage U.left U.left.affineCover.mem₀,
          U.left.affineCover.mem₀.1,
          MorphismProperty.ofArrows_mem_precoverage.mpr (fun i => inferInstance)⟩
      refine GrothendieckTopology.transitive _ (Precoverage.generate_mem_toGrothendieck hP) T ?_
      intro Y' f hf
      obtain ⟨Y'', h, g', hg', rfl⟩ := hf
      rcases hg' with ⟨i⟩
      rw [Sieve.pullback_comp]
      exact GrothendieckTopology.pullback_stable _ h
        (hT (W i) (e i) (show IsAffine (U.left.affineCover.X i) by infer_instance))
    apply affine_local U R
    intro W v hW
    obtain ⟨m, W₁, e, haff, hsurj, hR'⟩ := hR W v hW
    haveI : IsAffine W.left := hW
    refine GrothendieckTopology.superset_covering _ ?_ (fin_covers W m W₁ e haff hsurj)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨j⟩
    exact hR' j

  apply crit V _
  intro T0 v hT0
  haveI : IsAffine T0.left := hT0
  haveI : QuasiCompact W'.hom := hqc
  haveI : WeaklyEtale W'.hom := W'.prop
  haveI : WeaklyEtale T0.hom := T0.prop
  have hUb : ∀ y : T0.left, T0.hom y ∈ Ub := by
    intro y
    have h := MorphismProperty.Over.w v
    have e1 : T0.hom y = V.hom (v.left y) := by
      rw [← h]
      exact Scheme.Hom.comp_apply _ _ _
    rw [e1]
    exact hV _
  haveI hT0c : CompactSpace T0.left := inferInstance
  haveI : CompactSpace ↥(Limits.pullback T0.hom W'.hom) :=
    @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.fst T0.hom W'.hom)
      inferInstance hT0c
  let 𝒱 := (Limits.pullback T0.hom W'.hom).affineCover.finiteSubcover
  let σ := (Fintype.equivFin 𝒱.I₀).symm
  let T : Fin (Fintype.card 𝒱.I₀) → Y.ProEt := fun j =>
    MorphismProperty.Over.mk ⊤ (𝒱.f (σ j) ≫ Limits.pullback.fst T0.hom W'.hom ≫ T0.hom)
      inferInstance
  let e : ∀ j, T j ⟶ T0 := fun j =>
    MorphismProperty.Over.homMk (𝒱.f (σ j) ≫ Limits.pullback.fst T0.hom W'.hom)
      (Category.assoc _ _ _) trivial
  refine ⟨Fintype.card 𝒱.I₀, T, e, fun j => (inferInstance : IsAffine (𝒱.X (σ j))), ?_, ?_⟩
  · intro y
    obtain ⟨z, hz⟩ := hcov _ (hUb y)
    obtain ⟨q, hq, -⟩ := Scheme.Pullback.exists_preimage_pullback y z hz.symm
    obtain ⟨i, x, hx⟩ := 𝒱.exists_eq q
    obtain ⟨j, rfl⟩ := σ.surjective i
    refine ⟨j, x, ?_⟩
    show (𝒱.f (σ j) ≫ Limits.pullback.fst T0.hom W'.hom) x = y
    rw [Scheme.Hom.comp_apply, hx, hq]
  · intro j
    refine ⟨T j, 𝟙 _, e j ≫ v, ⟨(inferInstance : IsAffine (𝒱.X (σ j))),
      ⟨MorphismProperty.Over.homMk (𝒱.f (σ j) ≫ Limits.pullback.snd T0.hom W'.hom) ?_ trivial⟩⟩,
      Category.id_comp _⟩
    show (𝒱.f (σ j) ≫ Limits.pullback.snd T0.hom W'.hom) ≫ W'.hom =
      𝒱.f (σ j) ≫ Limits.pullback.fst T0.hom W'.hom ≫ T0.hom
    rw [Category.assoc, ← Limits.pullback.condition]

theorem wcvs_lat_nsmul_iso : ∀ (Y : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (W' : Y.ProEt) (r : ℕ)
    (θ : G.over W' ≅ (wcContSheaf Y (Fin r → ℚ_[ℓ])).over W'),
    (∀ (U : Y.ProEt) (s : G.obj.obj (Opposite.op U)) (S : Sieve U),
      (∀ (T : Y.ProEt) (g : T ⟶ U), IsAffine T.left → Nonempty (T ⟶ W') → S.arrows g) →
      (∀ (T : Y.ProEt) (g : T ⟶ U), (G.obj.map g.op).hom s = 0 → S.arrows g) →
      S ∈ Scheme.ProEt.topology Y U) →
    ∀ (m : ℕ), m ≠ 0 → IsIso (m • 𝟙 G) :=
by
  intro Y ℓ _ G W' r θ hloc m hm

  have s1 : ∀ T : Y.ProEt, Function.Bijective
      (fun f : (wcContSheaf Y (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op T) => m • f) := by
    intro T
    have hc : (m : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hm
    constructor
    · intro f g hfg
      have h1 : (show C(↥T.left, Fin r → ℚ_[ℓ]) from (m • f).down) =
          (show C(↥T.left, Fin r → ℚ_[ℓ]) from (m • g).down) := congrArg ULift.down hfg
      change m • (show C(↥T.left, Fin r → ℚ_[ℓ]) from f.down) =
        m • (show C(↥T.left, Fin r → ℚ_[ℓ]) from g.down) at h1
      rw [← Nat.cast_smul_eq_nsmul ℚ_[ℓ], ← Nat.cast_smul_eq_nsmul ℚ_[ℓ]] at h1
      have h2 : (show C(↥T.left, Fin r → ℚ_[ℓ]) from f.down) =
          (show C(↥T.left, Fin r → ℚ_[ℓ]) from g.down) :=
        smul_right_injective (M := C(↥T.left, Fin r → ℚ_[ℓ])) hc h1
      exact ULift.ext _ _ h2
    · intro g
      refine ⟨ULift.up ((m : ℚ_[ℓ])⁻¹ • (show C(↥T.left, Fin r → ℚ_[ℓ]) from g.down)), ?_⟩
      apply ULift.ext
      change m • ((m : ℚ_[ℓ])⁻¹ • (show C(↥T.left, Fin r → ℚ_[ℓ]) from g.down)) =
        (show C(↥T.left, Fin r → ℚ_[ℓ]) from g.down)
      rw [← Nat.cast_smul_eq_nsmul ℚ_[ℓ], smul_inv_smul₀ hc]

  have s2 : ∀ (T : Y.ProEt) (b : T ⟶ W'),
      Function.Bijective (fun x : G.obj.obj (Opposite.op T) => m • x) := by
    intro T b
    let e : G.obj.obj (Opposite.op T) →+ (wcContSheaf Y (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op T) :=
      (θ.hom.hom.app (Opposite.op (Over.mk b))).hom
    let e' : (wcContSheaf Y (Fin r → ℚ_[ℓ])).obj.obj (Opposite.op T) →+ G.obj.obj (Opposite.op T) :=
      (θ.inv.hom.app (Opposite.op (Over.mk b))).hom
    have h1 : ∀ x, e' (e x) = x := fun x =>
      Iso.hom_inv_id_apply (((sheafToPresheaf _ AddCommGrpCat.{u+1}).mapIso θ).app
        (Opposite.op (Over.mk b))) x
    constructor
    · intro x x' hxx
      have hxx' : m • x = m • x' := hxx
      have h3 : m • e x = m • e x' := by
        rw [← map_nsmul, ← map_nsmul, hxx']
      have h4 : e x = e x' := (s1 T).1 h3
      rw [← h1 x, ← h1 x', h4]
    · intro y
      obtain ⟨z, hz⟩ := (s1 T).2 (e y)
      have hz' : m • z = e y := hz
      refine ⟨e' z, ?_⟩
      show m • e' z = y
      rw [← map_nsmul, hz', h1]

  haveI hinj : Sheaf.IsLocallyInjective (m • 𝟙 G) := by
    constructor
    intro U x y hxy
    have hxy' : m • x = m • y := hxy
    refine hloc U.unop (x - y) _ ?_ ?_
    · intro T g _ hW
      obtain ⟨b⟩ := hW
      rw [Presheaf.equalizerSieve_apply]
      apply (s2 T b).1
      show m • (G.obj.map g.op).hom x = m • (G.obj.map g.op).hom y
      rw [← map_nsmul, ← map_nsmul, hxy']
    · intro T g hg
      rw [Presheaf.equalizerSieve_apply]
      rw [map_sub, sub_eq_zero] at hg
      exact hg
  haveI hsurj : Sheaf.IsLocallySurjective (m • 𝟙 G) := by
    constructor
    intro U s
    refine hloc U s _ ?_ ?_
    · intro T g _ hW
      obtain ⟨b⟩ := hW
      obtain ⟨t, ht⟩ := (s2 T b).2 ((G.obj.map g.op).hom s)
      exact ⟨t, ht⟩
    · intro T g hg
      exact ⟨0, by rw [map_zero]; exact hg.symm⟩
  exact (Sheaf.isLocallyBijective_iff_isIso (m • 𝟙 G)).mp ⟨hinj, hsurj⟩

theorem wcvs_lat_colimit : ∀ (Y : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G N : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (ι : N ⟶ G) [Mono ι]
    (W' : Y.ProEt) (r : ℕ) (θ : G.over W' ≅ (wcContSheaf Y (Fin r → ℚ_[ℓ])).over W')
    (P : (Fin r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ])),
    (∀ (V : Y.ProEt) (a b : V ⟶ W') (x : G.obj.obj (Opposite.op V)) (z : V.left),
      (∀ i, ‖P ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
      ∀ i, ‖P ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1) →
    (∀ (V : Y.ProEt) (s : G.obj.obj (Opposite.op V)),
      (∃ t, (ι.hom.app (Opposite.op V)).hom t = s) ↔
        ∀ (V' : Y.ProEt) (c : V' ⟶ V) (b : V' ⟶ W') (z : V'.left) (i : Fin r),
          ‖P ((show C(↥V'.left, Fin r → ℚ_[ℓ]) from
            ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((G.obj.map c.op).hom s)).down) z) i‖ ≤ 1) →
    (∀ n : ℕ, IsIso ((ℓ ^ n : ℕ) • 𝟙 G)) →
    (∀ (U : Y.ProEt) (s : G.obj.obj (Opposite.op U)) (S : Sieve U),
      (∀ (T : Y.ProEt) (g : T ⟶ U), IsAffine T.left → Nonempty (T ⟶ W') → S.arrows g) →
      (∀ (T : Y.ProEt) (g : T ⟶ U), (G.obj.map g.op).hom s = 0 → S.arrows g) →
      S ∈ Scheme.ProEt.topology Y U) →
    ∃ κ : Functor.ofSequence (X := fun _ : ℕ => N) (fun _ => (ℓ : ℕ) • 𝟙 N) ⟶
        (Functor.const ℕ).obj G,
      Nonempty (Limits.IsColimit (Limits.Cocone.mk G κ)) :=
by
  intro Y ℓ _ G N ι _ W' r θ P hint hJ hiso hloc
  classical
  haveI hex : HasExactColimitsOfShape ℕ (Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _ (Scheme.ProEt.topology Y) _ _ _
      (@HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
        (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _))

  have hns : ∀ (F : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (m : ℕ)
      (U : (Y.ProEt)ᵒᵖ) (x : (F.obj.obj U : Type (u+1))),
      ((m • 𝟙 F).hom.app U).hom x = m • x := by
    intro F m U x
    induction m with
    | zero => rw [zero_nsmul, zero_nsmul]; rfl
    | succ m ih =>
      rw [succ_nsmul, Sheaf.Hom.add_app, AddCommGrpCat.hom_add_apply, ih, succ_nsmul]
      rfl

  have L1 : ∀ (T : Y.ProEt), IsAffine T.left → Nonempty (T ⟶ W') →
      ∀ (y : G.obj.obj (Opposite.op T)), ∃ (n : ℕ) (t : N.obj.obj (Opposite.op T)),
        (ι.hom.app (Opposite.op T)).hom t = (ℓ ^ n : ℕ) • y := by
    intro T hT hTW y
    obtain ⟨b⟩ := hTW
    haveI : IsAffine T.left := hT
    let f : C(↥T.left, Fin r → ℚ_[ℓ]) :=
      (show C(↥T.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom y).down)
    have hPc : Continuous (fun v : Fin r → ℚ_[ℓ] => P v) :=
      LinearMap.continuous_of_finiteDimensional P.toLinearMap
    obtain ⟨C, hC⟩ :=
      isCompact_univ.exists_bound_of_continuousOn (hPc.comp f.continuous).continuousOn
    have hℓ1 : (1 : ℝ) < (ℓ : ℝ) := Nat.one_lt_cast.mpr (Fact.out : Nat.Prime ℓ).one_lt
    obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt C hℓ1
    have hpos : (0 : ℝ) < (ℓ : ℝ) ^ n := pow_pos (by linarith) n
    refine ⟨n, (hJ T ((ℓ ^ n : ℕ) • y)).mpr ?_⟩
    intro V' c b' z i
    refine hint V' (c ≫ b) b' ((G.obj.map c.op).hom ((ℓ ^ n : ℕ) • y)) z (fun i' => ?_) i
    have hnat : (θ.hom.hom.app (Opposite.op (Over.mk (c ≫ b)))).hom
          ((G.obj.map c.op).hom ((ℓ ^ n : ℕ) • y)) =
        (((wcContSheaf Y (Fin r → ℚ_[ℓ])).over W').obj.map
          (Over.homMk c : Over.mk (c ≫ b) ⟶ Over.mk b).op).hom
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((ℓ ^ n : ℕ) • y)) :=
      congrArg (fun φ => φ.hom ((ℓ ^ n : ℕ) • y))
        (θ.hom.hom.naturality (Over.homMk c : Over.mk (c ≫ b) ⟶ Over.mk b).op)
    have e : (show C(↥V'.left, Fin r → ℚ_[ℓ]) from
        ((θ.hom.hom.app (Opposite.op (Over.mk (c ≫ b)))).hom
          ((G.obj.map c.op).hom ((ℓ ^ n : ℕ) • y))).down) z =
        (ℓ ^ n : ℕ) • f (c.left z) := by
      have hadd : (θ.hom.hom.app (Opposite.op (Over.mk b))).hom ((ℓ ^ n : ℕ) • y) =
          (ℓ ^ n : ℕ) • (θ.hom.hom.app (Opposite.op (Over.mk b))).hom y :=
        map_nsmul (θ.hom.hom.app (Opposite.op (Over.mk b))).hom _ _
      have hadd2 := map_nsmul (((wcContSheaf Y (Fin r → ℚ_[ℓ])).over W').obj.map
          (Over.homMk c : Over.mk (c ≫ b) ⟶ Over.mk b).op).hom (ℓ ^ n : ℕ)
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom y)
      rw [hnat, hadd, hadd2]
      rfl
    rw [e, map_nsmul, Pi.smul_apply, nsmul_eq_mul, Nat.cast_pow, norm_mul, Padic.norm_p_pow,
      zpow_neg, zpow_natCast, inv_mul_le_iff₀ hpos, mul_one]
    have h1 : ‖P (f (c.left z))‖ ≤ C := hC (c.left z) (Set.mem_univ _)
    have h2 := norm_le_pi_norm (P (f (c.left z))) i'
    linarith

  obtain ⟨e, he1, he2⟩ : ∃ e : ℕ → (G ⟶ G), (∀ n, ((ℓ ^ n : ℕ) • 𝟙 G) ≫ e n = 𝟙 G) ∧
      ∀ n, e n ≫ ((ℓ ^ n : ℕ) • 𝟙 G) = 𝟙 G :=
    ⟨fun n => (hiso n).out.choose, fun n => (hiso n).out.choose_spec.1,
      fun n => (hiso n).out.choose_spec.2⟩
  have hey : ∀ (n : ℕ) (T : (Y.ProEt)ᵒᵖ) (y : (G.obj.obj T : Type (u+1))),
      ((e n).hom.app T).hom ((ℓ ^ n : ℕ) • y) = y := by
    intro n T y
    have h := congrArg (fun φ : G ⟶ G => (φ.hom.app T).hom y) (he1 n)
    have h' : ((e n).hom.app T).hom ((((ℓ ^ n : ℕ) • 𝟙 G).hom.app T).hom y) = y := h
    rwa [hns] at h'
  have hμ : ∀ n : ℕ, ((ℓ ^ n : ℕ) • 𝟙 G) ≫ ((ℓ : ℕ) • 𝟙 G) = ((ℓ ^ (n + 1) : ℕ) • 𝟙 G) := by
    intro n
    rw [Preadditive.nsmul_comp, Category.id_comp, smul_smul, pow_succ]
  have hstep : ∀ n : ℕ, ((ℓ : ℕ) • 𝟙 G) ≫ e (n + 1) = e n := by
    intro n
    calc ((ℓ : ℕ) • 𝟙 G) ≫ e (n + 1)
        = (e n ≫ ((ℓ ^ n : ℕ) • 𝟙 G)) ≫ ((ℓ : ℕ) • 𝟙 G) ≫ e (n + 1) := by
          rw [he2, Category.id_comp]
      _ = e n ≫ (((ℓ ^ n : ℕ) • 𝟙 G) ≫ ((ℓ : ℕ) • 𝟙 G)) ≫ e (n + 1) := by
          simp only [Category.assoc]
      _ = e n := by rw [hμ, he1, Category.comp_id]
  have h1N : ((ℓ : ℕ) • 𝟙 N) ≫ ι = ι ≫ ((ℓ : ℕ) • 𝟙 G) := by
    rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
  obtain ⟨κ, hκ⟩ : ∃ κ : Functor.ofSequence (X := fun _ : ℕ => N) (fun _ => (ℓ : ℕ) • 𝟙 N) ⟶
      (Functor.const ℕ).obj G, ∀ n, κ.app n = ι ≫ e n := by
    refine ⟨NatTrans.ofSequence (fun n => ι ≫ e n) (fun n => ?_),
      fun n => NatTrans.ofSequence_app _ _ n⟩
    have key : ((ℓ : ℕ) • 𝟙 N) ≫ ι ≫ e (n + 1) = ι ≫ e n := by
      rw [← Category.assoc, h1N, Category.assoc, hstep]
    rw [Functor.ofSequence_map_homOfLE_succ, Functor.const_obj_map]
    exact key.trans (Category.comp_id _).symm
  refine ⟨κ, ?_⟩

  have crit : ∀ (T : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
      (D : ℕ ⥤ Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
      (κ : D ⟶ (Functor.const ℕ).obj T), (∀ n, Mono (κ.app n)) →
      Epi (Limits.colimit.desc D (Limits.Cocone.mk T κ)) →
      Nonempty (Limits.IsColimit (Limits.Cocone.mk T κ)) := by
    intro T D κ hmono hepi
    haveI : Mono κ := NatTrans.mono_of_mono_app κ
    haveI : Mono (Limits.colimMap κ) := Functor.map_mono Limits.colim κ
    let e : Limits.colimit ((Functor.const ℕ).obj T) ≅ T :=
      (Limits.colimit.isColimit ((Functor.const ℕ).obj T)).coconePointUniqueUpToIso
        (Limits.isColimitConstCocone ℕ T)
    have he : ∀ n, Limits.colimit.ι ((Functor.const ℕ).obj T) n ≫ e.hom = 𝟙 T := fun n =>
      (Limits.colimit.isColimit ((Functor.const ℕ).obj T)).comp_coconePointUniqueUpToIso_hom
        (Limits.isColimitConstCocone ℕ T) n
    have hD : Limits.colimit.desc D (Limits.Cocone.mk T κ) = Limits.colimMap κ ≫ e.hom := by
      apply Limits.colimit.hom_ext
      intro n
      rw [Limits.colimit.ι_desc, Limits.ι_colimMap_assoc, he]
      exact (Category.comp_id (κ.app n)).symm
    haveI : Mono (Limits.colimMap κ ≫ e.hom) := mono_comp _ _
    haveI : Mono (Limits.colimit.desc D (Limits.Cocone.mk T κ)) := by
      rw [hD]; infer_instance
    haveI : IsIso (Limits.colimit.desc D (Limits.Cocone.mk T κ)) := isIso_of_mono_of_epi _
    haveI : IsIso ((Limits.colimit.isColimit D).desc (Limits.Cocone.mk T κ)) := by
      rw [Limits.colimit.isColimit_desc]; infer_instance
    exact ⟨Limits.IsColimit.ofPointIso (Limits.colimit.isColimit D)⟩

  have hmono : ∀ n, Mono (κ.app n) := by
    intro n
    haveI : IsIso (e n) := ⟨⟨_, he2 n, he1 n⟩⟩
    have hm : Mono (ι ≫ e n) := mono_comp _ _
    rw [hκ n]
    exact hm

  have hepi : Epi (Limits.colimit.desc
      (Functor.ofSequence (X := fun _ : ℕ => N) (fun _ => (ℓ : ℕ) • 𝟙 N))
      (Limits.Cocone.mk G κ)) := by
    have hls : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Y)
        (Limits.colimit.desc
          (Functor.ofSequence (X := fun _ : ℕ => N) (fun _ => (ℓ : ℕ) • 𝟙 N))
          (Limits.Cocone.mk G κ)).hom := by
      refine ⟨fun {U} s => ?_⟩
      refine hloc U s _ (fun T g hT hTW => ?_) (fun T g hg => ?_)
      · obtain ⟨n, t, ht⟩ := L1 T hT hTW ((G.obj.map g.op).hom s)
        refine ⟨(Limits.colimit.ι
          (Functor.ofSequence (X := fun _ : ℕ => N) (fun _ => (ℓ : ℕ) • 𝟙 N)) n).hom.app
            (Opposite.op T) t, ?_⟩
        change (Limits.colimit.ι
          (Functor.ofSequence (X := fun _ : ℕ => N) (fun _ => (ℓ : ℕ) • 𝟙 N)) n ≫
            Limits.colimit.desc
              (Functor.ofSequence (X := fun _ : ℕ => N) (fun _ => (ℓ : ℕ) • 𝟙 N))
              (Limits.Cocone.mk G κ)).hom.app (Opposite.op T) t = _
        rw [Limits.colimit.ι_desc]
        change (κ.app n).hom.app (Opposite.op T) t = _
        rw [hκ n]
        change ((e n).hom.app (Opposite.op T)).hom ((ι.hom.app (Opposite.op T)).hom t) =
          (G.obj.map g.op).hom s
        rw [ht, hey]
      · exact ⟨0, by rw [map_zero]; exact hg.symm⟩
    exact (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp hls

  exact crit G _ κ hmono hepi

theorem wcvs_geom_lattice (Y : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y]
    (Ub : Y.Opens) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (W' : Y.ProEt)
    (hqc : QuasiCompact W'.hom) (hirr : IrreducibleSpace W'.left)
    (hin : ∀ z : W'.left, W'.hom z ∈ Ub) (hcov : ∀ p : Y, p ∈ Ub → ∃ z : W'.left, W'.hom z = p)
    (r : ℕ) (θ : G.over W' ≅ (wcContSheaf Y (Fin r → ℚ_[ℓ])).over W')
    (hG : wcvsSuppY Y Ub G) :
    ∃ (N : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
      (κ : Functor.ofSequence (X := fun _ : ℕ => N) (fun _ => (ℓ : ℕ) • 𝟙 N) ⟶
        (Functor.const ℕ).obj G),
      Nonempty (Limits.IsColimit (Limits.Cocone.mk G κ)) ∧ Mono ((ℓ : ℕ) • 𝟙 N) ∧
      wcvsSuppY Y Ub N ∧ Nonempty (N.over W' ≅ (wcContSheaf Y (Fin r → ℤ_[ℓ])).over W') :=
by
  classical

  have hW := wcvs_lat_affine_W_cover Y Ub W' hqc hcov

  have hloc : ∀ (U : Y.ProEt) (s : G.obj.obj (Opposite.op U)) (S : Sieve U),
      (∀ (T : Y.ProEt) (g : T ⟶ U), IsAffine T.left → Nonempty (T ⟶ W') → S.arrows g) →
      (∀ (T : Y.ProEt) (g : T ⟶ U), (G.obj.map g.op).hom s = 0 → S.arrows g) →
      S ∈ Scheme.ProEt.topology Y U := by
    intro U s S h1 h2
    obtain ⟨R, hR, hRg⟩ := hG U s
    refine (Scheme.ProEt.topology Y).transitive hR S (fun V'' g hg => ?_)
    rcases hRg V'' g hg with hA | hB
    · refine (Scheme.ProEt.topology Y).superset_covering ?_ (hW V'' hA)
      intro T k hk
      obtain ⟨Z, h, f, ⟨hZa, ⟨hZW⟩⟩, rfl⟩ := hk
      show S.arrows ((h ≫ f) ≫ g)
      rw [Category.assoc]
      exact S.downward_closed (h1 Z (f ≫ g) hZa ⟨hZW⟩) h
    · have htop : Sieve.pullback g S = ⊤ := by
        ext T k
        simp only [Sieve.pullback_apply, Sieve.top_apply, iff_true]
        apply h2
        simp only [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply,
          hB, map_zero]
      rw [htop]
      exact (Scheme.ProEt.topology Y).top_mem V''

  obtain ⟨P, hint⟩ : ∃ P : (Fin r → ℚ_[ℓ]) ≃ₗ[ℚ_[ℓ]] (Fin r → ℚ_[ℓ]),
      ∀ (V : Y.ProEt) (a b : V ⟶ W') (x : G.obj.obj (Opposite.op V)) (z : V.left),
        (∀ i, ‖P ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk a))).hom x).down) z) i‖ ≤ 1) →
        ∀ i, ‖P ((show C(↥V.left, Fin r → ℚ_[ℓ]) from
          ((θ.hom.hom.app (Opposite.op (Over.mk b))).hom x).down) z) i‖ ≤ 1 := by
    obtain ⟨τ, hcont, htr⟩ := wc_qtl_transition_matrix_field Y G W' r ℓ θ
    haveI hWqc : QuasiCompact W'.hom := hqc
    haveI hWc : CompactSpace ↥W'.left :=
      @QuasiCompact.compactSpace_of_compactSpace _ _ W'.hom hWqc (‹CompactSpace Y› :)
    haveI : CompactSpace ↥(Limits.pullback W'.hom W'.hom) :=
      @QuasiCompact.compactSpace_of_compactSpace _ _ (Limits.pullback.fst W'.hom W'.hom)
        inferInstance hWc
    have hbd : ∃ C : ℝ, ∀ h ∈ Set.range τ, ∀ j : Fin r, ‖h (Pi.single j 1)‖ ≤ C := by
      have hf : Continuous (fun p => fun j : Fin r => τ p (Pi.single j 1)) :=
        continuous_pi (fun j => hcont _)
      obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn hf.continuousOn
      refine ⟨C, ?_⟩
      rintro _ ⟨p, rfl⟩ j
      exact (norm_le_pi_norm (fun j : Fin r => τ p (Pi.single j 1)) j).trans
        (hC p (Set.mem_univ p))
    haveI hWet : WeaklyEtale W'.hom := W'.prop
    have hgen : ∀ p : ↥(Limits.pullback W'.hom W'.hom), ∃ p' : ↥(Limits.pullback W'.hom W'.hom),
        τ p' = τ p ∧ (Limits.pullback.fst W'.hom W'.hom) p' = genericPoint ↥W'.left ∧
          (Limits.pullback.snd W'.hom W'.hom) p' = genericPoint ↥W'.left := by
      intro p
      obtain ⟨p', hsp, h1, h2⟩ := @wc_qtl_generic_pair_generization _ _ W'.hom hWet hirr p
      refine ⟨p', ?_, h1, h2⟩
      apply LinearMap.ext
      intro v
      exact (hsp.map (hcont v)).eq
    have hmul : ∀ h₁ ∈ Set.range τ, ∀ h₂ ∈ Set.range τ, h₂ ∘ₗ h₁ ∈ Set.range τ := by
      rintro _ ⟨p, rfl⟩ _ ⟨q, rfl⟩
      obtain ⟨p', hp', -, hp2⟩ := hgen p
      obtain ⟨q', hq', hq1, -⟩ := hgen q
      obtain ⟨r', hr⟩ := wc_qtl_transition_cocycle Y G W' r ℓ θ τ htr p' q'
        (hp2.trans hq1.symm)
      exact ⟨r', by rw [hr, hp', hq']⟩
    obtain ⟨P, hPH⟩ := wc_qtl_bounded_monoid_lattice ℓ r (Set.range τ) hbd hmul
    refine ⟨P, fun V a b x z ha => ?_⟩
    rw [htr V a b x z]
    exact hPH _ ⟨_, rfl⟩ _ ha

  obtain ⟨J, hJ⟩ := wc_qclift_integral_subsheaf Y G W' r ℓ θ P
  obtain ⟨ψ, -⟩ := wc_qclift_integral_frame Y ℓ G W' r θ P hint J hJ

  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have hiso : ∀ n : ℕ, IsIso ((ℓ ^ n : ℕ) • 𝟙 G) := fun n =>
    wcvs_lat_nsmul_iso Y ℓ G W' r θ hloc (ℓ ^ n) (pow_ne_zero n hℓ0)

  obtain ⟨κ, hκ⟩ := wcvs_lat_colimit Y ℓ G (Subobject.underlying.obj J) J.arrow W' r θ P hint hJ
    hiso hloc

  have hinj : ∀ V : Y.ProEt, Function.Injective (J.arrow.hom.app (Opposite.op V)).hom := by
    intro V
    have h1 : Mono ((sheafToPresheaf _ _).map J.arrow) := inferInstance
    have h2 : Mono (J.arrow.hom.app (Opposite.op V)) :=
      (NatTrans.mono_iff_mono_app _).mp h1 (Opposite.op V)
    exact (AddCommGrpCat.mono_iff_injective _).mp h2
  refine ⟨Subobject.underlying.obj J, κ, hκ, ?_, ?_, ⟨ψ⟩⟩
  · have heq : ((ℓ : ℕ) • 𝟙 (Subobject.underlying.obj J)) ≫ J.arrow =
        J.arrow ≫ ((ℓ : ℕ) • 𝟙 G) := by
      rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
    have h1 := hiso 1
    rw [pow_one] at h1
    haveI : Mono (((ℓ : ℕ) • 𝟙 (Subobject.underlying.obj J)) ≫ J.arrow) := by
      rw [heq]; infer_instance
    exact mono_of_mono _ J.arrow
  · intro V t
    obtain ⟨R, hR, hRg⟩ := hG V ((J.arrow.hom.app (Opposite.op V)).hom t)
    refine ⟨R, hR, fun V'' g hg => ?_⟩
    rcases hRg V'' g hg with h | h
    · exact Or.inl h
    · right
      apply hinj V''
      have hnat := congrArg (fun f => (AddCommGrpCat.Hom.hom f) t) (J.arrow.hom.naturality g.op)
      simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at hnat
      rw [map_zero, hnat]
      exact h

theorem wcvs_geom_int_tower (Y : Scheme.{u}) [CompactSpace Y] [QuasiSeparatedSpace Y]
    (Ub : Y.Opens) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (N : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (W' : Y.ProEt)
    (hqc : QuasiCompact W'.hom)
    (hin : ∀ z : W'.left, W'.hom z ∈ Ub) (hcov : ∀ p : Y, p ∈ Ub → ∃ z : W'.left, W'.hom z = p)
    (r : ℕ) (ψ : N.over W' ≅ (wcContSheaf Y (Fin r → ℤ_[ℓ])).over W')
    (hN : wcvsSuppY Y Ub N) (hmono : Mono ((ℓ : ℕ) • 𝟙 N)) :
    ∃ (Yt : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
      (pr : ∀ n : ℕ, Yt ⟶ Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 N))
      (c : ∀ n : ℕ, Limits.cokernel ((ℓ ^ (n + 1) : ℕ) • 𝟙 N) ⟶ Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 N))
      (T : Yt ⟶ Yt) (incl : N ⟶ Yt),
      Nonempty (Limits.IsLimit (Limits.Fan.mk Yt pr)) ∧
      (∀ n, T ≫ pr n = pr n - pr (n + 1) ≫ c n) ∧ Epi T ∧
      (∃ h : incl ≫ T = 0, Mono (Limits.kernel.lift T incl h) ∧
        ∀ (V : Y.ProEt), (∀ v : V.left, V.hom v ∈ Ub) →
          ∀ s : (Limits.cokernel (Limits.kernel.lift T incl h)).obj.obj (Opposite.op V), s = 0) ∧
      (∀ n, (ℓ ^ n : ℕ) • 𝟙 (Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 N)) = 0) ∧
      (∀ n, Nonempty ((Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 N)).over W' ≅
        (wcContSheaf Y (Fin r → ZMod (ℓ ^ n))).over W')) ∧
      (∀ n, wcvsSuppY Y Ub (Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 N))) :=
by
  classical

  let B : ℕ → Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} :=
    fun n => Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 N)
  let π : ∀ n, N ⟶ B n := fun n => Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 N)
  have hπ : ∀ n, ((ℓ ^ n : ℕ) • π n) = 0 := by
    intro n
    have h := Limits.cokernel.condition ((ℓ ^ n : ℕ) • 𝟙 N)
    rwa [Preadditive.nsmul_comp, Category.id_comp] at h
  have hc0 : ∀ n, ((ℓ ^ (n + 1) : ℕ) • 𝟙 N) ≫ π n = 0 := by
    intro n
    rw [Preadditive.nsmul_comp, Category.id_comp, pow_succ', mul_smul, hπ n, smul_zero]
  let c : ∀ n, B (n + 1) ⟶ B n := fun n => Limits.cokernel.desc _ (π n) (hc0 n)
  have hc : ∀ n, π (n + 1) ≫ c n = π n := fun n => Limits.cokernel.π_desc _ _ _
  have hcepi : ∀ n, Epi (c n) := by
    intro n
    haveI : Epi (π (n + 1) ≫ c n) := by rw [hc n]; infer_instance
    exact epi_of_epi (π (n + 1)) (c n)
  let Yt := ∏ᶜ B
  let pr : ∀ n, Yt ⟶ B n := fun n => Limits.Pi.π B n
  have hY : Limits.IsLimit (Limits.Fan.mk Yt pr) := Limits.productIsProduct B
  let T : Yt ⟶ Yt := Limits.Pi.lift (fun n => pr n - pr (n + 1) ≫ c n)
  have hT : ∀ n, T ≫ pr n = pr n - pr (n + 1) ≫ c n := fun n => by simp [T, pr]
  let ι : N ⟶ Yt := Limits.Pi.lift π
  have hιpr : ∀ n, ι ≫ pr n = π n := fun n => by simp [ι, pr]
  have hι : ι ≫ T = 0 := by
    apply Limits.Pi.hom_ext
    intro n
    rw [Category.assoc, Limits.zero_comp]
    change ι ≫ T ≫ pr n = 0
    rw [hT n, Preadditive.comp_sub, hιpr, ← Category.assoc, hιpr, hc, sub_self]

  let c' : ∀ k m, m ≤ k → (B k ⟶ B m) := fun k m h => (Functor.ofOpSequence c).map (homOfLE h).op
  have hcomp : ∀ k j m (h1 : m ≤ j) (h2 : j ≤ k), c' k j h2 ≫ c' j m h1 = c' k m (h1.trans h2) := by
    intro k j m h1 h2
    exact ((Functor.ofOpSequence c).map_comp (homOfLE h2).op (homOfLE h1).op).symm
  have hsucc : ∀ m, c' (m + 1) m (Nat.le_succ m) = c m := fun m =>
    Functor.ofOpSequence_map_homOfLE_succ c m
  have hepi : ∀ d m, Epi (c' (m + d) m (Nat.le_add_right m d)) := by
    intro d
    induction d with
    | zero =>
      intro m
      have : c' (m + 0) m (Nat.le_add_right m 0) = 𝟙 _ :=
        (Functor.ofOpSequence c).map_id (Opposite.op m)
      rw [this]
      infer_instance
    | succ d ih =>
      intro m
      have e1 := hcomp (m + (d + 1)) (m + d) m (Nat.le_add_right m d) (by omega)
      have e2 : c' (m + (d + 1)) (m + d) (by omega) = c (m + d) := hsucc (m + d)
      rw [← e1, e2]
      haveI := ih m
      haveI := hcepi (m + d)
      infer_instance
  have hepi' : ∀ k m (h : m ≤ k), Epi (c' k m h) := by
    intro k m h
    obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le h
    exact hepi d m
  have htop : ∀ {X Y' : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}}
      (f : X ⟶ Y'), Epi f → Limits.imageSubobject f = ⊤ := by
    intro X Y' f hf
    haveI : Epi (Limits.imageSubobject f).arrow := by
      have := Limits.imageSubobject_arrow_comp f
      exact epi_of_epi_fac this
    haveI : IsIso (Limits.imageSubobject f).arrow := isIso_of_mono_of_epi _
    exact Subobject.eq_top_of_isIso_arrow _
  have hML : ∀ m, ∃ m', ∃ hm : m ≤ m', ∀ k (hk : m' ≤ k),
      Limits.imageSubobject (c' k m (hm.trans hk)) = Limits.imageSubobject (c' m' m hm) :=
    fun m => ⟨m, le_refl m, fun k hk => by rw [htop _ (hepi' _ _ _), htop _ (hepi' _ _ _)]⟩
  have hTepi : Epi T := wc_proet_ML_tower_shift_epi Y Yt B pr hY c' hcomp hML T
    (fun m => by rw [hsucc]; exact hT m)
  set qq := Limits.kernel.lift T ι hι with hqdef

  have nat : ∀ {G H : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}} (f : G ⟶ H)
      {V V'' : Y.ProEt} (g : V'' ⟶ V) (x : G.obj.obj (Opposite.op V)),
      (f.hom.app (Opposite.op V'')).hom ((G.obj.map g.op).hom x) =
        (H.obj.map g.op).hom ((f.hom.app (Opposite.op V)).hom x) := by
    intro G H f V V'' g x
    have h := congrArg (fun φ => AddCommGrpCat.Hom.hom φ x) (f.hom.naturality g.op)
    exact h

  have hdesc : ∀ (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}),
      Limits.IsZero (G.over W') → ∀ (V : Y.ProEt), (∀ v : V.left, V.hom v ∈ Ub) →
      ∀ s : G.obj.obj (Opposite.op V), s = 0 := by
    intro G hG V hV s
    have hzero : ∀ (V' : Y.ProEt) (b : V' ⟶ W') (y : G.obj.obj (Opposite.op V')), y = 0 := by
      intro V' b y
      have h1 := Functor.map_isZero
        (sheafToPresheaf ((Scheme.ProEt.topology Y).over W') AddCommGrpCat.{u+1} ⋙
          (evaluation (Over W')ᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op (Over.mk b))) hG
      have h2 : Limits.IsZero (G.obj.obj (Opposite.op V')) := h1
      haveI := AddCommGrpCat.subsingleton_of_isZero h2
      exact Subsingleton.elim _ _
    haveI : QuasiCompact W'.hom := hqc
    haveI hWp : WeaklyEtale W'.hom := W'.prop
    haveI hVp : WeaklyEtale V.hom := V.prop
    haveI : WeaklyEtale (Limits.pullback.fst V.hom W'.hom) := inferInstance
    haveI : QuasiCompact (Limits.pullback.fst V.hom W'.hom) := inferInstance
    haveI : WeaklyEtale (Limits.pullback.fst V.hom W'.hom ≫ V.hom) := inferInstance
    let Tc : Y.ProEt := Scheme.ProEt.mk (Limits.pullback.fst V.hom W'.hom ≫ V.hom)
    let p₁ : Tc ⟶ V := MorphismProperty.Over.homMk (Limits.pullback.fst V.hom W'.hom) rfl trivial
    let p₂ : Tc ⟶ W' := MorphismProperty.Over.homMk (Limits.pullback.snd V.hom W'.hom)
      Limits.pullback.condition.symm trivial
    have hp₁qc : QuasiCompact p₁.left :=
      (inferInstance : QuasiCompact (Limits.pullback.fst V.hom W'.hom))
    have hx : (G.obj.map p₁.op).hom s = 0 := hzero Tc p₂ _
    have hs := wc_proet_section_zero_of_qc_image Y G V Tc p₁ hp₁qc s hx V (𝟙 V) (by
      intro p
      obtain ⟨z, hz⟩ := hcov (V.hom p) (hV p)
      obtain ⟨τ, hτ, -⟩ := Scheme.Pullback.exists_preimage_pullback p z hz.symm
      exact ⟨τ, hτ⟩)
    simpa using hs

  have hsuppMono : ∀ (G H : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (f : G ⟶ H),
      Mono f → wcvsSuppY Y Ub H → wcvsSuppY Y Ub G := by
    intro G H f hf hH V s
    have hinj := (wc_proet_ses_sectionwise Y f (Limits.cokernel.π f) (Limits.cokernel.condition f)
      (ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel f) hf inferInstance)).1
    obtain ⟨R, hR, hR'⟩ := hH V ((f.hom.app (Opposite.op V)).hom s)
    refine ⟨R, hR, fun V'' g hg => ?_⟩
    rcases hR' V'' g hg with h | h
    · exact Or.inl h
    · right
      apply hinj
      rw [← h]
      exact nat f g s

  have hsuppEpi : ∀ (G H : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (f : G ⟶ H),
      Epi f → wcvsSuppY Y Ub G → wcvsSuppY Y Ub H := by
    intro G H f hf hG V t
    have hR0 : Presheaf.imageSieve f.hom t ∈ Scheme.ProEt.topology Y V :=
      (wc_proet_ses_sectionwise Y (Limits.kernel.ι f) f (Limits.kernel.condition f)
        (ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel f) inferInstance hf)).2.2.2 V t
    refine ⟨Sieve.bind (Presheaf.imageSieve f.hom t).arrows
      (fun V₁ _ hg => (hG V₁ hg.choose).choose), ?_, ?_⟩
    · apply (Scheme.ProEt.topology Y).bind_covering hR0
      intro V₁ g hg
      exact (hG V₁ hg.choose).choose_spec.1
    · rintro V'' g' ⟨V₁, k, g, hg, hk, rfl⟩
      rcases (hG V₁ hg.choose).choose_spec.2 V'' k hk with h | h
      · exact Or.inl h
      · right
        have hlam : (f.hom.app (Opposite.op V₁)).hom hg.choose = (H.obj.map g.op).hom t :=
          hg.choose_spec
        rw [op_comp, Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply, ← hlam,
          ← nat f k, h, map_zero]

  have hisZero : ∀ (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}),
      wcvsSuppY Y Ub G → (∀ (V : Y.ProEt), (∀ v : V.left, V.hom v ∈ Ub) →
        ∀ s : G.obj.obj (Opposite.op V), s = 0) → Limits.IsZero G := by
    intro G hG hU
    have hall : ∀ (V : Y.ProEt) (s : G.obj.obj (Opposite.op V)), s = 0 := by
      intro V s
      obtain ⟨R, hR, hR'⟩ := hG V s
      refine Sheaf.isSeparated G V R hR s 0 ?_
      intro V'' g hg
      change (G.obj.map g.op).hom s = (G.obj.map g.op).hom 0
      rw [map_zero]
      rcases hR' V'' g hg with h | h
      · exact hU V'' h _
      · exact h
    have hsub : ∀ V : (Y.ProEt)ᵒᵖ, Subsingleton (G.obj.obj V) :=
      fun V => ⟨fun a b => (hall V.unop a).trans (hall V.unop b).symm⟩
    rw [Limits.IsZero.iff_id_eq_zero]
    ext V x
    exact (hsub V).elim _ _

  obtain ⟨Ym, Bm, red, cst, prm, incl, shift, hred, hcst, ⟨hYm⟩, hincl, hshift, hses⟩ :=
    wc_contSheaf_intvec_tower_model Y ℓ r
  haveI : Limits.PreservesFiniteColimits
      ((Scheme.ProEt.topology Y).overPullback AddCommGrpCat.{u+1} W') := by
    have hpc : Limits.PreservesColimitsOfSize.{0, 0}
        ((Scheme.ProEt.topology Y).overPullback AddCommGrpCat.{u+1} W') :=
      (Functor.sheafAdjunctionCocontinuous (Over.forget W') AddCommGrpCat.{u+1}
        ((Scheme.ProEt.topology Y).over W')
        (Scheme.ProEt.topology Y)).leftAdjoint_preservesColimits
    exact Limits.PreservesColimitsOfSize.preservesFiniteColimits
        ((Scheme.ProEt.topology Y).overPullback AddCommGrpCat.{u+1} W')
  haveI : ((Scheme.ProEt.topology Y).overPullback AddCommGrpCat.{u+1} W').Additive :=
    Functor.additive_of_preserves_binary_products _
  obtain ⟨hK, hC⟩ := wc_tower_defect_isZero_of_exact_functor
    ((Scheme.ProEt.topology Y).overPullback AddCommGrpCat.{u+1} W') ℓ
    N Yt pr hY c hc T hT ι hιpr hι
    (wcContSheaf Y (Fin r → ℤ_[ℓ])) Ym Bm red hred cst hcst prm hYm incl hincl
    shift hshift hses ψ

  have hKU := hdesc (Limits.kernel qq) hK
  have hKsupp := hsuppMono _ _ (Limits.kernel.ι qq) inferInstance hN
  have hK0 := hisZero _ hKsupp hKU
  have hmonoq : Mono qq := Preadditive.mono_of_isZero_kernel qq hK0

  have htors : ∀ n, (ℓ ^ n : ℕ) • 𝟙 (B n) = 0 := by
    intro n
    apply (cancel_epi (π n)).mp
    rw [Preadditive.comp_nsmul, Category.comp_id, Limits.comp_zero]
    exact hπ n

  have hframe : ∀ n, Nonempty ((Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 N)).over W' ≅
      (wcContSheaf Y (Fin r → ZMod (ℓ ^ n))).over W') := by
    intro n
    obtain ⟨e, -⟩ := wc_contSheaf_pi_padic_coker_reduce Y ℓ r n
    have h1 : ((Scheme.ProEt.topology Y).overPullback AddCommGrpCat.{u+1} W').map
        ((ℓ ^ n : ℕ) • 𝟙 N) = (ℓ ^ n : ℕ) • 𝟙 (N.over W') := by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    have h2 : ((Scheme.ProEt.topology Y).overPullback AddCommGrpCat.{u+1} W').map
        ((ℓ ^ n : ℕ) • 𝟙 (wcContSheaf Y (Fin r → ℤ_[ℓ]))) =
        (ℓ ^ n : ℕ) • 𝟙 ((wcContSheaf Y (Fin r → ℤ_[ℓ])).over W') := by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    have hsq : ((ℓ ^ n : ℕ) • 𝟙 (N.over W')) ≫ ψ.hom =
        ψ.hom ≫ ((ℓ ^ n : ℕ) • 𝟙 ((wcContSheaf Y (Fin r → ℤ_[ℓ])).over W')) := by
      rw [Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp, Category.comp_id]
    exact ⟨Limits.PreservesCokernel.iso
        ((Scheme.ProEt.topology Y).overPullback AddCommGrpCat.{u+1} W') _ ≪≫
      Limits.cokernelIsoOfEq h1 ≪≫ Limits.cokernel.mapIso _ _ ψ ψ hsq ≪≫
      (Limits.cokernelIsoOfEq h2).symm ≪≫
      (Limits.PreservesCokernel.iso
        ((Scheme.ProEt.topology Y).overPullback AddCommGrpCat.{u+1} W') _).symm ≪≫
      ((Scheme.ProEt.topology Y).overPullback AddCommGrpCat.{u+1} W').mapIso e⟩
  refine ⟨Yt, pr, c, T, ι, ⟨hY⟩, hT, hTepi, ⟨hι, hmonoq, hdesc _ hC⟩, htors, hframe,
    fun n => hsuppEpi _ _ (π n) inferInstance hN⟩

theorem wcvs_milnor_ext3 (S : Scheme.{u}) (U : S.ProEt)
    (N Yt : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (B : ℕ → Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (pr : ∀ n, Yt ⟶ B n)
    (hY : Limits.IsLimit (Limits.Fan.mk Yt pr)) (c : ∀ n, B (n + 1) ⟶ B n) (T : Yt ⟶ Yt)
    (hT : ∀ n, T ≫ pr n = pr n - pr (n + 1) ≫ c n) (f : N ⟶ Yt) (hf : f ≫ T = 0)
    (hS : (ShortComplex.mk f T hf).ShortExact)
    (hfin : ∀ n, Finite (Abelian.Ext (wcFreeSheaf S U) (B n) 2))
    (h3 : ∀ n, ∀ x : Abelian.Ext (wcFreeSheaf S U) (B n) 3, x = 0) :
    ∀ x : Abelian.Ext (wcFreeSheaf S U) N 3, x = 0 :=
by
  haveI := wc_proet_products_exact S
  have hprod := fun k => wc_ext_prod_bijective (wcFreeSheaf S U) Yt B pr hY k

  have hlim1 : ∀ w : ∀ n, Abelian.Ext (wcFreeSheaf S U) (B n) 2,
      ∃ v : ∀ n, Abelian.Ext (wcFreeSheaf S U) (B n) 2, ∀ n,
        w n = v n - (v (n + 1)).comp (Abelian.Ext.mk₀ (c n)) (add_zero 2) := by
    intro w
    let F : ℕᵒᵖ ⥤ Type _ := Functor.ofOpSequence
      (X := fun n => Abelian.Ext (wcFreeSheaf S U) (B n) 2)
      (fun n => TypeCat.ofHom (fun a => w n + a.comp (Abelian.Ext.mk₀ (c n)) (add_zero 2)))
    haveI : ∀ j : ℕᵒᵖ, Finite (F.obj j) := fun j => hfin j.unop
    haveI : ∀ j : ℕᵒᵖ, Nonempty (F.obj j) := fun j =>
      ⟨(0 : Abelian.Ext (wcFreeSheaf S U) (B j.unop) 2)⟩
    obtain ⟨s, hs⟩ := nonempty_sections_of_finite_inverse_system F
    refine ⟨fun n => s (Opposite.op n), fun n => ?_⟩
    have h1 := hs (homOfLE (Nat.le_succ n)).op
    rw [Functor.ofOpSequence_map_homOfLE_succ] at h1
    exact eq_sub_of_add_eq h1

  have s4 : ∀ y : Abelian.Ext (wcFreeSheaf S U) Yt 2, ∃ x : Abelian.Ext (wcFreeSheaf S U) Yt 2,
      x.comp (Abelian.Ext.mk₀ T) (add_zero 2) = y := by
    intro y
    obtain ⟨v, hv⟩ := hlim1 (fun n => y.comp (Abelian.Ext.mk₀ (pr n)) (add_zero 2))
    obtain ⟨x, hx⟩ := (hprod 2).2 v
    refine ⟨x, ?_⟩
    rw [← sub_eq_zero]
    apply (hprod 2).1
    intro n
    have key : ∀ (a b : Abelian.Ext (wcFreeSheaf S U) Yt 2) (g : Yt ⟶ B n),
        (a - b).comp (Abelian.Ext.mk₀ g) (add_zero 2) =
          a.comp (Abelian.Ext.mk₀ g) (add_zero 2) - b.comp (Abelian.Ext.mk₀ g) (add_zero 2) := by
      intro a b g
      rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, ← sub_eq_add_neg]
    have h1 : (x.comp (Abelian.Ext.mk₀ T) (add_zero 2)).comp (Abelian.Ext.mk₀ (pr n)) (add_zero 2) =
        x.comp (Abelian.Ext.mk₀ (pr n)) (add_zero 2) -
          (x.comp (Abelian.Ext.mk₀ (pr (n + 1))) (add_zero 2)).comp (Abelian.Ext.mk₀ (c n))
            (add_zero 2) := by
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀, hT n,
        Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀,
        sub_eq_add_neg, Abelian.Ext.mk₀_add, Abelian.Ext.mk₀_neg, Abelian.Ext.comp_add,
        Abelian.Ext.comp_neg, ← sub_eq_add_neg]
    rw [key, h1, hx, hx]
    exact sub_eq_zero.mpr (hv n).symm
  intro z
  have h0 : z.comp (Abelian.Ext.mk₀ f) (add_zero 3) = 0 :=
    (hprod 3).1 _ (fun n => h3 n _)
  obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ (wcFreeSheaf S U) hS z h0
    (n₀ := 2) rfl
  rw [← hx₃]
  obtain ⟨w, hw⟩ := s4 x₃
  rw [← hw, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have h2 := hS.comp_extClass
  erw [h2, Abelian.Ext.comp_zero]

theorem wcvs_geom_supp_vanish (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (Ub : (wcGeomPoint K (wcP1Over K) hP).left.Opens)
    (hUb : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left, p ∈ Ub ↔
        ∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K))
    (Q : Sheaf (Scheme.ProEt.topology (wcGeomPoint K (wcP1Over K) hP).left) AddCommGrpCat.{u+1})
    (hQ : ∀ (V : (wcGeomPoint K (wcP1Over K) hP).left.ProEt), (∀ v : V.left, V.hom v ∈ Ub) →
      ∀ s : Q.obj.obj (Opposite.op V), s = 0)
    (j : ℕ) (hj : 1 ≤ j) :
    ∀ x : Abelian.Ext (wcFreeSheaf (wcGeomPoint K (wcP1Over K) hP).left
        (Scheme.ProEt.mk (𝟙 (wcGeomPoint K (wcP1Over K) hP).left))) Q j, x = 0 :=
by
  intro x
  have hcont := wc_slice_over_sites_cont (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)
  haveI hF : (wcSliceToOver (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)).IsContinuous
      (Scheme.ProEt.topology (wcGeomPoint K (wcP1Over K) hP).left)
      ((Scheme.ProEt.topology (wcP1Over K).left).over (wcGeomPoint K (wcP1Over K) hP)) := hcont.1
  haveI hG : (wcOverToSlice (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)).IsContinuous
      ((Scheme.ProEt.topology (wcP1Over K).left).over (wcGeomPoint K (wcP1Over K) hP))
      (Scheme.ProEt.topology (wcGeomPoint K (wcP1Over K) hP).left) := hcont.2.1
  let Ψ := (wcOverToSlice (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)).sheafPushforwardContinuous
    AddCommGrpCat.{u+1} ((Scheme.ProEt.topology (wcP1Over K).left).over (wcGeomPoint K (wcP1Over K) hP))
    (Scheme.ProEt.topology (wcGeomPoint K (wcP1Over K) hP).left)
  let Φ := (wcSliceToOver (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)).sheafPushforwardContinuous
    AddCommGrpCat.{u+1} (Scheme.ProEt.topology (wcGeomPoint K (wcP1Over K) hP).left)
    ((Scheme.ProEt.topology (wcP1Over K).left).over (wcGeomPoint K (wcP1Over K) hP))
  have hK : ∀ (V' : Over (wcGeomPoint K (wcP1Over K) hP)), (∀ v : V'.left.left, V'.hom.left v ∈ Ub) →
      ∀ s : (Ψ.obj Q).obj.obj (Opposite.op V'), s = 0 :=
    fun V' hV' s => hQ ((wcOverToSlice (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP)).obj V') hV' s
  have h0 := wc_qcfin_slice_supp_vanish K hP m S hS Ub hUb (Ψ.obj Q) hK j hj
  letI : HasExt (Sheaf ((Scheme.ProEt.topology (wcP1Over K).left).over
    (wcGeomPoint K (wcP1Over K) hP)) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨T⟩ := wc_slice_geom_ext_transfer (wcP1Over K).left (wcGeomPoint K (wcP1Over K) hP) (Ψ.obj Q) j
  have key : ∀ y : Abelian.Ext (wcFreeSheaf (wcGeomPoint K (wcP1Over K) hP).left
      (Scheme.ProEt.mk (𝟙 (wcGeomPoint K (wcP1Over K) hP).left))) (Φ.obj (Ψ.obj Q)) j, y = 0 :=
    fun y => T.symm.injective ((h0 _).trans (h0 _).symm)
  exact key x

theorem wcvsgf_frame_fet_descent (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (m : ℕ) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (Ub : (wcGeomPoint K (wcP1Over K) hP).left.Opens)
    (hUb : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left, p ∈ Ub ↔
        ∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K))
    (W' : (wcGeomPoint K (wcP1Over K) hP).left.ProEt) (hqc : QuasiCompact W'.hom)
    (hconn : ConnectedSpace W'.left)
    (hin : ∀ z : W'.left, W'.hom z ∈ Ub)
    (hcov : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left, p ∈ Ub → ∃ z : W'.left, W'.hom z = p)
    (L : Sheaf (Scheme.ProEt.topology (wcGeomPoint K (wcP1Over K) hP).left) AddCommGrpCat.{u+1})
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n k : ℕ)
    (θL : L.over W' ≅ (wcContSheaf (wcGeomPoint K (wcP1Over K) hP).left (Fin k → ZMod (ℓ ^ n))).over W') :
    ∃ (E : (wcGeomPoint K (wcP1Over K) hP).left.Etale) (πE : E.left ⟶ Ub.toScheme),
      πE ≫ Ub.ι = E.hom ∧ IsFinite πE ∧ Etale πE ∧ Surjective πE ∧ ConnectedSpace E.left ∧
      Nonempty (L.over ((wcEtToProEt (wcGeomPoint K (wcP1Over K) hP).left).obj E) ≅
        (wcContSheaf (wcGeomPoint K (wcP1Over K) hP).left (Fin k → ZMod (ℓ ^ n))).over
          ((wcEtToProEt (wcGeomPoint K (wcP1Over K) hP).left).obj E)) :=
by
  classical
  haveI : NeZero (ℓ ^ n) := ⟨pow_ne_zero n (Fact.out : ℓ.Prime).ne_zero⟩

  obtain ⟨hUbN, -⟩ := wc_P1bar_open_finite_noetherian_sep K hP Ub Ub.toScheme (𝟙 _) inferInstance
  haveI := hUbN

  have hrange : Set.range W'.hom ⊆ Set.range Ub.ι := by
    rw [Scheme.Opens.range_ι]; rintro _ ⟨z, rfl⟩; exact hin z
  let pV : W'.left ⟶ Ub.toScheme := IsOpenImmersion.lift Ub.ι W'.hom hrange
  have hpV : pV ≫ Ub.ι = W'.hom := IsOpenImmersion.lift_fac _ _ _
  have hpVw : WeaklyEtale pV := by
    have h1 : WeaklyEtale (pV ≫ Ub.ι) := by rw [hpV]; exact W'.prop
    exact @WeaklyEtale.of_comp _ _ _ pV Ub.ι h1 inferInstance
  have hpVq : QuasiCompact pV := by
    haveI : QuasiCompact (pV ≫ Ub.ι) := by rw [hpV]; exact hqc
    exact QuasiCompact.of_comp pV Ub.ι
  have hpVs : Surjective pV := by
    refine ⟨fun u => ?_⟩
    have hu : Ub.ι u ∈ (Ub : Set (wcGeomPoint K (wcP1Over K) hP).left) := by
      rw [← Scheme.Opens.range_ι]; exact ⟨u, rfl⟩
    obtain ⟨z, hz⟩ := hcov (Ub.ι u) hu
    refine ⟨z, ?_⟩
    apply Ub.ι.isOpenEmbedding.injective
    show Ub.ι (pV z) = Ub.ι u
    rw [← Scheme.Hom.comp_apply, hpV, hz]

  obtain ⟨c₀, hlc, hcoc, htrans⟩ := wc_qcfin_frame_base_cocycle (wcGeomPoint K (wcP1Over K) hP).left
    L (Fin k → ZMod (ℓ ^ n)) W' θL Ub.toScheme pV Ub.ι hpV hpVw

  haveI := hpVw
  obtain ⟨E₁, πE₀, s, hfin, het, -, hs, hmeet, hclift⟩ := wc_fpqc_gtor_descent Ub.toScheme W'.left pV
    inferInstance inferInstance inferInstance hpVq hpVs
    (Multiplicative (AddAut (Fin k → ZMod (ℓ ^ n)))) c₀ hlc hcoc

  obtain ⟨E0, hE0c, hfin', het', hsurj', hs1, hcovE⟩ := wc_fet_connected_piece Ub.toScheme W'.left E₁
    pV πE₀ _ s hUbN hfin het hpVs hconn hs hclift
  haveI := hfin

  let πE : E0.toScheme ⟶ Ub.toScheme := E0.ι ≫ πE₀
  have hEt : Etale (πE ≫ Ub.ι) := by
    haveI : Etale πE := het'
    infer_instance
  let E : (wcGeomPoint K (wcP1Over K) hP).left.Etale := MorphismProperty.Over.mk ⊤ (πE ≫ Ub.ι) hEt
  let ℰ : (wcGeomPoint K (wcP1Over K) hP).left.ProEt :=
    (wcEtToProEt (wcGeomPoint K (wcP1Over K) hP).left).obj E

  let Kκ := {γ : Multiplicative (AddAut (Fin k → ZMod (ℓ ^ n))) // Set.range (s γ) ⊆ (E0 : Set E₁)}
  have hsub : ∀ κ : Kκ, Set.range (s κ.1) ⊆ Set.range E0.ι := fun κ => by
    rw [Scheme.Opens.range_ι]; exact κ.2
  let s' : Kκ → (W'.left ⟶ E0.toScheme) := fun κ => IsOpenImmersion.lift E0.ι (s κ.1) (hsub κ)
  have hs' : ∀ κ, s' κ ≫ E0.ι = s κ.1 := fun κ => IsOpenImmersion.lift_fac _ _ _
  have htri : ∀ κ, (s' κ : W'.left ⟶ ℰ.left) ≫ ℰ.hom = W'.hom := by
    intro κ
    show s' κ ≫ ((E0.ι ≫ πE₀) ≫ Ub.ι) = W'.hom
    simp only [Category.assoc]
    rw [← Category.assoc (s' κ) E0.ι, hs', ← Category.assoc (s κ.1) πE₀, hs, hpV]
  let f : Kκ → (W' ⟶ ℰ) := fun κ => MorphismProperty.Over.homMk (s' κ) (htri κ) trivial
  haveI : Finite Kκ := Subtype.finite

  have hqcs : ∀ κ : Kκ, QuasiCompact (f κ).left := by
    intro κ
    have h1 : QuasiCompact (s κ.1) := by
      haveI : QuasiCompact (s κ.1 ≫ πE₀) := by rw [hs]; exact hpVq
      exact QuasiCompact.of_comp (s κ.1) πE₀
    haveI : QuasiCompact (s' κ ≫ E0.ι) := by rw [hs']; exact h1
    exact QuasiCompact.of_comp (s' κ) E0.ι

  have hjs : ∀ y : ℰ.left, ∃ κ, y ∈ Set.range (f κ).left := by
    intro y
    obtain ⟨γ, x, hγ, hx⟩ := hcovE (E0.ι y) (by rw [← Scheme.Opens.range_ι]; exact ⟨y, rfl⟩)
    refine ⟨⟨γ, hγ⟩, x, ?_⟩
    apply E0.ι.isOpenEmbedding.injective
    show E0.ι (s' ⟨γ, hγ⟩ x) = E0.ι y
    rw [← Scheme.Hom.comp_apply, hs', hx]

  have hcovS : Sieve.generate (Presieve.ofArrows (fun _ : Kκ => W') f) ∈
      Scheme.ProEt.topology (wcGeomPoint K (wcP1Over K) hP).left ℰ := by
    have hs5 : ∀ x : ℰ.left, ∃ j y, (f j).left y = x := by
      intro x; obtain ⟨j, y, hy⟩ := hjs x; exact ⟨j, y, hy⟩
    have hw : ∀ i, WeaklyEtale (f i).left := fun i => by
      have h1 : WeaklyEtale ((f i).left ≫ ℰ.hom) := by
        rw [MorphismProperty.Over.w (f i)]; exact W'.prop
      exact @WeaklyEtale.of_comp _ _ _ (f i).left ℰ.hom h1 ℰ.prop
    let 𝒰 := Scheme.Cover.mkOfCovers (P := ⊤) Kκ (fun _ => W'.left) (fun i => (f i).left) hs5
      (fun _ => trivial)
    haveI : Finite 𝒰.I₀ := (inferInstance : Finite Kκ)
    haveI : ∀ i, QuasiCompact (𝒰.f i) := fun i => hqcs i
    have H : Presieve.ofArrows (fun _ : Kκ => W'.left) (fun i => (f i).left) ∈
        Scheme.proetalePrecoverage.coverings ℰ.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (QuasiCompactCover.of_finite (𝒰 := 𝒰)),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs5 x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))

  obtain ⟨θE, -⟩ := wc_proet_frame_glue_twisted (wcGeomPoint K (wcP1Over K) hP).left L
    (Fin k → ZMod (ℓ ^ n)) W' ℰ θL Kκ f Subtype.val hcovS (by
      intro κ κ' Z a b hab x z
      have h1 : a.left ≫ s' κ = b.left ≫ s' κ' := congrArg (fun t => t.left) hab
      have h2 : a.left ≫ s κ.1 = b.left ≫ s κ'.1 := by
        rw [← hs' κ, ← hs' κ', ← Category.assoc, h1, Category.assoc]
      have h3 : a.left ≫ pV = b.left ≫ pV := by
        calc a.left ≫ pV = (a.left ≫ s κ.1) ≫ πE₀ := by rw [Category.assoc, hs]
          _ = (b.left ≫ s κ'.1) ≫ πE₀ := by rw [h2]
          _ = b.left ≫ pV := by rw [Category.assoc, hs]
      have h4 := (hmeet Z.left a.left b.left h3 κ.1 κ'.1).mp h2 z
      rw [htrans Z a b h3 x z, h4]
      rfl)

  exact ⟨E, πE, rfl, hfin', het', hsurj', hE0c, ⟨θE⟩⟩

theorem wcvsgf_frame_free_maps (Y : Scheme.{u}) (Ub : Y.Opens) (E : Y.Etale)
    (πE : E.left ⟶ Ub.toScheme) (hπE : πE ≫ Ub.ι = E.hom) (hsurjE : Surjective πE)
    (L : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (n k : ℕ)
    (θE : L.over ((wcEtToProEt Y).obj E) ≅
      (wcContSheaf Y (Fin k → ZMod (ℓ ^ n))).over ((wcEtToProEt Y).obj E)) :
    letI : Limits.HasFiniteBiproducts (Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) :=
      Limits.HasFiniteBiproducts.of_hasFiniteProducts
    ∃ Ψ : Limits.biproduct (fun _ : Fin k =>
        Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (wcFreeSheaf Y ((wcEtToProEt Y).obj E)))) ⟶ L,
      ∀ (V : Y.ProEt), (∀ v : V.left, V.hom v ∈ Ub) →
        ∀ s : (Limits.cokernel Ψ).obj.obj (Opposite.op V), s = 0 :=
by
  suffices main : ∀ (ℰ : Y.ProEt) (πℰ : ℰ.left ⟶ Ub.toScheme), πℰ ≫ Ub.ι = ℰ.hom →
      Etale ℰ.hom → Surjective πℰ →
      (L.over ℰ ≅ (wcContSheaf Y (Fin k → ZMod (ℓ ^ n))).over ℰ) →
      letI : Limits.HasFiniteBiproducts (Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) :=
        Limits.HasFiniteBiproducts.of_hasFiniteProducts
      ∃ Ψ : Limits.biproduct (fun _ : Fin k =>
          Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (wcFreeSheaf Y ℰ))) ⟶ L,
        ∀ (V : Y.ProEt), (∀ v : V.left, V.hom v ∈ Ub) →
          ∀ s : (Limits.cokernel Ψ).obj.obj (Opposite.op V), s = 0 by
    exact main _ πE hπE E.prop hsurjE θE
  intro ℰ πℰ hπℰ hEt hsurjℰ θℰ
  letI : Limits.HasFiniteBiproducts (Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) :=
    Limits.HasFiniteBiproducts.of_hasFiniteProducts
  haveI : NeZero (ℓ ^ n) := ⟨pow_ne_zero n (Fact.out : ℓ.Prime).ne_zero⟩
  let J := Scheme.ProEt.topology Y

  let P : (Y.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    yoneda.obj ℰ ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
  let FE : Sheaf J AddCommGrpCat.{u+1} := wcFreeSheaf Y ℰ
  let ν : FE.obj.obj (Opposite.op ℰ) :=
    (toSheafify J P).app (Opposite.op ℰ) (FreeAbelianGroup.of (ULift.up (𝟙 ℰ)))
  have hbij : ∀ (G : Sheaf J AddCommGrpCat.{u+1}),
      Function.Bijective (fun g : (presheafToSheaf J AddCommGrpCat.{u+1}).obj P ⟶ G =>
        (g.hom.app (Opposite.op ℰ)).hom ν) := by
    intro G
    let e2 : (P ⟶ G.obj) ≃ G.obj.obj (Opposite.op ℰ) :=
      ((Adjunction.whiskerRight (Y.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj ℰ ⋙ uliftFunctor.{u+1, u}) G.obj).trans
          (uliftYonedaEquiv.{u+1} (X := ℰ) (F := G.obj ⋙ forget AddCommGrpCat.{u+1}))
    let e' := ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv P G).trans e2
    convert e'.bijective using 1
    funext g
    simp only [e', e2, Equiv.trans_apply, Adjunction.homEquiv_unit]
    rfl
  have hI : ∀ (G : Sheaf J AddCommGrpCat.{u+1}) (g g' : FE ⟶ G),
      (g.hom.app (Opposite.op ℰ)).hom ν = (g'.hom.app (Opposite.op ℰ)).hom ν → g = g' :=
    fun G g g' hg => (hbij G).1 hg
  have hS : ∀ (G : Sheaf J AddCommGrpCat.{u+1}) (s : G.obj.obj (Opposite.op ℰ)),
      ∃ g : FE ⟶ G, (g.hom.app (Opposite.op ℰ)).hom ν = s :=
    fun G s => (hbij G).2 s

  have hs3 : ∀ (M N : Sheaf J AddCommGrpCat.{u+1}) (Ψ : M ⟶ N)
      (𝒰 : Y.ProEt → Prop), (∀ {X X' : Y.ProEt} (_ : X ⟶ X'), 𝒰 X' → 𝒰 X) →
      (∀ X, 𝒰 X → ∀ t : N.obj.obj (Opposite.op X), Presheaf.imageSieve Ψ.hom t ∈ J X) →
      ∀ X, 𝒰 X → ∀ q : (Limits.cokernel Ψ).obj.obj (Opposite.op X), q = 0 := by
    intro M N Ψ 𝒰 h𝒰 hloc
    let π := Limits.cokernel.π Ψ
    have h0 : (0 : M ⟶ Limits.cokernel Ψ).hom = 0 :=
      (sheafToPresheaf J AddCommGrpCat.{u+1}).map_zero M _
    have hA : ∀ X, 𝒰 X → ∀ t : N.obj.obj (Opposite.op X), (π.hom.app (Opposite.op X)).hom t = 0 := by
      intro X hX t
      refine (Limits.cokernel Ψ).isSeparated X _ (hloc X hX t) _ 0 ?_
      rintro X'' f ⟨m, hm⟩
      rw [map_zero, ← NatTrans.naturality_apply π.hom f.op t, ← hm]
      have := congrArg (fun φ => (φ.hom.app (Opposite.op X'')).hom m) (Limits.cokernel.condition Ψ)
      change (π.hom.app (Opposite.op X'')).hom ((Ψ.hom.app (Opposite.op X'')).hom m) =
        ((0 : M ⟶ Limits.cokernel Ψ).hom.app (Opposite.op X'')).hom m at this
      rw [this, h0, NatTrans.app_zero]
      rfl
    intro X hX q
    have hls : Presheaf.IsLocallySurjective J π.hom :=
      (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} π).mpr inferInstance
    refine (Limits.cokernel Ψ).isSeparated X _ (Presheaf.imageSieve_mem J π.hom q) _ 0 ?_
    rintro X'' f ⟨t, ht⟩
    rw [map_zero, ← ht]
    exact hA X'' (h𝒰 f hX) t

  have hs4 : ∀ (M N : Sheaf J AddCommGrpCat.{u+1}) (Ψ : M ⟶ N)
      (X : Y.ProEt) (t : N.obj.obj (Opposite.op X)) (m : ℕ) (W : Fin m → Y.ProEt)
      (g : ∀ j, W j ⟶ X),
      Sieve.generate (Presieve.ofArrows W g) ∈ J X →
      (∀ j, ∃ μ : M.obj.obj (Opposite.op (W j)),
        (Ψ.hom.app (Opposite.op (W j))).hom μ = (N.obj.map (g j).op).hom t) →
      Presheaf.imageSieve Ψ.hom t ∈ J X := by
    intro M N Ψ X t m W g hcov hlift
    refine GrothendieckTopology.superset_covering _ ?_ hcov
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨j⟩
    exact hlift j

  have hopen : ∀ (Q : Y.ProEt) (m : ℕ) (W : Fin m → Y.ProEt) (h : ∀ k, W k ⟶ Q),
      (∀ k, IsOpenMap ⇑(h k).left) → (∀ x : ↥Q.left, ∃ k, x ∈ Set.range ⇑(h k).left) →
      Sieve.generate (Presieve.ofArrows W h) ∈ Scheme.ProEt.topology Y Q := by
    intro Q m W h hO hJ
    have hs : ∀ x : Q.left, ∃ j y, (h j).left y = x := by
      intro x; obtain ⟨j, y, hy⟩ := hJ x; exact ⟨j, y, hy⟩
    have hw : ∀ i, WeaklyEtale (h i).left := fun i => by
      have h1 : WeaklyEtale ((h i).left ≫ Q.hom) := by
        rw [MorphismProperty.Over.w (h i)]; exact (W i).prop
      exact @WeaklyEtale.of_comp _ _ _ (h i).left Q.hom h1 Q.prop
    have H : Presieve.ofArrows (fun i => (W i).left) (fun i => (h i).left) ∈
        Scheme.proetalePrecoverage.coverings Q.left :=
      ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr (QuasiCompactCover.of_isOpenMap
        (𝒰 := Scheme.Cover.mkOfCovers (P := ⊤) (Fin m) (fun i => (W i).left) (fun i => (h i).left)
          hs (fun _ => trivial)) (fun i => hO i)),
        (Scheme.ofArrows_mem_precoverage_iff @WeaklyEtale).mpr
          ⟨fun x => by obtain ⟨j, y, hy⟩ := hs x; exact ⟨j, y, hy⟩, hw⟩⟩
    exact Precoverage.generate_mem_toGrothendieck
      (Precoverage.mem_comap_iff.mpr (by rw [Presieve.map_ofArrows]; exact H))

  have hs6 : ∀ (V : Y.ProEt), (∀ y : V.left, V.hom y ∈ Ub) →
      ∃ (W0 : Y.ProEt) (q1 : W0 ⟶ V) (q2 : W0 ⟶ ℰ),
        IsOpenMap ⇑q1.left ∧ Function.Surjective ⇑q1.left := by
    intro V hv
    haveI : Etale ℰ.hom := hEt
    let W0 : Y.ProEt := MorphismProperty.Over.mk ⊤ (Limits.pullback.fst V.hom ℰ.hom ≫ V.hom)
      (by haveI : WeaklyEtale V.hom := V.prop; infer_instance)
    let q1 : W0 ⟶ V := MorphismProperty.Over.homMk (Limits.pullback.fst V.hom ℰ.hom) rfl trivial
    have hq2 : Limits.pullback.snd V.hom ℰ.hom ≫ ℰ.hom = W0.hom := by
      show _ = Limits.pullback.fst V.hom ℰ.hom ≫ V.hom
      exact Limits.pullback.condition.symm
    let q2 : W0 ⟶ ℰ := MorphismProperty.Over.homMk (Limits.pullback.snd V.hom ℰ.hom) hq2 trivial
    refine ⟨W0, q1, q2, ?_, ?_⟩
    · exact (Limits.pullback.fst V.hom ℰ.hom).isOpenMap
    · intro y
      have hy : V.hom y ∈ Set.range Ub.ι := by rw [Scheme.Opens.range_ι]; exact hv y
      obtain ⟨p, hp⟩ := hy
      obtain ⟨z, hz⟩ := hsurjℰ.surj p
      have hez : V.hom y = ℰ.hom z := by
        rw [← hp, ← hz, ← hπℰ, Scheme.Hom.comp_apply]
      obtain ⟨w, hw, _⟩ := Scheme.Pullback.exists_preimage_pullback y z hez
      exact ⟨w, hw⟩

  have hs7 : ∀ (Q : Y.ProEt) (τ : C(↥Q.left, Fin k → ZMod (ℓ ^ n))),
      ∃ (m : ℕ) (W : Fin m → Y.ProEt) (ι : ∀ j, W j ⟶ Q) (b : Fin m → (Fin k → ZMod (ℓ ^ n))),
        (∀ j, IsOpenMap ⇑(ι j).left) ∧ (∀ x : ↥Q.left, ∃ j, x ∈ Set.range ⇑(ι j).left) ∧
        ∀ j (t : ↥(W j).left), τ ((ι j).left t) = b j := by
    intro Q τ
    classical
    let eB := Finite.equivFin (Fin k → ZMod (ℓ ^ n))
    let O : Fin (Nat.card (Fin k → ZMod (ℓ ^ n))) → Q.left.Opens := fun j =>
      ⟨τ ⁻¹' {eB.symm j}, τ.continuous.isOpen_preimage _ (isOpen_discrete _)⟩
    let W : Fin (Nat.card (Fin k → ZMod (ℓ ^ n))) → Y.ProEt := fun j =>
      MorphismProperty.Over.mk ⊤ ((O j).ι ≫ Q.hom)
        (by haveI : WeaklyEtale Q.hom := Q.prop; infer_instance)
    let ι : ∀ j, W j ⟶ Q := fun j => MorphismProperty.Over.homMk (O j).ι rfl trivial
    refine ⟨Nat.card (Fin k → ZMod (ℓ ^ n)), W, ι, fun j => eB.symm j, fun j => ?_, fun x => ?_,
      fun j t => ?_⟩
    · exact (O j).ι.isOpenEmbedding.isOpenMap
    · refine ⟨eB (τ x), ⟨x, ?_⟩, ?_⟩
      · show τ x ∈ ({eB.symm (eB (τ x))} : Set _)
        simp
      · exact Scheme.Opens.ι_apply _ _
    · show τ ((O j).ι t) = eB.symm j
      exact (congrArg τ (Scheme.Opens.ι_apply (O j) t)).trans t.2

  have hominv : ∀ (T : (Over ℰ)ᵒᵖ) (y : (L.over ℰ).obj.obj T),
      (θℰ.inv.hom.app T).hom ((θℰ.hom.hom.app T).hom y) = y := by
    intro T y
    exact congrArg (fun φ => (φ.hom.app T).hom y) θℰ.hom_inv_id
  have invhom : ∀ (T : (Over ℰ)ᵒᵖ)
      (y : ((wcContSheaf Y (Fin k → ZMod (ℓ ^ n))).over ℰ).obj.obj T),
      (θℰ.hom.hom.app T).hom ((θℰ.inv.hom.app T).hom y) = y := by
    intro T y
    exact congrArg (fun φ => (φ.hom.app T).hom y) θℰ.inv_hom_id
  have ha : ∀ (Z Z' : Y.ProEt) (c : Z ⟶ ℰ) (c' : Z' ⟶ ℰ) (f : Z' ⟶ Z), f ≫ c = c' →
      ∀ (x : L.obj.obj (Opposite.op Z)) (t : Z'.left),
        (show C(↥Z'.left, Fin k → ZMod (ℓ ^ n)) from
          ((θℰ.hom.hom.app (Opposite.op (Over.mk c'))).hom ((L.obj.map f.op).hom x)).down) t =
        (show C(↥Z.left, Fin k → ZMod (ℓ ^ n)) from
          ((θℰ.hom.hom.app (Opposite.op (Over.mk c))).hom x).down) (f.left t) := by
    intro Z Z' c c' f hf x t
    subst hf
    have h := NatTrans.naturality_apply θℰ.hom.hom
      (Over.homMk f rfl : Over.mk (f ≫ c) ⟶ Over.mk c).op x
    exact congrArg (fun y => (show C(↥Z'.left, Fin k → ZMod (ℓ ^ n)) from y.down) t) h
  have hb : ∀ (Z : Y.ProEt) (c : Z ⟶ ℰ) (x y : L.obj.obj (Opposite.op Z)),
      (∀ t : Z.left,
        (show C(↥Z.left, Fin k → ZMod (ℓ ^ n)) from
          ((θℰ.hom.hom.app (Opposite.op (Over.mk c))).hom x).down) t =
        (show C(↥Z.left, Fin k → ZMod (ℓ ^ n)) from
          ((θℰ.hom.hom.app (Opposite.op (Over.mk c))).hom y).down) t) → x = y := by
    intro Z c x y hxy
    have h : (θℰ.hom.hom.app (Opposite.op (Over.mk c))).hom x =
        (θℰ.hom.hom.app (Opposite.op (Over.mk c))).hom y :=
      ULift.ext _ _ (ContinuousMap.ext hxy)
    exact (hominv (Opposite.op (Over.mk c)) x).symm.trans
      ((congrArg (fun z => (θℰ.inv.hom.app (Opposite.op (Over.mk c))).hom z) h).trans
        (hominv (Opposite.op (Over.mk c)) y))
  let cst : (Fin k → ZMod (ℓ ^ n)) →
      ((wcContSheaf Y (Fin k → ZMod (ℓ ^ n))).over ℰ).obj.obj (Opposite.op (Over.mk (𝟙 ℰ))) :=
    fun a => ULift.up (ContinuousMap.const ↥ℰ.left a)
  let s : (Fin k → ZMod (ℓ ^ n)) → L.obj.obj (Opposite.op ℰ) := fun a =>
    (θℰ.inv.hom.app (Opposite.op (Over.mk (𝟙 ℰ)))).hom (cst a)
  have hc : ∀ (a : Fin k → ZMod (ℓ ^ n)) (Z : Y.ProEt) (c : Z ⟶ ℰ) (t : Z.left),
      (show C(↥Z.left, Fin k → ZMod (ℓ ^ n)) from ((θℰ.hom.hom.app (Opposite.op (Over.mk c))).hom
        ((L.obj.map c.op).hom (s a))).down) t = a := by
    intro a Z c t
    refine (ha ℰ Z (𝟙 ℰ) c c (Category.comp_id c) _ t).trans ?_
    have h := invhom (Opposite.op (Over.mk (𝟙 ℰ))) (cst a)
    exact (congrArg (fun y : ((wcContSheaf Y (Fin k → ZMod (ℓ ^ n))).over ℰ).obj.obj
        (Opposite.op (Over.mk (𝟙 ℰ))) =>
      (show C(↥ℰ.left, Fin k → ZMod (ℓ ^ n)) from y.down) (c.left t)) h).trans rfl
  have hs_add : ∀ a b, s (a + b) = s a + s b := by
    intro a b
    have hcst : cst (a + b) = cst a + cst b := rfl
    show (θℰ.inv.hom.app (Opposite.op (Over.mk (𝟙 ℰ)))).hom (cst (a + b)) =
      (θℰ.inv.hom.app (Opposite.op (Over.mk (𝟙 ℰ)))).hom (cst a) +
        (θℰ.inv.hom.app (Opposite.op (Over.mk (𝟙 ℰ)))).hom (cst b)
    rw [hcst, map_add]

  have hadd : ∀ {X : (Y.ProEt)ᵒᵖ} {G H : Sheaf J AddCommGrpCat.{u+1}}
      (f g : G ⟶ H) (x : G.obj.obj X),
      ((f + g).hom.app X).hom x = (f.hom.app X).hom x + (g.hom.app X).hom x := by
    intro X G H f g x
    have : (f + g).hom = f.hom + g.hom :=
      (sheafToPresheaf J AddCommGrpCat.{u+1}).map_add
    rw [this, NatTrans.app_add, AddCommGrpCat.hom_add, AddMonoidHom.add_apply]
  let G₀ : (Fin k → ZMod (ℓ ^ n)) → (FE ⟶ L) := fun a => (hS L (s a)).choose
  have hG₀ : ∀ a, ((G₀ a).hom.app (Opposite.op ℰ)).hom ν = s a :=
    fun a => (hS L (s a)).choose_spec
  have hG₀add : ∀ a b, G₀ (a + b) = G₀ a + G₀ b := by
    intro a b
    apply hI
    rw [hadd, hG₀, hG₀, hG₀]
    exact hs_add a b
  let G : (Fin k → ZMod (ℓ ^ n)) →+ (FE ⟶ L) := AddMonoidHom.mk' G₀ hG₀add
  have hGν : ∀ a, ((G a).hom.app (Opposite.op ℰ)).hom ν = s a := hG₀
  have hnA : ∀ a : Fin k → ZMod (ℓ ^ n), (ℓ ^ n : ℕ) • a = 0 := by
    intro a
    funext i
    rw [Pi.smul_apply, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    rfl
  have hT : ∀ a, ((ℓ ^ n : ℕ) • 𝟙 FE) ≫ G a = 0 := by
    intro a
    rw [Preadditive.nsmul_comp, Category.id_comp, ← map_nsmul G, hnA a, map_zero]
  let Zm := Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 FE)
  let ψ₀ : (Fin k → ZMod (ℓ ^ n)) → (Zm ⟶ L) := fun a =>
    Limits.cokernel.desc ((ℓ ^ n : ℕ) • 𝟙 FE) (G a) (hT a)
  have hK0 : ∀ a, Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 FE) ≫ ψ₀ a = G a :=
    fun a => Limits.cokernel.π_desc _ _ _
  have hψadd : ∀ a b, ψ₀ (a + b) = ψ₀ a + ψ₀ b := by
    intro a b
    apply (cancel_epi (Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 FE))).mp
    rw [Preadditive.comp_add, hK0, hK0, hK0, map_add]
  let ψ : (Fin k → ZMod (ℓ ^ n)) →+ (Zm ⟶ L) := AddMonoidHom.mk' ψ₀ hψadd
  have hK : ∀ a, Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 FE) ≫ ψ a = G a := hK0
  have hR : ∀ (W : Y.ProEt) (c : W ⟶ ℰ) (a : Fin k → ZMod (ℓ ^ n)),
      ((G a).hom.app (Opposite.op W)).hom ((FE.obj.map c.op).hom ν) =
        (L.obj.map c.op).hom (s a) := by
    intro W c a
    rw [NatTrans.naturality_apply (G a).hom c.op, hGν]

  let D := fun _ : Fin k => Zm
  let Ψ : Limits.biproduct D ⟶ L := Limits.biproduct.desc (fun i => ψ (Pi.single i 1))
  have hsum : ∀ bb : Fin k → ZMod (ℓ ^ n),
      ∑ i, (bb i).val • (Pi.single i (1 : ZMod (ℓ ^ n)) : Fin k → ZMod (ℓ ^ n)) = bb := by
    intro bb
    conv_rhs => rw [← Finset.univ_sum_single bb]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [← Pi.single_smul, nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
  have hcoord : ∀ bb : Fin k → ZMod (ℓ ^ n),
      (∑ i, (bb i).val • Limits.biproduct.ι D i) ≫ Ψ = ψ bb := by
    intro bb
    rw [Preadditive.sum_comp]
    simp only [Preadditive.nsmul_comp, Limits.biproduct.ι_desc, Ψ]
    conv_rhs => rw [← hsum bb]
    rw [map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [map_nsmul]

  refine ⟨Ψ, fun V hV q => hs3 _ _ Ψ (fun X => ∀ v : X.left, X.hom v ∈ Ub) ?_ ?_ V hV q⟩
  · intro X X' f hX' v
    rw [← MorphismProperty.Over.w f, Scheme.Hom.comp_apply]
    exact hX' _
  · intro X hX t
    obtain ⟨W0, q1, q2, hq1o, hq1s⟩ := hs6 X hX
    let τ : C(↥W0.left, Fin k → ZMod (ℓ ^ n)) :=
      (show C(↥W0.left, Fin k → ZMod (ℓ ^ n)) from
        ((θℰ.hom.hom.app (Opposite.op (Over.mk q2))).hom ((L.obj.map q1.op).hom t)).down)
    obtain ⟨m, W, ι, b, hιo, hιs, hιc⟩ := hs7 W0 τ
    let g : ∀ j, W j ⟶ X := fun j => ι j ≫ q1
    let c : ∀ j, W j ⟶ ℰ := fun j => ι j ≫ q2
    have e1 : ∀ j, ⇑(g j).left = ⇑q1.left ∘ ⇑(ι j).left := by
      intro j
      funext x
      exact Scheme.Hom.comp_apply _ _ x
    refine hs4 _ _ Ψ X t m W g ?_ ?_
    · refine hopen X m W g (fun j => ?_) (fun x => ?_)
      · rw [e1 j]
        exact hq1o.comp (hιo j)
      · obtain ⟨w, hw⟩ := hq1s x
        obtain ⟨j, t', ht'⟩ := hιs w
        refine ⟨j, t', ?_⟩
        rw [e1 j, Function.comp_apply, ht', hw]
    · intro j
      let φ : Zm ⟶ Limits.biproduct D := ∑ i, (b j i).val • Limits.biproduct.ι D i
      refine ⟨((Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 FE) ≫ φ).hom.app
        (Opposite.op (W j))).hom ((FE.obj.map (c j).op).hom ν), ?_⟩
      have e2 : (Ψ.hom.app (Opposite.op (W j))).hom
          (((Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 FE) ≫ φ).hom.app
            (Opposite.op (W j))).hom ((FE.obj.map (c j).op).hom ν)) =
          ((G (b j)).hom.app (Opposite.op (W j))).hom ((FE.obj.map (c j).op).hom ν) := by
        have h3 : Limits.cokernel.π ((ℓ ^ n : ℕ) • 𝟙 FE) ≫ φ ≫ Ψ = G (b j) := by
          rw [hcoord, hK]
        rw [← h3]
        rfl
      rw [e2, hR]
      apply hb (W j) (c j)
      intro t0
      rw [hc]
      have h4 : (L.obj.map (g j).op).hom t =
          (L.obj.map (ι j).op).hom ((L.obj.map q1.op).hom t) := by
        show (L.obj.map (q1.op ≫ (ι j).op)).hom t = _
        rw [Functor.map_comp]
        rfl
      rw [h4, ha W0 (W j) q2 (c j) (ι j) rfl]
      exact (hιc j t0).symm

theorem wcvsgf_free_part_classical (Y : Scheme.{u})
    [(wcEtToProEt Y).IsContinuous (Scheme.smallEtaleTopology Y) (Scheme.ProEt.topology Y)]
    (E : Y.Etale) (N k : ℕ) :
    letI : Limits.HasFiniteBiproducts (Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) :=
      Limits.HasFiniteBiproducts.of_hasFiniteProducts
    Nonempty ((wcEpsInv Y).obj (Limits.cokernel (N • 𝟙 (wcFtcFS Y E))) ≅
        Limits.cokernel (N • 𝟙 (wcFreeSheaf Y ((wcEtToProEt Y).obj E)))) ∧
    ∃ G₀ : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1},
      Nonempty ((wcEpsInv Y).obj G₀ ≅ Limits.biproduct (fun _ : Fin k =>
        Limits.cokernel (N • 𝟙 (wcFreeSheaf Y ((wcEtToProEt Y).obj E))))) ∧
      ∀ (V : Y.Etale) (x : V.left), V.hom x ∉ Set.range E.hom →
        ∀ g : G₀.obj.obj (Opposite.op V), ∃ (W : Y.Etale) (w : W ⟶ V),
          x ∈ Set.range w.left ∧ (G₀.obj.map w.op).hom g = 0 :=
by
  letI : Limits.HasFiniteBiproducts (Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) :=
