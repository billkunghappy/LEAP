theorem wc_vqtt_block_frame_coordinates (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r m : ℕ)
    (J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (Γ : Subgroup (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (Φ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (μ : ℚ_[ℓ])
    (v₀ : Fin m → Fin r → ℚ_[ℓ]) (ε : Fin m → ℚ_[ℓ])
    (T : Fin m → (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ)
    (hJ : J.transpose = -J) (hJdet : IsUnit J.det)
    (hnorm : ∀ h ∈ Γ, Φ * h * Φ⁻¹ ∈ Γ ∧ Φ⁻¹ * h * Φ ∈ Γ)
    (hΓJ : ∀ h ∈ Γ, (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
      (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = J)
    (hμ : μ ≠ 0)
    (hΦJ : (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
      (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = μ • J)
    (hT : ∀ s, v₀ s ≠ 0 ∧ ε s ≠ 0 ∧ T s ∈ Γ ∧
      (T s : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
        1 + ε s • Matrix.vecMulVec (v₀ s) (Matrix.vecMul (v₀ s) J))
    (hF : ∀ s, ∃ h ∈ Γ, ((Φ * h : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
      Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec (v₀ s) ∈ Submodule.span ℚ_[ℓ] {v₀ s})
    (hspan : Submodule.span ℚ_[ℓ]
      {v | ∃ h ∈ Γ, ∃ s, v = (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec (v₀ s)} = ⊤)
    (hgen : ∀ Wsub : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]),
      (∀ h ∈ Γ, ∀ s, ∀ x ∈ Wsub,
        ((h * T s * h⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x ∈ Wsub) →
      ∀ h ∈ Γ, ∀ x ∈ Wsub, (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]).mulVec x ∈ Wsub) :
    ∃ (t : ℕ) (b : Fin r → Fin t) (P P' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      P * P' = 1 ∧ P' * P = 1 ∧
      (∀ p q, b p ≠ b q → (P.transpose * J * P) p q = 0) ∧
      (∀ p q, b p ≠ b q → (P' * (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * P) p q = 0) ∧
      (∀ p q, b p ≠ b q →
        (P' * ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * P) p q = 0) ∧
      ∃ m₀ : ℕ, ∀ s : Matrix (Fin r) (Fin r) ℚ_[ℓ],
        s.transpose * (P.transpose * J * P) * s = P.transpose * J * P →
        (∀ p q, b p ≠ b q → s p q = 0) →
        (∀ a a', ‖s a a' - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a a'‖ ≤ (ℓ : ℝ) ^ (-(m₀ : ℤ))) →
        ∀ t' : ℕ, ∃ h ∈ Γ, ∀ a a',
          ‖(P' * (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * P) a a' - s a a'‖ ≤ (ℓ : ℝ) ^ (-(t' : ℤ)) :=
by
  classical

  have s3 : ∀ (x y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (c e : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]),
      c ≠ 0 → x * y = 1 → x.transpose * J * x = c • J →
      x * (1 + e • Matrix.vecMulVec v (Matrix.vecMul v J)) * y =
        1 + (e / c) • Matrix.vecMulVec (x.mulVec v) (Matrix.vecMul (x.mulVec v) J) := by
    intro x y c e v hc hxy hx
    have h1 : x.transpose * J = c • (J * y) := by
      calc x.transpose * J = x.transpose * J * (x * y) := by rw [hxy, Matrix.mul_one]
        _ = (x.transpose * J * x) * y := by simp only [Matrix.mul_assoc]
        _ = c • (J * y) := by rw [hx, Matrix.smul_mul]
    have key : Matrix.vecMul (x.mulVec v) J = c • Matrix.vecMul (Matrix.vecMul v J) y := by
      rw [← Matrix.vecMul_transpose, Matrix.vecMul_vecMul, h1, Matrix.vecMul_vecMul]
      ext i
      simp [Matrix.vecMul, dotProduct, Finset.mul_sum, mul_left_comm]
    rw [Matrix.mul_add, Matrix.add_mul, Matrix.mul_one, hxy, Matrix.mul_smul, Matrix.smul_mul,
      Matrix.mul_vecMulVec, Matrix.vecMulVec_mul, key]
    congr 1
    ext i j
    simp only [Matrix.smul_apply, Matrix.vecMulVec_apply, Pi.smul_apply, smul_eq_mul]
    field_simp

  have s4 : ∀ (e : ℚ_[ℓ]) (v : Fin r → ℚ_[ℓ]) (u : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ),
      (u : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = 1 + e • Matrix.vecMulVec v (Matrix.vecMul v J) →
      ∀ z : ℤ, ((u ^ z : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
        1 + ((z : ℤ) : ℚ_[ℓ]) • (e • Matrix.vecMulVec v (Matrix.vecMul v J)) := by
    intro e v u hu
    have hJ' : ∀ a b, J a b = -J b a := fun a b => by
      have := congrFun (congrFun hJ b) a
      simpa [Matrix.transpose_apply] using this
    have hq : ∑ k, Matrix.vecMul v J k * v k = 0 := by
      show ∑ k, (∑ a, v a * J a k) * v k = 0
      have h1 : ∑ k, (∑ a, v a * J a k) * v k = -∑ k, (∑ a, v a * J a k) * v k := by
        simp only [Finset.sum_mul]
        conv_lhs => rw [Finset.sum_comm]
        rw [← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [hJ' a k]; ring
      exact self_eq_neg.mp h1
    set N := e • Matrix.vecMulVec v (Matrix.vecMul v J) with hN
    have hNN : N * N = 0 := by
      ext i j
      have e1 : ∀ k, N i k * N k j =
          (e * e * v i * Matrix.vecMul v J j) * (Matrix.vecMul v J k * v k) := by
        intro k; simp only [hN, Matrix.smul_apply, Matrix.vecMulVec_apply, smul_eq_mul]; ring
      rw [Matrix.mul_apply, Finset.sum_congr rfl (fun k _ => e1 k), ← Finset.mul_sum, hq,
        mul_zero, Matrix.zero_apply]
    have hinv : ((u⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
        1 - N := by
      have h2 : (u : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * (1 - N) = 1 := by
        rw [hu, add_mul, one_mul, mul_sub, mul_one, hNN]; abel
      calc ((u⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ])
          = ((u⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
            ((u : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * (1 - N)) := by rw [h2, mul_one]
        _ = 1 - N := by rw [← mul_assoc, Units.inv_mul, one_mul]
    intro z
    refine Int.induction_on z ?_ ?_ ?_
    · simp
    · intro i ih
      rw [zpow_add_one, Units.val_mul, ih, hu]
      simp only [add_mul, mul_add, one_mul, mul_one, smul_mul_assoc, hNN, smul_zero, add_zero]
      push_cast
      module
    · intro i ih
      rw [zpow_sub_one, Units.val_mul, ih, hinv]
      simp only [add_mul, mul_sub, one_mul, mul_one, smul_mul_assoc, hNN, smul_zero]
      push_cast
      module

  have s5 : ∀ (k p : ℕ) (δ : Fin k → Fin r → ℚ_[ℓ]) (β : Fin k → Fin p),
      Submodule.span ℚ_[ℓ] (Set.range δ) = ⊤ →
      (∀ i j, β i ≠ β j → ∑ a, δ i a * J.mulVec (δ j) a = 0) →
      ∃ (σ : Fin r → Fin k) (P P' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
        P * P' = 1 ∧ P' * P = 1 ∧ (∀ a q, P a q = δ (σ q) a) ∧
        ∀ (γ : Fin p) (v : Fin r → ℚ_[ℓ]), v ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = γ}) →
          ∀ q, β (σ q) ≠ γ → (P'.mulVec v) q = 0 := by
    intro k p δ β hspan horth
    obtain ⟨κ, a, ha, hspan', hli⟩ := exists_linearIndependent' ℚ_[ℓ] δ
    have : Finite κ := Finite.of_injective a ha
    letI : Fintype κ := Fintype.ofFinite κ
    have htop : ⊤ ≤ Submodule.span ℚ_[ℓ] (Set.range (δ ∘ a)) := by rw [hspan', hspan]
    let bas := Module.Basis.mk hli htop
    have hcard : Fintype.card κ = r := by
      rw [← Module.finrank_eq_card_basis bas, Module.finrank_fin_fun]
    let e := Fintype.equivFinOfCardEq hcard
    let σ : Fin r → Fin k := a ∘ e.symm
    have hliσ : LinearIndependent ℚ_[ℓ] (δ ∘ σ) := hli.comp e.symm e.symm.injective
    let P : Matrix (Fin r) (Fin r) ℚ_[ℓ] := Matrix.of fun i q => δ (σ q) i
    have hcols : P.col = δ ∘ σ := by ext q i; rfl
    have hPu : IsUnit P := by
      rw [← Matrix.linearIndependent_cols_iff_isUnit, hcols]
      exact hliσ
    have hPdet : IsUnit P.det := (Matrix.isUnit_iff_isUnit_det P).mp hPu
    refine ⟨σ, P, P⁻¹, Matrix.mul_nonsing_inv P hPdet, Matrix.nonsing_inv_mul P hPdet,
      fun i q => rfl, ?_⟩
    intro γ v hv q hq
    let Bf : (Fin r → ℚ_[ℓ]) → (Fin r → ℚ_[ℓ]) → ℚ_[ℓ] := fun x y => ∑ a, x a * J.mulVec y a
    have hzero_l : ∀ (S : Set (Fin r → ℚ_[ℓ])) (y : Fin r → ℚ_[ℓ]), (∀ x ∈ S, Bf x y = 0) →
        ∀ x ∈ Submodule.span ℚ_[ℓ] S, Bf x y = 0 := by
      intro S y h x hx
      induction hx using Submodule.span_induction with
      | mem x hx => exact h x hx
      | zero => simp [Bf]
      | add x z _ _ hx hz =>
        simp only [Bf, Pi.add_apply, add_mul, Finset.sum_add_distrib] at hx hz ⊢
        rw [hx, hz, add_zero]
      | smul t x _ hx =>
        simp only [Bf, Pi.smul_apply, smul_eq_mul, mul_assoc, ← Finset.mul_sum] at hx ⊢
        rw [hx, mul_zero]
    have hzero_r : ∀ (S : Set (Fin r → ℚ_[ℓ])) (x : Fin r → ℚ_[ℓ]), (∀ y ∈ S, Bf x y = 0) →
        ∀ y ∈ Submodule.span ℚ_[ℓ] S, Bf x y = 0 := by
      intro S x h y hy
      induction hy using Submodule.span_induction with
      | mem y hy => exact h y hy
      | zero => simp [Bf]
      | add y z _ _ hy hz =>
        simp only [Bf, Matrix.mulVec_add, Pi.add_apply, mul_add, Finset.sum_add_distrib] at hy hz ⊢
        rw [hy, hz, add_zero]
      | smul t y _ hy =>
        simp only [Bf, Matrix.mulVec_smul, Pi.smul_apply, smul_eq_mul, mul_left_comm,
          ← Finset.mul_sum] at hy ⊢
        rw [hy, mul_zero]
    have hnd : ∀ x : Fin r → ℚ_[ℓ], (∀ y, Bf x y = 0) → x = 0 := by
      intro x hx
      have h1 : Matrix.vecMul x J = 0 := by
        ext b
        have := hx (Pi.single b 1)
        simp only [Bf, Matrix.mulVec, dotProduct, Pi.single_apply, mul_ite, mul_one, mul_zero,
          Finset.sum_ite_eq', Finset.mem_univ, ite_true] at this
        simpa [Matrix.vecMul, dotProduct] using this
      calc x = Matrix.vecMul x (J * J⁻¹) := by
            rw [Matrix.mul_nonsing_inv J hJdet, Matrix.vecMul_one]
        _ = 0 := by rw [← Matrix.vecMul_vecMul, h1, Matrix.zero_vecMul]
    have hexp : ∀ d : Fin r → ℚ_[ℓ], P.mulVec d = ∑ q, d q • δ (σ q) := by
      intro d; ext i
      simp only [P, Matrix.mulVec, dotProduct, Matrix.of_apply, Finset.sum_apply, Pi.smul_apply,
        smul_eq_mul]
      exact Finset.sum_congr rfl fun q _ => mul_comm _ _
    set c := P⁻¹.mulVec v with hc
    have hv_eq : v = ∑ q, c q • δ (σ q) := by
      rw [← hexp, hc, Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv P hPdet, Matrix.one_mulVec]
    set vout : Fin r → ℚ_[ℓ] := ∑ q, (if β (σ q) ≠ γ then c q else 0) • δ (σ q) with hvout
    set vin : Fin r → ℚ_[ℓ] := ∑ q, (if β (σ q) ≠ γ then 0 else c q) • δ (σ q) with hvin
    have hsplit : v = vin + vout := by
      rw [hv_eq, hvin, hvout, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun q _ => ?_
      split_ifs <;> simp
    have hvinW : vin ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = γ}) := by
      apply Submodule.sum_mem
      intro q _
      split_ifs with h
      · rw [zero_smul]; exact Submodule.zero_mem _
      · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨σ q, not_not.mp h, rfl⟩)
    have hvoutW : vout ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = γ}) := by
      have : vout = v - vin := by rw [hsplit]; abel
      rw [this]; exact Submodule.sub_mem _ hv hvinW
    have hvoutO : vout ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j ≠ γ}) := by
      apply Submodule.sum_mem
      intro q _
      split_ifs with h
      · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨σ q, h, rfl⟩)
      · rw [zero_smul]; exact Submodule.zero_mem _
    have horth1 : ∀ j, Bf vout (δ j) = 0 := by
      intro j
      by_cases hj : β j = γ
      · refine hzero_l _ _ ?_ vout hvoutO
        rintro x ⟨i, hi, rfl⟩
        exact horth i j (fun h => hi (h.trans hj))
      · refine hzero_l _ _ ?_ vout hvoutW
        rintro x ⟨i, hi, rfl⟩
        exact horth i j (fun h => hj (h.symm.trans hi))
    have horth2 : ∀ y, Bf vout y = 0 := by
      intro y
      refine hzero_r (Set.range δ) vout ?_ y (by rw [hspan]; exact Submodule.mem_top)
      rintro y ⟨j, rfl⟩
      exact horth1 j
    have hvout0 : vout = 0 := hnd vout horth2
    have := (Fintype.linearIndependent_iff.mp hliσ) _ hvout0 q
    simpa [hq] using this

  have s6 : ∀ (k p : ℕ) (δ : Fin k → Fin r → ℚ_[ℓ]) (β : Fin k → Fin p),
      (∀ i j, β i ≠ β j → ∑ a, δ i a * J.mulVec (δ j) a = 0) →
      ∀ (σ : Fin r → Fin k) (P P' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      (∀ a q, P a q = δ (σ q) a) →
      (∀ (γ : Fin p) (v : Fin r → ℚ_[ℓ]), v ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = γ}) →
          ∀ q, β (σ q) ≠ γ → (P'.mulVec v) q = 0) →
      (∀ p' q, β (σ p') ≠ β (σ q) → (P.transpose * J * P) p' q = 0) ∧
      (∀ X : Matrix (Fin r) (Fin r) ℚ_[ℓ],
        (∀ j, X.mulVec (δ j) ∈ Submodule.span ℚ_[ℓ] (δ '' {j' | β j' = β j})) →
        ∀ p' q, β (σ p') ≠ β (σ q) → (P' * X * P) p' q = 0) ∧
      (∀ s : Matrix (Fin r) (Fin r) ℚ_[ℓ], (∀ p' q, β (σ p') ≠ β (σ q) → s p' q = 0) →
        ∀ i, (P * s * P').mulVec (δ i) ∈ Submodule.span ℚ_[ℓ] (δ '' {j | β j = β i})) := by
    intro k p δ β horth σ P P' hcol hsupp
    have hcolq : ∀ q, (fun a => P a q) = δ (σ q) := fun q => funext fun a => hcol a q
    have hexp : ∀ d : Fin r → ℚ_[ℓ], P.mulVec d = ∑ q, d q • δ (σ q) := by
      intro d; ext a
      simp only [Matrix.mulVec, dotProduct, hcol, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
      exact Finset.sum_congr rfl fun q _ => mul_comm _ _
    refine ⟨fun p' q hne => ?_, fun X hX p' q hne => ?_, fun s hs i => ?_⟩
    · rw [← horth (σ p') (σ q) hne]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.mulVec, dotProduct, hcol,
        Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
    · have e1 : (P' * X * P) p' q = (P'.mulVec (X.mulVec (δ (σ q)))) p' := by
        rw [← hcolq q, Matrix.mulVec_mulVec]
        simp only [Matrix.mulVec, dotProduct, Matrix.mul_apply]
      rw [e1]
      exact hsupp _ _ (hX (σ q)) p' hne
    · have hc : ∀ q, β (σ q) ≠ β i → (P'.mulVec (δ i)) q = 0 :=
        hsupp (β i) (δ i) (Submodule.subset_span ⟨i, rfl, rfl⟩)
      have hd : ∀ p', β (σ p') ≠ β i → (s.mulVec (P'.mulVec (δ i))) p' = 0 := by
        intro p' hp'
        simp only [Matrix.mulVec, dotProduct]
        apply Finset.sum_eq_zero
        intro q _
        by_cases hq : β (σ q) = β i
        · rw [hs p' q (by rw [hq]; exact hp'), zero_mul]
        · have := hc q hq
          simp only [Matrix.mulVec, dotProduct] at this
          rw [this, mul_zero]
      rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hexp]
      apply Submodule.sum_mem
      intro q _
      by_cases hq : β (σ q) = β i
      · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨σ q, hq, rfl⟩)
      · rw [hd q hq, zero_smul]; exact Submodule.zero_mem _

  have s7 : ∀ (P P' : Matrix (Fin r) (Fin r) ℚ_[ℓ]),
      ∃ n₀ : ℕ, ∀ (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (m : ℕ),
        (∀ a b, ‖X a b‖ ≤ (ℓ : ℝ) ^ (-((m + n₀ : ℕ) : ℤ))) →
        ∀ a b, ‖(P * X * P') a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ)) ∧
          ‖(P' * X * P) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ)) := by
    intro P P'
    have hbd : ∀ A : Matrix (Fin r) (Fin r) ℚ_[ℓ], ∀ a b,
        ‖A a b‖ ≤ 1 + ∑ a', ∑ b', ‖A a' b'‖ := by
      intro A a b
      have h1 : ‖A a b‖ ≤ ∑ b', ‖A a b'‖ :=
        Finset.single_le_sum (f := fun b' => ‖A a b'‖) (fun _ _ => norm_nonneg _)
          (Finset.mem_univ b)
      have h2 : ∑ b', ‖A a b'‖ ≤ ∑ a', ∑ b', ‖A a' b'‖ :=
        Finset.single_le_sum (f := fun a' => ∑ b', ‖A a' b'‖)
          (fun _ _ => Finset.sum_nonneg fun _ _ => norm_nonneg _) (Finset.mem_univ a)
      linarith
    have hbd0 : ∀ A : Matrix (Fin r) (Fin r) ℚ_[ℓ], 0 ≤ 1 + ∑ a', ∑ b', ‖A a' b'‖ := by
      intro A
      have : 0 ≤ ∑ a', ∑ b', ‖A a' b'‖ :=
        Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => norm_nonneg _
      linarith
    set B : ℝ := 1 + ∑ a', ∑ b', ‖P a' b'‖ with hBdef
    set B' : ℝ := 1 + ∑ a', ∑ b', ‖P' a' b'‖ with hB'def
    have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
    have hℓ0 : (ℓ : ℝ) ≠ 0 := by positivity
    obtain ⟨n₀, hn₀⟩ := pow_unbounded_of_one_lt (B * B') hℓ1
    refine ⟨n₀, fun X m hX a b => ?_⟩
    have hη0 : (0 : ℝ) ≤ (ℓ : ℝ) ^ (-((m + n₀ : ℕ) : ℤ)) := by positivity
    have key : ∀ C D : ℝ, C * D = B * B' →
        C * D * (ℓ : ℝ) ^ (-((m + n₀ : ℕ) : ℤ)) ≤ (ℓ : ℝ) ^ (-(m : ℤ)) := by
      intro C D hCD
      have : (ℓ : ℝ) ^ (-(m : ℤ)) = (ℓ : ℝ) ^ n₀ * (ℓ : ℝ) ^ (-((m + n₀ : ℕ) : ℤ)) := by
        rw [← zpow_natCast (ℓ : ℝ) n₀, ← zpow_add₀ hℓ0]
        congr 1; push_cast; ring
      rw [this, hCD]
      exact mul_le_mul_of_nonneg_right hn₀.le hη0
    have gen : ∀ (A C : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (BA BC : ℝ), 0 ≤ BA → 0 ≤ BC →
        (∀ a b, ‖A a b‖ ≤ BA) → (∀ a b, ‖C a b‖ ≤ BC) →
        ∀ a b, ‖(A * X * C) a b‖ ≤ BA * BC * (ℓ : ℝ) ^ (-((m + n₀ : ℕ) : ℤ)) := by
      intro A C BA BC hA0 hC0 hA hC a b
      rw [Matrix.mul_apply]
      apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg
        (mul_nonneg (mul_nonneg hA0 hC0) hη0)
      intro d _
      rw [norm_mul, Matrix.mul_apply]
      have h1 : ‖∑ c, A a c * X c d‖ ≤ BA * (ℓ : ℝ) ^ (-((m + n₀ : ℕ) : ℤ)) := by
        apply IsUltrametricDist.norm_sum_le_of_forall_le_of_nonneg (mul_nonneg hA0 hη0)
        intro c _
        rw [norm_mul]
        exact mul_le_mul (hA a c) (hX c d) (norm_nonneg _) hA0
      calc ‖∑ c, A a c * X c d‖ * ‖C d b‖
          ≤ (BA * (ℓ : ℝ) ^ (-((m + n₀ : ℕ) : ℤ))) * BC :=
            mul_le_mul h1 (hC d b) (norm_nonneg _) (mul_nonneg hA0 hη0)
        _ = BA * BC * (ℓ : ℝ) ^ (-((m + n₀ : ℕ) : ℤ)) := by ring
    exact ⟨(gen P P' B B' (hbd0 P) (hbd0 P') (hbd P) (hbd P') a b).trans (key B B' rfl),
      (gen P' P B' B (hbd0 P') (hbd0 P) (hbd P') (hbd P) a b).trans (key B' B (mul_comm _ _))⟩

  have s2 : ∃ (G : Type) (_ : Group G) (ρ : G →* Matrix (Fin r) (Fin r) ℚ_[ℓ])
      (deg : G →* Multiplicative ℤ) (τ Fs : Fin m → G) (gp gm : G),
      (∀ g : G, ∃ c : ℚ_[ℓ], c ≠ 0 ∧ (ρ g).transpose * J * ρ g = c • J) ∧
      (∀ s, v₀ s ≠ 0 ∧ deg (τ s) = 1 ∧ ε s ≠ 0 ∧
        ρ (τ s) = 1 + ε s • Matrix.vecMulVec (v₀ s) (Matrix.vecMul (v₀ s) J)) ∧
      (∀ s, deg (Fs s) = Multiplicative.ofAdd 1 ∧
        (ρ (Fs s)).mulVec (v₀ s) ∈ Submodule.span ℚ_[ℓ] {v₀ s}) ∧
      Submodule.span ℚ_[ℓ] {v | ∃ (g : G) (s : Fin m), v = (ρ g).mulVec (v₀ s)} = ⊤ ∧
      (∀ Wsub : Submodule ℚ_[ℓ] (Fin r → ℚ_[ℓ]),
        (∀ (h : G) (s : Fin m), ∀ w ∈ Wsub, (ρ (h * τ s * h⁻¹)).mulVec w ∈ Wsub) →
        ∀ g : G, deg g = 1 → ∀ w ∈ Wsub, (ρ g).mulVec w ∈ Wsub) ∧
      (∀ g : G, deg g = 1 → ∃ h ∈ Γ, ρ g = (h : Matrix (Fin r) (Fin r) ℚ_[ℓ])) ∧
      ρ gp = (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) ∧
      ρ gm = ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) := by
    have hC : ∀ n : ℤ, ∀ h ∈ Γ, Φ ^ n * h * Φ ^ (-n) ∈ Γ := by
      intro n
      refine Int.induction_on n ?_ ?_ ?_
      · intro h hh; simpa using hh
      · intro i ih h hh
        have e : Φ ^ ((i : ℤ) + 1) * h * Φ ^ (-((i : ℤ) + 1)) =
            Φ * (Φ ^ (i : ℤ) * h * Φ ^ (-(i : ℤ))) * Φ⁻¹ := by group
        rw [e]; exact (hnorm _ (ih h hh)).1
      · intro i ih h hh
        have e : Φ ^ (-(i : ℤ) - 1) * h * Φ ^ (-(-(i : ℤ) - 1)) =
            Φ⁻¹ * (Φ ^ (-(i : ℤ)) * h * Φ ^ (-(-(i : ℤ)))) * Φ := by group
        rw [e]; exact (hnorm _ (ih h hh)).2
    have hstep : ∀ (x y : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) (a b : ℚ_[ℓ]),
        (x : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J * (x : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
          a • J →
        (y : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J * (y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
          b • J →
        ((x * y : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
          ((x * y : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
            (a * b) • J := by
      intro x y a b hx hy
      rw [Units.val_mul, Matrix.transpose_mul]
      calc (y : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose *
            (x : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose *
            J * ((x : Matrix (Fin r) (Fin r) ℚ_[ℓ]) * (y : Matrix (Fin r) (Fin r) ℚ_[ℓ]))
          = (y : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose *
            ((x : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
              (x : Matrix (Fin r) (Fin r) ℚ_[ℓ])) *
            (y : Matrix (Fin r) (Fin r) ℚ_[ℓ]) := by simp only [Matrix.mul_assoc]
        _ = (a * b) • J := by
            rw [hx, Matrix.mul_smul, Matrix.smul_mul, hy, smul_smul, mul_comm]
    have hinv : ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
        Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
        ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = μ⁻¹ • J := by
      have key : ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
          Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose *
          ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
            (Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ])) *
          ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = J := by
        calc _ = ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
              ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
                Matrix (Fin r) (Fin r) ℚ_[ℓ])).transpose * J *
              ((Φ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) *
              ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ])) := by
              rw [Matrix.transpose_mul]; simp only [Matrix.mul_assoc]
          _ = J := by rw [Units.mul_inv]; simp
      rw [hΦJ, Matrix.mul_smul, Matrix.smul_mul] at key
      calc _ = μ⁻¹ • (μ • (((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
            Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
            ((Φ⁻¹ : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]))) := by
            rw [smul_smul, inv_mul_cancel₀ hμ, one_smul]
        _ = μ⁻¹ • J := by rw [key]
    have hZ : ∀ n : ℤ, ((Φ ^ n : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
        Matrix (Fin r) (Fin r) ℚ_[ℓ]).transpose * J *
        ((Φ ^ n : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) : Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
          μ ^ n • J := by
      intro n
      refine Int.induction_on n ?_ ?_ ?_
      · simp
      · intro i ih
        rw [zpow_add_one, zpow_add_one₀ hμ]
        exact hstep _ _ _ _ ih hΦJ
      · intro i ih
        rw [zpow_sub_one, zpow_sub_one₀ hμ]
        exact hstep _ _ _ _ ih hinv
    let H : Subgroup ((Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ × Multiplicative ℤ) :=
      { carrier := {p | Φ ^ (-(Multiplicative.toAdd p.2)) * p.1 ∈ Γ}
        one_mem' := by
          show Φ ^ (-(Multiplicative.toAdd (1 : Multiplicative ℤ))) * 1 ∈ Γ
          simp only [toAdd_one, neg_zero, zpow_zero, mul_one]
          exact Γ.one_mem
        mul_mem' := by
          rintro ⟨x, a⟩ ⟨y, b⟩ hx hy
          change Φ ^ (-(Multiplicative.toAdd a)) * x ∈ Γ at hx
          change Φ ^ (-(Multiplicative.toAdd b)) * y ∈ Γ at hy
          show Φ ^ (-(Multiplicative.toAdd (a * b))) * (x * y) ∈ Γ
          rw [toAdd_mul]
          have e : Φ ^ (-(Multiplicative.toAdd a + Multiplicative.toAdd b)) * (x * y) =
              (Φ ^ (-(Multiplicative.toAdd b)) * (Φ ^ (-(Multiplicative.toAdd a)) * x) *
                Φ ^ (-(-(Multiplicative.toAdd b)))) * (Φ ^ (-(Multiplicative.toAdd b)) * y) := by
            group
          rw [e]; exact Γ.mul_mem (hC _ _ hx) hy
        inv_mem' := by
          rintro ⟨x, a⟩ hx
          change Φ ^ (-(Multiplicative.toAdd a)) * x ∈ Γ at hx
          show Φ ^ (-(Multiplicative.toAdd a⁻¹)) * x⁻¹ ∈ Γ
          rw [toAdd_inv]
          have e : Φ ^ (-(-(Multiplicative.toAdd a))) * x⁻¹ =
              Φ ^ (Multiplicative.toAdd a) * (Φ ^ (-(Multiplicative.toAdd a)) * x)⁻¹ *
                Φ ^ (-(Multiplicative.toAdd a)) := by group
          rw [e]; exact hC _ _ (Γ.inv_mem hx) }
    have memΓ : ∀ h ∈ Γ,
        ((h, 1) : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ × Multiplicative ℤ) ∈ H := by
      intro h hh
      show Φ ^ (-(Multiplicative.toAdd (1 : Multiplicative ℤ))) * h ∈ Γ
      simpa using hh
    have mem1 : ∀ g : H, g.1.2 = 1 → g.1.1 ∈ Γ := by
      rintro ⟨⟨x, a⟩, hx⟩ ha
      change a = 1 at ha
      subst ha
      change Φ ^ (-(Multiplicative.toAdd (1 : Multiplicative ℤ))) * x ∈ Γ at hx
      simpa using hx
    choose hs hsΓ hsF using hF
    let φ : H →* (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ := (MonoidHom.fst _ _).comp H.subtype
    let ρ : H →* Matrix (Fin r) (Fin r) ℚ_[ℓ] := (Units.coeHom _).comp φ
    let deg : H →* Multiplicative ℤ := (MonoidHom.snd _ _).comp H.subtype
    have hρ : ∀ g : H, ρ g = ((g.1.1 : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
        Matrix (Fin r) (Fin r) ℚ_[ℓ]) := fun g => rfl
    let τ : Fin m → H := fun s => ⟨(T s, 1), memΓ _ (hT s).2.2.1⟩
    let Fs : Fin m → H := fun s => ⟨(Φ * hs s, Multiplicative.ofAdd 1), by
      show Φ ^ (-(Multiplicative.toAdd (Multiplicative.ofAdd (1 : ℤ)))) * (Φ * hs s) ∈ Γ
      rw [toAdd_ofAdd]
      have e : Φ ^ (-(1 : ℤ)) * (Φ * hs s) = hs s := by group
      rw [e]; exact hsΓ s⟩
    let gp : H := ⟨(Φ, Multiplicative.ofAdd 1), by
      show Φ ^ (-(Multiplicative.toAdd (Multiplicative.ofAdd (1 : ℤ)))) * Φ ∈ Γ
      rw [toAdd_ofAdd]
      have e : Φ ^ (-(1 : ℤ)) * Φ = 1 := by group
      rw [e]; exact Γ.one_mem⟩
    let gm : H := ⟨(Φ⁻¹, Multiplicative.ofAdd (-1)), by
      show Φ ^ (-(Multiplicative.toAdd (Multiplicative.ofAdd (-1 : ℤ)))) * Φ⁻¹ ∈ Γ
      rw [toAdd_ofAdd]
      have e : Φ ^ (-(-1 : ℤ)) * Φ⁻¹ = 1 := by group
      rw [e]; exact Γ.one_mem⟩
    refine ⟨H, inferInstance, ρ, deg, τ, Fs, gp, gm, ?_, ?_, ?_, ?_, ?_, ?_, rfl, rfl⟩
    · rintro ⟨⟨x, a⟩, hx⟩
      refine ⟨μ ^ (Multiplicative.toAdd a), zpow_ne_zero _ hμ, ?_⟩
      have hx' : Φ ^ (-(Multiplicative.toAdd a)) * x ∈ Γ := hx
      have e : x = Φ ^ (Multiplicative.toAdd a) * (Φ ^ (-(Multiplicative.toAdd a)) * x) := by
        group
      have := hstep _ _ _ 1 (hZ (Multiplicative.toAdd a)) (by rw [hΓJ _ hx', one_smul])
      rw [← e, mul_one] at this
      exact this
    · intro s
      exact ⟨(hT s).1, rfl, (hT s).2.1, (hT s).2.2.2⟩
    · intro s
      exact ⟨rfl, hsF s⟩
    · rw [eq_top_iff, ← hspan]
      apply Submodule.span_mono
      rintro v ⟨h, hh, s, rfl⟩
      exact ⟨⟨(h, 1), memΓ h hh⟩, s, rfl⟩
    · intro W hW g hg w hw
      rw [hρ]
      refine hgen W (fun h hh s x hx => ?_) _ (mem1 g hg) w hw
      exact hW ⟨(h, 1), memΓ h hh⟩ s x hx
    · intro g hg
      exact ⟨g.1.1, mem1 g hg, rfl⟩


  obtain ⟨G, instG, ρ, deg, τ, Fs, gp, gm, hsim, hτ, hF', hspanG, hgenG, hdeg1, hgp, hgm⟩ := s2
  have CS := wc_block_class_stability r m J hJ hJdet ρ deg v₀ ε τ Fs hsim hτ hF' hspanG hgenG
  have h0 : (0 : Fin r → ℚ_[ℓ]) ∉ {v | ∃ (g : G) (s : Fin m), v = (ρ g).mulVec (v₀ s)} := by
    rintro ⟨g, s, hgs⟩
    apply (hτ s).1
    have e1 : (ρ g⁻¹).mulVec ((ρ g).mulVec (v₀ s)) = v₀ s := by
      rw [Matrix.mulVec_mulVec, ← map_mul, inv_mul_cancel, map_one, Matrix.one_mulVec]
    rw [← e1, ← hgs, Matrix.mulVec_zero]
  obtain ⟨k, p, δ, β, hδV, hδspan, horth, hconn, hclass⟩ :=
    wc_block_family_selection r J hJ hJdet _ h0 hspanG
  have hδV' : ∀ i, ∃ (x : G) (s : Fin m), δ i = (ρ x).mulVec (v₀ s) := hδV
  choose g s₀ hgs using hδV'
  choose c hc0 hcJ using fun i => hsim (g i)
  obtain ⟨ε', hε'⟩ : ∃ ε' : Fin k → ℚ_[ℓ], ∀ i, ε' i = ε (s₀ i) / c i := ⟨_, fun i => rfl⟩
  have hε'0 : ∀ i, ε' i ≠ 0 := fun i => by
    rw [hε' i]; exact div_ne_zero (hT (s₀ i)).2.1 (hc0 i)
  obtain ⟨Mt, hMt⟩ : ∃ Mt : Fin k → Matrix (Fin r) (Fin r) ℚ_[ℓ],
      ∀ i, Mt i = ε' i • Matrix.vecMulVec (δ i) (Matrix.vecMul (δ i) J) := ⟨_, fun i => rfl⟩
  have hu : ∀ i, ∃ u ∈ Γ, (u : Matrix (Fin r) (Fin r) ℚ_[ℓ]) = 1 + Mt i := by
    intro i
    have hdeg : deg (g i * τ (s₀ i) * (g i)⁻¹) = 1 := by
      rw [map_mul, map_mul, map_inv, (hτ (s₀ i)).2.1, mul_one, mul_inv_cancel]
    obtain ⟨u, huΓ, hu⟩ := hdeg1 _ hdeg
    refine ⟨u, huΓ, ?_⟩
    rw [← hu, map_mul, map_mul, (hτ (s₀ i)).2.2.2,
      s3 (ρ (g i)) (ρ (g i)⁻¹) (c i) (ε (s₀ i))
        (v₀ (s₀ i)) (hc0 i) (by rw [← map_mul, mul_inv_cancel, map_one]) (hcJ i),
      ← hgs i, hMt i, hε' i]
  choose u huΓ huM using hu
  have hpow : ∀ i (z : ℤ), ((u i ^ z : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
      Matrix (Fin r) (Fin r) ℚ_[ℓ]) = 1 + ((z : ℤ) : ℚ_[ℓ]) • Mt i := by
    intro i z
    rw [hMt i]
    exact s4 (ε' i) (δ i) (u i) (by rw [huM i, hMt i]) z
  have hword : ∀ L : List (Fin k × ℤ), (L.map (fun q => u q.1 ^ q.2)).prod ∈ Γ ∧
      (((L.map (fun q => u q.1 ^ q.2)).prod : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
        Matrix (Fin r) (Fin r) ℚ_[ℓ]) =
        (L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • Mt q.1)).prod := by
    intro L
    induction L with
    | nil => simp [Γ.one_mem]
    | cons q L ih =>
      simp only [List.map_cons, List.prod_cons]
      refine ⟨Γ.mul_mem (Γ.zpow_mem (huΓ q.1) q.2) ih.1, ?_⟩
      rw [Units.val_mul, hpow, ih.2]
  have hLie := wc_sp_lie_span_block_transvections r k p J hJ hJdet δ β hδspan horth hconn ε' hε'0
  obtain ⟨m₁, happ₁⟩ := wc_sp_block_congruence_integer_words ℓ r k p J hJ hJdet δ β hδspan horth
    ε' Mt hMt (fun V hV hc X hX hXδ =>
      hLie V (fun i => by rw [← hMt i]; exact hV i) hc X hX hXδ)
  obtain ⟨σ, P, P', hPP', hP'P, hcol, hsupp⟩ := s5 k p δ β hδspan horth
  obtain ⟨hGram, hXblk, hsblk⟩ := s6 k p δ β horth σ P P' hcol hsupp
  have hpres : ∀ x : G, ∀ j, (ρ x).mulVec (δ j) ∈
      Submodule.span ℚ_[ℓ] (δ '' {j' | β j' = β j}) := by
    intro x j
    have hmem : (ρ x).mulVec (δ j) ∈
        {v | ∃ (g : G) (s : Fin m), v = (ρ g).mulVec (v₀ s)} :=
      ⟨x * g j, s₀ j, by rw [hgs j, Matrix.mulVec_mulVec, map_mul]⟩
    exact hclass j _ hmem (Relation.EqvGen.symm _ _ (CS x (δ j) (hδV j)))
  obtain ⟨n₀, hB⟩ := s7 P P'
  refine ⟨p, fun q => β (σ q), P, P', hPP', hP'P, hGram, ?_, ?_, m₁ + n₀, ?_⟩
  · exact hXblk _ (fun j => by rw [← hgp]; exact hpres gp j)
  · exact hXblk _ (fun j => by rw [← hgm]; exact hpres gm j)
  · intro s hs hsb hs1 t'
    have h1 : P'.transpose * P.transpose = 1 := by
      rw [← Matrix.transpose_mul, hPP', Matrix.transpose_one]
    have hsym : (P * s * P').transpose * J * (P * s * P') = J := by
      calc (P * s * P').transpose * J * (P * s * P')
          = P'.transpose * (s.transpose * (P.transpose * J * P) * s) * P' := by
            rw [Matrix.transpose_mul, Matrix.transpose_mul]; simp only [Matrix.mul_assoc]
        _ = P'.transpose * (P.transpose * J * P) * P' := by rw [hs]
        _ = (P'.transpose * P.transpose) * J * (P * P') := by simp only [Matrix.mul_assoc]
        _ = J := by rw [h1, hPP', Matrix.one_mul, Matrix.mul_one]
    have hblk := hsblk s hsb
    have hnear : ∀ a b, ‖(P * s * P') a b - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤
        (ℓ : ℝ) ^ (-(m₁ : ℤ)) := by
      have heq : P * s * P' - 1 = P * (s - 1) * P' := by
        rw [Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_one, hPP']
      intro a b
      rw [← Matrix.sub_apply, heq]
      exact (hB (s - 1) m₁ (fun a b => by rw [Matrix.sub_apply]; exact hs1 a b) a b).1
    obtain ⟨L, hL⟩ := happ₁ (P * s * P') hsym hblk hnear (t' + n₀)
    refine ⟨(L.map (fun q => u q.1 ^ q.2)).prod, (hword L).1, ?_⟩
    intro a a'
    have heq : P' * (((L.map (fun q => u q.1 ^ q.2)).prod : (Matrix (Fin r) (Fin r) ℚ_[ℓ])ˣ) :
        Matrix (Fin r) (Fin r) ℚ_[ℓ]) * P - s =
        P' * ((L.map (fun q => 1 + ((q.2 : ℤ) : ℚ_[ℓ]) • Mt q.1)).prod - P * s * P') * P := by
      rw [(hword L).2, Matrix.mul_sub, Matrix.sub_mul,
        show P' * (P * s * P') * P = (P' * P) * s * (P' * P) by simp only [Matrix.mul_assoc],
        hP'P, Matrix.one_mul, Matrix.mul_one]
    rw [← Matrix.sub_apply, heq]
    exact (hB _ t' (fun a b => by rw [Matrix.sub_apply]; exact hL a b) a a').2

theorem wc_vqtt_tensor_transport_closure (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r k N : ℕ)
    (P P' : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hPP' : P * P' = 1) (hP'P : P' * P = 1)
    (T : Fin N → (Fin (2 * k) → Fin r) → ℚ_[ℓ]) :
    (LinearIndependent ℚ_[ℓ] T →
      LinearIndependent ℚ_[ℓ] (fun (l : Fin N) (i : Fin (2 * k) → Fin r) =>
        ∑ j : Fin (2 * k) → Fin r, T l j * ∏ a, P (j a) (i a))) ∧
    (∀ (h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (l : Fin N),
      (∀ i : Fin (2 * k) → Fin r, ∑ j : Fin (2 * k) → Fin r, T l j * ∏ a, h (j a) (i a) = T l i) →
      ∀ i : Fin (2 * k) → Fin r, ∑ j : Fin (2 * k) → Fin r,
          (∑ j' : Fin (2 * k) → Fin r, T l j' * ∏ a, P (j' a) (j a)) * ∏ a, (P' * h * P) (j a) (i a) =
        ∑ j' : Fin (2 * k) → Fin r, T l j' * ∏ a, P (j' a) (i a)) ∧
    (∀ (Ψ : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (A : Matrix (Fin N) (Fin N) ℚ_[ℓ]),
      (∀ (l : Fin N) (i : Fin (2 * k) → Fin r),
        ∑ j : Fin (2 * k) → Fin r, T l j * ∏ a, Ψ (j a) (i a) = ∑ l', A l' l * T l' i) →
      ∀ (l : Fin N) (i : Fin (2 * k) → Fin r), ∑ j : Fin (2 * k) → Fin r,
          (∑ j' : Fin (2 * k) → Fin r, T l j' * ∏ a, P (j' a) (j a)) * ∏ a, (P' * Ψ * P) (j a) (i a) =
        ∑ l', A l' l * ∑ j' : Fin (2 * k) → Fin r, T l' j' * ∏ a, P (j' a) (i a)) ∧
    (∀ (U : (Fin (2 * k) → Fin r) → ℚ_[ℓ]) (s : Matrix (Fin r) (Fin r) ℚ_[ℓ])
      (S : Set (Matrix (Fin r) (Fin r) ℚ_[ℓ])),
      (∀ g ∈ S, ∀ i : Fin (2 * k) → Fin r,
        ∑ j : Fin (2 * k) → Fin r, U j * ∏ a, g (j a) (i a) = U i) →
      (∀ t' : ℕ, ∃ g ∈ S, ∀ a a', ‖g a a' - s a a'‖ ≤ (ℓ : ℝ) ^ (-(t' : ℤ))) →
      ∀ i : Fin (2 * k) → Fin r, ∑ j : Fin (2 * k) → Fin r, U j * ∏ a, s (j a) (i a) = U i) :=
by
  classical

  have hmul : ∀ (g h : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (U : (Fin (2 * k) → Fin r) → ℚ_[ℓ])
      (i : Fin (2 * k) → Fin r),
      ∑ j : Fin (2 * k) → Fin r, (∑ j' : Fin (2 * k) → Fin r, U j' * ∏ a, g (j' a) (j a)) *
          ∏ a, h (j a) (i a) =
        ∑ j' : Fin (2 * k) → Fin r, U j' * ∏ a, (g * h) (j' a) (i a) := by
    intro g h U i
    have key : ∀ j' : Fin (2 * k) → Fin r, ∏ a, (g * h) (j' a) (i a) =
        ∑ j : Fin (2 * k) → Fin r, (∏ a, g (j' a) (j a)) * ∏ a, h (j a) (i a) := by
      intro j'
      simp only [Matrix.mul_apply]
      rw [Fintype.prod_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [Finset.prod_mul_distrib]
    simp only [key, Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun j' _ => ?_))
    ring

  have hone : ∀ (U : (Fin (2 * k) → Fin r) → ℚ_[ℓ]) (i : Fin (2 * k) → Fin r),
      ∑ j : Fin (2 * k) → Fin r, U j * ∏ a, (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (j a) (i a) = U i := by
    intro U i
    rw [Fintype.sum_eq_single i]
    · simp [Matrix.one_apply_eq]
    · intro j hj
      obtain ⟨a, ha⟩ := Function.ne_iff.mp hj
      apply mul_eq_zero_of_right
      exact Finset.prod_eq_zero (i := a) (Finset.mem_univ a)
        (Matrix.one_apply_ne (α := ℚ_[ℓ]) ha)

  have hlin : ∀ (c : Fin N → ℚ_[ℓ]) (V : Fin N → (Fin (2 * k) → Fin r) → ℚ_[ℓ])
      (w : (Fin (2 * k) → Fin r) → ℚ_[ℓ]),
      ∑ j, (∑ l, c l * V l j) * w j = ∑ l, c l * ∑ j, V l j * w j := by
    intro c V w
    simp only [Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun _ _ => Finset.sum_congr rfl (fun _ _ => by ring))

  have hconj : ∀ (X : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (U : (Fin (2 * k) → Fin r) → ℚ_[ℓ])
      (i : Fin (2 * k) → Fin r),
      ∑ j : Fin (2 * k) → Fin r, (∑ j' : Fin (2 * k) → Fin r, U j' * ∏ a, P (j' a) (j a)) *
          ∏ a, (P' * X * P) (j a) (i a) =
        ∑ j : Fin (2 * k) → Fin r, (∑ j' : Fin (2 * k) → Fin r, U j' * ∏ a, X (j' a) (j a)) *
          ∏ a, P (j a) (i a) := by
    intro X U i
    rw [hmul, hmul]
    have e : P * (P' * X * P) = X * P := by
      rw [← Matrix.mul_assoc, ← Matrix.mul_assoc, hPP', Matrix.one_mul]
    rw [e]
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro hT
    rw [Fintype.linearIndependent_iff] at hT ⊢
    intro c hc
    apply hT c
    funext i₀
    have hc' : ∀ i : Fin (2 * k) → Fin r, ∑ l, c l * ∑ j, T l j * ∏ a, P (j a) (i a) = 0 := by
      intro i
