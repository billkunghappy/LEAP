          exact c7b _ l (hinv l h hh))
        (fun t' => by
          obtain ⟨h, hh, hclose⟩ := happrox s hs1 hs2 hs3 t'
          exact ⟨_, ⟨h, hh, rfl⟩, hclose⟩) i
    · exact c7c _ A hA

theorem wc_tensor_invariant_block_transvection_transfer (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (r t k m : ℕ)
    (b : Fin r → Fin t) (J : Matrix (Fin r) (Fin r) ℚ_[ℓ]) (hJ : J.transpose = -J)
    (hJb : ∀ p q, b p ≠ b q → J p q = 0)
    (T : (Fin (2 * k) → Fin r) → ℚ_[ℓ])
    (hT : ∀ s : Matrix (Fin r) (Fin r) ℚ_[ℓ], s.transpose * J * s = J →
      (∀ p q, b p ≠ b q → s p q = 0) →
      (∀ a a', ‖s a a' - (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a a'‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ))) →
      ∀ i, ∑ j, T j * ∏ a, s (j a) (i a) = T i)
    (γ : Fin t) (v : Fin r → AlgebraicClosure ℚ_[ℓ]) (hv : ∀ p, b p ≠ γ → v p = 0)
    (c : AlgebraicClosure ℚ_[ℓ]) :
    ∀ i, ∑ j, algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) (T j) *
        ∏ a, ((1 : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ])) +
          c • Matrix.vecMulVec v
            (Matrix.vecMul v (J.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))))) (j a) (i a) =
      algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) (T i) :=
by
  classical
  intro i

  set Q : MvPolynomial (Option (Fin r)) ℚ_[ℓ] := ∑ j : Fin (2 * k) → Fin r,
      MvPolynomial.C (T j) * ∏ a : Fin (2 * k),
        ((if j a = i a then (1 : MvPolynomial (Option (Fin r)) ℚ_[ℓ]) else 0) +
          MvPolynomial.X none *
            ((if b (j a) = γ then (MvPolynomial.X (some (j a)) :
                MvPolynomial (Option (Fin r)) ℚ_[ℓ]) else 0) *
              ∑ y : Fin r, (if b y = γ then (MvPolynomial.X (some y) :
                MvPolynomial (Option (Fin r)) ℚ_[ℓ]) else 0) * MvPolynomial.C (J y (i a))))
    with hQdef

  have s2 : ∀ (A : Type) [CommRing A] [Algebra ℚ_[ℓ] A] (c₁ : A) (v₁ : Fin r → A),
      MvPolynomial.aeval (fun o : Option (Fin r) => o.elim c₁ v₁) Q =
      ∑ j : Fin (2 * k) → Fin r, algebraMap ℚ_[ℓ] A (T j) * ∏ a : Fin (2 * k),
        ((1 : Matrix (Fin r) (Fin r) A) +
          c₁ • Matrix.vecMulVec (fun y => if b y = γ then v₁ y else 0)
            (Matrix.vecMul (fun y => if b y = γ then v₁ y else 0)
              (J.map (algebraMap ℚ_[ℓ] A)))) (j a) (i a) := by
    intro A _ _ c₁ v₁
    have hm : ∀ y, MvPolynomial.aeval (fun o : Option (Fin r) => o.elim c₁ v₁)
        (if b y = γ then (MvPolynomial.X (some y) : MvPolynomial (Option (Fin r)) ℚ_[ℓ])
          else 0) = if b y = γ then v₁ y else 0 := by
      intro y
      split_ifs <;> simp
    rw [hQdef]
    simp only [map_sum, map_mul, map_prod, MvPolynomial.aeval_C]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    congr 1
    refine Finset.prod_congr rfl (fun a _ => ?_)
    simp only [map_add, map_mul, map_sum, MvPolynomial.aeval_C, MvPolynomial.aeval_X, hm,
      Option.elim_none, Matrix.add_apply, Matrix.one_apply, Matrix.smul_apply,
      Matrix.vecMulVec_apply, Matrix.vecMul, dotProduct, Matrix.map_apply, smul_eq_mul]
    split_ifs <;> simp

  have s1 : ∀ (c₀ : ℚ_[ℓ]) (v₀ : Fin r → ℚ_[ℓ]),
      (1 + c₀ • Matrix.vecMulVec v₀ (Matrix.vecMul v₀ J)).transpose * J *
        (1 + c₀ • Matrix.vecMulVec v₀ (Matrix.vecMul v₀ J)) = J := by
    intro c₀ v₀
    set w := Matrix.vecMul v₀ J with hw
    have ha : J.mulVec v₀ = -w := by
      have h0 : J.transpose.mulVec v₀ = w := Matrix.mulVec_transpose J v₀
      rw [hJ, Matrix.neg_mulVec] at h0
      rw [← h0, neg_neg]
    have hd : w ⬝ᵥ v₀ = 0 := by
      have h1 : v₀ ⬝ᵥ J.mulVec v₀ = w ⬝ᵥ v₀ := Matrix.dotProduct_mulVec v₀ J v₀
      rw [ha, dotProduct_neg, dotProduct_comm] at h1
      have h2 : (2 : ℚ_[ℓ]) * (w ⬝ᵥ v₀) = 0 := by linear_combination -h1
      rcases mul_eq_zero.mp h2 with h | h
      · norm_num at h
      · exact h
    have hXJ : Matrix.vecMulVec w v₀ * J = Matrix.vecMulVec w w := by
      rw [Matrix.vecMulVec_mul]
    have hJY : J * Matrix.vecMulVec v₀ w = -Matrix.vecMulVec w w := by
      rw [Matrix.mul_vecMulVec, ha]
      ext p q
      simp [Matrix.vecMulVec_apply]
    have hWY : Matrix.vecMulVec w w * Matrix.vecMulVec v₀ w = 0 := by
      ext p q
      simp only [Matrix.mul_apply, Matrix.vecMulVec_apply, Matrix.zero_apply]
      have : ∑ x, w p * w x * (v₀ x * w q) = w p * (w ⬝ᵥ v₀) * w q := by
        simp only [dotProduct, Finset.mul_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun x _ => ?_)
        ring
      rw [this, hd, mul_zero, zero_mul]
    rw [Matrix.transpose_add, Matrix.transpose_one, Matrix.transpose_smul,
      Matrix.transpose_vecMulVec]
    calc (1 + c₀ • Matrix.vecMulVec w v₀) * J * (1 + c₀ • Matrix.vecMulVec v₀ w)
        = J + c₀ • (Matrix.vecMulVec w v₀ * J) + c₀ • (J * Matrix.vecMulVec v₀ w)
          + (c₀ * c₀) • (Matrix.vecMulVec w v₀ * J * Matrix.vecMulVec v₀ w) := by
          simp only [Matrix.add_mul, Matrix.mul_add, Matrix.one_mul, Matrix.mul_one,
            Matrix.smul_mul, Matrix.mul_smul, smul_add, smul_smul]
          abel
      _ = J := by
          rw [hXJ, hJY, hWY, smul_neg, smul_zero, add_zero, add_neg_cancel_right]

  have s3 : ∃ M : ℕ, ∀ (c₀ : ℚ_[ℓ]) (v₀ : Fin r → ℚ_[ℓ]),
      ‖c₀‖ ≤ (ℓ : ℝ) ^ (-(M : ℤ)) → (∀ x, ‖v₀ x‖ ≤ 1) →
      ∀ a b, ‖(1 + c₀ • Matrix.vecMulVec v₀ (Matrix.vecMul v₀ J)) a b -
        (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b‖ ≤ (ℓ : ℝ) ^ (-(m : ℤ)) := by
    have hℓ1 : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
    set C : ℝ := ∑ y : Fin r, ∑ b : Fin r, ‖J y b‖ with hC
    obtain ⟨N, hN⟩ := pow_unbounded_of_one_lt C hℓ1
    refine ⟨m + N, fun c₀ v₀ hc hv a b => ?_⟩
    have hent : (1 + c₀ • Matrix.vecMulVec v₀ (Matrix.vecMul v₀ J)) a b -
        (1 : Matrix (Fin r) (Fin r) ℚ_[ℓ]) a b = c₀ * (v₀ a * ∑ y, v₀ y * J y b) := by
      simp [Matrix.vecMulVec_apply, Matrix.vecMul, dotProduct]
    rw [hent, norm_mul, norm_mul]
    have h1 : ‖∑ y, v₀ y * J y b‖ ≤ C := by
      calc ‖∑ y, v₀ y * J y b‖ ≤ ∑ y, ‖v₀ y * J y b‖ := norm_sum_le _ _
        _ ≤ ∑ y, ∑ b', ‖J y b'‖ := by
          apply Finset.sum_le_sum
          intro y _
          rw [norm_mul]
          calc ‖v₀ y‖ * ‖J y b‖ ≤ 1 * ‖J y b‖ :=
                mul_le_mul_of_nonneg_right (hv y) (norm_nonneg _)
            _ = ‖J y b‖ := one_mul _
            _ ≤ ∑ b', ‖J y b'‖ :=
                Finset.single_le_sum (f := fun b' => ‖J y b'‖)
                  (fun _ _ => norm_nonneg _) (Finset.mem_univ b)
    have hpos : (0 : ℝ) < ℓ := by linarith
    calc ‖c₀‖ * (‖v₀ a‖ * ‖∑ y, v₀ y * J y b‖)
        ≤ (ℓ : ℝ) ^ (-((m + N : ℕ) : ℤ)) * (1 * (ℓ : ℝ) ^ N) := by
          apply mul_le_mul hc _ (by positivity) (by positivity)
          exact mul_le_mul (hv a) (h1.trans hN.le) (norm_nonneg _) zero_le_one
      _ = (ℓ : ℝ) ^ (-(m : ℤ)) := by
          rw [one_mul, ← zpow_natCast, ← zpow_add₀ hpos.ne']
          congr 1
          push_cast
          ring

  have s4 : ∀ M : ℕ, ∃ S : Set ℚ_[ℓ], S.Infinite ∧
      ∀ z ∈ S, ‖z‖ ≤ (ℓ : ℝ) ^ (-(M : ℤ)) ∧ ‖z‖ ≤ 1 := by
    intro M
    refine ⟨Set.range (fun n : ℕ => (ℓ : ℚ_[ℓ]) ^ (M + n)), ?_, ?_⟩
    · apply Set.infinite_range_of_injective
      intro n₁ n₂ h
      have h' : ((ℓ ^ (M + n₁) : ℕ) : ℚ_[ℓ]) = ((ℓ ^ (M + n₂) : ℕ) : ℚ_[ℓ]) := by
        push_cast
        exact h
      have := Nat.pow_right_injective (Fact.out : ℓ.Prime).two_le (Nat.cast_injective h')
      omega
    · rintro z ⟨n, rfl⟩
      rw [Padic.norm_p_pow]
      have hℓ1 : (1 : ℝ) ≤ ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt.le
      constructor
      · apply zpow_le_zpow_right₀ hℓ1
        push_cast
        omega
      · calc (ℓ : ℝ) ^ (-((M + n : ℕ) : ℤ)) ≤ (ℓ : ℝ) ^ (0 : ℤ) :=
              zpow_le_zpow_right₀ hℓ1 (by omega)
          _ = 1 := zpow_zero _

  have s5 : ∀ (c₀ : ℚ_[ℓ]) (v₀ : Fin r → ℚ_[ℓ]), (∀ p, b p ≠ γ → v₀ p = 0) →
      ∀ p q, b p ≠ b q → (1 + c₀ • Matrix.vecMulVec v₀ (Matrix.vecMul v₀ J)) p q = 0 := by
    intro c₀ v₀ hv₀ p q hpq
    have hpq' : p ≠ q := fun h => hpq (congrArg b h)
    rw [Matrix.add_apply, Matrix.one_apply_ne hpq', zero_add, Matrix.smul_apply,
      Matrix.vecMulVec_apply, smul_eq_mul]
    by_cases hp : b p = γ
    · have hsum : Matrix.vecMul v₀ J q = 0 := by
        simp only [Matrix.vecMul, dotProduct]
        apply Finset.sum_eq_zero
        intro y _
        by_cases hy : b y = γ
        · rw [hJb y q (by rw [hy, ← hp]; exact hpq), mul_zero]
        · rw [hv₀ y hy, zero_mul]
      rw [hsum, mul_zero, mul_zero]
    · rw [hv₀ p hp, zero_mul, mul_zero]

  obtain ⟨M, hM⟩ := s3
  obtain ⟨S, hSinf, hS⟩ := s4 M
  have hQ : Q = MvPolynomial.C (T i) := by
    apply MvPolynomial.funext_set (fun _ => S) (fun _ => hSinf)
    intro x hx
    have hx' : ∀ o, x o ∈ S := fun o => Set.mem_univ_pi.mp hx o
    rw [MvPolynomial.eval_C, ← MvPolynomial.coe_aeval_eq_eval]
    show MvPolynomial.aeval x Q = T i
    have hxe : x = fun o : Option (Fin r) => o.elim (x none) (fun y => x (some y)) := by
      funext o
      cases o <;> rfl
    have key : MvPolynomial.aeval x Q =
        MvPolynomial.aeval (fun o : Option (Fin r) => o.elim (x none) (fun y => x (some y))) Q :=
      congrArg (fun f => MvPolynomial.aeval f Q) hxe
    rw [key, s2 ℚ_[ℓ] (x none) (fun y => x (some y))]
    have hJid : J.map (algebraMap ℚ_[ℓ] ℚ_[ℓ]) = J := by
      ext a b
      simp
    rw [hJid]
    simp only [Algebra.algebraMap_self, RingHom.id_apply]
    apply hT
    · exact s1 _ _
    · exact s5 _ _ (fun p hp => if_neg hp)
    · refine hM _ _ (hS _ (hx' none)).1 (fun y => ?_)
      by_cases hy : b y = γ
      · rw [if_pos hy]
        exact (hS _ (hx' (some y))).2
      · rw [if_neg hy, norm_zero]
        exact zero_le_one
  have hfin := congrArg (MvPolynomial.aeval (fun o : Option (Fin r) => o.elim c v)) hQ
  rw [s2 (AlgebraicClosure ℚ_[ℓ]) c v, MvPolynomial.aeval_C] at hfin
  have hmask : (fun y => if b y = γ then v y else 0) = v := by
    funext y
    split_ifs with h
    · rfl
    · exact (hv y h).symm
  rw [hmask] at hfin
  exact hfin

theorem wc_symplectic_transvection_generation (K : Type*) [Field K] [CharZero K] (r : ℕ)
    (J : Matrix (Fin r) (Fin r) K) (hJ : J.transpose = -J) (hdet : IsUnit J.det)
    (s : Matrix (Fin r) (Fin r) K) (hs : s.transpose * J * s = J) :
    ∃ L : List (Matrix (Fin r) (Fin r) K),
      (∀ t ∈ L, ∃ (v : Fin r → K) (c : K), t = 1 + c • Matrix.vecMulVec v (Matrix.vecMul v J)) ∧
      s = L.prod :=
by
  classical

  obtain ⟨B, hB⟩ : ∃ B : (Fin r → K) → (Fin r → K) → K,
      ∀ x u, B x u = Matrix.vecMul x J ⬝ᵥ u := ⟨_, fun _ _ => rfl⟩

  obtain ⟨τ, hτ⟩ : ∃ τ : (Fin r → K) → K → Matrix (Fin r) (Fin r) K,
      ∀ v c, τ v c = 1 + c • Matrix.vecMulVec v (Matrix.vecMul v J) := ⟨_, fun _ _ => rfl⟩
  have Badd_l : ∀ x y u, B (x + y) u = B x u + B y u := fun x y u => by
    simp only [hB, Matrix.add_vecMul, add_dotProduct]
  have Badd_r : ∀ x u v, B x (u + v) = B x u + B x v := fun x u v => by
    simp only [hB, dotProduct_add]
  have Bsub_l : ∀ x y u, B (x - y) u = B x u - B y u := fun x y u => by
    simp only [hB, Matrix.sub_vecMul, sub_dotProduct]
  have Bsmul_l : ∀ (a : K) x u, B (a • x) u = a * B x u := fun a x u => by
    simp only [hB, Matrix.smul_vecMul, smul_dotProduct, smul_eq_mul]
  have Bsmul_r : ∀ (a : K) x u, B x (a • u) = a * B x u := fun a x u => by
    simp only [hB, dotProduct_smul, smul_eq_mul]
  have Banti : ∀ x u, B x u = -B u x := by
    intro x u
    rw [hB, hB, ← Matrix.dotProduct_mulVec, ← Matrix.vecMul_transpose, hJ, Matrix.vecMul_neg,
      dotProduct_neg, dotProduct_comm]
  have Bself : ∀ x, B x x = 0 := by
    intro x
    have h := Banti x x
    have h2 : (2 : K) * B x x = 0 := by linear_combination h
    exact (mul_eq_zero.mp h2).resolve_left two_ne_zero
  have τapp : ∀ v c u, (τ v c).mulVec u = u + (c * B v u) • v := by
    intro v c u
    rw [hτ, Matrix.add_mulVec, Matrix.one_mulVec, Matrix.smul_mulVec, Matrix.vecMulVec_mulVec, hB]
    ext i
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, op_smul_eq_mul]
    ring
  have τinv : ∀ v c, τ v c * τ v (-c) = 1 := by
    intro v c
    apply Matrix.ext_of_mulVec_single
    intro i
    rw [← Matrix.mulVec_mulVec, τapp, τapp, Badd_r, Bsmul_r, Bself, Matrix.one_mulVec]
    ext j
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    ring

  have Pmul : ∀ M N : Matrix (Fin r) (Fin r) K,
      (∀ x u, B (M.mulVec x) (M.mulVec u) = B x u) →
      (∀ x u, B (N.mulVec x) (N.mulVec u) = B x u) →
      ∀ x u, B ((M * N).mulVec x) ((M * N).mulVec u) = B x u := by
    intro M N hM hN x u
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, hM, hN]
  have Pτ : ∀ v c x u, B ((τ v c).mulVec x) ((τ v c).mulVec u) = B x u := by
    intro v c x u
    rw [τapp, τapp]
    simp only [Badd_l, Badd_r, Bsmul_l, Bsmul_r, Bself]
    linear_combination (c * B v u) * Banti x v
  have Ps : ∀ x u, B (s.mulVec x) (s.mulVec u) = B x u := by
    intro x u
    rw [hB, hB, ← Matrix.vecMul_transpose, Matrix.dotProduct_mulVec, Matrix.vecMul_vecMul,
      Matrix.vecMul_vecMul, ← Matrix.mul_assoc, hs]

  have dual : ∀ k : Fin r, ∃ a : Fin r → K, ∀ u, B a u = u k := by
    intro k
    refine ⟨Matrix.vecMul (Pi.single k 1) J⁻¹, fun u => ?_⟩
    rw [hB, Matrix.vecMul_vecMul, Matrix.nonsing_inv_mul J hdet, Matrix.vecMul_one,
      single_one_dotProduct]

  have R : ∀ n : ℕ, ∀ s : Matrix (Fin r) (Fin r) K,
      (∀ x u, B (s.mulVec x) (s.mulVec u) = B x u) →
      (∀ i : Fin r, n ≤ i.val → s.mulVec (Pi.single i 1) = Pi.single i 1) →
      ∃ L : List (Matrix (Fin r) (Fin r) K), (∀ t ∈ L, ∃ (v : Fin r → K) (c : K), t = τ v c) ∧
        s = L.prod := by
    intro n
    induction n with
    | zero =>
      intro s _ hfix
      refine ⟨[], by simp, ?_⟩
      rw [List.prod_nil]
      apply Matrix.ext_of_mulVec_single
      intro i
      rw [hfix i (Nat.zero_le _), Matrix.one_mulVec]
    | succ n ih =>
      intro s hsP hfix
      by_cases hnr : r ≤ n
      · exact ih s hsP (fun i hi => absurd i.isLt (by omega))
      have hnr' : n < r := by omega
      obtain ⟨k, hk⟩ : ∃ k : Fin r, k.val = n := ⟨⟨n, hnr'⟩, rfl⟩
      obtain ⟨a, ha⟩ := dual k
      obtain ⟨x, hx⟩ : ∃ x : Fin r → K, x = Pi.single k 1 := ⟨_, rfl⟩
      obtain ⟨y, hy⟩ : ∃ y : Fin r → K, y = s.mulVec x := ⟨_, rfl⟩
      obtain ⟨b, hb⟩ : ∃ b : Fin r → K, b = s.mulVec a := ⟨_, rfl⟩
      have hne : ∀ i : Fin r, n + 1 ≤ i.val → k ≠ i := by
        intro i hi hki
        rw [← hki] at hi
        omega
      have haI : ∀ i : Fin r, n + 1 ≤ i.val → B a (Pi.single i 1) = 0 := by
        intro i hi
        rw [ha]
        exact Pi.single_eq_of_ne (hne i hi) _
      have hbI : ∀ i : Fin r, n + 1 ≤ i.val → B b (Pi.single i 1) = 0 := by
        intro i hi
        have h1 := hsP a (Pi.single i 1)
        rw [hfix i (by omega)] at h1
        rw [hb, h1]
        exact haI i hi
      have hax : B a x = 1 := by
        rw [ha, hx]
        exact Pi.single_eq_same _ _
      have hby : B b y = 1 := by
        rw [hb, hy, hsP]
        exact hax

      obtain ⟨p, q, hp1, hp2⟩ : ∃ p q : K, p + q * B b x ≠ 0 ∧
          B y x - p * B a y - q ≠ 0 := by
        by_cases hα : B a y = 0
        · refine ⟨1 - (B y x + 1) * B b x, B y x + 1, ?_, ?_⟩
          · have e : 1 - (B y x + 1) * B b x + (B y x + 1) * B b x = 1 := by ring
            rw [e]
            exact one_ne_zero
          · have e : B y x - (1 - (B y x + 1) * B b x) * B a y - (B y x + 1) = -1 := by
              rw [hα]; ring
            rw [e]
            exact neg_ne_zero.mpr one_ne_zero
        · by_cases hγ : B y x = B a y
          · refine ⟨2, 0, ?_, ?_⟩
            · rw [zero_mul, add_zero]
              exact two_ne_zero
            · intro h
              apply hα
              linear_combination (-1 : K) * h + hγ
          · refine ⟨1, 0, ?_, ?_⟩
            · rw [zero_mul, add_zero]
              exact one_ne_zero
            · intro h
              apply hγ
              linear_combination h
      obtain ⟨w, hw⟩ : ∃ w : Fin r → K, w = p • a + q • b := ⟨_, rfl⟩
      have hwx : B w x ≠ 0 := by
        rw [hw, Badd_l, Bsmul_l, Bsmul_l, hax, mul_one]
        exact hp1
      have hyz : B y (x + w) ≠ 0 := by
        have e : B y (x + w) = B y x - p * B a y - q := by
          rw [hw, Badd_r, Badd_r, Bsmul_r, Bsmul_r, Banti y a, Banti y b, hby]
          ring
        rw [e]
        exact hp2
      have hwI : ∀ i : Fin r, n + 1 ≤ i.val → B w (Pi.single i 1) = 0 := by
        intro i hi
        rw [hw, Badd_l, Bsmul_l, Bsmul_l, haI i hi, hbI i hi]
        ring
      obtain ⟨z, hz⟩ : ∃ z : Fin r → K, z = x + w := ⟨_, rfl⟩
      obtain ⟨v₂, hv₂⟩ : ∃ v₂ : Fin r → K, v₂ = y - z := ⟨_, rfl⟩
      rw [← hz] at hyz
      obtain ⟨c₁, hc₁⟩ : ∃ c₁ : K, c₁ = (B w x)⁻¹ := ⟨_, rfl⟩
      obtain ⟨c₂, hc₂⟩ : ∃ c₂ : K, c₂ = (B y z)⁻¹ := ⟨_, rfl⟩
      obtain ⟨h, hh⟩ : ∃ h : Matrix (Fin r) (Fin r) K, h = τ w (-c₁) * τ v₂ (-c₂) := ⟨_, rfl⟩
      have hhP : ∀ x u, B (h.mulVec x) (h.mulVec u) = B x u := by
        rw [hh]
        exact Pmul _ _ (Pτ w (-c₁)) (Pτ v₂ (-c₂))
      have hhy : h.mulVec y = x := by
        have e1 : (τ v₂ (-c₂)).mulVec y = z := by
          rw [τapp]
          have e : -c₂ * B v₂ y = -1 := by
            rw [hv₂, Bsub_l, Bself, Banti z y, hc₂, zero_sub, neg_neg, neg_mul,
              inv_mul_cancel₀ hyz]
          rw [e, hv₂]
          ext j
          simp only [Pi.add_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul]
          ring
        have e2 : (τ w (-c₁)).mulVec z = x := by
          rw [τapp]
          have e : -c₁ * B w z = -1 := by
            rw [hz, Badd_r, Bself, add_zero, hc₁, neg_mul, inv_mul_cancel₀ hwx]
          rw [e, hz]
          ext j
          simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
          ring
        rw [hh, ← Matrix.mulVec_mulVec, e1, e2]
      have hhI : ∀ i : Fin r, n + 1 ≤ i.val → h.mulVec (Pi.single i 1) = Pi.single i 1 := by
        intro i hi
        have hyI : B y (Pi.single i 1) = B x (Pi.single i 1) := by
          rw [hy, ← hfix i (by omega), hsP, hfix i (by omega)]
        have hv₂I : B v₂ (Pi.single i 1) = 0 := by
          rw [hv₂, hz, Bsub_l, Badd_l, hyI, hwI i hi]
          ring
        rw [hh, ← Matrix.mulVec_mulVec, τapp v₂, hv₂I, mul_zero, zero_smul, add_zero, τapp w,
          hwI i hi, mul_zero, zero_smul, add_zero]
      obtain ⟨L', hL'1, hL'2⟩ := ih (h * s) (Pmul _ _ hhP hsP) (by
        intro i hi
        rcases Nat.lt_or_ge n i.val with hlt | hge
        · rw [← Matrix.mulVec_mulVec, hfix i (by omega), hhI i (by omega)]
        · have hik : i = k := Fin.ext (by omega)
          rw [hik, ← hx, ← Matrix.mulVec_mulVec, ← hy, hhy])
      refine ⟨τ v₂ c₂ :: τ w c₁ :: L', ?_, ?_⟩
      · intro t ht
        rcases List.mem_cons.mp ht with ht | ht
        · exact ⟨v₂, c₂, ht⟩
        rcases List.mem_cons.mp ht with ht | ht
        · exact ⟨w, c₁, ht⟩
        · exact hL'1 t ht
      · rw [List.prod_cons, List.prod_cons, ← hL'2, hh]
        rw [show τ v₂ c₂ * (τ w c₁ * (τ w (-c₁) * τ v₂ (-c₂) * s)) =
            τ v₂ c₂ * ((τ w c₁ * τ w (-c₁)) * τ v₂ (-c₂)) * s by simp only [mul_assoc]]
        rw [τinv, one_mul, τinv, one_mul]
  obtain ⟨L, hL1, hL2⟩ := R r s Ps (fun i hi => absurd i.isLt (by omega))
  refine ⟨L, fun t ht => ?_, hL2⟩
  obtain ⟨v, c, rfl⟩ := hL1 t ht
  exact ⟨v, c, hτ v c⟩

theorem wc_block_symplectic_transvection_generation (K : Type*) [Field K] (r t : ℕ)
    (b : Fin r → Fin t)
    (hgen : ∀ (d : ℕ) (M : Matrix (Fin d) (Fin d) K), M.transpose = -M → IsUnit M.det →
      ∀ s : Matrix (Fin d) (Fin d) K, s.transpose * M * s = M →
      ∃ L : List (Matrix (Fin d) (Fin d) K),
        (∀ x ∈ L, ∃ (u : Fin d → K) (c : K), x = 1 + c • Matrix.vecMulVec u (Matrix.vecMul u M)) ∧
        s = L.prod)
    (J : Matrix (Fin r) (Fin r) K) (hJ : J.transpose = -J) (hdet : IsUnit J.det)
    (hJb : ∀ p q, b p ≠ b q → J p q = 0)
    (s : Matrix (Fin r) (Fin r) K) (hs : s.transpose * J * s = J)
    (hsb : ∀ p q, b p ≠ b q → s p q = 0) :
    ∃ L : List (Matrix (Fin r) (Fin r) K),
      (∀ x ∈ L, ∃ (γ : Fin t) (v : Fin r → K) (c : K), (∀ p, b p ≠ γ → v p = 0) ∧
        x = 1 + c • Matrix.vecMulVec v (Matrix.vecMul v J)) ∧
      s = L.prod :=
by
  classical

  obtain ⟨S, hS⟩ : ∃ S : Fin t → Matrix (Fin r) (Fin r) K, ∀ γ p q,
      S γ p q = if b q = γ then s p q else (1 : Matrix (Fin r) (Fin r) K) p q :=
    ⟨fun γ => Matrix.of (fun p q => if b q = γ then s p q else (1 : Matrix (Fin r) (Fin r) K) p q),
      fun _ _ _ => rfl⟩

  have hprod : ((List.finRange t).map S).prod = s := by
    have key : ∀ l : List (Fin t), l.Nodup → (l.map S).prod =
        Matrix.of (fun p q => if b q ∈ l then s p q else (1 : Matrix (Fin r) (Fin r) K) p q) := by
      intro l
      induction l with
      | nil =>
        intro _
        ext p q
        simp
      | cons γ l ih =>
        intro hnd
        rw [List.nodup_cons] at hnd
        rw [List.map_cons, List.prod_cons, ih hnd.2]
        ext p q
        rw [Matrix.mul_apply]
        by_cases hq : b q ∈ l
        · have hterm : ∀ y, S γ p y * Matrix.of (fun p q => if b q ∈ l then s p q else
              (1 : Matrix (Fin r) (Fin r) K) p q) y q = (1 : Matrix (Fin r) (Fin r) K) p y * s y q := by
            intro y
            rw [Matrix.of_apply, if_pos hq, hS]
            by_cases hy : b y = b q
            · have hyγ : b y ≠ γ := fun h => hnd.1 (h ▸ hy ▸ hq)
              rw [if_neg hyγ]
            · rw [hsb y q hy, mul_zero, mul_zero]
          rw [Finset.sum_congr rfl (fun y _ => hterm y), ← Matrix.mul_apply, Matrix.one_mul,
            Matrix.of_apply, if_pos (List.mem_cons_of_mem γ hq)]
        · have hterm : ∀ y, S γ p y * Matrix.of (fun p q => if b q ∈ l then s p q else
              (1 : Matrix (Fin r) (Fin r) K) p q) y q = S γ p y * (1 : Matrix (Fin r) (Fin r) K) y q := by
            intro y
            rw [Matrix.of_apply, if_neg hq]
          rw [Finset.sum_congr rfl (fun y _ => hterm y), ← Matrix.mul_apply, Matrix.mul_one, hS,
            Matrix.of_apply]
          by_cases hqγ : b q = γ
          · rw [if_pos hqγ, if_pos (by rw [hqγ]; exact List.mem_cons_self)]
          · rw [if_neg hqγ, if_neg (by rw [List.mem_cons]; push_neg; exact ⟨hqγ, hq⟩)]
    rw [key _ (List.nodup_finRange t)]
    ext p q
    rw [Matrix.of_apply, if_pos (List.mem_finRange _)]

  have hblock : ∀ γ : Fin t, ∃ Lγ : List (Matrix (Fin r) (Fin r) K),
      (∀ x ∈ Lγ, ∃ (v : Fin r → K) (c : K), (∀ p, b p ≠ γ → v p = 0) ∧
        x = 1 + c • Matrix.vecMulVec v (Matrix.vecMul v J)) ∧ Lγ.prod = S γ := by
    intro γ
    obtain ⟨d, ε, hεinj, hεb, hεs⟩ : ∃ (d : ℕ) (ε : Fin d → Fin r), Function.Injective ε ∧
        (∀ i, b (ε i) = γ) ∧ ∀ p, b p = γ → ∃ k, ε k = p := by
      refine ⟨Fintype.card {p : Fin r // b p = γ},
        fun i => ((Fintype.equivFin {p : Fin r // b p = γ}).symm i).1, ?_, ?_, ?_⟩
      · intro i j h
        exact (Fintype.equivFin {p : Fin r // b p = γ}).symm.injective (Subtype.ext h)
      · intro i
        exact ((Fintype.equivFin {p : Fin r // b p = γ}).symm i).2
      · intro p hp
        exact ⟨Fintype.equivFin {p : Fin r // b p = γ} ⟨p, hp⟩, by simp⟩
    obtain ⟨P, hP⟩ : ∃ P : Matrix (Fin r) (Fin d) K, ∀ p i, P p i = if p = ε i then 1 else 0 :=
      ⟨Matrix.of (fun p i => if p = ε i then 1 else 0), fun _ _ => rfl⟩
    have hPtP : P.transpose * P = 1 := by
      ext i j
      rw [Matrix.mul_apply]
      simp only [Matrix.transpose_apply, hP]
      rcases eq_or_ne i j with rfl | hij
      · simp
      · simp [hεinj.eq_iff, hij, hij.symm]
    have hAP : ∀ {n : ℕ} (A : Matrix (Fin n) (Fin r) K) p i, (A * P) p i = A p (ε i) := by
      intro n A p i
      simp [Matrix.mul_apply, hP]
    have hPtA : ∀ {n : ℕ} (A : Matrix (Fin r) (Fin n) K) i q, (P.transpose * A) i q = A (ε i) q := by
      intro n A i q
      simp [Matrix.mul_apply, hP]
    have hPY : ∀ {n : ℕ} (Y : Matrix (Fin d) (Fin n) K) k j, (P * Y) (ε k) j = Y k j := by
      intro n Y k j
      simp [Matrix.mul_apply, hP, hεinj.eq_iff]
    have hPY0 : ∀ {n : ℕ} (Y : Matrix (Fin d) (Fin n) K) p j, b p ≠ γ → (P * Y) p j = 0 := by
      intro n Y p j hp
      have hne : ∀ i, p ≠ ε i := fun i h => hp (h ▸ hεb i)
      simp [Matrix.mul_apply, hP, hne]
    have hYPt : ∀ {n : ℕ} (Y : Matrix (Fin n) (Fin d) K) j k, (Y * P.transpose) j (ε k) = Y j k := by
      intro n Y j k
      simp [Matrix.mul_apply, hP, hεinj.eq_iff]
    have hYPt0 : ∀ {n : ℕ} (Y : Matrix (Fin n) (Fin d) K) j q, b q ≠ γ →
        (Y * P.transpose) j q = 0 := by
      intro n Y j q hq
      have hne : ∀ i, q ≠ ε i := fun i h => hq (h ▸ hεb i)
      simp [Matrix.mul_apply, hP, hne]
    have hPtAP : ∀ A : Matrix (Fin r) (Fin r) K, P.transpose * A * P = A.submatrix ε ε := by
      intro A
      ext i j
      rw [hAP, hPtA, Matrix.submatrix_apply]
    have hblk1 : ∀ A : Matrix (Fin r) (Fin r) K, (∀ p q, b p ≠ b q → A p q = 0) →
        A * P = P * (P.transpose * A * P) := by
      intro A hA
      ext p i
      rw [hAP, hPtAP]
      by_cases hp : b p = γ
      · obtain ⟨k, rfl⟩ := hεs p hp
        rw [hPY, Matrix.submatrix_apply]
      · rw [hPY0 _ _ _ hp, hA p (ε i) (by rw [hεb]; exact hp)]
    have hblk2 : ∀ A : Matrix (Fin r) (Fin r) K, (∀ p q, b p ≠ b q → A p q = 0) →
        P.transpose * A = P.transpose * A * P * P.transpose := by
      intro A hA
      ext i q
      rw [hPtA, hPtAP]
      by_cases hq : b q = γ
      · obtain ⟨k, rfl⟩ := hεs q hq
        rw [hYPt, Matrix.submatrix_apply]
      · rw [hYPt0 _ _ _ hq, hA (ε i) q (by rw [hεb]; exact Ne.symm hq)]

    have hM : (P.transpose * J * P).transpose = -(P.transpose * J * P) := by
      rw [Matrix.transpose_mul, Matrix.transpose_mul, Matrix.transpose_transpose, hJ]
      simp [Matrix.mul_assoc]
    have hMdet : IsUnit (P.transpose * J * P).det := by
      rw [isUnit_iff_ne_zero]
      intro h0
      obtain ⟨u, hu0, hu⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr h0
      apply isUnit_iff_ne_zero.mp hdet
      apply Matrix.exists_mulVec_eq_zero_iff.mp
      refine ⟨P.mulVec u, ?_, ?_⟩
      · intro h
        apply hu0
        have e1 : P.transpose.mulVec (P.mulVec u) = u := by
          rw [Matrix.mulVec_mulVec, hPtP, Matrix.one_mulVec]
        rw [← e1, h, Matrix.mulVec_zero]
      · rw [Matrix.mulVec_mulVec, hblk1 J hJb, ← Matrix.mulVec_mulVec, hu, Matrix.mulVec_zero]
    have h1 : P * (P.transpose * s * P) = s * P := (hblk1 s hsb).symm
    have h2 : (P.transpose * s * P).transpose * P.transpose = P.transpose * s.transpose := by
      rw [← Matrix.transpose_mul, h1, Matrix.transpose_mul]
    have hσ : (P.transpose * s * P).transpose * (P.transpose * J * P) * (P.transpose * s * P) =
        P.transpose * J * P := by
      calc (P.transpose * s * P).transpose * (P.transpose * J * P) * (P.transpose * s * P)
          = ((P.transpose * s * P).transpose * P.transpose) * J * (P * (P.transpose * s * P)) := by
            simp only [Matrix.mul_assoc]
        _ = P.transpose * (s.transpose * J * s) * P := by
            rw [h1, h2]
            simp only [Matrix.mul_assoc]
        _ = P.transpose * J * P := by rw [hs]
    obtain ⟨L, hL, hLs⟩ := hgen d (P.transpose * J * P) hM hMdet (P.transpose * s * P) hσ

    obtain ⟨E, hE⟩ : ∃ E : Matrix (Fin d) (Fin d) K →* Matrix (Fin r) (Fin r) K,
        ∀ X, E X = 1 + P * (X - 1) * P.transpose := by
      refine ⟨{ toFun := fun X => 1 + P * (X - 1) * P.transpose
                map_one' := by simp
                map_mul' := ?_ }, fun _ => rfl⟩
      intro X Y
      have hAB : P * (X - 1) * P.transpose * (P * (Y - 1) * P.transpose) =
          P * ((X - 1) * (Y - 1)) * P.transpose := by
        calc P * (X - 1) * P.transpose * (P * (Y - 1) * P.transpose)
            = P * (X - 1) * (P.transpose * P) * (Y - 1) * P.transpose := by
              simp only [Matrix.mul_assoc]
          _ = P * ((X - 1) * (Y - 1)) * P.transpose := by
            rw [hPtP, Matrix.mul_one]
            simp only [Matrix.mul_assoc]
      have hXY : X * Y - 1 = (X - 1) + (Y - 1) + (X - 1) * (Y - 1) := by noncomm_ring
      show 1 + P * (X * Y - 1) * P.transpose =
        (1 + P * (X - 1) * P.transpose) * (1 + P * (Y - 1) * P.transpose)
      rw [hXY, add_mul, mul_add, mul_add, one_mul, mul_one, one_mul, hAB, Matrix.mul_add,
        Matrix.mul_add, Matrix.add_mul, Matrix.add_mul]
      abel
    refine ⟨L.map E, ?_, ?_⟩
    · intro x hx
      rw [List.mem_map] at hx
      obtain ⟨y, hy, rfl⟩ := hx
      obtain ⟨u, c, rfl⟩ := hL y hy
      refine ⟨P.mulVec u, c, ?_, ?_⟩
      · intro p hp
        have hne : ∀ i, p ≠ ε i := fun i h => hp (h ▸ hεb i)
        simp [Matrix.mulVec, dotProduct, hP, hne]
      · rw [hE, add_sub_cancel_left, Matrix.mul_smul, Matrix.smul_mul, Matrix.mul_vecMulVec,
          Matrix.vecMulVec_mul, Matrix.vecMul_vecMul, ← hblk2 J hJb, ← Matrix.vecMul_vecMul,
          Matrix.vecMul_transpose]
    · rw [← map_list_prod, ← hLs]
      ext p q
      rw [hS, hE, Matrix.add_apply]
      by_cases hq : b q = γ
      · obtain ⟨k, rfl⟩ := hεs q hq
        rw [if_pos hq, hYPt, Matrix.mul_sub, Matrix.mul_one, h1, Matrix.sub_apply, hAP, hP,
          Matrix.one_apply]
        split_ifs <;> ring
      · rw [if_neg hq, hYPt0 _ _ _ hq, add_zero]
  choose Lf hLf hLp using hblock
  refine ⟨((List.finRange t).map Lf).flatten, ?_, ?_⟩
  · intro x hx
    rw [List.mem_flatten] at hx
    obtain ⟨l, hl, hxl⟩ := hx
    rw [List.mem_map] at hl
    obtain ⟨γ, _, rfl⟩ := hl
    obtain ⟨v, c, hv, hxv⟩ := hLf γ x hxl
    exact ⟨γ, v, c, hv, hxv⟩
  · rw [List.prod_flatten, List.map_map]
    have hmap : List.map (List.prod ∘ Lf) (List.finRange t) = (List.finRange t).map S :=
      List.map_congr_left (fun γ _ => hLp γ)
    rw [hmap, hprod]

theorem wc_pencil_VQ_tensor_moments_nm (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∀ k : ℕ, 1 ≤ k → ∃ (N : ℕ) (Hk : Multiset (AlgebraicClosure ℚ_[ℓ])), ∀ e : ℕ, 1 ≤ e →
      ∑ d ∈ e.divisors, ∑ x : Fin (wcPencilNp D d),
          (d : AlgebraicClosure ℚ_[ℓ]) *
            ((wcPencilLocIdx D ℓ hP d x).map (· ^ (e / d))).sum ^ (2 * k) =
        (N : AlgebraicClosure ℚ_[ℓ]) *
            ((Nat.card F'' : ℕ) : AlgebraicClosure ℚ_[ℓ]) ^ (e * (k * (n - 1) + 1)) -
          (Hk.map (· ^ e)).sum :=
by
  classical
  intro k hk
  obtain ⟨r, t, b, J, G, Φ, hJ, hdet, hJb, ⟨m, hG⟩, hΦb, hΦ, hall⟩ :=
    wc_pencil_VQ_block_monodromy_tensor_trace_nm F' F'' Y n hn hn2 D hNM ℓ hℓ hP hNI
  obtain ⟨N, T, A, Hk, hlin, hinv, hA, htr⟩ := hall k hk
  haveI : CharZero (AlgebraicClosure ℚ_[ℓ]) :=
    charZero_of_injective_algebraMap (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ])).injective
  set ι : ℚ_[ℓ] →+* AlgebraicClosure ℚ_[ℓ] := algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) with hι
  set μ : ℚ_[ℓ] := (Nat.card F'' : ℚ_[ℓ]) ^ (n - 1) with hμ

  have hprod : ∀ (g h : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ]))
      (U : (Fin (2 * k) → Fin r) → AlgebraicClosure ℚ_[ℓ]) (i : Fin (2 * k) → Fin r),
      ∑ j, U j * ∏ a, (g * h) (j a) (i a) =
        ∑ p : Fin (2 * k) → Fin r, (∑ j, U j * ∏ a, g (j a) (p a)) * ∏ a, h (p a) (i a) := by
    intro g h U i
    simp only [Matrix.mul_apply]
    simp only [Fintype.prod_sum, Finset.prod_mul_distrib, Finset.mul_sum, Finset.sum_mul]
    conv_lhs => rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun j _ => ?_))
    ring
  have hone : ∀ (U : (Fin (2 * k) → Fin r) → AlgebraicClosure ℚ_[ℓ]) (i : Fin (2 * k) → Fin r),
      ∑ j, U j * ∏ a, (1 : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ])) (j a) (i a) = U i := by
    intro U i
    rw [Fintype.sum_eq_single i]
    · simp [Matrix.one_apply_eq]
    · intro j hj
      obtain ⟨a, ha⟩ : ∃ a, j a ≠ i a := by
        by_contra h
        push_neg at h
        exact hj (funext h)
      have h1 : (1 : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ])) (j a) (i a) = 0 :=
        Matrix.one_apply_ne ha
      apply mul_eq_zero_of_right
      exact Finset.prod_eq_zero (Finset.mem_univ a) h1
  have hmulInv : ∀ (g h : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ]))
      (U : (Fin (2 * k) → Fin r) → AlgebraicClosure ℚ_[ℓ]),
      (∀ i, ∑ j, U j * ∏ a, g (j a) (i a) = U i) →
      (∀ i, ∑ j, U j * ∏ a, h (j a) (i a) = U i) →
      ∀ i, ∑ j, U j * ∏ a, (g * h) (j a) (i a) = U i := by
    intro g h U hg hh i
    rw [hprod]
    simp only [hg]
    exact hh i
  have hlist : ∀ (L : List (Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ])))
      (U : (Fin (2 * k) → Fin r) → AlgebraicClosure ℚ_[ℓ]),
      (∀ t ∈ L, ∀ i, ∑ j, U j * ∏ a, t (j a) (i a) = U i) →
      ∀ i, ∑ j, U j * ∏ a, L.prod (j a) (i a) = U i := by
    intro L U
    induction L with
    | nil =>
      intro _ i
      simp only [List.prod_nil]
      exact hone U i
    | cons t L ih =>
      intro hL i
      rw [List.prod_cons]
      exact hmulInv t L.prod U (hL t (by simp))
        (ih (fun t' ht' => hL t' (by simp [ht']))) i

  have hJ' : (J.map ι).transpose = -(J.map ι) := by
    ext a b
    have h := congrFun (congrFun hJ a) b
    simp only [Matrix.transpose_apply, Matrix.neg_apply] at h
    simp only [Matrix.transpose_apply, Matrix.neg_apply, Matrix.map_apply, h, map_neg]
  have hdet' : IsUnit (J.map ι).det := by
    have h := RingHom.map_det ι J
    rw [RingHom.mapMatrix_apply] at h
    rw [← h]
    exact hdet.map _
  have hJb' : ∀ p q, b p ≠ b q → (J.map ι) p q = 0 := by
    intro p q hpq
    rw [Matrix.map_apply, hJb p q hpq, map_zero]

  have hSp : ∀ l (s : Matrix (Fin r) (Fin r) (AlgebraicClosure ℚ_[ℓ])),
      s.transpose * J.map ι * s = J.map ι → (∀ p q, b p ≠ b q → s p q = 0) →
      ∀ i, ∑ j, ι (T l j) * ∏ a, s (j a) (i a) = ι (T l i) := by
    intro l s hs hsb
    obtain ⟨L, hL, rfl⟩ :=
      wc_block_symplectic_transvection_generation (AlgebraicClosure ℚ_[ℓ]) r t b
        (fun d M hM hMd s' hs' =>
          wc_symplectic_transvection_generation (AlgebraicClosure ℚ_[ℓ]) d M hM hMd s' hs')
        _ hJ' hdet' hJb' s hs hsb
    apply hlist L
    intro x hx
    obtain ⟨γ, v, c, hv, rfl⟩ := hL x hx
    exact wc_tensor_invariant_block_transvection_transfer ℓ r t k m b J hJ hJb (T l)
      (fun s hs hsb hsm i => hinv l s (hG s hs hsb hsm) i) γ v hv c

  have hq0 : (Nat.card F'' : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr Finite.card_pos.ne'
  have hμ0 : ι μ ≠ 0 := (map_ne_zero _).mpr (pow_ne_zero _ hq0)
  obtain ⟨c, hc⟩ := IsAlgClosed.exists_pow_nat_eq (ι μ) two_pos
  have hc0 : c ≠ 0 := by
    rintro rfl
    apply hμ0
    rw [← hc]
    ring
  have hΦ' : (Φ.map ι).transpose * J.map ι * Φ.map ι = ι μ • J.map ι := by
    rw [← Matrix.transpose_map, ← Matrix.map_mul, ← Matrix.map_mul, hΦ]
    ext a b
    simp [Matrix.map_apply, Matrix.smul_apply]
  have hsSp : (c⁻¹ • Φ.map ι).transpose * J.map ι * (c⁻¹ • Φ.map ι) = J.map ι := by
    rw [Matrix.transpose_smul, Matrix.smul_mul, Matrix.smul_mul, Matrix.mul_smul, hΦ', smul_smul,
      smul_smul]
    conv_rhs => rw [← one_smul (AlgebraicClosure ℚ_[ℓ]) (J.map ι)]
    congr 1
    rw [← hc]
    field_simp
  have hsb : ∀ p q, b p ≠ b q → (c⁻¹ • Φ.map ι) p q = 0 := by
    intro p q hpq
    rw [Matrix.smul_apply, Matrix.map_apply, hΦb p q hpq, map_zero, smul_zero]

  have hΦinv : ∀ l i, ∑ j, T l j * ∏ a, Φ (j a) (i a) = μ ^ k * T l i := by
    intro l i
    apply ι.injective
    have h1 := hSp l _ hsSp hsb i
    have h2 : ∀ j : Fin (2 * k) → Fin r, ∏ a, ι (Φ (j a) (i a)) =
        c ^ (2 * k) * ∏ a, (c⁻¹ • Φ.map ι) (j a) (i a) := by
      intro j
      simp only [Matrix.smul_apply, Matrix.map_apply, smul_eq_mul, Finset.prod_mul_distrib,
        Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      rw [← mul_assoc, ← mul_pow, mul_inv_cancel₀ hc0, one_pow, one_mul]
    simp only [map_sum, map_mul, map_prod, map_pow]
    rw [Finset.sum_congr rfl (fun j _ => by rw [h2 j])]
    rw [show (∑ j : Fin (2 * k) → Fin r, ι (T l j) *
          (c ^ (2 * k) * ∏ a, (c⁻¹ • Φ.map ι) (j a) (i a))) =
        c ^ (2 * k) * ∑ j : Fin (2 * k) → Fin r, ι (T l j) * ∏ a, (c⁻¹ • Φ.map ι) (j a) (i a) by
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl (fun j _ => by ring)]
    rw [h1, pow_mul, hc]

  have hAeq : A = μ ^ k • (1 : Matrix (Fin N) (Fin N) ℚ_[ℓ]) := by
    ext l' l
    have h0 := Fintype.linearIndependent_iff.mp hlin
      (fun l' => A l' l - μ ^ k * (1 : Matrix (Fin N) (Fin N) ℚ_[ℓ]) l' l) (by
        funext i
        have e2 : ∑ l', μ ^ k * (1 : Matrix (Fin N) (Fin N) ℚ_[ℓ]) l' l * T l' i =
            μ ^ k * T l i := by
          rw [Fintype.sum_eq_single l (fun l' hl' => by
            rw [Matrix.one_apply_ne hl', mul_zero, zero_mul]), Matrix.one_apply_eq, mul_one]
        simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply, sub_mul,
          Finset.sum_sub_distrib]
        rw [e2, ← hA l i, hΦinv l i, sub_self]) l'
    rw [Matrix.smul_apply, smul_eq_mul]
    exact sub_eq_zero.mp h0
  have htrace : ∀ e : ℕ, (A ^ e).trace = (μ ^ k) ^ e * (N : ℚ_[ℓ]) := by
    intro e
    rw [hAeq, smul_pow, one_pow, Matrix.trace_smul, Matrix.trace_one, Fintype.card_fin,
      smul_eq_mul]
  refine ⟨N, Hk, fun e he => ?_⟩
  rw [htr e he, htrace e, hμ]
  simp only [map_mul, map_pow, map_natCast]
  ring

theorem wc_pencil_VQ_trace_datum_nonisotropic (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n) (hNM : wcPencilNoMixed D)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F'')
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over F'').hom
          (Spec.map (CommRingCat.ofHom (algebraMap F'' (AlgebraicClosure F''))))))
    (β₀ : AlgebraicClosure ℚ_[ℓ])
    (hβ₀ : wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β₀)
    (hsq : β₀ ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n)) :
    ∃ (r : ℕ) (T : wcPureTraceData ℓ (Nat.card F'') (n - 1) r), β₀ ∈ T.H :=
by
  classical

  have hNI : ∃ β : AlgebraicClosure ℚ_[ℓ], wcIsEigen ℓ
      (fun c => wcCohGEnd F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1 (wcPencilVQScalar D ℓ hP c))
      (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1) β ∧
      β ^ 2 ≠ algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((Nat.card F'' : ℚ_[ℓ]) ^ n) :=
    ⟨β₀, hβ₀, hsq⟩
  obtain ⟨r₁, e₁, he₁, hmem⟩ := hβ₀
  obtain ⟨r, hloc, h0, h2⟩ := wc_pencil_VQ_nonisotropic_local F' F'' Y n hn hn2 D hNM ℓ hℓ hP hNI
  obtain ⟨hfinCP, hcount⟩ := wc_P1_closed_point_count F''

  have hpt : ∀ (d : ℕ) (i : Fin (wcPencilNp D d)), 1 ≤ d ∧
      wcPencilPt D d i ∈ wcP1ClosedPt F'' d ∧
      ∀ j, wcPencilPt D d i ≠ D.S j (IsLocalRing.closedPoint F'') := by
    intro d i
    have hpos : 0 < Nat.card (wcPencilOffS D d) := lt_of_le_of_lt (Nat.zero_le _) i.isLt
    obtain ⟨_, hfin⟩ := Nat.card_pos_iff.mp hpos
    have hmemS := ((@Finite.equivFin _ hfin).symm i).2
    have heq : wcPencilPt D d i = ((@Finite.equivFin _ hfin).symm i).1 := by
      rw [wcPencilPt, dif_pos hfin]
    rw [heq]
    obtain ⟨hd, hx, hS⟩ := hmemS
    exact ⟨Nat.one_le_iff_ne_zero.mpr hd, hx, hS⟩

  have hnp : ∀ e : ℕ, 1 ≤ e →
      ∑ d ∈ e.divisors, d * wcPencilNp D d ≤ Nat.card F'' ^ e + 1 := by
    intro e he
    rw [← hcount e he]
    apply Finset.sum_le_sum
    intro d hd
    have hd1 : 1 ≤ d := Nat.pos_of_mem_divisors hd
    haveI := (hfinCP d hd1).to_subtype
    apply Nat.mul_le_mul le_rfl
    exact Nat.card_le_card_of_injective
      (fun x : wcPencilOffS D d => (⟨x.1, x.2.2.1⟩ : wcP1ClosedPt F'' d))
      (fun a b h => Subtype.ext (congrArg Subtype.val h :))

  obtain ⟨Hm, hHm⟩ : ∃ Hm : Multiset (AlgebraicClosure ℚ_[ℓ]),
      Hm = (wcAddEquivMatrix e₁ (wcCohGFrob F'' (wcP1Over F'') hP (wcPencilVQ D ℓ hP) 1)).charpoly.aroots
          (AlgebraicClosure ℚ_[ℓ]) +
        ∑ j : Fin D.m, wcPencilLoc D ℓ hP (D.S j (IsLocalRing.closedPoint F'')) 1 := ⟨_, rfl⟩
  have hH : ∀ e : ℕ, 1 ≤ e →
      ∑ d ∈ e.divisors, ∑ i : Fin (wcPencilNp D d),
          (d : AlgebraicClosure ℚ_[ℓ]) * ((wcPencilLocIdx D ℓ hP d i).map (· ^ (e / d))).sum =
        -(Hm.map (· ^ e)).sum := by
    intro e he
    have h5 := wc_pencil_VQ_P1_trace_formula F' F'' Y n hn hn2 D ℓ hℓ hP hNI h0 h2 r₁ e₁ he₁ e he
    have hsum : ((∑ j : Fin D.m, wcPencilLoc D ℓ hP (D.S j (IsLocalRing.closedPoint F'')) 1).map
          (· ^ e)).sum =
        ∑ j : Fin D.m,
          ((wcPencilLoc D ℓ hP (D.S j (IsLocalRing.closedPoint F'')) 1).map (· ^ e)).sum :=
