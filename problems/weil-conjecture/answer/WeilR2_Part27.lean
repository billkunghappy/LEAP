  have hiter : ∀ j s z, Ψ ((⇑((wcTwSh (q' ≫ Uo.ι)
      (Set.range (fun i => S i (IsLocalRing.closedPoint K)))
      Γ α hα ℓ n r ρ).obj.map N.φ.op).hom)^[j] s) z = Ψ s (Φf^[j] z) :=
    iterLemma _ Φf (fun s z => Ψ s z) hΨF'
  have e2 : Φf^[e / d] z₀ = act g⁻¹ z₀ := by
    have hΦfun : Φf = ⇑(Limits.pullback.map N.V.hom (q' ≫ Uo.ι) N.V.hom (q' ≫ Uo.ι) N.φ.left
        (𝟙 V) (𝟙 _) (by rw [Category.comp_id]; exact (MorphismProperty.Over.w N.φ).symm) (by simp)) :=
      funext hΦf
    rw [hΦfun, hact]
