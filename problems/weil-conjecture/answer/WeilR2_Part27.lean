  let φ' : Fin N → (G.over (wcGeomPoint K (wcP1Over K) hP) ⟶
      (wcLadicSheaf (wcP1Over K).left ℓ).over (wcGeomPoint K (wcP1Over K) hP)) := fun l =>
    ∑ l', φl l' ≫ scal (B l' l)
  have htwist : ∀ l (X : Over (wcGeomPoint K (wcP1Over K) hP)),
