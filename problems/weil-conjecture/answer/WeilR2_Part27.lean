      congrArg (fun f => f.left) h1
    have h3 : ((wcProEtPullback p.left).map k.left).left ≫
        (Limits.pullback.fst V₂.left.hom p.left : Limits.pullback V₂.left.hom p.left ⟶ _) =
        (Limits.pullback.fst V₁.left.hom p.left :
          Limits.pullback V₁.left.hom p.left ⟶ _) ≫ k.left.left :=
      Limits.pullback.lift_fst _ _ _
    exact (Category.assoc _ _ _).trans ((congrArg (fun g => _ ≫ g) h3.symm).trans
      (((Category.assoc _ _ _).symm.trans (congrArg (fun g => g ≫ _) h2.symm)).trans
        (Category.assoc _ _ _)))
  have hs : ∀ {V₁ V₂ : Over (wcGeomPoint F Y hY)} (k : V₁ ⟶ V₂),
      ((wcSliceBC F p hX hY).map k).left.left ≫ ((wcSliceBC F p hX hY).obj V₂).hom.left =
        ((wcSliceBC F p hX hY).obj V₁).hom.left :=
    fun k => congrArg (fun f => f.left) (Over.w ((wcSliceBC F p hX hY).map k))
  have nat : ∀ {V₁ V₂ : Over (wcGeomPoint F Y hY)} (k : V₁ ⟶ V₂),
      (wcOverToSlice Y.left (wcGeomPoint F Y hY) ⋙ wcProEtBC pb).map k ≫ (β V₂).hom =
        (β V₁).hom ≫ (wcSliceBC F p hX hY ⋙ wcOverToSlice X.left (wcGeomPoint F X hX)).map k := by
    intro V₁ V₂ k
    have hc1 : ((wcProEtBC pb).map ((wcOverToSlice Y.left (wcGeomPoint F Y hY)).map k)).left ≫
        Limits.pullback.fst V₂.hom.left pb = Limits.pullback.fst V₁.hom.left pb ≫ k.left.left :=
      Limits.pullback.lift_fst _ _ _
    have hc2 : ((wcProEtBC pb).map ((wcOverToSlice Y.left (wcGeomPoint F Y hY)).map k)).left ≫
        Limits.pullback.snd V₂.hom.left pb = Limits.pullback.snd V₁.hom.left pb :=
      Limits.pullback.lift_snd _ _ _
    apply MorphismProperty.Over.Hom.ext
    show ((wcProEtBC pb).map ((wcOverToSlice Y.left (wcGeomPoint F Y hY)).map k)).left ≫
        (ι V₂).inv = (ι V₁).inv ≫ ((wcSliceBC F p hX hY).map k).left.left
    apply (Sq V₂).hom_ext
    · exact (Category.assoc _ _ _).trans ((congrArg (fun g => _ ≫ g) (hinv1 V₂)).trans
        (hc1.trans ((congrArg (fun g => g ≫ _) (hinv1 V₁)).symm.trans
          ((Category.assoc _ _ _).trans ((congrArg (fun g => _ ≫ g) (key k)).trans
            (Category.assoc _ _ _).symm)))))
    · exact (Category.assoc _ _ _).trans ((congrArg (fun g => _ ≫ g) (hinv2 V₂)).trans
        (hc2.trans ((hinv2 V₁).symm.trans ((congrArg (fun g => _ ≫ g) (hs k)).symm.trans
          (Category.assoc _ _ _).symm))))
  refine ⟨NatIso.ofComponents β nat, fun V => ?_⟩
  exact hinv1 V

theorem wc_modPull_slice_pushforward_iso (F : Type u) [Field F] {X Y : Over (Spec (.of F))} (p : X ⟶ Y)
    (hX : WeaklyEtale (Limits.pullback.fst X.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (hY : WeaklyEtale (Limits.pullback.fst Y.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    [(wcSliceBC F p hX hY).IsContinuous ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX))]
    [(wcOverToSlice X.left (wcGeomPoint F X hX)).IsContinuous
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX))
      (Scheme.ProEt.topology (wcGeomPoint F X hX).left)]
    [(wcOverToSlice Y.left (wcGeomPoint F Y hY)).IsContinuous
      ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      (Scheme.ProEt.topology (wcGeomPoint F Y hY).left)]
    (pb : wcXbar F X ⟶ wcXbar F Y) (D : wcHMPullData pb ℓ) (hD : wcHMPullCanonical D)
    (α : wcOverToSlice Y.left (wcGeomPoint F Y hY) ⋙ wcProEtBC pb ≅
        wcSliceBC F p hX hY ⋙ wcOverToSlice X.left (wcGeomPoint F X hX))
    (hα : ∀ V : Over (wcGeomPoint F Y hY),
        (α.hom.app V).left ≫ wcSliceProj F p hX hY V =
          Limits.pullback.fst ((wcOverToSlice Y.left (wcGeomPoint F Y hY)).obj V).hom pb) :
    Nonempty (SheafOfModules.pushforward.{u+1} (F := wcOverToSlice X.left (wcGeomPoint F X hX))
        (S := wcSliceRing F X hX ℓ) (R := wcRingSheaf (wcGeomPoint F X hX).left ℓ) (𝟙 _) ⋙
        SheafOfModules.pushforward.{u+1} (wcSliceRingMap F p hX hY ℓ) ≅
      @SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC pb) _ _ D.cont D.φ ⋙
        SheafOfModules.pushforward.{u+1} (F := wcOverToSlice Y.left (wcGeomPoint F Y hY))
          (S := wcSliceRing F Y hY ℓ) (R := wcRingSheaf (wcGeomPoint F Y hY).left ℓ) (𝟙 _)) :=
by
  classical
  haveI := D.cont
  haveI hG : (wcSliceBC F p hX hY ⋙ wcOverToSlice X.left (wcGeomPoint F X hX)).IsContinuous
      ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      (Scheme.ProEt.topology (wcGeomPoint F X hX).left) :=
    Functor.isContinuous_comp _ _ _ ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX)) _
  haveI hF : (wcOverToSlice Y.left (wcGeomPoint F Y hY) ⋙ wcProEtBC pb).IsContinuous
      ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      (Scheme.ProEt.topology (wcGeomPoint F X hX).left) :=
    @Functor.isContinuous_comp _ _ _ _ _ _ _ _
      ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      (Scheme.ProEt.topology (wcGeomPoint F Y hY).left)
      (Scheme.ProEt.topology (wcGeomPoint F X hX).left) inferInstance D.cont
  let ψX : wcSliceRing F X hX ℓ ⟶ ((wcOverToSlice X.left (wcGeomPoint F X hX)).sheafPushforwardContinuous
      RingCat.{u+1} ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX))
      (Scheme.ProEt.topology (wcGeomPoint F X hX).left)).obj (wcRingSheaf (wcGeomPoint F X hX).left ℓ) :=
    𝟙 _
  let ψY : wcSliceRing F Y hY ℓ ⟶ ((wcOverToSlice Y.left (wcGeomPoint F Y hY)).sheafPushforwardContinuous
      RingCat.{u+1} ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      (Scheme.ProEt.topology (wcGeomPoint F Y hY).left)).obj (wcRingSheaf (wcGeomPoint F Y hY).left ℓ) :=
    𝟙 _
  let φG : wcSliceRing F Y hY ℓ ⟶ ((wcSliceBC F p hX hY ⋙ wcOverToSlice X.left (wcGeomPoint F X hX)).sheafPushforwardContinuous
      RingCat.{u+1} ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      (Scheme.ProEt.topology (wcGeomPoint F X hX).left)).obj (wcRingSheaf (wcGeomPoint F X hX).left ℓ) :=
    wcSliceRingMap F p hX hY ℓ ≫ ((wcSliceBC F p hX hY).sheafPushforwardContinuous RingCat.{u+1}
      ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX))).map ψX
  let φF : wcSliceRing F Y hY ℓ ⟶ ((wcOverToSlice Y.left (wcGeomPoint F Y hY) ⋙ wcProEtBC pb).sheafPushforwardContinuous
      RingCat.{u+1} ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      (Scheme.ProEt.topology (wcGeomPoint F X hX).left)).obj (wcRingSheaf (wcGeomPoint F X hX).left ℓ) :=
    ψY ≫ ((wcOverToSlice Y.left (wcGeomPoint F Y hY)).sheafPushforwardContinuous RingCat.{u+1}
      ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      (Scheme.ProEt.topology (wcGeomPoint F Y hY).left)).map D.φ
  let τ := (@Functor.sheafPushforwardContinuousNatTrans _ _ _ _ _ _ α.hom RingCat.{u+1} _
    ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
    (Scheme.ProEt.topology (wcGeomPoint F X hX).left) hF hG).app
      (wcRingSheaf (wcGeomPoint F X hX).left ℓ)
  have hring : φG ≫ τ = φF := by
    apply Sheaf.hom_ext
    apply NatTrans.ext
    funext V
    induction V using Opposite.rec with
    | op V =>
    apply RingCat.hom_ext
    apply RingHom.ext
    intro s
    have hR := hD ((wcOverToSlice Y.left (wcGeomPoint F Y hY)).obj V) s
    let s' : C(↥V.left.left, ULift.{u+1} ℚ_[ℓ]) := s
    apply ContinuousMap.ext
    intro x
    refine Eq.trans ?_ (congrArg (fun h : C(↥(Limits.pullback
        ((wcOverToSlice Y.left (wcGeomPoint F Y hY)).obj V).hom pb), ULift.{u+1} ℚ_[ℓ]) => h x)
      hR).symm
    exact congrArg (fun f => s' (f.base x)) (hα V)
  have iSBC : (wcSliceBC F p hX hY).IsContinuous
      ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX)) := inferInstance
  have iOX : (wcOverToSlice X.left (wcGeomPoint F X hX)).IsContinuous
      ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX))
      (Scheme.ProEt.topology (wcGeomPoint F X hX).left) := inferInstance
  have iOY : (wcOverToSlice Y.left (wcGeomPoint F Y hY)).IsContinuous
      ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
      (Scheme.ProEt.topology (wcGeomPoint F Y hY).left) := inferInstance
  let i1 := @SheafOfModules.pushforwardComp _ _ _ _ _ _ _ _ _ _ _ iSBC
    (wcSliceRingMap F p hX hY ℓ) _ _ _ iOX ψX
  let i2 := @SheafOfModules.pushforwardNatIso _ _ _ _ _ _ _ _ _ _ hF hG φG α
  let i3 := @SheafOfModules.pushforwardCongr _ _ _ _ _ _ _ _ _ hF _ _ hring
  let i4 := @SheafOfModules.pushforwardComp _ _ _ _ _ _ _ _ _ _ _ iOY ψY _ _ _ D.cont D.φ
  exact ⟨i1 ≪≫ i2 ≪≫ i3 ≪≫ i4.symm⟩

theorem wc_modPull_hm_transport (F : Type u) [Field F] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ Θ : ∀ (Z : Over (Spec (.of F)))
        (hZ : WeaklyEtale (Limits.pullback.fst Z.hom
          (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) (n : ℕ),
        wcModCoh F Z hZ ℓ n ≃+ wcHM (wcXbar F Z) ℓ n,
      (∀ (Z : Over (Spec (.of F)))
          (hZ : WeaklyEtale (Limits.pullback.fst Z.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
          (i j k : ℕ) (hk : i + j = k) (x : wcModCoh F Z hZ ℓ i) (y : wcModCoh F Z hZ ℓ j),
          Θ Z hZ k (wcModCup F Z hZ ℓ i j k hk x y) =
            wcHMCup (wcXbar F Z) ℓ i j k hk (Θ Z hZ i x) (Θ Z hZ j y)) ∧
      (∀ (X Y : Over (Spec (.of F))) (p : X ⟶ Y)
          (hX : WeaklyEtale (Limits.pullback.fst X.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
          (hY : WeaklyEtale (Limits.pullback.fst Y.hom
            (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))))
          (pb : wcXbar F X ⟶ wcXbar F Y)
          (h1 : pb ≫ Limits.pullback.fst Y.hom
              (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
            Limits.pullback.fst X.hom
              (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫ p.left)
          (h2 : pb ≫ Limits.pullback.snd Y.hom
              (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
            Limits.pullback.snd X.hom
              (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
          (D : wcHMPullData pb ℓ) (hD : wcHMPullCanonical D),
          wcModPullOK F p hX hY ℓ →
          ∀ (n : ℕ) (u : wcModCoh F Y hY ℓ n),
            Θ X hX n (wcModPull F p hX hY ℓ n u) = wcHMPull D n (Θ Y hY n u)) :=
by
  classical
  have hmem : ∀ (T : Scheme.{u}) (V : T.ProEt) (R : Sieve V),
      R ∈ Scheme.ProEt.topology T V ↔
        Sieve.functorPushforward (Scheme.ProEt.forget T ⋙ Over.forget T) R ∈
          Scheme.proetaleTopology V.left := by
    intro T V R
    letI := MorphismProperty.IsMultiplicative.toIsStableUnderComposition (W := @WeaklyEtale)
    have hT : Scheme.ProEt.topology T =
        (Scheme.ProEt.forget T).restrictedTopology (Scheme.proetaleTopology.over T) :=
      MorphismProperty.toGrothendieck_comap_forget_eq_restrictedTopology (S := T)
        (P := @WeaklyEtale) Scheme.proetalePrecoverage
        Scheme.proetalePrecoverage_le_precoverage_weaklyEtale
    rw [hT, Functor.mem_restrictedTopology_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv_apply, ← Sieve.functorPushforward_comp]
    rfl
  have hmemD : ∀ (S : Scheme.{u}) (U : S.ProEt) (V : Over U) (R : Sieve V),
      R ∈ (Scheme.ProEt.topology S).over U V ↔
      Sieve.functorPushforward (Over.forget U ⋙ Scheme.ProEt.forget S ⋙ Over.forget S) R ∈
        Scheme.proetaleTopology V.left.left := by
    intro S U V R
    rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_apply, hmem S V.left,
      ← Sieve.functorPushforward_comp]
  let εapp : ∀ (S : Scheme.{u}) (U : S.ProEt) (V : Over U),
      (wcOverToSlice S U ⋙ wcSliceToOver S U).obj V ≅ V := fun S U V =>
    Over.isoMk (MorphismProperty.Over.isoMk (Iso.refl V.left.left)
        ((Category.id_comp _).trans (MorphismProperty.Over.w V.hom).symm))
      (MorphismProperty.Over.Hom.ext (Category.id_comp V.hom.left))
  let ε : ∀ (S : Scheme.{u}) (U : S.ProEt),
      wcOverToSlice S U ⋙ wcSliceToOver S U ≅ 𝟭 (Over U) := fun S U =>
    NatIso.ofComponents (εapp S U) (fun {V V'} g => by
      apply Over.OverMorphism.ext
      apply MorphismProperty.Over.Hom.ext
      exact (Category.comp_id g.left.left).trans (Category.id_comp g.left.left).symm)
  let eqv : ∀ (S : Scheme.{u}) (U : S.ProEt), U.left.ProEt ≌ Over U := fun S U =>
    Equivalence.mk' (wcSliceToOver S U) (wcOverToSlice S U) (Iso.refl _) (ε S U) (fun W => by
      apply Over.OverMorphism.ext
      apply MorphismProperty.Over.Hom.ext
      exact Category.comp_id (𝟙 W.left))
  have hcont : ∀ (S : Scheme.{u}) (U : S.ProEt),
      (eqv S U).functor.IsContinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) ∧
      (eqv S U).inverse.IsContinuous ((Scheme.ProEt.topology S).over U)
        (Scheme.ProEt.topology U.left) := by
    intro S U
    have hFc : (wcSliceToOver S U).IsCocontinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) := by
      constructor
      intro W T hT
      rw [hmem U.left W]
      rw [hmemD S U] at hT
      refine GrothendieckTopology.superset_covering _ ?_ hT
      rintro Z f ⟨V', t, a, ht, rfl⟩
      refine ⟨(wcOverToSlice S U).obj V', (wcOverToSlice S U).map t, a, ?_, rfl⟩
      show T.arrows ((wcSliceToOver S U).map ((wcOverToSlice S U).map t))
      have hft : (wcSliceToOver S U).map ((wcOverToSlice S U).map t) = (εapp S U V').hom ≫ t := by
        apply Over.OverMorphism.ext
        apply MorphismProperty.Over.Hom.ext
        exact (Category.id_comp t.left.left).symm
      exact (congrArg (fun g => T.arrows g) hft).mpr (T.downward_closed ht _)
    have hGc : (wcOverToSlice S U).IsCocontinuous ((Scheme.ProEt.topology S).over U)
        (Scheme.ProEt.topology U.left) := by
      constructor
      intro V T hT
      rw [hmemD S U]
      rw [hmem U.left] at hT
      refine GrothendieckTopology.superset_covering _ ?_ hT
      rintro Z f ⟨W', t, a, ht, rfl⟩
      refine ⟨(wcSliceToOver S U).obj W', (wcSliceToOver S U).map t ≫ (εapp S U V).hom, a, ?_, ?_⟩
      · show T.arrows ((wcOverToSlice S U).map ((wcSliceToOver S U).map t ≫ (εapp S U V).hom))
        have hgt : (wcOverToSlice S U).map ((wcSliceToOver S U).map t ≫ (εapp S U V).hom) = t := by
          apply MorphismProperty.Over.Hom.ext
          exact Category.comp_id t.left
        exact (congrArg (fun g => T.arrows g) hgt).mpr ht
      · exact (congrArg (a ≫ ·) (Category.comp_id t.left)).symm
    haveI : (eqv S U).functor.IsCocontinuous (Scheme.ProEt.topology U.left)
        ((Scheme.ProEt.topology S).over U) := hFc
    haveI : (eqv S U).inverse.IsCocontinuous ((Scheme.ProEt.topology S).over U)
        (Scheme.ProEt.topology U.left) := hGc
    haveI := Equivalence.isDenseSubsite_functor_of_isCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) (eqv S U)
    haveI := Equivalence.isDenseSubsite_inverse_of_isCocontinuous (Scheme.ProEt.topology U.left)
      ((Scheme.ProEt.topology S).over U) (eqv S U)
    exact ⟨inferInstance, inferInstance⟩
  let E : ∀ (Z : Over (Spec (.of F)))
      (hZ : WeaklyEtale (Limits.pullback.fst Z.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))),
      SheafOfModules.{u+1} (wcSliceRing F Z hZ ℓ) ≌
        SheafOfModules.{u+1} (wcRingSheaf (wcXbar F Z) ℓ) := fun Z hZ =>
    haveI := (hcont Z.left (wcGeomPoint F Z hZ)).1
    haveI := (hcont Z.left (wcGeomPoint F Z hZ)).2
    SheafOfModules.pushforwardPushforwardEquivalence (eqv Z.left (wcGeomPoint F Z hZ))
      (S := wcRingSheaf (wcGeomPoint F Z hZ).left ℓ) (R := wcSliceRing F Z hZ ℓ) (𝟙 _) (𝟙 _) rfl rfl
  let Θdef : ∀ (Z : Over (Spec (.of F)))
      (hZ : WeaklyEtale (Limits.pullback.fst Z.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))) (n : ℕ),
      wcModCoh F Z hZ ℓ n ≃+ wcHM (wcXbar F Z) ℓ n := fun Z hZ n => by
    letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F Z hZ ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F Z) ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcGeomPoint F Z hZ).left ℓ)) :=
      HasExt.standard _
    haveI : (E Z hZ).functor.PreservesZeroMorphisms :=
      Functor.preservesZeroMorphisms_of_isLeftAdjoint _
    haveI : (E Z hZ).functor.Additive := Functor.additive_of_preserves_binary_products _
    haveI : (E Z hZ).inverse.Additive := (E Z hZ).inverse_additive
    let adj : (E Z hZ).inverse ⊣ (E Z hZ).functor := (E Z hZ).symm.toAdjunction
    let θ : (E Z hZ).inverse.obj ((E Z hZ).functor.obj (SheafOfModules.unit (wcSliceRing F Z hZ ℓ))) ≅
        SheafOfModules.unit (wcSliceRing F Z hZ ℓ) :=
      ((E Z hZ).unitIso.app (SheafOfModules.unit (wcSliceRing F Z hZ ℓ))).symm
    have hc : adj.unit.app ((E Z hZ).functor.obj (SheafOfModules.unit (wcSliceRing F Z hZ ℓ))) ≫
        (E Z hZ).functor.map θ.hom = 𝟙 _ := by
      simp [adj, θ]
    have hb : Function.Bijective
        ((E Z hZ).functor.mapExtAddHom (SheafOfModules.unit (wcSliceRing F Z hZ ℓ))
          (SheafOfModules.unit (wcSliceRing F Z hZ ℓ)) n) := by
      let P : Abelian.Ext (SheafOfModules.unit (wcSliceRing F Z hZ ℓ))
          (SheafOfModules.unit (wcSliceRing F Z hZ ℓ)) n ≃+
          Abelian.Ext ((E Z hZ).inverse.obj ((E Z hZ).functor.obj
            (SheafOfModules.unit (wcSliceRing F Z hZ ℓ))))
            (SheafOfModules.unit (wcSliceRing F Z hZ ℓ)) n :=
        { toFun := fun x => (Abelian.Ext.mk₀ θ.hom).comp x (zero_add n)
          invFun := fun y => (Abelian.Ext.mk₀ θ.inv).comp y (zero_add n)
          left_inv := fun x => by
            simp only
            rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
          right_inv := fun y => by
            simp only
            rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]
          map_add' := fun x y => Abelian.Ext.comp_add _ _ _ _ }
      have hΨ : ∀ β : Abelian.Ext (SheafOfModules.unit (wcSliceRing F Z hZ ℓ))
          (SheafOfModules.unit (wcSliceRing F Z hZ ℓ)) n,
          adj.extEquiv (P β) = Abelian.Ext.mapExactFunctor (E Z hZ).functor β := by
        intro β
        show adj.extEquiv ((Abelian.Ext.mk₀ θ.hom).comp β (zero_add n)) = _
        rw [Adjunction.extEquiv_apply, Abelian.Ext.mapExactFunctor_comp,
          Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀_assoc, hc,
          Abelian.Ext.mk₀_id_comp]
      have hcomp := (adj.extEquiv (n := n)).bijective.comp P.bijective
      convert hcomp using 1
      funext β
      rw [Functor.mapExtAddHom_apply]
      exact (hΨ β).symm
    exact (AddEquiv.ofBijective _ hb : wcModCoh F Z hZ ℓ n ≃+ wcHM (wcXbar F Z) ℓ n)
  refine ⟨Θdef, ?_, ?_⟩
  · intro Z hZ i j k hk x y
    letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F Z hZ ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F Z) ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcGeomPoint F Z hZ).left ℓ)) :=
      HasExt.standard _
    haveI : (E Z hZ).functor.PreservesZeroMorphisms :=
      Functor.preservesZeroMorphisms_of_isLeftAdjoint _
    haveI : (E Z hZ).functor.Additive := Functor.additive_of_preserves_binary_products _
    show (E Z hZ).functor.mapExtAddHom _ _ k (wcModCup F Z hZ ℓ i j k hk x y) =
      wcHMCup (wcXbar F Z) ℓ i j k hk ((E Z hZ).functor.mapExtAddHom _ _ i x)
        ((E Z hZ).functor.mapExtAddHom _ _ j y)
    simp only [wcModCup, wcHMCup, Abelian.Ext.bilinearComp_apply_apply, Functor.mapExtAddHom_apply]
    exact Abelian.Ext.mapExactFunctor_comp _ x y hk
  · intro X Y p hX hY pb h1 h2 D hD hP n u
    letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F Y hY ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcSliceRing F X hX ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F Y) ℓ)) := HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcGeomPoint F X hX).left ℓ)) :=
      HasExt.standard _
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf (wcGeomPoint F Y hY).left ℓ)) :=
      HasExt.standard _
    haveI := hP.fst
    haveI := hP.snd.fst
    haveI := hP.snd.snd.1
    haveI := hP.snd.snd.2.1
    haveI := hP.snd.snd.2.2.1
    haveI := hP.snd.snd.2.2.2.1
    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    haveI : (E X hX).functor.PreservesZeroMorphisms :=
      Functor.preservesZeroMorphisms_of_isLeftAdjoint _
    haveI : (E X hX).functor.Additive := Functor.additive_of_preserves_binary_products _
    haveI : (E Y hY).functor.PreservesZeroMorphisms :=
      Functor.preservesZeroMorphisms_of_isLeftAdjoint _
    haveI : (E Y hY).functor.Additive := Functor.additive_of_preserves_binary_products _
    have hpull : wcModPull F p hX hY ℓ n u = (Abelian.Ext.mk₀
        (inv (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ)))).comp
        ((Abelian.Ext.mapExactFunctor (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ))
          u).comp (Abelian.Ext.mk₀ (SheafOfModules.pullbackObjUnitToUnit
            (wcSliceRingMap F p hX hY ℓ))) (add_zero n)) (zero_add n) := by
      unfold wcModPull
      rw [dif_pos hP]
      rfl
    have hΘX : ∀ v : wcModCoh F X hX ℓ n,
        Θdef X hX n v = Abelian.Ext.mapExactFunctor (E X hX).functor v := fun v => rfl
    have hΘY : ∀ v : wcModCoh F Y hY ℓ n,
        Θdef Y hY n v = Abelian.Ext.mapExactFunctor (E Y hY).functor v := fun v => rfl
    have hDP : ∀ x : wcHM (wcXbar F Y) ℓ n, wcHMPull D n x =
        (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ x).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n) := fun x => rfl
    rw [hpull, hΘX, hΘY]
    refine Eq.trans ?_ (hDP _).symm

    obtain ⟨α, hα⟩ := wc_sliceBC_overToSlice_iso F p hX hY pb h1 h2
    haveI : (wcOverToSlice X.left (wcGeomPoint F X hX)).IsContinuous
        ((Scheme.ProEt.topology X.left).over (wcGeomPoint F X hX))
        (Scheme.ProEt.topology (wcGeomPoint F X hX).left) := (hcont X.left (wcGeomPoint F X hX)).2
    haveI : (wcOverToSlice Y.left (wcGeomPoint F Y hY)).IsContinuous
        ((Scheme.ProEt.topology Y.left).over (wcGeomPoint F Y hY))
        (Scheme.ProEt.topology (wcGeomPoint F Y hY).left) := (hcont Y.left (wcGeomPoint F Y hY)).2
    obtain ⟨θ⟩ := wc_modPull_slice_pushforward_iso F p hX hY ℓ pb D hD α hα

    let adj1 := (SheafOfModules.pullbackPushforwardAdjunction (wcSliceRingMap F p hX hY ℓ)).comp
      (E X hX).toAdjunction
    let adj2 := (E Y hY).toAdjunction.comp D.adj
    let γ : SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ) ⋙ (E X hX).functor ≅
        (E Y hY).functor ⋙ D.Φ := (adj1.ofNatIsoRight θ).leftAdjointUniq adj2

    have h2' : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)} {a : ℕ}
        (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' D' a),
        (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add a)) (zero_add a) =
          (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add a) := by
      intro A B C' D' a f g z
      rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
    have h3' : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)} {a : ℕ}
        (z : Abelian.Ext A B a) (f : B ⟶ C') (g : C' ⟶ D'),
        (z.comp (Abelian.Ext.mk₀ f) (add_zero a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
          z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero a) := by
      intro A B C' D' a z f g
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    have h4' : ∀ {A B C' D' : SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)} {a : ℕ}
        (f : A ⟶ B) (z : Abelian.Ext B C' a) (g : C' ⟶ D'),
        ((Abelian.Ext.mk₀ f).comp z (zero_add a)).comp (Abelian.Ext.mk₀ g) (add_zero a) =
          (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero a)) (zero_add a) := by
      intro A B C' D' a f z g
      exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
    have central : ∀ (e : SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ) ⟶
        SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) (y : wcHM (wcXbar F X) ℓ n),
        (Abelian.Ext.mk₀ e).comp y (zero_add n) = y.comp (Abelian.Ext.mk₀ e) (add_zero n) := by
      intro e y
      have hcomm : ∀ (W : ((wcXbar F X).ProEt)ᵒᵖ) (a b : (wcRingSheaf (wcXbar F X) ℓ).obj.obj W),
          a * b = b * a := by
        intro W a b
        exact @mul_comm C(↥(Opposite.unop W).left, ULift.{u+1} ℚ_[ℓ]) _ a b
      have hext : ∃ m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) ⟶
          𝟭 (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)),
          m.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)) = e := by
        let R := wcRingSheaf (wcXbar F X) ℓ
        let s := (SheafOfModules.unit R).unitHomEquiv e
        let σ : ∀ W : ((wcXbar F X).ProEt)ᵒᵖ, R.obj.obj W := fun W => (s.1 W : R.obj.obj W)
        have hσ : ∀ {W W' : ((wcXbar F X).ProEt)ᵒᵖ} (f : W ⟶ W'), (R.obj.map f).hom (σ W) = σ W' :=
          fun f => PresheafOfModules.sections_property s f
        let L : ∀ (M : SheafOfModules.{u+1} R) (W : ((wcXbar F X).ProEt)ᵒᵖ),
            M.val.obj W ⟶ M.val.obj W :=
          fun M W => ModuleCat.ofHom
            { toFun := fun x => σ W • x
              map_add' := fun x y => smul_add _ _ _
              map_smul' := fun r x => by
                simp only [RingHom.id_apply, smul_smul]
                rw [hcomm W] }
        let mM : ∀ M : SheafOfModules.{u+1} R, M ⟶ M := fun M =>
          ⟨PresheafOfModules.Hom.mk (L M) (by
            intro W W' f
            ext x
            show σ W' • (M.val.map f).hom x = (M.val.map f).hom (σ W • x)
            rw [PresheafOfModules.map_smul, hσ])⟩
        refine ⟨{ app := mM, naturality := ?_ }, ?_⟩
        · intro M N g
          apply SheafOfModules.hom_ext
          apply PresheafOfModules.hom_ext
          intro W
          ext x
          show σ W • (g.val.app W).hom x = (g.val.app W).hom (σ W • x)
          exact ((g.val.app W).hom.map_smul _ _).symm
        · apply (SheafOfModules.unit R).unitHomEquiv.injective
          apply PresheafOfModules.sections_ext
          intro W
          rw [SheafOfModules.unitHomEquiv_apply_coe]
          show σ W • (1 : R.obj.obj W) = s.1 W
          rw [smul_eq_mul, mul_one]
      have hcen : ∀ (m : 𝟭 (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)) ⟶
          𝟭 (SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ))) (z : wcHM (wcXbar F X) ℓ n),
          (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)))).comp z
              (zero_add n) =
            z.comp (Abelian.Ext.mk₀ (m.app (SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ))))
              (add_zero n) := by
        intro m z
        have h := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp z m
        simp only [Abelian.Ext.id_mapExactFunctor] at h
        exact h.symm
      obtain ⟨m, hm⟩ := hext
      subst hm
      exact hcen m y
    have gen : ∀ {M : SheafOfModules.{u+1} (wcRingSheaf (wcXbar F X) ℓ)} (y : Abelian.Ext M M n)
        (a a' : SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ) ⟶ M)
        (b b' : M ⟶ SheafOfModules.unit (wcRingSheaf (wcXbar F X) ℓ)),
        a ≫ b = 𝟙 _ → b' ≫ a' = 𝟙 _ →
        (Abelian.Ext.mk₀ a).comp (y.comp (Abelian.Ext.mk₀ b) (add_zero n)) (zero_add n) =
          (Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (add_zero n)) (zero_add n) := by
      intro M y a a' b b' hab hba
      have ea : (a ≫ b') ≫ a' = a := by rw [Category.assoc, hba, Category.comp_id]
      have eb : b' ≫ a' ≫ b = b := by rw [← Category.assoc, hba, Category.id_comp]
      have eE : (a ≫ b') ≫ (a' ≫ b) = 𝟙 _ := by rw [← Category.assoc, ea, hab]
      have hc : (Abelian.Ext.mk₀ (a ≫ b')).comp ((Abelian.Ext.mk₀ a').comp
            (y.comp (Abelian.Ext.mk₀ b') (add_zero n)) (zero_add n)) (zero_add n) =
          ((Abelian.Ext.mk₀ a').comp (y.comp (Abelian.Ext.mk₀ b') (add_zero n)) (zero_add n)).comp
            (Abelian.Ext.mk₀ (a ≫ b')) (add_zero n) :=
        central _ _
      have e1 : (Abelian.Ext.mk₀ a).comp (y.comp (Abelian.Ext.mk₀ b) (add_zero n)) (zero_add n) =
          ((Abelian.Ext.mk₀ (a ≫ b')).comp ((Abelian.Ext.mk₀ a').comp
            (y.comp (Abelian.Ext.mk₀ b') (add_zero n)) (zero_add n)) (zero_add n)).comp
            (Abelian.Ext.mk₀ (a' ≫ b)) (add_zero n) := by
        rw [h2', h4', h3', ea, eb]
      rw [e1, hc, h3', eE, Abelian.Ext.comp_mk₀_id]
    have nat' := Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp u γ.hom
    have step1 : (Abelian.Ext.mapExactFunctor
          (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ) ⋙ (E X hX).functor) u).comp
          (Abelian.Ext.mk₀ ((E X hX).functor.map
            (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ)))) (add_zero n) =
        ((Abelian.Ext.mk₀ (γ.hom.app (SheafOfModules.unit (wcSliceRing F Y hY ℓ)))).comp
          (Abelian.Ext.mapExactFunctor ((E Y hY).functor ⋙ D.Φ) u) (zero_add n)).comp
          (Abelian.Ext.mk₀ (γ.inv.app (SheafOfModules.unit (wcSliceRing F Y hY ℓ)) ≫
            (E X hX).functor.map
              (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ)))) (add_zero n) := by
      rw [← nat', h3', Iso.hom_inv_id_app_assoc]
    have hL : Abelian.Ext.mapExactFunctor (E X hX).functor ((Abelian.Ext.mk₀
        (inv (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ)))).comp
        ((Abelian.Ext.mapExactFunctor (SheafOfModules.pullback.{u+1} (wcSliceRingMap F p hX hY ℓ))
          u).comp (Abelian.Ext.mk₀ (SheafOfModules.pullbackObjUnitToUnit
            (wcSliceRingMap F p hX hY ℓ))) (add_zero n)) (zero_add n)) =
        (Abelian.Ext.mk₀ ((E X hX).functor.map
            (inv (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ))) ≫
            γ.hom.app (SheafOfModules.unit (wcSliceRing F Y hY ℓ)))).comp
          ((Abelian.Ext.mapExactFunctor ((E Y hY).functor ⋙ D.Φ) u).comp
            (Abelian.Ext.mk₀ (γ.inv.app (SheafOfModules.unit (wcSliceRing F Y hY ℓ)) ≫
              (E X hX).functor.map
                (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ)))) (add_zero n))
          (zero_add n) := by
      rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_comp,
        Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mapExactFunctor_mk₀,
        ← Abelian.Ext.comp_mapExactFunctor, step1, h4', h2']
    have hR : (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor D.Φ
        ((Abelian.Ext.mapExactFunctor (E Y hY).functor u : wcHM (wcXbar F Y) ℓ n))).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n) =
        (Abelian.Ext.mk₀ D.μ.inv).comp ((Abelian.Ext.mapExactFunctor ((E Y hY).functor ⋙ D.Φ) u).comp
          (Abelian.Ext.mk₀ D.μ.hom) (add_zero n)) (zero_add n) := by
      rw [← Abelian.Ext.comp_mapExactFunctor]
    refine hL.trans (Eq.trans ?_ hR.symm)
    have hab : ((E X hX).functor.map
          (inv (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ))) ≫
          γ.hom.app (SheafOfModules.unit (wcSliceRing F Y hY ℓ))) ≫
        (γ.inv.app (SheafOfModules.unit (wcSliceRing F Y hY ℓ)) ≫
          (E X hX).functor.map
            (SheafOfModules.pullbackObjUnitToUnit (wcSliceRingMap F p hX hY ℓ))) = 𝟙 _ := by
      rw [Category.assoc, Iso.hom_inv_id_app_assoc, ← CategoryTheory.Functor.map_comp,
        IsIso.inv_hom_id, CategoryTheory.Functor.map_id]
    exact gen _ _ _ _ _ hab D.μ.hom_inv_id

theorem wc_prod_xbar_isPullback (F : Type u) [Field F] (Y₁ Y₂ : Over (Spec (.of F)))
    (r₁ : wcXbar F (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) ⟶ wcXbar F Y₁)
    (r₂ : wcXbar F (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)) ⟶ wcXbar F Y₂)
    (h11 : r₁ ≫ Limits.pullback.fst Y₁.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      Limits.pullback.fst (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
        Limits.pullback.fst Y₁.hom Y₂.hom)
    (h12 : r₁ ≫ Limits.pullback.snd Y₁.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      Limits.pullback.snd (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))))
    (h21 : r₂ ≫ Limits.pullback.fst Y₂.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      Limits.pullback.fst (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) ≫
        Limits.pullback.snd Y₁.hom Y₂.hom)
    (h22 : r₂ ≫ Limits.pullback.snd Y₂.hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) =
      Limits.pullback.snd (Over.mk (Limits.pullback.fst Y₁.hom Y₂.hom ≫ Y₁.hom)).hom
        (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F))))) :
    IsPullback r₁ r₂ (wcPi2 F Y₁) (wcPi2 F Y₂) :=
by
  have key : ∀ {S B A₁ A₂ : Scheme.{u}} (σ : B ⟶ S) (g₁ : A₁ ⟶ S) (g₂ : A₂ ⟶ S)
      (q₁ : Limits.pullback (Limits.pullback.fst g₁ g₂ ≫ g₁) σ ⟶ Limits.pullback g₁ σ)
      (q₂ : Limits.pullback (Limits.pullback.fst g₁ g₂ ≫ g₁) σ ⟶ Limits.pullback g₂ σ),
      q₁ ≫ Limits.pullback.fst g₁ σ =
        Limits.pullback.fst (Limits.pullback.fst g₁ g₂ ≫ g₁) σ ≫ Limits.pullback.fst g₁ g₂ →
      q₁ ≫ Limits.pullback.snd g₁ σ = Limits.pullback.snd (Limits.pullback.fst g₁ g₂ ≫ g₁) σ →
      q₂ ≫ Limits.pullback.fst g₂ σ =
        Limits.pullback.fst (Limits.pullback.fst g₁ g₂ ≫ g₁) σ ≫ Limits.pullback.snd g₁ g₂ →
      q₂ ≫ Limits.pullback.snd g₂ σ = Limits.pullback.snd (Limits.pullback.fst g₁ g₂ ≫ g₁) σ →
      IsPullback q₁ q₂ (Limits.pullback.snd g₁ σ) (Limits.pullback.snd g₂ σ) := by
    intro S B A₁ A₂ σ g₁ g₂ q₁ q₂ e11 e12 e21 e22
    have comm : q₁ ≫ Limits.pullback.snd g₁ σ = q₂ ≫ Limits.pullback.snd g₂ σ := by
      rw [e12, e22]
    have w1 : ∀ s : Limits.PullbackCone (Limits.pullback.snd g₁ σ) (Limits.pullback.snd g₂ σ),
        (s.fst ≫ Limits.pullback.fst g₁ σ) ≫ g₁ = (s.snd ≫ Limits.pullback.fst g₂ σ) ≫ g₂ := by
      intro s
      rw [Category.assoc, Category.assoc, Limits.pullback.condition, Limits.pullback.condition,
        ← Category.assoc, ← Category.assoc, s.condition]
    have w2 : ∀ s : Limits.PullbackCone (Limits.pullback.snd g₁ σ) (Limits.pullback.snd g₂ σ),
        Limits.pullback.lift (s.fst ≫ Limits.pullback.fst g₁ σ)
            (s.snd ≫ Limits.pullback.fst g₂ σ) (w1 s) ≫ (Limits.pullback.fst g₁ g₂ ≫ g₁) =
          (s.fst ≫ Limits.pullback.snd g₁ σ) ≫ σ := by
      intro s
      rw [← Category.assoc, Limits.pullback.lift_fst, Category.assoc, Limits.pullback.condition,
        ← Category.assoc]
    refine IsPullback.of_isLimit (c := Limits.PullbackCone.mk q₁ q₂ comm) ?_
    refine Limits.PullbackCone.IsLimit.mk comm
      (fun s => Limits.pullback.lift
        (Limits.pullback.lift (s.fst ≫ Limits.pullback.fst g₁ σ)
          (s.snd ≫ Limits.pullback.fst g₂ σ) (w1 s))
        (s.fst ≫ Limits.pullback.snd g₁ σ) (w2 s)) ?_ ?_ ?_
    · intro s
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, e11, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.lift_fst]
      · rw [Category.assoc, e12, Limits.pullback.lift_snd]
    · intro s
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, e21, ← Category.assoc, Limits.pullback.lift_fst,
          Limits.pullback.lift_snd]
      · rw [Category.assoc, e22, Limits.pullback.lift_snd, s.condition]
    · intro s m h1 h2
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst]
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, Category.assoc, ← e11, ← Category.assoc, h1]
        · rw [Limits.pullback.lift_snd, Category.assoc, ← e21, ← Category.assoc, h2]
      · rw [Limits.pullback.lift_snd, ← e12, ← Category.assoc, h1]
  exact key (Spec.map (CommRingCat.ofHom (algebraMap F (AlgebraicClosure F)))) Y₁.hom Y₂.hom
    r₁ r₂ h11 h12 h21 h22

theorem wc_prod_wcontr_kunneth_gen (F : Type u) [Finite F] [Field F] (Y₁ Y₂ : Over (Spec (.of F)))
    [GeometricallyIrreducible Y₁.hom] [IsProper Y₁.hom] (d₁ : ℕ) [SmoothOfRelativeDimension d₁ Y₁.hom]
    [GeometricallyIrreducible Y₂.hom] [IsProper Y₂.hom] (d₂ : ℕ) [SmoothOfRelativeDimension d₂ Y₂.hom]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card F)
    (P : Scheme.{u}) (q₁ : P ⟶ wcXbar F Y₁) (q₂ : P ⟶ wcXbar F Y₂)
    (hq : IsPullback q₁ q₂ (wcPi2 F Y₁) (wcPi2 F Y₂))
    (D1 : wcHMPullData q₁ ℓ) (hD1 : wcHMPullCanonical D1)
    (D2 : wcHMPullData q₂ ℓ) (hD2 : wcHMPullCanonical D2)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf P ℓ)))
    (q m : ℕ) (e : Fin m → wcHM (wcXbar F Y₂) ℓ q)
