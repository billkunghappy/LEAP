        (fun j : Fin D.m => wcPencilLoc D ℓ hP (D.S j (IsLocalRing.closedPoint F'')) 1)
        Finset.univ
    rw [hHm, Multiset.map_add, Multiset.sum_add, hsum]
    linear_combination h5
  refine ⟨r,
    { np := wcPencilNp D
      hnp := hnp
      loc := wcPencilLocIdx D ℓ hP
      hcard := ?_
      hrat := ?_
      hzero := ?_
      hsymp := ?_
      tensor := wc_pencil_VQ_tensor_moments_nm F' F'' Y n hn hn2 D hNM ℓ hℓ hP hNI
