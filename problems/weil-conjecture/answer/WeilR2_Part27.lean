          Finset.sum_congr rfl (fun j _ => by rw [hA l j])
      _ = _ := hlin (fun l' => A l' l) T (fun j => ∏ a, P (j a) (i a))
  · intro U s S hS happ i
    choose g hgS hgclose using happ
    have hgeom : Filter.Tendsto (fun t : ℕ => (ℓ : ℝ) ^ (-(t : ℤ))) Filter.atTop (nhds 0) := by
      have h1 : (1 : ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
      have e : (fun t : ℕ => (ℓ : ℝ) ^ (-(t : ℤ))) = fun t : ℕ => ((ℓ : ℝ)⁻¹) ^ t := by
        funext t; rw [zpow_neg, zpow_natCast, inv_pow]
      rw [e]
      exact tendsto_pow_atTop_nhds_zero_of_lt_one (by positivity) (inv_lt_one_of_one_lt₀ h1)
    have hconv : ∀ a a', Filter.Tendsto (fun t => g t a a') Filter.atTop (nhds (s a a')) := by
      intro a a'
      rw [tendsto_iff_norm_sub_tendsto_zero]
