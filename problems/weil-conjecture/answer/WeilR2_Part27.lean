    exact hi0 (h2.symm.trans h3)
  let ψa : G.over (wcGeomPoint K (wcP1Over K) hP) ⟶
      (wcLadicSheaf (wcP1Over K).left ℓ).over (wcGeomPoint K (wcP1Over K) hP) :=
    ∑ l, φl l ≫ scal (a l)
  have hψa : ∀ (V : (wcP1Over K).left.ProEt) (h' : V ⟶ W) (y : G.obj.obj (Opposite.op V))
      (z : V.left),
      (show C(↥V.left, ℚ_[ℓ]) from
        ((ψa.hom.app (Opposite.op (Over.mk (h' ≫ w)))).hom y).down) z =
        μU U (wcContEval (wcP1Over K).left V ((θ.hom.hom.app (Opposite.op (Over.mk h'))).hom y) z) := by
    intro V h' y z
    calc E V (h' ≫ w) y z ψa = ∑ l, E V (h' ≫ w) y z (φl l ≫ scal (a l)) := map_sum _ _ _
      _ = ∑ l, a l * ∑ i, T l i * gv V h' y z i := Finset.sum_congr rfl fun l _ =>
          (hEscal _ _ _ _ _ _).trans (congrArg (a l * ·) (hEφ l V h' y z))
      _ = ∑ i, U i * gv V h' y z i := by
          simp only [hUi, Finset.mul_sum, Finset.sum_mul]
          rw [Finset.sum_comm]
          exact Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => by ring
      _ = μU U (R (gv V h' y z)) := (hμR U _).symm
  have hsl := wc_vqtt_slice_H2_functional_surj K hP ℓ hℓ m hm S hS G hzero W w hqc hconn hoff hcov
    k θ (μU U) hμ ψa hψa
  obtain ⟨y, hy⟩ := hΘsurj G (wcLadicSheaf (wcP1Over K).left ℓ) ψa hsl (e₂.symm (fun _ => 1))
  have h1 : LΘ y ψa = 1 := by
    show e₂ (Θ G (wcLadicSheaf (wcP1Over K).left ℓ) ψa y) 0 = 1
    rw [hy, AddEquiv.apply_symm_apply]
  have h2 : LΘ y ψa = ∑ l, a l * lamψ (φl l) y :=
    (map_sum (LΘ y) _ _).trans (Finset.sum_congr rfl fun l _ => hscalΘ _ _ _)
  have h3 := ha y
  rw [← h2, h1] at h3
  exact one_ne_zero h3

theorem wc_vqtt_H2_coinvariants (K : Type u) [Field K] [Finite K]
    (hP : WeaklyEtale (Limits.pullback.fst (wcP1Over K).hom
          (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))))))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : ¬ ℓ ∣ Nat.card K)
    (m : ℕ) (hm : 1 ≤ m) (S : Fin m → (Spec (.of K) ⟶ (wcP1Over K).left))
    (hS : ∀ i, S i ≫ (wcP1Over K).hom = 𝟙 _)
    (G : Sheaf (Scheme.ProEt.topology (wcP1Over K).left) AddCommGrpCat.{u+1})
    (σ : ℚ_[ℓ] → (G ⟶ G)) (hzero : wcZeroAtS K m S G)
    (ι' : Type) [Fintype ι'] [DecidableEq ι']
    (W : (wcP1Over K).left.ProEt) (w : W ⟶ wcGeomPoint K (wcP1Over K) hP)
    (θG : G.over W ≅ (wcContSheaf (wcP1Over K).left (ι' → ℚ_[ℓ])).over W)
    (hθc : ∀ c : ℚ_[ℓ],
      ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map (σ c) ≫
          θG.hom =
        θG.hom ≫ ((Scheme.ProEt.topology (wcP1Over K).left).overPullback AddCommGrpCat.{u+1} W).map
          (wcContSheafMap (wcP1Over K).left (DistribSMul.toAddMonoidHom (ι' → ℚ_[ℓ]) c)
            (continuous_const_smul c)))
    (hqc : QuasiCompact w.left) (hconn : ConnectedSpace W.left)
    (hoff : ∀ (z : W.left) (i : Fin m), W.hom z ≠ S i (IsLocalRing.closedPoint K))
    (hcov : ∀ p : (wcGeomPoint K (wcP1Over K) hP).left,
      (∀ i : Fin m, (wcGeomPoint K (wcP1Over K) hP).hom p ≠ S i (IsLocalRing.closedPoint K)) →
      ∃ z : W.left, w.left z = p)
    (hgal : ∀ (V : (wcP1Over K).left.ProEt) (a b : V ⟶ W), ConnectedSpace V.left →
      a ≫ w = b ≫ w → ∃ γ : W ⟶ W, γ ≫ w = w ∧ b = a ≫ γ)
    (φ : W ⟶ W) (hφw : φ ≫ w = w ≫ wcGeomFrob K (wcP1Over K) hP)
    (Ψ Ψ' : Matrix ι' ι' ℚ_[ℓ]) (hΨΨ' : Ψ * Ψ' = 1) (hΨ'Ψ : Ψ' * Ψ = 1)
    (hΨ : ∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
      (show C(↥W.left, ι' → ℚ_[ℓ]) from ((θG.hom.hom.app (Opposite.op (Over.mk φ))).hom s).down) z =
      Ψ.mulVec ((show C(↥W.left, ι' → ℚ_[ℓ]) from
        ((θG.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z))
    (N : ℕ) (T : Fin N → ι' → ℚ_[ℓ]) (B : Matrix (Fin N) (Fin N) ℚ_[ℓ])
    (hlin : LinearIndependent ℚ_[ℓ] T)
    (hTinv : ∀ γ : W ⟶ W, γ ≫ w = w → ∃ g : Matrix ι' ι' ℚ_[ℓ],
      (∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
        (show C(↥W.left, ι' → ℚ_[ℓ]) from ((θG.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
        g.mulVec ((show C(↥W.left, ι' → ℚ_[ℓ]) from
          ((θG.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) ∧
      ∀ l i, ∑ j, T l j * g j i = T l i)
    (hspan : ∀ U : ι' → ℚ_[ℓ], (∀ (γ : W ⟶ W) (g : Matrix ι' ι' ℚ_[ℓ]), γ ≫ w = w →
        (∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
          (show C(↥W.left, ι' → ℚ_[ℓ]) from ((θG.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
          g.mulVec ((show C(↥W.left, ι' → ℚ_[ℓ]) from
            ((θG.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z)) →
        ∀ i, ∑ j, U j * g j i = U i) → U ∈ Submodule.span ℚ_[ℓ] (Set.range T))
    (hB : ∀ l i, ∑ j, T l j * Ψ' j i = ∑ l', B l' l * T l' i)
    (r₂ : ℕ) (e₂ : wcCohG K (wcP1Over K) hP G 2 ≃+ (Fin r₂ → ℚ_[ℓ]))
    (he₂ : ∀ (c : ℚ_[ℓ]) (y : wcCohG K (wcP1Over K) hP G 2),
      e₂ (wcCohGEnd K (wcP1Over K) hP G 2 (σ c) y) = c • e₂ y) :
    ∀ e : ℕ, 1 ≤ e →
      (((wcAddEquivMatrix e₂ (wcCohGFrob K (wcP1Over K) hP G 2)).charpoly.aroots
          (AlgebraicClosure ℚ_[ℓ])).map (· ^ e)).sum =
        ((Nat.card K : ℕ) : AlgebraicClosure ℚ_[ℓ]) ^ e *
          algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) ((B ^ e).trace) :=
by
  classical
  intro e he
  obtain ⟨Pr, hPrs, hPrσ, hPrg⟩ := wc_vqtt_H2_coinv_surj K hP ℓ hℓ m hm S hS G σ hzero ι' W w θG
    hθc hqc hconn hoff hcov hgal
  obtain ⟨lam, hlamσ, hlamF, hlamind⟩ := wc_vqtt_H2_functionals K hP ℓ hℓ m hm S hS G σ hzero ι'
    W w θG hθc hqc hconn hoff hcov hgal φ hφw Ψ Ψ' hΨΨ' hΨ'Ψ hΨ N T B hlin hTinv hB

  have hes : ∀ (c : ℚ_[ℓ]) (v : Fin r₂ → ℚ_[ℓ]),
      e₂.symm (c • v) = wcCohGEnd K (wcP1Over K) hP G 2 (σ c) (e₂.symm v) := fun c v =>
    e₂.injective (by rw [he₂, AddEquiv.apply_symm_apply, AddEquiv.apply_symm_apply])
  have hFσ : ∀ (c : ℚ_[ℓ]) (y : wcCohG K (wcP1Over K) hP G 2),
      wcCohGFrob K (wcP1Over K) hP G 2 (wcCohGEnd K (wcP1Over K) hP G 2 (σ c) y) =
        wcCohGEnd K (wcP1Over K) hP G 2 (σ c) (wcCohGFrob K (wcP1Over K) hP G 2 y) := by
    intro c y
    show (Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP))).comp
        (y.comp (Abelian.Ext.mk₀ (σ c)) (add_zero 2)) (zero_add 2) =
      ((Abelian.Ext.mk₀ (wcFreeSheafMap (wcP1Over K).left (wcGeomFrob K (wcP1Over K) hP))).comp y
        (zero_add 2)).comp (Abelian.Ext.mk₀ (σ c)) (add_zero 2)
    exact (Abelian.Ext.comp_assoc _ _ _ (zero_add 2) (add_zero 2) (by omega)).symm
  let LA : (Fin r₂ → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r₂ → ℚ_[ℓ]) :=
    { toFun := fun v => e₂ (wcCohGFrob K (wcP1Over K) hP G 2 (e₂.symm v))
      map_add' := fun v v' => by simp only [map_add]
      map_smul' := fun c v => by simp only [hes, hFσ, he₂, RingHom.id_apply] }
  have hM : wcAddEquivMatrix e₂ (wcCohGFrob K (wcP1Over K) hP G 2) = LinearMap.toMatrix' LA := by
    ext a b
    rw [LinearMap.toMatrix'_apply]
    rfl
  set M := wcAddEquivMatrix e₂ (wcCohGFrob K (wcP1Over K) hP G 2) with hMdef
  have hMv : ∀ v, M.mulVec v = e₂ (wcCohGFrob K (wcP1Over K) hP G 2 (e₂.symm v)) := by
    intro v
    rw [hM, LinearMap.toMatrix'_mulVec]
    rfl

  have laB : ∀ (r0 N0 : ℕ) (T0 : Fin N0 → ι' → ℚ_[ℓ]), LinearIndependent ℚ_[ℓ] T0 →
      ∀ (P : Matrix ι' ι' ℚ_[ℓ] → Prop),
      (∀ U : ι' → ℚ_[ℓ], (∀ g, P g → ∀ i, ∑ j, U j * g j i = U i) →
        U ∈ Submodule.span ℚ_[ℓ] (Set.range T0)) →
      ∀ (f : (ι' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r0 → ℚ_[ℓ])), Function.Surjective f →
      (∀ g, P g → ∀ v, f (g.mulVec v) = f v) → r0 ≤ N0 := by
    intro r0 N0 T0 hlin0 P hspan0 f hf hfg
    set Mf := LinearMap.toMatrix' f with hMf
    have hMfv : ∀ v, Mf.mulVec v = f v := fun v => LinearMap.toMatrix'_mulVec f v
    have hmem : ∀ a : Fin r0 → ℚ_[ℓ],
        Matrix.vecMulLinear Mf a ∈ Submodule.span ℚ_[ℓ] (Set.range T0) := by
      intro a
      apply hspan0
      intro g hg i
      have hMg : Mf * g = Mf := by
        apply Matrix.toLin'.injective
        apply LinearMap.ext
        intro v
        rw [Matrix.toLin'_apply, Matrix.toLin'_apply, ← Matrix.mulVec_mulVec, hMfv, hMfv, hfg g hg]
      have h1 : Matrix.vecMul a (Mf * g) i = Matrix.vecMul a Mf i := by rw [hMg]
      rw [← Matrix.vecMul_vecMul] at h1
      exact h1
    let Φ0 := LinearMap.codRestrict (Submodule.span ℚ_[ℓ] (Set.range T0)) (Matrix.vecMulLinear Mf) hmem
    have hinj : Function.Injective Φ0 := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro a ha
      have ha' : Matrix.vecMul a Mf = 0 := by
        have := congrArg Subtype.val ha
        exact this
      funext b
      obtain ⟨v, hv⟩ := hf (Pi.single b 1)
      have h1 : a ⬝ᵥ Mf.mulVec v = Matrix.vecMul a Mf ⬝ᵥ v := Matrix.dotProduct_mulVec a Mf v
      rw [ha', zero_dotProduct, hMfv, hv, dotProduct_single, mul_one] at h1
      exact h1
    have := LinearMap.finrank_le_finrank_of_injective hinj
    rw [finrank_span_eq_card hlin0] at this
    simpa using this
  let f : (ι' → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin r₂ → ℚ_[ℓ]) :=
    { toFun := fun v => e₂ (Pr v)
      map_add' := fun v v' => by simp only [map_add]
      map_smul' := fun c v => by simp only [hPrσ, he₂, RingHom.id_apply] }
  have hf : Function.Surjective f := by
    intro y
    obtain ⟨v, hv⟩ := hPrs (e₂.symm y)
    exact ⟨v, by show e₂ (Pr v) = y; rw [hv, AddEquiv.apply_symm_apply]⟩
  have hrN : r₂ ≤ N := by
    refine laB r₂ N T hlin (fun g => ∃ γ : W ⟶ W, γ ≫ w = w ∧
      ∀ (s : G.obj.obj (Opposite.op W)) (z : W.left),
        (show C(↥W.left, ι' → ℚ_[ℓ]) from ((θG.hom.hom.app (Opposite.op (Over.mk γ))).hom s).down) z =
        g.mulVec ((show C(↥W.left, ι' → ℚ_[ℓ]) from
          ((θG.hom.hom.app (Opposite.op (Over.mk (𝟙 W)))).hom s).down) z))
      (fun U hU => hspan U (fun γ g hγ hg => hU g ⟨γ, hγ, hg⟩)) f hf ?_
    rintro g ⟨γ, hγ, hg⟩ v
    show e₂ (Pr (g.mulVec v)) = e₂ (Pr v)
    rw [hPrg γ g hγ hg v]

  let Lmap : (Fin r₂ → ℚ_[ℓ]) →ₗ[ℚ_[ℓ]] (Fin N → ℚ_[ℓ]) :=
    { toFun := fun v l => lam l (e₂.symm v)
      map_add' := fun v v' => by
        funext l
        simp only [map_add, Pi.add_apply]
      map_smul' := fun c v => by
        funext l
        simp only [hes, hlamσ, RingHom.id_apply, Pi.smul_apply, smul_eq_mul] }
  set L := LinearMap.toMatrix' Lmap with hLdef
  have hLv : ∀ v, L.mulVec v = Lmap v := fun v => LinearMap.toMatrix'_mulVec Lmap v
  have hind : ∀ a : Fin N → ℚ_[ℓ], Matrix.vecMul a L = 0 → a = 0 := by
    intro a ha
    apply hlamind a
    intro y
    have h1 : a ⬝ᵥ L.mulVec (e₂ y) = Matrix.vecMul a L ⬝ᵥ e₂ y := Matrix.dotProduct_mulVec a L (e₂ y)
    rw [ha, zero_dotProduct, hLv] at h1
    have h2 : a ⬝ᵥ Lmap (e₂ y) = ∑ l, a l * lam l y := by
      simp only [dotProduct]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      show a l * lam l (e₂.symm (e₂ y)) = _
      rw [AddEquiv.symm_apply_apply]
    rw [← h2]
    exact h1
  have hLA : L * M = ((Nat.card K : ℚ_[ℓ]) • B.transpose) * L := by
    apply Matrix.toLin'.injective
    apply LinearMap.ext
    intro v
    rw [Matrix.toLin'_apply, Matrix.toLin'_apply, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
    simp only [hLv, hMv]
    funext l
    show lam l (e₂.symm (e₂ (wcCohGFrob K (wcP1Over K) hP G 2 (e₂.symm v)))) =
      ∑ l', ((Nat.card K : ℚ_[ℓ]) • B.transpose) l l' * lam l' (e₂.symm v)
    rw [AddEquiv.symm_apply_apply, hlamF, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun l' _ => ?_)
    rw [Matrix.smul_apply, Matrix.transpose_apply, smul_eq_mul]
    ring

  have trM : (M ^ e).trace = (Nat.card K : ℚ_[ℓ]) ^ e * (B ^ e).trace := by
    have hinj : Function.Injective (Matrix.vecMulLinear L) := by
      rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
      intro a ha
      exact hind a ha
    have hnr : N ≤ r₂ := by
      have := LinearMap.finrank_le_finrank_of_injective hinj
      simpa using this
    obtain rfl : N = r₂ := le_antisymm hnr hrN
    have hU : IsUnit L := by
      rw [← Matrix.vecMul_injective_iff_isUnit]
      exact hinj
    have hdet : IsUnit L.det := (Matrix.isUnit_iff_isUnit_det L).mp hU
    set X := (Nat.card K : ℚ_[ℓ]) • B.transpose with hX
    have hpow : ∀ j : ℕ, L * M ^ j = X ^ j * L := by
      intro j
      induction j with
      | zero => simp
      | succ j ih =>
        rw [pow_succ, ← mul_assoc, ih, mul_assoc, hLA, ← mul_assoc, ← pow_succ]
    have hA : M ^ e = L⁻¹ * (X ^ e * L) := by
      rw [← hpow e, ← mul_assoc, Matrix.nonsing_inv_mul L hdet, one_mul]
    rw [hA, Matrix.trace_mul_comm, mul_assoc, Matrix.mul_nonsing_inv L hdet, mul_one, hX, smul_pow,
      Matrix.trace_smul, ← Matrix.transpose_pow, Matrix.trace_transpose, smul_eq_mul]

  have gen : ∀ {Kc : Type} [Field Kc] [IsAlgClosed Kc] (A : Matrix (Fin r₂) (Fin r₂) Kc) (n : ℕ),
      (A ^ n).trace = (A.charpoly.roots.map (· ^ n)).sum := by
    intro Kc _ _ A n
    set f : Module.End Kc (Fin r₂ → Kc) := Matrix.toLin' A with hf
    have h1 : (A ^ n).trace = LinearMap.trace Kc (Fin r₂ → Kc) (f ^ n) := by
      rw [← Matrix.trace_toLin'_eq, Matrix.toLin'_pow]
    have h2 : A.charpoly = LinearMap.charpoly f := (Matrix.charpoly_toLin' A).symm
    rw [h1, h2]
    set p := LinearMap.charpoly f with hp
    have s3 : ∀ μ : Kc, LinearMap.trace Kc (f.maxGenEigenspace μ)
        ((f ^ n).restrict (Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.self_pow f n) μ)) =
        (Module.finrank Kc (f.maxGenEigenspace μ) : Kc) * μ ^ n := by
      intro μ
      have hW : Set.MapsTo f (f.maxGenEigenspace μ) (f.maxGenEigenspace μ) :=
        Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.refl f) μ
      set a : Module.End Kc (f.maxGenEigenspace μ) := f.restrict hW with ha_def
      set c : Module.End Kc (f.maxGenEigenspace μ) := algebraMap Kc _ μ with hc_def
      have ha : (f ^ n).restrict
          (Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.self_pow f n) μ) = a ^ n :=
        (Module.End.pow_restrict n hW _).symm
      have hnil : IsNilpotent (a - c) := by
        have := Module.End.isNilpotent_restrict_maxGenEigenspace_sub_algebraMap f μ
        convert this using 1
        ext x
        simp [a, c, LinearMap.coe_restrict_apply, Algebra.algebraMap_eq_smul_one]
        rfl
      have hac : Commute a c := by
        show a * c = c * a
        exact (Algebra.commutes μ a).symm
      have key : ∀ {R : Type} [Ring R] (x y : R), Commute x y → IsNilpotent (x - y) →
          IsNilpotent (x ^ n - y ^ n) := by
        intro R _ x y hxy hn
        have hd : Commute (x - y) x := (Commute.refl x).sub_left hxy.symm
        have hd' : Commute (x - y) y := hxy.sub_left (Commute.refl y)
        have hcomm : Commute (x - y)
            (∑ i ∈ Finset.range n, x ^ i * y ^ (n - 1 - i)) :=
          Commute.sum_right _ _ _ (fun i _ => (hd.pow_right i).mul_right (hd'.pow_right _))
        rw [← hxy.geom_sum₂_mul n]
        exact Commute.isNilpotent_mul_left hcomm.symm hn
      have hnil2 : IsNilpotent (a ^ n - c ^ n) := key a c hac hnil
      have ht : LinearMap.trace Kc _ (a ^ n - c ^ n) = 0 :=
        (LinearMap.isNilpotent_trace_of_isNilpotent hnil2).eq_zero
      rw [ha]
      have h3 := (LinearMap.trace Kc (f.maxGenEigenspace μ)).map_sub (a ^ n) (c ^ n)
      have ht' : LinearMap.trace Kc _ (a ^ n) = LinearMap.trace Kc _ (c ^ n) :=
        sub_eq_zero.mp (h3.symm.trans ht)
      rw [ht', hc_def, ← map_pow, Algebra.algebraMap_eq_smul_one, map_smul, LinearMap.trace_one,
        smul_eq_mul, mul_comm]
    have hI : DirectSum.IsInternal (fun μ => f.maxGenEigenspace μ) :=
      DirectSum.isInternal_submodule_of_iSupIndep_of_iSup_eq_top
        (Module.End.independent_maxGenEigenspace f) (Module.End.iSup_maxGenEigenspace_eq_top f)
    have hb : ∀ μ, f.maxGenEigenspace μ ≠ ⊥ ↔ μ ∈ p.roots.toFinset := by
      intro μ
      rw [Multiset.mem_toFinset, ← Multiset.count_ne_zero, Polynomial.count_roots,
        hp, ← LinearMap.finrank_maxGenEigenspace_eq, ne_eq, ne_eq, Submodule.finrank_eq_zero]
    have hN : {μ | f.maxGenEigenspace μ ≠ ⊥}.Finite := by
      apply (p.roots.toFinset.finite_toSet).subset
      intro μ hμ
      exact (hb μ).1 hμ
    have hmaps := Module.End.mapsTo_maxGenEigenspace_of_comm (Commute.self_pow f n)
    rw [LinearMap.trace_eq_sum_trace_restrict' hI hN hmaps]
    have hfs : hN.toFinset = p.roots.toFinset := by
      ext μ
      rw [Set.Finite.mem_toFinset, ← hb μ]
      rfl
    rw [hfs, Finset.sum_multiset_map_count]
    refine Finset.sum_congr rfl (fun μ _ => ?_)
    rw [s3, LinearMap.finrank_maxGenEigenspace_eq, ← hp, ← Polynomial.count_roots, nsmul_eq_mul]
  have hR : algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]) (M ^ e).trace =
      ((M.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))) ^ e).trace := by
    rw [AddMonoidHom.map_trace, Matrix.map_pow]
  have hL : M.charpoly.aroots (AlgebraicClosure ℚ_[ℓ]) =
      (M.map (algebraMap ℚ_[ℓ] (AlgebraicClosure ℚ_[ℓ]))).charpoly.roots := by
    rw [Polynomial.aroots_def, Matrix.charpoly_map]
  rw [hL, ← gen, ← hR, trM, map_mul, map_pow, map_natCast]

theorem wc_vqtt_frame_cup_tensor_trace (F' F'' : Type u) [Field F'] [Field F''] [Finite F'']
    [Algebra F' F'']
    (Y : Over (Spec (.of F'))) (n : ℕ) (hn : Even n) (hn2 : 2 ≤ n) (D : wcLefschetzDatum F' F'' Y n)
