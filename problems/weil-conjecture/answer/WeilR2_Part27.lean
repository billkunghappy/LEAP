  have hlamF : ∀ l (y : wcCohG K (wcP1Over K) hP G 2),
      lamψ (φl l) (wcCohGFrob K (wcP1Over K) hP G 2 y) =
        (Nat.card K : ℚ_[ℓ]) * ∑ l', B l' l * lamψ (φl l') y := by
    intro l y
