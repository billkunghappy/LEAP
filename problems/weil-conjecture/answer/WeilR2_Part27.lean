      have hd' : g d'.1 = IsLocalRing.closedPoint A := (hgapp d'.1).trans d'.2
      show ∑ d, (C d).indicator (fun _ => c d) d'.1 = c d'
      rw [Finset.sum_eq_single d']
      · rw [Set.indicator_of_mem ((hCf d' d'.1 hd').2 rfl)]
      · intro b _ hb
        have hnm : d'.1 ∉ C b := by
          intro hm
          exact hb (Subtype.ext ((hCf b d'.1 hd').1 hm).symm)
        rw [Set.indicator_of_notMem hnm]
      · intro h
        exact absurd (Finset.mem_univ _) h

  have hxU : x ∈ Uo := (hUo x).mpr hx.2.2
