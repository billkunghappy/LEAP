      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at this
      exact this
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
    calc ∑ l, c l * T l i₀
        = ∑ l, c l * ∑ j : Fin (2 * k) → Fin r, T l j * ∏ a, (P * P') (j a) (i₀ a) := by
