      show wcSpfTruncMap _ _ (wcCxJMap K hP (lamI (a * b))) = _
      rw [hD3, hTf.2.1]⟩

  obtain ⟨γ, hγ, h₁, h₂, hh₁, hh₂⟩ := wcU_sms_relinj_htpy_equiv (ℓ ^ n) (wcSmsBarSmul P n)
    (fun x => wcSpfTruncMap (wcCxJ K hP I.cocomplex) (ℓ ^ n) (wcCxJMap K hP (lamI x)))
    hAct hWact hAN hWN hAI hWI β' hβlin hcone
  have twF : ∀ {Y Y' : CochainComplex AddCommGrpCat.{u+1} ℕ}
      {lamY : MonoidAlgebra ℤ_[ℓ] Γ → (Y ⟶ Y)} {lamY' : MonoidAlgebra ℤ_[ℓ] Γ → (Y' ⟶ Y')}
      (u : Y ⟶ Y') (hu : ∀ x, lamY x ≫ u = u ≫ lamY' x) (k : ℕ),
      (wcSmsTwMap ρ u hu).f k ≫ Limits.kernel.ι (wcSpfTwD (Y'.X k) (fun x => (lamY' x).f k) ρ) =
        Limits.kernel.ι (wcSpfTwD (Y.X k) (fun x => (lamY x).f k) ρ) ≫
          Limits.Pi.map (fun _ => u.f k) := fun u hu k => Limits.kernel.lift_ι _ _ _
  have tw : (∀ {Y Y' Y'' : CochainComplex AddCommGrpCat.{u+1} ℕ}
      {lamY : MonoidAlgebra ℤ_[ℓ] Γ → (Y ⟶ Y)}
      {lamY' : MonoidAlgebra ℤ_[ℓ] Γ → (Y' ⟶ Y')} {lamY'' : MonoidAlgebra ℤ_[ℓ] Γ → (Y'' ⟶ Y'')}
      (u : Y ⟶ Y') (v : Y' ⟶ Y'') (hu : ∀ x, lamY x ≫ u = u ≫ lamY' x)
      (hv : ∀ x, lamY' x ≫ v = v ≫ lamY'' x),
      wcSmsTwMap ρ u hu ≫ wcSmsTwMap ρ v hv = wcSmsTwMap ρ (u ≫ v) (fun x => by
        rw [← Category.assoc, hu, Category.assoc, hv, Category.assoc])) ∧
    (∀ {Y Y' : CochainComplex AddCommGrpCat.{u+1} ℕ} {lamY : MonoidAlgebra ℤ_[ℓ] Γ → (Y ⟶ Y)}
      {lamY' : MonoidAlgebra ℤ_[ℓ] Γ → (Y' ⟶ Y')} (u u' : Y ⟶ Y')
      (hu : ∀ x, lamY x ≫ u = u ≫ lamY' x) (hu' : ∀ x, lamY x ≫ u' = u' ≫ lamY' x),
      u = u' → wcSmsTwMap ρ u hu = wcSmsTwMap ρ u' hu') ∧
    (∀ {Y : CochainComplex AddCommGrpCat.{u+1} ℕ} {lamY : MonoidAlgebra ℤ_[ℓ] Γ → (Y ⟶ Y)}
      (u : Y ⟶ Y) (hu : ∀ x, lamY x ≫ u = u ≫ lamY x), u = 𝟙 Y → wcSmsTwMap ρ u hu = 𝟙 _) := by
    refine ⟨?_, ?_, ?_⟩
    · intro Y Y' Y'' lamY lamY' lamY'' u v hu hv
      apply HomologicalComplex.hom_ext
      intro k
      have ab : ∀ {A B C PA PB PC : AddCommGrpCat.{u+1}} (ιA : A ⟶ PA) (ιB : B ⟶ PB)
