      (Limits.cokernel ((ℓ ^ n : ℕ) • 𝟙 (Subobject.underlying.obj J))) W hWqc hWs ℓ n k θr
      q α hG hα fr hfr ρ hρ μ0 hχ
    obtain ⟨mu, hmu⟩ := wc_h2r_sheafify_lift_offS (wcP1Over K).left
