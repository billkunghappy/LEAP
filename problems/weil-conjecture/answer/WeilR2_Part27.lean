      subst h
      rfl
    · intro Y lamY u hu h
      subst h
      apply HomologicalComplex.hom_ext
      intro k
      have ab : ∀ {A PA : AddCommGrpCat.{u+1}} (ιA : A ⟶ PA) (_ : Mono ιA) (a : A ⟶ A)
