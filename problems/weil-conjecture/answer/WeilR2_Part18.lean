    ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
      (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal R →
    ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
      (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal R →
    ∀ (L : Type u) [Field L] [IsSepClosed L] (φA : A →+* L), Function.Injective φA →
    (letI := φA.toAlgebra; Algebra.IsAlgebraic A L) →
    ∀ (k q : ℕ), 2 ≤ q →
      letI : Algebra A R := (ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
      letI : Algebra A L := φA.toAlgebra
      Subsingleton (wcEtCoh (Spec (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) -
        Polynomial.C ((1 : L) ⊗ₜ[A] ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) : TensorProduct A L R))))) ℓ q) :=
by

  have hv_gen : ∀ (A : Type u) [CommRing A] [IsDomain A]
      [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
      (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A) →
      ∀ (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} →
      ∀ (r : ℕ),
      (∑ p : Fin (r + 2), ∑ q : Fin (r + 2), MvPolynomial.C (wcQmtmC A r p q) * MvPolynomial.X p *
          MvPolynomial.X q : MvPolynomial (Fin (r + 2)) A) =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) →
      ∀ (R : Type u) [CommRing R] [HenselianLocalRing R]
        [IsSepClosed (IsLocalRing.ResidueField R)]
        (ρ : wcQuadModelRing A (r + 2) π (wcQmtmC A r) →+* R),
      WeaklyEtale (Spec.map (CommRingCat.ofHom ρ)) →
      ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal R →
      ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal R →
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ξ : Spec (.of Ω) ⟶ Spec (.of A)),
        ξ (IsLocalRing.closedPoint Ω) ≠ IsLocalRing.closedPoint A →
      ∀ q : ℕ, 2 ≤ q →
        Subsingleton (wcEtCoh (Limits.pullback (Spec.map (CommRingCat.ofHom ρ) ≫
          wcQuadModelStr A (r + 2) π (wcQmtmC A r)) ξ) ℓ q) := by
    intro A _ _ _ _ _ ℓ _ hℓ π hπ r hA R _ _ _ ρ hWE h0 h1 Ω _ _ ξ hξ q hq
    have t_rel : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) *
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) =
        algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)) π := by
      rw [← map_mul, ← hA]
      change _ = Ideal.Quotient.mk _ (MvPolynomial.C π)
      exact Ideal.Quotient.eq.mpr (Ideal.subset_span rfl)
    obtain ⟨y, hy_def⟩ : ∃ y : Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r))),
        Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R) = y := ⟨_, rfl⟩
    have hyI : y.asIdeal = Ideal.comap ρ (IsLocalRing.maximalIdeal R) := by
      rw [← hy_def]
      exact (congrArg PrimeSpectrum.asIdeal
        (Spec.map_apply (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R))).trans rfl
    have hx0 : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ y.asIdeal := by
      rw [hyI]; exact Ideal.mem_comap.mpr h0
    have hx1 : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ y.asIdeal := by
      rw [hyI]; exact Ideal.mem_comap.mpr h1
    have hy : wcQuadModelStr A (r + 2) π (wcQmtmC A r) y = IsLocalRing.closedPoint A := by
      apply PrimeSpectrum.ext
      have e1 : (wcQuadModelStr A (r + 2) π (wcQmtmC A r) y).asIdeal =
          Ideal.comap (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r))) y.asIdeal := by
        show (Spec.map (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r))))
          y).asIdeal = _
        exact (congrArg PrimeSpectrum.asIdeal (Spec.map_apply
          (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))) y)).trans rfl
      rw [e1, hyI, Ideal.comap_comap]
      show Ideal.comap (ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r))))
        (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal A
      symm
      apply Ideal.IsMaximal.eq_of_le (IsLocalRing.maximalIdeal.isMaximal A)
        (Ideal.comap_isPrime _ _).ne_top
      rw [hπ, Ideal.span_le, Set.singleton_subset_iff]
      show ρ (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)) π) ∈ IsLocalRing.maximalIdeal R
      rw [← t_rel, map_mul]
      exact Ideal.mul_mem_left _ _ h1
    obtain ⟨B₁, _, _, _, Λ₁, _, _, W₁, φ₁, a₁, e₁, hI, haff, hcomp, hφa, hlim, hint, heq⟩ :=
      wc_et_geom_strict_henselization y
    have hsh₁ : wcHalShData y B₁ Λ₁ W₁ φ₁ a₁ := ⟨hI, haff, hcomp, hφa, hlim, e₁, hint, heq⟩
    have hresG : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
        (x : Spec (.of (IsLocalRing.ResidueField R))),
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) x = IsLocalRing.closedPoint R := by
      intro R _ _ x
      rw [Spec.map_apply]
      exact (congrArg (PrimeSpectrum.comap (IsLocalRing.residue R))
        (Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField R)) x _)).trans
        ((IsLocalRing.isLocalHom_iff_comap_closedPoint (IsLocalRing.residue R)).mp inferInstance)
    obtain ⟨ε, -, hε⟩ := wc_pltr_wet_residue_geom_point y R (Spec.map (CommRingCat.ofHom ρ)) hWE hy_def
    have hq1 : (Spec.map (CommRingCat.ofHom ε) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))
        (IsLocalRing.closedPoint (AlgebraicClosure
          ((Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).residueField y))) =
        IsLocalRing.closedPoint R :=
      (Scheme.Hom.comp_apply _ _ _).trans (hresG R _)
    have hq2 : (Spec.map (CommRingCat.ofHom ε) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) ≫ Spec.map (CommRingCat.ofHom ρ) =
        wcEtGeomPt (Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))) y :=
      (Category.assoc _ _ _).trans hε
    obtain ⟨δ, hδ, -⟩ := wc_shdata_lift_geom_point y B₁ Λ₁ W₁ φ₁ a₁ hsh₁ R
      (Spec.map (CommRingCat.ofHom ρ)) _ hq1 hq2
    haveI hδiso : IsIso δ := wc_pltr_shens_lift_iso y B₁ Λ₁ W₁ φ₁ a₁ hsh₁ R
      (Spec.map (CommRingCat.ofHom ρ)) hWE hy_def δ hδ
    have hS : Subsingleton (wcEtCoh (Limits.pullback (a₁ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
        ξ) ℓ q) :=
      wc_qmssl_hv_milnor_double A ℓ hℓ π hπ r y hy hx0 hx1 B₁ Λ₁ W₁ φ₁ a₁ hsh₁ Ω ξ hξ q hq
    have eq₁ : (Spec.map (CommRingCat.ofHom ρ) ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) ≫ 𝟙 _ =
        δ ≫ (a₁ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) := by
      rw [Category.comp_id, ← Category.assoc δ a₁, hδ]
    have eq₂ : ξ ≫ 𝟙 _ = 𝟙 _ ≫ ξ := by
      rw [Category.comp_id, Category.id_comp]
    haveI := Limits.pullback.map_isIso
      (Spec.map (CommRingCat.ofHom ρ) ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) ξ
      (a₁ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) ξ δ (𝟙 _) (𝟙 _) eq₁ eq₂
    obtain ⟨E⟩ := wc_et_coh_iso_invariance (Limits.pullback.map
      (Spec.map (CommRingCat.ofHom ρ) ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) ξ
      (a₁ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) ξ δ (𝟙 _) (𝟙 _) eq₁ eq₂) ℓ q
    exact @Equiv.subsingleton _ _ E.symm hS

  have descent : ∀ (A Q R L : Type u) [CommRing A] [CommRing Q] [CommRing R]
      [Field L] [IsSepClosed L] [Algebra A Q] (ρ : Q →+* R) (φA : A →+* L) (n q : ℕ),
      Subsingleton (wcEtCoh (Limits.pullback (Spec.map (CommRingCat.ofHom ρ) ≫
          Spec.map (CommRingCat.ofHom (algebraMap A Q)))
        (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) ≫
          Spec.map (CommRingCat.ofHom φA))) n q) →
      letI : Algebra A R := (ρ.comp (algebraMap A Q)).toAlgebra
      letI : Algebra A L := φA.toAlgebra
      Subsingleton (wcEtCoh (Spec (.of (TensorProduct A L R))) n q) := by
    intro A Q R L _ _ _ _ _ _ ρ φA n q hyp
    letI iAR : Algebra A R := (ρ.comp (algebraMap A Q)).toAlgebra
    letI iAL : Algebra A L := φA.toAlgebra
    obtain ⟨E1⟩ := wc_et_coh_iso_invariance (Limits.pullbackLeftPullbackSndIso
      (Spec.map (CommRingCat.ofHom ρ) ≫ Spec.map (CommRingCat.ofHom (algebraMap A Q)))
      (Spec.map (CommRingCat.ofHom φA))
      (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))).hom n q
    have h1 := @Equiv.subsingleton _ _ E1.symm hyp
    have hint : (algebraMap L (AlgebraicClosure L)).IsIntegral :=
      algebraMap_isIntegral_iff.mpr inferInstance
    obtain ⟨E2⟩ := wc_et_coh_purely_inseparable_invariance L (AlgebraicClosure L) hint _
      (Limits.pullback.snd
        (Spec.map (CommRingCat.ofHom ρ) ≫ Spec.map (CommRingCat.ofHom (algebraMap A Q)))
        (Spec.map (CommRingCat.ofHom φA))) n q
    have h2 := @Equiv.subsingleton _ _ E2.symm h1
    have hf1 : Spec.map (CommRingCat.ofHom ρ) ≫ Spec.map (CommRingCat.ofHom (algebraMap A Q)) =
        Spec.map (CommRingCat.ofHom (algebraMap A R)) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hf2 : Spec.map (CommRingCat.ofHom φA) = Spec.map (CommRingCat.ofHom (algebraMap A L)) := rfl
    let e : Limits.pullback
        (Spec.map (CommRingCat.ofHom ρ) ≫ Spec.map (CommRingCat.ofHom (algebraMap A Q)))
        (Spec.map (CommRingCat.ofHom φA)) ≅ Spec (.of (TensorProduct A L R)) :=
      Limits.pullback.congrHom hf1 hf2 ≪≫ Limits.pullbackSymmetry _ _ ≪≫ pullbackSpecIso A L R
    obtain ⟨E3⟩ := wc_et_coh_iso_invariance e.hom n q
    exact @Equiv.subsingleton _ _ E3 h2
  intro A _ _ _ _ _ ℓ _ hℓ π hπ r R _ _ _ ρ hWE h0 h1 L _ _ φA hφA halg k q hq
  have t_s3 : ∀ (A : Type u) [CommRing A] [IsDomain A] (π : A), π ≠ 0 →
      ∀ (N : ℕ), 0 < N →
      IsDomain (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) →
      ∀ (L : Type u) [Field L] [IsSepClosed L] (φA : A →+* L), Function.Injective φA →
      ((N : ℕ) : L) ≠ 0 →
      ∃ φ' : AdjoinRoot (Polynomial.X ^ N - Polynomial.C π) →+* L,
        φ'.comp (AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C π)) = φA ∧ Function.Injective φ' ∧
        φ' (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π)) ≠ 0 := by
    intro A _ _ π hπ0 N hN hdom L _ _ φA hφA hNL
    have ha : φA π ≠ 0 := by
      intro h; apply hπ0; apply hφA; rw [h, map_zero]
    have hsep : (Polynomial.X ^ N - Polynomial.C (φA π)).Separable :=
      Polynomial.separable_X_pow_sub_C (φA π) hNL ha
    have hdeg : (Polynomial.X ^ N - Polynomial.C (φA π)).degree ≠ 0 := by
      rw [Polynomial.degree_X_pow_sub_C hN]
      exact_mod_cast hN.ne'
    obtain ⟨zL, hzL⟩ := IsSepClosed.exists_root _ hdeg hsep
    have hzL' : zL ^ N = φA π := by
      have := hzL
      simp only [Polynomial.IsRoot, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_C] at this
      exact sub_eq_zero.mp this
    have hev : (Polynomial.X ^ N - Polynomial.C π).eval₂ φA zL = 0 := by
      simp [Polynomial.eval₂_sub, hzL']
    refine ⟨AdjoinRoot.lift φA zL hev, ?_, ?_, ?_⟩
    · ext a
      simp [AdjoinRoot.lift_of]
    · have hmon : (Polynomial.X ^ N - Polynomial.C π).Monic := Polynomial.monic_X_pow_sub_C π hN.ne'
      haveI : Module.Finite A (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) :=
        (AdjoinRoot.powerBasis' hmon).finite
      haveI : Algebra.IsIntegral A (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) :=
        Algebra.IsIntegral.of_finite _ _
      rw [RingHom.injective_iff_ker_eq_bot]
      haveI := hdom
      apply Ideal.eq_bot_of_comap_eq_bot (R := A)
      change Ideal.comap (algebraMap A (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π))) (RingHom.ker _) = ⊥
      rw [RingHom.comap_ker]
      have : (AdjoinRoot.lift φA zL hev).comp (algebraMap A (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π))) = φA := by
        ext a
        exact AdjoinRoot.lift_of hev
      rw [this]
      exact (RingHom.injective_iff_ker_eq_bot φA).mp hφA
    · rw [AdjoinRoot.lift_root]
      intro h
      apply ha
      rw [← hzL', h, zero_pow hN.ne']
  have t_rel : ∀ (B : Type u) [CommRing B] (b : B) (r : ℕ),
      (∑ p : Fin (r + 2), ∑ q : Fin (r + 2), MvPolynomial.C (wcQmtmC B r p q) * MvPolynomial.X p *
            MvPolynomial.X q : MvPolynomial (Fin (r + 2)) B) =
          MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) →
      Ideal.Quotient.mk (wcQuadModelIdeal B (r + 2) b (wcQmtmC B r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) *
        Ideal.Quotient.mk (wcQuadModelIdeal B (r + 2) b (wcQmtmC B r))
