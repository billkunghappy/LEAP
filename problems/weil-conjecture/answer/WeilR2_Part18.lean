theorem wc_tsf_push_slice_bc (S' : Scheme.{u}) {w : S' ⟶ S'} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Dw : wcHMPullData w ℓ) (hDw : wcHMPullCanonical Dw) (V V' : S'.ProEt)
    (fU : V'.left ⟶ V.left) (hpb : IsPullback V'.hom fU w V.hom)
    [(wcSliceFunctor S' V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S')]
    [(wcSliceFunctor S' V').IsContinuous (Scheme.ProEt.topology V'.left) (Scheme.ProEt.topology S')]
    (D : wcHMPullData fU ℓ) (hD : wcHMPullCanonical D) :
    ∃ β : @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC w) _ _ Dw.cont Dw.φ ⋙
          wcSliceRes S' ℓ V ≅
        wcSliceRes S' ℓ V' ⋙ @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC fU) _ _
          D.cont D.φ,
      ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) (T : V.left.ProEt)
        (ζ : (wcSliceFunctor S' V').obj ((wcProEtBC fU).obj T) ⟶
          (wcProEtBC w).obj ((wcSliceFunctor S' V).obj T)),
        ζ.left ≫ Limits.pullback.fst (T.hom ≫ V.hom) w = Limits.pullback.fst T.hom fU →
        ζ.left ≫ Limits.pullback.snd (T.hom ≫ V.hom) w = Limits.pullback.snd T.hom fU ≫ V'.hom →
        ∀ x : ((wcSliceRes S' ℓ V).obj ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
            (wcProEtBC w) _ _ Dw.cont Dw.φ).obj M)).val.obj (Opposite.op T),
          ((β.hom.app M).val.app (Opposite.op T)).hom x = (M.val.map ζ.op).hom x :=
by
  have hBCfst : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) {A B : Y.ProEt} (g : A ⟶ B),
      ((wcProEtBC h).map g).left ≫ Limits.pullback.fst B.hom h = Limits.pullback.fst A.hom h ≫ g.left := by
    intro X Y h A B g
    exact Limits.pullback.lift_fst _ _ _
  have hBCsnd : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) {A B : Y.ProEt} (g : A ⟶ B),
      ((wcProEtBC h).map g).left ≫ Limits.pullback.snd B.hom h = Limits.pullback.snd A.hom h := by
    intro X Y h A B g
    exact Limits.pullback.lift_snd _ _ _
  have sqAux : ∀ {P₁ P₂ Q₁ Q₂ A₁ A₂ B₁ B₂ Z : Scheme.{u}} (a : P₁ ⟶ P₂) (b : Q₁ ⟶ Q₂) (e₁ : P₁ ⟶ Q₁) (e₂ : P₂ ⟶ Q₂) (x₁ : P₁ ⟶ A₁) (x₂ : P₂ ⟶ A₂) (y₁ : P₁ ⟶ B₁) (y₂ : P₂ ⟶ B₂) (p₁ : Q₁ ⟶ A₁) (p₂ : Q₂ ⟶ A₂) (q₁ : Q₁ ⟶ Z) (q₂ : Q₂ ⟶ Z) (gA : A₁ ⟶ A₂) (v₁ : B₁ ⟶ Z) (v₂ : B₂ ⟶ Z) (hext : ∀ φ ψ : P₁ ⟶ Q₂, φ ≫ p₂ = ψ ≫ p₂ → φ ≫ q₂ = ψ ≫ q₂ → φ = ψ) (h1 : e₁ ≫ p₁ = x₁) (h2 : e₂ ≫ p₂ = x₂) (h3 : e₁ ≫ q₁ = y₁ ≫ v₁) (h4 : e₂ ≫ q₂ = y₂ ≫ v₂) (ha1 : a ≫ x₂ = x₁ ≫ gA) (ha2 : a ≫ y₂ ≫ v₂ = y₁ ≫ v₁) (hb1 : b ≫ p₂ = p₁ ≫ gA) (hb2 : b ≫ q₂ = q₁),
      a ≫ e₂ = e₁ ≫ b := by
    intro P₁ P₂ Q₁ Q₂ A₁ A₂ B₁ B₂ Z a b e₁ e₂ x₁ x₂ y₁ y₂ p₁ p₂ q₁ q₂ gA v₁ v₂ hext h1 h2 h3 h4 ha1 ha2 hb1 hb2
    apply hext
    · rw [Category.assoc, Category.assoc, h2, ha1, hb1, ← Category.assoc, h1]
    · rw [Category.assoc, Category.assoc, h4, ha2, hb2, h3]
  have s1 : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) (V : S.ProEt) (V' : S'.ProEt) (fU : V'.left ⟶ V.left) (hpb : IsPullback V'.hom fU f V.hom),
      ∃ ζ : wcProEtBC fU ⋙ wcSliceFunctor S' V' ≅ wcSliceFunctor S V ⋙ wcProEtBC f,
        ∀ T : V.left.ProEt,
          (ζ.hom.app T).left ≫ Limits.pullback.fst (T.hom ≫ V.hom) f = Limits.pullback.fst T.hom fU ∧
          (ζ.hom.app T).left ≫ Limits.pullback.snd (T.hom ≫ V.hom) f =
            Limits.pullback.snd T.hom fU ≫ V'.hom := by
    intro S S' f V V' fU hpb
    have hT : ∀ T : V.left.ProEt, IsPullback (Limits.pullback.fst T.hom fU)
        (Limits.pullback.snd T.hom fU ≫ V'.hom) (T.hom ≫ V.hom) f :=
      fun T => (IsPullback.paste_horiz (IsPullback.of_hasPullback T.hom fU).flip hpb).flip
    let e : ∀ T : V.left.ProEt, ((wcProEtBC fU ⋙ wcSliceFunctor S' V').obj T) ≅
        ((wcSliceFunctor S V ⋙ wcProEtBC f).obj T) :=
      fun T => MorphismProperty.Over.isoMk (hT T).isoPullback (hT T).isoPullback_hom_snd
    refine ⟨NatIso.ofComponents e ?_, fun T => ⟨(hT T).isoPullback_hom_fst, (hT T).isoPullback_hom_snd⟩⟩
    intro T₁ T₂ g
    apply MorphismProperty.Over.Hom.ext
    exact sqAux ((wcProEtBC fU).map g).left ((wcProEtBC f).map ((wcSliceFunctor S V).map g)).left
      (hT T₁).isoPullback.hom (hT T₂).isoPullback.hom
      (Limits.pullback.fst T₁.hom fU) (Limits.pullback.fst T₂.hom fU)
      (Limits.pullback.snd T₁.hom fU) (Limits.pullback.snd T₂.hom fU)
      (Limits.pullback.fst (T₁.hom ≫ V.hom) f) (Limits.pullback.fst (T₂.hom ≫ V.hom) f)
      (Limits.pullback.snd (T₁.hom ≫ V.hom) f) (Limits.pullback.snd (T₂.hom ≫ V.hom) f)
      g.left V'.hom V'.hom
      (fun φ ψ h₁ h₂ => Limits.pullback.hom_ext h₁ h₂)
      (hT T₁).isoPullback_hom_fst (hT T₂).isoPullback_hom_fst
      (hT T₁).isoPullback_hom_snd (hT T₂).isoPullback_hom_snd
      (hBCfst fU g) ((Category.assoc _ _ _).symm.trans (congrArg (· ≫ V'.hom) (hBCsnd fU g)))
      (hBCfst f ((wcSliceFunctor S V).map g)) (hBCsnd f ((wcSliceFunctor S V).map g))
  have s2 : ∀ {S S' : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)] (f : S' ⟶ S) (V : S.ProEt) (V' : S'.ProEt) (fU : V'.left ⟶ V.left) [(wcSliceFunctor S V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)] [(wcSliceFunctor S' V').IsContinuous (Scheme.ProEt.topology V'.left) (Scheme.ProEt.topology S')] (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df) (DfU : wcHMPullData fU ℓ) (hDfU : wcHMPullCanonical DfU) (ζ : wcProEtBC fU ⋙ wcSliceFunctor S' V' ≅ wcSliceFunctor S V ⋙ wcProEtBC f) (hζ : ∀ T : V.left.ProEt, (ζ.hom.app T).left ≫ Limits.pullback.fst (T.hom ≫ V.hom) f = Limits.pullback.fst T.hom fU),
      ∃ β : @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC f) _ _ Df.cont Df.φ ⋙
            wcSliceRes S ℓ V ≅
          wcSliceRes S' ℓ V' ⋙
            @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC fU) _ _ DfU.cont DfU.φ,
        ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) (T : V.left.ProEt)
          (x : ((wcSliceRes S ℓ V).obj ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
              (wcProEtBC f) _ _ Df.cont Df.φ).obj M)).val.obj (Opposite.op T)),
          (ConcreteCategory.hom ((β.hom.app M).val.app (Opposite.op T))) x =
            (ConcreteCategory.hom (M.val.map (ζ.hom.app T).op)) x := by
    intro S S' ℓ _ f V V' fU _ _ Df hDf DfU hDfU ζ hζ
    haveI := Df.cont
    haveI := DfU.cont
    haveI : (wcSliceFunctor S V ⋙ wcProEtBC f).IsContinuous (Scheme.ProEt.topology V.left)
        (Scheme.ProEt.topology S') := Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S) _
    haveI : (wcProEtBC fU ⋙ wcSliceFunctor S' V').IsContinuous (Scheme.ProEt.topology V.left)
        (Scheme.ProEt.topology S') := Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology V'.left) _
    let φ₁ : wcRingSheaf V.left ℓ ⟶ ((wcSliceFunctor S V ⋙ wcProEtBC f).sheafPushforwardContinuous
        RingCat.{u+1} (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S')).obj
          (wcRingSheaf S' ℓ) :=
      (𝟙 (wcRingSheaf V.left ℓ)) ≫ ((wcSliceFunctor S V).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S)).map Df.φ
    let φ₂ : wcRingSheaf V.left ℓ ⟶ ((wcProEtBC fU ⋙ wcSliceFunctor S' V').sheafPushforwardContinuous
        RingCat.{u+1} (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S')).obj
          (wcRingSheaf S' ℓ) :=
      DfU.φ ≫ ((wcProEtBC fU).sheafPushforwardContinuous
      RingCat.{u+1} (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology V'.left)).map
        (𝟙 (wcRingSheaf V'.left ℓ))
    have h : φ₁ ≫ (Functor.sheafPushforwardContinuousNatTrans ζ.hom RingCat.{u+1}
        (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S')).app (wcRingSheaf S' ℓ) = φ₂ := by
      apply Sheaf.hom_ext
      apply NatTrans.ext
      funext T
      cases T with
      | op T =>
      apply RingCat.hom_ext
      apply RingHom.ext
      intro s
      have e1 := hDf ((wcSliceFunctor S V).obj T) s
      have e2 := hDfU T s
      change ((Df.φ.hom.app (Opposite.op ((wcSliceFunctor S V).obj T))).hom s).comp
          (ζ.hom.app T).left.base.hom = (DfU.φ.hom.app (Opposite.op T)).hom s
      rw [e1, e2, ← hζ T]
      rfl
    refine ⟨SheafOfModules.pushforwardComp (F := wcSliceFunctor S V) (G := wcProEtBC f)
        (S := wcRingSheaf V.left ℓ) (R := wcRingSheaf S ℓ) (R' := wcRingSheaf S' ℓ)
        (𝟙 (wcRingSheaf V.left ℓ)) Df.φ ≪≫
      SheafOfModules.pushforwardNatIso φ₁ ζ ≪≫ SheafOfModules.pushforwardCongr h ≪≫
      (SheafOfModules.pushforwardComp (F := wcProEtBC fU) (G := wcSliceFunctor S' V')
        (S := wcRingSheaf V.left ℓ) (R := wcRingSheaf V'.left ℓ) (R' := wcRingSheaf S' ℓ)
        DfU.φ (𝟙 (wcRingSheaf V'.left ℓ))).symm, ?_⟩
    intro M T x
    exact SheafOfModules.pushforwardNatTrans_app_val_app φ₁ ζ.hom M (Opposite.op T) x
  obtain ⟨ζ, hζ⟩ := s1 w V V' fU hpb
  obtain ⟨β, hβ⟩ := s2 w V V' fU Dw hDw D hD ζ (fun T => (hζ T).1)
  refine ⟨β, ?_⟩
  intro M T ζ' h1 h2 x
  have key : ζ' = ζ.hom.app T := by
    apply MorphismProperty.Over.Hom.ext
    exact Limits.pullback.hom_ext (h1.trans (hζ T).1.symm) (h2.trans (hζ T).2.symm)
  subst key
  exact hβ M T x

theorem wc_tsf_bc_unit_compat (S' : Scheme.{u}) {w : S' ⟶ S'} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Dw : wcHMPullData w ℓ) (hDw : wcHMPullCanonical Dw)
    (P : S'.ProEt → SheafOfModules.{u+1} (wcRingSheaf S' ℓ))
    (ev : ∀ (W : S'.ProEt) (M : SheafOfModules.{u+1} (wcRingSheaf S' ℓ)),
      (P W ⟶ M) ≃ M.val.obj (Opposite.op W))
    (hnat : ∀ (W : S'.ProEt) (M N : SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) (ψ : M ⟶ N)
      (g : P W ⟶ M), ev W N (g ≫ ψ) = (ψ.val.app (Opposite.op W)).hom (ev W M g))
    (V : S'.ProEt)
    [(wcSliceFunctor S' V).IsContinuous (Scheme.ProEt.topology V.left) (Scheme.ProEt.topology S')]
    [(wcSliceFunctor S' ((wcProEtBC w).obj V)).IsContinuous
      (Scheme.ProEt.topology ((wcProEtBC w).obj V).left) (Scheme.ProEt.topology S')]
    (D : wcHMPullData (Limits.pullback.fst V.hom w) ℓ) (hD : wcHMPullCanonical D)
    (β : @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC w) _ _ Dw.cont Dw.φ ⋙
        wcSliceRes S' ℓ V ⟶ wcSliceRes S' ℓ ((wcProEtBC w).obj V) ⋙
        @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC (Limits.pullback.fst V.hom w)) _ _
          D.cont D.φ)
    (hβ : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) (T : V.left.ProEt)
      (ζ : (wcSliceFunctor S' ((wcProEtBC w).obj V)).obj
          ((wcProEtBC (Limits.pullback.fst V.hom w)).obj T) ⟶
        (wcProEtBC w).obj ((wcSliceFunctor S' V).obj T)),
      ζ.left ≫ Limits.pullback.fst (T.hom ≫ V.hom) w =
        Limits.pullback.fst T.hom (Limits.pullback.fst V.hom w) →
      ζ.left ≫ Limits.pullback.snd (T.hom ≫ V.hom) w =
        Limits.pullback.snd T.hom (Limits.pullback.fst V.hom w) ≫ ((wcProEtBC w).obj V).hom →
      ∀ x : ((wcSliceRes S' ℓ V).obj ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
          (wcProEtBC w) _ _ Dw.cont Dw.φ).obj M)).val.obj (Opposite.op T),
        ((β.app M).val.app (Opposite.op T)).hom x = (M.val.map ζ.op).hom x)
    (εV : SheafOfModules.unit (wcRingSheaf V.left ℓ) ⟶ (wcSliceRes S' ℓ V).obj (P V))
    (hεV : ∀ (T : V.left.ProEt) (h : (wcSliceFunctor S' V).obj T ⟶ V), h.left = T.hom →
      (εV.val.app (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])) =
        ((P V).val.map h.op).hom (ev V (P V) (𝟙 (P V))))
    (εV' : SheafOfModules.unit (wcRingSheaf ((wcProEtBC w).obj V).left ℓ) ⟶
      (wcSliceRes S' ℓ ((wcProEtBC w).obj V)).obj (P ((wcProEtBC w).obj V)))
    (hεV' : ∀ (T : ((wcProEtBC w).obj V).left.ProEt)
      (h : (wcSliceFunctor S' ((wcProEtBC w).obj V)).obj T ⟶ (wcProEtBC w).obj V),
      h.left = T.hom →
      (εV'.val.app (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])) =
        ((P ((wcProEtBC w).obj V)).val.map h.op).hom
          (ev ((wcProEtBC w).obj V) (P ((wcProEtBC w).obj V)) (𝟙 _))) :
    εV ≫ (wcSliceRes S' ℓ V).map (Dw.adj.unit.app (P V)) ≫ β.app (Dw.Φ.obj (P V)) =
        @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC (Limits.pullback.fst V.hom w)) _ _ D.cont D.φ ≫
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC (Limits.pullback.fst V.hom w)) _ _
          D.cont D.φ).map
          (εV' ≫ (wcSliceRes S' ℓ ((wcProEtBC w).obj V)).map (wcTsfKappa Dw P ev V)) ∧
      wcSliceUnit S' ℓ V ≫ (wcSliceRes S' ℓ V).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC w) _ _ Dw.cont Dw.φ) ≫
        β.app (SheafOfModules.unit (wcRingSheaf S' ℓ)) =
        @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC (Limits.pullback.fst V.hom w)) _ _ D.cont D.φ ≫
        (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC (Limits.pullback.fst V.hom w)) _ _
          D.cont D.φ).map (wcSliceUnit S' ℓ ((wcProEtBC w).obj V)) :=
by
  classical
  haveI := Dw.cont
  haveI := D.cont
  have red : ∀ {Y : Scheme.{u}} {M : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)}
      (f g : SheafOfModules.unit (wcRingSheaf Y ℓ) ⟶ M),
      (∀ T : Y.ProEt, (f.val.app (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])) =
        (g.val.app (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ]))) → f = g := by
    intro Y M f g H
    apply M.unitHomEquiv.injective
    apply PresheafOfModules.sections_ext
    intro X
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    exact H X.unop
  have hκ : ∀ (T₀ : Scheme.{u}) (V₀ : T₀.ProEt)
      [(wcSliceFunctor T₀ V₀).IsContinuous (Scheme.ProEt.topology V₀.left)
        (Scheme.ProEt.topology T₀)]
      (T : V₀.left.ProEt),
      ((wcSliceUnit T₀ ℓ V₀).val.app (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])) =
        (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])) := by
    intro T₀ V₀ _ T
    unfold wcSliceUnit
    first
      | (erw [SheafOfModules.unitToPushforwardObjUnit_val_app_apply]; rfl)
      | exact (SheafOfModules.unitToPushforwardObjUnit_val_app_apply _ _).trans rfl
      | rfl
  have hBCfst : ∀ {X Y : Scheme.{u}} (hh : X ⟶ Y) {A B : Y.ProEt} (g : A ⟶ B),
      ((wcProEtBC hh).map g).left ≫ Limits.pullback.fst B.hom hh =
        Limits.pullback.fst A.hom hh ≫ g.left := by
    intro X Y hh A B g
    exact Limits.pullback.lift_fst _ _ _
  have hBCsnd : ∀ {X Y : Scheme.{u}} (hh : X ⟶ Y) {A B : Y.ProEt} (g : A ⟶ B),
      ((wcProEtBC hh).map g).left ≫ Limits.pullback.snd B.hom hh =
        Limits.pullback.snd A.hom hh := by
    intro X Y hh A B g
    exact Limits.pullback.lift_snd _ _ _
  obtain ⟨k, hk⟩ : ∃ k : (Dw.Φ.obj (P V)).val.obj (Opposite.op ((wcProEtBC w).obj V)),
      ((Dw.adj.unit.app (P V)).val.app (Opposite.op V)).hom (ev V (P V) (𝟙 (P V))) = k :=
    ⟨_, rfl⟩
  have s3 : ((wcTsfKappa Dw P ev V).val.app (Opposite.op ((wcProEtBC w).obj V))).hom
      (ev ((wcProEtBC w).obj V) (P ((wcProEtBC w).obj V)) (𝟙 (P ((wcProEtBC w).obj V)))) = k := by
    have h1 := hnat ((wcProEtBC w).obj V) (P ((wcProEtBC w).obj V)) (Dw.Φ.obj (P V))
      (wcTsfKappa Dw P ev V) (𝟙 (P ((wcProEtBC w).obj V)))
    rw [Category.id_comp] at h1
    rw [← h1, ← hk]
    exact Equiv.apply_symm_apply _ _
  have key : ∀ T : V.left.ProEt, ∃ (h : (wcSliceFunctor S' V).obj T ⟶ V)
      (h' : (wcSliceFunctor S' ((wcProEtBC w).obj V)).obj
          ((wcProEtBC (Limits.pullback.fst V.hom w)).obj T) ⟶ (wcProEtBC w).obj V)
      (ζ : (wcSliceFunctor S' ((wcProEtBC w).obj V)).obj
          ((wcProEtBC (Limits.pullback.fst V.hom w)).obj T) ⟶
        (wcProEtBC w).obj ((wcSliceFunctor S' V).obj T)),
      h.left = T.hom ∧ h'.left = ((wcProEtBC (Limits.pullback.fst V.hom w)).obj T).hom ∧
      ζ.left ≫ Limits.pullback.fst (T.hom ≫ V.hom) w =
        Limits.pullback.fst T.hom (Limits.pullback.fst V.hom w) ∧
      ζ.left ≫ Limits.pullback.snd (T.hom ≫ V.hom) w =
        Limits.pullback.snd T.hom (Limits.pullback.fst V.hom w) ≫ ((wcProEtBC w).obj V).hom ∧
      ζ ≫ (wcProEtBC w).map h = h' := by
    intro T
    have hT : Limits.pullback.fst T.hom (Limits.pullback.fst V.hom w) ≫ (T.hom ≫ V.hom) =
        (Limits.pullback.snd T.hom (Limits.pullback.fst V.hom w) ≫
          Limits.pullback.snd V.hom w) ≫ w := by
      simp only [Category.assoc]
      rw [Limits.pullback.condition_assoc, Limits.pullback.condition]
    refine ⟨MorphismProperty.Over.homMk T.hom rfl trivial,
      MorphismProperty.Over.homMk ((wcProEtBC (Limits.pullback.fst V.hom w)).obj T).hom rfl trivial,
      MorphismProperty.Over.homMk (Limits.pullback.lift _ _ hT)
        (Limits.pullback.lift_snd _ _ hT) trivial, rfl, rfl,
      Limits.pullback.lift_fst _ _ hT, Limits.pullback.lift_snd _ _ hT, ?_⟩
    apply MorphismProperty.Over.Hom.ext
    show Limits.pullback.lift _ _ hT ≫ ((wcProEtBC w).map
        (MorphismProperty.Over.homMk T.hom rfl trivial :
          (wcSliceFunctor S' V).obj T ⟶ V)).left =
      Limits.pullback.snd T.hom (Limits.pullback.fst V.hom w)
