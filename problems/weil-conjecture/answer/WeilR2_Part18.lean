          ((Pg.mapHomologicalComplex (ComplexShape.up ℤ)).map fK)) ≫ θ.hom =
        θ.hom ≫ (Pβ.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map
          (ObjectProperty.homMk
            (X := (⟨_, hP'⟩ : DerivedCategory.Plus (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))))
            (Y := (⟨_, hP'⟩ : DerivedCategory.Plus (SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ))))
            (DerivedCategory.Q.map ((Di'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map fK))) :=
by
  intro P' K' Pg Pβ hP'
  haveI := Dp'.additive
  haveI := Di'.additive
  haveI := Di.additive
  haveI := Dg.additive
  haveI := Dβ.additive
  haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj
  haveI : Pg.Additive := Adjunction.right_adjoint_additive Dg.adj
  haveI : Pβ.Additive := Adjunction.right_adjoint_additive Dβ.adj
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
