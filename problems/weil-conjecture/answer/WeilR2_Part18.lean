          (NatTrans.mapHomologicalComplex γ₀ (ComplexShape.up ℤ)).app K₀) := by
    intro Φ G Φ₂ G₂ _ _ _ _ P₀ _ adj adj₂ c γ₀ γ₂₀ hC1 O u₀ u₂ hu K₀ ι' t₀ ht₀
    let τ : ∀ i, K₀.X i ⟶ G.obj (K₀.X i) := fun i => adj.homEquiv _ _ (t₀.f i)
    have hτ : ∀ i j, K₀.d i j ≫ τ j = τ i ≫ G.map (K₀.d i j) := by
      intro i j
      have hc := t₀.comm i j
      simp only [Functor.mapHomologicalComplex_obj_d] at hc
      simp only [τ]
      rw [← Adjunction.homEquiv_naturality_left, ← Adjunction.homEquiv_naturality_right, hc]
    let σ : ∀ i, K₀.X i ⟶ G₂.obj (K₀.X i) := fun i => τ i ≫ G.map (τ i) ≫ c.app (K₀.X i)
    have hσ : ∀ i j, K₀.d i j ≫ σ j = σ i ≫ G₂.map (K₀.d i j) := by
      intro i j
      have nat := c.naturality (K₀.d i j)
      simp only [Functor.comp_map] at nat
      simp only [σ]
      rw [reassoc_of% (hτ i j), ← G.map_comp_assoc, hτ i j, G.map_comp_assoc, nat]
      simp only [Category.assoc]
    let t₂ : (Φ₂.mapHomologicalComplex (ComplexShape.up ℤ)).obj K₀ ⟶ K₀ :=
      { f := fun i => (adj₂.homEquiv _ _).symm (σ i)
        comm' := by
          intro i j _
          simp only [Functor.mapHomologicalComplex_obj_d]
          rw [← Adjunction.homEquiv_naturality_right_symm,
            ← Adjunction.homEquiv_naturality_left_symm, hσ] }
    have ht₂f : ∀ i, t₂.f i = (adj₂.homEquiv _ _).symm (σ i) := fun i => rfl
    refine ⟨t₂, ?_, ?_⟩
    · apply HomologicalComplex.hom_ext
      intro i
      by_cases hi : i = 0
      · subst hi
        have h0 := congrArg (fun φ => HomologicalComplex.Hom.f φ 0) ht₀
        simp only [HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f,
          HomologicalComplex.singleMapHomologicalComplex_hom_app_self,
          HomologicalComplex.single_map_f_self, Category.assoc, Iso.inv_hom_id_assoc] at h0 ⊢
        set s := HomologicalComplex.singleObjXSelf
          (V := SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) (ComplexShape.up ℤ) 0 O with hs
        set j := s.inv ≫ ι'.f 0 with hj
        have E2 : ι'.f 0 ≫ τ 0 = s.hom ≫ u₀ ≫ G.map j := by
          have h1 := congrArg (adj.homEquiv _ _) h0
          simp only [τ]
          rw [Adjunction.homEquiv_naturality_left] at h1
          rw [h1, Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right,
            Equiv.apply_symm_apply]
        have E2' : j ≫ τ 0 = u₀ ≫ G.map j := by
          rw [hj, Category.assoc, E2, Iso.inv_hom_id_assoc]
        have key : ι'.f 0 ≫ σ 0 = s.hom ≫ u₂ ≫ G₂.map j := by
          have nat := c.naturality j
          simp only [Functor.comp_map] at nat
          simp only [σ]
          rw [reassoc_of% E2, ← G.map_comp_assoc, E2', G.map_comp_assoc, nat, ← hu]
          simp only [Category.assoc]
        apply (adj₂.homEquiv _ _).injective
        rw [ht₂f, Adjunction.homEquiv_naturality_left, Equiv.apply_symm_apply, key,
          Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right,
          Equiv.apply_symm_apply]
      · exact (Functor.map_isZero Φ₂
          (HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 O i hi)).eq_of_src _ _
    · apply HomologicalComplex.hom_ext
      intro i
      simp only [HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f,
        Functor.mapHomologicalComplexCompIso_hom_app_f,
        Functor.mapHomologicalComplexCompIso_inv_app_f,
        NatTrans.mapHomologicalComplex_app_f, Functor.mapHomologicalComplexIdIso_inv_app_f,
        Iso.refl_hom, Iso.refl_inv, NatTrans.id_app, Category.id_comp,
        Functor.id_obj, Functor.comp_obj]
      have e1 : adj.unit.app (K₀.X i) ≫ 𝟙 (G.obj (Φ.obj (K₀.X i))) ≫ G.map (t₀.f i) = τ i :=
        (congrArg (fun m => adj.unit.app (K₀.X i) ≫ m) (Category.id_comp _)).trans
          (Adjunction.homEquiv_unit adj _ _ (t₀.f i)).symm
      have e2 : adj₂.unit.app (K₀.X i) ≫ 𝟙 (G₂.obj (Φ₂.obj (K₀.X i))) ≫ G₂.map (t₂.f i) =
          σ i :=
        (congrArg (fun m => adj₂.unit.app (K₀.X i) ≫ m) (Category.id_comp _)).trans
          ((Adjunction.homEquiv_unit adj₂ _ _ (t₂.f i)).symm.trans (Equiv.apply_symm_apply _ _))
      have i1 : 𝟙 (P₀.obj (G.obj (K₀.X i))) ≫ γ₀.app (K₀.X i) = γ₀.app (K₀.X i) :=
        Category.id_comp _
      have i2 : 𝟙 (P₀.obj (G₂.obj (K₀.X i))) ≫ γ₂₀.app (K₀.X i) = γ₂₀.app (K₀.X i) :=
        Category.id_comp _
      erw [e1, e2, i1, i2]
      have nat := γ₀.naturality (τ i)
      simp only [Functor.comp_map] at nat
      simp only [σ, Functor.map_comp, Category.assoc]
      rw [← reassoc_of% nat, hC1]

  intro α hφ t ht P Pw K γ Tflat T TΨ
  haveI := Df.cont
  haveI := Dw.cont
  haveI := Df.additive
  haveI := Dw.additive
  haveI := Dg.additive
  obtain ⟨D₂, hD₂⟩ := wc_hm_pull_data_exists (w ≫ w) ℓ
  haveI := D₂.cont
  haveI := D₂.additive
  haveI : (wcProEtBC w ⋙ wcProEtBC w).IsContinuous
      (Scheme.ProEt.topology S') (Scheme.ProEt.topology S') :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S') _
  haveI : (wcProEtBC f ⋙ wcProEtBC w).IsContinuous
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S') _
  haveI : (wcProEtBC f ⋙ wcProEtBC (w ≫ w)).IsContinuous
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S') _
  have hφ₂ := compat (w ≫ w) f f hcomp₂.symm D₂ hD₂ Df hDf Df hDf
  have hcc := compat w w (w ≫ w) rfl Dw hDw Dw hDw D₂ hD₂
  let α' : wcProEtBC (w ≫ w) ⟶ wcProEtBC w ⋙ wcProEtBC w :=
    letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong
        (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
      (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
        (inferInstance : Pr.IsStableUnderBaseChangeAlong w)) (@WeaklyEtale : MorphismProperty Scheme.{u})
    (MorphismProperty.Over.pullbackComp (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
      (Q := ⊤) w w (w ≫ w) rfl).hom
  let α₂ : wcProEtBC f ⟶ wcProEtBC f ⋙ wcProEtBC (w ≫ w) :=
    letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong
        (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
      (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
        (inferInstance : Pr.IsStableUnderBaseChangeAlong f)) (@WeaklyEtale : MorphismProperty Scheme.{u})
    letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u})
        (w ≫ w) := ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong
        (@WeaklyEtale : MorphismProperty Scheme.{u}) (w ≫ w) :=
      (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
        (inferInstance : Pr.IsStableUnderBaseChangeAlong (w ≫ w)))
        (@WeaklyEtale : MorphismProperty Scheme.{u})
    (MorphismProperty.Over.pullbackComp (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
      (Q := ⊤) _ _ _ hcomp₂.symm).hom
  have hSI : ∀ V, α.app V ≫ (wcProEtBC w).map (α.app V) =
      α₂.app V ≫ α'.app ((wcProEtBC f).obj V) := fun V =>
    @gen_SI (@WeaklyEtale : MorphismProperty Scheme.{u}) inferInstance
      (fun _ => ⟨fun _ _ => inferInstance⟩) _ _ f w hcomp hcomp₂ V
  have hC1 := gen_C1 (wcProEtBC f) (wcProEtBC w) (wcProEtBC (w ≫ w)) (wcRingSheaf S ℓ)
    (wcRingSheaf S' ℓ) Df.φ Dw.φ D₂.φ α α₂ α' hSI hφ hφ₂ hcc
  have hC2 := gen_C2 (wcProEtBC w) (wcProEtBC (w ≫ w)) (wcRingSheaf S' ℓ) Dw.φ D₂.φ α' hcc
  let Pw₂ := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
    (wcProEtBC (w ≫ w)) _ _ D₂.cont D₂.φ
  haveI : P.Additive := Adjunction.right_adjoint_additive Df.adj
  haveI : Pw.Additive := Adjunction.right_adjoint_additive Dw.adj
  haveI : Pw₂.Additive := Adjunction.right_adjoint_additive D₂.adj
  obtain ⟨t₂, hLP₂, hsq⟩ := abs_sq Dw.Φ Pw D₂.Φ Pw₂ P Dw.adj D₂.adj
    ((SheafOfModules.pushforwardComp Dw.φ Dw.φ).hom ≫
      SheafOfModules.pushforwardNatTrans _ α' ≫ (SheafOfModules.pushforwardCongr hcc).hom)
    γ
    ((SheafOfModules.pushforwardComp Df.φ D₂.φ).hom ≫
      SheafOfModules.pushforwardNatTrans _ α₂ ≫ (SheafOfModules.pushforwardCongr hφ₂).hom)
    hC1 (SheafOfModules.unit (wcRingSheaf S' ℓ))
    (SheafOfModules.unitToPushforwardObjUnit Dw.φ) (SheafOfModules.unitToPushforwardObjUnit D₂.φ)
    hC2 I.cochainComplex I.ι' t ht
  refine ⟨D₂, hD₂, ?_⟩
  intro α₂'
  refine ⟨hφ₂, t₂, hLP₂, ?_⟩
  intro Pw₂' γ₂' Tflat₂ T₂ TΨ₂
  have e : T₂ = T ≫ T := hsq
  have e2 : TΨ₂ = TΨ ≫ TΨ := by
    show (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map T₂ = _
    rw [e, Functor.map_comp]
  rw [e2, Functor.map_comp]

theorem wc_qmbt_eisenstein_base (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit ((ℓ : ℕ) : A)) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) :
    ∃ (A' : Type u) (_ : CommRing A') (_ : IsDomain A') (_ : IsDiscreteValuationRing A')
      (_ : HenselianLocalRing A') (_ : IsSepClosed (IsLocalRing.ResidueField A'))
      (ιA : A →+* A') (π' : A')
      (κ : IsLocalRing.ResidueField A →+* IsLocalRing.ResidueField A'),
      κ.comp (IsLocalRing.residue A) = (IsLocalRing.residue A').comp ιA ∧
      IsUnit ((ℓ : ℕ) : A') ∧ IsLocalRing.maximalIdeal A' = Ideal.span {π'} ∧ π' ^ 2 = ιA π ∧
      (∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π') ∧
      ∀ (L : Type u) [Field L] (φA : A →+* L), Function.Injective φA →
        (letI := φA.toAlgebra; Algebra.IsAlgebraic A L) →
      ∀ (L' : Type u) [Field L'] (ιL : L →+* L'), (letI := ιL.toAlgebra; Algebra.IsAlgebraic L L') →
      ∀ S' : L', S' ^ 2 = ιL (φA π) →
      ∃ φ' : A' →+* L', Function.Injective φ' ∧ (letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L') ∧
        φ'.comp ιA = ιL.comp φA ∧ φ' π' = S' :=
by
  classical

  have hirr : Irreducible π := (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mpr hπ
  have hπ0 : π ≠ 0 := hirr.ne_zero
  have hπmem : π ∈ IsLocalRing.maximalIdeal A := by rw [hπ]; exact Ideal.mem_span_singleton_self π
  have hπnu : ¬ IsUnit π :=
    mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hπmem)
  have hN : ∀ x y : A, x ^ 2 = y ^ 2 * π → x = 0 ∧ y = 0 := by
    intro x y hxy
    by_cases hy : y = 0
    · subst hy
      refine ⟨?_, rfl⟩
      have h0 : x ^ 2 = 0 := by rw [hxy]; ring
      exact pow_eq_zero_iff (two_ne_zero) |>.mp h0
    · exfalso
      by_cases hx : x = 0
      · subst hx
        have : y ^ 2 * π ≠ 0 := mul_ne_zero (pow_ne_zero 2 hy) hπ0
        exact this (by rw [← hxy]; ring)
      · obtain ⟨m, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hx hirr
        obtain ⟨n, w, hw⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hy hirr
        have h1 : ((u ^ 2 : Aˣ) : A) * π ^ (2 * m) = ((w ^ 2 : Aˣ) : A) * π ^ (2 * n + 1) := by
          rw [Units.val_pow_eq_pow_val, Units.val_pow_eq_pow_val]
          calc (u : A) ^ 2 * π ^ (2 * m) = x ^ 2 := by rw [hu]; ring
            _ = y ^ 2 * π := hxy
            _ = (w : A) ^ 2 * π ^ (2 * n + 1) := by rw [hw]; ring
        have := IsDiscreteValuationRing.unit_mul_pow_congr_pow hirr hirr _ _ _ _ h1
        omega

  obtain ⟨f, hf⟩ : ∃ f : Polynomial A, f = Polynomial.X ^ 2 - Polynomial.C π := ⟨_, rfl⟩
  have hmonic : f.Monic := by rw [hf]; exact Polynomial.monic_X_pow_sub_C π two_ne_zero
  have hdeg : f.degree = 2 := by rw [hf]; exact Polynomial.degree_X_pow_sub_C (by norm_num) π
  have hs : AdjoinRoot.root f ^ 2 = AdjoinRoot.of f π := by
    have h : AdjoinRoot.mk f (Polynomial.X ^ 2 - Polynomial.C π) = 0 := by
      rw [← hf]; exact AdjoinRoot.mk_self
    rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h
    exact h
  have hrep : ∀ z : AdjoinRoot f, ∃ x y : A,
      z = AdjoinRoot.of f x + AdjoinRoot.of f y * AdjoinRoot.root f := by
    intro z
    obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective z
    have hlt : (Polynomial.modByMonic p f).degree < 2 := by
      rw [← hdeg]; exact Polynomial.degree_modByMonic_lt p hmonic
    have hle : (Polynomial.modByMonic p f).degree ≤ 1 := Order.le_of_lt_succ hlt
    have e1 := Polynomial.eq_X_add_C_of_degree_le_one hle
    refine ⟨(Polynomial.modByMonic p f).coeff 0, (Polynomial.modByMonic p f).coeff 1, ?_⟩
    have e2 : AdjoinRoot.mk f p = AdjoinRoot.mk f (Polynomial.modByMonic p f) := by
      conv_lhs => rw [← Polynomial.modByMonic_add_div p f]
      rw [map_add, map_mul, AdjoinRoot.mk_self, zero_mul, add_zero]
    rw [e2]
    conv_lhs => rw [e1]
    simp only [map_add, map_mul, AdjoinRoot.mk_C, AdjoinRoot.mk_X]
    ring
  have huniq : ∀ x y : A,
      AdjoinRoot.of f x + AdjoinRoot.of f y * AdjoinRoot.root f = 0 → x = 0 ∧ y = 0 := by
    intro x y h
    have h1 : AdjoinRoot.mk f (Polynomial.C x + Polynomial.C y * Polynomial.X) = 0 := by
      simp only [map_add, map_mul, AdjoinRoot.mk_C, AdjoinRoot.mk_X]; exact h
    rw [AdjoinRoot.mk_eq_zero] at h1
    have hq : Polynomial.C x + Polynomial.C y * Polynomial.X = 0 := by
      by_contra hq0
      have hd1 : (Polynomial.C x + Polynomial.C y * Polynomial.X).degree ≤ 1 := by
        rw [add_comm]; exact Polynomial.degree_linear_le
      have hdq : (Polynomial.C x + Polynomial.C y * Polynomial.X).degree < f.degree := by
        rw [hdeg]
        exact lt_of_le_of_lt hd1 (by norm_num)
      exact hmonic.not_dvd_of_degree_lt hq0 hdq h1
    have hc0 := congrArg (fun q => Polynomial.coeff q 0) hq
    have hc1 := congrArg (fun q => Polynomial.coeff q 1) hq
    simp at hc0 hc1
    exact ⟨hc0, hc1⟩

  have key : ∀ (R : Type u) [CommRing R] [IsNoetherianRing R] (ι : A →+* R) (s : R),
      s ^ 2 = ι π → (∀ r : R, ∃ x y : A, r = ι x + ι y * s) →
      (∀ x y : A, ι x + ι y * s = 0 → x = 0 ∧ y = 0) →
      ∃ (_ : IsDomain R) (_ : IsDiscreteValuationRing R),
        IsLocalRing.maximalIdeal R = Ideal.span {s} ∧ IsLocalHom ι := by
    intro R _ _ ι s hs hrep huniq
    have huniq2 : ∀ a b c d : A, ι a + ι b * s = ι c + ι d * s → a = c ∧ b = d := by
      intro a b c d h
      have := huniq (a - c) (b - d) (by rw [map_sub, map_sub]; linear_combination h)
      exact ⟨sub_eq_zero.mp this.1, sub_eq_zero.mp this.2⟩
    have hιinj : ∀ a : A, ι a = 0 → a = 0 := fun a h => (huniq a 0 (by simp [h])).1
    have hnt : Nontrivial R := by
      refine ⟨⟨0, 1, fun h => ?_⟩⟩
      have := (huniq 1 0 (by rw [map_one, map_zero, zero_mul, add_zero]; exact h.symm)).1
      exact one_ne_zero this
    have hnorm : ∀ x y : A, (ι x + ι y * s) * (ι x + ι (-y) * s) = ι (x ^ 2 - y ^ 2 * π) := by
      intro x y
      simp only [map_mul, map_neg, map_sub, map_pow]
      linear_combination (-(ι y) ^ 2) * hs
    have hdom : IsDomain R := by
      have : NoZeroDivisors R := by
        refine ⟨fun {r₁ r₂} h => ?_⟩
        obtain ⟨x₁, y₁, rfl⟩ := hrep r₁
        obtain ⟨x₂, y₂, rfl⟩ := hrep r₂
        have e : ι ((x₁ ^ 2 - y₁ ^ 2 * π) * (x₂ ^ 2 - y₂ ^ 2 * π)) = 0 := by
          rw [map_mul, ← hnorm, ← hnorm]
          calc _ = ((ι x₁ + ι y₁ * s) * (ι x₂ + ι y₂ * s)) *
                ((ι x₁ + ι (-y₁) * s) * (ι x₂ + ι (-y₂) * s)) := by ring
            _ = 0 := by rw [h, zero_mul]
        rcases mul_eq_zero.mp (hιinj _ e) with h1 | h1
        · left
          obtain ⟨hx, hy⟩ := hN x₁ y₁ (sub_eq_zero.mp h1)
          simp [hx, hy]
        · right
          obtain ⟨hx, hy⟩ := hN x₂ y₂ (sub_eq_zero.mp h1)
          simp [hx, hy]
      exact NoZeroDivisors.to_isDomain R
    have hsnu : ¬ IsUnit s := by
      rintro ⟨u, hu⟩
      obtain ⟨c, d, hcd⟩ := hrep (↑u⁻¹ : R)
      have h1 : s * (ι c + ι d * s) = 1 := by rw [← hcd, ← hu]; exact u.mul_inv
      have h2 : ι (d * π) + ι c * s = ι 1 + ι 0 * s := by
        simp only [map_mul, map_one, map_zero, zero_mul, add_zero]
        linear_combination h1 - ι d * hs
      have h3 := (huniq2 _ _ _ _ h2).1
      have hu1 : IsUnit (d * π) := by rw [h3]; exact isUnit_one
      exact hπnu (isUnit_of_mul_isUnit_right hu1)
    have hunit : ∀ x y : A, IsUnit x → IsUnit (ι x + ι y * s) := by
      intro x y hx
      have hNu : IsUnit (x ^ 2 - y ^ 2 * π) := by
        by_contra hc
        have h1 : x ^ 2 - y ^ 2 * π ∈ IsLocalRing.maximalIdeal A :=
          (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hc)
        have h2 : y ^ 2 * π ∈ IsLocalRing.maximalIdeal A := Ideal.mul_mem_left _ _ hπmem
        have h3 : x ^ 2 ∈ IsLocalRing.maximalIdeal A := by
          have := Ideal.add_mem _ h1 h2
          rwa [sub_add_cancel] at this
        exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h3) (hx.pow 2)
      have hu : IsUnit (ι (x ^ 2 - y ^ 2 * π)) := hNu.map ι
      rw [← hnorm x y] at hu
      exact isUnit_of_mul_isUnit_left hu
    have hnon : ∀ r : R, ¬ IsUnit r ↔ r ∈ Ideal.span {s} := by
      intro r
      constructor
      · intro hr
        obtain ⟨x, y, rfl⟩ := hrep r
        have hx : ¬ IsUnit x := fun hx => hr (hunit x y hx)
        have hxm : x ∈ Ideal.span {π} := by
          rw [← hπ]; exact (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hx)
        obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hxm
        rw [Ideal.mem_span_singleton']
        refine ⟨ι c * s + ι y, ?_⟩
        rw [map_mul]
        linear_combination (ι c) * hs
      · intro hr hu
        obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hr
        exact hsnu (isUnit_of_mul_isUnit_right hu)
    haveI hloc : IsLocalRing R := IsLocalRing.of_nonunits_add (fun a b ha hb => by
      rw [mem_nonunits_iff, hnon] at ha hb ⊢
      exact Ideal.add_mem _ ha hb)
    have hmax : IsLocalRing.maximalIdeal R = Ideal.span {s} := by
      ext r
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hnon]
    have hs0 : s ≠ 0 := by
      intro h0
      have := (huniq 0 1 (by rw [map_zero, map_one, one_mul, zero_add]; exact h0)).2
      exact one_ne_zero this
    haveI := hdom
    have hnf : ¬ IsField R := by
      intro hF
      have := (IsLocalRing.isField_iff_maximalIdeal_eq).mp hF
      rw [hmax, Ideal.span_singleton_eq_bot] at this
      exact hs0 this
    have hprin : (IsLocalRing.maximalIdeal R).IsPrincipal := ⟨⟨s, hmax⟩⟩
    have hdvr : IsDiscreteValuationRing R :=
      ((IsDiscreteValuationRing.TFAE R hnf).out 1 5).mpr hprin
    have hlh : IsLocalHom ι := ⟨fun a ha => by
      by_contra hna
      have ham : a ∈ Ideal.span {π} := by
        rw [← hπ]; exact (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hna)
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ham
      have : ι (c * π) ∈ Ideal.span {s} := by
        rw [Ideal.mem_span_singleton']
        exact ⟨ι c * s, by rw [map_mul, ← hs]; ring⟩
      exact (hnon _).mpr this ha⟩
    exact ⟨hdom, hdvr, hmax, hlh⟩
  obtain ⟨hD, hDVR, hmax, hlh⟩ :=
    key (AdjoinRoot f) (AdjoinRoot.of f) (AdjoinRoot.root f) hs hrep huniq

  haveI : Module.Finite A (AdjoinRoot f) := hmonic.finite_adjoinRoot
  haveI : Algebra.IsIntegral A (AdjoinRoot f) := Algebra.IsIntegral.of_finite A (AdjoinRoot f)
  obtain ⟨hH, hSep⟩ := wc_integral_over_strictly_henselian A (AdjoinRoot f) inferInstance

  have hemb : ∀ (L : Type u) [Field L] (φA : A →+* L), Function.Injective φA →
        (letI := φA.toAlgebra; Algebra.IsAlgebraic A L) →
      ∀ (L' : Type u) [Field L'] (ιL : L →+* L'),
        (letI := ιL.toAlgebra; Algebra.IsAlgebraic L L') →
      ∀ S' : L', S' ^ 2 = ιL (φA π) →
      ∃ φ' : AdjoinRoot f →+* L', Function.Injective φ' ∧
        (letI := φ'.toAlgebra; Algebra.IsAlgebraic (AdjoinRoot f) L') ∧
        φ'.comp (AdjoinRoot.of f) = ιL.comp φA ∧ φ' (AdjoinRoot.root f) = S' := by
    intro L _ φA hφA halg L' _ ιL hLalg S' hS
    obtain ⟨ψ, hψ⟩ : ∃ ψ : A →+* L', ψ = ιL.comp φA := ⟨_, rfl⟩
    have hψx : ∀ x, ψ x = ιL (φA x) := by intro x; rw [hψ]; rfl
    have hψinj : Function.Injective ψ := by
      rw [hψ]; exact ιL.injective.comp hφA
    have hψπ : ψ π = S' ^ 2 := by rw [hψx, hS]
    have hev : Polynomial.eval₂ ψ S' f = 0 := by
      rw [hf, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hψπ, sub_self]
    obtain ⟨φ', hφ'of, hφ'root⟩ : ∃ φ' : AdjoinRoot f →+* L',
        (∀ x, φ' (AdjoinRoot.of f x) = ψ x) ∧ φ' (AdjoinRoot.root f) = S' :=
      ⟨AdjoinRoot.lift ψ S' hev, fun x => AdjoinRoot.lift_of hev, AdjoinRoot.lift_root hev⟩
    have hinj : Function.Injective φ' := by
      rw [injective_iff_map_eq_zero]
      intro z hz
      obtain ⟨x, y, rfl⟩ := hrep z
      rw [map_add, map_mul, hφ'of, hφ'of, hφ'root] at hz
      have h2 : ψ (x ^ 2 - y ^ 2 * π) = 0 := by
        rw [map_sub, map_mul, map_pow, map_pow, hψπ]
        linear_combination (ψ x - ψ y * S') * hz
      have h3 : x ^ 2 - y ^ 2 * π = 0 := by
        apply hψinj; rw [h2, map_zero]
      obtain ⟨hx, hy⟩ := hN x y (sub_eq_zero.mp h3)
      rw [hx, hy]; simp
    have hofinj : Function.Injective (AdjoinRoot.of f) := by
      intro a b hab
      apply hψinj
      rw [← hφ'of, ← hφ'of, hab]
    have halgφ : (letI := φ'.toAlgebra; Algebra.IsAlgebraic (AdjoinRoot f) L') := by
      letI : Algebra A L := φA.toAlgebra
      letI : Algebra L L' := ιL.toAlgebra
      letI : Algebra A L' := ψ.toAlgebra
      haveI : Algebra.IsAlgebraic A L := halg
      haveI : Algebra.IsAlgebraic L L' := hLalg
      haveI : IsScalarTower A L L' := IsScalarTower.of_algebraMap_eq (fun x => hψx x)
      haveI : Algebra.IsAlgebraic A L' := Algebra.IsAlgebraic.trans A L L'
      letI : Algebra (AdjoinRoot f) L' := φ'.toAlgebra
      refine ⟨fun w => ?_⟩
      obtain ⟨p, hp0, hp⟩ := Algebra.IsAlgebraic.isAlgebraic (R := A) w
      refine ⟨p.map (AdjoinRoot.of f), (Polynomial.map_ne_zero_iff hofinj).mpr hp0, ?_⟩
      have e : (algebraMap (AdjoinRoot f) L').comp (AdjoinRoot.of f) = algebraMap A L' :=
        RingHom.ext fun x => hφ'of x
      rw [Polynomial.aeval_def, Polynomial.eval₂_map, e, ← Polynomial.aeval_def]
      exact hp
    refine ⟨φ', hinj, halgφ, ?_, hφ'root⟩
    apply RingHom.ext
    intro x
    rw [RingHom.comp_apply, hφ'of, hψx, RingHom.comp_apply]

  have hℓ' : IsUnit ((ℓ : ℕ) : AdjoinRoot f) := by
    have := hℓ.map (AdjoinRoot.of f)
    rwa [map_natCast] at this
  refine ⟨AdjoinRoot f, inferInstance, hD, hDVR, hH, hSep, AdjoinRoot.of f, AdjoinRoot.root f,
    IsLocalRing.ResidueField.map (AdjoinRoot.of f), ?_, hℓ', hmax, hs, hrep, hemb⟩
  exact RingHom.ext fun a => IsLocalRing.ResidueField.map_residue _ a

theorem wc_qmbt_bm_quad_pullback {A A' : Type u} [CommRing A] [CommRing A'] (ιA : A →+* A')
    (n : ℕ) (π : A) (c : Matrix (Fin n) (Fin n) A) (π' : A') (hπ'2 : π' ^ 2 = ιA π) :
    ∃ θ : wcQuadModelRing A n π c →+* wcQuadModelRing A' n (π' ^ 2) (c.map ιA),
      (∀ p, θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X p)) ∧
      θ.comp (algebraMap A (wcQuadModelRing A n π c)) =
        (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))).comp ιA ∧
      IsPullback (Spec.map (CommRingCat.ofHom θ))
        (Spec.map (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))))
        (wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) :=
by
  classical
  have hF : MvPolynomial.map ιA (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p *
      MvPolynomial.X q - MvPolynomial.C π : MvPolynomial (Fin n) A) =
      ∑ p, ∑ q, MvPolynomial.C ((c.map ιA) p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C (π' ^ 2) := by
    simp only [map_sum, map_sub, map_mul, MvPolynomial.map_C, MvPolynomial.map_X,
      Matrix.map_apply, hπ'2]
  have hle : wcQuadModelIdeal A n π c ≤
      (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)).comap (MvPolynomial.map ιA) := by
    rw [Ideal.span_le]
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    show MvPolynomial.map ιA _ ∈ wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)
    rw [hF]
    exact Ideal.subset_span rfl
  let θ : wcQuadModelRing A n π c →+* wcQuadModelRing A' n (π' ^ 2) (c.map ιA) :=
    Ideal.quotientMap (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.map ιA) hle
  have hθ : ∀ P : MvPolynomial (Fin n) A, θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) P) =
      Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.map ιA P) :=
    fun P => Ideal.quotientMap_mk
  have h1 : ∀ p, θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.X p) := by
    intro p
    rw [hθ, MvPolynomial.map_X]
  have h2 : θ.comp (algebraMap A (wcQuadModelRing A n π c)) =
      (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))).comp ιA := by
    refine RingHom.ext fun a => ?_
    show θ (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.C a)) =
      Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.C (ιA a))
    rw [hθ, MvPolynomial.map_C]
  have key : ∀ (T : Type u) [CommRing T] (u : wcQuadModelRing A n π c →+* T) (v : A' →+* T),
      u.comp (algebraMap A (wcQuadModelRing A n π c)) = v.comp ιA →
      ∃ d : wcQuadModelRing A' n (π' ^ 2) (c.map ιA) →+* T, d.comp θ = u ∧
        d.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) = v := by
    intro T _ u v huv
    let E : MvPolynomial (Fin n) A' →+* T :=
      MvPolynomial.eval₂Hom v (fun p => u (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)
        (MvPolynomial.X p)))
    have hE : E.comp (MvPolynomial.map ιA) = u.comp (Ideal.Quotient.mk (wcQuadModelIdeal A n π c)) := by
      apply MvPolynomial.ringHom_ext
      · intro r
        have := RingHom.congr_fun huv r
        simp only [RingHom.comp_apply] at this
        simp only [RingHom.comp_apply, MvPolynomial.map_C, E, MvPolynomial.eval₂Hom_C]
        rw [← this]
        rfl
      · intro i
        simp only [RingHom.comp_apply, MvPolynomial.map_X, E, MvPolynomial.eval₂Hom_X']
    have hEker : ∀ a ∈ wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA), E a = 0 := by
      intro a ha
      rw [Ideal.mem_span_singleton'] at ha
      obtain ⟨b, rfl⟩ := ha
      rw [map_mul, ← hF]
      have := RingHom.congr_fun hE (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p *
        MvPolynomial.X q - MvPolynomial.C π : MvPolynomial (Fin n) A)
      rw [RingHom.comp_apply, RingHom.comp_apply] at this
      have hmk : Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (∑ p, ∑ q, MvPolynomial.C (c p q) *
          MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π : MvPolynomial (Fin n) A) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      rw [this, hmk, map_zero, mul_zero]
    refine ⟨Ideal.Quotient.lift (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) E hEker, ?_, ?_⟩
    · apply Ideal.Quotient.ringHom_ext
      refine RingHom.ext fun P => ?_
      simp only [RingHom.comp_apply, hθ, Ideal.Quotient.lift_mk]
      exact RingHom.congr_fun hE P
    · refine RingHom.ext fun a => ?_
      show Ideal.Quotient.lift (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) E hEker
        (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) (c.map ιA)) (MvPolynomial.C a)) = v a
      rw [Ideal.Quotient.lift_mk]
      simp only [E, MvPolynomial.eval₂Hom_C]
  have huniq : ∀ (T : Type u) [CommRing T] (m1 m2 : wcQuadModelRing A' n (π' ^ 2) (c.map ιA) →+* T),
      m1.comp θ = m2.comp θ →
      m1.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) =
        m2.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) → m1 = m2 := by
    intro T _ m1 m2 e1 e2
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro r
      exact RingHom.congr_fun e2 r
    · intro i
      have := RingHom.congr_fun e1 (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X i))
      simp only [RingHom.comp_apply, h1] at this ⊢
      exact this
  refine ⟨θ, h1, h2, ?_⟩
  have eq : CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π c)) ≫ CommRingCat.ofHom θ =
      CommRingCat.ofHom ιA ≫
        CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))) := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, h2]
  have hcond : ∀ s : Limits.PushoutCocone
      (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π c))) (CommRingCat.ofHom ιA),
      s.inl.hom.comp (algebraMap A (wcQuadModelRing A n π c)) = s.inr.hom.comp ιA := by
    intro s
    have := congrArg CommRingCat.Hom.hom s.condition
    simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using this
  have hP : IsPushout (CommRingCat.ofHom (algebraMap A (wcQuadModelRing A n π c)))
      (CommRingCat.ofHom ιA) (CommRingCat.ofHom θ)
      (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) := by
    refine IsPushout.of_isColimit' ⟨eq⟩ ?_
    refine Limits.PushoutCocone.IsColimit.mk eq
      (fun s => CommRingCat.ofHom (Classical.choose (key s.pt s.inl.hom s.inr.hom (hcond s))))
      ?_ ?_ ?_
    · intro s
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
      exact (Classical.choose_spec (key s.pt s.inl.hom s.inr.hom (hcond s))).1
    · intro s
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
      exact (Classical.choose_spec (key s.pt s.inl.hom s.inr.hom (hcond s))).2
    · intro s m hm1 hm2
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_ofHom]
      have hs := Classical.choose_spec (key s.pt s.inl.hom s.inr.hom (hcond s))
      apply huniq
      · rw [hs.1, ← hm1, CommRingCat.hom_comp, CommRingCat.hom_ofHom]
      · rw [hs.2, ← hm2, CommRingCat.hom_comp, CommRingCat.hom_ofHom]
  exact AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hP

theorem wc_qmbt_bm_flat_base_change {R : CommRingCat.{u}} {ι : Type} [Finite ι] (b : ι → R)
    {X₁ : Scheme.{u}} (r : X₁ ⟶ Spec R) {P : Scheme.{u}} [IsAffine P] (g : P ⟶ Spec R) [Flat g]
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop
      (Ideal.span (Set.range fun k => (Scheme.ΓSpecIso R).inv.hom (b k)))) r) :
    wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop
      (Ideal.span (Set.range fun k => g.appTop.hom ((Scheme.ΓSpecIso R).inv.hom (b k)))))
      (Limits.pullback.snd r g) :=
by
  classical


  have gen_chart : ∀ (X T : Scheme.{u}) (I : X.IdealSheafData) (h : T ⟶ X), wcCsdInvPull I h →
      ∀ (U : X.affineOpens) (n : ℕ) (b : Fin n → Γ(X, U.1)), Ideal.span (Set.range b) = I.ideal U →
      ∀ t : T, h t ∈ U.1 → ∃ j : Fin n, wcCsdChartAt I h U (b j) t := by
    intro X T I h hP U n b hb t hU
    have LC : ∀ (U' : X.Opens) (V : T.Opens) (hV : IsAffineOpen V) (e : V ≤ h ⁻¹ᵁ U')
        (J : Ideal Γ(X, U')) (ε f : Γ(T, V)), ε ∈ nonZeroDivisors Γ(T, V) →
        Ideal.map (h.appLE U' V e).hom J = Ideal.span {ε} →
        ∃ (e' : T.basicOpen f ≤ h ⁻¹ᵁ U') (r : Γ(T, V) →+* Γ(T, T.basicOpen f)),
          r ε ∈ nonZeroDivisors Γ(T, T.basicOpen f) ∧ IsUnit (r f) ∧
          Ideal.map (h.appLE U' (T.basicOpen f) e').hom J = Ideal.span {r ε} ∧
          ∀ x : Γ(X, U'), (h.appLE U' (T.basicOpen f) e').hom x = r ((h.appLE U' V e).hom x) := by
      intro U' V hV e J ε f hε hJ
      have e' : T.basicOpen f ≤ h ⁻¹ᵁ U' := (T.basicOpen_le f).trans e
      have hform : ∀ x : Γ(X, U'), (h.appLE U' (T.basicOpen f) e').hom x =
          (T.presheaf.map (homOfLE (T.basicOpen_le f)).op).hom ((h.appLE U' V e).hom x) := by
        intro x
        rw [← Scheme.Hom.appLE_map h e (homOfLE (T.basicOpen_le f)).op]
        rfl
      refine ⟨e', (T.presheaf.map (homOfLE (T.basicOpen_le f)).op).hom, ?_, ?_, ?_, hform⟩
      · exact @IsLocalization.map_nonZeroDivisors_le _ _ (Submonoid.powers f) _ _ _
          (hV.isLocalization_basicOpen f) _ (Submonoid.mem_map_of_mem _ hε)
      · exact @IsLocalization.Away.algebraMap_isUnit _ _ _ _ _ f (hV.isLocalization_basicOpen f)
      · have hcomp : (h.appLE U' (T.basicOpen f) e').hom =
            (T.presheaf.map (homOfLE (T.basicOpen_le f)).op).hom.comp (h.appLE U' V e).hom :=
          RingHom.ext hform
        rw [hcomp, ← Ideal.map_map, hJ, Ideal.map_span, Set.image_singleton]
    have LD : ∀ (U₀ D : X.affineOpens) (W : T.Opens) (eU : W ≤ h ⁻¹ᵁ U₀.1) (eD : W ≤ h ⁻¹ᵁ D.1),
        D ≤ U₀ → Ideal.map (h.appLE U₀.1 W eU).hom (I.ideal U₀) =
          Ideal.map (h.appLE D.1 W eD).hom (I.ideal D) := by
      intro U₀ D W eU eD hDU
      rw [← I.map_ideal hDU, Ideal.map_map]
      congr 1
      rw [← CommRingCat.hom_comp, Scheme.Hom.map_appLE]
    obtain ⟨U₁, V₁, e₁, a₁, htV₁, -, hε₁, hJ₁⟩ := hP t
    have hU₁ : h t ∈ U₁.1 := e₁ htV₁
    obtain ⟨D₀, hD₀, hxD₀, hD₀sub⟩ :=
      exists_isAffineOpen_mem_and_subset (x := h t) (U := U.1 ⊓ U₁.1) ⟨hU, hU₁⟩
    let D : X.affineOpens := ⟨D₀, hD₀⟩
    have hDU : D ≤ U := show D₀ ≤ U.1 from fun x hx => (hD₀sub hx).1
    have hDU₁ : D ≤ U₁ := show D₀ ≤ U₁.1 from fun x hx => (hD₀sub hx).2
    have htVD : t ∈ V₁.1 ⊓ h ⁻¹ᵁ D.1 := ⟨htV₁, hxD₀⟩
    obtain ⟨f, hf, htf⟩ := V₁.2.exists_basicOpen_le (V := V₁.1 ⊓ h ⁻¹ᵁ D.1) ⟨t, htVD⟩ htV₁
    have htf' : t ∈ T.basicOpen f := htf
    have hV₂ : IsAffineOpen (T.basicOpen f) := V₁.2.basicOpen f
    have eD : T.basicOpen f ≤ h ⁻¹ᵁ D.1 := hf.trans inf_le_right
    have eU : T.basicOpen f ≤ h ⁻¹ᵁ U.1 := fun x hx => hDU (eD hx)
    obtain ⟨eU₁, r₁, hε₂, -, hJ₂, -⟩ := LC U₁.1 V₁.1 V₁.2 e₁ (I.ideal U₁) _ f hε₁ hJ₁
    generalize r₁ ((h.appLE U₁.1 V₁.1 e₁).hom a₁) = ε₂ at hε₂ hJ₂
    have hJ : Ideal.map (h.appLE U.1 (T.basicOpen f) eU).hom (I.ideal U) = Ideal.span {ε₂} := by
      rw [LD U D _ eU eD hDU, ← LD U₁ D _ eU₁ eD hDU₁, hJ₂]
    have hJb : Ideal.span (Set.range (fun j => (h.appLE U.1 (T.basicOpen f) eU).hom (b j))) =
        Ideal.span {ε₂} := by
      rw [← hJ, ← hb, Ideal.map_span, ← Set.range_comp]
      rfl
    have hy : ∀ j, ∃ y, y * ε₂ = (h.appLE U.1 (T.basicOpen f) eU).hom (b j) := by
      intro j
      apply Ideal.mem_span_singleton'.mp
      rw [← hJb]
      exact Ideal.subset_span ⟨j, rfl⟩
    choose y hy using hy
    have hεmem : ε₂ ∈ Ideal.span (Set.range (fun j => (h.appLE U.1 (T.basicOpen f) eU).hom (b j))) := by
      rw [hJb]; exact Ideal.mem_span_singleton_self ε₂
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hεmem
    have hcy : ∑ j, c j * y j = 1 := by
      have h1 : (∑ j, c j * y j) * ε₂ = ε₂ := by
        rw [Finset.sum_mul]
        simp_rw [mul_assoc, hy]
        exact hc
      have h0 : (∑ j, c j * y j - 1) * ε₂ = 0 := by rw [sub_mul, h1, one_mul, sub_self]
      exact sub_eq_zero.mp ((mul_right_mem_nonZeroDivisors_eq_zero_iff hε₂).mp h0)
    obtain ⟨j, hj⟩ : ∃ j, t ∈ T.basicOpen (y j) := by
      by_contra hcon
      push_neg at hcon
      have hm : ∀ j, (T.presheaf.germ (T.basicOpen f) t htf').hom (c j * y j) ∈
          IsLocalRing.maximalIdeal (T.presheaf.stalk t) := by
        intro j
        rw [map_mul]
        apply Ideal.mul_mem_left
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, ← Scheme.mem_basicOpen T (y j) t htf']
        exact hcon j
      have h1 := Ideal.sum_mem (IsLocalRing.maximalIdeal (T.presheaf.stalk t))
        (t := Finset.univ) (fun j _ => hm j)
      rw [← map_sum, hcy, map_one] at h1
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top
        (Ideal.eq_top_of_isUnit_mem _ h1 isUnit_one)
    obtain ⟨e'', r, hε₃, hu, hJ₃, hform⟩ :=
      LC U.1 (T.basicOpen f) hV₂ eU (I.ideal U) ε₂ (y j) hε₂ hJ
    refine ⟨j, ⟨T.basicOpen (y j), hV₂.basicOpen (y j)⟩, e'', hj, ?_, ?_⟩
    · show (h.appLE U.1 (T.basicOpen (y j)) e'').hom (b j) ∈ nonZeroDivisors Γ(T, T.basicOpen (y j))
      rw [hform, ← hy j, map_mul]
      exact mul_mem_nonZeroDivisors.mpr ⟨hu.mem_nonZeroDivisors, hε₃⟩
    · show Ideal.map (h.appLE U.1 (T.basicOpen (y j)) e'').hom (I.ideal U) =
        Ideal.span {(h.appLE U.1 (T.basicOpen (y j)) e'').hom (b j)}
      rw [hJ₃, hform, ← hy j, map_mul, Ideal.span_singleton_mul_left_unit hu]

  have H1 : ∀ (Y : Scheme.{u}) [IsAffine Y] (J : Ideal Γ(Y, ⊤)),
      (Scheme.IdealSheafData.ofIdealTop J).ideal ⟨⊤, isAffineOpen_top Y⟩ = J := by
    intro Y _ J
    rw [Scheme.IdealSheafData.ofIdealTop_ideal]
    have e : Y.presheaf.map (homOfLE (le_refl (⊤ : Y.Opens))).op = 𝟙 _ := by
      rw [show homOfLE (le_refl (⊤ : Y.Opens)) = 𝟙 _ from rfl, op_id, CategoryTheory.Functor.map_id]
    rw [e, CommRingCat.hom_id, Ideal.map_id]

  have H3 : ∀ {T : Scheme.{u}} (h : T ⟶ P) (V : T.Opens) (e : V ≤ h ⁻¹ᵁ ⊤)
      (e' : V ≤ (h ≫ g) ⁻¹ᵁ ⊤), g.appTop ≫ h.appLE ⊤ V e = (h ≫ g).appLE ⊤ V e' := by
    intro T h V e e'
    rw [Scheme.Hom.comp_appLE]
    rfl
  have appLE_eq : ∀ {X Y : Scheme.{u}} (f f' : X ⟶ Y), f = f' → ∀ (U : Y.Opens) (V : X.Opens)
      (e : V ≤ f ⁻¹ᵁ U) (e' : V ≤ f' ⁻¹ᵁ U), f.appLE U V e = f'.appLE U V e' := by
    intro X Y f f' hf U V e e'
    subst hf
    rfl

  have hreg : ∀ {A B : Type u} [CommRing A] [CommRing B] (f : A →+* B), f.Flat →
      ∀ x ∈ nonZeroDivisors A, f x ∈ nonZeroDivisors B := by
    intro A B _ _ f hf x hx
    letI := f.toAlgebra
    haveI : Module.Flat A B := hf
    have h1 := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := B) hx
    rw [mem_nonZeroDivisors_iff_right]
    intro y hy
    apply h1
    show x • y = x • (0 : B)
    rw [smul_zero, Algebra.smul_def, RingHom.algebraMap_toAlgebra, mul_comm]
    exact hy

  set β : ι → Γ(Spec R, ⊤) := fun k => (Scheme.ΓSpecIso R).inv.hom (b k) with hβ
  set gA := g.appTop.hom with hgA
  let N := Nat.card ι
  let eι : ι ≃ Fin N := Finite.equivFin ι
  let b' : Fin N → Γ(Spec R, ⊤) := fun j => β (eι.symm j)
  have hrange : Set.range b' = Set.range β := eι.symm.surjective.range_comp β
  have hrange' : Set.range (fun j => gA (b' j)) = Set.range (fun k => gA (β k)) :=
    eι.symm.surjective.range_comp (fun k => gA (β k))
  let TR : (Spec R).affineOpens := ⟨⊤, isAffineOpen_top _⟩
  let TP : P.affineOpens := ⟨⊤, isAffineOpen_top P⟩
  have hspanI : Ideal.span (Set.range b') =
      (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range β))).ideal TR := by
    rw [H1, hrange]
  have hspanI' : Ideal.span (Set.range (fun j => gA (b' j))) =
      (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k => gA (β k)))).ideal TP := by
    rw [H1, hrange']

  have hB : ∀ (T : Scheme.{u}) (h : T ⟶ P),
      wcCsdInvPull (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k => gA (β k)))) h →
      wcCsdInvPull (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range β))) (h ≫ g) := by
    intro T h hh t
    obtain ⟨j, V, e, htV, hnzd, hgen⟩ := gen_chart P T _ h hh TP N
      (fun j => gA (b' j)) hspanI' t (by simp [TP])
    have e' : V.1 ≤ (h ≫ g) ⁻¹ᵁ TR.1 := le_top.trans_eq (Scheme.Hom.preimage_top _).symm
    have H : g.appTop ≫ h.appLE TP.1 V.1 e = (h ≫ g).appLE TR.1 V.1 e' := H3 h V.1 e e'
    refine ⟨TR, V, e', b' j, htV, ?_, ?_, ?_⟩
    · rw [H1]; exact Ideal.subset_span ⟨eι.symm j, rfl⟩
    · rw [← H, CommRingCat.hom_comp, RingHom.comp_apply]; exact hnzd
    · rw [H1] at hgen
      rw [← H, H1, CommRingCat.hom_comp, ← Ideal.map_map, Ideal.map_span, ← Set.range_comp,
        RingHom.comp_apply]
      exact hgen

  have hA : wcCsdInvPull
      (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k => gA (β k))))
      (Limits.pullback.snd r g) := by
    intro t
    obtain ⟨j, V, e₁, htV, hnzd, hgen⟩ := gen_chart (Spec R) X₁ _ r hr.1 TR N
      b' hspanI (Limits.pullback.fst r g t) (by simp [TR])
    obtain ⟨W, hWaff, htW, hWsub⟩ := exists_isAffineOpen_mem_and_subset (x := t)
      (U := Limits.pullback.fst r g ⁻¹ᵁ V.1) htV
    have e₂ : W ≤ Limits.pullback.fst r g ⁻¹ᵁ V.1 := fun x hx => hWsub hx
    have eW : W ≤ Limits.pullback.snd r g ⁻¹ᵁ TP.1 :=
      le_top.trans_eq (Scheme.Hom.preimage_top _).symm
    have hflat : RingHom.Flat (Scheme.Hom.appLE (Limits.pullback.fst r g) V.1 W e₂).hom :=
      HasRingHomProperty.appLE @Flat (Limits.pullback.fst r g) inferInstance V ⟨W, hWaff⟩ e₂
    have star : g.appTop ≫ (Limits.pullback.snd r g).appLE TP.1 W eW =
        r.appLE TR.1 V.1 e₁ ≫ (Limits.pullback.fst r g).appLE V.1 W e₂ := by
      rw [H3 (Limits.pullback.snd r g) W eW (le_top.trans_eq (Scheme.Hom.preimage_top _).symm),
        Scheme.Hom.appLE_comp_appLE]
      exact appLE_eq _ _ Limits.pullback.condition.symm _ _ _ _
    have star' : ((Limits.pullback.snd r g).appLE TP.1 W eW).hom.comp gA =
        ((Limits.pullback.fst r g).appLE V.1 W e₂).hom.comp (r.appLE TR.1 V.1 e₁).hom := by
      rw [hgA, ← CommRingCat.hom_comp, ← CommRingCat.hom_comp, star]
    have star_apply : ∀ x, ((Limits.pullback.snd r g).appLE TP.1 W eW).hom (gA x) =
        ((Limits.pullback.fst r g).appLE V.1 W e₂).hom ((r.appLE TR.1 V.1 e₁).hom x) := by
      intro x
      rw [← RingHom.comp_apply, star', RingHom.comp_apply]
    refine ⟨TP, ⟨W, hWaff⟩, eW, gA (b' j), htW, ?_, ?_, ?_⟩
    · rw [H1]; exact Ideal.subset_span ⟨eι.symm j, rfl⟩
    · rw [star_apply]; exact hreg _ hflat _ hnzd
    · rw [H1] at hgen
      have e1 : Ideal.span (Set.range fun k => gA (β k)) = Ideal.map gA (Ideal.span (Set.range β)) := by
        rw [Ideal.map_span, ← Set.range_comp]; rfl
      rw [H1, e1, Ideal.map_map, star', ← Ideal.map_map, hgen, Ideal.map_span, Set.image_singleton,
        star_apply]

  refine ⟨hA, fun T h hh => ?_⟩
  obtain ⟨h₁, hh₁, u₁⟩ := hr.2 T (h ≫ g) (hB T h hh)
  refine ⟨Limits.pullback.lift h₁ h hh₁, Limits.pullback.lift_snd _ _ _, fun k hk => ?_⟩
  dsimp only at hk
  have hk1 : k ≫ Limits.pullback.fst r g = h₁ :=
    u₁ _ (by
      show (k ≫ Limits.pullback.fst r g) ≫ r = h ≫ g
      rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hk])
  apply Limits.pullback.hom_ext
  · rw [hk1, Limits.pullback.lift_fst]
  · rw [hk, Limits.pullback.lift_snd]

theorem wc_qmbt_bm_blowup_charts {R : CommRingCat.{u}} {ι : Type} [Finite ι] (b : ι → R)
    {X' : Scheme.{u}} (r : X' ⟶ Spec R)
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop
      (Ideal.span (Set.range fun k => (Scheme.ΓSpecIso R).inv.hom (b k)))) r)
    (C : ι → CommRingCat.{u}) (φ : ∀ k, R ⟶ C k)
    (hnzd : ∀ k, (φ k).hom (b k) ∈ nonZeroDivisors (C k))
    (hgen : ∀ k, Ideal.map (φ k).hom (Ideal.span (Set.range b)) = Ideal.span {(φ k).hom (b k)})
    (hup : ∀ k (B : CommRingCat.{u}) (ρ : R ⟶ B), ρ.hom (b k) ∈ nonZeroDivisors B →
      Ideal.map ρ.hom (Ideal.span (Set.range b)) = Ideal.span {ρ.hom (b k)} →
      ∃! ψ : C k ⟶ B, φ k ≫ ψ = ρ) :
    ∃ e : ∀ k, Spec (C k) ⟶ X', (∀ k, IsOpenImmersion (e k)) ∧
      (∀ k, e k ≫ r = Spec.map (φ k)) ∧ ∀ x : X', ∃ k, ∃ y : Spec (C k), e k y = x :=
by
  classical

  have main : ∀ (I : (Spec R).IdealSheafData), wcCsdIsBlowup I r →
      ∀ (U : (Spec R).affineOpens) (a : ι → Γ(Spec R, U.1)) (φ' : ∀ k, Γ(Spec R, U.1) ⟶ C k),
      (∀ x : Spec R, x ∈ U.1) → (∀ k, a k ∈ I.ideal U) → Ideal.span (Set.range a) = I.ideal U →
      (∀ k, (φ' k).hom (a k) ∈ nonZeroDivisors (C k)) →
      (∀ k, Ideal.map (φ' k).hom (I.ideal U) = Ideal.span {(φ' k).hom (a k)}) →
      (∀ k (B : CommRingCat.{u}) (ρ : Γ(Spec R, U.1) ⟶ B), ρ.hom (a k) ∈ nonZeroDivisors B →
        Ideal.map ρ.hom (I.ideal U) = Ideal.span {ρ.hom (a k)} → ∃! ψ : C k ⟶ B, φ' k ≫ ψ = ρ) →
      ∃ e : ∀ k, Spec (C k) ⟶ X', (∀ k, IsOpenImmersion (e k)) ∧
        (∀ k, e k ≫ r = Spec.map (φ' k) ≫ U.2.fromSpec) ∧
        ∀ x : X', ∃ k, ∃ y : Spec (C k), e k y = x := by
    intro I hrI U a φ' hUall hak hspan hnz hid hUP
    have hmapcomp : ∀ {A B C : CommRingCat.{u}} (φ : A ⟶ B) (σ : B ⟶ C) (J : Ideal A) (x : A),
        Ideal.map φ.hom J = Ideal.span {φ.hom x} →
        Ideal.map (φ ≫ σ).hom J = Ideal.span {(φ ≫ σ).hom x} := by
      intro A B C φ σ J x h
      rw [CommRingCat.hom_comp, ← Ideal.map_map, h, Ideal.map_span, Set.image_singleton]
      try rfl
    have hL5a : ∀ {A B C : CommRingCat.{u}} (φ : A ⟶ B) (σ : B ⟶ C) (J : Ideal A) (x y : A),
        Ideal.map φ.hom J = Ideal.span {φ.hom x} → (φ ≫ σ).hom y ∈ nonZeroDivisors C →
        Ideal.map (φ ≫ σ).hom J = Ideal.span {(φ ≫ σ).hom y} →
        (φ ≫ σ).hom x ∈ nonZeroDivisors C ∧
          Ideal.map (φ ≫ σ).hom J = Ideal.span {(φ ≫ σ).hom x} := by
      intro A B C φ σ J x y hx hy hJy
      have hJx := hmapcomp φ σ J x hx
      refine ⟨?_, hJx⟩
      have hm : (φ ≫ σ).hom y ∈ Ideal.span {(φ ≫ σ).hom x} := by
        rw [← hJx, hJy]; exact Ideal.subset_span (Set.mem_singleton _)
      obtain ⟨v, hv⟩ := Ideal.mem_span_singleton'.mp hm
      rw [← hv] at hy
      exact (mul_mem_nonZeroDivisors.mp hy).2
    have hisoNZD : ∀ {B C : CommRingCat.{u}} (ε : B ≅ C) (y : B), y ∈ nonZeroDivisors B →
        ε.hom.hom y ∈ nonZeroDivisors C := by
      intro B C ε y hy
      rw [← MulEquivClass.map_nonZeroDivisors ε.commRingCatIsoToRingEquiv]
      exact ⟨y, hy, rfl⟩
    have hInv : ∀ {T : Scheme.{u}} (h : T ⟶ Spec R), wcCsdInvPull I h ↔
        ∀ t : T, ∃ (U : (Spec R).affineOpens) (a : Γ(Spec R, U.1)), a ∈ I.ideal U ∧
          wcCsdChartAt I h U a t := by
      intro T h
      unfold wcCsdInvPull
      constructor
      · intro H t
        obtain ⟨U, V, e, a, ht, ha, h1, h2⟩ := H t
        exact ⟨U, a, ha, V, e, ht, h1, h2⟩
      · intro H t
        obtain ⟨U, a, ha, V, e, ht, h1, h2⟩ := H t
        exact ⟨U, V, e, a, ht, ha, h1, h2⟩
    obtain ⟨N, ⟨eι⟩⟩ := Finite.exists_equiv_fin ι
    have hb : Ideal.span (Set.range (fun j : Fin N => a (eι.symm j))) = I.ideal U := by
      rw [← hspan]
      congr 1
      exact EquivLike.range_comp a eι.symm
    have htopk : ∀ k, (⊤ : (Spec (C k)).Opens) ≤ (Spec.map (φ' k) ≫ U.2.fromSpec) ⁻¹ᵁ U.1 := by
      intro k x _
      show (Spec.map (φ' k) ≫ U.2.fromSpec) x ∈ (U.1 : Set (Spec R))
      exact hUall _
    have hL4c := fun k => wc_csd_chart_spec_maps (Spec R) U.1 U.2 (C k) (φ' k)

    have hPres : ∀ (T T' : Scheme.{u}) (j : T' ⟶ T) [IsOpenImmersion j] (h : T ⟶ Spec R),
        wcCsdInvPull I h → wcCsdInvPull I (j ≫ h) := by
      intro T T' j _ h hP
      rw [hInv] at hP ⊢
      intro t'
      obtain ⟨U', a', ha', hc⟩ := hP (j t')
      exact ⟨U', a', ha', (wc_csd_chart_open_imm (Spec R) T T' I j h U' a' t').mp hc⟩

    have hPloc : ∀ (T : Scheme.{u}) (h : T ⟶ Spec R),
        (∀ t : T, ∃ W : T.Opens, t ∈ W ∧ wcCsdInvPull I (W.ι ≫ h)) → wcCsdInvPull I h := by
      intro T h H
      rw [hInv]
      intro t
      obtain ⟨W, htW, hW⟩ := H t
      rw [hInv] at hW
      obtain ⟨U', a', ha', hc⟩ := hW ⟨t, htW⟩
      exact ⟨U', a', ha', (wc_csd_chart_open_imm (Spec R) T W.toScheme I W.ι h U' a' ⟨t, htW⟩).mpr hc⟩

    have hGres : ∀ (k : ULift.{u} ι) (T T' : Scheme.{u}) (j : T' ⟶ T) [IsOpenImmersion j]
        (h : T ⟶ Spec R),
        (∀ t : T, wcCsdChartAt I h U (a k.down) t) →
        ∀ t' : T', wcCsdChartAt I (j ≫ h) U (a k.down) t' := by
      intro k T T' j _ h hG t'
      exact (wc_csd_chart_open_imm (Spec R) T T' I j h U (a k.down) t').mp (hG (j t'))

    have hGloc : ∀ (k : ULift.{u} ι) (T : Scheme.{u}) (h : T ⟶ Spec R),
        (∀ t : T, ∃ W : T.Opens, t ∈ W ∧
          ∀ w : W.toScheme, wcCsdChartAt I (W.ι ≫ h) U (a k.down) w) →
        ∀ t : T, wcCsdChartAt I h U (a k.down) t := by
      intro k T h H t
      obtain ⟨W, htW, hW⟩ := H t
      exact (wc_csd_chart_open_imm (Spec R) T W.toScheme I W.ι h U (a k.down) ⟨t, htW⟩).mpr
        (hW ⟨t, htW⟩)

    have hCov : ∀ (T : Scheme.{u}) (h : T ⟶ Spec R), wcCsdInvPull I h → ∀ t : T,
        ∃ (k : ULift.{u} ι) (W : T.Opens), t ∈ W ∧
          ∀ w : W.toScheme, wcCsdChartAt I (W.ι ≫ h) U (a k.down) w := by
      intro T h hP t
      obtain ⟨j, V, e, htV, h1, h2⟩ := wc_csd_invpull_generator_chart (Spec R) T I h hP U N
        (fun j : Fin N => a (eι.symm j)) hb t (hUall _)
      refine ⟨ULift.up (eι.symm j), V.1, htV, fun w => ?_⟩
      exact (wc_csd_chart_open_imm (Spec R) T V.1.toScheme I V.1.ι h U (a (eι.symm j)) w).mp
        ⟨V, e, w.2, h1, h2⟩

    have hGp : ∀ (k : ULift.{u} ι) (y : Spec (C k.down)),
        wcCsdChartAt I (Spec.map (φ' k.down) ≫ U.2.fromSpec) U (a k.down) y := by
      intro k y
      refine ⟨⟨⊤, isAffineOpen_top _⟩, htopk k.down, trivial, ?_, ?_⟩
      · show ((Spec.map (φ' k.down) ≫ U.2.fromSpec).appLE U.1 ⊤ (htopk k.down)).hom (a k.down) ∈
          nonZeroDivisors Γ(Spec (C k.down), ⊤)
        rw [(hL4c k.down).1 (htopk k.down)]
        exact hisoNZD (Scheme.ΓSpecIso (C k.down)).symm _ (hnz k.down)
      · show Ideal.map ((Spec.map (φ' k.down) ≫ U.2.fromSpec).appLE U.1 ⊤ (htopk k.down)).hom
            (I.ideal U) =
          Ideal.span {((Spec.map (φ' k.down) ≫ U.2.fromSpec).appLE U.1 ⊤ (htopk k.down)).hom
            (a k.down)}
        rw [(hL4c k.down).1 (htopk k.down)]
        exact hmapcomp (φ' k.down) _ _ _ (hid k.down)

    have hGP : ∀ (k : ULift.{u} ι) (T : Scheme.{u}) (h : T ⟶ Spec R),
        (∀ t : T, wcCsdChartAt I h U (a k.down) t) → wcCsdInvPull I h := by
      intro k T h hG
      rw [hInv]
      intro t
      exact ⟨U, a k.down, hak k.down, hG t⟩

    have hRep : ∀ (k : ULift.{u} ι) (T : Scheme.{u}) (h : T ⟶ Spec R),
        (∀ t : T, wcCsdChartAt I h U (a k.down) t) →
        ∃! c : T ⟶ Spec (C k.down), c ≫ Spec.map (φ' k.down) ≫ U.2.fromSpec = h := by
      intro k T h hG
      have e : (⊤ : T.Opens) ≤ h ⁻¹ᵁ U.1 := by
        intro t _
        obtain ⟨V, eV, htV, -, -⟩ := hG t
        exact eV htV
      obtain ⟨hnzT, hidT⟩ :=
        wc_csd_chart_global_sections (Spec R) T I h U (a k.down) (hak k.down) hG e
      obtain ⟨ψ, hψ, hψu⟩ := hUP k.down _ (h.appLE U.1 ⊤ e) hnzT hidT
      obtain ⟨c, hc, hcu⟩ := (hL4c k.down).2.2 T ψ
      refine ⟨c, ((hL4c k.down).2.1 T h e c).mpr (by rw [hc]; exact hψ), fun c' hc' => ?_⟩
      exact hcu c' (hψu _ (((hL4c k.down).2.1 T h e c').mp hc'))

    have hInto : ∀ (k : ULift.{u} ι) (T : Scheme.{u}) (c : T ⟶ Spec (C k.down)),
        wcCsdInvPull I (c ≫ Spec.map (φ' k.down) ≫ U.2.fromSpec) →
        ∀ t : T, wcCsdChartAt I (c ≫ Spec.map (φ' k.down) ≫ U.2.fromSpec) U (a k.down) t := by
      intro k T c hP t
      obtain ⟨j, V, e, htV, hnzb, hidb⟩ := wc_csd_invpull_generator_chart (Spec R) T I _ hP U
        N (fun j : Fin N => a (eι.symm j)) hb t (hUall _)
      have e2 : V.1 ≤ c ⁻¹ᵁ ⊤ := fun _ _ => trivial
      have hc : (c ≫ Spec.map (φ' k.down) ≫ U.2.fromSpec).appLE U.1 V.1 e =
          φ' k.down ≫ ((Scheme.ΓSpecIso (C k.down)).inv ≫ c.appLE ⊤ V.1 e2) := by
        rw [← Scheme.Hom.appLE_comp_appLE c (Spec.map (φ' k.down) ≫ U.2.fromSpec) U.1 ⊤ V.1
          (htopk k.down) e2, (hL4c k.down).1 (htopk k.down), Category.assoc]
      rw [hc] at hnzb hidb
      obtain ⟨h1, h2⟩ := hL5a (φ' k.down) _ _ (a k.down) _ (hid k.down) hnzb hidb
      exact ⟨V, e, htV, by rw [hc]; exact h1, by rw [hc]; exact h2⟩

    have hOpen : ∀ (k : ULift.{u} ι) (T T' : Scheme.{u}) (h : T ⟶ Spec R) (g : T' ⟶ T),
        wcCsdInvPull I h →
        (∀ t' : T', wcCsdChartAt I (g ≫ h) U (a k.down) t') →
        ∀ t' : T', ∃ W : T.Opens, g t' ∈ W ∧
          ∀ w : W.toScheme, wcCsdChartAt I (W.ι ≫ h) U (a k.down) w := by
      intro k T T' h g hP hG t'
      obtain ⟨j, hcb⟩ := wc_csd_invpull_generator_chart (Spec R) T I h hP U N
        (fun j : Fin N => a (eι.symm j)) hb (g t') (hUall _)
      obtain ⟨W, eW, hgW, h1, h2⟩ :=
        wc_csd_good_locus_open (Spec R) T T' I h g U (a k.down) _ t' (hak k.down) hcb (hG t')
      refine ⟨W.1, hgW, fun w => ?_⟩
      exact (wc_csd_chart_open_imm (Spec R) T W.1.toScheme I W.1.ι h U (a k.down) w).mp
        ⟨W, eW, w.2, h1, h2⟩

    obtain ⟨X'', r'', s, hbl, hso, hsr, hsurj⟩ := wc_csd_glue_local_universal (Spec R)
      (ULift.{u} ι) (fun k => Spec (C k.down))
      (fun k => Spec.map (φ' k.down) ≫ U.2.fromSpec) (fun T h => wcCsdInvPull I h)
      (fun k T h => ∀ t : T, wcCsdChartAt I h U (a k.down) t)
      hPres hPloc hGres hGloc hCov hGp hGP hRep hInto hOpen

    unfold wcCsdIsBlowup at hrI
    obtain ⟨hrP, hrU⟩ := hrI
    obtain ⟨hblP, hblU⟩ := hbl
    obtain ⟨f, hf, -⟩ := hrU X'' r'' hblP
    obtain ⟨g, hg, -⟩ := hblU X' r hrP
    have hfg : f ≫ g = 𝟙 X'' :=
      (hblU X'' r'' hblP).unique (by rw [Category.assoc, hg, hf]) (Category.id_comp _)
    have hgf : g ≫ f = 𝟙 X' :=
      (hrU X' r hrP).unique (by rw [Category.assoc, hf, hg]) (Category.id_comp _)
    let E : X'' ≅ X' := ⟨f, g, hfg, hgf⟩
    refine ⟨fun k => s (ULift.up k) ≫ E.hom, fun k => ?_, fun k => ?_, fun x => ?_⟩
    · have := hso (ULift.up k)
      have hfiso : IsIso f := ⟨⟨g, hfg, hgf⟩⟩
      show IsOpenImmersion (s (ULift.up k) ≫ f)
      infer_instance
    · show (s (ULift.up k) ≫ f) ≫ r = _
      rw [Category.assoc, hf]
      exact hsr (ULift.up k)
    · obtain ⟨k', y, hy⟩ := hsurj (E.inv x)
      refine ⟨k'.down, y, ?_⟩
      show (s k' ≫ E.hom) y = x
      rw [Scheme.Hom.comp_apply, hy]
      exact Scheme.inv_hom_apply E x

  have hIU : (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso R).inv.hom (b k)))).ideal ⟨⊤, isAffineOpen_top _⟩ =
      Ideal.span (Set.range fun k => (Scheme.ΓSpecIso R).inv.hom (b k)) := by
    rw [Scheme.IdealSheafData.ofIdealTop_ideal]
    have key : ∀ (h : (⊤ : (Spec R).Opens) ≤ ⊤) (J : Ideal Γ(Spec R, ⊤)),
        Ideal.map ((Spec R).presheaf.map (homOfLE h).op).hom J = J := by
      intro h J
      rw [show (homOfLE h).op = 𝟙 _ from rfl, CategoryTheory.Functor.map_id, CommRingCat.hom_id,
        Ideal.map_id]
    exact key _ _
  have hmapb : Ideal.map (Scheme.ΓSpecIso R).inv.hom (Ideal.span (Set.range b)) =
      Ideal.span (Set.range fun k => (Scheme.ΓSpecIso R).inv.hom (b k)) := by
    rw [Ideal.map_span, ← Set.range_comp]
    try rfl
  have hcompφ : ∀ k, ((Scheme.ΓSpecIso R).hom ≫ φ k).hom.comp (Scheme.ΓSpecIso R).inv.hom =
      (φ k).hom := fun k => by
    rw [← CommRingCat.hom_comp, Iso.inv_hom_id_assoc]
  have hφb : ∀ k, ((Scheme.ΓSpecIso R).hom ≫ φ k).hom ((Scheme.ΓSpecIso R).inv.hom (b k)) =
      (φ k).hom (b k) := by
    intro k
    show (φ k).hom (((Scheme.ΓSpecIso R).inv ≫ (Scheme.ΓSpecIso R).hom).hom (b k)) = _
    rw [Iso.inv_hom_id]; rfl
  have hak' : ∀ k, (Scheme.ΓSpecIso R).inv.hom (b k) ∈
      (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso R).inv.hom (b k)))).ideal ⟨⊤, isAffineOpen_top _⟩ := by
    intro k
    rw [hIU]
    exact Ideal.subset_span ⟨k, rfl⟩
  have hnz' : ∀ k, ((Scheme.ΓSpecIso R).hom ≫ φ k).hom ((Scheme.ΓSpecIso R).inv.hom (b k)) ∈
      nonZeroDivisors (C k) := by
    intro k
    rw [hφb]
    exact hnzd k
  have hid' : ∀ k, Ideal.map ((Scheme.ΓSpecIso R).hom ≫ φ k).hom
      ((Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso R).inv.hom (b k)))).ideal ⟨⊤, isAffineOpen_top _⟩) =
      Ideal.span {((Scheme.ΓSpecIso R).hom ≫ φ k).hom ((Scheme.ΓSpecIso R).inv.hom (b k))} := by
    intro k
    rw [hIU, ← hmapb, Ideal.map_map, hcompφ, hgen, hφb]
  have hUP' : ∀ k (B : CommRingCat.{u}) (ρ' : Γ(Spec R, ⊤) ⟶ B),
      ρ'.hom ((Scheme.ΓSpecIso R).inv.hom (b k)) ∈ nonZeroDivisors B →
      Ideal.map ρ'.hom ((Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
        (Scheme.ΓSpecIso R).inv.hom (b k)))).ideal ⟨⊤, isAffineOpen_top _⟩) =
        Ideal.span {ρ'.hom ((Scheme.ΓSpecIso R).inv.hom (b k))} →
      ∃! ψ : C k ⟶ B, ((Scheme.ΓSpecIso R).hom ≫ φ k) ≫ ψ = ρ' := by
    intro k B ρ' h1 h2
    have h1' : ((Scheme.ΓSpecIso R).inv ≫ ρ').hom (b k) ∈ nonZeroDivisors B := h1
    have h2' : Ideal.map ((Scheme.ΓSpecIso R).inv ≫ ρ').hom (Ideal.span (Set.range b)) =
        Ideal.span {((Scheme.ΓSpecIso R).inv ≫ ρ').hom (b k)} := by
      rw [CommRingCat.hom_comp, ← Ideal.map_map, hmapb, ← hIU]
      exact h2
    obtain ⟨ψ, hψ, hψu⟩ := hup k B ((Scheme.ΓSpecIso R).inv ≫ ρ') h1' h2'
    have hψ0 : φ k ≫ ψ = (Scheme.ΓSpecIso R).inv ≫ ρ' := hψ
    refine ⟨ψ, ?_, fun ψ' hψ' => hψu ψ' ?_⟩
    · show ((Scheme.ΓSpecIso R).hom ≫ φ k) ≫ ψ = ρ'
      rw [Category.assoc, hψ0, Iso.hom_inv_id_assoc]
    · have hψ'' : ((Scheme.ΓSpecIso R).hom ≫ φ k) ≫ ψ' = ρ' := hψ'
      show φ k ≫ ψ' = (Scheme.ΓSpecIso R).inv ≫ ρ'
      rw [← hψ'', Category.assoc, Iso.inv_hom_id_assoc]
  have hp : ∀ k, Spec.map ((Scheme.ΓSpecIso R).hom ≫ φ k) ≫
      (isAffineOpen_top (Spec R)).fromSpec = Spec.map (φ k) := by
    intro k
    rw [IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp, Iso.inv_hom_id_assoc]
  obtain ⟨e, he1, he2, he3⟩ := main _ hr ⟨⊤, isAffineOpen_top _⟩
    (fun k => (Scheme.ΓSpecIso R).inv.hom (b k)) (fun k => (Scheme.ΓSpecIso R).hom ≫ φ k)
    (fun _ => trivial) hak' hIU.symm hnz' hid' hUP'
  exact ⟨e, he1, fun k => (he2 k).trans (hp k), he3⟩

theorem wc_qmbt_bm_chart_algebra {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {n : ℕ} (c' : Matrix (Fin n) (Fin n) A') (j : Fin n) :
    ∃ φ : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChart A' n π' c' j,
      (∀ p, φ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
          (MvPolynomial.X (some j) * wcQmbtChartHat j p)) ∧
      φ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
        algebraMap A' (wcQmbtChart A' n π' c' j) ∧
      φ (wcQmbtGen A' n π' c' (some j)) ∈ nonZeroDivisors (wcQmbtChart A' n π' c' j) ∧
      Ideal.map φ (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
        Ideal.span {φ (wcQmbtGen A' n π' c' (some j))} ∧
      ∀ (B : CommRingCat.{u}) (ρ : CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c') ⟶ B),
        ρ.hom (wcQmbtGen A' n π' c' (some j)) ∈ nonZeroDivisors B →
        Ideal.map ρ.hom (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
          Ideal.span {ρ.hom (wcQmbtGen A' n π' c' (some j))} →
        ∃! ψ : CommRingCat.of (wcQmbtChart A' n π' c' j) ⟶ B, CommRingCat.ofHom φ ≫ ψ = ρ :=
by

  have hπne : π' ≠ 0 := by
    intro h
    apply IsDiscreteValuationRing.not_a_field A'
    rw [hπ', h, Ideal.span_singleton_eq_bot]
  have hπprime : Prime π' := by
    rw [← Ideal.span_singleton_prime hπne, ← hπ']
    exact (IsLocalRing.maximalIdeal.isMaximal A').isPrime
  have hCprime : Prime (MvPolynomial.C π' : MvPolynomial (Option (Fin n)) A') :=
    (MvPolynomial.prime_C_iff _).mpr hπprime

  let I : Ideal (MvPolynomial (Option (Fin n)) A') := wcQmbtChartIdeal A' n π' c' j
  let x : MvPolynomial (Option (Fin n)) A' := MvPolynomial.X (some j)
  let s : MvPolynomial (Option (Fin n)) A' := MvPolynomial.X none
  let H : Fin n → MvPolynomial (Option (Fin n)) A' := fun p => wcQmbtChartHat j p
  let f1 : MvPolynomial (Option (Fin n)) A' := x * s - MvPolynomial.C π'
  let G : MvPolynomial (Option (Fin n)) A' :=
    ∑ p, ∑ q, MvPolynomial.C (c' p q) * H p * H q - s ^ 2
  have hf1def : f1 = x * s - MvPolynomial.C π' := rfl
  have hf1 : f1 ∈ I := by
    show f1 ∈ Ideal.span {f1, G}
    exact Ideal.subset_span (Set.mem_insert _ _)
  have hG : G ∈ I := by
    show G ∈ Ideal.span {f1, G}
    exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  have hHj : H j = 1 := by simp [H, wcQmbtChartHat]
  have hAlg : ∀ a, algebraMap A' (wcQmbtChart A' n π' c' j) a =
      Ideal.Quotient.mk I (MvPolynomial.C a) := fun a => rfl
  have hAlgR : ∀ a, Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.C a) =
      algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') a := fun a => rfl
  have hF0 : Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c')
      (∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C (π' ^ 2)) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)

  have hW : MvPolynomial.aeval (fun p => x * H p)
      (∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C (π' ^ 2)) = x ^ 2 * G + (x * s + MvPolynomial.C π') * f1 := by
    simp only [map_sub, map_sum, map_mul, MvPolynomial.aeval_X, MvPolynomial.aeval_C,
      MvPolynomial.algebraMap_eq]
    have e : ∑ p, ∑ q, MvPolynomial.C (c' p q) * (x * H p) * (x * H q) =
        x ^ 2 * ∑ p, ∑ q, MvPolynomial.C (c' p q) * H p * H q := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun p _ => ?_
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun q _ => ?_
      ring
    rw [e, hf1def, MvPolynomial.C_pow]
    show _ = x ^ 2 * (∑ p, ∑ q, MvPolynomial.C (c' p q) * H p * H q - s ^ 2) + _
    ring
  have hker : wcQuadModelIdeal A' n (π' ^ 2) c' ≤
      RingHom.ker ((Ideal.Quotient.mk I).comp (MvPolynomial.aeval (fun p => x * H p)).toRingHom) := by
    apply Ideal.span_le.mpr
    rintro z rfl
    show Ideal.Quotient.mk I (MvPolynomial.aeval (fun p => x * H p)
      (∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C (π' ^ 2))) = 0
    rw [hW, Ideal.Quotient.eq_zero_iff_mem]
    exact I.add_mem (I.mul_mem_left _ hG) (I.mul_mem_left _ hf1)
  let φ : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChart A' n π' c' j :=
    Ideal.Quotient.lift _ ((Ideal.Quotient.mk I).comp
      (MvPolynomial.aeval (fun p => x * H p)).toRingHom) (fun a ha => RingHom.mem_ker.mp (hker ha))
  have hφX : ∀ p, φ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) =
      Ideal.Quotient.mk I (x * H p) := by
    intro p
    show Ideal.Quotient.mk I (MvPolynomial.aeval (fun p => x * H p) (MvPolynomial.X p)) = _
    rw [MvPolynomial.aeval_X]
  have hφA : φ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
      algebraMap A' (wcQmbtChart A' n π' c' j) := by
    refine RingHom.ext fun a => ?_
    show Ideal.Quotient.mk I (MvPolynomial.aeval (fun p => x * H p) (MvPolynomial.C a)) = _
    rw [MvPolynomial.aeval_C]
    rfl
  have hφA' : ∀ a, φ (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') a) =
      algebraMap A' (wcQmbtChart A' n π' c' j) a := fun a => RingHom.congr_fun hφA a
  have hφx : φ (wcQmbtGen A' n π' c' (some j)) = Ideal.Quotient.mk I x := by
    show φ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X j)) = _
    rw [hφX, hHj, mul_one]

  let ev : MvPolynomial (Option (Fin n)) A' →+* MvPolynomial (Option (Fin n)) A' :=
    MvPolynomial.eval₂Hom MvPolynomial.C
      (fun i => if i = some j then 0 else MvPolynomial.X i)
  have ev_C : ∀ a, ev (MvPolynomial.C a) = MvPolynomial.C a := fun a =>
    MvPolynomial.eval₂Hom_C _ _ _
  have ev_X : ∀ i, i ≠ some j → ev (MvPolynomial.X i) = MvPolynomial.X i := fun i hi =>
    (MvPolynomial.eval₂Hom_X' _ _ _).trans (if_neg hi)
  have ev_x : ev x = 0 :=
    (MvPolynomial.eval₂Hom_X' _ _ _).trans (if_pos rfl)
  have ev_s : ev s = s := ev_X none (by simp)
  have ev_H : ∀ p, ev (H p) = H p := by
    intro p
    show ev (if p = j then 1 else MvPolynomial.X (some p)) = if p = j then 1 else MvPolynomial.X (some p)
    split_ifs with hp
    · exact map_one ev
    · exact ev_X _ (fun h => hp (Option.some_injective _ h))
  have ev_G : ev G = G := by
    show ev (∑ p, ∑ q, MvPolynomial.C (c' p q) * H p * H q - s ^ 2) = _
    simp only [map_sub, map_sum, map_mul, map_pow, ev_C, ev_H, ev_s]
    rfl
  have ev_f1 : ev f1 = -MvPolynomial.C π' := by
    show ev (x * s - MvPolynomial.C π') = _
    rw [map_sub, map_mul, ev_x, ev_C, zero_mul, zero_sub]
  have hdiv : ∀ h : MvPolynomial (Option (Fin n)) A', x ∣ h - ev h := by
    intro h
    induction h using MvPolynomial.induction_on with
    | C a =>
      rw [ev_C, sub_self]
      exact dvd_zero _
    | add p q hp hq =>
      rw [map_add, add_sub_add_comm]
      exact dvd_add hp hq
    | mul_X p i hp =>
      rw [map_mul]
      by_cases hi : i = some j
      · rw [hi]
        show x ∣ p * x - ev p * ev x
        rw [ev_x, mul_zero, sub_zero]
        exact dvd_mul_left _ _
      · rw [ev_X i hi, ← sub_mul]
        exact dvd_mul_of_dvd_left hp _
  have hndvd : ¬ (MvPolynomial.C π' ∣ G) := by
    rintro ⟨m, hm⟩
    have key : ∀ t : A', π' ∣ c' j j - t ^ 2 := by
      intro t
      let e : MvPolynomial (Option (Fin n)) A' →+* A' :=
        MvPolynomial.eval (fun i => if i = none then t else 0)
      have eC : ∀ a, e (MvPolynomial.C a) = a := fun a => MvPolynomial.eval_C _
      have es : e s = t := by
        show MvPolynomial.eval _ (MvPolynomial.X none) = t
        rw [MvPolynomial.eval_X]
        simp
      have eH : ∀ p, e (H p) = if p = j then 1 else 0 := by
        intro p
        show e (if p = j then 1 else MvPolynomial.X (some p)) = _
        split_ifs with hp
        · exact map_one e
        · show MvPolynomial.eval _ (MvPolynomial.X (some p)) = 0
          rw [MvPolynomial.eval_X]
          simp
      have eG : e G = c' j j - t ^ 2 := by
        show e (∑ p, ∑ q, MvPolynomial.C (c' p q) * H p * H q - s ^ 2) = _
        simp only [map_sub, map_sum, map_mul, map_pow, eC, eH, es]
        simp
      refine ⟨e m, ?_⟩
      rw [← eG, hm, map_mul, eC]
    have h0 := key 0
    have h1 := key 1
    have h2 := dvd_sub h0 h1
    have h3 : (c' j j - 0 ^ 2) - (c' j j - 1 ^ 2) = 1 := by ring
    rw [h3] at h2
    exact hπprime.not_unit (isUnit_of_dvd_one h2)
  have hcolon : ∀ g, x * g ∈ I → g ∈ I := by
    intro g hg
    have hg' : x * g ∈ Ideal.span {f1, G} := hg
    obtain ⟨a, b, hab⟩ := Ideal.mem_span_pair.mp hg'
    have e1 := congrArg ev hab
    rw [map_add, map_mul, map_mul, map_mul, ev_f1, ev_G, ev_x, zero_mul] at e1
    have hdvd : MvPolynomial.C π' ∣ ev b * G := ⟨ev a, by linear_combination e1⟩
    obtain ⟨k, hk⟩ := (hCprime.dvd_or_dvd hdvd).resolve_right hndvd
    have hevA : ev a = k * G := by
      apply mul_left_cancel₀ hCprime.ne_zero
      linear_combination (-1 : MvPolynomial (Option (Fin n)) A') * e1 + G * hk
    obtain ⟨a1, ha1⟩ := hdiv a
    obtain ⟨b1, hb1⟩ := hdiv b
    have hx0 : x ≠ 0 := MvPolynomial.X_ne_zero _
    have hgeq : g = a1 * f1 + (b1 + k * s) * G := by
      apply mul_left_cancel₀ hx0
      linear_combination (-1 : MvPolynomial (Option (Fin n)) A') * hab + f1 * ha1 + G * hb1 +
        f1 * hevA + G * hk + (k * G) * hf1def
    rw [hgeq]
    show _ ∈ Ideal.span {f1, G}
    exact Ideal.mem_span_pair.mpr ⟨a1, b1 + k * s, rfl⟩

  have hNZD : φ (wcQmbtGen A' n π' c' (some j)) ∈ nonZeroDivisors (wcQmbtChart A' n π' c' j) := by
    rw [hφx, mem_nonZeroDivisors_iff_right]
    intro z hz
    obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective z
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem] at hz
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact hcolon g (by rw [mul_comm]; exact hz)

  have hgen : Ideal.map φ (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
      Ideal.span {φ (wcQmbtGen A' n π' c' (some j))} := by
    rw [Ideal.map_span, ← Set.range_comp]
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      rw [SetLike.mem_coe, Ideal.mem_span_singleton, hφx]
      cases k with
      | none =>
        show Ideal.Quotient.mk I x ∣ φ (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π')
        rw [hφA', hAlg]
        exact ⟨Ideal.Quotient.mk I s, by rw [← map_mul]; exact (Ideal.Quotient.eq.mpr hf1).symm⟩
      | some p =>
        show Ideal.Quotient.mk I x ∣
          φ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p))
        rw [hφX, map_mul]
        exact dvd_mul_right _ _
    · rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.subset_span ⟨some j, rfl⟩

  have hUP : ∀ (B : CommRingCat.{u}) (ρ : CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c') ⟶ B),
      ρ.hom (wcQmbtGen A' n π' c' (some j)) ∈ nonZeroDivisors B →
      Ideal.map ρ.hom (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
        Ideal.span {ρ.hom (wcQmbtGen A' n π' c' (some j))} →
      ∃! ψ : CommRingCat.of (wcQmbtChart A' n π' c' j) ⟶ B, CommRingCat.ofHom φ ≫ ψ = ρ := by
    intro B ρ hξ hmap
    let ξ : B := ρ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X j))
    have hξ' : ξ ∈ nonZeroDivisors B := hξ
    have hβ : ∀ k, ∃ b : B, b * ξ = ρ.hom (wcQmbtGen A' n π' c' k) := by
      intro k
      have hmem : ρ.hom (wcQmbtGen A' n π' c' k) ∈
          Ideal.span {ρ.hom (wcQmbtGen A' n π' c' (some j))} := by
        rw [← hmap]
        exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨k, rfl⟩)
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hmem
      exact ⟨b, hb⟩
    choose β hβ using hβ
    have hβnone : β none * ξ = ρ.hom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π') :=
      hβ none
    have hβsome : ∀ p, β (some p) * ξ =
        ρ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) :=
      fun p => hβ (some p)
    let v : Option (Fin n) → B := fun i =>
      Option.elim i (β none) (fun p => if p = j then ξ else β (some p))
    let ψ₀ : MvPolynomial (Option (Fin n)) A' →+* B :=
      MvPolynomial.eval₂Hom (ρ.hom.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c'))) v
    have ψ₀C : ∀ a, ψ₀ (MvPolynomial.C a) =
        ρ.hom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') a) := fun a =>
      MvPolynomial.eval₂Hom_C _ _ _
    have ψ₀X : ∀ i, ψ₀ (MvPolynomial.X i) = v i := fun i => MvPolynomial.eval₂Hom_X' _ _ _
    have hψx : ψ₀ x = ξ := by
      show ψ₀ (MvPolynomial.X (some j)) = ξ
      rw [ψ₀X]
      show (if j = j then ξ else β (some j)) = ξ
      rw [if_pos rfl]
    have hs : ψ₀ s = β none := ψ₀X none
    have hK : ∀ p, ξ * ψ₀ (H p) =
        ρ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) := by
      intro p
      show ξ * ψ₀ (if p = j then 1 else MvPolynomial.X (some p)) = _
      split_ifs with hp
      · rw [map_one, mul_one, hp]
      · rw [ψ₀X]
        show ξ * (if p = j then ξ else β (some p)) = _
        rw [if_neg hp, mul_comm]
        exact hβsome p
    have hψf1 : ψ₀ f1 = 0 := by
      show ψ₀ (x * s - MvPolynomial.C π') = 0
      rw [map_sub, map_mul, hψx, hs, ψ₀C, mul_comm, hβnone, sub_self]
    have hψG : ψ₀ G = 0 := by
      have e : ξ ^ 2 * ψ₀ G = ρ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c')
          (∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q -
            MvPolynomial.C (π' ^ 2))) := by
        calc ξ ^ 2 * ψ₀ G
            = ∑ p, ∑ q, ρ.hom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') (c' p q)) *
                (ξ * ψ₀ (H p)) * (ξ * ψ₀ (H q)) - (β none * ξ) ^ 2 := by
              show ξ ^ 2 * ψ₀ (∑ p, ∑ q, MvPolynomial.C (c' p q) * H p * H q - s ^ 2) = _
              rw [map_sub, map_pow, hs, map_sum, mul_sub, Finset.mul_sum]
              congr 1
              · refine Finset.sum_congr rfl fun p _ => ?_
                rw [map_sum, Finset.mul_sum]
                refine Finset.sum_congr rfl fun q _ => ?_
                rw [map_mul, map_mul, ψ₀C]
                ring
              · ring
          _ = ∑ p, ∑ q, ρ.hom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') (c' p q)) *
                ρ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) *
                ρ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X q)) -
                ρ.hom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π') ^ 2 := by
              simp only [hK, hβnone]
          _ = _ := by
              simp only [map_sub, map_sum, map_mul, map_pow, MvPolynomial.C_pow, hAlgR]
      have h0 : ψ₀ G * ξ ^ 2 = 0 := by
        rw [mul_comm, e, hF0, map_zero]
      exact mem_nonZeroDivisors_iff_right.mp (pow_mem hξ' 2) _ h0
    have hker2 : I ≤ RingHom.ker ψ₀ := by
      show Ideal.span {f1, G} ≤ _
      rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
      exact ⟨hψf1, hψG⟩
    let ψ₁ : wcQmbtChart A' n π' c' j →+* B :=
      Ideal.Quotient.lift I ψ₀ (fun a ha => RingHom.mem_ker.mp (hker2 ha))
    have hcomp : ψ₁.comp φ = ρ.hom := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        show ψ₁ (φ (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') a)) =
          ρ.hom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') a)
        rw [hφA', hAlg]
        exact ψ₀C a
      · intro p
        show ψ₁ (φ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p))) =
          ρ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p))
        rw [hφX]
        show ψ₀ (x * H p) = _
        rw [map_mul, hψx]
        exact hK p
    refine ⟨CommRingCat.ofHom ψ₁, ?_, ?_⟩
    · apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
      exact hcomp
    · intro ψ' hψ'
      have ht : ∀ y, ψ'.hom (φ y) = ρ.hom y := fun y =>
        congrArg (fun f => CommRingCat.Hom.hom f y) hψ'
      have htx : ψ'.hom (Ideal.Quotient.mk I x) = ξ := by
        show _ = ρ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X j))
        rw [← ht, hφX, hHj, mul_one]
      apply CommRingCat.hom_ext
      rw [CommRingCat.hom_ofHom]
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        show ψ'.hom (Ideal.Quotient.mk I (MvPolynomial.C a)) = ψ₀ (MvPolynomial.C a)
        rw [ψ₀C, ← ht, hφA', hAlg]
      · intro i
        show ψ'.hom (Ideal.Quotient.mk I (MvPolynomial.X i)) = ψ₀ (MvPolynomial.X i)
        rw [ψ₀X]
        rcases i with _ | p
        · apply (mul_cancel_left_mem_nonZeroDivisors hξ').mp
          calc ξ * ψ'.hom (Ideal.Quotient.mk I (MvPolynomial.X none))
              = ψ'.hom (Ideal.Quotient.mk I (x * s)) := by rw [map_mul, map_mul, htx]
            _ = ψ'.hom (Ideal.Quotient.mk I (MvPolynomial.C π')) := by
                rw [Ideal.Quotient.eq.mpr hf1]
            _ = ρ.hom (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π') := by
                rw [← hAlg, ← hφA', ht]
            _ = ξ * v none := by
                rw [← hβnone, mul_comm]
                rfl
        · by_cases hp : p = j
          · rw [hp]
            show ψ'.hom (Ideal.Quotient.mk I x) = (if j = j then ξ else β (some j))
            rw [if_pos rfl]
            exact htx
          · apply (mul_cancel_left_mem_nonZeroDivisors hξ').mp
            have hHp : H p = MvPolynomial.X (some p) := by
              show (if p = j then 1 else MvPolynomial.X (some p)) = _
              rw [if_neg hp]
            calc ξ * ψ'.hom (Ideal.Quotient.mk I (MvPolynomial.X (some p)))
                = ψ'.hom (Ideal.Quotient.mk I (x * H p)) := by
                  rw [hHp, map_mul, map_mul, htx]
              _ = ρ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c')
                    (MvPolynomial.X p)) := by
                  rw [← hφX, ht]
              _ = ξ * v (some p) := by
                  rw [← hβsome p, mul_comm]
                  show _ = ξ * (if p = j then ξ else β (some p))
                  rw [if_neg hp]
  exact ⟨φ, hφX, hφA, hNZD, hgen, hUP⟩

theorem wc_qmbt_bm_chart_algebra_none {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {n : ℕ} (c' : Matrix (Fin n) (Fin n) A') :
    ∃ φ : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChartNone A' n c',
      (∀ p, φ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) =
        Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C π' * MvPolynomial.X p)) ∧
      φ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
        algebraMap A' (wcQmbtChartNone A' n c') ∧
      φ (wcQmbtGen A' n π' c' none) ∈ nonZeroDivisors (wcQmbtChartNone A' n c') ∧
      Ideal.map φ (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
        Ideal.span {φ (wcQmbtGen A' n π' c' none)} ∧
      ∀ (B : CommRingCat.{u}) (ρ : CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) c') ⟶ B),
        ρ.hom (wcQmbtGen A' n π' c' none) ∈ nonZeroDivisors B →
        Ideal.map ρ.hom (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
          Ideal.span {ρ.hom (wcQmbtGen A' n π' c' none)} →
        ∃! ψ : CommRingCat.of (wcQmbtChartNone A' n c') ⟶ B, CommRingCat.ofHom φ ≫ ψ = ρ :=
by
  classical

  obtain ⟨Q, hQ⟩ : ∃ Q : MvPolynomial (Fin n) A',
      Q = ∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q := ⟨_, rfl⟩
  have hJ : wcQmbtChartNoneIdeal A' n c' = Ideal.span {Q - 1} := by subst hQ; rfl
  have hI : wcQuadModelIdeal A' n (π' ^ 2) c' = Ideal.span {Q - MvPolynomial.C (π' ^ 2)} := by
    subst hQ; rfl

  have evalQ : ∀ (S : Type u) [CommRing S] (f : A' →+* S) (g : Fin n → S) (s : S),
      MvPolynomial.eval₂Hom f (fun p => s * g p) Q = s ^ 2 * MvPolynomial.eval₂Hom f g Q := by
    intro S _ f g s
    subst hQ
    simp only [map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    ring

  obtain ⟨E, hE⟩ : ∃ E : MvPolynomial (Fin n) A' →+* MvPolynomial (Fin n) A',
      E = MvPolynomial.eval₂Hom MvPolynomial.C
        (fun p => MvPolynomial.C π' * MvPolynomial.X p) := ⟨_, rfl⟩
  have hEC : ∀ r, E (MvPolynomial.C r) = MvPolynomial.C r := by
    intro r; rw [hE, MvPolynomial.eval₂Hom_C]
  have hEX : ∀ p, E (MvPolynomial.X p) = MvPolynomial.C π' * MvPolynomial.X p := by
    intro p; rw [hE, MvPolynomial.eval₂Hom_X']
  have hEQ : E Q = MvPolynomial.C (π' ^ 2) * Q := by
    have h1 := evalQ (MvPolynomial (Fin n) A') MvPolynomial.C MvPolynomial.X (MvPolynomial.C π')
    have h2 : MvPolynomial.eval₂Hom (MvPolynomial.C : A' →+* MvPolynomial (Fin n) A')
        MvPolynomial.X Q = Q := by
      have : MvPolynomial.eval₂Hom (MvPolynomial.C : A' →+* MvPolynomial (Fin n) A')
          MvPolynomial.X = RingHom.id _ :=
        MvPolynomial.ringHom_ext (fun r => by simp) (fun i => by simp)
      rw [this, RingHom.id_apply]
    rw [hE, h1, h2, MvPolynomial.C_pow]
  have key : ∀ a ∈ wcQuadModelIdeal A' n (π' ^ 2) c',
      ((Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c')).comp E) a = 0 := by
    intro a ha
    rw [hI] at ha
    obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, map_mul, map_sub, hEQ, hEC, hJ]
    have : MvPolynomial.C (π' ^ 2) * Q - MvPolynomial.C (π' ^ 2) =
        MvPolynomial.C (π' ^ 2) * (Q - 1) := by ring
    rw [this]
    exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
  obtain ⟨φ, hφdef⟩ : ∃ φ : wcQuadModelRing A' n (π' ^ 2) c' →+* wcQmbtChartNone A' n c',
      φ = Ideal.Quotient.lift _ _ key := ⟨_, rfl⟩
  have hφmk : ∀ x, φ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') x) =
      Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (E x) := by
    intro x; rw [hφdef, Ideal.Quotient.lift_mk, RingHom.comp_apply]
  have hφ1 : ∀ p, φ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) =
      Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C π' * MvPolynomial.X p) := by
    intro p; rw [hφmk, hEX]
  have hφC : ∀ r, φ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.C r)) =
      Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C r) := by
    intro r; rw [hφmk, hEC]
  have halgR : ∀ r, algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') r =
      Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.C r) := by
    intro r
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  have halgC : ∀ r, algebraMap A' (wcQmbtChartNone A' n c') r =
      Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C r) := by
    intro r
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  have hφ2 : φ.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) =
      algebraMap A' (wcQmbtChartNone A' n c') := by
    refine RingHom.ext fun r => ?_
    rw [RingHom.comp_apply, halgR, hφC, halgC]
  have ht : φ (wcQmbtGen A' n π' c' none) =
      Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C π') := by
    show φ (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c') π') = _
    rw [halgR, hφC]

  have hπ0 : π' ≠ 0 := by
    intro h
    apply IsDiscreteValuationRing.not_a_field A'
    rw [hπ', h, Ideal.span_singleton_eq_bot]
  have hprime : Prime π' := by
    have h1 : (Ideal.span {π'}).IsPrime := by
      rw [← hπ']; exact (IsLocalRing.maximalIdeal.isMaximal A').isPrime
    exact (Ideal.span_singleton_prime hπ0).mp h1
  have hCprime : Prime (MvPolynomial.C π' : MvPolynomial (Fin n) A') :=
    (MvPolynomial.prime_C_iff (Fin n)).mpr hprime
  have hQ0 : MvPolynomial.constantCoeff Q = 0 := by
    subst hQ; simp
  have hndvd : ¬ ((MvPolynomial.C π' : MvPolynomial (Fin n) A') ∣ Q - 1) := by
    rintro ⟨w, hw⟩
    have h1 := congrArg MvPolynomial.constantCoeff hw
    rw [map_sub, map_one, hQ0, map_mul, MvPolynomial.constantCoeff_C] at h1
    exact hprime.not_isUnit (IsUnit.of_mul_eq_one (-MvPolynomial.constantCoeff w)
      (by linear_combination h1))
  have hnzd : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C π') ∈
      nonZeroDivisors (wcQmbtChartNone A' n c') := by
    rw [mem_nonZeroDivisors_iff_right]
    intro z hz
    obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective z
    rw [← map_mul, Ideal.Quotient.eq_zero_iff_mem, hJ] at hz
    obtain ⟨h, hh⟩ := Ideal.mem_span_singleton'.mp hz
    have hd : (MvPolynomial.C π' : MvPolynomial (Fin n) A') ∣ h * (Q - 1) :=
      ⟨g, by rw [hh, mul_comm]⟩
    rcases hCprime.dvd_or_dvd hd with ⟨h', rfl⟩ | hG
    · rw [Ideal.Quotient.eq_zero_iff_mem, hJ]
      have hC0 : (MvPolynomial.C π' : MvPolynomial (Fin n) A') ≠ 0 := by
        rw [Ne, MvPolynomial.C_eq_zero]; exact hπ0
      have h2 : h' * (Q - 1) = g := by
        apply mul_right_cancel₀ hC0
        rw [← hh]; ring
      rw [← h2]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    · exact absurd hG hndvd

  have hmap : Ideal.map φ (Ideal.span (Set.range (wcQmbtGen A' n π' c'))) =
      Ideal.span {φ (wcQmbtGen A' n π' c' none)} := by
    rw [Ideal.map_span]
    apply le_antisymm
    · rw [Ideal.span_le]
      rintro _ ⟨_, ⟨k, rfl⟩, rfl⟩
      cases k with
      | none => exact Ideal.subset_span (Set.mem_singleton _)
      | some p =>
        show φ (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) ∈
          Ideal.span {φ (wcQmbtGen A' n π' c' none)}
        rw [hφ1, ht, map_mul]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
    · rw [Ideal.span_singleton_le_iff_mem]
      exact Ideal.subset_span ⟨_, ⟨none, rfl⟩, rfl⟩
  refine ⟨φ, hφ1, hφ2, by rw [ht]; exact hnzd, hmap, ?_⟩

  intro B ρ hN hJρ
  have hmem : ∀ p, ∃ b : B, b * ρ.hom (wcQmbtGen A' n π' c' none) =
      ρ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X p)) := by
    intro p
    apply Ideal.mem_span_singleton'.mp
    rw [← hJρ]
    exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨some p, rfl⟩)
  choose β hβ using hmem
  obtain ⟨ρA, hρA⟩ : ∃ ρA : A' →+* B,
      ρA = ρ.hom.comp (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) c')) := ⟨_, rfl⟩
  have hξ : ρ.hom (wcQmbtGen A' n π' c' none) = ρA π' := by
    subst hρA; rfl
  rw [hξ] at hβ hN
  have hρC : ∀ r, ρ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c')
      (MvPolynomial.C r)) = ρA r := by
    intro r; rw [hρA, RingHom.comp_apply, halgR]
  have hχ : ∀ x, ρ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') x) =
      MvPolynomial.eval₂Hom ρA (fun p => ρA π' * β p) x := by
    intro x
    have : ρ.hom.comp (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c')) =
        MvPolynomial.eval₂Hom ρA (fun p => ρA π' * β p) := by
      refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
      · rw [RingHom.comp_apply, hρC, MvPolynomial.eval₂Hom_C]
      · rw [RingHom.comp_apply, MvPolynomial.eval₂Hom_X', ← hβ i, mul_comm]
    exact RingHom.congr_fun this x
  have hρQ : ρ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') Q) = ρA π' ^ 2 := by
    have h1 : Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') Q =
        Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.C (π' ^ 2)) := by
      rw [Ideal.Quotient.eq, hI]
      exact Ideal.mem_span_singleton_self _
    rw [h1, hρC, map_pow]
  have hψQ : MvPolynomial.eval₂Hom ρA β (Q - 1) = 0 := by
    have h1 := evalQ B ρA β (ρA π')
    rw [← hχ, hρQ] at h1
    have h2 : (MvPolynomial.eval₂Hom ρA β (Q - 1)) * ρA π' ^ 2 = 0 := by
      rw [map_sub, map_one]
      linear_combination -h1
    exact (mem_nonZeroDivisors_iff_right.mp (Submonoid.pow_mem _ hN 2)) _ h2
  have key2 : ∀ a ∈ wcQmbtChartNoneIdeal A' n c', MvPolynomial.eval₂Hom ρA β a = 0 := by
    intro a ha
    rw [hJ] at ha
    obtain ⟨s, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hψQ, mul_zero]
  obtain ⟨ψ0, hψ0def⟩ : ∃ ψ0 : wcQmbtChartNone A' n c' →+* B,
      ψ0 = Ideal.Quotient.lift _ _ key2 := ⟨_, rfl⟩
  have hψ0mk : ∀ x, ψ0 (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') x) =
      MvPolynomial.eval₂Hom ρA β x := by
    intro x; rw [hψ0def, Ideal.Quotient.lift_mk]
  have hex : ψ0.comp φ = ρ.hom := by
    refine Ideal.Quotient.ringHom_ext (MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_))
    · simp only [RingHom.comp_apply]
      rw [hφC, hψ0mk, MvPolynomial.eval₂Hom_C, hρC]
    · simp only [RingHom.comp_apply]
      rw [hφ1, hψ0mk, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X', ← hβ i,
        mul_comm]
  refine ⟨CommRingCat.ofHom ψ0, ?_, fun ψ' hψ' => ?_⟩
  · apply CommRingCat.hom_ext
    rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
    exact hex
  · have hc : ψ'.hom.comp φ = ρ.hom := by
      rw [← hψ', CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    apply CommRingCat.hom_ext
    rw [CommRingCat.hom_ofHom]
    refine Ideal.Quotient.ringHom_ext (MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_))
    · simp only [RingHom.comp_apply]
      have h1 := RingHom.congr_fun hc
        (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.C r))
      have h2 := RingHom.congr_fun hex
        (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.C r))
      rw [RingHom.comp_apply, hφC] at h1 h2
      rw [h1, h2]
    · simp only [RingHom.comp_apply]
      rw [hψ0mk, MvPolynomial.eval₂Hom_X']
      have h1 := RingHom.congr_fun hc
        (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.C π'))
      rw [RingHom.comp_apply, hφC, hρC] at h1
      have h2 := RingHom.congr_fun hc
        (Ideal.Quotient.mk (wcQuadModelIdeal A' n (π' ^ 2) c') (MvPolynomial.X i))
      rw [RingHom.comp_apply, hφ1, ← hβ i, map_mul, map_mul, h1] at h2
      have h3 := (mem_nonZeroDivisors_iff_right.mp hN)
        (ψ'.hom (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X i)) - β i)
        (by linear_combination h2)
      exact sub_eq_zero.mp h3

theorem wc_qmbt_cc_case_a_iso {A' : Type u} [CommRing A'] {π' : A'} {n : ℕ}
    {c' : Matrix (Fin n) (Fin n) A'} {i j : Fin n} (hij : i ≠ j)
    (τ : Fin (n - 2) ≃ {p : Fin n // p ≠ i ∧ p ≠ j}) :
    ∃ (η : Fin n → Polynomial (wcQmbtSSRing A' (n - 2) π'))
      (e : wcQmbtChart A' n π' c' j ≃+* AdjoinRoot (∑ p, ∑ q,
          Polynomial.C (algebraMap A' (wcQmbtSSRing A' (n - 2) π') (c' p q)) * η p * η q -
          Polynomial.C ((Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
            (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin (n - 2 + 2)))) ^ 2))),
      (∀ p, Polynomial.derivative (η p) = if p = i then 1 else 0) ∧
      e (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
          (∑ q, MvPolynomial.C (c' i q + c' q i) * wcQmbtChartHat (A' := A') j q)) =
        AdjoinRoot.mk _ (∑ q, Polynomial.C (algebraMap A' (wcQmbtSSRing A' (n - 2) π') (c' i q) +
          algebraMap A' (wcQmbtSSRing A' (n - 2) π') (c' q i)) * η q) ∧
      (∀ a : A', e (algebraMap A' (wcQmbtChart A' n π' c' j) a) =
        AdjoinRoot.of _ (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a)) ∧
      e (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none)) =
        AdjoinRoot.of _ (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
          (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (n - 2 + 2)))) ∧
      e (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j))) =
        AdjoinRoot.of _ (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
          (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (n - 2 + 2)))) :=
by

  obtain ⟨mM, hmM⟩ : ∃ f : MvPolynomial (Fin (n - 2 + 2)) A' →+* wcQmbtSSRing A' (n - 2) π',
      f = Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
        (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0)) :=
    ⟨_, rfl⟩
  obtain ⟨mC, hmC⟩ : ∃ f : MvPolynomial (Option (Fin n)) A' →+* wcQmbtChart A' n π' c' j,
      f = Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) := ⟨_, rfl⟩
  rw [← hmM, ← hmC]
  have hmM_C : ∀ a, mM (MvPolynomial.C a) = algebraMap A' (wcQmbtSSRing A' (n - 2) π') a := by
    intro a
    rw [hmM, ← MvPolynomial.algebraMap_eq]
    exact Ideal.Quotient.mk_algebraMap A' _ a
  have hmC_C : ∀ a, mC (MvPolynomial.C a) = algebraMap A' (wcQmbtChart A' n π' c' j) a := by
    intro a
    rw [hmC, ← MvPolynomial.algebraMap_eq]
    exact Ideal.Quotient.mk_algebraMap A' _ a
  have hhatj : wcQmbtChartHat (A' := A') j j = 1 := if_pos rfl
  have hhatne : ∀ p, p ≠ j → wcQmbtChartHat (A' := A') j p = MvPolynomial.X (some p) :=
    fun p hp => if_neg hp

  have hcollapse : ∀ {S : Type u} [CommRing S] (f : A' →+* S) (v : Fin (n - 2 + 2) → S),
      ∑ a, ∑ b, f ((Matrix.of fun a b : Fin (n - 2 + 2) =>
        if a.val = 0 ∧ b.val = 1 then (1 : A') else 0) a b) * v a * v b =
      v ⟨0, by omega⟩ * v ⟨1, by omega⟩ := by
    intro S _ f v
    rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (n - 2 + 2))]
    · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (n - 2 + 2))]
      · simp
      · intro b _ hb
        have : b.val ≠ 1 := fun h => hb (Fin.ext h)
        simp [this]
      · intro h; exact absurd (Finset.mem_univ _) h
    · intro a _ ha
      have : a.val ≠ 0 := fun h => ha (Fin.ext h)
      simp only [Matrix.of_apply, this, false_and, ↓reduceIte, map_zero, zero_mul,
        Finset.sum_const_zero]
    · intro h; exact absurd (Finset.mem_univ _) h

  have relM : mM (MvPolynomial.X ⟨0, by omega⟩) * mM (MvPolynomial.X ⟨1, by omega⟩) =
      algebraMap A' (wcQmbtSSRing A' (n - 2) π') π' := by
    have h0 : mM (∑ a, ∑ b, MvPolynomial.C ((Matrix.of fun a b : Fin (n - 2 + 2) =>
        if a.val = 0 ∧ b.val = 1 then (1 : A') else 0) a b) * MvPolynomial.X a *
        MvPolynomial.X b - MvPolynomial.C π') = 0 := by
      rw [hmM, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_span_singleton_self _
    have hc : ∑ a, ∑ b, algebraMap A' (wcQmbtSSRing A' (n - 2) π') ((Matrix.of fun a b :
        Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0) a b) *
        mM (MvPolynomial.X a) * mM (MvPolynomial.X b) =
        mM (MvPolynomial.X ⟨0, by omega⟩) * mM (MvPolynomial.X ⟨1, by omega⟩) :=
      hcollapse _ (fun k => mM (MvPolynomial.X k))
    simp only [map_sub, map_sum, map_mul, hmM_C] at h0
    rw [hc] at h0
    exact sub_eq_zero.mp h0
  have relC : mC (MvPolynomial.X (some j)) * mC (MvPolynomial.X none) =
      algebraMap A' (wcQmbtChart A' n π' c' j) π' := by
    have h0 : mC (MvPolynomial.X (some j) * MvPolynomial.X none - MvPolynomial.C π') = 0 := by
      rw [hmC, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span (Set.mem_insert _ _)
    rw [map_sub, map_mul, hmC_C] at h0
    exact sub_eq_zero.mp h0
  have GC : ∑ p, ∑ q, algebraMap A' (wcQmbtChart A' n π' c' j) (c' p q) *
      mC (wcQmbtChartHat (A' := A') j p) * mC (wcQmbtChartHat (A' := A') j q) =
      mC (MvPolynomial.X none) ^ 2 := by
    have h0 : mC (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat (A' := A') j p *
        wcQmbtChartHat (A' := A') j q - MvPolynomial.X none ^ 2) = 0 := by
      rw [hmC, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
    simp only [map_sub, map_sum, map_mul, map_pow, hmC_C] at h0
    exact sub_eq_zero.mp h0

  obtain ⟨up, hup⟩ : ∃ up : Fin (n - 2) → Fin (n - 2 + 2), ∀ k, (up k).val = k.val + 2 :=
    ⟨fun k => ⟨k.val + 2, by have := k.isLt; omega⟩, fun _ => rfl⟩

  obtain ⟨v, hv0, hv1, hvup⟩ : ∃ v : Fin (n - 2 + 2) → wcQmbtChart A' n π' c' j,
      v ⟨0, by omega⟩ = mC (MvPolynomial.X none) ∧
      v ⟨1, by omega⟩ = mC (MvPolynomial.X (some j)) ∧
      ∀ k, v (up k) = mC (MvPolynomial.X (some (τ k).1)) := by
    refine ⟨fun k => if h0 : k.val = 0 then mC (MvPolynomial.X none) else
      if h1 : k.val = 1 then mC (MvPolynomial.X (some j)) else
      mC (MvPolynomial.X (some (τ ⟨k.val - 2, by have := k.isLt; omega⟩).1)), ?_, ?_, ?_⟩
    · simp
    · simp
    · intro k
      have h0 : (up k).val ≠ 0 := by rw [hup]; omega
      have h1 : (up k).val ≠ 1 := by rw [hup]; omega
      have key : ∀ k' : Fin (n - 2), k'.val = k.val →
          mC (MvPolynomial.X (some (τ k').1)) = mC (MvPolynomial.X (some (τ k).1)) := by
        intro k' hk'
        rw [Fin.ext hk']
      simp only [dif_neg h0, dif_neg h1]
      exact key _ (by simp [hup])

  have hαH : ∀ a ∈ wcQuadModelIdeal A' (n - 2 + 2) π'
      (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0),
      MvPolynomial.eval₂Hom (algebraMap A' (wcQmbtChart A' n π' c' j)) v a = 0 := by
    intro a ha
    have hle : wcQuadModelIdeal A' (n - 2 + 2) π'
        (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0) ≤
        RingHom.ker (MvPolynomial.eval₂Hom (algebraMap A' (wcQmbtChart A' n π' c' j)) v) := by
      apply Ideal.span_le.mpr
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      rw [SetLike.mem_coe, RingHom.mem_ker, hx]
      simp only [map_sub, map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
      rw [hcollapse (algebraMap A' (wcQmbtChart A' n π' c' j)) v, hv0, hv1,
        mul_comm (mC (MvPolynomial.X none)), relC, sub_self]
    exact hle ha
  obtain ⟨α, hαmk⟩ : ∃ α : wcQmbtSSRing A' (n - 2) π' →+* wcQmbtChart A' n π' c' j,
      ∀ x, α (mM x) = MvPolynomial.eval₂Hom (algebraMap A' (wcQmbtChart A' n π' c' j)) v x :=
    ⟨Ideal.Quotient.lift _ _ hαH, fun x => by rw [hmM]; exact Ideal.Quotient.lift_mk _ _ _⟩
  have hαA : ∀ a, α (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a) =
      algebraMap A' (wcQmbtChart A' n π' c' j) a := by
    intro a
    rw [← hmM_C, hαmk, MvPolynomial.eval₂Hom_C]
  have hαX : ∀ k, α (mM (MvPolynomial.X k)) = v k := by
    intro k
    rw [hαmk, MvPolynomial.eval₂Hom_X']

  obtain ⟨η, hηj, hηi, hηo⟩ : ∃ η : Fin n → Polynomial (wcQmbtSSRing A' (n - 2) π'),
      η j = 1 ∧ η i = Polynomial.X ∧
      ∀ p (hi : p ≠ i) (hj : p ≠ j),
        η p = Polynomial.C (mM (MvPolynomial.X (up (τ.symm ⟨p, hi, hj⟩)))) := by
    refine ⟨fun p => if hj : p = j then 1 else if hi : p = i then Polynomial.X else
      Polynomial.C (mM (MvPolynomial.X (up (τ.symm ⟨p, hi, hj⟩)))), ?_, ?_, ?_⟩
    · simp
    · simp [hij]
    · intro p hi hj
      simp only [dif_neg hj, dif_neg hi]
  have hη' : ∀ p, Polynomial.derivative (η p) = if p = i then 1 else 0 := by
    intro p
    by_cases hj : p = j
    · rw [hj, hηj, Polynomial.derivative_one, if_neg (Ne.symm hij)]
    · by_cases hi : p = i
      · rw [hi, hηi, Polynomial.derivative_X, if_pos rfl]
      · rw [hηo p hi hj, Polynomial.derivative_C, if_neg hi]

  obtain ⟨g, hg⟩ : ∃ g : Polynomial (wcQmbtSSRing A' (n - 2) π'), g = ∑ p, ∑ q,
      Polynomial.C (algebraMap A' (wcQmbtSSRing A' (n - 2) π') (c' p q)) * η p * η q -
      Polynomial.C (mM (MvPolynomial.X ⟨0, by omega⟩) ^ 2) := ⟨_, rfl⟩

  have K1 : ∀ p, Polynomial.eval₂ α (mC (MvPolynomial.X (some i))) (η p) =
      mC (wcQmbtChartHat (A' := A') j p) := by
    intro p
    by_cases hj : p = j
    · rw [hj, hηj, Polynomial.eval₂_one, hhatj, map_one]
    · by_cases hi : p = i
      · rw [hi, hηi, Polynomial.eval₂_X, hhatne i hij]
      · rw [hηo p hi hj, Polynomial.eval₂_C, hαX, hvup, Equiv.apply_symm_apply, hhatne p hj]
  have hβ : Polynomial.eval₂ α (mC (MvPolynomial.X (some i))) g = 0 := by
    rw [hg]
    simp only [Polynomial.eval₂_sub, Polynomial.eval₂_finsetSum, Polynomial.eval₂_mul,
      Polynomial.eval₂_pow, Polynomial.eval₂_C, K1, hαA, map_pow, hαX, hv0]
    rw [GC, sub_self]
  obtain ⟨β, hβof, hβroot, hβmk⟩ : ∃ β : AdjoinRoot g →+* wcQmbtChart A' n π' c' j,
      (∀ z, β (AdjoinRoot.of g z) = α z) ∧ β (AdjoinRoot.root g) = mC (MvPolynomial.X (some i)) ∧
      ∀ P, β (AdjoinRoot.mk g P) = Polynomial.eval₂ α (mC (MvPolynomial.X (some i))) P :=
    ⟨AdjoinRoot.lift α _ hβ, fun z => AdjoinRoot.lift_of hβ, AdjoinRoot.lift_root hβ,
      fun P => AdjoinRoot.lift_mk hβ P⟩

  obtain ⟨w, hwj, hwne⟩ : ∃ w : Fin n → AdjoinRoot g,
      w j = AdjoinRoot.of g (mM (MvPolynomial.X ⟨1, by omega⟩)) ∧
      ∀ p, p ≠ j → w p = AdjoinRoot.mk g (η p) :=
    ⟨fun p => if p = j then AdjoinRoot.of g (mM (MvPolynomial.X ⟨1, by omega⟩)) else
      AdjoinRoot.mk g (η p), by simp, fun p hp => by simp [hp]⟩
  obtain ⟨F, hFC, hFnone, hFsome⟩ : ∃ F : MvPolynomial (Option (Fin n)) A' →+* AdjoinRoot g,
      (∀ a, F (MvPolynomial.C a) =
        AdjoinRoot.of g (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a)) ∧
      F (MvPolynomial.X none) = AdjoinRoot.of g (mM (MvPolynomial.X ⟨0, by omega⟩)) ∧
      ∀ p, F (MvPolynomial.X (some p)) = w p :=
    ⟨MvPolynomial.eval₂Hom ((AdjoinRoot.of g).comp
        (algebraMap A' (wcQmbtSSRing A' (n - 2) π')))
      (fun o => Option.elim o (AdjoinRoot.of g (mM (MvPolynomial.X ⟨0, by omega⟩))) w),
      fun a => by rw [MvPolynomial.eval₂Hom_C]; rfl,
      by rw [MvPolynomial.eval₂Hom_X']; rfl,
      fun p => by rw [MvPolynomial.eval₂Hom_X']; rfl⟩
  have hFhat : ∀ q, F (wcQmbtChartHat (A' := A') j q) = AdjoinRoot.mk g (η q) := by
    intro q
    by_cases hq : q = j
    · rw [hq, hhatj, map_one, hηj, map_one]
    · rw [hhatne q hq, hFsome, hwne q hq]
  have hFr : F (MvPolynomial.X (some j) * MvPolynomial.X none - MvPolynomial.C π') = 0 := by
    rw [map_sub, map_mul, hFsome, hFnone, hFC, hwj, ← map_mul (AdjoinRoot.of g),
      mul_comm (mM _) (mM _), relM, sub_self]
  have hFG : F (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat (A' := A') j p *
      wcQmbtChartHat (A' := A') j q - MvPolynomial.X none ^ 2) = 0 := by
    have hmkg : AdjoinRoot.mk g (∑ p, ∑ q,
        Polynomial.C (algebraMap A' (wcQmbtSSRing A' (n - 2) π') (c' p q)) * η p * η q -
        Polynomial.C (mM (MvPolynomial.X ⟨0, by omega⟩) ^ 2)) = 0 := by
      rw [← hg]
      exact AdjoinRoot.mk_self
    simp only [map_sub, map_sum, map_mul, map_pow, AdjoinRoot.mk_C] at hmkg
    simp only [map_sub, map_sum, map_mul, map_pow, hFC, hFhat, hFnone]
    exact hmkg
  have hφH : ∀ a ∈ wcQmbtChartIdeal A' n π' c' j, F a = 0 := by
    intro a ha
    have hle : wcQmbtChartIdeal A' n π' c' j ≤ RingHom.ker F := by
      apply Ideal.span_le.mpr
      intro x hx
      rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rw [SetLike.mem_coe, RingHom.mem_ker]
      rcases hx with rfl | rfl
      · exact hFr
      · exact hFG
    exact hle ha
  obtain ⟨φ, hφmk⟩ : ∃ φ : wcQmbtChart A' n π' c' j →+* AdjoinRoot g, ∀ x, φ (mC x) = F x :=
    ⟨Ideal.Quotient.lift _ F hφH, fun x => by rw [hmC]; exact Ideal.Quotient.lift_mk _ _ _⟩
  have hφA : ∀ a, φ (algebraMap A' (wcQmbtChart A' n π' c' j) a) =
      AdjoinRoot.of g (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a) := by
    intro a
    rw [← hmC_C, hφmk, hFC]
  have hφv : ∀ k, φ (v k) = AdjoinRoot.of g (mM (MvPolynomial.X k)) := by
    intro k
    by_cases h0 : k.val = 0
    · have hk : k = ⟨0, by omega⟩ := Fin.ext h0
      rw [hk, hv0, hφmk, hFnone]
    · by_cases h1 : k.val = 1
      · have hk : k = ⟨1, by omega⟩ := Fin.ext h1
        rw [hk, hv1, hφmk, hFsome, hwj]
      · obtain ⟨q, rfl⟩ : ∃ q, up q = k :=
          ⟨⟨k.val - 2, by have := k.isLt; omega⟩,
            Fin.ext (by rw [hup]; show k.val - 2 + 2 = k.val; omega)⟩
        have hqi : (τ q).1 ≠ i := (τ q).2.1
        have hqj : (τ q).1 ≠ j := (τ q).2.2
        rw [hvup, hφmk, hFsome, hwne _ hqj, hηo _ hqi hqj, AdjoinRoot.mk_C]
        have hτ : (⟨(τ q).1, hqi, hqj⟩ : {p : Fin n // p ≠ i ∧ p ≠ j}) = τ q := Subtype.ext rfl
        rw [hτ, Equiv.symm_apply_apply]

  have hM_ext : ∀ (f₁ f₂ : wcQmbtSSRing A' (n - 2) π' →+* AdjoinRoot g),
      (∀ a, f₁ (algebraMap A' _ a) = f₂ (algebraMap A' _ a)) →
      (∀ k, f₁ (mM (MvPolynomial.X k)) = f₂ (mM (MvPolynomial.X k))) → f₁ = f₂ := by
    intro f₁ f₂ hA hX
    have e : f₁.comp mM = f₂.comp mM := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, hmM_C]
        exact hA a
      · intro k
        exact hX k
    rw [hmM] at e
    exact Ideal.Quotient.ringHom_ext e
  have hC_ext : ∀ (f₁ f₂ : wcQmbtChart A' n π' c' j →+* wcQmbtChart A' n π' c' j),
      (∀ a, f₁ (algebraMap A' _ a) = f₂ (algebraMap A' _ a)) →
      (∀ o, f₁ (mC (MvPolynomial.X o)) = f₂ (mC (MvPolynomial.X o))) → f₁ = f₂ := by
    intro f₁ f₂ hA hX
    have e : f₁.comp mC = f₂.comp mC := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply, hmC_C]
        exact hA a
      · intro o
        exact hX o
    rw [hmC] at e
    exact Ideal.Quotient.ringHom_ext e

  have hφβ : φ.comp β = RingHom.id (AdjoinRoot g) := by
    apply AdjoinRoot.ringHom_ext
    · apply hM_ext
      · intro a
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hβof, hαA, hφA]
      · intro k
        simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hβof, hαX, hφv]
    · simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hβroot, hφmk, hFsome, hwne i hij, hηi, AdjoinRoot.mk_X]
  have hβφ : β.comp φ = RingHom.id (wcQmbtChart A' n π' c' j) := by
    apply hC_ext
    · intro a
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hφA, hβof, hαA]
    · intro o
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hφmk]
      cases o with
      | none => rw [hFnone, hβof, hαX, hv0]
      | some p =>
        rw [hFsome]
        by_cases hj : p = j
        · rw [hj, hwj, hβof, hαX, hv1]
        · by_cases hi : p = i
          · rw [hwne p hj, hi, hηi, hβmk, Polynomial.eval₂_X]
          · rw [hwne p hj, hβmk, K1, hhatne p hj]

  subst hg
  refine ⟨η, RingEquiv.ofRingHom φ β hφβ hβφ, hη', ?_, ?_, ?_, ?_⟩
  · rw [RingEquiv.ofRingHom_apply, hφmk]
    simp only [map_sum, map_mul, hFC, hFhat, AdjoinRoot.mk_C, map_add]
  · intro a
    rw [RingEquiv.ofRingHom_apply, hφA]
  · rw [RingEquiv.ofRingHom_apply, hφmk, hFnone]
  · rw [RingEquiv.ofRingHom_apply, hφmk, hFsome, hwj]

theorem wc_qmbt_cc_case_a {A' : Type u} [CommRing A'] {π' : A'} {n : ℕ}
    {c' : Matrix (Fin n) (Fin n) A'} {i j : Fin n} (hij : i ≠ j)
    (τ : Fin (n - 2) ≃ {p : Fin n // p ≠ i ∧ p ≠ j}) :
    ∃ ψ : wcQmbtSSRing A' (n - 2) π' →+* Localization.Away (Ideal.Quotient.mk
        (wcQmbtChartIdeal A' n π' c' j)
        (∑ q, MvPolynomial.C (c' i q + c' q i) * wcQmbtChartHat (A' := A') j q)),
      ψ.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π')) = algebraMap A' _ ∧
      ψ.Etale ∧
      ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
          (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (n - 2 + 2)))) =
        algebraMap (wcQmbtChart A' n π' c' j) _
          (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none)) ∧
      ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
          (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (n - 2 + 2)))) =
        algebraMap (wcQmbtChart A' n π' c' j) _
          (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j))) :=
by
  classical

  have L5 : ∀ {R : Type u} [CommRing R] (c : Fin n → Fin n → R) (η : Fin n → Polynomial R),
      (∀ p, Polynomial.derivative (η p) = if p = i then 1 else 0) → ∀ t : R,
      Polynomial.derivative (∑ p, ∑ q, Polynomial.C (c p q) * η p * η q - Polynomial.C t) =
        ∑ q, Polynomial.C (c i q + c q i) * η q := by
    intro R _ c η hη t
    have hterm : ∀ p q, Polynomial.derivative (Polynomial.C (c p q) * η p * η q) =
        (if p = i then Polynomial.C (c p q) * η q else 0) +
          (if q = i then Polynomial.C (c p q) * η p else 0) := by
      intro p q
      rw [Polynomial.derivative_mul, Polynomial.derivative_mul, Polynomial.derivative_C, hη p, hη q]
      split_ifs <;> ring
    have h1 : ∑ p, ∑ q, (if p = i then Polynomial.C (c p q) * η q else 0) =
        ∑ q, Polynomial.C (c i q) * η q := by
      rw [Finset.sum_eq_single i (fun b _ hb => by simp [hb]) (fun h => absurd (Finset.mem_univ i) h)]
      simp
    have h2 : ∑ p, ∑ q, (if q = i then Polynomial.C (c p q) * η p else 0) =
        ∑ p, Polynomial.C (c p i) * η p := by
      refine Finset.sum_congr rfl fun p _ => ?_
      rw [Finset.sum_ite_eq']
      simp
    rw [Polynomial.derivative_sub, Polynomial.derivative_C, sub_zero, Polynomial.derivative_sum]
    simp only [Polynomial.derivative_sum, hterm, Finset.sum_add_distrib]
    rw [h1, h2, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [map_add, add_mul]

  have glue : ∀ (g : Polynomial (wcQmbtSSRing A' (n - 2) π'))
      (e : wcQmbtChart A' n π' c' j ≃+* AdjoinRoot g),
      e (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
          (∑ q, MvPolynomial.C (c' i q + c' q i) * wcQmbtChartHat (A' := A') j q)) =
        AdjoinRoot.mk g (Polynomial.derivative g * 1) →
      (∀ a : A', e (algebraMap A' (wcQmbtChart A' n π' c' j) a) =
        AdjoinRoot.of g (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a)) →
      e (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none)) =
        AdjoinRoot.of g (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
          (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (n - 2 + 2)))) →
      e (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j))) =
        AdjoinRoot.of g (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
          (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (n - 2 + 2)))) →
      ∃ ψ : wcQmbtSSRing A' (n - 2) π' →+* Localization.Away (Ideal.Quotient.mk
          (wcQmbtChartIdeal A' n π' c' j)
          (∑ q, MvPolynomial.C (c' i q + c' q i) * wcQmbtChartHat (A' := A') j q)),
        ψ.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π')) = algebraMap A' _ ∧
        ψ.Etale ∧
        ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
            (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin (n - 2 + 2)))) =
          algebraMap (wcQmbtChart A' n π' c' j) _
            (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none)) ∧
        ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
            (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
            (MvPolynomial.X (⟨1, by omega⟩ : Fin (n - 2 + 2)))) =
          algebraMap (wcQmbtChart A' n π' c' j) _
            (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j))) := by
    intro g e hed hea hes hex
    have hL := wc_qmbt_cc_etale_adjoin_deriv (wcQmbtSSRing A' (n - 2) π') g 1
    have H : Submonoid.map e.toMonoidHom (Submonoid.powers (Ideal.Quotient.mk
          (wcQmbtChartIdeal A' n π' c' j)
          (∑ q, MvPolynomial.C (c' i q + c' q i) * wcQmbtChartHat (A' := A') j q))) =
        Submonoid.powers (AdjoinRoot.mk g (Polynomial.derivative g * 1)) := by
      rw [Submonoid.map_powers]
      exact congrArg Submonoid.powers hed
    let E := IsLocalization.ringEquivOfRingEquiv (Localization.Away (Ideal.Quotient.mk
          (wcQmbtChartIdeal A' n π' c' j)
          (∑ q, MvPolynomial.C (c' i q + c' q i) * wcQmbtChartHat (A' := A') j q)))
      (Localization.Away (AdjoinRoot.mk g (Polynomial.derivative g * 1))) e H
    have hE : ∀ y, E.symm (algebraMap (AdjoinRoot g)
        (Localization.Away (AdjoinRoot.mk g (Polynomial.derivative g * 1))) (e y)) =
        algebraMap (wcQmbtChart A' n π' c' j) (Localization.Away (Ideal.Quotient.mk
          (wcQmbtChartIdeal A' n π' c' j)
          (∑ q, MvPolynomial.C (c' i q + c' q i) * wcQmbtChartHat (A' := A') j q))) y := by
      intro y
      rw [RingEquiv.symm_apply_eq]
      exact (IsLocalization.ringEquivOfRingEquiv_eq H y).symm
    have hML : ∀ z, algebraMap (wcQmbtSSRing A' (n - 2) π')
        (Localization.Away (AdjoinRoot.mk g (Polynomial.derivative g * 1))) z =
        algebraMap (AdjoinRoot g)
          (Localization.Away (AdjoinRoot.mk g (Polynomial.derivative g * 1)))
          (AdjoinRoot.of g z) := by
      intro z
      rw [IsScalarTower.algebraMap_apply (wcQmbtSSRing A' (n - 2) π') (AdjoinRoot g)
        (Localization.Away (AdjoinRoot.mk g (Polynomial.derivative g * 1)))]
      rfl
    refine ⟨(E.symm : _ →+* _).comp (algebraMap (wcQmbtSSRing A' (n - 2) π')
      (Localization.Away (AdjoinRoot.mk g (Polynomial.derivative g * 1)))), ?_, ?_, ?_, ?_⟩
    · ext a
      simp only [RingHom.comp_apply, RingHom.coe_coe]
      rw [hML, ← hea, hE]
      exact (IsScalarTower.algebraMap_apply A' (wcQmbtChart A' n π' c' j) _ a).symm
    · exact RingHom.Etale.stableUnderComposition _ _ (RingHom.etale_algebraMap.mpr hL)
        (RingHom.Etale.of_bijective E.symm.bijective)
    · simp only [RingHom.comp_apply, RingHom.coe_coe]
      rw [hML, ← hes, hE]
    · simp only [RingHom.comp_apply, RingHom.coe_coe]
      rw [hML, ← hex, hE]
  obtain ⟨η, e, hη, hed, hea, hes, hex⟩ := wc_qmbt_cc_case_a_iso (π' := π') (c' := c') hij τ
  have hder := L5 (fun p q => algebraMap A' (wcQmbtSSRing A' (n - 2) π') (c' p q)) η hη
    ((Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
      (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
      (MvPolynomial.X (⟨0, by omega⟩ : Fin (n - 2 + 2)))) ^ 2)
  beta_reduce at hder
  refine glue _ e ?_ hea hes hex
  rw [hed, mul_one, hder]

theorem wc_qmbt_cc_case_b {A' : Type u} [CommRing A'] {π' : A'} {n : ℕ}
    {c' : Matrix (Fin n) (Fin n) A'} {i₀ j : Fin n} (hij : i₀ ≠ j)
    (τ : Fin (n - 2) ≃ {p : Fin n // p ≠ i₀ ∧ p ≠ j}) (ε : A') :
    ∃ ψ : wcQmbtSSRing A' (n - 2) π' →+* Localization.Away ((2 : wcQmbtChart A' n π' c' j) *
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none) *
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
          (MvPolynomial.X (some i₀) + MvPolynomial.C ε)),
      ψ.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π')) = algebraMap A' _ ∧ ψ.Etale :=
by
  classical

  have c4 : ∀ {M K : Type u} [CommRing M] [CommRing K] (κ m₀ : M) (α : M →+* K) (t : K),
      (∀ {L : Type u} [CommRing L] (β : M →+* L) (r : L), r ^ 2 = β κ →
        IsUnit (β (2 * m₀) * r) →
        ∃ Φ : K →+* L, Φ.comp α = β ∧ Φ t = r ∧
          ∀ Ψ : L →+* K, Ψ.comp β = α → Ψ r = t → Ψ.comp Φ = RingHom.id K) →
      t ^ 2 = α κ → IsUnit (α (2 * m₀) * t) → α.Etale := by
    intro M K _ _ κ m₀ α t hU h1 h2
    have hmk : AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
        (Polynomial.C (2 * m₀) * Polynomial.X) =
        AdjoinRoot.of (Polynomial.X ^ 2 - Polynomial.C κ) (2 * m₀) *
          AdjoinRoot.root (Polynomial.X ^ 2 - Polynomial.C κ) := by
      rw [map_mul, AdjoinRoot.mk_C, AdjoinRoot.mk_X]
    have hval : algebraMap M (Localization.Away (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
          (Polynomial.C (2 * m₀) * Polynomial.X))) (2 * m₀) *
        algebraMap (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C κ))
          (Localization.Away (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
          (Polynomial.C (2 * m₀) * Polynomial.X))) (AdjoinRoot.root _) =
        algebraMap (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C κ))
          (Localization.Away (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
          (Polynomial.C (2 * m₀) * Polynomial.X)))
          (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
            (Polynomial.C (2 * m₀) * Polynomial.X)) := by
      show algebraMap (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C κ)) _
        (AdjoinRoot.of _ (2 * m₀)) * _ = _
      rw [← map_mul, ← hmk]
    have hu0 := IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (AdjoinRoot.mk
      (Polynomial.X ^ 2 - Polynomial.C κ) (Polynomial.C (2 * m₀) * Polynomial.X)))
      (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ) (Polynomial.C (2 * m₀) * Polynomial.X))
    rw [← hval] at hu0
    have hr0 : (algebraMap (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C κ))
        (Localization.Away (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
          (Polynomial.C (2 * m₀) * Polynomial.X))) (AdjoinRoot.root _)) ^ 2 =
        algebraMap M (Localization.Away (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
          (Polynomial.C (2 * m₀) * Polynomial.X))) κ := by
      have h0 : (AdjoinRoot.root (Polynomial.X ^ 2 - Polynomial.C κ)) ^ 2 -
          AdjoinRoot.of (Polynomial.X ^ 2 - Polynomial.C κ) κ = 0 := by
        rw [← AdjoinRoot.mk_X, ← AdjoinRoot.mk_C, ← map_pow, ← map_sub]
        exact AdjoinRoot.mk_self
      have h0' := congrArg (algebraMap (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C κ))
        (Localization.Away (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
          (Polynomial.C (2 * m₀) * Polynomial.X)))) h0
      rw [map_sub, map_pow, map_zero] at h0'
      exact sub_eq_zero.mp h0'
    obtain ⟨Φ, h3, h4, h5⟩ := hU _ _ hr0 hu0
    let P : StandardEtalePair M :=
      { f := Polynomial.X ^ 2 - Polynomial.C κ
        monic_f := Polynomial.monic_X_pow_sub_C κ two_ne_zero
        g := Polynomial.C (2 * m₀) * Polynomial.X
        cond := ⟨Polynomial.C m₀, 0, 1, by
          simp [Polynomial.C_ofNat]
          ring⟩ }
    have : Algebra.Etale M P.Ring := inferInstance
    have hL : Algebra.Etale M (Localization.Away (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
        (Polynomial.C (2 * m₀) * Polynomial.X))) :=
      Algebra.Etale.of_equiv P.equivAwayAdjoinRoot
    have hLe := RingHom.etale_algebraMap.mpr hL
    have h0 : (Polynomial.X ^ 2 - Polynomial.C κ).eval₂ α t = 0 := by simp [h1]
    let Ψ₀ : AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C κ) →+* K := AdjoinRoot.lift α t h0
    have hΨ₀e : IsUnit (Ψ₀ (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
        (Polynomial.C (2 * m₀) * Polynomial.X))) := by
      simp only [Ψ₀, AdjoinRoot.lift_mk, Polynomial.eval₂_mul, Polynomial.eval₂_C,
        Polynomial.eval₂_X]
      exact h2
    let Ψ : Localization.Away (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
        (Polynomial.C (2 * m₀) * Polynomial.X)) →+* K :=
      IsLocalization.Away.lift (AdjoinRoot.mk (Polynomial.X ^ 2 - Polynomial.C κ)
        (Polynomial.C (2 * m₀) * Polynomial.X)) hΨ₀e
    have hΨB : ∀ b, Ψ (algebraMap _ _ b) = Ψ₀ b := fun b => IsLocalization.Away.lift_eq _ _ b
    have hT : ∀ a : M, algebraMap M (Localization.Away (AdjoinRoot.mk
        (Polynomial.X ^ 2 - Polynomial.C κ) (Polynomial.C (2 * m₀) * Polynomial.X))) a =
        algebraMap (AdjoinRoot (Polynomial.X ^ 2 - Polynomial.C κ)) _ (AdjoinRoot.of _ a) :=
      fun a => rfl
    have hΨ1 : Ψ.comp (algebraMap M _) = α := by
      ext a
      rw [RingHom.comp_apply, hT, hΨB]
      exact AdjoinRoot.lift_of _
    have hΨ2 : Ψ (algebraMap _ _ (AdjoinRoot.root (Polynomial.X ^ 2 - Polynomial.C κ))) = t := by
      rw [hΨB]; exact AdjoinRoot.lift_root _
    have hΨΦ := h5 Ψ hΨ1 hΨ2
    have hΦΨ : Φ.comp Ψ = RingHom.id _ := by
      apply IsLocalization.ringHom_ext (Submonoid.powers (AdjoinRoot.mk
        (Polynomial.X ^ 2 - Polynomial.C κ) (Polynomial.C (2 * m₀) * Polynomial.X)))
      apply AdjoinRoot.ringHom_ext
      · ext a
        simp only [RingHom.comp_apply, RingHom.id_apply, hΨB]
        rw [show Ψ₀ (AdjoinRoot.of _ a) = α a from AdjoinRoot.lift_of _,
          ← RingHom.comp_apply Φ α, h3, hT]
      · simp only [RingHom.comp_apply, RingHom.id_apply, hΨB]
        rw [show Ψ₀ (AdjoinRoot.root _) = t from AdjoinRoot.lift_root _, h4]
    let E := RingEquiv.ofRingHom Ψ Φ hΨΦ hΦΨ
    have hαE : α = E.toRingHom.comp (algebraMap M _) := by
      rw [← hΨ1]; rfl
    rw [hαE]
    exact RingHom.Etale.respectsIso.1 _ E hLe

  have hcol : ∀ (m : ℕ) {R : Type u} [CommRing R] (f : A' →+* R) (z : Fin (m + 2) → R),
      ∑ a : Fin (m + 2), ∑ b : Fin (m + 2), f ((Matrix.of fun a b : Fin (m + 2) =>
        if a.val = 0 ∧ b.val = 1 then (1 : A') else 0) a b) * z a * z b =
      z ⟨0, by omega⟩ * z ⟨1, by omega⟩ := by
    intro m R _ f z
    rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (m + 2))]
    · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (m + 2))]
      · simp
      · intro b _ hb
        have hb' : b.val ≠ 1 := fun h => hb (Fin.ext h)
        simp [hb']
      · simp
    · intro a _ ha
      have ha' : a.val ≠ 0 := fun h => ha (Fin.ext h)
      apply Finset.sum_eq_zero
      intro b _
      rw [Matrix.of_apply, if_neg (fun h => ha' h.1), map_zero, zero_mul, zero_mul]
    · simp

  have c1 : ∀ {T : Type u} [CommRing T] (m : ℕ) (ι : A' →+* T) (y : Fin (m + 2) → T),
      y ⟨0, by omega⟩ * y ⟨1, by omega⟩ = ι π' →
      ∃ α : wcQmbtSSRing A' m π' →+* T, α.comp (algebraMap A' (wcQmbtSSRing A' m π')) = ι ∧
        ∀ a : Fin (m + 2), α (Ideal.Quotient.mk (wcQuadModelIdeal A' (m + 2) π'
          (Matrix.of fun a b : Fin (m + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
          (MvPolynomial.X a)) = y a := by
    intro T _ m ι y hy
    have hker : ∀ a ∈ wcQuadModelIdeal A' (m + 2) π'
        (Matrix.of fun a b : Fin (m + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0),
        MvPolynomial.eval₂Hom ι y a = 0 := by
      intro a ha
      obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul]
      apply mul_eq_zero_of_right
      simp only [map_sub, map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
      rw [hcol m ι y, hy, sub_self]
    refine ⟨Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom ι y) hker, ?_, ?_⟩
    · ext a
      show Ideal.Quotient.lift (wcQuadModelIdeal A' (m + 2) π' (Matrix.of fun a b : Fin (m + 2) =>
          if a.val = 0 ∧ b.val = 1 then (1 : A') else 0)) (MvPolynomial.eval₂Hom ι y) hker
        (Ideal.Quotient.mk (wcQuadModelIdeal A' (m + 2) π' (Matrix.of fun a b : Fin (m + 2) =>
          if a.val = 0 ∧ b.val = 1 then (1 : A') else 0)) (MvPolynomial.C a)) = ι a
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
    · intro a
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']

  have c3 : ∀ {T : Type u} [CommRing T] (ι : A' →+* T) (z : T) (w : Fin n → T),
      w j * z = ι π' →
      ∑ p, ∑ q, ι (c' p q) * (if p = j then 1 else w p) * (if q = j then 1 else w q) = z ^ 2 →
      ∃ φ : wcQmbtChart A' n π' c' j →+* T, φ.comp (algebraMap A' _) = ι ∧
        φ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none)) = z ∧
        ∀ p, φ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
          (MvPolynomial.X (some p))) = w p := by
    intro T _ ι z w h1 h2
    obtain ⟨e, he⟩ : ∃ e : MvPolynomial (Option (Fin n)) A' →+* T,
        e = MvPolynomial.eval₂Hom ι (fun o => Option.elim o z w) := ⟨_, rfl⟩
    have heC : ∀ a, e (MvPolynomial.C a) = ι a := fun a => by rw [he, MvPolynomial.eval₂Hom_C]
    have heN : e (MvPolynomial.X none) = z := by rw [he, MvPolynomial.eval₂Hom_X']; rfl
    have heS : ∀ p, e (MvPolynomial.X (some p)) = w p := fun p => by
      rw [he, MvPolynomial.eval₂Hom_X']; rfl
    have hhat : ∀ p, e (wcQmbtChartHat (A' := A') j p) = if p = j then 1 else w p := by
      intro p
      by_cases hp : p = j
      · rw [if_pos hp]; simp only [wcQmbtChartHat, if_pos hp, map_one]
      · rw [if_neg hp]; simp only [wcQmbtChartHat, if_neg hp, heS]
    have hker : ∀ a ∈ wcQmbtChartIdeal A' n π' c' j, e a = 0 := by
      intro a ha
      have hle : wcQmbtChartIdeal A' n π' c' j ≤ RingHom.ker e := by
        rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
        refine ⟨?_, ?_⟩
        · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_mul, heS, heN, heC, h1, sub_self]
        · rw [SetLike.mem_coe, RingHom.mem_ker]
          simp only [map_sub, map_sum, map_mul, map_pow, heC, hhat, heN]
          rw [h2, sub_self]
      exact hle ha
    refine ⟨Ideal.Quotient.lift _ e hker, ?_, ?_, ?_⟩
    · ext a
      show Ideal.Quotient.lift (wcQmbtChartIdeal A' n π' c' j) e hker
        (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.C a)) = ι a
      rw [Ideal.Quotient.lift_mk, heC]
    · rw [Ideal.Quotient.lift_mk, heN]
    · intro p; rw [Ideal.Quotient.lift_mk, heS]

  set mkC := Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) with hmkC
  set mkM := Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
    (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
    with hmkM
  set H : wcQmbtChart A' n π' c' j := (2 : wcQmbtChart A' n π' c' j) * mkC (MvPolynomial.X none) *
    mkC (MvPolynomial.X (some i₀) + MvPolynomial.C ε) with hH
  set algC := algebraMap (wcQmbtChart A' n π' c' j) (Localization.Away H) with halgC
  have hAK : ∀ a, algebraMap A' (Localization.Away H) a = algC (mkC (MvPolynomial.C a)) := by
    intro a
    rw [IsScalarTower.algebraMap_apply A' (wcQmbtChart A' n π' c' j) (Localization.Away H)]
    rfl

  set S := algC (mkC (MvPolynomial.X none)) with hSdef
  set V := algC (mkC (MvPolynomial.X (some i₀) + MvPolynomial.C ε)) with hVdef
  have hHK : algC H = 2 * S * V := by
    show algC ((2 : wcQmbtChart A' n π' c' j) * mkC (MvPolynomial.X none) *
      mkC (MvPolynomial.X (some i₀) + MvPolynomial.C ε)) = _
    rw [map_mul, map_mul, map_ofNat]
  have hHu : IsUnit (algC H) := IsLocalization.Away.algebraMap_isUnit H
  have hSV : IsUnit S ∧ IsUnit V := by
    rw [hHK] at hHu
    obtain ⟨h1, h2⟩ := IsUnit.mul_iff.mp hHu
    exact ⟨(IsUnit.mul_iff.mp h1).2, h2⟩
  obtain ⟨hS, hV⟩ := hSV
  have hVe : V = algC (mkC (MvPolynomial.X (some i₀))) + algebraMap A' (Localization.Away H) ε := by
    rw [hAK, hVdef, map_add, map_add]
  obtain ⟨Vinv, hVinv⟩ : ∃ x, x = (↑hV.unit⁻¹ : Localization.Away H) := ⟨_, rfl⟩
  have hVV : V * Vinv = 1 := by rw [hVinv]; exact IsUnit.mul_val_inv hV

  obtain ⟨y, hy⟩ : ∃ y : Fin (n - 2 + 2) → Localization.Away H, y = fun a : Fin (n - 2 + 2) =>
      if h0 : a.val = 0 then V else if h1 : a.val = 1 then
        algebraMap A' (Localization.Away H) π' * Vinv
      else algC (mkC (MvPolynomial.X (some (τ ⟨a.val - 2, by have := a.isLt; omega⟩).1))) :=
    ⟨_, rfl⟩
  have hy0 : y ⟨0, by omega⟩ = V := by rw [hy]; rfl
  have hy1 : y ⟨1, by omega⟩ = algebraMap A' (Localization.Away H) π' * Vinv := by
    rw [hy]; simp
  have hyk : ∀ k : Fin (n - 2), y ⟨k.val + 2, Nat.add_lt_add_right k.isLt 2⟩ =
      algC (mkC (MvPolynomial.X (some (τ k).1))) := by
    intro k
    rw [hy]
    simp only [Nat.add_eq_zero_iff, OfNat.ofNat_ne_zero, and_false, dite_false,
      Nat.add_sub_cancel, Fin.eta]
    rw [dif_neg (by omega)]
  have hyπ : y ⟨0, by omega⟩ * y ⟨1, by omega⟩ = algebraMap A' (Localization.Away H) π' := by
    rw [hy0, hy1, mul_left_comm, hVV, mul_one]
  obtain ⟨α, hαA, hαX⟩ := c1 (n - 2) (algebraMap A' (Localization.Away H)) y hyπ
  have hαa : ∀ a, α (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a) =
      algebraMap A' (Localization.Away H) a := fun a => by rw [← RingHom.comp_apply, hαA]

  obtain ⟨m₀, hm₀⟩ : ∃ x : wcQmbtSSRing A' (n - 2) π', x = mkM (MvPolynomial.X ⟨0, by omega⟩) :=
    ⟨_, rfl⟩
  have hc2 : m₀ * mkM (MvPolynomial.X ⟨1, by omega⟩) =
      algebraMap A' (wcQmbtSSRing A' (n - 2) π') π' := by
    have h := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton
      (∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun a b : Fin (n - 2 + 2) =>
        if a.val = 0 ∧ b.val = 1 then (1 : A') else 0) p q) * MvPolynomial.X p * MvPolynomial.X q -
        MvPolynomial.C π')))
    rw [← hmkM] at h
    simp only [map_sub, map_sum, map_mul] at h
    have h2 := hcol (n - 2) (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))
      (fun a => mkM (MvPolynomial.X a))
    rw [hm₀, ← h2, ← sub_eq_zero]
    exact h

  let η : Fin n → wcQmbtSSRing A' (n - 2) π' := fun p =>
    if hpj : p = j then 1 else if hpi : p = i₀ then
      m₀ - algebraMap A' (wcQmbtSSRing A' (n - 2) π') ε
    else mkM (MvPolynomial.X ⟨(τ.symm ⟨p, hpi, hpj⟩).val + 2,
      Nat.add_lt_add_right (τ.symm ⟨p, hpi, hpj⟩).isLt 2⟩)
  obtain ⟨κ, hκ⟩ : ∃ x : wcQmbtSSRing A' (n - 2) π', x = ∑ p, ∑ q,
      algebraMap A' (wcQmbtSSRing A' (n - 2) π') (c' p q) * η p * η q := ⟨_, rfl⟩
  have hηj : η j = 1 := dif_pos rfl
  have hηi : η i₀ = m₀ - algebraMap A' (wcQmbtSSRing A' (n - 2) π') ε := by
    simp only [η, dif_neg hij]; exact dif_pos trivial
  have hηk : ∀ k : Fin (n - 2), η (τ k).1 =
      mkM (MvPolynomial.X ⟨k.val + 2, Nat.add_lt_add_right k.isLt 2⟩) := by
    intro k
    simp only [η, dif_neg (τ k).2.2, dif_neg (τ k).2.1, Subtype.coe_eta, Equiv.symm_apply_apply]
  have hαX' : ∀ a, α (mkM (MvPolynomial.X a)) = y a := hαX
  have hαm₀ : α m₀ = V := by rw [hm₀, hαX', hy0]

  have hGC : mkC (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat (A' := A') j p *
      wcQmbtChartHat (A' := A') j q) = mkC (MvPolynomial.X none) ^ 2 := by
    have h := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert_of_mem
      (MvPolynomial.X (some j) * MvPolynomial.X none - MvPolynomial.C π')
      (Set.mem_singleton (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat (A' := A') j p *
        wcQmbtChartHat (A' := A') j q - MvPolynomial.X none ^ 2))))
    rw [← hmkC, map_sub, sub_eq_zero, map_pow] at h
    exact h
  have hxs : mkC (MvPolynomial.X (some j)) * mkC (MvPolynomial.X none) =
      mkC (MvPolynomial.C π') := by
    have h := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert
      (MvPolynomial.X (some j) * MvPolynomial.X none - MvPolynomial.C π')
      {∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat (A' := A') j p *
        wcQmbtChartHat (A' := A') j q - MvPolynomial.X none ^ 2}))
    rw [← hmkC, map_sub, sub_eq_zero, map_mul] at h
    exact h
  have hhat : ∀ p, p ≠ j → wcQmbtChartHat (A' := A') j p = MvPolynomial.X (some p) :=
    fun p hp => if_neg hp

  have hαη : ∀ p, α (η p) = algC (mkC (wcQmbtChartHat (A' := A') j p)) := by
    intro p
    by_cases hpj : p = j
    · subst hpj
      rw [hηj, map_one, show wcQmbtChartHat (A' := A') p p = 1 from if_pos rfl, map_one, map_one]
    · rw [hhat p hpj]
      by_cases hpi : p = i₀
      · subst hpi
        rw [hηi, map_sub, hαm₀, hαa, hVe, add_sub_cancel_right]
      · obtain ⟨k, hk⟩ : ∃ k, (τ k).1 = p := ⟨τ.symm ⟨p, hpi, hpj⟩, by simp⟩
        subst hk
        rw [hηk, hαX', hyk]

  have h1 : S ^ 2 = α κ := by
    rw [hSdef, ← map_pow, ← hGC, hκ]
    simp only [map_sum, map_mul, hαa, hαη, hAK]

  have h2 : IsUnit (α (2 * m₀) * S) := by
    rw [map_mul, map_ofNat, hαm₀, show (2 : Localization.Away H) * V * S = 2 * S * V by ring,
      ← hHK]
    exact hHu
  refine ⟨α, hαA, c4 κ m₀ α S ?_ h1 h2⟩
  intro L _ β r hr2 hu
  obtain ⟨h2m, hru⟩ := IsUnit.mul_iff.mp hu
  rw [map_mul, map_ofNat] at h2m
  have hm0u := (IsUnit.mul_iff.mp h2m).2
  obtain ⟨rinv, hrinv⟩ : ∃ x, x = (↑hru.unit⁻¹ : L) := ⟨_, rfl⟩
  have hrr : rinv * r = 1 := by rw [hrinv]; exact IsUnit.val_inv_mul hru

  obtain ⟨w, hw⟩ : ∃ w : Fin n → L, w = fun p =>
      if p = j then β (algebraMap A' (wcQmbtSSRing A' (n - 2) π') π') * rinv
      else β (η p) := ⟨_, rfl⟩
  have hwj : w j = β (algebraMap A' (wcQmbtSSRing A' (n - 2) π') π') * rinv := by
    rw [hw]; exact if_pos rfl
  have hwp : ∀ p, p ≠ j → w p = β (η p) := by
    intro p hp; rw [hw]; exact if_neg hp
  have hŵ : ∀ p, (if p = j then 1 else w p) = β (η p) := by
    intro p
    by_cases hp : p = j
    · subst hp; rw [if_pos rfl, hηj, map_one]
    · rw [if_neg hp, hwp p hp]
  obtain ⟨φ, hφA, hφN, hφS⟩ := c3 (β.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))) r w
    (by rw [hwj, RingHom.comp_apply, mul_assoc, hrr, mul_one])
    (by
      simp only [hŵ, RingHom.comp_apply]
      rw [hr2, hκ]
      simp only [map_sum, map_mul])
  have hφN' : φ (mkC (MvPolynomial.X none)) = r := hφN
  have hφS' : ∀ p, φ (mkC (MvPolynomial.X (some p))) = w p := hφS
  have hφa : ∀ a, φ (mkC (MvPolynomial.C a)) =
      β (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a) := by
    intro a
    rw [← RingHom.comp_apply β (algebraMap A' (wcQmbtSSRing A' (n - 2) π')), ← hφA]
    rfl
  have hφv : φ (mkC (MvPolynomial.X (some i₀) + MvPolynomial.C ε)) = β m₀ := by
    rw [map_add, map_add, hφS', hφa, hwp i₀ hij, hηi, map_sub, sub_add_cancel]
  have hφH : IsUnit (φ H) := by
    show IsUnit (φ ((2 : wcQmbtChart A' n π' c' j) * mkC (MvPolynomial.X none) *
      mkC (MvPolynomial.X (some i₀) + MvPolynomial.C ε)))
    rw [map_mul, map_mul, map_ofNat, hφN', hφv,
      show (2 : L) * r * β m₀ = 2 * β m₀ * r by ring]
    exact h2m.mul hru
  let Φ := IsLocalization.Away.lift (S := Localization.Away H) H hφH
  have hΦC : ∀ c, Φ (algC c) = φ c := fun c => IsLocalization.Away.lift_eq H hφH c
  have hΦA : ∀ a, Φ (algebraMap A' (Localization.Away H) a) =
      β (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a) := by
    intro a; rw [hAK, hΦC, hφa]
  have hΦV : Φ V = β m₀ := by rw [hVdef, hΦC, hφv]
  refine ⟨Φ, ?_, ?_, ?_⟩
  ·
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      show Φ (α (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a)) =
        β (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a)
      rw [hαa, hΦA]
    · intro a
      show Φ (α (mkM (MvPolynomial.X a))) = β (mkM (MvPolynomial.X a))
      rw [hαX']
      by_cases ha0 : a.val = 0
      · have ha : a = ⟨0, by omega⟩ := Fin.ext ha0
        rw [ha, hy0, hΦV, hm₀]
      · by_cases ha1 : a.val = 1
        · have ha : a = ⟨1, by omega⟩ := Fin.ext ha1
          rw [ha, hy1]
          apply (hm0u.mul_left_inj).mp
          rw [← hΦV, ← map_mul, mul_assoc, mul_comm Vinv V, hVV, mul_one, hΦA, hΦV, ← map_mul,
            mul_comm (mkM _) m₀, hc2]
        · obtain ⟨k, hk⟩ : ∃ k : Fin (n - 2), a = ⟨k.val + 2, Nat.add_lt_add_right k.isLt 2⟩ :=
            ⟨⟨a.val - 2, by have := a.isLt; omega⟩, Fin.ext (by simp; omega)⟩
          subst hk
          rw [hyk, hΦC, hφS', hwp _ (τ k).2.2, hηk]
  ·
    rw [hSdef, hΦC, hφN']
  ·
    intro Ψ hΨ1 hΨ2
    apply IsLocalization.ringHom_ext (Submonoid.powers H)
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      show Ψ (Φ (algC (mkC (MvPolynomial.C a)))) = algC (mkC (MvPolynomial.C a))
      rw [hΦC, hφa, ← RingHom.comp_apply Ψ β, hΨ1, hαa, hAK]
    · intro o
      show Ψ (Φ (algC (mkC (MvPolynomial.X o)))) = algC (mkC (MvPolynomial.X o))
      rw [hΦC]
      cases o with
      | none => rw [hφN', hΨ2]
      | some p =>
        rw [hφS']
        by_cases hp : p = j
        · subst hp
          rw [hwj]
          apply (hS.mul_left_inj).mp
          rw [← hΨ2, ← map_mul, mul_assoc, hrr, mul_one, ← RingHom.comp_apply Ψ β, hΨ1, hαa,
            hΨ2, hSdef, ← map_mul, hxs, hAK]
        · rw [hwp p hp, ← RingHom.comp_apply Ψ β, hΨ1, hαη, hhat p hp]

theorem wc_qmbt_bm_chart_coords {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {n : ℕ} (hn : 2 ≤ n) {c' : Matrix (Fin n) (Fin n) A'} (hc' : IsUnit (c' + c'.transpose).det)
    (j : Fin n) (𝔭 : PrimeSpectrum (wcQmbtChart A' n π' c' j)) :
    ∃ (h : wcQmbtChart A' n π' c' j) (ψ : wcQmbtSSRing A' (n - 2) π' →+* Localization.Away h),
      h ∉ 𝔭.asIdeal ∧
      ψ.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π')) = algebraMap A' (Localization.Away h) ∧
      ψ.Etale ∧
      (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none) ∈ 𝔭.asIdeal →
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j)) ∈ 𝔭.asIdeal →
        ∀ 𝔮 : PrimeSpectrum (Localization.Away h),
          𝔮.asIdeal.comap (algebraMap (wcQmbtChart A' n π' c' j) (Localization.Away h)) =
            𝔭.asIdeal →
          ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
              (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
              (MvPolynomial.X (⟨0, by omega⟩ : Fin (n - 2 + 2)))) ∈ 𝔮.asIdeal ∧
          ψ (Ideal.Quotient.mk (wcQuadModelIdeal A' (n - 2 + 2) π'
              (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
              (MvPolynomial.X (⟨1, by omega⟩ : Fin (n - 2 + 2)))) ∈ 𝔮.asIdeal) :=
by
  classical

  have hcompl : ∀ i : Fin n, i ≠ j →
      Nonempty (Fin (n - 2) ≃ {p : Fin n // p ≠ i ∧ p ≠ j}) := by
    intro i hij
    refine ⟨Fintype.equivOfCardEq ?_⟩
    rw [Fintype.card_fin, Fintype.card_subtype]
    have e : (Finset.univ.filter fun p : Fin n => p ≠ i ∧ p ≠ j) = Finset.univ \ {i, j} := by
      ext p
      simp
    rw [e, Finset.card_univ_diff, Finset.card_pair hij, Fintype.card_fin]
  by_cases H : ∃ i, i ≠ j ∧ Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
      (∑ q, MvPolynomial.C (c' i q + c' q i) * wcQmbtChartHat (A' := A') j q) ∉ 𝔭.asIdeal
  ·
    obtain ⟨i, hij, hi⟩ := H
    obtain ⟨τ⟩ := hcompl i hij
    obtain ⟨ψ, hA, hE, h0, h1⟩ := wc_qmbt_cc_case_a (π' := π') (c' := c') hij τ
    refine ⟨_, ψ, hi, hA, hE, ?_⟩
    intro hs hx 𝔮 h𝔮
    rw [h0, h1]
    constructor
    · rw [← Ideal.mem_comap, h𝔮]
      exact hs
    · rw [← Ideal.mem_comap, h𝔮]
      exact hx
  ·
    push_neg at H
    let κ := 𝔭.asIdeal.ResidueField
    let φ : wcQmbtChart A' n π' c' j →+* κ := algebraMap _ κ
    let ι : A' →+* κ :=
      φ.comp ((Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)).comp MvPolynomial.C)
    let û : Fin n → κ := fun p =>
      φ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (wcQmbtChartHat (A' := A') j p))
    let sb : κ := φ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none))
    have hdet : ((c'.map ι) + (c'.map ι).transpose).det ≠ 0 := by
      have h1 : c'.map ι + (c'.map ι).transpose = (c' + c'.transpose).map ι := by
        ext a b
        simp [Matrix.map_apply, Matrix.transpose_apply]
      rw [h1, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
      exact (hc'.map ι).ne_zero
    have hG : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
        (∑ p, ∑ q, MvPolynomial.C (c' p q) * wcQmbtChartHat (A' := A') j p *
          wcQmbtChartHat (A' := A') j q - MvPolynomial.X none ^ 2) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
    have hquad : ∑ p, ∑ q, (c'.map ι) p q * û p * û q = sb ^ 2 := by
      have := congrArg φ hG
      simp only [map_sub, map_sum, map_mul, map_pow, map_zero] at this
      exact sub_eq_zero.mp this
    have hmv : ∀ i, (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) i =
        φ (Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
          (∑ q, MvPolynomial.C (c' i q + c' q i) * wcQmbtChartHat (A' := A') j q)) := by
      intro i
      simp only [Matrix.mulVec, dotProduct, map_sum, map_mul, map_add, Matrix.add_apply,
        Matrix.transpose_apply, Matrix.map_apply, ι, û, RingHom.comp_apply]
    have hûj : û j = 1 := by
      simp [û, wcQmbtChartHat]
    have hne : (2 : κ) ≠ 0 ∧ sb ≠ 0 := by
      by_contra hcon
      have h2s : (2 : κ) * sb ^ 2 = 0 := by
        rcases not_and_or.mp hcon with h | h
        · push_neg at h
          rw [h, zero_mul]
        · push_neg at h
          rw [h]
          ring
      have hzero_off : ∀ i, i ≠ j → (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) i = 0 := by
        intro i hij
        rw [hmv i]
        exact Ideal.algebraMap_residueField_eq_zero.mpr (H i hij)
      have hsum1 : ∑ i, û i * (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) i =
          (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) j := by
        rw [Finset.sum_eq_single j]
        · rw [hûj, one_mul]
        · intro b _ hb
          rw [hzero_off b hb, mul_zero]
        · intro h
          exact absurd (Finset.mem_univ j) h
      have e3 : ∑ i, ∑ q, (c'.map ι) q i * û i * û q = ∑ p, ∑ q, (c'.map ι) p q * û p * û q := by
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun y _ => Finset.sum_congr rfl fun x _ => ?_
        ring
      have hsum2 : ∑ i, û i * (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) i = 2 * sb ^ 2 := by
        have e1 : ∑ i, û i * (Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û) i =
            ∑ i, ∑ q, (c'.map ι) i q * û i * û q + ∑ i, ∑ q, (c'.map ι) q i * û i * û q := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun i _ => ?_
          simp only [Matrix.mulVec, dotProduct, Matrix.add_apply, Matrix.transpose_apply,
            Finset.mul_sum]
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun q _ => ?_
          ring
        rw [e1, e3, hquad]
        ring
      have hNu : Matrix.mulVec (c'.map ι + (c'.map ι).transpose) û = 0 := by
        funext i
        by_cases hij : i = j
        · rw [hij, ← hsum1, hsum2, h2s]
          rfl
        · exact hzero_off i hij
      have hû0 : û ≠ 0 := by
        intro h
        have := congrFun h j
        rw [hûj] at this
        exact one_ne_zero this
      exact hdet (Matrix.exists_mulVec_eq_zero_iff.mp ⟨û, hû0, hNu⟩)
    have h2p : (2 : wcQmbtChart A' n π' c' j) ∉ 𝔭.asIdeal := by
      intro h
      have := Ideal.algebraMap_residueField_eq_zero.mpr h
      rw [map_ofNat] at this
      exact hne.1 this
    have hsp : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none) ∉
        𝔭.asIdeal := by
      intro h
      exact hne.2 (Ideal.algebraMap_residueField_eq_zero.mpr h)
    obtain ⟨i₀, hi₀⟩ : ∃ i₀ : Fin n, i₀ ≠ j := by
      by_cases hj : j.val = 0
      · refine ⟨⟨1, by omega⟩, fun h => ?_⟩
        rw [← h] at hj
        exact Nat.one_ne_zero hj
      · exact ⟨⟨0, by omega⟩, fun h => hj (by rw [← h])⟩
    obtain ⟨ε, hv⟩ : ∃ ε : A', Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
        (MvPolynomial.X (some i₀) + MvPolynomial.C ε) ∉ 𝔭.asIdeal := by
      by_cases hu : Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
          (MvPolynomial.X (some i₀)) ∈ 𝔭.asIdeal
      · refine ⟨1, fun hmem => ?_⟩
        simp only [map_add, map_one] at hmem
        have h1 := (Ideal.add_mem_iff_right _ hu).mp hmem
        exact 𝔭.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)
      · refine ⟨0, ?_⟩
        simpa using hu
    have hh : (2 : wcQmbtChart A' n π' c' j) *
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none) *
        Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j)
          (MvPolynomial.X (some i₀) + MvPolynomial.C ε) ∉ 𝔭.asIdeal := by
      intro hmem
      rcases 𝔭.isPrime.mem_or_mem hmem with h1 | h1
      · rcases 𝔭.isPrime.mem_or_mem h1 with h2 | h2
        · exact h2p h2
        · exact hsp h2
      · exact hv h1
    obtain ⟨τ⟩ := hcompl i₀ hi₀
    obtain ⟨ψ, hA, hE⟩ := wc_qmbt_cc_case_b (π' := π') (c' := c') hi₀ τ ε
    refine ⟨_, ψ, hh, hA, hE, ?_⟩
    intro hs
    exact absurd hs hsp

theorem wc_qmbt_cn_etale_pres (M : Type u) [CommRing M] (g : Polynomial M) (b : M) :
    Algebra.Etale M (MvPolynomial (Fin 2) M ⧸ wcQmbtCnPres M g b) :=
by
  classical
  set Q : MvPolynomial (Fin 2) M :=
    Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) M) (Polynomial.derivative g) with hQ
  set r₀ : MvPolynomial (Fin 2) M :=
    Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) M) g with hr₀
  set r₁ : MvPolynomial (Fin 2) M := MvPolynomial.X 1 * MvPolynomial.C b * Q - 1 with hr₁
  set v : Fin 2 → MvPolynomial (Fin 2) M := ![r₀, r₁] with hv
  have hI : Ideal.span (Set.range v) = wcQmbtCnPres M g b := by
    rw [hv, Matrix.range_cons_cons_empty]
  let P : Algebra.PreSubmersivePresentation M (MvPolynomial (Fin 2) M ⧸ Ideal.span (Set.range v))
      (Fin 2) (Fin 2) :=
    Algebra.PreSubmersivePresentation.naive (v := v) id Function.injective_id
  have hJ : ∀ i j, P.jacobiMatrix i j = MvPolynomial.pderiv i (v j) := by
    intro i j
    rw [Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
    rfl
  have h01 : (0 : Fin 2) ≠ 1 := by decide
  have hQ1 : MvPolynomial.pderiv (1 : Fin 2) Q = 0 := by
    rw [hQ, Derivation.map_aeval, MvPolynomial.pderiv_X_of_ne h01, smul_zero]
  have hJ00 : P.jacobiMatrix 0 0 = Q := by
    rw [hJ]
    simp only [hv, Matrix.cons_val_zero, hr₀]
    rw [Derivation.map_aeval, MvPolynomial.pderiv_X_self, smul_eq_mul, mul_one]
  have hJ10 : P.jacobiMatrix 1 0 = 0 := by
    rw [hJ]
    simp only [hv, Matrix.cons_val_zero, hr₀]
    rw [Derivation.map_aeval, MvPolynomial.pderiv_X_of_ne h01, smul_zero]
  have hJ11 : P.jacobiMatrix 1 1 = Q * MvPolynomial.C b := by
    rw [hJ]
    show MvPolynomial.pderiv (1 : Fin 2) r₁ = Q * MvPolynomial.C b
    rw [hr₁]
    rw [map_sub, Derivation.leibniz, Derivation.leibniz, hQ1, MvPolynomial.pderiv_C,
      MvPolynomial.pderiv_X_self, Derivation.map_one_eq_zero]
    simp only [smul_eq_mul]
    ring
  have hdet : P.jacobiMatrix.det = MvPolynomial.C b * Q ^ 2 := by
    rw [Matrix.det_fin_two, hJ00, hJ10, hJ11]
    ring
  have hunit : IsUnit P.jacobian := by
    rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, hdet]
    have halg : ∀ x, algebraMap P.Ring (MvPolynomial (Fin 2) M ⧸ Ideal.span (Set.range v)) x =
        Ideal.Quotient.mk (Ideal.span (Set.range v)) x := fun x => rfl
    rw [halg]
    have hrel : Ideal.Quotient.mk (Ideal.span (Set.range v)) r₁ = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨1, rfl⟩)
    rw [hr₁, map_sub, map_one, map_mul, map_mul, sub_eq_zero] at hrel
    refine IsUnit.of_mul_eq_one
      (Ideal.Quotient.mk (Ideal.span (Set.range v)) (MvPolynomial.X 1) ^ 2 *
        Ideal.Quotient.mk (Ideal.span (Set.range v)) (MvPolynomial.C b)) ?_
    rw [map_mul, map_pow]
    calc _ = (Ideal.Quotient.mk (Ideal.span (Set.range v)) (MvPolynomial.X 1) *
          Ideal.Quotient.mk (Ideal.span (Set.range v)) (MvPolynomial.C b) *
          Ideal.Quotient.mk (Ideal.span (Set.range v)) Q) ^ 2 := by ring
      _ = 1 := by rw [hrel, one_pow]
  let P' : Algebra.SubmersivePresentation M (MvPolynomial (Fin 2) M ⧸ Ideal.span (Set.range v))
      (Fin 2) (Fin 2) := ⟨P, hunit⟩
  have hdim : P'.dimension = 0 := by
    simp [Algebra.Presentation.dimension]
  have := P'.isStandardSmoothOfRelativeDimension hdim
  have : Algebra.Etale M (MvPolynomial (Fin 2) M ⧸ Ideal.span (Set.range v)) := inferInstance
  exact Algebra.Etale.of_equiv (Ideal.quotientEquivAlgOfEq M hI)

theorem wc_qmbt_cn_chart_iso {A' : Type u} [CommRing A'] (π' : A') {n : ℕ}
    (c' : Matrix (Fin n) (Fin n) A') (i k0 : Fin n) (hik : i ≠ k0) (eps : A')
    (e : Fin n ≃ Fin (n - 2 + 2)) (he0 : (e k0).val = 0) (he1 : (e i).val = 1) :
    ∃ Φ : MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π') ⧸
        wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') (wcQmbtCnPoly π' c' i k0 eps e)
          (wcQmbtCnMk A' n π' (MvPolynomial.X (e k0))) →+*
        Localization.Away (wcQmbtCnD c' i *
          (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X k0) +
            algebraMap A' (wcQmbtChartNone A' n c') eps)),
      Function.Bijective Φ ∧
      (Φ.comp (algebraMap (wcQmbtSSRing A' (n - 2) π') _)).comp
          (algebraMap A' (wcQmbtSSRing A' (n - 2) π')) =
        algebraMap A' (Localization.Away (wcQmbtCnD c' i *
          (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X k0) +
            algebraMap A' (wcQmbtChartNone A' n c') eps))) :=
by
  classical

  have hHatE : ∀ {R : Type u} [CommRing R] (f : wcQmbtSSRing A' (n - 2) π' →+* R) (t : R)
      (p : Fin n), Polynomial.eval₂ f t (wcQmbtCnHat π' i k0 eps e p) =
        if p = i then t else f (wcQmbtCnMk A' n π' (MvPolynomial.X (e p)) -
          if p = k0 then algebraMap A' (wcQmbtSSRing A' (n - 2) π') eps else 0) := by
    intro R _ f t p
    unfold wcQmbtCnHat
    split_ifs <;> simp
  have hHatD : ∀ p, Polynomial.derivative (wcQmbtCnHat π' i k0 eps e p) =
      if p = i then 1 else 0 := by
    intro p
    unfold wcQmbtCnHat
    split_ifs <;> simp
  have hDer : Polynomial.derivative (wcQmbtCnPoly π' c' i k0 eps e) =
      ∑ q, (Polynomial.C (algebraMap A' (wcQmbtSSRing A' (n - 2) π') (c' i q)) +
        Polynomial.C (algebraMap A' (wcQmbtSSRing A' (n - 2) π') (c' q i))) *
          wcQmbtCnHat π' i k0 eps e q := by
    unfold wcQmbtCnPoly
    simp only [Polynomial.derivative_sub, Polynomial.derivative_one, sub_zero,
      Polynomial.derivative_sum, Polynomial.derivative_mul, Polynomial.derivative_C, zero_mul,
      zero_add, hHatD, mul_ite, mul_one, mul_zero, ite_mul, Finset.sum_add_distrib]
    rw [Finset.sum_eq_single i (fun p _ hp => by simp [hp]) (by simp)]
    simp only [ite_true, Finset.sum_ite_eq', Finset.mem_univ, add_mul, Finset.sum_add_distrib]

  have collapse : ∀ {R : Type u} [CommRing R] (φ : A' →+* R) (z : Fin (n - 2 + 2) → R),
      ∑ a, ∑ b, φ ((Matrix.of fun a b : Fin (n - 2 + 2) =>
        if a.val = 0 ∧ b.val = 1 then (1 : A') else 0) a b) * z a * z b =
        z ⟨0, by omega⟩ * z ⟨1, by omega⟩ := by
    intro R _ φ z
    rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (n - 2 + 2))]
    · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (n - 2 + 2))]
      · simp
      · intro b _ hb
        have : b.val ≠ 1 := fun h => hb (Fin.ext h)
        simp [this]
      · intro h; exact absurd (Finset.mem_univ _) h
    · intro a _ ha
      have : a.val ≠ 0 := fun h => ha (Fin.ext h)
      apply Finset.sum_eq_zero
      intro b _
      simp only [Matrix.of_apply, this, false_and, if_false, map_zero, zero_mul]
    · intro h; exact absurd (Finset.mem_univ _) h
  have hMmk : ∀ a : A', wcQmbtCnMk A' n π' (MvPolynomial.C a) =
      algebraMap A' (wcQmbtSSRing A' (n - 2) π') a := by
    intro a
    rw [← MvPolynomial.algebraMap_eq]
    exact Ideal.Quotient.mk_algebraMap A' _ a
  have hrel : wcQmbtCnMk A' n π' (MvPolynomial.X ⟨0, by omega⟩) *
      wcQmbtCnMk A' n π' (MvPolynomial.X ⟨1, by omega⟩) =
        algebraMap A' (wcQmbtSSRing A' (n - 2) π') π' := by
    have h0 : wcQmbtCnMk A' n π' (∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun a b : Fin (n - 2 + 2) =>
        if a.val = 0 ∧ b.val = 1 then (1 : A') else 0) p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C π') = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    simp only [map_sub, map_sum, map_mul, hMmk] at h0
    rw [collapse (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))
      (fun j => wcQmbtCnMk A' n π' (MvPolynomial.X j))] at h0
    exact sub_eq_zero.mp h0

  have hCmk : ∀ a : A', Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C a) =
      algebraMap A' (wcQmbtChartNone A' n c') a := by
    intro a
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  have hF : ∑ p, ∑ q, algebraMap A' (wcQmbtChartNone A' n c') (c' p q) *
      Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X p) *
      Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X q) = 1 := by
    have h0 : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c')
        (∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q - 1) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    rw [map_sub, map_one, sub_eq_zero] at h0
    simpa only [map_sum, map_mul, hCmk] using h0
  have hdC : wcQmbtCnD c' i = ∑ q, (algebraMap A' (wcQmbtChartNone A' n c') (c' i q) +
      algebraMap A' (wcQmbtChartNone A' n c') (c' q i)) *
        Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X q) := by
    simp only [wcQmbtCnD, map_sum, map_mul, map_add, hCmk]

  obtain ⟨g, hg⟩ : ∃ g, g = wcQmbtCnPoly π' c' i k0 eps e := ⟨_, rfl⟩
  obtain ⟨b, hb⟩ : ∃ b, b = wcQmbtCnMk A' n π' (MvPolynomial.X (e k0)) := ⟨_, rfl⟩
  obtain ⟨v, hv⟩ : ∃ v, v = Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X k0) +
      algebraMap A' (wcQmbtChartNone A' n c') eps := ⟨_, rfl⟩
  obtain ⟨hh, hhh⟩ : ∃ h, h = wcQmbtCnD c' i * v := ⟨_, rfl⟩
  rw [← hg, ← hb, ← hv, ← hhh]
  rw [← hg] at hDer
  have TL : ∀ {R : Type u} [CommRing R]
      (φ : MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π') →+* R)
      (P : Polynomial (wcQmbtSSRing A' (n - 2) π')),
      φ (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π')) P) =
        Polynomial.eval₂ (φ.comp MvPolynomial.C) (φ (MvPolynomial.X 0)) P := by
    intro R _ φ P
    rw [Polynomial.aeval_def, Polynomial.hom_eval₂, MvPolynomial.algebraMap_eq]
  have hEvG : ∀ {R : Type u} [CommRing R] (f : wcQmbtSSRing A' (n - 2) π' →+* R) (t : R),
      Polynomial.eval₂ f t g = ∑ p, ∑ q, f (algebraMap A' (wcQmbtSSRing A' (n - 2) π') (c' p q)) *
        Polynomial.eval₂ f t (wcQmbtCnHat π' i k0 eps e p) *
        Polynomial.eval₂ f t (wcQmbtCnHat π' i k0 eps e q) - 1 := by
    intro R _ f t
    rw [hg]
    unfold wcQmbtCnPoly
    simp only [Polynomial.eval₂_sub, Polynomial.eval₂_finsetSum, Polynomial.eval₂_mul,
      Polynomial.eval₂_C, Polynomial.eval₂_one]
  have hEvD : ∀ {R : Type u} [CommRing R] (f : wcQmbtSSRing A' (n - 2) π' →+* R) (t : R),
      Polynomial.eval₂ f t (Polynomial.derivative g) =
        ∑ q, (f (algebraMap A' (wcQmbtSSRing A' (n - 2) π') (c' i q)) +
          f (algebraMap A' (wcQmbtSSRing A' (n - 2) π') (c' q i))) *
          Polynomial.eval₂ f t (wcQmbtCnHat π' i k0 eps e q) := by
    intro R _ f t
    rw [hDer]
    simp only [Polynomial.eval₂_finsetSum, Polynomial.eval₂_mul, Polynomial.eval₂_add,
      Polynomial.eval₂_C]
  have hSmk : ∀ x : wcQmbtSSRing A' (n - 2) π',
      Ideal.Quotient.mk (wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b) (MvPolynomial.C x) =
        algebraMap (wcQmbtSSRing A' (n - 2) π')
          (MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π') ⧸
            wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b) x := by
    intro x
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  have hιA : ∀ a : A', algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh)
      (algebraMap A' (wcQmbtChartNone A' n c') a) = algebraMap A' (Localization.Away hh) a :=
    fun a => (IsScalarTower.algebraMap_apply A' _ _ a).symm
  have hU : IsUnit (algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh) hh) :=
    IsLocalization.Away.algebraMap_isUnit hh
  have hιh : algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh) hh =
      algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh) (wcQmbtCnD c' i) *
        algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh) v := by
    rw [← map_mul, ← hhh]
  have hV : IsUnit (algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh) v) := by
    have h := hU
    rw [hιh] at h
    exact isUnit_of_mul_isUnit_right h

  obtain ⟨z, hz⟩ : ∃ z : Fin (n - 2 + 2) → Localization.Away hh, ∀ j, z j =
      if j.val = 0 then algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh) v
      else if j.val = 1 then algebraMap A' (Localization.Away hh) π' * ↑hV.unit⁻¹
      else algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh)
        (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X (e.symm j))) :=
    ⟨_, fun j => rfl⟩
  have hz01 : z ⟨0, by omega⟩ * z ⟨1, by omega⟩ = algebraMap A' (Localization.Away hh) π' := by
    have e0 : (⟨0, by omega⟩ : Fin (n - 2 + 2)).val = 0 := rfl
    have e1 : (⟨1, by omega⟩ : Fin (n - 2 + 2)).val = 1 := rfl
    rw [hz, hz, if_pos e0, if_neg (by rw [e1]; exact one_ne_zero), if_pos e1, mul_left_comm,
      hV.mul_val_inv, mul_one]
  obtain ⟨χ, hχA, hχz⟩ : ∃ χ : wcQmbtSSRing A' (n - 2) π' →+* Localization.Away hh,
      χ.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π')) = algebraMap A' (Localization.Away hh) ∧
      ∀ j, χ (wcQmbtCnMk A' n π' (MvPolynomial.X j)) = z j := by
    refine ⟨Ideal.Quotient.lift (wcQuadModelIdeal A' (n - 2 + 2) π'
      (Matrix.of fun a b : Fin (n - 2 + 2) => if a.val = 0 ∧ b.val = 1 then (1 : A') else 0))
      (MvPolynomial.eval₂Hom (algebraMap A' (Localization.Away hh)) z) ?_, ?_, ?_⟩
    · intro a ha
      obtain ⟨x, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul]
      apply mul_eq_zero_of_right
      simp only [map_sub, map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X']
      rw [collapse, hz01, sub_self]
    · ext a
      rw [RingHom.comp_apply, ← hMmk, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
    · intro j
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
  have hχc : ∀ a : A', χ (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a) =
      algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh)
        (algebraMap A' (wcQmbtChartNone A' n c') a) :=
    fun a => (RingHom.congr_fun hχA a).trans (hιA a).symm
  have hne0 : ∀ p, p ≠ k0 → (e p).val ≠ 0 :=
    fun p hp h => hp (e.injective (Fin.ext (h.trans he0.symm)))
  have hne1 : ∀ p, p ≠ i → (e p).val ≠ 1 :=
    fun p hp h => hp (e.injective (Fin.ext (h.trans he1.symm)))
  have hχm : ∀ p, p ≠ i → χ (wcQmbtCnMk A' n π' (MvPolynomial.X (e p)) -
      if p = k0 then algebraMap A' (wcQmbtSSRing A' (n - 2) π') eps else 0) =
        algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh)
          (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X p)) := by
    intro p hp
    by_cases hpk : p = k0
    · rw [if_pos hpk, hpk, map_sub, hχz, hz, if_pos he0, hχc, hv, map_add, add_sub_cancel_right]
    · rw [if_neg hpk, sub_zero, hχz, hz, if_neg (hne0 p hpk), if_neg (hne1 p hp),
        e.symm_apply_apply]

  obtain ⟨Φ, hΦχ, hΦX0, hΦX1⟩ : ∃ Φ : MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π') ⧸
      wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b →+* Localization.Away hh,
      (∀ x, Φ (algebraMap (wcQmbtSSRing A' (n - 2) π') _ x) = χ x) ∧
      Φ (Ideal.Quotient.mk (wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b) (MvPolynomial.X 0)) =
        algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh)
          (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X i)) ∧
      Φ (Ideal.Quotient.mk (wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b) (MvPolynomial.X 1)) =
        ↑hU.unit⁻¹ := by
    have hw : ∀ p, Polynomial.eval₂ χ (algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh)
        (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X i)))
        (wcQmbtCnHat π' i k0 eps e p) =
          algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh)
            (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X p)) := by
      intro p
      rw [hHatE]
      by_cases hp : p = i
      · rw [if_pos hp, hp]
      · rw [if_neg hp]; exact hχm p hp
    have hιd : algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh) (wcQmbtCnD c' i) =
        ∑ q, (algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh)
          (algebraMap A' (wcQmbtChartNone A' n c') (c' i q)) +
          algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh)
            (algebraMap A' (wcQmbtChartNone A' n c') (c' q i))) *
          algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh)
            (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X q)) := by
      rw [hdC]
      simp only [map_sum, map_mul, map_add]
    obtain ⟨E, hEC, hE0, hE1⟩ : ∃ E : MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π') →+*
        Localization.Away hh, E.comp MvPolynomial.C = χ ∧
        E (MvPolynomial.X 0) = algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh)
          (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X i)) ∧
        E (MvPolynomial.X 1) = ↑hU.unit⁻¹ :=
      ⟨MvPolynomial.eval₂Hom χ ![algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh)
        (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X i)), ↑hU.unit⁻¹],
        MvPolynomial.eval₂Hom_comp_C _ _, MvPolynomial.eval₂Hom_X' _ _ _,
        MvPolynomial.eval₂Hom_X' _ _ _⟩
    have hECx : ∀ x, E (MvPolynomial.C x) = χ x := fun x => RingHom.congr_fun hEC x
    refine ⟨Ideal.Quotient.lift (wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b) E ?_,
      ?_, ?_, ?_⟩
    · intro a ha
      obtain ⟨x, x', rfl⟩ := Ideal.mem_span_pair.mp ha
      have h0 : E (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2)
          (wcQmbtSSRing A' (n - 2) π')) g) = 0 := by
        rw [TL, hEC, hE0, hEvG]
        simp only [hw, hχc]
        rw [sub_eq_zero, ← map_one (algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh)),
          ← hF]
        simp only [map_sum, map_mul]
      have h1 : E (MvPolynomial.X 1 * MvPolynomial.C b *
            Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π'))
              (Polynomial.derivative g) - 1) = 0 := by
        rw [map_sub, map_mul, map_mul, TL, hEC, hE0, hE1, hECx, hEvD, map_one]
        simp only [hw, hχc]
        rw [← hιd, hb, hχz, hz, if_pos he0, mul_assoc, mul_comm _ (algebraMap _ _ (wcQmbtCnD c' i)),
          ← hιh, hU.val_inv_mul, sub_self]
      rw [map_add, map_mul, map_mul, h0, h1, mul_zero, mul_zero, add_zero]
    · intro x
      rw [← hSmk, Ideal.Quotient.lift_mk, hECx]
    · rw [Ideal.Quotient.lift_mk, hE0]
    · rw [Ideal.Quotient.lift_mk, hE1]

  obtain ⟨ŵ, hŵ⟩ : ∃ ŵ : Fin n → MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π') ⧸
      wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b, ∀ p, ŵ p =
        if p = i then
          Ideal.Quotient.mk (wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b) (MvPolynomial.X 0)
        else algebraMap (wcQmbtSSRing A' (n - 2) π') _
          (wcQmbtCnMk A' n π' (MvPolynomial.X (e p)) -
            if p = k0 then algebraMap A' (wcQmbtSSRing A' (n - 2) π') eps else 0) :=
    ⟨_, fun p => rfl⟩
  have hŵE : ∀ p, Polynomial.eval₂
      ((Ideal.Quotient.mk (wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b)).comp MvPolynomial.C)
      (Ideal.Quotient.mk (wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b) (MvPolynomial.X 0))
      (wcQmbtCnHat π' i k0 eps e p) = ŵ p := by
    intro p
    rw [hHatE, hŵ, RingHom.comp_apply, hSmk]
  have hgS : ∑ p, ∑ q, algebraMap (wcQmbtSSRing A' (n - 2) π')
      (MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π') ⧸
        wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b)
      (algebraMap A' (wcQmbtSSRing A' (n - 2) π') (c' p q)) * ŵ p * ŵ q - 1 = 0 := by
    have h := (Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_insert _ _)) :
      Ideal.Quotient.mk (wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b)
        (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π'))
          g) = 0)
    rw [TL, hEvG] at h
    simpa only [hŵE, RingHom.comp_apply, hSmk] using h
  obtain ⟨Ψ₀, hΨ₀A, hΨ₀X⟩ : ∃ Ψ₀ : wcQmbtChartNone A' n c' →+*
      MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π') ⧸
        wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b,
      (∀ a, Ψ₀ (algebraMap A' (wcQmbtChartNone A' n c') a) =
        algebraMap (wcQmbtSSRing A' (n - 2) π') _ (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a)) ∧
      ∀ p, Ψ₀ (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X p)) = ŵ p := by
    refine ⟨Ideal.Quotient.lift (wcQmbtChartNoneIdeal A' n c')
      (MvPolynomial.eval₂Hom ((algebraMap (wcQmbtSSRing A' (n - 2) π')
        (MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π') ⧸
          wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b)).comp
        (algebraMap A' (wcQmbtSSRing A' (n - 2) π'))) ŵ) ?_, ?_, ?_⟩
    · intro a ha
      obtain ⟨x, rfl⟩ := Ideal.mem_span_singleton'.mp ha
      rw [map_mul]
      apply mul_eq_zero_of_right
      simp only [map_sub, map_sum, map_mul, MvPolynomial.eval₂Hom_C, MvPolynomial.eval₂Hom_X',
        map_one, RingHom.comp_apply]
      exact hgS
    · intro a
      rw [← hCmk, Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
    · intro p
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
  have hΨ₀d : Ψ₀ (wcQmbtCnD c' i) =
      Ideal.Quotient.mk (wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b)
        (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π'))
          (Polynomial.derivative g)) := by
    rw [hdC, TL, hEvD]
    simp only [map_sum, map_mul, map_add, hΨ₀A, hΨ₀X, hŵE, RingHom.comp_apply, hSmk]
  have hΨ₀v : Ψ₀ v = algebraMap (wcQmbtSSRing A' (n - 2) π') _ b := by
    rw [hv, map_add, hΨ₀X, hΨ₀A, hŵ, if_neg hik.symm, if_pos rfl, ← map_add, sub_add_cancel, hb]
  have hr1 : Ideal.Quotient.mk (wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b) (MvPolynomial.X 1) *
      algebraMap (wcQmbtSSRing A' (n - 2) π') _ b *
      Ideal.Quotient.mk (wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b)
        (Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π'))
          (Polynomial.derivative g)) = 1 := by
    have h := (Ideal.Quotient.eq_zero_iff_mem.mpr
      (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)) :
      Ideal.Quotient.mk (wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b)
        (MvPolynomial.X 1 * MvPolynomial.C b *
          Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π'))
            (Polynomial.derivative g) - 1) = 0)
    rw [map_sub, map_mul, map_mul, hSmk, map_one, sub_eq_zero] at h
    exact h
  have hΨ₀h : Ψ₀ hh *
      Ideal.Quotient.mk (wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b) (MvPolynomial.X 1) = 1 := by
    rw [hhh, map_mul, hΨ₀d, hΨ₀v]
    linear_combination hr1
  have hΨu : IsUnit (Ψ₀ hh) := IsUnit.of_mul_eq_one _ hΨ₀h
  obtain ⟨Ψ, hΨι⟩ : ∃ Ψ : Localization.Away hh →+*
      MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π') ⧸
        wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b,
      ∀ x, Ψ (algebraMap (wcQmbtChartNone A' n c') (Localization.Away hh) x) = Ψ₀ x :=
    ⟨IsLocalization.Away.lift hh hΨu, fun x => IsLocalization.Away.lift_eq hh hΨu x⟩
  have hΨA : ∀ a : A', Ψ (algebraMap A' (Localization.Away hh) a) =
      algebraMap (wcQmbtSSRing A' (n - 2) π') _ (algebraMap A' (wcQmbtSSRing A' (n - 2) π') a) := by
    intro a
    rw [← hιA, hΨι, hΨ₀A]

  have hΨvi : algebraMap (wcQmbtSSRing A' (n - 2) π') _ b * Ψ ↑hV.unit⁻¹ = 1 := by
    rw [← hΨ₀v, ← hΨι, ← map_mul, hV.mul_val_inv, map_one]
  have hstepA : ∀ x : wcQmbtSSRing A' (n - 2) π', Ψ (χ x) =
      algebraMap (wcQmbtSSRing A' (n - 2) π')
        (MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π') ⧸
          wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b) x := by
    intro x
    have key : Ψ.comp χ = algebraMap (wcQmbtSSRing A' (n - 2) π')
        (MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π') ⧸
          wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b) := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [RingHom.comp_apply]
        rw [hMmk, hχc, hΨι, hΨ₀A]
      · intro j
        simp only [RingHom.comp_apply]
        rw [hχz, hz]
        by_cases h0 : j.val = 0
        · have hj : j = e k0 := Fin.ext (h0.trans he0.symm)
          rw [if_pos h0, hΨι, hΨ₀v, hb, hj]
        · by_cases h1 : j.val = 1
          · have hj : j = ⟨1, by omega⟩ := Fin.ext h1
            have hk : e k0 = ⟨0, by omega⟩ := Fin.ext he0
            rw [if_neg h0, if_pos h1, map_mul, hΨA, ← hrel, map_mul, hj]
            have hb' : b = wcQmbtCnMk A' n π' (MvPolynomial.X ⟨0, by omega⟩) := by rw [hb, hk]
            have hb'' := congrArg (algebraMap (wcQmbtSSRing A' (n - 2) π')
              (MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π') ⧸
                wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b)) hb'
            rw [hb''] at hΨvi
            linear_combination (algebraMap (wcQmbtSSRing A' (n - 2) π')
              (MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π') ⧸
                wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b)
              (wcQmbtCnMk A' n π' (MvPolynomial.X ⟨1, by omega⟩))) * hΨvi
          · have hpi : e.symm j ≠ i := fun h => h1 (by rw [← e.apply_symm_apply j, h]; exact he1)
            have hpk : e.symm j ≠ k0 :=
              fun h => h0 (by rw [← e.apply_symm_apply j, h]; exact he0)
            rw [if_neg h0, if_neg h1, hΨι, hΨ₀X, hŵ, if_neg hpi, if_neg hpk, sub_zero,
              e.apply_symm_apply]
    exact RingHom.congr_fun key x
  have hleft : Ψ.comp Φ = RingHom.id _ := by
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro x
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hSmk, hΦχ, hstepA]
    · refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
      · simp only [RingHom.comp_apply, RingHom.id_apply]
        rw [hΦX0, hΨι, hΨ₀X, hŵ, if_pos rfl]
      · simp only [RingHom.comp_apply, RingHom.id_apply]
        have h1 : Ψ ↑hU.unit⁻¹ * Ψ₀ hh = 1 := by
          rw [← hΨι, ← map_mul, hU.val_inv_mul, map_one]
        rw [hΦX1]
        linear_combination
          (Ideal.Quotient.mk (wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') g b)
            (MvPolynomial.X 1)) * h1 - Ψ ↑hU.unit⁻¹ * hΨ₀h

  have hright : Φ.comp Ψ = RingHom.id _ := by
    apply IsLocalization.ringHom_ext (Submonoid.powers hh)
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hCmk, hΨι, hΨ₀A, hΦχ, hχc]
    · intro p
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΨι, hΨ₀X, hŵ]
      by_cases hp : p = i
      · rw [if_pos hp, hΦX0, hp]
      · rw [if_neg hp, hΦχ, hχm p hp]
  refine ⟨Φ, Function.bijective_iff_has_inverse.mpr
    ⟨Ψ, fun x => RingHom.congr_fun hleft x, fun x => RingHom.congr_fun hright x⟩, ?_⟩
  ext a
  simp only [RingHom.comp_apply]
  rw [hΦχ]
  exact RingHom.congr_fun hχA a

theorem wc_qmbt_bm_chart_coords_none {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] {π' : A'} (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {n : ℕ} (hn : 2 ≤ n) {c' : Matrix (Fin n) (Fin n) A'} (hc' : IsUnit (c' + c'.transpose).det)
    (𝔭 : PrimeSpectrum (wcQmbtChartNone A' n c')) :
    ∃ (h : wcQmbtChartNone A' n c') (ψ : wcQmbtSSRing A' (n - 2) π' →+* Localization.Away h),
      h ∉ 𝔭.asIdeal ∧
      ψ.comp (algebraMap A' (wcQmbtSSRing A' (n - 2) π')) = algebraMap A' (Localization.Away h) ∧
      ψ.Etale :=
by
  classical
  have hP : 𝔭.asIdeal.IsPrime := 𝔭.isPrime

  have hCmk : ∀ a : A', Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.C a) =
      algebraMap A' (wcQmbtChartNone A' n c') a := by
    intro a
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  obtain ⟨i, hi⟩ : ∃ i : Fin n, wcQmbtCnD c' i ∉ 𝔭.asIdeal := by
    by_contra hcon
    push_neg at hcon
    set f := algebraMap A' (wcQmbtChartNone A' n c') with hf
    set y : Fin n → wcQmbtChartNone A' n c' :=
      fun p => Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X p) with hy
    set N' := (c' + c'.transpose).map f with hN'
    have hd : ∀ j, wcQmbtCnD c' j = N'.mulVec y j := by
      intro j
      simp only [wcQmbtCnD, map_sum, map_mul, map_add, hCmk, Matrix.mulVec, dotProduct, hN',
        Matrix.map_apply, Matrix.add_apply, Matrix.transpose_apply, hy, hf]
    have hu : IsUnit N'.det := by
      rw [hN', ← RingHom.mapMatrix_apply, ← RingHom.map_det]
      exact hc'.map f
    have key : N'.det • y = N'.adjugate.mulVec (N'.mulVec y) := by
      rw [Matrix.mulVec_mulVec, Matrix.adjugate_mul]
      ext p
      simp [Matrix.mulVec, dotProduct, Matrix.one_apply]
    have hyp : ∀ p, y p ∈ 𝔭.asIdeal := by
      intro p
      have h1 : N'.det * y p ∈ 𝔭.asIdeal := by
        have := congrFun key p
        rw [Pi.smul_apply, smul_eq_mul] at this
        rw [this]
        have hmem : ∀ j, N'.mulVec y j ∈ 𝔭.asIdeal := fun j => (hd j) ▸ hcon j
        simp only [Matrix.mulVec, dotProduct] at hmem ⊢
        exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_left _ _ (hmem j))
      obtain ⟨u, hu'⟩ := hu
      have h2 : y p = ↑u⁻¹ * (N'.det * y p) := by
        rw [← hu', ← mul_assoc, Units.inv_mul, one_mul]
      rw [h2]
      exact Ideal.mul_mem_left _ _ h1
    have hF : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c')
        (∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q - 1) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
    rw [map_sub, map_one, sub_eq_zero] at hF
    have hQ : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c')
        (∑ p, ∑ q, MvPolynomial.C (c' p q) * MvPolynomial.X p * MvPolynomial.X q) ∈ 𝔭.asIdeal := by
      rw [map_sum]
      refine Ideal.sum_mem _ (fun p _ => ?_)
      rw [map_sum]
      refine Ideal.sum_mem _ (fun q _ => ?_)
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ (hyp q)
    rw [hF] at hQ
    exact hP.ne_top ((Ideal.eq_top_iff_one _).mpr hQ)

  have hN : n = n - 2 + 2 := by omega
  let e : Fin n ≃ Fin (n - 2 + 2) :=
    (finCongr hN).trans (Equiv.swap (Fin.cast hN i) ⟨1, by omega⟩)
  have he1 : (e i).val = 1 := by
    simp only [e, Equiv.trans_apply, finCongr_apply, Equiv.swap_apply_left]
  let k0 : Fin n := e.symm ⟨0, by omega⟩
  have he0 : (e k0).val = 0 := by
    simp only [k0, Equiv.apply_symm_apply]
  have hik : i ≠ k0 := by
    intro h
    rw [h] at he1
    omega

  let eps : A' := if Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X k0) ∈
    𝔭.asIdeal then 1 else 0
  have hv : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X k0) +
      algebraMap A' (wcQmbtChartNone A' n c') eps ∉ 𝔭.asIdeal := by
    by_cases hk : Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X k0) ∈ 𝔭.asIdeal
    · have heps : eps = 1 := if_pos hk
      rw [heps, map_one]
      intro hv
      apply hP.ne_top
      rw [Ideal.eq_top_iff_one]
      have := 𝔭.asIdeal.sub_mem hv hk
      simpa using this
    · have heps : eps = 0 := if_neg hk
      rw [heps, map_zero, add_zero]
      exact hk
  have hh : wcQmbtCnD c' i * (Ideal.Quotient.mk (wcQmbtChartNoneIdeal A' n c') (MvPolynomial.X k0) +
      algebraMap A' (wcQmbtChartNone A' n c') eps) ∉ 𝔭.asIdeal := by
    intro hm
    rcases hP.mul_mem_iff_mem_or_mem.mp hm with h1 | h1
    · exact hi h1
    · exact hv h1
  obtain ⟨Φ, hΦb, hΦc⟩ := wc_qmbt_cn_chart_iso π' c' i k0 hik eps e he0 he1
  refine ⟨_, Φ.comp (algebraMap _ _), hh, hΦc, ?_⟩
  have h1 : (algebraMap (wcQmbtSSRing A' (n - 2) π') (MvPolynomial (Fin 2) (wcQmbtSSRing A' (n - 2) π') ⧸
        wcQmbtCnPres (wcQmbtSSRing A' (n - 2) π') (wcQmbtCnPoly π' c' i k0 eps e)
          (wcQmbtCnMk A' n π' (MvPolynomial.X (e k0))))).Etale :=
    RingHom.etale_algebraMap.mpr (wc_qmbt_cn_etale_pres _ _ _)
  have h2 : Φ.Etale := RingHom.Etale.of_bijective hΦb
  exact RingHom.Etale.stableUnderComposition _ _ h1 h2

theorem wc_qmbt_bm_origin_point {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] [IsSepClosed (IsLocalRing.ResidueField A')] {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'}) {n : ℕ} (hn : 2 ≤ n)
    {c' : Matrix (Fin n) (Fin n) A'} (hc' : IsUnit (c' + c'.transpose).det) :
    ∃ (j : Fin n) (𝔭 : PrimeSpectrum (wcQmbtChart A' n π' c' j)),
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X none) ∈ 𝔭.asIdeal ∧
      Ideal.Quotient.mk (wcQmbtChartIdeal A' n π' c' j) (MvPolynomial.X (some j)) ∈ 𝔭.asIdeal :=
by
  classical

  have hroot : ∀ α β γ : IsLocalRing.ResidueField A', α ≠ 0 →
      ((2 : IsLocalRing.ResidueField A') ≠ 0 ∨ β ≠ 0) →
      ∃ t : IsLocalRing.ResidueField A', α * (t * t) + β * t + γ = 0 := by
    intro α β γ hα h
    by_cases h2 : (2 : IsLocalRing.ResidueField A') = 0
    · have hβ : β ≠ 0 := h.resolve_left (not_not.mpr h2)
      set p : Polynomial (IsLocalRing.ResidueField A') :=
        Polynomial.C α * Polynomial.X ^ 2 + Polynomial.C β * Polynomial.X + Polynomial.C γ
        with hp
      have hdeg : p.degree ≠ 0 := by
        rw [hp, Polynomial.degree_quadratic hα]; decide
      have hder : Polynomial.derivative p = Polynomial.C β := by
        rw [hp]
        simp only [Polynomial.derivative_add, Polynomial.derivative_C_mul_X_pow,
          Polynomial.derivative_C_mul_X, Polynomial.derivative_C]
        have : (α * ((2 : ℕ) : IsLocalRing.ResidueField A')) = 0 := by
          rw [Nat.cast_ofNat, h2, mul_zero]
        rw [this, Polynomial.C_0, zero_mul, zero_add, add_zero]
      have hsep : p.Separable := by
        rw [Polynomial.separable_def, hder]
        exact ⟨0, Polynomial.C β⁻¹, by
          rw [zero_mul, zero_add, ← Polynomial.C_mul, inv_mul_cancel₀ hβ, Polynomial.C_1]⟩
      obtain ⟨t, ht⟩ := IsSepClosed.exists_root p hdeg hsep
      refine ⟨t, ?_⟩
      have ht' : Polynomial.eval t p = 0 := ht
      simp only [hp, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
        Polynomial.eval_pow, Polynomial.eval_X] at ht'
      linear_combination ht'
    · haveI : NeZero ((2 : ℕ) : IsLocalRing.ResidueField A') := ⟨by rw [Nat.cast_ofNat]; exact h2⟩
      haveI : NeZero (2 : IsLocalRing.ResidueField A') := ⟨h2⟩
      obtain ⟨z, hz⟩ := IsSepClosed.exists_pow_nat_eq (discrim α β γ) 2
      exact exists_quadratic_eq_zero hα ⟨z, by rw [← hz, sq]⟩

  have s2 : ∀ (c : Matrix (Fin n) (Fin n) (IsLocalRing.ResidueField A')),
      (c + c.transpose).det ≠ 0 → ∃ (j : Fin n) (v : Fin n → IsLocalRing.ResidueField A'),
        v j = 1 ∧ ∑ p, ∑ q, c p q * v p * v q = 0 := by
    intro c hc
    by_cases hA : ∃ a, c a a = 0
    · obtain ⟨a, ha⟩ := hA
      refine ⟨a, fun p => if p = a then 1 else 0, by simp, ?_⟩
      simp [ha]
    · push_neg at hA
      set a : Fin n := ⟨0, by omega⟩ with ha_def
      obtain ⟨b, hba, hD⟩ : ∃ b, b ≠ a ∧
          ((2 : IsLocalRing.ResidueField A') ≠ 0 ∨ (c + c.transpose) a b ≠ 0) := by
        by_cases h2 : (2 : IsLocalRing.ResidueField A') = 0
        · by_contra hcon
          push_neg at hcon
          apply hc
          apply Matrix.det_eq_zero_of_row_eq_zero a
          intro b
          by_cases hb : b = a
          · rw [hb, Matrix.add_apply, Matrix.transpose_apply, ← two_mul, h2, zero_mul]
          · exact (hcon b hb).2
        · refine ⟨⟨1, by omega⟩, ?_, Or.inl h2⟩
          intro h
          rw [ha_def, Fin.ext_iff] at h
          simp at h
      obtain ⟨t, ht⟩ := hroot (c a a) ((c + c.transpose) a b) (c b b) (hA a) hD
      refine ⟨b, fun p => if p = a then t else if p = b then 1 else 0, by simp [hba], ?_⟩
      rw [Fintype.sum_eq_add a b hba.symm (fun p hp => by simp [hp.1, hp.2])]
      rw [Fintype.sum_eq_add a b hba.symm (fun q hq => by simp [hq.1, hq.2]),
        Fintype.sum_eq_add a b hba.symm (fun q hq => by simp [hq.1, hq.2])]
      simp only [↓reduceIte, hba]
      rw [Matrix.add_apply, Matrix.transpose_apply] at ht
      linear_combination ht

  have hdet : ((c'.map (IsLocalRing.residue A')) +
      (c'.map (IsLocalRing.residue A')).transpose).det ≠ 0 := by
    have h1 : c'.map (IsLocalRing.residue A') + (c'.map (IsLocalRing.residue A')).transpose =
        (c' + c'.transpose).map (IsLocalRing.residue A') := by
      ext i j
      simp [Matrix.map_apply, Matrix.transpose_apply]
    rw [h1, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact (hc'.map _).ne_zero
  obtain ⟨j, v, hvj, hQ⟩ := s2 _ hdet

  let g : Option (Fin n) → IsLocalRing.ResidueField A' :=
    fun i => Option.elim i 0 (fun p => if p = j then 0 else v p)
  let ev := MvPolynomial.eval₂Hom (IsLocalRing.residue A') g
  have hhat : ∀ p, ev (wcQmbtChartHat j p) = v p := by
    intro p
    by_cases hp : p = j
    · subst hp
      simp [wcQmbtChartHat, hvj]
    · simp [wcQmbtChartHat, hp, ev, g]
  have hπres : IsLocalRing.residue A' π' = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff, hπ']
    exact Ideal.mem_span_singleton_self π'
  have hle : wcQmbtChartIdeal A' n π' c' j ≤ RingHom.ker ev := by
    rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    refine ⟨?_, ?_⟩
    · rw [SetLike.mem_coe, RingHom.mem_ker]
      simp [ev, g, hπres]
    · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_sum]
      simp_rw [map_sum, map_mul, hhat]
      simp only [ev, MvPolynomial.eval₂Hom_C, map_pow, MvPolynomial.eval₂Hom_X', g,
        Option.elim_none]
      simpa [Matrix.map_apply] using hQ
  let L := Ideal.Quotient.lift (wcQmbtChartIdeal A' n π' c' j) ev
    (fun a ha => (RingHom.mem_ker).mp (hle ha))
  refine ⟨j, ⟨RingHom.ker L, RingHom.ker_isPrime L⟩, ?_, ?_⟩
  · show L (Ideal.Quotient.mk _ (MvPolynomial.X none)) = 0
    rw [Ideal.Quotient.lift_mk]
    simp [ev, g]
  · show L (Ideal.Quotient.mk _ (MvPolynomial.X (some j))) = 0
    rw [Ideal.Quotient.lift_mk]
    simp [ev, g]

theorem wc_qmbt_bm_origin_maximal {A : Type u} [CommRing A] [IsLocalRing A] {π : A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (n : ℕ) (c : Matrix (Fin n) (Fin n) A) :
    (Ideal.span (Set.range fun p : Fin n =>
      Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p))).IsMaximal :=
by
  classical
  set I := wcQuadModelIdeal A n π c with hI
  set Q : MvPolynomial (Fin n) A :=
    ∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q with hQ
  have hIdef : I = Ideal.span {Q - MvPolynomial.C π} := rfl
  have hπm : π ∈ IsLocalRing.maximalIdeal A := by
    rw [hπ]; exact Ideal.mem_span_singleton_self π
  have hres : IsLocalRing.residue A π = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff]; exact hπm
  let ε : MvPolynomial (Fin n) A →+* IsLocalRing.ResidueField A :=
    (IsLocalRing.residue A).comp MvPolynomial.constantCoeff
  have hccQ : MvPolynomial.constantCoeff Q = 0 := by
    rw [hQ]; simp
  have hεI : ∀ a ∈ I, ε a = 0 := by
    intro a ha
    rw [hIdef, Ideal.mem_span_singleton'] at ha
    obtain ⟨b, rfl⟩ := ha
    rw [map_mul]
    show ε b * IsLocalRing.residue A (MvPolynomial.constantCoeff (Q - MvPolynomial.C π)) = 0
    rw [map_sub, hccQ, MvPolynomial.constantCoeff_C, zero_sub, map_neg, hres, neg_zero, mul_zero]
  let εb : MvPolynomial (Fin n) A ⧸ I →+* IsLocalRing.ResidueField A :=
    Ideal.Quotient.lift I ε hεI
  have hεb : ∀ f, εb (Ideal.Quotient.mk I f) =
      IsLocalRing.residue A (MvPolynomial.constantCoeff f) :=
    fun f => Ideal.Quotient.lift_mk _ _ _
  have hsurj : Function.Surjective εb := by
    intro y
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
    exact ⟨Ideal.Quotient.mk I (MvPolynomial.C a), by rw [hεb, MvPolynomial.constantCoeff_C]⟩
  have hmax : (RingHom.ker εb).IsMaximal := RingHom.ker_isMaximal_of_surjective εb hsurj
  set J := Ideal.span (Set.range fun p : Fin n => Ideal.Quotient.mk I (MvPolynomial.X p)) with hJ
  have hXJ : ∀ p, Ideal.Quotient.mk I (MvPolynomial.X p) ∈ J :=
    fun p => Ideal.subset_span ⟨p, rfl⟩
  have h1 : J ≤ RingHom.ker εb := by
    rw [hJ, Ideal.span_le]
    rintro _ ⟨p, rfl⟩
    show εb (Ideal.Quotient.mk I (MvPolynomial.X p)) = 0
    rw [hεb, MvPolynomial.constantCoeff_X, map_zero]
  have hdec : ∀ f : MvPolynomial (Fin n) A,
      Ideal.Quotient.mk I f -
        Ideal.Quotient.mk I (MvPolynomial.C (MvPolynomial.constantCoeff f)) ∈ J := by
    intro f
    induction f using MvPolynomial.induction_on
    next a =>
      rw [MvPolynomial.constantCoeff_C, sub_self]
      exact J.zero_mem
    next p q hp hq =>
      have := J.add_mem hp hq
      simp only [map_add]
      convert this using 1
      ring
    next p i _ =>
      simp only [map_mul, MvPolynomial.constantCoeff_X, mul_zero, MvPolynomial.C_0, map_zero,
        sub_zero]
      exact J.mul_mem_left _ (hXJ i)
  have hπJ : Ideal.Quotient.mk I (MvPolynomial.C π) ∈ J := by
    have e : Ideal.Quotient.mk I (MvPolynomial.C π) = Ideal.Quotient.mk I Q := by
      rw [Ideal.Quotient.eq]
      have hmem : Q - MvPolynomial.C π ∈ I := by
        rw [hIdef]; exact Ideal.mem_span_singleton_self _
      rw [← neg_sub]
      exact neg_mem hmem
    have := hdec Q
    rw [hccQ, MvPolynomial.C_0, map_zero, sub_zero] at this
    rw [e]; exact this
  have h2 : RingHom.ker εb ≤ J := by
    intro r hr
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective r
    rw [RingHom.mem_ker, hεb, IsLocalRing.residue_eq_zero_iff, hπ,
      Ideal.mem_span_singleton'] at hr
    obtain ⟨a, ha⟩ := hr
    have hC : Ideal.Quotient.mk I (MvPolynomial.C (MvPolynomial.constantCoeff f)) ∈ J := by
      rw [← ha, MvPolynomial.C_mul, map_mul]
      exact J.mul_mem_left _ hπJ
    have := J.add_mem (hdec f) hC
    rwa [sub_add_cancel] at this
  rw [le_antisymm h1 h2]
  exact hmax

theorem wc_qmbt_blowup_model {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π') :
    ∃ (Xm : Scheme.{u}) (f : Xm ⟶ Spec (.of A'))
      (bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))),
    wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range (fun i : Option (Fin n) =>
      Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl ∧
    bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) = f ∧
    QuasiCompact f ∧ QuasiSeparated f ∧
    (∀ x : Xm, ∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))),
      x ∈ U ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f) ∧
    (∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))))
      (y : U.toScheme),
      WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f ∧
      Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g y) ∧
      Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g y)) :=
by
  classical
  have hn2 : 2 ≤ n := by omega

  obtain ⟨θ, hθX, hθA, sq₁⟩ := wc_qmbt_bm_quad_pullback ιA n π c π' hπ'2
  obtain ⟨gP, hgP1, hgP2⟩ : ∃ gP : Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ⟶
        Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))),
      gP ≫ Spec.map (CommRingCat.ofHom θ) = Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ≫ a₀ ∧
      gP ≫ Spec.map (CommRingCat.ofHom
          (algebraMap A' (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) =
        Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) :=
    ⟨sq₁.lift _ _ (by rw [Category.assoc]; exact Limits.pullback.condition),
      sq₁.lift_fst _ _ _, sq₁.lift_snd _ _ _⟩
  have sqL : IsPullback (Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) gP a₀ (Spec.map (CommRingCat.ofHom θ)) := by
    refine IsPullback.of_bot ?_ hgP1.symm sq₁
    rw [hgP2]
    exact IsPullback.of_hasPullback _ _
  haveI ha₀ : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  haveI hgPw : WeaklyEtale gP := MorphismProperty.of_isPullback (P := @WeaklyEtale) sqL ha₀

  haveI : IsNoetherian (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))) :=
    inferInstance
  obtain ⟨X₁, r₁, hb₁, hX₁⟩ := wc_csd_blowup_exists_noeth
    (Spec (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA))))
    (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range fun k =>
      (Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))).inv.hom
        (wcQmbtGen A' n π' (c.map ιA) k))))
  haveI := hX₁
  haveI hfst : WeaklyEtale (Limits.pullback.fst r₁ gP) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) (IsPullback.of_hasPullback r₁ gP).flip hgPw

  haveI hgPflat : Flat gP := hgPw.flat
  haveI hPaff : IsAffine (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) := by
    dsimp only [wcQuadModelStr]
    infer_instance
  have hbl := wc_qmbt_bm_flat_base_change
    (R := CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))
    (wcQmbtGen A' n π' (c.map ιA)) r₁ gP hb₁

  have hc' : IsUnit (c.map ιA + (c.map ιA).transpose).det := by
    have h1 : c.map ιA + (c.map ιA).transpose = (c + c.transpose).map ιA := by
      ext i j
      simp [Matrix.map_apply, Matrix.transpose_apply]
    rw [h1, ← RingHom.mapMatrix_apply, ← RingHom.map_det]
    exact hc.map ιA
  choose φs hφs using fun j => wc_qmbt_bm_chart_algebra hπ' (c.map ιA) j
  obtain ⟨φ0, hφ0⟩ := wc_qmbt_bm_chart_algebra_none hπ' (c.map ιA)
  let Φ : ∀ k, CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) ⟶
      wcQmbtCharts A' n π' (c.map ιA) k := fun k =>
    Option.rec (motive := fun k => CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)) ⟶
      wcQmbtCharts A' n π' (c.map ιA) k) (CommRingCat.ofHom φ0)
      (fun j => CommRingCat.ofHom (φs j)) k
  obtain ⟨e, he_open, he_comp, he_cover⟩ := wc_qmbt_bm_blowup_charts
    (R := CommRingCat.of (wcQuadModelRing A' n (π' ^ 2) (c.map ιA)))
