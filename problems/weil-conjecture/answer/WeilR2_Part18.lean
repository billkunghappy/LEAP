  intro A _ _ _ _ _ ℓ _ hℓ π hπ r R _ _ _ ρ hWE h0 h1 L _ _ φA hφA k
  have t_s3 : ∀ (A : Type u) [CommRing A] [IsDomain A] (π : A), π ≠ 0 →
      ∀ (N : ℕ), 0 < N →
      IsDomain (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) →
      ∀ (L : Type u) [Field L] [IsSepClosed L] (φA : A →+* L), Function.Injective φA →
      ((N : ℕ) : L) ≠ 0 →
      ∃ φ' : AdjoinRoot (Polynomial.X ^ N - Polynomial.C π) →+* L,
        φ'.comp (AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C π)) = φA ∧ Function.Injective φ' ∧
        φ' (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π)) ≠ 0 := by
    intro A _ _ π hπ0 N hN hdom L _ _ φA hφA hNL
    have ha : φA π ≠ 0 := by
      intro h; apply hπ0; apply hφA; rw [h, map_zero]
    have hsep : (Polynomial.X ^ N - Polynomial.C (φA π)).Separable :=
      Polynomial.separable_X_pow_sub_C (φA π) hNL ha
    have hdeg : (Polynomial.X ^ N - Polynomial.C (φA π)).degree ≠ 0 := by
