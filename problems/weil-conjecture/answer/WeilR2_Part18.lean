    exact (hcb _ _ _).symm.trans (h0.trans (hcb _ _ _))
  have e3 : F (φ0.base.hom ⟨x', hx'⟩) = (f (κ.base.hom x')).down :=
    (hFdef _).trans (congrArg (fun t => (f t).down) e1)
  have e4 : F ⟨x', hx'⟩ = (f x').down := hFdef _
  rw [e3, e4] at hest
  exact hest

theorem wc_qmtx1u_mahler_operator {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (Dπ : wcHMPullData T.πi ℓ) (hDπ : wcHMPullCanonical Dπ)
    (γN : wcSuppObj Dπ ⟶ wcSuppObj Dπ) (hγs : wcQmtmGammaSec T Dπ γN) (s : ℤ_[ℓ]) :
    ∃ (γs : T.XEi ⟶ T.XEi)
      (Rs : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
        AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))
      (Γ H : wcSuppObj Dπ ⟶ wcSuppObj Dπ),
      γs ≫ T.πi = T.πi ∧
      (∀ (a : ℤ) (k : ℕ) (c : L),
        Rs (AddMonoidAlgebra.single
            (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c) =
          AddMonoidAlgebra.single
            (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))
            (T.ζ k ^ (a * ((PadicInt.toZModPow k s).val : ℤ)) * c)) ∧
      γs ≫ T.gi = T.gi ≫ Spec.map (CommRingCat.ofHom Rs) ∧
      (∀ (V : XE.ProEt) (f : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]))
        (κ : Limits.pullback V.hom T.πi ⟶ Limits.pullback V.hom T.πi),
        κ ≫ Limits.pullback.fst V.hom T.πi = Limits.pullback.fst V.hom T.πi →
        κ ≫ Limits.pullback.snd V.hom T.πi = Limits.pullback.snd V.hom T.πi ≫ γs →
        ((Γ.val.app (Opposite.op V)).hom f :
          C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])) = f.comp κ.base.hom) ∧
      (γN - 𝟙 _) ≫ H = Γ - 𝟙 _ ∧
      wcQmtmUnit Dπ ≫ H = wcHMConst XE ℓ (s : ℚ_[ℓ]) ≫ wcQmtmUnit Dπ :=
by
  classical
  haveI := Dπ.cont

  obtain ⟨R, hR, hRadd, hR1, hR0, hRι⟩ := wc_qmtx1u_transl_ring T

  have hγw : ∀ y, T.πi ≫ T.g₀ = (T.gi ≫ Spec.map (CommRingCat.ofHom (R y))) ≫
      Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)) := by
    intro y
    rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hRι y]
    exact T.hT.w
  obtain ⟨γ, hγπ, hγg⟩ : ∃ γ : ℤ_[ℓ] → (T.XEi ⟶ T.XEi), (∀ y, γ y ≫ T.πi = T.πi) ∧
      ∀ y, γ y ≫ T.gi = T.gi ≫ Spec.map (CommRingCat.ofHom (R y)) :=
    ⟨fun y => T.hT.lift T.πi (T.gi ≫ Spec.map (CommRingCat.ofHom (R y))) (hγw y),
      fun y => T.hT.lift_fst _ _ _, fun y => T.hT.lift_snd _ _ _⟩
  have hγadd : ∀ y y', γ y ≫ γ y' = γ (y + y') := by
    intro y y'
    apply T.hT.hom_ext
    · rw [Category.assoc, hγπ y', hγπ y, hγπ (y + y')]
    · rw [Category.assoc, hγg y', ← Category.assoc, hγg y, hγg (y + y'), Category.assoc,
        ← Spec.map_comp, ← CommRingCat.ofHom_comp, hRadd]
  have hγ0 : γ 0 = 𝟙 _ := by
    apply T.hT.hom_ext
    · rw [hγπ, Category.id_comp]
    · rw [hγg, hR0, CommRingCat.ofHom_id, Spec.map_id, Category.comp_id, Category.id_comp]
  have hγ1 : γ 1 = T.γi := by
    apply T.hT.hom_ext
    · rw [hγπ, T.hγπ]
    · rw [hγg, hR1, T.hγg]

  have hcb : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : ↥X),
      (f ≫ g).base.hom x = g.base.hom (f.base.hom x) := by
    intro X Y Z f g x; rw [Scheme.Hom.comp_base]; rfl
  have hcompb : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (r : C(↥Z, ULift.{u+1} ℚ_[ℓ])),
      (r.comp g.base.hom).comp f.base.hom = r.comp (f ≫ g).base.hom := by
    intro X Y Z f g r; rw [Scheme.Hom.comp_base]; rfl
  have hpre : ∀ {P Q Q' R : Scheme.{u}} (a : P ⟶ Q) (b : Q ⟶ R) (c : P ⟶ Q') (d : Q' ⟶ R)
      (s : C(↥R, ULift.{u+1} ℚ_[ℓ])), a ≫ b = c ≫ d →
      (s.comp b.base.hom).comp a.base.hom = (s.comp d.base.hom).comp c.base.hom := by
    intro P Q Q' R a b c d s h
    rw [hcompb, hcompb, h]
  have hρ : ∀ {V₁ V₂ : XE.ProEt} (g : V₁ ⟶ V₂),
      ((wcProEtBC T.πi).map g).left ≫ Limits.pullback.fst V₂.hom T.πi =
        Limits.pullback.fst V₁.hom T.πi ≫ g.left ∧
      ((wcProEtBC T.πi).map g).left ≫ Limits.pullback.snd V₂.hom T.πi =
        Limits.pullback.snd V₁.hom T.πi :=
    fun g => ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have ext_sec : ∀ {M N : SheafOfModules.{u+1} (wcRingSheaf XE ℓ)} {f g : M ⟶ N},
      (∀ (V : XE.ProEt) (m : M.val.obj (Opposite.op V)),
        (f.val.app (Opposite.op V)).hom m = (g.val.app (Opposite.op V)).hom m) → f = g := by
    intro M N f g h
    apply SheafOfModules.hom_ext; apply PresheafOfModules.hom_ext; intro X
    apply ModuleCat.hom_ext; apply LinearMap.ext; intro m; exact h X.unop m

  have hκex : ∀ (V : XE.ProEt) (y : ℤ_[ℓ]),
      ∃ κ : Limits.pullback V.hom T.πi ⟶ Limits.pullback V.hom T.πi,
      κ ≫ Limits.pullback.fst V.hom T.πi = Limits.pullback.fst V.hom T.πi ∧
      κ ≫ Limits.pullback.snd V.hom T.πi = Limits.pullback.snd V.hom T.πi ≫ γ y := fun V y =>
    ⟨Limits.pullback.lift (Limits.pullback.fst V.hom T.πi) (Limits.pullback.snd V.hom T.πi ≫ γ y)
      (by rw [Category.assoc, hγπ, Limits.pullback.condition]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  choose κ hκ1 hκ2 using hκex
  have hκuniq : ∀ (V : XE.ProEt) (y : ℤ_[ℓ])
      (κ' : Limits.pullback V.hom T.πi ⟶ Limits.pullback V.hom T.πi),
      κ' ≫ Limits.pullback.fst V.hom T.πi = Limits.pullback.fst V.hom T.πi →
      κ' ≫ Limits.pullback.snd V.hom T.πi = Limits.pullback.snd V.hom T.πi ≫ γ y →
      κ' = κ V y := fun V y κ' h1 h2 =>
    Limits.pullback.hom_ext (h1.trans (hκ1 V y).symm) (h2.trans (hκ2 V y).symm)
  have hκadd : ∀ (V : XE.ProEt) (y y' : ℤ_[ℓ]), κ V y ≫ κ V y' = κ V (y + y') := by
    intro V y y'
    apply hκuniq
    · rw [Category.assoc, hκ1, hκ1]
    · rw [Category.assoc, hκ2, ← Category.assoc, hκ2, Category.assoc, hγadd]
  have hκ0 : ∀ V : XE.ProEt, κ V 0 = 𝟙 _ := fun V =>
    (hκuniq V 0 (𝟙 _) (Category.id_comp _) (by rw [Category.id_comp, hγ0, Category.comp_id])).symm
  have hκ1' : ∀ V : XE.ProEt,
      κ V 1 ≫ Limits.pullback.snd V.hom T.πi = Limits.pullback.snd V.hom T.πi ≫ T.γi :=
    fun V => (hκ2 V 1).trans (by rw [hγ1])
  have hnat' : ∀ {V₁ V₂ : XE.ProEt} (gl : V₁.left ⟶ V₂.left)
      (ρ : Limits.pullback V₁.hom T.πi ⟶ Limits.pullback V₂.hom T.πi) (y : ℤ_[ℓ]),
      ρ ≫ Limits.pullback.fst V₂.hom T.πi = Limits.pullback.fst V₁.hom T.πi ≫ gl →
      ρ ≫ Limits.pullback.snd V₂.hom T.πi = Limits.pullback.snd V₁.hom T.πi →
      κ V₁ y ≫ ρ = ρ ≫ κ V₂ y := by
    intro V₁ V₂ gl ρ y h1 h2
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, h1, hκ1, ← Category.assoc, hκ1, h1]
    · rw [Category.assoc, Category.assoc, h2, hκ2, hκ2, ← Category.assoc, h2]
  have hnat : ∀ {V₁ V₂ : XE.ProEt} (g : V₁ ⟶ V₂) (y : ℤ_[ℓ]),
      κ V₁ y ≫ ((wcProEtBC T.πi).map g).left = ((wcProEtBC T.πi).map g).left ≫ κ V₂ y :=
    fun g y => hnat' g.left _ y (hρ g).1 (hρ g).2

  have happΓ : ∀ V : XE.ProEt, ∃ F : (wcSuppObj Dπ).val.obj (Opposite.op V) ⟶
      (wcSuppObj Dπ).val.obj (Opposite.op V),
      ∀ f : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]),
        (F.hom f : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])) =
          f.comp (κ V s).base.hom := by
    intro V
    refine ⟨ModuleCat.ofHom (X := ↑((wcSuppObj Dπ).val.obj (Opposite.op V)))
      (Y := ↑((wcSuppObj Dπ).val.obj (Opposite.op V)))
      { toFun := fun f => (show C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) from f).comp
          (κ V s).base.hom
        map_add' := fun f g => ContinuousMap.add_comp _ _ _
        map_smul' := fun r f => ?_ }, fun f => rfl⟩
    change C(↥V.left, ULift.{u+1} ℚ_[ℓ]) at r
    change C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) at f
    change (@HMul.hMul C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])
        C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])
        C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) _
        ((Dπ.φ.hom.app (Opposite.op V)).hom r) f).comp (κ V s).base.hom =
      @HMul.hMul C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])
        C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])
        C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) _
        ((Dπ.φ.hom.app (Opposite.op V)).hom r) (f.comp (κ V s).base.hom)
    refine (ContinuousMap.mul_comp _ _ _).trans ?_
    have H : ContinuousMap.comp ((Dπ.φ.hom.app (Opposite.op V)).hom r :
          C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])) (κ V s).base.hom =
