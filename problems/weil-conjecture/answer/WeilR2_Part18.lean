          x.comp (Abelian.Ext.mk₀ (inv (wcSliceUnit S' ℓ W))) (add_zero q)) := by
      refine Function.bijective_iff_has_inverse.mpr
        ⟨fun z => z.comp (Abelian.Ext.mk₀ (wcSliceUnit S' ℓ W)) (add_zero q), fun x => ?_,
