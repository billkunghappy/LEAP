      ∀ (DO : wcHMPullData jO ℓ), wcHMPullCanonical DO →
      Epi (DO.Φ.map (γM - 𝟙 M)) ∧ ∃ h : DO.Φ.obj M ⟶ DO.Φ.obj M,
        DO.Φ.map (wM - 𝟙 M) = DO.Φ.map (γM - 𝟙 M) ≫ h ∧
        DO.Φ.map ιM ≫ h = DO.Φ.map (wcHMConst Xs ℓ t₁ ≫ ιM)) →
    (∀ (O : Scheme.{u}) (jO : O ⟶ Xs)
      (kO : O ⟶ Spec (.of (Localization.Away ((Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))))))),
      IsPullback jO kO ι (Spec.map (CommRingCat.ofHom (algebraMap B
        (Localization.Away ((Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))))))))) →
      ∀ (DO : wcHMPullData jO ℓ), wcHMPullCanonical DO →
