      (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
        (inferInstance : Pr.IsStableUnderBaseChangeAlong g₂)) (@WeaklyEtale : MorphismProperty Scheme.{u})
    letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) g₁ :=
      ⟨fun _ _ => inferInstance⟩
    letI : MorphismProperty.IsStableUnderBaseChangeAlong
        (@WeaklyEtale : MorphismProperty Scheme.{u}) g₁ :=
      (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
        (inferInstance : Pr.IsStableUnderBaseChangeAlong g₁)) (@WeaklyEtale : MorphismProperty Scheme.{u})
    have key : ∀ V : Z₀.ProEt,
        (α₀.app V).left ≫
          Limits.pullback.fst (Limits.pullback.snd V.hom g₂) g₁ ≫ Limits.pullback.fst V.hom g₂ =
            Limits.pullback.fst V.hom g₁₂ := by
      intro V
      have hα := MorphismProperty.Over.pullbackComp_hom_app_left
        (P := (@WeaklyEtale : MorphismProperty Scheme.{u})) (Q := ⊤) g₁ g₂ g₁₂ h V
      first
        | (erw [hα, Category.assoc, Limits.pullbackLeftPullbackSndIso_inv_fst]
           exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _))
        | (dsimp only [α₀]; erw [hα, Category.assoc, Limits.pullbackLeftPullbackSndIso_inv_fst]
