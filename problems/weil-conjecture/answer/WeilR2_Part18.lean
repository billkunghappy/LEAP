theorem wc_qmtm_unit_fix {S S' : Scheme.{u}} {f : S' ⟶ S} {w : S' ⟶ S'} {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] (hcomp : w ≫ f = f) (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
    (Dw : wcHMPullData w ℓ) (hDw : wcHMPullCanonical Dw) (hφ : wcQmtmHPhi hcomp Df Dw) :
    wcQmtmUnit Df ≫ (wcQmtmPush Df).map (wcQmtmUnit Dw) ≫
      (wcQmtmGamma hcomp Df Dw hφ).app (SheafOfModules.unit (wcRingSheaf S' ℓ)) =
      wcQmtmUnit Df :=
by
  haveI := Df.cont
  haveI := Dw.cont
  apply ((wcQmtmPush Df).obj (SheafOfModules.unit (wcRingSheaf S' ℓ))).unitHomEquiv.injective
  apply PresheafOfModules.sections_ext
  intro X
  rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
  simp only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.comp_apply,
    wcQmtmGamma, NatTrans.comp_app, SheafOfModules.unitToPushforwardObjUnit_val_app_apply,
    map_one, SheafOfModules.pushforward_map_val, PresheafOfModules.pushforward_map_app_apply,
    SheafOfModules.pushforwardComp_hom_app_val_app, SheafOfModules.pushforwardNatTrans_app_val_app,
    SheafOfModules.pushforwardCongr_hom_app_val_app, SheafOfModules.unit_val,
    PresheafOfModules.unit_map_one]
  erw [PresheafOfModules.comp_app]
  erw [ConcreteCategory.comp_apply]
  erw [SheafOfModules.unitToPushforwardObjUnit_val_app_apply]
  erw [map_one (ConcreteCategory.hom (Df.φ.hom.app X))]
  erw [ConcreteCategory.comp_apply]
  erw [PresheafOfModules.pushforward_map_app_apply]
  erw [SheafOfModules.unitToPushforwardObjUnit_val_app_apply]
  erw [map_one]
  erw [PresheafOfModules.comp_app]
  erw [ConcreteCategory.comp_apply]
  have e1 := SheafOfModules.pushforwardComp_hom_app_val_app Df.φ Dw.φ
    (SheafOfModules.unit (wcRingSheaf S' ℓ)) X
  erw [e1]
  erw [PresheafOfModules.comp_app]
  erw [ConcreteCategory.comp_apply]
  have e3 := SheafOfModules.pushforwardCongr_hom_app_val_app hφ
    (SheafOfModules.unit (wcRingSheaf S' ℓ)) X
  erw [e3]
  haveI : (wcProEtBC f ⋙ wcProEtBC w).IsContinuous
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S') _
  have e2 := SheafOfModules.pushforwardNatTrans_app_val_app (J := Scheme.ProEt.topology S)
    (K := Scheme.ProEt.topology S') (F := wcProEtBC f) (G := wcProEtBC f ⋙ wcProEtBC w)
    (T := wcRingSheaf S ℓ) (S := wcRingSheaf S' ℓ)
    (Df.φ ≫ ((wcProEtBC f).sheafPushforwardContinuous RingCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).map Dw.φ)
    (wcQmtmAlpha f w hcomp) (SheafOfModules.unit (wcRingSheaf S' ℓ)) X
  erw [e2]
  exact PresheafOfModules.unit_map_one _ _

theorem wc_qmtm_ses_of_sections {S : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {M₁ M₂ M₃ : SheafOfModules.{u+1} (wcRingSheaf S ℓ)} (f : M₁ ⟶ M₂) (g : M₂ ⟶ M₃)
    (hfg : f ≫ g = 0)
    (hinj : ∀ (V : S.ProEt) (x : M₁.val.obj (Opposite.op V)),
      (f.val.app (Opposite.op V)).hom x = 0 → x = 0)
    (hex : ∀ (V : S.ProEt) (y : M₂.val.obj (Opposite.op V)),
      (g.val.app (Opposite.op V)).hom y = 0 → ∃ x, (f.val.app (Opposite.op V)).hom x = y)
    (hsurj : ∀ U : S.ProEt, IsAffine U.left → ∀ y : M₃.val.obj (Opposite.op U),
      ∃ (V : S.ProEt) (h : V ⟶ U) (x : M₂.val.obj (Opposite.op V)),
        IsAffine V.left ∧ Surjective h.left ∧
        (g.val.app (Opposite.op V)).hom x = (M₃.val.map h.op).hom y) :
    (ShortComplex.mk f g hfg).ShortExact :=
by
  classical

  have hinj' : ∀ (X : (S.ProEt)ᵒᵖ) (a b : M₁.val.obj X),
      (f.val.app X).hom a = (f.val.app X).hom b → a = b := by
    intro X a b h
    have h1 : a - b = 0 := hinj X.unop (a - b) (by
      show (f.val.app X).hom (a - b) = 0
      rw [map_sub, h, sub_self])
    exact sub_eq_zero.mp h1
  have hex' : ∀ (X : (S.ProEt)ᵒᵖ) (y : M₂.val.obj X),
      (g.val.app X).hom y = 0 → ∃ x : M₁.val.obj X, (f.val.app X).hom x = y :=
    fun X y hy => hex X.unop y hy

  have hmono : Mono f := by
    apply Preadditive.mono_of_cancel_zero
    intro P φ hφ
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    refine ModuleCat.hom_ext (LinearMap.ext fun w => ?_)
    have h : (f.val.app X).hom ((φ.val.app X).hom w) = 0 := by
      have := congrArg (fun ψ => (ψ.val.app X).hom w) hφ
      exact this
    have h2 : (φ.val.app X).hom w = 0 := hinj X.unop _ h
    exact h2

  have hepi : Epi g := by
    have h1 : Epi ((SheafOfModules.toSheaf (wcRingSheaf S ℓ)).map g) := by
      apply wc_proet_epi_of_affine_lift S
      intro U hU y
      obtain ⟨V, h, x, hV, hh, hx⟩ := hsurj U hU y
      exact ⟨V, h, x, hV, hh, hx⟩
    exact (SheafOfModules.toSheaf (wcRingSheaf S ℓ)).epi_of_epi_map h1

  have hexact : (ShortComplex.mk f g hfg).Exact := by
    refine ShortComplex.exact_of_f_is_kernel _
      (Limits.KernelFork.IsLimit.ofι' (hi := hmono) _ _ (fun {W} k hk => ?_))
    have hk0 : ∀ (X : (S.ProEt)ᵒᵖ) (w : W.val.obj X),
        (g.val.app X).hom ((k.val.app X).hom w) = 0 := by
      intro X w
      have := congrArg (fun ψ => (ψ.val.app X).hom w) hk
      exact this
    choose l hl using fun (X : (S.ProEt)ᵒᵖ) (w : W.val.obj X) => hex' X _ (hk0 X w)
    let lX : ∀ X : (S.ProEt)ᵒᵖ, W.val.obj X ⟶ M₁.val.obj X := fun X => ModuleCat.ofHom
      { toFun := l X
        map_add' := fun a b => hinj' X _ _ (by rw [hl, map_add, map_add, hl, hl])
        map_smul' := fun r a => hinj' X _ _ (by
          rw [RingHom.id_apply, hl, map_smul, map_smul, hl]) }
    let lP : W.val ⟶ M₁.val :=
      { app := lX
        naturality := by
          intro X Y ρ
          refine ModuleCat.hom_ext (LinearMap.ext fun w => ?_)
          refine hinj' Y (l Y ((W.val.map ρ).hom w)) ((M₁.val.map ρ).hom (l X w)) ?_
          have e1 : (f.val.app Y).hom ((M₁.val.map ρ).hom (l X w)) =
              (M₂.val.map ρ).hom ((f.val.app X).hom (l X w)) :=
            PresheafOfModules.naturality_apply f.val ρ (l X w)
          have e2 : (k.val.app Y).hom ((W.val.map ρ).hom w) =
              (M₂.val.map ρ).hom ((k.val.app X).hom w) :=
            PresheafOfModules.naturality_apply k.val ρ w
          have e3 : (f.val.app Y).hom (l Y ((W.val.map ρ).hom w)) =
              (k.val.app Y).hom ((W.val.map ρ).hom w) := hl Y ((W.val.map ρ).hom w)
          have e4 : (f.val.app X).hom (l X w) = (k.val.app X).hom w := hl X w
          rw [e3, e2, e1, e4] }
    refine ⟨SheafOfModules.Hom.mk lP, ?_⟩
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro X
    refine ModuleCat.hom_ext (LinearMap.ext fun w => ?_)
    exact hl X w
  exact ShortComplex.ShortExact.mk' hexact hmono hepi

theorem wc_qmtm_tower_pi_props {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) :
    IsAffineHom T.πi ∧ Surjective T.πi ∧ UniversallyClosed T.πi ∧ WeaklyEtale T.πi :=
by
  classical
  have hℓpos : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have hℓ0 : (ℓ : ℤ) ≠ 0 := by exact_mod_cast hℓpos
  have hιinj : Function.Injective (algebraMap ℤ (Localization.Away (ℓ : ℤ))) :=
    IsLocalization.injective (Localization.Away (ℓ : ℤ))
      (powers_le_nonZeroDivisors_of_noZeroDivisors hℓ0)
  obtain ⟨ι₀, hι₀def⟩ : ∃ f : LaurentPolynomial L →+* AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)),
      f = AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom := ⟨_, rfl⟩
  have hι₀ : ∀ (m : ℤ) (c : L), ι₀ (AddMonoidAlgebra.single m c) =
      AddMonoidAlgebra.single (algebraMap ℤ (Localization.Away (ℓ : ℤ)) m) c := by
    intro m c
    rw [hι₀def, AddMonoidAlgebra.mapDomainRingHom_apply, AddMonoidAlgebra.mapDomain_single]
    rfl
  have hinj0 : Function.Injective ι₀ := by
    rw [hι₀def]
    intro x y hxy
    rw [AddMonoidAlgebra.mapDomainRingHom_apply, AddMonoidAlgebra.mapDomainRingHom_apply] at hxy
    exact AddMonoidAlgebra.mapDomain_injective hιinj hxy

  have hint0 : ι₀.IsIntegral := by
    intro y
    induction y using AddMonoidAlgebra.induction_linear with
    | zero =>
      have h := RingHom.isIntegralElem_map ι₀ (x := 0)
      rwa [map_zero] at h
    | add y₁ y₂ h₁ h₂ => exact RingHom.IsIntegralElem.add _ h₁ h₂
    | single q c =>
      have hsplit : (AddMonoidAlgebra.single q c : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) =
          ι₀ (AddMonoidAlgebra.single 0 c) * AddMonoidAlgebra.single q 1 := by
        rw [hι₀, map_zero, AddMonoidAlgebra.single_mul_single, zero_add, mul_one]
      rw [hsplit]
      refine RingHom.IsIntegralElem.mul _ (RingHom.isIntegralElem_map _) ?_
      obtain ⟨j, a, hja⟩ := IsLocalization.Away.surj (ℓ : ℤ) q
      refine (show ∃ P : Polynomial (LaurentPolynomial L), P.Monic ∧
          Polynomial.eval₂ ι₀ (AddMonoidAlgebra.single q 1) P = 0 from ?_)
      refine ⟨Polynomial.X ^ (ℓ ^ j) - Polynomial.C (AddMonoidAlgebra.single a 1),
        Polynomial.monic_X_pow_sub_C _ (pow_ne_zero _ hℓpos), ?_⟩
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hι₀,
        AddMonoidAlgebra.single_pow, one_pow, sub_eq_zero]
      congr 1
      rw [← hja, nsmul_eq_mul, Nat.cast_pow, map_natCast]
      ring

  have hUC : UniversallyClosed (Spec.map (CommRingCat.ofHom ι₀)) := by
    haveI : IsIntegralHom (Spec.map (CommRingCat.ofHom ι₀)) := by
      rw [IsIntegralHom.SpecMap_iff]; exact hint0
    infer_instance

  have hS : Surjective (Spec.map (CommRingCat.ofHom ι₀)) := by
    constructor
    intro x
    obtain ⟨y, hy⟩ := RingHom.IsIntegral.comap_surjective hint0 hinj0 x
    refine ⟨y, ?_⟩
    have h1 := Spec.map_apply (CommRingCat.ofHom ι₀) y
    exact h1.trans hy

  have s6 : ∀ (R : Type u) [CommRing R] (t : R), IsUnit t → ∀ n : ℕ, n ≠ 0 →
      IsUnit ((n : ℕ) : R) → wcIndEtale (AdjoinRoot.of (Polynomial.X ^ n - Polynomial.C t)) := by
    intro R _ t ht n hn hnR
    have hmon : (Polynomial.X ^ n - Polynomial.C t).Monic := Polynomial.monic_X_pow_sub_C t hn
    have hcond : ∃ (p₁ p₂ : Polynomial R) (m : ℕ),
        Polynomial.derivative (Polynomial.X ^ n - Polynomial.C t) * p₁ +
          (Polynomial.X ^ n - Polynomial.C t) * p₂ = 1 ^ m := by
      refine ⟨Polynomial.C ((↑hnR.unit⁻¹ : R) * (↑ht.unit⁻¹ : R)) * Polynomial.X,
        -Polynomial.C (↑ht.unit⁻¹ : R), 0, ?_⟩
      rw [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
        sub_zero, pow_zero]
      have hX : Polynomial.X ^ (n - 1) * Polynomial.X = (Polynomial.X ^ n : Polynomial R) :=
        pow_sub_one_mul hn _
      have h1 : ((n : ℕ) : R) * (↑hnR.unit⁻¹ : R) = 1 := hnR.mul_val_inv
      have h2 : t * (↑ht.unit⁻¹ : R) = 1 := ht.mul_val_inv
      calc _ = Polynomial.C (((n : ℕ) : R) * (↑hnR.unit⁻¹ : R)) * Polynomial.C (↑ht.unit⁻¹ : R) *
              (Polynomial.X ^ (n - 1) * Polynomial.X) - Polynomial.X ^ n * Polynomial.C (↑ht.unit⁻¹ : R) +
              Polynomial.C (t * (↑ht.unit⁻¹ : R)) := by
            simp only [map_mul]; ring
        _ = 1 := by simp only [h1, h2, hX, map_one]; ring
    let P : StandardEtalePair R := StandardEtalePair.mk (Polynomial.X ^ n - Polynomial.C t) hmon 1 hcond
    have hX : Polynomial.eval₂ (algebraMap R P.Ring) P.X (Polynomial.X ^ n - Polynomial.C t) = 0 := by
      obtain ⟨h0, -⟩ := (StandardEtalePair.hasMap_X (P := P))
      rw [Polynomial.aeval_def] at h0
      exact h0
    have hmap : P.HasMap (AdjoinRoot.root (Polynomial.X ^ n - Polynomial.C t)) := by
      refine And.intro ?_ ?_
      · rw [AdjoinRoot.aeval_eq]
        exact AdjoinRoot.mk_self
      · have hg : P.g = 1 := rfl
        rw [hg, map_one]
        exact isUnit_one
    let β₀ := P.lift (AdjoinRoot.root (Polynomial.X ^ n - Polynomial.C t)) hmap
    have hβX : β₀ P.X = AdjoinRoot.root (Polynomial.X ^ n - Polynomial.C t) :=
      P.lift_X _ hmap
    have hβα : ∀ y : AdjoinRoot (Polynomial.X ^ n - Polynomial.C t),
        β₀ (AdjoinRoot.lift (algebraMap R P.Ring) P.X hX y) = y := by
      intro y
      have e : (β₀ : P.Ring →+* AdjoinRoot (Polynomial.X ^ n - Polynomial.C t)).comp
          (AdjoinRoot.lift (algebraMap R P.Ring) P.X hX) = RingHom.id _ := by
        apply AdjoinRoot.ringHom_ext
        · refine RingHom.ext fun r => ?_
          show β₀ (AdjoinRoot.lift (algebraMap R P.Ring) P.X hX (AdjoinRoot.of _ r)) =
            AdjoinRoot.of _ r
          rw [AdjoinRoot.lift_of, β₀.commutes, AdjoinRoot.algebraMap_eq]
        · show β₀ (AdjoinRoot.lift (algebraMap R P.Ring) P.X hX (AdjoinRoot.root _)) =
            AdjoinRoot.root _
          rw [AdjoinRoot.lift_root]
          exact hβX
      exact RingHom.congr_fun e y
    let β : @AlgHom R P.Ring (AdjoinRoot (Polynomial.X ^ n - Polynomial.C t)) _ _ _ _
        (AdjoinRoot.of (Polynomial.X ^ n - Polynomial.C t)).toAlgebra :=
      @AlgHom.mk R P.Ring (AdjoinRoot (Polynomial.X ^ n - Polynomial.C t)) _ _ _ _
        (AdjoinRoot.of (Polynomial.X ^ n - Polynomial.C t)).toAlgebra
        (β₀ : P.Ring →+* AdjoinRoot (Polynomial.X ^ n - Polynomial.C t))
        (fun r => by
          have h := β₀.commutes r
          rw [AdjoinRoot.algebraMap_eq] at h
          exact h)
    let α' : @AlgHom R (AdjoinRoot (Polynomial.X ^ n - Polynomial.C t)) P.Ring _ _ _
        (AdjoinRoot.of (Polynomial.X ^ n - Polynomial.C t)).toAlgebra _ :=
      @AlgHom.mk R (AdjoinRoot (Polynomial.X ^ n - Polynomial.C t)) P.Ring _ _ _
        (AdjoinRoot.of (Polynomial.X ^ n - Polynomial.C t)).toAlgebra _
        (AdjoinRoot.lift (algebraMap R P.Ring) P.X hX) (fun r => AdjoinRoot.lift_of (x := r) hX)
    intro Pp _ _ _ h
    refine ⟨P.Ring, inferInstance, inferInstance, inferInstance,
      @AlgHom.comp R Pp (AdjoinRoot (Polynomial.X ^ n - Polynomial.C t)) P.Ring _ _ _ _ _
        (AdjoinRoot.of (Polynomial.X ^ n - Polynomial.C t)).toAlgebra _ α' h, β, ?_⟩
    exact DFunLike.ext _ _ fun x => hβα (h x)

  have hℓL : IsUnit ((ℓ : ℕ) : L) := by
    haveI : NeZero (ℓ ^ 1) := ⟨pow_ne_zero _ hℓpos⟩
    have h := (T.hζ 1).neZero'
    have h2 : ((ℓ : ℕ) : L) ≠ 0 := by
      have := h.out
      rwa [pow_one] at this
    exact Ne.isUnit h2
  have hnk : ∀ k : ℕ, IsUnit (((ℓ ^ k : ℕ)) : LaurentPolynomial L) := by
    intro k
    have e : (((ℓ ^ k : ℕ)) : LaurentPolynomial L) = LaurentPolynomial.C ((((ℓ : ℕ) : L)) ^ k) := by
      rw [map_pow, map_natCast, Nat.cast_pow]
    rw [e]
    exact (hℓL.pow k).map _

  obtain ⟨u, hu⟩ : ∃ u : Localization.Away (ℓ : ℤ),
      algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ) * u = 1 :=
    ⟨_, IsLocalization.Away.mul_invSelf (ℓ : ℤ)⟩
  have hw : ∀ k : ℕ, (algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ)) ^ k * u ^ k = 1 := by
    intro k; rw [← mul_pow, hu, one_pow]
  have hev : ∀ k : ℕ, Polynomial.eval₂ ι₀ (AddMonoidAlgebra.single (u ^ k) (1 : L))
      (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (LaurentPolynomial.T 1 : LaurentPolynomial L)) = 0 := by
    intro k
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C,
      AddMonoidAlgebra.single_pow, one_pow, sub_eq_zero]
    have h1 : (ℓ ^ k) • u ^ k = (1 : Localization.Away (ℓ : ℤ)) := by
      rw [nsmul_eq_mul, Nat.cast_pow]
      simpa using hw k
    rw [h1]
    show _ = ι₀ (AddMonoidAlgebra.single 1 1)
    rw [hι₀, map_one]
  obtain ⟨β, hβ1, hβ2⟩ : ∃ β : ∀ k : ℕ, AdjoinRoot (Polynomial.X ^ (ℓ ^ k) -
        Polynomial.C (LaurentPolynomial.T 1 : LaurentPolynomial L)) →+*
        AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)),
      (∀ k x, β k (AdjoinRoot.of _ x) = ι₀ x) ∧
      (∀ k, β k (AdjoinRoot.root _) = AddMonoidAlgebra.single (u ^ k) (1 : L)) :=
    ⟨fun k => AdjoinRoot.lift ι₀ _ (hev k), fun k x => AdjoinRoot.lift_of _,
      fun k => AdjoinRoot.lift_root _⟩
  have hθ : ∀ k : ℕ, AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) -
      Polynomial.C (LaurentPolynomial.T 1 : LaurentPolynomial L)) ^ (ℓ ^ k) =
      AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (LaurentPolynomial.T 1 : LaurentPolynomial L))
        (LaurentPolynomial.T 1) := by
    intro k
    have h := AdjoinRoot.mk_self (f := Polynomial.X ^ (ℓ ^ k) -
      Polynomial.C (LaurentPolynomial.T 1 : LaurentPolynomial L))
    rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h
    exact h

  have Γex : ∀ k : ℕ, ∃ Γ : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+
      AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (LaurentPolynomial.T 1 : LaurentPolynomial L)),
      ∀ (r : LaurentPolynomial L) (n : ℕ),
        Γ (ι₀ r * AddMonoidAlgebra.single (n • u ^ k) (1 : L)) =
        AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) -
            Polynomial.C (LaurentPolynomial.T 1 : LaurentPolynomial L)) r *
          AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) -
            Polynomial.C (LaurentPolynomial.T 1 : LaurentPolynomial L)) ^ n := by
    intro k
    have hθk := hθ k
    generalize (Polynomial.X ^ (ℓ ^ k) -
      Polynomial.C (LaurentPolynomial.T 1 : LaurentPolynomial L)) = P at hθk ⊢
    obtain ⟨Nz, hNz⟩ : ∃ Nz : ℤ, Nz = (ℓ : ℤ) ^ k := ⟨_, rfl⟩
    have hNz0 : Nz ≠ 0 := by rw [hNz]; exact pow_ne_zero _ hℓ0
    have hNzw : algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * u ^ k = 1 := by
      rw [hNz, map_pow]; exact hw k
    let Γq : Localization.Away (ℓ : ℤ) → L →+ AdjoinRoot P := fun q =>
      if h : ∃ a : ℤ, algebraMap ℤ (Localization.Away (ℓ : ℤ)) a =
          algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * q then
        { toFun := fun c => AdjoinRoot.of P (LaurentPolynomial.C c *
              LaurentPolynomial.T (h.choose / Nz)) * AdjoinRoot.root P ^ (h.choose % Nz).toNat
          map_zero' := by simp
          map_add' := by intro a b; simp only [map_add, add_mul] }
      else 0
    have hΓq1 : ∀ (q : Localization.Away (ℓ : ℤ)) (a : ℤ) (c : L),
        algebraMap ℤ (Localization.Away (ℓ : ℤ)) a =
          algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * q →
        Γq q c = AdjoinRoot.of P (LaurentPolynomial.C c * LaurentPolynomial.T (a / Nz)) *
          AdjoinRoot.root P ^ (a % Nz).toNat := by
      intro q a c ha
      have h : ∃ a : ℤ, algebraMap ℤ (Localization.Away (ℓ : ℤ)) a =
          algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * q := ⟨a, ha⟩
      have hc : h.choose = a := hιinj (h.choose_spec.trans ha.symm)
      simp only [Γq, dif_pos h, AddMonoidHom.coe_mk, ZeroHom.coe_mk, hc]
    have hΓq0 : ∀ (q : Localization.Away (ℓ : ℤ)) (c : L),
        ¬ (∃ a : ℤ, algebraMap ℤ (Localization.Away (ℓ : ℤ)) a =
          algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * q) → Γq q c = 0 := by
      intro q c h
      simp only [Γq, dif_neg h, AddMonoidHom.zero_apply]
    let Γ : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+ AdjoinRoot P :=
      { toFun := fun g => Finsupp.liftAddHom Γq g.coeff
        map_zero' := by simp only [AddMonoidAlgebra.coeff_zero, map_zero]
        map_add' := by intro x y; simp only [AddMonoidAlgebra.coeff_add, map_add] }
    have hΓs : ∀ (q : Localization.Away (ℓ : ℤ)) (c : L),
        Γ (AddMonoidAlgebra.single q c) = Γq q c := by
      intro q c
      show Finsupp.liftAddHom Γq (AddMonoidAlgebra.single q c).coeff = Γq q c
      rw [AddMonoidAlgebra.coeff_single, Finsupp.liftAddHom_apply_single]
    have hkey : ∀ (r : LaurentPolynomial L) (g : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))),
        Γ (ι₀ r * g) = AdjoinRoot.of P r * Γ g := by
      intro r g
      induction g using AddMonoidAlgebra.induction_linear with
      | zero => simp
      | add g₁ g₂ h₁ h₂ => simp only [mul_add, map_add, h₁, h₂]
      | single q c =>
        induction r using AddMonoidAlgebra.induction_linear with
        | zero => simp
        | add r₁ r₂ h₁ h₂ => simp only [map_add, add_mul, h₁, h₂]
        | single m c' =>
          rw [hι₀, AddMonoidAlgebra.single_mul_single, hΓs, hΓs]
          by_cases hq : ∃ a : ℤ, algebraMap ℤ (Localization.Away (ℓ : ℤ)) a =
              algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * q
          · obtain ⟨a, ha⟩ := hq
            have ha' : algebraMap ℤ (Localization.Away (ℓ : ℤ)) (a + Nz * m) =
                algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz *
                  (algebraMap ℤ (Localization.Away (ℓ : ℤ)) m + q) := by
              rw [map_add, map_mul, ha]; ring
            rw [hΓq1 _ _ _ ha', hΓq1 _ _ _ ha, Int.add_mul_ediv_left _ _ hNz0,
              Int.add_mul_emod_self_left, LaurentPolynomial.single_eq_C_mul_T,
              map_mul LaurentPolynomial.C, LaurentPolynomial.T_add]
            simp only [map_mul]
            ring
          · have hq' : ¬ ∃ a : ℤ, algebraMap ℤ (Localization.Away (ℓ : ℤ)) a =
                algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz *
                  (algebraMap ℤ (Localization.Away (ℓ : ℤ)) m + q) := by
              rintro ⟨a, ha⟩
              apply hq
              refine ⟨a - Nz * m, ?_⟩
              rw [map_sub, map_mul, ha]; ring
            rw [hΓq0 _ _ hq', hΓq0 _ _ hq, mul_zero]
    refine ⟨Γ, ?_⟩
    intro r n
    rw [hkey, hΓs]
    have hn : algebraMap ℤ (Localization.Away (ℓ : ℤ)) (n : ℤ) =
        algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * (n • u ^ k) := by
      rw [nsmul_eq_mul, mul_left_comm, hNzw, mul_one, map_natCast]
    rw [hΓq1 _ _ _ hn]
    congr 1
    have hNnat : Nz = ((ℓ ^ k : ℕ) : ℤ) := by rw [hNz, Nat.cast_pow]
    rw [hNnat, ← Int.natCast_div, ← Int.natCast_mod, Int.toNat_natCast, map_one, one_mul]
    have hTpow : (LaurentPolynomial.T (((n / ℓ ^ k : ℕ)) : ℤ) : LaurentPolynomial L) =
        LaurentPolynomial.T 1 ^ (n / ℓ ^ k) := by
      rw [LaurentPolynomial.T_pow, mul_one]
    rw [hTpow, map_pow, ← hθk, ← pow_mul, ← pow_add, Nat.div_add_mod]
  have hinjβ : ∀ k, Function.Injective (β k) := by
    intro k
    obtain ⟨Γ, hΓ⟩ := Γex k
    apply Function.LeftInverse.injective (g := Γ)
    intro y
    refine AdjoinRoot.induction_on _ y (fun p => ?_)
    refine Polynomial.induction_on' p ?_ ?_
    · intro p q hp hq
      simp only [map_add, hp, hq]
    · intro n r
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, AdjoinRoot.mk_C,
        AdjoinRoot.mk_X, map_mul, map_pow, hβ1, hβ2 k, AddMonoidAlgebra.single_pow, one_pow, hΓ]

  have hex : ∀ z : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)),
      ∃ K₀ : ℕ, ∀ k : ℕ, K₀ ≤ k → z ∈ (β k).range := by
    intro z
    induction z using AddMonoidAlgebra.induction_linear with
    | zero => exact ⟨0, fun k _ => zero_mem _⟩
    | add z₁ z₂ h₁ h₂ =>
      obtain ⟨K₁, hK₁⟩ := h₁
      obtain ⟨K₂, hK₂⟩ := h₂
      exact ⟨max K₁ K₂, fun k hk =>
        add_mem (hK₁ k (le_of_max_le_left hk)) (hK₂ k (le_of_max_le_right hk))⟩
    | single q c =>
      obtain ⟨j, a, hja⟩ := IsLocalization.Away.surj (ℓ : ℤ) q
      refine ⟨j, fun k hk => ?_⟩
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hk
      obtain ⟨w, hwdef⟩ : ∃ w : Localization.Away (ℓ : ℤ), w = u ^ (j + d) := ⟨_, rfl⟩
      have hwk : (algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ)) ^ (j + d) * w = 1 := by
        rw [hwdef]; exact hw _
      have hβ2' : β (j + d) (AdjoinRoot.root _) = AddMonoidAlgebra.single w (1 : L) := by
        rw [hwdef]; exact hβ2 _
      have hNz0 : ((ℓ : ℤ) ^ (j + d)) ≠ 0 := pow_ne_zero _ hℓ0
      have hq1 : q = algebraMap ℤ (Localization.Away (ℓ : ℤ)) (a * (ℓ : ℤ) ^ d) * w := by
        calc q = q * ((algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ)) ^ (j + d) * w) := by
              rw [hwk, mul_one]
          _ = (q * (algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ)) ^ j) *
              (algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ)) ^ d * w := by ring
          _ = _ := by rw [hja, map_mul, map_pow]
      have hs0 : 0 ≤ (a * (ℓ : ℤ) ^ d) % ((ℓ : ℤ) ^ (j + d)) := Int.emod_nonneg _ hNz0
      have hbdec := Int.emod_add_mul_ediv (a * (ℓ : ℤ) ^ d) ((ℓ : ℤ) ^ (j + d))
      have hq2 : q = algebraMap ℤ (Localization.Away (ℓ : ℤ))
            ((a * (ℓ : ℤ) ^ d) / ((ℓ : ℤ) ^ (j + d))) +
          ((a * (ℓ : ℤ) ^ d) % ((ℓ : ℤ) ^ (j + d))).toNat • w := by
        have hcast : ((((a * (ℓ : ℤ) ^ d) % ((ℓ : ℤ) ^ (j + d))).toNat : ℕ) :
            Localization.Away (ℓ : ℤ)) = algebraMap ℤ (Localization.Away (ℓ : ℤ))
              ((a * (ℓ : ℤ) ^ d) % ((ℓ : ℤ) ^ (j + d))) := by
          rw [← map_natCast (algebraMap ℤ (Localization.Away (ℓ : ℤ))), Int.toNat_of_nonneg hs0]
        rw [nsmul_eq_mul, hcast]
        conv_lhs => rw [hq1, ← hbdec]
        rw [map_add, map_mul, map_pow]
        linear_combination (algebraMap ℤ (Localization.Away (ℓ : ℤ))
          ((a * (ℓ : ℤ) ^ d) / ((ℓ : ℤ) ^ (j + d)))) * hwk
      have hsingle : (AddMonoidAlgebra.single q c : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) =
          ι₀ (AddMonoidAlgebra.single ((a * (ℓ : ℤ) ^ d) / ((ℓ : ℤ) ^ (j + d))) c) *
            (AddMonoidAlgebra.single w (1 : L)) ^
              ((a * (ℓ : ℤ) ^ d) % ((ℓ : ℤ) ^ (j + d))).toNat := by
        rw [hι₀, AddMonoidAlgebra.single_pow, AddMonoidAlgebra.single_mul_single, one_pow,
          mul_one, ← hq2]
      rw [hsingle]
      refine RingHom.mem_range.mpr ⟨AdjoinRoot.of _ (AddMonoidAlgebra.single
        ((a * (ℓ : ℤ) ^ d) / ((ℓ : ℤ) ^ (j + d))) c) * AdjoinRoot.root _ ^
          ((a * (ℓ : ℤ) ^ d) % ((ℓ : ℤ) ^ (j + d))).toNat, ?_⟩
      rw [map_mul, map_pow, hβ1, hβ2']

  have hind : wcIndEtale ι₀ := by
    refine wc_seq_colimit_indEtale (LaurentPolynomial L)
      (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) ι₀
      (fun k => AdjoinRoot (Polynomial.X ^ (ℓ ^ k) -
        Polynomial.C (LaurentPolynomial.T 1 : LaurentPolynomial L)))
      (fun k => AdjoinRoot.of _) β ?_ ?_ ?_ ?_
    · intro k
      exact RingHom.ext fun x => hβ1 k x
    · intro k
      exact s6 (LaurentPolynomial L) (LaurentPolynomial.T 1) (LaurentPolynomial.isUnit_T 1)
        (ℓ ^ k) (pow_ne_zero _ hℓpos) (hnk k)
    · intro n t
      choose K hK using fun i => hex (t i)
      exact ⟨Finset.univ.sup K,
        fun i => (RingHom.mem_range.mp (hK i _ (Finset.le_sup (Finset.mem_univ i)))).choose,
        fun i => (RingHom.mem_range.mp (hK i _ (Finset.le_sup (Finset.mem_univ i)))).choose_spec⟩
    · intro k n x hx
      exact ⟨k, RingHom.id _, RingHom.comp_id _, RingHom.id_comp _,
        fun i => hinjβ k ((hx i).trans (map_zero _).symm)⟩
  have hWA := wc_indEtale_weaklyEtale ι₀ hind
  have hWS : WeaklyEtale (Spec.map (CommRingCat.ofHom ι₀)) :=
    @wc_lfi_specMap_weaklyEtale (LaurentPolynomial L)
      (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) _ _ ι₀.toAlgebra hWA
  subst hι₀def
  have hpb := T.hT.flip
  exact ⟨MorphismProperty.of_isPullback (P := @IsAffineHom) hpb inferInstance,
    MorphismProperty.of_isPullback (P := @Surjective) hpb hS,
    MorphismProperty.of_isPullback (P := @UniversallyClosed) hpb hUC,
    MorphismProperty.of_isPullback (P := @WeaklyEtale) hpb hWS⟩

theorem wc_qmtm_tt_psi_exists {L : Type u} [Field L] {ℓ : ℕ} [Fact (Nat.Prime ℓ)] (ζ : ℕ → L)
    (hζ : ∀ k, IsPrimitiveRoot (ζ k) (ℓ ^ k)) (hζc : ∀ k, ζ (k + 1) ^ ℓ = ζ k) :
    ∃ Ψ : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
      LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))),
    ∀ (a : ℤ) (k : ℕ) (c : L) (z : ℤ_[ℓ]),
      Ψ (AddMonoidAlgebra.single (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c) z =
        AddMonoidAlgebra.single (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))
          (ζ k ^ (a * ((PadicInt.toZModPow k z).val : ℤ)) * c) :=
by
  classical
  have hℓ : ℓ.Prime := Fact.out
  have hℓ0 : ℓ ≠ 0 := hℓ.ne_zero
  have hℓZ : (ℓ : ℤ) ≠ 0 := by exact_mod_cast hℓ0
  have hζ0 : ∀ k, ζ k ≠ 0 := fun k => (hζ k).ne_zero (pow_ne_zero k hℓ0)

  have R1 : ∀ k m : ℕ, ζ (k + m) ^ (ℓ ^ m) = ζ k := by
    intro k m
    induction m with
    | zero => simp
    | succ m ih =>
      rw [pow_succ', pow_mul, ← Nat.add_assoc, hζc, ih]

  have R2 : ∀ (z : ℤ_[ℓ]) (k m : ℕ), ((ℓ ^ k : ℕ) : ℤ) ∣
      ((PadicInt.toZModPow (k + m) z).val : ℤ) - ((PadicInt.toZModPow k z).val : ℤ) := by
    intro z k m
    have : NeZero (ℓ ^ (k + m)) := ⟨pow_ne_zero _ hℓ0⟩
    have : NeZero (ℓ ^ k) := ⟨pow_ne_zero _ hℓ0⟩
    rw [← ZMod.intCast_eq_intCast_iff_dvd_sub]
    have h1 := congrArg (fun f => f z)
      (PadicInt.zmod_cast_comp_toZModPow (p := ℓ) k (k + m) (Nat.le_add_right k m))
    simp only [RingHom.coe_comp, Function.comp_apply, ZMod.castHom_apply] at h1
    rw [Int.cast_natCast, Int.cast_natCast, ZMod.natCast_zmod_val (PadicInt.toZModPow k z),
      ZMod.natCast_val, h1]

  have R3 : ∀ (k : ℕ) (e e' : ℤ), ((ℓ ^ k : ℕ) : ℤ) ∣ e - e' → ζ k ^ e = ζ k ^ e' := by
    intro k e e' h
    have h1 : ζ k ^ (e - e') = 1 := ((hζ k).zpow_eq_one_iff_dvd (e - e')).mpr h
    calc ζ k ^ e = ζ k ^ ((e - e') + e') := by rw [sub_add_cancel]
      _ = ζ k ^ (e - e') * ζ k ^ e' := zpow_add₀ (hζ0 k) _ _
      _ = ζ k ^ e' := by rw [h1, one_mul]

  have R4 : ∀ (z : ℤ_[ℓ]) (k m : ℕ) (a : ℤ), ζ k ^ (a * ((PadicInt.toZModPow k z).val : ℤ)) =
      ζ (k + m) ^ (a * (ℓ : ℤ) ^ m * ((PadicInt.toZModPow (k + m) z).val : ℤ)) := by
    intro z k m a
    have e1 : a * (ℓ : ℤ) ^ m * ((PadicInt.toZModPow (k + m) z).val : ℤ) =
        ((ℓ ^ m : ℕ) : ℤ) * (a * ((PadicInt.toZModPow (k + m) z).val : ℤ)) := by
      push_cast; ring
    rw [e1, zpow_mul (ζ (k + m)), zpow_natCast, R1]
    apply R3
    have e2 : a * ((PadicInt.toZModPow k z).val : ℤ) -
          a * ((PadicInt.toZModPow (k + m) z).val : ℤ)
        = -(a * (((PadicInt.toZModPow (k + m) z).val : ℤ) -
          ((PadicInt.toZModPow k z).val : ℤ))) := by ring
    rw [e2, dvd_neg]
    exact Dvd.dvd.mul_left (R2 z k m) a

  have S1 : ∀ (z : ℤ_[ℓ]) (a a' : ℤ) (k k' : ℕ), a * (ℓ : ℤ) ^ k' = a' * (ℓ : ℤ) ^ k →
      ζ k ^ (a * ((PadicInt.toZModPow k z).val : ℤ)) =
        ζ k' ^ (a' * ((PadicInt.toZModPow k' z).val : ℤ)) := by
    intro z a a' k k' h
    rw [R4 z k k' a, R4 z k' k a', h, Nat.add_comm k' k]

  have S2 : ∀ k : ℕ, IsLocallyConstant (PadicInt.toZModPow k : ℤ_[ℓ] → ZMod (ℓ ^ k)) := by
    intro k
    rw [IsLocallyConstant.iff_isOpen_fiber]
    intro y
    rw [Metric.isOpen_iff]
    intro x hx
    refine ⟨(ℓ : ℝ) ^ (-(k : ℤ)), zpow_pos (by exact_mod_cast hℓ.pos) _, ?_⟩
    intro x' hx'
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hx ⊢
    rw [Metric.mem_ball, dist_eq_norm] at hx'
    have h1 : x' - x ∈ RingHom.ker (PadicInt.toZModPow k) := by
      rw [PadicInt.ker_toZModPow, ← PadicInt.norm_le_pow_iff_mem_span_pow]
      exact hx'.le
    rw [RingHom.mem_ker, map_sub, sub_eq_zero] at h1
    rw [h1, hx]

  have hnorm : ∀ x : Localization.Away (ℓ : ℤ), ∃ (a : ℤ) (k : ℕ),
      x = (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) := by
    intro x
    refine Localization.induction_on x ?_
    rintro ⟨a, s⟩
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp s.2
    refine ⟨a, n, ?_⟩
    rw [show s = ⟨(ℓ : ℤ) ^ n, n, rfl⟩ from Subtype.ext hn.symm]

  have S3 : ∀ (F : ℤ → ℕ → L),
      (∀ (a a' : ℤ) (k k' : ℕ), a * (ℓ : ℤ) ^ k' = a' * (ℓ : ℤ) ^ k → F a k = F a' k') →
      (∀ (a a' : ℤ) (k : ℕ), F (a + a') k = F a k * F a' k) → F 0 0 = 1 →
      ∃ χ : Multiplicative (Localization.Away (ℓ : ℤ)) →* L,
        ∀ (a : ℤ) (k : ℕ), χ (Multiplicative.ofAdd
          (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))) = F a k := by
    intro F hF hadd h0
    have hpow : ∀ s : Submonoid.powers (ℓ : ℤ), ∃ n : ℕ, (ℓ : ℤ) ^ n = s :=
      fun s => (Submonoid.mem_powers_iff _ _).mp s.2
    choose κ hκ using hpow
    let f₀ : Localization.Away (ℓ : ℤ) → L := fun x => Localization.liftOn x
      (fun a s => F a (κ s)) (by
        intro a c b d h
        rw [Localization.r_iff_exists] at h
        obtain ⟨t, ht⟩ := h
        have ht0 : (t : ℤ) ≠ 0 := by
          rw [← hκ t]; exact pow_ne_zero _ hℓZ
        have h2 := mul_left_cancel₀ ht0 ht
        dsimp only at h2
        apply hF
        rw [hκ d, hκ b]
        linear_combination h2)
    have hE : ∀ (a : ℤ) (k : ℕ), f₀ (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩) = F a k := by
      intro a k
      simp only [f₀]
      rw [Localization.liftOn_mk]
      apply hF
      rw [hκ]
    have hA : ∀ x y : Localization.Away (ℓ : ℤ), f₀ (x + y) = f₀ x * f₀ y := by
      intro x y
      obtain ⟨a, m, rfl⟩ := hnorm x
      obtain ⟨c, n, rfl⟩ := hnorm y
      rw [Localization.add_mk]
      have e : (⟨(ℓ : ℤ) ^ m, m, rfl⟩ * ⟨(ℓ : ℤ) ^ n, n, rfl⟩ : Submonoid.powers (ℓ : ℤ)) =
          ⟨(ℓ : ℤ) ^ (m + n), m + n, rfl⟩ := Subtype.ext (pow_add _ _ _).symm
      rw [e, hE, hE, hE, hadd, mul_comm (F a m) (F c n)]
      congr 1
      · apply hF
        show (ℓ : ℤ) ^ m * c * (ℓ : ℤ) ^ n = c * (ℓ : ℤ) ^ (m + n)
        ring
      · apply hF
        show (ℓ : ℤ) ^ n * a * (ℓ : ℤ) ^ m = a * (ℓ : ℤ) ^ (m + n)
        ring
    have hZ : f₀ 0 = 1 := by
      have : (0 : Localization.Away (ℓ : ℤ)) = (Localization.mk 0 ⟨(ℓ : ℤ) ^ 0, 0, rfl⟩ : Localization.Away (ℓ : ℤ)) :=
        (Localization.mk_zero _).symm
      rw [this, hE, h0]
    refine ⟨{ toFun := fun y => f₀ (Multiplicative.toAdd y), map_one' := ?_, map_mul' := ?_ }, ?_⟩
    · show f₀ (Multiplicative.toAdd 1) = 1
      rw [toAdd_one, hZ]
    · intro x y
      show f₀ (Multiplicative.toAdd (x * y)) =
        f₀ (Multiplicative.toAdd x) * f₀ (Multiplicative.toAdd y)
      rw [toAdd_mul, hA]
    · intro a k
      exact (congrArg f₀ (toAdd_ofAdd _)).trans (hE a k)

  have hχex : ∀ z : ℤ_[ℓ], ∃ χ : Multiplicative (Localization.Away (ℓ : ℤ)) →* L,
      ∀ (a : ℤ) (k : ℕ), χ (Multiplicative.ofAdd
        (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))) =
          ζ k ^ (a * ((PadicInt.toZModPow k z).val : ℤ)) := by
    intro z
    refine S3 (fun a k => ζ k ^ (a * ((PadicInt.toZModPow k z).val : ℤ))) (S1 z) ?_ ?_
    · intro a a' k
      simp only [add_mul]
      exact zpow_add₀ (hζ0 k) _ _
    · simp
  choose χ hχ using hχex
  have hLC : ∀ y : Multiplicative (Localization.Away (ℓ : ℤ)),
      IsLocallyConstant (fun z : ℤ_[ℓ] => χ z y) := by
    intro y
    obtain ⟨a, k, hy⟩ := hnorm (Multiplicative.toAdd y)
    have : (fun z : ℤ_[ℓ] => χ z y) = (fun w : ZMod (ℓ ^ k) => ζ k ^ (a * (w.val : ℤ))) ∘
        (PadicInt.toZModPow k : ℤ_[ℓ] → ZMod (ℓ ^ k)) := by
      funext z
      rw [Function.comp_apply, ← hχ z a k, ← hy, ofAdd_toAdd]
    rw [this]
    exact (S2 k).comp _
  let g : Multiplicative (Localization.Away (ℓ : ℤ)) →*
      LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) :=
    { toFun := fun y => ⟨fun z => AddMonoidAlgebra.single (Multiplicative.toAdd y) (χ z y),
        (hLC y).comp (AddMonoidAlgebra.single (Multiplicative.toAdd y))⟩
      map_one' := by
        ext z
        simp [AddMonoidAlgebra.one_def]
      map_mul' := by
        intro x y
        ext z
        simp [AddMonoidAlgebra.single_mul_single] }
  refine ⟨AddMonoidAlgebra.liftNCRingHom
    ((LocallyConstant.constRingHom).comp AddMonoidAlgebra.singleZeroRingHom) g
    (fun _ _ => Commute.all _ _), ?_⟩
  intro a k c z
  rw [AddMonoidAlgebra.liftNCRingHom_single, LocallyConstant.coe_mul, Pi.mul_apply]
  show AddMonoidAlgebra.single 0 c *
    AddMonoidAlgebra.single (Multiplicative.toAdd (Multiplicative.ofAdd
      (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))))
      (χ z (Multiplicative.ofAdd
      (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)))) = _
  rw [toAdd_ofAdd, AddMonoidAlgebra.single_mul_single, zero_add, hχ, mul_comm]

theorem wc_qmtm_tt_psi_pushout {L : Type u} [Field L] {ℓ : ℕ} [Fact (Nat.Prime ℓ)] (ζ : ℕ → L)
    (hζ : ∀ k, IsPrimitiveRoot (ζ k) (ℓ ^ k)) (hζc : ∀ k, ζ (k + 1) ^ ℓ = ζ k)
    (Ψ : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
      LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))
    (hΨ : ∀ (a : ℤ) (k : ℕ) (c : L) (z : ℤ_[ℓ]),
      Ψ (AddMonoidAlgebra.single (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c) z =
        AddMonoidAlgebra.single (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))
          (ζ k ^ (a * ((PadicInt.toZModPow k z).val : ℤ)) * c)) :
    IsPushout
      (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom))
      (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom))
      (CommRingCat.ofHom (LocallyConstant.constRingHom :
        AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
          LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))))
      (CommRingCat.ofHom Ψ) :=
by
  classical
  have hℓpos : (0 : ℤ) < (ℓ : ℤ) := by exact_mod_cast (Fact.out : ℓ.Prime).pos

  have s7 : ∀ {R A P : Type u} [CommRing R] [CommRing A] [CommRing P] [Algebra R A]
      (i j : A →+* P) (Φ : TensorProduct R A A →+* P),
      (∀ a b : A, Φ (a ⊗ₜ[R] b) = i a * j b) → Function.Bijective Φ →
      IsPushout (CommRingCat.ofHom (algebraMap R A)) (CommRingCat.ofHom (algebraMap R A))
        (CommRingCat.ofHom i) (CommRingCat.ofHom j) := by
    intro R A P _ _ _ _ i j Φ hΦ hbij
    let e := RingEquiv.ofBijective Φ hbij
    refine IsPushout.of_iso (CommRingCat.isPushout_tensorProduct R A A) (Iso.refl _) (Iso.refl _)
      (Iso.refl _) e.toCommRingCatIso ?_ ?_ ?_ ?_
    · simp
    · simp
    · ext a
      simp [e, hΦ]
    · ext b
      simp [e, hΦ]

  have s2 : ∀ {n : ℕ} {ξ : L}, IsPrimitiveRoot ξ n → ∀ r : ℤ,
      ∑ j ∈ Finset.range n, ξ ^ (r * (j : ℤ)) = if (n : ℤ) ∣ r then (n : L) else 0 := by
    intro n ξ hξ r
    have h1 : ∀ j : ℕ, ξ ^ (r * (j : ℤ)) = (ξ ^ r) ^ j := fun j => by rw [zpow_mul, zpow_natCast]
    simp_rw [h1]
    split_ifs with hd
    · rw [(hξ.zpow_eq_one_iff_dvd r).mpr hd]
      simp
    · have hw : ξ ^ r ≠ 1 := fun h => hd ((hξ.zpow_eq_one_iff_dvd r).mp h)
      have hwn : (ξ ^ r) ^ n = 1 := by
        rw [← zpow_natCast, ← zpow_mul, mul_comm, zpow_mul, zpow_natCast, hξ.pow_eq_one, one_zpow]
      have := geom_sum_mul (ξ ^ r) n
      rw [hwn, sub_self] at this
      exact (mul_eq_zero.mp this).resolve_right (sub_ne_zero.mpr hw)

  have s5 : ∀ (f : LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))),
      ∃ k : ℕ, ∀ z z' : ℤ_[ℓ], PadicInt.toZModPow k z = PadicInt.toZModPow k z' → f z = f z' := by
    intro f
    obtain ⟨δ, hδ, hball⟩ := lebesgue_number_lemma_of_metric (s := (Set.univ : Set ℤ_[ℓ]))
      (c := fun y : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) => f ⁻¹' {y}) isCompact_univ
      (fun y => f.isLocallyConstant.isOpen_fiber y)
      (fun x _ => Set.mem_iUnion.mpr ⟨f x, rfl⟩)
    have hℓ1 : (1:ℝ) < ℓ := by exact_mod_cast (Fact.out : ℓ.Prime).one_lt
    obtain ⟨k, hk⟩ := exists_pow_lt_of_lt_one hδ (inv_lt_one_of_one_lt₀ hℓ1)
    refine ⟨k, fun z z' h => ?_⟩
    have hmem : z - z' ∈ Ideal.span {(ℓ : ℤ_[ℓ]) ^ k} := by
      rw [← PadicInt.ker_toZModPow, RingHom.mem_ker, map_sub, h, sub_self]
    have hn := (PadicInt.norm_le_pow_iff_mem_span_pow _ _).mpr hmem
    obtain ⟨y, hy⟩ := hball z' (Set.mem_univ _)
    have h1 : z ∈ Metric.ball z' δ := by
      rw [Metric.mem_ball, dist_eq_norm]
      refine lt_of_le_of_lt hn ?_
      rw [zpow_neg, zpow_natCast, ← inv_pow]
      exact hk
    have e1 : f z = y := hy h1
    have e2 : f z' = y := hy (Metric.mem_ball_self hδ)
    rw [e1, e2]

  have hcomm : Ψ.comp (AddMonoidAlgebra.mapDomainRingHom L
      (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) =
      (LocallyConstant.constRingHom : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
          LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))).comp
        (AddMonoidAlgebra.mapDomainRingHom L (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) := by
    have hζ0 : ζ 0 = 1 := by
      have := hζ 0
      rw [pow_zero] at this
      exact IsPrimitiveRoot.one_right_iff.mp this
    have hι : ∀ (m : ℤ) (c : L),
        AddMonoidAlgebra.mapDomainRingHom L (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom
          (AddMonoidAlgebra.single m c) =
        AddMonoidAlgebra.single (Localization.mk m ⟨(ℓ : ℤ) ^ 0, 0, rfl⟩ : Localization.Away (ℓ : ℤ)) c := by
      intro m c
      rw [AddMonoidAlgebra.mapDomainRingHom_apply, AddMonoidAlgebra.mapDomain_single]
      congr 1
    have key : ∀ (m : ℤ) (c : L),
        Ψ (AddMonoidAlgebra.mapDomainRingHom L (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom
          (AddMonoidAlgebra.single m c)) =
        LocallyConstant.constRingHom (AddMonoidAlgebra.mapDomainRingHom L
          (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom (AddMonoidAlgebra.single m c)) := by
      intro m c
      ext z
      rw [hι, hΨ, hζ0, one_zpow, one_mul]
      rfl
    apply AddMonoidAlgebra.ringHom_ext
    · intro b
      exact key 0 b
    · intro a
      exact key a 1

  have s4 : ∀ (k : ℕ) (g : ℕ → AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))),
      (∀ z : ℤ_[ℓ], ∑ a ∈ Finset.range (ℓ ^ k), g a *
        AddMonoidAlgebra.single (Localization.mk (a : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))
          (ζ k ^ ((a : ℤ) * ((PadicInt.toZModPow k z).val : ℤ)) * 1) = 0) →
      ∀ a < ℓ ^ k, g a = 0 := by
    intro k g hg
    have horth := s2 (hζ k)
    have hnpos : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k
    haveI : NeZero (ℓ ^ k) := ⟨hnpos.ne'⟩
    have hζ0 : ζ k ≠ 0 := (hζ k).ne_zero hnpos.ne'
    have hnL : ((ℓ ^ k : ℕ) : L) ≠ 0 := ((hζ k).neZero').out
    obtain ⟨C, hC⟩ : ∃ C : L →+* AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)),
        ∀ r, C r = AddMonoidAlgebra.single 0 r := ⟨AddMonoidAlgebra.singleZeroRingHom, fun _ => rfl⟩
    obtain ⟨t, ht⟩ : ∃ t : ℤ → AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)), ∀ a, t a =
        AddMonoidAlgebra.single (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) (1 : L) :=
      ⟨_, fun _ => rfl⟩
    have hfac : ∀ (a : ℤ) (r : L), AddMonoidAlgebra.single
        (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) r = C r * t a := by
      intro a r
      rw [hC, ht, AddMonoidAlgebra.single_mul_single, zero_add, mul_one]
    have hinv : ∀ a : ℤ, t a * t (-a) = 1 := by
      intro a
      rw [ht, ht, AddMonoidAlgebra.single_mul_single, Localization.add_mk_self, add_neg_cancel,
        Localization.mk_zero, mul_one, AddMonoidAlgebra.one_def]
    have hval : ∀ j < ℓ ^ k, (PadicInt.toZModPow k (j : ℤ_[ℓ])).val = j := by
      intro j hj
      rw [map_natCast, ZMod.val_natCast, Nat.mod_eq_of_lt hj]
    have E : ∀ j < ℓ ^ k, ∑ a ∈ Finset.range (ℓ ^ k),
        g a * (C (ζ k ^ ((a : ℤ) * (j : ℤ))) * t a) = 0 := by
      intro j hj
      have := hg (j : ℤ_[ℓ])
      rw [hval j hj] at this
      simp only [mul_one, hfac] at this
      exact this
    intro a' ha'
    have key : ∑ j ∈ Finset.range (ℓ ^ k), C (ζ k ^ (-((a' : ℤ) * (j : ℤ)))) *
        ∑ a ∈ Finset.range (ℓ ^ k), g a * (C (ζ k ^ ((a : ℤ) * (j : ℤ))) * t a) = 0 := by
      apply Finset.sum_eq_zero
      intro j hj
      rw [E j (Finset.mem_range.mp hj), mul_zero]
    have key2 : ∑ j ∈ Finset.range (ℓ ^ k), C (ζ k ^ (-((a' : ℤ) * (j : ℤ)))) *
        ∑ a ∈ Finset.range (ℓ ^ k), g a * (C (ζ k ^ ((a : ℤ) * (j : ℤ))) * t a) =
        ∑ a ∈ Finset.range (ℓ ^ k), g a * t a *
          C (∑ j ∈ Finset.range (ℓ ^ k), ζ k ^ (((a : ℤ) - a') * (j : ℤ))) := by
      simp_rw [Finset.mul_sum, map_sum, Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun j _ => ?_
      have : ζ k ^ (((a : ℤ) - a') * (j : ℤ)) =
          ζ k ^ (-((a' : ℤ) * (j : ℤ))) * ζ k ^ ((a : ℤ) * (j : ℤ)) := by
        rw [← zpow_add₀ hζ0]; congr 1; ring
      rw [this, map_mul]; ring
    have key3 : ∑ a ∈ Finset.range (ℓ ^ k), g a * t a *
          C (∑ j ∈ Finset.range (ℓ ^ k), ζ k ^ (((a : ℤ) - a') * (j : ℤ))) =
        g a' * t a' * C ((ℓ ^ k : ℕ) : L) := by
      rw [Finset.sum_eq_single_of_mem a' (Finset.mem_range.mpr ha')]
      · rw [horth, if_pos (by simp)]
      · intro b hb hne
        rw [horth, if_neg, map_zero, mul_zero]
        intro hd
        apply hne
        have hb' := Finset.mem_range.mp hb
        have := Int.eq_zero_of_abs_lt_dvd hd (by
          rw [abs_lt]; constructor <;> omega)
        omega
    rw [key2, key3] at key
    have : g a' = g a' * t a' * C ((ℓ ^ k : ℕ) : L) * (t (-(a' : ℤ)) * C (((ℓ ^ k : ℕ) : L)⁻¹)) := by
      calc g a' = g a' * (t a' * t (-(a' : ℤ))) * (C ((ℓ ^ k : ℕ) : L) * C (((ℓ ^ k : ℕ) : L)⁻¹)) := by
            rw [hinv, ← map_mul, mul_inv_cancel₀ hnL, map_one, mul_one, mul_one]
        _ = _ := by ring
    rw [this, key, zero_mul]

  have s6 : ∀ (k : ℕ) (f : LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))),
      (∀ z z' : ℤ_[ℓ], PadicInt.toZModPow k z = PadicInt.toZModPow k z' → f z = f z') →
      ∃ h : ℕ → AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)),
        f = ∑ a ∈ Finset.range (ℓ ^ k),
          (LocallyConstant.constRingHom : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
            LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))) (h a) *
          Ψ (AddMonoidAlgebra.single (Localization.mk (a : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ :
            Localization.Away (ℓ : ℤ)) 1) := by
    intro k f hf
    have horth := s2 (hζ k)
    have hnpos : 0 < ℓ ^ k := pow_pos (Fact.out : ℓ.Prime).pos k
    haveI : NeZero (ℓ ^ k) := ⟨hnpos.ne'⟩
    have hζ0 : ζ k ≠ 0 := (hζ k).ne_zero hnpos.ne'
    have hnL : ((ℓ ^ k : ℕ) : L) ≠ 0 := ((hζ k).neZero').out
    obtain ⟨C, hC⟩ : ∃ C : L →+* AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)),
        ∀ r, C r = AddMonoidAlgebra.single 0 r := ⟨AddMonoidAlgebra.singleZeroRingHom, fun _ => rfl⟩
    obtain ⟨t, ht⟩ : ∃ t : ℤ → AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)), ∀ a, t a =
        AddMonoidAlgebra.single (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) (1 : L) :=
      ⟨_, fun _ => rfl⟩
    have hfac : ∀ (a : ℤ) (r : L), AddMonoidAlgebra.single
        (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) r = C r * t a := by
      intro a r
      rw [hC, ht, AddMonoidAlgebra.single_mul_single, zero_add, mul_one]
    have hinv : ∀ a : ℤ, t a * t (-a) = 1 := by
      intro a
      rw [ht, ht, AddMonoidAlgebra.single_mul_single, Localization.add_mk_self, add_neg_cancel,
        Localization.mk_zero, mul_one, AddMonoidAlgebra.one_def]
    refine ⟨fun a => ∑ j ∈ Finset.range (ℓ ^ k),
      C (((ℓ ^ k : ℕ) : L)⁻¹ * ζ k ^ (-((a : ℤ) * (j : ℤ)))) * f ((j : ℕ) : ℤ_[ℓ]) * t (-(a : ℤ)), ?_⟩
    refine LocallyConstant.ext fun z => ?_
    have hsum : ∀ (F : ℕ → LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))),
        (∑ a ∈ Finset.range (ℓ ^ k), F a) z = ∑ a ∈ Finset.range (ℓ ^ k), F a z :=
      fun F => map_sum (LocallyConstant.evalRingHom z) F _
    rw [hsum]
    simp only [LocallyConstant.coe_mul, Pi.mul_apply, LocallyConstant.constRingHom_apply,
      LocallyConstant.coe_const, Function.const_apply, hΨ]
    simp only [mul_one, hfac]
    obtain ⟨v, hvdef⟩ : ∃ v : ℕ, v = (PadicInt.toZModPow k z).val := ⟨_, rfl⟩
    rw [← hvdef]
    have hv : v < ℓ ^ k := hvdef ▸ ZMod.val_lt _
    have step : ∀ a ∈ Finset.range (ℓ ^ k),
        (∑ j ∈ Finset.range (ℓ ^ k),
          C (((ℓ ^ k : ℕ) : L)⁻¹ * ζ k ^ (-((a : ℤ) * (j : ℤ)))) * f ((j : ℕ) : ℤ_[ℓ]) * t (-(a : ℤ))) *
          (C (ζ k ^ ((a : ℤ) * (v : ℤ))) * t a) =
        ∑ j ∈ Finset.range (ℓ ^ k), f ((j : ℕ) : ℤ_[ℓ]) *
          C (((ℓ ^ k : ℕ) : L)⁻¹ * ζ k ^ (((v : ℤ) - j) * (a : ℤ))) := by
      intro a _
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun j _ => ?_
      have e : ζ k ^ (((v : ℤ) - j) * (a : ℤ)) =
          ζ k ^ (-((a : ℤ) * (j : ℤ))) * ζ k ^ ((a : ℤ) * (v : ℤ)) := by
        rw [← zpow_add₀ hζ0]; congr 1; ring
      have e2 : t (-(a : ℤ)) * t a = 1 := by simpa using hinv (-(a : ℤ))
      rw [e]
      calc C (((ℓ ^ k : ℕ) : L)⁻¹ * ζ k ^ (-((a : ℤ) * (j : ℤ)))) * f ((j : ℕ) : ℤ_[ℓ]) * t (-(a : ℤ)) *
            (C (ζ k ^ ((a : ℤ) * (v : ℤ))) * t a)
          = f ((j : ℕ) : ℤ_[ℓ]) * (C (((ℓ ^ k : ℕ) : L)⁻¹ * ζ k ^ (-((a : ℤ) * (j : ℤ)))) *
              C (ζ k ^ ((a : ℤ) * (v : ℤ)))) * (t (-(a : ℤ)) * t a) := by ring
        _ = _ := by rw [e2, mul_one, ← map_mul, mul_assoc]
    have step2 : ∀ j ∈ Finset.range (ℓ ^ k),
        ∑ a ∈ Finset.range (ℓ ^ k), f ((j : ℕ) : ℤ_[ℓ]) *
          C (((ℓ ^ k : ℕ) : L)⁻¹ * ζ k ^ (((v : ℤ) - j) * (a : ℤ))) =
        f ((j : ℕ) : ℤ_[ℓ]) * C (((ℓ ^ k : ℕ) : L)⁻¹ *
          ∑ a ∈ Finset.range (ℓ ^ k), ζ k ^ (((v : ℤ) - j) * (a : ℤ))) := by
      intro j _
      rw [Finset.mul_sum, map_sum, Finset.mul_sum]
    rw [Finset.sum_congr rfl step, Finset.sum_comm, Finset.sum_congr rfl step2,
      Finset.sum_eq_single_of_mem v (Finset.mem_range.mpr hv)]
    · rw [horth, if_pos (by simp), inv_mul_cancel₀ hnL, map_one, mul_one]
      apply hf
      rw [map_natCast, hvdef, ZMod.natCast_zmod_val]
    · intro j hj hne
      rw [horth, if_neg, mul_zero, map_zero, mul_zero]
      intro hd
      apply hne
      have hj' := Finset.mem_range.mp hj
      have := Int.eq_zero_of_abs_lt_dvd hd (by
        rw [abs_lt]; constructor <;> omega)
      omega

  suffices H : ∀ [Algebra (AddMonoidAlgebra L ℤ) (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))],
      algebraMap (AddMonoidAlgebra L ℤ) (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) =
      AddMonoidAlgebra.mapDomainRingHom L (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom →
      IsPushout
      (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom))
      (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom))
      (CommRingCat.ofHom (LocallyConstant.constRingHom :
        AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
          LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))))
      (CommRingCat.ofHom Ψ) from
    @H (AddMonoidAlgebra.mapDomainRingHom L (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom).toAlgebra
      (RingHom.algebraMap_toAlgebra _)
  intro inst hA

  have s3 : ∀ (x : TensorProduct (AddMonoidAlgebra L ℤ) (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))
      (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))),
      ∃ k₀ : ℕ, ∀ K : ℕ, k₀ ≤ K → ∃ g : ℕ → AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)),
        x = ∑ b ∈ Finset.range (ℓ ^ K), g b ⊗ₜ[AddMonoidAlgebra L ℤ]
          AddMonoidAlgebra.single (Localization.mk (b : ℤ) ⟨(ℓ : ℤ) ^ K, K, rfl⟩ :
            Localization.Away (ℓ : ℤ)) (1 : L) := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero =>
      refine ⟨0, fun K _ => ⟨0, ?_⟩⟩
      simp
    | add x y hx hy =>
      obtain ⟨k₁, h₁⟩ := hx
      obtain ⟨k₂, h₂⟩ := hy
      refine ⟨max k₁ k₂, fun K hK => ?_⟩
      obtain ⟨g₁, hg₁⟩ := h₁ K (le_trans (le_max_left _ _) hK)
      obtain ⟨g₂, hg₂⟩ := h₂ K (le_trans (le_max_right _ _) hK)
      refine ⟨g₁ + g₂, ?_⟩
      rw [hg₁, hg₂, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun b _ => ?_
      rw [Pi.add_apply, TensorProduct.add_tmul]
    | tmul u v =>
      induction v using AddMonoidAlgebra.induction_linear with
      | zero =>
        refine ⟨0, fun K _ => ⟨0, ?_⟩⟩
        simp
      | add v w hv hw =>
        obtain ⟨k₁, h₁⟩ := hv
        obtain ⟨k₂, h₂⟩ := hw
        refine ⟨max k₁ k₂, fun K hK => ?_⟩
        obtain ⟨g₁, hg₁⟩ := h₁ K (le_trans (le_max_left _ _) hK)
        obtain ⟨g₂, hg₂⟩ := h₂ K (le_trans (le_max_right _ _) hK)
        refine ⟨g₁ + g₂, ?_⟩
        rw [TensorProduct.tmul_add, hg₁, hg₂, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun b _ => ?_
        rw [Pi.add_apply, TensorProduct.add_tmul]
      | single y c =>
        induction y using Localization.induction_on with
        | H p =>
          obtain ⟨a, s⟩ := p
          obtain ⟨k, hk⟩ := (Submonoid.mem_powers_iff _ _).mp s.2
          have hs : s = ⟨(ℓ : ℤ) ^ k, k, rfl⟩ := Subtype.ext hk.symm
          simp only
          rw [hs]
          refine ⟨k, fun K hK => ?_⟩
          have hKd : K = k + (K - k) := by omega
          have hN : (0 : ℤ) < (ℓ : ℤ) ^ K := pow_pos hℓpos _
          have h1 : (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) =
              (Localization.mk (a * (ℓ : ℤ) ^ (K - k)) ⟨(ℓ : ℤ) ^ K, K, rfl⟩ :
                Localization.Away (ℓ : ℤ)) := by
            rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
            refine ⟨1, ?_⟩
            simp only [OneMemClass.coe_one, one_mul]
            rw [hKd, pow_add, Nat.add_sub_cancel_left]
            ring
          obtain ⟨A, hAdef⟩ : ∃ A : ℤ, A = a * (ℓ : ℤ) ^ (K - k) := ⟨_, rfl⟩
          rw [← hAdef] at h1
          obtain ⟨b', hb'⟩ : ∃ b' : ℕ, b' = (A % (ℓ : ℤ) ^ K).toNat := ⟨_, rfl⟩
          have hb'nn : ((b' : ℕ) : ℤ) = A % (ℓ : ℤ) ^ K := by
            rw [hb']; exact Int.toNat_of_nonneg (Int.emod_nonneg _ hN.ne')
          have hb'lt : b' < ℓ ^ K := by
            have h : ((b' : ℕ) : ℤ) < ((ℓ ^ K : ℕ) : ℤ) := by
              rw [hb'nn]; push_cast; exact Int.emod_lt_of_pos A hN
            exact_mod_cast h
          have h2 : (Localization.mk A ⟨(ℓ : ℤ) ^ K, K, rfl⟩ : Localization.Away (ℓ : ℤ)) =
              Localization.mk (A / (ℓ : ℤ) ^ K) 1 +
                (Localization.mk (b' : ℤ) ⟨(ℓ : ℤ) ^ K, K, rfl⟩ : Localization.Away (ℓ : ℤ)) := by
            rw [Localization.add_mk, one_mul]
            congr 1
            simp only [OneMemClass.coe_one, one_mul]
            rw [hb'nn]
            exact (Int.emod_add_mul_ediv A _).symm
          have h3 : AddMonoidAlgebra.single
              (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c =
              (AddMonoidAlgebra.single (A / (ℓ : ℤ) ^ K) c : AddMonoidAlgebra L ℤ) •
                AddMonoidAlgebra.single (Localization.mk (b' : ℤ) ⟨(ℓ : ℤ) ^ K, K, rfl⟩ :
                  Localization.Away (ℓ : ℤ)) (1 : L) := by
            rw [Algebra.smul_def, hA, AddMonoidAlgebra.mapDomainRingHom_apply,
              AddMonoidAlgebra.mapDomain_single, AddMonoidAlgebra.single_mul_single, mul_one, h1, h2]
            congr 1
          have h4 : ∀ (r : AddMonoidAlgebra L ℤ) (w : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))),
              u ⊗ₜ[AddMonoidAlgebra L ℤ] (r • w) = (r • u) ⊗ₜ[AddMonoidAlgebra L ℤ] w :=
            fun r w => (TensorProduct.smul_tmul r u w).symm
          refine ⟨fun b => if b = b' then
            (AddMonoidAlgebra.single (A / (ℓ : ℤ) ^ K) c : AddMonoidAlgebra L ℤ) • u else 0, ?_⟩
          rw [h3, h4, Finset.sum_eq_single_of_mem b' (Finset.mem_range.mpr hb'lt)]
          · simp
          · intro b _ hne
            simp [hne]

  obtain ⟨Φ, hΦ⟩ : ∃ Φ : TensorProduct (AddMonoidAlgebra L ℤ) (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))
      (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) →+*
        LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))),
      ∀ a b : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)),
        Φ (a ⊗ₜ[AddMonoidAlgebra L ℤ] b) = LocallyConstant.constRingHom a * Ψ b := by
    have hc : ∀ r, (LocallyConstant.constRingHom : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
            LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))
          (algebraMap (AddMonoidAlgebra L ℤ) (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) r) =
        algebraMap (AddMonoidAlgebra L ℤ)
          (LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))) r := by
      intro r
      refine LocallyConstant.ext fun z => ?_
      rw [LocallyConstant.coe_algebraMap, Pi.algebraMap_apply, LocallyConstant.constRingHom_apply,
        LocallyConstant.coe_const, Function.const_apply]
    let fA : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →ₐ[AddMonoidAlgebra L ℤ]
        LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) :=
      { toRingHom := LocallyConstant.constRingHom
        commutes' := hc }
    let gA : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →ₐ[AddMonoidAlgebra L ℤ]
        LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) :=
      { toRingHom := Ψ
        commutes' := fun r => by
          rw [← hc r, hA]
          exact RingHom.congr_fun hcomm r }
    exact ⟨(Algebra.TensorProduct.productMap fA gA).toRingHom,
      fun a b => Algebra.TensorProduct.productMap_apply_tmul fA gA a b⟩
  have hinj : Function.Injective Φ := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    obtain ⟨k₀, hk⟩ := s3 x
    obtain ⟨g, hg⟩ := hk k₀ le_rfl
    have hz : ∀ b < ℓ ^ k₀, g b = 0 := by
      apply s4 k₀ g
      intro z
      have hsum : ∀ (F : ℕ → LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))),
          (∑ a ∈ Finset.range (ℓ ^ k₀), F a) z = ∑ a ∈ Finset.range (ℓ ^ k₀), F a z :=
        fun F => map_sum (LocallyConstant.evalRingHom z) F _
      have h0 : (Φ x) z = 0 := by rw [hx]; rfl
      rw [hg, map_sum, hsum] at h0
      refine Eq.trans ?_ h0
      refine Finset.sum_congr rfl fun b _ => ?_
      rw [hΦ]
      simp only [LocallyConstant.coe_mul, Pi.mul_apply, LocallyConstant.constRingHom_apply,
        LocallyConstant.coe_const, Function.const_apply, hΨ]
    rw [hg]
    exact Finset.sum_eq_zero fun b hb => by
      rw [hz b (Finset.mem_range.mp hb), TensorProduct.zero_tmul]
  have hsurj : Function.Surjective Φ := by
    intro f
    obtain ⟨k, hk⟩ := s5 f
    obtain ⟨h, hh⟩ := s6 k f hk
    refine ⟨∑ a ∈ Finset.range (ℓ ^ k), h a ⊗ₜ[AddMonoidAlgebra L ℤ]
      AddMonoidAlgebra.single (Localization.mk (a : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ :
        Localization.Away (ℓ : ℤ)) (1 : L), ?_⟩
    rw [map_sum, hh]
    exact Finset.sum_congr rfl fun a _ => hΦ _ _
  have HP := @s7 (AddMonoidAlgebra L ℤ) (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))
    (LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))) _ _ _ _
    LocallyConstant.constRingHom Ψ Φ hΦ ⟨hinj, hsurj⟩
  rw [hA] at HP
  exact HP

theorem wc_qmtm_tt_psi_shift {L : Type u} [Field L] {ℓ : ℕ} [Fact (Nat.Prime ℓ)] (ζ : ℕ → L)
    (hζ : ∀ k, IsPrimitiveRoot (ζ k) (ℓ ^ k))
    (χ : Multiplicative (Localization.Away (ℓ : ℤ)) →* Lˣ)
    (hχ : ∀ (a : ℤ) (k : ℕ), ((χ (Multiplicative.ofAdd
      (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))) : Lˣ) : L) = ζ k ^ a)
    (γR : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
      AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))
    (hγR : ∀ (x : Localization.Away (ℓ : ℤ)) (c : L), γR (AddMonoidAlgebra.single x c) =
      AddMonoidAlgebra.single x (((χ (Multiplicative.ofAdd x) : Lˣ) : L) * c))
    (Ψ : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
      LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))
    (hΨ : ∀ (a : ℤ) (k : ℕ) (c : L) (z : ℤ_[ℓ]),
      Ψ (AddMonoidAlgebra.single (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c) z =
        AddMonoidAlgebra.single (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))
          (ζ k ^ (a * ((PadicInt.toZModPow k z).val : ℤ)) * c)) :
    Ψ.comp γR = (LocallyConstant.comapRingHom (ContinuousMap.addRight (1 : ℤ_[ℓ]))).comp Ψ :=
by
  classical
  have hℓ : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero
  have key : ∀ (a : ℤ) (k : ℕ) (z : ℤ_[ℓ]),
      ζ k ^ (a * ((PadicInt.toZModPow k (z + 1)).val : ℤ)) =
        ζ k ^ (a * ((PadicInt.toZModPow k z).val : ℤ)) * ζ k ^ a := by
    intro a k z
    have : NeZero (ℓ ^ k) := ⟨pow_ne_zero k hℓ⟩
    have hne : ζ k ≠ 0 := (hζ k).ne_zero (pow_ne_zero k hℓ)
    have hD : ((ℓ ^ k : ℕ) : ℤ) ∣ (((PadicInt.toZModPow k (z + 1)).val : ℤ) -
        ((PadicInt.toZModPow k z).val : ℤ) - 1) := by
      rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
      push_cast
      rw [ZMod.natCast_zmod_val, ZMod.natCast_zmod_val, map_add, map_one]
      ring
    have he : ζ k ^ (a * (((PadicInt.toZModPow k (z + 1)).val : ℤ) -
        ((PadicInt.toZModPow k z).val : ℤ) - 1)) = 1 :=
      ((hζ k).zpow_eq_one_iff_dvd _).mpr (hD.mul_left a)
    have hring : a * ((PadicInt.toZModPow k (z + 1)).val : ℤ) =
        (a * ((PadicInt.toZModPow k z).val : ℤ) + a) +
          a * (((PadicInt.toZModPow k (z + 1)).val : ℤ) - ((PadicInt.toZModPow k z).val : ℤ) - 1) := by
      ring
    rw [hring, zpow_add₀ hne, he, mul_one, zpow_add₀ hne]
  have gen : ∀ (x : Localization.Away (ℓ : ℤ)) (c : L),
      (Ψ.comp γR) (AddMonoidAlgebra.single x c) =
        ((LocallyConstant.comapRingHom (ContinuousMap.addRight (1 : ℤ_[ℓ]))).comp Ψ)
          (AddMonoidAlgebra.single x c) := by
    intro x c
    induction x using Localization.induction_on with
    | H p =>
      obtain ⟨a, s, hs⟩ := p
      obtain ⟨k, rfl⟩ := hs
      refine LocallyConstant.ext fun z => ?_
      rw [RingHom.comp_apply, RingHom.comp_apply, hγR, hχ a k, hΨ]
      change _ = (Ψ (AddMonoidAlgebra.single _ c)) (z + 1)
      rw [hΨ, key, mul_assoc]
  exact AddMonoidAlgebra.ringHom_ext (fun r => gen 0 r) (fun m => gen m 1)

theorem wc_qmtm_tt_lc_pullback_homeo {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {R : Type u} [CommRing R]
    {Y : Scheme.{u}} (y : Y ⟶ Spec (.of R))
    (π₀ : C(PrimeSpectrum (LocallyConstant ℤ_[ℓ] R), ℤ_[ℓ]))
    (hπ₀ : ∀ (U : Set ℤ_[ℓ]) (hU : IsClopen U) (q : PrimeSpectrum (LocallyConstant ℤ_[ℓ] R)),
      π₀ q ∈ U ↔ q ∈ PrimeSpectrum.basicOpen (LocallyConstant.charFn R hU)) :
    ∃ Θ : ↥(Limits.pullback y (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : R →+* LocallyConstant ℤ_[ℓ] R)))) ≃ₜ ↥Y × ℤ_[ℓ],
      ∀ x, Θ x = (Limits.pullback.fst y (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : R →+* LocallyConstant ℤ_[ℓ] R))) x,
        π₀ (Limits.pullback.snd y (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : R →+* LocallyConstant ℤ_[ℓ] R))) x)) :=
by
  classical

  have s1 : ∀ {A : Type u} [CommRing A] (πA : C(PrimeSpectrum (LocallyConstant ℤ_[ℓ] A), ℤ_[ℓ])),
      (∀ (U : Set ℤ_[ℓ]) (hU : IsClopen U) (q : PrimeSpectrum (LocallyConstant ℤ_[ℓ] A)),
        πA q ∈ U ↔ q ∈ PrimeSpectrum.basicOpen (LocallyConstant.charFn A hU)) →
      ∃ e : PrimeSpectrum (LocallyConstant ℤ_[ℓ] A) ≃ₜ PrimeSpectrum A × ℤ_[ℓ],
        ∀ q, e q = (PrimeSpectrum.comap
          (LocallyConstant.constRingHom : A →+* LocallyConstant ℤ_[ℓ] A) q, πA q) := by
    intro A _ πA hπA
    let c : A →+* LocallyConstant ℤ_[ℓ] A := LocallyConstant.constRingHom
    let ev : ℤ_[ℓ] → (LocallyConstant ℤ_[ℓ] A →+* A) := fun z => LocallyConstant.evalRingHom z
    let F : PrimeSpectrum (LocallyConstant ℤ_[ℓ] A) → PrimeSpectrum A × ℤ_[ℓ] :=
      fun q => (PrimeSpectrum.comap c q, πA q)
    let G : PrimeSpectrum A × ℤ_[ℓ] → PrimeSpectrum (LocallyConstant ℤ_[ℓ] A) :=
      fun pz => PrimeSpectrum.comap (ev pz.2) pz.1
    have hFG : ∀ pz, F (G pz) = pz := by
      rintro ⟨p, z⟩
      refine Prod.ext ?_ ?_
      · ext a
        exact Iff.rfl
      · show πA (G (p, z)) = z
        by_contra hne
        obtain ⟨U, hU, h1, h2⟩ := exists_isClopen_of_totally_separated hne
        have k := (hπA U hU (G (p, z))).mp h1
        rw [PrimeSpectrum.mem_basicOpen] at k
        apply k
        show (LocallyConstant.charFn A hU) z ∈ p.asIdeal
        rw [LocallyConstant.coe_charFn, Set.indicator_of_notMem h2]
        exact p.asIdeal.zero_mem
    have hGF : ∀ q, G (F q) = q := by
      intro q
      ext f
      show c (f (πA q)) ∈ q.asIdeal ↔ f ∈ q.asIdeal
      have hW : IsClopen {w | f w = f (πA q)} :=
        IsLocallyConstant.isClopen_fiber f.isLocallyConstant (f (πA q))
      have hχ : LocallyConstant.charFn A hW ∉ q.asIdeal := (hπA _ hW q).mp rfl
      have hzero : (f - c (f (πA q))) * LocallyConstant.charFn A hW = 0 := by
        ext w
        show (f w - f (πA q)) * (LocallyConstant.charFn A hW) w = 0
        rw [LocallyConstant.coe_charFn]
        by_cases hw : f w = f (πA q)
        · rw [hw, sub_self, zero_mul]
        · rw [Set.indicator_of_notMem (show w ∉ {w | f w = f (πA q)} from hw), mul_zero]
      have hmem : f - c (f (πA q)) ∈ q.asIdeal := by
        have h0 : (f - c (f (πA q))) * LocallyConstant.charFn A hW ∈ q.asIdeal := by
          rw [hzero]; exact q.asIdeal.zero_mem
        exact (q.isPrime.mem_or_mem h0).resolve_right hχ
      constructor
      · intro h
        have := q.asIdeal.add_mem hmem h
        rwa [sub_add_cancel] at this
      · intro h
        have := q.asIdeal.sub_mem h hmem
        rwa [sub_sub_cancel] at this
    have hFc : Continuous F := (PrimeSpectrum.continuous_comap c).prodMk πA.continuous
    have hGc : Continuous G := by
      rw [PrimeSpectrum.isTopologicalBasis_basic_opens.continuous_iff]
      rintro _ ⟨f, rfl⟩
      rw [isOpen_iff_forall_mem_open]
      rintro ⟨p, z⟩ hpz
      refine ⟨(PrimeSpectrum.basicOpen (f z) : Set (PrimeSpectrum A)) ×ˢ {w | f w = f z},
        ?_, ?_, ?_⟩
      · rintro ⟨p', w⟩ ⟨h1, h2⟩
        show f w ∉ p'.asIdeal
        rw [show f w = f z from h2]
        exact h1
      · exact (PrimeSpectrum.basicOpen (f z)).isOpen.prod
          (IsLocallyConstant.isOpen_fiber f.isLocallyConstant (f z))
      · exact ⟨hpz, rfl⟩
    let e : PrimeSpectrum (LocallyConstant ℤ_[ℓ] A) ≃ₜ PrimeSpectrum A × ℤ_[ℓ] :=
      { toFun := F, invFun := G, left_inv := hGF, right_inv := hFG,
        continuous_toFun := hFc, continuous_invFun := hGc }
    exact ⟨e, fun q => rfl⟩

  have s2 : ∀ {A : Type u} [CommRing A] (φ : R →+* A),
      IsPushout (CommRingCat.ofHom (LocallyConstant.constRingHom :
          R →+* LocallyConstant ℤ_[ℓ] R))
        (CommRingCat.ofHom φ)
        (CommRingCat.ofHom (LocallyConstant.mapRingHom φ :
          LocallyConstant ℤ_[ℓ] R →+* LocallyConstant ℤ_[ℓ] A))
        (CommRingCat.ofHom (LocallyConstant.constRingHom :
          A →+* LocallyConstant ℤ_[ℓ] A)) := by
    intro A _ φ
    letI : Algebra R A := φ.toAlgebra
    let mA : LocallyConstant ℤ_[ℓ] R →ₐ[R] LocallyConstant ℤ_[ℓ] A :=
      { LocallyConstant.mapRingHom φ with
        commutes' := fun r => by ext z; rfl }
    let kA : A →ₐ[R] LocallyConstant ℤ_[ℓ] A :=
      { (LocallyConstant.constRingHom : A →+* LocallyConstant ℤ_[ℓ] A) with
        commutes' := fun r => by ext z; rfl }
    let Φ := Algebra.TensorProduct.productMap mA kA
    have hΦ : ∀ (f : LocallyConstant ℤ_[ℓ] R) (a : A) (z : ℤ_[ℓ]),
        Φ (TensorProduct.tmul R f a) z = φ (f z) * a := by
      intro f a z
      rw [Algebra.TensorProduct.productMap_apply_tmul]
      rfl
    have hevA : ∀ {ι : Type u} (s : Finset ι) (F : ι → LocallyConstant ℤ_[ℓ] A) (z : ℤ_[ℓ]),
        (∑ i ∈ s, F i) z = ∑ i ∈ s, F i z := fun s F z =>
      map_sum (LocallyConstant.evalRingHom z) F s
    have hevR : ∀ {ι : Type u} (s : Finset ι) (F : ι → LocallyConstant ℤ_[ℓ] R) (z : ℤ_[ℓ]),
        (∑ i ∈ s, F i) z = ∑ i ∈ s, F i z := fun s F z =>
      map_sum (LocallyConstant.evalRingHom z) F s
    have hsurj : Function.Surjective Φ := by
      intro g
      let V := (LocallyConstant.range_finite g).toFinset
      let δ : A → LocallyConstant ℤ_[ℓ] R :=
        fun b => g.map (fun w => if w = b then (1 : R) else 0)
      refine ⟨∑ b ∈ V, TensorProduct.tmul R (δ b) b, ?_⟩
      rw [map_sum]
      ext z
      rw [hevA]
      simp only [hΦ]
      have hδ : ∀ b, φ (δ b z) * b = if g z = b then b else 0 := by
        intro b
        show φ (if g z = b then (1 : R) else 0) * b = _
        split_ifs <;> simp
      simp only [hδ]
      rw [Finset.sum_ite_eq]
      rw [if_pos ((Set.Finite.mem_toFinset _).mpr (Set.mem_range_self z))]
    have hinj : Function.Injective Φ := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨S, rfl⟩ := TensorProduct.exists_finset x
      let F : LocallyConstant ℤ_[ℓ] (S → R) := LocallyConstant.unflip (fun i : S => i.1.1)
      let V := (LocallyConstant.range_finite F).toFinset
      let χ : (S → R) → LocallyConstant ℤ_[ℓ] R :=
        fun v => F.map (fun w => if w = v then (1 : R) else 0)
      let b : (S → R) → A := fun v => ∑ i : S, φ (v i) * i.1.2
      have hFz : ∀ z, F z ∈ V := fun z =>
        (Set.Finite.mem_toFinset _).mpr (Set.mem_range_self z)
      have hf : ∀ i : S, i.1.1 = ∑ v ∈ V, (v i) • χ v := by
        intro i
        ext z
        rw [hevR]
        have hc : ∀ v, ((v i) • χ v) z = if F z = v then v i else 0 := by
          intro v
          show v i * (if F z = v then (1 : R) else 0) = _
          split_ifs <;> simp
        simp only [hc]
        rw [Finset.sum_ite_eq, if_pos (hFz z)]
        rfl
      have hx' : ∑ i ∈ S, TensorProduct.tmul R i.1 i.2 =
          ∑ v ∈ V, TensorProduct.tmul R (χ v) (b v) := by
        rw [← Finset.sum_coe_sort S]
        have e1 : ∀ i : S, TensorProduct.tmul R i.1.1 i.1.2 =
            ∑ v ∈ V, TensorProduct.tmul R (χ v) (φ (v i) * i.1.2) := by
          intro i
          conv_lhs => rw [hf i]
          rw [TensorProduct.sum_tmul]
          refine Finset.sum_congr rfl fun v _ => ?_
          rw [TensorProduct.smul_tmul, Algebra.smul_def]
          rfl
        simp only [e1]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun v _ => ?_
        rw [← TensorProduct.tmul_sum]
      rw [hx'] at hx ⊢
      have hb : ∀ v ∈ V, b v = 0 := by
        intro v hv
        obtain ⟨z, hz⟩ := (Set.Finite.mem_toFinset _).mp hv
        have h := congrArg (fun g : LocallyConstant ℤ_[ℓ] A => g z) hx
        simp only [map_sum] at h
        rw [hevA] at h
        simp only [hΦ] at h
        have hc : ∀ v', φ (χ v' z) * b v' = if F z = v' then b v' else 0 := by
          intro v'
          show φ (if F z = v' then (1 : R) else 0) * b v' = _
          split_ifs <;> simp
        simp only [hc] at h
        rw [Finset.sum_ite_eq, if_pos (hFz z), hz] at h
        exact h
      exact Finset.sum_eq_zero fun v hv => by rw [hb v hv, TensorProduct.tmul_zero]
    let ε : TensorProduct R (LocallyConstant ℤ_[ℓ] R) A ≃+* LocallyConstant ℤ_[ℓ] A :=
      RingEquiv.ofBijective Φ ⟨hinj, hsurj⟩
    refine IsPushout.of_iso
      (CommRingCat.isPushout_tensorProduct R (LocallyConstant ℤ_[ℓ] R) A)
      (Iso.refl _) (Iso.refl _) (Iso.refl _) ε.toCommRingCatIso ?_ ?_ ?_ ?_
    · rfl
    · rfl
    · ext f z
      show Φ (TensorProduct.tmul R f 1) z = φ (f z)
      rw [hΦ, mul_one]
    · ext a z
      show Φ (TensorProduct.tmul R 1 a) z = a
      rw [hΦ]
      show φ 1 * a = a
      rw [map_one, one_mul]

  generalize hC : Spec.map (CommRingCat.ofHom
    (LocallyConstant.constRingHom : R →+* LocallyConstant ℤ_[ℓ] R)) = C

  have hloc : ∀ p : ↥Y, ∃ (A : Type u) (_ : CommRing A) (j : Spec (CommRingCat.of A) ⟶ Y)
      (ι : Spec (CommRingCat.of (LocallyConstant ℤ_[ℓ] A)) ⟶ Limits.pullback y C)
      (e : PrimeSpectrum (LocallyConstant ℤ_[ℓ] A) ≃ₜ PrimeSpectrum A × ℤ_[ℓ]),
      Topology.IsOpenEmbedding j ∧ p ∈ Set.range j ∧
      (∀ s, (Limits.pullback.fst y C (ι s), π₀ (Limits.pullback.snd y C (ι s))) =
        (j (e s).1, (e s).2)) ∧
      ∀ x, Limits.pullback.fst y C x ∈ Set.range j → x ∈ Set.range ι := by
    intro p
    obtain ⟨U, hU, hpU, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      (Scheme.isBasis_affineOpens Y)) (show p ∈ (⊤ : Y.Opens) from trivial)
    have hU' : IsAffineOpen U := hU
    haveI := hU'.isOpenImmersion_fromSpec
    obtain ⟨φ', hφ'⟩ : ∃ φ' : R →+* Γ(Y, U),
        Spec.map (CommRingCat.ofHom φ') = hU'.fromSpec ≫ y :=
      ⟨(Spec.preimage (hU'.fromSpec ≫ y)).hom, Spec.map_preimage _⟩
    have S := isPullback_SpecMap_of_isPushout _ _ _ _ (s2 φ')
    obtain ⟨ι, hι1, hι2⟩ : ∃ ι : Spec (CommRingCat.of (LocallyConstant ℤ_[ℓ] Γ(Y, U))) ⟶
        Limits.pullback y C,
        ι ≫ Limits.pullback.fst y C = Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : Γ(Y, U) →+* LocallyConstant ℤ_[ℓ] Γ(Y, U))) ≫
            hU'.fromSpec ∧
        ι ≫ Limits.pullback.snd y C = Spec.map (CommRingCat.ofHom
          (LocallyConstant.mapRingHom φ')) :=
      ⟨Limits.pullback.lift (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : Γ(Y, U) →+* LocallyConstant ℤ_[ℓ] Γ(Y, U))) ≫
            hU'.fromSpec)
        (Spec.map (CommRingCat.ofHom (LocallyConstant.mapRingHom φ')))
        (by rw [Category.assoc, ← hφ', ← hC]; exact S.w.symm),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have H : IsPullback ι (Spec.map (CommRingCat.ofHom
        (LocallyConstant.constRingHom : Γ(Y, U) →+* LocallyConstant ℤ_[ℓ] Γ(Y, U))))
        (Limits.pullback.fst y C) hU'.fromSpec :=
      IsPullback.of_right (by rw [hι2, ← hφ', ← hC]; exact S) hι1
        (IsPullback.of_hasPullback y C).flip
    have hfib : ∀ x, Limits.pullback.fst y C x ∈ Set.range hU'.fromSpec →
        x ∈ Set.range ι := by
      rintro x ⟨a, ha⟩
      obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback
        (f := Limits.pullback.fst y C) (g := hU'.fromSpec) x a ha.symm
      exact ⟨H.isoPullback.inv w, by
        rw [← Scheme.Hom.comp_apply, H.isoPullback_inv_fst, hw1]⟩
    let πΓ : C(PrimeSpectrum (LocallyConstant ℤ_[ℓ] Γ(Y, U)), ℤ_[ℓ]) :=
      π₀.comp ⟨PrimeSpectrum.comap (LocallyConstant.mapRingHom φ'),
        PrimeSpectrum.continuous_comap _⟩
    have hψc : ∀ (V : Set ℤ_[ℓ]) (hV : IsClopen V),
        LocallyConstant.mapRingHom φ' (LocallyConstant.charFn R hV) =
          LocallyConstant.charFn (Γ(Y, U)) hV := by
      intro V hV
      refine LocallyConstant.ext fun z => ?_
      show φ' ((LocallyConstant.charFn R hV) z) = (LocallyConstant.charFn (Γ(Y, U)) hV) z
      rw [LocallyConstant.coe_charFn, LocallyConstant.coe_charFn]
      by_cases hz : z ∈ V
      · simp [Set.indicator_of_mem hz]
      · simp [Set.indicator_of_notMem hz]
    have hπΓ : ∀ (V : Set ℤ_[ℓ]) (hV : IsClopen V)
        (q : PrimeSpectrum (LocallyConstant ℤ_[ℓ] Γ(Y, U))),
        πΓ q ∈ V ↔ q ∈ PrimeSpectrum.basicOpen (LocallyConstant.charFn (Γ(Y, U)) hV) := by
      intro V hV q
      show π₀ (PrimeSpectrum.comap (LocallyConstant.mapRingHom φ') q) ∈ V ↔ _
      rw [hπ₀ V hV, PrimeSpectrum.mem_basicOpen, PrimeSpectrum.mem_basicOpen,
        PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, hψc]
    obtain ⟨e, he⟩ := s1 πΓ hπΓ
    refine ⟨Γ(Y, U), inferInstance, hU'.fromSpec, ι, e, hU'.fromSpec.isOpenEmbedding,
      ?_, ?_, hfib⟩
    · rw [hU'.range_fromSpec]; exact hpU
    · intro s
      rw [he s]
      have h1 : Limits.pullback.fst y C (ι s) = hU'.fromSpec (Spec.map (CommRingCat.ofHom
          (LocallyConstant.constRingHom : Γ(Y, U) →+* LocallyConstant ℤ_[ℓ] Γ(Y, U))) s) := by
        rw [← Scheme.Hom.comp_apply, hι1, Scheme.Hom.comp_apply]
      have h2 : Limits.pullback.snd y C (ι s) =
          Spec.map (CommRingCat.ofHom (LocallyConstant.mapRingHom φ')) s := by
        rw [← Scheme.Hom.comp_apply, hι2]
      rw [h1, h2]
      rfl

  let Θ₀ : ↥(Limits.pullback y C) → ↥Y × ℤ_[ℓ] :=
    fun x => (Limits.pullback.fst y C x, π₀ (Limits.pullback.snd y C x))
  have hcont : Continuous Θ₀ :=
    (Limits.pullback.fst y C).continuous.prodMk
      (π₀.continuous.comp (Limits.pullback.snd y C).continuous)
  have hinj : Function.Injective Θ₀ := by
    intro x x' hxx
    obtain ⟨A, _, j, ι, e, hj, ⟨t, ht⟩, hΘι, hfib⟩ := hloc (Limits.pullback.fst y C x)
    have h1 : Limits.pullback.fst y C x = Limits.pullback.fst y C x' := congrArg Prod.fst hxx
    obtain ⟨s, hs⟩ := hfib x ⟨t, ht⟩
    obtain ⟨s', hs'⟩ := hfib x' ⟨t, ht.trans h1⟩
    have h2 : (j (e s).1, (e s).2) = (j (e s').1, (e s').2) := by
      rw [← hΘι s, ← hΘι s', hs, hs']; exact hxx
    simp only [Prod.mk.injEq] at h2
    obtain ⟨h2a, h2b⟩ := h2
    have h3 : e s = e s' := Prod.ext (hj.isEmbedding.injective h2a) h2b
    rw [← hs, ← hs', e.injective h3]
  have hsurj : Function.Surjective Θ₀ := by
    rintro ⟨p, k⟩
    obtain ⟨A, _, j, ι, e, hj, ⟨t, ht⟩, hΘι, hfib⟩ := hloc p
    let t' : PrimeSpectrum A := t
    refine ⟨ι (e.symm (t', k)), ?_⟩
    have h := hΘι (e.symm (t', k))
    rw [Homeomorph.apply_symm_apply] at h
    exact h.trans (Prod.ext ht rfl)
  have hopen : IsOpenMap Θ₀ := by
    intro W hW
    rw [isOpen_iff_forall_mem_open]
    rintro _ ⟨x, hxW, rfl⟩
    obtain ⟨A, _, j, ι, e, hj, ⟨t, ht⟩, hΘι, hfib⟩ := hloc (Limits.pullback.fst y C x)
    obtain ⟨s, hs⟩ := hfib x ⟨t, ht⟩
    refine ⟨Prod.map j id '' (e '' (ι ⁻¹' W)), ?_, ?_, ?_⟩
    · rintro _ ⟨_, ⟨s', hs'W, rfl⟩, rfl⟩
      exact ⟨ι s', hs'W, hΘι s'⟩
    · exact (hj.isOpenMap.prodMap IsOpenMap.id) _
        (e.isOpenMap _ (hW.preimage ι.continuous))
    · refine ⟨e s, ⟨s, ?_, rfl⟩, ?_⟩
      · show ι s ∈ W
        rw [hs]; exact hxW
      · rw [← hs]; exact (hΘι s).symm
  exact ⟨(Equiv.ofBijective Θ₀ ⟨hinj, hsurj⟩).toHomeomorphOfContinuousOpen hcont hopen,
    fun x => rfl⟩

theorem wc_qmtm_torsor_triv {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) {V : Scheme.{u}} (v : V ⟶ XE) (ρ : V ⟶ T.XEi)
    (hρ : ρ ≫ T.πi = v) :
    ∃ Θ : ↥(Limits.pullback v T.πi) ≃ₜ ↥V × ℤ_[ℓ],
      (∀ x, (Θ x).1 = (Limits.pullback.fst v T.πi) x) ∧
      ∀ κ : Limits.pullback v T.πi ⟶ Limits.pullback v T.πi,
        κ ≫ Limits.pullback.fst v T.πi = Limits.pullback.fst v T.πi →
        κ ≫ Limits.pullback.snd v T.πi = Limits.pullback.snd v T.πi ≫ T.γi →
        ∀ x, Θ (κ x) = ((Θ x).1, (Θ x).2 + 1) :=
by
  classical

  obtain ⟨Ψ, hΨ⟩ := wc_qmtm_tt_psi_exists T.ζ T.hζ T.hζc
  have HP := wc_qmtm_tt_psi_pushout T.ζ T.hζ T.hζc Ψ hΨ
  have hsh := wc_qmtm_tt_psi_shift T.ζ T.hζ T.χ T.hχ T.γR T.hγR Ψ hΨ

  obtain ⟨π0, hπ0⟩ := wc_lc_spec_pi0.{u} ℤ_[ℓ]
  let ψ : LocallyConstant ℤ_[ℓ] (ULift.{u} ℤ) →+*
      LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) :=
    LocallyConstant.mapRingHom
      ((Int.castRingHom (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))).comp
        ULift.ringEquiv.toRingHom)
  let π₀ : C(PrimeSpectrum (LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))),
      ℤ_[ℓ]) :=
    π0.comp ⟨PrimeSpectrum.comap ψ, PrimeSpectrum.continuous_comap ψ⟩
  have hψc : ∀ (U : Set ℤ_[ℓ]) (hU : IsClopen U),
      ψ (LocallyConstant.charFn (ULift.{u} ℤ) hU) =
        LocallyConstant.charFn (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) hU := by
    intro U hU
    refine LocallyConstant.ext fun z => ?_
    show ((Int.castRingHom (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))).comp
        ULift.ringEquiv.toRingHom) ((LocallyConstant.charFn (ULift.{u} ℤ) hU) z) =
      (LocallyConstant.charFn (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) hU) z
    rw [LocallyConstant.coe_charFn, LocallyConstant.coe_charFn]
    by_cases hz : z ∈ U
    · simp [Set.indicator_of_mem hz]
    · simp [Set.indicator_of_notMem hz]
  have hπ₀ : ∀ (U : Set ℤ_[ℓ]) (hU : IsClopen U)
      (q : PrimeSpectrum (LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))),
      π₀ q ∈ U ↔ q ∈ PrimeSpectrum.basicOpen
        (LocallyConstant.charFn (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) hU) := by
    intro U hU q
    show π0 (PrimeSpectrum.comap ψ q) ∈ U ↔ _
    rw [hπ0 U hU, PrimeSpectrum.mem_basicOpen, PrimeSpectrum.mem_basicOpen,
      PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, hψc]

  let sh : LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) →+*
      LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) :=
    LocallyConstant.comapRingHom (ContinuousMap.addRight (1 : ℤ_[ℓ]))
  have hshift : ∀ q, π₀ (PrimeSpectrum.comap sh q) = π₀ q + 1 := by
    intro q
    by_contra hne
    obtain ⟨U, hU, h1, h2⟩ := exists_isClopen_of_totally_separated hne
    have hU' : IsClopen ((fun z : ℤ_[ℓ] => z + 1) ⁻¹' U) :=
      hU.preimage (continuous_id.add continuous_const)
    have e1 : sh (LocallyConstant.charFn (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) hU) =
        LocallyConstant.charFn (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) hU' := by
      refine LocallyConstant.ext fun z => ?_
      show (LocallyConstant.charFn (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) hU) (z + 1) =
        (LocallyConstant.charFn (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) hU') z
      rw [LocallyConstant.coe_charFn, LocallyConstant.coe_charFn]
      simp only [Set.indicator_apply, Set.mem_preimage, Pi.one_apply]
    have k1 := hπ₀ U hU (PrimeSpectrum.comap sh q)
    have k2 := hπ₀ _ hU' q
    rw [PrimeSpectrum.mem_basicOpen, PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, e1] at k1
    rw [PrimeSpectrum.mem_basicOpen] at k2
    exact h2 (k2.mpr (k1.mp h1))

  have S3 := isPullback_SpecMap_of_isPushout _ _ _ _ HP

  have hw : (Limits.pullback.fst v T.πi ≫ ρ ≫ T.gi) ≫
      Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)) =
      (Limits.pullback.snd v T.πi ≫ T.gi) ≫
      Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)) := by
    simp only [Category.assoc]
    rw [← T.hT.w, reassoc_of% hρ, Limits.pullback.condition_assoc]
  let snd' := S3.lift _ _ hw
  have hL1 : snd' ≫ Spec.map (CommRingCat.ofHom (LocallyConstant.constRingHom :
        AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
          LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))) =
      Limits.pullback.fst v T.πi ≫ ρ ≫ T.gi := S3.lift_fst _ _ _
  have hL2 : snd' ≫ Spec.map (CommRingCat.ofHom Ψ) = Limits.pullback.snd v T.πi ≫ T.gi :=
    S3.lift_snd _ _ _

  have P1 := (IsPullback.of_hasPullback v T.πi).flip.paste_horiz T.hT.flip
  have P2 : IsPullback (snd' ≫ Spec.map (CommRingCat.ofHom Ψ)) (Limits.pullback.fst v T.πi)
      (Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)))
      ((ρ ≫ T.gi) ≫ Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom))) := by
    rw [hL2, Category.assoc, ← T.hT.w, reassoc_of% hρ]
    exact P1
  have S4 := IsPullback.of_right P2 hL1 S3.flip
  have H := S4.flip

  obtain ⟨Θ₁, hΘ₁⟩ := wc_qmtm_tt_lc_pullback_homeo (ρ ≫ T.gi) π₀ hπ₀
  let Θ := (Scheme.homeoOfIso H.isoPullback).trans Θ₁
  have hΘ : ∀ x, Θ x = (Limits.pullback.fst v T.πi x, π₀ (snd' x)) := by
    intro x
    rw [Homeomorph.trans_apply, Scheme.homeoOfIso_apply, hΘ₁, ← Scheme.Hom.comp_apply,
      ← Scheme.Hom.comp_apply, H.isoPullback_hom_fst, H.isoPullback_hom_snd]
  refine ⟨Θ, fun x => by rw [hΘ], ?_⟩

  intro κ hκ1 hκ2 x
  have hsc : Spec.map (CommRingCat.ofHom sh) ≫ Spec.map (CommRingCat.ofHom
      (LocallyConstant.constRingHom : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
          LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))) =
      Spec.map (CommRingCat.ofHom (LocallyConstant.constRingHom :
        AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
          LocallyConstant ℤ_[ℓ] (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    congr 2
  have hsΨ : Spec.map (CommRingCat.ofHom sh) ≫ Spec.map (CommRingCat.ofHom Ψ) =
      Spec.map (CommRingCat.ofHom Ψ) ≫ Spec.map (CommRingCat.ofHom T.γR) := by
    rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hsh]
  have hκ : κ ≫ snd' = snd' ≫ Spec.map (CommRingCat.ofHom sh) := by
    apply S3.hom_ext
    · rw [Category.assoc, Category.assoc, hsc, hL1, reassoc_of% hκ1]
    · rw [Category.assoc, Category.assoc, hsΨ, reassoc_of% hL2, hL2, reassoc_of% hκ2, T.hγg]
  have hp : snd' (κ x) = PrimeSpectrum.comap sh (snd' x) := by
    rw [← Scheme.Hom.comp_apply, hκ, Scheme.Hom.comp_apply]
    rfl
  have hf : Limits.pullback.fst v T.πi (κ x) = Limits.pullback.fst v T.πi x := by
    rw [← Scheme.Hom.comp_apply, hκ1]
  rw [hΘ, hΘ, hp, hf]
  exact Prod.ext rfl (hshift (snd' x))

theorem wc_qmtm_invariant_factor {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) {V : Scheme.{u}} (v : V ⟶ XE)
    (s : C(↥(Limits.pullback v T.πi), ULift.{u+1} ℚ_[ℓ]))
    (hs : ∀ κ : Limits.pullback v T.πi ⟶ Limits.pullback v T.πi,
      κ ≫ Limits.pullback.fst v T.πi = Limits.pullback.fst v T.πi →
      κ ≫ Limits.pullback.snd v T.πi = Limits.pullback.snd v T.πi ≫ T.γi →
      s.comp κ.base.hom = s) :
    ∃ t : C(↥V, ULift.{u+1} ℚ_[ℓ]), s = t.comp (Limits.pullback.fst v T.πi).base.hom :=
by
  classical
  obtain ⟨_, hsurj, huc, _⟩ := wc_qmtm_tower_pi_props T
  set fP := Limits.pullback.fst v T.πi with hfP
  set sP := Limits.pullback.snd v T.πi with hsP
  have hPw : fP ≫ v = sP ≫ T.πi := Limits.pullback.condition
  have hP : IsPullback fP sP v T.πi := IsPullback.of_hasPullback _ _
  have hsurjP : Surjective fP :=
    MorphismProperty.of_isPullback (P := @Surjective) hP.flip hsurj
  have hucP : UniversallyClosed fP :=
    MorphismProperty.of_isPullback (P := @UniversallyClosed) hP.flip huc

  obtain ⟨Θ, hΘ1, hΘ2⟩ := wc_qmtm_torsor_triv T (fP ≫ v) sP hPw.symm
  set fQ := Limits.pullback.fst (fP ≫ v) T.πi with hfQ
  set sQ := Limits.pullback.snd (fP ≫ v) T.πi with hsQ
  have hQw : fQ ≫ fP ≫ v = sQ ≫ T.πi := Limits.pullback.condition
  set r₁ := Limits.pullback.fst fP fP with hr₁
  set r₂ := Limits.pullback.snd fP fP with hr₂
  have hRw : r₁ ≫ fP = r₂ ≫ fP := Limits.pullback.condition

  let κP : Limits.pullback v T.πi ⟶ Limits.pullback v T.πi :=
    Limits.pullback.lift fP (sP ≫ T.γi) (by rw [Category.assoc, T.hγπ, hPw])
  have hκP1 : κP ≫ fP = fP := Limits.pullback.lift_fst _ _ _
  have hκP2 : κP ≫ sP = sP ≫ T.γi := Limits.pullback.lift_snd _ _ _
  have H1 : ∀ a, s (κP a) = s a := fun a => DFunLike.congr_fun (hs κP hκP1 hκP2) a

  let κQ : Limits.pullback (fP ≫ v) T.πi ⟶ Limits.pullback (fP ≫ v) T.πi :=
    Limits.pullback.lift fQ (sQ ≫ T.γi) (by rw [Category.assoc, T.hγπ, hQw])
  have hκQ1 : κQ ≫ fQ = fQ := Limits.pullback.lift_fst _ _ _
  have hκQ2 : κQ ≫ sQ = sQ ≫ T.γi := Limits.pullback.lift_snd _ _ _

  let m : Limits.pullback (fP ≫ v) T.πi ⟶ Limits.pullback v T.πi :=
    Limits.pullback.lift (fQ ≫ fP) sQ (by rw [Category.assoc, hQw])
  have hm1 : m ≫ fP = fQ ≫ fP := Limits.pullback.lift_fst _ _ _
  have hm2 : m ≫ sP = sQ := Limits.pullback.lift_snd _ _ _
  have H2 : κQ ≫ m = m ≫ κP := by
    apply Limits.pullback.hom_ext
    · change (κQ ≫ m) ≫ fP = (m ≫ κP) ≫ fP
      rw [Category.assoc, Category.assoc, hκP1, hm1, ← Category.assoc, hκQ1]
    · change (κQ ≫ m) ≫ sP = (m ≫ κP) ≫ sP
      rw [Category.assoc, Category.assoc, hκP2, hm2, ← Category.assoc, hm2, hκQ2]

  let d : Limits.pullback v T.πi ⟶ Limits.pullback (fP ≫ v) T.πi :=
    Limits.pullback.lift (𝟙 _) sP (by rw [Category.id_comp, hPw])
  have hd1 : d ≫ fQ = 𝟙 _ := Limits.pullback.lift_fst _ _ _
  have hd2 : d ≫ sQ = sP := Limits.pullback.lift_snd _ _ _
  have H4 : d ≫ m = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · change (d ≫ m) ≫ fP = 𝟙 _ ≫ fP
      rw [Category.assoc, hm1, ← Category.assoc, hd1]
    · change (d ≫ m) ≫ sP = 𝟙 _ ≫ sP
      rw [Category.assoc, hm2, hd2, Category.id_comp]

  let e : Limits.pullback fP fP ⟶ Limits.pullback (fP ≫ v) T.πi :=
    Limits.pullback.lift r₁ (r₂ ≫ sP) (by
      rw [← Category.assoc, hRw, Category.assoc, hPw, Category.assoc])
  have he1 : e ≫ fQ = r₁ := Limits.pullback.lift_fst _ _ _
  have he2 : e ≫ sQ = r₂ ≫ sP := Limits.pullback.lift_snd _ _ _
  have H6 : e ≫ m = r₂ := by
    apply Limits.pullback.hom_ext
    · change (e ≫ m) ≫ fP = r₂ ≫ fP
      rw [Category.assoc, hm1, ← Category.assoc, he1, hRw]
    · change (e ≫ m) ≫ sP = r₂ ≫ sP
      rw [Category.assoc, hm2, he2]

  have pH2 : ∀ y, m (κQ y) = κP (m y) := fun y => by
    rw [← Scheme.Hom.comp_apply, H2, Scheme.Hom.comp_apply]
  have pH3 : ∀ a, fQ (d a) = a := fun a => by
    rw [← Scheme.Hom.comp_apply, hd1]; rfl
  have pH4 : ∀ a, m (d a) = a := fun a => by
    rw [← Scheme.Hom.comp_apply, H4]; rfl

  have hg : ∀ (a : ↥(Limits.pullback v T.πi)) (z : ℤ_[ℓ]),
      s (m (Θ.symm (a, z))) = s (m (Θ.symm (a, 0))) := by
    intro a
    let g : ℤ_[ℓ] → ULift.{u+1} ℚ_[ℓ] := fun z => s (m (Θ.symm (a, z)))
    have hgc : Continuous g :=
      s.continuous.comp ((Scheme.Hom.continuous m).comp
        (Θ.symm.continuous.comp (Continuous.prodMk continuous_const continuous_id)))
    have hper : ∀ z, g (z + 1) = g z := by
      intro z
      have h1 : Θ (κQ (Θ.symm (a, z))) = (a, z + 1) := by
        rw [hΘ2 κQ hκQ1 hκQ2, Homeomorph.apply_symm_apply]
      have h2 : κQ (Θ.symm (a, z)) = Θ.symm (a, z + 1) := by
        rw [← h1, Homeomorph.symm_apply_apply]
      show s (m (Θ.symm (a, z + 1))) = s (m (Θ.symm (a, z)))
      rw [← h2, pH2, H1]
    have hnat : ∀ n : ℕ, g n = g 0 := by
      intro n
      induction n with
      | zero => rw [Nat.cast_zero]
      | succ n ih => rw [Nat.cast_succ, hper, ih]
    have heq : g = fun _ => g 0 :=
      PadicInt.denseRange_natCast.equalizer hgc continuous_const (funext fun n => hnat n)
    intro z
    exact congrFun heq z
  have hstar : ∀ y, s (m y) = s (m (Θ.symm (fQ y, 0))) := by
    intro y
    have hy : y = Θ.symm (fQ y, (Θ y).2) := by
      rw [← hΘ1 y, Prod.mk.eta, Homeomorph.symm_apply_apply]
    exact (congrArg (fun t => s (m t)) hy).trans (hg _ _)
  have hdiag : ∀ a, s a = s (m (Θ.symm (a, 0))) := by
    intro a
    have h := hstar (d a)
    rw [pH4 a, pH3 a] at h
    exact h
  have key : ∀ y, s (m y) = s (fQ y) := fun y => (hstar y).trans (hdiag (fQ y)).symm

  have hfib : ∀ x y, fP x = fP y → s x = s y := by
    intro x y hxy
    obtain ⟨z, hz1, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := fP) (g := fP) x y hxy
    have e1 : fQ (e z) = x := by rw [← Scheme.Hom.comp_apply, he1, hz1]
    have e2 : m (e z) = y := by rw [← Scheme.Hom.comp_apply, H6, hz2]
    rw [← e1, ← e2, key]

  haveI := hsurjP
  haveI := hucP
  have hq : Topology.IsQuotientMap ⇑fP.base.hom :=
    IsClosedMap.isQuotientMap (Scheme.Hom.isClosedMap fP) (Scheme.Hom.continuous fP)
      (Scheme.Hom.surjective fP)
  exact ⟨hq.lift s (fun a b hab => hfib a b hab), (hq.lift_comp s _).symm⟩

theorem wc_qmtm_gamma_local_epi {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (Dπ : wcHMPullData T.πi ℓ)
    (γN : wcSuppObj Dπ ⟶ wcSuppObj Dπ) (hγs : wcQmtmGammaSec T Dπ γN)
    (U : XE.ProEt) (hU : IsAffine U.left) (s : (wcSuppObj Dπ).val.obj (Opposite.op U)) :
    ∃ (V : XE.ProEt) (h : V ⟶ U) (G : (wcSuppObj Dπ).val.obj (Opposite.op V)),
      IsAffine V.left ∧ Surjective h.left ∧
      ((γN - 𝟙 (wcSuppObj Dπ)).val.app (Opposite.op V)).hom G =
        ((wcSuppObj Dπ).val.map h.op).hom s :=
by
  classical
  have hM : ∀ (X : Type u) [TopologicalSpace X] [CompactSpace X] (f : C(X × ℤ_[ℓ], ℚ_[ℓ])),
      ∃ G : C(X × ℤ_[ℓ], ℚ_[ℓ]), ∀ (x : X) (z : ℤ_[ℓ]), G (x, z + 1) - G (x, z) = f (x, z) := by
    intro X _ _ f
    haveI : IsBoundedSMul ℤ_[ℓ] C(X, ℚ_[ℓ]) := by
      refine IsBoundedSMul.of_norm_smul_le fun r g => ?_
      refine (ContinuousMap.norm_le _ (by positivity)).2 fun x => ?_
      have e : (r • g) x = (r : ℚ_[ℓ]) * g x := rfl
      rw [e, norm_mul, PadicInt.norm_def]
      exact mul_le_mul_of_nonneg_left (ContinuousMap.norm_coe_le_norm g x) (norm_nonneg _)
    let F : C(ℤ_[ℓ], C(X, ℚ_[ℓ])) := (f.comp ContinuousMap.prodSwap).curry
    let a : ℕ → C(X, ℚ_[ℓ]) := fun n => (fwdDiff 1)^[n] (⇑F) 0
    have ha : Filter.Tendsto a Filter.atTop (nhds 0) := PadicInt.fwdDiff_tendsto_zero F
    let b : ℕ → C(X, ℚ_[ℓ]) := fun n => Nat.casesOn n 0 a
    have hb : Filter.Tendsto b Filter.atTop (nhds 0) := by
      rw [← Filter.tendsto_add_atTop_iff_nat 1]
      exact ha
    let H : C(ℤ_[ℓ], C(X, ℚ_[ℓ])) := PadicInt.mahlerSeries b
    let D : C(ℤ_[ℓ], C(X, ℚ_[ℓ])) := H.comp (ContinuousMap.addRight 1) - H
    have hD : ⇑D = fwdDiff 1 ⇑H := by
      funext z
      rfl
    have hDF : D = F := by
      apply (PadicInt.mahlerEquiv (C(X, ℚ_[ℓ]))).injective
      ext1 n
      rw [PadicInt.mahlerEquiv_apply, PadicInt.mahlerEquiv_apply]
      show (fwdDiff 1)^[n] (⇑D) 0 = a n
      rw [hD, ← Function.iterate_succ_apply, PadicInt.fwdDiff_mahlerSeries hb]
    refine ⟨⟨fun y => H y.2 y.1, ?_⟩, ?_⟩
    · exact continuous_eval.comp ((H.continuous.comp continuous_snd).prodMk continuous_fst)
    · intro x z
      have := congrArg (fun K : C(ℤ_[ℓ], C(X, ℚ_[ℓ])) => K z x) hDF
      simpa [D, F] using this
  obtain ⟨hAff, hSurj, -, hWE⟩ := wc_qmtm_tower_pi_props T
  haveI hW : WeaklyEtale (Limits.pullback.fst U.hom T.πi) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale)
      (IsPullback.of_hasPullback U.hom T.πi).flip hWE
  haveI : WeaklyEtale U.hom := U.prop
  haveI : WeaklyEtale (Limits.pullback.fst U.hom T.πi ≫ U.hom) := inferInstance
  let V : XE.ProEt := Scheme.ProEt.mk (Limits.pullback.fst U.hom T.πi ≫ U.hom)
  let h : V ⟶ U := MorphismProperty.Over.homMk (A := V) (B := U)
    (Limits.pullback.fst U.hom T.πi) rfl trivial
  haveI : IsAffineHom (Limits.pullback.fst U.hom T.πi) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback U.hom T.πi).flip hAff
  haveI : IsAffine U.left := hU
  have hPaff : IsAffine (Limits.pullback U.hom T.πi) :=
    @isAffine_of_isAffineHom _ _ (Limits.pullback.fst U.hom T.πi) _ hU
  have hVaff : IsAffine V.left := hPaff
  have hhs : Surjective h.left :=
    MorphismProperty.of_isPullback (P := @Surjective)
      (IsPullback.of_hasPullback U.hom T.πi).flip hSurj
  have hρ : Limits.pullback.snd U.hom T.πi ≫ T.πi = V.hom := (Limits.pullback.condition).symm
  obtain ⟨Θ, -, hΘκ⟩ := wc_qmtm_torsor_triv T V.hom (Limits.pullback.snd U.hom T.πi) hρ
  have hκw : Limits.pullback.fst V.hom T.πi ≫ V.hom =
      (Limits.pullback.snd V.hom T.πi ≫ T.γi) ≫ T.πi := by
    rw [Category.assoc, T.hγπ, Limits.pullback.condition]
  let κ : Limits.pullback V.hom T.πi ⟶ Limits.pullback V.hom T.πi :=
    Limits.pullback.lift _ _ hκw
  have hκ1 : κ ≫ Limits.pullback.fst V.hom T.πi = Limits.pullback.fst V.hom T.πi :=
    Limits.pullback.lift_fst _ _ _
  have hκ2 : κ ≫ Limits.pullback.snd V.hom T.πi = Limits.pullback.snd V.hom T.πi ≫ T.γi :=
    Limits.pullback.lift_snd _ _ _
  have hΘk := hΘκ κ hκ1 hκ2
  let r : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) :=
    ((wcSuppObj Dπ).val.map h.op).hom s
  haveI : CompactSpace ↥V.left := inferInstance
  let f : C(↥V.left × ℤ_[ℓ], ℚ_[ℓ]) :=
    ⟨fun y => (r (Θ.symm y)).down,
      continuous_uliftDown.comp (r.continuous.comp Θ.symm.continuous)⟩
  obtain ⟨G₀, hG₀⟩ := hM ↥V.left f
  let Gc : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) :=
    ⟨fun y => ULift.up (G₀ (Θ y)), continuous_uliftUp.comp (G₀.continuous.comp Θ.continuous)⟩
  let G : (wcSuppObj Dπ).val.obj (Opposite.op V) := Gc
  refine ⟨V, h, G, hVaff, hhs, ?_⟩
  have hsub : ((γN - 𝟙 (wcSuppObj Dπ)).val.app (Opposite.op V)).hom G =
      (γN.val.app (Opposite.op V)).hom G - G := rfl
  have h2 := hγs V Gc κ hκ1 hκ2
  rw [hsub]
  have key : Gc.comp κ.base.hom - Gc = r := by
    refine ContinuousMap.ext fun y => ?_
    apply ULift.ext
    rw [ContinuousMap.sub_apply, ULift.sub_down, ContinuousMap.comp_apply]
    have e1 : Gc (κ.base.hom y) = ULift.up (G₀ ((Θ y).1, (Θ y).2 + 1)) := by
      show ULift.up (G₀ (Θ (κ y))) = _
      rw [hΘk y]
    rw [e1]
    show G₀ ((Θ y).1, (Θ y).2 + 1) - G₀ ((Θ y).1, (Θ y).2) = (r y).down
    rw [hG₀ (Θ y).1 (Θ y).2]
    show (r (Θ.symm ((Θ y).1, (Θ y).2))).down = (r y).down
    rw [Prod.mk.eta, Homeomorph.symm_apply_apply]
  let γG : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) :=
    (γN.val.app (Opposite.op V)).hom G
  have h3 : γG = Gc.comp κ.base.hom := h2
  have h4 : γG - Gc = r := by
    rw [h3]
    exact key
  exact h4

theorem wc_qmtm_torsor_ses {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (Dπ : wcHMPullData T.πi ℓ) (hDπ : wcHMPullCanonical Dπ)
    (γN : wcSuppObj Dπ ⟶ wcSuppObj Dπ) (hγs : wcQmtmGammaSec T Dπ γN)
    (hz : wcSuppUnitMap Dπ ≫ (γN - 𝟙 (wcSuppObj Dπ)) = 0) :
    (ShortComplex.mk (wcSuppUnitMap Dπ) (γN - 𝟙 (wcSuppObj Dπ)) hz).ShortExact :=
by
  classical
  obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit Dπ
  obtain ⟨_, hsurjπ, _, _⟩ := wc_qmtm_tower_pi_props T
  have hsub : ∀ (V : XE.ProEt) (z : (wcSuppObj Dπ).val.obj (Opposite.op V)),
      ((γN - 𝟙 (wcSuppObj Dπ)).val.app (Opposite.op V)).hom z =
        (γN.val.app (Opposite.op V)).hom z - z := fun V z => rfl
  refine wc_qmtm_ses_of_sections _ _ hz ?_ ?_
    (fun U hU s => wc_qmtm_gamma_local_epi T Dπ γN hγs U hU s)
  ·
    intro V x hx
    have hf := wc_supp_hom_twist_formula Dπ hDπ (wcSuppUnitMap Dπ) V x
    have h0 : x.comp (Limits.pullback.fst V.hom T.πi).base.hom *
        (wcSuppTwist (wcSuppUnitMap Dπ)).comp (Limits.pullback.snd V.hom T.πi).base.hom = 0 := by
      have h := hf.symm.trans hx
      exact h
    have h1 : x.comp (Limits.pullback.fst V.hom T.πi).base.hom = 0 := by
      have h2 := congrArg (· * c'.comp (Limits.pullback.snd V.hom T.πi).base.hom) h0
      simp only [zero_mul] at h2
      rw [mul_assoc, ← ContinuousMap.mul_comp, hc', ContinuousMap.one_comp, mul_one] at h2
      exact h2
    haveI : Surjective (Limits.pullback.fst V.hom T.πi) :=
      MorphismProperty.of_isPullback (P := @Surjective)
        (IsPullback.of_hasPullback V.hom T.πi).flip hsurjπ
    refine ContinuousMap.ext fun z => ?_
    obtain ⟨y, hy⟩ := (Limits.pullback.fst V.hom T.πi).surjective z
    have h3 := DFunLike.congr_fun h1 y
    rw [← hy]
    exact h3
  ·
    intro V y hy
    rw [hsub] at hy
    have hyC : (γN.val.app (Opposite.op V)).hom y = y := sub_eq_zero.mp hy
    let yC : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) := y
    let b : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) :=
      (wcSuppTwist (wcSuppUnitMap Dπ)).comp (Limits.pullback.snd V.hom T.πi).base.hom
    let a : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) :=
      c'.comp (Limits.pullback.snd V.hom T.πi).base.hom
    have hab : b * a = 1 := by
      show (wcSuppTwist (wcSuppUnitMap Dπ)).comp (Limits.pullback.snd V.hom T.πi).base.hom *
        c'.comp (Limits.pullback.snd V.hom T.πi).base.hom = 1
      rw [← ContinuousMap.mul_comp, hc', ContinuousMap.one_comp]
    have hb := wc_supp_hom_twist_formula Dπ hDπ (wcSuppUnitMap Dπ) V
      (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))
    rw [ContinuousMap.one_comp, one_mul] at hb
    have hzV : ((γN - 𝟙 (wcSuppObj Dπ)).val.app (Opposite.op V)).hom
        (((wcSuppUnitMap Dπ).val.app (Opposite.op V)).hom
          (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))) = 0 := by
      have h := congrArg (fun φ : SheafOfModules.unit (wcRingSheaf XE ℓ) ⟶ wcSuppObj Dπ =>
        (φ.val.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))) hz
      exact h
    rw [hb] at hzV
    have hbC : (γN.val.app (Opposite.op V)).hom b = b :=
      sub_eq_zero.mp ((hsub V b).symm.trans hzV)
    have hinv : ∀ κ : Limits.pullback V.hom T.πi ⟶ Limits.pullback V.hom T.πi,
        κ ≫ Limits.pullback.fst V.hom T.πi = Limits.pullback.fst V.hom T.πi →
        κ ≫ Limits.pullback.snd V.hom T.πi = Limits.pullback.snd V.hom T.πi ≫ T.γi →
        (yC * a).comp κ.base.hom = yC * a := by
      intro κ hκ1 hκ2
      have hyκ : yC.comp κ.base.hom = yC := (hγs V yC κ hκ1 hκ2).symm.trans hyC
      have hbκ : b.comp κ.base.hom = b := (hγs V b κ hκ1 hκ2).symm.trans hbC
      have haκ : a.comp κ.base.hom = a := by
        have e1 : b * a.comp κ.base.hom = 1 := by
          rw [← hbκ, ← ContinuousMap.mul_comp, hab, ContinuousMap.one_comp]
        calc a.comp κ.base.hom = a.comp κ.base.hom * (b * a) := by rw [hab, mul_one]
          _ = (b * a.comp κ.base.hom) * a := by ring
          _ = a := by rw [e1, one_mul]
      rw [ContinuousMap.mul_comp, hyκ, haκ]
    obtain ⟨t, ht⟩ := wc_qmtm_invariant_factor T V.hom (yC * a) hinv
    refine ⟨t, ?_⟩
    rw [wc_supp_hom_twist_formula Dπ hDπ (wcSuppUnitMap Dπ) V t, ← ht]
    show yC * a * b = yC
    rw [mul_assoc, mul_comm a b, hab, mul_one]

theorem wc_qmtm_push_comp_homology_iso {X' X S : Scheme.{u}} (f : X' ⟶ X) (g : X ⟶ S)
    (k : X' ⟶ S) (hk : f ≫ g = k) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg)
    (Dk : wcHMPullData k ℓ) (hDk : wcHMPullCanonical Dk)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf X' ℓ))) :
    haveI := Df.additive
    haveI : (wcQmtmPush Df).Additive := Adjunction.right_adjoint_additive Df.adj
    haveI := Dg.additive
    haveI : (wcQmtmPush Dg).Additive := Adjunction.right_adjoint_additive Dg.adj
    haveI := Dk.additive
    haveI : (wcQmtmPush Dk).Additive := Adjunction.right_adjoint_additive Dk.adj
    (∀ n : ℕ, Limits.IsZero ((((wcQmtmPush Df).mapHomologicalComplex (ComplexShape.up ℕ)).obj
      I.cocomplex).homology (n + 1))) →
    ∀ (J : InjectiveResolution (wcSuppObj Df)) (m : ℕ),
      Nonempty ((((wcQmtmPush Dg).mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology m ≅
        (((wcQmtmPush Dk).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology m) :=
by
  intro hacyc J m
  haveI := Df.additive
  haveI : (wcQmtmPush Df).Additive := Adjunction.right_adjoint_additive Df.adj
  haveI := Dg.additive
  haveI : (wcQmtmPush Dg).Additive := Adjunction.right_adjoint_additive Dg.adj
  haveI := Dk.additive
  haveI : (wcQmtmPush Dk).Additive := Adjunction.right_adjoint_additive Dk.adj
  haveI := Df.presLim

  let R := wcQmtmPush Df
  let Z := SheafOfModules.unit (wcRingSheaf X' ℓ)
  let K := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
  have hinj : ∀ n, Injective (K.X n) := fun n => Df.adj.map_injective _ (I.injective n)
  have hz : R.map (I.ι.f 0) ≫ K.d 0 1 = 0 := by
    show R.map (I.ι.f 0) ≫ R.map (I.cocomplex.d 0 1) = 0
    rw [← R.map_comp, I.ι_f_zero_comp_complex_d, R.map_zero]
  let ι : (CochainComplex.single₀ _).obj (R.obj Z) ⟶ K :=
    (CochainComplex.fromSingle₀Equiv K (R.obj Z)).symm ⟨R.map (I.ι.f 0), hz⟩
  have hι0 : ι.f 0 = R.map (I.ι.f 0) :=
    CochainComplex.fromSingle₀Equiv_symm_apply_f_zero _ _
  have hqi : QuasiIso ι := by
    rw [quasiIso_iff]
    intro i
    rcases i with _ | n
    · rw [CochainComplex.quasiIsoAt₀_iff, ShortComplex.quasiIso_iff_of_zeros]
      · have : Limits.PreservesLimitsOfSize.{0, 0} R := Df.adj.rightAdjoint_preservesLimits
        have : R.IsRightAdjoint := ⟨_, ⟨Df.adj⟩⟩
        constructor
        · have e1 := I.exact₀.map_of_mono_of_preservesKernel R inferInstance inferInstance
          refine ShortComplex.exact_of_iso ?_ e1
          refine ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_
          · first
              | exact (Category.id_comp _).trans (hι0.trans (Category.comp_id _).symm)
              | (dsimp; erw [Category.id_comp, Category.comp_id]; exact hι0)
              | (simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]; exact hι0)
          · first
              | exact (Category.id_comp _).trans (Category.comp_id _).symm
              | (dsimp; erw [Category.id_comp, Category.comp_id]; rfl)
              | (simp only [Iso.refl_hom, Category.id_comp, Category.comp_id]; rfl)
        · show Mono (ι.f 0)
          rw [hι0]
          exact @Functor.map_mono _ _ _ _ R (Functor.preservesMonomorphisms_of_isRightAdjoint R)
            _ _ _ inferInstance
      · first
          | rfl
          | exact HomologicalComplex.single_obj_d _ _ _ _ _
          | (dsimp; rfl)
      · first
          | rfl
          | exact HomologicalComplex.single_obj_d _ _ _ _ _
          | (dsimp; rfl)
      · exact K.shape 0 0 (by simp)
    · rw [quasiIsoAt_iff_exactAt ι (n + 1)]
      · exact (HomologicalComplex.exactAt_iff_isZero_homology K (n + 1)).2 (hacyc n)
      · exact HomologicalComplex.exactAt_single_obj _ 0 _ (n + 1) (by omega)
  let J' : InjectiveResolution (wcSuppObj Df) :=
    { cocomplex := K, injective := hinj, ι := ι, quasiIso := hqi }

  let E := InjectiveResolution.homotopyEquiv J J'
  let e1 := ((wcQmtmPush Dg).mapHomotopyEquiv E).toHomologyIso m

  obtain ⟨γ⟩ := wc_hm_pull_data_comp_Phi_iso g f k hk Dg hDg Df hDf Dk hDk
  let adj' : Dk.Φ ⊣ wcQmtmPush Df ⋙ wcQmtmPush Dg := (Dg.adj.comp Df.adj).ofNatIsoLeft γ.symm
  let θ : wcQmtmPush Dk ≅ wcQmtmPush Df ⋙ wcQmtmPush Dg := Dk.adj.rightAdjointUniq adj'
  let ψ := (NatIso.mapHomologicalComplex θ (ComplexShape.up ℕ)).app I.cocomplex ≪≫
    ((Functor.mapHomologicalComplexCompIso (Iso.refl (wcQmtmPush Df ⋙ wcQmtmPush Dg))
      (ComplexShape.up ℕ)).app I.cocomplex).symm
  exact ⟨e1 ≪≫ HomologicalComplex.homologyMapIso ψ.symm m⟩

theorem wc_kummer_kappa_finite_fp (L : Type u) [Field L] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (k : ℕ) :
    IsFinite (Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
      (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) : LaurentPolynomial L →+* LaurentPolynomial L))) ∧
    LocallyOfFinitePresentation (Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
      (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) : LaurentPolynomial L →+* LaurentPolynomial L))) :=
by
  classical
  set N : ℤ := (ℓ : ℤ) ^ k with hNdef
  have hN : 0 < N := pow_pos (Nat.cast_pos.mpr (Fact.out : ℓ.Prime).pos) k
  set φ : LaurentPolynomial L →+* LaurentPolynomial L :=
    AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft N) with hφ
  have hfin : φ.Finite := by
    let S : Finset (LaurentPolynomial L) :=
      (Finset.range N.toNat).image (fun r : ℕ => AddMonoidAlgebra.single (r : ℤ) (1 : L))
    refine @Module.Finite.of_fg_top _ _ _ _ (φ.toAlgebra.toModule) ⟨S, ?_⟩
    refine @eq_top_iff _ _ _ _ |>.2 ?_
    intro x hx
    clear hx
    induction x using AddMonoidAlgebra.induction_linear with
    | zero => exact @Submodule.zero_mem _ _ _ _ (φ.toAlgebra.toModule) _
    | add f g hf hg => exact @Submodule.add_mem _ _ _ _ (φ.toAlgebra.toModule) _ _ _ hf hg
    | single m c =>
      have hr0 : 0 ≤ m % N := Int.emod_nonneg m hN.ne'
      have hrN : m % N < N := Int.emod_lt_of_pos m hN
      have hmem : AddMonoidAlgebra.single (m % N) (1 : L) ∈ @Submodule.span _ _ _ _
          (φ.toAlgebra.toModule) (S : Set (LaurentPolynomial L)) := by
        apply @Submodule.subset_span _ _ _ _ (φ.toAlgebra.toModule)
        simp only [S, Finset.coe_image, Finset.coe_range, Set.mem_image, Set.mem_Iio]
        refine ⟨(m % N).toNat, by omega, ?_⟩
        rw [Int.toNat_of_nonneg hr0]
      have key : (AddMonoidAlgebra.single m c : LaurentPolynomial L) =
          φ (AddMonoidAlgebra.single (m / N) c : LaurentPolynomial L) *
            (AddMonoidAlgebra.single (m % N) (1 : L) : LaurentPolynomial L) := by
        rw [hφ, AddMonoidAlgebra.mapDomainRingHom_apply, AddMonoidAlgebra.mapDomain_single,
          AddMonoidHom.coe_mulLeft, AddMonoidAlgebra.single_mul_single, mul_one,
          Int.mul_ediv_add_emod]
      rw [key]
      exact @Submodule.smul_mem _ _ _ _ (φ.toAlgebra.toModule) _ _
        (AddMonoidAlgebra.single (m / N) c : LaurentPolynomial L) hmem
  have hnoeth : IsNoetherianRing (LaurentPolynomial L) := by
    have : Algebra.FiniteType L (AddMonoidAlgebra L ℤ) :=
      (AddMonoidAlgebra.finiteType_iff_group_fg (R := L) (G := ℤ)).2 inferInstance
    exact Algebra.FiniteType.isNoetherianRing L (AddMonoidAlgebra L ℤ)
  refine ⟨?_, ?_⟩
  · rw [IsFinite.SpecMap_iff, CommRingCat.hom_ofHom]
    exact hfin
  · rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFinitePresentation), CommRingCat.hom_ofHom]
    exact RingHom.FinitePresentation.of_finiteType.1 hfin.finiteType

theorem wc_qmbt_cc_etale_adjoin_deriv (R : Type u) [CommRing R] (g b : Polynomial R) :
    Algebra.Etale R (Localization.Away (AdjoinRoot.mk g (Polynomial.derivative g * b))) :=
by
  classical
  set h : AdjoinRoot g := AdjoinRoot.mk g (Polynomial.derivative g * b) with hh

  have hFP : Algebra.FinitePresentation R (Localization.Away h) :=
    Algebra.FinitePresentation.of_isLocalizationAway (S := AdjoinRoot g) h

  have himg : ∀ {S : Type u} [CommRing S] [Algebra R S] (φ : Localization.Away h →ₐ[R] S)
      (p : Polynomial R),
      Polynomial.aeval (φ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g))) p =
        φ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.mk g p)) := by
    intro S _ _ φ p
    rw [Polynomial.aeval_algHom_apply, Polynomial.aeval_algebraMap_apply, AdjoinRoot.aeval_eq]

  have hext : ∀ {S : Type u} [CommRing S] [Algebra R S] (φ₁ φ₂ : Localization.Away h →ₐ[R] S),
      φ₁ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g)) =
        φ₂ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g)) → φ₁ = φ₂ := by
    intro S _ _ φ₁ φ₂ hφ
    apply IsLocalization.algHom_ext (Submonoid.powers h)
    apply AdjoinRoot.algHom_ext
    exact hφ

  have hlift : ∀ {S : Type u} [CommRing S] [Algebra R S] (x : S), Polynomial.aeval x g = 0 →
      IsUnit (Polynomial.aeval x (Polynomial.derivative g * b)) →
      ∃ φ : Localization.Away h →ₐ[R] S,
        φ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g)) = x := by
    intro S _ _ x hx hu
    have hx' : Polynomial.eval₂ (↑(Algebra.ofId R S)) x g = 0 := by
      rw [← hx, Polynomial.aeval_def]; rfl
    let f : AdjoinRoot g →ₐ[R] S := AdjoinRoot.liftAlgHom g (Algebra.ofId R S) x hx'
    have hfr : f (AdjoinRoot.root g) = x := AdjoinRoot.liftAlgHom_root _ _ _ _
    have hfh : IsUnit (f h) := by
      rw [hh, ← AdjoinRoot.aeval_eq, ← Polynomial.aeval_algHom_apply, hfr]
      exact hu
    refine ⟨IsLocalization.Away.liftAlgHom h hfh, ?_⟩
    rw [IsLocalization.Away.liftAlgHom_apply]
    exact (IsLocalization.lift_eq _ _).trans hfr

  have hFE : Algebra.FormallyEtale R (Localization.Away h) := by
    rw [Algebra.FormallyEtale.iff_comp_bijective]
    intro B _ _ I hI
    have hsq : ∀ e ∈ I, e ^ 2 = 0 := by
      intro e he
      have h2 : e ^ 2 ∈ I ^ 2 := Ideal.pow_mem_pow he 2
      rw [hI] at h2
      exact (Ideal.mem_bot).mp h2
    have hnil : IsNilpotent I := ⟨2, by rw [hI, Ideal.zero_eq_bot]⟩
    have hmk0 : ∀ (z : B) (p : Polynomial R),
        Ideal.Quotient.mk I (Polynomial.aeval z p) =
          Polynomial.aeval (Ideal.Quotient.mk I z) p := fun z p =>
      (Polynomial.aeval_algHom_apply (Ideal.Quotient.mkₐ R I) z p).symm
    have hroot : ∀ {S : Type u} [CommRing S] [Algebra R S] (φ : Localization.Away h →ₐ[R] S),
        Polynomial.aeval (φ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g))) g = 0 ∧
        IsUnit (Polynomial.aeval (φ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g)))
          (Polynomial.derivative g * b)) := by
      intro S _ _ φ
      refine ⟨?_, ?_⟩
      · rw [himg φ g, AdjoinRoot.mk_self, map_zero, map_zero]
      · rw [himg φ _]
        exact (IsLocalization.Away.algebraMap_isUnit h).map φ
    constructor
    · intro φ₁ φ₂ hφ
      apply hext
      obtain ⟨h1g, -⟩ := hroot φ₁
      obtain ⟨h2g, h2u⟩ := hroot φ₂
      set x₁ := φ₁ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g)) with hx₁
      set x₂ := φ₂ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g)) with hx₂
      have hq : Ideal.Quotient.mk I x₁ = Ideal.Quotient.mk I x₂ := by
        have := AlgHom.congr_fun hφ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g))
        simpa only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] using this
      have he : x₁ - x₂ ∈ I := Ideal.Quotient.eq.mp hq
      have hD : IsUnit (Polynomial.aeval x₂ (Polynomial.derivative g)) := by
        rw [map_mul] at h2u
        exact isUnit_of_mul_isUnit_left h2u
      have key := Polynomial.aeval_add_of_sq_eq_zero g x₂ (x₁ - x₂) (hsq _ he)
      have hs : x₂ + (x₁ - x₂) = x₁ := by ring
      rw [hs, h1g, h2g, zero_add] at key
      have : x₁ - x₂ = 0 := hD.mul_right_eq_zero.mp key.symm
      exact sub_eq_zero.mp this
    · intro ψ
      obtain ⟨hyg, hyu⟩ := hroot ψ
      obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective
        (ψ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g)))
      have hG : Polynomial.aeval x g ∈ I := by
        apply Ideal.Quotient.eq_zero_iff_mem.mp
        rw [hmk0, hx, hyg]
      have hH : IsUnit (Polynomial.aeval x (Polynomial.derivative g * b)) := by
        apply (hnil.isUnit_quotient_mk_iff).mp
        rw [hmk0, hx]
        exact hyu
      have hD : IsUnit (Polynomial.aeval x (Polynomial.derivative g)) := by
        rw [map_mul] at hH
        exact isUnit_of_mul_isUnit_left hH
      set G := Polynomial.aeval x g with hGdef
      set D := Polynomial.aeval x (Polynomial.derivative g) with hDdef
      set u : B := ↑(hD.unit⁻¹) with hudef
      have hDu : D * u = 1 := hD.mul_val_inv
      have hε : -(G * u) ∈ I := I.neg_mem (I.mul_mem_right _ hG)
      have hr1 : Polynomial.aeval (x + -(G * u)) g = 0 := by
        rw [Polynomial.aeval_add_of_sq_eq_zero g x _ (hsq _ hε)]
        rw [← hGdef, ← hDdef]
        linear_combination (-G) * hDu
      have hmkx : Ideal.Quotient.mk I (x + -(G * u)) =
          ψ (algebraMap (AdjoinRoot g) _ (AdjoinRoot.root g)) := by
        rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hε, add_zero, hx]
      have hr2 : IsUnit (Polynomial.aeval (x + -(G * u)) (Polynomial.derivative g * b)) := by
        apply (hnil.isUnit_quotient_mk_iff).mp
        rw [hmk0, hmkx]
        exact hyu
      obtain ⟨φ, hφ⟩ := hlift (x + -(G * u)) hr1 hr2
      refine ⟨φ, hext _ _ ?_⟩
      rw [AlgHom.comp_apply, hφ, Ideal.Quotient.mkₐ_eq_mk, hmkx]
  exact ⟨hFE, hFP⟩

theorem wc_kummer_tower_et_coh_limit {M : Scheme.{u}} [IsAffine M] {L : Type u} [Field L]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓL : IsUnit ((ℓ : ℕ) : L))
    (g : M ⟶ Spec (.of (LaurentPolynomial L))) (j : ℕ)
    (hkill : ∀ (k : ℕ) (x : wcEtZModExt (Limits.pullback g (Spec.map (CommRingCat.ofHom
        (AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) :
          LaurentPolynomial L →+* LaurentPolynomial L)))) ℓ (j + 1)),
      ∃ d : ℕ, ∀ (t : Limits.pullback g (Spec.map (CommRingCat.ofHom
          (AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ (k + d))) :
            LaurentPolynomial L →+* LaurentPolynomial L))) ⟶
          Limits.pullback g (Spec.map (CommRingCat.ofHom
          (AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) :
            LaurentPolynomial L →+* LaurentPolynomial L)))),
        t ≫ Limits.pullback.fst g (Spec.map (CommRingCat.ofHom
          (AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) :
            LaurentPolynomial L →+* LaurentPolynomial L))) =
          Limits.pullback.fst g (Spec.map (CommRingCat.ofHom
          (AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ (k + d))) :
            LaurentPolynomial L →+* LaurentPolynomial L))) →
        t ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom
          (AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) :
            LaurentPolynomial L →+* LaurentPolynomial L))) =
          Limits.pullback.snd g (Spec.map (CommRingCat.ofHom
          (AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ (k + d))) :
            LaurentPolynomial L →+* LaurentPolynomial L))) ≫
          Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
            (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ d)) : LaurentPolynomial L →+* LaurentPolynomial L)) →
        ∀ E : wcEtPullData t ℓ, wcEtPull E (j + 1) x = 0) :
    Subsingleton (wcEtCoh (Limits.pullback g (Spec.map (CommRingCat.ofHom
      (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)))) ℓ (j + 1)) :=
by
  classical

  have C2 :
      (∀ a b : ℕ, (AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ a)) :
          LaurentPolynomial L →+* LaurentPolynomial L).comp
          (AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ b)) :
            LaurentPolynomial L →+* LaurentPolynomial L) =
        (AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ (b + a))) :
          LaurentPolynomial L →+* LaurentPolynomial L)) ∧
      (AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ 0)) :
          LaurentPolynomial L →+* LaurentPolynomial L) = RingHom.id (LaurentPolynomial L) ∧
      (∀ k : ℕ, (AddMonoidAlgebra.mapDomainRingHom L
          ((AddMonoidHom.mulLeft ((IsLocalization.Away.invSelf (ℓ : ℤ) :
            Localization.Away (ℓ : ℤ)) ^ k)).comp
            (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)).comp
          (AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) :
            LaurentPolynomial L →+* LaurentPolynomial L) =
        AddMonoidAlgebra.mapDomainRingHom L
          (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) ∧
      (∀ k d : ℕ, (AddMonoidAlgebra.mapDomainRingHom L
          ((AddMonoidHom.mulLeft ((IsLocalization.Away.invSelf (ℓ : ℤ) :
            Localization.Away (ℓ : ℤ)) ^ (k + d))).comp
            (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)).comp
          (AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ d)) :
            LaurentPolynomial L →+* LaurentPolynomial L) =
        AddMonoidAlgebra.mapDomainRingHom L
          ((AddMonoidHom.mulLeft ((IsLocalization.Away.invSelf (ℓ : ℤ) :
            Localization.Away (ℓ : ℤ)) ^ k)).comp
            (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)) := by
    have hinv : (algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ)) *
        (IsLocalization.Away.invSelf (ℓ : ℤ) : Localization.Away (ℓ : ℤ)) = 1 :=
      IsLocalization.Away.mul_invSelf (ℓ : ℤ)
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro a b
      rw [← AddMonoidAlgebra.mapDomainRingHom_comp]
      congr 1
      ext
      simp [pow_add, mul_comm]
    · have : (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ 0)) = AddMonoidHom.id ℤ := by
        ext; simp
      rw [this]
      exact AddMonoidAlgebra.mapDomainRingHom_id
    · intro k
      rw [← AddMonoidAlgebra.mapDomainRingHom_comp]
      congr 1
      ext
      simp only [AddMonoidHom.comp_apply, AddMonoidHom.coe_mulLeft, RingHom.toAddMonoidHom_eq_coe,
        AddMonoidHom.coe_coe, mul_one, map_pow, map_natCast]
      rw [← mul_pow, mul_comm]
      have h2 : (ℓ : Localization.Away (ℓ : ℤ)) *
          (IsLocalization.Away.invSelf (ℓ : ℤ) : Localization.Away (ℓ : ℤ)) = 1 := by
        simpa using hinv
      rw [h2, one_pow, map_one]
    · intro k d
      rw [← AddMonoidAlgebra.mapDomainRingHom_comp]
      congr 1
      ext
      simp only [AddMonoidHom.comp_apply, AddMonoidHom.coe_mulLeft, RingHom.toAddMonoidHom_eq_coe,
        AddMonoidHom.coe_coe, mul_one, map_pow, map_natCast, map_one]
      have h2 : (IsLocalization.Away.invSelf (ℓ : ℤ) : Localization.Away (ℓ : ℤ)) *
          (ℓ : Localization.Away (ℓ : ℤ)) = 1 := by
        rw [mul_comm]; simpa using hinv
      rw [pow_add, mul_assoc, ← mul_pow, h2, one_pow, mul_one]

  have hZ : ∀ m : ℤ, (((LaurentPolynomial.isUnit_T (R := L) 1).unit ^ m :
      (LaurentPolynomial L)ˣ) : LaurentPolynomial L) = LaurentPolynomial.T m := by
    set V := (LaurentPolynomial.isUnit_T (R := L) 1).unit with hVdef
    have hV : (V : LaurentPolynomial L) = LaurentPolynomial.T 1 := rfl
    have hinv' : ((V⁻¹ : (LaurentPolynomial L)ˣ) : LaurentPolynomial L) =
        LaurentPolynomial.T (-1) := by
      have h1 : (V : LaurentPolynomial L) * LaurentPolynomial.T (-1) = 1 := by
        rw [hV, ← LaurentPolynomial.T_add]; simp
      calc ((V⁻¹ : (LaurentPolynomial L)ˣ) : LaurentPolynomial L)
          = ((V⁻¹ : (LaurentPolynomial L)ˣ) : LaurentPolynomial L) *
              ((V : LaurentPolynomial L) * LaurentPolynomial.T (-1)) := by rw [h1, mul_one]
        _ = LaurentPolynomial.T (-1) := by rw [← mul_assoc, Units.inv_mul, one_mul]
    intro m
    induction m using Int.induction_on with
    | zero => simp
    | succ n ih => rw [zpow_add_one, Units.val_mul, ih, hV, ← LaurentPolynomial.T_add]
    | pred n ih =>
      rw [zpow_sub_one, Units.val_mul, ih, hinv', ← LaurentPolynomial.T_add]; ring_nf
  have Zl : ∀ {S : Type u} [CommRing S] (f : LaurentPolynomial L →+* S) (m : ℤ),
      f (LaurentPolynomial.T m) =
        (((Units.map (f : LaurentPolynomial L →* S)
          (LaurentPolynomial.isUnit_T (R := L) 1).unit) ^ m : Sˣ) : S) := by
    intro S _ f m
    rw [← hZ m, ← map_zpow, Units.coe_map]
    rfl
  have hC : ∀ c : L, AddMonoidAlgebra.single (0 : ℤ) c = LaurentPolynomial.C c := fun c => rfl
  have hT : ∀ m : ℤ, AddMonoidAlgebra.single m (1 : L) = LaurentPolynomial.T m := fun m => rfl
  have hκT : ∀ (d : ℕ) (m : ℤ), (AddMonoidAlgebra.mapDomainRingHom L
      (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ d)) : LaurentPolynomial L →+* LaurentPolynomial L)
        (LaurentPolynomial.T m) = LaurentPolynomial.T ((ℓ : ℤ) ^ d * m) := by
    intro d m
    show AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.single m (1 : L)) = _
    rw [AddMonoidAlgebra.mapDomain_single]
    rfl
  have hκC : ∀ (d : ℕ) (c : L), (AddMonoidAlgebra.mapDomainRingHom L
      (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ d)) : LaurentPolynomial L →+* LaurentPolynomial L)
        (LaurentPolynomial.C c) = LaurentPolynomial.C c := by
    intro d c
    show AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.single 0 c) = _
    rw [AddMonoidAlgebra.mapDomain_single]
    simp only [AddMonoidHom.coe_mulLeft, mul_zero]
    rfl

  have C1 : ∀ k : ℕ, Etale (Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
      (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) : LaurentPolynomial L →+* LaurentPolynomial L))) := by
    intro k
    set κ : LaurentPolynomial L →+* LaurentPolynomial L := AddMonoidAlgebra.mapDomainRingHom L
        (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) with hκdef
    rw [HasRingHomProperty.Spec_iff (P := @Etale), CommRingCat.hom_ofHom]
    set N : ℕ := ℓ ^ k with hN
    have hNpos : N ≠ 0 := pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero
    have hκT' : ∀ m : ℤ, κ (LaurentPolynomial.T m) = LaurentPolynomial.T ((N : ℤ) * m) := by
      intro m
      rw [hκdef, hκT, hN, Nat.cast_pow]
    have hκC' : ∀ c : L, κ (LaurentPolynomial.C c) = LaurentPolynomial.C c := fun c => hκC k c
    set g : Polynomial (LaurentPolynomial L) :=
      Polynomial.X ^ N - Polynomial.C (LaurentPolynomial.T 1) with hg
    have hroot_eval : Polynomial.eval₂ κ (LaurentPolynomial.T 1) g = 0 := by
      rw [hg, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hκT',
        LaurentPolynomial.T_pow, sub_self]
    set φ : AdjoinRoot g →+* LaurentPolynomial L :=
      AdjoinRoot.lift κ (LaurentPolynomial.T 1) hroot_eval with hφ
    have hrootN : AdjoinRoot.root g ^ N = AdjoinRoot.of g (LaurentPolynomial.T 1) := by
      have h0 := (AdjoinRoot.mk_self : AdjoinRoot.mk g g = 0)
      rw [hg, map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h0
      exact h0
    have hroot_unit : IsUnit (AdjoinRoot.root g) := by
      rw [← isUnit_pow_iff hNpos, hrootN]
      exact (LaurentPolynomial.isUnit_T 1).map _
    set u := hroot_unit.unit with hu
    have huv : (u : AdjoinRoot g) = AdjoinRoot.root g := rfl
    set ψ : LaurentPolynomial L →+* AdjoinRoot g := AddMonoidAlgebra.liftNCRingHom
      ((AdjoinRoot.of g).comp LaurentPolynomial.C)
      ((Units.coeHom (AdjoinRoot g)).comp (zpowersHom _ u)) (fun _ _ => Commute.all _ _) with hψ
    have hψs : ∀ (m : ℤ) (c : L), ψ (AddMonoidAlgebra.single m c) =
        AdjoinRoot.of g (LaurentPolynomial.C c) * ((u ^ m : (AdjoinRoot g)ˣ) : AdjoinRoot g) := by
      intro m c
      rw [hψ, AddMonoidAlgebra.liftNCRingHom_single]
      simp
    have hUN : Units.map ((AdjoinRoot.of g : LaurentPolynomial L →+* AdjoinRoot g) :
        LaurentPolynomial L →* AdjoinRoot g) (LaurentPolynomial.isUnit_T (R := L) 1).unit =
          u ^ N := by
      apply Units.ext
      rw [Units.coe_map, Units.val_pow_eq_pow_val, huv, hrootN]
      rfl
    have hUφ : Units.map (φ : AdjoinRoot g →* LaurentPolynomial L) u =
        (LaurentPolynomial.isUnit_T (R := L) 1).unit := by
      apply Units.ext
      rw [Units.coe_map, huv]
      exact AdjoinRoot.lift_root hroot_eval
    have h1 : φ.comp ψ = RingHom.id _ := by
      apply AddMonoidAlgebra.ringHom_ext
      · intro r
        rw [RingHom.comp_apply, hψs, zpow_zero, Units.val_one, mul_one, AdjoinRoot.lift_of, hC,
          hκC']
        rfl
      · intro m
        rw [RingHom.comp_apply, hψs, map_one, map_one, one_mul]
        have e1 : φ ((u ^ m : (AdjoinRoot g)ˣ) : AdjoinRoot g) =
            ((Units.map (φ : AdjoinRoot g →* LaurentPolynomial L) (u ^ m) :
              (LaurentPolynomial L)ˣ) : LaurentPolynomial L) := (Units.coe_map _ _).symm
        rw [e1, map_zpow, hUφ, hZ, RingHom.id_apply, hT]
    have h2 : ψ.comp φ = RingHom.id _ := by
      apply AdjoinRoot.ringHom_ext
      · rw [RingHom.comp_assoc, hφ, AdjoinRoot.lift_comp_of]
        apply AddMonoidAlgebra.ringHom_ext
        · intro r
          rw [RingHom.comp_apply, hC, hκC', ← hC, hψs, zpow_zero, Units.val_one, mul_one]
          rfl
        · intro m
          rw [RingHom.comp_apply, hT, hκT', ← hT, hψs, map_one, map_one, one_mul,
            RingHom.comp_apply, RingHom.id_apply, Zl (AdjoinRoot.of g) m, hUN, ← zpow_natCast,
            ← zpow_mul]
      · rw [RingHom.comp_apply, AdjoinRoot.lift_root, ← hT, hψs, map_one, map_one, one_mul,
          zpow_one, huv, RingHom.id_apply]
    set e : AdjoinRoot g ≃+* LaurentPolynomial L := RingEquiv.ofRingHom φ ψ h1 h2 with he
    have hκe : e.toRingHom.comp (AdjoinRoot.of g) = κ := by
      refine RingHom.ext fun x => ?_
      exact AdjoinRoot.lift_of hroot_eval
    set h := AdjoinRoot.mk g (Polynomial.derivative g * Polynomial.X) with hh
    have hNunit : IsUnit ((N : ℕ) : LaurentPolynomial L) := by
      have := (hℓL.pow k).map (LaurentPolynomial.C (R := L))
      rw [map_pow, map_natCast] at this
      rw [hN, Nat.cast_pow]
      exact this
    have hhunit : IsUnit h := by
      have hd : Polynomial.derivative g * Polynomial.X =
          Polynomial.C ((N : ℕ) : LaurentPolynomial L) * Polynomial.X ^ (N - 1) *
            Polynomial.X := by
        rw [hg, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
          sub_zero]
      rw [hh, hd, map_mul, map_mul, map_pow, AdjoinRoot.mk_C, AdjoinRoot.mk_X]
      exact ((hNunit.map _).mul (hroot_unit.pow _)).mul hroot_unit
    haveI := wc_qmbt_cc_etale_adjoin_deriv (LaurentPolynomial L) g Polynomial.X
    have hle : Submonoid.powers h ≤ IsUnit.submonoid (AdjoinRoot g) := by
      rintro x ⟨n, rfl⟩
      exact hhunit.pow n
    let e1 := (IsLocalization.atUnits (AdjoinRoot g) (Submonoid.powers h)
      (S := Localization.Away h) hle).restrictScalars (LaurentPolynomial L)
    haveI : Algebra.Etale (LaurentPolynomial L) (AdjoinRoot g) := Algebra.Etale.of_equiv e1.symm
    have hof : (AdjoinRoot.of g).Etale := by
      rw [← AdjoinRoot.algebraMap_eq]
      exact RingHom.etale_algebraMap.mpr inferInstance
    rw [← hκe]
    exact RingHom.Etale.respectsIso.1 _ e hof

  have C3 : ∀ (B : Type u) [CommRing B] (σ : ℕ → (LaurentPolynomial L →+* B)),
      (∀ k d : ℕ, (σ (k + d)).comp (AddMonoidAlgebra.mapDomainRingHom L
          (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ d)) : LaurentPolynomial L →+* LaurentPolynomial L) =
            σ k) →
      ∃! τ : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+* B,
        ∀ k : ℕ, τ.comp (AddMonoidAlgebra.mapDomainRingHom L
          ((AddMonoidHom.mulLeft ((IsLocalization.Away.invSelf (ℓ : ℤ) :
            Localization.Away (ℓ : ℤ)) ^ k)).comp
            (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)) = σ k := by
    intro B _ σ hσ
    set A := Localization.Away (ℓ : ℤ) with hA
    set inv : A := IsLocalization.Away.invSelf (ℓ : ℤ) with hinv
    set ι : ℤ →+* A := algebraMap ℤ A with hι
    have hℓ0 : (ℓ : ℤ) ≠ 0 := by exact_mod_cast (Fact.out : ℓ.Prime).ne_zero
    have hinj : Function.Injective ι :=
      IsLocalization.injective (M := Submonoid.powers (ℓ : ℤ)) A
        (powers_le_nonZeroDivisors_of_noZeroDivisors hℓ0)
    have hli : ι (ℓ : ℤ) * inv = 1 := IsLocalization.Away.mul_invSelf (ℓ : ℤ)
    set U : ℕ → Bˣ := fun k => Units.map (σ k : LaurentPolynomial L →* B)
      (LaurentPolynomial.isUnit_T (R := L) 1).unit with hU
    have hσT : ∀ (k : ℕ) (m : ℤ), σ k (LaurentPolynomial.T m) = ((U k ^ m : Bˣ) : B) := by
      intro k m
      rw [← hZ m, hU, ← map_zpow, Units.coe_map]
      rfl
    have hrel : ∀ (k d : ℕ), U (k + d) ^ ((ℓ : ℤ) ^ d) = U k := by
      intro k d
      apply Units.ext
      rw [← zpow_one (U k), ← hσT, ← hσT, ← hσ k d, RingHom.comp_apply, hκT, mul_one]
    have hσC : ∀ (k : ℕ) (c : L), σ k (LaurentPolynomial.C c) = σ 0 (LaurentPolynomial.C c) := by
      intro k c
      rw [← hσ 0 k, RingHom.comp_apply, hκC, zero_add]
    have hex : ∀ x : A, ∃ p : ℕ × ℤ, x * ι ((ℓ : ℤ) ^ p.1) = ι p.2 := by
      intro x
      obtain ⟨n, a, h⟩ := IsLocalization.Away.surj (ℓ : ℤ) x
      exact ⟨(n, a), by rw [map_pow]; exact h⟩
    let rep : A → ℕ × ℤ := fun x => Classical.choose (hex x)
    have hrep : ∀ x, x * ι ((ℓ : ℤ) ^ (rep x).1) = ι (rep x).2 :=
      fun x => Classical.choose_spec (hex x)
    have hwd : ∀ (x : A) (n m : ℕ) (a b : ℤ), x * ι ((ℓ : ℤ) ^ n) = ι a →
        x * ι ((ℓ : ℤ) ^ m) = ι b → U n ^ a = U m ^ b := by
      intro x n m a b ha hb
      have hab : a * (ℓ : ℤ) ^ m = b * (ℓ : ℤ) ^ n := by
        apply hinj
        rw [map_mul, map_mul, ← ha, ← hb]
        ring
      rw [← hrel n m, ← hrel m n, ← zpow_mul, ← zpow_mul, add_comm n m, mul_comm _ a,
        mul_comm _ b, hab]
    let χf : A → Bˣ := fun x => U (rep x).1 ^ (rep x).2
    have hχ : ∀ (x : A) (n : ℕ) (a : ℤ), x * ι ((ℓ : ℤ) ^ n) = ι a → χf x = U n ^ a :=
      fun x n a h => hwd x _ _ _ _ (hrep x) h
    let χ : Multiplicative A →* Bˣ :=
      { toFun := fun x => χf (Multiplicative.toAdd x)
        map_one' := by
          show χf 0 = 1
          rw [hχ 0 0 0 (by simp)]
          simp
        map_mul' := by
          intro x y
          show χf (Multiplicative.toAdd x + Multiplicative.toAdd y) =
            χf (Multiplicative.toAdd x) * χf (Multiplicative.toAdd y)
          set x' := Multiplicative.toAdd x
          set y' := Multiplicative.toAdd y
          rw [hχ x' _ _ (hrep x'), hχ y' _ _ (hrep y')]
          set n := (rep x').1
          set a := (rep x').2
          set m := (rep y').1
          set b := (rep y').2
          have hx := hrep x'
          have hy := hrep y'
          have hxy : (x' + y') * ι ((ℓ : ℤ) ^ (n + m)) =
              ι (a * (ℓ : ℤ) ^ m + b * (ℓ : ℤ) ^ n) := by
            rw [map_add, map_mul, map_mul, ← hx, ← hy, pow_add, map_mul]
            ring
          rw [hχ _ _ _ hxy, zpow_add, ← hrel n m, ← hrel m n, ← zpow_mul, ← zpow_mul, add_comm m n,
            mul_comm a, mul_comm b] }
    have hχv : ∀ (x : A) (n : ℕ) (a : ℤ), x * ι ((ℓ : ℤ) ^ n) = ι a →
        χ (Multiplicative.ofAdd x) = U n ^ a := fun x n a h => hχ x n a h
    let τ : AddMonoidAlgebra L A →+* B := AddMonoidAlgebra.liftNCRingHom
      ((σ 0).comp LaurentPolynomial.C) ((Units.coeHom B).comp χ) (fun _ _ => Commute.all _ _)
    have hτs : ∀ (x : A) (c : L), τ (AddMonoidAlgebra.single x c) =
        σ 0 (LaurentPolynomial.C c) * ((χ (Multiplicative.ofAdd x) : Bˣ) : B) := by
      intro x c
      exact AddMonoidAlgebra.liftNCRingHom_single _ _ _ x c
    set β : ℕ → (LaurentPolynomial L →+* AddMonoidAlgebra L A) := fun k =>
      AddMonoidAlgebra.mapDomainRingHom L ((AddMonoidHom.mulLeft (inv ^ k)).comp ι.toAddMonoidHom)
      with hβ
    have hβs : ∀ (k : ℕ) (m : ℤ) (c : L), β k (AddMonoidAlgebra.single m c) =
        AddMonoidAlgebra.single (inv ^ k * ι m) c := by
      intro k m c
      show AddMonoidAlgebra.mapDomain _ (AddMonoidAlgebra.single m c) = _
      rw [AddMonoidAlgebra.mapDomain_single]
      rfl
    have hkey : ∀ (k : ℕ) (m : ℤ), (inv ^ k * ι m) * ι ((ℓ : ℤ) ^ k) = ι m := by
      intro k m
      rw [map_pow, mul_comm (inv ^ k), mul_assoc, ← mul_pow, mul_comm inv, hli, one_pow, mul_one]
    have hτβ : ∀ k, τ.comp (β k) = σ k := by
      intro k
      apply AddMonoidAlgebra.ringHom_ext
      · intro r
        rw [RingHom.comp_apply, hβs, map_zero, mul_zero, hτs, hχv 0 0 0 (by simp), zpow_zero,
          Units.val_one, mul_one, ← hσC k r]
        rfl
      · intro m
        rw [RingHom.comp_apply, hβs, hτs, hχv _ k m (hkey k m), map_one, map_one, one_mul]
        exact (hσT k m).symm
    refine ⟨τ, hτβ, ?_⟩
    intro τ' hτ'
    apply AddMonoidAlgebra.ringHom_ext
    · intro r
      have h1 : AddMonoidAlgebra.single (0 : A) r = β 0 (AddMonoidAlgebra.single 0 r) := by
        rw [hβs, map_zero, mul_zero]
      rw [h1, ← RingHom.comp_apply, ← RingHom.comp_apply τ, hτ' 0, hτβ 0]
    · intro x
      obtain ⟨n, a, h⟩ := IsLocalization.Away.surj (ℓ : ℤ) x
      have hx : x = inv ^ n * ι a := by
        rw [← h, mul_comm x, ← mul_assoc, ← mul_pow, mul_comm inv, hli, one_pow, one_mul]
      have h1 : AddMonoidAlgebra.single x (1 : L) = β n (AddMonoidAlgebra.single a 1) := by
        rw [hβs, hx]
      rw [h1, ← RingHom.comp_apply, ← RingHom.comp_apply τ, hτ' n, hτβ n]

  have C4 : ∀ {R A : Type u} [CommRing R] [CommRing A]
      (κ : ℕ → (R →+* R)) (β : ℕ → (R →+* A)),
      (∀ (B : Type u) [CommRing B] (σ : ℕ → (R →+* B)),
        (∀ k d : ℕ, (σ (k + d)).comp (κ d) = σ k) →
          ∃! τ : A →+* B, ∀ k : ℕ, τ.comp (β k) = σ k) →
      ∀ (T : Scheme.{u}) (s : ℕ → (T ⟶ Spec (.of R))),
      (∀ k d : ℕ, s (k + d) ≫ Spec.map (CommRingCat.ofHom (κ d)) = s k) →
      ∃! s₀ : T ⟶ Spec (.of A), ∀ k : ℕ, s₀ ≫ Spec.map (CommRingCat.ofHom (β k)) = s k := by
    intro R A _ _ κ β hup T s hs
    let Φ := fun (X : CommRingCat.{u}) => (ΓSpec.adjunction.homEquiv T (Opposite.op X))
    have nat : ∀ {X Y : CommRingCat.{u}} (f : Opposite.op Γ(T, ⊤) ⟶ Opposite.op X) (g : Y ⟶ X),
        Φ Y (f ≫ g.op) = Φ X f ≫ Spec.map g := by
      intro X Y f g
      exact ΓSpec.adjunction.homEquiv_naturality_right f g.op
    have key : ∀ (k : ℕ) {X : CommRingCat.{u}} (a : Opposite.op Γ(T, ⊤) ⟶ Opposite.op X)
        (b : CommRingCat.of R ⟶ X), Φ X a ≫ Spec.map b = s k →
        a.unop.hom.comp b.hom = ((Φ _).symm (s k)).unop.hom := by
      intro k X a b h
      have h2 : a ≫ b.op = (Φ _).symm (s k) := by
        rw [← h, ← nat, Equiv.symm_apply_apply]
        rfl
      rw [← h2]
      rfl
    let σ : ℕ → (R →+* Γ(T, ⊤)) := fun k => ((Φ _).symm (s k)).unop.hom
    have hσ : ∀ k d, (σ (k + d)).comp (κ d) = σ k := by
      intro k d
      refine key k ((Φ _).symm (s (k + d))) (CommRingCat.ofHom (κ d)) ?_
      rw [Equiv.apply_symm_apply]
      exact hs k d
    obtain ⟨τ, hτ, huniq⟩ := hup Γ(T, ⊤) σ hσ
    refine ⟨Φ _ (CommRingCat.ofHom τ).op, ?_, ?_⟩
    · intro k
      rw [← nat]
      have e : (CommRingCat.ofHom τ).op ≫ (CommRingCat.ofHom (β k)).op =
          (Φ _).symm (s k) := by
        change (CommRingCat.ofHom (τ.comp (β k))).op = _
        rw [hτ k]
        rfl
      exact (congrArg (Φ _) e).trans (Equiv.apply_symm_apply _ _)
    · intro s₁ hs₁
      have h1 : ((Φ _).symm s₁).unop.hom = τ := by
        apply huniq
        intro k
        refine key k ((Φ _).symm s₁) (CommRingCat.ofHom (β k)) ?_
        rw [Equiv.apply_symm_apply]
        exact hs₁ k
      rw [← Equiv.apply_symm_apply (Φ _) s₁]
      congr 1
      rw [← h1]
      rfl

  have C5 : ∀ {R A : Type u} [CommRing R] [CommRing A] (κ : ℕ → (R →+* R))
      (β : ℕ → (R →+* A)) (ι : R →+* A), (∀ a b : ℕ, (κ a).comp (κ b) = κ (b + a)) →
      κ 0 = RingHom.id R → (∀ k : ℕ, (β k).comp (κ k) = ι) →
      (∀ k d : ℕ, (β (k + d)).comp (κ d) = β k) →
      (∀ (T : Scheme.{u}) (s : ℕ → (T ⟶ Spec (.of R))),
        (∀ k d : ℕ, s (k + d) ≫ Spec.map (CommRingCat.ofHom (κ d)) = s k) →
        ∃! s₀ : T ⟶ Spec (.of A), ∀ k : ℕ, s₀ ≫ Spec.map (CommRingCat.ofHom (β k)) = s k) →
      ∀ {M : Scheme.{u}} (g : M ⟶ Spec (.of R)),
      ∃ (tr : ∀ k d : ℕ, Limits.pullback g (Spec.map (CommRingCat.ofHom (κ (k + d)))) ⟶
          Limits.pullback g (Spec.map (CommRingCat.ofHom (κ k))))
        (π : ∀ k : ℕ, Limits.pullback g (Spec.map (CommRingCat.ofHom ι)) ⟶
          Limits.pullback g (Spec.map (CommRingCat.ofHom (κ k)))),
        (∀ k d : ℕ, tr k d ≫ Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (κ k))) =
          Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (κ (k + d))))) ∧
        (∀ k d : ℕ, tr k d ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (κ k))) =
          Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (κ (k + d)))) ≫
            Spec.map (CommRingCat.ofHom (κ d))) ∧
        (∀ k : ℕ, tr k 0 = 𝟙 _) ∧
        (∀ k d : ℕ, tr k (d + 1) = tr (k + d) 1 ≫ tr k d) ∧
        (∀ k : ℕ, π k ≫ Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (κ k))) =
          Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ι))) ∧
        (∀ k : ℕ, π (k + 1) ≫ tr k 1 = π k) ∧
        (∀ (T : Scheme.{u})
          (w : ∀ k : ℕ, T ⟶ Limits.pullback g (Spec.map (CommRingCat.ofHom (κ k)))),
          (∀ k : ℕ, w (k + 1) ≫ tr k 1 = w k) →
          ∃! w₀ : T ⟶ Limits.pullback g (Spec.map (CommRingCat.ofHom ι)),
            ∀ k : ℕ, w₀ ≫ π k = w k) := by
    intro R A _ _ κ β ι hκ hκ0 hβι hβκ hspec M g
    have S1 : ∀ k d : ℕ, Spec.map (CommRingCat.ofHom (κ d)) ≫ Spec.map (CommRingCat.ofHom (κ k)) =
        Spec.map (CommRingCat.ofHom (κ (k + d))) := by
      intro k d
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hκ d k]
    have S2 : Spec.map (CommRingCat.ofHom (κ 0)) = 𝟙 _ := by
      rw [hκ0, CommRingCat.ofHom_id, Spec.map_id]
    have S3 : ∀ k : ℕ, Spec.map (CommRingCat.ofHom (β k)) ≫ Spec.map (CommRingCat.ofHom (κ k)) =
        Spec.map (CommRingCat.ofHom ι) := by
      intro k
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hβι k]
    have S4 : ∀ k d : ℕ, Spec.map (CommRingCat.ofHom (β (k + d))) ≫
        Spec.map (CommRingCat.ofHom (κ d)) = Spec.map (CommRingCat.ofHom (β k)) := by
      intro k d
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hβκ k d]
    let tr : ∀ k d : ℕ, Limits.pullback g (Spec.map (CommRingCat.ofHom (κ (k + d)))) ⟶
        Limits.pullback g (Spec.map (CommRingCat.ofHom (κ k))) := fun k d =>
      Limits.pullback.lift (Limits.pullback.fst _ _)
        (Limits.pullback.snd _ _ ≫ Spec.map (CommRingCat.ofHom (κ d)))
        (by rw [Limits.pullback.condition, Category.assoc, S1])
    let π : ∀ k : ℕ, Limits.pullback g (Spec.map (CommRingCat.ofHom ι)) ⟶
        Limits.pullback g (Spec.map (CommRingCat.ofHom (κ k))) := fun k =>
      Limits.pullback.lift (Limits.pullback.fst _ _)
        (Limits.pullback.snd _ _ ≫ Spec.map (CommRingCat.ofHom (β k)))
        (by rw [Limits.pullback.condition, Category.assoc, S3])
    have h1 : ∀ k d : ℕ, tr k d ≫ Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (κ k))) =
        Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (κ (k + d)))) :=
      fun k d => Limits.pullback.lift_fst _ _ _
    have h2 : ∀ k d : ℕ, tr k d ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (κ k))) =
        Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (κ (k + d)))) ≫
          Spec.map (CommRingCat.ofHom (κ d)) :=
      fun k d => Limits.pullback.lift_snd _ _ _
    have h5 : ∀ k : ℕ, π k ≫ Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (κ k))) =
        Limits.pullback.fst g (Spec.map (CommRingCat.ofHom ι)) :=
      fun k => Limits.pullback.lift_fst _ _ _
    have h5' : ∀ k : ℕ, π k ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (κ k))) =
        Limits.pullback.snd g (Spec.map (CommRingCat.ofHom ι)) ≫
          Spec.map (CommRingCat.ofHom (β k)) :=
      fun k => Limits.pullback.lift_snd _ _ _
    refine ⟨tr, π, h1, h2, ?_, ?_, h5, ?_, ?_⟩
    · intro k
      apply Limits.pullback.hom_ext
      · rw [h1, Category.id_comp]
      · rw [h2, S2, Category.comp_id, Category.id_comp]
    · intro k d
      apply Limits.pullback.hom_ext
      · rw [h1, Category.assoc, h1, h1]
      · rw [h2, Category.assoc, h2, ← Category.assoc, h2, Category.assoc, S1]
    · intro k
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, h1, h5, h5]
      · rw [Category.assoc, h2, ← Category.assoc, h5', Category.assoc, S4, h5']
    · intro T w hw
      have hfst : ∀ k, w k ≫ Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (κ k))) =
          w 0 ≫ Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (κ 0))) := by
        intro k
        induction k with
        | zero => rfl
        | succ n ih => rw [← ih, ← hw n, Category.assoc, h1]
      let s : ℕ → (T ⟶ Spec (.of R)) := fun k =>
        w k ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (κ k)))
      have hs : ∀ k d : ℕ, s (k + d) ≫ Spec.map (CommRingCat.ofHom (κ d)) = s k := by
        intro k d
        induction d with
        | zero => simp only [s]; rw [S2, Category.comp_id]; rfl
        | succ d ih =>
          rw [← ih, ← S1 d 1]
          show (w (k + d + 1) ≫
              Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (κ (k + d + 1))))) ≫
              (Spec.map (CommRingCat.ofHom (κ 1)) ≫ Spec.map (CommRingCat.ofHom (κ d))) =
            (w (k + d) ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (κ (k + d))))) ≫
              Spec.map (CommRingCat.ofHom (κ d))
          rw [← hw (k + d)]
          simp only [Category.assoc]
          rw [reassoc_of% (h2 (k + d) 1)]
      obtain ⟨s₀, hs₀, hu⟩ := hspec T s hs
      have hc : (w 0 ≫ Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (κ 0)))) ≫ g =
          s₀ ≫ Spec.map (CommRingCat.ofHom ι) := by
        rw [Category.assoc, Limits.pullback.condition, ← S3 0, ← Category.assoc s₀, hs₀ 0]
        simp only [s, Category.assoc]
      refine ⟨Limits.pullback.lift _ s₀ hc, ?_, ?_⟩
      · intro k
        apply Limits.pullback.hom_ext
        · rw [Category.assoc, h5, Limits.pullback.lift_fst]
          exact (hfst k).symm
        · rw [Category.assoc, h5', ← Category.assoc, Limits.pullback.lift_snd, hs₀]
      · intro w₁ hw₁
        apply Limits.pullback.hom_ext
        · rw [Limits.pullback.lift_fst, ← h5 0, ← Category.assoc, hw₁]
        · rw [Limits.pullback.lift_snd]
          apply hu
          intro k
          rw [Category.assoc, ← h5', ← Category.assoc, hw₁]

  have C6 : ∀ {S Z : Scheme.{u}} (X : ℕ → Scheme.{u}) (f : ∀ n, X n ⟶ S)
      (hf : ∀ n, Etale (f n)) (tr : ∀ n d : ℕ, X (n + d) ⟶ X n),
      (∀ n, tr n 0 = 𝟙 (X n)) → (∀ n d : ℕ, tr n (d + 1) = tr (n + d) 1 ≫ tr n d) →
      ∀ (htrf : ∀ n, tr n 1 ≫ f n = f (n + 1)) (π : ∀ n, Z ⟶ X n),
      (∀ n, π (n + 1) ≫ tr n 1 = π n) →
      (∀ (T : Scheme.{u}) (w : ∀ n, T ⟶ X n), (∀ n, w (n + 1) ≫ tr n 1 = w n) →
        ∃! w₀ : T ⟶ Z, ∀ n, w₀ ≫ π n = w n) →
      (∀ n, IsAffine (X n)) → IsAffine Z → ∀ (m q : ℕ),
      (∀ (n : ℕ) (x : wcEtZModExt (X n) m q),
        ∃ d : ℕ, ∀ E : wcEtPullData (tr n d) m, wcEtPull E q x = 0) →
      ∀ y : wcEtZModExt Z m q, y = 0 := by
    intro S Z X f hf tr htr0 htrc htrf π hπ hlim hX hZ m q hkill' y
    have P0 : ∀ n, π n ≫ f n = π 0 ≫ f 0 := by
      intro n
      induction n with
      | zero => rfl
      | succ n ih => rw [← htrf, ← Category.assoc, hπ, ih]
    have P1 : ∀ n d, π (n + d) ≫ tr n d = π n := by
      intro n d
      induction d with
      | zero => rw [htr0]; exact Category.comp_id _
      | succ d ih =>
        rw [htrc, ← Category.assoc]
        show (π (n + d + 1) ≫ tr (n + d) 1) ≫ tr n d = π n
        rw [hπ, ih]
    let F : ℕᵒᵖ ⥤ S.Etale := Functor.ofOpSequence (C := S.Etale)
      (X := fun n => MorphismProperty.Over.mk ⊤ (f n) (hf n))
      (fun n => MorphismProperty.Over.homMk (tr n 1) (htrf n) trivial)
    let D : AsSmall.{u} ℕᵒᵖ ⥤ S.Etale := AsSmall.down ⋙ F
    have hFs : ∀ n, (F.map (homOfLE (Nat.le_succ n)).op).left = tr n 1 := by
      intro n
      have e := Functor.ofOpSequence_map_homOfLE_succ (C := S.Etale)
        (X := fun n => MorphismProperty.Over.mk ⊤ (f n) (hf n))
        (fun n => MorphismProperty.Over.homMk (tr n 1) (htrf n) trivial) n
      exact congrArg (fun φ => φ.left) e
    have hFc : ∀ {a b c : ℕᵒᵖ} (x : a ⟶ b) (y : b ⟶ c),
        (F.map (x ≫ y)).left = (F.map x).left ≫ (F.map y).left := by
      intro a b c x y
      rw [F.map_comp]
      rfl
    have hFi : ∀ (a : ℕᵒᵖ), (F.map (𝟙 a)).left = 𝟙 _ := by
      intro a
      rw [F.map_id]
      rfl
    have hstep : ∀ n, π (n + 1) ≫ (F.map (homOfLE (Nat.le_succ n)).op).left = π n := by
      intro n
      rw [hFs]
      exact hπ n
    have hcompat : ∀ (b d : ℕ) (t : Opposite.op (b + d) ⟶ Opposite.op b),
        π (b + d) ≫ (F.map t).left = π b := by
      intro b d
      induction d with
      | zero =>
        intro t
        have : t = 𝟙 _ := Quiver.Hom.unop_inj (Subsingleton.elim _ _)
        subst this
        rw [hFi]
        exact Category.comp_id _
      | succ d ih =>
        intro t
        have : t = (homOfLE (Nat.le_succ (b + d))).op ≫ (homOfLE (Nat.le_add_right b d)).op :=
          Quiver.Hom.unop_inj (Subsingleton.elim _ _)
        rw [this, hFc]
        exact (Category.assoc _ _ _).symm.trans
          ((congrArg (· ≫ (F.map (homOfLE (Nat.le_add_right b d)).op).left)
            (hstep (b + d))).trans (ih _))
    let π' : ∀ l, Z ⟶ (D.obj l).left := fun l => π (AsSmall.down.obj l).unop
    obtain ⟨l, x, hx⟩ := wc_et_limit_pull_surj_qcqs_all (π 0 ≫ f 0) (AsSmall.{u} ℕᵒᵖ) D π'
      (fun l => P0 _)
      (by
        intro l l' t
        obtain ⟨⟨a⟩⟩ := l
        obtain ⟨⟨b⟩⟩ := l'
        have hba : b ≤ a := leOfHom t.down.unop
        obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hba
        exact hcompat b d t.down)
      (by
        intro T w hw
        let w' : ∀ n, T ⟶ X n := fun n => w (AsSmall.up.obj (Opposite.op n))
        have hw' : ∀ n, w' (n + 1) ≫ tr n 1 = w' n := by
          intro n
          have := hw (AsSmall.up.map (homOfLE (Nat.le_succ n)).op)
          rw [← hFs]
          exact this
        obtain ⟨w₀, hw₀, hu⟩ := hlim T w' hw'
        refine ⟨w₀, ?_, ?_⟩
        · intro l
          obtain ⟨⟨n⟩⟩ := l
          exact hw₀ n
        · intro w₁ hw₁
          exact hu w₁ (fun n => hw₁ (AsSmall.up.obj (Opposite.op n))))
      (fun l => by
        have : IsAffine (D.obj l).left := hX (AsSmall.down.obj l).unop
        infer_instance)
      (fun l => by
        have : IsAffine (D.obj l).left := hX (AsSmall.down.obj l).unop
        infer_instance)
      (fun {l l'} t => by
        have : IsAffine (D.obj l).left := hX (AsSmall.down.obj l).unop
        have : IsAffine (D.obj l').left := hX (AsSmall.down.obj l').unop
        exact isAffineHom_of_isAffine _)
      inferInstance inferInstance m q y
    obtain ⟨⟨n⟩⟩ := l
    obtain ⟨d, hd⟩ := hkill' n x
    obtain ⟨Etr⟩ := wc_et_zmod_pull_data_exists (tr n d) m
    obtain ⟨Eπ⟩ := wc_et_zmod_pull_data_exists (π (n + d)) m
    obtain ⟨E⟩ := wc_et_zmod_pull_data_exists (π n) m
    have e1 := wc_et_pull_comp (tr n d) (π (n + d)) (π n) (P1 n d) Etr Eπ E q x
    rw [hd Etr, map_zero] at e1
    exact (hx E).symm.trans e1

  obtain ⟨hκ, hκ0, hβι, hβκ⟩ := C2
  have hspec := fun (T : Scheme.{u}) (s : ℕ → (T ⟶ Spec (.of (LaurentPolynomial L)))) hs =>
    C4 (fun n => (AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ n)) :
        LaurentPolynomial L →+* LaurentPolynomial L))
      (fun k => AddMonoidAlgebra.mapDomainRingHom L
        ((AddMonoidHom.mulLeft ((IsLocalization.Away.invSelf (ℓ : ℤ) :
          Localization.Away (ℓ : ℤ)) ^ k)).comp
          (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom))
      (fun B _ σ hσ => C3 B σ hσ) T s hs
  obtain ⟨tr, π, h1, h2, h3, h4, h5, h6, h7⟩ := C5
    (fun n => (AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ n)) :
        LaurentPolynomial L →+* LaurentPolynomial L))
    (fun k => AddMonoidAlgebra.mapDomainRingHom L
        ((AddMonoidHom.mulLeft ((IsLocalization.Away.invSelf (ℓ : ℤ) :
          Localization.Away (ℓ : ℤ)) ^ k)).comp
          (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom))
    (AddMonoidAlgebra.mapDomainRingHom L
          (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)
    hκ hκ0 hβι hβκ hspec g
  have hall := C6 (S := M)
    (fun k => Limits.pullback g (Spec.map (CommRingCat.ofHom
        (AddMonoidAlgebra.mapDomainRingHom L (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) :
          LaurentPolynomial L →+* LaurentPolynomial L))))
    (fun k => Limits.pullback.fst _ _)
    (fun k => by
      haveI := C1 k
      infer_instance)
    tr h3 h4 (fun n => h1 n 1) π h6 h7
    (fun n => by
      beta_reduce
      infer_instance)
    inferInstance ℓ (j + 1)
    (fun n x => by
      obtain ⟨d, hd⟩ := hkill n x
      exact ⟨d, fun E => hd (tr n d) (h1 n d) (h2 n d) E⟩)
  haveI : Subsingleton (wcEtZModExt (Limits.pullback g (Spec.map (CommRingCat.ofHom
      (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)))) ℓ (j + 1)) :=
    ⟨fun a b => by rw [hall a, hall b]⟩
  obtain ⟨E0⟩ := wc_et_zmodext_coh_equiv (Limits.pullback g (Spec.map (CommRingCat.ofHom
      (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)))) ℓ (j + 1)
  exact E0.symm.subsingleton

theorem wc_qmtm_tower_push_acyclic {A B L : Type u} [CommRing A] [CommRing B] [Field L]
    [IsSepClosed L] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (φA : A →+* L) (hℓL : IsUnit ((ℓ : ℕ) : L))
    (σ : L →+* L) {XE : Scheme.{u}} (p : XE ⟶ Spec (.of B)) (q : XE ⟶ Spec (.of L))
    (w : XE ⟶ XE) (x₀ : B) (T : wcQmtmTower ℓ φA σ p q w x₀)
    (Dπ : wcHMPullData T.πi ℓ) (hDπ : wcHMPullCanonical Dπ)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf T.XEi ℓ))) (n : ℕ) :
    haveI := Dπ.additive
    haveI : (wcQmtmPush Dπ).Additive := Adjunction.right_adjoint_additive Dπ.adj
    Limits.IsZero ((((wcQmtmPush Dπ).mapHomologicalComplex (ComplexShape.up ℕ)).obj
      I.cocomplex).homology (n + 1)) :=
by
  classical
  haveI := Dπ.additive
  haveI : (wcQmtmPush Dπ).Additive := Adjunction.right_adjoint_additive Dπ.adj
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf T.XEi ℓ)) := HasExt.standard _
  haveI := Dπ.cont

  have hvan : ∀ W' : XE.ProEt,
      (IsAffine W'.left ∧ IsClosed {x : W'.left | IsClosed ({x} : Set W'.left)} ∧
        (∀ x : W'.left, ∃! y : W'.left, IsClosed ({y} : Set W'.left) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : W'.left | IsClosed ({x} : Set W'.left)} ∧
        (∀ x : W'.left, IsClosed ({x} : Set W'.left) →
          HenselianLocalRing (W'.left.presheaf.stalk x) ∧ IsSepClosed (W'.left.residueField x))) →
      ∀ x : wcHM ((wcProEtBC T.πi).obj W').left ℓ (n + 1), x = 0 := by
    intro W' hV
    haveI hW'aff : IsAffine W'.left := hV.1
    haveI : IsAffine ((𝟭 Scheme.{u}).obj W'.left) := hV.1
    have hAHπ : IsAffineHom T.πi :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) T.hT.flip (isAffineHom_of_isAffine _)
    have hYaff : IsAffine ((wcProEtBC T.πi).obj W').left :=
      @AlgebraicGeometry.instIsAffinePullbackSchemeOfIsAffineHom_1 _ _ _ W'.hom T.πi hAHπ hV.1

    have hstage : ∀ (k : ℕ) (x : wcEtZModExt (Limits.pullback (W'.hom ≫ T.g₀)
        (Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
          (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) : LaurentPolynomial L →+* LaurentPolynomial L))))
        ℓ (n + 1)), x = 0 := by
      intro k x
      obtain ⟨hfin, hfp⟩ := wc_kummer_kappa_finite_fp L ℓ k
      haveI := hfin
      haveI hqf : IsFinite (Limits.pullback.fst (W'.hom ≫ T.g₀)
          (Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
            (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) : LaurentPolynomial L →+* LaurentPolynomial L)))) :=
        inferInstance
      haveI hqp : LocallyOfFinitePresentation (Limits.pullback.fst (W'.hom ≫ T.g₀)
          (Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
            (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) : LaurentPolynomial L →+* LaurentPolynomial L)))) :=
        MorphismProperty.of_isPullback (P := @LocallyOfFinitePresentation)
