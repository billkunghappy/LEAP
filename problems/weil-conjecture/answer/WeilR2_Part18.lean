    have hb : Function.Bijective
        ⇑(((SheafOfModules.pushforward Di.φ).map (Di.Φ.map v)).val.app (Opposite.op Vt)).hom := by
      refine (Function.Bijective.of_comp_iff _
        (hunit (SheafOfModules.unit (wcRingSheaf S ℓ)))).mp ?_
      have key := Di.adj.unit_naturality v
      first
