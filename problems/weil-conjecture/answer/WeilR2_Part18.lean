      (g : P W ⟶ M), ev W' M (Pm W W' b ≫ g) = (M.val.map b.op).hom (ev W M g)) :
    letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) := HasExt.standard _
    haveI := Dw.additive
    haveI := Dw.presLim
    haveI := Dw.presColim
    ∃ Θ : ∀ (q : ℕ) (W : S'.ProEt),
        Abelian.Ext (P W) (SheafOfModules.unit (wcRingSheaf S' ℓ)) q ≃+ wcHM W.left ℓ q,
      (∀ (q : ℕ) (W W' : S'.ProEt) (b : W' ⟶ W) (Db : wcHMPullData b.left ℓ),
