          Θ q W' ((Abelian.Ext.mk₀ (Pm W W' b)).comp β (zero_add q)) = wcHMPull Db q (Θ q W β)) ∧
      (∀ (q : ℕ) (W : S'.ProEt) (D : wcHMPullData (Limits.pullback.fst W.hom w) ℓ),
        wcHMPullCanonical D →
        ∀ β : Abelian.Ext (P W) (SheafOfModules.unit (wcRingSheaf S' ℓ)) q,
          Θ q ((wcProEtBC w).obj W) ((Abelian.Ext.mk₀ (wcTsfKappa Dw P ev W)).comp
