      (wc_slice_unit_isIso W.left ℓ (Scheme.ProEt.mk b.left)) (Pm W W' b) Db.μ
      H1 H2 (fun e n y => wc_hm_unit_end_central W'.left ℓ e n y) q β
  · intro q V D hD b
