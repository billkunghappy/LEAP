    (hW2 : IsClosed {x : Vt.left | IsClosed ({x} : Set Vt.left)})
    (hW3 : ∀ x : Vt.left, ∃! y : Vt.left, IsClosed ({y} : Set Vt.left) ∧ x ⤳ y)
    (hW5 : ∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
      HenselianLocalRing (Vt.left.presheaf.stalk x) ∧ IsSepClosed (Vt.left.residueField x))
    (hW6 : ∀ v : Vt.left, IsClosed ({v} : Set Vt.left) → Vt.hom v ∈ Set.range (jO ≫ ι)) :
    ∃ ρ : Limits.pullback Vt.hom p ⟶ T.XEi, ρ ≫ T.πi = Limits.pullback.snd Vt.hom p :=
by
  classical
  have hp : Nat.Prime ℓ := Fact.out
  have hℓ0 : ℓ ≠ 0 := hp.ne_zero
  have hnat : ∀ {R S : CommRingCat.{u}} (f : R ⟶ S) (y : R),
      (Spec.map f).appTop.hom ((Scheme.ΓSpecIso R).inv.hom y) =
        (Scheme.ΓSpecIso S).inv.hom (f.hom y) := by
    intro R S f y
    have h2 := congrArg (fun k => k.hom y) (Scheme.ΓSpecIso_inv_naturality f)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h2
    exact h2.symm

  have hprod : p.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom
        (wcQmtmX a₀ ⟨0, by omega⟩)) *
      p.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom
        (wcQmtmX a₀ ⟨1, by omega⟩)) =
      q.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom (φA π)) := by
    have hsum : (∑ i : Fin (r + 2), ∑ j : Fin (r + 2), MvPolynomial.C (wcQmtmC A r i j) *
        MvPolynomial.X i * MvPolynomial.X j : MvPolynomial (Fin (r + 2)) A) =
        MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩ := by
      rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
      · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
        · simp [wcQmtmC]
        · intro b _ hb
          have hb1 : b.val ≠ 1 := fun h => hb (Fin.ext h)
          simp [wcQmtmC, hb1]
        · intro h; exact absurd (Finset.mem_univ _) h
      · intro b _ hb
        apply Finset.sum_eq_zero
        intro j _
        have hb0 : b.val ≠ 0 := fun h => hb (Fin.ext h)
        simp only [wcQmtmC, Matrix.of_apply]
        rw [if_neg (fun h => hb0 h.1)]
        simp
      · intro h; exact absurd (Finset.mem_univ _) h
    have hmem : (MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩ -
        MvPolynomial.C π : MvPolynomial (Fin (r + 2)) A) ∈
        wcQuadModelIdeal A (r + 2) π (wcQmtmC A r) := by
      rw [← hsum]
      exact Ideal.subset_span (Set.mem_singleton _)
    have hquot : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X ⟨0, by omega⟩) *
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X ⟨1, by omega⟩) =
        algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)) π := by
      rw [← map_mul, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
      exact Ideal.Quotient.eq.mpr hmem
    have hw := congrArg (fun k => k.hom ((Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom π))
      (congrArg Scheme.Hom.appTop hpb.toCommSq.w)
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at hw
    rw [hnat, hnat, ← Spec.map_preimage a₀, hnat] at hw
    simp only [CommRingCat.hom_ofHom] at hw
    show p.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom
          ((Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
            (MvPolynomial.X ⟨0, by omega⟩)))) *
        p.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom
          ((Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
            (MvPolynomial.X ⟨1, by omega⟩)))) = _
    rw [← map_mul, ← map_mul, ← map_mul, hquot]
    exact hw

  have hx1 : IsUnit (Vt.hom.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom
      (wcQmtmX a₀ ⟨1, by omega⟩))) := by
    have hx1gen : ∀ f : Vt.left ⟶ Spec (CommRingCat.of B),
        (∀ v : Vt.left, IsClosed ({v} : Set Vt.left) → f v ∈ Set.range (jO ≫ ι)) →
        IsUnit (f.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom
          (wcQmtmX a₀ ⟨1, by omega⟩))) := by
      intro f hf6
      have hclosed : ∀ v : Vt.left, IsClosed ({v} : Set Vt.left) →
          v ∈ Vt.left.basicOpen (f.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom
            (wcQmtmX a₀ ⟨1, by omega⟩))) := by
        intro v hv
        obtain ⟨o, ho⟩ := hf6 v hv
        have h1 : f v = (Spec.map (CommRingCat.ofHom (algebraMap B
            (Localization.Away (wcQmtmX a₀ ⟨1, by omega⟩))))) (kO o) := by
          rw [← ho, hO.toCommSq.w, Scheme.Hom.comp_apply]
        have hb : (Spec (CommRingCat.of B)).basicOpen
            ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom (wcQmtmX a₀ ⟨1, by omega⟩)) =
            PrimeSpectrum.basicOpen (wcQmtmX a₀ ⟨1, by omega⟩) := basicOpen_eq_of_affine _
        rw [← Scheme.preimage_basicOpen_top, Scheme.Hom.mem_preimage, hb, h1, Spec.map_apply]
        refine (PrimeSpectrum.mem_basicOpen _ _).mpr ?_
        intro hmem
        have hmem' : (algebraMap B (Localization.Away (wcQmtmX a₀ ⟨1, Nat.one_lt_succ_succ r⟩)))
            (wcQmtmX a₀ ⟨1, Nat.one_lt_succ_succ r⟩) ∈ (kO o).asIdeal := hmem
        exact (kO o).isPrime.ne_top
          (Ideal.eq_top_of_isUnit_mem _ hmem' (IsLocalization.Away.algebraMap_isUnit _))
      have hall : ∀ x : Vt.left,
          x ∈ Vt.left.basicOpen (f.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom
            (wcQmtmX a₀ ⟨1, by omega⟩))) := by
        intro x
        obtain ⟨y, ⟨hy, hxy⟩, -⟩ := hW3 x
        exact hxy.mem_open (Vt.left.basicOpen _).isOpen (hclosed y hy)
      exact RingedSpace.isUnit_of_isUnit_germ Vt.left.toLocallyRingedSpace.toRingedSpace ⊤ _
        (fun x _ => (Scheme.mem_basicOpen_top _ _ _).mp (hall x))
    exact hx1gen Vt.hom hW6

  have hℓV : IsUnit ((ℓ : ℕ) : Γ(Vt.left, ⊤)) := by
    have := hℓ.map (Vt.hom.appTop.hom.comp ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom.comp
      ((Spec.preimage a₀).hom.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r))))))
    rw [map_natCast] at this
    exact this

  have hr : ∀ a : (Γ(Vt.left, ⊤))ˣ, ∃ c : (Γ(Vt.left, ⊤))ˣ, c ^ ℓ = a := by
    intro a
    obtain ⟨b, hb⟩ := wc_qmtm_wlocal_unit_root Vt.left hW2 hW3 hW5 ℓ hℓV a a.isUnit
    have hbu : IsUnit b := (isUnit_pow_iff hℓ0).mp (hb ▸ a.isUnit)
    exact ⟨hbu.unit, Units.ext (by simp [hb])⟩
  choose rt hrt using hr
  obtain ⟨x1V, hx1Vdef⟩ : ∃ x : Γ(Vt.left, ⊤), x = Vt.hom.appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom (wcQmtmX a₀ ⟨1, by omega⟩)) := ⟨_, rfl⟩
  have hx1u : IsUnit x1V := by rw [hx1Vdef]; exact hx1
  let W : ℕ → (Γ(Vt.left, ⊤))ˣ := fun j => rt^[j] hx1u.unit⁻¹
  have hW : ∀ j, W (j + 1) ^ ℓ = W j := by
    intro j
    show (rt^[j + 1] hx1u.unit⁻¹) ^ ℓ = rt^[j] hx1u.unit⁻¹
    rw [Function.iterate_succ_apply', hrt]

  have hπ0 : π ≠ 0 := by
    intro h
    apply IsDiscreteValuationRing.not_a_field A
    rw [hπ, h, Ideal.span_singleton_eq_bot.mpr rfl]
  have hφπ : φA π ≠ 0 := (map_ne_zero_iff φA hφA).mpr hπ0
  have hℓL : ((ℓ : ℕ) : L) ≠ 0 := by
    have := hℓ.map φA
    rw [map_natCast] at this
    exact this.ne_zero
  haveI : NeZero ((ℓ : ℕ) : L) := ⟨hℓL⟩
  have hrL : ∀ a : Lˣ, ∃ c : Lˣ, c ^ ℓ = a := by
    intro a
    obtain ⟨b, hb⟩ := IsSepClosed.exists_pow_nat_eq (a : L) ℓ
    have hbu : IsUnit b := (isUnit_pow_iff hℓ0).mp (hb ▸ a.isUnit)
    exact ⟨hbu.unit, Units.ext (by simp [hb])⟩
  choose rtL hrtL using hrL
  let Z : ℕ → Lˣ := fun j => rtL^[j] (Units.mk0 (φA π) hφπ)
  have hZ : ∀ j, Z (j + 1) ^ ℓ = Z j := by
    intro j
    show (rtL^[j + 1] (Units.mk0 (φA π) hφπ)) ^ ℓ = rtL^[j] (Units.mk0 (φA π) hφπ)
    rw [Function.iterate_succ_apply', hrtL]

  obtain ⟨φL, hφL⟩ : ∃ φL : L →+* Γ(Limits.pullback Vt.hom p, ⊤), ∀ c : L,
      φL c = (Limits.pullback.snd Vt.hom p).appTop.hom
        (q.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom c)) :=
    ⟨(Limits.pullback.snd Vt.hom p).appTop.hom.comp
      (q.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom), fun _ => rfl⟩
  have hpq : ∀ s : Γ(Spec (.of B), ⊤),
      (Limits.pullback.fst Vt.hom p).appTop.hom (Vt.hom.appTop.hom s) =
        (Limits.pullback.snd Vt.hom p).appTop.hom (p.appTop.hom s) := by
    intro s
    have h := congrArg (fun k => k.hom s)
      (congrArg Scheme.Hom.appTop (Limits.pullback.condition (f := Vt.hom) (g := p)))
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h
    exact h
  have hprodE : (Limits.pullback.snd Vt.hom p).appTop.hom (p.appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom (wcQmtmX a₀ ⟨0, by omega⟩))) *
      (Limits.pullback.snd Vt.hom p).appTop.hom (p.appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom (wcQmtmX a₀ ⟨1, by omega⟩))) =
      (Limits.pullback.snd Vt.hom p).appTop.hom
        (q.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom (φA π))) := by
    rw [← map_mul, hprod]
  have hξ0 : (Limits.pullback.snd Vt.hom p).appTop.hom (p.appTop.hom
        ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom (wcQmtmX a₀ ⟨0, by omega⟩))) =
      φL (φA π) * (Limits.pullback.fst Vt.hom p).appTop.hom
        ((hx1u.unit⁻¹ : (Γ(Vt.left, ⊤))ˣ) : Γ(Vt.left, ⊤)) := by
    have h1 : (Limits.pullback.fst Vt.hom p).appTop.hom
        (x1V * ((hx1u.unit⁻¹ : (Γ(Vt.left, ⊤))ˣ) : Γ(Vt.left, ⊤))) = 1 := by
      rw [hx1u.mul_val_inv, map_one]
    have hpq' : (Limits.pullback.fst Vt.hom p).appTop.hom x1V =
        (Limits.pullback.snd Vt.hom p).appTop.hom (p.appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom (wcQmtmX a₀ ⟨1, by omega⟩))) := by
      rw [hx1Vdef]; exact hpq _
    rw [map_mul, hpq'] at h1
    rw [hφL, ← hprodE, mul_assoc, h1, mul_one]
  obtain ⟨ξ, hξdef⟩ : ∃ ξ : ℕ → Γ(Limits.pullback Vt.hom p, ⊤), ∀ k,
      ξ k = φL ((Z k : Lˣ) : L) * (Limits.pullback.fst Vt.hom p).appTop.hom
        ((W k : (Γ(Vt.left, ⊤))ˣ) : Γ(Vt.left, ⊤)) := ⟨_, fun _ => rfl⟩
  have hξs : ∀ k, ξ (k + 1) ^ ℓ = ξ k := by
    intro k
    rw [hξdef, hξdef, mul_pow, ← map_pow, ← map_pow, ← Units.val_pow_eq_pow_val,
      ← Units.val_pow_eq_pow_val, hZ, hW]
  have hξu : ∀ k, IsUnit (ξ k) := by
    intro k
    rw [hξdef]
    exact ((Z k).isUnit.map φL).mul ((W k).isUnit.map _)
  obtain ⟨uu, huu⟩ : ∃ uu : ℕ → (Γ(Limits.pullback Vt.hom p, ⊤))ˣ, ∀ k,
      (uu k : Γ(Limits.pullback Vt.hom p, ⊤)) = ξ k :=
    ⟨fun k => (hξu k).unit, fun k => IsUnit.unit_spec _⟩
  have hstep : ∀ k, uu (k + 1) ^ ℓ = uu k := by
    intro k
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, huu, huu, hξs]

  obtain ⟨χ, hχ⟩ : ∃ χ : Multiplicative (Localization.Away (ℓ : ℤ)) →*
      (Γ(Limits.pullback Vt.hom p, ⊤))ˣ,
      ∀ (a : ℤ) (k : ℕ), χ (Multiplicative.ofAdd
        (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))) = uu k ^ a := by
    have hK : ∀ k j, uu (k + j) ^ (ℓ ^ j) = uu k := by
      intro k j
      induction j with
      | zero => simp
      | succ j ih =>
        rw [← ih, ← add_assoc, pow_succ', pow_mul, hstep]
    have hKz : ∀ k j (a : ℤ), uu (k + j) ^ ((ℓ : ℤ) ^ j * a) = uu k ^ a := by
      intro k j a
      have h : ((ℓ : ℤ) ^ j) = ((ℓ ^ j : ℕ) : ℤ) := by push_cast; rfl
      rw [zpow_mul, h, zpow_natCast, hK]
    have huniq : ∀ m n : ℕ, (ℓ : ℤ) ^ m = (ℓ : ℤ) ^ n → m = n := by
      intro m n h
      have h' : ℓ ^ m = ℓ ^ n := by exact_mod_cast h
      exact Nat.pow_right_injective hp.two_le h'
    let ex : Submonoid.powers (ℓ : ℤ) → ℕ := fun s =>
      Classical.choose ((Submonoid.mem_powers_iff _ _).mp s.2)
    have he : ∀ s, (ℓ : ℤ) ^ (ex s) = s := fun s =>
      Classical.choose_spec ((Submonoid.mem_powers_iff _ _).mp s.2)
    have hek : ∀ k : ℕ, ex ⟨(ℓ : ℤ) ^ k, k, rfl⟩ = k := fun k => huniq _ _ (he _)
    let f : ℤ → Submonoid.powers (ℓ : ℤ) → (Γ(Limits.pullback Vt.hom p, ⊤))ˣ :=
      fun a s => uu (ex s) ^ a
    have H : ∀ {a c : ℤ} {b d : Submonoid.powers (ℓ : ℤ)},
        (Localization.r (Submonoid.powers (ℓ : ℤ))) (a, b) (c, d) → f a b = f c d := by
      intro a c b d hr
      rw [Localization.r_iff_exists] at hr
      obtain ⟨m, hm⟩ := hr
      have hm0 : (m : ℤ) ≠ 0 := by
        rw [← he m]; exact pow_ne_zero _ (by exact_mod_cast hℓ0)
      have h2 : (d : ℤ) * a = (b : ℤ) * c := mul_left_cancel₀ hm0 hm
      rw [← he b, ← he d] at h2
      show uu (ex b) ^ a = uu (ex d) ^ c
      rw [← hKz (ex b) (ex d) a, h2, add_comm, hKz]
    let χf : Multiplicative (Localization.Away (ℓ : ℤ)) → (Γ(Limits.pullback Vt.hom p, ⊤))ˣ :=
      fun x => Localization.liftOn (Multiplicative.toAdd x) f H
    have hχf : ∀ a s, χf (Multiplicative.ofAdd (Localization.mk a s)) = uu (ex s) ^ a := by
      intro a s
      show Localization.liftOn (Localization.mk a s) f H = _
      rw [Localization.liftOn_mk]
    refine ⟨{ toFun := χf, map_one' := ?_, map_mul' := ?_ }, ?_⟩
    · show Localization.liftOn (0 : Localization.Away (ℓ : ℤ)) f H = 1
      rw [← Localization.mk_zero 1, Localization.liftOn_mk]
      simp [f]
    · intro x y
      show Localization.liftOn (Multiplicative.toAdd x + Multiplicative.toAdd y) f H =
        Localization.liftOn (Multiplicative.toAdd x) f H *
          Localization.liftOn (Multiplicative.toAdd y) f H
      generalize Multiplicative.toAdd x = X
      generalize Multiplicative.toAdd y = Y
      induction X using Localization.induction_on with
      | H p' =>
        induction Y using Localization.induction_on with
        | H p'' =>
          obtain ⟨a, s⟩ := p'
          obtain ⟨b, t⟩ := p''
          rw [Localization.add_mk, Localization.liftOn_mk, Localization.liftOn_mk,
            Localization.liftOn_mk]
          have hst : ex (s * t) = ex s + ex t := by
            apply huniq
            rw [he, pow_add, he, he, Submonoid.coe_mul]
          show uu (ex (s * t)) ^ ((s : ℤ) * b + (t : ℤ) * a) = uu (ex s) ^ a * uu (ex t) ^ b
          rw [hst, zpow_add, ← he s, ← he t, hKz, add_comm (ex s) (ex t), hKz, mul_comm]
    · intro a k
      show χf (Multiplicative.ofAdd (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩)) = _
      rw [hχf, hek]

  obtain ⟨ψ, hψ⟩ : ∃ ψ : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
      Γ(Limits.pullback Vt.hom p, ⊤),
      ∀ (x : Localization.Away (ℓ : ℤ)) (c : L), ψ (AddMonoidAlgebra.single x c) =
        φL c * ((χ (Multiplicative.ofAdd x) : (Γ(Limits.pullback Vt.hom p, ⊤))ˣ) :
          Γ(Limits.pullback Vt.hom p, ⊤)) :=
    ⟨AddMonoidAlgebra.liftNCRingHom φL ((Units.coeHom _).comp χ) (fun _ _ => Commute.all _ _),
      fun x c => by rw [AddMonoidAlgebra.liftNCRingHom_single]; rfl⟩
  have hι : ∀ (n : ℤ) (c : L), (AddMonoidAlgebra.mapDomainRingHom L
      (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) (AddMonoidAlgebra.single n c) =
      AddMonoidAlgebra.single (algebraMap ℤ (Localization.Away (ℓ : ℤ)) n) c := by
    intro n c
    rw [AddMonoidAlgebra.mapDomainRingHom_apply, AddMonoidAlgebra.mapDomain_single]
    rfl
  have hstar : ∀ y : L, T.g₀.appTop.hom
      ((Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial L))).inv.hom
        (LaurentPolynomial.C y)) =
      q.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom y) := by
    intro y
    have h1 := congrArg (fun k => k.hom ((Scheme.ΓSpecIso (CommRingCat.of L)).inv.hom y))
      (congrArg Scheme.Hom.appTop T.hg₀q)
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h1
    rw [hnat, CommRingCat.hom_ofHom] at h1
    exact h1
  have hlext : ∀ (f₁ f₂ : LaurentPolynomial L →+* Γ(Limits.pullback Vt.hom p, ⊤)),
      (∀ r, f₁ (LaurentPolynomial.C r) = f₂ (LaurentPolynomial.C r)) →
      f₁ (LaurentPolynomial.T 1) = f₂ (LaurentPolynomial.T 1) → f₁ = f₂ := by
    intro f₁ f₂ hC hT
    have hTm : f₁ (LaurentPolynomial.T (-1)) = f₂ (LaurentPolynomial.T (-1)) := by
      have e : (LaurentPolynomial.T 1 : LaurentPolynomial L) * LaurentPolynomial.T (-1) = 1 := by
        rw [← LaurentPolynomial.T_add]; simp
      have e1 := congrArg f₁ e
      have e2 := congrArg f₂ e
      rw [map_mul, map_one] at e1 e2
      calc f₁ (LaurentPolynomial.T (-1))
          = f₁ (LaurentPolynomial.T (-1)) *
              (f₂ (LaurentPolynomial.T 1) * f₂ (LaurentPolynomial.T (-1))) := by
            rw [e2, mul_one]
        _ = (f₁ (LaurentPolynomial.T 1) * f₁ (LaurentPolynomial.T (-1))) *
              f₂ (LaurentPolynomial.T (-1)) := by
            rw [← hT]; ring
        _ = f₂ (LaurentPolynomial.T (-1)) := by rw [e1, one_mul]
    apply AddMonoidAlgebra.ringHom_ext
    · intro r; exact hC r
    · intro m
      show f₁ (LaurentPolynomial.T m) = f₂ (LaurentPolynomial.T m)
      rcases Int.eq_nat_or_neg m with ⟨n, rfl | rfl⟩
      · have : (LaurentPolynomial.T (n : ℤ) : LaurentPolynomial L) =
            LaurentPolynomial.T 1 ^ n := by
          rw [LaurentPolynomial.T_pow]; simp
        rw [this, map_pow, map_pow, hT]
      · have : (LaurentPolynomial.T (-(n : ℤ)) : LaurentPolynomial L) =
            LaurentPolynomial.T (-1) ^ n := by
          rw [LaurentPolynomial.T_pow]; simp
        rw [this, map_pow, map_pow, hTm]
  have hm : algebraMap ℤ (Localization.Away (ℓ : ℤ)) 1 =
      Localization.mk 1 (⟨(ℓ : ℤ) ^ 0, 0, rfl⟩ : Submonoid.powers (ℓ : ℤ)) := by
    rw [← Localization.mk_one_eq_algebraMap]
    exact congrArg (Localization.mk 1) (Subtype.ext (by simp))

  have hw : Limits.pullback.snd Vt.hom p ≫ T.g₀ =
      ((Limits.pullback Vt.hom p).toSpecΓ ≫ Spec.map (CommRingCat.ofHom ψ)) ≫
        Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
          (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)) := by
    apply ext_of_isAffine
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop,
      Scheme.toSpecΓ_appTop, Scheme.ΓSpecIso_naturality,
      reassoc_of% (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
          (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom)))]
    rw [← cancel_epi (Scheme.ΓSpecIso (CommRingCat.of (LaurentPolynomial L))).inv,
      Iso.inv_hom_id_assoc]
    apply CommRingCat.hom_ext
    apply hlext
    · intro c
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom]
      rw [hstar, ← LaurentPolynomial.single_eq_C, hι, map_zero, hψ, ofAdd_zero, map_one,
        Units.val_one, mul_one, hφL]
    · simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom]
      rw [T.hg₀T, show (LaurentPolynomial.T 1 : LaurentPolynomial L) =
        AddMonoidAlgebra.single 1 1 from rfl, hι, hm, hψ, hχ, zpow_one, map_one, one_mul, huu,
        hξdef]
      exact hξ0
  exact ⟨T.hT.lift _ _ hw, T.hT.lift_fst _ _ hw⟩

theorem wc_qmtx1u_push_gamma_surj_of_lift {A B L : Type u} [CommRing A] [CommRing B] [Field L]
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (Dπ : wcHMPullData T.πi ℓ)
    (γN : wcSuppObj Dπ ⟶ wcSuppObj Dπ) (hγs : wcQmtmGammaSec T Dπ γN)
    (Dp : wcHMPullData p ℓ) (Vt : (Spec (.of B)).ProEt)
    [IsAffine (Limits.pullback Vt.hom p)]
    (ρ : Limits.pullback Vt.hom p ⟶ T.XEi)
    (hρ : ρ ≫ T.πi = Limits.pullback.snd Vt.hom p) :
    Function.Surjective (((wcQmtmPush Dp).map γN - 𝟙 _).val.app (Opposite.op Vt)).hom :=
by
  classical

  have hM : ∀ (X : Type u) [TopologicalSpace X] [CompactSpace X] (f : C(X × ℤ_[ℓ], ℚ_[ℓ])),
      ∃ G : C(X × ℤ_[ℓ], ℚ_[ℓ]), ∀ (x : X) (z : ℤ_[ℓ]), G (x, z + 1) - G (x, z) = f (x, z) := by
    intro X _ _ f
    haveI : IsBoundedSMul ℤ_[ℓ] C(X, ℚ_[ℓ]) := by
      refine IsBoundedSMul.of_norm_smul_le fun r g => ?_
      refine (ContinuousMap.norm_le _ (by positivity)).2 fun x => ?_
      have e : (r • g) x = (r : ℚ_[ℓ]) * g x := rfl
      rw [e, norm_mul, PadicInt.norm_def]
      exact mul_le_mul_of_nonneg_left (ContinuousMap.norm_coe_le_norm g x) (norm_nonneg _)
    let F : C(ℤ_[ℓ], C(X, ℚ_[ℓ])) := (f.comp ContinuousMap.prodSwap).curry
    let a : ℕ → C(X, ℚ_[ℓ]) := fun n => (fwdDiff 1)^[n] (⇑F) 0
    have ha : Filter.Tendsto a Filter.atTop (nhds 0) := PadicInt.fwdDiff_tendsto_zero F
    let b : ℕ → C(X, ℚ_[ℓ]) := fun n => Nat.casesOn n 0 a
    have hb : Filter.Tendsto b Filter.atTop (nhds 0) := by
      rw [← Filter.tendsto_add_atTop_iff_nat 1]
      exact ha
    let H : C(ℤ_[ℓ], C(X, ℚ_[ℓ])) := PadicInt.mahlerSeries b
    let D : C(ℤ_[ℓ], C(X, ℚ_[ℓ])) := H.comp (ContinuousMap.addRight 1) - H
    have hD : ⇑D = fwdDiff 1 ⇑H := by
      funext z
      rfl
    have hDF : D = F := by
      apply (PadicInt.mahlerEquiv (C(X, ℚ_[ℓ]))).injective
      ext1 n
      rw [PadicInt.mahlerEquiv_apply, PadicInt.mahlerEquiv_apply]
      show (fwdDiff 1)^[n] (⇑D) 0 = a n
      rw [hD, ← Function.iterate_succ_apply, PadicInt.fwdDiff_mahlerSeries hb]
    refine ⟨⟨fun y => H y.2 y.1, ?_⟩, ?_⟩
    · exact continuous_eval.comp ((H.continuous.comp continuous_snd).prodMk continuous_fst)
    · intro x z
      have := congrArg (fun K : C(ℤ_[ℓ], C(X, ℚ_[ℓ])) => K z x) hDF
      simpa [D, F] using this

  obtain ⟨κ, hκ1, hκ2⟩ : ∃ κ : Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi ⟶
      Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi,
      κ ≫ Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi =
        Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi ∧
      κ ≫ Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi =
        Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi ≫ T.γi :=
    ⟨Limits.pullback.lift (Limits.pullback.fst _ _) (Limits.pullback.snd _ _ ≫ T.γi)
      (by rw [Category.assoc, T.hγπ]; exact Limits.pullback.condition),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  obtain ⟨Θ, -, hΘκ⟩ := wc_qmtm_torsor_triv T (Limits.pullback.snd Vt.hom p) ρ hρ
  have hΘk := hΘκ κ hκ1 hκ2
  haveI : CompactSpace ↥(Limits.pullback Vt.hom p) := inferInstance
  have hsub : ∀ {M N : SheafOfModules.{u+1} (wcRingSheaf (Spec (.of B)) ℓ)} (f g : M ⟶ N),
      (f - g).val = f.val - g.val := by
    intro M N f g
    have := (SheafOfModules.forget (wcRingSheaf (Spec (.of B)) ℓ)).map_sub (f := f) (g := g)
    rw [SheafOfModules.forget_map, SheafOfModules.forget_map, SheafOfModules.forget_map] at this
    exact this
  intro t
  let f : C(↥(Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi), ULift.{u+1} ℚ_[ℓ]) := t
  let f' : C(↥(Limits.pullback Vt.hom p) × ℤ_[ℓ], ℚ_[ℓ]) :=
    ⟨fun y => (f (Θ.symm y)).down,
      continuous_uliftDown.comp (f.continuous.comp Θ.symm.continuous)⟩
  obtain ⟨G₀, hG₀⟩ := hM ↥(Limits.pullback Vt.hom p) f'
  let g : C(↥(Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi), ULift.{u+1} ℚ_[ℓ]) :=
    ⟨fun x => ULift.up (G₀ (Θ x)), continuous_uliftUp.comp (G₀.continuous.comp Θ.continuous)⟩
  let g' : ↑(((wcQmtmPush Dp).obj (wcSuppObj Dπ)).val.obj (Opposite.op Vt)) := g
  refine ⟨g', ?_⟩
  rw [hsub, PresheafOfModules.sub_app, ModuleCat.hom_sub, LinearMap.sub_apply, SheafOfModules.id_val,
    PresheafOfModules.id_app, ModuleCat.hom_id, LinearMap.id_apply]
  have key := hγs ((wcProEtBC p).obj Vt) g κ hκ1 hκ2
  have goal' : g.comp κ.base.hom - g = f := by
    refine ContinuousMap.ext fun x => ?_
    apply ULift.ext
    rw [ContinuousMap.sub_apply, ULift.sub_down, ContinuousMap.comp_apply]
    have e1 : g (κ.base.hom x) = ULift.up (G₀ ((Θ x).1, (Θ x).2 + 1)) := by
      show ULift.up (G₀ (Θ (κ x))) = _
      rw [hΘk x]
    rw [e1]
    show G₀ ((Θ x).1, (Θ x).2 + 1) - G₀ ((Θ x).1, (Θ x).2) = (f x).down
    rw [hG₀ (Θ x).1 (Θ x).2]
    show (f (Θ.symm ((Θ x).1, (Θ x).2))).down = (f x).down
    rw [Prod.mk.eta, Homeomorph.symm_apply_apply]
  have final : ∀ c : C(↥(Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi), ULift.{u+1} ℚ_[ℓ]),
      c = g.comp κ.base.hom → c - g = f := by
    intro c hc
    rw [hc]
    exact goal'
  exact final _ key

theorem wc_qmtx1u_tube_epi {A B L : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    [Field L] [IsSepClosed L]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit ((ℓ : ℕ) : A)) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (r : ℕ)
    (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r))))
    (ha₀ : WeaklyEtale a₀)
    (φA : A →+* L) (hφA : Function.Injective φA) (halg : letI := φA.toAlgebra; Algebra.IsAlgebraic A L)
    (σ : L →+* L) (hσ : σ.comp φA = φA)
    (XE : Scheme.{u}) (p : XE ⟶ Spec (.of B)) (q : XE ⟶ Spec (.of L))
    (hpb : IsPullback p q (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) (Spec.map (CommRingCat.ofHom φA)))
    (Xs : Scheme.{u}) (ι : Xs ⟶ Spec (.of B)) (s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A)))
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) (wcQmSp A))
    (w : XE ⟶ XE) (hw₁ : w ≫ p = p) (hw₂ : w ≫ q = q ≫ Spec.map (CommRingCat.ofHom σ))
    (T : wcQmtmTower ℓ φA σ p q w (wcQmtmX a₀ ⟨0, by omega⟩))
    (Dπ : wcHMPullData T.πi ℓ) (hDπ : wcHMPullCanonical Dπ)
    (Dp : wcHMPullData p ℓ) (hDp : wcHMPullCanonical Dp)
    (Di : wcHMPullData ι ℓ) (hDi : wcHMPullCanonical Di)
    (γN : wcSuppObj Dπ ⟶ wcSuppObj Dπ) (hγs : wcQmtmGammaSec T Dπ γN) :
    ∀ (O : Scheme.{u}) (jO : O ⟶ Xs)
      (kO : O ⟶ Spec (.of (Localization.Away (wcQmtmX a₀ ⟨1, by omega⟩)))),
      IsPullback jO kO ι (Spec.map (CommRingCat.ofHom (algebraMap B
        (Localization.Away (wcQmtmX a₀ ⟨1, by omega⟩))))) →
      ∀ (DO : wcHMPullData jO ℓ), wcHMPullCanonical DO →
      Epi (DO.Φ.map (Di.Φ.map ((wcQmtmPush Dp).map γN) - 𝟙 _)) :=
by
  classical
  intro O jO kO hO DO hDO
  haveI hιc : IsClosedImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps.flip
      (IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue A))
        IsLocalRing.residue_surjective)
  haveI hjO : IsOpenImmersion jO :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) hO.flip
      (IsOpenImmersion.of_isLocalization (R := B) (wcQmtmX a₀ ⟨1, Nat.one_lt_succ_succ r⟩))
  haveI hpA : IsAffineHom p :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) hpb.flip inferInstance
  exact wc_qmtm_restr_epi_of_thick ι jO ℓ Di hDi DO hDO _ ((wcQmtmPush Dp).map γN)
    (fun Vt hW1 hW2 hW3 _ hW5 hW6 _ => by
      haveI := hW1
      haveI hfA : IsAffineHom (Limits.pullback.fst Vt.hom p) :=
        MorphismProperty.of_isPullback (P := @IsAffineHom)
          (IsPullback.of_hasPullback Vt.hom p).flip hpA
      haveI : IsAffine (Limits.pullback Vt.hom p) :=
        @isAffine_of_isAffineHom _ _ (Limits.pullback.fst Vt.hom p) hfA hW1
      obtain ⟨ρ, hρ⟩ := wc_qmtx1u_thick_tower_lift ℓ hℓ π hπ r a₀ φA hφA σ XE p q hpb Xs ι w T
        O jO kO hO Vt hW2 hW3 hW5 hW6
      exact wc_qmtx1u_push_gamma_surj_of_lift T Dπ γN hγs Dp Vt ρ hρ)

theorem wc_qmtm_tube_x1_of_unit_eq {A B L : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    [Field L] [IsSepClosed L]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit ((ℓ : ℕ) : A)) (π : A)
