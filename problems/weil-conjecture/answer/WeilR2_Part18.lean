theorem wc_qmbt_tq_hens_tensor_sqrt {A A' R : Type u} [CommRing A] [CommRing A'] [CommRing R]
    (ιA : A →+* A') (ρ : A →+* R) {π : A} {π' : A'} (hπ'2 : π' ^ 2 = ιA π)
    (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    [HenselianRing R (Ideal.span {ρ π})] :
    letI := ρ.toAlgebra
    letI := ιA.toAlgebra
    HenselianRing (TensorProduct A R A') (Ideal.span {(1 : R) ⊗ₜ[A] π'}) :=
by
  have hHR0 : HenselianRing R (Ideal.span {ρ π}) := ‹HenselianRing R (Ideal.span {ρ π})›


  have L2 : ∀ (R₀ S₀ : Type u) [CommRing R₀] [CommRing S₀] [Algebra R₀ S₀]
      [Module.Finite R₀ S₀] (J₀ : Ideal R₀), J₀ ≤ (⊥ : Ideal R₀).jacobson →
      J₀.map (algebraMap R₀ S₀) ≤ (⊥ : Ideal S₀).jacobson := by
    intro R₀ S₀ _ _ _ _ J₀ hJ
    rw [Ideal.map_le_iff_le_comap]
    intro j hj
    rw [Ideal.mem_comap, Ideal.jacobson, Ideal.mem_sInf]
    rintro M ⟨-, hM⟩
    have hint : (algebraMap R₀ S₀).IsIntegral :=
      fun x => Algebra.IsIntegral.isIntegral (R := R₀) x
    haveI := hM
    have hMc := Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap R₀ S₀) hint M
    have := hJ hj
    rw [Ideal.jacobson, Ideal.mem_sInf] at this
    exact this ⟨bot_le, hMc⟩

  have L3 : ∀ (R₀ : Type u) [CommRing R₀] (J₀ : Ideal R₀), J₀ ≤ (⊥ : Ideal R₀).jacobson →
      ∀ (G H : Polynomial R₀), G.Monic →
      IsCoprime (G.map (Ideal.Quotient.mk J₀)) (H.map (Ideal.Quotient.mk J₀)) →
      IsCoprime G H := by
    intro R₀ _ J₀ hJ G H hG hcop
    obtain ⟨a, b, hab⟩ := hcop
    obtain ⟨u, rfl⟩ := Polynomial.map_surjective _ Ideal.Quotient.mk_surjective a
    obtain ⟨v, rfl⟩ := Polynomial.map_surjective _ Ideal.Quotient.mk_surjective b
    have hw : ∀ n, (u * G + v * H - 1).coeff n ∈ J₀ := by
      intro n
      rw [← Ideal.Quotient.eq_zero_iff_mem, ← Polynomial.coeff_map]
      have : (u * G + v * H - 1).map (Ideal.Quotient.mk J₀) = 0 := by
        simp only [Polynomial.map_sub, Polynomial.map_add, Polynomial.map_mul,
          Polynomial.map_one, hab, sub_self]
      rw [this, Polynomial.coeff_zero]
    haveI : Module.Finite R₀ (AdjoinRoot G) := (AdjoinRoot.powerBasis' hG).finite
    have hjac := L2 R₀ (AdjoinRoot G) J₀ hJ
    have hwm : AdjoinRoot.mk G (u * G + v * H - 1) ∈ J₀.map (algebraMap R₀ (AdjoinRoot G)) := by
      rw [← AdjoinRoot.aeval_eq, Polynomial.aeval_eq_sum_range]
      refine Ideal.sum_mem _ (fun i _ => ?_)
      rw [Algebra.smul_def]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hw i))
    have hunit := Ideal.mem_jacobson_bot.mp (hjac hwm) 1
    have heq : AdjoinRoot.mk G (u * G + v * H - 1) * 1 + 1 =
        AdjoinRoot.mk G v * AdjoinRoot.mk G H := by
      simp [map_sub, map_add, map_mul, AdjoinRoot.mk_self]
    rw [heq] at hunit
    have hH : IsUnit (AdjoinRoot.mk G H) := isUnit_of_mul_isUnit_right hunit
    obtain ⟨s', hs'⟩ := hH.exists_left_inv
    obtain ⟨s, rfl⟩ := AdjoinRoot.mk_surjective s'
    rw [← map_mul, ← sub_eq_zero, ← map_one (AdjoinRoot.mk G), ← map_sub,
      AdjoinRoot.mk_eq_zero] at hs'
    obtain ⟨k, hk⟩ := hs'
    exact ⟨-k, s, by linear_combination hk⟩


  have L4 : ∀ (R₀ : Type u) [CommRing R₀] (J₀ : Ideal R₀),
      (∀ (P : Polynomial R₀) (g₀ h₀ : Polynomial (R₀ ⧸ J₀)), P.Monic → g₀.Monic → h₀.Monic →
        P.map (Ideal.Quotient.mk J₀) = g₀ * h₀ → IsCoprime g₀ h₀ →
        ∃ g h : Polynomial R₀, g.Monic ∧ h.Monic ∧ P = g * h ∧
          g.map (Ideal.Quotient.mk J₀) = g₀ ∧ h.map (Ideal.Quotient.mk J₀) = h₀ ∧
          IsCoprime g h) →
      ∀ (B : Type u) [CommRing B] [Algebra R₀ B] [Module.Finite R₀ B] (b : B),
      b * b - b ∈ J₀.map (algebraMap R₀ B) →
      ∃ e : B, IsIdempotentElem e ∧ e - b ∈ J₀.map (algebraMap R₀ B) := by
    intro R₀ _ J hfl B _ _ _ b hb
    rcases subsingleton_or_nontrivial R₀ with hR | hR
    · haveI : Subsingleton B := Module.subsingleton R₀ B
      exact ⟨b, Subsingleton.elim _ _, by rw [sub_self]; exact zero_mem _⟩
    have hrange : LinearMap.range (Algebra.lmul R₀ B (b * b - b)) ≤
        J • (⊤ : Submodule R₀ B) := by
      rintro _ ⟨x, rfl⟩
      rw [Ideal.smul_top_eq_map, Submodule.restrictScalars_mem, Algebra.coe_lmul_eq_mul,
        LinearMap.mul_apply']
      exact Ideal.mul_mem_right _ _ hb
    obtain ⟨q, hqm, -, hqc, hq0⟩ :=
      LinearMap.exists_monic_and_coeff_mem_pow_and_aeval_eq_zero_of_range_le_smul R₀
        (Algebra.lmul R₀ B (b * b - b)) J hrange
    have hqc0 : Polynomial.aeval (b * b - b) q = 0 := by
      have h1 : Algebra.lmul R₀ B (Polynomial.aeval (b * b - b) q) = 0 := by
        rw [← Polynomial.aeval_algHom_apply]; exact hq0
      have h2 := DFunLike.congr_fun h1 1
      rw [Algebra.coe_lmul_eq_mul, LinearMap.mul_apply', mul_one] at h2
      exact h2
    obtain ⟨n, hn⟩ : ∃ n, n = q.natDegree + 1 := ⟨_, rfl⟩
    have hg0m : (Polynomial.X * q).Monic := Polynomial.monic_X.mul hqm
    have hg0map : (Polynomial.X * q).map (Ideal.Quotient.mk J) = Polynomial.X ^ n := by
      ext m
      rw [Polynomial.coeff_map, Polynomial.coeff_X_pow]
      rcases m with _ | k
      · simp [hn]
      · rw [Polynomial.coeff_X_mul]
        rcases lt_trichotomy k q.natDegree with hk | hk | hk
        · rw [if_neg (by omega), Ideal.Quotient.eq_zero_iff_mem]
          exact Ideal.pow_le_self (by omega) (hqc k)
        · rw [if_pos (by omega), hk, hqm.coeff_natDegree, map_one]
        · rw [if_neg (by omega), Polynomial.coeff_eq_zero_of_natDegree_lt hk, map_zero]
    have hinm : (Polynomial.X * (Polynomial.X - Polynomial.C 1) : Polynomial R₀).Monic :=
      Polynomial.monic_X.mul (Polynomial.monic_X_sub_C 1)
    have hindeg : (Polynomial.X * (Polynomial.X - Polynomial.C 1) :
        Polynomial R₀).natDegree ≠ 0 := by
      rw [Polynomial.monic_X.natDegree_mul (Polynomial.monic_X_sub_C 1),
        Polynomial.natDegree_X, Polynomial.natDegree_X_sub_C]; omega
    have hPm : ((Polynomial.X * q).comp
        (Polynomial.X * (Polynomial.X - Polynomial.C 1))).Monic := hg0m.comp hinm hindeg
    have hPmap : ((Polynomial.X * q).comp
        (Polynomial.X * (Polynomial.X - Polynomial.C 1))).map (Ideal.Quotient.mk J) =
        Polynomial.X ^ n * (Polynomial.X - Polynomial.C 1) ^ n := by
      rw [Polynomial.map_comp, hg0map, Polynomial.X_pow_comp, ← mul_pow]
      simp
    have hcop : IsCoprime (Polynomial.X ^ n : Polynomial (R₀ ⧸ J))
        ((Polynomial.X - Polynomial.C 1) ^ n) := by
      apply IsCoprime.pow
      exact ⟨1, -1, by rw [Polynomial.C_1]; ring⟩
    obtain ⟨g, h, hg, hh, hPgh, hgm, hhm, u, v, huv⟩ :=
      hfl _ _ _ hPm (Polynomial.monic_X_pow n) ((Polynomial.monic_X_sub_C 1).pow n) hPmap hcop
    have hP0 : Polynomial.aeval b ((Polynomial.X * q).comp
        (Polynomial.X * (Polynomial.X - Polynomial.C 1))) = 0 := by
      rw [Polynomial.aeval_comp]
      have : Polynomial.aeval b (Polynomial.X * (Polynomial.X - Polynomial.C 1) :
          Polynomial R₀) = b * b - b := by simp; ring
      rw [this, map_mul, Polynomial.aeval_X, hqc0, mul_zero]
    have hsum : Polynomial.aeval b (u * g) + Polynomial.aeval b (v * h) = 1 := by
      rw [← map_add, huv, map_one]
    have hEid : IsIdempotentElem (Polynomial.aeval b (u * g)) := by
      have h1 : Polynomial.aeval b (u * g) * Polynomial.aeval b (v * h) = 0 := by
        have : u * g * (v * h) = (u * v) * (g * h) := by ring
        rw [← map_mul, this, map_mul, ← hPgh, hP0, mul_zero]
      have h2 : Polynomial.aeval b (v * h) = 1 - Polynomial.aeval b (u * g) := by
        rw [← hsum]; ring
      rw [h2, mul_sub, mul_one, sub_eq_zero] at h1
      exact h1.symm
    have hψ : ∀ p : Polynomial R₀,
        Ideal.Quotient.mk (J.map (algebraMap R₀ B)) (Polynomial.aeval b p) =
        Polynomial.eval₂ (Ideal.quotientMap (J.map (algebraMap R₀ B)) (algebraMap R₀ B)
          Ideal.le_comap_map)
          (Ideal.Quotient.mk (J.map (algebraMap R₀ B)) b) (p.map (Ideal.Quotient.mk J)) := by
      intro p
      rw [Polynomial.eval₂_map, Ideal.quotientMap_comp_mk, Polynomial.aeval_def,
        Polynomial.hom_eval₂]
    have hβ : IsIdempotentElem (Ideal.Quotient.mk (J.map (algebraMap R₀ B)) b) := by
      show _ * _ = _
      rw [← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]; exact hb
    set β := Ideal.Quotient.mk (J.map (algebraMap R₀ B)) b with hβdef
    set ψ := Ideal.quotientMap (J.map (algebraMap R₀ B)) (algebraMap R₀ B) Ideal.le_comap_map
    have hUV : Polynomial.eval₂ ψ β (u.map (Ideal.Quotient.mk J)) * β ^ n +
        Polynomial.eval₂ ψ β (v.map (Ideal.Quotient.mk J)) * (β - 1) ^ n = 1 := by
      have := congrArg (fun p => Polynomial.eval₂ ψ β (p.map (Ideal.Quotient.mk J))) huv
      simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_one, hgm, hhm,
        Polynomial.eval₂_add, Polynomial.eval₂_mul, Polynomial.eval₂_one, Polynomial.eval₂_pow,
        Polynomial.eval₂_X, Polynomial.eval₂_sub, map_one] at this
      exact this
    have hβn : β ^ n = β := by rw [hn]; exact hβ.pow_succ_eq _
    have hβ1 : (β - 1) ^ n * β = 0 := by
      rw [hn, pow_succ, mul_assoc, sub_mul, one_mul, hβ.eq, sub_self, mul_zero]
    have hUβ : Polynomial.eval₂ ψ β (u.map (Ideal.Quotient.mk J)) * β = β := by
      have : (Polynomial.eval₂ ψ β (u.map (Ideal.Quotient.mk J)) * β ^ n +
          Polynomial.eval₂ ψ β (v.map (Ideal.Quotient.mk J)) * (β - 1) ^ n) * β = 1 * β := by
        rw [hUV]
      rw [add_mul, mul_assoc (Polynomial.eval₂ ψ β (v.map (Ideal.Quotient.mk J))), hβ1,
        mul_zero, add_zero, one_mul, hβn] at this
      rw [mul_assoc, hβ.eq] at this
      exact this
    refine ⟨Polynomial.aeval b (u * g), hEid, ?_⟩
    rw [← Ideal.Quotient.eq, hψ, Polynomial.map_mul, hgm, Polynomial.eval₂_mul,
      Polynomial.eval₂_pow, Polynomial.eval₂_X, hβn]
    exact hUβ

  have L7 : ∀ (A₀ : Type u) [CommRing A₀] (I₀ : Ideal A₀), I₀ ≤ (⊥ : Ideal A₀).jacobson →
      (∀ (P : Polynomial A₀) (g₀ h₀ : Polynomial (A₀ ⧸ I₀)), P.Monic → g₀.Monic → h₀.Monic →
        P.map (Ideal.Quotient.mk I₀) = g₀ * h₀ → IsCoprime g₀ h₀ →
        ∃ g h : Polynomial A₀, g.Monic ∧ h.Monic ∧ P = g * h ∧
          g.map (Ideal.Quotient.mk I₀) = g₀ ∧ h.map (Ideal.Quotient.mk I₀) = h₀) →
      HenselianRing A₀ I₀ := by
    intro A₀ _ I hI hfl
    refine HenselianRing.mk hI ?_
    intro f hf a₀ hfa₀ hunit
    rcases subsingleton_or_nontrivial (A₀ ⧸ I) with hQ | hQ
    · have h1 : (1 : A₀) ∈ I := by
        rw [← Ideal.Quotient.eq_zero_iff_mem]; exact Subsingleton.elim _ _
      have hu := Ideal.mem_jacobson_bot.mp (hI h1) (-1)
      rw [mul_neg_one, neg_add_cancel, isUnit_zero_iff] at hu
      haveI : Subsingleton A₀ := subsingleton_of_zero_eq_one hu
      exact ⟨a₀, Subsingleton.elim _ _, by rw [sub_self]; exact zero_mem _⟩
    · have hroot : (f.map (Ideal.Quotient.mk I)).IsRoot (Ideal.Quotient.mk I a₀) := by
        show Polynomial.eval _ _ = 0
        rw [Polynomial.eval_map, Polynomial.eval₂_hom, Ideal.Quotient.eq_zero_iff_mem]
        exact hfa₀
      set a := Ideal.Quotient.mk I a₀ with ha
      set h₀ := f.map (Ideal.Quotient.mk I) /ₘ (Polynomial.X - Polynomial.C a) with hh₀def
      have hfac : (Polynomial.X - Polynomial.C a) * h₀ = f.map (Ideal.Quotient.mk I) :=
        Polynomial.mul_divByMonic_eq_iff_isRoot.mpr hroot
      have hh₀ : h₀.Monic :=
        Polynomial.Monic.of_mul_monic_left (Polynomial.monic_X_sub_C a) (hfac ▸ hf.map _)
      have hw : IsUnit (Polynomial.eval a h₀) := by
        have e1 := congrArg (fun p => Polynomial.eval a (Polynomial.derivative p)) hfac
        simp only [Polynomial.derivative_mul, Polynomial.derivative_sub,
          Polynomial.derivative_X, Polynomial.derivative_C, sub_zero, one_mul,
          Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X,
          Polynomial.eval_C, sub_self, zero_mul, add_zero] at e1
        rw [e1, Polynomial.derivative_map, Polynomial.eval_map, Polynomial.eval₂_hom]
        exact hunit
      obtain ⟨w', hw'⟩ := hw.exists_left_inv
      have e := Polynomial.modByMonic_add_div h₀ (Polynomial.X - Polynomial.C a)
      rw [Polynomial.modByMonic_X_sub_C_eq_C_eval] at e
      have hC : Polynomial.C w' * Polynomial.C (Polynomial.eval a h₀) = 1 := by
        rw [← Polynomial.C_mul, hw', Polynomial.C_1]
      have hcop : IsCoprime (Polynomial.X - Polynomial.C a) h₀ :=
        ⟨-(Polynomial.C w' * (h₀ /ₘ (Polynomial.X - Polynomial.C a))), Polynomial.C w',
          by linear_combination (-(Polynomial.C w')) * e + hC⟩
      obtain ⟨g, h, hg, hh, hfgh, hgm, hhm⟩ :=
        hfl f (Polynomial.X - Polynomial.C a) h₀ hf (Polynomial.monic_X_sub_C a) hh₀
          hfac.symm hcop
      have hdeg : g.natDegree = 1 := by
        rw [← hg.natDegree_map (Ideal.Quotient.mk I), hgm, Polynomial.natDegree_X_sub_C]
      have hc0 : Ideal.Quotient.mk I (g.coeff 0) = -a := by
        have := congrArg (fun p => p.coeff 0) hgm
        simpa using this
      have hdecomp := hg.eq_X_add_C hdeg
      set c0 := g.coeff 0 with hc0def
      refine ⟨-c0, ?_, ?_⟩
      · show Polynomial.eval _ f = 0
        rw [hfgh, Polynomial.eval_mul, hdecomp]
        simp
      · rw [← Ideal.Quotient.eq, map_neg, hc0, neg_neg]

  have L8 : ∀ (R₀ S : Type u) [CommRing R₀] [CommRing S] [Algebra R₀ S] [Module.Finite R₀ S]
      (j : R₀), HenselianRing R₀ (Ideal.span {j}) → ∀ (t : S), algebraMap R₀ S j = t ^ 2 →
      HenselianRing S (Ideal.span {t}) := by
    intro R₀ S _ _ _ _ j hHR t ht
    have hJjac : Ideal.span {j} ≤ (⊥ : Ideal R₀).jacobson := hHR.jac
    have hJS := L2 R₀ S _ hJjac
    have hI' : Ideal.span {t} ≤ (⊥ : Ideal S).jacobson := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      show t ∈ (⊥ : Ideal S).jacobson
      have ht2 : t ^ 2 ∈ (⊥ : Ideal S).jacobson := by
        rw [← ht]; exact hJS (Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self j))
      rw [Ideal.jacobson, Ideal.mem_sInf] at ht2 ⊢
      rintro M ⟨hM0, hM⟩
      exact hM.isPrime.mem_of_pow_mem 2 (ht2 ⟨hM0, hM⟩)
    have hflR : ∀ (P : Polynomial R₀) (g₀ h₀ : Polynomial (R₀ ⧸ Ideal.span {j})), P.Monic →
        g₀.Monic → h₀.Monic → P.map (Ideal.Quotient.mk (Ideal.span {j})) = g₀ * h₀ →
        IsCoprime g₀ h₀ →
        ∃ g h : Polynomial R₀, g.Monic ∧ h.Monic ∧ P = g * h ∧
          g.map (Ideal.Quotient.mk (Ideal.span {j})) = g₀ ∧
          h.map (Ideal.Quotient.mk (Ideal.span {j})) = h₀ ∧ IsCoprime g h := by
      intro P g₀ h₀ hP hg₀ hh₀ hfac hcop
      obtain ⟨g, h, hg, hh, hPgh, hgm, hhm⟩ :=
        wc_hp_lift_coprime_factorization_of_section R₀ (Ideal.span {j})
          (fun R₁ _ _ _ J₁ _ σ₀ => wc_hp_finite_away_section_lift R₀ (Ideal.span {j}) hJjac
            (fun B _ _ _ b hb hrk =>
              wc_hp_rank_one_idempotent_lift R₀ (Ideal.span {j}) B b hb hrk)
            R₁ J₁ σ₀)
          P hP g₀ h₀ hg₀ hh₀ hfac hcop
      exact ⟨g, h, hg, hh, hPgh, hgm, hhm,
        L3 R₀ (Ideal.span {j}) hJjac g h hg (by rw [hgm, hhm]; exact hcop)⟩
    have hR1 : ∀ (B : Type u) [CommRing B] [Algebra S B] [Module.Finite S B] (b : B),
        b * b - b ∈ (Ideal.span {t}).map (algebraMap S B) →
        (∀ x : B, ∃ a : S, b * x - algebraMap S B a * b ∈
          (Ideal.span {t}).map (algebraMap S B)) →
        ∃ e : B, IsIdempotentElem e ∧ e - b ∈ (Ideal.span {t}).map (algebraMap S B) := by
      intro B _ _ _ b hb _
      letI : Algebra R₀ B := ((algebraMap S B).comp (algebraMap R₀ S)).toAlgebra
      haveI : IsScalarTower R₀ S B := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
      haveI : Module.Finite R₀ B := Module.Finite.trans S B
      have hmap : (Ideal.span {t}).map (algebraMap S B) = Ideal.span {algebraMap S B t} := by
        rw [Ideal.map_span, Set.image_singleton]
      rw [hmap] at hb ⊢
      obtain ⟨y, hy⟩ := Ideal.mem_span_singleton'.mp hb
      have hτ2 : (algebraMap S B t) ^ 2 = algebraMap R₀ B j := by
        rw [IsScalarTower.algebraMap_apply R₀ S B, ht, map_pow]
      have hb₁ : (3 * b ^ 2 - 2 * b ^ 3) * (3 * b ^ 2 - 2 * b ^ 3) - (3 * b ^ 2 - 2 * b ^ 3) ∈
          (Ideal.span {j}).map (algebraMap R₀ B) := by
        have : (3 * b ^ 2 - 2 * b ^ 3) * (3 * b ^ 2 - 2 * b ^ 3) - (3 * b ^ 2 - 2 * b ^ 3) =
            (y ^ 2 * (4 * (b * b - b) - 3)) * algebraMap R₀ B j := by
          rw [← hτ2]
          linear_combination (-(b * b - b + y * algebraMap S B t) * (4 * (b * b - b) - 3)) * hy
        rw [this]
        exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (Ideal.mem_span_singleton_self j))
      have hb₁b : (3 * b ^ 2 - 2 * b ^ 3) - b ∈ Ideal.span {algebraMap S B t} :=
        Ideal.mem_span_singleton'.mpr
          ⟨-(2 * b - 1) * y, by linear_combination (-(2 * b - 1)) * hy⟩
      obtain ⟨e, he, heb₁⟩ := L4 R₀ (Ideal.span {j}) hflR B _ hb₁
      have hle : (Ideal.span {j}).map (algebraMap R₀ B) ≤ Ideal.span {algebraMap S B t} := by
        rw [Ideal.map_span, Set.image_singleton, ← hτ2, Ideal.span_singleton_le_span_singleton]
        exact dvd_pow_self _ two_ne_zero
      refine ⟨e, he, ?_⟩
      have : e - b = (e - (3 * b ^ 2 - 2 * b ^ 3)) + ((3 * b ^ 2 - 2 * b ^ 3) - b) := by ring
      rw [this]
      exact add_mem (hle heb₁) hb₁b
    exact L7 S (Ideal.span {t}) hI' (fun P g₀ h₀ hP hg₀ hh₀ hfac hcop =>
      wc_hp_lift_coprime_factorization_of_section S (Ideal.span {t})
        (fun R₁ _ _ _ J₁ _ σ₀ =>
          wc_hp_finite_away_section_lift S (Ideal.span {t}) hI' hR1 R₁ J₁ σ₀)
        P hP g₀ h₀ hg₀ hh₀ hfac hcop)

  letI := ρ.toAlgebra
  letI := ιA.toAlgebra
  have hfin : Module.Finite R (TensorProduct A R A') := by
    classical
    refine ⟨⟨{(1 : R) ⊗ₜ[A] (1 : A'), (1 : R) ⊗ₜ[A] π'}, ?_⟩⟩
    rw [eq_top_iff]
    intro x _
    induction x using TensorProduct.induction_on with
    | zero => exact zero_mem _
    | tmul r a =>
      obtain ⟨x, y, rfl⟩ := hgen a
      have e1 : r ⊗ₜ[A] (ιA x + ιA y * π') =
          (ρ x * r) • ((1 : R) ⊗ₜ[A] (1 : A')) + (ρ y * r) • ((1 : R) ⊗ₜ[A] π') := by
        rw [TensorProduct.tmul_add, TensorProduct.smul_tmul', TensorProduct.smul_tmul',
          smul_eq_mul, smul_eq_mul, mul_one, mul_one]
        have h1 : ιA x = x • (1 : A') := by rw [Algebra.smul_def, mul_one]; rfl
        have h2 : ιA y * π' = y • π' := by rw [Algebra.smul_def]; rfl
        have h3 : ρ x * r = x • r := by rw [Algebra.smul_def]; rfl
        have h4 : ρ y * r = y • r := by rw [Algebra.smul_def]; rfl
        rw [h1, h2, h3, h4, TensorProduct.smul_tmul, TensorProduct.smul_tmul]
      rw [e1]
      refine add_mem (Submodule.smul_mem _ _ (Submodule.subset_span ?_))
        (Submodule.smul_mem _ _ (Submodule.subset_span ?_))
      · simp
      · simp
    | add x y hx hy => exact add_mem (hx (Submodule.mem_top)) (hy (Submodule.mem_top))
  have ht : algebraMap R (TensorProduct A R A') (ρ π) = ((1 : R) ⊗ₜ[A] π') ^ 2 := by
    rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_pow, one_pow,
      Algebra.algebraMap_self, RingHom.id_apply, hπ'2]
    have h1 : ρ π = π • (1 : R) := by rw [Algebra.smul_def, mul_one]; rfl
    have h2 : ιA π = π • (1 : A') := by rw [Algebra.smul_def, mul_one]; rfl
    rw [h1, h2, TensorProduct.smul_tmul]
  exact L8 R (TensorProduct A R A') (ρ π) hHR0 ((1 : R) ⊗ₜ[A] π') ht

theorem wc_qmbt_tq_thickening_geometry {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {n : ℕ} {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    {B₀ : Type u} [CommRing B₀]
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    (hprop : IsProper (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))))
    {L' : Type u} [Field L'] {φ' : A' →+* L'}
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    (R : Type u) [CommRing R] (I : Ideal R) (Vt : (Spec (.of B₀)).ProEt)
    (e : Vt.left ≅ Spec (.of R)) (cR : Limits.pullback Vt.hom ι ⟶ Spec (.of (R ⧸ I)))
    (hVt : IsPullback (Limits.pullback.fst Vt.hom ι) cR e.hom
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))) :
    ∃ ρ : A →+* R, I = Ideal.span {ρ π} ∧
      (letI := ρ.toAlgebra
       letI := ιA.toAlgebra
       ∃ (πW : ((wcProEtBC (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)))).obj Vt).left ⟶
              Spec (.of (TensorProduct A R A')))
         (cW : Limits.pullback ((wcProEtBC (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)))).obj Vt).hom ι' ⟶
              Spec (.of (TensorProduct A R A' ⧸ Ideal.span {(1 : R) ⊗ₜ[A] π'}))),
         IsProper πW ∧
         IsPullback (Limits.pullback.fst ((wcProEtBC (bl ≫ Limits.pullback.fst
            (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))).obj Vt).hom ι')
            cW πW
            (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {(1 : R) ⊗ₜ[A] π'})))) ∧
         CompactSpace ((wcProEtBC (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)))).obj Vt).left ∧
         QuasiSeparatedSpace ((wcProEtBC (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
            (Spec.map (CommRingCat.ofHom ιA)))).obj Vt).left ∧
         CompactSpace ((wcProEtBC ι').obj ((wcProEtBC (bl ≫ Limits.pullback.fst
            (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))).obj Vt)).left ∧
         QuasiSeparatedSpace ((wcProEtBC ι').obj ((wcProEtBC (bl ≫ Limits.pullback.fst
            (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))).obj Vt)).left ∧
         CompactSpace ((wcProEtBC p').obj ((wcProEtBC (bl ≫ Limits.pullback.fst
            (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))).obj Vt)).left ∧
         QuasiSeparatedSpace ((wcProEtBC p').obj ((wcProEtBC (bl ≫ Limits.pullback.fst
            (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))).obj Vt)).left) :=
by
  classical

  have s3 : ∀ {S S' : Scheme.{u}} (g : S' ⟶ S) (V : S.ProEt),
      ∃ fst : ((wcProEtBC g).obj V).left ⟶ V.left,
        IsPullback fst ((wcProEtBC g).obj V).hom V.hom g := by
    intro S S' g V
    exact ⟨Limits.pullback.fst V.hom g, IsPullback.of_hasPullback V.hom g⟩
  set βm := bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
    (Spec.map (CommRingCat.ofHom ιA)) with hβm
  set Wt := (wcProEtBC βm).obj Vt with hWt

  obtain ⟨ρ, hρ⟩ : ∃ ρ : A →+* R, Spec.map (CommRingCat.ofHom ρ) =
      e.inv ≫ Vt.hom ≫ (a₀ ≫ wcQuadModelStr A n π c) :=
    ⟨(Spec.preimage (e.inv ≫ Vt.hom ≫ (a₀ ≫ wcQuadModelStr A n π c))).hom, by
      rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
  have hρ' : e.hom ≫ Spec.map (CommRingCat.ofHom ρ) = Vt.hom ≫ (a₀ ≫ wcQuadModelStr A n π c) := by
    rw [hρ, Iso.hom_inv_id_assoc]

  have P0 : IsPullback (Limits.pullback.fst Vt.hom ι) (Limits.pullback.snd Vt.hom ι ≫ s)
      (Vt.hom ≫ (a₀ ≫ wcQuadModelStr A n π c)) (wcQmSp A) :=
    ((IsPullback.of_hasPullback Vt.hom ι).flip.paste_horiz hps.flip).flip
  have P0' : IsPullback (Limits.pullback.fst Vt.hom ι ≫ e.hom) (Limits.pullback.snd Vt.hom ι ≫ s)
      (Spec.map (CommRingCat.ofHom ρ)) (wcQmSp A) :=
    IsPullback.of_iso P0 (Iso.refl _) e (Iso.refl _) (Iso.refl _) (by simp) (by simp)
      (by simp [hρ']) (by simp)
  haveI hcR : IsIso cR := hVt.flip.isIso_fst_of_isIso
  have hres : IsLocalRing.residue A π = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff, hπ]; exact Ideal.mem_span_singleton_self π
  have hle1 : Ideal.span {ρ π} ≤ I := by
    rw [Ideal.span_singleton_le_iff_mem]
    have h3 : inv cR ≫ Limits.pullback.fst Vt.hom ι ≫ e.hom =
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) := by
      rw [hVt.w, IsIso.inv_hom_id_assoc]
    have hw0 : Limits.pullback.fst Vt.hom ι ≫ e.hom ≫ Spec.map (CommRingCat.ofHom ρ) =
        Limits.pullback.snd Vt.hom ι ≫ s ≫ wcQmSp A := by
      simpa only [Category.assoc] using P0'.w
    have e1 : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) ≫ Spec.map (CommRingCat.ofHom ρ) =
        (inv cR ≫ Limits.pullback.snd Vt.hom ι ≫ s) ≫ wcQmSp A := by
      rw [← h3]
      simp only [Category.assoc]
      rw [hw0]
    obtain ⟨τ, hτ⟩ : ∃ τ, Spec.map τ = inv cR ≫ Limits.pullback.snd Vt.hom ι ≫ s :=
      ⟨_, Spec.map_preimage _⟩
    have e2 : CommRingCat.ofHom ρ ≫ CommRingCat.ofHom (Ideal.Quotient.mk I) =
        CommRingCat.ofHom (IsLocalRing.residue A) ≫ τ := by
      apply Spec.map_injective
      rw [Spec.map_comp, Spec.map_comp, e1, hτ]
    have e3 := congrArg (fun φ => φ.hom π) e2
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at e3
    rw [hres, map_zero] at e3
    exact Ideal.Quotient.eq_zero_iff_mem.mp e3
  have hle2 : I ≤ Ideal.span {ρ π} := by
    have H : ∀ x ∈ IsLocalRing.maximalIdeal A,
        ((Ideal.Quotient.mk (Ideal.span {ρ π})).comp ρ) x = 0 := by
      intro x hx
      rw [hπ, Ideal.mem_span_singleton'] at hx
      obtain ⟨a, rfl⟩ := hx
      rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, map_mul]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    let lam : IsLocalRing.ResidueField A →+* R ⧸ Ideal.span {ρ π} :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal A) _ H
    have hcomm : CommRingCat.ofHom ρ ≫ CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ρ π})) =
        CommRingCat.ofHom (IsLocalRing.residue A) ≫ CommRingCat.ofHom lam := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro a
      rfl
    have hw2 : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ρ π}))) ≫
        Spec.map (CommRingCat.ofHom ρ) = Spec.map (CommRingCat.ofHom lam) ≫ wcQmSp A := by
      show _ = Spec.map (CommRingCat.ofHom lam) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))
      rw [← Spec.map_comp, ← Spec.map_comp, hcomm]
    obtain ⟨u, hu⟩ : ∃ u, u ≫ (Limits.pullback.fst Vt.hom ι ≫ e.hom) =
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ρ π}))) :=
      ⟨P0'.lift _ _ hw2, P0'.lift_fst _ _ _⟩
    obtain ⟨ν, hν⟩ : ∃ ν, Spec.map ν = u ≫ cR := ⟨_, Spec.map_preimage _⟩
    have e4 : CommRingCat.ofHom (Ideal.Quotient.mk I) ≫ ν =
        CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ρ π})) := by
      apply Spec.map_injective
      rw [Spec.map_comp, hν, Category.assoc, ← hVt.w, hu]
    intro x hx
    have e5 := congrArg (fun φ => φ.hom x) e4
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at e5
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hx, map_zero] at e5
    exact Ideal.Quotient.eq_zero_iff_mem.mp e5.symm
  have hI : I = Ideal.span {ρ π} := le_antisymm hle2 hle1

  letI instR : Algebra A R := ρ.toAlgebra
  letI instA' : Algebra A A' := ιA.toAlgebra
  obtain ⟨jR, hjR⟩ : ∃ j : A' →+* TensorProduct A R A',
      j = (Algebra.TensorProduct.includeRight : A' →ₐ[A] TensorProduct A R A').toRingHom :=
    ⟨_, rfl⟩
  have hjR' : jR π' = (1 : R) ⊗ₜ[A] π' := by rw [hjR]; rfl
  have hT : IsPullback
      (Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct A R A')))
      (Spec.map (CommRingCat.ofHom jR)) (Spec.map (CommRingCat.ofHom ρ))
      (Spec.map (CommRingCat.ofHom ιA)) := by
    subst hjR
    exact isPullback_SpecMap_of_isPushout _ _ _ _ (CommRingCat.isPushout_tensorProduct A R A')

  obtain ⟨fstW, hW⟩ := s3 βm Vt
  have hβg : βm ≫ (a₀ ≫ wcQuadModelStr A n π c) = f ≫ Spec.map (CommRingCat.ofHom ιA) := by
    rw [hβm, Category.assoc, Limits.pullback.condition, ← Category.assoc, hblf]

  have hw : (fstW ≫ e.hom) ≫ Spec.map (CommRingCat.ofHom ρ) =
      (Wt.hom ≫ f) ≫ Spec.map (CommRingCat.ofHom ιA) := by
    calc (fstW ≫ e.hom) ≫ Spec.map (CommRingCat.ofHom ρ)
        = fstW ≫ (e.hom ≫ Spec.map (CommRingCat.ofHom ρ)) := Category.assoc _ _ _
      _ = fstW ≫ (Vt.hom ≫ (a₀ ≫ wcQuadModelStr A n π c)) := by rw [hρ']
      _ = (fstW ≫ Vt.hom) ≫ (a₀ ≫ wcQuadModelStr A n π c) := (Category.assoc _ _ _).symm
      _ = (Wt.hom ≫ βm) ≫ (a₀ ≫ wcQuadModelStr A n π c) := by rw [hW.w]
      _ = Wt.hom ≫ (βm ≫ (a₀ ≫ wcQuadModelStr A n π c)) := Category.assoc _ _ _
      _ = Wt.hom ≫ (f ≫ Spec.map (CommRingCat.ofHom ιA)) := by rw [hβg]
      _ = (Wt.hom ≫ f) ≫ Spec.map (CommRingCat.ofHom ιA) := (Category.assoc _ _ _).symm
  obtain ⟨πW, hπW1, hπW2⟩ : ∃ πW : Wt.left ⟶ Spec (.of (TensorProduct A R A')),
      πW ≫ Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct A R A')) = fstW ≫ e.hom ∧
      πW ≫ Spec.map (CommRingCat.ofHom jR) = Wt.hom ≫ f :=
    ⟨hT.lift _ _ hw, hT.lift_fst _ _ _, hT.lift_snd _ _ _⟩

  haveI hfstWp : IsProper fstW := MorphismProperty.of_isPullback (P := @IsProper) hW.flip hprop
  haveI : IsProper (πW ≫ Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct A R A'))) := by
    rw [hπW1]; infer_instance
  haveI hπWp : IsProper πW := IsProper.of_comp πW (Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct A R A')))

  have hJ : ∀ x ∈ IsLocalRing.maximalIdeal A',
      ((Ideal.Quotient.mk (Ideal.span {(1 : R) ⊗ₜ[A] π'})).comp jR) x = 0 := by
    intro x hx
    rw [hπ', Ideal.mem_span_singleton'] at hx
    obtain ⟨a, rfl⟩ := hx
    rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem, map_mul, hjR']
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
  let θ : IsLocalRing.ResidueField A' →+*
      TensorProduct A R A' ⧸ Ideal.span {(1 : R) ⊗ₜ[A] π'} :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal A') _ hJ
  have hres' : IsLocalRing.residue A' π' = 0 := by
    rw [IsLocalRing.residue_eq_zero_iff, hπ']; exact Ideal.mem_span_singleton_self π'
  have heq : CommRingCat.ofHom jR ≫
      CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {(1 : R) ⊗ₜ[A] π'})) =
      CommRingCat.ofHom (IsLocalRing.residue A') ≫ CommRingCat.ofHom θ := by
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro a
    rfl
  have H1 : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom jR)
      (CommRingCat.ofHom (IsLocalRing.residue A')),
      ∀ x ∈ Ideal.span {(1 : R) ⊗ₜ[A] π'}, s.inl.hom x = 0 := by
    intro s x hx
    obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hx
    have hc := congrArg (fun φ => φ.hom π') s.condition
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at hc
    rw [hres', map_zero, hjR'] at hc
    rw [map_mul, hc, mul_zero]
  have hpo : IsPushout (CommRingCat.ofHom jR) (CommRingCat.ofHom (IsLocalRing.residue A'))
      (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {(1 : R) ⊗ₜ[A] π'})))
      (CommRingCat.ofHom θ) :=
    IsPushout.of_isColimit (Limits.PushoutCocone.IsColimit.mk heq
      (fun s => CommRingCat.ofHom (Ideal.Quotient.lift _ s.inl.hom (H1 s)))
      (fun s => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        rfl)
      (fun s => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro y
        obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective y
        have hc := congrArg (fun φ => φ.hom a) s.condition
        exact hc)
      (fun s m h1 _ => by
        apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply RingHom.ext
        intro x
        have := congrArg (fun φ => φ.hom x) h1
        exact this))
  have hB : IsPullback
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {(1 : R) ⊗ₜ[A] π'}))))
      (Spec.map (CommRingCat.ofHom θ)) (Spec.map (CommRingCat.ofHom jR)) (wcQmSp A') :=
    isPullback_SpecMap_of_isPushout _ _ _ _ hpo
  have Big : IsPullback (Limits.pullback.fst Wt.hom ι') (Limits.pullback.snd Wt.hom ι' ≫ s')
      (Wt.hom ≫ f) (wcQmSp A') :=
    ((IsPullback.of_hasPullback Wt.hom ι').flip.paste_horiz hps'.flip).flip
  have wc : (Limits.pullback.fst Wt.hom ι' ≫ πW) ≫ Spec.map (CommRingCat.ofHom jR) =
      (Limits.pullback.snd Wt.hom ι' ≫ s') ≫ wcQmSp A' := by
    simp only [Category.assoc]
    rw [hπW2, Limits.pullback.condition_assoc, hps'.w]
  obtain ⟨cW, hcW1, hcW2⟩ : ∃ cW : Limits.pullback Wt.hom ι' ⟶
      Spec (.of (TensorProduct A R A' ⧸ Ideal.span {(1 : R) ⊗ₜ[A] π'})),
      cW ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {(1 : R) ⊗ₜ[A] π'}))) =
        Limits.pullback.fst Wt.hom ι' ≫ πW ∧
      cW ≫ Spec.map (CommRingCat.ofHom θ) = Limits.pullback.snd Wt.hom ι' ≫ s' :=
    ⟨hB.lift _ _ wc, hB.lift_fst _ _ _, hB.lift_snd _ _ _⟩
  have hsq : IsPullback (Limits.pullback.fst Wt.hom ι') cW πW
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {(1 : R) ⊗ₜ[A] π'})))) := by
    refine IsPullback.of_bot ?_ hcW1.symm hB
    rw [hcW2, hπW2]
    exact Big

  haveI hc1 : CompactSpace Wt.left := QuasiCompact.compactSpace_of_compactSpace πW
  haveI hq1 : QuasiSeparatedSpace Wt.left := quasiSeparatedSpace_of_quasiSeparated πW
  have hQm : IsClosedImmersion (wcQmSp A') := by
    delta wcQmSp
    first
      | exact IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
      | infer_instance
  haveI hι'c : IsClosedImmersion ι' :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps'.flip hQm
  obtain ⟨fst₁, h₁⟩ := s3 ι' Wt
  haveI : IsClosedImmersion fst₁ :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) h₁.flip hι'c
  haveI hp'a : IsAffineHom p' :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) hpb'.flip inferInstance
  obtain ⟨fst₂, h₂⟩ := s3 p' Wt
  haveI : IsAffineHom fst₂ := MorphismProperty.of_isPullback (P := @IsAffineHom) h₂.flip hp'a
  refine ⟨ρ, hI, ?_⟩
  exact ⟨πW, cW, hπWp, hsq, hc1, hq1, QuasiCompact.compactSpace_of_compactSpace fst₁,
    quasiSeparatedSpace_of_quasiSeparated fst₁, QuasiCompact.compactSpace_of_compactSpace fst₂,
    quasiSeparatedSpace_of_quasiSeparated fst₂⟩

theorem wc_tq_quasiIso_iff_cone_exact {C : Type*} [Category C] [Abelian C]
    {X Y : CochainComplex C ℤ} (φ : X ⟶ Y) :
    QuasiIso φ ↔ ∀ q : ℤ, (CochainComplex.mappingCone φ).ExactAt q :=
by
  refine ((HomologicalComplex.mem_quasiIso_iff φ).symm.trans
    (HomotopyCategory.quotient_map_mem_quasiIso_iff φ).symm).trans ?_
  rw [HomotopyCategory.quasiIso_eq_trW_subcategoryAcyclic]
  exact ((HomotopyCategory.subcategoryAcyclic C).trW_iff_of_distinguished _
    (HomotopyCategory.mappingCone_triangleh_distinguished φ)).trans
    (HomotopyCategory.quotient_obj_mem_subcategoryAcyclic_iff_exactAt _)

theorem wc_tq_zmod_free_corep (S : Scheme.{u}) (m : ℕ) (W : S.ProEt) :
    ∃ (Q : SheafOfModules.{u+1} (wcZModRingSheaf S m))
      (e : ∀ M : SheafOfModules.{u+1} (wcZModRingSheaf S m), (Q ⟶ M) ≃ (wcZModSecEv S m W).obj M),
      ∀ (M N : SheafOfModules.{u+1} (wcZModRingSheaf S m)) (ψ : M ⟶ N) (f : Q ⟶ M),
        e N (f ≫ ψ) = ((wcZModSecEv S m W).map ψ).hom (e M f) :=
by
  let R := wcZModRingSheaf S m
  let adj := (PresheafOfModules.freeAdjunction.{u+1} R.obj).comp
    (PresheafOfModules.sheafificationAdjunction (𝟙 R.obj))
  refine ⟨(PresheafOfModules.sheafification (𝟙 R.obj)).obj
      ((PresheafOfModules.free.{u+1} R.obj).obj (uliftYoneda.{u+1}.obj W)),
    fun M => (adj.homEquiv (uliftYoneda.{u+1}.obj W) M).trans uliftYonedaEquiv, ?_⟩
  intro M N ψ f
  show uliftYonedaEquiv (adj.homEquiv _ _ (f ≫ ψ)) = _
  rw [Adjunction.homEquiv_naturality_right, uliftYonedaEquiv_comp]
  rfl

theorem wc_tq_inj_complex_cocycle_exact_int {C : Type*} [Category C] [Abelian C] (P : C)
    (X : CochainComplex C ℤ) (n₀ : ℤ) (hX : X.IsStrictlyGE n₀) (hXi : ∀ n, Injective (X.X n))
    (hExt : letI := HasExt.standard C
      ∀ (p : ℕ) (q : ℤ), Subsingleton (Abelian.Ext P (X.homology q) p))
    (q : ℤ) (c : P ⟶ X.X q) (hc : c ≫ X.d q (q + 1) = 0) :
    ∃ e : P ⟶ X.X (q - 1), e ≫ X.d (q - 1) q = c :=
by
  letI := HasExt.standard C
  have hExt' : ∀ (p : ℕ) (q : ℤ), Subsingleton (Abelian.Ext P (X.homology q) p) := hExt

  have sA : ∀ n : ℤ, ∃ w : Abelian.image.ι (X.toCycles n (n + 1)) ≫ X.homologyπ (n + 1) = 0,
      (ShortComplex.mk _ _ w).ShortExact := by
    intro n
    have w : Abelian.image.ι (X.toCycles n (n + 1)) ≫ X.homologyπ (n + 1) = 0 := by
      rw [← cancel_epi (Abelian.factorThruImage (X.toCycles n (n + 1))), Limits.comp_zero,
        ← Category.assoc, Abelian.image.fac, HomologicalComplex.toCycles_comp_homologyπ]
    refine ⟨w, ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance⟩
    apply ShortComplex.exact_of_g_is_cokernel
    exact Limits.isCokernelOfComp _ _ (X.homologyIsCokernel n (n + 1) (by simp)) w
      (Abelian.image.fac _)

  have sB : ∀ n : ℤ, ∃ w : X.iCycles n ≫ Abelian.factorThruImage (X.toCycles n (n + 1)) = 0,
      (ShortComplex.mk _ _ w).ShortExact := by
    intro n
    have key : Abelian.factorThruImage (X.toCycles n (n + 1)) ≫
        (Abelian.image.ι (X.toCycles n (n + 1)) ≫ X.iCycles (n + 1)) = X.d n (n + 1) := by
      rw [← Category.assoc, Abelian.image.fac, HomologicalComplex.toCycles_i]
    have w : X.iCycles n ≫ Abelian.factorThruImage (X.toCycles n (n + 1)) = 0 := by
      rw [← cancel_mono (Abelian.image.ι (X.toCycles n (n + 1)) ≫ X.iCycles (n + 1)),
        Limits.zero_comp, Category.assoc, key, HomologicalComplex.iCycles_d]
    refine ⟨w, ShortComplex.ShortExact.mk' ?_ inferInstance inferInstance⟩
    apply ShortComplex.exact_of_f_is_kernel
    exact Limits.isKernelOfComp _ _ (X.cyclesIsKernel n (n + 1) (by simp)) w key

  have hZ0 : ∀ n, n < n₀ → Limits.IsZero (X.cycles n) := fun n hn =>
    Limits.IsZero.of_mono (X.iCycles n) ((CochainComplex.isStrictlyGE_iff X n₀).mp hX n hn)

  have step : ∀ n : ℤ, (∀ (p : ℕ) (x : Abelian.Ext P (X.cycles n) (p + 1)), x = 0) →
      ∀ (p : ℕ) (x : Abelian.Ext P (X.cycles (n + 1)) (p + 1)), x = 0 := by
    intro n ih p x
    obtain ⟨wA, hA⟩ := sA n
    obtain ⟨wB, hB⟩ := sB n
    obtain ⟨y, hy⟩ := Abelian.Ext.covariant_sequence_exact₂ P hA x
      (@Subsingleton.elim _ (hExt' (p + 1) (n + 1)) _ _)
    obtain ⟨w', hw'⟩ := Abelian.Ext.covariant_sequence_exact₃ P hB y
      (rfl : (p + 1) + 1 = p + 2) (ih (p + 1) _)
    have hw0 : w' = 0 := by
      haveI := hXi n
      exact Abelian.Ext.eq_zero_of_injective w'
    rw [← hy, ← hw', hw0, Abelian.Ext.zero_comp, Abelian.Ext.zero_comp]
  have base : ∀ m, m < n₀ → ∀ (p : ℕ) (x : Abelian.Ext P (X.cycles m) (p + 1)), x = 0 := by
    intro m hm p x
    haveI : Injective (X.cycles m) := (hZ0 m hm).injective
    exact Abelian.Ext.eq_zero_of_injective x
  have key : ∀ k : ℕ, ∀ (p : ℕ) (x : Abelian.Ext P (X.cycles (n₀ - 1 + k)) (p + 1)), x = 0 := by
    intro k
    induction k with
    | zero =>
      rw [Nat.cast_zero, add_zero]
      exact base (n₀ - 1) (by omega)
    | succ k ih =>
      rw [show n₀ - 1 + ((k + 1 : ℕ) : ℤ) = (n₀ - 1 + k) + 1 by push_cast; ring]
      exact step _ ih
  have hdim : ∀ (n : ℤ) (p : ℕ) (x : Abelian.Ext P (X.cycles n) (p + 1)), x = 0 := by
    intro n
    rcases lt_or_ge n n₀ with h | h
    · exact base n h
    · obtain ⟨k, hk⟩ : ∃ k : ℕ, n = n₀ - 1 + k := ⟨(n - (n₀ - 1)).toNat, by omega⟩
      subst hk
      exact key k

  obtain ⟨j, rfl⟩ : ∃ j, q = j + 1 := ⟨q - 1, by omega⟩
  rw [show j + 1 - 1 = j by omega]
  obtain ⟨k, hk⟩ : ∃ k, k ≫ X.iCycles (j + 1) = c :=
    ⟨_, X.liftCycles_i c (j + 1 + 1) (by simp) hc⟩
  obtain ⟨wA, hA⟩ := sA j
  obtain ⟨wB, hB⟩ := sB j
  have h1 : k ≫ X.homologyπ (j + 1) = 0 := by
    apply (Abelian.Ext.mk₀_bijective P (X.homology (j + 1))).1
    exact @Subsingleton.elim _ (hExt' 0 (j + 1)) _ _
  haveI := hA.mono_f
  obtain ⟨b, hb⟩ : ∃ b, b ≫ Abelian.image.ι (X.toCycles j (j + 1)) = k :=
    ⟨_, hA.exact.lift_f k h1⟩
  obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hB (Abelian.Ext.mk₀ b)
    (zero_add 1) (hdim j 0 _)
  refine ⟨Abelian.Ext.homEquiv₀ x₂, ?_⟩
  have he : Abelian.Ext.homEquiv₀ x₂ ≫ Abelian.factorThruImage (X.toCycles j (j + 1)) = b := by
    apply (Abelian.Ext.mk₀_bijective _ _).1
    rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
    exact hx₂
  calc Abelian.Ext.homEquiv₀ x₂ ≫ X.d j (j + 1)
      = Abelian.Ext.homEquiv₀ x₂ ≫ (Abelian.factorThruImage (X.toCycles j (j + 1)) ≫
          Abelian.image.ι (X.toCycles j (j + 1))) ≫ X.iCycles (j + 1) := by
        rw [Abelian.image.fac, HomologicalComplex.toCycles_i]
    _ = c := by rw [Category.assoc, reassoc_of% he, reassoc_of% hb, hk]

theorem wc_tq_zmod_contfun_pullback_locally_bijective : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) (n : ℕ),
    (∀ (V' : S'.ProEt) (r' : C(↥V'.left, ULift.{u+1} (ZMod n))),
      ∃ T ∈ Scheme.ProEt.topology S' V', ∀ ⦃W' : S'.ProEt⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (V : S.ProEt) (a : W' ⟶ (wcProEtBC f).obj V) (r : C(↥V.left, ULift.{u+1} (ZMod n))),
          r'.comp g.left.base.hom =
            (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom) ∧
    (∀ (V' : S'.ProEt) (V : S.ProEt) (a : V' ⟶ (wcProEtBC f).obj V)
      (r : C(↥V.left, ULift.{u+1} (ZMod n))),
      (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom = 0 →
      ∃ T ∈ Scheme.ProEt.topology S' V', ∀ ⦃W' : S'.ProEt⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (W : S.ProEt) (b : W ⟶ V) (a' : W' ⟶ (wcProEtBC f).obj W),
          a' ≫ (wcProEtBC f).map b = g ≫ a ∧ r.comp b.left.base.hom = 0) :=
by
  intro S S' f n

  have H1 : ∀ (V : S'.ProEt) (R : Sieve V), (∀ x : ↥V.left, ∃ (W : S'.ProEt) (g : W ⟶ V),
      R.arrows g ∧ IsOpenImmersion g.left ∧ x ∈ Set.range g.left) →
      R ∈ Scheme.ProEt.topology S' V := by
    intro V R hR
    choose W g hgR hgo hgx using hR
    have hZ : Presieve.ofArrows (fun x => (W x).left) (fun x => (g x).left) ∈
        (Scheme.precoverage @IsOpenImmersion).coverings V.left :=
      (Scheme.ofArrows_mem_precoverage_iff _).mpr ⟨fun x => ⟨x, hgx x⟩, fun x => hgo x⟩
    have hP : Presieve.ofArrows W g ∈ (Scheme.ProEt.precoverage S').coverings V := by
      show _ ∈ (Precoverage.comap (Scheme.ProEt.forget S' ⋙ Over.forget S')
        Scheme.proetalePrecoverage).coverings V
      rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
      change Presieve.ofArrows (fun x => (W x).left) (fun x => (g x).left) ∈
        Scheme.proetalePrecoverage.coverings V.left
      exact ⟨Scheme.zariskiPrecoverage_le_qcPrecoverage V.left hZ, hZ.1,
        MorphismProperty.ofArrows_mem_precoverage.mpr (fun x => inferInstance)⟩
    refine GrothendieckTopology.superset_covering _ ?_ (Precoverage.generate_mem_toGrothendieck hP)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨x⟩
    exact hgR x
  refine ⟨fun V' r' => ?_, fun V' V a r hr => ?_⟩
  ·
    let T : Sieve V' :=
      { arrows := fun W' g => ∃ (V : S.ProEt) (a : W' ⟶ (wcProEtBC f).obj V)
            (r : C(↥V.left, ULift.{u+1} (ZMod n))),
            r'.comp g.left.base.hom =
              (r.comp (Limits.pullback.fst V.hom f).base.hom).comp a.left.base.hom
        downward_closed := by
          rintro Y Z g ⟨V, a, r, h⟩ k
          exact ⟨V, k ≫ a, r,
            ContinuousMap.ext fun z => congrArg (fun ψ : C(_, _) => ψ (k.left.base z)) h⟩ }
    refine ⟨T, H1 V' T ?_, fun W' g hg => hg⟩
    intro x
    let O : V'.left.Opens := ⟨r' ⁻¹' {r' x}, (isOpen_discrete _).preimage r'.continuous⟩
    have hxO : x ∈ O := Set.mem_singleton (r' x)
    haveI : WeaklyEtale V'.hom := V'.prop
    let W : S'.ProEt := Scheme.ProEt.mk (O.ι ≫ V'.hom)
    let g : W ⟶ V' := MorphismProperty.Over.homMk O.ι rfl trivial
    refine ⟨W, g, ?_, (inferInstance : IsOpenImmersion O.ι), ?_⟩
    swap
    · exact (Set.ext_iff.mp (Scheme.Opens.range_ι O) x).mpr hxO
    let V : S.ProEt := Scheme.ProEt.mk (𝟙 S)
    let aL : O.toScheme ⟶ Limits.pullback (𝟙 S) f :=
      Limits.pullback.lift (O.ι ≫ V'.hom ≫ f) (O.ι ≫ V'.hom)
        (by rw [Category.comp_id, Category.assoc])
    let a : W ⟶ (wcProEtBC f).obj V :=
      MorphismProperty.Over.homMk aL (Limits.pullback.lift_snd _ _ _) trivial
    refine ⟨V, a, ContinuousMap.const _ (r' x), ?_⟩
    apply ContinuousMap.ext
    intro z
    have hz : O.ι.base z ∈ O := (Set.ext_iff.mp (Scheme.Opens.range_ι O) _).mp ⟨z, rfl⟩
    exact hz
  ·
    refine ⟨⊤, GrothendieckTopology.top_mem _ V', fun W' g _ => ?_⟩
    let O : V.left.Opens := ⟨r ⁻¹' {0}, (isOpen_discrete _).preimage r.continuous⟩
    haveI : WeaklyEtale V.hom := V.prop
    let W : S.ProEt := Scheme.ProEt.mk (O.ι ≫ V.hom)
    let b : W ⟶ V := MorphismProperty.Over.homMk O.ι rfl trivial
    have hb0 : r.comp b.left.base.hom = 0 := by
      apply ContinuousMap.ext
      intro w
      have hw : O.ι.base w ∈ O := (Set.ext_iff.mp (Scheme.Opens.range_ι O) _).mp ⟨w, rfl⟩
      exact hw
    let φ : W'.left ⟶ V.left := g.left ≫ a.left ≫ Limits.pullback.fst V.hom f
    have hφ : Set.range φ ⊆ Set.range O.ι := by
      rintro _ ⟨w, rfl⟩
      apply (Set.ext_iff.mp (Scheme.Opens.range_ι O) _).mpr
