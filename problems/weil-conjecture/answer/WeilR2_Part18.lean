    · have hmon : (Polynomial.X ^ N - Polynomial.C π).Monic := Polynomial.monic_X_pow_sub_C π hN.ne'
      haveI : Module.Finite A (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) :=
