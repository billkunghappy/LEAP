theorem wc_qmtm_tower_fibre_ring {A B L : Type u} [CommRing A] [CommRing B] [Field L]
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {π : A} {r : ℕ}
    (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r))))
    (φA : A →+* L) {σ : L →+* L} {XE : Scheme.{u}} (p : XE ⟶ Spec (.of B)) (q : XE ⟶ Spec (.of L))
    (hpb : IsPullback p q (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
      (Spec.map (CommRingCat.ofHom φA)))
    {w : XE ⟶ XE} (T : wcQmtmTower ℓ φA σ p q w (wcQmtmX a₀ ⟨0, by omega⟩))
    (R : Type u) [CommRing R] (c : Spec (.of R) ⟶ Spec (.of B)) :
    letI : Algebra A R := ((Spec.preimage (c ≫ a₀)).hom.comp
      (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
    letI : Algebra A L := φA.toAlgebra
    ∃ e : LaurentPolynomial L →+* TensorProduct A L R,
      e (LaurentPolynomial.T 1) = (1 : L) ⊗ₜ[A] (Spec.preimage (c ≫ a₀)).hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∧
      (letI := e.toAlgebra
       letI := (AddMonoidAlgebra.mapDomainRingHom L
         (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom).toAlgebra
       ConnectedSpace (PrimeSpectrum (TensorProduct (LaurentPolynomial L) (TensorProduct A L R)
         (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))) →
       ConnectedSpace ↥(Limits.pullback c (T.πi ≫ p))) :=
by
  classical

  have s1 : ∀ {A L R : Type u} [CommRing A] [CommRing L] [CommRing R]
      [Algebra A L] [Algebra A R] {Y XE : Scheme.{u}} (p : XE ⟶ Y) (q : XE ⟶ Spec (.of L))
      (s : Y ⟶ Spec (.of A))
      (hpb : IsPullback p q s (Spec.map (CommRingCat.ofHom (algebraMap A L))))
      (c : Spec (.of R) ⟶ Y) (hc : c ≫ s = Spec.map (CommRingCat.ofHom (algebraMap A R))),
      ∃ E : Limits.pullback c p ≅ Spec (.of (TensorProduct A L R)),
        E.hom ≫ Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : R →ₐ[A] TensorProduct A L R).toRingHom) =
        Limits.pullback.fst c p := by
    intro A L R _ _ _ _ _ Y XE p q s hpb c hc
    have H3 := IsPullback.paste_horiz (IsPullback.of_hasPullback c p).flip hpb.flip
    rw [hc] at H3
    refine ⟨H3.isoPullback ≪≫ pullbackSpecIso A L R, ?_⟩
    rw [Iso.trans_hom, Category.assoc]
    erw [pullbackSpecIso_hom_snd]
    exact H3.isoPullback_hom_snd

  have s2 : ∀ {G₀ G M : Type u} [CommRing G₀] [CommRing G] [CommRing M]
      (ι : G₀ →+* G) {P XE XEi : Scheme.{u}} (s : P ⟶ XE) (πi : XEi ⟶ XE)
      (gi : XEi ⟶ Spec (.of G)) (g₀ : XE ⟶ Spec (.of G₀))
      (hT : IsPullback πi gi g₀ (Spec.map (CommRingCat.ofHom ι)))
      (E : P ≅ Spec (.of M)) (e : G₀ →+* M)
      (he : E.hom ≫ Spec.map (CommRingCat.ofHom e) = s ≫ g₀),
      letI := e.toAlgebra
      letI := ι.toAlgebra
      Nonempty (Limits.pullback s πi ≅ Spec (.of (TensorProduct G₀ M G))) := by
    intro G₀ G M _ _ _ ι P XE XEi s πi gi g₀ hT E e he
    letI := e.toAlgebra
    letI := ι.toAlgebra
    have HB := IsPullback.paste_vert (IsPullback.of_hasPullback s πi) hT
    have HC : IsPullback (Limits.pullback.fst s πi ≫ E.hom) (Limits.pullback.snd s πi ≫ gi)
        (Spec.map (CommRingCat.ofHom (algebraMap G₀ M)))
        (Spec.map (CommRingCat.ofHom (algebraMap G₀ G))) :=
      IsPullback.of_iso HB (Iso.refl _) E (Iso.refl _) (Iso.refl _) (by simp) (by simp)
        (by simp only [Iso.refl_hom, Category.comp_id]; exact he.symm) (by simp)
    exact ⟨HC.isoPullback ≪≫ pullbackSpecIso G₀ M G⟩

  have s3 : ∀ {B R M G₀ : CommRingCat.{u}} {XE : Scheme.{u}}
      (c : Spec R ⟶ Spec B) (p : XE ⟶ Spec B) (g₀ : XE ⟶ Spec G₀)
      (E : Limits.pullback c p ≅ Spec M) (j : R ⟶ M)
      (hE : E.hom ≫ Spec.map j = Limits.pullback.fst c p) (t : G₀) (x : B)
      (hg : g₀.appTop.hom ((Scheme.ΓSpecIso G₀).inv.hom t) =
        p.appTop.hom ((Scheme.ΓSpecIso B).inv.hom x)),
      (Spec.preimage (E.inv ≫ Limits.pullback.snd c p ≫ g₀)).hom t =
        j.hom ((Spec.preimage c).hom x) := by
    intro B R M G₀ XE c p g₀ E j hE t x hg
    have hα : ∀ {S R' : CommRingCat.{u}} (h : Spec S ⟶ Spec R') (r : R'),
        (Spec.preimage h).hom r =
          (Scheme.ΓSpecIso S).hom.hom (h.appTop.hom ((Scheme.ΓSpecIso R').inv.hom r)) := by
      intro S R' h r
      obtain ⟨f, rfl⟩ : ∃ f, Spec.map f = h := ⟨_, Spec.map_preimage h⟩
      rw [Spec.preimage_map]
      have := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso R').inv.hom r))
        (Scheme.ΓSpecIso_naturality f)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      rw [this]
      simp
    have hj' : Spec.map j = E.inv ≫ Limits.pullback.fst c p := (Iso.eq_inv_comp E).mpr hE
    have hcomp : E.inv ≫ Limits.pullback.snd c p ≫ p = Spec.map (Spec.preimage c ≫ j) := by
      rw [← Limits.pullback.condition, Spec.map_comp, Spec.map_preimage, hj', Category.assoc]
    have h2 : (E.inv ≫ Limits.pullback.snd c p ≫ g₀).appTop.hom ((Scheme.ΓSpecIso G₀).inv.hom t)
        = (E.inv ≫ Limits.pullback.snd c p ≫ p).appTop.hom ((Scheme.ΓSpecIso B).inv.hom x) := by
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, hg]
    rw [hα, h2, hcomp, ← hα, Spec.preimage_map, CommRingCat.hom_comp, RingHom.comp_apply]

  letI iAR : Algebra A R := ((Spec.preimage (c ≫ a₀)).hom.comp
      (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
  letI iAL : Algebra A L := φA.toAlgebra
  have hc : c ≫ (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) =
      Spec.map (CommRingCat.ofHom (algebraMap A R)) := by
    rw [show algebraMap A R = (Spec.preimage (c ≫ a₀)).hom.comp
        (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r))) from rfl,
      CommRingCat.ofHom_comp, CommRingCat.ofHom_hom, Spec.map_comp, Spec.map_preimage,
      Category.assoc]
  have hpb' : IsPullback p q (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
      (Spec.map (CommRingCat.ofHom (algebraMap A L))) := hpb
  obtain ⟨E, hE⟩ := s1 p q _ hpb' c hc
  have he : E.hom ≫ Spec.map (CommRingCat.ofHom
      (Spec.preimage (E.inv ≫ Limits.pullback.snd c p ≫ T.g₀)).hom) =
      Limits.pullback.snd c p ≫ T.g₀ := by
    rw [CommRingCat.ofHom_hom, Spec.map_preimage, Iso.hom_inv_id_assoc]
  refine ⟨(Spec.preimage (E.inv ≫ Limits.pullback.snd c p ≫ T.g₀)).hom, ?_, ?_⟩
  · have h3 := s3 c p T.g₀ E (CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : R →ₐ[A] TensorProduct A L R).toRingHom) hE
      (LaurentPolynomial.T 1) _ T.hg₀T
    have h4 : (Spec.preimage (c ≫ a₀)).hom (Ideal.Quotient.mk
        (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) =
        (Spec.preimage c).hom (wcQmtmX a₀ ⟨0, by omega⟩) := by
      rw [Spec.preimage_comp, CommRingCat.hom_comp, RingHom.comp_apply]
    rw [h3, h4]
    rfl
  · intro hconn
    obtain ⟨Ψ⟩ := s2 (AddMonoidAlgebra.mapDomainRingHom L
      (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) (Limits.pullback.snd c p)
      T.πi T.gi T.g₀ T.hT E _ he
    have h := Scheme.homeoOfIso ((Limits.pullbackLeftPullbackSndIso c p T.πi).symm ≪≫ Ψ).symm
    exact @Function.Surjective.connectedSpace _ _ _ hconn _ _ h.surjective h.continuous

theorem wc_qmtm_tower_colim_connected {S M : Type u} [CommRing S] [CommRing M] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (e : LaurentPolynomial S →+* M)
    (hlev : ∀ k : ℕ, ConnectedSpace (PrimeSpectrum
      (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1)))))) :
    letI := e.toAlgebra
    letI := (AddMonoidAlgebra.mapDomainRingHom S
      (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom).toAlgebra
    ConnectedSpace (PrimeSpectrum (TensorProduct (LaurentPolynomial S) M
      (AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))))) :=
by
  classical
  letI := e.toAlgebra
  letI := (AddMonoidAlgebra.mapDomainRingHom S
      (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom).toAlgebra

  have s1 : ∀ {R : Type u} [CommRing R] (A : ℕ → Type u)
      [∀ k, CommRing (A k)] (β : ∀ k, A k →+* R) (_hinj : ∀ k, Function.Injective (β k))
      (_hconn : ∀ k, ConnectedSpace (PrimeSpectrum (A k)))
      (_hex : ∀ z : R, ∃ k, z ∈ (β k).range), ConnectedSpace (PrimeSpectrum R) := by
    intro R _ A _ β hinj hconn hex
    have key : ∀ (B : Type u) [CommRing B] [ConnectedSpace (PrimeSpectrum B)] (f : B),
        IsIdempotentElem f → f = 0 ∨ f = 1 := by
      intro B _ _ f hf
      have hc : IsClopen ((PrimeSpectrum.basicOpen f : Set (PrimeSpectrum B))) :=
        PrimeSpectrum.isClopen_iff.mpr ⟨f, hf, rfl⟩
      rcases _root_.isClopen_iff.mp hc with h | h
      · left
        apply hf.eq_zero_of_isNilpotent
        rw [nilpotent_iff_mem_prime]
        intro J hJ
        by_contra hfJ
        have hmem : (⟨J, hJ⟩ : PrimeSpectrum B) ∈
            (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum B)) := hfJ
        rw [h] at hmem
        exact hmem
      · right
        have h0 : 1 - f = 0 := by
          apply hf.one_sub.eq_zero_of_isNilpotent
          rw [nilpotent_iff_mem_prime]
          intro J hJ
          have hmem : (⟨J, hJ⟩ : PrimeSpectrum B) ∈
              (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum B)) := by
            rw [h]; exact Set.mem_univ _
          have hfJ : f ∉ J := hmem
          have hprod : f * (1 - f) ∈ J := by
            have h00 : f * (1 - f) = 0 := by rw [mul_sub, mul_one, hf.eq, sub_self]
            rw [h00]; exact J.zero_mem
          exact (hJ.mem_or_mem hprod).resolve_left hfJ
        exact (sub_eq_zero.mp h0).symm
    rw [connectedSpace_iff_clopen]
    refine ⟨?_, ?_⟩
    · haveI := hconn 0
      haveI : Nontrivial (A 0) := PrimeSpectrum.nonempty_iff_nontrivial.mp inferInstance
      haveI : Nontrivial R := (hinj 0).nontrivial
      exact PrimeSpectrum.nonempty_iff_nontrivial.mpr inferInstance
    · intro s hs
      obtain ⟨ε, hε, rfl⟩ := PrimeSpectrum.isClopen_iff.mp hs
      obtain ⟨k, f, rfl⟩ := hex ε
      have hf : IsIdempotentElem f := hinj k (by rw [map_mul]; exact hε)
      haveI := hconn k
      rcases key (A k) f hf with h | h
      · left; rw [h, map_zero, PrimeSpectrum.basicOpen_zero]; rfl
      · right; rw [h, map_one, PrimeSpectrum.basicOpen_one]; rfl

  have hℓ0 : (ℓ : ℤ) ≠ 0 := by exact_mod_cast (Fact.out : ℓ.Prime).ne_zero
  have hιinj : Function.Injective (algebraMap ℤ (Localization.Away (ℓ : ℤ))) :=
    IsLocalization.injective (Localization.Away (ℓ : ℤ))
      (powers_le_nonZeroDivisors_of_noZeroDivisors hℓ0)
  have hT : ∀ n : ℤ, (LaurentPolynomial.T n : LaurentPolynomial S) = AddMonoidAlgebra.single n 1 :=
    fun n => rfl
  have hι₀ : ∀ (m : ℤ) (c : S), (AddMonoidAlgebra.mapDomainRingHom S
      (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) (AddMonoidAlgebra.single m c) =
      AddMonoidAlgebra.single (algebraMap ℤ (Localization.Away (ℓ : ℤ)) m) c := by
    intro m c
    rw [AddMonoidAlgebra.mapDomainRingHom_apply, AddMonoidAlgebra.mapDomain_single]
    rfl
  have hsmulG : ∀ (r : LaurentPolynomial S) (g : AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))),
      r • g = (AddMonoidAlgebra.mapDomainRingHom S
      (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) r * g :=
    fun r g => Algebra.smul_def r g
  have hsmulM : ∀ (r : LaurentPolynomial S) (m : M), r • m = e r * m :=
    fun r m => Algebra.smul_def r m
  have htm : ∀ (r : LaurentPolynomial S) (m : M)
      (g : AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))),
      m ⊗ₜ[LaurentPolynomial S] ((AddMonoidAlgebra.mapDomainRingHom S
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) r * g) =
      (e r * m) ⊗ₜ[LaurentPolynomial S] g := by
    intro r m g
    rw [← hsmulG, ← hsmulM]
    exact (TensorProduct.smul_tmul r m g).symm
  have hθ : ∀ k : ℕ, AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) -
      Polynomial.C (e (LaurentPolynomial.T 1))) ^ (ℓ ^ k) =
      AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1)))
        (e (LaurentPolynomial.T 1)) := by
    intro k
    have h := AdjoinRoot.mk_self (f := Polynomial.X ^ (ℓ ^ k) -
      Polynomial.C (e (LaurentPolynomial.T 1)))
    rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h
    exact h

  have s2 : ∀ (k : ℕ) (w : Localization.Away (ℓ : ℤ)),
      (algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ)) ^ k * w = 1 →
      ∃ β : AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1))) →+*
          TensorProduct (LaurentPolynomial S) M (AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))),
        β.comp (AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1)))) =
          Algebra.TensorProduct.includeLeftRingHom ∧
        β (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1)))) =
          (1 : M) ⊗ₜ[LaurentPolynomial S] AddMonoidAlgebra.single w (1 : S) := by
    intro k w hw
    have h1 : (ℓ ^ k) • w = 1 := by
      rw [nsmul_eq_mul, Nat.cast_pow]
      simpa using hw
    have hev : Polynomial.eval₂ (Algebra.TensorProduct.includeLeftRingHom
        (R := LaurentPolynomial S) (A := M)
        (B := AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))))
        ((1 : M) ⊗ₜ[LaurentPolynomial S] AddMonoidAlgebra.single w (1 : S))
        (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1))) =
        ((1 : M) ⊗ₜ[LaurentPolynomial S] AddMonoidAlgebra.single w (1 : S)) ^ (ℓ ^ k) -
          (e (LaurentPolynomial.T 1)) ⊗ₜ[LaurentPolynomial S]
            (1 : AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))) := by
      erw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
      rfl
    have hev2 : ((1 : M) ⊗ₜ[LaurentPolynomial S] AddMonoidAlgebra.single w (1 : S)) ^ (ℓ ^ k) -
          (e (LaurentPolynomial.T 1)) ⊗ₜ[LaurentPolynomial S]
            (1 : AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))) = 0 := by
      rw [Algebra.TensorProduct.tmul_pow, one_pow,
        AddMonoidAlgebra.single_pow, h1, one_pow, sub_eq_zero]
      have h2 : (AddMonoidAlgebra.single (1 : Localization.Away (ℓ : ℤ)) (1 : S)) =
          (AddMonoidAlgebra.mapDomainRingHom S
            (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) (LaurentPolynomial.T 1) *
            (1 : AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))) := by
        rw [mul_one, hT, hι₀, map_one]
      rw [h2, htm, mul_one]
    refine ⟨AdjoinRoot.lift Algebra.TensorProduct.includeLeftRingHom
      ((1 : M) ⊗ₜ[LaurentPolynomial S] AddMonoidAlgebra.single w (1 : S)) (hev.trans hev2), ?_,
      AdjoinRoot.lift_root _⟩
    ext x
    simp

  have s3 : ∀ (k : ℕ) (w : Localization.Away (ℓ : ℤ)),
      (algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ)) ^ k * w = 1 →
      ∃ γ : TensorProduct (LaurentPolynomial S) M
          (AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))) →+
          AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1))),
        ∀ (m : M) (n : ℕ),
          γ (m ⊗ₜ[LaurentPolynomial S] AddMonoidAlgebra.single (n • w) (1 : S)) =
          AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1))) m *
            AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) -
              Polynomial.C (e (LaurentPolynomial.T 1))) ^ n := by
    intro k w hw
    have hθk := hθ k
    generalize (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1))) = P at hθk ⊢
    obtain ⟨Nz, hNz⟩ : ∃ Nz : ℤ, Nz = (ℓ : ℤ) ^ k := ⟨_, rfl⟩
    have hNz0 : Nz ≠ 0 := by rw [hNz]; exact pow_ne_zero _ hℓ0
    have hNzw : algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * w = 1 := by
      rw [hNz, map_pow]; exact hw
    let Γq : Localization.Away (ℓ : ℤ) → S →+ AdjoinRoot P := fun q =>
      if h : ∃ a : ℤ, algebraMap ℤ (Localization.Away (ℓ : ℤ)) a =
          algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * q then
        { toFun := fun c => AdjoinRoot.of P (e (LaurentPolynomial.C c *
              LaurentPolynomial.T (h.choose / Nz))) * AdjoinRoot.root P ^ (h.choose % Nz).toNat
          map_zero' := by simp
          map_add' := by intro a b; simp only [map_add, add_mul] }
      else 0
    have hΓq1 : ∀ (q : Localization.Away (ℓ : ℤ)) (a : ℤ) (c : S),
        algebraMap ℤ (Localization.Away (ℓ : ℤ)) a =
          algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * q →
        Γq q c = AdjoinRoot.of P (e (LaurentPolynomial.C c * LaurentPolynomial.T (a / Nz))) *
          AdjoinRoot.root P ^ (a % Nz).toNat := by
      intro q a c ha
      have h : ∃ a : ℤ, algebraMap ℤ (Localization.Away (ℓ : ℤ)) a =
          algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * q := ⟨a, ha⟩
      have hc : h.choose = a := hιinj (h.choose_spec.trans ha.symm)
      simp only [Γq, dif_pos h, AddMonoidHom.coe_mk, ZeroHom.coe_mk, hc]
    have hΓq0 : ∀ (q : Localization.Away (ℓ : ℤ)) (c : S),
        ¬ (∃ a : ℤ, algebraMap ℤ (Localization.Away (ℓ : ℤ)) a =
          algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * q) → Γq q c = 0 := by
      intro q c h
      simp only [Γq, dif_neg h, AddMonoidHom.zero_apply]
    let Γ : AddMonoidAlgebra S (Localization.Away (ℓ : ℤ)) →+ AdjoinRoot P :=
      { toFun := fun g => Finsupp.liftAddHom Γq g.coeff
        map_zero' := by simp only [AddMonoidAlgebra.coeff_zero, map_zero]
        map_add' := by intro x y; simp only [AddMonoidAlgebra.coeff_add, map_add] }
    have hΓs : ∀ (q : Localization.Away (ℓ : ℤ)) (c : S),
        Γ (AddMonoidAlgebra.single q c) = Γq q c := by
      intro q c
      show Finsupp.liftAddHom Γq (AddMonoidAlgebra.single q c).coeff = Γq q c
      rw [AddMonoidAlgebra.coeff_single, Finsupp.liftAddHom_apply_single]
    have hkey : ∀ (r : LaurentPolynomial S) (g : AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))),
        Γ (AddMonoidAlgebra.mapDomainRingHom S
          (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom r * g) =
          AdjoinRoot.of P (e r) * Γ g := by
      intro r g
      induction g using AddMonoidAlgebra.induction_linear with
      | zero => simp
      | add g₁ g₂ h₁ h₂ => simp only [mul_add, map_add, h₁, h₂]
      | single q c =>
        induction r using AddMonoidAlgebra.induction_linear with
        | zero => simp
        | add r₁ r₂ h₁ h₂ => simp only [map_add, add_mul, h₁, h₂]
        | single m c' =>
          rw [hι₀, AddMonoidAlgebra.single_mul_single, hΓs, hΓs]
          by_cases hq : ∃ a : ℤ, algebraMap ℤ (Localization.Away (ℓ : ℤ)) a =
              algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * q
          · obtain ⟨a, ha⟩ := hq
            have ha' : algebraMap ℤ (Localization.Away (ℓ : ℤ)) (a + Nz * m) =
                algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz *
                  (algebraMap ℤ (Localization.Away (ℓ : ℤ)) m + q) := by
              rw [map_add, map_mul, ha]; ring
            rw [hΓq1 _ _ _ ha', hΓq1 _ _ _ ha, Int.add_mul_ediv_left _ _ hNz0,
              Int.add_mul_emod_self_left, LaurentPolynomial.single_eq_C_mul_T,
              map_mul LaurentPolynomial.C, LaurentPolynomial.T_add]
            simp only [map_mul]
            ring
          · have hq' : ¬ ∃ a : ℤ, algebraMap ℤ (Localization.Away (ℓ : ℤ)) a =
                algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz *
                  (algebraMap ℤ (Localization.Away (ℓ : ℤ)) m + q) := by
              rintro ⟨a, ha⟩
              apply hq
              refine ⟨a - Nz * m, ?_⟩
              rw [map_sub, map_mul, ha]; ring
            rw [hΓq0 _ _ hq', hΓq0 _ _ hq, mul_zero]
    let f : M →+ AddMonoidAlgebra S (Localization.Away (ℓ : ℤ)) →+ AdjoinRoot P :=
      (AddMonoidHom.mul.comp (AdjoinRoot.of P).toAddMonoidHom).compl₂ Γ
    have hf : ∀ m g, f m g = AdjoinRoot.of P m * Γ g := fun m g => rfl
    have hbal : ∀ (r : LaurentPolynomial S) (m : M)
        (g : AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))), f (r • m) g = f m (r • g) := by
      intro r m g
      rw [hf, hf, hsmulM, hsmulG, hkey, map_mul]; ring
    refine ⟨TensorProduct.liftAddHom f hbal, ?_⟩
    intro m n
    rw [TensorProduct.liftAddHom_tmul, hf, hΓs]
    have hn : algebraMap ℤ (Localization.Away (ℓ : ℤ)) (n : ℤ) =
        algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * (n • w) := by
      rw [nsmul_eq_mul, mul_left_comm, hNzw, mul_one, map_natCast]
    rw [hΓq1 _ _ _ hn]
    congr 1
    have hNnat : Nz = ((ℓ ^ k : ℕ) : ℤ) := by rw [hNz, Nat.cast_pow]
    rw [hNnat, ← Int.natCast_div, ← Int.natCast_mod, Int.toNat_natCast, map_one, one_mul]
    have hTpow : (LaurentPolynomial.T (((n / ℓ ^ k : ℕ)) : ℤ) : LaurentPolynomial S) =
        LaurentPolynomial.T 1 ^ (n / ℓ ^ k) := by
      rw [LaurentPolynomial.T_pow, mul_one]
    rw [hTpow, map_pow, map_pow, ← hθk, ← pow_mul, ← pow_add, Nat.div_add_mod]

  have s4 : ∀ z : TensorProduct (LaurentPolynomial S) M
      (AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))),
      ∃ K₀ : ℕ, ∀ k : ℕ, K₀ ≤ k → ∀ (w : Localization.Away (ℓ : ℤ)),
        (algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ)) ^ k * w = 1 →
        ∀ β : AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1))) →+*
          TensorProduct (LaurentPolynomial S) M (AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))),
        β.comp (AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1)))) =
          Algebra.TensorProduct.includeLeftRingHom →
        β (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1)))) =
          (1 : M) ⊗ₜ[LaurentPolynomial S] AddMonoidAlgebra.single w (1 : S) →
        z ∈ β.range := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, fun k _ w _ β _ _ => zero_mem _⟩
    | add z₁ z₂ h₁ h₂ =>
      obtain ⟨K₁, hK₁⟩ := h₁
      obtain ⟨K₂, hK₂⟩ := h₂
      exact ⟨max K₁ K₂, fun k hk w hw β hβ1 hβ2 =>
        add_mem (hK₁ k (le_of_max_le_left hk) w hw β hβ1 hβ2)
          (hK₂ k (le_of_max_le_right hk) w hw β hβ1 hβ2)⟩
    | tmul m g =>
      induction g using AddMonoidAlgebra.induction_linear with
      | zero => exact ⟨0, fun k _ w _ β _ _ => by rw [TensorProduct.tmul_zero]; exact zero_mem _⟩
      | add g₁ g₂ h₁ h₂ =>
        obtain ⟨K₁, hK₁⟩ := h₁
        obtain ⟨K₂, hK₂⟩ := h₂
        refine ⟨max K₁ K₂, fun k hk w hw β hβ1 hβ2 => ?_⟩
        rw [TensorProduct.tmul_add]
        exact add_mem (hK₁ k (le_of_max_le_left hk) w hw β hβ1 hβ2)
          (hK₂ k (le_of_max_le_right hk) w hw β hβ1 hβ2)
      | single q c =>
        obtain ⟨j, a, hja⟩ := IsLocalization.Away.surj (ℓ : ℤ) q
        refine ⟨j, fun k hk w hw β hβ1 hβ2 => ?_⟩
        obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hk
        have hNz0 : ((ℓ : ℤ) ^ (j + d)) ≠ 0 := pow_ne_zero _ hℓ0
        have hq1 : q = algebraMap ℤ (Localization.Away (ℓ : ℤ)) (a * (ℓ : ℤ) ^ d) * w := by
          calc q = q * ((algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ)) ^ (j + d) * w) := by
                rw [hw, mul_one]
            _ = (q * (algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ)) ^ j) *
                (algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ)) ^ d * w := by ring
            _ = _ := by rw [hja, map_mul, map_pow]
        have hs0 : 0 ≤ (a * (ℓ : ℤ) ^ d) % ((ℓ : ℤ) ^ (j + d)) := Int.emod_nonneg _ hNz0
        have hbdec := Int.emod_add_mul_ediv (a * (ℓ : ℤ) ^ d) ((ℓ : ℤ) ^ (j + d))
        have hq2 : q = algebraMap ℤ (Localization.Away (ℓ : ℤ))
              ((a * (ℓ : ℤ) ^ d) / ((ℓ : ℤ) ^ (j + d))) +
            ((a * (ℓ : ℤ) ^ d) % ((ℓ : ℤ) ^ (j + d))).toNat • w := by
          have hcast : ((((a * (ℓ : ℤ) ^ d) % ((ℓ : ℤ) ^ (j + d))).toNat : ℕ) :
              Localization.Away (ℓ : ℤ)) = algebraMap ℤ (Localization.Away (ℓ : ℤ))
                ((a * (ℓ : ℤ) ^ d) % ((ℓ : ℤ) ^ (j + d))) := by
            rw [← map_natCast (algebraMap ℤ (Localization.Away (ℓ : ℤ))), Int.toNat_of_nonneg hs0]
          rw [nsmul_eq_mul, hcast]
          conv_lhs => rw [hq1, ← hbdec]
          rw [map_add, map_mul, map_pow]
          linear_combination (algebraMap ℤ (Localization.Away (ℓ : ℤ))
            ((a * (ℓ : ℤ) ^ d) / ((ℓ : ℤ) ^ (j + d)))) * hw
        have hsingle : AddMonoidAlgebra.single q c =
            AddMonoidAlgebra.mapDomainRingHom S
              (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom
              (AddMonoidAlgebra.single ((a * (ℓ : ℤ) ^ d) / ((ℓ : ℤ) ^ (j + d))) c) *
              (AddMonoidAlgebra.single w (1 : S)) ^
                ((a * (ℓ : ℤ) ^ d) % ((ℓ : ℤ) ^ (j + d))).toNat := by
          rw [hι₀, AddMonoidAlgebra.single_pow, AddMonoidAlgebra.single_mul_single, one_pow,
            mul_one, ← hq2]
        have hβ1' : ∀ x, β (AdjoinRoot.of _ x) =
            x ⊗ₜ[LaurentPolynomial S] (1 : AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))) := by
          intro x
          have hx := RingHom.congr_fun hβ1 x
          rw [RingHom.comp_apply] at hx
          rw [hx, Algebra.TensorProduct.includeLeftRingHom_apply]
        rw [hsingle, htm]
        refine RingHom.mem_range.mpr ⟨AdjoinRoot.of _ (e (AddMonoidAlgebra.single
          ((a * (ℓ : ℤ) ^ d) / ((ℓ : ℤ) ^ (j + d))) c) * m) * AdjoinRoot.root _ ^
            ((a * (ℓ : ℤ) ^ d) % ((ℓ : ℤ) ^ (j + d))).toNat, ?_⟩
        rw [map_mul, map_pow, hβ2, hβ1', Algebra.TensorProduct.tmul_pow, one_pow,
          Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]

  have s5 : ∀ (k : ℕ) (w : Localization.Away (ℓ : ℤ))
      (β : AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1))) →+*
          TensorProduct (LaurentPolynomial S) M (AddMonoidAlgebra S (Localization.Away (ℓ : ℤ)))),
      β.comp (AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1)))) =
          Algebra.TensorProduct.includeLeftRingHom →
      β (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1)))) =
          (1 : M) ⊗ₜ[LaurentPolynomial S] AddMonoidAlgebra.single w (1 : S) →
      ∀ (γ : TensorProduct (LaurentPolynomial S) M
          (AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))) →+
          AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1)))),
      (∀ (m : M) (n : ℕ),
          γ (m ⊗ₜ[LaurentPolynomial S] AddMonoidAlgebra.single (n • w) (1 : S)) =
          AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1))) m *
            AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) -
              Polynomial.C (e (LaurentPolynomial.T 1))) ^ n) →
      Function.Injective β := by
    intro k w β hβ1 hβ2 γ hγ
    have hβ1' : ∀ x, β (AdjoinRoot.of _ x) =
        x ⊗ₜ[LaurentPolynomial S] (1 : AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))) := by
      intro x
      have hx := RingHom.congr_fun hβ1 x
      rw [RingHom.comp_apply] at hx
      rw [hx, Algebra.TensorProduct.includeLeftRingHom_apply]
    apply Function.LeftInverse.injective (g := γ)
    intro y
    refine AdjoinRoot.induction_on _ y (fun p => ?_)
    refine Polynomial.induction_on' p ?_ ?_
    · intro p q hp hq
      simp only [map_add, hp, hq]
    · intro n m
      rw [← Polynomial.C_mul_X_pow_eq_monomial, map_mul, map_pow, AdjoinRoot.mk_C,
        AdjoinRoot.mk_X, map_mul, map_pow, hβ1', hβ2, Algebra.TensorProduct.tmul_pow, one_pow,
        Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul, AddMonoidAlgebra.single_pow,
        one_pow, hγ]

  obtain ⟨u, hu⟩ : ∃ u : Localization.Away (ℓ : ℤ),
      algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ) * u = 1 :=
    ⟨_, IsLocalization.Away.mul_invSelf (ℓ : ℤ)⟩
  have hw : ∀ k : ℕ, (algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ)) ^ k * u ^ k = 1 := by
    intro k; rw [← mul_pow, hu, one_pow]
  choose β hβ1 hβ2 using fun k => s2 k (u ^ k) (hw k)
  have hinj : ∀ k, Function.Injective (β k) := by
    intro k
    obtain ⟨γ, hγ⟩ := s3 k (u ^ k) (hw k)
    exact s5 k (u ^ k) (β k) (hβ1 k) (hβ2 k) γ hγ
  have hex : ∀ z : TensorProduct (LaurentPolynomial S) M
      (AddMonoidAlgebra S (Localization.Away (ℓ : ℤ))), ∃ k, ∃ y, β k y = z := by
    intro z
    obtain ⟨K₀, hK⟩ := s4 z
    obtain ⟨y, hy⟩ := RingHom.mem_range.mp
      (hK K₀ le_rfl (u ^ K₀) (hw K₀) (β K₀) (hβ1 K₀) (hβ2 K₀))
    exact ⟨K₀, y, hy⟩
  refine @s1 (TensorProduct (LaurentPolynomial S) M
      (AddMonoidAlgebra S (Localization.Away (ℓ : ℤ)))) _ (fun k => AdjoinRoot (Polynomial.X ^ (ℓ ^ k) -
      Polynomial.C (e (LaurentPolynomial.T 1)))) (fun k => inferInstance) β hinj hlev ?_
  intro z
  obtain ⟨k, y, hy⟩ := hex z
  exact ⟨k, RingHom.mem_range.mpr ⟨y, hy⟩⟩

theorem wc_qmtm_Y_iso {A B L : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    [Field L] [IsSepClosed L]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit ((ℓ : ℕ) : A)) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (r : ℕ)
    (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r))))
    (ha₀ : WeaklyEtale a₀)
    (hx0 : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
      (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)))
    (hx1 : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
      (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)))
    (φA : A →+* L) (hφA : Function.Injective φA) (halg : letI := φA.toAlgebra; Algebra.IsAlgebraic A L)
    (σ : L →+* L) (hσ : σ.comp φA = φA)
    (XE : Scheme.{u}) (p : XE ⟶ Spec (.of B)) (q : XE ⟶ Spec (.of L))
    (hpb : IsPullback p q (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) (Spec.map (CommRingCat.ofHom φA)))
    (Xs : Scheme.{u}) (ι : Xs ⟶ Spec (.of B)) (s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A)))
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) (wcQmSp A))
    (Y : Scheme.{u}) (iY : Y ⟶ Xs)
    (kY : Y ⟶ Spec (.of (B ⧸ Ideal.span {wcQmtmX a₀ ⟨0, by omega⟩, wcQmtmX a₀ ⟨1, by omega⟩})))
    (hDY : IsPullback iY kY ι (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (Ideal.span {wcQmtmX a₀ ⟨0, by omega⟩, wcQmtmX a₀ ⟨1, by omega⟩})))))
    (EY : wcHMPullData iY ℓ) (hEY : wcHMPullCanonical EY)
    (w : XE ⟶ XE) (hw₁ : w ≫ p = p) (hw₂ : w ≫ q = q ≫ Spec.map (CommRingCat.ofHom σ))
    (T : wcQmtmTower ℓ φA σ p q w (wcQmtmX a₀ ⟨0, by omega⟩))
    (Dπ : wcHMPullData T.πi ℓ) (hDπ : wcHMPullCanonical Dπ)
    (Dp : wcHMPullData p ℓ) (hDp : wcHMPullCanonical Dp)
    (Di : wcHMPullData ι ℓ) (hDi : wcHMPullCanonical Di) :
    IsIso (EY.Φ.map (Di.Φ.map ((wcQmtmPush Dp).map (wcSuppUnitMap Dπ)))) :=
by
  classical

  haveI : IsClosedImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps.flip
      (IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective)
  haveI : IsClosedImmersion iY :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hDY.flip
      (IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective)
  haveI : QuasiCompact p :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) hpb.flip (quasiCompact_of_compactSpace _)
  haveI : QuasiCompact T.πi :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) T.hT.flip (quasiCompact_of_compactSpace _)
  obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists (iY ≫ ι) ℓ

  obtain ⟨η⟩ := wc_hm_pull_data_comp_Phi_iso ι iY (iY ≫ ι) rfl Di hDi EY hEY Dk hDk
  have hiff : ∀ {M N : SheafOfModules.{u+1} (wcRingSheaf (Spec (.of B)) ℓ)} (g : M ⟶ N),
      IsIso (EY.Φ.map (Di.Φ.map g)) ↔ IsIso (Dk.Φ.map g) :=
    fun g => (NatIso.isIso_map_iff η g).symm

  have htw := wc_supp_unit_map_twist_factor Dπ hDπ
  obtain ⟨c', hc'⟩ := wc_supp_unit_twist_isUnit Dπ
  obtain ⟨h1, hmul⟩ := wc_hm_fun_one_mul T.XEi ℓ
  haveI : IsIso (wcHMFun T.XEi ℓ (wcSuppTwist (wcSuppUnitMap Dπ))) :=
    ⟨⟨wcHMFun T.XEi ℓ c', by rw [← hmul, hc', h1], by rw [← hmul, mul_comm, hc', h1]⟩⟩

  have hunit := wc_qmssl_ci_unit_restr_iso A ℓ hℓ π hπ r B a₀ ha₀ hx0 hx1 L φA hφA halg
    XE p q hpb Xs ι s hps Dp hDp Di hDi
  haveI hunitk : IsIso (Dk.Φ.map (wcQmtmUnit Dp)) := (hiff _).mp inferInstance

  have hgen : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R]
      [IsSepClosed (IsLocalRing.ResidueField R)] (c : Spec (.of R) ⟶ Spec (.of B)),
      letI : Algebra A R := ((Spec.preimage (c ≫ a₀)).hom.comp
        (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
      letI : Algebra A L := φA.toAlgebra
      ∀ (e : LaurentPolynomial L →+* TensorProduct A L R),
      e (LaurentPolynomial.T 1) = (1 : L) ⊗ₜ[A] (Spec.preimage (c ≫ a₀)).hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) →
      (letI := e.toAlgebra
       letI := (AddMonoidAlgebra.mapDomainRingHom L
         (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom).toAlgebra
       ConnectedSpace (PrimeSpectrum (TensorProduct (LaurentPolynomial L) (TensorProduct A L R)
         (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))) →
       ConnectedSpace ↥(Limits.pullback c (T.πi ≫ p))) →
      WeaklyEtale (Spec.map (CommRingCat.ofHom (Spec.preimage (c ≫ a₀)).hom)) →
      (Spec.preimage (c ≫ a₀)).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal R →
      (Spec.preimage (c ≫ a₀)).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal R →
      ConnectedSpace ↥(Limits.pullback c (T.πi ≫ p)) := by
    intro R _ _ _ c
    intro e he himp hWE h0 h1
    refine himp (wc_qmtm_tower_colim_connected (S := L) ℓ e ?_)
    intro k
    have hk := wc_qmtm_level_milnor_conn A ℓ hℓ π hπ r R
      (Spec.preimage (c ≫ a₀)).hom hWE h0 h1 L φA hφA k
    rw [← he] at hk
    exact hk
  have hmfc : ∀ (Vt : (Spec (.of B)).ProEt) (x : Vt.left),
      HenselianLocalRing (Vt.left.presheaf.stalk x) → IsSepClosed (Vt.left.residueField x) →
      Vt.hom x ∈ Set.range (iY ≫ ι) →
      ConnectedSpace ↥(Limits.pullback (Vt.left.fromSpecStalk x ≫ Vt.hom) (T.πi ≫ p)) := by
    intro Vt x hhen hsep hz
    haveI hloc : IsLocalRing (Vt.left.presheaf.stalk x) := hhen.toIsLocalRing
    haveI : HenselianLocalRing (Vt.left.presheaf.stalk x) := hhen
    haveI hsepR : IsSepClosed (IsLocalRing.ResidueField (Vt.left.presheaf.stalk x)) := hsep
    have hc0' : (Vt.left.fromSpecStalk x ≫ Vt.hom)
        (IsLocalRing.closedPoint (Vt.left.presheaf.stalk x)) = Vt.hom x := by
      have h := Scheme.Hom.comp_apply (Vt.left.fromSpecStalk x) Vt.hom
        (IsLocalRing.closedPoint (Vt.left.presheaf.stalk x))
      exact h.trans (congrArg Vt.hom Scheme.fromSpecStalk_closedPoint)
    have hWc : WeaklyEtale ((Vt.left.fromSpecStalk x ≫ Vt.hom) ≫ a₀) := by
      haveI := wc_fromSpecStalk_weaklyEtale Vt.left x
      haveI : WeaklyEtale Vt.hom := Vt.prop
      haveI : WeaklyEtale a₀ := ha₀
      infer_instance
    have hWE : WeaklyEtale (Spec.map (CommRingCat.ofHom
        (Spec.preimage ((Vt.left.fromSpecStalk x ≫ Vt.hom) ≫ a₀)).hom)) := by
      rw [CommRingCat.ofHom_hom, Spec.map_preimage]
      exact hWc

    obtain ⟨yy, hyy⟩ := hz
    have hJ : ∀ b ∈ ({wcQmtmX a₀ ⟨0, by omega⟩, wcQmtmX a₀ ⟨1, by omega⟩} : Set B),
        b ∈ (Vt.hom x).asIdeal := by
      intro b hb
      have h0 : (Ideal.Quotient.mk (Ideal.span {wcQmtmX a₀ ⟨0, by omega⟩,
          wcQmtmX a₀ ⟨1, by omega⟩})) b = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span hb)
      rw [← hyy, hDY.w, Scheme.Hom.comp_apply, Spec.map_apply]
      show b ∈ Ideal.comap _ _
      rw [Ideal.mem_comap, CommRingCat.hom_ofHom, h0]
      exact Ideal.zero_mem _
    have key : ∀ b : wcQuadModelRing A (r + 2) π (wcQmtmC A r),
        (Spec.preimage a₀).hom b ∈ (Vt.hom x).asIdeal →
        (Spec.preimage ((Vt.left.fromSpecStalk x ≫ Vt.hom) ≫ a₀)).hom b ∈
          IsLocalRing.maximalIdeal (Vt.left.presheaf.stalk x) := by
      intro b hb
      have e1 : (Spec.map (CommRingCat.ofHom
          (Spec.preimage ((Vt.left.fromSpecStalk x ≫ Vt.hom) ≫ a₀)).hom))
          (IsLocalRing.closedPoint (Vt.left.presheaf.stalk x)) = a₀ (Vt.hom x) := by
        rw [CommRingCat.ofHom_hom, Spec.map_preimage]
        exact (Scheme.Hom.comp_apply _ _ _).trans (congrArg a₀ hc0')
      have e2 : b ∈ (a₀ (Vt.hom x)).asIdeal := by
        rw [← Spec.map_preimage a₀, Spec.map_apply]
        exact hb
      rw [← e1] at e2
      exact e2
    have h0 := key _ (hJ _ (Set.mem_insert _ _))
    have h1 := key _ (hJ _ (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    obtain ⟨e, he, himp⟩ := wc_qmtm_tower_fibre_ring a₀ φA p q hpb T
      (Vt.left.presheaf.stalk x) (Vt.left.fromSpecStalk x ≫ Vt.hom)
    exact @hgen (Vt.left.presheaf.stalk x) _ hhen hsepR (Vt.left.fromSpecStalk x ≫ Vt.hom)
      e he himp hWE h0 h1

  have hs1 := wc_qmtm_unit_comp_restr_iso (iY ≫ ι) p T.πi ℓ Dp hDp Dπ hDπ Dk hDk hmfc
  rw [Functor.map_comp] at hs1
  haveI := hs1
  haveI i1 : IsIso (Dk.Φ.map ((wcQmtmPush Dp).map (wcQmtmUnit Dπ))) :=
    IsIso.of_isIso_comp_left (Dk.Φ.map (wcQmtmUnit Dp)) _
  have etw : Dk.Φ.map ((wcQmtmPush Dp).map (wcSuppUnitMap Dπ)) =
      Dk.Φ.map ((wcQmtmPush Dp).map (wcQmtmUnit Dπ)) ≫
        Dk.Φ.map ((wcQmtmPush Dp).map ((wcQmtmPush Dπ).map
          (wcHMFun T.XEi ℓ (wcSuppTwist (wcSuppUnitMap Dπ))))) := by
    rw [← Functor.map_comp, ← Functor.map_comp]
    exact congrArg (fun g => Dk.Φ.map ((wcQmtmPush Dp).map g)) htw
  haveI i2 : IsIso ((wcQmtmPush Dπ).map (wcHMFun T.XEi ℓ (wcSuppTwist (wcSuppUnitMap Dπ)))) :=
    Functor.map_isIso _ _
  haveI i3 : IsIso ((wcQmtmPush Dp).map ((wcQmtmPush Dπ).map
      (wcHMFun T.XEi ℓ (wcSuppTwist (wcSuppUnitMap Dπ))))) :=
    Functor.map_isIso _ _
  haveI i4 : IsIso (Dk.Φ.map ((wcQmtmPush Dp).map ((wcQmtmPush Dπ).map
      (wcHMFun T.XEi ℓ (wcSuppTwist (wcSuppUnitMap Dπ)))))) :=
    Functor.map_isIso _ _
  rw [hiff, etw]
  exact IsIso.comp_isIso' i1 i4

theorem wc_qmtm_restr_id_of_thick {S Z O : Scheme.{u}} (ι : Z ⟶ S) [IsClosedImmersion ι]
    (jO : O ⟶ Z) [IsOpenImmersion jO] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData ι ℓ) (hDi : wcHMPullCanonical Di)
    (DO : wcHMPullData jO ℓ) (hDO : wcHMPullCanonical DO)
    (F : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (e : F ⟶ F)
    (he : ∀ Vt : S.ProEt, IsAffine Vt.left → IsClosed {x : Vt.left | IsClosed ({x} : Set Vt.left)} →
      (∀ x : Vt.left, ∃! y : Vt.left, IsClosed ({y} : Set Vt.left) ∧ x ⤳ y) →
      ExtremallyDisconnected {x : Vt.left | IsClosed ({x} : Set Vt.left)} →
      (∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
        HenselianLocalRing (Vt.left.presheaf.stalk x) ∧ IsSepClosed (Vt.left.residueField x)) →
      (∀ v : Vt.left, IsClosed ({v} : Set Vt.left) → Vt.hom v ∈ Set.range (jO ≫ ι)) →
      (∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
        Function.Bijective ((Di.adj.unit.app M).val.app (Opposite.op Vt)).hom) →
      e.val.app (Opposite.op Vt) = 𝟙 _) :
    DO.Φ.map (Di.Φ.map e) = 𝟙 _ :=
by
  classical

  have hsep : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) (χ : M ⟶ M) (U : Z.ProEt),
      Sieve.generate (fun (T : Z.ProEt) (_ : T ⟶ U) =>
          ∃ (T₀ : Z.ProEt) (_ : T₀ ≅ T), χ.val.app (Opposite.op T₀) = 𝟙 _)
        ∈ Scheme.ProEt.topology Z U →
      χ.val.app (Opposite.op U) = 𝟙 _ := by
    intro M χ U hU
    let Q := (SheafOfModules.toSheaf _).obj M
    let χ' := (SheafOfModules.toSheaf _).map χ
    have hT : ∀ (T T₀ : Z.ProEt) (β : T₀ ≅ T), χ.val.app (Opposite.op T₀) = 𝟙 _ →
        χ'.hom.app (Opposite.op T) = 𝟙 _ := by
      intro T T₀ β hid
      have h0 : χ'.hom.app (Opposite.op T₀) = 𝟙 _ := by
        ext y
        exact congrArg (fun φ => ModuleCat.Hom.hom φ y) hid
      have hn := χ'.hom.naturality β.hom.op
      rw [h0, Category.comp_id] at hn
      exact (cancel_mono (Q.obj.map β.hom.op)).mp (by rw [Category.id_comp]; exact hn.symm)
    have key : χ'.hom.app (Opposite.op U) = 𝟙 _ := by
      refine Presheaf.IsSheaf.hom_ext Q.2 ⟨_, hU⟩ _ _ ?_
      intro I
      obtain ⟨T, h, g, ⟨T₀, β, hid⟩, hfac⟩ := I.hf
      rw [Category.id_comp, ← hfac, op_comp, Functor.map_comp, ← Category.assoc,
        ← χ'.hom.naturality, Category.assoc, hT T T₀ β hid, Category.id_comp]
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro m
    exact ConcreteCategory.congr_hom key m

  let Vo : Z.ProEt := MorphismProperty.Over.mk ⊤ jO inferInstance
  obtain ⟨hc, -, -⟩ := wc_lpsc_site Z Vo
  haveI := hc
  obtain ⟨θ⟩ := wc_hm_pull_Phi_slice_iso Z ℓ Vo DO hDO

  have hloc : ∀ T : Vo.left.ProEt,
      (Di.Φ.map e).val.app (Opposite.op ((wcSliceFunctor Z Vo).obj T)) = 𝟙 _ := by
    intro T
    have hU' : ((wcSliceFunctor Z Vo).obj T).hom = T.hom ≫ jO := by
      first
        | rfl
        | exact MorphismProperty.Over.map_obj_hom _ _ _
    apply hsep _ (Di.Φ.map e) _
    refine GrothendieckTopology.superset_covering _ (Sieve.generate_mono ?_)
      (wc_pmn_vp_thick_cover ι ℓ Di hDi ((wcSliceFunctor Z Vo).obj T))
    intro T' f hf
    obtain ⟨Vt, β, hW, hcl, hunit⟩ := hf
    refine ⟨(wcProEtBC ι).obj Vt, β, ?_⟩

    have e1 : β.hom.left ≫ f.left ≫ T.hom ≫ jO = Limits.pullback.snd Vt.hom ι := by
      have w1 : f.left ≫ ((wcSliceFunctor Z Vo).obj T).hom = T'.hom := MorphismProperty.Over.w f
      have w2 : β.hom.left ≫ T'.hom = ((wcProEtBC ι).obj Vt).hom := MorphismProperty.Over.w β.hom
      rw [hU'] at w1
      exact (congrArg (fun k => β.hom.left ≫ k) w1).trans (w2.trans rfl)
    have hW6 : ∀ v : Vt.left, IsClosed ({v} : Set Vt.left) → Vt.hom v ∈ Set.range (jO ≫ ι) := by
      intro v hv
      have hv' : v ∈ Set.range (Limits.pullback.fst Vt.hom ι) := by
        rw [Scheme.Pullback.range_fst]; exact hcl v hv
      obtain ⟨z, rfl⟩ := hv'
      refine ⟨T.hom (f.left (β.hom.left z)), ?_⟩
      have c1 : (jO ≫ ι) (T.hom (f.left (β.hom.left z)))
          = ((β.hom.left ≫ f.left ≫ T.hom ≫ jO) ≫ ι) z := by
        first
          | rfl
          | (simp only [Scheme.Hom.comp_apply]; done)
          | exact (Scheme.Hom.comp_apply jO ι _).trans
              ((Scheme.Hom.comp_apply _ ι z).trans (congrArg ι
                ((Scheme.Hom.comp_apply β.hom.left _ z).trans
                  ((Scheme.Hom.comp_apply f.left _ _).trans
                    (Scheme.Hom.comp_apply T.hom jO _))))).symm
      have c2 : ((β.hom.left ≫ f.left ≫ T.hom ≫ jO) ≫ ι) z
          = (Limits.pullback.snd Vt.hom ι ≫ ι) z := congrArg (fun k => (k ≫ ι) z) e1
      have c3 : (Limits.pullback.snd Vt.hom ι ≫ ι) z
          = (Limits.pullback.fst Vt.hom ι ≫ Vt.hom) z :=
        congrArg (fun k : Limits.pullback Vt.hom ι ⟶ S => k z)
          (Limits.pullback.condition (f := Vt.hom) (g := ι)).symm
      exact c1.trans (c2.trans (c3.trans (Scheme.Hom.comp_apply _ _ _)))
    have heV := he Vt hW.1 hW.2.1 hW.2.2.1 hW.2.2.2.1 hW.2.2.2.2 hW6 hunit

    have key := Di.adj.unit_naturality e
    have hx : ∀ x, ((Di.Φ.map e).val.app (Opposite.op ((wcProEtBC ι).obj Vt))).hom
        (((Di.adj.unit.app F).val.app (Opposite.op Vt)).hom x) =
        ((Di.adj.unit.app F).val.app (Opposite.op Vt)).hom x := by
      intro x
      have h2 : (e.val.app (Opposite.op Vt)).hom x = x := by rw [heV]; rfl
      have h1 : ((Di.Φ.map e).val.app (Opposite.op ((wcProEtBC ι).obj Vt))).hom
          (((Di.adj.unit.app F).val.app (Opposite.op Vt)).hom x) =
          ((Di.adj.unit.app F).val.app (Opposite.op Vt)).hom ((e.val.app (Opposite.op Vt)).hom x) :=
        congrArg (fun φ => (φ.val.app (Opposite.op Vt)).hom x) key
      rw [h2] at h1
      exact h1
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro y
    obtain ⟨x, rfl⟩ := (hunit F).2 y
    exact hx x

  have hρ : (wcSliceRes Z ℓ Vo).map (Di.Φ.map e) = 𝟙 _ := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro T
    induction T using Opposite.rec with
    | op T =>
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    exact congrArg (fun φ => ModuleCat.Hom.hom φ x) (hloc T)

  have hnat : DO.Φ.map (Di.Φ.map e) =
      θ.hom.app _ ≫ (wcSliceRes Z ℓ Vo).map (Di.Φ.map e) ≫ θ.inv.app _ := by
    rw [← Category.assoc, ← θ.hom.naturality, Category.assoc, Iso.hom_inv_id_app,
      Category.comp_id]
  rw [hnat, hρ, Category.id_comp]
  first
    | exact θ.hom_inv_id_app _
    | (rw [Iso.hom_inv_id_app]; rfl)

theorem wc_qmtm_restr_epi_of_thick {S Z O : Scheme.{u}} (ι : Z ⟶ S) [IsClosedImmersion ι]
    (jO : O ⟶ Z) [IsOpenImmersion jO] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData ι ℓ) (hDi : wcHMPullCanonical Di)
    (DO : wcHMPullData jO ℓ) (hDO : wcHMPullCanonical DO)
    (F : SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (e : F ⟶ F)
    (he : ∀ Vt : S.ProEt, IsAffine Vt.left → IsClosed {x : Vt.left | IsClosed ({x} : Set Vt.left)} →
      (∀ x : Vt.left, ∃! y : Vt.left, IsClosed ({y} : Set Vt.left) ∧ x ⤳ y) →
      ExtremallyDisconnected {x : Vt.left | IsClosed ({x} : Set Vt.left)} →
      (∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
        HenselianLocalRing (Vt.left.presheaf.stalk x) ∧ IsSepClosed (Vt.left.residueField x)) →
      (∀ v : Vt.left, IsClosed ({v} : Set Vt.left) → Vt.hom v ∈ Set.range (jO ≫ ι)) →
      (∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
        Function.Bijective ((Di.adj.unit.app M).val.app (Opposite.op Vt)).hom) →
      Function.Surjective ((e - 𝟙 F).val.app (Opposite.op Vt)).hom) :
    Epi (DO.Φ.map (Di.Φ.map e - 𝟙 _)) :=
by
  classical
  haveI := Di.additive
  haveI := DO.additive
  haveI := Di.cont
  have hψeq : Di.Φ.map (e - 𝟙 F) = Di.Φ.map e - 𝟙 (Di.Φ.obj F) := by
    rw [Functor.map_sub, CategoryTheory.Functor.map_id]
  let Vo : Z.ProEt := MorphismProperty.Over.mk ⊤ jO (inferInstance : WeaklyEtale jO)
  obtain ⟨hcont, hcocont, -⟩ := wc_lpsc_site Z Vo
  haveI := hcont
  haveI := hcocont
  obtain ⟨η⟩ := wc_hm_pull_Phi_slice_iso Z ℓ Vo DO hDO
  have hepi : Epi ((wcSliceRes Z ℓ Vo).map (Di.Φ.map e - 𝟙 (Di.Φ.obj F))) := by
    haveI := Functor.reflectsEpimorphisms_of_faithful
      (SheafOfModules.toSheaf (wcRingSheaf Vo.left ℓ))
    apply (SheafOfModules.toSheaf (wcRingSheaf Vo.left ℓ)).epi_of_epi_map
    haveI : Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf (wcRingSheaf Vo.left ℓ)).map
        ((wcSliceRes Z ℓ Vo).map (Di.Φ.map e - 𝟙 (Di.Φ.obj F)))) := by
      apply Presheaf.IsLocallySurjective.mk
      intro T s
      have hR := Functor.cover_lift (wcSliceFunctor Z Vo) (Scheme.ProEt.topology Vo.left)
        (Scheme.ProEt.topology Z) (wc_pmn_vp_thick_cover ι ℓ Di hDi ((wcSliceFunctor Z Vo).obj T))
      refine GrothendieckTopology.superset_covering _ ?_ hR
      intro T' g hg
      obtain ⟨T'', h, f₀, ⟨Vt, β, hW, hcl, hunit⟩, hcomp⟩ := hg
      rw [Presheaf.imageSieve_apply]
      have hUhom : ((wcSliceFunctor Z Vo).obj T).hom = T.hom ≫ jO := by
        first
          | rfl
          | exact MorphismProperty.Over.map_obj_hom _ _ _

      have hW6 : ∀ v : Vt.left, IsClosed ({v} : Set Vt.left) → Vt.hom v ∈ Set.range (jO ≫ ι) := by
        intro v hv
        have hv' : v ∈ Set.range (Limits.pullback.fst Vt.hom ι) := by
          rw [Scheme.Pullback.range_fst]; exact hcl v hv
        obtain ⟨w, hw⟩ := hv'
        have h1 : f₀.left ≫ T.hom ≫ jO = T''.hom := by
          first
            | exact MorphismProperty.Over.w f₀
