      (kO : O ⟶ Spec (.of (Localization.Away ((Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))))))),
      IsPullback jO kO ι (Spec.map (CommRingCat.ofHom (algebraMap B
