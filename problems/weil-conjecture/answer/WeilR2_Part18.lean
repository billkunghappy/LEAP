    (t : (Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶ I.cochainComplex)
    (hLP : (Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t =
      (HomologicalComplex.singleMapHomologicalComplex Φ (ComplexShape.up ℤ) 0).hom.app O ≫
      (HomologicalComplex.single C (ComplexShape.up ℤ) 0).map e ≫ I.ι')
    (c : X ⟶ Φ.obj X)
    (z z' : CochainComplex.HomComplex.Cocycle ((CochainComplex.singleFunctor C 0).obj X)
      I.cochainComplex (n : ℤ))
    (hz : CochainComplex.HomComplex.Cochain.fromSingleEquiv (zero_add (n : ℤ))
        (z' : CochainComplex.HomComplex.Cochain _ _ (n : ℤ)) =
      c ≫ Φ.map (CochainComplex.HomComplex.Cochain.fromSingleEquiv (zero_add (n : ℤ))
        (z : CochainComplex.HomComplex.Cochain _ _ (n : ℤ))) ≫ t.f (n : ℤ)) :
    I.extEquivCohomologyClass.symm (CochainComplex.HomComplex.CohomologyClass.mk z') =
      (Abelian.Ext.mk₀ c).comp ((Φ.mapExtAddHom X O n
        (I.extEquivCohomologyClass.symm (CochainComplex.HomComplex.CohomologyClass.mk z))).comp
          (Abelian.Ext.mk₀ e) (add_zero n)) (zero_add n) :=
by
  classical



  have s1 : ∀ (w : CochainComplex.HomComplex.Cocycle ((CochainComplex.singleFunctor C 0).obj X)
      I.cochainComplex (n : ℤ)),
      (CochainComplex.HomComplex.Cocycle.equivHomShift.symm w).f 0 =
