by
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) := HasExt.standard _
  intro x
  have hGC := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology S)
