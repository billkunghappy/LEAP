      haveI : QuasiCompact (Limits.pullback.fst (Limits.pullback.snd Vt.hom f) g) :=
        MorphismProperty.of_isPullback (P := @QuasiCompact) (IsPullback.of_hasPullback _ _).flip
          ‹QuasiCompact g›
      haveI : QuasiCompact (Limits.pullback.fst Vt.hom f) :=
        MorphismProperty.of_isPullback (P := @QuasiCompact) (IsPullback.of_hasPullback _ _).flip
          ‹QuasiCompact f›
      haveI : QuasiCompact pr := inferInstance
      haveI : CompactSpace ↥((𝟭 Scheme).obj Vt.left) := (inferInstance : CompactSpace Vt.left)
      haveI : CompactSpace ↥(Limits.pullback (Limits.pullback.snd Vt.hom f) g) :=
        QuasiCompact.compactSpace_of_compactSpace pr
      have hfib : ∀ w : ↥Vt.left, IsClosed ({w} : Set ↥Vt.left) →
          _root_.IsPreconnected (pr.base.hom ⁻¹' {y | y ⤳ w}) ∧
          (pr.base.hom ⁻¹' {y | y ⤳ w}).Nonempty := by
        intro w hw
        have hhs := hW.2.2.2.2 w hw
        have hconn := hmfc Vt w hhs.1 hhs.2 (hcl w hw)
        let c := Vt.left.fromSpecStalk w
        let e := Limits.pullbackLeftPullbackSndIso Vt.hom f g
        have h₁ : c ≫ 𝟙 _ = 𝟙 _ ≫ c := by simp
        have h₂ : pr ≫ 𝟙 _ = e.hom ≫ Limits.pullback.fst Vt.hom (g ≫ f) := by
          rw [Category.comp_id, Limits.pullbackLeftPullbackSndIso_hom_fst]
        haveI := Limits.pullback.map_isIso c pr c (Limits.pullback.fst Vt.hom (g ≫ f))
          (𝟙 _) e.hom (𝟙 _) h₁ h₂
        let φiso := asIso (Limits.pullback.map c pr c (Limits.pullback.fst Vt.hom (g ≫ f))
          (𝟙 _) e.hom (𝟙 _) h₁ h₂) ≪≫ Limits.pullbackRightPullbackFstIso Vt.hom (g ≫ f) c
        have hconn2 : ConnectedSpace ↥(Limits.pullback c pr) :=
          @Function.Surjective.connectedSpace _ _ _ hconn _ _
            (Scheme.homeoOfIso φiso.symm).surjective (Scheme.homeoOfIso φiso.symm).continuous
        have hset : pr.base.hom ⁻¹' {y | y ⤳ w} =
            Set.range (Limits.pullback.snd c pr) := by
          rw [Scheme.Pullback.range_snd, Scheme.range_fromSpecStalk]
          rfl
        rw [hset]
