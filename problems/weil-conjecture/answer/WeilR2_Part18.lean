          AddCommGrpCat.{u+1}).obj (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙
            AddCommGrpCat.free) ⟶ Fs =>
        φ.hom.app (Opposite.op T)
          ((toSheafify (Scheme.ProEt.topology S)
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
            (Opposite.op T) (FreeAbelianGroup.of (ULift.up (𝟙 T))))) := by
    intro T Fs
    let e2 : ∀ G : (S.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1},
        (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃
