theorem wc_qmbt_nt_generic_fibre {A : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    {n : ℕ} {π : A} {c : Matrix (Fin n) (Fin n) A}
    {B₀ : Type u} [CommRing B₀]
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    {L : Type u} [Field L] {φA : A →+* L} (hφA : Function.Injective φA)
    {XE : Scheme.{u}} {p : XE ⟶ Spec (.of B₀)} {q : XE ⟶ Spec (.of L)}
    (hpb : IsPullback p q (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom φA)))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] {ιA : A →+* A'} {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {L' : Type u} [Field L'] {ιL : L →+* L'}
    {φ' : A' →+* L'} (hφ' : Function.Injective φ') (hφ'A : φ'.comp ιA = ιL.comp φA)
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
    (hblf : bl ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA)) = f)
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ'))) :
    ∃ βE : XE' ⟶ XE,
      βE ≫ p = p' ≫ bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA)) ∧
      IsPullback βE q' q (Spec.map (CommRingCat.ofHom ιL)) :=
by
  classical

  have s3 : ∀ {B S S' E E' P₀ Xm XE XE' : Scheme.{u}} (gB : B ⟶ S) (φ : E ⟶ S) (ι : S' ⟶ S)
      (φ₁ : E' ⟶ S') (ιE : E' ⟶ E), φ₁ ≫ ι = ιE ≫ φ →
      ∀ (fst : P₀ ⟶ B) (snd : P₀ ⟶ S'), IsPullback fst snd gB ι →
      ∀ (bl : Xm ⟶ P₀) (f : Xm ⟶ S'), bl ≫ snd = f →
      (∀ (T : Scheme.{u}) (h : T ⟶ P₀) (k : T ⟶ E'), h ≫ snd = k ≫ φ₁ →
        ∃! h' : T ⟶ Xm, h' ≫ bl = h) →
      ∀ (p : XE ⟶ B) (q : XE ⟶ E), IsPullback p q gB φ →
      ∀ (p' : XE' ⟶ Xm) (q' : XE' ⟶ E'), IsPullback p' q' f φ₁ →
      ∃ βE : XE' ⟶ XE, βE ≫ p = p' ≫ bl ≫ fst ∧ IsPullback βE q' q ιE := by
    intro B S S' E E' P₀ Xm XE XE' gB φ ι φ₁ ιE hcomm fst snd hP bl f hblf hlift p q hpb p' q' hpb'
    have w : (p' ≫ bl ≫ fst) ≫ gB = (q' ≫ ιE) ≫ φ := by
      calc (p' ≫ bl ≫ fst) ≫ gB = p' ≫ bl ≫ (fst ≫ gB) := by simp only [Category.assoc]
        _ = p' ≫ (bl ≫ snd) ≫ ι := by rw [hP.w]; simp only [Category.assoc]
        _ = (p' ≫ f) ≫ ι := by rw [hblf, Category.assoc]
        _ = q' ≫ (φ₁ ≫ ι) := by rw [hpb'.w, Category.assoc]
        _ = (q' ≫ ιE) ≫ φ := by rw [hcomm, Category.assoc]
    have key : ∀ (T : Scheme.{u}) (a : T ⟶ XE) (b : T ⟶ E'), a ≫ q = b ≫ ιE →
        ∃ l : T ⟶ XE', l ≫ hpb.lift _ _ w = a ∧ l ≫ q' = b ∧
          ∀ m : T ⟶ XE', m ≫ hpb.lift _ _ w = a → m ≫ q' = b → m = l := by
      intro T a b hab
      have w1 : (a ≫ p) ≫ gB = (b ≫ φ₁) ≫ ι := by
        calc (a ≫ p) ≫ gB = a ≫ (p ≫ gB) := Category.assoc _ _ _
          _ = (a ≫ q) ≫ φ := by rw [hpb.w, Category.assoc]
          _ = b ≫ (ιE ≫ φ) := by rw [hab, Category.assoc]
          _ = (b ≫ φ₁) ≫ ι := by rw [← hcomm, Category.assoc]
      obtain ⟨h', hh', huniq⟩ := hlift T (hP.lift _ _ w1) b (hP.lift_snd _ _ w1)
      have w2 : h' ≫ f = b ≫ φ₁ := by
        rw [← hblf, ← Category.assoc, hh', hP.lift_snd]
      refine ⟨hpb'.lift h' b w2, ?_, hpb'.lift_snd _ _ _, ?_⟩
      · apply hpb.hom_ext
        · rw [Category.assoc, hpb.lift_fst, ← Category.assoc, ← Category.assoc, hpb'.lift_fst, hh',
            hP.lift_fst]
        · rw [Category.assoc, hpb.lift_snd, ← Category.assoc, hpb'.lift_snd, hab]
      · intro m hm1 hm2
        apply hpb'.hom_ext
        · rw [hpb'.lift_fst]
          apply huniq
          apply hP.hom_ext
          · rw [hP.lift_fst, ← hm1]
            simp only [Category.assoc, hpb.lift_fst]
          · rw [hP.lift_snd, ← hm2]
            simp only [Category.assoc, hblf, hpb'.w]
        · rw [hpb'.lift_snd, hm2]
    refine ⟨hpb.lift _ _ w, hpb.lift_fst _ _ w, ?_⟩
    refine IsPullback.of_isLimit' ⟨hpb.lift_snd _ _ w⟩ ?_
    exact Limits.PullbackCone.IsLimit.mk _ (fun s => Classical.choose (key s.pt s.fst s.snd s.condition))
      (fun s => (Classical.choose_spec (key s.pt s.fst s.snd s.condition)).1)
      (fun s => (Classical.choose_spec (key s.pt s.fst s.snd s.condition)).2.1)
      (fun s m h1 h2 => (Classical.choose_spec (key s.pt s.fst s.snd s.condition)).2.2 m h1 h2)

  have s1 : ∀ {X T : Scheme.{u}} (J : Ideal Γ(X, ⊤)) (r : Γ(X, ⊤)), r ∈ J → ∀ (h : T ⟶ X),
      IsUnit (h.appTop.hom r) → wcCsdInvPull (Scheme.IdealSheafData.ofIdealTop J) h := by
    intro X T J r hr h hu t
    obtain ⟨U, hU, hxU, -⟩ := exists_isAffineOpen_mem_and_subset (x := h.base t) (U := ⊤) trivial
    obtain ⟨V, hV, htV, hVU0⟩ := exists_isAffineOpen_mem_and_subset (x := t) (U := h ⁻¹ᵁ U) hxU
    have hVU : V ≤ h ⁻¹ᵁ U := hVU0
    have ha : (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom r ∈
        (Scheme.IdealSheafData.ofIdealTop J).ideal ⟨U, hU⟩ := by
      rw [Scheme.IdealSheafData.ofIdealTop_ideal]
      exact Ideal.mem_map_of_mem _ hr
    have hu' : IsUnit ((h.appLE U V hVU).hom
        ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom r)) := by
      rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Scheme.Hom.map_appLE]
      exact hu.map (T.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom
    refine ⟨⟨U, hU⟩, ⟨V, hV⟩, hVU, (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom r, htV,
      ha, hu'.mem_nonZeroDivisors, ?_⟩
    rw [Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ ha) hu',
      Ideal.span_singleton_eq_top.mpr hu']

  have hπ0 : π' ≠ 0 := by
    intro h0
    apply IsDiscreteValuationRing.not_a_field A'
    rw [hπ', h0]
    exact Ideal.span_singleton_eq_bot.mpr rfl

  have hunit : ∀ (T : Scheme.{u})
      (h : T ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
      (k : T ⟶ Spec (.of L')),
      h ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) =
        k ≫ Spec.map (CommRingCat.ofHom φ') →
      IsUnit (h.appTop.hom ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
        (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))) := by
    intro T h k hk
    have hc : ∀ {Y : Scheme.{u}} (g : Y ⟶ Spec (.of A')) (h : T ⟶ Y) (y : Γ(Spec (.of A'), ⊤)),
        h.appTop.hom (g.appTop.hom y) = (h ≫ g).appTop.hom y := by
      intro Y g h y
      rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    rw [hc, hk, ← hc]
    have e := congrArg (fun g => g.hom π')
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom φ'))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e
    rw [← e]
    exact ((isUnit_iff_ne_zero.mpr ((map_ne_zero_iff φ' hφ').mpr hπ0)).map _).map _
  have hcomm : Spec.map (CommRingCat.ofHom φ') ≫ Spec.map (CommRingCat.ofHom ιA) =
      Spec.map (CommRingCat.ofHom ιL) ≫ Spec.map (CommRingCat.ofHom φA) := by
    rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp,
      hφ'A]
  have hlift : ∀ (T : Scheme.{u})
      (h : T ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)))
      (k : T ⟶ Spec (.of L')),
      h ≫ Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA)) =
        k ≫ Spec.map (CommRingCat.ofHom φ') → ∃! h' : T ⟶ Xm, h' ≫ bl = h := by
    intro T h k hk
    refine hbl.2 T h (s1 _ _ ?_ h (hunit T h k hk))
    exact Ideal.subset_span ⟨none, rfl⟩
  exact s3 _ _ _ _ _ hcomm _ _ (IsPullback.of_hasPullback _ _) bl f hblf hlift p q hpb p' q' hpb'

theorem wc_bp_blowup_charts {X X' : Scheme.{u}} [IsAffine X] {ι : Type} [Finite ι]
    (g : ι → Γ(X, ⊤)) (r : X' ⟶ X)
    (hr : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g))) r) :
    ∃ (U : ι → X'.Opens) (t : ∀ l : ι, ι → Γ(X', U l)), wcBpChartHyp r g U t :=
by
  classical
  let U₀ : X.affineOpens := ⟨⊤, isAffineOpen_top X⟩
  have hI0 : (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g))).ideal U₀ =
      Ideal.span (Set.range g) := by
    rw [Scheme.IdealSheafData.ofIdealTop_ideal]
    have h : ∀ f : (⊤ : X.Opens) ⟶ ⊤, X.presheaf.map f.op = 𝟙 _ := fun f => by
      rw [Subsingleton.elim f (𝟙 _), op_id, CategoryTheory.Functor.map_id]
    first
      | (rw [h, CommRingCat.hom_id, Ideal.map_id])
      | (erw [h, CommRingCat.hom_id, Ideal.map_id])
      | (simp only [h, CommRingCat.hom_id, Ideal.map_id])
  generalize hIg : Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range g)) = I at hr hI0
  have hgl : ∀ j, g j ∈ I.ideal U₀ := fun j => by rw [hI0]; exact Ideal.subset_span ⟨j, rfl⟩
  have isoNZD : ∀ {R S : CommRingCat.{u}} (e : R ≅ S) (a : R),
      a ∈ nonZeroDivisors R → e.hom.hom a ∈ nonZeroDivisors S := by
    intro R S e a ha
    have h1 := Submonoid.mem_map_of_mem e.commRingCatIsoToRingEquiv ha
    rw [MulEquivClass.map_nonZeroDivisors] at h1
    exact h1
  obtain ⟨n, ⟨eqv⟩⟩ := Finite.exists_equiv_fin ι
  have hspanE : Ideal.span (Set.range (fun i : Fin n => g (eqv.symm i))) = I.ideal U₀ := by
    rw [hI0]; congr 1; exact eqv.symm.surjective.range_comp g

  have hopen : ∀ l, IsOpen {x : X' | wcCsdChartAt I r U₀ (g l) x} := by
    intro l
    rw [isOpen_iff_forall_mem_open]
    rintro x ⟨V, e, hx, hnzd, hspan⟩
    exact ⟨V.1, fun y hy => ⟨V, e, hy, hnzd, hspan⟩, V.1.isOpen, hx⟩
  let U : ι → X'.Opens := fun l => ⟨{x : X' | wcCsdChartAt I r U₀ (g l) x}, hopen l⟩
  have hcov : (⨆ l, U l) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    obtain ⟨j, hj⟩ := wc_csd_invpull_generator_chart X X' I r hr.1 U₀ n
      (fun i => g (eqv.symm i)) hspanE x
      (by first | trivial | simp [U₀] | exact Set.mem_univ _)
    exact ⟨eqv.symm j, hj⟩

  have hT1 : ∀ (W : X'.Opens) (e : ⊤ ≤ (W.ι ≫ r) ⁻¹ᵁ ⊤),
      (W.ι ≫ r).appLE ⊤ ⊤ e ≫ W.topIso.hom = r.appLE ⊤ W (by simp) := by
    intro W e
    have e' : (⊤ : W.toScheme.Opens) ≤ W.ι ⁻¹ᵁ (r ⁻¹ᵁ ⊤) := e
    have h1 : W.ι.appLE (r ⁻¹ᵁ ⊤) ⊤ e' ≫ W.topIso.hom =
        X'.presheaf.map (homOfLE (by simp : W ≤ r ⁻¹ᵁ ⊤)).op := by
      rw [Scheme.Opens.ι_appLE, Scheme.Opens.topIso_hom]
      exact (X'.presheaf.map_comp _ _).symm.trans (congrArg X'.presheaf.map (Subsingleton.elim _ _))
    have h2 : (W.ι ≫ r).appLE ⊤ ⊤ e = r.app ⊤ ≫ W.ι.appLE (r ⁻¹ᵁ ⊤) ⊤ e' :=
      Scheme.Hom.comp_appLE _ _ _ _ _
    rw [h2, Category.assoc, h1, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]

  have s2 : ∀ (l : ι) (W : X'.Opens), (∀ x ∈ W, wcCsdChartAt I r U₀ (g l) x) →
      (r.appLE ⊤ W (by simp)).hom (g l) ∈ nonZeroDivisors Γ(X', W) ∧
      Ideal.map (r.appLE ⊤ W (by simp)).hom (Ideal.span (Set.range g)) =
        Ideal.span {(r.appLE ⊤ W (by simp)).hom (g l)} ∧
      wcCsdInvPull I (W.ι ≫ r) := by
    intro l W hW
    have hch : ∀ y : W.toScheme, wcCsdChartAt I (W.ι ≫ r) U₀ (g l) y := fun y =>
      (wc_csd_chart_open_imm X X' W.toScheme I W.ι r U₀ (g l) y).mp
        (hW _ (by
          first
            | exact y.2
            | (have h := Set.mem_range_self (f := W.ι) y
               rw [Scheme.Opens.range_ι] at h
               exact h)
            | simpa using y.2))
    have hinv : wcCsdInvPull I (W.ι ≫ r) := by
      intro y
      obtain ⟨V, e, hy, hnzd, hspan⟩ := hch y
      exact ⟨U₀, V, e, g l, hy, hgl l, hnzd, hspan⟩
    have he : (⊤ : W.toScheme.Opens) ≤ (W.ι ≫ r) ⁻¹ᵁ ⊤ := by simp
    have hGS : ((W.ι ≫ r).appLE ⊤ ⊤ he).hom (g l) ∈ nonZeroDivisors Γ(W.toScheme, ⊤) ∧
        Ideal.map ((W.ι ≫ r).appLE ⊤ ⊤ he).hom (I.ideal U₀) =
          Ideal.span {((W.ι ≫ r).appLE ⊤ ⊤ he).hom (g l)} :=
      wc_csd_chart_global_sections X W.toScheme I (W.ι ≫ r) U₀ (g l) (hgl l) hch he
    have key := hT1 W he
    refine ⟨?_, ?_, hinv⟩
    · have := isoNZD W.topIso _ hGS.1
      rw [← key]
      exact this
    · rw [← key, CommRingCat.hom_comp, ← Ideal.map_map, ← hI0, hGS.2, Ideal.map_span,
        Set.image_singleton]
      try rfl

  have s4 : ∀ (l k : ι) (Wl : X'.Opens), IsAffineOpen Wl → ∀ (τ : Γ(X', Wl)),
      (r.appLE ⊤ Wl (by simp)).hom (g k) = τ * (r.appLE ⊤ Wl (by simp)).hom (g l) →
      (r.appLE ⊤ Wl (by simp)).hom (g l) ∈ nonZeroDivisors Γ(X', Wl) →
      Ideal.map (r.appLE ⊤ Wl (by simp)).hom (Ideal.span (Set.range g)) =
        Ideal.span {(r.appLE ⊤ Wl (by simp)).hom (g l)} →
      X'.basicOpen τ ≤ U k := by
    intro l k Wl hWl τ hrel hnzd hspan x hx
    show wcCsdChartAt I r U₀ (g k) x
    have hDle : X'.basicOpen τ ≤ Wl := X'.basicOpen_le τ
    have heD : X'.basicOpen τ ≤ r ⁻¹ᵁ ⊤ := by simp
    have hres : r.appLE ⊤ (X'.basicOpen τ) heD =
        r.appLE ⊤ Wl (by simp) ≫ X'.presheaf.map (homOfLE hDle).op :=
      (Scheme.Hom.appLE_map _ _ _).symm
    have hu : IsUnit ((X'.presheaf.map (homOfLE hDle).op).hom τ) := by
      exact X'.toRingedSpace.isUnit_res_basicOpen τ
    refine ⟨⟨X'.basicOpen τ, hWl.basicOpen τ⟩, heD, hx, ?_, ?_⟩
    · show (r.appLE ⊤ (X'.basicOpen τ) heD).hom (g k) ∈ nonZeroDivisors Γ(X', X'.basicOpen τ)
      rw [hres, CommRingCat.hom_comp, RingHom.comp_apply, hrel, map_mul]
      exact mul_mem_nonZeroDivisors.mpr ⟨hu.mem_nonZeroDivisors,
        wc_csd_nzd_restrict X' Wl _ hDle hWl _ hnzd⟩
    · show Ideal.map (r.appLE ⊤ (X'.basicOpen τ) heD).hom (I.ideal U₀) =
        Ideal.span {(r.appLE ⊤ (X'.basicOpen τ) heD).hom (g k)}
      rw [hres, hI0, CommRingCat.hom_comp, ← Ideal.map_map, hspan, Ideal.map_span,
        Set.image_singleton, RingHom.comp_apply, hrel, map_mul,
        Ideal.span_singleton_mul_left_unit hu]
      try rfl

  have s5 : ∀ (l : ι) (W : X'.Opens) (τ : ι → Γ(X', W)),
      (∀ x : X', wcCsdChartAt I r U₀ (g l) x → x ∈ W) →
      (∀ j, (r.appLE ⊤ W (by simp)).hom (g j) = τ j * (r.appLE ⊤ W (by simp)).hom (g l)) →
      (r.appLE ⊤ W (by simp)).hom (g l) ∈ nonZeroDivisors Γ(X', W) →
      wcCsdInvPull I (W.ι ≫ r) →
      IsAffineOpen W ∧ ∀ s : Γ(X', W),
        s ∈ Subring.closure (Set.range (r.appLE ⊤ W (by simp)).hom ∪ Set.range τ) := by
    intro l W τ hWc hrel hnzdW hinvW
    let B : Subring Γ(X', W) := Subring.closure (Set.range (r.appLE ⊤ W (by simp)).hom ∪ Set.range τ)
    let Bc : CommRingCat.{u} := CommRingCat.of B
    let ρ' : Γ(X, ⊤) →+* B := (r.appLE ⊤ W (by simp)).hom.codRestrict B
      (fun a => Subring.subset_closure (Or.inl ⟨a, rfl⟩))
    let τ' : ι → B := fun j => ⟨τ j, Subring.subset_closure (Or.inr ⟨j, rfl⟩)⟩
    have a1 : ∀ j, ρ' (g j) = τ' j * ρ' (g l) := fun j => Subtype.ext (hrel j)
    have a2 : ρ' (g l) ∈ nonZeroDivisors B := by
      rw [mem_nonZeroDivisors_iff_right]
      intro y hy
      have : y.1 * (r.appLE ⊤ W (by simp)).hom (g l) = 0 := congrArg Subtype.val hy
      exact Subtype.ext (mem_nonZeroDivisors_iff_right.mp hnzdW _ this)
    have a3 : Ideal.map ρ' (Ideal.span (Set.range g)) = Ideal.span {ρ' (g l)} := by
      apply le_antisymm
      · rw [Ideal.map_span, Ideal.span_le]
        rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
        rw [SetLike.mem_coe, Ideal.mem_span_singleton']
        exact ⟨τ' j, (a1 j).symm⟩
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨l, rfl⟩)
    let φ : Γ(X, ⊤) ⟶ Bc := CommRingCat.ofHom ρ'
    have a4nzd : (φ ≫ (Scheme.ΓSpecIso Bc).inv).hom (g l) ∈ nonZeroDivisors Γ(Spec Bc, ⊤) :=
      isoNZD (Scheme.ΓSpecIso Bc).symm _ a2
    have a4span : Ideal.map (φ ≫ (Scheme.ΓSpecIso Bc).inv).hom (I.ideal U₀) =
        Ideal.span {(φ ≫ (Scheme.ΓSpecIso Bc).inv).hom (g l)} := by
      rw [hI0, CommRingCat.hom_comp, ← Ideal.map_map, show φ.hom = ρ' from rfl, a3,
        Ideal.map_span, Set.image_singleton]
      try rfl
    obtain ⟨P1, P2, P3⟩ := wc_csd_chart_spec_maps X ⊤ (isAffineOpen_top X) Bc φ
    generalize hσdef : Spec.map φ ≫ (isAffineOpen_top X).fromSpec = σ at P1 P2
    have heσ : (⊤ : (Spec Bc).Opens) ≤ σ ⁻¹ᵁ ⊤ := by simp
    have hP1 := P1 heσ
    have hchσ : ∀ p, wcCsdChartAt I σ U₀ (g l) p := by
      intro p
      refine ⟨⟨⊤, isAffineOpen_top _⟩, heσ, (by first | trivial | simp | exact Set.mem_univ _),
        ?_, ?_⟩
      · show (σ.appLE ⊤ ⊤ heσ).hom (g l) ∈ nonZeroDivisors Γ(Spec Bc, ⊤)
        rw [hP1]; exact a4nzd
      · show Ideal.map (σ.appLE ⊤ ⊤ heσ).hom (I.ideal U₀) =
          Ideal.span {(σ.appLE ⊤ ⊤ heσ).hom (g l)}
        rw [hP1]; exact a4span
    have hinvσ : wcCsdInvPull I σ := fun p => by
      obtain ⟨V, e, hp, hn, hs⟩ := hchσ p
      exact ⟨U₀, V, e, g l, hp, hgl l, hn, hs⟩
    obtain ⟨c, hc, -⟩ := hr.2 (Spec Bc) σ hinvσ
    have hcW : Set.range c ⊆ Set.range W.ι := by
      rintro _ ⟨p, rfl⟩
      rw [Scheme.Opens.range_ι, SetLike.mem_coe]
      obtain ⟨j, hj⟩ := wc_csd_invpull_generator_chart X X' I r hr.1 U₀ n
        (fun i => g (eqv.symm i)) hspanE (c p)
        (by first | trivial | simp [U₀] | exact Set.mem_univ _)
      have hch2 : wcCsdChartAt I (c ≫ r) U₀ (g l) p := by rw [hc]; exact hchσ p
      exact hWc _ (wc_csd_good_locus_open X X' (Spec Bc) I r c U₀ (g l) (g (eqv.symm j)) p
        (hgl l) hj hch2)
    obtain ⟨c', hc'⟩ : ∃ c' : Spec Bc ⟶ W.toScheme, c' ≫ W.ι = c :=
      ⟨_, IsOpenImmersion.lift_fac W.ι c hcW⟩
    obtain ⟨d, hd, -⟩ := P3 W.toScheme (CommRingCat.ofHom B.subtype ≫ W.topIso.inv)
    have heW : (⊤ : W.toScheme.Opens) ≤ (W.ι ≫ r) ⁻¹ᵁ ⊤ := by simp
    have hf : d ≫ σ = W.ι ≫ r := by
      rw [P2 W.toScheme (W.ι ≫ r) heW d, hd, ← Category.assoc, Iso.comp_inv_eq, hT1 W heW]
      ext a
      rfl
    have hg1 : d ≫ c = W.ι := by
      obtain ⟨h0, -, huniq⟩ := hr.2 W.toScheme (W.ι ≫ r) hinvW
      exact (huniq _ (show (d ≫ c) ≫ r = W.ι ≫ r by rw [Category.assoc, hc, hf])).trans
        (huniq _ (show W.ι ≫ r = W.ι ≫ r from rfl)).symm
    have hg : d ≫ c' = 𝟙 _ := by
      rw [← cancel_mono W.ι, Category.assoc, hc', hg1, Category.id_comp]
    have hcd : (c' ≫ d) ≫ σ = σ := by
      rw [Category.assoc, hf, ← Category.assoc, hc', hc]
    have hP2eq := (P2 (Spec Bc) σ heσ (c' ≫ d)).mp hcd
    rw [hP1] at hP2eq
    have hρ' : ∀ a, ((Scheme.ΓSpecIso Bc).inv ≫ (c' ≫ d).appTop).hom (ρ' a) =
        (Scheme.ΓSpecIso Bc).inv.hom (ρ' a) := fun a => congrArg (fun f => f.hom a) hP2eq
    have hh : c' ≫ d = 𝟙 _ := by
      obtain ⟨c0, -, hu⟩ := P3 (Spec Bc) (Scheme.ΓSpecIso Bc).inv
      refine (hu _ ?_).trans (hu _ ?_).symm
      · show (Scheme.ΓSpecIso Bc).inv ≫ (c' ≫ d).appTop = (Scheme.ΓSpecIso Bc).inv
        ext y
        obtain ⟨y, hy⟩ := y
        induction hy using Subring.closure_induction with
        | mem x hx =>
          rcases hx with ⟨a, rfl⟩ | ⟨j, rfl⟩
          · exact hρ' a
          · have e1 : ((Scheme.ΓSpecIso Bc).inv ≫ (c' ≫ d).appTop).hom (ρ' (g j)) =
                ((Scheme.ΓSpecIso Bc).inv ≫ (c' ≫ d).appTop).hom (τ' j) *
                ((Scheme.ΓSpecIso Bc).inv ≫ (c' ≫ d).appTop).hom (ρ' (g l)) := by
              rw [a1 j, map_mul]
            have e2 : (Scheme.ΓSpecIso Bc).inv.hom (ρ' (g j)) =
                (Scheme.ΓSpecIso Bc).inv.hom (τ' j) * (Scheme.ΓSpecIso Bc).inv.hom (ρ' (g l)) := by
              rw [a1 j, map_mul]
            rw [hρ', hρ'] at e1
            have e3 : (((Scheme.ΓSpecIso Bc).inv ≫ (c' ≫ d).appTop).hom (τ' j) -
                (Scheme.ΓSpecIso Bc).inv.hom (τ' j)) * (Scheme.ΓSpecIso Bc).inv.hom (ρ' (g l)) = 0 := by
              rw [sub_mul, ← e1, ← e2, sub_self]
            exact sub_eq_zero.mp (mem_nonZeroDivisors_iff_right.mp a4nzd _ e3)
        | zero => exact (map_zero _).trans (map_zero _).symm
        | one => exact (map_one _).trans (map_one _).symm
        | add x y hx hy ihx ihy =>
          have e : (⟨x + y, add_mem hx hy⟩ : B) = ⟨x, hx⟩ + ⟨y, hy⟩ := rfl
          rw [e, map_add, map_add, ihx, ihy]
        | neg x hx ihx =>
          have e : (⟨-x, neg_mem hx⟩ : B) = -⟨x, hx⟩ := rfl
          rw [e, map_neg, map_neg, ihx]
        | mul x y hx hy ihx ihy =>
          have e : (⟨x * y, mul_mem hx hy⟩ : B) = ⟨x, hx⟩ * ⟨y, hy⟩ := rfl
          rw [e, map_mul, map_mul, ihx, ihy]
      · show (Scheme.ΓSpecIso Bc).inv ≫ (𝟙 (Spec Bc) : Spec Bc ⟶ Spec Bc).appTop =
          (Scheme.ΓSpecIso Bc).inv
        rw [Scheme.Hom.id_appTop, Category.comp_id]
    refine ⟨?_, ?_⟩
    · haveI : IsIso d := ⟨⟨c', hg, hh⟩⟩
      exact IsAffine.of_isIso d
    · intro s
      have h1 : ∀ z, d.appTop.hom (c'.appTop.hom z) = z := by
        intro z
        have := congrArg (fun f => f.hom z) (congrArg Scheme.Hom.appTop hg)
        rw [Scheme.Hom.comp_appTop, Scheme.Hom.id_appTop] at this
        exact this
      have e1 : ∀ y, (Scheme.ΓSpecIso Bc).inv.hom ((Scheme.ΓSpecIso Bc).hom.hom y) = y :=
        fun y => by
          show ((Scheme.ΓSpecIso Bc).hom ≫ (Scheme.ΓSpecIso Bc).inv).hom y = y
          rw [Iso.hom_inv_id]
          try rfl
      obtain ⟨b, hb⟩ : ∃ b : B, (CommRingCat.ofHom B.subtype ≫ W.topIso.inv).hom b =
          W.topIso.inv.hom s := by
        refine ⟨(Scheme.ΓSpecIso Bc).hom.hom (c'.appTop.hom (W.topIso.inv.hom s)), ?_⟩
        rw [← hd]
        show d.appTop.hom ((Scheme.ΓSpecIso Bc).inv.hom ((Scheme.ΓSpecIso Bc).hom.hom
          (c'.appTop.hom (W.topIso.inv.hom s)))) = _
        rw [e1, h1]
      have hb' : (b : Γ(X', W)) = s := by
        have h4 := congrArg W.topIso.hom.hom hb
        change (W.topIso.inv ≫ W.topIso.hom).hom b.1 = (W.topIso.inv ≫ W.topIso.hom).hom s at h4
        rw [Iso.inv_hom_id] at h4
        exact h4
      rw [← hb']
      exact b.2

  choose hnzd hspan hinv using fun l => s2 l (U l) (fun x hx => hx)
  have hrat : ∀ l j, ∃ a : Γ(X', U l), (r.appLE ⊤ (U l) (by simp)).hom (g j) =
      a * (r.appLE ⊤ (U l) (by simp)).hom (g l) := by
    intro l j
    have hmem : (r.appLE ⊤ (U l) (by simp)).hom (g j) ∈
        Ideal.map (r.appLE ⊤ (U l) (by simp)).hom (Ideal.span (Set.range g)) :=
      Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨j, rfl⟩)
    rw [hspan l, Ideal.mem_span_singleton'] at hmem
    obtain ⟨a, ha⟩ := hmem
    exact ⟨a, ha.symm⟩
  choose t ht using hrat
  have hs5 := fun l => s5 l (U l) (t l) (fun x hx => hx) (ht l) (hnzd l) (hinv l)
  refine ⟨U, t, ?_⟩
  unfold wcBpChartHyp
  exact ⟨hcov, fun l => (hs5 l).1, ht, hnzd, fun l => (hs5 l).2,
    fun l k => s4 l k (U l) (hs5 l).1 (t l k) (ht l k) (hnzd l) (hspan l)⟩

theorem wc_bp_charts_finiteness {X X' : Scheme.{u}} [IsAffine X] {ι : Type} [Finite ι]
    (g : ι → Γ(X, ⊤)) (r : X' ⟶ X) (U : ι → X'.Opens) (t : ∀ l : ι, ι → Γ(X', U l))
    (hCH : wcBpChartHyp r g U t) :
    QuasiCompact r ∧ QuasiSeparated r ∧ LocallyOfFiniteType r :=
by
  obtain ⟨C1, C2, C3, C4, C5, C6⟩ := hCH
  have nzdR : ∀ (T : Scheme.{u}) (W O : T.Opens) (hOW : O ≤ W), IsAffineOpen W →
      ∀ b : Γ(T, W), b ∈ nonZeroDivisors Γ(T, W) →
        T.presheaf.map (homOfLE hOW).op b ∈ nonZeroDivisors Γ(T, O) := by
    intro T W O hOW hW b hb
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    refine TopCat.Presheaf.section_ext T.sheaf _ _ _ (fun t ht => ?_)
    have hst := congrArg (T.presheaf.germ O t ht) hx
    rw [map_mul, map_zero, TopCat.Presheaf.germ_res_apply] at hst
    have hnz' : T.presheaf.germ W t (hOW ht) b ∈ nonZeroDivisors (T.presheaf.stalk t) := by
      letI := TopCat.Presheaf.algebra_section_stalk T.presheaf (⟨t, hOW ht⟩ : W)
      haveI := hW.isLocalization_stalk ⟨t, hOW ht⟩
      have hnz := IsLocalization.map_nonZeroDivisors_le
          (hW.primeIdealOf ⟨t, hOW ht⟩).asIdeal.primeCompl
          (T.presheaf.stalk ((⟨t, hOW ht⟩ : W) : T))
          (Submonoid.mem_map_of_mem
            (algebraMap Γ(T, W) (T.presheaf.stalk ((⟨t, hOW ht⟩ : W) : T))) hb)
      exact hnz
    show T.presheaf.germ O t ht x = T.presheaf.germ O t ht 0
    rw [map_zero]
    exact mem_nonZeroDivisors_iff_right.mp hnz' _ hst

  have hov : ∀ k l, U k ⊓ U l = X'.basicOpen (t k l) := by
    intro k l
    apply le_antisymm
    · have iK : U k ⊓ U l ≤ U k := inf_le_left
      have iL : U k ⊓ U l ≤ U l := inf_le_right
      have eK : ∀ a, (X'.presheaf.map (homOfLE iK).op).hom
          ((r.appLE ⊤ (U k) (by simp)).hom a) = (r.appLE ⊤ (U k ⊓ U l) (by simp)).hom a :=
        fun a => congrArg (fun φ => φ.hom a) (Scheme.Hom.appLE_map r (by simp) (homOfLE iK).op)
      have eL : ∀ a, (X'.presheaf.map (homOfLE iL).op).hom
          ((r.appLE ⊤ (U l) (by simp)).hom a) = (r.appLE ⊤ (U k ⊓ U l) (by simp)).hom a :=
        fun a => congrArg (fun φ => φ.hom a) (Scheme.Hom.appLE_map r (by simp) (homOfLE iL).op)
      have h1 : (r.appLE ⊤ (U k ⊓ U l) (by simp)).hom (g l) =
          (X'.presheaf.map (homOfLE iK).op).hom (t k l) *
            (r.appLE ⊤ (U k ⊓ U l) (by simp)).hom (g k) := by
        have := congrArg (X'.presheaf.map (homOfLE iK).op).hom (C3 k l)
        rwa [map_mul, eK, eK] at this
      have h2 : (r.appLE ⊤ (U k ⊓ U l) (by simp)).hom (g k) =
          (X'.presheaf.map (homOfLE iL).op).hom (t l k) *
            (r.appLE ⊤ (U k ⊓ U l) (by simp)).hom (g l) := by
        have := congrArg (X'.presheaf.map (homOfLE iL).op).hom (C3 l k)
        rwa [map_mul, eL, eL] at this
      have hnzd : (r.appLE ⊤ (U k ⊓ U l) (by simp)).hom (g k) ∈
          nonZeroDivisors Γ(X', U k ⊓ U l) := by
        rw [← eK]
        exact nzdR X' (U k) (U k ⊓ U l) iK (C2 k) _ (C4 k)
      have h3 : (1 - (X'.presheaf.map (homOfLE iL).op).hom (t l k) *
          (X'.presheaf.map (homOfLE iK).op).hom (t k l)) *
            (r.appLE ⊤ (U k ⊓ U l) (by simp)).hom (g k) = 0 := by
        linear_combination h2 + (X'.presheaf.map (homOfLE iL).op).hom (t l k) * h1
      have h4 := (mul_right_mem_nonZeroDivisors_eq_zero_iff hnzd).mp h3
      have hu : IsUnit ((X'.presheaf.map (homOfLE iK).op).hom (t k l)) :=
        isUnit_iff_exists_inv.mpr ⟨(X'.presheaf.map (homOfLE iL).op).hom (t l k),
          by linear_combination (-1 : Γ(X', U k ⊓ U l)) * h4⟩
      have h5 := Scheme.basicOpen_of_isUnit X' hu
      have h6 := Scheme.basicOpen_res X' (t k l) (homOfLE iK).op
      calc U k ⊓ U l = X'.basicOpen ((X'.presheaf.map (homOfLE iK).op).hom (t k l)) := h5.symm
        _ = (U k ⊓ U l) ⊓ X'.basicOpen (t k l) := h6
        _ ≤ X'.basicOpen (t k l) := inf_le_right
    · exact le_inf (Scheme.basicOpen_le X' (t k l)) (C6 k l)

  haveI : CompactSpace X' := by
    rw [← isCompact_univ_iff]
    have hU : (Set.univ : Set X') = ⋃ l, ((U l : X'.Opens) : Set X') := by
      rw [← TopologicalSpace.Opens.coe_iSup, C1, TopologicalSpace.Opens.coe_top]
    rw [hU]
    exact isCompact_iUnion (fun l => (C2 l).isCompact)

  haveI : QuasiSeparatedSpace X' :=
    Scheme.quasiSeparatedSpace_of_isOpenCover U C1 C2 (fun i j => by
      rw [← TopologicalSpace.Opens.coe_inf, hov i j]
      exact ((C2 i).basicOpen (t i j)).isCompact)

  have hlft : LocallyOfFiniteType r := by
    refine HasRingHomProperty.of_iSup_eq_top (P := @LocallyOfFiniteType)
      (fun l => (⟨U l, C2 l⟩ : X'.affineOpens)) C1 ?_
    intro l
    let φ := (r.appLE ⊤ (U l) (by simp)).hom
    change φ.FiniteType
    letI : Algebra Γ(X, ⊤) Γ(X', U l) := φ.toAlgebra
    show Algebra.FiniteType Γ(X, ⊤) Γ(X', U l)
    refine ⟨⟨(Set.finite_range (t l)).toFinset, ?_⟩⟩
    rw [Set.Finite.coe_toFinset, eq_top_iff]
    intro s _
    have hle : Subring.closure (Set.range φ ∪ Set.range (t l)) ≤
        (Algebra.adjoin Γ(X, ⊤) (Set.range (t l))).toSubring := by
      rw [Subring.closure_le]
      rintro x (⟨a, rfl⟩ | ⟨j, rfl⟩)
      · exact Subalgebra.algebraMap_mem _ a
      · exact Algebra.subset_adjoin ⟨j, rfl⟩
    exact hle (C5 l s)
  exact ⟨quasiCompact_of_compactSpace r, QuasiSeparated.of_quasiSeparatedSpace r, hlft⟩

theorem wc_bp_charts_val_exist {X X' : Scheme.{u}} [IsAffine X] {ι : Type} [Finite ι]
    (g : ι → Γ(X, ⊤)) (r : X' ⟶ X) (U : ι → X'.Opens) (t : ∀ l : ι, ι → Γ(X', U l))
    (hCH : wcBpChartHyp r g U t) :
    ValuativeCriterion.Existence r :=
by
  obtain ⟨C1, C2, C3, C4, C5, C6⟩ := hCH

  have s1 : ∀ (R K : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [Field K] [Algebra R K]
      [IsFractionRing R K] (τ : ι → K) (k : ι), τ k ≠ 0 →
      ∃ m : ι, τ m ≠ 0 ∧ ∀ j : ι, ∃ a : R, algebraMap R K a = τ j / τ m := by
    intro R K _ _ _ _ _ _ τ k hk
    have : Nonempty ι := ⟨k⟩
    obtain ⟨m, hm⟩ := Finite.exists_max (fun j => ValuationRing.valuation R K (τ j))
    have hvk : 0 < ValuationRing.valuation R K (τ k) := (Valuation.pos_iff _).mpr hk
    have hvm : 0 < ValuationRing.valuation R K (τ m) := lt_of_lt_of_le hvk (hm k)
    have hτm : τ m ≠ 0 := (Valuation.pos_iff _).mp hvm
    refine ⟨m, hτm, fun j => ?_⟩
    rw [← ValuationRing.mem_integer_iff, Valuation.mem_integer_iff, Valuation.map_div,
      div_le_one₀ hvm]
    exact hm j

  have appLE_top : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (e : (⊤ : A.Opens) ≤ f ⁻¹ᵁ ⊤),
      f.appLE ⊤ ⊤ e = f.appTop := by
    intro A B f e
    exact Scheme.Hom.appLE_eq_app f

  have s3 : ∀ (R K : Type u) [CommRing R] [CommRing K] [Algebra R K]
      (i₁ : Spec (CommRingCat.of K) ⟶ X') (i₂ : Spec (CommRingCat.of R) ⟶ X)
      (hw : i₁ ≫ r = Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ i₂)
      (V : X'.Opens) (e : ⊤ ≤ i₁ ⁻¹ᵁ V) (a : Γ(X, ⊤)),
      (i₁.appLE V ⊤ e ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom
        ((r.appLE ⊤ V (by simp)).hom a) =
      algebraMap R K ((i₂.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of R)).hom).hom a) := by
    intro R K _ _ _ i₁ i₂ hw V e a
    have hle : V ≤ r ⁻¹ᵁ ⊤ := by simp
    have hcomp := Scheme.Hom.appLE_comp_appLE i₁ r ⊤ V ⊤ hle e
    have key : (r.appLE ⊤ V hle ≫ i₁.appLE V ⊤ e) ≫
        (Scheme.ΓSpecIso (CommRingCat.of K)).hom =
        (i₂.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of R)).hom) ≫
          CommRingCat.ofHom (algebraMap R K) := by
      rw [hcomp, appLE_top, hw, Scheme.Hom.comp_appTop]
      simp only [Category.assoc]
      rw [Scheme.ΓSpecIso_naturality]
    have := congrArg (fun f => f.hom a) key
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] using this

  have s4 : ∀ (R K : Type u) [CommRing R] [CommRing K] [Algebra R K],
      Function.Injective (algebraMap R K) → ∀ (V : X'.Opens), IsAffineOpen V →
      ∀ (i₁ : Spec (CommRingCat.of K) ⟶ X') (e : ⊤ ≤ i₁ ⁻¹ᵁ V),
      (∀ s : Γ(X', V), ∃ a : R, algebraMap R K a =
        (i₁.appLE V ⊤ e ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom s) →
      ∃ l : Spec (CommRingCat.of R) ⟶ X', Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ l = i₁ := by
    intro R K _ _ _ hinj V hV i₁ e hrange
    choose φf hφf using hrange
    let φ : Γ(X', V) →+* R :=
      { toFun := φf
        map_one' := hinj (by rw [hφf, map_one, map_one])
        map_mul' := fun x y => hinj (by rw [hφf, map_mul, map_mul, hφf, hφf])
        map_zero' := hinj (by rw [hφf, map_zero, map_zero])
        map_add' := fun x y => hinj (by rw [hφf, map_add, map_add, hφf, hφf]) }
    have hφ : CommRingCat.ofHom φ ≫ CommRingCat.ofHom (algebraMap R K) =
        i₁.appLE V ⊤ e ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).hom := by
      ext x
      exact hφf x
    refine ⟨Spec.map (CommRingCat.ofHom φ) ≫ hV.fromSpec, ?_⟩
    rw [← Category.assoc, ← Spec.map_comp, hφ, Spec.map_comp, Category.assoc,
      IsAffineOpen.SpecMap_appLE_fromSpec i₁ hV (isAffineOpen_top _) e,
      IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Category.assoc, ← Spec.map_comp,
      Iso.inv_hom_id, Spec.map_id, Category.id_comp]

  have s5 : ∀ (R K : Type u) [CommRing R] [CommRing K] [Algebra R K],
      Function.Injective (algebraMap R K) → ∀ (h₁ h₂ : Spec (CommRingCat.of R) ⟶ X),
      Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ h₁ =
        Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ h₂ → h₁ = h₂ := by
    intro R K _ _ _ hinj h₁ h₂ h
    apply ext_of_isAffine
    have key : ∀ i : Spec (CommRingCat.of R) ⟶ X,
        (i.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of R)).hom) ≫
          CommRingCat.ofHom (algebraMap R K) =
        (Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ i).appTop ≫
          (Scheme.ΓSpecIso (CommRingCat.of K)).hom := by
      intro i
      rw [Scheme.Hom.comp_appTop, Category.assoc, Category.assoc, Scheme.ΓSpecIso_naturality]
    have k1 := key h₁
    rw [h, ← key h₂] at k1
    have e : h₁.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of R)).hom =
        h₂.appTop ≫ (Scheme.ΓSpecIso (CommRingCat.of R)).hom := by
      ext a
      apply hinj
      have := congrArg (fun f => f.hom a) k1
      simpa only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] using this
    exact (cancel_mono _).mp e

  have s2 : ∀ {T : Scheme.{u}} (h : T ⟶ X') (k m : ι) (ek : ⊤ ≤ h ⁻¹ᵁ U k),
      IsUnit ((h.appLE (U k) ⊤ ek).hom (t k m)) →
      ∃ em : ⊤ ≤ h ⁻¹ᵁ U m, ∀ j : ι,
        (h.appLE (U m) ⊤ em).hom (t m j) * (h.appLE (U k) ⊤ ek).hom (t k m) =
          (h.appLE (U k) ⊤ ek).hom (t k j) := by
    intro T h k m ek hu
    have hWk : X'.basicOpen (t k m) ≤ U k := X'.basicOpen_le _
    have hWm : X'.basicOpen (t k m) ≤ U m := C6 k m
    have eW : ⊤ ≤ h ⁻¹ᵁ X'.basicOpen (t k m) := by
      have := Scheme.basicOpen_appLE h ⊤ (U k) ek (t k m)
      rw [Scheme.basicOpen_of_isUnit _ hu, top_inf_eq] at this
      exact this.le
    have em : ⊤ ≤ h ⁻¹ᵁ U m := eW.trans (h.preimage_mono hWm)
    refine ⟨em, fun j => ?_⟩
    have hρk : r.appLE ⊤ (U k) (by simp) ≫ X'.presheaf.map (homOfLE hWk).op =
        r.appLE ⊤ (X'.basicOpen (t k m)) (by simp) := Scheme.Hom.appLE_map _ _ _
    have hρm : r.appLE ⊤ (U m) (by simp) ≫ X'.presheaf.map (homOfLE hWm).op =
        r.appLE ⊤ (X'.basicOpen (t k m)) (by simp) := Scheme.Hom.appLE_map _ _ _
    have hhk : X'.presheaf.map (homOfLE hWk).op ≫ h.appLE (X'.basicOpen (t k m)) ⊤ eW =
        h.appLE (U k) ⊤ ek := Scheme.Hom.map_appLE _ _ _
    have hhm : X'.presheaf.map (homOfLE hWm).op ≫ h.appLE (X'.basicOpen (t k m)) ⊤ eW =
        h.appLE (U m) ⊤ em := Scheme.Hom.map_appLE _ _ _
    haveI := (C2 k).isLocalization_basicOpen (t k m)
    have hG : (X'.presheaf.map (homOfLE hWk).op).hom ((r.appLE ⊤ (U k) (by simp)).hom (g k)) ∈
        nonZeroDivisors Γ(X', X'.basicOpen (t k m)) :=
      IsLocalization.map_nonZeroDivisors_le (Submonoid.powers (t k m))
        Γ(X', X'.basicOpen (t k m)) (Submonoid.mem_map.mpr ⟨_, C4 k, rfl⟩)
    have q : ∀ x, (X'.presheaf.map (homOfLE hWk).op).hom ((r.appLE ⊤ (U k) (by simp)).hom x) =
        (X'.presheaf.map (homOfLE hWm).op).hom ((r.appLE ⊤ (U m) (by simp)).hom x) := by
      intro x
      rw [← RingHom.comp_apply, ← RingHom.comp_apply, ← CommRingCat.hom_comp,
        ← CommRingCat.hom_comp, hρk, hρm]
    have hcoc : (X'.presheaf.map (homOfLE hWk).op).hom (t k j) =
        (X'.presheaf.map (homOfLE hWm).op).hom (t m j) *
          (X'.presheaf.map (homOfLE hWk).op).hom (t k m) := by
      rw [← mul_cancel_right_mem_nonZeroDivisors hG]
      have e1 := congrArg (X'.presheaf.map (homOfLE hWk).op).hom (C3 k j)
      have e2 := congrArg (X'.presheaf.map (homOfLE hWk).op).hom (C3 k m)
      have e3 := congrArg (X'.presheaf.map (homOfLE hWm).op).hom (C3 m j)
      rw [map_mul] at e1 e2 e3
      rw [mul_assoc, ← e2, ← e1, q, q, e3]
    rw [← hhk, ← hhm]
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    rw [hcoc, map_mul]

  have main : ∀ (R K : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [Field K]
      [Algebra R K] [IsFractionRing R K] (i₁ : Spec (CommRingCat.of K) ⟶ X')
      (i₂ : Spec (CommRingCat.of R) ⟶ X),
      i₁ ≫ r = Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ i₂ →
      ∃ l : Spec (CommRingCat.of R) ⟶ X',
        Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ l = i₁ ∧ l ≫ r = i₂ := by
    intro R K _ _ _ _ _ _ i₁ i₂ hw
    have hinj : Function.Injective (algebraMap R K) := IsFractionRing.injective R K
    obtain ⟨x⟩ : Nonempty (Spec (CommRingCat.of K)) := ⟨default⟩
    have hx : i₁.base x ∈ ⨆ l, U l := by rw [C1]; trivial
    obtain ⟨k, hk⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    have ek : ⊤ ≤ i₁ ⁻¹ᵁ U k := by
      intro y _
      rw [Subsingleton.elim y x]
      exact hk
    obtain ⟨τ, hτ⟩ : ∃ τ : ι → K, ∀ j, τ j =
        (Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom ((i₁.appLE (U k) ⊤ ek).hom (t k j)) :=
      ⟨fun j => (Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom ((i₁.appLE (U k) ⊤ ek).hom (t k j)),
        fun j => rfl⟩
    have htkk : t k k = 1 :=
      (mul_cancel_right_mem_nonZeroDivisors (C4 k)).mp (by rw [one_mul]; exact (C3 k k).symm)
    have hτk : τ k ≠ 0 := by
      rw [hτ, htkk, map_one, map_one]
      exact one_ne_zero
    obtain ⟨m, hτm, ha⟩ := s1 R K τ k hτk
    have hu : IsUnit ((i₁.appLE (U k) ⊤ ek).hom (t k m)) := by
      have h1 : IsUnit (τ m) := isUnit_iff_ne_zero.mpr hτm
      have h2 := h1.map (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom
      have h3 : (Scheme.ΓSpecIso (CommRingCat.of K)).inv.hom (τ m) =
          (i₁.appLE (U k) ⊤ ek).hom (t k m) := by
        rw [hτ, ← RingHom.comp_apply, ← CommRingCat.hom_comp, Iso.hom_inv_id]
        rfl
      rwa [h3] at h2
    obtain ⟨em, hcoc⟩ := s2 i₁ k m ek hu
    have hval : ∀ j, algebraMap R K
        (Classical.choose (ha j)) = (Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom
          ((i₁.appLE (U m) ⊤ em).hom (t m j)) := by
      intro j
      rw [Classical.choose_spec (ha j)]
      symm
      apply eq_div_of_mul_eq hτm
      have := congrArg (Scheme.ΓSpecIso (CommRingCat.of K)).hom.hom (hcoc j)
      rw [map_mul] at this
      rw [hτ, hτ]
      exact this
    have hrange : ∀ s : Γ(X', U m), ∃ a : R, algebraMap R K a =
        (i₁.appLE (U m) ⊤ em ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom s := by
      have hsub : Subring.closure (Set.range (r.appLE ⊤ (U m) (by simp)).hom ∪ Set.range (t m)) ≤
          Subring.comap (i₁.appLE (U m) ⊤ em ≫ (Scheme.ΓSpecIso (CommRingCat.of K)).hom).hom
            (algebraMap R K).range := by
        rw [Subring.closure_le]
        rintro s (⟨a', rfl⟩ | ⟨j, rfl⟩)
        · exact Subring.mem_comap.mpr
            (RingHom.mem_range.mpr ⟨_, (s3 R K i₁ i₂ hw (U m) em a').symm⟩)
        · refine Subring.mem_comap.mpr (RingHom.mem_range.mpr ⟨Classical.choose (ha j), ?_⟩)
          rw [hval j, CommRingCat.hom_comp, RingHom.comp_apply]
      intro s
      exact RingHom.mem_range.mp (Subring.mem_comap.mp (hsub (C5 m s)))
    obtain ⟨l, hl⟩ := s4 R K hinj (U m) (C2 m) i₁ em hrange
    have hlr : l ≫ r = i₂ := s5 R K hinj (l ≫ r) i₂ (by rw [← Category.assoc, hl, hw])
    exact ⟨l, hl, hlr⟩
  intro S
  obtain ⟨l, hl, hlr⟩ := main S.R S.K S.i₁ S.i₂ S.commSq.w
  exact CommSq.HasLift.mk' ⟨l, hl, hlr⟩

theorem wc_bp_charts_val_unique {X X' : Scheme.{u}} [IsAffine X] {ι : Type} [Finite ι]
    (g : ι → Γ(X, ⊤)) (r : X' ⟶ X) (U : ι → X'.Opens) (t : ∀ l : ι, ι → Γ(X', U l))
    (hCH : wcBpChartHyp r g U t) :
    ValuativeCriterion.Uniqueness r :=
by
  classical
  obtain ⟨hC1, hC2, hC3, hC4, -, hC6⟩ := hCH

  have nzd : ∀ (T : Scheme.{u}) (W O : T.Opens) (hOW : O ≤ W), IsAffineOpen W →
      ∀ b : Γ(T, W), b ∈ nonZeroDivisors Γ(T, W) →
        T.presheaf.map (homOfLE hOW).op b ∈ nonZeroDivisors Γ(T, O) := by
    intro T W O hOW hW b hb
    rw [mem_nonZeroDivisors_iff_right]
    intro x hx
    refine TopCat.Presheaf.section_ext T.sheaf _ _ _ (fun t ht => ?_)
    have hst := congrArg (T.presheaf.germ O t ht) hx
    rw [map_mul, map_zero, TopCat.Presheaf.germ_res_apply] at hst
    have hnz' : T.presheaf.germ W t (hOW ht) b ∈ nonZeroDivisors (T.presheaf.stalk t) := by
      letI := TopCat.Presheaf.algebra_section_stalk T.presheaf (⟨t, hOW ht⟩ : W)
      haveI := hW.isLocalization_stalk ⟨t, hOW ht⟩
      have hnz := IsLocalization.map_nonZeroDivisors_le
          (hW.primeIdealOf ⟨t, hOW ht⟩).asIdeal.primeCompl
          (T.presheaf.stalk ((⟨t, hOW ht⟩ : W) : T))
          (Submonoid.mem_map_of_mem
            (algebraMap Γ(T, W) (T.presheaf.stalk ((⟨t, hOW ht⟩ : W) : T))) hb)
      exact hnz
    show T.presheaf.germ O t ht x = T.presheaf.germ O t ht 0
    rw [map_zero]
    exact mem_nonZeroDivisors_iff_right.mp hnz' _ hst

  have s2 : ∀ m p : ι,
      (X'.presheaf.map (homOfLE (inf_le_left : U m ⊓ U p ≤ U m)).op).hom (t m p) *
        (X'.presheaf.map (homOfLE (inf_le_right : U m ⊓ U p ≤ U p)).op).hom (t p m) = 1 := by
    intro m p
    have hσm : ∀ a, (X'.presheaf.map (homOfLE (inf_le_left : U m ⊓ U p ≤ U m)).op).hom
        ((r.appLE ⊤ (U m) (by simp)).hom a) = (r.appLE ⊤ (U m ⊓ U p) (by simp)).hom a := by
      intro a
      rw [← Scheme.Hom.appLE_map r _ (homOfLE (inf_le_left : U m ⊓ U p ≤ U m)).op]
      rfl
    have hσp : ∀ a, (X'.presheaf.map (homOfLE (inf_le_right : U m ⊓ U p ≤ U p)).op).hom
        ((r.appLE ⊤ (U p) (by simp)).hom a) = (r.appLE ⊤ (U m ⊓ U p) (by simp)).hom a := by
      intro a
      rw [← Scheme.Hom.appLE_map r _ (homOfLE (inf_le_right : U m ⊓ U p ≤ U p)).op]
      rfl
    have E1 := congrArg (X'.presheaf.map (homOfLE (inf_le_left : U m ⊓ U p ≤ U m)).op).hom
      (hC3 m p)
    rw [map_mul, hσm, hσm] at E1
    have E2 := congrArg (X'.presheaf.map (homOfLE (inf_le_right : U m ⊓ U p ≤ U p)).op).hom
      (hC3 p m)
    rw [map_mul, hσp, hσp] at E2
    have hN : (r.appLE ⊤ (U m ⊓ U p) (by simp)).hom (g m) ∈ nonZeroDivisors Γ(X', U m ⊓ U p) := by
      rw [← hσm]
      exact nzd X' (U m) (U m ⊓ U p) inf_le_left (hC2 m) _ (hC4 m)
    set α := (X'.presheaf.map (homOfLE (inf_le_left : U m ⊓ U p ≤ U m)).op).hom (t m p)
    set β := (X'.presheaf.map (homOfLE (inf_le_right : U m ⊓ U p ≤ U p)).op).hom (t p m)
    have key : (r.appLE ⊤ (U m ⊓ U p) (by simp)).hom (g m) * (α * β - 1) = 0 := by
      linear_combination (-β) * E1 - E2
    have key' : (α * β - 1) * (r.appLE ⊤ (U m ⊓ U p) (by simp)).hom (g m) = 0 := by
      rw [mul_comm]; exact key
    have h0 : α * β - 1 = 0 := mem_nonZeroDivisors_iff_right.mp hN _ key'
    exact sub_eq_zero.mp h0

  have s3 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (f : Spec (.of R) ⟶ X'),
      ∃ m, f ⁻¹ᵁ U m = ⊤ := by
    intro R _ _ f
    have hc : f (IsLocalRing.closedPoint R) ∈ (⨆ l, U l) := by rw [hC1]; trivial
    obtain ⟨m, hm⟩ := TopologicalSpace.Opens.mem_iSup.mp hc
    refine ⟨m, eq_top_iff.mpr fun x _ => ?_⟩
    rw [Scheme.Hom.mem_preimage]
    exact ((IsLocalRing.specializes_closedPoint (R := R) x).map f.continuous).mem_open
      (U m).isOpen hm

  have s6 : ∀ (R K : Type u) [CommRing R] [CommRing K] (φ : R →+* K), Function.Injective φ →
      Function.Injective (Spec.map (CommRingCat.ofHom φ)).appTop.hom := by
    intro R K _ _ φ hφ x y hxy
    have nat := Scheme.ΓSpecIso_naturality (CommRingCat.ofHom φ)
    have h1 := congrArg (fun F => F.hom x) nat
    have h2 := congrArg (fun F => F.hom y) nat
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h1 h2
    rw [hxy] at h1
    have h3 := hφ (h1.symm.trans h2)
    have h4 := congrArg (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom h3
    simpa using h4

  have s4 : ∀ (V : X'.Opens), IsAffineOpen V → ∀ (R K : Type u) [CommRing R] [CommRing K]
      (φ : R →+* K), Function.Injective (Spec.map (CommRingCat.ofHom φ)).appTop.hom →
      ∀ (f₁ f₂ : Spec (.of R) ⟶ X'), f₁ ⁻¹ᵁ V = ⊤ → f₂ ⁻¹ᵁ V = ⊤ →
        Spec.map (CommRingCat.ofHom φ) ≫ f₁ = Spec.map (CommRingCat.ofHom φ) ≫ f₂ →
        f₁ = f₂ := by
    intro V hV R K _ _ φ hα f₁ f₂ h₁ h₂ h
    have r₁ : Set.range f₁ ⊆ Set.range V.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      have : x ∈ f₁ ⁻¹ᵁ V := by rw [h₁]; trivial
      exact (Scheme.Hom.mem_preimage f₁).mp this
    have r₂ : Set.range f₂ ⊆ Set.range V.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨x, rfl⟩
      have : x ∈ f₂ ⁻¹ᵁ V := by rw [h₂]; trivial
      exact (Scheme.Hom.mem_preimage f₂).mp this
    haveI : IsAffine V := hV
    have e₁ := IsOpenImmersion.lift_fac V.ι f₁ r₁
    have e₂ := IsOpenImmersion.lift_fac V.ι f₂ r₂
    have hK : Spec.map (CommRingCat.ofHom φ) ≫ IsOpenImmersion.lift V.ι f₁ r₁ =
        Spec.map (CommRingCat.ofHom φ) ≫ IsOpenImmersion.lift V.ι f₂ r₂ := by
      rw [← cancel_mono V.ι, Category.assoc, Category.assoc, e₁, e₂, h]
    have hT : (IsOpenImmersion.lift V.ι f₁ r₁).appTop =
        (IsOpenImmersion.lift V.ι f₂ r₂).appTop := by
      ext s
      apply hα
      have := congrArg (fun k => k.appTop.hom s) hK
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at this
      exact this
    rw [← e₁, ← e₂, ext_of_isAffine hT]

  have s5 : ∀ (Um Up : X'.Opens) (a : Γ(X', Um)) (b : Γ(X', Up)),
      (X'.presheaf.map (homOfLE (inf_le_left : Um ⊓ Up ≤ Um)).op).hom a *
        (X'.presheaf.map (homOfLE (inf_le_right : Um ⊓ Up ≤ Up)).op).hom b = 1 →
      X'.basicOpen b ≤ Um →
      ∀ (R K : Type u) [CommRing R] [CommRing K] (φ : R →+* K),
        Function.Injective (Spec.map (CommRingCat.ofHom φ)).appTop.hom →
      ∀ (l₁ l₂ : Spec (.of R) ⟶ X'),
        Spec.map (CommRingCat.ofHom φ) ≫ l₁ = Spec.map (CommRingCat.ofHom φ) ≫ l₂ →
        l₁ ⁻¹ᵁ Um = ⊤ → l₂ ⁻¹ᵁ Up = ⊤ → l₂ ⁻¹ᵁ Um = ⊤ := by
    intro Um Up a b hab hb R K _ _ φ hα l₁ l₂ h h₁ h₂
    have e₁ : (⊤ : (Spec (.of R)).Opens) ≤ l₁ ⁻¹ᵁ Um := h₁.ge
    have e₂ : (⊤ : (Spec (.of R)).Opens) ≤ l₂ ⁻¹ᵁ Up := h₂.ge
    have hm1 : ∀ y, l₁ y ∈ Um := fun y => by
      have : y ∈ l₁ ⁻¹ᵁ Um := by rw [h₁]; trivial
      exact (Scheme.Hom.mem_preimage l₁).mp this
    have hp2 : ∀ y, l₂ y ∈ Up := fun y => by
      have : y ∈ l₂ ⁻¹ᵁ Up := by rw [h₂]; trivial
      exact (Scheme.Hom.mem_preimage l₂).mp this
    obtain ⟨i, hi1, hi2⟩ : ∃ i, Spec.map (CommRingCat.ofHom φ) ≫ l₁ = i ∧
        Spec.map (CommRingCat.ofHom φ) ≫ l₂ = i := ⟨_, rfl, h.symm⟩
    set ψ := Spec.map (CommRingCat.ofHom φ) with hψ
    have hV0W : ψ ⁻¹ᵁ (⊤ : (Spec (.of R)).Opens) ≤ i ⁻¹ᵁ (Um ⊓ Up) := by
      intro x _
      rw [Scheme.Hom.mem_preimage]
      refine ⟨?_, ?_⟩
      · rw [← hi1]; exact hm1 (ψ x)
      · rw [← hi2]; exact hp2 (ψ x)
    have hα' : Function.Injective (ψ.appLE ⊤ (ψ ⁻¹ᵁ ⊤) le_rfl).hom := by
      rw [← Scheme.Hom.app_eq_appLE]; exact hα
    have M1 : l₁.appLE Um ⊤ e₁ ≫ ψ.appLE ⊤ (ψ ⁻¹ᵁ ⊤) le_rfl =
        X'.presheaf.map (homOfLE (inf_le_left : Um ⊓ Up ≤ Um)).op ≫
          i.appLE (Um ⊓ Up) (ψ ⁻¹ᵁ ⊤) hV0W := by
      rw [Scheme.Hom.appLE_comp_appLE, Scheme.Hom.map_appLE]
      subst hi1
      rfl
    have M2 : l₂.appLE Up ⊤ e₂ ≫ ψ.appLE ⊤ (ψ ⁻¹ᵁ ⊤) le_rfl =
        X'.presheaf.map (homOfLE (inf_le_right : Um ⊓ Up ≤ Up)).op ≫
          i.appLE (Um ⊓ Up) (ψ ⁻¹ᵁ ⊤) hV0W := by
      rw [Scheme.Hom.appLE_comp_appLE, Scheme.Hom.map_appLE]
      subst hi2
      rfl
    have hprod : (ψ.appLE ⊤ (ψ ⁻¹ᵁ ⊤) le_rfl).hom
        ((l₁.appLE Um ⊤ e₁).hom a * (l₂.appLE Up ⊤ e₂).hom b) =
        (ψ.appLE ⊤ (ψ ⁻¹ᵁ ⊤) le_rfl).hom 1 := by
      rw [map_mul, map_one]
      have q1 := congrArg (fun F => F.hom a) M1
      have q2 := congrArg (fun F => F.hom b) M2
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at q1 q2
      rw [q1, q2, ← map_mul, hab, map_one]
    have hunit := hα' hprod
    have hU : IsUnit ((l₂.appLE Up ⊤ e₂).hom b) :=
      IsUnit.of_mul_eq_one ((l₁.appLE Um ⊤ e₁).hom a) (by rw [mul_comm]; exact hunit)
    have hbo := Scheme.basicOpen_appLE l₂ ⊤ Up e₂ b
    rw [Scheme.basicOpen_of_isUnit _ hU] at hbo
    refine eq_top_iff.mpr fun x _ => ?_
    have hx : x ∈ (⊤ : (Spec (.of R)).Opens) ⊓ l₂ ⁻¹ᵁ X'.basicOpen b := by
      rw [← hbo]; trivial
    rw [Scheme.Hom.mem_preimage]
    exact hb ((Scheme.Hom.mem_preimage l₂).mp hx.2)

  unfold ValuativeCriterion.Uniqueness
  intro S
  refine ⟨fun x y => CommSq.LiftStruct.ext ?_⟩
  have hφ : Function.Injective (algebraMap S.R S.K) := IsFractionRing.injective S.R S.K
  have hα := s6 S.R S.K (algebraMap S.R S.K) hφ
  have h : Spec.map (CommRingCat.ofHom (algebraMap S.R S.K)) ≫ x.l =
      Spec.map (CommRingCat.ofHom (algebraMap S.R S.K)) ≫ y.l :=
    x.fac_left.trans y.fac_left.symm
  obtain ⟨m, hm⟩ := s3 S.R x.l
  obtain ⟨p, hp⟩ := s3 S.R y.l
  have hym := s5 (U m) (U p) (t m p) (t p m) (s2 m p) (hC6 p m) S.R S.K _ hα x.l y.l h hm hp
  exact s4 (U m) (hC2 m) S.R S.K _ hα x.l y.l hm hym h

theorem wc_qmbt_nt_beta_proper {A : Type u} [CommRing A]
    {n : ℕ} {π : A} {c : Matrix (Fin n) (Fin n) A}
    {B₀ : Type u} [CommRing B₀]
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    {A' : Type u} [CommRing A'] {ιA : A →+* A'} {π' : A'}
    (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {Xm : Scheme.{u}}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl) :
    IsProper (bl ≫ Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) :=
by
  classical

  have hfin : ιA.Finite := by
    letI := ιA.toAlgebra
    show Module.Finite A A'
    refine ⟨⟨{1, π'}, ?_⟩⟩
    rw [eq_top_iff]
    intro a' _
    obtain ⟨x, y, rfl⟩ := hgen a'
    rw [Finset.coe_insert, Finset.coe_singleton, Submodule.mem_span_pair]
    exact ⟨x, y, by simp [Algebra.smul_def, RingHom.algebraMap_toAlgebra]⟩
  haveI : IsFinite (Spec.map (CommRingCat.ofHom ιA)) := (IsFinite.SpecMap_iff _).mpr hfin
  haveI : IsProper (Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) :=
    MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback _ _).flip
      inferInstance

  haveI : IsAffine (Limits.pullback (a₀ ≫ wcQuadModelStr A n π c)
      (Spec.map (CommRingCat.ofHom ιA))) :=
    Scheme.Pullback.isAffine_of_isAffine_isAffine_isAffine _ _

  obtain ⟨U, t, hCH⟩ := wc_bp_blowup_charts _ bl hbl
  obtain ⟨h1, h2, h3⟩ := wc_bp_charts_finiteness _ bl U t hCH
  have hV : ValuativeCriterion bl := by
    rw [ValuativeCriterion.eq]
    exact ⟨wc_bp_charts_val_exist _ bl U t hCH, wc_bp_charts_val_unique _ bl U t hCH⟩
  haveI : IsProper bl := IsProper.of_valuativeCriterion bl hV
  infer_instance

theorem wc_ntc_insep_geom {L : Type u} [Field L] [IsSepClosed L] {L' : Type u} [Field L']
    {ιL : L →+* L'} (hLalg : letI := ιL.toAlgebra; Algebra.IsAlgebraic L L')
    {XE XE' : Scheme.{u}} {q : XE ⟶ Spec (.of L)} {q' : XE' ⟶ Spec (.of L')} {βE : XE' ⟶ XE}
    (hβq : IsPullback βE q' q (Spec.map (CommRingCat.ofHom ιL))) :
    ∀ {T : Scheme.{u}} (t : T ⟶ XE),
      IsIntegralHom (Limits.pullback.fst t βE) ∧ IsHomeomorph ⇑(Limits.pullback.fst t βE) :=
by
  intro T t
  letI := ιL.toAlgebra
  have hpi : IsPurelyInseparable L L' :=
    Algebra.IsAlgebraic.isPurelyInseparable_of_isSepClosed
  have hint : IsIntegralHom (Spec.map (CommRingCat.ofHom ιL)) := by
    rw [IsIntegralHom.SpecMap_iff, CommRingCat.hom_ofHom]
    have : Algebra.IsIntegral L L' := Algebra.IsAlgebraic.isIntegral
    exact algebraMap_isIntegral_iff.mpr this
  have hsurj : Surjective (Spec.map (CommRingCat.ofHom ιL)) :=
    ⟨fun y => ⟨default, Subsingleton.elim _ _⟩⟩
  have hui : UniversallyInjective (Spec.map (CommRingCat.ofHom ιL)) := by
    rw [UniversallyInjective.iff_diagonal]
    have hsub : Subsingleton (PrimeSpectrum (TensorProduct L L' L')) :=
      (PrimeSpectrum.isHomeomorph_comap_of_isPurelyInseparable L L' L').injective.subsingleton
    have e := Scheme.homeoOfIso (pullbackSpecIso L L' L')
    have hsub2 : Subsingleton ↥(Limits.pullback (Spec.map (CommRingCat.ofHom ιL))
        (Spec.map (CommRingCat.ofHom ιL))) :=
      @Equiv.subsingleton _ _ e.toEquiv hsub
    exact ⟨fun y => ⟨default, @Subsingleton.elim _ hsub2 _ _⟩⟩
  haveI : IsIntegralHom βE := MorphismProperty.of_isPullback (P := @IsIntegralHom) hβq.flip hint
  haveI : UniversallyInjective βE :=
    MorphismProperty.of_isPullback (P := @UniversallyInjective) hβq.flip hui
  haveI : Surjective βE := MorphismProperty.of_isPullback (P := @Surjective) hβq.flip hsurj
  have h1 : IsIntegralHom (Limits.pullback.fst t βE) :=
    MorphismProperty.of_isPullback (P := @IsIntegralHom)
      (IsPullback.of_hasPullback t βE).flip inferInstance
  haveI := h1
  haveI : UniversallyInjective (Limits.pullback.fst t βE) :=
    MorphismProperty.of_isPullback (P := @UniversallyInjective)
      (IsPullback.of_hasPullback t βE).flip inferInstance
  haveI : Surjective (Limits.pullback.fst t βE) :=
    MorphismProperty.of_isPullback (P := @Surjective)
      (IsPullback.of_hasPullback t βE).flip inferInstance
  refine ⟨h1, isHomeomorph_iff_continuous_isClosedMap_bijective.mpr
    ⟨Scheme.Hom.continuous _, Scheme.Hom.isClosedMap _,
      Scheme.Hom.injective _, Scheme.Hom.surjective _⟩⟩

theorem wc_ntc_wcontr_integral_bij {Δ Y : Scheme.{u}} (q : Y ⟶ Δ) [IsIntegralHom q]
    (hq : Function.Bijective ⇑q) (hΔ : IsAffine Δ) (hw : wcNtcWConds Δ) :
    IsAffine Y ∧ wcNtcWConds Y :=
by
  classical


  refine (fun (IOSH : ∀ (B C : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)] [CommRing C] [IsLocalRing C] [Algebra B C],
      Algebra.IsIntegral B C → HenselianLocalRing C ∧ IsSepClosed (IsLocalRing.ResidueField C)) =>
    ?_) ?_
  haveI : IsAffine Δ := hΔ
  haveI hYa : IsAffine Y := isAffine_of_isAffineHom q
  obtain ⟨hW1, hW2, hW3, hW4⟩ := hw

  have T₁ : ∀ (R S : Type u) [CommRing R] [CommRing S], (R ≃+* S) → HenselianLocalRing R →
      HenselianLocalRing S := by
    intro R S _ _ e hR
    haveI : IsLocalRing S := e.isLocalRing
    have hmem : ∀ {A B : Type u} [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
        (φ : A ≃+* B) (x : A),
        φ x ∈ IsLocalRing.maximalIdeal B ↔ x ∈ IsLocalRing.maximalIdeal A := by
      intro A B _ _ _ _ φ x
      rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
        mem_nonunits_iff, MulEquiv.isUnit_map]
    have hev : ∀ (p : Polynomial S) (a : S),
        (p.map (e.symm : S →+* R)).eval (e.symm a) = e.symm (p.eval a) := by
      intro p a
      rw [Polynomial.eval_map]
      exact Polynomial.eval₂_at_apply (e.symm : S →+* R) a
    have hround : ∀ p : Polynomial S, (p.map (e.symm : S →+* R)).map (e : R →+* S) = p := by
      intro p
      rw [Polynomial.map_map]
      have hc : (e : R →+* S).comp (e.symm : S →+* R) = RingHom.id S := by
        ext x; simp
      rw [hc, Polynomial.map_id]
    refine { toIsLocalRing := this, is_henselian := ?_ }
    intro f hf a₀ h₁ h₂
    have hgm : (f.map (e.symm : S →+* R)).Monic := hf.map _
    have hb₁ : (f.map (e.symm : S →+* R)).eval (e.symm a₀) ∈ IsLocalRing.maximalIdeal R := by
      rw [hev]
      exact (hmem e.symm _).mpr h₁
    have hb₂ : IsUnit ((Polynomial.derivative (f.map (e.symm : S →+* R))).eval (e.symm a₀)) := by
      rw [Polynomial.derivative_map, hev, MulEquiv.isUnit_map]
      exact h₂
    obtain ⟨b, hbroot, hbclose⟩ := hR.is_henselian _ hgm (e.symm a₀) hb₁ hb₂
    refine ⟨e b, ?_, ?_⟩
    · have h3 : (Polynomial.map (e : R →+* S) (f.map (e.symm : S →+* R))).eval (e b)
          = e ((f.map (e.symm : S →+* R)).eval b) := by
        rw [Polynomial.eval_map]
        exact Polynomial.eval₂_at_apply (e : R →+* S) b
      rw [hround] at h3
      show f.eval (e b) = 0
      rw [h3, hbroot.eq_zero, map_zero]
    · have h4 : e b - a₀ = e (b - e.symm a₀) := by
        rw [map_sub, RingEquiv.apply_symm_apply]
      rw [h4]
      exact (hmem e _).mpr hbclose
  have T₂ : ∀ (K L : Type u) [Field K] [Field L], (K ≃+* L) → IsSepClosed K → IsSepClosed L := by
    intro K L _ _ e hK
    haveI := hK
    apply IsSepClosed.of_exists_root
    intro p _ hirr hsep
    obtain ⟨y, hy⟩ := IsSepClosed.exists_eval₂_eq_zero_of_injective (e.symm : L →+* K)
      e.symm.injective p (Polynomial.degree_pos_of_irreducible hirr).ne' hsep
    refine ⟨e y, ?_⟩
    have h5 := Polynomial.hom_eval₂ p (e.symm : L →+* K) (e : K →+* L) y
    have hc : (e : K →+* L).comp (e.symm : L →+* K) = RingHom.id L := by
      ext x; simp
    rw [hy, map_zero, hc, Polynomial.eval₂_id] at h5
    exact h5.symm

  have SI : ∀ (Z : Scheme.{u}), IsAffine Z →
      ((∀ x : Z, IsClosed ({x} : Set Z) →
          HenselianLocalRing (Z.presheaf.stalk x) ∧ IsSepClosed (Z.residueField x)) ↔
        (∀ (m : Ideal Γ(Z, ⊤)) [m.IsMaximal], HenselianLocalRing (Localization.AtPrime m) ∧
          IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime m)))) := by
    intro Z hZ
    haveI : IsAffine Z := hZ
    constructor
    · intro hL m hm
      let p : PrimeSpectrum Γ(Z, ⊤) := ⟨m, hm.isPrime⟩
      have hp : IsClosed ({p} : Set (PrimeSpectrum Γ(Z, ⊤))) :=
        (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr hm
      have hcl : IsClosed ({Z.isoSpec.inv p} : Set Z) := by
        have := (Scheme.homeoOfIso Z.isoSpec.symm).isClosedMap ({p} : Set (Spec Γ(Z, ⊤))) hp
        convert this using 1
        exact (Set.image_singleton (f := (Scheme.homeoOfIso Z.isoSpec.symm)) (a := p)).symm
      let e : Z.presheaf.stalk (Z.isoSpec.inv p) ≃+* Localization.AtPrime p.asIdeal :=
        (asIso (Scheme.Hom.stalkMap Z.isoSpec.inv (show (Spec Γ(Z, ⊤) : Scheme.{u}) from p)) ≪≫
          Spec.stalkIso Γ(Z, ⊤) p).commRingCatIsoToRingEquiv
      obtain ⟨h1, h2⟩ := hL _ hcl
      exact ⟨T₁ _ _ e h1, T₂ _ _ (IsLocalRing.ResidueField.mapEquiv e) h2⟩
    · intro hR x hx
      have hy0 : IsClosed ({Scheme.homeoOfIso Z.isoSpec x} : Set (Spec Γ(Z, ⊤))) :=
        (Set.image_singleton (f := Scheme.homeoOfIso Z.isoSpec) (a := x)) ▸
          (Scheme.homeoOfIso Z.isoSpec).isClosedMap {x} hx
      have hy : IsClosed ({Z.isoSpec.hom x} : Set (PrimeSpectrum Γ(Z, ⊤))) := hy0
      have hmax : (Z.isoSpec.hom x).asIdeal.IsMaximal :=
        (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hy
      have hRy := @hR (Z.isoSpec.hom x).asIdeal hmax
      let e : Localization.AtPrime (Z.isoSpec.hom x).asIdeal ≃+* Z.presheaf.stalk x :=
        ((Spec.stalkIso Γ(Z, ⊤) (Z.isoSpec.hom x)).symm ≪≫
          asIso (Scheme.Hom.stalkMap Z.isoSpec.hom x)).commRingCatIsoToRingEquiv
      exact ⟨T₁ _ _ e hRy.1, T₂ _ _ (IsLocalRing.ResidueField.mapEquiv e) hRy.2⟩

  have HW : ∀ (X Y : Type u) [TopologicalSpace X] [TopologicalSpace Y] (_h : X ≃ₜ Y),
      IsClosed {x : X | IsClosed ({x} : Set X)} →
      (∀ x : X, ∃! y : X, IsClosed ({y} : Set X) ∧ x ⤳ y) →
      ExtremallyDisconnected {x : X | IsClosed ({x} : Set X)} →
      IsClosed {x : Y | IsClosed ({x} : Set Y)} ∧
        (∀ x : Y, ∃! y : Y, IsClosed ({y} : Set Y) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : Y | IsClosed ({x} : Set Y)} := by
    intro X Y _ _ h ha hb hc
    have K : ∀ x : X, IsClosed ({h x} : Set Y) ↔ IsClosed ({x} : Set X) := by
      intro x
      rw [← Set.image_singleton]
      exact h.isClosed_image
    have K' : ∀ y : Y, IsClosed ({y} : Set Y) ↔ IsClosed ({h.symm y} : Set X) := by
      intro y
      have := K (h.symm y)
      rwa [Homeomorph.apply_symm_apply] at this
    refine ⟨?_, ?_, ?_⟩
    · have hpre : (⇑h ⁻¹' {x : Y | IsClosed ({x} : Set Y)}) = {x : X | IsClosed ({x} : Set X)} := by
        ext x
        simp only [Set.mem_preimage, Set.mem_setOf_eq]
        exact K x
      rw [← h.isClosed_preimage, hpre]
      exact ha
    · intro y
      obtain ⟨z, ⟨hzcl, hxz⟩, hzu⟩ := hb (h.symm y)
      refine ⟨h z, ⟨(K z).mpr hzcl, ?_⟩, ?_⟩
      · have := hxz.map h.continuous
        rwa [Homeomorph.apply_symm_apply] at this
      · rintro w ⟨hwcl, hyw⟩
        have h1 : h.symm w = z := hzu (h.symm w) ⟨(K' w).mp hwcl, hyw.map h.continuous_symm⟩
        rw [← h1, Homeomorph.apply_symm_apply]
    · haveI := hc
      exact extremallyDisconnected_of_homeo
        (Homeomorph.subtype h (p := fun x => x ∈ {x : X | IsClosed ({x} : Set X)})
          (q := fun y => y ∈ {x : Y | IsClosed ({x} : Set Y)}) (fun x => (K x).symm))

  have KEY : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [Algebra.IsIntegral A B],
      Function.Injective (PrimeSpectrum.comap (algebraMap A B)) →
      (∀ (m : Ideal A) [m.IsMaximal], HenselianLocalRing (Localization.AtPrime m) ∧
          IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime m))) →
      ∀ (n : Ideal B) [n.IsMaximal], HenselianLocalRing (Localization.AtPrime n) ∧
          IsSepClosed (IsLocalRing.ResidueField (Localization.AtPrime n)) := by
    intro A B _ _ _ _ hinj hA n hn
    set m : Ideal A := n.under A with hm
    haveI hmM : m.IsMaximal := Ideal.IsMaximal.under A n

    have hloc : IsLocalization.AtPrime
        (Localization (Algebra.algebraMapSubmonoid B m.primeCompl)) n := by
      have hle : Algebra.algebraMapSubmonoid B m.primeCompl ≤ n.primeCompl := by
        intro y hy
        obtain ⟨a, ha, rfl⟩ := Submonoid.mem_map.mp hy
        exact fun hy' => ha hy'
      refine IsLocalization.of_le (Algebra.algebraMapSubmonoid B m.primeCompl) n.primeCompl hle ?_
      intro b hb
      by_contra hnu
      obtain ⟨N, hN, hbN⟩ := Ideal.exists_le_maximal
        (Ideal.span {algebraMap B (Localization (Algebra.algebraMapSubmonoid B m.primeCompl)) b})
        (by rwa [Ne, Ideal.span_singleton_eq_top])
      haveI := hN
      have hbN' : algebraMap B (Localization (Algebra.algebraMapSubmonoid B m.primeCompl)) b ∈ N :=
        hbN (Ideal.subset_span rfl)
      have h1 : N.under (Localization.AtPrime m) = IsLocalRing.maximalIdeal _ := by
        haveI := Ideal.IsMaximal.under (Localization.AtPrime m) N
        exact IsLocalRing.eq_maximalIdeal this
      have h2 : N.under A = m := by
        rw [← Ideal.under_under (B := Localization.AtPrime m) N, h1]
        exact Localization.AtPrime.under_maximalIdeal
      have h3 : (N.under B).under A = n.under A := by
        rw [Ideal.under_under, h2]
      have hP : (N.under B).IsPrime := Ideal.IsPrime.under B N
      have h4 : (⟨N.under B, hP⟩ : PrimeSpectrum B) = ⟨n, hn.isPrime⟩ :=
        hinj (PrimeSpectrum.ext h3)
      have h5 : N.under B = n := congrArg PrimeSpectrum.asIdeal h4
      apply hb
      rw [← h5]
      exact hbN'

    haveI := hloc
    haveI : IsLocalRing (Localization (Algebra.algebraMapSubmonoid B m.primeCompl)) :=
      IsLocalization.AtPrime.isLocalRing _ n
    obtain ⟨hH, hS⟩ := hA m
    haveI := hH
    haveI := hS
    obtain ⟨hBH, hBS⟩ := IOSH (Localization.AtPrime m)
      (Localization (Algebra.algebraMapSubmonoid B m.primeCompl)) inferInstance
    let e : Localization (Algebra.algebraMapSubmonoid B m.primeCompl) ≃+* Localization.AtPrime n :=
      (IsLocalization.algEquiv n.primeCompl
        (Localization (Algebra.algebraMapSubmonoid B m.primeCompl))
        (Localization.AtPrime n)).toRingEquiv
    exact ⟨T₁ _ _ e hBH, T₂ _ _ (IsLocalRing.ResidueField.mapEquiv e) hBS⟩

  have hhom : IsHomeomorph ⇑q :=
    isHomeomorph_iff_continuous_isClosedMap_bijective.mpr ⟨q.continuous, q.isClosedMap, hq⟩
  obtain ⟨W1, W2, W3⟩ := HW Δ Y (IsHomeomorph.homeomorph ⇑q hhom).symm hW1 hW2 hW3

  have e1 : Spec.map q.appTop = Y.isoSpec.inv ≫ q ≫ Δ.isoSpec.hom := by
    rw [← Scheme.isoSpec_hom_naturality, Iso.inv_hom_id_assoc]
  have hinjS : Function.Injective ⇑(Spec.map q.appTop) := by
    rw [e1]
    intro x y hxy
    simp only [Scheme.Hom.comp_apply] at hxy
    have h1 : q (Y.isoSpec.inv x) = q (Y.isoSpec.inv y) :=
      (Scheme.homeoOfIso Δ.isoSpec).injective
        (by rw [Scheme.homeoOfIso_apply, Scheme.homeoOfIso_apply]; exact hxy)
    have h2 : Y.isoSpec.inv x = Y.isoSpec.inv y := hq.1 h1
    exact (Scheme.homeoOfIso Y.isoSpec.symm).injective
      (by rw [Scheme.homeoOfIso_apply, Scheme.homeoOfIso_apply]; exact h2)
  have hinj : Function.Injective (PrimeSpectrum.comap q.appTop.hom) := by
    intro x y hxy
    first
      | exact hinjS hxy
      | exact hinjS (by rw [Spec.map_apply, Spec.map_apply]; exact hxy)
      | exact hinjS (by simpa only [Spec.map_apply] using hxy)

  have hφint : (q.appTop).hom.IsIntegral := IsIntegralHom.isIntegral_app q ⊤ (isAffineOpen_top Δ)
  have hAm := (SI Δ hΔ).mp hW4
  letI : Algebra Γ(Δ, ⊤) Γ(Y, ⊤) := q.appTop.hom.toAlgebra
  haveI : Algebra.IsIntegral Γ(Δ, ⊤) Γ(Y, ⊤) := ⟨hφint⟩
  have hBn := KEY Γ(Δ, ⊤) Γ(Y, ⊤) hinj hAm
  exact ⟨hYa, W1, W2, W3, (SI Y hYa).mpr hBn⟩

  intro B C _ _ _ _ _ _ hInt
  classical
  haveI := hInt

  have hloc : IsLocalHom (algebraMap B C) := by
    refine ⟨fun a ha => ?_⟩
    by_contra hna
    have hker : RingHom.ker (algebraMap B C) ≤ IsLocalRing.maximalIdeal B :=
      IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top _)
    obtain ⟨Q, hQ, hQu⟩ :=
      Ideal.exists_ideal_over_maximal_of_isIntegral (S := C) (IsLocalRing.maximalIdeal B) hker
    have hmem : a ∈ IsLocalRing.maximalIdeal B := (IsLocalRing.mem_maximalIdeal a).mpr hna
    rw [← hQu] at hmem
    have hQa : algebraMap B C a ∈ Q := hmem
    exact hQ.ne_top (Ideal.eq_top_of_isUnit_mem _ hQa ha)
  haveI := hloc

  have hsep : IsSepClosed (IsLocalRing.ResidueField C) := by
    haveI : Algebra.IsAlgebraic (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField C) := by
      constructor
      intro z
      obtain ⟨c, rfl⟩ := IsLocalRing.residue_surjective z
      obtain ⟨f, hf, hfc⟩ := hInt.isIntegral c
      refine ⟨f.map (IsLocalRing.residue B), (hf.map _).ne_zero, ?_⟩
      have hcomp : (algebraMap (IsLocalRing.ResidueField B) (IsLocalRing.ResidueField C)).comp
          (IsLocalRing.residue B) = (IsLocalRing.residue C).comp (algebraMap B C) := by
        ext b
        exact IsLocalRing.ResidueField.algebraMap_residue b
      rw [Polynomial.aeval_def, Polynomial.eval₂_map, hcomp, ← Polynomial.hom_eval₂, hfc, map_zero]
    exact Algebra.IsAlgebraic.isSepClosed (F := IsLocalRing.ResidueField B)
  have hofId : ((Algebra.ofId B (IsLocalRing.ResidueField B) : B →ₐ[B] IsLocalRing.ResidueField B) :
      B →+* IsLocalRing.ResidueField B) = IsLocalRing.residue B := by
    ext x
    show Algebra.ofId B (IsLocalRing.ResidueField B) x = IsLocalRing.residue B x
    rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq]

  have s3a : ∀ (S : Type u) [CommRing S] [Algebra B S], Algebra.IsStandardEtale B S →
      ∀ φ : S →ₐ[B] IsLocalRing.ResidueField B,
        ∃ τ : S →ₐ[B] B, (Algebra.ofId B (IsLocalRing.ResidueField B)).comp τ = φ := by
    intro S _ _ hS φ
    obtain ⟨P⟩ := hS.nonempty_standardEtalePresentation
    have hm := P.hasMap
    have hf0 : Polynomial.aeval (φ P.x) P.f = 0 := by
      rw [Polynomial.aeval_algHom_apply, hm.1, map_zero]
    have hg0 : Polynomial.aeval (φ P.x) P.g ≠ 0 := by
      rw [Polynomial.aeval_algHom_apply]
      exact (hm.2.map φ).ne_zero
    have hd0 : Polynomial.aeval (φ P.x) (Polynomial.derivative P.f) ≠ 0 := by
      obtain ⟨p₁, p₂, N, hc⟩ := P.cond
      have h1 := congrArg (Polynomial.aeval (φ P.x)) hc
      rw [map_add, map_mul, map_mul, hf0, zero_mul, add_zero, map_pow] at h1
      intro h
      rw [h, zero_mul] at h1
      exact pow_ne_zero N hg0 h1.symm
    have key := (HenselianLocalRing.TFAE B).out 1 2
    obtain ⟨a, ha, hres⟩ := key.mp inferInstance P.f P.monic_f (φ P.x) hf0 hd0
    have hA : P.HasMap a := by
      refine ⟨?_, ?_⟩
      · rw [Polynomial.aeval_def, Algebra.algebraMap_self, Polynomial.eval₂_id]
        exact ha
      · have key2 : (Algebra.ofId B (IsLocalRing.ResidueField B)) (Polynomial.aeval a P.g) =
            Polynomial.aeval (φ P.x) P.g := by
          rw [← Polynomial.aeval_algHom_apply, Algebra.ofId_apply,
            IsLocalRing.ResidueField.algebraMap_eq, hres]
        rw [Algebra.ofId_apply, IsLocalRing.ResidueField.algebraMap_eq] at key2
        exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mp (key2 ▸ hg0)
    refine ⟨(P.lift a hA).comp P.equivRing.toAlgHom, ?_⟩
    have h1 : (Algebra.ofId B (IsLocalRing.ResidueField B)).comp (P.lift a hA) =
        φ.comp P.equivRing.symm.toAlgHom := by
      apply StandardEtalePair.hom_ext
      rw [AlgHom.comp_apply, AlgHom.comp_apply, StandardEtalePair.lift_X, Algebra.ofId_apply,
        IsLocalRing.ResidueField.algebraMap_eq, hres]
      have hx : P.equivRing.symm P.X = P.x := (P.equivRing.symm_apply_eq).mpr P.equivRing_x.symm
      show φ P.x = φ (P.equivRing.symm P.X)
      rw [hx]
    ext s
    have h2 := congrArg (fun F => F (P.equivRing s)) h1
    simpa using h2

  have s3 : ∀ (E : Type u) [CommRing E] [Algebra B E], Algebra.Etale B E →
      ∀ φ : E →ₐ[B] IsLocalRing.ResidueField B,
        ∃ τ : E →ₐ[B] B, (Algebra.ofId B (IsLocalRing.ResidueField B)).comp τ = φ := by
    intro E _ _ hE φ
    have : (RingHom.ker (φ : E →+* IsLocalRing.ResidueField B)).IsPrime := RingHom.ker_isPrime _
    obtain ⟨s, hs, hst⟩ := Algebra.IsEtaleAt.exists_isStandardEtale (R := B)
      (RingHom.ker (φ : E →+* IsLocalRing.ResidueField B))
    have hs0 : φ s ≠ 0 := fun h => hs (RingHom.mem_ker.mpr h)
    have hu : ∀ y : Submonoid.powers s, IsUnit (φ y) := by
      rintro ⟨y, k, rfl⟩
      simpa [map_pow] using (isUnit_iff_ne_zero.mpr hs0).pow k
    let φ' : Localization.Away s →ₐ[B] IsLocalRing.ResidueField B :=
      IsLocalization.liftAlgHom (M := Submonoid.powers s) hu
    obtain ⟨τ', hτ'⟩ := s3a _ hst φ'
    refine ⟨τ'.comp (IsScalarTower.toAlgHom B E (Localization.Away s)), ?_⟩
    ext e
    have h1 := congrArg (fun F => F (algebraMap E (Localization.Away s) e)) hτ'
    simp only [AlgHom.comp_apply] at h1 ⊢
    rw [IsScalarTower.toAlgHom_apply, h1]
    simp [φ', IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]

  have Fac : ∀ (f : Polynomial B) (g₀ h₀ : Polynomial (IsLocalRing.ResidueField B)), f.Monic →
      g₀.Monic → h₀.Monic → IsCoprime g₀ h₀ → f.map (IsLocalRing.residue B) = g₀ * h₀ →
      ∃ g h : Polynomial B, g.Monic ∧ h.Monic ∧ f = g * h ∧ IsCoprime g h ∧
        g.map (IsLocalRing.residue B) = g₀ ∧ h.map (IsLocalRing.residue B) = h₀ := by
    intro f g₀ h₀ hf hg hh hc hfac
    have hn : f.natDegree = g₀.natDegree + h₀.natDegree := by
      rw [← hg.natDegree_mul hh, ← hfac, hf.natDegree_map]
    let p : Polynomial.MonicDegreeEq B f.natDegree := Polynomial.MonicDegreeEq.mk f hf rfl
    let G₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField B) g₀.natDegree :=
      Polynomial.MonicDegreeEq.mk g₀ hg rfl
    let H₀ : Polynomial.MonicDegreeEq (IsLocalRing.ResidueField B) h₀.natDegree :=
      Polynomial.MonicDegreeEq.mk h₀ hh rfl
    have hq : (G₀ : Polynomial (IsLocalRing.ResidueField B)) * (H₀ : Polynomial _) =
        Polynomial.map (algebraMap B (IsLocalRing.ResidueField B)) (p : Polynomial B) ∧
        IsCoprime (G₀ : Polynomial (IsLocalRing.ResidueField B)) (H₀ : Polynomial _) := by
      refine ⟨?_, hc⟩
      rw [IsLocalRing.ResidueField.algebraMap_eq]
      exact hfac.symm
    obtain ⟨τ, hτ⟩ := s3 _ inferInstance
      ((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField B)
        _ _ hn p).symm ⟨(G₀, H₀), hq⟩)
    have nat : ∀ (ψ : B →ₐ[B] IsLocalRing.ResidueField B),
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField B)
          _ _ hn p (ψ.comp τ)).1.1 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv B _ _ hn p τ).1.1 :
          Polynomial.MonicDegreeEq B _) : Polynomial B).map (ψ : B →+* IsLocalRing.ResidueField B) ∧
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField B)
          _ _ hn p (ψ.comp τ)).1.2 : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
        (((Polynomial.UniversalCoprimeFactorizationRing.homEquiv B _ _ hn p τ).1.2 :
          Polynomial.MonicDegreeEq B _) : Polynomial B).map (ψ : B →+* IsLocalRing.ResidueField B) := by
      intro ψ
      constructor
      · show (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
            (((ψ.comp τ).comp (IsScalarTower.toAlgHom B
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                IsLocalRing.ResidueField B)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalFactorizationRing.factor₁ _ _ hn p).map
            ((τ.comp (IsScalarTower.toAlgHom B
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* B)) :
              Polynomial.MonicDegreeEq B _) : Polynomial B).map
                (ψ : B →+* IsLocalRing.ResidueField B)
        rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
        rfl
      · show (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
            (((ψ.comp τ).comp (IsScalarTower.toAlgHom B
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+*
                IsLocalRing.ResidueField B)) : Polynomial.MonicDegreeEq _ _) : Polynomial _) =
          (((Polynomial.UniversalFactorizationRing.factor₂ _ _ hn p).map
            ((τ.comp (IsScalarTower.toAlgHom B
              (Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p)
              (Polynomial.UniversalCoprimeFactorizationRing g₀.natDegree h₀.natDegree hn p)) :
              Polynomial.UniversalFactorizationRing g₀.natDegree h₀.natDegree hn p →+* B)) :
              Polynomial.MonicDegreeEq B _) : Polynomial B).map
                (ψ : B →+* IsLocalRing.ResidueField B)
        rw [Polynomial.MonicDegreeEq.map_coe, Polynomial.MonicDegreeEq.map_coe, Polynomial.map_map]
        rfl
    obtain ⟨nat1, nat2⟩ := nat (Algebra.ofId B (IsLocalRing.ResidueField B))
    have hφ : Polynomial.UniversalCoprimeFactorizationRing.homEquiv (IsLocalRing.ResidueField B)
        _ _ hn p ((Algebra.ofId B (IsLocalRing.ResidueField B)).comp τ) = ⟨(G₀, H₀), hq⟩ := by
      rw [hτ]
      exact Equiv.apply_symm_apply _ _
    rw [hφ, hofId] at nat1 nat2
    refine ⟨_, _, (Polynomial.UniversalCoprimeFactorizationRing.homEquiv B _ _ hn p τ).1.1.monic,
      (Polynomial.UniversalCoprimeFactorizationRing.homEquiv B _ _ hn p τ).1.2.monic, ?_,
      (Polynomial.UniversalCoprimeFactorizationRing.homEquiv B _ _ hn p τ).2.2,
      nat1.symm, nat2.symm⟩
    rw [(Polynomial.UniversalCoprimeFactorizationRing.homEquiv B _ _ hn p τ).2.1,
      Algebra.algebraMap_self, Polynomial.map_id]
    rfl

  have hs5 : ∀ (D : Type u) [CommRing D] [Algebra B D], Algebra.IsIntegral B D →
      ∀ (J : Ideal D), (∀ b ∈ IsLocalRing.maximalIdeal B, algebraMap B D b ∈ J) →
      ∀ d : D, d * d - d ∈ J → ∃ e : D, e * e = e ∧ e - d ∈ J := by
    intro D _ _ hIntD J hJ d hd
    obtain ⟨F, hF, hFd⟩ := hIntD.isIntegral d
    obtain ⟨F₁, hF₁⟩ : ∃ F₁ : Polynomial B,
        F₁ = Polynomial.X * (Polynomial.X - Polynomial.C 1) * F := ⟨_, rfl⟩
    have hF₁m : F₁.Monic := by
      rw [hF₁]; exact (Polynomial.monic_X.mul (Polynomial.monic_X_sub_C 1)).mul hF
    have hF₁d : Polynomial.aeval d F₁ = 0 := by
      rw [hF₁, map_mul, Polynomial.aeval_def d F, hFd, mul_zero]
    obtain ⟨b, H₀, hsplit, hnd⟩ : ∃ (b : ℕ) (H₀ : Polynomial (IsLocalRing.ResidueField B)),
        F₁.map (IsLocalRing.residue B) = (Polynomial.X - Polynomial.C 1) ^ b * H₀ ∧
          ¬ (Polynomial.X - Polynomial.C 1) ∣ H₀ :=
      ⟨_, Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd _ (hF₁m.map _).ne_zero 1⟩
    have hG₀ : ((Polynomial.X - Polynomial.C 1 : Polynomial (IsLocalRing.ResidueField B)) ^ b).Monic :=
      (Polynomial.monic_X_sub_C 1).pow b
    have hH₀ : H₀.Monic := hG₀.of_mul_monic_left (hsplit ▸ hF₁m.map _)
    have hcop : IsCoprime ((Polynomial.X - Polynomial.C 1 :
        Polynomial (IsLocalRing.ResidueField B)) ^ b) H₀ :=
      ((Irreducible.coprime_iff_not_dvd (Polynomial.irreducible_X_sub_C 1)).mpr hnd).pow_left
    have hFbar : F₁.map (IsLocalRing.residue B) = Polynomial.X * (Polynomial.X - Polynomial.C 1) *
        F.map (IsLocalRing.residue B) := by
      rw [hF₁, Polynomial.map_mul, Polynomial.map_mul, Polynomial.map_sub, Polynomial.map_X,
        Polynomial.map_C, map_one]
    have hb : b ≠ 0 := by
      intro hb0
      apply hnd
      rw [hb0, pow_zero, one_mul] at hsplit
      rw [← hsplit, hFbar]
      exact ⟨Polynomial.X * F.map (IsLocalRing.residue B), by ring⟩
    have hH0 : H₀.eval 0 = 0 := by
      have h1 : (F₁.map (IsLocalRing.residue B)).eval 0 = 0 := by
        rw [hFbar, Polynomial.eval_mul, Polynomial.eval_mul, Polynomial.eval_X, zero_mul, zero_mul]
      rw [hsplit, Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_sub, Polynomial.eval_X,
        Polynomial.eval_C] at h1
      have hu : IsUnit (((0 : IsLocalRing.ResidueField B) - 1) ^ b) := by
        rw [zero_sub]; exact (isUnit_one.neg).pow b
      exact hu.mul_right_eq_zero.mp h1
    obtain ⟨G, H, hGm, hHm, hGH, hGHc, hGr, hHr⟩ := Fac F₁ _ H₀ hF₁m hG₀ hH₀ hcop hsplit
    obtain ⟨U, V, hUV⟩ := hGHc
    have hG1 : G.eval 1 ∈ IsLocalRing.maximalIdeal B := by
      rw [← IsLocalRing.residue_eq_zero_iff, ← Polynomial.eval_one_map, hGr, Polynomial.eval_pow,
        Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self, zero_pow hb]
    have hH0' : H.eval 0 ∈ IsLocalRing.maximalIdeal B := by
      rw [← IsLocalRing.residue_eq_zero_iff, ← Polynomial.eval_zero_map, hHr, hH0]
    refine ⟨Polynomial.aeval d (V * H), ?_, ?_⟩
    · have h1 : Polynomial.aeval d (U * G) + Polynomial.aeval d (V * H) = 1 := by
        rw [← map_add, hUV, map_one]
      have h2 : Polynomial.aeval d (U * G) * Polynomial.aeval d (V * H) = 0 := by
        have : U * G * (V * H) = U * V * F₁ := by rw [hGH]; ring
        rw [← map_mul, this, map_mul, hF₁d, mul_zero]
      have h3 : Polynomial.aeval d (U * G) = 1 - Polynomial.aeval d (V * H) := by
        rw [← h1]; ring
      rw [h3] at h2
      linear_combination -h2
    · rw [← Ideal.Quotient.eq]
      have ht : Ideal.Quotient.mk J d * Ideal.Quotient.mk J d = Ideal.Quotient.mk J d := by
        rw [← map_mul]; exact Ideal.Quotient.eq.mpr hd
      have hpow : ∀ n : ℕ, Ideal.Quotient.mk J d ^ (n + 1) = Ideal.Quotient.mk J d := by
        intro n
        induction n with
        | zero => rw [zero_add, pow_one]
        | succ n ih => rw [pow_succ, ih, ht]
      have hcol : ∀ P : Polynomial B, Ideal.Quotient.mk J (Polynomial.aeval d P) =
          Ideal.Quotient.mk J (algebraMap B D (P.eval 0)) * (1 - Ideal.Quotient.mk J d) +
          Ideal.Quotient.mk J (algebraMap B D (P.eval 1)) * Ideal.Quotient.mk J d := by
        intro P
        induction P using Polynomial.induction_on' with
        | add p q hp hq =>
          rw [map_add, map_add, hp, hq, Polynomial.eval_add, Polynomial.eval_add, map_add, map_add,
            map_add, map_add]
          ring
        | monomial n c =>
          rw [Polynomial.aeval_monomial, Polynomial.eval_monomial, Polynomial.eval_monomial]
          cases n with
          | zero =>
            simp only [pow_zero, mul_one]
            ring
          | succ n =>
            rw [map_mul, map_pow, hpow, zero_pow (Nat.succ_ne_zero n), one_pow, mul_zero, mul_one,
              map_zero, map_zero, zero_mul, zero_add]
      rw [hcol (V * H)]
      have h0 : Ideal.Quotient.mk J (algebraMap B D ((V * H).eval 0)) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (hJ _ (by
          rw [Polynomial.eval_mul]; exact Ideal.mul_mem_left _ _ hH0'))
      have h1e : (V * H).eval 1 = 1 - U.eval 1 * G.eval 1 := by
        have := congrArg (Polynomial.eval 1) hUV
        rw [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_mul, Polynomial.eval_one] at this
        rw [Polynomial.eval_mul]
        linear_combination this
      have h1 : Ideal.Quotient.mk J (algebraMap B D ((V * H).eval 1)) = 1 := by
        rw [h1e, map_sub, map_one, map_sub, map_one,
          Ideal.Quotient.eq_zero_iff_mem.mpr (hJ _ (Ideal.mul_mem_left _ _ hG1)), sub_zero]
      rw [h0, h1]
      ring

  have hD : ∀ g : Polynomial C, g.Monic → g.coeff 0 ∈ IsLocalRing.maximalIdeal C →
      IsUnit (g.coeff 1) → ∃ a ∈ IsLocalRing.maximalIdeal C, g.IsRoot a := by
    intro g hg h0 hu
    have hn : 0 < g.natDegree := by
      rcases Nat.eq_zero_or_pos g.natDegree with h | h
      · exfalso
        have h1 := Polynomial.eq_one_of_monic_natDegree_zero hg h
        rw [h1] at hu
        simp [Polynomial.coeff_one] at hu
      · exact h
    obtain ⟨v, hv⟩ : ∃ v, v * g.coeff 1 = 1 := ⟨↑hu.unit⁻¹, hu.val_inv_mul⟩
    have hvu : IsUnit v := ⟨⟨v, g.coeff 1, hv, by rw [mul_comm]; exact hv⟩, rfl⟩
    haveI : Module.Finite C (AdjoinRoot g) := (AdjoinRoot.powerBasis' hg).finite
    haveI : Algebra.IsIntegral C (AdjoinRoot g) := Algebra.IsIntegral.of_finite C (AdjoinRoot g)
    haveI : Algebra.IsIntegral B (AdjoinRoot g) := Algebra.IsIntegral.trans C
    obtain ⟨J, hJdef⟩ : ∃ J : Ideal (AdjoinRoot g),
        J = Ideal.map (algebraMap C (AdjoinRoot g)) (IsLocalRing.maximalIdeal C) := ⟨_, rfl⟩
    have hιJ : ∀ c ∈ IsLocalRing.maximalIdeal C, algebraMap C (AdjoinRoot g) c ∈ J := by
      intro c hc; rw [hJdef]; exact Ideal.mem_map_of_mem _ hc

    have hlin : ∀ l : AdjoinRoot g →ₗ[C] C, ∀ y ∈ J, l y ∈ IsLocalRing.maximalIdeal C := by
      intro l y hy
      have hy' : y ∈ (IsLocalRing.maximalIdeal C) • (⊤ : Submodule C (AdjoinRoot g)) := by
        rw [Ideal.smul_top_eq_map, ← hJdef]; exact hy
      refine Submodule.smul_induction_on hy' ?_ ?_
      · intro r hr n _
        rw [map_smul, smul_eq_mul]
        exact Ideal.mul_mem_right _ _ hr
      · intro x y hx hy
        rw [map_add]; exact add_mem hx hy
    obtain ⟨d, hd⟩ : ∃ d : AdjoinRoot g,
        d = algebraMap C (AdjoinRoot g) v * AdjoinRoot.mk g g.divX := ⟨_, rfl⟩

    have hi : AdjoinRoot.mk g g.divX * AdjoinRoot.root g =
        -algebraMap C (AdjoinRoot g) (g.coeff 0) := by
      have := congrArg (AdjoinRoot.mk g) (Polynomial.divX_mul_X_add g)
      rw [map_add, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C, AdjoinRoot.mk_self] at this
      rw [AdjoinRoot.algebraMap_eq]
      linear_combination this
    have hii : AdjoinRoot.mk g g.divX = AdjoinRoot.mk g g.divX.divX * AdjoinRoot.root g +
        algebraMap C (AdjoinRoot g) (g.coeff 1) := by
      have := congrArg (AdjoinRoot.mk g) (Polynomial.divX_mul_X_add g.divX)
      rw [map_add, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C, Polynomial.coeff_divX, zero_add] at this
      rw [AdjoinRoot.algebraMap_eq]
      exact this.symm
    have hxd : AdjoinRoot.root g * d ∈ J := by
      have : AdjoinRoot.root g * d = -algebraMap C (AdjoinRoot g) (v * g.coeff 0) := by
        rw [hd, map_mul]
        linear_combination (algebraMap C (AdjoinRoot g) v) * hi
      rw [this]
      exact J.neg_mem (hιJ _ (Ideal.mul_mem_left _ _ h0))
    have hdd : d * d - d ∈ J := by
      have hvu' : algebraMap C (AdjoinRoot g) v * algebraMap C (AdjoinRoot g) (g.coeff 1) = 1 := by
        rw [← map_mul, hv, map_one]
      have hd1 : d - 1 = algebraMap C (AdjoinRoot g) v * AdjoinRoot.mk g g.divX.divX *
          AdjoinRoot.root g := by
        rw [hd, hii]
        linear_combination hvu'
      have : d * d - d = (AdjoinRoot.root g * d) *
          (algebraMap C (AdjoinRoot g) v * AdjoinRoot.mk g g.divX.divX) := by
        linear_combination d * hd1
      rw [this]
      exact J.mul_mem_right _ hxd
    have hJB : ∀ b ∈ IsLocalRing.maximalIdeal B, algebraMap B (AdjoinRoot g) b ∈ J := by
      intro b hb
      rw [IsScalarTower.algebraMap_apply B C (AdjoinRoot g)]
      apply hιJ
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu'
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hb
      exact hb (isUnit_of_map_unit _ _ hu')
    obtain ⟨e, he, hed⟩ := hs5 (AdjoinRoot g) inferInstance J hJB d hdd

    obtain ⟨l, hl⟩ : ∃ l : AdjoinRoot g →ₗ[C] C,
        l = (Polynomial.lcoeff C (g.natDegree - 1)).comp (AdjoinRoot.modByMonicHom hg) := ⟨_, rfl⟩
    have hlq : l (AdjoinRoot.mk g g.divX) = 1 := by
      rw [hl, LinearMap.comp_apply, AdjoinRoot.modByMonicHom_mk, Polynomial.lcoeff_apply]
      have hdeg : g.divX.degree < g.degree := by
        apply Polynomial.degree_lt_degree
        rw [Polynomial.natDegree_divX_eq_natDegree_tsub_one]
        omega
      rw [(Polynomial.modByMonic_eq_self_iff hg).mpr hdeg, Polynomial.coeff_divX,
        Nat.sub_add_cancel hn, hg.coeff_natDegree]
    have hsm : ∀ (c : C) (y : AdjoinRoot g), l (algebraMap C (AdjoinRoot g) c * y) = c * l y := by
      intro c y
      rw [← Algebra.smul_def, map_smul, smul_eq_mul]
    have hld : l d = v := by rw [hd, hsm, hlq, mul_one]
    have hle : l e ∉ IsLocalRing.maximalIdeal C := by
      intro hmem
      have h1 : l (e - d) ∈ IsLocalRing.maximalIdeal C := hlin l _ hed
      rw [map_sub, hld] at h1
      have h2 := Ideal.sub_mem _ hmem h1
      rw [sub_sub_cancel] at h2
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h2
      exact h2 hvu
    have hleU : IsUnit (l e) := by
      by_contra h
      apply hle
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact h
    have hxe : AdjoinRoot.root g * e ∈ J := by
      have : AdjoinRoot.root g * e = AdjoinRoot.root g * d + AdjoinRoot.root g * (e - d) := by ring
      rw [this]
      exact J.add_mem hxd (J.mul_mem_left _ hed)

    have hnak : ∃ a : C, algebraMap C (AdjoinRoot g) a * e = AdjoinRoot.root g * e := by
      have hfg : (LinearMap.range (LinearMap.mulRight C e)).FG := by
        rw [LinearMap.range_eq_map]; exact Module.Finite.fg_top.map _
      have hjac := IsLocalRing.maximalIdeal_le_jacobson (R := C) ⊥
      have hstar : ∀ w ∈ J, w * e ∈ IsLocalRing.maximalIdeal C •
          LinearMap.range (LinearMap.mulRight C e) := by
        intro w hw
        have hw' : w ∈ (IsLocalRing.maximalIdeal C) • (⊤ : Submodule C (AdjoinRoot g)) := by
          rw [Ideal.smul_top_eq_map, ← hJdef]; exact hw
        refine Submodule.smul_induction_on hw' ?_ ?_
        · intro r hr n _
          rw [smul_mul_assoc]
          exact Submodule.smul_mem_smul hr (LinearMap.mem_range.mpr ⟨n, rfl⟩)
        · intro x y hx hy
          rw [add_mul]; exact add_mem hx hy
      have hle' : LinearMap.range (LinearMap.mulRight C e) ≤
          (C ∙ e) ⊔ IsLocalRing.maximalIdeal C • LinearMap.range (LinearMap.mulRight C e) := by
        intro z hz
        obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp hz
        obtain ⟨P, rfl⟩ := AdjoinRoot.mk_surjective y
        rw [LinearMap.mulRight_apply, ← AdjoinRoot.aeval_eq]
        have hP : Polynomial.aeval (AdjoinRoot.root g) P =
            Polynomial.aeval (AdjoinRoot.root g) P.divX * AdjoinRoot.root g +
              algebraMap C (AdjoinRoot g) (P.coeff 0) := by
          conv_lhs => rw [← Polynomial.divX_mul_X_add P]
          rw [map_add, map_mul, Polynomial.aeval_X, Polynomial.aeval_C]
        have hw : Polynomial.aeval (AdjoinRoot.root g) P.divX * (AdjoinRoot.root g * e) ∈ J :=
          J.mul_mem_left _ hxe
        have heq : Polynomial.aeval (AdjoinRoot.root g) P * e = P.coeff 0 • e +
            (Polynomial.aeval (AdjoinRoot.root g) P.divX * (AdjoinRoot.root g * e)) * e := by
          rw [hP, Algebra.smul_def]
          linear_combination (-(Polynomial.aeval (AdjoinRoot.root g) P.divX * AdjoinRoot.root g)) * he
        rw [heq]
        exact Submodule.add_mem_sup (Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self e))
          (hstar _ hw)
      have hN := Submodule.le_of_le_smul_of_le_jacobson_bot hfg hjac hle'
      obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp
        (hN (LinearMap.mem_range.mpr ⟨AdjoinRoot.root g, rfl⟩))
      refine ⟨a, ?_⟩
      rw [← Algebra.smul_def, ha, LinearMap.mulRight_apply]
    obtain ⟨a, ha⟩ := hnak

    have hpow : ∀ n : ℕ, algebraMap C (AdjoinRoot g) a ^ n * e = AdjoinRoot.root g ^ n * e := by
      intro n
      induction n with
      | zero => simp
      | succ n ih =>
        calc algebraMap C (AdjoinRoot g) a ^ (n + 1) * e
            = algebraMap C (AdjoinRoot g) a * (algebraMap C (AdjoinRoot g) a ^ n * e) := by ring
          _ = algebraMap C (AdjoinRoot g) a * (AdjoinRoot.root g ^ n * e) := by rw [ih]
          _ = AdjoinRoot.root g ^ n * (algebraMap C (AdjoinRoot g) a * e) := by ring
          _ = AdjoinRoot.root g ^ n * (AdjoinRoot.root g * e) := by rw [ha]
          _ = AdjoinRoot.root g ^ (n + 1) * e := by ring
    have h6c : ∀ P : Polynomial C, algebraMap C (AdjoinRoot g) (P.eval a) * e =
        Polynomial.aeval (AdjoinRoot.root g) P * e := by
      intro P
      induction P using Polynomial.induction_on' with
      | add p q hp hq => rw [Polynomial.eval_add, map_add, add_mul, hp, hq, map_add, add_mul]
      | monomial n c =>
        rw [Polynomial.eval_monomial, Polynomial.aeval_monomial, map_mul, map_pow, mul_assoc, hpow,
          mul_assoc]
    have hg0 := h6c g
    rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self, zero_mul] at hg0
    have hl0 := congrArg l hg0
    rw [hsm, map_zero] at hl0
    have hga : g.eval a = 0 := hleU.mul_left_eq_zero.mp hl0
    have hae : l (algebraMap C (AdjoinRoot g) a * e) ∈ IsLocalRing.maximalIdeal C := by
      apply hlin; rw [ha]; exact hxe
    rw [hsm] at hae
    rcases (IsLocalRing.maximalIdeal.isMaximal C).isPrime.mem_or_mem hae with h | h
    · exact ⟨a, h, hga⟩
    · exact absurd h hle

  refine ⟨HenselianLocalRing.mk (fun f hf a₀ h₀ hu => ?_), hsep⟩
  have hc0 : (f.comp (Polynomial.X + Polynomial.C a₀)).coeff 0 ∈ IsLocalRing.maximalIdeal C := by
    rw [Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_comp, Polynomial.eval_add,
      Polynomial.eval_X, Polynomial.eval_C, zero_add]
    exact h₀
  have hc1 : IsUnit ((f.comp (Polynomial.X + Polynomial.C a₀)).coeff 1) := by
    have h1 := Polynomial.coeff_derivative (f.comp (Polynomial.X + Polynomial.C a₀)) 0
    rw [Polynomial.derivative_comp, Polynomial.derivative_X_add_C, one_mul,
      Polynomial.coeff_zero_eq_eval_zero, Polynomial.eval_comp, Polynomial.eval_add,
      Polynomial.eval_X, Polynomial.eval_C, zero_add] at h1
    simp only [Nat.cast_zero, zero_add, mul_one] at h1
    rw [← h1]
    exact hu
  obtain ⟨a, ha, hroot⟩ := hD (f.comp (Polynomial.X + Polynomial.C a₀)) (hf.comp_X_add_C a₀) hc0 hc1
  refine ⟨a + a₀, ?_, by rwa [add_sub_cancel_right]⟩
  have h2 : (f.comp (Polynomial.X + Polynomial.C a₀)).eval a = f.eval (a + a₀) := by
    rw [Polynomial.eval_comp, Polynomial.eval_add, Polynomial.eval_X, Polynomial.eval_C]
  show f.eval (a + a₀) = 0
  rw [← h2]
  exact hroot

theorem wc_ntc_push_exact {XE XE' : Scheme.{u}} (βE : XE' ⟶ XE) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (DβE : wcHMPullData βE ℓ)
    (hgeo : ∀ {T : Scheme.{u}} (t : T ⟶ XE),
      IsIntegralHom (Limits.pullback.fst t βE) ∧ IsHomeomorph ⇑(Limits.pullback.fst t βE))
    (hstab : ∀ {Δ Y : Scheme.{u}} (q : Y ⟶ Δ) [IsIntegralHom q], Function.Bijective ⇑q →
      IsAffine Δ → wcNtcWConds Δ → IsAffine Y ∧ wcNtcWConds Y) :
    Limits.PreservesFiniteColimits
      (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC βE) _ _ DβE.cont DβE.φ) :=
by
  classical
  haveI hcont := DβE.cont

  have hsplit : ∀ (V : XE.ProEt) (T : Sieve ((wcProEtBC βE).obj V)),
      T ∈ Scheme.ProEt.topology XE' ((wcProEtBC βE).obj V) →
      ∃ R : Presieve V, Sieve.generate R ∈ Scheme.ProEt.topology XE V ∧
        ∀ ⦃W : XE.ProEt⦄ (f : W ⟶ V), R f →
          ∃ (n : ℕ) (P : Fin n → XE'.ProEt) (ι : ∀ k, P k ⟶ (wcProEtBC βE).obj W),
            (∀ k, IsOpenImmersion (ι k).left) ∧
            (∀ x : ((wcProEtBC βE).obj W).left, ∃! k, x ∈ Set.range ⇑(ι k).left) ∧
            ∀ k, T (ι k ≫ (wcProEtBC βE).map f) := by
    intro V T hT
    refine ⟨fun (W : XE.ProEt) (_ : W ⟶ V) => IsAffine W.left ∧
        (IsClosed {x : W.left | IsClosed ({x} : Set W.left)} ∧
        (∀ x : W.left, ∃! y : W.left, IsClosed ({y} : Set W.left) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : W.left | IsClosed ({x} : Set W.left)} ∧
        (∀ x : W.left, IsClosed ({x} : Set W.left) →
          HenselianLocalRing (W.left.presheaf.stalk x) ∧ IsSepClosed (W.left.residueField x))),
      wc_proet_cover_of_affine_local (fun Δ => IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ∧
        ExtremallyDisconnected {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, IsClosed ({x} : Set Δ) →
          HenselianLocalRing (Δ.presheaf.stalk x) ∧ IsSepClosed (Δ.residueField x)))
        (fun V₀ hV₀ => wc_exists_wcontractible_cover V₀ hV₀) V, ?_⟩
    intro W f hRf
    obtain ⟨hWa, q1, q2, q3, q4⟩ := hRf
    haveI : IsAffine W.left := hWa
    haveI : IsAffine ((𝟭 Scheme.{u}).obj W.left) := hWa

    obtain ⟨hI, hH⟩ := hgeo W.hom
    haveI := hI
    obtain ⟨hUa, r1, r2, r3, r4⟩ :=
      hstab (Limits.pullback.fst W.hom βE) hH.bijective hWa ⟨q1, q2, q3, q4⟩
    have hRET := wc_wlocal_strictHensel_retraction (Limits.pullback W.hom βE) hUa r1 r2 r3 r4
    have hT' : T.pullback ((wcProEtBC βE).map f) ∈
        Scheme.ProEt.topology XE' ((wcProEtBC βE).obj W) :=
      (Scheme.ProEt.topology XE').pullback_stable _ hT
    obtain ⟨n, P, fk, hPa, hTfk, hsurj⟩ :=
      wc_proet_cover_affine_finite_refine ((wcProEtBC βE).obj W) hUa _ hT'
    obtain ⟨m, Q, ι, hopen, huniq, hfac⟩ :=
      wc_ret_disjoint_open_refine ((wcProEtBC βE).obj W) hUa hRET n P fk hPa hsurj
    refine ⟨m, Q, ι, hopen, huniq, fun j => ?_⟩
    obtain ⟨k, h, hh⟩ := hfac j
    have hj := (T.pullback ((wcProEtBC βE).map f)).downward_closed (hTfk k) h
    rw [hh] at hj
    exact hj

  haveI hepi := wc_sheafPushforward_preservesEpi_of_split (wcProEtBC βE) hsplit
  haveI hlim : Limits.PreservesFiniteLimits ((wcProEtBC βE).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology XE) (Scheme.ProEt.topology XE')) :=
    inferInstance
  haveI : ((wcProEtBC βE).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology XE) (Scheme.ProEt.topology XE')).PreservesZeroMorphisms :=
    Functor.preservesZeroMorphisms_of_preserves_terminal_object
  haveI : ((wcProEtBC βE).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology XE) (Scheme.ProEt.topology XE')).Additive :=
    Functor.additive_of_preserves_binary_products _
  haveI : ((wcProEtBC βE).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology XE) (Scheme.ProEt.topology XE')).PreservesHomology :=
    Functor.preservesHomology_of_preservesEpis_and_kernels _
  haveI hcolim : Limits.PreservesFiniteColimits ((wcProEtBC βE).sheafPushforwardContinuous
      AddCommGrpCat.{u+1} (Scheme.ProEt.topology XE) (Scheme.ProEt.topology XE')) :=
    Functor.preservesFiniteColimits_of_preservesHomology _

  haveI := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology XE) (wcRingSheaf XE ℓ)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology XE') (wcRingSheaf XE' ℓ)
  exact (sheafOfModules_pushforward_exact (wcProEtBC βE) (wcRingSheaf XE ℓ)
    (wcRingSheaf XE' ℓ) DβE.φ).2.2

theorem wc_ntc_unit_iso {XE XE' : Scheme.{u}} (βE : XE' ⟶ XE) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (DβE : wcHMPullData βE ℓ) (hDβE : wcHMPullCanonical DβE)
    (hhomeo : ∀ V : XE.ProEt, IsHomeomorph ⇑(Limits.pullback.fst V.hom βE)) :
    IsIso (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
      (wcProEtBC βE) _ _ DβE.cont DβE.φ) :=
by
  haveI := DβE.cont
  set uu := @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
      (wcProEtBC βE) _ _ DβE.cont DβE.φ with huu
  have hbij : ∀ V : XE.ProEt, Function.Bijective (uu.val.app (Opposite.op V)).hom := by
    intro V
    have key : ∀ a : C(↥V.left, ULift.{u+1} ℚ_[ℓ]),
        ((uu.val.app (Opposite.op V)).hom a :
          C(↥(Limits.pullback V.hom βE), ULift.{u+1} ℚ_[ℓ])) =
        a.comp (Limits.pullback.fst V.hom βE).base.hom := fun a =>
      (SheafOfModules.unitToPushforwardObjUnit_val_app_apply DβE.φ a).trans (hDβE V a)
    have hfun : (⇑(uu.val.app (Opposite.op V)).hom :
        C(↥V.left, ULift.{u+1} ℚ_[ℓ]) → C(↥(Limits.pullback V.hom βE), ULift.{u+1} ℚ_[ℓ])) =
        (fun a : C(↥V.left, ULift.{u+1} ℚ_[ℓ]) =>
          a.comp (Limits.pullback.fst V.hom βE).base.hom) := funext key
    let e := (hhomeo V).homeomorph
    have h1 : ∀ x, (Limits.pullback.fst V.hom βE).base.hom (e.symm x) = x :=
      fun x => e.apply_symm_apply x
    have h2 : ∀ p, e.symm ((Limits.pullback.fst V.hom βE).base.hom p) = p :=
      fun p => e.symm_apply_apply p
    have hb : Function.Bijective (fun a : C(↥V.left, ULift.{u+1} ℚ_[ℓ]) =>
        a.comp (Limits.pullback.fst V.hom βE).base.hom) := by
      refine ⟨fun a b hab => ?_, fun c => ⟨c.comp ⟨e.symm, e.symm.continuous⟩, ?_⟩⟩
      · apply ContinuousMap.ext
        intro x
        have := congrArg (fun g : C(↥(Limits.pullback V.hom βE), ULift.{u+1} ℚ_[ℓ]) =>
          g (e.symm x)) hab
        simp only [ContinuousMap.comp_apply, h1] at this
        exact this
      · apply ContinuousMap.ext
        intro p
        simp only [ContinuousMap.comp_apply, ContinuousMap.coe_mk, h2]
    exact hfun ▸ hb
  have hcomp : ∀ X : XE.ProEtᵒᵖ,
      IsIso (((sheafToPresheaf (Scheme.ProEt.topology XE) AddCommGrpCat.{u+1}).map
        ((SheafOfModules.toSheaf (wcRingSheaf XE ℓ)).map uu)).app X) := by
    intro X
    rw [ConcreteCategory.isIso_iff_bijective]
    exact hbij X.unop
  haveI : IsIso ((sheafToPresheaf (Scheme.ProEt.topology XE) AddCommGrpCat.{u+1}).map
      ((SheafOfModules.toSheaf (wcRingSheaf XE ℓ)).map uu)) :=
    NatIso.isIso_of_isIso_app _
  haveI : IsIso ((SheafOfModules.toSheaf (wcRingSheaf XE ℓ)).map uu) :=
    isIso_of_reflects_iso _ (sheafToPresheaf (Scheme.ProEt.topology XE) AddCommGrpCat.{u+1})
  exact isIso_of_reflects_iso uu (SheafOfModules.toSheaf (wcRingSheaf XE ℓ))

theorem wc_ntc_bc_coherence {S : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {XE : Scheme.{u}} {p : XE ⟶ S} {Xm : Scheme.{u}} {g : Xm ⟶ S}
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {βE : XE' ⟶ XE} (hβp : βE ≫ p = p' ≫ g)
    {w : XE ⟶ XE} (hw₁ : w ≫ p = p) {w' : XE' ⟶ XE'} (hw₁' : w' ≫ p' = p')
    (hwβ : w' ≫ βE = βE ≫ w)
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg)
    (Dp : wcHMPullData p ℓ) (hDp : wcHMPullCanonical Dp)
    (Dτ : wcHMPullData w ℓ) (hDτ : wcHMPullCanonical Dτ)
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Dτ' : wcHMPullData w' ℓ) (hDτ' : wcHMPullCanonical Dτ')
    (DβE : wcHMPullData βE ℓ) (hDβE : wcHMPullCanonical DβE) :
    haveI := Dp.cont
    haveI := Dτ.cont
    haveI : (wcProEtBC p ⋙ wcProEtBC w).IsContinuous
        (Scheme.ProEt.topology S) (Scheme.ProEt.topology XE) :=
      Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology XE) _
    let α : wcProEtBC p ⟶ wcProEtBC p ⋙ wcProEtBC w :=
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) p :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) p :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong p))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong w))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
        (Q := ⊤) _ _ _ hw₁.symm).hom
    ∀ (hφ : (Dp.φ ≫ ((wcProEtBC p).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.ProEt.topology S) (Scheme.ProEt.topology XE)).map Dτ.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans α RingCat.{u+1}
          (Scheme.ProEt.topology S) (Scheme.ProEt.topology XE)).app
          (wcRingSheaf XE ℓ) = Dp.φ),
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC p) _ _ Dp.cont Dp.φ
    let Pw := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC w) _ _ Dτ.cont Dτ.φ
    let γ : Pw ⋙ P ⟶ P := (SheafOfModules.pushforwardComp Dp.φ Dτ.φ).hom ≫
        SheafOfModules.pushforwardNatTrans _ α ≫ (SheafOfModules.pushforwardCongr hφ).hom
    haveI := Dp'.cont
    haveI := Dτ'.cont
    haveI : (wcProEtBC p' ⋙ wcProEtBC w').IsContinuous
        (Scheme.ProEt.topology Xm) (Scheme.ProEt.topology XE') :=
      Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology XE') _
    let α' : wcProEtBC p' ⟶ wcProEtBC p' ⋙ wcProEtBC w' :=
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) p' :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) p' :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong p'))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) w' :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) w' :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong w'))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
        (Q := ⊤) _ _ _ hw₁'.symm).hom
    ∀ (hφ' : (Dp'.φ ≫ ((wcProEtBC p').sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.ProEt.topology Xm) (Scheme.ProEt.topology XE')).map Dτ'.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans α' RingCat.{u+1}
          (Scheme.ProEt.topology Xm) (Scheme.ProEt.topology XE')).app
          (wcRingSheaf XE' ℓ) = Dp'.φ),
    let P' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC p') _ _ Dp'.cont Dp'.φ
    let Pw' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC w') _ _ Dτ'.cont Dτ'.φ
    let γ' : Pw' ⋙ P' ⟶ P' := (SheafOfModules.pushforwardComp Dp'.φ Dτ'.φ).hom ≫
        SheafOfModules.pushforwardNatTrans _ α' ≫ (SheafOfModules.pushforwardCongr hφ').hom
    let Pg := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ
    haveI := DβE.cont
    let PE := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC βE) _ _ DβE.cont DβE.φ
    ∃ (β : P' ⋙ Pg ≅ PE ⋙ P) (βw : Pw' ⋙ PE ⟶ PE ⋙ Pw),
      (∀ M : SheafOfModules.{u+1} (wcRingSheaf XE' ℓ),
        Pg.map (γ'.app M) ≫ β.hom.app M =
          β.hom.app (Pw'.obj M) ≫ P.map (βw.app M) ≫ γ.app (PE.obj M)) ∧
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC βE) _ _ DβE.cont DβE.φ ≫
          PE.map (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcProEtBC w') _ _ Dτ'.cont Dτ'.φ) ≫
          βw.app (SheafOfModules.unit (wcRingSheaf XE' ℓ)) =
        @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC w) _ _ Dτ.cont Dτ.φ ≫
          Pw.map (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcProEtBC βE) _ _ DβE.cont DβE.φ)) :=
by
  have hBCfst : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) {A B : Y.ProEt} (g : A ⟶ B),
      ((wcProEtBC h).map g).left ≫ Limits.pullback.fst B.hom h =
        Limits.pullback.fst A.hom h ≫ g.left := by
    intro X Y h A B g
    exact Limits.pullback.lift_fst _ _ _
  have hBCsnd : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) {A B : Y.ProEt} (g : A ⟶ B),
      ((wcProEtBC h).map g).left ≫ Limits.pullback.snd B.hom h = Limits.pullback.snd A.hom h := by
    intro X Y h A B g
    exact Limits.pullback.lift_snd _ _ _
  have natAux : ∀ {A₁ A₂ Q₁ Q₂ B' V₁ V₂ X₁ X₂ Y₁ Y₂ : Scheme.{u}} {mA : A₁ ⟶ A₂} {mQ : Q₁ ⟶ Q₂}
      {e₁ : A₁ ⟶ Q₁} {e₂ : A₂ ⟶ Q₂} {sA₁ : A₁ ⟶ B'} {sA₂ : A₂ ⟶ B'} {sQ₁ : Q₁ ⟶ B'}
      {sQ₂ : Q₂ ⟶ B'} {fA₁ : A₁ ⟶ X₁} {fA₂ : A₂ ⟶ X₂} {gA₁ : X₁ ⟶ V₁} {gA₂ : X₂ ⟶ V₂}
      {mX : X₁ ⟶ X₂} {fQ₁ : Q₁ ⟶ Y₁} {fQ₂ : Q₂ ⟶ Y₂} {gQ₁ : Y₁ ⟶ V₁} {gQ₂ : Y₂ ⟶ V₂}
      {mY : Y₁ ⟶ Y₂} {a : V₁ ⟶ V₂}
      (he₁s : e₁ ≫ sQ₁ = sA₁) (he₂s : e₂ ≫ sQ₂ = sA₂)
      (he₁f : e₁ ≫ fQ₁ ≫ gQ₁ = fA₁ ≫ gA₁) (he₂f : e₂ ≫ fQ₂ ≫ gQ₂ = fA₂ ≫ gA₂)
      (hmAs : mA ≫ sA₂ = sA₁) (hmAf : mA ≫ fA₂ = fA₁ ≫ mX) (hmX : mX ≫ gA₂ = gA₁ ≫ a)
      (hmQs : mQ ≫ sQ₂ = sQ₁) (hmQf : mQ ≫ fQ₂ = fQ₁ ≫ mY) (hmY : mY ≫ gQ₂ = gQ₁ ≫ a)
      (hext : ∀ φ ψ : A₁ ⟶ Q₂, φ ≫ sQ₂ = ψ ≫ sQ₂ → φ ≫ fQ₂ ≫ gQ₂ = ψ ≫ fQ₂ ≫ gQ₂ → φ = ψ),
      mA ≫ e₂ = e₁ ≫ mQ := by
    intro A₁ A₂ Q₁ Q₂ B' V₁ V₂ X₁ X₂ Y₁ Y₂ mA mQ e₁ e₂ sA₁ sA₂ sQ₁ sQ₂ fA₁ fA₂ gA₁ gA₂ mX
      fQ₁ fQ₂ gQ₁ gQ₂ mY a he₁s he₂s he₁f he₂f hmAs hmAf hmX hmQs hmQf hmY hext
    apply hext
    · simp only [Category.assoc]
      rw [he₂s, hmAs, hmQs, he₁s]
    · simp only [Category.assoc]
      rw [he₂f, reassoc_of% hmAf, hmX, reassoc_of% hmQf, hmY, reassoc_of% he₁f]
  have s1 : ∀ {Y A B C : Scheme.{u}} (f1 : A ⟶ Y) (f2 : B ⟶ A) (h1 : C ⟶ Y) (h2 : B ⟶ C)
      (h : f2 ≫ f1 = h2 ≫ h1),
      ∃ ζ : wcProEtBC f1 ⋙ wcProEtBC f2 ≅ wcProEtBC h1 ⋙ wcProEtBC h2,
        ∀ V : Y.ProEt,
          (ζ.hom.app V).left ≫ Limits.pullback.snd (Limits.pullback.snd V.hom h1) h2 =
              Limits.pullback.snd (Limits.pullback.snd V.hom f1) f2 ∧
          (ζ.hom.app V).left ≫ Limits.pullback.fst (Limits.pullback.snd V.hom h1) h2 ≫
              Limits.pullback.fst V.hom h1 =
            Limits.pullback.fst (Limits.pullback.snd V.hom f1) f2 ≫
              Limits.pullback.fst V.hom f1 := by
    intro Y A B C f1 f2 h1 h2 h
    have hA : ∀ V : Y.ProEt, IsPullback (Limits.pullback.snd (Limits.pullback.snd V.hom f1) f2)
        (Limits.pullback.fst (Limits.pullback.snd V.hom f1) f2 ≫ Limits.pullback.fst V.hom f1)
        (f2 ≫ f1) V.hom :=
      fun V => IsPullback.paste_vert
        (IsPullback.of_hasPullback (Limits.pullback.snd V.hom f1) f2).flip
        (IsPullback.of_hasPullback V.hom f1).flip
    have hQ : ∀ V : Y.ProEt, IsPullback (Limits.pullback.snd (Limits.pullback.snd V.hom h1) h2)
        (Limits.pullback.fst (Limits.pullback.snd V.hom h1) h2 ≫ Limits.pullback.fst V.hom h1)
        (h2 ≫ h1) V.hom :=
      fun V => IsPullback.paste_vert
        (IsPullback.of_hasPullback (Limits.pullback.snd V.hom h1) h2).flip
        (IsPullback.of_hasPullback V.hom h1).flip
    have hQ' : ∀ V : Y.ProEt, IsPullback (Limits.pullback.snd (Limits.pullback.snd V.hom h1) h2)
        (Limits.pullback.fst (Limits.pullback.snd V.hom h1) h2 ≫ Limits.pullback.fst V.hom h1)
        (f2 ≫ f1) V.hom := by
      intro V
      rw [h]
      exact hQ V
    let e : ∀ V : Y.ProEt, ((wcProEtBC f1 ⋙ wcProEtBC f2).obj V) ≅
        ((wcProEtBC h1 ⋙ wcProEtBC h2).obj V) :=
      fun V => MorphismProperty.Over.isoMk (IsPullback.isoIsPullback _ _ (hA V) (hQ' V))
        (IsPullback.isoIsPullback_hom_fst _ _ (hA V) (hQ' V))
    refine ⟨NatIso.ofComponents e ?_, fun V =>
      ⟨IsPullback.isoIsPullback_hom_fst _ _ (hA V) (hQ' V),
        IsPullback.isoIsPullback_hom_snd _ _ (hA V) (hQ' V)⟩⟩
    intro V₁ V₂ a
    apply MorphismProperty.Over.Hom.ext
    exact natAux
      (IsPullback.isoIsPullback_hom_fst _ _ (hA V₁) (hQ' V₁))
      (IsPullback.isoIsPullback_hom_fst _ _ (hA V₂) (hQ' V₂))
      (IsPullback.isoIsPullback_hom_snd _ _ (hA V₁) (hQ' V₁))
      (IsPullback.isoIsPullback_hom_snd _ _ (hA V₂) (hQ' V₂))
      (hBCsnd f2 ((wcProEtBC f1).map a)) (hBCfst f2 ((wcProEtBC f1).map a)) (hBCfst f1 a)
      (hBCsnd h2 ((wcProEtBC h1).map a)) (hBCfst h2 ((wcProEtBC h1).map a)) (hBCfst h1 a)
      (fun φ ψ h₁ h₂ => (hQ V₂).hom_ext h₁ h₂)
  have s2 : ∀ {Y A B C : Scheme.{u}} (f1 : A ⟶ Y) (f2 : B ⟶ A) (h1 : C ⟶ Y) (h2 : B ⟶ C)
      (D1 : wcHMPullData f1 ℓ) (hD1 : wcHMPullCanonical D1)
      (D2 : wcHMPullData f2 ℓ) (hD2 : wcHMPullCanonical D2)
      (E1 : wcHMPullData h1 ℓ) (hE1 : wcHMPullCanonical E1)
      (E2 : wcHMPullData h2 ℓ) (hE2 : wcHMPullCanonical E2)
      (ζ : wcProEtBC f1 ⋙ wcProEtBC f2 ≅ wcProEtBC h1 ⋙ wcProEtBC h2)
      (hζ : ∀ V : Y.ProEt,
        (ζ.hom.app V).left ≫ Limits.pullback.fst (Limits.pullback.snd V.hom h1) h2 ≫
            Limits.pullback.fst V.hom h1 =
          Limits.pullback.fst (Limits.pullback.snd V.hom f1) f2 ≫ Limits.pullback.fst V.hom f1),
      ∃ η : @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC h2) _ _ E2.cont E2.φ ⋙
            @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC h1) _ _ E1.cont E1.φ ≅
          @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC f2) _ _ D2.cont D2.φ ⋙
