          _ = z l₀ ≫ (Limits.pullback.fst (W.obj l₀).hom h ≫ (W.obj l₀).hom) :=
              whisker_eq _ Limits.pullback.condition.symm
          _ = (z l₀ ≫ Limits.pullback.fst (W.obj l₀).hom h) ≫ (W.obj l₀).hom :=
              (Category.assoc _ _ _).symm
          _ = (y ≫ φ l₀) ≫ (W.obj l₀).hom := eq_whisker (hy' l₀).symm _
          _ = y ≫ a := by rw [Category.assoc, hφa l₀]
      obtain ⟨z₀, hz₀p, hz₀Z⟩ : ∃ z₀ : T ⟶ XZ,
          z₀ ≫ p = z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h ∧ z₀ ≫ hZ = y :=
        ⟨hpb.lift _ y hxy, hpb.lift_fst _ _ _, hpb.lift_snd _ _ _⟩
      refine ⟨z₀, fun l => ?_, fun z' hz' => ?_⟩
      · refine Limits.pullback.hom_ext (f := (W.obj l).hom) (g := h) ?_ ?_
        · calc (z₀ ≫ π l) ≫ Limits.pullback.fst (W.obj l).hom h
