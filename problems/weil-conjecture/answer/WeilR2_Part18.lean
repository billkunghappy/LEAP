    wc_et_geom_strict_henselization y
  have hsh₁ : wcHalShData y B₁ Λ₁ W₁ φ₁ a₁ := ⟨hI, haff, hcomp, hφa, hlim, e₁, hint, heq⟩

  have hresG : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
