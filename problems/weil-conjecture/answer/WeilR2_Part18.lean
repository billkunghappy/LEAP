    first
      | exact ⟨fun {_ _ _ _} => rfl⟩
      | (haveI := adj.rightAdjoint_preservesLimits
         exact Functor.additive_of_preserves_binary_products _)
  haveI : Li.Additive := Adjunction.left_adjoint_additive adj
  let ev : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⥤ AddCommGrpCat.{u+1} :=
    sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
      (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op W)
  let evZ : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1} ⥤ AddCommGrpCat.{u+1} :=
    sheafToPresheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1} ⋙
      (evaluation Z.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op ((wcProEtBC i).obj W))
  haveI : ev.Additive := by
    first
      | infer_instance
      | exact Functor.additive_of_preserves_binary_products _
  haveI : evZ.Additive := by
    first
      | infer_instance
      | exact Functor.additive_of_preserves_binary_products _
  let PgHC := Pg.mapHomologicalComplex (ComplexShape.up ℤ)
  let LiHC := Li.mapHomologicalComplex (ComplexShape.up ℤ)
  let evHC := ev.mapHomologicalComplex (ComplexShape.up ℤ)
  let evZHC := evZ.mapHomologicalComplex (ComplexShape.up ℤ)

  haveI hexA : HasExactColimitsOfShape ℕ AddCommGrpCat.{u+1} :=
    @HasExactColimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1} _ _ _ _ _
      (ULiftHomULiftCategory.equiv.{u+1, u+1} ℕ).symm _ (AB5OfSize.ofShape _)
  haveI hexE : HasExactColimitsOfShape ℕ (Sheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _ (Scheme.ProEt.topology E) _ _ _
      hexA
  haveI hexZ : HasExactColimitsOfShape ℕ (Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) :=
    @Sheaf.hasExactColimitsOfShape _ AddCommGrpCat.{u+1} ℕ _ _ _ (Scheme.ProEt.topology Z) _ _ _
      hexA
  haveI : RepresentablyFlat (wcProEtBC i) := (wc_proet_pullback_continuous_flat i).2
  haveI : RepresentablyFlat (wcProEtBC g) := (wc_proet_pullback_continuous_flat g).2
  haveI : Limits.PreservesFiniteLimits Li :=
    wc_sheafPullback_preservesFiniteLimits_of_flat _ _ (wcProEtBC i)
  haveI : Limits.PreservesColimitsOfSize.{0, 0} Li := adj.leftAdjoint_preservesColimits
  haveI : Limits.PreservesFiniteColimits Li := by
    haveI := adj.leftAdjoint_preservesColimits
    infer_instance
  haveI : Li.PreservesHomology := Functor.preservesHomologyOfExact Li
  let adjg := (wcProEtBC g).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology E)
  haveI : Limits.PreservesFiniteLimits ((wcProEtBC g).sheafPullback AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology E)) :=
    wc_sheafPullback_preservesFiniteLimits_of_flat _ _ (wcProEtBC g)
  have hPgInj : ∀ X, Injective X → Injective (Pg.obj X) := fun X _ =>
    Injective.injective_of_adjoint adjg X

  let M₀ := wcIntSheaf E ℓ
  let sℓ : M₀ ⟶ M₀ := wcIntScalar E ℓ (ℓ : ℤ_[ℓ])
  let I₀ := InjectiveResolution.of M₀
  have hι'mono : ∀ k, Mono (I₀.ι'.f k) := by
    intro k
    by_cases hk : k = 0
    · subst hk
      rw [InjectiveResolution.ι'_f_zero]
      haveI h0 : Mono (I₀.ι.f 0) := inferInstance
      exact @mono_comp _ _ _ _ _ _ inferInstance _ (@mono_comp _ _ _ _ _ _ h0 _ inferInstance)
    · exact ⟨fun g' h' _ =>
        (HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 M₀ k hk).eq_of_tgt g' h'⟩
  obtain ⟨f₀, ⟨Hf₀⟩⟩ := wc_ltp_kinj_factor 0 (inferInstance : I₀.cochainComplex.IsStrictlyGE 0)
    (fun k => inferInstance) I₀.ι' ((CochainComplex.singleFunctor _ 0).map sℓ ≫ I₀.ι')
    inferInstance
  obtain ⟨f, hf⟩ := wc_ltp_strictify_homotopy I₀.ι' hι'mono (fun k => inferInstance) _ f₀ Hf₀
  let G₀ := Functor.ofSequence (X := fun _ : ℕ => wcIntSheaf E ℓ)
    (fun _ => wcIntScalar E ℓ (ℓ : ℤ_[ℓ]))
  obtain ⟨κ, ⟨hκ⟩, -⟩ := wc_ladic_tower_colimit E ℓ
  let 𝕀 : ℕ ⥤ CochainComplex (Sheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1}) ℤ :=
    Functor.ofSequence (X := fun _ : ℕ => I₀.cochainComplex) (fun _ => f)
  let s := Limits.colimit.cocone 𝕀
  have hs : ∀ k, Limits.IsColimit
      ((HomologicalComplex.eval _ (ComplexShape.up ℤ) k).mapCocone s) := fun k =>
    Limits.isColimitOfPreserves _ (Limits.colimit.isColimit 𝕀)
  let α : G₀ ⋙ CochainComplex.singleFunctor _ 0 ⟶ 𝕀 :=
    NatTrans.ofSequence (fun _ => I₀.ι') (fun n => by
      simp only [Functor.comp_map, G₀, 𝕀, Functor.ofSequence_map_homOfLE_succ]
      exact hf.symm)
  let hκ' := Limits.isColimitOfPreserves (CochainComplex.singleFunctor
    (Sheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1}) 0) hκ
  have hcF : ∀ k, Limits.IsColimit ((HomologicalComplex.eval _ (ComplexShape.up ℤ) k).mapCocone
      ((CochainComplex.singleFunctor _ 0).mapCocone (Limits.Cocone.mk _ κ))) := fun k =>
    Limits.isColimitOfPreserves _ hκ'
  let ε' := hκ'.desc (Limits.Cocone.mk s.pt (α ≫ s.ι))
  have hε' : QuasiIso ε' :=
    wc_ltp_seq_colim_quasiIso α (fun n => (inferInstance : QuasiIso I₀.ι'))
      ((CochainComplex.singleFunctor _ 0).mapCocone (Limits.Cocone.mk _ κ)) s hcF hs ε'
      (fun n => hκ'.fac _ n)
  obtain ⟨χ, ⟨Hχ⟩⟩ := wc_ltp_kinj_factor 0 (inferInstance : I.cochainComplex.IsStrictlyGE 0)
    (fun k => inferInstance) ε' I.ι' hε'
  have hχ : QuasiIso χ := by
    have h1 : QuasiIso (ε' ≫ χ) := by
      rw [quasiIso_iff]
      intro q
      rw [quasiIsoAt_iff_isIso_homologyMap, Hχ.homologyMap_eq]
      have hI : QuasiIso I.ι' := inferInstance
      exact (quasiIsoAt_iff_isIso_homologyMap _ _).mp ((quasiIso_iff _).mp hI q)
    exact (quasiIso_iff_comp_left ε' χ).mp h1

  let T := Limits.colimit.cocone (𝕀 ⋙ PgHC)
  have hT : ∀ k, Limits.IsColimit
      ((HomologicalComplex.eval _ (ComplexShape.up ℤ) k).mapCocone T) := fun k =>
    Limits.isColimitOfPreserves _ (Limits.colimit.isColimit _)
  let θ : T.pt ⟶ K := (Limits.colimit.isColimit (𝕀 ⋙ PgHC)).desc (PgHC.mapCocone (s.extend χ))
  have hθleg : ∀ n, T.ι.app n ≫ θ = PgHC.map (s.ι.app n ≫ χ) := fun n =>
    (Limits.colimit.isColimit (𝕀 ⋙ PgHC)).fac _ n
  have hPaff : ∀ V : S.ProEt, IsAffine V.left → ∃ V' : E.ProEt, IsAffine V'.left ∧
      Nonempty (Pg ⋙ (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
        (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op V)) ≅
        (sheafToPresheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1} ⋙
          (evaluation E.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op V'))) := by
    intro V hV
    refine ⟨(wcProEtBC g).obj V, ?_, ⟨NatIso.ofComponents (fun _ => Iso.refl _) ?_⟩⟩
    · haveI : IsAffine V.left := hV
      haveI : IsAffineHom (Limits.pullback.fst V.hom g) :=
        MorphismProperty.of_isPullback (P := @IsAffineHom)
          (IsPullback.of_hasPullback V.hom g).flip inferInstance
      change IsAffine (Limits.pullback V.hom g)
      exact @isAffine_of_isAffineHom _ _ (Limits.pullback.fst V.hom g) this hV
    · intro X Y φ
      first
        | rfl
        | (simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]; done)
        | (simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]; rfl)
  have hθ : QuasiIso θ :=
    wc_ltp_qiso_of_affine_sections_colim Pg hPaff 𝕀 0
      (fun n => (inferInstance : I₀.cochainComplex.IsStrictlyGE 0))
      (fun n m => (inferInstance : Injective (I₀.cochainComplex.X m))) s hs I.cochainComplex
      inferInstance (fun m => inferInstance) χ hχ T hT θ hθleg

  let K₀ := PgHC.obj I₀.cochainComplex
  haveI hLK₀ : CochainComplex.IsStrictlyGE (LiHC.obj K₀) 0 :=
    (CochainComplex.isStrictlyGE_iff _ _).mpr (fun k hk =>
      Li.map_isZero (Pg.map_isZero (I₀.cochainComplex.isZero_of_isStrictlyGE 0 k hk)))
  obtain ⟨J₀, j₀, hj₀m, hqj₀, hinj, hJ₀ge⟩ :=
    CochainComplex.Plus.modelCategoryQuillen.exists_mono_quasiIso_injective (LiHC.obj K₀) (-1) 0
  haveI := hj₀m
  haveI := hqj₀
  haveI := hJ₀ge
  have hj₀f : ∀ k, Mono (j₀.f k) := fun k => inferInstance
  obtain ⟨t₀, ⟨Ht₀⟩⟩ := wc_ltp_kinj_factor (-1) hJ₀ge hinj j₀ (LiHC.map (PgHC.map f) ≫ j₀) hqj₀
  obtain ⟨t, ht⟩ := wc_ltp_strictify_homotopy j₀ hj₀f hinj _ t₀ Ht₀
  let 𝕁 := Functor.ofSequence (X := fun _ : ℕ => J₀) (fun _ => t)
  let R := Limits.colimit.cocone 𝕁
  have hR : ∀ k, Limits.IsColimit
      ((HomologicalComplex.eval _ (ComplexShape.up ℤ) k).mapCocone R) := fun k =>
    Limits.isColimitOfPreserves _ (Limits.colimit.isColimit 𝕁)
  let β : (𝕀 ⋙ PgHC) ⋙ LiHC ⟶ 𝕁 :=
    NatTrans.ofSequence (fun _ => j₀) (fun n => by
      simp only [Functor.comp_map, 𝕀, 𝕁, Functor.ofSequence_map_homOfLE_succ]
      exact ht.symm)
  have hLT : ∀ k, Limits.IsColimit
      ((HomologicalComplex.eval _ (ComplexShape.up ℤ) k).mapCocone (LiHC.mapCocone T)) := fun k =>
    Limits.isColimitOfPreserves Li (hT k)
  let hLTc := HomologicalComplex.isColimitOfEval _ _ hLT
  let ψ := hLTc.desc (Limits.Cocone.mk R.pt (β ≫ R.ι))
  have hψleg : ∀ n, LiHC.map (T.ι.app n) ≫ ψ = j₀ ≫ R.ι.app n := fun n => hLTc.fac _ n
  have hψ : QuasiIso ψ :=
    wc_ltp_seq_colim_quasiIso β (fun n => hqj₀) (LiHC.mapCocone T) R hLT hR ψ
      (fun n => hLTc.fac _ n)
  obtain ⟨u', ⟨Hu⟩⟩ := wc_ltp_kinj_factor m₀ hJ hJi ψ (LiHC.map θ ≫ j) hψ
  haveI := hθ
  haveI := hj
  haveI := hψ
  haveI hLθ : QuasiIso (LiHC.map θ) := HomologicalComplex.quasiIso_map_of_preservesHomology θ Li
  haveI : QuasiIso (LiHC.map θ ≫ j) := quasiIso_comp _ _
  have hu' : QuasiIso u' := by
    have h1 : QuasiIso (ψ ≫ u') := by
      rw [quasiIso_iff]
      intro q
      rw [quasiIsoAt_iff_isIso_homologyMap, Hu.homologyMap_eq]
      have hI : QuasiIso (LiHC.map θ ≫ j) := inferInstance
      exact (quasiIsoAt_iff_isIso_homologyMap _ _).mp ((quasiIso_iff _).mp hI q)
    exact (quasiIso_iff_comp_left ψ u').mp h1

  let σ : ev ⟶ Li ⋙ evZ := Functor.whiskerRight adj.unit ev
  let σHC := NatTrans.mapHomologicalComplex σ (ComplexShape.up ℤ)
  let w₀ : evHC.obj K₀ ⟶ evZHC.obj J₀ := σHC.app K₀ ≫ evZHC.map j₀
  have hw₀ : QuasiIso w₀ := h I₀ J₀ (-1) hJ₀ge hinj j₀ hqj₀ w₀ (fun m x => rfl)
  have hcomp : w₀ ≫ evZHC.map t = evHC.map (PgHC.map f) ≫ w₀ := by
    ext m x
    have e1 := congrArg (fun φ => (φ.hom.app (Opposite.op W)).hom x)
      (adj.unit_naturality ((PgHC.map f).f m))
    have e2 := congrArg (fun φ => ((HomologicalComplex.Hom.f φ m).hom.app
      (Opposite.op ((wcProEtBC i).obj W))).hom
      (((adj.unit.app (K₀.X m)).hom.app (Opposite.op W)).hom x)) ht
    exact e2.trans (congrArg (fun y => ((j₀.f m).hom.app
      (Opposite.op ((wcProEtBC i).obj W))).hom y) e1)
  have hevT : ∀ k, Limits.IsColimit
      ((HomologicalComplex.eval _ (ComplexShape.up ℤ) k).mapCocone (evHC.mapCocone T)) := fun k =>
    (wc_ltp_sections_seq_colimit W _ _ (hT k)).some
  have hevR : ∀ k, Limits.IsColimit
      ((HomologicalComplex.eval _ (ComplexShape.up ℤ) k).mapCocone (evZHC.mapCocone R)) := fun k =>
    (wc_ltp_sections_seq_colimit ((wcProEtBC i).obj W) _ _ (hR k)).some
  let hevTc := HomologicalComplex.isColimitOfEval _ _ hevT
  let γ : (𝕀 ⋙ PgHC) ⋙ evHC ⟶ 𝕁 ⋙ evZHC :=
    NatTrans.ofSequence (fun _ => w₀) (fun n => by
      simp only [Functor.comp_map, 𝕀, 𝕁, Functor.ofSequence_map_homOfLE_succ]
      exact hcomp.symm)
  let Ω := hevTc.desc (Limits.Cocone.mk (evZHC.mapCocone R).pt (γ ≫ (evZHC.mapCocone R).ι))
  have hΩ : QuasiIso Ω :=
    wc_ltp_seq_colim_quasiIso γ (fun n => hw₀) (evHC.mapCocone T) (evZHC.mapCocone R) hevT hevR Ω
      (fun n => hevTc.fac _ n)
  have hΩ' : Ω = σHC.app T.pt ≫ evZHC.map ψ := by
    apply hevTc.hom_ext
    intro n
    refine (hevTc.fac (Limits.Cocone.mk (evZHC.mapCocone R).pt (γ ≫ (evZHC.mapCocone R).ι))
      n).trans ?_
    ext m x
    have e1 := congrArg (fun φ => (φ.hom.app (Opposite.op W)).hom x)
      (adj.unit_naturality ((T.ι.app n).f m))
    have e2 := congrArg (fun φ => ((HomologicalComplex.Hom.f φ m).hom.app
      (Opposite.op ((wcProEtBC i).obj W))).hom
      (((adj.unit.app (K₀.X m)).hom.app (Opposite.op W)).hom x)) (hψleg n)
    exact ((congrArg (fun y => ((ψ.f m).hom.app
      (Opposite.op ((wcProEtBC i).obj W))).hom y) e1).symm.trans e2).symm

  haveI hTge : CochainComplex.IsStrictlyGE T.pt 0 := (CochainComplex.isStrictlyGE_iff _ _).mpr (fun k hk => by
    rw [Limits.IsZero.iff_id_eq_zero]
    apply (hT k).hom_ext
    intro n
    exact (Pg.map_isZero (I₀.cochainComplex.isZero_of_isStrictlyGE 0 k hk)).eq_of_src _ _)
  haveI hKge : CochainComplex.IsStrictlyGE K 0 := (CochainComplex.isStrictlyGE_iff _ _).mpr (fun k hk =>
    Pg.map_isZero (I.cochainComplex.isZero_of_isStrictlyGE 0 k hk))
  have hb : QuasiIso (evHC.map θ) :=
    wc_ltp_sections_qiso_of_acyclic W θ 0 0 hTge hKge
      (fun m k x => proet_ext_colimit_injectives_vanish S W _
        (fun n => hPgInj (I₀.cochainComplex.X m) inferInstance) _ (hT m) k x)
      (fun m k x => by
        haveI : Injective (K.X m) := hPgInj (I.cochainComplex.X m) inferInstance
        exact Abelian.Ext.eq_zero_of_injective x) hθ
  haveI hRge : CochainComplex.IsStrictlyGE R.pt (-1) := (CochainComplex.isStrictlyGE_iff _ _).mpr (fun k hk => by
    rw [Limits.IsZero.iff_id_eq_zero]
    apply (hR k).hom_ext
    intro n
    exact (J₀.isZero_of_isStrictlyGE (-1) k hk).eq_of_src _ _)
  have hc : QuasiIso (evZHC.map u') :=
    wc_ltp_sections_qiso_of_acyclic ((wcProEtBC i).obj W) u' (-1) m₀ hRge hJ
      (fun m k x => proet_ext_colimit_injectives_vanish Z ((wcProEtBC i).obj W) _
        (fun n => hinj m) _ (hR m) k x)
      (fun m k x => by
        haveI := hJi m
        exact Abelian.Ext.eq_zero_of_injective x) hu'
  have hwσ : evHC.map θ ≫ w = σHC.app T.pt ≫ evZHC.map (LiHC.map θ ≫ j) := by
    ext m x
    have e1 := congrArg (fun φ => (φ.hom.app (Opposite.op W)).hom x)
      (adj.unit_naturality (θ.f m))
    exact (hw m (((θ.f m).hom.app (Opposite.op W)).hom x)).trans
      (congrArg (fun y => ((j.f m).hom.app (Opposite.op ((wcProEtBC i).obj W))).hom y) e1.symm)
  have hd : QuasiIso (σHC.app T.pt ≫ evZHC.map (LiHC.map θ ≫ j)) := by
    have H' : Homotopy (σHC.app T.pt ≫ evZHC.map (ψ ≫ u'))
        (σHC.app T.pt ≫ evZHC.map (LiHC.map θ ≫ j)) :=
      (evZ.mapHomotopy Hu).compLeft (σHC.app T.pt)
    have h1 : σHC.app T.pt ≫ evZHC.map (ψ ≫ u') = Ω ≫ evZHC.map u' := by
      rw [hΩ', Functor.map_comp, Category.assoc]
    haveI := hΩ
    haveI := hc
    haveI : QuasiIso (Ω ≫ evZHC.map u') := quasiIso_comp _ _
    rw [quasiIso_iff]
    intro q
    rw [quasiIsoAt_iff_isIso_homologyMap, ← H'.homologyMap_eq, h1]
    have hI : QuasiIso (Ω ≫ evZHC.map u') := inferInstance
    exact (quasiIsoAt_iff_isIso_homologyMap _ _).mp ((quasiIso_iff _).mp hI q)
  haveI := hb
  have hfin : QuasiIso (evHC.map θ ≫ w) := by
    rw [hwσ]
    exact hd
  exact (quasiIso_iff_comp_left (evHC.map θ) w).mp hfin

theorem wc_ltp_closed_thick_units {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (U : Z.ProEt) :
    letI := Di.cont
    Sieve.generate (fun (T : Z.ProEt) (_ : T ⟶ U) =>
        ∃ (Vt : Y.ProEt) (_ : (wcProEtBC i).obj Vt ≅ T),
          (∀ M : SheafOfModules.{u+1} (wcRingSheaf Y ℓ),
            Function.Bijective ((Di.adj.unit.app M).val.app (Opposite.op Vt)).hom) ∧
          (∀ G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1},
            Function.Bijective ((((wcProEtBC i).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
              (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z)).unit.app G).hom.app
                (Opposite.op Vt)).hom))
      ∈ Scheme.ProEt.topology Z U :=
by
  classical
  letI := Di.cont

  have hAb : ∀ (Vt : Y.ProEt) (G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}),
      Function.Bijective (⇑((toSheafify (Scheme.ProEt.topology Z)
          ((wcProEtBaseChange i).op.lan.obj G.obj)).app
            (Opposite.op ((wcProEtBaseChange i).obj Vt))).hom ∘
        ⇑(((wcProEtBaseChange i).op.lanUnit.app G.obj).app (Opposite.op Vt)).hom) →
      Function.Bijective ((((wcProEtBC i).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z)).unit.app G).hom.app
          (Opposite.op Vt)).hom := by
    intro Vt G h
    have hTS : ∀ H : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1},
        IsIso (toSheafify (Scheme.ProEt.topology Y) ((wcProEtBaseChange i).op ⋙ H.obj)) :=
      fun H => isIso_toSheafify _ (Functor.op_comp_isSheaf (wcProEtBC i) _ _ H)
    let ρ : (wcProEtBC i).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z) ≅ wcProEtPush i :=
      NatIso.ofComponents (fun H =>
        (fullyFaithfulSheafToPresheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).preimageIso
          (@asIso _ _ _ _ (toSheafify (Scheme.ProEt.topology Y) ((wcProEtBaseChange i).op ⋙ H.obj))
            (hTS H)))
        (fun {H H'} f => by
          apply Sheaf.hom_ext
          exact toSheafify_naturality (Scheme.ProEt.topology Y)
            (Functor.whiskerLeft (wcProEtBaseChange i).op f.hom))
    let adj := (wcProEtBC i).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z)
    let adj' := adj.ofNatIsoRight ρ
    have h' := wc_proet_closed_unit_bij_of_lan i _ adj' Vt G h
    have huniq := Adjunction.unit_rightAdjointUniq_hom_app adj adj' G
    have hs : Function.Bijective (((adj.rightAdjointUniq adj').hom.app
        (((wcProEtBC i).sheafPullback AddCommGrpCat.{u+1} (Scheme.ProEt.topology Y)
          (Scheme.ProEt.topology Z)).obj G)).hom.app (Opposite.op Vt)).hom :=
      ConcreteCategory.bijective_of_isIso
        (((sheafToPresheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).mapIso
          ((adj.rightAdjointUniq adj').app
            (((wcProEtBC i).sheafPullback AddCommGrpCat.{u+1} (Scheme.ProEt.topology Y)
              (Scheme.ProEt.topology Z)).obj G))).app (Opposite.op Vt)).hom
    have e1 : ⇑((adj'.unit.app G).hom.app (Opposite.op Vt)).hom =
        ⇑(((adj.rightAdjointUniq adj').hom.app
          (((wcProEtBC i).sheafPullback AddCommGrpCat.{u+1} (Scheme.ProEt.topology Y)
            (Scheme.ProEt.topology Z)).obj G)).hom.app (Opposite.op Vt)).hom ∘
        ⇑((adj.unit.app G).hom.app (Opposite.op Vt)).hom := by
      funext x
      exact (congrArg (fun m => (m.hom.app (Opposite.op Vt)).hom x) huniq).symm
    rw [e1] at h'
    exact (Function.Bijective.of_comp_iff' hs _).mp h'

  refine (Scheme.ProEt.topology Z).superset_covering (Sieve.generate_mono ?_)
    (wc_proet_wcontr_affine_open_cover i U)
  rintro T f ⟨⟨O, hO, hTO⟩, hT⟩
  obtain ⟨A, iA, I, iI, Vt, e, c, κ, hsq, hV, hiV⟩ :=
    wc_proet_henselian_thickening_exists i T O hO hTO hT
  have hinit : ∀ V : Y.ProEt,
      Function.Bijective (fun a : Vt ⟶ V => (wcProEtBaseChange i).map a) := by
    intro V
    refine wc_proet_thickening_bc_hom_bijective i A I Vt e c hsq ?_ V
    intro X S g _ a b hab
    exact wc_weaklyEtale_henselian_lift g A I a b hab
  have hlan : ∀ G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1},
      Function.Bijective (⇑((toSheafify (Scheme.ProEt.topology Z)
          ((wcProEtBaseChange i).op.lan.obj G.obj)).app
            (Opposite.op ((wcProEtBaseChange i).obj Vt))).hom ∘
        ⇑(((wcProEtBaseChange i).op.lanUnit.app G.obj).app (Opposite.op Vt)).hom) := by
    intro G
    refine Function.Bijective.comp ?_ (wc_proet_lan_unit_bijective_of_init i Vt hinit G.obj)
    apply wc_proet_toSheafify_bijective_wcontr Z _ _ hiV
    intro m Q ι hι hpart
    obtain ⟨Vk, ιt, κk, hιt, hpt, hκ, hthick⟩ :=
      wc_proet_thickening_clopen_lift i A I Vt e c hsq m Q ι hι hpart
    refine wc_proet_lan_clopen_additive i Vt G m Q ι Vk ιt κk hιt hpt hκ
      (wc_proet_lan_unit_bijective_of_init i Vt hinit G.obj) (fun k => ?_)
    obtain ⟨Ak, iAk, Ik, iIk, ek, ck, hsqk⟩ := hthick k
    refine wc_proet_lan_unit_bijective_of_init i (Vk k) (fun V => ?_) G.obj
    refine wc_proet_thickening_bc_hom_bijective i Ak Ik (Vk k) ek ck hsqk ?_ V
    intro X S g _ a b hab
    exact wc_weaklyEtale_henselian_lift g Ak Ik a b hab
  exact ⟨Vt, κ, fun M => wc_hm_pull_unit_bij_of_lan i ℓ Di hDi Vt M
      (hlan ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).obj M)),
    fun G => hAb Vt G (hlan G)⟩

theorem wc_ltp_mate_iso_of_cover {Y Z : Scheme.{u}} (i : Z ⟶ Y) (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Di : wcHMPullData i ℓ) :
    letI := Di.cont
    let Li := (wcProEtBC i).sheafPullback AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z)
    let adj := (wcProEtBC i).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z)
    (∀ U : Z.ProEt, Sieve.generate (fun (T : Z.ProEt) (_ : T ⟶ U) =>
        ∃ (Vt : Y.ProEt) (_ : (wcProEtBC i).obj Vt ≅ T),
          (∀ M : SheafOfModules.{u+1} (wcRingSheaf Y ℓ),
            Function.Bijective ((Di.adj.unit.app M).val.app (Opposite.op Vt)).hom) ∧
          (∀ G : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1},
            Function.Bijective ((adj.unit.app G).hom.app (Opposite.op Vt)).hom))
      ∈ Scheme.ProEt.topology Z U) →
    ∃ β : SheafOfModules.toSheaf (wcRingSheaf Y ℓ) ⋙ Li ⟶
        Di.Φ ⋙ SheafOfModules.toSheaf (wcRingSheaf Z ℓ),
      (∀ M, IsIso (β.app M)) ∧
      ∀ (M : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (V : Y.ProEt)
        (x : M.val.obj (Opposite.op V)),
        ((β.app M).hom.app (Opposite.op ((wcProEtBC i).obj V))).hom
            (((adj.unit.app ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).obj M)).hom.app
              (Opposite.op V)).hom x) =
          ((Di.adj.unit.app M).val.app (Opposite.op V)).hom x :=
by
  intro Li adj hcov
  letI := Di.cont
  let TY := SheafOfModules.toSheaf.{u+1} (wcRingSheaf Y ℓ)
  let TZ := SheafOfModules.toSheaf.{u+1} (wcRingSheaf Z ℓ)
  let Pi := (wcProEtBC i).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology Y) (Scheme.ProEt.topology Z)
  let Q := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ

  let α : TwoSquare Q TZ TY Pi := TwoSquare.mk _ _ _ _ (𝟙 (TZ ⋙ Pi))

  let β : TY ⋙ Li ⟶ Di.Φ ⋙ TZ := ((mateEquiv Di.adj adj).symm α).natTrans
  have hE : ∀ M : SheafOfModules.{u+1} (wcRingSheaf Y ℓ),
      TY.map (Di.adj.unit.app M) = adj.unit.app (TY.obj M) ≫ Pi.map (β.app M) := by
    intro M
    have h := unit_mateEquiv_symm Di.adj adj α M
    exact (Category.comp_id _).symm.trans h
  have hβ : ∀ (M : SheafOfModules.{u+1} (wcRingSheaf Y ℓ)) (V : Y.ProEt)
      (x : M.val.obj (Opposite.op V)),
      ((β.app M).hom.app (Opposite.op ((wcProEtBC i).obj V))).hom
          (((adj.unit.app (TY.obj M)).hom.app (Opposite.op V)).hom x) =
        ((Di.adj.unit.app M).val.app (Opposite.op V)).hom x := by
    intro M V x
    have h := congrArg (fun f => (f.hom.app (Opposite.op V)).hom x) (hE M)
    exact h.symm

  have key : ∀ {A B : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}} (γ : A ⟶ B),
      (∀ U : Z.ProEt, Sieve.generate (fun (T : Z.ProEt) (_ : T ⟶ U) =>
        Function.Bijective (γ.hom.app (Opposite.op T)).hom) ∈ Scheme.ProEt.topology Z U) →
      IsIso γ := by
    intro A B γ hγ
    have hinj : Presheaf.IsLocallyInjective (Scheme.ProEt.topology Z) γ.hom := by
      apply Presheaf.IsLocallyInjective.mk
      intro X x y hxy
      refine (Scheme.ProEt.topology Z).superset_covering ?_ (hγ X.unop)
      rw [Sieve.generate_le_iff]
      intro T g hg
      rw [Presheaf.equalizerSieve_apply]
      have e : ∀ z : A.obj.obj X, (γ.hom.app (Opposite.op T)).hom ((A.obj.map g.op).hom z) =
          (B.obj.map g.op).hom ((γ.hom.app X).hom z) := fun z =>
        congrArg (fun m => m.hom z) (γ.hom.naturality g.op)
      apply hg.injective
      exact (e x).trans ((congrArg (B.obj.map g.op).hom hxy).trans (e y).symm)
    have hsurj : Presheaf.IsLocallySurjective (Scheme.ProEt.topology Z) γ.hom := by
      apply Presheaf.IsLocallySurjective.mk
      intro U s
      refine (Scheme.ProEt.topology Z).superset_covering ?_ (hγ U)
      rw [Sieve.generate_le_iff]
      intro T g hg
      rw [Presheaf.imageSieve_apply]
      obtain ⟨t, ht⟩ := hg.2 ((B.obj.map g.op).hom s)
      exact ⟨t, ht⟩
    exact (Sheaf.isLocallyBijective_iff_isIso γ).mp ⟨hinj, hsurj⟩

  have transport : ∀ {F G : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}} (H : F ⟶ G)
      {T₁ T₂ : Z.ProEt} (φ : T₁ ≅ T₂),
      Function.Bijective (H.hom.app (Opposite.op T₁)).hom →
        Function.Bijective (H.hom.app (Opposite.op T₂)).hom := by
    intro F G H T₁ T₂ φ h
    have e1 : H.hom.app (Opposite.op T₂) =
        F.obj.map φ.hom.op ≫ H.hom.app (Opposite.op T₁) ≫ G.obj.map φ.inv.op := by
      rw [← Category.assoc, H.hom.naturality, Category.assoc, ← G.obj.map_comp, ← op_comp,
        φ.inv_hom_id, op_id, G.obj.map_id, Category.comp_id]
    have hF : Function.Bijective (F.obj.map φ.hom.op).hom :=
      ConcreteCategory.bijective_of_isIso (F.obj.map φ.hom.op)
    have hG : Function.Bijective (G.obj.map φ.inv.op).hom :=
      ConcreteCategory.bijective_of_isIso (G.obj.map φ.inv.op)
    rw [e1, AddCommGrpCat.hom_comp, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
      AddMonoidHom.coe_comp]
    exact (hG.comp h).comp hF
  have hiso : ∀ M : SheafOfModules.{u+1} (wcRingSheaf Y ℓ), IsIso (β.app M) := by
    intro M
    apply key
    intro U
    refine GrothendieckTopology.superset_covering _ ?_ (hcov U)
    rw [Sieve.generate_le_iff]
    rintro T t ⟨Vt, e, hM, hG⟩
    apply Sieve.le_generate
    apply transport (β.app M) e
    have hg := hG (TY.obj M)
    have hh := hM M
    have hfg : (⇑((β.app M).hom.app (Opposite.op ((wcProEtBC i).obj Vt))).hom) ∘
        (⇑((adj.unit.app (TY.obj M)).hom.app (Opposite.op Vt)).hom) =
        ⇑((Di.adj.unit.app M).val.app (Opposite.op Vt)).hom := funext (fun x => hβ M Vt x)
    have hcomp : Function.Bijective
        ((⇑((β.app M).hom.app (Opposite.op ((wcProEtBC i).obj Vt))).hom) ∘
          (⇑((adj.unit.app (TY.obj M)).hom.app (Opposite.op Vt)).hom)) := by
      rw [hfg]; exact hh
    exact (Function.Bijective.of_comp_iff _ hg).mp hcomp
  exact ⟨β, hiso, hβ⟩

theorem wc_ltp_ladic_module_of_ab {S Z E : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    (g : E ⟶ S) [IsAffineHom g] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (W : S.ProEt)
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf E ℓ)))
    (hab : wcAbPBCAt i g W Di.cont Dg.cont (wcLadicSheaf E ℓ)) :
    haveI := Dg.additive
    haveI := Di.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dg.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    ∀ (J : CochainComplex (SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) ℤ) (m₀ : ℤ),
      J.IsStrictlyGE m₀ → (∀ m, Injective (J.X m)) →
      ∀ (j : (Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K ⟶ J), QuasiIso j →
      ∀ (w : ((wcSecEv S ℓ W).mapHomologicalComplex (ComplexShape.up ℤ)).obj K ⟶
          ((wcSecEv Z ℓ ((wcProEtBC i).obj W)).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj J),
        (∀ (m : ℤ) (x : (K.X m).val.obj (Opposite.op W)),
          (w.f m).hom x =
            ((j.f m).val.app (Opposite.op ((wcProEtBC i).obj W))).hom
              (((Di.adj.unit.app (K.X m)).val.app (Opposite.op W)).hom x)) →
        QuasiIso w :=
by
  intro P K J m₀ hJ hJi j hj w hw
  letI := Di.cont
  letI := Dg.cont
  haveI := Dg.additive
  haveI := Di.additive

  have hunit : ∀ (X : Scheme.{u}) (V : (X.ProEt)ᵒᵖ) (k : ℕ), k ≠ 0 →
      IsUnit (k : ↑((wcRingSheaf X ℓ).obj.obj V)) := by
    intro X V k hk
    have hk' : (k : ℚ_[ℓ]) ≠ 0 := Nat.cast_ne_zero.mpr hk
    change IsUnit (k : C(↥((Opposite.unop V).left), ULift.{u+1} ℚ_[ℓ]))
    refine isUnit_iff_exists_inv.mpr ⟨ContinuousMap.const _ (ULift.up ((k : ℚ_[ℓ])⁻¹)), ?_⟩
    refine ContinuousMap.ext fun t => ULift.ext _ _ ?_
    simp [hk']
  have injT : ∀ (X : Scheme.{u}) (N : SheafOfModules.{u+1} (wcRingSheaf X ℓ)), Injective N →
      Injective ((SheafOfModules.toSheaf.{u+1} (wcRingSheaf X ℓ)).obj N) := by
    intro X N hN
    obtain ⟨L, adjL, -, hLL, -⟩ := sheafOfModules_toSheaf_exact_left_adjoint
      (Scheme.ProEt.topology X) (wcRingSheaf X ℓ) (hunit X)
    haveI := hLL
    exact adjL.map_injective N hN
  haveI hcolE := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology E) (wcRingSheaf E ℓ)
  haveI hcolZ := sheafOfModules_toSheaf_preservesFiniteColimits
    (Scheme.ProEt.topology Z) (wcRingSheaf Z ℓ)
  let TS := SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ)
  let TZ := SheafOfModules.toSheaf.{u+1} (wcRingSheaf Z ℓ)
  let TE := SheafOfModules.toSheaf.{u+1} (wcRingSheaf E ℓ)
  let Pg := (wcProEtBC g).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology E)
  let Li := (wcProEtBC i).sheafPullback AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z)
  let adj := (wcProEtBC i).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z)
  haveI : Pg.Additive := ⟨fun {_ _ _ _} => rfl⟩
  let Pi := (wcProEtBC i).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z)
  haveI : Pi.Additive := ⟨fun {_ _ _ _} => rfl⟩
  haveI : Li.Additive := Adjunction.left_adjoint_additive adj

  obtain ⟨-, ιQ, -⟩ := wc_proet_int_unit_isos E ℓ
  obtain ⟨IA, θ, -⟩ := wc_pltr_exact_injres TE (injT E) _ (wcLadicSheaf E ℓ) ιQ I

  let Θ : (TS.mapHomologicalComplex (ComplexShape.up ℤ)).obj K ≅
      (Pg.mapHomologicalComplex (ComplexShape.up ℤ)).obj IA.cochainComplex :=
    (Pg.mapHomologicalComplex (ComplexShape.up ℤ)).mapIso θ

  obtain ⟨β, hβiso, hβ⟩ := wc_ltp_mate_iso_of_cover i ℓ Di
    (fun U => wc_ltp_closed_thick_units i ℓ Di hDi U)
  let βK : (Li.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((TS.mapHomologicalComplex (ComplexShape.up ℤ)).obj K) ⟶
      (TZ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K) :=
    { f := fun m => β.app (K.X m)
      comm' := fun m n _ => (β.naturality (K.d m n)).symm }
  haveI : ∀ m, IsIso (βK.f m) := fun m => hβiso (K.X m)
  haveI : IsIso βK := HomologicalComplex.Hom.isIso_of_components βK

  let JA : CochainComplex (Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) ℤ :=
    (TZ.mapHomologicalComplex (ComplexShape.up ℤ)).obj J
  have hJA : JA.IsStrictlyGE m₀ := by
    rw [CochainComplex.isStrictlyGE_iff]
    intro k hk
    exact TZ.map_isZero ((CochainComplex.isStrictlyGE_iff J m₀).mp hJ k hk)
  have hJiA : ∀ m, Injective (JA.X m) := fun m => injT Z (J.X m) (hJi m)
  let jA := (Li.mapHomologicalComplex (ComplexShape.up ℤ)).map Θ.inv ≫ βK ≫
    (TZ.mapHomologicalComplex (ComplexShape.up ℤ)).map j
  haveI : QuasiIso ((Li.mapHomologicalComplex (ComplexShape.up ℤ)).map Θ.inv) :=
    quasiIso_of_isIso _
  haveI : QuasiIso βK := quasiIso_of_isIso _
  haveI : QuasiIso ((TZ.mapHomologicalComplex (ComplexShape.up ℤ)).map j) :=
    HomologicalComplex.quasiIso_map_of_preservesHomology j TZ
  haveI : QuasiIso (βK ≫ (TZ.mapHomologicalComplex (ComplexShape.up ℤ)).map j) :=
    quasiIso_comp _ _
  have hjA : QuasiIso jA := quasiIso_comp _ _
  let evW := sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
    (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op W)
  let evWZ := sheafToPresheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1} ⋙
    (evaluation Z.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op ((wcProEtBC i).obj W))
  let w' : (evW.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((TS.mapHomologicalComplex (ComplexShape.up ℤ)).obj K) ⟶
      (evWZ.mapHomologicalComplex (ComplexShape.up ℤ)).obj JA := w
  let wA := (evW.mapHomologicalComplex (ComplexShape.up ℤ)).map Θ.inv ≫ w'

  have hA : QuasiIso wA := by
    refine hab IA JA m₀ hJA hJiA jA hjA wA (fun m x => ?_)
    let y : (K.X m).val.obj (Opposite.op W) := ((Θ.inv.f m).hom.app (Opposite.op W)).hom x
    have e2 : ((Li.map (Θ.inv.f m)).hom.app (Opposite.op ((wcProEtBC i).obj W))).hom
        (((adj.unit.app (((Pg.mapHomologicalComplex (ComplexShape.up ℤ)).obj
          IA.cochainComplex).X m)).hom.app (Opposite.op W)).hom x) =
        ((adj.unit.app (TS.obj (K.X m))).hom.app (Opposite.op W)).hom y :=
      congrArg (fun f => (f.hom.app (Opposite.op W)).hom x) (adj.unit_naturality (Θ.inv.f m))
    have e3 := congrArg (fun z => ((j.f m).val.app (Opposite.op ((wcProEtBC i).obj W))).hom z)
      ((hβ (K.X m) W y).symm.trans (congrArg (fun z =>
        ((β.app (K.X m)).hom.app (Opposite.op ((wcProEtBC i).obj W))).hom z) e2.symm))
    exact (hw m y).trans e3
  haveI : QuasiIso ((evW.mapHomologicalComplex (ComplexShape.up ℤ)).map Θ.inv) :=
    quasiIso_of_isIso _
  have hw' : QuasiIso w' :=
    (quasiIso_iff_comp_left ((evW.mapHomologicalComplex (ComplexShape.up ℤ)).map Θ.inv) w').mp hA
  exact hw'

theorem wc_qmbt_tq_ladic_passage {S Z E : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    (g : E ⟶ S) [IsAffineHom g] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (W : S.ProEt)
    [CompactSpace W.left] [QuasiSeparatedSpace W.left]
    [CompactSpace ((wcProEtBC i).obj W).left] [QuasiSeparatedSpace ((wcProEtBC i).obj W).left]
    [CompactSpace ((wcProEtBC g).obj W).left] [QuasiSeparatedSpace ((wcProEtBC g).obj W).left]
    (htor : ∀ k : ℕ, 1 ≤ k → wcTorsionPBCAt i g (ℓ ^ k) W)
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf E ℓ))) :
    haveI := Dg.additive
    haveI := Di.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dg.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    ∀ (J : CochainComplex (SheafOfModules.{u+1} (wcRingSheaf Z ℓ)) ℤ) (m₀ : ℤ),
      J.IsStrictlyGE m₀ → (∀ m, Injective (J.X m)) →
      ∀ (j : (Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K ⟶ J), QuasiIso j →
      ∀ (w : ((wcSecEv S ℓ W).mapHomologicalComplex (ComplexShape.up ℤ)).obj K ⟶
          ((wcSecEv Z ℓ ((wcProEtBC i).obj W)).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj J),
        (∀ (m : ℤ) (x : (K.X m).val.obj (Opposite.op W)),
          (w.f m).hom x =
            ((j.f m).val.app (Opposite.op ((wcProEtBC i).obj W))).hom
              (((Di.adj.unit.app (K.X m)).val.app (Opposite.op W)).hom x)) →
        QuasiIso w :=
by

  have hZ : ∀ n : ℕ, wcAbPBCAt i g W Di.cont Dg.cont (wcContSheaf E (ZMod (ℓ ^ n))) := by
    intro n
    cases n with
    | zero =>
      rw [pow_zero]
      exact wc_ltp_zmod_one i g W Di.cont Dg.cont
    | succ k =>
      exact wc_ltp_ab_of_zmod i g W Di.cont Dg.cont (ℓ ^ (k + 1))
        (pow_pos (Fact.out : Nat.Prime ℓ).pos _) (htor (k + 1) (by omega))

  have hT := wc_ltp_products i g ℓ W Di.cont Dg.cont hZ

  obtain ⟨h1, h2, h3, h4, σ, hσ, hσ'⟩ := wc_padic_tower_facts ℓ
  obtain ⟨hz, hSE⟩ := wc_contSheaf_shortExact E (wcTowerIncl ℓ) h1 (wcTowerShift ℓ) h3 h2 h4
    ⟨σ, hσ, hσ'⟩
  have hZl : wcAbPBCAt i g W Di.cont Dg.cont (wcContSheaf E ℤ_[ℓ]) :=
    wc_ltp_two_of_three i g W Di.cont Dg.cont _ hSE hT hT

  have hQ := wc_ltp_rationalize i g ℓ W Di.cont Dg.cont hZl

  exact wc_ltp_ladic_module_of_ab i g ℓ W Dg hDg Di hDi I hQ

theorem wc_qmbt_pbc_thickening_qiso {A : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A]
    [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (hℓ : IsUnit ((ℓ : ℕ) : A)) {n : ℕ} (hn : Even n) (hn4 : 4 ≤ n) {π : A}
    {c : Matrix (Fin n) (Fin n) A}
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (hc : IsUnit (c + c.transpose).det)
    {x₀ : Spec (.of (wcQuadModelRing A n π c))}
    (hx₀ : ∀ p, Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X p) ∈
      PrimeSpectrum.asIdeal x₀)
    {B₀ : Type u} [CommRing B₀] [HenselianLocalRing B₀] [IsSepClosed (IsLocalRing.ResidueField B₀)]
    {Λ₀ : Type u} [SmallCategory Λ₀] [IsCofiltered Λ₀]
    {W₀ : Λ₀ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (wcQuadModelRing A n π c))) x₀))
      (Scheme.Etale.forget (Spec (.of (wcQuadModelRing A n π c))))}
    {φ₀ : ∀ l, Spec (.of B₀) ⟶ (W₀.obj l).right.left}
    {a₀ : Spec (.of B₀) ⟶ Spec (.of (wcQuadModelRing A n π c))}
    (hsh : wcHalShData x₀ B₀ Λ₀ W₀ φ₀ a₀)
    {L : Type u} [Field L] [IsSepClosed L] {φA : A →+* L} (hφA : Function.Injective φA)
    (halg : letI := φA.toAlgebra; Algebra.IsAlgebraic A L)
    {L' : Type u} [Field L'] [IsSepClosed L'] {ιL : L →+* L'}
    (hLalg : letI := ιL.toAlgebra; Algebra.IsAlgebraic L L')
    {Xs : Scheme.{u}} {ι : Xs ⟶ Spec (.of B₀)} {s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))}
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A n π c) (wcQmSp A))
    {A' : Type u} [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] [HenselianLocalRing A']
    [IsSepClosed (IsLocalRing.ResidueField A')] {ιA : A →+* A'} {π' : A'}
    (hℓ' : IsUnit ((ℓ : ℕ) : A')) (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    (hπ'2 : π' ^ 2 = ιA π) (hgen : ∀ a' : A', ∃ x y : A, a' = ιA x + ιA y * π')
    {φ' : A' →+* L'} (hφ' : Function.Injective φ') (hφ'A : φ'.comp ιA = ιL.comp φA)
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    {bl : Xm ⟶ Limits.pullback (a₀ ≫ wcQuadModelStr A n π c) (Spec.map (CommRingCat.ofHom ιA))}
    (hbl : wcCsdIsBlowup (Scheme.IdealSheafData.ofIdealTop (Ideal.span (Set.range
      (fun i : Option (Fin n) => Option.elim i
        ((Limits.pullback.snd (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π'))
        (fun j => ((Limits.pullback.fst (a₀ ≫ wcQuadModelStr A n π c)
          (Spec.map (CommRingCat.ofHom ιA))) ≫ a₀).appTop.hom
          ((Scheme.ΓSpecIso (CommRingCat.of (wcQuadModelRing A n π c))).inv.hom
            (Ideal.Quotient.mk (wcQuadModelIdeal A n π c) (MvPolynomial.X j)))))))) bl)
