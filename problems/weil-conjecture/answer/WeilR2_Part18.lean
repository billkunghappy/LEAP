          (Limits.pullback.snd c pr).base.hom.continuous
        exact ⟨hc.isPreconnected, hc.nonempty⟩
      exact wc_pmn_vp_wlocal_comp_bij hW.2.1 hW.2.2.1
        (fun z hz O hO hzO => wc_wlocal_clopen_nbhd_in_open Vt.left hW.2.1 hW.2.2.1 z hz O hO hzO)
