  obtain ⟨χ, hχ⟩ : ∃ χ : Multiplicative (Localization.Away (ℓ : ℤ)) →* Lˣ,
      ∀ (a : ℤ) (k : ℕ), ((χ (Multiplicative.ofAdd
        (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))) : Lˣ) : L) =
          ζ k ^ a := by
    have hne : ∀ k, ζ k ≠ 0 := fun k => (hζ k).ne_zero (pow_ne_zero _ hℓ0)
    let uu : ℕ → Lˣ := fun k => Units.mk0 (ζ k) (hne k)
