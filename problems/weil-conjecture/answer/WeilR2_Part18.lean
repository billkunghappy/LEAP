    have hf1 : Spec.map (CommRingCat.ofHom ρ) ≫ Spec.map (CommRingCat.ofHom (algebraMap A Q)) =
        Spec.map (CommRingCat.ofHom (algebraMap A R)) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    have hf2 : Spec.map (CommRingCat.ofHom φA) = Spec.map (CommRingCat.ofHom (algebraMap A L)) := rfl
    let e : Limits.pullback
        (Spec.map (CommRingCat.ofHom ρ) ≫ Spec.map (CommRingCat.ofHom (algebraMap A Q)))
