  intro t
  let f : C(↥(Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi), ULift.{u+1} ℚ_[ℓ]) := t
  have hG : ∃ g : C(↥(Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi), ULift.{u+1} ℚ_[ℓ]),
