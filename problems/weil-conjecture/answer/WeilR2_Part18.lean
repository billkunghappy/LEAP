    obtain ⟨V⟩ := V
    apply RingCat.hom_ext
    apply RingHom.ext
    intro (s : C(V.left, ULift.{u+1} ℚ_[ℓ]))
    change @ContinuousMap.comp ↥(Limits.pullback V.hom g₁₂)
        ↥(Limits.pullback (Limits.pullback.snd V.hom g₂) g₁) (ULift.{u+1} ℚ_[ℓ]) _ _ _
