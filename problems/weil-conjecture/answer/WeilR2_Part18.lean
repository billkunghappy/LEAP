by
  intro A' _ _ _ _ _ ℓ _ hℓ π' hπ' r C _ _ _ a ha hcl L' _ _ φ' hφ'i halg' Pq q1 qL hT hD0 hD1 k hk
  classical

  obtain ⟨B, _, _, _, Λ, _, _, W', φ, a_y, e, h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_et_geom_strict_henselization (a (IsLocalRing.closedPoint C))
