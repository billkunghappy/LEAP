    obtain ⟨ε, -, hε⟩ := wc_pltr_wet_residue_geom_point y R (Spec.map (CommRingCat.ofHom ρ)) hWE hy_def
    have hq1 : (Spec.map (CommRingCat.ofHom ε) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))
