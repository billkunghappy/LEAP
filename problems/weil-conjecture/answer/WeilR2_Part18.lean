        (Scheme.ΓSpecIso (.of L)).inv.hom))), fun c => rfl⟩
  have θinj : Function.Injective θ := RingHom.injective θ
  obtain ⟨ξ, hξdef⟩ : ∃ ξ : ℕ → ((Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi).residueField x),
      ∀ k, ξ k = θ (T.ζ k) := ⟨_, fun k => rfl⟩
  obtain ⟨ν, hνdef⟩ : ∃ ν : ℕ → ((Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi).residueField x),
