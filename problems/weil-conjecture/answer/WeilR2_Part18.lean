    have hfun : (fun g : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ N =>
        g.val.app (Opposite.op T) (1 : (wcRingSheaf S ℓ).obj.obj (Opposite.op T))) =
        (fun s : N.val.sections =>
