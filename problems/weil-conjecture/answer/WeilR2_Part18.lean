        (α₀.app V).left.base.hom = (D₁₂.φ.hom.app (Opposite.op V)).hom s
    have h1 := hD₂ V s
    have h2 := hD₁ ((wcProEtBC g₂).obj V) (s.comp (Limits.pullback.fst V.hom g₂).base.hom)
    have h3 := hD₁₂ V s
    first
      | rw [h1, h2, h3]
      | erw [h1, h2, h3]
