            (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) : LaurentPolynomial L →+* LaurentPolynomial L)))) :=
        isAffine_of_isAffineHom (Limits.pullback.fst (W'.hom ≫ T.g₀)
          (Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
            (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) : LaurentPolynomial L →+* LaurentPolynomial L))))
      obtain ⟨hc, hu, he, hs⟩ := wc_wlocal_strictHensel_finite_stable (Limits.pullback.fst
        (W'.hom ≫ T.g₀) (Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
          (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) : LaurentPolynomial L →+* LaurentPolynomial L))))
        hV.1 hV.2.1 hV.2.2.1 hV.2.2.2.1 hV.2.2.2.2
      have hv := wc_et_wstrictly_local_vanish _ hSaff hc hu he hs
        ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback (W'.hom ≫ T.g₀)
          (Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
            (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) : LaurentPolynomial L →+* LaurentPolynomial L)))))
          AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ)))) n
      have hv' : Subsingleton (wcEtCoh (Limits.pullback (W'.hom ≫ T.g₀)
          (Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
            (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) : LaurentPolynomial L →+* LaurentPolynomial L))))
          ℓ (n + 1)) := hv
      obtain ⟨E0⟩ := wc_et_zmodext_coh_equiv (Limits.pullback (W'.hom ≫ T.g₀)
          (Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
            (AddMonoidHom.mulLeft ((ℓ : ℤ) ^ k)) : LaurentPolynomial L →+* LaurentPolynomial L))))
          ℓ (n + 1)
      haveI := @Equiv.subsingleton _ _ E0 hv'
