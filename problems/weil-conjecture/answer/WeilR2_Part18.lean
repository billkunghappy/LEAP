    exact ⟨(htf.mp hlim Sc hSc).1, hepi _ hSc.epi_g⟩

  haveI : (wcSecEv S ℓ W).PreservesHomology := inferInstance
  have h1 : IsIso (HomologicalComplex.homologyMap
      (((wcSecEv S ℓ W).mapHomologicalComplex (ComplexShape.up ℤ)).map φ) q) :=
