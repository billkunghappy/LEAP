    {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B} (T : wcQmtmTower ℓ φA σ p q w x₀) :
    ∃ (t : ℤ_[ℓ]) (z : ℕ → L), IsUnit t ∧ (∀ k : ℕ, z k ^ (ℓ ^ k) = φA π) ∧
      (∀ k : ℕ, z (k + 1) ^ ℓ = z k) ∧
      ∀ k : ℕ, σ (z k) = T.ζ k ^ (PadicInt.toZModPow k t).val * z k :=
by
  classical
  have hℓp : ℓ.Prime := Fact.out
  have hℓ1 : 1 < ℓ := hℓp.one_lt

  have hπ0 : π ≠ 0 := by
    intro h
    apply IsDiscreteValuationRing.not_a_field A
    rw [hπ, h, Ideal.span_singleton_eq_bot.mpr rfl]
  have hφπ : φA π ≠ 0 := (map_ne_zero_iff φA hφA).mpr hπ0
  have hζ1 : IsPrimitiveRoot (T.ζ 1) ℓ := by simpa [pow_one] using T.hζ 1
  haveI : NeZero ℓ := ⟨hℓp.ne_zero⟩
  haveI hL : NeZero ((ℓ : ℕ) : L) := hζ1.neZero'
  have hpk : ∀ k : ℕ, ℓ ^ k ≠ 0 := fun k => pow_ne_zero k hℓp.ne_zero

  obtain ⟨z, hz0, hzs⟩ : ∃ z : ℕ → L, z 0 = φA π ∧ ∀ k, z (k + 1) ^ ℓ = z k :=
    ⟨fun k => Nat.rec (motive := fun _ => L) (φA π)
        (fun _ y => Classical.choose (IsSepClosed.exists_pow_nat_eq y ℓ)) k, rfl,
      fun k => Classical.choose_spec (IsSepClosed.exists_pow_nat_eq _ ℓ)⟩
  have hzpow : ∀ k, z k ^ (ℓ ^ k) = φA π := by
    intro k
    induction k with
    | zero => simp [hz0]
    | succ k ih => rw [pow_succ' ℓ k, pow_mul, hzs k, ih]
  have hzne : ∀ k, z k ≠ 0 := by
    intro k h
    apply hφπ
    rw [← hzpow k, h, zero_pow (hpk k)]
  have hσπ : σ (φA π) = φA π := RingHom.congr_fun hσ π

  have he : ∀ k, (σ (z k) * (z k)⁻¹) ^ (ℓ ^ k) = 1 := by
    intro k
    rw [mul_pow, inv_pow, ← map_pow, hzpow k, hσπ, mul_inv_cancel₀ hφπ]
  have hc : ∀ k, ∃ c < ℓ ^ k, T.ζ k ^ c = σ (z k) * (z k)⁻¹ := by
    intro k
    haveI : NeZero (ℓ ^ k) := ⟨hpk k⟩
    exact (T.hζ k).eq_pow_of_pow_eq_one (he k)
  choose c hclt hcζ using hc
  have hσz : ∀ k, σ (z k) = T.ζ k ^ c k * z k := by
    intro k
    rw [hcζ k, inv_mul_cancel_right₀ (hzne k)]

  have hcompat : ∀ k, c (k + 1) % ℓ ^ k = c k := by
    intro k
    have h1 : (σ (z (k + 1)) * (z (k + 1))⁻¹) ^ ℓ = σ (z k) * (z k)⁻¹ := by
      rw [mul_pow, inv_pow, ← map_pow, hzs k]
    have h2 : T.ζ k ^ c (k + 1) = T.ζ k ^ c k := by
      rw [hcζ k, ← h1, ← hcζ (k + 1), ← T.hζc k, pow_right_comm]
    have hord : orderOf (T.ζ k) = ℓ ^ k := ((T.hζ k).eq_orderOf).symm
    have h3 : T.ζ k ^ (c (k + 1) % ℓ ^ k) = T.ζ k ^ c k := by
      rw [← hord, pow_mod_orderOf, h2]
    exact (T.hζ k).pow_inj (Nat.mod_lt _ (Nat.pos_of_ne_zero (hpk k))) (hclt k) h3

  have padic : ∀ (x : ∀ m : ℕ, ZMod (ℓ ^ m)),
      (∀ m : ℕ, ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ m)) (ZMod (ℓ ^ m)) (x (m + 1)) = x m) →
      ∃ t : ℤ_[ℓ], ∀ m : ℕ, PadicInt.toZModPow m t = x m := by
    intro x hx
    let S : Subring (∀ m : ℕ, ZMod (ℓ ^ m)) :=
      { carrier := {y | ∀ m : ℕ,
          ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ m)) (ZMod (ℓ ^ m)) (y (m + 1)) = y m}
        mul_mem' := by
          intro a b ha hb m
          simp only [Set.mem_setOf_eq] at ha hb
          simp only [Pi.mul_apply, map_mul, ha m, hb m]
        one_mem' := by
          intro m
          simp only [Pi.one_apply, map_one]
        add_mem' := by
          intro a b ha hb m
          simp only [Set.mem_setOf_eq] at ha hb
          simp only [Pi.add_apply, map_add, ha m, hb m]
        zero_mem' := by
          intro m
          simp only [Pi.zero_apply, map_zero]
        neg_mem' := by
          intro a ha m
          simp only [Set.mem_setOf_eq] at ha
          simp only [Pi.neg_apply, map_neg, ha m] }
    let f : ∀ k : ℕ, S →+* ZMod (ℓ ^ k) := fun k =>
      (Pi.evalRingHom (fun m : ℕ => ZMod (ℓ ^ m)) k).comp S.subtype
    have hf : ∀ k (y : S), f k y = (y : ∀ m : ℕ, ZMod (ℓ ^ m)) k := fun k y => rfl
    have compat : ∀ k1 k2 (hk : k1 ≤ k2),
        (ZMod.castHom (pow_dvd_pow ℓ hk) (ZMod (ℓ ^ k1))).comp (f k2) = f k1 := by
      intro k1 k2 hk
      induction k2, hk using Nat.le_induction with
      | base =>
        ext y
        rw [RingHom.comp_apply, hf, ZMod.castHom_apply]
        exact ZMod.cast_id _ _
      | succ k2 hk ih =>
        ext y
        have hy : ∀ m : ℕ, ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ m)) (ZMod (ℓ ^ m))
            ((y : ∀ m : ℕ, ZMod (ℓ ^ m)) (m + 1)) = (y : ∀ m : ℕ, ZMod (ℓ ^ m)) m := y.2
        have h1 := congrArg (fun g => g y) ih
        simp only [RingHom.comp_apply, hf] at h1
        rw [RingHom.comp_apply, hf, hf, ← h1, ← hy k2]
        exact (RingHom.congr_fun (ZMod.castHom_comp (pow_dvd_pow ℓ hk)
          (pow_dvd_pow ℓ (Nat.le_succ k2))) _).symm
    refine ⟨PadicInt.lift compat ⟨x, hx⟩, fun m => ?_⟩
    have h := congrArg (fun g => g (⟨x, hx⟩ : S)) (PadicInt.lift_spec compat m)
    simpa only [RingHom.comp_apply, hf] using h
  obtain ⟨t, ht⟩ := padic (fun m => ((c m : ℕ) : ZMod (ℓ ^ m))) (by
    intro m
    simp only [map_natCast]
    rw [← ZMod.natCast_mod (c (m + 1)) (ℓ ^ m), hcompat m])

  have hval : ∀ k, (PadicInt.toZModPow k t).val = c k := by
    intro k
    rw [ht k]
    exact ZMod.val_natCast_of_lt (hclt k)

  have hc1 : c 1 ≠ 0 := by
    intro h0
    have hprim := htame 1 le_rfl (z 1) (hzpow 1)
    rw [← hcζ 1, h0, pow_zero] at hprim
    have h4 := hprim.eq_orderOf
    rw [orderOf_one, pow_one] at h4
    omega
  have hunit : IsUnit t := by
    by_contra hnu
    have hmem : t ∈ IsLocalRing.maximalIdeal ℤ_[ℓ] :=
      (IsLocalRing.mem_maximalIdeal t).mpr (mem_nonunits_iff.mpr hnu)
    rw [PadicInt.maximalIdeal_eq_span_p, ← pow_one (ℓ : ℤ_[ℓ]), ← PadicInt.ker_toZModPow,
      RingHom.mem_ker] at hmem
    apply hc1
    rw [← hval 1, hmem, ZMod.val_zero]
  exact ⟨t, z, hunit, hzpow, hzs, fun k => by rw [hσz k, hval k]⟩

theorem wc_qmtx1u_transl_ring {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) :
    ∃ R : ℤ_[ℓ] → (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
        AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))),
      (∀ (y : ℤ_[ℓ]) (a : ℤ) (k : ℕ) (c : L),
        R y (AddMonoidAlgebra.single
            (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c) =
          AddMonoidAlgebra.single
            (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))
            (T.ζ k ^ (a * ((PadicInt.toZModPow k y).val : ℤ)) * c)) ∧
      (∀ y y' : ℤ_[ℓ], (R y).comp (R y') = R (y + y')) ∧
      R 1 = T.γR ∧
      R 0 = RingHom.id _ ∧
      ∀ y : ℤ_[ℓ], (R y).comp (AddMonoidAlgebra.mapDomainRingHom L
          (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) =
        AddMonoidAlgebra.mapDomainRingHom L
          (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom :=
by
  classical
  have hℓ0 : ℓ ≠ 0 := (Fact.out : Nat.Prime ℓ).ne_zero
  have hζ0 : ∀ k, T.ζ k ≠ 0 := fun k => (T.hζ k).ne_zero (pow_ne_zero k hℓ0)

  have period : ∀ (k : ℕ) (a m m' : ℤ), (ℓ : ℤ) ^ k ∣ m - m' →
      T.ζ k ^ (a * m) = T.ζ k ^ (a * m') := by
    intro k a m m' h
    have h1 : T.ζ k ^ (a * (m - m')) = 1 := by
      rw [(T.hζ k).zpow_eq_one_iff_dvd]
      push_cast
      exact Dvd.dvd.mul_left h a
    calc T.ζ k ^ (a * m) = T.ζ k ^ (a * m' + a * (m - m')) := by congr 1; ring
      _ = T.ζ k ^ (a * m') * T.ζ k ^ (a * (m - m')) := zpow_add₀ (hζ0 k) _ _
      _ = T.ζ k ^ (a * m') := by rw [h1, mul_one]

  have cong : ∀ (k : ℕ) (m m' : ℤ), ((m : ZMod (ℓ ^ k)) = (m' : ZMod (ℓ ^ k))) →
      (ℓ : ℤ) ^ k ∣ m - m' := by
    intro k m m' h
    have := (ZMod.intCast_eq_intCast_iff_dvd_sub m' m (ℓ ^ k)).mp h.symm
    push_cast at this
    exact this

  have lineup : ∀ k j : ℕ, T.ζ (k + j) ^ (ℓ ^ j) = T.ζ k := by
    intro k j
    induction j with
    | zero => simp
    | succ j ih => rw [← add_assoc, pow_succ' ℓ j, pow_mul, T.hζc, ih]

  have level : ∀ (y : ℤ_[ℓ]) (k j : ℕ) (u : ℤ),
      T.ζ (k + j) ^ (u * (ℓ : ℤ) ^ j * ((PadicInt.toZModPow (k + j) y).val : ℤ)) =
        T.ζ k ^ (u * ((PadicInt.toZModPow k y).val : ℤ)) := by
    intro y k j u
    have e1 : u * (ℓ : ℤ) ^ j * ((PadicInt.toZModPow (k + j) y).val : ℤ) =
        ((ℓ ^ j : ℕ) : ℤ) * (u * ((PadicInt.toZModPow (k + j) y).val : ℤ)) := by
      push_cast; ring
    rw [e1, zpow_mul, zpow_natCast, lineup]
    apply period
    apply cong
    have hc := congrArg (fun F => F y)
      (PadicInt.zmod_cast_comp_toZModPow (p := ℓ) k (k + j) (Nat.le_add_right k j))
    simp only [RingHom.comp_apply, ZMod.castHom_apply] at hc
    rw [Int.cast_natCast, Int.cast_natCast, ZMod.natCast_val, ZMod.natCast_zmod_val, hc]

  have repr : ∀ x : Localization.Away (ℓ : ℤ), ∃ (a : ℤ) (k : ℕ),
      x = (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) := by
    intro x
    refine Localization.induction_on x ?_
    rintro ⟨a, s, hs⟩
    obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hs
    exact ⟨a, n, rfl⟩

  have charex : ∀ (E : ℕ → ℤ → L), E 0 0 = 1 → (∀ k u v, E k (u + v) = E k u * E k v) →
      (∀ k j u, E (k + j) (u * (ℓ : ℤ) ^ j) = E k u) →
      ∃ f : Localization.Away (ℓ : ℤ) → L, f 0 = 1 ∧ (∀ x x', f (x + x') = f x * f x') ∧
        ∀ (a : ℤ) (k : ℕ), f ((Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))) = E k a := by
    intro E h0 hadd hlev
    have wd : ∀ (a a' : ℤ) (k k' : ℕ),
        ((Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) : Localization.Away (ℓ : ℤ)) =
          (Localization.mk a' ⟨(ℓ : ℤ) ^ k', k', rfl⟩ : Localization.Away (ℓ : ℤ)) → E k a = E k' a' := by
      intro a a' k k' h
      rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists] at h
      obtain ⟨⟨c, hcm⟩, hc⟩ := h
      obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hcm
      have hc0 : ((ℓ : ℤ) ^ n) ≠ 0 := pow_ne_zero _ (by exact_mod_cast hℓ0)
      have h3 : (ℓ : ℤ) ^ k' * a = (ℓ : ℤ) ^ k * a' := mul_left_cancel₀ hc0 hc
      have h2 : a * (ℓ : ℤ) ^ k' = a' * (ℓ : ℤ) ^ k := by linear_combination h3
      rw [← hlev k k' a, h2, add_comm, hlev k' k a']
    have repr' := repr
    choose ax kx hx using repr'
    have val : ∀ (a : ℤ) (k : ℕ),
        E (kx ((Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))))
          (ax ((Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)))) = E k a :=
      fun a k => wd _ _ _ _ (hx _).symm
    refine ⟨fun x => E (kx x) (ax x), ?_, ?_, val⟩
    · have e0 : (0 : Localization.Away (ℓ : ℤ)) = (Localization.mk 0 ⟨(ℓ : ℤ) ^ 0, 0, rfl⟩ : Localization.Away (ℓ : ℤ)) :=
        (Localization.mk_zero _).symm
      show E (kx 0) (ax 0) = 1
      rw [e0, val, h0]
    · intro x x'
      obtain ⟨a, k, rfl⟩ := repr x
      obtain ⟨b, m, rfl⟩ := repr x'
      have hsum : ((Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) : Localization.Away (ℓ : ℤ)) +
          (Localization.mk b ⟨(ℓ : ℤ) ^ m, m, rfl⟩ : Localization.Away (ℓ : ℤ)) =
          (Localization.mk ((ℓ : ℤ) ^ k * b + (ℓ : ℤ) ^ m * a)
            ⟨(ℓ : ℤ) ^ (k + m), k + m, rfl⟩ : Localization.Away (ℓ : ℤ)) := by
        rw [Localization.add_mk]
        have e : (⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Submonoid.powers (ℓ : ℤ)) * ⟨(ℓ : ℤ) ^ m, m, rfl⟩ =
            ⟨(ℓ : ℤ) ^ (k + m), k + m, rfl⟩ := Subtype.ext (pow_add _ _ _).symm
        rw [e]
      show E (kx _) (ax _) = E (kx _) (ax _) * E (kx _) (ax _)
      rw [hsum, val, val, val, hadd]
      have e1 : E (k + m) ((ℓ : ℤ) ^ m * a) = E k a := by rw [mul_comm]; exact hlev k m a
      have e2 : E (k + m) ((ℓ : ℤ) ^ k * b) = E m b := by
        rw [mul_comm, add_comm]; exact hlev m k b
      rw [e1, e2, mul_comm]

  have hch : ∀ y : ℤ_[ℓ], ∃ f : Localization.Away (ℓ : ℤ) → L, f 0 = 1 ∧
      (∀ x x', f (x + x') = f x * f x') ∧
      ∀ (a : ℤ) (k : ℕ), f ((Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))) =
        T.ζ k ^ (a * ((PadicInt.toZModPow k y).val : ℤ)) := by
    intro y
    refine charex (fun k a => T.ζ k ^ (a * ((PadicInt.toZModPow k y).val : ℤ))) ?_ ?_ ?_
    · simp
    · intro k u v
      rw [add_mul, zpow_add₀ (hζ0 k)]
    · intro k j u
      exact level y k j u
  choose f hf0 hfadd hfval using hch

  let g : ℤ_[ℓ] → (Multiplicative (Localization.Away (ℓ : ℤ)) →*
      AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) := fun y =>
    { toFun := fun x => AddMonoidAlgebra.single (Multiplicative.toAdd x)
        (f y (Multiplicative.toAdd x))
      map_one' := by
        show AddMonoidAlgebra.single 0 (f y 0) = 1
        rw [hf0, AddMonoidAlgebra.one_def]
      map_mul' := by
        intro x x'
        show AddMonoidAlgebra.single (Multiplicative.toAdd x + Multiplicative.toAdd x')
          (f y (Multiplicative.toAdd x + Multiplicative.toAdd x')) = _
        rw [hfadd, AddMonoidAlgebra.single_mul_single] }
  let R : ℤ_[ℓ] → (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
      AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) := fun y =>
    (AddMonoidAlgebra.lift L (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))
      (Localization.Away (ℓ : ℤ)) (g y)).toRingHom
  have hR : ∀ (y : ℤ_[ℓ]) (x : Localization.Away (ℓ : ℤ)) (c : L),
      R y (AddMonoidAlgebra.single x c) = AddMonoidAlgebra.single x (f y x * c) := by
    intro y x c
    show AddMonoidAlgebra.lift L (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))
      (Localization.Away (ℓ : ℤ)) (g y) (AddMonoidAlgebra.single x c) = _
    rw [AddMonoidAlgebra.lift_single]
    show c • AddMonoidAlgebra.single x (f y x) = _
    rw [AddMonoidAlgebra.smul_single', mul_comm]

  have ext : ∀ F G' : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
      AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)),
      (∀ (a : ℤ) (k : ℕ) (c : L),
        F (AddMonoidAlgebra.single ((Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))) c) =
          G' (AddMonoidAlgebra.single ((Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))) c)) →
      F = G' := by
    intro F G' h
    apply AddMonoidAlgebra.ringHom_ext
    · intro c
      have e0 : (0 : Localization.Away (ℓ : ℤ)) = (Localization.mk 0 ⟨(ℓ : ℤ) ^ 0, 0, rfl⟩ : Localization.Away (ℓ : ℤ)) :=
        (Localization.mk_zero _).symm
      rw [e0]
      exact h 0 0 c
    · intro x
      obtain ⟨a, k, rfl⟩ := repr x
      exact h a k 1
  refine ⟨R, ?_, ?_, ?_, ?_, ?_⟩
  · intro y a k c
    rw [hR, hfval]
  · intro y y'
    apply ext
    intro a k c
    have hdiv : (ℓ : ℤ) ^ k ∣ (((PadicInt.toZModPow k y).val : ℤ) +
        ((PadicInt.toZModPow k y').val : ℤ)) - ((PadicInt.toZModPow k (y + y')).val : ℤ) := by
      apply cong
      simp only [Int.cast_add, Int.cast_natCast, ZMod.natCast_zmod_val, map_add]
    rw [RingHom.comp_apply, hR, hR, hR, hfval, hfval, hfval, ← mul_assoc,
      ← zpow_add₀ (hζ0 k), ← mul_add, period k a _ _ hdiv]
  · apply ext
    intro a k c
    have hdiv : (ℓ : ℤ) ^ k ∣ ((PadicInt.toZModPow k (1 : ℤ_[ℓ])).val : ℤ) - 1 := by
      apply cong
      simp only [Int.cast_natCast, ZMod.natCast_zmod_val, map_one, Int.cast_one]
    rw [hR, T.hγR, T.hχ, hfval, period k a _ _ hdiv, mul_one]
  · apply ext
    intro a k c
    rw [hR, hfval, map_zero, ZMod.val_zero, Nat.cast_zero, mul_zero, zpow_zero, one_mul,
      RingHom.id_apply]
  · intro y
    have hv : ∀ (n : ℤ) (c : L), R y (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom (AddMonoidAlgebra.single n c)) =
        AddMonoidAlgebra.mapDomainRingHom L
          (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom
          (AddMonoidAlgebra.single n c) := by
      intro n c
      rw [AddMonoidAlgebra.mapDomainRingHom_apply, AddMonoidAlgebra.mapDomain_single]
      have e : ((algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom :
          ℤ → Localization.Away (ℓ : ℤ)) n = (Localization.mk n ⟨(ℓ : ℤ) ^ 0, 0, rfl⟩ : Localization.Away (ℓ : ℤ)) := by
        show (algebraMap ℤ (Localization.Away (ℓ : ℤ))) n = _
        rw [← Localization.mk_one_eq_algebraMap]
        congr 1
      rw [e, hR, hfval]
      have hdiv : (ℓ : ℤ) ^ 0 ∣ ((PadicInt.toZModPow 0 y).val : ℤ) - 0 := by
        rw [pow_zero]; exact one_dvd _
      rw [period 0 n _ _ hdiv, mul_zero, zpow_zero, one_mul]
    apply AddMonoidAlgebra.ringHom_ext
    · intro c; exact hv 0 c
    · intro n; exact hv n 1

theorem wc_qmtx1u_mahler_series {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {X : Type*} [TopologicalSpace X]
    (a : ℤ_[ℓ] → X → X) (f : X → ℚ_[ℓ]) (s : ℤ_[ℓ])
    (ha : ∀ y, Continuous (a y)) (ha0 : ∀ x, a 0 x = x)
    (hadd : ∀ y y' x, a (y + y') x = a y' (a y x)) (hf : Continuous f)
    (hUC : ∀ x, ∃ K : Set X, IsOpen K ∧ x ∈ K ∧ IsCompact K ∧ (∀ y, ∀ x' ∈ K, a y x' ∈ K) ∧
      ∀ ε : ℝ, 0 < ε → ∃ k : ℕ, ∀ z : ℤ_[ℓ], PadicInt.toZModPow k z = 0 →
        ∀ x' ∈ K, ‖f (a z x') - f x'‖ ≤ ε) :
    (∀ x, Summable (fun n : ℕ =>
      Ring.choose s (n + 1) • (fwdDiff 1)^[n] (fun m : ℤ_[ℓ] => f (a m x)) 0)) ∧
    Continuous (fun x => ∑' n : ℕ,
      Ring.choose s (n + 1) • (fwdDiff 1)^[n] (fun m : ℤ_[ℓ] => f (a m x)) 0) ∧
    ∀ x, ∑' n : ℕ, Ring.choose s (n + 1) • (fwdDiff 1)^[n + 1] (fun m : ℤ_[ℓ] => f (a m x)) 0 =
      f (a s x) - f x :=
by
  classical
  letI hBS : IsBoundedSMul ℤ_[ℓ] ℚ_[ℓ] := IsBoundedSMul.of_norm_smul_le (fun r v => le_of_eq
    (by rw [Algebra.smul_def, PadicInt.algebraMap_apply, norm_mul, ← PadicInt.norm_def]))
  have hsmul : ∀ (r : ℤ_[ℓ]) (v : ℚ_[ℓ]), ‖r • v‖ ≤ ‖v‖ := fun r v =>
    (norm_smul_le r v).trans (mul_le_of_le_one_left (norm_nonneg _) (PadicInt.norm_le_one r))
  have hℓ1 : (1 : ℝ) < ℓ := Nat.one_lt_cast.mpr (Fact.out : Nat.Prime ℓ).one_lt
  have hℓ0 : (0 : ℝ) < ℓ := by linarith

  have modulus : ∀ K : Set X, (∀ y, ∀ x' ∈ K, a y x' ∈ K) →
      (∀ ε : ℝ, 0 < ε → ∃ k : ℕ, ∀ z : ℤ_[ℓ], PadicInt.toZModPow k z = 0 →
        ∀ x' ∈ K, ‖f (a z x') - f x'‖ ≤ ε) →
      ∀ ε : ℝ, 0 < ε → ∃ k : ℕ, ∀ x' ∈ K, ∀ y y' : ℤ_[ℓ], ‖y - y'‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) →
        ‖f (a y x') - f (a y' x')‖ ≤ ε := by
    intro K hKinv hlev ε hε
    obtain ⟨k, hk⟩ := hlev ε hε
    refine ⟨k, fun x' hx' y y' hyy' => ?_⟩
    have hz : PadicInt.toZModPow k (y - y') = 0 := by
      rw [← RingHom.mem_ker, PadicInt.ker_toZModPow, ← PadicInt.norm_le_pow_iff_mem_span_pow]
      exact hyy'
    have h1 := hk (y - y') hz (a y' x') (hKinv y' x' hx')
    have e : y' + (y - y') = y := by ring
    rwa [← hadd, e] at h1

  have gcont : ∀ x, Continuous (fun m : ℤ_[ℓ] => f (a m x)) := by
    intro x
    obtain ⟨K, -, hxK, -, hKinv, hlev⟩ := hUC x
    rw [Metric.continuous_iff]
    intro m₀ ε hε
    obtain ⟨k, hk⟩ := modulus K hKinv hlev (ε / 2) (by linarith)
    refine ⟨(ℓ : ℝ) ^ (-(k : ℤ)), zpow_pos hℓ0 _, fun m hm => ?_⟩
    rw [dist_eq_norm] at hm ⊢
    have := hk x hxK m m₀ hm.le
    linarith

  have hA : ∀ x, Summable (fun n : ℕ =>
      Ring.choose s (n + 1) • (fwdDiff 1)^[n] (fun m : ℤ_[ℓ] => f (a m x)) 0) := by
    intro x
    apply NonarchimedeanAddGroup.summable_of_tendsto_cofinite_zero
    rw [Nat.cofinite_eq_atTop]
    have h0 := (PadicInt.fwdDiff_tendsto_zero
      (⟨fun m : ℤ_[ℓ] => f (a m x), gcont x⟩ : C(ℤ_[ℓ], ℚ_[ℓ]))).norm
    rw [norm_zero] at h0
    exact squeeze_zero_norm (fun n => hsmul _ _) h0

  have hC : ∀ x, ∑' n : ℕ, Ring.choose s (n + 1) •
      (fwdDiff 1)^[n + 1] (fun m : ℤ_[ℓ] => f (a m x)) 0 = f (a s x) - f x := by
    intro x
    have h1 := (PadicInt.hasSum_mahler
      (⟨fun m : ℤ_[ℓ] => f (a m x), gcont x⟩ : C(ℤ_[ℓ], ℚ_[ℓ]))).map
      (ContinuousMap.evalCLM ℚ_[ℓ] s) (ContinuousMap.evalCLM ℚ_[ℓ] s).continuous
    have h2 : HasSum (fun n : ℕ => Ring.choose s n •
        (fwdDiff 1)^[n] (fun m : ℤ_[ℓ] => f (a m x)) 0) (f (a s x)) := by
      convert h1 using 1
      · funext n
        rw [Function.comp_apply, ContinuousMap.evalCLM_apply, PadicInt.mahlerTerm_apply,
          mahler_apply, ContinuousMap.coe_mk]
      · rw [ContinuousMap.evalCLM_apply, ContinuousMap.coe_mk]
    have h3 := (hasSum_nat_add_iff' 1).mpr h2
    rw [Finset.sum_range_one, Ring.choose_zero_right, Function.iterate_zero_apply, one_smul,
      ha0] at h3
    exact h3.tsum_eq

  have hB : Continuous (fun x => ∑' n : ℕ,
      Ring.choose s (n + 1) • (fwdDiff 1)^[n] (fun m : ℤ_[ℓ] => f (a m x)) 0) := by
    rw [continuous_iff_continuousAt]
    intro x
    obtain ⟨K, hKo, hxK, hKc, hKinv, hlev⟩ := hUC x
    refine ContinuousOn.continuousAt ?_ (hKo.mem_nhds hxK)
    set F : ℕ → X → ℚ_[ℓ] := fun n x =>
      Ring.choose s (n + 1) • (fwdDiff 1)^[n] (fun m : ℤ_[ℓ] => f (a m x)) 0 with hF
    show ContinuousOn (fun x => ∑' n, F n x) K

    have hcont : ∀ N : ℕ, Continuous (fun x => ∑ n ∈ Finset.range N, F n x) := by
      intro N
      apply continuous_finsetSum
      intro n _
      simp only [hF, fwdDiff_iter_eq_sum_shift]
      refine Continuous.const_smul (continuous_finsetSum _ (fun j _ => ?_)) _
      exact (hf.comp (ha _)).zsmul _

    have htail : ∀ ε : ℝ, 0 < ε → ∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ x' ∈ K, ‖F n x'‖ ≤ ε := by
      intro ε' hε'
      obtain ⟨C, hC⟩ := hKc.exists_bound_of_continuousOn hf.continuousOn
      have hCm : 0 ≤ max C 0 := le_max_right _ _
      set B : ℝ := max C 0 + 1 with hBdef
      have hB0 : 0 < B := by linarith
      have hfB : ∀ y ∈ K, ‖f y‖ ≤ B := fun y hy =>
        (hC y hy).trans (by linarith [le_max_left C 0])
      obtain ⟨s₀, hs₀⟩ := pow_unbounded_of_one_lt (B / ε') hℓ1
      have hq : (0 : ℝ) < (ℓ : ℝ) ^ s₀ := pow_pos hℓ0 _
      have hBq : B / (ℓ : ℝ) ^ s₀ < ε' := by
        rw [div_lt_iff₀ hq]
        rw [div_lt_iff₀ hε'] at hs₀
        linarith
      obtain ⟨k, hk⟩ := modulus K hKinv hlev (B / (ℓ : ℝ) ^ (2 * s₀)) (by positivity)
      refine ⟨s₀ * ℓ ^ k, fun n hn x' hx' => ?_⟩
      let G : C(ℤ_[ℓ], ℚ_[ℓ]) := ⟨fun m => f (a m x'), gcont x'⟩
      have hGB : ‖G‖ ≤ B :=
        (ContinuousMap.norm_le G hB0.le).mpr (fun m => hfB _ (hKinv m x' hx'))
      have hΔ : ‖(fwdDiff 1)^[n] (⇑G) 0‖ ≤ B / (ℓ : ℝ) ^ s₀ := by
        obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le' hn
        by_cases hsmall : ‖G‖ ≤ B / (ℓ : ℝ) ^ s₀
        · exact (IsUltrametricDist.norm_fwdDiff_iter_apply_le 1 G 0 _).trans hsmall
        · push_neg at hsmall
          have hmod : ∀ y y' : ℤ_[ℓ], ‖y - y'‖ ≤ (ℓ : ℝ) ^ (-(k : ℤ)) →
              ‖G y - G y'‖ ≤ ‖G‖ / (ℓ : ℝ) ^ s₀ := by
            intro y y' h
            refine (hk x' hx' y y' h).trans ?_
            rw [two_mul, pow_add, ← div_div]
            exact div_le_div_of_nonneg_right hsmall.le hq.le
          exact (PadicInt.fwdDiff_iter_le_of_forall_le hmod d).trans
            (div_le_div_of_nonneg_right hGB hq.le)
      calc ‖F n x'‖ ≤ ‖(fwdDiff 1)^[n] (⇑G) 0‖ := hsmul _ _
        _ ≤ B / (ℓ : ℝ) ^ s₀ := hΔ
        _ ≤ ε' := hBq.le

    have hunif : TendstoUniformlyOn (fun N x => ∑ n ∈ Finset.range N, F n x)
        (fun x => ∑' n, F n x) Filter.atTop K := by
      rw [Metric.tendstoUniformlyOn_iff]
      intro ε hε
      obtain ⟨N₀, hN₀⟩ := htail (ε / 2) (by linarith)
      rw [Filter.eventually_atTop]
      refine ⟨N₀, fun N hN x' hx' => ?_⟩
      have hs : ∑ i ∈ Finset.range N, F i x' + ∑' i, F (i + N) x' = ∑' i, F i x' :=
        (hA x').sum_add_tsum_nat_add N
      have e : ∑' n, F n x' - ∑ n ∈ Finset.range N, F n x' = ∑' i, F (i + N) x' := by
        rw [← hs]; abel
      have ht : ‖∑' i, F (i + N) x'‖ ≤ ε / 2 :=
        IsUltrametricDist.norm_tsum_le_of_forall_le (fun i => hN₀ (i + N) (by omega) x' hx')
      show dist (∑' n, F n x') (∑ n ∈ Finset.range N, F n x') < ε
      rw [dist_eq_norm, e]
      linarith
    exact hunif.continuousOn (Filter.Frequently.of_forall (fun N => (hcont N).continuousOn))
  exact ⟨hA, hB, hC⟩

theorem wc_qmtx1u_uniform_level {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (γ : ℤ_[ℓ] → (T.XEi ⟶ T.XEi))
    (R : ℤ_[ℓ] → (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
        AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))
    (hγπ : ∀ y, γ y ≫ T.πi = T.πi)
    (hγg : ∀ y, γ y ≫ T.gi = T.gi ≫ Spec.map (CommRingCat.ofHom (R y)))
    (hR : ∀ (y : ℤ_[ℓ]) (a : ℤ) (k : ℕ) (c : L),
        R y (AddMonoidAlgebra.single
            (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c) =
          AddMonoidAlgebra.single
            (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))
            (T.ζ k ^ (a * ((PadicInt.toZModPow k y).val : ℤ)) * c))
    (V : XE.ProEt) (f : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]))
    (x : ↥(Limits.pullback V.hom T.πi)) :
    ∃ K : Set ↥(Limits.pullback V.hom T.πi), IsOpen K ∧ x ∈ K ∧ IsCompact K ∧
      (∀ κ : Limits.pullback V.hom T.πi ⟶ Limits.pullback V.hom T.πi,
        κ ≫ Limits.pullback.fst V.hom T.πi = Limits.pullback.fst V.hom T.πi →
        ∀ x' ∈ K, κ.base.hom x' ∈ K) ∧
      ∀ ε : ℝ, 0 < ε → ∃ k : ℕ, ∀ z : ℤ_[ℓ], PadicInt.toZModPow k z = 0 →
        ∀ κ : Limits.pullback V.hom T.πi ⟶ Limits.pullback V.hom T.πi,
        κ ≫ Limits.pullback.fst V.hom T.πi = Limits.pullback.fst V.hom T.πi →
        κ ≫ Limits.pullback.snd V.hom T.πi = Limits.pullback.snd V.hom T.πi ≫ γ z →
        ∀ x' ∈ K, ‖(f (κ.base.hom x')).down - (f x').down‖ ≤ ε :=
by
  classical

  have hcb : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (x : ↥X),
      (f ≫ g).base.hom x = g.base.hom (f.base.hom x) := by
    intro X Y Z f g x; rw [Scheme.Hom.comp_base]; rfl
  have happ : ∀ {X Y Z : Scheme.{u}} (u : X ⟶ Y) (v : Y ⟶ Z) (r : Γ(Z, ⊤)),
      (u ≫ v).appTop.hom r = u.appTop.hom (v.appTop.hom r) := by
    intro X Y Z u v r; rw [Scheme.Hom.comp_appTop]; rfl
  have hM : ∀ j k : ℕ, j ≤ k → ∀ z : ℤ_[ℓ], PadicInt.toZModPow k z = 0 →
      PadicInt.toZModPow j z = 0 := by
    intro j k hjk z hz
    rw [← PadicInt.zmod_cast_comp_toZModPow j k hjk, RingHom.comp_apply, hz, map_zero]

  have s3 : ∀ g : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)),
      ∃ k : ℕ, ∀ z : ℤ_[ℓ], PadicInt.toZModPow k z = 0 → R z g = g := by
    intro g
    induction g using AddMonoidAlgebra.induction_linear with
    | zero => exact ⟨0, fun z _ => map_zero _⟩
    | add g₁ g₂ h₁ h₂ =>
      obtain ⟨k₁, hk₁⟩ := h₁
      obtain ⟨k₂, hk₂⟩ := h₂
      refine ⟨max k₁ k₂, fun z hz => ?_⟩
      rw [map_add, hk₁ z (hM _ _ (le_max_left _ _) z hz), hk₂ z (hM _ _ (le_max_right _ _) z hz)]
    | single m c =>
      refine Localization.induction_on m ?_
      rintro ⟨a, ⟨_, n, rfl⟩⟩
      refine ⟨n, fun z hz => ?_⟩
      rw [hR, hz, ZMod.val_zero]
      simp

  have s5 : ∀ {X : Type u} [TopologicalSpace X] [CompactSpace X]
      (F : X → ℚ_[ℓ]) (_ : Continuous F) (Ψ : ℕ → Set (X → X))
      (_ : ∀ j k, j ≤ k → Ψ k ⊆ Ψ j)
      (_ : ∀ C : Set X, IsClopen C → ∃ k, ∀ φ ∈ Ψ k, ∀ y ∈ C, φ y ∈ C)
      (ε : ℝ) (_ : 0 < ε), ∃ k, ∀ φ ∈ Ψ k, ∀ y, ‖F (φ y) - F y‖ ≤ ε := by
    intro X _ _ F hF Ψ hmono hC ε hε
    let C : X → Set X := fun y => F ⁻¹' Metric.closedBall (F y) ε
    have hCc : ∀ y, IsClopen (C y) := fun y =>
      (IsUltrametricDist.isClopen_closedBall (F y) hε.ne').preimage hF
    choose kf hkf using fun y => hC (C y) (hCc y)
    obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover C (fun y => (hCc y).isOpen)
      (fun y _ => Set.mem_iUnion.mpr ⟨y, show F y ∈ Metric.closedBall (F y) ε from
        Metric.mem_closedBall_self hε.le⟩)
    refine ⟨t.sup kf, fun φ hφ y' => ?_⟩
    have h1 := ht (Set.mem_univ y')
    simp only [Set.mem_iUnion] at h1
    obtain ⟨y, hy, hy'⟩ := h1
    have hφy := hkf y φ (hmono _ _ (Finset.le_sup hy) hφ) y' hy'
    simp only [C, Set.mem_preimage, Metric.mem_closedBall] at hy' hφy
    rw [← dist_eq_norm]
    calc dist (F (φ y')) (F y') ≤ max (dist (F (φ y')) (F y)) (dist (F y) (F y')) :=
          IsUltrametricDist.dist_triangle_max _ _ _
      _ ≤ ε := max_le hφy (by rw [dist_comm]; exact hy')

  have s4 : ∀ (X : Scheme.{u}) [IsAffine X] (C : Set X), IsClopen C →
      ∃ e : Γ(X, ⊤), ∀ φ : X ⟶ X, φ.appTop.hom e = e → ∀ y ∈ C, φ.base.hom y ∈ C := by
    intro X _ C hC
    let h := Scheme.homeoOfIso X.isoSpec
    have hs : IsClopen (h.symm ⁻¹' C) := hC.preimage h.symm.continuous
    obtain ⟨e, -, he⟩ := PrimeSpectrum.isClopen_iff.mp hs
    have hCe : C = (X.basicOpen e : Set X) := by
      ext y
      have hy : h y = X.toSpecΓ.base y := by
        simp [h, Scheme.homeoOfIso_apply, Scheme.isoSpec_hom]
      have h2 : y ∈ (X.basicOpen e : Set X) ↔
          X.toSpecΓ.base y ∈ (PrimeSpectrum.basicOpen e : Set (PrimeSpectrum Γ(X, ⊤))) := by
        rw [← Scheme.toSpecΓ_preimage_basicOpen]
        exact Iff.rfl
      rw [h2, ← hy]
      have h3 : h y ∈ (h.symm ⁻¹' C) ↔ y ∈ C := by
        show h.symm (h y) ∈ C ↔ y ∈ C
        rw [Homeomorph.symm_apply_apply]
      rw [he] at h3
      exact h3.symm
    refine ⟨e, fun φ hφ y hy => ?_⟩
    rw [hCe] at hy ⊢
    have : y ∈ φ ⁻¹ᵁ X.basicOpen e := by rw [Scheme.preimage_basicOpen_top, hφ]; exact hy
    exact this

  have s2 : ∀ {P X Y Z : Scheme.{u}} (a : P ⟶ X) (b : P ⟶ Y) (f : X ⟶ Z) (g : Y ⟶ Z)
      (_ : IsPullback a b f g) [IsAffine X] [IsAffine Y] [IsAffine Z]
      (S : Subring Γ(P, ⊤)) (_ : ∀ r, a.appTop.hom r ∈ S) (_ : ∀ r, b.appTop.hom r ∈ S),
      ∀ e, e ∈ S := by
    intro P X Y Z a b f g h _ _ _ S ha hb
    have : ∀ i, IsAffine ((Limits.cospan f g).obj i) := by
      rintro (_ | _ | _) <;> dsimp <;> infer_instance
    have hpo : IsPushout g.appTop f.appTop b.appTop a.appTop := (h.map Scheme.Γ.rightOp).unop
    let ιS : CommRingCat.of S ⟶ Γ(P, ⊤) := CommRingCat.ofHom S.subtype
    let a' : Γ(X, ⊤) ⟶ CommRingCat.of S := CommRingCat.ofHom (a.appTop.hom.codRestrict S ha)
    let b' : Γ(Y, ⊤) ⟶ CommRingCat.of S := CommRingCat.ofHom (b.appTop.hom.codRestrict S hb)
    have hw : g.appTop ≫ b' = f.appTop ≫ a' := by
      ext r
      change b.appTop.hom (g.appTop.hom r) = a.appTop.hom (f.appTop.hom r)
      rw [← happ, ← happ, h.w]
    have hb' : b' ≫ ιS = b.appTop := by ext r; rfl
    have ha' : a' ≫ ιS = a.appTop := by ext r; rfl
    have hd : hpo.desc b' a' hw ≫ ιS = 𝟙 _ := by
      apply hpo.hom_ext
      · rw [← Category.assoc, hpo.inl_desc, hb', Category.comp_id]
      · rw [← Category.assoc, hpo.inr_desc, ha', Category.comp_id]
    intro e
    have h2 : ιS.hom ((hpo.desc b' a' hw).hom e) = e := by
      rw [← CommRingCat.comp_apply, hd]; rfl
    rw [← h2]
    exact ((hpo.desc b' a' hw).hom e).2

  haveI hπaff : IsAffineHom T.πi :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) T.hT.flip (isAffineHom_of_isAffine _)
  haveI hfaff : IsAffineHom (Limits.pullback.fst V.hom T.πi) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom)
      (IsPullback.of_hasPullback V.hom T.πi).flip hπaff
  obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤)
    (show (Limits.pullback.fst V.hom T.πi).base.hom x ∈ (⊤ : V.left.Opens) by simp)
  have hU : IsAffineOpen (Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W) :=
    hW.preimage (Limits.pullback.fst V.hom T.πi)
  have hinv : ∀ κ : Limits.pullback V.hom T.πi ⟶ Limits.pullback V.hom T.πi,
      κ ≫ Limits.pullback.fst V.hom T.πi = Limits.pullback.fst V.hom T.πi →
      ∀ x' ∈ ((Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W : (Limits.pullback V.hom T.πi).Opens) :
        Set ↥(Limits.pullback V.hom T.πi)),
      κ.base.hom x' ∈ ((Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W :
        (Limits.pullback V.hom T.πi).Opens) : Set ↥(Limits.pullback V.hom T.πi)) := by
    intro κ hκ x' hx'
    have e1 : (Limits.pullback.fst V.hom T.πi).base.hom (κ.base.hom x') =
        (Limits.pullback.fst V.hom T.πi).base.hom x' := by rw [← hcb, hκ]
    change (Limits.pullback.fst V.hom T.πi).base.hom (κ.base.hom x') ∈ W
    rw [e1]
    exact hx'
  refine ⟨((Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W : (Limits.pullback V.hom T.πi).Opens) :
    Set ↥(Limits.pullback V.hom T.πi)), (Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).isOpen,
    hxW, hU.isCompact, hinv, ?_⟩
  intro ε hε
  haveI : IsAffine (W : V.left.Opens).toScheme := hW
  haveI : IsAffine (Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).toScheme := hU

  have hsq : IsPullback (Limits.pullback.fst V.hom T.πi ∣_ W)
      ((Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).ι ≫ Limits.pullback.snd V.hom T.πi ≫ T.gi)
      (W.ι ≫ V.hom ≫ T.g₀)
      (Spec.map (CommRingCat.ofHom (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom))) := by
    have := ((isPullback_morphismRestrict (Limits.pullback.fst V.hom T.πi) W).paste_vert
      (IsPullback.of_hasPullback V.hom T.πi)).paste_vert T.hT
    simpa only [Category.assoc] using this

  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : ℕ → Set ((Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).toScheme ⟶
      (Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).toScheme), ∀ k φ, φ ∈ Ψ k ↔
      ∃ z : ℤ_[ℓ], PadicInt.toZModPow k z = 0 ∧
        ∃ κ : Limits.pullback V.hom T.πi ⟶ Limits.pullback V.hom T.πi,
          κ ≫ Limits.pullback.fst V.hom T.πi = Limits.pullback.fst V.hom T.πi ∧
          κ ≫ Limits.pullback.snd V.hom T.πi = Limits.pullback.snd V.hom T.πi ≫ γ z ∧
