    apply Limits.pullback.hom_ext
    · refine Eq.trans ?_ (Limits.pullback.lift_fst _ _ _).symm
      refine (Category.assoc _ _ _).trans ?_
      change (α.app W).left ≫ Limits.pullback.fst (Limits.pullback.snd W.hom f) w ≫
        Limits.pullback.fst W.hom f = Limits.pullback.fst W.hom f
      rw [hαW]
      refine (Category.assoc _ _ _).trans ?_
      refine (whisker_eq _ (Limits.pullbackLeftPullbackSndIso_inv_fst W.hom f w)).trans ?_
      exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
    · refine Eq.trans ?_ (Limits.pullback.lift_snd _ _ _).symm
      refine (Category.assoc _ _ _).trans ?_
      change (α.app W).left ≫ Limits.pullback.fst (Limits.pullback.snd W.hom f) w ≫
        Limits.pullback.snd W.hom f = Limits.pullback.snd W.hom f ≫ w
      refine (whisker_eq _ (Limits.pullback.condition (f := Limits.pullback.snd W.hom f)
        (g := w))).trans ?_
      refine (Category.assoc _ _ _).symm.trans ?_
      refine eq_whisker ?_ w
      rw [hαW]
      refine (Category.assoc _ _ _).trans ?_
      refine (whisker_eq _ (Limits.pullbackLeftPullbackSndIso_inv_snd_snd W.hom f w)).trans ?_
      exact (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)

  choose Pf ev hnat hadd using fun V : S'.ProEt =>
    sheafOfModules_free_yoneda (Scheme.ProEt.topology S') (wcRingSheaf S' ℓ) V
  let Pm : ∀ (V V' : S'.ProEt), (V' ⟶ V) → (Pf V' ⟶ Pf V) := fun V V' b =>
    (ev V' (Pf V)).symm (((Pf V).val.map b.op).hom (ev V (Pf V) (𝟙 _)))
  have hpre : ∀ (V V' : S'.ProEt) (b : V' ⟶ V) (M : SheafOfModules.{u+1} (wcRingSheaf S' ℓ))
      (g : Pf V ⟶ M), ev V' M (Pm V V' b ≫ g) = (M.val.map b.op).hom (ev V M g) := by
    intro V V' b M g
    rw [hnat V' (Pf V) M g (Pm V V' b)]
    have e1 : ev V' (Pf V) (Pm V V' b) = ((Pf V).val.map b.op).hom (ev V (Pf V) (𝟙 _)) :=
      Equiv.apply_symm_apply _ _
    rw [e1]
    have e2 : ev V M g = (g.val.app (Opposite.op V)).hom (ev V (Pf V) (𝟙 _)) := by
      rw [← hnat V (Pf V) M g (𝟙 _), Category.id_comp]
    rw [e2]
    exact PresheafOfModules.naturality_apply g.val b.op _

  obtain ⟨Θ, hNat, hBC⟩ := wc_tsf_corep_theta_bc S' ℓ Dw hDw Pf Pm ev hnat hpre

  obtain ⟨Λ', hΛ⟩ := wc_tsf_sections_cocycle hcomp Df hDf Dw hDw I n Pf ev hnat hadd Pm hpre
    hφ t hLP W hW
  obtain ⟨z, hz⟩ := CochainComplex.HomComplex.CohomologyClass.mk_surjective (Λ' x)
  obtain ⟨z', hz'1, hz'2⟩ := hΛ z
  have hx : x = Λ'.symm (CochainComplex.HomComplex.CohomologyClass.mk z) := by
    rw [hz, AddEquiv.symm_apply_apply]
  have hTx : Λ' (((HomologicalComplex.homologyMap T (n : ℤ)).val.app (Opposite.op W)).hom x) =
      CochainComplex.HomComplex.CohomologyClass.mk z' := by
    rw [hx]
    exact hz'2

  have h1 := wc_tsf_ext_class_conj Dw.Φ I _ n t hLP _ z z' hz'1

  obtain ⟨Dα, hDα⟩ := wc_hm_pull_data_exists (α.app W).left ℓ
  obtain ⟨Dfst, hDfst⟩ :=
    wc_hm_pull_data_exists (Limits.pullback.fst ((wcProEtBC f).obj W).hom w) ℓ
  obtain ⟨Dτ, hDτ⟩ := wc_hm_pull_data_exists (Limits.pullback.lift (Limits.pullback.fst W.hom f)
    (Limits.pullback.snd W.hom f ≫ w)
    (by rw [Category.assoc, hcomp, Limits.pullback.condition])) ℓ
  have key : Θ n ((wcProEtBC f).obj W)
      (I.extEquivCohomologyClass.symm (CochainComplex.HomComplex.CohomologyClass.mk z')) =
      Θ n ((wcProEtBC f).obj W)
        (I.extEquivCohomologyClass.symm (CochainComplex.HomComplex.CohomologyClass.mk z)) := by
    rw [h1, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero,
      hNat n ((wcProEtBC w).obj ((wcProEtBC f).obj W)) ((wcProEtBC f).obj W) (α.app W) Dα hDα,
      hBC n ((wcProEtBC f).obj W) Dfst hDfst]
    exact (wc_hm_pull_comp _ _ _ hk Dfst hDfst Dα hDα Dτ hDτ n _).symm.trans (hyp Dτ hDτ _)
  have hinj : Function.Injective (fun h : (K.homology (n : ℤ)).val.obj (Opposite.op W) =>
      Θ n ((wcProEtBC f).obj W) (I.extEquivCohomologyClass.symm (Λ' h))) :=
    (Θ n ((wcProEtBC f).obj W)).injective.comp
      (I.extEquivCohomologyClass.symm.injective.comp Λ'.injective)
  apply hinj
  show Θ n ((wcProEtBC f).obj W) (I.extEquivCohomologyClass.symm (Λ'
      (((HomologicalComplex.homologyMap T (n : ℤ)).val.app (Opposite.op W)).hom x))) =
    Θ n ((wcProEtBC f).obj W) (I.extEquivCohomologyClass.symm (Λ' x))
  rw [hTx, ← hz]
  exact key

theorem wc_hm_pull_id_of_zmod_pull_id : ∀ {T : Scheme.{u}} [CompactSpace T] [QuasiSeparatedSpace T]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (w : T ⟶ T) (D : wcHMPullData w ℓ), wcHMPullCanonical D →
    @wcLim1Zero (fun k => wcZModProEtExt T (ℓ ^ k) 0) (fun _ => inferInstance)
      (fun k => wcIntRedTau T ℓ k 0) →
    (∀ k : ℕ, 1 ≤ k → ∀ (Dk : wcZModPullData w (ℓ ^ k)), wcZModPullCanonical Dk →
      ∀ h : wcZModProEtExt T (ℓ ^ k) 1, wcZModPull Dk 1 h = h) →
    ∀ x : wcHM T ℓ 1, wcHMPull D 1 x = x :=
by
  intro T _ _ ℓ _ w D hD hlim hzmod x
  obtain ⟨E, hE⟩ := wc_int_rat_data_exists T ℓ
  obtain ⟨DΛ, hDΛ⟩ := wc_int_pull_data_exists w ℓ
  choose Dk hDk using fun k : ℕ => wc_zmod_pull_data_exists w (ℓ ^ k)
  obtain ⟨hTr, ht⟩ := wc_int_red_transfer T ℓ
  have hρ : ∀ y, wcIntRho E 1 (wcIntPull DΛ 1 y) = wcHMPull D 1 (wcIntRho E 1 y) :=
    wc_int_rat_pull_compat ℓ w D hD DΛ hDΛ E hE E hE 1
  have hred := (wc_int_red_pull_compat ℓ w DΛ Dk hTr ht hTr ht
    (fun k => wc_int_zmod_pull_restrict_iso ℓ w k DΛ hDΛ (Dk k) (hDk k)) 1).1
  have hsep := (wc_int_red_milnor T ℓ hTr ht 1).2.2.1 hlim
  obtain ⟨hS1, hS2, -, hS4⟩ := wc_hmScalar_laws T ℓ 1
  obtain ⟨n, y, hy⟩ := (wc_int_rat_rationalization T ℓ E hE 1).1 x
  have hfix : wcIntPull DΛ 1 y = y := by
    rw [← sub_eq_zero]
    apply hsep
    intro k hk
    rw [map_sub, hred k y, hzmod k hk (Dk k) (hDk k) (wcIntRed T ℓ k 1 y), sub_self]
  have hPc : wcHMPull D 1 (wcHMScalar T ℓ 1 ((ℓ : ℚ_[ℓ]) ^ n) x) =
      wcHMScalar T ℓ 1 ((ℓ : ℚ_[ℓ]) ^ n) x := by
    rw [hy, ← hρ, hfix]
  have hcz : ∀ z, wcHMScalar T ℓ 1 ((ℓ : ℚ_[ℓ]) ^ n) z = (ℓ ^ n : ℕ) • z := fun z => by
    rw [hS4, Nat.cast_pow]
  rw [hcz, map_nsmul] at hPc
  have he1 : (ℓ ^ n : ℕ) • (wcHMPull D 1 x - x) = 0 := by
    rw [smul_sub, hPc, sub_self]
  have he2 : wcHMScalar T ℓ 1 ((ℓ : ℚ_[ℓ]) ^ n) (wcHMPull D 1 x - x) = 0 := by
    rw [hcz, he1]
  have hc0 : ((ℓ : ℚ_[ℓ]) ^ n) ≠ 0 :=
    pow_ne_zero n (Nat.cast_ne_zero.mpr (Fact.out : Nat.Prime ℓ).ne_zero)
  have he : wcHMPull D 1 x - x = 0 := by
    rw [← hS2 (wcHMPull D 1 x - x), ← mul_inv_cancel₀ hc0, ← hS1, he2, map_zero]
  exact sub_eq_zero.mp he

theorem wc_zmod_deg0_lim1_zero : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)],
    @wcLim1Zero (fun k => wcZModProEtExt S (ℓ ^ k) 0) (fun _ => inferInstance)
      (fun k => wcIntRedTau S ℓ k 0) :=
by
  intro S ℓ _
  classical

  have hGlim : ∀ (R₀ : Sheaf (Scheme.ProEt.topology S) RingCat.{u+1})
      (K' : Type) [SmallCategory K'] [FinCategory K'],
      Limits.PreservesLimitsOfShape K' (SheafOfModules.toSheaf.{u+1} R₀) := by
    intro R₀ K' _ _
    haveI : Limits.PreservesLimitsOfShape K'
        (SheafOfModules.forget.{u+1} R₀ ⋙ PresheafOfModules.toPresheaf.{u+1} R₀.obj) :=
      inferInstance
    haveI : Limits.PreservesLimitsOfShape K'
        (SheafOfModules.toSheaf.{u+1} R₀ ⋙
          sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
      Limits.preservesLimitsOfShape_of_natIso
        (Iso.refl _ : SheafOfModules.forget.{u+1} R₀ ⋙ PresheafOfModules.toPresheaf.{u+1} R₀.obj ≅ _)
    exact Limits.preservesLimitsOfShape_of_reflects_of_preserves _
      (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
  have hexact : ∀ (R R' : Sheaf (Scheme.ProEt.topology S) RingCat.{u+1}) (φ : R ⟶ R'),
      (SheafOfModules.restrictScalars.{u+1} φ).Additive ∧
        Limits.PreservesFiniteLimits (SheafOfModules.restrictScalars.{u+1} φ) ∧
        Limits.PreservesFiniteColimits (SheafOfModules.restrictScalars.{u+1} φ) := by
    intro R R' φ
    haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R) :=
      sheafOfModules_toSheaf_preservesFiniteColimits _ R
    haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} R') :=
      sheafOfModules_toSheaf_preservesFiniteColimits _ R'
    haveI : (SheafOfModules.toSheaf.{u+1} R).ReflectsMonomorphisms :=
      Functor.reflectsMonomorphisms_of_faithful _
    haveI : (SheafOfModules.toSheaf.{u+1} R).ReflectsEpimorphisms :=
      Functor.reflectsEpimorphisms_of_faithful _
    haveI : (SheafOfModules.toSheaf.{u+1} R).ReflectsIsomorphisms :=
      reflectsIsomorphisms_of_reflectsMonomorphisms_of_reflectsEpimorphisms _
    let θ : SheafOfModules.restrictScalars.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} R ≅
        SheafOfModules.toSheaf.{u+1} R' := Iso.refl _
    refine ⟨inferInstance, ⟨fun K' _ _ => ?_⟩, ⟨fun K' _ _ => ?_⟩⟩
    · haveI := hGlim R K'
      haveI := hGlim R' K'
      haveI : Limits.ReflectsLimitsOfShape K' (SheafOfModules.toSheaf.{u+1} R) :=
        Limits.reflectsLimitsOfShape_of_reflectsIsomorphisms
      haveI : Limits.PreservesLimitsOfShape K'
          (SheafOfModules.restrictScalars.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} R) :=
        Limits.preservesLimitsOfShape_of_natIso θ.symm
      exact Limits.preservesLimitsOfShape_of_reflects_of_preserves _
        (SheafOfModules.toSheaf.{u+1} R)
    · haveI : Limits.ReflectsColimitsOfShape K' (SheafOfModules.toSheaf.{u+1} R) :=
        Limits.reflectsColimitsOfShape_of_reflectsIsomorphisms
      haveI : Limits.PreservesColimitsOfShape K'
          (SheafOfModules.restrictScalars.{u+1} φ ⋙ SheafOfModules.toSheaf.{u+1} R) :=
        Limits.preservesColimitsOfShape_of_natIso θ.symm
      exact Limits.preservesColimitsOfShape_of_reflects_of_preserves _
        (SheafOfModules.toSheaf.{u+1} R)

  have hsurj : ∀ k : ℕ, Function.Surjective (wcIntRedTau S ℓ k 0) := by
    letI : HasExt (SheafOfModules.{u+1} (wcIntRingSheaf S ℓ)) := HasExt.standard _
    letI hZ : ∀ N : ℕ, HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S N)) :=
      fun N => HasExt.standard _

    have hEnd : ∀ (N : ℕ) (e : SheafOfModules.unit (wcZModRingSheaf S N) ⟶
        SheafOfModules.unit (wcZModRingSheaf S N)),
        ∃ r0 : C(↥S, ULift.{u+1} (ZMod N)), e = wcZModFun S N r0 := by
      intro N e
      let T : S.ProEt := Scheme.ProEt.mk (𝟙 S)
      let s := SheafOfModules.unitHomEquiv _ e
      refine ⟨s.1 (Opposite.op T), ?_⟩
      apply (SheafOfModules.unitHomEquiv _).injective
      apply PresheafOfModules.sections_ext
      intro W
      let g : W.unop ⟶ T := MorphismProperty.Over.homMk W.unop.hom (Category.comp_id _) trivial
      have hg : ((SheafOfModules.unitHomEquiv _) (wcZModFun S N (s.1 (Opposite.op T)))).1 W =
          ((s.1 (Opposite.op T) : C(↥S, ULift.{u+1} (ZMod N))).comp
            (Opposite.unop W).hom.base.hom :
            C(↥((Opposite.unop W).left), ULift.{u+1} (ZMod N))) := by
        simp only [wcZModFun, Equiv.apply_symm_apply]
        rfl
      rw [hg]
      refine (PresheafOfModules.sections_property s g.op).symm.trans ?_
      rfl
    obtain ⟨hTr, ht⟩ := wc_int_red_transfer S ℓ
    have hTau : ∀ (k j : ℕ) (b : wcZModProEtExt S (ℓ ^ (k + 1)) j), wcIntRedTau S ℓ k j b =
        (AddEquiv.ofBijective (wcIntRedTr S ℓ k j) (hTr k j)).symm
          ((wcIntRedTr S ℓ (k + 1) j b).comp (Abelian.Ext.mk₀ (Classical.choose (ht k)))
            (add_zero j)) := by
      intro k j b
      rw [wcIntRedTau, dif_pos ⟨hTr k j, ht k⟩]
      rfl
    have hTr1 : ∀ k : ℕ, wcIntRedTr S ℓ k 0 (Abelian.Ext.mk₀ (𝟙 _)) =
        Abelian.Ext.mk₀ (wcUnitRestrict (wcIntZModRingSheafMap S ℓ k)) := by
      intro k
      have hX : wcIntResExact S ℓ k := hexact _ _ (wcIntZModRingSheafMap S ℓ k)
      haveI := hX.1
      haveI := hX.2.1
      haveI := hX.2.2
      have hT : wcIntRedTr S ℓ k 0 (Abelian.Ext.mk₀ (𝟙 _)) =
          (Abelian.Ext.mk₀ (wcUnitRestrict (wcIntZModRingSheafMap S ℓ k))).comp
            (Abelian.Ext.mapExactFunctor
              (SheafOfModules.restrictScalars.{u+1} (wcIntZModRingSheafMap S ℓ k))
              (Abelian.Ext.mk₀ (𝟙 _))) (zero_add 0) := by
        rw [wcIntRedTr, dif_pos hX]
        rfl
      rw [hT, Abelian.Ext.mapExactFunctor_mk₀, CategoryTheory.Functor.map_id,
        Abelian.Ext.mk₀_comp_mk₀, Category.comp_id]
    have hτ1 : ∀ k : ℕ, wcIntRedTau S ℓ k 0 (Abelian.Ext.mk₀ (𝟙 _)) =
        Abelian.Ext.mk₀ (𝟙 _) := by
      intro k
      rw [hTau, AddEquiv.symm_apply_eq, AddEquiv.ofBijective_apply, hTr1, hTr1,
        Abelian.Ext.mk₀_comp_mk₀, Classical.choose_spec (ht k)]
    intro k a
    obtain ⟨e₀, rfl⟩ := (Abelian.Ext.mk₀_bijective _ _).2 a
    obtain ⟨r₀, rfl⟩ := hEnd (ℓ ^ k) e₀
    let r₁ : C(↥S, ULift.{u+1} (ZMod (ℓ ^ (k + 1)))) :=
      ⟨fun t => ULift.up (((r₀ t).down.val : ℕ) : ZMod (ℓ ^ (k + 1))),
        continuous_uliftUp.comp ((continuous_of_discreteTopology
          (f := fun a : ZMod (ℓ ^ k) => ((a.val : ℕ) : ZMod (ℓ ^ (k + 1))))).comp
          (continuous_uliftDown.comp r₀.continuous))⟩
    have hc : ∀ t, (r₀ t).down =
        ZMod.castHom (pow_dvd_pow ℓ (Nat.le_succ k)) (ZMod (ℓ ^ k)) (r₁ t).down := by
      intro t
      show _ = ZMod.castHom _ _ (((r₀ t).down.val : ℕ) : ZMod (ℓ ^ (k + 1)))
      rw [map_natCast, ZMod.natCast_zmod_val]
    refine ⟨Abelian.Ext.mk₀ (wcZModFun S (ℓ ^ (k + 1)) r₁), ?_⟩
    have h3' := (wc_int_red_act S ℓ hTr ht 0).2.2 k 0 r₁ r₀ hc (Abelian.Ext.mk₀ (𝟙 _))
    rw [Abelian.Ext.mk₀_comp_mk₀, Category.comp_id, hτ1, Abelian.Ext.mk₀_comp_mk₀,
      Category.comp_id] at h3'
    exact h3'

  intro β
  let f : ∀ q : ℕ, wcZModProEtExt S (ℓ ^ (q + 1)) 0 := fun q =>
    Nat.rec (motive := fun q => wcZModProEtExt S (ℓ ^ (q + 1)) 0) 0
      (fun q fq => Function.surjInv (hsurj (q + 1)) (fq - β (q + 1))) q
  refine ⟨fun k => Nat.casesOn (motive := fun k => wcZModProEtExt S (ℓ ^ k) 0) k 0
    (fun q => f q), fun k hk => ?_⟩
  cases k with
  | zero => omega
  | succ q =>
    show β (q + 1) = f q - wcIntRedTau S ℓ (q + 1) 0 (f (q + 1))
    have hq : wcIntRedTau S ℓ (q + 1) 0 (f (q + 1)) = f q - β (q + 1) :=
      Function.surjInv_eq (hsurj (q + 1)) _
    rw [hq, sub_sub_cancel]

theorem wc_zmod_wlocal_kill_of_stalks : ∀ {W₀ T : Scheme.{u}}, IsAffine W₀ →
    IsClosed {x : W₀ | IsClosed ({x} : Set W₀)} →
    (∀ x : W₀, ∃! y : W₀, IsClosed ({y} : Set W₀) ∧ x ⤳ y) →
    ∀ (g : T ⟶ W₀), QuasiCompact g → QuasiSeparated g →
    ∀ (n j : ℕ) (h : wcZModProEtExt T n j),
    (∀ z : W₀, IsClosed ({z} : Set W₀) →
      ∀ (Dz : wcZModPullData (Limits.pullback.snd (W₀.fromSpecStalk z) g) n),
      wcZModPullCanonical Dz → wcZModPull Dz j h = 0) → h = 0 :=
by
  classical
  intro W₀ T haff hc hu g hqc hqs n j h hloc
  haveI : IsAffine W₀ := haff
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf T n)) := HasExt.standard _

  have hFunOne : ∀ (S : Scheme.{u}) (m : ℕ), wcZModFun S m 1 = 𝟙 _ := by
    intro S m
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    rw [← SheafOfModules.unitHomEquiv_apply_coe]
    simp only [wcZModFun, Equiv.apply_symm_apply]
    rfl
  have hFunMul : ∀ (S : Scheme.{u}) (m : ℕ) (r r' : C(↥S, ULift.{u+1} (ZMod m))),
      wcZModFun S m (r * r') = wcZModFun S m r ≫ wcZModFun S m r' := by
    intro S m r r'
    apply (SheafOfModules.unitHomEquiv _).injective
    rw [SheafOfModules.unitHomEquiv_comp_apply]
    apply Subtype.ext
    funext V
    have hvalP : ∀ c : C(↥S, ULift.{u+1} (ZMod m)),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun S m c)).1 V =
        (c.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod m))) := by
      intro c
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    show _ = ((wcZModFun S m r').val.app V).hom (((SheafOfModules.unitHomEquiv _) (wcZModFun S m r)).1 V)
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  have hFunAdd : ∀ (S : Scheme.{u}) (m : ℕ) (r r' : C(↥S, ULift.{u+1} (ZMod m))),
      wcZModFun S m (r + r') = wcZModFun S m r + wcZModFun S m r' := by
    intro S m r r'
    apply (SheafOfModules.unitHomEquiv _).injective
    apply Subtype.ext
    funext V
    have hvalP : ∀ c : C(↥S, ULift.{u+1} (ZMod m)),
        ((SheafOfModules.unitHomEquiv _) (wcZModFun S m c)).1 V =
        (c.comp (Opposite.unop V).hom.base.hom :
          C(↥((Opposite.unop V).left), ULift.{u+1} (ZMod m))) := by
      intro c
      simp only [wcZModFun, Equiv.apply_symm_apply]
      rfl
    rw [hvalP, SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.add_val,
      PresheafOfModules.add_app]
    show _ = ((SheafOfModules.unitHomEquiv _) (wcZModFun S m r)).1 V +
      ((SheafOfModules.unitHomEquiv _) (wcZModFun S m r')).1 V
    rw [hvalP, hvalP]
    apply ContinuousMap.ext
    intro x
    rfl
  obtain ⟨χ, hχdef⟩ : ∃ χ : ∀ O : Set W₀, IsClopen O → C(↥T, ULift.{u+1} (ZMod n)),
      ∀ (O : Set W₀) (hO : IsClopen O), χ O hO =
        (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hO).toContinuousMap.comp g.base.hom :=
    ⟨_, fun _ _ => rfl⟩
  have hχ : ∀ (O : Set W₀) (hO : IsClopen O) (x : ↥T),
      χ O hO x = O.indicator 1 (g.base.hom x) := by
    intro O hO x
    rw [hχdef]
    show (LocallyConstant.charFn (ULift.{u+1} (ZMod n)) hO) (g.base.hom x) = _
    rw [LocallyConstant.coe_charFn]
  obtain ⟨e, he⟩ : ∃ e : ∀ O : Set W₀, IsClopen O →
      (wcZModProEtExt T n j →+ wcZModProEtExt T n j),
      ∀ (O : Set W₀) (hO : IsClopen O) h, e O hO h =
        (Abelian.Ext.mk₀ (wcZModFun T n (χ O hO))).comp h (zero_add j) :=
    ⟨fun O hO => (Abelian.Ext.mk₀ (wcZModFun T n (χ O hO))).precomp _ (zero_add j),
      fun _ _ _ => rfl⟩
  have G0 : ∀ (r r' : C(↥T, ULift.{u+1} (ZMod n))), r = r' →
      ∀ h : wcZModProEtExt T n j,
      (Abelian.Ext.mk₀ (wcZModFun T n r)).comp h (zero_add j) =
        (Abelian.Ext.mk₀ (wcZModFun T n r')).comp h (zero_add j) := by
    intro r r' hr h
    subst hr
    rfl
  have G1 : ∀ (r : C(↥T, ULift.{u+1} (ZMod n))), r = 1 →
      ∀ h : wcZModProEtExt T n j,
      (Abelian.Ext.mk₀ (wcZModFun T n r)).comp h (zero_add j) = h := by
    intro r hr h
    subst hr
    rw [hFunOne]
    exact Abelian.Ext.mk₀_id_comp h
  have G2 : ∀ (r r1 r2 : C(↥T, ULift.{u+1} (ZMod n))), r = r1 * r2 →
      ∀ h : wcZModProEtExt T n j,
      (Abelian.Ext.mk₀ (wcZModFun T n r)).comp h (zero_add j) =
        (Abelian.Ext.mk₀ (wcZModFun T n r1)).comp
          ((Abelian.Ext.mk₀ (wcZModFun T n r2)).comp h (zero_add j)) (zero_add j) := by
    intro r r1 r2 hr h
    subst hr
    rw [hFunMul, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
  have G3 : ∀ (r r1 r2 : C(↥T, ULift.{u+1} (ZMod n))), r = r1 + r2 →
      ∀ h : wcZModProEtExt T n j,
      (Abelian.Ext.mk₀ (wcZModFun T n r)).comp h (zero_add j) =
        (Abelian.Ext.mk₀ (wcZModFun T n r1)).comp h (zero_add j) +
          (Abelian.Ext.mk₀ (wcZModFun T n r2)).comp h (zero_add j) := by
    intro r r1 r2 hr h
    subst hr
    rw [hFunAdd, Abelian.Ext.mk₀_add, Abelian.Ext.add_comp]
  have he1 : ∀ h, e Set.univ isClopen_univ h = h := by
    intro h
    have hf : χ Set.univ isClopen_univ = 1 :=
      ContinuousMap.ext fun x => (hχ _ _ x).trans (congrFun (Set.indicator_univ _) _)
    exact (he _ _ h).trans (G1 _ hf h)
  have hei : ∀ (O O' : Set W₀) (hO : IsClopen O) (hO' : IsClopen O') h,
      e (O ∩ O') (hO.inter hO') h = e O hO (e O' hO' h) := by
    intro O O' hO hO' h
    have hf : χ (O ∩ O') (hO.inter hO') = χ O hO * χ O' hO' :=
      ContinuousMap.ext fun x => (hχ _ _ x).trans
        ((congrFun (Set.inter_indicator_one (M₀ := ULift.{u+1} (ZMod n)) (s := O) (t := O')) _).trans
          (congrArg₂ (· * ·) (hχ O hO x) (hχ O' hO' x)).symm)
    exact (he _ _ h).trans ((G2 _ _ _ hf h).trans
      ((congrArg (fun y => (Abelian.Ext.mk₀ (wcZModFun T n (χ O hO))).comp y
          (zero_add j)) (he O' hO' h).symm).trans (he O hO _).symm))
  have heu : ∀ (O O' : Set W₀) (hO : IsClopen O) (hO' : IsClopen O'), Disjoint O O' → ∀ h,
      e (O ∪ O') (hO.union hO') h = e O hO h + e O' hO' h := by
    intro O O' hO hO' hdisj h
    have hf : χ (O ∪ O') (hO.union hO') = χ O hO + χ O' hO' :=
      ContinuousMap.ext fun x => (hχ _ _ x).trans
        ((congrFun (Set.indicator_union_of_disjoint hdisj (1 : W₀ → ULift.{u+1} (ZMod n))) _).trans
          (congrArg₂ (· + ·) (hχ O hO x) (hχ O' hO' x)).symm)
    exact (he _ _ h).trans ((G3 _ _ _ hf h).trans
      (congrArg₂ (· + ·) (he O hO h).symm (he O' hO' h).symm))

  have hs : ∀ z : W₀, IsClosed ({z} : Set W₀) →
      ∃ (V : Set W₀) (hV : IsClopen V), z ∈ V ∧ e V hV h = 0 := by
    intro z hz
    obtain ⟨Dz, hDz⟩ := wc_zmod_pull_data_exists
      (Limits.pullback.snd (W₀.fromSpecStalk z) g) n
    obtain ⟨V, hV, hzV, hV0⟩ := wc_zmod_wlocal_closed_point_continuity haff hc hu g hqc hqs n j
      z hz Dz hDz h (hloc z hz Dz hDz)
    exact ⟨V, hV, hzV, (he _ _ _).trans ((G0 _ _ (hχdef V hV) _).trans hV0)⟩

  have hcong : ∀ (S S' : Set W₀) (hS : IsClopen S) (hS' : IsClopen S'), S = S' →
      e S hS h = e S' hS' h := by
    intro S S' hS hS' hSS
    subst hSS
    rfl
  have hempty : e ∅ isClopen_empty h = 0 := by
    have h1 := heu ∅ ∅ isClopen_empty isClopen_empty (Set.disjoint_empty _) h
    have h2 : e ∅ isClopen_empty h = e ∅ isClopen_empty h + e ∅ isClopen_empty h :=
      (hcong (∅ ∪ ∅) ∅ (isClopen_empty.union isClopen_empty) isClopen_empty
        (Set.union_self _)).symm.trans h1
    exact left_eq_add.mp h2
  have hunion : ∀ (V V' : Set W₀) (hV : IsClopen V) (hV' : IsClopen V'),
      e V hV h = 0 → e V' hV' h = 0 → e (V ∪ V') (hV.union hV') h = 0 := by
    intro V V' hV hV' h0 h0'
    have hW : e (Vᶜ ∩ V') (hV.compl.inter hV') h = 0 := by
      rw [hei Vᶜ V' hV.compl hV', h0', map_zero]
    have hdisj : Disjoint V (Vᶜ ∩ V') :=
      Set.disjoint_left.mpr (fun x hx hx' => hx'.1 hx)
    have hset : V ∪ (Vᶜ ∩ V') = V ∪ V' := by
      ext x
      by_cases hx : x ∈ V <;> simp [hx]
    calc e (V ∪ V') (hV.union hV') h
        = e (V ∪ (Vᶜ ∩ V')) (hV.union (hV.compl.inter hV')) h :=
          hcong _ _ _ _ hset.symm
      _ = e V hV h + e (Vᶜ ∩ V') (hV.compl.inter hV') h := heu _ _ _ _ hdisj h
      _ = 0 := by rw [h0, hW, add_zero]
  have hZ : ∀ x : W₀, ∃ z : W₀, IsClosed ({z} : Set W₀) ∧ x ⤳ z := by
    intro x
    obtain ⟨y, hy, _⟩ := hu x
    exact ⟨y, hy.1, hy.2⟩
  choose zf hzZ hxz using hZ
  choose Vf hVf hzV hV0 using fun x => hs (zf x) (hzZ x)
  have hxV : ∀ x, x ∈ Vf x := fun x => (hxz x).mem_open (hVf x).isOpen (hzV x)
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover Vf (fun x => (hVf x).isOpen)
    (fun x _ => Set.mem_iUnion.mpr ⟨x, hxV x⟩)
  have hind : ∀ s : Finset W₀, ∀ hS : IsClopen (⋃ x ∈ s, Vf x), e _ hS h = 0 := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      intro hS
      exact (hcong _ ∅ hS isClopen_empty (by simp)).trans hempty
    | insert a s ha ih =>
      intro hS
      have hc' : IsClopen (⋃ x ∈ s, Vf x) := isClopen_biUnion_finset (fun x _ => hVf x)
      exact (hcong _ _ hS ((hVf a).union hc') (Finset.set_biUnion_insert _ _ _)).trans
        (hunion _ _ _ _ (hV0 a) (ih hc'))
  have hU : (⋃ x ∈ t, Vf x) = Set.univ := Set.univ_subset_iff.mp ht
  calc h = e Set.univ isClopen_univ h := (he1 h).symm
    _ = e (⋃ x ∈ t, Vf x) (isClopen_biUnion_finset (fun x _ => hVf x)) h :=
        hcong _ _ _ _ hU.symm
    _ = 0 := hind t _

theorem wc_qsfx_offdouble_proet_vanish : ∀ (A' : Type u) [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A') →
    ∀ (π' : A'), IsLocalRing.maximalIdeal A' = Ideal.span {π'} →
    ∀ (r : ℕ) (C : Type u) [CommRing C] [HenselianLocalRing C]
      [IsSepClosed (IsLocalRing.ResidueField C)]
      (a : Spec (.of C) ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))),
    WeaklyEtale a →
    wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)
        (a (IsLocalRing.closedPoint C)) = IsLocalRing.closedPoint A' →
    ∀ (L' : Type u) [Field L'] [IsSepClosed L'] (φ' : A' →+* L'), Function.Injective φ' →
    (letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L') →
    ∀ (Pq : Scheme.{u}) (q1 : Pq ⟶ Spec (.of C)) (qL : Pq ⟶ Spec (.of L')),
    IsPullback q1 qL (a ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom φ')) →
    ¬ (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈
        PrimeSpectrum.asIdeal (a (IsLocalRing.closedPoint C)) ∧
      Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈
        PrimeSpectrum.asIdeal (a (IsLocalRing.closedPoint C))) →
    ∀ k : ℕ, 1 ≤ k → Subsingleton (wcZModProEtExt Pq (ℓ ^ k) 1) :=
by
  intro A' _ _ _ _ _ ℓ _ hℓ' π' hπ' r C _ _ _ a ha hcl L' _ _ φ' hφ'i halg' Pq q1 qL hT hD k hk
  classical
  have hM : IsUnit (((ℓ ^ k : ℕ)) : A') := by
    rw [Nat.cast_pow]; exact hℓ'.pow k
  obtain ⟨U, hyU, hU⟩ := wc_qmssl_offdouble_smooth A' r π' (a (IsLocalRing.closedPoint C))
    (not_and_or.mp hD)
  obtain ⟨B, _, _, _, Λ, _, _, W', φ, ash, e, h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_et_geom_strict_henselization (a (IsLocalRing.closedPoint C))
  have hsh : wcHalShData (a (IsLocalRing.closedPoint C)) B Λ W' φ ash :=
    ⟨h1, h2, h3, h4, h5, e, h6, h7⟩
  have h1m := (wc_smooth_open_shens_milnor_fibre_acyclic A' _
    (wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
    U hU (ℓ ^ k) hM _ hyU hcl B Λ W' φ ash hsh (AlgebraicClosure L')
    (Spec.map (CommRingCat.ofHom (algebraMap L' (AlgebraicClosure L'))) ≫
      Spec.map (CommRingCat.ofHom φ'))).2 1 le_rfl

  obtain ⟨ε, -, hε⟩ := @wc_pltr_wet_residue_geom_point _ (a (IsLocalRing.closedPoint C))
    C _ inferInstance a ha rfl
  have hp : (Spec.map (CommRingCat.ofHom ε))
      (IsLocalRing.closedPoint (AlgebraicClosure
        ((Spec (.of (wcQuadModelRing A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))).residueField
          (a (IsLocalRing.closedPoint C))))) =
      IsLocalRing.closedPoint (IsLocalRing.ResidueField C) :=
    @Subsingleton.elim (PrimeSpectrum (IsLocalRing.ResidueField C)) inferInstance _ _
  have hres : (Spec.map (CommRingCat.ofHom (IsLocalRing.residue C)))
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField C)) = IsLocalRing.closedPoint C := by
    first
      | exact IsLocalRing.comap_closedPoint (IsLocalRing.residue C)
      | (show (Spec.map (CommRingCat.ofHom (IsLocalRing.residue C))).base _ = _
         rw [Spec.map_base]
         exact IsLocalRing.comap_closedPoint (IsLocalRing.residue C))
  have hq : (Spec.map (CommRingCat.ofHom ε) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue C)))
      (IsLocalRing.closedPoint (AlgebraicClosure
        ((Spec (.of (wcQuadModelRing A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))).residueField
          (a (IsLocalRing.closedPoint C))))) = IsLocalRing.closedPoint C :=
    (Scheme.Hom.comp_apply _ _ _).trans
      ((congrArg (fun p => (Spec.map (CommRingCat.ofHom (IsLocalRing.residue C))) p) hp).trans hres)
  obtain ⟨δ, hδ, -⟩ := @wc_shdata_lift_geom_point _ _ B _ inferInstance Λ _ _ W' φ ash hsh
    C _ inferInstance inferInstance a
    (Spec.map (CommRingCat.ofHom ε) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue C))) hq
    ((Category.assoc _ _ _).trans hε)
  haveI hδi : IsIso δ := @wc_pltr_shens_lift_iso _ _ B _ inferInstance inferInstance Λ _ _
    W' φ ash hsh C _ inferInstance a ha rfl δ hδ

  obtain ⟨e1⟩ := wc_et_coh_iso_invariance (Limits.pullbackLeftPullbackSndIso
    (ash ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
    (Spec.map (CommRingCat.ofHom φ'))
    (Spec.map (CommRingCat.ofHom (algebraMap L' (AlgebraicClosure L'))))).hom (ℓ ^ k) 1
  have h2m := @Equiv.subsingleton _ _ e1.symm h1m
  obtain ⟨e2⟩ := wc_et_coh_purely_inseparable_invariance L' (AlgebraicClosure L')
    (fun x => Algebra.IsIntegral.isIntegral x) _
    (Limits.pullback.snd (ash ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom φ'))) (ℓ ^ k) 1
  have h3m := @Equiv.subsingleton _ _ e2.symm h2m

  have eq₁ : (a ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) ≫ 𝟙 _ =
      δ ≫ ash ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) := by
    first
      | (rw [Category.comp_id, ← Category.assoc, hδ])
      | (rw [Category.comp_id, ← hδ, Category.assoc])
      | (simp only [Category.comp_id, ← Category.assoc, hδ])
  have eq₂ : Spec.map (CommRingCat.ofHom φ') ≫ 𝟙 _ = 𝟙 _ ≫ Spec.map (CommRingCat.ofHom φ') := by
    simp
  haveI hm1 : IsIso (Limits.pullback.map (a ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom φ'))
      (ash ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom φ')) δ (𝟙 _) (𝟙 _) eq₁ eq₂) :=
    Limits.pullback.map_isIso _ _ _ _ _ _ _ _ _
  obtain ⟨e3⟩ := wc_et_coh_iso_invariance (Limits.pullback.map (a ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom φ'))
      (ash ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom φ')) δ (𝟙 _) (𝟙 _) eq₁ eq₂) (ℓ ^ k) 1
  have h4m := @Equiv.subsingleton _ _ e3.symm h3m

  obtain ⟨e4⟩ := wc_et_coh_iso_invariance hT.isoPullback.hom (ℓ ^ k) 1
  have hEt : Subsingleton (wcEtCoh Pq (ℓ ^ k) 1) := @Equiv.subsingleton _ _ e4.symm h4m

  haveI : IsAffineHom q1 :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) hT.flip (isAffineHom_of_isAffine _)
  haveI : IsAffine Pq := isAffine_of_isAffineHom q1
  obtain ⟨Θ, hΘ, -⟩ := wc_zmod_et_proet_natural_comparison_all (ℓ ^ k) 1
  obtain ⟨E⟩ := wc_et_zmodext_coh_equiv Pq (ℓ ^ k) 1
  haveI : Subsingleton (wcEtZModExt Pq (ℓ ^ k) 1) := E.subsingleton
  exact (hΘ Pq inferInstance inferInstance).2.subsingleton

theorem wc_qsfx_double_proet_card : ∀ (A' : Type u) [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
