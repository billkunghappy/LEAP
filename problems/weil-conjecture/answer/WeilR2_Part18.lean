theorem wc_tq_closed_counit_iso {S Z : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i] (m : ℕ)
    (Di : wcZModPullData i m) (hDi : wcZModPullCanonical Di)
    (M : SheafOfModules.{u+1} (wcZModRingSheaf Z m)) : IsIso (Di.adj.counit.app M) :=
by
  classical

  have transport : ∀ {F G : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}} (H : F ⟶ G)
      {T₁ T₂ : Z.ProEt} (φ : T₁ ≅ T₂),
      Function.Bijective (H.hom.app (Opposite.op T₁)).hom →
        Function.Bijective (H.hom.app (Opposite.op T₂)).hom := by
    intro F G H T₁ T₂ φ h
    have e1 : H.hom.app (Opposite.op T₂) =
        F.obj.map φ.hom.op ≫ H.hom.app (Opposite.op T₁) ≫ G.obj.map φ.inv.op := by
      rw [← Category.assoc, H.hom.naturality, Category.assoc, ← G.obj.map_comp, ← op_comp,
        φ.inv_hom_id, op_id, G.obj.map_id, Category.comp_id]
    have hF : Function.Bijective (F.obj.map φ.hom.op).hom :=
      ConcreteCategory.bijective_of_isIso (F.obj.map φ.hom.op)
    have hG : Function.Bijective (G.obj.map φ.inv.op).hom :=
      ConcreteCategory.bijective_of_isIso (G.obj.map φ.inv.op)
    rw [e1, AddCommGrpCat.hom_comp, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
      AddMonoidHom.coe_comp]
    exact (hG.comp h).comp hF
  letI := Di.cont
  haveI hα : IsIso ((SheafOfModules.toSheaf (wcZModRingSheaf Z m)).map (Di.adj.counit.app M)) := by
    apply wc_proet_isIso_of_sections_bijective
    intro U
    refine (Scheme.ProEt.topology Z).superset_covering (Sieve.generate_mono ?_)
      (wc_proet_wcontr_affine_open_cover i U)
    rintro T f ⟨⟨O, hO, hTO⟩, hT⟩
    obtain ⟨A, iA, I, iI, Vt, e, c, κ, hsq, hV, hiV⟩ :=
      wc_proet_henselian_thickening_exists i T O hO hTO hT
    have hinit : ∀ V : S.ProEt,
        Function.Bijective (fun a : Vt ⟶ V => (wcProEtBaseChange i).map a) := by
      intro V
      refine wc_proet_thickening_bc_hom_bijective i A I Vt e c hsq ?_ V
      intro X S' g _ a b hab
      exact wc_weaklyEtale_henselian_lift g A I a b hab

    have hη : ∀ N : SheafOfModules.{u+1} (wcZModRingSheaf S m),
        Function.Bijective ((Di.adj.unit.app N).val.app (Opposite.op Vt)).hom := by
      intro N
      apply wc_tq_zmod_pull_unit_bij_of_lan i m Di hDi
        (wc_tq_zmod_contfun_pullback_locally_bijective i m) Vt N
      refine Function.Bijective.comp ?_
        (wc_proet_lan_unit_bijective_of_init i Vt hinit N.val.presheaf)
      apply wc_proet_toSheafify_bijective_wcontr Z _ _ hiV
      intro m' Q ι hι hpart
      obtain ⟨Vk, ιt, κk, hιt, hpt, hκ, hthick⟩ :=
        wc_proet_thickening_clopen_lift i A I Vt e c hsq m' Q ι hι hpart
      refine wc_proet_lan_clopen_additive i Vt ((SheafOfModules.toSheaf (wcZModRingSheaf S m)).obj N)
        m' Q ι Vk ιt κk hιt hpt hκ
        (wc_proet_lan_unit_bijective_of_init i Vt hinit N.val.presheaf) (fun k => ?_)
      obtain ⟨Ak, iAk, Ik, iIk, ek, ck, hsqk⟩ := hthick k
      refine wc_proet_lan_unit_bijective_of_init i (Vk k) (fun V => ?_) N.val.presheaf
      refine wc_proet_thickening_bc_hom_bijective i Ak Ik (Vk k) ek ck hsqk ?_ V
      intro X S' g _ a b hab
      exact wc_weaklyEtale_henselian_lift g Ak Ik a b hab

    have hηM := hη ((SheafOfModules.pushforward Di.φ).obj M)
    have hl : ∀ x : ((SheafOfModules.pushforward Di.φ).obj M).val.obj (Opposite.op Vt),
        ((Di.adj.counit.app M).val.app (Opposite.op ((wcProEtBC i).obj Vt))).hom
          (((Di.adj.unit.app ((SheafOfModules.pushforward Di.φ).obj M)).val.app
            (Opposite.op Vt)).hom x) = x := by
      intro x
      have h := congrArg (fun k => (k.val.app (Opposite.op Vt)).hom x)
        (Di.adj.right_triangle_components M)
      exact h
    have hg : Function.Bijective
        ((Di.adj.counit.app M).val.app (Opposite.op ((wcProEtBC i).obj Vt))).hom := by
      constructor
      · intro y₁ y₂ hy
        obtain ⟨x₁, hx₁⟩ := hηM.2 y₁
        obtain ⟨x₂, hx₂⟩ := hηM.2 y₂
        subst hx₁ hx₂
        have e1 := hl x₁
        have e2 := hl x₂
        rw [hy] at e1
        rw [← e1, e2]
      · intro x
        exact ⟨_, hl x⟩
    have hBC : Function.Bijective
        ((((SheafOfModules.toSheaf (wcZModRingSheaf Z m)).map (Di.adj.counit.app M)).hom.app
          (Opposite.op ((wcProEtBC i).obj Vt))).hom) := by
      have e : ⇑((((SheafOfModules.toSheaf (wcZModRingSheaf Z m)).map (Di.adj.counit.app M)).hom.app
          (Opposite.op ((wcProEtBC i).obj Vt))).hom) =
          ⇑((Di.adj.counit.app M).val.app (Opposite.op ((wcProEtBC i).obj Vt))).hom := by
        funext x
        rfl
      rw [e]
      exact hg

    exact transport _ κ hBC
  exact isIso_of_reflects_iso _ (SheafOfModules.toSheaf (wcZModRingSheaf Z m))

theorem wc_tq_classical_mod_ker_coker (S : Scheme.{u}) (m : ℕ)
    {A B : SheafOfModules.{u+1} (wcZModRingSheaf S m)} (f : A ⟶ B)
    (hA : wcZModClassicalMod S m A) (hB : wcZModClassicalMod S m B) :
    wcZModClassicalMod S m (Limits.kernel f) ∧ wcZModClassicalMod S m (Limits.cokernel f) :=
by
  unfold wcZModClassicalMod at hA hB ⊢
  obtain ⟨HA, hHA, ⟨α⟩⟩ := hA
  obtain ⟨HB, hHB, ⟨β⟩⟩ := hB

  haveI hcont := (wc_etToProEt_flat_cont S).2
  obtain ⟨hL0, hLlim, hLcolim⟩ := wc_epsInv_exact S
  haveI := hL0
  haveI := hLlim
  haveI := hLcolim
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology S) _

  let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt S)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)
  haveI : ∀ G, IsIso (adj.unit.app G) := fun G => wc_epsInv_unit_iso S G
  haveI : IsIso adj.unit := NatIso.isIso_of_isIso_app _
  let hff : (wcEpsInv S).FullyFaithful := adj.fullyFaithfulLOfIsIsoUnit

  have tk : ∀ {X Y : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}} (g : X ⟶ Y),
      m • 𝟙 X = 0 → m • 𝟙 (Limits.kernel g) = 0 := by
    intro X Y g h
    apply Limits.zero_of_comp_mono (Limits.kernel.ι g)
    have e : m • Limits.kernel.ι g = Limits.kernel.ι g ≫ (m • 𝟙 X) := by
      rw [Preadditive.comp_nsmul, Category.comp_id]
    rw [Preadditive.nsmul_comp, Category.id_comp, e, h, Limits.comp_zero]
  have tc : ∀ {X Y : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}} (g : X ⟶ Y),
      m • 𝟙 Y = 0 → m • 𝟙 (Limits.cokernel g) = 0 := by
    intro X Y g h
    apply Limits.zero_of_epi_comp (Limits.cokernel.π g)
    have e : m • Limits.cokernel.π g = (m • 𝟙 Y) ≫ Limits.cokernel.π g := by
      rw [Preadditive.nsmul_comp, Category.id_comp]
    rw [Preadditive.comp_nsmul, Category.comp_id, e, h, Limits.zero_comp]

  let U := SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m)
  let L := wcEpsInv S
  obtain ⟨ψ, hψ⟩ : ∃ ψ : HA ⟶ HB, L.map ψ = α.inv ≫ U.map f ≫ β.hom :=
    ⟨hff.preimage _, hff.map_preimage _⟩
  have comm : U.map f ≫ β.hom = α.hom ≫ L.map ψ := by
    rw [hψ, Iso.hom_inv_id_assoc]

  refine ⟨⟨Limits.kernel ψ, tk ψ hHA, ⟨?_⟩⟩, ⟨Limits.cokernel ψ, tc ψ hHB, ⟨?_⟩⟩⟩
  · exact Limits.PreservesKernel.iso U f ≪≫ Limits.kernel.mapIso (U.map f) (L.map ψ) α β comm ≪≫
      (Limits.PreservesKernel.iso L ψ).symm
  · exact Limits.PreservesCokernel.iso U f ≪≫
      Limits.cokernel.mapIso (U.map f) (L.map ψ) α β comm ≪≫
      (Limits.PreservesCokernel.iso L ψ).symm

theorem wc_tq_cme_nu_map_epi : ∀ (S : Scheme.{u}) [(wcEtToProEt S).IsContinuous (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)] (hVan : ∀ (H : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (V : S.Etale) (y : Abelian.Ext (wcFreeSheaf S ((wcEtToProEt S).obj V)) ((wcEpsInv S).obj H) 1), Sieve.generate (fun (V₁ : S.Etale) (c : V₁ ⟶ V) => (Abelian.Ext.mk₀ (wcFreeSheafMap S ((wcEtToProEt S).map c))).comp y (zero_add 1) = 0) ∈ Scheme.smallEtaleTopology S V) (A : ShortComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})), A.ShortExact → ∀ (H₁ : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}), (A.X₁ ≅ (wcEpsInv S).obj H₁) → Epi (((wcEtToProEt S).sheafPushforwardContinuous AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)).map A.g) :=
by
  intro S _ hVan A hA H₁ α
  obtain ⟨ev, hpost, hpre⟩ := wc_free_ext0_eval S
  rw [← Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1}]
  constructor
  intro V s
  let s' : A.X₃.obj.obj (Opposite.op ((wcEtToProEt S).obj V)) := s
  let x₃ := (ev ((wcEtToProEt S).obj V) A.X₃).symm s'
  let y := x₃.comp hA.extClass (zero_add 1)
  let y' := y.comp (Abelian.Ext.mk₀ α.hom) (add_zero 1)
  refine GrothendieckTopology.superset_covering _ ?_ (hVan H₁ V y')
  rw [Sieve.generate_le_iff]
  intro V₁ c hc
  let f := Abelian.Ext.mk₀ (wcFreeSheafMap S ((wcEtToProEt S).map c))
  have hc' : f.comp y' (zero_add 1) = 0 := hc
  have h3 : f.comp y (zero_add 1) = 0 := by
    have e1 : (f.comp y (zero_add 1)).comp (Abelian.Ext.mk₀ α.hom) (add_zero 1) = 0 := by
      rw [Abelian.Ext.comp_assoc f y (Abelian.Ext.mk₀ α.hom) (zero_add 1) (add_zero 1) (by omega)]
      exact hc'
    have e2 : f.comp y (zero_add 1) =
        ((f.comp y (zero_add 1)).comp (Abelian.Ext.mk₀ α.hom) (add_zero 1)).comp
          (Abelian.Ext.mk₀ α.inv) (add_zero 1) := by
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (add_zero 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, α.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    rw [e2, e1, Abelian.Ext.zero_comp]
  have h4 : (f.comp x₃ (zero_add 0)).comp hA.extClass (zero_add 1) = 0 := by
    rw [Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 1) (by omega)]
    exact h3
  obtain ⟨x₂, hx₂⟩ :=
    Abelian.Ext.covariant_sequence_exact₃ _ hA (f.comp x₃ (zero_add 0)) (zero_add 1) h4
  show ∃ t, _
  refine ⟨ev ((wcEtToProEt S).obj V₁) A.X₂ x₂, ?_⟩
  change (A.g.hom.app (Opposite.op ((wcEtToProEt S).obj V₁))).hom
      (ev ((wcEtToProEt S).obj V₁) A.X₂ x₂) =
    (A.X₃.obj.map ((wcEtToProEt S).map c).op).hom s'
  rw [← hpost]
  have ep : (Abelian.Ext.mk₀ A.g).postcomp (wcFreeSheaf S ((wcEtToProEt S).obj V₁)) (add_zero 0) x₂
      = x₂.comp (Abelian.Ext.mk₀ A.g) (add_zero 0) := by
    first
      | rfl
      | simp [Abelian.Ext.postcomp, Abelian.Ext.bilinearComp_apply_apply]
  have eq : f.comp x₃ (zero_add 0) = f.precomp A.X₃ (zero_add 0) x₃ := by
    first
      | rfl
      | simp [Abelian.Ext.precomp, Abelian.Ext.bilinearComp_apply_apply]
  rw [ep, hx₂, eq, hpre, AddEquiv.apply_symm_apply]

theorem wc_tq_cme_affine_etale_sieve : ∀ (S : Scheme.{u}) (V : S.Etale), Sieve.generate (fun (V₁ : S.Etale) (_ : V₁ ⟶ V) => IsAffine V₁.left ∧ ∃ A : S.Opens, IsAffineOpen A ∧ ∃ g : V₁.left ⟶ (A : Scheme.{u}), g ≫ A.ι = V₁.hom) ∈ Scheme.smallEtaleTopology S V :=
by
  intro S V
  have hcov : ∀ (Sv : Sieve V), (∀ v : V.left, ∃ (V₁ : S.Etale) (c : V₁ ⟶ V),
      Sv.arrows c ∧ v ∈ Set.range c.left) → Sv ∈ Scheme.smallEtaleTopology S V := by
    intro Sv hS
    change Sv ∈ Scheme.smallGrothendieckTopology @Etale S V
    rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
    apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale S
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
    intro x
    obtain ⟨V₁, c, hc, y, hy⟩ := hS x
    have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
    have hEt : Etale c.left := by
      have h1 : Etale V.hom := V.prop
      have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
      exact Etale.of_comp c.left V.hom
    exact ⟨V₁, c, y, hc, hEt, hy⟩
  apply hcov
  intro v
  obtain ⟨A, hA, hvA, -⟩ := exists_isAffineOpen_mem_and_subset
    (U := (⊤ : S.Opens)) (TopologicalSpace.Opens.mem_top (V.hom v))
  have hvO : v ∈ V.hom ⁻¹ᵁ A := (Scheme.Hom.mem_preimage V.hom).mpr hvA
  obtain ⟨W, hW, hvW, hWO⟩ := exists_isAffineOpen_mem_and_subset hvO
  have hle : W ≤ V.hom ⁻¹ᵁ A := fun x hx => hWO hx
  haveI : Etale V.hom := V.prop
  let V₁ : S.Etale := MorphismProperty.Over.mk ⊤ (W.ι ≫ V.hom) inferInstance
  let c : V₁ ⟶ V := MorphismProperty.Over.homMk W.ι rfl trivial
  refine ⟨V₁, c, ?_, ?_⟩
  · apply Sieve.le_generate
    refine ⟨?_, A, hA, V.hom.resLE A W hle, ?_⟩
    · show IsAffine (W : Scheme.{u})
      exact hW
    · exact Scheme.Hom.resLE_comp_ι V.hom hle
  · show v ∈ Set.range W.ι
    rw [Scheme.Opens.range_ι]
    exact hvW

theorem wc_tq_cme_epsInv_epi_etale_local_lift : ∀ (S : Scheme.{u}) [(wcEtToProEt S).IsContinuous (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)] {E Q : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}} (π : E ⟶ Q) [Epi π] (V : S.Etale) (x : ((wcEpsInv S).obj Q).obj.obj (Opposite.op ((wcEtToProEt S).obj V))), Sieve.generate (fun (V₁ : S.Etale) (c : V₁ ⟶ V) => ∃ e : ((wcEpsInv S).obj E).obj.obj (Opposite.op ((wcEtToProEt S).obj V₁)), (((wcEpsInv S).map π).hom.app (Opposite.op ((wcEtToProEt S).obj V₁))).hom e = (((wcEpsInv S).obj Q).obj.map ((wcEtToProEt S).map c).op).hom x) ∈ Scheme.smallEtaleTopology S V :=
by
  intro S _ E Q π _ V x
  let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt S)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)
  haveI h0 : IsIso (adj.unit.app Q) := wc_epsInv_unit_iso S Q
  haveI h1 : IsIso (adj.unit.app Q).hom :=
    Functor.map_isIso (sheafToPresheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
      (adj.unit.app Q)
  haveI h2 : IsIso ((adj.unit.app Q).hom.app (Opposite.op V)) := inferInstance
  obtain ⟨q, hq⟩ :=
    (ConcreteCategory.bijective_of_isIso ((adj.unit.app Q).hom.app (Opposite.op V))).2 x
  have hls : Sheaf.IsLocallySurjective π :=
    (Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} π).2 inferInstance
  refine (Scheme.smallEtaleTopology S).superset_covering ?_
    (Presheaf.imageSieve_mem (Scheme.smallEtaleTopology S) π.hom q)
  rintro V₁ c ⟨e₀, he₀⟩
  apply Sieve.le_generate
  refine ⟨((adj.unit.app E).hom.app (Opposite.op V₁)).hom e₀, ?_⟩
  have n1 := congrArg (fun f => (f.hom.app (Opposite.op V₁)).hom e₀) (adj.unit_naturality π)
  simp only [ObjectProperty.FullSubcategory.comp_hom, NatTrans.comp_app,
    ConcreteCategory.comp_apply] at n1
  have n2 := NatTrans.naturality_apply (adj.unit.app Q).hom c.op q
  rw [he₀] at n1
  subst hq
  exact n1.trans n2

theorem wc_tq_cme_epsInv_ext1_local_vanish : ∀ (S : Scheme.{u}) [(wcEtToProEt S).IsContinuous (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)] (hAff : ∀ (V : S.Etale), Sieve.generate (fun (V₁ : S.Etale) (_ : V₁ ⟶ V) => IsAffine V₁.left ∧ ∃ A : S.Opens, IsAffineOpen A ∧ ∃ g : V₁.left ⟶ (A : Scheme.{u}), g ≫ A.ι = V₁.hom) ∈ Scheme.smallEtaleTopology S V) (hLift : ∀ {E Q : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}} (π : E ⟶ Q) [Epi π] (V : S.Etale) (x : ((wcEpsInv S).obj Q).obj.obj (Opposite.op ((wcEtToProEt S).obj V))), Sieve.generate (fun (V₁ : S.Etale) (c : V₁ ⟶ V) => ∃ e : ((wcEpsInv S).obj E).obj.obj (Opposite.op ((wcEtToProEt S).obj V₁)), (((wcEpsInv S).map π).hom.app (Opposite.op ((wcEtToProEt S).obj V₁))).hom e = (((wcEpsInv S).obj Q).obj.map ((wcEtToProEt S).map c).op).hom x) ∈ Scheme.smallEtaleTopology S V) (H : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (V : S.Etale) (y : Abelian.Ext (wcFreeSheaf S ((wcEtToProEt S).obj V)) ((wcEpsInv S).obj H) 1), Sieve.generate (fun (V₁ : S.Etale) (c : V₁ ⟶ V) => (Abelian.Ext.mk₀ (wcFreeSheafMap S ((wcEtToProEt S).map c))).comp y (zero_add 1) = 0) ∈ Scheme.smallEtaleTopology S V :=
by
  intro S _ hAff hLift H V y
  classical
  haveI := wc_et_enough_injectives S
  obtain ⟨h0, hL, hR⟩ := wc_epsInv_exact S
  haveI := h0
  haveI := hL
  haveI := hR
  obtain ⟨ev, hpost, hpre⟩ := wc_free_ext0_eval S

  have hrestr : ∀ {V₁ V₂ : S.Etale} (c₁ : V₁ ⟶ V) (c₂ : V₂ ⟶ V₁),
      (Abelian.Ext.mk₀ (wcFreeSheafMap S ((wcEtToProEt S).map (c₂ ≫ c₁)))).comp y (zero_add 1) =
      (Abelian.Ext.mk₀ (wcFreeSheafMap S ((wcEtToProEt S).map c₂))).comp
        ((Abelian.Ext.mk₀ (wcFreeSheafMap S ((wcEtToProEt S).map c₁))).comp y (zero_add 1))
        (zero_add 1) := by
    intro V₁ V₂ c₁ c₂
    have hf : wcFreeSheafMap S ((wcEtToProEt S).map (c₂ ≫ c₁)) =
        wcFreeSheafMap S ((wcEtToProEt S).map c₂) ≫ wcFreeSheafMap S ((wcEtToProEt S).map c₁) := by
      simp only [wcFreeSheafMap, Functor.map_comp, Functor.whiskerRight_comp]
      all_goals first | rfl | (congr 1)
    rw [hf, Abelian.Ext.mk₀_comp_mk₀_assoc]

  have hkill : ∀ (V₁ : S.Etale) (A : S.Opens), IsAffineOpen A → IsAffine V₁.left →
      (∃ g : V₁.left ⟶ (A : Scheme.{u}), g ≫ A.ι = V₁.hom) →
      ∀ (y₁ : Abelian.Ext (wcFreeSheaf S ((wcEtToProEt S).obj V₁)) ((wcEpsInv S).obj H) 1),
      ∃ (E Q : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (π : E ⟶ Q) (_ : Epi π)
        (x : ((wcEpsInv S).obj Q).obj.obj (Opposite.op ((wcEtToProEt S).obj V₁))),
        ∀ (V₂ : S.Etale) (c₂ : V₂ ⟶ V₁)
          (e : ((wcEpsInv S).obj E).obj.obj (Opposite.op ((wcEtToProEt S).obj V₂))),
          (((wcEpsInv S).map π).hom.app (Opposite.op ((wcEtToProEt S).obj V₂))).hom e =
            (((wcEpsInv S).obj Q).obj.map ((wcEtToProEt S).map c₂).op).hom x →
          (Abelian.Ext.mk₀ (wcFreeSheafMap S ((wcEtToProEt S).map c₂))).comp y₁ (zero_add 1) = 0 := by
    intro V₁ A hA hV₁ hg y₁
    let E := Injective.under H
    let ι : H ⟶ E := Injective.ι H
    let Q := Limits.cokernel ι
    let π : E ⟶ Q := Limits.cokernel.π ι
    haveI : Injective E := Injective.injective_under H
    let T₀ : ShortComplex (Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) :=
      ShortComplex.mk ι π (Limits.cokernel.condition ι)
    have hT₀ : T₀.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) inferInstance inferInstance
    let T := T₀.map (wcEpsInv S)
    have hT : T.ShortExact := hT₀.map_of_exact (wcEpsInv S)
    have hz : y₁.comp (Abelian.Ext.mk₀ T.f) (add_zero 1) = 0 :=
      wc_epsInv_injective_etale_affine_vanishing S A hA V₁ hV₁ hg E 0
        (y₁.comp (Abelian.Ext.mk₀ T.f) (add_zero 1))
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hT y₁ hz (n₀ := 0) (zero_add 1)
    refine ⟨E, Q, π, inferInstance, ev ((wcEtToProEt S).obj V₁) ((wcEpsInv S).obj Q) x₃, ?_⟩
    intro V₂ c₂ e he
    let x₂ := (ev ((wcEtToProEt S).obj V₂) ((wcEpsInv S).obj E)).symm e
    have h1 := hpost ((wcEtToProEt S).obj V₂) ((wcEpsInv S).obj E) ((wcEpsInv S).obj Q)
      ((wcEpsInv S).map π) x₂
    have h2 := hpre ((wcEtToProEt S).obj V₁) ((wcEtToProEt S).obj V₂) ((wcEtToProEt S).map c₂)
      ((wcEpsInv S).obj Q) x₃
    have hstar : (Abelian.Ext.mk₀ (wcFreeSheafMap S ((wcEtToProEt S).map c₂))).comp x₃ (zero_add 0) =
        x₂.comp (Abelian.Ext.mk₀ ((wcEpsInv S).map π)) (add_zero 0) := by
      apply (ev ((wcEtToProEt S).obj V₂) ((wcEpsInv S).obj Q)).injective
      have e1 : ev ((wcEtToProEt S).obj V₂) ((wcEpsInv S).obj Q)
          ((Abelian.Ext.mk₀ (wcFreeSheafMap S ((wcEtToProEt S).map c₂))).comp x₃ (zero_add 0)) =
          (((wcEpsInv S).obj Q).obj.map ((wcEtToProEt S).map c₂).op).hom
            (ev ((wcEtToProEt S).obj V₁) ((wcEpsInv S).obj Q) x₃) := h2
      have e2 : ev ((wcEtToProEt S).obj V₂) ((wcEpsInv S).obj Q)
          (x₂.comp (Abelian.Ext.mk₀ ((wcEpsInv S).map π)) (add_zero 0)) =
          (((wcEpsInv S).map π).hom.app (Opposite.op ((wcEtToProEt S).obj V₂))).hom
            (ev ((wcEtToProEt S).obj V₂) ((wcEpsInv S).obj E) x₂) := h1
      rw [e1, e2]
      have e3 : ev ((wcEtToProEt S).obj V₂) ((wcEpsInv S).obj E) x₂ = e :=
        AddEquiv.apply_symm_apply _ _
      rw [e3]
      exact he.symm
    calc (Abelian.Ext.mk₀ (wcFreeSheafMap S ((wcEtToProEt S).map c₂))).comp y₁ (zero_add 1)
        = (Abelian.Ext.mk₀ (wcFreeSheafMap S ((wcEtToProEt S).map c₂))).comp
            (x₃.comp hT.extClass (zero_add 1)) (zero_add 1) := by rw [hx₃]
      _ = ((Abelian.Ext.mk₀ (wcFreeSheafMap S ((wcEtToProEt S).map c₂))).comp x₃ (zero_add 0)).comp
            hT.extClass (zero_add 1) :=
          (Abelian.Ext.comp_assoc (Abelian.Ext.mk₀ (wcFreeSheafMap S ((wcEtToProEt S).map c₂)))
            x₃ hT.extClass (zero_add 0) (zero_add 1) (rfl : 0 + 0 + 1 = 1)).symm
      _ = (x₂.comp (Abelian.Ext.mk₀ ((wcEpsInv S).map π)) (add_zero 0)).comp
            hT.extClass (zero_add 1) := by rw [hstar]
      _ = x₂.comp ((Abelian.Ext.mk₀ T.g).comp hT.extClass (zero_add 1)) (zero_add 1) :=
          Abelian.Ext.comp_assoc x₂ (Abelian.Ext.mk₀ T.g) hT.extClass (zero_add 0) (zero_add 1)
            (rfl : 0 + 0 + 1 = 1)
      _ = x₂.comp 0 (zero_add 1) := by rw [hT.comp_extClass]
      _ = 0 := by simp

  refine GrothendieckTopology.transitive _ (hAff V) _ ?_
  intro Y f hf
  obtain ⟨V₁, h, c₁, ⟨hV₁, A, hA, g, hg⟩, rfl⟩ := hf
  rw [Sieve.pullback_comp]
  apply GrothendieckTopology.pullback_stable
  obtain ⟨E, Q, π, hπ, x, hk⟩ := hkill V₁ A hA hV₁ ⟨g, hg⟩
    ((Abelian.Ext.mk₀ (wcFreeSheafMap S ((wcEtToProEt S).map c₁))).comp y (zero_add 1))
  haveI := hπ
  refine GrothendieckTopology.superset_covering _ ?_ (hLift π V₁ x)
  rw [Sieve.generate_le_iff]
  rintro V₂ c₂ ⟨e, he⟩
  rw [Sieve.pullback_apply]
  apply Sieve.le_generate
  show (Abelian.Ext.mk₀ (wcFreeSheafMap S ((wcEtToProEt S).map (c₂ ≫ c₁)))).comp y (zero_add 1) = 0
  rw [hrestr c₁ c₂]
  exact hk V₂ c₂ e he

theorem wc_tq_classical_mod_extension (S : Scheme.{u}) (m : ℕ) (hm : 0 < m)
    (T : ShortComplex (SheafOfModules.{u+1} (wcZModRingSheaf S m))) (hT : T.ShortExact)
    (h₁ : wcZModClassicalMod S m T.X₁) (h₃ : wcZModClassicalMod S m T.X₃) :
    wcZModClassicalMod S m T.X₂ :=
by
  classical
  haveI : (wcEtToProEt S).IsContinuous (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S) :=
    (wc_etToProEt_flat_cont S).2
  obtain ⟨hε0, hεL, hεR⟩ := wc_epsInv_exact S
  obtain ⟨H₁, -, ⟨α₁⟩⟩ := h₁
  obtain ⟨H₃, -, ⟨α₃⟩⟩ := h₃
  let U := SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m)
  haveI : Limits.PreservesFiniteColimits U :=
    sheafOfModules_toSheaf_preservesFiniteColimits _ _
  let A := T.map U
  have hA : A.ShortExact := hT.map_of_exact U
  let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt S)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)
  let N := (wcEtToProEt S).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)
  let Lf := Functor.sheafPullbackConstruction.sheafPullback (wcEtToProEt S)
    AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)
  have hEq : wcEpsInv S = Lf := rfl
  haveI : Limits.PreservesLimits N := adj.rightAdjoint_preservesLimits
  haveI : N.IsRightAdjoint := adj.isRightAdjoint
  haveI : N.PreservesZeroMorphisms := Functor.preservesZeroMorphisms_of_isRightAdjoint N
  haveI : N.Additive := Functor.additive_of_preserves_binary_products N
  haveI : Lf.PreservesZeroMorphisms := hε0
  haveI : Limits.PreservesFiniteLimits Lf := hεL
  haveI : Limits.PreservesFiniteColimits Lf := hεR

  have hcounit : ∀ (X : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
      (H : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}),
      (X ≅ Lf.obj H) → IsIso (adj.counit.app X) := by
    intro X H α
    haveI : IsIso (adj.unit.app H) := wc_epsInv_unit_iso S H
    have e : Lf.map (adj.unit.app H) ≫ adj.counit.app (Lf.obj H) = 𝟙 (Lf.obj H) :=
      adj.left_triangle_components H
    haveI h1 : IsIso (adj.counit.app (Lf.obj H)) := isIso_of_hom_comp_eq_id _ e
    have hn' : Lf.map (N.map α.hom) ≫ adj.counit.app (Lf.obj H) = adj.counit.app X ≫ α.hom :=
      adj.counit.naturality α.hom
    have h3 : adj.counit.app X = (Lf.map (N.map α.hom) ≫ adj.counit.app (Lf.obj H)) ≫ α.inv := by
      rw [hn', Category.assoc, Iso.hom_inv_id, Category.comp_id]
    rw [h3]
    infer_instance

  have htors : ∀ M : SheafOfModules.{u+1} (wcZModRingSheaf S m), m • 𝟙 (U.obj M) = 0 := by
    intro M
    obtain ⟨-, -, -, hR⟩ := wc_proet_zmod_ring_locbij S m hm
    ext V x
    have key : ∀ y : ↑(M.val.obj V), m • y = 0 := fun y => by
      rw [← Nat.cast_smul_eq_nsmul ((wcZModRingSheaf S m).obj.obj V), hR V, zero_smul]
    exact key x

  have hk : Limits.IsLimit (Limits.KernelFork.ofι (N.map A.f)
      (by rw [← N.map_comp, A.zero, N.map_zero]) : Limits.KernelFork (N.map A.g)) :=
    Limits.KernelFork.mapIsLimit _ hA.fIsKernel N
  have hNex : (A.map N).Exact := ShortComplex.exact_of_f_is_kernel _ hk
  haveI : Mono (A.map N).f := Limits.mono_of_isLimit_fork hk
  haveI : Epi (A.map N).g := wc_tq_cme_nu_map_epi S
    (wc_tq_cme_epsInv_ext1_local_vanish S (wc_tq_cme_affine_etale_sieve S)
      (fun π _ V x => wc_tq_cme_epsInv_epi_etale_local_lift S π V x)) A hA H₁ α₁
  have hN : (A.map N).ShortExact := ShortComplex.ShortExact.mk' hNex inferInstance inferInstance
  have hB : ((A.map N).map Lf).ShortExact := hN.map_of_exact Lf
  let φ : (A.map N).map Lf ⟶ A :=
    { τ₁ := adj.counit.app A.X₁
      τ₂ := adj.counit.app A.X₂
      τ₃ := adj.counit.app A.X₃
      comm₁₂ := (adj.counit.naturality A.f).symm
      comm₂₃ := (adj.counit.naturality A.g).symm }
  have hi1 : IsIso φ.τ₁ := hcounit _ H₁ α₁
  have hi3 : IsIso φ.τ₃ := hcounit _ H₃ α₃
  have hi2 : IsIso φ.τ₂ := ShortComplex.isIso₂_of_shortExact_of_isIso₁₃' φ hB hA hi1 hi3
  have htN : m • 𝟙 (N.obj (U.obj T.X₂)) = 0 := by
    rw [← N.map_id, ← Functor.map_nsmul, htors, N.map_zero]
  haveI : IsIso (adj.counit.app (U.obj T.X₂)) := hi2
  exact ⟨N.obj (U.obj T.X₂), htN, ⟨(asIso (adj.counit.app (U.obj T.X₂))).symm⟩⟩

theorem wc_tq_cone_homology_ses {C : Type*} [Category C] [Abelian C] {X Y : CochainComplex C ℤ}
    (φ : X ⟶ Y) (q : ℤ) :
    ∃ (a : Limits.cokernel (HomologicalComplex.homologyMap φ q) ⟶
        (CochainComplex.mappingCone φ).homology q)
      (b : (CochainComplex.mappingCone φ).homology q ⟶
        Limits.kernel (HomologicalComplex.homologyMap φ (q + 1)))
      (w : a ≫ b = 0), (ShortComplex.mk a b w).ShortExact :=
by
  have s1 : ∀ {A B M D E : C} (f : A ⟶ B) (g : B ⟶ M) (h : M ⟶ D) (k : D ⟶ E)
      (hfg : f ≫ g = 0) (hgh : g ≫ h = 0) (hhk : h ≫ k = 0),
      (ShortComplex.mk f g hfg).Exact → (ShortComplex.mk g h hgh).Exact →
      (ShortComplex.mk h k hhk).Exact →
      ∃ (a : Limits.cokernel f ⟶ M) (b : M ⟶ Limits.kernel k) (w : a ≫ b = 0),
        (ShortComplex.mk a b w).ShortExact := by
    intro A B M D E f g h k hfg hgh hhk h₁ h₂ h₃
    let a := Limits.cokernel.desc f g hfg
    let b := Limits.kernel.lift k h hhk
    have hb : b ≫ Limits.kernel.ι k = h := Limits.kernel.lift_ι k h hhk
    have ha : Limits.cokernel.π f ≫ a = g := Limits.cokernel.π_desc f g hfg
    have hgb : g ≫ b = 0 := by
      apply (cancel_mono (Limits.kernel.ι k)).mp
      rw [Category.assoc, hb, hgh, Limits.zero_comp]
    have w : a ≫ b = 0 := by
      apply (cancel_epi (Limits.cokernel.π f)).mp
      rw [← Category.assoc, ha, hgb, Limits.comp_zero]
    refine ⟨a, b, w, ?_⟩
    have hma : Mono a := h₁.mono_cokernelDesc
    have heb : Epi b := h₃.epi_kernelLift
    have e1 : (ShortComplex.mk g b hgb).Exact := by
      let α : ShortComplex.mk g b hgb ⟶ ShortComplex.mk g h hgh :=
        { τ₁ := 𝟙 B, τ₂ := 𝟙 M, τ₃ := Limits.kernel.ι k
          comm₁₂ := by simp
          comm₂₃ := by simp [hb] }
      have : Epi α.τ₁ := by dsimp [α]; infer_instance
      have : IsIso α.τ₂ := by dsimp [α]; infer_instance
      have : Mono α.τ₃ := by dsimp [α]; infer_instance
      exact (ShortComplex.exact_iff_of_epi_of_isIso_of_mono α).mpr h₂
    have e2 : (ShortComplex.mk a b w).Exact := by
      let β : ShortComplex.mk g b hgb ⟶ ShortComplex.mk a b w :=
        { τ₁ := Limits.cokernel.π f, τ₂ := 𝟙 M, τ₃ := 𝟙 _
          comm₁₂ := by simp [ha]
          comm₂₃ := by simp }
      have : Epi β.τ₁ := by dsimp [β]; infer_instance
      have : IsIso β.τ₂ := by dsimp [β]; infer_instance
      have : Mono β.τ₃ := by dsimp [β]; infer_instance
      exact (ShortComplex.exact_iff_of_epi_of_isIso_of_mono β).mp e1
    exact ShortComplex.ShortExact.mk' e2 hma heb
  let F := HomotopyCategory.homologyFunctor C (ComplexShape.up ℤ) 0
  let T := CochainComplex.mappingCone.triangleh φ
  have hT : T ∈ distTriang _ := HomotopyCategory.mappingCone_triangleh_distinguished φ
  let eX : ∀ n : ℤ, (F.shift n).obj T.obj₁ ≅ X.homology n := fun n =>
    (HomotopyCategory.homologyFunctorFactors C (ComplexShape.up ℤ) n).app X
  let eY : ∀ n : ℤ, (F.shift n).obj T.obj₂ ≅ Y.homology n := fun n =>
    (HomotopyCategory.homologyFunctorFactors C (ComplexShape.up ℤ) n).app Y
  let eC : (F.shift q).obj T.obj₃ ≅ (CochainComplex.mappingCone φ).homology q :=
    (HomotopyCategory.homologyFunctorFactors C (ComplexShape.up ℤ) q).app _
  have sq : ∀ n : ℤ, (F.shift n).map T.mor₁ ≫ (eY n).hom =
      (eX n).hom ≫ HomologicalComplex.homologyMap φ n := fun n =>
    (HomotopyCategory.homologyFunctorFactors C (ComplexShape.up ℤ) n).hom.naturality φ
  have sq' : ∀ n : ℤ, HomologicalComplex.homologyMap φ n =
      (eX n).inv ≫ (F.shift n).map T.mor₁ ≫ (eY n).hom := by
    intro n
    rw [sq n, Iso.inv_hom_id_assoc]
  let g : Y.homology q ⟶ (CochainComplex.mappingCone φ).homology q :=
    (eY q).inv ≫ (F.shift q).map T.mor₂ ≫ eC.hom
  let h : (CochainComplex.mappingCone φ).homology q ⟶ X.homology (q + 1) :=
    eC.inv ≫ F.homologySequenceδ T q (q + 1) rfl ≫ (eX (q + 1)).hom
  have hfg : HomologicalComplex.homologyMap φ q ≫ g = 0 := by
    rw [sq' q]
    simp only [g, Category.assoc, Iso.hom_inv_id_assoc]
    rw [← Category.assoc ((F.shift q).map T.mor₁), F.homologySequence_comp T hT q,
      Limits.zero_comp, Limits.comp_zero]
  have hgh : g ≫ h = 0 := by
    simp only [g, h, Category.assoc, Iso.hom_inv_id_assoc]
    rw [← Category.assoc ((F.shift q).map T.mor₂), F.comp_homologySequenceδ T hT q (q + 1) rfl,
      Limits.zero_comp, Limits.comp_zero]
  have hhk : h ≫ HomologicalComplex.homologyMap φ (q + 1) = 0 := by
    rw [sq' (q + 1)]
    simp only [h, Category.assoc, Iso.hom_inv_id_assoc]
    rw [← Category.assoc (F.homologySequenceδ T q (q + 1) rfl),
      F.homologySequenceδ_comp T hT q (q + 1) rfl, Limits.zero_comp, Limits.comp_zero]
  have E1 : (ShortComplex.mk _ _ hfg).Exact := by
    refine (ShortComplex.exact_iff_of_iso
      (ShortComplex.isoMk (eX q) (eY q) eC (sq q).symm ?_)).mp
      (F.homologySequence_exact₂ T hT q)
    simp only [g, Iso.hom_inv_id_assoc]
  have E2 : (ShortComplex.mk _ _ hgh).Exact := by
    refine (ShortComplex.exact_iff_of_iso
      (ShortComplex.isoMk (eY q) eC (eX (q + 1)) ?_ ?_)).mp
      (F.homologySequence_exact₃ T hT q (q + 1) rfl)
    · simp only [g, Iso.hom_inv_id_assoc]
    · simp only [h, Iso.hom_inv_id_assoc]
  have E3 : (ShortComplex.mk _ _ hhk).Exact := by
    refine (ShortComplex.exact_iff_of_iso
      (ShortComplex.isoMk eC (eX (q + 1)) (eY (q + 1)) ?_ (sq (q + 1)).symm)).mp
      (F.homologySequence_exact₁ T hT q (q + 1) rfl)
    simp only [h, Iso.hom_inv_id_assoc]
  exact s1 _ g h _ hfg hgh hhk E1 E2 E3

theorem wc_tq_zmod_inj_free_ext_vanish : ∀ (S : Scheme.{u}) (m : ℕ), 0 < m → ∀ (V : S.ProEt) (J : SheafOfModules.{u+1} (wcZModRingSheaf S m)) [Injective J] (k : ℕ) (z : Abelian.Ext (wcFreeSheaf S V) ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m)).obj J) (k + 1)), z = 0 :=
by
  intro S m hm V J _ k z
  obtain ⟨αp, hp1, hp2, hp3⟩ := wc_proet_zmod_ring_locbij S m hm
  obtain ⟨hFp, hEp⟩ := sheafOfModules_toSheaf_torsion_equiv (Scheme.ProEt.topology S)
    (wcZModRingSheaf S m) m αp hp1 hp2
  haveI := hFp
  haveI : EssentiallySmall.{u+1} S.ProEt := inferInstance
  haveI : IsGrothendieckAbelian.{u+1} (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall _ _
  haveI : EnoughInjectives (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) :=
    IsGrothendieckAbelian.enoughInjectives
  obtain ⟨E, hE, j, ρ, hjρ⟩ := sheafOfModules_torsion_injective_retract (Scheme.ProEt.topology S)
    (wcZModRingSheaf S m) m hp3 hEp J
  haveI := hE
  have h := wc_exact_kernel_nsmul_ext_vanish (𝟭 (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}))
    (wcFreeSheaf S V) (wcFreeSheaf S V) (Iso.refl _) m
    (sheaf_free_yoneda_nsmul_mono (Scheme.ProEt.topology S) V m hm) E
    (sheaf_injective_nsmul_epi _ E m hm) (fun k y => Abelian.Ext.eq_zero_of_injective y) k
    (z.comp (Abelian.Ext.mk₀ j) (add_zero _))
  calc z = z.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero _) := (Abelian.Ext.comp_mk₀_id z).symm
    _ = z.comp (Abelian.Ext.mk₀ (j ≫ ρ)) (add_zero _) := by rw [hjρ]
    _ = z.comp ((Abelian.Ext.mk₀ j).comp (Abelian.Ext.mk₀ ρ) (add_zero 0)) (add_zero _) := by
      rw [Abelian.Ext.mk₀_comp_mk₀]
    _ = (z.comp (Abelian.Ext.mk₀ j) (add_zero _)).comp (Abelian.Ext.mk₀ ρ) (add_zero _) :=
      (Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega)).symm
    _ = 0 := by rw [h, Abelian.Ext.zero_comp]

theorem wc_proet_push_epsInv_injective_affine_vanishing_affHom : ∀ {X B : Scheme.{u}} (g : X ⟶ B) [IsAffineHom g] (A : B.Opens), IsAffineOpen A → ∀ (T : B.ProEt), wcAffIndEt B A T → ∀ (I : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) [Injective I] (n : ℕ) (e : Abelian.Ext (wcFreeSheaf X ((wcProEtBaseChange g).obj T)) ((wcEpsInv X).obj I) (n + 1)), e = 0 :=
by

  have hbclp : ∀ {X' Y' : Scheme.{u}} (h : X' ⟶ Y') [IsAffineHom h] (A : Type u) [CommRing A] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W : Λ ⥤ Y'.Etale) (φ : ∀ l, Spec (.of A) ⟶ (W.obj l).left) (a : Spec (.of A) ⟶ Y'), (∀ l, IsAffine (W.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (W.map t).left = φ l') → (∀ l, φ l ≫ (W.obj l).hom = a) → (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (W.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (W.map t).left = z l') → ∃! z₀ : T ⟶ Spec (.of A), ∀ l, z₀ ≫ φ l = z l) → ∀ (XZ : Scheme.{u}) (p : XZ ⟶ X') (hZ : XZ ⟶ Spec (.of A)), IsPullback p hZ h a → ∃ π : ∀ l, XZ ⟶ ((W ⋙ wcEtBaseChange h).obj l).left, (∀ l, π l ≫ ((W ⋙ wcEtBaseChange h).obj l).hom = p) ∧ (∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange h).map t).left = π l') ∧ (∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange h).obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange h).map t).left = z l') → ∃! z₀ : T ⟶ XZ, ∀ l, z₀ ≫ π l = z l) ∧ (∀ l, CompactSpace ((W ⋙ wcEtBaseChange h).obj l).left) ∧ (∀ l, QuasiSeparatedSpace ((W ⋙ wcEtBaseChange h).obj l).left) ∧ (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom ((W ⋙ wcEtBaseChange h).map t).left) ∧ CompactSpace XZ ∧ QuasiSeparatedSpace XZ ∧ XZ.IsSeparated := by
    intro X' Y' h _ A _ Λ _ _ W φ a hW hφ hφa hlim XZ p hZ hpb
    have M1 : ∀ {l l' : Λ} (t : l ⟶ l'),
        ((W ⋙ wcEtBaseChange h).map t).left ≫ Limits.pullback.fst (W.obj l').hom h =
          Limits.pullback.fst (W.obj l).hom h ≫ (W.map t).left := by
      intro l l' t
      exact Limits.pullback.lift_fst _ _ _
    have M2 : ∀ {l l' : Λ} (t : l ⟶ l'),
        ((W ⋙ wcEtBaseChange h).map t).left ≫ Limits.pullback.snd (W.obj l').hom h =
          Limits.pullback.snd (W.obj l).hom h := by
      intro l l' t
      exact Limits.pullback.lift_snd _ _ _
    have hw : p ≫ h = hZ ≫ a := hpb.w
    have wl : ∀ l, (hZ ≫ φ l) ≫ (W.obj l).hom = p ≫ h := by
      intro l
      rw [Category.assoc, hφa l, hw]
    let π : ∀ l, XZ ⟶ ((W ⋙ wcEtBaseChange h).obj l).left := fun l =>
      Limits.pullback.lift (hZ ≫ φ l) p (wl l)
    have P1 : ∀ l, π l ≫ Limits.pullback.fst (W.obj l).hom h = hZ ≫ φ l := fun l =>
      Limits.pullback.lift_fst _ _ _
    have P2 : ∀ l, π l ≫ Limits.pullback.snd (W.obj l).hom h = p := fun l =>
      Limits.pullback.lift_snd _ _ _
    have C2 : ∀ {l l' : Λ} (t : l ⟶ l'), π l ≫ ((W ⋙ wcEtBaseChange h).map t).left = π l' := by
      intro l l' t
      refine Limits.pullback.hom_ext (f := (W.obj l').hom) (g := h) ?_ ?_
      · calc (π l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫ Limits.pullback.fst (W.obj l').hom h
            = π l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
                Limits.pullback.fst (W.obj l').hom h) := Category.assoc _ _ _
          _ = π l ≫ (Limits.pullback.fst (W.obj l).hom h ≫ (W.map t).left) := whisker_eq _ (M1 t)
          _ = (π l ≫ Limits.pullback.fst (W.obj l).hom h) ≫ (W.map t).left :=
              (Category.assoc _ _ _).symm
          _ = (hZ ≫ φ l) ≫ (W.map t).left := eq_whisker (P1 l) _
          _ = hZ ≫ φ l' := by rw [Category.assoc, hφ t]
          _ = π l' ≫ Limits.pullback.fst (W.obj l').hom h := (P1 l').symm
      · calc (π l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫ Limits.pullback.snd (W.obj l').hom h
            = π l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
                Limits.pullback.snd (W.obj l').hom h) := Category.assoc _ _ _
          _ = π l ≫ Limits.pullback.snd (W.obj l).hom h := whisker_eq _ (M2 t)
          _ = p := P2 l
          _ = π l' ≫ Limits.pullback.snd (W.obj l').hom h := (P2 l').symm
    have C3 : ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ ((W ⋙ wcEtBaseChange h).obj l).left),
        (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((W ⋙ wcEtBaseChange h).map t).left = z l') →
        ∃! z₀ : T ⟶ XZ, ∀ l, z₀ ≫ π l = z l := by
      intro T z hz
      have hs : ∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ Limits.pullback.snd (W.obj l).hom h =
          z l' ≫ Limits.pullback.snd (W.obj l').hom h := by
        intro l l' t
        calc z l ≫ Limits.pullback.snd (W.obj l).hom h
            = z l ≫ (((W ⋙ wcEtBaseChange h).map t).left ≫
                Limits.pullback.snd (W.obj l').hom h) := (whisker_eq _ (M2 t)).symm
          _ = (z l ≫ ((W ⋙ wcEtBaseChange h).map t).left) ≫
                Limits.pullback.snd (W.obj l').hom h := (Category.assoc _ _ _).symm
          _ = z l' ≫ Limits.pullback.snd (W.obj l').hom h := eq_whisker (hz t) _
      obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
      have hX : ∀ l, z l ≫ Limits.pullback.snd (W.obj l).hom h =
          z l₀ ≫ Limits.pullback.snd (W.obj l₀).hom h := fun l =>
        (hs (IsCofiltered.minToLeft l l₀)).symm.trans (hs (IsCofiltered.minToRight l l₀))
      have hf : ∀ {l l' : Λ} (t : l ⟶ l'), (z l ≫ Limits.pullback.fst (W.obj l).hom h) ≫
