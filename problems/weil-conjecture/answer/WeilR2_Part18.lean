              t.comp (Limits.pullback.fst ((wcProEtBC f).obj Vt).hom g).base.hom := fun t =>
          (SheafOfModules.unitToPushforwardObjUnit_val_app_apply Dg.φ
            (X := Opposite.op ((wcProEtBC f).obj Vt)) t).trans
            (hDg ((wcProEtBC f).obj Vt) t)
        show ((wcQmtmUnit Dg).val.app (Opposite.op ((wcProEtBC f).obj Vt))).hom
          (((wcQmtmUnit Df).val.app (Opposite.op Vt)).hom s) = _
