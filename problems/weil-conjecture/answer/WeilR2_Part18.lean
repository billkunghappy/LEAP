      (Spec.map_apply (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R))).trans rfl
  have hx0 : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
      (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ y.asIdeal := by
    rw [hyI]; exact Ideal.mem_comap.mpr h0
  have hx1 : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
      (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ y.asIdeal := by
    rw [hyI]; exact Ideal.mem_comap.mpr h1

  have hy : wcQuadModelStr A (r + 2) π (wcQmtmC A r) y = IsLocalRing.closedPoint A := by
