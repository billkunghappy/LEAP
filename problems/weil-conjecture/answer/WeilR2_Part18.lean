    obtain ⟨E⟩ := wc_et_coh_iso_invariance hP.isoPullback.hom ℓ (n + 1)
    have hYet : Subsingleton (wcEtCoh ((wcProEtBC T.πi).obj W').left ℓ (n + 1)) := by
      change Subsingleton (wcEtCoh (Limits.pullback W'.hom T.πi) ℓ (n + 1))
