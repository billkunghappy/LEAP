    (φA : A →+* L) (hφA : Function.Injective φA) (halg : letI := φA.toAlgebra; Algebra.IsAlgebraic A L)
    (σ : L →+* L) (hσ : σ.comp φA = φA) (htame : wcMntTame ℓ φA σ π)
    (XE : Scheme.{u}) (p : XE ⟶ Spec (.of B)) (q : XE ⟶ Spec (.of L))
    (hpb : IsPullback p q (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) (Spec.map (CommRingCat.ofHom φA)))
    (Xs : Scheme.{u}) (ι : Xs ⟶ Spec (.of B)) (s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A)))
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) (wcQmSp A))
    (w : XE ⟶ XE) (hw₁ : w ≫ p = p) (hw₂ : w ≫ q = q ≫ Spec.map (CommRingCat.ofHom σ))
    (T : wcQmtmTower ℓ φA σ p q w (wcQmtmX a₀ ⟨0, by omega⟩))
    (Dπ : wcHMPullData T.πi ℓ) (hDπ : wcHMPullCanonical Dπ)
    (hu : wcSuppUnitMap Dπ = wcQmtmUnit Dπ)
    (Dp : wcHMPullData p ℓ) (hDp : wcHMPullCanonical Dp)
    (Dτ : wcHMPullData w ℓ) (hDτ : wcHMPullCanonical Dτ)
    (Di : wcHMPullData ι ℓ) (hDi : wcHMPullCanonical Di)
    (γN : wcSuppObj Dπ ⟶ wcSuppObj Dπ) (aN : wcSuppObj Dπ ⟶ (wcQmtmPush Dτ).obj (wcSuppObj Dπ))
    (hγs : wcQmtmGammaSec T Dπ γN) (has : wcQmtmActSec T Dπ Dτ aN)
    (hφ : wcQmtmHPhi hw₁ Dp Dτ) :
    ∃ t₁ : ℚ_[ℓ], t₁ ≠ 0 ∧
    ∀ (O : Scheme.{u}) (jO : O ⟶ Xs)
      (kO : O ⟶ Spec (.of (Localization.Away (wcQmtmX a₀ ⟨1, by omega⟩)))),
      IsPullback jO kO ι (Spec.map (CommRingCat.ofHom (algebraMap B
        (Localization.Away (wcQmtmX a₀ ⟨1, by omega⟩))))) →
      ∀ (DO : wcHMPullData jO ℓ), wcHMPullCanonical DO →
      Epi (DO.Φ.map (Di.Φ.map ((wcQmtmPush Dp).map γN) - 𝟙 _)) ∧
      ∃ h : DO.Φ.obj (Di.Φ.obj ((wcQmtmPush Dp).obj (wcSuppObj Dπ))) ⟶
          DO.Φ.obj (Di.Φ.obj ((wcQmtmPush Dp).obj (wcSuppObj Dπ))),
        DO.Φ.map (Di.Φ.map ((wcQmtmPush Dp).map aN ≫
            (wcQmtmGamma hw₁ Dp Dτ hφ).app (wcSuppObj Dπ)) - 𝟙 _) =
          DO.Φ.map (Di.Φ.map ((wcQmtmPush Dp).map γN) - 𝟙 _) ≫ h ∧
        DO.Φ.map (Di.μ.inv ≫ Di.Φ.map (wcQmtmUnit Dp ≫ (wcQmtmPush Dp).map (wcSuppUnitMap Dπ))) ≫ h =
          DO.Φ.map (wcHMConst Xs ℓ t₁ ≫ Di.μ.inv ≫
            Di.Φ.map (wcQmtmUnit Dp ≫ (wcQmtmPush Dp).map (wcSuppUnitMap Dπ))) :=
by
  classical
  haveI := Dp.additive
  haveI := Di.additive
  haveI hPadd : (wcQmtmPush Dp).Additive := Adjunction.right_adjoint_additive Dp.adj
  obtain ⟨t, z, ht, hz1, hz2, hz3⟩ := wc_qmtx1u_tame_exponent π hπ φA hφA σ hσ htame T
  obtain ⟨γs, Rs, Γ, H, hT1, hT2, hT3, hΓ, hH, hHu⟩ :=
    wc_qmtx1u_mahler_operator T Dπ hDπ γN hγs (-t)
  have hw := wc_qmtx1u_w_is_translation ℓ hℓ π hπ r a₀ ha₀ hx0 hx1 φA hφA halg σ hσ htame
    XE p q hpb Xs ι s hps w hw₁ hw₂ T Dπ hDπ Dp hDp Dτ hDτ Di hDi γN aN hγs has hφ t z hz1 hz2 hz3
    γs Rs Γ hT1 hT2 hT3 hΓ
  have hepi := wc_qmtx1u_tube_epi ℓ hℓ π hπ r a₀ ha₀ φA hφA halg σ hσ XE p q hpb Xs ι s hps
    w hw₁ hw₂ T Dπ hDπ Dp hDp Di hDi γN hγs

  have hκ : ∀ (S0 : Scheme.{u}) (W : (S0.ProEt)ᵒᵖ) (r0 : ↑((wcRingSheaf S0 ℓ).val.obj W))
      (c : ℚ_[ℓ]),
      ((wcHMConst S0 ℓ c).val.app W).hom r0 =
        r0 * (show ↑((wcRingSheaf S0 ℓ).val.obj W) from
          (ContinuousMap.const _ (ULift.up c) :
            C(↥(Opposite.unop W).left, ULift.{u+1} ℚ_[ℓ]))) := by
    intro S0 W r0 c
    rfl
  have hpc : ∀ c : ℚ_[ℓ], wcQmtmUnit Dp ≫ (wcQmtmPush Dp).map (wcHMConst XE ℓ c) =
      wcHMConst (Spec (.of B)) ℓ c ≫ wcQmtmUnit Dp := by
    intro c
    apply (SheafOfModules.unitHomEquiv _).injective
    apply PresheafOfModules.sections_ext
    intro X
    rw [SheafOfModules.unitHomEquiv_apply_coe, SheafOfModules.unitHomEquiv_apply_coe]
    cases X with
    | op V =>
    change ((wcHMConst XE ℓ c).val.app (Opposite.op ((wcProEtBC p).obj V))).hom
        ((Dp.φ.hom.app (Opposite.op V)).hom (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ]))) =
      (Dp.φ.hom.app (Opposite.op V)).hom
        (((wcHMConst (Spec (.of B)) ℓ c).val.app (Opposite.op V)).hom
          (1 : C(↥V.left, ULift.{u+1} ℚ_[ℓ])))
    refine (hκ XE _ _ c).trans ?_
    refine Eq.trans ?_ (congrArg (Dp.φ.hom.app (Opposite.op V)).hom
      (hκ (Spec (.of B)) (Opposite.op V) 1 c).symm)
    refine Eq.trans ?_ (hDp V _).symm
    first
