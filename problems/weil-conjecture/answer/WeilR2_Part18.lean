  let ψ := (HomologicalComplex.shortComplexFunctor _ (ComplexShape.up ℤ) q).map φ
  have h2 : IsIso (ShortComplex.homologyMap ((wcSecEv S ℓ W).mapShortComplex.map ψ)) := h1
  have h3 := ShortComplex.mapHomologyIso_hom_naturality ψ (wcSecEv S ℓ W)
  have h4 : IsIso ((ShortComplex.mapHomologyIso (C.sc q) (wcSecEv S ℓ W)).hom ≫
