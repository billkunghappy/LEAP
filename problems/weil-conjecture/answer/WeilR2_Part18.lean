        exact ⟨Δ, δ, h1, h2, h3, h4, h5, h6, h7⟩) W
    refine (Scheme.ProEt.topology XE).superset_covering ((Sieve.generate_le_iff _ _).2 ?_) hcov
    intro W' g hg
    obtain ⟨hA, hQW⟩ := hg
    refine ⟨W', 𝟙 _, g, ?_, Category.id_comp g⟩
    have hds' : ((I.cocomplex.d (n + 1) (n + 1 + 1)).val.app
        (Opposite.op ((wcProEtBC T.πi).obj W'))).hom
        (((I.cocomplex.X (n + 1)).val.map
          ((wcProEtBC T.πi).map g).op).hom s) = 0 := by
      erw [PresheafOfModules.naturality_apply, hs, map_zero]
      all_goals rfl
    obtain ⟨P, ev, hnat, hevadd⟩ := sheafOfModules_free_yoneda
      (Scheme.ProEt.topology T.XEi) (wcRingSheaf T.XEi ℓ) ((wcProEtBC T.πi).obj W')
    have hev0 : ∀ M, ev M 0 = 0 := fun M => by
      have h := hevadd M 0 0
