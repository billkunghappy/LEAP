        ∃ (V : Y.ProEt) (a : W' ⟶ (wcProEtBC i).obj V) (r : (wcZModRingSheaf Y m).obj.obj (Opposite.op V)),
          ((wcZModRingSheaf Z m).obj.map g.op).hom r' =
            ((wcZModRingSheaf Z m).obj.map a.op).hom ((Di.φ.hom.app (Opposite.op V)).hom r) := by
    intro V' r'
    obtain ⟨T, hT, H⟩ := hs0 V' r'
    refine ⟨T, hT, fun W' g hg => ?_⟩
    obtain ⟨V, a, r, hr⟩ := H g hg
    refine ⟨V, a, r, ?_⟩
    exact hr.trans (congrArg (fun s : C(↥(Limits.pullback V.hom i), ULift.{u+1} (ZMod m)) =>
      s.comp a.left.base.hom) (hDi V r).symm)
  have hinj : ∀ (V' : Z.ProEt) (V : Y.ProEt) (a : V' ⟶ (wcProEtBC i).obj V)
      (r : (wcZModRingSheaf Y m).obj.obj (Opposite.op V)),
      ((wcZModRingSheaf Z m).obj.map a.op).hom ((Di.φ.hom.app (Opposite.op V)).hom r) = 0 →
      ∃ T ∈ Scheme.ProEt.topology Z V', ∀ ⦃W' : Z.ProEt⦄ (g : W' ⟶ V'), T.arrows g →
        ∃ (W : Y.ProEt) (b : W ⟶ V) (a' : W' ⟶ (wcProEtBC i).obj W),
          a' ≫ (wcProEtBC i).map b = g ≫ a ∧ ((wcZModRingSheaf Y m).obj.map b.op).hom r = 0 := by
    intro V' V a r h0
    have h0' := (congrArg (fun s : C(↥(Limits.pullback V.hom i), ULift.{u+1} (ZMod m)) =>
      s.comp a.left.base.hom) (hDi V r)).symm.trans h0
    obtain ⟨T, hT, H⟩ := hi0 V' V a r h0'
    exact ⟨T, hT, fun W' g hg => H g hg⟩

  letI : Limits.HasColimitsOfSize.{u, u+1} RingCat.{u+1} :=
    Limits.hasColimitsOfSizeShrink.{u, u+1, u+1, u+1} RingCat.{u+1}
  let R₀ : (Z.ProEt)ᵒᵖ ⥤ RingCat.{u+1} := (wcProEtBC i).op.leftKanExtension (wcZModRingSheaf Y m).obj
  let ψ : (wcZModRingSheaf Y m).obj ⟶ (wcProEtBC i).op ⋙ R₀ :=
    (wcProEtBC i).op.leftKanExtensionUnit (wcZModRingSheaf Y m).obj
  let hψ : (Functor.LeftExtension.mk R₀ ψ).IsPointwiseLeftKanExtension :=
    (wcProEtBC i).op.isPointwiseLeftKanExtensionLeftKanExtensionUnit (wcZModRingSheaf Y m).obj
  haveI : R₀.IsLeftKanExtension ψ := hψ.isLeftKanExtension
  let α : R₀ ⟶ (wcZModRingSheaf Z m).obj :=
    R₀.descOfIsLeftKanExtension ψ (wcZModRingSheaf Z m).obj Di.φ.hom
  have hfac : ψ ≫ Functor.whiskerLeft (wcProEtBC i).op α = Di.φ.hom :=
    R₀.descOfIsLeftKanExtension_fac ψ (wcZModRingSheaf Z m).obj Di.φ.hom

  obtain ⟨RS, RI⟩ := wc_lan_ring_rep (wcProEtBC i) (wcZModRingSheaf Y m).obj R₀ ψ hψ
  have hAB := fun M : PresheafOfModules.{u+1} (wcZModRingSheaf Y m).obj =>
    wc_lan_ab_rep (wcProEtBC i) M.presheaf ((wcProEtBC i).op.lan.obj M.presheaf)
      ((wcProEtBC i).op.lanUnit.app M.presheaf)
      ((wcProEtBC i).op.isPointwiseLeftKanExtensionLeftKanExtensionUnit M.presheaf)
  have JR := fun M : PresheafOfModules.{u+1} (wcZModRingSheaf Y m).obj =>
    wc_lan_joint_rep (wcProEtBC i) (wcZModRingSheaf Y m).obj R₀ ψ M.presheaf
      ((wcProEtBC i).op.lan.obj M.presheaf) ((wcProEtBC i).op.lanUnit.app M.presheaf) RS (hAB M).1
  have WD := fun M : PresheafOfModules.{u+1} (wcZModRingSheaf Y m).obj =>
    wc_lan_smul_well_defined (wcProEtBC i) (wcZModRingSheaf Y m).obj R₀ ψ M
      ((wcProEtBC i).op.lan.obj M.presheaf) ((wcProEtBC i).op.lanUnit.app M.presheaf) RI (hAB M).2
  choose N e hF using fun M : PresheafOfModules.{u+1} (wcZModRingSheaf Y m).obj =>
    wc_lan_presheafOfModules_mk (wcProEtBC i) (wcZModRingSheaf Y m).obj R₀ ψ M
      ((wcProEtBC i).op.lan.obj M.presheaf) ((wcProEtBC i).op.lanUnit.app M.presheaf) (WD M) (JR M)

  obtain ⟨Λ, adjΛ, ι, hunit⟩ := s1 (wcProEtBC i) (wcZModRingSheaf Y m).obj R₀ ψ N e hF
    (fun M Y x t => by
      obtain ⟨W, b, r, _, mx, _, hx, _, ht, _⟩ := JR M Y x x t t
      exact ⟨W, b, r, mx, hx, ht⟩)

  obtain ⟨hLS, hLI⟩ := wc_lan_ring_comparison_locally_bijective (Scheme.ProEt.topology Y)
    (Scheme.ProEt.topology Z) (wcProEtBC i) (wcZModRingSheaf Y m) (wcZModRingSheaf Z m) Di.φ R₀ ψ α hfac
    RS hsurj hinj
  haveI := hLS
  haveI := hLI

  obtain ⟨ι₂⟩ := wc_presheafOfModules_pushforward_restrictScalars_iso (wcProEtBC i) ψ α Di.φ.hom hfac
  let eD : SheafOfModules.pushforward.{u+1} Di.φ ⋙ SheafOfModules.forget (wcZModRingSheaf Y m) ≅
      SheafOfModules.forget (wcZModRingSheaf Z m) ⋙ PresheafOfModules.restrictScalars α ⋙
        PresheafOfModules.pushforward.{u+1} ψ :=
    (Iso.refl _ : SheafOfModules.pushforward.{u+1} Di.φ ⋙ SheafOfModules.forget (wcZModRingSheaf Y m) ≅
      SheafOfModules.forget (wcZModRingSheaf Z m) ⋙ PresheafOfModules.pushforward.{u+1} Di.φ.hom) ≪≫
      Functor.isoWhiskerLeft (SheafOfModules.forget (wcZModRingSheaf Z m)) ι₂
  let L := SheafOfModules.forget (wcZModRingSheaf Y m) ⋙ Λ ⋙ PresheafOfModules.sheafification α
  let adjS := (adjΛ.comp (PresheafOfModules.sheafificationAdjunction α)).restrictFullyFaithful
    (SheafOfModules.fullyFaithfulForget (wcZModRingSheaf Y m)) (Functor.FullyFaithful.id _)
    (L := L) (R := SheafOfModules.pushforward.{u+1} Di.φ) (Iso.refl _) eD.symm
  have hstar := Adjunction.map_restrictFullyFaithful_unit_app
    (adjΛ.comp (PresheafOfModules.sheafificationAdjunction α))
    (SheafOfModules.fullyFaithfulForget (wcZModRingSheaf Y m)) (Functor.FullyFaithful.id _)
    (L := L) (R := SheafOfModules.pushforward.{u+1} Di.φ) (Iso.refl _) eD.symm M
  rw [Adjunction.comp_unit_app] at hstar
  have hbij : ∀ {P Q : PresheafOfModules.{u+1} (wcZModRingSheaf Y m).obj} (f : P ≅ Q)
      (X : (Y.ProEt)ᵒᵖ), Function.Bijective (f.hom.app X).hom := fun f X =>
    ConcreteCategory.bijective_of_isIso ((PresheafOfModules.evaluation _ X).mapIso f).hom
  let M' : PresheafOfModules.{u+1} (wcZModRingSheaf Y m).obj := M.val
  let smIso : sheafify (Scheme.ProEt.topology Z) ((wcProEtBC i).op.lan.obj M'.presheaf) ≅
      sheafify (Scheme.ProEt.topology Z) (Λ.obj M').presheaf :=
    { hom := sheafifyMap (Scheme.ProEt.topology Z) (ι M').inv
      inv := sheafifyMap (Scheme.ProEt.topology Z) (ι M').hom
      hom_inv_id := by rw [← sheafifyMap_comp, Iso.inv_hom_id, sheafifyMap_id]
      inv_hom_id := by rw [← sheafifyMap_comp, Iso.hom_inv_id, sheafifyMap_id] }
  have hsm : Function.Bijective
      ((sheafifyMap (Scheme.ProEt.topology Z) (ι M').inv).app
        (Opposite.op ((wcProEtBC i).obj Vt))).hom :=
    ConcreteCategory.bijective_of_isIso (smIso.app (Opposite.op ((wcProEtBC i).obj Vt))).hom
  have hc3 : Function.Bijective ((eD.symm.hom.app (L.obj M)).app (Opposite.op Vt)).hom :=
    hbij (eD.symm.app (L.obj M)) (Opposite.op Vt)
  have h' : Function.Bijective (⇑((toSheafify (Scheme.ProEt.topology Z)
        ((wcProEtBC i).op.lan.obj M'.presheaf)).app (Opposite.op ((wcProEtBC i).obj Vt))).hom ∘
      ⇑(((wcProEtBC i).op.lanUnit.app M'.presheaf).app (Opposite.op Vt)).hom) := h
  have e0 : ⇑((adjS.unit.app M).val.app (Opposite.op Vt)).hom =
      ⇑((eD.symm.hom.app (L.obj M)).app (Opposite.op Vt)).hom ∘
        (⇑((sheafifyMap (Scheme.ProEt.topology Z) (ι M').inv).app
            (Opposite.op ((wcProEtBC i).obj Vt))).hom ∘
          (⇑((toSheafify (Scheme.ProEt.topology Z)
              ((wcProEtBC i).op.lan.obj M'.presheaf)).app (Opposite.op ((wcProEtBC i).obj Vt))).hom ∘
            ⇑(((wcProEtBC i).op.lanUnit.app M'.presheaf).app (Opposite.op Vt)).hom)) := by
    funext mx
    have h1 := congrArg (fun k => (k.app (Opposite.op Vt)).hom mx) hstar
    have h2 : ((adjΛ.unit.app M').app (Opposite.op Vt)).hom mx =
        ((ι M').inv.app (Opposite.op ((wcProEtBC i).obj Vt))).hom
          ((((wcProEtBC i).op.lanUnit.app M'.presheaf).app (Opposite.op Vt)).hom mx) := by
      rw [← hunit M' Vt mx]
      exact (congrArg (fun k : (Λ.obj M').presheaf ⟶ (Λ.obj M').presheaf =>
        (k.app (Opposite.op ((wcProEtBC i).obj Vt))).hom
          (((adjΛ.unit.app M').app (Opposite.op Vt)).hom mx)) (ι M').hom_inv_id).symm
    have h3 := congrArg (fun k => (k.app (Opposite.op ((wcProEtBC i).obj Vt))).hom
        (((adjΛ.unit.app M').app (Opposite.op Vt)).hom mx))
      (PresheafOfModules.toPresheaf_map_sheafificationAdjunction_unit_app α (Λ.obj M'))
    have h4 := congrArg (fun k => (k.app (Opposite.op ((wcProEtBC i).obj Vt))).hom
        ((((wcProEtBC i).op.lanUnit.app M'.presheaf).app (Opposite.op Vt)).hom mx))
      (toSheafify_naturality (Scheme.ProEt.topology Z) (ι M').inv)
    refine h1.trans (congrArg (fun y => ((eD.symm.hom.app (L.obj M)).app (Opposite.op Vt)).hom y) ?_)
    refine h3.trans ?_
    refine (congrArg (fun z => ((toSheafify (Scheme.ProEt.topology Z) (Λ.obj M').presheaf).app
      (Opposite.op ((wcProEtBC i).obj Vt))).hom z) h2).trans ?_
    exact h4
  have hS : Function.Bijective ((adjS.unit.app M).val.app (Opposite.op Vt)).hom := by
    rw [e0]
    exact hc3.comp (hsm.comp h')

  have huniq := Adjunction.unit_leftAdjointUniq_hom_app adjS Di.adj M
  have hc4 : Function.Bijective (((SheafOfModules.pushforward.{u+1} Di.φ).map
      ((adjS.leftAdjointUniq Di.adj).hom.app M)).val.app (Opposite.op Vt)).hom :=
    hbij ((SheafOfModules.forget _).mapIso
      ((SheafOfModules.pushforward.{u+1} Di.φ).mapIso ((adjS.leftAdjointUniq Di.adj).app M)))
      (Opposite.op Vt)
  have e1 : ⇑((Di.adj.unit.app M).val.app (Opposite.op Vt)).hom =
      ⇑(((SheafOfModules.pushforward.{u+1} Di.φ).map
        ((adjS.leftAdjointUniq Di.adj).hom.app M)).val.app (Opposite.op Vt)).hom ∘
        ⇑((adjS.unit.app M).val.app (Opposite.op Vt)).hom := by
    funext x
