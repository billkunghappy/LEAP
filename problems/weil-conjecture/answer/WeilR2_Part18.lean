theorem wc_qmel_free_hom_lift : ∀ (S : Scheme.{u}) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (L : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⥤ SheafOfModules.{u+1} (wcRingSheaf S ℓ)) (adj : L ⊣ SheafOfModules.toSheaf (wcRingSheaf S ℓ)) (ε : L.obj (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) ≅ SheafOfModules.unit (wcRingSheaf S ℓ)) {V : S.ProEt} (g : V ⟶ Scheme.ProEt.mk (𝟙 S)) (M : SheafOfModules.{u+1} (wcRingSheaf S ℓ)), (∀ s : M.val.obj (Opposite.op V), ∃ t : M.val.obj (Opposite.op (Scheme.ProEt.mk (𝟙 S))), (M.val.map g.op).hom t = s) → ∀ φ : L.obj (wcFreeSheaf S V) ⟶ M, ∃ t : SheafOfModules.unit (wcRingSheaf S ℓ) ⟶ M, (L.map (wcFreeSheafMap S g) ≫ ε.hom) ≫ t = φ :=
by
  intro S ℓ _ L adj ε V g M hsurj φ
  have hY : ∃ η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T),
      (∀ (T : S.ProEt) (G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
          (s : G.obj.obj (Opposite.op T)),
        ∃! g : wcFreeSheaf S T ⟶ G, (g.hom.app (Opposite.op T)).hom (η T) = s) ∧
      ∀ (T T' : S.ProEt) (c : T' ⟶ T),
        ((wcFreeSheafMap S c).hom.app (Opposite.op T')).hom (η T') =
          ((wcFreeSheaf S T).obj.map c.op).hom (η T) := by
    let J := Scheme.ProEt.topology S
    let η : ∀ T : S.ProEt, (wcFreeSheaf S T).obj.obj (Opposite.op T) :=
      fun T => ((toSheafify J (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)).app
        (Opposite.op T)).hom (FreeAbelianGroup.of (ULift.up (𝟙 T)))
    let e : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}),
        (wcFreeSheaf S T ⟶ G) ≃ G.obj.obj (Opposite.op T) := fun T G =>
      ((sheafificationAdjunction J AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) G).trans
        (((Adjunction.whiskerRight (S.ProEt)ᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
            (yoneda.obj T ⋙ uliftFunctor.{u+1, u}) G.obj).trans
          (uliftYonedaEquiv.{u+1} (X := T) (F := G.obj ⋙ forget AddCommGrpCat.{u+1})))
    have he : ∀ (T : S.ProEt) (G : Sheaf J AddCommGrpCat.{u+1}) (g : wcFreeSheaf S T ⟶ G),
        e T G g = (g.hom.app (Opposite.op T)).hom (η T) := fun _ _ _ => rfl
    refine ⟨η, fun T G s => ⟨(e T G).symm s, ?_, fun g hg => (e T G).injective ?_⟩, fun T T' c => ?_⟩
    · exact (he T G _).symm.trans (Equiv.apply_symm_apply _ _)
    · exact (he T G g).trans (hg.trans (Equiv.apply_symm_apply _ _).symm)
    · let P := yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let P' := yoneda.obj T' ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
      let w : P' ⟶ P :=
        Functor.whiskerRight (yoneda.map c) (uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free)
      let x' : P'.obj (Opposite.op T') := FreeAbelianGroup.of (ULift.up (𝟙 T'))
      let x : P.obj (Opposite.op T) := FreeAbelianGroup.of (ULift.up (𝟙 T))
      have h1 : ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
          (Opposite.op T')).hom x') = ((toSheafify J P).app (Opposite.op T')).hom
            ((w.app (Opposite.op T')).hom x') :=
        (ConcreteCategory.congr_hom
          (congrArg (fun φ => φ.app (Opposite.op T')) (toSheafify_naturality J w)) x').symm
      have h2 : (w.app (Opposite.op T')).hom x' = (P.map c.op).hom x := by
        change FreeAbelianGroup.map _ (FreeAbelianGroup.of _) =
          FreeAbelianGroup.map _ (FreeAbelianGroup.of _)
        refine (FreeAbelianGroup.map_of_apply _).trans
          (Eq.trans ?_ (FreeAbelianGroup.map_of_apply _).symm)
        congr 1
      have hn : ((toSheafify J P).app (Opposite.op T')).hom ((P.map c.op).hom x) =
          ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x) :=
        NatTrans.naturality_apply (toSheafify J P) c.op x
      change ((sheafifyMap J w).app (Opposite.op T')).hom (((toSheafify J P').app
          (Opposite.op T')).hom x') =
        ((sheafify J P).map c.op).hom (((toSheafify J P).app (Opposite.op T)).hom x)
      rw [h1, h2, hn]
  obtain ⟨η, hY1, hY2⟩ := hY
  let F := (SheafOfModules.toSheaf (wcRingSheaf S ℓ)).obj M
  let φb : wcFreeSheaf S V ⟶ F := adj.homEquiv _ _ φ
  let s : F.obj.obj (Opposite.op V) := (φb.hom.app (Opposite.op V)).hom (η V)
  obtain ⟨t₀, ht₀⟩ := hsurj s
  obtain ⟨ψb, hψ, -⟩ := hY1 (Scheme.ProEt.mk (𝟙 S)) F t₀
  have h1 := hY2 (Scheme.ProEt.mk (𝟙 S)) V g
  have h2 : (ψb.hom.app (Opposite.op V)).hom
      (((wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))).obj.map g.op).hom (η (Scheme.ProEt.mk (𝟙 S)))) =
      (F.obj.map g.op).hom ((ψb.hom.app (Opposite.op (Scheme.ProEt.mk (𝟙 S)))).hom
        (η (Scheme.ProEt.mk (𝟙 S)))) :=
    NatTrans.naturality_apply ψb.hom g.op (η (Scheme.ProEt.mk (𝟙 S)))
  have hkey : (((wcFreeSheafMap S g ≫ ψb).hom).app (Opposite.op V)).hom (η V) = s := by
    change (ψb.hom.app (Opposite.op V)).hom
      (((wcFreeSheafMap S g).hom.app (Opposite.op V)).hom (η V)) = s
    rw [h1, h2, hψ]
    exact ht₀
  have hfac : wcFreeSheafMap S g ≫ ψb = φb := (hY1 V F s).unique hkey rfl
  refine ⟨ε.inv ≫ (adj.homEquiv _ _).symm ψb, ?_⟩
  rw [Category.assoc, Iso.hom_inv_id_assoc, ← Adjunction.homEquiv_naturality_left_symm, hfac]
  exact (adj.homEquiv _ _).symm_apply_apply φ

theorem wc_qmel_supp_restrict_surj : ∀ {X D : Scheme.{u}} (i : D ⟶ X) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (E : wcHMPullData i ℓ), wcHMPullCanonical E → ∀ (O : X.Opens) (g : (Scheme.ProEt.mk O.ι : X.ProEt) ⟶ Scheme.ProEt.mk (𝟙 X)), _root_.IsPreconnected (i ⁻¹' (O : Set X)) → ∀ s : (wcSuppObj E).val.obj (Opposite.op (Scheme.ProEt.mk O.ι : X.ProEt)), ∃ t : (wcSuppObj E).val.obj (Opposite.op (Scheme.ProEt.mk (𝟙 X) : X.ProEt)), ((wcSuppObj E).val.map g.op).hom t = s :=
by
  intro X D i ℓ _ E _ O g hpre s
  classical
  let s' : C(↥(Limits.pullback O.ι i), ULift.{u+1} ℚ_[ℓ]) := s
  have hind : Topology.IsInducing (Limits.pullback.snd O.ι i) :=
    (Limits.pullback.snd O.ι i).isOpenEmbedding.isInducing
  have hrange : Set.range (Limits.pullback.snd O.ι i) = i ⁻¹' (O : Set X) := by
    have h1 := Scheme.Pullback.range_snd O.ι i
    rw [Scheme.Opens.range_ι] at h1
    exact h1
  have hconn : _root_.IsPreconnected (Set.univ : Set ↥(Limits.pullback O.ι i)) := by
    rw [← hind.isPreconnected_image, Set.image_univ, hrange]
    exact hpre
  have hconst : ∀ p q, s' p = s' q := by
    intro p q
    have hf : Continuous (fun x => (s' x).down) := continuous_uliftDown.comp s'.continuous
    have h1 := (hconn.image _ hf.continuousOn).subsingleton
    exact ULift.ext _ _ (h1 (Set.mem_image_of_mem _ (Set.mem_univ p))
      (Set.mem_image_of_mem _ (Set.mem_univ q)))
  obtain ⟨c, hc⟩ : ∃ c : ULift.{u+1} ℚ_[ℓ], ∀ p, s' p = c := by
    by_cases hne : Nonempty ↥(Limits.pullback O.ι i)
    · obtain ⟨p₀⟩ := hne
      exact ⟨s' p₀, fun p => hconst p p₀⟩
    · exact ⟨0, fun p => (hne ⟨p⟩).elim⟩
  let t' : C(↥(Limits.pullback (𝟙 X) i), ULift.{u+1} ℚ_[ℓ]) := ContinuousMap.const _ c
  refine ⟨t', ?_⟩
  show (_ : C(↥(Limits.pullback O.ι i), ULift.{u+1} ℚ_[ℓ])) = s'
  refine ContinuousMap.ext (fun p => ?_)
  exact (hc p).symm

theorem wc_qmel_Xs_strict_local : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} → ∀ (r : ℕ) (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))), WeaklyEtale a₀ → Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) → ∀ (Xs : Scheme.{u}) (ι : Xs ⟶ Spec (.of B)) (s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))), IsPullback ι s (a₀ ≫ wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (wcQmSp A) → ∃ (R : Type u) (_ : CommRing R) (_ : HenselianLocalRing R) (_ : IsSepClosed (IsLocalRing.ResidueField R)) (_ : IsNoetherianRing R), Nonempty (Xs ≅ Spec (.of R)) :=
by
  intro A _ _ _ _ _ π hπ r B _ _ _ a₀ ha₀ hx0 Xs ι s hpb
  classical

  have quad : ∀ (c₀ : Matrix (Fin (r + 2)) (Fin (r + 2)) A),
      c₀ = (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) →
      wcQuadModelIdeal A (r + 2) π c₀ = Ideal.span {MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
        MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π} := by
    intro c₀ hc₀
    have hsum : (∑ p, ∑ q, MvPolynomial.C (c₀ p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin (r + 2)) A) =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
          MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) := by
      rw [Fintype.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
      · rw [Fintype.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
        · rw [hc₀, Matrix.of_apply, if_pos ⟨rfl, rfl⟩, map_one, one_mul]
        · intro q hq
          have : ¬ (q.val = 1) := fun h => hq (Fin.ext h)
          rw [hc₀, Matrix.of_apply, if_neg (fun h => this h.2), map_zero, zero_mul, zero_mul]
      · intro p hp
        apply Finset.sum_eq_zero
        intro q _
        have : ¬ (p.val = 0) := fun h => hp (Fin.ext h)
        rw [hc₀, Matrix.of_apply, if_neg (fun h => this h.1), map_zero, zero_mul, zero_mul]
    show Ideal.span {_ - _} = _
    rw [hsum]
  have hIeq := quad _ rfl
  have hrel : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) *
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) =
      algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π := by
    have hmem : (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
        MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π :
          MvPolynomial (Fin (r + 2)) A) ∈ wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
      rw [hIeq]; exact Ideal.mem_span_singleton_self _
    have hal : algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π =
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.C π) := by
      rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
    rw [hal, ← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
    exact hmem

  let ψ : A →+* B := (Spec.preimage a₀).hom.comp (algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))

  have hptg : ∀ {R' : CommRingCat.{u}} (g : Spec (.of B) ⟶ Spec R') (p : Spec (.of B)),
      (g p).asIdeal = Ideal.comap (Spec.preimage g).hom p.asIdeal := by
    intro R' g p
    conv_lhs => rw [← Spec.map_preimage g]
    rfl
  have hm0 : _ ∈ Ideal.comap (Spec.preimage a₀).hom (IsLocalRing.maximalIdeal B) :=
    (hptg a₀ (IsLocalRing.closedPoint B)).le hx0
  have hπm : ψ π ∈ IsLocalRing.maximalIdeal B := by
    show (Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π) ∈ _
    rw [← hrel, map_mul]; exact Ideal.mul_mem_right _ _ (Ideal.mem_comap.mp hm0)
  have hne : Ideal.span {ψ π} ≠ ⊤ := by
    intro h
    apply (IsLocalRing.maximalIdeal.isMaximal B).ne_top
    rw [eq_top_iff, ← h, Ideal.span_singleton_le_iff_mem]
    exact hπm
  obtain ⟨hH, hsep⟩ := wc_quot_strictly_henselian_of_ne_top B (Ideal.span {ψ π}) hne
  haveI hBN : IsNoetherianRing B := wc_qmssl_r1_B_noetherian A π hπ r B a₀ ha₀

  have hcomp : a₀ ≫ wcQuadModelStr A (r + 2) π
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) =
      Spec.map (CommRingCat.ofHom ψ) := by
    have e : CommRingCat.ofHom ψ = CommRingCat.ofHom (algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) ≫
        Spec.preimage a₀ := rfl
    rw [e, Spec.map_comp, Spec.map_preimage]

  letI : Algebra A B := ψ.toAlgebra
  have hpb' : IsPullback ι s (Spec.map (CommRingCat.ofHom (algebraMap A B)))
      (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) := by
    rw [hcomp] at hpb
    exact hpb
  have hT := isPullback_SpecMap_of_isPushout _ _ _ _
    (CommRingCat.isPushout_tensorProduct A B (IsLocalRing.ResidueField A))
  let e₁ := IsPullback.isoIsPullback _ _ hpb' hT
  have hJ : Ideal.span {ψ π} = Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A) := by
    rw [hπ, Ideal.map_span, Set.image_singleton]
    rfl
  let e₂ : (B ⧸ Ideal.span {ψ π}) ≃+* TensorProduct A B (IsLocalRing.ResidueField A) :=
    (Ideal.quotEquivOfEq hJ).trans
      (Algebra.TensorProduct.quotIdealMapEquivTensorQuot B (IsLocalRing.maximalIdeal A)).toRingEquiv
  let e₃ := Scheme.Spec.mapIso e₂.toCommRingCatIso.op
  exact ⟨B ⧸ Ideal.span {ψ π}, inferInstance, hH, hsep, Ideal.Quotient.isNoetherianRing _,
    ⟨e₁ ≪≫ e₃⟩⟩

theorem wc_qmel_Y_preconnected : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} → ∀ (r : ℕ) (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))), Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) → Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) → ∀ (Xs : Scheme.{u}) (ι : Xs ⟶ Spec (.of B)) (s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))), IsPullback ι s (a₀ ≫ wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (wcQmSp A) → ∀ (Y : Scheme.{u}) (iY : Y ⟶ Xs) (kY : Y ⟶ Spec (.of (B ⧸ Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))), (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))}))), IsPullback iY kY ι (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))), (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))})))) → PreconnectedSpace Y :=
by
  intro A _ _ _ _ _ π hπ r B _ _ _ a₀ hx0 hx1 Xs ι s hpbS Y iY kY hDY
  have h1 : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom (IsLocalRing.residue A))
      IsLocalRing.residue_surjective
  haveI hι : IsClosedImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hpbS.flip h1
  haveI hiY : IsClosedImmersion iY :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hDY.flip
      (IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective)
  have hemb := Scheme.Hom.isClosedEmbedding (iY ≫ ι)
  have hcl := hemb.isClosed_range
  have hind := hemb.isInducing
  have hsp : ∀ y : Y, (iY ≫ ι) y ⤳ IsLocalRing.closedPoint B :=
    fun y => IsLocalRing.specializes_closedPoint ((iY ≫ ι) y)
  rw [preconnectedSpace_iff_clopen]
  intro U hU
  rcases U.eq_empty_or_nonempty with h | ⟨y₁, hy₁⟩
  · exact Or.inl h
  right
  obtain ⟨y₀, hy₀⟩ := (hsp y₁).mem_closed hcl (Set.mem_range_self y₁)
  have hall : ∀ y, y ⤳ y₀ := fun y => hind.specializes_iff.mp (by rw [hy₀]; exact hsp y)
  have h0 : y₀ ∈ U := (hall y₁).mem_closed hU.isClosed hy₁
  exact Set.eq_univ_of_forall fun y => (hall y).mem_open hU.isOpen h0

theorem wc_qmel_branch_preirreducible : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} → ∀ (r : ℕ) (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))), WeaklyEtale a₀ → Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) → Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) → ∀ (Xs : Scheme.{u}) (ι : Xs ⟶ Spec (.of B)) (s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))), IsPullback ι s (a₀ ≫ wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (wcQmSp A) → ∀ (j : Fin (r + 2)), j.val < 2 → ∀ (D : Scheme.{u}) (i : D ⟶ Xs) (k : D ⟶ Spec (.of (B ⧸ Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X j))}))), IsPullback i k ι (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X j))})))) → IsPreirreducible (Set.univ : Set D) :=
by
  intro A _ _ _ _ _ π hπ r B _ _ _ a₀ ha₀ hx0 hx1 Xs ι s hpbS j hj D i k hD
  classical
  let c : Matrix (Fin (r + 2)) (Fin (r + 2)) A :=
    Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0
  have hc : c = Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0 := rfl
  let φ := Spec.preimage a₀
  have ha : Spec.map φ = a₀ := Spec.map_preimage a₀

  have L3 : ∀ {P X Y Z : Scheme.{u}} {fst : P ⟶ X} {snd : P ⟶ Y} {f : X ⟶ Z} {g : Y ⟶ Z},
      IsPullback fst snd f g → Mono f → ∀ σ : Y ⟶ X, σ ≫ f = g → IsIso snd := by
    intro P X Y Z fst snd f g h hf σ hσ
    refine ⟨⟨h.lift σ (𝟙 Y) (by rw [Category.id_comp]; exact hσ), ?_, h.lift_snd _ _ _⟩⟩
    apply h.hom_ext
    · rw [Category.assoc, h.lift_fst, Category.id_comp]
      rw [← cancel_mono f, Category.assoc, hσ, h.w]
    · rw [Category.assoc, h.lift_snd, Category.comp_id, Category.id_comp]

  have L2 : ∀ {R' B' : CommRingCat.{u}} (ψ : R' ⟶ B') (x : R'),
      ∃ inr : CommRingCat.of (R' ⧸ Ideal.span {x}) ⟶ CommRingCat.of (B' ⧸ Ideal.span {ψ.hom x}),
        IsPushout ψ (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {x})))
          (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ψ.hom x}))) inr := by
    intro R' B' ψ x
    have hle : Ideal.span {x} ≤ Ideal.comap ψ.hom (Ideal.span {ψ.hom x}) := by
      rw [Ideal.span_singleton_le_iff_mem, Ideal.mem_comap]
      exact Ideal.mem_span_singleton_self _
    refine ⟨CommRingCat.ofHom (Ideal.quotientMap _ ψ.hom hle), ?_⟩
    have w : ψ ≫ CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {ψ.hom x})) =
        CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {x})) ≫
          CommRingCat.ofHom (Ideal.quotientMap _ ψ.hom hle) := by
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro y
      rfl
    have H : ∀ t : Limits.PushoutCocone ψ (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {x}))),
        ∀ a ∈ Ideal.span {ψ.hom x}, t.inl.hom a = 0 := by
      intro t a ha
      obtain ⟨u', rfl⟩ := Ideal.mem_span_singleton'.mp ha
      have e : t.inl.hom (ψ.hom x) = t.inr.hom (Ideal.Quotient.mk (Ideal.span {x}) x) :=
        congrArg (fun f => f.hom x) t.condition
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self x), map_zero] at e
      rw [map_mul, e, mul_zero]
    exact IsPushout.of_isColimit (Limits.PushoutCocone.IsColimit.mk w
      (fun t => CommRingCat.ofHom (Ideal.Quotient.lift _ t.inl.hom (H t)))
      (fun t => by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro y
        exact Ideal.Quotient.lift_mk (Ideal.span {ψ.hom x}) t.inl.hom (H t))
      (fun t => by
        apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply RingHom.ext
        intro y
        exact congrArg (fun f => f.hom y) t.condition)
      (fun t m h1 _ => by
        apply CommRingCat.hom_ext
        apply Ideal.Quotient.ringHom_ext
        apply RingHom.ext
        intro y
        exact (congrArg (fun f => f.hom y) h1).trans
          (Ideal.Quotient.lift_mk (Ideal.span {ψ.hom x}) t.inl.hom (H t)).symm))

  have quad : wcQuadModelIdeal A (r + 2) π c = Ideal.span {MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
        MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π} := by
    have hsum : (∑ p, ∑ q, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin (r + 2)) A) =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
          MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) := by
      rw [Fintype.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
      · rw [Fintype.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
        · rw [hc, Matrix.of_apply, if_pos ⟨rfl, rfl⟩, map_one, one_mul]
        · intro q hq
          have : ¬ (q.val = 1) := fun h => hq (Fin.ext h)
          rw [hc, Matrix.of_apply, if_neg (fun h => this h.2), map_zero, zero_mul, zero_mul]
      · intro p hp
        apply Finset.sum_eq_zero
        intro q _
        have : ¬ (p.val = 0) := fun h => hp (Fin.ext h)
        rw [hc, Matrix.of_apply, if_neg (fun h => this h.1), map_zero, zero_mul, zero_mul]
    show Ideal.span {_ - _} = _
    rw [hsum]
  have hmemI : (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
      MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π :
        MvPolynomial (Fin (r + 2)) A) ∈ wcQuadModelIdeal A (r + 2) π c := by
    rw [quad]; exact Ideal.mem_span_singleton_self _
  have hrel : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c)
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) *
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c)
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) =
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c) (MvPolynomial.C π) := by
    rw [← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
    exact hmemI
  have hj01 : j = ⟨0, by omega⟩ ∨ j = ⟨1, by omega⟩ := by
    rcases (show j.val = 0 ∨ j.val = 1 by omega) with h | h
    · exact Or.inl (Fin.ext h)
    · exact Or.inr (Fin.ext h)
  have hprod0 : ∀ {T : Type u} [CommRing T] (v : Fin (r + 2) → T), v j = 0 →
      v ⟨0, by omega⟩ * v ⟨1, by omega⟩ = 0 := by
    intro T _ v hv
    rcases hj01 with h | h
    · rw [← h, hv, zero_mul]
    · rw [← h, hv, mul_zero]
  have hkill : ∀ {T : Type u} [CommRing T] (f : wcQuadModelRing A (r + 2) π c →+* T),
      f (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c) (MvPolynomial.X j)) = 0 →
      f (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c) (MvPolynomial.C π)) = 0 := by
    intro T _ f hf
    rw [← hrel, map_mul]
    exact hprod0 (fun i => f (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c) (MvPolynomial.X i))) hf
  have hπm : π ∈ IsLocalRing.maximalIdeal A := hπ ▸ Ideal.mem_span_singleton_self π
  have hmA : ∀ {T : Type u} [CommRing T] (g : A →+* T), g π = 0 →
      ∀ a ∈ IsLocalRing.maximalIdeal A, g a = 0 := by
    intro T _ g hg a ha
    rw [hπ] at ha
    obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, hg, mul_zero]

  have hptg : ∀ {R' : CommRingCat.{u}} (g : Spec (.of B) ⟶ Spec R') (p : Spec (.of B)),
      (g p).asIdeal = Ideal.comap (Spec.preimage g).hom p.asIdeal := by
    intro R' g p
    conv_lhs => rw [← Spec.map_preimage g]
    rfl
  have hm0 : φ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c)
      (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal B :=
    Ideal.mem_comap.mp ((hptg a₀ (IsLocalRing.closedPoint B)).le hx0)
  have hm1 : φ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c)
      (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal B :=
    Ideal.mem_comap.mp ((hptg a₀ (IsLocalRing.closedPoint B)).le hx1)
  have hxj : φ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c) (MvPolynomial.X j)) ∈
      IsLocalRing.maximalIdeal B := by
    rcases hj01 with h | h
    · rw [h]; exact hm0
    · rw [h]; exact hm1
  let J : Ideal B := Ideal.span {φ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c)
    (MvPolynomial.X j))}
  have hJle : J ≤ IsLocalRing.maximalIdeal B := (Ideal.span_singleton_le_iff_mem _).mpr hxj
  have hJne : J ≠ ⊤ := by
    intro h
    apply (IsLocalRing.maximalIdeal.isMaximal B).ne_top
    rw [eq_top_iff, ← h]
    exact hJle
  have hxJ : Ideal.Quotient.mk J (φ.hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c)
      (MvPolynomial.X j))) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)

  let θ : A →+* B ⧸ J :=
    (Ideal.Quotient.mk J).comp (φ.hom.comp (algebraMap A (wcQuadModelRing A (r + 2) π c)))
  have hθ : ∀ a ∈ IsLocalRing.maximalIdeal A, θ a = 0 := by
    refine hmA θ ?_
    have h1 := hkill ((Ideal.Quotient.mk J).comp φ.hom) hxJ
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap] at h1
    exact h1
  let θb : IsLocalRing.ResidueField A →+* B ⧸ J :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal A) θ hθ
  have hsq : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) ≫
      (a₀ ≫ wcQuadModelStr A (r + 2) π c) = Spec.map (CommRingCat.ofHom θb) ≫ wcQmSp A := by
    rw [← ha]
    show Spec.map _ ≫ Spec.map φ ≫ Spec.map _ = Spec.map _ ≫ Spec.map _
    rw [← Spec.map_comp, ← Spec.map_comp, ← Spec.map_comp]
    congr 1
  let σ : Spec (CommRingCat.of (B ⧸ J)) ⟶ Xs :=
    hpbS.lift (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) (Spec.map (CommRingCat.ofHom θb)) hsq
  have hσ : σ ≫ ι = Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J)) := hpbS.lift_fst _ _ _
  haveI hci : IsClosedImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hpbS.flip
      (IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective)
  haveI hk : IsIso k := L3 hD inferInstance σ hσ

  obtain ⟨inr, hpo⟩ := L2 φ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c) (MvPolynomial.X j))
  have hpb := isPullback_SpecMap_of_isPushout _ _ _ _ hpo
  have hWφ : WeaklyEtale (Spec.map φ) := by rw [ha]; exact ha₀
  have hWinr : WeaklyEtale (Spec.map inr) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) hpb hWφ

  let Ib : Ideal (wcQuadModelRing A (r + 2) π c) :=
    Ideal.span {Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c) (MvPolynomial.X j)}
  have hπIb : Ideal.Quotient.mk Ib (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c)
      (MvPolynomial.C π)) = 0 := by
    have hXj : Ideal.Quotient.mk Ib (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c)
        (MvPolynomial.X j)) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
    have h := hkill (T := wcQuadModelRing A (r + 2) π c ⧸ Ib) (Ideal.Quotient.mk Ib) hXj
    exact h
  have hκ : ∀ a ∈ IsLocalRing.maximalIdeal A,
      ((Ideal.Quotient.mk Ib).comp
        ((Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c)).comp MvPolynomial.C)) a = 0 := by
    have h := hmA (T := wcQuadModelRing A (r + 2) π c ⧸ Ib) ((Ideal.Quotient.mk Ib).comp
        ((Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c)).comp MvPolynomial.C)) hπIb
    exact h
  let κ : IsLocalRing.ResidueField A →+* (wcQuadModelRing A (r + 2) π c ⧸ Ib) :=
    Ideal.Quotient.lift (IsLocalRing.maximalIdeal A)
      ((Ideal.Quotient.mk Ib).comp
        ((Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c)).comp MvPolynomial.C)) hκ
  have hκa : ∀ a : A, κ (IsLocalRing.residue A a) =
      Ideal.Quotient.mk Ib (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c) (MvPolynomial.C a)) :=
    fun a => Ideal.Quotient.lift_mk (IsLocalRing.maximalIdeal A) _ hκ
  obtain ⟨Φ, hΦC, hΦX⟩ : ∃ Φ : MvPolynomial (Fin (r + 1)) (IsLocalRing.ResidueField A) →+*
        (wcQuadModelRing A (r + 2) π c ⧸ Ib),
      (∀ a : A, Φ (MvPolynomial.C (IsLocalRing.residue A a)) =
        Ideal.Quotient.mk Ib (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c) (MvPolynomial.C a))) ∧
      (∀ t, Φ (MvPolynomial.X t) = Ideal.Quotient.mk Ib
        (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c) (MvPolynomial.X (j.succAbove t)))) := by
    refine ⟨MvPolynomial.eval₂Hom κ
      (fun t => Ideal.Quotient.mk Ib (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c)
        (MvPolynomial.X (j.succAbove t)))), fun a => ?_, fun t => ?_⟩
    · exact (MvPolynomial.eval₂Hom_C (R := IsLocalRing.ResidueField A)
        (S₁ := wcQuadModelRing A (r + 2) π c ⧸ Ib) κ _ _).trans (hκa a)
    · exact MvPolynomial.eval₂Hom_X' (R := IsLocalRing.ResidueField A)
        (S₁ := wcQuadModelRing A (r + 2) π c ⧸ Ib) κ _ t
  obtain ⟨v, hvj, hvs⟩ : ∃ v : Fin (r + 2) → MvPolynomial (Fin (r + 1)) (IsLocalRing.ResidueField A),
      v j = 0 ∧ ∀ t, v (j.succAbove t) = MvPolynomial.X t :=
    ⟨Fin.insertNth (α := fun _ => MvPolynomial (Fin (r + 1)) (IsLocalRing.ResidueField A)) j 0
      (fun t => MvPolynomial.X t), Fin.insertNth_apply_same _ _ _,
      fun t => Fin.insertNth_apply_succAbove _ _ _ _⟩
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : (wcQuadModelRing A (r + 2) π c ⧸ Ib) →+*
        MvPolynomial (Fin (r + 1)) (IsLocalRing.ResidueField A),
      ∀ p, Ψ (Ideal.Quotient.mk Ib (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π c) p)) =
        MvPolynomial.eval₂Hom ((MvPolynomial.C).comp (IsLocalRing.residue A)) v p := by
    have hgen : MvPolynomial.eval₂Hom ((MvPolynomial.C).comp (IsLocalRing.residue A)) v
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) -
          MvPolynomial.C π) = 0 := by
      rw [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_X',
        MvPolynomial.eval₂Hom_C, hprod0 v hvj, RingHom.comp_apply,
        (IsLocalRing.residue_eq_zero_iff π).mpr hπm, map_zero, sub_zero]
    let Ψ₁ : wcQuadModelRing A (r + 2) π c →+* MvPolynomial (Fin (r + 1)) (IsLocalRing.ResidueField A) :=
      Ideal.Quotient.lift (wcQuadModelIdeal A (r + 2) π c)
        (MvPolynomial.eval₂Hom ((MvPolynomial.C).comp (IsLocalRing.residue A)) v) (fun a ha => by
          rw [quad] at ha
          obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp ha
          rw [map_mul, hgen, mul_zero])
    refine ⟨Ideal.Quotient.lift Ib Ψ₁ (fun a ha => ?_), fun p => rfl⟩
    obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul]
    show Ψ₁ t * MvPolynomial.eval₂Hom ((MvPolynomial.C).comp (IsLocalRing.residue A)) v
      (MvPolynomial.X j) = 0
    rw [MvPolynomial.eval₂Hom_X', hvj, mul_zero]
  have hΨΦ : Ψ.comp Φ = RingHom.id _ := by
    apply MvPolynomial.ringHom_ext
    · intro κ
      obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective κ
      rw [RingHom.comp_apply, hΦC, hΨ, MvPolynomial.eval₂Hom_C, RingHom.comp_apply,
        RingHom.id_apply]
    · intro t
      rw [RingHom.comp_apply, hΦX, hΨ, MvPolynomial.eval₂Hom_X', hvs, RingHom.id_apply]
  have hΦΨ : Φ.comp Ψ = RingHom.id _ := by
    apply Ideal.Quotient.ringHom_ext
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro a
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΨ, MvPolynomial.eval₂Hom_C, RingHom.comp_apply, hΦC]
    · intro t
      simp only [RingHom.comp_apply, RingHom.id_apply]
      rw [hΨ, MvPolynomial.eval₂Hom_X']
      by_cases ht : t = j
      · rw [ht, hvj, map_zero, eq_comm, Ideal.Quotient.eq_zero_iff_mem]
        exact Ideal.mem_span_singleton_self _
      · obtain ⟨z, rfl⟩ := Fin.exists_succAbove_eq ht
        rw [hvs, hΦX]
  let e := RingEquiv.ofRingHom Φ Ψ hΦΨ hΨΦ

  let k' : Spec (CommRingCat.of (B ⧸ J)) ⟶
      Spec (CommRingCat.of (MvPolynomial (Fin (r + 1)) (IsLocalRing.ResidueField A))) :=
    Spec.map inr ≫ Spec.map (RingEquiv.toCommRingCatIso e).hom
  have hk' : WeaklyEtale k' :=
    MorphismProperty.RespectsIso.postcomp @WeaklyEtale _ _ hWinr
  haveI := wc_mvpoly_spec_smoothOfRelDim (IsLocalRing.ResidueField A) (r + 1)

  obtain ⟨hH, hSC⟩ := wc_quot_strictly_henselian_of_ne_top B J hJne
  have hdom : IsDomain (CommRingCat.of (B ⧸ J)) :=
    @wc_strictHensel_weaklyEtale_smooth_isDomain (IsLocalRing.ResidueField A) _ _
      (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField A)
        (MvPolynomial (Fin (r + 1)) (IsLocalRing.ResidueField A))))) (r + 1) _
      (CommRingCat.of (B ⧸ J)) hH hSC k' hk'

  haveI : IsDomain (B ⧸ J) := hdom
  have hirr : IsPreirreducible (Set.univ : Set (Spec (CommRingCat.of (B ⧸ J)))) :=
    (IrreducibleSpace.isIrreducible_univ _).isPreirreducible
  have himg := hirr.image (Scheme.Hom.homeomorph k).symm
    (Scheme.Hom.homeomorph k).symm.continuous.continuousOn
  rwa [Set.image_univ_of_surjective (Scheme.Hom.homeomorph k).symm.surjective] at himg

theorem wc_qmssl_ext_line : ∀ (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A) →
    ∀ (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} →
    ∀ (r : ℕ) (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)]
      (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
    WeaklyEtale a₀ →
    Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) →
    Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) →
    ∀ (Xs : Scheme.{u}) (ι : Xs ⟶ Spec (.of B))
      (s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))),
    IsPullback ι s (a₀ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (wcQmSp A) →
    ∀ (D₁ : Scheme.{u}) (i₁ : D₁ ⟶ Xs)
      (k₁ : D₁ ⟶ Spec (.of (B ⧸ Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))))}))),
    IsPullback i₁ k₁ ι (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))))})))) →
    ∀ (D₂ : Scheme.{u}) (i₂ : D₂ ⟶ Xs)
      (k₂ : D₂ ⟶ Spec (.of (B ⧸ Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))}))),
    IsPullback i₂ k₂ ι (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))})))) →
    ∀ (Y : Scheme.{u}) (iY : Y ⟶ Xs)
      (kY : Y ⟶ Spec (.of (B ⧸ Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))),
        (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))}))),
    IsPullback iY kY ι (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))),
        (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))})))) →
    ∀ (E₁ : wcHMPullData i₁ ℓ), wcHMPullCanonical E₁ →
    ∀ (E₂ : wcHMPullData i₂ ℓ), wcHMPullCanonical E₂ →
    ∀ (EY : wcHMPullData iY ℓ), wcHMPullCanonical EY →
    ∀ (ρ₁ : wcSuppObj E₁ ⟶ wcSuppObj EY) (ρ₂ : wcSuppObj E₂ ⟶ wcSuppObj EY)
      (hz : Limits.biprod.lift (wcSuppUnitMap E₁) (wcSuppUnitMap E₂) ≫
        Limits.biprod.desc ρ₁ (-ρ₂) = 0)
      (hS : (ShortComplex.mk _ _ hz).ShortExact),
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
    ∀ g : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0).obj
          (wcSuppObj EY) ⟶
        ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0).obj
          (SheafOfModules.unit (wcRingSheaf Xs ℓ)))⟦(1 : ℤ)⟧,
      g = 0 ∨ ∃ v : ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0).obj
            (SheafOfModules.unit (wcRingSheaf Xs ℓ)))⟦(1 : ℤ)⟧ ≅
          ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0).obj
            (SheafOfModules.unit (wcRingSheaf Xs ℓ)))⟦(1 : ℤ)⟧,
        g = hS.singleδ ≫ v.hom :=
by
  intro A _ _ _ _ _ ℓ _ hℓ π hπ r B _ _ _ a₀ ha₀ hx0 hx1 Xs ι s hpbS D₁ i₁ k₁ hD1 D₂ i₂ k₂ hD2
    Y iY kY hDY E₁ hE₁ E₂ hE₂ EY hEY ρ₁ ρ₂ hz hS
  intro g
  classical
  letI : HasExt (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) := HasExt.standard _
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))

  have hJ : ∀ (J : Ideal B), IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))) :=
    fun J => IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  haveI : IsClosedImmersion iY :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hDY.flip (hJ _)

  obtain ⟨R, _, _, _, _, ⟨eX⟩⟩ := wc_qmel_Xs_strict_local A π hπ r B a₀ ha₀ hx0 Xs ι s hpbS
  haveI : IsLocallyNoetherian Xs := isLocallyNoetherian_of_isOpenImmersion eX.hom

  have htf : ∀ (V : (Xs.ProEt)ᵒᵖ) (m : ℕ) (x : ↑((wcRingSheaf Xs ℓ).obj.obj V)),
      m ≠ 0 → m • x = 0 → x = 0 := by
    intro V m x hm hx
    let x' : C(↥(Opposite.unop V).left, ULift.{u+1} ℚ_[ℓ]) := x
    have hx' : m • x' = 0 := hx
    show x' = 0
    refine ContinuousMap.ext fun p => ?_
    have h1 := ContinuousMap.congr_fun hx' p
    have h2 : (m : ℚ_[ℓ]) * (x' p).down = 0 := by
      have h3 := congrArg ULift.down h1
      simpa [nsmul_eq_mul] using h3
    have h4 : (x' p).down = 0 := (mul_eq_zero.mp h2).resolve_left (Nat.cast_ne_zero.mpr hm)
    exact ULift.ext _ _ h4
  obtain ⟨L, adj, hLadd, hLlim, hLcolim⟩ :=
    sheafOfModules_toSheaf_exact_left_adjoint_of_torsionFree (Scheme.ProEt.topology Xs)
      (wcRingSheaf Xs ℓ) htf

  have hcl : IsClosed (Set.range iY) := iY.isClosedEmbedding.isClosed_range
  let O : Xs.Opens := ⟨(Set.range iY)ᶜ, hcl.isOpen_compl⟩
  obtain ⟨ε, hαβ, hex⟩ := wc_closed_supp_kernel_free iY ℓ EY hEY L adj O rfl

  have C2 : ∀ {P U Q N : SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)} (α : P ⟶ U) (β : U ⟶ Q)
      (hαβ : α ≫ β = 0), (ShortComplex.mk α β hαβ).Exact → Epi β →
      (∀ x : Abelian.Ext U N 1, x = 0) → (∀ φ : P ⟶ N, ∃ t : U ⟶ N, α ≫ t = φ) →
      ∀ x : Abelian.Ext Q N 1, x = 0 := by
    intro P U Q N α β hαβ hexact hepi hU hlift x
    have hS' : (ShortComplex.mk (Limits.kernel.ι β) β (Limits.kernel.condition β)).ShortExact :=
      ShortComplex.ShortExact.mk'
        (ShortComplex.exact_of_f_is_kernel _ (Limits.kernelIsKernel β)) inferInstance hepi
    have h0 : (Abelian.Ext.mk₀ β).comp x (zero_add 1) = 0 := hU _
    obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS' N x h0 (n₀ := 0) (by omega)
    obtain ⟨φ', hφ'⟩ := (Abelian.Ext.mk₀_bijective _ _).2 x₁
    haveI : Epi (Limits.kernel.lift β α hαβ) := hexact.epi_kernelLift
    obtain ⟨t, ht⟩ := hlift (Limits.kernel.lift β α hαβ ≫ φ')
    have hκt : Limits.kernel.ι β ≫ t = φ' := by
      rw [← cancel_epi (Limits.kernel.lift β α hαβ), ← Category.assoc, Limits.kernel.lift_ι]
      exact ht
    have e : hS'.extClass.comp (Abelian.Ext.mk₀ (Limits.kernel.ι β)) (add_zero 1) = 0 :=
      hS'.extClass_comp
    rw [← hx₁, ← hφ', ← hκt, ← Abelian.Ext.mk₀_comp_mk₀,
      ← Abelian.Ext.comp_assoc _ _ _ (add_zero 1) (zero_add 0) (by omega), e,
      Abelian.Ext.zero_comp]

  have hU : ∀ M : SheafOfModules.{u+1} (wcRingSheaf Xs ℓ),
      ∀ x : Abelian.Ext (SheafOfModules.unit (wcRingSheaf Xs ℓ)) M 1, x = 0 := by
    intro M
    haveI : Projective (wcFreeSheaf Xs (Scheme.ProEt.mk (𝟙 Xs))) :=
      wc_proet_free_projective_strict_local Xs (Scheme.ProEt.mk (𝟙 Xs)) R eX
    exact wc_hm_unit_ext_vanish_of_free_ext_vanish Xs ℓ M 1
      (fun y => Abelian.Ext.eq_zero_of_projective y)

  have hO_pre : ∀ (D : Scheme.{u}) (i : D ⟶ Xs), IsPreirreducible (Set.univ : Set D) →
      _root_.IsPreconnected (i ⁻¹' (O : Set Xs)) := by
    intro D i hirr
    have hopen : IsOpen (i ⁻¹' (O : Set Xs)) := O.2.preimage i.continuous
    exact (hirr.open_subset hopen (Set.subset_univ _)).isPreconnected

  have hvan : ∀ (D : Scheme.{u}) (i : D ⟶ Xs) (E : wcHMPullData i ℓ), wcHMPullCanonical E →
      IsPreirreducible (Set.univ : Set D) →
      ∀ x : Abelian.Ext (wcSuppObj EY) (wcSuppObj E) 1, x = 0 := by
    intro D i E hE hirr
    exact C2 _ _ hαβ hex (wc_supp_unit_epi_of_closed iY ℓ EY hEY) (hU _)
      (wc_qmel_free_hom_lift Xs ℓ L adj ε _ (wcSuppObj E)
        (wc_qmel_supp_restrict_surj i ℓ E hE O _ (hO_pre D i hirr)))
  have hirr1 := wc_qmel_branch_preirreducible A π hπ r B a₀ ha₀ hx0 hx1 Xs ι s hpbS
    ⟨0, by omega⟩ (by simp) D₁ i₁ k₁ hD1
  have hirr2 := wc_qmel_branch_preirreducible A π hπ r B a₀ ha₀ hx0 hx1 Xs ι s hpbS
    ⟨1, by omega⟩ (by simp) D₂ i₂ k₂ hD2

  have hD : ∀ (D : Scheme.{u}) (i : D ⟶ Xs) (E : wcHMPullData i ℓ), wcHMPullCanonical E →
      IsPreirreducible (Set.univ : Set D) →
      ∀ f : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0).obj
          (wcSuppObj EY) ⟶
        ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0).obj
          (wcSuppObj E))⟦(1 : ℤ)⟧, f = 0 := by
    intro D i E hE hirr f
    have h := hvan D i E hE hirr (Abelian.Ext.homEquiv.symm f)
    have hf : f = Abelian.Ext.homEquiv (Abelian.Ext.homEquiv.symm f) :=
      (Equiv.apply_symm_apply _ _).symm
    rw [hf, h]
    exact Abelian.Ext.zero_hom _ _ _

  have hmid : g ≫ (shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)))
      (1 : ℤ)).map hS.singleTriangle.mor₁ = 0 := by
    let F := DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0 ⋙
      shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))) (1 : ℤ)
    have y0 : ∀ y : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0).obj
        (wcSuppObj EY) ⟶ F.obj (wcSuppObj E₁ ⊞ wcSuppObj E₂), y = 0 := by
      intro y
      have h1 := hD D₁ i₁ E₁ hE₁ hirr1 (y ≫ F.map Limits.biprod.fst)
      have h2 := hD D₂ i₂ E₂ hE₂ hirr2 (y ≫ F.map Limits.biprod.snd)
      calc y = y ≫ F.map (𝟙 _) := by rw [F.map_id, Category.comp_id]
        _ = y ≫ F.map (Limits.biprod.fst ≫ Limits.biprod.inl +
              Limits.biprod.snd ≫ Limits.biprod.inr) := by rw [Limits.biprod.total]
        _ = 0 := by
          rw [F.map_add, F.map_comp, F.map_comp, Preadditive.comp_add, ← Category.assoc,
            ← Category.assoc, h1, h2, Limits.zero_comp, Limits.zero_comp, add_zero]
    exact y0 _

  obtain ⟨h, hh⟩ :=
    Pretriangulated.Triangle.coyoneda_exact₁ _ hS.singleTriangle_distinguished g hmid
  obtain ⟨e, he⟩ : ∃ e : wcSuppObj EY ⟶ wcSuppObj EY,
      g = (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0).map e ≫
        hS.singleδ :=
    ⟨(DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0).preimage
      (h : (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0).obj
          (wcSuppObj EY) ⟶
        (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0).obj
          (wcSuppObj EY)), by rw [Functor.map_preimage]; exact hh⟩

  haveI : PreconnectedSpace Y :=
    wc_qmel_Y_preconnected A π hπ r B a₀ hx0 hx1 Xs ι s hpbS Y iY kY hDY
  obtain ⟨b, hb⟩ := (wc_supp_obj_fun_end_bijective iY ℓ EY hEY
    (wc_supp_unit_epi_of_closed iY ℓ EY hEY)).2 e
  obtain ⟨c, hc⟩ := wc_hm_unit_end_const Y ℓ (wcHMFun Y ℓ b)
  have hec : e = (@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC iY) _ _
      EY.cont EY.φ).map (wcHMConst Y ℓ c) := by
    rw [← hc]; exact hb.symm

  have hcent : (Abelian.Ext.mk₀ ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC iY) _ _
      EY.cont EY.φ).map (wcHMConst Y ℓ c))).comp hS.extClass (zero_add 1) =
      hS.extClass.comp (Abelian.Ext.mk₀ (wcHMConst Xs ℓ c)) (add_zero 1) :=
    wc_supp_ext_scalar_central iY ℓ EY hEY 1 hS.extClass c
  have hg : g = hS.singleδ ≫ (shiftFunctor (DerivedCategory (SheafOfModules.{u+1}
      (wcRingSheaf Xs ℓ))) (1 : ℤ)).map
      ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0).map
        (wcHMConst Xs ℓ c)) := by
    rw [he, hec]
    have h1 := Abelian.Ext.comp_hom (Abelian.Ext.mk₀ ((@SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC iY) _ _ EY.cont EY.φ).map (wcHMConst Y ℓ c))) hS.extClass
      (zero_add 1)
    have h2 := Abelian.Ext.comp_hom hS.extClass (Abelian.Ext.mk₀ (wcHMConst Xs ℓ c)) (add_zero 1)
    simp only [Abelian.Ext.mk₀_hom, ShiftedHom.mk₀_comp, ShortComplex.ShortExact.extClass_hom] at h1
    simp only [Abelian.Ext.mk₀_hom, ShiftedHom.comp_mk₀, ShortComplex.ShortExact.extClass_hom] at h2
    have key := h1.symm.trans ((congrArg Abelian.Ext.hom hcent).trans h2)
    rw [← hS.extClass_hom]
    exact key

  obtain ⟨hc1, hcmul, hcadd⟩ := wc_hm_const_ring Xs ℓ
  by_cases hc0 : c = 0
  · left
    have h00 : wcHMConst Xs ℓ 0 = 0 := by
      have h3 := hcadd 0 0
      rw [add_zero] at h3
      exact left_eq_add.mp h3
    rw [hg, hc0, h00, Functor.map_zero, Functor.map_zero, Limits.comp_zero]
  · right
    let uc : SheafOfModules.unit (wcRingSheaf Xs ℓ) ≅ SheafOfModules.unit (wcRingSheaf Xs ℓ) :=
      { hom := wcHMConst Xs ℓ c
        inv := wcHMConst Xs ℓ c⁻¹
        hom_inv_id := by rw [← hcmul, mul_inv_cancel₀ hc0, hc1]
        inv_hom_id := by rw [← hcmul, inv_mul_cancel₀ hc0, hc1] }
    exact ⟨(shiftFunctor (DerivedCategory (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))) (1 : ℤ)).mapIso
      ((DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0).mapIso uc), hg⟩

theorem wc_qmtm_pull_data_unit {S S' : Scheme.{u}} (f : S' ⟶ S) (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ D : wcHMPullData f ℓ, wcHMPullCanonical D ∧ wcSuppUnitMap D = wcQmtmUnit D :=
by
  classical
  obtain ⟨D₀, hD₀⟩ := wc_hm_pull_data_exists f ℓ

  have hF : (wcProEtBC f).Final := by
    let T₀ : S.ProEt := MorphismProperty.Over.mk ⊤ (𝟙 S) (inferInstance : WeaklyEtale (𝟙 S))
    have hT₀ : Limits.IsTerminal T₀ := by
      refine Limits.IsTerminal.ofUniqueHom
        (fun V => MorphismProperty.Over.homMk V.hom (Category.comp_id V.hom) trivial) ?_
      intro V m
      apply MorphismProperty.Over.Hom.ext
      have hw : m.left ≫ 𝟙 S = V.hom := MorphismProperty.Over.w m
      exact (Category.comp_id m.left).symm.trans hw
    let FT := (wcProEtBC f).obj T₀
    haveI he : IsIso FT.hom := by
      show IsIso (Limits.pullback.snd (𝟙 S) f)
      infer_instance
    have hFT : Limits.IsTerminal FT := by
      refine Limits.IsTerminal.ofUniqueHom
        (fun W => MorphismProperty.Over.homMk (W.hom ≫ inv FT.hom) (by simp) trivial) ?_
      intro W m
      apply MorphismProperty.Over.Hom.ext
      have hw := MorphismProperty.Over.w m
      show m.left = W.hom ≫ inv FT.hom
      rw [← hw, Category.assoc, IsIso.hom_inv_id, Category.comp_id]
    refine Functor.Final.mk (fun d => ?_)
    let td : StructuredArrow d (wcProEtBC f) := StructuredArrow.mk (hFT.from d)
    have htd : Limits.IsTerminal td := by
      refine Limits.IsTerminal.ofUniqueHom
        (fun Y => StructuredArrow.homMk (hT₀.from Y.right) (hFT.hom_ext _ _)) ?_
      intro Y m
      exact StructuredArrow.hom_ext _ _ (hT₀.hom_ext _ _)
    exact isConnected_of_isTerminal _ htd
  haveI := D₀.cont
  haveI := hF
  haveI : (SheafOfModules.pushforward D₀.φ).IsRightAdjoint := ⟨_, ⟨D₀.adj⟩⟩
  let Λ := SheafOfModules.unit (wcRingSheaf S ℓ)
  let Λ' := SheafOfModules.unit (wcRingSheaf S' ℓ)
  let U : Λ ⟶ (SheafOfModules.pushforward D₀.φ).obj Λ' := wcQmtmUnit D₀
  let m : D₀.Φ.obj Λ ⟶ Λ' := (D₀.adj.homEquiv Λ Λ').symm U
  have hm : IsIso m := by
    let adjM := SheafOfModules.pullbackPushforwardAdjunction D₀.φ
    let e := adjM.leftAdjointUniq D₀.adj
    have h1 : adjM.homEquiv Λ Λ' (e.hom.app Λ ≫ m) = U := by
      rw [Adjunction.homEquiv_naturality_right, Adjunction.homEquiv_leftAdjointUniq_hom_app,
        ← Adjunction.homEquiv_unit, Equiv.apply_symm_apply]
    have h2 : e.hom.app Λ ≫ m = SheafOfModules.pullbackObjUnitToUnit D₀.φ := by
      rw [← SheafOfModules.pullbackPushforwardAdjunction_homEquiv_symm_unitToPushforwardObjUnit]
      exact (Equiv.eq_symm_apply _).mpr h1
    have h3 : m = e.inv.app Λ ≫ SheafOfModules.pullbackObjUnitToUnit D₀.φ := by
      rw [← h2, Iso.inv_hom_id_app_assoc]
    haveI : IsIso (SheafOfModules.pullbackObjUnitToUnit D₀.φ) := inferInstance
    rw [h3]
    infer_instance
  refine ⟨{ D₀ with μ := asIso m }, hD₀, ?_⟩
  show D₀.adj.unit.app Λ ≫ (SheafOfModules.pushforward D₀.φ).map (asIso m).hom = U
  rw [asIso_hom]
  exact (D₀.adj.homEquiv_unit Λ Λ' m).symm.trans (Equiv.apply_symm_apply _ U)

theorem wc_qmtm_tower_data {A B L : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    [CommRing B] [Field L] [IsSepClosed L]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit ((ℓ : ℕ) : A)) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (r : ℕ)
    (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r))))
    (φA : A →+* L) (hφA : Function.Injective φA) (σ : L →+* L) (hσ : σ.comp φA = φA)
    (XE : Scheme.{u}) (p : XE ⟶ Spec (.of B)) (q : XE ⟶ Spec (.of L))
    (hpb : IsPullback p q (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
      (Spec.map (CommRingCat.ofHom φA)))
    (w : XE ⟶ XE) (hw₁ : w ≫ p = p) (hw₂ : w ≫ q = q ≫ Spec.map (CommRingCat.ofHom σ)) :
    Nonempty (wcQmtmTower ℓ φA σ p q w (wcQmtmX a₀ ⟨0, by omega⟩)) :=
by
  classical
  have hp : Nat.Prime ℓ := Fact.out
  have hℓ0 : ℓ ≠ 0 := hp.ne_zero

  have hlk : ((ℓ : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    have := hℓ.map (IsLocalRing.residue A)
    rw [map_natCast] at this
    exact this.ne_zero
  haveI : NeZero ((ℓ : ℕ) : IsLocalRing.ResidueField A) := ⟨hlk⟩
  have hroot : ∀ c : A, IsUnit c → ∃ a : A, a ^ ℓ = c := by
    intro c hc
    obtain ⟨bb, hbb⟩ := IsSepClosed.exists_pow_nat_eq (IsLocalRing.residue A c) ℓ
    obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective bb
    have hcres : IsLocalRing.residue A c ≠ 0 := (IsLocalRing.residue_ne_zero_iff_isUnit c).mpr hc
    have hb : IsUnit b := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
      intro h; apply hcres; rw [← hbb, h, zero_pow hℓ0]
    have hmon : (Polynomial.X ^ ℓ - Polynomial.C c).Monic := Polynomial.monic_X_pow_sub_C c hℓ0
    have h1 : Polynomial.eval b (Polynomial.X ^ ℓ - Polynomial.C c) ∈
        IsLocalRing.maximalIdeal A := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      simp [hbb]
    have h2 : IsUnit (Polynomial.eval b
        (Polynomial.derivative (Polynomial.X ^ ℓ - Polynomial.C c))) := by
      simp only [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
        sub_zero, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
      exact hℓ.mul (hb.pow _)
    obtain ⟨a, ha, -⟩ := HenselianLocalRing.is_henselian _ hmon b h1 h2
    refine ⟨a, ?_⟩
    rw [Polynomial.IsRoot.def] at ha
    simpa [sub_eq_zero] using ha

  have hnt : ∃ a : A, a ^ ℓ = 1 ∧ a ≠ 1 := by
    have hsep : (Polynomial.cyclotomic ℓ (IsLocalRing.ResidueField A)).Separable :=
      (Polynomial.X_pow_sub_one_separable_iff.mpr hlk).of_dvd
        (Polynomial.cyclotomic.dvd_X_pow_sub_one ℓ _)
    have hdeg : (Polynomial.cyclotomic ℓ (IsLocalRing.ResidueField A)).degree ≠ 0 :=
      (Polynomial.degree_cyclotomic_pos ℓ _ hp.pos).ne'
    obtain ⟨μ, hμ⟩ := IsSepClosed.exists_root _ hdeg hsep
    have hprim : IsPrimitiveRoot μ ℓ := (Polynomial.isRoot_cyclotomic_iff).mp hμ
    obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective μ
    have hb : IsUnit b := by
