      ((Scheme.ΓSpecIso (.of B)).inv.hom (wcQmtmX a₀ ⟨0, by omega⟩))) := by
    apply RingedSpace.isUnit_of_isUnit_germ Vt.left.toRingedSpace ⊤
    intro x _
    have hmem : x ∈ Vt.left.basicOpen (Vt.hom.appTop.hom
        ((Scheme.ΓSpecIso (.of B)).inv.hom (wcQmtmX a₀ ⟨0, by omega⟩))) := by
      obtain ⟨y, ⟨hycl, hxy⟩, -⟩ := hW3 x
      refine hxy.mem_open (Vt.left.basicOpen _).isOpen ?_
      have hb : (Spec (.of B)).basicOpen ((Scheme.ΓSpecIso (.of B)).inv.hom
          (wcQmtmX a₀ ⟨0, by omega⟩)) = PrimeSpectrum.basicOpen (wcQmtmX a₀ ⟨0, by omega⟩) :=
        basicOpen_eq_of_affine _
      have hy' : Vt.hom y ∈ (Spec (.of B)).basicOpen ((Scheme.ΓSpecIso (.of B)).inv.hom
