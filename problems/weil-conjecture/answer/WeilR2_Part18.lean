        Polynomial.C xM)))).hom.hom u, ?_⟩
      rw [← map_pow, hu, IsUnit.unit_spec]
      exact CommRingCat.hom_inv_apply (Scheme.ΓSpecIso (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) -
        Polynomial.C xM)))) (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C xM))
    have hmem := mem_zmultiples_of_prime_card hcard hκne (g' := x)
    obtain ⟨n, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
    rw [map_zsmul, hκkill E, smul_zero]
  intro β _ hβ2 E x
  letI : Algebra A R := (ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
  letI : Algebra A L := φA.toAlgebra
  have hℓM : IsUnit ((ℓ : ℕ) : TensorProduct A L R) := by
    have h := hℓL.map (Algebra.TensorProduct.includeLeftRingHom : L →+* TensorProduct A L R)
    rwa [map_natCast] at h

  have collapse :
      (∑ p : Fin (r + 2), ∑ q : Fin (r + 2), MvPolynomial.C (wcQmtmC A r p q) * MvPolynomial.X p *
          MvPolynomial.X q : MvPolynomial (Fin (r + 2)) A) =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) := by
    rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
    · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
