    intro c
    rw [← wc_hm_pull_const Di hDi c]
    simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id]
  refine ⟨((-t : ℤ_[ℓ]) : ℚ_[ℓ]), ?_, ?_⟩
  · intro h0
    exact ht.neg.ne_zero (PadicInt.coe_eq_zero.mp h0)
  intro O jO kO hO DO hDO
  haveI := DO.additive
  refine ⟨hepi O jO kO hO DO hDO, DO.Φ.map (Di.Φ.map ((wcQmtmPush Dp).map H)), ?_, ?_⟩
  · have e1 : Di.Φ.map ((wcQmtmPush Dp).map Γ) - 𝟙 _ =
        (Di.Φ.map ((wcQmtmPush Dp).map γN) - 𝟙 _) ≫ Di.Φ.map ((wcQmtmPush Dp).map H) := by
      have hΓ' : Γ = (γN - 𝟙 _) ≫ H + 𝟙 _ := by rw [hH]; abel
      rw [hΓ']
      simp only [Functor.map_add, Functor.map_comp, Functor.map_sub, CategoryTheory.Functor.map_id,
        add_sub_cancel_right]
    have e2 : DO.Φ.map (Di.Φ.map ((wcQmtmPush Dp).map aN ≫
          (wcQmtmGamma hw₁ Dp Dτ hφ).app (wcSuppObj Dπ)) - 𝟙 _) =
        DO.Φ.map (Di.Φ.map ((wcQmtmPush Dp).map Γ) - 𝟙 _) := by
      rw [Functor.map_sub, Functor.map_sub, hw O jO kO hO DO hDO]
    rw [e2, e1, Functor.map_comp]
  · have key : wcQmtmUnit Dp ≫ (wcQmtmPush Dp).map (wcQmtmUnit Dπ) ≫ (wcQmtmPush Dp).map H =
        wcHMConst (Spec (.of B)) ℓ ((-t : ℤ_[ℓ]) : ℚ_[ℓ]) ≫ wcQmtmUnit Dp ≫
          (wcQmtmPush Dp).map (wcQmtmUnit Dπ) := by
