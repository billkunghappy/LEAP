    let G : C(↥(Limits.pullback Vt.hom p) × ℤ_[ℓ], ℚ_[ℓ]) :=
      (⟨S ∘ F.curry, hSc.comp F.curry.continuous⟩ :
        C(↥(Limits.pullback Vt.hom p), C(ℤ_[ℓ], ℚ_[ℓ]))).uncurry
    refine ⟨⟨fun z => ULift.up (G (τ.symm z)),
