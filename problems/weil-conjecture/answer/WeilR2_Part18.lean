  have hs : Function.Bijective (((wcProEtPush i).map
      ((adj₀.leftAdjointUniq adj).hom.app G)).hom.app (Opposite.op Vt)).hom :=
    ConcreteCategory.bijective_of_isIso
      (((sheafToPresheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).mapIso
        ((wcProEtPush i).mapIso ((adj₀.leftAdjointUniq adj).app G))).app (Opposite.op Vt)).hom
  have e1 : ⇑((adj.unit.app G).hom.app (Opposite.op Vt)).hom =
      ⇑(((wcProEtPush i).map ((adj₀.leftAdjointUniq adj).hom.app G)).hom.app
        (Opposite.op Vt)).hom ∘ ⇑((adj₀.unit.app G).hom.app (Opposite.op Vt)).hom := by
    funext x
    exact (congrArg (fun m => (m.hom.app (Opposite.op Vt)).hom x) huniq).symm
  rw [e1]
  exact hs.comp h0

theorem wc_ltp_closed_pullback_preserves_products {S Z : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    (hi : (wcProEtBC i).IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z)) :
    letI := hi
    Limits.PreservesLimitsOfShape (Discrete ℕ)
      ((wcProEtBC i).sheafPullback AddCommGrpCat.{u+1} (Scheme.ProEt.topology S)
        (Scheme.ProEt.topology Z)) :=
by
  classical
  letI := hi
  let Li := (wcProEtBC i).sheafPullback AddCommGrpCat.{u+1} (Scheme.ProEt.topology S)
    (Scheme.ProEt.topology Z)
  let Pu := (wcProEtBC i).sheafPushforwardContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z)
  let adj : Li ⊣ Pu := (wcProEtBC i).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
    (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z)

  have hbijS : ∀ {X Y : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} (f : X ⟶ Y),
      IsIso f → ∀ V, Function.Bijective (f.hom.app V).hom := by
    intro X Y f hf V
    have h1 : IsIso ((sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map f) :=
      Functor.map_isIso _ f
    have h2 : IsIso (((sheafToPresheaf (Scheme.ProEt.topology S)
        AddCommGrpCat.{u+1}).map f).app V) := inferInstance
    exact (ConcreteCategory.isIso_iff_bijective _).mp h2

  haveI : IsIso (sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).counit :=
    NatIso.isIso_of_isIso_app _
  let θ : Pu ≅ wcProEtPush i :=
    (Functor.rightUnitor Pu).symm ≪≫
      Functor.isoWhiskerLeft Pu
        (asIso (sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).counit).symm ≪≫
      (Functor.associator Pu (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
        (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})).symm ≪≫
      Functor.isoWhiskerRight (Functor.sheafPushforwardContinuousCompSheafToPresheafIso (wcProEtBC i)
        AddCommGrpCat.{u+1} (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z))
        (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) ≪≫
      Functor.associator _ _ _
  refine ⟨fun {F} => ?_⟩
  suffices hpost : IsIso (Limits.limit.post F Li) by
    haveI := hpost
    exact preservesLimit_of_isIso_post Li F
  apply wc_proet_isIso_of_sections_bijective
  intro U
  refine (Scheme.ProEt.topology Z).superset_covering (Sieve.generate_mono ?_)
    (wc_proet_wcontr_affine_open_cover i U)
  rintro T f ⟨⟨O, hO, hTO⟩, hT⟩
  obtain ⟨R, iR, I, iI, Vt, e, c, κ, hsq, hV, hiV⟩ :=
    wc_proet_henselian_thickening_exists i T O hO hTO hT

  have hinit : ∀ V : S.ProEt,
      Function.Bijective (fun a : Vt ⟶ V => (wcProEtBaseChange i).map a) := by
    intro V
    refine wc_proet_thickening_bc_hom_bijective i R I Vt e c hsq ?_ V
    intro X S' g _ a b hab
    exact wc_weaklyEtale_henselian_lift g R I a b hab
  have hlan : ∀ G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      Function.Bijective (⇑((toSheafify (Scheme.ProEt.topology Z)
        ((wcProEtBaseChange i).op.lan.obj G.obj)).app
          (Opposite.op ((wcProEtBaseChange i).obj Vt))).hom ∘
      ⇑(((wcProEtBaseChange i).op.lanUnit.app G.obj).app (Opposite.op Vt)).hom) := by
    intro G
    refine Function.Bijective.comp ?_ (wc_proet_lan_unit_bijective_of_init i Vt hinit G.obj)
    apply wc_proet_toSheafify_bijective_wcontr Z _ _ hiV
    intro m Q ι hι hpart
    obtain ⟨Vk, ιt, κk, hιt, hpt, hκ, hthick⟩ :=
      wc_proet_thickening_clopen_lift i R I Vt e c hsq m Q ι hι hpart
    refine wc_proet_lan_clopen_additive i Vt G m Q ι Vk ιt κk hιt hpt hκ
      (wc_proet_lan_unit_bijective_of_init i Vt hinit G.obj) (fun k => ?_)
    obtain ⟨Ak, iAk, Ik, iIk, ek, ck, hsqk⟩ := hthick k
    refine wc_proet_lan_unit_bijective_of_init i (Vk k) (fun V => ?_) G.obj
    refine wc_proet_thickening_bc_hom_bijective i Ak Ik (Vk k) ek ck hsqk ?_ V
    intro X S' g _ a b hab
    exact wc_weaklyEtale_henselian_lift g Ak Ik a b hab

  have hunit : ∀ G : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      Function.Bijective ((adj.unit.app G).hom.app (Opposite.op Vt)).hom := by
    intro G
    have h := wc_proet_closed_unit_bij_of_lan i Li (adj.ofNatIsoRight θ) Vt G (hlan G)
    have hg := hbijS (θ.hom.app (Li.obj G)) inferInstance (Opposite.op Vt)
    have hcomp : ⇑((((adj.ofNatIsoRight θ).unit.app G).hom.app (Opposite.op Vt)).hom) =
        ⇑((θ.hom.app (Li.obj G)).hom.app (Opposite.op Vt)).hom ∘
          ⇑((adj.unit.app G).hom.app (Opposite.op Vt)).hom := rfl
    rw [hcomp] at h
    exact (Function.Bijective.of_comp_iff' hg _).mp h

  let evA := sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
    (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op Vt)
  let evB := sheafToPresheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1} ⋙
    (evaluation Z.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op ((wcProEtBC i).obj Vt))
  let σ : evA ⟶ Li ⋙ evB :=
    { app := fun X => (adj.unit.app X).hom.app (Opposite.op Vt)
      naturality := fun X Y f =>
        congrArg (fun φ => φ.hom.app (Opposite.op Vt)) (adj.unit.naturality f) }
  haveI hσiso : ∀ X, IsIso (σ.app X) := fun X =>
    (ConcreteCategory.isIso_iff_bijective _).mpr (hunit X)
  let P := Limits.isLimitOfPreserves evA (Limits.limit.isLimit F)
  let Q := Limits.isLimitOfPreserves evB (Limits.limit.isLimit (F ⋙ Li))
  let w : F ⋙ evA ≅ (F ⋙ Li) ⋙ evB := Discrete.natIso (fun n => asIso (σ.app (F.obj n)))
  have hφ : σ.app (Limits.limit F) ≫ evB.map (Limits.limit.post F Li) =
      (P.conePointsIsoOfNatIso Q w).hom := by
    apply Q.hom_ext
    intro n
    rw [Limits.IsLimit.conePointsIsoOfNatIso_hom_comp, Category.assoc]
    change σ.app _ ≫ evB.map (Limits.limit.post F Li) ≫ evB.map (Limits.limit.π (F ⋙ Li) n) =
      evA.map (Limits.limit.π F n) ≫ σ.app (F.obj n)
    rw [← evB.map_comp, Limits.limit.post_π]
    exact (σ.naturality (Limits.limit.π F n)).symm
  have hPiso : IsIso (evB.map (Limits.limit.post F Li)) := by
    haveI : IsIso (σ.app (Limits.limit F) ≫ evB.map (Limits.limit.post F Li)) := by
      rw [hφ]; infer_instance
    exact IsIso.of_isIso_comp_left (σ.app _) _
  have hP : Function.Bijective (evB.map (Limits.limit.post F Li)).hom :=
    (ConcreteCategory.isIso_iff_bijective _).mp hPiso

  have hnat := (Limits.limit.post F Li).hom.naturality κ.hom.op
  have ha : Function.Bijective ((Li.obj (Limits.limit F)).obj.map κ.hom.op).hom :=
    (ConcreteCategory.isIso_iff_bijective _).mp inferInstance
  have hb : Function.Bijective ((Limits.limit (F ⋙ Li)).obj.map κ.hom.op).hom :=
    (ConcreteCategory.isIso_iff_bijective _).mp inferInstance
  have hfun : ⇑((Limits.limit (F ⋙ Li)).obj.map κ.hom.op).hom ∘
      ⇑((Limits.limit.post F Li).hom.app (Opposite.op T)).hom =
      ⇑((Limits.limit.post F Li).hom.app (Opposite.op ((wcProEtBaseChange i).obj Vt))).hom ∘
      ⇑((Li.obj (Limits.limit F)).obj.map κ.hom.op).hom := by
    funext x
    have := congrArg (fun φ => (AddCommGrpCat.Hom.hom φ) x) hnat
    exact this.symm
  have hR : Function.Bijective
      (⇑((Limits.limit.post F Li).hom.app (Opposite.op ((wcProEtBaseChange i).obj Vt))).hom ∘
        ⇑((Li.obj (Limits.limit F)).obj.map κ.hom.op).hom) := hP.comp ha
  rw [← hfun] at hR
  exact (Function.Bijective.of_comp_iff' hb _).mp hR

theorem wc_ltp_prod_quasiIso {C : Type*} [Category C] [Abelian C]
    [Limits.HasLimitsOfShape (Discrete ℕ) C] [HasExactLimitsOfShape (Discrete ℕ) C]
    (K L : CochainComplex C ℤ) (Kn Ln : ℕ → CochainComplex C ℤ)
    (pK : ∀ n, K ⟶ Kn n) (pL : ∀ n, L ⟶ Ln n)
    (hK : Limits.IsLimit (Limits.Fan.mk K pK)) (hL : Limits.IsLimit (Limits.Fan.mk L pL))
    (f : ∀ n, Kn n ⟶ Ln n) (hf : ∀ n, QuasiIso (f n)) (φ : K ⟶ L)
    (hφ : ∀ n, φ ≫ pL n = pK n ≫ f n) : QuasiIso φ :=
by
  classical

  let mk : (ℕ → CochainComplex C ℤ) → HomologicalComplex (Discrete ℕ ⥤ C) (ComplexShape.up ℤ) :=
    fun Mn =>
    { X := fun i => Discrete.functor (fun n => (Mn n).X i)
      d := fun i j => Discrete.natTrans (fun m => (Mn m.as).d i j)
      shape := fun i j h => by
        ext m
        simp [(Mn m.as).shape i j h]
      d_comp_d' := fun i j k _ _ => by
        ext m
        simp }
  let ff : mk Kn ⟶ mk Ln :=
    { f := fun i => Discrete.natTrans (fun m => (f m.as).f i)
      comm' := fun i j _ => by
        ext m
        simp [mk] }
  haveI hff : QuasiIso ff := by
    rw [HomologicalComplex.quasiIso_iff_evaluation]
    rintro ⟨n⟩
    exact hf n
  haveI : (Limits.lim : (Discrete ℕ ⥤ C) ⥤ C).Additive :=
    Functor.additive_of_preserves_binary_products _
  have h1 : QuasiIso ((Limits.lim.mapHomologicalComplex (ComplexShape.up ℤ)).map ff) :=
    HomologicalComplex.quasiIso_map_of_preservesHomology ff Limits.lim

  have key : ∀ (M : CochainComplex C ℤ) (Mn : ℕ → CochainComplex C ℤ) (pM : ∀ n, M ⟶ Mn n)
      (hM : Limits.IsLimit (Limits.Fan.mk M pM)),
      ∃ e : M ≅ (Limits.lim.mapHomologicalComplex (ComplexShape.up ℤ)).obj (mk Mn),
        ∀ (n : ℕ) (i : ℤ), e.hom.f i ≫ Limits.limit.π ((mk Mn).X i) ⟨n⟩ = (pM n).f i := by
    intro M Mn pM hM
    have hdeg : ∀ i, Limits.IsLimit (Limits.Fan.mk (M.X i) (fun n => (pM n).f i)) := fun i =>
      Limits.isLimitFanMkObjOfIsLimit (HomologicalComplex.eval C (ComplexShape.up ℤ) i) _ _ hM
    let ei : ∀ i, M.X i ≅ Limits.limit ((mk Mn).X i) := fun i =>
      (hdeg i).conePointUniqueUpToIso (Limits.limit.isLimit ((mk Mn).X i))
    have hei : ∀ (n : ℕ) (i : ℤ), (ei i).hom ≫ Limits.limit.π ((mk Mn).X i) ⟨n⟩ = (pM n).f i :=
      fun n i => (hdeg i).conePointUniqueUpToIso_hom_comp (Limits.limit.isLimit ((mk Mn).X i)) ⟨n⟩
    refine ⟨HomologicalComplex.Hom.isoOfComponents ei ?_, ?_⟩
    · intro i j _
      apply Limits.limit.hom_ext
      rintro ⟨n⟩
      simp only [Functor.mapHomologicalComplex_obj_d, Limits.lim_map, Category.assoc,
        Limits.limMap_π]
      rw [hei n j, reassoc_of% (hei n i)]
      simp [mk]
    · intro n i
      simpa using hei n i
  obtain ⟨eK, heK⟩ := key K Kn pK hK
  obtain ⟨eL, heL⟩ := key L Ln pL hL
  have sq : eK.hom ≫ (Limits.lim.mapHomologicalComplex (ComplexShape.up ℤ)).map ff =
      φ ≫ eL.hom := by
    ext i : 1
    apply Limits.limit.hom_ext
    rintro ⟨n⟩
    simp only [HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f, Limits.lim_map,
      Category.assoc, Limits.limMap_π]
    rw [heL n i, reassoc_of% (heK n i)]
    have := congrArg (fun g => HomologicalComplex.Hom.f g i) (hφ n)
    simp only [HomologicalComplex.comp_f] at this
    rw [this]
    simp [ff]
  exact (quasiIso_iff_of_arrow_mk_iso φ _ (Arrow.isoMk eK eL sq)).mpr h1

theorem wc_ltp_prod_resolution {C : Type*} [Category C] [Abelian C]
    [Limits.HasLimitsOfShape (Discrete ℕ) C] [HasExactLimitsOfShape (Discrete ℕ) C]
    (M : C) (Mn : ℕ → C) (pr : ∀ n, M ⟶ Mn n) (hM : Limits.IsLimit (Limits.Fan.mk M pr))
    (I : InjectiveResolution M) (In : ∀ n, InjectiveResolution (Mn n)) :
    ∃ (P : CochainComplex C ℤ) (p : ∀ n, P ⟶ (In n).cochainComplex),
      Nonempty (Limits.IsLimit (Limits.Fan.mk P p)) ∧
        Nonempty (HomotopyEquiv I.cochainComplex P) :=
by

  have s7 : ∀ {Y Z : C} (f : Z ⟶ Y) (I : InjectiveResolution Y) (J : InjectiveResolution Z)
      (E : J.cochainComplex ⟶ I.cochainComplex),
      E.f 0 = (J.cochainComplexXIso 0 0 rfl).hom ≫ (InjectiveResolution.desc f I J).f 0 ≫
        (I.cochainComplexXIso 0 0 rfl).inv →
      J.ι' ≫ E = (CochainComplex.singleFunctor C 0).map f ≫ I.ι' := by
    intro Y Z f I J E hE0
    apply HomologicalComplex.from_single_hom_ext
    rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f, hE0, InjectiveResolution.ι'_f_zero,
      InjectiveResolution.ι'_f_zero]
    erw [HomologicalComplex.single_map_f_self]
    simp only [Category.assoc, Iso.inv_hom_id_assoc]
    congr 1
    have key := InjectiveResolution.desc_commutes_zero f I J
    erw [Category.assoc, Iso.inv_hom_id_assoc, reassoc_of% key]
    exact Category.assoc _ _ _

  have s2 : ∀ (K L : CochainComplex C ℤ) (a b : ℤ) [K.IsStrictlyGE a] [L.IsStrictlyGE b]
      [∀ n, Injective (K.X n)] [∀ n, Injective (L.X n)] (f : K ⟶ L) [QuasiIso f],
      Nonempty (HomotopyEquiv K L) := by
    intro K L a b _ _ _ _ f _
    letI := HasDerivedCategory.standard C
    haveI := CochainComplex.isKInjective_of_injective K a
    haveI := CochainComplex.isKInjective_of_injective L b
    let q := HomotopyCategory.quotient C (ComplexShape.up ℤ)
    have hQ : IsIso (DerivedCategory.Q.map f) :=
      (DerivedCategory.isIso_Q_map_iff_quasiIso C f).mpr inferInstance
    have hQh : IsIso (DerivedCategory.Qh.map (q.map f)) :=
      (NatIso.isIso_map_iff (DerivedCategory.quotientCompQhIso C) f).mpr hQ
    obtain ⟨g, hg⟩ := (CochainComplex.IsKInjective.Qh_map_bijective (q.obj L) K).2
      (inv (DerivedCategory.Qh.map (q.map f)))
    have h1 : q.map f ≫ g = 𝟙 _ := by
      apply (CochainComplex.IsKInjective.Qh_map_bijective (q.obj K) K).1
      simp [hg]
    have h2 : g ≫ q.map f = 𝟙 _ := by
      apply (CochainComplex.IsKInjective.Qh_map_bijective (q.obj L) L).1
      simp [hg]
    exact ⟨HomotopyCategory.homotopyEquivOfIso ⟨q.map f, g, h1, h2⟩⟩

  let c := ComplexShape.up ℤ
  let X : ℕ → CochainComplex C ℤ := fun n => (In n).cochainComplex
  let P := ∏ᶜ X
  let p : ∀ n, P ⟶ X n := Limits.Pi.π X
  have hP : Limits.IsLimit (Limits.Fan.mk P p) := Limits.productIsProduct X
  let π : ∀ n, I.cochainComplex ⟶ X n := fun n =>
    HomologicalComplex.extendMap (InjectiveResolution.desc (pr n) (In n) I)
      ComplexShape.embeddingUpNat
  have hπ : ∀ n, I.ι' ≫ π n = (CochainComplex.singleFunctor C 0).map (pr n) ≫ (In n).ι' :=
    fun n => s7 (pr n) (In n) I (π n) (HomologicalComplex.extendMap_f _ _ rfl)
  let Φ : I.cochainComplex ⟶ P := Limits.Pi.lift π

  have hsingle : Limits.IsLimit (Limits.Fan.mk ((CochainComplex.singleFunctor C 0).obj M)
      (fun n => (CochainComplex.singleFunctor C 0).map (pr n))) :=
    Limits.isLimitFanMkObjOfIsLimit (CochainComplex.singleFunctor C 0) Mn pr hM
  have hq : QuasiIso (I.ι' ≫ Φ) := by
    refine wc_ltp_prod_quasiIso _ P _ X _ p hsingle hP (fun n => (In n).ι')
      (fun n => inferInstance) (I.ι' ≫ Φ) ?_
    intro n
    have hl : Φ ≫ p n = π n := by simp [Φ, p]
    rw [Category.assoc, hl]
    exact hπ n
  haveI : QuasiIso Φ := (quasiIso_iff_comp_left I.ι' Φ).mp hq

  have hdeg : ∀ k, Limits.IsLimit (Limits.Fan.mk (P.X k) (fun n => (p n).f k)) :=
    fun k => Limits.isLimitFanMkObjOfIsLimit (HomologicalComplex.eval C c k) _ _
      (Limits.productIsProduct X)
  haveI hPi : ∀ k, Injective (P.X k) := by
    intro k
    exact Injective.of_iso ((hdeg k).conePointUniqueUpToIso
      (Limits.productIsProduct (fun n => (X n).X k))).symm
      (inferInstance : Injective (Limits.piObj (fun n => (X n).X k)))
  haveI hPge : CochainComplex.IsStrictlyGE P 0 := by
    rw [CochainComplex.isStrictlyGE_iff]
    intro k hk
    exact Limits.IsLimit.isZero_pt (hdeg k) (Functor.isZero _ (fun n =>
      (X n.as).isZero_of_isStrictlyGE 0 k hk))

  exact ⟨P, p, ⟨hP⟩, s2 I.cochainComplex P 0 0 Φ⟩

theorem wc_ltp_pbc_transfer {𝒜 ℬ 𝒞 : Type*} [Category 𝒜] [Category ℬ] [Category 𝒞]
    [Abelian 𝒜] [Abelian ℬ] [Abelian 𝒞]
    (Li : 𝒜 ⥤ ℬ) (evA : 𝒜 ⥤ 𝒞) (evB : ℬ ⥤ 𝒞) [Li.Additive] [evA.Additive] [evB.Additive]
    (σ : evA ⟶ Li ⋙ evB) (K K' : CochainComplex 𝒜 ℤ) (e : HomotopyEquiv K K')
    (J J' : CochainComplex ℬ ℤ) (m₀ m₁ : ℤ) (hJ : J.IsStrictlyGE m₀) (hJ' : J'.IsStrictlyGE m₁)
    (hJi : ∀ k, Injective (J.X k)) (hJi' : ∀ k, Injective (J'.X k))
    (j : (Li.mapHomologicalComplex (ComplexShape.up ℤ)).obj K ⟶ J)
    (j' : (Li.mapHomologicalComplex (ComplexShape.up ℤ)).obj K' ⟶ J')
    (hj : QuasiIso j) (hj' : QuasiIso j')
    (h' : QuasiIso ((NatTrans.mapHomologicalComplex σ (ComplexShape.up ℤ)).app K' ≫
      (evB.mapHomologicalComplex (ComplexShape.up ℤ)).map j')) :
    QuasiIso ((NatTrans.mapHomologicalComplex σ (ComplexShape.up ℤ)).app K ≫
      (evB.mapHomologicalComplex (ComplexShape.up ℤ)).map j) :=
by
  classical

  have qiC : ∀ {X Y : CochainComplex 𝒞 ℤ} {f g : X ⟶ Y}, Homotopy f g → QuasiIso f →
      QuasiIso g := by
    intro X Y f g h hf
    rw [quasiIso_iff] at hf ⊢
    intro i
    specialize hf i
    rw [quasiIsoAt_iff_isIso_homologyMap] at hf ⊢
    rwa [← h.homologyMap_eq i]
  have qiB : ∀ {X Y : CochainComplex ℬ ℤ} {f g : X ⟶ Y}, Homotopy f g → QuasiIso f →
      QuasiIso g := by
    intro X Y f g h hf
    rw [quasiIso_iff] at hf ⊢
    intro i
    specialize hf i
    rw [quasiIsoAt_iff_isIso_homologyMap] at hf ⊢
    rwa [← h.homologyMap_eq i]

  have : J.IsStrictlyGE m₀ := hJ
  have : J'.IsStrictlyGE m₁ := hJ'
  have : ∀ k, Injective (J.X k) := hJi
  have : ∀ k, Injective (J'.X k) := hJi'
  have : J.IsKInjective := CochainComplex.isKInjective_of_injective J m₀
  have : J'.IsKInjective := CochainComplex.isKInjective_of_injective J' m₁
  let _ := HasDerivedCategory.standard ℬ
  have isoQh : ∀ {X Y : CochainComplex ℬ ℤ} (s : X ⟶ Y), QuasiIso s →
      IsIso (DerivedCategory.Qh.map ((HomotopyCategory.quotient ℬ (ComplexShape.up ℤ)).map s)) := by
    intro X Y s hs
    rw [DerivedCategory.isIso_Qh_map_iff, HomotopyCategory.quotient_map_mem_quasiIso_iff,
      HomologicalComplex.mem_quasiIso_iff]
    exact hs

  have lift : ∀ {L L' M : CochainComplex ℬ ℤ} [M.IsKInjective] (s : L ⟶ L'), QuasiIso s →
      ∀ g : L ⟶ M, ∃ φ : L' ⟶ M, Nonempty (Homotopy (s ≫ φ) g) := by
    intro L L' M _ s hs g
    have := isoQh s hs
    obtain ⟨φb, hφb⟩ := (CochainComplex.IsKInjective.Qh_map_bijective
      ((HomotopyCategory.quotient ℬ (ComplexShape.up ℤ)).obj L') M).2
      (inv (DerivedCategory.Qh.map ((HomotopyCategory.quotient ℬ (ComplexShape.up ℤ)).map s)) ≫
        DerivedCategory.Qh.map ((HomotopyCategory.quotient ℬ (ComplexShape.up ℤ)).map g))
    refine ⟨Quot.out φb, ⟨HomotopyCategory.homotopyOfEq _ _ ?_⟩⟩
    apply (CochainComplex.IsKInjective.Qh_map_bijective
      ((HomotopyCategory.quotient ℬ (ComplexShape.up ℤ)).obj L) M).1
    have hout : (HomotopyCategory.quotient ℬ (ComplexShape.up ℤ)).map (Quot.out φb) = φb :=
      HomotopyCategory.quotient_map_out φb
    rw [CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_comp, hout, hφb,
      IsIso.hom_inv_id_assoc]

  have hinv : ∀ {A B : CochainComplex ℬ ℤ} [A.IsKInjective] [B.IsKInjective] (φ : A ⟶ B),
      QuasiIso φ → ∃ ψ : B ⟶ A, Nonempty (Homotopy (φ ≫ ψ) (𝟙 A)) ∧
        Nonempty (Homotopy (ψ ≫ φ) (𝟙 B)) := by
    intro A B _ _ φ hφ
    have := isoQh φ hφ
    obtain ⟨ψb, hψb⟩ := (CochainComplex.IsKInjective.Qh_map_bijective
      ((HomotopyCategory.quotient ℬ (ComplexShape.up ℤ)).obj B) A).2
      (inv (DerivedCategory.Qh.map ((HomotopyCategory.quotient ℬ (ComplexShape.up ℤ)).map φ)))
    have hout : (HomotopyCategory.quotient ℬ (ComplexShape.up ℤ)).map (Quot.out ψb) = ψb :=
      HomotopyCategory.quotient_map_out ψb
    refine ⟨Quot.out ψb, ⟨HomotopyCategory.homotopyOfEq _ _ ?_⟩,
      ⟨HomotopyCategory.homotopyOfEq _ _ ?_⟩⟩
    · apply (CochainComplex.IsKInjective.Qh_map_bijective
        ((HomotopyCategory.quotient ℬ (ComplexShape.up ℤ)).obj A) A).1
      rw [CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_comp, hout, hψb,
        IsIso.hom_inv_id, CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id]
    · apply (CochainComplex.IsKInjective.Qh_map_bijective
        ((HomotopyCategory.quotient ℬ (ComplexShape.up ℤ)).obj B) B).1
      rw [CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_comp, hout, hψb,
        IsIso.inv_hom_id, CategoryTheory.Functor.map_id, CategoryTheory.Functor.map_id]

  obtain ⟨φ, ⟨H₁⟩⟩ := lift (M := J) j' hj'
    ((Li.mapHomologicalComplex (ComplexShape.up ℤ)).map e.inv ≫ j)
  have hφ : QuasiIso φ := by
    have h1 : QuasiIso ((Li.mapHomologicalComplex (ComplexShape.up ℤ)).map e.inv) :=
      (inferInstance : QuasiIso (Li.mapHomotopyEquiv e.symm).hom)
    have h2 : QuasiIso ((Li.mapHomologicalComplex (ComplexShape.up ℤ)).map e.inv ≫ j) :=
      quasiIso_comp _ _
    have h3 : QuasiIso (j' ≫ φ) := qiB H₁.symm h2
    exact (quasiIso_iff_comp_left j' φ).mp h3
  obtain ⟨ψ, ⟨h₁⟩, ⟨h₂⟩⟩ := hinv φ hφ
  let E : HomotopyEquiv J' J := ⟨φ, ψ, h₁, h₂⟩
  have hevφ : QuasiIso ((evB.mapHomologicalComplex (ComplexShape.up ℤ)).map φ) :=
    (inferInstance : QuasiIso (evB.mapHomotopyEquiv E).hom)
  have hevA : QuasiIso ((evA.mapHomologicalComplex (ComplexShape.up ℤ)).map e.hom) :=
    (inferInstance : QuasiIso (evA.mapHomotopyEquiv e).hom)
  have hT : QuasiIso ((evA.mapHomologicalComplex (ComplexShape.up ℤ)).map e.hom ≫
      (((NatTrans.mapHomologicalComplex σ (ComplexShape.up ℤ)).app K' ≫
        (evB.mapHomologicalComplex (ComplexShape.up ℤ)).map j') ≫
        (evB.mapHomologicalComplex (ComplexShape.up ℤ)).map φ)) := by
    have := h'
    have := hevφ
    have := hevA
    exact quasiIso_comp _ _

  have H₂ : Homotopy ((Li.mapHomologicalComplex (ComplexShape.up ℤ)).map e.hom ≫ j' ≫ φ) j :=
    (H₁.compLeft ((Li.mapHomologicalComplex (ComplexShape.up ℤ)).map e.hom)).trans
      ((Homotopy.ofEq (by rw [← Category.assoc, ← CategoryTheory.Functor.map_comp])).trans
        (((Li.mapHomotopy e.homotopyHomInvId).compRight j).trans
          (Homotopy.ofEq (by rw [CategoryTheory.Functor.map_id, Category.id_comp]))))
  have H₃ := (evB.mapHomotopy H₂).compLeft
    ((NatTrans.mapHomologicalComplex σ (ComplexShape.up ℤ)).app K)
  have hcomp : (evB.mapHomologicalComplex (ComplexShape.up ℤ)).map
      ((Li.mapHomologicalComplex (ComplexShape.up ℤ)).map e.hom) =
      ((Li ⋙ evB).mapHomologicalComplex (ComplexShape.up ℤ)).map e.hom := rfl
  have heq : (NatTrans.mapHomologicalComplex σ (ComplexShape.up ℤ)).app K ≫
      (evB.mapHomologicalComplex (ComplexShape.up ℤ)).map
        ((Li.mapHomologicalComplex (ComplexShape.up ℤ)).map e.hom ≫ j' ≫ φ) =
      (evA.mapHomologicalComplex (ComplexShape.up ℤ)).map e.hom ≫
      (((NatTrans.mapHomologicalComplex σ (ComplexShape.up ℤ)).app K' ≫
        (evB.mapHomologicalComplex (ComplexShape.up ℤ)).map j') ≫
        (evB.mapHomologicalComplex (ComplexShape.up ℤ)).map φ) := by
    rw [CategoryTheory.Functor.map_comp, CategoryTheory.Functor.map_comp, hcomp, ← Category.assoc,
      ← NatTrans.mapHomologicalComplex_naturality]
    simp only [Category.assoc]
  rw [heq] at H₃
  exact qiC H₃ hT

theorem wc_ltp_products {S Z E : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    (g : E ⟶ S) [IsAffineHom g] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (W : S.ProEt)
    (hi : (wcProEtBC i).IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z))
    (hg : (wcProEtBC g).IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology E))
    (h : ∀ n : ℕ, wcAbPBCAt i g W hi hg (wcContSheaf E (ZMod (ℓ ^ n)))) :
    wcAbPBCAt i g W hi hg (wcContSheaf E ((n : ℕ) → ZMod (ℓ ^ n))) :=
by
  classical
  unfold wcAbPBCAt
  intro Pg PiF Li adj I K J m₀ hJ hJi j hj w hw
  letI := hi
  letI := hg
  let c := ComplexShape.up ℤ
  let evA := sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
    (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op W)
  let evB := sheafToPresheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1} ⋙
    (evaluation Z.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op ((wcProEtBC i).obj W))
  haveI hexE := wc_proet_products_exact E
  haveI hexZ := wc_proet_products_exact Z
  haveI hexAb : HasExactLimitsOfShape (Discrete ℕ) AddCommGrpCat.{u+1} :=
    HasExactLimitsOfShape.of_domain_equivalence AddCommGrpCat.{u+1}
      (Discrete.equivalence (Equiv.ulift.{u+1, 0} (α := ℕ)))
  haveI : Limits.PreservesLimitsOfSize.{0, 0} Pg :=
    ((wcProEtBC g).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology E)).rightAdjoint_preservesLimits
  haveI : Limits.PreservesLimitsOfShape (Discrete ℕ) Li :=
    wc_ltp_closed_pullback_preserves_products i hi
  haveI : Pg.Additive := Functor.additive_of_preserves_binary_products _
  haveI : Limits.PreservesLimitsOfSize.{0, 0} PiF := adj.rightAdjoint_preservesLimits
  haveI : PiF.Additive := Functor.additive_of_preserves_binary_products _
  haveI : Li.Additive := Adjunction.left_adjoint_additive adj
  let σ : evA ⟶ Li ⋙ evB :=
    { app := fun X => (adj.unit.app X).hom.app (Opposite.op W)
      naturality := fun X Y f =>
        congrArg (fun φ => φ.hom.app (Opposite.op W)) (adj.unit.naturality f) }
  let Mn : ℕ → Sheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1} :=
    fun n => wcContSheaf E (ZMod (ℓ ^ n))
  let pr : ∀ n, wcContSheaf E ((n : ℕ) → ZMod (ℓ ^ n)) ⟶ Mn n := fun n =>
    wcContSheafMap E (Pi.evalAddMonoidHom (fun n => ZMod (ℓ ^ n)) n) (continuous_apply n)
  have hM : Limits.IsLimit (Limits.Fan.mk _ pr) :=
    (wc_contSheaf_pi_isLimit E (fun n => ZMod (ℓ ^ n))).some

  let In : ∀ n, InjectiveResolution (Mn n) := fun n => injectiveResolution (Mn n)
  obtain ⟨P, p, ⟨hP⟩, ⟨e⟩⟩ := wc_ltp_prod_resolution _ Mn pr hM I In
  let Kn : ℕ → CochainComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) ℤ :=
    fun n => (Pg.mapHomologicalComplex c).obj (In n).cochainComplex
  let K' := (Pg.mapHomologicalComplex c).obj P
  have hK' : Limits.IsLimit (Limits.Fan.mk K' (fun n => (Pg.mapHomologicalComplex c).map (p n))) :=
    Limits.isLimitFanMkObjOfIsLimit (Pg.mapHomologicalComplex c) _ p hP
  have hLK' : Limits.IsLimit (Limits.Fan.mk ((Li.mapHomologicalComplex c).obj K')
      (fun n => (Li.mapHomologicalComplex c).map ((Pg.mapHomologicalComplex c).map (p n)))) :=
    Limits.isLimitFanMkObjOfIsLimit (Li.mapHomologicalComplex c) _ _ hK'

  have hge : ∀ n, CochainComplex.IsStrictlyGE ((Li.mapHomologicalComplex c).obj (Kn n)) 0 := by
    intro n
    rw [CochainComplex.isStrictlyGE_iff]
    intro k hk
    exact Li.map_isZero (Pg.map_isZero ((In n).cochainComplex.isZero_of_isStrictlyGE 0 k hk))
  have hJn : ∀ n, ∃ (L : CochainComplex (Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) ℤ)
      (jn : (Li.mapHomologicalComplex c).obj (Kn n) ⟶ L),
      QuasiIso jn ∧ (∀ k, Injective (L.X k)) ∧ CochainComplex.IsStrictlyGE L 0 := by
    intro n
    haveI := hge n
    obtain ⟨L, jn, h1, h2, h3⟩ :=
      CochainComplex.Plus.modelCategoryQuillen.exists_quasiIso_injective
        ((Li.mapHomologicalComplex c).obj (Kn n)) 0
    exact ⟨L, jn, h1, h2, h3⟩
  choose Jn jn hjn hJni hJnge using hJn

  have hdeg : ∀ k, Limits.IsLimit (Limits.Fan.mk ((∏ᶜ Jn).X k)
      (fun n => (Limits.Pi.π Jn n).f k)) :=
    fun k => Limits.isLimitFanMkObjOfIsLimit
      (HomologicalComplex.eval (Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) c k) _ _
      (Limits.productIsProduct Jn)
  have hJ'i : ∀ k, Injective ((∏ᶜ Jn).X k) := by
    intro k
    haveI : ∀ n, Injective ((Jn n).X k) := fun n => hJni n k
    exact Injective.of_iso ((hdeg k).conePointUniqueUpToIso
      (Limits.productIsProduct (fun n => (Jn n).X k))).symm
      (inferInstance : Injective (Limits.piObj (fun n => (Jn n).X k)))
  have hJ'ge : CochainComplex.IsStrictlyGE (∏ᶜ Jn) 0 := by
    rw [CochainComplex.isStrictlyGE_iff]
    intro k hk
    exact Limits.IsLimit.isZero_pt (hdeg k) (Functor.isZero _ (fun n =>
      (Jn n.as).isZero_of_isStrictlyGE 0 k hk))
  let j' : (Li.mapHomologicalComplex c).obj K' ⟶ ∏ᶜ Jn :=
    Limits.Pi.lift (fun n =>
      (Li.mapHomologicalComplex c).map ((Pg.mapHomologicalComplex c).map (p n)) ≫ jn n)
  have hj'π : ∀ n, j' ≫ Limits.Pi.π Jn n =
      (Li.mapHomologicalComplex c).map ((Pg.mapHomologicalComplex c).map (p n)) ≫ jn n := by
    intro n
    simp [j']
  have hj' : QuasiIso j' :=
    wc_ltp_prod_quasiIso _ _ _ Jn _ _ hLK' (Limits.productIsProduct Jn) jn hjn j' hj'π

  let wn : ∀ n, _ := fun n => (NatTrans.mapHomologicalComplex σ c).app (Kn n) ≫
    (evB.mapHomologicalComplex c).map (jn n)
  have hwn : ∀ n, QuasiIso (wn n) := fun n =>
    h n (In n) (Jn n) 0 (hJnge n) (hJni n) (jn n) (hjn n) (wn n) (fun _ _ => rfl)

  let w' := (NatTrans.mapHomologicalComplex σ c).app K' ≫ (evB.mapHomologicalComplex c).map j'
  have hcompat : ∀ n, w' ≫ (evB.mapHomologicalComplex c).map (Limits.Pi.π Jn n) =
      (evA.mapHomologicalComplex c).map ((Pg.mapHomologicalComplex c).map (p n)) ≫ wn n := by
    intro n
    have hnat := (NatTrans.mapHomologicalComplex σ c).naturality
      ((Pg.mapHomologicalComplex c).map (p n))
    simp only [w', wn, Category.assoc, ← Functor.map_comp, hj'π]
    rw [Functor.map_comp, ← Category.assoc, ← Category.assoc]
    congr 1
    exact hnat.symm
  have hw' : QuasiIso w' :=
    wc_ltp_prod_quasiIso _ _ _ _ _ _
      (Limits.isLimitFanMkObjOfIsLimit (evA.mapHomologicalComplex c) _ _ hK')
      (Limits.isLimitFanMkObjOfIsLimit (evB.mapHomologicalComplex c) _ _
        (Limits.productIsProduct Jn))
      wn hwn w' hcompat

  have hweq : w = (NatTrans.mapHomologicalComplex σ c).app K ≫
      (evB.mapHomologicalComplex c).map j := by
    ext m x
    exact hw m x
  rw [hweq]
  exact wc_ltp_pbc_transfer Li evA evB σ K K' (Pg.mapHomotopyEquiv e) J (∏ᶜ Jn) m₀ 0 hJ hJ'ge
    hJi hJ'i j j' hj hj' hw'

theorem wc_ltp_horseshoe {C : Type*} [Category C] [Abelian C] (S : ShortComplex C)
    (hS : S.ShortExact) (I₁ : InjectiveResolution S.X₁) (I₃ : InjectiveResolution S.X₃) :
    ∃ (I₂ : InjectiveResolution S.X₂) (i : I₁.cochainComplex ⟶ I₂.cochainComplex)
      (p : I₂.cochainComplex ⟶ I₃.cochainComplex),
      ∀ n : ℤ, ∃ h : i.f n ≫ p.f n = 0, Nonempty (ShortComplex.mk (i.f n) (p.f n) h).Splitting :=
by

  have s3 : ∃ (σ : S.X₂ ⟶ I₁.cocomplex.X 0) (t : ∀ n : ℕ, I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)), S.f ≫ σ = I₁.ι.f 0 ∧ σ ≫ I₁.cocomplex.d 0 1 + S.g ≫ I₃.ι.f 0 ≫ t 0 = 0 ∧ ∀ n : ℕ, t n ≫ I₁.cocomplex.d (n + 1) (n + 2) + I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = 0 := by
    have hmf : Mono S.f := hS.mono_f
    have heg : Epi S.g := hS.epi_g
    obtain ⟨ι₁, hι₁⟩ : ∃ ι₁ : S.X₁ ⟶ I₁.cocomplex.X 0, ι₁ = I₁.ι.f 0 := ⟨_, rfl⟩
    obtain ⟨ι₃, hι₃⟩ : ∃ ι₃ : S.X₃ ⟶ I₃.cocomplex.X 0, ι₃ = I₃.ι.f 0 := ⟨_, rfl⟩
    have hι₃m : Mono ι₃ := by subst hι₃; exact (inferInstance : Mono (I₃.ι.f 0))
    have hι₁d : ι₁ ≫ I₁.cocomplex.d 0 1 = 0 := by subst hι₁; exact I₁.ι_f_zero_comp_complex_d
    have ref₃ : ∀ {A : C} (x : A ⟶ I₃.cocomplex.X 0), x ≫ I₃.cocomplex.d 0 1 = 0 →
        ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₃), π ≫ x = y ≫ ι₃ := by
      subst hι₃
      intro A x hx
      exact I₃.exact₀.exact_up_to_refinements x hx
    let σ : S.X₂ ⟶ I₁.cocomplex.X 0 := Injective.factorThru ι₁ S.f
    have hσ : S.f ≫ σ = ι₁ := Injective.comp_factorThru _ _
    have hv : S.f ≫ (-(σ ≫ I₁.cocomplex.d 0 1)) = 0 := by
      rw [Preadditive.comp_neg, ← Category.assoc, hσ, hι₁d, neg_zero]
    let u : S.X₃ ⟶ I₁.cocomplex.X 1 := hS.exact.desc _ hv
    have hu : S.g ≫ u = -(σ ≫ I₁.cocomplex.d 0 1) := hS.exact.g_desc _ hv
    let t₀ : I₃.cocomplex.X 0 ⟶ I₁.cocomplex.X 1 := Injective.factorThru u ι₃
    have ht₀ : ι₃ ≫ t₀ = u := Injective.comp_factorThru _ _
    let Q : ∀ n : ℕ, (I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)) → Prop := fun n t =>
      ∀ (A : C) (y : A ⟶ I₃.cocomplex.X n), y ≫ I₃.cocomplex.d n (n + 1) = 0 →
        y ≫ t ≫ I₁.cocomplex.d (n + 1) (n + 2) = 0
    have hud : u ≫ I₁.cocomplex.d 1 2 = 0 := by
      apply (cancel_epi S.g).1
      rw [← Category.assoc, hu, Preadditive.neg_comp, Category.assoc,
        HomologicalComplex.d_comp_d, Limits.comp_zero, neg_zero, Limits.comp_zero]
    have h₀ : Q 0 t₀ := by
      intro A y hy
      obtain ⟨A', π, hπ, z, hz⟩ := ref₃ y hy
      have key : π ≫ y ≫ t₀ ≫ I₁.cocomplex.d 1 2 = 0 := by
        rw [← Category.assoc, hz, Category.assoc, ← Category.assoc ι₃, ht₀, hud,
          Limits.comp_zero]
      exact (cancel_epi π).1 (key.trans Limits.comp_zero.symm)
    have step : ∀ (n : ℕ) (t : I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)), Q n t →
        ∃ t' : I₃.cocomplex.X (n + 1) ⟶ I₁.cocomplex.X (n + 2),
          I₃.cocomplex.d n (n + 1) ≫ t' = -(t ≫ I₁.cocomplex.d (n + 1) (n + 2)) ∧
            Q (n + 1) t' := by
      intro n t ht
      let E := ShortComplex.mk (Limits.kernel.ι (I₃.cocomplex.d n (n + 1)))
        (I₃.cocomplex.d n (n + 1)) (Limits.kernel.condition _)
      have hE : E.Exact := E.exact_of_f_is_kernel (Limits.kernelIsKernel _)
      have hf : E.f ≫ (-(t ≫ I₁.cocomplex.d (n + 1) (n + 2))) = 0 := by
        rw [Preadditive.comp_neg, ht _ _ (Limits.kernel.condition _), neg_zero]
      have hdesc : I₃.cocomplex.d n (n + 1) ≫ hE.descToInjective _ hf =
          -(t ≫ I₁.cocomplex.d (n + 1) (n + 2)) := hE.comp_descToInjective _ hf
      refine ⟨hE.descToInjective _ hf, hdesc, ?_⟩
      intro A y hy
      have ref : ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (z : A' ⟶ I₃.cocomplex.X n),
          π ≫ y = z ≫ I₃.cocomplex.d n (n + 1) :=
        (I₃.exact_succ n).exact_up_to_refinements y hy
      obtain ⟨A', π, hπ, z, hz⟩ := ref
      have key : π ≫ y ≫ hE.descToInjective _ hf ≫ I₁.cocomplex.d (n + 2) (n + 3) = 0 := by
        rw [← Category.assoc, hz, Category.assoc, ← Category.assoc (I₃.cocomplex.d n (n + 1)),
          hdesc, Preadditive.neg_comp, Category.assoc, HomologicalComplex.d_comp_d,
          Limits.comp_zero, neg_zero, Limits.comp_zero]
      exact (cancel_epi π).1 (key.trans Limits.comp_zero.symm)
    choose F hF using step
    let T : ∀ n, {t : I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1) // Q n t} := fun n =>
      Nat.rec (motive := fun n => {t : I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1) // Q n t})
        ⟨t₀, h₀⟩ (fun n T => ⟨F n T.1 T.2, (hF n T.1 T.2).2⟩) n
    refine ⟨σ, fun n => (T n).1, hσ.trans hι₁, ?_, ?_⟩
    · show σ ≫ I₁.cocomplex.d 0 1 + S.g ≫ I₃.ι.f 0 ≫ t₀ = 0
      rw [← hι₃, ht₀, hu, add_neg_cancel]
    · intro n
      show (T n).1 ≫ I₁.cocomplex.d (n + 1) (n + 2) +
        I₃.cocomplex.d n (n + 1) ≫ F n (T n).1 (T n).2 = 0
      rw [(hF n (T n).1 (T n).2).1, add_neg_cancel]

  have s4 : ∀ (σ : S.X₂ ⟶ I₁.cocomplex.X 0) (t : ∀ n : ℕ, I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)), S.f ≫ σ = I₁.ι.f 0 → σ ≫ I₁.cocomplex.d 0 1 + S.g ≫ I₃.ι.f 0 ≫ t 0 = 0 → (∀ n : ℕ, t n ≫ I₁.cocomplex.d (n + 1) (n + 2) + I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = 0) → ∃ (K : CochainComplex C ℕ) (i : I₁.cocomplex ⟶ K) (p : K ⟶ I₃.cocomplex) (e : (CochainComplex.single₀ C).obj S.X₂ ⟶ K), (∀ n, Injective (K.X n)) ∧ I₁.ι ≫ i = (CochainComplex.single₀ C).map S.f ≫ e ∧ e ≫ p = (CochainComplex.single₀ C).map S.g ≫ I₃.ι ∧ ∀ n : ℕ, ∃ h : i.f n ≫ p.f n = 0, Nonempty (ShortComplex.mk (i.f n) (p.f n) h).Splitting := by
    intro σ t H1 H2 H3
    let X : ℕ → C := fun n => I₁.cocomplex.X n ⊞ I₃.cocomplex.X n
    let d : ∀ n, X n ⟶ X (n + 1) := fun n =>
      Limits.biprod.lift (Limits.biprod.fst ≫ I₁.cocomplex.d n (n + 1) + Limits.biprod.snd ≫ t n)
        (Limits.biprod.snd ≫ I₃.cocomplex.d n (n + 1))
    have sq : ∀ n, d n ≫ d (n + 1) = 0 := by
      intro n
      have h3 : t n ≫ I₁.cocomplex.d (n + 1) (n + 1 + 1) +
          I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = 0 := H3 n
      apply Limits.biprod.hom_ext
      · simp only [d, Category.assoc, Limits.biprod.lift_fst, Preadditive.comp_add,
          Preadditive.add_comp, Limits.biprod.lift_fst_assoc, Limits.biprod.lift_snd_assoc,
          HomologicalComplex.d_comp_d, Limits.comp_zero, zero_add, Limits.zero_comp]
        rw [← Preadditive.comp_add, h3, Limits.comp_zero]
      · simp only [d, Category.assoc, Limits.biprod.lift_snd, Limits.biprod.lift_snd_assoc,
          HomologicalComplex.d_comp_d, Limits.comp_zero, Limits.zero_comp]
    let K : CochainComplex C ℕ := CochainComplex.of X d sq
    have hKd : ∀ n, K.d n (n + 1) = d n := fun n => CochainComplex.of_d X d n
    let i : I₁.cocomplex ⟶ K :=
      { f := fun n => (Limits.biprod.inl : I₁.cocomplex.X n ⟶ X n)
        comm' := by
          rintro n m rfl
          rw [hKd]
          apply Limits.biprod.hom_ext <;> simp [d] }
    let p : K ⟶ I₃.cocomplex :=
      { f := fun n => (Limits.biprod.snd : X n ⟶ I₃.cocomplex.X n)
        comm' := by
          rintro n m rfl
          rw [hKd]
          simp [d] }
    have hz : (Limits.biprod.lift σ (S.g ≫ I₃.ι.f 0) : S.X₂ ⟶ X 0) ≫ K.d 0 1 = 0 := by
      have hK0 : K.d 0 1 = d 0 := hKd 0
      rw [hK0]
      apply Limits.biprod.hom_ext
      · simp only [d, Category.assoc, Limits.biprod.lift_fst, Limits.biprod.lift_fst_assoc,
          Preadditive.comp_add, Limits.biprod.lift_snd_assoc, Limits.zero_comp]
        refine Eq.trans ?_ H2
        congr 1
        exact Category.assoc _ _ _
      · simp only [d, Category.assoc, Limits.biprod.lift_snd, Limits.biprod.lift_snd_assoc,
          Limits.zero_comp]
        exact (Category.assoc _ _ _).trans
          ((congrArg (S.g ≫ ·) I₃.ι_f_zero_comp_complex_d).trans Limits.comp_zero)
    refine ⟨K, i, p, (K.fromSingle₀Equiv S.X₂).symm ⟨Limits.biprod.lift σ (S.g ≫ I₃.ι.f 0), hz⟩,
      fun n => ?_, ?_, ?_, fun n => ?_⟩
    · show Injective (I₁.cocomplex.X n ⊞ I₃.cocomplex.X n)
      infer_instance
    · apply HomologicalComplex.from_single_hom_ext
      rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero,
        CochainComplex.fromSingle₀Equiv_symm_apply_f_zero]
      apply Limits.biprod.hom_ext
      · simp [i, H1]
        exact (Category.assoc _ _ _).trans
          ((congrArg (I₁.ι.f 0 ≫ ·) Limits.biprod.inl_fst).trans (Category.comp_id _))
      · simp [i]
        refine ((Category.assoc _ _ _).trans
          ((congrArg (I₁.ι.f 0 ≫ ·) Limits.biprod.inl_snd).trans Limits.comp_zero)).trans ?_
        refine Eq.symm (Eq.trans (Category.assoc S.f S.g (I₃.ι.f 0)).symm ?_)
        exact (congrArg (· ≫ I₃.ι.f 0) S.zero).trans Limits.zero_comp
    · apply HomologicalComplex.from_single_hom_ext
      rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero,
        CochainComplex.fromSingle₀Equiv_symm_apply_f_zero]
      simp [p]
    · refine ⟨Limits.biprod.inl_snd, ⟨?_⟩⟩
      exact ShortComplex.Splitting.mk Limits.biprod.fst Limits.biprod.inr Limits.biprod.inl_fst
        Limits.biprod.inr_snd Limits.biprod.total

  have s5 : ∀ (K : CochainComplex C ℕ) (i : I₁.cocomplex ⟶ K) (p : K ⟶ I₃.cocomplex) (e : (CochainComplex.single₀ C).obj S.X₂ ⟶ K), I₁.ι ≫ i = (CochainComplex.single₀ C).map S.f ≫ e → e ≫ p = (CochainComplex.single₀ C).map S.g ≫ I₃.ι → (∀ n : ℕ, ∃ h : i.f n ≫ p.f n = 0, (ShortComplex.mk (i.f n) (p.f n) h).ShortExact) → QuasiIso e := by
    intro K i p e hi hp hses
    have heg : Epi S.g := hS.epi_g
    have hip : i ≫ p = 0 := by
      ext n
      obtain ⟨h, -⟩ := hses n
      rw [HomologicalComplex.comp_f, HomologicalComplex.zero_f]
      exact h
    let T := ShortComplex.mk i p hip
    have hT : T.ShortExact := by
      apply HomologicalComplex.shortExact_of_degreewise_shortExact
      intro n
      obtain ⟨h, hn⟩ := hses n
      exact ShortComplex.shortExact_of_iso
        (ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp [T]) (by simp [T])) hn
    rw [quasiIso_iff]
    intro n
    cases n with
    | succ n =>
      rw [quasiIsoAt_iff_exactAt e (n + 1) (CochainComplex.exactAt_succ_single_obj S.X₂ n),
        HomologicalComplex.exactAt_iff_isZero_homology]
      have hex := hT.homology_exact₂ (n + 1)
      have h1 : Limits.IsZero (I₁.cocomplex.homology (n + 1)) :=
        (I₁.cocomplex_exactAt_succ n).isZero_homology
      have h3 : Limits.IsZero (I₃.cocomplex.homology (n + 1)) :=
        (I₃.cocomplex_exactAt_succ n).isZero_homology
      exact hex.isZero_of_both_zeros (h1.eq_of_src _ _) (h3.eq_of_tgt _ _)
    | zero =>
      obtain ⟨ι₁, hι₁⟩ : ∃ ι₁ : S.X₁ ⟶ I₁.cocomplex.X 0, ι₁ = I₁.ι.f 0 := ⟨_, rfl⟩
      obtain ⟨ι₃, hι₃⟩ : ∃ ι₃ : S.X₃ ⟶ I₃.cocomplex.X 0, ι₃ = I₃.ι.f 0 := ⟨_, rfl⟩
      obtain ⟨e0, he0⟩ : ∃ e0 : S.X₂ ⟶ K.X 0, e0 = e.f 0 := ⟨_, rfl⟩
      have hι₁m : Mono ι₁ := by subst hι₁; exact (inferInstance : Mono (I₁.ι.f 0))
      have hι₃m : Mono ι₃ := by subst hι₃; exact (inferInstance : Mono (I₃.ι.f 0))
      have ref₁ : ∀ {A : C} (x : A ⟶ I₁.cocomplex.X 0), x ≫ I₁.cocomplex.d 0 1 = 0 →
          ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₁), π ≫ x = y ≫ ι₁ := by
        subst hι₁
        intro A x hx
        exact I₁.exact₀.exact_up_to_refinements x hx
      have ref₃ : ∀ {A : C} (x : A ⟶ I₃.cocomplex.X 0), x ≫ I₃.cocomplex.d 0 1 = 0 →
          ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₃), π ≫ x = y ≫ ι₃ := by
        subst hι₃
        intro A x hx
        exact I₃.exact₀.exact_up_to_refinements x hx
      have hi0 : Mono (i.f 0) := (hses 0).choose_spec.mono_f
      have hi1 : Mono (i.f 1) := (hses 1).choose_spec.mono_f
      have F1 : S.f ≫ e0 = ι₁ ≫ i.f 0 := by
        have := congrArg (fun φ => HomologicalComplex.Hom.f φ 0) hi
        simp only [HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero] at this
        subst hι₁ he0
        exact this.symm
      have F2 : e0 ≫ p.f 0 = S.g ≫ ι₃ := by
        have := congrArg (fun φ => HomologicalComplex.Hom.f φ 0) hp
        simp only [HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero] at this
        subst hι₃ he0
        exact this
      have F3 : e0 ≫ K.d 0 1 = 0 := by
        subst he0
        have hd : ((CochainComplex.single₀ C).obj S.X₂).d 0 1 = 0 := rfl
        exact (e.comm 0 1).trans ((congrArg (· ≫ e.f 1) hd).trans Limits.zero_comp)
      have F4 : i.f 0 ≫ K.d 0 1 = I₁.cocomplex.d 0 1 ≫ i.f 1 := i.comm 0 1
      have F5 : K.d 0 1 ≫ p.f 1 = p.f 0 ≫ I₃.cocomplex.d 0 1 := (p.comm 0 1).symm
      have hmono' : Mono e0 := by
        apply Preadditive.mono_of_cancel_zero
        intro A x hx
        have h1 : x ≫ S.g = 0 := by
          apply (cancel_mono ι₃).1
          rw [Category.assoc, ← F2, ← Category.assoc, hx, Limits.zero_comp, Limits.zero_comp]
        have ref : ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₁), π ≫ x = y ≫ S.f :=
          hS.exact.exact_up_to_refinements x h1
        obtain ⟨A', π, hπ, y, hy⟩ := ref
        have h2 : y ≫ (ι₁ ≫ i.f 0) = 0 := by
          rw [← F1, ← Category.assoc, ← hy, Category.assoc, hx, Limits.comp_zero]
        have h3 : y = 0 := by
          apply (cancel_mono (ι₁ ≫ i.f 0)).1
          rw [h2, Limits.zero_comp]
        apply (cancel_epi π).1
        rw [hy, h3, Limits.zero_comp, Limits.comp_zero]
      have hexact : (ShortComplex.mk e0 (K.d 0 1) F3).Exact := by
        rw [ShortComplex.exact_iff_exact_up_to_refinements]
        intro A x hx
        have hx' : x ≫ K.d 0 1 = 0 := hx
        have s1 : (x ≫ p.f 0) ≫ I₃.cocomplex.d 0 1 = 0 := by
          rw [Category.assoc, ← F5, ← Category.assoc, hx', Limits.zero_comp]
        obtain ⟨A₁, π₁, hπ₁, y₃, hy₃⟩ := ref₃ (x ≫ p.f 0) s1
        obtain ⟨A₂, π₂, hπ₂, y₂, hy₂⟩ := surjective_up_to_refinements_of_epi S.g y₃
        have s3' : (π₂ ≫ π₁ ≫ x - y₂ ≫ e0) ≫ p.f 0 = 0 := by
          have e1 : (π₂ ≫ π₁ ≫ x) ≫ p.f 0 = y₂ ≫ S.g ≫ ι₃ := by
            rw [Category.assoc, Category.assoc, hy₃, ← Category.assoc, hy₂, Category.assoc]
          have e2 : (y₂ ≫ e0) ≫ p.f 0 = y₂ ≫ S.g ≫ ι₃ := by
            rw [Category.assoc, F2]
          rw [Preadditive.sub_comp, e1, e2, sub_self]
        obtain ⟨h0, hs0⟩ := hses 0
        have ref : ∃ (A' : C) (π : A' ⟶ A₂) (_ : Epi π) (z : A' ⟶ I₁.cocomplex.X 0),
            π ≫ (π₂ ≫ π₁ ≫ x - y₂ ≫ e0) = z ≫ i.f 0 :=
          hs0.exact.exact_up_to_refinements _ s3'
        obtain ⟨A₃, π₃, hπ₃, z, hz⟩ := ref
        have s4' : (π₂ ≫ π₁ ≫ x - y₂ ≫ e0) ≫ K.d 0 1 = 0 := by
          simp only [Preadditive.sub_comp, Category.assoc, hx', F3, Limits.comp_zero, sub_self]
        have s4'' : z ≫ I₁.cocomplex.d 0 1 = 0 := by
          apply (cancel_mono (i.f 1)).1
          have : (z ≫ i.f 0) ≫ K.d 0 1 = 0 := by
            rw [← hz, Category.assoc, s4', Limits.comp_zero]
          rw [Limits.zero_comp, Category.assoc, ← F4, ← Category.assoc, this]
        obtain ⟨A₄, π₄, hπ₄, w, hw⟩ := ref₁ z s4''
        have k1 : π₃ ≫ π₂ ≫ π₁ ≫ x = π₃ ≫ y₂ ≫ e0 + z ≫ i.f 0 := by
          rw [← hz, Preadditive.comp_sub]
          abel
        refine ⟨A₄, π₄ ≫ π₃ ≫ π₂ ≫ π₁, inferInstance, π₄ ≫ π₃ ≫ y₂ + w ≫ S.f, ?_⟩
        show (π₄ ≫ π₃ ≫ π₂ ≫ π₁) ≫ x = (π₄ ≫ π₃ ≫ y₂ + w ≫ S.f) ≫ e0
        simp only [Category.assoc, Preadditive.add_comp]
        rw [k1, Preadditive.comp_add, ← Category.assoc π₄ z, hw, Category.assoc, ← F1]
      rw [CochainComplex.quasiIsoAt₀_iff]
      subst he0
      refine (ShortComplex.quasiIso_iff_of_zeros _ ?_ ?_ ?_).2 ⟨hexact, hmono'⟩
      · exact ((CochainComplex.single₀ C).obj S.X₂).shape 0 0 (by simp)
      · rfl
      · exact K.shape 0 0 (by simp)

  have s6 : ∀ {K₁ K₂ K₃ : CochainComplex C ℕ} (i : K₁ ⟶ K₂) (p : K₂ ⟶ K₃),
      (∀ n : ℕ, ∃ h : i.f n ≫ p.f n = 0, Nonempty (ShortComplex.mk (i.f n) (p.f n) h).Splitting) →
      ∀ n : ℤ, ∃ h : (HomologicalComplex.extendMap i ComplexShape.embeddingUpNat).f n ≫
          (HomologicalComplex.extendMap p ComplexShape.embeddingUpNat).f n = 0,
        Nonempty (ShortComplex.mk _ _ h).Splitting := by
    intro K₁ K₂ K₃ i p H n
    have hip : i ≫ p = 0 := by
      ext k
      rw [HomologicalComplex.comp_f, HomologicalComplex.zero_f]
      exact (H k).1
    have hz : (HomologicalComplex.extendMap i ComplexShape.embeddingUpNat).f n ≫
          (HomologicalComplex.extendMap p ComplexShape.embeddingUpNat).f n = 0 := by
      rw [← HomologicalComplex.comp_f, ← HomologicalComplex.extendMap_comp, hip,
        HomologicalComplex.extendMap_zero, HomologicalComplex.zero_f]
    refine ⟨hz, ?_⟩
    rcases (lt_or_ge n 0 : n < 0 ∨ n ≥ 0) with hn | hn
    · have hne : ∀ k : ℕ, ComplexShape.embeddingUpNat.f k ≠ n := by
        intro k hk
        rw [ComplexShape.embeddingUpNat_f] at hk
        omega
      exact ⟨ShortComplex.Splitting.ofIsZero _
        (HomologicalComplex.isZero_extend_X _ _ _ hne)
        (HomologicalComplex.isZero_extend_X _ _ _ hne)
        (HomologicalComplex.isZero_extend_X _ _ _ hne)⟩
    · obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le hn
      have hk : ComplexShape.embeddingUpNat.f k = (k : ℤ) := ComplexShape.embeddingUpNat_f k
      obtain ⟨h, ⟨spl⟩⟩ := H k
      refine ⟨ShortComplex.Splitting.ofIso spl (ShortComplex.isoMk
        (K₁.extendXIso ComplexShape.embeddingUpNat hk).symm
        (K₂.extendXIso ComplexShape.embeddingUpNat hk).symm
        (K₃.extendXIso ComplexShape.embeddingUpNat hk).symm ?_ ?_)⟩
      · simp [HomologicalComplex.extendMap_f _ _ hk]
      · simp [HomologicalComplex.extendMap_f _ _ hk]

  obtain ⟨σ, t, H1, H2, H3⟩ := s3
  obtain ⟨K, i, p, e, hK, hi, hp, hspl⟩ := s4 σ t H1 H2 H3
  have he : QuasiIso e := s5 K i p e hi hp (fun n => by
    obtain ⟨h, ⟨spl⟩⟩ := hspl n
    exact ⟨h, spl.shortExact⟩)
  let I₂ : InjectiveResolution S.X₂ :=
    { cocomplex := K, injective := hK, ι := e, quasiIso := he }
  exact ⟨I₂, HomologicalComplex.extendMap i ComplexShape.embeddingUpNat,
    HomologicalComplex.extendMap p ComplexShape.embeddingUpNat, s6 i p hspl⟩

theorem wc_ltp_ses_qiso_two_of_three {C : Type*} [Category C] [Abelian C]
    {S₁ S₂ : ShortComplex (CochainComplex C ℤ)} (φ : S₁ ⟶ S₂) :
    S₁.ShortExact → S₂.ShortExact →
      (QuasiIso φ.τ₂ → QuasiIso φ.τ₃ → QuasiIso φ.τ₁) ∧
      (QuasiIso φ.τ₁ → QuasiIso φ.τ₃ → QuasiIso φ.τ₂) :=
by
  intro hS₁ hS₂
  have hR : ∀ n : ℤ, (ComplexShape.up ℤ).Rel (n - 1) n := fun n => by simp
  have hR' : ∀ n : ℤ, (ComplexShape.up ℤ).Rel n (n + 1) := fun n => by simp
  have hiso : ∀ {K L : CochainComplex C ℤ} (f : K ⟶ L), QuasiIso f →
      ∀ m : ℤ, IsIso (HomologicalComplex.homologyMap f m) := by
    intro K L f hf m
    rw [← quasiIsoAt_iff_isIso_homologyMap]
    infer_instance
  have hfin : ∀ {K L : CochainComplex C ℤ} (f : K ⟶ L),
      (∀ m : ℤ, IsIso (HomologicalComplex.homologyMap f m)) → QuasiIso f := by
    intro K L f hf
    rw [quasiIso_iff]
    intro m
    rw [quasiIsoAt_iff_isIso_homologyMap]
    exact hf m
  refine ⟨fun h₂ h₃ => ?_, fun h₁ h₃ => ?_⟩
  · apply hfin
    intro n
    have i₂ := hiso φ.τ₂ h₂
    have i₃ := hiso φ.τ₃ h₃
    have hm : Mono (HomologicalComplex.homologyMap φ.τ₁ n) := by
      have a := i₂ (n - 1)
      have b := i₃ (n - 1)
      have c := i₂ n
      exact Abelian.mono_of_epi_of_mono_of_mono
        ((ComposableArrows.δ₀Functor ⋙ ComposableArrows.δlastFunctor).map
          (HomologicalComplex.HomologySequence.mapComposableArrows₅ φ hS₁ hS₂ (n - 1) n (hR n)))
        (HomologicalComplex.HomologySequence.composableArrows₅_exact hS₁ (n - 1) n (hR n)).δ₀.δlast
        (HomologicalComplex.HomologySequence.composableArrows₅_exact hS₂ (n - 1) n (hR n)).δ₀.δlast
        (inferInstance : Epi (HomologicalComplex.homologyMap φ.τ₂ (n - 1)))
        (inferInstance : Mono (HomologicalComplex.homologyMap φ.τ₃ (n - 1)))
        (inferInstance : Mono (HomologicalComplex.homologyMap φ.τ₂ n))
    have he : Epi (HomologicalComplex.homologyMap φ.τ₁ n) := by
      have a := i₃ (n - 1)
      have b := i₂ n
      have c := i₃ n
      exact Abelian.epi_of_epi_of_epi_of_mono
        ((ComposableArrows.δ₀Functor ⋙ ComposableArrows.δ₀Functor).map
          (HomologicalComplex.HomologySequence.mapComposableArrows₅ φ hS₁ hS₂ (n - 1) n (hR n)))
        (HomologicalComplex.HomologySequence.composableArrows₅_exact hS₁ (n - 1) n (hR n)).δ₀.δ₀
        (HomologicalComplex.HomologySequence.composableArrows₅_exact hS₂ (n - 1) n (hR n)).δ₀.δ₀
        (inferInstance : Epi (HomologicalComplex.homologyMap φ.τ₃ (n - 1)))
        (inferInstance : Epi (HomologicalComplex.homologyMap φ.τ₂ n))
        (inferInstance : Mono (HomologicalComplex.homologyMap φ.τ₃ n))
    exact isIso_of_mono_of_epi _
  · apply hfin
    intro n
    have i₁ := hiso φ.τ₁ h₁
    have i₃ := hiso φ.τ₃ h₃
    have hm : Mono (HomologicalComplex.homologyMap φ.τ₂ n) := by
      have a := i₃ (n - 1)
      have b := i₁ n
      have c := i₃ n
      exact Abelian.mono_of_epi_of_mono_of_mono
        ((ComposableArrows.δ₀Functor ⋙ ComposableArrows.δ₀Functor).map
          (HomologicalComplex.HomologySequence.mapComposableArrows₅ φ hS₁ hS₂ (n - 1) n (hR n)))
        (HomologicalComplex.HomologySequence.composableArrows₅_exact hS₁ (n - 1) n (hR n)).δ₀.δ₀
        (HomologicalComplex.HomologySequence.composableArrows₅_exact hS₂ (n - 1) n (hR n)).δ₀.δ₀
        (inferInstance : Epi (HomologicalComplex.homologyMap φ.τ₃ (n - 1)))
        (inferInstance : Mono (HomologicalComplex.homologyMap φ.τ₁ n))
        (inferInstance : Mono (HomologicalComplex.homologyMap φ.τ₃ n))
    have he : Epi (HomologicalComplex.homologyMap φ.τ₂ n) := by
      have a := i₁ n
      have b := i₃ n
      have c := i₁ (n + 1)
      exact Abelian.epi_of_epi_of_epi_of_mono
        ((ComposableArrows.δlastFunctor ⋙ ComposableArrows.δlastFunctor).map
          (HomologicalComplex.HomologySequence.mapComposableArrows₅ φ hS₁ hS₂ n (n + 1) (hR' n)))
        (HomologicalComplex.HomologySequence.composableArrows₅_exact hS₁ n (n + 1) (hR' n)).δlast.δlast
        (HomologicalComplex.HomologySequence.composableArrows₅_exact hS₂ n (n + 1) (hR' n)).δlast.δlast
        (inferInstance : Epi (HomologicalComplex.homologyMap φ.τ₁ n))
        (inferInstance : Epi (HomologicalComplex.homologyMap φ.τ₃ n))
        (inferInstance : Mono (HomologicalComplex.homologyMap φ.τ₁ (n + 1)))
    exact isIso_of_mono_of_epi _

theorem wc_ltp_inj_ses_replacement {C : Type*} [Category C] [Abelian C] [EnoughInjectives C]
    {A B D J₁ : CochainComplex C ℤ} (a : A ⟶ B) (b : B ⟶ D) (hab : a ≫ b = 0) :
    (ShortComplex.mk a b hab).ShortExact → ∀ (n : ℤ), D.IsStrictlyGE n → J₁.IsStrictlyGE n →
      (∀ m, Injective (J₁.X m)) → ∀ (j₁ : A ⟶ J₁), QuasiIso j₁ →
      ∃ (J₂ J₃ : CochainComplex C ℤ) (u : J₁ ⟶ J₂) (v : J₂ ⟶ J₃) (j₂ : B ⟶ J₂) (j₃ : D ⟶ J₃),
        J₂.IsStrictlyGE (n - 1) ∧ J₃.IsStrictlyGE (n - 1) ∧ (∀ m, Injective (J₂.X m)) ∧
        (∀ m, Injective (J₃.X m)) ∧ QuasiIso j₂ ∧ QuasiIso j₃ ∧ j₁ ≫ u = a ≫ j₂ ∧
        j₂ ≫ v = b ≫ j₃ ∧
        ∀ m : ℤ, ∃ h : u.f m ≫ v.f m = 0, Nonempty (ShortComplex.mk (u.f m) (v.f m) h).Splitting :=
by
  intro hS n hD hJ₁ hJ₁i j₁ hj₁

  have hR' : ∀ k : ℤ, (ComplexShape.up ℤ).Rel k (k + 1) := fun k => by simp
  have hiso : ∀ {K L : CochainComplex C ℤ} (f : K ⟶ L), QuasiIso f →
      ∀ m : ℤ, IsIso (HomologicalComplex.homologyMap f m) := by
    intro K L f hf m
    rw [← quasiIsoAt_iff_isIso_homologyMap]
    infer_instance
  have hfin : ∀ {K L : CochainComplex C ℤ} (f : K ⟶ L),
      (∀ m : ℤ, IsIso (HomologicalComplex.homologyMap f m)) → QuasiIso f := by
    intro K L f hf
    rw [quasiIso_iff]
    intro m
    rw [quasiIsoAt_iff_isIso_homologyMap]
    exact hf m
  have five₂ : ∀ {S₁ S₂ : ShortComplex (CochainComplex C ℤ)} (φ : S₁ ⟶ S₂),
      S₁.ShortExact → S₂.ShortExact → QuasiIso φ.τ₁ → QuasiIso φ.τ₃ → QuasiIso φ.τ₂ := by
    intro S₁ S₂ φ hS₁ hS₂ h₁ h₃
    apply hfin
    intro k
    have i₁ := hiso φ.τ₁ h₁
    have i₃ := hiso φ.τ₃ h₃
    have hm : Mono (HomologicalComplex.homologyMap φ.τ₂ k) := by
      have a := i₃ (k - 1)
      have b := i₁ k
      have c := i₃ k
      have hR : (ComplexShape.up ℤ).Rel (k - 1) k := by simp
      exact Abelian.mono_of_epi_of_mono_of_mono
        ((ComposableArrows.δ₀Functor ⋙ ComposableArrows.δ₀Functor).map
          (HomologicalComplex.HomologySequence.mapComposableArrows₅ φ hS₁ hS₂ (k - 1) k hR))
        (HomologicalComplex.HomologySequence.composableArrows₅_exact hS₁ (k - 1) k hR).δ₀.δ₀
        (HomologicalComplex.HomologySequence.composableArrows₅_exact hS₂ (k - 1) k hR).δ₀.δ₀
        (inferInstance : Epi (HomologicalComplex.homologyMap φ.τ₃ (k - 1)))
        (inferInstance : Mono (HomologicalComplex.homologyMap φ.τ₁ k))
        (inferInstance : Mono (HomologicalComplex.homologyMap φ.τ₃ k))
    have he : Epi (HomologicalComplex.homologyMap φ.τ₂ k) := by
      have a := i₁ k
      have b := i₃ k
      have c := i₁ (k + 1)
      exact Abelian.epi_of_epi_of_epi_of_mono
        ((ComposableArrows.δlastFunctor ⋙ ComposableArrows.δlastFunctor).map
          (HomologicalComplex.HomologySequence.mapComposableArrows₅ φ hS₁ hS₂ k (k + 1) (hR' k)))
        (HomologicalComplex.HomologySequence.composableArrows₅_exact hS₁ k (k + 1) (hR' k)).δlast.δlast
        (HomologicalComplex.HomologySequence.composableArrows₅_exact hS₂ k (k + 1) (hR' k)).δlast.δlast
        (inferInstance : Epi (HomologicalComplex.homologyMap φ.τ₁ k))
        (inferInstance : Epi (HomologicalComplex.homologyMap φ.τ₃ k))
        (inferInstance : Mono (HomologicalComplex.homologyMap φ.τ₁ (k + 1)))
    exact isIso_of_mono_of_epi _

  have geMid : ∀ {X₁ X₂ X₃ : CochainComplex C ℤ} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃) (hfg : f ≫ g = 0),
      (ShortComplex.mk f g hfg).ShortExact → ∀ k : ℤ, X₁.IsStrictlyGE k → X₃.IsStrictlyGE k →
        X₂.IsStrictlyGE k := by
    intro X₁ X₂ X₃ f g hfg hS' k h₁ h₃
    rw [CochainComplex.isStrictlyGE_iff]
    intro i hi
    have hSi := (HomologicalComplex.shortExact_iff_degreewise_shortExact _).mp hS' i
    have z1 : Limits.IsZero (X₁.X i) := X₁.isZero_of_isStrictlyGE k i hi
    have z3 : Limits.IsZero (X₃.X i) := X₃.isZero_of_isStrictlyGE k i hi
    exact hSi.exact.isZero_X₂ (z1.eq_of_src _ _) (z3.eq_of_tgt _ _)
  have geRight : ∀ {X₁ X₂ X₃ : CochainComplex C ℤ} (f : X₁ ⟶ X₂) (g : X₂ ⟶ X₃) (hfg : f ≫ g = 0),
      (ShortComplex.mk f g hfg).ShortExact → ∀ k : ℤ, X₂.IsStrictlyGE k → X₃.IsStrictlyGE k := by
    intro X₁ X₂ X₃ f g hfg hS' k h₂
    rw [CochainComplex.isStrictlyGE_iff]
    intro i hi
    have hSi := (HomologicalComplex.shortExact_iff_degreewise_shortExact _).mp hS' i
    have z2 : Limits.IsZero (X₂.X i) := X₂.isZero_of_isStrictlyGE k i hi
    haveI : Epi (g.f i) := hSi.epi_g
    exact Limits.IsZero.of_epi (g.f i) z2

  have t2 : ∀ {A' B' D' J : CochainComplex C ℤ} (a' : A' ⟶ B') (b' : B' ⟶ D')
      (hab' : a' ≫ b' = 0), (ShortComplex.mk a' b' hab').ShortExact → ∀ (j : A' ⟶ J),
      ∃ (P : CochainComplex C ℤ) (p : B' ⟶ P) (q : J ⟶ P) (c : P ⟶ D') (hqc : q ≫ c = 0),
        a' ≫ p = j ≫ q ∧ p ≫ c = b' ∧ (ShortComplex.mk q c hqc).ShortExact := by
    intro A' B' D' J a' b' hab' hS' j
    haveI : Mono a' := hS'.mono_f
    haveI : Epi b' := hS'.epi_g
    have w : a' ≫ b' = j ≫ 0 := by rw [hab', Limits.comp_zero]
    have pc : Limits.pushout.inl a' j ≫ Limits.pushout.desc b' 0 w = b' :=
      Limits.pushout.inl_desc _ _ _
    have qc : Limits.pushout.inr a' j ≫ Limits.pushout.desc b' 0 w = 0 :=
      Limits.pushout.inr_desc _ _ _
    refine ⟨Limits.pushout a' j, Limits.pushout.inl a' j, Limits.pushout.inr a' j,
      Limits.pushout.desc b' 0 w, qc, Limits.pushout.condition, pc, ?_⟩
    haveI hqm : Mono (Limits.pushout.inr a' j) := Abelian.mono_pushout_of_mono_f a' j
    haveI hce : Epi (Limits.pushout.desc b' 0 w) := epi_of_epi_fac pc
    have hex := hS'.exact
    have key : ∀ {T : CochainComplex C ℤ} (k : Limits.pushout a' j ⟶ T),
        Limits.pushout.inr a' j ≫ k = 0 → a' ≫ (Limits.pushout.inl a' j ≫ k) = 0 := by
      intro T k hk
      rw [← Category.assoc, Limits.pushout.condition, Category.assoc, hk, Limits.comp_zero]
    have fac : ∀ {T : CochainComplex C ℤ} (k : Limits.pushout a' j ⟶ T)
        (hk : Limits.pushout.inr a' j ≫ k = 0),
        Limits.pushout.desc b' 0 w ≫ hex.desc (Limits.pushout.inl a' j ≫ k) (key k hk) = k := by
      intro T k hk
      apply Limits.pushout.hom_ext
      · rw [← Category.assoc, pc]
        exact hex.g_desc _ _
      · rw [← Category.assoc, qc, Limits.zero_comp, hk]
    refine ShortComplex.ShortExact.mk' ?_ hqm hce
    apply ShortComplex.exact_of_g_is_cokernel
    exact Limits.CokernelCofork.IsColimit.ofπ _ _
      (fun k hk => hex.desc (Limits.pushout.inl a' j ≫ k) (key k hk))
      (fun k hk => fac k hk)
      (fun k hk m hm => by
        rw [← cancel_epi (Limits.pushout.desc b' 0 w), hm, fac k hk])

  obtain ⟨P, p, q, c, hqc, sqP, pc, hP⟩ := t2 a b hab hS j₁
  have hPge : P.IsStrictlyGE n := geMid q c hqc hP n hJ₁ hD
  have hp : QuasiIso p := by
    let φ : ShortComplex.mk a b hab ⟶ ShortComplex.mk q c hqc :=
      { τ₁ := j₁
        τ₂ := p
        τ₃ := 𝟙 D
        comm₁₂ := sqP.symm
        comm₂₃ := by
          show p ≫ c = b ≫ 𝟙 D
          rw [pc, Category.comp_id] }
    exact five₂ φ hS hP hj₁ (inferInstance : QuasiIso (𝟙 D))
  haveI := hPge
  obtain ⟨L, ι, hιm, hιq, hLi, hLge⟩ :=
    CochainComplex.Plus.modelCategoryQuillen.exists_mono_quasiIso_injective P (n - 1) n
  haveI : Mono q := hP.mono_f
  haveI hum : Mono (q ≫ ι) := mono_comp q ι
  have hj₂ : QuasiIso (p ≫ ι) := quasiIso_comp p ι

  have huv : (q ≫ ι) ≫ Limits.cokernel.π (q ≫ ι) = 0 := Limits.cokernel.condition _
  have hJ : (ShortComplex.mk (q ≫ ι) (Limits.cokernel.π (q ≫ ι)) huv).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel (q ≫ ι)) hum inferInstance
  have hzero : ∀ m : ℤ, (q ≫ ι).f m ≫ (Limits.cokernel.π (q ≫ ι)).f m = 0 := by
    intro m
    rw [← HomologicalComplex.comp_f, huv, HomologicalComplex.zero_f]
  have hsplit : ∀ m : ℤ,
      (ShortComplex.mk ((q ≫ ι).f m) ((Limits.cokernel.π (q ≫ ι)).f m) (hzero m)).Splitting := by
    intro m
    have hSm := (HomologicalComplex.shortExact_iff_degreewise_shortExact _).mp hJ m
    exact @ShortComplex.ShortExact.splittingOfInjective _ _ _ _ hSm (hJ₁i m) _
  have hJ₃i : ∀ m, Injective ((Limits.cokernel (q ≫ ι)).X m) := by
    intro m
    haveI := hLi m
    exact Retract.injective ⟨(hsplit m).s, (Limits.cokernel.π (q ≫ ι)).f m, (hsplit m).s_g⟩
  have hJ₃ge : (Limits.cokernel (q ≫ ι)).IsStrictlyGE (n - 1) :=
    geRight (q ≫ ι) (Limits.cokernel.π (q ≫ ι)) huv hJ (n - 1) hLge

  haveI : Epi b := hS.epi_g
  have huv' : q ≫ ι ≫ Limits.cokernel.π (q ≫ ι) = 0 := by
    rw [← Category.assoc]; exact huv
  have e₃ : a ≫ ((p ≫ ι) ≫ Limits.cokernel.π (q ≫ ι)) = 0 := by
    rw [← Category.assoc, ← Category.assoc, sqP, Category.assoc, Category.assoc, huv',
      Limits.comp_zero]
  obtain ⟨j₃, hj₃eq⟩ : ∃ j₃ : D ⟶ Limits.cokernel (q ≫ ι),
      b ≫ j₃ = (p ≫ ι) ≫ Limits.cokernel.π (q ≫ ι) :=
    ⟨hS.exact.desc _ e₃, hS.exact.g_desc _ e₃⟩
  have sq₁ : j₁ ≫ (q ≫ ι) = a ≫ (p ≫ ι) := by
    rw [← Category.assoc, ← Category.assoc, sqP]
  let ψ : ShortComplex.mk a b hab ⟶ ShortComplex.mk (q ≫ ι) (Limits.cokernel.π (q ≫ ι)) huv :=
    { τ₁ := j₁
      τ₂ := p ≫ ι
      τ₃ := j₃
      comm₁₂ := sq₁
      comm₂₃ := hj₃eq.symm }
  have hj₃ : QuasiIso j₃ := HomologicalComplex.HomologySequence.quasiIso_τ₃ ψ hS hJ hj₁ hj₂
  exact ⟨L, Limits.cokernel (q ≫ ι), q ≫ ι, Limits.cokernel.π (q ≫ ι), p ≫ ι, j₃, hLge, hJ₃ge,
    hLi, hJ₃i, hj₂, hj₃, sq₁, hj₃eq.symm, fun m => ⟨hzero m, ⟨hsplit m⟩⟩⟩

theorem wc_ltp_split_map {C D : Type*} [Category C] [Category D] [Abelian C] [Abelian D]
    (F : C ⥤ D) [F.Additive] {X Y Z : CochainComplex C ℤ} (i : X ⟶ Y) (p : Y ⟶ Z) :
    (∀ n : ℤ, ∃ h : i.f n ≫ p.f n = 0, Nonempty (ShortComplex.mk (i.f n) (p.f n) h).Splitting) →
    ∃ hz : (F.mapHomologicalComplex (ComplexShape.up ℤ)).map i ≫
        (F.mapHomologicalComplex (ComplexShape.up ℤ)).map p = 0,
      (ShortComplex.mk _ _ hz).ShortExact ∧
      ∀ n : ℤ, ∃ h : ((F.mapHomologicalComplex (ComplexShape.up ℤ)).map i).f n ≫
          ((F.mapHomologicalComplex (ComplexShape.up ℤ)).map p).f n = 0,
        Nonempty (ShortComplex.mk _ _ h).Splitting :=
by
  intro H
  have hdeg : ∀ n : ℤ, ((F.mapHomologicalComplex (ComplexShape.up ℤ)).map i).f n ≫
      ((F.mapHomologicalComplex (ComplexShape.up ℤ)).map p).f n = 0 := by
    intro n
    obtain ⟨h, -⟩ := H n
    rw [Functor.mapHomologicalComplex_map_f, Functor.mapHomologicalComplex_map_f, ← F.map_comp,
      h, F.map_zero]
  have hspl : ∀ n : ℤ, Nonempty (ShortComplex.mk _ _ (hdeg n)).Splitting := by
    intro n
    obtain ⟨h, ⟨σ⟩⟩ := H n
    exact ⟨σ.map F⟩
  have hz : (F.mapHomologicalComplex (ComplexShape.up ℤ)).map i ≫
        (F.mapHomologicalComplex (ComplexShape.up ℤ)).map p = 0 := by
    ext n
    rw [HomologicalComplex.comp_f, HomologicalComplex.zero_f]
    exact hdeg n
  refine ⟨hz, ?_, fun n => ⟨hdeg n, hspl n⟩⟩
  apply HomologicalComplex.shortExact_of_degreewise_shortExact
  intro n
  obtain ⟨σ⟩ := hspl n
  exact σ.shortExact

theorem wc_ltp_two_of_three {S Z E : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    (g : E ⟶ S) [IsAffineHom g] (W : S.ProEt)
    (hi : (wcProEtBC i).IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z))
    (hg : (wcProEtBC g).IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology E))
    (Sc : ShortComplex (Sheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1}))
    (hSc : Sc.ShortExact)
    (h₂ : wcAbPBCAt i g W hi hg Sc.X₂) (h₃ : wcAbPBCAt i g W hi hg Sc.X₃) :
    wcAbPBCAt i g W hi hg Sc.X₁ :=
by
  unfold wcAbPBCAt
  intro Pg Pi Li adj I₁ K₁ J₁ m₀ hJ₁ hJ₁i j₁ hj₁ w₁ hw₁
  haveI : Pg.Additive := by
    first
      | exact ⟨fun {_ _ _ _} => rfl⟩
      | (haveI := ((wcProEtBC g).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology S) (Scheme.ProEt.topology E)).rightAdjoint_preservesLimits
         exact Functor.additive_of_preserves_binary_products _)
  haveI : Pi.Additive := by
    first
      | exact ⟨fun {_ _ _ _} => rfl⟩
      | (haveI := adj.rightAdjoint_preservesLimits
         exact Functor.additive_of_preserves_binary_products _)
  haveI : Li.Additive := Adjunction.left_adjoint_additive adj
  let ev : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⥤ AddCommGrpCat.{u+1} :=
    sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
      (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op W)
  let evZ : Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1} ⥤ AddCommGrpCat.{u+1} :=
    sheafToPresheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1} ⋙
      (evaluation Z.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op ((wcProEtBC i).obj W))
  haveI : ev.Additive := by
    first
      | infer_instance
      | exact Functor.additive_of_preserves_binary_products _
  haveI : evZ.Additive := by
    first
      | infer_instance
      | exact Functor.additive_of_preserves_binary_products _

  let I₃ := InjectiveResolution.of Sc.X₃
  obtain ⟨I₂, iI, pI, hsplI⟩ := wc_ltp_horseshoe Sc hSc I₁ I₃

  let iK := (Pg.mapHomologicalComplex (ComplexShape.up ℤ)).map iI
  let pK := (Pg.mapHomologicalComplex (ComplexShape.up ℤ)).map pI
  obtain ⟨-, -, hsplK⟩ := wc_ltp_split_map Pg iI pI hsplI
  obtain ⟨hab, hSab, -⟩ := wc_ltp_split_map Li iK pK hsplK
  obtain ⟨hzE, hSE, -⟩ := wc_ltp_split_map ev iK pK hsplK

  have hD0 : CochainComplex.IsStrictlyGE ((Li.mapHomologicalComplex (ComplexShape.up ℤ)).obj
      ((Pg.mapHomologicalComplex (ComplexShape.up ℤ)).obj I₃.cochainComplex)) 0 := by
    rw [CochainComplex.isStrictlyGE_iff]
    intro k hk
    exact Li.map_isZero (Pg.map_isZero (CochainComplex.isZero_of_isStrictlyGE _ 0 k hk))
  have hDn : CochainComplex.IsStrictlyGE ((Li.mapHomologicalComplex (ComplexShape.up ℤ)).obj
      ((Pg.mapHomologicalComplex (ComplexShape.up ℤ)).obj I₃.cochainComplex))
        (min m₀ 0) := by
    haveI := hD0
    exact CochainComplex.isStrictlyGE_of_ge _ _ 0 (min_le_right _ _)
  have hJn : CochainComplex.IsStrictlyGE J₁ (min m₀ 0) := by
    haveI := hJ₁
    exact CochainComplex.isStrictlyGE_of_ge J₁ _ m₀ (min_le_left _ _)

  obtain ⟨J₂, J₃, u, v, j₂, j₃, hJ₂, hJ₃, hJ₂i, hJ₃i, hj₂, hj₃, sq₁, sq₂, hsplJ⟩ :=
    wc_ltp_inj_ses_replacement ((Li.mapHomologicalComplex (ComplexShape.up ℤ)).map iK)
      ((Li.mapHomologicalComplex (ComplexShape.up ℤ)).map pK) hab hSab (min m₀ 0) hDn hJn hJ₁i
      j₁ hj₁
  obtain ⟨hzJ, hSJ, -⟩ := wc_ltp_split_map evZ u v hsplJ

  have mkw : ∀ (K : CochainComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) ℤ)
      (J : CochainComplex (Sheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1}) ℤ)
      (j : (Li.mapHomologicalComplex (ComplexShape.up ℤ)).obj K ⟶ J),
      ∃ w : (ev.mapHomologicalComplex (ComplexShape.up ℤ)).obj K ⟶
          (evZ.mapHomologicalComplex (ComplexShape.up ℤ)).obj J,
        ∀ (m : ℤ) (x : (K.X m).obj.obj (Opposite.op W)),
          (w.f m).hom x = ((j.f m).hom.app (Opposite.op ((wcProEtBC i).obj W))).hom
            (((adj.unit.app (K.X m)).hom.app (Opposite.op W)).hom x) := by
    intro K J j
    refine ⟨{ f := fun m => (adj.unit.app (K.X m)).hom.app (Opposite.op W) ≫
                (j.f m).hom.app (Opposite.op ((wcProEtBC i).obj W))
              comm' := ?_ }, fun m x => rfl⟩
    intro p q _
    ext x
    have e1 := congrArg (fun φ => (φ.hom.app (Opposite.op W)).hom x)
      (adj.unit_naturality (K.d p q))
    have e2 := congrArg (fun φ => (φ.hom.app (Opposite.op ((wcProEtBC i).obj W))).hom
      (((adj.unit.app (K.X p)).hom.app (Opposite.op W)).hom x)) (j.comm p q)
    exact e2.trans (congrArg (fun y => ((j.f q).hom.app
      (Opposite.op ((wcProEtBC i).obj W))).hom y) e1)
  obtain ⟨w₂, hw₂⟩ := mkw _ J₂ j₂
  obtain ⟨w₃, hw₃⟩ := mkw _ J₃ j₃
  have qw₂ : QuasiIso w₂ := h₂ I₂ J₂ (min m₀ 0 - 1) hJ₂ hJ₂i j₂ hj₂ w₂ hw₂
  have qw₃ : QuasiIso w₃ := h₃ I₃ J₃ (min m₀ 0 - 1) hJ₃ hJ₃i j₃ hj₃ w₃ hw₃

  have c₁₂ : w₁ ≫ (evZ.mapHomologicalComplex (ComplexShape.up ℤ)).map u =
      (ev.mapHomologicalComplex (ComplexShape.up ℤ)).map iK ≫ w₂ := by
    ext m x
    change ((u.f m).hom.app (Opposite.op ((wcProEtBC i).obj W))).hom ((w₁.f m).hom x) =
      (w₂.f m).hom (((iK.f m).hom.app (Opposite.op W)).hom x)
    rw [hw₁, hw₂]
    have e1 := congrArg (fun φ => (φ.hom.app (Opposite.op W)).hom x)
      (adj.unit_naturality (iK.f m))
    have e2 := congrArg (fun φ => ((HomologicalComplex.Hom.f φ m).hom.app
      (Opposite.op ((wcProEtBC i).obj W))).hom
      (((adj.unit.app (K₁.X m)).hom.app (Opposite.op W)).hom x)) sq₁
    exact e2.trans (congrArg (fun y => ((j₂.f m).hom.app
      (Opposite.op ((wcProEtBC i).obj W))).hom y) e1)
  have c₂₃ : w₂ ≫ (evZ.mapHomologicalComplex (ComplexShape.up ℤ)).map v =
      (ev.mapHomologicalComplex (ComplexShape.up ℤ)).map pK ≫ w₃ := by
    ext m x
    change ((v.f m).hom.app (Opposite.op ((wcProEtBC i).obj W))).hom ((w₂.f m).hom x) =
      (w₃.f m).hom (((pK.f m).hom.app (Opposite.op W)).hom x)
    rw [hw₂, hw₃]
    have e1 := congrArg (fun φ => (φ.hom.app (Opposite.op W)).hom x)
      (adj.unit_naturality (pK.f m))
    have e2 := congrArg (fun φ => ((HomologicalComplex.Hom.f φ m).hom.app
      (Opposite.op ((wcProEtBC i).obj W))).hom
      (((adj.unit.app (((Pg.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        I₂.cochainComplex).X m)).hom.app (Opposite.op W)).hom x)) sq₂
    exact e2.trans (congrArg (fun y => ((j₃.f m).hom.app
      (Opposite.op ((wcProEtBC i).obj W))).hom y) e1)
  let Φ : ShortComplex.mk _ _ hzE ⟶ ShortComplex.mk _ _ hzJ :=
    { τ₁ := w₁
      τ₂ := w₂
      τ₃ := w₃
      comm₁₂ := c₁₂
      comm₂₃ := c₂₃ }

  exact (wc_ltp_ses_qiso_two_of_three Φ hSE hSJ).1 qw₂ qw₃

theorem wc_ltp_sections_qiso_of_acyclic : ∀ {S : Scheme.{u}} (U : S.ProEt)
    {A B : CochainComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) ℤ} (f : A ⟶ B)
    (a b : ℤ), A.IsStrictlyGE a → B.IsStrictlyGE b →
    (∀ (m : ℤ) (k : ℕ) (x : Abelian.Ext (wcFreeSheaf S U) (A.X m) (k + 1)), x = 0) →
    (∀ (m : ℤ) (k : ℕ) (x : Abelian.Ext (wcFreeSheaf S U) (B.X m) (k + 1)), x = 0) →
    QuasiIso f →
    QuasiIso (((sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
      (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op U)).mapHomologicalComplex
        (ComplexShape.up ℤ)).map f) :=
by
  classical
  intro S U A B f a b hA hB hAext hBext hf

  have D1 : ∃ e : ∀ F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
      (wcFreeSheaf S U ⟶ F) ≃ F.obj.obj (Opposite.op U),
      (∀ (F F' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (φ : F ⟶ F')
        (g : wcFreeSheaf S U ⟶ F), e F' (g ≫ φ) = φ.hom.app (Opposite.op U) (e F g)) ∧
      (∀ F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}, e F 0 = 0) := by
    let e2 : ∀ G : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1},
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃ G.obj (Opposite.op U) :=
      fun G => ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u}) G).trans
          (uliftYonedaEquiv.{u+1} (X := U) (F := G ⋙ forget AddCommGrpCat.{u+1}))
    have hnat2 : ∀ (G G' : S.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}) (ψ : G ⟶ G')
        (h : yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G),
        e2 G' (h ≫ ψ) = ψ.app (Opposite.op U) (e2 G h) := by
      intro G G' ψ h
      have hW := (Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv_naturality_right
        (X := yoneda.obj U ⋙ uliftFunctor.{u+1, u}) h ψ
      have hY := uliftYonedaEquiv_comp.{u+1}
        ((Adjunction.whiskerRight S.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u}) G h)
        (((Functor.whiskeringRight S.ProEtᵒᵖ AddCommGrpCat.{u+1} (Type (u+1))).obj
            (forget AddCommGrpCat.{u+1})).map ψ)
      exact (congrArg (uliftYonedaEquiv.{u+1} (X := U) (F := G' ⋙ forget AddCommGrpCat.{u+1})) hW).trans hY
    let e : ∀ F : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1},
        (wcFreeSheaf S U ⟶ F) ≃ F.obj.obj (Opposite.op U) := fun F =>
      ((sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F).trans (e2 F.obj)
    have hnat : ∀ (F F' : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) (φ : F ⟶ F')
        (g : wcFreeSheaf S U ⟶ F), e F' (g ≫ φ) = φ.hom.app (Opposite.op U) (e F g) := by
      intro F F' φ g
      have hA := (sheafificationAdjunction (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).homEquiv_naturality_right
        (X := yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) g φ
      exact (congrArg (e2 F'.obj) hA).trans (hnat2 F.obj F'.obj φ.hom _)
    refine ⟨e, hnat, fun F => ?_⟩
    have h1 := hnat F F 0 0
    rw [Limits.zero_comp] at h1
    rw [h1]
    have h0 : (0 : F ⟶ F).hom = 0 :=
      (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).map_zero F F
    rw [h0, NatTrans.app_zero]
    rfl
  obtain ⟨e, he, he0⟩ := D1

  have extZero : ∀ {X : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}}, Limits.IsZero X →
      ∀ (n : ℕ) (x : Abelian.Ext (wcFreeSheaf S U) X n), x = 0 := by
    intro X hX n x
    refine x.comp_mk₀_id.symm.trans ?_
    rw [hX.eq_of_src (𝟙 X) 0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
  have compFac : ∀ {X Y Z : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}} {n : ℕ}
      (x : Abelian.Ext (wcFreeSheaf S U) X n) (u : X ⟶ Y) (v : Y ⟶ Z),
      x.comp (Abelian.Ext.mk₀ (u ≫ v)) (add_zero n) =
        (x.comp (Abelian.Ext.mk₀ u) (add_zero n)).comp (Abelian.Ext.mk₀ v) (add_zero n) := by
    intro X Y Z n x u v
    rw [Abelian.Ext.comp_assoc x (Abelian.Ext.mk₀ u) (Abelian.Ext.mk₀ v) (add_zero n)
      (add_zero 0) (by omega), Abelian.Ext.mk₀_comp_mk₀]
  let M := CochainComplex.mappingCone f

  have hM : ∀ q : ℤ, M.ExactAt q := by
    have key : QuasiIso f ↔ ∀ q : ℤ, (CochainComplex.mappingCone f).ExactAt q := by
      refine ((HomologicalComplex.mem_quasiIso_iff f).symm.trans
        (HomotopyCategory.quotient_map_mem_quasiIso_iff f).symm).trans ?_
      rw [HomotopyCategory.quasiIso_eq_trW_subcategoryAcyclic]
      exact ((HomotopyCategory.subcategoryAcyclic _).trW_iff_of_distinguished _
        (HomotopyCategory.mappingCone_triangleh_distinguished f)).trans
        (HomotopyCategory.quotient_obj_mem_subcategoryAcyclic_iff_exactAt _)
    exact key.mp hf

  have hMge : M.IsStrictlyGE (min a b - 1) := by
    rw [CochainComplex.isStrictlyGE_iff]
    intro i hi
    have hi' : i < min a b - 1 := hi
    rw [Limits.IsZero.iff_id_eq_zero, ← CochainComplex.mappingCone.id_X f i (i+1) rfl]
    have hA0 : Limits.IsZero (A.X (i+1)) := A.isZero_of_isStrictlyGE a (i+1) (by omega)
    have hB0 : Limits.IsZero (B.X i) := B.isZero_of_isStrictlyGE b i (by omega)
    rw [hA0.eq_of_tgt ((↑(CochainComplex.mappingCone.fst f) :
        CochainComplex.HomComplex.Cochain M A 1).v i (i+1) rfl) 0,
      hB0.eq_of_tgt ((CochainComplex.mappingCone.snd f).v i i (add_zero i)) 0,
      Limits.zero_comp, Limits.zero_comp, add_zero]
  have Mext : ∀ (m : ℤ) (k : ℕ) (x : Abelian.Ext (wcFreeSheaf S U) (M.X m) (k + 1)), x = 0 := by
    intro m k x
    have h := CochainComplex.mappingCone.id_X f m (m+1) rfl
    have e1 : x.comp (Abelian.Ext.mk₀ ((↑(CochainComplex.mappingCone.fst f) :
        CochainComplex.HomComplex.Cochain M A 1).v m (m+1) rfl)) (add_zero _) = 0 :=
      hAext (m+1) k _
    have e2 : x.comp (Abelian.Ext.mk₀ ((CochainComplex.mappingCone.snd f).v m m (add_zero m)))
        (add_zero _) = 0 := hBext m k _
    refine x.comp_mk₀_id.symm.trans ?_
    rw [← h, Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, compFac, compFac, e1, e2,
      Abelian.Ext.zero_comp, Abelian.Ext.zero_comp, add_zero]

  have ses : ∀ n : ℤ, M.ExactAt (n+1) → ∃ w : Limits.kernel.ι (M.d n (n+1)) ≫
      Limits.kernel.lift (M.d (n+1) (n+1+1)) (M.d n (n+1)) (M.d_comp_d _ _ _) = 0,
      (ShortComplex.mk (Limits.kernel.ι (M.d n (n+1)))
        (Limits.kernel.lift (M.d (n+1) (n+1+1)) (M.d n (n+1)) (M.d_comp_d _ _ _)) w).ShortExact := by
    intro n hn
    have hw : Limits.kernel.ι (M.d n (n+1)) ≫
        Limits.kernel.lift (M.d (n+1) (n+1+1)) (M.d n (n+1)) (M.d_comp_d _ _ _) = 0 := by
      rw [← cancel_mono (Limits.kernel.ι (M.d (n+1) (n+1+1))), Category.assoc,
        Limits.kernel.lift_ι, Limits.kernel.condition, Limits.zero_comp]
    refine ⟨hw, ?_⟩
    have hex : (M.sc' n (n+1) (n+1+1)).Exact :=
      (M.exactAt_iff' n (n+1) (n+1+1) (by simp) (by simp)).mp hn
    have hepi : Epi (Limits.kernel.lift (M.d (n+1) (n+1+1)) (M.d n (n+1)) (M.d_comp_d _ _ _)) :=
      hex.epi_kernelLift
    have hexact : (ShortComplex.mk (Limits.kernel.ι (M.d n (n+1)))
        (Limits.kernel.lift (M.d (n+1) (n+1+1)) (M.d n (n+1)) (M.d_comp_d _ _ _)) hw).Exact := by
      apply ShortComplex.exact_of_f_is_kernel
      refine Limits.KernelFork.IsLimit.ofι _ _
        (fun {W'} g' h' => Limits.kernel.lift (M.d n (n+1)) g' ?_) ?_ ?_
      · have := congrArg (· ≫ Limits.kernel.ι (M.d (n+1) (n+1+1))) h'
        simpa using this
      · intro W' g' h'
        simp
      · intro W' g' h' m hm
        rw [← cancel_mono (Limits.kernel.ι (M.d n (n+1))), Limits.kernel.lift_ι]
        exact hm
    exact ShortComplex.ShortExact.mk' hexact inferInstance hepi

  have Kext : ∀ (n : ℤ) (k : ℕ)
      (x : Abelian.Ext (wcFreeSheaf S U) (Limits.kernel (M.d n (n+1))) (k+1)), x = 0 := by
    have base : ∀ n : ℤ, n < min a b - 1 → ∀ (k : ℕ)
        (x : Abelian.Ext (wcFreeSheaf S U) (Limits.kernel (M.d n (n+1))) (k+1)), x = 0 := by
      intro n hn k x
      apply extZero _ _ x
      exact Limits.IsZero.of_mono (Limits.kernel.ι _) (M.isZero_of_isStrictlyGE (min a b - 1) n hn)
    have step : ∀ n : ℤ, min a b - 1 - 1 ≤ n → ∀ (k : ℕ)
        (x : Abelian.Ext (wcFreeSheaf S U) (Limits.kernel (M.d n (n+1))) (k+1)), x = 0 := by
      intro n hn
      induction n, hn using Int.le_induction with
      | base => exact base _ (by omega)
      | succ n hn ih =>
        intro k x
        obtain ⟨w, hS⟩ := ses n (hM (n+1))
        have h0 : x.comp hS.extClass (rfl : k + 1 + 1 = k + 1 + 1) = 0 := ih (k+1) _
        obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ (wcFreeSheaf S U) hS x rfl h0
        rw [← hx₂, Mext n k x₂, Abelian.Ext.zero_comp]
    intro n
    by_cases hn : n < min a b - 1
    · exact base n hn
    · exact step n (by omega)

  have liftP : ∀ (i j k : ℤ), j = i + 1 → k = j + 1 → ∀ (y : wcFreeSheaf S U ⟶ M.X j),
      y ≫ M.d j k = 0 → ∃ φ : wcFreeSheaf S U ⟶ M.X i, φ ≫ M.d i j = y := by
    intro i j k hj hk y hy
    subst hj hk
    obtain ⟨w, hS⟩ := ses i (hM (i+1))
    have h0 : (Abelian.Ext.mk₀ (Limits.kernel.lift _ y hy)).comp hS.extClass (zero_add 1) = 0 :=
      Kext i 0 _
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ (wcFreeSheaf S U) hS
      (Abelian.Ext.mk₀ (Limits.kernel.lift _ y hy)) (zero_add 1) h0
    refine ⟨Abelian.Ext.homEquiv₀ x₂, ?_⟩
    have h1 : Abelian.Ext.homEquiv₀ x₂ ≫
        Limits.kernel.lift (M.d (i+1) (i+1+1)) (M.d i (i+1)) (M.d_comp_d _ _ _) =
        Limits.kernel.lift _ y hy := by
      apply (Abelian.Ext.mk₀_bijective _ _).1
      rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
      exact hx₂
    have h2 := congrArg (· ≫ Limits.kernel.ι (M.d (i+1) (i+1+1))) h1
    simpa using h2

  let ev := sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
    (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op U)
  have hN : ∀ q : ℤ, ((ev.mapHomologicalComplex (ComplexShape.up ℤ)).obj M).ExactAt q := by
    intro q
    rw [HomologicalComplex.exactAt_iff' _ (q-1) q (q+1) (by simp) (by simp),
      ShortComplex.ab_exact_iff]
    intro y hy
    let y' : (M.X q).obj.obj (Opposite.op U) := y
    have hy' : (M.d q (q+1)).hom.app (Opposite.op U) y' = 0 := hy
    have hg : (e (M.X q)).symm y' ≫ M.d q (q+1) = 0 := by
      apply (e _).injective
      rw [he, Equiv.apply_symm_apply, he0]
      exact hy'
    obtain ⟨φ, hφ⟩ := liftP (q-1) q (q+1) (by omega) rfl _ hg
    refine ⟨e _ φ, ?_⟩
    have := he _ _ (M.d (q-1) q) φ
    rw [hφ, Equiv.apply_symm_apply] at this
    exact this.symm
  have hiso := CochainComplex.mappingCone.mapHomologicalComplexIso f ev
  have key : QuasiIso ((ev.mapHomologicalComplex (ComplexShape.up ℤ)).map f) ↔ ∀ q : ℤ,
      (CochainComplex.mappingCone ((ev.mapHomologicalComplex (ComplexShape.up ℤ)).map f)).ExactAt q := by
    refine ((HomologicalComplex.mem_quasiIso_iff _).symm.trans
      (HomotopyCategory.quotient_map_mem_quasiIso_iff _).symm).trans ?_
    rw [HomotopyCategory.quasiIso_eq_trW_subcategoryAcyclic]
    exact ((HomotopyCategory.subcategoryAcyclic _).trW_iff_of_distinguished _
      (HomotopyCategory.mappingCone_triangleh_distinguished _)).trans
      (HomotopyCategory.quotient_obj_mem_subcategoryAcyclic_iff_exactAt _)
  exact key.mpr (fun q => (hN q).of_iso hiso)

theorem wc_ltp_seq_colim_quasiIso : ∀ {C : Type*} [Category C] [Abelian C]
    [Limits.HasColimitsOfShape ℕ C] [HasExactColimitsOfShape ℕ C]
    {F G : ℕ ⥤ CochainComplex C ℤ} (α : F ⟶ G), (∀ n, QuasiIso (α.app n)) →
    ∀ (cF : Limits.Cocone F) (cG : Limits.Cocone G),
    (∀ k, Limits.IsColimit ((HomologicalComplex.eval C (ComplexShape.up ℤ) k).mapCocone cF)) →
    (∀ k, Limits.IsColimit ((HomologicalComplex.eval C (ComplexShape.up ℤ) k).mapCocone cG)) →
    ∀ (φ : cF.pt ⟶ cG.pt), (∀ n, cF.ι.app n ≫ φ = α.app n ≫ cG.ι.app n) → QuasiIso φ :=
by
  intro C _ _ _ _ F G α hα cF cG hcF hcG φ hφ
  rw [quasiIso_iff]
  intro j
  rw [quasiIsoAt_iff' φ (j-1) j (j+1) (CochainComplex.prev ℤ j) (CochainComplex.next ℤ j)]
  let Φ := HomologicalComplex.shortComplexFunctor' C (ComplexShape.up ℤ) (j-1) j (j+1)
  let Inv := ShortComplex.FunctorEquivalence.inverse ℕ C
  let β : F ⋙ Φ ⟶ G ⋙ Φ := Functor.whiskerRight α Φ
  let ψ' := Inv.map β
  have hψ' : ShortComplex.QuasiIso ψ' := by
    rw [ShortComplex.quasiIso_iff_evaluation]
    intro n
    exact (quasiIsoAt_iff' (α.app n) (j-1) j (j+1) (CochainComplex.prev ℤ j)
      (CochainComplex.next ℤ j)).mp ((quasiIso_iff _).mp (hα n) j)
  let H := (Limits.colim : (ℕ ⥤ C) ⥤ C).mapShortComplex
  have hH : ShortComplex.QuasiIso (H.map ψ') :=
    ShortComplex.quasiIso_map_of_preservesLeftHomology _ _
  have hE : ∀ (K : ℕ ⥤ CochainComplex C ℤ) (c : Limits.Cocone K),
      (∀ k, Limits.IsColimit ((HomologicalComplex.eval C (ComplexShape.up ℤ) k).mapCocone c)) →
      ∃ E : H.obj (Inv.obj (K ⋙ Φ)) ≅ Φ.obj c.pt,
        ∀ n, Limits.colimit.ι ((K ⋙ Φ) ⋙ ShortComplex.π₁) n ≫ E.hom.τ₁ = (c.ι.app n).f (j-1) ∧
          Limits.colimit.ι ((K ⋙ Φ) ⋙ ShortComplex.π₂) n ≫ E.hom.τ₂ = (c.ι.app n).f j ∧
          Limits.colimit.ι ((K ⋙ Φ) ⋙ ShortComplex.π₃) n ≫ E.hom.τ₃ = (c.ι.app n).f (j+1) := by
    intro K c hc
    let e₁ := (Limits.colimit.isColimit ((K ⋙ Φ) ⋙ ShortComplex.π₁)).coconePointUniqueUpToIso
      (hc (j-1))
    let e₂ := (Limits.colimit.isColimit ((K ⋙ Φ) ⋙ ShortComplex.π₂)).coconePointUniqueUpToIso
      (hc j)
    let e₃ := (Limits.colimit.isColimit ((K ⋙ Φ) ⋙ ShortComplex.π₃)).coconePointUniqueUpToIso
      (hc (j+1))
    have h₁ : ∀ n, Limits.colimit.ι ((K ⋙ Φ) ⋙ ShortComplex.π₁) n ≫ e₁.hom =
        (c.ι.app n).f (j-1) :=
      fun n => (Limits.colimit.isColimit _).comp_coconePointUniqueUpToIso_hom (hc (j-1)) n
    have h₂ : ∀ n, Limits.colimit.ι ((K ⋙ Φ) ⋙ ShortComplex.π₂) n ≫ e₂.hom =
        (c.ι.app n).f j :=
      fun n => (Limits.colimit.isColimit _).comp_coconePointUniqueUpToIso_hom (hc j) n
    have h₃ : ∀ n, Limits.colimit.ι ((K ⋙ Φ) ⋙ ShortComplex.π₃) n ≫ e₃.hom =
        (c.ι.app n).f (j+1) :=
      fun n => (Limits.colimit.isColimit _).comp_coconePointUniqueUpToIso_hom (hc (j+1)) n
    refine ⟨ShortComplex.isoMk e₁ e₂ e₃ ?_ ?_, fun n => ⟨h₁ n, h₂ n, h₃ n⟩⟩
    · refine Limits.colimit.hom_ext (F := (K ⋙ Φ) ⋙ ShortComplex.π₁) (fun n => ?_)
      show Limits.colimit.ι ((K ⋙ Φ) ⋙ ShortComplex.π₁) n ≫ e₁.hom ≫ c.pt.d (j-1) j =
        Limits.colimit.ι ((K ⋙ Φ) ⋙ ShortComplex.π₁) n ≫
          Limits.colimMap (Functor.whiskerLeft (K ⋙ Φ) ShortComplex.π₁Toπ₂) ≫ e₂.hom
      rw [reassoc_of% (h₁ n), Limits.ι_colimMap_assoc, h₂ n]
      exact (c.ι.app n).comm (j-1) j
    · refine Limits.colimit.hom_ext (F := (K ⋙ Φ) ⋙ ShortComplex.π₂) (fun n => ?_)
      show Limits.colimit.ι ((K ⋙ Φ) ⋙ ShortComplex.π₂) n ≫ e₂.hom ≫ c.pt.d j (j+1) =
        Limits.colimit.ι ((K ⋙ Φ) ⋙ ShortComplex.π₂) n ≫
          Limits.colimMap (Functor.whiskerLeft (K ⋙ Φ) ShortComplex.π₂Toπ₃) ≫ e₃.hom
      rw [reassoc_of% (h₂ n), Limits.ι_colimMap_assoc, h₃ n]
      exact (c.ι.app n).comm j (j+1)
  obtain ⟨E₁, hE₁⟩ := hE F cF hcF
  obtain ⟨E₂, hE₂⟩ := hE G cG hcG
  have w : E₁.hom ≫ Φ.map φ = H.map ψ' ≫ E₂.hom := by
    ext
    · refine Limits.colimit.hom_ext (F := (F ⋙ Φ) ⋙ ShortComplex.π₁) (fun n => ?_)
      show Limits.colimit.ι ((F ⋙ Φ) ⋙ ShortComplex.π₁) n ≫ E₁.hom.τ₁ ≫ φ.f (j-1) =
        Limits.colimit.ι ((F ⋙ Φ) ⋙ ShortComplex.π₁) n ≫
          Limits.colimMap (Functor.whiskerRight β ShortComplex.π₁) ≫ E₂.hom.τ₁
      have := congrArg (fun f => HomologicalComplex.Hom.f f (j-1)) (hφ n)
      simp only [HomologicalComplex.comp_f] at this
      refine (Category.assoc _ _ _).symm.trans ?_
      refine (congrArg (fun x => x ≫ φ.f (j-1)) (hE₁ n).1).trans ?_
      refine Eq.trans ?_ (Limits.ι_colimMap_assoc (Functor.whiskerRight β ShortComplex.π₁) n E₂.hom.τ₁).symm
      refine Eq.trans ?_
        (congrArg (fun x => (Functor.whiskerRight β ShortComplex.π₁).app n ≫ x) (hE₂ n).1).symm
      exact this
    · refine Limits.colimit.hom_ext (F := (F ⋙ Φ) ⋙ ShortComplex.π₂) (fun n => ?_)
      show Limits.colimit.ι ((F ⋙ Φ) ⋙ ShortComplex.π₂) n ≫ E₁.hom.τ₂ ≫ φ.f j =
        Limits.colimit.ι ((F ⋙ Φ) ⋙ ShortComplex.π₂) n ≫
          Limits.colimMap (Functor.whiskerRight β ShortComplex.π₂) ≫ E₂.hom.τ₂
      have := congrArg (fun f => HomologicalComplex.Hom.f f j) (hφ n)
      simp only [HomologicalComplex.comp_f] at this
      refine (Category.assoc _ _ _).symm.trans ?_
      refine (congrArg (fun x => x ≫ φ.f j) (hE₁ n).2.1).trans ?_
      refine Eq.trans ?_ (Limits.ι_colimMap_assoc (Functor.whiskerRight β ShortComplex.π₂) n E₂.hom.τ₂).symm
      refine Eq.trans ?_
        (congrArg (fun x => (Functor.whiskerRight β ShortComplex.π₂).app n ≫ x) (hE₂ n).2.1).symm
      exact this
    · refine Limits.colimit.hom_ext (F := (F ⋙ Φ) ⋙ ShortComplex.π₃) (fun n => ?_)
      show Limits.colimit.ι ((F ⋙ Φ) ⋙ ShortComplex.π₃) n ≫ E₁.hom.τ₃ ≫ φ.f (j+1) =
        Limits.colimit.ι ((F ⋙ Φ) ⋙ ShortComplex.π₃) n ≫
          Limits.colimMap (Functor.whiskerRight β ShortComplex.π₃) ≫ E₂.hom.τ₃
      have := congrArg (fun f => HomologicalComplex.Hom.f f (j+1)) (hφ n)
      simp only [HomologicalComplex.comp_f] at this
      refine (Category.assoc _ _ _).symm.trans ?_
      refine (congrArg (fun x => x ≫ φ.f (j+1)) (hE₁ n).2.2).trans ?_
      refine Eq.trans ?_ (Limits.ι_colimMap_assoc (Functor.whiskerRight β ShortComplex.π₃) n E₂.hom.τ₃).symm
      refine Eq.trans ?_
        (congrArg (fun x => (Functor.whiskerRight β ShortComplex.π₃).app n ≫ x) (hE₂ n).2.2).symm
      exact this
  exact ShortComplex.quasiIso_of_arrow_mk_iso (H.map ψ') (Φ.map φ) (Arrow.isoMk' _ _ E₁ E₂ w)

theorem wc_ltp_kinj_factor : ∀ {C : Type*} [Category C] [Abelian C] {A B J : CochainComplex C ℤ}
    (m : ℤ), J.IsStrictlyGE m → (∀ k, Injective (J.X k)) → ∀ (a : A ⟶ B) (b : A ⟶ J),
    QuasiIso a → ∃ u : B ⟶ J, Nonempty (Homotopy (a ≫ u) b) :=
by
  intro C _ _ A B J m hJ hInj a b ha
  letI := HasDerivedCategory.standard C
  haveI := hJ
  haveI : ∀ k, Injective (J.X k) := hInj
  haveI : J.IsKInjective := CochainComplex.isKInjective_of_injective J m
  let q := HomotopyCategory.quotient C (ComplexShape.up ℤ)
  have hsurj := CochainComplex.IsKInjective.Qh_map_bijective (q.obj B) J
  have hinj := CochainComplex.IsKInjective.Qh_map_bijective (q.obj A) J
  have hiso : IsIso (DerivedCategory.Qh.map (q.map a)) := by
    rw [DerivedCategory.isIso_Qh_map_iff, HomotopyCategory.quotient_map_mem_quasiIso_iff,
      HomologicalComplex.mem_quasiIso_iff]
    exact ha
  obtain ⟨v, hv⟩ := hsurj.2 (inv (DerivedCategory.Qh.map (q.map a)) ≫ DerivedCategory.Qh.map (q.map b))
  obtain ⟨u, hu⟩ := q.map_surjective v
  refine ⟨u, ⟨HomotopyCategory.homotopyOfEq (a ≫ u) b ?_⟩⟩
  apply hinj.1
  change DerivedCategory.Qh.map (q.map (a ≫ u)) = DerivedCategory.Qh.map (q.map b)
  rw [Functor.map_comp, Functor.map_comp, hu, hv, IsIso.hom_inv_id_assoc]

theorem wc_ltp_strictify_homotopy : ∀ {C : Type*} [Category C] [Abelian C]
    {Y J J' : CochainComplex C ℤ} (j : Y ⟶ J), (∀ k, Mono (j.f k)) → (∀ k, Injective (J'.X k)) →
    ∀ (a : Y ⟶ J') (t₀ : J ⟶ J'), Homotopy (j ≫ t₀) a → ∃ t : J ⟶ J', j ≫ t = a :=
by
  intro C _ _ Y J J' j hj hJ' a t₀ H
  have hex : ∀ k l : ℤ, ∃ s : J.X k ⟶ J'.X l, j.f k ≫ s = H.hom k l := by
    intro k l
    haveI := hJ' l
    haveI := hj k
    exact ⟨Injective.factorThru (H.hom k l) (j.f k), Injective.comp_factorThru _ _⟩
  choose s hs using hex
  refine ⟨t₀ - Homotopy.nullHomotopicMap s, ?_⟩
  have e1 : j ≫ Homotopy.nullHomotopicMap s = Homotopy.nullHomotopicMap H.hom := by
    rw [Homotopy.comp_nullHomotopicMap]
    congr 1
    funext k l
    exact hs k l
  rw [Preadditive.comp_sub, e1]
  exact sub_eq_of_eq_add (Homotopy.eq_add_nullHomotopicMap H)

theorem wc_ltp_sections_seq_colimit : ∀ {S : Scheme.{u}} (U : S.ProEt) [CompactSpace U.left]
    [QuasiSeparatedSpace U.left] (G : ℕ ⥤ Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})
    (c : Limits.Cocone G), Limits.IsColimit c →
    Nonempty (Limits.IsColimit ((sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
      (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op U)).mapCocone c)) :=
by
  intro S U _ _ G c hc

  have pbgood : ∀ (K A B : S.ProEt) (a : A ⟶ K) (b : B ⟶ K),
      QuasiSeparatedSpace K.left → IsAffine A.left → IsAffine B.left →
      CompactSpace (Limits.pullback a b).left ∧ QuasiSeparatedSpace (Limits.pullback a b).left := by
    intro K A B a b hK hA hB
    haveI := hK
    haveI := hA
    haveI := hB
    have hsq := (IsPullback.of_hasPullback a b).map (Scheme.ProEt.forget S ⋙ Over.forget S)
    have hbqc : QuasiCompact b.left := inferInstance
    have hbqs : QuasiSeparated b.left := inferInstance
    have rqc := MorphismProperty.of_isPullback (P := @QuasiCompact) hsq.flip hbqc
    have rqs := MorphismProperty.of_isPullback (P := @QuasiSeparated) hsq.flip hbqs
    haveI : QuasiCompact (Limits.pullback.fst a b).left := rqc
    haveI : QuasiSeparated (Limits.pullback.fst a b).left := rqs
    exact ⟨QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst a b).left,
      quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst a b).left⟩

  have injK : ∀ (K : S.ProEt), CompactSpace K.left → QuasiSeparatedSpace K.left →
      ∀ (n : ℕ) (t : (G.obj n).obj.obj (Opposite.op K)),
        (c.ι.app n).hom.app (Opposite.op K) t = 0 →
        ∃ (m : ℕ) (hnm : n ≤ m), (G.map (homOfLE hnm)).hom.app (Opposite.op K) t = 0 := by
    intro K hK1 hK2 n t ht
    haveI := hK1
    haveI := hK2
    obtain ⟨R, hR, hRk⟩ :=
      sheaf_seq_colimit_section_locally_dies (Scheme.ProEt.topology S) G c hc K n t ht
    exact sheaf_seq_kill_of_finite_refinement (Scheme.ProEt.topology S) G K (fun R' hR' => by
        obtain ⟨k', V, f, h1, -, h3⟩ := proet_qcqs_finite_affine_refinement S K R' hR'
        exact ⟨k', V, f, h1, h3⟩) n t R hR hRk

  have surjK : ∀ (K : S.ProEt), CompactSpace K.left → QuasiSeparatedSpace K.left →
      ∀ s : c.pt.obj.obj (Opposite.op K), ∃ (n : ℕ) (t : (G.obj n).obj.obj (Opposite.op K)),
        (c.ι.app n).hom.app (Opposite.op K) t = s := by
    intro K hK1 hK2 s
    haveI := hK1
    haveI := hK2
    obtain ⟨R, hR, hl⟩ :=
      sheaf_seq_colimit_section_locally_lifts (Scheme.ProEt.topology S) G c hc K s
    obtain ⟨k', V, f, hRf, hVa, hcov⟩ := proet_qcqs_finite_affine_refinement S K R hR
    refine sheaf_seq_glue_finite_cover (Scheme.ProEt.topology S) G c K k' V f hcov ?_ s
      (fun j => hl (V j) (f j) (hRf j))
    intro i j n t ht
    obtain ⟨h1, h2⟩ := pbgood K (V i) (V j) (f i) (f j) hK2 (hVa i) (hVa j)
    exact injK _ h1 h2 n t ht

  let ev : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⥤ AddCommGrpCat.{u+1} :=
    sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
      (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op U)
  have hT : Limits.IsColimit ((forget AddCommGrpCat.{u+1}).mapCocone (ev.mapCocone c)) := by
    refine Limits.Types.FilteredColimit.isColimitOf' _ _ ?_ ?_
    · intro x
      obtain ⟨n, t, ht⟩ := surjK U inferInstance inferInstance x
      exact ⟨n, t, ht.symm⟩
    · intro i x y hxy
      have hxy' : ((c.ι.app i).hom.app (Opposite.op U)).hom x =
          ((c.ι.app i).hom.app (Opposite.op U)).hom y := hxy
      have e1 := (((c.ι.app i).hom.app (Opposite.op U)).hom).map_sub x y
      have hz : (c.ι.app i).hom.app (Opposite.op U) (x - y) = 0 := by
        refine e1.trans ?_
        rw [hxy', sub_self]
      obtain ⟨m, hnm, hm⟩ := injK U inferInstance inferInstance i (x - y) hz
      refine ⟨m, homOfLE hnm, ?_⟩
      have e2 := (((G.map (homOfLE hnm)).hom.app (Opposite.op U)).hom).map_sub x y
      have h3 : ((G.map (homOfLE hnm)).hom.app (Opposite.op U)).hom x -
          ((G.map (homOfLE hnm)).hom.app (Opposite.op U)).hom y = 0 := e2.symm.trans hm
      exact sub_eq_zero.mp h3

  haveI : Limits.PreservesFilteredColimitsOfSize.{0, 0} (forget AddCommGrpCat.{u+1}) :=
    Limits.preservesFilteredColimitsOfSize_shrink (forget AddCommGrpCat.{u+1})
  haveI := Limits.reflectsColimit_of_reflectsIsomorphisms (G ⋙ ev) (forget AddCommGrpCat.{u+1})
  exact ⟨Limits.isColimitOfReflects (forget AddCommGrpCat.{u+1}) hT⟩

theorem wc_ltp_qiso_of_affine_sections_colim : ∀ {S E : Scheme.{u}}
    (P : Sheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1} ⥤
      Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) [P.Additive],
    (∀ V : S.ProEt, IsAffine V.left → ∃ V' : E.ProEt, IsAffine V'.left ∧
      Nonempty (P ⋙ (sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
        (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op V)) ≅
        (sheafToPresheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1} ⋙
          (evaluation E.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op V')))) →
    ∀ (𝕀 : ℕ ⥤ CochainComplex (Sheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1}) ℤ) (a : ℤ),
    (∀ n, (𝕀.obj n).IsStrictlyGE a) → (∀ n m, Injective ((𝕀.obj n).X m)) →
    ∀ (s : Limits.Cocone 𝕀),
    (∀ k, Limits.IsColimit ((HomologicalComplex.eval _ (ComplexShape.up ℤ) k).mapCocone s)) →
    ∀ (B : CochainComplex (Sheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1}) ℤ),
    B.IsStrictlyGE a → (∀ m, Injective (B.X m)) → ∀ (χ : s.pt ⟶ B), QuasiIso χ →
    ∀ (T : Limits.Cocone (𝕀 ⋙ P.mapHomologicalComplex (ComplexShape.up ℤ))),
    (∀ k, Limits.IsColimit ((HomologicalComplex.eval _ (ComplexShape.up ℤ) k).mapCocone T)) →
    ∀ (θ : T.pt ⟶ (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj B),
    (∀ n, T.ι.app n ≫ θ = (P.mapHomologicalComplex (ComplexShape.up ℤ)).map (s.ι.app n ≫ χ)) →
    QuasiIso θ :=
by
  intro S E P _ hP 𝕀 a h𝕀ge h𝕀inj s hs B hBge hBinj χ hχ T hT θ hθ

  have hexact : ∀ (C : CochainComplex (Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}) ℤ),
      (∀ V : S.ProEt, IsAffine V.left → ∀ q : ℤ,
        (((sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
          (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op V)).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj C).ExactAt q) → ∀ q : ℤ, C.ExactAt q := by
    intro C hC q
    rw [HomologicalComplex.exactAt_iff]
    refine (ShortComplex.exact_iff_epi_toCycles _).mpr
      ((Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat.{u+1} _).mp ?_)
    refine ⟨fun {U} z => ?_⟩
    have hcov := wc_proet_cover_of_affine_local (fun _ => True)
      (fun V hV => ⟨V, 𝟙 V, hV, inferInstance, inferInstance, trivial⟩) U
    refine (Scheme.ProEt.topology S).superset_covering ?_ hcov
    rw [Sieve.generate_le_iff]
    rintro W g ⟨hW, -⟩
    let evW := sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
      (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op W)
    have lift : ∀ z' : (evW.obj (C.sc q).cycles),
        ∃ t, (evW.map (C.sc q).toCycles).hom t = z' := by
      intro z'
      have hmono : Mono (evW.map (C.sc q).iCycles) := by
        first
          | exact Functor.map_mono _ _
          | exact (inferInstance : Mono ((C.sc q).iCycles.hom.app (Opposite.op W)))
      have hinj := (AddCommGrpCat.mono_iff_injective _).mp hmono
      have h0 : evW.map (C.sc q).iCycles ≫ evW.map (C.sc q).g = 0 := by
        rw [← Functor.map_comp, ShortComplex.iCycles_g, Functor.map_zero]
      have hy : (evW.map (C.sc q).g).hom ((evW.map (C.sc q).iCycles).hom z') = 0 := by
        have := congrArg (fun φ => φ.hom z') h0
        simpa using this
      obtain ⟨t, ht⟩ := (ShortComplex.ab_exact_iff _).mp
        ((HomologicalComplex.exactAt_iff _ _).mp (hC W hW q))
        ((evW.map (C.sc q).iCycles).hom z') hy
      refine ⟨t, hinj ?_⟩
      have h1 : evW.map (C.sc q).toCycles ≫ evW.map (C.sc q).iCycles = evW.map (C.sc q).f := by
        rw [← Functor.map_comp, ShortComplex.toCycles_i]
      have h2 := congrArg (fun φ => φ.hom t) h1
      exact h2.trans ht
    rw [Presheaf.imageSieve_apply]
    exact lift _

  refine (wc_tq_quasiIso_iff_cone_exact θ).mpr ?_
  apply hexact
  intro V hV q
  obtain ⟨V', hV', ⟨ν⟩⟩ := hP V hV
  haveI : IsAffine V.left := hV
  haveI : IsAffine V'.left := hV'
  let Γ := sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
    (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op V)
  let Γ' := sheafToPresheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1} ⋙
    (evaluation E.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op V')
  let PH := P.mapHomologicalComplex (ComplexShape.up ℤ)
  let ΓH := Γ.mapHomologicalComplex (ComplexShape.up ℤ)
  let Γ'H := Γ'.mapHomologicalComplex (ComplexShape.up ℤ)

  have hsge : s.pt.IsStrictlyGE a := (CochainComplex.isStrictlyGE_iff _ _).mpr (fun k hk => by
    rw [Limits.IsZero.iff_id_eq_zero]
    apply (hs k).hom_ext
    intro n
    haveI := h𝕀ge n
    exact ((𝕀.obj n).isZero_of_isStrictlyGE a k hk).eq_of_src _ _)
  have hχ' : QuasiIso (Γ'H.map χ) :=
    wc_ltp_sections_qiso_of_acyclic V' χ a a hsge hBge
      (fun m k x => proet_ext_colimit_injectives_vanish E V'
        (𝕀 ⋙ HomologicalComplex.eval _ (ComplexShape.up ℤ) m)
        (fun n => h𝕀inj n m) ((HomologicalComplex.eval _ (ComplexShape.up ℤ) m).mapCocone s)
        (hs m) k x)
      (fun m k x => by haveI := hBinj m; exact Abelian.Ext.eq_zero_of_injective x) hχ

  have hT' : Limits.IsColimit (ΓH.mapCocone T) :=
    HomologicalComplex.isColimitOfEval _ _ (fun k =>
      (wc_ltp_sections_seq_colimit V _ _ (hT k)).some)
  have hs' : Limits.IsColimit (Γ'H.mapCocone s) :=
    HomologicalComplex.isColimitOfEval _ _ (fun k =>
      (wc_ltp_sections_seq_colimit V' _ _ (hs k)).some)
  let N := Functor.mapHomologicalComplexCompIso ν (ComplexShape.up ℤ)
  let Φ : (𝕀 ⋙ PH) ⋙ ΓH ≅ 𝕀 ⋙ Γ'H :=
    NatIso.ofComponents (fun n => N.app (𝕀.obj n)) (fun f => by exact N.hom.naturality (𝕀.map f))
  let κ := hT'.coconePointsIsoOfNatIso hs' Φ
  have hsq : ΓH.map θ ≫ N.hom.app B = κ.hom ≫ Γ'H.map χ := by
    apply hT'.hom_ext
    intro n
    have e1 : (ΓH.mapCocone T).ι.app n ≫ κ.hom = Φ.hom.app n ≫ (Γ'H.mapCocone s).ι.app n :=
      hT'.comp_coconePointsIsoOfNatIso_hom hs' Φ n
    have e2 : (PH ⋙ ΓH).map (s.ι.app n ≫ χ) ≫ N.hom.app B =
        N.hom.app (𝕀.obj n) ≫ Γ'H.map (s.ι.app n ≫ χ) := N.hom.naturality _
    have e3 : ΓH.map (T.ι.app n ≫ θ) = ΓH.map (PH.map (s.ι.app n ≫ χ)) :=
      congrArg ΓH.map (hθ n)
    change ΓH.map (T.ι.app n) ≫ ΓH.map θ ≫ N.hom.app B =
      ΓH.map (T.ι.app n) ≫ κ.hom ≫ Γ'H.map χ
    rw [← Category.assoc, ← Functor.map_comp, e3, ← Category.assoc]
    change (PH ⋙ ΓH).map (s.ι.app n ≫ χ) ≫ N.hom.app B =
      (ΓH.map (T.ι.app n) ≫ κ.hom) ≫ Γ'H.map χ
    rw [e2]
    change _ = ((ΓH.mapCocone T).ι.app n ≫ κ.hom) ≫ Γ'H.map χ
    rw [e1]
    change _ = (N.hom.app (𝕀.obj n) ≫ Γ'H.map (s.ι.app n)) ≫ Γ'H.map χ
    rw [Category.assoc, ← Functor.map_comp]
  have hθV : QuasiIso (ΓH.map θ) := by
    haveI := hχ'
    haveI : QuasiIso κ.hom := quasiIso_of_isIso _
    haveI : QuasiIso (N.hom.app B) := quasiIso_of_isIso _
    have h1 : QuasiIso (ΓH.map θ ≫ N.hom.app B) := by
      rw [hsq]
      exact quasiIso_comp _ _
    exact (quasiIso_iff_comp_right _ _).mp h1

  have hcone := (wc_tq_quasiIso_iff_cone_exact (ΓH.map θ)).mp hθV q
  exact hcone.of_iso (CochainComplex.mappingCone.mapHomologicalComplexIso θ Γ).symm

theorem wc_ltp_rationalize {S Z E : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    (g : E ⟶ S) [IsAffineHom g] (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (W : S.ProEt)
    [CompactSpace W.left] [QuasiSeparatedSpace W.left]
    [CompactSpace ((wcProEtBC i).obj W).left] [QuasiSeparatedSpace ((wcProEtBC i).obj W).left]
    [CompactSpace ((wcProEtBC g).obj W).left] [QuasiSeparatedSpace ((wcProEtBC g).obj W).left]
