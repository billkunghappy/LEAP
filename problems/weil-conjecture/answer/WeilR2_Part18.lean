  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
  have hQ' : DerivedCategory.Q.map (CochainComplex.mappingCone.map _ _ _ _ hc) =
      DerivedCategory.Q.map (𝟙 _) := hQ.trans (DerivedCategory.Q.map_id _).symm
  obtain ⟨Z, sZ, hqis, hZz, ⟨hm0⟩⟩ := wc_qmmv_derived_eq_homotopy _ _ (-1) hs2 hQ'
