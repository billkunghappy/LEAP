      ⟨(ev _).symm _, Equiv.apply_symm_apply _ _⟩
    have hfP : fP ≫ I.cocomplex.d (n + 1) (n + 1 + 1) = 0 := by
      apply (ev _).injective
      rw [hnat, hfPdef, hds', hev0]
    obtain ⟨DV, hDV⟩ := wc_hm_pull_data_exists ((wcProEtBC T.πi).obj W').hom ℓ
    obtain ⟨Θ, -⟩ := wc_proet_free_slice_module_ext T.XEi ℓ
