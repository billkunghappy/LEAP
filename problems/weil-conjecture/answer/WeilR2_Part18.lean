      exact ((Dw.Φ.obj (P V)).val.map_comp_apply ((wcProEtBC w).map h).op ζ.op k).symm
    · rw [hK]
      have n2 := PresheafOfModules.naturality_apply (wcTsfKappa Dw P ev V).val h'.op
        (ev ((wcProEtBC w).obj V) (P ((wcProEtBC w).obj V)) (𝟙 (P ((wcProEtBC w).obj V))))
      have n2' := n2.trans (congrArg
        (fun y : (Dw.Φ.obj (P V)).val.obj (Opposite.op ((wcProEtBC w).obj V)) =>
          ((Dw.Φ.obj (P V)).val.map h'.op).hom y) s3)
      show _ = ((wcTsfKappa Dw P ev V).val.app (Opposite.op ((wcSliceFunctor S'
          ((wcProEtBC w).obj V)).obj ((wcProEtBC (Limits.pullback.fst V.hom w)).obj T)))).hom
        ((εV'.val.app (Opposite.op ((wcProEtBC (Limits.pullback.fst V.hom w)).obj T))).hom
          (((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
            (wcProEtBC (Limits.pullback.fst V.hom w)) _ _ D.cont D.φ).val.app
              (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ]))))
      rw [e5 T, hεV' ((wcProEtBC (Limits.pullback.fst V.hom w)).obj T) h' hh']
      exact n2'.symm
  · obtain ⟨h, h', ζ, hh, hh', hζf, hζs, hK⟩ := key T
    have e1 := hκ S' V T
    have e2 : ((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC w) _ _
        Dw.cont Dw.φ).val.app (Opposite.op ((wcSliceFunctor S' V).obj T))).hom
          (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])) =
        (1 : C(↥((wcProEtBC w).obj ((wcSliceFunctor S' V).obj T)).left, ULift.{u+1} ℚ_[ℓ])) :=
      (SheafOfModules.unitToPushforwardObjUnit_val_app_apply Dw.φ
        (X := Opposite.op ((wcSliceFunctor S' V).obj T)) _).trans
        (map_one (ConcreteCategory.hom (Dw.φ.hom.app (Opposite.op ((wcSliceFunctor S' V).obj T)))))
    have e6 := hκ S' ((wcProEtBC w).obj V) ((wcProEtBC (Limits.pullback.fst V.hom w)).obj T)
    show ((β.app (SheafOfModules.unit (wcRingSheaf S' ℓ))).val.app (Opposite.op T)).hom
        (((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC w) _ _
          Dw.cont Dw.φ).val.app (Opposite.op ((wcSliceFunctor S' V).obj T))).hom
