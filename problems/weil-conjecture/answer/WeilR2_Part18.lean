      rw [he2, Adjunction.homEquiv_unit, sheafificationAdjunction_unit_app]
      rfl
    have hfun : (fun φ : (presheafToSheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}).obj
          (yoneda.obj T ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) ⟶ Fs =>
