      refine ⟨O.ι (Limits.pullback.snd Vt.hom k pp), ?_⟩
      have h1 : (Limits.pullback.fst Vt.hom k ≫ Vt.hom) pp =
          (Limits.pullback.snd Vt.hom k ≫ k) pp := by rw [Limits.pullback.condition]
      have h2 : Vt.hom x = i (O.ι (Limits.pullback.snd Vt.hom k pp)) := by
        rw [← hpp]
        exact h1
      exact h2.symm
    haveI hP : Projective (wcFreeSheaf X Vt) := wc_proet_free_projective_wcontractible X Vt hVt
    obtain ⟨ev, hnat, hzero⟩ := proet_free_sheaf_hom_equiv X Vt
    let toSh := SheafOfModules.toSheaf.{u+1} (wcRingSheaf X ℓ)
    obtain ⟨s', hs'⟩ : ∃ s' : (toSh.obj N₀).obj.obj (Opposite.op Vt),
        s' = (N₀.val.map c₀.op).hom s := ⟨_, rfl⟩
    rw [← hs']
    let σ : wcFreeSheaf X Vt ⟶ toSh.obj N₀ := (ev (toSh.obj N₀)).symm s'
    haveI : Epi (toSh.map π) := Functor.map_epi _ π
    haveI : Mono (toSh.map ι) := Functor.map_mono _ ι
    let τ := Projective.factorThru σ (toSh.map π)
    have hτ : τ ≫ toSh.map π = σ := Projective.factorThru_comp σ (toSh.map π)
    obtain ⟨m, hm⟩ : ∃ m : M.val.obj (Opposite.op Vt), m = ev (toSh.obj M) τ := ⟨_, rfl⟩
    have hgm : (g.val.app (Opposite.op Vt)).hom m = 0 := hg Vt hVt hclX m
    have hd : τ ≫ toSh.map g = 0 := by
      apply (ev (toSh.obj N)).injective
      rw [hnat, hzero, ← hm]
      exact hgm
    have he : σ ≫ toSh.map ι = 0 := by
      rw [← hτ, Category.assoc, ← Functor.map_comp, hfac]
      exact hd
    have hσ : σ = 0 := Limits.zero_of_comp_mono (toSh.map ι) he
    have : s' = ev (toSh.obj N₀) σ := (Equiv.apply_symm_apply _ _).symm
    rw [this, hσ, hzero]
    rfl

theorem wc_tsf_ext_class_conj {C : Type*} [Category C] [Abelian C] [HasExt C]
    (Φ : C ⥤ C) [Φ.Additive] [Limits.PreservesFiniteLimits Φ] [Limits.PreservesFiniteColimits Φ]
