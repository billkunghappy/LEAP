        ((Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app J.cochainComplex ≫
          (NatTrans.mapHomologicalComplex adj.unit (ComplexShape.up ℤ)).app J.cochainComplex ≫
          (Functor.mapHomologicalComplexCompIso (Iso.refl (Φw ⋙ Pw))
            (ComplexShape.up ℤ)).inv.app J.cochainComplex ≫
          (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map tU) ≫
      (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
        (ComplexShape.up ℤ)).hom.app J.cochainComplex ≫
      (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app J.cochainComplex
  obtain ⟨χ, hχ⟩ := L4 P' Pw' Φw' (𝟭 C) adj' γ' P Pw Φw (𝟭 D) adj γ PE Pg Pg
    β βw α (Functor.leftUnitor Pg ≪≫ (Functor.rightUnitor Pg).symm) hBC3 hBC4
    I'.cochainComplex J.cochainComplex θ t' tU rfl T' rfl TJ rfl
  let a := (Functor.mapHomologicalComplexIdIso C (ComplexShape.up ℤ)).app
    ((P'.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex)
  let b := (Functor.mapHomologicalComplexIdIso D (ComplexShape.up ℤ)).app
    ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj J.cochainComplex)
  let χs : (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj J.cochainComplex ≅
