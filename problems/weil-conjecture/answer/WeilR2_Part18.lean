  have hB := ext_transfer_of_hom_bijective L (SheafOfModules.toSheaf.{u+1} (wcRingSheaf S ℓ))
    adj (wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S))) (SheafOfModules.unit (wcRingSheaf S ℓ)) ε Hε
