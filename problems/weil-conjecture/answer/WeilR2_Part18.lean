  intro x
  have εinj : Function.Injective
      (Scheme.ΓSpecIso ((Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi).residueField x)).hom.hom :=
    (Scheme.ΓSpecIso _).commRingCatIsoToRingEquiv.injective
  obtain ⟨ρ, hρ⟩ : ∃ ρ : Γ(Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi, ⊤) →+*
      ((Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi).residueField x),
      ∀ y, ρ y = (Scheme.ΓSpecIso ((Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi).residueField
        x)).hom.hom
          (((Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi).fromSpecResidueField x).appTop.hom y) :=
    ⟨(Scheme.ΓSpecIso _).hom.hom.comp (Scheme.Hom.appTop _).hom, fun y => rfl⟩
  obtain ⟨θ, hθ⟩ : ∃ θ : L →+* ((Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi).residueField x),
