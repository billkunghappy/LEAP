    rw [mul_pow, ← pow_mul, mul_comm _ ℓ, pow_mul, hζEc, hyEc,
      powmodG _ _ (ℓ ^ k) _ (hζEpow k), valsucc]
  have sec : ∀ a : ℤ_[ℓ], ∃ s : E ⟶ Z, s ≫ fZ = 𝟙 E ∧ (∀ e, θ (s e) = a) ∧
      (∀ z, θ z = a → s (fZ z) = z) := by
    intro a
    obtain ⟨χa, hχa⟩ := c1 (Γ(E, ⊤)) (fun k => uζ k ^ (PadicInt.toZModPow k a).val * uy k)
      (uacomp a)
    have hχa' : ∀ (m : ℤ) (k : ℕ), χa (Multiplicative.ofAdd (Localization.mk m
        (⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Submonoid.powers (ℓ : ℤ)))) =
        (uζ k ^ (PadicInt.toZModPow k a).val * uy k) ^ m := hχa
    have h1 : ((χa (Multiplicative.ofAdd 1) : Γ(E, ⊤)ˣ) : Γ(E, ⊤)) = H (LaurentPolynomial.T 1) := by
      rw [hmk0, hχa' 1 0, zpow_one, Units.val_mul, Units.val_pow_eq_pow_val, huζ, huy, valzero,
        pow_zero, one_mul, hyE0]
    obtain ⟨s, hs1, hs2⟩ := c6 χa h1
    refine ⟨s, hs1, ?_, ?_⟩
    · intro e
      have e1 : ∀ k, s.appTop.hom (tk k) =
          H (LaurentPolynomial.C (T.ζ k)) ^ (PadicInt.toZModPow k a).val * yE k := by
        intro k
        rw [htk, hs2, map_one, map_one, one_mul, hχa' 1 k, zpow_one, Units.val_mul,
          Units.val_pow_eq_pow_val, huζ, huy]
      have e2 : ∀ k, s.appTop.hom (ζZ k) = H (LaurentPolynomial.C (T.ζ k)) := by
        intro k
        rw [hζZ, hs2, ofAdd_zero, map_one, Units.val_one, mul_one]
      have e3 : ∀ k, s.appTop.hom (Yk k) = yE k := by
        intro k
        rw [hYk, ← cA, hs1]
        exact congrArg (fun f => f.hom (yE k)) Scheme.Hom.id_appTop
      rw [hDig]
      intro k
      apply rfinj s e
      rw [map_mul, map_pow, natev, natev, natev, e1 k, e2 k, e3 k, map_mul, map_pow]
    · intro z hz
      have hdig := (hDig z a).mp hz
      have hm : ∀ m : Localization.Away (ℓ : ℤ), (Z.Γevaluation z).hom (fZ.appTop.hom
          ((χa (Multiplicative.ofAdd m) : Γ(E, ⊤)ˣ) : Γ(E, ⊤))) =
          (Z.Γevaluation z).hom (G (AddMonoidAlgebra.single m 1)) := by
        let f1 : Multiplicative (Localization.Away (ℓ : ℤ)) →* Z.residueField z :=
          ((Z.Γevaluation z).hom.toMonoidHom.comp fZ.appTop.hom.toMonoidHom).comp
            ((Units.coeHom _).comp χa)
        let f2 : Multiplicative (Localization.Away (ℓ : ℤ)) →* Z.residueField z :=
          { toFun := fun x => (Z.Γevaluation z).hom
              (G (AddMonoidAlgebra.single (Multiplicative.toAdd x) 1))
            map_one' := by
              simp only [toAdd_one, ← AddMonoidAlgebra.one_def, map_one]
            map_mul' := fun x y => by
              simp only [toAdd_mul, ← map_mul, AddMonoidAlgebra.single_mul_single, mul_one] }
        have hgen : ∀ k : ℕ, f1 (Multiplicative.ofAdd (Localization.mk (1 : ℤ)
            (⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Submonoid.powers (ℓ : ℤ)))) =
            f2 (Multiplicative.ofAdd (Localization.mk (1 : ℤ)
            (⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Submonoid.powers (ℓ : ℤ)))) := by
          intro k
          show (Z.Γevaluation z).hom (fZ.appTop.hom ((χa (Multiplicative.ofAdd
            (Localization.mk (1 : ℤ) (⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Submonoid.powers (ℓ : ℤ)))) :
              Γ(E, ⊤)ˣ) : Γ(E, ⊤))) =
            (Z.Γevaluation z).hom (G (AddMonoidAlgebra.single (Localization.mk (1 : ℤ)
            (⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Submonoid.powers (ℓ : ℤ))) 1))
          rw [hχa' 1 k, zpow_one, Units.val_mul, Units.val_pow_eq_pow_val, huζ, huy, map_mul,
            map_pow, hHC, ← hζZ, ← hYk, map_mul, map_pow, ← htk]
          exact (hdig k).symm
        intro m
        induction m using Localization.induction_on with | H yy => ?_
        obtain ⟨n, s0⟩ := yy
        obtain ⟨k, hk⟩ := s0.2
        have hs0 : s0 = (⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Submonoid.powers (ℓ : ℤ)) := Subtype.ext hk.symm
        subst hs0
        have e1 : (Localization.mk n (⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Submonoid.powers (ℓ : ℤ)) :
            Localization.Away (ℓ : ℤ)) = n • Localization.mk (1 : ℤ)
              (⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Submonoid.powers (ℓ : ℤ)) := (hzsmul n _).symm
        show f1 (Multiplicative.ofAdd (Localization.mk n _)) =
          f2 (Multiplicative.ofAdd (Localization.mk n _))
        rw [e1, ofAdd_zsmul, map_zpow, map_zpow, hgen]
      have key : Z.fromSpecResidueField z ≫ fZ ≫ s = Z.fromSpecResidueField z := by
        apply hZ.hom_ext
        · simp only [Category.assoc, hs1, Category.comp_id]
        · apply T.hT.hom_ext
          · simp only [Category.assoc, ← hZ.w]
            rw [← Category.assoc s fZ sE, hs1, Category.id_comp]
          · simp only [Category.assoc]
            apply c3 Z z _ (fZ ≫ s ≫ sZ ≫ T.gi) (sZ ≫ T.gi)
            intro r
            have hR : ((Z.Γevaluation z).hom.comp ((fZ.appTop.hom).comp ((s.appTop.hom).comp G))) =
                (Z.Γevaluation z).hom.comp G := by
              apply AddMonoidAlgebra.ringHom_ext
              · intro c
                simp only [RingHom.comp_apply]
                rw [hs2, ofAdd_zero, map_one, Units.val_one, mul_one, hHC]
              · intro m
                simp only [RingHom.comp_apply]
                rw [hs2, map_one, map_one, one_mul]
                exact hm m
            rw [cA fZ (s ≫ sZ ≫ T.gi), cA s (sZ ≫ T.gi), ← hG]
            exact RingHom.congr_fun hR r
      obtain ⟨s0⟩ : Nonempty (Spec (Z.residueField z)) := inferInstance
      have := congrArg (fun f : Spec (Z.residueField z) ⟶ Z => f s0) key
      simp only [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply] at this
      exact this
  have hbij : Function.Bijective (fun z : Z => (fZ z, θ z)) := by
    constructor
    · intro z1 z2 h
      simp only [Prod.mk.injEq] at h
      obtain ⟨h1, h2⟩ := h
      obtain ⟨s, -, -, hs⟩ := sec (θ z1)
      rw [← hs z1 rfl, ← hs z2 h2.symm, h1]
    · rintro ⟨e, a⟩
      obtain ⟨s, hs1, hs2, -⟩ := sec a
      refine ⟨s e, ?_⟩
      simp only [Prod.mk.injEq]
      refine ⟨?_, hs2 e⟩
      rw [← Scheme.Hom.comp_apply, hs1, idap]
  have hπint : IsIntegralHom T.πi :=
    MorphismProperty.of_isPullback (P := @IsIntegralHom) T.hT.flip
      (IsIntegralHom.SpecMap_iff.mpr c2)
  haveI hfZint : IsIntegralHom fZ :=
    MorphismProperty.of_isPullback (P := @IsIntegralHom) hZ.flip hπint
  obtain ⟨τ, hτ⟩ := c4 fZ (Scheme.Hom.isProperMap fZ) θ hθc hbij
  have star : ∀ e a z, fZ z = e → θ z = a → τ (e, a) = z := by
    intro e a z h1 h2
    rw [← h1, ← h2, ← hτ z, Homeomorph.apply_symm_apply]
  have tfs : ∀ x, fZ (τ x) = x.1 ∧ θ (τ x) = x.2 := by
    intro x
    have h := hτ (τ x)
    rw [Homeomorph.symm_apply_apply] at h
    exact ⟨(congrArg Prod.fst h).symm, (congrArg Prod.snd h).symm⟩
  refine ⟨τ, fun x => (tfs x).1, ?_, ?_⟩
  · intro κ hκ1 hκ2 e a
    symm
    apply star
    · rw [← Scheme.Hom.comp_apply, hκ1, (tfs (e, a)).1]
    · rw [hDig]
      intro k
      apply rfinj κ (τ (e, a))
      have hz := (hDig (τ (e, a)) a).mp (tfs (e, a)).2 k
      have e1 : κ.appTop.hom (tk k) = ζZ k * tk k := by
        rw [htk, P2 κ hκ2, T.hχ, zpow_one, hζZ, ← map_mul, AddMonoidAlgebra.single_mul_single,
          zero_add]
      have e2 : κ.appTop.hom (ζZ k) = ζZ k := by
        rw [hζZ, P2 κ hκ2, ofAdd_zero, map_one, Units.val_one, one_mul]
      have e3 : κ.appTop.hom (Yk k) = Yk k := by
        rw [hYk, ← cA, hκ1]
      rw [map_mul, map_pow, natev, natev, natev, e1, e2, e3, map_mul, hz, valadd, Nat.add_mod_mod,
        ← powmodG _ _ _ _ (hζZprim (τ (e, a)) k).pow_eq_one, pow_succ]
      ring
  · intro W hW Ξ hΞ1 hΞ2 e a
    symm
    apply star
    · rw [← Scheme.Hom.comp_apply, hΞ1, Scheme.Hom.comp_apply, (tfs (e, a)).1]
    · rw [hDig]
      intro k
      apply rfinj Ξ (τ (e, a))
      have hz := (hDig (τ (e, a)) a).mp (tfs (e, a)).2 k
      have e1 : Ξ.appTop.hom (tk k) = tk k := by
        rw [htk, P3 Ξ hΞ2, map_one]
      have e2 : Ξ.appTop.hom (ζZ k) = ζZ k := by
        obtain ⟨a', ha'⟩ := T.hζA k
        rw [hζZ, P3 Ξ hΞ2, ← ha', ← RingHom.comp_apply σ φA, hσ]
      have e3 : Ξ.appTop.hom (Yk k) = Yk k := by
        rw [hYk, hyE, ← cA Ξ fZ, hΞ1, cA fZ W, ← cA W fE, hW]
      rw [map_mul, map_pow, natev, natev, natev, e1, e2, e3]
      exact hz

theorem wc_qmtm_wlocal_unit_root (X : Scheme.{u}) [IsAffine X]
    (hc : IsClosed {x : X | IsClosed ({x} : Set X)})
    (hu : ∀ x : X, ∃! y : X, IsClosed ({y} : Set X) ∧ x ⤳ y)
    (hs : ∀ x : X, IsClosed ({x} : Set X) →
      HenselianLocalRing (X.presheaf.stalk x) ∧ IsSepClosed (X.residueField x))
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit ((ℓ : ℕ) : Γ(X, ⊤))) (a : Γ(X, ⊤)) (ha : IsUnit a) :
    ∃ b : Γ(X, ⊤), b ^ ℓ = a :=
by
  classical
  have hℓ0 : ℓ ≠ 0 := (Fact.out : ℓ.Prime).ne_zero

  have wclopen : ∀ (z : X) (hz : IsClosed ({z} : Set X)) (U : Set X) (hU : IsOpen U)
      (hzU : z ∈ U), ∃ V : Set X, IsClopen V ∧ z ∈ V ∧ V ⊆ U := by
    intro z hz U hU hzU
    have s3 : ∀ (A : Type u) [CommRing A], IsClosed {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} → (∀ x : PrimeSpectrum A, ∃! y : PrimeSpectrum A, IsClosed ({y} : Set (PrimeSpectrum A)) ∧ x ⤳ y) → ∀ U : Set {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, IsClopen U → ∃ e : A, e * e = e ∧ ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, (m ∈ U ↔ e ∉ m.1.asIdeal) := by
      intro A _ ha hb U hU
      have hclosed : ∀ V : Set {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))},
          IsClosed V → ∀ n : Ideal A, n.IsMaximal →
          PrimeSpectrum.vanishingIdeal (Subtype.val '' V) ≤ n → ∃ m ∈ V, m.1.asIdeal = n := by
        intro V hV n hn hle
        have hVc : IsClosed (Subtype.val '' V) := (IsClosed.isClosedMap_subtype_val ha) V hV
        have hx : (⟨n, hn.isPrime⟩ : PrimeSpectrum A) ∈ PrimeSpectrum.zeroLocus
            (PrimeSpectrum.vanishingIdeal (Subtype.val '' V) : Set A) := by
          rw [PrimeSpectrum.mem_zeroLocus]
          exact fun a ha' => hle ha'
        rw [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hVc.closure_eq] at hx
        obtain ⟨m, hm, hmeq⟩ := hx
        exact ⟨m, hm, by rw [hmeq]⟩
      have hnc : ∀ P : Ideal A, P.IsPrime →
          P ⊔ PrimeSpectrum.vanishingIdeal (Subtype.val '' U) ≠ ⊤ →
          P ⊔ PrimeSpectrum.vanishingIdeal (Subtype.val '' Uᶜ) = ⊤ := by
        intro P hP h1
        by_contra h2
        obtain ⟨n1, hn1, hle1⟩ := Ideal.exists_le_maximal _ h1
        obtain ⟨n2, hn2, hle2⟩ := Ideal.exists_le_maximal _ h2
        obtain ⟨m1, hm1U, hm1⟩ := hclosed U hU.isClosed n1 hn1 (le_trans le_sup_right hle1)
        obtain ⟨m2, hm2U, hm2⟩ := hclosed Uᶜ hU.compl.isClosed n2 hn2 (le_trans le_sup_right hle2)
        have sp1 : (⟨P, hP⟩ : PrimeSpectrum A) ⤳ m1.1 := by
          rw [← PrimeSpectrum.le_iff_specializes, ← PrimeSpectrum.asIdeal_le_asIdeal, hm1]
          exact le_trans le_sup_left hle1
        have sp2 : (⟨P, hP⟩ : PrimeSpectrum A) ⤳ m2.1 := by
          rw [← PrimeSpectrum.le_iff_specializes, ← PrimeSpectrum.asIdeal_le_asIdeal, hm2]
          exact le_trans le_sup_left hle2
        have heq := (hb ⟨P, hP⟩).unique ⟨m1.2, sp1⟩ ⟨m2.2, sp2⟩
        have hm12 : m1 = m2 := Subtype.ext heq
        exact hm2U (hm12 ▸ hm1U)
      have havoid : ∃ i ∈ PrimeSpectrum.vanishingIdeal (Subtype.val '' U),
          ∃ j ∈ PrimeSpectrum.vanishingIdeal (Subtype.val '' Uᶜ), (1 - i) * (1 - j) = 0 := by
        set I := PrimeSpectrum.vanishingIdeal (Subtype.val '' U) with hI
        set J := PrimeSpectrum.vanishingIdeal (Subtype.val '' Uᶜ) with hJ
        let S : Submonoid A :=
          { carrier := {x | ∃ i ∈ I, ∃ j ∈ J, x = (1 - i) * (1 - j)}
            mul_mem' := by
              rintro a b ⟨i1, hi1, j1, hj1, rfl⟩ ⟨i2, hi2, j2, hj2, rfl⟩
              exact ⟨i1 + i2 - i1 * i2, I.sub_mem (I.add_mem hi1 hi2) (I.mul_mem_right i2 hi1),
                j1 + j2 - j1 * j2, J.sub_mem (J.add_mem hj1 hj2) (J.mul_mem_right j2 hj1), by ring⟩
            one_mem' := by
              show ∃ i ∈ I, ∃ j ∈ J, (1 : A) = (1 - i) * (1 - j)
              exact ⟨0, I.zero_mem, 0, J.zero_mem, by ring⟩ }
        have hS : ∀ x, x ∈ S ↔ ∃ i ∈ I, ∃ j ∈ J, x = (1 - i) * (1 - j) := fun x => Iff.rfl
        by_contra hcon
        have hdisj : Disjoint ((⊥ : Ideal A) : Set A) (S : Set A) := by
          rw [Set.disjoint_left]
          intro x hx hxS
          rw [SetLike.mem_coe, Ideal.mem_bot] at hx
          subst hx
          obtain ⟨i, hi, j, hj, h⟩ := (hS 0).1 hxS
          exact hcon ⟨i, hi, j, hj, h.symm⟩
        obtain ⟨P, hP, -, hPS⟩ := Ideal.exists_le_prime_disjoint ⊥ S hdisj
        have h1 : P ⊔ I ≠ ⊤ := by
          intro htop
          rw [Ideal.eq_top_iff_one, Submodule.mem_sup] at htop
          obtain ⟨p, hp, i, hi, hpi⟩ := htop
          have hmem : 1 - i ∈ S := (hS _).2 ⟨i, hi, 0, J.zero_mem, by ring⟩
          have hpe : 1 - i = p := by rw [← hpi]; ring
          rw [← hpe] at hp
          exact Set.disjoint_left.mp hPS (SetLike.mem_coe.mpr hp) hmem
        have h2 := hnc P hP h1
        rw [Ideal.eq_top_iff_one, Submodule.mem_sup] at h2
        obtain ⟨p, hp, j, hj, hpj⟩ := h2
        have hmem : 1 - j ∈ S := (hS _).2 ⟨0, I.zero_mem, j, hj, by ring⟩
        have hpe : 1 - j = p := by rw [← hpj]; ring
        rw [← hpe] at hp
        exact Set.disjoint_left.mp hPS (SetLike.mem_coe.mpr hp) hmem
      obtain ⟨i, hi, j, hj, hij⟩ := havoid
      have P1 : ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, m ∈ U →
          (1 - i) ∉ m.1.asIdeal ∧ (1 - j) ∈ m.1.asIdeal := by
        intro m hm
        have him : i ∈ m.1.asIdeal :=
          (PrimeSpectrum.mem_vanishingIdeal _ _).mp hi m.1 (Set.mem_image_of_mem _ hm)
        have hfn : (1 - i) ∉ m.1.asIdeal := by
          intro hfm
          apply m.1.isPrime.ne_top
          rw [Ideal.eq_top_iff_one]
          have h1 : (1 : A) = (1 - i) + i := by ring
          rw [h1]
          exact m.1.asIdeal.add_mem hfm him
        refine ⟨hfn, ?_⟩
        have h0 : (1 - i) * (1 - j) ∈ m.1.asIdeal := by rw [hij]; exact m.1.asIdeal.zero_mem
        exact (m.1.isPrime.mem_or_mem h0).resolve_left hfn
      have P2 : ∀ m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))}, m ∉ U →
          (1 - j) ∉ m.1.asIdeal ∧ (1 - i) ∈ m.1.asIdeal := by
        intro m hm
        have hjm : j ∈ m.1.asIdeal :=
          (PrimeSpectrum.mem_vanishingIdeal _ _).mp hj m.1
            (Set.mem_image_of_mem _ (show m ∈ Uᶜ from hm))
        have hgn : (1 - j) ∉ m.1.asIdeal := by
          intro hgm
          apply m.1.isPrime.ne_top
          rw [Ideal.eq_top_iff_one]
          have h1 : (1 : A) = (1 - j) + j := by ring
          rw [h1]
          exact m.1.asIdeal.add_mem hgm hjm
        refine ⟨hgn, ?_⟩
        have h0 : (1 - i) * (1 - j) ∈ m.1.asIdeal := by rw [hij]; exact m.1.asIdeal.zero_mem
        exact (m.1.isPrime.mem_or_mem h0).resolve_right hgn
      have hunit : IsUnit ((1 - i) + (1 - j)) := by
        by_contra hnu
        obtain ⟨N, hN, hmem⟩ := exists_max_ideal_of_mem_nonunits (mem_nonunits_iff.mpr hnu)
        let m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} :=
          ⟨⟨N, hN.isPrime⟩, (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr hN⟩
        have hmN : m.1.asIdeal = N := rfl
        by_cases hm : m ∈ U
        · obtain ⟨hf, hg⟩ := P1 m hm
          rw [hmN] at hf hg
          apply hf
          have e1 : 1 - i = ((1 - i) + (1 - j)) - (1 - j) := by ring
          rw [e1]
          exact N.sub_mem hmem hg
        · obtain ⟨hg, hf⟩ := P2 m hm
          rw [hmN] at hf hg
          apply hg
          have e1 : 1 - j = ((1 - i) + (1 - j)) - (1 - i) := by ring
          rw [e1]
          exact N.sub_mem hmem hf
      obtain ⟨u, hu⟩ := hunit
      have h1 : ((1 - i) + (1 - j)) * (↑u⁻¹ : A) = 1 := by rw [← hu, Units.mul_inv]
      refine ⟨(1 - i) * (↑u⁻¹ : A), ?_, ?_⟩
      · linear_combination (-((↑u⁻¹ : A) * (↑u⁻¹ : A))) * hij + ((1 - i) * (↑u⁻¹ : A)) * h1
      · intro m
        constructor
        · intro hm hem
          apply (P1 m hm).1
          have e1 : 1 - i = ((1 - i) * (↑u⁻¹ : A)) * ((1 - i) + (1 - j)) := by
            linear_combination (-(1 - i)) * h1
          rw [e1]
          exact m.1.asIdeal.mul_mem_right _ hem
        · intro hem
          by_contra hm
          exact hem (m.1.asIdeal.mul_mem_right _ (P2 m hm).2)
    have s1 : ∀ (A : Type u) [CommRing A], IsClosed {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} → ∀ a : A, IsClopen {m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} | a ∉ m.1.asIdeal} := by
      intro A _ hcA a
      have hopen : ∀ b : A, IsOpen {m : {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} | b ∉ m.1.asIdeal} :=
        fun b => (PrimeSpectrum.isOpen_basicOpen (a := b)).preimage continuous_subtype_val
      refine ⟨?_, hopen a⟩
      rw [← isOpen_compl_iff, isOpen_iff_forall_mem_open]
      intro m' hm'
      have ham' : a ∈ m'.1.asIdeal := not_not.mp hm'
      have hnd : ¬ Disjoint ((PrimeSpectrum.vanishingIdeal {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} : Ideal A) : Set A)
          ((m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a : Submonoid A) : Set A) := by
        intro hdisj
        obtain ⟨P, hP, hJP, hPS⟩ := Ideal.exists_le_prime_disjoint _ _ hdisj
        have hPZ : (⟨P, hP⟩ : PrimeSpectrum A) ∈ {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} := by
          have hx : (⟨P, hP⟩ : PrimeSpectrum A) ∈ PrimeSpectrum.zeroLocus
              (PrimeSpectrum.vanishingIdeal {x : PrimeSpectrum A | IsClosed ({x} : Set (PrimeSpectrum A))} : Set A) := by
            rw [PrimeSpectrum.mem_zeroLocus]
            exact fun t ht => hJP ht
          rwa [PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure, hcA.closure_eq] at hx
        have hPmax : P.IsMaximal := (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hPZ
        have hPle : P ≤ m'.1.asIdeal := by
          intro t ht
          by_contra htm
          have htS : t ∈ (m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a : Submonoid A) :=
            (le_sup_left : m'.1.asIdeal.primeCompl ≤ m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a) htm
          exact Set.disjoint_left.mp hPS ht htS
        have hPeq : P = m'.1.asIdeal := hPmax.eq_of_le m'.1.isPrime.ne_top hPle
        have haS : a ∈ (m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a : Submonoid A) :=
          (le_sup_right : Submonoid.powers a ≤ m'.1.asIdeal.primeCompl ⊔ Submonoid.powers a)
            (Submonoid.mem_powers a)
        have haP : a ∈ (P : Set A) := by rw [SetLike.mem_coe, hPeq]; exact ham'
        exact Set.disjoint_left.mp hPS haP haS
      rw [Set.not_disjoint_iff] at hnd
      obtain ⟨t, htJ, htS⟩ := hnd
      obtain ⟨s, hs, w, hw, hsw⟩ := Submonoid.mem_sup.mp (SetLike.mem_coe.mp htS)
      obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hw
      refine ⟨{m | s ∉ m.1.asIdeal}, ?_, hopen s, hs⟩
      intro m hm ham
      have htm : t ∈ m.1.asIdeal :=
        (PrimeSpectrum.mem_vanishingIdeal _ _).mp (SetLike.mem_coe.mp htJ) m.1 m.2
      rw [← hsw] at htm
      rcases m.1.isPrime.mem_or_mem htm with h | h
      · exact hm h
      · exact ham (m.1.isPrime.mem_of_pow_mem k h)
    have s2 : ∀ (A : Type u) [CommRing A], (∀ x : PrimeSpectrum A, ∃ y : PrimeSpectrum A, IsClosed ({y} : Set (PrimeSpectrum A)) ∧ x ⤳ y) → ∀ (a e : A), e * e = e → (∀ y : PrimeSpectrum A, IsClosed ({y} : Set (PrimeSpectrum A)) → e ∉ y.asIdeal → a ∉ y.asIdeal) → ∀ x : PrimeSpectrum A, e ∉ x.asIdeal → a ∉ x.asIdeal := by
      intro A _ hex a e he hcl x hx hax
      obtain ⟨y, hy, hxy⟩ := hex x
      have hle : x.asIdeal ≤ y.asIdeal :=
        (PrimeSpectrum.asIdeal_le_asIdeal x y).mpr ((PrimeSpectrum.le_iff_specializes x y).mpr hxy)
      have h0 : e * (1 - e) ∈ x.asIdeal := by
        have h00 : e * (1 - e) = 0 := by rw [mul_sub, mul_one, he, sub_self]
        rw [h00]; exact x.asIdeal.zero_mem
      have h1 : 1 - e ∈ y.asIdeal := hle ((x.isPrime.mem_or_mem h0).resolve_left hx)
      have hey : e ∉ y.asIdeal := by
        intro hey
        apply y.isPrime.ne_top
        rw [Ideal.eq_top_iff_one]
        have h11 : (1 : A) = e + (1 - e) := by ring
        rw [h11]; exact y.asIdeal.add_mem hey h1
      exact hcl y hy hey (hle hax)
    let φ : X ≃ₜ PrimeSpectrum Γ(X, ⊤) := X.isoSpec.hom.homeomorph
    have K : ∀ x : X, IsClosed ({φ x} : Set (PrimeSpectrum Γ(X, ⊤))) ↔ IsClosed ({x} : Set X) := by
      intro x
      rw [show ({φ x} : Set (PrimeSpectrum Γ(X, ⊤))) = φ '' {x} from (Set.image_singleton).symm]
      exact φ.isClosed_image
    have K' : ∀ p : PrimeSpectrum Γ(X, ⊤),
        IsClosed ({p} : Set (PrimeSpectrum Γ(X, ⊤))) ↔ IsClosed ({φ.symm p} : Set X) := by
      intro p
      rw [← K, φ.apply_symm_apply]
    have hc' : IsClosed {p : PrimeSpectrum Γ(X, ⊤) | IsClosed ({p} : Set (PrimeSpectrum Γ(X, ⊤)))} := by
      have hset : {p : PrimeSpectrum Γ(X, ⊤) | IsClosed ({p} : Set (PrimeSpectrum Γ(X, ⊤)))} =
          φ.symm ⁻¹' {x : X | IsClosed ({x} : Set X)} := by
        ext p; exact K' p
      rw [hset]; exact hc.preimage φ.symm.continuous
    have hu' : ∀ p : PrimeSpectrum Γ(X, ⊤), ∃! q : PrimeSpectrum Γ(X, ⊤),
        IsClosed ({q} : Set (PrimeSpectrum Γ(X, ⊤))) ∧ p ⤳ q := by
      intro p
      obtain ⟨y, ⟨hy, hpy⟩, huniq⟩ := hu (φ.symm p)
      refine ⟨φ y, ⟨(K y).mpr hy, ?_⟩, ?_⟩
      · have hsp := hpy.map φ.continuous
        rwa [φ.apply_symm_apply] at hsp
      · rintro q ⟨hq, hpq⟩
        have h1 : φ.symm q = y := huniq _ ⟨(K' q).mp hq, hpq.map φ.symm.continuous⟩
        rw [← h1, φ.apply_symm_apply]
    have hzU' : φ z ∈ φ.symm ⁻¹' U := by
      rw [Set.mem_preimage, φ.symm_apply_apply]; exact hzU
    obtain ⟨_, ⟨a, rfl⟩, hza, haU⟩ :=
      PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hzU'
        (hU.preimage φ.symm.continuous)
    obtain ⟨e, he, heC⟩ := s3 Γ(X, ⊤) hc' hu' _ (s1 Γ(X, ⊤) hc' a)
    refine ⟨φ ⁻¹' (PrimeSpectrum.basicOpen e : Set (PrimeSpectrum Γ(X, ⊤))), ?_, ?_, ?_⟩
    · exact (PrimeSpectrum.isClopen_basicOpen_of_mul_add e (1 - e)
        (by rw [mul_sub, mul_one, he, sub_self]) (by ring)).preimage φ.continuous
    · show e ∉ (φ z).asIdeal
      exact (heC ⟨φ z, (K z).mpr hz⟩).mp hza
    · intro x hx
      have hxa : a ∉ (φ x).asIdeal :=
        s2 Γ(X, ⊤) (fun p => (hu' p).exists) a e he (fun y hy hey => (heC ⟨y, hy⟩).mpr hey) (φ x) hx
      have hxU := haU hxa
      rwa [Set.mem_preimage, φ.symm_apply_apply] at hxU

  have hensel : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R]
      [IsSepClosed (IsLocalRing.ResidueField R)] (n : ℕ), n ≠ 0 → IsUnit (n : R) →
      ∀ (a : R), IsUnit a → ∃ b : R, b ^ n = a := by
    intro R _ _ _ n hn hnR a ha
    have hā : IsLocalRing.residue R a ≠ 0 := (IsLocalRing.residue_ne_zero_iff_isUnit a).mpr ha
    have hnk : ((n : ℕ) : IsLocalRing.ResidueField R) ≠ 0 := by
      rw [← map_natCast (IsLocalRing.residue R) n]
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hnR
    haveI : NeZero ((n : ℕ) : IsLocalRing.ResidueField R) := ⟨hnk⟩
    obtain ⟨bb, hbb⟩ := IsSepClosed.exists_pow_nat_eq (IsLocalRing.residue R a) n
    obtain ⟨b₀, hb₀⟩ := IsLocalRing.residue_surjective bb
    have hbb0 : bb ≠ 0 := by
      rintro rfl
      rw [zero_pow hn] at hbb
      exact hā hbb.symm
    have hb₀u : IsUnit b₀ := (IsLocalRing.residue_ne_zero_iff_isUnit b₀).mp (hb₀ ▸ hbb0)
    have hmon := Polynomial.monic_X_pow_sub_C a hn
    have h1 : Polynomial.eval b₀ (Polynomial.X ^ n - Polynomial.C a) ∈
        IsLocalRing.maximalIdeal R := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
        map_sub, map_pow, hb₀, hbb, sub_self]
    have h2 : IsUnit (Polynomial.eval b₀
        (Polynomial.derivative (Polynomial.X ^ n - Polynomial.C a))) := by
      simp only [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
        sub_zero, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
      exact hnR.mul (hb₀u.pow _)
    obtain ⟨b, hb, -⟩ := HenselianLocalRing.is_henselian _ hmon b₀ h1 h2
    refine ⟨b, ?_⟩
    rw [Polynomial.IsRoot.def] at hb
    simpa [sub_eq_zero] using hb

  have spread : ∀ (z : X) (β : X.presheaf.stalk z),
      β ^ ℓ = (X.presheaf.germ ⊤ z trivial).hom a →
      ∃ (W : X.Opens) (_ : z ∈ W) (c : Γ(X, W)),
        c ^ ℓ = (X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom a := by
    intro z β hβ
    obtain ⟨U, hzU, s, hs⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf β
    have h : ConcreteCategory.hom (X.presheaf.germ U z hzU) (s ^ ℓ) =
        ConcreteCategory.hom (X.presheaf.germ ⊤ z trivial) a := by
      rw [map_pow, hs]
      exact hβ
    obtain ⟨W, hzW, iU, iV, he⟩ := TopCat.Presheaf.germ_eq X.presheaf (V := ⊤) z hzU
      (show z ∈ (⊤ : X.Opens) from trivial) (s ^ ℓ) a h
    refine ⟨W, hzW, ConcreteCategory.hom (X.presheaf.map iU.op) s, ?_⟩
    rw [← map_pow]
    have hiV : iV = homOfLE (le_top : W ≤ ⊤) := Subsingleton.elim _ _
    subst hiV
    exact he

  have hloc : ∀ z : {z : X // IsClosed ({z} : Set X)}, ∃ (W : X.Opens) (c : Γ(X, W)) (V : Set X),
      c ^ ℓ = (X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom a ∧ IsClopen V ∧ z.1 ∈ V ∧
        V ⊆ (W : Set X) := by
    rintro ⟨z, hz⟩
    obtain ⟨hH, hS⟩ := hs z hz
    haveI := hH
    haveI : IsSepClosed (IsLocalRing.ResidueField (X.presheaf.stalk z)) := hS
    have hℓz : IsUnit ((ℓ : ℕ) : X.presheaf.stalk z) := by
      have := hℓ.map (X.presheaf.germ ⊤ z trivial).hom
      rwa [map_natCast] at this
    obtain ⟨β, hβ⟩ := hensel (X.presheaf.stalk z) ℓ hℓ0 hℓz _
      (ha.map (X.presheaf.germ ⊤ z trivial).hom)
    obtain ⟨W, hzW, c, hcW⟩ := spread z β hβ
    obtain ⟨V, hV, hzV, hVW⟩ := wclopen z hz W W.isOpen hzW
    exact ⟨W, c, V, hcW, hV, hzV, hVW⟩
  choose W c V hcW hV hzV hVW using hloc

  have hcov0 : ∀ x : X, ∃ z, x ∈ V z := by
    intro x
    obtain ⟨y, ⟨hy, hxy⟩, -⟩ := hu x
    exact ⟨⟨y, hy⟩, hxy.mem_open (hV ⟨y, hy⟩).isOpen (hzV ⟨y, hy⟩)⟩
  obtain ⟨t, ht⟩ := (isCompact_univ (X := X)).elim_finite_subcover (fun z => V z)
    (fun z => (hV z).isOpen) (by
      intro x _
      obtain ⟨z, hz⟩ := hcov0 x
      exact Set.mem_iUnion.mpr ⟨z, hz⟩)
  set m := t.card with hm
  let zs : Fin m → {z : X // IsClosed ({z} : Set X)} := fun i => (t.equivFin.symm i).1
  let D : Fin m → Set X := fun i => V (zs i) \ ⋃ j ∈ {j : Fin m | j < i}, V (zs j)
  have hD : ∀ i, IsClopen (D i) := fun i =>
    (hV _).diff (Set.Finite.isClopen_biUnion (Set.toFinite _) (fun j _ => hV _))
  have hDsub : ∀ i, D i ⊆ V (zs i) := fun i => Set.diff_subset
  have hdisj : ∀ i j, i ≠ j → Disjoint (D i) (D j) := by
    intro i j hij
    rcases lt_or_gt_of_ne hij with h | h
    · exact Set.disjoint_left.mpr fun x hxi hxj =>
        hxj.2 (Set.mem_biUnion (show i ∈ {j' : Fin m | j' < j} from h) hxi.1)
    · exact Set.disjoint_left.mpr fun x hxi hxj =>
        hxi.2 (Set.mem_biUnion (show j ∈ {j' : Fin m | j' < i} from h) hxj.1)
  have hcovD : ∀ x : X, ∃ i, x ∈ D i := by
    intro x
    obtain ⟨z, hzt, hxz⟩ := Set.mem_iUnion₂.mp (ht (Set.mem_univ x))
    let S : Finset (Fin m) := Finset.univ.filter (fun i => x ∈ V (zs i))
    have hi0 : zs (t.equivFin ⟨z, hzt⟩) = z := by
      simp only [zs, Equiv.symm_apply_apply]
    have hne : S.Nonempty := ⟨t.equivFin ⟨z, hzt⟩, by
      simp only [S, Finset.mem_filter, Finset.mem_univ, true_and, hi0]
      exact hxz⟩
    refine ⟨S.min' hne, (Finset.mem_filter.mp (S.min'_mem hne)).2, ?_⟩
    intro hx
    obtain ⟨j, hj, hxj⟩ := Set.mem_iUnion₂.mp hx
    have := S.min'_le j (by simp only [S, Finset.mem_filter, Finset.mem_univ, true_and]; exact hxj)
    exact absurd (show j < S.min' hne from hj) (not_lt.mpr this)

  let D' : Fin m → X.Opens := fun i => ⟨D i, (hD i).isOpen⟩
  have hle : ∀ i, D' i ≤ W (zs i) := fun i x hx => hVW (zs i) (hDsub i hx)
  let c' : ∀ i, Γ(X, D' i) := fun i => (X.presheaf.map (homOfLE (hle i)).op).hom (c (zs i))
  have hc' : ∀ i, c' i ^ ℓ = (X.presheaf.map (homOfLE (le_top : D' i ≤ ⊤)).op).hom a := by
    intro i
    show ((X.presheaf.map (homOfLE (hle i)).op).hom (c (zs i))) ^ ℓ = _
    rw [← map_pow, hcW, ← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Functor.map_comp]
    rfl
  have hdisj' : ∀ i j, i ≠ j → D' i ⊓ D' j = ⊥ := by
    intro i j hij
    apply TopologicalSpace.Opens.ext
    rw [TopologicalSpace.Opens.coe_inf, TopologicalSpace.Opens.coe_bot]
    exact Set.disjoint_iff_inter_eq_empty.mp (hdisj i j hij)
  have hcov : (⊤ : X.Opens) ≤ iSup D' := by
    intro x _
    rw [TopologicalSpace.Opens.mem_iSup]
    exact hcovD x
  have hcompat : TopCat.Presheaf.IsCompatible X.sheaf.obj D' c' := by
    intro i j
    by_cases hij : i = j
    · subst hij
      rfl
    · haveI := CommRingCat.subsingleton_of_isTerminal (X.sheaf.isTerminalOfEqEmpty (hdisj' i j hij))
      exact Subsingleton.elim _ _
  obtain ⟨b, hb, -⟩ := TopCat.Sheaf.existsUnique_gluing' X.sheaf D' ⊤
    (fun i => homOfLE le_top) hcov c' hcompat
  refine ⟨b, ?_⟩
  apply TopCat.Sheaf.eq_of_locally_eq' X.sheaf D' ⊤ (fun i => homOfLE le_top) hcov
  intro i
  have e : (X.presheaf.map (homOfLE (le_top : D' i ≤ ⊤)).op).hom b = c' i := hb i
  have key : (X.presheaf.map (homOfLE (le_top : D' i ≤ ⊤)).op).hom ((b : Γ(X, ⊤)) ^ ℓ) =
      (X.presheaf.map (homOfLE (le_top : D' i ≤ ⊤)).op).hom a := by
    refine (RingHom.map_pow _ (b : Γ(X, ⊤)) ℓ).trans ?_
    exact (congrArg (fun y => y ^ ℓ) e).trans (hc' i)
  exact key

theorem wc_qmtm_ew_section_formula {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (hw₁ : w ≫ p = p)
    (Dπ : wcHMPullData T.πi ℓ) (Dp : wcHMPullData p ℓ) (Dτ : wcHMPullData w ℓ)
    (aN : wcSuppObj Dπ ⟶ (wcQmtmPush Dτ).obj (wcSuppObj Dπ)) (has : wcQmtmActSec T Dπ Dτ aN)
    (hφ : wcQmtmHPhi hw₁ Dp Dτ) (Vt : (Spec (.of B)).ProEt) :
    ∃ Ξ : Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi ⟶
        Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi,
      Ξ ≫ Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi =
        Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi ≫
          Limits.pullback.lift (Limits.pullback.fst Vt.hom p) (Limits.pullback.snd Vt.hom p ≫ w)
            (by rw [Category.assoc, hw₁]; exact Limits.pullback.condition) ∧
      Ξ ≫ Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi =
        Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi ≫ T.wi ∧
      ((∀ s : C(↥(Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi), ULift.{u+1} ℚ_[ℓ]),
          s.comp Ξ.base.hom = s) →
        ((wcQmtmPush Dp).map aN ≫ (wcQmtmGamma hw₁ Dp Dτ hφ).app (wcSuppObj Dπ)).val.app
          (Opposite.op Vt) = 𝟙 _) :=
by
  classical
  haveI := Dp.cont
  haveI := Dτ.cont
  haveI := Dπ.cont
  haveI : (wcProEtBC p ⋙ wcProEtBC w).IsContinuous
      (Scheme.ProEt.topology (Spec (.of B))) (Scheme.ProEt.topology XE) :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology XE) _
  haveI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) p :=
    ⟨fun _ _ => inferInstance⟩
  haveI : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) p :=
    (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
      (inferInstance : Pr.IsStableUnderBaseChangeAlong p)) (@WeaklyEtale : MorphismProperty Scheme.{u})
  haveI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
    ⟨fun _ _ => inferInstance⟩
  haveI : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
    (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
      (inferInstance : Pr.IsStableUnderBaseChangeAlong w)) (@WeaklyEtale : MorphismProperty Scheme.{u})
  haveI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) T.πi :=
    ⟨fun _ _ => inferInstance⟩
  haveI : MorphismProperty.IsStableUnderBaseChangeAlong
      (@WeaklyEtale : MorphismProperty Scheme.{u}) T.πi :=
    (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
      (inferInstance : Pr.IsStableUnderBaseChangeAlong T.πi))
      (@WeaklyEtale : MorphismProperty Scheme.{u})

  have hL2 : ((wcQmtmAlpha p w hw₁).app Vt).left ≫
      Limits.pullback.fst (Limits.pullback.snd Vt.hom p) w =
        Limits.pullback.lift (Limits.pullback.fst Vt.hom p) (Limits.pullback.snd Vt.hom p ≫ w)
          (by rw [Category.assoc, hw₁]; exact Limits.pullback.condition) := by
    have gen : ∀ {X Y Z : Scheme.{u}} (V : X ⟶ Z) (f : Y ⟶ Z) (w : Y ⟶ Y) (h : w ≫ f = f),
        (Limits.pullback.map V f V (w ≫ f) (𝟙 X) (𝟙 Y) (𝟙 Z) (by simp) (by simp [h]) ≫
          (Limits.pullbackLeftPullbackSndIso V f w).inv) ≫
            Limits.pullback.fst (Limits.pullback.snd V f) w =
          Limits.pullback.lift (Limits.pullback.fst V f) (Limits.pullback.snd V f ≫ w)
            (by rw [Category.assoc, h]; exact Limits.pullback.condition) := by
      intro X Y Z V f w h
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, Limits.pullbackLeftPullbackSndIso_inv_fst,
          Limits.pullback.lift_fst]
        simp
      · simp only [Category.assoc, Limits.pullbackLeftPullbackSndIso_inv_fst_snd,
          Limits.pullback.lift_snd]
        simp only [Limits.pullback.map, Category.comp_id]
        exact Limits.pullback.lift_snd_assoc _ _ _ _
    have hα : ((wcQmtmAlpha p w hw₁).app Vt).left = _ :=
      MorphismProperty.Over.pullbackComp_hom_app_left
        (P := (@WeaklyEtale : MorphismProperty Scheme.{u})) (Q := ⊤) w p p hw₁.symm Vt
    rw [hα]
    exact gen Vt.hom p w hw₁

  obtain ⟨κa, hκ1, hκ2⟩ : ∃ κa : Limits.pullback (Limits.pullback.snd
        (Limits.pullback.snd Vt.hom p) w) T.πi ⟶
      Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi,
      κa ≫ Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi =
        Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd Vt.hom p) w) T.πi ≫
          Limits.pullback.fst (Limits.pullback.snd Vt.hom p) w ∧
      κa ≫ Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi =
        Limits.pullback.snd (Limits.pullback.snd (Limits.pullback.snd Vt.hom p) w) T.πi ≫ T.wi :=
    ⟨Limits.pullback.lift
      (Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd Vt.hom p) w) T.πi ≫
          Limits.pullback.fst (Limits.pullback.snd Vt.hom p) w)
      (Limits.pullback.snd (Limits.pullback.snd (Limits.pullback.snd Vt.hom p) w) T.πi ≫ T.wi)
      (by
        rw [Category.assoc, Category.assoc, T.hwπ,
          Limits.pullback.condition (f := Limits.pullback.snd Vt.hom p) (g := w), ← Category.assoc,
          Limits.pullback.condition (f := Limits.pullback.snd (Limits.pullback.snd Vt.hom p) w)
            (g := T.πi), Category.assoc]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  have hμ0 := MorphismProperty.Over.pullback_map_left (@WeaklyEtale : MorphismProperty Scheme.{u})
    ⊤ T.πi ((wcQmtmAlpha p w hw₁).app Vt)
  obtain ⟨μ, hμ1, hμ2, hμe⟩ : ∃ μ : Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi ⟶
      Limits.pullback (Limits.pullback.snd (Limits.pullback.snd Vt.hom p) w) T.πi,
      μ ≫ Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd Vt.hom p) w) T.πi =
        Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi ≫
          ((wcQmtmAlpha p w hw₁).app Vt).left ∧
      μ ≫ Limits.pullback.snd (Limits.pullback.snd (Limits.pullback.snd Vt.hom p) w) T.πi =
        Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi ∧
      ((wcProEtBC T.πi).map ((wcQmtmAlpha p w hw₁).app Vt)).left = μ := by
    have e : ((wcProEtBC T.πi).map ((wcQmtmAlpha p w hw₁).app Vt)).left = _ := hμ0
    refine ⟨((wcProEtBC T.πi).map ((wcQmtmAlpha p w hw₁).app Vt)).left, ?_, ?_, rfl⟩
    · rw [e]
      exact Limits.pullback.lift_fst _ _ _
    · rw [e]
      exact Limits.pullback.lift_snd _ _ _

  have hL1 : ∀ t : C(↥(Limits.pullback (Limits.pullback.snd (Limits.pullback.snd Vt.hom p) w) T.πi),
      ULift.{u+1} ℚ_[ℓ]),
      (((wcSuppObj Dπ).val.map ((wcQmtmAlpha p w hw₁).app Vt).op).hom t :
        C(↥(Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi), ULift.{u+1} ℚ_[ℓ])) =
        t.comp μ.base.hom := by
    intro t
    rw [← hμe]
    rfl

  have hγ : ∀ y : ↑(((wcQmtmPush Dτ ⋙ wcQmtmPush Dp).obj (wcSuppObj Dπ)).val.obj
      (Opposite.op Vt)),
      (((wcQmtmGamma hw₁ Dp Dτ hφ).app (wcSuppObj Dπ)).val.app (Opposite.op Vt)).hom y =
        ((wcSuppObj Dπ).val.map ((wcQmtmAlpha p w hw₁).app Vt).op).hom y := by
    intro y
    simp only [wcQmtmGamma, NatTrans.comp_app, SheafOfModules.comp_val]
    erw [PresheafOfModules.comp_app]
    erw [ConcreteCategory.comp_apply]
  refine ⟨μ ≫ κa, ?_, ?_, ?_⟩
  · calc (μ ≫ κa) ≫ Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi
        = μ ≫ (κa ≫ Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi) :=
          Category.assoc _ _ _
      _ = μ ≫ (Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd Vt.hom p) w) T.πi ≫
          Limits.pullback.fst (Limits.pullback.snd Vt.hom p) w) := by rw [hκ1]
      _ = (μ ≫ Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd Vt.hom p) w) T.πi) ≫
          Limits.pullback.fst (Limits.pullback.snd Vt.hom p) w := (Category.assoc _ _ _).symm
      _ = (Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi ≫
          ((wcQmtmAlpha p w hw₁).app Vt).left) ≫
          Limits.pullback.fst (Limits.pullback.snd Vt.hom p) w :=
            congrArg (fun k => k ≫ Limits.pullback.fst (Limits.pullback.snd Vt.hom p) w) hμ1
      _ = Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi ≫
          (((wcQmtmAlpha p w hw₁).app Vt).left ≫
          Limits.pullback.fst (Limits.pullback.snd Vt.hom p) w) := Category.assoc _ _ _
      _ = _ := congrArg (fun k => Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi ≫ k) hL2
  · calc (μ ≫ κa) ≫ Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi
        = μ ≫ (κa ≫ Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi) :=
          Category.assoc _ _ _
      _ = μ ≫ (Limits.pullback.snd (Limits.pullback.snd (Limits.pullback.snd Vt.hom p) w) T.πi ≫
          T.wi) := by rw [hκ2]
      _ = (μ ≫ Limits.pullback.snd (Limits.pullback.snd (Limits.pullback.snd Vt.hom p) w) T.πi) ≫
          T.wi := (Category.assoc _ _ _).symm
      _ = Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi ≫ T.wi := by rw [hμ2]
  · intro H
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    let s : C(↥(Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi), ULift.{u+1} ℚ_[ℓ]) := x
    have hA : (((wcQmtmPush Dp).map aN).val.app (Opposite.op Vt)).hom x = s.comp κa.base.hom :=
      has ((wcProEtBC p).obj Vt) s κa hκ1 hκ2
    have hfin : (s.comp κa.base.hom).comp μ.base.hom = s := by
      have h1 := H s
      rw [Scheme.Hom.comp_base, TopCat.hom_comp, ← ContinuousMap.comp_assoc] at h1
      exact h1
    rw [ModuleCat.hom_id, LinearMap.id_apply, SheafOfModules.comp_val, PresheafOfModules.comp_app,
      ModuleCat.hom_comp, LinearMap.comp_apply]
    exact (hγ ((((wcQmtmPush Dp).map aN).val.app (Opposite.op Vt)).hom x)).trans
      ((congrArg (fun y => ((wcSuppObj Dπ).val.map ((wcQmtmAlpha p w hw₁).app Vt).op).hom y)
        hA).trans ((hL1 _).trans hfin))

theorem wc_qmtm_unit_iso_fun_descends {S S' Z : Scheme.{u}} (f : S' ⟶ S) (ι : Z ⟶ S)
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
    (Di : wcHMPullData ι ℓ) (hiso : IsIso (Di.Φ.map (wcQmtmUnit Df)))
    (Vt : S.ProEt)
    (hW7 : ∀ M : SheafOfModules.{u+1} (wcRingSheaf S ℓ),
      Function.Bijective ((Di.adj.unit.app M).val.app (Opposite.op Vt)).hom) :
    ∀ g : C(↥(Limits.pullback Vt.hom f), ULift.{u+1} ℚ_[ℓ]),
      ∃ g₀ : C(↥Vt.left, ULift.{u+1} ℚ_[ℓ]), g = g₀.comp (Limits.pullback.fst Vt.hom f).base.hom :=
by
  intro g
  have hnat := Di.adj.unit_naturality (wcQmtmUnit Df)
  haveI : IsIso (Di.Φ.map (wcQmtmUnit Df)) := hiso
  have hΦ' : Function.Bijective
      (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC ι) _ _ Di.cont Di.φ).map
        (Di.Φ.map (wcQmtmUnit Df))).val.app (Opposite.op Vt)).hom := by
    have : IsIso (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC ι) _ _ Di.cont Di.φ).map
        (Di.Φ.map (wcQmtmUnit Df))).val.app (Opposite.op Vt)) := by
      change IsIso ((SheafOfModules.forget _ ⋙ PresheafOfModules.evaluation _ (Opposite.op Vt)).map
        ((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC ι) _ _ Di.cont Di.φ).map
          (Di.Φ.map (wcQmtmUnit Df))))
      infer_instance
    exact ConcreteCategory.bijective_of_isIso _
  have hsq : ∀ x, (((@SheafOfModules.pushforward _ _ _ _ _ _ (wcProEtBC ι) _ _ Di.cont Di.φ).map
        (Di.Φ.map (wcQmtmUnit Df))).val.app (Opposite.op Vt)).hom
        (((Di.adj.unit.app (SheafOfModules.unit (wcRingSheaf S ℓ))).val.app (Opposite.op Vt)).hom x)
      = ((Di.adj.unit.app ((wcQmtmPush Df).obj (SheafOfModules.unit (wcRingSheaf S' ℓ)))).val.app
          (Opposite.op Vt)).hom (((wcQmtmUnit Df).val.app (Opposite.op Vt)).hom x) := by
    intro x
    have := congrArg (fun h => (h.val.app (Opposite.op Vt)).hom x) hnat
    simpa only [SheafOfModules.comp_val, PresheafOfModules.comp_app, ModuleCat.hom_comp,
      LinearMap.comp_apply] using this
  have h1 := (hW7 (SheafOfModules.unit (wcRingSheaf S ℓ))).2
  have h2 := (hW7 ((wcQmtmPush Df).obj (SheafOfModules.unit (wcRingSheaf S' ℓ)))).1
  obtain ⟨x, hx⟩ := (hΦ'.2.comp h1)
    (((Di.adj.unit.app ((wcQmtmPush Df).obj (SheafOfModules.unit (wcRingSheaf S' ℓ)))).val.app
          (Opposite.op Vt)).hom g)
  have hux : ((wcQmtmUnit Df).val.app (Opposite.op Vt)).hom x = g := by
    apply h2
    rw [← hsq x]
    exact hx
  refine ⟨x, ?_⟩
  rw [← hux]
  have e1 : ((wcQmtmUnit Df).val.app (Opposite.op Vt)).hom x =
      (Df.φ.hom.app (Opposite.op Vt)).hom x := by
    haveI := Df.cont
    exact SheafOfModules.unitToPushforwardObjUnit_val_app_apply _ _
  rw [e1]
  exact hDf Vt x

theorem wc_qmtm_x0_ew_sections_id {A B L : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    [Field L] [IsSepClosed L]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit ((ℓ : ℕ) : A)) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (r : ℕ)
    (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r))))
    (ha₀ : WeaklyEtale a₀)
    (hx0 : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
      (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)))
    (hx1 : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
      (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)))
    (φA : A →+* L) (hφA : Function.Injective φA) (halg : letI := φA.toAlgebra; Algebra.IsAlgebraic A L)
    (σ : L →+* L) (hσ : σ.comp φA = φA) (htame : wcMntTame ℓ φA σ π)
    (XE : Scheme.{u}) (p : XE ⟶ Spec (.of B)) (q : XE ⟶ Spec (.of L))
    (hpb : IsPullback p q (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) (Spec.map (CommRingCat.ofHom φA)))
    (Xs : Scheme.{u}) (ι : Xs ⟶ Spec (.of B)) (s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A)))
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) (wcQmSp A))
    (w : XE ⟶ XE) (hw₁ : w ≫ p = p) (hw₂ : w ≫ q = q ≫ Spec.map (CommRingCat.ofHom σ))
    (T : wcQmtmTower ℓ φA σ p q w (wcQmtmX a₀ ⟨0, by omega⟩))
    (Dπ : wcHMPullData T.πi ℓ) (hDπ : wcHMPullCanonical Dπ)
    (Dp : wcHMPullData p ℓ) (hDp : wcHMPullCanonical Dp)
    (Dτ : wcHMPullData w ℓ) (hDτ : wcHMPullCanonical Dτ)
    (Di : wcHMPullData ι ℓ) (hDi : wcHMPullCanonical Di)
    (γN : wcSuppObj Dπ ⟶ wcSuppObj Dπ) (aN : wcSuppObj Dπ ⟶ (wcQmtmPush Dτ).obj (wcSuppObj Dπ))
    (hγs : wcQmtmGammaSec T Dπ γN) (has : wcQmtmActSec T Dπ Dτ aN)
    (hφ : wcQmtmHPhi hw₁ Dp Dτ)
    (O : Scheme.{u}) (jO : O ⟶ Xs)
    (kO : O ⟶ Spec (.of (Localization.Away (wcQmtmX a₀ ⟨0, by omega⟩))))
    (hO : IsPullback jO kO ι (Spec.map (CommRingCat.ofHom (algebraMap B
      (Localization.Away (wcQmtmX a₀ ⟨0, by omega⟩))))))
    (Vt : (Spec (.of B)).ProEt) [IsAffine Vt.left]
    (hW2 : IsClosed {x : Vt.left | IsClosed ({x} : Set Vt.left)})
    (hW3 : ∀ x : Vt.left, ∃! y : Vt.left, IsClosed ({y} : Set Vt.left) ∧ x ⤳ y)
    (hW5 : ∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
      HenselianLocalRing (Vt.left.presheaf.stalk x) ∧ IsSepClosed (Vt.left.residueField x))
    (hW6 : ∀ v : Vt.left, IsClosed ({v} : Set Vt.left) → Vt.hom v ∈ Set.range (jO ≫ ι))
    (hW7 : ∀ M : SheafOfModules.{u+1} (wcRingSheaf (Spec (.of B)) ℓ),
      Function.Bijective ((Di.adj.unit.app M).val.app (Opposite.op Vt)).hom) :
    ((wcQmtmPush Dp).map aN ≫ (wcQmtmGamma hw₁ Dp Dτ hφ).app (wcSuppObj Dπ)).val.app
      (Opposite.op Vt) = 𝟙 _ :=
by
  classical

  have hℓV : IsUnit ((ℓ : ℕ) : Γ(Vt.left, ⊤)) := by
    have h := hℓ.map (Vt.hom.appTop.hom.comp ((Scheme.ΓSpecIso (.of B)).inv.hom.comp
      ((Spec.preimage a₀).hom.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r))))))
    rwa [map_natCast] at h

  have hx0V : IsUnit (Vt.hom.appTop.hom
      ((Scheme.ΓSpecIso (.of B)).inv.hom (wcQmtmX a₀ ⟨0, by omega⟩))) := by
    apply RingedSpace.isUnit_of_isUnit_germ Vt.left.toRingedSpace ⊤
    intro x _
    have hmem : x ∈ Vt.left.basicOpen (Vt.hom.appTop.hom
        ((Scheme.ΓSpecIso (.of B)).inv.hom (wcQmtmX a₀ ⟨0, by omega⟩))) := by
      obtain ⟨y, ⟨hycl, hxy⟩, -⟩ := hW3 x
      refine hxy.mem_open (Vt.left.basicOpen _).isOpen ?_
      have hb : (Spec (.of B)).basicOpen ((Scheme.ΓSpecIso (.of B)).inv.hom
          (wcQmtmX a₀ ⟨0, by omega⟩)) = PrimeSpectrum.basicOpen (wcQmtmX a₀ ⟨0, by omega⟩) :=
        basicOpen_eq_of_affine _
      have hy' : Vt.hom y ∈ (Spec (.of B)).basicOpen ((Scheme.ΓSpecIso (.of B)).inv.hom
          (wcQmtmX a₀ ⟨0, by omega⟩)) := by
        rw [hb]
        refine (PrimeSpectrum.mem_basicOpen _ _).mpr ?_
        obtain ⟨o, ho⟩ := hW6 y hycl
        have h1 : Vt.hom y = (Spec.map (CommRingCat.ofHom (algebraMap B
            (Localization.Away (wcQmtmX a₀ ⟨0, by omega⟩))))) (kO o) := by
          rw [← ho, hO.w, Scheme.Hom.comp_apply]
        have hu : IsUnit (algebraMap B (Localization.Away (wcQmtmX a₀ ⟨0, by omega⟩))
            (wcQmtmX a₀ ⟨0, by omega⟩)) := IsLocalization.Away.algebraMap_isUnit _
        intro hm
        rw [h1] at hm
        exact (PrimeSpectrum.isPrime (kO o)).ne_top
          ((PrimeSpectrum.asIdeal (kO o)).eq_top_of_isUnit_mem hm hu)
      have hy'' : y ∈ Vt.hom ⁻¹ᵁ (Spec (.of B)).basicOpen ((Scheme.ΓSpecIso (.of B)).inv.hom
          (wcQmtmX a₀ ⟨0, by omega⟩)) := hy'
      have e := Scheme.preimage_basicOpen_top Vt.hom ((Scheme.ΓSpecIso (.of B)).inv.hom
          (wcQmtmX a₀ ⟨0, by omega⟩))
      exact (congrArg (fun U : Vt.left.Opens => y ∈ U) e).mp hy''
    exact (Scheme.mem_basicOpen_top _ _ x).mp hmem

  have hr : ∀ c : {b : Γ(Vt.left, ⊤) // IsUnit b},
      ∃ d : {b : Γ(Vt.left, ⊤) // IsUnit b}, d.1 ^ ℓ = c.1 := by
    intro c
    obtain ⟨b, hb⟩ := wc_qmtm_wlocal_unit_root Vt.left hW2 hW3 hW5 ℓ hℓV c.1 c.2
    refine ⟨⟨b, ?_⟩, hb⟩
    rw [← isUnit_pow_iff (Fact.out : ℓ.Prime).ne_zero, hb]
    exact c.2
  choose fr hfr using hr
  let y : ℕ → Γ(Vt.left, ⊤) := fun k => (fr^[k] ⟨_, hx0V⟩).1
  have hy : ∀ k, y (k + 1) ^ ℓ = y k := by
    intro k
    show (fr^[k + 1] ⟨_, hx0V⟩).1 ^ ℓ = (fr^[k] ⟨_, hx0V⟩).1
    rw [Function.iterate_succ_apply']
    exact hfr _

  haveI : IsAffine XE := IsAffine.of_isIso hpb.isoPullback.hom

  obtain ⟨τ, -, -, hτΞ⟩ := wc_qmtm_tower_triv_homeo T hσ hw₁ Vt y rfl hy

  obtain ⟨Ξ, hΞ1, hΞ2, himp⟩ := wc_qmtm_ew_section_formula T hw₁ Dπ Dp Dτ aN has hφ Vt
  apply himp

  have hiso := wc_qmssl_ci_unit_restr_iso A ℓ hℓ π hπ r B a₀ ha₀ hx0 hx1 L φA hφA halg
    XE p q hpb Xs ι s hps Dp hDp Di hDi
  have hdesc := wc_qmtm_unit_iso_fun_descends p ι ℓ Dp hDp Di hiso Vt hW7

  intro f
  refine ContinuousMap.ext (fun z => ?_)
  obtain ⟨⟨e, a⟩, rfl⟩ : ∃ x, τ x = z := ⟨τ.symm z, τ.apply_symm_apply z⟩
  let g : C(↥(Limits.pullback Vt.hom p), ULift.{u+1} ℚ_[ℓ]) :=
    ⟨fun e' => f (τ (e', a)),
      f.continuous.comp (τ.continuous.comp (continuous_id.prodMk continuous_const))⟩
  obtain ⟨g₀, hg⟩ := hdesc g
  have hpr : (Limits.pullback.fst Vt.hom p) ((Limits.pullback.lift (Limits.pullback.fst Vt.hom p)
      (Limits.pullback.snd Vt.hom p ≫ w)
      (by rw [Category.assoc, hw₁]; exact Limits.pullback.condition)) e) =
      (Limits.pullback.fst Vt.hom p) e := by
    rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_fst]
  have hΞz : Ξ.base.hom (τ (e, a)) = τ ((Limits.pullback.lift (Limits.pullback.fst Vt.hom p)
      (Limits.pullback.snd Vt.hom p ≫ w)
      (by rw [Category.assoc, hw₁]; exact Limits.pullback.condition)) e, a) :=
    hτΞ Ξ hΞ1 hΞ2 e a
  have hge : ∀ e' : ↥(Limits.pullback Vt.hom p), f (τ (e', a)) =
      g₀ ((Limits.pullback.fst Vt.hom p) e') := by
    intro e'
    have := congrArg (fun h : C(↥(Limits.pullback Vt.hom p), ULift.{u+1} ℚ_[ℓ]) => h e') hg
    exact this
  rw [ContinuousMap.comp_apply, hΞz, hge, hpr, ← hge]

theorem wc_padic_shift_diff_right_inverse (ℓ : ℕ) [Fact (Nat.Prime ℓ)] :
    ∃ S : C(ℤ_[ℓ], ℚ_[ℓ]) → C(ℤ_[ℓ], ℚ_[ℓ]), Continuous S ∧
      ∀ (φ : C(ℤ_[ℓ], ℚ_[ℓ])) (x : ℤ_[ℓ]), S φ (x + 1) - S φ x = φ x :=
by

  have : IsBoundedSMul ℤ_[ℓ] ℚ_[ℓ] := IsBoundedSMul.of_norm_smul_le (fun r x => by
    change ‖(r : ℚ_[ℓ]) * x‖ ≤ ‖r‖ * ‖x‖
    rw [norm_mul, PadicInt.padic_norm_e_of_padicInt])

  have tend : ∀ a : ZeroAtInftyContinuousMap ℕ ℚ_[ℓ],
      Filter.Tendsto (⇑a) Filter.atTop (nhds 0) := by
    intro a
    have h := a.zero_at_infty'
    rw [Filter.cocompact_eq_cofinite, Nat.cofinite_eq_atTop] at h
    exact h

  let g : ZeroAtInftyContinuousMap ℕ ℚ_[ℓ] → ℕ → ℚ_[ℓ] := fun a n =>
    match n with
    | 0 => 0
    | k + 1 => a k
  let R : ZeroAtInftyContinuousMap ℕ ℚ_[ℓ] → ZeroAtInftyContinuousMap ℕ ℚ_[ℓ] := fun a =>
    ⟨⟨g a, continuous_of_discreteTopology⟩, by
      show Filter.Tendsto (g a) _ _
      rw [Filter.cocompact_eq_cofinite, Nat.cofinite_eq_atTop,
        ← Filter.tendsto_add_atTop_iff_nat 1]
      exact tend a⟩
  have hRc : Continuous R := by
    apply LipschitzWith.continuous (K := 1)
    apply LipschitzWith.of_dist_le_mul
    intro a a'
    rw [NNReal.coe_one, one_mul, ← ZeroAtInftyContinuousMap.dist_toBCF_eq_dist,
      ← ZeroAtInftyContinuousMap.dist_toBCF_eq_dist,
      BoundedContinuousFunction.dist_le dist_nonneg]
    intro n
    cases n with
    | zero =>
      show dist (0 : ℚ_[ℓ]) 0 ≤ _
      rw [dist_self]
      exact dist_nonneg
    | succ k => exact BoundedContinuousFunction.dist_coe_le_dist (f := a.toBCF) (g := a'.toBCF) k

  refine ⟨fun φ => (PadicInt.mahlerEquiv ℚ_[ℓ]).symm (R (PadicInt.mahlerEquiv ℚ_[ℓ] φ)),
    (PadicInt.mahlerEquiv ℚ_[ℓ]).symm.continuous.comp
      (hRc.comp (PadicInt.mahlerEquiv ℚ_[ℓ]).continuous), ?_⟩
  intro φ x
  show (PadicInt.mahlerEquiv ℚ_[ℓ]).symm (R (PadicInt.mahlerEquiv ℚ_[ℓ] φ)) (x + 1) -
      (PadicInt.mahlerEquiv ℚ_[ℓ]).symm (R (PadicInt.mahlerEquiv ℚ_[ℓ] φ)) x = φ x
  rw [PadicInt.mahlerEquiv_symm_apply]
  have hb := tend (R (PadicInt.mahlerEquiv ℚ_[ℓ] φ))
  have hbf : ∀ n, (R (PadicInt.mahlerEquiv ℚ_[ℓ] φ)) (n + 1) = (fwdDiff 1)^[n] (⇑φ) 0 := by
    intro n
    show (PadicInt.mahlerEquiv ℚ_[ℓ] φ) n = _
    rw [PadicInt.mahlerEquiv_apply]

  have h1 := PadicInt.hasSum_mahlerSeries (p := ℓ) hb
  have hx1 := ContinuousMap.hasSum_apply h1 (x + 1)
  have hx0 := ContinuousMap.hasSum_apply h1 x
  simp only [PadicInt.mahlerTerm_apply, mahler_apply] at hx1 hx0
  have hd := hx1.sub hx0
  rw [← hasSum_nat_add_iff' 1] at hd
  simp only [Finset.range_one, Finset.sum_singleton, Ring.choose_zero_right, sub_self,
    zero_smul, sub_zero, ← sub_smul, Ring.choose_succ_succ, add_sub_cancel_right, hbf] at hd
  have hf := ContinuousMap.hasSum_apply (PadicInt.hasSum_mahler φ) x
  simp only [PadicInt.mahlerTerm_apply, mahler_apply] at hf
  exact hd.unique hf

