    inferInstance a ha rfl
  have hp : (Spec.map (CommRingCat.ofHom ε))
      (IsLocalRing.closedPoint (AlgebraicClosure (Scheme.residueField _
        (a (IsLocalRing.closedPoint C))))) =
      IsLocalRing.closedPoint (IsLocalRing.ResidueField C) :=
    @Subsingleton.elim (PrimeSpectrum (IsLocalRing.ResidueField C)) inferInstance _ _
  have hres : (Spec.map (CommRingCat.ofHom (IsLocalRing.residue C)))
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField C)) = IsLocalRing.closedPoint C := by
    first
      | exact IsLocalRing.comap_closedPoint (IsLocalRing.residue C)
      | (show (Spec.map (CommRingCat.ofHom (IsLocalRing.residue C))).base _ = _
         rw [Spec.map_base]
         exact IsLocalRing.comap_closedPoint (IsLocalRing.residue C))
  have hq : (Spec.map (CommRingCat.ofHom ε) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue C)))
      (IsLocalRing.closedPoint (AlgebraicClosure (Scheme.residueField _
        (a (IsLocalRing.closedPoint C))))) = IsLocalRing.closedPoint C :=
    (Scheme.Hom.comp_apply _ _ _).trans
      ((congrArg (fun p => (Spec.map (CommRingCat.ofHom (IsLocalRing.residue C))) p) hp).trans hres)

  obtain ⟨δ, hδ, -⟩ := @wc_shdata_lift_geom_point _ (a (IsLocalRing.closedPoint C)) B _
    inferInstance Λ _ _ W' φ a_y hsh C _ inferInstance inferInstance a
    (Spec.map (CommRingCat.ofHom ε) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue C))) hq
    ((Category.assoc _ _ _).trans hε)
  haveI hδi : IsIso δ := @wc_pltr_shens_lift_iso _ (a (IsLocalRing.closedPoint C)) B _
    inferInstance inferInstance Λ _ _ W' φ a_y hsh C _ inferInstance a ha rfl δ hδ

  have hψ : Function.Injective ((algebraMap L' (AlgebraicClosure L')).comp φ') :=
    (algebraMap L' (AlgebraicClosure L')).injective.comp hφ'i
  obtain ⟨hfin, hcard, -⟩ := wc_qmssl_double_milnor_et_counts A' ℓ hℓ π' hπ' r
    (a (IsLocalRing.closedPoint C)) hcl hD0 hD1 B Λ W' φ a_y hsh (AlgebraicClosure L')
    ((algebraMap L' (AlgebraicClosure L')).comp φ') hψ

  obtain ⟨E1⟩ := wc_et_coh_iso_invariance hT.isoPullback.hom (ℓ ^ k) 1
  have eq₁ : (a ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) ≫ 𝟙 _ =
      δ ≫ (a_y ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) := by
    rw [Category.comp_id, ← Category.assoc, hδ]
  have eq₂ : Spec.map (CommRingCat.ofHom φ') ≫ 𝟙 _ = 𝟙 _ ≫ Spec.map (CommRingCat.ofHom φ') := by
    simp
  haveI hm1 : IsIso (Limits.pullback.map (a ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom φ')) (a_y ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom φ')) δ (𝟙 _) (𝟙 _) eq₁ eq₂) :=
    Limits.pullback.map_isIso _ _ _ _ _ _ _ _ _
  obtain ⟨E2⟩ := wc_et_coh_iso_invariance (Limits.pullback.map (a ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom φ')) (a_y ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom φ')) δ (𝟙 _) (𝟙 _) eq₁ eq₂) (ℓ ^ k) 1
  obtain ⟨E3⟩ := wc_et_coh_purely_inseparable_invariance L' (AlgebraicClosure L')
    (fun x => Algebra.IsIntegral.isIntegral x) _
    (Limits.pullback.snd (a_y ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom φ'))) (ℓ ^ k) 1
  obtain ⟨E4⟩ := wc_et_coh_iso_invariance (Limits.pullbackLeftPullbackSndIso
    (a_y ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
    (Spec.map (CommRingCat.ofHom φ'))
    (Spec.map (CommRingCat.ofHom (algebraMap L' (AlgebraicClosure L'))))).hom (ℓ ^ k) 1
  have hψS : Spec.map (CommRingCat.ofHom ((algebraMap L' (AlgebraicClosure L')).comp φ')) =
      Spec.map (CommRingCat.ofHom (algebraMap L' (AlgebraicClosure L'))) ≫
        Spec.map (CommRingCat.ofHom φ') := by
    rw [CommRingCat.ofHom_comp, Spec.map_comp]
  obtain ⟨E5⟩ := wc_et_coh_iso_invariance (Limits.pullback.congrHom
    (rfl : a_y ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) = _)
    hψS).hom (ℓ ^ k) 1
  have Eet := E1.symm.trans (E2.symm.trans (E3.symm.trans (E4.symm.trans E5)))

  haveI : IsAffine Pq := IsAffine.of_isIso hT.isoPullback.hom

  obtain ⟨Θ, hΘ, -⟩ := wc_zmod_et_proet_natural_comparison_all (ℓ ^ k) 1
  have hbij := hΘ Pq inferInstance inferInstance
  obtain ⟨Z⟩ := wc_et_zmodext_coh_equiv Pq (ℓ ^ k) 1
  have Tot := (Equiv.ofBijective (Θ Pq) hbij).symm.trans (Z.trans Eet)
  haveI := hfin k 1 hk
  exact ⟨Finite.of_equiv _ Tot.symm, (Nat.card_congr Tot).trans (hcard k hk)⟩

theorem wc_qsfx_prim_root_A : ∀ (A : Type u) [CommRing A] [IsDomain A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (N : ℕ), 0 < N → IsUnit ((N : ℕ) : A) → ∃ ζ : A, IsPrimitiveRoot ζ N :=
by
  intro A _ _ _ _ N hN0 hN
  have hNk : ((N : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
    rw [← map_natCast (IsLocalRing.residue A)]
    exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr hN
  haveI : NeZero ((N : ℕ) : IsLocalRing.ResidueField A) := ⟨hNk⟩
  haveI := IsSepClosed.hasEnoughRootsOfUnity (IsLocalRing.ResidueField A) N
  obtain ⟨zb, hzb⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot (IsLocalRing.ResidueField A) N
  obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective zb
  have hN0' : N ≠ 0 := Nat.pos_iff_ne_zero.mp hN0
  have hmon : (Polynomial.X ^ N - Polynomial.C 1 : Polynomial A).Monic :=
    Polynomial.monic_X_pow_sub_C (1 : A) hN0'
  have hev : ∀ x : A, (Polynomial.X ^ N - Polynomial.C 1 : Polynomial A).eval x = x ^ N - 1 := by
    intro x; simp
  have hder : ∀ x : A, (Polynomial.derivative
      (Polynomial.X ^ N - Polynomial.C 1 : Polynomial A)).eval x = (N : A) * x ^ (N - 1) := by
    intro x; simp [Polynomial.derivative_X_pow]
  have h1 : (Polynomial.X ^ N - Polynomial.C 1 : Polynomial A).eval a₀ ∈
      IsLocalRing.maximalIdeal A := by
    rw [hev, ← IsLocalRing.residue_eq_zero_iff, map_sub, map_pow, map_one, ha₀,
      hzb.pow_eq_one, sub_self]
  have hzb0 : zb ≠ 0 := hzb.ne_zero hN0'
  have ha₀u : IsUnit a₀ :=
    (IsLocalRing.residue_ne_zero_iff_isUnit a₀).mp (by rw [ha₀]; exact hzb0)
  have h2 : IsUnit ((Polynomial.derivative
      (Polynomial.X ^ N - Polynomial.C 1 : Polynomial A)).eval a₀) := by
    rw [hder]; exact hN.mul (ha₀u.pow _)
  obtain ⟨a, ha, ham⟩ := HenselianLocalRing.is_henselian _ hmon a₀ h1 h2
  have haN : a ^ N = 1 := by
    have h3 : (Polynomial.X ^ N - Polynomial.C 1 : Polynomial A).eval a = 0 := ha
    rw [hev] at h3
    exact sub_eq_zero.mp h3
  have hra : IsLocalRing.residue A a = zb := by
    have h4 := (IsLocalRing.residue_eq_zero_iff _).mpr ham
    rw [map_sub, sub_eq_zero] at h4
    rw [h4, ha₀]
  refine ⟨a, ⟨haN, fun l hl => ?_⟩⟩
  apply hzb.dvd_of_pow_eq_one l
  rw [← hra, ← map_pow, hl, map_one]

theorem wc_qsfx_kummer_ses_field : ∀ (Ω : Type u) [Field Ω] (X : Scheme.{u}) (fX : X ⟶ Spec (.of Ω)) (M : ℕ), (M : Ω) ≠ 0 → ∀ ζ : Ω, IsPrimitiveRoot ζ M → ∃ κ : (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))) ⟶ wcEtGmPre X, (∀ (U : X.Etale) (x : ULift.{u+1} (ZMod M)), ((Additive.toMul (κ.app (Opposite.op U) x).down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) = (U.hom.appTop.hom (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom ζ))) ^ x.down.val) ∧ ∃ h : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map κ ≫ (M • 𝟙 (wcEtGm X)) = 0, (ShortComplex.mk ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map κ) (M • 𝟙 (wcEtGm X)) h).ShortExact :=
by
  intro Ω _ X fX M hMΩ ζ hζ
  classical
  have hM0 : M ≠ 0 := fun h => hMΩ (by rw [h, Nat.cast_zero])

  have hkappa : ∃ κ : (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))) ⟶ wcEtGmPre X, (∀ (U : X.Etale) (x : ULift.{u+1} (ZMod M)), ((Additive.toMul (κ.app (Opposite.op U) x).down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) = (U.hom.appTop.hom (fX.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom ζ))) ^ x.down.val) ∧ κ ≫ (M • 𝟙 (wcEtGmPre X)) = 0 ∧ Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology X) κ ∧ ∀ (U : Scheme.Etale X) (s : ToType ((wcEtGmPre X).obj (Opposite.op U))), (M • 𝟙 (wcEtGmPre X)).app (Opposite.op U) s = 0 → Presheaf.imageSieve κ s ∈ Scheme.smallEtaleTopology X U := by
    haveI : NeZero M := ⟨hM0⟩
    haveI : NeZero (M : Ω) := ⟨hMΩ⟩

    have s2 : ∀ (O : Type u) [CommRing O] [IsLocalRing O] (φ : Ω →+* O) (v : O),
        v ^ M = 1 → ∃ k : ℕ, v = φ ζ ^ k := by
      intro O _ _ φ v hv
      let π := IsLocalRing.residue O
      have hinj : Function.Injective (π.comp φ) := (π.comp φ).injective
      have hprim : IsPrimitiveRoot ((π.comp φ) ζ) M := hζ.map_of_injective hinj
      have hπv : π v ^ M = 1 := by rw [← map_pow, hv, map_one]
      obtain ⟨i, -, hiv⟩ := hprim.eq_pow_of_pow_eq_one hπv
      refine ⟨i, ?_⟩
      have hw : (φ ζ ^ i) ^ M = 1 := by
        rw [← pow_mul, mul_comm, pow_mul, ← map_pow, hζ.pow_eq_one, map_one, one_pow]
      have hπw : π (φ ζ ^ i) = π v := by rw [map_pow]; exact hiv
      have hS : (∑ j ∈ Finset.range M, v ^ j * (φ ζ ^ i) ^ (M - 1 - j)) * (v - φ ζ ^ i) = 0 := by
        rw [geom_sum₂_mul, hv, hw, sub_self]
      have hSu : IsUnit (∑ j ∈ Finset.range M, v ^ j * (φ ζ ^ i) ^ (M - 1 - j)) := by
        rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
        have e : π (∑ j ∈ Finset.range M, v ^ j * (φ ζ ^ i) ^ (M - 1 - j)) =
            (M : IsLocalRing.ResidueField O) * π v ^ (M - 1) := by
          rw [map_sum, ← geom_sum₂_self]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [map_mul, map_pow, map_pow, hπw]
        rw [e]
        refine mul_ne_zero ?_ (pow_ne_zero _ ?_)
        · have h1 : (M : IsLocalRing.ResidueField O) = (π.comp φ) (M : Ω) := by rw [map_natCast]
          rw [h1]
          exact (map_ne_zero_iff _ hinj).mpr hMΩ
        · intro h0
          rw [h0, zero_pow hM0] at hπv
          exact zero_ne_one hπv
      exact sub_eq_zero.mp (hSu.mul_right_eq_zero.mp hS)

    have s3 : ∀ (Y : Scheme.{u}) (y : Y) (a b : Γ(Y, ⊤)),
        (Y.presheaf.germ ⊤ y trivial).hom a = (Y.presheaf.germ ⊤ y trivial).hom b →
        ∃ W : Y.Opens, y ∈ W ∧ W.ι.appTop.hom a = W.ι.appTop.hom b := by
      intro Y y a b h
      obtain ⟨W, hyW, iU, iV, e⟩ :=
        TopCat.Presheaf.germ_eq (U := ⊤) (V := ⊤) Y.presheaf y trivial trivial a b h
      refine ⟨W, hyW, ?_⟩
      obtain rfl : iV = iU := Subsingleton.elim _ _
      have e' : (Y.presheaf.map iV.op).hom a = (Y.presheaf.map iV.op).hom b := e
      have gen : ∀ (V : Y.Opens) (j : V ⟶ ⊤), V ≤ W →
          (Y.presheaf.map j.op).hom a = (Y.presheaf.map j.op).hom b := by
        intro V j hVW
        obtain rfl : j = homOfLE hVW ≫ iV := Subsingleton.elim _ _
        rw [op_comp, Functor.map_comp, CommRingCat.comp_apply, CommRingCat.comp_apply, e']
      rw [Scheme.Opens.ι_appTop]
      exact gen _ _ (by simp)

    have hcov : ∀ (V : X.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : X.Etale) (c : V₁ ⟶ V),
        S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X V := by
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale X V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    have hG3 : ∀ (U : X.Etale) (a b : ToType ((wcEtGmPre X).obj (Opposite.op U))),
        ((Additive.toMul a.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) =
          ((Additive.toMul b.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) → a = b :=
      fun U a b h => ULift.ext _ _ (Additive.toMul.injective (Units.ext h))
    let cX : Ω →+* Γ(X, ⊤) := fX.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
    let ψ : ∀ U : X.Etale, Ω →+* Γ(U.left, ⊤) := fun U => U.hom.appTop.hom.comp cX
    have hψnat : ∀ (U V : X.Etale) (f : V ⟶ U) (a : Ω), f.left.appTop.hom (ψ U a) = ψ V a := by
      intro U V f a
      have hw : f.left ≫ U.hom = V.hom := MorphismProperty.Over.w f
      simp only [ψ, RingHom.comp_apply]
      rw [← hw, Scheme.Hom.comp_appTop]
      rfl
    have hζmod : ∀ (m : ℕ), ζ ^ m = ζ ^ (m % M) := fun m => by
      conv_lhs => rw [← Nat.div_add_mod m M, pow_add, pow_mul, hζ.pow_eq_one, one_pow, one_mul]
    have hζu : IsUnit ζ := hζ.isUnit hM0
    let zU : ∀ U : X.Etale, (Γ(U.left, ⊤))ˣ := fun U => Units.map (ψ U).toMonoidHom hζu.unit
    have hzU : ∀ U : X.Etale, ((zU U : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) = ψ U ζ := fun U => by
      simp [zU]
    have hzpow : ∀ (U : X.Etale) (m : ℕ), ((zU U ^ m : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) = ψ U ζ ^ m :=
      fun U m => by rw [Units.val_pow_eq_pow_val, hzU]
    have hψmod : ∀ (U : X.Etale) (m : ℕ), ψ U ζ ^ m = ψ U ζ ^ (m % M) := fun U m => by
      rw [← map_pow, ← map_pow, ← hζmod]
    have hzmod : ∀ (U : X.Etale) (m : ℕ), zU U ^ m = zU U ^ (m % M) := fun U m => by
      ext
      rw [hzpow, hzpow, ← hψmod]
    let κf : ∀ U : X.Etale, ULift.{u+1} (ZMod M) →+ ULift.{u+1} (Additive (Γ(U.left, ⊤))ˣ) :=
      fun U => AddMonoidHom.mk' (fun x => ULift.up (Additive.ofMul (zU U ^ x.down.val))) (by
        intro a b
        apply ULift.ext
        apply Additive.toMul.injective
        change zU U ^ (a.down + b.down).val = zU U ^ a.down.val * zU U ^ b.down.val
        rw [ZMod.val_add, ← hzmod, pow_add])
    let κ : (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M))) ⟶
        wcEtGmPre X :=
      { app := fun U => AddCommGrpCat.ofHom (κf U.unop)
        naturality := by
          intro U V f
          ext x
          apply hG3 V.unop
          change ((zU V.unop ^ x.down.val : (Γ(V.unop.left, ⊤))ˣ) : Γ(V.unop.left, ⊤)) =
            f.unop.left.appTop.hom ((zU U.unop ^ x.down.val : (Γ(U.unop.left, ⊤))ˣ) : Γ(U.unop.left, ⊤))
          rw [hzpow, hzpow, map_pow, hψnat] }
    have hκv : ∀ (U : X.Etale) (x : ULift.{u+1} (ZMod M)),
        ((Additive.toMul (κ.app (Opposite.op U) x).down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) =
          ψ U ζ ^ x.down.val := fun U x => hzpow U x.down.val
    refine ⟨κ, hκv, ?_, ?_, ?_⟩
    ·
      rw [Preadditive.comp_nsmul, Category.comp_id]
      ext U x
      simp only [NatTrans.app_nsmul, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
        AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply, AddMonoidHom.zero_apply]
      apply ULift.ext
      apply Additive.toMul.injective
      change (zU U.unop ^ x.down.val) ^ M = 1
      rw [← pow_mul, mul_comm, pow_mul, hzmod U.unop M, Nat.mod_self, pow_zero, one_pow]
    ·
      refine ⟨fun {U'} x y hxy => ?_⟩
      obtain ⟨U⟩ := U'
      rcases isEmpty_or_nonempty U.left with hE | ⟨⟨y₀⟩⟩
      · exact hcov _ _ (fun v => isEmptyElim v)
      · haveI : Nontrivial Γ(U.left, ⊤) := @Scheme.component_nontrivial U.left ⊤ ⟨⟨y₀, trivial⟩⟩
        have hinj : Function.Injective (ψ U) := (ψ U).injective
        have hprim := hζ.map_of_injective hinj
        have h1 : ψ U ζ ^ x.down.val = ψ U ζ ^ y.down.val := by
          rw [← hκv U x, ← hκv U y]
          exact congrArg (fun t : ToType ((wcEtGmPre X).obj (Opposite.op U)) =>
            ((Additive.toMul t.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤))) hxy
        have hval := hprim.pow_inj (ZMod.val_lt _) (ZMod.val_lt _) h1
        have hxy' : x = y := ULift.ext _ _ (ZMod.val_injective _ hval)
        subst hxy'
        rw [Presheaf.equalizerSieve_self_eq_top]
        exact (Scheme.smallEtaleTopology X).top_mem _
    ·
      intro U s hs
      have hs' : M • s = 0 := by
        first
          | exact hs
          | simpa using hs
      have hv : ((Additive.toMul s.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)) ^ M = 1 :=
        congrArg (fun t : ToType ((wcEtGmPre X).obj (Opposite.op U)) =>
            ((Additive.toMul t.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤))) hs'
      refine hcov U _ (fun y => ?_)
      obtain ⟨k, hk⟩ := s2 (U.left.presheaf.stalk y)
        ((U.left.presheaf.germ ⊤ y trivial).hom.comp (ψ U))
        ((U.left.presheaf.germ ⊤ y trivial).hom
          ((Additive.toMul s.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤)))
        (by rw [← map_pow, hv, map_one])
      rw [RingHom.comp_apply, ← map_pow] at hk
      obtain ⟨W, hyW, hW⟩ := s3 U.left y _ _ hk
      let V₁ : X.Etale := MorphismProperty.Over.mk ⊤ (W.ι ≫ U.hom) inferInstance
      let c : V₁ ⟶ U := MorphismProperty.Over.homMk W.ι rfl trivial
      refine ⟨V₁, c, ⟨ULift.up (k : ZMod M), ?_⟩, ?_⟩
      · apply hG3 V₁
        rw [hκv]
        change _ = W.ι.appTop.hom ((Additive.toMul s.down : (Γ(U.left, ⊤))ˣ) : Γ(U.left, ⊤))
        rw [hW, map_pow, show W.ι.appTop.hom (ψ U ζ) = ψ V₁ ζ from hψnat U V₁ c ζ,
          ZMod.val_natCast]
        exact (hψmod V₁ k).symm
      · exact ⟨⟨y, hyW⟩, rfl⟩

  have hsurjM : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) (M • 𝟙 (wcEtGmPre X)) := by

    have s2 : ∀ (R : Type u) [CommRing R], IsUnit (M : R) → ∀ a : R, IsUnit a →
        ∃ (B : Type u) (_ : CommRing B) (_ : Algebra R B), Algebra.Etale R B ∧
          Function.Surjective (PrimeSpectrum.comap (algebraMap R B)) ∧
          ∃ t : B, t ^ M = algebraMap R B a := by
      intro R _ hMR a ha
      set f : Polynomial R := Polynomial.X ^ M - Polynomial.C a with hf
      have hfm : f.Monic := Polynomial.monic_X_pow_sub_C a hM0
      obtain ⟨u, hu⟩ := (hMR.mul ha).exists_left_inv
      have hcert : ∃ (p₁ p₂ : Polynomial R) (n : ℕ),
          Polynomial.derivative f * p₁ + f * p₂ = (1 : Polynomial R) ^ n := by
        refine ⟨Polynomial.C u * Polynomial.X, -(Polynomial.C u * Polynomial.C (M : R)), 1, ?_⟩
        have hd : Polynomial.derivative f = Polynomial.C (M : R) * Polynomial.X ^ (M - 1) := by
          rw [hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
            sub_zero]
        have hX : Polynomial.X ^ (M - 1) * Polynomial.X = (Polynomial.X : Polynomial R) ^ M :=
          pow_sub_one_mul hM0 Polynomial.X
        have hu' : Polynomial.C u * (Polynomial.C (M : R) * Polynomial.C a) = 1 := by
          rw [← map_mul, ← map_mul, hu, map_one]
        rw [hd, hf, pow_one]
        linear_combination hu' + (Polynomial.C u * Polynomial.C (M : R)) * hX
      let P : StandardEtalePair R := ⟨f, hfm, 1, hcert⟩
      have e₂ : AdjoinRoot f ≃ₐ[R] Localization.Away ((AdjoinRoot.mk f) 1) :=
        (IsLocalization.atUnit (AdjoinRoot f) (Localization.Away ((AdjoinRoot.mk f) 1))
          ((AdjoinRoot.mk f) 1) (by simp)).restrictScalars R
      have e : P.Ring ≃ₐ[R] AdjoinRoot f := P.equivAwayAdjoinRoot.trans e₂.symm
      have het : Algebra.Etale R (AdjoinRoot f) := Algebra.Etale.of_equiv e
      refine ⟨AdjoinRoot f, inferInstance, inferInstance, het, ?_, AdjoinRoot.root f, ?_⟩
      · rcases subsingleton_or_nontrivial R with hR | hR
        · have : IsEmpty (PrimeSpectrum R) := PrimeSpectrum.isEmpty_iff_subsingleton.mpr hR
          intro x
          exact isEmptyElim x
        · have : Module.Free R (AdjoinRoot f) := hfm.free_adjoinRoot
          let pb := AdjoinRoot.powerBasis' hfm
          have hdim : 0 < pb.dim := by
            rw [AdjoinRoot.powerBasis'_dim, hf, Polynomial.natDegree_X_pow_sub_C]
            exact Nat.pos_of_ne_zero hM0
          have : Nontrivial (AdjoinRoot f) := nontrivial_of_ne _ _ (pb.basis.ne_zero ⟨0, hdim⟩)
          exact PrimeSpectrum.comap_surjective_of_faithfullyFlat
      · have h1 : Polynomial.aeval (AdjoinRoot.root f) f = 0 := by
          rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]
        rw [hf, map_sub, Polynomial.aeval_X_pow, Polynomial.aeval_C] at h1
        exact sub_eq_zero.mp h1

    have s3 : ∀ (Y : Scheme.{u}) (B : Type u) [CommRing B] [Algebra Γ(Y, ⊤) B],
        Algebra.Etale Γ(Y, ⊤) B → Function.Surjective (PrimeSpectrum.comap (algebraMap Γ(Y, ⊤) B)) →
        ∃ (V : Scheme.{u}) (p : V ⟶ Y) (ψ : B →+* Γ(V, ⊤)), Etale p ∧ Function.Surjective p ∧
          ∀ r : Γ(Y, ⊤), ψ (algebraMap Γ(Y, ⊤) B r) = p.appTop.hom r := by
      intro Y B _ _ hB hsurj
      let φ : CommRingCat.of Γ(Y, ⊤) ⟶ CommRingCat.of B := CommRingCat.ofHom (algebraMap Γ(Y, ⊤) B)
      let g : Spec (CommRingCat.of B) ⟶ Spec (CommRingCat.of Γ(Y, ⊤)) := Spec.map φ
      have hg : Etale g := by
        apply (HasRingHomProperty.Spec_iff (P := @Etale)).mpr
        rw [CommRingCat.hom_ofHom]
        exact RingHom.etale_algebraMap.mpr hB
      have hgs : Surjective g := by
        constructor
        exact hsurj
      let p := Limits.pullback.fst Y.toSpecΓ g
      let q := Limits.pullback.snd Y.toSpecΓ g
      refine ⟨Limits.pullback Y.toSpecΓ g, p,
        ((Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ q.appTop).hom,
        inferInstance, p.surjective, fun r => ?_⟩
      have hc : Y.toSpecΓ.appTop ≫ p.appTop = g.appTop ≫ q.appTop := by
        rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, Limits.pullback.condition]
      have hn := Scheme.ΓSpecIso_inv_naturality φ
      have key : φ ≫ (Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫ q.appTop = p.appTop := by
        rw [← Category.assoc, hn, Category.assoc, ← hc, Scheme.toSpecΓ_appTop]
        exact Iso.inv_hom_id_assoc _ _
      exact congrArg (fun h => h.hom r) key

    have hcov : ∀ (V : X.Etale) (S : Sieve V), (∀ v : V.left, ∃ (V₁ : X.Etale) (c : V₁ ⟶ V),
        S.arrows c ∧ v ∈ Set.range c.left) → S ∈ Scheme.smallEtaleTopology X V := by
      intro V S hS
      change S ∈ Scheme.smallGrothendieckTopology @Etale X V
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
      apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
      intro x
      obtain ⟨V₁, c, hc, y, hy⟩ := hS x
      have hw : c.left ≫ V.hom = V₁.hom := MorphismProperty.Over.w c
      have hEt : Etale c.left := by
        have h1 : Etale V.hom := V.prop
        have h2 : Etale (c.left ≫ V.hom) := by rw [hw]; exact V₁.prop
        exact Etale.of_comp c.left V.hom
      exact ⟨V₁, c, y, hc, hEt, hy⟩
    refine Presheaf.IsLocallySurjective.mk (fun {U} s => ?_)
    let aU : (Γ(U.left, ⊤))ˣ := Additive.toMul s.down
    let cU : Ω →+* Γ(U.left, ⊤) :=
      ((U.hom ≫ fX).appTop).hom.comp (Scheme.ΓSpecIso (CommRingCat.of Ω)).inv.hom
    have hMR : IsUnit (M : Γ(U.left, ⊤)) := by
      rw [← map_natCast cU]
      exact (Ne.isUnit hMΩ).map cU
    obtain ⟨B, _, _, hBet, hBsurj, t, ht⟩ := s2 Γ(U.left, ⊤) hMR (aU : Γ(U.left, ⊤)) aU.isUnit
    obtain ⟨V, p, ψ, hpet, hpsurj, hψ⟩ := s3 U.left B hBet hBsurj
    have hT : ψ t ^ M = p.appTop.hom (aU : Γ(U.left, ⊤)) := by rw [← map_pow, ht, hψ]
    have hTu : IsUnit (ψ t) := by
      have h1 : IsUnit (ψ t ^ M) := by rw [hT]; exact aU.isUnit.map _
      exact (isUnit_pow_iff hM0).mp h1
    haveI := hpet
    let V₁ : X.Etale := MorphismProperty.Over.mk ⊤ (p ≫ U.hom) inferInstance
    let c : V₁ ⟶ U := MorphismProperty.Over.homMk p rfl trivial
    have hc : (Presheaf.imageSieve (M • 𝟙 (wcEtGmPre X)) s).arrows c := by
      refine ⟨ULift.up (Additive.ofMul hTu.unit), ?_⟩
      simp only [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.hom_nsmul,
        AddMonoidHom.nsmul_apply, AddCommGrpCat.hom_id, AddMonoidHom.id_apply]
      apply ULift.ext
      apply Additive.toMul.injective
      apply Units.ext
      change ((hTu.unit ^ M : (Γ(V, ⊤))ˣ) : Γ(V, ⊤)) = p.appTop.hom (aU : Γ(U.left, ⊤))
      rw [Units.val_pow_eq_pow_val, IsUnit.unit_spec, hT]
    exact hcov U _ (fun v => ⟨V₁, c, hc, hpsurj v⟩)

  have hA : ∀ (P₁ P₂ P₃ : (Scheme.Etale X)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (f : P₁ ⟶ P₂) (g : P₂ ⟶ P₃),
      f ≫ g = 0 → Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology X) f →
      (∀ (U : Scheme.Etale X) (s : ToType (P₂.obj (Opposite.op U))),
        g.app (Opposite.op U) s = 0 → Presheaf.imageSieve f s ∈ Scheme.smallEtaleTopology X U) →
      Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X) g →
      ∀ (g' : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj P₂ ⟶
          (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj P₃),
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g = g' →
        ∃ h : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f ≫ g' = 0,
          (ShortComplex.mk ((presheafToSheaf (Scheme.smallEtaleTopology X)
            AddCommGrpCat.{u+1}).map f) g' h).ShortExact := by
    intro P₁ P₂ P₃ f g hfg hinj hex hsurj g' hg'
    subst hg'
    have h : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f ≫
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g = 0 := by
      rw [← Functor.map_comp, hfg, Functor.map_zero]
    refine ⟨h, ?_⟩
    have hmono : Mono ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) := by
      haveI : Sheaf.IsLocallyInjective
          ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) :=
        (Presheaf.isLocallyInjective_presheafToSheaf_map_iff _ f).mpr hinj
      exact Sheaf.mono_of_isLocallyInjective _
    have hepi : Epi ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g) := by
      rw [← Sheaf.isLocallySurjective_iff_epi']
      exact (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ g).mpr hsurj
    refine ShortComplex.ShortExact.mk' ?_ hmono hepi
    rw [ShortComplex.exact_iff_epi_kernel_lift]
    have hk : Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology X)
        (Limits.kernel.lift g f hfg) := by
      refine Presheaf.IsLocallySurjective.mk (fun {U} s => ?_)
      have ht : g.app (Opposite.op U) ((Limits.kernel.ι g).app (Opposite.op U) s) = 0 := by
        rw [← ConcreteCategory.comp_apply, ← NatTrans.comp_app, Limits.kernel.condition]
        rfl
      refine GrothendieckTopology.superset_covering _ ?_ (hex U _ ht)
      intro V φ hφ
      obtain ⟨r, hr⟩ := hφ
      refine ⟨r, ?_⟩
      have hm : Mono ((Limits.kernel.ι g).app (Opposite.op V)) :=
        (NatTrans.mono_iff_mono_app _).mp inferInstance _
      apply (AddCommGrpCat.mono_iff_injective _).mp hm
      rw [← ConcreteCategory.comp_apply, ← NatTrans.comp_app, Limits.kernel.lift_ι, hr,
        ← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, NatTrans.naturality]
    have hkF : Epi ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
        (Limits.kernel.lift g f hfg)) := by
      rw [← Sheaf.isLocallySurjective_iff_epi']
      exact (Presheaf.isLocallySurjective_presheafToSheaf_map_iff _ _).mpr hk
    have heq : Limits.kernel.lift
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g)
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) h =
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
          (Limits.kernel.lift g f hfg) ≫
        (Limits.PreservesKernel.iso
          (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) g).hom := by
      rw [Limits.PreservesKernel.iso_hom, Limits.map_lift_kernelComparison]
    change Epi (Limits.kernel.lift
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map g)
        ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map f) h)
    rw [heq]
    exact epi_comp _ _

  have hmap : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map
      (M • 𝟙 (wcEtGmPre X)) = M • 𝟙 (wcEtGm X) := by
    rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rfl

  obtain ⟨κ, hκf, h0, hinj, hex⟩ := hkappa
  obtain ⟨h, hS⟩ := hA _ _ _ κ (M • 𝟙 (wcEtGmPre X)) h0 hinj hex
    hsurjM (M • 𝟙 (wcEtGm X)) hmap
  exact ⟨κ, hκf, h, hS⟩

theorem wc_qsfx_unit_class : ∀ (X : Scheme.{u}) (v : (Γ(X, ⊤))ˣ), ∃ β : (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ wcEtGmPre X, (∀ (U : X.Etale) (n : ULift.{u+1} ℤ), (Additive.toMul (β.app (Opposite.op U) n).down : (Γ(U.left, ⊤))ˣ) = (Units.map U.hom.appTop.hom.toMonoidHom v) ^ n.down) ∧ ∀ (h : (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj ((Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ⟶ wcEtGm X) (m j : ℕ), h ≫ (m • 𝟙 (wcEtGm X)) = j • (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map β → ∃ w : (Γ(X, ⊤))ˣ, w ^ m = v ^ j :=
by
  intro X v

  have hG : Presheaf.IsSheaf (Scheme.smallEtaleTopology X) (wcEtGmPre X) := by
    have s2a : Scheme.etaleTopology.{u} ≤ Scheme.fpqcTopology.{u} := by
      apply Precoverage.toGrothendieck_mono
      apply le_inf
      · apply Scheme.precoverage_le_qcPrecoverage_of_isOpenMap
        intro X Y f hf
        have := hf
        exact f.isOpenMap
      · apply Scheme.precoverage_mono
        intro X Y f hf
        have := hf
        infer_instance
    have s2b : Presieve.IsSheaf Scheme.fpqcTopology.{u} (Scheme.Γ ⋙ forget CommRingCat.{u}) := by
      let A1 : Scheme.{u} := Spec (CommRingCat.of (MvPolynomial PUnit.{u+1} (ULift.{u} ℤ)))
      let e : yoneda.obj A1 ≅ Scheme.Γ ⋙ forget CommRingCat.{u} :=
        NatIso.ofComponents (fun T => Equiv.toIso
          ((AffineSpace.toSpecMvPolyIntEquiv PUnit.{u+1} (X := T.unop)).trans
            (Equiv.funUnique PUnit.{u+1} _))) (by
          intro T T' g
          ext h
          exact AffineSpace.toSpecMvPolyIntEquiv_comp PUnit.{u+1} g.unop h PUnit.unit)
      exact Presieve.isSheaf_iso Scheme.fpqcTopology e
        (GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable (yoneda.obj A1))
    have s3 : ∀ (F : Scheme.{u}ᵒᵖ ⥤ Type u), Presieve.IsSheaf Scheme.etaleTopology F →
        Presieve.IsSheaf (Scheme.smallEtaleTopology X)
          ((Scheme.Etale.forget X ⋙ Over.forget X).op ⋙ F) := by
      intro F hF U S hS x hx
      have hSurj : ∀ y : U.left, ∃ (Y : X.Etale) (g : Y ⟶ U) (w : Y.left),
          S.arrows g ∧ g.left w = y := by
        change S ∈ Scheme.smallGrothendieckTopology @Etale X U at hS
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale X
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hS
        intro y
        obtain ⟨Y, g, w, hg, -, hw⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale X
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ U S).mp hS y
        exact ⟨Y, g, w, hg, hw⟩
      let ι := Σ (Y : X.Etale), {f : Y ⟶ U // S.arrows f}
      have hR : Presieve.ofArrows (fun i : ι => i.1.left) (fun i => i.2.1.left) ∈
          (Scheme.precoverage @Etale).coverings U.left := by
        refine (Scheme.ofArrows_mem_precoverage_iff @Etale).mpr ⟨fun y => ?_, fun i => inferInstance⟩
        obtain ⟨Y, g, w, hg, hw⟩ := hSurj y
        exact ⟨⟨Y, g, hg⟩, w, hw⟩
      have hgen : Sieve.generate (Presieve.ofArrows (fun i : ι => i.1.left) (fun i => i.2.1.left)) ∈
          Scheme.etaleTopology U.left := Precoverage.generate_mem_toGrothendieck hR
      have hsf := (Presieve.isSheafFor_arrows_iff F (fun i : ι => i.2.1.left)).mp
        ((Presieve.isSheafFor_iff_generate _).mpr (hF _ hgen))
      let z : ∀ i : ι, F.obj (Opposite.op i.1.left) := fun i => x i.2.1 i.2.2
      have hz : Presieve.Arrows.Compatible F (fun i : ι => i.2.1.left) z := by
        rintro ⟨Y₁, f₁, h₁⟩ ⟨Y₂, f₂, h₂⟩ Z gi gj e
        haveI hEt : Etale (Limits.pullback.fst f₁.left f₂.left ≫ Y₁.hom) := by
          haveI : Etale Y₁.hom := Y₁.prop
          infer_instance
        let P : X.Etale :=
          MorphismProperty.Over.mk ⊤ (Limits.pullback.fst f₁.left f₂.left ≫ Y₁.hom) hEt
        have hw : Limits.pullback.snd f₁.left f₂.left ≫ Y₂.hom =
            Limits.pullback.fst f₁.left f₂.left ≫ Y₁.hom := by
          rw [← MorphismProperty.Over.w f₁, ← MorphismProperty.Over.w f₂, ← Category.assoc,
            ← Category.assoc, Limits.pullback.condition]
        let p₁ : P ⟶ Y₁ :=
          MorphismProperty.Over.homMk (Limits.pullback.fst f₁.left f₂.left) rfl trivial
        let p₂ : P ⟶ Y₂ :=
          MorphismProperty.Over.homMk (Limits.pullback.snd f₁.left f₂.left) hw trivial
        have hcomm : p₁ ≫ f₁ = p₂ ≫ f₂ := by
          apply MorphismProperty.Over.Hom.ext
          change Limits.pullback.fst f₁.left f₂.left ≫ f₁.left =
            Limits.pullback.snd f₁.left f₂.left ≫ f₂.left
          exact Limits.pullback.condition
        have hc : F.map (Limits.pullback.fst f₁.left f₂.left).op (z ⟨Y₁, f₁, h₁⟩) =
            F.map (Limits.pullback.snd f₁.left f₂.left).op (z ⟨Y₂, f₂, h₂⟩) :=
          hx p₁ p₂ h₁ h₂ hcomm
        let l := Limits.pullback.lift gi gj e
        change F.map gi.op (z ⟨Y₁, f₁, h₁⟩) = F.map gj.op (z ⟨Y₂, f₂, h₂⟩)
        calc F.map gi.op (z ⟨Y₁, f₁, h₁⟩)
            = F.map (l ≫ Limits.pullback.fst f₁.left f₂.left).op (z ⟨Y₁, f₁, h₁⟩) := by
              rw [Limits.pullback.lift_fst]
          _ = F.map l.op (F.map (Limits.pullback.fst f₁.left f₂.left).op (z ⟨Y₁, f₁, h₁⟩)) := by
              rw [op_comp, FunctorToTypes.map_comp_apply]
          _ = F.map l.op (F.map (Limits.pullback.snd f₁.left f₂.left).op (z ⟨Y₂, f₂, h₂⟩)) := by
              rw [hc]
          _ = F.map (l ≫ Limits.pullback.snd f₁.left f₂.left).op (z ⟨Y₂, f₂, h₂⟩) := by
              rw [op_comp, FunctorToTypes.map_comp_apply]
          _ = F.map gj.op (z ⟨Y₂, f₂, h₂⟩) := by
              rw [Limits.pullback.lift_snd]
      obtain ⟨t, ht, huniq⟩ := hsf z hz
      exact ⟨t, fun Y f hf => ht ⟨Y, f, hf⟩, fun y hy => huniq y (fun i => hy i.2.1 i.2.2)⟩
    have s4 : ∀ (J : GrothendieckTopology X.Etale) (R : (X.Etale)ᵒᵖ ⥤ CommRingCat.{u}),
        Presieve.IsSheaf J (R ⋙ forget CommRingCat.{u}) →
        Presieve.IsSheaf J (R ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
          CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u} ⋙
            forget AddCommGrpCat.{u+1}) := by
      intro J R hR V S hS x hx
      have hP := hR S hS
      let Q := R ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
          CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u} ⋙
            forget AddCommGrpCat.{u+1}
      let P := R ⋙ forget CommRingCat.{u}
      let val : ∀ (W : (X.Etale)ᵒᵖ), Q.obj W → P.obj W :=
        fun W a => ((Additive.toMul (ULift.down a) : (R.obj W)ˣ) : R.obj W)
      let ival : ∀ (W : (X.Etale)ᵒᵖ), Q.obj W → P.obj W :=
        fun W a => (((Additive.toMul (ULift.down a) : (R.obj W)ˣ)⁻¹ : (R.obj W)ˣ) : R.obj W)
      have hmap : ∀ {W W' : (X.Etale)ᵒᵖ} (g : W ⟶ W') (a : Q.obj W),
          val W' (Q.map g a) = P.map g (val W a) := fun g a => rfl
      have hmapi : ∀ {W W' : (X.Etale)ᵒᵖ} (g : W ⟶ W') (a : Q.obj W),
          ival W' (Q.map g a) = P.map g (ival W a) := fun g a => rfl
      have hext : ∀ {W : (X.Etale)ᵒᵖ} (a b : Q.obj W), val W a = val W b → a = b := by
        intro W a b h
        apply ULift.ext
        apply Additive.toMul.injective
        exact Units.ext h
      let a : Presieve.FamilyOfElements P S.arrows := fun Y f hf => val _ (x f hf)
      let b : Presieve.FamilyOfElements P S.arrows := fun Y f hf => ival _ (x f hf)
      have ha : a.Compatible := by
        intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
        change P.map g₁.op (val _ (x f₁ h₁)) = P.map g₂.op (val _ (x f₂ h₂))
        rw [← hmap, ← hmap]
        exact congrArg (val _) (hx g₁ g₂ h₁ h₂ comm)
      have hb : b.Compatible := by
        intro Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ comm
        change P.map g₁.op (ival _ (x f₁ h₁)) = P.map g₂.op (ival _ (x f₂ h₂))
        rw [← hmapi, ← hmapi]
        exact congrArg (ival _) (hx g₁ g₂ h₁ h₂ comm)
      let α := hP.amalgamate a ha
      let β := hP.amalgamate b hb
      have hα : ∀ ⦃Y⦄ (f : Y ⟶ V) (hf : S.arrows f), P.map f.op α = a f hf :=
        fun Y f hf => hP.valid_glue ha f hf
      have hβ : ∀ ⦃Y⦄ (f : Y ⟶ V) (hf : S.arrows f), P.map f.op β = b f hf :=
        fun Y f hf => hP.valid_glue hb f hf
      have hαβ : (α * β : R.obj (Opposite.op V)) = 1 := by
        apply hP.isSeparatedFor.ext
        intro Y f hf
        change (R.map f.op).hom (α * β) = (R.map f.op).hom 1
        rw [map_mul, map_one]
        change P.map f.op α * P.map f.op β = 1
        rw [hα f hf, hβ f hf]
        exact Units.mul_inv _
      have hβα : (β * α : R.obj (Opposite.op V)) = 1 := by
        apply hP.isSeparatedFor.ext
        intro Y f hf
        change (R.map f.op).hom (β * α) = (R.map f.op).hom 1
        rw [map_mul, map_one]
        change P.map f.op β * P.map f.op α = 1
        rw [hα f hf, hβ f hf]
        exact Units.inv_mul _
      let υ : (R.obj (Opposite.op V))ˣ := ⟨α, β, hαβ, hβα⟩
      let t : Q.obj (Opposite.op V) := ULift.up (Additive.ofMul υ)
      refine ⟨t, ?_, ?_⟩
      · intro Y f hf
        apply hext
        rw [hmap]
        exact hα f hf
      · intro y hy
        apply hext
        refine hP.isSeparatedFor a (val _ y) α (fun Y f hf => ?_) hα
        rw [← hmap, hy f hf]
    rw [Presheaf.isSheaf_iff_isSheaf_forget (Scheme.smallEtaleTopology X) (wcEtGmPre X)
      (forget AddCommGrpCat.{u+1}), isSheaf_iff_isSheaf_of_type]
    exact s4 (Scheme.smallEtaleTopology X) ((Scheme.Etale.forget X ⋙ Over.forget X).op ⋙ Scheme.Γ)
      (s3 (Scheme.Γ ⋙ forget CommRingCat.{u})
        (Presieve.isSheaf_of_le _ s2a s2b))

  let vU : ∀ U : X.Etale, (Γ(U.left, ⊤))ˣ := fun U => Units.map U.hom.appTop.hom.toMonoidHom v
  have hvnat : ∀ (U V : X.Etale) (f : V ⟶ U),
      Units.map f.left.appTop.hom.toMonoidHom (vU U) = vU V := by
    intro U V f
    apply Units.ext
    have hw : f.left ≫ U.hom = V.hom := MorphismProperty.Over.w f
    change f.left.appTop.hom (U.hom.appTop.hom (v : Γ(X, ⊤))) = V.hom.appTop.hom (v : Γ(X, ⊤))
    rw [← hw, Scheme.Hom.comp_appTop]
    rfl
  let βf : ∀ U : X.Etale, ULift.{u+1} ℤ →+ ULift.{u+1} (Additive (Γ(U.left, ⊤))ˣ) :=
    fun U => AddMonoidHom.mk' (fun n => ULift.up (Additive.ofMul (vU U ^ n.down))) (by
      intro a b
      apply ULift.ext
      apply Additive.toMul.injective
      change vU U ^ (a.down + b.down) = vU U ^ a.down * vU U ^ b.down
      rw [zpow_add])
  let β : (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶
      wcEtGmPre X :=
    { app := fun U => AddCommGrpCat.ofHom (βf U.unop)
      naturality := by
        intro U V f
        ext n
        apply ULift.ext
        apply Additive.toMul.injective
        change vU V.unop ^ n.down =
          Units.map f.unop.left.appTop.hom.toMonoidHom (vU U.unop ^ n.down)
        rw [map_zpow, hvnat] }
  refine ⟨β, fun U n => rfl, ?_⟩

  intro h m j H
  let Zc := (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))
  let ρ : sheafify (Scheme.smallEtaleTopology X) (wcEtGmPre X) ⟶ wcEtGmPre X :=
    sheafifyLift (Scheme.smallEtaleTopology X) (𝟙 _) hG
  have hρ : toSheafify (Scheme.smallEtaleTopology X) (wcEtGmPre X) ≫ ρ = 𝟙 _ :=
    toSheafify_sheafifyLift (Scheme.smallEtaleTopology X) (𝟙 _) hG
  let θ : ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj Zc ⟶
      (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (wcEtGmPre X)) →
      (Zc ⟶ wcEtGmPre X) :=
    fun k => toSheafify (Scheme.smallEtaleTopology X) Zc ≫
      (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map k ≫ ρ
  have hlin : ∀ (n : ℕ) (k : (presheafToSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj Zc ⟶ (presheafToSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (wcEtGmPre X)), θ (n • k) = n • θ k := by
    intro n k
    show toSheafify (Scheme.smallEtaleTopology X) Zc ≫
        (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map (n • k) ≫ ρ =
      n • (toSheafify (Scheme.smallEtaleTopology X) Zc ≫
        (sheafToPresheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map k ≫ ρ)
    rw [Functor.map_nsmul, Preadditive.nsmul_comp, Preadditive.comp_nsmul]
  have hθβ : θ ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map β) = β := by
    show toSheafify (Scheme.smallEtaleTopology X) Zc ≫
        sheafifyMap (Scheme.smallEtaleTopology X) β ≫ ρ = β
    rw [← Category.assoc, ← toSheafify_naturality, Category.assoc, hρ, Category.comp_id]
  have e0 : m • h = h ≫ (m • 𝟙 (wcEtGm X)) := by
    rw [Preadditive.comp_nsmul, Category.comp_id]
  have H' : m • θ h = j • β := by
    have a1 : θ (m • h) = m • θ h := hlin m h
    have a2 : θ (j • (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map β) =
        j • θ ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map β) :=
      hlin j _
    have a3 : θ (m • h) =
        θ (j • (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map β) :=
      congrArg θ (e0.trans H)
    rw [← a1, a3, a2, hθβ]

  let T : X.Etale := wcEtTop X
  have e1 := congrArg (fun φ : Zc ⟶ wcEtGmPre X =>
    (φ.app (Opposite.op T)) (ULift.up (1 : ℤ) : ULift.{u+1} ℤ)) H'
  simp only [NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul, AddMonoidHom.nsmul_apply] at e1
  have e2 := congrArg (fun t : ULift.{u+1} (Additive (Γ(X, ⊤))ˣ) => Additive.toMul t.down) e1
  have hvT : vU T = v := by
    apply Units.ext
    change (𝟙 X : X ⟶ X).appTop.hom (v : Γ(X, ⊤)) = v
    simp
  let a0 : ULift.{u+1} (Additive (Γ(X, ⊤))ˣ) :=
    (θ h).app (Opposite.op T) (ULift.up (1 : ℤ) : ULift.{u+1} ℤ)
  let w : (Γ(X, ⊤))ˣ := Additive.toMul a0.down
  refine ⟨w, ?_⟩
  have e3 : w ^ m = (vU T ^ (1 : ℤ)) ^ j := by
    first
      | exact e2
      | (simp only [ULift.smul_down, toMul_nsmul] at e2; exact e2)
  rw [e3, zpow_one, hvT]
  first
    | rfl
    | (congr 1)
    | simp

theorem wc_qsfx_unit_can_compat : ∀ (X : Scheme.{u}) (g : X ⟶ X) (v : (Γ(X, ⊤))ˣ), g.appTop.hom (v : Γ(X, ⊤)) = v → ∀ β : (Functor.const (Scheme.Etale X)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ wcEtGmPre X, (∀ (U : X.Etale) (n : ULift.{u+1} ℤ), (Additive.toMul (β.app (Opposite.op U) n).down : (Γ(U.left, ⊤))ˣ) = (Units.map U.hom.appTop.hom.toMonoidHom v) ^ n.down) → wcEtCanConst g (AddCommGrpCat.of (ULift.{u+1} ℤ)) ≫ (wcEtPush g).map ((presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map β) = (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map β ≫ wcEtCanGm g :=
by
  intro X g v hv β hβ
  have hpt : ∀ (U : X.Etale),
      (Limits.pullback.fst U.hom g).appTop.hom (U.hom.appTop.hom (v : Γ(X, ⊤))) =
        ((wcEtBaseChange g).obj U).hom.appTop.hom (v : Γ(X, ⊤)) := by
    intro U
    have e1 : (Limits.pullback.fst U.hom g).appTop.hom (U.hom.appTop.hom (v : Γ(X, ⊤))) =
        (Limits.pullback.fst U.hom g ≫ U.hom).appTop.hom (v : Γ(X, ⊤)) := by
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    rw [e1, Limits.pullback.condition]
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    rw [hv]
    rfl
  have hptU : ∀ (U : X.Etale),
      Units.map (Limits.pullback.fst U.hom g).appTop.hom.toMonoidHom
          (Units.map U.hom.appTop.hom.toMonoidHom v) =
        Units.map ((wcEtBaseChange g).obj U).hom.appTop.hom.toMonoidHom v := by
    intro U
    apply Units.ext
    simp only [Units.coe_map]
    exact hpt U
  have hstar : ((({ app := fun _ => 𝟙 _, naturality := fun _ _ _ => rfl } :
        (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶
          (wcEtBaseChange g).op ⋙ (Functor.const (X.Etale)ᵒᵖ).obj
            (AddCommGrpCat.of (ULift.{u+1} ℤ)))) ≫
        Functor.whiskerLeft (wcEtBaseChange g).op β) =
      β ≫ Functor.whiskerRight (NatTrans.op (wcEtBaseChangeFst g))
        (Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
          CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) := by
    apply NatTrans.ext
    funext V
    induction V using Opposite.rec with
    | op U =>
    apply AddCommGrpCat.hom_ext
    apply AddMonoidHom.ext
    intro x
    apply ULift.ext
    apply Additive.toMul.injective
    change (Additive.toMul (β.app (Opposite.op ((wcEtBaseChange g).obj U)) x).down :
        (Γ(((wcEtBaseChange g).obj U).left, ⊤))ˣ) =
      Units.map (Limits.pullback.fst U.hom g).appTop.hom.toMonoidHom
        (Additive.toMul (β.app (Opposite.op U) x).down : (Γ(U.left, ⊤))ˣ)
    rw [hβ, hβ, map_zpow, hptU]
    rfl
  have hpre : ((({ app := fun _ => 𝟙 _, naturality := fun _ _ _ => rfl } :
        (Functor.const (X.Etale)ᵒᵖ).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶
          (wcEtBaseChange g).op ⋙ (Functor.const (X.Etale)ᵒᵖ).obj
            (AddCommGrpCat.of (ULift.{u+1} ℤ)))) ≫
        Functor.whiskerLeft (wcEtBaseChange g).op
          (toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj
            (AddCommGrpCat.of (ULift.{u+1} ℤ))))) ≫
        Functor.whiskerLeft (wcEtBaseChange g).op
          (sheafifyMap (Scheme.smallEtaleTopology X) β) =
      β ≫ (Functor.whiskerRight (NatTrans.op (wcEtBaseChangeFst g))
        (Scheme.Γ ⋙ forget₂ CommRingCat CommMonCat ⋙ CommMonCat.units ⋙
          CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}) ≫
        Functor.whiskerLeft (wcEtBaseChange g).op
          (toSheafify (Scheme.smallEtaleTopology X) (wcEtGmPre X))) := by
    rw [Category.assoc, ← Functor.whiskerLeft_comp, ← toSheafify_naturality,
      Functor.whiskerLeft_comp, ← Category.assoc, hstar]
    exact Category.assoc _ _ _
  exact (Functor.map_comp _ _ _).symm.trans
    ((congrArg (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).map hpre).trans
      (Functor.map_comp _ _ _))

theorem wc_qsfx_aut_bridge_unif : ∀ (X : Scheme.{u}) (M : ℕ), M ≠ 0 → ∀ (n : ℕ), letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _; ∃ B : wcEtZModExt X M n ≃+ Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))) n, ∀ (σ : X ⟶ X) [IsIso σ] [(wcEtPush (inv σ)).Additive] [Limits.PreservesFiniteLimits (wcEtPush (inv σ))] [Limits.PreservesFiniteColimits (wcEtPush (inv σ))] [IsIso (wcEtCanConst (inv σ) (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))] (D : wcEtPullData σ M) (x : wcEtZModExt X M n), B (wcEtPull D n x) = wcExtTwist (wcEtPush (inv σ)) (wcEtCanConst (inv σ) (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtCanConst (inv σ) (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))) n (B x) :=
by
  intro X M hM n
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) := HasExt.standard _
  classical
  obtain ⟨μ, hμ, hnat⟩ := wc_r2gs_coh_zmodext_natural M hM n
  let e := AddEquiv.ofBijective (μ X) (hμ X)
  refine ⟨e.symm, ?_⟩
  intro σ _ hFA hFL hFC hcanμ D x

  have hindep : ∀ (D' : wcEtPullData σ M) (x : wcEtZModExt X M n),
      wcEtPull D' n x = wcEtPull D n x := by
    intro D' x
    have Did : wcEtPullData (𝟙 X) M := (wc_et_zmod_pull_data_exists (𝟙 X) M).some
    have hP : ∀ y : wcEtZModExt X M n, wcEtPull Did n y = y := by
      intro y
      have hidem : wcEtPull Did n y = wcEtPull Did n (wcEtPull Did n y) :=
        wc_et_pull_comp (𝟙 X) (𝟙 X) (𝟙 X) (Category.id_comp _) Did Did Did n y
      have h0 : wcEtPull Did n (wcEtPull Did n y - y) = 0 := by
        rw [map_sub, ← hidem, sub_self]
      exact sub_eq_zero.mp (wc_et_pull_id_injective Did n _ h0)
    rw [wc_et_pull_comp σ (𝟙 X) σ (Category.id_comp σ) D Did D' n x, hP]

  have s4 : ∀ (F' G' : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1} ⥤
        Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1})
      [F'.Additive] [Limits.PreservesFiniteLimits F'] [Limits.PreservesFiniteColimits F']
      [G'.Additive] [Limits.PreservesFiniteLimits G'] [Limits.PreservesFiniteColimits G']
      (θ' : G' ≅ F') {P Y : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
      (cP : P ⟶ G'.obj P) (cY : Y ⟶ G'.obj Y) (kP : P ⟶ F'.obj P) (kY : Y ⟶ F'.obj Y)
      [IsIso cY] [IsIso kY], cP ≫ θ'.hom.app P = kP → cY ≫ θ'.hom.app Y = kY →
      ∀ h : Abelian.Ext P Y n, wcExtTwist F' kP kY n h = wcExtTwist G' cP cY n h := by
    intro F' G' _ _ _ _ _ _ θ' P Y cP cY kP kY _ _ hPk hYk h
    have h2 : ∀ {A B C' E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
        (f : A ⟶ B) (g : B ⟶ C') (z : Abelian.Ext C' E n),
        (Abelian.Ext.mk₀ f).comp ((Abelian.Ext.mk₀ g).comp z (zero_add n)) (zero_add n) =
          (Abelian.Ext.mk₀ (f ≫ g)).comp z (zero_add n) := by
      intro A B C' E f g z
      rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero]
    have h3 : ∀ {A B C' E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
        (z : Abelian.Ext A B n) (f : B ⟶ C') (g : C' ⟶ E),
        (z.comp (Abelian.Ext.mk₀ f) (add_zero n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
          z.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero n) := by
      intro A B C' E z f g
      rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
    have h4 : ∀ {A B C' E : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}}
        (f : A ⟶ B) (z : Abelian.Ext B C' n) (g : C' ⟶ E),
        ((Abelian.Ext.mk₀ f).comp z (zero_add n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
          (Abelian.Ext.mk₀ f).comp (z.comp (Abelian.Ext.mk₀ g) (add_zero n)) (zero_add n) := by
      intro A B C' E f z g
      exact Abelian.Ext.comp_assoc_of_third_deg_zero _ _ _ _
    have hinv : θ'.hom.app Y ≫ inv kY = inv cY := by
      apply IsIso.eq_inv_of_hom_inv_id
      rw [← Category.assoc, hYk, IsIso.hom_inv_id]
    have hN : (Abelian.Ext.mapExactFunctor G' h).comp (Abelian.Ext.mk₀ (θ'.hom.app Y))
        (add_zero n) =
        (Abelian.Ext.mk₀ (θ'.hom.app P)).comp (Abelian.Ext.mapExactFunctor F' h) (zero_add n) :=
      Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp h θ'.hom
    show (Abelian.Ext.mk₀ kP).comp ((Abelian.Ext.mapExactFunctor F' h).comp
        (Abelian.Ext.mk₀ (inv kY)) (add_zero n)) (zero_add n) =
      (Abelian.Ext.mk₀ cP).comp ((Abelian.Ext.mapExactFunctor G' h).comp
        (Abelian.Ext.mk₀ (inv cY)) (add_zero n)) (zero_add n)
    rw [← hPk, ← h2]
    refine congrArg (fun z => (Abelian.Ext.mk₀ cP).comp z (zero_add n)) ?_
    rw [← h4, ← hN, h3, hinv]

  obtain ⟨hcont, -⟩ := wc_et_slice_continuous (Scheme.Etale.mk σ)
  haveI := hcont

  have hs3 : ∃ θ : (wcEtSlice (Scheme.Etale.mk σ)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology (Scheme.Etale.mk σ).left) (Scheme.smallEtaleTopology X) ≅
        wcEtPush (X := X) (B := X) (inv σ),
      ∀ A : AddCommGrpCat.{u+1}, wcR2gsConstRes (Scheme.Etale.mk σ) A ≫
        θ.hom.app ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj A) =
        wcEtCanConst (inv σ) A := by

    have gen1 : ∀ {P P' Q Q' : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}} (a : P ⟶ P') (w : P ⟶ Q)
        (w' : P' ⟶ Q') (b : Q ⟶ Q'), a ≫ w' = w ≫ b →
        a ≫ toSheafify (Scheme.smallEtaleTopology X) P' ≫
            sheafifyMap (Scheme.smallEtaleTopology X) w' =
          (toSheafify (Scheme.smallEtaleTopology X) P ≫
            sheafifyMap (Scheme.smallEtaleTopology X) w) ≫
            sheafifyMap (Scheme.smallEtaleTopology X) b := by
      intro P P' Q Q' a w w' b h
      rw [← Category.assoc, toSheafify_naturality, Category.assoc, ← sheafifyMap_comp, h,
        sheafifyMap_comp, Category.assoc]
    have gen2 : ∀ {K P Q : (X.Etale)ᵒᵖ ⥤ AddCommGrpCat.{u+1}}
        (c : sheafify (Scheme.smallEtaleTopology X) K ⟶ P) (g : K ⟶ P) (w : P ⟶ Q) (k : K ⟶ Q),
        toSheafify (Scheme.smallEtaleTopology X) K ≫ c = g → g ≫ w = k →
        toSheafify (Scheme.smallEtaleTopology X) K ≫ c ≫ toSheafify (Scheme.smallEtaleTopology X) P ≫
            sheafifyMap (Scheme.smallEtaleTopology X) w =
          toSheafify (Scheme.smallEtaleTopology X) K ≫ sheafifyMap (Scheme.smallEtaleTopology X) k := by
      intro K P Q c g w k h1 h2
      rw [← Category.assoc, h1, ← toSheafify_naturality, ← Category.assoc, h2,
        toSheafify_naturality]
    have hw : ∀ V : X.Etale, Limits.pullback.fst V.hom (inv σ) ≫
        ((wcEtSlice (Scheme.Etale.mk σ)).obj V).hom = ((wcEtBaseChange (inv σ)).obj V).hom := by
      intro V
      show Limits.pullback.fst V.hom (inv σ) ≫ V.hom ≫ σ = Limits.pullback.snd V.hom (inv σ)
      rw [← Category.assoc, Limits.pullback.condition, Category.assoc, IsIso.inv_hom_id,
        Category.comp_id]
    let βc : ∀ V : X.Etale,
        (wcEtBaseChange (inv σ)).obj V ≅ (wcEtSlice (Scheme.Etale.mk σ)).obj V := fun V =>
      MorphismProperty.Over.isoMk
        (@asIso _ _ _ _ (Limits.pullback.fst V.hom (inv σ))
          (Limits.pullback_fst_iso_of_right_iso V.hom (inv σ))) (hw V)
    let β : wcEtBaseChange (inv σ) ≅ wcEtSlice (Scheme.Etale.mk σ) :=
      NatIso.ofComponents βc (fun {V V'} u => by
        apply MorphismProperty.Over.Hom.ext
        show ((wcEtBaseChange (inv σ)).map u).left ≫ Limits.pullback.fst V'.hom (inv σ) =
          Limits.pullback.fst V.hom (inv σ) ≫ u.left
        exact (wcEtBaseChangeFst (inv σ)).naturality u)
    let θc : ∀ S : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1},
        ((wcEtSlice (Scheme.Etale.mk σ)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology (Scheme.Etale.mk σ).left) (Scheme.smallEtaleTopology X)).obj S ≅
        (wcEtPush (X := X) (B := X) (inv σ)).obj S := fun S =>
      sheafificationIso (J := Scheme.smallEtaleTopology X)
          (((wcEtSlice (Scheme.Etale.mk σ)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology (Scheme.Etale.mk σ).left) (Scheme.smallEtaleTopology X)).obj S) ≪≫
        (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).mapIso
          (Functor.isoWhiskerRight (NatIso.op β) S.obj)
    have hθc : ∀ S : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}, (θc S).hom.hom =
        toSheafify (Scheme.smallEtaleTopology X) ((wcEtSlice (Scheme.Etale.mk σ)).op ⋙ S.obj) ≫
          sheafifyMap (Scheme.smallEtaleTopology X)
            (Functor.whiskerRight (NatTrans.op β.hom) S.obj) := by
      intro S
      have e1 := sheafificationIso_hom_hom (J := Scheme.smallEtaleTopology X)
        (((wcEtSlice (Scheme.Etale.mk σ)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
          (Scheme.smallEtaleTopology (Scheme.Etale.mk σ).left) (Scheme.smallEtaleTopology X)).obj S)
      rw [isoSheafify_hom] at e1
      exact congrArg (fun t => t ≫ sheafifyMap (Scheme.smallEtaleTopology X)
        (Functor.whiskerRight (NatTrans.op β.hom) S.obj)) e1
    refine ⟨NatIso.ofComponents θc (fun {S S'} f => ?_), fun A => ?_⟩
    · apply Sheaf.hom_ext
      refine (congrArg (fun t => Functor.whiskerLeft (wcEtSlice (Scheme.Etale.mk σ)).op f.hom ≫ t)
        (hθc S')).trans ((gen1 _ _ _ _ ?_).trans
          (congrArg (fun t => t ≫ sheafifyMap (Scheme.smallEtaleTopology X)
            (Functor.whiskerLeft (wcEtBaseChange (inv σ)).op f.hom)) (hθc S)).symm)
      exact NatTrans.ext (funext fun V => (f.hom.naturality (β.hom.app V.unop).op).symm)
    · apply Sheaf.hom_ext
      refine sheafify_hom_ext (Scheme.smallEtaleTopology X)
        (P := (Functor.const (X.Etale)ᵒᵖ).obj A) _ _
        ((wcEtPush (X := X) (B := X) (inv σ)).obj
          ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj A)).property ?_
      have L1 : toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj A) ≫
          (wcR2gsConstRes (Scheme.Etale.mk σ) A).hom =
          Functor.whiskerLeft (wcEtSlice (Scheme.Etale.mk σ)).op
            (toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj A)) :=
        toSheafify_sheafifyLift _ _ _
      have key : Functor.whiskerLeft (wcEtSlice (Scheme.Etale.mk σ)).op
            (toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj A)) ≫
          Functor.whiskerRight (NatTrans.op β.hom)
            ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj A).obj =
          (({ app := fun _ => 𝟙 A, naturality := fun _ _ _ => rfl } :
            (Functor.const (X.Etale)ᵒᵖ).obj A ⟶
              (wcEtBaseChange (inv σ)).op ⋙ (Functor.const (X.Etale)ᵒᵖ).obj A)) ≫
          Functor.whiskerLeft (wcEtBaseChange (inv σ)).op
            (toSheafify (Scheme.smallEtaleTopology X) ((Functor.const (X.Etale)ᵒᵖ).obj A)) :=
        NatTrans.ext (funext fun V =>
          ((toSheafify (Scheme.smallEtaleTopology X)
            ((Functor.const (X.Etale)ᵒᵖ).obj A)).naturality (β.hom.app V.unop).op).symm)
      have hfin := gen2 (wcR2gsConstRes (Scheme.Etale.mk σ) A).hom _ _ _ L1 key
      refine Eq.trans ?_ (hfin.trans rfl)
      exact congrArg (fun t => toSheafify (Scheme.smallEtaleTopology X)
        ((Functor.const (X.Etale)ᵒᵖ).obj A) ≫ (wcR2gsConstRes (Scheme.Etale.mk σ) A).hom ≫ t)
        (hθc ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj A))
  obtain ⟨θ, hθ⟩ := hs3
  haveI hGA : ((wcEtSlice (Scheme.Etale.mk σ)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology (Scheme.Etale.mk σ).left) (Scheme.smallEtaleTopology X)).Additive :=
    @Functor.additive_of_iso _ _ _ _ _ _ _ hFA _ θ.symm
  haveI hGPFL : Limits.PreservesFiniteLimits
      ((wcEtSlice (Scheme.Etale.mk σ)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology (Scheme.Etale.mk σ).left) (Scheme.smallEtaleTopology X)) :=
    @Limits.preservesFiniteLimits_of_natIso _ _ _ _ _ _ θ.symm hFL
  haveI hGPFC : Limits.PreservesFiniteColimits
      ((wcEtSlice (Scheme.Etale.mk σ)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology (Scheme.Etale.mk σ).left) (Scheme.smallEtaleTopology X)) :=
    @Limits.preservesFiniteColimits_of_natIso _ _ _ _ _ _ θ.symm hFC
  haveI hIsoΛ : IsIso (wcR2gsConstRes (Scheme.Etale.mk σ)
      (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))) := by
    have h := hθ (AddCommGrpCat.of (ULift.{u+1} (ZMod M)))
    haveI : IsIso (wcR2gsConstRes (Scheme.Etale.mk σ) (AddCommGrpCat.of (ULift.{u+1} (ZMod M))) ≫
        θ.hom.app ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))) := by
      rw [h]
      exact hcanμ
    exact @IsIso.of_isIso_comp_right _ _ _ _ _ _ (θ.hom.app _) (Iso.isIso_hom (θ.app _)) this

  obtain ⟨D₀, hD₀⟩ := hnat (Scheme.Etale.mk σ)
  obtain ⟨y, rfl⟩ : ∃ y, μ X y = x := (hμ X).2 x
  have hy : e.symm (μ X y) = y := e.symm_apply_apply y
  have h1 : wcEtPull D n (μ X y) = μ X (wcR2gsRes (Scheme.Etale.mk σ) M n y) :=
    (hindep D₀ (μ X y)).symm.trans (hD₀ y).symm
  have h2 : e.symm (μ X (wcR2gsRes (Scheme.Etale.mk σ) M n y)) =
      wcR2gsRes (Scheme.Etale.mk σ) M n y :=
    e.symm_apply_apply _
  rw [h1, h2, hy, wcR2gsRes, dif_pos ⟨hcont, hGA, hGPFL, hGPFC, hIsoΛ⟩]
  exact (@s4 (wcEtPush (inv σ))
    ((wcEtSlice (Scheme.Etale.mk σ)).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology (Scheme.Etale.mk σ).left) (Scheme.smallEtaleTopology X))
    _ _ _ hGA hGPFL hGPFC θ _ _
    (wcR2gsConstRes (Scheme.Etale.mk σ) (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    (wcR2gsConstRes (Scheme.Etale.mk σ) (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))
    (wcEtCanConst (inv σ) (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    (wcEtCanConst (inv σ) (AddCommGrpCat.of (ULift.{u+1} (ZMod M))))
    hIsoΛ hcanμ (hθ _) (hθ _) y).symm

theorem wc_qsfx_root_of_pow : ∀ (R : Type u) [CommRing R] (ℓ : ℕ), ℓ.Prime → IsUnit ((ℓ : ℕ) : R) → ∀ k : ℕ, 1 ≤ k → ∀ ζ : R, ζ ^ (ℓ ^ k) = 1 → (∀ i : ℕ, 0 < i → i < ℓ ^ k → IsUnit (1 - ζ ^ i)) → ∀ u v : Rˣ, u ^ (ℓ ^ (k - 1)) = v ^ (ℓ ^ k) → ∃ w : R, w ^ ℓ = (u : R) :=
by
  intro R _ ℓ hp hℓu k hk ζ hζ hζu u v huv
  obtain ⟨n, hn⟩ : ∃ n : ℕ, n = ℓ ^ (k - 1) := ⟨_, rfl⟩
  rw [← hn] at huv
  have hℓpos : 0 < ℓ := hp.pos
  have hnl : ℓ ^ k = n * ℓ := by
    rw [hn, ← pow_succ, Nat.sub_add_cancel hk]
  have hnpos : 0 < n := by rw [hn]; exact pow_pos hℓpos _
  have hnu : IsUnit ((n : ℕ) : R) := by rw [hn, Nat.cast_pow]; exact hℓu.pow _
  obtain ⟨a, ha⟩ : ∃ a : R, a * (n : R) = 1 := hnu.exists_left_inv
  have hn1 : ∀ c : ℕ, (n - 1) * c + c = n * c := by
    intro c
    obtain ⟨n', hn'⟩ : ∃ n', n = n' + 1 := ⟨n - 1, by omega⟩
    rw [hn', Nat.add_sub_cancel]; ring
  obtain ⟨η, hη⟩ : ∃ η : R, η = ζ ^ ℓ := ⟨_, rfl⟩
  have hηn : η ^ n = 1 := by rw [hη, ← pow_mul, mul_comm, ← hnl, hζ]
  have hηu : ∀ j, 0 < j → j < n → IsUnit (1 - η ^ j) := by
    intro j hj0 hjn
    rw [hη, ← pow_mul]
    apply hζu
    · exact Nat.mul_pos hℓpos hj0
    · rw [hnl, mul_comm n ℓ]; exact Nat.mul_lt_mul_of_pos_left hjn hℓpos

  obtain ⟨x', hx'⟩ : ∃ x' : Rˣ, x' = u * v⁻¹ ^ ℓ := ⟨_, rfl⟩
  have hx'n : x' ^ n = 1 := by
    have e : x' ^ n = u ^ n * (v ^ (n * ℓ))⁻¹ := by
      rw [hx', mul_pow, ← pow_mul, inv_pow, mul_comm ℓ n]
    rw [e, ← hnl, ← huv, mul_inv_cancel]
  obtain ⟨x, hx⟩ : ∃ x : R, x = (x' : R) := ⟨_, rfl⟩
  have hxn : x ^ n = 1 := by rw [hx, ← Units.val_pow_eq_pow_val, hx'n, Units.val_one]

  have hS : ∀ e : ℕ, ∑ i ∈ Finset.range n, (η ^ e) ^ i = if n ∣ e then (n : R) else 0 := by
    intro e
    have he : η ^ e = η ^ (e % n) := by
      conv_lhs => rw [← Nat.div_add_mod e n]
      rw [pow_add, pow_mul, hηn, one_pow, one_mul]
    split_ifs with hd
    · rw [he, Nat.mod_eq_zero_of_dvd hd, pow_zero]; simp
    · have hr0 : 0 < e % n := Nat.pos_of_ne_zero (fun h => hd (Nat.dvd_of_mod_eq_zero h))
      have hu := hηu (e % n) hr0 (Nat.mod_lt _ hnpos)
      have htn : (η ^ e) ^ n = 1 := by rw [← pow_mul, mul_comm, pow_mul, hηn, one_pow]
      have hg := geom_sum_mul (η ^ e) n
      rw [htn, sub_self] at hg
      rw [he] at hg ⊢
      have hu' : IsUnit (η ^ (e % n) - 1) := by rw [← neg_sub]; exact hu.neg
      exact (hu'.mul_left_eq_zero).mp hg

  have hdiv : ∀ m m' : ℕ, m < n → m' < n → (n ∣ (n - 1) * m' + m ↔ m' = m) := by
    intro m m' hm hm'
    constructor
    · rintro ⟨c, hc⟩
      have e1 : m' + n * c = m + n * m' := by
        have := hn1 m'
        omega
      have e2 : (m' + n * c) % n = (m + n * m') % n := by rw [e1]
      rw [Nat.add_mul_mod_self_left, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hm',
        Nat.mod_eq_of_lt hm] at e2
      exact e2
    · rintro rfl
      rw [hn1 m']
      exact Dvd.intro m' rfl

  have hgeom : ∀ g : R, g ^ n = 1 →
      g * ∑ i ∈ Finset.range n, g ^ i = ∑ i ∈ Finset.range n, g ^ i := by
    intro g hg
    have h := mul_geom_sum g n
    rw [hg, sub_self, sub_mul, one_mul, sub_eq_zero] at h
    exact h
  obtain ⟨f, hf⟩ : ∃ f : ℕ → R,
      ∀ m, f m = a * ∑ i ∈ Finset.range n, (η ^ ((n - 1) * m) * x) ^ i := ⟨_, fun _ => rfl⟩
  have hxf : ∀ m, x * f m = η ^ m * f m := by
    intro m
    have h1 : η ^ m * (η ^ ((n - 1) * m) * x) = x := by
      rw [← mul_assoc, ← pow_add, add_comm, hn1, pow_mul, hηn, one_pow, one_mul]
    have h2 : (η ^ ((n - 1) * m) * x) ^ n = 1 := by
      rw [mul_pow, ← pow_mul, mul_comm ((n - 1) * m) n, pow_mul, hηn, one_pow, one_mul, hxn]
    have key : ∀ g S : R, g * S = S → η ^ m * g = x → x * (a * S) = η ^ m * (a * S) := by
      intro g S hgS h1'
      linear_combination (-(a * S)) * h1' + (a * η ^ m) * hgS
    rw [hf m]
    exact key _ _ (hgeom _ h2) h1
  have hxif : ∀ i m, x ^ i * f m = (η ^ m) ^ i * f m := by
    intro i m
    induction i with
    | zero => simp
    | succ i ih =>
      rw [pow_succ, mul_assoc, hxf, mul_left_comm, ih, ← mul_assoc, ← pow_succ']
  have horth : ∀ m m', m < n → m' < n → f m' * f m = if m' = m then f m else 0 := by
    intro m m' hm hm'
    have e1 : f m' * f m = a * (∑ i ∈ Finset.range n, (η ^ ((n - 1) * m' + m)) ^ i) * f m := by
      calc f m' * f m = a * ∑ i ∈ Finset.range n, (η ^ ((n - 1) * m') * x) ^ i * f m := by
            rw [hf m', mul_assoc, Finset.sum_mul]
        _ = a * ∑ i ∈ Finset.range n, (η ^ ((n - 1) * m' + m)) ^ i * f m := by
            congr 1
            apply Finset.sum_congr rfl
            intro i _
            rw [mul_pow, mul_assoc, hxif, ← mul_assoc, ← mul_pow, ← pow_add]
        _ = a * (∑ i ∈ Finset.range n, (η ^ ((n - 1) * m' + m)) ^ i) * f m := by
            rw [mul_assoc, Finset.sum_mul]
    rw [e1, hS]
    by_cases h2 : m' = m
    · rw [if_pos ((hdiv m m' hm hm').mpr h2), if_pos h2, ha, one_mul]
    · rw [if_neg (fun h => h2 ((hdiv m m' hm hm').mp h)), if_neg h2, mul_zero, zero_mul]
  have hsum : ∑ m ∈ Finset.range n, f m = 1 := by
    calc ∑ m ∈ Finset.range n, f m
        = a * ∑ i ∈ Finset.range n, x ^ i * ∑ m ∈ Finset.range n, (η ^ ((n - 1) * i)) ^ m := by
          rw [Finset.sum_congr rfl (fun m _ => hf m), ← Finset.mul_sum, Finset.sum_comm]
          congr 1
          apply Finset.sum_congr rfl
          intro i _
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro m _
          rw [mul_pow, ← pow_mul, ← pow_mul, mul_right_comm (n - 1) m i, mul_comm]
      _ = a * ∑ i ∈ Finset.range n, x ^ i * (if n ∣ (n - 1) * i then (n : R) else 0) := by
          simp only [hS]
      _ = a * (x ^ 0 * (if n ∣ (n - 1) * 0 then (n : R) else 0)) := by
          congr 1
          apply Finset.sum_eq_single 0
          · intro i hi hi0
            have hin : ¬ n ∣ (n - 1) * i := by
              intro h
              have := (hdiv 0 i hnpos (Finset.mem_range.mp hi)).mp (by simpa using h)
              exact hi0 this
            rw [if_neg hin, mul_zero]
          · intro h
            exact absurd (Finset.mem_range.mpr hnpos) h
      _ = 1 := by simp [ha]

  obtain ⟨y, hy⟩ : ∃ y : R, y = ∑ m ∈ Finset.range n, ζ ^ m * f m := ⟨_, rfl⟩
  have hyf : ∀ m, m < n → y * f m = ζ ^ m * f m := by
    intro m hm
    rw [hy, Finset.sum_mul, Finset.sum_eq_single m]
    · rw [mul_assoc, horth m m hm hm, if_pos rfl]
    · intro b hb hbm
      rw [mul_assoc, horth m b hm (Finset.mem_range.mp hb), if_neg hbm, mul_zero]
    · intro h
      exact absurd (Finset.mem_range.mpr hm) h
  have hyjf : ∀ m, m < n → ∀ j : ℕ, y ^ j * f m = (ζ ^ m) ^ j * f m := by
    intro m hm j
    induction j with
    | zero => simp
    | succ j ih =>
      rw [pow_succ', mul_assoc, ih, mul_left_comm, hyf m hm, ← mul_assoc, ← pow_succ]
  have hyl : y ^ ℓ = x := by
    calc y ^ ℓ = y ^ ℓ * ∑ m ∈ Finset.range n, f m := by rw [hsum, mul_one]
      _ = ∑ m ∈ Finset.range n, x * f m := by
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro m hm
          rw [hyjf m (Finset.mem_range.mp hm), hxf, hη, ← pow_mul, ← pow_mul, mul_comm m ℓ]
      _ = x := by rw [← Finset.mul_sum, hsum, mul_one]
  refine ⟨y * (v : R), ?_⟩
  have hu : x' * v ^ ℓ = u := by
    rw [hx', mul_assoc, ← mul_pow, inv_mul_cancel, one_pow, mul_one]
  rw [mul_pow, hyl, hx, ← hu, Units.val_mul, Units.val_pow_eq_pow_val]

theorem wc_qsfx_tube_endo_iso : ∀ (A' : Type u) [CommRing A'] [IsDomain A'] (L' : Type u) [Field L'] (φ' : A' →+* L'), Function.Injective φ' → (letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L') → ∀ (σ' : L' →+* L'), σ'.comp φ' = φ' → ∀ (C : Type u) [CommRing C] (g : Spec (.of C) ⟶ Spec (.of A')) (Pq : Scheme.{u}) (q1 : Pq ⟶ Spec (.of C)) (qL : Pq ⟶ Spec (.of L')), IsPullback q1 qL g (Spec.map (CommRingCat.ofHom φ')) → ∀ (wq : Pq ⟶ Pq), wq ≫ q1 = q1 → wq ≫ qL = qL ≫ Spec.map (CommRingCat.ofHom σ') → IsIso wq :=
by
  intro A' _ _ L' _ φ' hφ halg σ' hσ C _ g Pq q1 qL hT wq hw1 hwL
  letI : Algebra A' L' := φ'.toAlgebra
  haveI : Algebra.IsAlgebraic A' L' := halg
  haveI : Module.IsTorsionFree A' L' :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr hφ
  let σA : L' →ₐ[A'] L' :=
    { σ' with
      commutes' := fun a => by
        show σ' (φ' a) = φ' a
        exact RingHom.congr_fun hσ a }
  have hbij : Function.Bijective σ' := Algebra.IsAlgebraic.algHom_bijective σA
  let e : L' ≃+* L' := RingEquiv.ofBijective σ' hbij
  let τ : L' →+* L' := (e.symm : L' →+* L')
  have hτσ : τ.comp σ' = RingHom.id L' := by
    ext x
    show e.symm (σ' x) = x
    exact e.symm_apply_apply x
  have hστ : σ'.comp τ = RingHom.id L' := by
    ext x
    show σ' (e.symm x) = x
    exact e.apply_symm_apply x
  have hτφ : τ.comp φ' = φ' := by
    rw [← hσ, ← RingHom.comp_assoc, hτσ, RingHom.id_comp]
    exact hσ.symm
  have hK : ∀ (f h : L' →+* L'), Spec.map (CommRingCat.ofHom f) ≫ Spec.map (CommRingCat.ofHom h)
      = Spec.map (CommRingCat.ofHom (f.comp h)) := by
    intro f h
    rw [← Spec.map_comp, CommRingCat.ofHom_comp]
  have hw : q1 ≫ g = (qL ≫ Spec.map (CommRingCat.ofHom τ)) ≫ Spec.map (CommRingCat.ofHom φ') := by
    rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hτφ]
    exact hT.w
  let v : Pq ⟶ Pq := hT.lift q1 (qL ≫ Spec.map (CommRingCat.ofHom τ)) hw
  have hv1 : v ≫ q1 = q1 := hT.lift_fst _ _ _
  have hvL : v ≫ qL = qL ≫ Spec.map (CommRingCat.ofHom τ) := hT.lift_snd _ _ _
  have h1 : wq ≫ v = 𝟙 Pq := by
    apply hT.hom_ext
    · rw [Category.assoc, hv1, hw1, Category.id_comp]
    · rw [Category.assoc, hvL, ← Category.assoc, hwL, Category.assoc, hK, hστ,
        CommRingCat.ofHom_id, Spec.map_id, Category.comp_id, Category.id_comp]
  have h2 : v ≫ wq = 𝟙 Pq := by
    apply hT.hom_ext
    · rw [Category.assoc, hw1, hv1, Category.id_comp]
    · rw [Category.assoc, hwL, ← Category.assoc, hvL, Category.assoc, hK, hτσ,
        CommRingCat.ofHom_id, Spec.map_id, Category.comp_id, Category.id_comp]
  exact ⟨⟨v, h1, h2⟩⟩

theorem wc_qsfx_uq_isUnit : ∀ (A' : Type u) [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A'] (π' : A'), IsLocalRing.maximalIdeal A' = Ideal.span {π'} → ∀ (r : ℕ) (C : Type u) [CommRing C] (a : Spec (.of C) ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π' (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))) (L' : Type u) [Field L'] (φ' : A' →+* L'), Function.Injective φ' → ∀ (Pq : Scheme.{u}) (q1 : Pq ⟶ Spec (.of C)) (qL : Pq ⟶ Spec (.of L')), IsPullback q1 qL (a ≫ wcQuadModelStr A' (r + 2) π' (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) (Spec.map (CommRingCat.ofHom φ')) → IsUnit (q1.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of C)).inv.hom ((Spec.preimage a).hom (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π' (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))))))) :=
by
  intro A' _ _ _ π' hπ' r C _ a L' _ φ' hφ' Pq q1 qL hT
  have hπ0 : π' ≠ 0 := by
    intro h
    apply IsDiscreteValuationRing.not_a_field A'
    rw [hπ', h, Ideal.span_singleton_eq_bot.mpr rfl]
  have hφπ : IsUnit (φ' π') := by
    refine Ne.isUnit ?_
    intro h
    exact hπ0 (hφ' (h.trans (map_zero φ').symm))
  have s4 : IsUnit (qL.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of L')).inv.hom (φ' π'))) :=
    (hφπ.map (Scheme.ΓSpecIso (CommRingCat.of L')).inv.hom).map qL.appTop.hom
  have s1 : Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π' (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) * Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π' (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) = algebraMap A' (wcQuadModelRing A' (r + 2) π' (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) π' := by
    have hg : Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π' (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) (∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) p q) * MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π') = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
    have hsum : (∑ p : Fin (r + 2), ∑ q : Fin (r + 2), MvPolynomial.C ((Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) p q) * MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin (r + 2)) A') = MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) := by
      simp only [Matrix.of_apply]
      rw [Fintype.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
      · rw [Fintype.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
        · simp
        · intro q hq
          have : q.val ≠ 1 := fun h => hq (Fin.ext h)
          simp [this]
      · intro p hp
        have : p.val ≠ 0 := fun h => hp (Fin.ext h)
        simp [this]
    rw [hsum, map_sub, map_mul, sub_eq_zero] at hg
    rw [hg, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  have s3 : q1.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of C)).inv.hom ((Spec.preimage a).hom (algebraMap A' (wcQuadModelRing A' (r + 2) π' (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) π'))) = qL.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of L')).inv.hom (φ' π')) := by
    have e1 := congrArg (fun f => f.hom π') (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap A' (wcQuadModelRing A' (r + 2) π' (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))))
    have e2 := congrArg (fun f => f.hom (algebraMap A' (wcQuadModelRing A' (r + 2) π' (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) π')) (Scheme.ΓSpecIso_inv_naturality (Spec.preimage a))
    have e3 := congrArg (fun f => f.hom π') (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom φ'))
    have e4 := congrArg (fun f => f.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of A')).inv.hom π')) hT.w
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e1 e2 e3
    rw [Spec.map_preimage] at e2
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e4
    rw [e2, e1, e3]
    exact e4
  have s2 := congrArg (fun z => q1.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of C)).inv.hom ((Spec.preimage a).hom z))) s1
  simp only [map_mul] at s2
  rw [s3] at s2
  rw [← s2] at s4
  exact isUnit_of_mul_isUnit_left s4

theorem wc_qsfx_double_kummer_class : ∀ (A' : Type u) [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A') →
    ∀ (π' : A'), IsLocalRing.maximalIdeal A' = Ideal.span {π'} →
    ∀ (r : ℕ) (C : Type u) [CommRing C] [HenselianLocalRing C]
      [IsSepClosed (IsLocalRing.ResidueField C)]
      (a : Spec (.of C) ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))),
    WeaklyEtale a →
    wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)
        (a (IsLocalRing.closedPoint C)) = IsLocalRing.closedPoint A' →
    ∀ (L' : Type u) [Field L'] [IsSepClosed L'] (φ' : A' →+* L'), Function.Injective φ' →
    (letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L') →
    ∀ (Pq : Scheme.{u}) (q1 : Pq ⟶ Spec (.of C)) (qL : Pq ⟶ Spec (.of L')),
    IsPullback q1 qL (a ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom φ')) →
    Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (a (IsLocalRing.closedPoint C)) →
    Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (a (IsLocalRing.closedPoint C)) →
    ∀ k : ℕ, 1 ≤ k → ∃ κ : wcZModProEtExt Pq (ℓ ^ k) 1,
      ((ℓ ^ (k - 1)) • κ = 0 → ∃ v : Γ(Pq, ⊤), v ^ ℓ =
        q1.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of C)).inv.hom ((Spec.preimage a).hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
            (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))))))) ∧
      ∀ (σ' : L' →+* L'), σ'.comp φ' = φ' → ∀ (wq : Pq ⟶ Pq), wq ≫ q1 = q1 →
        wq ≫ qL = qL ≫ Spec.map (CommRingCat.ofHom σ') →
        ∀ (Dq : wcZModPullData wq (ℓ ^ k)), wcZModPullCanonical Dq → wcZModPull Dq 1 κ = κ :=
by
  intro A' _ _ _ _ _ ℓ _ hℓA π' hπ' r C _ _ _ a _ _ L' _ _ φ' hφ'i halg' Pq q1 qL hT _ _ k hk
  classical
  have hp : Nat.Prime ℓ := Fact.out
  have hM : ℓ ^ k ≠ 0 := pow_ne_zero _ hp.ne_zero

  have hℓL : IsUnit ((ℓ : ℕ) : L') := by
    rw [← map_natCast φ']; exact hℓA.map φ'
  have hML : ((ℓ ^ k : ℕ) : L') ≠ 0 := by
    rw [Nat.cast_pow]; exact (hℓL.pow k).ne_zero
  have hMA : IsUnit ((ℓ ^ k : ℕ) : A') := by
    rw [Nat.cast_pow]; exact hℓA.pow k
  have hℓX : IsUnit ((ℓ : ℕ) : Γ(Pq, ⊤)) := by
    have h := hℓL.map (qL.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of L')).inv.hom)
    rwa [map_natCast] at h

  obtain ⟨ζ, hζ⟩ := wc_qsfx_prim_root_A A' (ℓ ^ k) (Nat.pos_of_ne_zero hM) hMA
  have hζL : IsPrimitiveRoot (φ' ζ) (ℓ ^ k) := hζ.map_of_injective hφ'i
  obtain ⟨zX, hzX⟩ : ∃ z : Γ(Pq, ⊤),
      z = qL.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of L')).inv.hom (φ' ζ)) := ⟨_, rfl⟩
  have hzXM : zX ^ (ℓ ^ k) = 1 := by
    rw [hzX, ← map_pow, ← map_pow, hζL.pow_eq_one, map_one, map_one]
  have hzXu : ∀ i : ℕ, 0 < i → i < ℓ ^ k → IsUnit (1 - zX ^ i) := by
    intro i hi0 hiM
    have h1 : (φ' ζ) ^ i ≠ 1 := hζL.pow_ne_one_of_pos_of_lt hi0.ne' hiM
    have h2 : IsUnit (1 - (φ' ζ) ^ i) := (sub_ne_zero.mpr (Ne.symm h1)).isUnit
    have h3 := h2.map (qL.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of L')).inv.hom)
    rw [map_sub, map_one, map_pow, RingHom.comp_apply] at h3
    rw [hzX]
    exact h3

  obtain ⟨κK, hκK, hw, hS⟩ := wc_qsfx_kummer_ses_field L' Pq qL (ℓ ^ k) hML (φ' ζ) hζL

  obtain ⟨vq, hvq⟩ := wc_qsfx_uq_isUnit A' π' hπ' r C a L' φ' hφ'i Pq q1 qL hT
  obtain ⟨β, hβ, hev⟩ := wc_qsfx_unit_class Pq vq
  obtain ⟨ũ, hũ⟩ : ∃ g : (constantSheaf (Scheme.smallEtaleTopology Pq) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ)) ⟶ wcEtGm Pq,
      g = (presheafToSheaf (Scheme.smallEtaleTopology Pq) AddCommGrpCat.{u+1}).map β := ⟨_, rfl⟩
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Pq) AddCommGrpCat.{u+1}) := HasExt.standard _
  obtain ⟨κet, hκet⟩ : ∃ e : Abelian.Ext
      ((constantSheaf (Scheme.smallEtaleTopology Pq) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((constantSheaf (Scheme.smallEtaleTopology Pq) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k))))) 1,
      e = (Abelian.Ext.mk₀ ũ).comp hS.extClass (zero_add 1) := ⟨_, rfl⟩
  obtain ⟨B, hB⟩ := wc_qsfx_aut_bridge_unif Pq (ℓ ^ k) hM 1
  obtain ⟨Θ, hΘbij, hΘnat⟩ := wc_zmod_et_proet_natural_comparison_all (ℓ ^ k) 1
  haveI : IsAffine Pq := IsAffine.of_isIso hT.isoPullback.hom
  refine ⟨Θ Pq (B.symm κet), ?_, ?_⟩
  ·
    intro h0
    have h1 : (ℓ ^ (k - 1)) • B.symm κet = 0 := by
      apply (hΘbij Pq inferInstance inferInstance).1
      rw [map_nsmul, h0, map_zero]
    have h2 : (ℓ ^ (k - 1)) • κet = 0 := by
      have := congrArg B h1
      rwa [map_nsmul, AddEquiv.apply_symm_apply, map_zero] at this
    rw [hκet] at h2
    obtain ⟨h, hh⟩ := wc_d1_ext_kummer_lift
      ((presheafToSheaf (Scheme.smallEtaleTopology Pq) AddCommGrpCat.{u+1}).map κK) (ℓ ^ k) hw hS
      ũ (ℓ ^ (k - 1)) h2
    rw [hũ] at hh
    obtain ⟨w, hw'⟩ := hev h (ℓ ^ k) (ℓ ^ (k - 1)) hh
    obtain ⟨w', hw''⟩ := wc_qsfx_root_of_pow Γ(Pq, ⊤) ℓ hp hℓX k hk zX hzXM hzXu vq w hw'.symm
    exact ⟨w', hw''.trans hvq⟩
  ·
    intro σ' hσ' wq hwq1 hwqL Dq hDq
    haveI hiso : IsIso wq :=
      wc_qsfx_tube_endo_iso A' L' φ' hφ'i halg' σ' hσ' C _ Pq q1 qL hT wq hwq1 hwqL
    obtain ⟨E⟩ := wc_et_zmod_pull_data_exists wq (ℓ ^ k)
    rw [hΘnat wq Dq hDq E]
    congr 1
    apply B.injective
    obtain ⟨hAdd, hLim, hColim, hConst, hGm⟩ := wc_et_push_iso_exact_can (inv wq)
    haveI := hAdd
    haveI := hLim
    haveI := hColim
    haveI := hGm
    haveI hZ := hConst (AddCommGrpCat.of (ULift.{u+1} ℤ))
    haveI hμ := hConst (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k))))
    rw [hB wq E]
    simp only [AddEquiv.apply_symm_apply]

    have hinvfix : ∀ z : Γ(Pq, ⊤), wq.appTop.hom z = z → (inv wq).appTop.hom z = z := by
      intro z hz
      have h1 := congrArg (fun f : Pq ⟶ Pq => f.appTop.hom z) (IsIso.inv_hom_id wq)
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at h1
      rw [hz] at h1
      rw [h1]
      simp
    have hwq_fix : ∀ y, wq.appTop.hom (q1.appTop.hom y) = q1.appTop.hom y := by
      intro y
      have h1 := congrArg (fun f : Pq ⟶ Spec (.of C) => f.appTop.hom y) hwq1
      simpa only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] using h1
    have hfixq : (inv wq).appTop.hom (vq : Γ(Pq, ⊤)) = vq :=
      hinvfix _ (by rw [hvq]; exact hwq_fix _)
    have hwz : wq.appTop.hom zX = zX := by
      have e1 := congrArg (fun f : Pq ⟶ Spec (.of L') =>
        f.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of L')).inv.hom (φ' ζ))) hwqL
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e1
      have e2 := congrArg (fun f => f.hom (φ' ζ))
        (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom σ'))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e2
      have e3 : σ' (φ' ζ) = φ' ζ := congrArg (fun f => f ζ) hσ'
      rw [e3] at e2
      rw [← e2] at e1
      rw [hzX]
      exact e1
    have hfixz : (inv wq).appTop.hom zX = zX := hinvfix _ hwz

    have sq1 := wc_pow_kummer_can_compat Pq (inv wq) (ℓ ^ k) zX hfixz κK
      (fun U x => by rw [hκK U x, hzX])
    have sq2 : wcEtCanGm (inv wq) ≫ (wcEtPush (inv wq)).map ((ℓ ^ k) • 𝟙 (wcEtGm Pq)) =
        ((ℓ ^ k) • 𝟙 (wcEtGm Pq)) ≫ wcEtCanGm (inv wq) := by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id, Preadditive.comp_nsmul,
        Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
    have hE := @wc_ext_twist_extClass _ _ _ _ (wcEtPush (inv wq)) _ _ _ _ hS _
      (wcEtCanConst (inv wq) (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      (wcEtCanConst (inv wq) (AddCommGrpCat.of (ULift.{u+1} (ZMod (ℓ ^ k)))))
      (wcEtCanGm (inv wq)) (wcEtCanGm (inv wq)) hμ hGm sq1 sq2 0 (Abelian.Ext.mk₀ ũ)
    have hsq0 : wcEtCanConst (inv wq) (AddCommGrpCat.of (ULift.{u+1} ℤ)) ≫
        (wcEtPush (inv wq)).map ũ = ũ ≫ wcEtCanGm (inv wq) := by
      rw [hũ]
      exact wc_qsfx_unit_can_compat Pq (inv wq) vq hfixq β hβ
    have htw : wcExtTwist (wcEtPush (inv wq))
        (wcEtCanConst (inv wq) (AddCommGrpCat.of (ULift.{u+1} ℤ))) (wcEtCanGm (inv wq)) 0
        (Abelian.Ext.mk₀ ũ) = Abelian.Ext.mk₀ ũ := by
      unfold wcExtTwist
      rw [Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀,
        ← Category.assoc, hsq0, Category.assoc, IsIso.hom_inv_id, Category.comp_id]
    rw [hκet]
    refine hE.trans ?_
    exact congrArg (fun e => e.comp hS.extClass (zero_add 1)) htw

theorem wc_xnp_eis_dvr : ∀ (A' : Type u) [CommRing A'] [IsDomain A'] [IsDiscreteValuationRing A']
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (π' : A'), IsLocalRing.maximalIdeal A' = Ideal.span {π'} →
    ∃ (_ : IsDomain (wcXnpEis A' ℓ π')) (_ : IsDiscreteValuationRing (wcXnpEis A' ℓ π')),
      IsLocalRing.maximalIdeal (wcXnpEis A' ℓ π') = Ideal.span {wcXnpRho A' ℓ π'} :=
by
  intro A _ _ _ ℓ _ π hπ
  have hN : 0 < ℓ := (Fact.out : ℓ.Prime).pos
  suffices key : ∀ f : Polynomial A, Polynomial.X ^ ℓ - Polynomial.C π = f →
      ∃ (_ : IsDomain (AdjoinRoot f)) (_ : IsDiscreteValuationRing (AdjoinRoot f)),
        IsLocalRing.maximalIdeal (AdjoinRoot f) = Ideal.span {AdjoinRoot.root f} from
    key _ rfl
  intro f hf

  have hirr : Irreducible π := (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mpr hπ
  have hπ0 : π ≠ 0 := hirr.ne_zero
  have hπnu : ¬ IsUnit π := hirr.not_isUnit
  have hπmem : π ∈ IsLocalRing.maximalIdeal A := by
    rw [hπ]; exact Ideal.mem_span_singleton_self π

  have hN0 : ℓ ≠ 0 := Nat.pos_iff_ne_zero.mp hN
  have hmonic : f.Monic := by rw [← hf]; exact Polynomial.monic_X_pow_sub_C π hN0
  have hnatdeg : f.natDegree = ℓ := by rw [← hf]; exact Polynomial.natDegree_X_pow_sub_C
  have hdeg : f.degree = ℓ := by rw [← hf]; exact Polynomial.degree_X_pow_sub_C hN π
  have hs : AdjoinRoot.root f ^ ℓ = AdjoinRoot.of f π := by
    have h : AdjoinRoot.mk f (Polynomial.X ^ ℓ - Polynomial.C π) = 0 := by
      rw [hf]; exact AdjoinRoot.mk_self
    rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h
    exact h
  have hcoeff : ∀ n, n < ℓ → f.coeff n ∈ IsLocalRing.maximalIdeal A := by
    intro n hn
    rw [← hf, Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C,
      if_neg (by omega)]
    split_ifs
    · rw [zero_sub]; exact (Ideal.neg_mem_iff _).mpr hπmem
    · rw [sub_zero]; exact Ideal.zero_mem _
  have hc0 : f.coeff 0 = -π := by
    rw [← hf, Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C,
      if_neg (by omega), if_pos rfl, zero_sub]

  have hP2 : f.coeff 0 ∉ (IsLocalRing.maximalIdeal A) ^ 2 := by
    rw [hc0, hπ, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
    rintro ⟨c, hc⟩
    have h1 : π * (c * π + 1) = 0 := by linear_combination hc
    rcases mul_eq_zero.mp h1 with h | h
    · exact hπ0 h
    · exact hπnu (isUnit_iff_exists_inv.mpr ⟨-c, by linear_combination -h⟩)
  have hE : f.IsEisensteinAt (IsLocalRing.maximalIdeal A) :=
    hmonic.isEisensteinAt_of_mem_of_notMem (IsLocalRing.maximalIdeal.isMaximal A).ne_top
      (fun {n} hn => hcoeff n (by rwa [hnatdeg] at hn)) hP2
  have hfirr : Irreducible f :=
    hE.irreducible (IsLocalRing.maximalIdeal.isMaximal A).isPrime hmonic.isPrimitive
      (by rw [hnatdeg]; exact hN)
  have hfprime : Prime f := hfirr.prime
  haveI hdom : IsDomain (AdjoinRoot f) := AdjoinRoot.isDomain_of_prime hfprime

  haveI : Module.Finite A (AdjoinRoot f) := hmonic.finite_adjoinRoot
  haveI : Algebra.IsIntegral A (AdjoinRoot f) := Algebra.IsIntegral.of_finite A (AdjoinRoot f)

  have hcomap : ∀ M : Ideal (AdjoinRoot f), M.IsMaximal →
      Ideal.comap (AdjoinRoot.of f) M = IsLocalRing.maximalIdeal A := by
    intro M hM
    haveI := hM
    have h1 : (Ideal.under A M).IsMaximal := Ideal.IsMaximal.under A M
    have h2 : Ideal.comap (AdjoinRoot.of f) M = Ideal.under A M := by
      rw [Ideal.under_def, AdjoinRoot.algebraMap_eq]
    rw [h2]
    exact IsLocalRing.eq_maximalIdeal h1
  have hzM : ∀ M : Ideal (AdjoinRoot f), M.IsMaximal → AdjoinRoot.root f ∈ M := by
    intro M hM
    have h1 : π ∈ Ideal.comap (AdjoinRoot.of f) M := by rw [hcomap M hM]; exact hπmem
    rw [Ideal.mem_comap, ← hs] at h1
    exact hM.isPrime.mem_of_pow_mem ℓ h1

  have hznu : ¬ IsUnit (AdjoinRoot.root f) := by
    intro hu
    obtain ⟨M, hM⟩ := Ideal.exists_maximal (AdjoinRoot f)
    exact hM.ne_top (Ideal.eq_top_of_isUnit_mem M (hzM M hM) hu)
  have hz0 : AdjoinRoot.root f ≠ 0 := by
    intro h0
    have hd0 : f.degree ≠ 0 := by rw [hdeg]; exact_mod_cast hN0
    have hinj := AdjoinRoot.of.injective_of_degree_ne_zero hd0
    apply hπ0
    apply hinj
    rw [map_zero, ← hs, h0, zero_pow hN0]

  have hsK : AdjoinRoot.root f ^ (ℓ - 1) * AdjoinRoot.root f = AdjoinRoot.of f π := by
    rw [← pow_succ, Nat.sub_add_cancel hN]; exact hs
  have hnon : ∀ y : AdjoinRoot f, ¬ IsUnit y ↔ y ∈ Ideal.span {AdjoinRoot.root f} := by
    intro y
    constructor
    · intro hy
      obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective y
      obtain ⟨M, hM, hyM⟩ := exists_max_ideal_of_mem_nonunits (mem_nonunits_iff.mpr hy)
      have hdecomp : AdjoinRoot.mk f p = AdjoinRoot.root f * AdjoinRoot.mk f p.divX +
          AdjoinRoot.of f (p.coeff 0) := by
        conv_lhs => rw [← Polynomial.X_mul_divX_add p]
        rw [map_add, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C]
      have ha0' : AdjoinRoot.of f (p.coeff 0) =
          AdjoinRoot.mk f p - AdjoinRoot.root f * AdjoinRoot.mk f p.divX := by
        linear_combination -hdecomp
      have ha0 : AdjoinRoot.of f (p.coeff 0) ∈ M := by
        rw [ha0']
        exact M.sub_mem hyM (M.mul_mem_right (AdjoinRoot.mk f p.divX) (hzM M hM))
      have ha0P : p.coeff 0 ∈ Ideal.span {π} := by
        rw [← hπ, ← hcomap M hM, Ideal.mem_comap]; exact ha0
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp ha0P
      rw [Ideal.mem_span_singleton']
      refine ⟨AdjoinRoot.mk f p.divX + AdjoinRoot.of f b * AdjoinRoot.root f ^ (ℓ - 1), ?_⟩
      rw [hdecomp, ← hb, map_mul, ← hsK]
      ring
    · intro hy hu
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      exact hznu (isUnit_of_mul_isUnit_right hu)

  haveI hloc : IsLocalRing (AdjoinRoot f) := IsLocalRing.of_nonunits_add (fun a b ha hb => by
    rw [mem_nonunits_iff, hnon] at ha hb ⊢
    exact Ideal.add_mem _ ha hb)
  have hmax : IsLocalRing.maximalIdeal (AdjoinRoot f) = Ideal.span {AdjoinRoot.root f} := by
    ext r
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hnon]

  have hnf : ¬ IsField (AdjoinRoot f) := by
    intro hF
    have := (IsLocalRing.isField_iff_maximalIdeal_eq).mp hF
    rw [hmax, Ideal.span_singleton_eq_bot] at this
    exact hz0 this
  have hprin : (IsLocalRing.maximalIdeal (AdjoinRoot f)).IsPrincipal := ⟨⟨_, hmax⟩⟩
  have hdvr : IsDiscreteValuationRing (AdjoinRoot f) :=
    ((IsDiscreteValuationRing.TFAE (AdjoinRoot f) hnf).out 1 5).mpr hprin

  exact ⟨hdom, hdvr, hmax⟩

theorem wc_xnp_tube_conn : ∀ (A : Type u) [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A) → ∀ (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} → ∀ (r : ℕ) (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)] (a : Spec (.of C) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))), WeaklyEtale a → wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) (a (IsLocalRing.closedPoint C)) = IsLocalRing.closedPoint A → Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a (IsLocalRing.closedPoint C)) → Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a (IsLocalRing.closedPoint C)) → ∀ (L : Type u) [Field L] (φ : A →+* L), Function.Injective φ → ∀ (Pq : Scheme.{u}) (q1 : Pq ⟶ Spec (.of C)) (qL : Pq ⟶ Spec (.of L)), IsPullback q1 qL (a ≫ wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (Spec.map (CommRingCat.ofHom φ)) → ConnectedSpace Pq :=
by
  intro A _ _ _ _ _ ℓ _ hℓ π hπ r C _ _ _ a ha hy hx0 hx1 L _ φ hφ Pq q1 qL hT
  obtain ⟨B₁, _, _, _, Λ₁, _, _, W₁, φ₁, a₁, e₁, hI, haff, hcomp, hφa, hlim, hint, heq⟩ :=
    wc_et_geom_strict_henselization (a (IsLocalRing.closedPoint C))
  have hsh₁ : wcHalShData (a (IsLocalRing.closedPoint C)) B₁ Λ₁ W₁ φ₁ a₁ :=
    ⟨hI, haff, hcomp, hφa, hlim, e₁, hint, heq⟩
  have hresG : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
      (x : Spec (.of (IsLocalRing.ResidueField R))),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) x = IsLocalRing.closedPoint R := by
    intro R _ _ x
    rw [Spec.map_apply]
    exact (congrArg (PrimeSpectrum.comap (IsLocalRing.residue R))
      (Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField R)) x _)).trans
      ((IsLocalRing.isLocalHom_iff_comap_closedPoint (IsLocalRing.residue R)).mp inferInstance)
  obtain ⟨ε, -, hε⟩ := wc_pltr_wet_residue_geom_point (a (IsLocalRing.closedPoint C)) C a ha rfl
  have hq1 : (Spec.map (CommRingCat.ofHom ε) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue C)))
      (IsLocalRing.closedPoint (AlgebraicClosure
        ((Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))).residueField
          (a (IsLocalRing.closedPoint C))))) =
      IsLocalRing.closedPoint C :=
    (Scheme.Hom.comp_apply _ _ _).trans (hresG C _)
  have hq2 : (Spec.map (CommRingCat.ofHom ε) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue C))) ≫ a =
      wcEtGeomPt (Spec (.of (wcQuadModelRing A (r + 2) π (Matrix.of fun i j : Fin (r + 2) =>
          if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))) (a (IsLocalRing.closedPoint C)) :=
    (Category.assoc _ _ _).trans hε
  obtain ⟨δ, hδ, -⟩ := wc_shdata_lift_geom_point (a (IsLocalRing.closedPoint C)) B₁ Λ₁ W₁ φ₁ a₁
    hsh₁ C a _ hq1 hq2
  haveI hδiso : IsIso δ := wc_pltr_shens_lift_iso (a (IsLocalRing.closedPoint C)) B₁ Λ₁ W₁ φ₁ a₁
    hsh₁ C a ha rfl δ hδ
  have hconn := wc_qmssl_mfc_double A ℓ hℓ π hπ r (a (IsLocalRing.closedPoint C)) hy hx0 hx1
    B₁ Λ₁ W₁ φ₁ a₁ hsh₁ L φ hφ
  have eq₁ : (a ≫ wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) =>
        if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) ≫ 𝟙 _ =
      δ ≫ (a₁ ≫ wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) =>
        if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) := by
    rw [Category.comp_id, ← Category.assoc δ a₁, hδ]
  have eq₂ : Spec.map (CommRingCat.ofHom φ) ≫ 𝟙 _ = 𝟙 _ ≫ Spec.map (CommRingCat.ofHom φ) := by
    rw [Category.comp_id, Category.id_comp]
  haveI := Limits.pullback.map_isIso
    (a ≫ wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) =>
        if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
    (Spec.map (CommRingCat.ofHom φ))
    (a₁ ≫ wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) =>
        if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
    (Spec.map (CommRingCat.ofHom φ)) δ (𝟙 _) (𝟙 _) eq₁ eq₂
  let eT := asIso (Limits.pullback.map
    (a ≫ wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) =>
        if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
    (Spec.map (CommRingCat.ofHom φ))
    (a₁ ≫ wcQuadModelStr A (r + 2) π (Matrix.of fun i j : Fin (r + 2) =>
        if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
    (Spec.map (CommRingCat.ofHom φ)) δ (𝟙 _) (𝟙 _) eq₁ eq₂)
  let E := hT.isoPullback ≪≫ eT
  exact @Function.Surjective.connectedSpace _ _ _ hconn _ _
    (Scheme.homeoOfIso E.symm).surjective (Scheme.homeoOfIso E.symm).continuous

theorem wc_xnp_cover_local : ∀ (C : Type u) [CommRing C] [IsLocalRing C] (n : ℕ), 0 < n →
    ∀ (c0 c1 : C), c0 ∈ IsLocalRing.maximalIdeal C → c1 ∈ IsLocalRing.maximalIdeal C →
    Module.Finite C (wcXnpCov C n c0 c1) ∧ ∃ (_ : IsLocalRing (wcXnpCov C n c0 c1)),
      ∀ i : Fin 2, wcXnpY C n c0 c1 i ∈ IsLocalRing.maximalIdeal (wcXnpCov C n c0 c1) :=
by
  intro C _ _ n hn c0 c1 h0 h1
  classical
  have hn0 : n ≠ 0 := by omega
  have hgen : ∀ i : Fin 2,
      MvPolynomial.X i ^ n - MvPolynomial.C (![c0, c1] i) ∈ wcXnpCovIdeal C n c0 c1 := by
    intro i
    fin_cases i
    · exact Ideal.subset_span (by simp)
    · exact Ideal.subset_span (by simp)
  have hc : ∀ i : Fin 2, ![c0, c1] i ∈ IsLocalRing.maximalIdeal C := by
    intro i
    fin_cases i
    · simpa using h0
    · simpa using h1
  have hypow : ∀ i : Fin 2, wcXnpY C n c0 c1 i ^ n =
      algebraMap C (wcXnpCov C n c0 c1) (![c0, c1] i) := by
    intro i
    show Ideal.Quotient.mk (wcXnpCovIdeal C n c0 c1) (MvPolynomial.X i) ^ n = _
    rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, ← map_pow,
      Ideal.Quotient.eq]
    exact hgen i

  have hint : ∀ i : Fin 2, IsIntegral C (wcXnpY C n c0 c1 i) := by
    intro i
    refine ⟨Polynomial.X ^ n - Polynomial.C (![c0, c1] i),
      Polynomial.monic_X_pow_sub_C _ hn0, ?_⟩
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hypow, sub_self]
  have hadj : Algebra.adjoin C (Set.range (wcXnpY C n c0 c1)) = ⊤ := by
    have e : Set.range (wcXnpY C n c0 c1) =
        (Ideal.Quotient.mkₐ C (wcXnpCovIdeal C n c0 c1)) '' Set.range MvPolynomial.X := by
      rw [← Set.range_comp]
      rfl
    rw [e, Algebra.adjoin_image, MvPolynomial.adjoin_range_X, Algebra.map_top,
      AlgHom.range_eq_top]
    exact Ideal.Quotient.mkₐ_surjective C _
  have hfin : Module.Finite C (wcXnpCov C n c0 c1) := by
    rw [Module.finite_def, ← Algebra.top_toSubmodule, ← hadj]
    exact fg_adjoin_of_finite (Set.finite_range _) (by rintro _ ⟨i, rfl⟩; exact hint i)

  let f : MvPolynomial (Fin 2) C →+* IsLocalRing.ResidueField C :=
    (IsLocalRing.residue C).comp MvPolynomial.constantCoeff
  have hf : ∀ p, f p = IsLocalRing.residue C (MvPolynomial.constantCoeff p) := fun p => rfl
  have hIf : ∀ a ∈ wcXnpCovIdeal C n c0 c1, f a = 0 := by
    intro a ha
    have hle : wcXnpCovIdeal C n c0 c1 ≤ RingHom.ker f := by
      rw [Ideal.span_le]
      rintro x (rfl | rfl)
      · show f _ = 0
        rw [hf, map_sub, map_pow, MvPolynomial.constantCoeff_X, MvPolynomial.constantCoeff_C,
          zero_pow hn0, zero_sub, map_neg, neg_eq_zero, IsLocalRing.residue_eq_zero_iff]
        exact h0
      · show f _ = 0
        rw [hf, map_sub, map_pow, MvPolynomial.constantCoeff_X, MvPolynomial.constantCoeff_C,
          zero_pow hn0, zero_sub, map_neg, neg_eq_zero, IsLocalRing.residue_eq_zero_iff]
        exact h1
    exact hle ha
  let ev : wcXnpCov C n c0 c1 →+* IsLocalRing.ResidueField C :=
    Ideal.Quotient.lift _ f hIf
  have hev : ∀ p, ev (Ideal.Quotient.mk (wcXnpCovIdeal C n c0 c1) p) =
      IsLocalRing.residue C (MvPolynomial.constantCoeff p) := fun p => rfl
  have hsurj : Function.Surjective ev := by
    intro t
    obtain ⟨c, rfl⟩ := IsLocalRing.residue_surjective t
    exact ⟨Ideal.Quotient.mk _ (MvPolynomial.C c), by rw [hev, MvPolynomial.constantCoeff_C]⟩
  have hM0 : (RingHom.ker ev).IsMaximal := RingHom.ker_isMaximal_of_surjective ev hsurj
  have : Algebra.IsIntegral C (wcXnpCov C n c0 c1) := Algebra.IsIntegral.of_finite C _
  have key : ∀ M : Ideal (wcXnpCov C n c0 c1), M.IsMaximal →
      RingHom.ker ev ≤ M ∧ ∀ i, wcXnpY C n c0 c1 i ∈ M := by
    intro M hM
    have hunder : Ideal.comap (algebraMap C (wcXnpCov C n c0 c1)) M =
        IsLocalRing.maximalIdeal C :=
      IsLocalRing.eq_maximalIdeal (Ideal.IsMaximal.under C M)
    have halg : ∀ c ∈ IsLocalRing.maximalIdeal C,
        algebraMap C (wcXnpCov C n c0 c1) c ∈ M := by
      intro c hc
      rw [← hunder] at hc
      exact hc
    have hy : ∀ i, wcXnpY C n c0 c1 i ∈ M := by
      intro i
      apply hM.isPrime.mem_of_pow_mem n
      rw [hypow]
      exact halg _ (hc i)
    have hcong : ∀ p : MvPolynomial (Fin 2) C,
        Ideal.Quotient.mk (wcXnpCovIdeal C n c0 c1) p -
          algebraMap C (wcXnpCov C n c0 c1) (MvPolynomial.constantCoeff p) ∈ M := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a =>
        rw [MvPolynomial.constantCoeff_C, ← Ideal.Quotient.mk_algebraMap,
          MvPolynomial.algebraMap_eq, sub_self]
        exact M.zero_mem
      | add p q hp hq =>
        rw [map_add, map_add, map_add, add_sub_add_comm]
        exact M.add_mem hp hq
      | mul_X p j hp =>
        rw [map_mul, map_mul, MvPolynomial.constantCoeff_X, mul_zero, map_zero, sub_zero]
        exact M.mul_mem_left _ (hy j)
    refine ⟨?_, hy⟩
    intro d hd
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective d
    rw [RingHom.mem_ker, hev, IsLocalRing.residue_eq_zero_iff] at hd
    have h2 := M.add_mem (hcong p) (halg _ hd)
    rwa [sub_add_cancel] at h2
  have huniq : ∀ M : Ideal (wcXnpCov C n c0 c1), M.IsMaximal → M = RingHom.ker ev :=
    fun M hM => (hM0.eq_of_le hM.ne_top (key M hM).1).symm
  letI hloc : IsLocalRing (wcXnpCov C n c0 c1) :=
    IsLocalRing.of_unique_max_ideal ⟨RingHom.ker ev, hM0, huniq⟩
  exact ⟨hfin, hloc, fun i => (key _ (IsLocalRing.maximalIdeal.isMaximal _)).2 i⟩

theorem wc_xnp_cover_base_change : ∀ (A' : Type u) [CommRing A'] (ℓ r : ℕ) (π' : A'), 0 < ℓ →
    ∀ (C : Type u) [CommRing C] (αC : wcQuadModelRing A' (r + 2) π' (wcXnpC0 A' r) →+* C),
    WeaklyEtale (Spec.map (CommRingCat.ofHom αC)) →
    ∃ σ : wcXnpS A' ℓ π' r →+* wcXnpCov C ℓ (αC (wcXnpX0 A' r π'))
        (αC (wcXnpX1 A' r π')),
      σ (wcXnpX0 (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π')) =
        wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 0 ∧
      σ (wcXnpX1 (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π')) =
        wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 1 ∧
      σ (algebraMap (wcXnpEis A' ℓ π') (wcXnpS A' ℓ π' r) (wcXnpRho A' ℓ π')) =
        wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 0 *
        wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 1 ∧
      (∀ t : A', σ (algebraMap (wcXnpEis A' ℓ π') (wcXnpS A' ℓ π' r)
          (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C π') t)) =
        Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π'))
          (αC (wcXnpX1 A' r π')))
          (MvPolynomial.C (αC (algebraMap A' (wcQuadModelRing A' (r + 2) π' (wcXnpC0 A' r)) t)))) ∧
      WeaklyEtale (Spec.map (CommRingCat.ofHom σ)) :=
by
  intro A' _ ℓ r π' _hℓ C _ αC hαC
  classical

  have hsum : ∀ (A : Type u) [CommRing A],
      (∑ p : Fin (r + 2), ∑ q : Fin (r + 2), MvPolynomial.C ((wcXnpC0 A r) p q) *
        MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin (r + 2)) A) =
      MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) := by
    intro A _
    simp only [wcXnpC0, Matrix.of_apply]
    rw [Fintype.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
    · rw [Fintype.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
      · simp
      · intro q hq
        have : q.val ≠ 1 := fun h => hq (Fin.ext h)
        simp [this]
    · intro p hp
      have : p.val ≠ 0 := fun h => hp (Fin.ext h)
      simp [this]
  have hprod : ∀ (A : Type u) [CommRing A] (π : A),
      wcXnpX0 A r π * wcXnpX1 A r π = algebraMap A (wcQuadModelRing A (r + 2) π (wcXnpC0 A r)) π := by
    intro A _ π
    have hg0 : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcXnpC0 A r))
        (∑ p, ∑ q, MvPolynomial.C ((wcXnpC0 A r) p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C π) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
    rw [hsum A, map_sub, map_mul, sub_eq_zero] at hg0
    show Ideal.Quotient.mk _ _ * Ideal.Quotient.mk _ _ = _
    rw [hg0, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]

  have liftQ : ∀ (A : Type u) [CommRing A] (π : A) (T : Type u) [CommRing T] (f : A →+* T)
      (g : Fin (r + 2) → T), g ⟨0, by omega⟩ * g ⟨1, by omega⟩ = f π →
      ∃ L : wcQuadModelRing A (r + 2) π (wcXnpC0 A r) →+* T,
        (∀ i, L (wcXnpX A r π i) = g i) ∧
        ∀ t, L (algebraMap A (wcQuadModelRing A (r + 2) π (wcXnpC0 A r)) t) = f t := by
    intro A _ π T _ f g hg
    have hle : wcQuadModelIdeal A (r + 2) π (wcXnpC0 A r) ≤
        RingHom.ker (MvPolynomial.eval₂Hom f g) := by
      change Ideal.span {(∑ p : Fin (r + 2), ∑ q : Fin (r + 2), MvPolynomial.C ((wcXnpC0 A r) p q) *
        MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π)} ≤ _
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe,
        RingHom.mem_ker, hsum A, map_sub, map_mul, MvPolynomial.eval₂Hom_X',
        MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, hg, sub_self]
    refine ⟨Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom f g) (fun a ha => RingHom.mem_ker.mp (hle ha)), ?_, ?_⟩
    · intro i
      show Ideal.Quotient.lift _ _ _ (Ideal.Quotient.mk _ (MvPolynomial.X i)) = g i
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
    · intro t
      rw [← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq, Ideal.Quotient.lift_mk,
        MvPolynomial.eval₂Hom_C]
  have extQ : ∀ (A : Type u) [CommRing A] (π : A) (T : Type u) [CommRing T]
      (L1 L2 : wcQuadModelRing A (r + 2) π (wcXnpC0 A r) →+* T),
      (∀ i, L1 (wcXnpX A r π i) = L2 (wcXnpX A r π i)) →
      (∀ t, L1 (algebraMap A (wcQuadModelRing A (r + 2) π (wcXnpC0 A r)) t) =
        L2 (algebraMap A (wcQuadModelRing A (r + 2) π (wcXnpC0 A r)) t)) → L1 = L2 := by
    intro A _ π T _ L1 L2 h1 h2
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro t
      simp only [RingHom.comp_apply]
      rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
      exact h2 t
    · intro i
      exact h1 i

  have hρ : wcXnpRho A' ℓ π' ^ ℓ = AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C π') π' := by
    have h := AdjoinRoot.eval₂_root (Polynomial.X ^ ℓ - Polynomial.C π')
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, sub_eq_zero] at h
    exact h
  have hy0 : wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 0 ^ ℓ =
      Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')))
        (MvPolynomial.C (αC (wcXnpX0 A' r π'))) := by
    show Ideal.Quotient.mk _ (MvPolynomial.X 0) ^ ℓ = _
    rw [← map_pow, Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_insert _ _)
  have hy1 : wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 1 ^ ℓ =
      Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')))
        (MvPolynomial.C (αC (wcXnpX1 A' r π'))) := by
    show Ideal.Quotient.mk _ (MvPolynomial.X 1) ^ ℓ = _
    rw [← map_pow, Ideal.Quotient.eq]
    exact Ideal.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))

  obtain ⟨β, hβX, hβA⟩ := liftQ A' π' (wcXnpS A' ℓ π' r)
    ((algebraMap (wcXnpEis A' ℓ π') (wcXnpS A' ℓ π' r)).comp
      (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C π')))
    (fun i => if i.val = 0 then wcXnpX0 (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π') ^ ℓ
      else if i.val = 1 then wcXnpX1 (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π') ^ ℓ
      else wcXnpX (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π') i)
    (by
      show (if (0 : ℕ) = 0 then _ else _) *
        (if (1 : ℕ) = 0 then _ else if (1 : ℕ) = 1 then _ else _) =
        algebraMap (wcXnpEis A' ℓ π') (wcXnpS A' ℓ π' r)
          (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C π') π')
      rw [if_pos rfl, if_neg one_ne_zero, if_pos rfl, ← mul_pow, hprod (wcXnpEis A' ℓ π'),
        ← map_pow, hρ])
  have hβA' : ∀ t : A', β (algebraMap A' (wcQuadModelRing A' (r + 2) π' (wcXnpC0 A' r)) t) =
      algebraMap (wcXnpEis A' ℓ π') (wcXnpS A' ℓ π' r)
        (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C π') t) := fun t => hβA t
  have hβ0 : β (wcXnpX0 A' r π') = wcXnpX0 (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π') ^ ℓ := by
    rw [show wcXnpX0 A' r π' = wcXnpX A' r π' ⟨0, by omega⟩ from rfl, hβX]
    exact if_pos rfl
  have hβ1 : β (wcXnpX1 A' r π') = wcXnpX1 (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π') ^ ℓ := by
    rw [show wcXnpX1 A' r π' = wcXnpX A' r π' ⟨1, by omega⟩ from rfl, hβX]
    exact (if_neg one_ne_zero).trans (if_pos rfl)

  have hψev : Polynomial.eval₂
      ((Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')))).comp
        (MvPolynomial.C.comp (αC.comp (algebraMap A' (wcQuadModelRing A' (r + 2) π' (wcXnpC0 A' r))))))
      (wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 0 *
        wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 1)
      (Polynomial.X ^ ℓ - Polynomial.C π') = 0 := by
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, mul_pow, hy0, hy1]
    simp only [RingHom.comp_apply]
    rw [← hprod A', map_mul, map_mul, map_mul, sub_self]
  obtain ⟨ψ, hψρ, hψof⟩ : ∃ ψ : wcXnpEis A' ℓ π' →+*
      wcXnpCov C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')),
      ψ (wcXnpRho A' ℓ π') = wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 0 *
        wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 1 ∧
      ∀ t : A', ψ (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C π') t) =
        Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')))
          (MvPolynomial.C (αC (algebraMap A' (wcQuadModelRing A' (r + 2) π' (wcXnpC0 A' r)) t))) :=
    ⟨AdjoinRoot.lift _ _ hψev, AdjoinRoot.lift_root hψev, fun t => AdjoinRoot.lift_of hψev⟩
  obtain ⟨σ, hσX, hσA⟩ := liftQ (wcXnpEis A' ℓ π') (wcXnpRho A' ℓ π')
    (wcXnpCov C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π'))) ψ
    (fun i => if i.val = 0 then wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 0
      else if i.val = 1 then wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 1
      else Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')))
        (MvPolynomial.C (αC (wcXnpX A' r π' i))))
    (by
      show (if (0 : ℕ) = 0 then _ else _) *
        (if (1 : ℕ) = 0 then _ else if (1 : ℕ) = 1 then _ else _) = ψ (wcXnpRho A' ℓ π')
      rw [if_pos rfl, if_neg one_ne_zero, if_pos rfl, hψρ])
  have hσ0 : σ (wcXnpX0 (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π')) =
      wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 0 := by
    rw [show wcXnpX0 (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π') =
      wcXnpX (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π') ⟨0, by omega⟩ from rfl, hσX]
    exact if_pos rfl
  have hσ1 : σ (wcXnpX1 (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π')) =
      wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 1 := by
    rw [show wcXnpX1 (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π') =
      wcXnpX (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π') ⟨1, by omega⟩ from rfl, hσX]
    exact (if_neg one_ne_zero).trans (if_pos rfl)
  have hσρ : σ (algebraMap (wcXnpEis A' ℓ π') (wcXnpS A' ℓ π' r) (wcXnpRho A' ℓ π')) =
      wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 0 *
      wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 1 := (hσA _).trans hψρ
  have hσof : ∀ t : A', σ (algebraMap (wcXnpEis A' ℓ π') (wcXnpS A' ℓ π' r)
      (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C π') t)) =
      Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')))
        (MvPolynomial.C (αC (algebraMap A' (wcQuadModelRing A' (r + 2) π' (wcXnpC0 A' r)) t))) :=
    fun t => (hσA _).trans (hψof t)

  have hσβ : σ.comp β =
      ((Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')))).comp
        MvPolynomial.C).comp αC := by
    apply extQ A' π'
    · intro i
      show σ (β (wcXnpX A' r π' i)) = Ideal.Quotient.mk _ (MvPolynomial.C (αC (wcXnpX A' r π' i)))
      rw [hβX]
      by_cases h0 : i.val = 0
      · obtain rfl : i = ⟨0, Nat.succ_pos _⟩ := Fin.ext h0
        rw [if_pos h0, map_pow, hσ0, hy0]
      · by_cases h1 : i.val = 1
        · obtain rfl : i = ⟨1, Nat.succ_lt_succ (Nat.succ_pos _)⟩ := Fin.ext h1
          rw [if_neg h0, if_pos h1, map_pow, hσ1, hy1]
        · rw [if_neg h0, if_neg h1, hσX, if_neg h0, if_neg h1]
    · intro t
      show σ (β _) = Ideal.Quotient.mk _ (MvPolynomial.C (αC _))
      rw [hβA', hσof]
  have extD : ∀ (T : Type u) [CommRing T]
      (d1 d2 : wcXnpCov C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) →+* T),
      d1.comp ((Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π'))
        (αC (wcXnpX1 A' r π')))).comp MvPolynomial.C) =
      d2.comp ((Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π'))
        (αC (wcXnpX1 A' r π')))).comp MvPolynomial.C) →
      d1 (wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 0) =
        d2 (wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 0) →
      d1 (wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 1) =
        d2 (wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 1) → d1 = d2 := by
    intro T _ d1 d2 hC h0 h1
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro c
      exact RingHom.congr_fun hC c
    · intro j
      fin_cases j
      · exact h0
      · exact h1
  have liftD : ∀ (T : Type u) [CommRing T] (h1 : C →+* T) (a0 a1 : T),
      a0 ^ ℓ = h1 (αC (wcXnpX0 A' r π')) → a1 ^ ℓ = h1 (αC (wcXnpX1 A' r π')) →
      ∃ d : wcXnpCov C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) →+* T,
        d.comp ((Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π'))
          (αC (wcXnpX1 A' r π')))).comp MvPolynomial.C) = h1 ∧
        d (wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 0) = a0 ∧
        d (wcXnpY C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) 1) = a1 := by
    intro T _ h1 a0 a1 ha0 ha1
    have hle : wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) ≤
        RingHom.ker (MvPolynomial.eval₂Hom h1 ![a0, a1]) := by
      apply Ideal.span_le.mpr
      rw [Set.insert_subset_iff, Set.singleton_subset_iff]
      constructor
      · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_pow, MvPolynomial.eval₂Hom_X',
          MvPolynomial.eval₂Hom_C]
        simp [ha0]
      · rw [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_pow, MvPolynomial.eval₂Hom_X',
          MvPolynomial.eval₂Hom_C]
        simp [ha1]
    refine ⟨Ideal.Quotient.lift _ (MvPolynomial.eval₂Hom h1 ![a0, a1]) (fun a ha => RingHom.mem_ker.mp (hle ha)),
      ?_, ?_, ?_⟩
    · ext c
      simp only [RingHom.comp_apply]
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_C]
    · show Ideal.Quotient.lift _ _ _ (Ideal.Quotient.mk _ (MvPolynomial.X 0)) = a0
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
      simp
    · show Ideal.Quotient.lift _ _ _ (Ideal.Quotient.mk _ (MvPolynomial.X 1)) = a1
      rw [Ideal.Quotient.lift_mk, MvPolynomial.eval₂Hom_X']
      simp
  have univ : ∀ (T : Type u) [CommRing T] (h1 : C →+* T) (h2 : wcXnpS A' ℓ π' r →+* T),
      h1.comp αC = h2.comp β →
      ∃ d : wcXnpCov C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) →+* T,
        d.comp ((Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π'))
          (αC (wcXnpX1 A' r π')))).comp MvPolynomial.C) = h1 ∧ d.comp σ = h2 := by
    intro T _ h1 h2 hc
    have cond : ∀ x, h1 (αC x) = h2 (β x) := fun x => RingHom.congr_fun hc x
    obtain ⟨d, hdγ, hd0, hd1⟩ := liftD T h1
      (h2 (wcXnpX0 (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π')))
      (h2 (wcXnpX1 (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π')))
      (by rw [← map_pow, ← hβ0, cond]) (by rw [← map_pow, ← hβ1, cond])
    have hdC : ∀ c, d (Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π'))
        (αC (wcXnpX1 A' r π'))) (MvPolynomial.C c)) = h1 c := fun c => RingHom.congr_fun hdγ c
    refine ⟨d, hdγ, ?_⟩
    apply extQ (wcXnpEis A' ℓ π') (wcXnpRho A' ℓ π') T
    · intro i
      show d (σ (wcXnpX (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π') i)) =
        h2 (wcXnpX (wcXnpEis A' ℓ π') r (wcXnpRho A' ℓ π') i)
      rw [hσX]
      by_cases hi0 : i.val = 0
      · obtain rfl : i = ⟨0, Nat.succ_pos _⟩ := Fin.ext hi0
        rw [if_pos hi0]
        exact hd0
      · by_cases hi1 : i.val = 1
        · obtain rfl : i = ⟨1, Nat.succ_lt_succ (Nat.succ_pos _)⟩ := Fin.ext hi1
          rw [if_neg hi0, if_pos hi1]
          exact hd1
        · rw [if_neg hi0, if_neg hi1, hdC, cond, hβX, if_neg hi0, if_neg hi1]
    · intro e
      have hE : (d.comp σ).comp (algebraMap (wcXnpEis A' ℓ π') (wcXnpS A' ℓ π' r)) =
          h2.comp (algebraMap (wcXnpEis A' ℓ π') (wcXnpS A' ℓ π' r)) := by
        apply AdjoinRoot.ringHom_ext
        · ext t
          simp only [RingHom.comp_apply]
          rw [hσof, hdC, cond, hβA']
        · simp only [RingHom.comp_apply]
          rw [hσρ, map_mul, hd0, hd1, ← map_mul, hprod (wcXnpEis A' ℓ π')]
      exact RingHom.congr_fun hE e
  have uniqD : ∀ (T : Type u) [CommRing T]
      (d1 d2 : wcXnpCov C ℓ (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) →+* T),
      d1.comp ((Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π'))
        (αC (wcXnpX1 A' r π')))).comp MvPolynomial.C) =
      d2.comp ((Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π'))
        (αC (wcXnpX1 A' r π')))).comp MvPolynomial.C) →
      d1.comp σ = d2.comp σ → d1 = d2 := by
    intro T _ d1 d2 hγ hσ'
    apply extD T d1 d2 hγ
    · rw [← hσ0]
      exact RingHom.congr_fun hσ' _
    · rw [← hσ1]
      exact RingHom.congr_fun hσ' _
  have hcomm : CommRingCat.ofHom αC ≫ CommRingCat.ofHom
      ((Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π'))
        (αC (wcXnpX1 A' r π')))).comp MvPolynomial.C) =
      CommRingCat.ofHom β ≫ CommRingCat.ofHom σ := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hσβ]
  have hcond : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom αC) (CommRingCat.ofHom β),
      s.inl.hom.comp αC = s.inr.hom.comp β := by
    intro s
    have h := congrArg CommRingCat.Hom.hom s.condition
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at h
    exact h
  have hPO : IsPushout (CommRingCat.ofHom αC) (CommRingCat.ofHom β)
      (CommRingCat.ofHom ((Ideal.Quotient.mk (wcXnpCovIdeal C ℓ (αC (wcXnpX0 A' r π'))
        (αC (wcXnpX1 A' r π')))).comp MvPolynomial.C)) (CommRingCat.ofHom σ) := by
    refine IsPushout.of_isColimit (c := Limits.PushoutCocone.mk _ _ hcomm) ?_
    refine Limits.PushoutCocone.IsColimit.mk hcomm
      (fun s => CommRingCat.ofHom (Classical.choose (univ s.pt s.inl.hom s.inr.hom (hcond s))))
      ?_ ?_ ?_
    · intro s
      apply CommRingCat.hom_ext
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
      exact (Classical.choose_spec (univ s.pt s.inl.hom s.inr.hom (hcond s))).1
    · intro s
      apply CommRingCat.hom_ext
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
      exact (Classical.choose_spec (univ s.pt s.inl.hom s.inr.hom (hcond s))).2
    · intro s m hm1 hm2
      apply CommRingCat.hom_ext
      simp only [CommRingCat.hom_ofHom]
      have e1 := congrArg CommRingCat.Hom.hom hm1
      have e2 := congrArg CommRingCat.Hom.hom hm2
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] at e1 e2
      apply uniqD _ m.hom
      · rw [e1, (Classical.choose_spec (univ s.pt s.inl.hom s.inr.hom (hcond s))).1]
      · rw [e2, (Classical.choose_spec (univ s.pt s.inl.hom s.inr.hom (hcond s))).2]
  have hPB := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPO
  have hσet : WeaklyEtale (Spec.map (CommRingCat.ofHom σ)) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale) hPB hαC
  exact ⟨σ, hσ0, hσ1, hσρ, hσof, hσet⟩

theorem wc_xnp_gamma_pushout : ∀ (R C L : Type u) [CommRing R] [CommRing C] [CommRing L] (f : R →+* C) (g : R →+* L) (P : Scheme.{u}) (p1 : P ⟶ Spec (.of C)) (pL : P ⟶ Spec (.of L)), IsPullback p1 pL (Spec.map (CommRingCat.ofHom f)) (Spec.map (CommRingCat.ofHom g)) → IsPushout (CommRingCat.ofHom f) (CommRingCat.ofHom g) ((Scheme.ΓSpecIso (.of C)).inv ≫ p1.appTop) ((Scheme.ΓSpecIso (.of L)).inv ≫ pL.appTop) :=
by
  intro R C L _ _ _ f g P p1 pL hP
  have hW := IsPushout.of_hasPushout (CommRingCat.ofHom f) (CommRingCat.ofHom g)
  have hS := AlgebraicGeometry.isPullback_SpecMap_pushout (CommRingCat.ofHom f) (CommRingCat.ofHom g)
  have hfst := hP.isoIsPullback_hom_fst _ _ hS
  have hsnd := hP.isoIsPullback_hom_snd _ _ hS
  set e := hP.isoIsPullback _ _ hS with he
  let E : Limits.pushout (CommRingCat.ofHom f) (CommRingCat.ofHom g) ≅ Γ(P, ⊤) :=
    (Scheme.ΓSpecIso _).symm ≪≫ Scheme.Γ.mapIso e.op
  have hE : E.hom = (Scheme.ΓSpecIso _).inv ≫ e.hom.appTop := rfl
  refine IsPushout.of_iso hW (Iso.refl _) (Iso.refl _) (Iso.refl _) E (by simp) (by simp) ?_ ?_
  · rw [hE, Iso.refl_hom, Category.id_comp, ← Category.assoc, Scheme.ΓSpecIso_inv_naturality,
      Category.assoc, ← Scheme.Hom.comp_appTop, hfst]
  · rw [hE, Iso.refl_hom, Category.id_comp, ← Category.assoc, Scheme.ΓSpecIso_inv_naturality,
      Category.assoc, ← Scheme.Hom.comp_appTop, hsnd]

theorem wc_xnp_kummer_pushout : ∀ (A' C L K : Type u) [CommRing A'] [CommRing C] [CommRing L] [CommRing K]
    (ℓ : ℕ), 0 < ℓ → ∀ (π' : A') (g : A' →+* C) (φ' : A' →+* L) (κC : C →+* K) (κL : L →+* K),
    IsPushout (CommRingCat.ofHom g) (CommRingCat.ofHom φ') (CommRingCat.ofHom κC) (CommRingCat.ofHom κL) →
    ∀ (c0 c1 : C), c0 * c1 = g π' → IsUnit (κC c0) →
    ∀ (φ'' : wcXnpEis A' ℓ π' →+* L), φ''.comp (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C π')) = φ' →
    ∀ (ψ : wcXnpEis A' ℓ π' →+* wcXnpCov C ℓ c0 c1),
      ψ (wcXnpRho A' ℓ π') = wcXnpY C ℓ c0 c1 0 * wcXnpY C ℓ c0 c1 1 →
      (∀ t : A', ψ (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C π') t) =
        Ideal.Quotient.mk (wcXnpCovIdeal C ℓ c0 c1) (MvPolynomial.C (g t))) →
    ∃ θD : wcXnpCov C ℓ c0 c1 →+* wcXnpEis K ℓ (κC c0),
      IsPushout (CommRingCat.ofHom ψ) (CommRingCat.ofHom φ'') (CommRingCat.ofHom θD)
        (CommRingCat.ofHom ((AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C (κC c0))).comp κL)) :=
by
  intro A' C L K _ _ _ _ ℓ hℓ π' g φ' κC κL hPO c0 c1 hc01 hu φ'' hφ'' ψ hψρ hψof
  obtain ⟨m, rfl⟩ : ∃ m, ℓ = m + 1 := ⟨ℓ - 1, by omega⟩
  obtain ⟨w, huw⟩ := hu.exists_right_inv
  dsimp only [wcXnpRho, wcXnpY] at hψρ

  have hpt : ∀ {X Y Z : CommRingCat.{u}} (f : X ⟶ Y) (h : Y ⟶ Z) (k : X ⟶ Z), f ≫ h = k →
      ∀ x, h.hom (f.hom x) = k.hom x := by
    intro X Y Z f h k e x
    rw [← e]
    rfl
  have hcomm : ∀ t, κC (g t) = κL (φ' t) := fun t => hpt _ _ _ hPO.w t
  have hφ''t : ∀ t, φ'' (AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C π') t) = φ' t :=
    fun t => RingHom.congr_fun hφ'' t
  have hroot : ∀ (R : Type u) [CommRing R] (a : R),
      (AdjoinRoot.root (Polynomial.X ^ (m + 1) - Polynomial.C a)) ^ (m + 1) =
        AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C a) a := by
    intro R _ a
    have h := AdjoinRoot.eval₂_root (Polynomial.X ^ (m + 1) - Polynomial.C a)
    rwa [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, sub_eq_zero] at h
  have hy0 : (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.X 0)) ^ (m + 1) =
      Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.C c0) := by
    rw [← map_pow, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.subset_span (Set.mem_insert _ _)
  have he : (κL (φ'' (AdjoinRoot.root (Polynomial.X ^ (m + 1) - Polynomial.C π')))) ^ (m + 1) =
      κC c0 * κC c1 := by
    rw [← map_pow κL, ← map_pow φ'', hroot, hφ''t, ← hcomm, ← map_mul κC, hc01]
  have hθpow := hroot K (κC c0)
  have hbpow : (AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))
        (κL (φ'' (AdjoinRoot.root (Polynomial.X ^ (m + 1) - Polynomial.C π'))) * w) *
      (AdjoinRoot.root (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))) ^ m) ^ (m + 1) =
      AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0)) (κC c1) := by
    have hK : (κL (φ'' (AdjoinRoot.root (Polynomial.X ^ (m + 1) - Polynomial.C π'))) * w) ^ (m + 1) *
        (κC c0) ^ m = κC c1 := by
      rw [mul_pow, he]
      calc κC c0 * κC c1 * w ^ (m + 1) * κC c0 ^ m = κC c1 * (κC c0 * w) ^ (m + 1) := by ring
        _ = κC c1 := by rw [huw, one_pow, mul_one]
    rw [mul_pow, ← pow_mul, mul_comm m (m + 1), pow_mul, hθpow,
      ← map_pow (AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))),
      ← map_pow (AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))),
      ← map_mul (AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))), hK]

  have hgen : ∀ (R : Type u) [CommRing R] (f : C →+* R) (a0 a1 : R), a0 ^ (m + 1) = f c0 →
      a1 ^ (m + 1) = f c1 →
      ∃ χ : wcXnpCov C (m + 1) c0 c1 →+* R,
        (∀ c, χ (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.C c)) = f c) ∧
        χ (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.X 0)) = a0 ∧
        χ (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.X 1)) = a1 := by
    intro R _ f a0 a1 h0 h1
    have hle : wcXnpCovIdeal C (m + 1) c0 c1 ≤ RingHom.ker (MvPolynomial.eval₂Hom f ![a0, a1]) := by
      apply Ideal.span_le.mpr
      intro p hp
      rcases hp with rfl | rfl
      · simp [h0]
      · simp [h1]
    refine ⟨Ideal.Quotient.lift _ _ (fun a ha => RingHom.mem_ker.mp (hle ha)), ?_, ?_, ?_⟩
    · intro c; simp
    · simp
    · simp

  have hext : ∀ (R : Type u) [CommRing R] (χ χ' : wcXnpCov C (m + 1) c0 c1 →+* R),
      (∀ c, χ (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.C c)) =
        χ' (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.C c))) →
      χ (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.X 0)) =
        χ' (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.X 0)) →
      χ (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.X 1)) =
        χ' (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.X 1)) → χ = χ' := by
    intro R _ χ χ' hC h0 h1
    apply Ideal.Quotient.ringHom_ext
    apply MvPolynomial.ringHom_ext
    · intro c; exact hC c
    · intro i
      revert i
      exact Fin.forall_fin_two.mpr ⟨h0, h1⟩

  obtain ⟨θD, hθDC0, hθD0, hθD1⟩ := hgen (wcXnpEis K (m + 1) (κC c0))
    ((AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))).comp κC)
    (AdjoinRoot.root (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0)))
    (AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))
        (κL (φ'' (AdjoinRoot.root (Polynomial.X ^ (m + 1) - Polynomial.C π'))) * w) *
      (AdjoinRoot.root (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))) ^ m) hθpow hbpow
  have hθDC : ∀ c, θD (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.C c)) =
      AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0)) (κC c) := hθDC0

  have hsq : CommSq (CommRingCat.ofHom ψ) (CommRingCat.ofHom φ'') (CommRingCat.ofHom θD)
      (CommRingCat.ofHom ((AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))).comp κL)) := by
    constructor
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 1
    apply AdjoinRoot.ringHom_ext
    · ext t
      simp only [RingHom.comp_apply]
      rw [hψof, hθDC, hφ''t, hcomm]
    · simp only [RingHom.comp_apply]
      rw [hψρ, map_mul, hθD0, hθD1]
      calc _ = AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))
            (κL (φ'' (AdjoinRoot.root (Polynomial.X ^ (m + 1) - Polynomial.C π'))) * w) *
            (AdjoinRoot.root (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))) ^ (m + 1) := by ring
        _ = _ := by
          rw [hθpow, ← map_mul (AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))),
            mul_assoc, mul_comm w, huw, mul_one]

  have hdesc : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom ψ) (CommRingCat.ofHom φ''),
      ∃ M : CommRingCat.of (wcXnpEis K (m + 1) (κC c0)) ⟶ s.pt,
        CommRingCat.ofHom θD ≫ M = s.inl ∧
        CommRingCat.ofHom ((AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))).comp κL)
          ≫ M = s.inr := by
    intro s
    have hcond : ∀ x, s.inl.hom (ψ x) = s.inr.hom (φ'' x) := fun x => hpt _ _ _ s.condition x
    have hk : CommRingCat.ofHom g ≫ (CommRingCat.ofHom
        ((Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1)).comp MvPolynomial.C) ≫ s.inl) =
        CommRingCat.ofHom φ' ≫ s.inr := by
      apply CommRingCat.hom_ext
      ext t
      change s.inl.hom (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.C (g t))) =
        s.inr.hom (φ' t)
      rw [← hψof, hcond, hφ''t]
    obtain ⟨k, hkC, hkL⟩ : ∃ k : CommRingCat.of K ⟶ s.pt,
        (∀ c, k.hom (κC c) =
          s.inl.hom (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.C c))) ∧
        (∀ x, k.hom (κL x) = s.inr.hom x) :=
      ⟨hPO.desc _ _ hk, fun c => hpt _ _ _ (hPO.inl_desc _ _ hk) c,
        fun x => hpt _ _ _ (hPO.inr_desc _ _ hk) x⟩
    have hU : (s.inl.hom (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.X 0))) ^
        (m + 1) = k.hom (κC c0) := by
      rw [← map_pow, hy0, hkC]
    have hev : Polynomial.eval₂ k.hom
        (s.inl.hom (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.X 0)))
        (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0)) = 0 := by
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hU, sub_self]
    have hUW : k.hom (κC c0) * k.hom w = 1 := by rw [← map_mul, huw, map_one]
    refine ⟨CommRingCat.ofHom (AdjoinRoot.lift k.hom _ hev), ?_, ?_⟩
    · apply CommRingCat.hom_ext
      rw [CommRingCat.hom_comp, CommRingCat.hom_ofHom, CommRingCat.hom_ofHom]
      apply hext
      · intro c
        rw [RingHom.comp_apply, hθDC, AdjoinRoot.lift_of, hkC]
      · rw [RingHom.comp_apply, hθD0, AdjoinRoot.lift_root]
      · simp only [RingHom.comp_apply, hθD1, map_mul, map_pow, AdjoinRoot.lift_of,
          AdjoinRoot.lift_root]
        rw [hkL, ← hcond, hψρ, map_mul]
        linear_combination
          (s.inl.hom (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.X 1)) *
            k.hom w) * hU +
          s.inl.hom (Ideal.Quotient.mk (wcXnpCovIdeal C (m + 1) c0 c1) (MvPolynomial.X 1)) * hUW
    · apply CommRingCat.hom_ext
      ext x
      change AdjoinRoot.lift k.hom _ hev
        (AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0)) (κL x)) = s.inr.hom x
      rw [AdjoinRoot.lift_of, hkL]

  have huniq : ∀ s : Limits.PushoutCocone (CommRingCat.ofHom ψ) (CommRingCat.ofHom φ''),
      ∀ M M' : CommRingCat.of (wcXnpEis K (m + 1) (κC c0)) ⟶ s.pt,
        CommRingCat.ofHom θD ≫ M = s.inl →
        CommRingCat.ofHom ((AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))).comp κL)
          ≫ M = s.inr →
        CommRingCat.ofHom θD ≫ M' = s.inl →
        CommRingCat.ofHom ((AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))).comp κL)
          ≫ M' = s.inr → M = M' := by
    intro s M M' h1 h2 h1' h2'
    have e1 : ∀ x, M.hom (θD x) = s.inl.hom x := hpt _ _ _ h1
    have e1' : ∀ x, M'.hom (θD x) = s.inl.hom x := hpt _ _ _ h1'
    have e2 : ∀ x, M.hom (AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0)) (κL x)) =
        s.inr.hom x := hpt _ _ _ h2
    have e2' : ∀ x, M'.hom (AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0)) (κL x)) =
        s.inr.hom x := hpt _ _ _ h2'
    have hof : CommRingCat.ofHom (AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))) ≫ M =
        CommRingCat.ofHom (AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0))) ≫ M' := by
      apply hPO.hom_ext
      · apply CommRingCat.hom_ext
        ext c
        change M.hom (AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0)) (κC c)) =
          M'.hom (AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0)) (κC c))
        rw [← hθDC, e1, e1']
      · apply CommRingCat.hom_ext
        ext x
        change M.hom (AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0)) (κL x)) =
          M'.hom (AdjoinRoot.of (Polynomial.X ^ (m + 1) - Polynomial.C (κC c0)) (κL x))
        rw [e2, e2']
    apply CommRingCat.hom_ext
    apply AdjoinRoot.ringHom_ext
    · exact congrArg CommRingCat.Hom.hom hof
    · rw [← hθD0, e1, e1']
  choose desc hdl hdr using hdesc
  refine ⟨θD, IsPushout.of_isColimit' hsq ?_⟩
  exact Limits.PushoutCocone.IsColimit.mk hsq.w desc hdl hdr
    (fun s M e1 e2 => huniq s M (desc s) e1 e2 (hdl s) (hdr s))

theorem wc_qsfx_x0_not_pow : ∀ (A' : Type u) [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A') →
    ∀ (π' : A'), IsLocalRing.maximalIdeal A' = Ideal.span {π'} →
    ∀ (r : ℕ) (C : Type u) [CommRing C] [HenselianLocalRing C]
      [IsSepClosed (IsLocalRing.ResidueField C)]
      (a : Spec (.of C) ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))),
    WeaklyEtale a →
    wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)
        (a (IsLocalRing.closedPoint C)) = IsLocalRing.closedPoint A' →
    ∀ (L' : Type u) [Field L'] [IsSepClosed L'] (φ' : A' →+* L'), Function.Injective φ' →
    (letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L') →
    ∀ (Pq : Scheme.{u}) (q1 : Pq ⟶ Spec (.of C)) (qL : Pq ⟶ Spec (.of L')),
    IsPullback q1 qL (a ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom φ')) →
    Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (a (IsLocalRing.closedPoint C)) →
    Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (a (IsLocalRing.closedPoint C)) →
    ¬ ∃ v : Γ(Pq, ⊤), v ^ ℓ =
        q1.appTop.hom ((Scheme.ΓSpecIso (CommRingCat.of C)).inv.hom ((Spec.preimage a).hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
            (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))))) :=
by
  intro A' _ _ _ _ _ ℓ _ hℓ π' hπ' r C _ _ _ a ha hcl L' _ _ φ' hφ' halg Pq q1 qL hT hD0 hD1 hex
  obtain ⟨v, hv⟩ := hex
  have hp : ℓ.Prime := Fact.out
  have hℓpos : 0 < ℓ := hp.pos
  have hℓ1 : 1 < ℓ := hp.one_lt
  have huq := wc_qsfx_uq_isUnit A' π' hπ' r C a L' φ' hφ' Pq q1 qL hT

  have kummer : ∀ (K : Type u) [CommRing K] (u w : K), IsUnit ((ℓ : ℕ) : K) → IsUnit u → w ^ ℓ = u →
      ∀ ζ : K, ζ ^ ℓ = 1 → ∑ i ∈ Finset.range ℓ, ζ ^ i = 0 →
      Nontrivial (wcXnpEis K ℓ u) → (∀ e : wcXnpEis K ℓ u, IsIdempotentElem e → e = 0 ∨ e = 1) →
      False := by
    intro K _ u w hℓu hu hw ζ hζ hζs hnt hid
    have hwu : IsUnit w := (isUnit_pow_iff hp.ne_zero).mp (hw ▸ hu)
    obtain ⟨w', hww'⟩ : ∃ w' : K, w * w' = 1 := ⟨_, hwu.mul_val_inv⟩
    obtain ⟨li, hli⟩ : ∃ li : K, ((ℓ : ℕ) : K) * li = 1 := ⟨_, hℓu.mul_val_inv⟩
    obtain ⟨of, θ, hθℓ, hlift⟩ : ∃ (of : K →+* wcXnpEis K ℓ u) (θ : wcXnpEis K ℓ u), θ ^ ℓ = of u ∧
        ∀ c : K, c ^ ℓ = u → ∃ χ : wcXnpEis K ℓ u →+* K, χ θ = c ∧ ∀ x, χ (of x) = x := by
      refine ⟨AdjoinRoot.of _, AdjoinRoot.root _, ?_, ?_⟩
      · have h := AdjoinRoot.eval₂_root (Polynomial.X ^ ℓ - Polynomial.C u)
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, sub_eq_zero] at h
        exact h
      · intro c hc
        have hev : Polynomial.eval₂ (RingHom.id K) c (Polynomial.X ^ ℓ - Polynomial.C u) = 0 := by
          rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, RingHom.id_apply, hc,
            sub_self]
        exact ⟨AdjoinRoot.lift (RingHom.id K) c hev, AdjoinRoot.lift_root hev,
          fun x => AdjoinRoot.lift_of hev⟩
    obtain ⟨χ0, hχ0θ, hχ0of⟩ := hlift w hw
    obtain ⟨χ1, hχ1θ, hχ1of⟩ := hlift (ζ * w) (by rw [mul_pow, hζ, one_mul, hw])
    have huw : u * w' ^ ℓ = 1 := by rw [← hw, ← mul_pow, hww', one_pow]
    obtain ⟨t, ht⟩ : ∃ t, t = θ * of w' := ⟨_, rfl⟩
    have htℓ : t ^ ℓ = 1 := by
      rw [ht, mul_pow, hθℓ, ← map_pow, ← map_mul, huw, map_one]
    have hχ0t : χ0 t = 1 := by rw [ht, map_mul, hχ0θ, hχ0of, hww']
    have hχ1t : χ1 t = ζ := by rw [ht, map_mul, hχ1θ, hχ1of, mul_assoc, hww', mul_one]
    obtain ⟨S, hS⟩ : ∃ S, S = ∑ i ∈ Finset.range ℓ, t ^ i := ⟨_, rfl⟩
    have htS : t * S = S := by
      have h := (geom_sum_succ (x := t) (n := ℓ)).symm.trans (geom_sum_succ' (x := t) (n := ℓ))
      rw [htℓ, ← hS] at h
      linear_combination h
    have htiS : ∀ i : ℕ, t ^ i * S = S := by
      intro i
      induction i with
      | zero => rw [pow_zero, one_mul]
      | succ n ih => rw [pow_succ, mul_assoc, htS, ih]
    have hSS : S * S = ((ℓ : ℕ) : wcXnpEis K ℓ u) * S := by
      calc S * S = ∑ i ∈ Finset.range ℓ, t ^ i * S := by rw [← Finset.sum_mul, ← hS]
        _ = ∑ i ∈ Finset.range ℓ, S := Finset.sum_congr rfl (fun i _ => htiS i)
        _ = ((ℓ : ℕ) : wcXnpEis K ℓ u) * S := by
          rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    have hl : of li * ((ℓ : ℕ) : wcXnpEis K ℓ u) = 1 := by
      rw [← map_natCast of ℓ, ← map_mul, mul_comm li, hli, map_one]
    have hide : IsIdempotentElem (of li * S) := by
      unfold IsIdempotentElem
      calc of li * S * (of li * S) = of li * (of li * (S * S)) := by ring
        _ = (of li * ((ℓ : ℕ) : wcXnpEis K ℓ u)) * (of li * S) := by rw [hSS]; ring
        _ = of li * S := by rw [hl, one_mul]
    have h0 : χ0 (of li * S) = 1 := by
      rw [map_mul, hχ0of, hS, map_sum]
      simp only [map_pow, hχ0t, one_pow, Finset.sum_const, Finset.card_range, nsmul_eq_mul, mul_one]
      linear_combination hli
    have h1 : χ1 (of li * S) = 0 := by
      rw [map_mul, hχ1of, hS, map_sum]
      simp only [map_pow, hχ1t]
      rw [hζs, mul_zero]
    have hK : (1 : K) ≠ 0 := by
      intro h10
      apply one_ne_zero (α := wcXnpEis K ℓ u)
      rw [← map_one of, h10, map_zero]
    rcases hid _ hide with h | h
    · apply hK
      rw [← h0, h, map_zero]
    · apply hK
      calc (1 : K) = χ1 1 := (map_one χ1).symm
        _ = χ1 (of li * S) := by rw [h]
        _ = 0 := h1

  have connIdem : ∀ (R : Type u) [CommRing R], ConnectedSpace (PrimeSpectrum R) →
      Nontrivial R ∧ ∀ e : R, IsIdempotentElem e → e = 0 ∨ e = 1 := by
    intro R _ hc
    have hne : Nonempty (PrimeSpectrum R) := ConnectedSpace.toNonempty
    refine ⟨PrimeSpectrum.nonempty_iff_nontrivial.mp hne, fun e he => ?_⟩
    have key : ∀ f : R, IsIdempotentElem f →
        (PrimeSpectrum.basicOpen f : Set (PrimeSpectrum R)) = ∅ → f = 0 := by
      intro f hf h
      apply hf.eq_zero_of_isNilpotent
      rw [← PrimeSpectrum.basicOpen_eq_bot_iff]
      exact TopologicalSpace.Opens.ext (by rw [h, TopologicalSpace.Opens.coe_bot])
    rcases isClopen_iff.mp (PrimeSpectrum.isClopen_iff.mpr ⟨e, he, rfl⟩) with h | h
    · exact Or.inl (key e he h)
    · right
      rcases isClopen_iff.mp (PrimeSpectrum.isClopen_iff.mpr ⟨1 - e, he.one_sub, rfl⟩) with h' | h'
      · exact (sub_eq_zero.mp (key _ he.one_sub h')).symm
      · exfalso
        obtain ⟨x⟩ := hne
        have hx1 : x ∈ PrimeSpectrum.basicOpen e := by
          rw [← SetLike.mem_coe, h]; exact Set.mem_univ x
        have hx2 : x ∈ PrimeSpectrum.basicOpen (1 - e) := by
          rw [← SetLike.mem_coe, h']; exact Set.mem_univ x
        have h0 : e * (1 - e) ∈ x.asIdeal := by
          rw [mul_sub, mul_one, he.eq, sub_self]; exact x.asIdeal.zero_mem
        rcases x.isPrime.mem_or_mem h0 with h2 | h2
        · exact (PrimeSpectrum.mem_basicOpen _ _).mp hx1 h2
        · exact (PrimeSpectrum.mem_basicOpen _ _).mp hx2 h2

  set αC := (Spec.preimage a).hom with hαC
  have ha' : a = Spec.map (CommRingCat.ofHom αC) := by
    rw [hαC, CommRingCat.ofHom_hom, Spec.map_preimage]
  rw [ha'] at hT hD0 hD1 ha
  set κC : C →+* Γ(Pq, ⊤) := ((Scheme.ΓSpecIso (CommRingCat.of C)).inv ≫ q1.appTop).hom with hκC
  set κL : L' →+* Γ(Pq, ⊤) := ((Scheme.ΓSpecIso (CommRingCat.of L')).inv ≫ qL.appTop).hom with hκL
  set g : A' →+* C := αC.comp (algebraMap A' (wcQuadModelRing A' (r + 2) π' (wcXnpC0 A' r))) with hg
  have hc0 : αC (wcXnpX0 A' r π') ∈ IsLocalRing.maximalIdeal C := hD0
  have hc1 : αC (wcXnpX1 A' r π') ∈ IsLocalRing.maximalIdeal C := hD1
  have hx01 : Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π' (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) * Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π' (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) = algebraMap A' (wcQuadModelRing A' (r + 2) π' (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) π' := by
    have hg0 : Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π' (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)) (∑ p, ∑ q, MvPolynomial.C ((Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) p q) * MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π') = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
    have hsum : (∑ p : Fin (r + 2), ∑ q : Fin (r + 2), MvPolynomial.C ((Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) p q) * MvPolynomial.X p * MvPolynomial.X q : MvPolynomial (Fin (r + 2)) A') = MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) := by
      simp only [Matrix.of_apply]
      rw [Fintype.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
      · rw [Fintype.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
        · simp
        · intro q hq
          have : q.val ≠ 1 := fun h => hq (Fin.ext h)
          simp [this]
      · intro p hp
        have : p.val ≠ 0 := fun h => hp (Fin.ext h)
        simp [this]
    rw [hsum, map_sub, map_mul, sub_eq_zero] at hg0
    rw [hg0, ← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
  have hc01 : αC (wcXnpX0 A' r π') * αC (wcXnpX1 A' r π') = g π' := by
    show αC _ * αC _ = αC (algebraMap A' _ π')
    rw [← map_mul, hx01]
  have hstr : Spec.map (CommRingCat.ofHom αC) ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
      Spec.map (CommRingCat.ofHom g) := by
    show Spec.map _ ≫ Spec.map _ = _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    try rfl
  rw [hstr] at hT
  have hPO : IsPushout (CommRingCat.ofHom g) (CommRingCat.ofHom φ') (CommRingCat.ofHom κC)
      (CommRingCat.ofHom κL) := wc_xnp_gamma_pushout A' C L' g φ' Pq q1 qL hT

  have hπ0 : π' ≠ 0 := by
    intro h
    apply IsDiscreteValuationRing.not_a_field A'
    rw [hπ', h, Ideal.span_singleton_eq_bot.mpr rfl]
  have hφπ0 : φ' π' ≠ 0 := fun h => hπ0 (hφ' (h.trans (map_zero φ').symm))
  have hℓL : ((ℓ : ℕ) : L') ≠ 0 := by
    have h := hℓ.map φ'
    rw [map_natCast] at h
    exact h.ne_zero
  have hℓK : IsUnit ((ℓ : ℕ) : Γ(Pq, ⊤)) := by
    have h := hℓ.map (κL.comp φ')
    rw [map_natCast] at h
    exact h

  haveI : NeZero ((ℓ : ℕ) : L') := ⟨hℓL⟩
  obtain ⟨ζL, hζL⟩ : ∃ ζL : L', IsPrimitiveRoot ζL ℓ := by
    have hsep : (Polynomial.cyclotomic ℓ L').Separable :=
      (Polynomial.separable_X_pow_sub_C (1 : L') hℓL one_ne_zero).of_dvd
        (by rw [map_one]; exact Polynomial.cyclotomic.dvd_X_pow_sub_one ℓ L')
    have hdeg : (Polynomial.cyclotomic ℓ L').degree ≠ 0 := by
      rw [Polynomial.degree_cyclotomic, Nat.totient_prime hp]
      have h1 : ℓ - 1 ≠ 0 := by omega
      exact_mod_cast h1
    obtain ⟨z, hz⟩ := IsSepClosed.exists_root _ hdeg hsep
    exact ⟨z, Polynomial.isRoot_cyclotomic_iff.mp hz⟩
  have hζ1 : (κL ζL) ^ ℓ = 1 := by rw [← map_pow, hζL.pow_eq_one, map_one]
  have hζsum : ∑ i ∈ Finset.range ℓ, (κL ζL) ^ i = 0 := by
    have h := congrArg κL (hζL.geom_sum_eq_zero hℓ1)
    rw [map_sum, map_zero] at h
    simpa only [map_pow] using h

  obtain ⟨hdomE, hdvrE, hmE⟩ := wc_xnp_eis_dvr A' ℓ π' hπ'
  haveI : Module.Finite A' (wcXnpEis A' ℓ π') :=
    (Polynomial.monic_X_pow_sub_C π' hp.ne_zero).finite_adjoinRoot
  haveI : Algebra.IsIntegral A' (wcXnpEis A' ℓ π') := Algebra.IsIntegral.of_finite A' _
  obtain ⟨hHensE, hSepE⟩ := wc_integral_over_strictly_henselian A' (wcXnpEis A' ℓ π') inferInstance
  have hℓE : IsUnit ((ℓ : ℕ) : wcXnpEis A' ℓ π') := by
    have h := hℓ.map (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C π'))
    rw [map_natCast] at h
    exact h

  obtain ⟨ρL, hρL⟩ := IsSepClosed.exists_root (Polynomial.X ^ ℓ - Polynomial.C (φ' π'))
    (by rw [Polynomial.degree_X_pow_sub_C hℓpos]; exact_mod_cast hp.ne_zero)
    (Polynomial.separable_X_pow_sub_C _ hℓL hφπ0)
  have hρL' : ρL ^ ℓ = φ' π' := by
    have h : Polynomial.eval ρL (Polynomial.X ^ ℓ - Polynomial.C (φ' π')) = 0 := hρL
    rw [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
      sub_eq_zero] at h
    exact h
  have hev : Polynomial.eval₂ φ' ρL (Polynomial.X ^ ℓ - Polynomial.C π') = 0 := by
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, hρL', sub_self]
  obtain ⟨φ'', hφ''c⟩ : ∃ φ'' : wcXnpEis A' ℓ π' →+* L',
      φ''.comp (AdjoinRoot.of (Polynomial.X ^ ℓ - Polynomial.C π')) = φ' :=
    ⟨AdjoinRoot.lift φ' ρL hev, RingHom.ext fun t => AdjoinRoot.lift_of hev⟩
  have hφ''inj : Function.Injective φ'' := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    by_contra hx0
    apply Ideal.comap_ne_bot_of_integral_mem (R := A') (I := RingHom.ker φ'') hx0
      (RingHom.mem_ker.mpr hx) (Algebra.IsIntegral.isIntegral x)
    rw [eq_bot_iff]
    intro t ht
    have h1 : φ'' (algebraMap A' (wcXnpEis A' ℓ π') t) = 0 := RingHom.mem_ker.mp (Ideal.mem_comap.mp ht)
    rw [AdjoinRoot.algebraMap_eq] at h1
    have h2 : φ' t = 0 := by rw [← hφ''c]; exact h1
    exact (Ideal.mem_bot).mpr (hφ' (h2.trans (map_zero φ').symm))

  obtain ⟨hfinD, hlocD, hyD⟩ := wc_xnp_cover_local C ℓ hℓpos _ _ hc0 hc1
  haveI : Algebra.IsIntegral C (wcXnpCov C ℓ (αC (wcXnpX0 A' r π'))
      (αC (wcXnpX1 A' r π'))) := Algebra.IsIntegral.of_finite C _
  obtain ⟨hHensD, hSepD⟩ := wc_integral_over_strictly_henselian C (wcXnpCov C ℓ
    (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π'))) inferInstance

  obtain ⟨σ, hσ0, hσ1, hσρ, hσof, hσet⟩ := wc_xnp_cover_base_change A' ℓ r π' hℓpos C αC ha
  set ψ : wcXnpEis A' ℓ π' →+* wcXnpCov C ℓ (αC (wcXnpX0 A' r π'))
      (αC (wcXnpX1 A' r π')) :=
    σ.comp (algebraMap (wcXnpEis A' ℓ π') (wcXnpS A' ℓ π' r)) with hψ

  obtain ⟨θD, hPO2⟩ := wc_xnp_kummer_pushout A' C L' Γ(Pq, ⊤) ℓ hℓpos π' g φ' κC κL hPO
    (αC (wcXnpX0 A' r π')) (αC (wcXnpX1 A' r π')) hc01 huq φ'' hφ''c ψ
    hσρ (fun t => hσof t)
  have hPB := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hPO2
  have hstr2 : Spec.map (CommRingCat.ofHom σ) ≫ wcQuadModelStr (wcXnpEis A' ℓ π') (r + 2)
      (wcXnpRho A' ℓ π')
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : wcXnpEis A' ℓ π') else 0) =
      Spec.map (CommRingCat.ofHom ψ) := by
    show Spec.map _ ≫ Spec.map _ = _
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    try rfl
  rw [← hstr2] at hPB

  have hclosed' : wcQuadModelStr (wcXnpEis A' ℓ π') (r + 2) (wcXnpRho A' ℓ π')
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : wcXnpEis A' ℓ π') else 0)
      (Spec.map (CommRingCat.ofHom σ) (IsLocalRing.closedPoint _)) =
      IsLocalRing.closedPoint (wcXnpEis A' ℓ π') := by
    have h := Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom σ))
      (wcQuadModelStr (wcXnpEis A' ℓ π') (r + 2) (wcXnpRho A' ℓ π')
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : wcXnpEis A' ℓ π') else 0))
      (IsLocalRing.closedPoint _)
    rw [← h, hstr2]
    apply PrimeSpectrum.ext
    change Ideal.comap ψ (IsLocalRing.maximalIdeal _) = IsLocalRing.maximalIdeal _
    symm
    apply (IsLocalRing.maximalIdeal.isMaximal _).eq_of_le
      (Ideal.comap_ne_top _ (IsLocalRing.maximalIdeal.isMaximal _).ne_top)
    rw [hmE, Ideal.span_le, Set.singleton_subset_iff]
    show σ (algebraMap _ _ (wcXnpRho A' ℓ π')) ∈ IsLocalRing.maximalIdeal _
    rw [hσρ]
    exact Ideal.mul_mem_right _ _ (hyD 0)
  have hz0 : Ideal.Quotient.mk (wcQuadModelIdeal (wcXnpEis A' ℓ π') (r + 2) (wcXnpRho A' ℓ π')
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : wcXnpEis A' ℓ π') else 0))
      (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (Spec.map (CommRingCat.ofHom σ) (IsLocalRing.closedPoint _)) := by
    have h := hyD 0
    rw [← hσ0] at h
    exact h
  have hz1 : Ideal.Quotient.mk (wcQuadModelIdeal (wcXnpEis A' ℓ π') (r + 2) (wcXnpRho A' ℓ π')
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : wcXnpEis A' ℓ π') else 0))
      (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (Spec.map (CommRingCat.ofHom σ) (IsLocalRing.closedPoint _)) := by
    have h := hyD 1
    rw [← hσ1] at h
    exact h

  have hconn := wc_xnp_tube_conn (wcXnpEis A' ℓ π') ℓ hℓE (wcXnpRho A' ℓ π') hmE r _
    (Spec.map (CommRingCat.ofHom σ)) hσet hclosed' hz0 hz1 L' φ'' hφ''inj _ _ _ hPB
  obtain ⟨hnt, hid⟩ := connIdem
    (wcXnpEis Γ(Pq, ⊤) ℓ (κC (αC (wcXnpX0 A' r π')))) hconn
  exact kummer Γ(Pq, ⊤) (κC (αC (wcXnpX0 A' r π'))) v hℓK huq hv (κL ζL) hζ1 hζsum
    hnt hid

theorem wc_qmbt_h1t_strict_tube_pull_fixed : ∀ (A' : Type u) [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A') →
    ∀ (π' : A'), IsLocalRing.maximalIdeal A' = Ideal.span {π'} →
    ∀ (Xm : Scheme.{u}) (f : Xm ⟶ Spec (.of A')),
    (∀ x : Xm, ∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))),
      x ∈ U ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f) →
    ∀ (L' : Type u) [Field L'] [IsSepClosed L'] (φ' : A' →+* L'), Function.Injective φ' →
    (letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L') →
    ∀ (σ' : L' →+* L'), σ'.comp φ' = φ' →
    ∀ (XE' : Scheme.{u}) (p' : XE' ⟶ Xm) (q' : XE' ⟶ Spec (.of L')),
      IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')) →
    ∀ (Xs' : Scheme.{u}) (ι' : Xs' ⟶ Xm)
      (s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))),
      IsPullback ι' s' f (wcQmSp A') →
    ∀ (w' : XE' ⟶ XE') (hw₁' : w' ≫ p' = p'),
      w' ≫ q' = q' ≫ Spec.map (CommRingCat.ofHom σ') →
    ∀ (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)]
      (c : Spec (.of C) ⟶ Xm), WeaklyEtale c → c (IsLocalRing.closedPoint C) ∈ Set.range ι' →
    ∀ (Pq : Scheme.{u}) (q1 : Pq ⟶ Spec (.of C)) (q2 : Pq ⟶ XE'), IsPullback q1 q2 c p' →
    ∀ (wq : Pq ⟶ Pq), wq ≫ q1 = q1 → wq ≫ q2 = q2 ≫ w' →
    ∀ (k : ℕ), 1 ≤ k → ∀ (Dq : wcZModPullData wq (ℓ ^ k)), wcZModPullCanonical Dq →
    ∀ h : wcZModProEtExt Pq (ℓ ^ k) 1, wcZModPull Dq 1 h = h :=
by
  intro A' _ _ _ _ _ ℓ _ hℓ' π' hπ' Xm f hcov L' _ _ φ' hφ'i halg' σ' hσ' XE' p' q' hpb'
    Xs' ι' s' hps' w' hw₁' hw₂' C _ _ _ c hc hrange Pq q1 q2 hq wq hwq1 hwq2 k hk Dq hDq h

  obtain ⟨t, ht⟩ := hrange
  obtain ⟨U, r, g, hyU, hg, hgf⟩ := hcov (c (IsLocalRing.closedPoint C))
  have hsub : Set.range c ⊆ Set.range U.ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨z, rfl⟩
    exact ((IsLocalRing.specializes_closedPoint z).map c.continuous).mem_open U.isOpen hyU
  haveI hcU : WeaklyEtale (IsOpenImmersion.lift U.ι c hsub) :=
    MorphismProperty.of_isPullback (P := @WeaklyEtale)
      (IsOpenImmersion.isPullback_lift_id c U.ι hsub).flip hc
  haveI := hg
  have ha : WeaklyEtale (IsOpenImmersion.lift U.ι c hsub ≫ g) := inferInstance
  have haf : (IsOpenImmersion.lift U.ι c hsub ≫ g) ≫ wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
      c ≫ f := by
    rw [Category.assoc, hgf, ← Category.assoc, IsOpenImmersion.lift_fac]
  have hT : IsPullback q1 (q2 ≫ q') ((IsOpenImmersion.lift U.ι c hsub ≫ g) ≫
      wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
      (Spec.map (CommRingCat.ofHom φ')) := by
    rw [haf]
    exact IsPullback.paste_vert hq hpb'
  have hcl : wcQuadModelStr A' (r + 2) π'
      (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)
      ((IsOpenImmersion.lift U.ι c hsub ≫ g) (IsLocalRing.closedPoint C)) =
      IsLocalRing.closedPoint A' := by
    have e1 : ((IsOpenImmersion.lift U.ι c hsub ≫ g) ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
        (IsLocalRing.closedPoint C) = (c ≫ f) (IsLocalRing.closedPoint C) := by rw [haf]
    have e1' : wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)
        ((IsOpenImmersion.lift U.ι c hsub ≫ g) (IsLocalRing.closedPoint C)) =
        f (c (IsLocalRing.closedPoint C)) :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans (e1.trans (Scheme.Hom.comp_apply _ _ _))
    have e3 : (ι' ≫ f) t = (s' ≫ wcQmSp A') t :=
      congrArg (fun m : Xs' ⟶ Spec (.of A') => m t) hps'.w
    have e3' : f (ι' t) = wcQmSp A' (s' t) :=
      (Scheme.Hom.comp_apply _ _ _).symm.trans (e3.trans (Scheme.Hom.comp_apply _ _ _))
    have e2 : s' t = IsLocalRing.closedPoint (IsLocalRing.ResidueField A') := Subsingleton.elim _ _
    rw [e1', ← ht, e3', e2]
    haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom (IsLocalRing.residue A'))) := by
      rw [CommRingCat.hom_ofHom]; infer_instance
    exact Spec_closedPoint
  have hwqL : wq ≫ (q2 ≫ q') = (q2 ≫ q') ≫ Spec.map (CommRingCat.ofHom σ') := by
    rw [← Category.assoc, hwq2, Category.assoc, hw₂', Category.assoc]

  by_cases hD : Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈
        PrimeSpectrum.asIdeal ((IsOpenImmersion.lift U.ι c hsub ≫ g) (IsLocalRing.closedPoint C)) ∧
      Ideal.Quotient.mk (wcQuadModelIdeal A' (r + 2) π'
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈
        PrimeSpectrum.asIdeal ((IsOpenImmersion.lift U.ι c hsub ≫ g) (IsLocalRing.closedPoint C))
  · obtain ⟨hD0, hD1⟩ := hD
    obtain ⟨hfin, hcard⟩ := wc_qsfx_double_proet_card A' ℓ hℓ' π' hπ' r C _ ha hcl L' φ' hφ'i
      halg' Pq q1 (q2 ≫ q') hT hD0 hD1 k hk
