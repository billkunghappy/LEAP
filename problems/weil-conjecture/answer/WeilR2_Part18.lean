    have hlim := wc_kummer_tower_et_coh_limit (M := W'.left) ℓ hℓL (W'.hom ≫ T.g₀) n
      (fun k x => ⟨0, fun t _ _ E => by rw [hstage k x, map_zero]⟩)

    have hP : IsPullback (Limits.pullback.fst W'.hom T.πi)
