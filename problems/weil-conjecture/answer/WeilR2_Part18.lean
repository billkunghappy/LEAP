by
  intro A _ _ _ _ _ ℓ _ hℓ π hπ r B _ _ _ a₀ ha₀ hx0 hx1 Xs ι s hpbS D₁ i₁ k₁ hD1 D₂ i₂ k₂ hD2
    Y iY kY hDY E₁ hE₁ E₂ hE₂ EY hEY ρ₁ ρ₂ hz hS M γM wM ιM t₁ t₂ hc hι ht12 hγw hιw hmono hex
    hiso hO1 hO2 hQ

  have hs2 : ∀ i < (-1 : ℤ), Limits.IsZero ((CochainComplex.mappingCone
      ((HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
        (ComplexShape.up ℤ) 0).map (γM - 𝟙 M))).X i) := by
    intro i hi
    rw [Limits.IsZero.iff_id_eq_zero, ← CochainComplex.mappingCone.id_X _ i (i + 1) rfl]
    have h1 : Limits.IsZero (((HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
        (ComplexShape.up ℤ) 0).obj M).X (i + 1)) :=
      HomologicalComplex.isZero_single_obj_X _ _ _ _ (by omega)
    have h2 : Limits.IsZero (((HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
        (ComplexShape.up ℤ) 0).obj M).X i) :=
      HomologicalComplex.isZero_single_obj_X _ _ _ _ (by omega)
    rw [h1.eq_of_tgt ((CochainComplex.mappingCone.fst _).1.v i (i + 1) rfl) 0,
      h2.eq_of_tgt ((CochainComplex.mappingCone.snd _).v i i (add_zero i)) 0]
