        (Algebra.TensorProduct.includeRight : Q' →ₐ[Q] TensorProduct Q R Q').toRingHom)) := by
    intro Q R Q' _ _ _ ρ θ hρ
    letI : Algebra Q R := ρ.toAlgebra
    letI : Algebra Q Q' := θ.toAlgebra
    have hpo := CommRingCat.isPushout_tensorProduct Q R Q'
    have hpb := AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _ hpo
    exact MorphismProperty.of_isPullback (P := @WeaklyEtale) hpb hρ
  have hWE' := s7 _ _ _ ρ θ hWE

  have hℓ' : IsUnit ((ℓ : ℕ) : AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π)) := by
    have := hℓ.map (AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π))
    rwa [map_natCast] at this
  have hconn := wc_qmlm_double_generic_conn (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π))
    ℓ hℓ' (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π)) hmax' r hA'
    _ _ hWE' (hmemC _ (Set.mem_insert _ _)) (hmemC _ (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    L φ' hφ'inj

  have s9 : ∀ (Q R Q' : Type u) [CommRing Q] [CommRing R] [CommRing Q']
      (ρ : Q →+* R) (θ : Q →+* Q'),
      letI : Algebra Q R := ρ.toAlgebra
      letI : Algebra Q Q' := θ.toAlgebra
      (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct Q R Q').comp ρ =
        (Algebra.TensorProduct.includeRight : Q' →ₐ[Q] TensorProduct Q R Q').toRingHom.comp θ ∧
      ∀ (T : Type u) [CommRing T] (f : R →+* T) (g : Q' →+* T), f.comp ρ = g.comp θ →
        ∃! h : TensorProduct Q R Q' →+* T,
          h.comp Algebra.TensorProduct.includeLeftRingHom = f ∧
          h.comp (Algebra.TensorProduct.includeRight : Q' →ₐ[Q] TensorProduct Q R Q').toRingHom = g := by
    intro Q R Q' _ _ _ ρ θ
    letI : Algebra Q R := ρ.toAlgebra
    letI : Algebra Q Q' := θ.toAlgebra
    refine ⟨?_, ?_⟩
    · ext q
      exact Algebra.TensorProduct.tmul_one_eq_one_tmul q
    · intro T _ f g hfg
      letI iQT : Algebra Q T := (f.comp ρ).toAlgebra
      let f' : R →ₐ[Q] T := { f with commutes' := fun q => rfl }
      let g' : Q' →ₐ[Q] T := { g with commutes' := fun q => (RingHom.congr_fun hfg q).symm }
      refine ⟨(Algebra.TensorProduct.productMap f' g').toRingHom, ⟨?_, ?_⟩, ?_⟩
      · ext x
        simp [f']
      · ext x
        simp [g']
      · rintro h' ⟨hl, hr⟩
        apply RingHom.ext
        intro x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul a b =>
          have e : (a ⊗ₜ[Q] b) =
              Algebra.TensorProduct.includeLeftRingHom a *
                (Algebra.TensorProduct.includeRight : Q' →ₐ[Q] TensorProduct Q R Q') b := by
            simp
          have ha := RingHom.congr_fun hl a
          have hb := RingHom.congr_fun hr b
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at ha hb
          rw [e, map_mul, ha, hb]
          simp [f', g']
        | add x y hx hy => rw [map_add, map_add, hx, hy]
  obtain ⟨hpo1, hpo2⟩ := s9 _ _ _ ρ θ

  obtain ⟨e⟩ := wc_qmlm_level_tensor_iso A π r (ℓ ^ k) hN hA hA' R ρ L φA φ' hφ'A hzL θ hθA hθ0 hθ1 hθi
    _ _ _ hpo1 hpo2
  exact @Function.Surjective.connectedSpace _ _ _ hconn _ _
    (PrimeSpectrum.homeomorphOfRingEquiv e.symm).surjective
    (PrimeSpectrum.homeomorphOfRingEquiv e.symm).continuous

theorem wc_qmtm_level_h1_kill : ∀ (A : Type u) [CommRing A] [IsDomain A]
