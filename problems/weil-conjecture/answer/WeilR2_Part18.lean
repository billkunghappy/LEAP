        Polynomial.C ((1 : L) ⊗ₜ[A] ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) : TensorProduct A L R)))) :=
by
  intro A _ _ _ _ _ ℓ _ hℓ π hπ r R _ _ _ ρ hWE h0 h1 L _ _ φA hφA k
  have t_s3 : ∀ (A : Type u) [CommRing A] [IsDomain A] (π : A), π ≠ 0 →
      ∀ (N : ℕ), 0 < N →
      IsDomain (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) →
      ∀ (L : Type u) [Field L] [IsSepClosed L] (φA : A →+* L), Function.Injective φA →
      ((N : ℕ) : L) ≠ 0 →
      ∃ φ' : AdjoinRoot (Polynomial.X ^ N - Polynomial.C π) →+* L,
        φ'.comp (AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C π)) = φA ∧ Function.Injective φ' ∧
        φ' (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π)) ≠ 0 := by
    intro A _ _ π hπ0 N hN hdom L _ _ φA hφA hNL
    have ha : φA π ≠ 0 := by
      intro h; apply hπ0; apply hφA; rw [h, map_zero]
    have hsep : (Polynomial.X ^ N - Polynomial.C (φA π)).Separable :=
      Polynomial.separable_X_pow_sub_C (φA π) hNL ha
    have hdeg : (Polynomial.X ^ N - Polynomial.C (φA π)).degree ≠ 0 := by
      rw [Polynomial.degree_X_pow_sub_C hN]
      exact_mod_cast hN.ne'
    obtain ⟨zL, hzL⟩ := IsSepClosed.exists_root _ hdeg hsep
    have hzL' : zL ^ N = φA π := by
      have := hzL
      simp only [Polynomial.IsRoot, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_C] at this
      exact sub_eq_zero.mp this
    have hev : (Polynomial.X ^ N - Polynomial.C π).eval₂ φA zL = 0 := by
      simp [Polynomial.eval₂_sub, hzL']
    refine ⟨AdjoinRoot.lift φA zL hev, ?_, ?_, ?_⟩
    · ext a
      simp [AdjoinRoot.lift_of]
    · have hmon : (Polynomial.X ^ N - Polynomial.C π).Monic := Polynomial.monic_X_pow_sub_C π hN.ne'
      haveI : Module.Finite A (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) :=
        (AdjoinRoot.powerBasis' hmon).finite
      haveI : Algebra.IsIntegral A (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) :=
        Algebra.IsIntegral.of_finite _ _
      rw [RingHom.injective_iff_ker_eq_bot]
      haveI := hdom
      apply Ideal.eq_bot_of_comap_eq_bot (R := A)
      change Ideal.comap (algebraMap A (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π))) (RingHom.ker _) = ⊥
      rw [RingHom.comap_ker]
      have : (AdjoinRoot.lift φA zL hev).comp (algebraMap A (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π))) = φA := by
        ext a
        exact AdjoinRoot.lift_of hev
      rw [this]
      exact (RingHom.injective_iff_ker_eq_bot φA).mp hφA
    · rw [AdjoinRoot.lift_root]
      intro h
      apply ha
