    b.symm ≪≫ χ.symm ≪≫ (Pg.mapHomologicalComplex (ComplexShape.up ℤ)).mapIso a
  have n1 : TJ ≫ b.inv = b.inv ≫ ((𝟭 D).mapHomologicalComplex (ComplexShape.up ℤ)).map TJ :=
    (Functor.mapHomologicalComplexIdIso D (ComplexShape.up ℤ)).inv.naturality TJ
  have n3 : ((𝟭 C).mapHomologicalComplex (ComplexShape.up ℤ)).map T' ≫ a.hom = a.hom ≫ T' :=
    (Functor.mapHomologicalComplexIdIso C (ComplexShape.up ℤ)).hom.naturality T'
  have h2 : ((𝟭 D).mapHomologicalComplex (ComplexShape.up ℤ)).map TJ ≫ χ.inv =
      χ.inv ≫ (Pg.mapHomologicalComplex (ComplexShape.up ℤ)).map
        (((𝟭 C).mapHomologicalComplex (ComplexShape.up ℤ)).map T') := by
    rw [Iso.comp_inv_eq, Category.assoc, hχ, Iso.inv_hom_id_assoc]
  have claim : TJ ≫ χs.hom = χs.hom ≫ (Pg.mapHomologicalComplex (ComplexShape.up ℤ)).map T' := by
    change TJ ≫ (b.inv ≫ χ.inv ≫ (Pg.mapHomologicalComplex (ComplexShape.up ℤ)).map a.hom) =
      (b.inv ≫ χ.inv ≫ (Pg.mapHomologicalComplex (ComplexShape.up ℤ)).map a.hom) ≫
        (Pg.mapHomologicalComplex (ComplexShape.up ℤ)).map T'
    rw [reassoc_of% n1, reassoc_of% h2, ← Functor.map_comp, n3, Functor.map_comp]
    simp only [Category.assoc]

  have s6 : ∃ h : HomotopyEquiv I.cochainComplex J.cochainComplex, I.ι' ≫ h.hom = J.ι' := by
    let h₀ := I.homotopyEquiv J
    let hh : HomotopyEquiv I.cochainComplex J.cochainComplex :=
      { hom := HomologicalComplex.extendMap h₀.hom ComplexShape.embeddingUpNat
        inv := HomologicalComplex.extendMap h₀.inv ComplexShape.embeddingUpNat
        homotopyHomInvId := (Homotopy.ofEq (HomologicalComplex.extendMap_comp h₀.hom h₀.inv
            ComplexShape.embeddingUpNat).symm).trans
            ((h₀.homotopyHomInvId.extend ComplexShape.embeddingUpNat).trans
              (Homotopy.ofEq (HomologicalComplex.extendMap_id _ _)))
        homotopyInvHomId := (Homotopy.ofEq (HomologicalComplex.extendMap_comp h₀.inv h₀.hom
            ComplexShape.embeddingUpNat).symm).trans
            ((h₀.homotopyInvHomId.extend ComplexShape.embeddingUpNat).trans
              (Homotopy.ofEq (HomologicalComplex.extendMap_id _ _))) }
    refine ⟨hh, ?_⟩
    have key : (ComplexShape.embeddingUpNat.extendFunctor D').map I.ι ≫
        (ComplexShape.embeddingUpNat.extendFunctor D').map h₀.hom =
        (ComplexShape.embeddingUpNat.extendFunctor D').map J.ι := by
      rw [← Functor.map_comp, InjectiveResolution.homotopyEquiv_hom_ι]
    exact (Category.assoc _ _ _).trans (whisker_eq _ key)
  obtain ⟨h, hIJ⟩ := s6

  haveI : QuasiIso ((Φw.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι') :=
    HomologicalComplex.quasiIso_map_of_preservesHomology _ _
  have e1 : (Φw.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t ≫ h.hom =
      (HomologicalComplex.singleMapHomologicalComplex Φw (ComplexShape.up ℤ) 0).hom.app R ≫
      (HomologicalComplex.single D' (ComplexShape.up ℤ) 0).map ((adj.homEquiv _ _).symm uP) ≫
      J.ι' := by
    rw [reassoc_of% ht, hIJ]
  have e2 : (Φw.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫
      (Φw.mapHomologicalComplex (ComplexShape.up ℤ)).map h.hom ≫ tU =
      (HomologicalComplex.singleMapHomologicalComplex Φw (ComplexShape.up ℤ) 0).hom.app R ≫
      (HomologicalComplex.single D' (ComplexShape.up ℤ) 0).map ((adj.homEquiv _ _).symm uP) ≫
      J.ι' := by
    rw [← Functor.map_comp_assoc, hIJ, hJ]
  have s5 : ∀ {K₀ K L : CochainComplex D' ℤ} (s : K₀ ⟶ K) [QuasiIso s] [L.IsKInjective]
      (f g : K ⟶ L), s ≫ f = s ≫ g → Nonempty (Homotopy f g) := by
    intro K₀ K L s _ _ f g hfg
    letI := HasDerivedCategory.standard D'
    have h1 : DerivedCategory.Q.map f = DerivedCategory.Q.map g := by
      haveI : IsIso (DerivedCategory.Q.map s) :=
        (DerivedCategory.isIso_Q_map_iff_quasiIso D' s).2 inferInstance
      rw [← cancel_epi (DerivedCategory.Q.map s), ← Functor.map_comp, ← Functor.map_comp, hfg]
    have h2 : DerivedCategory.Qh.map ((HomotopyCategory.quotient D' (ComplexShape.up ℤ)).map f) =
        DerivedCategory.Qh.map ((HomotopyCategory.quotient D' (ComplexShape.up ℤ)).map g) := by
      have hf := (DerivedCategory.quotientCompQhIso D').hom.naturality f
      have hg := (DerivedCategory.quotientCompQhIso D').hom.naturality g
      simp only [Functor.comp_map] at hf hg
      rw [← cancel_mono ((DerivedCategory.quotientCompQhIso D').hom.app L), hf, hg, h1]
    exact ⟨HomotopyCategory.homotopyOfEq f g
      ((CochainComplex.IsKInjective.Qh_map_bijective _ L).1 h2)⟩
  obtain ⟨H⟩ := s5 ((Φw.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι') (t ≫ h.hom)
    ((Φw.mapHomologicalComplex (ComplexShape.up ℤ)).map h.hom ≫ tU) (e1.trans e2.symm)

  have n1' := (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
    (ComplexShape.up ℤ)).hom.naturality h.hom
  have n2' := (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).naturality h.hom
  have m1 : h.hom ≫ (Functor.mapHomologicalComplexIdIso D' (ComplexShape.up ℤ)).inv.app
        J.cochainComplex =
      (Functor.mapHomologicalComplexIdIso D' (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
        ((𝟭 D').mapHomologicalComplex (ComplexShape.up ℤ)).map h.hom :=
    (Functor.mapHomologicalComplexIdIso D' (ComplexShape.up ℤ)).inv.naturality h.hom
  have m2 := (NatTrans.mapHomologicalComplex adj.unit (ComplexShape.up ℤ)).naturality h.hom
  have m3 := (Functor.mapHomologicalComplexCompIso (Iso.refl (Φw ⋙ Pw))
    (ComplexShape.up ℤ)).inv.naturality h.hom
  simp only [Functor.comp_map] at n1' m3
  have E1 : T ≫ (P.mapHomologicalComplex (ComplexShape.up ℤ)).map h.hom =
      (P.mapHomologicalComplex (ComplexShape.up ℤ)).map
        (((Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
          (NatTrans.mapHomologicalComplex adj.unit (ComplexShape.up ℤ)).app I.cochainComplex ≫
          (Functor.mapHomologicalComplexCompIso (Iso.refl (Φw ⋙ Pw))
            (ComplexShape.up ℤ)).inv.app I.cochainComplex) ≫
          (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map (t ≫ h.hom)) ≫
      ((Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P)) (ComplexShape.up ℤ)).hom.app
          J.cochainComplex ≫
      (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app J.cochainComplex) := by
    simp only [T, Functor.map_comp, Category.assoc]
    rw [← n2', reassoc_of% n1']
  have E2 : (P.mapHomologicalComplex (ComplexShape.up ℤ)).map h.hom ≫ TJ =
      (P.mapHomologicalComplex (ComplexShape.up ℤ)).map
        (((Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
          (NatTrans.mapHomologicalComplex adj.unit (ComplexShape.up ℤ)).app I.cochainComplex ≫
          (Functor.mapHomologicalComplexCompIso (Iso.refl (Φw ⋙ Pw))
            (ComplexShape.up ℤ)).inv.app I.cochainComplex) ≫
          (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map
            ((Φw.mapHomologicalComplex (ComplexShape.up ℤ)).map h.hom ≫ tU)) ≫
      ((Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P)) (ComplexShape.up ℤ)).hom.app
          J.cochainComplex ≫
      (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app J.cochainComplex) := by
    simp only [TJ]
    rw [← Category.assoc ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map h.hom),
      ← Functor.map_comp, reassoc_of% m1, reassoc_of% m2, reassoc_of% m3]
    simp only [Functor.map_comp, Category.assoc]
  have G : Homotopy (T ≫ (P.mapHomologicalComplex (ComplexShape.up ℤ)).map h.hom)
      ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map h.hom ≫ TJ) :=
    (Homotopy.ofEq E1).trans
      (((P.mapHomotopy ((Pw.mapHomotopy H).compLeft _)).compRight _).trans
        (Homotopy.ofEq E2.symm))

  refine ⟨(P.mapHomotopyEquiv h).trans (HomotopyEquiv.ofIso χs), ?_⟩
  change Nonempty (Homotopy
    (T ≫ ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map h.hom ≫ χs.hom))
    (((P.mapHomologicalComplex (ComplexShape.up ℤ)).map h.hom ≫ χs.hom) ≫
      (Pg.mapHomologicalComplex (ComplexShape.up ℤ)).map T'))
  exact ⟨(Homotopy.ofEq (Category.assoc _ _ _).symm).trans
    ((G.compRight χs.hom).trans (Homotopy.ofEq (by simp only [Category.assoc, claim])))⟩

theorem wc_qmbt_nt_conj_homotopy {S : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    {L : Type u} [Field L] [IsSepClosed L] {L' : Type u} [Field L'] {ιL : L →+* L'}
    (hLalg : letI := ιL.toAlgebra; Algebra.IsAlgebraic L L')
    {XE : Scheme.{u}} {p : XE ⟶ S} {q : XE ⟶ Spec (.of L)}
    {Xm : Scheme.{u}} {g : Xm ⟶ S}
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    {βE : XE' ⟶ XE} (hβp : βE ≫ p = p' ≫ g)
    (hβq : IsPullback βE q' q (Spec.map (CommRingCat.ofHom ιL)))
    {w : XE ⟶ XE} (hw₁ : w ≫ p = p) {w' : XE' ⟶ XE'} (hw₁' : w' ≫ p' = p')
    (hwβ : w' ≫ βE = βE ≫ w)
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg)
    (Dp : wcHMPullData p ℓ) (hDp : wcHMPullCanonical Dp)
    (Dτ : wcHMPullData w ℓ) (hDτ : wcHMPullCanonical Dτ)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE ℓ)))
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Dτ' : wcHMPullData w' ℓ) (hDτ' : wcHMPullCanonical Dτ')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ))) :
    haveI := Dp.cont
    haveI := Dτ.cont
    haveI : (wcProEtBC p ⋙ wcProEtBC w).IsContinuous
        (Scheme.ProEt.topology S) (Scheme.ProEt.topology XE) :=
      Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology XE) _
    let α : wcProEtBC p ⟶ wcProEtBC p ⋙ wcProEtBC w :=
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) p :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) p :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong p))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong w))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
        (Q := ⊤) _ _ _ hw₁.symm).hom
    haveI := Dp.additive
    haveI := Dτ.additive
    ∀ (hφ : (Dp.φ ≫ ((wcProEtBC p).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.ProEt.topology S) (Scheme.ProEt.topology XE)).map Dτ.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans α RingCat.{u+1}
          (Scheme.ProEt.topology S) (Scheme.ProEt.topology XE)).app
          (wcRingSheaf XE ℓ) = Dp.φ)
      (t : (Dτ.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶
        I.cochainComplex),
      (Dτ.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t =
        (HomologicalComplex.singleMapHomologicalComplex Dτ.Φ (ComplexShape.up ℤ) 0).hom.app
          (SheafOfModules.unit (wcRingSheaf XE ℓ)) ≫
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          ((Dτ.adj.homEquiv _ _).symm
            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
              (wcProEtBC w) _ _ Dτ.cont Dτ.φ)) ≫
        I.ι' →
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC p) _ _ Dp.cont Dp.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dp.adj
    let Pw := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC w) _ _ Dτ.cont Dτ.φ
    haveI : Pw.Additive := Adjunction.right_adjoint_additive Dτ.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    let γ : Pw ⋙ P ⟶ P := (SheafOfModules.pushforwardComp Dp.φ Dτ.φ).hom ≫
        SheafOfModules.pushforwardNatTrans _ α ≫ (SheafOfModules.pushforwardCongr hφ).hom
    let Tflat := (Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app
          I.cochainComplex ≫
        (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ Dτ.Φ ⋙ Pw from Dτ.adj.unit)
          (ComplexShape.up ℤ)).app I.cochainComplex ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Dτ.Φ ⋙ Pw))
          (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
        (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map t
    let T : K ⟶ K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).map Tflat ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
          (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
        (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I.cochainComplex
    haveI := Dp'.cont
    haveI := Dτ'.cont
    haveI : (wcProEtBC p' ⋙ wcProEtBC w').IsContinuous
        (Scheme.ProEt.topology Xm) (Scheme.ProEt.topology XE') :=
      Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology XE') _
    let α' : wcProEtBC p' ⟶ wcProEtBC p' ⋙ wcProEtBC w' :=
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) p' :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) p' :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong p'))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) w' :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) w' :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong w'))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
        (Q := ⊤) _ _ _ hw₁'.symm).hom
    haveI := Dp'.additive
    haveI := Dτ'.additive
    ∀ (hφ' : (Dp'.φ ≫ ((wcProEtBC p').sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.ProEt.topology Xm) (Scheme.ProEt.topology XE')).map Dτ'.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans α' RingCat.{u+1}
          (Scheme.ProEt.topology Xm) (Scheme.ProEt.topology XE')).app
          (wcRingSheaf XE' ℓ) = Dp'.φ)
      (t' : (Dτ'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex ⟶
        I'.cochainComplex),
      (Dτ'.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I'.ι' ≫ t' =
        (HomologicalComplex.singleMapHomologicalComplex Dτ'.Φ (ComplexShape.up ℤ) 0).hom.app
          (SheafOfModules.unit (wcRingSheaf XE' ℓ)) ≫
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          ((Dτ'.adj.homEquiv _ _).symm
            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
              (wcProEtBC w') _ _ Dτ'.cont Dτ'.φ)) ≫
        I'.ι' →
    let P' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC p') _ _ Dp'.cont Dp'.φ
    haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj
    let Pw' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC w') _ _ Dτ'.cont Dτ'.φ
    haveI : Pw'.Additive := Adjunction.right_adjoint_additive Dτ'.adj
    let K' := (P'.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex
    let γ' : Pw' ⋙ P' ⟶ P' := (SheafOfModules.pushforwardComp Dp'.φ Dτ'.φ).hom ≫
        SheafOfModules.pushforwardNatTrans _ α' ≫ (SheafOfModules.pushforwardCongr hφ').hom
    let Tflat' := (Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app
          I'.cochainComplex ≫
        (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ Dτ'.Φ ⋙ Pw' from Dτ'.adj.unit)
          (ComplexShape.up ℤ)).app I'.cochainComplex ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Dτ'.Φ ⋙ Pw'))
          (ComplexShape.up ℤ)).inv.app I'.cochainComplex ≫
        (Pw'.mapHomologicalComplex (ComplexShape.up ℤ)).map t'
    let T' : K' ⟶ K' := (P'.mapHomologicalComplex (ComplexShape.up ℤ)).map Tflat' ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw' ⋙ P'))
          (ComplexShape.up ℤ)).hom.app I'.cochainComplex ≫
        (NatTrans.mapHomologicalComplex γ' (ComplexShape.up ℤ)).app I'.cochainComplex
    haveI := Dg.additive
    let Pg := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ
    haveI : Pg.Additive := Adjunction.right_adjoint_additive Dg.adj
    ∃ e : HomotopyEquiv K ((Pg.mapHomologicalComplex (ComplexShape.up ℤ)).obj K'),
      Nonempty (Homotopy (T ≫ e.hom)
        (e.hom ≫ (Pg.mapHomologicalComplex (ComplexShape.up ℤ)).map T')) :=
by
  intro α hφ t ht P Pw K γ Tflat T α' hφ' t' ht' P' Pw' K' γ' Tflat' T' Pg
  haveI := Dp.additive
  haveI := Dτ.additive
  haveI := Dp'.additive
  haveI := Dτ'.additive
  haveI := Dg.additive
  haveI : P.Additive := Adjunction.right_adjoint_additive Dp.adj
  haveI : Pw.Additive := Adjunction.right_adjoint_additive Dτ.adj
  haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj
  haveI : Pw'.Additive := Adjunction.right_adjoint_additive Dτ'.adj
  haveI : Pg.Additive := Adjunction.right_adjoint_additive Dg.adj

  obtain ⟨DβE, hDβE⟩ := wc_hm_pull_data_exists βE ℓ

  have hgeo : ∀ {T : Scheme.{u}} (t : T ⟶ XE),
      IsIntegralHom (Limits.pullback.fst t βE) ∧ IsHomeomorph ⇑(Limits.pullback.fst t βE) :=
    fun t => wc_ntc_insep_geom hLalg hβq t
  haveI := DβE.cont
  haveI := DβE.additive
  let PE := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC βE) _ _ DβE.cont DβE.φ
  haveI : PE.Additive := Adjunction.right_adjoint_additive DβE.adj

  haveI : Limits.PreservesFiniteColimits PE :=
    wc_ntc_push_exact βE ℓ DβE (fun t => hgeo t)
      (fun q _ hq hΔ hw => wc_ntc_wcontr_integral_bij q hq hΔ hw)
  haveI : Limits.PreservesFiniteLimits PE := by
    haveI := DβE.adj.rightAdjoint_preservesLimits
    infer_instance
  have hinj : ∀ J : SheafOfModules.{u+1} (wcRingSheaf XE' ℓ), Injective J →
      Injective (PE.obj J) := by
    intro J hJ
    haveI := DβE.presLim
    exact Injective.injective_of_adjoint DβE.adj J

  haveI hiso := wc_ntc_unit_iso βE ℓ DβE hDβE (fun V => (hgeo V.hom).2)

  obtain ⟨β, βw, hBC4, hunit⟩ := wc_ntc_bc_coherence hβp hw₁ hw₁' hwβ Dg hDg Dp hDp Dτ hDτ
    Dp' hDp' Dτ' hDτ' DβE hDβE hφ hφ'
  haveI := Dτ.presLim
  haveI := Dτ.presColim

  exact wc_ntc_abs_transfer P' P Pg PE hinj Dτ'.Φ Pw' Dτ'.adj Dτ.Φ Pw Dτ.adj γ' γ
    (SheafOfModules.unit (wcRingSheaf XE' ℓ)) (SheafOfModules.unit (wcRingSheaf XE ℓ))
    (asIso (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
      (wcProEtBC βE) _ _ DβE.cont DβE.φ)).symm
    (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC w') _ _ Dτ'.cont Dτ'.φ)
    (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC w) _ _ Dτ.cont Dτ.φ)
    β βw hBC4 hunit I' I t' ht' t ht

theorem wc_qmbt_pbc_derived_comparison {𝒞 : Type*} [Category 𝒞] [Abelian 𝒞]
    {ℬ : Type*} [Category ℬ] [Abelian ℬ]
    {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] [HasDerivedCategory 𝒜]
    {𝒜' : Type*} [Category 𝒜'] [Abelian 𝒜'] [HasDerivedCategory 𝒜'] [EnoughInjectives 𝒜']
    (G₁ : 𝒞 ⥤ ℬ) (G₂ : ℬ ⥤ 𝒜) (H : 𝒞 ⥤ 𝒜') (P : 𝒜' ⥤ 𝒜)
    [G₁.Additive] [G₂.Additive] [H.Additive] [P.Additive]
    (δ : G₁ ⋙ G₂ ⟶ H ⋙ P) (K : CochainComplex 𝒞 ℤ) (n₀ : ℤ)
    (hK : CochainComplex.IsStrictlyGE ((H.mapHomologicalComplex (ComplexShape.up ℤ)).obj K) n₀)
    (hP : DerivedCategory.TStructure.t.plus
      (DerivedCategory.Q.obj ((H.mapHomologicalComplex (ComplexShape.up ℤ)).obj K)))
    (hq : ∀ (J : CochainComplex 𝒜' ℤ) (n : ℤ), J.IsStrictlyGE n → (∀ m, Injective (J.X m)) →
      ∀ (j : (H.mapHomologicalComplex (ComplexShape.up ℤ)).obj K ⟶ J), QuasiIso j →
      ∀ (u : (G₂.mapHomologicalComplex (ComplexShape.up ℤ)).obj
          ((G₁.mapHomologicalComplex (ComplexShape.up ℤ)).obj K) ⟶
          (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj J),
        (∀ m, u.f m = δ.app (K.X m) ≫ P.map (j.f m)) → QuasiIso u) :
    ∃ θ : DerivedCategory.Q.obj ((G₂.mapHomologicalComplex (ComplexShape.up ℤ)).obj
          ((G₁.mapHomologicalComplex (ComplexShape.up ℤ)).obj K)) ≅
        (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
          (⟨_, hP⟩ : DerivedCategory.Plus 𝒜'),
      ∀ fK : K ⟶ K,
        DerivedCategory.Q.map ((G₂.mapHomologicalComplex (ComplexShape.up ℤ)).map
          ((G₁.mapHomologicalComplex (ComplexShape.up ℤ)).map fK)) ≫ θ.hom =
        θ.hom ≫ (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).map
          (ObjectProperty.homMk
            (X := (⟨_, hP⟩ : DerivedCategory.Plus 𝒜'))
            (Y := (⟨_, hP⟩ : DerivedCategory.Plus 𝒜'))
            (DerivedCategory.Q.map ((H.mapHomologicalComplex (ComplexShape.up ℤ)).map fK))) :=
by

  have lift : ∀ {X J : CochainComplex 𝒜' ℤ} [J.IsKInjective] (j : X ⟶ J) [QuasiIso j]
      (a : X ⟶ X), ∃ f : J ⟶ J, Nonempty (Homotopy (j ≫ f) (a ≫ j)) := by
    intro X J _ j _ a
    let qt := HomotopyCategory.quotient 𝒜' (ComplexShape.up ℤ)
    let e := DerivedCategory.quotientCompQhIso 𝒜'
    have hnat : ∀ {Y Y' : CochainComplex 𝒜' ℤ} (g : Y ⟶ Y'),
        DerivedCategory.Qh.map (qt.map g) =
          e.hom.app Y ≫ DerivedCategory.Q.map g ≫ e.inv.app Y' := by
      intro Y Y' g
      have h1 := e.hom.naturality g
      rw [← reassoc_of% h1]
      simp
      rfl
    have hQj : IsIso (DerivedCategory.Q.map j) := by
      rw [DerivedCategory.isIso_Q_map_iff_quasiIso]
      infer_instance
    obtain ⟨ψ, hψ⟩ := (CochainComplex.IsKInjective.Qh_map_bijective (qt.obj J) J).2
      (e.hom.app J ≫ (inv (DerivedCategory.Q.map j) ≫ DerivedCategory.Q.map a ≫
        DerivedCategory.Q.map j) ≫ e.inv.app J)
    obtain ⟨f, rfl⟩ := qt.map_surjective ψ
    have hQf : DerivedCategory.Q.map f =
        inv (DerivedCategory.Q.map j) ≫ DerivedCategory.Q.map a ≫ DerivedCategory.Q.map j := by
      rw [hnat] at hψ
      have h2 := (cancel_epi (e.hom.app J)).1 hψ
      exact (cancel_mono (e.inv.app J)).1 h2
    refine ⟨f, ⟨HomotopyCategory.homotopyOfEq _ _ ?_⟩⟩
    apply (CochainComplex.IsKInjective.Qh_map_bijective (qt.obj X) J).1
    change DerivedCategory.Qh.map (qt.map (j ≫ f)) = DerivedCategory.Qh.map (qt.map (a ≫ j))
    rw [hnat, hnat]
    simp [hQf]

  let M : CochainComplex.Plus 𝒜' := ⟨(H.mapHomologicalComplex (ComplexShape.up ℤ)).obj K, n₀, hK⟩
  haveI : M.obj.IsStrictlyGE n₀ := hK
  obtain ⟨L, hL, i, hi⟩ := CochainComplex.Plus.exists_quasiIso_injective M n₀
  let N := (InjectiveObject.ι 𝒜').mapCochainComplexPlus.obj L
  have hj : QuasiIso i.hom :=
    (HomologicalComplex.mem_quasiIso_iff _).1 ((MorphismProperty.inverseImage_iff _ _ _).1 hi)
  have hJ : N.obj.IsStrictlyGE n₀ := by
    rw [CochainComplex.isStrictlyGE_iff]
    intro k hk
    exact Functor.map_isZero (InjectiveObject.ι 𝒜')
      ((CochainComplex.isStrictlyGE_iff L.obj n₀).1 hL k hk)
  have hJi : ∀ m, Injective (N.obj.X m) := fun m =>
    show Injective ((InjectiveObject.ι 𝒜').obj (L.obj.X m)) from inferInstance
  haveI := hJ
  haveI := hJi
  haveI : N.obj.IsKInjective := CochainComplex.isKInjective_of_injective N.obj n₀

  let δK : (G₂.mapHomologicalComplex (ComplexShape.up ℤ)).obj
      ((G₁.mapHomologicalComplex (ComplexShape.up ℤ)).obj K) ⟶
      (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((H.mapHomologicalComplex (ComplexShape.up ℤ)).obj K) :=
    { f := fun m => δ.app (K.X m)
      comm' := by
        intro p q _
        exact (δ.naturality (K.d p q)).symm }
  let u := δK ≫ (P.mapHomologicalComplex (ComplexShape.up ℤ)).map i.hom
  have hu : QuasiIso u := hq N.obj n₀ hJ hJi i.hom hj u (fun m => rfl)
  have hQu : IsIso (DerivedCategory.Q.map u) := by
    rw [DerivedCategory.isIso_Q_map_iff_quasiIso]
    exact hu

  let η := P.rightDerivedFunctorPlusUnit
  let R := P.rightDerivedFunctorPlus
  let qi := DerivedCategory.Plus.Q.map i
  haveI hηN : IsIso (η.app N) := inferInstance
  haveI hιqi : IsIso (DerivedCategory.Plus.ι.map qi) := by
    change IsIso (DerivedCategory.Q.map i.hom)
    rw [DerivedCategory.isIso_Q_map_iff_quasiIso]
    exact hj
  haveI hqi : IsIso qi := isIso_of_fully_faithful DerivedCategory.Plus.ι qi
  let θhom : DerivedCategory.Q.obj ((G₂.mapHomologicalComplex (ComplexShape.up ℤ)).obj
          ((G₁.mapHomologicalComplex (ComplexShape.up ℤ)).obj K)) ⟶
        (P.rightDerivedFunctorPlus ⋙ DerivedCategory.Plus.ι).obj
          (⟨_, hP⟩ : DerivedCategory.Plus 𝒜') :=
    DerivedCategory.Q.map u ≫ DerivedCategory.Plus.ι.map (η.app N) ≫
      DerivedCategory.Plus.ι.map (inv (R.map qi))
  haveI : IsIso θhom := by
    dsimp only [θhom]
    infer_instance
  refine ⟨asIso θhom, ?_⟩
  intro fK
  let a := (H.mapHomologicalComplex (ComplexShape.up ℤ)).map fK
  let b := (G₂.mapHomologicalComplex (ComplexShape.up ℤ)).map
    ((G₁.mapHomologicalComplex (ComplexShape.up ℤ)).map fK)
  obtain ⟨f, ⟨h⟩⟩ := lift i.hom a

  have N1 : b ≫ δK = δK ≫ (P.mapHomologicalComplex (ComplexShape.up ℤ)).map a := by
    ext m
    simp only [HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f]
    exact δ.naturality (fK.f m)

  have hE := DerivedCategory.Q_map_eq_of_homotopy _
    ((P.mapHomotopy h).compLeft δK)
  have e1 : u ≫ (P.mapHomologicalComplex (ComplexShape.up ℤ)).map f =
      δK ≫ (P.mapHomologicalComplex (ComplexShape.up ℤ)).map (i.hom ≫ f) := by
    simp only [u, Functor.map_comp, Category.assoc]
  have e2 : b ≫ u =
      δK ≫ (P.mapHomologicalComplex (ComplexShape.up ℤ)).map (a ≫ i.hom) := by
    simp only [u, Functor.map_comp]
    rw [reassoc_of% N1]
  have E1 : DerivedCategory.Q.map u ≫
      DerivedCategory.Q.map ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map f) =
      DerivedCategory.Q.map b ≫ DerivedCategory.Q.map u := by
    rw [← Functor.map_comp, ← Functor.map_comp, e1, e2]
    exact hE

  have star : qi ≫ DerivedCategory.Plus.Q.map (ObjectProperty.homMk f : N ⟶ N) =
      DerivedCategory.Plus.Q.map (ObjectProperty.homMk a : M ⟶ M) ≫ qi := by
    apply DerivedCategory.Plus.ι.map_injective
    rw [Functor.map_comp, Functor.map_comp]
    change DerivedCategory.Q.map i.hom ≫ DerivedCategory.Q.map f =
      DerivedCategory.Q.map a ≫ DerivedCategory.Q.map i.hom
    rw [← Functor.map_comp, ← Functor.map_comp]
    exact DerivedCategory.Q_map_eq_of_homotopy _ h

  have d1 := congrArg DerivedCategory.Plus.ι.map (η.naturality (ObjectProperty.homMk f : N ⟶ N))
  simp only [Functor.map_comp] at d1
  have d1' : DerivedCategory.Q.map ((P.mapHomologicalComplex (ComplexShape.up ℤ)).map f) ≫
      DerivedCategory.Plus.ι.map (η.app N) =
      DerivedCategory.Plus.ι.map (η.app N) ≫
        DerivedCategory.Plus.ι.map (R.map (DerivedCategory.Plus.Q.map
          (ObjectProperty.homMk f : N ⟶ N))) := d1

  have d3 : R.map (DerivedCategory.Plus.Q.map (ObjectProperty.homMk f : N ⟶ N)) ≫
      inv (R.map qi) =
      inv (R.map qi) ≫ R.map (DerivedCategory.Plus.Q.map (ObjectProperty.homMk a : M ⟶ M)) := by
    rw [IsIso.comp_inv_eq, Category.assoc, IsIso.eq_inv_comp, ← R.map_comp, ← R.map_comp, star]
  have d3' := congrArg DerivedCategory.Plus.ι.map d3
  simp only [Functor.map_comp] at d3'
  change DerivedCategory.Q.map b ≫ (DerivedCategory.Q.map u ≫
      DerivedCategory.Plus.ι.map (η.app N) ≫ DerivedCategory.Plus.ι.map (inv (R.map qi))) =
    (DerivedCategory.Q.map u ≫ DerivedCategory.Plus.ι.map (η.app N) ≫
      DerivedCategory.Plus.ι.map (inv (R.map qi))) ≫
      DerivedCategory.Plus.ι.map (R.map (DerivedCategory.Plus.Q.map
        (ObjectProperty.homMk a : M ⟶ M)))
  rw [← reassoc_of% E1, reassoc_of% d1', d3']
  simp only [Category.assoc]

theorem wc_qmbt_pbc_bc_two_cell {Xm B Xs Xs' : Scheme.{u}} {ℓ : ℕ} [Fact (Nat.Prime ℓ)]
    (f : Xm ⟶ B) (i : Xs ⟶ B) (i' : Xs' ⟶ Xm) (b : Xs' ⟶ Xs) (hsq : b ≫ i = i' ≫ f)
    (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (Di' : wcHMPullData i' ℓ) (hDi' : wcHMPullCanonical Di')
    (Db : wcHMPullData b ℓ) (hDb : wcHMPullCanonical Db) :
    let Pf := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC f) _ _ Df.cont Df.φ
    let Pb := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC b) _ _ Db.cont Db.φ
    ∃ (δ : Pf ⋙ Di.Φ ⟶ Di'.Φ ⋙ Pb)
      (ε : ∀ V : B.ProEt, (wcProEtBC b).obj ((wcProEtBC i).obj V) ⟶
        (wcProEtBC i').obj ((wcProEtBC f).obj V)),
      (∀ V, IsIso (ε V)) ∧
      ∀ (X : SheafOfModules.{u+1} (wcRingSheaf Xm ℓ)) (V : B.ProEt)
        (x : X.val.obj (Opposite.op ((wcProEtBC f).obj V))),
        ((δ.app X).val.app (Opposite.op ((wcProEtBC i).obj V))).hom
            (((Di.adj.unit.app (Pf.obj X)).val.app (Opposite.op V)).hom x) =
          ((Di'.Φ.obj X).val.map (ε V).op).hom
            (((Di'.adj.unit.app X).val.app (Opposite.op ((wcProEtBC f).obj V))).hom x) :=
by
  intro Pf Pb

  have mapfst : ∀ {S S' : Scheme.{u}} (h : S' ⟶ S) {W W' : S.ProEt} (k : W ⟶ W'),
      ((wcProEtBC h).map k).left ≫ Limits.pullback.fst W'.hom h =
        Limits.pullback.fst W.hom h ≫ k.left := by
    intro S S' h W W' k
    exact Limits.pullback.lift_fst _ _ _
  have mapsnd : ∀ {S S' : Scheme.{u}} (h : S' ⟶ S) {W W' : S.ProEt} (k : W ⟶ W'),
      ((wcProEtBC h).map k).left ≫ Limits.pullback.snd W'.hom h =
        Limits.pullback.snd W.hom h := by
    intro S S' h W W' k
    exact Limits.pullback.lift_snd _ _ _
  have mapfst_assoc : ∀ {S S' : Scheme.{u}} (h : S' ⟶ S) {W W' : S.ProEt} (k : W ⟶ W')
      {Z : Scheme.{u}} (q : W'.left ⟶ Z),
      ((wcProEtBC h).map k).left ≫ Limits.pullback.fst W'.hom h ≫ q =
        Limits.pullback.fst W.hom h ≫ k.left ≫ q := by
    intro S S' h W W' k Z q
    exact Limits.pullback.lift_fst_assoc _ _ _ _
  have mapsnd_assoc : ∀ {S S' : Scheme.{u}} (h : S' ⟶ S) {W W' : S.ProEt} (k : W ⟶ W')
      {Z : Scheme.{u}} (q : S' ⟶ Z),
      ((wcProEtBC h).map k).left ≫ Limits.pullback.snd W'.hom h ≫ q =
        Limits.pullback.snd W.hom h ≫ q := by
    intro S S' h W W' k Z q
    exact Limits.pullback.lift_snd_assoc _ _ _ _
  have w1 : ∀ V : B.ProEt, (Limits.pullback.fst (Limits.pullback.snd V.hom i) b ≫
      Limits.pullback.fst V.hom i) ≫ V.hom =
      (Limits.pullback.snd (Limits.pullback.snd V.hom i) b ≫ i') ≫ f := by
    intro V
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, Limits.pullback.condition,
      Category.assoc, hsq, Category.assoc]
  have w3 : ∀ V : B.ProEt, (Limits.pullback.fst (Limits.pullback.snd V.hom f) i' ≫
      Limits.pullback.fst V.hom f) ≫ V.hom =
      (Limits.pullback.snd (Limits.pullback.snd V.hom f) i' ≫ b) ≫ i := by
    intro V
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, Limits.pullback.condition,
      Category.assoc, ← hsq, Category.assoc]
  let e : ∀ V : B.ProEt, Limits.pullback (Limits.pullback.snd V.hom i) b ⟶
      Limits.pullback (Limits.pullback.snd V.hom f) i' := fun V =>
    Limits.pullback.lift
      (Limits.pullback.lift
        (Limits.pullback.fst (Limits.pullback.snd V.hom i) b ≫ Limits.pullback.fst V.hom i)
        (Limits.pullback.snd (Limits.pullback.snd V.hom i) b ≫ i') (w1 V))
      (Limits.pullback.snd (Limits.pullback.snd V.hom i) b) (Limits.pullback.lift_snd _ _ _)
  let e' : ∀ V : B.ProEt, Limits.pullback (Limits.pullback.snd V.hom f) i' ⟶
      Limits.pullback (Limits.pullback.snd V.hom i) b := fun V =>
    Limits.pullback.lift
      (Limits.pullback.lift
        (Limits.pullback.fst (Limits.pullback.snd V.hom f) i' ≫ Limits.pullback.fst V.hom f)
        (Limits.pullback.snd (Limits.pullback.snd V.hom f) i' ≫ b) (w3 V))
      (Limits.pullback.snd (Limits.pullback.snd V.hom f) i') (Limits.pullback.lift_snd _ _ _)
  have hee' : ∀ V, e V ≫ e' V = 𝟙 _ := by
    intro V
    refine Limits.pullback.hom_ext ?_ ?_
    · refine Limits.pullback.hom_ext ?_ ?_
      · simp only [e, e', Category.assoc, Category.id_comp, Limits.pullback.lift_fst,
          Limits.pullback.lift_fst_assoc]
      · simp only [e, e', Category.assoc, Category.id_comp, Limits.pullback.lift_fst,
          Limits.pullback.lift_fst_assoc, Limits.pullback.lift_snd,
          Limits.pullback.lift_snd_assoc]
        exact Limits.pullback.condition.symm
    · simp only [e, e', Category.assoc, Category.id_comp, Limits.pullback.lift_snd]
  have he'e : ∀ V, e' V ≫ e V = 𝟙 _ := by
    intro V
    refine Limits.pullback.hom_ext ?_ ?_
    · refine Limits.pullback.hom_ext ?_ ?_
      · simp only [e, e', Category.assoc, Category.id_comp, Limits.pullback.lift_fst,
          Limits.pullback.lift_fst_assoc]
      · simp only [e, e', Category.assoc, Category.id_comp, Limits.pullback.lift_fst,
          Limits.pullback.lift_fst_assoc, Limits.pullback.lift_snd,
          Limits.pullback.lift_snd_assoc]
        exact Limits.pullback.condition.symm
    · simp only [e, e', Category.assoc, Category.id_comp, Limits.pullback.lift_snd]
  have gw : ∀ {V V' : B.ProEt} (g : V ⟶ V'), g.left ≫ V'.hom = V.hom :=
    fun g => MorphismProperty.Over.w g
  have nat : ∀ (V V' : B.ProEt) (g : V ⟶ V'),
      Limits.pullback.lift
        (Limits.pullback.fst (Limits.pullback.snd V.hom i) b ≫
          Limits.pullback.lift (Limits.pullback.fst V.hom i ≫ g.left) (Limits.pullback.snd V.hom i)
            (by rw [Category.assoc, gw g, Limits.pullback.condition]))
        (Limits.pullback.snd (Limits.pullback.snd V.hom i) b)
        (by rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.condition]) ≫ e V' =
      e V ≫ Limits.pullback.lift
        (Limits.pullback.fst (Limits.pullback.snd V.hom f) i' ≫
          Limits.pullback.lift (Limits.pullback.fst V.hom f ≫ g.left) (Limits.pullback.snd V.hom f)
            (by rw [Category.assoc, gw g, Limits.pullback.condition]))
        (Limits.pullback.snd (Limits.pullback.snd V.hom f) i')
        (by rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.condition]) := by
    intro V V' g
    refine Limits.pullback.hom_ext ?_ ?_
    · refine Limits.pullback.hom_ext ?_ ?_
      · simp only [e, Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc]
      · simp only [e, Category.assoc, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc,
          Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc]
    · simp only [e, Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc]
  let αapp : ∀ V : B.ProEt, (wcProEtBC i ⋙ wcProEtBC b).obj V ⟶
      (wcProEtBC f ⋙ wcProEtBC i').obj V := fun V =>
    MorphismProperty.Over.homMk (e V) (Limits.pullback.lift_snd _ _ _) trivial
  let α : wcProEtBC i ⋙ wcProEtBC b ⟶ wcProEtBC f ⋙ wcProEtBC i' :=
    { app := αapp
      naturality := by
        intro V V' g
        apply MorphismProperty.Over.Hom.ext
        exact nat V V' g }
  have hαiso : ∀ V, IsIso (α.app V) := by
    intro V
    refine ⟨⟨MorphismProperty.Over.homMk (e' V) (Limits.pullback.lift_snd _ _ _) trivial,
      MorphismProperty.Over.Hom.ext ?_, MorphismProperty.Over.Hom.ext ?_⟩⟩
    · exact hee' V
    · exact he'e V
  have hα : ∀ V : B.ProEt, e V ≫ Limits.pullback.fst (Limits.pullback.snd V.hom f) i' ≫
      Limits.pullback.fst V.hom f =
      Limits.pullback.fst (Limits.pullback.snd V.hom i) b ≫ Limits.pullback.fst V.hom i := by
    intro V
    simp only [e, Limits.pullback.lift_fst, Limits.pullback.lift_fst_assoc]

  haveI := Df.cont
  haveI := Di.cont
  haveI := Di'.cont
  haveI := Db.cont
  haveI h1c : (wcProEtBC f ⋙ wcProEtBC i').IsContinuous
      (Scheme.ProEt.topology B) (Scheme.ProEt.topology Xs') :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology Xm) _
  haveI h2c : (wcProEtBC i ⋙ wcProEtBC b).IsContinuous
      (Scheme.ProEt.topology B) (Scheme.ProEt.topology Xs') :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology Xs) _

  have hφ : (Df.φ ≫ ((wcProEtBC f).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.ProEt.topology B) (Scheme.ProEt.topology Xm)).map Di'.φ) ≫
      (Functor.sheafPushforwardContinuousNatTrans α RingCat.{u+1}
        (Scheme.ProEt.topology B) (Scheme.ProEt.topology Xs')).app (wcRingSheaf Xs' ℓ) =
      Di.φ ≫ ((wcProEtBC i).sheafPushforwardContinuous RingCat.{u+1}
        (Scheme.ProEt.topology B) (Scheme.ProEt.topology Xs)).map Db.φ := by
    refine Sheaf.hom_ext ?_
    refine NatTrans.ext (funext fun V => ?_)
    obtain ⟨V⟩ := V
    refine RingCat.hom_ext (RingHom.ext fun s => ?_)
    change ((wcRingSheaf Xs' ℓ).obj.map (α.app V).op).hom
        ((Di'.φ.hom.app (Opposite.op ((wcProEtBC f).obj V))).hom
          ((Df.φ.hom.app (Opposite.op V)).hom s)) =
      (Db.φ.hom.app (Opposite.op ((wcProEtBC i).obj V))).hom
        ((Di.φ.hom.app (Opposite.op V)).hom s)
    rw [hDf V s, hDi V s]
    have e1 := hDi' ((wcProEtBC f).obj V) (s.comp (Limits.pullback.fst V.hom f).base.hom)
    have e2 := hDb ((wcProEtBC i).obj V) (s.comp (Limits.pullback.fst V.hom i).base.hom)
    refine (congrArg (fun y => ((wcRingSheaf Xs' ℓ).obj.map (α.app V).op).hom y) e1).trans ?_
    refine Eq.trans ?_ e2.symm
    refine ContinuousMap.ext fun x => ?_
    have hx : (e V ≫ Limits.pullback.fst (Limits.pullback.snd V.hom f) i' ≫
        Limits.pullback.fst V.hom f) x =
        (Limits.pullback.fst (Limits.pullback.snd V.hom i) b ≫ Limits.pullback.fst V.hom i) x := by
      rw [hα V]
    simp only [Scheme.Hom.comp_apply] at hx
    let s' : C(↥V.left, ULift.{u+1, 0} ℚ_[ℓ]) := s
    exact congrArg s' hx

  let χ : SheafOfModules.pushforward Di'.φ ⋙ Pf ⟶ Pb ⋙ SheafOfModules.pushforward Di.φ :=
    (SheafOfModules.pushforwardComp Df.φ Di'.φ).hom ≫
      SheafOfModules.pushforwardNatTrans (F := wcProEtBC i ⋙ wcProEtBC b)
        (G := wcProEtBC f ⋙ wcProEtBC i') (S := wcRingSheaf Xs' ℓ)
        (Df.φ ≫ ((wcProEtBC f).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.ProEt.topology B) (Scheme.ProEt.topology Xm)).map Di'.φ) α ≫
      (SheafOfModules.pushforwardCongr hφ).hom ≫
      (SheafOfModules.pushforwardComp Di.φ Db.φ).inv
  have hχ : ∀ (N : SheafOfModules.{u+1} (wcRingSheaf Xs' ℓ)) (V : B.ProEt)
      (y : N.val.obj (Opposite.op ((wcProEtBC i').obj ((wcProEtBC f).obj V)))),
      ((χ.app N).val.app (Opposite.op V)).hom y = (N.val.map (α.app V).op).hom y := by
    intro N V y
    first
    | (simp only [χ, NatTrans.comp_app, SheafOfModules.comp_val, PresheafOfModules.comp_app]
       erw [ModuleCat.comp_apply, ModuleCat.comp_apply, ModuleCat.comp_apply,
         SheafOfModules.pushforwardComp_inv_app_val_app,
         SheafOfModules.pushforwardCongr_hom_app_val_app,
         SheafOfModules.pushforwardNatTrans_app_val_app,
         SheafOfModules.pushforwardComp_hom_app_val_app]
       done)
    | rfl

  let g : ∀ X, Pf.obj X ⟶ (SheafOfModules.pushforward Di.φ).obj (Pb.obj (Di'.Φ.obj X)) :=
    fun X => Pf.map (Di'.adj.unit.app X) ≫ χ.app (Di'.Φ.obj X)
  let δ : Pf ⋙ Di.Φ ⟶ Di'.Φ ⋙ Pb :=
    { app := fun X => (Di.adj.homEquiv _ _).symm (g X)
      naturality := fun X Y h => by
        have e1 : h ≫ Di'.adj.unit.app Y = Di'.adj.unit.app X ≫
            (SheafOfModules.pushforward Di'.φ).map (Di'.Φ.map h) := Di'.adj.unit.naturality h
        have e2 : Pf.map ((SheafOfModules.pushforward Di'.φ).map (Di'.Φ.map h)) ≫
            χ.app (Di'.Φ.obj Y) = χ.app (Di'.Φ.obj X) ≫
              (SheafOfModules.pushforward Di.φ).map (Pb.map (Di'.Φ.map h)) :=
          χ.naturality (Di'.Φ.map h)
        show Di.Φ.map (Pf.map h) ≫ (Di.adj.homEquiv _ _).symm (g Y) =
          (Di.adj.homEquiv _ _).symm (g X) ≫ Pb.map (Di'.Φ.map h)
        rw [← Adjunction.homEquiv_naturality_left_symm,
          ← Adjunction.homEquiv_naturality_right_symm]
        refine congrArg (Di.adj.homEquiv _ _).symm ?_
        show Pf.map h ≫ Pf.map (Di'.adj.unit.app Y) ≫ χ.app (Di'.Φ.obj Y) =
          (Pf.map (Di'.adj.unit.app X) ≫ χ.app (Di'.Φ.obj X)) ≫
            (SheafOfModules.pushforward Di.φ).map (Pb.map (Di'.Φ.map h))
        rw [← Pf.map_comp_assoc, e1, Pf.map_comp_assoc, e2, Category.assoc] }
  have hδ : ∀ X, Di.adj.unit.app (Pf.obj X) ≫ (SheafOfModules.pushforward Di.φ).map (δ.app X) =
      g X := by
    intro X
    exact (Di.adj.homEquiv_unit _ _ (δ.app X)).symm.trans
      ((Di.adj.homEquiv _ _).apply_symm_apply (g X))
  refine ⟨δ, fun V => α.app V, hαiso, ?_⟩
  intro X V x
  have h := congrArg (fun φ : Pf.obj X ⟶
      (SheafOfModules.pushforward Di.φ).obj (Pb.obj (Di'.Φ.obj X)) =>
    (φ.val.app (Opposite.op V)).hom x) (hδ X)
  exact h.trans (hχ (Di'.Φ.obj X) V
    (((Di'.adj.unit.app X).val.app (Opposite.op ((wcProEtBC f).obj V))).hom x))

theorem wc_qmbt_pbc_henselian_thick_cover {Y Z : Scheme.{u}} (i : Z ⟶ Y) [IsClosedImmersion i]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (U : Z.ProEt) :
    Sieve.generate (fun (T : Z.ProEt) (_ : T ⟶ U) =>
      ∃ (R : Type u) (_ : CommRing R) (I : Ideal R) (_ : HenselianRing R I) (Vt : Y.ProEt)
        (e : Vt.left ≅ Spec (.of R)) (c : Limits.pullback Vt.hom i ⟶ Spec (.of (R ⧸ I)))
        (_ : (wcProEtBC i).obj Vt ≅ T),
        IsPullback (Limits.pullback.fst Vt.hom i) c e.hom
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) ∧
        Projective (wcFreeSheaf Y Vt) ∧ Projective (wcFreeSheaf Z ((wcProEtBC i).obj Vt)) ∧
        ∀ M : SheafOfModules.{u+1} (wcRingSheaf Y ℓ),
          Function.Bijective ((Di.adj.unit.app M).val.app (Opposite.op Vt)).hom)
      ∈ Scheme.ProEt.topology Z U :=
by
  classical
  refine (Scheme.ProEt.topology Z).superset_covering (Sieve.generate_mono ?_)
    (wc_proet_wcontr_affine_open_cover i U)
  rintro T f ⟨⟨O, hO, hTO⟩, hT⟩
  obtain ⟨A, iA, I, iI, Vt, e, c, κ, hsq, hV, hiV⟩ :=
    wc_proet_henselian_thickening_exists i T O hO hTO hT
  have hinit : ∀ V : Y.ProEt,
      Function.Bijective (fun a : Vt ⟶ V => (wcProEtBaseChange i).map a) := by
    intro V
    refine wc_proet_thickening_bc_hom_bijective i A I Vt e c hsq ?_ V
    intro X S g _ a b hab
    exact wc_weaklyEtale_henselian_lift g A I a b hab
  refine ⟨A, iA, I, iI, Vt, e, c, κ, hsq,
    wc_proet_free_projective_wcontractible Y Vt hV,
    wc_proet_free_projective_wcontractible Z ((wcProEtBC i).obj Vt) hiV, fun M => ?_⟩
  apply wc_hm_pull_unit_bij_of_lan i ℓ Di hDi Vt M
  refine Function.Bijective.comp ?_ (wc_proet_lan_unit_bijective_of_init i Vt hinit M.val.presheaf)
  apply wc_proet_toSheafify_bijective_wcontr Z _ _ hiV
  intro m Q ι hι hpart
  obtain ⟨Vk, ιt, κk, hιt, hpt, hκ, hthick⟩ :=
    wc_proet_thickening_clopen_lift i A I Vt e c hsq m Q ι hι hpart
  refine wc_proet_lan_clopen_additive i Vt ((SheafOfModules.toSheaf (wcRingSheaf Y ℓ)).obj M)
    m Q ι Vk ιt κk hιt hpt hκ
    (wc_proet_lan_unit_bijective_of_init i Vt hinit M.val.presheaf) (fun k => ?_)
  obtain ⟨Ak, iAk, Ik, iIk, ek, ck, hsqk⟩ := hthick k
  refine wc_proet_lan_unit_bijective_of_init i (Vk k) (fun V => ?_) M.val.presheaf
  refine wc_proet_thickening_bc_hom_bijective i Ak Ik (Vk k) ek ck hsqk ?_ V
  intro X S g _ a b hab
  exact wc_weaklyEtale_henselian_lift g Ak Ik a b hab

theorem wc_qmbt_pbc_sections_homology {S : Scheme.{u}} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (W : S.ProEt) (hW : Projective (wcFreeSheaf S W))
    {C D : CochainComplex (SheafOfModules.{u+1} (wcRingSheaf S ℓ)) ℤ} (φ : C ⟶ D) (q : ℤ) :
    QuasiIsoAt (((wcSecEv S ℓ W).mapHomologicalComplex (ComplexShape.up ℤ)).map φ) q →
