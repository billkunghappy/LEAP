  refine ⟨a, ?_⟩
  have e1 := Scheme.fromSpecResidueField_apply x
    (IsLocalRing.closedPoint ((Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi).residueField x))
  have e2 := congrArg (fun f : Spec ((Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi).residueField x) ⟶
      Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi =>
    f (IsLocalRing.closedPoint ((Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi).residueField x)))
    hext
  have e3 : ∀ y : ↥(Spec ((Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi).residueField x)),
      ((Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi).fromSpecResidueField x ≫
        Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi ≫ sc a) y =
      (sc a).base.hom ((Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi).base.hom
