          exact this
        · rw [hψi i (by omega), hΦ1]
          have h1 := RingHom.congr_fun hpo1 (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
            (MvPolynomial.X i))
          simp only [RingHom.comp_apply] at h1
          rw [h1, hθi i (by omega)]
    rw [huniq _ ⟨hA1, hA2⟩, huniq iC ⟨rfl, rfl⟩]

  have h1 : Φ.comp Ψ = RingHom.id _ := by
    refine text _ _ _ _ _ _ ?_
    intro l c
    simp only [RingHom.comp_apply, RingHom.id_apply]
    rw [hΨ, map_mul]
    have e1 : Φ (((AdjoinRoot.of _).comp
        (Algebra.TensorProduct.includeLeftRingHom : L →+* TensorProduct A L R)) l) =
        l ⊗ₜ[AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)] (1 : C) := by
      show Φ (AdjoinRoot.of _ (l ⊗ₜ[A] (1 : R))) = _
      rw [hΦ1, map_one]
    have e2 : Φ (ψC c) = (1 : L) ⊗ₜ[AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)] c := by
      rw [← RingHom.comp_apply Φ ψC, hkey, hiC]
    rw [e1, e2, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  exact ⟨RingEquiv.ofRingHom Φ Ψ h1 h2⟩

theorem wc_qmtm_level_double_higher_vanish : ∀ (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A) →
    ∀ (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} →
    ∀ (r : ℕ) (R : Type u) [CommRing R] [HenselianLocalRing R]
      [IsSepClosed (IsLocalRing.ResidueField R)]
      (ρ : wcQuadModelRing A (r + 2) π (wcQmtmC A r) →+* R),
