  ·
    intro W s hs
    have hcov := wc_proet_cover_of_affine_local
      (fun Δ : Scheme.{u} => IsClosed {x : Δ | IsClosed ({x} : Set Δ)} ∧
        (∀ x : Δ, ∃! y : Δ, IsClosed ({y} : Set Δ) ∧ x ⤳ y) ∧
