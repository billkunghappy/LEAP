      (Spec.map (CommRingCat.ofHom ρ) ≫ Spec.map (CommRingCat.ofHom (algebraMap A Q)))
      (Spec.map (CommRingCat.ofHom φA))
      (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))).hom n q
