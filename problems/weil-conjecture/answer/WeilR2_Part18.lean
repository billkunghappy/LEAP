    haveI := D.additive
    haveI := D.presLim
    haveI := D.presColim
    obtain ⟨βi, hβi⟩ := wc_tsf_push_slice_bc S' ℓ Dw hDw V ((wcProEtBC w).obj V)
      (Limits.pullback.fst V.hom w) (IsPullback.of_hasPullback V.hom w).flip D hD
    obtain ⟨H1, H2⟩ := wc_tsf_bc_unit_compat S' ℓ Dw hDw P ev hnat V D hD βi.hom hβi (ε V)
      (hεval V) (ε ((wcProEtBC w).obj V)) (hεval ((wcProEtBC w).obj V))
    have hν := wc_hm_pull_unit_transpose_isIso (Limits.pullback.fst V.hom w) ℓ D hD
    exact @ext_tsf_bc_mate_chase _ _ _ (hE S') _ _ _ (hE V.left) _ _ _
