      letI : Algebra Q Q' := θ.toAlgebra
      (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct Q R Q').comp ρ =
        (Algebra.TensorProduct.includeRight : Q' →ₐ[Q] TensorProduct Q R Q').toRingHom.comp θ ∧
      ∀ (T : Type u) [CommRing T] (f : R →+* T) (g : Q' →+* T), f.comp ρ = g.comp θ →
        ∃! h : TensorProduct Q R Q' →+* T,
          h.comp Algebra.TensorProduct.includeLeftRingHom = f ∧
          h.comp (Algebra.TensorProduct.includeRight : Q' →ₐ[Q] TensorProduct Q R Q').toRingHom = g := by
    intro Q R Q' _ _ _ ρ θ
    letI : Algebra Q R := ρ.toAlgebra
    letI : Algebra Q Q' := θ.toAlgebra
    refine ⟨?_, ?_⟩
    · ext q
      exact Algebra.TensorProduct.tmul_one_eq_one_tmul q
    · intro T _ f g hfg
      letI iQT : Algebra Q T := (f.comp ρ).toAlgebra
      let f' : R →ₐ[Q] T := { f with commutes' := fun q => rfl }
      let g' : Q' →ₐ[Q] T := { g with commutes' := fun q => (RingHom.congr_fun hfg q).symm }
      refine ⟨(Algebra.TensorProduct.productMap f' g').toRingHom, ⟨?_, ?_⟩, ?_⟩
      · ext x
        simp [f']
      · ext x
        simp [g']
      · rintro h' ⟨hl, hr⟩
        apply RingHom.ext
        intro x
        induction x using TensorProduct.induction_on with
        | zero => simp
        | tmul a b =>
          have e : (a ⊗ₜ[Q] b) =
              Algebra.TensorProduct.includeLeftRingHom a *
                (Algebra.TensorProduct.includeRight : Q' →ₐ[Q] TensorProduct Q R Q') b := by
            simp
          have ha := RingHom.congr_fun hl a
          have hb := RingHom.congr_fun hr b
          simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe] at ha hb
          rw [e, map_mul, ha, hb]
          simp [f', g']
        | add x y hx hy => rw [map_add, map_add, hx, hy]
  obtain ⟨hpo1, hpo2⟩ := s9 _ _ _ ρ θ

  obtain ⟨e⟩ := wc_qmlm_level_tensor_iso A π r (ℓ ^ k) hN hA hA' R ρ L φA φ' hφ'A hzL θ hθA hθ0 hθ1 hθi
    _ _ _ hpo1 hpo2

  have hψL : Function.Injective ((algebraMap L (AlgebraicClosure L)).comp φ') :=
    (algebraMap L (AlgebraicClosure L)).injective.comp hφ'inj

  have hc0 := hv_gen (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π))
    ℓ hℓ' (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π)) hmax' r hA'
    _ _ hWE' (hmemC _ (Set.mem_insert _ _)) (hmemC _ (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
    (AlgebraicClosure L) _ hψL

  obtain ⟨E3⟩ := descent (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π))
    (wcQuadModelRing (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π)) (r + 2)
        (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π))
        (wcQmtmC (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π)) r))
    (TensorProduct (wcQuadModelRing A (r + 2) π (wcQmtmC A r)) R
        (wcQuadModelRing (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π)) (r + 2)
        (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π))
        (wcQmtmC (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π)) r))) L
    (Algebra.TensorProduct.includeRight : (wcQuadModelRing (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) -
        Polynomial.C π)) (r + 2)
        (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π))
        (wcQmtmC (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π)) r)) →ₐ[wcQuadModelRing A (r + 2) π (wcQmtmC A r)]
      TensorProduct (wcQuadModelRing A (r + 2) π (wcQmtmC A r)) R
        (wcQuadModelRing (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π)) (r + 2)
        (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π))
        (wcQmtmC (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C π)) r))).toRingHom
    φ' ℓ 1

  obtain ⟨E⟩ := wc_et_coh_iso_invariance (Spec.map e.toCommRingCatIso.hom) ℓ 1

  refine (Nat.card_congr (wc_et_zmodext_coh_equiv _ ℓ 1).some).trans ?_
  exact (Nat.card_congr E).trans ((Nat.card_congr E3).trans hc0)

theorem wc_qmtm_h1k_root_not_pow : ∀ (M : Type u) [CommRing M] (ℓ : ℕ), ℓ.Prime →
    IsUnit ((ℓ : ℕ) : M) → ∀ (k : ℕ) (x : M),
    ConnectedSpace (PrimeSpectrum (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C x))) →
    ConnectedSpace (PrimeSpectrum (AdjoinRoot (Polynomial.X ^ (ℓ ^ (k + 1)) - Polynomial.C x))) →
    IsUnit (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C x)) →
    ¬ ∃ s : AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C x),
      s ^ ℓ = AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C x) :=
by
  rintro M _ ℓ hℓ hℓM k x hA hB ht ⟨s, hs⟩

  have idem : ∀ (R : Type u) [CommRing R], ConnectedSpace (PrimeSpectrum R) →
      ∀ e : R, IsIdempotentElem e → e = 0 ∨ e = 1 := by
    intro R _ hR e he
    have := hR
    have hcl : IsClopen ((PrimeSpectrum.basicOpen e : Set (PrimeSpectrum R))) :=
      PrimeSpectrum.isClopen_iff.mpr ⟨e, he, rfl⟩
    rcases _root_.isClopen_iff.mp hcl with h | h
    · left
      apply he.eq_zero_of_isNilpotent
      rw [← PrimeSpectrum.basicOpen_eq_bot_iff]
      exact TopologicalSpace.Opens.ext (h.trans TopologicalSpace.Opens.coe_bot.symm)
    · right
      have h1 : IsNilpotent (1 - e) := by
        rw [← PrimeSpectrum.basicOpen_eq_bot_iff]
        apply TopologicalSpace.Opens.ext
        rw [TopologicalSpace.Opens.coe_bot, Set.eq_empty_iff_forall_notMem]
        intro p hp
        have hpe : p ∈ (PrimeSpectrum.basicOpen e : Set (PrimeSpectrum R)) := by
          rw [h]; trivial
        rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen] at hpe hp
        have hmul : e * (1 - e) ∈ p.asIdeal := by
          rw [mul_sub, mul_one, he.eq, sub_self]; exact p.asIdeal.zero_mem
        rcases p.isPrime.mem_or_mem hmul with h2 | h2
        · exact hpe h2
        · exact hp h2
      have := he.one_sub.eq_zero_of_isNilpotent h1
      exact (sub_eq_zero.mp this).symm

  have kummer : ∀ (R : Type u) [CommRing R] [Nontrivial R], IsUnit ((ℓ : ℕ) : R) →
      ∀ f : Polynomial R, f = Polynomial.X ^ ℓ - Polynomial.C 1 →
      ∃ e : AdjoinRoot f, IsIdempotentElem e ∧ e ≠ 0 ∧ e ≠ 1 := by
    intro R _ _ hℓR f hf
    obtain ⟨c, hc⟩ := hℓR.exists_left_inv
    have h2 : 2 ≤ ℓ := hℓ.two_le
    have hc0 : c ≠ 0 := by
      intro h0; rw [h0, zero_mul] at hc; exact zero_ne_one hc
    have hfm : f.Monic := by rw [hf]; exact Polynomial.monic_X_pow_sub_C 1 hℓ.ne_zero
    have hfd : f.natDegree = ℓ := by rw [hf]; exact Polynomial.natDegree_X_pow_sub_C
    have hu : (AdjoinRoot.root f) ^ ℓ = 1 := by
      have h0 : AdjoinRoot.mk f (Polynomial.X ^ ℓ - Polynomial.C 1) = 0 := by
        rw [← hf]; exact AdjoinRoot.mk_self
      rwa [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, map_one, sub_eq_zero] at h0
    obtain ⟨S, hS⟩ : ∃ S : AdjoinRoot f, S = ∑ i ∈ Finset.range ℓ, (AdjoinRoot.root f) ^ i :=
      ⟨_, rfl⟩
    have huS : AdjoinRoot.root f * S = S := by
      have := mul_geom_sum (AdjoinRoot.root f) ℓ
      rw [hu, sub_self, sub_mul, one_mul, sub_eq_zero, ← hS] at this
      exact this
    have hpowS : ∀ i : ℕ, (AdjoinRoot.root f) ^ i * S = S := by
      intro i
      induction i with
      | zero => simp
      | succ i ih => rw [pow_succ, mul_assoc, huS, ih]
    have hSS : S * S = (ℓ : AdjoinRoot f) * S := by
      calc S * S = ∑ i ∈ Finset.range ℓ, (AdjoinRoot.root f) ^ i * S := by
            rw [hS, Finset.sum_mul]
        _ = ∑ i ∈ Finset.range ℓ, S := Finset.sum_congr rfl (fun i _ => hpowS i)
        _ = (ℓ : AdjoinRoot f) * S := by rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    have hcℓ : (AdjoinRoot.of f c) * (ℓ : AdjoinRoot f) = 1 := by
      rw [← map_natCast (AdjoinRoot.of f) ℓ, ← map_mul, hc, map_one]
    obtain ⟨g, hg⟩ : ∃ g : Polynomial R,
        g = ∑ i ∈ Finset.range ℓ, Polynomial.C c * Polynomial.X ^ i := ⟨_, rfl⟩
    have heg : AdjoinRoot.of f c * S = AdjoinRoot.mk f g := by
      rw [hg, map_sum, hS, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [map_mul, map_pow, AdjoinRoot.mk_C, AdjoinRoot.mk_X]
    have hgc : ∀ n, g.coeff n = if n < ℓ then c else 0 := by
      intro n
      rw [hg, Polynomial.finsetSum_coeff]
      simp
    have hgd : g.natDegree ≤ ℓ - 1 := by
      rw [hg]
      apply Polynomial.natDegree_sum_le_of_forall_le
      intro i hi
      have := Finset.mem_range.mp hi
      exact (Polynomial.natDegree_C_mul_X_pow_le c i).trans (by omega)
    refine ⟨AdjoinRoot.of f c * S, ?_, ?_, ?_⟩
    · show (AdjoinRoot.of f c * S) * (AdjoinRoot.of f c * S) = AdjoinRoot.of f c * S
      calc (AdjoinRoot.of f c * S) * (AdjoinRoot.of f c * S)
          = AdjoinRoot.of f c * (AdjoinRoot.of f c * ((ℓ : AdjoinRoot f) * S)) := by
            rw [← hSS]; ring
        _ = AdjoinRoot.of f c * S := by linear_combination (AdjoinRoot.of f c * S) * hcℓ
    · rw [heg]
      refine AdjoinRoot.mk_ne_zero_of_natDegree_lt hfm ?_ (by rw [hfd]; omega)
      intro h
      have := hgc 0
      rw [h, Polynomial.coeff_zero, if_pos (by omega)] at this
      exact hc0 this.symm
    · rw [heg]
      intro h
      have hm : AdjoinRoot.mk f (g - 1) = 0 := by rw [map_sub, h, map_one, sub_self]
      have h1 : (g - 1).coeff 1 = c := by
        rw [Polynomial.coeff_sub, hgc]
        have h12 : 1 < ℓ := by omega
        simp [Polynomial.coeff_one, h12]
      have hne : g - 1 ≠ 0 := by
        intro h0; rw [h0, Polynomial.coeff_zero] at h1; exact hc0 h1.symm
      have hdeg : (g - 1).natDegree < f.natDegree := by
        refine (Polynomial.natDegree_sub_le g 1).trans_lt ?_
        rw [Polynomial.natDegree_one, hfd]; omega
      exact AdjoinRoot.mk_ne_zero_of_natDegree_lt hfm hne hdeg hm

  have retract : ∀ (fA fB : Polynomial M), fA = Polynomial.X ^ (ℓ ^ k) - Polynomial.C x →
      fB = Polynomial.X ^ (ℓ ^ (k + 1)) - Polynomial.C x →
      ∀ s : AdjoinRoot fA, IsUnit s → s ^ ℓ = AdjoinRoot.root fA →
      ∀ fC : Polynomial (AdjoinRoot fA), fC = Polynomial.X ^ ℓ - Polynomial.C 1 →
      ∃ (χ : AdjoinRoot fC →+* AdjoinRoot fB) (ψ : AdjoinRoot fB →+* AdjoinRoot fC),
        ψ.comp χ = RingHom.id _ := by
    intro fA fB hfA hfB s hsu hs fC hfC
    have hxA : AdjoinRoot.root fA ^ (ℓ ^ k) = AdjoinRoot.of fA x := by
      have h0 : AdjoinRoot.mk fA (Polynomial.X ^ (ℓ ^ k) - Polynomial.C x) = 0 := by
        rw [← hfA]; exact AdjoinRoot.mk_self
      rwa [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h0
    have hxB : AdjoinRoot.root fB ^ (ℓ ^ (k + 1)) = AdjoinRoot.of fB x := by
      have h0 : AdjoinRoot.mk fB (Polynomial.X ^ (ℓ ^ (k + 1)) - Polynomial.C x) = 0 := by
        rw [← hfB]; exact AdjoinRoot.mk_self
      rwa [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h0
    have huC : AdjoinRoot.root fC ^ ℓ = 1 := by
      have h0 : AdjoinRoot.mk fC (Polynomial.X ^ ℓ - Polynomial.C 1) = 0 := by
        rw [← hfC]; exact AdjoinRoot.mk_self
      rwa [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, map_one, sub_eq_zero] at h0
    have hσ : Polynomial.eval₂ (AdjoinRoot.of fB) (AdjoinRoot.root fB ^ ℓ) fA = 0 := by
      rw [hfA, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, ← pow_mul,
        ← pow_succ', hxB, sub_self]
    obtain ⟨σ, hσof, hσt⟩ : ∃ σ : AdjoinRoot fA →+* AdjoinRoot fB,
        (∀ m, σ (AdjoinRoot.of fA m) = AdjoinRoot.of fB m) ∧
          σ (AdjoinRoot.root fA) = AdjoinRoot.root fB ^ ℓ :=
      ⟨AdjoinRoot.lift _ _ hσ, fun m => AdjoinRoot.lift_of hσ, AdjoinRoot.lift_root hσ⟩
    obtain ⟨s', hs'⟩ := hsu.exists_right_inv
    have hy : AdjoinRoot.root fB ^ ℓ = σ s ^ ℓ := by rw [← hσt, ← hs, map_pow]
    have hχ : Polynomial.eval₂ σ (AdjoinRoot.root fB * σ s') fC = 0 := by
      rw [hfC, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, map_one, mul_pow,
        hy, ← mul_pow, ← map_mul, hs', map_one, one_pow, sub_self]
    obtain ⟨χ, hχof, hχroot⟩ : ∃ χ : AdjoinRoot fC →+* AdjoinRoot fB,
        (∀ a, χ (AdjoinRoot.of fC a) = σ a) ∧
          χ (AdjoinRoot.root fC) = AdjoinRoot.root fB * σ s' :=
      ⟨AdjoinRoot.lift _ _ hχ, fun a => AdjoinRoot.lift_of hχ, AdjoinRoot.lift_root hχ⟩
    have hψ : Polynomial.eval₂ ((AdjoinRoot.of fC).comp (AdjoinRoot.of fA))
        (AdjoinRoot.of fC s * AdjoinRoot.root fC) fB = 0 := by
      rw [hfB, Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, pow_succ',
        pow_mul, mul_pow, ← map_pow, hs, huC, mul_one, RingHom.comp_apply, ← map_pow, hxA,
        sub_self]
    obtain ⟨ψ, hψof, hψroot⟩ : ∃ ψ : AdjoinRoot fB →+* AdjoinRoot fC,
        (∀ m, ψ (AdjoinRoot.of fB m) = AdjoinRoot.of fC (AdjoinRoot.of fA m)) ∧
          ψ (AdjoinRoot.root fB) = AdjoinRoot.of fC s * AdjoinRoot.root fC :=
      ⟨AdjoinRoot.lift _ _ hψ, fun m => AdjoinRoot.lift_of hψ, AdjoinRoot.lift_root hψ⟩
    have key : ψ.comp σ = AdjoinRoot.of fC := by
      apply AdjoinRoot.ringHom_ext
      · refine RingHom.ext fun m => ?_
        simp only [RingHom.comp_apply, hσof, hψof]
      · rw [RingHom.comp_apply, hσt, map_pow, hψroot, mul_pow, ← map_pow, hs, huC, mul_one]
    have hψσ : ∀ a, ψ (σ a) = AdjoinRoot.of fC a := fun a => RingHom.congr_fun key a
    refine ⟨χ, ψ, ?_⟩
    apply AdjoinRoot.ringHom_ext
    · refine RingHom.ext fun a => ?_
      simp only [RingHom.comp_apply, RingHom.id_apply, hχof, hψσ]
    · rw [RingHom.comp_apply, hχroot, map_mul, hψroot, hψσ, RingHom.id_apply, mul_right_comm,
        ← map_mul, hs', map_one, one_mul]

  have hnt : Nontrivial (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C x)) :=
    PrimeSpectrum.nonempty_iff_nontrivial.mp (@ConnectedSpace.toNonempty _ _ hA)
  have hℓA : IsUnit ((ℓ : ℕ) : AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C x)) := by
    have := hℓM.map (AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C x))
    rwa [map_natCast] at this
  have hsu : IsUnit s := (isUnit_pow_iff hℓ.ne_zero).mp (hs ▸ ht)
  obtain ⟨χ, ψ, hψχ⟩ := retract _ _ rfl rfl s hsu hs _ rfl
  obtain ⟨e, he, he0, he1⟩ := kummer _ hℓA _ rfl
  have hχe : IsIdempotentElem (χ e) := by
    show χ e * χ e = χ e
    rw [← map_mul, he.eq]
  have hback : ψ (χ e) = e := RingHom.congr_fun hψχ e
  rcases idem _ hB _ hχe with h | h
  · apply he0; rw [← hback, h]; exact map_zero ψ
  · apply he1; rw [← hback, h]; exact map_one ψ

theorem wc_qmtm_h1k_gm_transport_top : ∀ (Y Z : Scheme.{u}) (σ : Z ⟶ Y) (ℓ : ℕ)
    (A : wcR2gsAdjData σ ℓ), ∃ c : A.L.obj (wcEtGm Y) ⟶ wcEtGm Z,
    ∀ (hg : σ ≫ (wcEtTop Y).hom = (wcEtTop Z).hom ≫ σ) (a : (Γ(Y, ⊤))ˣ),
      (c.hom.app (Opposite.op (wcEtTop Z))).hom ((A.ρ (wcEtGm Y)).ρ (wcEtTop Y) (wcEtTop Z) σ hg
        (((toSheafify (Scheme.smallEtaleTopology Y) (wcEtGmPre Y)).app (Opposite.op (wcEtTop Y))).hom
          (ULift.up (Additive.ofMul a)))) =
      ((toSheafify (Scheme.smallEtaleTopology Z) (wcEtGmPre Z)).app (Opposite.op (wcEtTop Z))).hom
        (ULift.up (Additive.ofMul (Units.map σ.appTop.hom.toMonoidHom a))) :=
by
  intro Y Z σ ℓ A
  let G : Scheme.{u}ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    (Scheme.Γ : Scheme.{u}ᵒᵖ ⥤ CommRingCat.{u}) ⋙ forget₂ CommRingCat CommMonCat ⋙
      CommMonCat.units ⋙ CommGrpCat.toAddCommGrp ⋙ AddCommGrpCat.uliftFunctor.{u+1, u}
  let τP := toSheafify (Scheme.smallEtaleTopology Y) (wcEtGmPre Y)
  let τQ := toSheafify (Scheme.smallEtaleTopology Z) (wcEtGmPre Z)
  haveI : IsIso τP := isIso_toSheafify _ (wc_et_gm_pre_isSheaf Y)
  let ι := inv τP
  have hι : ∀ (V : Y.Etale) (x : (wcEtGmPre Y).obj (Opposite.op V)),
      (ι.app (Opposite.op V)).hom ((τP.app (Opposite.op V)).hom x) = x := by
    intro V x
    have h := congrArg (fun f => (f.app (Opposite.op V)).hom x) (IsIso.hom_inv_id τP)
    simp only [NatTrans.comp_app, NatTrans.id_app, AddCommGrpCat.hom_comp,
      AddMonoidHom.comp_apply, AddCommGrpCat.hom_id, AddMonoidHom.id_apply] at h
    exact h
  let T : wcEtTransport σ (wcEtGm Y) (wcEtGm Z) :=
    { ρ := fun V O h _ => (τQ.app (Opposite.op O)).hom.comp
          ((G.map h.op).hom.comp (ι.app (Opposite.op V)).hom)
      nat := by
        intro V V' c O O' d h hh h' hh' hcomm x
        have e1 : (ι.app (Opposite.op V')).hom
            (((sheafify (Scheme.smallEtaleTopology Y) (wcEtGmPre Y)).map c.op).hom x) =
            (G.map c.left.op).hom ((ι.app (Opposite.op V)).hom x) := by
          have h1 := congrArg (fun f => f.hom x) (ι.naturality c.op)
          simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at h1
          exact h1
        have e2 : ∀ y, (G.map h'.op).hom ((G.map c.left.op).hom y) =
            (G.map d.left.op).hom ((G.map h.op).hom y) := by
          intro y
          have h2 : c.left.op ≫ h'.op = h.op ≫ d.left.op := by
            rw [← op_comp, ← op_comp, hcomm]
          have h3 := congrArg (fun f => (G.map f).hom y) h2
          simp only [Functor.map_comp, AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at h3
          exact h3
        have e3 : ∀ z, (τQ.app (Opposite.op O')).hom ((G.map d.left.op).hom z) =
            (((sheafify (Scheme.smallEtaleTopology Z) (wcEtGmPre Z)).map d.op).hom
              ((τQ.app (Opposite.op O)).hom z)) := by
          intro z
          have h4 := congrArg (fun f => f.hom z) (τQ.naturality d.op)
          simp only [AddCommGrpCat.hom_comp, AddMonoidHom.comp_apply] at h4
          exact h4
        change (τQ.app (Opposite.op O')).hom ((G.map h'.op).hom ((ι.app (Opposite.op V')).hom
            (((sheafify (Scheme.smallEtaleTopology Y) (wcEtGmPre Y)).map c.op).hom x))) =
          (((sheafify (Scheme.smallEtaleTopology Z) (wcEtGmPre Z)).map d.op).hom
            ((τQ.app (Opposite.op O)).hom ((G.map h.op).hom ((ι.app (Opposite.op V)).hom x))))
        rw [e1]
        exact (congrArg (fun w => (τQ.app (Opposite.op O')).hom w) (e2 _)).trans (e3 _) }
  obtain ⟨c, hc, -⟩ := A.nut.1 (wcEtGm Y) (wcEtGm Z) T
  refine ⟨c, fun hg a => ?_⟩
  refine (hc (wcEtTop Y) (wcEtTop Z) σ hg _).trans ?_
  have key := hι (wcEtTop Y) (ULift.up (Additive.ofMul a))
  first
    | exact congrArg (fun w => (τQ.app (Opposite.op (wcEtTop Z))).hom ((G.map σ.op).hom w)) key
    | (change (τQ.app (Opposite.op (wcEtTop Z))).hom ((G.map σ.op).hom
          ((ι.app (Opposite.op (wcEtTop Y))).hom ((τP.app (Opposite.op (wcEtTop Y))).hom
            (ULift.up (Additive.ofMul a))))) = _
       rw [key]
       rfl)

