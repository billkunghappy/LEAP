    QuasiCompact (a₀ ≫ wcQuadModelStr A 2 π c) ∧ QuasiSeparated (a₀ ≫ wcQuadModelStr A 2 π c) ∧
    (∀ x : Spec (.of B₀), ∃ (U : (Spec (.of B₀)).Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
      x ∈ U ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) =
        U.ι ≫ a₀ ≫ wcQuadModelStr A 2 π c) ∧
    (∃ (U : (Spec (.of B₀)).Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))))
      (y : U.toScheme),
      WeaklyEtale g ∧
      g ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) =
        U.ι ≫ a₀ ≫ wcQuadModelStr A 2 π c ∧
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g y) ∧
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
          (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (g y)) :=
by
  intro A _ _ _ _ _ π c hπ hc x₀ hx₀ B₀ _ _ _ Λ₀ _ _ W₀ φ₀ a₀ hsh
  classical
  have hwa : WeaklyEtale a₀ := wc_shdata_weaklyEtale x₀ B₀ Λ₀ W₀ φ₀ a₀ hsh
  have hcp : a₀ (IsLocalRing.closedPoint B₀ : Spec (.of B₀)) = x₀ := by
    obtain ⟨eK, -, heK⟩ := hsh.2.2.2.2.2
    let z : Spec (.of (AlgebraicClosure ((Spec (.of (wcQuadModelRing A 2 π c))).residueField x₀))) :=
      IsLocalRing.closedPoint (AlgebraicClosure ((Spec (.of (wcQuadModelRing A 2 π c))).residueField x₀))
    have hz := congrArg (fun h => h z) heK
    simp only [Scheme.Hom.comp_apply] at hz
    have hpt : (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₀)))
        ((Spec.map (CommRingCat.ofHom eK)) z) = (IsLocalRing.closedPoint B₀ : Spec (.of B₀)) :=
      (Spec.map_apply _ _).trans ((congrArg (PrimeSpectrum.comap (IsLocalRing.residue B₀))
        (Subsingleton.elim ((Spec.map (CommRingCat.ofHom eK)) z :
          PrimeSpectrum (IsLocalRing.ResidueField B₀))
          (IsLocalRing.closedPoint (IsLocalRing.ResidueField B₀)))).trans
        (IsLocalRing.comap_closedPoint (IsLocalRing.residue B₀)))
    exact (congrArg a₀ hpt).symm.trans (hz.trans (Scheme.fromSpecResidueField_apply _ _))
  obtain ⟨b, e, δi, h1, h2, h3⟩ : ∃ b e δi : A, b * e = c 1 1 ∧ e + b * c 0 0 = c 0 1 + c 1 0 ∧
      (e - b * c 0 0) * δi = 1 := by
    classical
    have hdet : (c + c.transpose).det = -((c 0 1 + c 1 0) ^ 2 - 4 * (c 0 0 * c 1 1)) := by
      rw [Matrix.det_fin_two]
      simp only [Matrix.add_apply, Matrix.transpose_apply]
      ring
    have hΔ : IsUnit ((c 0 1 + c 1 0) ^ 2 - 4 * (c 0 0 * c 1 1)) := by
      have h := hc.neg
      rwa [hdet, neg_neg] at h
    obtain ⟨Δi, hΔi⟩ := hΔ.exists_right_inv
    let g : Polynomial A := Polynomial.X ^ 2 + Polynomial.C (c 0 1 + c 1 0) * Polynomial.X +
      Polynomial.C (c 0 0 * c 1 1)
    have hgm : g.Monic := by
      simp only [g]; monicity!
    have hgdeg : g.degree = 2 := by
      simp only [g]; compute_degree!
    have hgeval : ∀ t : A, g.eval t = t ^ 2 + (c 0 1 + c 1 0) * t + c 0 0 * c 1 1 := by
      intro t; simp [g]
    have hder : Polynomial.derivative g =
        Polynomial.C 2 * Polynomial.X + Polynomial.C (c 0 1 + c 1 0) := by
      simp only [g, Polynomial.derivative_add, Polynomial.derivative_X_pow,
        Polynomial.derivative_C_mul_X, Polynomial.derivative_C]
      simp
    have hsep : g.Separable := by
      rw [Polynomial.separable_def']
      refine ⟨Polynomial.C (-4 * Δi), Polynomial.C Δi * Polynomial.derivative g, ?_⟩
      rw [hder]
      have h1 : (1 : Polynomial A) =
          Polynomial.C (((c 0 1 + c 1 0) ^ 2 - 4 * (c 0 0 * c 1 1)) * Δi) := by
        rw [hΔi, map_one]
      rw [h1]
      simp only [g, map_mul, map_sub, map_pow, map_add, map_neg, map_ofNat]
      ring
    have hgbar_deg : (g.map (IsLocalRing.residue A)).degree ≠ 0 := by
      rw [hgm.degree_map, hgdeg]; norm_num
    obtain ⟨tb, htb⟩ := IsSepClosed.exists_root (g.map (IsLocalRing.residue A)) hgbar_deg
      (hsep.map)
    obtain ⟨t, rfl⟩ := IsLocalRing.residue_surjective tb
    have hgt : g.eval t ∈ IsLocalRing.maximalIdeal A := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      rw [Polynomial.IsRoot.def, Polynomial.eval_map, Polynomial.eval₂_hom] at htb
      exact htb
    have hdt : IsUnit ((Polynomial.derivative g).eval t) := by
      rw [hder]
      simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X]
      have hsq : (2 * t + (c 0 1 + c 1 0)) ^ 2 =
          ((c 0 1 + c 1 0) ^ 2 - 4 * (c 0 0 * c 1 1)) + 4 * g.eval t := by
        rw [hgeval]; ring
      have hu : IsUnit ((2 * t + (c 0 1 + c 1 0)) ^ 2) := by
        by_contra hn
        have h1 : (2 * t + (c 0 1 + c 1 0)) ^ 2 ∈ IsLocalRing.maximalIdeal A := by
          rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]; exact hn
        have h2 : 4 * g.eval t ∈ IsLocalRing.maximalIdeal A := Ideal.mul_mem_left _ _ hgt
        have h3 : ((c 0 1 + c 1 0) ^ 2 - 4 * (c 0 0 * c 1 1)) ∈ IsLocalRing.maximalIdeal A := by
          have := Ideal.sub_mem _ h1 h2
          rwa [hsq, add_sub_cancel_right] at this
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h3
        exact h3 hΔ
      exact (isUnit_pow_iff two_ne_zero).mp hu
    obtain ⟨ρ0, hρ0, -⟩ := HenselianLocalRing.is_henselian g hgm t hgt hdt
    have hr0 : ρ0 ^ 2 + (c 0 1 + c 1 0) * ρ0 + c 0 0 * c 1 1 = 0 := by
      rw [← hgeval]; exact hρ0
    have hu0 : IsUnit (2 * ρ0 + (c 0 1 + c 1 0)) := by
      have h : (2 * ρ0 + (c 0 1 + c 1 0)) ^ 2 = (c 0 1 + c 1 0) ^ 2 - 4 * (c 0 0 * c 1 1) := by
        linear_combination 4 * hr0
      exact (isUnit_pow_iff two_ne_zero).mp (by rw [h]; exact hΔ)
    obtain ⟨ρ, hρu, hr, hu⟩ : ∃ ρ : A, IsUnit ρ ∧ ρ ^ 2 + (c 0 1 + c 1 0) * ρ + c 0 0 * c 1 1 = 0 ∧
        IsUnit (2 * ρ + (c 0 1 + c 1 0)) := by
      by_cases h0 : IsUnit ρ0
      · exact ⟨ρ0, h0, hr0, hu0⟩
      · refine ⟨-(c 0 1 + c 1 0) - ρ0, ?_, by linear_combination hr0, ?_⟩
        · have hsum : IsUnit ((-(c 0 1 + c 1 0) - ρ0) + (-ρ0)) := by
            have h : (-(c 0 1 + c 1 0) - ρ0) + (-ρ0) = -(2 * ρ0 + (c 0 1 + c 1 0)) := by ring
            rw [h]; exact hu0.neg
          rcases IsLocalRing.isUnit_or_isUnit_of_isUnit_add hsum with h | h
          · exact h
          · exact (h0 (by simpa using h.neg)).elim
        · have h : 2 * (-(c 0 1 + c 1 0) - ρ0) + (c 0 1 + c 1 0) = -(2 * ρ0 + (c 0 1 + c 1 0)) := by
            ring
          rw [h]; exact hu0.neg
    obtain ⟨ρi, hρi⟩ := hρu.exists_right_inv
    obtain ⟨ui, hui⟩ := hu.exists_right_inv
    refine ⟨-(c 1 1) * ρi, -ρ, -ui, ?_, ?_, ?_⟩
    · linear_combination (c 1 1) * hρi
    · linear_combination (-ρi) * hr + (ρ + (c 0 1 + c 1 0)) * hρi
    · linear_combination hui - ui * ρi * hr + ui * (ρ + (c 0 1 + c 1 0)) * hρi
  obtain ⟨Θ, hΘ0, hΘ1⟩ : ∃ Θ : wcQuadModelRing A 2 π
        (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) ≃ₐ[A]
        wcQuadModelRing A 2 π c,
      Θ (Ideal.Quotient.mk (wcQuadModelIdeal A 2 π
          (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X 0)) =
        Ideal.Quotient.mk (wcQuadModelIdeal A 2 π c)
          (MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1) ∧
      Θ (Ideal.Quotient.mk (wcQuadModelIdeal A 2 π
          (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.X 1)) =
        Ideal.Quotient.mk (wcQuadModelIdeal A 2 π c)
          (MvPolynomial.C (c 0 0) * MvPolynomial.X 0 + MvPolynomial.C e * MvPolynomial.X 1) := by
    classical
    let F : MvPolynomial (Fin 2) A →ₐ[A] MvPolynomial (Fin 2) A :=
      MvPolynomial.aeval ![MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1,
        MvPolynomial.C (c 0 0) * MvPolynomial.X 0 + MvPolynomial.C e * MvPolynomial.X 1]
    let G : MvPolynomial (Fin 2) A →ₐ[A] MvPolynomial (Fin 2) A :=
      MvPolynomial.aeval ![MvPolynomial.C δi *
          (MvPolynomial.C e * MvPolynomial.X 0 - MvPolynomial.C b * MvPolynomial.X 1),
        MvPolynomial.C δi * (-(MvPolynomial.C (c 0 0)) * MvPolynomial.X 0 + MvPolynomial.X 1)]
    have hF0 : F (MvPolynomial.X 0) = MvPolynomial.X 0 + MvPolynomial.C b * MvPolynomial.X 1 := by
      simp [F]
    have hF1 : F (MvPolynomial.X 1) =
        MvPolynomial.C (c 0 0) * MvPolynomial.X 0 + MvPolynomial.C e * MvPolynomial.X 1 := by
      simp [F]
    have hFC : ∀ a : A, F (MvPolynomial.C a) = MvPolynomial.C a := fun a => by simp [F]
    have hG0 : G (MvPolynomial.X 0) = MvPolynomial.C δi *
        (MvPolynomial.C e * MvPolynomial.X 0 - MvPolynomial.C b * MvPolynomial.X 1) := by
      simp [G]
    have hG1 : G (MvPolynomial.X 1) =
        MvPolynomial.C δi * (-(MvPolynomial.C (c 0 0)) * MvPolynomial.X 0 + MvPolynomial.X 1) := by
      simp [G]
    have hGC : ∀ a : A, G (MvPolynomial.C a) = MvPolynomial.C a := fun a => by simp [G]
    have hCδ : MvPolynomial.C δi * (MvPolynomial.C e - MvPolynomial.C b * MvPolynomial.C (c 0 0)) =
        (1 : MvPolynomial (Fin 2) A) := by
      rw [← MvPolynomial.C_mul, ← MvPolynomial.C_sub, ← MvPolynomial.C_mul, mul_comm, h3,
        MvPolynomial.C_1]
    have eFG0 : F (G (MvPolynomial.X 0)) = MvPolynomial.X 0 := by
      simp only [hG0, map_mul, map_sub, map_add, map_neg, hFC, hF0, hF1]
      linear_combination (MvPolynomial.X 0) * hCδ
    have eFG1 : F (G (MvPolynomial.X 1)) = MvPolynomial.X 1 := by
      simp only [hG1, map_mul, map_sub, map_add, map_neg, hFC, hF0, hF1]
      linear_combination (MvPolynomial.X 1) * hCδ
    have eGF0 : G (F (MvPolynomial.X 0)) = MvPolynomial.X 0 := by
      simp only [hF0, map_mul, map_sub, map_add, map_neg, hGC, hG0, hG1]
      linear_combination (MvPolynomial.X 0) * hCδ
    have eGF1 : G (F (MvPolynomial.X 1)) = MvPolynomial.X 1 := by
      simp only [hF1, map_mul, map_sub, map_add, map_neg, hGC, hG0, hG1]
      linear_combination (MvPolynomial.X 1) * hCδ
    have hFG : F.comp G = AlgHom.id A _ := by
      apply MvPolynomial.algHom_ext
      intro i
      fin_cases i
      · exact eFG0
      · exact eFG1
    have hGF : G.comp F = AlgHom.id A _ := by
      apply MvPolynomial.algHom_ext
      intro i
      fin_cases i
      · exact eGF0
      · exact eGF1
    let Ψ : MvPolynomial (Fin 2) A ≃ₐ[A] MvPolynomial (Fin 2) A := AlgEquiv.ofAlgHom F G hFG hGF
    have hgen0 : (∑ p : Fin 2, ∑ q : Fin 2, MvPolynomial.C
        ((Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) p q) *
          MvPolynomial.X p * MvPolynomial.X q - MvPolynomial.C π) =
        MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π := by
      simp [Fin.sum_univ_two]
    have hFgen : F (MvPolynomial.X 0 * MvPolynomial.X 1 - MvPolynomial.C π) =
        (∑ p : Fin 2, ∑ q : Fin 2, MvPolynomial.C (c p q) * MvPolynomial.X p * MvPolynomial.X q -
          MvPolynomial.C π) := by
      simp only [Fin.sum_univ_two, map_sub, map_mul, hF0, hF1, hFC]
      have h1' : MvPolynomial.C b * MvPolynomial.C e = (MvPolynomial.C (c 1 1) : MvPolynomial (Fin 2) A) := by
        rw [← MvPolynomial.C_mul, h1]
      have h2' : MvPolynomial.C e + MvPolynomial.C b * MvPolynomial.C (c 0 0) =
          (MvPolynomial.C (c 0 1) + MvPolynomial.C (c 1 0) : MvPolynomial (Fin 2) A) := by
        rw [← MvPolynomial.C_mul, ← MvPolynomial.C_add, h2, MvPolynomial.C_add]
      linear_combination (MvPolynomial.X 0 * MvPolynomial.X 1) * h2' +
        (MvPolynomial.X 1 * MvPolynomial.X 1) * h1'
    have hIJ : wcQuadModelIdeal A 2 π c = Ideal.map (Ψ : MvPolynomial (Fin 2) A →+* MvPolynomial (Fin 2) A)
        (wcQuadModelIdeal A 2 π
          (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) := by
      unfold wcQuadModelIdeal
      rw [Ideal.map_span, Set.image_singleton, hgen0]
      exact congrArg (fun x => Ideal.span {x}) hFgen.symm
    refine ⟨Ideal.quotientEquivAlg _ _ Ψ hIJ, ?_, ?_⟩
    · rw [Ideal.quotientEquivAlg_mk]
      exact congrArg _ hF0
    · rw [Ideal.quotientEquivAlg_mk]
      exact congrArg _ hF1
  let φΘ : CommRingCat.of (wcQuadModelRing A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) ⟶
      CommRingCat.of (wcQuadModelRing A 2 π c) :=
    (RingEquiv.toCommRingCatIso Θ.toRingEquiv).hom
  let g : (⊤ : (Spec (.of B₀)).Opens).toScheme ⟶
      Spec (.of (wcQuadModelRing A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) :=
    (⊤ : (Spec (.of B₀)).Opens).ι ≫ a₀ ≫ Spec.map φΘ
  have hwg : WeaklyEtale g := by
    simp only [g]; infer_instance
  have hcompat : g ≫ wcQuadModelStr A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) =
      (⊤ : (Spec (.of B₀)).Opens).ι ≫ a₀ ≫ wcQuadModelStr A 2 π c := by
    have hφ : CommRingCat.ofHom (algebraMap A (wcQuadModelRing A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))) ≫ φΘ =
        CommRingCat.ofHom (algebraMap A (wcQuadModelRing A 2 π c)) := by
      ext x; simp [φΘ]
    simp only [g, wcQuadModelStr, Category.assoc]
    rw [← Spec.map_comp, hφ]
  let y0 : Spec (.of B₀) := IsLocalRing.closedPoint B₀
  have hy0 : y0 ∈ (⊤ : (Spec (.of B₀)).Opens) := by simp
  let yU : (⊤ : (Spec (.of B₀)).Opens).toScheme := ⟨y0, hy0⟩
  have hgy : g yU = Spec.map φΘ x₀ := by
    have hι : (⊤ : (Spec (.of B₀)).Opens).ι yU = y0 := Scheme.Opens.ι_apply _ yU
    have e1 : g yU = Spec.map φΘ (a₀ ((⊤ : (Spec (.of B₀)).Opens).ι yU)) := by
      simp only [g, Scheme.Hom.comp_apply]
    exact e1.trans (congrArg (Spec.map φΘ) ((congrArg a₀ hι).trans hcp))
  have hmem : ∀ q : wcQuadModelRing A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0), Θ q ∈ PrimeSpectrum.asIdeal x₀ →
      q ∈ PrimeSpectrum.asIdeal (g yU) := by
    intro q hq
    rw [hgy]
    exact hq
  refine ⟨inferInstance, inferInstance, fun x => ⟨⊤, 0, g, by simp, hwg, hcompat⟩,
    ⟨⊤, 0, g, yU, hwg, hcompat, ?_, ?_⟩⟩
  · apply hmem
    show Θ (Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X 0)) ∈ _
    rw [hΘ0, map_add, map_mul]
    exact Ideal.add_mem _ (hx₀ 0) (Ideal.mul_mem_left _ _ (hx₀ 1))
  · apply hmem
    show Θ (Ideal.Quotient.mk (wcQuadModelIdeal A 2 π (Matrix.of fun i j : Fin 2 => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X 1)) ∈ _
    rw [hΘ1, map_add, map_mul, map_mul]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (hx₀ 0)) (Ideal.mul_mem_left _ _ (hx₀ 1))

theorem wc_qmpl_root_field : ∀ (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A) →
    ∀ (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} →
    ∀ (L : Type u) [Field L] [IsSepClosed L] (φA : A →+* L), Function.Injective φA →
    ∀ (σ : L →+* L), σ.comp φA = φA → wcMntTame ℓ φA σ π →
    ∃ (L' : Type u) (_ : Field L') (_ : IsSepClosed L') (ιL : L →+* L') (S' : L')
      (σ' : L' →+* L'),
      (letI := ιL.toAlgebra; Algebra.IsAlgebraic L L') ∧ S' ^ 2 = ιL (φA π) ∧
      σ'.comp ιL = ιL.comp (σ.comp σ) ∧ σ' S' = S' ∧
      ∀ k : ℕ, 1 ≤ k → ∀ y : L', y ^ (ℓ ^ k) = S' → IsPrimitiveRoot (σ' y * y⁻¹) (ℓ ^ k) :=
by
  intro A _ _ _ _ _ ℓ _ hℓ π hπ L _ _ φA hφA σ hσ htame
  classical
  have hp : ℓ.Prime := Fact.out

  have hπ0 : π ≠ 0 := by
    intro h
    apply IsDiscreteValuationRing.not_a_field A
    rw [hπ, h]
    exact Ideal.span_singleton_eq_bot.mpr rfl
  have hc0 : φA π ≠ 0 := fun h => hπ0 (hφA (h.trans (map_zero φA).symm))
  have hσc : σ (φA π) = φA π := RingHom.congr_fun hσ π
  have hℓL : ∀ j : ℕ, ((ℓ ^ j : ℕ) : L) ≠ 0 := by
    intro j
    have h1 := (hℓ.pow j).map φA
    rw [map_pow, map_natCast] at h1
    rw [Nat.cast_pow]
    exact h1.ne_zero

  have hfixRoots : ∀ (j : ℕ) (ω : L), ω ^ (ℓ ^ j) = 1 → σ ω = ω := by
    intro j ω hω
    have hNpos : 0 < ℓ ^ j := pow_pos hp.pos j
    have hNk : ((ℓ ^ j : ℕ) : IsLocalRing.ResidueField A) ≠ 0 := by
      have h1 : IsUnit ((ℓ ^ j : ℕ) : A) := by rw [Nat.cast_pow]; exact hℓ.pow j
      have h2 := h1.map (IsLocalRing.residue A)
      rw [map_natCast] at h2
      exact h2.ne_zero
    haveI : NeZero ((ℓ ^ j : ℕ) : IsLocalRing.ResidueField A) := ⟨hNk⟩
    haveI : NeZero (ℓ ^ j) := ⟨hNpos.ne'⟩
    obtain ⟨ζb, hζb⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot
      (IsLocalRing.ResidueField A) (ℓ ^ j)
    obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective ζb
    have hmono : (Polynomial.X ^ (ℓ ^ j) - Polynomial.C (1 : A)).Monic :=
      Polynomial.monic_X_pow_sub_C _ hNpos.ne'
    obtain ⟨a, ha, haa₀⟩ := HenselianLocalRing.is_henselian _ hmono a₀ (by
      rw [← IsLocalRing.residue_eq_zero_iff]
      simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C,
        Polynomial.eval_one, map_sub, map_pow, map_one, ha₀, hζb.pow_eq_one, sub_self]) (by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
      simp only [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
        sub_zero, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_natCast, map_mul, map_pow, map_natCast, ha₀]
      exact mul_ne_zero hNk (pow_ne_zero _ (hζb.ne_zero hNpos.ne')))
    have haN : a ^ (ℓ ^ j) = 1 := by
      have := ha
      simp only [Polynomial.IsRoot, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
        Polynomial.eval_C, Polynomial.eval_one, sub_eq_zero] at this
      exact this
    have hres : IsLocalRing.residue A a = ζb := by
      rw [← ha₀, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
      exact haa₀
    have hprim : IsPrimitiveRoot a (ℓ ^ j) :=
      ⟨haN, fun l hl => hζb.dvd_of_pow_eq_one l (by rw [← hres, ← map_pow, hl, map_one])⟩
    have hη := hprim.map_of_injective hφA
    obtain ⟨i, -, hi⟩ := hη.eq_pow_of_pow_eq_one hω
    rw [← hi, map_pow]
    congr 1
    exact RingHom.congr_fun hσ a

  have key : ∀ (L' : Type u) [Field L'] [IsAlgClosed L'] (ι : L →+* L') (σ' : L' →+* L'),
      (∀ x, σ' (ι x) = ι (σ (σ x))) → ∃ S' : L', S' ^ 2 = ι (φA π) ∧ σ' S' = S' ∧
      ∀ k : ℕ, 1 ≤ k → ∀ y : L', y ^ (ℓ ^ k) = S' → IsPrimitiveRoot (σ' y * y⁻¹) (ℓ ^ k) := by
    intro L' _ _ ι σ' hσ'ι
    have hιc : ι (φA π) ≠ 0 := (map_ne_zero ι).mpr hc0
    have hpull : ∀ (j : ℕ) (w : L'), w ^ (ℓ ^ j) = ι (φA π) →
        ∃ w₁ : L, ι w₁ = w ∧ w₁ ^ (ℓ ^ j) = φA π := by
      intro j w hw
      haveI : NeZero ((ℓ ^ j : ℕ) : L) := ⟨hℓL j⟩
      have hN0 : ℓ ^ j ≠ 0 := pow_ne_zero _ hp.ne_zero
      haveI : NeZero (ℓ ^ j) := ⟨hN0⟩
      obtain ⟨w₀, hw₀⟩ := IsSepClosed.exists_pow_nat_eq (φA π) (ℓ ^ j)
      have hw₀0 : w₀ ≠ 0 := by
        rintro rfl
        rw [zero_pow hN0] at hw₀
        exact hc0 hw₀.symm
      have hιw₀ : ι w₀ ≠ 0 := (map_ne_zero ι).mpr hw₀0
      obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot L (ℓ ^ j)
      have hιζ := hζ.map_of_injective ι.injective
      have hu : (w * (ι w₀)⁻¹) ^ (ℓ ^ j) = 1 := by
        rw [mul_pow, inv_pow, ← map_pow, hw₀, hw, mul_inv_cancel₀ hιc]
      obtain ⟨i, -, hi⟩ := hιζ.eq_pow_of_pow_eq_one hu
      refine ⟨w₀ * ζ ^ i, ?_, ?_⟩
      · rw [map_mul, map_pow, hi, mul_comm w, ← mul_assoc, mul_inv_cancel₀ hιw₀, one_mul]
      · rw [mul_pow, ← pow_mul, mul_comm i, pow_mul, hζ.pow_eq_one, one_pow, mul_one, hw₀]

    obtain ⟨S', hS2, hσS⟩ : ∃ S' : L', S' ^ 2 = ι (φA π) ∧ σ' S' = S' := by
      by_cases h2 : (2 : L) = 0
      · obtain ⟨S', hS'⟩ := IsAlgClosed.exists_pow_nat_eq (ι (φA π)) (by norm_num : 0 < 2)
        refine ⟨S', hS', ?_⟩
        have h2' : (2 : L') = 0 := by rw [← map_ofNat ι 2, h2, map_zero]
        have ha2 : (σ' S') ^ 2 = ι (φA π) := by rw [← map_pow, hS', hσ'ι, hσc, hσc]
        have hsq : (σ' S' - S') ^ 2 = 0 := by
          linear_combination ha2 + hS' + (ι (φA π) - σ' S' * S') * h2'
        exact sub_eq_zero.mp (pow_eq_zero_iff two_ne_zero |>.mp hsq)
      · haveI : NeZero ((2 : ℕ) : L) := ⟨by exact_mod_cast h2⟩
        obtain ⟨s, hs⟩ := IsSepClosed.exists_pow_nat_eq (φA π) 2
        refine ⟨ι s, by rw [← map_pow, hs], ?_⟩
        have hss : σ s ^ 2 = s ^ 2 := by rw [← map_pow, hs, hσc]
        have hσσ : σ (σ s) = s := by
          rcases sq_eq_sq_iff_eq_or_eq_neg.mp hss with h | h
          · rw [h, h]
          · rw [h, map_neg, h, neg_neg]
        rw [hσ'ι, hσσ]
    refine ⟨S', hS2, hσS, ?_⟩

    intro k hk y hy
    have hS0 : S' ≠ 0 := by
      rintro rfl
      rw [zero_pow two_ne_zero] at hS2
      exact hιc hS2.symm
    have hN0 : ℓ ^ k ≠ 0 := pow_ne_zero _ hp.ne_zero
    have hy0 : y ≠ 0 := by
      rintro rfl
      rw [zero_pow hN0] at hy
      exact hS0 hy.symm
    have hrN : (σ' y * y⁻¹) ^ (ℓ ^ k) = 1 := by
      rw [mul_pow, inv_pow, ← map_pow, hy, hσS, mul_inv_cancel₀ hS0]
    have F2 : ∀ x₁ : L, x₁ ≠ 0 → σ (σ x₁ * x₁⁻¹) = σ x₁ * x₁⁻¹ →
        σ' (ι x₁) * (ι x₁)⁻¹ = ι ((σ x₁ * x₁⁻¹) ^ 2) := by
      intro x₁ hx hfix
      have hιx : ι x₁ ≠ 0 := (map_ne_zero ι).mpr hx
      have e2 : σ (σ x₁) = (σ x₁ * x₁⁻¹) ^ 2 * x₁ := by
        have e1 : σ x₁ = (σ x₁ * x₁⁻¹) * x₁ := (inv_mul_cancel_right₀ hx _).symm
        calc σ (σ x₁) = σ ((σ x₁ * x₁⁻¹) * x₁) := by rw [← e1]
          _ = σ (σ x₁ * x₁⁻¹) * σ x₁ := by rw [map_mul]
          _ = (σ x₁ * x₁⁻¹) * ((σ x₁ * x₁⁻¹) * x₁) := by rw [hfix, ← e1]
          _ = (σ x₁ * x₁⁻¹) ^ 2 * x₁ := by ring
      rw [hσ'ι, e2, map_mul, mul_inv_cancel_right₀ hιx]
    rcases hp.eq_two_or_odd' with h2 | hodd
    · subst h2
      have hy' : y ^ (2 ^ (k + 1)) = ι (φA π) := by
        rw [pow_succ (2 : ℕ) k, pow_mul, hy, hS2]
      obtain ⟨y₁, hy₁, hy₁c⟩ := hpull (k + 1) y hy'
      have hy₁0 : y₁ ≠ 0 := by
        rintro rfl
        rw [zero_pow (pow_ne_zero _ two_ne_zero)] at hy₁c
        exact hc0 hy₁c.symm
      have hζ := htame (k + 1) (by omega) y₁ hy₁c
      have hfix := hfixRoots (k + 1) _ hζ.pow_eq_one
      rw [← hy₁, F2 y₁ hy₁0 hfix]
      exact (hζ.pow (pow_pos two_pos _) (pow_succ' 2 k)).map_of_injective ι.injective
    · have hz : (y ^ 2) ^ (ℓ ^ k) = ι (φA π) := by
        rw [pow_right_comm, hy, hS2]
      obtain ⟨z₁, hz₁, hz₁c⟩ := hpull k (y ^ 2) hz
      have hz₁0 : z₁ ≠ 0 := by
        rintro rfl
        rw [zero_pow hN0] at hz₁c
        exact hc0 hz₁c.symm
      have hζ := htame k hk z₁ hz₁c
      have hfix := hfixRoots k _ hζ.pow_eq_one
      have hr2 : (σ' y * y⁻¹) ^ 2 = ι ((σ z₁ * z₁⁻¹) ^ 2) := by
        rw [mul_pow, inv_pow, ← map_pow, ← hz₁, F2 z₁ hz₁0 hfix]
      have hcop : Nat.Coprime 2 (ℓ ^ k) := (Nat.coprime_two_left.mpr hodd).pow_right k
      have hprim2 := (hζ.pow_of_coprime 2 hcop).map_of_injective ι.injective
      refine ⟨hrN, fun d hd => hprim2.dvd_of_pow_eq_one d ?_⟩
      rw [← hr2, pow_right_comm, hd, one_pow]

  let g : L →+* AlgebraicClosure L := (algebraMap L (AlgebraicClosure L)).comp (σ.comp σ)
  let τ := @IsAlgClosed.lift (AlgebraicClosure L) _ _ L _ _ (AlgebraicClosure L) _ _ _
    g.toAlgebra _ (letI := g.toAlgebra; inferInstance) _
  obtain ⟨σ', hσ'ι⟩ : ∃ σ' : AlgebraicClosure L →+* AlgebraicClosure L,
      ∀ x, σ' (algebraMap L (AlgebraicClosure L) x) =
        algebraMap L (AlgebraicClosure L) (σ (σ x)) :=
    ⟨@AlgHom.toRingHom _ _ _ _ _ _ _ g.toAlgebra τ,
      fun x => @AlgHom.commutes _ _ _ _ _ _ _ g.toAlgebra τ x⟩
  obtain ⟨S', hS2, hσS, hprim⟩ := key (AlgebraicClosure L) (algebraMap L (AlgebraicClosure L))
    σ' hσ'ι
  refine ⟨AlgebraicClosure L, inferInstance, inferInstance, algebraMap L (AlgebraicClosure L),
    S', σ', ?_, hS2, ?_, hσS, hprim⟩
  · show @Algebra.IsAlgebraic L (AlgebraicClosure L) _ _
      (algebraMap L (AlgebraicClosure L)).toAlgebra
    rw [Algebra.algebra_ext (algebraMap L (AlgebraicClosure L)).toAlgebra
      (AlgebraicClosure.instAlgebra L) (fun _ => rfl)]
    infer_instance
  · exact RingHom.ext hσ'ι

theorem wc_qmpl_T_square {S S' Z : Scheme.{u}} {f : S' ⟶ S} {w : S' ⟶ S'} {g : Z ⟶ S} {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)]
    (hcomp : w ≫ f = f) (hcomp₂ : (w ≫ w) ≫ f = f)
    (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
    (Dw : wcHMPullData w ℓ) (hDw : wcHMPullCanonical Dw) (Dg : wcHMPullData g ℓ)
    (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf S' ℓ))) :
    haveI := Df.cont
    haveI := Dw.cont
    haveI : (wcProEtBC f ⋙ wcProEtBC w).IsContinuous
        (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') :=
      Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S') _
    let α : wcProEtBC f ⟶ wcProEtBC f ⋙ wcProEtBC w :=
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong f))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
        ⟨fun _ _ => inferInstance⟩
      letI : MorphismProperty.IsStableUnderBaseChangeAlong
          (@WeaklyEtale : MorphismProperty Scheme.{u}) w :=
        (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
          (inferInstance : Pr.IsStableUnderBaseChangeAlong w))
          (@WeaklyEtale : MorphismProperty Scheme.{u})
      (MorphismProperty.Over.pullbackComp (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
        (Q := ⊤) _ _ _ hcomp.symm).hom
    haveI := Df.additive
    haveI := Dw.additive
    haveI := Dg.additive
    ∀ (hφ : (Df.φ ≫ ((wcProEtBC f).sheafPushforwardContinuous RingCat.{u+1}
          (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).map Dw.φ) ≫
        (Functor.sheafPushforwardContinuousNatTrans α RingCat.{u+1}
          (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).app
          (wcRingSheaf S' ℓ) = Df.φ)
      (t : (Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶
        I.cochainComplex),
      (Dw.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t =
        (HomologicalComplex.singleMapHomologicalComplex Dw.Φ (ComplexShape.up ℤ) 0).hom.app
          (SheafOfModules.unit (wcRingSheaf S' ℓ)) ≫
        (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
          ((Dw.adj.homEquiv _ _).symm
            (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
              (wcProEtBC w) _ _ Dw.cont Dw.φ)) ≫
        I.ι' →
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC f) _ _ Df.cont Df.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Df.adj
    let Pw := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC w) _ _ Dw.cont Dw.φ
    haveI : Pw.Additive := Adjunction.right_adjoint_additive Dw.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    let γ : Pw ⋙ P ⟶ P := (SheafOfModules.pushforwardComp Df.φ Dw.φ).hom ≫
        SheafOfModules.pushforwardNatTrans _ α ≫ (SheafOfModules.pushforwardCongr hφ).hom
    let Tflat := (Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app
          I.cochainComplex ≫
        (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ Dw.Φ ⋙ Pw from Dw.adj.unit)
          (ComplexShape.up ℤ)).app I.cochainComplex ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Dw.Φ ⋙ Pw))
          (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
        (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map t
    let T : K ⟶ K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).map Tflat ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
          (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
        (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I.cochainComplex
    let TΨ := (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map T
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Z ℓ))
    ∃ (D₂ : wcHMPullData (w ≫ w) ℓ) (_ : wcHMPullCanonical D₂),
      haveI := D₂.cont
      haveI : (wcProEtBC f ⋙ wcProEtBC (w ≫ w)).IsContinuous
          (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') :=
        Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S') _
      let α₂ : wcProEtBC f ⟶ wcProEtBC f ⋙ wcProEtBC (w ≫ w) :=
        letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
          ⟨fun _ _ => inferInstance⟩
        letI : MorphismProperty.IsStableUnderBaseChangeAlong
            (@WeaklyEtale : MorphismProperty Scheme.{u}) f :=
          (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
            (inferInstance : Pr.IsStableUnderBaseChangeAlong f))
            (@WeaklyEtale : MorphismProperty Scheme.{u})
        letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u})
            (w ≫ w) :=
          ⟨fun _ _ => inferInstance⟩
        letI : MorphismProperty.IsStableUnderBaseChangeAlong
            (@WeaklyEtale : MorphismProperty Scheme.{u}) (w ≫ w) :=
          (fun (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange] =>
            (inferInstance : Pr.IsStableUnderBaseChangeAlong (w ≫ w)))
            (@WeaklyEtale : MorphismProperty Scheme.{u})
        (MorphismProperty.Over.pullbackComp (P := (@WeaklyEtale : MorphismProperty Scheme.{u}))
          (Q := ⊤) _ _ _ hcomp₂.symm).hom
      haveI := D₂.additive
      ∃ (hφ₂ : (Df.φ ≫ ((wcProEtBC f).sheafPushforwardContinuous RingCat.{u+1}
            (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).map D₂.φ) ≫
          (Functor.sheafPushforwardContinuousNatTrans α₂ RingCat.{u+1}
            (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).app
            (wcRingSheaf S' ℓ) = Df.φ)
        (t₂ : (D₂.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶
          I.cochainComplex),
        (D₂.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t₂ =
          (HomologicalComplex.singleMapHomologicalComplex D₂.Φ (ComplexShape.up ℤ) 0).hom.app
            (SheafOfModules.unit (wcRingSheaf S' ℓ)) ≫
          (HomologicalComplex.single _ (ComplexShape.up ℤ) 0).map
            ((D₂.adj.homEquiv _ _).symm
              (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
                (wcProEtBC (w ≫ w)) _ _ D₂.cont D₂.φ)) ≫
          I.ι' ∧
        let Pw₂ := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
          (wcProEtBC (w ≫ w)) _ _ D₂.cont D₂.φ
        haveI : Pw₂.Additive := Adjunction.right_adjoint_additive D₂.adj
        let γ₂ : Pw₂ ⋙ P ⟶ P := (SheafOfModules.pushforwardComp Df.φ D₂.φ).hom ≫
            SheafOfModules.pushforwardNatTrans _ α₂ ≫ (SheafOfModules.pushforwardCongr hφ₂).hom
        let Tflat₂ := (Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app
              I.cochainComplex ≫
            (NatTrans.mapHomologicalComplex (show 𝟭 _ ⟶ D₂.Φ ⋙ Pw₂ from D₂.adj.unit)
              (ComplexShape.up ℤ)).app I.cochainComplex ≫
            (Functor.mapHomologicalComplexCompIso (Iso.refl (D₂.Φ ⋙ Pw₂))
              (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
            (Pw₂.mapHomologicalComplex (ComplexShape.up ℤ)).map t₂
        let T₂ : K ⟶ K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).map Tflat₂ ≫
            (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw₂ ⋙ P))
              (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
            (NatTrans.mapHomologicalComplex γ₂ (ComplexShape.up ℤ)).app I.cochainComplex
        let TΨ₂ := (Dg.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map T₂
        DerivedCategory.Q.map TΨ₂ = DerivedCategory.Q.map TΨ ≫ DerivedCategory.Q.map TΨ :=
by

  have pure_SI : ∀ {V X Y : Scheme.{u}} (v : V ⟶ Y) (f₀ : X ⟶ Y) (w₀ : X ⟶ X)
      (A : Limits.pullback v f₀ ⟶ Limits.pullback (Limits.pullback.snd v f₀) w₀)
      (A₂ : Limits.pullback v f₀ ⟶ Limits.pullback (Limits.pullback.snd v f₀) (w₀ ≫ w₀))
      (B : Limits.pullback (Limits.pullback.snd v f₀) (w₀ ≫ w₀) ⟶
        Limits.pullback (Limits.pullback.snd (Limits.pullback.snd v f₀) w₀) w₀),
      A ≫ Limits.pullback.fst (Limits.pullback.snd v f₀) w₀ ≫ Limits.pullback.fst v f₀ =
        Limits.pullback.fst v f₀ →
      A ≫ Limits.pullback.fst (Limits.pullback.snd v f₀) w₀ ≫ Limits.pullback.snd v f₀ =
        Limits.pullback.snd v f₀ ≫ w₀ →
      A ≫ Limits.pullback.snd (Limits.pullback.snd v f₀) w₀ = Limits.pullback.snd v f₀ →
      A₂ ≫ Limits.pullback.fst (Limits.pullback.snd v f₀) (w₀ ≫ w₀) ≫ Limits.pullback.fst v f₀ =
        Limits.pullback.fst v f₀ →
      A₂ ≫ Limits.pullback.fst (Limits.pullback.snd v f₀) (w₀ ≫ w₀) ≫ Limits.pullback.snd v f₀ =
        Limits.pullback.snd v f₀ ≫ w₀ ≫ w₀ →
      A₂ ≫ Limits.pullback.snd (Limits.pullback.snd v f₀) (w₀ ≫ w₀) = Limits.pullback.snd v f₀ →
      B ≫ Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd v f₀) w₀) w₀ ≫
        Limits.pullback.fst (Limits.pullback.snd v f₀) w₀ =
          Limits.pullback.fst (Limits.pullback.snd v f₀) (w₀ ≫ w₀) →
      B ≫ Limits.pullback.fst (Limits.pullback.snd (Limits.pullback.snd v f₀) w₀) w₀ ≫
        Limits.pullback.snd (Limits.pullback.snd v f₀) w₀ =
          Limits.pullback.snd (Limits.pullback.snd v f₀) (w₀ ≫ w₀) ≫ w₀ →
      B ≫ Limits.pullback.snd (Limits.pullback.snd (Limits.pullback.snd v f₀) w₀) w₀ =
        Limits.pullback.snd (Limits.pullback.snd v f₀) (w₀ ≫ w₀) →
      ∀ (hA : (Limits.pullback.fst (Limits.pullback.snd v f₀) w₀ ≫ A) ≫
          Limits.pullback.snd (Limits.pullback.snd v f₀) w₀ =
            Limits.pullback.snd (Limits.pullback.snd v f₀) w₀ ≫ w₀),
      A ≫ Limits.pullback.lift (Limits.pullback.fst (Limits.pullback.snd v f₀) w₀ ≫ A)
        (Limits.pullback.snd (Limits.pullback.snd v f₀) w₀) hA = A₂ ≫ B := by
    intro V X Y v f₀ w₀ A A₂ B a1 a2 a3 b1 b2 b3 c1 c2 c3 hA
    apply Limits.pullback.hom_ext
    · apply Limits.pullback.hom_ext
      · apply Limits.pullback.hom_ext
        · simp only [Category.assoc, Limits.pullback.lift_fst_assoc]
          rw [a1, a1, reassoc_of% c1, b1]
        · simp only [Category.assoc, Limits.pullback.lift_fst_assoc]
          rw [a2, reassoc_of% a2, reassoc_of% c1, b2]
      · simp only [Category.assoc, Limits.pullback.lift_fst_assoc]
        rw [a3, a2, c2, reassoc_of% b3]
    · simp only [Category.assoc, Limits.pullback.lift_snd]
      rw [a3, c3, b3]

  have gen_SI : ∀ (Pr : MorphismProperty Scheme.{u}) [Pr.IsStableUnderBaseChange]
      [∀ {A B : Scheme.{u}} (g₀ : A ⟶ B), Pr.HasPullbacksAlong g₀]
      {X Y : Scheme.{u}} (f₀ : X ⟶ Y) (w₀ : X ⟶ X)
      (hc : w₀ ≫ f₀ = f₀) (hc₂ : (w₀ ≫ w₀) ≫ f₀ = f₀) (V : Pr.Over ⊤ Y),
      (MorphismProperty.Over.pullbackComp (P := Pr) (Q := ⊤) w₀ f₀ f₀ hc.symm).hom.app V ≫
          (MorphismProperty.Over.pullback Pr ⊤ w₀).map
            ((MorphismProperty.Over.pullbackComp (P := Pr) (Q := ⊤) w₀ f₀ f₀ hc.symm).hom.app V) =
        (MorphismProperty.Over.pullbackComp (P := Pr) (Q := ⊤) (w₀ ≫ w₀) f₀ f₀ hc₂.symm).hom.app V ≫
          (MorphismProperty.Over.pullbackComp (P := Pr) (Q := ⊤) w₀ w₀ (w₀ ≫ w₀) rfl).hom.app
            ((MorphismProperty.Over.pullback Pr ⊤ f₀).obj V) := by
    intro Pr _ _ X Y f₀ w₀ hc hc₂ V
    have key : ∀ {A B C : Scheme.{u}} (g₁ : A ⟶ B) (g₂ : B ⟶ C) (g₁₂ : A ⟶ C)
        (h : g₁₂ = g₁ ≫ g₂) (W : Pr.Over ⊤ C),
        ((MorphismProperty.Over.pullbackComp (P := Pr) (Q := ⊤) g₁ g₂ g₁₂ h).hom.app W).left ≫
            Limits.pullback.fst ((MorphismProperty.Over.pullback Pr ⊤ g₂).obj W).hom g₁ ≫
              Limits.pullback.fst W.hom g₂ = Limits.pullback.fst W.hom g₁₂ ∧
        ((MorphismProperty.Over.pullbackComp (P := Pr) (Q := ⊤) g₁ g₂ g₁₂ h).hom.app W).left ≫
            Limits.pullback.fst ((MorphismProperty.Over.pullback Pr ⊤ g₂).obj W).hom g₁ ≫
              Limits.pullback.snd W.hom g₂ = Limits.pullback.snd W.hom g₁₂ ≫ g₁ ∧
        ((MorphismProperty.Over.pullbackComp (P := Pr) (Q := ⊤) g₁ g₂ g₁₂ h).hom.app W).left ≫
            Limits.pullback.snd ((MorphismProperty.Over.pullback Pr ⊤ g₂).obj W).hom g₁ =
