      simp only [ι₀, AddMonoidAlgebra.mapDomainRingHom_apply,
        AddMonoidAlgebra.mapDomain_single, hγR]
      rw [show ((algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom m) =
        algebraMap ℤ (Localization.Away (ℓ : ℤ)) m from rfl, hχm, one_mul]
  have hI2 : ι₀.comp σLP = σG.comp ι₀ := by
    apply AddMonoidAlgebra.ringHom_ext
    · intro c
      simp only [RingHom.comp_apply, ι₀, AddMonoidAlgebra.mapDomainRingHom_apply, hσLP,
        AddMonoidAlgebra.mapDomain_single, hσG]
    · intro m
      simp only [RingHom.comp_apply, ι₀, AddMonoidAlgebra.mapDomainRingHom_apply, hσLP,
        AddMonoidAlgebra.mapDomain_single, hσG]

  have hT : IsPullback (Limits.pullback.fst g₀ (Spec.map (CommRingCat.ofHom ι₀)))
      (Limits.pullback.snd g₀ (Spec.map (CommRingCat.ofHom ι₀))) g₀
      (Spec.map (CommRingCat.ofHom ι₀)) := IsPullback.of_hasPullback _ _
  have hγ : Limits.pullback.fst g₀ (Spec.map (CommRingCat.ofHom ι₀)) ≫ g₀ =
      (Limits.pullback.snd g₀ (Spec.map (CommRingCat.ofHom ι₀)) ≫
        Spec.map (CommRingCat.ofHom γR)) ≫ Spec.map (CommRingCat.ofHom ι₀) := by
    rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hI1]
    exact Limits.pullback.condition
  have hw : (Limits.pullback.fst g₀ (Spec.map (CommRingCat.ofHom ι₀)) ≫ w) ≫ g₀ =
      (Limits.pullback.snd g₀ (Spec.map (CommRingCat.ofHom ι₀)) ≫
        Spec.map (CommRingCat.ofHom σG)) ≫ Spec.map (CommRingCat.ofHom ι₀) := by
    rw [Category.assoc, hs9, ← Category.assoc, Limits.pullback.condition, Category.assoc,
      Category.assoc, ← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
      ← CommRingCat.ofHom_comp, hI2]
  have hζA : ∀ k, ∃ a : A, φA a = ζ k := fun k => ⟨ζA k, rfl⟩
  exact ⟨⟨ζ, hζ, hζc, hζA, χ, hχ, γR, hγR, σG, hσG, g₀, hg₀q, hg₀T,
    Limits.pullback g₀ (Spec.map (CommRingCat.ofHom ι₀)),
    Limits.pullback.fst g₀ (Spec.map (CommRingCat.ofHom ι₀)),
    Limits.pullback.snd g₀ (Spec.map (CommRingCat.ofHom ι₀)), hT,
    hT.lift _ _ hγ, hT.lift _ _ hw,
    hT.lift_fst _ _ hγ, hT.lift_snd _ _ hγ,
    hT.lift_fst _ _ hw, hT.lift_snd _ _ hw⟩⟩

theorem wc_qmtm_action_maps_of_unit_eq {A B L : Type u} [CommRing A] [CommRing B] [Field L] {ℓ : ℕ}
    [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (hσ : σ.comp φA = φA)
    (Dπ : wcHMPullData T.πi ℓ) (hDπ : wcHMPullCanonical Dπ)
    (hu : wcSuppUnitMap Dπ = wcQmtmUnit Dπ)
    (Dτ : wcHMPullData w ℓ) (hDτ : wcHMPullCanonical Dτ) :
    ∃ (γN : wcSuppObj Dπ ⟶ wcSuppObj Dπ) (aN : wcSuppObj Dπ ⟶ (wcQmtmPush Dτ).obj (wcSuppObj Dπ)),
      wcQmtmGammaSec T Dπ γN ∧ wcQmtmActSec T Dπ Dτ aN ∧
      wcSuppUnitMap Dπ ≫ γN = wcSuppUnitMap Dπ ∧
      wcSuppUnitMap Dπ ≫ aN = wcQmtmUnit Dτ ≫ (wcQmtmPush Dτ).map (wcSuppUnitMap Dπ) ∧
      γN ≫ aN = aN ≫ (wcQmtmPush Dτ).map γN :=
by
  classical
  haveI := Dπ.cont
  haveI := Dτ.cont

  have hζ : ∀ k, σ (T.ζ k) = T.ζ k := by
    intro k
    obtain ⟨a, ha⟩ := T.hζA k
    rw [← ha, ← RingHom.comp_apply, hσ]
  have hχσ : ∀ x : Localization.Away (ℓ : ℤ),
      σ ((T.χ (Multiplicative.ofAdd x) : Lˣ) : L) = ((T.χ (Multiplicative.ofAdd x) : Lˣ) : L) := by
    intro x
    refine Localization.induction_on x ?_
    rintro ⟨a, ⟨b, hb⟩⟩
    obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hb
    show σ ((T.χ (Multiplicative.ofAdd
      (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))) : Lˣ) : L) = _
    rw [T.hχ, map_zpow₀, hζ]
  have hσγ : T.σG.comp T.γR = T.γR.comp T.σG := by
    apply AddMonoidAlgebra.ringHom_ext
    · intro r
      simp only [RingHom.comp_apply, T.hγR, T.hσG, map_mul, hχσ]
    · intro m
      simp only [RingHom.comp_apply, T.hγR, T.hσG, map_mul, hχσ]
  have hcomm : T.γi ≫ T.wi = T.wi ≫ T.γi := by
    apply T.hT.hom_ext
    · rw [Category.assoc, Category.assoc, T.hγπ, T.hwπ, ← Category.assoc, T.hγπ]
    · rw [Category.assoc, Category.assoc, T.hwg, T.hγg, ← Category.assoc, ← Category.assoc,
        T.hγg, T.hwg, Category.assoc, Category.assoc, ← Spec.map_comp, ← Spec.map_comp,
        ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp, hσγ]

  have hcompb : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (r : C(↥Z, ULift.{u+1} ℚ_[ℓ])),
      (r.comp g.base.hom).comp f.base.hom = r.comp (f ≫ g).base.hom := by
    intro X Y Z f g r; rw [Scheme.Hom.comp_base]; rfl
  have hpre : ∀ {P Q Q' R : Scheme.{u}} (a : P ⟶ Q) (b : Q ⟶ R) (c : P ⟶ Q') (d : Q' ⟶ R)
      (s : C(↥R, ULift.{u+1} ℚ_[ℓ])), a ≫ b = c ≫ d →
      (s.comp b.base.hom).comp a.base.hom = (s.comp d.base.hom).comp c.base.hom := by
    intro P Q Q' R a b c d s h
    rw [hcompb, hcompb, h]
  have hρ : ∀ {S S' : Scheme.{u}} (f : S' ⟶ S) {V₁ V₂ : S.ProEt} (g : V₁ ⟶ V₂),
      ((wcProEtBC f).map g).left ≫ Limits.pullback.fst V₂.hom f =
        Limits.pullback.fst V₁.hom f ≫ g.left ∧
      ((wcProEtBC f).map g).left ≫ Limits.pullback.snd V₂.hom f = Limits.pullback.snd V₁.hom f :=
    by intro S S' f V₁ V₂ g; exact ⟨Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have ext_sec : ∀ {M N : SheafOfModules.{u+1} (wcRingSheaf XE ℓ)} {f g : M ⟶ N},
      (∀ (V : XE.ProEt) (m : M.val.obj (Opposite.op V)),
        (f.val.app (Opposite.op V)).hom m = (g.val.app (Opposite.op V)).hom m) → f = g := by
    intro M N f g h
    apply SheafOfModules.hom_ext; apply PresheafOfModules.hom_ext; intro X
    apply ModuleCat.hom_ext; apply LinearMap.ext; intro m; exact h X.unop m

  have hκγex : ∀ V : XE.ProEt, ∃ κ : Limits.pullback V.hom T.πi ⟶ Limits.pullback V.hom T.πi,
      κ ≫ Limits.pullback.fst V.hom T.πi = Limits.pullback.fst V.hom T.πi ∧
      κ ≫ Limits.pullback.snd V.hom T.πi = Limits.pullback.snd V.hom T.πi ≫ T.γi := fun V =>
    ⟨Limits.pullback.lift (Limits.pullback.fst V.hom T.πi) (Limits.pullback.snd V.hom T.πi ≫ T.γi)
      (by rw [Category.assoc, T.hγπ, Limits.pullback.condition]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  choose κγ hκγ1 hκγ2 using hκγex
  have hκaex : ∀ V : XE.ProEt,
      ∃ κ : Limits.pullback (Limits.pullback.snd V.hom w) T.πi ⟶ Limits.pullback V.hom T.πi,
      κ ≫ Limits.pullback.fst V.hom T.πi =
        Limits.pullback.fst (Limits.pullback.snd V.hom w) T.πi ≫ Limits.pullback.fst V.hom w ∧
      κ ≫ Limits.pullback.snd V.hom T.πi =
        Limits.pullback.snd (Limits.pullback.snd V.hom w) T.πi ≫ T.wi := fun V =>
    ⟨Limits.pullback.lift
      (Limits.pullback.fst (Limits.pullback.snd V.hom w) T.πi ≫ Limits.pullback.fst V.hom w)
      (Limits.pullback.snd (Limits.pullback.snd V.hom w) T.πi ≫ T.wi)
      (by
        rw [Category.assoc, Category.assoc, T.hwπ, Limits.pullback.condition,
          ← Category.assoc, Limits.pullback.condition, Category.assoc]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  choose κa hκa1 hκa2 using hκaex

  have hnatγ' : ∀ {V₁ V₂ : XE.ProEt} (gl : V₁.left ⟶ V₂.left)
      (ρ : Limits.pullback V₁.hom T.πi ⟶ Limits.pullback V₂.hom T.πi),
      ρ ≫ Limits.pullback.fst V₂.hom T.πi = Limits.pullback.fst V₁.hom T.πi ≫ gl →
      ρ ≫ Limits.pullback.snd V₂.hom T.πi = Limits.pullback.snd V₁.hom T.πi →
      κγ V₁ ≫ ρ = ρ ≫ κγ V₂ := by
    intro V₁ V₂ gl ρ h1 h2
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, h1, hκγ1, ← Category.assoc, hκγ1, h1]
    · rw [Category.assoc, Category.assoc, h2, hκγ2, hκγ2, ← Category.assoc, h2]
  have hnatγ : ∀ {V₁ V₂ : XE.ProEt} (g : V₁ ⟶ V₂),
      κγ V₁ ≫ ((wcProEtBC T.πi).map g).left = ((wcProEtBC T.πi).map g).left ≫ κγ V₂ :=
    fun g => hnatγ' g.left _ (hρ T.πi g).1 (hρ T.πi g).2
  have hnata' : ∀ {V₁ V₂ : XE.ProEt} (gl : V₁.left ⟶ V₂.left)
      (ρw : Limits.pullback V₁.hom w ⟶ Limits.pullback V₂.hom w)
      (ρ : Limits.pullback V₁.hom T.πi ⟶ Limits.pullback V₂.hom T.πi)
      (ρ' : Limits.pullback (Limits.pullback.snd V₁.hom w) T.πi ⟶
        Limits.pullback (Limits.pullback.snd V₂.hom w) T.πi),
      ρ ≫ Limits.pullback.fst V₂.hom T.πi = Limits.pullback.fst V₁.hom T.πi ≫ gl →
      ρ ≫ Limits.pullback.snd V₂.hom T.πi = Limits.pullback.snd V₁.hom T.πi →
      ρw ≫ Limits.pullback.fst V₂.hom w = Limits.pullback.fst V₁.hom w ≫ gl →
      ρ' ≫ Limits.pullback.fst (Limits.pullback.snd V₂.hom w) T.πi =
        Limits.pullback.fst (Limits.pullback.snd V₁.hom w) T.πi ≫ ρw →
      ρ' ≫ Limits.pullback.snd (Limits.pullback.snd V₂.hom w) T.πi =
        Limits.pullback.snd (Limits.pullback.snd V₁.hom w) T.πi →
      κa V₁ ≫ ρ = ρ' ≫ κa V₂ := by
    intro V₁ V₂ gl ρw ρ ρ' h1 h2 hw1 h1' h2'
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, h1, hκa1, ← Category.assoc, hκa1, ← Category.assoc,
        h1', Category.assoc, Category.assoc, hw1]
    · rw [Category.assoc, Category.assoc, h2, hκa2, hκa2, ← Category.assoc, h2']
  have hnata : ∀ {V₁ V₂ : XE.ProEt} (g : V₁ ⟶ V₂),
      κa V₁ ≫ ((wcProEtBC T.πi).map g).left =
        ((wcProEtBC T.πi).map ((wcProEtBC w).map g)).left ≫ κa V₂ :=
    fun g => hnata' g.left ((wcProEtBC w).map g).left _ _ (hρ T.πi g).1 (hρ T.πi g).2
      (hρ w g).1 (hρ T.πi ((wcProEtBC w).map g)).1 (hρ T.πi ((wcProEtBC w).map g)).2
  have hmor : ∀ (V : XE.ProEt)
      (κ' : Limits.pullback (Limits.pullback.snd V.hom w) T.πi ⟶
        Limits.pullback (Limits.pullback.snd V.hom w) T.πi),
      κ' ≫ Limits.pullback.fst (Limits.pullback.snd V.hom w) T.πi =
        Limits.pullback.fst (Limits.pullback.snd V.hom w) T.πi →
      κ' ≫ Limits.pullback.snd (Limits.pullback.snd V.hom w) T.πi =
        Limits.pullback.snd (Limits.pullback.snd V.hom w) T.πi ≫ T.γi →
      κa V ≫ κγ V = κ' ≫ κa V := by
    intro V κ' e1 e2
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, hκγ1, hκa1, ← Category.assoc, e1]
    · rw [Category.assoc, Category.assoc, hκγ2, hκa2, ← Category.assoc, hκa2, ← Category.assoc,
        e2, Category.assoc, Category.assoc, hcomm]

  have happγ : ∀ V : XE.ProEt, ∃ f : (wcSuppObj Dπ).val.obj (Opposite.op V) ⟶
      (wcSuppObj Dπ).val.obj (Opposite.op V),
      ∀ s : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]),
        (f.hom s : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])) = s.comp (κγ V).base.hom := by
    intro V
    refine ⟨ModuleCat.ofHom (X := ↑((wcSuppObj Dπ).val.obj (Opposite.op V)))
      (Y := ↑((wcSuppObj Dπ).val.obj (Opposite.op V)))
      { toFun := fun s => (show C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) from s).comp
          (κγ V).base.hom
        map_add' := fun s t => ContinuousMap.add_comp _ _ _
        map_smul' := fun r s => ?_ }, fun s => rfl⟩
    change C(↥V.left, ULift.{u+1} ℚ_[ℓ]) at r
    change C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) at s
    change (@HMul.hMul C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])
        C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])
        C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) _
        ((Dπ.φ.hom.app (Opposite.op V)).hom r) s).comp (κγ V).base.hom =
      @HMul.hMul C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])
        C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])
        C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) _
        ((Dπ.φ.hom.app (Opposite.op V)).hom r) (s.comp (κγ V).base.hom)
    refine (ContinuousMap.mul_comp _ _ _).trans ?_
    have H : ContinuousMap.comp ((Dπ.φ.hom.app (Opposite.op V)).hom r :
          C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])) (κγ V).base.hom =
        ((Dπ.φ.hom.app (Opposite.op V)).hom r : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])) := by
      refine (congrArg (fun t : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) =>
        t.comp (κγ V).base.hom) (hDπ V r)).trans ?_
      refine (hcompb _ _ r).trans ?_
      refine (congrArg (fun k : Limits.pullback V.hom T.πi ⟶ V.left => r.comp k.base.hom)
        (hκγ1 V)).trans ?_
      exact (hDπ V r).symm
    exact congrArg (fun t : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) =>
      t * s.comp (κγ V).base.hom) H
  choose appγ happγ using happγ
  have happa : ∀ V : XE.ProEt, ∃ f : (wcSuppObj Dπ).val.obj (Opposite.op V) ⟶
      ((wcQmtmPush Dτ).obj (wcSuppObj Dπ)).val.obj (Opposite.op V),
      ∀ s : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]),
        (f.hom s : C(↥(Limits.pullback (Limits.pullback.snd V.hom w) T.πi), ULift.{u+1} ℚ_[ℓ])) =
          s.comp (κa V).base.hom := by
    intro V
    refine ⟨ModuleCat.ofHom (X := ↑((wcSuppObj Dπ).val.obj (Opposite.op V)))
      (Y := ↑(((wcQmtmPush Dτ).obj (wcSuppObj Dπ)).val.obj (Opposite.op V)))
      { toFun := fun s => (show C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) from s).comp
          (κa V).base.hom
        map_add' := fun s t => ContinuousMap.add_comp _ _ _
        map_smul' := fun r s => ?_ }, fun s => rfl⟩
    change C(↥V.left, ULift.{u+1} ℚ_[ℓ]) at r
    change C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) at s
    change (@HMul.hMul C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])
        C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])
        C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) _
        ((Dπ.φ.hom.app (Opposite.op V)).hom r) s).comp (κa V).base.hom =
      @HMul.hMul C(↥(Limits.pullback (Limits.pullback.snd V.hom w) T.πi), ULift.{u+1} ℚ_[ℓ])
        C(↥(Limits.pullback (Limits.pullback.snd V.hom w) T.πi), ULift.{u+1} ℚ_[ℓ])
        C(↥(Limits.pullback (Limits.pullback.snd V.hom w) T.πi), ULift.{u+1} ℚ_[ℓ]) _
        ((Dπ.φ.hom.app (Opposite.op ((wcProEtBC w).obj V))).hom
          ((Dτ.φ.hom.app (Opposite.op V)).hom r)) (s.comp (κa V).base.hom)
    refine (ContinuousMap.mul_comp _ _ _).trans ?_
    have H : ContinuousMap.comp ((Dπ.φ.hom.app (Opposite.op V)).hom r :
          C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])) (κa V).base.hom =
        ((Dπ.φ.hom.app (Opposite.op ((wcProEtBC w).obj V))).hom
          ((Dτ.φ.hom.app (Opposite.op V)).hom r) :
          C(↥(Limits.pullback (Limits.pullback.snd V.hom w) T.πi), ULift.{u+1} ℚ_[ℓ])) := by
      refine (congrArg (fun t : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) =>
        t.comp (κa V).base.hom) (hDπ V r)).trans ?_
      refine (hcompb _ _ r).trans ?_
      refine (congrArg (fun k : Limits.pullback (Limits.pullback.snd V.hom w) T.πi ⟶ V.left =>
        r.comp k.base.hom) (hκa1 V)).trans ?_
      refine Eq.trans ?_
        (hDπ ((wcProEtBC w).obj V) ((Dτ.φ.hom.app (Opposite.op V)).hom r)).symm
      refine Eq.trans ?_ (congrArg (fun t : C(↥(Limits.pullback V.hom w), ULift.{u+1} ℚ_[ℓ]) =>
        t.comp (Limits.pullback.fst ((wcProEtBC w).obj V).hom T.πi).base.hom) (hDτ V r)).symm
      exact (hcompb _ _ r).symm
    exact congrArg (fun t : C(↥(Limits.pullback (Limits.pullback.snd V.hom w) T.πi),
      ULift.{u+1} ℚ_[ℓ]) => t * s.comp (κa V).base.hom) H
  choose appa happa using happa
  obtain ⟨γN, hγN⟩ : ∃ γN : wcSuppObj Dπ ⟶ wcSuppObj Dπ, ∀ (V : XE.ProEt)
      (s : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])),
      ((γN.val.app (Opposite.op V)).hom s : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])) =
        s.comp (κγ V).base.hom := by
    refine ⟨⟨⟨fun X => appγ X.unop, ?_⟩⟩, fun V s => happγ V s⟩
    intro X Y f
    apply ModuleCat.hom_ext; apply LinearMap.ext; intro s
    change C(↥(Limits.pullback X.unop.hom T.πi), ULift.{u+1} ℚ_[ℓ]) at s
    change ((appγ Y.unop).hom (s.comp ((wcProEtBC T.πi).map f.unop).left.base.hom) :
        C(↥(Limits.pullback Y.unop.hom T.πi), ULift.{u+1} ℚ_[ℓ])) =
      ((appγ X.unop).hom s : C(↥(Limits.pullback X.unop.hom T.πi), ULift.{u+1} ℚ_[ℓ])).comp
        ((wcProEtBC T.πi).map f.unop).left.base.hom
    refine (happγ Y.unop _).trans ?_
    refine (hpre _ _ _ _ s (hnatγ f.unop)).trans ?_
    exact (congrArg (fun t => ContinuousMap.comp t _) (happγ X.unop s)).symm
  obtain ⟨aN, haN⟩ : ∃ aN : wcSuppObj Dπ ⟶ (wcQmtmPush Dτ).obj (wcSuppObj Dπ), ∀ (V : XE.ProEt)
      (s : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])),
      ((aN.val.app (Opposite.op V)).hom s :
        C(↥(Limits.pullback (Limits.pullback.snd V.hom w) T.πi), ULift.{u+1} ℚ_[ℓ])) =
        s.comp (κa V).base.hom := by
    refine ⟨⟨⟨fun X => appa X.unop, ?_⟩⟩, fun V s => happa V s⟩
    intro X Y f
    apply ModuleCat.hom_ext; apply LinearMap.ext; intro s
    change C(↥(Limits.pullback X.unop.hom T.πi), ULift.{u+1} ℚ_[ℓ]) at s
    change ((appa Y.unop).hom (s.comp ((wcProEtBC T.πi).map f.unop).left.base.hom) :
        C(↥(Limits.pullback (Limits.pullback.snd Y.unop.hom w) T.πi), ULift.{u+1} ℚ_[ℓ])) =
      ((appa X.unop).hom s :
        C(↥(Limits.pullback (Limits.pullback.snd X.unop.hom w) T.πi), ULift.{u+1} ℚ_[ℓ])).comp
        ((wcProEtBC T.πi).map ((wcProEtBC w).map f.unop)).left.base.hom
    refine (happa Y.unop _).trans ?_
    refine (hpre _ _ _ _ s (hnata f.unop)).trans ?_
    exact (congrArg (fun t => ContinuousMap.comp t _) (happa X.unop s)).symm

  have hu_app : ∀ (V : XE.ProEt) (a : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
      (((wcSuppUnitMap Dπ).val.app (Opposite.op V)).hom a :
        C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ])) =
        a.comp (Limits.pullback.fst V.hom T.πi).base.hom := by
    intro V a
    rw [hu]
    have h0 := SheafOfModules.unitToPushforwardObjUnit_val_app_apply Dπ.φ (X := Opposite.op V) a
    exact h0.trans (hDπ V a)
  have huτ : ∀ (V : XE.ProEt) (a : C(↥V.left, ULift.{u+1} ℚ_[ℓ])),
      (((wcQmtmUnit Dτ).val.app (Opposite.op V)).hom a :
        C(↥(Limits.pullback V.hom w), ULift.{u+1} ℚ_[ℓ])) =
        a.comp (Limits.pullback.fst V.hom w).base.hom := by
    intro V a
    have h0 := SheafOfModules.unitToPushforwardObjUnit_val_app_apply Dτ.φ (X := Opposite.op V) a
    exact h0.trans (hDτ V a)
  refine ⟨γN, aN, ?_, ?_, ?_, ?_, ?_⟩
  · intro V s κ h1 h2
    rw [Limits.pullback.hom_ext (h1.trans (hκγ1 V).symm) (h2.trans (hκγ2 V).symm)]
    exact hγN V s
  · intro V s κ h1 h2
    rw [Limits.pullback.hom_ext (h1.trans (hκa1 V).symm) (h2.trans (hκa2 V).symm)]
    exact haN V s
  · apply ext_sec
    intro V a
    change C(↥V.left, ULift.{u+1} ℚ_[ℓ]) at a
    change (γN.val.app (Opposite.op V)).hom (((wcSuppUnitMap Dπ).val.app (Opposite.op V)).hom a) =
      ((wcSuppUnitMap Dπ).val.app (Opposite.op V)).hom a
    refine (hγN V _).trans ?_
    refine (congrArg (fun t : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) =>
      t.comp (κγ V).base.hom) (hu_app V a)).trans ?_
    refine (hcompb _ _ a).trans ?_
    refine (congrArg (fun k : Limits.pullback V.hom T.πi ⟶ V.left => a.comp k.base.hom)
      (hκγ1 V)).trans ?_
    exact (hu_app V a).symm
  · apply ext_sec
    intro V a
    change C(↥V.left, ULift.{u+1} ℚ_[ℓ]) at a
    change (aN.val.app (Opposite.op V)).hom (((wcSuppUnitMap Dπ).val.app (Opposite.op V)).hom a) =
      ((wcSuppUnitMap Dπ).val.app (Opposite.op ((wcProEtBC w).obj V))).hom
        (((wcQmtmUnit Dτ).val.app (Opposite.op V)).hom a)
    have hl : ((aN.val.app (Opposite.op V)).hom
        (((wcSuppUnitMap Dπ).val.app (Opposite.op V)).hom a) :
          C(↥(Limits.pullback (Limits.pullback.snd V.hom w) T.πi), ULift.{u+1} ℚ_[ℓ])) =
        a.comp (Limits.pullback.fst (Limits.pullback.snd V.hom w) T.πi ≫
          Limits.pullback.fst V.hom w).base.hom := by
      refine (haN V _).trans ?_
      refine (congrArg (fun t : C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) =>
        t.comp (κa V).base.hom) (hu_app V a)).trans ?_
      refine (hcompb _ _ a).trans ?_
      exact congrArg (fun k : Limits.pullback (Limits.pullback.snd V.hom w) T.πi ⟶ V.left =>
        a.comp k.base.hom) (hκa1 V)
    have hr : (((wcSuppUnitMap Dπ).val.app (Opposite.op ((wcProEtBC w).obj V))).hom
        (((wcQmtmUnit Dτ).val.app (Opposite.op V)).hom a) :
          C(↥(Limits.pullback ((wcProEtBC w).obj V).hom T.πi), ULift.{u+1} ℚ_[ℓ])) =
        a.comp (Limits.pullback.fst ((wcProEtBC w).obj V).hom T.πi ≫
          Limits.pullback.fst V.hom w).base.hom := by
      refine (hu_app ((wcProEtBC w).obj V) _).trans ?_
      refine (congrArg (fun t : C(↥(Limits.pullback V.hom w), ULift.{u+1} ℚ_[ℓ]) =>
        t.comp (Limits.pullback.fst ((wcProEtBC w).obj V).hom T.πi).base.hom) (huτ V a)).trans ?_
      exact hcompb _ _ a
    exact hl.trans hr.symm
  · apply ext_sec
    intro V s
    change C(↥(Limits.pullback V.hom T.πi), ULift.{u+1} ℚ_[ℓ]) at s
    change (aN.val.app (Opposite.op V)).hom ((γN.val.app (Opposite.op V)).hom s) =
      (γN.val.app (Opposite.op ((wcProEtBC w).obj V))).hom ((aN.val.app (Opposite.op V)).hom s)
    refine (congrArg (fun t => (aN.val.app (Opposite.op V)).hom t) (hγN V s)).trans ?_
    refine (haN V _).trans ?_
    refine Eq.trans ?_
      (congrArg (fun t => (γN.val.app (Opposite.op ((wcProEtBC w).obj V))).hom t) (haN V s)).symm
    refine Eq.trans ?_ (hγN ((wcProEtBC w).obj V) (s.comp (κa V).base.hom)).symm
    exact hpre _ _ _ _ s (hmor V (κγ ((wcProEtBC w).obj V)) (hκγ1 _) (hκγ2 _))

theorem wc_sst_chi_qis_neg {𝒜 ℬ 𝒞 : Type*} [Category 𝒜] [Category ℬ]
    [Category 𝒞] [Abelian 𝒜] [Abelian ℬ] [Abelian 𝒞]
    (Lp : ℬ ⥤ 𝒜) (P : 𝒜 ⥤ ℬ) (adjP : Lp ⊣ P) [P.Additive]
    (Φ : ℬ ⥤ 𝒞) [Φ.Additive] [Limits.PreservesFiniteLimits Φ]
    (Λ N : 𝒜) (u : Λ ⟶ N) (g : N ⟶ N) (hug : u ≫ g = 0)
    (hS : (ShortComplex.mk u g hug).ShortExact)
    (I : InjectiveResolution Λ)
    (v : N ⟶ I.cochainComplex.X 0)
    (hv : u ≫ v = (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 Λ).inv ≫ I.ι'.f 0)
    (χ : CochainComplex.mappingCone
        ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map (Φ.map (P.map g))) ⟶
      (shiftFunctor (CochainComplex 𝒞 ℤ) (1 : ℤ)).obj
        ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
          ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex)))
    (h₁ : (CochainComplex.mappingCone.inl _).v 0 (-1) (by omega) ≫ χ.f (-1) =
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (Φ.obj (P.obj N))).hom ≫
        Φ.map (P.map v)) :
    ∀ n : ℤ, n < 0 → QuasiIsoAt χ n :=
by
  classical
  have := adjP.rightAdjoint_preservesLimits
  intro n hn

  have hIz : ∀ p : ℤ, p < 0 → Limits.IsZero (I.cochainComplex.X p) := by
    intro p hp
    exact HomologicalComplex.isZero_extend_X I.cocomplex ComplexShape.embeddingUpNat p
      (fun i h => by
        simp only [ComplexShape.embeddingUpNat_f] at h
        omega)
  have hTz : ∀ p : ℤ, p ≤ -2 → Limits.IsZero (((shiftFunctor (CochainComplex 𝒞 ℤ) (1 : ℤ)).obj
        ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
          ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex))).X p) := by
    intro p hp
    change Limits.IsZero (Φ.obj (P.obj (I.cochainComplex.X (p + 1))))
    exact Φ.map_isZero (P.map_isZero (hIz (p + 1) (by omega)))
  have hCz : ∀ p : ℤ, p ≤ -2 → Limits.IsZero ((CochainComplex.mappingCone
        ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map (Φ.map (P.map g)))).X p) := by
    intro p hp
    exact (CochainComplex.mappingCone.isZero_X_iff _ p).2
      ⟨HomologicalComplex.isZero_single_obj_X _ _ _ _ (by omega),
        HomologicalComplex.isZero_single_obj_X _ _ _ _ (by omega)⟩
  by_cases hn1 : n = -1
  swap
  ·
    have hn2 : n ≤ -2 := by omega
    rw [quasiIsoAt_iff_isIso_homologyMap]
    exact Limits.IsZero.isIso
      (ShortComplex.isZero_homology_of_isZero_X₂ _ (hCz n hn2))
      (ShortComplex.isZero_homology_of_isZero_X₂ _ (hTz n hn2)) _
  subst hn1

  have hz1 : (CochainComplex.mappingCone.snd
        ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map (Φ.map (P.map g)))).v (-1) (-1)
        (by omega) ≫
      (CochainComplex.mappingCone.inr
        ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map (Φ.map (P.map g)))).f (-1) = 0 := by
    have hz : Limits.IsZero (((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj
        (Φ.obj (P.obj N))).X (-1)) :=
      HomologicalComplex.isZero_single_obj_X _ _ _ _ (by omega)
    rw [hz.eq_of_tgt ((CochainComplex.mappingCone.snd _).v (-1) (-1) (by omega)) 0,
      Limits.zero_comp]
  let eA : Φ.obj (P.obj N) ≅ (CochainComplex.mappingCone
      ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map (Φ.map (P.map g)))).X (-1) :=
    { hom := (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (Φ.obj (P.obj N))).inv ≫
        (CochainComplex.mappingCone.inl _).v 0 (-1) (by omega)
      inv := (CochainComplex.mappingCone.fst _).1.v (-1) 0 (by omega) ≫
        (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (Φ.obj (P.obj N))).hom
      hom_inv_id := by
        rw [Category.assoc, ← Category.assoc ((CochainComplex.mappingCone.inl _).v 0 (-1) _),
          CochainComplex.mappingCone.inl_v_fst_v, Category.id_comp, Iso.inv_hom_id]
      inv_hom_id := by
        have hid := CochainComplex.mappingCone.id_X
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map (Φ.map (P.map g))) (-1) 0
          (by omega)
        rw [hz1, add_zero] at hid
        rw [Category.assoc, Iso.hom_inv_id_assoc]
        exact hid }
  have heA : eA.hom =
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (Φ.obj (P.obj N))).inv ≫
        (CochainComplex.mappingCone.inl
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map (Φ.map (P.map g)))).v 0 (-1)
          (by omega) := rfl
  have hdA : eA.hom ≫ (CochainComplex.mappingCone
      ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map (Φ.map (P.map g)))).d (-1) 0 =
      Φ.map (P.map g) ≫
        (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (Φ.obj (P.obj N))).inv ≫
        (CochainComplex.mappingCone.inr
          ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map (Φ.map (P.map g)))).f 0 := by
    have hF : ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj (Φ.obj (P.obj N))).d 0 1
        = 0 :=
      (HomologicalComplex.isZero_single_obj_X _ _ _ 1 (by omega)).eq_of_tgt _ _
    rw [heA, Category.assoc, CochainComplex.mappingCone.inl_v_d _ 0 (-1) 1 (by omega) (by omega),
      hF, Limits.zero_comp, sub_zero, HomologicalComplex.single_map_f_self]
    simp only [Category.assoc, Iso.inv_hom_id_assoc]
  have hiffA : ∀ ⦃W : 𝒞⦄ (x : W ⟶ Φ.obj (P.obj N)), x ≫ Φ.map (P.map g) = 0 ↔
      x ≫ eA.hom ≫ (CochainComplex.mappingCone
        ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map (Φ.map (P.map g)))).d (-1) 0
        = 0 := by
    intro W x
    rw [hdA]
    constructor
    · intro h
      rw [← Category.assoc, h, Limits.zero_comp]
    · intro h
      have h2 := congrArg (fun y => y ≫ (CochainComplex.mappingCone.snd
        ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map (Φ.map (P.map g)))).v 0 0
          (by omega) ≫
        (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (Φ.obj (P.obj N))).hom) h
      simp only [Category.assoc, CochainComplex.mappingCone.inr_f_snd_v_assoc, Iso.inv_hom_id,
        Category.comp_id, Limits.zero_comp] at h2
      exact h2
  have hU := Limits.KernelFork.mapIsLimit _
    (Limits.KernelFork.mapIsLimit _ hS.fIsKernel P) Φ
  have hc₁ := Limits.KernelFork.isLimitOfIsLimitOfIff hU
    ((CochainComplex.mappingCone
      ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map (Φ.map (P.map g)))).d (-1) 0)
    eA hiffA

  have hk := I.exact₀.fIsKernel
  have hiffI : ∀ ⦃W : 𝒜⦄ (x : W ⟶ I.cocomplex.X 0), x ≫ I.cocomplex.d 0 1 = 0 ↔
      x ≫ (I.cochainComplexXIso 0 0 rfl).symm.hom ≫ I.cochainComplex.d 0 1 = 0 := by
    intro W x
    rw [InjectiveResolution.cochainComplex_d I 0 1 0 1 rfl rfl, Iso.symm_hom,
      Iso.inv_hom_id_assoc, ← Category.assoc,
      Preadditive.IsIso.comp_right_eq_zero _ (I.cochainComplexXIso 1 1 rfl).inv]
  have hJ0 := Limits.KernelFork.isLimitOfIsLimitOfIff hk (I.cochainComplex.d 0 1)
    (I.cochainComplexXIso 0 0 rfl).symm hiffI
  have hJ := Limits.KernelFork.mapIsLimit _ (Limits.KernelFork.mapIsLimit _ hJ0 P) Φ
  have hTd : ((shiftFunctor (CochainComplex 𝒞 ℤ) (1 : ℤ)).obj
        ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
          ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex))).d (-1) 0 =
      -(Φ.map (P.map (I.cochainComplex.d 0 1))) := by
    rw [CochainComplex.shiftFunctor_obj_d']
    simp only [Int.negOnePow_one, Units.neg_smul, one_smul]
    rfl
  have hc₂ := Limits.KernelFork.isLimitOfIsLimitOfIff' hJ
    (((shiftFunctor (CochainComplex 𝒞 ℤ) (1 : ℤ)).obj
        ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
          ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex))).d (-1) 0)
    (fun W x => by
      rw [hTd, Preadditive.comp_neg, neg_eq_zero])
  have hι0 : (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 Λ).inv ≫ I.ι'.f 0 =
      I.ι.f 0 ≫ (I.cochainComplexXIso 0 0 rfl).inv := by
    rw [InjectiveResolution.ι'_f_zero, Iso.inv_hom_id_assoc]
    rfl
  have key : (Φ.map (P.map u) ≫ eA.hom) ≫ χ.f (-1) =
      Φ.map (P.map (I.ι.f 0 ≫ (I.cochainComplexXIso 0 0 rfl).symm.hom)) := by
    rw [heA, Category.assoc, Category.assoc, h₁, Iso.inv_hom_id_assoc, ← Φ.map_comp,
      ← P.map_comp, hv, hι0, Iso.symm_hom]
    rfl

  rw [quasiIsoAt_iff' χ (-2) (-1) 0 ((ComplexShape.up ℤ).prev_eq' (by simp))
    ((ComplexShape.up ℤ).next_eq' (by simp))]
  rw [(ShortComplex.LeftHomologyMapData.ofIsLimitKernelFork
    ((HomologicalComplex.shortComplexFunctor' 𝒞 (ComplexShape.up ℤ) (-2) (-1) 0).map χ)
    ((hCz (-2) le_rfl).eq_of_src _ _) _ hc₁ ((hTz (-2) le_rfl).eq_of_src _ _) _ hc₂
    (𝟙 _) (key.trans (Category.id_comp _).symm)).quasiIso_iff]
  exact IsIso.id _

theorem wc_sst_chi_qis_nonneg {𝒜 ℬ 𝒞 : Type*} [Category 𝒜] [Category ℬ]
    [Category 𝒞] [Abelian 𝒜] [Abelian ℬ] [Abelian 𝒞] [EnoughInjectives 𝒜]
    (Lp : ℬ ⥤ 𝒜) (P : 𝒜 ⥤ ℬ) (adjP : Lp ⊣ P) [Lp.Additive] [Limits.PreservesFiniteLimits Lp]
    [Limits.PreservesFiniteColimits Lp] [P.Additive]
    (Φ : ℬ ⥤ 𝒞) [Φ.Additive] [Limits.PreservesFiniteLimits Φ] [Limits.PreservesFiniteColimits Φ]
    (Λ N : 𝒜) (u : Λ ⟶ N) (g : N ⟶ N) (hug : u ≫ g = 0)
    (hS : (ShortComplex.mk u g hug).ShortExact)
    (hacyc : ∀ (J : InjectiveResolution N) (m : ℕ), 1 ≤ m →
      Limits.IsZero (Φ.obj (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj J.cocomplex).homology m)))
    (I : InjectiveResolution Λ)
    (v : N ⟶ I.cochainComplex.X 0)
    (hv : u ≫ v = (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 Λ).inv ≫ I.ι'.f 0)
    (w : N ⟶ I.cochainComplex.X 1) (hw : g ≫ w = v ≫ I.cochainComplex.d 0 1)
    (χ : CochainComplex.mappingCone
        ((HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).map (Φ.map (P.map g))) ⟶
      (shiftFunctor (CochainComplex 𝒞 ℤ) (1 : ℤ)).obj
        ((Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
          ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex)))
    (h₂ : (CochainComplex.mappingCone.inr _).f 0 ≫ χ.f 0 =
      -((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 (Φ.obj (P.obj N))).hom ≫
        Φ.map (P.map w))) :
    ∀ n : ℤ, 0 ≤ n → QuasiIsoAt χ n :=
by
  have t_s1 {K L : CochainComplex 𝒞 ℤ} (f f' : K ⟶ L)
      (i j : ℤ) (s : K.X i ⟶ L.X j) (h : f.f i = f'.f i + s ≫ L.d j i) :
      (QuasiIsoAt f i ↔ QuasiIsoAt f' i) := by
    have key : HomologicalComplex.homologyMap f i = HomologicalComplex.homologyMap f' i := by
      rw [← cancel_epi (K.homologyπ i), HomologicalComplex.homologyπ_naturality,
        HomologicalComplex.homologyπ_naturality]
      have hc : HomologicalComplex.cyclesMap f i =
          HomologicalComplex.cyclesMap f' i + K.iCycles i ≫ s ≫ L.toCycles j i := by
        rw [← cancel_mono (L.iCycles i)]
        simp only [Preadditive.add_comp, HomologicalComplex.cyclesMap_i, Category.assoc,
          HomologicalComplex.toCycles_i, h, Preadditive.comp_add]
      rw [hc, Preadditive.add_comp]
      simp [HomologicalComplex.toCycles_comp_homologyπ]
    rw [quasiIsoAt_iff_isIso_homologyMap, quasiIsoAt_iff_isIso_homologyMap, key]
  have t_s8 {K L : CochainComplex 𝒜 ℤ} (f f' : K ⟶ L)
      (i : ℤ) (hK : Limits.IsZero (K.X (i + 1))) (hL : Limits.IsZero (L.X (i - 1)))
      (H : Homotopy f f') : f.f i = f'.f i := by
    rw [H.comm i, dNext_eq _ (show (ComplexShape.up ℤ).Rel i (i+1) from rfl),
      prevD_eq _ (show (ComplexShape.up ℤ).Rel (i-1) i by simp)]
    rw [hK.eq_of_tgt (K.d i (i+1)) 0, hL.eq_of_tgt (H.hom i (i-1)) 0]
    simp
  have t_s3A {K₁ L₁ K₂ L₂ : CochainComplex 𝒜 ℤ}
      (φ₁ : K₁ ⟶ L₁) (φ₂ : K₂ ⟶ L₂) (a : K₁ ⟶ K₂) (b : L₁ ⟶ L₂) (comm : φ₁ ≫ b = a ≫ φ₂)
      (ha : QuasiIso a) (hb : QuasiIso b) :
      QuasiIso (CochainComplex.mappingCone.map φ₁ φ₂ a b comm) := by
    letI := HasDerivedCategory.standard 𝒜
    rw [← DerivedCategory.isIso_Q_map_iff_quasiIso]
    have ha' := (DerivedCategory.isIso_Q_map_iff_quasiIso 𝒜 a).2 ha
    have hb' := (DerivedCategory.isIso_Q_map_iff_quasiIso 𝒜 b).2 hb
    have h := Pretriangulated.isIso₃_of_isIso₁₂
      (DerivedCategory.Q.mapTriangle.map (CochainComplex.mappingCone.triangleMap φ₁ φ₂ a b comm))
      (DerivedCategory.mappingCone_triangle_distinguished φ₁)
      (DerivedCategory.mappingCone_triangle_distinguished φ₂) (by exact ha') (by exact hb')
    exact h
  have t_s3C {K₁ L₁ K₂ L₂ : CochainComplex 𝒞 ℤ}
      (φ₁ : K₁ ⟶ L₁) (φ₂ : K₂ ⟶ L₂) (a : K₁ ⟶ K₂) (b : L₁ ⟶ L₂) (comm : φ₁ ≫ b = a ≫ φ₂)
      (ha : QuasiIso a) (hb : QuasiIso b) :
      QuasiIso (CochainComplex.mappingCone.map φ₁ φ₂ a b comm) := by
    letI := HasDerivedCategory.standard 𝒞
    rw [← DerivedCategory.isIso_Q_map_iff_quasiIso]
    have ha' := (DerivedCategory.isIso_Q_map_iff_quasiIso 𝒞 a).2 ha
    have hb' := (DerivedCategory.isIso_Q_map_iff_quasiIso 𝒞 b).2 hb
    have h := Pretriangulated.isIso₃_of_isIso₁₂
      (DerivedCategory.Q.mapTriangle.map (CochainComplex.mappingCone.triangleMap φ₁ φ₂ a b comm))
      (DerivedCategory.mappingCone_triangle_distinguished φ₁)
      (DerivedCategory.mappingCone_triangle_distinguished φ₂) (by exact ha') (by exact hb')
    exact h
  have t_s10 {K₀ K L : CochainComplex 𝒜 ℤ}
