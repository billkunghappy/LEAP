    obtain ⟨Z, hZ⟩ := Limits.HasZeroObject.zero
      (C := Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
    exact ⟨Z, hZ.eq_of_src _ _,
      ⟨Limits.IsZero.iso ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m)).map_isZero h0)
        ((wcEpsInv S).map_isZero hZ)⟩⟩
  · obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le hq

    let L := I.cocomplex
    let aux : ∀ o : Option ℕ, P.obj (HomologicalComplex.extend.X L o) ≅
        HomologicalComplex.extend.X ((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj L) o :=
      fun o => match o with
        | some _ => Iso.refl _
        | none => Limits.IsZero.iso (P.map_isZero (Limits.isZero_zero _)) (Limits.isZero_zero _)
    have α : (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ≅
        ((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).extend
          ComplexShape.embeddingUpNat := by
      refine HomologicalComplex.Hom.isoOfComponents
        (fun i' => aux (ComplexShape.embeddingUpNat.r i')) ?_
      intro i' j' _
      show (aux _).hom ≫ HomologicalComplex.extend.d _ _ _ =
        P.map (HomologicalComplex.extend.d L _ _) ≫ (aux _).hom
      generalize ComplexShape.embeddingUpNat.r i' = o1
      generalize ComplexShape.embeddingUpNat.r j' = o2
      cases o1 with
      | none => exact (P.map_isZero (Limits.isZero_zero _)).eq_of_src _ _
      | some a =>
        cases o2 with
        | none => exact (Limits.isZero_zero _).eq_of_tgt _ _
        | some b =>
          show 𝟙 _ ≫ P.map (L.d a b) = P.map (L.d a b) ≫ 𝟙 _
          rw [Category.id_comp, Category.comp_id]
    have e1 : ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex).homology
        (n : ℤ) ≅ (P.rightDerived n).obj (SheafOfModules.unit (wcZModRingSheaf E m)) :=
      HomologicalComplex.homologyMapIso α (n : ℤ) ≪≫
        HomologicalComplex.extendHomologyIso _ ComplexShape.embeddingUpNat
          (ComplexShape.embeddingUpNat_f n) ≪≫ (I.isoRightDerivedObj P n).symm

    have α2 : P ⋙ SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m) ≅
        SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf E m) ⋙ wcProEtPush g :=
      (Functor.rightUnitor _).symm ≪≫
        Functor.isoWhiskerLeft _ (sheafificationNatIso (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})

    have hacycP : ∀ (J : SheafOfModules.{u+1} (wcZModRingSheaf E m)) [Injective J] (k : ℕ),
        Limits.IsZero (((wcProEtPush g).rightDerived (k + 1)).obj
          ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf E m)).obj J)) := by
      intro J _ k
      apply wc_proet_push_rightDerived_zero_of_local
      intro U
      refine GrothendieckTopology.superset_covering _ ?_ (GrothendieckTopology.top_mem _ U)
      intro T f _
      apply Sieve.le_generate
      exact fun e => wc_tq_zmod_inj_free_ext_vanish E m hm _ J k e
    obtain ⟨e2⟩ := wc_rightDerived_exact_conj_iso P (wcProEtPush g)
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf E m))
      (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m)) ⟨α2⟩ hacycP
      (SheafOfModules.unit (wcZModRingSheaf E m)) n

    obtain ⟨_, κ, -⟩ := (wc_zmod_model_structure_maps m hm).1 E

    obtain ⟨β⟩ := wc_epsInv_push_base_change g
    have hacyc : ∀ (I' : Sheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}) [Injective I']
        (k : ℕ), Limits.IsZero (((wcProEtPush g).rightDerived (k + 1)).obj ((wcEpsInv E).obj I')) := by
      intro I' _ k
      apply wc_proet_push_rightDerived_zero_of_local
      intro U
      refine GrothendieckTopology.superset_covering _ ?_ (wc_proet_affIndEt_covering S U)
      apply Sieve.generate_mono
      rintro T f ⟨A, hA, hT⟩
      exact fun e => wc_proet_push_epsInv_injective_affine_vanishing_affHom g A hA T hT I' k e
    obtain ⟨Φ⟩ := wc_rightDerived_exact_conj_iso (wcEtPush g) (wcProEtPush g) (wcEpsInv E)
      (wcEpsInv S) ⟨β⟩ hacyc
      ((constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) n
    obtain ⟨c₁⟩ := wc_contSheaf_discrete_const E (ZMod m)
    obtain ⟨c₂⟩ := wc_epsInv_const E (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))
    have h0 : m • 𝟙 (AddCommGrpCat.of (ULift.{u+1} (ZMod m))) = 0 := by
      ext x
      first
        | (simp [nsmul_eq_mul]; done)
        | (change (m • x).down = (0 : ULift.{u+1} (ZMod m)).down
           simp [nsmul_eq_mul])
    have htorΛ : m • 𝟙 ((constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) = 0 := by
      rw [← (constantSheaf (Scheme.smallEtaleTopology E) AddCommGrpCat.{u+1}).map_id,
        ← Functor.map_nsmul, h0, Functor.map_zero]
    exact ⟨_, wc_rightDerived_nsmul_eq_zero (wcEtPush g) m n _ htorΛ,
      ⟨(SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m)).mapIso e1 ≪≫ e2.symm ≪≫
        ((wcProEtPush g).rightDerived n).mapIso (κ ≪≫ c₁ ≪≫ c₂.symm) ≪≫ Φ⟩⟩

theorem wc_tq_inj_complex_homology_collapse : ∀ {C D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] [HasInjectiveResolutions C] (G : C ⥤ D) [G.Additive] [Limits.PreservesFiniteLimits G] (L : CochainComplex C ℤ) (m₀ : ℤ), L.IsStrictlyGE m₀ → (∀ k, Injective (L.X k)) → (∀ (q : ℤ) (k : ℕ), Limits.IsZero ((G.rightDerived (k + 1)).obj (L.homology q))) → ∀ q : ℤ, Nonempty (((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj L).homology q ≅ G.obj (L.homology q)) :=
by
  intro C D _ _ _ _ _ G _ _ L m₀ hL hLi hH q
  suffices hles : ∀ (R : C ⥤ D) [R.Additive] [Limits.PreservesFiniteLimits R] (S : ShortComplex C), S.ShortExact → (∀ (q : ℕ) {X Y : C} (a b : X ⟶ Y), (R.rightDerived q).map (a - b) = (R.rightDerived q).map a - (R.rightDerived q).map b) ∧ Mono ((R.rightDerived 0).map S.f) ∧ ∀ q : ℕ, (∃ h0 : (R.rightDerived q).map S.f ≫ (R.rightDerived q).map S.g = 0, (ShortComplex.mk _ _ h0).Exact) ∧ ∃ (δ : (R.rightDerived q).obj S.X₃ ⟶ (R.rightDerived (q + 1)).obj S.X₁) (h1 : (R.rightDerived q).map S.g ≫ δ = 0) (h2 : δ ≫ (R.rightDerived (q + 1)).map S.f = 0), (ShortComplex.mk _ _ h1).Exact ∧ (ShortComplex.mk _ _ h2).Exact by

    have pkg : ∀ (S : ShortComplex C), S.ShortExact →
        (∀ k : ℕ, Limits.IsZero ((G.rightDerived (k + 1)).obj S.X₁)) →
        (S.map G).ShortExact ∧
        ((∀ k : ℕ, Limits.IsZero ((G.rightDerived (k + 1)).obj S.X₂)) →
          ∀ k : ℕ, Limits.IsZero ((G.rightDerived (k + 1)).obj S.X₃)) ∧
        ((∀ k : ℕ, Limits.IsZero ((G.rightDerived (k + 1)).obj S.X₃)) →
          ∀ k : ℕ, Limits.IsZero ((G.rightDerived (k + 1)).obj S.X₂)) := by
      intro S hS h1
      obtain ⟨-, -, hl⟩ := hles G S hS
      refine ⟨?_, ?_, ?_⟩
      · obtain ⟨-, δ, e1, e2, hex1, hex2⟩ := hl 0
        have hδ : δ = 0 := (h1 0).eq_of_tgt _ _
        haveI hepi : Epi ((G.rightDerived 0).map S.g) := hex1.epi_f hδ
        have hmf : Mono S.f := hS.mono_f
        have hg : G.map S.g = G.rightDerivedZeroIsoSelf.inv.app S.X₂ ≫
            (G.rightDerived 0).map S.g ≫ G.rightDerivedZeroIsoSelf.hom.app S.X₃ := by
          rw [G.rightDerivedZeroIsoSelf.hom.naturality S.g, ← Category.assoc,
            Iso.inv_hom_id_app, Category.id_comp]
        refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
        · exact hS.exact.map_of_mono_of_preservesKernel G hmf inferInstance
        · exact (inferInstance : Mono (G.map S.f))
        · show Epi (G.map S.g)
          rw [hg]
          infer_instance
      · intro h2 k
        obtain ⟨-, δ, e1, e2, hex1, hex2⟩ := hl (k + 1)
        exact hex1.isZero_X₂ ((h2 k).eq_of_src _ _) ((h1 (k + 1)).eq_of_tgt _ _)
      · intro h3 k
        obtain ⟨⟨e0, hex0⟩, -⟩ := hl (k + 1)
        exact hex0.isZero_X₂ ((h1 k).eq_of_src _ _) ((h3 k).eq_of_tgt _ _)

    have ses : ∀ i j : ℤ, i + 1 = j →
        (∃ w : L.iCycles i ≫ Limits.factorThruImage (L.toCycles i j) = 0,
          (ShortComplex.mk _ _ w).ShortExact) ∧
        (∃ w : Limits.image.ι (L.toCycles i j) ≫ L.homologyπ j = 0,
          (ShortComplex.mk _ _ w).ShortExact) := by
      intro i j hij
      have hnext : (ComplexShape.up ℤ).next i = j := (CochainComplex.next ℤ i).trans hij
      have hprev : (ComplexShape.up ℤ).prev j = i := (CochainComplex.prev ℤ j).trans (by omega)
      have hfac : Limits.factorThruImage (L.toCycles i j) ≫
          (Limits.image.ι (L.toCycles i j) ≫ L.iCycles j) = L.d i j := by
        rw [Limits.image.fac_assoc, L.toCycles_i]
      have w1 : L.iCycles i ≫ Limits.factorThruImage (L.toCycles i j) = 0 := by
        rw [← cancel_mono (Limits.image.ι (L.toCycles i j) ≫ L.iCycles j), Category.assoc, hfac,
          L.iCycles_d, Limits.zero_comp]
      have w2 : Limits.image.ι (L.toCycles i j) ≫ L.homologyπ j = 0 := by
        rw [← cancel_epi (Limits.factorThruImage (L.toCycles i j)), Limits.image.fac_assoc,
          L.toCycles_comp_homologyπ, Limits.comp_zero]
      refine ⟨⟨w1, ?_⟩, ⟨w2, ?_⟩⟩
      · refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
        · exact ShortComplex.exact_of_f_is_kernel _
            (Limits.isKernelOfComp _ _ (L.cyclesIsKernel i j hnext) w1 hfac)
        · show Mono (L.iCycles i)
          infer_instance
        · show Epi (Limits.factorThruImage (L.toCycles i j))
          infer_instance
      · refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
        · exact ShortComplex.exact_of_g_is_cokernel _
            (Limits.isCokernelOfComp _ _ (L.homologyIsCokernel i j hprev) w2 (Limits.image.fac _))
        · show Mono (Limits.image.ι (L.toCycles i j))
          infer_instance
        · show Epi (L.homologyπ j)
          infer_instance

    have hacZ : ∀ X : C, Limits.IsZero X → ∀ k : ℕ, Limits.IsZero ((G.rightDerived (k + 1)).obj X) := by
      intro X hX k
      haveI : Injective X := hX.injective
      exact G.isZero_rightDerived_obj_injective_succ k X
    have hacInj : ∀ n : ℤ, ∀ k : ℕ, Limits.IsZero ((G.rightDerived (k + 1)).obj (L.X n)) := by
      intro n k
      haveI := hLi n
      exact G.isZero_rightDerived_obj_injective_succ k (L.X n)

    have stepB : ∀ i : ℤ, (∀ k : ℕ, Limits.IsZero ((G.rightDerived (k + 1)).obj (L.cycles i))) →
        ∀ k : ℕ, Limits.IsZero ((G.rightDerived (k + 1)).obj (Limits.image (L.toCycles i (i + 1)))) := by
      intro i hZ
      obtain ⟨⟨w₁, hS₁⟩, -⟩ := ses i (i + 1) rfl
      exact (pkg _ hS₁ hZ).2.1 (hacInj i)
    have hZall : ∀ n : ℤ, ∀ k : ℕ, Limits.IsZero ((G.rightDerived (k + 1)).obj (L.cycles n)) := by
      have base : ∀ n : ℤ, n < m₀ →
          ∀ k : ℕ, Limits.IsZero ((G.rightDerived (k + 1)).obj (L.cycles n)) := by
        intro n hn
        apply hacZ
        exact Limits.IsZero.of_mono (L.iCycles n) ((CochainComplex.isStrictlyGE_iff L m₀).mp hL n hn)
      have step : ∀ i : ℤ, (∀ k : ℕ, Limits.IsZero ((G.rightDerived (k + 1)).obj (L.cycles i))) →
          ∀ k : ℕ, Limits.IsZero ((G.rightDerived (k + 1)).obj (L.cycles (i + 1))) := by
        intro i hZ
        obtain ⟨-, ⟨w₂, hS₂⟩⟩ := ses i (i + 1) rfl
        exact (pkg _ hS₂ (stepB i hZ)).2.2 (hH (i + 1))
      intro n
      by_cases hn : n < m₀
      · exact base n hn
      · exact Int.leInduction (m := m₀ - 1)
          (motive := fun n _ => ∀ k : ℕ, Limits.IsZero ((G.rightDerived (k + 1)).obj (L.cycles n)))
          (base _ (by omega)) (fun n _ ih => step n ih) n (by omega)

    have hi : q - 1 + 1 = q := by omega
    obtain ⟨⟨w₁, hS₁⟩, ⟨w₂, hS₂⟩⟩ := ses (q - 1) q hi

    obtain ⟨φ, hφ⟩ : ∃ φ : G.obj (L.cycles q) ≅
        ((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj L).cycles q,
        φ.hom ≫ ((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj L).iCycles q =
          G.map (L.iCycles q) := by
      have h1 := Limits.KernelFork.mapIsLimit _
        (L.cyclesIsKernel q (q + 1) (CochainComplex.next ℤ q)) G
      have h2 := ((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj L).cyclesIsKernel q (q + 1)
        (CochainComplex.next ℤ q)
      refine ⟨Limits.IsLimit.conePointUniqueUpToIso h1 h2, ?_⟩
      have := Limits.IsLimit.conePointUniqueUpToIso_hom_comp h1 h2 Limits.WalkingParallelPair.zero
      simpa using this
    have hsq : G.map (L.toCycles (q - 1) q) ≫ φ.hom =
        ((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj L).toCycles (q - 1) q := by
      rw [← cancel_mono (((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj L).iCycles q),
        Category.assoc, hφ, ← G.map_comp, L.toCycles_i, HomologicalComplex.toCycles_i]
      all_goals rfl
    have hc := ((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj L).homologyIsCokernel (q - 1) q
      (CochainComplex.prev ℤ q)
    let e₁ : ((G.mapHomologicalComplex (ComplexShape.up ℤ)).obj L).homology q ≅
        Limits.cokernel (G.map (L.toCycles (q - 1) q)) :=
      Limits.IsColimit.coconePointUniqueUpToIso hc (Limits.cokernelIsCokernel _) ≪≫
        (Limits.cokernel.mapIso _ _ (Iso.refl _) φ
          (by rw [hsq, Iso.refl_hom, Category.id_comp])).symm
    have hfac : G.map (L.toCycles (q - 1) q) =
        G.map (Limits.factorThruImage (L.toCycles (q - 1) q)) ≫
          G.map (Limits.image.ι (L.toCycles (q - 1) q)) := by
      rw [← G.map_comp, Limits.image.fac]
    have hZ := hZall (q - 1)
    have hG1 := (pkg _ hS₁ hZ).1
    haveI hepi : Epi (G.map (Limits.factorThruImage (L.toCycles (q - 1) q))) := hG1.epi_g
    have hB : ∀ k : ℕ, Limits.IsZero ((G.rightDerived (k + 1)).obj
        (Limits.image (L.toCycles (q - 1) q))) := (pkg _ hS₁ hZ).2.1 (hacInj (q - 1))
    have hG2 := (pkg _ hS₂ hB).1
    let e₄ : Limits.cokernel (G.map (Limits.image.ι (L.toCycles (q - 1) q))) ≅
        G.obj (L.homology q) :=
      Limits.IsColimit.coconePointUniqueUpToIso (Limits.cokernelIsCokernel _) hG2.gIsCokernel
    exact ⟨e₁ ≪≫ Limits.cokernelIsoOfEq hfac ≪≫ Limits.cokernelEpiComp _ _ ≪≫ e₄⟩

  intro R _ _ S hS

  have hadd : ∀ (q : ℕ) {X Y : C} (a b : X ⟶ Y),
      (R.rightDerived q).map (a - b) = (R.rightDerived q).map a - (R.rightDerived q).map b := by
    intro q X Y a b
    have ha := InjectiveResolution.desc_commutes a (injectiveResolution Y) (injectiveResolution X)
    have hb := InjectiveResolution.desc_commutes b (injectiveResolution Y) (injectiveResolution X)
    have hab : (injectiveResolution X).ι ≫
        (InjectiveResolution.desc a (injectiveResolution Y) (injectiveResolution X) -
          InjectiveResolution.desc b (injectiveResolution Y) (injectiveResolution X)) =
        (CochainComplex.single₀ C).map (a - b) ≫ (injectiveResolution Y).ι := by
      rw [Preadditive.comp_sub, ha, hb, Functor.map_sub, Preadditive.sub_comp]
    rw [R.rightDerived_map_eq q (a - b) _ hab, R.rightDerived_map_eq q a _ ha,
      R.rightDerived_map_eq q b _ hb, Functor.map_sub, Preadditive.sub_comp,
      Preadditive.comp_sub]

  have hmono : Mono ((R.rightDerived 0).map S.f) := by
    have := hS.mono_f
    rw [← NatIso.naturality_2 R.rightDerivedZeroIsoSelf S.f]
    infer_instance
  refine ⟨hadd, hmono, ?_⟩

  have s3 : ∀ (I₁ : InjectiveResolution S.X₁) (I₃ : InjectiveResolution S.X₃), ∃ (σ : S.X₂ ⟶ I₁.cocomplex.X 0) (t : ∀ n : ℕ, I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)), S.f ≫ σ = I₁.ι.f 0 ∧ σ ≫ I₁.cocomplex.d 0 1 + S.g ≫ I₃.ι.f 0 ≫ t 0 = 0 ∧ ∀ n : ℕ, t n ≫ I₁.cocomplex.d (n + 1) (n + 2) + I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = 0 := by
    intro I₁ I₃
    have hmf : Mono S.f := hS.mono_f
    have heg : Epi S.g := hS.epi_g
    obtain ⟨ι₁, hι₁⟩ : ∃ ι₁ : S.X₁ ⟶ I₁.cocomplex.X 0, ι₁ = I₁.ι.f 0 := ⟨_, rfl⟩
    obtain ⟨ι₃, hι₃⟩ : ∃ ι₃ : S.X₃ ⟶ I₃.cocomplex.X 0, ι₃ = I₃.ι.f 0 := ⟨_, rfl⟩
    have hι₃m : Mono ι₃ := by subst hι₃; exact (inferInstance : Mono (I₃.ι.f 0))
    have hι₁d : ι₁ ≫ I₁.cocomplex.d 0 1 = 0 := by subst hι₁; exact I₁.ι_f_zero_comp_complex_d
    have ref₃ : ∀ {A : C} (x : A ⟶ I₃.cocomplex.X 0), x ≫ I₃.cocomplex.d 0 1 = 0 →
        ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₃), π ≫ x = y ≫ ι₃ := by
      subst hι₃
      intro A x hx
      exact I₃.exact₀.exact_up_to_refinements x hx
    let σ : S.X₂ ⟶ I₁.cocomplex.X 0 := Injective.factorThru ι₁ S.f
    have hσ : S.f ≫ σ = ι₁ := Injective.comp_factorThru _ _
    have hv : S.f ≫ (-(σ ≫ I₁.cocomplex.d 0 1)) = 0 := by
      rw [Preadditive.comp_neg, ← Category.assoc, hσ, hι₁d, neg_zero]
    let u : S.X₃ ⟶ I₁.cocomplex.X 1 := hS.exact.desc _ hv
    have hu : S.g ≫ u = -(σ ≫ I₁.cocomplex.d 0 1) := hS.exact.g_desc _ hv
    let t₀ : I₃.cocomplex.X 0 ⟶ I₁.cocomplex.X 1 := Injective.factorThru u ι₃
    have ht₀ : ι₃ ≫ t₀ = u := Injective.comp_factorThru _ _
    let Q : ∀ n : ℕ, (I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)) → Prop := fun n t =>
      ∀ (A : C) (y : A ⟶ I₃.cocomplex.X n), y ≫ I₃.cocomplex.d n (n + 1) = 0 →
        y ≫ t ≫ I₁.cocomplex.d (n + 1) (n + 2) = 0
    have hud : u ≫ I₁.cocomplex.d 1 2 = 0 := by
      apply (cancel_epi S.g).1
      rw [← Category.assoc, hu, Preadditive.neg_comp, Category.assoc,
        HomologicalComplex.d_comp_d, Limits.comp_zero, neg_zero, Limits.comp_zero]
    have h₀ : Q 0 t₀ := by
      intro A y hy
      obtain ⟨A', π, hπ, z, hz⟩ := ref₃ y hy
      have key : π ≫ y ≫ t₀ ≫ I₁.cocomplex.d 1 2 = 0 := by
        rw [← Category.assoc, hz, Category.assoc, ← Category.assoc ι₃, ht₀, hud,
          Limits.comp_zero]
      exact (cancel_epi π).1 (key.trans Limits.comp_zero.symm)
    have step : ∀ (n : ℕ) (t : I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)), Q n t →
        ∃ t' : I₃.cocomplex.X (n + 1) ⟶ I₁.cocomplex.X (n + 2),
          I₃.cocomplex.d n (n + 1) ≫ t' = -(t ≫ I₁.cocomplex.d (n + 1) (n + 2)) ∧
            Q (n + 1) t' := by
      intro n t ht
      let E := ShortComplex.mk (Limits.kernel.ι (I₃.cocomplex.d n (n + 1)))
        (I₃.cocomplex.d n (n + 1)) (Limits.kernel.condition _)
      have hE : E.Exact := E.exact_of_f_is_kernel (Limits.kernelIsKernel _)
      have hf : E.f ≫ (-(t ≫ I₁.cocomplex.d (n + 1) (n + 2))) = 0 := by
        rw [Preadditive.comp_neg, ht _ _ (Limits.kernel.condition _), neg_zero]
      have hdesc : I₃.cocomplex.d n (n + 1) ≫ hE.descToInjective _ hf =
          -(t ≫ I₁.cocomplex.d (n + 1) (n + 2)) := hE.comp_descToInjective _ hf
      refine ⟨hE.descToInjective _ hf, hdesc, ?_⟩
      intro A y hy
      have ref : ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (z : A' ⟶ I₃.cocomplex.X n),
          π ≫ y = z ≫ I₃.cocomplex.d n (n + 1) :=
        (I₃.exact_succ n).exact_up_to_refinements y hy
      obtain ⟨A', π, hπ, z, hz⟩ := ref
      have key : π ≫ y ≫ hE.descToInjective _ hf ≫ I₁.cocomplex.d (n + 2) (n + 3) = 0 := by
        rw [← Category.assoc, hz, Category.assoc, ← Category.assoc (I₃.cocomplex.d n (n + 1)),
          hdesc, Preadditive.neg_comp, Category.assoc, HomologicalComplex.d_comp_d,
          Limits.comp_zero, neg_zero, Limits.comp_zero]
      exact (cancel_epi π).1 (key.trans Limits.comp_zero.symm)
    choose F hF using step
    let T : ∀ n, {t : I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1) // Q n t} := fun n =>
      Nat.rec (motive := fun n => {t : I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1) // Q n t})
        ⟨t₀, h₀⟩ (fun n T => ⟨F n T.1 T.2, (hF n T.1 T.2).2⟩) n
    refine ⟨σ, fun n => (T n).1, hσ.trans hι₁, ?_, ?_⟩
    · show σ ≫ I₁.cocomplex.d 0 1 + S.g ≫ I₃.ι.f 0 ≫ t₀ = 0
      rw [← hι₃, ht₀, hu, add_neg_cancel]
    · intro n
      show (T n).1 ≫ I₁.cocomplex.d (n + 1) (n + 2) +
        I₃.cocomplex.d n (n + 1) ≫ F n (T n).1 (T n).2 = 0
      rw [(hF n (T n).1 (T n).2).1, add_neg_cancel]

  have s4 : ∀ (I₁ : InjectiveResolution S.X₁) (I₃ : InjectiveResolution S.X₃) (σ : S.X₂ ⟶ I₁.cocomplex.X 0) (t : ∀ n : ℕ, I₃.cocomplex.X n ⟶ I₁.cocomplex.X (n + 1)), S.f ≫ σ = I₁.ι.f 0 → σ ≫ I₁.cocomplex.d 0 1 + S.g ≫ I₃.ι.f 0 ≫ t 0 = 0 → (∀ n : ℕ, t n ≫ I₁.cocomplex.d (n + 1) (n + 2) + I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = 0) → ∃ (K : CochainComplex C ℕ) (i : I₁.cocomplex ⟶ K) (p : K ⟶ I₃.cocomplex) (e : (CochainComplex.single₀ C).obj S.X₂ ⟶ K), (∀ n, Injective (K.X n)) ∧ I₁.ι ≫ i = (CochainComplex.single₀ C).map S.f ≫ e ∧ e ≫ p = (CochainComplex.single₀ C).map S.g ≫ I₃.ι ∧ ∀ n : ℕ, ∃ h : i.f n ≫ p.f n = 0, Nonempty (ShortComplex.mk (i.f n) (p.f n) h).Splitting := by
    intro I₁ I₃ σ t H1 H2 H3
    let X : ℕ → C := fun n => I₁.cocomplex.X n ⊞ I₃.cocomplex.X n
    let d : ∀ n, X n ⟶ X (n + 1) := fun n =>
      Limits.biprod.lift (Limits.biprod.fst ≫ I₁.cocomplex.d n (n + 1) + Limits.biprod.snd ≫ t n)
        (Limits.biprod.snd ≫ I₃.cocomplex.d n (n + 1))
    have sq : ∀ n, d n ≫ d (n + 1) = 0 := by
      intro n
      have h3 : t n ≫ I₁.cocomplex.d (n + 1) (n + 1 + 1) +
          I₃.cocomplex.d n (n + 1) ≫ t (n + 1) = 0 := H3 n
      apply Limits.biprod.hom_ext
      · simp only [d, Category.assoc, Limits.biprod.lift_fst, Preadditive.comp_add,
          Preadditive.add_comp, Limits.biprod.lift_fst_assoc, Limits.biprod.lift_snd_assoc,
          HomologicalComplex.d_comp_d, Limits.comp_zero, zero_add, Limits.zero_comp]
        rw [← Preadditive.comp_add, h3, Limits.comp_zero]
      · simp only [d, Category.assoc, Limits.biprod.lift_snd, Limits.biprod.lift_snd_assoc,
          HomologicalComplex.d_comp_d, Limits.comp_zero, Limits.zero_comp]
    let K : CochainComplex C ℕ := CochainComplex.of X d sq
    have hKd : ∀ n, K.d n (n + 1) = d n := fun n => CochainComplex.of_d X d n
    let i : I₁.cocomplex ⟶ K :=
      { f := fun n => (Limits.biprod.inl : I₁.cocomplex.X n ⟶ X n)
        comm' := by
          rintro n m rfl
          rw [hKd]
          apply Limits.biprod.hom_ext <;> simp [d] }
    let p : K ⟶ I₃.cocomplex :=
      { f := fun n => (Limits.biprod.snd : X n ⟶ I₃.cocomplex.X n)
        comm' := by
          rintro n m rfl
          rw [hKd]
          simp [d] }
    have hz : (Limits.biprod.lift σ (S.g ≫ I₃.ι.f 0) : S.X₂ ⟶ X 0) ≫ K.d 0 1 = 0 := by
      have hK0 : K.d 0 1 = d 0 := hKd 0
      rw [hK0]
      apply Limits.biprod.hom_ext
      · simp only [d, Category.assoc, Limits.biprod.lift_fst, Limits.biprod.lift_fst_assoc,
          Preadditive.comp_add, Limits.biprod.lift_snd_assoc, Limits.zero_comp]
        refine Eq.trans ?_ H2
        congr 1
        exact Category.assoc _ _ _
      · simp only [d, Category.assoc, Limits.biprod.lift_snd, Limits.biprod.lift_snd_assoc,
          Limits.zero_comp]
        exact (Category.assoc _ _ _).trans
          ((congrArg (S.g ≫ ·) I₃.ι_f_zero_comp_complex_d).trans Limits.comp_zero)
    refine ⟨K, i, p, (K.fromSingle₀Equiv S.X₂).symm ⟨Limits.biprod.lift σ (S.g ≫ I₃.ι.f 0), hz⟩,
      fun n => ?_, ?_, ?_, fun n => ?_⟩
    · show Injective (I₁.cocomplex.X n ⊞ I₃.cocomplex.X n)
      infer_instance
    · apply HomologicalComplex.from_single_hom_ext
      rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero,
        CochainComplex.fromSingle₀Equiv_symm_apply_f_zero]
      apply Limits.biprod.hom_ext
      · simp [i, H1]
        exact (Category.assoc _ _ _).trans
          ((congrArg (I₁.ι.f 0 ≫ ·) Limits.biprod.inl_fst).trans (Category.comp_id _))
      · simp [i]
        refine ((Category.assoc _ _ _).trans
          ((congrArg (I₁.ι.f 0 ≫ ·) Limits.biprod.inl_snd).trans Limits.comp_zero)).trans ?_
        refine Eq.symm (Eq.trans (Category.assoc S.f S.g (I₃.ι.f 0)).symm ?_)
        exact (congrArg (· ≫ I₃.ι.f 0) S.zero).trans Limits.zero_comp
    · apply HomologicalComplex.from_single_hom_ext
      rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero,
        CochainComplex.fromSingle₀Equiv_symm_apply_f_zero]
      simp [p]
    · refine ⟨Limits.biprod.inl_snd, ⟨?_⟩⟩
      exact ShortComplex.Splitting.mk Limits.biprod.fst Limits.biprod.inr Limits.biprod.inl_fst
        Limits.biprod.inr_snd Limits.biprod.total

  have s5 : ∀ (I₁ : InjectiveResolution S.X₁) (I₃ : InjectiveResolution S.X₃) (K : CochainComplex C ℕ) (i : I₁.cocomplex ⟶ K) (p : K ⟶ I₃.cocomplex) (e : (CochainComplex.single₀ C).obj S.X₂ ⟶ K), I₁.ι ≫ i = (CochainComplex.single₀ C).map S.f ≫ e → e ≫ p = (CochainComplex.single₀ C).map S.g ≫ I₃.ι → (∀ n : ℕ, ∃ h : i.f n ≫ p.f n = 0, (ShortComplex.mk (i.f n) (p.f n) h).ShortExact) → QuasiIso e := by
    intro I₁ I₃ K i p e hi hp hses
    have heg : Epi S.g := hS.epi_g
    have hip : i ≫ p = 0 := by
      ext n
      obtain ⟨h, -⟩ := hses n
      rw [HomologicalComplex.comp_f, HomologicalComplex.zero_f]
      exact h
    let T := ShortComplex.mk i p hip
    have hT : T.ShortExact := by
      apply HomologicalComplex.shortExact_of_degreewise_shortExact
      intro n
      obtain ⟨h, hn⟩ := hses n
      exact ShortComplex.shortExact_of_iso
        (ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp [T]) (by simp [T])) hn
    rw [quasiIso_iff]
    intro n
    cases n with
    | succ n =>
      rw [quasiIsoAt_iff_exactAt e (n + 1) (CochainComplex.exactAt_succ_single_obj S.X₂ n),
        HomologicalComplex.exactAt_iff_isZero_homology]
      have hex := hT.homology_exact₂ (n + 1)
      have h1 : Limits.IsZero (I₁.cocomplex.homology (n + 1)) :=
        (I₁.cocomplex_exactAt_succ n).isZero_homology
      have h3 : Limits.IsZero (I₃.cocomplex.homology (n + 1)) :=
        (I₃.cocomplex_exactAt_succ n).isZero_homology
      exact hex.isZero_of_both_zeros (h1.eq_of_src _ _) (h3.eq_of_tgt _ _)
    | zero =>
      obtain ⟨ι₁, hι₁⟩ : ∃ ι₁ : S.X₁ ⟶ I₁.cocomplex.X 0, ι₁ = I₁.ι.f 0 := ⟨_, rfl⟩
      obtain ⟨ι₃, hι₃⟩ : ∃ ι₃ : S.X₃ ⟶ I₃.cocomplex.X 0, ι₃ = I₃.ι.f 0 := ⟨_, rfl⟩
      obtain ⟨e0, he0⟩ : ∃ e0 : S.X₂ ⟶ K.X 0, e0 = e.f 0 := ⟨_, rfl⟩
      have hι₁m : Mono ι₁ := by subst hι₁; exact (inferInstance : Mono (I₁.ι.f 0))
      have hι₃m : Mono ι₃ := by subst hι₃; exact (inferInstance : Mono (I₃.ι.f 0))
      have ref₁ : ∀ {A : C} (x : A ⟶ I₁.cocomplex.X 0), x ≫ I₁.cocomplex.d 0 1 = 0 →
          ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₁), π ≫ x = y ≫ ι₁ := by
        subst hι₁
        intro A x hx
        exact I₁.exact₀.exact_up_to_refinements x hx
      have ref₃ : ∀ {A : C} (x : A ⟶ I₃.cocomplex.X 0), x ≫ I₃.cocomplex.d 0 1 = 0 →
          ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₃), π ≫ x = y ≫ ι₃ := by
        subst hι₃
        intro A x hx
        exact I₃.exact₀.exact_up_to_refinements x hx
      have hi0 : Mono (i.f 0) := (hses 0).choose_spec.mono_f
      have hi1 : Mono (i.f 1) := (hses 1).choose_spec.mono_f
      have F1 : S.f ≫ e0 = ι₁ ≫ i.f 0 := by
        have := congrArg (fun φ => HomologicalComplex.Hom.f φ 0) hi
        simp only [HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero] at this
        subst hι₁ he0
        exact this.symm
      have F2 : e0 ≫ p.f 0 = S.g ≫ ι₃ := by
        have := congrArg (fun φ => HomologicalComplex.Hom.f φ 0) hp
        simp only [HomologicalComplex.comp_f, CochainComplex.single₀_map_f_zero] at this
        subst hι₃ he0
        exact this
      have F3 : e0 ≫ K.d 0 1 = 0 := by
        subst he0
        have hd : ((CochainComplex.single₀ C).obj S.X₂).d 0 1 = 0 := rfl
        exact (e.comm 0 1).trans ((congrArg (· ≫ e.f 1) hd).trans Limits.zero_comp)
      have F4 : i.f 0 ≫ K.d 0 1 = I₁.cocomplex.d 0 1 ≫ i.f 1 := i.comm 0 1
      have F5 : K.d 0 1 ≫ p.f 1 = p.f 0 ≫ I₃.cocomplex.d 0 1 := (p.comm 0 1).symm
      have hmono' : Mono e0 := by
        apply Preadditive.mono_of_cancel_zero
        intro A x hx
        have h1 : x ≫ S.g = 0 := by
          apply (cancel_mono ι₃).1
          rw [Category.assoc, ← F2, ← Category.assoc, hx, Limits.zero_comp, Limits.zero_comp]
        have ref : ∃ (A' : C) (π : A' ⟶ A) (_ : Epi π) (y : A' ⟶ S.X₁), π ≫ x = y ≫ S.f :=
          hS.exact.exact_up_to_refinements x h1
        obtain ⟨A', π, hπ, y, hy⟩ := ref
        have h2 : y ≫ (ι₁ ≫ i.f 0) = 0 := by
          rw [← F1, ← Category.assoc, ← hy, Category.assoc, hx, Limits.comp_zero]
        have h3 : y = 0 := by
          apply (cancel_mono (ι₁ ≫ i.f 0)).1
          rw [h2, Limits.zero_comp]
        apply (cancel_epi π).1
        rw [hy, h3, Limits.zero_comp, Limits.comp_zero]
      have hexact : (ShortComplex.mk e0 (K.d 0 1) F3).Exact := by
        rw [ShortComplex.exact_iff_exact_up_to_refinements]
        intro A x hx
        have hx' : x ≫ K.d 0 1 = 0 := hx
        have s1 : (x ≫ p.f 0) ≫ I₃.cocomplex.d 0 1 = 0 := by
          rw [Category.assoc, ← F5, ← Category.assoc, hx', Limits.zero_comp]
        obtain ⟨A₁, π₁, hπ₁, y₃, hy₃⟩ := ref₃ (x ≫ p.f 0) s1
        obtain ⟨A₂, π₂, hπ₂, y₂, hy₂⟩ := surjective_up_to_refinements_of_epi S.g y₃
        have s3' : (π₂ ≫ π₁ ≫ x - y₂ ≫ e0) ≫ p.f 0 = 0 := by
          have e1 : (π₂ ≫ π₁ ≫ x) ≫ p.f 0 = y₂ ≫ S.g ≫ ι₃ := by
            rw [Category.assoc, Category.assoc, hy₃, ← Category.assoc, hy₂, Category.assoc]
          have e2 : (y₂ ≫ e0) ≫ p.f 0 = y₂ ≫ S.g ≫ ι₃ := by
            rw [Category.assoc, F2]
          rw [Preadditive.sub_comp, e1, e2, sub_self]
        obtain ⟨h0, hs0⟩ := hses 0
        have ref : ∃ (A' : C) (π : A' ⟶ A₂) (_ : Epi π) (z : A' ⟶ I₁.cocomplex.X 0),
            π ≫ (π₂ ≫ π₁ ≫ x - y₂ ≫ e0) = z ≫ i.f 0 :=
          hs0.exact.exact_up_to_refinements _ s3'
        obtain ⟨A₃, π₃, hπ₃, z, hz⟩ := ref
        have s4' : (π₂ ≫ π₁ ≫ x - y₂ ≫ e0) ≫ K.d 0 1 = 0 := by
          simp only [Preadditive.sub_comp, Category.assoc, hx', F3, Limits.comp_zero, sub_self]
        have s4'' : z ≫ I₁.cocomplex.d 0 1 = 0 := by
          apply (cancel_mono (i.f 1)).1
          have : (z ≫ i.f 0) ≫ K.d 0 1 = 0 := by
            rw [← hz, Category.assoc, s4', Limits.comp_zero]
          rw [Limits.zero_comp, Category.assoc, ← F4, ← Category.assoc, this]
        obtain ⟨A₄, π₄, hπ₄, w, hw⟩ := ref₁ z s4''
        have k1 : π₃ ≫ π₂ ≫ π₁ ≫ x = π₃ ≫ y₂ ≫ e0 + z ≫ i.f 0 := by
          rw [← hz, Preadditive.comp_sub]
          abel
        refine ⟨A₄, π₄ ≫ π₃ ≫ π₂ ≫ π₁, inferInstance, π₄ ≫ π₃ ≫ y₂ + w ≫ S.f, ?_⟩
        show (π₄ ≫ π₃ ≫ π₂ ≫ π₁) ≫ x = (π₄ ≫ π₃ ≫ y₂ + w ≫ S.f) ≫ e0
        simp only [Category.assoc, Preadditive.add_comp]
        rw [k1, Preadditive.comp_add, ← Category.assoc π₄ z, hw, Category.assoc, ← F1]
      rw [CochainComplex.quasiIsoAt₀_iff]
      subst he0
      refine (ShortComplex.quasiIso_iff_of_zeros _ ?_ ?_ ?_).2 ⟨hexact, hmono'⟩
      · exact ((CochainComplex.single₀ C).obj S.X₂).shape 0 0 (by simp)
      · rfl
      · exact K.shape 0 0 (by simp)

  have s6 : ∀ (I₁ : InjectiveResolution S.X₁) (I₂ : InjectiveResolution S.X₂) (I₃ : InjectiveResolution S.X₃) (i : I₁.cocomplex ⟶ I₂.cocomplex) (p : I₂.cocomplex ⟶ I₃.cocomplex), I₁.ι ≫ i = (CochainComplex.single₀ C).map S.f ≫ I₂.ι → I₂.ι ≫ p = (CochainComplex.single₀ C).map S.g ≫ I₃.ι → (∀ n : ℕ, ∃ h : i.f n ≫ p.f n = 0, Nonempty (ShortComplex.mk (i.f n) (p.f n) h).Splitting) → ∀ q : ℕ, (∃ h0 : (R.rightDerived q).map S.f ≫ (R.rightDerived q).map S.g = 0, (ShortComplex.mk _ _ h0).Exact) ∧ ∃ (δ : (R.rightDerived q).obj S.X₃ ⟶ (R.rightDerived (q + 1)).obj S.X₁) (h1 : (R.rightDerived q).map S.g ≫ δ = 0) (h2 : δ ≫ (R.rightDerived (q + 1)).map S.f = 0), (ShortComplex.mk _ _ h1).Exact ∧ (ShortComplex.mk _ _ h2).Exact := by
    intro I₁ I₂ I₃ i p hi hp hspl q
    have hip : i ≫ p = 0 := by
      ext n
      obtain ⟨h, -⟩ := hspl n
      rw [HomologicalComplex.comp_f, HomologicalComplex.zero_f]
      exact h
    have hz : (R.mapHomologicalComplex (ComplexShape.up ℕ)).map i ≫
        (R.mapHomologicalComplex (ComplexShape.up ℕ)).map p = 0 := by
      rw [← Functor.map_comp, hip, Functor.map_zero]
    let S' := ShortComplex.mk _ _ hz
    have hS' : S'.ShortExact := by
      apply HomologicalComplex.shortExact_of_degreewise_shortExact
      intro n
      obtain ⟨h, ⟨spl⟩⟩ := hspl n
      exact ShortComplex.shortExact_of_iso
        (ShortComplex.isoMk (Iso.refl _) (Iso.refl _) (Iso.refl _) (by simp [S']) (by simp [S']))
        (spl.map R).shortExact
    let α₁ : ∀ k, (R.rightDerived k).obj S.X₁ ≅ S'.X₁.homology k :=
      fun k => I₁.isoRightDerivedObj R k
    let α₂ : ∀ k, (R.rightDerived k).obj S.X₂ ≅ S'.X₂.homology k :=
      fun k => I₂.isoRightDerivedObj R k
    let α₃ : ∀ k, (R.rightDerived k).obj S.X₃ ≅ S'.X₃.homology k :=
      fun k => I₃.isoRightDerivedObj R k
    have C1 : ∀ k, (α₁ k).hom ≫ HomologicalComplex.homologyMap S'.f k =
        (R.rightDerived k).map S.f ≫ (α₂ k).hom := by
      intro k
      show (I₁.isoRightDerivedObj R k).hom ≫ _ = _ ≫ (I₂.isoRightDerivedObj R k).hom
      rw [R.rightDerived_map_eq k S.f i hi, Category.assoc, Category.assoc, Iso.inv_hom_id,
        Category.comp_id]
      rfl
    have C2 : ∀ k, (α₂ k).hom ≫ HomologicalComplex.homologyMap S'.g k =
        (R.rightDerived k).map S.g ≫ (α₃ k).hom := by
      intro k
      show (I₂.isoRightDerivedObj R k).hom ≫ _ = _ ≫ (I₃.isoRightDerivedObj R k).hom
      rw [R.rightDerived_map_eq k S.g p hp, Category.assoc, Category.assoc, Iso.inv_hom_id,
        Category.comp_id]
      rfl
    have hrel : (ComplexShape.up ℕ).Rel q (q + 1) := rfl
    have h0 : (R.rightDerived q).map S.f ≫ (R.rightDerived q).map S.g = 0 := by
      rw [← cancel_mono (α₃ q).hom, Category.assoc, ← C2, ← Category.assoc,
        ← C1, Category.assoc, ← HomologicalComplex.homologyMap_comp, S'.zero,
        HomologicalComplex.homologyMap_zero, Limits.comp_zero, Limits.zero_comp]
    let δ : (R.rightDerived q).obj S.X₃ ⟶ (R.rightDerived (q + 1)).obj S.X₁ :=
      (α₃ q).hom ≫ hS'.δ q (q + 1) hrel ≫ (α₁ (q + 1)).inv
    have Cδ : (α₃ q).hom ≫ hS'.δ q (q + 1) hrel = δ ≫ (α₁ (q + 1)).hom := by
      simp only [δ, Category.assoc, Iso.inv_hom_id, Category.comp_id]
    have h1 : (R.rightDerived q).map S.g ≫ δ = 0 := by
      rw [← cancel_mono (α₁ (q + 1)).hom, Category.assoc, ← Cδ,
        ← Category.assoc, ← C2, Category.assoc, hS'.comp_δ, Limits.comp_zero, Limits.zero_comp]
    have h2 : δ ≫ (R.rightDerived (q + 1)).map S.f = 0 := by
      rw [← cancel_mono (α₂ (q + 1)).hom, Category.assoc, ← C1,
        ← Category.assoc, ← Cδ, Category.assoc, hS'.δ_comp, Limits.comp_zero, Limits.zero_comp]
    refine ⟨⟨h0, ?_⟩, δ, h1, h2, ?_, ?_⟩
    · exact ShortComplex.exact_of_iso
        (ShortComplex.isoMk (α₁ q) (α₂ q) (α₃ q) (C1 q) (C2 q)).symm (hS'.homology_exact₂ q)
    · exact ShortComplex.exact_of_iso
        (ShortComplex.isoMk (α₂ q) (α₃ q) (α₁ (q + 1)) (C2 q) Cδ).symm
        (hS'.homology_exact₃ q (q + 1) hrel)
    · exact ShortComplex.exact_of_iso
        (ShortComplex.isoMk (α₃ q) (α₁ (q + 1)) (α₂ (q + 1)) Cδ (C1 (q + 1))).symm
        (hS'.homology_exact₁ q (q + 1) hrel)

  obtain ⟨σ, t, H1, H2, H3⟩ := s3 (injectiveResolution S.X₁) (injectiveResolution S.X₃)
  obtain ⟨K, i, p, e, hK, hi, hp, hspl⟩ := s4 _ _ σ t H1 H2 H3
  have he : QuasiIso e := s5 _ _ K i p e hi hp (fun n => by
    obtain ⟨h, ⟨spl⟩⟩ := hspl n
    exact ⟨h, spl.shortExact⟩)
  let I₂ : InjectiveResolution S.X₂ :=
    { cocomplex := K, injective := hK, ι := e, quasiIso := he }
  exact s6 _ I₂ _ i p hi hp hspl

theorem wc_tq_closed_push_inj_classical {S Z : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    (m : ℕ) (hm : 0 < m) (Di : wcZModPullData i m) (hDi : wcZModPullCanonical Di)
    (J : CochainComplex (SheafOfModules.{u+1} (wcZModRingSheaf Z m)) ℤ) (m₀ : ℤ)
    (hJ : J.IsStrictlyGE m₀) (hJi : ∀ k, Injective (J.X k))
    (hJcl : ∀ r : ℤ, wcZModClassicalMod Z m (J.homology r)) (q : ℤ) :
    haveI := Di.additive
    let Pi := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ
    haveI : Pi.Additive := Adjunction.right_adjoint_additive Di.adj
    wcZModClassicalMod S m (((Pi.mapHomologicalComplex (ComplexShape.up ℤ)).obj J).homology q) :=
by
  intro Pi
  haveI := Di.additive
  haveI : Pi.Additive := Adjunction.right_adjoint_additive Di.adj

  haveI hPiL : Limits.PreservesFiniteLimits Pi := by
    haveI := Di.adj.rightAdjoint_preservesLimits.{0, 0}
    exact Limits.PreservesLimitsOfSize.preservesFiniteLimits.{0, 0} Pi
  haveI := sheafOfModules_enoughInjectives (Scheme.ProEt.topology Z) (wcZModRingSheaf Z m)
  haveI := wc_et_enough_injectives Z
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology Z)
    (wcZModRingSheaf Z m)
  haveI := sheafOfModules_toSheaf_preservesFiniteColimits (Scheme.ProEt.topology S)
    (wcZModRingSheaf S m)
  haveI : Limits.PreservesFiniteColimits (wcEtPush i) := wc_et_finite_push_exact i
  obtain ⟨hz0, hzl, hzc⟩ := wc_epsInv_exact Z
  obtain ⟨hs0, hsl, hsc⟩ := wc_epsInv_exact S
  haveI := hz0
  haveI := hzl
  haveI := hzc
  haveI := hs0
  haveI := hsl
  haveI := hsc
  haveI : (wcEpsInv Z).Additive := Functor.additive_of_preserves_binary_products _
  haveI : (wcEpsInv S).Additive := Functor.additive_of_preserves_binary_products _

  have hα : Nonempty (Pi ⋙ SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m) ≅
      SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Z m) ⋙ wcProEtPush i) :=
    ⟨(Functor.rightUnitor _).symm ≪≫ Functor.isoWhiskerLeft _
      (sheafificationNatIso (Scheme.ProEt.topology S) AddCommGrpCat.{u+1})⟩

  have hacycU : ∀ (I : SheafOfModules.{u+1} (wcZModRingSheaf Z m)) [Injective I] (n : ℕ),
      Limits.IsZero (((wcProEtPush i).rightDerived (n + 1)).obj
        ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Z m)).obj I)) := by
    intro I _ n
    apply wc_proet_push_rightDerived_zero_of_local
    intro U
    refine GrothendieckTopology.superset_covering _ ?_ (GrothendieckTopology.top_mem _ U)
    intro T f _
    exact Sieve.le_generate _ _ f (fun e => wc_tq_zmod_inj_free_ext_vanish Z m hm _ I n e)
  have s3 := wc_rightDerived_exact_conj_iso Pi (wcProEtPush i)
    (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf Z m))
    (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m)) hα hacycU

  obtain ⟨β⟩ := wc_epsInv_push_base_change i
  have hacycE : ∀ (I : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) [Injective I]
      (n : ℕ), Limits.IsZero (((wcProEtPush i).rightDerived (n + 1)).obj ((wcEpsInv Z).obj I)) := by
    intro I _ n
    apply wc_proet_push_rightDerived_zero_of_local
    intro U
    refine GrothendieckTopology.superset_covering _ ?_ (wc_proet_affIndEt_covering S U)
    apply Sieve.generate_mono
    rintro T f ⟨A, hA, hT⟩
    exact fun e => wc_proet_push_epsInv_injective_affine_vanishing i A hA T hT I n e
  have s5 := wc_rightDerived_exact_conj_iso (wcEtPush i) (wcProEtPush i) (wcEpsInv Z)
    (wcEpsInv S) ⟨β⟩ hacycE

  have s4 : ∀ (H : Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}) (k : ℕ),
      Limits.IsZero (((wcEtPush i).rightDerived (k + 1)).obj H) := by
    intro H k
    let I := injectiveResolution H
    haveI : (wcEtPush i).PreservesHomology := (wcEtPush i).preservesHomologyOfExact
    refine Limits.IsZero.of_iso ?_ (I.isoRightDerivedObj (wcEtPush i) (k + 1))
    have h1 : Limits.IsZero (I.cocomplex.homology (k + 1)) :=
      (HomologicalComplex.exactAt_iff_isZero_homology _ _).mp (I.cocomplex_exactAt_succ k)
    exact Limits.IsZero.of_iso ((wcEtPush i).map_isZero h1)
      ((I.cocomplex.sc (k + 1)).mapHomologyIso (wcEtPush i))

  have s6 : ∀ M : SheafOfModules.{u+1} (wcZModRingSheaf Z m), wcZModClassicalMod Z m M →
      ∀ k : ℕ, Limits.IsZero ((Pi.rightDerived (k + 1)).obj M) := by
    intro M hM k
    obtain ⟨H, -, ⟨eH⟩⟩ := hM
    obtain ⟨e2⟩ := s3 M (k + 1)
    obtain ⟨e4⟩ := s5 H (k + 1)
    have z' : Limits.IsZero ((wcEpsInv S).obj (((wcEtPush i).rightDerived (k + 1)).obj H)) :=
      (wcEpsInv S).map_isZero (s4 H k)
    have zU : Limits.IsZero ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m)).obj
        ((Pi.rightDerived (k + 1)).obj M)) :=
      z'.of_iso (e2.symm ≪≫ ((wcProEtPush i).rightDerived (k + 1)).mapIso eH ≪≫ e4)
    rw [Limits.IsZero.iff_id_eq_zero]
    apply (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m)).zero_of_map_zero
    rw [CategoryTheory.Functor.map_id]
    exact (Limits.IsZero.iff_id_eq_zero _).mp zU

  have s7 : ∀ M : SheafOfModules.{u+1} (wcZModRingSheaf Z m), wcZModClassicalMod Z m M →
      wcZModClassicalMod S m (Pi.obj M) := by
    intro M hM
    obtain ⟨H, hHm, ⟨eH⟩⟩ := hM
    obtain ⟨α⟩ := hα
    refine ⟨(wcEtPush i).obj H, ?_, ⟨α.app M ≪≫ (wcProEtPush i).mapIso eH ≪≫ (β.app H).symm⟩⟩
    rw [← (wcEtPush i).map_id, ← CategoryTheory.Functor.map_nsmul, hHm, CategoryTheory.Functor.map_zero]

  have hacyc : ∀ (r : ℤ) (k : ℕ), Limits.IsZero ((Pi.rightDerived (k + 1)).obj (J.homology r)) :=
    fun r k => s6 _ (hJcl r) k
  obtain ⟨c⟩ := wc_tq_inj_complex_homology_collapse Pi J m₀ hJ hJi hacyc q
  obtain ⟨H, h, ⟨e⟩⟩ := s7 _ (hJcl q)
  exact ⟨H, h, ⟨(SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m)).mapIso c ≪≫ e⟩⟩

theorem wc_tq_pull_classical {S S' : Scheme.{u}} (f : S' ⟶ S) (m : ℕ) (D : wcZModPullData f m)
    (hD : wcZModPullCanonical D) (M : SheafOfModules.{u+1} (wcZModRingSheaf S m))
    (hM : wcZModClassicalMod S m M) : wcZModClassicalMod S' m (D.Φ.obj M) :=
by
  classical
  obtain ⟨H, hHm, ⟨e⟩⟩ := hM
  haveI := D.cont
  obtain ⟨ι⟩ := wc_zmod_pull_data_toSheaf_iso D hD
  haveI hcS : (wcEtToProEt S).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.ProEt.topology S) := (wc_etToProEt_flat_cont S).2
  haveI hcS' : (wcEtToProEt S').IsContinuous (Scheme.smallEtaleTopology S')
      (Scheme.ProEt.topology S') := (wc_etToProEt_flat_cont S').2
  haveI hcB : (wcEtBaseChange f).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.smallEtaleTopology S') := wc_et_basechange_isContinuous f
  haveI hadd : (wcEtInv f).Additive := (wc_etInv_exact f).1
  haveI hc1 : (wcEtToProEt S ⋙ wcProEtBC f).IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.ProEt.topology S') :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology S) _
  haveI hc2 : (wcEtBaseChange f ⋙ wcEtToProEt S').IsContinuous (Scheme.smallEtaleTopology S)
      (Scheme.ProEt.topology S') :=
    Functor.isContinuous_comp _ _ _ (Scheme.smallEtaleTopology S') _

  have α : wcEtToProEt S ⋙ wcProEtBC f ≅ wcEtBaseChange f ⋙ wcEtToProEt S' := by
    first
      | exact Iso.refl _
      | exact NatIso.ofComponents (fun V => Iso.refl _) (by intros; rfl)
      | exact NatIso.ofComponents (fun V => Iso.refl _)

  have aS : wcEpsInv S ⊣ (wcEtToProEt S).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S) :=
    Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt S)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)
  have aS' : wcEpsInv S' ⊣ (wcEtToProEt S').sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology S') (Scheme.ProEt.topology S') :=
    Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt S')
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S') (Scheme.ProEt.topology S')
  have b : wcEtInv f ⊣ (wcEtBaseChange f).sheafPushforwardContinuous AddCommGrpCat.{u+1}
      (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S') :=
    Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtBaseChange f)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')
  have c := (wcProEtBC f).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')
  have adj₁ := aS.comp c
  have adj₂ := b.comp aS'
  have ρ : (wcProEtBC f).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') ⋙
        (wcEtToProEt S).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S) ≅
      (wcEtToProEt S').sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology S') (Scheme.ProEt.topology S') ⋙
        (wcEtBaseChange f).sheafPushforwardContinuous AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S') :=
    Functor.sheafPushforwardContinuousComp (wcEtToProEt S) (wcProEtBC f) AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S) (Scheme.ProEt.topology S') ≪≫
      Functor.sheafPushforwardContinuousIso α AddCommGrpCat.{u+1}
        (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S') ≪≫
      (Functor.sheafPushforwardContinuousComp (wcEtBaseChange f) (wcEtToProEt S')
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.smallEtaleTopology S')
        (Scheme.ProEt.topology S')).symm
  have κ := Adjunction.leftAdjointUniq (adj₁.ofNatIsoRight ρ) adj₂

  have htors : m • 𝟙 ((wcEtInv f).obj H) = 0 := by
    have h1 : (wcEtInv f).map (m • 𝟙 H) = m • 𝟙 ((wcEtInv f).obj H) := by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    rw [← h1, hHm, Functor.map_zero]

  exact ⟨(wcEtInv f).obj H, htors,
    ⟨ι.app M ≪≫ ((wcProEtBC f).sheafPullback AddCommGrpCat.{u+1}
      (Scheme.ProEt.topology S) (Scheme.ProEt.topology S')).mapIso e ≪≫ κ.app H⟩⟩

theorem wc_tq_cone_classical {S Z E : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    (g : E ⟶ S) [IsAffineHom g] (m : ℕ) (hm : 0 < m)
    (Dg : wcZModPullData g m) (hDg : wcZModPullCanonical Dg)
    (Di : wcZModPullData i m) (hDi : wcZModPullCanonical Di)
    (I : InjectiveResolution (SheafOfModules.unit (wcZModRingSheaf E m))) :
    haveI := Dg.additive
    haveI := Di.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC g) _ _ Dg.cont Dg.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dg.adj
    let Pi := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ
    haveI : Pi.Additive := Adjunction.right_adjoint_additive Di.adj
    let K := (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex
    ∀ (J : CochainComplex (SheafOfModules.{u+1} (wcZModRingSheaf Z m)) ℤ) (m₀ : ℤ),
      J.IsStrictlyGE m₀ → (∀ k, Injective (J.X k)) →
      ∀ (j : (Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K ⟶ J), QuasiIso j →
      ∀ (v : K ⟶ (Pi.mapHomologicalComplex (ComplexShape.up ℤ)).obj J),
        (∀ k, v.f k = Di.adj.unit.app (K.X k) ≫ Pi.map (j.f k)) →
      ∀ q : ℤ, ∃ H : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}, m • 𝟙 H = 0 ∧
        Nonempty ((SheafOfModules.toSheaf (wcZModRingSheaf S m)).obj
          ((CochainComplex.mappingCone v).homology q) ≅ (wcEpsInv S).obj H) :=
by
  intro P Pi K J m₀ hJ hJi j hj v hv q
  haveI := Di.additive
  haveI := Di.presLim
  haveI := Di.presColim
  haveI := Dg.additive
  haveI : P.Additive := Adjunction.right_adjoint_additive Dg.adj
  haveI : Pi.Additive := Adjunction.right_adjoint_additive Di.adj

  have htrans : ∀ {X : Scheme.{u}} {M M' : SheafOfModules.{u+1} (wcZModRingSheaf X m)},
      (M ≅ M') → wcZModClassicalMod X m M → wcZModClassicalMod X m M' := by
    intro X M M' φ hM
    obtain ⟨H, hH, ⟨e⟩⟩ := hM
    exact ⟨H, hH, ⟨(SheafOfModules.toSheaf (wcZModRingSheaf X m)).mapIso φ.symm ≪≫ e⟩⟩

  have hK : ∀ r : ℤ, wcZModClassicalMod S m (K.homology r) := fun r =>
    wc_tq_push_resolution_classical g m hm Dg hDg I r

  have hJcl : ∀ r : ℤ, wcZModClassicalMod Z m (J.homology r) := by
    intro r
    have h1 := wc_tq_pull_classical i m Di hDi (K.homology r) (hK r)
    haveI : IsIso (HomologicalComplex.homologyMap j r) :=
      (quasiIsoAt_iff_isIso_homologyMap j r).mp ((quasiIso_iff j).mp hj r)
    have e1 : ((Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K).homology r ≅
        Di.Φ.obj (K.homology r) := (K.sc r).mapHomologyIso Di.Φ
    have e2 : ((Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj K).homology r ≅
        J.homology r := asIso (HomologicalComplex.homologyMap j r)
    exact htrans (e1.symm ≪≫ e2) h1
  have hPJ : ∀ r : ℤ,
      wcZModClassicalMod S m (((Pi.mapHomologicalComplex (ComplexShape.up ℤ)).obj J).homology r) :=
    fun r => wc_tq_closed_push_inj_classical i m hm Di hDi J m₀ hJ hJi hJcl r

  obtain ⟨a, b, w, hses⟩ := wc_tq_cone_homology_ses v q
  have hcok := (wc_tq_classical_mod_ker_coker S m (HomologicalComplex.homologyMap v q)
    (hK q) (hPJ q)).2
  have hker := (wc_tq_classical_mod_ker_coker S m (HomologicalComplex.homologyMap v (q + 1))
    (hK (q + 1)) (hPJ (q + 1))).1
  exact wc_tq_classical_mod_extension S m hm _ hses hcok hker

theorem wc_tq_epsInv_section_local_vanish : ∀ (S : Scheme.{u}) (H : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (V : S.Etale) (s : H.obj.obj (Opposite.op V)) (v : V.left) (W : S.ProEt) (k : W ⟶ (wcEtToProEt S).obj V), v ∈ Set.range k.left → (((wcEpsInv S).obj H).obj.map k.op).hom (((toSheafify (Scheme.ProEt.topology S) ((wcEtToProEt S).op.lan.obj H.obj)).app (Opposite.op ((wcEtToProEt S).obj V))).hom ((((wcEtToProEt S).op.lanUnit.app H.obj).app (Opposite.op V)).hom s)) = 0 → ∃ (V₁ : S.Etale) (c : V₁ ⟶ V), v ∈ Set.range c.left ∧ (H.obj.map c.op).hom s = 0 :=
by
  intro S H V s v W k hv h0

  obtain ⟨O, hOo, hO⟩ := wc_epsInv_zero_locus S H ((wcEtToProEt S).obj V)
    (((toSheafify (Scheme.ProEt.topology S) ((wcEtToProEt S).op.lan.obj H.obj)).app
      (Opposite.op ((wcEtToProEt S).obj V))).hom
      ((((wcEtToProEt S).op.lanUnit.app H.obj).app (Opposite.op V)).hom s))
  have hkO : Set.range k.left ⊆ O := (hO W k).mp h0
  have hvO : v ∈ O := hkO hv

  obtain ⟨O', hO'a, hvO', hO'O⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
    (X := V.left) (x := v) (U := ⟨O, hOo⟩) hvO

  haveI : Etale V.hom := V.prop
  let V₁ : S.Etale := Scheme.Etale.mk (O'.ι ≫ V.hom)
  let c : V₁ ⟶ V := MorphismProperty.Over.homMk O'.ι
  have hrc : Set.range c.left = (O' : Set V.left) := Scheme.Opens.range_ι O'
  have hvc : v ∈ Set.range c.left := by rw [hrc]; exact hvO'

  have hy1 : ((wcEpsInv S).obj H).obj.map ((wcEtToProEt S).map c).op
      (((toSheafify (Scheme.ProEt.topology S) ((wcEtToProEt S).op.lan.obj H.obj)).app
        (Opposite.op ((wcEtToProEt S).obj V))).hom
        ((((wcEtToProEt S).op.lanUnit.app H.obj).app (Opposite.op V)).hom s)) = 0 := by
    apply (hO ((wcEtToProEt S).obj V₁) ((wcEtToProEt S).map c)).mpr
    intro x hx
    have hx' : x ∈ Set.range c.left := hx
    rw [hrc] at hx'
    exact hO'O hx'

  have hθ1 : ((toSheafify (Scheme.ProEt.topology S) ((wcEtToProEt S).op.lan.obj H.obj)).app
      (Opposite.op ((wcEtToProEt S).obj V₁))).hom
      ((((wcEtToProEt S).op.lanUnit.app H.obj).app (Opposite.op V₁)).hom
        ((H.obj.map c.op).hom s)) = 0 := by
    have e1 := congrArg (fun f => f.hom s)
      (((wcEtToProEt S).op.lanUnit.app H.obj).naturality c.op)
    have e2 := congrArg (fun f => f.hom
        ((((wcEtToProEt S).op.lanUnit.app H.obj).app (Opposite.op V)).hom s))
      ((toSheafify (Scheme.ProEt.topology S) ((wcEtToProEt S).op.lan.obj H.obj)).naturality
        ((wcEtToProEt S).map c).op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at e1 e2
    refine Eq.trans (congrArg (fun z => ((toSheafify (Scheme.ProEt.topology S)
      ((wcEtToProEt S).op.lan.obj H.obj)).app (Opposite.op ((wcEtToProEt S).obj V₁))).hom z) e1) ?_
    exact e2.trans hy1

  haveI : IsAffine V₁.left := hO'a
  have hid1 : ∀ z, (((wcEpsInv S).obj H).obj.map (𝟙 ((wcEtToProEt S).obj V₁)).op).hom z = z := by
    intro z; simp
  have hid2 : ∀ z, (H.obj.map (𝟙 V₁).op).hom z = z := by
    intro z; simp
  obtain ⟨l', t', ht'⟩ := wc_epsInv_limit_inj S H ((wcEtToProEt S).obj V₁) (Discrete PUnit.{u+1})
    ((Functor.const (Discrete PUnit.{u+1})).obj V₁) (fun _ => 𝟙 ((wcEtToProEt S).obj V₁))
    (by intro l l' t; simp)
    (by intro l; exact (inferInstance : CompactSpace V₁.left))
    (by intro l; exact (inferInstance : QuasiSeparatedSpace V₁.left))
    (by intro l l' t; exact (inferInstance : IsAffineHom (𝟙 V₁.left)))
    (by
      intro Z z hz
      refine ⟨z ⟨PUnit.unit⟩, fun l => ?_, fun h' hh' => ?_⟩
      · obtain ⟨⟨⟩⟩ := l
        exact Category.comp_id _
      · have := hh' ⟨PUnit.unit⟩
        rw [← this]
        exact (Category.comp_id h').symm)
    ⟨PUnit.unit⟩ ((H.obj.map c.op).hom s) ((hid1 _).trans hθ1)
  exact ⟨V₁, c, hvc, (hid2 _).symm.trans ht'⟩

theorem wc_tq_thickening_through_point : ∀ {S Z : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i] (T : S.ProEt) (τ : T.left), T.hom τ ∈ Set.range i → ∃ (A : Type u) (_ : CommRing A) (I : Ideal A) (_ : HenselianRing A I) (Vt : S.ProEt) (e : Vt.left ≅ Spec (.of A)) (c : Limits.pullback Vt.hom i ⟶ Spec (.of (A ⧸ I))) (k : Vt ⟶ T), IsPullback (Limits.pullback.fst Vt.hom i) c e.hom (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) ∧ (IsAffine ((wcProEtBaseChange i).obj Vt).left ∧ IsClosed {x : ((wcProEtBaseChange i).obj Vt).left | IsClosed ({x} : Set ((wcProEtBaseChange i).obj Vt).left)} ∧ (∀ x : ((wcProEtBaseChange i).obj Vt).left, ∃! y : ((wcProEtBaseChange i).obj Vt).left, IsClosed ({y} : Set ((wcProEtBaseChange i).obj Vt).left) ∧ x ⤳ y) ∧ ExtremallyDisconnected {x : ((wcProEtBaseChange i).obj Vt).left | IsClosed ({x} : Set ((wcProEtBaseChange i).obj Vt).left)} ∧ (∀ x : ((wcProEtBaseChange i).obj Vt).left, IsClosed ({x} : Set ((wcProEtBaseChange i).obj Vt).left) → HenselianLocalRing (((wcProEtBaseChange i).obj Vt).left.presheaf.stalk x) ∧ IsSepClosed (((wcProEtBaseChange i).obj Vt).left.residueField x))) ∧ τ ∈ Set.range k.left :=
by
  classical
  intro S Z i _ T τ hτ
  obtain ⟨z, hz⟩ := hτ
  obtain ⟨u, hu, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := T.hom) (g := i) τ z hz.symm
  obtain ⟨W₀, f, hf, w, hw⟩ :=
    (wc_proet_cover_surj_quotient Z ((wcProEtBaseChange i).obj T) _
      (wc_proet_wcontr_affine_open_cover i ((wcProEtBaseChange i).obj T))).1 u
  obtain ⟨T₀, h, g, ⟨⟨O, hO, hTO⟩, hT⟩, rfl⟩ := hf
  obtain ⟨A, iA, I, iI, Vt, e, c, κ, hsq, -, hiV⟩ :=
    wc_proet_henselian_thickening_exists i T₀ O hO hTO hT
  have hinit : Function.Bijective (fun a : Vt ⟶ T => (wcProEtBaseChange i).map a) := by
    refine wc_proet_thickening_bc_hom_bijective i A I Vt e c hsq ?_ T
    intro X S' g' _ a b hab
    exact wc_weaklyEtale_henselian_lift g' A I a b hab
  obtain ⟨k, hk⟩ := hinit.2 (κ.hom ≫ g)
  have hk' : (wcProEtBaseChange i).map k = κ.hom ≫ g := hk
  have hg : g.left (h.left w) = u := by
    rw [← hw]
    rfl
  have ha : κ.hom.left (κ.inv.left (h.left w)) = h.left w := by
    have e1 : (κ.inv ≫ κ.hom).left = (𝟙 T₀ : T₀ ⟶ T₀).left := by rw [κ.inv_hom_id]
    have e2 := congrArg (fun φ => φ (h.left w)) e1
    exact e2
  have hb : ((wcProEtBaseChange i).map k).left (κ.inv.left (h.left w)) = u := by
    rw [hk']
    change g.left (κ.hom.left (κ.inv.left (h.left w))) = u
    rw [ha, hg]
  have F1 : ((wcProEtBaseChange i).map k).left ≫ Limits.pullback.fst T.hom i =
      Limits.pullback.fst Vt.hom i ≫ k.left := Limits.pullback.lift_fst _ _ _
  have hc := congrArg (fun φ => φ (κ.inv.left (h.left w))) F1
  have hc' : Limits.pullback.fst T.hom i (((wcProEtBaseChange i).map k).left (κ.inv.left (h.left w)))
      = k.left (Limits.pullback.fst Vt.hom i (κ.inv.left (h.left w))) := hc
  refine ⟨A, iA, I, iI, Vt, e, c, k, hsq, hiV,
    Limits.pullback.fst Vt.hom i (κ.inv.left (h.left w)), ?_⟩
  exact hc'.symm.trans ((congrArg (Limits.pullback.fst T.hom i) hb).trans hu)

theorem wc_tq_zmod_unit_bij_at_thickening : ∀ {S Z : Scheme.{u}} (i : Z ⟶ S) (m : ℕ) (Di : wcZModPullData i m), wcZModPullCanonical Di → ∀ (A : Type u) [CommRing A] (I : Ideal A) [HenselianRing A I] (Vt : S.ProEt) (e : Vt.left ≅ Spec (.of A)) (c : Limits.pullback Vt.hom i ⟶ Spec (.of (A ⧸ I))), IsPullback (Limits.pullback.fst Vt.hom i) c e.hom (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) → (IsAffine ((wcProEtBaseChange i).obj Vt).left ∧ IsClosed {x : ((wcProEtBaseChange i).obj Vt).left | IsClosed ({x} : Set ((wcProEtBaseChange i).obj Vt).left)} ∧ (∀ x : ((wcProEtBaseChange i).obj Vt).left, ∃! y : ((wcProEtBaseChange i).obj Vt).left, IsClosed ({y} : Set ((wcProEtBaseChange i).obj Vt).left) ∧ x ⤳ y) ∧ ExtremallyDisconnected {x : ((wcProEtBaseChange i).obj Vt).left | IsClosed ({x} : Set ((wcProEtBaseChange i).obj Vt).left)} ∧ (∀ x : ((wcProEtBaseChange i).obj Vt).left, IsClosed ({x} : Set ((wcProEtBaseChange i).obj Vt).left) → HenselianLocalRing (((wcProEtBaseChange i).obj Vt).left.presheaf.stalk x) ∧ IsSepClosed (((wcProEtBaseChange i).obj Vt).left.residueField x))) → ∀ (N : SheafOfModules.{u+1} (wcZModRingSheaf S m)), Function.Bijective ((Di.adj.unit.app N).val.app (Opposite.op Vt)).hom :=
by
  intro S Z i m Di hDi A _ I _ Vt e c hsq hiV N
  have hinit : ∀ V : S.ProEt,
      Function.Bijective (fun a : Vt ⟶ V => (wcProEtBaseChange i).map a) := by
    intro V
    refine wc_proet_thickening_bc_hom_bijective i A I Vt e c hsq ?_ V
    intro X S' g _ a b hab
    exact wc_weaklyEtale_henselian_lift g A I a b hab
  apply wc_tq_zmod_pull_unit_bij_of_lan i m Di hDi
    (wc_tq_zmod_contfun_pullback_locally_bijective i m) Vt N
  refine Function.Bijective.comp ?_
    (wc_proet_lan_unit_bijective_of_init i Vt hinit N.val.presheaf)
  apply wc_proet_toSheafify_bijective_wcontr Z _ _ hiV
  intro m' Q ι hι hpart
  obtain ⟨Vk, ιt, κk, hιt, hpt, hκ, hthick⟩ :=
    wc_proet_thickening_clopen_lift i A I Vt e c hsq m' Q ι hι hpart
  refine wc_proet_lan_clopen_additive i Vt ((SheafOfModules.toSheaf (wcZModRingSheaf S m)).obj N)
    m' Q ι Vk ιt κk hιt hpt hκ
    (wc_proet_lan_unit_bijective_of_init i Vt hinit N.val.presheaf) (fun k => ?_)
  obtain ⟨Ak, iAk, Ik, iIk, ek, ck, hsqk⟩ := hthick k
  refine wc_proet_lan_unit_bijective_of_init i (Vk k) (fun V => ?_) N.val.presheaf
  refine wc_proet_thickening_bc_hom_bijective i Ak Ik (Vk k) ek ck hsqk ?_ V
  intro X S' g _ a b hab
  exact wc_weaklyEtale_henselian_lift g Ak Ik a b hab

theorem wc_tq_support_of_closed_pull_zero {S Z : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    (m : ℕ) (hm : 0 < m) (Di : wcZModPullData i m) (hDi : wcZModPullCanonical Di)
    (M : SheafOfModules.{u+1} (wcZModRingSheaf S m))
    (H : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1})
    (hH : Nonempty ((SheafOfModules.toSheaf (wcZModRingSheaf S m)).obj M ≅ (wcEpsInv S).obj H))
    (hz : Limits.IsZero (Di.Φ.obj M)) : wcSuppIn S (Set.range i)ᶜ H :=
by
  intro V s
  obtain ⟨φ⟩ := hH
  apply wc_etale_jointly_surjective_covers S V
  intro v
  by_cases hv : V.hom v ∈ Set.range i
  ·
    obtain ⟨A, _, I, _, Vt, e, c, k, hsq, hiV, hτ⟩ :=
      wc_tq_thickening_through_point i ((wcEtToProEt S).obj V) v hv
    have hU := wc_tq_zmod_unit_bij_at_thickening i m Di hDi A I Vt e c hsq hiV M
    haveI := Di.additive
    let Pi := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ
    haveI : Pi.Additive := Adjunction.right_adjoint_additive Di.adj
    have hz' : Limits.IsZero (Pi.obj (Di.Φ.obj M)) := Pi.map_isZero hz
    haveI : (wcZModSecEv S m Vt).Additive := by
      first
        | infer_instance
        | (dsimp only [wcZModSecEv]; infer_instance)
    have hsub : Subsingleton ((wcZModSecEv S m Vt).obj (Pi.obj (Di.Φ.obj M))) :=
      AddCommGrpCat.subsingleton_of_isZero ((wcZModSecEv S m Vt).map_isZero hz')
    let y := ((toSheafify (Scheme.ProEt.topology S) ((wcEtToProEt S).op.lan.obj H.obj)).app
      (Opposite.op ((wcEtToProEt S).obj V))).hom
        ((((wcEtToProEt S).op.lanUnit.app H.obj).app (Opposite.op V)).hom s)
    let x := (φ.inv.hom.app (Opposite.op ((wcEtToProEt S).obj V))).hom y
    have hxk : (((SheafOfModules.toSheaf (wcZModRingSheaf S m)).obj M).obj.map k.op).hom x = 0 := by
      apply hU.1
      exact @Subsingleton.elim _ hsub _ _
    have h1 : (φ.hom.hom.app (Opposite.op ((wcEtToProEt S).obj V))).hom x = y := by
      have e := congrArg (fun f => (f.hom.app (Opposite.op ((wcEtToProEt S).obj V))).hom y)
        φ.inv_hom_id
      first
        | exact e
        | (simp only [Sheaf.comp_hom, NatTrans.comp_app, AddCommGrpCat.hom_comp,
            Sheaf.id_hom, NatTrans.id_app, AddCommGrpCat.hom_id, AddMonoidHom.coe_comp,
            Function.comp_apply, AddMonoidHom.id_apply] at e
           exact e)
        | simp [x]
    have h2 := congrArg (fun f => f.hom x) (φ.hom.hom.naturality k.op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at h2
    have hy0 : (((wcEpsInv S).obj H).obj.map k.op).hom y = 0 := by
      rw [← h1, ← h2, hxk, map_zero]
    obtain ⟨V₁, c₁, hvc, hc0⟩ := wc_tq_epsInv_section_local_vanish S H V s v Vt k hτ hy0
    exact ⟨V₁, c₁, Sieve.le_generate _ _ c₁ (Or.inl hc0), hvc⟩
  ·
    have hZc : IsClosed (Set.range i) := (Scheme.Hom.isClosedEmbedding i).isClosed_range
    let O : V.left.Opens := V.hom ⁻¹ᵁ ⟨(Set.range i)ᶜ, hZc.isOpen_compl⟩
    haveI : Etale V.hom := V.prop
    let V₁ : S.Etale := Scheme.Etale.mk (O.ι ≫ V.hom)
    let c₁ : V₁ ⟶ V := MorphismProperty.Over.homMk O.ι
    refine ⟨V₁, c₁, Sieve.le_generate _ _ c₁ (Or.inr ?_), ?_⟩
    · intro x
      have hx : ∀ y : (O : Scheme), V.hom (O.ι y) ∈ (Set.range i)ᶜ := by
        intro y
        have hy : O.ι y ∈ (O : Set V.left) := by
          rw [← Scheme.Opens.range_ι O]
          exact Set.mem_range_self y
        exact hy
      first
        | exact hx x
        | (change V.hom (O.ι x) ∈ (Set.range i)ᶜ; exact hx x)
        | (erw [Scheme.Hom.comp_apply]; exact hx x)
    · show v ∈ Set.range O.ι
      rw [Scheme.Opens.range_ι]
      exact hv

theorem wc_tq_zmod_corep_ext_transfer : ∀ (S : Scheme.{u}) (m : ℕ) (W : S.ProEt) (Q : SheafOfModules.{u+1} (wcZModRingSheaf S m)) (e : ∀ M : SheafOfModules.{u+1} (wcZModRingSheaf S m), (Q ⟶ M) ≃ (wcZModSecEv S m W).obj M), (∀ (M N : SheafOfModules.{u+1} (wcZModRingSheaf S m)) (ψ : M ⟶ N) (f : Q ⟶ M), e N (f ≫ ψ) = ((wcZModSecEv S m W).map ψ).hom (e M f)) → (∀ (J : SheafOfModules.{u+1} (wcZModRingSheaf S m)) [Injective J] (k : ℕ) (z : Abelian.Ext (wcFreeSheaf S W) ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m)).obj J) (k + 1)), z = 0) → ∀ (M : SheafOfModules.{u+1} (wcZModRingSheaf S m)) (k : ℕ), (∀ z : Abelian.Ext (wcFreeSheaf S W) ((SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m)).obj M) k, z = 0) → letI := HasExt.standard (SheafOfModules.{u+1} (wcZModRingSheaf S m)); ∀ x : Abelian.Ext Q M k, x = 0 :=
by
  intro S m W Q e he hJ M k hM
  letI : HasExt (SheafOfModules.{u+1} (wcZModRingSheaf S m)) := HasExt.standard _
  intro x
  haveI : EnoughInjectives (SheafOfModules.{u+1} (wcZModRingSheaf S m)) :=
    sheafOfModules_enoughInjectives _ _
  haveI : Limits.PreservesFiniteColimits (SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m)) :=
    sheafOfModules_toSheaf_preservesFiniteColimits _ _
  obtain ⟨eF, heF, -⟩ := proet_free_sheaf_hom_equiv S W
  let U := SheafOfModules.toSheaf.{u+1} (wcZModRingSheaf S m)
  let s₀ : (U.obj Q).obj.obj (Opposite.op W) := e Q (𝟙 Q)
  let ε : wcFreeSheaf S W ⟶ U.obj Q := (eF (U.obj Q)).symm s₀
  have key : ∀ (Y' : SheafOfModules.{u+1} (wcZModRingSheaf S m)) (f : Q ⟶ Y'),
      eF (U.obj Y') (ε ≫ U.map f) = e Y' f := by
    intro Y' f
    rw [heF, Equiv.apply_symm_apply]
    have h := he Q Y' f (𝟙 Q)
    rw [Category.id_comp] at h
    rw [h]
    rfl
  have hhom : ∀ Y' : SheafOfModules.{u+1} (wcZModRingSheaf S m),
      Function.Bijective (fun f : Q ⟶ Y' => ε ≫ U.map f) := by
    intro Y'
    have hfun : (fun f : Q ⟶ Y' => ε ≫ U.map f) = (eF (U.obj Y')).symm ∘ (e Y') := by
      funext f
      apply (eF (U.obj Y')).injective
      exact (key Y' f).trans ((eF (U.obj Y')).apply_symm_apply (e Y' f)).symm
    rw [hfun]
    exact (eF (U.obj Y')).symm.bijective.comp (e Y').bijective
  have hT := ext_transfer_of_corep U Q (wcFreeSheaf S W) ε hhom hJ M k
  have h1 := hM ((Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor U x) (zero_add k))
  have h2 := hM ((Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor U 0) (zero_add k))
  exact hT.1 (h1.trans h2.symm)

theorem wc_tq_ext_free_slice_epsInv_supp : ∀ (S : Scheme.{u}) (U : S.ProEt) (m : ℕ) (T : Set S) (H : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}), m • 𝟙 H = 0 → wcSuppIn S T H → ∃ H' : Sheaf (Scheme.smallEtaleTopology U.left) AddCommGrpCat.{u+1}, m • 𝟙 H' = 0 ∧ wcSuppIn U.left (U.hom ⁻¹' T) H' ∧ ∀ i : ℕ, Nonempty (Abelian.Ext (wcFreeSheaf S U) ((wcEpsInv S).obj H) i ≃ Abelian.Ext (wcFreeSheaf U.left (Scheme.ProEt.mk (𝟙 U.left))) ((wcEpsInv U.left).obj H') i) :=
by

  have hpullSupp : ∀ {X B : Scheme.{u}} (h : X ⟶ B) (L : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), (L ⊣ wcEtPush h) → ∀ (W : Set B) (G : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}), wcSuppIn B W G → wcSuppIn X (h ⁻¹' W) (L.obj G) := by

    have s1 : ∀ (Y : Scheme.{u}) (W : Set Y) (P : (Scheme.Etale Y)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
        (∀ (U : Y.Etale), (∀ x, U.hom x ∈ W) → ∀ p : P.obj (Opposite.op U), p = 0) →
        ∀ (U : Y.Etale), (∀ x, U.hom x ∈ W) →
        ∀ t : (sheafify (Scheme.smallEtaleTopology Y) P).obj (Opposite.op U), t = 0 := by
      intro Y W P hP U hU t
      haveI := Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology Y) P
      have hI := Presheaf.imageSieve_mem (Scheme.smallEtaleTopology Y)
        (toSheafify (Scheme.smallEtaleTopology Y) P) t
      have hsep := Sheaf.isSeparated
        ((presheafToSheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}).obj P)
      refine hsep U _ hI t 0 ?_
      intro U' h hh
      obtain ⟨p, hp⟩ := hh
      have hU' : ∀ x, U'.hom x ∈ W := by
        intro x
        rw [← MorphismProperty.Over.w h, Scheme.Hom.comp_apply]
        exact hU _
      rw [hP U' hU' p, map_zero] at hp
      rw [map_zero]
      exact hp.symm

    have s2 : ∀ (Y : Scheme.{u}) (W : Set Y) (F H : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
        wcSuppIn Y W F →
        (∀ (U : Y.Etale), (∀ x, U.hom x ∈ W) → ∀ t : H.obj.obj (Opposite.op U), t = 0) →
        ∀ φ : F ⟶ H, φ = 0 := by
      intro Y W F H hF hH φ
      have key : ∀ (V : Y.Etale) (s : F.obj.obj (Opposite.op V)),
          φ.hom.app (Opposite.op V) s = 0 := by
        intro V s
        refine Sheaf.isSeparated H V _ (hF V s) _ 0 ?_
        intro V'' f hf
        obtain ⟨V', a, b, hb, rfl⟩ := hf
        have hnat : H.obj.map b.op (φ.hom.app (Opposite.op V) s) =
            φ.hom.app (Opposite.op V') (F.obj.map b.op s) :=
          (NatTrans.naturality_apply φ.hom b.op s).symm
        rw [map_zero, op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
        rcases hb with h0 | hW
        · rw [hnat, h0, map_zero, map_zero]
        · rw [hH V' hW (H.obj.map b.op (φ.hom.app (Opposite.op V) s)), map_zero]
      apply Sheaf.hom_ext
      ext V s
      exact (key V.unop s).trans rfl

    have s3 : ∀ (Y : Scheme.{u}) (W : Set Y) (G : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}),
        (∀ (P : (Scheme.Etale Y)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) (π : G.obj ⟶ P),
          (∀ (U : Y.Etale), (∀ x, U.hom x ∈ W) → ∀ p : P.obj (Opposite.op U), p = 0) →
          π ≫ toSheafify (Scheme.smallEtaleTopology Y) P = 0) → wcSuppIn Y W G := by
      intro Y W G hG
      have hM : ∀ {U U' : Y.Etale} (h : U' ⟶ U), (∀ x, U.hom x ∈ W) → ∀ x, U'.hom x ∈ W := by
        intro U U' h hU x
        rw [← MorphismProperty.Over.w h, Scheme.Hom.comp_apply]
        exact hU _
      let K : ∀ U : Y.Etale, AddSubgroup (G.obj.obj (Opposite.op U)) :=
        fun U => ⨆ (_ : ∀ x, U.hom x ∈ W), ⊤
      have hK : ∀ (U : Y.Etale) (y : G.obj.obj (Opposite.op U)),
          y ∈ K U ↔ ((∀ x, U.hom x ∈ W) ∨ y = 0) := by
        intro U y
        by_cases hU : ∀ x, U.hom x ∈ W
        · simp only [K, iSup_pos hU]
          simp [hU]
        · simp only [K, iSup_neg hU]
          rw [AddSubgroup.mem_bot]
          exact ⟨Or.inr, fun h => h.resolve_left hU⟩
      have hle : ∀ {U U' : Y.Etale} (h : U' ⟶ U),
          K U ≤ (K U').comap (G.obj.map h.op).hom := by
        intro U U' h y hy
        rw [AddSubgroup.mem_comap, hK]
        rcases (hK U y).mp hy with hU | hy0
        · exact Or.inl (hM h hU)
        · right
          rw [hy0, map_zero]
      let Q : (Scheme.Etale Y)ᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
        { obj := fun U => AddCommGrpCat.of (G.obj.obj U ⧸ K U.unop)
          map := fun {U U'} h => AddCommGrpCat.ofHom
            (QuotientAddGroup.map (K U.unop) (K U'.unop) (G.obj.map h).hom (hle h.unop))
          map_id := fun U => by
            apply AddCommGrpCat.hom_ext
            refine QuotientAddGroup.addMonoidHom_ext _ ?_
            ext y
            simp
          map_comp := fun f g => by
            apply AddCommGrpCat.hom_ext
            refine QuotientAddGroup.addMonoidHom_ext _ ?_
            ext y
            simp }
      let π : G.obj ⟶ Q :=
        { app := fun U => AddCommGrpCat.ofHom (QuotientAddGroup.mk' (K U.unop))
          naturality := fun U U' h => by
            apply AddCommGrpCat.hom_ext
            ext y
            rfl }
      have hQ : ∀ (U : Y.Etale), (∀ x, U.hom x ∈ W) → ∀ p : Q.obj (Opposite.op U), p = 0 := by
        intro U hU p
        obtain ⟨y, rfl⟩ : ∃ y : G.obj.obj (Opposite.op U),
            (QuotientAddGroup.mk y : G.obj.obj (Opposite.op U) ⧸ K U) = p :=
          QuotientAddGroup.mk_surjective p
        exact (QuotientAddGroup.eq_zero_iff y).mpr ((hK U y).mpr (Or.inl hU))
      intro V s
      have h0 := hG Q π hQ
      have h1 : (toSheafify (Scheme.smallEtaleTopology Y) Q).app (Opposite.op V)
          (QuotientAddGroup.mk s : G.obj.obj (Opposite.op V) ⧸ K V) =
          (toSheafify (Scheme.smallEtaleTopology Y) Q).app (Opposite.op V) 0 := by
        rw [map_zero]
        have h2 : (π ≫ toSheafify (Scheme.smallEtaleTopology Y) Q).app (Opposite.op V) = 0 := by
          rw [h0]; rfl
        exact (ConcreteCategory.congr_hom h2 s).trans rfl
      haveI := Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology Y) Q
      have hE := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology Y)
        (toSheafify (Scheme.smallEtaleTopology Y) Q) _ _ h1
      refine GrothendieckTopology.superset_covering _ ?_ hE
      intro V' f hf
      apply Sieve.le_generate
      rw [Presheaf.equalizerSieve_apply, map_zero] at hf
      have hf' : (QuotientAddGroup.mk (G.obj.map f.op s) :
          G.obj.obj (Opposite.op V') ⧸ K V') = 0 := hf
      rcases (hK V' _).mp ((QuotientAddGroup.eq_zero_iff _).mp hf') with hW | hz
      · exact Or.inr hW
      · exact Or.inl hz

    intro X B g L adj S F hF
    apply s3 X (g ⁻¹' S) (L.obj F)
    intro P π hP
    let H := (presheafToSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj P
    let q : L.obj F ⟶ H := ObjectProperty.homMk (π ≫ toSheafify (Scheme.smallEtaleTopology X) P)
    have hH : ∀ (U : X.Etale), (∀ x, U.hom x ∈ g ⁻¹' S) → ∀ t : H.obj.obj (Opposite.op U), t = 0 :=
      fun U hU t => s1 X (g ⁻¹' S) P hP U hU t
    have hpush : ∀ (V : B.Etale), (∀ x, V.hom x ∈ S) →
        ∀ t : ((wcEtPush g).obj H).obj.obj (Opposite.op V), t = 0 := by
      intro V hV t
      refine s1 B S ((wcEtBaseChange g).op ⋙ H.obj) ?_ V hV t
      intro V' hV' p
      refine hH ((wcEtBaseChange g).obj V') ?_ p
      show ∀ z : ↥(Limits.pullback V'.hom g), g (Limits.pullback.snd V'.hom g z) ∈ S
      intro z
      have e1 : (Limits.pullback.fst V'.hom g ≫ V'.hom) z = (Limits.pullback.snd V'.hom g ≫ g) z := by
        rw [Limits.pullback.condition]
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at e1
      rw [← e1]
