    have h2 := hd (τ l.unop.down (l.unop.down + d) hle) (hτof _ _ _)
      (by rw [hτroot, Nat.add_sub_cancel_left]) Ef
    rw [← hx Ek]
    exact h1.trans (by rw [h2, map_zero])
  obtain ⟨E⟩ := wc_et_zmodext_coh_equiv (Spec (.of (TensorProduct (LaurentPolynomial L) M
      (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))))) ℓ (j + 1)
  haveI : Subsingleton (wcEtZModExt (Spec (.of (TensorProduct (LaurentPolynomial L) M
      (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))))) ℓ (j + 1)) :=
    ⟨fun y₁ y₂ => by rw [key y₁, key y₂]⟩
  exact E.symm.subsingleton

theorem wc_qmtm_offdouble_milnor_acyclic : ∀ (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A) →
    ∀ (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} →
    ∀ (r : ℕ) (R : Type u) [CommRing R] [HenselianLocalRing R]
      [IsSepClosed (IsLocalRing.ResidueField R)]
      (ρ : wcQuadModelRing A (r + 2) π (wcQmtmC A r) →+* R),
    WeaklyEtale (Spec.map (CommRingCat.ofHom ρ)) →
    ρ (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)) π) ∈ IsLocalRing.maximalIdeal R →
    ¬ (ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal R ∧
       ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal R) →
    ∀ (L : Type u) [Field L] [IsSepClosed L] (φA : A →+* L), Function.Injective φA →
    (letI := φA.toAlgebra; Algebra.IsAlgebraic A L) →
    ∀ (q : ℕ), 1 ≤ q →
      letI : Algebra A R := (ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
      letI : Algebra A L := φA.toAlgebra
      Subsingleton (wcEtCoh (Spec (.of (TensorProduct A L R))) ℓ q) :=
by
  intro A _ _ _ _ _ ℓ _ hℓ π hπ r R _ _ _ ρ hWE hπR hoff L _ _ φA hφA halg q hq
  letI : Algebra A R :=
    (ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
  letI : Algebra A L := φA.toAlgebra

  have hoff' : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∉
        (Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R)).asIdeal ∨
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∉
        (Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R)).asIdeal :=
    not_and_or.mp hoff
  obtain ⟨U, hyU, hU⟩ := wc_qmssl_offdouble_smooth A r π
    (Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R)) hoff'
  have hfy : wcQuadModelStr A (r + 2) π (wcQmtmC A r)
      (Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R)) =
      IsLocalRing.closedPoint A := by
    have hle : IsLocalRing.maximalIdeal A ≤ (wcQuadModelStr A (r + 2) π (wcQmtmC A r)
        (Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R))).asIdeal := by
      rw [hπ, Ideal.span_singleton_le_iff_mem]
      exact hπR
    have hne : (wcQuadModelStr A (r + 2) π (wcQmtmC A r)
        (Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R))).asIdeal ≠ ⊤ :=
      (wcQuadModelStr A (r + 2) π (wcQmtmC A r)
        (Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R))).isPrime.ne_top
    exact PrimeSpectrum.ext ((IsLocalRing.maximalIdeal.isMaximal A).eq_of_le hne hle).symm

  obtain ⟨B, _, _, _, Λ, _, _, W', φ, a, e, h1, h2, h3, h4, h5, h6, h7⟩ :=
    wc_et_geom_strict_henselization (Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R))
  have hsh : wcHalShData (Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R)) B Λ W' φ a :=
    ⟨h1, h2, h3, h4, h5, e, h6, h7⟩

  obtain ⟨ε, -, hε⟩ := @wc_pltr_wet_residue_geom_point _
    (Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R)) R _ inferInstance
    (Spec.map (CommRingCat.ofHom ρ)) hWE rfl
  have hp : (Spec.map (CommRingCat.ofHom ε))
      (IsLocalRing.closedPoint (AlgebraicClosure
        ((Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).residueField
          (Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R))))) =
      IsLocalRing.closedPoint (IsLocalRing.ResidueField R) :=
    @Subsingleton.elim (PrimeSpectrum (IsLocalRing.ResidueField R)) inferInstance _ _
  have hres : (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField R)) = IsLocalRing.closedPoint R := by
    first
      | exact IsLocalRing.comap_closedPoint (IsLocalRing.residue R)
      | (show (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))).base _ = _
         rw [Spec.map_base]
         exact IsLocalRing.comap_closedPoint (IsLocalRing.residue R))
  have hq' : (Spec.map (CommRingCat.ofHom ε) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))
      (IsLocalRing.closedPoint (AlgebraicClosure
        ((Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).residueField
          (Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R))))) =
      IsLocalRing.closedPoint R :=
    (Scheme.Hom.comp_apply _ _ _).trans
      ((congrArg (fun p => (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) p) hp).trans hres)
  obtain ⟨δ, hδ, -⟩ := @wc_shdata_lift_geom_point _
    (Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R)) B _ inferInstance Λ _ _ W' φ a hsh
    R _ inferInstance inferInstance (Spec.map (CommRingCat.ofHom ρ))
    (Spec.map (CommRingCat.ofHom ε) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) hq'
    ((Category.assoc _ _ _).trans hε)
  haveI hδi : IsIso δ := @wc_pltr_shens_lift_iso _
    (Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R)) B _ inferInstance inferInstance
    Λ _ _ W' φ a hsh R _ inferInstance (Spec.map (CommRingCat.ofHom ρ)) hWE rfl δ hδ

  have h1m := (wc_smooth_open_shens_milnor_fibre_acyclic A _
    (wcQuadModelStr A (r + 2) π (wcQmtmC A r)) U hU ℓ hℓ
    (Spec.map (CommRingCat.ofHom ρ) (IsLocalRing.closedPoint R)) hyU hfy B Λ W' φ a hsh
    (AlgebraicClosure L)
    (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) ≫
      Spec.map (CommRingCat.ofHom φA))).2 q hq

  obtain ⟨e1⟩ := wc_et_coh_iso_invariance (Limits.pullbackLeftPullbackSndIso
    (a ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) (Spec.map (CommRingCat.ofHom φA))
    (Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))))).hom ℓ q
  have h2m := @Equiv.subsingleton _ _ e1.symm h1m
  obtain ⟨e2⟩ := wc_et_coh_purely_inseparable_invariance L (AlgebraicClosure L)
    (fun x => Algebra.IsIntegral.isIntegral x) _
    (Limits.pullback.snd (a ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
      (Spec.map (CommRingCat.ofHom φA))) ℓ q
  have h3m := @Equiv.subsingleton _ _ e2.symm h2m

  have eq₁ : (Spec.map (CommRingCat.ofHom ρ) ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) ≫ 𝟙 _ =
      δ ≫ a ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r) := by
    first
      | (rw [Category.comp_id, ← Category.assoc, hδ])
      | (rw [Category.comp_id, ← hδ, Category.assoc])
      | (simp only [Category.comp_id, ← Category.assoc, hδ])
  have eq₂ : Spec.map (CommRingCat.ofHom φA) ≫ 𝟙 _ = 𝟙 _ ≫ Spec.map (CommRingCat.ofHom φA) := by
    simp
  haveI hm1 : IsIso (Limits.pullback.map
      (Spec.map (CommRingCat.ofHom ρ) ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
      (Spec.map (CommRingCat.ofHom φA)) (a ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
      (Spec.map (CommRingCat.ofHom φA)) δ (𝟙 _) (𝟙 _) eq₁ eq₂) :=
    Limits.pullback.map_isIso _ _ _ _ _ _ _ _ _
  obtain ⟨e3⟩ := wc_et_coh_iso_invariance (Limits.pullback.map
      (Spec.map (CommRingCat.ofHom ρ) ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
      (Spec.map (CommRingCat.ofHom φA)) (a ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
      (Spec.map (CommRingCat.ofHom φA)) δ (𝟙 _) (𝟙 _) eq₁ eq₂) ℓ q
  have h4m := @Equiv.subsingleton _ _ e3.symm h3m

  have hcf : Spec.map (CommRingCat.ofHom ρ) ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r) =
      Spec.map (CommRingCat.ofHom (algebraMap A R)) := by
    rw [show algebraMap A R =
        ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r))) from rfl,
      CommRingCat.ofHom_comp, Spec.map_comp]
  have hη : Spec.map (CommRingCat.ofHom φA) = Spec.map (CommRingCat.ofHom (algebraMap A L)) := rfl
  obtain ⟨e4⟩ := wc_et_coh_iso_invariance
    (Limits.pullbackSymmetry _ _ ≪≫ Limits.pullback.congrHom hη hcf ≪≫
      pullbackSpecIso A L R).hom ℓ q
  exact @Equiv.subsingleton _ _ e4 h4m

theorem wc_henselian_sepclosed_unit_pow_root : ∀ (R : Type u) [CommRing R] [HenselianLocalRing R]
    [IsSepClosed (IsLocalRing.ResidueField R)] (N : ℕ), 0 < N → IsUnit ((N : ℕ) : R) →
    ∀ c : R, IsUnit c → ∃ w : R, w ^ N = c :=
by
  intro R _ _ _ N hN0 hN c hc
  have hcres : IsLocalRing.residue R c ≠ 0 :=
    (IsLocalRing.residue_ne_zero_iff_isUnit c).mpr hc
  have hNres : ((N : ℕ) : IsLocalRing.ResidueField R) ≠ 0 := by
    have h := (IsLocalRing.residue_ne_zero_iff_isUnit ((N : ℕ) : R)).mpr hN
    rwa [map_natCast] at h
  haveI : NeZero ((N : ℕ) : IsLocalRing.ResidueField R) := ⟨hNres⟩
  obtain ⟨z, hz⟩ := IsSepClosed.exists_pow_nat_eq (IsLocalRing.residue R c) N
  have hz0 : z ≠ 0 := by
    rintro rfl
    rw [zero_pow (Nat.pos_iff_ne_zero.mp hN0)] at hz
    exact hcres hz.symm
  obtain ⟨a₀, ha₀⟩ := IsLocalRing.residue_surjective z
  have ha₀u : IsUnit a₀ :=
    (IsLocalRing.residue_ne_zero_iff_isUnit a₀).mp (by rw [ha₀]; exact hz0)
  have hmon : (Polynomial.X ^ N - Polynomial.C c : Polynomial R).Monic :=
    Polynomial.monic_X_pow_sub_C c (Nat.pos_iff_ne_zero.mp hN0)
  have hev : Polynomial.eval a₀ (Polynomial.X ^ N - Polynomial.C c : Polynomial R) =
      a₀ ^ N - c := by
    simp
  have hmem : Polynomial.eval a₀ (Polynomial.X ^ N - Polynomial.C c : Polynomial R) ∈
      IsLocalRing.maximalIdeal R := by
    rw [hev, ← IsLocalRing.residue_eq_zero_iff, map_sub, map_pow, ha₀, hz, sub_self]
  have hder : Polynomial.eval a₀
      (Polynomial.derivative (Polynomial.X ^ N - Polynomial.C c : Polynomial R)) =
      ((N : ℕ) : R) * a₀ ^ (N - 1) := by
    simp [Polynomial.derivative_X_pow]
  have hderu : IsUnit (Polynomial.eval a₀
      (Polynomial.derivative (Polynomial.X ^ N - Polynomial.C c : Polynomial R))) := by
    rw [hder]
    exact hN.mul (ha₀u.pow _)
  obtain ⟨a, ha, -⟩ := HenselianLocalRing.is_henselian _ hmon a₀ hmem hderu
  refine ⟨a, ?_⟩
  have h := ha.eq_zero
  simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
    Polynomial.eval_C] at h
  exact sub_eq_zero.mp h

theorem wc_qmtm_offdouble_unit_root : ∀ (A : Type u) [CommRing A] (π : A), π ≠ 0 →
    ∀ (r : ℕ) (R : Type u) [CommRing R] [IsLocalRing R]
      (ρ : wcQuadModelRing A (r + 2) π (wcQmtmC A r) →+* R) (N : ℕ), 0 < N →
    (∀ c : R, IsUnit c → ∃ w : R, w ^ N = c) →
    ¬ (ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal R ∧
       ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal R) →
    ∀ (L : Type u) [Field L] [IsSepClosed L] (φA : A →+* L), Function.Injective φA →
    ((N : ℕ) : L) ≠ 0 →
      letI : Algebra A R := (ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
      letI : Algebra A L := φA.toAlgebra
      ∃ u : TensorProduct A L R, IsUnit u ∧
        u ^ N = (1 : L) ⊗ₜ[A] ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) :=
by
  intro A _ π hπ0 r R _ _ ρ N hN Hroot hoff L _ _ φA hφA hNL
  letI : Algebra A R := (ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
  letI : Algebra A L := φA.toAlgebra
  have hN0 : N ≠ 0 := Nat.pos_iff_ne_zero.mp hN
  have hsum : (∑ i : Fin (r + 2), ∑ j : Fin (r + 2), MvPolynomial.C (wcQmtmC A r i j) *
      MvPolynomial.X i * MvPolynomial.X j : MvPolynomial (Fin (r + 2)) A) =
      MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩ := by
    rw [Finset.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
    · rw [Finset.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
      · simp [wcQmtmC]
      · intro b _ hb
        have hb1 : b.val ≠ 1 := fun h => hb (Fin.ext h)
        simp [wcQmtmC, hb1]
      · intro h; exact absurd (Finset.mem_univ _) h
    · intro b _ hb
      apply Finset.sum_eq_zero
      intro j _
      have hb0 : b.val ≠ 0 := fun h => hb (Fin.ext h)
      simp only [wcQmtmC, Matrix.of_apply]
      rw [if_neg (fun h => hb0 h.1)]
      simp
    · intro h; exact absurd (Finset.mem_univ _) h
  have hmem : (MvPolynomial.X ⟨0, by omega⟩ * MvPolynomial.X ⟨1, by omega⟩ -
      MvPolynomial.C π : MvPolynomial (Fin (r + 2)) A) ∈
      wcQuadModelIdeal A (r + 2) π (wcQmtmC A r) := by
    rw [← hsum]
    exact Ideal.subset_span (Set.mem_singleton _)
  have hquot : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X ⟨0, by omega⟩) *
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X ⟨1, by omega⟩) =
      algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)) π := by
    rw [← map_mul, ← Ideal.Quotient.mk_algebraMap, MvPolynomial.algebraMap_eq]
    exact Ideal.Quotient.eq.mpr hmem
  have hρπ : algebraMap A R π =
      ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) *
      ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) := by
    rw [← map_mul, hquot]
    rfl
  rcases not_and_or.mp hoff with h0 | h1
  · have hu0 := IsLocalRing.notMem_maximalIdeal.mp h0
    obtain ⟨w, hw⟩ := Hroot _ hu0
    have hwu : IsUnit w := (isUnit_pow_iff hN0).mp (by rw [hw]; exact hu0)
    refine ⟨(1 : L) ⊗ₜ[A] w, ?_, ?_⟩
    · have h := hwu.map (Algebra.TensorProduct.includeRight : R →ₐ[A] TensorProduct A L R)
      rwa [Algebra.TensorProduct.includeRight_apply] at h
    · rw [Algebra.TensorProduct.tmul_pow, one_pow, hw]
  · have hu1 := IsLocalRing.notMem_maximalIdeal.mp h1
    have hxc := hu1.mul_val_inv
    obtain ⟨w, hw⟩ := Hroot _ (Units.isUnit hu1.unit⁻¹)
    have hwu : IsUnit w := (isUnit_pow_iff hN0).mp (by rw [hw]; exact Units.isUnit _)
    have hφπ : φA π ≠ 0 := (map_ne_zero_iff φA hφA).mpr hπ0
    haveI : NeZero ((N : ℕ) : L) := ⟨hNL⟩
    obtain ⟨πL, hπL⟩ := IsSepClosed.exists_pow_nat_eq (φA π) N
    have hπL0 : πL ≠ 0 := by
      rintro rfl
      rw [zero_pow hN0] at hπL
      exact hφπ hπL.symm
    refine ⟨πL ⊗ₜ[A] w, ?_, ?_⟩
    · have e : πL ⊗ₜ[A] w = Algebra.TensorProduct.includeLeftRingHom πL *
          (Algebra.TensorProduct.includeRight : R →ₐ[A] TensorProduct A L R) w := by
        rw [Algebra.TensorProduct.includeLeftRingHom_apply,
          Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.tmul_mul_tmul,
          mul_one, one_mul]
      rw [e]
      exact ((Ne.isUnit hπL0).map _).mul (hwu.map _)
    · have hφ : φA π = algebraMap A L π := rfl
      rw [Algebra.TensorProduct.tmul_pow, hπL, hw, hφ]
      calc algebraMap A L π ⊗ₜ[A] (↑hu1.unit⁻¹ : R)
          = (algebraMap A L π ⊗ₜ[A] (1 : R)) * ((1 : L) ⊗ₜ[A] (↑hu1.unit⁻¹ : R)) := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        _ = ((1 : L) ⊗ₜ[A] algebraMap A R π) * ((1 : L) ⊗ₜ[A] (↑hu1.unit⁻¹ : R)) := by
            rw [Algebra.TensorProduct.tmul_one_eq_one_tmul]
        _ = _ := by
            rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, hρπ, mul_assoc, hxc, mul_one]

theorem wc_adjoinRoot_X_pow_sub_C_pow_split : ∀ (M : Type u) [CommRing M] (N : ℕ), 0 < N →
    ∀ (ζ u : M), ζ ^ N = 1 →
    (∀ i j : ℕ, i < N → j < N → i ≠ j → IsUnit (ζ ^ i - ζ ^ j)) → IsUnit u →
    Nonempty (AdjoinRoot (Polynomial.X ^ N - Polynomial.C (u ^ N)) ≃+* (Fin N → M)) :=
by
  intro M _ N hN ζ u hζ hdiff hu
  classical
  set P : Polynomial M := Polynomial.X ^ N - Polynomial.C (u ^ N) with hPdef
  let c : Fin N → M := fun i => ζ ^ (i : ℕ) * u
  let s : Fin N → Polynomial M := fun i => Polynomial.X - Polynomial.C (c i)
  have hcop : ∀ i j : Fin N, i ≠ j → IsCoprime (s i) (s j) := by
    intro i j hij
    have hne : (i : ℕ) ≠ (j : ℕ) := fun h => hij (Fin.ext h)
    apply Polynomial.isCoprime_X_sub_C_of_isUnit_sub
    have : c i - c j = (ζ ^ (i : ℕ) - ζ ^ (j : ℕ)) * u := by
      simp only [c]; ring
    rw [this]
    exact (hdiff i j i.isLt j.isLt hne).mul hu
  have hdvd : ∀ i ∈ (Finset.univ : Finset (Fin N)), s i ∣ P := by
    intro i _
    rw [Polynomial.dvd_iff_isRoot, Polynomial.IsRoot.def]
    simp only [hPdef, c, Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X,
      Polynomial.eval_C]
    rw [mul_pow, ← pow_mul, mul_comm (i : ℕ) N, pow_mul, hζ, one_pow, one_mul, sub_self]
  have hprod_dvd : (∏ i, s i) ∣ P := by
    apply Finset.prod_dvd_of_coprime
    · intro i _ j _ hij
      exact hcop i j hij
    · exact hdvd
  have hP : P = ∏ i, s i := by
    rcases subsingleton_or_nontrivial M with hM | hM
    · exact Subsingleton.elim _ _
    · apply Polynomial.eq_of_monic_of_dvd_of_natDegree_le
      · exact Polynomial.monic_prod_of_monic _ _ (fun i _ => Polynomial.monic_X_sub_C (c i))
      · exact Polynomial.monic_X_pow_sub_C (u ^ N) hN.ne'
      · exact hprod_dvd
      · rw [Polynomial.natDegree_prod_of_monic _ _ (fun i _ => Polynomial.monic_X_sub_C (c i))]
        simp only [Polynomial.natDegree_X_sub_C, Finset.sum_const, Finset.card_univ,
          Fintype.card_fin, smul_eq_mul, mul_one, hPdef, Polynomial.natDegree_X_pow_sub_C]
        exact le_rfl
  have hideal : Ideal.span {P} = ⨅ i, Ideal.span {s i} := by
    rw [hP]; exact (Ideal.iInf_span_singleton hcop).symm
  have hpair : Pairwise (Function.onFun IsCoprime (fun i => Ideal.span {s i})) := by
    intro i j hij
    exact (Ideal.isCoprime_span_singleton_iff (s i) (s j)).mpr (hcop i j hij)
  exact ⟨(Ideal.quotEquivOfEq hideal).trans
    ((Ideal.quotientInfRingEquivPiQuotient (fun i => Ideal.span {s i}) hpair).trans
      (RingEquiv.piCongrRight
        (fun i => (Polynomial.quotientSpanXSubCAlgEquiv (c i)).toRingEquiv)))⟩

theorem wc_et_zmodext_clopen_split : ∀ (Y : Scheme.{u}) (U V : Y.Opens), Disjoint U V → U ⊔ V = ⊤ → ∀ (n : ℕ), 0 < n → ∀ (DU : wcEtPullData U.ι n) (DV : wcEtPullData V.ι n) (p : ℕ), Function.Bijective (fun x : wcEtZModExt Y n p => (wcEtPull DU p x, wcEtPull DV p x)) :=
by
  intro Y U V hUV hUVtop n _hn DU DV p
  have hbot : U ⊓ V = ⊥ := disjoint_iff.mp hUV
  have hW : IsEmpty ((U ⊓ V : Y.Opens) : Scheme.{u}) := by
    have hy : ∀ y : Y, y ∈ U ⊓ V → False := by
      intro y hy
      rw [hbot] at hy
      simpa using hy
    exact ⟨fun x => hy x.1 x.2⟩
  have hzero : ∀ (k : ℕ) (z : wcEtZModExt ((U ⊓ V : Y.Opens) : Scheme.{u}) n k), z = 0 := by
    intro k z
    letI : HasExt (SheafOfModules.{u+1} (wcEtZModRing ((U ⊓ V : Y.Opens) : Scheme.{u}) n)) :=
      HasExt.standard _
    have h0 : 𝟙 (SheafOfModules.unit (wcEtZModRing ((U ⊓ V : Y.Opens) : Scheme.{u}) n)) = 0 :=
      (wc_et_zmod_modules_zero_of_isEmpty _ n hW _).eq_of_src _ _
    have e := Abelian.Ext.comp_mk₀_id z
    rw [h0, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero] at e
    exact e.symm
  have hker : ∀ (q : ℕ) (x : wcEtZModExt Y n q), wcEtPull DU q x = 0 → wcEtPull DV q x = 0 →
      x = 0 := by
    intro q
    cases q with
    | zero =>
      intro x h1 h2
      obtain ⟨δ₀, hP⟩ := wc_et_mv_boundary_chosen_data n 0 Y U V hUVtop
      exact wc_et_mv_restr_zero_injective n 0 Y U V δ₀ hP x DU DV h1 h2
    | succ k =>
      intro x h1 h2
      obtain ⟨δ₀, hP⟩ := wc_et_mv_boundary_chosen_data n k Y U V hUVtop
      obtain ⟨γ, hγ⟩ := wc_et_mv_boundary_onto n k Y U V δ₀ hP x
        (fun DA => (wc_et_pull_data_indep U.ι DA DU (k + 1) x).trans h1)
        (fun DB => (wc_et_pull_data_indep V.ι DB DV (k + 1) x).trans h2)
      rw [← hγ, hzero k γ, map_zero]
  have hsurj : Function.Surjective
      (fun x : wcEtZModExt Y n p => (wcEtPull DU p x, wcEtPull DV p x)) := by
    rintro ⟨a, b⟩
    obtain ⟨δ₀, hP⟩ := wc_et_mv_boundary_chosen_data n p Y U V hUVtop
    obtain ⟨Da⟩ := wc_et_zmod_pull_data_exists (Y.homOfLE (inf_le_left : U ⊓ V ≤ U)) n
    obtain ⟨Db⟩ := wc_et_zmod_pull_data_exists (Y.homOfLE (inf_le_right : U ⊓ V ≤ V)) n
    have hab : wcEtPull Da p a = wcEtPull Db p b := (hzero p _).trans (hzero p _).symm
    obtain ⟨z, hz1, hz2⟩ := wc_et_mv_restr_mid_exact n p Y U V δ₀ hP a b DU DV Da Db hab
    exact ⟨z, Prod.ext hz1 hz2⟩
  refine ⟨fun x x' hxx => ?_, hsurj⟩
  have h1 : wcEtPull DU p x = wcEtPull DU p x' := congrArg Prod.fst hxx
  have h2 : wcEtPull DV p x = wcEtPull DV p x' := congrArg Prod.snd hxx
  rw [← sub_eq_zero]
  apply hker p
  · rw [map_sub, h1, sub_self]
  · rw [map_sub, h2, sub_self]

theorem wc_et_coh_prod_ring_subsingleton : ∀ (S S' : Type u) [CommRing S] [CommRing S'] (ℓ q : ℕ),
    0 < ℓ → Subsingleton (wcEtCoh (Spec (.of S)) ℓ q) → Subsingleton (wcEtCoh (Spec (.of S')) ℓ q) →
    Subsingleton (wcEtCoh (Spec (.of (S × S'))) ℓ q) :=
by
  intro S S' _ _ ℓ q hℓ hS hS'

  have s1 : ∀ (Y : Scheme.{u}) (U V : Y.Opens), Disjoint U V → U ⊔ V = ⊤ →
      Subsingleton (wcEtCoh U ℓ q) → Subsingleton (wcEtCoh V ℓ q) →
      Subsingleton (wcEtCoh Y ℓ q) := by
    intro Y U V hdisj htop hU hV
    obtain ⟨DU⟩ := wc_et_zmod_pull_data_exists U.ι ℓ
    obtain ⟨DV⟩ := wc_et_zmod_pull_data_exists V.ι ℓ
    have hbij := wc_et_zmodext_clopen_split Y U V hdisj htop ℓ hℓ DU DV q
    obtain ⟨EU⟩ := wc_et_zmodext_coh_equiv U ℓ q
    obtain ⟨EV⟩ := wc_et_zmodext_coh_equiv V ℓ q
    haveI : Subsingleton (wcEtZModExt U ℓ q) := @Equiv.subsingleton _ _ EU hU
    haveI : Subsingleton (wcEtZModExt V ℓ q) := @Equiv.subsingleton _ _ EV hV
    haveI : Subsingleton (wcEtZModExt Y ℓ q) := hbij.1.subsingleton
    obtain ⟨EY⟩ := wc_et_zmodext_coh_equiv Y ℓ q
    exact @Equiv.subsingleton _ _ EY.symm inferInstance

  have s2 : ∀ (T : Type u) [CommRing T] (f : (S × S') →+* T) (e : S × S'), IsIdempotentElem e →
      RingHom.ker f = Ideal.span {1 - e} → Function.Surjective f →
      ∀ (U : (Spec (.of (S × S'))).Opens), U = PrimeSpectrum.basicOpen e →
      Subsingleton (wcEtCoh (Spec (.of T)) ℓ q) →
      Subsingleton (wcEtCoh U ℓ q) := by
    intro T _ f e he hk hs U hU hT
    subst hU
    letI := f.toAlgebra
    haveI : IsLocalization.Away e T := IsLocalization.away_of_isIdempotentElem he hk hs
    let i := Spec.map (IsLocalization.algEquiv (Submonoid.powers e) (Localization.Away e)
          T).toRingEquiv.toCommRingCatIso.hom ≫
        (basicOpenIsoSpecAway (R := CommRingCat.of (S × S')) e).inv
    haveI : IsIso i := by dsimp only [i]; infer_instance
    obtain ⟨E⟩ := wc_et_coh_iso_invariance i ℓ q
    exact @Equiv.subsingleton _ _ E hT

  have hdisj : Disjoint (PrimeSpectrum.basicOpen ((1, 0) : S × S') : (Spec (.of (S × S'))).Opens)
      (PrimeSpectrum.basicOpen ((0, 1) : S × S')) := by
    have h : ((1, 0) : S × S') * (0, 1) = 0 := Prod.ext (by simp) (by simp)
    exact disjoint_iff.mpr (by rw [← PrimeSpectrum.basicOpen_mul, h, PrimeSpectrum.basicOpen_zero])
  have htop : (PrimeSpectrum.basicOpen ((1, 0) : S × S') : (Spec (.of (S × S'))).Opens) ⊔
      PrimeSpectrum.basicOpen ((0, 1) : S × S') = ⊤ := by
    have hsum : ((1, 0) : S × S') + (0, 1) = 1 := Prod.ext (by simp) (by simp)
    rw [eq_top_iff]
    intro x _
    rw [TopologicalSpace.Opens.mem_sup, PrimeSpectrum.mem_basicOpen, PrimeSpectrum.mem_basicOpen]
    by_contra hc
    push_neg at hc
    have h1 : (1 : S × S') ∈ x.asIdeal := hsum ▸ x.asIdeal.add_mem hc.1 hc.2
    exact x.isPrime.ne_top ((Ideal.eq_top_iff_one _).mpr h1)

  have hk : RingHom.ker (RingHom.fst S S') = Ideal.span {1 - ((1, 0) : S × S')} := by
    have hc1 : (1 : S × S') - (1, 0) = (0, 1) := Prod.ext (by simp) (by simp)
    rw [hc1]
    ext z
    rw [RingHom.mem_ker, Ideal.mem_span_singleton']
    constructor
    · intro hz
      have hz' : z.1 = 0 := hz
      exact ⟨z, Prod.ext (by simp [hz']) (by simp)⟩
    · rintro ⟨a, rfl⟩
      simp
  have hk' : RingHom.ker (RingHom.snd S S') = Ideal.span {1 - ((0, 1) : S × S')} := by
    have hc2 : (1 : S × S') - (0, 1) = (1, 0) := Prod.ext (by simp) (by simp)
    rw [hc2]
    ext z
    rw [RingHom.mem_ker, Ideal.mem_span_singleton']
    constructor
    · intro hz
      have hz' : z.2 = 0 := hz
      exact ⟨z, Prod.ext (by simp) (by simp [hz'])⟩
    · rintro ⟨a, rfl⟩
      simp
  have hU := s2 S (RingHom.fst S S') (1, 0) (Prod.ext (by simp) (by simp)) hk
    (fun s => ⟨(s, 0), rfl⟩) (PrimeSpectrum.basicOpen ((1, 0) : S × S')) rfl hS
  have hV := s2 S' (RingHom.snd S S') (0, 1) (Prod.ext (by simp) (by simp)) hk'
    (fun s => ⟨(0, s), rfl⟩) (PrimeSpectrum.basicOpen ((0, 1) : S × S')) rfl hS'
  exact s1 _ _ _ hdisj htop hU hV

theorem wc_et_coh_pi_fin_of_prod : ∀ (ℓ q : ℕ),
    (∀ (S S' : Type u) [CommRing S] [CommRing S'], Subsingleton (wcEtCoh (Spec (.of S)) ℓ q) →
      Subsingleton (wcEtCoh (Spec (.of S')) ℓ q) → Subsingleton (wcEtCoh (Spec (.of (S × S'))) ℓ q)) →
    ∀ (M : Type u) [CommRing M], Subsingleton (wcEtCoh (Spec (.of M)) ℓ q) →
    ∀ (n : ℕ), 1 ≤ n → Subsingleton (wcEtCoh (Spec (.of (Fin n → M))) ℓ q) :=
by
  intro ℓ q H M _ hM n hn
  have transport : ∀ (R T : Type u) [CommRing R] [CommRing T], (R ≃+* T) →
      Subsingleton (wcEtCoh (Spec (.of T)) ℓ q) → Subsingleton (wcEtCoh (Spec (.of R)) ℓ q) := by
    intro R T _ _ e hT
    obtain ⟨E⟩ := wc_et_coh_iso_invariance (Spec.map e.toCommRingCatIso.hom) ℓ q
    exact @Equiv.subsingleton _ _ E hT
  induction n, hn using Nat.le_induction with
  | base => exact transport (Fin 1 → M) M (RingEquiv.piUnique (fun _ : Fin 1 => M)) hM
  | succ n _ ih =>
    have e : (Fin (n + 1) → M) ≃+* M × (Fin n → M) :=
      { toFun := fun f => (f 0, Fin.tail f)
        invFun := fun p => (Fin.cons p.1 p.2 : Fin (n + 1) → M)
        left_inv := fun f => Fin.cons_self_tail f
        right_inv := fun p => by simp
        map_mul' := fun f g => rfl
        map_add' := fun f g => rfl }
    exact transport _ _ e (H M (Fin n → M) hM ih)

theorem wc_qmtm_level_offdouble_acyclic : ∀ (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A) →
    ∀ (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} →
    ∀ (r : ℕ) (R : Type u) [CommRing R] [HenselianLocalRing R]
      [IsSepClosed (IsLocalRing.ResidueField R)]
      (ρ : wcQuadModelRing A (r + 2) π (wcQmtmC A r) →+* R),
    WeaklyEtale (Spec.map (CommRingCat.ofHom ρ)) →
    ρ (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)) π) ∈ IsLocalRing.maximalIdeal R →
    ¬ (ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal R ∧
       ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal R) →
    ∀ (L : Type u) [Field L] [IsSepClosed L] (φA : A →+* L), Function.Injective φA →
    (letI := φA.toAlgebra; Algebra.IsAlgebraic A L) →
    ∀ (k q : ℕ), 1 ≤ q →
      letI : Algebra A R := (ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
      letI : Algebra A L := φA.toAlgebra
      Subsingleton (wcEtCoh (Spec (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) -
        Polynomial.C ((1 : L) ⊗ₜ[A] ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) : TensorProduct A L R))))) ℓ q) :=
by
  intro A _ _ _ _ _ ℓ _ hℓ π hπ r R _ _ _ ρ hWE hπR hoff L _ _ φA hφA halg k q hq
  letI : Algebra A R := (ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
  letI : Algebra A L := φA.toAlgebra
  have hℓpos : 0 < ℓ := (Fact.out : ℓ.Prime).pos
  have hN : 0 < ℓ ^ k := pow_pos hℓpos k
  have hℓR : IsUnit ((ℓ : ℕ) : R) := by
    have h := hℓ.map (ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r))))
    rwa [map_natCast] at h
  have hNR : IsUnit (((ℓ ^ k : ℕ)) : R) := by
    rw [Nat.cast_pow]; exact hℓR.pow k
  have hℓL : IsUnit ((ℓ : ℕ) : L) := by
    have h := hℓ.map φA
    rwa [map_natCast] at h
  have hNL : (((ℓ ^ k : ℕ)) : L) ≠ 0 := by
    rw [Nat.cast_pow]; exact (hℓL.pow k).ne_zero
  have hπ0 : π ≠ 0 := by
    intro h
    apply IsDiscreteValuationRing.not_a_field A
    rw [hπ, h, Ideal.span_singleton_eq_bot.mpr rfl]
  obtain ⟨u, hu, huN⟩ := wc_qmtm_offdouble_unit_root A π hπ0 r R ρ (ℓ ^ k) hN
    (wc_henselian_sepclosed_unit_pow_root R (ℓ ^ k) hN hNR) hoff L φA hφA hNL

  haveI : NeZero (((ℓ ^ k : ℕ)) : L) := ⟨hNL⟩
  haveI := IsSepClosed.hasEnoughRootsOfUnity L (ℓ ^ k)
  obtain ⟨ζL, hζL⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot L (ℓ ^ k)
  let ζ : TensorProduct A L R := Algebra.TensorProduct.includeLeftRingHom ζL
  have hζN : ζ ^ (ℓ ^ k) = 1 := by
    show (Algebra.TensorProduct.includeLeftRingHom ζL : TensorProduct A L R) ^ (ℓ ^ k) = 1
    rw [← map_pow, hζL.pow_eq_one, map_one]
  have hdiff : ∀ i j : ℕ, i < ℓ ^ k → j < ℓ ^ k → i ≠ j → IsUnit (ζ ^ i - ζ ^ j) := by
    intro i j hi hj hij
    have hne : ζL ^ i - ζL ^ j ≠ 0 := sub_ne_zero.mpr (fun h => hij (hζL.pow_inj hi hj h))
    have h1 := (Ne.isUnit hne).map
      (Algebra.TensorProduct.includeLeftRingHom : L →+* TensorProduct A L R)
    rw [map_sub, map_pow, map_pow] at h1
    exact h1
  obtain ⟨Φ⟩ := wc_adjoinRoot_X_pow_sub_C_pow_split (TensorProduct A L R) (ℓ ^ k) hN ζ u hζN
    hdiff hu
  rw [← huN]
  have H := wc_et_coh_pi_fin_of_prod ℓ q
    (fun S S' _ _ h₁ h₂ => wc_et_coh_prod_ring_subsingleton S S' ℓ q hℓpos h₁ h₂)
    (TensorProduct A L R)
    (wc_qmtm_offdouble_milnor_acyclic A ℓ hℓ π hπ r R ρ hWE hπR hoff L φA hφA halg q hq)
    (ℓ ^ k) (Nat.one_le_iff_ne_zero.mpr hN.ne')
  obtain ⟨E⟩ := wc_et_coh_iso_invariance (Spec.map Φ.toCommRingCatIso.hom) ℓ q
  exact @Equiv.subsingleton _ _ E H

theorem wc_qmlm_eisenstein_base : ∀ (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} → ∀ (N : ℕ), 0 < N →
    ∃ (_ : IsDomain (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)))
      (_ : IsDiscreteValuationRing (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)))
      (_ : HenselianLocalRing (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π))),
      IsSepClosed (IsLocalRing.ResidueField (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π))) ∧
      IsLocalRing.maximalIdeal (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) =
        Ideal.span {AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π)} :=
by
  intro A _ _ _ _ _ π hπ N hN
  generalize hf : Polynomial.X ^ N - Polynomial.C π = f

  have hirr : Irreducible π := (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mpr hπ
  have hπ0 : π ≠ 0 := hirr.ne_zero
  have hπnu : ¬ IsUnit π := hirr.not_isUnit
  have hπmem : π ∈ IsLocalRing.maximalIdeal A := by
    rw [hπ]; exact Ideal.mem_span_singleton_self π

  have hN0 : N ≠ 0 := Nat.pos_iff_ne_zero.mp hN
  have hmonic : f.Monic := by rw [← hf]; exact Polynomial.monic_X_pow_sub_C π hN0
  have hnatdeg : f.natDegree = N := by rw [← hf]; exact Polynomial.natDegree_X_pow_sub_C
  have hdeg : f.degree = N := by rw [← hf]; exact Polynomial.degree_X_pow_sub_C hN π
  have hs : AdjoinRoot.root f ^ N = AdjoinRoot.of f π := by
    have h : AdjoinRoot.mk f (Polynomial.X ^ N - Polynomial.C π) = 0 := by
      rw [hf]; exact AdjoinRoot.mk_self
    rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h
    exact h
  have hcoeff : ∀ n, n < N → f.coeff n ∈ IsLocalRing.maximalIdeal A := by
    intro n hn
    rw [← hf, Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C,
      if_neg (by omega)]
    split_ifs
    · rw [zero_sub]; exact (Ideal.neg_mem_iff _).mpr hπmem
    · rw [sub_zero]; exact Ideal.zero_mem _
  have hc0 : f.coeff 0 = -π := by
    rw [← hf, Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C,
      if_neg (by omega), if_pos rfl, zero_sub]

  have hP2 : f.coeff 0 ∉ (IsLocalRing.maximalIdeal A) ^ 2 := by
    rw [hc0, hπ, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
    rintro ⟨c, hc⟩
    have h1 : π * (c * π + 1) = 0 := by linear_combination hc
    rcases mul_eq_zero.mp h1 with h | h
    · exact hπ0 h
    · exact hπnu (isUnit_iff_exists_inv.mpr ⟨-c, by linear_combination -h⟩)
  have hE : f.IsEisensteinAt (IsLocalRing.maximalIdeal A) :=
    hmonic.isEisensteinAt_of_mem_of_notMem (IsLocalRing.maximalIdeal.isMaximal A).ne_top
      (fun {n} hn => hcoeff n (by rwa [hnatdeg] at hn)) hP2
  have hfirr : Irreducible f :=
    hE.irreducible (IsLocalRing.maximalIdeal.isMaximal A).isPrime hmonic.isPrimitive
      (by rw [hnatdeg]; exact hN)
  have hfprime : Prime f := hfirr.prime
  haveI hdom : IsDomain (AdjoinRoot f) := AdjoinRoot.isDomain_of_prime hfprime

  haveI : Module.Finite A (AdjoinRoot f) := hmonic.finite_adjoinRoot
  haveI : Algebra.IsIntegral A (AdjoinRoot f) := Algebra.IsIntegral.of_finite A (AdjoinRoot f)

  have hcomap : ∀ M : Ideal (AdjoinRoot f), M.IsMaximal →
      Ideal.comap (AdjoinRoot.of f) M = IsLocalRing.maximalIdeal A := by
    intro M hM
    haveI := hM
    have h1 : (Ideal.under A M).IsMaximal := Ideal.IsMaximal.under A M
    have h2 : Ideal.comap (AdjoinRoot.of f) M = Ideal.under A M := by
      rw [Ideal.under_def, AdjoinRoot.algebraMap_eq]
    rw [h2]
    exact IsLocalRing.eq_maximalIdeal h1
  have hzM : ∀ M : Ideal (AdjoinRoot f), M.IsMaximal → AdjoinRoot.root f ∈ M := by
    intro M hM
    have h1 : π ∈ Ideal.comap (AdjoinRoot.of f) M := by rw [hcomap M hM]; exact hπmem
    rw [Ideal.mem_comap, ← hs] at h1
    exact hM.isPrime.mem_of_pow_mem N h1

  have hznu : ¬ IsUnit (AdjoinRoot.root f) := by
    intro hu
    obtain ⟨M, hM⟩ := Ideal.exists_maximal (AdjoinRoot f)
    exact hM.ne_top (Ideal.eq_top_of_isUnit_mem M (hzM M hM) hu)
  have hz0 : AdjoinRoot.root f ≠ 0 := by
    intro h0
    have hd0 : f.degree ≠ 0 := by rw [hdeg]; exact_mod_cast hN0
    have hinj := AdjoinRoot.of.injective_of_degree_ne_zero hd0
    apply hπ0
    apply hinj
    rw [map_zero, ← hs, h0, zero_pow hN0]

  have hsK : AdjoinRoot.root f ^ (N - 1) * AdjoinRoot.root f = AdjoinRoot.of f π := by
    rw [← pow_succ, Nat.sub_add_cancel hN]; exact hs
  have hnon : ∀ y : AdjoinRoot f, ¬ IsUnit y ↔ y ∈ Ideal.span {AdjoinRoot.root f} := by
    intro y
    constructor
    · intro hy
      obtain ⟨p, rfl⟩ := AdjoinRoot.mk_surjective y
      obtain ⟨M, hM, hyM⟩ := exists_max_ideal_of_mem_nonunits (mem_nonunits_iff.mpr hy)
      have hdecomp : AdjoinRoot.mk f p = AdjoinRoot.root f * AdjoinRoot.mk f p.divX +
          AdjoinRoot.of f (p.coeff 0) := by
        conv_lhs => rw [← Polynomial.X_mul_divX_add p]
        rw [map_add, map_mul, AdjoinRoot.mk_X, AdjoinRoot.mk_C]
      have ha0' : AdjoinRoot.of f (p.coeff 0) =
          AdjoinRoot.mk f p - AdjoinRoot.root f * AdjoinRoot.mk f p.divX := by
        linear_combination -hdecomp
      have ha0 : AdjoinRoot.of f (p.coeff 0) ∈ M := by
        rw [ha0']
        exact M.sub_mem hyM (M.mul_mem_right (AdjoinRoot.mk f p.divX) (hzM M hM))
      have ha0P : p.coeff 0 ∈ Ideal.span {π} := by
        rw [← hπ, ← hcomap M hM, Ideal.mem_comap]; exact ha0
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp ha0P
      rw [Ideal.mem_span_singleton']
      refine ⟨AdjoinRoot.mk f p.divX + AdjoinRoot.of f b * AdjoinRoot.root f ^ (N - 1), ?_⟩
      rw [hdecomp, ← hb, map_mul, ← hsK]
      ring
    · intro hy hu
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      exact hznu (isUnit_of_mul_isUnit_right hu)

  haveI hloc : IsLocalRing (AdjoinRoot f) := IsLocalRing.of_nonunits_add (fun a b ha hb => by
    rw [mem_nonunits_iff, hnon] at ha hb ⊢
    exact Ideal.add_mem _ ha hb)
  have hmax : IsLocalRing.maximalIdeal (AdjoinRoot f) = Ideal.span {AdjoinRoot.root f} := by
    ext r
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, hnon]

  obtain ⟨hH, hSep⟩ := wc_integral_over_strictly_henselian A (AdjoinRoot f) inferInstance

  have hnf : ¬ IsField (AdjoinRoot f) := by
    intro hF
    have := (IsLocalRing.isField_iff_maximalIdeal_eq).mp hF
    rw [hmax, Ideal.span_singleton_eq_bot] at this
    exact hz0 this
  have hprin : (IsLocalRing.maximalIdeal (AdjoinRoot f)).IsPrincipal := ⟨⟨_, hmax⟩⟩
  have hdvr : IsDiscreteValuationRing (AdjoinRoot f) :=
    ((IsDiscreteValuationRing.TFAE (AdjoinRoot f) hnf).out 1 5).mpr hprin

  exact ⟨hdom, hdvr, hH, hSep, hmax⟩

theorem wc_qmlm_tensor_local : ∀ (Q R Q' : Type u) [CommRing Q] [CommRing R] [CommRing Q'] [IsLocalRing R]
    [Algebra Q R] [Algebra Q Q'] (s : Set Q') (N : ℕ), 0 < N →
    (∀ v ∈ s, ∃ q : Q, v ^ N = algebraMap Q Q' q ∧ algebraMap Q R q ∈ IsLocalRing.maximalIdeal R) →
    Algebra.adjoin Q s = ⊤ →
    (∃ ψ : Q' →+* IsLocalRing.ResidueField R,
      ψ.comp (algebraMap Q Q') = (IsLocalRing.residue R).comp (algebraMap Q R)) →
    ∃ (_ : IsLocalRing (TensorProduct Q R Q')),
      Algebra.IsIntegral R (TensorProduct Q R Q') ∧
      ∀ v ∈ s, (Algebra.TensorProduct.includeRight v : TensorProduct Q R Q') ∈
        IsLocalRing.maximalIdeal (TensorProduct Q R Q') :=
by
  intro Q R Q' _ _ _ _ _ _ s N hN hs hadj hψ
  classical

  have hQ'int : Algebra.IsIntegral Q Q' := by
    have hsub : Algebra.adjoin Q s ≤ (integralClosure Q Q') := by
      rw [Algebra.adjoin_le_iff]
      intro v hv
      obtain ⟨q, hq, _⟩ := hs v hv
      have h1 : IsIntegral Q (v ^ N) := by rw [hq]; exact isIntegral_algebraMap
      exact IsIntegral.of_pow hN h1
    refine ⟨fun x => ?_⟩
    have hx : x ∈ Algebra.adjoin Q s := by rw [hadj]; exact Algebra.mem_top
    exact hsub hx
  have hint : Algebra.IsIntegral R (TensorProduct Q R Q') :=
    Algebra.IsIntegral.tensorProduct Q R Q'

  have hιalg : ∀ q : Q, (Algebra.TensorProduct.includeRight : Q' →ₐ[Q] TensorProduct Q R Q')
      (algebraMap Q Q' q) = algebraMap R (TensorProduct Q R Q') (algebraMap Q R q) := by
    intro q
    rw [AlgHom.commutes]
    exact IsScalarTower.algebraMap_apply Q R (TensorProduct Q R Q') q

  have hdecomp : ∀ t : TensorProduct Q R Q', ∃ r : R,
      t - algebraMap R (TensorProduct Q R Q') r ∈ Ideal.span
        ((fun v => (Algebra.TensorProduct.includeRight v : TensorProduct Q R Q')) '' s) := by
    have padd : ∀ t₁ t₂ : TensorProduct Q R Q',
        (∃ r : R, t₁ - algebraMap R (TensorProduct Q R Q') r ∈ Ideal.span
          ((fun v => (Algebra.TensorProduct.includeRight v : TensorProduct Q R Q')) '' s)) →
        (∃ r : R, t₂ - algebraMap R (TensorProduct Q R Q') r ∈ Ideal.span
          ((fun v => (Algebra.TensorProduct.includeRight v : TensorProduct Q R Q')) '' s)) →
        (∃ r : R, t₁ + t₂ - algebraMap R (TensorProduct Q R Q') r ∈ Ideal.span
          ((fun v => (Algebra.TensorProduct.includeRight v : TensorProduct Q R Q')) '' s)) := by
      rintro t₁ t₂ ⟨r₁, h₁⟩ ⟨r₂, h₂⟩
      refine ⟨r₁ + r₂, ?_⟩
      have e : t₁ + t₂ - algebraMap R (TensorProduct Q R Q') (r₁ + r₂) =
          (t₁ - algebraMap R (TensorProduct Q R Q') r₁) +
            (t₂ - algebraMap R (TensorProduct Q R Q') r₂) := by
        rw [map_add]; ring
      rw [e]
      exact Ideal.add_mem _ h₁ h₂
    have pmul : ∀ t₁ t₂ : TensorProduct Q R Q',
        (∃ r : R, t₁ - algebraMap R (TensorProduct Q R Q') r ∈ Ideal.span
          ((fun v => (Algebra.TensorProduct.includeRight v : TensorProduct Q R Q')) '' s)) →
        (∃ r : R, t₂ - algebraMap R (TensorProduct Q R Q') r ∈ Ideal.span
          ((fun v => (Algebra.TensorProduct.includeRight v : TensorProduct Q R Q')) '' s)) →
        (∃ r : R, t₁ * t₂ - algebraMap R (TensorProduct Q R Q') r ∈ Ideal.span
          ((fun v => (Algebra.TensorProduct.includeRight v : TensorProduct Q R Q')) '' s)) := by
      rintro t₁ t₂ ⟨r₁, h₁⟩ ⟨r₂, h₂⟩
      refine ⟨r₁ * r₂, ?_⟩
      have e : t₁ * t₂ - algebraMap R (TensorProduct Q R Q') (r₁ * r₂) =
          (t₁ - algebraMap R (TensorProduct Q R Q') r₁) * t₂ +
            algebraMap R (TensorProduct Q R Q') r₁ *
              (t₂ - algebraMap R (TensorProduct Q R Q') r₂) := by
        rw [map_mul]; ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ h₁) (Ideal.mul_mem_left _ _ h₂)
    have hA : ∀ x : Q', ∃ r : R,
        (Algebra.TensorProduct.includeRight : Q' →ₐ[Q] TensorProduct Q R Q') x -
          algebraMap R (TensorProduct Q R Q') r ∈ Ideal.span
          ((fun v => (Algebra.TensorProduct.includeRight v : TensorProduct Q R Q')) '' s) := by
      intro x
      have hx : x ∈ Algebra.adjoin Q s := by rw [hadj]; exact Algebra.mem_top
      induction hx using Algebra.adjoin_induction with
      | mem v hv =>
        refine ⟨0, ?_⟩
        rw [map_zero, sub_zero]
        exact Ideal.subset_span ⟨v, hv, rfl⟩
      | algebraMap q =>
        refine ⟨algebraMap Q R q, ?_⟩
        rw [hιalg, sub_self]
        exact Ideal.zero_mem _
      | add x y _ _ hx hy =>
        rw [map_add]; exact padd _ _ hx hy
      | mul x y _ _ hx hy =>
        rw [map_mul]; exact pmul _ _ hx hy
    intro t
    induction t using TensorProduct.induction_on with
    | zero => exact ⟨0, by rw [map_zero, sub_zero]; exact Ideal.zero_mem _⟩
    | tmul r x =>
      have e : (r ⊗ₜ[Q] x : TensorProduct Q R Q') = algebraMap R (TensorProduct Q R Q') r *
          (Algebra.TensorProduct.includeRight : Q' →ₐ[Q] TensorProduct Q R Q') x := by
        rw [Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.includeRight_apply,
          Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
        rfl
      rw [e]
      exact pmul _ _ ⟨r, by rw [sub_self]; exact Ideal.zero_mem _⟩ (hA x)
    | add t₁ t₂ h₁ h₂ => exact padd _ _ h₁ h₂

  have hmax : ∀ M : Ideal (TensorProduct Q R Q'), M.IsMaximal →
      (∀ r : R, algebraMap R (TensorProduct Q R Q') r ∈ M ↔ r ∈ IsLocalRing.maximalIdeal R) ∧
      Ideal.span ((fun v => (Algebra.TensorProduct.includeRight v : TensorProduct Q R Q')) '' s)
        ≤ M := by
    intro M hM
    have hc : (Ideal.comap (algebraMap R (TensorProduct Q R Q')) M).IsMaximal :=
      Ideal.isMaximal_comap_of_isIntegral_of_isMaximal (algebraMap R (TensorProduct Q R Q'))
        (fun x => Algebra.IsIntegral.isIntegral x) M
    have hc' : Ideal.comap (algebraMap R (TensorProduct Q R Q')) M = IsLocalRing.maximalIdeal R :=
      IsLocalRing.eq_maximalIdeal hc
    have h1 : ∀ r : R, algebraMap R (TensorProduct Q R Q') r ∈ M ↔
        r ∈ IsLocalRing.maximalIdeal R := by
      intro r
      rw [← hc', Ideal.mem_comap]
    refine ⟨h1, ?_⟩
    rw [Ideal.span_le]
    rintro _ ⟨v, hv, rfl⟩
    obtain ⟨q, hq, hqm⟩ := hs v hv
    have hpow : ((Algebra.TensorProduct.includeRight : Q' →ₐ[Q] TensorProduct Q R Q') v) ^ N ∈ M := by
      rw [← map_pow, hq, hιalg]
      exact (h1 _).2 hqm
    exact hM.isPrime.mem_of_pow_mem N hpow

  have huniq : ∀ M₁ M₂ : Ideal (TensorProduct Q R Q'), M₁.IsMaximal → M₂.IsMaximal → M₁ = M₂ := by
    intro M₁ M₂ h₁ h₂
    obtain ⟨a1, J1⟩ := hmax M₁ h₁
    obtain ⟨a2, J2⟩ := hmax M₂ h₂
    ext t
    obtain ⟨r, hr⟩ := hdecomp t
    have e : ∀ M : Ideal (TensorProduct Q R Q'),
        Ideal.span ((fun v => (Algebra.TensorProduct.includeRight v : TensorProduct Q R Q')) '' s)
          ≤ M → (t ∈ M ↔ algebraMap R (TensorProduct Q R Q') r ∈ M) := by
      intro M hJ
      constructor
      · intro ht
        have h3 := M.sub_mem ht (hJ hr)
        rwa [sub_sub_cancel] at h3
      · intro har
        have h3 := M.add_mem har (hJ hr)
        rwa [add_sub_cancel] at h3
    rw [e M₁ J1, e M₂ J2, a1, a2]

  obtain ⟨ψ, hψ⟩ := hψ
  have hnt : Nontrivial (TensorProduct Q R Q') := by
    let _ : Algebra Q (IsLocalRing.ResidueField R) :=
      ((IsLocalRing.residue R).comp (algebraMap Q R)).toAlgebra
    let f' : R →ₐ[Q] IsLocalRing.ResidueField R :=
      { IsLocalRing.residue R with commutes' := fun q => rfl }
    let g' : Q' →ₐ[Q] IsLocalRing.ResidueField R :=
      { ψ with commutes' := fun q => RingHom.congr_fun hψ q }
    exact RingHom.domain_nontrivial
      ((Algebra.TensorProduct.productMap f' g' : TensorProduct Q R Q' →ₐ[Q] _) :
        TensorProduct Q R Q' →+* IsLocalRing.ResidueField R)
  obtain ⟨M₀, hM₀⟩ := Ideal.exists_maximal (TensorProduct Q R Q')
  have hloc : IsLocalRing (TensorProduct Q R Q') :=
    IsLocalRing.of_unique_max_ideal ⟨M₀, hM₀, fun M hM => huniq M M₀ hM hM₀⟩
  refine ⟨hloc, hint, fun v hv => ?_⟩
  exact (hmax _ (IsLocalRing.maximalIdeal.isMaximal _)).2 (Ideal.subset_span ⟨v, hv, rfl⟩)

theorem wc_qmlm_level_tensor_iso : ∀ (A : Type u) [CommRing A] (π : A) (r N : ℕ), 0 < N →
    (∑ p : Fin (r + 2), ∑ q : Fin (r + 2), MvPolynomial.C (wcQmtmC A r p q) * MvPolynomial.X p *
        MvPolynomial.X q : MvPolynomial (Fin (r + 2)) A) =
      MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) →
    (∑ p : Fin (r + 2), ∑ q : Fin (r + 2),
        MvPolynomial.C (wcQmtmC (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) r p q) *
          MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin (r + 2)) (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π))) =
      MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) * MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) →
    ∀ (R : Type u) [CommRing R] (ρ : wcQuadModelRing A (r + 2) π (wcQmtmC A r) →+* R)
      (L : Type u) [Field L] (φA : A →+* L)
      (φ' : AdjoinRoot (Polynomial.X ^ N - Polynomial.C π) →+* L),
    φ'.comp (AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C π)) = φA →
    φ' (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π)) ≠ 0 →
    ∀ (θ : wcQuadModelRing A (r + 2) π (wcQmtmC A r) →+*
        wcQuadModelRing (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) (r + 2)
          (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π))
          (wcQmtmC (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) r)),
    θ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r))) =
        (algebraMap (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π))
          (wcQuadModelRing (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) (r + 2)
            (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π))
            (wcQmtmC (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) r))).comp
          (AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C π)) →
    θ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) =
        Ideal.Quotient.mk (wcQuadModelIdeal (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) (r + 2)
          (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π))
          (wcQmtmC (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ^ N →
    θ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) =
        Ideal.Quotient.mk (wcQuadModelIdeal (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) (r + 2)
          (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π))
          (wcQmtmC (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) r))
          (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ^ N →
    (∀ i : Fin (r + 2), 2 ≤ i.val →
        θ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r)) (MvPolynomial.X i)) =
          Ideal.Quotient.mk (wcQuadModelIdeal (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) (r + 2)
            (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π))
            (wcQmtmC (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) r)) (MvPolynomial.X i)) →
    ∀ (C : Type u) [CommRing C] (κR : R →+* C)
      (κQ : wcQuadModelRing (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) (r + 2)
          (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π))
          (wcQmtmC (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) r) →+* C),
    κR.comp ρ = κQ.comp θ →
    (∀ (T : Type u) [CommRing T] (f : R →+* T)
        (g : wcQuadModelRing (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) (r + 2)
          (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π))
          (wcQmtmC (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) r) →+* T),
        f.comp ρ = g.comp θ → ∃! h : C →+* T, h.comp κR = f ∧ h.comp κQ = g) →
    letI : Algebra A R := (ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
    letI : Algebra A L := φA.toAlgebra
    letI : Algebra (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) C :=
      (κQ.comp (algebraMap (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π))
        (wcQuadModelRing (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) (r + 2)
          (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π))
          (wcQmtmC (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) r)))).toAlgebra
    letI : Algebra (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) L := φ'.toAlgebra
    Nonempty (AdjoinRoot (Polynomial.X ^ N -
        Polynomial.C ((1 : L) ⊗ₜ[A] ρ (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) : TensorProduct A L R)) ≃+*
      TensorProduct (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) L C) :=
by
  intro A _ π r N hN hA hA' R _ ρ L _ φA φ' hφ'A hzL θ hθA hθ0 hθ1 hθi C _ κR κQ hpo1 hpo2
  letI iAR : Algebra A R :=
    (ρ.comp (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
  letI iAL : Algebra A L := φA.toAlgebra
  letI iA'C : Algebra (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) C :=
    (κQ.comp (algebraMap (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π))
      (wcQuadModelRing (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) (r + 2)
        (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π))
        (wcQmtmC (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) r)))).toAlgebra
  letI iA'L : Algebra (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) L := φ'.toAlgebra
  obtain ⟨n, hn⟩ : ∃ n, N = n + 1 := ⟨N - 1, by omega⟩
  have hpowN : ∀ {M : Type u} [Monoid M] (t : M), t ^ N = t * t ^ n := by
    intro M _ t; rw [hn, pow_succ']
  have hid : ∀ {M : Type u} [CommRing M] (u v w : M), u * v = w → v ^ N * u ^ n = w ^ n * v := by
    intro M _ u v w h; rw [← h, hn]; ring
  have hid2 : ∀ {M : Type u} [CommRing M] (u v : M), u * (v * u ^ n) = u ^ N * v := by
    intro M _ u v; rw [hn]; ring

  have tlift : ∀ (S X Y T : Type u) [CommRing S] [CommRing X] [CommRing Y] [CommRing T]
      [Algebra S X] [Algebra S Y] (f : X →+* T) (g : Y →+* T),
      f.comp (algebraMap S X) = g.comp (algebraMap S Y) →
      ∃ h : TensorProduct S X Y →+* T, ∀ x y, h (x ⊗ₜ[S] y) = f x * g y := by
    intro S X Y T _ _ _ _ _ _ f g hfg
    letI : Algebra S T := (f.comp (algebraMap S X)).toAlgebra
    let f' : X →ₐ[S] T := { f with commutes' := fun s => rfl }
    let g' : Y →ₐ[S] T := { g with commutes' := fun s => (RingHom.congr_fun hfg s).symm }
    refine ⟨(Algebra.TensorProduct.productMap f' g').toRingHom, fun x y => ?_⟩
    simp [f', g']
  have text : ∀ (S X Y T : Type u) [CommRing S] [CommRing X] [CommRing Y] [CommRing T]
      [Algebra S X] [Algebra S Y] (h1 h2 : TensorProduct S X Y →+* T),
      (∀ x y, h1 (x ⊗ₜ[S] y) = h2 (x ⊗ₜ[S] y)) → h1 = h2 := by
    intro S X Y T _ _ _ _ _ _ h1 h2 H
    apply RingHom.ext
    intro w
    induction w using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero]
    | tmul x y => exact H x y
    | add x y hx hy => rw [map_add, map_add, hx, hy]

  have hzN : AdjoinRoot.of (Polynomial.X ^ N - Polynomial.C π) π =
      AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π) ^ N := by
    have h := AdjoinRoot.eval₂_root (Polynomial.X ^ N - Polynomial.C π)
    rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, sub_eq_zero] at h
    exact h.symm
  have hrel : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) *
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) =
      algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)) π := by
    rw [← map_mul, ← hA]
    change _ = Ideal.Quotient.mk _ (MvPolynomial.C π)
    exact Ideal.Quotient.eq.mpr (Ideal.subset_span rfl)
  have hrel' : Ideal.Quotient.mk (wcQuadModelIdeal (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) (r + 2)
          (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π))
          (wcQmtmC (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) *
      Ideal.Quotient.mk (wcQuadModelIdeal (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) (r + 2)
          (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π))
          (wcQmtmC (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) r))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) =
      algebraMap (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π))
        (wcQuadModelRing (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) (r + 2)
          (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π))
          (wcQmtmC (AdjoinRoot (Polynomial.X ^ N - Polynomial.C π)) r))
        (AdjoinRoot.root (Polynomial.X ^ N - Polynomial.C π)) := by
    rw [← map_mul, ← hA']
    change _ = Ideal.Quotient.mk _ (MvPolynomial.C _)
    exact Ideal.Quotient.eq.mpr (Ideal.subset_span rfl)
