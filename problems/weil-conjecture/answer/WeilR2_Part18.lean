theorem wc_qmtx1u_kummer_sec_equivariance {A B L : Type u} [CommRing A] [CommRing B] [Field L]
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] {φA : A →+* L} {σ : L →+* L} {XE : Scheme.{u}}
    {p : XE ⟶ Spec (.of B)} {q : XE ⟶ Spec (.of L)} {w : XE ⟶ XE} {x₀ : B}
    (T : wcQmtmTower ℓ φA σ p q w x₀) (hw₁ : w ≫ p = p)
    (hw₂ : w ≫ q = q ≫ Spec.map (CommRingCat.ofHom σ)) (hζσ : ∀ k, σ (T.ζ k) = T.ζ k)
    (Vt : (Spec (.of B)).ProEt) (v : ℕ → Γ(Limits.pullback Vt.hom p, ⊤))
    (sc : ℤ_[ℓ] → (Limits.pullback Vt.hom p ⟶
      Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi))
    (hsc : wcQx1uKummerChar T Vt sc v) (t : ℤ_[ℓ])
    (hvw : ∀ k, (Limits.pullback.lift (Limits.pullback.fst Vt.hom p)
        (Limits.pullback.snd Vt.hom p ≫ w)
        (by rw [Category.assoc, hw₁]; exact Limits.pullback.condition)).appTop.hom (v k) =
      (Limits.pullback.snd Vt.hom p ≫ q).appTop.hom
          ((Scheme.ΓSpecIso (.of L)).inv.hom (T.ζ k)) ^ (PadicInt.toZModPow k t).val * v k)
    (γs : T.XEi ⟶ T.XEi)
    (Rs : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+*
      AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))
    (hT2 : ∀ (a : ℤ) (k : ℕ) (c : L),
      Rs (AddMonoidAlgebra.single
          (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c) =
        AddMonoidAlgebra.single
          (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))
          (T.ζ k ^ (a * ((PadicInt.toZModPow k (-t)).val : ℤ)) * c))
    (hT3 : γs ≫ T.gi = T.gi ≫ Spec.map (CommRingCat.ofHom Rs)) :
    (∀ κ : Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi ⟶
        Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi,
      κ ≫ Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi =
        Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi →
      κ ≫ Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi =
        Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi ≫ γs →
      ∀ a : ℤ_[ℓ], sc a ≫ κ = sc (a - t)) ∧
    (∀ Ξ : Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi ⟶
        Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi,
      Ξ ≫ Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi =
        Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi ≫
          Limits.pullback.lift (Limits.pullback.fst Vt.hom p) (Limits.pullback.snd Vt.hom p ≫ w)
            (by rw [Category.assoc, hw₁]; exact Limits.pullback.condition) →
      Ξ ≫ Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi =
        Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi ≫ T.wi →
      ∀ a : ℤ_[ℓ], sc a ≫ Ξ =
        Limits.pullback.lift (Limits.pullback.fst Vt.hom p) (Limits.pullback.snd Vt.hom p ≫ w)
          (by rw [Category.assoc, hw₁]; exact Limits.pullback.condition) ≫ sc (a - t)) :=
by
  classical
  obtain ⟨hsc1, hsc2⟩ := hsc

  have s0 : ∀ {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S) (y : R),
      (Spec.map (CommRingCat.ofHom f)).appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom y) =
        (Scheme.ΓSpecIso (.of S)).inv.hom (f y) := by
    intro R S _ _ f y
    have h := congrArg (fun φ => φ.hom y)
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom f))
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h
    exact h.symm

  have gen : ∀ {R : Type u} [CommRing R] (A₁ B₁ U U' : R),
      A₁ * U = 1 → B₁ * U' = 1 → U = U' → A₁ = B₁ := by
    intro R _ A₁ B₁ U U' ha hb hp
    linear_combination B₁ * ha - A₁ * hb - (A₁ * B₁) * hp

  have extG : ∀ {R : Type u} [CommRing R]
      (α β : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)) →+* R),
      (∀ (m k : ℕ) (c : L),
        α (AddMonoidAlgebra.single
          (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c) =
        β (AddMonoidAlgebra.single
          (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c)) →
      α = β := by
    intro R _ α β h
    apply AddMonoidAlgebra.ringHom_ext
    · intro r
      have e : (0 : Localization.Away (ℓ : ℤ)) =
          (Localization.mk ((0 : ℕ) : ℤ) ⟨(ℓ : ℤ) ^ 0, 0, rfl⟩ : Localization.Away (ℓ : ℤ)) := by
        rw [Nat.cast_zero, Localization.mk_zero]
      rw [e]
      exact h 0 0 r
    · have key : ∀ (a : ℤ) (k : ℕ),
          α (AddMonoidAlgebra.single
            (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) (1 : L)) =
          β (AddMonoidAlgebra.single
            (Localization.mk a ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) (1 : L)) := by
        intro a k
        obtain ⟨n, rfl | rfl⟩ := Int.eq_nat_or_neg a
        · exact h n k 1
        · have hinv : AddMonoidAlgebra.single
              (Localization.mk (-(n : ℤ)) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))
              (1 : L) *
              AddMonoidAlgebra.single
              (Localization.mk (n : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ))
              (1 : L) = 1 := by
            rw [AddMonoidAlgebra.single_mul_single, Localization.add_mk_self, neg_add_cancel,
              Localization.mk_zero, mul_one, AddMonoidAlgebra.one_def]
          exact gen _ _ _ _ (by rw [← map_mul, hinv, map_one]) (by rw [← map_mul, hinv, map_one])
            (h n k 1)
      intro x
      induction x using Localization.induction_on with
      | H y =>
        obtain ⟨a, s, hs⟩ := y
        obtain ⟨k, rfl⟩ := (Submonoid.mem_powers_iff _ _).mp hs
        exact key a k

  have s1 : ∀ (f g : Limits.pullback Vt.hom p ⟶
        Limits.pullback (Limits.pullback.snd Vt.hom p) T.πi),
      f ≫ Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi =
        g ≫ Limits.pullback.fst (Limits.pullback.snd Vt.hom p) T.πi →
      (∀ (m k : ℕ) (c : L),
        (f ≫ Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi ≫ T.gi).appTop.hom
          ((Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
            (AddMonoidAlgebra.single
              (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c)) =
        (g ≫ Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi ≫ T.gi).appTop.hom
          ((Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
            (AddMonoidAlgebra.single
              (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c))) →
      f = g := by
    intro f g h1 h2
    apply Limits.pullback.hom_ext h1
    apply T.hT.hom_ext
    · rw [Category.assoc, Category.assoc, ← Limits.pullback.condition, ← Category.assoc, h1,
