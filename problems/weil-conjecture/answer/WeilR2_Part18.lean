    (wcRingSheaf S ℓ)).obj (SheafOfModules.unit (wcRingSheaf S ℓ)))).2
    (1 : (wcRingSheaf S ℓ).obj.obj (Opposite.op (Scheme.ProEt.mk (𝟙 S))))
  let ε : wcFreeSheaf S (Scheme.ProEt.mk (𝟙 S)) ⟶ (SheafOfModules.toSheaf.{u+1}
