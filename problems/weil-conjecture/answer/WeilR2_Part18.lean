            (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])))) =
      ((wcSliceUnit S' ℓ ((wcProEtBC w).obj V)).val.app
          (Opposite.op ((wcProEtBC (Limits.pullback.fst V.hom w)).obj T))).hom
        (((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC (Limits.pullback.fst V.hom w)) _ _ D.cont D.φ).val.app
            (Opposite.op T)).hom (1 : C(↥T.left, ULift.{u+1} ℚ_[ℓ])))
    rw [e1, e2, e5 T, e6]
    refine (hβ _ T ζ hζf hζs _).trans ?_
    exact PresheafOfModules.unit_map_one _ ζ.op

theorem ext_tsf_bc_mate_chase {A : Type*} [Category A] [Abelian A] [HasExt A]
    {B : Type*} [Category B] [Abelian B] [HasExt B]
    {C : Type*} [Category C] [Abelian C] [HasExt C]
    {Φw Pw : A ⥤ A} (adjw : Φw ⊣ Pw) {ΦD : B ⥤ C} {PD : C ⥤ B} (adjD : ΦD ⊣ PD)
    (ρ : A ⥤ B) (ρ' : A ⥤ C)
    [Φw.Additive] [Limits.PreservesFiniteLimits Φw] [Limits.PreservesFiniteColimits Φw]
    [ΦD.Additive] [Limits.PreservesFiniteLimits ΦD] [Limits.PreservesFiniteColimits ΦD]
    [ρ.Additive] [Limits.PreservesFiniteLimits ρ] [Limits.PreservesFiniteColimits ρ]
    [ρ'.Additive] [Limits.PreservesFiniteLimits ρ'] [Limits.PreservesFiniteColimits ρ']
    (β : Pw ⋙ ρ ⟶ ρ' ⋙ PD) (X X' O : A) (OB : B) (OC : C)
    (ε : OB ⟶ ρ.obj X) (u : OB ⟶ ρ.obj O) [IsIso u]
    (ε' : OC ⟶ ρ'.obj X') (u' : OC ⟶ ρ'.obj O) [IsIso u']
    (κ : X' ⟶ Φw.obj X) (e : Φw.obj O ⟶ O) (ηw : O ⟶ Pw.obj O)
    (he : e = (adjw.homEquiv O O).symm ηw)
    (ηD : OB ⟶ PD.obj OC) [IsIso ((adjD.homEquiv OB OC).symm ηD)] (μ : ΦD.obj OB ≅ OC) :
    ε ≫ ρ.map (adjw.unit.app X) ≫ β.app (Φw.obj X) = ηD ≫ PD.map (ε' ≫ ρ'.map κ) →
    u ≫ ρ.map ηw ≫ β.app O = ηD ≫ PD.map u' →
    (∀ (c : OC ⟶ OC) (n : ℕ) (y : Abelian.Ext OC OC n),
      (Abelian.Ext.mk₀ c).comp y (zero_add n) = y.comp (Abelian.Ext.mk₀ c) (add_zero n)) →
    ∀ (q : ℕ) (b : Abelian.Ext X O q),
      ((Abelian.Ext.mk₀ ε').comp (Abelian.Ext.mapExactFunctor ρ'
          ((Abelian.Ext.mk₀ κ).comp ((Abelian.Ext.mapExactFunctor Φw b).comp
            (Abelian.Ext.mk₀ e) (add_zero q)) (zero_add q))) (zero_add q)).comp
          (Abelian.Ext.mk₀ (inv u')) (add_zero q) =
        (Abelian.Ext.mk₀ μ.inv).comp ((Abelian.Ext.mapExactFunctor ΦD
          (((Abelian.Ext.mk₀ ε).comp (Abelian.Ext.mapExactFunctor ρ b) (zero_add q)).comp
            (Abelian.Ext.mk₀ (inv u)) (add_zero q))).comp (Abelian.Ext.mk₀ μ.hom) (add_zero q))
          (zero_add q) :=
by
  intro H1 H2 Hc q b
  set ν := (adjD.homEquiv OB OC).symm ηD with hν
  have hνη : adjD.homEquiv OB OC ν = ηD := Equiv.apply_symm_apply _ _

  obtain ⟨σ, hU⟩ : ∃ σ : ρ ⋙ ΦD ⟶ Φw ⋙ ρ', ∀ M : A,
      ρ.map (adjw.unit.app M) ≫ β.app (Φw.obj M) =
        adjD.unit.app (ρ.obj M) ≫ PD.map (σ.app M) := by
    refine ⟨(mateEquiv adjw adjD).symm β, fun M => ?_⟩
    have := unit_mateEquiv adjw adjD ((mateEquiv adjw adjD).symm β) M
    have e0 : (mateEquiv adjw adjD) ((mateEquiv adjw adjD).symm β) = β :=
      (mateEquiv adjw adjD).apply_symm_apply β
    rw [e0] at this
    exact this

  have G1 : ΦD.map ε ≫ σ.app X = ν ≫ ε' ≫ ρ'.map κ := by
    have h1 : adjD.homEquiv OB (ρ'.obj (Φw.obj X)) (ΦD.map ε ≫ σ.app X) =
        ε ≫ adjD.unit.app (ρ.obj X) ≫ PD.map (σ.app X) := by
      rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_unit]
    have h2 : adjD.homEquiv OB (ρ'.obj (Φw.obj X)) (ν ≫ ε' ≫ ρ'.map κ) =
        ηD ≫ PD.map (ε' ≫ ρ'.map κ) := by
      rw [Adjunction.homEquiv_naturality_right, hνη]
    apply (adjD.homEquiv OB (ρ'.obj (Φw.obj X))).injective
    rw [h1, h2, ← hU X, H1]

  have hηw : adjw.unit.app O ≫ Pw.map e = ηw := by
    rw [he]
    exact (adjw.homEquiv_unit O O _).symm.trans (Equiv.apply_symm_apply _ _)
  have hn : ρ.map (Pw.map e) ≫ β.app O = β.app (Φw.obj O) ≫ PD.map (ρ'.map e) :=
    β.naturality e
  have hK : ρ.map ηw ≫ β.app O =
      adjD.unit.app (ρ.obj O) ≫ PD.map (σ.app O ≫ ρ'.map e) := by
    calc ρ.map ηw ≫ β.app O
        = ρ.map (adjw.unit.app O) ≫ (ρ.map (Pw.map e) ≫ β.app O) := by
          rw [← hηw, Functor.map_comp, Category.assoc]
      _ = (ρ.map (adjw.unit.app O) ≫ β.app (Φw.obj O)) ≫ PD.map (ρ'.map e) := by
          rw [hn, Category.assoc]
      _ = adjD.unit.app (ρ.obj O) ≫ PD.map (σ.app O ≫ ρ'.map e) := by
          rw [hU O, Category.assoc, Functor.map_comp]
  have G2 : ΦD.map u ≫ σ.app O ≫ ρ'.map e = ν ≫ u' := by
    have h1 : adjD.homEquiv OB (ρ'.obj O) (ΦD.map u ≫ σ.app O ≫ ρ'.map e) =
        u ≫ adjD.unit.app (ρ.obj O) ≫ PD.map (σ.app O ≫ ρ'.map e) := by
      rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_unit]
    have h2 : adjD.homEquiv OB (ρ'.obj O) (ν ≫ u') = ηD ≫ PD.map u' := by
      rw [Adjunction.homEquiv_naturality_right, hνη]
    apply (adjD.homEquiv OB (ρ'.obj O)).injective
    rw [h1, h2, ← hK, H2]

  have hZ : ΦD.map (inv u) ≫ μ.hom =
      σ.app O ≫ (ρ'.map e ≫ inv u' ≫ inv ν ≫ μ.hom) := by
    have h3 : σ.app O ≫ ρ'.map e = ΦD.map (inv u) ≫ ν ≫ u' := by
      rw [← G2, ← Category.assoc, ← Functor.map_comp, IsIso.inv_hom_id,
        CategoryTheory.Functor.map_id, Category.id_comp]
    rw [← Category.assoc, h3]
    simp

  have R0 : ∀ {P Q R S : C} {n : ℕ} (x : Abelian.Ext P Q n) (f : Q ⟶ R) (g : R ⟶ S),
      (x.comp (Abelian.Ext.mk₀ f) (add_zero n)).comp (Abelian.Ext.mk₀ g) (add_zero n) =
        x.comp (Abelian.Ext.mk₀ (f ≫ g)) (add_zero n) := by
    intro P Q R S n x f g
    rw [Abelian.Ext.comp_assoc_of_third_deg_zero, Abelian.Ext.mk₀_comp_mk₀]
  have hnat : (Abelian.Ext.mapExactFunctor ΦD (Abelian.Ext.mapExactFunctor ρ b)).comp
      (Abelian.Ext.mk₀ (σ.app O)) (add_zero q) =
      (Abelian.Ext.mk₀ (σ.app X)).comp
        (Abelian.Ext.mapExactFunctor ρ' (Abelian.Ext.mapExactFunctor Φw b)) (zero_add q) := by
    rw [← Abelian.Ext.comp_mapExactFunctor, ← Abelian.Ext.comp_mapExactFunctor]
    exact Abelian.Ext.mapExactFunctor_comp_mk₀_natTransApp b σ
  have hRHS : (Abelian.Ext.mapExactFunctor ΦD (Abelian.Ext.mapExactFunctor ρ b)).comp
      (Abelian.Ext.mk₀ (ΦD.map (inv u) ≫ μ.hom)) (add_zero q) =
      (Abelian.Ext.mk₀ (σ.app X)).comp
        ((Abelian.Ext.mapExactFunctor ρ' (Abelian.Ext.mapExactFunctor Φw b)).comp
          (Abelian.Ext.mk₀ (ρ'.map e ≫ inv u' ≫ inv ν ≫ μ.hom)) (add_zero q)) (zero_add q) := by
    rw [hZ, ← R0, hnat, Abelian.Ext.comp_assoc_of_third_deg_zero]
  have hcc : (μ.inv ≫ ν) ≫ (inv ν ≫ μ.hom) = 𝟙 OC := by simp
  set L := ((Abelian.Ext.mk₀ ε').comp (Abelian.Ext.mapExactFunctor ρ'
          ((Abelian.Ext.mk₀ κ).comp ((Abelian.Ext.mapExactFunctor Φw b).comp
            (Abelian.Ext.mk₀ e) (add_zero q)) (zero_add q))) (zero_add q)).comp
          (Abelian.Ext.mk₀ (inv u')) (add_zero q) with hL
  have hcentral : L = (((Abelian.Ext.mk₀ (μ.inv ≫ ν)).comp L (zero_add q)).comp
      (Abelian.Ext.mk₀ (inv ν ≫ μ.hom)) (add_zero q)) := by
    rw [Hc (μ.inv ≫ ν) q L, R0, hcc, Abelian.Ext.comp_mk₀_id]
  rw [hcentral, hL]
  simp only [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
    Abelian.Ext.comp_assoc_of_third_deg_zero,
    Abelian.Ext.mk₀_comp_mk₀_assoc, Abelian.Ext.mk₀_comp_mk₀, Category.assoc]
  rw [hRHS]
  simp only [Abelian.Ext.mk₀_comp_mk₀_assoc, Category.assoc]
  have ha : μ.inv ≫ ΦD.map ε ≫ σ.app X = μ.inv ≫ ν ≫ ε' ≫ ρ'.map κ := by
    rw [G1]
  rw [ha]

theorem wc_tsf_corep_theta_bc (S' : Scheme.{u}) {w : S' ⟶ S'} (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Dw : wcHMPullData w ℓ) (hDw : wcHMPullCanonical Dw)
    (P : S'.ProEt → SheafOfModules.{u+1} (wcRingSheaf S' ℓ))
    (Pm : ∀ (W W' : S'.ProEt), (W' ⟶ W) → (P W' ⟶ P W))
    (ev : ∀ (W : S'.ProEt) (M : SheafOfModules.{u+1} (wcRingSheaf S' ℓ)),
      (P W ⟶ M) ≃ M.val.obj (Opposite.op W))
    (hnat : ∀ (W : S'.ProEt) (M N : SheafOfModules.{u+1} (wcRingSheaf S' ℓ)) (ψ : M ⟶ N)
      (g : P W ⟶ M), ev W N (g ≫ ψ) = (ψ.val.app (Opposite.op W)).hom (ev W M g))
