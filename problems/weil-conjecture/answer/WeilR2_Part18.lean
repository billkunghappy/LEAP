      refine ⟨?_, ?_, ?_⟩
      · erw [hα, Category.assoc, Limits.pullbackLeftPullbackSndIso_inv_fst]
        exact (Limits.pullback.lift_fst _ _ _).trans (Category.comp_id _)
      · erw [hα, Category.assoc, Limits.pullbackLeftPullbackSndIso_inv_fst_snd]
        exact (Category.assoc _ _ _).symm.trans
          (congrArg (· ≫ g₁) ((Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)))
      · erw [hα, Category.assoc, Limits.pullbackLeftPullbackSndIso_inv_snd_snd]
        exact (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
    obtain ⟨a1, a2, a3⟩ := key w₀ f₀ f₀ hc.symm V
    obtain ⟨b1, b2, b3⟩ := key (w₀ ≫ w₀) f₀ f₀ hc₂.symm V
    obtain ⟨c1, c2, c3⟩ := key w₀ w₀ (w₀ ≫ w₀) rfl ((MorphismProperty.Over.pullback Pr ⊤ f₀).obj V)
