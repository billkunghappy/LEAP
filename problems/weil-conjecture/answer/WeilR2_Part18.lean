        (I.cochainComplex.shiftFunctorObjXIso (n : ℤ) 0 (n : ℤ) (zero_add (n : ℤ)).symm).inv := by
    intro w
    rw [CochainComplex.HomComplex.Cocycle.equivHomShift_symm_apply,
