      (Category.assoc _ _ _)).trans (Iso.hom_inv_id_assoc _ _)).symm



  obtain ⟨φ, rfl⟩ := CochainComplex.HomComplex.Cocycle.equivHomShift.surjective z
  obtain ⟨φ', rfl⟩ := CochainComplex.HomComplex.Cocycle.equivHomShift.surjective z'



  have key : Φ.map (I.cochainComplex.shiftFunctorObjXIso (n : ℤ) 0 (n : ℤ)
