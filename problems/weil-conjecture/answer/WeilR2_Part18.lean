    rw [MorphismProperty.Comma.comp_left, MorphismProperty.Comma.comp_left]
    erw [MorphismProperty.Over.pullback_map_left]
    exact pure_SI V.hom f₀ w₀ _ _ _ a1 a2 a3 b1 b2 b3 c1 c2 c3 _

  have compat : ∀ {X Y Z₀ : Scheme.{u}} (g₁ : X ⟶ Y) (g₂ : Y ⟶ Z₀) (g₁₂ : X ⟶ Z₀)
