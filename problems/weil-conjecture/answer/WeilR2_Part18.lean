    haveI : P.IsRightAdjoint := ⟨_, ⟨adj⟩⟩
    have hm0 : Mono u := hS.mono_f
    have e1 := hS.exact.map_of_mono_of_preservesKernel P hS.mono_f inferInstance
    have hm : Mono ((ShortComplex.mk u (γN - 𝟙 N) hz).map P).f := by
      change Mono (P.map u)
      infer_instance
    have e2 := e1.map_of_mono_of_preservesKernel Φ hm inferInstance
    refine ShortComplex.exact_of_iso ?_ e2
    refine ShortComplex.isoMk ((asIso (Φ.map e)).symm ≪≫ (asIso μi).symm) (Iso.refl _)
      (Iso.refl _) ?_ ?_
    · simp [Functor.map_comp]
    · simp [Functor.map_sub]
  have G7 : ∀ {ℬ 𝒞 𝒟 : Type (u+2)} [Category.{u+1} ℬ] [Category.{u+1} 𝒞] [Category.{u+1} 𝒟]
      (F : 𝒞 ⥤ 𝒟) (Φ : ℬ ⥤ 𝒞) {X : 𝒞} {Y Z W : ℬ} (μi : X ⟶ Φ.obj Y) (e : Y ⟶ Z)
      (pu : Z ⟶ W), IsIso μi → IsIso (Φ.map e) → IsIso (F.map (Φ.map pu)) →
      IsIso (F.map (μi ≫ Φ.map (e ≫ pu))) := by
    intro ℬ 𝒞 𝒟 _ _ _ F Φ X Y Z W μi e pu h1 h2 h3
    rw [Φ.map_comp, F.map_comp, F.map_comp]
    infer_instance

  haveI := Dp.additive
  haveI := Dτ.additive
  haveI := Di.additive
  haveI := Dp.presLim
  haveI := Dp.presColim
  haveI := Dτ.presLim
  haveI := Dτ.presColim
  haveI := Di.presLim
  haveI := Di.presColim
  haveI hPadd : (wcQmtmPush Dp).Additive := Adjunction.right_adjoint_additive Dp.adj
  haveI hPwadd : (wcQmtmPush Dτ).Additive := Adjunction.right_adjoint_additive Dτ.adj
  haveI := sheafOfModules_enoughInjectives (Scheme.ProEt.topology XE) (wcRingSheaf XE ℓ)
  have hφ' : wcQmtmHPhi hw₁ Dp Dτ := hφ

  obtain ⟨Tw⟩ := wc_qmtm_tower_data ℓ hℓ π hπ r a₀ φA hφA σ hσ XE p q hpb w hw₁ hw₂
  obtain ⟨Dπ, hDπ, hu⟩ := wc_qmtm_pull_data_unit Tw.πi ℓ
  obtain ⟨γN, aN, hγs, has, h1, h2, h3⟩ := wc_qmtm_action_maps_of_unit_eq Tw hσ Dπ hDπ hu Dτ hDτ
  have hz : wcSuppUnitMap Dπ ≫ (γN - 𝟙 _) = 0 := by
    rw [Preadditive.comp_sub, h1, Category.comp_id, sub_self]

  have hS := wc_qmtm_torsor_ses Tw Dπ hDπ γN hγs hz
  have hfix := wc_qmtm_unit_fix hw₁ Dp hDp Dτ hDτ hφ'
  have hacyc := wc_qmtm_tower_acyclic ℓ hℓ π hπ r a₀ ha₀ hx0 hx1 φA hφA halg σ hσ XE p q hpb
    Xs ι s hps w hw₁ hw₂ Tw Dπ hDπ Dp hDp Di hDi
  have hYiso := wc_qmtm_Y_iso ℓ hℓ π hπ r a₀ ha₀ hx0 hx1 φA hφA halg σ hσ XE p q hpb
    Xs ι s hps Y iY kY hDY EY hEY w hw₁ hw₂ Tw Dπ hDπ Dp hDp Di hDi
  have hO0 := wc_qmtm_tube_x0 ℓ hℓ π hπ r a₀ ha₀ hx0 hx1 φA hφA halg σ hσ htame XE p q hpb
    Xs ι s hps w hw₁ hw₂ Tw Dπ hDπ Dp hDp Dτ hDτ Di hDi γN aN hγs has hφ'
  obtain ⟨t₁, ht₁, hO1⟩ := wc_qmtm_tube_x1_of_unit_eq ℓ hℓ π hπ r a₀ ha₀ hx0 hx1 φA hφA halg σ hσ htame
    XE p q hpb Xs ι s hps w hw₁ hw₂ Tw Dπ hDπ hu Dp hDp Dτ hDτ Di hDi γN aN hγs has hφ'
  have hunit := wc_qmssl_ci_unit_restr_iso A ℓ hℓ π hπ r B a₀ ha₀ hx0 hx1 L φA hφA halg
    XE p q hpb Xs ι s hps Dp hDp Di hDi

  have hγw := G1 (wcQmtmPush Dp) (wcQmtmPush Dτ) Di.Φ (wcQmtmGamma hw₁ Dp Dτ hφ') γN aN h3
  have hc := G2 (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
    (ComplexShape.up ℤ) 0) _ _ hγw
  have hι := G3 (wcQmtmPush Dp) Di.Φ Di.μ.inv (wcQmtmUnit Dp) (wcSuppUnitMap Dπ) γN h1
  have hιw := G4 (wcQmtmPush Dp) (wcQmtmPush Dτ) Di.Φ (wcQmtmGamma hw₁ Dp Dτ hφ') Di.μ.inv
    (wcQmtmUnit Dp) (wcSuppUnitMap Dπ) (wcQmtmUnit Dτ) aN h2 hfix
  have hmono := G5 Dp.Φ (wcQmtmPush Dp) Dp.adj Di.Φ Di.μ.inv (wcQmtmUnit Dp) (wcSuppUnitMap Dπ)
    inferInstance hunit hS.mono_f
  have hex := G6 Dp.Φ (wcQmtmPush Dp) Dp.adj Di.Φ Di.μ.inv (wcQmtmUnit Dp) (wcSuppUnitMap Dπ) γN
    inferInstance hunit hz hS hι
  have hiso := G7 EY.Φ Di.Φ Di.μ.inv (wcQmtmUnit Dp) ((wcQmtmPush Dp).map (wcSuppUnitMap Dπ))
    inferInstance hunit hYiso
  have hga : (γN - 𝟙 _) ≫ aN = aN ≫ (wcQmtmPush Dτ).map (γN - 𝟙 _) := by
    rw [Preadditive.sub_comp, Functor.map_sub, CategoryTheory.Functor.map_id,
      Preadditive.comp_sub, h3, Category.id_comp, Category.comp_id]
  have hgM : Di.Φ.map ((wcQmtmPush Dp).map (γN - 𝟙 _)) =
      Di.Φ.map ((wcQmtmPush Dp).map γN) - 𝟙 _ := by
    rw [Functor.map_sub, CategoryTheory.Functor.map_id, Functor.map_sub,
      CategoryTheory.Functor.map_id]

  obtain ⟨φ, hφT⟩ := wc_qmtm_ses_transport Dp.Φ (wcQmtmPush Dp) Dp.adj Dτ.Φ (wcQmtmPush Dτ)
    Dτ.adj Di.Φ (wcQmtmGamma hw₁ Dp Dτ hφ') (SheafOfModules.unit (wcRingSheaf XE ℓ))
    (wcSuppObj Dπ) (wcSuppUnitMap Dπ) (γN - 𝟙 _) hz hS (wcQmtmUnit Dτ) aN h2 hga hacyc I t ht
    _ _ hgM rfl hc
  exact ⟨_, _, _, _, t₁, 0, hc, hι, φ, ht₁, hγw, hιw, hmono, hex, hiso, hO1, hO0, hφT⟩

theorem wc_qmmv_derived_eq_homotopy {𝒞 : Type u₁} [Category.{v₁} 𝒞] [Abelian 𝒞]
    [HasDerivedCategory.{w₁} 𝒞] {K L : CochainComplex 𝒞 ℤ} (f g : K ⟶ L) (n : ℤ)
    (hL : ∀ i < n, Limits.IsZero (L.X i))
    (hfg : DerivedCategory.Q.map f = DerivedCategory.Q.map g) :
    ∃ (Z : CochainComplex 𝒞 ℤ) (s : L ⟶ Z), QuasiIso s ∧ (∀ i < n, Limits.IsZero (Z.X i)) ∧
      Nonempty (Homotopy (f ≫ s) (g ≫ s)) :=
by
  let qt := HomotopyCategory.quotient 𝒞 (ComplexShape.up ℤ)
  have h1 : DerivedCategory.Qh.map (qt.map f) = DerivedCategory.Qh.map (qt.map g) := by
    have ef := NatIso.naturality_2 (DerivedCategory.quotientCompQhIso 𝒞) f
    have eg := NatIso.naturality_2 (DerivedCategory.quotientCompQhIso 𝒞) g
    rw [Functor.comp_map] at ef eg
    rw [← ef, ← eg, hfg]
  obtain ⟨Z', s', hs', hcomp⟩ := (MorphismProperty.map_eq_iff_postcomp DerivedCategory.Qh
    (HomotopyCategory.quasiIso 𝒞 (ComplexShape.up ℤ)) (qt.map f) (qt.map g)).mp h1
  obtain ⟨Z₀, rfl⟩ := HomotopyCategory.quotient_obj_surjective Z'
  obtain ⟨s₀, hs₀⟩ : ∃ s₀ : L ⟶ Z₀, qt.map s₀ = s' := ⟨_, HomotopyCategory.quotient_map_out s'⟩
  subst hs₀
  have hq : QuasiIso s₀ := by
    have := (HomotopyCategory.quotient_map_mem_quasiIso_iff s₀).mp hs'
    exact (HomologicalComplex.mem_quasiIso_iff s₀).mp this
  have hh : Homotopy (f ≫ s₀) (g ≫ s₀) := by
    apply HomotopyCategory.homotopyOfEq
    rw [Functor.map_comp, Functor.map_comp]
    exact hcomp
  have hGE : CochainComplex.IsGE Z₀ n := by
    rw [CochainComplex.isGE_iff]
    intro i hi
    have hLex : L.ExactAt i := by
      rw [HomologicalComplex.exactAt_iff]
      exact ShortComplex.exact_of_isZero_X₂ _ (hL i hi)
    exact (quasiIsoAt_iff_exactAt s₀ i hLex).mp (QuasiIso.quasiIsoAt (f := s₀) i)
  refine ⟨CochainComplex.truncGE Z₀ n, s₀ ≫ CochainComplex.πTruncGE Z₀ n, ?_, ?_, ?_⟩
  · exact quasiIso_comp s₀ (CochainComplex.πTruncGE Z₀ n)
  · intro i hi
    exact CochainComplex.isZero_of_isStrictlyGE (CochainComplex.truncGE Z₀ n) n i hi
  · exact ⟨(Homotopy.ofEq (Category.assoc f s₀ (CochainComplex.πTruncGE Z₀ n)).symm).trans
      ((hh.compRight (CochainComplex.πTruncGE Z₀ n)).trans
        (Homotopy.ofEq (Category.assoc g s₀ (CochainComplex.πTruncGE Z₀ n))))⟩

theorem wc_qmmv_cone_kernel {𝒜 : Type u₁} [Category.{v₁} 𝒜] [Abelian 𝒜] {Λ M : 𝒜}
    (u : M ⟶ M) (ι : Λ ⟶ M) (hι : ι ≫ u = 0) (hmono : Mono ι)
    (hex : (ShortComplex.mk ι u hι).Exact) (Z : CochainComplex 𝒜 ℤ)
    (s : CochainComplex.mappingCone ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u) ⟶ Z)
    (hs : QuasiIso s) (hZ : Limits.IsZero (Z.X (-2))) :
    Mono (ι ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
      (CochainComplex.mappingCone.inl ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).v
        0 (-1) (by omega) ≫ s.f (-1)) ∧
    ∀ (g : Λ ⟶ Z.X (-1)), g ≫ Z.d (-1) 0 = 0 → ∃ e : Λ ⟶ Λ,
      g = e ≫ ι ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
        (CochainComplex.mappingCone.inl ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).v
          0 (-1) (by omega) ≫ s.f (-1) :=
by
  classical
  have main : ∀ (φ : (HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).obj M ⟶
      (HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).obj M)
      (hφ0 : φ.f 0 = (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).hom ≫ u ≫
        (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv)
      (s : CochainComplex.mappingCone φ ⟶ Z) (hs : QuasiIso s),
      Mono (ι ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
        (CochainComplex.mappingCone.inl φ).v 0 (-1) (by omega) ≫ s.f (-1)) ∧
      ∀ (g : Λ ⟶ Z.X (-1)), g ≫ Z.d (-1) 0 = 0 → ∃ e : Λ ⟶ Λ,
        g = e ≫ ι ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
          (CochainComplex.mappingCone.inl φ).v 0 (-1) (by omega) ≫ s.f (-1) := by
    intro φ hφ0 s hs
    have hS : ∀ i : ℤ, i ≠ 0 →
        Limits.IsZero (((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).obj M).X i) :=
      fun i hi => HomologicalComplex.isZero_single_obj_X _ _ _ _ hi

    have hC2 : Limits.IsZero ((CochainComplex.mappingCone φ).X (-2)) := by
      rw [Limits.IsZero.iff_id_eq_zero, ← CochainComplex.mappingCone.id_X φ (-2) (-1) (by omega)]
      rw [(hS (-1) (by omega)).eq_of_tgt ((CochainComplex.mappingCone.fst φ).1.v (-2) (-1) _) 0,
        (hS (-2) (by omega)).eq_of_tgt ((CochainComplex.mappingCone.snd φ).v (-2) (-2) _) 0]
      simp

    have hcyc : IsIso (HomologicalComplex.cyclesMap s (-1)) := by
      have hp : (ComplexShape.up ℤ).prev (-1) = -2 := by
        simp only [CochainComplex.prev]; norm_num
      have : IsIso ((CochainComplex.mappingCone φ).homologyπ (-1)) :=
        (CochainComplex.mappingCone φ).isIso_homologyπ (-2) (-1) hp (hC2.eq_of_src _ _)
      have : IsIso (Z.homologyπ (-1)) := Z.isIso_homologyπ (-2) (-1) hp (hZ.eq_of_src _ _)
      have : QuasiIsoAt s (-1) := hs.quasiIsoAt (-1)
      have : IsIso (HomologicalComplex.homologyMap s (-1)) :=
        (quasiIsoAt_iff_isIso_homologyMap s (-1)).mp this
      have heq : HomologicalComplex.cyclesMap s (-1) =
          (CochainComplex.mappingCone φ).homologyπ (-1) ≫ HomologicalComplex.homologyMap s (-1) ≫
            inv (Z.homologyπ (-1)) := by
        rw [← Category.assoc, HomologicalComplex.homologyπ_naturality, Category.assoc,
          IsIso.hom_inv_id, Category.comp_id]
      rw [heq]
      infer_instance

    have hfi : (CochainComplex.mappingCone.fst φ).1.v (-1) 0 (by omega) ≫
        (CochainComplex.mappingCone.inl φ).v 0 (-1) (by omega) = 𝟙 _ := by
      have h := CochainComplex.mappingCone.id_X φ (-1) 0 (by omega)
      rw [(hS (-1) (by omega)).eq_of_tgt ((CochainComplex.mappingCone.snd φ).v (-1) (-1) _) 0,
        Limits.zero_comp, add_zero] at h
      exact h
    have hinr : Mono ((CochainComplex.mappingCone.inr φ).f 0) :=
      mono_of_mono_fac (CochainComplex.mappingCone.inr_f_snd_v φ 0)
    have hinl : Mono ((CochainComplex.mappingCone.inl φ).v 0 (-1) (by omega)) :=
      mono_of_mono_fac (CochainComplex.mappingCone.inl_v_fst_v φ 0 (-1) (by omega))
    have hd : (CochainComplex.mappingCone.inl φ).v 0 (-1) (by omega) ≫
        (CochainComplex.mappingCone φ).d (-1) 0 =
        (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).hom ≫ u ≫
          (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
            (CochainComplex.mappingCone.inr φ).f 0 := by
      rw [CochainComplex.mappingCone.inl_v_d φ 0 (-1) 1 (by omega) (by omega)]
      rw [(hS 1 (by omega)).eq_of_tgt
        (((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).obj M).d 0 1) 0, hφ0]
      simp
    have key : ∀ x : Λ ⟶ M, (x ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
        (CochainComplex.mappingCone.inl φ).v 0 (-1) (by omega)) ≫
        (CochainComplex.mappingCone φ).d (-1) 0 =
        (x ≫ u) ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
          (CochainComplex.mappingCone.inr φ).f 0 := by
      intro x
      simp only [Category.assoc, hd, Iso.inv_hom_id_assoc]
    have hnext : (ComplexShape.up ℤ).next (-1) = 0 := by
      simp only [CochainComplex.next]; norm_num
    have hτd : (ι ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
        (CochainComplex.mappingCone.inl φ).v 0 (-1) (by omega)) ≫
        (CochainComplex.mappingCone φ).d (-1) 0 = 0 := by
      rw [key, hι, Limits.zero_comp]
    obtain ⟨τ', hτ'⟩ : ∃ τ', τ' ≫ (CochainComplex.mappingCone φ).iCycles (-1) =
        ι ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
          (CochainComplex.mappingCone.inl φ).v 0 (-1) (by omega) :=
      ⟨_, HomologicalComplex.liftCycles_i _ _ _ hnext hτd⟩
    refine ⟨?_, ?_⟩
    · have : Mono (τ' ≫ (CochainComplex.mappingCone φ).iCycles (-1)) := by
        rw [hτ']; infer_instance
      have : Mono τ' := mono_of_mono τ' ((CochainComplex.mappingCone φ).iCycles (-1))
      have heq : ι ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
          (CochainComplex.mappingCone.inl φ).v 0 (-1) (by omega) ≫ s.f (-1) =
          τ' ≫ HomologicalComplex.cyclesMap s (-1) ≫ Z.iCycles (-1) := by
        rw [HomologicalComplex.cyclesMap_i, reassoc_of% hτ']
      rw [heq]
      infer_instance
    · intro g hg
      obtain ⟨g', hg'⟩ : ∃ g', g' ≫ Z.iCycles (-1) = g := ⟨_, Z.liftCycles_i g 0 hnext hg⟩
      obtain ⟨h, hhs, hhd⟩ : ∃ h : Λ ⟶ (CochainComplex.mappingCone φ).X (-1),
          h ≫ s.f (-1) = g ∧ h ≫ (CochainComplex.mappingCone φ).d (-1) 0 = 0 :=
        ⟨g' ≫ inv (HomologicalComplex.cyclesMap s (-1)) ≫
            (CochainComplex.mappingCone φ).iCycles (-1),
          by rw [Category.assoc, Category.assoc, ← HomologicalComplex.cyclesMap_i,
            IsIso.inv_hom_id_assoc, hg'],
          by simp⟩
      obtain ⟨x, hx⟩ : ∃ x : Λ ⟶ M,
          h = x ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
            (CochainComplex.mappingCone.inl φ).v 0 (-1) (by omega) :=
        ⟨h ≫ (CochainComplex.mappingCone.fst φ).1.v (-1) 0 (by omega) ≫
          (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).hom, by
            simp only [Category.assoc, Iso.hom_inv_id_assoc, hfi, Category.comp_id]⟩
      have hxu : x ≫ u = 0 := by
        have h1 := key x
        rw [← hx, hhd] at h1
        exact (cancel_mono ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
          (CochainComplex.mappingCone.inr φ).f 0)).mp
          (by rw [Limits.zero_comp]; exact h1.symm)
      have hε : hex.lift x hxu ≫ ι = x := hex.lift_f x hxu
      refine ⟨hex.lift x hxu, ?_⟩
      rw [reassoc_of% hε, ← hhs, hx]
      simp only [Category.assoc]
  exact main _ (HomologicalComplex.single_map_f_self _ _ _) s hs

theorem wc_qmmv_cone_homotopy_components {𝒜 : Type u₁} [Category.{v₁} 𝒜] [Abelian 𝒜] {M : 𝒜}
    (u w : M ⟶ M)
    (hc : (HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u ≫
        (HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map w =
      (HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map w ≫
        (HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)
    (Z : CochainComplex 𝒜 ℤ)
    (s : CochainComplex.mappingCone ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u) ⟶ Z)
    (hZ : Limits.IsZero (Z.X (-2)))
    (hm : Homotopy (CochainComplex.mappingCone.map _ _ _ _ hc ≫ s) s) :
    ∃ H : M ⟶ Z.X (-1),
      (w - 𝟙 M) ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
        (CochainComplex.mappingCone.inl ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).v
          0 (-1) (by omega) ≫ s.f (-1) = u ≫ H ∧
      H ≫ Z.d (-1) 0 = (w - 𝟙 M) ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
        (CochainComplex.mappingCone.inr ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).f 0 ≫
          s.f 0 :=
by
  have hX : ∀ f : M ⟶ M,
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
        ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map f).f 0 =
        f ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv := by
    intro f
    rw [HomologicalComplex.single_map_f_self, Iso.inv_hom_id_assoc]
  have hd : ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).obj M).d 0 1 = 0 := by simp
  have hl_d : (CochainComplex.mappingCone.inl
        ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).v 0 (-1) (by omega) ≫
      (CochainComplex.mappingCone
        ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).d (-1) 0 =
      ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u).f 0 ≫
        (CochainComplex.mappingCone.inr
          ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).f 0 := by
    rw [CochainComplex.mappingCone.inl_v_d _ 0 (-1) 1 (by omega) (by omega), hd,
      Limits.zero_comp, sub_zero]
  have hr_d : (CochainComplex.mappingCone.inr
        ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).f 0 ≫
      (CochainComplex.mappingCone
        ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).d 0 1 = 0 := by
    rw [CochainComplex.mappingCone.inr_f_d, hd, Limits.zero_comp]
  have hl_μ : (CochainComplex.mappingCone.inl
        ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).v 0 (-1) (by omega) ≫
      (CochainComplex.mappingCone.map _ _ _ _ hc).f (-1) =
      ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map w).f 0 ≫
        (CochainComplex.mappingCone.inl
          ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).v 0 (-1) (by omega) := by
    unfold CochainComplex.mappingCone.map
    rw [CochainComplex.mappingCone.inl_v_desc_f]
    simp [CochainComplex.HomComplex.Cochain.zero_cochain_comp_v,
      CochainComplex.HomComplex.Cochain.ofHom_v]
  have hr_μ : (CochainComplex.mappingCone.inr
        ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).f 0 ≫
      (CochainComplex.mappingCone.map _ _ _ _ hc).f 0 =
      ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map w).f 0 ≫
        (CochainComplex.mappingCone.inr
          ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).f 0 := by
    unfold CochainComplex.mappingCone.map
    rw [CochainComplex.mappingCone.inr_f_desc_f]
    simp
  have e1 := hm.comm (-1)
  rw [dNext_eq hm.hom (show (ComplexShape.up ℤ).Rel (-1) 0 by simp),
    prevD_eq hm.hom (show (ComplexShape.up ℤ).Rel (-2) (-1) by simp),
    show hm.hom (-1) (-2) = 0 from hZ.eq_of_tgt _ _, Limits.zero_comp, add_zero,
    HomologicalComplex.comp_f] at e1
  have e0 := hm.comm 0
  rw [dNext_eq hm.hom (show (ComplexShape.up ℤ).Rel 0 1 by simp),
    prevD_eq hm.hom (show (ComplexShape.up ℤ).Rel (-1) 0 by simp),
    HomologicalComplex.comp_f] at e0
  refine ⟨(HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
    (CochainComplex.mappingCone.inr
      ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).f 0 ≫ hm.hom 0 (-1), ?_, ?_⟩
  · have A : (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
        (CochainComplex.mappingCone.inl
          ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).v 0 (-1) (by omega) ≫
        ((CochainComplex.mappingCone.map _ _ _ _ hc).f (-1) ≫ s.f (-1)) =
        w ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
          (CochainComplex.mappingCone.inl
            ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).v 0 (-1) (by omega) ≫
          s.f (-1) := by
      rw [reassoc_of% hl_μ, reassoc_of% (hX w)]
    have B : (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
        (CochainComplex.mappingCone.inl
          ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).v 0 (-1) (by omega) ≫
        (CochainComplex.mappingCone
          ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).d (-1) 0 ≫ hm.hom 0 (-1) =
        u ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
          (CochainComplex.mappingCone.inr
            ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).f 0 ≫ hm.hom 0 (-1) := by
      rw [reassoc_of% hl_d, reassoc_of% (hX u)]
    rw [e1, Preadditive.comp_add, Preadditive.comp_add, B] at A
    rw [Preadditive.sub_comp, Category.id_comp, ← A, add_sub_cancel_right]
  · have A : (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
        (CochainComplex.mappingCone.inr
          ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).f 0 ≫
        ((CochainComplex.mappingCone.map _ _ _ _ hc).f 0 ≫ s.f 0) =
        w ≫ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).inv ≫
          (CochainComplex.mappingCone.inr
            ((HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u)).f 0 ≫ s.f 0 := by
      rw [reassoc_of% hr_μ, reassoc_of% (hX w)]
    rw [e0] at A
    simp only [Preadditive.comp_add, reassoc_of% hr_d, Limits.zero_comp, zero_add] at A
    simp only [Category.assoc]
    rw [Preadditive.sub_comp, Category.id_comp, ← A, add_sub_cancel_right]

theorem wc_qmmv_closed_in_local_preconnected (B : Type u) [CommRing B] [IsLocalRing B]
    (Xs : Scheme.{u}) (ι : Xs ⟶ Spec (.of B)) [IsClosedImmersion ι] : PreconnectedSpace Xs :=
by
  rcases isEmpty_or_nonempty Xs with hE | ⟨⟨x₁⟩⟩
  · exact ⟨(Set.subsingleton_of_subsingleton).isPreconnected⟩
  have hce : Topology.IsClosedEmbedding ⇑ι := ι.isClosedEmbedding
  have hsp : ∀ x : Xs, (ι x : PrimeSpectrum B) ⤳ IsLocalRing.closedPoint B := fun x =>
    IsLocalRing.specializes_closedPoint (R := B) (ι x)
  have hmem : (IsLocalRing.closedPoint B : Spec (.of B)) ∈ Set.range ι :=
    (hsp x₁).mem_closed hce.isClosed_range ⟨x₁, rfl⟩
  obtain ⟨x₀, hx₀⟩ := hmem
  have key : ∀ x : Xs, x₀ ∈ closure ({x} : Set Xs) := by
    intro x
    have h1 : ι x ⤳ ι x₀ := by
      have := hsp x
      rw [← hx₀] at this
      exact this
    exact specializes_iff_mem_closure.mp (hce.isInducing.specializes_iff.mp h1)
  exact ⟨isPreconnected_of_forall x₀ (fun y _ => ⟨closure {y}, Set.subset_univ _, key y,
    subset_closure rfl, isPreconnected_singleton.closure⟩)⟩

theorem wc_qmmv_tube_nonempty : ∀ (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} →
    ∀ (r : ℕ) (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)]
      (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
    WeaklyEtale a₀ →
    Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) →
    Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) →
    ∀ (Xs : Scheme.{u}) (ι : Xs ⟶ Spec (.of B))
      (s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))),
    IsPullback ι s (a₀ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (wcQmSp A) →
    ∀ (j : ℕ) (hj : j < 2) (O : Scheme.{u}) (jO : O ⟶ Xs)
      (kO : O ⟶ Spec (.of (Localization.Away ((Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨j, by omega⟩ : Fin (r + 2)))))))),
    IsPullback jO kO ι (Spec.map (CommRingCat.ofHom (algebraMap B
        (Localization.Away ((Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨j, by omega⟩ : Fin (r + 2))))))))) →
    Nonempty O :=
by
  intro A _ _ _ _ _ π hπ r B _ _ _ a₀ ha₀ hx0 hx1 Xs ι s hps
  classical

  have quad : ∀ (c₀ : Matrix (Fin (r + 2)) (Fin (r + 2)) A),
      c₀ = (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) →
      wcQuadModelIdeal A (r + 2) π c₀ = Ideal.span {MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
        MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π} := by
    intro c₀ hc₀
    have hsum : (∑ p, ∑ q, MvPolynomial.C (c₀ p q) * MvPolynomial.X p * MvPolynomial.X q :
        MvPolynomial (Fin (r + 2)) A) =
        MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
          MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) := by
      rw [Fintype.sum_eq_single (⟨0, by omega⟩ : Fin (r + 2))]
      · rw [Fintype.sum_eq_single (⟨1, by omega⟩ : Fin (r + 2))]
        · rw [hc₀, Matrix.of_apply, if_pos ⟨rfl, rfl⟩, map_one, one_mul]
        · intro q hq
          have : ¬ (q.val = 1) := fun h => hq (Fin.ext h)
          rw [hc₀, Matrix.of_apply, if_neg (fun h => this h.2), map_zero, zero_mul, zero_mul]
      · intro p hp
        apply Finset.sum_eq_zero
        intro q _
        have : ¬ (p.val = 0) := fun h => hp (Fin.ext h)
        rw [hc₀, Matrix.of_apply, if_neg (fun h => this h.1), map_zero, zero_mul, zero_mul]
    show Ideal.span {_ - _} = _
    rw [hsum]
  have hIeq := quad _ rfl
  have hrel : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) *
      Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) =
      algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π := by
    have hmem : (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
        MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π :
          MvPolynomial (Fin (r + 2)) A) ∈ wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0) := by
      rw [hIeq]; exact Ideal.mem_span_singleton_self _
    have hal : algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π =
        Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
          (MvPolynomial.C π) := by
      rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
    rw [hal, ← map_mul, ← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
    exact hmem

  have branch : ∀ {σ' : Type} (I : Ideal (MvPolynomial σ' A)) (a b : σ'), a ≠ b →
      (MvPolynomial.X a * MvPolynomial.X b - MvPolynomial.C π) ∈ I →
      I ≤ Ideal.span {MvPolynomial.X a * MvPolynomial.X b - MvPolynomial.C π} →
      ∀ (𝔮 : Ideal (MvPolynomial σ' A ⧸ I)) [𝔮.IsPrime],
      Ideal.Quotient.mk I (MvPolynomial.X a) ∈ 𝔮 → Ideal.Quotient.mk I (MvPolynomial.X b) ∈ 𝔮 →
      ∃ 𝔭 : Ideal (MvPolynomial σ' A ⧸ I), 𝔭.IsPrime ∧ 𝔭 ≤ 𝔮 ∧
        Ideal.Quotient.mk I (MvPolynomial.X a) ∉ 𝔭 ∧ Ideal.Quotient.mk I (MvPolynomial.X b) ∈ 𝔭 := by
    intro σ' I a b hab hmem hle 𝔮 _ ha hb
    letI : CommRing ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) := Ideal.Quotient.commRing 𝔮
    haveI : IsDomain ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) := Ideal.Quotient.isDomain 𝔮
    letI : CommRing (Polynomial ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮)) := Polynomial.commRing
    let q : MvPolynomial σ' A →+* ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) := (Ideal.Quotient.mk 𝔮).comp (Ideal.Quotient.mk I)
    let v : σ' → Polynomial ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) := fun i => if i = a then Polynomial.X else if i = b then 0
      else Polynomial.C (q (MvPolynomial.X i))
    let Ψt : MvPolynomial σ' A →+* Polynomial ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) :=
      MvPolynomial.eval₂Hom (Polynomial.C.comp (q.comp MvPolynomial.C)) v
    have hqa : q (MvPolynomial.X a) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr ha
    have hqb : q (MvPolynomial.X b) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hb
    have hπq : q (MvPolynomial.C π) = 0 := by
      have h1 : q (MvPolynomial.X a * MvPolynomial.X b - MvPolynomial.C π) = 0 := by
        show Ideal.Quotient.mk 𝔮 (Ideal.Quotient.mk I _) = 0
        rw [Ideal.Quotient.eq_zero_iff_mem.mpr hmem, map_zero]
      rw [map_sub, map_mul, hqa, zero_mul, zero_sub, neg_eq_zero] at h1
      exact h1
    have hva : v a = Polynomial.X := if_pos rfl
    have hvb : v b = 0 := by
      show (if b = a then Polynomial.X else if b = b then 0 else _) = 0
      rw [if_neg hab.symm, if_pos rfl]
    have hG : Ψt (MvPolynomial.X a * MvPolynomial.X b - MvPolynomial.C π) = 0 := by
      rw [map_sub, map_mul]
      simp only [Ψt, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      rw [hva, hvb, hπq, mul_zero, map_zero, sub_zero]
    let Ψ : (MvPolynomial σ' A ⧸ I) →+* Polynomial ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) := Ideal.Quotient.lift I Ψt (fun z hz => by
      obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp (hle hz)
      rw [map_mul, hG, mul_zero])
    have hΨX : ∀ i, Ψ (Ideal.Quotient.mk I (MvPolynomial.X i)) = v i := fun i => by
      simp only [Ψ, Ideal.Quotient.lift_mk, Ψt, MvPolynomial.eval₂Hom_X']
    have hev : (Polynomial.evalRingHom (0 : ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮))).comp Ψ = Ideal.Quotient.mk 𝔮 := by
      apply Ideal.Quotient.ringHom_ext
      apply MvPolynomial.ringHom_ext
      · intro c
        simp only [RingHom.comp_apply, Ψ, Ideal.Quotient.lift_mk, Ψt, MvPolynomial.eval₂Hom_C,
          Polynomial.coe_evalRingHom, Polynomial.eval_C]
        rfl
      · intro i
        simp only [RingHom.comp_apply]
        rw [hΨX, Polynomial.coe_evalRingHom]
        by_cases hia : i = a
        · rw [hia, hva, Polynomial.eval_X]
          exact hqa.symm
        · by_cases hib : i = b
          · rw [hib, hvb, Polynomial.eval_zero]
            exact hqb.symm
          · have : v i = Polynomial.C (q (MvPolynomial.X i)) := by
              show (if i = a then _ else if i = b then _ else _) = _
              rw [if_neg hia, if_neg hib]
            rw [this, Polynomial.eval_C]
            rfl
    refine ⟨RingHom.ker Ψ, RingHom.ker_isPrime Ψ, ?_, ?_, ?_⟩
    · intro z hz
      have h1 : Ψ z = 0 := RingHom.mem_ker.mp hz
      have h2 := congrArg (fun f : (MvPolynomial σ' A ⧸ I) →+* ((MvPolynomial σ' A ⧸ I) ⧸ 𝔮) => f z) hev
      simp only [RingHom.comp_apply, h1, map_zero] at h2
      exact Ideal.Quotient.eq_zero_iff_mem.mp h2.symm
    · intro h
      have h1 := RingHom.mem_ker.mp h
      rw [hΨX, hva] at h1
      exact Polynomial.X_ne_zero h1
    · exact RingHom.mem_ker.mpr ((hΨX b).trans hvb)

  have gd : ∀ {R' : Type u} [CommRing R'] (ψ : R' →+* B), ψ.Flat → ∀ (𝔭 : Ideal R') [𝔭.IsPrime],
      𝔭 ≤ Ideal.comap ψ (IsLocalRing.maximalIdeal B) →
      ∃ P : Ideal B, P.IsPrime ∧ Ideal.comap ψ P = 𝔭 := by
    intro R' _ ψ hψ 𝔭 _ hle
    letI := ψ.toAlgebra
    haveI : Module.Flat R' B := hψ
    haveI : Algebra.HasGoingDown R' B := Algebra.HasGoingDown.of_flat
    haveI : (Ideal.comap ψ (IsLocalRing.maximalIdeal B)).IsPrime := Ideal.comap_isPrime _ _
    haveI : (IsLocalRing.maximalIdeal B).LiesOver (Ideal.comap ψ (IsLocalRing.maximalIdeal B)) :=
      ⟨by rw [Ideal.under_def, RingHom.algebraMap_toAlgebra]⟩
    obtain ⟨P, -, hP, hPo⟩ := Ideal.exists_ideal_le_liesOver_of_le (IsLocalRing.maximalIdeal B) hle
    refine ⟨P, hP, ?_⟩
    have := hPo.over
    rw [Ideal.under_def, RingHom.algebraMap_toAlgebra] at this
    exact this.symm

  have hptg : ∀ {R' : CommRingCat.{u}} (g : Spec (.of B) ⟶ Spec R') (p : Spec (.of B)),
      (g p).asIdeal = Ideal.comap (Spec.preimage g).hom p.asIdeal := by
    intro R' g p
    conv_lhs => rw [← Spec.map_preimage g]
    rfl
  have hpt : ∀ p : Spec (.of B), (a₀ p).asIdeal = Ideal.comap (Spec.preimage a₀).hom p.asIdeal :=
    fun p => hptg a₀ p
  have hflat : (Spec.preimage a₀).hom.Flat := by
    haveI := ha₀
    have hf : Flat (Spec.map (Spec.preimage a₀)) := by
      rw [Spec.map_preimage]; exact WeaklyEtale.flat
    exact (HasRingHomProperty.Spec_iff (P := @Flat)).mp hf
  have hm0 : _ ∈ Ideal.comap (Spec.preimage a₀).hom (IsLocalRing.maximalIdeal B) :=
    (hpt (IsLocalRing.closedPoint B)).le hx0
  have hm1 : _ ∈ Ideal.comap (Spec.preimage a₀).hom (IsLocalRing.maximalIdeal B) :=
    (hpt (IsLocalRing.closedPoint B)).le hx1
  have hlift : ∀ P : Ideal B, P.IsPrime →
      (Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π) ∈ P →
      ∃ x : Xs, (ι x).asIdeal = P := by
    intro P hP hπP
    let p : Spec (.of B) := ⟨P, hP⟩
    let z : Spec (.of (IsLocalRing.ResidueField A)) := IsLocalRing.closedPoint _
    have heq : (a₀ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) p =
        wcQmSp A z := by
      apply PrimeSpectrum.ext
      show Ideal.comap (algebraMap A _) (a₀ p).asIdeal =
        Ideal.comap (IsLocalRing.residue A) z.asIdeal
      haveI := z.isPrime
      rw [Ideal.eq_bot_of_prime z.asIdeal, ← RingHom.ker_eq_comap_bot, IsLocalRing.ker_residue,
        hpt p]
      haveI := hP
      symm
      refine (IsLocalRing.maximalIdeal.isMaximal A).eq_of_le (Ideal.comap_isPrime _ _).ne_top ?_
      rw [hπ, Ideal.span_singleton_le_iff_mem, Ideal.mem_comap, Ideal.mem_comap]
      exact hπP
    obtain ⟨w, hw1, -⟩ := Scheme.Pullback.exists_preimage_pullback p z heq
    refine ⟨hps.isoPullback.inv w, ?_⟩
    rw [← Scheme.Hom.comp_apply, hps.isoPullback_inv_fst, hw1]

  have fin : ∀ (x : B) (P : Ideal B), P.IsPrime → x ∉ P →
      (Spec.preimage a₀).hom (algebraMap A (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) π) ∈ P →
      ∀ (O : Scheme.{u}) (jO : O ⟶ Xs) (kO : O ⟶ Spec (.of (Localization.Away x))),
      IsPullback jO kO ι (Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away x)))) →
      Nonempty O := by
    intro x P hP hxP hπP O jO kO hO
    obtain ⟨y, hy⟩ := hlift P hP hπP
    have hmem : ι y ∈ Set.range (PrimeSpectrum.comap (algebraMap B (Localization.Away x))) := by
      rw [PrimeSpectrum.localization_away_comap_range (Localization.Away x) x]
      show ι y ∈ ((PrimeSpectrum.basicOpen x : TopologicalSpace.Opens (PrimeSpectrum B)) :
        Set (PrimeSpectrum B))
      exact (PrimeSpectrum.mem_basicOpen _ _).mpr (by rw [hy]; exact hxP)
    obtain ⟨z, hz⟩ := hmem
    let z' : Spec (.of (Localization.Away x)) := z
    have hz' : ι y = (Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away x)))) z' :=
      hz.symm
    obtain ⟨w, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := ι)
      (g := Spec.map (CommRingCat.ofHom (algebraMap B (Localization.Away x)))) y z' hz'
    exact ⟨hO.isoPullback.inv w⟩
  haveI h𝔮 : (Ideal.comap (Spec.preimage a₀).hom (IsLocalRing.maximalIdeal B)).IsPrime :=
    Ideal.comap_isPrime _ _
  have h01 : (⟨0, by omega⟩ : Fin (r + 2)) ≠ ⟨1, by omega⟩ := by
    intro h; have := congrArg Fin.val h; simp at this
  have hcomm : (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)) *
      MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) - MvPolynomial.C π :
        MvPolynomial (Fin (r + 2)) A) =
      MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)) *
