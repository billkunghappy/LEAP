      (hβ (Pw'.obj M) V x).trans (pfObjMapEval Dτ'.φ M (ζ.hom.app V) x)
    have r2 : ∀ y, ConcreteCategory.hom ((P.map (β₀.hom.app M)).val.app (Opposite.op V)) y =
        ConcreteCategory.hom (M.val.map (ζw.hom.app ((wcProEtBC p).obj V)).op) y :=
      fun y => (pfMapEval Dp.φ (β₀.hom.app M) V y).trans (hβw M ((wcProEtBC p).obj V) y)
    have r3 : ∀ y, ConcreteCategory.hom ((γ.app (PE.obj M)).val.app (Opposite.op V)) y =
        ConcreteCategory.hom (M.val.map ((wcProEtBC βE).map (α.app V)).op) y :=
      fun y => (gammaEval Dp.φ Dτ.φ Dp.φ α hφ (PE.obj M) V y).trans
        (pfObjMapEval DβE.φ M (α.app V) y)
    let D := (wcProEtBC βE).obj ((wcProEtBC w).obj ((wcProEtBC p).obj V))
    let E := (wcProEtBC w').obj C
    have m1 := @PresheafOfModules.map_comp_apply _ _ _ M.val (Opposite.op A) (Opposite.op E)
      (Opposite.op D) ((wcProEtBC w').map (ζ.hom.app V)).op
      (ζw.hom.app ((wcProEtBC p).obj V)).op x'
    have m2 := @PresheafOfModules.map_comp_apply _ _ _ M.val (Opposite.op A) (Opposite.op D)
      (Opposite.op C) (ζw.hom.app ((wcProEtBC p).obj V) ≫ (wcProEtBC w').map (ζ.hom.app V)).op
      ((wcProEtBC βE).map (α.app V)).op x'
    have hR : ConcreteCategory.hom ((β.hom.app (Pw'.obj M) ≫ P.map (β₀.hom.app M) ≫
        γ.app (PE.obj M)).val.app (Opposite.op V)) x =
        ConcreteCategory.hom (M.val.map ((wcProEtBC βE).map (α.app V) ≫
          ζw.hom.app ((wcProEtBC p).obj V) ≫ (wcProEtBC w').map (ζ.hom.app V)).op) x' :=
      (compEval _ _ _ x).trans ((compEval _ _ _ _).trans ((r3 _).trans
        ((congrArg _ ((r2 _).trans ((congrArg _ r1).trans m1.symm))).trans m2.symm)))
    exact hL.trans ((congrArg (fun k : C ⟶ A => ConcreteCategory.hom (M.val.map k.op) x')
      (hS V)).trans hR.symm)
  · apply unitExt
    intro T
    have e1 : ∀ T' : XE.ProEt,
        ConcreteCategory.hom ((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC βE) _ _ DβE.cont DβE.φ).val.app (Opposite.op T'))
          (1 : (wcRingSheaf XE ℓ).obj.obj (Opposite.op T')) =
        (1 : (wcRingSheaf XE' ℓ).obj.obj (Opposite.op ((wcProEtBC βE).obj T'))) :=
      fun T' => (SheafOfModules.unitToPushforwardObjUnit_val_app_apply DβE.φ
        (X := Opposite.op T') (1 : (wcRingSheaf XE ℓ).obj.obj (Opposite.op T'))).trans
          (map_one (ConcreteCategory.hom (DβE.φ.hom.app (Opposite.op T'))))
    have e2 : ConcreteCategory.hom ((PE.map
        (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC w') _ _ Dτ'.cont Dτ'.φ)).val.app (Opposite.op T))
        (1 : (wcRingSheaf XE' ℓ).obj.obj (Opposite.op ((wcProEtBC βE).obj T))) =
        (1 : (wcRingSheaf XE' ℓ).obj.obj
          (Opposite.op ((wcProEtBC w').obj ((wcProEtBC βE).obj T)))) :=
      (pfMapEval DβE.φ _ T _).trans
        ((SheafOfModules.unitToPushforwardObjUnit_val_app_apply Dτ'.φ
          (X := Opposite.op ((wcProEtBC βE).obj T))
          (1 : (wcRingSheaf XE' ℓ).obj.obj (Opposite.op ((wcProEtBC βE).obj T)))).trans
          (map_one (ConcreteCategory.hom (Dτ'.φ.hom.app
            (Opposite.op ((wcProEtBC βE).obj T))))))
    have e3 := hβw (SheafOfModules.unit (wcRingSheaf XE' ℓ)) T
      (1 : (wcRingSheaf XE' ℓ).obj.obj
          (Opposite.op ((wcProEtBC w').obj ((wcProEtBC βE).obj T))))
    have e4 : ConcreteCategory.hom ((SheafOfModules.unit (wcRingSheaf XE' ℓ)).val.map
        (ζw.hom.app T).op) (1 : (wcRingSheaf XE' ℓ).obj.obj
          (Opposite.op ((wcProEtBC w').obj ((wcProEtBC βE).obj T)))) =
        (1 : (wcRingSheaf XE' ℓ).obj.obj
          (Opposite.op ((wcProEtBC βE).obj ((wcProEtBC w).obj T)))) :=
      PresheafOfModules.unit_map_one _ _
    have e5 : ConcreteCategory.hom ((@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
          (wcProEtBC w) _ _ Dτ.cont Dτ.φ).val.app (Opposite.op T))
        (1 : (wcRingSheaf XE ℓ).obj.obj (Opposite.op T)) =
        (1 : (wcRingSheaf XE ℓ).obj.obj (Opposite.op ((wcProEtBC w).obj T))) :=
      (SheafOfModules.unitToPushforwardObjUnit_val_app_apply Dτ.φ (X := Opposite.op T)
        (1 : (wcRingSheaf XE ℓ).obj.obj (Opposite.op T))).trans
        (map_one (ConcreteCategory.hom (Dτ.φ.hom.app (Opposite.op T))))
    have e6 := pfMapEval Dτ.φ (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _
        (wcProEtBC βE) _ _ DβE.cont DβE.φ) T
      (1 : (wcRingSheaf XE ℓ).obj.obj (Opposite.op ((wcProEtBC w).obj T)))
    refine (compEval _ _ _ _).trans ((compEval _ _ _ _).trans ?_)
    refine Eq.trans ?_ (compEval _ _ _ _).symm
    refine (congrArg _ ((congrArg _ (e1 T)).trans e2)).trans (e3.trans (e4.trans ?_))
    exact ((congrArg _ e5).trans (e6.trans (e1 _))).symm

theorem wc_ntc_abs_transfer {C' : Type*} {D' : Type*} {C : Type*} {D : Type*}
    [Category C'] [Category D'] [Category C] [Category D]
    [Abelian C'] [Abelian D'] [Abelian C] [Abelian D]
    (P' : C' ⥤ C) (P : D' ⥤ D) (Pg : C ⥤ D) (PE : C' ⥤ D')
    [P'.Additive] [P.Additive] [Pg.Additive] [PE.Additive]
    [Limits.PreservesFiniteLimits PE] [Limits.PreservesFiniteColimits PE]
    (hinj : ∀ J : C', Injective J → Injective (PE.obj J))
    (Φw' Pw' : C' ⥤ C') [Φw'.Additive] [Pw'.Additive] (adj' : Φw' ⊣ Pw')
    (Φw Pw : D' ⥤ D') [Φw.Additive] [Pw.Additive]
    [Limits.PreservesFiniteLimits Φw] [Limits.PreservesFiniteColimits Φw] (adj : Φw ⊣ Pw)
    (γ' : Pw' ⋙ P' ⟶ P') (γ : Pw ⋙ P ⟶ P)
    (R' : C') (R : D') (μ' : PE.obj R' ≅ R) (uP' : R' ⟶ Pw'.obj R') (uP : R ⟶ Pw.obj R)
    (β : P' ⋙ Pg ≅ PE ⋙ P) (βw : Pw' ⋙ PE ⟶ PE ⋙ Pw)
    (hBC4 : ∀ M : C', Pg.map (γ'.app M) ≫ β.hom.app M =
      β.hom.app (Pw'.obj M) ≫ P.map (βw.app M) ≫ γ.app (PE.obj M))
    (hunit : μ'.inv ≫ PE.map uP' ≫ βw.app R' = uP ≫ Pw.map μ'.inv)
    (I' : InjectiveResolution R') (I : InjectiveResolution R)
    (t' : (Φw'.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex ⟶
      I'.cochainComplex)
    (ht' : (Φw'.mapHomologicalComplex (ComplexShape.up ℤ)).map I'.ι' ≫ t' =
      (HomologicalComplex.singleMapHomologicalComplex Φw' (ComplexShape.up ℤ) 0).hom.app R' ≫
      (HomologicalComplex.single C' (ComplexShape.up ℤ) 0).map ((adj'.homEquiv _ _).symm uP') ≫
      I'.ι')
    (t : (Φw.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ⟶
      I.cochainComplex)
    (ht : (Φw.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ t =
      (HomologicalComplex.singleMapHomologicalComplex Φw (ComplexShape.up ℤ) 0).hom.app R ≫
      (HomologicalComplex.single D' (ComplexShape.up ℤ) 0).map ((adj.homEquiv _ _).symm uP) ≫
      I.ι') :
    let T := (P.mapHomologicalComplex (ComplexShape.up ℤ)).map
        ((Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
          (NatTrans.mapHomologicalComplex adj.unit (ComplexShape.up ℤ)).app I.cochainComplex ≫
          (Functor.mapHomologicalComplexCompIso (Iso.refl (Φw ⋙ Pw))
            (ComplexShape.up ℤ)).inv.app I.cochainComplex ≫
          (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map t) ≫
      (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P))
        (ComplexShape.up ℤ)).hom.app I.cochainComplex ≫
      (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app I.cochainComplex
    let T' := (P'.mapHomologicalComplex (ComplexShape.up ℤ)).map
        ((Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app I'.cochainComplex ≫
          (NatTrans.mapHomologicalComplex adj'.unit (ComplexShape.up ℤ)).app I'.cochainComplex ≫
          (Functor.mapHomologicalComplexCompIso (Iso.refl (Φw' ⋙ Pw'))
            (ComplexShape.up ℤ)).inv.app I'.cochainComplex ≫
          (Pw'.mapHomologicalComplex (ComplexShape.up ℤ)).map t') ≫
      (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw' ⋙ P'))
        (ComplexShape.up ℤ)).hom.app I'.cochainComplex ≫
      (NatTrans.mapHomologicalComplex γ' (ComplexShape.up ℤ)).app I'.cochainComplex
    ∃ e : HomotopyEquiv ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex)
        ((Pg.mapHomologicalComplex (ComplexShape.up ℤ)).obj
          ((P'.mapHomologicalComplex (ComplexShape.up ℤ)).obj I'.cochainComplex)),
      Nonempty (Homotopy (T ≫ e.hom)
        (e.hom ≫ (Pg.mapHomologicalComplex (ComplexShape.up ℤ)).map T')) :=
by
  intro T T'

  have L1 : ∀ (F : C' ⥤ D') [F.Additive] [Limits.PreservesFiniteLimits F]
      [Limits.PreservesFiniteColimits F]
      (_ : ∀ J : C', Injective J → Injective (F.obj J))
      (X : C') (Y : D') (μ : F.obj X ≅ Y) (I : InjectiveResolution X),
      ∃ (IU : InjectiveResolution Y)
        (θ : (F.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex ≅
          IU.cochainComplex),
        (F.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι' ≫ θ.hom =
          (HomologicalComplex.singleMapHomologicalComplex F (ComplexShape.up ℤ) 0).hom.app X ≫
          (HomologicalComplex.single D' (ComplexShape.up ℤ) 0).map μ.hom ≫ IU.ι' := by
    intro F _ _ _ hinj X Y μ I
    classical
    let FK := (F.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
    let ιU : (CochainComplex.single₀ D').obj Y ⟶ FK := (CochainComplex.single₀ D').map μ.inv ≫
          (HomologicalComplex.singleMapHomologicalComplex F (ComplexShape.up ℕ) 0).inv.app X ≫
          (F.mapHomologicalComplex (ComplexShape.up ℕ)).map I.ι
    let IU : InjectiveResolution Y :=
      { cocomplex := FK
        injective := fun n => hinj _ (I.injective n)
        ι := ιU
        quasiIso := by dsimp only [ιU]; infer_instance }
    let A := (F.mapHomologicalComplex (ComplexShape.up ℤ)).obj
      (I.cocomplex.extend ComplexShape.embeddingUpNat)
    let B := FK.extend ComplexShape.embeddingUpNat
    have hcomp : ∀ n : ℤ, ∃ f : A.X n ≅ B.X n,
        ∀ (k : ℕ) (h : ComplexShape.embeddingUpNat.f k = n),
          f.hom = F.map (I.cocomplex.extendXIso ComplexShape.embeddingUpNat h).hom ≫
            (FK.extendXIso ComplexShape.embeddingUpNat h).inv := by
      intro n
      by_cases hn : ∃ k, ComplexShape.embeddingUpNat.f k = n
      · obtain ⟨k, hk⟩ := hn
        refine ⟨F.mapIso (I.cocomplex.extendXIso _ hk) ≪≫ (FK.extendXIso _ hk).symm, ?_⟩
        intro k' hk'
        have : k' = k := ComplexShape.embeddingUpNat.injective_f (hk'.trans hk.symm)
        subst this
        rfl
      · push Not at hn
        refine ⟨Limits.IsZero.iso ?_ ?_, fun k hk => absurd hk (hn k)⟩
        · exact F.map_isZero (I.cocomplex.isZero_extend_X _ n hn)
        · exact FK.isZero_extend_X _ n hn
    choose f hf using hcomp
    let θ : A ≅ B := HomologicalComplex.Hom.isoOfComponents f (by
      intro i j _
      by_cases hi : ∃ k, ComplexShape.embeddingUpNat.f k = i
      · by_cases hj : ∃ k, ComplexShape.embeddingUpNat.f k = j
        · obtain ⟨k, hk⟩ := hi
          obtain ⟨k', hk'⟩ := hj
          rw [hf i k hk, hf j k' hk']
          have hdB : B.d i j = (FK.extendXIso _ hk).hom ≫ FK.d k k' ≫
              (FK.extendXIso _ hk').inv := HomologicalComplex.extend_d_eq _ _ hk hk'
          have hdA : A.d i j =
              F.map ((I.cocomplex.extendXIso _ hk).hom ≫ I.cocomplex.d k k' ≫
                (I.cocomplex.extendXIso _ hk').inv) :=
            congrArg F.map (HomologicalComplex.extend_d_eq _ _ hk hk')
          rw [hdA, hdB]
          have hFd : FK.d k k' = F.map (I.cocomplex.d k k') := rfl
          rw [hFd]
          simp only [Functor.map_comp, Category.assoc, Iso.inv_hom_id_assoc,
            Iso.map_inv_hom_id_assoc]
        · push Not at hj
          apply Limits.IsZero.eq_of_tgt
          exact FK.isZero_extend_X _ j hj
      · push Not at hi
        apply Limits.IsZero.eq_of_src
        exact F.map_isZero (I.cocomplex.isZero_extend_X _ i hi))
    refine ⟨IU, θ, ?_⟩
    ext n
    by_cases hn : n = 0
    · subst hn
      have h0 : ComplexShape.embeddingUpNat.f 0 = (0 : ℤ) := rfl
      have hθ0 : θ.hom.f 0 = F.map (I.cocomplex.extendXIso _ h0).hom ≫
          (FK.extendXIso _ h0).inv := hf 0 0 h0
      have hU : IU.ι'.f 0 = (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 Y).hom ≫
          ιU.f 0 ≫ (FK.extendXIso _ h0).inv := InjectiveResolution.ι'_f_zero IU
      have hI : I.ι'.f 0 = (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 X).hom ≫
          I.ι.f 0 ≫ (I.cocomplex.extendXIso _ h0).inv := InjectiveResolution.ι'_f_zero I
      simp only [HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f, hθ0, hU, hI,
        HomologicalComplex.singleMapHomologicalComplex_hom_app_self,
        HomologicalComplex.single_map_f_self, ιU,
        HomologicalComplex.singleMapHomologicalComplex_inv_app_self,
        CochainComplex.single₀_map_f_zero, Functor.map_comp, Category.assoc,
        Iso.map_inv_hom_id_assoc, Iso.inv_hom_id_assoc, Iso.hom_inv_id_assoc]
      have key : ∀ g : X ⟶ I.cocomplex.X 0,
          F.map (𝟙 X ≫ g ≫ (I.cocomplex.extendXIso _ h0).inv) ≫
            F.map (I.cocomplex.extendXIso _ h0).hom ≫ (FK.extendXIso _ h0).inv =
          F.map (𝟙 X) ≫ 𝟙 (F.obj X) ≫ (𝟙 (F.obj X) ≫ μ.hom ≫ 𝟙 Y) ≫ 𝟙 Y ≫
            (𝟙 Y ≫ μ.inv ≫ F.map (𝟙 X) ≫ F.map g) ≫ (FK.extendXIso _ h0).inv := by
        intro g
        simp only [Functor.map_comp, Category.id_comp, Category.assoc,
          Iso.map_inv_hom_id_assoc, Iso.hom_inv_id_assoc]
        rw [F.map_id, Category.id_comp, Category.id_comp]
      exact key (I.ι.f 0)
    · apply Limits.IsZero.eq_of_src
      exact F.map_isZero (HomologicalComplex.isZero_single_obj_X _ _ _ _ hn)

  have L2 : ∀ {Φw Pw : C' ⥤ C'} (adj : Φw ⊣ Pw) {ΦwU PwU : D' ⥤ D'} (adjU : ΦwU ⊣ PwU)
      (ρ' : C' ⥤ D') (βw : Pw ⋙ ρ' ⟶ ρ' ⋙ PwU) (R : C') (RU : D') (μ' : ρ'.obj R ≅ RU)
      (uP : R ⟶ Pw.obj R) (uPU : RU ⟶ PwU.obj RU)
      (_ : μ'.inv ≫ ρ'.map uP ≫ βw.app R = uPU ≫ PwU.map μ'.inv),
      ∃ α : ρ' ⋙ ΦwU ⟶ Φw ⋙ ρ',
        (∀ M : C', ρ'.map (adj.unit.app M) ≫ βw.app (Φw.obj M) =
          adjU.unit.app (ρ'.obj M) ≫ PwU.map (α.app M)) ∧
        α.app R ≫ ρ'.map ((adj.homEquiv _ _).symm uP) ≫ μ'.hom =
          ΦwU.map μ'.hom ≫ (adjU.homEquiv _ _).symm uPU := by
    intro Φw Pw adj ΦwU PwU adjU ρ' βw R RU μ' uP uPU h
    have h3 : ∀ M : C', ρ'.map (adj.unit.app M) ≫ βw.app (Φw.obj M) =
        adjU.unit.app (ρ'.obj M) ≫ PwU.map (((mateEquiv adj adjU).symm βw).app M) := by
      intro M
      have := unit_mateEquiv adj adjU ((mateEquiv adj adjU).symm βw) M
      have e : (mateEquiv adj adjU) ((mateEquiv adj adjU).symm βw) = βw :=
        (mateEquiv adj adjU).apply_symm_apply βw
      rw [e] at this
      exact this
    refine ⟨(mateEquiv adj adjU).symm βw, h3, ?_⟩
    apply (adjU.homEquiv (ρ'.obj R) RU).injective
    rw [Adjunction.homEquiv_unit, Adjunction.homEquiv_naturality_left, Equiv.apply_symm_apply]
    simp only [Functor.map_comp]
    rw [← Category.assoc, ← h3 R]
    have hn := βw.naturality ((adj.homEquiv _ _).symm uP)
    simp only [Functor.comp_map] at hn
    rw [Category.assoc, ← Category.assoc (βw.app _), ← hn]
    have he : adj.unit.app R ≫ Pw.map ((adj.homEquiv R R).symm uP) = uP :=
      (adj.homEquiv_unit R R _).symm.trans (Equiv.apply_symm_apply _ _)
    rw [← Category.assoc, ← Category.assoc, ← Functor.map_comp, he]
    have h' : ρ'.map uP ≫ βw.app R = μ'.hom ≫ uPU ≫ PwU.map μ'.inv :=
      (Iso.inv_comp_eq μ').mp h
    rw [h']
    simp

  have L3 : ∀ (Φw : C' ⥤ C') (ΦwU : D' ⥤ D') (ρ' : C' ⥤ D') [Φw.Additive] [ΦwU.Additive]
      [ρ'.Additive]
      (α : ρ' ⋙ ΦwU ⟶ Φw ⋙ ρ') (R : C') (RU : D') (μ' : ρ'.obj R ≅ RU)
      (e : Φw.obj R ⟶ R) (eU : ΦwU.obj RU ⟶ RU)
      (_ : α.app R ≫ ρ'.map e ≫ μ'.hom = ΦwU.map μ'.hom ≫ eU)
      (X : CochainComplex C' ℤ)
      (ιX : (HomologicalComplex.single C' (ComplexShape.up ℤ) 0).obj R ⟶ X)
      (XU : CochainComplex D' ℤ)
      (ιXU : (HomologicalComplex.single D' (ComplexShape.up ℤ) 0).obj RU ⟶ XU)
      (θ : (ρ'.mapHomologicalComplex (ComplexShape.up ℤ)).obj X ≅ XU)
      (_ : (ρ'.mapHomologicalComplex (ComplexShape.up ℤ)).map ιX ≫ θ.hom =
        (HomologicalComplex.singleMapHomologicalComplex ρ' (ComplexShape.up ℤ) 0).hom.app R ≫
        (HomologicalComplex.single D' (ComplexShape.up ℤ) 0).map μ'.hom ≫ ιXU)
      (t : (Φw.mapHomologicalComplex (ComplexShape.up ℤ)).obj X ⟶ X)
      (_ : (Φw.mapHomologicalComplex (ComplexShape.up ℤ)).map ιX ≫ t =
        (HomologicalComplex.singleMapHomologicalComplex Φw (ComplexShape.up ℤ) 0).hom.app R ≫
        (HomologicalComplex.single C' (ComplexShape.up ℤ) 0).map e ≫ ιX)
      (tU : (ΦwU.mapHomologicalComplex (ComplexShape.up ℤ)).obj XU ⟶ XU)
      (_ : tU = (ΦwU.mapHomologicalComplex (ComplexShape.up ℤ)).map θ.inv ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (ρ' ⋙ ΦwU)) (ComplexShape.up ℤ)).hom.app X ≫
        (NatTrans.mapHomologicalComplex α (ComplexShape.up ℤ)).app X ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Φw ⋙ ρ')) (ComplexShape.up ℤ)).inv.app X ≫
        (ρ'.mapHomologicalComplex (ComplexShape.up ℤ)).map t ≫ θ.hom),
      (ΦwU.mapHomologicalComplex (ComplexShape.up ℤ)).map ιXU ≫ tU =
        (HomologicalComplex.singleMapHomologicalComplex ΦwU (ComplexShape.up ℤ) 0).hom.app RU ≫
        (HomologicalComplex.single D' (ComplexShape.up ℤ) 0).map eU ≫ ιXU := by
    intro Φw ΦwU ρ' _ _ _ α R RU μ' e eU hBC6 X ιX XU ιXU θ hθ t hLP tU htU
    subst htU
    have hθ0 := congrArg (fun φ => HomologicalComplex.Hom.f φ 0) hθ
    have hLP0 := congrArg (fun φ => HomologicalComplex.Hom.f φ 0) hLP
    simp only [HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f,
      HomologicalComplex.singleMapHomologicalComplex_hom_app_self,
      HomologicalComplex.single_map_f_self, Category.assoc, Iso.inv_hom_id_assoc] at hθ0 hLP0
    apply (cancel_epi ((HomologicalComplex.singleMapHomologicalComplex ΦwU
      (ComplexShape.up ℤ) 0).inv.app RU)).mp
    rw [Iso.inv_hom_id_app_assoc]
    apply HomologicalComplex.from_single_hom_ext
    simp only [HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f,
      HomologicalComplex.singleMapHomologicalComplex_inv_app_self,
      HomologicalComplex.single_map_f_self, Category.assoc, NatTrans.mapHomologicalComplex_app_f,
      Functor.mapHomologicalComplexCompIso_hom_app_f,
      Functor.mapHomologicalComplexCompIso_inv_app_f, Iso.refl_hom, Iso.refl_inv,
      NatTrans.id_app]
    set sR := HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 R with hsR
    set sRU := HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 RU with hsRU
    set j : R ⟶ X.X 0 := sR.inv ≫ ιX.f 0 with hjdef
    set jU : RU ⟶ XU.X 0 := sRU.inv ≫ ιXU.f 0 with hjUdef
    have hj : ιX.f 0 = sR.hom ≫ j := by rw [hjdef, Iso.hom_inv_id_assoc]
    have hjU : ιXU.f 0 = sRU.hom ≫ jU := by rw [hjUdef, Iso.hom_inv_id_assoc]
    simp only [hj, hjU, Functor.map_comp, Category.assoc] at hθ0 hLP0 ⊢
    have hA : ρ'.map j ≫ θ.hom.f 0 = μ'.hom ≫ jU := (cancel_epi (ρ'.map sR.hom)).mp hθ0
    have hB : Φw.map j ≫ t.f 0 = e ≫ j := (cancel_epi (Φw.map sR.hom)).mp hLP0
    rw [← Functor.map_comp_assoc ΦwU sRU.inv sRU.hom, Iso.inv_hom_id,
      CategoryTheory.Functor.map_id, Category.id_comp, cancel_epi]
    have hθhi : θ.hom.f 0 ≫ θ.inv.f 0 = 𝟙 _ := by
      rw [← HomologicalComplex.comp_f, θ.hom_inv_id, HomologicalComplex.id_f]
    have hA' : jU ≫ θ.inv.f 0 = μ'.inv ≫ ρ'.map j := by
      calc jU ≫ θ.inv.f 0 = (μ'.inv ≫ μ'.hom ≫ jU) ≫ θ.inv.f 0 := by
            rw [Iso.inv_hom_id_assoc]
        _ = (μ'.inv ≫ ρ'.map j ≫ θ.hom.f 0) ≫ θ.inv.f 0 := by rw [hA]
        _ = μ'.inv ≫ ρ'.map j := by
            simp only [Category.assoc, hθhi]
            erw [Category.comp_id]
    have hnat : ΦwU.map (ρ'.map j) ≫ α.app (X.X 0) = α.app R ≫ ρ'.map (Φw.map j) := by
      have := α.naturality j
      simpa only [Functor.comp_map] using this
    have key : ΦwU.map jU ≫ ΦwU.map (θ.inv.f 0) ≫ α.app (X.X 0) ≫ ρ'.map (t.f 0) ≫
        θ.hom.f 0 = eU ≫ jU := by
      rw [← Functor.map_comp_assoc, hA', Functor.map_comp, Category.assoc, reassoc_of% hnat,
        ← Functor.map_comp_assoc ρ', hB, Functor.map_comp, Category.assoc, hA,
        reassoc_of% hBC6, ← Functor.map_comp_assoc, Iso.inv_hom_id, CategoryTheory.Functor.map_id,
        Category.id_comp]
    erw [Category.id_comp, Category.id_comp]
    exact key

  have L4 : ∀ (P : C' ⥤ C) (Pw Φw : C' ⥤ C') (Φg : C ⥤ C) [P.Additive] [Pw.Additive]
      [Φw.Additive] [Φg.Additive] (adj : Φw ⊣ Pw) (γ : Pw ⋙ P ⟶ P)
      (PU : D' ⥤ D) (PwU ΦwU : D' ⥤ D') (ΦgU : D ⥤ D) [PU.Additive] [PwU.Additive]
      [ΦwU.Additive] [ΦgU.Additive] (adjU : ΦwU ⊣ PwU) (γU : PwU ⋙ PU ⟶ PU)
      (ρ' : C' ⥤ D') (ρ : C ⥤ D) (ρZ : C ⥤ D) [ρ'.Additive] [ρ.Additive] [ρZ.Additive]
      (β : P ⋙ ρ ≅ ρ' ⋙ PU) (βw : Pw ⋙ ρ' ⟶ ρ' ⋙ PwU) (α : ρ' ⋙ ΦwU ⟶ Φw ⋙ ρ')
      (δ : Φg ⋙ ρZ ≅ ρ ⋙ ΦgU)
      (_ : ∀ M : C', ρ'.map (adj.unit.app M) ≫ βw.app (Φw.obj M) =
        adjU.unit.app (ρ'.obj M) ≫ PwU.map (α.app M))
      (_ : ∀ M : C', ρ.map (γ.app M) ≫ β.hom.app M =
        β.hom.app (Pw.obj M) ≫ PU.map (βw.app M) ≫ γU.app (ρ'.obj M))
      (X : CochainComplex C' ℤ) (XU : CochainComplex D' ℤ)
      (θ : (ρ'.mapHomologicalComplex (ComplexShape.up ℤ)).obj X ≅ XU)
      (t : (Φw.mapHomologicalComplex (ComplexShape.up ℤ)).obj X ⟶ X)
      (tU : (ΦwU.mapHomologicalComplex (ComplexShape.up ℤ)).obj XU ⟶ XU)
      (_ : tU = (ΦwU.mapHomologicalComplex (ComplexShape.up ℤ)).map θ.inv ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (ρ' ⋙ ΦwU)) (ComplexShape.up ℤ)).hom.app X ≫
        (NatTrans.mapHomologicalComplex α (ComplexShape.up ℤ)).app X ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Φw ⋙ ρ')) (ComplexShape.up ℤ)).inv.app X ≫
        (ρ'.mapHomologicalComplex (ComplexShape.up ℤ)).map t ≫ θ.hom)
      (T : (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj X ⟶
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).obj X)
      (_ : T = (P.mapHomologicalComplex (ComplexShape.up ℤ)).map
          ((Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app X ≫
            (NatTrans.mapHomologicalComplex adj.unit (ComplexShape.up ℤ)).app X ≫
            (Functor.mapHomologicalComplexCompIso (Iso.refl (Φw ⋙ Pw))
              (ComplexShape.up ℤ)).inv.app X ≫
            (Pw.mapHomologicalComplex (ComplexShape.up ℤ)).map t) ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (Pw ⋙ P)) (ComplexShape.up ℤ)).hom.app X ≫
        (NatTrans.mapHomologicalComplex γ (ComplexShape.up ℤ)).app X)
      (TU : (PU.mapHomologicalComplex (ComplexShape.up ℤ)).obj XU ⟶
        (PU.mapHomologicalComplex (ComplexShape.up ℤ)).obj XU)
      (_ : TU = (PU.mapHomologicalComplex (ComplexShape.up ℤ)).map
          ((Functor.mapHomologicalComplexIdIso _ (ComplexShape.up ℤ)).inv.app XU ≫
            (NatTrans.mapHomologicalComplex adjU.unit (ComplexShape.up ℤ)).app XU ≫
            (Functor.mapHomologicalComplexCompIso (Iso.refl (ΦwU ⋙ PwU))
              (ComplexShape.up ℤ)).inv.app XU ≫
            (PwU.mapHomologicalComplex (ComplexShape.up ℤ)).map tU) ≫
        (Functor.mapHomologicalComplexCompIso (Iso.refl (PwU ⋙ PU)) (ComplexShape.up ℤ)).hom.app XU ≫
        (NatTrans.mapHomologicalComplex γU (ComplexShape.up ℤ)).app XU),
      ∃ χ : (ρZ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
            ((Φg.mapHomologicalComplex (ComplexShape.up ℤ)).obj
              ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj X)) ≅
          (ΦgU.mapHomologicalComplex (ComplexShape.up ℤ)).obj
            ((PU.mapHomologicalComplex (ComplexShape.up ℤ)).obj XU),
        (ρZ.mapHomologicalComplex (ComplexShape.up ℤ)).map
            ((Φg.mapHomologicalComplex (ComplexShape.up ℤ)).map T) ≫ χ.hom =
          χ.hom ≫ (ΦgU.mapHomologicalComplex (ComplexShape.up ℤ)).map TU := by
    intro P Pw Φw Φg _ _ _ _ adj γ PU PwU ΦwU ΦgU _ _ _ _ adjU γU ρ' ρ ρZ _ _ _ β βw α δ
      hBC3 hBC4 X XU θ t tU htU T hT TU hTU
    have hTf : ∀ n, T.f n = P.map (adj.unit.app (X.X n) ≫ Pw.map (t.f n)) ≫ γ.app (X.X n) := by
      intro n; subst hT; simp
    have hTUf : ∀ n, TU.f n =
        PU.map (adjU.unit.app (XU.X n) ≫ PwU.map (tU.f n)) ≫ γU.app (XU.X n) := by
      intro n; subst hTU; simp
    have htUf : ∀ n, tU.f n =
        ΦwU.map (θ.inv.f n) ≫ α.app (X.X n) ≫ ρ'.map (t.f n) ≫ θ.hom.f n := by
      intro n; subst htU; simp
    have key : ∀ (M : C') (N : D') (e : ρ'.obj M ≅ N) (s : Φw.obj M ⟶ M),
        ρ.map (P.map (adj.unit.app M ≫ Pw.map s) ≫ γ.app M) ≫ β.hom.app M ≫ PU.map e.hom =
        β.hom.app M ≫ PU.map e.hom ≫ (PU.map (adjU.unit.app N ≫
          PwU.map (ΦwU.map e.inv ≫ α.app M ≫ ρ'.map s ≫ e.hom)) ≫ γU.app N) := by
      intro M N e s
      have hinv : PwU.map (ΦwU.map e.hom) ≫ PwU.map (ΦwU.map e.inv) = 𝟙 _ := by
        rw [← PwU.map_comp, ← ΦwU.map_comp, e.hom_inv_id, ΦwU.map_id, PwU.map_id]
      have hw : ρ'.map (Pw.map s) ≫ βw.app M = βw.app (Φw.obj M) ≫ PwU.map (ρ'.map s) :=
        βw.naturality s
      have inner : ρ'.map (adj.unit.app M) ≫ ρ'.map (Pw.map s) ≫ βw.app M ≫ PwU.map e.hom =
          e.hom ≫ adjU.unit.app N ≫ PwU.map (ΦwU.map e.inv) ≫ PwU.map (α.app M) ≫
            PwU.map (ρ'.map s) ≫ PwU.map e.hom := by
        rw [reassoc_of% hw, reassoc_of% (hBC3 M), ← adjU.unit_naturality_assoc,
          reassoc_of% hinv]
      have inner' := congrArg PU.map inner
      simp only [Functor.map_comp] at inner'
      have hγ : PU.map (PwU.map e.hom) ≫ γU.app N = γU.app (ρ'.obj M) ≫ PU.map e.hom :=
        γU.naturality e.hom
      have hβ1 : ρ.map (P.map (Pw.map s)) ≫ β.hom.app (Pw.obj M) =
          β.hom.app (Pw.obj (Φw.obj M)) ≫ PU.map (ρ'.map (Pw.map s)) :=
        β.hom.naturality (Pw.map s)
      have hβ2 : ρ.map (P.map (adj.unit.app M)) ≫ β.hom.app (Pw.obj (Φw.obj M)) =
          β.hom.app M ≫ PU.map (ρ'.map (adj.unit.app M)) :=
        β.hom.naturality (adj.unit.app M)
      simp only [Functor.map_comp, Category.assoc]
      rw [reassoc_of% (hBC4 M), ← hγ, reassoc_of% hβ1, reassoc_of% hβ2, reassoc_of% inner']
    let χ := HomologicalComplex.Hom.isoOfComponents
        (C₁ := (ρZ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
            ((Φg.mapHomologicalComplex (ComplexShape.up ℤ)).obj
              ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj X)))
        (C₂ := (ΦgU.mapHomologicalComplex (ComplexShape.up ℤ)).obj
            ((PU.mapHomologicalComplex (ComplexShape.up ℤ)).obj XU))
        (fun n => δ.app (P.obj (X.X n)) ≪≫
          ΦgU.mapIso (β.app (X.X n) ≪≫ PU.mapIso (HomologicalComplex.Hom.isoApp θ n)))
        (by
          intro i j _
          have h1 : θ.hom.f i ≫ XU.d i j = ρ'.map (X.d i j) ≫ θ.hom.f j := θ.hom.comm i j
          have h2 : ρZ.map (Φg.map (P.map (X.d i j))) ≫ δ.hom.app (P.obj (X.X j)) =
              δ.hom.app (P.obj (X.X i)) ≫ ΦgU.map (ρ.map (P.map (X.d i j))) :=
            δ.hom.naturality (P.map (X.d i j))
          have h3 : ρ.map (P.map (X.d i j)) ≫ β.hom.app (X.X j) =
              β.hom.app (X.X i) ≫ PU.map (ρ'.map (X.d i j)) :=
            β.hom.naturality (X.d i j)
          have h4 : β.hom.app (X.X i) ≫ PU.map (θ.hom.f i) ≫ PU.map (XU.d i j) =
              ρ.map (P.map (X.d i j)) ≫ β.hom.app (X.X j) ≫ PU.map (θ.hom.f j) := by
            rw [← PU.map_comp, h1, PU.map_comp, reassoc_of% h3]
          have h5 : ΦgU.map (β.hom.app (X.X i) ≫ PU.map (θ.hom.f i)) ≫
              ΦgU.map (PU.map (XU.d i j)) =
              ΦgU.map (ρ.map (P.map (X.d i j))) ≫
                ΦgU.map (β.hom.app (X.X j) ≫ PU.map (θ.hom.f j)) := by
            rw [← ΦgU.map_comp, ← ΦgU.map_comp, Category.assoc, h4]
          simp only [Iso.trans_hom, Functor.mapIso_hom, Iso.app_hom,
            HomologicalComplex.Hom.isoApp_hom, Functor.mapHomologicalComplex_obj_d,
            Category.assoc]
          rw [reassoc_of% h2, h5])
    refine ⟨χ, ?_⟩
    ext n
    have kn := key (X.X n) (XU.X n) (HomologicalComplex.Hom.isoApp θ n) (t.f n)
    simp only [HomologicalComplex.Hom.isoApp_hom, HomologicalComplex.Hom.isoApp_inv] at kn
    rw [← htUf, ← hTUf, ← hTf] at kn
    have h2 : ρZ.map (Φg.map (T.f n)) ≫ δ.hom.app (P.obj (X.X n)) =
        δ.hom.app (P.obj (X.X n)) ≫ ΦgU.map (ρ.map (T.f n)) :=
      δ.hom.naturality (T.f n)
    have kn' := congrArg ΦgU.map kn
    simp only [Functor.map_comp] at kn'
    simp only [χ, HomologicalComplex.comp_f, Functor.mapHomologicalComplex_map_f,
      HomologicalComplex.Hom.isoOfComponents_hom_f, Iso.trans_hom, Functor.mapIso_hom,
      Iso.app_hom, HomologicalComplex.Hom.isoApp_hom, Functor.map_comp, Category.assoc]
    rw [reassoc_of% h2, kn']

  obtain ⟨J, θ, hθ⟩ := L1 PE hinj R' R μ' I'

  obtain ⟨α, hBC3, hBC6⟩ := L2 adj' adj PE βw R' R μ' uP' uP hunit

  let tU : (Φw.mapHomologicalComplex (ComplexShape.up ℤ)).obj J.cochainComplex ⟶
      J.cochainComplex :=
    (Φw.mapHomologicalComplex (ComplexShape.up ℤ)).map θ.inv ≫
      (Functor.mapHomologicalComplexCompIso (Iso.refl (PE ⋙ Φw)) (ComplexShape.up ℤ)).hom.app
        I'.cochainComplex ≫
      (NatTrans.mapHomologicalComplex α (ComplexShape.up ℤ)).app I'.cochainComplex ≫
      (Functor.mapHomologicalComplexCompIso (Iso.refl (Φw' ⋙ PE)) (ComplexShape.up ℤ)).inv.app
        I'.cochainComplex ≫
