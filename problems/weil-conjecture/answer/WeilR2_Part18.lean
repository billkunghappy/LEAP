    exact ⟨W', 𝟙 _, g, fun a => a.elim0, Category.id_comp g⟩

theorem wc_qmtm_kummer_ring_tower_coh {L M : Type u} [Field L] [CommRing M] (ℓ : ℕ)
    [Fact (Nat.Prime ℓ)] (hℓL : IsUnit ((ℓ : ℕ) : L)) (e : LaurentPolynomial L →+* M) (a : M)
    (ha : e (LaurentPolynomial.T 1) = a) (j : ℕ)
    (hkill : ∀ (k : ℕ) (x : wcEtZModExt (Spec (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) -
        Polynomial.C a)))) ℓ (j + 1)), ∃ d : ℕ,
      ∀ (β : AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C a) →+*
          AdjoinRoot (Polynomial.X ^ (ℓ ^ (k + d)) - Polynomial.C a)),
        β.comp (AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C a)) =
          AdjoinRoot.of (Polynomial.X ^ (ℓ ^ (k + d)) - Polynomial.C a) →
        β (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C a)) =
          AdjoinRoot.root (Polynomial.X ^ (ℓ ^ (k + d)) - Polynomial.C a) ^ (ℓ ^ d) →
        ∀ (E : wcEtPullData (Spec.map (CommRingCat.ofHom β)) ℓ), wcEtPull E (j + 1) x = 0) :
    letI := e.toAlgebra
    letI := (AddMonoidAlgebra.mapDomainRingHom L
      (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom).toAlgebra
    Subsingleton (wcEtCoh (Spec (.of (TensorProduct (LaurentPolynomial L) M
      (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ)))))) ℓ (j + 1)) :=
by
  classical
  letI := e.toAlgebra
  letI := (AddMonoidAlgebra.mapDomainRingHom L
      (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom).toAlgebra

  have hℓM : IsUnit ((ℓ : ℕ) : M) := by
    have h := hℓL.map (e.comp LaurentPolynomial.C)
    rwa [map_natCast] at h
  have haU : IsUnit a := by
    rw [← ha]; exact (LaurentPolynomial.isUnit_T 1).map e

  have hét : ∀ k : ℕ, Etale (Spec.map (CommRingCat.ofHom
      (AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C a)))) := by
    intro k
    have hN0 : ℓ ^ k ≠ 0 := pow_ne_zero _ (Fact.out : ℓ.Prime).ne_zero
    have hNu : IsUnit (((ℓ ^ k : ℕ) : M)) := by rw [Nat.cast_pow]; exact hℓM.pow k
    generalize ℓ ^ k = N at hN0 hNu ⊢
    set f : Polynomial M := Polynomial.X ^ N - Polynomial.C a with hf
    have hfm : f.Monic := Polynomial.monic_X_pow_sub_C a hN0
    obtain ⟨v, hv⟩ := (hNu.mul haU).exists_left_inv
    have hcert : ∃ (p₁ p₂ : Polynomial M) (n : ℕ),
        Polynomial.derivative f * p₁ + f * p₂ = (1 : Polynomial M) ^ n := by
      refine ⟨Polynomial.C v * Polynomial.X, -(Polynomial.C v * Polynomial.C (N : M)), 1, ?_⟩
      have hd : Polynomial.derivative f = Polynomial.C (N : M) * Polynomial.X ^ (N - 1) := by
        rw [hf, Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_C,
          sub_zero]
      have hX : Polynomial.X ^ (N - 1) * Polynomial.X = (Polynomial.X : Polynomial M) ^ N :=
        pow_sub_one_mul hN0 Polynomial.X
      have hv' : Polynomial.C v * (Polynomial.C (N : M) * Polynomial.C a) = 1 := by
        rw [← map_mul, ← map_mul, hv, map_one]
      rw [hd, hf, pow_one]
      linear_combination hv' + (Polynomial.C v * Polynomial.C (N : M)) * hX
    let SP : StandardEtalePair M := ⟨f, hfm, 1, hcert⟩
    have e₂ : AdjoinRoot f ≃ₐ[M] Localization.Away ((AdjoinRoot.mk f) 1) :=
      (IsLocalization.atUnit (AdjoinRoot f) (Localization.Away ((AdjoinRoot.mk f) 1))
        ((AdjoinRoot.mk f) 1) (by simp)).restrictScalars M
    have eqv : SP.Ring ≃ₐ[M] AdjoinRoot f := SP.equivAwayAdjoinRoot.trans e₂.symm
    have het : Algebra.Etale M (AdjoinRoot f) := Algebra.Etale.of_equiv eqv
    rw [HasRingHomProperty.Spec_iff (P := @Etale), CommRingCat.hom_ofHom,
      ← AdjoinRoot.algebraMap_eq]
    exact RingHom.etale_algebraMap.mpr het

  obtain ⟨τ, hτof, hτroot, hτid, hτcomp⟩ : ∃ τ : ∀ k k' : ℕ, k ≤ k' →
      (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C a) →+*
        AdjoinRoot (Polynomial.X ^ (ℓ ^ k') - Polynomial.C a)),
      (∀ k k' (h : k ≤ k'), (τ k k' h).comp (AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C a)) =
        AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k') - Polynomial.C a)) ∧
      (∀ k k' (h : k ≤ k'), τ k k' h (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C a)) =
        AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k') - Polynomial.C a) ^ (ℓ ^ (k' - k))) ∧
      (∀ k (h : k ≤ k), τ k k h = RingHom.id _) ∧
      (∀ k k' k'' (h1 : k ≤ k') (h2 : k' ≤ k'') (h3 : k ≤ k''),
        (τ k' k'' h2).comp (τ k k' h1) = τ k k'' h3) := by
    have hθ : ∀ k : ℕ, AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C a) ^ (ℓ ^ k) =
        AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C a) a := by
      intro k
      have h := AdjoinRoot.mk_self (f := Polynomial.X ^ (ℓ ^ k) - Polynomial.C a)
      rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h
      exact h
    have hev : ∀ k k' (h : k ≤ k'), Polynomial.eval₂
        (AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k') - Polynomial.C a))
        (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k') - Polynomial.C a) ^ (ℓ ^ (k' - k)))
        (Polynomial.X ^ (ℓ ^ k) - Polynomial.C a) = 0 := by
      intro k k' h
      rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C, ← pow_mul, ← pow_add,
        Nat.sub_add_cancel h, hθ, sub_self]
    refine ⟨fun k k' h => AdjoinRoot.lift (AdjoinRoot.of _) _ (hev k k' h), ?_, ?_, ?_, ?_⟩
    · intro k k' h
      ext x
      simp
    · intro k k' h
      exact AdjoinRoot.lift_root _
    · intro k h
      apply AdjoinRoot.ringHom_ext
      · ext x
        simp
      · simp
    · intro k k' k'' h1 h2 h3
      apply AdjoinRoot.ringHom_ext
      · ext x
        simp
      · simp only [RingHom.comp_apply, AdjoinRoot.lift_root, map_pow, ← pow_mul, ← pow_add]
        congr 2
        omega

  have s4gen : ∀ {R : Type u} [CommRing R] (A : ℕ → Type u) [∀ k, CommRing (A k)]
      (τ' : ∀ k k' : ℕ, k ≤ k' → (A k →+* A k')) (γ' : ∀ k, A k →+* R)
      (_hγτ : ∀ k k' (h : k ≤ k'), (γ' k').comp (τ' k k' h) = γ' k)
      (_hinj : ∀ k, Function.Injective (γ' k)) (_hex : ∀ z : R, ∃ k y, γ' k y = z)
      (T : Scheme.{u}) (w : ∀ k, T ⟶ Spec (.of (A k)))
      (_hw : ∀ k k' (h : k ≤ k'), w k' ≫ Spec.map (CommRingCat.ofHom (τ' k k' h)) = w k),
      ∃! w₀ : T ⟶ Spec (.of R), ∀ k, w₀ ≫ Spec.map (CommRingCat.ofHom (γ' k)) = w k := by
    intro R _ A _ τ' γ' hγτ hinj hex T w hw
    have s1 : ∀ (R' : CommRingCat.{u}) (v : T ⟶ Spec R'),
        T.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso R').inv ≫ Scheme.Hom.appTop v) = v := by
      intro R' v
      rw [Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality, Category.assoc,
        toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
    have s2 : ∀ {R' S : CommRingCat.{u}} (f : S ⟶ R') (v : T ⟶ Spec R'),
        (Scheme.ΓSpecIso S).inv ≫ Scheme.Hom.appTop (v ≫ Spec.map f) =
          f ≫ (Scheme.ΓSpecIso R').inv ≫ Scheme.Hom.appTop v := by
      intro R' S f v
      have e' : (Scheme.ΓSpecIso S).inv ≫ Scheme.Hom.appTop (Spec.map f) =
          f ≫ (Scheme.ΓSpecIso R').inv := by
        rw [Iso.inv_comp_eq, ← Category.assoc, Iso.eq_comp_inv, Scheme.ΓSpecIso_naturality]
      rw [Scheme.Hom.comp_appTop, ← Category.assoc, e', Category.assoc]
    let ψ : ∀ k, A k →+* Γ(T, ⊤) := fun k =>
      ((Scheme.ΓSpecIso (CommRingCat.of (A k))).inv ≫ Scheme.Hom.appTop (w k)).hom
    have hψ : ∀ k k' (h : k ≤ k'), (ψ k').comp (τ' k k' h) = ψ k := by
      intro k k' h
      have h2 := s2 (CommRingCat.ofHom (τ' k k' h)) (w k')
      rw [hw k k' h] at h2
      show _ = CommRingCat.Hom.hom ((Scheme.ΓSpecIso (CommRingCat.of (A k))).inv ≫
        Scheme.Hom.appTop (w k))
      rw [h2]
      simp only [ψ, CommRingCat.hom_comp, CommRingCat.hom_ofHom]
    have agree : ∀ k k' (y : A k) (y' : A k'), γ' k y = γ' k' y' → ψ k y = ψ k' y' := by
      intro k k' y y' hyy
      have hk : k ≤ max k k' := le_max_left _ _
      have hk' : k' ≤ max k k' := le_max_right _ _
      have e1 := RingHom.congr_fun (hγτ k _ hk) y
      have e2 := RingHom.congr_fun (hγτ k' _ hk') y'
      rw [RingHom.comp_apply] at e1 e2
      have h2 := hinj _ (e1.trans (hyy.trans e2.symm))
      have e3 := RingHom.congr_fun (hψ k _ hk) y
      have e4 := RingHom.congr_fun (hψ k' _ hk') y'
      rw [RingHom.comp_apply] at e3 e4
      rw [← e3, ← e4, h2]
    choose κ yz hyz using hex
    let f : R → Γ(T, ⊤) := fun z => ψ (κ z) (yz z)
    have hf : ∀ k (y : A k) (z : R), γ' k y = z → f z = ψ k y := fun k y z h =>
      agree _ _ _ _ ((hyz z).trans h.symm)
    have hpair : ∀ x y : R, ∃ K a b, γ' K a = x ∧ γ' K b = y := by
      intro x y
      have hk : κ x ≤ max (κ x) (κ y) := le_max_left _ _
      have hk' : κ y ≤ max (κ x) (κ y) := le_max_right _ _
      have e1 := RingHom.congr_fun (hγτ _ _ hk) (yz x)
      have e2 := RingHom.congr_fun (hγτ _ _ hk') (yz y)
      rw [RingHom.comp_apply, hyz] at e1 e2
      exact ⟨_, _, _, e1, e2⟩
    let χ : R →+* Γ(T, ⊤) :=
      { toFun := f
        map_one' := by
          show f 1 = 1
          rw [hf 0 1 1 (map_one _)]
          exact map_one (ψ 0)
        map_mul' := by
          intro x y
          show f (x * y) = f x * f y
          obtain ⟨K, a, b, ha, hb⟩ := hpair x y
          rw [hf K (a * b) (x * y) (by rw [map_mul, ha, hb]), hf K a x ha, hf K b y hb, map_mul]
        map_zero' := by
          show f 0 = 0
          rw [hf 0 0 0 (map_zero _)]
          exact map_zero (ψ 0)
        map_add' := by
          intro x y
          show f (x + y) = f x + f y
          obtain ⟨K, a, b, ha, hb⟩ := hpair x y
          rw [hf K (a + b) (x + y) (by rw [map_add, ha, hb]), hf K a x ha, hf K b y hb, map_add] }
    have hχ : ∀ k, χ.comp (γ' k) = ψ k := by
      intro k
      ext y
      exact hf k y _ rfl
    have huniq : ∀ χ' : R →+* Γ(T, ⊤), (∀ k, χ'.comp (γ' k) = ψ k) → χ' = χ := by
      intro χ' h
      ext z
      have h1 := RingHom.congr_fun (h (κ z)) (yz z)
      have h2 := RingHom.congr_fun (hχ (κ z)) (yz z)
      rw [RingHom.comp_apply, hyz] at h1 h2
      rw [h1, h2]
    refine ⟨T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom χ), fun k => ?_, fun w₁ hw₁ => ?_⟩
    · rw [Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hχ k]
      exact s1 _ (w k)
    · have hall : ∀ k, ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
          Scheme.Hom.appTop w₁).hom.comp (γ' k) = ψ k := by
        intro k
        have h := s2 (CommRingCat.ofHom (γ' k)) w₁
        rw [hw₁ k] at h
        show _ = CommRingCat.Hom.hom ((Scheme.ΓSpecIso (CommRingCat.of (A k))).inv ≫
          Scheme.Hom.appTop (w k))
        rw [h]
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom]
      have hE : (Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫ Scheme.Hom.appTop w₁ =
          CommRingCat.ofHom χ := by
        ext1
        rw [CommRingCat.hom_ofHom]
        exact huniq _ hall
      calc w₁ = T.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso (CommRingCat.of R)).inv ≫
            Scheme.Hom.appTop w₁) := (s1 _ w₁).symm
        _ = T.toSpecΓ ≫ Spec.map (CommRingCat.ofHom χ) := by rw [hE]

  subst ha
  obtain ⟨γ, hinj, hcone, hex⟩ : ∃ γ : ∀ k : ℕ, AdjoinRoot (Polynomial.X ^ (ℓ ^ k) -
        Polynomial.C (e (LaurentPolynomial.T 1))) →+*
        TensorProduct (LaurentPolynomial L) M (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))),
      (∀ k, Function.Injective (γ k)) ∧
      (∀ (k k' : ℕ) (h : k ≤ k')
        (β : AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1))) →+*
          AdjoinRoot (Polynomial.X ^ (ℓ ^ k') - Polynomial.C (e (LaurentPolynomial.T 1)))),
        β.comp (AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1)))) =
          AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k') - Polynomial.C (e (LaurentPolynomial.T 1))) →
        β (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1)))) =
          AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k') - Polynomial.C (e (LaurentPolynomial.T 1))) ^
            (ℓ ^ (k' - k)) →
        (γ k').comp β = γ k) ∧
      (∀ z, ∃ k y, γ k y = z) := by
    have hℓ0 : (ℓ : ℤ) ≠ 0 := by exact_mod_cast (Fact.out : ℓ.Prime).ne_zero
    have hιinj : Function.Injective (algebraMap ℤ (Localization.Away (ℓ : ℤ))) :=
      IsLocalization.injective (Localization.Away (ℓ : ℤ))
        (powers_le_nonZeroDivisors_of_noZeroDivisors hℓ0)
    have hT : ∀ n : ℤ, (LaurentPolynomial.T n : LaurentPolynomial L) = AddMonoidAlgebra.single n 1 :=
      fun n => rfl
    have hι₀ : ∀ (m : ℤ) (c : L), (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) (AddMonoidAlgebra.single m c) =
        AddMonoidAlgebra.single (algebraMap ℤ (Localization.Away (ℓ : ℤ)) m) c := by
      intro m c
      rw [AddMonoidAlgebra.mapDomainRingHom_apply, AddMonoidAlgebra.mapDomain_single]
      rfl
    have hsmulG : ∀ (r : LaurentPolynomial L) (g : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))),
        r • g = (AddMonoidAlgebra.mapDomainRingHom L
        (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) r * g :=
      fun r g => Algebra.smul_def r g
    have hsmulM : ∀ (r : LaurentPolynomial L) (m : M), r • m = e r * m :=
      fun r m => Algebra.smul_def r m
    have htm : ∀ (r : LaurentPolynomial L) (m : M)
        (g : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))),
        m ⊗ₜ[LaurentPolynomial L] ((AddMonoidAlgebra.mapDomainRingHom L
          (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) r * g) =
        (e r * m) ⊗ₜ[LaurentPolynomial L] g := by
      intro r m g
      rw [← hsmulG, ← hsmulM]
      exact (TensorProduct.smul_tmul r m g).symm
    have hθ : ∀ k : ℕ, AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) -
        Polynomial.C (e (LaurentPolynomial.T 1))) ^ (ℓ ^ k) =
        AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1)))
          (e (LaurentPolynomial.T 1)) := by
      intro k
      have h := AdjoinRoot.mk_self (f := Polynomial.X ^ (ℓ ^ k) -
        Polynomial.C (e (LaurentPolynomial.T 1)))
      rw [map_sub, map_pow, AdjoinRoot.mk_X, AdjoinRoot.mk_C, sub_eq_zero] at h
      exact h
    have s2 : ∀ (k : ℕ) (w : Localization.Away (ℓ : ℤ)),
        (algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ)) ^ k * w = 1 →
        ∃ β : AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1))) →+*
            TensorProduct (LaurentPolynomial L) M (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))),
          β.comp (AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1)))) =
            Algebra.TensorProduct.includeLeftRingHom ∧
          β (AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1)))) =
            (1 : M) ⊗ₜ[LaurentPolynomial L] AddMonoidAlgebra.single w (1 : L) := by
      intro k w hw
      have h1 : (ℓ ^ k) • w = 1 := by
        rw [nsmul_eq_mul, Nat.cast_pow]
        simpa using hw
      have hev : Polynomial.eval₂ (Algebra.TensorProduct.includeLeftRingHom
          (R := LaurentPolynomial L) (A := M)
          (B := AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))
          ((1 : M) ⊗ₜ[LaurentPolynomial L] AddMonoidAlgebra.single w (1 : L))
          (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1))) =
          ((1 : M) ⊗ₜ[LaurentPolynomial L] AddMonoidAlgebra.single w (1 : L)) ^ (ℓ ^ k) -
            (e (LaurentPolynomial.T 1)) ⊗ₜ[LaurentPolynomial L]
              (1 : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) := by
        erw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_C]
        rfl
      have hev2 : ((1 : M) ⊗ₜ[LaurentPolynomial L] AddMonoidAlgebra.single w (1 : L)) ^ (ℓ ^ k) -
            (e (LaurentPolynomial.T 1)) ⊗ₜ[LaurentPolynomial L]
              (1 : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) = 0 := by
        rw [Algebra.TensorProduct.tmul_pow, one_pow,
          AddMonoidAlgebra.single_pow, h1, one_pow, sub_eq_zero]
        have h2 : (AddMonoidAlgebra.single (1 : Localization.Away (ℓ : ℤ)) (1 : L)) =
            (AddMonoidAlgebra.mapDomainRingHom L
              (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) (LaurentPolynomial.T 1) *
              (1 : AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) := by
          rw [mul_one, hT, hι₀, map_one]
        rw [h2, htm, mul_one]
      refine ⟨AdjoinRoot.lift Algebra.TensorProduct.includeLeftRingHom
        ((1 : M) ⊗ₜ[LaurentPolynomial L] AddMonoidAlgebra.single w (1 : L)) (hev.trans hev2), ?_,
        AdjoinRoot.lift_root _⟩
      ext x
      simp
    have s3 : ∀ (k : ℕ) (w : Localization.Away (ℓ : ℤ)),
        (algebraMap ℤ (Localization.Away (ℓ : ℤ)) (ℓ : ℤ)) ^ k * w = 1 →
        ∃ γ : TensorProduct (LaurentPolynomial L) M
            (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))) →+
            AdjoinRoot (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1))),
          ∀ (m : M) (n : ℕ),
            γ (m ⊗ₜ[LaurentPolynomial L] AddMonoidAlgebra.single (n • w) (1 : L)) =
            AdjoinRoot.of (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1))) m *
              AdjoinRoot.root (Polynomial.X ^ (ℓ ^ k) -
                Polynomial.C (e (LaurentPolynomial.T 1))) ^ n := by
      intro k w hw
      have hθk := hθ k
      generalize (Polynomial.X ^ (ℓ ^ k) - Polynomial.C (e (LaurentPolynomial.T 1))) = P at hθk ⊢
      obtain ⟨Nz, hNz⟩ : ∃ Nz : ℤ, Nz = (ℓ : ℤ) ^ k := ⟨_, rfl⟩
      have hNz0 : Nz ≠ 0 := by rw [hNz]; exact pow_ne_zero _ hℓ0
      have hNzw : algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * w = 1 := by
        rw [hNz, map_pow]; exact hw
      let Γq : Localization.Away (ℓ : ℤ) → L →+ AdjoinRoot P := fun q =>
        if h : ∃ a : ℤ, algebraMap ℤ (Localization.Away (ℓ : ℤ)) a =
            algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * q then
          { toFun := fun c => AdjoinRoot.of P (e (LaurentPolynomial.C c *
                LaurentPolynomial.T (h.choose / Nz))) * AdjoinRoot.root P ^ (h.choose % Nz).toNat
            map_zero' := by simp
            map_add' := by intro a b; simp only [map_add, add_mul] }
        else 0
      have hΓq1 : ∀ (q : Localization.Away (ℓ : ℤ)) (a : ℤ) (c : L),
          algebraMap ℤ (Localization.Away (ℓ : ℤ)) a =
            algebraMap ℤ (Localization.Away (ℓ : ℤ)) Nz * q →
          Γq q c = AdjoinRoot.of P (e (LaurentPolynomial.C c * LaurentPolynomial.T (a / Nz))) *
            AdjoinRoot.root P ^ (a % Nz).toNat := by
