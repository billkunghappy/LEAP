      cases k with
      | zero =>
        show ((W 0 : Aˣ) : A) ^ ℓ = 1
        simpa [W] using ha
      | succ j =>
        show ((W (j + 1) : Aˣ) : A) ^ ℓ = ((W j : Aˣ) : A)
        rw [← Units.val_pow_eq_pow_val, hW]
