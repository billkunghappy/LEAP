import WeilR2_Part17
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wc_qmssl_cone_iso : ∀ (A : Type u) [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)], IsUnit ((ℓ : ℕ) : A) →
    ∀ (π : A), IsLocalRing.maximalIdeal A = Ideal.span {π} →
    ∀ (r : ℕ) (B : Type u) [CommRing B] [HenselianLocalRing B]
      [IsSepClosed (IsLocalRing.ResidueField B)]
      (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)))),
    WeaklyEtale a₀ →
    Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) →
    Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈
      PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)) →
    ∀ (L : Type u) [Field L] [IsSepClosed L] (φA : A →+* L), Function.Injective φA →
    (letI := φA.toAlgebra; Algebra.IsAlgebraic A L) →
    ∀ (XE : Scheme.{u}) (p : XE ⟶ Spec (.of B)) (q : XE ⟶ Spec (.of L)),
    IsPullback p q (a₀ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (Spec.map (CommRingCat.ofHom φA)) →
    ∀ (Xs : Scheme.{u}) (ι : Xs ⟶ Spec (.of B))
      (s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A))),
    IsPullback ι s (a₀ ≫ wcQuadModelStr A (r + 2) π
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0))
      (wcQmSp A) →
    ∀ (Y : Scheme.{u}) (iY : Y ⟶ Xs)
      (kY : Y ⟶ Spec (.of (B ⧸ Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))),
        (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))}))),
    IsPullback iY kY ι (Spec.map (CommRingCat.ofHom
      (Ideal.Quotient.mk (Ideal.span {(Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))),
        (Spec.preimage a₀).hom (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A) else 0)) (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))))})))) →
    ∀ (EY : wcHMPullData iY ℓ), wcHMPullCanonical EY →
    ∀ (Dp : wcHMPullData p ℓ), wcHMPullCanonical Dp →
    ∀ (Di : wcHMPullData ι ℓ), wcHMPullCanonical Di →
    ∀ (I : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE ℓ))),
    haveI := Di.additive
    haveI := Dp.additive
    let P := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _
      (wcProEtBC p) _ _ Dp.cont Dp.φ
    haveI : P.Additive := Adjunction.right_adjoint_additive Dp.adj
    let eK := (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf (Spec (.of B)) ℓ))
          (ComplexShape.up ℤ) 0).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC p) _ _ Dp.cont Dp.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf XE ℓ)) ≫
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι'
    let eΨ := (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
          (ComplexShape.up ℤ) 0).map Di.μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex Di.Φ (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf (Spec (.of B)) ℓ)) ≫
        (Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map eK
    letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
    Nonempty ((DerivedCategory.Q.obj (CochainComplex.mappingCone eΨ))⟦(1 : ℤ)⟧ ≅
      (DerivedCategory.singleFunctor (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ)) 0).obj
        (wcSuppObj EY)) :=
by

  have cone_single : ∀ {𝒞 : Type (u+2)} [Category.{u+1} 𝒞] [Abelian 𝒞] [HasDerivedCategory 𝒞]
      (O S : 𝒞) (Ψ : CochainComplex 𝒞 ℤ)
      (e : (HomologicalComplex.single 𝒞 (ComplexShape.up ℤ) 0).obj O ⟶ Ψ)
      (_h0 : IsIso (HomologicalComplex.homologyMap e 0))
      (_hq : ∀ q : ℤ, q ≠ 0 → q ≠ 1 → Limits.IsZero (Ψ.homology q))
      (_hS : Nonempty (Ψ.homology 1 ≅ S)),
      Nonempty ((DerivedCategory.Q.obj (CochainComplex.mappingCone e))⟦(1 : ℤ)⟧ ≅
        (DerivedCategory.singleFunctor 𝒞 0).obj S) := by
    intro 𝒞 _ _ _ O S Ψ e h0 hq hS
    obtain ⟨σS⟩ := hS
    let T := DerivedCategory.Q.mapTriangle.obj (CochainComplex.mappingCone.triangle e)
    have hT : T ∈ Pretriangulated.distinguishedTriangles :=
      DerivedCategory.mappingCone_triangle_distinguished e
    have hA : ∀ q : ℤ, q ≠ 0 →
        Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 q).obj T.obj₁) := by
      intro q hq0
      exact Limits.IsZero.of_iso
        (HomologicalComplex.isZero_single_obj_homology _ _ _ _ hq0)
        ((DerivedCategory.homologyFunctorFactors 𝒞 q).app _)
    have hΨ : ∀ q : ℤ, q ≠ 0 → q ≠ 1 →
        Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 q).obj T.obj₂) := by
      intro q hq0 hqN
      exact Limits.IsZero.of_iso (hq q hq0 hqN)
        ((DerivedCategory.homologyFunctorFactors 𝒞 q).app _)
    have hm0 : IsIso ((DerivedCategory.homologyFunctor 𝒞 0).map T.mor₁) := by
      have hnat := (DerivedCategory.homologyFunctorFactors 𝒞 0).hom.naturality e
      have h0' : IsIso ((HomologicalComplex.homologyFunctor 𝒞 (ComplexShape.up ℤ) 0).map e) := h0
      have h2 : IsIso ((DerivedCategory.Q ⋙ DerivedCategory.homologyFunctor 𝒞 0).map e ≫
          (DerivedCategory.homologyFunctorFactors 𝒞 0).hom.app Ψ) := by
        rw [hnat]; infer_instance
      have h3 : IsIso ((DerivedCategory.Q ⋙ DerivedCategory.homologyFunctor 𝒞 0).map e) :=
        IsIso.of_isIso_comp_right _ ((DerivedCategory.homologyFunctorFactors 𝒞 0).hom.app Ψ)
      exact h3
    have hX : ∀ q : ℤ, q ≠ 1 →
        Limits.IsZero ((DerivedCategory.homologyFunctor 𝒞 q).obj T.obj₃) := by
      intro q hqN
      have E3 := DerivedCategory.HomologySequence.exact₃ T hT q (q + 1) rfl
      by_cases hq0 : q = 0
      · subst hq0
        have E2 := DerivedCategory.HomologySequence.exact₂ T hT 0
        apply E3.isZero_of_both_zeros
        · exact E2.epi_f_iff.mp
            (inferInstance : Epi ((DerivedCategory.homologyFunctor 𝒞 0).map T.mor₁))
        · exact (hA 1 (by norm_num)).eq_of_tgt _ _
      by_cases hqm : q = -1
      · subst hqm
        have E1 := DerivedCategory.HomologySequence.exact₁ T hT (-1) 0 (by norm_num)
        apply E3.isZero_of_both_zeros
        · exact (hΨ (-1) (by norm_num) (by norm_num)).eq_of_src _ _
        · exact E1.mono_g_iff.mp
            (inferInstance : Mono ((DerivedCategory.homologyFunctor 𝒞 0).map T.mor₁))
      · apply E3.isZero_of_both_zeros
        · exact (hΨ q hq0 hqN).eq_of_src _ _
        · exact (hA (q + 1) (by omega)).eq_of_tgt _ _
    have hXN : IsIso ((DerivedCategory.homologyFunctor 𝒞 1).map T.mor₂) := by
      have E3 := DerivedCategory.HomologySequence.exact₃ T hT 1 (1 + 1) rfl
      have E2 := DerivedCategory.HomologySequence.exact₂ T hT 1
      have : Epi ((DerivedCategory.homologyFunctor 𝒞 1).map T.mor₂) :=
        E3.epi_f ((hA (1 + 1) (by norm_num)).eq_of_tgt _ _)
      have : Mono ((DerivedCategory.homologyFunctor 𝒞 1).map T.mor₂) :=
        E2.mono_g ((hA 1 (by norm_num)).eq_of_src _ _)
      exact isIso_of_mono_of_epi _
    have hGE : T.obj₃.IsGE 1 := by
      rw [DerivedCategory.isGE_iff]
      intro q hq
      exact hX q (by omega)
    have hLE : T.obj₃.IsLE 1 := by
      rw [DerivedCategory.isLE_iff]
      intro q hq
      exact hX q (by omega)
    obtain ⟨Yo, ⟨σ⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE T.obj₃ 1
    have eY : Yo ≅ S :=
      ((DerivedCategory.singleFunctorCompHomologyFunctorIso 𝒞 1).app Yo).symm ≪≫
        (DerivedCategory.homologyFunctor 𝒞 1).mapIso σ.symm ≪≫
        (asIso ((DerivedCategory.homologyFunctor 𝒞 1).map T.mor₂)).symm ≪≫
        (DerivedCategory.homologyFunctorFactors 𝒞 1).app Ψ ≪≫ σS
    exact ⟨(shiftFunctor _ (1 : ℤ)).mapIso σ ≪≫
      ((DerivedCategory.singleFunctors 𝒞).shiftIso 1 0 1 (by simp)).app Yo ≪≫
      (DerivedCategory.singleFunctor 𝒞 0).mapIso eY⟩

  have homology_transfer : ∀ {𝒜 𝒜' ℬ : Type (u+2)} [Category.{u+1} 𝒜] [Category.{u+1} 𝒜']
      [Category.{u+1} ℬ] [Abelian 𝒜] [Abelian 𝒜'] [Abelian ℬ]
      (P : 𝒜' ⥤ 𝒜) [P.Additive] [Limits.PreservesFiniteLimits P]
      (G : 𝒜 ⥤ ℬ) [G.Additive] [Limits.PreservesFiniteLimits G]
      [Limits.PreservesFiniteColimits G]
      {O : 𝒜} {O' : 𝒜'} {Os : ℬ} (u : O ⟶ P.obj O') (μ : G.obj O ≅ Os)
      (I : InjectiveResolution O'),
      let eK := (HomologicalComplex.single 𝒜 (ComplexShape.up ℤ) 0).map u ≫
        (HomologicalComplex.singleMapHomologicalComplex P (ComplexShape.up ℤ) 0).inv.app O' ≫
        (P.mapHomologicalComplex (ComplexShape.up ℤ)).map I.ι'
      let eΨ := (HomologicalComplex.single ℬ (ComplexShape.up ℤ) 0).map μ.inv ≫
        (HomologicalComplex.singleMapHomologicalComplex G (ComplexShape.up ℤ) 0).inv.app O ≫
        (G.mapHomologicalComplex (ComplexShape.up ℤ)).map eK
      let Ψ := (G.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        ((P.mapHomologicalComplex (ComplexShape.up ℤ)).obj I.cochainComplex)
      (∀ q : ℕ, Nonempty (Ψ.homology (q : ℤ) ≅
          G.obj (((P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q))) ∧
      (∀ q : ℤ, q < 0 → Limits.IsZero (Ψ.homology q)) ∧
      (IsIso (G.map u) → IsIso (HomologicalComplex.homologyMap eΨ 0)) := by
    intro 𝒜 𝒜' ℬ _ _ _ _ _ _ P _ _ G _ _ _ O O' Os u μ I eK eΨ Ψ
    have hneg : ∀ q : ℤ, q < 0 → Limits.IsZero (Ψ.X q) := by
      intro q hq
      exact G.map_isZero
        (P.map_isZero (CochainComplex.isZero_of_isStrictlyGE I.cochainComplex 0 q hq))
    refine ⟨?_, ?_, ?_⟩
    · intro q
      let Kn := (P.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex
      let L := (G.mapHomologicalComplex (ComplexShape.up ℕ)).obj Kn
      let φ : ∀ a : Option ℕ, G.obj (P.obj (HomologicalComplex.extend.X I.cocomplex a)) ≅
          HomologicalComplex.extend.X L a := fun a =>
        match a with
        | some k => Iso.refl _
        | none => Limits.IsZero.iso (G.map_isZero (P.map_isZero (Limits.isZero_zero _)))
            (Limits.isZero_zero _)
      have hφ : ∀ a b : Option ℕ,
          (φ a).hom ≫ HomologicalComplex.extend.d L a b =
            G.map (P.map (HomologicalComplex.extend.d I.cocomplex a b)) ≫ (φ b).hom := by
        intro a b
        cases a with
        | none => exact (G.map_isZero (P.map_isZero (Limits.isZero_zero _))).eq_of_src _ _
        | some i =>
          cases b with
          | none => exact (Limits.isZero_zero _).eq_of_tgt _ _
          | some j => exact (Category.id_comp _).trans (Category.comp_id _).symm
      let isoΨ : Ψ ≅ L.extend ComplexShape.embeddingUpNat :=
        HomologicalComplex.Hom.isoOfComponents
          (fun i => φ (ComplexShape.embeddingUpNat.r i))
          (fun i j _ => hφ _ _)
      exact ⟨HomologicalComplex.homologyMapIso isoΨ (q : ℤ) ≪≫
        L.extendHomologyIso ComplexShape.embeddingUpNat (j := q) rfl ≪≫
        (Kn.sc q).mapHomologyIso G⟩
    · intro q hq
      exact (Ψ.sc q).isZero_homology_of_isZero_X₂ (hneg q hq)
    · intro hu
      let S := (HomologicalComplex.single ℬ (ComplexShape.up ℤ) 0).obj Os
      have hnext : (ComplexShape.up ℤ).next 0 = 1 := by simp
      have hprev : (ComplexShape.up ℤ).prev 0 = -1 := by simp
      let F := P ⋙ G
      have hk := I.exact₀.fIsKernel
      have hkF := Limits.KernelFork.mapIsLimit _ hk F
      let cXI0 := I.cochainComplexXIso 0 0 rfl
      let cXI1 := I.cochainComplexXIso 1 1 rfl
      have hd : Ψ.d 0 1 = F.map (cXI0.hom ≫ I.cocomplex.d 0 1 ≫ cXI1.inv) := by
        show G.map (P.map (I.cochainComplex.d 0 1)) = _
        rw [I.cochainComplex_d 0 1 0 1 rfl rfl]
        rfl
      have hlim := Limits.KernelFork.isLimitOfIsLimitOfIff hkF (Ψ.d 0 1) (F.mapIso cXI0.symm)
        (by
          intro W f
          rw [hd, F.map_comp, F.map_comp]
          simp only [Functor.mapIso_hom, Iso.symm_hom]
          rw [← F.map_comp_assoc, cXI0.inv_hom_id, F.map_id, Category.id_comp]
          constructor
          · intro h; simp [reassoc_of% h]
          · intro h
            rw [← cancel_mono (F.map cXI1.inv), Category.assoc, h, Limits.zero_comp])
      let κ : G.obj (P.obj O') ⟶ Ψ.X 0 := G.map (P.map (I.ι.f 0 ≫ cXI0.inv))
      have hf : eΨ.f 0 = (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 Os).hom ≫
          μ.inv ≫ G.map u ≫ κ := by
        simp [eΨ, eK, κ, HomologicalComplex.single_map_f_self,
          HomologicalComplex.singleMapHomologicalComplex_inv_app_self,
          InjectiveResolution.ι'_f_zero]
        rfl
      let c := (Ψ.cyclesIsKernel 0 1 hnext).conePointUniqueUpToIso hlim
      let ci : G.obj (P.obj O') ⟶ Ψ.cycles 0 := c.inv
      haveI : IsIso ci := (inferInstance : IsIso c.inv)
      have hc : ci ≫ Ψ.iCycles 0 = κ := by
        have h1 := Limits.IsLimit.conePointUniqueUpToIso_inv_comp
          (Ψ.cyclesIsKernel 0 1 hnext) hlim Limits.WalkingParallelPair.zero
        refine h1.trans ?_
        change F.map (I.ι.f 0) ≫ F.map cXI0.inv = _
        exact ((congrArg G.map (P.map_comp _ _)).trans (G.map_comp _ _)).symm
      have hcyc : HomologicalComplex.cyclesMap eΨ 0 = S.iCycles 0 ≫
          ((HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 Os).hom ≫ μ.inv ≫
            G.map u ≫ ci) := by
        rw [← cancel_mono (Ψ.iCycles 0), HomologicalComplex.cyclesMap_i, hf]
        simp only [Category.assoc, hc]
        rfl
      have hS1 : S.d 0 1 = 0 :=
        (HomologicalComplex.isZero_single_obj_X _ _ _ 1 (by decide)).eq_of_tgt _ _
      have hSm : S.d (-1) 0 = 0 :=
        (HomologicalComplex.isZero_single_obj_X _ _ _ (-1) (by decide)).eq_of_src _ _
      haveI : IsIso (S.iCycles 0) := HomologicalComplex.isIso_iCycles S 0 1 hnext hS1
      haveI : IsIso (S.homologyπ 0) := HomologicalComplex.isIso_homologyπ S (-1) 0 hprev hSm
      haveI : IsIso (Ψ.homologyπ 0) := HomologicalComplex.isIso_homologyπ Ψ (-1) 0 hprev
        ((hneg (-1) (by norm_num)).eq_of_src _ _)
      haveI : IsIso (G.map u) := hu
      haveI : IsIso (HomologicalComplex.cyclesMap eΨ 0) := by
        rw [hcyc]
        infer_instance
      have h2 : IsIso (S.homologyπ 0 ≫ HomologicalComplex.homologyMap eΨ 0) := by
        rw [HomologicalComplex.homologyπ_naturality]; infer_instance
      exact IsIso.of_isIso_comp_left (S.homologyπ 0) _

  intro A _ _ _ _ _ ℓ _ hℓ π hπ r B _ _ _ a₀ ha₀ hx0 hx1 L _ _ φA hφA halg XE p q hpb
    Xs ι s hps Y iY kY hY EY hEY Dp hDp Di hDi I
  intro P eK eΨ
  haveI := Dp.additive
  haveI := Di.additive
  haveI : P.Additive := Adjunction.right_adjoint_additive Dp.adj
  haveI := Di.presLim
  haveI := Di.presColim
  haveI : Limits.PreservesFiniteLimits P := by
    haveI := Dp.adj.rightAdjoint_preservesLimits
    infer_instance
  letI := HasDerivedCategory.standard (SheafOfModules.{u+1} (wcRingSheaf Xs ℓ))
  obtain ⟨ha, hb, hc⟩ := homology_transfer P Di.Φ
    (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC p) _ _ Dp.cont Dp.φ) Di.μ I
  have h0 := hc (wc_qmssl_ci_unit_restr_iso A ℓ hℓ π hπ r B a₀ ha₀ hx0 hx1 L φA hφA halg
    XE p q hpb Xs ι s hps Dp hDp Di hDi)
  refine cone_single _ (wcSuppObj EY) _ eΨ h0 ?_ ?_
  · intro k hk0 hk1
    rcases lt_or_ge k 0 with hlt | hge
    · exact hb k hlt
    · obtain ⟨m, rfl⟩ := Int.eq_ofNat_of_zero_le hge
      obtain ⟨iso⟩ := ha m
      refine Limits.IsZero.of_iso ?_ iso
      exact wc_qmssl_ci_restr_higher_vanish A ℓ hℓ π hπ r B a₀ ha₀ hx0 hx1 L φA hφA halg
        XE p q hpb Xs ι s hps Dp hDp Di hDi I m (by omega)
  · obtain ⟨iso⟩ := ha 1
    obtain ⟨iso2⟩ := wc_qmssl_ci_restr_R1_supp A ℓ hℓ π hπ r B a₀ ha₀ hx0 hx1 L φA hφA halg
      XE p q hpb Xs ι s hps Y iY kY hY EY hEY Dp hDp Di hDi I
    exact ⟨iso ≪≫ iso2⟩

theorem wc_qmbt_ss_cone_ge_one {A' : Type u} [CommRing A'] [IsDomain A']
    [IsDiscreteValuationRing A'] [HenselianLocalRing A'] [IsSepClosed (IsLocalRing.ResidueField A')]
    {ℓ : ℕ} [Fact (Nat.Prime ℓ)] (hℓ' : IsUnit ((ℓ : ℕ) : A')) {π' : A'}
    (hπ' : IsLocalRing.maximalIdeal A' = Ideal.span {π'})
    {Xm : Scheme.{u}} {f : Xm ⟶ Spec (.of A')}
    (hcov : ∀ x : Xm, ∃ (U : Xm.Opens) (r : ℕ)
      (g : U.toScheme ⟶ Spec (.of (wcQuadModelRing A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0)))),
      x ∈ U ∧ WeaklyEtale g ∧
      g ≫ wcQuadModelStr A' (r + 2) π'
        (Matrix.of fun i j : Fin (r + 2) => if i.val = 0 ∧ j.val = 1 then (1 : A') else 0) =
        U.ι ≫ f)
    {L' : Type u} [Field L'] [IsSepClosed L'] {φ' : A' →+* L'} (hφ' : Function.Injective φ')
    (halg' : letI := φ'.toAlgebra; Algebra.IsAlgebraic A' L')
    {XE' : Scheme.{u}} {p' : XE' ⟶ Xm} {q' : XE' ⟶ Spec (.of L')}
    (hpb' : IsPullback p' q' f (Spec.map (CommRingCat.ofHom φ')))
    {Xs' : Scheme.{u}} {ι' : Xs' ⟶ Xm} {s' : Xs' ⟶ Spec (.of (IsLocalRing.ResidueField A'))}
    (hps' : IsPullback ι' s' f (wcQmSp A'))
    (Dp' : wcHMPullData p' ℓ) (hDp' : wcHMPullCanonical Dp')
    (Di' : wcHMPullData ι' ℓ) (hDi' : wcHMPullCanonical Di')
    (I' : InjectiveResolution (SheafOfModules.unit (wcRingSheaf XE' ℓ))) :
    haveI := Dp'.additive
    haveI := Di'.additive
    let P' := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC p') _ _ Dp'.cont Dp'.φ
    haveI : P'.Additive := Adjunction.right_adjoint_additive Dp'.adj
    let eK' := (HomologicalComplex.single (SheafOfModules.{u+1} (wcRingSheaf Xm ℓ))
          (ComplexShape.up ℤ) 0).map
          (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcProEtBC p') _ _ Dp'.cont Dp'.φ) ≫
        (HomologicalComplex.singleMapHomologicalComplex P' (ComplexShape.up ℤ) 0).inv.app
          (SheafOfModules.unit (wcRingSheaf XE' ℓ)) ≫
