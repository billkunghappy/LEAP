    haveI := hYaff
    have h4 : ∀ k : ℕ, Subsingleton (wcEtCoh ((wcProEtBC T.πi).obj W').left (ℓ ^ (k + 1)) (n + 1)) :=
      fun k => wc_et_coh_zmod_prime_pow_of_prime _ ℓ Fact.out (n + 1) hYet k
    have h3 := fun k : ℕ =>
      wc_proet_zmod_ext_vanish_of_et ((wcProEtBC T.πi).obj W').left (ℓ ^ (k + 1)) n (h4 k)
    have h2 := wc_proet_int_ext_vanish_of_zmod_deg ((wcProEtBC T.πi).obj W').left ℓ
      (Scheme.ProEt.mk (𝟙 _)) n h3
    exact wc_hm_vanish_of_int_ext_vanish ((wcProEtBC T.πi).obj W').left ℓ n h2

  refine (fun key => ?_) (pushforward_homology_local_basis (wcProEtBC T.πi)
    (wcRingSheaf XE ℓ) (wcRingSheaf T.XEi ℓ)
    Dπ.φ I.cocomplex (n + 1) 0 (fun a => a.elim0) (fun a => a.elim0) ?_ ?_)
  · obtain ⟨ι, hinj, hloc⟩ := key
    obtain ⟨ρ, -, hsum⟩ := sheafOfModules_split_of_local_basis _ _ 0 ι hinj hloc
    rw [Fin.sum_univ_zero] at hsum
