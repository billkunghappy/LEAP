    ∀ (ζ : Ω), IsPrimitiveRoot ζ ℓ →
    ∀ (v : (Γ(Y, ⊤))ˣ) (w : Γ(Z, ⊤)), w ^ ℓ = σ.appTop.hom (v : Γ(Y, ⊤)) →
    ∃ κ : wcEtZModExt Y ℓ 1, (κ = 0 → ∃ u : Γ(Y, ⊤), u ^ ℓ = (v : Γ(Y, ⊤))) ∧
      ∀ D : wcEtPullData σ ℓ, wcEtPull D 1 κ = 0 :=
by
  intro Ω _ Y Z fY σ ℓ _ hℓ ζ hζ v w hw
  obtain ⟨κY, hκY, hY, hSY⟩ := wc_qsfx_kummer_ses_field Ω Y fY ℓ hℓ ζ hζ
  obtain ⟨κZ, hκZ, hZ, hSZ⟩ := wc_qsfx_kummer_ses_field Ω Z (σ ≫ fY) ℓ hℓ ζ hζ
