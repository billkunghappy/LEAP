  have descent : ∀ (A Q R L : Type u) [CommRing A] [CommRing Q] [CommRing R]
      [Field L] [IsSepClosed L] [Algebra A Q] (ρ : Q →+* R) (φA : A →+* L) (n q : ℕ),
      letI : Algebra A R := (ρ.comp (algebraMap A Q)).toAlgebra
      letI : Algebra A L := φA.toAlgebra
      Nonempty (wcEtCoh (Spec (.of (TensorProduct A L R))) n q ≃
        wcEtCoh (Limits.pullback (Spec.map (CommRingCat.ofHom ρ) ≫
            Spec.map (CommRingCat.ofHom (algebraMap A Q)))
          (Spec.map (CommRingCat.ofHom ((algebraMap L (AlgebraicClosure L)).comp φA)))) n q) := by
    intro A Q R L _ _ _ _ _ _ ρ φA n q
    letI iAR : Algebra A R := (ρ.comp (algebraMap A Q)).toAlgebra
    letI iAL : Algebra A L := φA.toAlgebra
    have hg : Spec.map (CommRingCat.ofHom ((algebraMap L (AlgebraicClosure L)).comp φA)) =
        Spec.map (CommRingCat.ofHom (algebraMap L (AlgebraicClosure L))) ≫
          Spec.map (CommRingCat.ofHom φA) := by
      rw [CommRingCat.ofHom_comp, Spec.map_comp]
    obtain ⟨E0⟩ := wc_et_coh_iso_invariance (Limits.pullback.congrHom
      (rfl : Spec.map (CommRingCat.ofHom ρ) ≫ Spec.map (CommRingCat.ofHom (algebraMap A Q)) =
        Spec.map (CommRingCat.ofHom ρ) ≫ Spec.map (CommRingCat.ofHom (algebraMap A Q))) hg).hom n q
