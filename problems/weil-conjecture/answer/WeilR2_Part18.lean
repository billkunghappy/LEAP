    intro F G H _ _ _ _ _ _ RS R φf φw φ2 α₀ α₂₀ α'₀ hSI₀ hφ₀ hφ₂₀ hcc₀ M
    have hγ : ∀ (N : SheafOfModules.{u+1} R) (U : (S.ProEt)ᵒᵖ)
