theorem wc_qmtm_tower_milnor_acyclic {A B L : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    [CommRing B] [Field L] [IsSepClosed L]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit ((ℓ : ℕ) : A)) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (r : ℕ)
    (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r))))
    (ha₀ : WeaklyEtale a₀)
    (φA : A →+* L) (hφA : Function.Injective φA) (halg : letI := φA.toAlgebra; Algebra.IsAlgebraic A L)
    (σ : L →+* L) (hσ : σ.comp φA = φA)
    (XE : Scheme.{u}) (p : XE ⟶ Spec (.of B)) (q : XE ⟶ Spec (.of L))
    (hpb : IsPullback p q (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) (Spec.map (CommRingCat.ofHom φA)))
    (w : XE ⟶ XE) (T : wcQmtmTower ℓ φA σ p q w (wcQmtmX a₀ ⟨0, by omega⟩))
    (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)]
    (c : Spec (.of C) ⟶ Spec (.of B)) (hc : WeaklyEtale c)
    (hcl : wcQuadModelStr A (r + 2) π (wcQmtmC A r) (a₀ (c (IsLocalRing.closedPoint C))) =
      IsLocalRing.closedPoint A) (j : ℕ) :
    Subsingleton (wcEtCoh (Limits.pullback c (T.πi ≫ p)) ℓ (j + 1)) :=
by
  classical


  have s1 : ∀ {A L R : Type u} [CommRing A] [CommRing L] [CommRing R]
      [Algebra A L] [Algebra A R] {Y XE : Scheme.{u}} (p : XE ⟶ Y) (q : XE ⟶ Spec (.of L))
      (s : Y ⟶ Spec (.of A))
      (hpb : IsPullback p q s (Spec.map (CommRingCat.ofHom (algebraMap A L))))
      (c : Spec (.of R) ⟶ Y) (hc : c ≫ s = Spec.map (CommRingCat.ofHom (algebraMap A R))),
      ∃ E : Limits.pullback c p ≅ Spec (.of (TensorProduct A L R)),
        E.hom ≫ Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight : R →ₐ[A] TensorProduct A L R).toRingHom) =
        Limits.pullback.fst c p := by
    intro A L R _ _ _ _ _ Y XE p q s hpb c hc
    have H3 := IsPullback.paste_horiz (IsPullback.of_hasPullback c p).flip hpb.flip
    rw [hc] at H3
    refine ⟨H3.isoPullback ≪≫ pullbackSpecIso A L R, ?_⟩
    rw [Iso.trans_hom, Category.assoc]
    erw [pullbackSpecIso_hom_snd]
    exact H3.isoPullback_hom_snd
  have s2 : ∀ {G₀ G M : Type u} [CommRing G₀] [CommRing G] [CommRing M]
      (ι : G₀ →+* G) {P XE XEi : Scheme.{u}} (s : P ⟶ XE) (πi : XEi ⟶ XE)
      (gi : XEi ⟶ Spec (.of G)) (g₀ : XE ⟶ Spec (.of G₀))
      (hT : IsPullback πi gi g₀ (Spec.map (CommRingCat.ofHom ι)))
      (E : P ≅ Spec (.of M)) (e : G₀ →+* M)
      (he : E.hom ≫ Spec.map (CommRingCat.ofHom e) = s ≫ g₀),
      letI := e.toAlgebra
      letI := ι.toAlgebra
      Nonempty (Limits.pullback s πi ≅ Spec (.of (TensorProduct G₀ M G))) := by
    intro G₀ G M _ _ _ ι P XE XEi s πi gi g₀ hT E e he
    letI := e.toAlgebra
    letI := ι.toAlgebra
    have HB := IsPullback.paste_vert (IsPullback.of_hasPullback s πi) hT
    have HC : IsPullback (Limits.pullback.fst s πi ≫ E.hom) (Limits.pullback.snd s πi ≫ gi)
        (Spec.map (CommRingCat.ofHom (algebraMap G₀ M)))
        (Spec.map (CommRingCat.ofHom (algebraMap G₀ G))) :=
      IsPullback.of_iso HB (Iso.refl _) E (Iso.refl _) (Iso.refl _) (by simp) (by simp)
        (by simp only [Iso.refl_hom, Category.comp_id]; exact he.symm) (by simp)
    exact ⟨HC.isoPullback ≪≫ pullbackSpecIso G₀ M G⟩
  have s3 : ∀ {B R M G₀ : CommRingCat.{u}} {XE : Scheme.{u}}
      (c : Spec R ⟶ Spec B) (p : XE ⟶ Spec B) (g₀ : XE ⟶ Spec G₀)
      (E : Limits.pullback c p ≅ Spec M) (j : R ⟶ M)
      (hE : E.hom ≫ Spec.map j = Limits.pullback.fst c p) (t : G₀) (x : B)
      (hg : g₀.appTop.hom ((Scheme.ΓSpecIso G₀).inv.hom t) =
        p.appTop.hom ((Scheme.ΓSpecIso B).inv.hom x)),
      (Spec.preimage (E.inv ≫ Limits.pullback.snd c p ≫ g₀)).hom t =
        j.hom ((Spec.preimage c).hom x) := by
    intro B R M G₀ XE c p g₀ E j hE t x hg
    have hα : ∀ {S R' : CommRingCat.{u}} (h : Spec S ⟶ Spec R') (r : R'),
        (Spec.preimage h).hom r =
          (Scheme.ΓSpecIso S).hom.hom (h.appTop.hom ((Scheme.ΓSpecIso R').inv.hom r)) := by
      intro S R' h r
      obtain ⟨f, rfl⟩ : ∃ f, Spec.map f = h := ⟨_, Spec.map_preimage h⟩
      rw [Spec.preimage_map]
      have := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso R').inv.hom r))
        (Scheme.ΓSpecIso_naturality f)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
      rw [this]
      simp
    have hj' : Spec.map j = E.inv ≫ Limits.pullback.fst c p := (Iso.eq_inv_comp E).mpr hE
    have hcomp : E.inv ≫ Limits.pullback.snd c p ≫ p = Spec.map (Spec.preimage c ≫ j) := by
      rw [← Limits.pullback.condition, Spec.map_comp, Spec.map_preimage, hj', Category.assoc]
    have h2 : (E.inv ≫ Limits.pullback.snd c p ≫ g₀).appTop.hom ((Scheme.ΓSpecIso G₀).inv.hom t)
        = (E.inv ≫ Limits.pullback.snd c p ≫ p).appTop.hom ((Scheme.ΓSpecIso B).inv.hom x) := by
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply, hg]
    rw [hα, h2, hcomp, ← hα, Spec.preimage_map, CommRingCat.hom_comp, RingHom.comp_apply]
  letI iAC : Algebra A C := ((Spec.preimage (c ≫ a₀)).hom.comp
      (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))).toAlgebra
  letI iAL : Algebra A L := φA.toAlgebra
  have hcs : c ≫ (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) =
      Spec.map (CommRingCat.ofHom (algebraMap A C)) := by
    rw [show algebraMap A C = (Spec.preimage (c ≫ a₀)).hom.comp
        (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r))) from rfl,
      CommRingCat.ofHom_comp, CommRingCat.ofHom_hom, Spec.map_comp, Spec.map_preimage,
      Category.assoc]
  have hpb' : IsPullback p q (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r))
      (Spec.map (CommRingCat.ofHom (algebraMap A L))) := hpb
  obtain ⟨E, hE⟩ := s1 p q _ hpb' c hcs
  have he : E.hom ≫ Spec.map (CommRingCat.ofHom
      (Spec.preimage (E.inv ≫ Limits.pullback.snd c p ≫ T.g₀)).hom) =
      Limits.pullback.snd c p ≫ T.g₀ := by
    rw [CommRingCat.ofHom_hom, Spec.map_preimage, Iso.hom_inv_id_assoc]
  have hT1 : (Spec.preimage (E.inv ≫ Limits.pullback.snd c p ≫ T.g₀)).hom
      (LaurentPolynomial.T 1) = (1 : L) ⊗ₜ[A] (Spec.preimage (c ≫ a₀)).hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) := by
    have h3 := s3 c p T.g₀ E (CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : C →ₐ[A] TensorProduct A L C).toRingHom) hE
      (LaurentPolynomial.T 1) _ T.hg₀T
    have h4 : (Spec.preimage (c ≫ a₀)).hom (Ideal.Quotient.mk
        (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) =
        (Spec.preimage c).hom (wcQmtmX a₀ ⟨0, by omega⟩) := by
      rw [Spec.preimage_comp, CommRingCat.hom_comp, RingHom.comp_apply]
    rw [h3, h4]
    rfl
  obtain ⟨Ψ⟩ := s2 (AddMonoidAlgebra.mapDomainRingHom L
    (algebraMap ℤ (Localization.Away (ℓ : ℤ))).toAddMonoidHom) (Limits.pullback.snd c p)
    T.πi T.gi T.g₀ T.hT E _ he
  obtain ⟨E0⟩ := wc_et_coh_iso_invariance
    ((Limits.pullbackLeftPullbackSndIso c p T.πi).symm ≪≫ Ψ).hom ℓ (j + 1)

  have hℓL : IsUnit ((ℓ : ℕ) : L) := by
    have h := hℓ.map φA
    rwa [map_natCast] at h
  have hSpec : Spec.map (CommRingCat.ofHom (Spec.preimage (c ≫ a₀)).hom) = c ≫ a₀ := by
    rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  have hWE : WeaklyEtale (Spec.map (CommRingCat.ofHom (Spec.preimage (c ≫ a₀)).hom)) := by
    rw [hSpec]
    haveI := hc
    haveI := ha₀
    infer_instance
  have hπC : (Spec.preimage (c ≫ a₀)).hom
      (algebraMap A (wcQuadModelRing A (r + 2) π (wcQmtmC A r)) π) ∈
        IsLocalRing.maximalIdeal C := by
    have h1 : (IsLocalRing.closedPoint A).asIdeal = IsLocalRing.maximalIdeal A := rfl
    have h2 : π ∈ (wcQuadModelStr A (r + 2) π (wcQmtmC A r)
        (a₀ (c (IsLocalRing.closedPoint C)))).asIdeal := by
      rw [hcl, h1, hπ]
      exact Ideal.mem_span_singleton_self π
    have h3 : a₀ (c (IsLocalRing.closedPoint C)) =
        (Spec.map (CommRingCat.ofHom (Spec.preimage (c ≫ a₀)).hom))
          (IsLocalRing.closedPoint C) := by
      rw [hSpec]
      first
        | exact (Scheme.Hom.comp_apply c a₀ _).symm
        | rfl
    rw [h3] at h2
    exact h2

  refine @Equiv.subsingleton _ _ E0.symm
    (wc_qmtm_kummer_ring_tower_coh ℓ hℓL _ _ hT1 j ?_)
  intro k x
  by_cases hdbl : (Spec.preimage (c ≫ a₀)).hom (Ideal.Quotient.mk
        (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal C ∧
      (Spec.preimage (c ≫ a₀)).hom (Ideal.Quotient.mk
        (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
        (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2)))) ∈ IsLocalRing.maximalIdeal C
  · rcases j with _ | j'
    ·
      refine ⟨1, fun β hβ1 hβ2 E' => ?_⟩
      rw [pow_one] at hβ2
      exact wc_qmtm_level_h1_kill A ℓ hℓ π hπ r C (Spec.preimage (c ≫ a₀)).hom hWE
        hdbl.1 hdbl.2 L φA hφA halg k β hβ1 hβ2 E' x
    ·
      refine ⟨0, fun β _ _ E' => ?_⟩
      have hS := wc_qmtm_level_double_higher_vanish A ℓ hℓ π hπ r C (Spec.preimage (c ≫ a₀)).hom
        hWE hdbl.1 hdbl.2 L φA hφA halg k (j' + 1 + 1) (by omega)
      obtain ⟨Eq⟩ := wc_et_zmodext_coh_equiv (Spec (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) -
        Polynomial.C ((1 : L) ⊗ₜ[A] (Spec.preimage (c ≫ a₀)).hom
          (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
            (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) : TensorProduct A L C))))) ℓ (j' + 1 + 1)
      haveI := @Equiv.subsingleton _ _ Eq hS
      rw [Subsingleton.elim x 0, map_zero]
  ·
    refine ⟨0, fun β _ _ E' => ?_⟩
    have hS := wc_qmtm_level_offdouble_acyclic A ℓ hℓ π hπ r C (Spec.preimage (c ≫ a₀)).hom
      hWE hπC hdbl L φA hφA halg k (j + 1) (by omega)
    obtain ⟨Eq⟩ := wc_et_zmodext_coh_equiv (Spec (.of (AdjoinRoot (Polynomial.X ^ (ℓ ^ k) -
      Polynomial.C ((1 : L) ⊗ₜ[A] (Spec.preimage (c ≫ a₀)).hom
        (Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
          (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2)))) : TensorProduct A L C))))) ℓ (j + 1)
    haveI := @Equiv.subsingleton _ _ Eq hS
    rw [Subsingleton.elim x 0, map_zero]

theorem wc_qmtm_tower_acyclic {A B L : Type u} [CommRing A] [IsDomain A]
    [IsDiscreteValuationRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)]
    [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)]
    [Field L] [IsSepClosed L]
    (ℓ : ℕ) [Fact (Nat.Prime ℓ)] (hℓ : IsUnit ((ℓ : ℕ) : A)) (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π}) (r : ℕ)
    (a₀ : Spec (.of B) ⟶ Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r))))
    (ha₀ : WeaklyEtale a₀)
    (hx0 : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
      (MvPolynomial.X (⟨0, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)))
    (hx1 : Ideal.Quotient.mk (wcQuadModelIdeal A (r + 2) π (wcQmtmC A r))
      (MvPolynomial.X (⟨1, by omega⟩ : Fin (r + 2))) ∈ PrimeSpectrum.asIdeal (a₀ (IsLocalRing.closedPoint B)))
    (φA : A →+* L) (hφA : Function.Injective φA) (halg : letI := φA.toAlgebra; Algebra.IsAlgebraic A L)
    (σ : L →+* L) (hσ : σ.comp φA = φA)
    (XE : Scheme.{u}) (p : XE ⟶ Spec (.of B)) (q : XE ⟶ Spec (.of L))
    (hpb : IsPullback p q (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) (Spec.map (CommRingCat.ofHom φA)))
    (Xs : Scheme.{u}) (ι : Xs ⟶ Spec (.of B)) (s : Xs ⟶ Spec (.of (IsLocalRing.ResidueField A)))
    (hps : IsPullback ι s (a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) (wcQmSp A))
    (w : XE ⟶ XE) (hw₁ : w ≫ p = p) (hw₂ : w ≫ q = q ≫ Spec.map (CommRingCat.ofHom σ))
    (T : wcQmtmTower ℓ φA σ p q w (wcQmtmX a₀ ⟨0, by omega⟩))
    (Dπ : wcHMPullData T.πi ℓ) (hDπ : wcHMPullCanonical Dπ)
    (Dp : wcHMPullData p ℓ) (hDp : wcHMPullCanonical Dp)
    (Di : wcHMPullData ι ℓ) (hDi : wcHMPullCanonical Di) :
    haveI := Dp.additive
    haveI : (wcQmtmPush Dp).Additive := Adjunction.right_adjoint_additive Dp.adj
    haveI := Di.additive
    ∀ (J : InjectiveResolution (wcSuppObj Dπ)) (m : ℕ), 1 ≤ m →
      Limits.IsZero (Di.Φ.obj ((((wcQmtmPush Dp).mapHomologicalComplex (ComplexShape.up ℕ)).obj
        J.cocomplex).homology m)) :=
by
  intro J m hm
  obtain ⟨j, rfl⟩ : ∃ j, m = j + 1 := ⟨m - 1, by omega⟩
  haveI := Dp.additive
  haveI := Di.additive
  haveI := Dπ.additive
  have hℓL : IsUnit ((ℓ : ℕ) : L) := by
    have h := hℓ.map φA
    rwa [map_natCast] at h

  let k := T.πi ≫ p
  obtain ⟨Dk, hDk⟩ := wc_hm_pull_data_exists k ℓ
  haveI := Dk.additive
  haveI := sheafOfModules_enoughInjectives (Scheme.ProEt.topology T.XEi) (wcRingSheaf T.XEi ℓ)
  let I := injectiveResolution (SheafOfModules.unit (wcRingSheaf T.XEi ℓ))

  have hacyc := fun n : ℕ => wc_qmtm_tower_push_acyclic ℓ φA hℓL σ p q w _ T Dπ hDπ I n
  obtain ⟨e⟩ := wc_qmtm_push_comp_homology_iso T.πi p k rfl ℓ Dπ hDπ Dp hDp Dk hDk I hacyc J
    (j + 1)
  refine Limits.IsZero.of_iso ?_ (Di.Φ.mapIso e)

  haveI : IsClosedImmersion (wcQmSp A) :=
    IsClosedImmersion.spec_of_surjective _ (by exact IsLocalRing.residue_surjective)
  haveI : IsClosedImmersion ι :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hps.flip inferInstance
  have hsp : ∀ w' : Xs, wcQuadModelStr A (r + 2) π (wcQmtmC A r)
      (a₀ (ι w')) = IsLocalRing.closedPoint A := by
    intro w'
    have h1 : (ι ≫ a₀ ≫ wcQuadModelStr A (r + 2) π (wcQmtmC A r)) w' =
        (s ≫ wcQmSp A) w' := by rw [hps.w]
    have h2 : (s ≫ wcQmSp A) w' = IsLocalRing.closedPoint A := by
      rw [Scheme.Hom.comp_apply]
      have hsw : s w' = IsLocalRing.closedPoint (IsLocalRing.ResidueField A) :=
        @Subsingleton.elim (PrimeSpectrum (IsLocalRing.ResidueField A)) inferInstance _ _
      rw [hsw]
      first
        | exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A)
        | (show (Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))).base _ = _
           rw [Spec.map_base]
           exact IsLocalRing.comap_closedPoint (IsLocalRing.residue A))
    exact h1.trans h2
  let O : Xs.Opens := ⊤
  let k' := O.ι ≫ ι
  obtain ⟨Dk', hDk'⟩ := wc_hm_pull_data_exists k' ℓ
  obtain ⟨Dg, hDg⟩ := wc_hm_pull_data_exists Xs.topIso.inv ℓ
  have hgk : Xs.topIso.inv ≫ k' = ι := by
    show Xs.topIso.inv ≫ (⊤ : Xs.Opens).ι ≫ ι = ι
    rw [← Scheme.topIso_hom, Iso.inv_hom_id_assoc]
  obtain ⟨cι⟩ := wc_hm_pull_data_comp_Phi_iso k' Xs.topIso.inv ι hgk Dk' hDk' Dg hDg Di hDi
  haveI := Dg.additive
  refine Limits.IsZero.of_iso ?_ (cι.app _)
  refine Dg.Φ.map_isZero ?_
  apply wc_proet_pull_isZero_of_local_death k' ℓ Dk'
  intro W s'
  refine ⟨_, wc_proet_closed_open_thickening_sieve ι O ((wcProEtBC k').obj W), ?_⟩
  rintro U e' ⟨T', g, θ, ⟨Vt, κ, hVt, hclos, hsurj⟩, rfl⟩
  obtain ⟨c₀, hc₀⟩ := hsurj W (κ.hom ≫ θ)
  have hc₀' : (wcProEtBC k').map c₀ = κ.hom ≫ θ := hc₀
  refine ⟨Vt, c₀, g ≫ κ.inv, ?_, ?_⟩
  · rw [Category.assoc, hc₀', Iso.inv_hom_id_assoc]
  ·
    have hVaff : IsAffine Vt.left := hVt.1
    haveI := hVaff
    have hAHp : IsAffineHom p :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) hpb.flip
        (isAffineHom_of_isAffine (Spec.map (CommRingCat.ofHom φA)))
    have hAHπ : IsAffineHom T.πi :=
      MorphismProperty.of_isPullback (P := @IsAffineHom) T.hT.flip
        (isAffineHom_of_isAffine _)
    have hAHk : IsAffineHom k := by
      haveI := hAHp
      haveI := hAHπ
      show IsAffineHom (T.πi ≫ p)
      infer_instance
    have hYaff : IsAffine ((wcProEtBC k).obj Vt).left :=
      @AlgebraicGeometry.instIsAffinePullbackSchemeOfIsAffineHom_1 _ _ _ Vt.hom k hAHk hVaff

    have hcl' : ∀ x : Vt.left, IsClosed ({x} : Set Vt.left) →
        wcQuadModelStr A (r + 2) π (wcQmtmC A r) ((Vt.hom ≫ a₀) x) =
          IsLocalRing.closedPoint A := by
      intro x hx
      obtain ⟨pt, hpt⟩ := hclos x hx
      have h1 : (Limits.pullback.fst Vt.hom k' ≫ Vt.hom) pt =
          (Limits.pullback.snd Vt.hom k' ≫ k') pt := by rw [Limits.pullback.condition]
      have h2 : Vt.hom x = ι (O.ι (Limits.pullback.snd Vt.hom k' pt)) := by
        rw [← hpt]
        exact h1
      rw [Scheme.Hom.comp_apply, h2]
      exact hsp _

    have hYet : Subsingleton (wcEtCoh ((wcProEtBC k).obj Vt).left ℓ (j + 1)) := by
      change Subsingleton (wcEtCoh (Limits.pullback Vt.hom k) ℓ (j + 1))
      haveI hYaff' : IsAffine (Limits.pullback Vt.hom k) := hYaff
      haveI : IsAffine ((𝟭 Scheme.{u}).obj Vt.left) := hVt.1
      haveI hAHf : IsAffineHom (Limits.pullback.fst Vt.hom k) := isAffineHom_of_isAffine _
      haveI hQC : QuasiCompact (Limits.pullback.fst Vt.hom k) := inferInstance
      haveI hQS : QuasiSeparated (Limits.pullback.fst Vt.hom k) := inferInstance
      haveI hP0c : CompactSpace (Limits.pullback Vt.hom k : Scheme.{u}) :=
        QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst Vt.hom k)
      haveI hP0q : QuasiSeparatedSpace (Limits.pullback Vt.hom k : Scheme.{u}) :=
        quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst Vt.hom k)
      have hst : ∀ z : Vt.left, IsClosed ({z} : Set Vt.left) →
          Subsingleton (wcEtZModExt (Limits.pullback (Vt.left.fromSpecStalk z)
            (Limits.pullback.fst Vt.hom k)) ℓ (j + 1)) := by
        intro z hz
        haveI : HenselianLocalRing (Vt.left.presheaf.stalk z) := (hVt.2.2.2.2 z hz).1
        haveI : IsSepClosed (IsLocalRing.ResidueField (Vt.left.presheaf.stalk z)) :=
          (hVt.2.2.2.2 z hz).2
        haveI := wc_fromSpecStalk_weaklyEtale Vt.left z
        haveI : WeaklyEtale Vt.hom := Vt.prop
        have hc : WeaklyEtale (Vt.left.fromSpecStalk z ≫ Vt.hom) := inferInstance
        have hcz : (Vt.left.fromSpecStalk z ≫ Vt.hom)
            (IsLocalRing.closedPoint (Vt.left.presheaf.stalk z)) = Vt.hom z :=
          (Scheme.Hom.comp_apply _ _ _).trans
            (congrArg (fun p => Vt.hom p) (Scheme.fromSpecStalk_closedPoint (X := Vt.left) (x := z)))
        have hclz : wcQuadModelStr A (r + 2) π (wcQmtmC A r)
            (a₀ ((Vt.left.fromSpecStalk z ≫ Vt.hom)
              (IsLocalRing.closedPoint (Vt.left.presheaf.stalk z)))) =
            IsLocalRing.closedPoint A := by
          rw [hcz]
          have h := hcl' z hz
          rwa [Scheme.Hom.comp_apply] at h
        have hM := @wc_qmtm_tower_milnor_acyclic A B L _ _ _ _ _ _ _ _ ℓ _ hℓ π hπ r a₀ ha₀
          φA hφA halg σ hσ XE p q hpb w T (Vt.left.presheaf.stalk z) _ (hVt.2.2.2.2 z hz).1
          (hVt.2.2.2.2 z hz).2 (Vt.left.fromSpecStalk z ≫ Vt.hom) hc hclz j
        obtain ⟨e4⟩ := wc_et_coh_iso_invariance
          (Limits.pullbackRightPullbackFstIso Vt.hom k (Vt.left.fromSpecStalk z)).hom ℓ (j + 1)
        have h4 : Subsingleton (wcEtCoh (Limits.pullback (Vt.left.fromSpecStalk z)
            (Limits.pullback.fst Vt.hom k)) ℓ (j + 1)) := @Equiv.subsingleton _ _ e4.symm hM
        obtain ⟨E⟩ := wc_et_zmodext_coh_equiv (Limits.pullback (Vt.left.fromSpecStalk z)
          (Limits.pullback.fst Vt.hom k)) ℓ (j + 1)
        exact @Equiv.subsingleton _ _ E h4
      obtain ⟨Θ, hΘ, hnat⟩ := wc_zmod_et_proet_natural_comparison_all ℓ (j + 1)
      have key : ∀ x : wcEtZModExt (Limits.pullback Vt.hom k) ℓ (j + 1), x = 0 := by
        intro x
        have h0 : Θ _ x = 0 := by
          apply wc_zmod_wlocal_kill_of_stalks hVt.1 hVt.2.1 hVt.2.2.1
            (Limits.pullback.fst Vt.hom k) hQC hQS ℓ (j + 1) (Θ _ x)
          intro z hz Dz hDz
          obtain ⟨Ez⟩ := wc_et_zmod_pull_data_exists (Limits.pullback.snd
            (Vt.left.fromSpecStalk z) (Limits.pullback.fst Vt.hom k)) ℓ
          rw [hnat _ Dz hDz Ez x]
          haveI := hst z hz
          rw [Subsingleton.elim (wcEtPull Ez (j + 1) x) 0, map_zero]
        exact (hΘ _ hP0c hP0q).1 (h0.trans (map_zero _).symm)
      haveI : Subsingleton (wcEtZModExt (Limits.pullback Vt.hom k) ℓ (j + 1)) :=
        ⟨fun x y => by rw [key x, key y]⟩
      obtain ⟨E0⟩ := wc_et_zmodext_coh_equiv (Limits.pullback Vt.hom k) ℓ (j + 1)
      exact E0.symm.subsingleton

    haveI := hYaff
    have h4 : ∀ n : ℕ, Subsingleton (wcEtCoh ((wcProEtBC k).obj Vt).left (ℓ ^ (n + 1)) (j + 1)) :=
      fun n => wc_et_coh_zmod_prime_pow_of_prime _ ℓ Fact.out (j + 1) hYet n
    have h3 := fun n : ℕ =>
      wc_proet_zmod_ext_vanish_of_et ((wcProEtBC k).obj Vt).left (ℓ ^ (n + 1)) j (h4 n)
    have h2 := wc_proet_int_ext_vanish_of_zmod_deg ((wcProEtBC k).obj Vt).left ℓ
      (Scheme.ProEt.mk (𝟙 _)) j h3
    have hv := wc_hm_vanish_of_int_ext_vanish ((wcProEtBC k).obj Vt).left ℓ j h2
    exact wc_proet_push_homology_section_local_death k ℓ Dk I (j + 1) Vt
      (wc_proet_free_projective_wcontractible _ Vt hVt) hv _

theorem wc_qmtm_unit_comp_restr_iso {S X X' Z : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    (f : X ⟶ S) (g : X' ⟶ X) [QuasiCompact f] [QuasiCompact g] (ℓ : ℕ) [Fact (Nat.Prime ℓ)]
    (Df : wcHMPullData f ℓ) (hDf : wcHMPullCanonical Df)
    (Dg : wcHMPullData g ℓ) (hDg : wcHMPullCanonical Dg)
    (Di : wcHMPullData i ℓ) (hDi : wcHMPullCanonical Di)
    (hmfc : ∀ (Vt : S.ProEt) (w : Vt.left), HenselianLocalRing (Vt.left.presheaf.stalk w) →
      IsSepClosed (Vt.left.residueField w) → Vt.hom w ∈ Set.range i →
      ConnectedSpace ↥(Limits.pullback (Vt.left.fromSpecStalk w ≫ Vt.hom) (g ≫ f))) :
    IsIso (Di.Φ.map (wcQmtmUnit Df ≫ (wcQmtmPush Df).map (wcQmtmUnit Dg))) :=
by
  classical
  haveI := Df.cont
  haveI := Dg.cont
  haveI := Di.cont
  let v := wcQmtmUnit Df ≫ (wcQmtmPush Df).map (wcQmtmUnit Dg)
  let α := (SheafOfModules.toSheaf _).map (Di.Φ.map v)
  haveI hα : IsIso α := by
    apply wc_proet_isIso_of_sections_bijective
    intro U
    refine GrothendieckTopology.superset_covering _ (Sieve.generate_mono ?_)
      (wc_pmn_vp_thick_cover i ℓ Di hDi U)
    intro T fT hf
    obtain ⟨Vt, κ, hW, hcl, hunit⟩ := hf
    haveI : IsAffine Vt.left := hW.1
    let pr := Limits.pullback.fst (Limits.pullback.snd Vt.hom f) g ≫ Limits.pullback.fst Vt.hom f
    have hv : Function.Bijective ((v.val.app (Opposite.op Vt)).hom) := by
      have hfun : ⇑((v.val.app (Opposite.op Vt)).hom) =
          fun s : C(↥Vt.left, ULift.{u+1} ℚ_[ℓ]) => s.comp pr.base.hom := by
        funext s
        have e1 : ((wcQmtmUnit Df).val.app (Opposite.op Vt)).hom s =
            s.comp (Limits.pullback.fst Vt.hom f).base.hom :=
          (SheafOfModules.unitToPushforwardObjUnit_val_app_apply Df.φ s).trans (hDf Vt s)
        have e2 : ∀ t : C(↥((wcProEtBC f).obj Vt).left, ULift.{u+1} ℚ_[ℓ]),
