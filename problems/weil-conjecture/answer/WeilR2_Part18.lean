      (∀ (m k : ℕ) (c : L),
        (f ≫ Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi ≫ T.gi).appTop.hom
          ((Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
            (AddMonoidAlgebra.single
              (Localization.mk (m : ℤ) ⟨(ℓ : ℤ) ^ k, k, rfl⟩ : Localization.Away (ℓ : ℤ)) c)) =
        (g ≫ Limits.pullback.snd (Limits.pullback.snd Vt.hom p) T.πi ≫ T.gi).appTop.hom
          ((Scheme.ΓSpecIso (.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv.hom
            (AddMonoidAlgebra.single
