  have G4 : ∀ {𝒜 ℬ 𝒞 : Type (u+2)} [Category.{u+1} 𝒜] [Category.{u+1} ℬ] [Category.{u+1} 𝒞]
      (P : 𝒜 ⥤ ℬ) (Pw : 𝒜 ⥤ 𝒜) (Φ : ℬ ⥤ 𝒞) (γ : Pw ⋙ P ⟶ P) {X : 𝒞} {Y : ℬ} {Λ N : 𝒜}
