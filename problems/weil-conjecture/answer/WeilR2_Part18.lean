    (hG : wcSuppIn (Spec (.of A))
      (Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))))ᶜ G)
    (htor : m • 𝟙 G = 0) (p : ℕ) : Subsingleton (wcEtExt (Spec (.of A)) G p) :=
by
  classical
  have hJ : I ≤ (⊥ : Ideal A).jacobson := HenselianRing.jac
  haveI hqci : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  have hZc : IsClosed (Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))) :=
    (Scheme.Hom.isClosedEmbedding (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))).isClosed_range

  have hspec : ∀ x : Spec (.of A),
      ∃ z ∈ Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))), x ⤳ z := by
    intro x
    obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal x.asIdeal x.isPrime.ne_top
    have hIM : I ≤ M := hJ.trans (sInf_le ⟨bot_le, hM⟩)
    let z : Spec (.of (A ⧸ I)) := ⟨M.map (Ideal.Quotient.mk I),
      Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective (by rw [Ideal.mk_ker]; exact hIM)⟩
    refine ⟨Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) z, ⟨z, rfl⟩, ?_⟩
    have hz : Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)) z =
        (⟨M, hM.isPrime⟩ : PrimeSpectrum A) := by
      apply PrimeSpectrum.ext
      show Ideal.comap (Ideal.Quotient.mk I) (M.map (Ideal.Quotient.mk I)) = M
      exact Ideal.comap_map_mk hIM
    rw [hz]
    exact (PrimeSpectrum.le_iff_specializes x ⟨M, hM.isPrime⟩).mp hle
  set Z : Set (Spec (.of A)) := Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))
    with hZdef
  have hWo : IsOpen Zᶜ := hZc.isOpen_compl

  have hsec : ∀ (Y : Scheme.{u}) (h : Y ⟶ Spec (.of A)), IsClosedMap h →
      ∀ (S : Set Y), (∀ y ∈ S, h y ∉ Z) →
      ∀ (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1})
        (b : F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 Y)))),
        wcSuppSec Y S F (Scheme.Etale.mk (𝟙 Y)) b → b = 0 := by
    intro Y h hh S hS F b hb
    have hEtHom : ∀ {P Q : Y.Etale} (c : P ⟶ Q), Etale c.left := by
      intro P Q c
      have hw : c.left ≫ Q.hom = P.hom := MorphismProperty.Over.w c
      have h1 : Etale Q.hom := Q.prop
      have h2 : Etale (c.left ≫ Q.hom) := by rw [hw]; exact P.prop
      exact Etale.of_comp c.left Q.hom
    let T : Y.Etale := Scheme.Etale.mk (𝟙 Y)
    let E : Set T.left := {v | ∃ (V₁ : Y.Etale) (c : V₁ ⟶ T), v ∈ Set.range c.left ∧
      F.obj.map c.op b = 0}
    have hEopen : IsOpen E := by
      rw [isOpen_iff_forall_mem_open]
      rintro v ⟨V₁, c, hv, hc⟩
      haveI := hEtHom c
      exact ⟨Set.range c.left, fun w hw => ⟨V₁, c, hw, hc⟩, c.left.isOpenMap.isOpen_range, hv⟩
    have hvan : ∀ (V₁ : Y.Etale) (c : V₁ ⟶ T), Set.range c.left ⊆ E →
        F.obj.map c.op b = 0 := by
      intro V₁ c hsub
      let S' : Sieve V₁ :=
        { arrows := fun D d => F.obj.map d.op (F.obj.map c.op b) = 0
          downward_closed := by
            intro D D' d hd e
            change F.obj.map (e ≫ d).op (F.obj.map c.op b) = 0
            rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
            rw [hd, map_zero] }
      have hS' : S' ∈ Scheme.smallEtaleTopology Y V₁ := by
        change S' ∈ Scheme.smallGrothendieckTopology @Etale Y V₁
        rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl]
        apply (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
          MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mpr
        intro q
        obtain ⟨V₂, c₂, ⟨q₀, hq₀⟩, hc₂⟩ := hsub ⟨q, rfl⟩
        haveI : Etale c₂.left := hEtHom c₂
        haveI : Etale V₁.hom := V₁.prop
        let fst := Limits.pullback.fst c.left c₂.left
        let snd := Limits.pullback.snd c.left c₂.left
        haveI hfst : Etale fst := inferInstance
        let D : Y.Etale := Scheme.Etale.mk (fst ≫ V₁.hom)
        have hw2 : snd ≫ V₂.hom = fst ≫ V₁.hom := by
          rw [← MorphismProperty.Over.w c₂, ← MorphismProperty.Over.w c, ← Category.assoc,
            ← Category.assoc, Limits.pullback.condition]
        let π₁ : D ⟶ V₁ := MorphismProperty.Over.homMk fst rfl trivial
        let π₂ : D ⟶ V₂ := MorphismProperty.Over.homMk snd hw2 trivial
        have hcomm : π₁ ≫ c = π₂ ≫ c₂ := by
          apply MorphismProperty.Over.Hom.ext
          exact Limits.pullback.condition
        obtain ⟨z, hz1, -⟩ := Scheme.Pullback.exists_preimage_pullback q q₀ hq₀.symm
        have hπ₁ : S'.arrows π₁ := by
          change F.obj.map π₁.op (F.obj.map c.op b) = 0
          rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp, hcomm, op_comp,
            Functor.map_comp, ConcreteCategory.comp_apply, hc₂, map_zero]
        exact ⟨D, π₁, z, hπ₁, hfst, hz1⟩
      have hsh := (isSheaf_iff_isSheaf_of_type _ _).mp
        ((sheafCompose (Scheme.smallEtaleTopology Y) (forget AddCommGrpCat.{u+1})).obj F).2
      exact (hsh S' hS').isSeparatedFor.ext (fun D d hd => by
        change F.obj.map d.op (F.obj.map c.op b) = F.obj.map d.op 0
        rw [map_zero]
        exact hd)
    have hfib : ∀ z : Y, h z ∈ Z → z ∈ E := by
      intro z hz
      have hR := hb
      unfold wcSuppSec at hR
      change _ ∈ Scheme.smallGrothendieckTopology @Etale Y T at hR
      rw [@Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ le_rfl] at hR
      obtain ⟨Y₀, g, y, hg, -, hy⟩ := (@Scheme.mem_toGrothendieck_smallPretopology @Etale @Etale Y
        MorphismProperty.IsMultiplicative.toIsStableUnderComposition _ _ _ _ _ _).mp hR z
      obtain ⟨Y', k, g', hg', hcomp⟩ := hg
      have hy' : g'.left (k.left y) = z := by
        rw [← hy, ← hcomp]
        rfl
      rcases hg' with h0 | hW
      · exact ⟨Y', g', ⟨k.left y, hy'⟩, h0⟩
      · exfalso
        have h1 := hS _ (hW (k.left y))
        have h2 : Y'.hom (k.left y) = z := by
          rw [← MorphismProperty.Over.w g', Scheme.Hom.comp_apply, hy']
          rfl
        rw [h2] at h1
        exact h1 hz
    have hEuniv : ∀ v, v ∈ E := by
      intro x
      by_contra hx
      have hZ' : IsClosed Eᶜ := hEopen.isClosed_compl
      have hfZ := hh _ hZ'
      obtain ⟨z', hz'Z, hspz⟩ := hspec (h x)
      have hmem : z' ∈ h '' Eᶜ := hspz.mem_closed hfZ ⟨x, hx, rfl⟩
      obtain ⟨z, hzE, hz⟩ := hmem
      exact hzE (hfib z (by rw [hz]; exact hz'Z))
    have h0 := hvan T (𝟙 T) (fun v _ => hEuniv v)
    rw [op_id, F.obj.map_id] at h0
    exact h0
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  letI : EnoughInjectives (Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) :=
    wc_et_enough_injectives (Spec (.of A))

  have hgamma : ∀ (J J' : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1})
      (ι : J' ⟶ J), Mono ι → wcSuppIn (Spec (.of A)) Zᶜ J' →
      (∀ (G : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) (φ : G ⟶ J),
        wcSuppIn (Spec (.of A)) Zᶜ G → ∃ φ' : G ⟶ J', φ' ≫ ι = φ) →
      ∀ t : (Limits.cokernel ι).obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 (Spec (.of A))))),
        ∃ s : J.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 (Spec (.of A))))),
          ((Limits.cokernel.π ι).hom.app
            (Opposite.op (Scheme.Etale.mk (𝟙 (Spec (.of A)))))).hom s = t := by
    intro J J' ι hmono hsupp huniv t
    have hkey := wc_et_quot_kernel_iff_supp (Spec (.of A)) Zᶜ J J' ι hmono hsupp huniv
    have hEG : wcEtGlueMod (Spec (.of A)) Zᶜ J := by
      refine wc_et_gluing_of_zariski_finite A (Spec (.of A)) (𝟙 _) Zᶜ hWo ?_ ?_ J
      · intro Y q _ G'
        exact wc_zariski_spectral_trace_gluing A Y q (q ⁻¹' Z) (hZc.preimage q.continuous)
          (wc_hp_finite_trace_connected A I Y q) G'
      · intro Y q _ G' b hb
        exact hsec Y q (Scheme.Hom.isClosedMap q) (q ⁻¹' Zᶜ) (fun y hy => hy) G' b hb
    have hR := wc_sheaf_epi_locallySurjective (Scheme.smallEtaleTopology (Spec (.of A)))
      (Limits.cokernel.π ι) (Scheme.Etale.mk (𝟙 (Spec (.of A)))) t
    let sl : ∀ (V : (Spec (.of A)).Etale) (g : V ⟶ Scheme.Etale.mk (𝟙 (Spec (.of A)))),
        (Presheaf.imageSieve (Limits.cokernel.π ι).hom t).arrows g → J.obj.obj (Opposite.op V) :=
      fun V g h => h.choose
    have hsl : ∀ (V : (Spec (.of A)).Etale) (g : V ⟶ Scheme.Etale.mk (𝟙 (Spec (.of A))))
        (h : (Presheaf.imageSieve (Limits.cokernel.π ι).hom t).arrows g),
        ((Limits.cokernel.π ι).hom.app (Opposite.op V)).hom (sl V g h) =
          ((Limits.cokernel ι).obj.map g.op).hom t := fun V g h => h.choose_spec
    have hnat : ∀ (V V' : (Spec (.of A)).Etale) (a : V' ⟶ V) (x : J.obj.obj (Opposite.op V)),
        ((Limits.cokernel.π ι).hom.app (Opposite.op V')).hom (J.obj.map a.op x) =
          ((Limits.cokernel ι).obj.map a.op).hom
            (((Limits.cokernel.π ι).hom.app (Opposite.op V)).hom x) := by
      intro V V' a x
      exact NatTrans.naturality_apply (Limits.cokernel.π ι).hom a.op x
    have hlift : ∀ (V V' : (Spec (.of A)).Etale) (g : V ⟶ Scheme.Etale.mk (𝟙 (Spec (.of A))))
        (h : (Presheaf.imageSieve (Limits.cokernel.π ι).hom t).arrows g) (a : V' ⟶ V),
        ((Limits.cokernel.π ι).hom.app (Opposite.op V')).hom (J.obj.map a.op (sl V g h)) =
          ((Limits.cokernel ι).obj.map (a ≫ g).op).hom t := by
      intro V V' g h a
      rw [hnat, hsl, op_comp, Functor.map_comp]
      rfl
    have hcompat : ∀ (V₁ V₂ V' : (Spec (.of A)).Etale)
        (g₁ : V₁ ⟶ Scheme.Etale.mk (𝟙 (Spec (.of A))))
        (g₂ : V₂ ⟶ Scheme.Etale.mk (𝟙 (Spec (.of A))))
        (h₁ : (Presheaf.imageSieve (Limits.cokernel.π ι).hom t).arrows g₁)
        (h₂ : (Presheaf.imageSieve (Limits.cokernel.π ι).hom t).arrows g₂)
        (a : V' ⟶ V₁) (c : V' ⟶ V₂), a ≫ g₁ = c ≫ g₂ →
        wcSuppSec (Spec (.of A)) Zᶜ J V'
          (J.obj.map a.op (sl V₁ g₁ h₁) - J.obj.map c.op (sl V₂ g₂ h₂)) := by
      intro V₁ V₂ V' g₁ g₂ h₁ h₂ a c hac
      rw [← hkey, map_sub, hlift, hlift, hac, sub_self]
    obtain ⟨s₀, hs₀⟩ := hEG _ hR sl hcompat
    refine ⟨s₀, (Limits.cokernel ι).isSeparated _ _ hR _ _ (fun V g hg => ?_)⟩
    have h0 := (hkey V _).mpr (hs₀ V g hg)
    rw [map_sub, sub_eq_zero] at h0
    have h1 := hnat _ V g s₀
    have h2 := hsl V g hg
    exact h1.symm.trans (h0.trans h2)

  let Q : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1} → Prop := fun G =>
    m • 𝟙 G = 0 ∧ wcSuppIn (Spec (.of A)) Zᶜ G

  have hcok : ∀ {G G' : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}}
      (ι : G ⟶ G'), Q G' → Q (Limits.cokernel ι) := by
    intro G G' ι hG'
    obtain ⟨h1, h2⟩ := wc_supp_torsion_cokernel (Spec (.of A)) Zᶜ m ι hG'.2 hG'.1
    exact ⟨h2, h1⟩

  have hT : Limits.IsTerminal (Scheme.Etale.mk (𝟙 (Spec (.of A)))) :=
    Limits.IsTerminal.ofUniqueHom
      (fun V => MorphismProperty.Over.homMk V.hom)
      (fun V m => MorphismProperty.Over.Hom.ext
        ((Category.comp_id m.left).symm.trans (MorphismProperty.Over.w m)))
  have h0 : ∀ G : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}, Q G →
      ∀ e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of A)))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G 0, e = 0 := by
    intro F hF e
    have hid : ∀ y ∈ (Zᶜ : Set (Spec (.of A))), (𝟙 (Spec (.of A))) y ∉ Z := by
      intro y hy
      simpa using hy
    have hzero : ∀ s : F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 (Spec (.of A))))), s = 0 :=
      fun s => hsec _ (𝟙 _) (Scheme.Hom.isClosedMap _) Zᶜ hid F s (hF.2 _ s)
    haveI : Subsingleton (F.obj.obj (Opposite.op (Scheme.Etale.mk (𝟙 (Spec (.of A)))))) :=
      ⟨fun a b => (hzero a).trans (hzero b).symm⟩
    have hs : Subsingleton (wcEtExt (Spec (.of A)) F 0) := by
      unfold wcEtExt
      exact (Sheaf.H.equiv₀ F hT).toEquiv.subsingleton
    have hs' : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology
        (Spec (.of A))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F 0) := hs
    exact Subsingleton.elim _ _

  have hkill : ∀ G : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}, Q G →
      ∀ (n : ℕ) (c : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of A)))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G (n + 1)),
      ∃ (G' : Sheaf (Scheme.smallEtaleTopology (Spec (.of A))) AddCommGrpCat.{u+1}) (ι : G ⟶ G'),
        Mono ι ∧ Q G' ∧ c.comp (Abelian.Ext.mk₀ ι) (add_zero (n + 1)) = 0 := by
    intro G hG n c
    haveI hIinj : Injective (Injective.under G) := Injective.injective_under G
    have h1 : Injective.ι G ≫ (m • 𝟙 (Injective.under G)) = 0 := by
      have e : Injective.ι G ≫ (m • 𝟙 (Injective.under G)) = (m • 𝟙 G) ≫ Injective.ι G := by
        simp only [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id,
          Category.id_comp]
      rw [e, hG.1, Limits.zero_comp]
    let ι₁ : G ⟶ Limits.kernel (m • 𝟙 (Injective.under G)) :=
      Limits.kernel.lift _ (Injective.ι G) h1
    haveI : Mono ι₁ := mono_of_mono_fac (Limits.kernel.lift_ι _ (Injective.ι G) h1)
    obtain ⟨J', ιJ, hmono, hsupp, huniv⟩ := wc_et_max_supported_subsheaf (Spec (.of A))
      Zᶜ (Limits.kernel (m • 𝟙 (Injective.under G)))
    obtain ⟨φ', hφ'⟩ := huniv G ι₁ hG.2
    haveI := hmono
    haveI hφmono : Mono φ' := mono_of_mono_fac hφ'
    have hK : m • 𝟙 (Limits.kernel (m • 𝟙 (Injective.under G))) = 0 := by
      rw [← cancel_mono (Limits.kernel.ι (m • 𝟙 (Injective.under G)))]
      have hc := Limits.kernel.condition (m • 𝟙 (Injective.under G))
      simp only [Preadditive.comp_nsmul, Category.comp_id] at hc
      simp only [Preadditive.nsmul_comp, Category.id_comp, Limits.zero_comp]
      exact hc
    have hJ'tor : m • 𝟙 J' = 0 := by
      rw [← cancel_mono ιJ]
      have e : (m • 𝟙 J') ≫ ιJ = ιJ ≫ (m • 𝟙 _) := by
        simp only [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id,
          Category.id_comp]
      rw [e, hK, Limits.comp_zero, Limits.zero_comp]
    have hJ'acyc : ∀ (k : ℕ) (e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology
        (Spec (.of A))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) J' (k + 1)),
        e = 0 := by
      let S := ShortComplex.mk ιJ (Limits.cokernel.π ιJ) (Limits.cokernel.condition ιJ)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ιJ) hmono inferInstance
      have hce : (Abelian.Ext.mk₀ (Limits.cokernel.π ιJ)).comp hS.extClass (zero_add 1) = 0 :=
        hS.comp_extClass
      intro k e
      have hmid : e.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 := by
        have hs : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology
            (Spec (.of A))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
            (Limits.kernel (m • 𝟙 (Injective.under G))) (k + 1)) :=
          wc_et_injective_torsion_kernel_acyclic (Spec (.of A)) (Injective.under G) m hm k
        exact Subsingleton.elim _ _
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS e hmid rfl
      rw [← hx₃]
      rcases k with _ | j
      · obtain ⟨y, hy⟩ := wc_et_ext0_surj_of_sections (Spec (.of A)) (Limits.cokernel.π ιJ)
          (hgamma _ J' ιJ hmono hsupp huniv) x₃
        rw [← hy, Abelian.Ext.comp_assoc _ _ _ (add_zero 0) (zero_add 1) (by omega), hce,
          Abelian.Ext.comp_zero]
      · have hs : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology
            (Spec (.of A))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
            (Limits.cokernel ιJ) (j + 1)) :=
          wc_et_affine_quot_vanish (Spec (.of A)) Zᶜ hWo m hm (Injective.under G) J' ιJ hmono
            hsupp (wc_et_maxsupp_sections_surj (Spec (.of A)) Zᶜ _ J' ιJ huniv) j
        have hx0 : x₃ = 0 := @Subsingleton.elim _ hs x₃ 0
        rw [hx0, Abelian.Ext.zero_comp]
    exact ⟨J', φ', hφmono, ⟨hJ'tor, hsupp⟩, hJ'acyc n _⟩

  have hshift : ∀ (n : ℕ) (G : Sheaf (Scheme.smallEtaleTopology (Spec (.of A)))
      AddCommGrpCat.{u+1}), Q G →
      ∀ e : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of A)))
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G n, e = 0 := by
    intro n
    induction n with
    | zero => exact h0
    | succ n ih =>
      intro G hG c
      obtain ⟨G', ι, hι, hG', hc⟩ := hkill G hG n c
      let S := ShortComplex.mk ι (Limits.cokernel.π ι) (Limits.cokernel.condition ι)
      have hS : S.ShortExact :=
        ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel ι) hι inferInstance
      obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ _ hS c hc rfl
      have hx0 : x₃ = 0 := ih _ (hcok ι hG') x₃
      rw [← hx₃, hx0, Abelian.Ext.zero_comp]
  have hs := hshift p G ⟨htor, hG⟩
  change Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of A)))
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) G p)
  exact ⟨fun x y => (hs x).trans (hs y).symm⟩

theorem wc_tq_et_proper_henselian_supp_vanish : ∀ (R : Type u) [CommRing R] (𝔞 : Ideal R) [HenselianRing R 𝔞] {X : Scheme.{u}} (π : X ⟶ Spec (.of R)) [IsProper π] (m : ℕ), m ≠ 0 → ∀ (F : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}), wcSuppIn X {x | ¬ (π x ∈ Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔞))))} F → m • 𝟙 F = 0 → ∀ q : ℕ, Subsingleton (wcEtExt X F q) :=
by
  classical
  intro R _ 𝔞 _ X π _ m hm0 F hF htor q
  have hloc : ∀ {X₁ Y₁ : Scheme.{u}} (g : X₁ ⟶ Y₁),
      (∀ y : Y₁, ∃ U₁ : Y₁.Opens, y ∈ U₁ ∧ wcPBCV (g ∣_ U₁)) → wcPBCV g := by
    intro X₁ Y₁ g H A' _ _ _ a X' f' a' hsq m' hm' F hF htor' q'
    obtain ⟨U₁, hyU, hU⟩ := H (a (IsLocalRing.closedPoint A'))
    have htop : a ⁻¹ᵁ U₁ = ⊤ := (IsLocalRing.closedPoint_mem_iff (U := a ⁻¹ᵁ U₁)).mp hyU
    have hrange : Set.range a ⊆ Set.range U₁.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      have hz : z ∈ a ⁻¹ᵁ U₁ := by rw [htop]; trivial
      exact hz
    let b := IsOpenImmersion.lift U₁.ι a hrange
    have hb : b ≫ U₁.ι = a := IsOpenImmersion.lift_fac _ _ _
    have hsq2 : IsPullback (g ⁻¹ᵁ U₁).ι (g ∣_ U₁) g U₁.ι := (isPullback_morphismRestrict g U₁).flip
    let a'' : X' ⟶ (g ⁻¹ᵁ U₁ : Scheme.{u}) :=
      hsq2.lift a' (f' ≫ b) (by rw [Category.assoc, hb, hsq.w])
    have h1 : a'' ≫ (g ⁻¹ᵁ U₁).ι = a' := hsq2.lift_fst _ _ _
    have h2 : a'' ≫ (g ∣_ U₁) = f' ≫ b := hsq2.lift_snd _ _ _
    have hbig : IsPullback (a'' ≫ (g ⁻¹ᵁ U₁).ι) f' g (b ≫ U₁.ι) := by rw [h1, hb]; exact hsq
    have hpb' : IsPullback a'' f' (g ∣_ U₁) b := IsPullback.of_right hbig h2 hsq2
    exact hU A' b X' f' a'' hpb' m' hm' F hF htor' q'
  have hall : ∀ {X₁ Y₁ : Scheme.{u}} (g : X₁ ⟶ Y₁), IsProper g → wcPBCV g :=
    wc_proper_devissage (fun g => wcPBCV g) wc_pbc_finite wc_pbc_P1 wc_pbc_comp wc_pbc_cancel
      hloc
  have hπP : wcPBCV π := hall π inferInstance
  haveI hqci : IsClosedImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔞))) :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  have hZIc : IsClosed (Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔞)))) :=
    (Scheme.Hom.isClosedEmbedding (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔞)))).isClosed_range
  let P : ↥(Spec (.of R)) → Prop :=
    fun y => y ∈ Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔞)))
  have hPo : IsOpen {y | ¬ P y} := hZIc.isOpen_compl
  have hF' : wcSuppIn X {x | ¬ P (π x)} F := hF
  have s5 : ∀ {C : Type _} {D : Type _} [Category C] [Category D] [Abelian C] [Abelian D]
      (R : C ⥤ D) [R.Additive] (A : C) (I : InjectiveResolution A) (m : ℕ), m • 𝟙 A = 0 →
      ∀ q : ℕ, m • 𝟙 (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)
        = 0 := by
    intro C D _ _ _ _ R _ A I m hA q
    have hι : I.ι ≫ (m • 𝟙 I.cocomplex) = 0 := by
      rw [Preadditive.comp_nsmul, Category.comp_id, ← Category.id_comp I.ι,
        ← Preadditive.nsmul_comp]
      have h0 : m • 𝟙 ((CochainComplex.single₀ C).obj A) = 0 := by
        rw [← (CochainComplex.single₀ C).map_id, ← CategoryTheory.Functor.map_nsmul, hA,
          CategoryTheory.Functor.map_zero]
      rw [h0, Limits.zero_comp]
    let H := I.descHomotopyZero (m • 𝟙 I.cocomplex) hι
    let H' := R.mapHomotopy H
    have e1 := H'.homologyMap_eq q
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_zero, HomologicalComplex.homologyMap_zero] at e1
    have e2 : HomologicalComplex.homologyMap
        (m • 𝟙 ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)) q =
        m • 𝟙 _ := by
      have : (HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).map
          (m • 𝟙 ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)) =
          m • (HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).map
            (𝟙 ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex)) :=
        (HomologicalComplex.homologyFunctor D (ComplexShape.up ℕ) q).map_nsmul
      simp at this
      exact this
    rw [← e2, e1]
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1}) :=
    HasExt.standard _
  haveI := wc_et_enough_injectives X
  let Ires := injectiveResolution F
  obtain ⟨L', ⟨adj'⟩, hL', ⟨eL⟩⟩ := wc_et_push_left_adjoint π
  haveI := hL'
  have hKinj : ∀ k, Injective ((((wcEtPush π).mapHomologicalComplex (ComplexShape.up ℕ)).obj
      Ires.cocomplex).X k) := fun k => adj'.map_injective _ (Ires.injective k)
  have hH : ∀ p n : ℕ, Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology
      (Spec (.of R))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((((wcEtPush π).mapHomologicalComplex (ComplexShape.up ℕ)).obj Ires.cocomplex).homology n)
      p) := by
    intro p n
    have hk := wc_pbc_locKill π (𝟙 _) π (𝟙 _) (IsPullback.id_horiz π) inferInstance hπP m hm0
      F htor P hF' Ires n
    have hs := wc_et_push_homology_supp_of_locKill π Ires.cocomplex n P hPo hk
    have ht := s5 (wcEtPush π) F Ires m htor n
    exact wc_et_henselian_pair_affine_supp_vanishing R 𝔞 m hm0 _ hs ht p
  have hcoc := wc_inj_complex_cocycle_exact ((constantSheaf (Scheme.smallEtaleTopology
      (Spec (.of R))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
    (((wcEtPush π).mapHomologicalComplex (ComplexShape.up ℕ)).obj Ires.cocomplex) hKinj hH
  let P0 := (constantSheaf (Scheme.smallEtaleTopology (Spec (.of R))) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} ℤ))
  have hcoc' : ∀ (n : ℕ) (c : P0 ⟶ (wcEtPush π).obj (Ires.cocomplex.X n)),
      c ≫ (wcEtPush π).map (Ires.cocomplex.d n (n + 1)) = 0 →
      ∃ e : P0 ⟶ (wcEtPush π).obj (Ires.cocomplex.X (n - 1)),
        e ≫ (wcEtPush π).map (Ires.cocomplex.d (n - 1) n) = c := fun n c hc => hcoc n c hc
  haveI hsub : Subsingleton (Abelian.Ext (L'.obj P0) F q) := by
    constructor
    intro x y
    suffices hz : ∀ z : Abelian.Ext (L'.obj P0) F q, z = 0 by rw [hz x, hz y]
    intro z
    cases q with
    | zero =>
      let φ : L'.obj P0 ⟶ F := Abelian.Ext.homEquiv₀ z
      have hz : z = Abelian.Ext.mk₀ φ := (Abelian.Ext.mk₀_homEquiv₀_apply z).symm
      let e0 := HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 F
      let ι' : F ⟶ Ires.cocomplex.X 0 := e0.inv ≫ Ires.ι.f 0
      haveI : Mono ι' := mono_comp _ _
      have hι' : ι' ≫ Ires.cocomplex.d 0 1 = 0 := by
        simp only [ι', Category.assoc, InjectiveResolution.ι_f_zero_comp_complex_d,
          Limits.comp_zero]
      let c := adj'.homEquiv _ _ (φ ≫ ι')
      have hc : c ≫ (wcEtPush π).map (Ires.cocomplex.d 0 (0 + 1)) = 0 := by
        rw [← adj'.homEquiv_naturality_right, Category.assoc, hι', Limits.comp_zero,
          Adjunction.homEquiv_unit, CategoryTheory.Functor.map_zero, Limits.comp_zero]
      obtain ⟨e, he⟩ := hcoc' 0 c hc
      have hc0 : c = 0 := by
        rw [← he, Ires.cocomplex.shape (0 - 1) 0 (by simp), CategoryTheory.Functor.map_zero,
          Limits.comp_zero]
      have hφι : φ ≫ ι' = 0 := by
        have : φ ≫ ι' = (adj'.homEquiv _ _).symm c := by
          simp only [c, Equiv.symm_apply_apply]
        rw [this, hc0, Adjunction.homEquiv_counit, CategoryTheory.Functor.map_zero,
          Limits.zero_comp]
      have hφ : φ = 0 := (cancel_mono ι').mp (hφι.trans (Limits.zero_comp).symm)
      rw [hz, hφ, Abelian.Ext.mk₀_zero]
    | succ p =>
      obtain ⟨f0, hf0, rfl⟩ := Ires.extMk_surjective z (p + 1 + 1) rfl
      have hc : adj'.homEquiv _ _ f0 ≫ (wcEtPush π).map (Ires.cocomplex.d (p + 1) (p + 1 + 1))
          = 0 := by
        rw [← adj'.homEquiv_naturality_right, hf0, Adjunction.homEquiv_unit,
          CategoryTheory.Functor.map_zero, Limits.comp_zero]
      obtain ⟨e, he⟩ := hcoc' (p + 1) _ hc
      rw [Ires.extMk_eq_zero_iff f0 (p + 1 + 1) rfl hf0 p rfl]
      refine ⟨(adj'.homEquiv _ _).symm e, ?_⟩
      apply (adj'.homEquiv _ _).injective
      rw [adj'.homEquiv_naturality_right, Equiv.apply_symm_apply]
      exact he
  show Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F q)
  constructor
  intro x y
  have key : ∀ z : Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology X)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) F q,
      (Abelian.Ext.mk₀ eL.inv).comp ((Abelian.Ext.mk₀ eL.hom).comp z (zero_add _)) (zero_add _)
        = z := by
    intro z
    rw [Abelian.Ext.mk₀_comp_mk₀_assoc, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
  rw [← key x, ← key y, Subsingleton.elim ((Abelian.Ext.mk₀ eL.hom).comp x (zero_add _))
    ((Abelian.Ext.mk₀ eL.hom).comp y (zero_add _))]

theorem wc_tq_gabber_module_ext_vanish {S Z : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    (W : S.ProEt) (R : Type u) [CommRing R] (𝔞 : Ideal R) [HenselianRing R 𝔞]
    (πW : W.left ⟶ Spec (.of R)) [IsProper πW]
    (cW : Limits.pullback W.hom i ⟶ Spec (.of (R ⧸ 𝔞)))
    (hsq : IsPullback (Limits.pullback.fst W.hom i) cW πW
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔞))))
    (m : ℕ) (hm : 0 < m) (Q : SheafOfModules.{u+1} (wcZModRingSheaf S m))
    (e : ∀ M : SheafOfModules.{u+1} (wcZModRingSheaf S m), (Q ⟶ M) ≃ (wcZModSecEv S m W).obj M)
    (he : ∀ (M N : SheafOfModules.{u+1} (wcZModRingSheaf S m)) (ψ : M ⟶ N) (f : Q ⟶ M),
      e N (f ≫ ψ) = ((wcZModSecEv S m W).map ψ).hom (e M f))
    (M : SheafOfModules.{u+1} (wcZModRingSheaf S m))
    (H : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (hHm : m • 𝟙 H = 0)
    (hsupp : wcSuppIn S (Set.range i)ᶜ H)
    (hH : Nonempty ((SheafOfModules.toSheaf (wcZModRingSheaf S m)).obj M ≅ (wcEpsInv S).obj H))
    (p : ℕ) :
    letI := HasExt.standard (SheafOfModules.{u+1} (wcZModRingSheaf S m))
    Subsingleton (Abelian.Ext Q M p) :=
by
  classical
  obtain ⟨φ⟩ := hH

  haveI : CompactSpace W.left := QuasiCompact.compactSpace_of_compactSpace πW
  haveI : IsSeparated (Limits.terminal.from W.left) := by
    rw [show Limits.terminal.from W.left = πW ≫ Limits.terminal.from _ from
      Limits.terminal.hom_ext _ _]
    infer_instance

  have hinv : hsq.isoPullback.inv ≫ Limits.pullback.fst W.hom i =
      Limits.pullback.fst πW (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔞))) := by
    rw [Iso.inv_comp_eq]
    exact hsq.isoPullback_hom_fst.symm
  have hrangei : Set.range (Limits.pullback.fst W.hom i) =
      Set.range (Limits.pullback.fst πW (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔞)))) := by
    ext x
    constructor
    · rintro ⟨z, rfl⟩
      exact ⟨hsq.isoPullback.hom z, by rw [← Scheme.Hom.comp_apply, hsq.isoPullback_hom_fst]⟩
    · rintro ⟨w, rfl⟩
      exact ⟨hsq.isoPullback.inv w, by rw [← Scheme.Hom.comp_apply, hinv]⟩
  have hset : W.hom ⁻¹' (Set.range i)ᶜ =
      {x | ¬ (πW x ∈ Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔞))))} := by
    ext x
    have h1 : x ∈ Set.range (Limits.pullback.fst W.hom i) ↔ W.hom x ∈ Set.range i := by
      rw [Scheme.Pullback.range_fst]; exact Iff.rfl
    have h2 : x ∈ Set.range (Limits.pullback.fst πW
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔞)))) ↔
        πW x ∈ Set.range (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔞))) := by
      rw [Scheme.Pullback.range_fst]; exact Iff.rfl
    rw [hrangei] at h1
    exact not_congr (h1.symm.trans h2)

  obtain ⟨H', htor', hsupp', E2⟩ :=
    wc_tq_ext_free_slice_epsInv_supp S W m (Set.range i)ᶜ H hHm hsupp
  rw [hset] at hsupp'
  have hvan := wc_tq_et_proper_henselian_supp_vanish R 𝔞 πW m (Nat.pos_iff_ne_zero.mp hm) H'
    hsupp' htor'
  have hB : ∀ w : Abelian.Ext (wcFreeSheaf S W) ((wcEpsInv S).obj H) p, w = 0 := by
    intro w
    obtain ⟨E⟩ := E2 p
    letI : HasExt (Sheaf (Scheme.smallEtaleTopology W.left) AddCommGrpCat.{u+1}) :=
      HasExt.standard _
    obtain ⟨E3⟩ := wc_proet_etale_comparison_epsInv_qcsep W.left H' p
    haveI : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology W.left)
        AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ))) H' p) := hvan p
    apply E.injective
    apply E3.injective
    exact Subsingleton.elim _ _
  have hM : ∀ z : Abelian.Ext (wcFreeSheaf S W)
      ((SheafOfModules.toSheaf (wcZModRingSheaf S m)).obj M) p, z = 0 := by
    intro z
    calc z = z.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero _) := (Abelian.Ext.comp_mk₀_id z).symm
      _ = z.comp (Abelian.Ext.mk₀ (φ.hom ≫ φ.inv)) (add_zero _) := by rw [Iso.hom_inv_id]
      _ = z.comp ((Abelian.Ext.mk₀ φ.hom).comp (Abelian.Ext.mk₀ φ.inv) (add_zero 0))
            (add_zero _) := by rw [Abelian.Ext.mk₀_comp_mk₀]
      _ = (z.comp (Abelian.Ext.mk₀ φ.hom) (add_zero _)).comp (Abelian.Ext.mk₀ φ.inv)
            (add_zero _) := (Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero 0) (by omega)).symm
      _ = 0 := by rw [hB (z.comp (Abelian.Ext.mk₀ φ.hom) (add_zero _)), Abelian.Ext.zero_comp]
  have hx := wc_tq_zmod_corep_ext_transfer S m W Q e he
    (wc_tq_zmod_inj_free_ext_vanish S m hm W) M p hM
  exact ⟨fun x y => (hx x).trans (hx y).symm⟩

theorem wc_qmbt_tq_torsion_pbc {S Z E : Scheme.{u}} (i : Z ⟶ S) [IsClosedImmersion i]
    (g : E ⟶ S) [IsAffineHom g] (m : ℕ) (hm : 0 < m) (W : S.ProEt)
    (R : Type u) [CommRing R] (𝔞 : Ideal R) [HenselianRing R 𝔞]
    (πW : W.left ⟶ Spec (.of R)) [IsProper πW]
    (cW : Limits.pullback W.hom i ⟶ Spec (.of (R ⧸ 𝔞)))
    (hsq : IsPullback (Limits.pullback.fst W.hom i) cW πW
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk 𝔞)))) :
    wcTorsionPBCAt i g m W :=
by
  intro Dg hDg Di hDi I
  haveI := Dg.additive
  haveI := Di.additive
  haveI := Dg.presLim
  haveI := Di.presLim
  haveI := Di.presColim
  intro P K evW evWs J m₀ hJ hJi j hj w hw
  haveI : P.Additive := Adjunction.right_adjoint_additive Dg.adj
  let Pi := @SheafOfModules.pushforward.{u+1} _ _ _ _ _ _ (wcProEtBC i) _ _ Di.cont Di.φ
  haveI : Pi.Additive := Adjunction.right_adjoint_additive Di.adj
  haveI : evW.Additive := by
    dsimp only [evW]
    infer_instance

  let v : K ⟶ (Pi.mapHomologicalComplex (ComplexShape.up ℤ)).obj J :=
    (NatTrans.mapHomologicalComplex Di.adj.unit (ComplexShape.up ℤ)).app K ≫
      (Pi.mapHomologicalComplex (ComplexShape.up ℤ)).map j
  have hv : ∀ k, v.f k = Di.adj.unit.app (K.X k) ≫ Pi.map (j.f k) := fun k => rfl
  have hwv : w = (evW.mapHomologicalComplex (ComplexShape.up ℤ)).map v := by
    ext k x
    exact hw k x

  have hε : IsIso ((NatTrans.mapHomologicalComplex Di.adj.counit (ComplexShape.up ℤ)).app J) := by
    have : ∀ k, IsIso (((NatTrans.mapHomologicalComplex Di.adj.counit
        (ComplexShape.up ℤ)).app J).f k) :=
      fun k => wc_tq_closed_counit_iso i m Di hDi (J.X k)
    exact HomologicalComplex.Hom.isIso_of_components _
  have hΦvj : (Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map v ≫
      (NatTrans.mapHomologicalComplex Di.adj.counit (ComplexShape.up ℤ)).app J = j := by
    refine HomologicalComplex.hom_ext _ _ (fun k => ?_)
    show Di.Φ.map (Di.adj.unit.app (K.X k) ≫ Pi.map (j.f k)) ≫ Di.adj.counit.app (J.X k) = j.f k
    rw [Functor.map_comp, Category.assoc]
    rw [show Di.Φ.map (Pi.map (j.f k)) ≫ Di.adj.counit.app (J.X k) =
      Di.adj.counit.app _ ≫ j.f k from Di.adj.counit_naturality (j.f k)]
    exact Di.adj.left_triangle_components_assoc _ _
  have hΦv : QuasiIso ((Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map v) := by
    have h1 : QuasiIso ((Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).map v ≫
        (NatTrans.mapHomologicalComplex Di.adj.counit (ComplexShape.up ℤ)).app J) := by
      rw [hΦvj]
      exact hj
    haveI := quasiIso_of_isIso
      ((NatTrans.mapHomologicalComplex Di.adj.counit (ComplexShape.up ℤ)).app J)
    exact (quasiIso_iff_comp_right _ _).mp h1
  have hC : ∀ q, Limits.IsZero (Di.Φ.obj ((CochainComplex.mappingCone v).homology q)) := by
    intro q
    have h1 := (wc_tq_quasiIso_iff_cone_exact _).mp hΦv q
    have h2 : ((Di.Φ.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        (CochainComplex.mappingCone v)).ExactAt q :=
      h1.of_iso (CochainComplex.mappingCone.mapHomologicalComplexIso v Di.Φ).symm
    have h3 : (((CochainComplex.mappingCone v).sc q).map Di.Φ).Exact := h2
    rw [ShortComplex.exact_iff_isZero_homology] at h3
    exact Limits.IsZero.of_iso h3 (ShortComplex.mapHomologyIso _ Di.Φ).symm

  obtain ⟨Q, e, he⟩ := wc_tq_zmod_free_corep S m W
  have hExt : letI := HasExt.standard (SheafOfModules.{u+1} (wcZModRingSheaf S m))
      ∀ (p : ℕ) (q : ℤ),
        Subsingleton (Abelian.Ext Q ((CochainComplex.mappingCone v).homology q) p) := by
    intro p q
    obtain ⟨H, hHm, hH⟩ :=
      wc_tq_cone_classical i g m hm Dg hDg Di hDi I J m₀ hJ hJi j hj v hv q
    have hsupp := wc_tq_support_of_closed_pull_zero i m hm Di hDi _ H hH (hC q)
    exact wc_tq_gabber_module_ext_vanish i W R 𝔞 πW cW hsq m hm Q e he _ H hHm hsupp hH p

  have hCinj : ∀ n, Injective ((CochainComplex.mappingCone v).X n) := by
    intro n
    haveI hK : Injective (K.X (n + 1)) := Adjunction.map_injective Dg.adj _ inferInstance
    haveI hPJ : Injective (((Pi.mapHomologicalComplex (ComplexShape.up ℤ)).obj J).X n) :=
      Adjunction.map_injective Di.adj _ (hJi n)
    exact Injective.of_iso
      (HomologicalComplex.homotopyCofiber.XIsoBiprod v n (n + 1) rfl).symm inferInstance
  have hCge : (CochainComplex.mappingCone v).IsStrictlyGE (min m₀ 0 - 1) := by
    rw [CochainComplex.isStrictlyGE_iff]
    intro n hn
    have h1 := min_le_left m₀ 0
    have h2 := min_le_right m₀ 0
    refine Limits.IsZero.of_iso ?_ (HomologicalComplex.homotopyCofiber.XIsoBiprod v n (n + 1) rfl)
    rw [Limits.biprod_isZero_iff]
    constructor
    · exact P.map_isZero ((CochainComplex.isStrictlyGE_iff I.cochainComplex 0).mp inferInstance
        (n + 1) (by omega))
    · exact Pi.map_isZero ((CochainComplex.isStrictlyGE_iff J m₀).mp hJ n (by omega))

  have he0 : ∀ N, e N 0 = 0 := by
    intro N
    have h := he N N 0 0
    rw [Limits.comp_zero] at h
    rw [h, Functor.map_zero]
    rfl
  have hev : ∀ q, ((evW.mapHomologicalComplex (ComplexShape.up ℤ)).obj
      (CochainComplex.mappingCone v)).ExactAt q := by
    intro q
    rw [HomologicalComplex.exactAt_iff' _ (q - 1) q (q + 1) (by simp) (by simp),
      ShortComplex.ab_exact_iff]
    intro x hx
    obtain ⟨c, hcx⟩ : ∃ c, e _ c = x := ⟨(e _).symm x, Equiv.apply_symm_apply _ _⟩
    have hc : c ≫ (CochainComplex.mappingCone v).d q (q + 1) = 0 := by
      apply (e _).injective
      rw [he, hcx, he0]
      exact hx
    obtain ⟨e', he'⟩ := wc_tq_inj_complex_cocycle_exact_int Q _ _ hCge hCinj hExt q c hc
    refine ⟨e _ e', ?_⟩
    change ((wcZModSecEv S m W).map ((CochainComplex.mappingCone v).d (q - 1) q)).hom
      (e _ e') = x
    rw [← he, he', hcx]

  rw [hwv]
  refine (wc_tq_quasiIso_iff_cone_exact _).mpr (fun q => ?_)
  exact (hev q).of_iso (CochainComplex.mappingCone.mapHomologicalComplexIso v evW)

theorem wc_ltp_zmod_one {S Z E : Scheme.{u}} (i : Z ⟶ S) (g : E ⟶ S) (W : S.ProEt)
    (hi : (wcProEtBC i).IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology Z))
    (hg : (wcProEtBC g).IsContinuous (Scheme.ProEt.topology S) (Scheme.ProEt.topology E)) :
    wcAbPBCAt i g W hi hg (wcContSheaf E (ZMod 1)) :=
by
  classical

  have hM : Limits.IsZero (wcContSheaf E (ZMod 1)) := by
    apply Limits.IsZero.of_full_of_faithful_of_isZero
      (sheafToPresheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1})
    apply Functor.isZero
    intro V
    have hs : Subsingleton (((sheafToPresheaf (Scheme.ProEt.topology E) AddCommGrpCat.{u+1}).obj
        (wcContSheaf E (ZMod 1))).obj V) := by
      first
        | (constructor
           intro x y
           apply ULift.ext
           apply ContinuousMap.ext
           intro z
           exact Subsingleton.elim _ _)
        | (dsimp [wcContSheaf]; infer_instance)
    exact AddCommGrpCat.isZero_of_subsingleton _
  unfold wcAbPBCAt
  intro Pg Pi Li adj I K J m₀ hJ hJi j hj w _hw
  haveI : Pg.Additive := by
    first
      | exact ⟨fun {_ _ _ _} => rfl⟩
      | (haveI := ((wcProEtBC g).sheafAdjunctionContinuous AddCommGrpCat.{u+1}
          (Scheme.ProEt.topology S) (Scheme.ProEt.topology E)).rightAdjoint_preservesLimits
         exact Functor.additive_of_preserves_binary_products _)
  haveI : Pi.Additive := by
    first
      | exact ⟨fun {_ _ _ _} => rfl⟩
      | (haveI := adj.rightAdjoint_preservesLimits
         exact Functor.additive_of_preserves_binary_products _)
  haveI : Li.Additive := Adjunction.left_adjoint_additive adj

  have hIac : I.cochainComplex.Acyclic := by
    have hX : Limits.IsZero
        ((CochainComplex.singleFunctor _ 0).obj (wcContSheaf E (ZMod 1))) :=
      Functor.map_isZero _ hM
    have hXac := HomologicalComplex.acyclic_of_isZero _ hX
    rw [HomologicalComplex.acyclic_iff]
    intro n
    have hq : QuasiIsoAt I.ι' n := (quasiIso_iff I.ι').mp (inferInstance : QuasiIso I.ι') n
    exact (quasiIsoAt_iff_exactAt I.ι' n
      ((HomologicalComplex.acyclic_iff _).mp hXac n)).mp hq

  haveI := CochainComplex.isKInjective_of_injective I.cochainComplex 0
  obtain ⟨hI0⟩ := CochainComplex.IsKInjective.nonempty_homotopy_zero (𝟙 I.cochainComplex) hIac

  have hK0 : Homotopy (𝟙 K) 0 :=
    (Homotopy.ofEq (CategoryTheory.Functor.map_id _ _).symm).trans
      ((Pg.mapHomotopy hI0).trans (Homotopy.ofEq (CategoryTheory.Functor.map_zero _ _ _)))
  have hLK0 : Homotopy (𝟙 ((Li.mapHomologicalComplex (ComplexShape.up ℤ)).obj K)) 0 :=
    (Homotopy.ofEq (CategoryTheory.Functor.map_id _ _).symm).trans
      ((Li.mapHomotopy hK0).trans (Homotopy.ofEq (CategoryTheory.Functor.map_zero _ _ _)))
  have hEK0 : Homotopy (𝟙 (((sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
            (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op W)).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj K)) 0 :=
    (Homotopy.ofEq (CategoryTheory.Functor.map_id _ _).symm).trans
      (((sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
            (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op W)).mapHomotopy hK0).trans
        (Homotopy.ofEq (CategoryTheory.Functor.map_zero _ _ _)))

  have hLKac : ∀ n, ((Li.mapHomologicalComplex (ComplexShape.up ℤ)).obj K).ExactAt n := by
    intro n
    have e := hLK0.homologyMap_eq n
    rw [HomologicalComplex.homologyMap_id, HomologicalComplex.homologyMap_zero] at e
    exact (HomologicalComplex.exactAt_iff_isZero_homology _ n).mpr
      ((Limits.IsZero.iff_id_eq_zero _).mpr e)
  have hEKac : ∀ n, (((sheafToPresheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1} ⋙
            (evaluation S.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op W)).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj K).ExactAt n := by
    intro n
    have e := hEK0.homologyMap_eq n
    rw [HomologicalComplex.homologyMap_id, HomologicalComplex.homologyMap_zero] at e
    exact (HomologicalComplex.exactAt_iff_isZero_homology _ n).mpr
      ((Limits.IsZero.iff_id_eq_zero _).mpr e)

  have hJac : J.Acyclic := by
    rw [HomologicalComplex.acyclic_iff]
    intro n
    exact (quasiIsoAt_iff_exactAt j n (hLKac n)).mp ((quasiIso_iff j).mp hj n)

  haveI := hJ
  haveI := hJi
  haveI := CochainComplex.isKInjective_of_injective J m₀
  obtain ⟨hJ0⟩ := CochainComplex.IsKInjective.nonempty_homotopy_zero (𝟙 J) hJac
  have hEJ0 : Homotopy (𝟙 (((sheafToPresheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1} ⋙
            (evaluation Z.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj
              (Opposite.op ((wcProEtBC i).obj W))).mapHomologicalComplex
                (ComplexShape.up ℤ)).obj J)) 0 :=
    (Homotopy.ofEq (CategoryTheory.Functor.map_id _ _).symm).trans
      (((sheafToPresheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1} ⋙
            (evaluation Z.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj
              (Opposite.op ((wcProEtBC i).obj W))).mapHomotopy hJ0).trans
        (Homotopy.ofEq (CategoryTheory.Functor.map_zero _ _ _)))
  have hEJac : ∀ n, (((sheafToPresheaf (Scheme.ProEt.topology Z) AddCommGrpCat.{u+1} ⋙
            (evaluation Z.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj
              (Opposite.op ((wcProEtBC i).obj W))).mapHomologicalComplex
                (ComplexShape.up ℤ)).obj J).ExactAt n := by
    intro n
    have e := hEJ0.homologyMap_eq n
    rw [HomologicalComplex.homologyMap_id, HomologicalComplex.homologyMap_zero] at e
    exact (HomologicalComplex.exactAt_iff_isZero_homology _ n).mpr
      ((Limits.IsZero.iff_id_eq_zero _).mpr e)

  rw [quasiIso_iff]
  intro n
  exact (quasiIsoAt_iff_exactAt w n (hEKac n)).mpr (hEJac n)

theorem wc_ltp_azm_mate_iso {C D : Type (u+1)} [Category.{u} C] [Category.{u} D]
    (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    [HasSheafify K AddCommGrpCat.{u+1}] [K.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    (F : C ⥤ D) [F.IsContinuous J K]
    [(F.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).IsRightAdjoint]
    (R : Sheaf J RingCat.{u+1}) (R' : Sheaf K RingCat.{u+1})
    (φ : R ⟶ (F.sheafPushforwardContinuous RingCat.{u+1} J K).obj R')
    (Φ : SheafOfModules.{u+1} R ⥤ SheafOfModules.{u+1} R')
    (adj : Φ ⊣ SheafOfModules.pushforward.{u+1} φ)
    [(SheafOfModules.toSheaf.{u+1} R).Full] [(SheafOfModules.toSheaf.{u+1} R').Full]
    (n : ℕ) (hR : ∀ V, ((n : ℕ) : ↑(R.obj.obj V)) = 0)
    (hess : ∀ G : Sheaf K AddCommGrpCat.{u+1}, n • 𝟙 G = 0 →
      (SheafOfModules.toSheaf.{u+1} R').essImage G) :
    ∃ c : SheafOfModules.toSheaf.{u+1} R ⋙ F.sheafPullback AddCommGrpCat.{u+1} J K ⟶
        Φ ⋙ SheafOfModules.toSheaf.{u+1} R',
      (∀ N, IsIso (c.app N)) ∧
      ∀ N, (SheafOfModules.toSheaf.{u+1} R).map (adj.unit.app N) =
        (F.sheafAdjunctionContinuous AddCommGrpCat.{u+1} J K).unit.app
            ((SheafOfModules.toSheaf.{u+1} R).obj N) ≫
          (F.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K).map (c.app N) :=
by
  classical
  let T := SheafOfModules.toSheaf.{u+1} R
  let T' := SheafOfModules.toSheaf.{u+1} R'
  let P := SheafOfModules.pushforward.{u+1} φ
  let Pi := F.sheafPushforwardContinuous AddCommGrpCat.{u+1} J K
  let Li := F.sheafPullback AddCommGrpCat.{u+1} J K
  let adjAb := F.sheafAdjunctionContinuous AddCommGrpCat.{u+1} J K
  have hPiAdd : Pi.Additive := ⟨fun {_ _ _ _} => rfl⟩
  have hLiAdd : Li.Additive := Adjunction.left_adjoint_additive adjAb
  let uu : ∀ N, T.obj N ⟶ Pi.obj (T'.obj (Φ.obj N)) := fun N => T.map (adj.unit.app N)
  let cc : ∀ N, Li.obj (T.obj N) ⟶ T'.obj (Φ.obj N) := fun N =>
    (adjAb.homEquiv (T.obj N) (T'.obj (Φ.obj N))).symm (uu N)
  have hU : ∀ (N : SheafOfModules.{u+1} R) (G : SheafOfModules.{u+1} R') (h : Φ.obj N ⟶ G),
      T.map (adj.homEquiv N G h) = uu N ≫ Pi.map (T'.map h) := by
    intro N G h
    rw [adj.homEquiv_unit, T.map_comp]
    rfl
  have hβ : ∀ (N : SheafOfModules.{u+1} R) (G : SheafOfModules.{u+1} R') (h : Φ.obj N ⟶ G),
      cc N ≫ T'.map h = (adjAb.homEquiv (T.obj N) (T'.obj G)).symm
        (uu N ≫ Pi.map (T'.map h)) := by
    intro N G h
    exact (adjAb.homEquiv_naturality_right_symm (uu N) (T'.map h)).symm
  have hnat : ∀ ⦃N N' : SheafOfModules.{u+1} R⦄ (f : N ⟶ N'),
      (T ⋙ Li).map f ≫ cc N' = cc N ≫ (Φ ⋙ T').map f := by
    intro N N' f
    show Li.map (T.map f) ≫ cc N' = cc N ≫ T'.map (Φ.map f)
    have e1 : Li.map (T.map f) ≫ cc N' = (adjAb.homEquiv (T.obj N) (T'.obj (Φ.obj N'))).symm
        (T.map f ≫ uu N') :=
      (adjAb.homEquiv_naturality_left_symm (T.map f) (uu N')).symm
    have e2 : T.map f ≫ uu N' = uu N ≫ Pi.map (T'.map (Φ.map f)) := by
      have := congrArg (fun k => T.map k) (adj.unit_naturality f)
      simp only [Functor.map_comp] at this
      exact this.symm
    rw [e1, e2]
    exact (hβ N (Φ.obj N') (Φ.map f)).symm
  let c : T ⋙ Li ⟶ Φ ⋙ T' := { app := cc, naturality := hnat }
  have hTN : ∀ N : SheafOfModules.{u+1} R, n • 𝟙 (T.obj N) = 0 := by
    intro N
    apply (sheafToPresheaf J AddCommGrpCat.{u+1}).map_injective
    rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id,
      CategoryTheory.Functor.map_zero]
    ext X m
    have key : ∀ m' : (N.val.obj X : Type _), n • m' = 0 := fun m' => by
      rw [← Nat.cast_smul_eq_nsmul (R.obj.obj X) n m', hR X, zero_smul]
    simp only [NatTrans.app_nsmul, NatTrans.id_app, NatTrans.app_zero, AddCommGrpCat.hom_nsmul,
      AddCommGrpCat.hom_id, AddCommGrpCat.hom_zero, AddMonoidHom.nsmul_apply,
      AddMonoidHom.id_apply, AddMonoidHom.zero_apply]
    exact key m
  have hLTN : ∀ N, n • 𝟙 (Li.obj (T.obj N)) = 0 := by
    intro N
    rw [← Li.map_id, ← Functor.map_nsmul, hTN N, Functor.map_zero]
  have hsurj : ∀ (N : SheafOfModules.{u+1} R) (G : SheafOfModules.{u+1} R')
      (g : Li.obj (T.obj N) ⟶ T'.obj G), ∃ h : Φ.obj N ⟶ G, cc N ≫ T'.map h = g := by
    intro N G g
    let x : T.obj N ⟶ T.obj (P.obj G) := adjAb.homEquiv (T.obj N) (T'.obj G) g
    refine ⟨(adj.homEquiv N G).symm (T.preimage x), ?_⟩
    rw [hβ, ← hU, Equiv.apply_symm_apply, Functor.map_preimage]
    exact Equiv.symm_apply_apply _ _
  have hinj : ∀ (N : SheafOfModules.{u+1} R) (G : SheafOfModules.{u+1} R')
      (f₁ f₂ : T'.obj (Φ.obj N) ⟶ T'.obj G), cc N ≫ f₁ = cc N ≫ f₂ → f₁ = f₂ := by
    intro N G f₁ f₂ hf
    obtain ⟨h₁, rfl⟩ := T'.map_surjective f₁
    obtain ⟨h₂, rfl⟩ := T'.map_surjective f₂
    rw [hβ, hβ, ← hU, ← hU] at hf
    have h1 := (adjAb.homEquiv _ _).symm.injective hf
    have h2 := T.map_injective h1
    rw [(adj.homEquiv _ _).injective h2]
  have hiso : ∀ N, IsIso (cc N) := by
    intro N
    obtain ⟨N', ⟨e⟩⟩ := hess _ (hLTN N)
    obtain ⟨h, hh⟩ := hsurj N N' e.inv
    have h1 : cc N ≫ T'.map h ≫ e.hom = 𝟙 _ := by
      rw [← Category.assoc, hh, e.inv_hom_id]
    refine ⟨⟨T'.map h ≫ e.hom, h1, ?_⟩⟩
    apply hinj N (Φ.obj N)
    rw [← Category.assoc, h1, Category.id_comp, Category.comp_id]
  refine ⟨c, hiso, fun N => ?_⟩
  have h1 : adjAb.homEquiv (T.obj N) (T'.obj (Φ.obj N)) (cc N) = uu N :=
    Equiv.apply_symm_apply _ _
  rw [adjAb.homEquiv_unit] at h1
  exact h1.symm

theorem wc_ltp_azm_free_nsmul_mono (Y : Scheme.{u}) (V : Y.ProEt) (n : ℕ) (hn : 0 < n) :
    Mono (n • 𝟙 (wcFreeSheaf Y V)) :=
by
  classical
  let G : Y.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
  have tf : ∀ (X : Type (u+1)) (a b : FreeAbelianGroup X), n • a = n • b → a = b := by
    intro X a b hab
    apply (FreeAbelianGroup.equivFinsupp X).injective
    ext x
    have hx := congrArg (fun z => FreeAbelianGroup.equivFinsupp X z x) hab
    simp only [map_nsmul, Finsupp.smul_apply, nsmul_eq_mul] at hx
    exact Int.eq_of_mul_eq_mul_left (by exact_mod_cast hn.ne') hx
  have hmono : Mono (n • 𝟙 G) := by
    have : ∀ W, Mono ((n • 𝟙 G).app W) := by
      intro W
      rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.mono_iff_injective]
      intro a b hab
      simp only [AddCommGrpCat.hom_nsmul, AddCommGrpCat.hom_id, AddMonoidHom.nsmul_apply,
        AddMonoidHom.id_apply] at hab
      exact tf _ a b hab
    exact NatTrans.mono_of_mono_app _
  have := Functor.map_mono (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1})
    (n • 𝟙 G)
  rw [CategoryTheory.Functor.map_nsmul, CategoryTheory.Functor.map_id] at this
  exact this

theorem wc_ltp_azm_torsion_inj_ext_vanish {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    [HasExt (Sheaf J AddCommGrpCat.{u+1})] [EnoughInjectives (Sheaf J AddCommGrpCat.{u+1})]
    (R : Sheaf J RingCat.{u+1}) [(SheafOfModules.toSheaf.{u+1} R).Full] (n : ℕ) (hn : 0 < n)
    (hR : ∀ V, ((n : ℕ) : ↑(R.obj.obj V)) = 0)
    (hess : ∀ G : Sheaf J AddCommGrpCat.{u+1}, n • 𝟙 G = 0 →
      (SheafOfModules.toSheaf.{u+1} R).essImage G)
    (I : SheafOfModules.{u+1} R) [Injective I] (X : Sheaf J AddCommGrpCat.{u+1})
    (hX : Mono (n • 𝟙 X)) (k : ℕ)
    (e : Abelian.Ext X ((SheafOfModules.toSheaf.{u+1} R).obj I) (k + 1)) : e = 0 :=
by
  classical
  let T := SheafOfModules.toSheaf.{u+1} R

  have s4 : ∀ M : SheafOfModules.{u+1} R, n • 𝟙 (T.obj M) = 0 := by
    intro M
    apply Sheaf.hom_ext
    ext V x
    have key : ∀ y : M.val.obj V, n • y = 0 := fun y => by
      rw [← Nat.cast_smul_eq_nsmul (R.obj.obj V), hR V, zero_smul]
    exact key x

  have s2 : ∀ (E : Sheaf J AddCommGrpCat.{u+1}) [Injective E], Epi (n • 𝟙 E) := by
    intro E _
    let P := (sheafToPresheaf J AddCommGrpCat.{u+1}).obj E
    have hP : Injective P :=
      Adjunction.map_injective (sheafificationAdjunction J _) E inferInstance
    have hfree : ∀ (α : Type (u+1)),
        Function.Injective (fun x : FreeAbelianGroup α => n • x) := by
      intro α a b hab
      apply (FreeAbelianGroup.equivFinsupp α).injective
      have := congrArg (FreeAbelianGroup.equivFinsupp α) hab
      simp only [map_nsmul] at this
      ext i
      have h2 := congrArg (fun f => f i) this
      simp only [Finsupp.smul_apply, nsmul_eq_mul] at h2
      have hn' : (n : ℤ) ≠ 0 := by exact_mod_cast hn.ne'
      exact mul_left_cancel₀ hn' h2
    have hdiv : ∀ (U : Cᵒᵖ) (s : P.obj U), ∃ t : P.obj U, n • t = s := by
      intro U s
      let F : Cᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
        yoneda.obj U.unop ⋙ uliftFunctor.{u+1} ⋙ AddCommGrpCat.free
      have key : ∀ (V W : Cᵒᵖ) (g : V ⟶ W) (a : ULift.{u+1} (V.unop ⟶ U.unop)),
          (FreeAbelianGroup.lift
              (fun a : ULift.{u+1} (W.unop ⟶ U.unop) => (P.map a.down.op).hom s))
            (FreeAbelianGroup.map (fun x : ULift.{u+1} (V.unop ⟶ U.unop) =>
              (ULift.up (g.unop ≫ x.down) : ULift.{u+1} (W.unop ⟶ U.unop)))
                (FreeAbelianGroup.of a))
          = (P.map g).hom ((FreeAbelianGroup.lift
              (fun a : ULift.{u+1} (V.unop ⟶ U.unop) => (P.map a.down.op).hom s))
                (FreeAbelianGroup.of a)) := by
        intro V W g a
        rw [FreeAbelianGroup.map_of_apply, FreeAbelianGroup.lift_apply_of,
          FreeAbelianGroup.lift_apply_of]
        dsimp only
        rw [op_comp, Quiver.Hom.op_unop, Functor.map_comp, AddCommGrpCat.hom_comp]
        rfl
      let σ : F ⟶ P :=
        { app := fun V => AddCommGrpCat.ofHom
            (FreeAbelianGroup.lift
              (fun a : ULift.{u+1} (V.unop ⟶ U.unop) => (P.map a.down.op).hom s))
          naturality := by
            intro V W g
            ext1
            apply FreeAbelianGroup.lift_ext
            intro a
            exact key V W g a }
      have : ∀ V, Mono ((n • 𝟙 F).app V) := by
        intro V
        rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.mono_iff_injective]
        exact hfree _
      have : Mono (n • 𝟙 F) := NatTrans.mono_of_mono_app _
      let τ := Injective.factorThru σ (n • 𝟙 F)
      have hτ : (n • 𝟙 F) ≫ τ = σ := Injective.comp_factorThru _ _
      rw [Preadditive.nsmul_comp, Category.id_comp] at hτ
      let g0 : F.obj U :=
        FreeAbelianGroup.of (ULift.up (𝟙 U.unop) : ULift.{u+1} (U.unop ⟶ U.unop))
      refine ⟨(τ.app U).hom g0, ?_⟩
      have h1 : ((n • τ).app U).hom g0 = (σ.app U).hom g0 := by rw [hτ]
      rw [NatTrans.app_nsmul, AddCommGrpCat.hom_nsmul] at h1
      change n • (τ.app U).hom g0 = _ at h1
      rw [h1]
      have h2 : (FreeAbelianGroup.lift
          (fun a : ULift.{u+1} (U.unop ⟶ U.unop) => (P.map a.down.op).hom s))
          (FreeAbelianGroup.of (ULift.up (𝟙 U.unop))) = s := by
        rw [FreeAbelianGroup.lift_apply_of]
        simp
      exact h2
    have hmap : (sheafToPresheaf J AddCommGrpCat.{u+1}).map (n • 𝟙 E) = n • 𝟙 P := by
      rw [Functor.map_nsmul, CategoryTheory.Functor.map_id]
    have : ∀ U, Epi ((n • 𝟙 P).app U) := by
      intro U
      rw [NatTrans.app_nsmul, NatTrans.id_app, AddCommGrpCat.epi_iff_surjective]
      intro s
      obtain ⟨t, ht⟩ := hdiv U s
      exact ⟨t, by simpa using ht⟩
    have : Epi (n • 𝟙 P) := NatTrans.epi_of_epi_app _
    apply (sheafToPresheaf J AddCommGrpCat.{u+1}).epi_of_epi_map
    rw [hmap]
    infer_instance

  have s3 : ∀ (E : Sheaf J AddCommGrpCat.{u+1}) [Injective E], Epi (n • 𝟙 E) →
      ∀ (e : Abelian.Ext X (Limits.kernel (n • 𝟙 E)) (k + 1)), e = 0 := by
    intro E _ hE e
    let S := ShortComplex.mk (Limits.kernel.ι (n • 𝟙 E)) (n • 𝟙 E) (Limits.kernel.condition _)
    have hS : S.ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel _) inferInstance hE
    have h0 : e.comp (Abelian.Ext.mk₀ S.f) (add_zero _) = 0 :=
      Abelian.Ext.eq_zero_of_injective _
    obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS e h0 rfl
    rw [← hx₃]
    cases k with
    | succ k' =>
      rw [Abelian.Ext.eq_zero_of_injective x₃, Abelian.Ext.zero_comp]
    | zero =>
      set h := Abelian.Ext.homEquiv₀ x₃ with hh
      have hx : x₃ = Abelian.Ext.mk₀ h := by rw [hh, Abelian.Ext.mk₀_homEquiv₀_apply]
      have : Mono (n • 𝟙 X) := hX
      let g' := Injective.factorThru h (n • 𝟙 X)
      have hg' : (n • 𝟙 X) ≫ g' = h := Injective.comp_factorThru _ _
      have hh2 : h = g' ≫ S.g := by
        rw [← hg']
        simp only [S, Preadditive.nsmul_comp, Preadditive.comp_nsmul, Category.id_comp,
          Category.comp_id]
      rw [hx, hh2, ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.comp_assoc_of_second_deg_zero,
        hS.comp_extClass, Abelian.Ext.comp_zero]

  let E := Injective.under (T.obj I)
  let ι : T.obj I ⟶ E := Injective.ι (T.obj I)
  have hι : ι ≫ (n • 𝟙 E) = 0 := by
    have h1 : ι ≫ (n • 𝟙 E) = (n • 𝟙 (T.obj I)) ≫ ι := by
      rw [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
    rw [h1, s4 I, Limits.zero_comp]
  let i : T.obj I ⟶ Limits.kernel (n • 𝟙 E) := Limits.kernel.lift (n • 𝟙 E) ι hι
  have hi : i ≫ Limits.kernel.ι _ = ι := Limits.kernel.lift_ι _ _ _
  have : Mono i := mono_of_mono_fac hi
  have hK : n • 𝟙 (Limits.kernel (n • 𝟙 E)) = 0 := by
    rw [← cancel_mono (Limits.kernel.ι (n • 𝟙 E)), Limits.zero_comp]
    have h1 : (n • 𝟙 (Limits.kernel (n • 𝟙 E))) ≫ Limits.kernel.ι (n • 𝟙 E) =
        Limits.kernel.ι (n • 𝟙 E) ≫ (n • 𝟙 E) := by
      rw [Preadditive.comp_nsmul, Preadditive.nsmul_comp, Category.comp_id, Category.id_comp]
    rw [h1, Limits.kernel.condition]
  have hM := hess _ hK
  let M := hM.witness
  let φ : T.obj M ≅ Limits.kernel (n • 𝟙 E) := hM.getIso
  let f : I ⟶ M := T.preimage (i ≫ φ.inv)
  have hf : T.map f = i ≫ φ.inv := T.map_preimage _
  have : Mono (T.map f) := by rw [hf]; infer_instance
  have : Mono f := T.mono_of_mono_map this
  let ρ := Injective.factorThru (𝟙 I) f
  have hρ : f ≫ ρ = 𝟙 I := Injective.comp_factorThru _ _
  let r : Limits.kernel (n • 𝟙 E) ⟶ T.obj I := φ.inv ≫ T.map ρ
  have hir : i ≫ r = 𝟙 _ := by
    change i ≫ φ.inv ≫ T.map ρ = _
    rw [← Category.assoc, ← hf, ← T.map_comp, hρ, T.map_id]

  have e0 : e.comp (Abelian.Ext.mk₀ i) (add_zero _) = 0 := s3 E (s2 E) _
  calc e = e.comp (Abelian.Ext.mk₀ (𝟙 _)) (add_zero _) := (Abelian.Ext.comp_mk₀_id e).symm
    _ = e.comp (Abelian.Ext.mk₀ (i ≫ r)) (add_zero _) := by rw [hir]
    _ = (e.comp (Abelian.Ext.mk₀ i) (add_zero _)).comp (Abelian.Ext.mk₀ r) (add_zero _) := by
        rw [← Abelian.Ext.mk₀_comp_mk₀]
        exact (Abelian.Ext.comp_assoc _ _ _ (add_zero _) (add_zero _) (by omega)).symm
    _ = 0 := by rw [e0, Abelian.Ext.zero_comp]

theorem wc_ltp_azm_free_corep (Y : Scheme.{u}) (V : Y.ProEt) :
    Nonempty (preadditiveCoyoneda.obj (Opposite.op (wcFreeSheaf Y V)) ≅
      sheafToPresheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1} ⋙
        (evaluation Y.ProEtᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op V)) :=
by
  classical
  let P : Y.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1} :=
    yoneda.obj V ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free
  let e : P.obj (Opposite.op V) :=
    (FreeAbelianGroup.of (ULift.up (𝟙 V)) : FreeAbelianGroup (ULift.{u+1} (V ⟶ V)))
  have hmap : ∀ (U U' : Y.ProEtᵒᵖ) (h : U ⟶ U') (f : ULift.{u+1} (Opposite.unop U ⟶ V)),
      (P.map h).hom (FreeAbelianGroup.of f : FreeAbelianGroup (ULift.{u+1} (Opposite.unop U ⟶ V))) =
        (FreeAbelianGroup.of (ULift.up (h.unop ≫ f.down)) :
          FreeAbelianGroup (ULift.{u+1} (Opposite.unop U' ⟶ V))) := by
    intro U U' h f
    simp [P]
    rfl
  let lam : ∀ (G : Y.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}) (x : G.obj (Opposite.op V)) (U : Y.ProEtᵒᵖ),
      FreeAbelianGroup (ULift.{u+1} (Opposite.unop U ⟶ V)) →+ G.obj U := fun G x U =>
    FreeAbelianGroup.lift (fun f : ULift.{u+1} (Opposite.unop U ⟶ V) => (G.map f.down.op).hom x)
  have hlam : ∀ (G : Y.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}) (x : G.obj (Opposite.op V))
      (U : Y.ProEtᵒᵖ) (f : ULift.{u+1} (Opposite.unop U ⟶ V)),
      lam G x U (FreeAbelianGroup.of f) = (G.map f.down.op).hom x := by
    intro G x U f
    exact FreeAbelianGroup.lift_apply_of _ _
  have hnat : ∀ (G : Y.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}) (x : G.obj (Opposite.op V))
      (U U' : Y.ProEtᵒᵖ) (h : U ⟶ U') (f : ULift.{u+1} (Opposite.unop U ⟶ V)),
      lam G x U' ((P.map h).hom
          (FreeAbelianGroup.of f : FreeAbelianGroup (ULift.{u+1} (Opposite.unop U ⟶ V)))) =
        (G.map h).hom (lam G x U (FreeAbelianGroup.of f)) := by
    intro G x U U' h f
    rw [hmap, hlam, hlam, op_comp, Quiver.Hom.op_unop, G.map_comp, AddCommGrpCat.hom_comp,
      AddMonoidHom.coe_comp, Function.comp_apply]
  have hleft : ∀ (G : Y.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}) (τ : P ⟶ G)
      (U : Y.ProEtᵒᵖ) (f : ULift.{u+1} (Opposite.unop U ⟶ V)),
      lam G ((τ.app (Opposite.op V)).hom e) U (FreeAbelianGroup.of f) =
        (τ.app U).hom (FreeAbelianGroup.of f : FreeAbelianGroup (ULift.{u+1} (Opposite.unop U ⟶ V))) := by
    intro G τ U f
    rw [hlam]
    have h1 := congrArg (fun φ => φ.hom e) (τ.naturality f.down.op)
    simp only [AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp, Function.comp_apply] at h1
    rw [← h1]
    congr 1
  let ψ : ∀ G : Y.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}, (P ⟶ G) ≃+ G.obj (Opposite.op V) := fun G =>
    { toFun := fun τ => (τ.app (Opposite.op V)).hom e
      invFun := fun x =>
        { app := fun U => AddCommGrpCat.ofHom (lam G x U)
          naturality := by
            intro U U' h
            apply AddCommGrpCat.hom_ext
            apply FreeAbelianGroup.lift_ext
            intro f
            exact hnat G x U U' h f }
      left_inv := by
        intro τ
        ext U : 2
        apply AddCommGrpCat.hom_ext
        apply FreeAbelianGroup.lift_ext
        intro f
        exact hleft G τ U f
      right_inv := by
        intro x
        change lam G x (Opposite.op V) (FreeAbelianGroup.of (ULift.up (𝟙 V))) = x
        rw [hlam]
        simp
      map_add' := by
        intro τ σ
        simp }
  let adj := sheafificationAdjunction (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}
  have hcomp : ∀ (F F' : Sheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}) (g : F ⟶ F')
      (f : (presheafToSheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj P ⟶ F),
      ψ _ (adj.homAddEquiv P F' (f ≫ g)) =
        (((sheafToPresheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).map g).app
          (Opposite.op V)).hom (ψ _ (adj.homAddEquiv P F f)) := by
    intro F F' g f
    rw [Adjunction.homAddEquiv_apply, Adjunction.homAddEquiv_apply,
      Adjunction.homEquiv_naturality_right]
    rfl
  refine ⟨NatIso.ofComponents (fun F =>
    ((adj.homAddEquiv P F).trans
      (ψ ((sheafToPresheaf (Scheme.ProEt.topology Y) AddCommGrpCat.{u+1}).obj F))).toAddCommGrpIso) ?_⟩
  intro F F' g
  apply AddCommGrpCat.hom_ext
  refine AddMonoidHom.ext (fun f => ?_)
  exact hcomp F F' g f

theorem wc_ltp_azm_coyoneda_qiso {C : Type*} [Category C] [Abelian C] [HasExt C] (X : C)
    {A B : CochainComplex C ℤ} (f : A ⟶ B) (hf : QuasiIso f) (d : ℤ)
    [A.IsStrictlyGE d] [B.IsStrictlyGE d]
    (hA : ∀ (k : ℤ) (n : ℕ) (e : Abelian.Ext X (A.X k) (n + 1)), e = 0)
    (hB : ∀ (k : ℤ) (n : ℕ) (e : Abelian.Ext X (B.X k) (n + 1)), e = 0) :
    QuasiIso (((preadditiveCoyoneda.obj (Opposite.op X)).mapHomologicalComplex
      (ComplexShape.up ℤ)).map f) :=
by

  have hQ : (CochainComplex.mappingCone f).Acyclic := by
    rw [← HomotopyCategory.quotient_obj_mem_subcategoryAcyclic_iff_acyclic]
    have h1 := (HomotopyCategory.quotient_map_mem_quasiIso_iff f).2
      ((HomologicalComplex.mem_quasiIso_iff f).2 hf)
    rw [HomotopyCategory.quasiIso_eq_trW_subcategoryAcyclic] at h1
    exact ((HomotopyCategory.subcategoryAcyclic C).trW_iff_of_distinguished _
      (HomotopyCategory.mappingCone_triangleh_distinguished f)).1 h1
  set Q := CochainComplex.mappingCone f with hQdef

  have hE : ∀ (k : ℤ) (n : ℕ) (e : Abelian.Ext X (Q.X k) (n + 1)), e = 0 := by
    intro k n e
    have key : ∀ {Y : C} (a : Q.X k ⟶ Y) (b : Y ⟶ Q.X k),
        (∀ x : Abelian.Ext X Y (n + 1), x = 0) →
        e.comp (Abelian.Ext.mk₀ (a ≫ b)) (add_zero _) = 0 := by
      intro Y a b hY
      rw [← Abelian.Ext.mk₀_comp_mk₀, ← Abelian.Ext.comp_assoc_of_third_deg_zero,
        hY (e.comp (Abelian.Ext.mk₀ a) (add_zero _)), Abelian.Ext.zero_comp]
    rw [← Abelian.Ext.comp_mk₀_id e, ← CochainComplex.mappingCone.id_X f k (k + 1) rfl,
      Abelian.Ext.mk₀_add, Abelian.Ext.comp_add, key _ _ (hA (k + 1) n), key _ _ (hB k n),
      add_zero]

  have hZero : ∀ {Y : C} (_ : Limits.IsZero Y) (m : ℕ) (x : Abelian.Ext X Y m), x = 0 := by
    intro Y hY m x
    rw [← Abelian.Ext.comp_mk₀_id x, hY.eq_of_tgt (𝟙 Y) 0, Abelian.Ext.mk₀_zero,
      Abelian.Ext.comp_zero]

  have hd : ∀ i < d - 1, Limits.IsZero (Q.X i) := fun i hi =>
    (CochainComplex.mappingCone.isZero_X_iff f i).2
      ⟨A.isZero_of_isStrictlyGE d (i + 1) (by omega), B.isZero_of_isStrictlyGE d i (by omega)⟩

  have hS : ∀ k : ℤ, ∃ hz : Q.iCycles k ≫ Q.toCycles k (k + 1) = 0,
      (ShortComplex.mk (Q.iCycles k) (Q.toCycles k (k + 1)) hz).ShortExact := by
    intro k
    have hz : Q.iCycles k ≫ Q.toCycles k (k + 1) = 0 := by
      rw [← cancel_mono (Q.iCycles (k + 1)), Category.assoc, HomologicalComplex.toCycles_i,
        HomologicalComplex.iCycles_d, Limits.zero_comp]
    refine ⟨hz, ?_⟩
    have hprev : (ComplexShape.up ℤ).prev (k + 1) = k := by
      rw [CochainComplex.prev]; omega
    have hnext : (ComplexShape.up ℤ).next (k + 1) = k + 2 := by
      rw [CochainComplex.next]; omega
    have hnext' : (ComplexShape.up ℤ).next k = k + 1 := CochainComplex.next ℤ k
    have h2 := (Q.exactAt_iff' k (k + 1) (k + 2) hprev hnext).1 (hQ (k + 1))
    have hepi : Epi (Q.toCycles k (k + 1)) := by
      have h4 : Epi (Q.toCycles k (k + 1) ≫
          (Q.cyclesIsoSc' k (k + 1) (k + 2) hprev hnext).hom) := by
        rw [HomologicalComplex.toCycles_cyclesIsoSc'_hom]
        exact h2.epi_toCycles
      have h5 := epi_comp (Q.toCycles k (k + 1) ≫
        (Q.cyclesIsoSc' k (k + 1) (k + 2) hprev hnext).hom)
        (Q.cyclesIsoSc' k (k + 1) (k + 2) hprev hnext).inv
      rwa [Category.assoc, Iso.hom_inv_id, Category.comp_id] at h5
    have hexact : (ShortComplex.mk (Q.iCycles k) (Q.toCycles k (k + 1)) hz).Exact := by
      apply ShortComplex.exact_of_f_is_kernel
      refine Limits.KernelFork.IsLimit.ofι _ _
        (fun g' eq' => Q.liftCycles g' (k + 1) hnext' (by
          rw [← HomologicalComplex.toCycles_i, ← Category.assoc]
          erw [eq']
          rw [Limits.zero_comp]))
        (fun g' eq' => HomologicalComplex.liftCycles_i _ _ _ _ _)
        (fun g' eq' m hm => by
          rw [← cancel_mono (Q.iCycles k), HomologicalComplex.liftCycles_i]
          exact hm)
    exact ShortComplex.ShortExact.mk' hexact inferInstance hepi

  have base : ∀ k < d - 1, ∀ (n : ℕ) (e : Abelian.Ext X (Q.cycles k) (n + 1)), e = 0 :=
    fun k hk n e => hZero (Limits.IsZero.of_mono (Q.iCycles k) (hd k hk)) _ e
  have step : ∀ k : ℤ, (∀ (n : ℕ) (e : Abelian.Ext X (Q.cycles k) (n + 1)), e = 0) →
      ∀ (n : ℕ) (e : Abelian.Ext X (Q.cycles (k + 1)) (n + 1)), e = 0 := by
    intro k hk n y
    obtain ⟨hz, hSk⟩ := hS k
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ X hSk y (n₁ := n + 1 + 1) rfl
      (hk (n + 1) _)
    rw [← hx₂, hE k n x₂, Abelian.Ext.zero_comp]
  have hall : ∀ m : ℕ, ∀ (n : ℕ) (e : Abelian.Ext X (Q.cycles (d - 2 + m)) (n + 1)), e = 0 := by
    intro m
    induction m with
    | zero =>
      have h0 : d - 2 + ((0 : ℕ) : ℤ) = d - 2 := by simp
      rw [h0]
      exact base (d - 2) (by omega)
    | succ m ih =>
      have h0 : d - 2 + ((m + 1 : ℕ) : ℤ) = d - 2 + (m : ℤ) + 1 := by push_cast; ring
      rw [h0]
      exact step _ ih
  have hZall : ∀ (k : ℤ) (n : ℕ) (e : Abelian.Ext X (Q.cycles k) (n + 1)), e = 0 := by
    intro k
    by_cases hk : k < d - 1
    · exact base k hk
    · obtain ⟨m, hm⟩ : ∃ m : ℕ, k = d - 2 + m := ⟨(k - d + 2).toNat, by omega⟩
      subst hm
      exact hall m

  set H := preadditiveCoyoneda.obj (Opposite.op X) with hH
  have h1 : ((H.mapHomologicalComplex (ComplexShape.up ℤ)).obj Q).Acyclic := by
    intro i
    obtain ⟨j, rfl⟩ : ∃ j, i = j + 1 := ⟨i - 1, by omega⟩
    have hprev : (ComplexShape.up ℤ).prev (j + 1) = j := by
      rw [CochainComplex.prev]; omega
    have hnext : (ComplexShape.up ℤ).next (j + 1) = j + 2 := by
      rw [CochainComplex.next]; omega
    rw [HomologicalComplex.exactAt_iff' _ j (j + 1) (j + 2) hprev hnext,
      ShortComplex.ab_exact_iff]
    intro φ hφ
    have hφ' : (φ : X ⟶ Q.X (j + 1)) ≫ Q.d (j + 1) (j + 2) = 0 := hφ
    let φ' := Q.liftCycles (φ : X ⟶ Q.X (j + 1)) (j + 2) hnext hφ'
    obtain ⟨hz, hSj⟩ := hS j
    obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ X hSj (Abelian.Ext.mk₀ φ')
      (n₁ := 1) (zero_add 1) (hZall j 0 _)
    refine ⟨Abelian.Ext.homEquiv₀ x₂, ?_⟩
    have e1 : Abelian.Ext.homEquiv₀ x₂ ≫ Q.toCycles j (j + 1) = φ' := by
      apply (Abelian.Ext.mk₀_bijective _ _).1
      rw [← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
      exact hx₂
    change Abelian.Ext.homEquiv₀ x₂ ≫ Q.d j (j + 1) = φ
    rw [← HomologicalComplex.toCycles_i, ← Category.assoc, e1]
    exact Q.liftCycles_i _ _ _ _

  have h2 : (CochainComplex.mappingCone
      ((H.mapHomologicalComplex (ComplexShape.up ℤ)).map f)).Acyclic := fun n =>
    (h1 n).of_iso (CochainComplex.mappingCone.mapHomologicalComplexIso f H)
  rw [← HomologicalComplex.mem_quasiIso_iff, ← HomotopyCategory.quotient_map_mem_quasiIso_iff,
    HomotopyCategory.quasiIso_eq_trW_subcategoryAcyclic]
  exact ((HomotopyCategory.subcategoryAcyclic _).trW_iff_of_distinguished _
    (HomotopyCategory.mappingCone_triangleh_distinguished _)).2
    ((HomotopyCategory.quotient_obj_mem_subcategoryAcyclic_iff_acyclic _).2 h2)

theorem wc_ltp_azm_lift_to_inj {C : Type*} [Category C] [Abelian C]
    {X X' L : CochainComplex C ℤ} (s : X ⟶ X') (hs : QuasiIso s) (g : X ⟶ L) (d : ℤ)
    (hL : L.IsStrictlyGE d) (hLi : ∀ n, Injective (L.X n)) :
    ∃ g' : X' ⟶ L, Nonempty (Homotopy (s ≫ g') g) ∧ (QuasiIso g → QuasiIso g') :=
by
  haveI := hL
  haveI := hLi
  haveI hK : L.IsKInjective := CochainComplex.isKInjective_of_injective L d
  have hR : (HomotopyCategory.subcategoryAcyclic C).rightOrthogonal
      ((HomotopyCategory.quotient C (ComplexShape.up ℤ)).obj L) :=
    CochainComplex.IsKInjective.rightOrthogonal L
  have hloc : (HomotopyCategory.subcategoryAcyclic C).trW.isLocal
      ((HomotopyCategory.quotient C (ComplexShape.up ℤ)).obj L) := by
    rw [ObjectProperty.isLocal_trW]; exact hR
  have h1 : HomotopyCategory.quasiIso C (ComplexShape.up ℤ)
      ((HomotopyCategory.quotient C (ComplexShape.up ℤ)).map s) :=
    (HomotopyCategory.quotient_map_mem_quasiIso_iff s).2
      ((HomologicalComplex.mem_quasiIso_iff s).2 hs)
  have hW : (HomotopyCategory.subcategoryAcyclic C).trW
      ((HomotopyCategory.quotient C (ComplexShape.up ℤ)).map s) := by
    rw [← HomotopyCategory.quasiIso_eq_trW_subcategoryAcyclic]; exact h1
  obtain ⟨h, hh⟩ := (((MorphismProperty.isLocal_iff _ _).1 hloc) _ hW).2
    ((HomotopyCategory.quotient C (ComplexShape.up ℤ)).map g)
  obtain ⟨g', hg'⟩ := (HomotopyCategory.quotient C (ComplexShape.up ℤ)).map_surjective h
  have heq : (HomotopyCategory.quotient C (ComplexShape.up ℤ)).map (s ≫ g') =
      (HomotopyCategory.quotient C (ComplexShape.up ℤ)).map g := by
    rw [Functor.map_comp, hg']; exact hh
  let H : Homotopy (s ≫ g') g := HomotopyCategory.homotopyOfEq _ _ heq
  refine ⟨g', ⟨H⟩, fun hg => ?_⟩
  haveI := hs
  haveI : QuasiIso (s ≫ g') := by
    rw [quasiIso_iff]
    intro k
    have h2 := (quasiIsoAt_iff_isIso_homologyMap _ k).mp ((quasiIso_iff _).mp hg k)
    rw [quasiIsoAt_iff_isIso_homologyMap, H.homologyMap_eq k]
    exact h2
  exact quasiIso_of_comp_left s g'

theorem wc_ltp_azm_qiso_of_sections {C : Type (u+1)} [Category.{u} C]
    (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{u+1}] [J.WEqualsLocallyBijective AddCommGrpCat.{u+1}]
    {A B : CochainComplex (Sheaf J AddCommGrpCat.{u+1}) ℤ} (f : A ⟶ B)
    (h : ∀ U : C, QuasiIso (((sheafToPresheaf J AddCommGrpCat.{u+1} ⋙
      (evaluation Cᵒᵖ AddCommGrpCat.{u+1}).obj (Opposite.op U)).mapHomologicalComplex
        (ComplexShape.up ℤ)).map f)) : QuasiIso f :=
by
  let P := sheafToPresheaf J AddCommGrpCat.{u+1}
  let L := presheafToSheaf J AddCommGrpCat.{u+1}
  let g := (P.mapHomologicalComplex (ComplexShape.up ℤ)).map f
  have s1 : ∀ U : C, QuasiIso ((((evaluation Cᵒᵖ AddCommGrpCat.{u+1}).obj
      (Opposite.op U)).mapHomologicalComplex (ComplexShape.up ℤ)).map g) := fun U => h U
