            (Scheme.ProEt.topology Z₀) (Scheme.ProEt.topology Y)).map D₁.φ) ≫
          (Functor.sheafPushforwardContinuousNatTrans α₀
            RingCat.{u+1} (Scheme.ProEt.topology Z₀) (Scheme.ProEt.topology X)).app
            (wcRingSheaf X ℓ) = D₁₂.φ := by
    intro X Y Z₀ g₁ g₂ g₁₂ h D₁ hD₁ D₂ hD₂ D₁₂ hD₁₂ α₀
    letI : MorphismProperty.HasPullbacksAlong (@WeaklyEtale : MorphismProperty Scheme.{u}) g₂ :=
