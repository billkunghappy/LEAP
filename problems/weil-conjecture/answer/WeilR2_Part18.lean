    (Scheme.Hom.comp_apply _ _ _).trans (hresG R _)
  have hq2 : (Spec.map (CommRingCat.ofHom ε) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) ≫ Spec.map (CommRingCat.ofHom ρ) =
      wcEtGeomPt (Spec (.of (wcQuadModelRing A (r + 2) π (wcQmtmC A r)))) y :=
    (Category.assoc _ _ _).trans hε

