          (wcConstSec Z (ULift.{u+1} (ZMod ℓ)) (wcEtTop Z) (ULift.up 1)) =
        (f₂.hom.app (Opposite.op (wcEtTop Z))).hom
          (wcConstSec Z (ULift.{u+1} (ZMod ℓ)) (wcEtTop Z) (ULift.up 1)) → f₁ = f₂ := by
