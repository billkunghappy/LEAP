  have ha : ∀ r, (Limits.pullback.fst V.hom T.πi ∣_ W).appTop.hom r ∈ S := by
    intro r
    refine (hS _).mpr ⟨0, fun φ hφ => ?_⟩
    obtain ⟨z, -, κ, h1, -, h3⟩ := (hΨ 0 φ).mp hφ
    have hφa : φ ≫ (Limits.pullback.fst V.hom T.πi ∣_ W) =
        (Limits.pullback.fst V.hom T.πi ∣_ W) := by
      rw [← cancel_mono W.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, h3,
        Category.assoc, h1]
    rw [← happ, hφa]

  have hb : ∀ r, ((Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).ι ≫ Limits.pullback.snd V.hom T.πi ≫
      T.gi).appTop.hom r ∈ S := by
    intro r
    obtain ⟨k, hk⟩ := s3 ((Scheme.ΓSpecIso
      (CommRingCat.of (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).hom.hom r)
    refine (hS _).mpr ⟨k, fun φ hφ => ?_⟩
    obtain ⟨z, hz, κ, -, h2, h3⟩ := (hΨ k φ).mp hφ
    have hφb : φ ≫ (Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).ι ≫
        Limits.pullback.snd V.hom T.πi ≫ T.gi =
        ((Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).ι ≫ Limits.pullback.snd V.hom T.πi ≫ T.gi) ≫
          Spec.map (CommRingCat.ofHom (R z)) := by
      rw [← Category.assoc φ, h3, Category.assoc, ← Category.assoc κ, h2, Category.assoc,
        hγg]
      simp only [Category.assoc]
    have hfix : (Spec.map (CommRingCat.ofHom (R z))).appTop.hom r = r := by
      have e1 : (Scheme.ΓSpecIso (CommRingCat.of (AddMonoidAlgebra L
            (Localization.Away (ℓ : ℤ))))).hom.hom
            ((Spec.map (CommRingCat.ofHom (R z))).appTop.hom r) =
          (Scheme.ΓSpecIso (CommRingCat.of (AddMonoidAlgebra L
            (Localization.Away (ℓ : ℤ))))).hom.hom r := by
        have h0 := congrArg (fun t => t.hom r)
          (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (R z)))
        refine h0.trans ?_
        exact hk z hz
      calc (Spec.map (CommRingCat.ofHom (R z))).appTop.hom r
          = ((Scheme.ΓSpecIso (CommRingCat.of (AddMonoidAlgebra L
              (Localization.Away (ℓ : ℤ))))).hom ≫ (Scheme.ΓSpecIso (CommRingCat.of
                (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv).hom
              ((Spec.map (CommRingCat.ofHom (R z))).appTop.hom r) := by
            rw [Iso.hom_inv_id]; rfl
        _ = ((Scheme.ΓSpecIso (CommRingCat.of (AddMonoidAlgebra L
              (Localization.Away (ℓ : ℤ))))).hom ≫ (Scheme.ΓSpecIso (CommRingCat.of
                (AddMonoidAlgebra L (Localization.Away (ℓ : ℤ))))).inv).hom r := by
            change (Scheme.ΓSpecIso _).inv.hom ((Scheme.ΓSpecIso _).hom.hom _) =
              (Scheme.ΓSpecIso _).inv.hom ((Scheme.ΓSpecIso _).hom.hom _)
            rw [e1]
        _ = r := by rw [Iso.hom_inv_id]; rfl
    rw [← happ, hφb, happ, hfix]
  have hall := s2 _ _ _ _ hsq S ha hb

  obtain ⟨F, hFdef⟩ : ∃ F : (Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).toScheme → ℚ_[ℓ],
      ∀ y, F y = (f ((Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).ι.base.hom y)).down :=
    ⟨fun y => (f ((Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).ι.base.hom y)).down, fun _ => rfl⟩
  have hF : Continuous F := by
    rw [show F = fun y => (f ((Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).ι.base.hom y)).down from
      funext hFdef]
    exact continuous_uliftDown.comp (f.continuous.comp
      (Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).ι.base.hom.continuous)
  have hC : ∀ C : Set (Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).toScheme, IsClopen C →
      ∃ k, ∀ φ' ∈ (fun φ : (Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).toScheme ⟶
        (Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).toScheme => ⇑φ.base.hom) '' Ψ k,
        ∀ y ∈ C, φ' y ∈ C := by
    intro C hCc
    obtain ⟨e, he⟩ := s4 _ C hCc
    obtain ⟨k, hk⟩ := (hS e).mp (hall e)
    refine ⟨k, ?_⟩
    rintro _ ⟨φ, hφ, rfl⟩ y hy
    exact he φ (hk φ hφ) y hy
  obtain ⟨k, hk⟩ := s5 F hF (fun k => (fun φ : (Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).toScheme ⟶
        (Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).toScheme => ⇑φ.base.hom) '' Ψ k)
    (fun j k hjk => Set.image_mono (hΨm j k hjk)) hC ε hε

  refine ⟨k, fun z hz κ h1 h2 x' hx' => ?_⟩
  have H : Set.range ⇑((Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).ι ≫ κ) ⊆
      Set.range ⇑(Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨y, rfl⟩
    have e1 : ((Limits.pullback.fst V.hom T.πi ⁻¹ᵁ W).ι ≫ κ).base.hom y =
