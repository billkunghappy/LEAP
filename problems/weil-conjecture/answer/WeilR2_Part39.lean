theorem wcpa_dj_lcc_cm_fibre_semistable (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (r : ℕ)
    (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)) (L : wcpaDjCoc Z₁)
    (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) (m : ℕ)
    (hSH : wcpaLccSH W u₁ ε L t m)
    (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (φ : Z₁ ⟶ Z) (hφ : φ ≫ uu = u₁)
    (hflat : Flat uu) (hprop : IsProper uu)
    (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Spec (.of ↥W))
    (φs : Limits.pullback u₁ s ⟶ Limits.pullback uu s)
    (h1 : φs ≫ Limits.pullback.fst uu s = Limits.pullback.fst u₁ s ≫ φ)
    (h2 : φs ≫ Limits.pullback.snd uu s = Limits.pullback.snd u₁ s)
    (hP1 : wcpaLccP1 φs) (hP2 : wcpaLccP2 u₁ L m s φs) (hABC : wcpaLccContr u₁ uu ε s φs)
    (hoff : wcpaLccOffExc u₁ uu ε s φs) :
    (∀ w : ↥(Limits.pullback uu s), wcpaDjMsFibreNS uu K s w) ∧
    (∀ E : Set ↥(Limits.pullback u₁ s), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
      (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
      (E ∩ closure Eᶜ).ncard = 1 → ∀ x ∈ E, ∃ W' : (Limits.pullback uu s).Opens,
        φs x ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ Limits.pullback.snd uu s)) :=
by
  classical
  obtain ⟨hss, -, -, -, -, hHAF, -⟩ := hSH
  obtain ⟨hA, -, -⟩ := hABC
  obtain ⟨hsurj, hinj, V, hV, hVimm⟩ := hoff
  haveI : IsProper u₁ := hss.2.1
  haveI : IsProper uu := hprop
  haveI hpXp : IsProper (Limits.pullback.snd u₁ s) := inferInstance
  haveI hpYp : IsProper (Limits.pullback.snd uu s) := inferInstance
  have hNS := hss.2.2 K s

  have s1 : ∀ y : (V : (Limits.pullback u₁ s).Opens).toScheme,
      wcpaDjMsFibreNS uu K s ((V.ι ≫ φs) y) := by
    intro y
    have h' := (wcpa_cl_ps_open_ns_iff K V.ι (Limits.pullback.snd u₁ s) y).mp (hNS (V.ι y))
    have heq : V.ι ≫ Limits.pullback.snd u₁ s = (V.ι ≫ φs) ≫ Limits.pullback.snd uu s := by
      rw [Category.assoc, h2]
    rw [heq] at h'
    exact (wcpa_cl_ps_open_ns_iff K (V.ι ≫ φs) (Limits.pullback.snd uu s) y).mpr h'

  have key : ∀ E : Set ↥(Limits.pullback u₁ s), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
      (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
      ∀ x₀ ∈ E,
      ((E ∩ closure Eᶜ).ncard = 1 → ∃ W' : (Limits.pullback uu s).Opens,
        φs x₀ ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ Limits.pullback.snd uu s)) ∧
      ((E ∩ closure Eᶜ).ncard = 2 → ∃ e : AdicCompletion
          (IsLocalRing.maximalIdeal ((Limits.pullback uu s).presheaf.stalk (φs x₀)))
          ((Limits.pullback uu s).presheaf.stalk (φs x₀)) ≃+*
          (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        e.toRingHom.comp ((algebraMap ((Limits.pullback uu s).presheaf.stalk (φs x₀))
          (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback uu s).presheaf.stalk (φs x₀)))
            ((Limits.pullback uu s).presheaf.stalk (φs x₀)))).comp
          ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd uu s).appTop ≫
            (Limits.pullback uu s).presheaf.germ ⊤ (φs x₀) trivial).hom) =
        (Ideal.Quotient.mk _).comp MvPowerSeries.C) := by
    intro E hE hAF x₀ hx₀
    obtain ⟨hdat, hk1, hk2, huniq⟩ := hHAF K s E hE hAF
    obtain ⟨X', i, n, hi, hX'red, hirange, hn, hndist, hnchar, hnsm⟩ :=
      wcpa_dj_lcc_fs_branch_curve K (Limits.pullback u₁ s) (Limits.pullback.snd u₁ s) E
        (E ∩ closure Eᶜ).ncard hpXp hNS hE hdat rfl hk1
    haveI := hi
    have hπ : (i ≫ φs) ≫ Limits.pullback.snd uu s = i ≫ Limits.pullback.snd u₁ s := by
      rw [Category.assoc, h2]
    have hconst : ∀ e ∈ E, φs e = φs x₀ := fun e he => hA E hE hAF e he x₀ hx₀
    have hpts : ∀ j, (i ≫ φs) (n j (IsLocalRing.closedPoint K)) = φs x₀ := by
      intro j
      have hmem : i (n j (IsLocalRing.closedPoint K)) ∈ E ∩ closure Eᶜ := (hnchar _).mpr ⟨j, rfl⟩
      rw [Scheme.Hom.comp_apply]
      exact hconst _ hmem.1
    have hiinj : Function.Injective i := i.isClosedEmbedding.injective
    have hcoll : ∀ x x' : X', (i ≫ φs) x = (i ≫ φs) x' → x ≠ x' →
        ∃ j, x = n j (IsLocalRing.closedPoint K) := by
      intro x x' hxx' hne
      have hne' : i x ≠ i x' := fun h => hne (hiinj h)
      rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hxx'
      rcases hinj (i x) (i x') hxx' with h | ⟨E', hE', hAF', hxE', -⟩
      · exact absurd h hne'
      · rw [huniq E' hE' hAF'] at hxE'
        have hmem : i x ∈ E ∩ closure Eᶜ := ⟨hxE', by rw [← hirange]; exact Set.mem_range_self x⟩
        obtain ⟨j, hj⟩ := (hnchar _).mp hmem
        exact ⟨j, hiinj hj⟩
    have hclosed : ∀ x x' : X', (i ≫ φs) x = (i ≫ φs) x' → x ≠ x' → IsClosed ({x} : Set X') := by
      intro x x' h hne
      obtain ⟨j, rfl⟩ := hcoll x x' h hne
      exact wc_pfam_mc_rational_point_closed K X' (i ≫ Limits.pullback.snd u₁ s) (n j) (hn j)
    have hfib : ∀ y, (⇑(i ≫ φs) ⁻¹' {y}).Finite := by
      intro y
      by_cases hsub : (⇑(i ≫ φs) ⁻¹' {y}).Subsingleton
      · exact hsub.finite
      · obtain ⟨a, ha, b, hb, hab⟩ := Set.not_subsingleton_iff.mp hsub
        have ha' : (i ≫ φs) a = y := ha
        have hb' : (i ≫ φs) b = y := hb
        apply (Set.finite_range (fun j : Fin (E ∩ closure Eᶜ).ncard =>
          n j (IsLocalRing.closedPoint K))).subset
        intro x hx
        have hx' : (i ≫ φs) x = y := hx
        by_cases hxa : x = a
        · subst hxa
          obtain ⟨j, hj⟩ := hcoll x b (ha'.trans hb'.symm) hab
          exact ⟨j, hj.symm⟩
        · obtain ⟨j, hj⟩ := hcoll x a (hx'.trans ha'.symm) hxa
          exact ⟨j, hj.symm⟩
    have hfin : IsFinite (i ≫ φs) :=
      wcpa_dj_lcc_fs_finite_of_fibres K X' (Limits.pullback uu s) (i ≫ Limits.pullback.snd u₁ s)
        (Limits.pullback.snd uu s) (i ≫ φs) inferInstance hpYp hπ hfib hclosed
    haveI : IsAffineHom (i ≫ φs) := (IsFinite.iff_isProper_and_isAffineHom.mp hfin).2
    obtain ⟨V₀, hV₀aff', hyV₀, -⟩ := exists_isAffineOpen_mem_and_subset
      (show φs x₀ ∈ (⊤ : (Limits.pullback uu s).Opens) from trivial)
    have hpreaff : IsAffineOpen ((i ≫ φs) ⁻¹ᵁ V₀) := hV₀aff'.preimage (i ≫ φs)
    have hEO : E ⊆ ↑(φs ⁻¹ᵁ V₀) := by
      intro e he
      show φs e ∈ V₀
      rw [hconst e he]
      exact hyV₀
    obtain ⟨hresinj, hreseq⟩ := wcpa_dj_lcc_fs_glue_sections K (Limits.pullback u₁ s) X'
      (Limits.pullback.snd u₁ s) i E (E ∩ closure Eᶜ).ncard n (φs ⁻¹ᵁ V₀) hpXp hNS hE hdat hi
      hX'red hirange hk1 hn hndist hnchar hnsm hEO
    have hbij : Function.Bijective (φs.appLE V₀ (φs ⁻¹ᵁ V₀) le_rfl).hom := by
      rw [← Scheme.Hom.app_eq_appLE]
      exact hP1 V₀
    have hfac : ((i ≫ φs).appLE V₀ ((i ≫ φs) ⁻¹ᵁ V₀) le_rfl) =
        φs.appLE V₀ (φs ⁻¹ᵁ V₀) le_rfl ≫ i.appLE (φs ⁻¹ᵁ V₀) (i ⁻¹ᵁ (φs ⁻¹ᵁ V₀)) le_rfl := by
      rw [Scheme.Hom.appLE_comp_appLE]
      rfl
    have hinjπ : Function.Injective ((i ≫ φs).appLE V₀ ((i ≫ φs) ⁻¹ᵁ V₀) le_rfl).hom := by
      rw [hfac]
      exact hresinj.comp hbij.1
    have heqπ : ∀ g : Γ(X', (i ≫ φs) ⁻¹ᵁ V₀),
        (∃ b : Γ(Limits.pullback uu s, V₀),
          ((i ≫ φs).appLE V₀ ((i ≫ φs) ⁻¹ᵁ V₀) le_rfl).hom b = g) ↔
        ∀ (j j' : Fin (E ∩ closure Eᶜ).ncard)
          (h : ⊤ ≤ n j ⁻¹ᵁ ((i ≫ φs) ⁻¹ᵁ V₀)) (h' : ⊤ ≤ n j' ⁻¹ᵁ ((i ≫ φs) ⁻¹ᵁ V₀)),
          ((n j).appLE ((i ≫ φs) ⁻¹ᵁ V₀) ⊤ h).hom g =
            ((n j').appLE ((i ≫ φs) ⁻¹ᵁ V₀) ⊤ h').hom g := by
      intro g
      have H := hreseq g
      constructor
      · rintro ⟨b, hb⟩
        rw [hfac] at hb
        exact H.mp ⟨_, hb⟩
      · intro hc
        obtain ⟨f, hf⟩ := H.mpr hc
        obtain ⟨b, rfl⟩ := hbij.2 f
        refine ⟨b, ?_⟩
        rw [hfac]
        exact hf
    exact wcpa_dj_lcc_fs_pinch_point K X' (Limits.pullback uu s) (i ≫ Limits.pullback.snd u₁ s)
      (Limits.pullback.snd uu s) (i ≫ φs) (E ∩ closure Eᶜ).ncard n V₀ (φs x₀) hπ hpYp hk1 hk2
      hn hndist hnsm hpts hyV₀ hV₀aff' hpreaff hinjπ heqπ
  refine ⟨fun w => ?_, ?_⟩
  · by_cases hw : w ∈ Set.range ⇑(V.ι ≫ φs)
    · obtain ⟨y, rfl⟩ := hw
      exact s1 y
    · obtain ⟨x₀, rfl⟩ := hsurj w
      have hx₀V : x₀ ∉ V := fun h => hw ⟨⟨x₀, h⟩, by first | rfl | simp⟩
      obtain ⟨E, hE, hAF, hx₀E⟩ : ∃ E ∈ irreducibleComponents ↥(Limits.pullback u₁ s),
          (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) ∧
          x₀ ∈ E := by
        by_contra hcon
        apply hx₀V
        rw [hV]
        intro E hE hAF hx
        exact hcon ⟨E, hE, hAF, hx⟩
      obtain ⟨-, hk1, hk2, -⟩ := hHAF K s E hE hAF
      have hk := key E hE hAF x₀ hx₀E
      rcases (by omega : (E ∩ closure Eᶜ).ncard = 1 ∨ (E ∩ closure Eᶜ).ncard = 2) with h | h
      · exact Or.inl (hk.1 h)
      · exact Or.inr (hk.2 h)
  · intro E hE hAF hk x hx
    exact (key E hE hAF x hx).1 hk

theorem wcpa_dj_lcc_contraction_model : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (r : ℕ)
    (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)) (L : wcpaDjCoc Z₁)
    (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)),
    wcpaDjSemistable u₁ → wcpaDjSections u₁ r ε → wcpaDjCocOK L →
    wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) 1 t →
    (∀ a, (Z₁.basicOpen (t a) : Set Z₁) =
      ((L.V a ⊓ u₁ ⁻¹ᵁ ⊤ : Z₁.Opens) : Set Z₁) \ ⋃ i, Set.range ⇑(ε i)) →
    wcpaLccHAF u₁ ε →
    ∀ m : ℕ, 0 < m → (∀ k : ℕ, 1 ≤ k → wcpaLccBC u₁ L (m * k)) → wcpaLccGG u₁ L m →
    ∃ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (φ : Z₁ ⟶ Z),
      φ ≫ uu = u₁ ∧ wcpaDjSemistable uu ∧ LocallyOfFinitePresentation uu ∧
        wcpaLccFib u₁ uu φ ε :=
by
  intro Ω _ _ W Z₁ u₁ r ε L t hss hsec hOK hcompat hbo hHAF m hm hBC hGG
  have hSH : wcpaLccSH W u₁ ε L t m := ⟨hss, hsec, hOK, hcompat, hbo, hHAF, hm, hBC, hGG⟩
  obtain ⟨d₀, hd₀, hgen⟩ := wcpa_dj_lcc_cm_section_ring_fg Ω W Z₁ u₁ r ε L t m hSH
  obtain ⟨Z, uu, φ, hφ, hflat, hprop, hlfp, hfib0⟩ :=
    wcpa_dj_lcc_cm_family_proj Ω W Z₁ u₁ r ε L t m d₀ hSH hd₀ hgen
  have key : ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Spec (.of ↥W))
      (φs : Limits.pullback u₁ s ⟶ Limits.pullback uu s),
      φs ≫ Limits.pullback.fst uu s = Limits.pullback.fst u₁ s ≫ φ →
      φs ≫ Limits.pullback.snd uu s = Limits.pullback.snd u₁ s →
      wcpaLccP1 φs ∧ wcpaLccP2 u₁ L m s φs ∧ wcpaLccContr u₁ uu ε s φs ∧
        wcpaLccOffExc u₁ uu ε s φs := by
    intro K _ _ s φs h1 h2
    obtain ⟨hP1, hP2⟩ := hfib0 K s φs h1 h2
    have hsep := wcpa_dj_lcc_cm_fibre_separation Ω W Z₁ u₁ r ε L t m hSH K s
    have hABC := wcpa_dj_lcc_cm_fibre_contracts Ω W Z₁ u₁ r ε L t m hSH Z uu φ hφ K s φs
      h1 h2 hP1 hP2 hsep
    have hoff := wcpa_dj_lcc_cm_fibre_iso_off_exc Ω W Z₁ u₁ r ε L t m hSH Z uu φ hφ hprop
      K s φs h1 h2 hP1 hABC
    exact ⟨hP1, hP2, hABC, hoff⟩
  have hssZ : wcpaDjSemistable uu := by
    refine ⟨hflat, hprop, ?_⟩
    intro K _ _ s w
    have hc : (Limits.pullback.fst u₁ s ≫ φ) ≫ uu = Limits.pullback.snd u₁ s ≫ s := by
      rw [Category.assoc, hφ, Limits.pullback.condition]
    obtain ⟨hP1, hP2, hABC, hoff⟩ := key K s (Limits.pullback.lift _ _ hc)
      (Limits.pullback.lift_fst _ _ _) (Limits.pullback.lift_snd _ _ _)
    exact (wcpa_dj_lcc_cm_fibre_semistable Ω W Z₁ u₁ r ε L t m hSH Z uu φ hφ hflat hprop
      K s (Limits.pullback.lift _ _ hc) (Limits.pullback.lift_fst _ _ _)
      (Limits.pullback.lift_snd _ _ _) hP1 hP2 hABC hoff).1 w
  refine ⟨Z, uu, φ, hφ, hssZ, hlfp, ?_⟩
  intro K _ _ s φs h1 h2
  obtain ⟨hP1, hP2, hABC, hoff⟩ := key K s φs h1 h2
  have hcomp := wcpa_dj_lcc_cm_fibre_components Ω W Z₁ u₁ r ε L t m hSH Z uu φ hφ hprop
    K s φs h1 h2 hP1 hABC hoff
  have hsemi := wcpa_dj_lcc_cm_fibre_semistable Ω W Z₁ u₁ r ε L t m hSH Z uu φ hφ hflat hprop
    K s φs h1 h2 hP1 hP2 hABC hoff
  have hnodes := (wcpa_dj_lfc_afc_fibre_nodes_finite (Spec (.of ↥W)) Z uu hssZ K s).2
  obtain ⟨hA, -, -⟩ := hABC
  obtain ⟨hsurj, hc3, hc5⟩ := hoff
  exact ⟨hsurj, fun C hC => (hnodes C hC).1, hc3, hA, hc5, hsemi.2, hcomp.1, hcomp.2⟩

theorem wcpa_dj_lccg_qf_basechange : ∀ {P X Y Y' : Scheme.{u}} {g' : P ⟶ X} {f' : P ⟶ Y'}
    {f : X ⟶ Y} {g : Y' ⟶ Y}, IsPullback g' f' f g → LocallyOfFiniteType f →
    ∀ p : P, f.QuasiFiniteAt (g' p) → f'.QuasiFiniteAt p :=
by
  intro P X Y Y' g' f' f g hPB _ p hx
  have hh : LocallyQuasiFinite (X.fromSpecStalk (g' p) ≫ f) :=
    Scheme.Hom.quasiFiniteAt_iff.mp hx
  have e3 : Spec.map (g'.stalkMap p) ≫ X.fromSpecStalk (g' p) = P.fromSpecStalk p ≫ g' :=
    Scheme.SpecMap_stalkMap_fromSpecStalk g'
  have w : Spec.map (g'.stalkMap p) ≫ (X.fromSpecStalk (g' p) ≫ f) =
      (P.fromSpecStalk p ≫ f') ≫ g := by
    rw [← Category.assoc, e3, Category.assoc, hPB.w, Category.assoc]
  let ι : Spec (P.presheaf.stalk p) ⟶ Limits.pullback (X.fromSpecStalk (g' p) ≫ f) g :=
    Limits.pullback.lift (Spec.map (g'.stalkMap p)) (P.fromSpecStalk p ≫ f') w
  have w' : (Limits.pullback.fst (X.fromSpecStalk (g' p) ≫ f) g ≫ X.fromSpecStalk (g' p)) ≫ f =
      Limits.pullback.snd (X.fromSpecStalk (g' p) ≫ f) g ≫ g := by
    rw [Category.assoc]; exact Limits.pullback.condition
  let q : Limits.pullback (X.fromSpecStalk (g' p) ≫ f) g ⟶ P :=
    hPB.lift _ _ w'
  have hι1 : ι ≫ Limits.pullback.fst (X.fromSpecStalk (g' p) ≫ f) g = Spec.map (g'.stalkMap p) :=
    Limits.pullback.lift_fst _ _ _
  have hι2 : ι ≫ Limits.pullback.snd (X.fromSpecStalk (g' p) ≫ f) g = P.fromSpecStalk p ≫ f' :=
    Limits.pullback.lift_snd _ _ _
  have hq1 : q ≫ g' = Limits.pullback.fst (X.fromSpecStalk (g' p) ≫ f) g ≫ X.fromSpecStalk (g' p) :=
    hPB.lift_fst _ _ w'
  have hq2 : q ≫ f' = Limits.pullback.snd (X.fromSpecStalk (g' p) ≫ f) g :=
    hPB.lift_snd _ _ w'
  have hιq : ι ≫ q = P.fromSpecStalk p := by
    apply hPB.hom_ext
    · rw [Category.assoc, hq1, ← Category.assoc, hι1, e3]
    · rw [Category.assoc, hq2, hι2]
  have : LocallyQuasiFinite (ι ≫ q) := by rw [hιq]; infer_instance
  have : LocallyQuasiFinite ι := LocallyQuasiFinite.of_comp ι q
  rw [Scheme.Hom.quasiFiniteAt_iff, ← hι2]
  infer_instance

theorem wcpa_dj_lccg_component_nontrivial : ∀ {C P : Scheme.{u}} (g : C ⟶ P),
    wcpaDjSemistable g → ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ P)
    (E : Set ↥(Limits.pullback g s)), E ∈ irreducibleComponents ↥(Limits.pullback g s) →
    ∀ y ∈ E, ∃ y' ∈ E, y' ≠ y :=
by
  intro C P g hss K _ _ s E hE y hy
  classical

  have s1 : ∀ (X : Scheme.{u}) (y : X), ({y} : Set X) ∈ irreducibleComponents X →
      ∀ I : Ideal (X.presheaf.stalk y), I.IsPrime → I = IsLocalRing.maximalIdeal (X.presheaf.stalk y) := by
    intro X y hE I hI
    let p : PrimeSpectrum (X.presheaf.stalk y) := ⟨I, hI⟩
    have hsp : X.fromSpecStalk y p ⤳ y := by
      have h0 : X.fromSpecStalk y p ∈ Set.range (X.fromSpecStalk y) := ⟨p, rfl⟩
      rw [Scheme.range_fromSpecStalk] at h0
      exact h0
    have hmem : y ∈ closure {X.fromSpecStalk y p} := specializes_iff_mem_closure.mp hsp
    have hirr : IsIrreducible (closure {X.fromSpecStalk y p}) := isIrreducible_singleton.closure
    have hsub : ({y} : Set X) ⊆ closure {X.fromSpecStalk y p} := Set.singleton_subset_iff.mpr hmem
    have heq : ({y} : Set X) = closure {X.fromSpecStalk y p} :=
      (show Maximal IsIrreducible ({y} : Set X) from hE).eq_of_subset hirr hsub
    have hy' : X.fromSpecStalk y p = y := by
      have h2 : X.fromSpecStalk y p ∈ closure {X.fromSpecStalk y p} :=
        subset_closure (Set.mem_singleton _)
      rw [← heq] at h2
      exact h2
    have hp : p = IsLocalRing.closedPoint (X.presheaf.stalk y) := by
      apply (X.fromSpecStalk y).isEmbedding.injective
      rw [hy', Scheme.fromSpecStalk_closedPoint]
    exact congrArg PrimeSpectrum.asIdeal hp

  have s2 : ∀ (O : Type u) [CommRing O] [IsLocalRing O] [IsNoetherianRing O] [Ring.KrullDimLE 0 O],
      (AdicCompletion (IsLocalRing.maximalIdeal O) O ≃+*
        (MvPowerSeries (Fin 2) K ⧸ Ideal.span
          {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)})) → False := by
    intro O _ _ _ _ e
    obtain ⟨N, hN⟩ := IsNoetherianRing.isNilpotent_nilradical O
    have hle : IsLocalRing.maximalIdeal O ≤ nilradical O := fun x hx =>
      mem_nilradical.mpr (Ring.KrullDimLE.isNilpotent_iff_mem_maximalIdeal.mpr hx)
    have hmN : (IsLocalRing.maximalIdeal O) ^ N = ⊥ := by
      have h1 := Ideal.pow_right_mono hle N
      rw [hN, Ideal.zero_eq_bot] at h1
      exact le_bot_iff.mp h1
    haveI : IsPrecomplete (IsLocalRing.maximalIdeal O) O := by
      refine IsPrecomplete.mk (fun f hf => ⟨f N, fun n => ?_⟩)
      rcases le_total n N with hnN | hNn
      · exact hf hnN
      · have h1 : (IsLocalRing.maximalIdeal O) ^ N • (⊤ : Submodule O O) = ⊥ := by
          rw [hmN, Submodule.bot_smul]
        have h2 := hf hNn
        rw [h1, SModEq.bot] at h2
        rw [h2]
    obtain ⟨J, hJ⟩ : ∃ J : Ideal (MvPowerSeries (Fin 2) K),
        J = Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)} :=
      ⟨_, rfl⟩
    rw [← hJ] at e
    obtain ⟨a, ha⟩ := AdicCompletion.of_surjective (IsLocalRing.maximalIdeal O) O
      (e.symm (Ideal.Quotient.mk J (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K)))
    have ha' : e (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O) a) =
        Ideal.Quotient.mk J (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K) := by
      rw [AdicCompletion.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply, ha,
        RingEquiv.apply_symm_apply]
    have hχ : ∀ x ∈ J, MvPowerSeries.constantCoeff x = 0 := by
      intro x hx
      rw [hJ] at hx
      obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp hx
      simp [MvPowerSeries.constantCoeff_X]
    let χ : (MvPowerSeries (Fin 2) K ⧸ J) →+* K :=
      Ideal.Quotient.lift J (MvPowerSeries.constantCoeff (σ := Fin 2) (R := K)) hχ
    have haM : a ∈ IsLocalRing.maximalIdeal O := by
      by_contra hna
      have hu : IsUnit a := IsLocalRing.notMem_maximalIdeal.mp hna
      have hu2 := (hu.map (algebraMap O (AdicCompletion (IsLocalRing.maximalIdeal O) O))).map e
      rw [ha'] at hu2
      have hu3 := hu2.map χ
      have hz : χ (Ideal.Quotient.mk J (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K)) = 0 := by
        simp only [χ, Ideal.Quotient.lift_mk, MvPowerSeries.constantCoeff_X]
      rw [hz] at hu3
      exact not_isUnit_zero hu3
    obtain ⟨k, hk⟩ := Ring.KrullDimLE.isNilpotent_iff_mem_maximalIdeal.mpr haM
    have hmk : Ideal.Quotient.mk J ((MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K) ^ k) = 0 := by
      rw [map_pow, ← ha', ← map_pow, ← map_pow, hk, map_zero, map_zero]
    have hdvd : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K) ∣
        (MvPowerSeries.X 0) ^ k := by
      have h1 := Ideal.Quotient.eq_zero_iff_mem.mp hmk
      rw [hJ] at h1
      exact Ideal.mem_span_singleton.mp h1
    have hdvd1 : (MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K) ∣ (MvPowerSeries.X 0) ^ k :=
      dvd_trans (dvd_mul_left _ _) hdvd
    have hc := MvPowerSeries.X_dvd_iff.mp hdvd1 (Finsupp.single 0 k) (by
      rw [Finsupp.single_apply]; simp)
    rw [MvPowerSeries.coeff_X_pow] at hc
    simp at hc

  have sdim : ∀ (Z : Scheme.{u}) (q : Z ⟶ Spec (.of K)) (d : ℕ) [SmoothOfRelativeDimension d q]
      (z : Z), IsClosed ({z} : Set Z) → ringKrullDim (Z.presheaf.stalk z) = (d : WithBot ℕ∞) := by
    intro Z q d _ z hcl
    have wc_lfi_flat_local_dim_eq : ∀ (P A : Type u) [CommRing P] [CommRing A] [IsLocalRing P]
        [IsLocalRing A] [IsNoetherianRing P] [IsNoetherianRing A] [Algebra P A] [Module.Flat P A]
        [IsLocalHom (algebraMap P A)],
        Ideal.map (algebraMap P A) (IsLocalRing.maximalIdeal P) = IsLocalRing.maximalIdeal A →
        ringKrullDim A = ringKrullDim P := by
      intro P A _ _ _ _ _ _ _ _ _ hmax
      haveI : Algebra.HasGoingDown P A := Algebra.HasGoingDown.of_flat
      haveI : (IsLocalRing.maximalIdeal A).LiesOver (IsLocalRing.maximalIdeal P) :=
        ⟨by rw [Ideal.under_def, IsLocalRing.maximalIdeal_comap]⟩
      have h1 := Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown
        (IsLocalRing.maximalIdeal P) (IsLocalRing.maximalIdeal A)
      have h5 : Ideal.map (Ideal.Quotient.mk (Ideal.map (algebraMap P A) (IsLocalRing.maximalIdeal P)))
          (IsLocalRing.maximalIdeal A) = ⊥ := by
        rw [Ideal.map_eq_bot_iff_le_ker, Ideal.mk_ker]
        exact hmax.ge
      haveI : Nontrivial (A ⧸ Ideal.map (algebraMap P A) (IsLocalRing.maximalIdeal P)) := by
        rw [Ideal.Quotient.nontrivial_iff, hmax]
        exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top
      rw [h5, Ideal.height_bot, add_zero] at h1
      rw [← IsLocalRing.maximalIdeal_height_eq_ringKrullDim,
        ← IsLocalRing.maximalIdeal_height_eq_ringKrullDim, h1]
    have s3 : ∀ (n : ℕ) (M : Ideal (MvPolynomial (Fin n) K)), M.IsMaximal → M.height = (n : ℕ∞) := by
      intro n
      induction n with
      | zero =>
        intro M hM
        let e := (MvPolynomial.isEmptyAlgEquiv K (Fin 0)).toRingEquiv
        haveI : (Ideal.map e M).IsMaximal := Ideal.map_isMaximal_of_equiv e
        have h2 : Ideal.map e M = ⊥ := Ideal.eq_bot_of_prime _
        rw [← RingEquiv.height_map e M, h2, Ideal.height_bot]
        simp
      | succ n ih =>
        intro M hM
        let e := (MvPolynomial.finSuccEquiv K n).toRingEquiv
        haveI : (Ideal.map e M).IsMaximal := Ideal.map_isMaximal_of_equiv e
        haveI := Ideal.over_under (A := MvPolynomial (Fin n) K) (Ideal.map e M)
        have h3 := Polynomial.height_eq_height_add_one
          (Ideal.under (MvPolynomial (Fin n) K) (Ideal.map e M)) (Ideal.map e M)
        have h4 : (Ideal.under (MvPolynomial (Fin n) K) (Ideal.map e M)).IsMaximal := by
          have := Polynomial.isMaximal_comap_C_of_isJacobsonRing (Ideal.map e M)
          unfold Ideal.under
          rw [Polynomial.algebraMap_eq]
          exact this
        rw [← RingEquiv.height_map e M, h3, ih _ h4]
        push_cast
        rfl
    have s4 : ∀ (S : Type u) [CommRing S] (g : MvPolynomial (Fin d) K →+* S), g.FiniteType →
        ∀ (Q : Ideal S), Q.IsMaximal → (Ideal.comap g Q).IsMaximal := by
      intro S _ g hg Q hQ
      letI := g.toAlgebra
      haveI : Algebra.FiniteType (MvPolynomial (Fin d) K) S := hg
      letI : Field (S ⧸ Q) := Ideal.Quotient.field Q
      haveI : Algebra.FiniteType (MvPolynomial (Fin d) K) (S ⧸ Q) :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ _ Q)
          (Ideal.Quotient.mkₐ_surjective _ Q)
      haveI : Module.Finite (MvPolynomial (Fin d) K) (S ⧸ Q) :=
        finite_of_finite_type_of_isJacobsonRing _ _
      haveI : (⊥ : Ideal (S ⧸ Q)).IsMaximal := Ideal.bot_isMaximal
      have h := Ideal.isMaximal_comap_of_isIntegral_of_isMaximal
        (algebraMap (MvPolynomial (Fin d) K) (S ⧸ Q))
        (fun x => Algebra.IsIntegral.isIntegral x) (⊥ : Ideal (S ⧸ Q))
      have heq : Ideal.comap (algebraMap (MvPolynomial (Fin d) K) (S ⧸ Q)) ⊥ = Ideal.comap g Q := by
        ext x
        rw [Ideal.mem_comap, Ideal.mem_comap, Ideal.mem_bot]
        first
          | (rw [← Ideal.Quotient.mk_algebraMap, Ideal.Quotient.eq_zero_iff_mem]; rfl)
          | exact Ideal.Quotient.eq_zero_iff_mem
          | (show Ideal.Quotient.mk Q (g x) = 0 ↔ _; exact Ideal.Quotient.eq_zero_iff_mem)
      rw [heq] at h
      exact h
    have key : ∀ (S : Type u) [CommRing S] (g : MvPolynomial (Fin d) K →+* S), g.Etale →
        ∀ (Q : Ideal S), Q.IsMaximal → Q.height = (d : ℕ∞) := by
      intro S _ g hg Q hQ
      haveI := hQ.isPrime
      letI := g.toAlgebra
      haveI : Algebra.Etale (MvPolynomial (Fin d) K) S := hg
      have hft : g.FiniteType := (inferInstance : Algebra.FiniteType (MvPolynomial (Fin d) K) S)
      have hfl : g.Flat := (inferInstance : Module.Flat (MvPolynomial (Fin d) K) S)
      haveI : IsNoetherianRing S := Algebra.FiniteType.isNoetherianRing (MvPolynomial (Fin d) K) S
      have hpmax := s4 S g hft Q hQ
      have hpd := s3 d _ hpmax
      let φ := Localization.localRingHom (Ideal.comap g Q) Q g rfl
      letI : Algebra (Localization.AtPrime (Ideal.comap g Q)) (Localization.AtPrime Q) := φ.toAlgebra
      haveI : IsLocalHom (algebraMap (Localization.AtPrime (Ideal.comap g Q)) (Localization.AtPrime Q)) :=
        Localization.isLocalHom_localRingHom (Ideal.comap g Q) Q g rfl
      haveI : Module.Flat (Localization.AtPrime (Ideal.comap g Q)) (Localization.AtPrime Q) :=
        RingHom.Flat.localRingHom hfl Q (Ideal.comap g Q) rfl
      haveI : IsNoetherianRing (Localization.AtPrime (Ideal.comap g Q)) :=
        IsLocalization.isNoetherianRing (Ideal.comap g Q).primeCompl _ inferInstance
      haveI : IsNoetherianRing (Localization.AtPrime Q) :=
        IsLocalization.isNoetherianRing Q.primeCompl _ inferInstance
      haveI : IsScalarTower (MvPolynomial (Fin d) K) (Localization.AtPrime (Ideal.comap g Q))
          (Localization.AtPrime Q) :=
        IsScalarTower.of_algebraMap_eq (fun x => by
          rw [IsScalarTower.algebraMap_apply (MvPolynomial (Fin d) K) S (Localization.AtPrime Q) x,
            RingHom.algebraMap_toAlgebra φ, Localization.localRingHom_to_map]
          rfl)
      haveI : Algebra.FormallyUnramified S (Localization.AtPrime Q) :=
        Algebra.FormallyUnramified.of_isLocalization Q.primeCompl
      haveI : Algebra.FormallyUnramified (MvPolynomial (Fin d) K) (Localization.AtPrime Q) :=
        Algebra.FormallyUnramified.comp (MvPolynomial (Fin d) K) S (Localization.AtPrime Q)
      haveI : Algebra.FormallyUnramified (Localization.AtPrime (Ideal.comap g Q))
          (Localization.AtPrime Q) :=
        Algebra.FormallyUnramified.localization_base (Ideal.comap g Q).primeCompl
      haveI : Algebra.EssFiniteType (MvPolynomial (Fin d) K) S :=
        Algebra.EssFiniteType.of_finiteType _ _
      haveI : Algebra.EssFiniteType S (Localization.AtPrime Q) :=
        Algebra.EssFiniteType.of_isLocalization _ Q.primeCompl
      haveI : Algebra.EssFiniteType (MvPolynomial (Fin d) K) (Localization.AtPrime Q) :=
        Algebra.EssFiniteType.comp (MvPolynomial (Fin d) K) S (Localization.AtPrime Q)
      haveI : Algebra.EssFiniteType (Localization.AtPrime (Ideal.comap g Q))
          (Localization.AtPrime Q) :=
        Algebra.EssFiniteType.of_comp (MvPolynomial (Fin d) K) _ _
      have hmap := Algebra.FormallyUnramified.map_maximalIdeal
        (R := Localization.AtPrime (Ideal.comap g Q)) (S := Localization.AtPrime Q)
      have hdim := wc_lfi_flat_local_dim_eq _ _ hmap
      rw [IsLocalization.AtPrime.ringKrullDim_eq_height Q (Localization.AtPrime Q),
        IsLocalization.AtPrime.ringKrullDim_eq_height (Ideal.comap g Q)
          (Localization.AtPrime (Ideal.comap g Q))] at hdim
      have hdim' : Q.height = (Ideal.comap g Q).height := by exact_mod_cast hdim
      rw [hdim', hpd]
    obtain ⟨U, hU, V, hV, hzV, e, hss⟩ :=
      SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := d) (f := q) z
    obtain ⟨g₀, -, hg₀⟩ := hss.exists_etale_mvPolynomial
    have hUtop : U = ⊤ := by
      have h1 : q z ∈ U := e hzV
      refine eq_top_iff.mpr (fun w _ => ?_)
      rwa [Subsingleton.elim w (q z)]
    subst hUtop
    let e₀ : K ≃+* Γ(Spec (.of K), ⊤) :=
      (Scheme.ΓSpecIso (CommRingCat.of K)).symm.commRingCatIsoToRingEquiv
    let g := g₀.comp (MvPolynomial.mapEquiv (Fin d) e₀).toRingHom
    have hg : g.Etale := RingHom.Etale.respectsIso.2 g₀ (MvPolynomial.mapEquiv (Fin d) e₀) hg₀
    obtain ⟨x, hx⟩ : ∃ x : V, (x : Z) = z := ⟨⟨z, hzV⟩, rfl⟩
    subst hx
    have hQmax : (hV.primeIdealOf x).asIdeal.IsMaximal := by
      haveI := hV.isOpenImmersion_fromSpec
      have hinj := hV.fromSpec.isOpenEmbedding.injective
      have hpre : hV.fromSpec ⁻¹' {(x : Z)} = {hV.primeIdealOf x} := by
        ext w
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        constructor
        · intro hw
          apply hinj
          rw [hw, hV.fromSpec_primeIdealOf]
        · intro hw
          rw [hw, hV.fromSpec_primeIdealOf]
      have hc : IsClosed ({hV.primeIdealOf x} : Set (Spec Γ(Z, V))) := by
        rw [← hpre]
        exact hcl.preimage hV.fromSpec.continuous
      exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal (hV.primeIdealOf x)).mp hc
    haveI := hQmax.isPrime
    haveI := hV.isLocalization_stalk x
    rw [IsLocalization.AtPrime.ringKrullDim_eq_height (hV.primeIdealOf x).asIdeal
      (Z.presheaf.stalk (x : Z)), key _ g hg _ hQmax]
    rfl

  by_contra hcon
  push_neg at hcon
  have hEy : E = {y} := Set.eq_singleton_iff_unique_mem.mpr ⟨hy, hcon⟩
  subst hEy
  have hcl : IsClosed ({y} : Set ↥(Limits.pullback g s)) :=
    isClosed_of_mem_irreducibleComponents _ hE
  have hall := s1 (Limits.pullback g s) y hE
  haveI hdim0 : Ring.KrullDimLE 0 ((Limits.pullback g s).presheaf.stalk y) :=
    Ring.krullDimLE_zero_iff.mpr (fun I hI => by
      rw [hall I hI]; exact IsLocalRing.maximalIdeal.isMaximal _)
  rcases hss.2.2 K s y with ⟨W, hyW, hsm⟩ | ⟨e, -⟩
  · have hclW : IsClosed ({(⟨y, hyW⟩ : W)} : Set W) := by
      have h1 : ({(⟨y, hyW⟩ : W)} : Set W) = (W.ι : W.toScheme ⟶ _) ⁻¹' {y} := by
        ext z
        simp only [Set.mem_singleton_iff, Set.mem_preimage, Scheme.Opens.ι_apply]
        constructor
        · rintro rfl; rfl
        · intro h; exact Subtype.ext h
      rw [h1]
      exact hcl.preimage W.ι.continuous
    have hd := @sdim W.toScheme (W.ι ≫ Limits.pullback.snd g s) 1 hsm ⟨y, hyW⟩ hclW
    have hd' : ringKrullDim ((Limits.pullback g s).presheaf.stalk y) = ((1 : ℕ) : WithBot ℕ∞) :=
      (ringKrullDim_eq_of_ringEquiv (W.stalkIso ⟨y, hyW⟩).commRingCatIsoToRingEquiv).symm.trans hd
    have h0 := Ring.krullDimLE_iff.mp hdim0
    rw [hd'] at h0
    norm_num at h0
  · haveI : IsProper g := hss.2.1
    haveI : LocallyOfFiniteType (Limits.pullback.snd g s) :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) (IsPullback.of_hasPullback g s)
        inferInstance
    haveI : IsLocallyNoetherian (Limits.pullback g s) :=
      LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd g s)
    exact s2 _ e

theorem wcpa_dj_lccg_reduced : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω)
    (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)), wcpaDjSemistable uu → IsReduced Z :=
by
  intro Ω _ _ W Z uu hss

  have flatGen : ∀ (R K : Type u) [CommRing R] [CommRing K] [Algebra R K],
      Function.Injective (algebraMap R K) → ∀ (Z : Scheme.{u}) (g : Z ⟶ Spec (.of R)), Flat g →
      AlgebraicGeometry.IsReduced
        (Limits.pullback g (Spec.map (CommRingCat.ofHom (algebraMap R K)))) →
      AlgebraicGeometry.IsReduced Z := by
    intro R K _ _ _ hinj Z g hg hred
    have gen : ∀ (A : CommRingCat.{u}) (f : Spec A ⟶ Z), IsOpenImmersion f →
        AlgebraicGeometry.IsReduced (Spec A) := by
      intro A f hf
      have : Flat (f ≫ g) := inferInstance
      let φ := Spec.preimage (f ≫ g)
      have hφ : Spec.map φ = f ≫ g := Spec.map_preimage _
      have hflat : φ.hom.Flat := by
        rw [← HasRingHomProperty.Spec_iff (P := @Flat), hφ]; infer_instance
      letI : Algebra R A := φ.hom.toAlgebra
      have : Module.Flat R A := hflat
      have hι : Function.Injective
          (Algebra.TensorProduct.includeLeftRingHom : A →+* TensorProduct R A K) := by
        have h1 := Module.Flat.lTensor_preserves_injective_linearMap (M := A)
          (Algebra.linearMap R K) hinj
        have h2 : ⇑(Algebra.TensorProduct.includeLeftRingHom : A →+* TensorProduct R A K) =
            (LinearMap.lTensor A (Algebra.linearMap R K)) ∘ (TensorProduct.rid R A).symm := by
          funext a
          simp
        rw [h2]
        exact h1.comp (TensorProduct.rid R A).symm.injective
      have : AlgebraicGeometry.IsReduced (Limits.pullback f (Limits.pullback.fst g
          (Spec.map (CommRingCat.ofHom (algebraMap R K))))) :=
        isReduced_of_isOpenImmersion (Limits.pullback.snd f _)
      have hh : Spec.map (CommRingCat.ofHom (algebraMap R A)) = f ≫ g := by
        rw [RingHom.algebraMap_toAlgebra]; exact hφ
      let e : Spec (.of (TensorProduct R A K)) ≅ Limits.pullback f (Limits.pullback.fst g
          (Spec.map (CommRingCat.ofHom (algebraMap R K)))) :=
        (pullbackSpecIso R A K).symm ≪≫ Limits.pullback.congrHom hh rfl ≪≫
          (Limits.pullbackRightPullbackFstIso g _ f).symm
      have : AlgebraicGeometry.IsReduced (Spec (.of (TensorProduct R A K))) :=
        isReduced_of_isOpenImmersion e.hom
      have : _root_.IsReduced (TensorProduct R A K) :=
        (affine_isReduced_iff (CommRingCat.of (TensorProduct R A K))).mp inferInstance
      have : _root_.IsReduced A := isReduced_of_injective _ hι
      infer_instance
    have key : ∀ i, AlgebraicGeometry.IsReduced (Z.affineOpenCover.openCover.X i) := by
      intro i
      exact gen (Z.affineOpenCover.X i) (Z.affineOpenCover.openCover.f i)
        (Z.affineOpenCover.openCover.map_prop i)
    exact AlgebraicGeometry.IsReduced.of_openCover Z Z.affineOpenCover.openCover
  have hred := wcpa_dj_ldx_semistable_fibre_reduced Z (Spec (.of ↥W)) uu hss Ω
    (Spec.map (CommRingCat.ofHom (algebraMap (↥W) Ω)))
  exact flatGen (↥W) Ω (IsFractionRing.injective (↥W) Ω) Z uu hss.1 hred

theorem wcpa_dj_lccg_fibre_iso : ∀ {X₁ X Y₁ Y : Scheme.{u}} {φs : X₁ ⟶ Y₁} {f₁ : X₁ ⟶ X}
    {f₂ : Y₁ ⟶ Y} {φ : X ⟶ Y}, IsPullback φs f₁ f₂ φ → ∀ (U : Y.Opens) (K : Type u) [Field K]
    (t : Spec (.of K) ⟶ U.toScheme) (w : Spec (.of K) ⟶ Y₁), t ≫ U.ι = w ≫ f₂ →
    ∀ V : X₁.Opens, IsOpenImmersion (V.ι ≫ φs) →
    (∀ x : X₁, φs x = w (IsLocalRing.closedPoint K) → x ∈ V) →
    (∃ x : X₁, φs x = w (IsLocalRing.closedPoint K)) →
    IsIso (Limits.pullback.snd (φ ∣_ U) t) :=
by
  intro X₁ X Y₁ Y φs f₁ f₂ φ hPB U K _ t w htw V hVo hfib hex
  haveI := hVo

  obtain ⟨x₀, hx₀⟩ := hex
  have hx₀V : x₀ ∈ V := hfib x₀ hx₀
  have hrange : Set.range ⇑w ⊆ Set.range ⇑(V.ι ≫ φs) := by
    rintro _ ⟨p, rfl⟩
    have hp : p = IsLocalRing.closedPoint K := Subsingleton.elim _ _
    subst hp
    have hx₀r : x₀ ∈ Set.range ⇑V.ι := by rw [Scheme.Opens.range_ι]; exact hx₀V
    obtain ⟨y, hy⟩ := hx₀r
    exact ⟨y, by rw [Scheme.Hom.comp_apply, hy, hx₀]⟩
  obtain ⟨a, ha⟩ : ∃ a : Spec (.of K) ⟶ V.toScheme, a ≫ V.ι ≫ φs = w :=
    ⟨IsOpenImmersion.lift (V.ι ≫ φs) w hrange, IsOpenImmersion.lift_fac _ _ _⟩

  have hb : t ≫ U.ι = (a ≫ V.ι ≫ f₁) ≫ φ := by
    rw [htw, ← ha]
    simp only [Category.assoc, hPB.w]

  obtain ⟨c, hc1, hc2⟩ : ∃ c : Spec (.of K) ⟶ (φ ⁻¹ᵁ U).toScheme,
      c ≫ φ ∣_ U = t ∧ c ≫ (φ ⁻¹ᵁ U).ι = a ≫ V.ι ≫ f₁ :=
    ⟨(isPullback_morphismRestrict φ U).lift t _ hb, IsPullback.lift_fst _ _ _ _,
      IsPullback.lift_snd _ _ _ _⟩
  obtain ⟨s, hs1, hs2⟩ : ∃ s : Spec (.of K) ⟶ Limits.pullback (φ ∣_ U) t,
      s ≫ Limits.pullback.fst (φ ∣_ U) t = c ∧ s ≫ Limits.pullback.snd (φ ∣_ U) t = 𝟙 _ :=
    ⟨Limits.pullback.lift c (𝟙 _) (by rw [hc1, Category.id_comp]),
      Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩

  have hcrux : Limits.pullback.fst (φ ∣_ U) t ≫ (φ ⁻¹ᵁ U).ι =
      Limits.pullback.snd (φ ∣_ U) t ≫ a ≫ V.ι ≫ f₁ := by
    have hcomm : (Limits.pullback.snd (φ ∣_ U) t ≫ w) ≫ f₂ =
        (Limits.pullback.fst (φ ∣_ U) t ≫ (φ ⁻¹ᵁ U).ι) ≫ φ := by
      rw [Category.assoc, ← htw, ← Category.assoc, ← Limits.pullback.condition]
      simp only [Category.assoc, morphismRestrict_ι]
    obtain ⟨m, hm1, hm2⟩ : ∃ m : Limits.pullback (φ ∣_ U) t ⟶ X₁,
        m ≫ φs = Limits.pullback.snd (φ ∣_ U) t ≫ w ∧
        m ≫ f₁ = Limits.pullback.fst (φ ∣_ U) t ≫ (φ ⁻¹ᵁ U).ι :=
      ⟨hPB.lift _ _ hcomm, hPB.lift_fst _ _ _, hPB.lift_snd _ _ _⟩
    have hmr : Set.range ⇑m ⊆ Set.range ⇑V.ι := by
      rintro _ ⟨p, rfl⟩
      rw [Scheme.Opens.range_ι]
      apply hfib
      have hq : Limits.pullback.snd (φ ∣_ U) t p = IsLocalRing.closedPoint K :=
        Subsingleton.elim _ _
      rw [← Scheme.Hom.comp_apply, hm1, Scheme.Hom.comp_apply, hq]
    obtain ⟨m', hm'⟩ : ∃ m' : Limits.pullback (φ ∣_ U) t ⟶ V.toScheme, m' ≫ V.ι = m :=
      ⟨IsOpenImmersion.lift V.ι m hmr, IsOpenImmersion.lift_fac _ _ _⟩
    have hm'a : m' = Limits.pullback.snd (φ ∣_ U) t ≫ a := by
      rw [← cancel_mono (V.ι ≫ φs)]
      rw [← hm'] at hm1
      simp only [Category.assoc] at hm1 ⊢
      rw [hm1, ha]
    rw [← hm2, ← hm', hm'a]
    simp only [Category.assoc]

  have h5 : Limits.pullback.snd (φ ∣_ U) t ≫ s = 𝟙 _ := by
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, hs1, Category.id_comp, ← cancel_mono (φ ⁻¹ᵁ U).ι, Category.assoc,
        hc2, hcrux]
    · rw [Category.assoc, hs2, Category.comp_id, Category.id_comp]

  exact ⟨⟨s, h5, hs2⟩⟩

theorem wcpa_dj_lccg_finite_iso : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [IsFinite f] [IsReduced Y],
    (∀ y : Y, ∃ (K : Type u) (_ : Field K) (t : Spec (.of K) ⟶ Y),
      t (IsLocalRing.closedPoint K) = y ∧ IsIso (Limits.pullback.snd f t)) → IsIso f :=
by

  have s1 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens),
      (∀ y : Y, ∃ (K : Type u) (_ : Field K) (t : Spec (.of K) ⟶ Y),
        t (IsLocalRing.closedPoint K) = y ∧ IsIso (Limits.pullback.snd f t)) →
      ∀ y : U.toScheme, ∃ (K : Type u) (_ : Field K) (t : Spec (.of K) ⟶ U.toScheme),
        t (IsLocalRing.closedPoint K) = y ∧ IsIso (Limits.pullback.snd (f ∣_ U) t) := by
    intro X Y f U H y
    obtain ⟨K, _, t, ht, hiso⟩ := H (U.ι y)
    have hrange : Set.range ⇑t ⊆ Set.range ⇑U.ι := by
      rintro _ ⟨p, rfl⟩
      refine ⟨y, ?_⟩
      have hp : p = IsLocalRing.closedPoint K := Subsingleton.elim _ _
      rw [hp, ht]
    have hfac : IsOpenImmersion.lift U.ι t hrange ≫ U.ι = t := IsOpenImmersion.lift_fac _ _ _
    refine ⟨K, inferInstance, IsOpenImmersion.lift U.ι t hrange, ?_, ?_⟩
    · apply U.ι.isOpenEmbedding.injective
      have e := congrArg (fun g : Spec (.of K) ⟶ Y => g (IsLocalRing.closedPoint K)) hfac
      exact (Scheme.Hom.comp_apply _ _ _).symm.trans (e.trans ht)
    · have H1 := IsPullback.paste_horiz (IsPullback.of_hasPullback (f ∣_ U)
        (IsOpenImmersion.lift U.ι t hrange)) (isPullback_morphismRestrict f U).flip
      rw [hfac] at H1
      have e := H1.isoPullback_hom_snd
      rw [← e]
      infer_instance

  have s2 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) [IsAffine X] [IsAffine Y],
      (∀ y : Y, ∃ (K : Type u) (_ : Field K) (t : Spec (.of K) ⟶ Y),
        t (IsLocalRing.closedPoint K) = y ∧ IsIso (Limits.pullback.snd f t)) →
      ∀ p : PrimeSpectrum Γ(Y, ⊤), ∃ (K : Type u) (_ : Field K) (ψ : Γ(Y, ⊤) ⟶ CommRingCat.of K),
        RingHom.ker ψ.hom = p.asIdeal ∧
          IsIso (Limits.pullback.snd (Spec.map f.appTop) (Spec.map ψ)) := by
    intro X Y f _ _ H p
    obtain ⟨K, _, t, ht, hiso⟩ := H (Y.isoSpec.inv p)
    have hψm : Spec.map (Spec.preimage (t ≫ Y.isoSpec.hom)) = t ≫ Y.isoSpec.hom :=
      Spec.map_preimage _
    refine ⟨K, inferInstance, Spec.preimage (t ≫ Y.isoSpec.hom), ?_, ?_⟩
    · have h1 : (Spec.map (Spec.preimage (t ≫ Y.isoSpec.hom))) (IsLocalRing.closedPoint K) = p := by
        have e1 := congrArg
          (fun g : Spec (.of K) ⟶ Spec Γ(Y, ⊤) => g (IsLocalRing.closedPoint K)) hψm
        have e3 : (Y.isoSpec.inv ≫ Y.isoSpec.hom) p = p := by simp; rfl
        exact e1.trans ((Scheme.Hom.comp_apply _ _ _).trans ((congrArg Y.isoSpec.hom ht).trans
          ((Scheme.Hom.comp_apply _ _ _).symm.trans e3)))
      have h2 : ((Spec.map (Spec.preimage (t ≫ Y.isoSpec.hom))) (IsLocalRing.closedPoint K)).asIdeal
          = RingHom.ker (Spec.preimage (t ≫ Y.isoSpec.hom)).hom := by
        show Ideal.comap (Spec.preimage (t ≫ Y.isoSpec.hom)).hom (IsLocalRing.maximalIdeal K) = _
        rw [IsLocalRing.maximalIdeal_eq_bot, RingHom.ker_eq_comap_bot]
      rw [← h2, h1]
    · have eq₁ : f ≫ Y.isoSpec.hom = X.isoSpec.hom ≫ Spec.map f.appTop :=
        (Scheme.isoSpec_hom_naturality f).symm
      have eq₂ : t ≫ Y.isoSpec.hom = 𝟙 _ ≫ Spec.map (Spec.preimage (t ≫ Y.isoSpec.hom)) := by
        rw [Category.id_comp, hψm]
      have hg : Limits.pullback.map f t (Spec.map f.appTop)
          (Spec.map (Spec.preimage (t ≫ Y.isoSpec.hom)))
          X.isoSpec.hom (𝟙 _) Y.isoSpec.hom eq₁ eq₂ ≫
          Limits.pullback.snd (Spec.map f.appTop) (Spec.map (Spec.preimage (t ≫ Y.isoSpec.hom))) =
          Limits.pullback.snd f t ≫ 𝟙 _ := Limits.pullback.lift_snd _ _ _
      rw [Category.comp_id] at hg
      have e : Limits.pullback.snd (Spec.map f.appTop)
          (Spec.map (Spec.preimage (t ≫ Y.isoSpec.hom))) =
          inv (Limits.pullback.map f t (Spec.map f.appTop)
            (Spec.map (Spec.preimage (t ≫ Y.isoSpec.hom)))
            X.isoSpec.hom (𝟙 _) Y.isoSpec.hom eq₁ eq₂) ≫ Limits.pullback.snd f t := by
        rw [← hg, IsIso.inv_hom_id_assoc]
      rw [e]
      infer_instance

  have s3 : ∀ {R S : CommRingCat.{u}} (K : Type u) [Field K]
      (φ : R ⟶ S) (ψ : R ⟶ CommRingCat.of K),
      IsIso (Limits.pullback.snd (Spec.map φ) (Spec.map ψ)) →
      letI := φ.hom.toAlgebra
      letI := ψ.hom.toAlgebra
      Function.Bijective (Algebra.TensorProduct.includeRight (R := R) (A := S) (B := K)) := by
    intro R S K _ φ ψ h
    letI := φ.hom.toAlgebra
    letI := ψ.hom.toAlgebra
    have e := pullbackSpecIso_inv_snd R S K
    have h' : IsIso (Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap R S)))
        (Spec.map (CommRingCat.ofHom (algebraMap R K)))) := h
    have h3 : IsIso ((pullbackSpecIso R S K).inv ≫ Limits.pullback.snd
        (Spec.map (CommRingCat.ofHom (algebraMap R S)))
        (Spec.map (CommRingCat.ofHom (algebraMap R K)))) := inferInstance
    rw [e] at h3
    exact isIso_SpecMap_iff.mp h3

  have s4 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [_root_.IsReduced A],
      (∀ p : PrimeSpectrum A, ∃ (K : Type u) (_ : Field K) (_ : Algebra A K),
        RingHom.ker (algebraMap A K) = p.asIdeal ∧
          Function.Injective (Algebra.TensorProduct.includeRight (R := A) (A := B) (B := K))) →
      Function.Injective (algebraMap A B) := by
    intro A B _ _ _ _ H
    rw [injective_iff_map_eq_zero]
    intro a ha
    have hnil : IsNilpotent a := by
      rw [nilpotent_iff_mem_prime]
      intro J hJ
      obtain ⟨K, _, _, hker, hinj⟩ := H ⟨J, hJ⟩
      have h1 : (Algebra.TensorProduct.includeRight (R := A) (A := B) (B := K)) (algebraMap A K a)
          = (Algebra.TensorProduct.includeRight (R := A) (A := B) (B := K)) 0 := by
        rw [AlgHom.commutes, Algebra.TensorProduct.algebraMap_apply, ha, map_zero,
          TensorProduct.zero_tmul]
      have h2 := hinj h1
      have : a ∈ RingHom.ker (algebraMap A K) := h2
      rw [hker] at this
      exact this
    exact hnil.eq_zero

  have s5 : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [Module.Finite A B],
      (∀ p : PrimeSpectrum A, ∃ (K : Type u) (_ : Field K) (_ : Algebra A K),
        RingHom.ker (algebraMap A K) = p.asIdeal ∧
          Function.Surjective (Algebra.TensorProduct.includeRight (R := A) (A := B) (B := K))) →
      Function.Surjective (algebraMap A B) := by
    intro A B _ _ _ _ H
    classical
    set N : Submodule A B := LinearMap.range (Algebra.linearMap A B) with hN
    have h1N : (1 : B) ∈ N := ⟨1, by simp⟩
    have hC : Subsingleton (B ⧸ N) := by
      rw [← Module.support_eq_empty_iff (R := A)]
      rw [Set.eq_empty_iff_forall_notMem]
      intro p hp
      rw [Module.mem_support_iff_nontrivial_residueField_tensorProduct] at hp
      obtain ⟨K, _, _, hker, hsurj⟩ := H p
      have hCK : Subsingleton (TensorProduct A (B ⧸ N) K) := by
        constructor
        intro x y
        obtain ⟨x', rfl⟩ := LinearMap.rTensor_surjective K N.mkQ_surjective x
        obtain ⟨y', rfl⟩ := LinearMap.rTensor_surjective K N.mkQ_surjective y
        obtain ⟨k, rfl⟩ := hsurj x'
        obtain ⟨l, rfl⟩ := hsurj y'
        simp only [Algebra.TensorProduct.includeRight_apply, LinearMap.rTensor_tmul,
          Submodule.mkQ_apply, (Submodule.Quotient.mk_eq_zero N).mpr h1N, TensorProduct.zero_tmul]
      have hle : p.asIdeal ≤ RingHom.ker (algebraMap A K) := hker.ge
      letI : Algebra p.asIdeal.ResidueField K :=
        (Ideal.ResidueField.lift p.asIdeal (algebraMap A K) hle (fun x hx => by
          show IsUnit (algebraMap A K x)
          rw [isUnit_iff_ne_zero]
          intro h0
          apply hx
          rw [← hker]
          exact h0)).toAlgebra
      haveI : IsScalarTower A p.asIdeal.ResidueField K :=
        IsScalarTower.of_algebraMap_eq (fun r => by
          rw [RingHom.algebraMap_toAlgebra, Ideal.ResidueField.lift_algebraMap])
      have e := TensorProduct.AlgebraTensorModule.cancelBaseChange A p.asIdeal.ResidueField
        p.asIdeal.ResidueField K (B ⧸ N)
      have h2 : Subsingleton (TensorProduct p.asIdeal.ResidueField K
          (TensorProduct A p.asIdeal.ResidueField (B ⧸ N))) := by
        have e2 := (TensorProduct.comm A K (B ⧸ N)).toEquiv
        exact (e.toEquiv.trans e2).subsingleton
      have h3 := Module.FaithfullyFlat.lTensor_reflects_triviality p.asIdeal.ResidueField K
        (TensorProduct A p.asIdeal.ResidueField (B ⧸ N))
      exact (not_subsingleton _) h3
    intro b
    have : N.mkQ b = 0 := Subsingleton.elim _ _
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at this
    obtain ⟨a, ha⟩ := this
    exact ⟨a, ha⟩

  have affine_case : ∀ {X' Y' : Scheme.{u}} (g : X' ⟶ Y') [IsAffine X'] [IsAffine Y']
      [IsFinite g] [IsReduced Y'],
      (∀ y : Y', ∃ (K : Type u) (_ : Field K) (t : Spec (.of K) ⟶ Y'),
        t (IsLocalRing.closedPoint K) = y ∧ IsIso (Limits.pullback.snd g t)) → IsIso g := by
    intro X' Y' g _ _ _ _ H
    letI := g.appTop.hom.toAlgebra
    haveI hfin : Module.Finite Γ(Y', ⊤) Γ(X', ⊤) := Scheme.Hom.finite_appTop g
    have hinj : Function.Injective g.appTop.hom := by
      refine s4 Γ(Y', ⊤) Γ(X', ⊤) (fun p => ?_)
      obtain ⟨K, _, ψ, hker, hiso⟩ := s2 g H p
      exact ⟨K, inferInstance, ψ.hom.toAlgebra, hker, (s3 K g.appTop ψ hiso).1⟩
    have hsurj : Function.Surjective g.appTop.hom := by
      refine s5 Γ(Y', ⊤) Γ(X', ⊤) (fun p => ?_)
      obtain ⟨K, _, ψ, hker, hiso⟩ := s2 g H p
      exact ⟨K, inferInstance, ψ.hom.toAlgebra, hker, (s3 K g.appTop ψ hiso).2⟩
    haveI : IsIso (Spec.map g.appTop) := isIso_SpecMap_iff.mpr ⟨hinj, hsurj⟩
    have e := Scheme.isoSpec_hom_naturality g
    have hg : g = X'.isoSpec.hom ≫ Spec.map g.appTop ≫ Y'.isoSpec.inv := by
      rw [← Category.assoc, e, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    rw [hg]
    infer_instance

  intro X Y f _ _ H
  rw [← MorphismProperty.isomorphisms.iff,
    IsZariskiLocalAtTarget.iff_of_iSup_eq_top (P := MorphismProperty.isomorphisms Scheme)
      (fun U : Y.affineOpens => (U : Y.Opens)) (iSup_affineOpens_eq_top Y)]
  intro U
  rw [MorphismProperty.isomorphisms.iff]
  haveI : IsAffine (f ⁻¹ᵁ (U : Y.Opens)).toScheme := isAffine_of_isAffineHom (f ∣_ (U : Y.Opens))
  exact affine_case (f ∣_ (U : Y.Opens)) (s1 f U H)

theorem wcpa_dj_lcc_globalize : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ Z : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W))
    (uu : Z ⟶ Spec (.of ↥W)) (φ : Z₁ ⟶ Z) (r : ℕ) (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)),
    φ ≫ uu = u₁ → wcpaDjSemistable u₁ → wcpaDjSemistable uu → wcpaLccFib u₁ uu φ ε →
    Surjective φ ∧
      ∃ V₁ : Z₁.Opens, IsOpenImmersion (V₁.ι ≫ φ) ∧ ⇑φ ⁻¹' (⇑φ '' (V₁ : Set Z₁)) = V₁ ∧
        ∀ z : Z₁, z ∉ V₁ → ∃ (K : Type u) (_ : Field K) (_ : IsAlgClosed K)
          (s : Spec (.of K) ⟶ Spec (.of ↥W)) (y : ↥(Limits.pullback u₁ s))
          (E : Set ↥(Limits.pullback u₁ s)),
          Limits.pullback.fst u₁ s y = z ∧ y ∈ E ∧
          E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) ∧
          (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) :=
by
  intro Ω _ _ W Z₁ Z u₁ uu φ r ε hφ hss₁ hss hfib
  classical

  haveI hp₁ : IsProper u₁ := hss₁.2.1
  haveI hpu : IsProper uu := hss.2.1
  haveI : IsProper (φ ≫ uu) := by rw [hφ]; exact hp₁
  haveI hφp : IsProper φ := IsProper.of_comp φ uu
  have apeq : ∀ {A B : Scheme.{u}} {f g : A ⟶ B}, f = g → ∀ x, f x = g x := by
    intro A B f g h x; rw [h]

  have geom : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) (x₁ x₂ : X), g x₁ = g x₂ →
      ∃ (K : Type u) (_ : Field K) (_ : IsAlgClosed K) (a₁ a₂ : Spec (.of K) ⟶ X),
        a₁ ≫ g = a₂ ≫ g ∧ a₁ (IsLocalRing.closedPoint K) = x₁ ∧
        a₂ (IsLocalRing.closedPoint K) = x₂ := by
    intro X Y g x₁ x₂ hx
    obtain ⟨p, -, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := X.fromSpecResidueField x₁ ≫ g) (g := X.fromSpecResidueField x₂ ≫ g)
      (IsLocalRing.closedPoint (X.residueField x₁)) (IsLocalRing.closedPoint (X.residueField x₂))
      ((Scheme.Hom.comp_apply _ _ _).trans ((congrArg g (Scheme.fromSpecResidueField_apply _ _)).trans
        (hx.trans ((congrArg g (Scheme.fromSpecResidueField_apply _ _)).symm.trans
          (Scheme.Hom.comp_apply _ _ _).symm))))
    have hc := Limits.pullback.condition (f := X.fromSpecResidueField x₁ ≫ g)
      (g := X.fromSpecResidueField x₂ ≫ g)
    set P := Limits.pullback (X.fromSpecResidueField x₁ ≫ g) (X.fromSpecResidueField x₂ ≫ g)
      with hP
    let b : Spec (.of (AlgebraicClosure (P.residueField p))) ⟶ P :=
      Spec.map (CommRingCat.ofHom (algebraMap (P.residueField p)
        (AlgebraicClosure (P.residueField p)))) ≫ P.fromSpecResidueField p
    refine ⟨AlgebraicClosure (P.residueField p), inferInstance, inferInstance,
      (b ≫ Limits.pullback.fst _ _) ≫ X.fromSpecResidueField x₁,
      (b ≫ Limits.pullback.snd _ _) ≫ X.fromSpecResidueField x₂, ?_, ?_, ?_⟩
    · simp only [Category.assoc]
      rw [hc]
    · exact (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)
    · exact (Scheme.Hom.comp_apply _ _ _).trans (Scheme.fromSpecResidueField_apply _ _)

  have collapse : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) [LocallyOfFiniteType g] (x : X) (E : Set X),
      g.QuasiFiniteAt x → IsPreirreducible E → x ∈ E → (∀ e ∈ E, g e = g x) → E ⊆ {x} := by
    intro X Y g _ x E hx hE hxE hEg
    have hxmem : x ∈ g ⁻¹' {g x} := Set.mem_preimage.mpr (Set.mem_singleton _)
    have hkey : g.fiberHomeo (g x) (g.asFiber x) = ⟨x, hxmem⟩ :=
      Subtype.ext (by rw [Scheme.Hom.fiberHomeo_apply, Scheme.Hom.fiberι_asFiber])
    have hcl : IsClopen ((g.fiberHomeo (g x)).symm ⁻¹' {g.asFiber x}) :=
      (Scheme.Hom.QuasiFiniteAt.isClopen_singleton_asFiber g hx).preimage
        (g.fiberHomeo (g x)).symm.continuous
    have hE' : _root_.IsPreconnected ((Subtype.val : g ⁻¹' {g x} → X) ⁻¹' E) := by
      refine Topology.IsInducing.subtypeVal.isPreconnected_image.mp ?_
      rw [Subtype.image_preimage_coe, Set.inter_eq_right.mpr
        (fun e he => Set.mem_preimage.mpr (Set.mem_singleton_iff.mpr (hEg e he)))]
      exact hE.isPreconnected
    have hmem : (⟨x, hxmem⟩ : g ⁻¹' {g x}) ∈ (g.fiberHomeo (g x)).symm ⁻¹' {g.asFiber x} := by
      show (g.fiberHomeo (g x)).symm ⟨x, hxmem⟩ = g.asFiber x
      rw [← hkey, Homeomorph.symm_apply_apply]
    have hsub := hE'.subset_isClopen hcl ⟨⟨x, hxmem⟩, hxE, hmem⟩
    intro e he
    have hemem : e ∈ g ⁻¹' {g x} := Set.mem_preimage.mpr (Set.mem_singleton_iff.mpr (hEg e he))
    have h2 : (g.fiberHomeo (g x)).symm ⟨e, hemem⟩ = g.asFiber x :=
      hsub (show (⟨e, hemem⟩ : g ⁻¹' {g x}) ∈ (Subtype.val : g ⁻¹' {g x} → X) ⁻¹' E from he)
    have h3 := congrArg (g.fiberHomeo (g x)) h2
    rw [Homeomorph.apply_symm_apply, hkey] at h3
    exact Set.mem_singleton_iff.mpr (congrArg Subtype.val h3)

  have mk : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥W)),
      ∃ φs : Limits.pullback u₁ s ⟶ Limits.pullback uu s,
        φs ≫ Limits.pullback.fst uu s = Limits.pullback.fst u₁ s ≫ φ ∧
        φs ≫ Limits.pullback.snd uu s = Limits.pullback.snd u₁ s ∧
        IsPullback φs (Limits.pullback.fst u₁ s) (Limits.pullback.fst uu s) φ := by
    intro K _ s
    refine ⟨Limits.pullback.lift (Limits.pullback.fst u₁ s ≫ φ) (Limits.pullback.snd u₁ s)
      (by rw [Category.assoc, hφ, Limits.pullback.condition]), Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _, ?_⟩
    refine IsPullback.of_right ?_ (Limits.pullback.lift_fst _ _ _)
      (IsPullback.of_hasPullback uu s).flip
    rw [Limits.pullback.lift_snd, hφ]
    exact (IsPullback.of_hasPullback u₁ s).flip

  have pair : ∀ z z' : Z₁, φ z = φ z' → ∃ (K : Type u) (_ : Field K) (_ : IsAlgClosed K)
      (s : Spec (.of K) ⟶ Spec (.of ↥W)) (φs : Limits.pullback u₁ s ⟶ Limits.pullback uu s)
      (y₁ y₂ : ↥(Limits.pullback u₁ s)),
      φs ≫ Limits.pullback.fst uu s = Limits.pullback.fst u₁ s ≫ φ ∧
      φs ≫ Limits.pullback.snd uu s = Limits.pullback.snd u₁ s ∧
      IsPullback φs (Limits.pullback.fst u₁ s) (Limits.pullback.fst uu s) φ ∧
      Limits.pullback.fst u₁ s y₁ = z ∧ Limits.pullback.fst u₁ s y₂ = z' ∧ φs y₁ = φs y₂ := by
    intro z z' hzz'
    obtain ⟨K, _, _, a₁, a₂, ha, ha₁, ha₂⟩ := geom φ z z' hzz'
    have hs₂ : a₂ ≫ u₁ = a₁ ≫ u₁ := by rw [← hφ, ← Category.assoc, ← Category.assoc, ha]
    obtain ⟨s, hs⟩ : ∃ s, s = a₁ ≫ u₁ := ⟨_, rfl⟩
    obtain ⟨φs, h1, h2, hPB⟩ := mk K s
    obtain ⟨l₁, hl₁f, hl₁s⟩ : ∃ l : Spec (.of K) ⟶ Limits.pullback u₁ s,
        l ≫ Limits.pullback.fst u₁ s = a₁ ∧ l ≫ Limits.pullback.snd u₁ s = 𝟙 _ :=
      ⟨Limits.pullback.lift a₁ (𝟙 _) (by rw [Category.id_comp, hs]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨l₂, hl₂f, hl₂s⟩ : ∃ l : Spec (.of K) ⟶ Limits.pullback u₁ s,
        l ≫ Limits.pullback.fst u₁ s = a₂ ∧ l ≫ Limits.pullback.snd u₁ s = 𝟙 _ :=
      ⟨Limits.pullback.lift a₂ (𝟙 _) (by rw [Category.id_comp, hs, hs₂]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hl : l₁ ≫ φs = l₂ ≫ φs := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Category.assoc, h1, reassoc_of% hl₁f, reassoc_of% hl₂f, ha]
      · rw [Category.assoc, Category.assoc, h2, hl₁s, hl₂s]
    refine ⟨K, inferInstance, inferInstance, s, φs, l₁ (IsLocalRing.closedPoint K),
      l₂ (IsLocalRing.closedPoint K), h1, h2, hPB, ?_, ?_, ?_⟩
    · exact (Scheme.Hom.comp_apply _ _ _).symm.trans ((apeq hl₁f _).trans ha₁)
    · exact (Scheme.Hom.comp_apply _ _ _).symm.trans ((apeq hl₂f _).trans ha₂)
    · exact (Scheme.Hom.comp_apply _ _ _).symm.trans ((apeq hl _).trans
        (Scheme.Hom.comp_apply _ _ _))

  have hsurj : Function.Surjective φ := by
    intro q
    obtain ⟨K, _, _, a, _, _, ha, _⟩ := geom (𝟙 Z) q q rfl
    obtain ⟨s, hs⟩ : ∃ s, s = a ≫ uu := ⟨_, rfl⟩
    obtain ⟨φs, h1, h2, -⟩ := mk K s
    obtain ⟨hF1, -⟩ := hfib K s φs h1 h2
    obtain ⟨w, hwf, -⟩ : ∃ w : Spec (.of K) ⟶ Limits.pullback uu s,
        w ≫ Limits.pullback.fst uu s = a ∧ w ≫ Limits.pullback.snd uu s = 𝟙 _ :=
      ⟨Limits.pullback.lift a (𝟙 _) (by rw [Category.id_comp, hs]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    obtain ⟨y, hy⟩ := hF1 (w (IsLocalRing.closedPoint K))
    refine ⟨Limits.pullback.fst u₁ s y, ?_⟩
    calc φ (Limits.pullback.fst u₁ s y) = (Limits.pullback.fst u₁ s ≫ φ) y :=
          (Scheme.Hom.comp_apply _ _ _).symm
      _ = (φs ≫ Limits.pullback.fst uu s) y := (apeq h1 y).symm
      _ = Limits.pullback.fst uu s (φs y) := Scheme.Hom.comp_apply _ _ _
      _ = Limits.pullback.fst uu s (w (IsLocalRing.closedPoint K)) := congrArg _ hy
      _ = (w ≫ Limits.pullback.fst uu s) (IsLocalRing.closedPoint K) :=
          (Scheme.Hom.comp_apply _ _ _).symm
      _ = a (IsLocalRing.closedPoint K) := apeq hwf _
      _ = q := ha

  have claimC : ∀ z z' : Z₁, φ.QuasiFiniteAt z → φ z = φ z' → z = z' := by
    intro z z' hz hzz'
    obtain ⟨K, _, _, s, φs, y₁, y₂, h1, h2, hPB, hy₁, hy₂, hy⟩ := pair z z' hzz'
    obtain ⟨-, -, hF2, hF3, -⟩ := hfib K s φs h1 h2
    rcases hF2 y₁ y₂ hy with h | ⟨E, hE, hAF, hy₁E, hy₂E⟩
    · rw [← hy₁, ← hy₂, h]
    · haveI : LocallyOfFiniteType φs :=
        MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) hPB.flip inferInstance
      have hqf : φs.QuasiFiniteAt y₁ :=
        wcpa_dj_lccg_qf_basechange hPB.flip inferInstance y₁ (by rw [hy₁]; exact hz)
      have hsub := collapse φs y₁ E hqf hE.1.isPreirreducible hy₁E
        (fun e he => hF3 E hE hAF e he y₁ hy₁E)
      have h21 : y₂ = y₁ := hsub hy₂E
      rw [← hy₁, ← hy₂, h21]

  have offlocus : ∀ z : Z₁, ¬ φ.QuasiFiniteAt z → ∃ (K : Type u) (_ : Field K)
      (_ : IsAlgClosed K) (s : Spec (.of K) ⟶ Spec (.of ↥W)) (y : ↥(Limits.pullback u₁ s))
      (E : Set ↥(Limits.pullback u₁ s)),
      Limits.pullback.fst u₁ s y = z ∧ y ∈ E ∧
      E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) ∧
      (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) := by
    intro z hz
    by_contra hno
    apply hz
    have hfibre : ∀ z' : Z₁, φ z' = φ z → z' = z := by
      intro z' hz'
      obtain ⟨K, _, _, s, φs, y₁, y₂, h1, h2, hPB, hy₁, hy₂, hy⟩ := pair z z' hz'.symm
      obtain ⟨-, -, hF2, -⟩ := hfib K s φs h1 h2
      rcases hF2 y₁ y₂ hy with h | ⟨E, hE, hAF, hy₁E, -⟩
      · rw [← hy₁, ← hy₂, h]
      · exact (hno ⟨K, inferInstance, inferInstance, s, y₁, E, hy₁, hy₁E, hE, hAF⟩).elim
    rw [Scheme.Hom.quasiFiniteAt_iff_isOpen_singleton_asFiber]
    have huniv : ({φ.asFiber z} : Set ↥(φ.fiber (φ z))) = Set.univ := by
      refine Set.eq_univ_of_forall fun p => ?_
      rw [Set.mem_singleton_iff]
      apply (φ.fiberHomeo (φ z)).injective
      apply Subtype.ext
      rw [Scheme.Hom.fiberHomeo_apply, Scheme.Hom.fiberHomeo_apply, Scheme.Hom.fiberι_asFiber]
      apply hfibre
      have hp := ((φ.fiberHomeo (φ z)) p).2
      rw [Scheme.Hom.fiberHomeo_apply] at hp
      exact hp
    rw [huniv]
    exact isOpen_univ

  have hcl : IsClosed (⇑φ '' ((φ.quasiFiniteLocus : Set Z₁)ᶜ)) :=
    φ.isClosedMap _ φ.quasiFiniteLocus.isOpen.isClosed_compl
  obtain ⟨U₂, hU₂⟩ : ∃ U : Z.Opens, (U : Set Z) = (⇑φ '' ((φ.quasiFiniteLocus : Set Z₁)ᶜ))ᶜ :=
    ⟨⟨_, hcl.isOpen_compl⟩, rfl⟩
  have hU₂mem : ∀ y : Z, y ∈ U₂ ↔ y ∉ ⇑φ '' ((φ.quasiFiniteLocus : Set Z₁)ᶜ) := by
    intro y
    rw [← SetLike.mem_coe, hU₂, Set.mem_compl_iff]
  have hV₁ : ∀ z, z ∈ φ ⁻¹ᵁ U₂ ↔ φ.QuasiFiniteAt z := by
    intro z
    rw [Scheme.Hom.mem_preimage, hU₂mem]
    constructor
    · intro h
      by_contra hz
      exact h ⟨z, fun hzQ => hz (Scheme.Hom.mem_quasiFiniteLocus.mp hzQ), rfl⟩
    · rintro hz ⟨t, ht, htz⟩
      have hzt := claimC z t hz htz.symm
      subst hzt
      exact ht (Scheme.Hom.mem_quasiFiniteLocus.mpr hz)
  have hsat : ⇑φ ⁻¹' (⇑φ '' ((φ ⁻¹ᵁ U₂ : Z₁.Opens) : Set Z₁)) =
      ((φ ⁻¹ᵁ U₂ : Z₁.Opens) : Set Z₁) := by
    ext z
    constructor
    · rintro ⟨v, hv, hvz⟩
      have hvz' := claimC v z ((hV₁ v).mp hv) hvz
      subst hvz'
      exact hv
    · intro hz
      exact ⟨z, hz, rfl⟩
  have hlast : ∀ z : Z₁, z ∉ φ ⁻¹ᵁ U₂ → ∃ (K : Type u) (_ : Field K) (_ : IsAlgClosed K)
      (s : Spec (.of K) ⟶ Spec (.of ↥W)) (y : ↥(Limits.pullback u₁ s))
      (E : Set ↥(Limits.pullback u₁ s)),
      Limits.pullback.fst u₁ s y = z ∧ y ∈ E ∧
      E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) ∧
      (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) :=
    fun z hz => offlocus z (fun h => hz ((hV₁ z).mpr h))

  have hinj : Function.Injective ⇑(φ ∣_ U₂) := by
    intro a b hab
    have e : ∀ c, U₂.ι ((φ ∣_ U₂) c) = φ ((φ ⁻¹ᵁ U₂).ι c) := fun c => by
      rw [← Scheme.Hom.comp_apply, morphismRestrict_ι, Scheme.Hom.comp_apply]
    have h1 : φ ((φ ⁻¹ᵁ U₂).ι a) = φ ((φ ⁻¹ᵁ U₂).ι b) := by rw [← e, ← e, hab]
    have hmem : (φ ⁻¹ᵁ U₂).ι a ∈ φ ⁻¹ᵁ U₂ := by
      rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι]
      exact ⟨a, rfl⟩
    exact (φ ⁻¹ᵁ U₂).ι.isOpenEmbedding.injective (claimC _ _ ((hV₁ _).mp hmem) h1)
  haveI : LocallyQuasiFinite (φ ∣_ U₂) := LocallyQuasiFinite.of_injective hinj
  haveI : IsFinite (φ ∣_ U₂) := IsFinite.of_isProper_of_locallyQuasiFinite _

  haveI : IsReduced Z := wcpa_dj_lccg_reduced Ω W Z uu hss

  haveI hiso : IsIso (φ ∣_ U₂) := by
    apply wcpa_dj_lccg_finite_iso
    intro q
    obtain ⟨z, hz⟩ := hsurj (U₂.ι q)
    have hqU : U₂.ι q ∈ U₂ := by
      rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι]
      exact ⟨q, rfl⟩
    have hzQ : φ.QuasiFiniteAt z := (hV₁ z).mp (by rw [Scheme.Hom.mem_preimage, hz]; exact hqU)
    obtain ⟨K, _, _, a, _, _, ha, _⟩ := geom φ z z rfl
    obtain ⟨s, hs⟩ : ∃ s, s = a ≫ u₁ := ⟨_, rfl⟩
    obtain ⟨φs, h1, h2, hPB⟩ := mk K s
    obtain ⟨hF1, -, -, hF3, ⟨V, hV, hVo⟩, -⟩ := hfib K s φs h1 h2
    obtain ⟨w, hwf, -⟩ : ∃ w : Spec (.of K) ⟶ Limits.pullback uu s,
        w ≫ Limits.pullback.fst uu s = a ≫ φ ∧ w ≫ Limits.pullback.snd uu s = 𝟙 _ :=
      ⟨Limits.pullback.lift (a ≫ φ) (𝟙 _) (by rw [Category.id_comp, hs, Category.assoc, hφ]),
        Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
    have hrange : Set.range ⇑(a ≫ φ) ⊆ Set.range ⇑U₂.ι := by
      rintro _ ⟨p, rfl⟩
      refine ⟨q, ?_⟩
      have hp : p = IsLocalRing.closedPoint K := Subsingleton.elim _ _
      subst hp
      exact (hz.symm.trans (congrArg φ ha.symm)).trans (Scheme.Hom.comp_apply _ _ _).symm
    have ht : IsOpenImmersion.lift U₂.ι (a ≫ φ) hrange ≫ U₂.ι = a ≫ φ :=
      IsOpenImmersion.lift_fac _ _ _
    refine ⟨K, inferInstance, IsOpenImmersion.lift U₂.ι (a ≫ φ) hrange, ?_, ?_⟩
    · apply U₂.ι.isOpenEmbedding.injective
      exact (Scheme.Hom.comp_apply _ _ _).symm.trans ((apeq ht _).trans
        ((Scheme.Hom.comp_apply _ _ _).trans ((congrArg φ ha).trans hz)))
    · refine wcpa_dj_lccg_fibre_iso hPB U₂ K _ w (by rw [ht, hwf]) V hVo ?_ (hF1 _)
      intro x hx
      have hfx : φ (Limits.pullback.fst u₁ s x) = φ z :=
        calc φ (Limits.pullback.fst u₁ s x) = (Limits.pullback.fst u₁ s ≫ φ) x :=
              (Scheme.Hom.comp_apply _ _ _).symm
          _ = (φs ≫ Limits.pullback.fst uu s) x := (apeq h1 x).symm
          _ = Limits.pullback.fst uu s (φs x) := Scheme.Hom.comp_apply _ _ _
          _ = Limits.pullback.fst uu s (w (IsLocalRing.closedPoint K)) := congrArg _ hx
          _ = (w ≫ Limits.pullback.fst uu s) (IsLocalRing.closedPoint K) :=
              (Scheme.Hom.comp_apply _ _ _).symm
          _ = (a ≫ φ) (IsLocalRing.closedPoint K) := apeq hwf _
          _ = φ (a (IsLocalRing.closedPoint K)) := Scheme.Hom.comp_apply _ _ _
          _ = φ z := congrArg φ ha
      have hxz : Limits.pullback.fst u₁ s x = z := (claimC z _ hzQ hfx.symm).symm
      haveI : LocallyOfFiniteType φs :=
        MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) hPB.flip inferInstance
      have hqf : φs.QuasiFiniteAt x :=
        wcpa_dj_lccg_qf_basechange hPB.flip inferInstance x (by rw [hxz]; exact hzQ)
      refine (hV x).mpr fun E hE hAF hxE => ?_
      have hsub := collapse φs x E hqf hE.1.isPreirreducible hxE
        (fun e he => hF3 E hE hAF e he x hxE)
      obtain ⟨y', hy'E, hy'⟩ := wcpa_dj_lccg_component_nontrivial u₁ hss₁ K s E hE x hxE
      exact hy' (hsub hy'E)

  refine ⟨⟨hsurj⟩, φ ⁻¹ᵁ U₂, ?_, hsat, hlast⟩
  rw [← morphismRestrict_ι]
  infer_instance

theorem wcpa_dj_lfc_contract_construct : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (r : ℕ)
    (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)) (L : wcpaDjCoc Z₁)
    (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)),
    wcpaDjSemistable u₁ → wcpaDjSections u₁ r ε → wcpaDjCocOK L →
    wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) 1 t →
    (∀ a, (Z₁.basicOpen (t a) : Set Z₁) =
      ((L.V a ⊓ u₁ ⁻¹ᵁ ⊤ : Z₁.Opens) : Set Z₁) \ ⋃ i, Set.range ⇑(ε i)) →
    (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Spec (.of ↥W))
      (E : Set ↥(Limits.pullback u₁ s)), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
      (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
      (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u₁ s)
        (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
        θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
        ι ≫ Limits.pullback.snd u₁ s) ∧
      1 ≤ (E ∩ closure Eᶜ).ncard ∧ (E ∩ closure Eᶜ).ncard ≤ 2 ∧
      ∀ E' : Set ↥(Limits.pullback u₁ s), E' ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
        (∀ b, ¬ ∃ x ∈ E', ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
        E' = E) →
    ∃ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (φ : Z₁ ⟶ Z),
      φ ≫ uu = u₁ ∧ wcpaDjSemistable uu ∧ LocallyOfFinitePresentation uu ∧ Surjective φ ∧
      (∃ V₁ : Z₁.Opens, IsOpenImmersion (V₁.ι ≫ φ) ∧ ⇑φ ⁻¹' (⇑φ '' (V₁ : Set Z₁)) = V₁ ∧
        ∀ z : Z₁, z ∉ V₁ → ∃ (K : Type u) (_ : Field K) (_ : IsAlgClosed K)
          (s : Spec (.of K) ⟶ Spec (.of ↥W)) (y : ↥(Limits.pullback u₁ s))
          (E : Set ↥(Limits.pullback u₁ s)),
          Limits.pullback.fst u₁ s y = z ∧ y ∈ E ∧
          E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) ∧
          (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q))) ∧
      ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Spec (.of ↥W))
        (φs : Limits.pullback u₁ s ⟶ Limits.pullback uu s),
        φs ≫ Limits.pullback.fst uu s = Limits.pullback.fst u₁ s ≫ φ →
        φs ≫ Limits.pullback.snd uu s = Limits.pullback.snd u₁ s →
        Function.Surjective ⇑φs ∧
        (∀ C : Set ↥(Limits.pullback uu s), C ∈ irreducibleComponents ↥(Limits.pullback uu s) →
          (C ∩ closure Cᶜ).Finite) ∧
        (∀ x y : ↥(Limits.pullback u₁ s), φs x = φs y → x = y ∨
          ∃ E : Set ↥(Limits.pullback u₁ s), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) ∧
            (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) ∧
            x ∈ E ∧ y ∈ E) ∧
        (∀ E : Set ↥(Limits.pullback u₁ s), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
          (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
          ∀ x ∈ E, ∀ y ∈ E, φs x = φs y) ∧
        (∃ V : (Limits.pullback u₁ s).Opens,
          (∀ x : ↥(Limits.pullback u₁ s), x ∈ V ↔ ∀ E : Set ↥(Limits.pullback u₁ s),
            E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
            (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
            x ∉ E) ∧
          IsOpenImmersion (V.ι ≫ φs)) ∧
        (∀ E : Set ↥(Limits.pullback u₁ s), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
          (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
          (E ∩ closure Eᶜ).ncard = 1 → ∀ x ∈ E, ∃ W' : (Limits.pullback uu s).Opens,
            φs x ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ Limits.pullback.snd uu s)) ∧
        (∀ E' : Set ↥(Limits.pullback u₁ s), E' ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
          ¬ (∀ b, ¬ ∃ x ∈ E', ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
          ⇑φs '' E' ∈ irreducibleComponents ↥(Limits.pullback uu s) ∧
          ((∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback uu s)
            (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra),
            IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = ⇑φs '' E' ∧
            θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
                (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
            ι ≫ Limits.pullback.snd uu s) →
          (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u₁ s)
            (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra),
            IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E' ∧
            θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
                (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
            ι ≫ Limits.pullback.snd u₁ s) ∧ Set.InjOn ⇑φs E')) ∧
        ∀ C : Set ↥(Limits.pullback uu s), C ∈ irreducibleComponents ↥(Limits.pullback uu s) →
          ∃ E' : Set ↥(Limits.pullback u₁ s), E' ∈ irreducibleComponents ↥(Limits.pullback u₁ s) ∧
            ¬ (∀ b, ¬ ∃ x ∈ E', ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) ∧
            C = ⇑φs '' E' :=
by
  intro Ω _ _ W Z₁ u₁ r ε L t hss hsec hOK hcompat hbo hAF
  obtain ⟨m, hm, hBC, hGG⟩ :=
    wcpa_dj_lcc_good_exponent Ω W Z₁ u₁ r ε L t hss hsec hOK hcompat hbo hAF
  obtain ⟨Z, uu, φ, hφ, hssZ, hlfp, hfib⟩ :=
    wcpa_dj_lcc_contraction_model Ω W Z₁ u₁ r ε L t hss hsec hOK hcompat hbo hAF m hm hBC hGG
  obtain ⟨hsurj, hV₁⟩ := wcpa_dj_lcc_globalize Ω W Z₁ Z u₁ uu φ r ε hφ hss hssZ hfib
  exact ⟨Z, uu, φ, hφ, hssZ, hlfp, hsurj, hV₁, hfib⟩

theorem wcpa_dj_lfcs_smooth_push : ∀ (A B T : Scheme.{u}) (p : A ⟶ T) (q : B ⟶ T) (h : A ⟶ B) (V O : A.Opens) (x : ↥A), h ≫ q = p → IsOpenImmersion (V.ι ≫ h) → x ∈ V → x ∈ O → SmoothOfRelativeDimension 1 (O.ι ≫ p) → ∃ W' : B.Opens, h x ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ q) :=
by
  intro A B T p q h V O x hhq hV hxV hxO hsm
  haveI := hV
  let e : (V ⊓ O : A.Opens).toScheme ⟶ B := A.homOfLE (inf_le_left : V ⊓ O ≤ V) ≫ (V.ι ≫ h)
  haveI : IsOpenImmersion e := inferInstance
  have he : e = (V ⊓ O).ι ≫ h := by
    simp only [e, ← Category.assoc, Scheme.homOfLE_ι]
  refine ⟨e.opensRange, ?_, ?_⟩
  · have hmem : x ∈ V ⊓ O := TopologicalSpace.Opens.mem_inf.mpr ⟨hxV, hxO⟩
    have hr : x ∈ Set.range (V ⊓ O).ι := by
      rw [Scheme.Opens.range_ι]; exact hmem
    obtain ⟨y, hy⟩ := hr
    have hpt : e y = h x := by
      rw [he, Scheme.Hom.comp_apply, hy]
    show h x ∈ (e.opensRange : Set B)
    rw [Scheme.Hom.coe_opensRange]
    exact ⟨y, hpt⟩
  · have hι : e.opensRange.ι = (Scheme.Hom.isoOpensRange e).inv ≫ e :=
      (Scheme.Hom.isoOpensRange_inv_comp e).symm
    have heq : e ≫ q = A.homOfLE (inf_le_right : V ⊓ O ≤ O) ≫ (O.ι ≫ p) := by
      rw [he, ← hhq]
      simp only [Category.assoc, Scheme.homOfLE_ι_assoc]
    have key : e.opensRange.ι ≫ q = ((Scheme.Hom.isoOpensRange e).inv ≫
        A.homOfLE (inf_le_right : V ⊓ O ≤ O)) ≫ (O.ι ≫ p) := by
      rw [hι, Category.assoc, heq, Category.assoc]
    rw [key]
    exact HasRingHomProperty.comp_of_isOpenImmersion _ _ _ hsm

theorem wcpa_dj_lfcs_top_contract_count : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] (f : X → Y) (k : ℕ) (a : Fin k → X → Prop) (b : Fin k → Y → Prop) (E' Es : Set X), Continuous f → IsClosed E' → IsPreirreducible E' → IsClosed Es → ¬ E' ⊆ Es → Set.InjOn f E' → (∀ x ∈ Es, ∀ y ∈ Es, f x = f y) → (∀ x y, f x = f y → x = y ∨ (x ∈ Es ∧ y ∈ Es)) → (∀ i x, a i x → b i (f x)) → (∀ i x y, a i x → a i y → x = y) → (∀ i, ∀ x ∈ E', x ∈ Es → ¬ a i x) → (Es.Nonempty → (Es ∩ closure Esᶜ).ncard + Nat.card {i : Fin k // ∃ x ∈ Es, a i x} = 2 ∧ 1 ≤ (Es ∩ closure Esᶜ).ncard) → ((f '' E') ∩ closure (f '' E')ᶜ).Finite → (E' ∩ closure E'ᶜ).ncard + Nat.card {i : Fin k // ∃ x ∈ E', a i x} ≤ ((f '' E') ∩ closure (f '' E')ᶜ).ncard + Nat.card {i : Fin k // ∃ y ∈ f '' E', b i y} :=
by
  intro X Y _ _ f k a b E' Es hf hE'c _ hEsc _ hinj hH2 hH3 hHab hH11 hH9 hEs hfin
  classical
  have himS : f '' (Esᶜ ∩ E'ᶜ) ⊆ (f '' E')ᶜ := by
    rintro _ ⟨w, ⟨hwEs, hwE'⟩, rfl⟩ ⟨x', hx', hfx⟩
    rcases hH3 x' w hfx with h | ⟨_, h⟩
    · exact hwE' (h ▸ hx')
    · exact hwEs h
  have hpush : ∀ z ∈ closure (Esᶜ ∩ E'ᶜ), f z ∈ closure (f '' E')ᶜ := by
    intro z hz
    exact closure_mono himS (image_closure_subset_closure_image hf ⟨z, hz, rfl⟩)
  have hs3 : ∀ x ∈ E' ∩ closure E'ᶜ, x ∉ Es → f x ∈ (f '' E') ∩ closure (f '' E')ᶜ := by
    intro x hx hxEs
    refine ⟨⟨x, hx.1, rfl⟩, hpush x ?_⟩
    exact hEsc.isOpen_compl.inter_closure ⟨hxEs, hx.2⟩
  have hmk : {i : Fin k | ∃ x ∈ E', a i x} ⊆ {i | ∃ y ∈ f '' E', b i y} := by
    rintro i ⟨x, hx, hax⟩
    exact ⟨f x, ⟨x, hx, rfl⟩, hHab i x hax⟩
  have hcardA : Nat.card {i : Fin k // ∃ x ∈ E', a i x} =
      {i : Fin k | ∃ x ∈ E', a i x}.ncard := Nat.card_coe_set_eq _
  have hcardB : Nat.card {i : Fin k // ∃ y ∈ f '' E', b i y} =
      {i : Fin k | ∃ y ∈ f '' E', b i y}.ncard := Nat.card_coe_set_eq _
  rw [hcardA, hcardB]
  have hm : {i : Fin k | ∃ x ∈ E', a i x}.ncard ≤ {i : Fin k | ∃ y ∈ f '' E', b i y}.ncard :=
    Set.ncard_le_ncard hmk (Set.toFinite _)
  by_cases h : ∀ x ∈ E' ∩ closure E'ᶜ, f x ∈ (f '' E') ∩ closure (f '' E')ᶜ
  · have := Set.ncard_le_ncard_of_injOn f h (hinj.mono Set.inter_subset_left) hfin
