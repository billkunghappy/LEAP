        · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, Iso.inv_hom_id_assoc]
        · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, Scheme.isoOfEq_inv_ι_assoc]
        · rw [Iso.refl_hom, Category.comp_id, Iso.refl_hom, Category.id_comp]
        · rw [Iso.refl_hom, Category.comp_id, Iso.refl_hom, Category.id_comp]
      · rw [morphismRestrict_ι_assoc, hcs]
      · rw [← cancel_mono V.ι, Category.assoc, morphismRestrict_ι, morphismRestrict_ι_assoc,
          hca, Category.assoc, morphismRestrict_ι]
        simp only [Category.assoc, morphismRestrict_ι_assoc, Scheme.isoOfEq_hom_ι_assoc]
  have t_raise : ∀ {X T T₁ T₂ Z : Scheme.{u}} (h : X ⟶ T) (g : T₁ ⟶ T) (b : T₂ ⟶ T)
        (b' : T₂ ⟶ T₁), b' ≫ g = b → ∀ (π : Z ⟶ X) (f : Z ⟶ T₂), IsPullback π f h b →
        ∃ ψ : Z ⟶ Limits.pullback h g, IsPullback ψ f (Limits.pullback.snd h g) b' ∧
          ψ ≫ Limits.pullback.fst h g = π := by
      intro X T T₁ T₂ Z h g b b' hb π f H
      have w : π ≫ h = (f ≫ b') ≫ g := by rw [Category.assoc, hb]; exact H.w
      refine ⟨Limits.pullback.lift π (f ≫ b') w, ?_, Limits.pullback.lift_fst _ _ _⟩
      refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _)
        (IsPullback.of_hasPullback h g)
      rw [Limits.pullback.lift_fst, hb]; exact H
  have R1 : ∀ (T U : Finset A) (hTU : Subring.closure (T : Set A) ≤ Subring.closure (U : Set A)),
      Spec.map (CommRingCat.ofHom (Subring.closure (U : Set A)).subtype) ≫
        Spec.map (CommRingCat.ofHom (Subring.inclusion hTU)) =
      Spec.map (CommRingCat.ofHom (Subring.closure (T : Set A)).subtype) := by
    have G : ∀ (S S' : Subring A) (h : S ≤ S'),
        Spec.map (CommRingCat.ofHom S'.subtype) ≫
          Spec.map (CommRingCat.ofHom (Subring.inclusion h)) =
        Spec.map (CommRingCat.ofHom S.subtype) := by
      intro S S' h
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      rfl
    intro T U hTU
    exact G _ _ hTU
  have R2 : ∀ (T U U' : Finset A) (h1 : Subring.closure (T : Set A) ≤ Subring.closure (U : Set A))
      (h2 : Subring.closure (U : Set A) ≤ Subring.closure (U' : Set A))
      (h3 : Subring.closure (T : Set A) ≤ Subring.closure (U' : Set A)),
      Spec.map (CommRingCat.ofHom (Subring.inclusion h2)) ≫
        Spec.map (CommRingCat.ofHom (Subring.inclusion h1)) =
      Spec.map (CommRingCat.ofHom (Subring.inclusion h3)) := by
    have G : ∀ (S S' S'' : Subring A) (h1 : S ≤ S') (h2 : S' ≤ S'') (h3 : S ≤ S''),
