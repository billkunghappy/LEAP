  have s6 : ∀ (X Y T : Scheme.{u}) (ι : X ⟶ Y) (q : Y ⟶ T) (V : Y.Opens) (v : Γ(T, ⊤)), X.presheaf.map (homOfLE (le_top : ι ⁻¹ᵁ V ≤ ⊤)).op ((ι ≫ q).appTop v) = ι.app V (Y.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (q.appTop v)) := by
    intro X Y T ι q V v
    have h := Scheme.Hom.naturality ι (homOfLE (le_top : V ≤ ⊤)).op
