  choose α β hαβ using hbez
  refine (hH1 (fun a b =>
      ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ O ≤ L.V a ⊓ L.V b from
          inf_le_left)).op).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b))) ^ (p + e) *
      ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ O ≤ L.V b ⊓ O from
