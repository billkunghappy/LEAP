theorem wcpa_dj_lsa_ll_uniform_step : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of A)), IsProper u₁ → ∀ L₁ : wcpaDjCoc Z₁, wcpaDjCocOK L₁ → ∀ e : ℕ, 0 < e → wcpaDjVA (Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) (wcpaDjCocPull (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) L₁) ⊤ e → ∃ m : ℕ, 1 ≤ m ∧ ∀ (n : ℕ) (x : ∀ a : Fin L₁.m, Γ(Z₁, L₁.V a)), wcpaDjCompatMod u₁ L₁ (IsLocalRing.maximalIdeal A ^ (n + 1)) (e * m) x → ∃ x' : ∀ a : Fin L₁.m, Γ(Z₁, L₁.V a), (∀ a, x' a - x a ∈ Ideal.map (wcCnSigma u₁ (L₁.V a)) (IsLocalRing.maximalIdeal A ^ (n + 1))) ∧ wcpaDjCompatMod u₁ L₁ (IsLocalRing.maximalIdeal A ^ (n + 2)) (e * m) x' :=
