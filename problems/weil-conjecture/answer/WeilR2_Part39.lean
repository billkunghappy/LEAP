        wcCbcmPull φ' L₀ (p + 1) z * wcCbcmSig q' (wcpaDjCocPull φ' L₀) ⊤ (p + 1) r) →
      ∀ x, Θ' ((d p).rTensor R x) = wcCbcmD (wcpaDjCocPull φ' L₀) ⊤ e p (Θ x) := by
    intro p Θ Θ' hΘ hΘ' x
