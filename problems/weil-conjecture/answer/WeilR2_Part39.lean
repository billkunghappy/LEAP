  obtain ⟨Θ0, hΘ0⟩ := wcpa_dj_lge_cbcm_cech_bc B R f Y₀ Y' q₀ φ' q' hsep hpb L₀ hOK.1 0
  obtain ⟨Θ1, hΘ1⟩ := wcpa_dj_lge_cbcm_cech_bc B R f Y₀ Y' q₀ φ' q' hsep hpb L₀ hOK.1 1
  obtain ⟨Θ2, hΘ2⟩ := wcpa_dj_lge_cbcm_cech_bc B R f Y₀ Y' q₀ φ' q' hsep hpb L₀ hOK.1 2

  have coord : ∀ (M N : Type u) [AddCommGroup M] [Module B M] [AddCommGroup N] [Module B N]
      (dd : M →ₗ[B] N) (n n' : ℕ) (β : Fin n → M) (γ : Fin n' → N)
