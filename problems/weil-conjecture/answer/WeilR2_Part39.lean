  have wcpa_dj_sfs_point_rational : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] (T : Scheme.{u}) (g : T ⟶ Spec (.of K)) (y : ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom (algebraMap K L))))), (∀ (M : Type u) [Field M] (a : T.residueField (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap K L))) y) →+* M) (b : L →+* M), a.comp (Spec.preimage (T.fromSpecResidueField (Limits.pullback.fst g (Spec.map (CommRingCat.ofHom (algebraMap K L))) y) ≫ g)).hom = b.comp (algebraMap K L) → ∀ z, a z ∈ b.range) → ∃ σ : Spec (.of L) ⟶ Limits.pullback g (Spec.map (CommRingCat.ofHom (algebraMap K L))), σ ≫ Limits.pullback.snd g (Spec.map (CommRingCat.ofHom (algebraMap K L))) = 𝟙 _ ∧ σ (IsLocalRing.closedPoint L) = y := by
