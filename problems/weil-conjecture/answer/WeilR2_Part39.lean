      have hCi : IsIrreducible C := hC.1
      obtain ⟨η, hη⟩ := QuasiSober.sober hCi hCc
      have hηx : η ⤳ x := hη.specializes (hsub (subset_closure rfl))
      rcases Hch η x z hηx hxz with h | h
      · subst h
