    intro v
    rw [wcpa_dj_lge_cbcm_fam_bridge R Y₀ Y' φ' q' L₀ n0 β0' v, Θsum]
    exact Finset.sum_congr rfl (fun j _ => hΘ0 (β0' j) (v j))
  have h7 := wcpa_dj_lge_cbcm_deg0 Y' (wcpaDjCocPull φ' L₀) (q' ⁻¹ᵁ ⊤) e hOK'
  refine ⟨?_, ?_, ?_⟩
  ·
    intro v hv
    have h1 : (d 0).rTensor R (∑ j, β0' j ⊗ₜ[B] v j) = 0 := by
