theorem wcpa_dj_lmga_ferrand_glue : ∀ (Ω : Type u) [Field Ω] (W W' : ValuationSubring Ω)
    (Wb : ValuationSubring (IsLocalRing.ResidueField ↥W')) (hle : W ≤ W') (πb : ↥W →+* ↥Wb),
    Function.Surjective πb →
    (∀ w : ↥W, algebraMap ↥Wb (IsLocalRing.ResidueField ↥W') (πb w) =
      algebraMap ↥W' (IsLocalRing.ResidueField ↥W') (ValuationSubring.inclusion W W' hle w)) →
    IsPullback (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)) (CommRingCat.ofHom πb)
      (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))
      (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W'))) →
    IsPreimmersion (Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle))) →
    ∀ (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of ↥W')) (Zb : Scheme.{u}) (ub : Zb ⟶ Spec (.of ↥Wb))
      (ψb : Limits.pullback u'
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⟶ Zb),
      wcpaDjSemistable u' → wcpaDjSemistable ub →
      IsPullback ψb (Limits.pullback.snd u'
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))))) ub
        (Spec.map (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W')))) →
      ∀ (m : ℕ) (U' : Fin m → Z'.Opens) (Ub : Fin m → Zb.Opens),
        (∀ a, IsAffineOpen (U' a)) → (∀ a, IsAffineOpen (Ub a)) →
        (∀ a, Limits.pullback.fst u'
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⁻¹ᵁ U' a =
          ψb ⁻¹ᵁ Ub a) →
        (⨆ a, U' a) = ⊤ → (⨆ a, Ub a) = ⊤ →
        ∃ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (i' : Z' ⟶ Z) (ib : Zb ⟶ Z),
          IsPullback i' u' uu (Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle))) ∧
          IsPullback ib ub uu (Spec.map (CommRingCat.ofHom πb)) ∧
          Limits.pullback.fst u'
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ≫ i' =
            ψb ≫ ib ∧
          Flat uu ∧ LocallyOfFiniteType uu ∧ QuasiCompact uu ∧ IsSeparated uu ∧
          Function.Injective ⇑i' ∧ Function.Injective ⇑ib ∧
          (∀ z : ↥Z, z ∈ Set.range ⇑i' ∨ z ∈ Set.range ⇑ib) ∧
          ∀ (R R1 R2 B : CommRingCat.{u}) (p1 : R ⟶ R1) (p2 : R ⟶ R2) (q1 : R1 ⟶ B) (q2 : R2 ⟶ B),
            IsPullback p1 p2 q1 q2 → Function.Surjective ⇑(ConcreteCategory.hom q1) →
            IsLocalRing R1 → IsLocalRing R2 → Nontrivial B →
            ∀ (a1 : Spec R1 ⟶ Z') (a2 : Spec R2 ⟶ Zb),
              Spec.map q1 ≫ a1 ≫ i' = Spec.map q2 ≫ a2 ≫ ib →
              ∃ t : Spec R ⟶ Z, Spec.map p1 ≫ t = a1 ≫ i' ∧ Spec.map p2 ≫ t = a2 ≫ ib :=
by
  intro Ω _ W W' Wb hle πb hsurj hcompat hpbR hpre Z' u' Zb ub ψb hss' hssb hpbb m U' Ub
    hU'aff hUbaff htr hU'cov hUbcov
  obtain ⟨Z, uu, i', ib, O, hpi', hpib, hY, hOcov, hO', hOb, hOaff, hchart⟩ :=
    wcpa_dj_lmfg_glue_charts Ω W W' Wb hle πb hsurj hcompat hpbR hpre Z' u' Zb ub ψb hss' hssb
      hpbb m U' Ub hU'aff hUbaff htr hU'cov hUbcov

  have keyT : ∀ {R S : CommRingCat.{u}} (f : R ⟶ S) {X Z₀ : Scheme.{u}} (g : X ⟶ Spec S)
      (i : X ⟶ Z₀) (v : Z₀ ⟶ Spec R), i ≫ v = g ≫ Spec.map f → ∀ (O₀ : Z₀.Opens) (U₀ : X.Opens)
      (e : U₀ ≤ i ⁻¹ᵁ O₀),
      ((Scheme.ΓSpecIso R).inv ≫ v.appLE ⊤ O₀ (by simp)) ≫ i.appLE O₀ U₀ e =
        f ≫ (Scheme.ΓSpecIso S).inv ≫ g.appLE ⊤ U₀ (by simp) := by
    intro R S f X Z₀ g i v h O₀ U₀ e
    have hc : ∀ φ ψ : X ⟶ Spec R, φ = ψ → ∀ p q, φ.appLE ⊤ U₀ p = ψ.appLE ⊤ U₀ q := by
      rintro φ _ rfl p q; rfl
    have h1 := Scheme.Hom.appLE_comp_appLE i v ⊤ O₀ U₀ (by simp) e
    have h2 := hc _ _ h (by simp) (by simp)
    have h3 := Scheme.Hom.appLE_comp_appLE g (Spec.map f) ⊤ ⊤ U₀ (by simp) (by simp)
    have h4 : (Spec.map f).appLE ⊤ ⊤ (by simp) = (Spec.map f).appTop :=
      Scheme.Hom.appLE_eq_app _
    rw [Category.assoc, h1, h2, ← h3, h4, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality,
      Category.assoc]

  have compIso : ∀ {R S T : CommRingCat.{u}} (e : R ⟶ S) [IsIso e] (g : S ⟶ T),
      (RingHom.Flat g.hom → RingHom.Flat (e ≫ g).hom) ∧
      (RingHom.FiniteType g.hom → RingHom.FiniteType (e ≫ g).hom) := by
    intro R S T e _ g
    have hb : Function.Bijective e.hom := ConcreteCategory.bijective_of_isIso e
    rw [CommRingCat.hom_comp]
    exact ⟨fun h => RingHom.Flat.comp (RingHom.Flat.of_bijective hb) h,
      fun h => RingHom.FiniteType.comp h (RingHom.FiniteType.of_surjective _ hb.2)⟩
  haveI hprop' : IsProper u' := hss'.2.1
  haveI hpropb : IsProper ub := hssb.2.1
  haveI hflat' : Flat u' := hss'.1
  haveI hflatb : Flat ub := hssb.1

  have hchartFT : ∀ a, RingHom.Flat (uu.appLE ⊤ (O a ⊓ O a) (by simp)).hom ∧
      RingHom.FiniteType (uu.appLE ⊤ (O a ⊓ O a) (by simp)).hom := by
    intro a
    have h1 : U' a ⊓ U' a ≤ i' ⁻¹ᵁ (O a ⊓ O a) := by rw [Scheme.Hom.preimage_inf, hO' a]
    have h2 : Ub a ⊓ Ub a ≤ ib ⁻¹ᵁ (O a ⊓ O a) := by rw [Scheme.Hom.preimage_inf, hOb a]
    have hV : ψb ⁻¹ᵁ (Ub a ⊓ Ub a) = Limits.pullback.fst u'
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⁻¹ᵁ
          (U' a ⊓ U' a) := by
      rw [Scheme.Hom.preimage_inf, Scheme.Hom.preimage_inf, htr a]
    have hUa : IsAffineOpen (U' a ⊓ U' a) := by rw [inf_idem]; exact hU'aff a
    have hUba : IsAffineOpen (Ub a ⊓ Ub a) := by rw [inf_idem]; exact hUbaff a
    have hA := wcpa_dj_lmfg_fibre_chart _ _ _ _ _ _ _ _ (IsPullback.of_hasPullback u'
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))))
      (U' a ⊓ U' a) hUa _ rfl
    have hB := wcpa_dj_lmfg_fibre_chart _ _ _ _ _ _ _ _ hpbb (Ub a ⊓ Ub a) hUba _ hV
    have hP := hchart a a h1 h2 hV.ge
    have hfl1 : RingHom.Flat (u'.appLE ⊤ (U' a ⊓ U' a) (by simp)).hom :=
      HasRingHomProperty.appLE @Flat u' hflat' ⟨⊤, isAffineOpen_top _⟩ ⟨U' a ⊓ U' a, hUa⟩
        (by simp)
    have hfl2 : RingHom.Flat (ub.appLE ⊤ (Ub a ⊓ Ub a) (by simp)).hom :=
      HasRingHomProperty.appLE @Flat ub hflatb ⟨⊤, isAffineOpen_top _⟩ ⟨Ub a ⊓ Ub a, hUba⟩
        (by simp)
    have hft1 : RingHom.FiniteType (u'.appLE ⊤ (U' a ⊓ U' a) (by simp)).hom :=
      HasRingHomProperty.appLE @LocallyOfFiniteType u' inferInstance ⟨⊤, isAffineOpen_top _⟩
        ⟨U' a ⊓ U' a, hUa⟩ (by simp)
    have hft2 : RingHom.FiniteType (ub.appLE ⊤ (Ub a ⊓ Ub a) (by simp)).hom :=
      HasRingHomProperty.appLE @LocallyOfFiniteType ub inferInstance ⟨⊤, isAffineOpen_top _⟩
        ⟨Ub a ⊓ Ub a, hUba⟩ (by simp)
    have h6a := keyT (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)) u' i' uu hpi'.w
      (O a ⊓ O a) (U' a ⊓ U' a) h1
    have h6b := keyT (CommRingCat.ofHom πb) ub ib uu hpib.w (O a ⊓ O a) (Ub a ⊓ Ub a) h2
    obtain ⟨hγf, hγt⟩ := wcpa_dj_lmfg_chart_ring Ω W W' Wb hle πb hsurj hcompat hpbR _ _ _ _ _ _
      _ _ _ _ _ ((Scheme.ΓSpecIso (CommRingCat.of ↥W)).inv ≫ uu.appLE ⊤ (O a ⊓ O a) (by simp))
      hA hB ((compIso _ _).1 hfl1) ((compIso _ _).1 hfl2) ((compIso _ _).2 hft1)
      ((compIso _ _).2 hft2) hP h6a h6b
    have hdec : uu.appLE ⊤ (O a ⊓ O a) (by simp) = (Scheme.ΓSpecIso (CommRingCat.of ↥W)).hom ≫
        ((Scheme.ΓSpecIso (CommRingCat.of ↥W)).inv ≫ uu.appLE ⊤ (O a ⊓ O a) (by simp)) := by
      rw [Iso.hom_inv_id_assoc]
    rw [hdec]
    exact ⟨(compIso _ _).1 hγf, (compIso _ _).2 hγt⟩
  have hcov2 : ⨆ a, ((⟨O a ⊓ O a, hOaff a a⟩ : Z.affineOpens) : Z.Opens) = ⊤ := by
    show ⨆ a, O a ⊓ O a = ⊤
    simp only [inf_idem]
    exact hOcov
  have hflat : Flat uu :=
    HasRingHomProperty.of_iSup_eq_top (P := @Flat) (fun a => ⟨O a ⊓ O a, hOaff a a⟩) hcov2
      (fun a => (hchartFT a).1)
  have hlft : LocallyOfFiniteType uu :=
    HasRingHomProperty.of_iSup_eq_top (P := @LocallyOfFiniteType)
      (fun a => ⟨O a ⊓ O a, hOaff a a⟩) hcov2 (fun a => (hchartFT a).2)

  have hcpt : CompactSpace Z := by
    refine ⟨?_⟩
    have hU : (Set.univ : Set Z) = ⋃ a, (O a : Set Z) := by
      rw [← TopologicalSpace.Opens.coe_iSup, hOcov, TopologicalSpace.Opens.coe_top]
    rw [hU]
    exact isCompact_iUnion (fun a => by
      have h := hOaff a a
      rw [inf_idem] at h
      exact h.isCompact)
  have hqc : QuasiCompact uu := (quasiCompact_iff_compactSpace uu).mpr hcpt

  have hsep : IsSeparated uu :=
    wcpa_dj_lmfg_separated_of_cover uu m O hOcov hOaff
      (wcpa_dj_lmfg_overlap_closure Ω W W' Wb hle πb hsurj hcompat hpbR Z' u' Zb ub ψb hss' hssb
        hpbb m U' Ub hU'aff hUbaff htr Z uu i' ib O hpi' hpib hY hO' hOb hOaff hchart)

  have hinj' : Function.Injective i' := by
    haveI : IsPreimmersion i' :=
      MorphismProperty.of_isPullback (P := @IsPreimmersion) hpi'.flip hpre
    exact (Scheme.Hom.isEmbedding i').injective
  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom πb)) :=
    IsClosedImmersion.spec_of_surjective _ hsurj
  have hinjb : Function.Injective ib := by
    haveI : IsPreimmersion ib :=
      MorphismProperty.of_isPullback (P := @IsPreimmersion) hpib.flip inferInstance
    exact (Scheme.Hom.isEmbedding ib).injective

  have hpts : ∀ z : Z, z ∈ Set.range ⇑i' ∨ z ∈ Set.range ⇑ib := by
    intro z
    obtain ⟨q, hq⟩ : uu z ∈ Set.range ⇑((Spec (.of ↥W)).fromSpecResidueField (uu z)) := by
      rw [Scheme.range_fromSpecResidueField]
      exact Set.mem_singleton _
    rcases wcpa_dj_lmga_geom_point_factor _ _ _ _ _ _ _ _ hpbR
        (IsLocalRing.residue_surjective (R := ↥W')) _
        ((Spec (.of ↥W)).fromSpecResidueField (uu z)) with ⟨s', hs'⟩ | ⟨sb, hsb⟩
    · left
      have hz : uu z ∈ Set.range
          ⇑(Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle))) := by
        rw [← hq, hs']
        exact ⟨s' q, (Scheme.Hom.comp_apply s' _ q).symm⟩
      obtain ⟨p, hp⟩ := hz
      obtain ⟨w, hw1, _⟩ := Scheme.Pullback.exists_preimage_pullback z p hp.symm
      refine ⟨hpi'.isoPullback.inv w, ?_⟩
      rw [← Scheme.Hom.comp_apply, hpi'.isoPullback_inv_fst, hw1]
    · right
      have hz : uu z ∈ Set.range ⇑(Spec.map (CommRingCat.ofHom πb)) := by
        rw [← hq, hsb]
        exact ⟨sb q, (Scheme.Hom.comp_apply sb _ q).symm⟩
      obtain ⟨p, hp⟩ := hz
      obtain ⟨w, hw1, _⟩ := Scheme.Pullback.exists_preimage_pullback z p hp.symm
      refine ⟨hpib.isoPullback.inv w, ?_⟩
      rw [← Scheme.Hom.comp_apply, hpib.isoPullback_inv_fst, hw1]
  refine ⟨Z, uu, i', ib, hpi', hpib, hY, hflat, hlft, hqc, hsep, hinj', hinjb, hpts, ?_⟩
  intro R R1 R2 B p1 p2 q1 q2 hpb hq1 hR1 hR2 hB a1 a2 h
  exact wcpa_dj_lmfg_local_milnor_lift R R1 R2 B p1 p2 q1 q2 hpb hq1 hR1 hR2 hB Z (a1 ≫ i')
