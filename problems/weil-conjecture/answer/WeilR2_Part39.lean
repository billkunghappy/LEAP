        (∃ p : ↥(Spec (.of K)), Limits.pullback.fst u (s ≫ b) (e.hom x) = τ i ((s ≫ b) p)) := by
      intro i x
      constructor
      · rintro ⟨p, hp⟩
        refine ⟨p, ?_⟩
        rw [pt I1 x, Scheme.Hom.comp_apply, hp, pt (hττ i) (s p), Scheme.Hom.comp_apply,
          Scheme.Hom.comp_apply]
      · rintro ⟨p, hp⟩
        refine ⟨p, ?_⟩
