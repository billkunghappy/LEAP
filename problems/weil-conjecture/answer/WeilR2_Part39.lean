      exact congrFun h3 a
    · have ht' : t = (fun a => ∑ j,
            (q'.appLE ⊤ ((wcpaDjCocPull φ' L₀).V a ⊓ q' ⁻¹ᵁ ⊤) inf_le_right).hom
