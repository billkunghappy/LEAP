    obtain ⟨v, ⟨hv0, hvx⟩, hvu⟩ := (hU R f).1 _ hx
    refine ⟨v, ⟨hv0, fun a => ?_⟩, fun v' hv' => hvu v' ⟨hv'.1, ?_⟩⟩
    · have hOf : wcCbcmOfFam (wcpaDjCocPull φ' L₀) (q' ⁻¹ᵁ ⊤) t =
