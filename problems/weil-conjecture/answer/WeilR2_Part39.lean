      · have hk2 : k ∉ Set.range e₂ := by
          rintro ⟨i, rfl⟩
          simp only [e₂] at hkN
          omega
        apply hav₂ k hk2 (j₂ y)
        rw [← Scheme.Hom.comp_apply, ← hxy]
        exact hk
      · have hk1 : k ∉ Set.range e₁ := by
          rintro ⟨i, rfl⟩
          exact hkN i.2
        apply hav₁ k hk1 (j₁ x)
        rw [← Scheme.Hom.comp_apply]
        exact hk
    haveI := hj₁
    haveI := hj₂
    haveI := hι₁
    haveI := hι₂
    refine ⟨N + 1 + M, Limits.coprod.desc (j₁ ≫ ι₁) (j₂ ≫ ι₂),
      t_closed _ _ inferInstance inferInstance hdisj, ?_⟩
    apply Limits.coprod.hom_ext
    · rw [Limits.coprod.inl_desc_assoc, Limits.coprod.inl_desc, Category.assoc, hι₁e, hj₁e]
    · rw [Limits.coprod.inr_desc_assoc, Limits.coprod.inr_desc, Category.assoc, hι₂e, hj₂e]

theorem wcpa_dj_lr1s_sgf_local_artinian_basechange : (∀ (R : Type u) [CommRing R] (P : Ideal R) [P.IsMaximal] (n : ℕ), ∃ ψ : R ⧸ P ^ n ≃+* Localization.AtPrime P ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime P) ^ n, ∀ r : R, ψ (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk _ (algebraMap R (Localization.AtPrime P) r)) → ∀ (κ K R : Type u) [Field κ] [Field K] [CommRing R] [Algebra κ K] [Algebra κ R] (𝔭 : Ideal R) [𝔭.IsPrime] (𝔮 : Ideal (TensorProduct κ R K)) [𝔮.IsPrime] (h : 𝔭 = 𝔮.comap (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct κ R K)), Function.Surjective ((Ideal.Quotient.mk 𝔭).comp (algebraMap κ R)) → ∀ n : ℕ, ∃ Φ : TensorProduct κ (Localization.AtPrime 𝔭 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) ^ n) K ≃+* (Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n), (∀ a : Localization.AtPrime 𝔭, Φ (Ideal.Quotient.mk _ a ⊗ₜ[κ] (1 : K)) = Ideal.Quotient.mk _ (Localization.localRingHom 𝔭 𝔮 Algebra.TensorProduct.includeLeftRingHom h a)) ∧ ∀ c : K, Φ (1 ⊗ₜ[κ] c) = Ideal.Quotient.mk _ (algebraMap (TensorProduct κ R K) (Localization.AtPrime 𝔮) (1 ⊗ₜ[κ] c)) :=
by
  intro QPL κ K R _ _ _ _ _ 𝔭 _ 𝔮 _ h hs n
  classical

  have tq : ∀ I : Ideal R, ∃ χ : (TensorProduct κ R K ⧸ Ideal.map (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct κ R K) I) ≃+* TensorProduct κ (R ⧸ I) K, ∀ (r : R) (c : K), χ (Ideal.Quotient.mk _ (r ⊗ₜ[κ] c)) = Ideal.Quotient.mk I r ⊗ₜ[κ] c := by
    intro I
    have hsurj : Function.Surjective (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ κ I) (AlgHom.id κ K)) :=
      Algebra.TensorProduct.map_surjective _ _ (Ideal.Quotient.mkₐ_surjective κ I) (fun x => ⟨x, rfl⟩)
    have hk : RingHom.ker (Ideal.Quotient.mkₐ κ I) = I := by
      ext x
      simp [RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem]
    have hker : Ideal.map (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct κ R K) I = RingHom.ker (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ κ I) (AlgHom.id κ K)) := by
      rw [Algebra.TensorProduct.rTensor_ker _ (Ideal.Quotient.mkₐ_surjective κ I), hk]
      apply le_antisymm
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, Algebra.TensorProduct.includeLeftRingHom_apply]
        have := Ideal.mem_map_of_mem (Algebra.TensorProduct.includeLeft : R →ₐ[κ] TensorProduct κ R K) hx
        rwa [Algebra.TensorProduct.includeLeft_apply] at this
      · rw [Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap, Algebra.TensorProduct.includeLeft_apply]
        have := Ideal.mem_map_of_mem (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct κ R K) hx
        rwa [Algebra.TensorProduct.includeLeftRingHom_apply] at this
    refine ⟨(Ideal.quotEquivOfEq hker).trans (Ideal.quotientKerAlgEquivOfSurjective hsurj).toRingEquiv, ?_⟩
    intro r c
    rw [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk]
    change (Algebra.TensorProduct.map (Ideal.Quotient.mkₐ κ I) (AlgHom.id κ K)) (r ⊗ₜ[κ] c) = _
    rw [Algebra.TensorProduct.map_tmul]
    rfl

  have hinj : Function.Injective ((Ideal.Quotient.mk 𝔭).comp (algebraMap κ R)) := RingHom.injective _
  have hpmax : 𝔭.IsMaximal := by
    apply Ideal.Quotient.maximal_of_isField
    exact MulEquiv.isField (Field.toIsField κ) (RingEquiv.ofBijective _ ⟨hinj, hs⟩).symm.toMulEquiv
  have hbij : Function.Bijective (Algebra.ofId κ (R ⧸ 𝔭)) := by
    have : ⇑(Algebra.ofId κ (R ⧸ 𝔭)) = ⇑((Ideal.Quotient.mk 𝔭).comp (algebraMap κ R)) := by
      funext c
      simp [Algebra.ofId_apply]
    rw [this]
    exact ⟨hinj, hs⟩
  let e₀ : κ ≃ₐ[κ] R ⧸ 𝔭 := AlgEquiv.ofBijective _ hbij
  obtain ⟨χ1, -⟩ := tq 𝔭
  have hmapmax : (Ideal.map (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct κ R K) 𝔭).IsMaximal := by
    apply Ideal.Quotient.maximal_of_isField
    let e : TensorProduct κ (R ⧸ 𝔭) K ≃ₐ[κ] K :=
      (Algebra.TensorProduct.congr e₀.symm (AlgEquiv.refl : K ≃ₐ[κ] K)).trans (Algebra.TensorProduct.lid κ K)
    exact MulEquiv.isField (Field.toIsField K) (χ1.trans e.toRingEquiv).toMulEquiv
  have hle : Ideal.map (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct κ R K) 𝔭 ≤ 𝔮 := by
    rw [Ideal.map_le_iff_le_comap, ← h]
  have hq : Ideal.map (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct κ R K) 𝔭 = 𝔮 :=
    hmapmax.eq_of_le (Ideal.IsPrime.ne_top inferInstance) hle
  have hqmax : 𝔮.IsMaximal := hq ▸ hmapmax

  have hqn : 𝔮 ^ n = Ideal.map (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct κ R K) (𝔭 ^ n) := by
    rw [Ideal.map_pow, hq]
  obtain ⟨χ0, hχ0⟩ := tq (𝔭 ^ n)
  let χ : (TensorProduct κ R K ⧸ 𝔮 ^ n) ≃+* TensorProduct κ (R ⧸ 𝔭 ^ n) K :=
    (Ideal.quotEquivOfEq hqn).trans χ0
  have hχ : ∀ (r : R) (c : K), χ (Ideal.Quotient.mk _ (r ⊗ₜ[κ] c)) = Ideal.Quotient.mk _ r ⊗ₜ[κ] c := by
    intro r c
    simp only [χ, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk, hχ0]
  obtain ⟨ψR, hψR⟩ := QPL R 𝔭 n
  obtain ⟨ψQ, hψQ⟩ := QPL (TensorProduct κ R K) 𝔮 n
  have hψRalg : ∀ c : κ, ψR (algebraMap κ (R ⧸ 𝔭 ^ n) c) =
      algebraMap κ (Localization.AtPrime 𝔭 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) ^ n) c := by
    intro c
    rw [← Ideal.Quotient.mk_algebraMap, hψR, ← IsScalarTower.algebraMap_apply,
      Ideal.Quotient.mk_algebraMap]
  let ψA := AlgEquiv.ofRingEquiv (f := ψR) hψRalg
  let T := Algebra.TensorProduct.congr ψA.symm (AlgEquiv.refl : K ≃ₐ[κ] K)
  refine ⟨T.toRingEquiv.trans (χ.symm.trans ψQ), ?_, ?_⟩
  ·
    intro a
    obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (ψR.symm (Ideal.Quotient.mk _ a))
    have hra : ψR (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk _ a := by
      rw [hr, RingEquiv.apply_symm_apply]
    rw [hψR, Ideal.Quotient.eq] at hra
    simp only [RingEquiv.trans_apply]
    have h1 : T.toRingEquiv (Ideal.Quotient.mk _ a ⊗ₜ[κ] (1 : K)) = Ideal.Quotient.mk _ r ⊗ₜ[κ] (1 : K) := by
      show T (Ideal.Quotient.mk _ a ⊗ₜ[κ] (1 : K)) = _
      rw [Algebra.TensorProduct.congr_apply, Algebra.TensorProduct.map_tmul]
      congr 1
      exact hr.symm
    rw [h1]
    have h2 : χ.symm (Ideal.Quotient.mk _ r ⊗ₜ[κ] (1 : K)) = Ideal.Quotient.mk _ (r ⊗ₜ[κ] (1 : K)) := by
      rw [RingEquiv.symm_apply_eq, hχ]
    rw [h2, hψQ, Ideal.Quotient.eq]
    have hL : Localization.localRingHom 𝔭 𝔮 Algebra.TensorProduct.includeLeftRingHom h
        (algebraMap R (Localization.AtPrime 𝔭) r) =
        algebraMap (TensorProduct κ R K) (Localization.AtPrime 𝔮) (r ⊗ₜ[κ] (1 : K)) :=
      Localization.localRingHom_to_map _ _ _ _ _
    rw [← hL, ← map_sub]
    have hmap : Ideal.map (Localization.localRingHom 𝔭 𝔮 Algebra.TensorProduct.includeLeftRingHom h)
        (IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭)) ≤
        IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) := by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, map_mem_nonunits_iff]
      exact (IsLocalRing.mem_maximalIdeal _).mp hx
    apply Ideal.pow_right_mono hmap n
    rw [← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ hra
  ·
    intro c
    simp only [RingEquiv.trans_apply]
    have h1 : T.toRingEquiv (1 ⊗ₜ[κ] c) = 1 ⊗ₜ[κ] c := by
      show T (1 ⊗ₜ[κ] c) = _
      rw [Algebra.TensorProduct.congr_apply, Algebra.TensorProduct.map_tmul, map_one]
      rfl
    rw [h1]
    have h2 : χ.symm (1 ⊗ₜ[κ] c) = Ideal.Quotient.mk _ (1 ⊗ₜ[κ] c) := by
      rw [RingEquiv.symm_apply_eq, hχ, map_one]
    rw [h2, hψQ]

theorem wcpa_dj_lr1s_sgf_affine_pullback_sections : ∀ (κ K : Type u) [Field κ] [Field K] (Yκ YK : Scheme.{u}) (tκ : Yκ ⟶ Spec (.of κ)) (tK : YK ⟶ Spec (.of K)) (s'' : Spec (.of K) ⟶ Spec (.of κ)) (p : YK ⟶ Yκ), IsPullback p tK tκ s'' → ∀ V : Yκ.Opens, IsAffineOpen V → letI : Algebra κ K := (Spec.preimage s'').hom.toAlgebra; letI : Algebra κ Γ(Yκ, V) := ((Scheme.ΓSpecIso (.of κ)).inv ≫ tκ.appTop ≫ Yκ.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.toAlgebra; IsAffineOpen (p ⁻¹ᵁ V) ∧ ∃ θ : Γ(YK, p ⁻¹ᵁ V) ≃+* TensorProduct κ Γ(Yκ, V) K, (∀ r : Γ(Yκ, V), θ ((p.app V).hom r) = r ⊗ₜ[κ] (1 : K)) ∧ ∀ c : K, θ (((Scheme.ΓSpecIso (.of K)).inv ≫ tK.appTop ≫ YK.presheaf.map (homOfLE (le_top : p ⁻¹ᵁ V ≤ ⊤)).op).hom c) = (1 : Γ(Yκ, V)) ⊗ₜ[κ] c :=
by
  intro κ K _ _ Yκ YK tκ tK s'' p hp V hV

  have s1 : ∀ (X Y : Scheme.{u}) (f : X ⟶ Y) (U : Y.Opens),
      U.topIso.inv ≫ (f ∣_ U).appTop ≫ (f ⁻¹ᵁ U).topIso.hom = f.app U := by
    intro X Y f U
    have key : ∀ {A : Y.Opens} (i : Opposite.op U ⟶ Opposite.op A) {B : X.Opens}
        (j : Opposite.op (f ⁻¹ᵁ A) ⟶ Opposite.op B) (k : Opposite.op B ⟶ Opposite.op (f ⁻¹ᵁ U)),
        Y.presheaf.map i ≫ f.app A ≫ X.presheaf.map j ≫ X.presheaf.map k = f.app U := by
      intro A i B j k
      rw [Scheme.Hom.naturality_assoc, ← Functor.map_comp, ← Functor.map_comp]
      convert Category.comp_id (f.app U) using 2
      rw [← X.presheaf.map_id]
      exact congrArg _ (Subsingleton.elim _ _)
    rw [morphismRestrict_appTop]
    exact key _ _ _

  have s2 : ∀ (X : Scheme.{u}) (W : X.Opens),
      X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op ≫ W.topIso.inv = W.ι.appTop := by
    intro X W
    rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
    exact (X.presheaf.map_comp _ _).symm

  have s3 : ∀ (S : CommRingCat.{u}) (X : Scheme.{u}) (t : X ⟶ Spec S) (W : X.Opens)
      (hW : IsAffineOpen W), W.ι ≫ t = hW.isoSpec.hom ≫
        Spec.map ((Scheme.ΓSpecIso S).inv ≫ t.appTop ≫
          X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op) := by
    intro S X t W hW
    apply ext_of_isAffine
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, IsAffineOpen.isoSpec_hom_appTop,
      ← s2 X W, ← Category.assoc (Scheme.Hom.appTop (Spec.map _)), Scheme.ΓSpecIso_naturality]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]

  have G : ∀ (R : CommRingCat.{u}) (φ : CommRingCat.of κ ⟶ R)
      (ιK : CommRingCat.of κ ⟶ CommRingCat.of K) (U : Scheme.{u}) (a : U ⟶ Spec R)
      (b : U ⟶ Spec (.of K)), IsPullback a b (Spec.map φ) (Spec.map ιK) →
      letI : Algebra κ K := ιK.hom.toAlgebra; letI : Algebra κ R := φ.hom.toAlgebra;
      IsAffine U ∧ ∃ θ0 : Γ(U, ⊤) ≃+* TensorProduct κ R K,
        (∀ r : R, θ0 (((Scheme.ΓSpecIso R).inv ≫ a.appTop).hom r) = r ⊗ₜ[κ] (1 : K)) ∧
        ∀ c : K, θ0 (((Scheme.ΓSpecIso (.of K)).inv ≫ b.appTop).hom c) = (1 : R) ⊗ₜ[κ] c := by
    intro R φ ιK U a b hab
    letI : Algebra κ K := ιK.hom.toAlgebra
    letI : Algebra κ R := φ.hom.toAlgebra
    have hT : IsPullback
        (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct κ R K)))
        (Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeRight.toRingHom : K →+* TensorProduct κ R K)))
        (Spec.map φ) (Spec.map ιK) :=
      isPullback_SpecMap_of_isPushout _ _ _ _ (CommRingCat.isPushout_tensorProduct κ R K)
    let ξ := hab.isoIsPullback _ _ hT
    have ha : ξ.hom ≫ Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct κ R K)) = a :=
      IsPullback.isoIsPullback_hom_fst _ _ hab hT
    have hb : ξ.hom ≫ Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight.toRingHom : K →+* TensorProduct κ R K)) = b :=
      IsPullback.isoIsPullback_hom_snd _ _ hab hT
    haveI : IsAffine U := IsAffine.of_isIso ξ.hom
    let T : CommRingCat.{u} := CommRingCat.of (TensorProduct κ R K)
    let E : Γ(U, ⊤) ≅ T :=
      { hom := ξ.inv.appTop ≫ (Scheme.ΓSpecIso T).hom
        inv := (Scheme.ΓSpecIso T).inv ≫ ξ.hom.appTop
        hom_inv_id := by
          rw [Category.assoc, Iso.hom_inv_id_assoc, ← Scheme.Hom.comp_appTop, Iso.hom_inv_id,
            Scheme.Hom.id_appTop]
        inv_hom_id := by
          rw [Category.assoc, ← Category.assoc ξ.hom.appTop, ← Scheme.Hom.comp_appTop,
            Iso.inv_hom_id, Scheme.Hom.id_appTop, Category.id_comp, Iso.inv_hom_id] }
    have key : ∀ (S : CommRingCat.{u}) (g : S ⟶ T) (f : U ⟶ Spec S),
        ξ.hom ≫ Spec.map g = f → (Scheme.ΓSpecIso S).inv ≫ f.appTop ≫ E.hom = g := by
      intro S g f hf
      subst hf
      show (Scheme.ΓSpecIso S).inv ≫ (ξ.hom ≫ Spec.map g).appTop ≫ ξ.inv.appTop ≫
        (Scheme.ΓSpecIso T).hom = g
      rw [Scheme.Hom.comp_appTop, Category.assoc, ← Category.assoc ξ.hom.appTop,
        ← Scheme.Hom.comp_appTop, Iso.inv_hom_id, Scheme.Hom.id_appTop, Category.id_comp,
        Scheme.ΓSpecIso_naturality, Iso.inv_hom_id_assoc]
    refine ⟨inferInstance, E.commRingCatIsoToRingEquiv, fun r => ?_, fun c => ?_⟩
    · have h := congrArg (fun h => h.hom r) (key _ _ a ha)
      exact h
    · have h := congrArg (fun h => h.hom c) (key _ _ b hb)
      exact h

  have h1 := (isPullback_morphismRestrict p V).paste_vert hp
  have h3 := s3 _ Yκ tκ V hV
  have h2 : IsPullback ((p ∣_ V) ≫ hV.isoSpec.hom) ((p ⁻¹ᵁ V).ι ≫ tK)
      (Spec.map ((Scheme.ΓSpecIso (.of κ)).inv ≫ tκ.appTop ≫
        Yκ.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op))
      (Spec.map (Spec.preimage s'')) :=
    IsPullback.of_iso h1 (Iso.refl _) hV.isoSpec (Iso.refl _) (Iso.refl _)
      (by rw [Iso.refl_hom, Category.id_comp])
      (by simp only [Iso.refl_hom, Category.id_comp, Category.comp_id])
      (by rw [Iso.refl_hom, Category.comp_id]; exact h3)
      (by simp only [Iso.refl_hom, Category.comp_id, Category.id_comp, Spec.map_preimage])
  obtain ⟨hUaff, θ0, hθR, hθK⟩ := G _ _ _ _ _ _ h2
  refine ⟨hUaff, ((p ⁻¹ᵁ V).topIso.symm.commRingCatIsoToRingEquiv).trans θ0,
    fun r => ?_, fun c => ?_⟩
  · have hstar : p.app V ≫ (p ⁻¹ᵁ V).topIso.inv =
        (Scheme.ΓSpecIso Γ(Yκ, V)).inv ≫ ((p ∣_ V) ≫ hV.isoSpec.hom).appTop := by
      rw [Scheme.Hom.comp_appTop, IsAffineOpen.isoSpec_hom_appTop, Category.assoc,
        Iso.inv_hom_id_assoc, ← s1 YK Yκ p V, Category.assoc, Category.assoc, Iso.hom_inv_id,
        Category.comp_id]
    show θ0 ((p.app V ≫ (p ⁻¹ᵁ V).topIso.inv).hom r) = _
    rw [hstar]
    exact hθR r
  · have hss : (Scheme.ΓSpecIso (.of K)).inv ≫ tK.appTop ≫
        YK.presheaf.map (homOfLE (le_top : p ⁻¹ᵁ V ≤ ⊤)).op ≫ (p ⁻¹ᵁ V).topIso.inv =
        (Scheme.ΓSpecIso (.of K)).inv ≫ ((p ⁻¹ᵁ V).ι ≫ tK).appTop := by
      rw [Scheme.Hom.comp_appTop, ← s2 YK (p ⁻¹ᵁ V)]
    show θ0 (((Scheme.ΓSpecIso (.of K)).inv ≫ tK.appTop ≫
        YK.presheaf.map (homOfLE (le_top : p ⁻¹ᵁ V ≤ ⊤)).op ≫ (p ⁻¹ᵁ V).topIso.inv).hom c) = _
    rw [hss]
    exact hθK c

theorem wcpa_dj_lr1s_sgf_stalk_model : ∀ (κ K : Type u) [Field κ] [Field K] (Yκ YK : Scheme.{u}) (tκ : Yκ ⟶ Spec (.of κ)) (tK : YK ⟶ Spec (.of K)) (s'' : Spec (.of K) ⟶ Spec (.of κ)) (p : YK ⟶ Yκ) (V : Yκ.Opens) (w' : YK), IsAffineOpen V → p w' ∈ V → IsAffineOpen (p ⁻¹ᵁ V) → letI : Algebra κ K := (Spec.preimage s'').hom.toAlgebra; letI : Algebra κ Γ(Yκ, V) := ((Scheme.ΓSpecIso (.of κ)).inv ≫ tκ.appTop ≫ Yκ.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.toAlgebra; ∀ θ : Γ(YK, p ⁻¹ᵁ V) ≃+* TensorProduct κ Γ(Yκ, V) K, ((∀ r : Γ(Yκ, V), θ ((p.app V).hom r) = r ⊗ₜ[κ] (1 : K)) ∧ ∀ c : K, θ (((Scheme.ΓSpecIso (.of K)).inv ≫ tK.appTop ≫ YK.presheaf.map (homOfLE (le_top : p ⁻¹ᵁ V ≤ ⊤)).op).hom c) = (1 : Γ(Yκ, V)) ⊗ₜ[κ] c) → ∃ (𝔮 : Ideal (TensorProduct κ Γ(Yκ, V) K)) (_ : 𝔮.IsPrime) (α : Yκ.presheaf.stalk (p w') ≃+* Localization.AtPrime (𝔮.comap (Algebra.TensorProduct.includeLeftRingHom : Γ(Yκ, V) →+* TensorProduct κ Γ(Yκ, V) K))) (β : YK.presheaf.stalk w' ≃+* Localization.AtPrime 𝔮), (∀ a, β ((p.stalkMap w').hom a) = Localization.localRingHom _ 𝔮 Algebra.TensorProduct.includeLeftRingHom rfl (α a)) ∧ (∀ c : κ, α (((Scheme.ΓSpecIso (.of κ)).inv ≫ tκ.appTop ≫ Yκ.presheaf.germ ⊤ (p w') trivial).hom c) = algebraMap κ _ c) ∧ ∀ c : K, β (((Scheme.ΓSpecIso (.of K)).inv ≫ tK.appTop ≫ YK.presheaf.germ ⊤ w' trivial).hom c) = algebraMap (TensorProduct κ Γ(Yκ, V) K) (Localization.AtPrime 𝔮) ((1 : Γ(Yκ, V)) ⊗ₜ[κ] c) :=
by

  have LT : ∀ (A B S : Type u) [CommRing A] [CommRing B] [CommRing S] [Algebra A S]
      (e : A ≃+* B) (P : Ideal A) [P.IsPrime] [IsLocalization.AtPrime S P] (J : Ideal B)
      [J.IsPrime], Ideal.comap (e : A →+* B) J = P →
      ∃ γ : S ≃+* Localization.AtPrime J, ∀ a : A,
        γ (algebraMap A S a) = algebraMap B (Localization.AtPrime J) (e a) := by
    intro A B S _ _ _ _ e P _ _ J _ h
    have H : Submonoid.map e.toMonoidHom P.primeCompl = J.primeCompl := by
      ext y
      constructor
      · rintro ⟨a, ha, rfl⟩
        intro hy
        apply ha
        rw [← h]
        exact hy
      · intro hy
        refine ⟨e.symm y, ?_, by simp⟩
        intro ha
        apply hy
        rw [← h] at ha
        simpa using ha
    refine ⟨IsLocalization.ringEquivOfRingEquiv S (Localization.AtPrime J) e H, fun a => ?_⟩
    rw [IsLocalization.ringEquivOfRingEquiv_apply, IsLocalization.map_eq]
    rfl

  have LC : ∀ (A A' SA SB : Type u) [CommRing A] [CommRing A'] [CommRing SA] [CommRing SB]
      [Algebra A SA] [Algebra A' SB] (P : Ideal A) [P.IsPrime] (P' : Ideal A') [P'.IsPrime]
      [IsLocalization.AtPrime SA P] [IsLocalization.AtPrime SB P'] (φ : A →+* A')
      (σ : SA →+* SB) [IsLocalHom σ],
      (∀ a : A, σ (algebraMap A SA a) = algebraMap A' SB (φ a)) → Ideal.comap φ P' = P := by
    intro A A' SA SB _ _ _ _ _ _ P _ P' _ _ _ φ σ _ hc
    ext a
    rw [Ideal.mem_comap]
    have h1 := IsLocalization.AtPrime.isUnit_to_map_iff SA P a
    have h2 := IsLocalization.AtPrime.isUnit_to_map_iff SB P' (φ a)
    have h3 : IsUnit (σ (algebraMap A SA a)) ↔ IsUnit (algebraMap A SA a) := isUnit_map_iff σ _
    rw [hc] at h3
    have h4 : (φ a ∉ P') ↔ (a ∉ P) := by
      rw [← Ideal.mem_primeCompl_iff, ← Ideal.mem_primeCompl_iff, ← h1, ← h2, h3]
    exact not_iff_not.mp h4
  intro κ K _ _ Yκ YK tκ tK s'' p V w' hV hwV hV'
  letI iK : Algebra κ K := (Spec.preimage s'').hom.toAlgebra
  letI iV : Algebra κ Γ(Yκ, V) := ((Scheme.ΓSpecIso (.of κ)).inv ≫ tκ.appTop ≫
    Yκ.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom.toAlgebra
  intro θ hθ
  let x : V := ⟨p w', hwV⟩
  let x' : (p ⁻¹ᵁ V : YK.Opens) := ⟨w', hwV⟩
  letI aA : Algebra Γ(Yκ, V) (Yκ.presheaf.stalk (p w')) :=
    TopCat.Presheaf.algebra_section_stalk Yκ.presheaf x
  letI aB : Algebra Γ(YK, p ⁻¹ᵁ V) (YK.presheaf.stalk w') :=
    TopCat.Presheaf.algebra_section_stalk YK.presheaf x'
  haveI hlocA : IsLocalization.AtPrime (Yκ.presheaf.stalk (p w')) (hV.primeIdealOf x).asIdeal :=
    hV.isLocalization_stalk x
  haveI hlocB : IsLocalization.AtPrime (YK.presheaf.stalk w') (hV'.primeIdealOf x').asIdeal :=
    hV'.isLocalization_stalk x'
  have hc : ∀ r : Γ(Yκ, V), (p.stalkMap w').hom (algebraMap Γ(Yκ, V) _ r) =
      algebraMap Γ(YK, p ⁻¹ᵁ V) (YK.presheaf.stalk w') ((p.app V).hom r) :=
    fun r => Scheme.Hom.germ_stalkMap_apply p V w' hwV r
  have hP : Ideal.comap (p.app V).hom (hV'.primeIdealOf x').asIdeal = (hV.primeIdealOf x).asIdeal :=
    LC _ _ _ _ _ _ (p.app V).hom (p.stalkMap w').hom hc
  set 𝔮 : Ideal (TensorProduct κ Γ(Yκ, V) K) :=
    Ideal.comap (θ.symm : TensorProduct κ Γ(Yκ, V) K →+* Γ(YK, p ⁻¹ᵁ V))
      (hV'.primeIdealOf x').asIdeal with h𝔮def
  haveI h𝔮 : 𝔮.IsPrime := Ideal.comap_isPrime _ _
  have hlam : ∀ r : Γ(Yκ, V),
      θ.symm (Algebra.TensorProduct.includeLeftRingHom r) = (p.app V).hom r := by
    intro r
    rw [Algebra.TensorProduct.includeLeftRingHom_apply, ← hθ.1 r, RingEquiv.symm_apply_apply]
  have hcomap : 𝔮.comap (Algebra.TensorProduct.includeLeftRingHom :
      Γ(Yκ, V) →+* TensorProduct κ Γ(Yκ, V) K) = (hV.primeIdealOf x).asIdeal := by
    rw [← hP]
    ext r
    show (θ.symm (Algebra.TensorProduct.includeLeftRingHom r) : Γ(YK, p ⁻¹ᵁ V)) ∈
        (hV'.primeIdealOf x').asIdeal ↔ (p.app V).hom r ∈ (hV'.primeIdealOf x').asIdeal
    rw [hlam r]
  obtain ⟨α, hα⟩ := LT _ _ (Yκ.presheaf.stalk (p w')) (RingEquiv.refl Γ(Yκ, V))
    (hV.primeIdealOf x).asIdeal (𝔮.comap (Algebra.TensorProduct.includeLeftRingHom :
      Γ(Yκ, V) →+* TensorProduct κ Γ(Yκ, V) K)) (by rw [← hcomap]; ext r; rfl)
  obtain ⟨β, hβ⟩ := LT _ _ (YK.presheaf.stalk w') θ (hV'.primeIdealOf x').asIdeal 𝔮 (by
    ext g
    show (θ.symm (θ g) : Γ(YK, p ⁻¹ᵁ V)) ∈ (hV'.primeIdealOf x').asIdeal ↔
      g ∈ (hV'.primeIdealOf x').asIdeal
    rw [RingEquiv.symm_apply_apply])
  refine ⟨𝔮, h𝔮, α, β, ?_, ?_, ?_⟩
  · intro a
    have key : (β.toRingHom.comp (p.stalkMap w').hom) =
        (Localization.localRingHom _ 𝔮 Algebra.TensorProduct.includeLeftRingHom rfl).comp
          α.toRingHom := by
      apply IsLocalization.ringHom_ext (hV.primeIdealOf x).asIdeal.primeCompl
      ext r
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom]
      rw [hc, hβ, hθ.1, hα, Localization.localRingHom_to_map]
      rfl
    exact RingHom.congr_fun key a
  · intro c
    have e2 : ((Scheme.ΓSpecIso (.of κ)).inv ≫ tκ.appTop ≫
        Yκ.presheaf.germ ⊤ (p w') trivial).hom c =
        algebraMap Γ(Yκ, V) (Yκ.presheaf.stalk (p w')) (algebraMap κ Γ(Yκ, V) c) := by
      rw [← TopCat.Presheaf.germ_res Yκ.presheaf (homOfLE (le_top : V ≤ ⊤)) (p w') hwV]
      rfl
    rw [e2, hα, RingEquiv.refl_apply, ← IsScalarTower.algebraMap_apply]
  · intro c
    have hx' : w' ∈ p ⁻¹ᵁ V := hwV
    have e2 : ((Scheme.ΓSpecIso (.of K)).inv ≫ tK.appTop ≫ YK.presheaf.germ ⊤ w' trivial).hom c =
        algebraMap Γ(YK, p ⁻¹ᵁ V) (YK.presheaf.stalk w')
          (((Scheme.ΓSpecIso (.of K)).inv ≫ tK.appTop ≫
            YK.presheaf.map (homOfLE (le_top : p ⁻¹ᵁ V ≤ ⊤)).op).hom c) := by
      rw [← TopCat.Presheaf.germ_res YK.presheaf (homOfLE (le_top : p ⁻¹ᵁ V ≤ ⊤)) w' hx']
      rfl
    rw [e2, hβ, hθ.2]

theorem wcpa_dj_lr1s_sgf_trunc_transport : ∀ (κ K A B R : Type u) [Field κ] [Field K] [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B] [CommRing R] [Algebra κ K] [Algebra κ R] (jA : κ →+* A) (σ : A →+* B) (jB : K →+* B) (𝔮 : Ideal (TensorProduct κ R K)) [𝔮.IsPrime] (α : A ≃+* Localization.AtPrime (𝔮.comap (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct κ R K))) (β : B ≃+* Localization.AtPrime 𝔮), (∀ (κ K R : Type u) [Field κ] [Field K] [CommRing R] [Algebra κ K] [Algebra κ R] (𝔭 : Ideal R) [𝔭.IsPrime] (𝔮 : Ideal (TensorProduct κ R K)) [𝔮.IsPrime] (h : 𝔭 = 𝔮.comap (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct κ R K)), Function.Surjective ((Ideal.Quotient.mk 𝔭).comp (algebraMap κ R)) → ∀ n : ℕ, ∃ Φ : TensorProduct κ (Localization.AtPrime 𝔭 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔭) ^ n) K ≃+* (Localization.AtPrime 𝔮 ⧸ IsLocalRing.maximalIdeal (Localization.AtPrime 𝔮) ^ n), (∀ a : Localization.AtPrime 𝔭, Φ (Ideal.Quotient.mk _ a ⊗ₜ[κ] (1 : K)) = Ideal.Quotient.mk _ (Localization.localRingHom 𝔭 𝔮 Algebra.TensorProduct.includeLeftRingHom h a)) ∧ ∀ c : K, Φ (1 ⊗ₜ[κ] c) = Ideal.Quotient.mk _ (algebraMap (TensorProduct κ R K) (Localization.AtPrime 𝔮) (1 ⊗ₜ[κ] c))) → (∀ a, β (σ a) = Localization.localRingHom _ 𝔮 Algebra.TensorProduct.includeLeftRingHom rfl (α a)) → (∀ c : κ, α (jA c) = algebraMap κ _ c) → (∀ c : K, β (jB c) = algebraMap (TensorProduct κ R K) (Localization.AtPrime 𝔮) ((1 : R) ⊗ₜ[κ] c)) → Function.Surjective ((IsLocalRing.residue A).comp jA) → ∀ n : ℕ, letI : Algebra κ A := jA.toAlgebra; ∃ Φ : TensorProduct κ (A ⧸ IsLocalRing.maximalIdeal A ^ n) K ≃+* (B ⧸ IsLocalRing.maximalIdeal B ^ n), (∀ a : A, Φ (Ideal.Quotient.mk _ a ⊗ₜ[κ] (1 : K)) = Ideal.Quotient.mk _ (σ a)) ∧ ∀ c : K, Φ (1 ⊗ₜ[κ] c) = Ideal.Quotient.mk _ (jB c) :=
by
  intro κ K A B R _ _ _ _ _ _ _ _ _ jA σ jB 𝔮 _ α β CORE hσ hjA hjB hres n
  letI : Algebra κ A := jA.toAlgebra

  have mapmax : ∀ {S T : Type u} [CommRing S] [IsLocalRing S] [CommRing T] [IsLocalRing T]
      (f : S ≃+* T) (k : ℕ), IsLocalRing.maximalIdeal T ^ k =
        Ideal.map (f : S →+* T) (IsLocalRing.maximalIdeal S ^ k) := by
    intro S T _ _ _ _ f k
    rw [Ideal.map_pow, Ideal.map_coe]
    congr 1
    have hm : (Ideal.map f (IsLocalRing.maximalIdeal S)).IsMaximal :=
      Ideal.map_isMaximal_of_equiv f
    exact (IsLocalRing.eq_maximalIdeal hm).symm

  have hsurj : Function.Surjective ((Ideal.Quotient.mk
      (𝔮.comap (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct κ R K))).comp
        (algebraMap κ R)) := by
    intro y
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨c, hc⟩ := hres (IsLocalRing.residue A (α.symm (algebraMap R _ x)))
    refine ⟨c, ?_⟩
    simp only [RingHom.comp_apply] at hc ⊢
    rw [Ideal.Quotient.eq]
    have h1 : jA c - α.symm (algebraMap R _ x) ∈ IsLocalRing.maximalIdeal A := by
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, hc, sub_self]
    have h2 : α (jA c - α.symm (algebraMap R _ x)) ∈ IsLocalRing.maximalIdeal
        (Localization.AtPrime
          (𝔮.comap (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct κ R K))) := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, isUnit_map_iff]
      exact (IsLocalRing.mem_maximalIdeal _).mp h1
    rw [map_sub, hjA, RingEquiv.apply_symm_apply,
      IsScalarTower.algebraMap_apply κ R (Localization.AtPrime
        (𝔮.comap (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct κ R K))),
      ← map_sub] at h2
    exact (IsLocalization.AtPrime.to_map_mem_maximal_iff _ _ _).mp h2

  obtain ⟨Φ₀, hΦ1, hΦ2⟩ := CORE κ K R
    (𝔮.comap (Algebra.TensorProduct.includeLeftRingHom : R →+* TensorProduct κ R K)) 𝔮 rfl hsurj n

  let αb := Ideal.quotientEquiv _ _ α (mapmax α n)
  let βb := Ideal.quotientEquiv _ _ β (mapmax β n)
  have hlin : ∀ c : κ, αb (algebraMap κ _ c) = algebraMap κ _ c := by
    intro c
    rw [← Ideal.Quotient.mk_algebraMap, ← Ideal.Quotient.mk_algebraMap]
    simp only [αb, Ideal.quotientEquiv_mk]
    rw [RingHom.algebraMap_toAlgebra, hjA]
  let αa := AlgEquiv.ofRingEquiv (f := αb) hlin
  let T := Algebra.TensorProduct.congr αa (AlgEquiv.refl : K ≃ₐ[κ] K)
  have hT : ∀ (y : A ⧸ IsLocalRing.maximalIdeal A ^ n) (c : K),
      T (y ⊗ₜ[κ] c) = αb y ⊗ₜ[κ] c := by
    intro y c
    simp only [T, Algebra.TensorProduct.congr_apply, Algebra.TensorProduct.map_tmul]
    rfl

  refine ⟨T.toRingEquiv.trans (Φ₀.trans βb.symm), ?_, ?_⟩
  · intro a
    rw [RingEquiv.trans_apply, RingEquiv.trans_apply]
    show βb.symm (Φ₀ (T (Ideal.Quotient.mk _ a ⊗ₜ[κ] (1 : K)))) = _
    rw [hT]
    simp only [αb, Ideal.quotientEquiv_mk]
    rw [hΦ1, ← hσ]
    simp only [βb, Ideal.quotientEquiv_symm_mk, RingEquiv.symm_apply_apply]
  · intro c
    rw [RingEquiv.trans_apply, RingEquiv.trans_apply]
    show βb.symm (Φ₀ (T ((1 : A ⧸ IsLocalRing.maximalIdeal A ^ n) ⊗ₜ[κ] c))) = _
    rw [hT, map_one, hΦ2, ← hjB]
    simp only [βb, Ideal.quotientEquiv_symm_mk, RingEquiv.symm_apply_apply]

theorem wcpa_dj_lr1s_sgf_nodal_trunc_basis : ∀ (F : Type u) [Field F], (∀ f : MvPowerSeries (Fin 2) F, (∀ n : ℕ, f ∈ (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F)) ^ n ⊔ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F)) ↔ ∀ a < n, MvPowerSeries.coeff (Finsupp.single 0 a) f = 0 ∧ MvPowerSeries.coeff (Finsupp.single 1 a) f = 0) ∧ (f ∈ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F)) ↔ ∀ a : ℕ, MvPowerSeries.coeff (Finsupp.single 0 a) f = 0 ∧ MvPowerSeries.coeff (Finsupp.single 1 a) f = 0)) → ∀ n : ℕ, ∃ b : Module.Basis (Fin n ⊕ Fin (n - 1)) F ((MvPowerSeries (Fin 2) F ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F))) ⧸ (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) F))) ^ n), (∀ a : Fin n, b (Sum.inl a) = Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPowerSeries.X 0 ^ (a : ℕ)))) ∧ (∀ c : Fin (n - 1), b (Sum.inr c) = Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPowerSeries.X 1 ^ ((c : ℕ) + 1)))) :=
by
  intro F _ hMEM n
  classical
  set J : Ideal (MvPowerSeries (Fin 2) F) := Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} with hJ
  set m : Ideal (MvPowerSeries (Fin 2) F) := Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} with hm
  set N : Ideal (MvPowerSeries (Fin 2) F ⧸ J) := Ideal.map (Ideal.Quotient.mk J) m ^ n with hN
  let q : MvPowerSeries (Fin 2) F →ₐ[F] (MvPowerSeries (Fin 2) F ⧸ J) ⧸ N :=
    (Ideal.Quotient.mkₐ F N).comp (Ideal.Quotient.mkₐ F J)
  have hq : ∀ f, q f = Ideal.Quotient.mk N (Ideal.Quotient.mk J f) := fun f => rfl
  have hKC : ∀ f, q f = 0 ↔ ∀ a < n, MvPowerSeries.coeff (Finsupp.single 0 a) f = 0 ∧
      MvPowerSeries.coeff (Finsupp.single 1 a) f = 0 := by
    intro f
    rw [hq, Ideal.Quotient.eq_zero_iff_mem, hN, ← Ideal.map_pow, Ideal.mem_quotient_iff_mem_sup]
    exact (hMEM f).1 n
  let Pol : (Fin n ⊕ Fin (n - 1) → F) → MvPowerSeries (Fin 2) F := fun g =>
    ∑ i : Fin n, g (Sum.inl i) • MvPowerSeries.X 0 ^ (i : ℕ) +
      ∑ j : Fin (n - 1), g (Sum.inr j) • MvPowerSeries.X 1 ^ ((j : ℕ) + 1)
  have hc0 : ∀ g a, MvPowerSeries.coeff (Finsupp.single 0 ((a : Fin n) : ℕ)) (Pol g) = g (Sum.inl a) := by
    intro g a
    simp only [Pol, map_add, map_sum, MvPowerSeries.coeff_smul, MvPowerSeries.coeff_X_pow,
      Finsupp.single_eq_single_iff]
    simp [Fin.val_inj]
    have hiff : ∀ x : Fin n, (a = x ∨ (a : ℕ) = 0 ∧ (x : ℕ) = 0) ↔ a = x := by
      intro x
      constructor
      · rintro (h | ⟨h1, h2⟩)
        · exact h
        · exact Fin.ext (h1.trans h2.symm)
      · exact Or.inl
    simp only [hiff, Finset.sum_ite_eq, Finset.mem_univ, ite_true]
  have hc1 : ∀ g c, MvPowerSeries.coeff (Finsupp.single 1 (((c : Fin (n - 1)) : ℕ) + 1)) (Pol g) = g (Sum.inr c) := by
    intro g c
    simp only [Pol, map_add, map_sum, MvPowerSeries.coeff_smul, MvPowerSeries.coeff_X_pow,
      Finsupp.single_eq_single_iff]
    simp [Fin.val_inj]
  let v : Fin n ⊕ Fin (n - 1) → (MvPowerSeries (Fin 2) F ⧸ J) ⧸ N :=
    Sum.elim (fun a => q (MvPowerSeries.X 0 ^ (a : ℕ))) (fun c => q (MvPowerSeries.X 1 ^ ((c : ℕ) + 1)))
  have hsum : ∀ g, ∑ k, g k • v k = q (Pol g) := by
    intro g
    rw [Fintype.sum_sum_type]
    simp only [Pol, map_add, map_sum, map_smul, v, Sum.elim_inl, Sum.elim_inr]
  have hli : LinearIndependent F v := by
    rw [Fintype.linearIndependent_iff]
    intro g hg k
    rw [hsum, hKC] at hg
    rcases k with a | c
    · rw [← hc0 g a]; exact (hg a a.isLt).1
    · rw [← hc1 g c]; exact (hg _ (by have := c.isLt; omega)).2
  have hsp : ⊤ ≤ Submodule.span F (Set.range v) := by
    intro x _
    obtain ⟨f, rfl⟩ : ∃ f, q f = x := by
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
      obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact ⟨f, rfl⟩
    let g : Fin n ⊕ Fin (n - 1) → F := Sum.elim
      (fun a => MvPowerSeries.coeff (Finsupp.single 0 (a : ℕ)) f)
      (fun c => MvPowerSeries.coeff (Finsupp.single 1 ((c : ℕ) + 1)) f)
    have hD : q (f - Pol g) = 0 := by
      rw [hKC]
      intro a ha
      have h0 : MvPowerSeries.coeff (Finsupp.single 0 a) (f - Pol g) = 0 := by
        rw [map_sub, hc0 g ⟨a, ha⟩]
        simp [g]
      refine ⟨h0, ?_⟩
      rcases a with _ | c
      · rw [Finsupp.single_zero] at h0 ⊢; exact h0
      · rw [map_sub, hc1 g ⟨c, by omega⟩]
        simp [g]
    have hfx : q f = ∑ k, g k • v k := by
      rw [hsum, ← sub_eq_zero, ← map_sub, hD]
    rw [hfx]
    exact Submodule.sum_mem _ (fun k _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩))
  refine ⟨Module.Basis.mk hli hsp, fun a => ?_, fun c => ?_⟩
  · rw [Module.Basis.mk_apply]; rfl
  · rw [Module.Basis.mk_apply]; rfl

theorem wcpa_dj_lr1s_sgf_nodal_trunc_basechange : ∀ (κ K : Type u) [Field κ] [Field K] [Algebra κ K] (n : ℕ), (∃ b : Module.Basis (Fin n ⊕ Fin (n - 1)) κ ((MvPowerSeries (Fin 2) κ ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) ⧸ (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) ^ n), (∀ a : Fin n, b (Sum.inl a) = Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPowerSeries.X 0 ^ (a : ℕ)))) ∧ (∀ c : Fin (n - 1), b (Sum.inr c) = Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPowerSeries.X 1 ^ ((c : ℕ) + 1))))) → (∃ b : Module.Basis (Fin n ⊕ Fin (n - 1)) K ((MvPowerSeries (Fin 2) K ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) ⧸ (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) ^ n), (∀ a : Fin n, b (Sum.inl a) = Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPowerSeries.X 0 ^ (a : ℕ)))) ∧ (∀ c : Fin (n - 1), b (Sum.inr c) = Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPowerSeries.X 1 ^ ((c : ℕ) + 1))))) → ∃ T : TensorProduct κ ((MvPowerSeries (Fin 2) κ ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) ⧸ (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) ^ n) K ≃+* ((MvPowerSeries (Fin 2) K ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) ⧸ (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) ^ n), (∀ f : MvPowerSeries (Fin 2) κ, T (Ideal.Quotient.mk _ (Ideal.Quotient.mk _ f) ⊗ₜ[κ] (1 : K)) = Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPowerSeries.map (algebraMap κ K) f))) ∧ ∀ c : K, T (1 ⊗ₜ[κ] c) = Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (MvPowerSeries.C c)) :=
by
  intro κ K _ _ _ n hbκ hbK
  classical
  obtain ⟨bκ, hbκ0, hbκ1⟩ := hbκ
  obtain ⟨bK, hbK0, hbK1⟩ := hbK

  have s2 : ∀ (A C : Type u) (ι : Type) [CommRing A] [Algebra κ A] [CommRing C] [Algebra K C]
      [Algebra κ C] [IsScalarTower κ K C] (bA : Module.Basis ι κ A) (bC : Module.Basis ι K C)
      (g : A →+* C), (∀ c : κ, g (algebraMap κ A c) = algebraMap κ C c) →
      (∀ i : ι, g (bA i) = bC i) →
      ∃ T : TensorProduct κ A K ≃+* C, (∀ a : A, T (a ⊗ₜ[κ] (1 : K)) = g a) ∧
        ∀ c : K, T (1 ⊗ₜ[κ] c) = algebraMap K C c := by
    intro A C ι _ _ _ _ _ _ bA bC g hgc hg
    let gA : A →ₐ[κ] C := { g with commutes' := hgc }
    let h : K →ₐ[κ] C := IsScalarTower.toAlgHom κ K C
    let L : TensorProduct κ A K →ₐ[κ] C :=
      Algebra.TensorProduct.lift gA h (fun _ _ => Commute.all _ _)
    let L' : TensorProduct κ K A →ₐ[K] C :=
      Algebra.TensorProduct.lift (Algebra.ofId K C) gA (fun _ _ => Commute.all _ _)
    let bA' := Algebra.TensorProduct.basis K bA
    have hL'b : ∀ i, L' (bA' i) = bC i := by
      intro i
      rw [Algebra.TensorProduct.basis_apply]
      simp only [L', Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      exact hg i
    let E := bA'.equiv bC (Equiv.refl ι)
    have hLE : L'.toLinearMap = E.toLinearMap := by
      apply bA'.ext
      intro i
      rw [AlgHom.toLinearMap_apply, LinearEquiv.coe_coe, Module.Basis.equiv_apply, hL'b]
      rfl
    have hL'bij : Function.Bijective L' := by
      have : (L' : TensorProduct κ K A → C) = E := by
        funext x; exact LinearMap.congr_fun hLE x
      rw [this]; exact E.bijective
    have hcomp : ∀ x, L x = L' (Algebra.TensorProduct.comm κ A K x) := by
      intro x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul a c =>
        simp only [L, L', Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.lift_tmul]
        exact mul_comm _ _
      | add x y hx hy => simp only [map_add, hx, hy]
    have hLbij : Function.Bijective L := by
      have : (L : TensorProduct κ A K → C) = L' ∘ (Algebra.TensorProduct.comm κ A K) :=
        funext hcomp
      rw [this]
      exact hL'bij.comp (Algebra.TensorProduct.comm κ A K).bijective
    refine ⟨RingEquiv.ofBijective L hLbij, ?_, ?_⟩
    · intro a
      rw [RingEquiv.ofBijective_apply]
      simp only [L, Algebra.TensorProduct.lift_tmul, map_one, mul_one]
      rfl
    · intro c
      rw [RingEquiv.ofBijective_apply]
      simp only [L, Algebra.TensorProduct.lift_tmul, map_one, one_mul]
      rfl

  let φ : MvPowerSeries (Fin 2) κ →+* MvPowerSeries (Fin 2) K := MvPowerSeries.map (algebraMap κ K)
  have hφX : ∀ i, φ (MvPowerSeries.X i) = MvPowerSeries.X i := fun i => MvPowerSeries.map_X _ i
  have hb : (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ)) ≤
      (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K)).comap φ := by
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap, map_mul, hφX, hφX]
    exact Ideal.subset_span rfl
  let φ1 := Ideal.quotientMap
    (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K)) φ hb
  have hc : Ideal.map φ1 (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) ≤
      Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K)) := by
    rw [Ideal.map_map, Ideal.map_le_iff_le_comap, Ideal.span_le]
    intro x hx
    rw [SetLike.mem_coe, Ideal.mem_comap, RingHom.comp_apply, Ideal.quotientMap_mk]
    apply Ideal.mem_map_of_mem
    rcases hx with rfl | rfl
    · rw [hφX]; exact Ideal.subset_span (Set.mem_insert _ _)
    · rw [hφX]; exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)
  have hd : (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) ^ n ≤
      ((Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) ^ n).comap φ1 := by
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
    exact Ideal.pow_right_mono hc n
  let ρ0 := Ideal.quotientMap _ φ1 hd
  have hρ : ∀ f : MvPowerSeries (Fin 2) κ, ρ0 (Ideal.Quotient.mk _ (Ideal.Quotient.mk _ f)) =
      Ideal.Quotient.mk _ (Ideal.Quotient.mk _ (φ f)) := by
    intro f
    simp only [ρ0, φ1, Ideal.quotientMap_mk]
  have hg : ∀ i, ρ0 (bκ i) = bK i := by
    rintro (a | c)
    · rw [hbκ0, hbK0, hρ, map_pow, hφX]
    · rw [hbκ1, hbK1, hρ, map_pow, hφX]
  have hcomm : ∀ c : κ, ρ0 (algebraMap κ _ c) = algebraMap κ
      ((MvPowerSeries (Fin 2) K ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) ⧸ (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) ^ n) c := by
    intro c
    simp only [← Ideal.Quotient.mk_algebraMap, hρ]
    simp only [φ, MvPowerSeries.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
      MvPowerSeries.map_C]
  obtain ⟨T, hT1, hT2⟩ := s2
    ((MvPowerSeries (Fin 2) κ ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) ⧸ (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) ^ n)
    ((MvPowerSeries (Fin 2) K ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) ⧸ (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) K))) ^ n)
    (Fin n ⊕ Fin (n - 1)) bκ bK ρ0 hcomm hg
  refine ⟨T, fun f => ?_, fun c => ?_⟩
  · rw [hT1, hρ]
  · rw [hT2]
    simp only [← Ideal.Quotient.mk_algebraMap, MvPowerSeries.algebraMap_apply,
      Algebra.algebraMap_self, RingHom.id_apply]

theorem wcpa_dj_lr1s_sgf_adic_ker_eval : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (I : Ideal A) (n : ℕ), RingHom.ker (AdicCompletion.evalₐ I n) = Ideal.map (algebraMap A (AdicCompletion I A)) (I ^ n) :=
by
  intro A _ _ I n
  classical
  have hι : ∀ a : A, algebraMap A (AdicCompletion I A) a = AdicCompletion.of I A a := fun a => rfl
  apply le_antisymm
  · intro x hx
    rw [RingHom.mem_ker] at hx
    obtain ⟨r, f, hf⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
      (IsNoetherian.noetherian (I ^ n))
    have hf' : Ideal.span (Set.range f) = I ^ n := hf
    obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective I A x
    rw [AdicCompletion.evalₐ_mk, Ideal.Quotient.eq_zero_iff_mem] at hx
    have hcau : ∀ m m' : ℕ, m ≤ m' → s m' - s m ∈ I ^ m := by
      intro m m' h
      rw [← Ideal.Quotient.mk_eq_mk_iff_sub_mem]
      exact AdicCompletion.Ideal.mk_eq_mk I h s
    have h0 : s n ∈ Ideal.span (Set.range f) := by rw [hf']; exact hx
    obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp h0
    have hinc : ∀ k : ℕ, ∃ e : Fin r → A, (∀ i, e i ∈ I ^ k) ∧
        ∑ i, e i * f i = s (n + (k + 1)) - s (n + k) := by
      intro k
      have hmem : s (n + (k + 1)) - s (n + k) ∈ I ^ k • Submodule.span A (Set.range f) := by
        rw [hf, Ideal.smul_eq_mul, ← pow_add, add_comm k n]
        exact hcau (n + k) (n + (k + 1)) (by omega)
      obtain ⟨a, ha, hsum⟩ := (Submodule.mem_ideal_smul_span_iff_exists_sum _ _ _).mp hmem
      refine ⟨fun i => a i, ha, ?_⟩
      rw [← hsum, Finsupp.sum_fintype]
      · simp [smul_eq_mul]
      · intro i; simp
    choose e he hesum using hinc
    let y : Fin r → ℕ → A := fun i k => c i + ∑ j ∈ Finset.range k, e j i
    have hy_succ : ∀ i k, y i (k + 1) - y i k = e k i := by
      intro i k; simp only [y, Finset.sum_range_succ]; ring
    have hy_sum : ∀ k, ∑ i, f i * y i k = s (n + k) := by
      intro k
      induction k with
      | zero =>
        simp only [y, Finset.sum_range_zero, add_zero]
        rw [← hc]
        exact Finset.sum_congr rfl (fun i _ => mul_comm _ _)
      | succ k ih =>
        have h1 : ∀ i, f i * y i (k + 1) = f i * y i k + e k i * f i := by
          intro i; rw [← hy_succ i k]; ring
        rw [Finset.sum_congr rfl (fun i _ => h1 i), Finset.sum_add_distrib, ih, hesum k]
        ring
    have hyc : ∀ i k, y i k ≡ y i (k + 1) [SMOD (I ^ k • ⊤ : Submodule A A)] := by
      intro i k
      rw [SModEq.sub_mem, Ideal.smul_eq_mul, Ideal.mul_top]
      have h2 := he k i
      rw [← hy_succ i k] at h2
      rw [← neg_sub]
      exact neg_mem h2
    let Y : Fin r → AdicCompletion I A := fun i =>
      AdicCompletion.mk I A (AdicCompletion.AdicCauchySequence.mk I A (y i) (hyc i))
    have hx_eq : AdicCompletion.mk I A s = ∑ i, algebraMap A (AdicCompletion I A) (f i) * Y i := by
      apply AdicCompletion.ext_evalₐ
      intro k
      rw [map_sum, AdicCompletion.evalₐ_mk]
      simp only [map_mul, hι, AdicCompletion.evalₐ_of, Y, AdicCompletion.evalₐ_mk,
        AdicCompletion.AdicCauchySequence.mk_coe]
      have h3 : ∑ i, Ideal.Quotient.mk (I ^ k) (f i) * Ideal.Quotient.mk (I ^ k) (y i k) =
          Ideal.Quotient.mk (I ^ k) (∑ i, f i * y i k) := by
        simp [map_sum, map_mul]
      rw [h3, hy_sum k]
      exact (AdicCompletion.Ideal.mk_eq_mk I (Nat.le_add_left k n) s).symm
    rw [hx_eq]
    refine Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ?_))
    rw [← hf']
    exact Ideal.subset_span ⟨i, rfl⟩
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    rw [Ideal.mem_comap, RingHom.mem_ker, hι, AdicCompletion.evalₐ_of,
      Ideal.Quotient.eq_zero_iff_mem]
    exact ha

theorem wcpa_dj_lr1s_sgf_trunc_iso_of_completion : ∀ (κ A : Type u) [Field κ] [CommRing A] [IsLocalRing A] (jA : κ →+* A) (e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* (MvPowerSeries (Fin 2) κ ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ)))), e.toRingHom.comp ((algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)).comp jA) = (Ideal.Quotient.mk _).comp MvPowerSeries.C → (∀ n : ℕ, RingHom.ker (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n) = Ideal.map (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) (IsLocalRing.maximalIdeal A ^ n)) → (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))).IsMaximal → (∀ x : (MvPowerSeries (Fin 2) κ ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))), x ∉ (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) → IsUnit x) → (∀ f : MvPowerSeries (Fin 2) κ, Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ)) f - Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ)) (MvPowerSeries.C (MvPowerSeries.constantCoeff f)) ∈ (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ)))) → (∀ n : ℕ, ∃ φ : A ⧸ IsLocalRing.maximalIdeal A ^ n ≃+* (MvPowerSeries (Fin 2) κ ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) ⧸ (Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) (Ideal.span {MvPowerSeries.X 0, MvPowerSeries.X 1} : Ideal (MvPowerSeries (Fin 2) κ))) ^ n, ∀ a : A, φ (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ (e (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a))) ∧ Function.Surjective ((IsLocalRing.residue A).comp jA) :=
by

  have s1 : ∀ (A S : Type u) [CommRing A] [IsLocalRing A] [CommRing S] (N : Ideal S)
      (e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* S),
      (∀ n : ℕ, RingHom.ker (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n) =
        Ideal.map (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
          (IsLocalRing.maximalIdeal A ^ n)) →
      N.IsMaximal → (∀ x : S, x ∉ N → IsUnit x) →
      ∀ n : ℕ, ∃ φ : A ⧸ IsLocalRing.maximalIdeal A ^ n ≃+* S ⧸ N ^ n, ∀ a : A,
        φ (Ideal.Quotient.mk _ a) =
          Ideal.Quotient.mk _ (e (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a)) := by
    intro A S _ _ _ N e hKER hmax hunit
    have hsurj1 := AdicCompletion.surjective_evalₐ (IsLocalRing.maximalIdeal A) 1
    have hm1 : (IsLocalRing.maximalIdeal A ^ 1).IsMaximal := by
      rw [pow_one]; exact IsLocalRing.maximalIdeal.isMaximal A
    letI : Field (A ⧸ IsLocalRing.maximalIdeal A ^ 1) := Ideal.Quotient.field _
    have hker1 : (RingHom.ker (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1)).IsMaximal :=
      RingHom.ker_isMaximal_of_surjective _ hsurj1
    have hJmax : (Ideal.map (e : AdicCompletion (IsLocalRing.maximalIdeal A) A →+* S)
        (RingHom.ker (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1))).IsMaximal :=
      Ideal.map_isMaximal_of_equiv e
    have hJN : Ideal.map (e : AdicCompletion (IsLocalRing.maximalIdeal A) A →+* S)
        (RingHom.ker (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) 1)) = N := by
      apply hJmax.eq_of_le hmax.ne_top
      intro x hx
      by_contra hxN
      exact hJmax.ne_top (Ideal.eq_top_of_isUnit_mem _ hx (hunit x hxN))
    intro n
    have hs : Function.Surjective
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom :=
      AdicCompletion.surjective_evalₐ (IsLocalRing.maximalIdeal A) n
    have hmapn : N ^ n = Ideal.map (e : AdicCompletion (IsLocalRing.maximalIdeal A) A →+* S)
        (RingHom.ker (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom) := by
      have h := hKER n
      change RingHom.ker (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom = _ at h
      rw [h, Ideal.map_pow, Ideal.map_pow, ← hJN, hKER 1, pow_one]
    let Ψ₁ := RingHom.quotientKerEquivOfSurjective hs
    let Ψ₂ := Ideal.quotientEquiv
      (RingHom.ker (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom) (N ^ n) e hmapn
    refine ⟨Ψ₁.symm.trans Ψ₂, fun a => ?_⟩
    have h1 : Ψ₁ (Ideal.Quotient.mk _
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a)) =
        Ideal.Quotient.mk _ a := by
      rw [RingHom.quotientKerEquivOfSurjective_apply_mk]
      have := (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).commutes a
      rw [Ideal.Quotient.algebraMap_eq] at this
      exact this
    rw [RingEquiv.trans_apply, ← h1, RingEquiv.symm_apply_apply]
    exact Ideal.quotientEquiv_mk _ _ _ _ _

  have s2 : ∀ (κ A S : Type u) [Field κ] [CommRing A] [IsLocalRing A] [CommRing S] (N : Ideal S)
      (θ : A →+* S) (jA : κ →+* A), N ≠ ⊤ → (∀ a : A, ∃ c : κ, θ a - θ (jA c) ∈ N) →
      Function.Surjective ((IsLocalRing.residue A).comp jA) := by
    intro κ A S _ _ _ _ N θ jA hN H r
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective r
    obtain ⟨c, hc⟩ := H a
    refine ⟨c, ?_⟩
    have hin : a - jA c ∈ IsLocalRing.maximalIdeal A := by
      by_contra h
      have hu := (IsLocalRing.notMem_maximalIdeal.mp h).map θ
      rw [map_sub] at hu
      exact hN (Ideal.eq_top_of_isUnit_mem _ hc hu)
    rw [RingHom.comp_apply, eq_comm, ← sub_eq_zero, ← map_sub, IsLocalRing.residue_eq_zero_iff]
    exact hin

  intro κ A _ _ _ jA e hE hKER hmax hunit hconst
  refine ⟨s1 A _ _ e hKER hmax hunit, ?_⟩
  refine s2 κ A _ _ (e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)))
    jA hmax.ne_top ?_
  intro a
  obtain ⟨f, hf⟩ := Ideal.Quotient.mk_surjective
    (e (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a))
  refine ⟨MvPowerSeries.constantCoeff f, ?_⟩
  have hc := RingHom.congr_fun hE (MvPowerSeries.constantCoeff f)
  simp only [RingHom.comp_apply] at hc ⊢
  rw [hc]
  change e (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) - _ ∈ _
  rw [← hf]
  exact hconst f

