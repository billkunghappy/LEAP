      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
        ((isPullback_morphismRestrict (Limits.pullback.fst u' (sg (u' z'))) W').paste_vert hpb) hsm'
    obtain ⟨e, he1, he2⟩ : ∃ e : Limits.pullback u' (sg (u' z')) ≅ Limits.pullback u₀ (sg (u' z') ≫ b),
        e.hom ≫ Limits.pullback.fst u₀ (sg (u' z') ≫ b) = Limits.pullback.fst u' (sg (u' z')) ≫ φ ∧
        e.hom ≫ Limits.pullback.snd u₀ (sg (u' z') ≫ b) = Limits.pullback.snd u' (sg (u' z')) :=
      ⟨hQ.isoPullback, hQ.isoPullback_hom_fst, hQ.isoPullback_hom_snd⟩
    have he2' : e.inv ≫ Limits.pullback.snd u' (sg (u' z')) =
        Limits.pullback.snd u₀ (sg (u' z') ≫ b) := by
      rw [← he2, Iso.inv_hom_id_assoc]
    have hsmW := s3h e.inv _ _ he2' _ hsmQ
    have hmem : e.hom w' ∈ e.inv ⁻¹ᵁ (Limits.pullback.fst u' (sg (u' z')) ⁻¹ᵁ W') := by
      rw [Scheme.Hom.mem_preimage, ← Scheme.Hom.comp_apply, e.hom_inv_id]
      show w' ∈ _
      rw [Scheme.Hom.mem_preimage, hw'1]
      exact hz'
    obtain ⟨W, hW, hWsm⟩ := wcpa_dj_bsc_smooth_descend T Z u₀ (Kg (u' z')) (sg (u' z') ≫ b)
      (e.hom w') hfl hfp ⟨_, hmem, hsmW⟩
    refine ⟨W, ?_, hWsm⟩
    rw [pt he1 w', Scheme.Hom.comp_apply, hw'1] at hW
    exact hW

  have hbOd : ∀ t', b t' ∈ Od := by
    intro t'
    refine hOdintro (b t') (fun i j hij y hy => ?_)
    have hyb : y = b t' := by
      have h1 := congrArg u₀ hy
      rw [hu₀τ, hu₀τ] at h1
      exact h1.symm
    have hc1 : φ (τ' i t') = τ₀ i (b t') := by
      rw [← Scheme.Hom.comp_apply, hτφ i, Scheme.Hom.comp_apply]
    have key := spu Z T T' Z' u₀ b φ u' (τ₀ j) (τ' j) hφ (hτ₀ j) (hτ' j) (hτφ j) (τ' i t')
      (by rw [hu'τ, hc1, hy, hyb])
    exact hS2 i j t' t' hij (key.trans (congrArg _ (hu'τ i t')))
  have hbOs : ∀ t', b t' ∈ Os := by
    intro t'
    refine hOsintro (b t') (fun j => ?_)
    obtain ⟨W', hW', hsm'⟩ := hS3 j t'
    obtain ⟨W, hW, hWsm⟩ := hdesc _ W' hW' hsm'
    refine ⟨W, ?_, hWsm⟩
    rw [← Scheme.Hom.comp_apply, hτφ j, Scheme.Hom.comp_apply] at hW
    exact hW

  have hW2 : ∀ t' : T', ∃ W2 : T.Opens, b t' ∈ W2 ∧ W2 ≤ ODS ∧
      ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T),
        Set.range ⇑s ⊆ (W2 : Set T) → wcpaDjSolSS u₀ K s ∧ wcpaDjSolStab u₀ n τ₀ K s := by
    intro t'
    obtain ⟨p0⟩ : Nonempty ↥(Spec (.of (Kg t'))) :=
      ⟨show ↥(Spec (.of (Kg t'))) from IsLocalRing.closedPoint (Kg t')⟩
    have hbt : (sg t' ≫ b) p0 = b t' := by
      rw [Scheme.Hom.comp_apply, hsg]
    obtain ⟨W1, hW1r, hW1⟩ :=
      wcpa_dj_sol_nodal_open T Z u₀ hfl hpr hfp (Kg t') (sg t' ≫ b) (hgeo t').1
    have hbW1 : b t' ∈ W1 := hW1r ⟨_, hbt⟩
    obtain ⟨W2, hW2le, hW2r, hW2g⟩ := wcpa_dj_sol_stable_open T Z u₀ n τ₀ hfl hpr hfp hτ₀
      (W1 ⊓ ODS) (fun K _ _ s hs => hW1 K s (fun x hx => (hs hx).1))
      (fun i j t ht hij heq => hOdmem t ht.2.1 i j hij t heq)
      (fun j t ht => hOsmem t ht.2.2 j) (Kg t') (sg t' ≫ b)
      (hrange _ _ p0 (by rw [hbt]; exact ⟨hbW1, hbOd t', hbOs t'⟩)) (hgeo t').2
    refine ⟨W2, hW2r ⟨_, hbt⟩, fun x hx => (hW2le hx).2, fun K _ _ s hs =>
      ⟨hW1 K s (fun x hx => (hW2le (hs hx)).1), hW2g K s hs⟩⟩
  choose W2 hbW2 hW2le hW2g using hW2

  let G₀ : T.Opens := ⨆ t', W2 t'
  have hgood : ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T),
      Set.range ⇑s ⊆ (G₀ : Set T) → wcpaDjSolSS u₀ K s ∧ wcpaDjSolStab u₀ n τ₀ K s := by
    intro K _ _ s hs
    obtain ⟨p0⟩ : Nonempty ↥(Spec (.of K)) :=
      ⟨show ↥(Spec (.of K)) from IsLocalRing.closedPoint K⟩
    obtain ⟨t', ht'⟩ := TopologicalSpace.Opens.mem_iSup.mp (hs ⟨p0, rfl⟩)
    exact hW2g t' K s (hrange s _ p0 ht')
  have hG₀ODS : G₀ ≤ ODS := iSup_le fun t' => hW2le t'
  have hbG₀ : ∀ t', b t' ∈ G₀ := fun t' => TopologicalSpace.Opens.mem_iSup.mpr ⟨t', hbW2 t'⟩

  have hres : ∀ U : T.Opens, U ≤ G₀ → ∃ τU : Fin n → (U.toScheme ⟶ (u₀ ⁻¹ᵁ U).toScheme),
      wcpaDjStablePtd (u₀ ∣_ U) n τU ∧ (∀ i, τU i ≫ (u₀ ⁻¹ᵁ U).ι = U.ι ≫ τ₀ i) := by
    intro U hU
    have hR : IsPullback (u₀ ∣_ U) (u₀ ⁻¹ᵁ U).ι U.ι u₀ := isPullback_morphismRestrict u₀ U
    let τU : Fin n → (U.toScheme ⟶ (u₀ ⁻¹ᵁ U).toScheme) := fun i =>
      hR.lift (𝟙 _) (U.ι ≫ τ₀ i) (by rw [Category.id_comp, Category.assoc, hτ₀ i, Category.comp_id])
    have L1 : ∀ i, τU i ≫ (u₀ ∣_ U) = 𝟙 _ := fun i => hR.lift_fst _ _ _
    have L2 : ∀ i, τU i ≫ (u₀ ⁻¹ᵁ U).ι = U.ι ≫ τ₀ i := fun i => hR.lift_snd _ _ _
    have hUmem : ∀ x : U.toScheme, U.ι x ∈ G₀ := by
      intro x
      have h1 : U.ι x ∈ Set.range ⇑U.ι := ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι] at h1
      exact hU h1
    have hrU : ∀ {K : Type u} [Field K] (s : Spec (.of K) ⟶ U.toScheme),
        Set.range ⇑(s ≫ U.ι) ⊆ (G₀ : Set T) := by
      intro K _ s
      rintro _ ⟨p, rfl⟩
      rw [Scheme.Hom.comp_apply]
      exact hUmem _
    have hFT := fun (K : Type u) [Field K] (s : Spec (.of K) ⟶ U.toScheme) =>
      wcpa_dj_sol_fibre_transfer T U.toScheme Z (u₀ ⁻¹ᵁ U).toScheme u₀ τ₀ U.ι (u₀ ∣_ U)
        (u₀ ⁻¹ᵁ U).ι τU hR.flip hτ₀ L1 L2 K s
    refine ⟨τU, ⟨⟨MorphismProperty.of_isPullback (P := @Flat) hR.flip hfl,
      MorphismProperty.of_isPullback (P := @IsProper) hR.flip hpr,
      fun K _ _ s => (hFT K s).1.mpr (hgood K (s ≫ U.ι) (hrU s)).1⟩,
      ⟨L1, ?_, ?_⟩, fun K _ _ s => (hFT K s).2.mpr (hgood K (s ≫ U.ι) (hrU s)).2⟩, L2⟩
    · intro i j p q hij heq
      have h1 := congrArg (u₀ ⁻¹ᵁ U).ι heq
      rw [pt (L2 i) p, pt (L2 j) q, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
      exact hOdmem _ (hG₀ODS (hUmem p)).1 i j hij _ h1
    · intro j p
      obtain ⟨W₀, hW₀, hW₀sm⟩ := hOsmem _ (hG₀ODS (hUmem p)).2 j
      refine ⟨(u₀ ⁻¹ᵁ U).ι ⁻¹ᵁ W₀, ?_, ?_⟩
      · rw [Scheme.Hom.mem_preimage, pt (L2 j) p, Scheme.Hom.comp_apply]
        exact hW₀
      · exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
          ((isPullback_morphismRestrict (u₀ ⁻¹ᵁ U).ι W₀).paste_vert hR.flip) hW₀sm

  haveI : LocallyConnectedSpace T := by
    rw [locallyConnectedSpace_iff_subsets_isOpen_isConnected]
    intro x U hU
    have hxI : x ∈ (⟨interior U, isOpen_interior⟩ : T.Opens) := mem_interior_iff_mem_nhds.mpr hU
    obtain ⟨A, hAaff, hxA, hAU⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      T.isBasis_affineOpens) hxI
    haveI : IsNoetherianRing Γ(T, A) := IsLocallyNoetherian.component_noetherian ⟨A, hAaff⟩
    haveI : TopologicalSpace.NoetherianSpace (A : Set T) := noetherianSpace_of_isAffineOpen A hAaff
    have hccopen : IsOpen (connectedComponent (⟨x, hxA⟩ : (A : Set T))) := by
      have hfin := TopologicalSpace.NoetherianSpace.finite_irreducibleComponents (α := (A : Set T))
      have heq : (connectedComponent (⟨x, hxA⟩ : (A : Set T)))ᶜ =
          ⋃₀ {Zc ∈ irreducibleComponents (A : Set T) |
            Disjoint Zc (connectedComponent (⟨x, hxA⟩ : (A : Set T)))} := by
        ext y
        constructor
        · intro hy
          obtain ⟨Zc, hZc, hyZ⟩ :=
            exists_mem_irreducibleComponents_subset_of_isIrreducible {y} isIrreducible_singleton
          refine ⟨Zc, ⟨hZc, ?_⟩, hyZ rfl⟩
          have h1 : Zc ⊆ connectedComponent y :=
            hZc.1.isPreirreducible.isPreconnected.subset_connectedComponent (hyZ rfl)
          rw [Set.disjoint_left]
          intro z hz hzx
          apply hy
          have h2 := connectedComponent_eq (h1 hz)
          have h3 := connectedComponent_eq hzx
          rw [h3, ← h2]
          exact mem_connectedComponent
        · rintro ⟨Zc, ⟨_, hdis⟩, hyZ⟩ hy
          exact Set.disjoint_left.mp hdis hyZ hy
      rw [← isClosed_compl_iff, heq]
      exact (hfin.subset (fun Zc h => h.1)).isClosed_sUnion
        (fun Zc h => isClosed_of_mem_irreducibleComponents Zc h.1)
    refine ⟨Subtype.val '' connectedComponent (⟨x, hxA⟩ : (A : Set T)), ?_,
      A.isOpen.isOpenMap_subtype_val _ hccopen, ⟨⟨x, hxA⟩, mem_connectedComponent, rfl⟩,
      isConnected_connectedComponent.image _ continuous_subtype_val.continuousOn⟩
    rintro _ ⟨y, -, rfl⟩
    have hy := hAU y.2
    exact interior_subset hy
  let C : T' → T.Opens := fun t' =>
    ⟨connectedComponentIn (G₀ : Set T) (b t'), G₀.isOpen.connectedComponentIn⟩
  have hCG : ∀ t', C t' ≤ G₀ := fun t' => connectedComponentIn_subset _ _
  have hbC : ∀ t', b t' ∈ C t' := fun t' => mem_connectedComponentIn (hbG₀ t')
  let G : T.Opens := ⨆ t', C t'
  have hGG₀ : G ≤ G₀ := iSup_le hCG
  have hrangeG : Set.range ⇑b ⊆ (G : Set T) := by
    rintro _ ⟨t', rfl⟩
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨t', hbC t'⟩
  obtain ⟨τG, hstG, hτG⟩ := hres G hGG₀

  have hgcC : ∀ t', GeometricallyConnected (u₀ ∣_ C t') := by
    intro t'
    obtain ⟨τC, hstC, -⟩ := hres (C t') (hCG t')
    have hRC : IsPullback (u₀ ∣_ C t') (u₀ ⁻¹ᵁ C t').ι (C t').ι u₀ :=
      isPullback_morphismRestrict u₀ (C t')
    have hw : ((u' ∣_ (b ⁻¹ᵁ C t')) ≫ (b ∣_ C t')) ≫ (C t').ι =
        ((u' ⁻¹ᵁ (b ⁻¹ᵁ C t')).ι ≫ φ) ≫ u₀ := by
      rw [Category.assoc, morphismRestrict_ι, ← Category.assoc, morphismRestrict_ι,
        Category.assoc, Category.assoc, hφ.w]
    have hl1 := hRC.lift_fst _ _ hw
    have hl2 := hRC.lift_snd _ _ hw
    have hout : IsPullback ((u' ⁻¹ᵁ (b ⁻¹ᵁ C t')).ι ≫ φ) (u' ∣_ (b ⁻¹ᵁ C t')) u₀
        ((b ⁻¹ᵁ C t').ι ≫ b) := (isPullback_morphismRestrict u' (b ⁻¹ᵁ C t')).flip.paste_horiz hφ
    have hpbC : IsPullback (hRC.lift _ _ hw) (u' ∣_ (b ⁻¹ᵁ C t')) (u₀ ∣_ C t') (b ∣_ C t') := by
      refine IsPullback.of_right ?_ hl1 hRC.flip
      rw [hl2, morphismRestrict_ι]
      exact hout
    have hconn : ConnectedSpace (C t').toScheme :=
      Subtype.connectedSpace (isConnected_connectedComponentIn_iff.mpr (hbG₀ t'))
    have hne : Nonempty (b ⁻¹ᵁ C t').toScheme := ⟨⟨t', hbC t'⟩⟩
    exact wcpa_dj_lsl_gc_connected_base (C t').toScheme (b ⁻¹ᵁ C t').toScheme
      (u₀ ⁻¹ᵁ C t').toScheme (u' ⁻¹ᵁ (b ⁻¹ᵁ C t')).toScheme (u₀ ∣_ C t') (b ∣_ C t')
      (u' ∣_ (b ⁻¹ᵁ C t')) (hRC.lift _ _ hw) hstC.1
      (MorphismProperty.of_isPullback (P := @LocallyOfFinitePresentation) hRC.flip hfp)
      hconn hne hpbC
      (MorphismProperty.of_isPullback (P := @GeometricallyConnected)
        (isPullback_morphismRestrict u' (b ⁻¹ᵁ C t')).flip hgc)
  have hgcG : GeometricallyConnected (u₀ ∣_ G) := by
    refine ⟨?_⟩
    intro K _ y W fst snd hpb
    obtain ⟨p0⟩ : Nonempty ↥(Spec (.of K)) :=
      ⟨show ↥(Spec (.of K)) from IsLocalRing.closedPoint K⟩
    have hyG : G.ι (y p0) ∈ G := by
      have h1 : G.ι (y p0) ∈ Set.range ⇑G.ι := ⟨_, rfl⟩
      rwa [Scheme.Opens.range_ι] at h1
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hyG
    have hr : Set.range ⇑(y ≫ G.ι) ⊆ Set.range ⇑(C a).ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨q, rfl⟩
      rw [Subsingleton.elim q p0, Scheme.Hom.comp_apply]
      exact ha
    have hya : IsOpenImmersion.lift (C a).ι (y ≫ G.ι) hr ≫ (C a).ι = y ≫ G.ι :=
      IsOpenImmersion.lift_fac _ _ _
    have hRG := isPullback_morphismRestrict u₀ G
    have hRC := isPullback_morphismRestrict u₀ (C a)
    have hout : IsPullback (fst ≫ (u₀ ⁻¹ᵁ G).ι) snd u₀ (y ≫ G.ι) := hpb.paste_horiz hRG.flip
    have hw : (snd ≫ IsOpenImmersion.lift (C a).ι (y ≫ G.ι) hr) ≫ (C a).ι =
        (fst ≫ (u₀ ⁻¹ᵁ G).ι) ≫ u₀ := by
      simpa only [Category.assoc, hya] using hout.w.symm
    have hpbA : IsPullback (hRC.lift _ _ hw) snd (u₀ ∣_ C a)
        (IsOpenImmersion.lift (C a).ι (y ≫ G.ι) hr) := by
      refine IsPullback.of_right ?_ (hRC.lift_fst _ _ hw) hRC.flip
      rw [hRC.lift_snd, hya]
      exact hout
    haveI := hgcC a
    exact GeometricallyConnected.geometrically_connectedSpace _ _ _ hpbA
  exact ⟨G, τG, hrangeG, hstG, hgcG, hτG⟩

