theorem wcpa_dj_lcc_cm_fibre_iso_off_exc (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (r : ℕ)
    (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)) (L : wcpaDjCoc Z₁)
    (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) (m : ℕ)
    (hSH : wcpaLccSH W u₁ ε L t m)
    (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (φ : Z₁ ⟶ Z) (hφ : φ ≫ uu = u₁)
    (hprop : IsProper uu)
    (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Spec (.of ↥W))
    (φs : Limits.pullback u₁ s ⟶ Limits.pullback uu s)
    (h1 : φs ≫ Limits.pullback.fst uu s = Limits.pullback.fst u₁ s ≫ φ)
    (h2 : φs ≫ Limits.pullback.snd uu s = Limits.pullback.snd u₁ s)
    (hP1 : wcpaLccP1 φs) (hABC : wcpaLccContr u₁ uu ε s φs) :
    wcpaLccOffExc u₁ uu ε s φs :=
by
  classical

  have hbij_iso : ∀ {R S : CommRingCat.{u}} (g : R ⟶ S) [IsIso g], Function.Bijective g.hom :=
    fun g _ => ConcreteCategory.bijective_of_isIso g
  have hcompb : ∀ {R S T : CommRingCat.{u}} (a : R ⟶ S) (b : S ⟶ T),
      Function.Bijective b.hom →
      Function.Bijective a.hom → Function.Bijective (a ≫ b).hom := by
    intro R S T a b hb ha
    rw [CommRingCat.hom_comp, RingHom.coe_comp]
    exact hb.comp ha
  have hpre : ∀ {X : Scheme.{u}} {U V : X.Opens} (h : U = V),
      Function.Bijective (X.presheaf.map (eqToHom h).op).hom := by
    intro X U V h
    subst h
    rw [eqToHom_refl, op_id, CategoryTheory.Functor.map_id]
    exact hbij_iso _
  have s2 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y), IsAffineHom f →
      (∀ V : Y.Opens, Function.Bijective (f.app V).hom) → IsIso f := by
    intro X Y f hf hb
    rw [← MorphismProperty.isomorphisms.iff]
    refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := MorphismProperty.isomorphisms Scheme)
      (fun W : Y.affineOpens => (W : Y.Opens)) (iSup_affineOpens_eq_top Y) ?_
    intro W
    rw [MorphismProperty.isomorphisms.iff]
    haveI : IsAffine (f ⁻¹ᵁ (W : Y.Opens)) := hf.isAffine_preimage _ W.2
    haveI : IsAffine (W : Y.Opens) := W.2
    have hb' : Function.Bijective (f ∣_ (W : Y.Opens)).appTop.hom := by
      have e := congrArg (fun g => Function.Bijective ⇑(CommRingCat.Hom.hom g))
        (morphismRestrict_appTop f (W : Y.Opens))
      exact e.mpr (hcompb _ _ (hpre _) (hb _))
    haveI : IsIso (Spec.map (f ∣_ (W : Y.Opens)).appTop) := isIso_SpecMap_iff.mpr hb'
    have e := Scheme.isoSpec_hom_naturality (f ∣_ (W : Y.Opens))
    have e2 : f ∣_ (W : Y.Opens) = (f ⁻¹ᵁ (W : Y.Opens)).toScheme.isoSpec.hom ≫
        Spec.map (f ∣_ (W : Y.Opens)).appTop ≫ (W : Y.Opens).toScheme.isoSpec.inv := by
      rw [← Category.assoc, e, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    rw [e2]
    infer_instance

  have s3 : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] [T0Space X] [CompactSpace X]
      [QuasiSober X] (f : X → Y) (P : Set X → Prop), Continuous f → IsClosedMap f →
      (∀ x x' x'' : X, x ⤳ x' → x' ⤳ x'' → x = x' ∨ x' = x'') →
