          rw [hy]) h
    · exact Stabiso K e (Limits.pullback.snd u' s) (Limits.pullback.snd u (s ≫ b)) I2
        (fun i x => ∃ p : ↥(Spec (.of K)), Limits.pullback.fst u' s x = τ' i (s p))
        (fun i y => ∃ p : ↥(Spec (.of K)), Limits.pullback.fst u (s ≫ b) y = τ i ((s ≫ b) p))
        hiff h

