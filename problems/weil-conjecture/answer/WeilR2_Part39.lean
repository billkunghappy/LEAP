  obtain ⟨φ, hφq, hφpre, hφrel⟩ := S4 Z uu (fun a => Lc.V a ⊓ uu ⁻¹ᵁ ⊤) hcovU
    (fun a J => t J a) (fun a => hVA2 a)
    (fun a b => Z.presheaf.map (homOfLE (kk a b)).op ((Lc.g a b : Γ(Z, Lc.V a ⊓ Lc.V b)) ^ ee))
    (fun a b => ((Lc.g a b).isUnit.pow ee).map (Z.presheaf.map (homOfLE (kk a b)).op).hom)
