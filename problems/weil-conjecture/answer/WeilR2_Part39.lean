      by_contra hna
      push_neg at hna
      apply hz
      refine TopologicalSpace.Opens.mem_iSup.mpr ⟨a, ?_⟩
      show z ∉ ⋃ i, Set.range (σ a i)
      intro hzC
      obtain ⟨i, p, hp⟩ := Set.mem_iUnion.mp hzC
      exact hna i p hp
    choose i p hp using hz'
    have hpz : ∀ a, p a = u' z := fun a => by rw [← hp a, sec_pt _ (hσ1 a (i a))]
