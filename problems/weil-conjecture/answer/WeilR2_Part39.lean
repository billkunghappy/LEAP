      (Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _).trans (cong hπ _ _ _ _)
    have hκ : (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl).hom.comp ((Scheme.ΓSpecIso (.of K)).inv ≫
        pY.appLE ⊤ V₀ le_top).hom =
        ((Scheme.ΓSpecIso (.of K)).inv ≫ pX'.appLE ⊤ (π ⁻¹ᵁ V₀) le_top).hom := by
      refine RingHom.ext fun c => ?_
      exact congrArg (fun f => CommRingCat.Hom.hom f
        ((Scheme.ΓSpecIso (.of K)).inv.hom c)) hκ0
    have hsκ : ∀ a (c : K), sK a (((Scheme.ΓSpecIso (.of K)).inv ≫
        pX'.appLE ⊤ (π ⁻¹ᵁ V₀) le_top).hom c) = c := by
      intro a c
      have h1' : pX'.appLE ⊤ (π ⁻¹ᵁ V₀) le_top ≫ (n a.2).appLE (π ⁻¹ᵁ V₀) ⊤ (hσU a.2) = 𝟙 _ :=
        ((Scheme.Hom.appLE_comp_appLE _ _ _ _ _ _ _).trans
          (cong (hn a.2) ⊤ ⊤ _ (fun _ _ => trivial))).trans (idtop _ _)
      have h2 : ∀ z, ((n a.2).appLE (π ⁻¹ᵁ V₀) ⊤ (hσU a.2)).hom
          ((pX'.appLE ⊤ (π ⁻¹ᵁ V₀) le_top).hom z) = z :=
        fun z => congrArg (fun f => CommRingCat.Hom.hom f z) h1'
      have h3 : ∀ z : K, (Scheme.ΓSpecIso (.of K)).hom.hom ((Scheme.ΓSpecIso (.of K)).inv.hom z) =
          z := fun z => congrArg (fun f => CommRingCat.Hom.hom f z)
            (Iso.inv_hom_id (Scheme.ΓSpecIso (.of K)))
      rw [hsK]
      show (Scheme.ΓSpecIso (.of K)).hom.hom (((n a.2).appLE (π ⁻¹ᵁ V₀) ⊤ (hσU a.2)).hom
          ((pX'.appLE ⊤ (π ⁻¹ᵁ V₀) le_top).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))) = c
      rw [h2, h3]
