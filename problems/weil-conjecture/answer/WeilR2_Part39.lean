          (by rw [e2]; exact e1)
        rw [key2, e2]
    refine ⟨⟨fun h w => SSiso K e.inv _ _ I2' w (h (e.inv w)),
      fun h w => SSiso K e.hom _ _ I2 w (h (e.hom w))⟩, ⟨fun h => ?_, fun h => ?_⟩⟩
    · exact Stabiso K e.symm (Limits.pullback.snd u (s ≫ b)) (Limits.pullback.snd u' s) I2'
