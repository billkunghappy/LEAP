      _ = ⨆ a, Z.basicOpen (t J a) := iSup_congr (fun a => hφpre' a J)



  have hq2 : ∀ r, (uu.appTop).hom r = (φ.appTop).hom ((wcpaLspStr R M).appTop.hom r) := by
    intro r
