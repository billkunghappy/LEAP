            refine Finset.sum_congr rfl (fun l _ => ?_)
            simp only [map_sum, map_mul, Finset.sum_mul, Finset.mul_sum]
            refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl
              (fun j _ => Finset.sum_congr rfl (fun r _ => ?_)))
            ring
    have e := (hu x₀ hx₀).unique (fun a => rfl) key
    intro l
    exact congrFun e l

  have hscal : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Y : Scheme.{u})
      (q : Y ⟶ Spec (.of A)) (V : Y.Opens) (hV : V ≤ q ⁻¹ᵁ ⊤)
      (O : (Limits.pullback q
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).Opens)
      (hO : O ≤ Limits.pullback.fst q
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ V)
      (x : A),
      ((Limits.pullback.fst q
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).appLE
          V O hO).hom ((q.appLE ⊤ V hV).hom ((Scheme.ΓSpecIso (.of A)).inv.hom x)) =
        wcpaLccScal (Limits.pullback.snd q
          (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) O
          (IsLocalRing.residue A x) := by
    intro A _ _ Y q V hV O hO x
    have e1 : ((Limits.pullback.fst q
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).appLE
          V O hO).hom ((q.appLE ⊤ V hV).hom ((Scheme.ΓSpecIso (.of A)).inv.hom x)) =
        ((Limits.pullback.fst q
          (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) ≫ q).appLE
            ⊤ O (by simp only [Scheme.Hom.preimage_top]; exact le_top)).hom
              ((Scheme.ΓSpecIso (.of A)).inv.hom x) :=
      congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (.of A)).inv.hom x))
        (Scheme.Hom.appLE_comp_appLE _ q ⊤ V O hV hO)
    have e2 : ∀ (g g' : Limits.pullback q
          (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) ⟶
          Spec (.of A)) (_ : g = g') (h : O ≤ g ⁻¹ᵁ ⊤) (h' : O ≤ g' ⁻¹ᵁ ⊤)
        (y : Γ(Spec (.of A), ⊤)), (g.appLE ⊤ O h).hom y = (g'.appLE ⊤ O h').hom y := by
      rintro g _ rfl h h' y
      rfl
    refine e1.trans ((e2 _ _ Limits.pullback.condition _
      (by simp only [Scheme.Hom.preimage_top]; exact le_top) _).trans ?_)
    have e4 : (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))).appTop.hom
        ((Scheme.ΓSpecIso (.of A)).inv.hom x) =
        (Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField A))).inv.hom (IsLocalRing.residue A x) := by
      have := congrArg (fun φ => φ.hom x)
        (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      rw [← this, IsLocalRing.ResidueField.algebraMap_eq]
    unfold wcpaLccScal
    rw [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_comp, RingHom.comp_apply,
      ← e4]
    rfl

  have hps : ∀ (n : ℕ) (C : Fin n → Γ(Spec (.of ↥W), ⊤))
      (b : Fin n → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤))
      (s t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)),
      (∀ a, s a * t a = ∑ l, (q.appLE ⊤ (L.V a ⊓ q ⁻¹ᵁ ⊤) inf_le_right).hom (C l) * b l a) →
      ∀ a, wcpaLccPullFam q L (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) s a *
        wcpaLccPullFam q L (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) t a =
        ∑ l, wcpaLccScal (Limits.pullback.snd q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
          ((wcpaDjCocPull (Limits.pullback.fst q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L).V a ⊓
            (Limits.pullback.snd q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ⁻¹ᵁ ⊤)
          (IsLocalRing.residue ↥W ((Scheme.ΓSpecIso (.of ↥W)).hom.hom (C l))) *
          wcpaLccPullFam q L (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) (b l) a := by
    intro n C b s t h a
    unfold wcpaLccPullFam
    rw [← map_mul, h a, map_sum]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [map_mul]
    congr 1
    rw [← hscal (↥W) Y q (L.V a ⊓ q ⁻¹ᵁ ⊤) inf_le_right
      ((wcpaDjCocPull (Limits.pullback.fst q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L).V a ⊓
        (Limits.pullback.snd q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ⁻¹ᵁ ⊤)
      (fun _ hx => ⟨hx.1, trivial⟩) ((Scheme.ΓSpecIso (.of ↥W)).hom.hom (C l)), hιj]
  have nD : ∀ {X Z : Scheme.{u}} (f : X ⟶ Z) (U U' : Z.Opens) (V V' : X.Opens)
      (h₀ : V ≤ f ⁻¹ᵁ U) (h₁ : V' ≤ V) (e' : V' ≤ f ⁻¹ᵁ U') (hU : U' ≤ U) (x : Γ(Z, U)),
      (X.presheaf.map (homOfLE h₁).op).hom ((X.presheaf.map (homOfLE h₀).op).hom ((f.app U).hom x)) =
        (f.appLE U' V' e').hom ((Z.presheaf.map (homOfLE hU).op).hom x) := by
    intro X Z f U U' V V' h₀ h₁ e' hU x
    rw [nC f U V h₀ x]
    exact (nB _ _ _ _).trans (nA _ _ _ _).symm

  have pfc : ∀ (e : ℕ) (t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)),
      wcpaDjCompat L (q ⁻¹ᵁ ⊤) e t →
      wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L)
        ((Limits.pullback.snd q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ⁻¹ᵁ ⊤) e
        (wcpaLccPullFam q L (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) t) := by
    intro e t ht a b
    have h := congrArg ((Limits.pullback.fst q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).appLE
      (L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ ⊤)
      ((wcpaDjCocPull (Limits.pullback.fst q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L).V a ⊓
        (wcpaDjCocPull (Limits.pullback.fst q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L).V b ⊓
        (Limits.pullback.snd q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ⁻¹ᵁ ⊤)
      (fun _ hx => ⟨⟨hx.1.1, hx.1.2⟩, trivial⟩)).hom (ht a b)
    simp only [map_mul, map_pow] at h
    unfold wcpaLccPullFam
    simp only [map_pow]
    convert h using 1
    · exact (nB _ _ _ _).trans (nA _ _ _ _).symm
    · congr 1
      · congr 1
        simp only [wcpaDjCocPull, Units.coe_map, MonoidHom.coe_coe, RingHom.coe_comp,
          Function.comp_apply]
        exact nD _ _ _ _ _ _ _ _ _ _
      · exact (nB _ _ _ _).trans (nA _ _ _ _).symm

  obtain ⟨N₁, b₁, hb₁, hgl₁, hfib₁⟩ := hBC₁
  obtain ⟨N₂, b₂, hb₂, hgl₂, hfib₂⟩ := hBC₂
  obtain ⟨N, b, hb, hgl, hfib⟩ := hBC
  choose C hC using fun i j =>
    (hgl (fun a => b₁ i a * b₂ j a) (cmul L _ e₁ e₂ _ _ (hb₁ i) (hb₂ j))).exists
  have hG4 := fibre_span (IsLocalRing.ResidueField ↥W) _
    (Limits.pullback.snd q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
    (wcpaDjCocPull (Limits.pullback.fst q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L)
    e₁ e₂ N₁ N₂ N
    (fun i a => wcpaLccPullFam q L (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) (b₁ i) a)
    (fun j a => wcpaLccPullFam q L (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) (b₂ j) a)
    (fun l a => wcpaLccPullFam q L (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) (b l) a)
    (fun i j l => IsLocalRing.residue ↥W ((Scheme.ΓSpecIso (.of ↥W)).hom.hom (C i j l)))
    (fun l => pfc _ (b l) (hb l))
    (fun t ht => (hfib₁ _ _ t ht).exists) (fun t ht => (hfib₂ _ _ t ht).exists)
    (fun t ht => hfib _ _ t ht)
    (fun i j => hps N (C i j) b (b₁ i) (b₂ j) (hC i j)) hCF
  let fpe : Fin N₁ × Fin N₂ ≃ Fin (N₁ * N₂) := finProdFinEquiv
  let Mw : Matrix (Fin N) (Fin (N₁ * N₂)) ↥W := Matrix.of fun l k =>
    (Scheme.ΓSpecIso (.of ↥W)).hom.hom (C (fpe.symm k).1 (fpe.symm k).2 l)
  have hres_surj : ∀ vb : Fin N → IsLocalRing.ResidueField ↥W, ∃ wb : Fin (N₁ * N₂) → IsLocalRing.ResidueField ↥W,
      (Mw.map (IsLocalRing.residue ↥W)).mulVec wb = vb := by
    intro vb
    obtain ⟨E, hE⟩ := hG4 vb
    refine ⟨fun k => E (fpe.symm k).1 (fpe.symm k).2, ?_⟩
    funext l
    rw [hE l]
    simp only [Matrix.mulVec, dotProduct, Matrix.map_apply, Matrix.of_apply, Mw]
    rw [← Fintype.sum_prod_type']
    exact Equiv.sum_comp fpe.symm (fun p => IsLocalRing.residue ↥W
      ((Scheme.ΓSpecIso (.of ↥W)).hom.hom (C p.1 p.2 l)) * E p.1 p.2)
  have hsurj := nak (↥W) N (N₁ * N₂) Mw hres_surj
  obtain ⟨cx, hcx⟩ := (hgl x hx).exists
  obtain ⟨w, hw⟩ := hsurj (fun l => (Scheme.ΓSpecIso (.of ↥W)).hom.hom (cx l))
  refine ⟨N₁ * N₂, fun k a => (q.appLE ⊤ (L.V a ⊓ q ⁻¹ᵁ ⊤) inf_le_right).hom
      ((Scheme.ΓSpecIso (.of ↥W)).inv.hom (w k)) * b₁ (fpe.symm k).1 a,
    fun k a => b₂ (fpe.symm k).2 a, ?_, ?_⟩
  · intro k
    refine ⟨?_, hb₂ _⟩
    intro a a'
    simp only [map_mul, nB]
    rw [hb₁ _ a a']
    ring
  · intro a
    have hcl : ∀ l, cx l = ∑ k, (Scheme.ΓSpecIso (.of ↥W)).inv.hom (w k) *
        C (fpe.symm k).1 (fpe.symm k).2 l := by
      intro l
      have h1 := congrFun hw l
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Mw] at h1
      rw [← hιj (cx l), ← h1, map_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [map_mul, hιj, mul_comm]
    rw [hcx a]
    have e1 : ∀ k, (q.appLE ⊤ (L.V a ⊓ q ⁻¹ᵁ ⊤) inf_le_right).hom
        ((Scheme.ΓSpecIso (.of ↥W)).inv.hom (w k)) * b₁ (fpe.symm k).1 a * b₂ (fpe.symm k).2 a =
        ∑ l, (q.appLE ⊤ (L.V a ⊓ q ⁻¹ᵁ ⊤) inf_le_right).hom
          ((Scheme.ΓSpecIso (.of ↥W)).inv.hom (w k) * C (fpe.symm k).1 (fpe.symm k).2 l) * b l a := by
      intro k
      rw [mul_assoc, hC _ _ a, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [map_mul]
      ring
    rw [Finset.sum_congr rfl (fun k _ => e1 k), Finset.sum_comm]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [← Finset.sum_mul, ← map_sum, ← hcl l]

theorem wcpa_dj_lcc_cm_section_ring_fg (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (r : ℕ)
    (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)) (L : wcpaDjCoc Z₁)
    (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) (m : ℕ)
    (hSH : wcpaLccSH W u₁ ε L t m) :
    ∃ d₀ : ℕ, 1 ≤ d₀ ∧ wcpaLccGenBy u₁ L m d₀ :=
by
  classical
  obtain ⟨hss, hsec, hOK, hcompat, hbo, hHAF, hm, hBC, _hGG⟩ := hSH
  haveI hκ : IsAlgClosed (IsLocalRing.ResidueField ↥W) := wcpa_dj_nc_residue_algclosed Ω W
  obtain ⟨m₀, hm₀, hgood⟩ :=
    wcpa_dj_lge_closed_fibre_good Ω W Z₁ u₁ r ε L t hκ hss hsec hOK hcompat hbo hHAF
  obtain ⟨hnoeth, hdim⟩ := wcpa_dj_lus_cvs_ct_closed_fibre_dim Ω W hκ Z₁ u₁ hss
  haveI hρ : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) := by
    apply IsClosedImmersion.spec_of_surjective
    exact IsLocalRing.residue_surjective
  have hOK₀ := wcpa_dj_lcc_sr_cocok_pull (Limits.pullback.fst u₁
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L hOK
  refine ⟨3 * m₀, by omega, ?_⟩
  intro k hk x hx
  obtain ⟨j, rfl⟩ : ∃ j, k = 3 * m₀ + 1 + j := ⟨k - (3 * m₀ + 1), by omega⟩
  have hp : m₀ ≤ m * m₀ := Nat.le_mul_of_pos_left m₀ hm
  have he : m₀ ≤ m * (m₀ + 1 + j) :=
    le_trans (by omega : m₀ ≤ m₀ + 1 + j) (Nat.le_mul_of_pos_left _ hm)

  obtain ⟨s₁, s₂, hs₁, hs₂, hbez⟩ := wcpa_dj_lcc_sr_pencil_exists
    (IsLocalRing.ResidueField ↥W) _ _ _ (m * m₀) hOK₀ hnoeth hdim (hgood (m * m₀) hp).2

  have hclosed := fun x₀ hx₀ =>
    wcpa_dj_lcc_sr_pencil_mul_surj _ _ _ (m * m₀) (m * (m₀ + 1 + j)) s₁ s₂ hOK₀ hs₁ hs₂ hbez
      (fun c hc => (hgood (m * (m₀ + 1 + j)) he).1 c hc) x₀ hx₀
  have hBC1 : wcpaLccBC u₁ L (m * m₀) := hBC m₀ hm₀
  have heq2 : m * (3 * m₀ + 1 + j - m₀) = m * m₀ + m * (m₀ + 1 + j) := by
    rw [show 3 * m₀ + 1 + j - m₀ = m₀ + (m₀ + 1 + j) by omega, Nat.mul_add]
  have heq12 : m * (3 * m₀ + 1 + j) = m * m₀ + (m * m₀ + m * (m₀ + 1 + j)) := by ring
  have hBC2 : wcpaLccBC u₁ L (m * m₀ + m * (m₀ + 1 + j)) := by
    rw [← heq2]; exact hBC _ (by omega)
  have hBC12 : wcpaLccBC u₁ L (m * m₀ + (m * m₀ + m * (m₀ + 1 + j))) := by
    rw [← heq12]; exact hBC _ (by omega)
  have hx' : wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) (m * m₀ + (m * m₀ + m * (m₀ + 1 + j))) x := by
    rw [← heq12]; exact hx
  obtain ⟨n, y, z, hyz, hsum⟩ := wcpa_dj_lcc_sr_nakayama_lift Ω W Z₁ u₁ L (m * m₀)
    (m * m₀ + m * (m₀ + 1 + j)) hBC1 hBC2 hBC12 (by
      intro x₀ hx₀
      obtain ⟨y₁, y₂, hy₁, hy₂, hxy⟩ := hclosed x₀ hx₀
      refine ⟨2, ![s₁, s₂], ![y₁, y₂], ?_, ?_⟩
      · intro l
        fin_cases l
        · exact ⟨hs₁, hy₁⟩
        · exact ⟨hs₂, hy₂⟩
      · intro a
        rw [Fin.sum_univ_two]
        exact hxy a) x hx'
  refine ⟨n, fun _ => m₀, y, z, fun l => ⟨hm₀, show m₀ ≤ 3 * m₀ by omega, (hyz l).1, ?_⟩, hsum⟩
  show wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) (m * (3 * m₀ + 1 + j - m₀)) (z l)
  rw [heq2]
  exact (hyz l).2

theorem wcpa_dj_lcc_fp_section_ring_data (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (r : ℕ)
    (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)) (L : wcpaDjCoc Z₁)
    (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) (m d₀ : ℕ)
    (hSH : wcpaLccSH W u₁ ε L t m) (hd₀ : 1 ≤ d₀) (hgen : wcpaLccGenBy u₁ L m d₀) :
    ∃ D : wcpaLccSRD W u₁ L, wcpaLccSRDOK D m :=
by
  obtain ⟨-, -, hOK, -, -, -, -, hBC, hGG⟩ := hSH
  classical

  have cz : ∀ e : ℕ, wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) e
      (0 : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) := by
    intro e a b
    simp only [Pi.zero_apply, map_zero, mul_zero]
  have cadd : ∀ (e : ℕ) (x y : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)),
      wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) e x → wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) e y →
      wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) e (x + y) := by
    intro e x y hx hy a b
    simp only [Pi.add_apply, map_add, hx a b, hy a b, mul_add]
  have cneg : ∀ (e : ℕ) (x : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)),
      wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) e x → wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) e (-x) := by
    intro e x hx a b
    simp only [Pi.neg_apply, map_neg, hx a b, mul_neg]
  have cmul : ∀ (e e' : ℕ) (x y : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)),
      wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) e x → wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) e' y →
      wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) (e + e') (x * y) := by
    intro e e' x y hx hy a b
    simp only [Pi.mul_apply, map_mul, hx a b, hy a b, pow_add]
    ring
  have resLE : ∀ (U : (Spec (.of ↥W)).Opens) (V V' : Z₁.Opens) (hU : V ≤ u₁ ⁻¹ᵁ U)
      (h : V' ≤ V) (c : Γ(Spec (.of ↥W), U)),
      (Z₁.presheaf.map (homOfLE h).op).hom ((u₁.appLE U V hU).hom c) =
        (u₁.appLE U V' (h.trans hU)).hom c := by
    intro U V V' hU h c
    have := congrArg (fun φ => φ.hom c) (Scheme.Hom.appLE_map u₁ hU (homOfLE h).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at this
    exact this
  have cconst : ∀ c : Γ(Spec (.of ↥W), ⊤), wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) 0
      (fun a => (u₁.appLE ⊤ (L.V a ⊓ u₁ ⁻¹ᵁ ⊤) inf_le_right).hom c) := by
    intro c a b
    rw [resLE, resLE, pow_zero, map_one, one_mul]

  have s1 : ∀ (R A : Type u) [CommRing R] [CommRing A] (ι : R →+* A) (N : ℕ → AddSubgroup A),
      (∀ x : A, x ∈ N 0 ↔ ∃ w : R, ι w = x) →
      (∀ (i j : ℕ) (x y : A), x ∈ N i → y ∈ N j → x * y ∈ N (i + j)) →
      ∃ (S : Type u) (_ : CommRing S) (𝒜 : ℕ → AddSubgroup S) (_ : GradedRing 𝒜)
        (ρ₀ : R →+* ↥(𝒜 0)) (ev : S →+* A), Function.Surjective ρ₀ ∧
        (∀ w : R, ev ((ρ₀ w : ↥(𝒜 0)) : S) = ι w) ∧ (∀ (k : ℕ) (r : S), r ∈ 𝒜 k → ev r ∈ N k) ∧
        (∀ (k : ℕ) (x : A), x ∈ N k → ∃! r : S, r ∈ 𝒜 k ∧ ev r = x) := by
    intro R A _ _ ι N h0 hmul
    have hGM : SetLike.GradedMonoid N :=
      { one_mem := (h0 1).2 ⟨1, map_one ι⟩
        mul_mem := fun i j a b ha hb => hmul i j a b ha hb }
    let 𝒜 : ℕ → AddSubgroup (DirectSum ℕ (fun k => ↥(N k))) :=
      fun k => (DirectSum.of (fun k => ↥(N k)) k).range
    have mem𝒜 : ∀ k r, r ∈ 𝒜 k ↔ ∃ y, DirectSum.of (fun k => ↥(N k)) k y = r :=
      fun k r => AddMonoidHom.mem_range
    have hGM2 : SetLike.GradedMonoid 𝒜 :=
      { one_mem := (mem𝒜 0 1).2 ⟨⟨1, SetLike.one_mem_graded N⟩, rfl⟩
        mul_mem := by
          intro i j a b ha hb
          obtain ⟨a', rfl⟩ := (mem𝒜 i a).1 ha
          obtain ⟨b', rfl⟩ := (mem𝒜 j b).1 hb
          exact (mem𝒜 _ _).2 ⟨⟨(a' : A) * b', SetLike.mul_mem_graded a'.2 b'.2⟩,
            by rw [DirectSum.of_mul_of]; rfl⟩ }
    let dk : ∀ k, ↥(N k) →+ ↥(𝒜 k) := fun k =>
      { toFun := fun y => ⟨DirectSum.of (fun k => ↥(N k)) k y, (mem𝒜 k _).2 ⟨y, rfl⟩⟩
        map_zero' := Subtype.ext (map_zero _)
        map_add' := fun a b => Subtype.ext (map_add _ a b) }
    let dec : DirectSum ℕ (fun k => ↥(N k)) →+ DirectSum ℕ (fun k => ↥(𝒜 k)) :=
      DirectSum.toAddMonoid (fun k => (DirectSum.of (fun k => ↥(𝒜 k)) k).comp (dk k))
    have hdec : ∀ k y, dec (DirectSum.of _ k y) = DirectSum.of (fun k => ↥(𝒜 k)) k (dk k y) :=
      fun k y => DirectSum.toAddMonoid_of _ _ _
    let decomp : DirectSum.Decomposition 𝒜 := DirectSum.Decomposition.ofAddHom 𝒜 dec
      (by
        apply DirectSum.addHom_ext
        intro k y
        rw [AddMonoidHom.comp_apply, hdec, DirectSum.coeAddMonoidHom_of]
        rfl)
      (by
        apply DirectSum.addHom_ext
        intro k y
        obtain ⟨z, hz⟩ := (mem𝒜 k _).1 y.2
        rw [AddMonoidHom.comp_apply, DirectSum.coeAddMonoidHom_of, AddMonoidHom.id_apply, ← hz,
          hdec]
        congr 1
        exact Subtype.ext hz)
    let gr : GradedRing 𝒜 := { hGM2, decomp with }
    have hι0 : ∀ w, ι w ∈ N 0 := fun w => (h0 _).2 ⟨w, rfl⟩
    let ρ₀ : R →+* ↥(𝒜 0) :=
      { toFun := fun w => ⟨DirectSum.of (fun k => ↥(N k)) 0 ⟨ι w, hι0 w⟩, (mem𝒜 0 _).2 ⟨_, rfl⟩⟩
        map_one' := by
          apply Subtype.ext
          rw [SetLike.GradeZero.coe_one]
          show DirectSum.of (fun k => ↥(N k)) 0 ⟨ι 1, hι0 1⟩ =
            DirectSum.of (fun k => ↥(N k)) 0 ⟨1, SetLike.one_mem_graded N⟩
          exact congrArg (DirectSum.of (fun k => ↥(N k)) 0) (Subtype.ext (map_one ι))
        map_mul' := by
          intro a b
          apply Subtype.ext
          rw [SetLike.GradeZero.coe_mul]
          show DirectSum.of (fun k => ↥(N k)) 0 ⟨ι (a * b), hι0 _⟩ =
            DirectSum.of (fun k => ↥(N k)) 0 ⟨ι a, hι0 a⟩ *
              DirectSum.of (fun k => ↥(N k)) 0 ⟨ι b, hι0 b⟩
          rw [DirectSum.of_mul_of]
          exact congrArg (DirectSum.of (fun k => ↥(N k)) 0) (Subtype.ext (map_mul ι a b))
        map_zero' := by
          apply Subtype.ext
          show DirectSum.of (fun k => ↥(N k)) 0 ⟨ι 0, hι0 0⟩ = 0
          rw [← map_zero (DirectSum.of (fun k => ↥(N k)) 0)]
          congr 1
          exact Subtype.ext (map_zero ι)
        map_add' := by
          intro a b
          apply Subtype.ext
          show DirectSum.of (fun k => ↥(N k)) 0 ⟨ι (a + b), hι0 _⟩ =
            DirectSum.of (fun k => ↥(N k)) 0 ⟨ι a, hι0 a⟩ +
              DirectSum.of (fun k => ↥(N k)) 0 ⟨ι b, hι0 b⟩
          rw [← map_add]
          congr 1
          exact Subtype.ext (map_add ι a b) }
    refine ⟨DirectSum ℕ (fun k => ↥(N k)), inferInstance, 𝒜, gr, ρ₀, DirectSum.coeRingHom N,
      ?_, ?_, ?_, ?_⟩
    · intro r
      obtain ⟨y, hy⟩ := (mem𝒜 0 _).1 r.2
      obtain ⟨w, hw⟩ := (h0 _).1 y.2
      refine ⟨w, Subtype.ext ?_⟩
      show DirectSum.of (fun k => ↥(N k)) 0 ⟨ι w, hι0 w⟩ = (r : DirectSum ℕ (fun k => ↥(N k)))
      rw [← hy]
      congr 1
      exact Subtype.ext hw
    · intro w
      show DirectSum.coeRingHom N (DirectSum.of (fun k => ↥(N k)) 0 ⟨ι w, hι0 w⟩) = ι w
      rw [DirectSum.coeRingHom_of]
    · intro k r hr
      obtain ⟨y, rfl⟩ := (mem𝒜 k _).1 hr
      rw [DirectSum.coeRingHom_of]
      exact y.2
    · intro k x hx
      refine ⟨DirectSum.of (fun k => ↥(N k)) k ⟨x, hx⟩, ⟨(mem𝒜 k _).2 ⟨_, rfl⟩, ?_⟩, ?_⟩
      · rw [DirectSum.coeRingHom_of]
      · rintro r' ⟨hr', he⟩
        obtain ⟨y', rfl⟩ := (mem𝒜 k _).1 hr'
        rw [DirectSum.coeRingHom_of] at he
        congr 1
        exact Subtype.ext he

  have s4 : ∀ (S : Type u) [CommRing S] (𝒜 : ℕ → AddSubgroup S) [GradedRing 𝒜] (d₀ M : ℕ)
      (x : Fin M → S),
      (∀ k : ℕ, 1 ≤ k → k ≤ d₀ → ∀ y ∈ 𝒜 k, y ∈ Submodule.span ↥(𝒜 0) (Set.range x)) →
      (∀ k : ℕ, d₀ < k → ∀ y ∈ 𝒜 k, ∃ (n : ℕ) (i : Fin n → ℕ) (p q : Fin n → S),
        (∀ l, 1 ≤ i l ∧ i l ≤ d₀ ∧ p l ∈ 𝒜 (i l) ∧ q l ∈ 𝒜 (k - i l)) ∧ y = ∑ l, p l * q l) →
      Algebra.FiniteType ↥(𝒜 0) S ∧
        (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤ Ideal.span (Set.range x) := by
    intro S _ 𝒜 _ d₀ M x Hlow Hhigh
    have low : ∀ k, 1 ≤ k → k ≤ d₀ → ∀ y ∈ 𝒜 k, y ∈ Ideal.span (Set.range x) := by
      intro k hk1 hk2 y hy
      have hspan := Hlow k hk1 hk2 y hy
      refine Submodule.span_induction (p := fun z _ => z ∈ Ideal.span (Set.range x))
        (fun z hz => Ideal.subset_span hz) (Ideal.zero_mem _)
        (fun a b _ _ ha hb => Ideal.add_mem _ ha hb) (fun c z _ hz => ?_) hspan
      rw [Algebra.smul_def]
      exact Ideal.mul_mem_left _ _ hz
    have hI : ∀ k, 1 ≤ k → ∀ y ∈ 𝒜 k, y ∈ Ideal.span (Set.range x) := by
      intro k hk y hy
      by_cases hkd : k ≤ d₀
      · exact low k hk hkd y hy
      · obtain ⟨n, i, p, q, hpq, rfl⟩ := Hhigh k (by omega) y hy
        exact Ideal.sum_mem _ fun l _ =>
          Ideal.mul_mem_right _ _ (low (i l) (hpq l).1 (hpq l).2.1 _ (hpq l).2.2.1)
    refine ⟨?_, ?_⟩
    · let B := Algebra.adjoin ↥(𝒜 0) (Set.range x)
      have lowB : ∀ j, 1 ≤ j → j ≤ d₀ → ∀ z ∈ 𝒜 j, z ∈ B := fun j hj1 hj2 z hz =>
        Algebra.span_le_adjoin _ _ (Hlow j hj1 hj2 z hz)
      have G : ∀ k, ∀ y ∈ 𝒜 k, y ∈ B := by
        intro k
        induction k using Nat.strong_induction_on with
        | _ k ih =>
          intro y hy
          by_cases hk0 : k = 0
          · subst hk0
            have e : algebraMap (↥(𝒜 0)) S ⟨y, hy⟩ = y := rfl
            rw [← e]
            exact Subalgebra.algebraMap_mem _ _
          by_cases hkd : k ≤ d₀
          · exact lowB k (by omega) hkd y hy
          · obtain ⟨n, i, p, q, hpq, rfl⟩ := Hhigh k (by omega) y hy
            refine Subalgebra.sum_mem _ fun l _ => Subalgebra.mul_mem _
              (lowB _ (hpq l).1 (hpq l).2.1 _ (hpq l).2.2.1) (ih _ ?_ _ (hpq l).2.2.2)
            have := (hpq l).1
            have := (hpq l).2.1
            omega
      have hB : B = ⊤ := by
        rw [eq_top_iff]
        intro s _
        refine DirectSum.Decomposition.inductionOn 𝒜 (motive := fun s => s ∈ B) B.zero_mem ?_ ?_ s
        · intro i m
          exact G i _ m.2
        · intro a b ha hb
          exact B.add_mem ha hb
      exact ⟨⟨(Set.finite_range x).toFinset, by rw [Set.Finite.coe_toFinset]; exact hB⟩⟩
    · intro a ha
      rw [HomogeneousIdeal.mem_iff, HomogeneousIdeal.mem_irrelevant_iff] at ha
      rw [← DirectSum.sum_support_decompose 𝒜 a]
      refine Ideal.sum_mem _ fun i _ => ?_
      by_cases h0 : i = 0
      · subst h0
        have h : ((DirectSum.decompose 𝒜 a 0 : S)) = 0 := by
          rw [← GradedRing.proj_apply]; exact ha
        rw [h]
        exact Ideal.zero_mem _
      · exact hI i (Nat.one_le_iff_ne_zero.mpr h0) _ (SetLike.coe_mem _)

  let ι : ↥W →+* (∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) :=
    RingHom.pi fun a => (u₁.appLE ⊤ (L.V a ⊓ u₁ ⁻¹ᵁ ⊤) inf_le_right).hom.comp
      (Scheme.ΓSpecIso (.of ↥W)).inv.hom
  let N : ℕ → AddSubgroup (∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) := fun k =>
    { carrier := {x | wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) (m * k) x ∧ (k = 0 → ∃ w, ι w = x)}
      zero_mem' := ⟨cz _, fun _ => ⟨0, map_zero ι⟩⟩
      add_mem' := by
        rintro x y ⟨hx1, hx2⟩ ⟨hy1, hy2⟩
        refine ⟨cadd _ _ _ hx1 hy1, fun hk => ?_⟩
        obtain ⟨w, rfl⟩ := hx2 hk
        obtain ⟨w', rfl⟩ := hy2 hk
        exact ⟨w + w', map_add ι w w'⟩
      neg_mem' := by
        rintro x ⟨hx1, hx2⟩
        refine ⟨cneg _ _ hx1, fun hk => ?_⟩
        obtain ⟨w, rfl⟩ := hx2 hk
        exact ⟨-w, map_neg ι w⟩ }
  have memN : ∀ k x, x ∈ N k ↔
      (wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) (m * k) x ∧ (k = 0 → ∃ w, ι w = x)) := fun k x => Iff.rfl
  have h0 : ∀ x, x ∈ N 0 ↔ ∃ w, ι w = x := by
    intro x
    rw [memN]
    constructor
    · exact fun h => h.2 rfl
    · rintro ⟨w, rfl⟩
      refine ⟨?_, fun _ => ⟨w, rfl⟩⟩
      rw [mul_zero]
      exact cconst ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w)
  have hmul : ∀ (i j : ℕ) (x y : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)),
      x ∈ N i → y ∈ N j → x * y ∈ N (i + j) := by
    intro i j x y hx hy
    rw [memN] at hx hy ⊢
    refine ⟨?_, fun hk => ?_⟩
    · rw [mul_add]
      exact cmul _ _ _ _ hx.1 hy.1
    · obtain ⟨w, rfl⟩ := hx.2 (by omega)
      obtain ⟨w', rfl⟩ := hy.2 (by omega)
      exact ⟨w * w', map_mul ι w w'⟩

  obtain ⟨S, iS, 𝒜, iG, ρ₀, ev₀, P1, P2, P3, P4⟩ :=
    s1 ↥W (∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) ι N h0 hmul
  have compat_of : ∀ k (r : S), r ∈ 𝒜 k → wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) (m * k) (ev₀ r) :=
    fun k r hr => ((memN k _).1 (P3 k r hr)).1
  have F : ∀ k : ℕ, 1 ≤ k → ∀ x, wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) (m * k) x →
      ∃! r : S, r ∈ 𝒜 k ∧ ev₀ r = x :=
    fun k hk x hx => P4 k x ((memN k x).2 ⟨hx, fun h => absurd h (by omega)⟩)
  have Finj : ∀ k (r r' : S), r ∈ 𝒜 k → r' ∈ 𝒜 k → ev₀ r = ev₀ r' → r = r' := by
    intro k r r' hr hr' he
    obtain ⟨r0, _, hu⟩ := P4 k _ (P3 k r hr)
    exact (hu r ⟨hr, rfl⟩).trans (hu r' ⟨hr', he.symm⟩).symm

  have O7 : ∀ k : ℕ, 1 ≤ k → ∀ w : ↥W, w ≠ 0 → ∀ y ∈ 𝒜 k,
      ((ρ₀ w : ↥(𝒜 0)) : S) * y = 0 → y = 0 := by
    intro k hk w hw y hy hwy
    have hx := compat_of k y hy
    obtain ⟨Nn, b, hb, hU, -⟩ := hBC k hk
    obtain ⟨c, hc, -⟩ := hU (ev₀ y) hx
    obtain ⟨c0, -, hu0⟩ := hU 0 (cz _)
    have hzero : ι w * ev₀ y = 0 := by rw [← P2 w, ← map_mul, hwy, map_zero]
    have e1 : (fun j => (Scheme.ΓSpecIso (.of ↥W)).inv.hom w * c j) = c0 := by
      apply hu0
      intro a
      have := congrFun hzero a
      rw [Pi.mul_apply, Pi.zero_apply, hc a, Finset.mul_sum] at this
      rw [Pi.zero_apply, ← this]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, mul_assoc]
      rfl
    have e2 : (fun _ => 0) = c0 := hu0 _ (fun a => by
      simp only [Pi.zero_apply, map_zero, zero_mul, Finset.sum_const_zero])
    have hcj : ∀ j, c j = 0 := by
      intro j
      have h := congrFun (e1.trans e2.symm) j
      simp only at h
      have h' := congrArg (Scheme.ΓSpecIso (.of ↥W)).hom.hom h
      have hw' : (Scheme.ΓSpecIso (.of ↥W)).hom.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w) = w := by
        simp
      rw [map_mul, map_zero, hw'] at h'
      rcases mul_eq_zero.1 h' with h3 | h3
      · exact absurd h3 hw
      · have e : c j = (Scheme.ΓSpecIso (.of ↥W)).inv.hom
            ((Scheme.ΓSpecIso (.of ↥W)).hom.hom (c j)) := by simp
        rw [e, h3, map_zero]
    have hx0 : ev₀ y = 0 := by
      funext a
      rw [hc a]
      simp only [hcj, Pi.zero_apply, map_zero, zero_mul, Finset.sum_const_zero]
    exact Finj k y 0 hy (zero_mem _) (by rw [hx0, map_zero])

  choose Nf bf hbf hUf _ using fun i : Fin d₀ => hBC (i.1 + 1) (by omega)
  choose β hβ using fun (i : Fin d₀) (j : Fin (Nf i)) =>
    (F (i.1 + 1) (by omega) (bf i j) (hbf i j)).exists
  let eqv := finSigmaFinEquiv (m := d₀) (n := Nf)
  let xg : Fin (∑ i, Nf i) → S := fun J => β (eqv.symm J).1 (eqv.symm J).2
  let dg : Fin (∑ i, Nf i) → ℕ := fun J => (eqv.symm J).1.1 + 1
  have Hlow : ∀ k : ℕ, 1 ≤ k → k ≤ d₀ → ∀ y ∈ 𝒜 k,
      y ∈ Submodule.span ↥(𝒜 0) (Set.range xg) := by
    intro k hk1 hk2 y hy
    obtain ⟨i, rfl⟩ : ∃ i : Fin d₀, k = i.1 + 1 := ⟨⟨k - 1, by omega⟩, by simp only; omega⟩
    obtain ⟨c, hc, -⟩ := hUf i (ev₀ y) (compat_of _ y hy)
    have hmem : ∀ j, ((ρ₀ ((Scheme.ΓSpecIso (.of ↥W)).hom.hom (c j)) : ↥(𝒜 0)) : S) * β i j ∈
        𝒜 (i.1 + 1) := by
      intro j
      have := SetLike.mul_mem_graded (ρ₀ ((Scheme.ΓSpecIso (.of ↥W)).hom.hom (c j))).2 (hβ i j).1
      rwa [zero_add] at this
    have hyy : y = ∑ j, ((ρ₀ ((Scheme.ΓSpecIso (.of ↥W)).hom.hom (c j)) : ↥(𝒜 0)) : S) *
        β i j := by
      apply Finj _ _ _ hy (AddSubgroup.sum_mem _ fun j _ => hmem j)
      funext a
      rw [hc a, map_sum, Finset.sum_apply]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_mul, Pi.mul_apply, P2, (hβ i j).2]
      congr 1
      show _ = (u₁.appLE ⊤ (L.V a ⊓ u₁ ⁻¹ᵁ ⊤) inf_le_right).hom
        ((Scheme.ΓSpecIso (.of ↥W)).inv.hom ((Scheme.ΓSpecIso (.of ↥W)).hom.hom (c j)))
      simp
    rw [hyy]
    refine Submodule.sum_mem _ fun j _ => ?_
    have e : ((ρ₀ ((Scheme.ΓSpecIso (.of ↥W)).hom.hom (c j)) : ↥(𝒜 0)) : S) * β i j =
        ρ₀ ((Scheme.ΓSpecIso (.of ↥W)).hom.hom (c j)) • β i j := by
      rw [Algebra.smul_def]; rfl
    rw [e]
    refine Submodule.smul_mem _ _ (Submodule.subset_span ⟨eqv ⟨i, j⟩, ?_⟩)
    show β (eqv.symm (eqv ⟨i, j⟩)).1 (eqv.symm (eqv ⟨i, j⟩)).2 = β i j
    rw [Equiv.symm_apply_apply]

  have Hhigh : ∀ k : ℕ, d₀ < k → ∀ y ∈ 𝒜 k, ∃ (n : ℕ) (i : Fin n → ℕ) (p q : Fin n → S),
      (∀ l, 1 ≤ i l ∧ i l ≤ d₀ ∧ p l ∈ 𝒜 (i l) ∧ q l ∈ 𝒜 (k - i l)) ∧ y = ∑ l, p l * q l := by
    intro k hk y hy
    obtain ⟨n, i, yy, zz, hl, hsum⟩ := hgen k hk (ev₀ y) (compat_of k y hy)
    choose p hp using fun l => (F (i l) (hl l).1 (yy l) (hl l).2.2.1).exists
    choose q hq using fun l =>
      (F (k - i l) (by have := (hl l).2.1; omega) (zz l) (hl l).2.2.2).exists
    refine ⟨n, i, p, q, fun l => ⟨(hl l).1, (hl l).2.1, (hp l).1, (hq l).1⟩, ?_⟩
    apply Finj k _ _ hy
    · refine AddSubgroup.sum_mem _ fun l _ => ?_
      have := SetLike.mul_mem_graded (hp l).1 (hq l).1
      rwa [Nat.add_sub_of_le (le_trans (hl l).2.1 hk.le)] at this
    · funext a
      rw [hsum a, map_sum, Finset.sum_apply]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [map_mul, Pi.mul_apply, (hp l).2, (hq l).2]
  obtain ⟨O5, hirr⟩ := s4 S 𝒜 d₀ (∑ i, Nf i) xg Hlow Hhigh

  obtain ⟨M', s, hs, hcov⟩ := hGG
  have hspan : ∀ a, Ideal.span (Set.range fun J => s J a) = ⊤ := by
    intro a
    have hU : IsAffineOpen (L.V a ⊓ u₁ ⁻¹ᵁ ⊤) := by
      rw [Scheme.Hom.preimage_top, inf_top_eq]; exact hOK.1 a
    rw [← hU.self_le_iSup_basicOpen_iff]
    intro z hz
    have hz' : z ∈ ⨆ J, ⨆ b, Z₁.basicOpen (s J b) := by rw [hcov]; trivial
    obtain ⟨J, hJ⟩ := TopologicalSpace.Opens.mem_iSup.1 hz'
    obtain ⟨b, hb⟩ := TopologicalSpace.Opens.mem_iSup.1 hJ
    have hb' := TopologicalSpace.Opens.mem_inf.1 (Z₁.basicOpen_le (s J b) hb)
    have hz'' := TopologicalSpace.Opens.mem_inf.1 hz
    have h1 := congrArg Z₁.basicOpen (hs J b a)
    simp only [Scheme.basicOpen_mul, Scheme.basicOpen_res] at h1
    rw [Scheme.basicOpen_of_isUnit Z₁ ((L.g b a).isUnit.pow m)] at h1
    have hmem : z ∈ (L.V b ⊓ L.V a ⊓ u₁ ⁻¹ᵁ ⊤) ⊓ Z₁.basicOpen (s J a) := by
      rw [h1]
      simp only [TopologicalSpace.Opens.mem_inf]
      exact ⟨⟨⟨⟨hb'.1, hz''.1⟩, hz''.2⟩, ⟨hb'.1, hz''.1⟩⟩, ⟨⟨hb'.1, hz''.1⟩, hz''.2⟩, hb⟩
    exact TopologicalSpace.Opens.mem_iSup.2
      ⟨⟨s J a, J, rfl⟩, (TopologicalSpace.Opens.mem_inf.1 hmem).2⟩
  choose ê hê using fun J => (F 1 le_rfl (s J) (by rw [mul_one]; exact hs J)).exists
  have hêirr : ∀ J, ê J ∈ (HomogeneousIdeal.irrelevant 𝒜).toIdeal := by
    intro J
    rw [HomogeneousIdeal.mem_iff, HomogeneousIdeal.mem_irrelevant_iff, GradedRing.proj_apply,
      DirectSum.decompose_of_mem_ne 𝒜 (hê J).1 one_ne_zero]
  have O8 : ∀ a : Fin L.m, Ideal.map
      ((Pi.evalRingHom (fun a : Fin L.m => Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) a).comp ev₀)
      (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤ := by
    intro a
    rw [eq_top_iff, ← hspan a, Ideal.span_le]
    rintro _ ⟨J, rfl⟩
    have e : ((Pi.evalRingHom (fun a : Fin L.m => Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) a).comp ev₀) (ê J) =
        s J a := by
      show ev₀ (ê J) a = s J a
      rw [(hê J).2]
    show s J a ∈ _
    rw [← e]
    exact Ideal.mem_map_of_mem _ (hêirr J)
  let evf : ∀ a : Fin L.m, S →+* Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤) := fun a =>
    (Pi.evalRingHom (fun a : Fin L.m => Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) a).comp ev₀
  let D : wcpaLccSRD W u₁ L := @wcpaLccSRD.mk Ω _ W Z₁ u₁ L S iS 𝒜 iG ρ₀ evf
  refine ⟨D, ?_⟩
  unfold wcpaLccSRDOK
  exact ⟨P1, fun a w => congrFun (P2 w) a, fun k hk r hr => compat_of k r hr,
    fun k hk x hx => by
      obtain ⟨r, ⟨hr, he⟩, hu⟩ := F k hk x hx
      exact ⟨r, ⟨hr, fun a => congrFun he a⟩, fun r' hr' => hu r' ⟨hr'.1, funext hr'.2⟩⟩,
    O5, ⟨∑ i, Nf i, dg, xg, fun J => ⟨by simp [dg], (hβ _ _).1⟩, hirr⟩, O7, O8⟩

theorem wcpa_dj_lcc_fp_chart_morphism (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (r : ℕ)
    (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)) (L : wcpaDjCoc Z₁)
    (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) (m : ℕ)
    (hSH : wcpaLccSH W u₁ ε L t m) (D : wcpaLccSRD W u₁ L) (hD : wcpaLccSRDOK D m) :
    letI := D.cr; letI := D.gr; ∃ φ : Z₁ ⟶ Proj D.𝒜, wcpaLccChart D φ :=
by

  have thin : ∀ (X : Scheme.{u}) {U V W : X.Opens} (i : Opposite.op U ⟶ Opposite.op V)
      (j : Opposite.op V ⟶ Opposite.op W) (y : Γ(X, U)),
      (X.presheaf.map j).hom ((X.presheaf.map i).hom y) =
        (X.presheaf.map (homOfLE (i ≫ j).unop.le).op).hom y := by
    intro X U V W i j y
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have bo_eq : ∀ (X : Scheme.{u}) {U V : X.Opens} (i : Opposite.op U ⟶ Opposite.op V),
      V = U → ∀ (s : Γ(X, U)), X.basicOpen ((X.presheaf.map i).hom s) = X.basicOpen s := by
    intro X U V i hVU s
    subst hVU
    rw [Subsingleton.elim i (𝟙 _)]
    simp
  have aux_unit : ∀ {R : Type u} [CommRing R] (n : ℕ) (a b x : R), a * b = 1 →
      x = a ^ n * (b ^ n * x) := by
    intro R _ n a b x h
    rw [← mul_assoc, ← mul_pow, h, one_pow, one_mul]

  have hs1 : ∀ (S : Type u) [CommRing S] (𝒜 : ℕ → AddSubgroup S) [GradedRing 𝒜] (Y : Scheme.{u})
      (f : S →+* Γ(Y, ⊤)) (hf : Ideal.map f (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤)
      (k : ℕ) (r : S) (hr : r ∈ 𝒜 k), 1 ≤ k → ∀ (j : ℕ) (β : S) (hβ : β ∈ 𝒜 (j • k))
      (V : Y.Opens) (h : V ≤ Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 r),
      ((Proj.fromOfGlobalSections 𝒜 f hf).appLE (Proj.basicOpen 𝒜 r) V h).hom
          ((Proj.awayToSection 𝒜 r).hom (HomogeneousLocalization.Away.mk 𝒜 hr j β hβ)) *
        (Y.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom (f r) ^ j =
      (Y.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom (f β) := by
    intro S _ 𝒜 _ Y f hf k r hr hk1 j β hβ V h
    have hk : 0 < k := hk1
    have hpre : Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 r = Y.basicOpen (f r) :=
      Proj.fromOfGlobalSections_preimage_basicOpen 𝒜 f hf hk hr
    have h' : Y.basicOpen (f r) ≤ Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 r :=
      hpre.ge
    have hVW : V ≤ Y.basicOpen (f r) := h.trans hpre.le
    have hT : (Proj.fromOfGlobalSections 𝒜 f hf).resLE (Proj.basicOpen 𝒜 r)
        (Y.basicOpen (f r)) h' = Proj.toBasicOpenOfGlobalSections 𝒜 f rfl hk hr :=
      Proj.fromOfGlobalSections_resLE 𝒜 f hf hk hr
    obtain ⟨E, ψ, hE1, hE2, hψ⟩ : ∃ (E : (Y.basicOpen (f r)).toScheme ⟶
          Spec (.of (Localization.Away (f r))))
        (ψ : Localization.Away r →+* Localization.Away (f r)),
        Proj.toBasicOpenOfGlobalSections 𝒜 f rfl hk hr ≫ Proj.basicOpenToSpec 𝒜 r =
          E ≫ Spec.map (CommRingCat.ofHom (ψ.comp
            (algebraMap (HomogeneousLocalization.Away 𝒜 r) (Localization.Away r)))) ∧
        E ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(Y, ⊤) (Localization.Away (f r)))) =
          (Y.basicOpen (f r)).ι ≫ Y.toSpecΓ ∧
        ψ.comp (algebraMap S (Localization.Away r)) =
          (algebraMap Γ(Y, ⊤) (Localization.Away (f r))).comp f := by
      have hy : Submonoid.powers r ≤ Submonoid.comap f (Submonoid.powers (f r)) :=
        Submonoid.powers_le.mpr (Submonoid.mem_powers (f r))
      refine ⟨(Y.isoOfEq (Y.toSpecΓ_preimage_basicOpen (f r))).inv ≫
          Y.toSpecΓ ∣_ PrimeSpectrum.basicOpen (f r) ≫ (basicOpenIsoSpecAway (f r)).hom,
        IsLocalization.map (Localization.Away (f r)) f hy, ?_, ?_, ?_⟩
      · rw [← Proj.basicOpenIsoSpec_hom 𝒜 r hr hk, Proj.toBasicOpenOfGlobalSections]
        simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
      · have h1 := morphismRestrict_ι Y.toSpecΓ (PrimeSpectrum.basicOpen (f r))
        have h2 := Scheme.isoOfEq_inv_ι Y (Y.toSpecΓ_preimage_basicOpen (f r))
        rw [Category.assoc, Category.assoc, basicOpenIsoSpecAway_hom_SpecMap, h1,
          ← Category.assoc, h2]
      · exact IsLocalization.map_comp hy
    let κ : Localization.Away (f r) →+* Γ((Y.basicOpen (f r)).toScheme, ⊤) :=
      ((Scheme.ΓSpecIso (.of (Localization.Away (f r)))).inv ≫ E.appTop).hom
    have H1m : Proj.awayToSection 𝒜 r ≫
        (Proj.fromOfGlobalSections 𝒜 f hf).appLE (Proj.basicOpen 𝒜 r) (Y.basicOpen (f r)) h' ≫
        (Y.basicOpen (f r)).topIso.inv =
        CommRingCat.ofHom (ψ.comp (algebraMap (HomogeneousLocalization.Away 𝒜 r)
          (Localization.Away r))) ≫ CommRingCat.ofHom κ := by
      have e := congrArg Scheme.Hom.appTop hE1
      simp only [Scheme.Hom.comp_appTop] at e
      rw [← hT] at e
      dsimp only [Scheme.Hom.appTop] at e
      rw [Proj.basicOpenToSpec_app_top, Scheme.Hom.resLE_app_top] at e
      have e2 := congrArg
        (fun g => (Scheme.ΓSpecIso (.of (HomogeneousLocalization.Away 𝒜 r))).inv ≫ g) e
      simp only [Category.assoc, Iso.inv_hom_id_assoc] at e2
      rw [e2]
      simp only [κ, CommRingCat.ofHom_hom]
      have hn := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (ψ.comp
        (algebraMap (HomogeneousLocalization.Away 𝒜 r) (Localization.Away r))))
      dsimp only [Scheme.Hom.appTop] at hn ⊢
      exact ((reassoc_of% hn) (Scheme.Hom.app E ⊤)).symm
    have H2m : CommRingCat.ofHom (algebraMap Γ(Y, ⊤) (Localization.Away (f r))) ≫
        CommRingCat.ofHom κ = (Y.basicOpen (f r)).ι.appTop := by
      have e := congrArg Scheme.Hom.appTop hE2
      simp only [Scheme.Hom.comp_appTop] at e
      have e2 := congrArg (fun g => (Scheme.ΓSpecIso Γ(Y, ⊤)).inv ≫ g) e
      rw [Scheme.toSpecΓ_appTop, Iso.inv_hom_id_assoc] at e2
      rw [← e2]
      simp only [κ, CommRingCat.ofHom_hom]
      rw [← Category.assoc, Scheme.ΓSpecIso_inv_naturality, Category.assoc]
      rfl
    set x := HomogeneousLocalization.Away.mk 𝒜 hr j β hβ with hx
    have H1 := congrArg (fun g => g.hom x) H1m
    have H2 : ∀ a : Γ(Y, ⊤), κ (algebraMap Γ(Y, ⊤) (Localization.Away (f r)) a) =
        (Y.basicOpen (f r)).ι.appTop.hom a := fun a => congrArg (fun g => g.hom a) H2m
    simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply] at H1
    have H3 : ψ (algebraMap (HomogeneousLocalization.Away 𝒜 r) (Localization.Away r) x) *
        algebraMap Γ(Y, ⊤) (Localization.Away (f r)) (f r) ^ j =
        algebraMap Γ(Y, ⊤) (Localization.Away (f r)) (f β) := by
      have e1 : algebraMap (HomogeneousLocalization.Away 𝒜 r) (Localization.Away r) x *
          algebraMap S (Localization.Away r) (r ^ j) = algebraMap S (Localization.Away r) β := by
        rw [HomogeneousLocalization.algebraMap_apply, hx, HomogeneousLocalization.Away.val_mk,
          Localization.mk_eq_mk']
        exact IsLocalization.mk'_spec _ _ _
      have e2 := congrArg ψ e1
      rw [map_mul] at e2
      have e3 : ∀ s : S, ψ (algebraMap S (Localization.Away r) s) =
          algebraMap Γ(Y, ⊤) (Localization.Away (f r)) (f s) := fun s =>
        congrArg (fun g : S →+* Localization.Away (f r) => g s) hψ
      rw [e3, e3, map_pow, map_pow] at e2
      exact e2
    have H4 : (Y.basicOpen (f r)).topIso.inv.hom
        (((Proj.fromOfGlobalSections 𝒜 f hf).appLE (Proj.basicOpen 𝒜 r)
          (Y.basicOpen (f r)) h').hom ((Proj.awayToSection 𝒜 r).hom x)) *
        ((Y.basicOpen (f r)).ι.appTop.hom (f r)) ^ j =
        (Y.basicOpen (f r)).ι.appTop.hom (f β) := by
      rw [H1, ← H2, ← H2, ← map_pow, ← map_mul, H3]
    have hle : V ≤ (Y.basicOpen (f r)).ι ''ᵁ ⊤ := by
      rw [Scheme.Opens.ι_image_top]; exact hVW
    let g : Γ((Y.basicOpen (f r)).toScheme, ⊤) ⟶ Γ(Y, V) := Y.presheaf.map (homOfLE hle).op
    have H5 := congrArg g.hom H4
    rw [map_mul, map_pow] at H5
    simp only [g, Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv] at H5
    repeat erw [thin Y] at H5
    rw [← Scheme.Hom.appLE_map _ h' (homOfLE hVW).op, CommRingCat.comp_apply]
    repeat erw [thin Y]
    exact H5

  have hs2 : ∀ (S : Type u) [CommRing S] (𝒜 : ℕ → AddSubgroup S) [GradedRing 𝒜]
      (X : Scheme.{u}) (V : X.Opens) (g₁ g₂ : X ⟶ Proj 𝒜) (k : ℕ) (r : S), r ∈ 𝒜 k → 0 < k →
      ∀ (h₁ : V ≤ g₁ ⁻¹ᵁ Proj.basicOpen 𝒜 r) (h₂ : V ≤ g₂ ⁻¹ᵁ Proj.basicOpen 𝒜 r),
      (∀ x : HomogeneousLocalization.Away 𝒜 r,
        (g₁.appLE (Proj.basicOpen 𝒜 r) V h₁).hom ((Proj.awayToSection 𝒜 r).hom x) =
        (g₂.appLE (Proj.basicOpen 𝒜 r) V h₂).hom ((Proj.awayToSection 𝒜 r).hom x)) →
      V.ι ≫ g₁ = V.ι ≫ g₂ := by
    intro S _ 𝒜 _ X V g₁ g₂ k r hr hk h₁ h₂ H
    rw [← Scheme.Hom.resLE_comp_ι g₁ h₁, ← Scheme.Hom.resLE_comp_ι g₂ h₂]
    congr 1
    rw [← cancel_mono (Proj.basicOpenIsoSpec 𝒜 r hr hk).hom, Proj.basicOpenIsoSpec_hom]
    apply ext_to_Spec
    simp only [Scheme.Γ_map_op, Scheme.Hom.comp_appTop]
    dsimp only [Scheme.Hom.appTop]
    rw [Proj.basicOpenToSpec_app_top, Scheme.Hom.resLE_app_top, Scheme.Hom.resLE_app_top]
    simp only [Category.assoc, Iso.inv_hom_id_assoc]
    congr 1
    ext x
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    rw [H]

  have hs3 : ∀ (S : Type u) [CommRing S] (𝒜 : ℕ → AddSubgroup S) [GradedRing 𝒜]
      {X X' : Scheme.{u}} (g : X' ⟶ X) (f : S →+* Γ(X, ⊤)) (f' : S →+* Γ(X', ⊤))
      (hf : Ideal.map f (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤)
      (hf' : Ideal.map f' (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤) (u : Γ(X', ⊤)) (e : ℕ),
      IsUnit u → (∀ k : ℕ, 1 ≤ k → ∀ r ∈ 𝒜 k, f' r = u ^ (e * k) * g.appTop.hom (f r)) →
      g ≫ Proj.fromOfGlobalSections 𝒜 f hf = Proj.fromOfGlobalSections 𝒜 f' hf' := by
    intro S _ 𝒜 _ X X' g f f' hf hf' u e hu htw
    apply (Proj.openCoverOfMapIrrelevantEqTop 𝒜 f' hf').hom_ext
    rintro ⟨k, r, hk, hr⟩
    change (X'.basicOpen (f' r)).ι ≫ g ≫ Proj.fromOfGlobalSections 𝒜 f hf =
      (X'.basicOpen (f' r)).ι ≫ Proj.fromOfGlobalSections 𝒜 f' hf'
    have hk1 : 1 ≤ k := hk
    have hpreX : Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 r = X.basicOpen (f r) :=
      Proj.fromOfGlobalSections_preimage_basicOpen 𝒜 f hf hk hr
    have hpreX' : Proj.fromOfGlobalSections 𝒜 f' hf' ⁻¹ᵁ Proj.basicOpen 𝒜 r =
        X'.basicOpen (f' r) :=
      Proj.fromOfGlobalSections_preimage_basicOpen 𝒜 f' hf' hk hr
    have hV : X'.basicOpen (f' r) = X'.basicOpen (g.appTop.hom (f r)) := by
      rw [htw k hk1 r hr, Scheme.basicOpen_mul, Scheme.basicOpen_of_isUnit _ (hu.pow _),
        top_inf_eq]
    have hgW : g ⁻¹ᵁ X.basicOpen (f r) = X'.basicOpen (g.appTop.hom (f r)) :=
      Scheme.preimage_basicOpen g (f r)
    have e₂ : X'.basicOpen (f' r) ≤ g ⁻¹ᵁ X.basicOpen (f r) := by rw [hgW, hV]
    have e₁ : X.basicOpen (f r) ≤ Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 r :=
      hpreX.ge
    have h₁ : X'.basicOpen (f' r) ≤
        (g ≫ Proj.fromOfGlobalSections 𝒜 f hf) ⁻¹ᵁ Proj.basicOpen 𝒜 r := by
      rw [Scheme.Hom.comp_preimage, hpreX]; exact e₂
    have h₂ : X'.basicOpen (f' r) ≤ Proj.fromOfGlobalSections 𝒜 f' hf' ⁻¹ᵁ Proj.basicOpen 𝒜 r :=
      hpreX'.ge
    refine hs2 S 𝒜 X' (X'.basicOpen (f' r)) _ _ k r hr hk h₁ h₂ ?_
    intro x
    obtain ⟨j, β, hβ, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hr x
    have hβ' : β * r ∈ 𝒜 ((j + 1) • k) := by
      rw [succ_nsmul]; exact SetLike.mul_mem_graded hβ hr
    have hmk : HomogeneousLocalization.Away.mk 𝒜 hr j β hβ =
        HomogeneousLocalization.Away.mk 𝒜 hr (j + 1) (β * r) hβ' := by
      rw [HomogeneousLocalization.ext_iff_val, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
      exact ⟨1, by simp only [OneMemClass.coe_one, one_mul]; ring⟩
    rw [hmk]
    set j' := j + 1 with hj'
    set β' := β * r with hβ'def
    set V := X'.basicOpen (f' r) with hVdef
    set ρ := (X'.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom with hρ
    have H2 := hs1 S 𝒜 X' f' hf' k r hr hk1 j' β' hβ' V h₂
    have hcomp := Scheme.Hom.appLE_comp_appLE g (Proj.fromOfGlobalSections 𝒜 f hf)
      (Proj.basicOpen 𝒜 r) (X.basicOpen (f r)) V e₁ e₂
    have H1X := hs1 S 𝒜 X f hf k r hr hk1 j' β' hβ' (X.basicOpen (f r)) e₁
    have hres : ∀ s : Γ(X, ⊤), (g.appLE (X.basicOpen (f r)) V e₂).hom
        ((X.presheaf.map (homOfLE (le_top : X.basicOpen (f r) ≤ ⊤)).op).hom s) =
        ρ (g.appTop.hom s) := by
      intro s
      rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
      simp only [Scheme.Hom.appLE, CommRingCat.comp_apply, hρ]
      rfl
    have H1 := congrArg (g.appLE (X.basicOpen (f r)) V e₂).hom H1X
    rw [map_mul, map_pow, hres, hres, ← CommRingCat.comp_apply, hcomp] at H1
    have hfr : ρ (f' r) = ρ u ^ (e * k) * ρ (g.appTop.hom (f r)) := by
      rw [htw k hk1 r hr, map_mul, map_pow]
    have hjk : 1 ≤ j' • k := by rw [smul_eq_mul]; nlinarith
    have hfβ : ρ (f' β') = ρ u ^ (e * (j' • k)) * ρ (g.appTop.hom (f β')) := by
      rw [htw (j' • k) hjk β' hβ', map_mul, map_pow]
    have hunit_fr : IsUnit (ρ (f' r)) := RingedSpace.isUnit_res_basicOpen _ (f' r)
    have hunit_u : IsUnit (ρ u) := hu.map ρ
    have hunit_a : IsUnit (ρ (g.appTop.hom (f r))) := by
      rw [hfr] at hunit_fr; exact isUnit_of_mul_isUnit_right hunit_fr
    rw [hfr, hfβ, mul_pow, ← pow_mul] at H2
    rw [← (hunit_a.pow j').mul_left_inj]
    rw [H1]
    rw [← (hunit_u.pow (e * (j' • k))).mul_left_inj]
    have hexp : e * k * j' = e * (j' • k) := by rw [smul_eq_mul]; ring
    rw [hexp] at H2
    linear_combination -H2

  have hs4 : ∀ (X : Scheme.{u}) (P Q O : X.Opens) (c : (Γ(X, P ⊓ Q))ˣ) (n : ℕ)
      (xP : Γ(X, P ⊓ O)) (xQ : Γ(X, Q ⊓ O)),
      (X.presheaf.map (homOfLE (show P ⊓ Q ⊓ O ≤ Q ⊓ O from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom xQ =
        (X.presheaf.map (homOfLE (show P ⊓ Q ⊓ O ≤ P ⊓ Q from inf_le_left)).op).hom
          ((c : Γ(X, P ⊓ Q)) ^ n) *
        (X.presheaf.map (homOfLE (show P ⊓ Q ⊓ O ≤ P ⊓ O from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom xP →
      (X.homOfLE (inf_le_left : (P ⊓ O) ⊓ (Q ⊓ O) ≤ P ⊓ O)).appTop.hom
          ((P ⊓ O).topIso.inv.hom xP) =
        (((P ⊓ O) ⊓ (Q ⊓ O)).topIso.inv.hom
          ((X.presheaf.map (homOfLE (show (P ⊓ O) ⊓ (Q ⊓ O) ≤ P ⊓ Q from
            le_inf (inf_le_left.trans inf_le_left) (inf_le_right.trans inf_le_left))).op).hom
            ((c⁻¹ : (Γ(X, P ⊓ Q))ˣ) : Γ(X, P ⊓ Q)))) ^ n *
        (X.homOfLE (inf_le_right : (P ⊓ O) ⊓ (Q ⊓ O) ≤ Q ⊓ O)).appTop.hom
          ((Q ⊓ O).topIso.inv.hom xQ) := by
    intro X P Q O c n xP xQ h
    have hN : (P ⊓ O) ⊓ (Q ⊓ O) ≤ P ⊓ Q ⊓ O :=
      le_inf (le_inf (inf_le_left.trans inf_le_left) (inf_le_right.trans inf_le_left))
        (inf_le_left.trans inf_le_right)
    have hT : ((P ⊓ O) ⊓ (Q ⊓ O)).ι ''ᵁ ⊤ ≤ P ⊓ Q ⊓ O := by
      rw [Scheme.Opens.ι_image_top]; exact hN
    have key := congrArg (X.presheaf.map (homOfLE hT).op).hom h
    simp only [map_mul, map_pow, thin] at key
    simp only [Scheme.homOfLE_appTop, Scheme.Opens.topIso_inv]
    erw [thin X, thin X, thin X]
    erw [key]
    have hab : ∀ (g : Γ(X, P ⊓ Q) ⟶ Γ(X, ((P ⊓ O) ⊓ (Q ⊓ O)).ι ''ᵁ ⊤)),
        g.hom ((c⁻¹ : (Γ(X, P ⊓ Q))ˣ) : Γ(X, P ⊓ Q)) * g.hom (c : Γ(X, P ⊓ Q)) = 1 := by
      intro g
      rw [← map_mul, ← Units.val_mul, inv_mul_cancel, Units.val_one, map_one]
    exact aux_unit n _ _ _ (hab _)

  have hs5 : ∀ (S : Type u) [CommRing S] (𝒜 : ℕ → AddSubgroup S) [GradedRing 𝒜]
      (R : Type u) [CommRing R]
      (ρ₀ : R →+* ↥(𝒜 0)) (X : Scheme.{u}) (q : X ⟶ Spec (.of R)) (U : X.Opens)
      (hU : U ≤ q ⁻¹ᵁ ⊤) (f : S →+* Γ(X, U))
      (hf : Ideal.map (U.topIso.inv.hom.comp f) (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤),
      (∀ w : R, f ((ρ₀ w : ↥(𝒜 0)) : S) =
        (q.appLE ⊤ U hU).hom ((Scheme.ΓSpecIso (.of R)).inv.hom w)) →
      U.ι ≫ q = Proj.fromOfGlobalSections 𝒜 (U.topIso.inv.hom.comp f) hf ≫ Proj.toSpecZero 𝒜 ≫
        Spec.map (CommRingCat.ofHom ρ₀) := by
    intro S _ 𝒜 _ R _ ρ₀ X q U hU f hf hw
    rw [Proj.fromOfGlobalSections_toSpecZero_assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
    apply ext_to_Spec
    simp only [Scheme.Γ_map_op, Scheme.Hom.comp_appTop]
    rw [Scheme.toSpecΓ_appTop, Scheme.ΓSpecIso_naturality]
    erw [Iso.inv_hom_id_assoc]
    ext w
    show (U.ι.appTop).hom ((q.appTop).hom ((Scheme.ΓSpecIso (.of R)).inv.hom w)) =
      U.topIso.inv.hom (f ((ρ₀ w : ↥(𝒜 0)) : S))
    rw [hw]
    simp only [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv, Scheme.Hom.appLE]
    first
    | rfl
    | (erw [thin X]; rfl)

  have hs6 : ∀ (X Y : Scheme.{u}) (n : ℕ) (V : Fin n → X.Opens), (⨆ l, V l) = ⊤ →
      (∀ (Z : Scheme.{u}) (φ₁ φ₂ : X ⟶ Z), (∀ l, (V l).ι ≫ φ₁ = (V l).ι ≫ φ₂) → φ₁ = φ₂) ∧
      ∀ g : ∀ l, (V l).toScheme ⟶ Y,
        (∀ l l', X.homOfLE (inf_le_left : V l ⊓ V l' ≤ V l) ≫ g l =
          X.homOfLE (inf_le_right : V l ⊓ V l' ≤ V l') ≫ g l') →
        ∃ φ : X ⟶ Y, ∀ l, (V l).ι ≫ φ = g l := by
    intro X Y n V hV
    have hc : TopologicalSpace.IsOpenCover V := hV
    refine ⟨fun Z φ₁ φ₂ h => ?_, fun g hg => ?_⟩
    · exact (X.openCoverOfIsOpenCover V hc).hom_ext _ _ (fun l => h l)
    · have H : ∀ (l l' : (X.openCoverOfIsOpenCover V hc).I₀),
          Limits.pullback.fst ((X.openCoverOfIsOpenCover V hc).f l)
            ((X.openCoverOfIsOpenCover V hc).f l') ≫ g l =
          Limits.pullback.snd ((X.openCoverOfIsOpenCover V hc).f l)
            ((X.openCoverOfIsOpenCover V hc).f l') ≫ g l' := by
        intro l l'
        have hp := isPullback_opens_inf (V l) (V l')
        change Limits.pullback.fst (V l).ι (V l').ι ≫ g l =
          Limits.pullback.snd (V l).ι (V l').ι ≫ g l'
        rw [← hp.isoPullback_inv_fst, ← hp.isoPullback_inv_snd, Category.assoc, Category.assoc,
          hg l l']
      exact ⟨(X.openCoverOfIsOpenCover V hc).glueMorphisms g H,
        fun l => (X.openCoverOfIsOpenCover V hc).ι_glueMorphisms g H l⟩

  have hs7 : ∀ (S : Type u) [CommRing S] (𝒜 : ℕ → AddSubgroup S) [GradedRing 𝒜]
      (X : Scheme.{u}) (n : ℕ) (V : Fin n → X.Opens) (f : ∀ l, S →+* Γ(X, V l))
      (hf : ∀ l, Ideal.map ((V l).topIso.inv.hom.comp (f l))
        (HomogeneousIdeal.irrelevant 𝒜).toIdeal = ⊤)
      (φ : X ⟶ Proj 𝒜), (⨆ l, V l) = ⊤ →
      (∀ l, (V l).ι ≫ φ = Proj.fromOfGlobalSections 𝒜 ((V l).topIso.inv.hom.comp (f l)) (hf l)) →
      (∀ (l : Fin n) (k : ℕ) (r : S) (hr : r ∈ 𝒜 k), 1 ≤ k → ∀ (j : ℕ) (β : S)
        (hβ : β ∈ 𝒜 (j • k)) (W : (V l).toScheme.Opens)
        (h : W ≤ Proj.fromOfGlobalSections 𝒜 ((V l).topIso.inv.hom.comp (f l)) (hf l) ⁻¹ᵁ
          Proj.basicOpen 𝒜 r),
        ((Proj.fromOfGlobalSections 𝒜 ((V l).topIso.inv.hom.comp (f l)) (hf l)).appLE
            (Proj.basicOpen 𝒜 r) W h).hom
            ((Proj.awayToSection 𝒜 r).hom (HomogeneousLocalization.Away.mk 𝒜 hr j β hβ)) *
          ((V l).toScheme.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom
            ((V l).topIso.inv.hom (f l r)) ^ j =
        ((V l).toScheme.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom
            ((V l).topIso.inv.hom (f l β))) →
      (∀ k : ℕ, 1 ≤ k → ∀ r ∈ 𝒜 k, φ ⁻¹ᵁ Proj.basicOpen 𝒜 r = ⨆ l, X.basicOpen (f l r)) ∧
      (∀ (k : ℕ) (r : S) (hr : r ∈ 𝒜 k), 1 ≤ k → ∀ (j : ℕ) (β : S) (hβ : β ∈ 𝒜 (j • k))
        (l : Fin n) (h : X.basicOpen (f l r) ≤ φ ⁻¹ᵁ Proj.basicOpen 𝒜 r),
        (φ.appLE (Proj.basicOpen 𝒜 r) (X.basicOpen (f l r)) h).hom
            ((Proj.awayToSection 𝒜 r).hom (HomogeneousLocalization.Away.mk 𝒜 hr j β hβ)) *
          (X.presheaf.map (homOfLE (X.basicOpen_le (f l r))).op).hom (f l r) ^ j =
        (X.presheaf.map (homOfLE (X.basicOpen_le (f l r))).op).hom (f l β)) := by
    intro S _ 𝒜 _ X n V f hf φ hcov hφ hch
    have hbo : ∀ l (s : Γ(X, V l)), X.basicOpen ((V l).topIso.inv.hom s) = X.basicOpen s := by
      intro l s
      rw [Scheme.Opens.topIso_inv]
      exact bo_eq X _ (Scheme.Opens.ι_image_top (V l)) s
    have hW : ∀ l (s : Γ(X, V l)),
        (V l).ι ''ᵁ (V l).toScheme.basicOpen ((V l).topIso.inv.hom s) = X.basicOpen s := by
      intro l s
      rw [Scheme.Opens.ι_image_basicOpen, hbo]
    have key : ∀ l (k : ℕ), 1 ≤ k → ∀ r ∈ 𝒜 k,
        V l ⊓ φ ⁻¹ᵁ Proj.basicOpen 𝒜 r = X.basicOpen (f l r) := by
      intro l k hk r hr
      have e1 := Scheme.Hom.image_preimage_eq_opensRange_inf (V l).ι (φ ⁻¹ᵁ Proj.basicOpen 𝒜 r)
      rw [Scheme.Opens.opensRange_ι] at e1
      rw [← e1, ← Scheme.Hom.comp_preimage, hφ l,
        Proj.fromOfGlobalSections_preimage_basicOpen 𝒜 _ (hf l) hk hr]
      exact hW l (f l r)
    refine ⟨?_, ?_⟩
    · intro k hk r hr
      calc φ ⁻¹ᵁ Proj.basicOpen 𝒜 r = φ ⁻¹ᵁ Proj.basicOpen 𝒜 r ⊓ ⨆ l, V l := by
            rw [hcov, inf_top_eq]
        _ = ⨆ l, φ ⁻¹ᵁ Proj.basicOpen 𝒜 r ⊓ V l := inf_iSup_eq _ _
        _ = ⨆ l, X.basicOpen (f l r) := by
          congr 1; ext1 l; rw [inf_comm, key l k hk r hr]
    · intro k r hr hk j β hβ l h
      set φl := Proj.fromOfGlobalSections 𝒜 ((V l).topIso.inv.hom.comp (f l)) (hf l) with hφl
      set Wl := (V l).toScheme.basicOpen ((V l).topIso.inv.hom (f l r)) with hWdef
      set Dl := X.basicOpen (f l r) with hDl
      have hpre : φl ⁻¹ᵁ Proj.basicOpen 𝒜 r = Wl :=
        Proj.fromOfGlobalSections_preimage_basicOpen 𝒜 _ (hf l) hk hr
      have h' : Wl ≤ φl ⁻¹ᵁ Proj.basicOpen 𝒜 r := hpre.ge
      have hWD : (V l).ι ''ᵁ Wl = Dl := hW l (f l r)
      have e : Wl ≤ (V l).ι ⁻¹ᵁ Dl := by
        rw [← hWD, Scheme.Hom.preimage_image_eq]
      have hcomp := Scheme.Hom.appLE_comp_appLE (V l).ι φ (Proj.basicOpen 𝒜 r) Dl Wl h e
      have happ : ∀ (a b : (V l).toScheme ⟶ Proj 𝒜) (hab : a = b)
          (ea : Wl ≤ a ⁻¹ᵁ Proj.basicOpen 𝒜 r) (eb : Wl ≤ b ⁻¹ᵁ Proj.basicOpen 𝒜 r),
          a.appLE (Proj.basicOpen 𝒜 r) Wl ea = b.appLE (Proj.basicOpen 𝒜 r) Wl eb := by
        intro a b hab ea eb; subst hab; rfl
      rw [happ _ _ (hφ l) _ h'] at hcomp
      have H := hch l k r hr hk j β hβ Wl h'
      rw [← hcomp, CommRingCat.comp_apply, Scheme.Opens.ι_appLE] at H
      simp only [Scheme.Opens.toScheme_presheaf_map, Scheme.Opens.topIso_inv] at H
      have hle1 : (V l).ι ''ᵁ Wl ≤ Dl := hWD.le
      have hle2 : Dl ≤ (V l).ι ''ᵁ Wl := hWD.ge
      have inj : ∀ a b : Γ(X, Dl), (X.presheaf.map (homOfLE hle1).op).hom a =
          (X.presheaf.map (homOfLE hle1).op).hom b → a = b := by
        intro a b hab
        have := congrArg (X.presheaf.map (homOfLE hle2).op).hom hab
        rw [thin, thin] at this
        rw [Subsingleton.elim (homOfLE _) (𝟙 Dl)] at this
        simpa using this
      apply inj
      rw [map_mul, map_pow]
      repeat erw [thin X] at H
      repeat erw [thin X]
      exact H

  unfold wcpaLccChart
  letI : CommRing D.S := D.cr
  letI : GradedRing D.𝒜 := D.gr
  obtain ⟨_hO1, hO2, hO3, _hO4, _hO5, _hO6, _hO7, hO8⟩ := hD
  have hcov : (⨆ a, (L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) = ⊤ := by
    simp only [Scheme.Hom.preimage_top, inf_top_eq]
    exact hSH.2.2.1.2.1
  have hf : ∀ a, Ideal.map ((L.V a ⊓ u₁ ⁻¹ᵁ ⊤).topIso.inv.hom.comp (D.ev a))
      (HomogeneousIdeal.irrelevant D.𝒜).toIdeal = ⊤ := by
    intro a
    rw [← Ideal.map_map, hO8 a, Ideal.map_top]
  have hover : ∀ a b, Z₁.homOfLE (inf_le_left : (L.V a ⊓ u₁ ⁻¹ᵁ ⊤) ⊓ (L.V b ⊓ u₁ ⁻¹ᵁ ⊤) ≤
        L.V a ⊓ u₁ ⁻¹ᵁ ⊤) ≫
        Proj.fromOfGlobalSections D.𝒜 ((L.V a ⊓ u₁ ⁻¹ᵁ ⊤).topIso.inv.hom.comp (D.ev a)) (hf a) =
      Z₁.homOfLE (inf_le_right : (L.V a ⊓ u₁ ⁻¹ᵁ ⊤) ⊓ (L.V b ⊓ u₁ ⁻¹ᵁ ⊤) ≤
        L.V b ⊓ u₁ ⁻¹ᵁ ⊤) ≫
        Proj.fromOfGlobalSections D.𝒜 ((L.V b ⊓ u₁ ⁻¹ᵁ ⊤).topIso.inv.hom.comp (D.ev b)) (hf b) := by
    intro a b
    have hFl : Ideal.map ((Z₁.homOfLE (inf_le_left : (L.V a ⊓ u₁ ⁻¹ᵁ ⊤) ⊓ (L.V b ⊓ u₁ ⁻¹ᵁ ⊤) ≤
        L.V a ⊓ u₁ ⁻¹ᵁ ⊤)).appTop.hom.comp
          ((L.V a ⊓ u₁ ⁻¹ᵁ ⊤).topIso.inv.hom.comp (D.ev a)))
        (HomogeneousIdeal.irrelevant D.𝒜).toIdeal = ⊤ := by
      rw [← Ideal.map_map, hf a, Ideal.map_top]
    have huab : IsUnit ((((L.V a ⊓ u₁ ⁻¹ᵁ ⊤) ⊓ (L.V b ⊓ u₁ ⁻¹ᵁ ⊤)).topIso.inv.hom
        ((Z₁.presheaf.map (homOfLE (show (L.V a ⊓ u₁ ⁻¹ᵁ ⊤) ⊓ (L.V b ⊓ u₁ ⁻¹ᵁ ⊤) ≤
          L.V a ⊓ L.V b from
          le_inf (inf_le_left.trans inf_le_left) (inf_le_right.trans inf_le_left))).op).hom
          (((L.g a b)⁻¹ : (Γ(Z₁, L.V a ⊓ L.V b))ˣ) : Γ(Z₁, L.V a ⊓ L.V b))))) := by
      apply IsUnit.map
      apply IsUnit.map
      exact Units.isUnit _
    have e1 := hs3 D.S D.𝒜 (Z₁.homOfLE (inf_le_left : (L.V a ⊓ u₁ ⁻¹ᵁ ⊤) ⊓ (L.V b ⊓ u₁ ⁻¹ᵁ ⊤) ≤
        L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) _ _ (hf a) hFl 1 0 isUnit_one
      (fun k _ r _ => by rw [one_pow, one_mul]; rfl)
    have e2 := hs3 D.S D.𝒜 (Z₁.homOfLE (inf_le_right : (L.V a ⊓ u₁ ⁻¹ᵁ ⊤) ⊓ (L.V b ⊓ u₁ ⁻¹ᵁ ⊤) ≤
        L.V b ⊓ u₁ ⁻¹ᵁ ⊤)) _ _ (hf b) hFl _ m huab
      (fun k hk r hr => by
        have h3 := hO3 k hk r hr
        unfold wcpaDjCompat at h3
        exact hs4 Z₁ (L.V a) (L.V b) (u₁ ⁻¹ᵁ ⊤) (L.g a b) (m * k) (D.ev a r) (D.ev b r) (h3 a b))
    exact e1.trans e2.symm
  obtain ⟨φ, hφ⟩ : ∃ φ : Z₁ ⟶ Proj D.𝒜, ∀ a, (L.V a ⊓ u₁ ⁻¹ᵁ ⊤).ι ≫ φ =
      Proj.fromOfGlobalSections D.𝒜 ((L.V a ⊓ u₁ ⁻¹ᵁ ⊤).topIso.inv.hom.comp (D.ev a)) (hf a) :=
    (hs6 Z₁ (Proj D.𝒜) L.m (fun a => L.V a ⊓ u₁ ⁻¹ᵁ ⊤) hcov).2 _ hover
  have hC1 : φ ≫ wcpaLccUU D = u₁ := by
    apply (hs6 Z₁ (Spec (.of ↥W)) L.m (fun a => L.V a ⊓ u₁ ⁻¹ᵁ ⊤) hcov).1
    intro a
    rw [← Category.assoc, hφ a]
    exact (hs5 D.S D.𝒜 ↥W D.ρ₀ Z₁ u₁ (L.V a ⊓ u₁ ⁻¹ᵁ ⊤) inf_le_right (D.ev a) (hf a)
      (hO2 a)).symm
  obtain ⟨hC2, hC3⟩ := hs7 D.S D.𝒜 Z₁ L.m (fun a => L.V a ⊓ u₁ ⁻¹ᵁ ⊤) D.ev hf φ hcov hφ
    (fun l k r hr hk j β hβ W' h => hs1 D.S D.𝒜 _ _ (hf l) k r hr hk j β hβ W' h)
  exact ⟨φ, hC1, hC2, hC3⟩

theorem wcpa_dj_lcc_fp_proj_flat_proper : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (S : Type u) [CommRing S] (𝒜 : ℕ → AddSubgroup S) [GradedRing 𝒜] (ρ₀ : ↥W →+* ↥(𝒜 0)),
    Function.Surjective ρ₀ → Algebra.FiniteType ↥(𝒜 0) S →
    (∀ k, 1 ≤ k → ∀ w : ↥W, w ≠ 0 → ∀ y ∈ 𝒜 k, ((ρ₀ w : ↥(𝒜 0)) : S) * y = 0 → y = 0) →
    IsProper (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) ∧
    Flat (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) ∧
    LocallyOfFiniteType (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) :=
by
  intro Ω _ W S _ 𝒜 _ ρ₀ hsurj hFT hNZ

  have s3 : ∀ (f : S) (m : ℕ), f ∈ 𝒜 m → 0 < m → ∀ r : ↥(𝒜 0),
      (∀ k, 1 ≤ k → ∀ y ∈ 𝒜 k, (r : S) * y = 0 → y = 0) →
      ∀ x : HomogeneousLocalization.Away 𝒜 f,
        HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f) r * x = 0 → x = 0 := by
    intro f m hf hm r hr x hx
    obtain ⟨k, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 hf x
    apply HomogeneousLocalization.val_injective
    have h1 := congrArg HomogeneousLocalization.val hx
    have h2 : (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f) r).val =
        Localization.mk (r : S) 1 := rfl
    rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_zero,
      HomogeneousLocalization.Away.val_mk, h2, Localization.mk_mul, Localization.mk_eq_mk',
      IsLocalization.mk'_eq_zero_iff] at h1
    obtain ⟨⟨c, hc⟩, hc0⟩ := h1
    obtain ⟨j, rfl⟩ := hc
    have hy : f ^ (j + 1) * a ∈ 𝒜 ((j + 1) • m + k • m) :=
      SetLike.mul_mem_graded (SetLike.pow_mem_graded (j + 1) hf) ha
    have hdeg : 1 ≤ (j + 1) • m + k • m := by
      simp only [smul_eq_mul]; nlinarith
    have hyz := hr _ hdeg _ hy (by
      calc (r : S) * (f ^ (j + 1) * a) = f * (f ^ j * ((r : S) * a)) := by ring
        _ = 0 := by
          have : f ^ j * ((r : S) * a) = 0 := by simpa using hc0
          rw [this, mul_zero])
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_zero,
      Localization.mk_eq_mk', IsLocalization.mk'_eq_zero_iff]
    exact ⟨⟨f ^ (j + 1), j + 1, rfl⟩, hyz⟩

  have s4 : ∀ (R : Type u) [CommRing R] (g : ↥W →+* R),
      (∀ w : ↥W, w ≠ 0 → ∀ x : R, g w * x = 0 → x = 0) → g.Flat := by
    intro R _ g h
    letI := g.toAlgebra
    show Module.Flat W R
    rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, Submodule.eq_bot_iff]
    intro x hx
    obtain ⟨a, ha⟩ := (Submodule.mem_torsion_iff x).mp hx
    have hga : g a * x = 0 := by rw [← ha]; rfl
    exact h a (nonZeroDivisors.coe_ne_zero a) x hga
  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom ρ₀)) :=
    IsClosedImmersion.spec_of_surjective _ hsurj
  haveI hP : IsProper (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) := inferInstance
  refine ⟨hP, ?_, inferInstance⟩
  have key : ∀ (f : S) (m : ℕ) (hf : f ∈ 𝒜 m) (hm : 0 < m),
      Flat (Proj.awayι 𝒜 f hf hm ≫ Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) := by
    intro f m hf hm
    rw [Proj.awayι_toSpecZero_assoc,
      ← Spec.map_comp, ← CommRingCat.ofHom_comp, HasRingHomProperty.Spec_iff (P := @Flat)]
    apply s4
    intro w hw x hx
    exact s3 f m hf hm (ρ₀ w) (fun k hk y hy hy0 => hNZ k hk w hw y hy hy0) x hx
  haveI := HasRingHomProperty.instIsZariskiLocalAtSource (P := @Flat)
  apply IsZariskiLocalAtSource.of_openCover (Proj.affineOpenCover 𝒜).openCover
  intro i
  exact key _ _ _ _

theorem wcpa_dj_lcc_fp_app_bij_of_cover : ∀ {X Y : Scheme.{u}} (ψ : X ⟶ Y) (n : ℕ)
    (U : Fin n → Y.Opens), (∀ J, IsAffineOpen (U J)) → (⨆ J, U J) = ⊤ →
    (∀ J, IsCompact ((ψ ⁻¹ᵁ U J : X.Opens) : Set X)) →
    (∀ J, IsQuasiSeparated ((ψ ⁻¹ᵁ U J : X.Opens) : Set X)) →
    (∀ J, Function.Bijective (ψ.app (U J)).hom) →
    ∀ V : Y.Opens, Function.Bijective (ψ.app V).hom :=
by
  intro X Y ψ n U hU hcov hC hQS hbij V

  have s2 : ∀ {T : TopCat.{u}} {F G : TopCat.Presheaf CommRingCat.{u} T} (α : F ⟶ G)
      (B : Set (TopologicalSpace.Opens T)), TopologicalSpace.Opens.IsBasis B →
      (∀ U ∈ B, Function.Bijective (α.app (Opposite.op U)).hom) → ∀ x : T,
      Function.Bijective ((TopCat.Presheaf.stalkFunctor CommRingCat.{u} x).map α).hom := by
    intro T F G α B hB hbij x
    refine ⟨TopCat.Presheaf.stalkFunctor_map_injective_of_isBasis hB
      (fun U hU => (hbij U hU).1) x, ?_⟩
    intro t
    obtain ⟨W, hxW, s, rfl⟩ := TopCat.Presheaf.exists_germ_eq G t
    obtain ⟨U', hU'B, hxU', hU'W⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp hB) hxW
    obtain ⟨r, hr⟩ := (hbij U' hU'B).2 (G.map (homOfLE hU'W).op s)
    refine ⟨F.germ U' x hxU' r, ?_⟩
    rw [TopCat.Presheaf.stalkFunctor_map_germ_apply, hr, TopCat.Presheaf.germ_res_apply]

  have s1 : ∀ (U : Y.Opens), IsAffineOpen U → IsCompact ((ψ ⁻¹ᵁ U : X.Opens) : Set X) →
      IsQuasiSeparated ((ψ ⁻¹ᵁ U : X.Opens) : Set X) → Function.Bijective (ψ.app U).hom →
      ∀ f : Γ(Y, U), Function.Bijective (ψ.app (Y.basicOpen f)).hom := by
    intro U hU hC hQS hbij f
    let e : Γ(Y, U) ≃+* Γ(X, ψ ⁻¹ᵁ U) := RingEquiv.ofBijective (ψ.app U).hom hbij
    have := hU.isLocalization_basicOpen f
    have := isLocalization_basicOpen_of_qcqs hC hQS ((ψ.app U).hom f)
    have hE : ψ ⁻¹ᵁ Y.basicOpen f = X.basicOpen ((ψ.app U).hom f) :=
      Scheme.Hom.preimage_basicOpen ψ f
    let ρ : Γ(X, ψ ⁻¹ᵁ Y.basicOpen f) ⟶ Γ(X, X.basicOpen ((ψ.app U).hom f)) :=
      X.presheaf.map (eqToHom hE.symm).op
    have hρ : Function.Bijective ρ.hom := ConcreteCategory.bijective_of_isIso ρ
    have H : Submonoid.map e.toMonoidHom (Submonoid.powers f) =
        Submonoid.powers ((ψ.app U).hom f) := by
      rw [Submonoid.map_powers]; rfl
    let Λ := IsLocalization.ringEquivOfRingEquiv (M := Submonoid.powers f)
      (T := Submonoid.powers ((ψ.app U).hom f)) Γ(Y, Y.basicOpen f)
      Γ(X, X.basicOpen ((ψ.app U).hom f)) e H
    have key : (ψ.app (Y.basicOpen f) ≫ ρ).hom = Λ.toRingHom := by
      apply IsLocalization.ringHom_ext (Submonoid.powers f)
      ext r
      have h1 := congrArg (fun k => (k ≫ ρ).hom r)
        (ψ.naturality (homOfLE (Y.basicOpen_le f)).op)
      have hΛ : Λ (algebraMap Γ(Y, U) Γ(Y, Y.basicOpen f) r) =
          algebraMap Γ(X, ψ ⁻¹ᵁ U) Γ(X, X.basicOpen ((ψ.app U).hom f)) (e r) :=
        IsLocalization.ringEquivOfRingEquiv_eq H r
      refine h1.trans (Eq.trans ?_ hΛ.symm)
      show (ψ.app U ≫ X.presheaf.map _ ≫ X.presheaf.map (eqToHom hE.symm).op).hom r = _
      rw [← Functor.map_comp]
      rfl
    have hcomp : ρ.hom ∘ (ψ.app (Y.basicOpen f)).hom = Λ := by
      funext x
      exact congrArg (fun k => k x) key
    have : Function.Bijective (ρ.hom ∘ (ψ.app (Y.basicOpen f)).hom) := by
      rw [hcomp]; exact Λ.bijective
    exact (Function.Bijective.of_comp_iff' hρ _).mp this

  let B : Set Y.Opens := {W | ∃ (J : Fin n) (h : Γ(Y, U J)), W = Y.basicOpen h}
  have hB : TopologicalSpace.Opens.IsBasis B := by
    rw [TopologicalSpace.Opens.isBasis_iff_nbhd]
    intro W y hyW
    have hy : y ∈ ⨆ J, U J := by rw [hcov]; trivial
    obtain ⟨J, hJ⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
    obtain ⟨h, hle, hyh⟩ := (hU J).exists_basicOpen_le ⟨y, hyW⟩ hJ
    exact ⟨Y.basicOpen h, ⟨J, h, rfl⟩, hyh, hle⟩

  have hBbij : ∀ W ∈ B, Function.Bijective (ψ.c.app (Opposite.op W)).hom := by
    rintro W ⟨J, h, rfl⟩
    exact s1 (U J) (hU J) (hC J) (hQS J) (hbij J) h

  have hstalk : ∀ y : Y, Function.Bijective
      ((TopCat.Presheaf.stalkFunctor CommRingCat y).map ψ.c).hom :=
    fun y => s2 ψ.c B hB hBbij y

  exact TopCat.Presheaf.app_bijective_of_stalkFunctor_map_bijective
    (⟨ψ.c⟩ : Y.sheaf ⟶ (TopCat.Sheaf.pushforward CommRingCat ψ.base).obj X.sheaf) V
    (fun y _ => hstalk y)

theorem wcpa_dj_lcc_fp_affine_bc_gen : ∀ (R : CommRingCat.{u}) (P : Scheme.{u}) (p : P ⟶ Spec R)
    (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec R) (U : P.Opens), IsAffineOpen U →
    IsAffineOpen ((Limits.pullback.fst p s) ⁻¹ᵁ U) ∧
    ∀ z : Γ(Limits.pullback p s, (Limits.pullback.fst p s) ⁻¹ᵁ U),
      ∃ (n : ℕ) (β : Fin n → Γ(P, U)) (c : Fin n → K),
        z = ∑ i, ((Limits.pullback.fst p s).app U).hom (β i) *
          wcpaLccScal (Limits.pullback.snd p s) ((Limits.pullback.fst p s) ⁻¹ᵁ U) (c i) :=
by

  have chart : ∀ (T0 X0 Y0 : Scheme.{u}) (g0 : X0 ⟶ T0) (t0 : Y0 ⟶ T0) (V0 : T0.Opens),
      IsAffineOpen V0 → ∀ (T : Y0.Opens), IsAffineOpen T → ∀ (hT : T ≤ t0 ⁻¹ᵁ V0)
      (U : X0.Opens), IsAffineOpen U → ∀ (hU : U ≤ g0 ⁻¹ᵁ V0)
      (UY : (Limits.pullback g0 t0).Opens) (h1 : UY ≤ Limits.pullback.fst g0 t0 ⁻¹ᵁ U)
      (h2 : UY ≤ Limits.pullback.snd g0 t0 ⁻¹ᵁ T),
      UY = Limits.pullback.fst g0 t0 ⁻¹ᵁ U ⊓ Limits.pullback.snd g0 t0 ⁻¹ᵁ T →
      IsAffineOpen UY ∧ IsPushout (g0.appLE V0 U hU) (t0.appLE V0 T hT)
        ((Limits.pullback.fst g0 t0).appLE U UY h1) ((Limits.pullback.snd g0 t0).appLE T UY h2) := by
    intro T0 X0 Y0 g0 t0 V0 hV0 T hTa hT U hUa hU UY h1 h2 heq
    have hPB := Scheme.Hom.isPullback_resLE (IsPullback.of_hasPullback g0 t0) hT hU heq
    haveI : IsAffine V0 := hV0
    haveI : IsAffine T := hTa
    haveI : IsAffine U := hUa
    have hUY : IsAffineOpen UY := by
      haveI : IsAffine (Limits.pullback (g0.resLE V0 U hU) (t0.resLE V0 T hT)) := inferInstance
      exact IsAffine.of_isIso hPB.isoPullback.hom
    refine ⟨hUY, ?_⟩
    haveI : IsAffine UY := hUY
    have hPO := isPushout_appTop_of_isPullback hPB
    have s1 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U),
        (f.resLE U V e).appTop ≫ V.topIso.hom = U.topIso.hom ≫ f.appLE U V e := by
      intro X Y f U V e
      simp only [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, Scheme.Opens.topIso_hom]
      erw [Scheme.Hom.resLE_appLE, Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
    exact IsPushout.of_iso hPO V0.topIso U.topIso T.topIso UY.topIso (s1 _ _ _ _) (s1 _ _ _ _)
      (s1 _ _ _ _) (s1 _ _ _ _)

  have gen : ∀ {Z X Y Q : CommRingCat.{u}} (f : Z ⟶ X) (g : Z ⟶ Y) (inl : X ⟶ Q)
      (inr : Y ⟶ Q), IsPushout f g inl inr → ∀ z : Q,
      ∃ (n : ℕ) (x : Fin n → X) (y : Fin n → Y), z = ∑ i, inl.hom (x i) * inr.hom (y i) := by
    intro Z X Y Q f g inl inr h z
    letI := f.hom.toAlgebra
    letI := g.hom.toAlgebra
    have hT := CommRingCat.isPushout_tensorProduct Z X Y
    have hT' : IsPushout f g
        (CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
          X →+* TensorProduct Z X Y))
        (CommRingCat.ofHom (Algebra.TensorProduct.includeRight.toRingHom :
          Y →+* TensorProduct Z X Y)) := hT
    let e := hT'.isoIsPushout _ _ h
    have hl : ∀ x : X, e.hom.hom (x ⊗ₜ[Z] (1 : Y)) = inl.hom x := by
      intro x
      have := congrArg (fun φ : X ⟶ Q => φ.hom x) (IsPushout.inl_isoIsPushout_hom _ _ hT' h)
      exact this
    have hr : ∀ y : Y, e.hom.hom ((1 : X) ⊗ₜ[Z] y) = inr.hom y := by
      intro y
      have := congrArg (fun φ : Y ⟶ Q => φ.hom y) (IsPushout.inr_isoIsPushout_hom _ _ hT' h)
      exact this
    have hrep : ∀ t : TensorProduct Z X Y, ∃ (n : ℕ) (x : Fin n → X) (y : Fin n → Y),
        t = ∑ i, x i ⊗ₜ[Z] y i := by
      intro t
      induction t using TensorProduct.inductionOn with
      | tmul x y => exact ⟨1, fun _ => x, fun _ => y, by simp⟩
      | add t₁ t₂ ih₁ ih₂ =>
        obtain ⟨n₁, x₁, y₁, h₁⟩ := ih₁
        obtain ⟨n₂, x₂, y₂, h₂⟩ := ih₂
        refine ⟨n₁ + n₂, Fin.append x₁ x₂, Fin.append y₁ y₂, ?_⟩
        rw [Fin.sum_univ_add, h₁, h₂]
        simp only [Fin.append_left, Fin.append_right]
    obtain ⟨n, x, y, hxy⟩ := hrep (e.inv.hom z)
    refine ⟨n, x, y, ?_⟩
    have hz : z = e.hom.hom (e.inv.hom z) := by
      rw [← CommRingCat.comp_apply, Iso.inv_hom_id, CommRingCat.id_apply]
    rw [hz, hxy, map_sum]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [← hl, ← hr, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]

  intro R P p K _ s U hU
  have hT : (⊤ : (Spec (.of K)).Opens) ≤ s ⁻¹ᵁ ⊤ := fun _ _ => trivial
  have hUle : U ≤ p ⁻¹ᵁ ⊤ := fun _ _ => trivial
  have hle1 : (Limits.pullback.fst p s ⁻¹ᵁ U) ≤ Limits.pullback.fst p s ⁻¹ᵁ U := le_rfl
  have hle2 : (Limits.pullback.fst p s ⁻¹ᵁ U) ≤ Limits.pullback.snd p s ⁻¹ᵁ ⊤ :=
    fun _ _ => trivial
  have heq : Limits.pullback.fst p s ⁻¹ᵁ U =
      Limits.pullback.fst p s ⁻¹ᵁ U ⊓ Limits.pullback.snd p s ⁻¹ᵁ ⊤ := by
    rw [Scheme.Hom.preimage_top, inf_top_eq]
  obtain ⟨hA, hPO⟩ := chart (Spec R) P (Spec (.of K)) p s ⊤ (isAffineOpen_top _) ⊤
    (isAffineOpen_top _) hT U hU hUle _ hle1 hle2 heq
  refine ⟨hA, fun z => ?_⟩
  obtain ⟨n, x, y, hz⟩ := gen _ _ _ _ hPO z
  refine ⟨n, x, fun i => (Scheme.ΓSpecIso (.of K)).hom.hom (y i), ?_⟩
  rw [hz]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  congr 1
  · rw [Scheme.Hom.appLE_eq_app]
  · have e1 : (Scheme.ΓSpecIso (.of K)).inv.hom ((Scheme.ΓSpecIso (.of K)).hom.hom (y i)) = y i := by
      rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]
    show _ = ((Limits.pullback.snd p s).appTop ≫ (Limits.pullback p s).presheaf.map
      (homOfLE le_top).op).hom ((Scheme.ΓSpecIso (.of K)).inv.hom
        ((Scheme.ΓSpecIso (.of K)).hom.hom (y i)))
    rw [e1]
    rfl

theorem wcpa_dj_lcc_fp_pull_basics : ∀ {Y : Scheme.{u}} {R : CommRingCat.{u}} (q : Y ⟶ Spec R)
    (L : wcpaDjCoc Y) {K : Type u} [Field K] (s : Spec (.of K) ⟶ Spec R), IsProper q →
    wcpaDjCocOK L →
    wcpaDjCocOK (wcpaDjCocPull (Limits.pullback.fst q s) L) ∧
    CompactSpace ↥(Limits.pullback q s) ∧ QuasiSeparatedSpace ↥(Limits.pullback q s) ∧
    (∀ (e : ℕ) (x : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)), wcpaDjCompat L (q ⁻¹ᵁ ⊤) e x →
      wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst q s) L) ((Limits.pullback.snd q s) ⁻¹ᵁ ⊤) e
        (wcpaLccPullFam q L s x)) ∧
    ∀ (x : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)) (a : Fin L.m),
      (Limits.pullback q s).basicOpen (wcpaLccPullFam q L s x a) =
        (Limits.pullback.fst q s) ⁻¹ᵁ Y.basicOpen (x a) :=
by
  intro Y R q L K _ s hq hL
  haveI := hq
  haveI hfa : IsAffineHom (Limits.pullback.fst q s) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback q s).flip
      inferInstance
  have gen : ∀ {X : Scheme.{u}} (f : X ⟶ Y) (a b : Fin L.m) (U : Y.Opens) (W : X.Opens)
      (hU : U ≤ L.V a ⊓ L.V b) (hWU : W ≤ f ⁻¹ᵁ U)
      (hW : W ≤ (wcpaDjCocPull f L).V a ⊓ (wcpaDjCocPull f L).V b),
      (X.presheaf.map (homOfLE hW).op).hom
          ((wcpaDjCocPull f L).g a b : Γ(X, (wcpaDjCocPull f L).V a ⊓ (wcpaDjCocPull f L).V b)) =
        (f.appLE U W hWU).hom ((Y.presheaf.map (homOfLE hU).op).hom
          (L.g a b : Γ(Y, L.V a ⊓ L.V b))) := by
    intro X f a b U W hU hWU hW
    have h1 : f ⁻¹ᵁ L.V a ⊓ f ⁻¹ᵁ L.V b ≤ f ⁻¹ᵁ (L.V a ⊓ L.V b) := fun _ hz => hz
    have key : f.app (L.V a ⊓ L.V b) ≫ X.presheaf.map (homOfLE h1).op ≫
        X.presheaf.map (homOfLE hW).op = Y.presheaf.map (homOfLE hU).op ≫ f.appLE U W hWU := by
      rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map_assoc, Scheme.Hom.map_appLE]
      exact Scheme.Hom.appLE_map _ _ _
    exact congrArg (fun φ => φ.hom (L.g a b : Γ(Y, L.V a ⊓ L.V b))) key
  have genpow : ∀ (e : ℕ) {X : Scheme.{u}} (f : X ⟶ Y) (a b : Fin L.m) (U : Y.Opens)
      (W : X.Opens) (hU : U ≤ L.V a ⊓ L.V b) (hWU : W ≤ f ⁻¹ᵁ U)
      (hW : W ≤ (wcpaDjCocPull f L).V a ⊓ (wcpaDjCocPull f L).V b),
      (X.presheaf.map (homOfLE hW).op).hom
          (((wcpaDjCocPull f L).g a b : Γ(X, (wcpaDjCocPull f L).V a ⊓ (wcpaDjCocPull f L).V b))
            ^ e) =
        (f.appLE U W hWU).hom ((Y.presheaf.map (homOfLE hU).op).hom
          ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ e)) := by
    intro e X f a b U W hU hWU hW
    simp only [map_pow]
    rw [gen f a b U W hU hWU hW]
  refine ⟨⟨?_, ?_, ?_, ?_⟩, ?_, ?_, ?_, ?_⟩
  · intro a
    exact (hL.1 a).preimage _
  · have := (Limits.pullback.fst q s).preimage_iSup L.V
    rw [hL.2.1, Scheme.Hom.preimage_top] at this
    exact this.symm
  · intro a
    show Units.map _ (L.g a a) = 1
    rw [hL.2.2.1 a, map_one]
  · intro a b c
    have hWU : (wcpaDjCocPull (Limits.pullback.fst q s) L).V a ⊓
        (wcpaDjCocPull (Limits.pullback.fst q s) L).V b ⊓
        (wcpaDjCocPull (Limits.pullback.fst q s) L).V c ≤
        (Limits.pullback.fst q s) ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ L.V c) :=
      fun _ hz => ⟨⟨hz.1.1, hz.1.2⟩, hz.2⟩
    rw [gen (Limits.pullback.fst q s) a b _ _ inf_le_left hWU,
      gen (Limits.pullback.fst q s) b c _ _
        (le_inf (inf_le_left.trans inf_le_right) inf_le_right) hWU,
      gen (Limits.pullback.fst q s) a c _ _
        (le_inf (inf_le_left.trans inf_le_left) inf_le_right) hWU, ← map_mul]
    exact congrArg _ (hL.2.2.2 a b c)
  · exact QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd q s)
  · exact quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.snd q s)
  · intro e x hx a b
    have genx : ∀ (a : Fin L.m) (U : Y.Opens) (W : (Limits.pullback q s).Opens)
        (hU : U ≤ L.V a ⊓ q ⁻¹ᵁ ⊤) (hWU : W ≤ (Limits.pullback.fst q s) ⁻¹ᵁ U)
        (hW : W ≤ (wcpaDjCocPull (Limits.pullback.fst q s) L).V a ⊓
          (Limits.pullback.snd q s) ⁻¹ᵁ ⊤),
        ((Limits.pullback q s).presheaf.map (homOfLE hW).op).hom (wcpaLccPullFam q L s x a) =
          ((Limits.pullback.fst q s).appLE U W hWU).hom
            ((Y.presheaf.map (homOfLE hU).op).hom (x a)) := by
      intro a U W hU hWU hW
      have h0 : (wcpaDjCocPull (Limits.pullback.fst q s) L).V a ⊓
          (Limits.pullback.snd q s) ⁻¹ᵁ ⊤ ≤
          (Limits.pullback.fst q s) ⁻¹ᵁ (L.V a ⊓ q ⁻¹ᵁ ⊤) := fun _ hz => ⟨hz.1, trivial⟩
      have key : (Limits.pullback.fst q s).appLE (L.V a ⊓ q ⁻¹ᵁ ⊤) _ h0 ≫
          (Limits.pullback q s).presheaf.map (homOfLE hW).op =
          Y.presheaf.map (homOfLE hU).op ≫ (Limits.pullback.fst q s).appLE U W hWU := by
        rw [Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
      exact congrArg (fun φ => φ.hom (x a)) key
    have hWU : (wcpaDjCocPull (Limits.pullback.fst q s) L).V a ⊓
        (wcpaDjCocPull (Limits.pullback.fst q s) L).V b ⊓ (Limits.pullback.snd q s) ⁻¹ᵁ ⊤ ≤
        (Limits.pullback.fst q s) ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ ⊤) :=
      fun _ hz => ⟨⟨hz.1.1, hz.1.2⟩, trivial⟩
    rw [genx b _ _ (le_inf (inf_le_left.trans inf_le_right) inf_le_right) hWU,
      genpow e (Limits.pullback.fst q s) a b _ _ inf_le_left hWU,
      genx a _ _ (le_inf (inf_le_left.trans inf_le_left) inf_le_right) hWU, ← map_mul]
    exact congrArg _ (hx a b)
  · intro x a
    refine (Scheme.basicOpen_appLE _ _ _ _ (x a)).trans ?_
    apply inf_eq_right.mpr
    exact fun z hz => ⟨(Y.basicOpen_le (x a) hz).1, trivial⟩

theorem wcpa_dj_lcc_fcb_gen : ∀ (S : Type u) [CommRing S] (𝒜 : ℕ → AddSubgroup S) [GradedRing 𝒜]
    (R : CommRingCat.{u}) (p : Proj 𝒜 ⟶ Spec R) (K : Type u) [Field K]
    (s : Spec (.of K) ⟶ Spec R) (f : S) (d : ℕ) (hf : f ∈ 𝒜 d), 0 < d →
    ∀ z : Γ(Limits.pullback p s, (Limits.pullback.fst p s) ⁻¹ᵁ Proj.basicOpen 𝒜 f),
    ∃ (n N : ℕ) (β : Fin N → S) (hβ : ∀ j, β j ∈ 𝒜 (n • d)) (c : Fin N → K), 1 ≤ n ∧
      z = ∑ j, ((Limits.pullback.fst p s).app (Proj.basicOpen 𝒜 f)).hom
          ((Proj.awayToSection 𝒜 f).hom (HomogeneousLocalization.Away.mk 𝒜 hf n (β j) (hβ j))) *
        wcpaLccScal (Limits.pullback.snd p s) ((Limits.pullback.fst p s) ⁻¹ᵁ Proj.basicOpen 𝒜 f) (c j) :=
by
  intro S _ 𝒜 _ R p K _ s f d hf hd z
  classical
  have haff : IsAffineOpen (Proj.basicOpen 𝒜 f) := Proj.isAffineOpen_basicOpen 𝒜 f hf hd
  obtain ⟨N, γ, c, hz⟩ :=
    (wcpa_dj_lcc_fp_affine_bc_gen R (Proj 𝒜) p K s (Proj.basicOpen 𝒜 f) haff).2 z
  have hB : ∀ y, (Proj.awayToSection 𝒜 f).hom
      ((Proj.basicOpenIsoAway 𝒜 f hf hd).inv.hom y) = y := by
    intro y
    rw [← Proj.basicOpenIsoAway_hom 𝒜 f hf hd]
    exact Iso.inv_hom_id_apply _ y
  choose n₀ a ha hq using fun i => HomogeneousLocalization.Away.mk_surjective 𝒜 hf
    ((Proj.basicOpenIsoAway 𝒜 f hf hd).inv.hom (γ i))
  obtain ⟨n, hn⟩ : ∃ n : ℕ, n = Finset.univ.sup n₀ + 1 := ⟨_, rfl⟩
  have hle : ∀ i, n₀ i ≤ n := fun i => by
    rw [hn]; exact Nat.le_succ_of_le (Finset.le_sup (Finset.mem_univ i))
  have hβ : ∀ i, a i * f ^ (n - n₀ i) ∈ 𝒜 (n • d) := by
    intro i
    have hidx : n₀ i • d + (n - n₀ i) • d = n • d := by
      rw [← add_nsmul, Nat.add_sub_cancel' (hle i)]
    rw [← hidx]
    exact SetLike.mul_mem_graded (ha i) (SetLike.pow_mem_graded (n - n₀ i) hf)
  have hraise : ∀ i, HomogeneousLocalization.Away.mk 𝒜 hf n (a i * f ^ (n - n₀ i)) (hβ i) =
      HomogeneousLocalization.Away.mk 𝒜 hf (n₀ i) (a i) (ha i) := by
    intro i
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
      Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    have hpow : f ^ n = f ^ n₀ i * f ^ (n - n₀ i) := by
      rw [← pow_add, Nat.add_sub_cancel' (hle i)]
    simp only [OneMemClass.coe_one, one_mul]
    rw [hpow]
    ring
  refine ⟨n, N, fun i => a i * f ^ (n - n₀ i), hβ, c, by omega, ?_⟩
  rw [hz]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  rw [hraise i, hq i, hB]

theorem wcpa_dj_lcc_fcb_away_alg : ∀ (S : Type u) [CommRing S] (𝒜 : ℕ → AddSubgroup S) [GradedRing 𝒜]
    {f : S} {d : ℕ} (hf : f ∈ 𝒜 d),
    (∀ (n p : ℕ) (y : S) (hy : y ∈ 𝒜 (n • d)) (hy' : y * f ^ p ∈ 𝒜 ((n + p) • d)),
      HomogeneousLocalization.Away.mk 𝒜 hf n y hy =
        HomogeneousLocalization.Away.mk 𝒜 hf (n + p) (y * f ^ p) hy') ∧
    (∀ (n N : ℕ) (a : Fin N → ↥(𝒜 0)) (y : Fin N → S) (hy : ∀ j, y j ∈ 𝒜 (n • d))
      (hs : (∑ j, (a j : S) * y j) ∈ 𝒜 (n • d)),
      HomogeneousLocalization.Away.mk 𝒜 hf n (∑ j, (a j : S) * y j) hs =
        ∑ j, HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f) (a j) *
          HomogeneousLocalization.Away.mk 𝒜 hf n (y j) (hy j)) :=
by
  intro S _ 𝒜 _ f d hf
  refine ⟨?_, ?_⟩
  · intro n p y hy hy'
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
      Localization.mk_eq_mk_iff, Localization.r_iff_exists]
    refine ⟨1, ?_⟩
    simp only [Submonoid.coe_one, one_mul]
    ring
  · intro n N a y hy hs
    apply HomogeneousLocalization.val_injective
    have s2 : ∀ (g : Fin N → HomogeneousLocalization.Away 𝒜 f),
        (∑ j, g j).val = ∑ j, (g j).val := by
      intro g
      have := map_sum (algebraMap (HomogeneousLocalization.Away 𝒜 f)
        (Localization (Submonoid.powers f))) g Finset.univ
      simpa only [HomogeneousLocalization.algebraMap_apply] using this
    have s3 : ∀ b : 𝒜 0, (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f) b).val
        = Localization.mk (b : S) 1 := by
      intro b
      rfl
    rw [s2, HomogeneousLocalization.Away.val_mk, Localization.mk_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [HomogeneousLocalization.val_mul, s3, HomogeneousLocalization.Away.val_mk,
      Localization.mk_mul, one_mul]

theorem wcpa_dj_lcc_fcb_lb_surj : ∀ (X : Scheme.{u}) (L : wcpaDjCoc X) (O : X.Opens) (e : ℕ)
    (g : ∀ a : Fin L.m, Γ(X, L.V a ⊓ O)),
    (∀ a, IsAffineOpen (L.V a ⊓ O)) →
    (∀ a b, IsCompact ((L.V a ⊓ L.V b ⊓ O : X.Opens) : Set X)) →
    wcpaDjCompat L O e g →
    ∀ (U : X.Opens) (hU : ∀ a, X.basicOpen (g a) ≤ U) (h : Γ(X, U)),
    ∃ (n : ℕ) (y : ∀ a : Fin L.m, Γ(X, L.V a ⊓ O)), 1 ≤ n ∧ wcpaDjCompat L O (n * e) y ∧
      ∀ a, (X.presheaf.map (homOfLE (hU a)).op).hom h *
          (X.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom (g a) ^ n =
        (X.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom (y a) :=
by
  intro X L O e g haff hcpt hcompat U hU h
  classical
  have hres : ∀ {V W Z : X.Opens} (h1 : V ≤ W) (h2 : W ≤ Z) (x : Γ(X, Z)),
      (X.presheaf.map (homOfLE h1).op).hom ((X.presheaf.map (homOfLE h2).op).hom x) =
        (X.presheaf.map (homOfLE (h1.trans h2)).op).hom x := by
    intro V W Z h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have hloc : ∀ a, ∃ (k : ℕ) (y0 : Γ(X, L.V a ⊓ O)),
      (X.presheaf.map (homOfLE (hU a)).op).hom h *
        (X.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom (g a) ^ k =
      (X.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom y0 := by
    intro a
    have := (haff a).isLocalization_basicOpen (g a)
    exact IsLocalization.Away.surj (g a) ((X.presheaf.map (homOfLE (hU a)).op).hom h)
  choose k y0 hy0 using hloc
  obtain ⟨n₁, hn₁⟩ : ∃ n₁ : ℕ, n₁ = 1 + Finset.univ.sup k := ⟨_, rfl⟩
  have hk : ∀ a, k a ≤ n₁ := fun a => by
    have := Finset.le_sup (f := k) (Finset.mem_univ a); omega
  have hn₁pos : 1 ≤ n₁ := by omega
  obtain ⟨y₁, hy₁def⟩ : ∃ y₁ : ∀ a : Fin L.m, Γ(X, L.V a ⊓ O),
      y₁ = fun a => y0 a * g a ^ (n₁ - k a) := ⟨_, rfl⟩
  have hrel : ∀ a, (X.presheaf.map (homOfLE (hU a)).op).hom h *
        (X.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom (g a) ^ n₁ =
      (X.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom (y₁ a) := by
    intro a
    obtain ⟨r, hr⟩ := Nat.exists_eq_add_of_le (hk a)
    have hr' : n₁ - k a = r := by omega
    rw [hy₁def]
    simp only [hr', map_mul, map_pow]
    rw [hr, pow_add, ← mul_assoc, hy0 a]

  have hA : ∀ a b : Fin L.m, L.V a ⊓ L.V b ⊓ O ≤ L.V a ⊓ O := fun a b =>
    le_inf (inf_le_left.trans inf_le_left) inf_le_right
  have hB : ∀ a b : Fin L.m, L.V a ⊓ L.V b ⊓ O ≤ L.V b ⊓ O := fun a b =>
    le_inf (inf_le_left.trans inf_le_right) inf_le_right
  have hS : ∀ a b : Fin L.m, L.V a ⊓ L.V b ⊓ O ≤ L.V a ⊓ L.V b := fun a b => inf_le_left

  have hQa : ∀ a b, X.basicOpen ((X.presheaf.map (homOfLE (hA a b)).op).hom (g a)) ≤
      X.basicOpen (g a) := by
    intro a b
    rw [Scheme.basicOpen_res]
    exact inf_le_right
  have hQb : ∀ a b, X.basicOpen ((X.presheaf.map (homOfLE (hA a b)).op).hom (g a)) ≤
      X.basicOpen (g b) := by
    intro a b
    have hc := hcompat a b
    have hu : IsUnit ((X.presheaf.map (homOfLE (hS a b)).op).hom
        ((L.g a b : Γ(X, L.V a ⊓ L.V b)) ^ e)) := ((L.g a b).isUnit.pow e).map _
    calc X.basicOpen ((X.presheaf.map (homOfLE (hA a b)).op).hom (g a))
        = X.basicOpen ((X.presheaf.map (homOfLE (hS a b)).op).hom
            ((L.g a b : Γ(X, L.V a ⊓ L.V b)) ^ e) *
            (X.presheaf.map (homOfLE (hA a b)).op).hom (g a)) := by
          rw [Scheme.basicOpen_mul, Scheme.basicOpen_of_isUnit _ hu]
          exact (inf_eq_right.mpr (X.basicOpen_le _)).symm
      _ = X.basicOpen ((X.presheaf.map (homOfLE (hB a b)).op).hom (g b)) := by
          rw [← hc]
      _ ≤ X.basicOpen (g b) := by
          rw [Scheme.basicOpen_res]
          exact inf_le_right

  have hdef : ∀ a b,
      (X.presheaf.map (homOfLE (X.basicOpen_le
          ((X.presheaf.map (homOfLE (hA a b)).op).hom (g a)))).op).hom
        ((X.presheaf.map (homOfLE (hB a b)).op).hom (y₁ b) -
          (X.presheaf.map (homOfLE (hS a b)).op).hom
            ((L.g a b : Γ(X, L.V a ⊓ L.V b)) ^ (n₁ * e)) *
          (X.presheaf.map (homOfLE (hA a b)).op).hom (y₁ a)) = 0 := by
    intro a b
    have Rb := congrArg (X.presheaf.map (homOfLE (hQb a b)).op).hom (hrel b)
    have Ra := congrArg (X.presheaf.map (homOfLE (hQa a b)).op).hom (hrel a)
    have Cg := congrArg (X.presheaf.map (homOfLE (X.basicOpen_le
          ((X.presheaf.map (homOfLE (hA a b)).op).hom (g a)))).op).hom (hcompat a b)
    simp only [map_mul, map_pow, hres] at Rb Ra Cg
    simp only [map_sub, map_mul, map_pow, hres]
    rw [Cg] at Rb
    linear_combination (-1 : Γ(X, X.basicOpen
        ((X.presheaf.map (homOfLE (hA a b)).op).hom (g a)))) * Rb +
      ((X.presheaf.map (homOfLE ((X.basicOpen_le _).trans (hS a b))).op).hom
        (L.g a b : Γ(X, L.V a ⊓ L.V b))) ^ (n₁ * e) * Ra

  have hkill0 : ∀ a b, ∃ Nab : ℕ,
      (X.presheaf.map (homOfLE (hA a b)).op).hom (g a) ^ Nab *
        ((X.presheaf.map (homOfLE (hB a b)).op).hom (y₁ b) -
          (X.presheaf.map (homOfLE (hS a b)).op).hom
            ((L.g a b : Γ(X, L.V a ⊓ L.V b)) ^ (n₁ * e)) *
          (X.presheaf.map (homOfLE (hA a b)).op).hom (y₁ a)) = 0 := fun a b =>
    exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isCompact X (hcpt a b) _ _ (hdef a b)
  choose Nab hNab using hkill0
  obtain ⟨N, hN⟩ : ∃ N : ℕ, ∀ a b, Nab a b ≤ N :=
    ⟨Finset.univ.sup (fun p : Fin L.m × Fin L.m => Nab p.1 p.2), fun a b =>
      Finset.le_sup (f := fun p : Fin L.m × Fin L.m => Nab p.1 p.2) (Finset.mem_univ (a, b))⟩
  have hkill : ∀ a b,
      (X.presheaf.map (homOfLE (hA a b)).op).hom (g a) ^ N *
        ((X.presheaf.map (homOfLE (hB a b)).op).hom (y₁ b) -
          (X.presheaf.map (homOfLE (hS a b)).op).hom
            ((L.g a b : Γ(X, L.V a ⊓ L.V b)) ^ (n₁ * e)) *
          (X.presheaf.map (homOfLE (hA a b)).op).hom (y₁ a)) = 0 := by
    intro a b
    obtain ⟨r, hr⟩ := Nat.exists_eq_add_of_le (hN a b)
    rw [hr, pow_add, mul_comm (_ ^ Nab a b), mul_assoc, hNab a b, mul_zero]

  refine ⟨n₁ + N, fun a => y₁ a * g a ^ N, by omega, ?_, ?_⟩
  · intro a b
    have hc := hcompat a b
    have hk := hkill a b
    show (X.presheaf.map (homOfLE (hB a b)).op).hom (y₁ b * g b ^ N) =
      (X.presheaf.map (homOfLE (hS a b)).op).hom
        ((L.g a b : Γ(X, L.V a ⊓ L.V b)) ^ ((n₁ + N) * e)) *
      (X.presheaf.map (homOfLE (hA a b)).op).hom (y₁ a * g a ^ N)
    simp only [map_mul, map_pow] at hc hk ⊢
    rw [hc]
    linear_combination ((X.presheaf.map (homOfLE (hS a b)).op).hom
        (L.g a b : Γ(X, L.V a ⊓ L.V b))) ^ (e * N) * hk
  · intro a
    show _ = (X.presheaf.map (homOfLE (X.basicOpen_le (g a))).op).hom (y₁ a * g a ^ N)
    rw [map_mul, map_pow, pow_add, ← mul_assoc, hrel a]

theorem wcpa_dj_lcc_fcb_eval : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Z₁ : Scheme.{u})
    (u₁ : Z₁ ⟶ Spec (.of ↥W))
    (L : wcpaDjCoc Z₁) (S : Type u) [CommRing S] (𝒜 : ℕ → AddSubgroup S) [GradedRing 𝒜]
    (ρ₀ : ↥W →+* ↥(𝒜 0)) (ev : ∀ a : Fin L.m, S →+* Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)),
    IsProper u₁ → wcpaDjCocOK L →
    ∀ (φ : Z₁ ⟶ Proj 𝒜) (k : ℕ) (x : S) (hx : x ∈ 𝒜 k),
    (∀ (j : ℕ) (β : S) (hβ : β ∈ 𝒜 (j • k)) (a : Fin L.m)
      (h : Z₁.basicOpen (ev a x) ≤ φ ⁻¹ᵁ Proj.basicOpen 𝒜 x),
      (φ.appLE (Proj.basicOpen 𝒜 x) (Z₁.basicOpen (ev a x)) h).hom
          ((Proj.awayToSection 𝒜 x).hom (HomogeneousLocalization.Away.mk 𝒜 hx j β hβ)) *
        (Z₁.presheaf.map (homOfLE (Z₁.basicOpen_le (ev a x))).op).hom (ev a x) ^ j =
      (Z₁.presheaf.map (homOfLE (Z₁.basicOpen_le (ev a x))).op).hom (ev a β)) →
    ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥W))
    (φs : Limits.pullback u₁ s ⟶ Limits.pullback (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s),
    φs ≫ Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s =
      Limits.pullback.fst u₁ s ≫ φ →
    φs ≫ Limits.pullback.snd (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s =
      Limits.pullback.snd u₁ s →
    ∀ (n N : ℕ) (β : Fin N → S) (hβ : ∀ j, β j ∈ 𝒜 (n • k)) (c : Fin N → K) (a : Fin L.m)
    (hle₀ : Z₁.basicOpen (ev a x) ≤ φ ⁻¹ᵁ Proj.basicOpen 𝒜 x)
    (hle : (Limits.pullback u₁ s).basicOpen (wcpaLccPullFam u₁ L s (fun a => ev a x) a) ≤
      φs ⁻¹ᵁ ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s) ⁻¹ᵁ
        Proj.basicOpen 𝒜 x)),
    ((Limits.pullback u₁ s).presheaf.map (homOfLE hle).op).hom
        ((φs.app ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s) ⁻¹ᵁ
          Proj.basicOpen 𝒜 x)).hom
          (∑ j, ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s).app
              (Proj.basicOpen 𝒜 x)).hom
              ((Proj.awayToSection 𝒜 x).hom (HomogeneousLocalization.Away.mk 𝒜 hx n (β j) (hβ j))) *
            wcpaLccScal (Limits.pullback.snd (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s)
              ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s) ⁻¹ᵁ
                Proj.basicOpen 𝒜 x) (c j))) *
      ((Limits.pullback u₁ s).presheaf.map (homOfLE ((Limits.pullback u₁ s).basicOpen_le
          (wcpaLccPullFam u₁ L s (fun a => ev a x) a))).op).hom
        (wcpaLccPullFam u₁ L s (fun a => ev a x) a) ^ n =
    ((Limits.pullback u₁ s).presheaf.map (homOfLE ((Limits.pullback u₁ s).basicOpen_le
          (wcpaLccPullFam u₁ L s (fun a => ev a x) a))).op).hom
      (∑ j, wcpaLccScal (Limits.pullback.snd u₁ s) _ (c j) *
        wcpaLccPullFam u₁ L s (fun a => ev a (β j)) a) :=
by
  intro Ω _ W Z₁ u₁ L S _ 𝒜 _ ρ₀ ev _hpu _hOK φ k x hx hC3 K _ s φs h1 h2 n N β hβ c a hle₀ hle

  have sq : ∀ {X Y Y' Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) (f' : X ⟶ Y') (g' : Y' ⟶ Z),
      f ≫ g = f' ≫ g' → ∀ (W₀ : Z.Opens) (V : Y.Opens) (V' : Y'.Opens) (U : X.Opens)
      (e₁ : V ≤ g ⁻¹ᵁ W₀) (e₂ : U ≤ f ⁻¹ᵁ V) (e₁' : V' ≤ g' ⁻¹ᵁ W₀) (e₂' : U ≤ f' ⁻¹ᵁ V')
      (w : Γ(Z, W₀)), (f.appLE V U e₂).hom ((g.appLE W₀ V e₁).hom w) =
        (f'.appLE V' U e₂').hom ((g'.appLE W₀ V' e₁').hom w) := by
    intro X Y Y' Z f g f' g' hfg W₀ V V' U e₁ e₂ e₁' e₂' w
    have aux : ∀ (h₁ h₂ : X ⟶ Z), h₁ = h₂ → ∀ e e', h₁.appLE W₀ U e = h₂.appLE W₀ U e' := by
      intro h₁ h₂ hh e e'; subst hh; rfl
    change (g.appLE W₀ V e₁ ≫ f.appLE V U e₂).hom w =
      (g'.appLE W₀ V' e₁' ≫ f'.appLE V' U e₂').hom w
    rw [Scheme.Hom.appLE_comp_appLE, Scheme.Hom.appLE_comp_appLE, aux _ _ hfg]
  have scal_nat : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Spec (.of K))
      (V : Y.Opens) (U : X.Opens) (e : U ≤ f ⁻¹ᵁ V) (c : K),
      (f.appLE V U e).hom (wcpaLccScal g V c) = wcpaLccScal (f ≫ g) U c := by
    intro X Y f g V U e c
    change ((Scheme.ΓSpecIso (.of K)).inv ≫ (g.appTop ≫ Y.presheaf.map (homOfLE le_top).op) ≫
        f.appLE V U e).hom c =
      ((Scheme.ΓSpecIso (.of K)).inv ≫ (f ≫ g).appTop ≫ X.presheaf.map (homOfLE le_top).op).hom c
    have e1 : g.appTop ≫ Y.presheaf.map (homOfLE le_top).op =
        g.appLE ⊤ V (le_top.trans (Scheme.Hom.preimage_top g).ge) := rfl
    have e2 : (f ≫ g).appTop ≫ X.presheaf.map (homOfLE le_top).op =
        (f ≫ g).appLE ⊤ U (le_top.trans (Scheme.Hom.preimage_top (f ≫ g)).ge) := rfl
    rw [e1, e2, Scheme.Hom.appLE_comp_appLE]
  have res_appLE : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (V : Y.Opens) (V' : X.Opens)
      (e' : V' ≤ f ⁻¹ᵁ V) (Z' : Y.Opens) (hZ : Z' ≤ V) (U : X.Opens) (hU : U ≤ V')
      (e : U ≤ f ⁻¹ᵁ Z') (t : Γ(Y, V)),
      (X.presheaf.map (homOfLE hU).op).hom ((f.appLE V V' e').hom t) =
        (f.appLE Z' U e).hom ((Y.presheaf.map (homOfLE hZ).op).hom t) := by
    intro X Y f V V' e' Z' hZ U hU e t
    change (f.appLE V V' e' ≫ X.presheaf.map (homOfLE hU).op).hom t =
      (Y.presheaf.map (homOfLE hZ).op ≫ f.appLE Z' U e).hom t
    rw [Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
  have scal_res : ∀ {X : Scheme.{u}} (h : X ⟶ Spec (.of K)) (U V : X.Opens)
      (i : U ≤ V) (c : K),
      (X.presheaf.map (homOfLE i).op).hom (wcpaLccScal h V c) = wcpaLccScal h U c := by
    intro X h U V i c
    change ((Scheme.ΓSpecIso (.of K)).inv ≫ h.appTop ≫ X.presheaf.map (homOfLE le_top).op ≫
        X.presheaf.map (homOfLE i).op).hom c =
      ((Scheme.ΓSpecIso (.of K)).inv ≫ h.appTop ≫ X.presheaf.map (homOfLE le_top).op).hom c
    rw [← Functor.map_comp]
    rfl

  have he : (Limits.pullback u₁ s).basicOpen (wcpaLccPullFam u₁ L s (fun a => ev a x) a) ≤
      (Limits.pullback.fst u₁ s) ⁻¹ᵁ Z₁.basicOpen (ev a x) :=
    (Scheme.basicOpen_appLE (Limits.pullback.fst u₁ s)
      ((wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓ (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤)
      (L.V a ⊓ u₁ ⁻¹ᵁ ⊤)
      (fun _ hx => ⟨hx.1, trivial⟩) (ev a x)).le.trans inf_le_right
  have hρφ : ∀ t, ((Limits.pullback u₁ s).presheaf.map (homOfLE hle).op).hom
      ((φs.app ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s) ⁻¹ᵁ
          Proj.basicOpen 𝒜 x)).hom t) =
      (φs.appLE ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s) ⁻¹ᵁ
          Proj.basicOpen 𝒜 x)
        ((Limits.pullback u₁ s).basicOpen (wcpaLccPullFam u₁ L s (fun a => ev a x) a)) hle).hom t :=
    fun t => rfl
  have hP : ∀ w : Γ(Proj 𝒜, Proj.basicOpen 𝒜 x),
      (φs.appLE ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s) ⁻¹ᵁ
          Proj.basicOpen 𝒜 x)
        ((Limits.pullback u₁ s).basicOpen (wcpaLccPullFam u₁ L s (fun a => ev a x) a)) hle).hom
        (((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s).app
          (Proj.basicOpen 𝒜 x)).hom w) =
      ((Limits.pullback.fst u₁ s).appLE (Z₁.basicOpen (ev a x))
        ((Limits.pullback u₁ s).basicOpen (wcpaLccPullFam u₁ L s (fun a => ev a x) a)) he).hom
        ((φ.appLE (Proj.basicOpen 𝒜 x) (Z₁.basicOpen (ev a x)) hle₀).hom w) := by
    intro w
    rw [Scheme.Hom.app_eq_appLE]
    exact sq _ _ _ _ h1 _ _ _ _ _ _ _ _ w
  have hSc : ∀ c' : K,
      (φs.appLE ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s) ⁻¹ᵁ
          Proj.basicOpen 𝒜 x)
        ((Limits.pullback u₁ s).basicOpen (wcpaLccPullFam u₁ L s (fun a => ev a x) a)) hle).hom
        (wcpaLccScal (Limits.pullback.snd (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s)
          ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s) ⁻¹ᵁ
            Proj.basicOpen 𝒜 x) c') =
      wcpaLccScal (Limits.pullback.snd u₁ s)
        ((Limits.pullback u₁ s).basicOpen (wcpaLccPullFam u₁ L s (fun a => ev a x) a)) c' := by
    intro c'
    rw [scal_nat, h2]
  have hR : ∀ y : S,
      ((Limits.pullback u₁ s).presheaf.map (homOfLE ((Limits.pullback u₁ s).basicOpen_le
          (wcpaLccPullFam u₁ L s (fun a => ev a x) a))).op).hom
        (wcpaLccPullFam u₁ L s (fun a => ev a y) a) =
      ((Limits.pullback.fst u₁ s).appLE (Z₁.basicOpen (ev a x))
        ((Limits.pullback u₁ s).basicOpen (wcpaLccPullFam u₁ L s (fun a => ev a x) a)) he).hom
        ((Z₁.presheaf.map (homOfLE (Z₁.basicOpen_le (ev a x))).op).hom (ev a y)) := by
    intro y
    unfold wcpaLccPullFam
    exact res_appLE _ _ _ _ _ _ _ _ _ _
  have hSR : ∀ c' : K,
      ((Limits.pullback u₁ s).presheaf.map (homOfLE ((Limits.pullback u₁ s).basicOpen_le
          (wcpaLccPullFam u₁ L s (fun a => ev a x) a))).op).hom
        (wcpaLccScal (Limits.pullback.snd u₁ s)
          ((wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓ (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤)
          c') =
      wcpaLccScal (Limits.pullback.snd u₁ s)
        ((Limits.pullback u₁ s).basicOpen (wcpaLccPullFam u₁ L s (fun a => ev a x) a)) c' :=
    fun c' => scal_res _ _ _ _ c'
  rw [hρφ, map_sum, Finset.sum_mul, map_sum]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [map_mul, map_mul, hP, hSc, hR x, hR (β j), hSR, ← hC3 n (β j) (hβ j) a hle₀, map_mul,
    map_pow]
  ring

theorem wcpa_dj_lcc_fcb_basis : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Z₁ : Scheme.{u})
    (u₁ : Z₁ ⟶ Spec (.of ↥W))
    (L : wcpaDjCoc Z₁) (S : Type u) [CommRing S] (𝒜 : ℕ → AddSubgroup S) [GradedRing 𝒜]
    (ρ₀ : ↥W →+* ↥(𝒜 0)) (ev : ∀ a : Fin L.m, S →+* Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) (m e : ℕ),
    wcpaLccBC u₁ L (m * e) →
    (∀ (a : Fin L.m) (w : ↥W), ev a ((ρ₀ w : ↥(𝒜 0)) : S) =
      (u₁.appLE ⊤ (L.V a ⊓ u₁ ⁻¹ᵁ ⊤) inf_le_right).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w)) →
    (∀ r ∈ 𝒜 e, wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) (m * e) (fun a => ev a r)) →
    (∀ x : (∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)),
      wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) (m * e) x → ∃! r : S, r ∈ 𝒜 e ∧ ∀ a, ev a r = x a) →
    ∃ (N : ℕ) (b : Fin N → S), (∀ j, b j ∈ 𝒜 e) ∧
      (∀ γ ∈ 𝒜 e, ∃ w : Fin N → ↥W, γ = ∑ j, ((ρ₀ (w j) : ↥(𝒜 0)) : S) * b j) ∧
      (∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥W))
        (y' : ∀ a : Fin L.m, Γ(Limits.pullback u₁ s,
          (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓ (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤)),
        wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst u₁ s) L) ((Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤)
          (m * e) y' →
        ∃ c : Fin N → K, ∀ a, y' a =
          ∑ j, wcpaLccScal (Limits.pullback.snd u₁ s) _ (c j) *
            wcpaLccPullFam u₁ L s (fun a => ev a (b j)) a) ∧
      (∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥W)) (c : Fin N → K),
        (∀ a, ∑ j, wcpaLccScal (Limits.pullback.snd u₁ s) _ (c j) *
            wcpaLccPullFam u₁ L s (fun a => ev a (b j)) a = 0) → ∀ j, c j = 0) :=
by
  intro Ω _ W Z₁ u₁ L S _ 𝒜 _ ρ₀ ev m e hBC hO2 hO3 hO4
  obtain ⟨N₀, b', hb'c, hglob, hfib⟩ := hBC
  choose b hb hbev using fun j => (hO4 (b' j) (hb'c j)).exists
  have hbev' : ∀ j, (fun a => ev a (b j)) = b' j := fun j => funext (hbev j)
  refine ⟨N₀, b, hb, ?_, ?_, ?_⟩
  · intro γ hγ
    obtain ⟨c, hc⟩ := (hglob (fun a => ev a γ) (hO3 γ hγ)).exists
    refine ⟨fun j => (Scheme.ΓSpecIso (.of ↥W)).hom.hom (c j), ?_⟩
    have hmem : (∑ j, ((ρ₀ ((Scheme.ΓSpecIso (.of ↥W)).hom.hom (c j)) : ↥(𝒜 0)) : S) * b j)
        ∈ 𝒜 e := by
      refine AddSubgroup.sum_mem _ (fun j _ => ?_)
      have := SetLike.mul_mem_graded (ρ₀ ((Scheme.ΓSpecIso (.of ↥W)).hom.hom (c j))).2 (hb j)
      rwa [zero_add] at this
    refine (hO4 (fun a => ev a γ) (hO3 γ hγ)).unique ⟨hγ, fun a => rfl⟩ ⟨hmem, fun a => ?_⟩
    rw [map_sum, hc a]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_mul, hO2, hbev, CommRingCat.inv_hom_apply]
  · intro K _ s y' hy'
    obtain ⟨c, hc⟩ := (hfib K s y' hy').exists
    have hPF : ∀ j, wcpaLccPullFam u₁ L s (fun a => ev a (b j)) = wcpaLccPullFam u₁ L s (b' j) :=
      fun j => by rw [hbev' j]
    refine ⟨c, fun a => ?_⟩
    rw [hc a]
    simp only [hPF]
  · intro K _ s c hz
    have hPF : ∀ j, wcpaLccPullFam u₁ L s (fun a => ev a (b j)) = wcpaLccPullFam u₁ L s (b' j) :=
      fun j => by rw [hbev' j]
    simp only [hPF] at hz
    have h0 : wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst u₁ s) L)
        ((Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤) (m * e) (fun _ => 0) := by
      intro a b
      simp only [map_zero, mul_zero]
    have hc0 : c = 0 := (hfib K s _ h0).unique (fun a => (hz a).symm)
      (fun a => by simp only [Pi.zero_apply, map_zero, zero_mul, Finset.sum_const_zero])
    intro j
    rw [hc0]
    rfl

theorem wcpa_dj_lcc_fcb_expand : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Z₁ : Scheme.{u})
    (u₁ : Z₁ ⟶ Spec (.of ↥W))
    (L : wcpaDjCoc Z₁) (S : Type u) [CommRing S] (𝒜 : ℕ → AddSubgroup S) [GradedRing 𝒜]
    (ρ₀ : ↥W →+* ↥(𝒜 0)) (ev : ∀ a : Fin L.m, S →+* Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)),
    (∀ (a : Fin L.m) (w : ↥W), ev a ((ρ₀ w : ↥(𝒜 0)) : S) =
      (u₁.appLE ⊤ (L.V a ⊓ u₁ ⁻¹ᵁ ⊤) inf_le_right).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w)) →
    ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥W)) (x : S) (k : ℕ) (hx : x ∈ 𝒜 k),
    0 < k →
    ∀ (n N : ℕ) (b : Fin N → S) (hb : ∀ j, b j ∈ 𝒜 (n • k)),
    (∀ γ ∈ 𝒜 (n • k), ∃ w : Fin N → ↥W, γ = ∑ j, ((ρ₀ (w j) : ↥(𝒜 0)) : S) * b j) →
    ∀ (M : ℕ) (γ : Fin M → S) (hγ : ∀ i, γ i ∈ 𝒜 (n • k)) (c : Fin M → K),
    ∃ e : Fin N → K,
      (∑ i, ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s).app
          (Proj.basicOpen 𝒜 x)).hom
          ((Proj.awayToSection 𝒜 x).hom (HomogeneousLocalization.Away.mk 𝒜 hx n (γ i) (hγ i))) *
        wcpaLccScal (Limits.pullback.snd (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s)
          ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s) ⁻¹ᵁ
            Proj.basicOpen 𝒜 x) (c i) =
      ∑ j, ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s).app
          (Proj.basicOpen 𝒜 x)).hom
          ((Proj.awayToSection 𝒜 x).hom (HomogeneousLocalization.Away.mk 𝒜 hx n (b j) (hb j))) *
        wcpaLccScal (Limits.pullback.snd (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s)
          ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s) ⁻¹ᵁ
            Proj.basicOpen 𝒜 x) (e j)) ∧
      ∀ a, ∑ i, wcpaLccScal (Limits.pullback.snd u₁ s) _ (c i) *
          wcpaLccPullFam u₁ L s (fun a => ev a (γ i)) a =
        ∑ j, wcpaLccScal (Limits.pullback.snd u₁ s) _ (e j) *
          wcpaLccPullFam u₁ L s (fun a => ev a (b j)) a :=
by
  intro Ω _ W Z₁ u₁ L S _ 𝒜 _ ρ₀ ev hO2 K _ s x k hx hk n N b hb hspan M γ hγ c

  have s1 : ∀ {P : Scheme.{u}} (p : P ⟶ Spec (.of ↥W)) (U : P.Opens) (hU : U ≤ p ⁻¹ᵁ ⊤)
      (V : (Limits.pullback p s).Opens) (hV : V ≤ (Limits.pullback.fst p s) ⁻¹ᵁ U)
      (c0 : Γ(Spec (.of ↥W), ⊤)),
      ((Limits.pullback.fst p s).appLE U V hV).hom ((p.appLE ⊤ U hU).hom c0) =
        wcpaLccScal (Limits.pullback.snd p s) V
          ((Scheme.ΓSpecIso (.of K)).hom.hom (s.appTop.hom c0)) := by
    intro P p U hU V hV c0
    rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE]
    have key : ∀ (f g : Limits.pullback p s ⟶ Spec (.of ↥W)), f = g → ∀ e e',
        f.appLE ⊤ V e = g.appLE ⊤ V e' := by
      intro f g h e e'; subst h; rfl
    rw [key _ _ Limits.pullback.condition _ (by rw [Scheme.Hom.preimage_top]; exact le_top),
      Scheme.Hom.comp_appLE]
    have e : ∀ y, (Scheme.ΓSpecIso (.of K)).inv.hom ((Scheme.ΓSpecIso (.of K)).hom.hom y) = y :=
      fun y => Iso.hom_inv_id_apply _ y
    simp only [wcpaLccScal, CommRingCat.hom_comp, RingHom.comp_apply, e]
    rfl

  have s2 : ∀ a0 : ↥(𝒜 0), (Proj.awayToSection 𝒜 x).hom
      (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers x) a0) =
      ((Proj.toSpecZero 𝒜).appLE ⊤ (Proj.basicOpen 𝒜 x) le_top).hom
        ((Scheme.ΓSpecIso (.of ↥(𝒜 0))).inv.hom a0) := by
    intro a0
    have h1 : (Proj.basicOpen 𝒜 x).ι ≫ Proj.toSpecZero 𝒜 =
        (Proj.basicOpenIsoSpec 𝒜 x hx hk).hom ≫ Spec.map (CommRingCat.ofHom
          (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers x))) := by
      rw [← Proj.awayι_toSpecZero 𝒜 x hx hk, Proj.awayι, Category.assoc, Iso.hom_inv_id_assoc]
    have h2 := congrArg Scheme.Hom.appTop h1
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop, Proj.basicOpenIsoSpec_hom,
      Scheme.Hom.appTop.eq_1 (Proj.basicOpenToSpec 𝒜 x), Proj.basicOpenToSpec_app_top] at h2
    have h3 := congrArg (fun φ => (Scheme.ΓSpecIso (.of (𝒜 0))).inv ≫ φ ≫
      (Proj.basicOpen 𝒜 x).topIso.hom) h2
    simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id] at h3
    rw [← Scheme.ΓSpecIso_inv_naturality_assoc, Iso.inv_hom_id_assoc] at h3
    have h5 : Scheme.Hom.appTop (Proj.basicOpen 𝒜 x).ι ≫ (Proj.basicOpen 𝒜 x).topIso.hom =
        (Proj 𝒜).presheaf.map (homOfLE (le_top : Proj.basicOpen 𝒜 x ≤ ⊤)).op := by
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_hom]
      erw [← Functor.map_comp]
      rfl
    show (CommRingCat.ofHom (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers x)) ≫
      Proj.awayToSection 𝒜 x).hom a0 = _
    rw [← h3, h5]
    rfl

  have s4' : ∀ w0 : ↥W,
      ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s).app
          (Proj.basicOpen 𝒜 x)).hom ((Proj.awayToSection 𝒜 x).hom
            (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers x) (ρ₀ w0))) =
        wcpaLccScal (Limits.pullback.snd (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s)
          ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s) ⁻¹ᵁ
            Proj.basicOpen 𝒜 x)
          ((Scheme.ΓSpecIso (.of K)).hom.hom (s.appTop.hom
            ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w0))) := by
    intro w0
    rw [s2]
    have e1 : (Scheme.ΓSpecIso (.of ↥(𝒜 0))).inv.hom (ρ₀ w0) =
        (Spec.map (CommRingCat.ofHom ρ₀)).appTop.hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom w0) := by
      have := congrArg (fun φ => φ.hom w0) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ρ₀))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      exact this
    rw [e1]
    have e2 : (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)).appLE ⊤ (Proj.basicOpen 𝒜 x)
          le_top =
        (Spec.map (CommRingCat.ofHom ρ₀)).appTop ≫
          (Proj.toSpecZero 𝒜).appLE ⊤ (Proj.basicOpen 𝒜 x) le_top :=
      Scheme.Hom.comp_appLE _ _ _ _ _
    have e3 : ∀ y, ((Proj.toSpecZero 𝒜).appLE ⊤ (Proj.basicOpen 𝒜 x) le_top).hom
        ((Spec.map (CommRingCat.ofHom ρ₀)).appTop.hom y) =
        ((Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)).appLE ⊤ (Proj.basicOpen 𝒜 x)
          le_top).hom y := by
      intro y; rw [e2]; rfl
    rw [e3, Scheme.Hom.app_eq_appLE]
    exact s1 _ _ _ _ _ _

  choose w hw using fun i => hspan (γ i) (hγ i)

  have hmk : ∀ i, HomogeneousLocalization.Away.mk 𝒜 hx n (γ i) (hγ i) =
      ∑ j, HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers x) (ρ₀ (w i j)) *
        HomogeneousLocalization.Away.mk 𝒜 hx n (b j) (hb j) := by
    intro i
    apply HomogeneousLocalization.val_injective
    have e2 : ∀ (g : Fin N → HomogeneousLocalization.Away 𝒜 x),
        (∑ j, g j).val = ∑ j, (g j).val := by
      intro g
      have := map_sum (algebraMap (HomogeneousLocalization.Away 𝒜 x)
        (Localization (Submonoid.powers x))) g Finset.univ
      simpa only [HomogeneousLocalization.algebraMap_apply] using this
    have e3 : ∀ b' : 𝒜 0, (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers x) b').val
        = Localization.mk (b' : S) 1 := fun b' => rfl
    rw [e2, HomogeneousLocalization.Away.val_mk, hw i, Localization.mk_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [HomogeneousLocalization.val_mul, e3, HomogeneousLocalization.Away.val_mk,
      Localization.mk_mul, one_mul]
  have hP : ∀ i,
      ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s).app
          (Proj.basicOpen 𝒜 x)).hom
          ((Proj.awayToSection 𝒜 x).hom (HomogeneousLocalization.Away.mk 𝒜 hx n (γ i) (hγ i))) =
      ∑ j, wcpaLccScal (Limits.pullback.snd (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s)
          ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s) ⁻¹ᵁ
            Proj.basicOpen 𝒜 x)
          ((Scheme.ΓSpecIso (.of K)).hom.hom (s.appTop.hom
            ((Scheme.ΓSpecIso (.of ↥W)).inv.hom (w i j)))) *
        ((Limits.pullback.fst (Proj.toSpecZero 𝒜 ≫ Spec.map (CommRingCat.ofHom ρ₀)) s).app
          (Proj.basicOpen 𝒜 x)).hom
          ((Proj.awayToSection 𝒜 x).hom (HomogeneousLocalization.Away.mk 𝒜 hx n (b j) (hb j))) := by
    intro i
    rw [hmk i, map_sum, map_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_mul, map_mul, s4' (w i j)]
  have hQ : ∀ a i, wcpaLccPullFam u₁ L s (fun a => ev a (γ i)) a =
      ∑ j, wcpaLccScal (Limits.pullback.snd u₁ s) _
          ((Scheme.ΓSpecIso (.of K)).hom.hom (s.appTop.hom
            ((Scheme.ΓSpecIso (.of ↥W)).inv.hom (w i j)))) *
        wcpaLccPullFam u₁ L s (fun a => ev a (b j)) a := by
    intro a i
    simp only [wcpaLccPullFam, hw i, map_sum, map_mul, hO2]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    exact congrArg (· * _) (s1 u₁ _ inf_le_right _ _ _)
  refine ⟨fun j => ∑ i, c i * (Scheme.ΓSpecIso (.of K)).hom.hom (s.appTop.hom
      ((Scheme.ΓSpecIso (.of ↥W)).inv.hom (w i j))), ?_, ?_⟩
  · simp only [hP, map_sum, map_mul, Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun i _ => by ring))
  · intro a
    simp only [hQ a, map_sum, map_mul, Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun i _ => by ring))

theorem wcpa_dj_lcc_fp_fibre_chart_bij (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (r : ℕ)
    (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)) (L : wcpaDjCoc Z₁)
    (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) (m : ℕ)
    (hSH : wcpaLccSH W u₁ ε L t m) (D : wcpaLccSRD W u₁ L) (hD : wcpaLccSRDOK D m) :
    letI := D.cr; letI := D.gr;
    ∀ (φ : Z₁ ⟶ Proj D.𝒜) (hφ : wcpaLccChart D φ)
    (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥W))
    (φs : Limits.pullback u₁ s ⟶ Limits.pullback (wcpaLccUU D) s)
    (h1 : φs ≫ Limits.pullback.fst (wcpaLccUU D) s = Limits.pullback.fst u₁ s ≫ φ)
    (h2 : φs ≫ Limits.pullback.snd (wcpaLccUU D) s = Limits.pullback.snd u₁ s)
    (k : ℕ) (hk : 1 ≤ k) (x : D.S) (hx : x ∈ D.𝒜 k),
    Function.Bijective
      (φs.app ((Limits.pullback.fst (wcpaLccUU D) s) ⁻¹ᵁ Proj.basicOpen D.𝒜 x)).hom :=
by
  letI : CommRing D.S := D.cr
  letI : GradedRing D.𝒜 := D.gr
  intro φ hφ K _ s
  rw [show wcpaLccUU D = Proj.toSpecZero D.𝒜 ≫ Spec.map (CommRingCat.ofHom D.ρ₀) from rfl]
  intro φs h1 h2 k hk x hx
  classical
  have hpu : IsProper u₁ := hSH.1.2.1
  have hOK : wcpaDjCocOK L := hSH.2.2.1
  have hBC : ∀ k', 1 ≤ k' → wcpaLccBC u₁ L (m * k') := hSH.2.2.2.2.2.2.2.1
  obtain ⟨_hO1, hO2, hO3, hO4, _hO5, _hO6, _hO7, _hO8⟩ := hD
  obtain ⟨hOKs, _hcpt, hqs, hcompat, hbo⟩ := wcpa_dj_lcc_fp_pull_basics u₁ L s hpu hOK
  haveI := hqs
  have hk0 : 0 < k := by omega

  have haff : ∀ a, IsAffineOpen ((wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓
      (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤) := by
    intro a
    rw [Scheme.Hom.preimage_top, inf_top_eq]
    exact hOKs.1 a

  have hcpt : ∀ a b, IsCompact (((wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓
      (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V b ⊓ (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤ :
        (Limits.pullback u₁ s).Opens) : Set ↥(Limits.pullback u₁ s)) := by
    intro a b
    rw [Scheme.Hom.preimage_top, inf_top_eq]
    exact QuasiSeparatedSpace.inter_isCompact _ _
      ((wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a).isOpen (hOKs.1 a).isCompact
      ((wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V b).isOpen (hOKs.1 b).isCompact

  have hg := hcompat (m * k) _ (hO3 k hk x hx)

  have hΦ : φs ⁻¹ᵁ ((Limits.pullback.fst (Proj.toSpecZero D.𝒜 ≫
      Spec.map (CommRingCat.ofHom D.ρ₀)) s) ⁻¹ᵁ Proj.basicOpen D.𝒜 x) =
      ⨆ a, (Limits.pullback u₁ s).basicOpen (wcpaLccPullFam u₁ L s (fun a => D.ev a x) a) := by
    rw [← Scheme.Hom.comp_preimage, h1, Scheme.Hom.comp_preimage, hφ.2.1 k hk x hx,
      Scheme.Hom.preimage_iSup]
    exact iSup_congr fun a => (hbo (fun a => D.ev a x) a).symm
  have hle : ∀ a, (Limits.pullback u₁ s).basicOpen (wcpaLccPullFam u₁ L s (fun a => D.ev a x) a) ≤
