theorem wcpa_dj_lmfg_chart_ring : ∀ (Ω : Type u) [Field Ω] (W W' : ValuationSubring Ω)
    (Wb : ValuationSubring (IsLocalRing.ResidueField ↥W')) (hle : W ≤ W') (πb : ↥W →+* ↥Wb),
    Function.Surjective πb →
    (∀ w : ↥W, algebraMap ↥Wb (IsLocalRing.ResidueField ↥W') (πb w) =
      algebraMap ↥W' (IsLocalRing.ResidueField ↥W') (ValuationSubring.inclusion W W' hle w)) →
    IsPullback (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)) (CommRingCat.ofHom πb)
      (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))
      (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W'))) →
    ∀ (A' Ab B P : CommRingCat.{u}) (α' : CommRingCat.of ↥W' ⟶ A') (ᾱ : CommRingCat.of ↥Wb ⟶ Ab)
      (r : A' ⟶ B) (e₀ : Ab ⟶ B) (β : CommRingCat.of (IsLocalRing.ResidueField ↥W') ⟶ B)
      (pA : P ⟶ A') (pB : P ⟶ Ab) (γ : CommRingCat.of ↥W ⟶ P),
      IsPushout α' (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))) r β →
      IsPushout ᾱ (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W'))) e₀ β →
      RingHom.Flat α'.hom → RingHom.Flat ᾱ.hom →
      RingHom.FiniteType α'.hom → RingHom.FiniteType ᾱ.hom →
      IsPullback pA pB r e₀ →
      γ ≫ pA = CommRingCat.ofHom (ValuationSubring.inclusion W W' hle) ≫ α' →
      γ ≫ pB = CommRingCat.ofHom πb ≫ ᾱ →
      RingHom.Flat γ.hom ∧ RingHom.FiniteType γ.hom :=
by

  have S0 : ∀ {P A B C : CommRingCat.{u}} (pA : P ⟶ A) (pB : P ⟶ C) (r : A ⟶ B) (e : C ⟶ B),
      IsPullback pA pB r e →
      (∀ x y : P, pA.hom x = pA.hom y → pB.hom x = pB.hom y → x = y) ∧
      (∀ a b, r.hom a = e.hom b → ∃ x : P, pA.hom x = a ∧ pB.hom x = b) ∧
      (∀ x, r.hom (pA.hom x) = e.hom (pB.hom x)) := by
    intro P A B C pA pB r e h
    have h' := (forget CommRingCat).map_isPullback h
    rw [Limits.Types.isPullback_iff] at h'
    obtain ⟨_, hinj, hex⟩ := h'
    refine ⟨fun x y h1 h2 => hinj x y ⟨h1, h2⟩, fun a b hab => hex a b hab, fun x => ?_⟩
    have := congrArg (fun f => f.hom x) h.w
    simpa using this

  have S1 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (A B : CommRingCat.{u})
      (α : CommRingCat.of R ⟶ A) (r : A ⟶ B)
      (β : CommRingCat.of (IsLocalRing.ResidueField R) ⟶ B),
      IsPushout α (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))) r β →
      Function.Surjective r.hom ∧
        ∀ a : A, r.hom a = 0 → a ∈ Ideal.map α.hom (IsLocalRing.maximalIdeal R) := by
    intro R _ _ A B α r β h
    set I := Ideal.map α.hom (IsLocalRing.maximalIdeal R) with hI
    have hC1 : ∀ x : R, r.hom (α.hom x) = β.hom (IsLocalRing.residue R x) := by
      intro x
      have := congrArg (fun f => f.hom x) h.w
      simpa using this
    let qb : IsLocalRing.ResidueField R →+* A ⧸ I :=
      Ideal.quotientMap I α.hom Ideal.le_comap_map
    have hqb : ∀ x : R, qb (IsLocalRing.residue R x) = Ideal.Quotient.mk I (α.hom x) := fun x =>
      Ideal.quotientMap_mk
    have hw : α ≫ CommRingCat.ofHom (Ideal.Quotient.mk I) =
        CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)) ≫ CommRingCat.ofHom qb := by
      ext x
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
        IsLocalRing.ResidueField.algebraMap_eq]
      rw [hqb]
    let φ := h.desc (CommRingCat.ofHom (Ideal.Quotient.mk I)) (CommRingCat.ofHom qb) hw
    have hφ1 : r ≫ φ = CommRingCat.ofHom (Ideal.Quotient.mk I) := h.inl_desc _ _ _
    have hφ2 : β ≫ φ = CommRingCat.ofHom qb := h.inr_desc _ _ _
    have hφ1' : ∀ a, φ.hom (r.hom a) = Ideal.Quotient.mk I a := fun a => by
      have := congrArg (fun f => f.hom a) hφ1
      simpa using this
    have hrI : I ≤ RingHom.ker r.hom := by
      rw [hI, Ideal.map_le_iff_le_comap]
      intro m hm
      rw [Ideal.mem_comap, RingHom.mem_ker, hC1, (IsLocalRing.residue_eq_zero_iff m).mpr hm,
        map_zero]
    let ψ : A ⧸ I →+* B := Ideal.Quotient.lift I r.hom (fun a ha => hrI ha)
    have hψ : ∀ a, ψ (Ideal.Quotient.mk I a) = r.hom a := fun a => Ideal.Quotient.lift_mk _ _ _
    have hφψ : φ ≫ CommRingCat.ofHom ψ = 𝟙 B := by
      apply h.hom_ext
      · rw [← Category.assoc, hφ1, Category.comp_id]
        ext a
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
        exact hψ a
      · rw [← Category.assoc, hφ2, Category.comp_id]
        ext y
        obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
        rw [hqb, hψ, hC1]
    have hψφ : ∀ b, ψ (φ.hom b) = b := fun b => by
      have := congrArg (fun f => f.hom b) hφψ
      simpa using this
    refine ⟨fun b => ?_, fun a ha => ?_⟩
    · obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (φ.hom b)
      refine ⟨a, ?_⟩
      rw [← hψφ b, ← ha, hψ]
    · have : Ideal.Quotient.mk I a = 0 := by
        rw [← hφ1', ha, map_zero]
      exact Ideal.Quotient.eq_zero_iff_mem.mp this

  have S2 : ∀ (R K : Type u) [CommRing R] [IsDomain R] [Field K] [Algebra R K]
      [IsFractionRing R K] (A B : CommRingCat.{u}) (α : CommRingCat.of R ⟶ A) (e : A ⟶ B)
      (β : CommRingCat.of K ⟶ B),
      IsPushout α (CommRingCat.ofHom (algebraMap R K)) e β →
      (∀ b : B, ∃ (t : R) (a : A), t ≠ 0 ∧ β.hom (algebraMap R K t) * b = e.hom a) ∧
      ∀ a : A, e.hom a = 0 → ∃ t : R, t ≠ 0 ∧ α.hom t * a = 0 := by
    intro R K _ _ _ _ _ A B α e β h
    have hC : ∀ x : R, e.hom (α.hom x) = β.hom (algebraMap R K x) := by
      intro x
      have := congrArg (fun f => f.hom x) h.w
      simpa using this
    set M : Submonoid A := Submonoid.map α.hom (nonZeroDivisors R) with hM
    let L := Localization M
    let lam : A →+* L := algebraMap A L
    have hg : ∀ y : nonZeroDivisors R, IsUnit ((lam.comp α.hom) y) := by
      intro y
      exact IsLocalization.map_units L (⟨α.hom y, ⟨y, y.2, rfl⟩⟩ : M)
    let μ : K →+* L := IsLocalization.lift (M := nonZeroDivisors R) (S := K) hg
    have hμ : ∀ x : R, μ (algebraMap R K x) = lam (α.hom x) := fun x =>
      IsLocalization.lift_eq hg x
    have hw : α ≫ CommRingCat.ofHom lam =
        CommRingCat.ofHom (algebraMap R K) ≫ CommRingCat.ofHom μ := by
      ext x
      simp [hμ]
    let φ := h.desc (CommRingCat.ofHom lam) (CommRingCat.ofHom μ) hw
    have hφ1 : e ≫ φ = CommRingCat.ofHom lam := h.inl_desc _ _ _
    have hφ2 : β ≫ φ = CommRingCat.ofHom μ := h.inr_desc _ _ _
    have hφ1' : ∀ a, φ.hom (e.hom a) = lam a := fun a => by
      have := congrArg (fun f => f.hom a) hφ1
      simpa using this
    have hne : ∀ t ∈ nonZeroDivisors R, algebraMap R K t ≠ 0 := fun t ht =>
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors ht
    have hunits : ∀ y : M, IsUnit (e.hom y) := by
      rintro ⟨m, hm⟩
      obtain ⟨t, ht, rfl⟩ := hm
      show IsUnit (e.hom (α.hom t))
      rw [hC]
      exact (isUnit_iff_ne_zero.mpr (hne t ht)).map β.hom
    let ψ : L →+* B := IsLocalization.lift (M := M) (S := L) hunits
    have hψ : ∀ a, ψ (lam a) = e.hom a := fun a => IsLocalization.lift_eq hunits a
    have hφψ : φ ≫ CommRingCat.ofHom ψ = 𝟙 B := by
      apply h.hom_ext
      · rw [← Category.assoc, hφ1, Category.comp_id]
        ext a
        simp [hψ]
      · rw [← Category.assoc, hφ2, Category.comp_id]
        ext y
        show ψ (μ y) = β.hom y
        have : (ψ.comp μ) = β.hom := by
          apply IsLocalization.ringHom_ext (nonZeroDivisors R)
          ext x
          simp [hμ, hψ, hC]
        exact congrArg (fun f => f y) this
    have hψφ : ∀ b, ψ (φ.hom b) = b := fun b => by
      have := congrArg (fun f => f.hom b) hφψ
      simpa using this
    refine ⟨fun b => ?_, fun a ha => ?_⟩
    · obtain ⟨⟨a, m⟩, hmk⟩ := IsLocalization.mk'_surjective M (φ.hom b)
      obtain ⟨t, ht, hteq⟩ := m.2
      refine ⟨t, a, nonZeroDivisors.ne_zero ht, ?_⟩
      have hmk' : IsLocalization.mk' L a m = φ.hom b := hmk
      have hspec := IsLocalization.mk'_spec L a m
      rw [hmk'] at hspec
      have := congrArg ψ hspec
      rw [map_mul, hψφ, hψ, hψ, ← hteq] at this
      rw [← hC, mul_comm]
      exact this
    · have h0 : lam a = 0 := by rw [← hφ1', ha, map_zero]
      obtain ⟨⟨m, hm⟩, hma⟩ := (IsLocalization.map_eq_zero_iff M L a).mp h0
      obtain ⟨t, ht, rfl⟩ := hm
      exact ⟨t, nonZeroDivisors.ne_zero ht, hma⟩

  have S3 : ∀ (R R1 R2 : Type u) [CommRing R] [IsDomain R] [IsBezout R] [CommRing R1]
      [IsDomain R1] [CommRing R2] [IsDomain R2] (A1 A2 B P : CommRingCat.{u}) (f1 : R →+* R1)
      (α1 : CommRingCat.of R1 ⟶ A1) (α2 : CommRingCat.of R2 ⟶ A2) (r : A1 ⟶ B) (e : A2 ⟶ B)
      (p1 : P ⟶ A1) (p2 : P ⟶ A2) (γ : CommRingCat.of R ⟶ P),
      Function.Injective f1 → RingHom.Flat α1.hom → RingHom.Flat α2.hom →
      (∀ a : A2, e.hom a = 0 → ∃ t : R2, t ≠ 0 ∧ α2.hom t * a = 0) →
      (∀ x : P, p1.hom x = 0 → p2.hom x = 0 → x = 0) →
      (∀ x : P, r.hom (p1.hom x) = e.hom (p2.hom x)) →
      γ ≫ p1 = CommRingCat.ofHom f1 ≫ α1 → RingHom.Flat γ.hom := by
    intro R R1 R2 _ _ _ _ _ _ _ A1 A2 B P f1 α1 α2 r e p1 p2 γ hf1 hfl1 hfl2 hL2 hP1 hP3 h6
    have reg : ∀ (S : Type u) [CommRing S] [IsDomain S] (A : CommRingCat.{u})
        (α : CommRingCat.of S ⟶ A), RingHom.Flat α.hom → ∀ (t : S) (y : A), t ≠ 0 →
        α.hom t * y = 0 → y = 0 := by
      intro S _ _ A α hfl t y ht hy
      letI := α.hom.toAlgebra
      haveI : Module.Flat S A := hfl
      have hreg : IsSMulRegular A t :=
        Module.Flat.isSMulRegular_of_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero ht)
      apply hreg
      show t • y = t • (0 : A)
      rw [smul_zero, Algebra.smul_def, RingHom.algebraMap_toAlgebra]
      exact hy
    have h6' : ∀ w : R, p1.hom (γ.hom w) = α1.hom (f1 w) := fun w => by
      have := congrArg (fun f => f.hom w) h6
      simpa using this
    letI := γ.hom.toAlgebra
    show Module.Flat R P
    rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, Submodule.eq_bot_iff]
    intro x hx
    obtain ⟨a, hax⟩ := (Submodule.mem_torsion_iff x).mp hx
    have ha0 : (a : R) ≠ 0 := nonZeroDivisors.ne_zero a.2
    have hax' : γ.hom a * x = 0 := by
      have h' : (a : R) • x = 0 := hax
      rw [Algebra.smul_def, RingHom.algebraMap_toAlgebra] at h'
      exact h'
    have hx1 : p1.hom x = 0 := by
      apply reg R1 A1 α1 hfl1 (f1 a) _ ((map_ne_zero_iff f1 hf1).mpr ha0)
      rw [← h6', ← map_mul, hax', map_zero]
    have hx2 : p2.hom x = 0 := by
      have he : e.hom (p2.hom x) = 0 := by rw [← hP3, hx1, map_zero]
      obtain ⟨t, ht, htx⟩ := hL2 _ he
      exact reg R2 A2 α2 hfl2 t _ ht htx
    exact hP1 x hx1 hx2

  have S4 : ∀ (Ω : Type u) [Field Ω] (W W' : ValuationSubring Ω)
      (Wb : ValuationSubring (IsLocalRing.ResidueField ↥W')) (hle : W ≤ W') (πb : ↥W →+* ↥Wb),
      Function.Surjective πb →
      (∀ w : ↥W, algebraMap ↥Wb (IsLocalRing.ResidueField ↥W') (πb w) =
        algebraMap ↥W' (IsLocalRing.ResidueField ↥W') (ValuationSubring.inclusion W W' hle w)) →
      (∀ m : ↥W', m ∈ IsLocalRing.maximalIdeal ↥W' →
        ∃ p : ↥W, ValuationSubring.inclusion W W' hle p = m ∧ πb p = 0) →
      ∀ (A' Ab B P : CommRingCat.{u}) (α' : CommRingCat.of ↥W' ⟶ A')
        (ᾱ : CommRingCat.of ↥Wb ⟶ Ab)
        (r : A' ⟶ B) (e₀ : Ab ⟶ B) (β : CommRingCat.of (IsLocalRing.ResidueField ↥W') ⟶ B)
        (pA : P ⟶ A') (pB : P ⟶ Ab) (γ : CommRingCat.of ↥W ⟶ P),
        RingHom.FiniteType α'.hom → RingHom.FiniteType ᾱ.hom →
        (∀ x : ↥W', r.hom (α'.hom x) = β.hom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W') x)) →
        Function.Surjective r.hom →
        (∀ a : A', r.hom a = 0 → a ∈ Ideal.map α'.hom (IsLocalRing.maximalIdeal ↥W')) →
        (∀ b : B, ∃ (t : ↥Wb) (a : Ab), t ≠ 0 ∧
          β.hom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W') t) * b = e₀.hom a) →
        (∀ x y : P, pA.hom x = pA.hom y → pB.hom x = pB.hom y → x = y) →
        (∀ (a : A') (b : Ab), r.hom a = e₀.hom b → ∃ x : P, pA.hom x = a ∧ pB.hom x = b) →
        (∀ x : P, r.hom (pA.hom x) = e₀.hom (pB.hom x)) →
        γ ≫ pA = CommRingCat.ofHom (ValuationSubring.inclusion W W' hle) ≫ α' →
        γ ≫ pB = CommRingCat.ofHom πb ≫ ᾱ →
        RingHom.FiniteType γ.hom := by
    intro Ω _ W W' Wb hle πb hs hc hM A' Ab B P α' ᾱ r e₀ β pA pB γ ftA ftB hC1 hS hK1 hL1 hP1
      hP2 hP3 h6 h7
    classical
    set ι := ValuationSubring.inclusion W W' hle with hι
    have h6' : ∀ w, pA.hom (γ.hom w) = α'.hom (ι w) := fun w => by
      have := congrArg (fun f => f.hom w) h6
      simpa using this
    have h7' : ∀ w, pB.hom (γ.hom w) = ᾱ.hom (πb w) := fun w => by
      have := congrArg (fun f => f.hom w) h7
      simpa using this

    have hU : ∀ s : W, πb s ≠ 0 → IsUnit (ι s) := by
      intro s hs0
      have h1 : algebraMap W' (IsLocalRing.ResidueField W') (ι s) ≠ 0 := by
        rw [← hc]
        intro h
        apply hs0
        exact IsFractionRing.injective Wb (IsLocalRing.ResidueField W')
          (h.trans (map_zero _).symm)
      by_contra hn
      apply h1
      rw [IsLocalRing.ResidueField.algebraMap_eq, IsLocalRing.residue_eq_zero_iff]
      exact hn

    have gA : ∀ c : A', ∃ (s : W) (y : P), IsUnit (ι s) ∧ pA.hom y = α'.hom (ι s) * c := by
      intro c
      obtain ⟨t, a, ht, hta⟩ := hL1 (r.hom c)
      obtain ⟨s, rfl⟩ := hs t
      have hr : r.hom (α'.hom (ι s) * c) = e₀.hom a := by
        rw [map_mul, hC1, ← hc, hta]
      obtain ⟨y, hy, -⟩ := hP2 _ _ hr
      exact ⟨s, y, hU s ht, hy⟩
    choose sA yA hsA hyA using gA

    have gB : ∀ b : Ab, ∃ x : P, pB.hom x = b := by
      intro b
      obtain ⟨a, ha⟩ := hS (e₀.hom b)
      obtain ⟨x, -, hx⟩ := hP2 a b ha
      exact ⟨x, hx⟩
    choose xB hxB using gB
    letI : Algebra W' A' := α'.hom.toAlgebra
    letI : Algebra Wb Ab := ᾱ.hom.toAlgebra
    letI : Algebra W P := γ.hom.toAlgebra
    obtain ⟨CA, hCA⟩ := (ftA : Algebra.FiniteType W' A').out
    obtain ⟨CB, hCB⟩ := (ftB : Algebra.FiniteType Wb Ab).out
    set G : Finset P := CB.image xB ∪ CA.image yA with hG
    set Q : Subalgebra W P := Algebra.adjoin W (G : Set P) with hQ
    have hγQ : ∀ w : W, γ.hom w ∈ Q := fun w => Q.algebraMap_mem w

    have good : ∀ a : A', ∃ s : W, IsUnit (ι s) ∧ ∃ q ∈ Q, pA.hom q = α'.hom (ι s) * a := by
      intro a
      have ha : a ∈ Algebra.adjoin W' (CA : Set A') := by rw [hCA]; exact Algebra.mem_top
      induction ha using Algebra.adjoin_induction with
      | mem c hc =>
        refine ⟨sA c, hsA c, yA c, ?_, hyA c⟩
        apply Algebra.subset_adjoin
        rw [hG, Finset.coe_union]
        exact Or.inr (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hc))
      | algebraMap x =>
        show ∃ s : W, IsUnit (ι s) ∧ ∃ q ∈ Q, pA.hom q = α'.hom (ι s) * α'.hom x
        by_cases hx : (x : Ω) ∈ W
        · refine ⟨1, by rw [map_one]; exact isUnit_one, γ.hom ⟨x, hx⟩, hγQ _, ?_⟩
          rw [h6', map_one, map_one, one_mul]
          rfl
        · have hxi := (ValuationSubring.mem_or_inv_mem W (x : Ω)).resolve_left hx
          have hx0 : (x : Ω) ≠ 0 := fun h => hx (h ▸ W.zero_mem)
          have hmul : ι ⟨(x : Ω)⁻¹, hxi⟩ * x = 1 := by
            apply Subtype.ext
            show (x : Ω)⁻¹ * (x : Ω) = 1
            exact inv_mul_cancel₀ hx0
          refine ⟨⟨(x : Ω)⁻¹, hxi⟩, ⟨⟨_, _, hmul, by rw [mul_comm]; exact hmul⟩, rfl⟩, 1,
            Q.one_mem, ?_⟩
          rw [map_one, ← map_mul, hmul, map_one]
      | add a b _ _ iha ihb =>
        obtain ⟨sa, hua, qa, hqa, hpa⟩ := iha
        obtain ⟨sb, hub, qb, hqb, hpb⟩ := ihb
        refine ⟨sa * sb, by rw [map_mul]; exact hua.mul hub,
          γ.hom sb * qa + γ.hom sa * qb,
          Q.add_mem (Q.mul_mem (hγQ _) hqa) (Q.mul_mem (hγQ _) hqb), ?_⟩
        rw [map_add, map_mul, map_mul, h6', h6', hpa, hpb, map_mul ι, map_mul α'.hom]
        ring
      | mul a b _ _ iha ihb =>
        obtain ⟨sa, hua, qa, hqa, hpa⟩ := iha
        obtain ⟨sb, hub, qb, hqb, hpb⟩ := ihb
        refine ⟨sa * sb, by rw [map_mul]; exact hua.mul hub, qa * qb, Q.mul_mem hqa hqb, ?_⟩
        rw [map_mul, hpa, hpb, map_mul ι, map_mul α'.hom]
        ring

    have ker : ∀ k ∈ Ideal.map α'.hom (IsLocalRing.maximalIdeal W'), ∀ u : W'ˣ,
        ∃ q ∈ Q, pA.hom q = α'.hom u * k ∧ pB.hom q = 0 := by
      intro k hk
      have hk' : k ∈ Submodule.span A' (⇑α'.hom '' (IsLocalRing.maximalIdeal W' : Set W')) := hk
      clear hk
      induction hk' using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨m, hm, rfl⟩ := hx
        intro u
        obtain ⟨p, hp, hp0⟩ := hM ((u : W') * m) (Ideal.mul_mem_left _ _ hm)
        refine ⟨γ.hom p, hγQ p, ?_, ?_⟩
        · rw [h6', hp, map_mul]
        · rw [h7', hp0, map_zero]
      | zero =>
        intro u
        exact ⟨0, Q.zero_mem, by rw [map_zero, mul_zero], map_zero _⟩
      | add x y _ _ hx hy =>
        intro u
        obtain ⟨qx, hqx, hpx, hbx⟩ := hx u
        obtain ⟨qy, hqy, hpy, hby⟩ := hy u
        refine ⟨qx + qy, Q.add_mem hqx hqy, ?_, ?_⟩
        · rw [map_add, hpx, hpy, mul_add]
        · rw [map_add, hbx, hby, add_zero]
      | smul a x _ hx =>
        intro u
        obtain ⟨s, hu, qa, hqa, hpa⟩ := good a
        obtain ⟨qk, hqk, hpk, hbk⟩ := hx (u * hu.unit⁻¹)
        refine ⟨qa * qk, Q.mul_mem hqa hqk, ?_, ?_⟩
        · have hunit : ι s * ((u * hu.unit⁻¹ : W'ˣ) : W') = u := by
            rw [Units.val_mul, mul_left_comm, hu.mul_val_inv, mul_one]
          rw [map_mul, hpa, hpk, smul_eq_mul, ← hunit, map_mul α'.hom]
          ring
        · rw [map_mul, hbk, mul_zero]

    have bside : ∀ b : Ab, ∃ q ∈ Q, pB.hom q = b := by
      intro b
      have hb : b ∈ Algebra.adjoin Wb (CB : Set Ab) := by rw [hCB]; exact Algebra.mem_top
      induction hb using Algebra.adjoin_induction with
      | mem c hc =>
        refine ⟨xB c, ?_, hxB c⟩
        apply Algebra.subset_adjoin
        rw [hG, Finset.coe_union]
        exact Or.inl (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hc))
      | algebraMap t =>
        obtain ⟨w, rfl⟩ := hs t
        exact ⟨γ.hom w, hγQ w, h7' w⟩
      | add a b _ _ iha ihb =>
        obtain ⟨qa, hqa, hpa⟩ := iha
        obtain ⟨qb, hqb, hpb⟩ := ihb
        exact ⟨qa + qb, Q.add_mem hqa hqb, by rw [map_add, hpa, hpb]⟩
      | mul a b _ _ iha ihb =>
        obtain ⟨qa, hqa, hpa⟩ := iha
        obtain ⟨qb, hqb, hpb⟩ := ihb
        exact ⟨qa * qb, Q.mul_mem hqa hqb, by rw [map_mul, hpa, hpb]⟩

    have top : Q = ⊤ := by
      rw [eq_top_iff]
      intro x _
      obtain ⟨q1, hq1, hpq1⟩ := bside (pB.hom x)
      have hk : r.hom (pA.hom (x - q1)) = 0 := by
        rw [hP3, map_sub, hpq1, sub_self, map_zero]
      obtain ⟨q2, hq2, hpq2, hbq2⟩ := ker _ (hK1 _ hk) 1
      have heq : x - q1 = q2 := by
        apply hP1
        · rw [hpq2, Units.val_one, map_one, one_mul]
        · rw [hbq2, map_sub, hpq1, sub_self]
      have : x = q1 + q2 := by rw [← heq]; ring
      rw [this]
      exact Q.add_mem hq1 hq2
    show Algebra.FiniteType W P
    exact ⟨⟨G, top⟩⟩

  intro Ω _ W W' Wb hle πb hsurj hcompat hpbR A' Ab B P α' ᾱ r e₀ β pA pB γ h1 h2 hfl1 hfl2
    hft1 hft2 h5 h6 h7
  obtain ⟨hP1, hP2, hP3⟩ := S0 pA pB r e₀ h5
  obtain ⟨-, hR2, -⟩ := S0 _ _ _ _ hpbR
  have hM : ∀ m : ↥W', m ∈ IsLocalRing.maximalIdeal ↥W' →
      ∃ p : ↥W, ValuationSubring.inclusion W W' hle p = m ∧ πb p = 0 := by
    intro m hm
    have hm0 : (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))).hom m =
        (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W'))).hom 0 := by
      rw [CommRingCat.hom_ofHom, CommRingCat.hom_ofHom, map_zero,
        IsLocalRing.ResidueField.algebraMap_eq, (IsLocalRing.residue_eq_zero_iff m).mpr hm]
    obtain ⟨p, hp1, hp2⟩ := hR2 m 0 hm0
    exact ⟨p, hp1, hp2⟩
  have hC1 : ∀ x : ↥W', r.hom (α'.hom x) =
      β.hom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W') x) := by
    intro x
    have := congrArg (fun f => f.hom x) h1.w
    simpa using this
  obtain ⟨hS, hK1⟩ := S1 ↥W' A' B α' r β h1
  obtain ⟨hL1, hL2⟩ := S2 ↥Wb (IsLocalRing.ResidueField ↥W') Ab B ᾱ e₀ β h2
  have hinj : Function.Injective (ValuationSubring.inclusion W W' hle) := by
    intro a b h
    have h' := congrArg Subtype.val h
    exact Subtype.ext h'
  refine ⟨?_, ?_⟩
  · exact S3 ↥W ↥W' ↥Wb A' Ab B P (ValuationSubring.inclusion W W' hle) α' ᾱ r e₀ pA pB γ
      hinj hfl1 hfl2 hL2
      (fun x hx1 hx2 => hP1 x 0 (by rw [hx1, map_zero]) (by rw [hx2, map_zero])) hP3 h6
  · exact S4 Ω W W' Wb hle πb hsurj hcompat hM A' Ab B P α' ᾱ r e₀ β pA pB γ hft1 hft2 hC1 hS
      hK1 hL1 hP1 hP2 hP3 h6 h7

theorem wcpa_dj_lmfg_fibre_chart : ∀ (A K : CommRingCat.{u}) (φ : A ⟶ K) (X F : Scheme.{u})
    (g : X ⟶ Spec A) (fst : F ⟶ X) (snd : F ⟶ Spec K), IsPullback fst snd g (Spec.map φ) →
    ∀ U : X.Opens, IsAffineOpen U → ∀ (V : F.Opens) (hV : fst ⁻¹ᵁ U = V),
      IsPushout ((Scheme.ΓSpecIso A).inv ≫ g.appLE ⊤ U (by simp)) φ (fst.appLE U V hV.ge)
        ((Scheme.ΓSpecIso K).inv ≫ snd.appLE ⊤ V (by simp)) :=
by
  intro A K φ X F g fst snd hpb U hU V hV
  subst hV
  have hUST : (⊤ : (Spec K).Opens) ≤ Spec.map φ ⁻¹ᵁ ⊤ := by simp
  have hUSX : U ≤ g ⁻¹ᵁ ⊤ := by simp
  have hUY : fst ⁻¹ᵁ U = fst ⁻¹ᵁ U ⊓ snd ⁻¹ᵁ ⊤ := by simp
  have hPB := Scheme.Hom.isPullback_resLE hpb hUST hUSX hUY
  haveI : IsAffine U := hU
  haveI : IsAffine ((⊤ : (Spec A).Opens) : Scheme) := isAffineOpen_top (Spec A)
  haveI : IsAffine ((⊤ : (Spec K).Opens) : Scheme) := isAffineOpen_top (Spec K)
  have hPO := isPushout_appTop_of_isPullback hPB
  have s1 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U),
      (f.resLE U V e).appTop ≫ V.topIso.hom = U.topIso.hom ≫ f.appLE U V e := by
    intro X Y f U V e
    simp only [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, Scheme.Opens.topIso_hom]
    erw [Scheme.Hom.resLE_appLE, Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
  have hPO2 := IsPushout.of_iso hPO (⊤ : (Spec A).Opens).topIso U.topIso
    (⊤ : (Spec K).Opens).topIso (fst ⁻¹ᵁ U).topIso (s1 _ _ _ _) (s1 _ _ _ _)
    (s1 _ _ _ _) (s1 _ _ _ _)
  refine IsPushout.of_iso hPO2 (Scheme.ΓSpecIso A) (Iso.refl _) (Scheme.ΓSpecIso K)
    (Iso.refl _) ?_ ?_ ?_ ?_
  · rw [Iso.refl_hom, Category.comp_id, Iso.hom_inv_id_assoc]
  · have h4 : (Spec.map φ).appLE ⊤ ⊤ hUST = (Spec.map φ).appTop := Scheme.Hom.appLE_eq_app _
    rw [h4]
    exact Scheme.ΓSpecIso_naturality φ
  · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
  · rw [Iso.refl_hom, Category.comp_id, Iso.hom_inv_id_assoc]

theorem wcpa_dj_lmfg_separated_of_cover : ∀ {X S : Scheme.{u}} (f : X ⟶ S) [IsAffine S] (m : ℕ)
    (O : Fin m → X.Opens), (⨆ a, O a) = ⊤ → (∀ a b, IsAffineOpen (O a ⊓ O b)) →
    (∀ a b (z : Γ(X, O a ⊓ O b)), z ∈ Subring.closure
      (Set.range ⇑(X.presheaf.map (homOfLE (inf_le_left : O a ⊓ O b ≤ O a)).op).hom ∪
       Set.range ⇑(X.presheaf.map (homOfLE (inf_le_right : O a ⊓ O b ≤ O b)).op).hom)) →
    IsSeparated f :=
by
  intro X S f _ m O hO hOaff hcl
  have key : ∀ (U V : X.Opens), (∀ z : Γ(X, U ⊓ V), z ∈ Subring.closure
      (Set.range ⇑(X.presheaf.map (homOfLE (inf_le_left : U ⊓ V ≤ U)).op).hom ∪
       Set.range ⇑(X.presheaf.map (homOfLE (inf_le_right : U ⊓ V ≤ V)).op).hom)) →
      Function.Surjective ⇑(Limits.pullback.mapDesc U.ι V.ι f).appTop.hom := by
    intro U V hUV
    obtain ⟨e, hef, hes⟩ : ∃ e : (U ⊓ V).toScheme ≅ Limits.pullback U.ι V.ι,
        e.hom ≫ Limits.pullback.fst U.ι V.ι = X.homOfLE (inf_le_left : U ⊓ V ≤ U) ∧
        e.hom ≫ Limits.pullback.snd U.ι V.ι = X.homOfLE (inf_le_right : U ⊓ V ≤ V) :=
      ⟨_, IsPullback.isoPullback_hom_fst (isPullback_opens_inf U V),
        IsPullback.isoPullback_hom_snd (isPullback_opens_inf U V)⟩
    have hφ1 : Limits.pullback.mapDesc U.ι V.ι f ≫ Limits.pullback.fst (U.ι ≫ f) (V.ι ≫ f) =
        Limits.pullback.fst U.ι V.ι := by
      unfold Limits.pullback.mapDesc Limits.pullback.map
      rw [Limits.pullback.lift_fst, Category.comp_id]
    have hφ2 : Limits.pullback.mapDesc U.ι V.ι f ≫ Limits.pullback.snd (U.ι ≫ f) (V.ι ≫ f) =
        Limits.pullback.snd U.ι V.ι := by
      unfold Limits.pullback.mapDesc Limits.pullback.map
      rw [Limits.pullback.lift_snd, Category.comp_id]
    let R : Subring Γ(Limits.pullback U.ι V.ι, ⊤) :=
      (Limits.pullback.mapDesc U.ι V.ι f).appTop.hom.range
    have hfst : ∀ y, (Limits.pullback.fst U.ι V.ι).appTop y ∈ R := by
      intro y
      refine ⟨(Limits.pullback.fst (U.ι ≫ f) (V.ι ≫ f)).appTop y, ?_⟩
      show ((Limits.pullback.fst (U.ι ≫ f) (V.ι ≫ f)).appTop ≫
        (Limits.pullback.mapDesc U.ι V.ι f).appTop) y = _
      rw [← Scheme.Hom.comp_appTop, hφ1]
    have hsnd : ∀ y, (Limits.pullback.snd U.ι V.ι).appTop y ∈ R := by
      intro y
      refine ⟨(Limits.pullback.snd (U.ι ≫ f) (V.ι ≫ f)).appTop y, ?_⟩
      show ((Limits.pullback.snd (U.ι ≫ f) (V.ι ≫ f)).appTop ≫
        (Limits.pullback.mapDesc U.ι V.ι f).appTop) y = _
      rw [← Scheme.Hom.comp_appTop, hφ2]
    have hinv : ∀ w, e.inv.appTop (e.hom.appTop w) = w := by
      intro w
      rw [← CommRingCat.comp_apply, ← Scheme.Hom.comp_appTop, e.inv_hom_id, Scheme.Hom.id_appTop,
        CommRingCat.id_apply]
    have htop' : ∀ (W : X.Opens) (x), W.topIso.inv (W.topIso.hom x) = x := by
      intro W x
      rw [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply]
    have hsq1 : X.presheaf.map (homOfLE (inf_le_left : U ⊓ V ≤ U)).op =
        U.topIso.inv ≫ (X.homOfLE (inf_le_left : U ⊓ V ≤ U)).appTop ≫ (U ⊓ V).topIso.hom := by
      rw [Scheme.homOfLE_appTop, Scheme.Opens.topIso_hom, Scheme.Opens.topIso_inv]
      erw [← Functor.map_comp, ← Functor.map_comp]
      rfl
    have hsq2 : X.presheaf.map (homOfLE (inf_le_right : U ⊓ V ≤ V)).op =
        V.topIso.inv ≫ (X.homOfLE (inf_le_right : U ⊓ V ≤ V)).appTop ≫ (U ⊓ V).topIso.hom := by
      rw [Scheme.homOfLE_appTop, Scheme.Opens.topIso_hom, Scheme.Opens.topIso_inv]
      erw [← Functor.map_comp, ← Functor.map_comp]
      rfl
    let κ : Γ(X, U ⊓ V) →+* Γ(Limits.pullback U.ι V.ι, ⊤) :=
      ((U ⊓ V).topIso.inv ≫ e.inv.appTop).hom
    have hκ : ∀ z, κ z = e.inv.appTop ((U ⊓ V).topIso.inv z) := fun z => rfl
    have hle : Subring.closure
        (Set.range ⇑(X.presheaf.map (homOfLE (inf_le_left : U ⊓ V ≤ U)).op).hom ∪
         Set.range ⇑(X.presheaf.map (homOfLE (inf_le_right : U ⊓ V ≤ V)).op).hom) ≤ R.comap κ := by
      rw [Subring.closure_le]
      rintro _ (⟨x, rfl⟩ | ⟨x, rfl⟩)
      · show κ _ ∈ R
        have h1 : (X.presheaf.map (homOfLE (inf_le_left : U ⊓ V ≤ U)).op).hom x =
            (U ⊓ V).topIso.hom ((X.homOfLE (inf_le_left : U ⊓ V ≤ U)).appTop (U.topIso.inv x)) := by
          rw [hsq1]; rfl
        rw [hκ, h1, htop', ← hef, Scheme.Hom.comp_appTop, CommRingCat.comp_apply, hinv]
        exact hfst _
      · show κ _ ∈ R
        have h1 : (X.presheaf.map (homOfLE (inf_le_right : U ⊓ V ≤ V)).op).hom x =
            (U ⊓ V).topIso.hom ((X.homOfLE (inf_le_right : U ⊓ V ≤ V)).appTop (V.topIso.inv x)) := by
          rw [hsq2]; rfl
        rw [hκ, h1, htop', ← hes, Scheme.Hom.comp_appTop, CommRingCat.comp_apply, hinv]
        exact hsnd _
    intro w
    have hz := hle (hUV ((U ⊓ V).topIso.hom (e.hom.appTop w)))
    have hw : κ ((U ⊓ V).topIso.hom (e.hom.appTop w)) = w := by
      rw [hκ, htop', hinv]
    rw [Subring.mem_comap, hw] at hz
    exact hz
  have hO' : ∀ a, IsAffineOpen (O a) := fun a => by simpa only [inf_idem] using hOaff a a
  have hcov : TopologicalSpace.IsOpenCover O := TopologicalSpace.IsOpenCover.mk hO
  rw [IsSeparated.isSeparated_eq_diagonal_isClosedImmersion]
  refine (@HasAffineProperty.diagonal_iff @IsClosedImmersion _
    IsClosedImmersion.hasAffineProperty _ _ f _).mp ?_
  haveI : ∀ a, IsAffine ((X.openCoverOfIsOpenCover O hcov).X a) := fun a => hO' a
  refine @AffineTargetMorphismProperty.diagonal_of_openCover_source _
    (@HasAffineProperty.isLocal_affineProperty @IsClosedImmersion _
      IsClosedImmersion.hasAffineProperty) _ _ f
    (X.openCoverOfIsOpenCover O hcov) _ _ ?_
  intro a b
  refine ⟨?_, key (O a) (O b) (hcl a b)⟩
  haveI : IsAffine (O a ⊓ O b).toScheme := hOaff a b
  exact @IsAffine.of_isIso _ _ (isPullback_opens_inf (O a) (O b)).isoPullback.inv
    (Iso.isIso_inv _) this

theorem wcpa_dj_lmfg_local_milnor_lift : ∀ (R R1 R2 B : CommRingCat.{u}) (p1 : R ⟶ R1)
    (p2 : R ⟶ R2) (q1 : R1 ⟶ B) (q2 : R2 ⟶ B), IsPullback p1 p2 q1 q2 →
    Function.Surjective ⇑(ConcreteCategory.hom q1) → IsLocalRing R1 → IsLocalRing R2 →
    Nontrivial B → ∀ (Z : Scheme.{u}) (g1 : Spec R1 ⟶ Z) (g2 : Spec R2 ⟶ Z),
      Spec.map q1 ≫ g1 = Spec.map q2 ≫ g2 →
      ∃ t : Spec R ⟶ Z, Spec.map p1 ≫ t = g1 ∧ Spec.map p2 ≫ t = g2 :=
by
  intro R R1 R2 B p1 p2 q1 q2 hpb hq1 hR1 hR2 hB Z g1 g2 hg
  have s1 : ∀ (A : CommRingCat.{u}) [IsLocalRing A] (g : Spec A ⟶ Z) (O : Z.Opens),
      g (IsLocalRing.closedPoint A) ∈ O → ∀ x : ↥(Spec A), g x ∈ O := by
    intro A _ g O hc x
    exact ((IsLocalRing.specializes_closedPoint x).map g.continuous).mem_open O.isOpen hc
  obtain ⟨𝔫, h𝔫⟩ := Ideal.exists_maximal B
  let y : Spec B := ⟨𝔫, h𝔫.isPrime⟩
  have hy : Spec.map q1 y = IsLocalRing.closedPoint R1 := by
    apply PrimeSpectrum.ext
    rw [Spec.map_apply, PrimeSpectrum.comap_asIdeal]
    haveI := h𝔫
    have := Ideal.comap_isMaximal_of_surjective q1.hom hq1 (K := 𝔫)
    exact IsLocalRing.eq_maximalIdeal this
  obtain ⟨O, hO, hcO, -⟩ :=
    (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens Z))
      (show g2 (IsLocalRing.closedPoint R2) ∈ (⊤ : Z.Opens) from trivial)
  have h2 : Set.range g2 ⊆ (O : Set Z) := by
    rintro _ ⟨x, rfl⟩
    exact s1 R2 g2 O hcO x
  have hc1 : g1 (IsLocalRing.closedPoint R1) ∈ O := by
    rw [← hy, ← Scheme.Hom.comp_apply, hg, Scheme.Hom.comp_apply]
    exact s1 R2 g2 O hcO _
  have h1 : Set.range g1 ⊆ (O : Set Z) := by
    rintro _ ⟨x, rfl⟩
    exact s1 R1 g1 O hc1 x
  have hO' : IsAffineOpen O := hO
  have hr1 : Set.range g1 ⊆ Set.range hO'.fromSpec := by
    rw [IsAffineOpen.range_fromSpec]; exact h1
  have hr2 : Set.range g2 ⊆ Set.range hO'.fromSpec := by
    rw [IsAffineOpen.range_fromSpec]; exact h2
  have hl1 : IsOpenImmersion.lift hO'.fromSpec g1 hr1 ≫ hO'.fromSpec = g1 :=
    IsOpenImmersion.lift_fac _ _ _
  have hl2 : IsOpenImmersion.lift hO'.fromSpec g2 hr2 ≫ hO'.fromSpec = g2 :=
    IsOpenImmersion.lift_fac _ _ _
  have hcomp : Spec.preimage (IsOpenImmersion.lift hO'.fromSpec g1 hr1) ≫ q1 =
      Spec.preimage (IsOpenImmersion.lift hO'.fromSpec g2 hr2) ≫ q2 := by
    apply Spec.map_injective
    rw [Spec.map_comp, Spec.map_comp, Spec.map_preimage, Spec.map_preimage,
      ← cancel_mono hO'.fromSpec, Category.assoc, Category.assoc, hl1, hl2, hg]
  refine ⟨Spec.map (hpb.lift _ _ hcomp) ≫ hO'.fromSpec, ?_, ?_⟩
  · rw [← Category.assoc, ← Spec.map_comp, hpb.lift_fst, Spec.map_preimage, hl1]
  · rw [← Category.assoc, ← Spec.map_comp, hpb.lift_snd, Spec.map_preimage, hl2]

theorem wcpa_dj_lmfg_chart_basechange : ∀ (Ω : Type u) [Field Ω] (W W' : ValuationSubring Ω)
    (Wb : ValuationSubring (IsLocalRing.ResidueField ↥W')) (hle : W ≤ W') (πb : ↥W →+* ↥Wb),
    Function.Surjective πb →
    (∀ w : ↥W, algebraMap ↥Wb (IsLocalRing.ResidueField ↥W') (πb w) =
      algebraMap ↥W' (IsLocalRing.ResidueField ↥W') (ValuationSubring.inclusion W W' hle w)) →
    IsPullback (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)) (CommRingCat.ofHom πb)
      (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))
      (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W'))) →
    ∀ (A' Ab B P : CommRingCat.{u}) (α' : CommRingCat.of ↥W' ⟶ A') (ᾱ : CommRingCat.of ↥Wb ⟶ Ab)
      (r : A' ⟶ B) (e₀ : Ab ⟶ B) (β : CommRingCat.of (IsLocalRing.ResidueField ↥W') ⟶ B)
      (pA : P ⟶ A') (pB : P ⟶ Ab) (γ : CommRingCat.of ↥W ⟶ P),
      IsPushout α' (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))) r β →
      IsPushout ᾱ (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W'))) e₀ β →
      IsPullback pA pB r e₀ →
      γ ≫ pA = CommRingCat.ofHom (ValuationSubring.inclusion W W' hle) ≫ α' →
      γ ≫ pB = CommRingCat.ofHom πb ≫ ᾱ →
      IsPushout (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)) γ α' pA ∧
        IsPushout (CommRingCat.ofHom πb) γ ᾱ pB :=
by

  have S0 : ∀ {P A B C : CommRingCat.{u}} (pA : P ⟶ A) (pB : P ⟶ C) (r : A ⟶ B) (e : C ⟶ B),
      IsPullback pA pB r e →
      (∀ x y : P, pA.hom x = pA.hom y → pB.hom x = pB.hom y → x = y) ∧
      (∀ a b, r.hom a = e.hom b → ∃ x : P, pA.hom x = a ∧ pB.hom x = b) ∧
      (∀ x, r.hom (pA.hom x) = e.hom (pB.hom x)) := by
    intro P A B C pA pB r e h
    have h' := (forget CommRingCat).map_isPullback h
    rw [Limits.Types.isPullback_iff] at h'
    obtain ⟨_, hinj, hex⟩ := h'
    refine ⟨fun x y h1 h2 => hinj x y ⟨h1, h2⟩, fun a b hab => hex a b hab, fun x => ?_⟩
    have := congrArg (fun f => f.hom x) h.w
    simpa using this

  have S1 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (A B : CommRingCat.{u})
      (α : CommRingCat.of R ⟶ A) (r : A ⟶ B)
      (β : CommRingCat.of (IsLocalRing.ResidueField R) ⟶ B),
      IsPushout α (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))) r β →
      Function.Surjective r.hom ∧
        ∀ a : A, r.hom a = 0 → a ∈ Ideal.map α.hom (IsLocalRing.maximalIdeal R) := by
    intro R _ _ A B α r β h
    set I := Ideal.map α.hom (IsLocalRing.maximalIdeal R) with hI
    have hC1 : ∀ x : R, r.hom (α.hom x) = β.hom (IsLocalRing.residue R x) := by
      intro x
      have := congrArg (fun f => f.hom x) h.w
      simpa using this
    let qb : IsLocalRing.ResidueField R →+* A ⧸ I :=
      Ideal.quotientMap I α.hom Ideal.le_comap_map
    have hqb : ∀ x : R, qb (IsLocalRing.residue R x) = Ideal.Quotient.mk I (α.hom x) := fun x =>
      Ideal.quotientMap_mk
    have hw : α ≫ CommRingCat.ofHom (Ideal.Quotient.mk I) =
        CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)) ≫ CommRingCat.ofHom qb := by
      ext x
      simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply,
        IsLocalRing.ResidueField.algebraMap_eq]
      rw [hqb]
    let φ := h.desc (CommRingCat.ofHom (Ideal.Quotient.mk I)) (CommRingCat.ofHom qb) hw
    have hφ1 : r ≫ φ = CommRingCat.ofHom (Ideal.Quotient.mk I) := h.inl_desc _ _ _
    have hφ2 : β ≫ φ = CommRingCat.ofHom qb := h.inr_desc _ _ _
    have hφ1' : ∀ a, φ.hom (r.hom a) = Ideal.Quotient.mk I a := fun a => by
      have := congrArg (fun f => f.hom a) hφ1
      simpa using this
    have hrI : I ≤ RingHom.ker r.hom := by
      rw [hI, Ideal.map_le_iff_le_comap]
      intro m hm
      rw [Ideal.mem_comap, RingHom.mem_ker, hC1, (IsLocalRing.residue_eq_zero_iff m).mpr hm,
        map_zero]
    let ψ : A ⧸ I →+* B := Ideal.Quotient.lift I r.hom (fun a ha => hrI ha)
    have hψ : ∀ a, ψ (Ideal.Quotient.mk I a) = r.hom a := fun a => Ideal.Quotient.lift_mk _ _ _
    have hφψ : φ ≫ CommRingCat.ofHom ψ = 𝟙 B := by
      apply h.hom_ext
      · rw [← Category.assoc, hφ1, Category.comp_id]
        ext a
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
        exact hψ a
      · rw [← Category.assoc, hφ2, Category.comp_id]
        ext y
        obtain ⟨x, rfl⟩ := IsLocalRing.residue_surjective y
        simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.comp_apply]
        rw [hqb, hψ, hC1]
    have hψφ : ∀ b, ψ (φ.hom b) = b := fun b => by
      have := congrArg (fun f => f.hom b) hφψ
      simpa using this
    refine ⟨fun b => ?_, fun a ha => ?_⟩
    · obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (φ.hom b)
      refine ⟨a, ?_⟩
      rw [← hψφ b, ← ha, hψ]
    · have : Ideal.Quotient.mk I a = 0 := by
        rw [← hφ1', ha, map_zero]
      exact Ideal.Quotient.eq_zero_iff_mem.mp this

  have S2 : ∀ (R K : Type u) [CommRing R] [IsDomain R] [Field K] [Algebra R K]
      [IsFractionRing R K] (A B : CommRingCat.{u}) (α : CommRingCat.of R ⟶ A) (e : A ⟶ B)
      (β : CommRingCat.of K ⟶ B),
      IsPushout α (CommRingCat.ofHom (algebraMap R K)) e β →
      (∀ b : B, ∃ (t : R) (a : A), t ≠ 0 ∧ β.hom (algebraMap R K t) * b = e.hom a) ∧
      ∀ a : A, e.hom a = 0 → ∃ t : R, t ≠ 0 ∧ α.hom t * a = 0 := by
    intro R K _ _ _ _ _ A B α e β h
    have hC : ∀ x : R, e.hom (α.hom x) = β.hom (algebraMap R K x) := by
      intro x
      have := congrArg (fun f => f.hom x) h.w
      simpa using this
    set M : Submonoid A := Submonoid.map α.hom (nonZeroDivisors R) with hM
    let L := Localization M
    let lam : A →+* L := algebraMap A L
    have hg : ∀ y : nonZeroDivisors R, IsUnit ((lam.comp α.hom) y) := by
      intro y
      exact IsLocalization.map_units L (⟨α.hom y, ⟨y, y.2, rfl⟩⟩ : M)
    let μ : K →+* L := IsLocalization.lift (M := nonZeroDivisors R) (S := K) hg
    have hμ : ∀ x : R, μ (algebraMap R K x) = lam (α.hom x) := fun x =>
      IsLocalization.lift_eq hg x
    have hw : α ≫ CommRingCat.ofHom lam =
        CommRingCat.ofHom (algebraMap R K) ≫ CommRingCat.ofHom μ := by
      ext x
      simp [hμ]
    let φ := h.desc (CommRingCat.ofHom lam) (CommRingCat.ofHom μ) hw
    have hφ1 : e ≫ φ = CommRingCat.ofHom lam := h.inl_desc _ _ _
    have hφ2 : β ≫ φ = CommRingCat.ofHom μ := h.inr_desc _ _ _
    have hφ1' : ∀ a, φ.hom (e.hom a) = lam a := fun a => by
      have := congrArg (fun f => f.hom a) hφ1
      simpa using this
    have hne : ∀ t ∈ nonZeroDivisors R, algebraMap R K t ≠ 0 := fun t ht =>
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors ht
    have hunits : ∀ y : M, IsUnit (e.hom y) := by
      rintro ⟨m, hm⟩
      obtain ⟨t, ht, rfl⟩ := hm
      show IsUnit (e.hom (α.hom t))
      rw [hC]
      exact (isUnit_iff_ne_zero.mpr (hne t ht)).map β.hom
    let ψ : L →+* B := IsLocalization.lift (M := M) (S := L) hunits
    have hψ : ∀ a, ψ (lam a) = e.hom a := fun a => IsLocalization.lift_eq hunits a
    have hφψ : φ ≫ CommRingCat.ofHom ψ = 𝟙 B := by
      apply h.hom_ext
      · rw [← Category.assoc, hφ1, Category.comp_id]
        ext a
        simp [hψ]
      · rw [← Category.assoc, hφ2, Category.comp_id]
        ext y
        show ψ (μ y) = β.hom y
        have : (ψ.comp μ) = β.hom := by
          apply IsLocalization.ringHom_ext (nonZeroDivisors R)
          ext x
          simp [hμ, hψ, hC]
        exact congrArg (fun f => f y) this
    have hψφ : ∀ b, ψ (φ.hom b) = b := fun b => by
      have := congrArg (fun f => f.hom b) hφψ
      simpa using this
    refine ⟨fun b => ?_, fun a ha => ?_⟩
    · obtain ⟨⟨a, m⟩, hmk⟩ := IsLocalization.mk'_surjective M (φ.hom b)
      obtain ⟨t, ht, hteq⟩ := m.2
      refine ⟨t, a, nonZeroDivisors.ne_zero ht, ?_⟩
      have hmk' : IsLocalization.mk' L a m = φ.hom b := hmk
      have hspec := IsLocalization.mk'_spec L a m
      rw [hmk'] at hspec
      have := congrArg ψ hspec
      rw [map_mul, hψφ, hψ, hψ, ← hteq] at this
      rw [← hC, mul_comm]
      exact this
    · have h0 : lam a = 0 := by rw [← hφ1', ha, map_zero]
      obtain ⟨⟨m, hm⟩, hma⟩ := (IsLocalization.map_eq_zero_iff M L a).mp h0
      obtain ⟨t, ht, rfl⟩ := hm
      exact ⟨t, nonZeroDivisors.ne_zero ht, hma⟩

  have S3 : ∀ (R R' P A : CommRingCat.{u}) (f : R ⟶ R') (g : R ⟶ P) (a : R' ⟶ A) (p : P ⟶ A),
      f ≫ a = g ≫ p →
      (∀ y : R', ∃ s t : R, IsUnit (f.hom s) ∧ f.hom s * y = f.hom t) →
      (∀ x : A, ∃ (s : R) (z : P), IsUnit (f.hom s) ∧ p.hom z = a.hom (f.hom s) * x) →
      (∀ z : P, p.hom z = 0 → ∃ s : R, IsUnit (f.hom s) ∧ g.hom s * z = 0) →
      IsPushout f g a p := by
    intro R R' P A f g a p sq hR' hA hK
    have sq' : ∀ x : R, a.hom (f.hom x) = p.hom (g.hom x) := fun x => by
      have := congrArg (fun h => h.hom x) sq
      simpa using this
    have cond : ∀ (c : Limits.PushoutCocone f g) (x : R),
        c.inl.hom (f.hom x) = c.inr.hom (g.hom x) := fun c x => by
      have := congrArg (fun h => h.hom x) c.condition
      simpa using this
    letI : Algebra P A := p.hom.toAlgebra
    let M : Submonoid P := Submonoid.map g.hom (Submonoid.comap f.hom (IsUnit.submonoid R'))
    have hMmem : ∀ m : M, ∃ s : R, IsUnit (f.hom s) ∧ g.hom s = m := by
      rintro ⟨m, hm⟩
      obtain ⟨s, hs, rfl⟩ := Submonoid.mem_map.mp hm
      exact ⟨s, (IsUnit.mem_submonoid_iff _).mp (Submonoid.mem_comap.mp hs), rfl⟩
    have mkM : ∀ s : R, IsUnit (f.hom s) → g.hom s ∈ M := fun s hs =>
      Submonoid.mem_map_of_mem _ (Submonoid.mem_comap.mpr ((IsUnit.mem_submonoid_iff _).mpr hs))
    have halg : ∀ z : P, algebraMap P A z = p.hom z := fun z => rfl
    haveI hloc : IsLocalization M A := by
      refine ⟨?_, ?_, ?_⟩
      · intro m
        obtain ⟨s, hs, hsm⟩ := hMmem m
        rw [halg, ← hsm, ← sq']
        exact hs.map a.hom
      · intro x
        obtain ⟨s, z, hs, hz⟩ := hA x
        refine ⟨⟨z, ⟨g.hom s, mkM s hs⟩⟩, ?_⟩
        show x * algebraMap P A (g.hom s) = algebraMap P A z
        rw [halg, halg, hz, ← sq', mul_comm]
      · intro z1 z2 h
        rw [halg, halg] at h
        obtain ⟨s, hs, hsz⟩ := hK (z1 - z2) (by rw [map_sub, h, sub_self])
        refine ⟨⟨g.hom s, mkM s hs⟩, ?_⟩
        show g.hom s * z1 = g.hom s * z2
        rw [← sub_eq_zero, ← mul_sub]
        exact hsz
    have hunits : ∀ (c : Limits.PushoutCocone f g) (m : M), IsUnit (c.inr.hom m) := by
      intro c m
      obtain ⟨s, hs, hsm⟩ := hMmem m
      rw [← hsm, ← cond]
      exact hs.map c.inl.hom
    let desc : (c : Limits.PushoutCocone f g) → A ⟶ c.pt := fun c =>
      CommRingCat.ofHom (IsLocalization.lift (M := M) (S := A) (hunits c))
    have hdesc : ∀ c z, (desc c).hom (p.hom z) = c.inr.hom z := fun c z => by
      have := IsLocalization.lift_eq (M := M) (S := A) (hunits c) z
      exact this
    have key : ∀ c x, (desc c).hom (a.hom (f.hom x)) = c.inl.hom (f.hom x) := fun c x => by
      rw [sq', hdesc, cond]
    refine IsPushout.of_isColimit (Limits.PushoutCocone.IsColimit.mk sq desc ?_ ?_ ?_)
    · intro c
      apply CommRingCat.hom_ext
      ext y
      obtain ⟨s, t, hs, hst⟩ := hR' y
      have hcs : IsUnit (c.inl.hom (f.hom s)) := hs.map c.inl.hom
      apply hcs.mul_left_cancel
      show c.inl.hom (f.hom s) * (desc c).hom (a.hom y) = c.inl.hom (f.hom s) * c.inl.hom y
      calc c.inl.hom (f.hom s) * (desc c).hom (a.hom y)
          = (desc c).hom (a.hom (f.hom s * y)) := by rw [map_mul, map_mul, key]
        _ = (desc c).hom (a.hom (f.hom t)) := by rw [hst]
        _ = c.inl.hom (f.hom s * y) := by rw [key, hst]
        _ = c.inl.hom (f.hom s) * c.inl.hom y := map_mul _ _ _
    · intro c
      apply CommRingCat.hom_ext
      ext z
      exact hdesc c z
    · intro c m _ hm2
      apply CommRingCat.hom_ext
      apply IsLocalization.ringHom_ext M
      ext z
      show m.hom (p.hom z) = (desc c).hom (p.hom z)
      rw [hdesc]
      have := congrArg (fun h => h.hom z) hm2
      simpa using this

  have S4 : ∀ (R Rb P Ab : CommRingCat.{u}) (f : R ⟶ Rb) (g : R ⟶ P) (a : Rb ⟶ Ab)
      (p : P ⟶ Ab), f ≫ a = g ≫ p → Function.Surjective f.hom → Function.Surjective p.hom →
      (∀ z : P, p.hom z = 0 → z ∈ Ideal.map g.hom (RingHom.ker f.hom)) → IsPushout f g a p := by
    intro R Rb P Ab f g a p sq hf hp hK
    have sq' : ∀ x : R, a.hom (f.hom x) = p.hom (g.hom x) := fun x => by
      have := congrArg (fun h => h.hom x) sq
      simpa using this
    have cond : ∀ (c : Limits.PushoutCocone f g) (x : R),
        c.inl.hom (f.hom x) = c.inr.hom (g.hom x) := fun c x => by
      have := congrArg (fun h => h.hom x) c.condition
      simpa using this
    have hker : ∀ c : Limits.PushoutCocone f g, RingHom.ker p.hom ≤ RingHom.ker c.inr.hom := by
      intro c z hz
      have h2 : Ideal.map g.hom (RingHom.ker f.hom) ≤ RingHom.ker c.inr.hom := by
        rw [Ideal.map_le_iff_le_comap]
        intro k hk
        rw [Ideal.mem_comap, RingHom.mem_ker, ← cond, RingHom.mem_ker.mp hk, map_zero]
      exact h2 (hK z hz)
    let desc : (c : Limits.PushoutCocone f g) → Ab ⟶ c.pt := fun c =>
      CommRingCat.ofHom ((RingHom.liftOfSurjective p.hom hp) ⟨c.inr.hom, hker c⟩)
    have hdesc : ∀ c z, (desc c).hom (p.hom z) = c.inr.hom z := fun c z =>
      RingHom.liftOfSurjective_comp_apply p.hom hp ⟨c.inr.hom, hker c⟩ z
    refine IsPushout.of_isColimit (Limits.PushoutCocone.IsColimit.mk sq desc ?_ ?_ ?_)
    · intro c
      apply CommRingCat.hom_ext
      ext y
      obtain ⟨w, rfl⟩ := hf y
      show (desc c).hom (a.hom (f.hom w)) = c.inl.hom (f.hom w)
      rw [sq', hdesc, cond]
    · intro c
      apply CommRingCat.hom_ext
      ext z
      exact hdesc c z
    · intro c m _ hm2
      apply CommRingCat.hom_ext
      ext x
      obtain ⟨z, rfl⟩ := hp x
      rw [hdesc]
      have := congrArg (fun h => h.hom z) hm2
      simpa using this

  intro Ω _ W W' Wb hle πb hsurj hcompat hpbR A' Ab B P α' ᾱ r e₀ β pA pB γ h1 h2 h5 h6 h7
  classical
  obtain ⟨hP1, hP2, hP3⟩ := S0 pA pB r e₀ h5
  obtain ⟨-, hR2, -⟩ := S0 _ _ _ _ hpbR
  have hM : ∀ m : ↥W', m ∈ IsLocalRing.maximalIdeal ↥W' →
      ∃ p : ↥W, ValuationSubring.inclusion W W' hle p = m ∧ πb p = 0 := by
    intro m hm
    have hm0 : (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))).hom m =
        (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W'))).hom 0 := by
      rw [CommRingCat.hom_ofHom, CommRingCat.hom_ofHom, map_zero,
        IsLocalRing.ResidueField.algebraMap_eq, (IsLocalRing.residue_eq_zero_iff m).mpr hm]
    obtain ⟨p, hp1, hp2⟩ := hR2 m 0 hm0
    exact ⟨p, hp1, hp2⟩
  have hC1 : ∀ x : ↥W', r.hom (α'.hom x) =
      β.hom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W') x) := by
    intro x
    have := congrArg (fun f => f.hom x) h1.w
    simpa using this
  obtain ⟨hS, hK1⟩ := S1 ↥W' A' B α' r β h1
  obtain ⟨hL1, hL2⟩ := S2 ↥Wb (IsLocalRing.ResidueField ↥W') Ab B ᾱ e₀ β h2
  set ι := ValuationSubring.inclusion W W' hle with hι
  have h6' : ∀ w, pA.hom (γ.hom w) = α'.hom (ι w) := fun w => by
    have := congrArg (fun f => f.hom w) h6
    simpa using this
  have h7' : ∀ w, pB.hom (γ.hom w) = ᾱ.hom (πb w) := fun w => by
    have := congrArg (fun f => f.hom w) h7
    simpa using this

  have hU : ∀ s : W, πb s ≠ 0 → IsUnit (ι s) := by
    intro s hs0
    have h1 : algebraMap W' (IsLocalRing.ResidueField W') (ι s) ≠ 0 := by
      rw [← hcompat]
      intro h
      apply hs0
      exact IsFractionRing.injective Wb (IsLocalRing.ResidueField W')
        (h.trans (map_zero _).symm)
    by_contra hn
    apply h1
    rw [IsLocalRing.ResidueField.algebraMap_eq, IsLocalRing.residue_eq_zero_iff]
    exact hn

  have star : ∀ c : A', ∃ (s : W) (y : P), IsUnit (ι s) ∧ pA.hom y = α'.hom (ι s) * c := by
    intro c
    obtain ⟨t, a, ht, hta⟩ := hL1 (r.hom c)
    obtain ⟨s, rfl⟩ := hsurj t
    have hr : r.hom (α'.hom (ι s) * c) = e₀.hom a := by
      rw [map_mul, hC1, ← hcompat, hta]
    obtain ⟨y, hy, -⟩ := hP2 _ _ hr
    exact ⟨s, y, hU s ht, hy⟩
  have locK : ∀ z : P, pA.hom z = 0 → ∃ s : W, IsUnit (ι s) ∧ γ.hom s * z = 0 := by
    intro z hz
    have he : e₀.hom (pB.hom z) = 0 := by rw [← hP3, hz, map_zero]
    obtain ⟨t, ht, htz⟩ := hL2 _ he
    obtain ⟨s, rfl⟩ := hsurj t
    refine ⟨s, hU s ht, ?_⟩
    apply hP1
    · rw [map_mul, h6', hz, mul_zero, map_zero]
    · rw [map_mul, h7', htz, map_zero]

  set J : Ideal P := Ideal.map γ.hom (RingHom.ker πb) with hJ
  have ker : ∀ k ∈ Ideal.map α'.hom (IsLocalRing.maximalIdeal W'), ∀ u : W'ˣ,
      ∃ q ∈ J, pA.hom q = α'.hom u * k ∧ pB.hom q = 0 := by
    intro k hk
    have hk' : k ∈ Submodule.span A' (⇑α'.hom '' (IsLocalRing.maximalIdeal W' : Set W')) := hk
    clear hk
    induction hk' using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨m, hm, rfl⟩ := hx
      intro u
      obtain ⟨p, hp, hp0⟩ := hM ((u : W') * m) (Ideal.mul_mem_left _ _ hm)
      refine ⟨γ.hom p, Ideal.mem_map_of_mem _ (RingHom.mem_ker.mpr hp0), ?_, ?_⟩
      · rw [h6', hp, map_mul]
      · rw [h7', hp0, map_zero]
    | zero =>
      intro u
      exact ⟨0, J.zero_mem, by rw [map_zero, mul_zero], map_zero _⟩
    | add x y _ _ hx hy =>
      intro u
      obtain ⟨qx, hqx, hpx, hbx⟩ := hx u
      obtain ⟨qy, hqy, hpy, hby⟩ := hy u
      refine ⟨qx + qy, J.add_mem hqx hqy, ?_, ?_⟩
      · rw [map_add, hpx, hpy, mul_add]
      · rw [map_add, hbx, hby, add_zero]
    | smul a x _ hx =>
      intro u
      obtain ⟨s, qa, hu, hpa⟩ := star a
      obtain ⟨qk, hqk, hpk, hbk⟩ := hx (u * hu.unit⁻¹)
      refine ⟨qa * qk, J.mul_mem_left qa hqk, ?_, ?_⟩
      · have hunit : ι s * ((u * hu.unit⁻¹ : W'ˣ) : W') = u := by
          rw [Units.val_mul, mul_left_comm, hu.mul_val_inv, mul_one]
        rw [map_mul, hpa, hpk, smul_eq_mul, ← hunit, map_mul α'.hom]
        ring
      · rw [map_mul, hbk, mul_zero]
  refine ⟨?_, ?_⟩
  · apply S3 _ _ _ _ _ _ _ _ h6.symm
    · intro y
      by_cases hy : (y : Ω) ∈ W
      · refine ⟨1, ⟨y, hy⟩, ?_, ?_⟩
        · rw [CommRingCat.hom_ofHom, map_one]
          exact isUnit_one
        · rw [CommRingCat.hom_ofHom, map_one, one_mul]
          rfl
      · have hyi := (ValuationSubring.mem_or_inv_mem W (y : Ω)).resolve_left hy
        have hy0 : (y : Ω) ≠ 0 := fun h => hy (h ▸ W.zero_mem)
        have hmul : ι ⟨(y : Ω)⁻¹, hyi⟩ * y = 1 := by
          apply Subtype.ext
          show (y : Ω)⁻¹ * (y : Ω) = 1
          exact inv_mul_cancel₀ hy0
        refine ⟨⟨(y : Ω)⁻¹, hyi⟩, 1, ?_, ?_⟩
        · rw [CommRingCat.hom_ofHom]
          exact ⟨⟨_, _, hmul, by rw [mul_comm]; exact hmul⟩, rfl⟩
        · rw [CommRingCat.hom_ofHom, map_one]
          exact hmul
    · intro x
      obtain ⟨s, z, hs, hz⟩ := star x
      exact ⟨s, z, hs, hz⟩
    · exact locK
  · apply S4 _ _ _ _ _ _ _ _ h7.symm hsurj
    · intro b
      obtain ⟨a, ha⟩ := hS (e₀.hom b)
      obtain ⟨x, -, hx⟩ := hP2 a b ha
      exact ⟨x, hx⟩
    · intro z hz
      have hk : r.hom (pA.hom z) = 0 := by rw [hP3, hz, map_zero]
      obtain ⟨q, hq, hpq, hbq⟩ := ker _ (hK1 _ hk) 1
      have hzq : z = q := hP1 _ _ (by rw [hpq, Units.val_one, map_one, one_mul])
        (by rw [hbq, hz])
      rw [hzq]
      exact hq

theorem wcpa_dj_lmfg_pullback_of_affine_charts : ∀ {X' X : Scheme.{u}} {R R' : CommRingCat.{u}}
    (φ : R ⟶ R') (i : X' ⟶ X) (u' : X' ⟶ Spec R') (u : X ⟶ Spec R), i ≫ u = u' ≫ Spec.map φ →
    ∀ (m : ℕ) (O : Fin m → X.Opens) (U : Fin m → X'.Opens), (⨆ a, O a) = ⊤ →
      (∀ a, IsAffineOpen (O a)) → (∀ a, IsAffineOpen (U a)) →
      ∀ (hU : ∀ a, i ⁻¹ᵁ O a = U a),
      (∀ a, IsPushout ((Scheme.ΓSpecIso R).inv ≫ u.appLE ⊤ (O a) (by simp)) φ
        (i.appLE (O a) (U a) (hU a).ge) ((Scheme.ΓSpecIso R').inv ≫ u'.appLE ⊤ (U a) (by simp))) →
      IsPullback i u' u (Spec.map φ) :=
by
  intro X' X R R' φ i u' u _hcomm m O U hcov hO hUaff hU hpush
  have s1 : ∀ {Y : Scheme.{u}} {S : CommRingCat.{u}} (g : Y ⟶ Spec S) (V : Y.Opens)
      (hV : IsAffineOpen V),
      Spec.map ((Scheme.ΓSpecIso S).inv ≫ g.appLE ⊤ V (by simp)) = hV.fromSpec ≫ g := by
    intro Y S g V hV
    rw [Spec.map_comp, ← Scheme.isoSpec_Spec_inv, ← IsAffineOpen.fromSpec_top]
    exact IsAffineOpen.SpecMap_appLE_fromSpec g (isAffineOpen_top (Spec S)) hV _
  have s2 : ∀ (O : X.Opens) (V : X'.Opens) (hVeq : i ⁻¹ᵁ O = V), IsAffineOpen O →
      IsAffineOpen V →
      IsPushout ((Scheme.ΓSpecIso R).inv ≫ u.appLE ⊤ O (by simp)) φ (i.appLE O V hVeq.ge)
        ((Scheme.ΓSpecIso R').inv ≫ u'.appLE ⊤ V (by simp)) →
      IsPullback (i ∣_ O) ((i ⁻¹ᵁ O).ι ≫ u') (O.ι ≫ u) (Spec.map φ) := by
    intro O V hVeq hO hV hP
    subst hVeq
    have H := isPullback_SpecMap_of_isPushout _ _ _ _ hP
    refine IsPullback.of_iso H hV.isoSpec.symm hO.isoSpec.symm (Iso.refl _) (Iso.refl _)
      ?_ ?_ ?_ ?_
    · simp only [Iso.symm_hom]
      rw [← cancel_mono O.ι, Category.assoc, IsAffineOpen.isoSpec_inv_ι, Category.assoc,
        morphismRestrict_ι, ← Category.assoc, IsAffineOpen.isoSpec_inv_ι]
      exact IsAffineOpen.SpecMap_appLE_fromSpec i hO hV _
    · simp only [Iso.symm_hom, Iso.refl_hom, Category.comp_id]
      rw [s1 u' _ hV, ← Category.assoc, IsAffineOpen.isoSpec_inv_ι]
    · simp only [Iso.symm_hom, Iso.refl_hom, Category.comp_id]
      rw [s1 u _ hO, ← Category.assoc, IsAffineOpen.isoSpec_inv_ι]
    · simp
  refine Scheme.isPullback_of_openCover i u' u (Spec.map φ)
    (X.openCoverOfIsOpenCover O hcov) (fun a => ?_)
  change IsPullback (Limits.pullback.snd i (O a).ι) (Limits.pullback.fst i (O a).ι ≫ u')
    ((O a).ι ≫ u) (Spec.map φ)
  have C := s2 (O a) (U a) (hU a) (hO a) (hUaff a) (hpush a)
  have E := (isPullback_morphismRestrict i (O a)).flip
  refine IsPullback.of_iso C E.isoPullback (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
  · simp
  · simp
  · simp
  · simp

theorem wcpa_dj_lmfg_chart_system : ∀ (Z' Zb Y : Scheme.{u}) (yf : Y ⟶ Z') (ψb : Y ⟶ Zb) (m : ℕ)
    (U' : Fin m → Z'.Opens) (Ub : Fin m → Zb.Opens)
    (htrT : ∀ T : Finset (Fin m), yf ⁻¹ᵁ (T.inf U') = ψb ⁻¹ᵁ (T.inf Ub)),
    ∃ (P : Finset (Fin m) → CommRingCat.{u}) (pA : ∀ T, P T ⟶ Γ(Z', T.inf U'))
      (pB : ∀ T, P T ⟶ Γ(Zb, T.inf Ub)) (π : ∀ T T' : Finset (Fin m), T ⊆ T' → (P T ⟶ P T')),
      (∀ T, IsPullback (pA T) (pB T) (yf.appLE (T.inf U') (yf ⁻¹ᵁ (T.inf U')) le_rfl)
        (ψb.appLE (T.inf Ub) (yf ⁻¹ᵁ (T.inf U')) (htrT T).le)) ∧
      (∀ T T' (h : T ⊆ T'), π T T' h ≫ pA T' = pA T ≫ Z'.presheaf.map (homOfLE (Finset.inf_mono h)).op) ∧
      (∀ T T' (h : T ⊆ T'), π T T' h ≫ pB T' = pB T ≫ Zb.presheaf.map (homOfLE (Finset.inf_mono h)).op) ∧
      (∀ T, π T T (Finset.Subset.refl T) = 𝟙 (P T)) ∧
      (∀ T T' T'' (h : T ⊆ T') (h' : T' ⊆ T''), π T T' h ≫ π T' T'' h' = π T T'' (h.trans h')) :=
by
  intro Z' Zb Y yf ψb m U' Ub htrT
  have hV : ∀ T T' : Finset (Fin m), T ⊆ T' → yf ⁻¹ᵁ (T'.inf U') ≤ yf ⁻¹ᵁ (T.inf U') :=
    fun T T' h x hx => SetLike.le_def.mp (Finset.inf_mono (f := U') h) hx
  let r : ∀ T : Finset (Fin m), Γ(Z', T.inf U') ⟶ Γ(Y, yf ⁻¹ᵁ (T.inf U')) :=
    fun T => yf.appLE (T.inf U') (yf ⁻¹ᵁ (T.inf U')) le_rfl
  let e : ∀ T : Finset (Fin m), Γ(Zb, T.inf Ub) ⟶ Γ(Y, yf ⁻¹ᵁ (T.inf U')) :=
    fun T => ψb.appLE (T.inf Ub) (yf ⁻¹ᵁ (T.inf U')) (htrT T).le
  have N1 : ∀ (T T' : Finset (Fin m)) (h : T ⊆ T'),
      Z'.presheaf.map (homOfLE (Finset.inf_mono h)).op ≫ r T' =
        r T ≫ Y.presheaf.map (homOfLE (hV T T' h)).op := by
    intro T T' h
    simp only [r, Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
  have N2 : ∀ (T T' : Finset (Fin m)) (h : T ⊆ T'),
      Zb.presheaf.map (homOfLE (Finset.inf_mono h)).op ≫ e T' =
        e T ≫ Y.presheaf.map (homOfLE (hV T T' h)).op := by
    intro T T' h
    simp only [e, Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
  let π : ∀ T T' : Finset (Fin m), T ⊆ T' →
      (Limits.pullback (r T) (e T) ⟶ Limits.pullback (r T') (e T')) :=
    fun T T' h => Limits.pullback.lift
      (Limits.pullback.fst (r T) (e T) ≫ Z'.presheaf.map (homOfLE (Finset.inf_mono h)).op)
      (Limits.pullback.snd (r T) (e T) ≫ Zb.presheaf.map (homOfLE (Finset.inf_mono h)).op)
      (by rw [Category.assoc, N1 T T' h, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        ← N2 T T' h, Category.assoc])
  have G2 : ∀ (T T' : Finset (Fin m)) (h : T ⊆ T'), π T T' h ≫ Limits.pullback.fst (r T') (e T') =
      Limits.pullback.fst (r T) (e T) ≫ Z'.presheaf.map (homOfLE (Finset.inf_mono h)).op :=
    fun T T' h => Limits.pullback.lift_fst _ _ _
  have G3 : ∀ (T T' : Finset (Fin m)) (h : T ⊆ T'), π T T' h ≫ Limits.pullback.snd (r T') (e T') =
      Limits.pullback.snd (r T) (e T) ≫ Zb.presheaf.map (homOfLE (Finset.inf_mono h)).op :=
    fun T T' h => Limits.pullback.lift_snd _ _ _
  refine ⟨fun T => Limits.pullback (r T) (e T), fun T => Limits.pullback.fst (r T) (e T),
    fun T => Limits.pullback.snd (r T) (e T), π, fun T => IsPullback.of_hasPullback _ _,
    G2, G3, ?_, ?_⟩
  · intro T
    apply Limits.pullback.hom_ext
    · rw [G2 T T (Finset.Subset.refl T), Category.id_comp]
      have h1 : (homOfLE (Finset.inf_mono (Finset.Subset.refl T))).op =
          𝟙 (Opposite.op (T.inf U')) := rfl
      rw [h1, CategoryTheory.Functor.map_id, Category.comp_id]
    · rw [G3 T T (Finset.Subset.refl T), Category.id_comp]
      have h1 : (homOfLE (Finset.inf_mono (Finset.Subset.refl T))).op =
          𝟙 (Opposite.op (T.inf Ub)) := rfl
      rw [h1, CategoryTheory.Functor.map_id, Category.comp_id]
  · intro T T' T'' h h'
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, G2 T' T'' h', ← Category.assoc, G2 T T' h, Category.assoc,
        G2 T T'' (h.trans h'),
        ← CategoryTheory.Functor.map_comp]
      rfl
    · rw [Category.assoc, G3 T' T'' h', ← Category.assoc, G3 T T' h, Category.assoc,
        G3 T T'' (h.trans h'),
        ← CategoryTheory.Functor.map_comp]
      rfl

theorem wcpa_dj_lmfg_milnor_spec_points : ∀ (P A Ab B : CommRingCat.{u}) (pA : P ⟶ A) (pB : P ⟶ Ab) (r : A ⟶ B) (e : Ab ⟶ B), IsPullback pA pB r e → Function.Surjective ⇑(ConcreteCategory.hom r) → (∀ z : ↥(Spec P), (∃ x, Spec.map pA x = z) ∨ (∃ y, Spec.map pB y = z)) ∧ (∀ (x : ↥(Spec A)) (y : ↥(Spec Ab)), Spec.map pA x = Spec.map pB y → ∃ v : ↥(Spec B), Spec.map r v = x ∧ Spec.map e v = y) ∧ (∀ x x' : ↥(Spec A), Spec.map pA x = Spec.map pA x' → x = x' ∨ ∃ v v' : ↥(Spec B), Spec.map r v = x ∧ Spec.map r v' = x' ∧ Spec.map e v = Spec.map e v') ∧ (∀ y y' : ↥(Spec Ab), Spec.map pB y = Spec.map pB y' → y = y') :=
by
  intro P A Ab B pA pB r e hpb hr
  have hr' : Function.Surjective r.hom := hr

  have hw : ∀ p : P, r.hom (pA.hom p) = e.hom (pB.hom p) := fun p => by
    have := congrArg (fun f => f.hom p) hpb.w
    simpa using this
  obtain ⟨_, hinj, hex⟩ :=
    (Limits.Types.isPullback_iff _ _ _ _).mp (hpb.map (forget CommRingCat.{u}))
  have ex : ∀ (a : A) (b : Ab), r.hom a = e.hom b → ∃ p : P, pA.hom p = a ∧ pB.hom p = b :=
    fun a b h => hex a b h
  have inj : ∀ p q : P, pA.hom p = pA.hom q → pB.hom p = pB.hom q → p = q :=
    fun p q h1 h2 => hinj p q ⟨h1, h2⟩
  have hsurjB : Function.Surjective pB.hom := fun b => by
    obtain ⟨a, ha⟩ := hr' (e.hom b)
    obtain ⟨p, -, hp⟩ := ex a b ha
    exact ⟨p, hp⟩

  have key : ∀ x : PrimeSpectrum A, RingHom.ker r.hom ≤ x.asIdeal →
      ∃ v : PrimeSpectrum B, PrimeSpectrum.comap r.hom v = x ∧
        ∀ a, r.hom a ∈ v.asIdeal ↔ a ∈ x.asIdeal := by
    intro x hx
    have := Ideal.map_isPrime_of_surjective hr' hx
    have hc : Ideal.comap r.hom (Ideal.map r.hom x.asIdeal) = x.asIdeal :=
      (Ideal.comap_map_of_surjective' _ hr' _).trans (sup_eq_left.mpr hx)
    refine ⟨⟨Ideal.map r.hom x.asIdeal, this⟩, PrimeSpectrum.ext ?_, fun a => ?_⟩
    · rw [PrimeSpectrum.comap_asIdeal]; exact hc
    · show r.hom a ∈ Ideal.map r.hom x.asIdeal ↔ a ∈ x.asIdeal
      rw [← Ideal.mem_comap, hc]

  have partA : ∀ z : PrimeSpectrum P, (∃ x, PrimeSpectrum.comap pA.hom x = z) ∨
      (∃ y, PrimeSpectrum.comap pB.hom y = z) := by
    intro z
    have hq := z.isPrime
    by_cases hK : RingHom.ker pB.hom ≤ z.asIdeal
    · right
      have := Ideal.map_isPrime_of_surjective hsurjB hK
      refine ⟨⟨Ideal.map pB.hom z.asIdeal, this⟩, PrimeSpectrum.ext ?_⟩
      rw [PrimeSpectrum.comap_asIdeal]
      exact (Ideal.comap_map_of_surjective' _ hsurjB _).trans (sup_eq_left.mpr hK)
    · left
      obtain ⟨h, hhK, hhq⟩ := SetLike.not_le_iff_exists.mp hK
      have hh0 : pB.hom h = 0 := RingHom.mem_ker.mp hhK
      have hc : ∀ a : A, ∃ p : P, pA.hom p = pA.hom h * a ∧ pB.hom p = 0 := fun a =>
        ex _ _ (by rw [map_mul, hw, hh0, map_zero, zero_mul])
      choose c hcA hcB using hc
      have I1 : ∀ a a', c (a + a') = c a + c a' := fun a a' =>
        inj _ _ (by simp only [map_add, hcA]; ring) (by simp only [map_add, hcB, add_zero])
      have I2 : ∀ a a', c a * c a' = h * c (a * a') := fun a a' =>
        inj _ _ (by simp only [map_mul, hcA]; ring) (by simp only [map_mul, hcB, mul_zero])
      have I3 : ∀ p, c (pA.hom p) = h * p := fun p =>
        inj _ _ (by simp only [map_mul, hcA]) (by simp only [map_mul, hcB, hh0, zero_mul])
      have I4 : c 0 = 0 := inj _ _ (by simp only [hcA, mul_zero, map_zero])
        (by simp only [hcB, map_zero])
      have I5 : c 1 = h := by
        have := I3 1
        rwa [map_one, mul_one] at this
      let I : Ideal A :=
        { carrier := {a | c a ∈ z.asIdeal}
          add_mem' := fun {a a'} ha ha' => by
            show c (a + a') ∈ z.asIdeal
            rw [I1]; exact z.asIdeal.add_mem ha ha'
          zero_mem' := by
            show c 0 ∈ z.asIdeal
            rw [I4]; exact z.asIdeal.zero_mem
          smul_mem' := fun s {a} ha => by
            show c (s * a) ∈ z.asIdeal
            have : h * c (s * a) ∈ z.asIdeal := by
              rw [← I2]; exact z.asIdeal.mul_mem_left _ ha
            exact (hq.mem_or_mem this).resolve_left hhq }
      have hmemI : ∀ a, a ∈ I ↔ c a ∈ z.asIdeal := fun a => Iff.rfl
      have hIp : I.IsPrime := by
        refine ⟨?_, ?_⟩
        · rw [Ideal.ne_top_iff_one, hmemI, I5]; exact hhq
        · intro a a' haa
          rw [hmemI] at haa
          rw [hmemI, hmemI]
          apply hq.mem_or_mem
          rw [I2]; exact z.asIdeal.mul_mem_left _ haa
      refine ⟨⟨I, hIp⟩, PrimeSpectrum.ext ?_⟩
      rw [PrimeSpectrum.comap_asIdeal]
      ext p
      rw [Ideal.mem_comap]
      show c (pA.hom p) ∈ z.asIdeal ↔ p ∈ z.asIdeal
      rw [I3]
      exact ⟨fun h' => (hq.mem_or_mem h').resolve_left hhq, fun h' => z.asIdeal.mul_mem_left _ h'⟩

  have partB : ∀ (x : PrimeSpectrum A) (y : PrimeSpectrum Ab),
      PrimeSpectrum.comap pA.hom x = PrimeSpectrum.comap pB.hom y →
      ∃ v : PrimeSpectrum B, PrimeSpectrum.comap r.hom v = x ∧ PrimeSpectrum.comap e.hom v = y := by
    intro x y hxy
    have H : ∀ p : P, pA.hom p ∈ x.asIdeal ↔ pB.hom p ∈ y.asIdeal := fun p => by
      have h1 : (PrimeSpectrum.comap pA.hom x).asIdeal = (PrimeSpectrum.comap pB.hom y).asIdeal := by
        rw [hxy]
      rw [PrimeSpectrum.comap_asIdeal, PrimeSpectrum.comap_asIdeal] at h1
      rw [← Ideal.mem_comap, h1, Ideal.mem_comap]
    have hker : RingHom.ker r.hom ≤ x.asIdeal := fun i hi => by
      obtain ⟨p, hp1, hp2⟩ := ex i 0 (by rw [map_zero]; exact RingHom.mem_ker.mp hi)
      rw [← hp1]; exact (H p).mpr (by rw [hp2]; exact y.asIdeal.zero_mem)
    obtain ⟨v, hv1, hv2⟩ := key x hker
    refine ⟨v, hv1, PrimeSpectrum.ext ?_⟩
    rw [PrimeSpectrum.comap_asIdeal]
    ext b
    rw [Ideal.mem_comap]
    obtain ⟨a, ha⟩ := hr' (e.hom b)
    obtain ⟨p, hp1, hp2⟩ := ex a b ha
    rw [← ha, hv2, ← hp1, H, hp2]

  have partC : ∀ x x' : PrimeSpectrum A,
      PrimeSpectrum.comap pA.hom x = PrimeSpectrum.comap pA.hom x' → x = x' ∨
      ∃ v v' : PrimeSpectrum B, PrimeSpectrum.comap r.hom v = x ∧
        PrimeSpectrum.comap r.hom v' = x' ∧
        PrimeSpectrum.comap e.hom v = PrimeSpectrum.comap e.hom v' := by
    intro x x' hxx
    have H : ∀ p : P, pA.hom p ∈ x.asIdeal ↔ pA.hom p ∈ x'.asIdeal := fun p => by
      have h1 : (PrimeSpectrum.comap pA.hom x).asIdeal =
          (PrimeSpectrum.comap pA.hom x').asIdeal := by
        rw [hxx]
      rw [PrimeSpectrum.comap_asIdeal, PrimeSpectrum.comap_asIdeal] at h1
      rw [← Ideal.mem_comap, h1, Ideal.mem_comap]
    have Hk : ∀ i, r.hom i = 0 → (i ∈ x.asIdeal ↔ i ∈ x'.asIdeal) := fun i hi => by
      obtain ⟨p, hp1, -⟩ := ex i 0 (by rw [map_zero]; exact hi)
      rw [← hp1]; exact H p
    by_cases hk : RingHom.ker r.hom ≤ x.asIdeal
    · right
      have hk' : RingHom.ker r.hom ≤ x'.asIdeal := fun i hi =>
        (Hk i (RingHom.mem_ker.mp hi)).mp (hk hi)
      obtain ⟨v, hv1, hv2⟩ := key x hk
      obtain ⟨v', hv1', hv2'⟩ := key x' hk'
      refine ⟨v, v', hv1, hv1', PrimeSpectrum.ext ?_⟩
      rw [PrimeSpectrum.comap_asIdeal, PrimeSpectrum.comap_asIdeal]
      ext b
      rw [Ideal.mem_comap, Ideal.mem_comap]
      obtain ⟨a, ha⟩ := hr' (e.hom b)
      obtain ⟨p, hp1, -⟩ := ex a b ha
      rw [← ha, hv2, hv2', ← hp1, H]
    · left
      obtain ⟨i, hi, hix⟩ := SetLike.not_le_iff_exists.mp hk
      have hi0 : r.hom i = 0 := RingHom.mem_ker.mp hi
      have hix' : i ∉ x'.asIdeal := fun h => hix ((Hk i hi0).mpr h)
      refine PrimeSpectrum.ext (Ideal.ext fun a => ?_)
      have h1 : r.hom (i * a) = 0 := by rw [map_mul, hi0, zero_mul]
      have e1 : a ∈ x.asIdeal ↔ i * a ∈ x.asIdeal :=
        ⟨fun h => x.asIdeal.mul_mem_left i h, fun h => (x.isPrime.mem_or_mem h).resolve_left hix⟩
      have e2 : a ∈ x'.asIdeal ↔ i * a ∈ x'.asIdeal :=
        ⟨fun h => x'.asIdeal.mul_mem_left i h,
          fun h => (x'.isPrime.mem_or_mem h).resolve_left hix'⟩
      rw [e1, e2]; exact Hk _ h1
  simp only [Spec.map_apply]
  exact ⟨partA, partB, partC,
    fun y y' h => PrimeSpectrum.comap_injective_of_surjective pB.hom hsurjB h⟩

theorem wcpa_dj_lmfg_pinch_sets : ∀ {XA XB XV XP : Type u} (a : XA → XP) (b : XB → XP) (ρ : XV → XA) (ε : XV → XB), (∀ v, a (ρ v) = b (ε v)) → (∀ x y, a x = b y → ∃ v, ρ v = x ∧ ε v = y) → (∀ x x', a x = a x' → x = x' ∨ ∃ v v', ρ v = x ∧ ρ v' = x' ∧ ε v = ε v') → Function.Injective b → ∀ (SA1 SA2 : Set XA) (SB1 SB2 : Set XB), ρ ⁻¹' SA1 = ε ⁻¹' SB1 → ρ ⁻¹' SA2 = ε ⁻¹' SB2 → ((a '' SA1 ∪ b '' SB1) ∩ (a '' SA2 ∪ b '' SB2) ⊆ a '' (SA1 ∩ SA2) ∪ b '' (SB1 ∩ SB2)) ∧ (∀ x, a x ∈ a '' SA1 ∪ b '' SB1 → x ∈ SA1) ∧ (∀ y, b y ∈ a '' SA1 ∪ b '' SB1 → y ∈ SB1) :=
by
  intro XA XB XV XP a b ρ ε _ hab haa hb SA1 SA2 SB1 SB2 h1 h2
  have satA : ∀ (SA : Set XA) (SB : Set XB), ρ ⁻¹' SA = ε ⁻¹' SB →
      ∀ x, a x ∈ a '' SA ∪ b '' SB → x ∈ SA := by
    intro SA SB hS x hx
    have key : ∀ v, ρ v ∈ SA ↔ ε v ∈ SB := fun v => Set.ext_iff.mp hS v
    rcases hx with ⟨x', hx', he⟩ | ⟨y, hy, he⟩
    · rcases haa x x' he.symm with h | ⟨v, v', hv, hv', hvv⟩
      · rw [h]; exact hx'
      · rw [← hv]
        apply (key v).mpr
        rw [hvv]
        apply (key v').mp
        rw [hv']; exact hx'
    · obtain ⟨v, hv, hv'⟩ := hab x y he.symm
      rw [← hv]
      apply (key v).mpr
      rw [hv']; exact hy
  have satB : ∀ (SA : Set XA) (SB : Set XB), ρ ⁻¹' SA = ε ⁻¹' SB →
      ∀ y, b y ∈ a '' SA ∪ b '' SB → y ∈ SB := by
    intro SA SB hS y hy
    have key : ∀ v, ρ v ∈ SA ↔ ε v ∈ SB := fun v => Set.ext_iff.mp hS v
    rcases hy with ⟨x, hx, he⟩ | ⟨y', hy', he⟩
    · obtain ⟨v, hv, hv'⟩ := hab x y he
      rw [← hv']
      apply (key v).mp
      rw [hv]; exact hx
    · rw [← hb he]; exact hy'
  refine ⟨?_, satA SA1 SB1 h1, satB SA1 SB1 h1⟩
  rintro p ⟨⟨x, hx1, rfl⟩ | ⟨y, hy1, rfl⟩, hp2⟩
  · exact Or.inl ⟨x, ⟨hx1, satA SA2 SB2 h2 x hp2⟩, rfl⟩
  · exact Or.inr ⟨y, ⟨hy1, satB SA2 SB2 h2 y hp2⟩, rfl⟩

theorem wcpa_dj_lmfg_restrict_open_trace : ∀ {X Y : Scheme.{u}} (g : Y ⟶ X) (U0 U : X.Opens) (V0 V : Y.Opens) (hU : U ≤ U0) (hV : V ≤ V0) (e0 : V0 ≤ g ⁻¹ᵁ U0) (hU0 : IsAffineOpen U0), IsAffineOpen U → IsAffineOpen V0 → IsAffineOpen V → g ⁻¹ᵁ U = V → IsOpenImmersion (Spec.map (X.presheaf.map (homOfLE hU).op)) ∧ IsOpenImmersion (Spec.map (Y.presheaf.map (homOfLE hV).op)) ∧ Set.range ⇑(Spec.map (X.presheaf.map (homOfLE hU).op)) = ⇑hU0.fromSpec ⁻¹' (U : Set X) ∧ Set.range ⇑(Spec.map (Y.presheaf.map (homOfLE hV).op)) = ⇑(Spec.map (g.appLE U0 V0 e0)) ⁻¹' Set.range ⇑(Spec.map (X.presheaf.map (homOfLE hU).op)) :=
by
  intro X Y g U0 U V0 V hU hV e0 hU0 hU1 hV0 hV1 htr
  have hA := IsAffineOpen.SpecMap_appLE_fromSpec g hU0 hV0 e0
  have key : ∀ {Z : Scheme.{u}} (W0 W : Z.Opens) (hW : W ≤ W0) (hW0 : IsAffineOpen W0)
      (hW1 : IsAffineOpen W),
      IsOpenImmersion (Spec.map (Z.presheaf.map (homOfLE hW).op)) ∧
      Set.range ⇑(Spec.map (Z.presheaf.map (homOfLE hW).op)) = ⇑hW0.fromSpec ⁻¹' (W : Set Z) := by
    intro Z W0 W hW hW0 hW1
    have hZ := IsAffineOpen.map_fromSpec hW0 hW1 (homOfLE hW).op
    constructor
    · haveI : IsOpenImmersion (Spec.map (Z.presheaf.map (homOfLE hW).op) ≫ hW0.fromSpec) := by
        rw [hZ]; infer_instance
      exact IsOpenImmersion.of_comp _ hW0.fromSpec
    · ext x
      constructor
      · rintro ⟨y, rfl⟩
        show hW0.fromSpec _ ∈ (W : Set Z)
        rw [← Scheme.Hom.comp_apply, hZ, ← hW1.range_fromSpec]
        exact ⟨y, rfl⟩
      · intro hx
        have hx' : hW0.fromSpec x ∈ Set.range hW1.fromSpec := by
          rw [hW1.range_fromSpec]; exact hx
        obtain ⟨y, hy⟩ := hx'
        refine ⟨y, ?_⟩
        apply hW0.fromSpec.isOpenEmbedding.injective
        rw [← Scheme.Hom.comp_apply, hZ, hy]
  obtain ⟨i1, r1⟩ := key U0 U hU hU0 hU1
  obtain ⟨i2, r2⟩ := key V0 V hV hV0 hV1
  refine ⟨i1, i2, r1, ?_⟩
  rw [r1, r2]
  ext x
  simp only [Set.mem_preimage, SetLike.mem_coe]
  rw [← Scheme.Hom.comp_apply, hA, Scheme.Hom.comp_apply]
  rw [← htr]
  try exact Iff.rfl

theorem wcpa_dj_lmfg_chart_restrict_open : ∀ (A0 A1 Ab0 Ab1 B0 B1 P0 P1 : CommRingCat.{u}) (r0 : A0 ⟶ B0) (r1 : A1 ⟶ B1) (e0 : Ab0 ⟶ B0) (e1 : Ab1 ⟶ B1) (α : A0 ⟶ A1) (ᾱ : Ab0 ⟶ Ab1) (β : B0 ⟶ B1) (pA0 : P0 ⟶ A0) (pB0 : P0 ⟶ Ab0) (pA1 : P1 ⟶ A1) (pB1 : P1 ⟶ Ab1) (π : P0 ⟶ P1), IsPullback pA0 pB0 r0 e0 → IsPullback pA1 pB1 r1 e1 → Function.Surjective ⇑(ConcreteCategory.hom r0) → Function.Surjective ⇑(ConcreteCategory.hom r1) → IsOpenImmersion (Spec.map α) → IsOpenImmersion (Spec.map ᾱ) → IsOpenImmersion (Spec.map β) → α ≫ r1 = r0 ≫ β → ᾱ ≫ e1 = e0 ≫ β → Set.range ⇑(Spec.map β) = ⇑(Spec.map r0) ⁻¹' Set.range ⇑(Spec.map α) → Set.range ⇑(Spec.map β) = ⇑(Spec.map e0) ⁻¹' Set.range ⇑(Spec.map ᾱ) → π ≫ pA1 = pA0 ≫ α → π ≫ pB1 = pB0 ≫ ᾱ → IsOpenImmersion (Spec.map π) ∧ ∀ z : ↥(Spec P0), z ∈ Set.range ⇑(Spec.map π) ↔ (∃ x, Spec.map pA0 (Spec.map α x) = z) ∨ (∃ x, Spec.map pB0 (Spec.map ᾱ x) = z) :=
by

  have t_c2 : ∀ {R S : Type u} [CommRing R] [CommRing S] (φ : R →+* S) (f : R),
      Function.Bijective ⇑(Localization.awayMap φ f) ↔
        ((∀ s : S, ∃ (n : ℕ) (a : R), φ f ^ n * s = φ a) ∧
          ∀ a : R, φ a = 0 → ∃ n : ℕ, f ^ n * a = 0) := by
    intro R S _ _ φ f
    have hL : ∀ a, Localization.awayMap φ f (algebraMap R (Localization.Away f) a) =
        algebraMap S (Localization.Away (φ f)) (φ a) := fun a => IsLocalization.map_eq _ _
    constructor
    · rintro ⟨hinj, hsurj⟩
      refine ⟨fun s => ?_, fun a ha => ?_⟩
      · obtain ⟨x, hx⟩ := hsurj (algebraMap S _ s)
        obtain ⟨n, a, hna⟩ := IsLocalization.Away.surj f x
        have h1 : algebraMap S (Localization.Away (φ f)) (s * φ f ^ n) =
            algebraMap S (Localization.Away (φ f)) (φ a) := by
          rw [← hL, ← hna, map_mul, map_mul, hx, map_pow, map_pow, hL]
        obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers (φ f)) _).mp h1
        obtain ⟨k, hk⟩ := Submonoid.mem_powers_iff _ _ |>.mp c.2
        refine ⟨k + n, f ^ k * a, ?_⟩
        rw [← hk] at hc
        rw [map_mul, map_pow, pow_add]
        linear_combination hc
      · have h1 : algebraMap R (Localization.Away f) a = 0 := by
          apply hinj
          rw [hL, ha, map_zero, map_zero]
        obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers f) _ a).mp h1
        obtain ⟨n, hn⟩ := Submonoid.mem_powers_iff _ _ |>.mp m.2
        exact ⟨n, by rw [hn]; exact hm⟩
    · rintro ⟨hi, hii⟩
      constructor
      · rw [injective_iff_map_eq_zero]
        intro x hx
        obtain ⟨n, a, hna⟩ := IsLocalization.Away.surj f x
        have h1 : algebraMap S (Localization.Away (φ f)) (φ a) = 0 := by
          rw [← hL, ← hna, map_mul, hx, zero_mul]
        obtain ⟨c, hc⟩ := (IsLocalization.map_eq_zero_iff (Submonoid.powers (φ f)) _ _).mp h1
        obtain ⟨k, hk⟩ := Submonoid.mem_powers_iff _ _ |>.mp c.2
        obtain ⟨j, hj⟩ := hii (f ^ k * a) (by rw [map_mul, map_pow, hk]; exact hc)
        have h2 : algebraMap R (Localization.Away f) a = 0 := by
          rw [IsLocalization.map_eq_zero_iff (Submonoid.powers f)]
          refine ⟨⟨f ^ (j + k), j + k, rfl⟩, ?_⟩
          show f ^ (j + k) * a = 0
          rw [pow_add, mul_assoc]
          exact hj
        rw [h2] at hna
        exact ((IsLocalization.Away.algebraMap_isUnit f).pow n).mul_left_eq_zero.mp hna
      · intro y
        obtain ⟨m, s, hms⟩ := IsLocalization.Away.surj (φ f) y
        obtain ⟨n, a, hna⟩ := hi s
        refine ⟨IsLocalization.mk' (Localization.Away f) a
          (⟨f ^ (n + m), n + m, rfl⟩ : Submonoid.powers f), ?_⟩
        rw [Localization.awayMap, IsLocalization.Away.map, IsLocalization.map_mk',
          IsLocalization.mk'_eq_iff_eq_mul]
        rw [← hna]
        simp only [map_mul, map_pow]
        rw [← hms]
        ring

  have t_c6 : ∀ {P0 P1 A0 A1 Ab0 Ab1 B0 B1 : Type u} [CommRing P0] [CommRing P1] [CommRing A0]
      [CommRing A1] [CommRing Ab0] [CommRing Ab1] [CommRing B0] [CommRing B1] (pA0 : P0 →+* A0)
      (pB0 : P0 →+* Ab0) (r0 : A0 →+* B0) (e0 : Ab0 →+* B0) (pA1 : P1 →+* A1) (pB1 : P1 →+* Ab1)
      (r1 : A1 →+* B1) (e1 : Ab1 →+* B1) (α : A0 →+* A1) (ᾱ : Ab0 →+* Ab1) (β : B0 →+* B1)
      (π : P0 →+* P1), (∀ p, r0 (pA0 p) = e0 (pB0 p)) →
      (∀ a b, r0 a = e0 b → ∃ p, pA0 p = a ∧ pB0 p = b) →
      (∀ p q, pA0 p = pA0 q → pB0 p = pB0 q → p = q) → (∀ s, r1 (pA1 s) = e1 (pB1 s)) →
      (∀ s t, pA1 s = pA1 t → pB1 s = pB1 t → s = t) → (∀ a, r1 (α a) = β (r0 a)) →
      (∀ b, e1 (ᾱ b) = β (e0 b)) → (∀ p, pA1 (π p) = α (pA0 p)) →
      (∀ p, pB1 (π p) = ᾱ (pB0 p)) → ∀ f : P0,
      (∀ s : A1, ∃ (n : ℕ) (a : A0), α (pA0 f) ^ n * s = α a) →
      (∀ a : A0, α a = 0 → ∃ n : ℕ, pA0 f ^ n * a = 0) →
      (∀ s : Ab1, ∃ (n : ℕ) (b : Ab0), ᾱ (pB0 f) ^ n * s = ᾱ b) →
      (∀ b : Ab0, ᾱ b = 0 → ∃ n : ℕ, pB0 f ^ n * b = 0) →
      (∀ c : B0, β c = 0 → ∃ n : ℕ, r0 (pA0 f) ^ n * c = 0) →
      (∀ s : P1, ∃ (n : ℕ) (p : P0), π f ^ n * s = π p) ∧
        (∀ p : P0, π p = 0 → ∃ n : ℕ, f ^ n * p = 0) := by
    intro P0 P1 A0 A1 Ab0 Ab1 B0 B1 _ _ _ _ _ _ _ _ pA0 pB0 r0 e0 pA1 pB1 r1 e1 α ᾱ β π w0 ex0
      inj0 w1 inj1 cA cB πA πB f iA iiA iB iiB iiβ
    constructor
    · intro s
      obtain ⟨n, a, hna⟩ := iA (pA1 s)
      obtain ⟨m, b, hmb⟩ := iB (pB1 s)
      have hA : α (pA0 f) ^ (n + m) * pA1 s = α (pA0 f ^ m * a) := by
        rw [map_mul, map_pow, ← hna]; ring
      have hB : ᾱ (pB0 f) ^ (n + m) * pB1 s = ᾱ (pB0 f ^ n * b) := by
        rw [map_mul, map_pow, ← hmb]; ring
      have hf : r1 (α (pA0 f)) = e1 (ᾱ (pB0 f)) := by rw [← πA, ← πB, w1]
      have hβ : β (r0 (pA0 f ^ m * a) - e0 (pB0 f ^ n * b)) = 0 := by
        rw [map_sub, ← cA, ← cB, ← hA, ← hB, map_mul, map_mul, map_pow, map_pow, hf, w1, sub_self]
      obtain ⟨k, hk⟩ := iiβ _ hβ
      have hk' : r0 (pA0 f ^ k * (pA0 f ^ m * a)) = e0 (pB0 f ^ k * (pB0 f ^ n * b)) := by
        rw [map_mul, map_mul e0, map_pow, map_pow, ← w0 f]
        rw [mul_sub, sub_eq_zero] at hk
        exact hk
      obtain ⟨p, hpA, hpB⟩ := ex0 _ _ hk'
      refine ⟨k + (n + m), p, inj1 _ _ ?_ ?_⟩
      · rw [map_mul, map_pow, πA, πA, hpA, map_mul, map_pow, ← hA, pow_add]; ring
      · rw [map_mul, map_pow, πB, πB, hpB, map_mul, map_pow, ← hB, pow_add]; ring
    · intro p hp
      have h1 : α (pA0 p) = 0 := by rw [← πA, hp, map_zero]
      have h2 : ᾱ (pB0 p) = 0 := by rw [← πB, hp, map_zero]
      obtain ⟨n, hn⟩ := iiA _ h1
      obtain ⟨m, hm⟩ := iiB _ h2
      refine ⟨n + m, inj0 _ _ ?_ ?_⟩
      · rw [map_mul, map_pow, map_zero, pow_add, mul_comm (pA0 f ^ n), mul_assoc, hn, mul_zero]
      · rw [map_mul, map_pow, map_zero, pow_add, mul_assoc, hm, mul_zero]

  have t_c7 : ∀ {P A Ab B : Type u} [CommRing P] [CommRing A] [CommRing Ab] [CommRing B]
      (pA : P →+* A) (pB : P →+* Ab) (r : A →+* B) (e : Ab →+* B),
      (∀ p, r (pA p) = e (pB p)) → (∀ a b, r a = e b → ∃ p, pA p = a ∧ pB p = b) →
      Function.Surjective r → ∀ (SA : Set (PrimeSpectrum A)) (SAb : Set (PrimeSpectrum Ab)),
      IsOpen SA → IsOpen SAb → PrimeSpectrum.comap r ⁻¹' SA = PrimeSpectrum.comap e ⁻¹' SAb →
      ∀ z : PrimeSpectrum P, ((∃ x ∈ SA, PrimeSpectrum.comap pA x = z) ∨
        (∃ y ∈ SAb, PrimeSpectrum.comap pB y = z)) →
      ∃ f : P, f ∉ z.asIdeal ∧ (∀ x : PrimeSpectrum A, pA f ∉ x.asIdeal → x ∈ SA) ∧
        (∀ y : PrimeSpectrum Ab, pB f ∉ y.asIdeal → y ∈ SAb) := by
    intro P A Ab B _ _ _ _ pA pB r e w ex hr SA SAb hSA hSAb htr
    have hrange : ∀ x : PrimeSpectrum A, RingHom.ker r ≤ x.asIdeal →
        ∃ v : PrimeSpectrum B, PrimeSpectrum.comap r v = x := by
      intro x hx
      have : x ∈ Set.range (PrimeSpectrum.comap r) := by
        rw [range_comap_of_surjective _ r hr, PrimeSpectrum.mem_zeroLocus]
        exact hx
      exact this
    have caseB : ∀ y ∈ SAb, ∃ f : P, f ∉ (PrimeSpectrum.comap pB y).asIdeal ∧
        (∀ x : PrimeSpectrum A, pA f ∉ x.asIdeal → x ∈ SA) ∧
        (∀ y : PrimeSpectrum Ab, pB f ∉ y.asIdeal → y ∈ SAb) := by
      intro y hy
      obtain ⟨_, ⟨g, rfl⟩, hyg, hgS⟩ :=
        PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hy hSAb
      have hyg' : g ∉ y.asIdeal := (PrimeSpectrum.mem_basicOpen g y).mp hyg
      obtain ⟨a0, ha0⟩ := hr (e g)
      set J := PrimeSpectrum.vanishingIdeal (SAᶜ) with hJ
      have hrad : a0 ∈ (J ⊔ RingHom.ker r).radical := by
        rw [Ideal.radical_eq_sInf, Submodule.mem_sInf]
        rintro x' ⟨hle, hxp⟩
        by_contra hna
        let x : PrimeSpectrum A := ⟨x', hxp⟩
        have hxc : x ∈ SAᶜ := by
          have : x ∈ PrimeSpectrum.zeroLocus (J : Set A) := by
            rw [PrimeSpectrum.mem_zeroLocus]
            exact fun t ht => hle (Ideal.mem_sup_left ht)
          rw [hJ, PrimeSpectrum.zeroLocus_vanishingIdeal_eq_closure,
            hSA.isClosed_compl.closure_eq] at this
          exact this
        obtain ⟨v, hv⟩ := hrange x (fun t ht => hle (Ideal.mem_sup_right ht))
        apply hxc
        have hv1 : PrimeSpectrum.comap e v ∈ SAb := by
          apply hgS
          rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen, PrimeSpectrum.comap_asIdeal,
            Ideal.mem_comap, ← ha0]
          intro hc
          apply hna
          have : a0 ∈ (PrimeSpectrum.comap r v).asIdeal := hc
          rw [hv] at this
          exact this
        have hv2 : v ∈ PrimeSpectrum.comap r ⁻¹' SA := by rw [htr]; exact hv1
        rw [← hv]; exact hv2
      obtain ⟨N, hN⟩ := Ideal.mem_radical_iff.mp hrad
      obtain ⟨j, hj, i, hi, hji⟩ := Submodule.mem_sup.mp hN
      have hrj : r j = e (g ^ N) := by
        have : r j + r i = r a0 ^ N := by rw [← map_add, hji, map_pow]
        rw [RingHom.mem_ker.mp hi, add_zero, ha0, ← map_pow] at this
        exact this
      obtain ⟨f, hfA, hfB⟩ := ex (j * a0) (g ^ (N + 1))
        (by rw [map_mul, hrj, ha0, ← map_mul, pow_succ])
      refine ⟨f, ?_, ?_, ?_⟩
      · rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, hfB]
        exact fun h => hyg' (y.isPrime.mem_of_pow_mem _ h)
      · intro x hx
        rw [hfA] at hx
        by_contra hxS
        apply hx
        apply Ideal.mul_mem_right
        exact (PrimeSpectrum.mem_vanishingIdeal _ _).mp hj x hxS
      · intro y' hy'
        rw [hfB] at hy'
        apply hgS
        rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
        intro hg
        exact hy' (by rw [pow_succ]; exact Ideal.mul_mem_left _ _ hg)
    rintro z (⟨x, hx, rfl⟩ | ⟨y, hy, rfl⟩)
    · by_cases hI : RingHom.ker r ≤ x.asIdeal
      · obtain ⟨v, rfl⟩ := hrange x hI
        have hv : v ∈ PrimeSpectrum.comap e ⁻¹' SAb := by rw [← htr]; exact hx
        have hcomp : r.comp pA = e.comp pB := RingHom.ext w
        have hz : PrimeSpectrum.comap pA (PrimeSpectrum.comap r v) =
            PrimeSpectrum.comap pB (PrimeSpectrum.comap e v) := by
          rw [← Function.comp_apply (f := PrimeSpectrum.comap pA), ← PrimeSpectrum.comap_comp,
            hcomp, PrimeSpectrum.comap_comp, Function.comp_apply]
        rw [hz]
        exact caseB _ hv
      · obtain ⟨i, hi, hix⟩ := SetLike.not_le_iff_exists.mp hI
        obtain ⟨_, ⟨g, rfl⟩, hxg, hgS⟩ :=
          PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hx hSA
        have hxg' : g ∉ x.asIdeal := (PrimeSpectrum.mem_basicOpen g x).mp hxg
        obtain ⟨f, hfA, hfB⟩ := ex (i * g) 0
          (by rw [map_mul, RingHom.mem_ker.mp hi, zero_mul, map_zero])
        refine ⟨f, ?_, ?_, ?_⟩
        · rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap, hfA]
          intro h
          rcases x.isPrime.mem_or_mem h with h | h
          · exact hix h
          · exact hxg' h
        · intro x' hx'
          rw [hfA] at hx'
          apply hgS
          rw [SetLike.mem_coe, PrimeSpectrum.mem_basicOpen]
          exact fun hg => hx' (Ideal.mul_mem_left _ _ hg)
        · intro y' hy'
          rw [hfB] at hy'
          exact absurd y'.asIdeal.zero_mem hy'
    · exact caseB y hy

  have t_iso : ∀ (R S : CommRingCat.{u}) (φ : R ⟶ S) (f : ↑R),
      Function.Bijective ⇑(Localization.awayMap φ.hom f) ↔
        IsIso (Spec.map φ ∣_ PrimeSpectrum.basicOpen f) := by
    intro R S φ f
    exact ((Arrow.isIso_hom_iff_isIso_hom_of_isIso (SpecMapRestrictBasicOpenIso φ f).hom).trans
      isIso_SpecMap_iff).symm
  have t_pt : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) (U : Y.Opens) (p : ↥(h ⁻¹ᵁ U)),
      ((h ∣_ U) p).1 = h p.1 := by
    intro X Y h U p
    have := congrArg (fun g => g p) (morphismRestrict_ι h U)
    simp only [Scheme.Hom.comp_apply, Scheme.Opens.ι_apply] at this
    exact this
  have g_open : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) [IsOpenImmersion h] (U : Y.Opens),
      IsOpenImmersion (h ∣_ U) := fun _ _ => inferInstance
  have g_surj : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) (U : Y.Opens),
      (∀ y : Y, y ∈ U → y ∈ Set.range h) → Surjective (h ∣_ U) := by
    intro X Y h U H
    refine ⟨fun y => ?_⟩
    obtain ⟨x, hx⟩ := H y.1 y.2
    have hxU : x ∈ h ⁻¹ᵁ U := by rw [Scheme.Hom.mem_preimage, hx]; exact y.2
    exact ⟨⟨x, hxU⟩, Subtype.ext ((t_pt h U _).trans hx)⟩
  have g_range : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) (U : Y.Opens),
      Surjective (h ∣_ U) → ∀ y : Y, y ∈ U → y ∈ Set.range h := by
    intro X Y h U hs y hy
    obtain ⟨p, hp⟩ := hs.surj ⟨y, hy⟩
    exact ⟨p.1, (t_pt h U p).symm.trans (congrArg Subtype.val hp)⟩
  have g_oi : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) (U : Y.Opens), IsIso (h ∣_ U) →
      IsOpenImmersion ((h ⁻¹ᵁ U).ι ≫ h) := by
    intro X Y h U _
    rw [← morphismRestrict_ι]; infer_instance
  have g_inj : ∀ {X Y : Scheme.{u}} (h : X ⟶ Y) (U : Y.Opens), IsIso (h ∣_ U) →
      ∀ x y : X, h x ∈ U → h x = h y → x = y := by
    intro X Y h U _ x y hx hxy
    have hx' : x ∈ h ⁻¹ᵁ U := hx
    have hy' : y ∈ h ⁻¹ᵁ U := by rw [Scheme.Hom.mem_preimage, ← hxy]; exact hx
    have h1 : (h ∣_ U) ⟨x, hx'⟩ = (h ∣_ U) ⟨y, hy'⟩ :=
      Subtype.ext ((t_pt h U _).trans (hxy.trans (t_pt h U ⟨y, hy'⟩).symm))
    exact congrArg Subtype.val ((h ∣_ U).isOpenEmbedding.injective h1)

  have t_c3 : ∀ (R S : CommRingCat.{u}) (φ : R ⟶ S), IsOpenImmersion (Spec.map φ) → ∀ f : ↑R,
      (∀ x : ↥(Spec R), f ∉ x.asIdeal → x ∈ Set.range ⇑(Spec.map φ)) →
      Function.Bijective ⇑(Localization.awayMap φ.hom f) := by
    intro R S φ hφ f hf
    refine (t_iso R S φ f).mpr ?_
    exact (isIso_iff_isOpenImmersion_and_surjective _).mpr
      ⟨g_open _ _, g_surj _ _ (fun y hy => hf y hy)⟩

  have t_c4 : ∀ (P0 P1 : CommRingCat.{u}) (π : P0 ⟶ P1) (f : ↑P0),
      Function.Bijective ⇑(Localization.awayMap π.hom f) →
      ∀ z : ↥(Spec P0), f ∉ z.asIdeal → z ∈ Set.range ⇑(Spec.map π) := by
    intro P0 P1 π f hb z hz
    have h1 := ((isIso_iff_isOpenImmersion_and_surjective _).mp ((t_iso P0 P1 π f).mp hb)).2
    exact g_range _ _ h1 z hz

  have t_c5 : ∀ (P0 P1 : CommRingCat.{u}) (π : P0 ⟶ P1),
      (∀ x : ↥(Spec P1), ∃ f : ↑P0, π.hom f ∉ x.asIdeal ∧
        Function.Bijective ⇑(Localization.awayMap π.hom f)) → IsOpenImmersion (Spec.map π) := by
    intro P0 P1 π H
    apply IsOpenImmersion.of_forall_source_exists
    · intro x y hxy
      obtain ⟨f, hfx, hb⟩ := H x
      exact g_inj _ _ ((t_iso P0 P1 π f).mp hb) x y hfx hxy
    · intro x
      obtain ⟨f, hfx, hb⟩ := H x
      refine ⟨_, (Spec.map π ⁻¹ᵁ PrimeSpectrum.basicOpen f).ι, inferInstance, ?_,
        g_oi _ _ ((t_iso P0 P1 π f).mp hb)⟩
      rw [Scheme.Opens.opensRange_ι]
      exact hfx

  have elts : ∀ (P A Ab B : CommRingCat.{u}) (pA : P ⟶ A) (pB : P ⟶ Ab) (r : A ⟶ B)
      (e : Ab ⟶ B), IsPullback pA pB r e →
      (∀ p : P, r.hom (pA.hom p) = e.hom (pB.hom p)) ∧
      (∀ (a : A) (b : Ab), r.hom a = e.hom b → ∃ p : P, pA.hom p = a ∧ pB.hom p = b) ∧
      (∀ p q : P, pA.hom p = pA.hom q → pB.hom p = pB.hom q → p = q) := by
    intro P A Ab B pA pB r e hpb
    obtain ⟨_, hinj, hex⟩ :=
      (Limits.Types.isPullback_iff _ _ _ _).mp (hpb.map (forget CommRingCat.{u}))
    refine ⟨fun p => ?_, fun a b h => hex a b h, fun p q h1 h2 => hinj p q ⟨h1, h2⟩⟩
    have := congrArg (fun f => f.hom p) hpb.w
    simpa using this

  intro A0 A1 Ab0 Ab1 B0 B1 P0 P1 r0 r1 e0 e1 α ᾱ β pA0 pB0 pA1 pB1 π hpb0 hpb1 hr0 hr1 hoA hoAb
    hoB hcA hcB htrA htrB hπA hπB
  obtain ⟨w0, ex0, inj0⟩ := elts _ _ _ _ _ _ _ _ hpb0
  obtain ⟨w1, -, inj1⟩ := elts _ _ _ _ _ _ _ _ hpb1
  have cA : ∀ a, r1.hom (α.hom a) = β.hom (r0.hom a) := fun a => by
    have := congrArg (fun g => g.hom a) hcA
    simpa using this
  have cB : ∀ b, e1.hom (ᾱ.hom b) = β.hom (e0.hom b) := fun b => by
    have := congrArg (fun g => g.hom b) hcB
    simpa using this
  have πA : ∀ p, pA1.hom (π.hom p) = α.hom (pA0.hom p) := fun p => by
    have := congrArg (fun g => g.hom p) hπA
    simpa using this
  have πB : ∀ p, pB1.hom (π.hom p) = ᾱ.hom (pB0.hom p) := fun p => by
    have := congrArg (fun g => g.hom p) hπB
    simpa using this
  have ptA : ∀ x, Spec.map π (Spec.map pA1 x) = Spec.map pA0 (Spec.map α x) := fun x => by
    rw [← Scheme.Hom.comp_apply, ← Spec.map_comp, hπA, Spec.map_comp, Scheme.Hom.comp_apply]
  have ptB : ∀ x, Spec.map π (Spec.map pB1 x) = Spec.map pB0 (Spec.map ᾱ x) := fun x => by
    rw [← Scheme.Hom.comp_apply, ← Spec.map_comp, hπB, Spec.map_comp, Scheme.Hom.comp_apply]
  set SA : Set ↥(Spec A0) := Set.range ⇑(Spec.map α) with hSAdef
  set SAb : Set ↥(Spec Ab0) := Set.range ⇑(Spec.map ᾱ) with hSAbdef
  have hSA : IsOpen SA := (Spec.map α).isOpenEmbedding.isOpen_range
  have hSAb : IsOpen SAb := (Spec.map ᾱ).isOpenEmbedding.isOpen_range
  have htr : ⇑(Spec.map r0) ⁻¹' SA = ⇑(Spec.map e0) ⁻¹' SAb := htrA.symm.trans htrB
  have K : ∀ z : ↥(Spec P0), ((∃ x ∈ SA, Spec.map pA0 x = z) ∨
      (∃ y ∈ SAb, Spec.map pB0 y = z)) →
      ∃ f : ↑P0, f ∉ z.asIdeal ∧ Function.Bijective ⇑(Localization.awayMap π.hom f) := by
    intro z hz
    obtain ⟨f, hfz, HA, HB⟩ :=
      t_c7 pA0.hom pB0.hom r0.hom e0.hom w0 ex0 hr0 SA SAb hSA hSAb htr z hz
    have bA := (t_c2 α.hom (pA0.hom f)).mp (t_c3 A0 A1 α hoA (pA0.hom f) (fun x hx => HA x hx))
    have bAb := (t_c2 ᾱ.hom (pB0.hom f)).mp
      (t_c3 Ab0 Ab1 ᾱ hoAb (pB0.hom f) (fun y hy => HB y hy))
    have bB := (t_c2 β.hom (r0.hom (pA0.hom f))).mp
      (t_c3 B0 B1 β hoB _ (fun v hv => by rw [htrA]; exact HA _ hv))
    exact ⟨f, hfz, (t_c2 π.hom f).mpr (t_c6 pA0.hom pB0.hom r0.hom e0.hom pA1.hom pB1.hom r1.hom
      e1.hom α.hom ᾱ.hom β.hom π.hom w0 ex0 inj0 w1 inj1 cA cB πA πB f bA.1 bA.2 bAb.1 bAb.2
      bB.2)⟩

  have hcovGen : ∀ (P A Ab B : CommRingCat.{u}) (pA : P ⟶ A) (pB : P ⟶ Ab) (r : A ⟶ B)
      (e : Ab ⟶ B), IsPullback pA pB r e → Function.Surjective ⇑(ConcreteCategory.hom r) →
      ∀ z : ↥(Spec P), (∃ x, Spec.map pA x = z) ∨ (∃ y, Spec.map pB y = z) := by
    intro P A Ab B pA pB r e hpb hr
    have hr' : Function.Surjective r.hom := hr
    obtain ⟨hw, ex, inj⟩ := elts _ _ _ _ _ _ _ _ hpb
    have hsurjB : Function.Surjective pB.hom := fun b => by
      obtain ⟨a, ha⟩ := hr' (e.hom b)
      obtain ⟨p, -, hp⟩ := ex a b ha
      exact ⟨p, hp⟩
    intro z
    simp only [Spec.map_apply]
    haveI hq := z.isPrime
    by_cases hK : RingHom.ker pB.hom ≤ z.asIdeal
    · right
      haveI := Ideal.map_isPrime_of_surjective hsurjB hK
      refine ⟨⟨Ideal.map pB.hom z.asIdeal, this⟩, PrimeSpectrum.ext ?_⟩
      rw [PrimeSpectrum.comap_asIdeal]
      exact (Ideal.comap_map_of_surjective' _ hsurjB _).trans (sup_eq_left.mpr hK)
    · left
      obtain ⟨h, hhK, hhq⟩ := SetLike.not_le_iff_exists.mp hK
      have hh0 : pB.hom h = 0 := RingHom.mem_ker.mp hhK
      have hc : ∀ a : A, ∃ p : P, pA.hom p = pA.hom h * a ∧ pB.hom p = 0 := fun a =>
        ex _ _ (by rw [map_mul, hw, hh0, map_zero, zero_mul])
      choose c hcA hcB using hc
      have I1 : ∀ a a', c (a + a') = c a + c a' := fun a a' =>
        inj _ _ (by simp only [map_add, hcA]; ring) (by simp only [map_add, hcB, add_zero])
      have I2 : ∀ a a', c a * c a' = h * c (a * a') := fun a a' =>
        inj _ _ (by simp only [map_mul, hcA]; ring) (by simp only [map_mul, hcB, mul_zero])
      have I3 : ∀ p, c (pA.hom p) = h * p := fun p =>
        inj _ _ (by simp only [map_mul, hcA]) (by simp only [map_mul, hcB, hh0, zero_mul])
      have I4 : c 0 = 0 := inj _ _ (by simp only [hcA, mul_zero, map_zero])
        (by simp only [hcB, map_zero])
      have I5 : c 1 = h := by
        have := I3 1
        rwa [map_one, mul_one] at this
      let I : Ideal A :=
        { carrier := {a | c a ∈ z.asIdeal}
          add_mem' := fun {a a'} ha ha' => by
            show c (a + a') ∈ z.asIdeal
            rw [I1]; exact z.asIdeal.add_mem ha ha'
          zero_mem' := by
            show c 0 ∈ z.asIdeal
            rw [I4]; exact z.asIdeal.zero_mem
          smul_mem' := fun s {a} ha => by
            show c (s * a) ∈ z.asIdeal
            have : h * c (s * a) ∈ z.asIdeal := by
              rw [← I2]; exact z.asIdeal.mul_mem_left _ ha
            exact (hq.mem_or_mem this).resolve_left hhq }
      have hmemI : ∀ a, a ∈ I ↔ c a ∈ z.asIdeal := fun a => Iff.rfl
      have hIp : I.IsPrime := by
        refine ⟨?_, ?_⟩
        · rw [Ideal.ne_top_iff_one, hmemI, I5]; exact hhq
        · intro a a' haa
          rw [hmemI] at haa
          rw [hmemI, hmemI]
          apply hq.mem_or_mem
          rw [I2]; exact z.asIdeal.mul_mem_left _ haa
      refine ⟨⟨I, hIp⟩, PrimeSpectrum.ext ?_⟩
      rw [PrimeSpectrum.comap_asIdeal]
      ext p
      rw [Ideal.mem_comap]
      show c (pA.hom p) ∈ z.asIdeal ↔ p ∈ z.asIdeal
      rw [I3]
      exact ⟨fun h' => (hq.mem_or_mem h').resolve_left hhq, fun h' => z.asIdeal.mul_mem_left _ h'⟩
  have hcov := hcovGen _ _ _ _ _ _ _ _ hpb1 hr1
  have G1 : IsOpenImmersion (Spec.map π) := by
    apply t_c5
    intro x
    have hz : (∃ x' ∈ SA, Spec.map pA0 x' = Spec.map π x) ∨
        (∃ y ∈ SAb, Spec.map pB0 y = Spec.map π x) := by
      rcases hcov x with ⟨x1, rfl⟩ | ⟨y1, rfl⟩
      · exact Or.inl ⟨_, ⟨x1, rfl⟩, (ptA x1).symm⟩
      · exact Or.inr ⟨_, ⟨y1, rfl⟩, (ptB y1).symm⟩
    obtain ⟨f, hf, hb⟩ := K _ hz
    exact ⟨f, hf, hb⟩
  refine ⟨G1, fun z => ⟨?_, ?_⟩⟩
  · rintro ⟨x, rfl⟩
    rcases hcov x with ⟨x1, rfl⟩ | ⟨y1, rfl⟩
    · exact Or.inl ⟨x1, (ptA x1).symm⟩
    · exact Or.inr ⟨y1, (ptB y1).symm⟩
  · rintro (⟨x, hx⟩ | ⟨x, hx⟩)
    · obtain ⟨f, hf, hb⟩ := K z (Or.inl ⟨_, ⟨x, rfl⟩, hx⟩)
      exact t_c4 P0 P1 π f hb z hf
    · obtain ⟨f, hf, hb⟩ := K z (Or.inr ⟨_, ⟨x, rfl⟩, hx⟩)
      exact t_c4 P0 P1 π f hb z hf

theorem wcpa_dj_lmfg_chart_system_props : ∀ (Z' Zb Y : Scheme.{u}) (yf : Y ⟶ Z') (ψb : Y ⟶ Zb) (m : ℕ)
    (U' : Fin m → Z'.Opens) (Ub : Fin m → Zb.Opens), IsClosedImmersion yf →
    (∀ T : Finset (Fin m), T.Nonempty → IsAffineOpen (T.inf U')) →
    (∀ T : Finset (Fin m), T.Nonempty → IsAffineOpen (T.inf Ub)) →
    ∀ (htrT : ∀ T : Finset (Fin m), yf ⁻¹ᵁ (T.inf U') = ψb ⁻¹ᵁ (T.inf Ub))
      (P : Finset (Fin m) → CommRingCat.{u}) (pA : ∀ T, P T ⟶ Γ(Z', T.inf U'))
      (pB : ∀ T, P T ⟶ Γ(Zb, T.inf Ub)) (π : ∀ T T' : Finset (Fin m), T ⊆ T' → (P T ⟶ P T')),
    (∀ T, IsPullback (pA T) (pB T) (yf.appLE (T.inf U') (yf ⁻¹ᵁ (T.inf U')) le_rfl)
        (ψb.appLE (T.inf Ub) (yf ⁻¹ᵁ (T.inf U')) (htrT T).le)) →
    (∀ T T' (h : T ⊆ T'), π T T' h ≫ pA T' = pA T ≫ Z'.presheaf.map (homOfLE (Finset.inf_mono h)).op) →
    (∀ T T' (h : T ⊆ T'), π T T' h ≫ pB T' = pB T ≫ Zb.presheaf.map (homOfLE (Finset.inf_mono h)).op) →
    (∀ T T' (h : T ⊆ T'), T.Nonempty → IsOpenImmersion (Spec.map (π T T' h))) ∧
    (∀ T T1 T2 (h1 : T ⊆ T1) (h2 : T ⊆ T2), T.Nonempty →
        Set.range (Spec.map (π T T1 h1)) ∩ Set.range (Spec.map (π T T2 h2)) ⊆
          Set.range (Spec.map (π T (T1 ∪ T2) (h1.trans Finset.subset_union_left)))) ∧
    (∀ T T' (h : T ⊆ T') (x : ↥(Spec Γ(Z', T.inf U'))), T.Nonempty →
        Spec.map (pA T) x ∈ Set.range (Spec.map (π T T' h)) →
        x ∈ Set.range (Spec.map (Z'.presheaf.map (homOfLE (Finset.inf_mono h)).op))) ∧
    (∀ T T' (h : T ⊆ T') (x : ↥(Spec Γ(Zb, T.inf Ub))), T.Nonempty →
        Spec.map (pB T) x ∈ Set.range (Spec.map (π T T' h)) →
        x ∈ Set.range (Spec.map (Zb.presheaf.map (homOfLE (Finset.inf_mono h)).op))) :=
by
  intro Z' Zb Y yf ψb m U' Ub hyf hU' hUb htrT P pA pB π hpb hcA hcB

  have hVaff : ∀ T : Finset (Fin m), T.Nonempty → IsAffineOpen (yf ⁻¹ᵁ (T.inf U')) :=
    fun T hT => (hU' T hT).preimage yf

  have hsurj : ∀ T : Finset (Fin m), T.Nonempty →
      Function.Surjective ⇑(ConcreteCategory.hom
        (yf.appLE (T.inf U') (yf ⁻¹ᵁ (T.inf U')) le_rfl)) := by
    intro T hT
    rw [Scheme.Hom.appLE_eq_app]
    exact yf.app_surjective _ (hU' T hT)

  have key : ∀ (T T' : Finset (Fin m)) (h : T ⊆ T') (hT : T.Nonempty),
      IsOpenImmersion (Spec.map (π T T' h)) ∧
      (∀ z : ↥(Spec (P T)), z ∈ Set.range ⇑(Spec.map (π T T' h)) ↔
        (∃ x, Spec.map (pA T) (Spec.map (Z'.presheaf.map (homOfLE (Finset.inf_mono h)).op) x) = z) ∨
        (∃ x, Spec.map (pB T) (Spec.map (Zb.presheaf.map (homOfLE (Finset.inf_mono h)).op) x) = z)) ∧
      Set.range ⇑(Spec.map (Z'.presheaf.map (homOfLE (Finset.inf_mono h)).op)) =
        ⇑(hU' T hT).fromSpec ⁻¹' (↑(T'.inf U') : Set ↥Z') ∧
      Set.range ⇑(Spec.map (Zb.presheaf.map (homOfLE (Finset.inf_mono h)).op)) =
        ⇑(hUb T hT).fromSpec ⁻¹' (↑(T'.inf Ub) : Set ↥Zb) ∧
      ⇑(Spec.map (yf.appLE (T.inf U') (yf ⁻¹ᵁ (T.inf U')) le_rfl)) ⁻¹'
          Set.range ⇑(Spec.map (Z'.presheaf.map (homOfLE (Finset.inf_mono h)).op)) =
        ⇑(Spec.map (ψb.appLE (T.inf Ub) (yf ⁻¹ᵁ (T.inf U')) (htrT T).le)) ⁻¹'
          Set.range ⇑(Spec.map (Zb.presheaf.map (homOfLE (Finset.inf_mono h)).op)) := by
    intro T T' h hT
    have hT' : T'.Nonempty := hT.mono h
    have hV : yf ⁻¹ᵁ (T'.inf U') ≤ yf ⁻¹ᵁ (T.inf U') := yf.preimage_mono (Finset.inf_mono h)
    obtain ⟨oA, oB, rA, trA⟩ := wcpa_dj_lmfg_restrict_open_trace yf (T.inf U') (T'.inf U')
      (yf ⁻¹ᵁ (T.inf U')) (yf ⁻¹ᵁ (T'.inf U')) (Finset.inf_mono h) hV le_rfl (hU' T hT)
      (hU' T' hT') (hVaff T hT) (hVaff T' hT') rfl
    obtain ⟨oAb, -, rAb, trAb⟩ := wcpa_dj_lmfg_restrict_open_trace ψb (T.inf Ub) (T'.inf Ub)
      (yf ⁻¹ᵁ (T.inf U')) (yf ⁻¹ᵁ (T'.inf U')) (Finset.inf_mono h) hV (htrT T).le (hUb T hT)
      (hUb T' hT') (hVaff T hT) (hVaff T' hT') (htrT T').symm
    have c1 : Z'.presheaf.map (homOfLE (Finset.inf_mono h)).op ≫
        yf.appLE (T'.inf U') (yf ⁻¹ᵁ (T'.inf U')) le_rfl =
        yf.appLE (T.inf U') (yf ⁻¹ᵁ (T.inf U')) le_rfl ≫ Y.presheaf.map (homOfLE hV).op := by
      rw [Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
    have c2 : Zb.presheaf.map (homOfLE (Finset.inf_mono h)).op ≫
        ψb.appLE (T'.inf Ub) (yf ⁻¹ᵁ (T'.inf U')) (htrT T').le =
        ψb.appLE (T.inf Ub) (yf ⁻¹ᵁ (T.inf U')) (htrT T).le ≫ Y.presheaf.map (homOfLE hV).op := by
      rw [Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
    obtain ⟨hoi, hrange⟩ := wcpa_dj_lmfg_chart_restrict_open _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
      (pA T) (pB T) (pA T') (pB T') (π T T' h) (hpb T) (hpb T') (hsurj T hT) (hsurj T' hT')
      oA oAb oB c1 c2 trA trAb (hcA T T' h) (hcB T T' h)
    exact ⟨hoi, hrange, rA, rAb, trA.symm.trans trAb⟩

  have pinch : ∀ (T : Finset (Fin m)), T.Nonempty →
      ∀ (SA1 SA2 : Set ↥(Spec Γ(Z', T.inf U'))) (SB1 SB2 : Set ↥(Spec Γ(Zb, T.inf Ub))),
      ⇑(Spec.map (yf.appLE (T.inf U') (yf ⁻¹ᵁ (T.inf U')) le_rfl)) ⁻¹' SA1 =
        ⇑(Spec.map (ψb.appLE (T.inf Ub) (yf ⁻¹ᵁ (T.inf U')) (htrT T).le)) ⁻¹' SB1 →
      ⇑(Spec.map (yf.appLE (T.inf U') (yf ⁻¹ᵁ (T.inf U')) le_rfl)) ⁻¹' SA2 =
        ⇑(Spec.map (ψb.appLE (T.inf Ub) (yf ⁻¹ᵁ (T.inf U')) (htrT T).le)) ⁻¹' SB2 →
      ((⇑(Spec.map (pA T)) '' SA1 ∪ ⇑(Spec.map (pB T)) '' SB1) ∩
          (⇑(Spec.map (pA T)) '' SA2 ∪ ⇑(Spec.map (pB T)) '' SB2) ⊆
        ⇑(Spec.map (pA T)) '' (SA1 ∩ SA2) ∪ ⇑(Spec.map (pB T)) '' (SB1 ∩ SB2)) ∧
      (∀ x, Spec.map (pA T) x ∈ ⇑(Spec.map (pA T)) '' SA1 ∪ ⇑(Spec.map (pB T)) '' SB1 →
        x ∈ SA1) ∧
      (∀ y, Spec.map (pB T) y ∈ ⇑(Spec.map (pA T)) '' SA1 ∪ ⇑(Spec.map (pB T)) '' SB1 →
        y ∈ SB1) := by
    intro T hT
    obtain ⟨-, hb, hc, hinj⟩ :=
      wcpa_dj_lmfg_milnor_spec_points _ _ _ _ _ _ _ _ (hpb T) (hsurj T hT)
    refine wcpa_dj_lmfg_pinch_sets ⇑(Spec.map (pA T)) ⇑(Spec.map (pB T))
      ⇑(Spec.map (yf.appLE (T.inf U') (yf ⁻¹ᵁ (T.inf U')) le_rfl))
      ⇑(Spec.map (ψb.appLE (T.inf Ub) (yf ⁻¹ᵁ (T.inf U')) (htrT T).le)) ?_ hb hc hinj
    intro v
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, ← Spec.map_comp, ← Spec.map_comp,
      (hpb T).w]
  refine ⟨fun T T' h hT => (key T T' h hT).1, ?_, ?_, ?_⟩
  ·
    intro T T1 T2 h1 h2 hT z hz
    obtain ⟨-, hr1, rA1, rB1, htr1⟩ := key T T1 h1 hT
    obtain ⟨-, hr2, rA2, rB2, htr2⟩ := key T T2 h2 hT
    have h12 : T ⊆ T1 ∪ T2 := h1.trans Finset.subset_union_left
    obtain ⟨-, hr12, rA12, rB12, -⟩ := key T (T1 ∪ T2) h12 hT
    have hP := (pinch T hT _ _ _ _ htr1 htr2).1
    have hz1 : z ∈ ⇑(Spec.map (pA T)) ''
          Set.range ⇑(Spec.map (Z'.presheaf.map (homOfLE (Finset.inf_mono h1)).op)) ∪
        ⇑(Spec.map (pB T)) ''
          Set.range ⇑(Spec.map (Zb.presheaf.map (homOfLE (Finset.inf_mono h1)).op)) := by
      rcases (hr1 z).1 hz.1 with ⟨x, hx⟩ | ⟨y, hy⟩
      · exact Or.inl ⟨_, ⟨x, rfl⟩, hx⟩
      · exact Or.inr ⟨_, ⟨y, rfl⟩, hy⟩
    have hz2 : z ∈ ⇑(Spec.map (pA T)) ''
          Set.range ⇑(Spec.map (Z'.presheaf.map (homOfLE (Finset.inf_mono h2)).op)) ∪
        ⇑(Spec.map (pB T)) ''
          Set.range ⇑(Spec.map (Zb.presheaf.map (homOfLE (Finset.inf_mono h2)).op)) := by
      rcases (hr2 z).1 hz.2 with ⟨x, hx⟩ | ⟨y, hy⟩
      · exact Or.inl ⟨_, ⟨x, rfl⟩, hx⟩
      · exact Or.inr ⟨_, ⟨y, rfl⟩, hy⟩
    have hz12 := hP ⟨hz1, hz2⟩
    have eA : Set.range ⇑(Spec.map (Z'.presheaf.map (homOfLE (Finset.inf_mono (f := U') h1)).op)) ∩
        Set.range ⇑(Spec.map (Z'.presheaf.map (homOfLE (Finset.inf_mono (f := U') h2)).op)) =
        Set.range ⇑(Spec.map (Z'.presheaf.map
          (homOfLE (Finset.inf_mono (f := U') h12)).op)) := by
      rw [rA1, rA2, rA12, Finset.inf_union, TopologicalSpace.Opens.coe_inf, Set.preimage_inter]
    have eB : Set.range ⇑(Spec.map (Zb.presheaf.map (homOfLE (Finset.inf_mono (f := Ub) h1)).op)) ∩
        Set.range ⇑(Spec.map (Zb.presheaf.map (homOfLE (Finset.inf_mono (f := Ub) h2)).op)) =
        Set.range ⇑(Spec.map (Zb.presheaf.map
          (homOfLE (Finset.inf_mono (f := Ub) h12)).op)) := by
      rw [rB1, rB2, rB12, Finset.inf_union, TopologicalSpace.Opens.coe_inf, Set.preimage_inter]
    rw [eA, eB] at hz12
    apply (hr12 z).2
    rcases hz12 with ⟨x, ⟨x', rfl⟩, hx⟩ | ⟨y, ⟨y', rfl⟩, hy⟩
    · exact Or.inl ⟨x', hx⟩
    · exact Or.inr ⟨y', hy⟩
  ·
    intro T T' h x hT hx
    obtain ⟨-, hr, -, -, htr⟩ := key T T' h hT
    apply (pinch T hT _ _ _ _ htr htr).2.1 x
    rcases (hr _).1 hx with ⟨x1, hx1⟩ | ⟨y1, hy1⟩
    · exact Or.inl ⟨_, ⟨x1, rfl⟩, hx1⟩
    · exact Or.inr ⟨_, ⟨y1, rfl⟩, hy1⟩
  ·
    intro T T' h y hT hy
    obtain ⟨-, hr, -, -, htr⟩ := key T T' h hT
    apply (pinch T hT _ _ _ _ htr htr).2.2 y
    rcases (hr _).1 hy with ⟨x1, hx1⟩ | ⟨y1, hy1⟩
    · exact Or.inl ⟨_, ⟨x1, rfl⟩, hx1⟩
    · exact Or.inr ⟨_, ⟨y1, rfl⟩, hy1⟩

theorem wcpa_dj_lmfg_affine_glue : ∀ (m : ℕ) (P : Finset (Fin m) → CommRingCat.{u})
    (π : ∀ T T' : Finset (Fin m), T ⊆ T' → (P T ⟶ P T')),
    (∀ T, π T T (Finset.Subset.refl T) = 𝟙 (P T)) →
    (∀ T T' T'' (h : T ⊆ T') (h' : T' ⊆ T''), π T T' h ≫ π T' T'' h' = π T T'' (h.trans h')) →
    (∀ T T' (h : T ⊆ T'), T.Nonempty → IsOpenImmersion (Spec.map (π T T' h))) →
    (∀ T T1 T2 (h1 : T ⊆ T1) (h2 : T ⊆ T2), T.Nonempty →
      Set.range (Spec.map (π T T1 h1)) ∩ Set.range (Spec.map (π T T2 h2)) ⊆
        Set.range (Spec.map (π T (T1 ∪ T2) (h1.trans Finset.subset_union_left)))) →
    ∃ (Z : Scheme.{u}) (ι : ∀ T : Finset (Fin m), T.Nonempty → (Spec (P T) ⟶ Z)),
      (∀ T T' (h : T ⊆ T') (hT : T.Nonempty),
        Spec.map (π T T' h) ≫ ι T hT = ι T' (Finset.Nonempty.mono h hT)) ∧
      (∀ T (hT : T.Nonempty), IsOpenImmersion (ι T hT)) ∧
      (∀ z : ↥Z, ∃ (a : Fin m) (x : ↥(Spec (P {a}))), ι {a} (Finset.singleton_nonempty a) x = z) ∧
      (∀ T1 T2 (h1 : T1.Nonempty) (h2 : T2.Nonempty) (x1 : ↥(Spec (P T1))) (x2 : ↥(Spec (P T2))),
        ι T1 h1 x1 = ι T2 h2 x2 → ∃ x : ↥(Spec (P (T1 ∪ T2))),
          Spec.map (π T1 (T1 ∪ T2) Finset.subset_union_left) x = x1 ∧
          Spec.map (π T2 (T1 ∪ T2) Finset.subset_union_right) x = x2) ∧
      (∀ (X : Scheme.{u}) (g : ∀ T : Finset (Fin m), T.Nonempty → (Spec (P T) ⟶ X)),
        (∀ T T' (h : T ⊆ T') (hT : T.Nonempty),
          Spec.map (π T T' h) ≫ g T hT = g T' (Finset.Nonempty.mono h hT)) →
        ∃ g' : Z ⟶ X, ∀ T (hT : T.Nonempty), ι T hT ≫ g' = g T hT) :=
by
  intro m P π hid hcomp hoi hrange
  classical

  have hinj : ∀ (T T' : Finset (Fin m)) (h : T ⊆ T'), T.Nonempty →
      Function.Injective ⇑(Spec.map (π T T' h)) := by
    intro T T' h hT
    haveI := hoi T T' h hT
    exact (Spec.map (π T T' h)).isOpenEmbedding.isEmbedding.injective

  have hstar : ∀ (T T' T'' : Finset (Fin m)) (h : T ⊆ T') (h' : T' ⊆ T'')
      (x : ↥(Spec (P T''))),
      Spec.map (π T T' h) (Spec.map (π T' T'' h') x) = Spec.map (π T T'' (h.trans h')) x := by
    intro T T' T'' h h' x
    rw [← hcomp T T' T'' h h', Spec.map_comp, Scheme.Hom.comp_apply]

  have hlift : ∀ (T T1 T2 : Finset (Fin m)) (h1 : T ⊆ T1) (h2 : T ⊆ T2)
      (x1 : ↥(Spec (P T1))) (x2 : ↥(Spec (P T2))), T.Nonempty →
      Spec.map (π T T1 h1) x1 = Spec.map (π T T2 h2) x2 →
      ∃ x : ↥(Spec (P (T1 ∪ T2))),
        Spec.map (π T1 (T1 ∪ T2) Finset.subset_union_left) x = x1 ∧
        Spec.map (π T2 (T1 ∪ T2) Finset.subset_union_right) x = x2 := by
    intro T T1 T2 h1 h2 x1 x2 hT hx
    obtain ⟨x, hx'⟩ := hrange T T1 T2 h1 h2 hT
      (show Spec.map (π T T1 h1) x1 ∈ _ ∩ _ from ⟨⟨x1, rfl⟩, ⟨x2, hx.symm⟩⟩)
    refine ⟨x, hinj T T1 h1 hT ?_, hinj T T2 h2 hT ?_⟩
    · rw [hstar]; exact hx'
    · rw [hstar]; exact hx'.trans hx

  let J := {T : Finset (Fin m) // T.Nonempty}ᵒᵈ
  have hle : ∀ {i k : J}, (i ⟶ k) → (OrderDual.ofDual k).1 ⊆ (OrderDual.ofDual i).1 :=
    fun f => leOfHom f
  let F : J ⥤ Scheme.{u} :=
    { obj := fun i => Spec (P (OrderDual.ofDual i).1)
      map := fun {i k} f => Spec.map (π _ _ (hle f))
      map_id := fun i => by
        show Spec.map (π _ _ (Finset.Subset.refl _)) = _
        rw [hid, Spec.map_id]
      map_comp := fun {i k l} f g => by
        rw [← Spec.map_comp, hcomp] }
  haveI hI1 : ∀ {i k : J} (f : i ⟶ k), IsOpenImmersion (F.map f) :=
    fun {i k} f => hoi _ _ _ (OrderDual.ofDual k).2
  haveI hI2 : (F ⋙ Scheme.forget).IsLocallyDirected := by
    refine Functor.IsLocallyDirected.mk ?_
    intro i j k fi fj xi xj hx
    obtain ⟨x, hx1, hx2⟩ := hlift (OrderDual.ofDual k).1 (OrderDual.ofDual i).1
      (OrderDual.ofDual j).1 (hle fi) (hle fj) xi xj (OrderDual.ofDual k).2 hx
    exact ⟨OrderDual.toDual ⟨(OrderDual.ofDual i).1 ∪ (OrderDual.ofDual j).1,
      (OrderDual.ofDual i).2.mono Finset.subset_union_left⟩,
      homOfLE Finset.subset_union_left, homOfLE Finset.subset_union_right, x, hx1, hx2⟩
  haveI : Limits.HasColimit F := Scheme.IsLocallyDirected.instHasColimit F
  refine ⟨Limits.colimit F, fun T hT => Limits.colimit.ι F (OrderDual.toDual ⟨T, hT⟩),
    ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro T T' h hT
    exact Limits.colimit.w F
      (homOfLE h : OrderDual.toDual ⟨T', hT.mono h⟩ ⟶ OrderDual.toDual ⟨T, hT⟩)
  ·
    intro T hT
    exact Scheme.IsLocallyDirected.instIsOpenImmersionι F _
  ·
    intro z
    obtain ⟨i, xi, hxi⟩ := Scheme.IsLocallyDirected.ι_jointly_surjective F z
    obtain ⟨a, ha⟩ := (OrderDual.ofDual i).2
    have hsub : ({a} : Finset (Fin m)) ⊆ (OrderDual.ofDual i).1 :=
      Finset.singleton_subset_iff.mpr ha
    have hw : Spec.map (π {a} (OrderDual.ofDual i).1 hsub) ≫
        Limits.colimit.ι F (OrderDual.toDual ⟨{a}, Finset.singleton_nonempty a⟩) =
          Limits.colimit.ι F i :=
      Limits.colimit.w F (homOfLE hsub : i ⟶ OrderDual.toDual ⟨{a}, Finset.singleton_nonempty a⟩)
    refine ⟨a, Spec.map (π {a} (OrderDual.ofDual i).1 hsub) xi, ?_⟩
    show Limits.colimit.ι F (OrderDual.toDual ⟨{a}, Finset.singleton_nonempty a⟩)
      (Spec.map (π {a} (OrderDual.ofDual i).1 hsub) xi) = z
    rw [← hxi, ← hw]
    rfl
  ·
    intro T1 T2 h1 h2 x1 x2 hx
    obtain ⟨k, fi, fj, x, hx1, hx2⟩ := (Scheme.IsLocallyDirected.ι_eq_ι_iff F).mp hx
    have hK1 : T1 ⊆ (OrderDual.ofDual k).1 := hle fi
    have hK2 : T2 ⊆ (OrderDual.ofDual k).1 := hle fj
    refine ⟨Spec.map (π (T1 ∪ T2) _ (Finset.union_subset hK1 hK2)) x, ?_, ?_⟩
    · rw [hstar]; exact hx1
    · rw [hstar]; exact hx2
  ·
    intro X g hg
    let c : Limits.Cocone F :=
      { pt := X
        ι := { app := fun i => g (OrderDual.ofDual i).1 (OrderDual.ofDual i).2
               naturality := fun i k f =>
                 (hg _ _ (hle f) (OrderDual.ofDual k).2).trans (Category.comp_id _).symm } }
    exact ⟨Limits.colimit.desc F c, fun T hT => Limits.colimit.ι_desc c _⟩

theorem wcpa_dj_lmfg_side_map : ∀ (X Z : Scheme.{u}) (m : ℕ) (U : Fin m → X.Opens)
    (hU : ∀ T : Finset (Fin m), T.Nonempty → IsAffineOpen (T.inf U)),
    (⨆ a, U a) = ⊤ →
    ∀ (P : Finset (Fin m) → CommRingCat.{u}) (p : ∀ T, P T ⟶ Γ(X, T.inf U))
      (π : ∀ T T' : Finset (Fin m), T ⊆ T' → (P T ⟶ P T'))
      (ι : ∀ T : Finset (Fin m), T.Nonempty → (Spec (P T) ⟶ Z)),
    (∀ T T' (h : T ⊆ T'), π T T' h ≫ p T' = p T ≫ X.presheaf.map (homOfLE (Finset.inf_mono h)).op) →
    (∀ T T' (h : T ⊆ T') (hT : T.Nonempty),
      Spec.map (π T T' h) ≫ ι T hT = ι T' (Finset.Nonempty.mono h hT)) →
    (∀ T1 T2 (h1 : T1.Nonempty) (h2 : T2.Nonempty) (x1 : ↥(Spec (P T1))) (x2 : ↥(Spec (P T2))),
      ι T1 h1 x1 = ι T2 h2 x2 → ∃ x : ↥(Spec (P (T1 ∪ T2))),
        Spec.map (π T1 (T1 ∪ T2) Finset.subset_union_left) x = x1 ∧
        Spec.map (π T2 (T1 ∪ T2) Finset.subset_union_right) x = x2) →
    (∀ T T' (h : T ⊆ T') (x : ↥(Spec Γ(X, T.inf U))), T.Nonempty →
      Spec.map (p T) x ∈ Set.range (Spec.map (π T T' h)) →
      x ∈ Set.range (Spec.map (X.presheaf.map (homOfLE (Finset.inf_mono h)).op))) →
    ∃ i : X ⟶ Z, (∀ T (hT : T.Nonempty), (hU T hT).fromSpec ≫ i = Spec.map (p T) ≫ ι T hT) ∧
      ∀ (a : Fin m) (x : ↥X), (i x ∈ Set.range (ι {a} (Finset.singleton_nonempty a)) ↔ x ∈ U a) :=
by
  intro X Z m U hU hcov P p π ι hcomp hco hun htr
  classical

  have s2 : ∀ (V V' : X.Opens) (hle : V' ≤ V) (Q Q' : CommRingCat.{u})
      (q : Q ⟶ Γ(X, V)) (q' : Q' ⟶ Γ(X, V')) (κ : Q ⟶ Q') (j : Spec Q ⟶ Z) (j' : Spec Q' ⟶ Z),
      κ ≫ q' = q ≫ X.presheaf.map (homOfLE hle).op → Spec.map κ ≫ j = j' →
      X.homOfLE hle ≫ V.toSpecΓ ≫ Spec.map q ≫ j = V'.toSpecΓ ≫ Spec.map q' ≫ j' := by
    intro V V' hle Q Q' q q' κ j j' h1 h2
    rw [← Category.assoc, ← Scheme.Opens.toSpecΓ_SpecMap_presheaf_map V' V hle, Category.assoc,
      ← Category.assoc (Spec.map _) (Spec.map q), ← Spec.map_comp, ← h1, Spec.map_comp,
      Category.assoc, h2]

  let V : Fin m → X.Opens := fun a => ({a} : Finset (Fin m)).inf U
  have hcovV : (⨆ a, V a) = ⊤ := by
    simp only [V, Finset.inf_singleton]
    exact hcov
  let 𝒰 := X.openCoverOfIsOpenCover V (TopologicalSpace.IsOpenCover.mk hcovV)
  let φ : ∀ a : Fin m, 𝒰.X a ⟶ Z := fun a =>
    (V a).toSpecΓ ≫ Spec.map (p {a}) ≫ ι {a} (Finset.singleton_nonempty a)

  have hφ : ∀ a b : Fin m, X.homOfLE (inf_le_left : V a ⊓ V b ≤ V a) ≫
      ((V a).toSpecΓ ≫ Spec.map (p {a}) ≫ ι {a} (Finset.singleton_nonempty a)) =
      X.homOfLE (inf_le_right : V a ⊓ V b ≤ V b) ≫
      ((V b).toSpecΓ ≫ Spec.map (p {b}) ≫ ι {b} (Finset.singleton_nonempty b)) := by
    intro a b
    have hab : ({a} ∪ {b} : Finset (Fin m)).Nonempty :=
      (Finset.singleton_nonempty a).mono Finset.subset_union_left
    have k : V a ⊓ V b ≤ ({a} ∪ {b} : Finset (Fin m)).inf U := le_of_eq Finset.inf_union.symm
    have hWa : ({a} ∪ {b} : Finset (Fin m)).inf U ≤ V a := Finset.inf_mono Finset.subset_union_left
    have hWb : ({a} ∪ {b} : Finset (Fin m)).inf U ≤ V b := Finset.inf_mono Finset.subset_union_right
    have e1 : X.homOfLE (inf_le_left : V a ⊓ V b ≤ V a) = X.homOfLE k ≫ X.homOfLE hWa :=
      (Scheme.homOfLE_homOfLE X k hWa).symm
    have e2 : X.homOfLE (inf_le_right : V a ⊓ V b ≤ V b) = X.homOfLE k ≫ X.homOfLE hWb :=
      (Scheme.homOfLE_homOfLE X k hWb).symm
    have ea := s2 (V a) _ hWa _ _ (p {a}) (p ({a} ∪ {b}))
      (π {a} ({a} ∪ {b}) Finset.subset_union_left)
      (ι {a} (Finset.singleton_nonempty a)) (ι ({a} ∪ {b}) hab) (hcomp _ _ _) (hco _ _ _ _)
    have eb := s2 (V b) _ hWb _ _ (p {b}) (p ({a} ∪ {b}))
      (π {b} ({a} ∪ {b}) Finset.subset_union_right)
      (ι {b} (Finset.singleton_nonempty b)) (ι ({a} ∪ {b}) hab) (hcomp _ _ _) (hco _ _ _ _)
    rw [e1, e2, Category.assoc, Category.assoc, ea, eb]
  have key : ∀ a b : Fin m, Limits.pullback.fst (V a).ι (V b).ι ≫
      ((V a).toSpecΓ ≫ Spec.map (p {a}) ≫ ι {a} (Finset.singleton_nonempty a)) =
      Limits.pullback.snd (V a).ι (V b).ι ≫
      ((V b).toSpecΓ ≫ Spec.map (p {b}) ≫ ι {b} (Finset.singleton_nonempty b)) := by
    intro a b
    have h := isPullback_opens_inf (V a) (V b)
    rw [← h.isoPullback_inv_fst, ← h.isoPullback_inv_snd, Category.assoc, Category.assoc,
      hφ a b]
  have hglue : ∀ x y : 𝒰.I₀, Limits.pullback.fst (𝒰.f x) (𝒰.f y) ≫ φ x =
      Limits.pullback.snd (𝒰.f x) (𝒰.f y) ≫ φ y := fun x y => key x y
  let i : X ⟶ Z := 𝒰.glueMorphisms φ hglue
  have hi : ∀ a : Fin m, (V a).ι ≫ i =
      (V a).toSpecΓ ≫ Spec.map (p {a}) ≫ ι {a} (Finset.singleton_nonempty a) :=
    fun a => 𝒰.ι_glueMorphisms φ hglue a

  have chart : ∀ T (hT : T.Nonempty), (hU T hT).fromSpec ≫ i = Spec.map (p T) ≫ ι T hT := by
    intro T hT
    obtain ⟨a, ha⟩ := hT
    have hsub : ({a} : Finset (Fin m)) ⊆ T := Finset.singleton_subset_iff.mpr ha
    have hle : T.inf U ≤ V a := Finset.inf_mono hsub
    rw [← (hU T ⟨a, ha⟩).isoSpec_inv_ι, ← Scheme.homOfLE_ι X hle, Category.assoc, Category.assoc,
      hi a, s2 (V a) (T.inf U) hle _ _ (p {a}) (p T) (π {a} T hsub)
        (ι {a} (Finset.singleton_nonempty a)) (ι T ⟨a, ha⟩) (hcomp _ _ _) (hco _ _ _ _),
      ← (hU T ⟨a, ha⟩).isoSpec_hom, Iso.inv_hom_id_assoc]
  have hpt : ∀ T (hT : T.Nonempty) (y : ↥(Spec Γ(X, T.inf U))),
      i ((hU T hT).fromSpec y) = ι T hT (Spec.map (p T) y) := by
    intro T hT y
    rw [← Scheme.Hom.comp_apply, chart T hT, Scheme.Hom.comp_apply]
  refine ⟨i, chart, ?_⟩
  intro a x
  constructor
  · rintro ⟨w, hw⟩
    have hx : x ∈ (⨆ a, U a) := by rw [hcov]; trivial
    rw [TopologicalSpace.Opens.mem_iSup] at hx
    obtain ⟨b, hxb⟩ := hx
    have hxb' : x ∈ Set.range (hU {b} (Finset.singleton_nonempty b)).fromSpec := by
      rw [IsAffineOpen.range_fromSpec]
      show x ∈ ({b} : Finset (Fin m)).inf U
      rw [Finset.inf_singleton]
      exact hxb
    obtain ⟨y, hy⟩ := hxb'
    obtain ⟨x', hx'1, -⟩ := hun {b} {a} (Finset.singleton_nonempty b) (Finset.singleton_nonempty a)
      (Spec.map (p {b}) y) w (by rw [← hpt, hy, hw])
    obtain ⟨y', hy'⟩ := htr {b} ({b} ∪ {a}) Finset.subset_union_left y
      (Finset.singleton_nonempty b) ⟨x', hx'1⟩
    have hba : ({b} ∪ {a} : Finset (Fin m)).Nonempty :=
      (Finset.singleton_nonempty b).mono Finset.subset_union_left
    have hxab : x ∈ Set.range (hU ({b} ∪ {a}) hba).fromSpec := by
      refine ⟨y', ?_⟩
      rw [← hy, ← hy', ← Scheme.Hom.comp_apply, IsAffineOpen.map_fromSpec]
    rw [IsAffineOpen.range_fromSpec] at hxab
    exact (Finset.inf_le (Finset.mem_union_right _ (Finset.mem_singleton_self a)) :
      ({b} ∪ {a} : Finset (Fin m)).inf U ≤ U a) hxab
  · intro hx
    have hx' : x ∈ Set.range (hU {a} (Finset.singleton_nonempty a)).fromSpec := by
      rw [IsAffineOpen.range_fromSpec]
      show x ∈ ({a} : Finset (Fin m)).inf U
      rw [Finset.inf_singleton]
      exact hx
    obtain ⟨y, rfl⟩ := hx'
    exact ⟨_, (hpt _ _ y).symm⟩

theorem wcpa_dj_lmfg_chart_pullback : ∀ (Z' Zb Y Z : Scheme.{u}) (yf : Y ⟶ Z') (ψb : Y ⟶ Zb) (i' : Z' ⟶ Z) (ib : Zb ⟶ Z)
    (P : CommRingCat.{u}) (ι : Spec P ⟶ Z) [IsOpenImmersion ι] (A0 A' : Z'.Opens) (B0 B' : Zb.Opens)
    (O' : Z.Opens), A0 = A' → B0 = B' → ι.opensRange = O' →
    ∀ (hA0 : IsAffineOpen A0) (hB0 : IsAffineOpen B0) (pA : P ⟶ Γ(Z', A0)) (pB : P ⟶ Γ(Zb, B0))
      (h0 : yf ⁻¹ᵁ A0 ≤ ψb ⁻¹ᵁ B0),
    IsPullback pA pB (yf.appLE A0 (yf ⁻¹ᵁ A0) le_rfl) (ψb.appLE B0 (yf ⁻¹ᵁ A0) h0) →
    hA0.fromSpec ≫ i' = Spec.map pA ≫ ι → hB0.fromSpec ≫ ib = Spec.map pB ≫ ι →
    ∀ (h1 : A' ≤ i' ⁻¹ᵁ O') (h2 : B' ≤ ib ⁻¹ᵁ O') (h4 : yf ⁻¹ᵁ A' ≤ ψb ⁻¹ᵁ B'),
      IsPullback (i'.appLE O' A' h1) (ib.appLE O' B' h2)
        (yf.appLE A' (yf ⁻¹ᵁ A') le_rfl) (ψb.appLE B' (yf ⁻¹ᵁ A') h4) :=
by
  intro Z' Zb Y Z yf ψb i' ib P ι _ A0 A' B0 B' O' hAA hBB hO hA0 hB0 pA pB h0 hpb hA hB h1 h2 h4
  subst hAA hBB hO
  have hτ : (⊤ : (Spec P).Opens) ≤ ι ⁻¹ᵁ ι.opensRange := (Scheme.Hom.preimage_opensRange ι).ge
  have key : ∀ (X : Scheme.{u}) (i : X ⟶ Z) (A : X.Opens) (hA : IsAffineOpen A) (p : P ⟶ Γ(X, A)),
      hA.fromSpec ≫ i = Spec.map p ≫ ι → ∀ (h : A ≤ i ⁻¹ᵁ ι.opensRange),
      i.appLE ι.opensRange A h = ι.appLE ι.opensRange ⊤ hτ ≫ (Scheme.ΓSpecIso P).hom ≫ p := by
    intro X i A hA p hc h
    have hs : (⊤ : (Spec Γ(X, A)).Opens) ≤ hA.fromSpec ⁻¹ᵁ A := hA.fromSpec_preimage_self.ge
    have hc' : ∀ (φ ψ : Spec Γ(X, A) ⟶ Z), φ = ψ → ∀ p q,
        φ.appLE ι.opensRange ⊤ p = ψ.appLE ι.opensRange ⊤ q := by
      rintro φ _ rfl p q; rfl
    have e3 : i.appLE ι.opensRange A h ≫ hA.fromSpec.appLE A ⊤ hs =
        ι.appLE ι.opensRange ⊤ hτ ≫ (Spec.map p).appLE ⊤ ⊤ (by simp) := by
      have k1 := Scheme.Hom.appLE_comp_appLE hA.fromSpec i ι.opensRange A ⊤ h hs
      have k2 := Scheme.Hom.appLE_comp_appLE (Spec.map p) ι ι.opensRange ⊤ ⊤ hτ (by simp)
      rw [k1, k2]
      exact hc' _ _ hc _ _
    have e4 : hA.fromSpec.appLE A ⊤ hs = (Scheme.ΓSpecIso Γ(X, A)).inv := by
      have hid : ∀ (f : (Opposite.op (⊤ : (Spec Γ(X, A)).Opens)) ⟶ Opposite.op ⊤),
          (Spec Γ(X, A)).presheaf.map f = 𝟙 _ := by
        intro f; rw [Subsingleton.elim f (𝟙 _), CategoryTheory.Functor.map_id]
      rw [Scheme.Hom.appLE, IsAffineOpen.fromSpec_app_self, Category.assoc, ← Functor.map_comp,
        hid, Category.comp_id]
    have e5 : (Spec.map p).appLE ⊤ ⊤ (by simp) = (Spec.map p).appTop := Scheme.Hom.appLE_eq_app _
    rw [e4, e5] at e3
    rw [← Scheme.ΓSpecIso_naturality p, ← Category.assoc, ← e3, Category.assoc, Iso.inv_hom_id,
      Category.comp_id]
  have : IsIso (ι.app ι.opensRange) := Scheme.Hom.isIso_app ι ι.opensRange le_rfl
  have : IsIso (ι.appLE ι.opensRange ⊤ hτ) := by
    have : homOfLE hτ = eqToHom (Scheme.Hom.preimage_opensRange ι).symm := Subsingleton.elim _ _
    rw [Scheme.Hom.appLE, this]
    infer_instance
  let e : Γ(Z, ι.opensRange) ≅ P := asIso (ι.appLE ι.opensRange ⊤ hτ) ≪≫ Scheme.ΓSpecIso P
  have he : e.hom = ι.appLE ι.opensRange ⊤ hτ ≫ (Scheme.ΓSpecIso P).hom := rfl
  have KA := key Z' i' A0 hA0 pA hA h1
  have KB := key Zb ib B0 hB0 pB hB h2
  rw [← Category.assoc, ← he] at KA KB
  refine IsPullback.of_iso hpb e.symm (Iso.refl _) (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
  · rw [Iso.symm_hom, KA, Iso.inv_hom_id_assoc, Iso.refl_hom, Category.comp_id]
  · rw [Iso.symm_hom, KB, Iso.inv_hom_id_assoc, Iso.refl_hom, Category.comp_id]
  · simp
  · simp

theorem wcpa_dj_lmfg_core_compat_desc : ∀ (Z' Zb Y Z : Scheme.{u}) (yf : Y ⟶ Z') (ψb : Y ⟶ Zb) (i' : Z' ⟶ Z) (ib : Zb ⟶ Z) (m : ℕ)
    (U' : Fin m → Z'.Opens) (Ub : Fin m → Zb.Opens), IsClosedImmersion yf →
    ∀ (hU' : ∀ T : Finset (Fin m), T.Nonempty → IsAffineOpen (T.inf U'))
      (hUb : ∀ T : Finset (Fin m), T.Nonempty → IsAffineOpen (T.inf Ub))
      (htrT : ∀ T : Finset (Fin m), yf ⁻¹ᵁ (T.inf U') = ψb ⁻¹ᵁ (T.inf Ub)),
    (⨆ a, U' a) = ⊤ → (⨆ a, Ub a) = ⊤ →
    ∀ (P : Finset (Fin m) → CommRingCat.{u}) (pA : ∀ T, P T ⟶ Γ(Z', T.inf U'))
      (pB : ∀ T, P T ⟶ Γ(Zb, T.inf Ub)) (π : ∀ T T' : Finset (Fin m), T ⊆ T' → (P T ⟶ P T'))
      (ι : ∀ T : Finset (Fin m), T.Nonempty → (Spec (P T) ⟶ Z)),
    (∀ T, IsPullback (pA T) (pB T) (yf.appLE (T.inf U') (yf ⁻¹ᵁ (T.inf U')) le_rfl)
        (ψb.appLE (T.inf Ub) (yf ⁻¹ᵁ (T.inf U')) (htrT T).le)) →
    (∀ T T' (h : T ⊆ T'), π T T' h ≫ pA T' = pA T ≫ Z'.presheaf.map (homOfLE (Finset.inf_mono h)).op) →
    (∀ T T' (h : T ⊆ T'), π T T' h ≫ pB T' = pB T ≫ Zb.presheaf.map (homOfLE (Finset.inf_mono h)).op) →
    (∀ T T' (h : T ⊆ T') (hT : T.Nonempty),
        Spec.map (π T T' h) ≫ ι T hT = ι T' (Finset.Nonempty.mono h hT)) →
    (∀ (X : Scheme.{u}) (g : ∀ T : Finset (Fin m), T.Nonempty → (Spec (P T) ⟶ X)),
        (∀ T T' (h : T ⊆ T') (hT : T.Nonempty),
          Spec.map (π T T' h) ≫ g T hT = g T' (Finset.Nonempty.mono h hT)) →
        ∃ g' : Z ⟶ X, ∀ T (hT : T.Nonempty), ι T hT ≫ g' = g T hT) →
    (∀ T (hT : T.Nonempty), (hU' T hT).fromSpec ≫ i' = Spec.map (pA T) ≫ ι T hT) →
    (∀ T (hT : T.Nonempty), (hUb T hT).fromSpec ≫ ib = Spec.map (pB T) ≫ ι T hT) →
    yf ≫ i' = ψb ≫ ib ∧
      ∀ (R : CommRingCat.{u}) (g' : Z' ⟶ Spec R) (gb : Zb ⟶ Spec R), yf ≫ g' = ψb ≫ gb →
        ∃ g : Z ⟶ Spec R, i' ≫ g = g' ∧ ib ≫ g = gb :=
by
  intro Z' Zb Y Z yf ψb i' ib m U' Ub hyf hU' hUb htrT hcov' hcovb P pA pB π ι hpb hcA hcB hco
    hdesc hi'c hibc

  have homext : ∀ {X W : Scheme.{u}} (U : Fin m → X.Opens) (hU : ∀ a, IsAffineOpen (U a)),
      (⨆ a, U a) = ⊤ → ∀ (f g : X ⟶ W), (∀ a, (hU a).fromSpec ≫ f = (hU a).fromSpec ≫ g) →
      f = g := by
    intro X W U hU hcov f g h
    apply Scheme.hom_ext_of_forall
    intro x
    have hx : x ∈ (⨆ a, U a) := by rw [hcov]; trivial
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    refine ⟨U a, ha, ?_⟩
    have e : (U a).ι = (hU a).isoSpec.hom ≫ (hU a).fromSpec := by
      rw [← IsAffineOpen.isoSpec_inv_ι, Iso.hom_inv_id_assoc]
    rw [e, Category.assoc, Category.assoc, h a]
  have hsing : ∀ a : Fin m, ({a} : Finset (Fin m)).Nonempty := fun a => Finset.singleton_nonempty a
  have hV : ∀ a, IsAffineOpen (yf ⁻¹ᵁ (({a} : Finset (Fin m)).inf U')) :=
    fun a => (hU' {a} (hsing a)).preimage yf

  have K1 : yf ≫ i' = ψb ≫ ib := by
    apply homext (fun a => yf ⁻¹ᵁ (({a} : Finset (Fin m)).inf U')) hV
    · simp only [Finset.inf_singleton]
      rw [← Scheme.Hom.preimage_iSup, hcov', Scheme.Hom.preimage_top]
    · intro a
      have e1 := IsAffineOpen.SpecMap_appLE_fromSpec yf (hU' {a} (hsing a)) (hV a) le_rfl
      have e2 := IsAffineOpen.SpecMap_appLE_fromSpec ψb (hUb {a} (hsing a)) (hV a) (htrT {a}).le
      rw [← Category.assoc, ← e1, ← Category.assoc, ← e2, Category.assoc, Category.assoc,
        hi'c {a} (hsing a), hibc {a} (hsing a), ← Category.assoc, ← Category.assoc,
        ← Spec.map_comp, ← Spec.map_comp, (hpb {a}).w]
  refine ⟨K1, ?_⟩

  intro R g' gb hg
  have htop : ∀ {X : Scheme.{u}} (f : X ⟶ Spec R) (V : X.Opens), V ≤ f ⁻¹ᵁ ⊤ :=
    fun f V => le_top.trans_eq (Scheme.Hom.preimage_top f).symm
  have hc : ∀ (T : Finset (Fin m)) (φ ψ : Y ⟶ Spec R), φ = ψ → ∀ p q,
      φ.appLE ⊤ (yf ⁻¹ᵁ (T.inf U')) p = ψ.appLE ⊤ (yf ⁻¹ᵁ (T.inf U')) q := by
    rintro T φ _ rfl p q; rfl
  have hw : ∀ T, ((Scheme.ΓSpecIso R).inv ≫ g'.appLE ⊤ (T.inf U') (htop g' _)) ≫
      yf.appLE (T.inf U') (yf ⁻¹ᵁ (T.inf U')) le_rfl =
      ((Scheme.ΓSpecIso R).inv ≫ gb.appLE ⊤ (T.inf Ub) (htop gb _)) ≫
      ψb.appLE (T.inf Ub) (yf ⁻¹ᵁ (T.inf U')) (htrT T).le := by
    intro T
    rw [Category.assoc, Category.assoc, Scheme.Hom.appLE_comp_appLE,
      Scheme.Hom.appLE_comp_appLE]
    congr 1
    exact hc T _ _ hg _ _
  let φ : ∀ T, R ⟶ P T := fun T => (hpb T).lift _ _ (hw T)
  have hφA : ∀ T, φ T ≫ pA T = (Scheme.ΓSpecIso R).inv ≫ g'.appLE ⊤ (T.inf U') (htop g' _) :=
    fun T => (hpb T).lift_fst _ _ _
  have hφB : ∀ T, φ T ≫ pB T = (Scheme.ΓSpecIso R).inv ≫ gb.appLE ⊤ (T.inf Ub) (htop gb _) :=
    fun T => (hpb T).lift_snd _ _ _
  have hφπ : ∀ T T' (h : T ⊆ T'), φ T ≫ π T T' h = φ T' := by
    intro T T' h
    apply (hpb T').hom_ext
    · rw [Category.assoc, hcA, ← Category.assoc, hφA, hφA, Category.assoc, Scheme.Hom.appLE_map]
    · rw [Category.assoc, hcB, ← Category.assoc, hφB, hφB, Category.assoc, Scheme.Hom.appLE_map]
  obtain ⟨g, hgι⟩ := hdesc (Spec R) (fun T _ => Spec.map (φ T)) (by
    intro T T' h hT
    rw [← Spec.map_comp, hφπ])

  have cd : ∀ (X : Scheme.{u}) (i : X ⟶ Z) (g₁ : X ⟶ Spec R) (A : X.Opens) (hA : IsAffineOpen A)
      (Q : CommRingCat.{u}) (p : Q ⟶ Γ(X, A)) (ι0 : Spec Q ⟶ Z) (φ0 : R ⟶ Q),
      hA.fromSpec ≫ i = Spec.map p ≫ ι0 → ι0 ≫ g = Spec.map φ0 →
      φ0 ≫ p = (Scheme.ΓSpecIso R).inv ≫ g₁.appLE ⊤ A (htop g₁ A) →
      hA.fromSpec ≫ i ≫ g = hA.fromSpec ≫ g₁ := by
    intro X i g₁ A hA Q p ι0 φ0 h1 h2 h3
    rw [← Category.assoc, h1, Category.assoc, h2, ← Spec.map_comp, h3, Spec.map_comp,
      ← IsAffineOpen.SpecMap_appLE_fromSpec g₁ (isAffineOpen_top (Spec R)) hA (htop g₁ A),
      IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv]
  refine ⟨g, ?_, ?_⟩
  · apply homext (fun a => ({a} : Finset (Fin m)).inf U') (fun a => hU' {a} (hsing a))
    · simp only [Finset.inf_singleton]; exact hcov'
    · intro a
      exact cd Z' i' g' _ _ (P {a}) (pA {a}) (ι {a} (hsing a)) (φ {a}) (hi'c {a} (hsing a))
        (hgι {a} (hsing a)) (hφA {a})
  · apply homext (fun a => ({a} : Finset (Fin m)).inf Ub) (fun a => hUb {a} (hsing a))
    · simp only [Finset.inf_singleton]; exact hcovb
    · intro a
      exact cd Zb ib gb _ _ (P {a}) (pB {a}) (ι {a} (hsing a)) (φ {a}) (hibc {a} (hsing a))
        (hgι {a} (hsing a)) (hφB {a})

theorem wcpa_dj_lmfg_ferrand_core : ∀ (Z' Zb Y : Scheme.{u}) (yf : Y ⟶ Z') (ψb : Y ⟶ Zb) (m : ℕ)
    (U' : Fin m → Z'.Opens) (Ub : Fin m → Zb.Opens), IsClosedImmersion yf →
    (∀ T : Finset (Fin m), T.Nonempty → IsAffineOpen (T.inf U')) →
    (∀ T : Finset (Fin m), T.Nonempty → IsAffineOpen (T.inf Ub)) →
    (∀ a, yf ⁻¹ᵁ U' a = ψb ⁻¹ᵁ Ub a) → (⨆ a, U' a) = ⊤ → (⨆ a, Ub a) = ⊤ →
    ∃ (Z : Scheme.{u}) (i' : Z' ⟶ Z) (ib : Zb ⟶ Z) (O : Fin m → Z.Opens),
      yf ≫ i' = ψb ≫ ib ∧ (⨆ a, O a) = ⊤ ∧ (∀ a, i' ⁻¹ᵁ O a = U' a) ∧
      (∀ a, ib ⁻¹ᵁ O a = Ub a) ∧ (∀ a b, IsAffineOpen (O a ⊓ O b)) ∧
      (∀ (a b : Fin m) (h1 : U' a ⊓ U' b ≤ i' ⁻¹ᵁ (O a ⊓ O b))
        (h2 : Ub a ⊓ Ub b ≤ ib ⁻¹ᵁ (O a ⊓ O b))
        (h4 : yf ⁻¹ᵁ (U' a ⊓ U' b) ≤ ψb ⁻¹ᵁ (Ub a ⊓ Ub b)),
        IsPullback (i'.appLE (O a ⊓ O b) (U' a ⊓ U' b) h1)
          (ib.appLE (O a ⊓ O b) (Ub a ⊓ Ub b) h2)
          (yf.appLE (U' a ⊓ U' b) (yf ⁻¹ᵁ (U' a ⊓ U' b)) le_rfl)
          (ψb.appLE (Ub a ⊓ Ub b) (yf ⁻¹ᵁ (U' a ⊓ U' b)) h4)) ∧
      ∀ (R : CommRingCat.{u}) (g' : Z' ⟶ Spec R) (gb : Zb ⟶ Spec R), yf ≫ g' = ψb ≫ gb →
        ∃ g : Z ⟶ Spec R, i' ≫ g = g' ∧ ib ≫ g = gb :=
by
  intro Z' Zb Y yf ψb m U' Ub hyf hU' hUb htr hcov' hcovb

  have htrT : ∀ T : Finset (Fin m), yf ⁻¹ᵁ (T.inf U') = ψb ⁻¹ᵁ (T.inf Ub) := by
    intro T
    induction T using Finset.induction_on with
    | empty => simp only [Finset.inf_empty, Scheme.Hom.preimage_top]
    | insert a T _ ih =>
      rw [Finset.inf_insert, Finset.inf_insert, Scheme.Hom.preimage_inf, Scheme.Hom.preimage_inf,
        htr a, ih]

  obtain ⟨P, pA, pB, π, hpb, hcA, hcB, hid, hcomp⟩ :=
    wcpa_dj_lmfg_chart_system Z' Zb Y yf ψb m U' Ub htrT
  obtain ⟨hoi, hrange, htA, htB⟩ :=
    wcpa_dj_lmfg_chart_system_props Z' Zb Y yf ψb m U' Ub hyf hU' hUb htrT P pA pB π hpb hcA hcB
  obtain ⟨Z, ι, hco, hιoi, hjs, hun, hdesc⟩ := wcpa_dj_lmfg_affine_glue m P π hid hcomp hoi hrange
  obtain ⟨i', hi'c, hi'p⟩ := wcpa_dj_lmfg_side_map Z' Z m U' hU' hcov' P pA π ι hcA hco hun htA
  obtain ⟨ib, hibc, hibp⟩ := wcpa_dj_lmfg_side_map Zb Z m Ub hUb hcovb P pB π ι hcB hco hun htB
  haveI : ∀ (T : Finset (Fin m)) (hT : T.Nonempty), IsOpenImmersion (ι T hT) := hιoi

  obtain ⟨hK1, hK7⟩ := wcpa_dj_lmfg_core_compat_desc Z' Zb Y Z yf ψb i' ib m U' Ub hyf hU' hUb htrT
    hcov' hcovb P pA pB π ι hpb hcA hcB hco hdesc hi'c hibc

  let O : Fin m → Z.Opens := fun a => (ι {a} (Finset.singleton_nonempty a)).opensRange

  have ho1 : ∀ a b, (ι ({a} ∪ {b})
      ((Finset.singleton_nonempty a).mono Finset.subset_union_left)).opensRange = O a ⊓ O b := by
    intro a b
    ext z
    simp only [O, SetLike.mem_coe, TopologicalSpace.Opens.mem_inf, Scheme.Hom.mem_opensRange]
    constructor
    · rintro ⟨x, rfl⟩
      refine ⟨⟨Spec.map (π {a} ({a} ∪ {b}) Finset.subset_union_left) x, ?_⟩,
        ⟨Spec.map (π {b} ({a} ∪ {b}) Finset.subset_union_right) x, ?_⟩⟩
      · rw [← Scheme.Hom.comp_apply, hco]
      · rw [← Scheme.Hom.comp_apply, hco]
    · rintro ⟨⟨x1, hx1⟩, ⟨x2, hx2⟩⟩
      obtain ⟨x, hx, -⟩ := hun {a} {b} (Finset.singleton_nonempty a) (Finset.singleton_nonempty b)
        x1 x2 (hx1.trans hx2.symm)
      refine ⟨x, ?_⟩
      rw [← hx1, ← hx, ← Scheme.Hom.comp_apply, hco]

  have hK2 : (⨆ a, O a) = ⊤ := by
    rw [eq_top_iff]
    intro z _
    obtain ⟨a, x, hx⟩ := hjs z
    rw [TopologicalSpace.Opens.mem_iSup]
    refine ⟨a, ?_⟩
    simp only [O, Scheme.Hom.mem_opensRange]
    exact ⟨x, hx⟩

  have hK3 : ∀ a, i' ⁻¹ᵁ O a = U' a := by
    intro a
    ext x
    simp only [SetLike.mem_coe, Scheme.Hom.mem_preimage, O, Scheme.Hom.mem_opensRange]
    exact hi'p a x
  have hK4 : ∀ a, ib ⁻¹ᵁ O a = Ub a := by
    intro a
    ext x
    simp only [SetLike.mem_coe, Scheme.Hom.mem_preimage, O, Scheme.Hom.mem_opensRange]
    exact hibp a x

  have hK5 : ∀ a b, IsAffineOpen (O a ⊓ O b) := by
    intro a b
    rw [← ho1 a b]
    exact isAffineOpen_opensRange _

  have hK6 : ∀ (a b : Fin m) (h1 : U' a ⊓ U' b ≤ i' ⁻¹ᵁ (O a ⊓ O b))
      (h2 : Ub a ⊓ Ub b ≤ ib ⁻¹ᵁ (O a ⊓ O b))
      (h4 : yf ⁻¹ᵁ (U' a ⊓ U' b) ≤ ψb ⁻¹ᵁ (Ub a ⊓ Ub b)),
      IsPullback (i'.appLE (O a ⊓ O b) (U' a ⊓ U' b) h1)
        (ib.appLE (O a ⊓ O b) (Ub a ⊓ Ub b) h2)
        (yf.appLE (U' a ⊓ U' b) (yf ⁻¹ᵁ (U' a ⊓ U' b)) le_rfl)
        (ψb.appLE (Ub a ⊓ Ub b) (yf ⁻¹ᵁ (U' a ⊓ U' b)) h4) := by
    intro a b h1 h2 h4
    have hab : ({a} ∪ {b} : Finset (Fin m)).Nonempty :=
      (Finset.singleton_nonempty a).mono Finset.subset_union_left
    have eA : ({a} ∪ {b} : Finset (Fin m)).inf U' = U' a ⊓ U' b := by
      rw [Finset.inf_union, Finset.inf_singleton, Finset.inf_singleton]
    have eB : ({a} ∪ {b} : Finset (Fin m)).inf Ub = Ub a ⊓ Ub b := by
      rw [Finset.inf_union, Finset.inf_singleton, Finset.inf_singleton]
    exact wcpa_dj_lmfg_chart_pullback Z' Zb Y Z yf ψb i' ib (P ({a} ∪ {b})) (ι _ hab) _ _ _ _ _
      eA eB (ho1 a b) (hU' _ hab) (hUb _ hab) (pA _) (pB _) (htrT _).le (hpb _) (hi'c _ hab)
      (hibc _ hab) h1 h2 h4
  exact ⟨Z, i', ib, O, hK1, hK2, hK3, hK4, hK5, hK6, hK7⟩

theorem wcpa_dj_lmfg_glue_charts : ∀ (Ω : Type u) [Field Ω] (W W' : ValuationSubring Ω)
    (Wb : ValuationSubring (IsLocalRing.ResidueField ↥W')) (hle : W ≤ W') (πb : ↥W →+* ↥Wb),
    Function.Surjective πb →
    (∀ w : ↥W, algebraMap ↥Wb (IsLocalRing.ResidueField ↥W') (πb w) =
      algebraMap ↥W' (IsLocalRing.ResidueField ↥W') (ValuationSubring.inclusion W W' hle w)) →
    IsPullback (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)) (CommRingCat.ofHom πb)
      (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))
      (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W'))) →
    IsPreimmersion (Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle))) →
    ∀ (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of ↥W')) (Zb : Scheme.{u}) (ub : Zb ⟶ Spec (.of ↥Wb))
      (ψb : Limits.pullback u'
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⟶ Zb),
      wcpaDjSemistable u' → wcpaDjSemistable ub →
      IsPullback ψb (Limits.pullback.snd u'
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))))) ub
        (Spec.map (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W')))) →
      ∀ (m : ℕ) (U' : Fin m → Z'.Opens) (Ub : Fin m → Zb.Opens),
        (∀ a, IsAffineOpen (U' a)) → (∀ a, IsAffineOpen (Ub a)) →
        (∀ a, Limits.pullback.fst u'
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⁻¹ᵁ U' a =
          ψb ⁻¹ᵁ Ub a) →
        (⨆ a, U' a) = ⊤ → (⨆ a, Ub a) = ⊤ →
        ∃ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (i' : Z' ⟶ Z) (ib : Zb ⟶ Z)
          (O : Fin m → Z.Opens),
          IsPullback i' u' uu (Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle))) ∧
          IsPullback ib ub uu (Spec.map (CommRingCat.ofHom πb)) ∧
          Limits.pullback.fst u'
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ≫ i' =
            ψb ≫ ib ∧
          (⨆ a, O a) = ⊤ ∧ (∀ a, i' ⁻¹ᵁ O a = U' a) ∧ (∀ a, ib ⁻¹ᵁ O a = Ub a) ∧
          (∀ a b, IsAffineOpen (O a ⊓ O b)) ∧
          ∀ (a b : Fin m) (h1 : U' a ⊓ U' b ≤ i' ⁻¹ᵁ (O a ⊓ O b))
            (h2 : Ub a ⊓ Ub b ≤ ib ⁻¹ᵁ (O a ⊓ O b))
            (h4 : Limits.pullback.fst u'
              (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⁻¹ᵁ
                (U' a ⊓ U' b) ≤ ψb ⁻¹ᵁ (Ub a ⊓ Ub b)),
            IsPullback (i'.appLE (O a ⊓ O b) (U' a ⊓ U' b) h1)
              (ib.appLE (O a ⊓ O b) (Ub a ⊓ Ub b) h2)
              ((Limits.pullback.fst u'
                (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))))).appLE
                (U' a ⊓ U' b) (Limits.pullback.fst u'
                  (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⁻¹ᵁ
                    (U' a ⊓ U' b)) le_rfl)
              (ψb.appLE (Ub a ⊓ Ub b) (Limits.pullback.fst u'
                  (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⁻¹ᵁ
                    (U' a ⊓ U' b)) h4) :=
by
  intro Ω _ W W' Wb hle πb hsurj hcompat hpbR hpre Z' u' Zb ub ψb hss' hssb hpbb m U' Ub
    hU'aff hUbaff htr hU'cov hUbcov

  have affInf : ∀ {X S : Scheme.{u}} (f : X ⟶ S) [IsAffine S] [IsSeparated f]
      (U : Fin m → X.Opens), (∀ a, IsAffineOpen (U a)) →
      ∀ T : Finset (Fin m), T.Nonempty → IsAffineOpen (T.inf U) := by
    intro X S f _ _ U hU T hT
    haveI : IsSeparated (Limits.terminal.from X) := by
      rw [← Limits.terminal.comp_from f]; infer_instance
    haveI : IsAffineHom (Limits.pullback.diagonal (Limits.terminal.from X)) := inferInstance
    induction hT using Finset.Nonempty.cons_induction with
    | singleton a => rw [Finset.inf_singleton]; exact hU a
    | cons a s h hs ih => rw [Finset.inf_cons]; exact (hU a).inf ih
  haveI hprop' : IsProper u' := hss'.2.1
  haveI hpropb : IsProper ub := hssb.2.1
  have hT' := affInf u' U' hU'aff
  have hTb := affInf ub Ub hUbaff

  haveI : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) :=
    IsClosedImmersion.spec_of_surjective _ (IsLocalRing.residue_surjective (R := ↥W'))
  have hyf : IsClosedImmersion (Limits.pullback.fst u'
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))))) :=
    inferInstance

  obtain ⟨Z, i', ib, O, hY, hOcov, hO', hOb, hOaff, hchart, hdesc⟩ :=
    wcpa_dj_lmfg_ferrand_core Z' Zb _ _ ψb m U' Ub hyf hT' hTb htr hU'cov hUbcov

  have hρε : Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))) ≫
      Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)) =
      Spec.map (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W'))) ≫
      Spec.map (CommRingCat.ofHom πb) := by
    rw [← Spec.map_comp, ← Spec.map_comp, hpbR.w]
  have hcomm : Limits.pullback.fst u'
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ≫
      u' ≫ Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)) =
      ψb ≫ ub ≫ Spec.map (CommRingCat.ofHom πb) := by
    rw [← Category.assoc, Limits.pullback.condition, Category.assoc, hρε, ← Category.assoc,
      ← hpbb.w, Category.assoc]
  obtain ⟨uu, huu', huub⟩ := hdesc (CommRingCat.of ↥W)
    (u' ≫ Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)))
    (ub ≫ Spec.map (CommRingCat.ofHom πb)) hcomm

  have keyT : ∀ {R S : CommRingCat.{u}} (f : R ⟶ S) {X Z₀ : Scheme.{u}} (g : X ⟶ Spec S)
      (i : X ⟶ Z₀) (v : Z₀ ⟶ Spec R), i ≫ v = g ≫ Spec.map f → ∀ (O₀ : Z₀.Opens) (U₀ : X.Opens)
      (e : U₀ ≤ i ⁻¹ᵁ O₀),
      ((Scheme.ΓSpecIso R).inv ≫ v.appLE ⊤ O₀ (by simp)) ≫ i.appLE O₀ U₀ e =
        f ≫ (Scheme.ΓSpecIso S).inv ≫ g.appLE ⊤ U₀ (by simp) := by
    intro R S f X Z₀ g i v h O₀ U₀ e
    have hc : ∀ φ ψ : X ⟶ Spec R, φ = ψ → ∀ p q, φ.appLE ⊤ U₀ p = ψ.appLE ⊤ U₀ q := by
      rintro φ _ rfl p q; rfl
    have h1 := Scheme.Hom.appLE_comp_appLE i v ⊤ O₀ U₀ (by simp) e
    have h2 := hc _ _ h (by simp) (by simp)
    have h3 := Scheme.Hom.appLE_comp_appLE g (Spec.map f) ⊤ ⊤ U₀ (by simp) (by simp)
    have h4 : (Spec.map f).appLE ⊤ ⊤ (by simp) = (Spec.map f).appTop :=
      Scheme.Hom.appLE_eq_app _
    rw [Category.assoc, h1, h2, ← h3, h4, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality,
      Category.assoc]

  have hO'2 : ∀ a, i' ⁻¹ᵁ (O a ⊓ O a) = U' a ⊓ U' a := fun a => by
    rw [Scheme.Hom.preimage_inf, hO' a]
  have hOb2 : ∀ a, ib ⁻¹ᵁ (O a ⊓ O a) = Ub a ⊓ Ub a := fun a => by
    rw [Scheme.Hom.preimage_inf, hOb a]
  have hcov2 : (⨆ a, O a ⊓ O a) = ⊤ := by
    simp only [inf_idem]; exact hOcov
  have hUa : ∀ a, IsAffineOpen (U' a ⊓ U' a) := fun a => by rw [inf_idem]; exact hU'aff a
  have hUba : ∀ a, IsAffineOpen (Ub a ⊓ Ub a) := fun a => by rw [inf_idem]; exact hUbaff a
  have hcharts : ∀ a,
      IsPushout (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle))
        ((Scheme.ΓSpecIso (CommRingCat.of ↥W)).inv ≫ uu.appLE ⊤ (O a ⊓ O a) (by simp))
        ((Scheme.ΓSpecIso (CommRingCat.of ↥W')).inv ≫ u'.appLE ⊤ (U' a ⊓ U' a) (by simp))
        (i'.appLE (O a ⊓ O a) (U' a ⊓ U' a) (hO'2 a).ge) ∧
      IsPushout (CommRingCat.ofHom πb)
        ((Scheme.ΓSpecIso (CommRingCat.of ↥W)).inv ≫ uu.appLE ⊤ (O a ⊓ O a) (by simp))
        ((Scheme.ΓSpecIso (CommRingCat.of ↥Wb)).inv ≫ ub.appLE ⊤ (Ub a ⊓ Ub a) (by simp))
        (ib.appLE (O a ⊓ O a) (Ub a ⊓ Ub a) (hOb2 a).ge) := by
    intro a
    have h1 : U' a ⊓ U' a ≤ i' ⁻¹ᵁ (O a ⊓ O a) := (hO'2 a).ge
    have h2 : Ub a ⊓ Ub a ≤ ib ⁻¹ᵁ (O a ⊓ O a) := (hOb2 a).ge
    have hV : ψb ⁻¹ᵁ (Ub a ⊓ Ub a) = Limits.pullback.fst u'
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⁻¹ᵁ
          (U' a ⊓ U' a) := by
      rw [Scheme.Hom.preimage_inf, Scheme.Hom.preimage_inf, htr a]
    have hA := wcpa_dj_lmfg_fibre_chart _ _ _ _ _ _ _ _ (IsPullback.of_hasPullback u'
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))))
      (U' a ⊓ U' a) (hUa a) _ rfl
    have hB := wcpa_dj_lmfg_fibre_chart _ _ _ _ _ _ _ _ hpbb (Ub a ⊓ Ub a) (hUba a) _ hV
    have hP := hchart a a h1 h2 hV.ge
    have h6a := keyT (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)) u' i' uu huu'
      (O a ⊓ O a) (U' a ⊓ U' a) h1
    have h6b := keyT (CommRingCat.ofHom πb) ub ib uu huub (O a ⊓ O a) (Ub a ⊓ Ub a) h2
    exact wcpa_dj_lmfg_chart_basechange Ω W W' Wb hle πb hsurj hcompat hpbR _ _ _ _ _ _ _ _ _ _ _
      ((Scheme.ΓSpecIso (CommRingCat.of ↥W)).inv ≫ uu.appLE ⊤ (O a ⊓ O a) (by simp))
      hA hB hP h6a h6b
  have hT1 : IsPullback i' u' uu (Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle))) :=
    wcpa_dj_lmfg_pullback_of_affine_charts (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle))
      i' u' uu huu' m (fun a => O a ⊓ O a) (fun a => U' a ⊓ U' a) hcov2 (fun a => hOaff a a) hUa
      hO'2 (fun a => (hcharts a).1.flip)
  have hT2 : IsPullback ib ub uu (Spec.map (CommRingCat.ofHom πb)) :=
    wcpa_dj_lmfg_pullback_of_affine_charts (CommRingCat.ofHom πb)
      ib ub uu huub m (fun a => O a ⊓ O a) (fun a => Ub a ⊓ Ub a) hcov2 (fun a => hOaff a a) hUba
      hOb2 (fun a => (hcharts a).2.flip)
  exact ⟨Z, uu, i', ib, O, hT1, hT2, hY, hOcov, hO', hOb, hOaff, hchart⟩

theorem wcpa_dj_lmfg_overlap_closure : ∀ (Ω : Type u) [Field Ω] (W W' : ValuationSubring Ω)
    (Wb : ValuationSubring (IsLocalRing.ResidueField ↥W')) (hle : W ≤ W') (πb : ↥W →+* ↥Wb),
    Function.Surjective πb →
    (∀ w : ↥W, algebraMap ↥Wb (IsLocalRing.ResidueField ↥W') (πb w) =
      algebraMap ↥W' (IsLocalRing.ResidueField ↥W') (ValuationSubring.inclusion W W' hle w)) →
    IsPullback (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)) (CommRingCat.ofHom πb)
      (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))
      (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W'))) →
    ∀ (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of ↥W')) (Zb : Scheme.{u}) (ub : Zb ⟶ Spec (.of ↥Wb))
      (ψb : Limits.pullback u'
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⟶ Zb),
      wcpaDjSemistable u' → wcpaDjSemistable ub →
      IsPullback ψb (Limits.pullback.snd u'
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))))) ub
        (Spec.map (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W')))) →
      ∀ (m : ℕ) (U' : Fin m → Z'.Opens) (Ub : Fin m → Zb.Opens),
        (∀ a, IsAffineOpen (U' a)) → (∀ a, IsAffineOpen (Ub a)) →
        (∀ a, Limits.pullback.fst u'
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⁻¹ᵁ U' a =
          ψb ⁻¹ᵁ Ub a) →
        ∀ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (i' : Z' ⟶ Z) (ib : Zb ⟶ Z)
          (O : Fin m → Z.Opens),
          IsPullback i' u' uu (Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle))) →
          IsPullback ib ub uu (Spec.map (CommRingCat.ofHom πb)) →
          Limits.pullback.fst u'
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ≫ i' =
            ψb ≫ ib →
          (∀ a, i' ⁻¹ᵁ O a = U' a) → (∀ a, ib ⁻¹ᵁ O a = Ub a) →
          (∀ a b, IsAffineOpen (O a ⊓ O b)) →
          (∀ (a b : Fin m) (h1 : U' a ⊓ U' b ≤ i' ⁻¹ᵁ (O a ⊓ O b))
            (h2 : Ub a ⊓ Ub b ≤ ib ⁻¹ᵁ (O a ⊓ O b))
            (h4 : Limits.pullback.fst u'
              (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⁻¹ᵁ
                (U' a ⊓ U' b) ≤ ψb ⁻¹ᵁ (Ub a ⊓ Ub b)),
            IsPullback (i'.appLE (O a ⊓ O b) (U' a ⊓ U' b) h1)
              (ib.appLE (O a ⊓ O b) (Ub a ⊓ Ub b) h2)
              ((Limits.pullback.fst u'
                (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))))).appLE
                (U' a ⊓ U' b) (Limits.pullback.fst u'
                  (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⁻¹ᵁ
                    (U' a ⊓ U' b)) le_rfl)
              (ψb.appLE (Ub a ⊓ Ub b) (Limits.pullback.fst u'
                  (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⁻¹ᵁ
                    (U' a ⊓ U' b)) h4)) →
          ∀ (a b : Fin m) (z : Γ(Z, O a ⊓ O b)), z ∈ Subring.closure
            (Set.range ⇑(Z.presheaf.map (homOfLE (inf_le_left : O a ⊓ O b ≤ O a)).op).hom ∪
             Set.range ⇑(Z.presheaf.map (homOfLE (inf_le_right : O a ⊓ O b ≤ O b)).op).hom) :=
by
  intro Ω _ W W' Wb hle πb hsurj hcompat hpbR Z' u' Zb ub ψb hss' hssb hpbb m U' Ub hU'aff
    hUbaff htr Z uu i' ib O hpi' hpib hY hO' hOb hOaff hchart a b z
  have fc : ∀ (A K : CommRingCat.{u}) (φ : A ⟶ K) (X F : Scheme.{u})
      (g : X ⟶ Spec A) (fst : F ⟶ X) (snd : F ⟶ Spec K), IsPullback fst snd g (Spec.map φ) →
      ∀ U : X.Opens, IsAffineOpen U → ∀ (V : F.Opens) (hV : fst ⁻¹ᵁ U = V),
        IsPushout ((Scheme.ΓSpecIso A).inv ≫ g.appLE ⊤ U (by simp)) φ (fst.appLE U V hV.ge)
          ((Scheme.ΓSpecIso K).inv ≫ snd.appLE ⊤ V (by simp)) := by
    intro A K φ X F g fst snd hpb U hU V hV
    subst hV
    have hUST : (⊤ : (Spec K).Opens) ≤ Spec.map φ ⁻¹ᵁ ⊤ := by simp
    have hUSX : U ≤ g ⁻¹ᵁ ⊤ := by simp
    have hUY : fst ⁻¹ᵁ U = fst ⁻¹ᵁ U ⊓ snd ⁻¹ᵁ ⊤ := by simp
    have hPB := Scheme.Hom.isPullback_resLE hpb hUST hUSX hUY
    haveI : IsAffine U := hU
    haveI : IsAffine ((⊤ : (Spec A).Opens) : Scheme) := isAffineOpen_top (Spec A)
    haveI : IsAffine ((⊤ : (Spec K).Opens) : Scheme) := isAffineOpen_top (Spec K)
    have hPO := isPushout_appTop_of_isPullback hPB
    have s1f : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U),
        (f.resLE U V e).appTop ≫ V.topIso.hom = U.topIso.hom ≫ f.appLE U V e := by
      intro X Y f U V e
      simp only [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, Scheme.Opens.topIso_hom]
      erw [Scheme.Hom.resLE_appLE, Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
    have hPO2 := IsPushout.of_iso hPO (⊤ : (Spec A).Opens).topIso U.topIso
      (⊤ : (Spec K).Opens).topIso (fst ⁻¹ᵁ U).topIso (s1f _ _ _ _) (s1f _ _ _ _)
      (s1f _ _ _ _) (s1f _ _ _ _)
    refine IsPushout.of_iso hPO2 (Scheme.ΓSpecIso A) (Iso.refl _) (Scheme.ΓSpecIso K)
      (Iso.refl _) ?_ ?_ ?_ ?_
    · rw [Iso.refl_hom, Category.comp_id, Iso.hom_inv_id_assoc]
    · have h4 : (Spec.map φ).appLE ⊤ ⊤ hUST = (Spec.map φ).appTop := Scheme.Hom.appLE_eq_app _
      rw [h4]
      exact Scheme.ΓSpecIso_naturality φ
    · rw [Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
    · rw [Iso.refl_hom, Category.comp_id, Iso.hom_inv_id_assoc]
  have keyT : ∀ {R S : CommRingCat.{u}} (f : R ⟶ S) {X Z₀ : Scheme.{u}} (g : X ⟶ Spec S)
      (i : X ⟶ Z₀) (v : Z₀ ⟶ Spec R), i ≫ v = g ≫ Spec.map f → ∀ (O₀ : Z₀.Opens) (U₀ : X.Opens)
      (e : U₀ ≤ i ⁻¹ᵁ O₀),
      ((Scheme.ΓSpecIso R).inv ≫ v.appLE ⊤ O₀ (by simp)) ≫ i.appLE O₀ U₀ e =
        f ≫ (Scheme.ΓSpecIso S).inv ≫ g.appLE ⊤ U₀ (by simp) := by
    intro R S f X Z₀ g i v h O₀ U₀ e
    have hc : ∀ φ ψ : X ⟶ Spec R, φ = ψ → ∀ p q, φ.appLE ⊤ U₀ p = ψ.appLE ⊤ U₀ q := by
      rintro φ _ rfl p q; rfl
    have h1 := Scheme.Hom.appLE_comp_appLE i v ⊤ O₀ U₀ (by simp) e
    have h2 := hc _ _ h (by simp) (by simp)
    have h3 := Scheme.Hom.appLE_comp_appLE g (Spec.map f) ⊤ ⊤ U₀ (by simp) (by simp)
    have h4 : (Spec.map f).appLE ⊤ ⊤ (by simp) = (Spec.map f).appTop :=
      Scheme.Hom.appLE_eq_app _
    rw [Category.assoc, h1, h2, ← h3, h4, ← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality,
      Category.assoc]
  have hmap : ∀ {X : Scheme.{u}} {U V W : X.Opens} (f : Opposite.op U ⟶ Opposite.op V)
      (g : Opposite.op V ⟶ Opposite.op W) (h : Opposite.op U ⟶ Opposite.op W) (y : Γ(X, U)),
      (X.presheaf.map g).hom ((X.presheaf.map f).hom y) = (X.presheaf.map h).hom y := by
    intro X U V W f g h y
    have hfg : f ≫ g = h := Quiver.Hom.unop_inj (Subsingleton.elim _ _)
    rw [← CommRingCat.comp_apply, ← Functor.map_comp, hfg]
  have s1 : ∀ {R A B P : CommRingCat.{u}} (f : R ⟶ A) (g : R ⟶ B) (inl : A ⟶ P) (inr : B ⟶ P)
      (hP : IsPushout f g inl inr) (S : Subring P) (hl : ∀ a, inl.hom a ∈ S)
      (hr : ∀ b, inr.hom b ∈ S), ∀ z : P, z ∈ S := by
    intro R A B P f g inl inr hP S hl hr
    intro z
    let inl' : A ⟶ CommRingCat.of S := CommRingCat.ofHom (inl.hom.codRestrict S hl)
    let inr' : B ⟶ CommRingCat.of S := CommRingCat.ofHom (inr.hom.codRestrict S hr)
    have hw : f ≫ inl' = g ≫ inr' := by
      ext x
      show inl.hom (f.hom x) = inr.hom (g.hom x)
      exact congrArg (fun φ => φ.hom x) hP.w
    have hφ : hP.desc inl' inr' hw ≫ CommRingCat.ofHom S.subtype = 𝟙 P := by
      apply hP.hom_ext
      · rw [← Category.assoc, hP.inl_desc, Category.comp_id]; rfl
      · rw [← Category.assoc, hP.inr_desc, Category.comp_id]; rfl
    have h2 : (CommRingCat.ofHom S.subtype).hom ((hP.desc inl' inr' hw).hom z) = z := by
      have := congrArg (fun φ => φ.hom z) hφ
      exact this
    rw [← h2]
    exact ((hP.desc inl' inr' hw).hom z).2

  have s2 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (A B : CommRingCat.{u})
      (α : CommRingCat.of R ⟶ A) (r : A ⟶ B) (β : CommRingCat.of (IsLocalRing.ResidueField R) ⟶ B),
      IsPushout α (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))) r β →
      Function.Surjective ⇑r.hom ∧
        ∀ x : ↑A, r.hom x = 0 → x ∈ Ideal.map α.hom (IsLocalRing.maximalIdeal R) := by
    intro R _ _ A B α r β hP
    set I := Ideal.map α.hom (IsLocalRing.maximalIdeal R) with hIdef
    have hw : ∀ x : R, r.hom (α.hom x) = β.hom (algebraMap R _ x) := fun x =>
      congrArg (fun φ => φ.hom x) hP.w
    let ℓ : IsLocalRing.ResidueField R →+* A ⧸ I :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal R) ((Ideal.Quotient.mk I).comp α.hom)
        (fun m hm => by
          rw [RingHom.comp_apply]
          exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hm))
    have hℓ : ∀ x : R, ℓ (algebraMap R _ x) = Ideal.Quotient.mk I (α.hom x) := fun x => rfl
    have hw2 : α ≫ CommRingCat.ofHom (Ideal.Quotient.mk I) =
        CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)) ≫ CommRingCat.ofHom ℓ := by
      ext x
      exact (hℓ x).symm
    have hrd : ∀ x : A, (hP.desc _ _ hw2).hom (r.hom x) = Ideal.Quotient.mk I x := fun x =>
      congrArg (fun φ => φ.hom x) (hP.inl_desc _ _ hw2)
    have hβd : ∀ k, (hP.desc _ _ hw2).hom (β.hom k) = ℓ k := fun k =>
      congrArg (fun φ => φ.hom k) (hP.inr_desc _ _ hw2)
    have hI : I ≤ RingHom.ker r.hom := by
      rw [hIdef, Ideal.map_le_iff_le_comap]
      intro m hm
      rw [Ideal.mem_comap, RingHom.mem_ker, hw,
        IsLocalRing.ResidueField.algebraMap_eq, (IsLocalRing.residue_eq_zero_iff m).mpr hm, map_zero]
    let g : A ⧸ I →+* B := Ideal.Quotient.lift I r.hom (fun a ha => hI ha)
    have hdg : hP.desc _ _ hw2 ≫ CommRingCat.ofHom g = 𝟙 B := by
      apply hP.hom_ext
      · ext x
        show g ((hP.desc _ _ hw2).hom (r.hom x)) = r.hom x
        rw [hrd]
        rfl
      · ext k
        show g ((hP.desc _ _ hw2).hom (β.hom k)) = β.hom k
        rw [hβd]
        obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective k
        rw [← IsLocalRing.ResidueField.algebraMap_eq, hℓ, ← hw]
        rfl
    refine ⟨fun y => ?_, fun x hx => ?_⟩
    · obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective ((hP.desc _ _ hw2).hom y)
      refine ⟨x, ?_⟩
      have h1 : g ((hP.desc _ _ hw2).hom y) = y := congrArg (fun φ => φ.hom y) hdg
      rw [← h1, ← hx]
      rfl
    · have h1 := hrd x
      rw [hx, map_zero] at h1
      exact Ideal.Quotient.eq_zero_iff_mem.mp h1.symm

  have s3 : ∀ (D K : Type u) [CommRing D] [IsDomain D] [Field K] [Algebra D K] [IsFractionRing D K]
      (A B : CommRingCat.{u}) (α : CommRingCat.of D ⟶ A) (e : A ⟶ B) (β : CommRingCat.of K ⟶ B),
      IsPushout α (CommRingCat.ofHom (algebraMap D K)) e β →
      ∀ y : ↑B, ∃ t : D, t ≠ 0 ∧ ∃ x : ↑A, β.hom (algebraMap D K t) * y = e.hom x := by
    intro D K _ _ _ _ _ A B α e β hP
    have hw : ∀ d : D, e.hom (α.hom d) = β.hom (algebraMap D K d) := fun d =>
      congrArg (fun φ => φ.hom d) hP.w
    let S : Subring B :=
      { carrier := {y | ∃ t : D, t ≠ 0 ∧ ∃ x : ↑A, β.hom (algebraMap D K t) * y = e.hom x}
        mul_mem' := by
          rintro y1 y2 ⟨t1, ht1, x1, h1⟩ ⟨t2, ht2, x2, h2⟩
          refine ⟨t1 * t2, mul_ne_zero ht1 ht2, x1 * x2, ?_⟩
          rw [map_mul, map_mul, map_mul, ← h1, ← h2]
          ring
        one_mem' := ⟨1, one_ne_zero, 1, by simp⟩
        add_mem' := by
          rintro y1 y2 ⟨t1, ht1, x1, h1⟩ ⟨t2, ht2, x2, h2⟩
          refine ⟨t1 * t2, mul_ne_zero ht1 ht2, α.hom t2 * x1 + α.hom t1 * x2, ?_⟩
          simp only [map_add, map_mul, hw]
          rw [← h1, ← h2]
          ring
        zero_mem' := ⟨1, one_ne_zero, 0, by simp⟩
        neg_mem' := by
          rintro y ⟨t, ht, x, h⟩
          exact ⟨t, ht, -x, by rw [map_neg, ← h, mul_neg]⟩ }
    intro y
    exact s1 α (CommRingCat.ofHom (algebraMap D K)) e β hP S
      (fun x => ⟨1, one_ne_zero, x, by simp⟩)
      (fun k => by
        obtain ⟨a, t, ht, rfl⟩ := IsFractionRing.div_surjective (A := D) k
        have hct : algebraMap D K t ≠ 0 :=
          IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors ht
        refine ⟨t, nonZeroDivisors.ne_zero ht, α.hom a, ?_⟩
        rw [← map_mul, mul_div_cancel₀ _ hct, hw]) y

  have chart : ∀ (T0 X0 Y0 : Scheme.{u}) (g0 : X0 ⟶ T0) (t0 : Y0 ⟶ T0) (V0 : T0.Opens), IsAffineOpen V0 → ∀ (T : Y0.Opens), IsAffineOpen T → ∀ (hT : T ≤ t0 ⁻¹ᵁ V0) (U : X0.Opens), IsAffineOpen U → ∀ (hU : U ≤ g0 ⁻¹ᵁ V0) (UY : (Limits.pullback g0 t0).Opens) (h1 : UY ≤ Limits.pullback.fst g0 t0 ⁻¹ᵁ U) (h2 : UY ≤ Limits.pullback.snd g0 t0 ⁻¹ᵁ T), UY = Limits.pullback.fst g0 t0 ⁻¹ᵁ U ⊓ Limits.pullback.snd g0 t0 ⁻¹ᵁ T → IsAffineOpen UY ∧ IsPushout (g0.appLE V0 U hU) (t0.appLE V0 T hT) ((Limits.pullback.fst g0 t0).appLE U UY h1) ((Limits.pullback.snd g0 t0).appLE T UY h2) := by
    intro T0 X0 Y0 g0 t0 V0 hV0 T hTa hT U hUa hU UY h1 h2 heq
    have hPB := Scheme.Hom.isPullback_resLE (IsPullback.of_hasPullback g0 t0) hT hU heq
    haveI : IsAffine V0 := hV0
    haveI : IsAffine T := hTa
    haveI : IsAffine U := hUa
    have hUY : IsAffineOpen UY := by
      haveI : IsAffine (Limits.pullback (g0.resLE V0 U hU) (t0.resLE V0 T hT)) := inferInstance
      exact IsAffine.of_isIso hPB.isoPullback.hom
    refine ⟨hUY, ?_⟩
    haveI : IsAffine UY := hUY
    have hPO := isPushout_appTop_of_isPullback hPB
    have s1c : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U),
        (f.resLE U V e).appTop ≫ V.topIso.hom = U.topIso.hom ≫ f.appLE U V e := by
      intro X Y f U V e
      simp only [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, Scheme.Opens.topIso_hom]
      erw [Scheme.Hom.resLE_appLE, Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
    exact IsPushout.of_iso hPO V0.topIso U.topIso T.topIso UY.topIso (s1c _ _ _ _) (s1c _ _ _ _)
      (s1c _ _ _ _) (s1c _ _ _ _)

  have s4 : ∀ {X S : Scheme.{u}} (f : X ⟶ S) [IsAffine S] [IsSeparated f] (U V : X.Opens),
      IsAffineOpen U → IsAffineOpen V → IsAffineOpen (U ⊓ V) ∧
      ∀ z : Γ(X, U ⊓ V), z ∈ Subring.closure
        (Set.range ⇑(X.presheaf.map (homOfLE (inf_le_left : U ⊓ V ≤ U)).op).hom ∪
         Set.range ⇑(X.presheaf.map (homOfLE (inf_le_right : U ⊓ V ≤ V)).op).hom) := by
    intro X S f _ _ U V hU hV
    haveI : IsSeparated (Limits.terminal.from X) := by
      rw [show Limits.terminal.from X = f ≫ Limits.terminal.from S from
        Limits.terminal.hom_ext _ _]
      infer_instance
    refine ⟨hU.inf hV, ?_⟩
    set fst := Limits.pullback.fst f f
    set snd := Limits.pullback.snd f f
    set UY := fst ⁻¹ᵁ U ⊓ snd ⁻¹ᵁ V with hUYdef
    have h1 : UY ≤ fst ⁻¹ᵁ U := inf_le_left
    have h2 : UY ≤ snd ⁻¹ᵁ V := inf_le_right
    obtain ⟨hUY, hPO⟩ := chart S X X f f ⊤ (isAffineOpen_top S) V hV (by simp) U hU (by simp)
      UY h1 h2 rfl
    set Δ := Limits.pullback.diagonal f
    have hpre : Δ ⁻¹ᵁ UY = U ⊓ V := by
      rw [hUYdef, Scheme.Hom.preimage_inf, ← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage,
        Limits.pullback.diagonal_fst, Limits.pullback.diagonal_snd, Scheme.Hom.id_preimage,
        Scheme.Hom.id_preimage]
    have he : U ⊓ V ≤ Δ ⁻¹ᵁ UY := hpre.ge
    set δ := Δ.appLE UY (U ⊓ V) he
    have hδs : Function.Surjective δ.hom := by
      have h0 : Function.Surjective (Δ.appLE UY (Δ ⁻¹ᵁ UY) le_rfl).hom := by
        rw [← Scheme.Hom.app_eq_appLE]
        exact Scheme.Hom.app_surjective Δ UY hUY
      exact (Scheme.Hom.appLE_congr Δ le_rfl rfl hpre
        (fun g => Function.Surjective g.hom)).mp h0
    have hc : ∀ (φ ψ : X ⟶ X), φ = ψ → ∀ (W : X.Opens) p q,
        φ.appLE W (U ⊓ V) p = ψ.appLE W (U ⊓ V) q := by
      rintro φ _ rfl W p q; rfl
    have hid : ∀ (W : X.Opens) (p : U ⊓ V ≤ 𝟙 X ⁻¹ᵁ W),
        (𝟙 X : X ⟶ X).appLE W (U ⊓ V) p = X.presheaf.map (homOfLE p).op := by
      intro W p
      rw [Scheme.Hom.appLE, Scheme.Hom.id_app]; exact Category.id_comp _
    have hδ1 : ∀ a, δ.hom ((fst.appLE U UY h1).hom a) =
        (X.presheaf.map (homOfLE (inf_le_left : U ⊓ V ≤ U)).op).hom a := by
      intro a
      have := Scheme.Hom.appLE_comp_appLE Δ fst U UY (U ⊓ V) h1 he
      rw [hc _ _ (Limits.pullback.diagonal_fst f) U _ (by simp), hid] at this
