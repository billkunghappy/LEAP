      have hc := smoothOfRelativeDimension_comp 0 1
        ((inv (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl)) ≫ hU.fromSpec) ∣_ W) (W.ι ≫ pX')
      rw [heq']
      simpa using hc
    have hψt₀ : hV₀.fromSpec (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl) t₁) = y := by
      rw [← hjπ, Scheme.Hom.comp_apply, hjt₀, hpts 0]
    refine ⟨hV₀.fromSpec ''ᵁ
      ((inv (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl)) ≫ hU.fromSpec) ⁻¹ᵁ W), ?_, ?_⟩
    · rw [← hψt₀]
      exact ⟨_, ht₀W, rfl⟩
    · have heq2 : (hV₀.fromSpec ''ᵁ
          ((inv (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl)) ≫ hU.fromSpec) ⁻¹ᵁ W)).ι ≫ pY =
          (hV₀.fromSpec.isoImage
            ((inv (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl)) ≫ hU.fromSpec) ⁻¹ᵁ W)).inv ≫
          (((inv (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl)) ≫ hU.fromSpec) ⁻¹ᵁ W).ι ≫
            hV₀.fromSpec ≫ pY) := by
        rw [← Scheme.Hom.isoImage_inv_ι hV₀.fromSpec]
        simp only [Category.assoc]
      have : SmoothOfRelativeDimension 0 (hV₀.fromSpec.isoImage
          ((inv (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl)) ≫ hU.fromSpec) ⁻¹ᵁ W)).inv :=
        inferInstance
      have hc := smoothOfRelativeDimension_comp 0 1 (hV₀.fromSpec.isoImage
          ((inv (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl)) ≫ hU.fromSpec) ⁻¹ᵁ W)).inv
        (((inv (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl)) ≫ hU.fromSpec) ⁻¹ᵁ W).ι ≫
