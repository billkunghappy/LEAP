    have e1 : inv (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl))
        (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl) t₁) = t₁ := by
      rw [← Scheme.Hom.comp_apply, IsIso.hom_inv_id]
