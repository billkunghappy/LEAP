    rw [hset j]
    exact (hWirr j Ω _).image Φ Φ.continuous.continuousOn

  set Ω₂ := AlgebraicClosure L₂
  set t₂ := Spec.map (CommRingCat.ofHom (algebraMap L₂ Ω₂)) with ht₂
  have hSS₂ : wcpaDjSolSS (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k L₂))))
      Ω₂ t₂ :=
    (wcpa_dj_sfs_solss_transfer _ _ _ _ h _ _ _ (IsPullback.of_hasPullback h
      (Spec.map (CommRingCat.ofHom (algebraMap k L₂)))) Ω₂ t₂).mpr (hSS Ω₂ _)
  obtain ⟨D₂fin, -⟩ := wcpa_dj_sfs_double_points_finite _ _ _ Ω₂ t₂ hSS₂
  have A₂ := hAt Ω₂ t₂
  set I₂ : Set ↥(Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k L₂)))) :=
    {y | ∃ j j', j ≠ j' ∧ y ∈ Zf j ∧ y ∈ Zf j'} with hI₂
  have hI₂fin : I₂.Finite := by
    refine (D₂fin.image (Limits.pullback.fst (Limits.pullback.snd h
      (Spec.map (CommRingCat.ofHom (algebraMap k L₂)))) t₂)).subset ?_
    rintro x ⟨j, j', hjj, hxj, hxj'⟩
    obtain ⟨w, rfl⟩ := GS L₂ Ω₂ _ (Limits.pullback.snd h
      (Spec.map (CommRingCat.ofHom (algebraMap k L₂)))) t₂ x
    exact ⟨w, ⟨_, A₂.1 j, _, A₂.1 j', fun heq => hjj (A₂.2.2.1 j j' heq), hxj, hxj'⟩, rfl⟩

  choose ya hya using fun j => hπsurj (anc j)
  set Sg := I₂ ∪ Set.range ya with hSg
  have hSgfin : Sg.Finite := hI₂fin.union (Set.finite_range ya)
  have hSgP : ∀ y ∈ Sg, π y ∈ P := by
    rintro y (⟨j, j', hjj, hj, hj'⟩ | ⟨j, rfl⟩)
    · exact Or.inl ⟨j, j', hjj, hj, hj'⟩
    · rw [hya j]
      exact Or.inr ⟨j, rfl⟩
  choose sec hsec using fun (y : ↥Sg) => RAT y.1 (hSgP y.1 y.2)
  haveI : Finite ↥Sg := hSgfin.to_subtype
  let ε := Finite.equivFin ↥Sg
  refine ⟨L₂, iL₂, iA₂, hfd₂, r, Nat.card ↥Sg, Zf, fun a => sec (ε.symm a), ?_, ?_, ?_, ?_⟩
  · intro j
    exact (hWcl j).preimage π.continuous
  · intro a
    exact (hsec _).1
  · intro j
    refine ⟨ε ⟨ya j, Or.inr ⟨j, rfl⟩⟩, ?_⟩
    have hpt : sec (ε.symm (ε ⟨ya j, Or.inr ⟨j, rfl⟩⟩)) (IsLocalRing.closedPoint L₂) = ya j := by
      rw [Equiv.symm_apply_apply]
      exact (hsec _).2
    refine ⟨?_, ?_⟩
    · show sec (ε.symm (ε ⟨ya j, Or.inr ⟨j, rfl⟩⟩)) (IsLocalRing.closedPoint L₂) ∈ ⇑π ⁻¹' W j
      rw [hpt, Set.mem_preimage, hya j]
      exact hancW j
    · intro j' hj'
      show sec (ε.symm (ε ⟨ya j, Or.inr ⟨j, rfl⟩⟩)) (IsLocalRing.closedPoint L₂) ∉ ⇑π ⁻¹' W j'
      rw [hpt, Set.mem_preimage, hya j]
      exact hancN j j' hj'
  · intro Ω _ _ t
    obtain ⟨c1, c2, -, -⟩ := hAt Ω t
    refine ⟨c1, c2, ?_⟩
    rintro w ⟨j, j', hjj, h1, h2⟩
    have hy : Limits.pullback.fst (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom
        (algebraMap k L₂)))) t w ∈ Sg := Or.inl ⟨j, j', hjj, h1, h2⟩
    refine ⟨ε ⟨_, hy⟩, ?_⟩
    show _ = sec (ε.symm (ε ⟨_, hy⟩)) (IsLocalRing.closedPoint L₂)
    rw [Equiv.symm_apply_apply, (hsec _).2]

theorem wcpa_dj_ssc_finite_model_sections : ∀ (S X : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [IsLocallyNoetherian S] (u : X ⟶ S) [LocallyOfFiniteType u] (L : Type u) [Field L] [Algebra (S.residueField (genericPoint S)) L] [FiniteDimensional (S.residueField (genericPoint S)) L] (m : ℕ) (σ : Fin m → (Spec (.of L) ⟶ X)), (∀ a, σ a ≫ u = Spec.map (CommRingCat.ofHom (algebraMap (S.residueField (genericPoint S)) L)) ≫ S.fromSpecResidueField (genericPoint S)) → ∃ (U₀ : S.Opens) (Y : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Y) (_ : IsLocallyNoetherian Y) (q₀ : Y ⟶ U₀.toScheme) (e : Y.residueField (genericPoint Y) ⟶ CommRingCat.of L) (ρ : Fin m → (Y ⟶ Limits.pullback u (q₀ ≫ U₀.ι))), genericPoint S ∈ U₀ ∧ IsFinite q₀ ∧ Surjective q₀ ∧ (∀ y : Y, U₀.ι (q₀ y) = genericPoint S → y = genericPoint Y) ∧ IsIso e ∧ Spec.map e ≫ Y.fromSpecResidueField (genericPoint Y) ≫ q₀ ≫ U₀.ι = Spec.map (CommRingCat.ofHom (algebraMap (S.residueField (genericPoint S)) L)) ≫ S.fromSpecResidueField (genericPoint S) ∧ (∀ a, ρ a ≫ Limits.pullback.snd u (q₀ ≫ U₀.ι) = 𝟙 Y) ∧ (∀ a, Spec.map e ≫ Y.fromSpecResidueField (genericPoint Y) ≫ ρ a ≫ Limits.pullback.fst u (q₀ ≫ U₀.ι) = σ a) :=
by
  intro S X _ _ u _ L _ _ _ m σ hσ
  classical
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]
  have hSc : ∀ {R R' R'' : CommRingCat.{u}} (f : R ⟶ R') (g : R' ⟶ R'') {T : Scheme.{u}}
      (Z : Spec R ⟶ T), Spec.map g ≫ Spec.map f ≫ Z = Spec.map (f ≫ g) ≫ Z := by
    intro R R' R'' f g T Z
    rw [Spec.map_comp, Category.assoc]

  obtain ⟨U, Y', ι, q', hι, _hηr, hfin, hsurj, hint, hnoeth, _hint2, huniq, e', he', hcomp'⟩ :=
    wc_spread_finite_ext_generic S L
  haveI := hι
  haveI := hfin
  haveI := hsurj
  haveI := hint
  haveI := hnoeth
  haveI := he'

  have P0 : ι (q' (genericPoint Y')) = genericPoint S := by
    obtain ⟨p⟩ : Nonempty ↥(Spec (.of L)) := ⟨IsLocalRing.closedPoint L⟩
    have h1 := pt hcomp' p
    simp only [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply] at h1
    exact h1.trans (Scheme.fromSpecResidueField_apply _ _)

  have hPw : ∀ a, σ a ≫ u =
      (Spec.map e' ≫ Y'.fromSpecResidueField (genericPoint Y')) ≫ (q' ≫ ι) := by
    intro a
    rw [hσ a, ← hcomp']
    simp only [Category.assoc]
  obtain ⟨P, hPfst, hPsnd⟩ : ∃ P : Fin m → (Spec (.of L) ⟶ Limits.pullback u (q' ≫ ι)),
      (∀ a, P a ≫ Limits.pullback.fst _ _ = σ a) ∧
      (∀ a, P a ≫ Limits.pullback.snd _ _ =
        Spec.map e' ≫ Y'.fromSpecResidueField (genericPoint Y')) :=
    ⟨fun a => Limits.pullback.lift (σ a) _ (hPw a), fun a => Limits.pullback.lift_fst _ _ _,
      fun a => Limits.pullback.lift_snd _ _ _⟩

  have s2 : ∀ (X' : Scheme.{u}) (sY : X' ⟶ Y') [LocallyOfFiniteType sY]
      (Pt : Spec (.of L) ⟶ X'),
      Pt ≫ sY = Spec.map e' ≫ Y'.fromSpecResidueField (genericPoint Y') →
      ∃ (V : Y'.Opens) (f : V.toScheme ⟶ X'), genericPoint Y' ∈ V ∧ f ≫ sY = V.ι ∧
        ∀ g : Spec (.of L) ⟶ V.toScheme,
          g ≫ V.ι = Spec.map e' ≫ Y'.fromSpecResidueField (genericPoint Y') → g ≫ f = Pt := by
    intro X' sY _ Pt hPt
    haveI hres : IsIso (Y'.residue (genericPoint Y')) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      refine ⟨?_, Scheme.residue_surjective _ _⟩
      exact RingHom.injective _
    have hb3 : Y'.fromSpecResidueField (genericPoint Y') =
        Spec.map (Y'.residue (genericPoint Y')) ≫ Y'.fromSpecStalk (genericPoint Y') := rfl
    have hc1 : ∀ {T : Scheme.{u}} (Z : Spec (Y'.presheaf.stalk (genericPoint Y')) ⟶ T),
        Spec.map (inv e' ≫ inv (Y'.residue (genericPoint Y'))) ≫ Spec.map e' ≫
          Spec.map (Y'.residue (genericPoint Y')) ≫ Z = Z := by
      intro T Z
      rw [hSc (Y'.residue (genericPoint Y')) e',
        hSc (Y'.residue (genericPoint Y') ≫ e') (inv e' ≫ inv (Y'.residue (genericPoint Y')))]
      simp only [Category.assoc, IsIso.hom_inv_id_assoc, IsIso.hom_inv_id, Spec.map_id,
        Category.id_comp]
    have hc2 : ∀ {T : Scheme.{u}} (Z : Spec (.of L) ⟶ T),
        Spec.map e' ≫ Spec.map (Y'.residue (genericPoint Y')) ≫
          Spec.map (inv e' ≫ inv (Y'.residue (genericPoint Y'))) ≫ Z = Z := by
      intro T Z
      rw [hSc (inv e' ≫ inv (Y'.residue (genericPoint Y'))) (Y'.residue (genericPoint Y')),
        hSc ((inv e' ≫ inv (Y'.residue (genericPoint Y'))) ≫ Y'.residue (genericPoint Y')) e']
      simp only [Category.assoc, IsIso.inv_hom_id, Spec.map_id, Category.id_comp]
    have hφ : (Spec.map (inv e' ≫ inv (Y'.residue (genericPoint Y'))) ≫ Pt) ≫ sY =
        Y'.fromSpecStalk (genericPoint Y') ≫ 𝟙 Y' := by
      rw [Category.assoc, hPt, hb3, Category.comp_id, hc1]
    obtain ⟨V, hV, f, hφV, hf⟩ :=
      spread_out_of_isGermInjective' (𝟙 Y') sY (x := genericPoint Y') _ hφ
    refine ⟨V, f, hV, by rw [hf, Category.comp_id], ?_⟩
    intro g hg
    have hg' : g = Spec.map e' ≫ Spec.map (Y'.residue (genericPoint Y')) ≫
        V.fromSpecStalkOfMem (genericPoint Y') hV := by
      rw [← cancel_mono V.ι, hg, Category.assoc, Category.assoc,
        Scheme.Opens.fromSpecStalkOfMem_ι, hb3]
    rw [hg', Category.assoc, Category.assoc, ← hφV, hc2]

  choose V f hηV hf hg using fun a =>
    s2 _ (Limits.pullback.snd u (q' ≫ ι)) (P a) (hPsnd a)

  obtain ⟨Vint, hVint⟩ : ∃ Vint : Y'.Opens, (Vint : Set Y') = ⋂ a, (V a : Set Y') :=
    ⟨⟨_, isOpen_iInter_of_finite (fun a => (V a).isOpen)⟩, rfl⟩
  have hη'Vint : genericPoint Y' ∈ Vint := by
    rw [← SetLike.mem_coe, hVint]
    exact Set.mem_iInter.mpr hηV

  have hB : IsClosed (q' '' (Vint : Set Y')ᶜ) :=
    q'.isClosedMap _ Vint.isOpen.isClosed_compl
  obtain ⟨O, hO⟩ : ∃ O : U.Opens, (O : Set U) = (q' '' (Vint : Set Y')ᶜ)ᶜ :=
    ⟨⟨_, hB.isOpen_compl⟩, rfl⟩
  obtain ⟨W, hWdef⟩ : ∃ W : Y'.Opens, W = q' ⁻¹ᵁ O := ⟨_, rfl⟩
  have hWV : ∀ y : Y', y ∈ W → y ∈ Vint := by
    intro y hy
    rw [hWdef, Scheme.Hom.mem_preimage] at hy
    by_contra hn
    have h2 : q' y ∈ (O : Set U) := hy
    rw [hO] at h2
    exact h2 ⟨y, hn, rfl⟩
  have hη'W : genericPoint Y' ∈ W := by
    rw [hWdef, Scheme.Hom.mem_preimage, ← SetLike.mem_coe, hO]
    rintro ⟨y, hy, hyeq⟩
    apply hy
    have h3 := huniq y (by rw [hyeq, P0])
    rw [h3]
    exact hη'Vint
  have hηU₀ : genericPoint S ∈ ι ''ᵁ O := by
    rw [← SetLike.mem_coe, Scheme.Hom.coe_image]
    rw [hWdef] at hη'W
    exact ⟨q' (genericPoint Y'), (Scheme.Hom.mem_preimage _).mp hη'W, P0⟩
  haveI hrs : Surjective (q' ∣_ O) :=
    MorphismProperty.of_isPullback (P := @Surjective) (isPullback_morphismRestrict q' O).flip
      ‹Surjective q'›
  obtain ⟨q₀, hq₀f, hq₀s, hQ⟩ : ∃ q₀ : W.toScheme ⟶ (ι ''ᵁ O).toScheme,
      IsFinite q₀ ∧ Surjective q₀ ∧ q₀ ≫ (ι ''ᵁ O).ι = W.ι ≫ q' ≫ ι := by
    subst hWdef
    refine ⟨(q' ∣_ O) ≫ (ι.isoImage O).hom, inferInstance, inferInstance, ?_⟩
    rw [Category.assoc, Scheme.Hom.isoImage_hom_ι, ← Category.assoc, morphismRestrict_ι,
      Category.assoc]

  haveI : Nonempty W.toScheme := ⟨⟨genericPoint Y', hη'W⟩⟩
  haveI hWint : AlgebraicGeometry.IsIntegral W.toScheme := isIntegral_of_isOpenImmersion W.ι
  haveI hWln : IsLocallyNoetherian W.toScheme := inferInstance

  have hG : W.ι (genericPoint W.toScheme) = genericPoint Y' :=
    genericPoint_eq_of_isOpenImmersion W.ι
  obtain ⟨eW, heW, hcW⟩ : ∃ eW : W.toScheme.residueField (genericPoint W.toScheme) ⟶
      Y'.residueField (genericPoint Y'), IsIso eW ∧
      Spec.map eW ≫ W.toScheme.fromSpecResidueField (genericPoint W.toScheme) ≫ W.ι =
        Y'.fromSpecResidueField (genericPoint Y') := by
    refine ⟨inv (W.ι.residueFieldMap (genericPoint W.toScheme)) ≫
      (Y'.residueFieldCongr hG).hom, inferInstance, ?_⟩
    rw [← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField, hSc, IsIso.hom_inv_id_assoc]
    exact Scheme.residueFieldCongr_fromSpecResidueField hG
  haveI := heW
  have huW : ∀ y : W.toScheme, W.ι y = genericPoint Y' → y = genericPoint W.toScheme := by
    intro y hy
    exact W.ι.isOpenEmbedding.injective (hy.trans hG.symm)
  have J : (Spec.map (eW ≫ e') ≫ W.toScheme.fromSpecResidueField (genericPoint W.toScheme)) ≫
      W.ι = Spec.map e' ≫ Y'.fromSpecResidueField (genericPoint Y') := by
    rw [Spec.map_comp, Category.assoc, Category.assoc, hcW]

  have hWa : ∀ a, W ≤ V a := by
    intro a y hy
    have h4 := hWV y hy
    rw [← SetLike.mem_coe, hVint] at h4
    exact Set.mem_iInter.mp h4 a
  have hc : ∀ a, (Y'.homOfLE (hWa a) ≫ f a ≫ Limits.pullback.fst u (q' ≫ ι)) ≫ u =
      𝟙 _ ≫ q₀ ≫ (ι ''ᵁ O).ι := by
    intro a
    have h5 : Y'.homOfLE (hWa a) ≫ f a ≫ Limits.pullback.snd u (q' ≫ ι) = W.ι := by
      rw [hf a, Scheme.homOfLE_ι]
    calc (Y'.homOfLE (hWa a) ≫ f a ≫ Limits.pullback.fst u (q' ≫ ι)) ≫ u
        = (Y'.homOfLE (hWa a) ≫ f a ≫ Limits.pullback.snd u (q' ≫ ι)) ≫ q' ≫ ι := by
          simp only [Category.assoc, Limits.pullback.condition]
      _ = _ := by rw [h5, Category.id_comp, hQ]
  obtain ⟨ρ, hρfst, hρsnd⟩ : ∃ ρ : Fin m → (W.toScheme ⟶ Limits.pullback u (q₀ ≫ (ι ''ᵁ O).ι)),
      (∀ a, ρ a ≫ Limits.pullback.fst _ _ =
        Y'.homOfLE (hWa a) ≫ f a ≫ Limits.pullback.fst u (q' ≫ ι)) ∧
      ∀ a, ρ a ≫ Limits.pullback.snd _ _ = 𝟙 _ :=
    ⟨fun a => Limits.pullback.lift _ _ (hc a), fun a => Limits.pullback.lift_fst _ _ _,
      fun a => Limits.pullback.lift_snd _ _ _⟩

  have G10 : ∀ y : W.toScheme, (ι ''ᵁ O).ι (q₀ y) = genericPoint S →
      y = genericPoint W.toScheme := by
    intro y hy
    rw [pt hQ y, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at hy
    exact huW y (huniq _ hy)

  have G11 : Spec.map (eW ≫ e') ≫ W.toScheme.fromSpecResidueField (genericPoint W.toScheme) ≫
      q₀ ≫ (ι ''ᵁ O).ι = Spec.map (CommRingCat.ofHom
        (algebraMap (S.residueField (genericPoint S)) L)) ≫
        S.fromSpecResidueField (genericPoint S) := by
    rw [hQ, ← hcomp']
    simp only [← Category.assoc]
    rw [J]

  have G13 : ∀ a, Spec.map (eW ≫ e') ≫
      W.toScheme.fromSpecResidueField (genericPoint W.toScheme) ≫ ρ a ≫
        Limits.pullback.fst u (q₀ ≫ (ι ''ᵁ O).ι) = σ a := by
    intro a
    rw [hρfst a]
    have h6 : (Spec.map (eW ≫ e') ≫
        W.toScheme.fromSpecResidueField (genericPoint W.toScheme) ≫ Y'.homOfLE (hWa a)) ≫
          (V a).ι = Spec.map e' ≫ Y'.fromSpecResidueField (genericPoint Y') := by
      rw [Category.assoc, Category.assoc, Scheme.homOfLE_ι, ← Category.assoc, J]
    have h7 := hg a _ h6
    rw [← hPfst a, ← h7]
    simp only [Category.assoc]
  exact ⟨ι ''ᵁ O, W.toScheme, hWint, hWln, q₀, eW ≫ e', ρ, hηU₀, hq₀f, hq₀s, G10,
    inferInstance, G11, hρsnd, G13⟩

theorem wcpa_dj_sso_split_cover : ∀ (S X : Scheme.{u}) [AlgebraicGeometry.IsIntegral S] [IsLocallyNoetherian S] (u : X ⟶ S), Flat u → IsProper u → LocallyOfFinitePresentation u → (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ S), wcpaDjSolSS u K s) → ∃ (U₀ : S.Opens) (Y : Scheme.{u}) (_ : AlgebraicGeometry.IsIntegral Y) (_ : IsLocallyNoetherian Y) (q₀ : Y ⟶ U₀.toScheme) (r m : ℕ) (Ebar : Fin r → Set ↥(Limits.pullback u (q₀ ≫ U₀.ι))) (ρ : Fin m → (Y ⟶ Limits.pullback u (q₀ ≫ U₀.ι))), genericPoint S ∈ U₀ ∧ IsFinite q₀ ∧ Surjective q₀ ∧ (∀ y : Y, U₀.ι (q₀ y) = genericPoint S → y = genericPoint Y) ∧ (∀ j, IsClosed (Ebar j)) ∧ (∀ a, ρ a ≫ Limits.pullback.snd u (q₀ ≫ U₀.ι) = 𝟙 Y) ∧ (∀ j, ∃ a, ρ a (genericPoint Y) ∈ Ebar j ∧ ∀ j', j' ≠ j → ρ a (genericPoint Y) ∉ Ebar j') ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ε : Spec (.of Ω) ⟶ Y), ε (IsLocalRing.closedPoint Ω) = genericPoint Y → ((∀ j, (Limits.pullback.fst (Limits.pullback.snd u (q₀ ≫ U₀.ι)) ε) ⁻¹' (Ebar j) ∈ irreducibleComponents ↥(Limits.pullback (Limits.pullback.snd u (q₀ ≫ U₀.ι)) ε)) ∧ (∀ E ∈ irreducibleComponents ↥(Limits.pullback (Limits.pullback.snd u (q₀ ≫ U₀.ι)) ε), ∃ j, E = (Limits.pullback.fst (Limits.pullback.snd u (q₀ ≫ U₀.ι)) ε) ⁻¹' (Ebar j)) ∧ (∀ w : ↥(Limits.pullback (Limits.pullback.snd u (q₀ ≫ U₀.ι)) ε), (∃ j j', j ≠ j' ∧ Limits.pullback.fst (Limits.pullback.snd u (q₀ ≫ U₀.ι)) ε w ∈ Ebar j ∧ Limits.pullback.fst (Limits.pullback.snd u (q₀ ≫ U₀.ι)) ε w ∈ Ebar j') → ∃ a, Limits.pullback.fst (Limits.pullback.snd u (q₀ ≫ U₀.ι)) ε w = ρ a (genericPoint Y))) :=
by
  intro S X _ _ u hfl hpr hfp hSS
  classical
  haveI : IsProper u := hpr
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]

  have s3h : ∀ {X Y S : Scheme.{u}} (i : X ⟶ Y) [IsIso i] (p : X ⟶ S) (q : Y ⟶ S), i ≫ q = p →
      ∀ (W' : Y.Opens), SmoothOfRelativeDimension 1 (W'.ι ≫ q) →
        SmoothOfRelativeDimension 1 ((i ⁻¹ᵁ W').ι ≫ p) := by
    intro X Y S i _ p q hi W' hW'
    have hfac' : (i ⁻¹ᵁ W').ι ≫ p = (i ∣_ W') ≫ (W'.ι ≫ q) := by
      rw [← hi, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    have hpb : IsPullback (i ∣_ W') ((i ∣_ W') ≫ (W'.ι ≫ q)) (W'.ι ≫ q) (𝟙 S) :=
      IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]⟩
    rw [hfac']
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hW'
  have hcomap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B) (n : ℕ), IsLocalRing.maximalIdeal A ^ n ≤
        Ideal.comap (σ : A →+* B) (IsLocalRing.maximalIdeal B ^ n) := by
    intro A B _ _ _ _ σ n
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
    apply Ideal.pow_right_mono
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
    intro h
    exact hx ((MulEquiv.isUnit_map (σ : A ≃* B)).mp h)
  have hfac : ∀ (A : Type u) [CommRing A] (I : Ideal A) (m n : ℕ) (h : m ≤ n)
      (x : AdicCompletion I A),
      Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) = AdicCompletion.evalₐ I m x := by
    intro A _ I m n h x
    obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I A x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, Ideal.Quotient.factorPow,
      Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
    have := (Submodule.Quotient.eq _).mp (AdicCompletion.AdicCauchySequence.mk_eq_mk h c)
    simpa [smul_eq_mul, Ideal.mul_top] using this
  have hmap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ (n : ℕ) x (a : A),
        AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
        AdicCompletion.evalₐ _ n (Φ x) = Ideal.Quotient.mk _ (σ a) := by
    intro A B _ _ _ _ σ
    let f : ∀ n : ℕ, AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
        B ⧸ IsLocalRing.maximalIdeal B ^ n := fun n =>
      (Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)).comp
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom
    have hf : ∀ (n : ℕ) x (a : A), AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
        f n x = Ideal.Quotient.mk _ (σ a) := by
      intro n x a ha
      show Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)
        (AdicCompletion.evalₐ _ n x) = _
      rw [ha, Ideal.quotientMap_mk]
      rfl
    have hcompat : ∀ {m n : ℕ} (hle : m ≤ n),
        (Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal B) hle).comp (f n) = f m := by
      intro m n hle
      ext x
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n x)
      have ha' : AdicCompletion.evalₐ _ m x = Ideal.Quotient.mk _ a := by
        rw [← hfac A _ m n hle x, ← ha, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
      rw [RingHom.comp_apply, hf n x a ha.symm, hf m x a ha', Ideal.Quotient.factorPow,
        Ideal.Quotient.factor_mk]
    refine ⟨AdicCompletion.liftRingHom _ f hcompat, ?_⟩
    intro n x a ha
    rw [AdicCompletion.evalₐ_liftRingHom]
    exact hf n x a ha
  have s1a : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ a : A,
        Φ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) =
          algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (σ a) := by
    intro A B _ _ _ _ σ
    obtain ⟨Φ, hΦ⟩ := hmap A B σ
    obtain ⟨Ψ, hΨ⟩ := hmap B A σ.symm
    have h1 : Φ.comp Ψ = RingHom.id _ := by
      ext1 y
      apply AdicCompletion.ext_evalₐ
      intro n
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
      rw [RingHom.comp_apply, hΦ n _ _ (hΨ n y b hb.symm), RingEquiv.apply_symm_apply,
        RingHom.id_apply, hb]
    have h2 : Ψ.comp Φ = RingHom.id _ := by
      ext1 y
      apply AdicCompletion.ext_evalₐ
      intro n
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
      rw [RingHom.comp_apply, hΨ n _ _ (hΦ n y b hb.symm), RingEquiv.symm_apply_apply,
        RingHom.id_apply, hb]
    refine ⟨RingEquiv.ofRingHom Φ Ψ h1 h2, ?_⟩
    intro a
    apply AdicCompletion.ext_evalₐ
    intro n
    have hof : ∀ (R : Type u) [CommRing R] (I : Ideal R) (r : R),
        AdicCompletion.evalₐ I n (algebraMap R (AdicCompletion I R) r) =
          Ideal.Quotient.mk _ r := by
      intro R _ I r
      rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of, Algebra.algebraMap_self,
        RingHom.id_apply]
    show AdicCompletion.evalₐ _ n (Φ _) = _
    rw [hΦ n _ a (hof A _ a), hof B _ (σ a)]
  have s2a : ∀ (K : Type u) [Field K] {X Y : Scheme.{u}} (i : X ⟶ Y) (p : X ⟶ Spec (.of K))
      (q : Y ⟶ Spec (.of K)), i ≫ q = p → ∀ x : X,
      ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ Y.presheaf.germ ⊤ (i x) trivial) ≫
        i.stalkMap x =
      (Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial := by
    intro K _ X Y i p q hi x
    have key : Y.presheaf.germ ⊤ (i x) trivial ≫ i.stalkMap x =
        i.appTop ≫ X.presheaf.germ ⊤ x trivial := Scheme.Hom.germ_stalkMap i ⊤ x trivial
    rw [← hi, Scheme.Hom.comp_appTop]
    simp only [Category.assoc]
    exact congrArg (fun t => (Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ t) key
  have SSiso : ∀ (K : Type u) [Field K] {X Y : Scheme.{u}} (i : X ⟶ Y) [IsIso i]
      (p : X ⟶ Spec (.of K)) (q : Y ⟶ Spec (.of K)), i ≫ q = p → ∀ x : X,
      ((∃ W : Y.Opens, i x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) ∨
        (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk (i x)))
            (Y.presheaf.stalk (i x)) ≃+*
            (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
          (e.toRingHom.comp ((algebraMap (Y.presheaf.stalk (i x))
            (AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk (i x)))
              (Y.presheaf.stalk (i x)))).comp
            ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫
              Y.presheaf.germ ⊤ (i x) trivial).hom)) =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C)) →
      ((∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p)) ∨
        (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x))
            (X.presheaf.stalk x) ≃+*
            (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
          (e.toRingHom.comp ((algebraMap (X.presheaf.stalk x)
            (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x))
              (X.presheaf.stalk x))).comp
            ((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫
              X.presheaf.germ ⊤ x trivial).hom)) =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C)) := by
    intro K _ X Y i _ p q hi w hY
    rcases hY with ⟨W', hw', hsm⟩ | ⟨e₀, he₀⟩
    · left
      exact ⟨i ⁻¹ᵁ W', hw', s3h i _ _ hi W' hsm⟩
    · right
      let τ := Iso.commRingCatIsoToRingEquiv (asIso (i.stalkMap w))
      obtain ⟨Φ, hΦ⟩ := s1a _ _ τ.symm
      refine ⟨Φ.trans e₀, ?_⟩
      have h2 := s2a K i _ _ hi w
      ext1 k
      have hk : τ.symm (((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫
          X.presheaf.germ ⊤ w trivial).hom k) =
          ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫
            Y.presheaf.germ ⊤ (i w) trivial).hom k := by
        rw [← h2, RingEquiv.symm_apply_eq]
        rfl
      have := RingHom.congr_fun he₀ k
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at this ⊢
      rw [RingEquiv.trans_apply, hΦ, hk]
      exact this

  have hcomp : ∀ {A B : Type u} [TopologicalSpace A] [TopologicalSpace B] (Φ : A ≃ₜ B)
      (V : Set A), V ∈ irreducibleComponents A → Φ '' V ∈ irreducibleComponents B := by
    intro A B _ _ Φ V hV
    refine image_mem_irreducibleComponents_of_isPreirreducible_fiber Φ Φ.continuous Φ.isOpenMap
      ?_ Φ.surjective hV
    intro y
    apply Set.Subsingleton.isPreirreducible
    intro a ha a' ha'
    exact Φ.injective (ha.trans ha'.symm)

  obtain ⟨T, fT, h, hpbT⟩ : ∃ (T : Scheme.{u}) (fT : T ⟶ X)
      (h : T ⟶ Spec (.of (S.residueField (genericPoint S)))),
      IsPullback fT h u (S.fromSpecResidueField (genericPoint S)) :=
    ⟨_, _, _, IsPullback.of_hasPullback _ _⟩
  haveI hhprop : IsProper h := MorphismProperty.of_isPullback (P := @IsProper) hpbT hpr
  have hnod : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
      (t : Spec (.of Ω) ⟶ Spec (.of (S.residueField (genericPoint S)))), wcpaDjSolSS h Ω t := by
    intro Ω _ _ t w
    have hQ : IsPullback (Limits.pullback.fst h t ≫ fT) (Limits.pullback.snd h t) u
        (t ≫ S.fromSpecResidueField (genericPoint S)) :=
      (IsPullback.of_hasPullback h t).paste_horiz hpbT
    exact SSiso Ω hQ.isoPullback.hom _ _ hQ.isoPullback_hom_snd w
      (hSS Ω _ (hQ.isoPullback.hom w))

  obtain ⟨L, iL, iA, iFD, r, m, Z, σ, hZcl, hσs, hanch, hgeo⟩ :=
    wcpa_dj_ssc_field_split (S.residueField (genericPoint S)) T h hnod
  have houter : IsPullback
      (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom
        (algebraMap (S.residueField (genericPoint S)) L))) ≫ fT)
      (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom
        (algebraMap (S.residueField (genericPoint S)) L))))
      u (Spec.map (CommRingCat.ofHom (algebraMap (S.residueField (genericPoint S)) L)) ≫
        S.fromSpecResidueField (genericPoint S)) :=
    (IsPullback.of_hasPullback _ _).paste_horiz hpbT

  have hσX : ∀ a, (σ a ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom
        (algebraMap (S.residueField (genericPoint S)) L))) ≫ fT) ≫ u =
      Spec.map (CommRingCat.ofHom (algebraMap (S.residueField (genericPoint S)) L)) ≫
        S.fromSpecResidueField (genericPoint S) := by
    intro a
    rw [Category.assoc, houter.w, ← Category.assoc, hσs a, Category.id_comp]
  obtain ⟨U₀, Y, iY, iYn, q₀, e, ρ, hηU₀, hfin, hsurj, hgen, hiso, hcompat, hρs, hρσ⟩ :=
    wcpa_dj_ssc_finite_model_sections S X u L m
      (fun a => σ a ≫ Limits.pullback.fst h (Spec.map (CommRingCat.ofHom
        (algebraMap (S.residueField (genericPoint S)) L))) ≫ fT) hσX
  haveI := iY
  haveI : IsIso e := hiso
  have hρσ' : ∀ a, Spec.map e ≫ Y.fromSpecResidueField (genericPoint Y) ≫ ρ a ≫
      Limits.pullback.fst u (q₀ ≫ U₀.ι) = σ a ≫ Limits.pullback.fst h (Spec.map
        (CommRingCat.ofHom (algebraMap (S.residueField (genericPoint S)) L))) ≫ fT := hρσ
  obtain ⟨j0, hj0⟩ : ∃ j0 : Spec (.of L) ⟶ Y,
      j0 = Spec.map e ≫ Y.fromSpecResidueField (genericPoint Y) := ⟨_, rfl⟩
  have hj0b : j0 ≫ q₀ ≫ U₀.ι =
      Spec.map (CommRingCat.ofHom (algebraMap (S.residueField (genericPoint S)) L)) ≫
        S.fromSpecResidueField (genericPoint S) := by
    rw [hj0, Category.assoc]; exact hcompat

  have hw : (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom
        (algebraMap (S.residueField (genericPoint S)) L))) ≫ fT) ≫ u =
      (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom
        (algebraMap (S.residueField (genericPoint S)) L))) ≫ j0) ≫ (q₀ ≫ U₀.ι) := by
    rw [houter.w, Category.assoc, hj0b]
  obtain ⟨κ, hκfst, hκsnd⟩ : ∃ κ : Limits.pullback h (Spec.map (CommRingCat.ofHom
        (algebraMap (S.residueField (genericPoint S)) L))) ⟶ Limits.pullback u (q₀ ≫ U₀.ι),
      κ ≫ Limits.pullback.fst u (q₀ ≫ U₀.ι) = Limits.pullback.fst h (Spec.map
        (CommRingCat.ofHom (algebraMap (S.residueField (genericPoint S)) L))) ≫ fT ∧
      κ ≫ Limits.pullback.snd u (q₀ ≫ U₀.ι) = Limits.pullback.snd h (Spec.map
        (CommRingCat.ofHom (algebraMap (S.residueField (genericPoint S)) L))) ≫ j0 :=
    ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  have hκ : IsPullback κ (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom
        (algebraMap (S.residueField (genericPoint S)) L))))
      (Limits.pullback.snd u (q₀ ≫ U₀.ι)) j0 := by
    refine IsPullback.of_right ?_ hκsnd (IsPullback.of_hasPullback u (q₀ ≫ U₀.ι))
    rw [hκfst, hj0b]
    exact houter
  haveI : IsPreimmersion j0 := by rw [hj0]; infer_instance
  haveI : IsPreimmersion κ := MorphismProperty.of_isPullback (P := @IsPreimmersion) hκ.flip
    inferInstance
  have hemb : Topology.IsEmbedding ⇑κ := Scheme.Hom.isEmbedding κ

  obtain ⟨Ebar, hEbar⟩ : ∃ Ebar : Fin r → Set ↥(Limits.pullback u (q₀ ≫ U₀.ι)),
      ∀ j, Ebar j = closure (⇑κ '' Z j) := ⟨fun j => closure (⇑κ '' Z j), fun _ => rfl⟩
  have hpre : ∀ j, ⇑κ ⁻¹' Ebar j = Z j := by
    intro j
    rw [hEbar j, ← hemb.closure_eq_preimage_closure_image, (hZcl j).closure_eq]
  have hmem : ∀ j x, κ x ∈ Ebar j ↔ x ∈ Z j := fun j x => Set.ext_iff.mp (hpre j) x

  have hρκ : ∀ a, j0 ≫ ρ a = σ a ≫ κ := by
    intro a
    apply Limits.pullback.hom_ext
    · rw [Category.assoc, Category.assoc, hκfst, hj0, Category.assoc, hρσ' a]
    · rw [Category.assoc, Category.assoc, hρs a, Category.comp_id, hκsnd, ← Category.assoc,
        hσs a, Category.id_comp]
  have hj0pt' : ∀ p : ↥(Spec (.of L)), j0 p = genericPoint Y := by
    intro p
    rw [hj0, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
  have hρpt' : ∀ a (p : ↥(Spec (.of L))), ρ a (j0 p) = κ (σ a p) := by
    intro a p
    rw [pt (hρκ a) p, Scheme.Hom.comp_apply]
  have hρpt : ∀ a, ρ a (genericPoint Y) = κ (σ a (IsLocalRing.closedPoint L)) := by
    intro a
    have e1 := hρpt' a (IsLocalRing.closedPoint L)
    refine Eq.trans ?_ e1
    exact congrArg (ρ a) (hj0pt' (IsLocalRing.closedPoint L)).symm
  refine ⟨U₀, Y, iY, iYn, q₀, r, m, Ebar, ρ, hηU₀, hfin, hsurj, hgen, ?_, hρs, ?_, ?_⟩
  · intro j
    rw [hEbar j]
    exact isClosed_closure
  ·
    intro j
    obtain ⟨a, ha1, ha2⟩ := hanch j
    refine ⟨a, ?_, ?_⟩
    · rw [hρpt a]
      exact (hmem j _).mpr ha1
    · intro j' hj' hc
      rw [hρpt a] at hc
      exact ha2 j' hj' ((hmem j' _).mp hc)
  ·
    intro Ω _ _ ε hε
    obtain ⟨t', ht'⟩ : ∃ t' : Spec (.of Ω) ⟶ Spec (.of L), t' ≫ j0 = ε := by
      obtain ⟨⟨y, φ⟩, hyφ⟩ : ∃ xf, (Scheme.SpecToEquivOfField Ω Y).symm xf = ε :=
        ⟨_, Equiv.symm_apply_apply _ ε⟩
      rw [Scheme.SpecToEquivOfField_symm_apply] at hyφ
      have h2 : ∀ p : ↥(Spec (.of Ω)), ε p = y := by
        intro p
        rw [← hyφ, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
      have hy : y = genericPoint Y := by
        rw [← hε]
        exact (h2 (IsLocalRing.closedPoint Ω)).symm
      subst hy
      refine ⟨Spec.map (inv e ≫ φ), ?_⟩
      rw [hj0, ← Category.assoc, ← Spec.map_comp, IsIso.hom_inv_id_assoc]
      exact hyφ
    subst ht'
    have hP : IsPullback (Limits.pullback.fst (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom
          (algebraMap (S.residueField (genericPoint S)) L)))) t' ≫ κ)
        (Limits.pullback.snd (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom
          (algebraMap (S.residueField (genericPoint S)) L)))) t')
        (Limits.pullback.snd u (q₀ ≫ U₀.ι)) (t' ≫ j0) :=
      (IsPullback.of_hasPullback _ _).paste_horiz hκ
    obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : ↥(Limits.pullback (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom
          (algebraMap (S.residueField (genericPoint S)) L)))) t') ≃ₜ
        ↥(Limits.pullback (Limits.pullback.snd u (q₀ ≫ U₀.ι)) (t' ≫ j0)),
        ∀ x, Ψ x = hP.isoPullback.hom x :=
      ⟨Scheme.homeoOfIso hP.isoPullback, Scheme.homeoOfIso_apply hP.isoPullback⟩
    have hFΨ : ∀ x, Limits.pullback.fst (Limits.pullback.snd u (q₀ ≫ U₀.ι)) (t' ≫ j0) (Ψ x) =
        κ (Limits.pullback.fst (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom
          (algebraMap (S.residueField (genericPoint S)) L)))) t' x) := by
      intro x
      rw [hΨ, pt hP.isoPullback_hom_fst x, Scheme.Hom.comp_apply]
    have hpreF : ∀ j, ⇑(Limits.pullback.fst (Limits.pullback.snd u (q₀ ≫ U₀.ι)) (t' ≫ j0)) ⁻¹'
        Ebar j = ⇑Ψ.symm ⁻¹' (⇑(Limits.pullback.fst (Limits.pullback.snd h (Spec.map
          (CommRingCat.ofHom (algebraMap (S.residueField (genericPoint S)) L)))) t') ⁻¹' Z j) := by
      intro j
      ext w
      have h1 := hFΨ (Ψ.symm w)
      rw [Ψ.apply_symm_apply] at h1
      show _ ∈ Ebar j ↔ _ ∈ Z j
      rw [h1]
      exact hmem j _
    have himg : ∀ s, ⇑Ψ.symm ⁻¹' s = ⇑Ψ '' s := by
      intro s
      ext w
      constructor
      · intro hw'
        exact ⟨Ψ.symm w, hw', Ψ.apply_symm_apply w⟩
      · rintro ⟨x, hx, rfl⟩
        show Ψ.symm (Ψ x) ∈ s
        rw [Ψ.symm_apply_apply]
        exact hx
    obtain ⟨g1, g2, g3⟩ := hgeo Ω t'
    refine ⟨?_, ?_, ?_⟩
    · intro j
      rw [hpreF j, himg]
      exact hcomp Ψ _ (g1 j)
    · intro E hE
      obtain ⟨j, hj⟩ := g2 _ (hcomp Ψ.symm E hE)
      refine ⟨j, ?_⟩
      rw [hpreF j, ← hj]
      ext w
      exact (Ψ.symm.injective.mem_set_image).symm
    · rintro w ⟨j, j', hjj', h1, h2⟩
      have h1' := (Set.ext_iff.mp (hpreF j) w).mp h1
      have h2' := (Set.ext_iff.mp (hpreF j') w).mp h2
      obtain ⟨a, ha⟩ := g3 (Ψ.symm w) ⟨j, j', hjj', h1', h2'⟩
      refine ⟨a, ?_⟩
      rw [hρpt a, ← ha, ← hFΨ, Ψ.apply_symm_apply]

theorem wcpa_dj_sso_data_spread : ∀ (Y X : Scheme.{u}) [AlgebraicGeometry.IsIntegral Y] [IsLocallyNoetherian Y] (u : X ⟶ Y) (r m k : ℕ) (Ebar : Fin r → Set X) (ρ : Fin m → (Y ⟶ X)) (σ : Fin k → (Y ⟶ X)), Flat u → IsProper u → LocallyOfFinitePresentation u → (∀ j, IsClosed (Ebar j)) → (∀ a, ρ a ≫ u = 𝟙 Y) → (∀ i, σ i ≫ u = 𝟙 Y) → (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ε : Spec (.of Ω) ⟶ Y), ε (IsLocalRing.closedPoint Ω) = genericPoint Y → ((∀ j, (Limits.pullback.fst u ε) ⁻¹' (Ebar j) ∈ irreducibleComponents ↥(Limits.pullback u ε)) ∧ (∀ E ∈ irreducibleComponents ↥(Limits.pullback u ε), ∃ j, E = (Limits.pullback.fst u ε) ⁻¹' (Ebar j)) ∧ (∀ w : ↥(Limits.pullback u ε), (∃ j j', j ≠ j' ∧ Limits.pullback.fst u ε w ∈ Ebar j ∧ Limits.pullback.fst u ε w ∈ Ebar j') → ∃ a, Limits.pullback.fst u ε w = ρ a (genericPoint Y)))) → ∃ V : Y.Opens, genericPoint Y ∈ V ∧ (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (s : Spec (.of Ω) ⟶ Y), s (IsLocalRing.closedPoint Ω) ∈ V → ∀ j, IsIrreducible ((Limits.pullback.fst u s) ⁻¹' (Ebar j))) ∧ (∀ z : X, u z ∈ V → (∃ j j', j ≠ j' ∧ z ∈ Ebar j ∧ z ∈ Ebar j') → ∃ a, z = ρ a (u z)) ∧ (∀ y ∈ V, ∀ a j, ρ a y ∈ Ebar j ↔ ρ a (genericPoint Y) ∈ Ebar j) ∧ (∀ y ∈ V, ∀ i j, σ i y ∈ Ebar j ↔ σ i (genericPoint Y) ∈ Ebar j) ∧ (∀ y ∈ V, ∀ a b, ρ a y = ρ b y ↔ ρ a (genericPoint Y) = ρ b (genericPoint Y)) :=
by
  intro Y X _ _ u r m k Ebar ρ σ hfl hpr hfp hEcl hρ hσ hH
  classical
  haveI := hpr
  haveI := hfl
  haveI := hfp

  have KF : ∀ (F : Set Y), IsClosed F → genericPoint Y ∈ F → ∀ y, y ∈ F := fun F hF hη y =>
    ((genericPoint_spec Y).specializes (Set.mem_univ y)).mem_closed hF hη
  have dich : ∀ (F : Set Y) (P : Y → Prop), IsClosed F → (∀ y, P y ↔ y ∈ F) →
      ∃ O : Set Y, IsOpen O ∧ genericPoint Y ∈ O ∧ ∀ y ∈ O, (P y ↔ P (genericPoint Y)) := by
    intro F P hF hP
    by_cases hη : genericPoint Y ∈ F
    · refine ⟨Set.univ, isOpen_univ, trivial, fun y _ => ?_⟩
      rw [hP, hP]
      exact ⟨fun _ => hη, fun _ => KF F hF hη y⟩
    · refine ⟨Fᶜ, hF.isOpen_compl, hη, fun y hy => ?_⟩
      rw [hP, hP]
      exact ⟨fun h => absurd h hy, fun h => absurd h hη⟩

  have huρ : ∀ a y, u (ρ a y) = y := fun a y => by
    rw [← Scheme.Hom.comp_apply, hρ a]; rfl
  have hclρ : ∀ a, IsClosed (Set.range ⇑(ρ a)) := fun a => by
    haveI : IsClosedImmersion (ρ a ≫ u) := by rw [hρ a]; infer_instance
    haveI := IsClosedImmersion.of_comp (ρ a) u
    exact (IsClosedImmersion.isClosedEmbedding (ρ a)).isClosed_range

  have h3 : ∀ a j, ∃ O : Set Y, IsOpen O ∧ genericPoint Y ∈ O ∧
      ∀ y ∈ O, (ρ a y ∈ Ebar j ↔ ρ a (genericPoint Y) ∈ Ebar j) := fun a j =>
    dich _ (fun y => ρ a y ∈ Ebar j) ((hEcl j).preimage (ρ a).continuous) (fun _ => Iff.rfl)
  have h4 : ∀ i j, ∃ O : Set Y, IsOpen O ∧ genericPoint Y ∈ O ∧
      ∀ y ∈ O, (σ i y ∈ Ebar j ↔ σ i (genericPoint Y) ∈ Ebar j) := fun i j =>
    dich _ (fun y => σ i y ∈ Ebar j) ((hEcl j).preimage (σ i).continuous) (fun _ => Iff.rfl)

  have h5 : ∀ a b, ∃ O : Set Y, IsOpen O ∧ genericPoint Y ∈ O ∧
      ∀ y ∈ O, (ρ a y = ρ b y ↔ ρ a (genericPoint Y) = ρ b (genericPoint Y)) := by
    intro a b
    refine dich (⇑(ρ a) ⁻¹' Set.range ⇑(ρ b)) (fun y => ρ a y = ρ b y)
      ((hclρ b).preimage (ρ a).continuous) ?_
    intro y
    simp only [Set.mem_preimage, Set.mem_range]
    constructor
    · intro h; exact ⟨y, h.symm⟩
    · rintro ⟨y', hy'⟩
      have e : y' = y := by rw [← huρ b y', hy', huρ a y]
      rw [e] at hy'
      exact hy'.symm

  have h1 : ∀ j, ∃ O : Set Y, IsOpen O ∧ genericPoint Y ∈ O ∧
      ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ Y),
        t (IsLocalRing.closedPoint Ω) ∈ O → IsIrreducible ((Limits.pullback.fst u t) ⁻¹' (Ebar j)) :=
    fun j => wc_spread_geom_irreducible_closed X Y u (Ebar j) (hEcl j)
      (fun Ω _ _ t ht => ((hH Ω t ht).1 j).1)

  set N : Set X := ⋃ j, ⋃ j', {z | j ≠ j' ∧ z ∈ Ebar j ∧ z ∈ Ebar j'} with hN
  have hNcl : IsClosed N := isClosed_iUnion_of_finite fun j => isClosed_iUnion_of_finite fun j' => by
    by_cases hjj : j = j'
    · subst hjj; simp
    · have e : {z | j ≠ j' ∧ z ∈ Ebar j ∧ z ∈ Ebar j'} = Ebar j ∩ Ebar j' := by
        ext z; simp [hjj]
      rw [e]
      exact (hEcl j).inter (hEcl j')
  set R : Set X := ⋃ a, Set.range ⇑(ρ a) with hR
  have hRcl : IsClosed R := isClosed_iUnion_of_finite hclρ
  have hNmem : ∀ z, (∃ j j', j ≠ j' ∧ z ∈ Ebar j ∧ z ∈ Ebar j') → z ∈ N := by
    rintro z ⟨j, j', h⟩
    exact Set.mem_iUnion.mpr ⟨j, Set.mem_iUnion.mpr ⟨j', h⟩⟩
  obtain ⟨V2, hV2o, hηV2, -, hV2dis⟩ :=
    wc_generic_constructible_dichotomy X Y u N Rᶜ hNcl hRcl.isOpen_compl
  have hgeom : ∃ (K : Type u) (_ : Field K) (_ : IsAlgClosed K)
      (s : Spec (.of K) ⟶ Y), ∀ p, s p = genericPoint Y := by
    refine ⟨AlgebraicClosure (Y.residueField (genericPoint Y)), inferInstance, inferInstance,
      Spec.map (CommRingCat.ofHom (algebraMap (Y.residueField (genericPoint Y))
        (AlgebraicClosure (Y.residueField (genericPoint Y))))) ≫
        Y.fromSpecResidueField (genericPoint Y), fun p => ?_⟩
    rw [Scheme.Hom.comp_apply]
    exact Scheme.fromSpecResidueField_apply _ _
  obtain ⟨K, iK, iKa, ε, hε⟩ := hgeom
  have hηnot : genericPoint Y ∉ u '' (N ∩ Rᶜ) := by
    rintro ⟨z, ⟨hzN, hzR⟩, hz⟩
    have hzr : z ∈ Set.range ⇑(Limits.pullback.fst u ε) := by
      rw [Scheme.Pullback.range_fst, Set.mem_preimage]
      exact ⟨IsLocalRing.closedPoint K, (hε _).trans hz.symm⟩
    obtain ⟨w, hw⟩ := hzr
    have hNz : ∃ j j', j ≠ j' ∧ z ∈ Ebar j ∧ z ∈ Ebar j' := by
      obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hzN
      obtain ⟨j', hj'⟩ := Set.mem_iUnion.mp hj
      exact ⟨j, j', hj'⟩
    rw [← hw] at hNz
    obtain ⟨a, ha⟩ := (hH K ε (hε _)).2.2 w hNz
    apply hzR
    exact Set.mem_iUnion.mpr ⟨a, ⟨genericPoint Y, ha.symm.trans hw⟩⟩
  have hV2 := hV2dis hηnot
  have h2 : ∀ z : X, u z ∈ V2 → (∃ j j', j ≠ j' ∧ z ∈ Ebar j ∧ z ∈ Ebar j') →
      ∃ a, z = ρ a (u z) := by
    intro z hz htwo
    have hzR : z ∈ R := by
      by_contra hzR
      exact Set.disjoint_left.mp hV2 hz ⟨z, ⟨hNmem z htwo, hzR⟩, rfl⟩
    obtain ⟨a, y', hy'⟩ := Set.mem_iUnion.mp hzR
    refine ⟨a, ?_⟩
    rw [← hy', huρ]

  choose V1 hV1o hηV1 hV1 using h1
  choose V3 hV3o hηV3 hV3 using h3
  choose V4 hV4o hηV4 hV4 using h4
  choose V5 hV5o hηV5 hV5 using h5
  let Vs : Set Y := (⋂ j, V1 j) ∩ V2 ∩ (⋂ a, ⋂ j, V3 a j) ∩ (⋂ i, ⋂ j, V4 i j) ∩
    (⋂ a, ⋂ b, V5 a b)
  have hVo : IsOpen Vs :=
    ((((isOpen_iInter_of_finite hV1o).inter hV2o).inter
      (isOpen_iInter_of_finite fun a => isOpen_iInter_of_finite (hV3o a))).inter
      (isOpen_iInter_of_finite fun i => isOpen_iInter_of_finite (hV4o i))).inter
      (isOpen_iInter_of_finite fun a => isOpen_iInter_of_finite (hV5o a))
  refine ⟨⟨Vs, hVo⟩, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · show genericPoint Y ∈ Vs
    exact ⟨⟨⟨⟨Set.mem_iInter.mpr hηV1, hηV2⟩, Set.mem_iInter₂.mpr hηV3⟩,
      Set.mem_iInter₂.mpr hηV4⟩, Set.mem_iInter₂.mpr hηV5⟩
  · intro Ω _ _ s hs j
    have hs' : s (IsLocalRing.closedPoint Ω) ∈ Vs := hs
    exact hV1 j Ω s (Set.mem_iInter.mp hs'.1.1.1.1 j)
  · intro z hz htwo
    have hz' : u z ∈ Vs := hz
    exact h2 z hz'.1.1.1.2 htwo
  · intro y hy a j
    have hy' : y ∈ Vs := hy
    exact hV3 a j y (Set.mem_iInter₂.mp hy'.1.1.2 a j)
  · intro y hy i j
    have hy' : y ∈ Vs := hy
    exact hV4 i j y (Set.mem_iInter₂.mp hy'.1.2 i j)
  · intro y hy a b
    have hy' : y ∈ Vs := hy
    exact hV5 a b y (Set.mem_iInter₂.mp hy'.2 a b)

theorem wcpa_dj_sso_trait : ∀ (Y : Scheme.{u}) (y y' : Y), y' ⤳ y → ∃ (K : Type u) (_ : Field K) (_ : IsAlgClosed K) (R : ValuationSubring K) (_ : IsAlgClosed (IsLocalRing.ResidueField ↥R)) (g : Spec (.of ↥R) ⟶ Y), (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))) ≫ g) (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥R)) = y ∧ (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) ≫ g) (IsLocalRing.closedPoint K) = y' :=
by
  intro Y y y' h
  have s1 : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K),
      IsAlgClosed (IsLocalRing.ResidueField ↥R) := by
    intro K _ _ R
    apply IsAlgClosed.of_exists_root
    intro pbar hmon hirr
    have hlift : pbar ∈ Polynomial.lifts (IsLocalRing.residue ↥R) :=
      (Polynomial.lifts_iff_set_range _).mpr
        (Polynomial.map_surjective _ IsLocalRing.residue_surjective pbar)
    obtain ⟨p, hp, hdeg, hpmon⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hmon
    have hPmon : (p.map (algebraMap ↥R K)).Monic := hpmon.map _
    have hPdeg : (p.map (algebraMap ↥R K)).natDegree = p.natDegree := hpmon.natDegree_map _
    have hpos : 0 < pbar.natDegree := hirr.natDegree_pos
    have hPdeg' : (p.map (algebraMap ↥R K)).degree ≠ 0 := by
      rw [Polynomial.degree_eq_natDegree hPmon.ne_zero]
      exact_mod_cast (by omega : (p.map (algebraMap ↥R K)).natDegree ≠ 0)
    obtain ⟨θ, hθ⟩ := IsAlgClosed.exists_root _ hPdeg'
    have hint : IsIntegral ↥R θ := ⟨p, hpmon, by rw [Polynomial.eval₂_eq_eval_map]; exact hθ⟩
    obtain ⟨r, hr⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hint
    have hev : Polynomial.eval r p = 0 := by
      apply IsFractionRing.injective ↥R K
      rw [map_zero, ← Polynomial.eval₂_at_apply, hr, Polynomial.eval₂_eq_eval_map]
      exact hθ
    refine ⟨IsLocalRing.residue ↥R r, ?_⟩
    rw [← hp, Polynomial.eval_map, Polynomial.eval₂_at_apply, hev, map_zero]
  let K := AlgebraicClosure ↑(Y.residueField y')
  let j : Y.residueField y' ⟶ CommRingCat.of K :=
    CommRingCat.ofHom (algebraMap (↑(Y.residueField y')) K)
  let F : Y.presheaf.stalk y ⟶ CommRingCat.of K :=
    Y.presheaf.stalkSpecializes h ≫ Y.residue y' ≫ j
  obtain ⟨R, hR, hloc⟩ := IsLocalRing.exists_factor_valuationRing F.hom
  let fR : ↑(Y.presheaf.stalk y) →+* ↥R := F.hom.codRestrict R.toSubring hR
  have : IsLocalHom fR := hloc
  refine ⟨K, inferInstance, inferInstance, R, s1 K R,
    Spec.map (CommRingCat.ofHom fR) ≫ Y.fromSpecStalk y, ?_, ?_⟩
  · have hl : IsLocalHom (CommRingCat.ofHom
        (algebraMap ↥R (IsLocalRing.ResidueField ↥R))).hom := by
      rw [CommRingCat.hom_ofHom, IsLocalRing.ResidueField.algebraMap_eq]
      infer_instance
    have e1 : (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))))
        (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥R)) = IsLocalRing.closedPoint ↥R :=
      Spec_closedPoint
    have hl2 : IsLocalHom (CommRingCat.ofHom fR).hom := by
      rw [CommRingCat.hom_ofHom]; infer_instance
    have e2 : (Spec.map (CommRingCat.ofHom fR)) (IsLocalRing.closedPoint ↥R) =
        IsLocalRing.closedPoint ↑(Y.presheaf.stalk y) :=
      Spec_closedPoint
    exact (congrArg (fun x => Y.fromSpecStalk y x)
      ((congrArg (fun x => Spec.map (CommRingCat.ofHom fR) x) e1).trans e2)).trans
      (Scheme.fromSpecStalk_closedPoint)
  · have claim : CommRingCat.ofHom fR ≫ CommRingCat.ofHom (algebraMap ↥R K) = F := by
      ext x; rfl
    have key : ∀ x : ↥(Spec (CommRingCat.of K)),
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) ≫
          Spec.map (CommRingCat.ofHom fR) ≫ Y.fromSpecStalk y) x = y' := by
      intro x
      rw [← Category.assoc, ← Spec.map_comp, claim]
      simp only [F, Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
      have e : Spec.map (Y.residue y') ≫ Y.fromSpecStalk y' = Y.fromSpecResidueField y' := rfl
      rw [e, Scheme.Hom.comp_apply]
      have hm : Y.fromSpecResidueField y' (Spec.map j x) ∈
          Set.range (Y.fromSpecResidueField y') := Set.mem_range_self _
      rw [Scheme.range_fromSpecResidueField] at hm
      exact hm
    exact key _

theorem wcpa_dj_p1g_flat_model : ∀ (K : Type u) [Field K] (R : ValuationSubring K) (V : Scheme.{u}) (v : V ⟶ Spec (.of ↥R)) (ξ : V), IsProper v → v ξ = genericPoint ↥(Spec (.of ↥R)) → ∃ (Z : Scheme.{u}) (z : Z ⟶ V), IsClosedImmersion z ∧ AlgebraicGeometry.IsIntegral Z ∧ Set.range z = closure {ξ} ∧ Flat (z ≫ v) ∧ IsProper (z ≫ v) ∧ LocallyOfFinitePresentation (z ≫ v) :=
by
  intro K _ R V v ξ hv hξ
  haveI := hv

  obtain ⟨Z, r, hr, hrr, hZred⟩ := wc_reduced_subscheme_exists
    (Scheme.IdealSheafData.vanishingIdeal (⟨closure {ξ}, isClosed_closure⟩ : TopologicalSpace.Closeds V)).subscheme
  haveI := hr
  haveI := hZred
  obtain ⟨z, hz⟩ : ∃ z : Z ⟶ V, z = r ≫
      (Scheme.IdealSheafData.vanishingIdeal (⟨closure {ξ}, isClosed_closure⟩ : TopologicalSpace.Closeds V)).subschemeι :=
    ⟨_, rfl⟩
  haveI hzci : IsClosedImmersion z := by rw [hz]; infer_instance
  have hrange : Set.range z = closure {ξ} := by
    have h1 : Set.range (Scheme.IdealSheafData.vanishingIdeal
        (⟨closure {ξ}, isClosed_closure⟩ : TopologicalSpace.Closeds V)).subschemeι = closure {ξ} := by
      rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
      rfl
    rw [← h1, hz]
    ext x
    constructor
    · rintro ⟨w, rfl⟩
      exact ⟨r w, (Scheme.Hom.comp_apply _ _ w).symm⟩
    · rintro ⟨y, rfl⟩
      have hy : y ∈ Set.range r := by rw [hrr]; trivial
      obtain ⟨w, rfl⟩ := hy
      exact ⟨w, Scheme.Hom.comp_apply _ _ w⟩

  haveI hirr : IrreducibleSpace Z := by
    have hemb := z.isClosedEmbedding
    have hirrS : IsIrreducible (Set.range z) := by
      rw [hrange]; exact isIrreducible_singleton.closure
    haveI : IrreducibleSpace (Set.range z) := Subtype.irreducibleSpace hirrS
    exact Function.Surjective.irreducibleSpace hemb.isEmbedding.toHomeomorph.symm.continuous
      hemb.isEmbedding.toHomeomorph.symm.surjective
  haveI hint : AlgebraicGeometry.IsIntegral Z := isIntegral_of_irreducibleSpace_of_isReduced Z
  have hgen : z (genericPoint Z) = ξ := by
    have h1 := (genericPoint_spec Z).image z.continuous
    rw [Set.image_univ, hrange, closure_closure] at h1
    exact h1.eq isGenericPoint_closure
  have hfgen : (z ≫ v) (genericPoint Z) = genericPoint (Spec (.of R)) := by
    rw [Scheme.Hom.comp_apply, hgen, hξ]

  have hflat : Flat (z ≫ v) := by
    generalize z ≫ v = f at hfgen
    have key : ∀ (U : Z.Opens) (e : U ≤ f ⁻¹ᵁ ⊤),
        RingHom.Flat ((f.appLE ⊤ U e).hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom) := by
      intro U e
      letI : Algebra R Γ(Z, U) :=
        ((f.appLE ⊤ U e).hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom).toAlgebra
      change (algebraMap R Γ(Z, U)).Flat
      rw [RingHom.flat_algebraMap_iff, Module.Flat.flat_iff_torsion_eq_bot_of_isBezout,
        Submodule.eq_bot_iff]
      intro s hs
      rw [Submodule.mem_torsion_iff] at hs
      obtain ⟨a, ha⟩ := hs
      have ha' : algebraMap R Γ(Z, U) (a : R) * s = 0 := by
        rw [← Algebra.smul_def]; exact ha
      by_cases hU : (U : Set Z).Nonempty
      · haveI : Nonempty U := hU.to_subtype
        have hη : genericPoint Z ∈ U :=
          ((genericPoint_spec Z).mem_open_set_iff U.isOpen).mpr (by simpa using hU)
        have hne : algebraMap R Γ(Z, U) (a : R) ≠ 0 := by
          intro h0
          have hmem : genericPoint Z ∈ Z.basicOpen
              ((f.appLE ⊤ U e).hom ((Scheme.ΓSpecIso (.of R)).inv.hom (a : R))) := by
            rw [Scheme.basicOpen_appLE]
            refine ⟨hη, ?_⟩
            change f (genericPoint Z) ∈ (Spec (.of R)).basicOpen _
            rw [hfgen]
            erw [basicOpen_eq_of_affine]
            rw [genericPoint_eq_bot_of_affine]
            refine (PrimeSpectrum.mem_basicOpen (R := R) (a : R) ⊥).mpr ?_
            rw [PrimeSpectrum.asIdeal_bot, Ideal.mem_bot]
            exact nonZeroDivisors.ne_zero a.2
          have h0' : (f.appLE ⊤ U e).hom ((Scheme.ΓSpecIso (.of R)).inv.hom (a : R)) = 0 := h0
          rw [h0', Scheme.basicOpen_zero] at hmem
          exact hmem
        exact (mul_eq_zero.mp ha').resolve_left hne
      · have hU' : U = ⊥ := by
          ext x
          simp only [TopologicalSpace.Opens.coe_bot, Set.mem_empty_iff_false, iff_false]
          intro hx
          exact hU ⟨x, hx⟩
        have hsub : Subsingleton Γ(Z, U) :=
          CommRingCat.subsingleton_of_isTerminal (Z.sheaf.isTerminalOfEqEmpty hU')
        exact @Subsingleton.elim _ hsub _ _
    rw [HasRingHomProperty.iff_of_iSup_eq_top (P := @Flat) (U := fun U : Z.affineOpens => U)
      (iSup_affineOpens_eq_top Z)]
    intro U
    rw [← RingHom.RespectsIso.cancel_left_isIso RingHom.Flat.respectsIso
      (Scheme.ΓSpecIso (.of R)).inv]
    exact key _ _

  have hlfp : LocallyOfFinitePresentation (z ≫ v) :=
    wcpa_dj_mn_flat_fp (Spec (.of R)) Z (z ≫ v) hflat inferInstance
  exact ⟨Z, z, hzci, hint, hrange, hflat, inferInstance, hlfp⟩

theorem wcpa_dj_p1g_section_extend : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K) (V : Scheme.{u}) (v : V ⟶ Spec (.of ↥R)), IsProper v → ∀ n : ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))), ∃ ρ : Spec (.of ↥R) ⟶ V, ρ ≫ v = 𝟙 _ ∧ ρ (genericPoint ↥(Spec (.of ↥R))) ∈ closure {Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) n} :=
by
  intro K _ _ R V v hv n
  haveI := hv

  have hrat : ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of K)) [LocallyOfFiniteType f] (x : X),
      ∃ x₁ : Spec (.of K) ⟶ X, x₁ ≫ f = 𝟙 _ ∧ x ⤳ x₁ (IsLocalRing.closedPoint K) := by
    intro X f _ x
    haveI : JacobsonSpace X := LocallyOfFiniteType.jacobsonSpace f
    have hZ : IsClosed (closure ({x} : Set X)) := isClosed_closure
    have hxZ : x ∈ closure ({x} : Set X) := subset_closure rfl
    have hc := JacobsonSpace.closure_inter_closedPoints hZ
    have hne : (closure ({x} : Set X) ∩ closedPoints X).Nonempty := by
      rw [← closure_nonempty_iff, hc]; exact ⟨x, hxZ⟩
    obtain ⟨y, hyZ, hyc⟩ := hne
    have hy : IsClosed ({y} : Set X) := mem_closedPoints_iff.mp hyc
    have hxy : x ⤳ y := specializes_iff_mem_closure.mpr hyZ
    haveI : LocallyOfFiniteType (X.fromSpecResidueField y) :=
      isClosed_singleton_iff_locallyOfFiniteType.mp hy
    obtain ⟨g, hg⟩ : ∃ g, g = X.fromSpecResidueField y ≫ f := ⟨_, rfl⟩
    haveI : LocallyOfFiniteType g := by rw [hg]; infer_instance
    let φ : CommRingCat.of K ⟶ X.residueField y := (Spec.fullyFaithful.preimage g).unop
    have hφ : Spec.map φ = g := Spec.map_preimage_unop g
    have hlft : LocallyOfFiniteType (Spec.map φ) := by rw [hφ]; infer_instance
    have hft : φ.hom.FiniteType :=
      (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp hlft
    letI : Algebra K (X.residueField y) := φ.hom.toAlgebra
    haveI : Algebra.FiniteType K (X.residueField y) := hft
    haveI hmf : Module.Finite K (X.residueField y) :=
      finite_of_finite_type_of_isJacobsonRing K (X.residueField y)
    have hfin : φ.hom.Finite := hmf
    have hint : φ.hom.IsIntegral := RingHom.IsIntegral.of_finite hfin
    have hbij : Function.Bijective φ.hom := IsAlgClosed.ringHom_bijective_of_isIntegral φ.hom hint
    let e : K ≃+* X.residueField y := RingEquiv.ofBijective φ.hom hbij
    let ψ : X.residueField y ⟶ CommRingCat.of K := CommRingCat.ofHom e.symm.toRingHom
    refine ⟨Spec.map ψ ≫ X.fromSpecResidueField y, ?_, ?_⟩
    · rw [Category.assoc, ← hg, ← hφ, ← Spec.map_comp]
      have h1 : φ ≫ ψ = 𝟙 _ := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro a
        show e.symm (φ.hom a) = a
        exact e.symm_apply_apply a
      rw [h1, Spec.map_id]
    · have hpt : ∀ z : Spec (X.residueField y), X.fromSpecResidueField y z = y :=
        fun z => Scheme.fromSpecResidueField_apply y z
      convert hxy using 1
      exact hpt _
  have hLFT : LocallyOfFiniteType
      (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFiniteType)
      (IsPullback.of_hasPullback v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))))
      (inferInstance : LocallyOfFiniteType v)
  obtain ⟨x₁, hx₁, hsp⟩ := @hrat _
    (Limits.pullback.snd v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))) hLFT n

  have hsq : CommSq (x₁ ≫ Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))))
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) v (𝟙 _) := ⟨by
    rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, hx₁, Category.id_comp,
      Category.comp_id]⟩
  have hVC : ValuativeCriterion v := by
    have h := hv
    rw [IsProper.eq_valuativeCriterion] at h
    exact h.1.1.1
  let S : ValuativeCommSq v :=
    { R := ↥R, K := K,
      i₁ := x₁ ≫ Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))),
      i₂ := 𝟙 _, commSq := hsq }
  obtain ⟨hU⟩ := hVC S
  obtain ⟨ρ', hfl, hfr⟩ := (default : S.commSq.LiftStruct)
  obtain ⟨ρ, hρ⟩ : ∃ ρ : Spec (.of ↥R) ⟶ V, ρ = ρ' := ⟨ρ', rfl⟩
  have hfl' : Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) ≫ ρ =
      x₁ ≫ Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K))) := by
    rw [hρ]; exact hfl
  have hfr' : ρ ≫ v = 𝟙 _ := by rw [hρ]; exact hfr

  have hgen : Spec.map (CommRingCat.ofHom (algebraMap ↥R K)) (IsLocalRing.closedPoint K) =
      genericPoint ↥(Spec (.of ↥R)) := by
    rw [genericPoint_eq_bot_of_affine]
    apply PrimeSpectrum.ext
    change Ideal.comap (algebraMap ↥R K) (IsLocalRing.closedPoint K).asIdeal = ⊥
    rw [Ideal.eq_bot_of_prime (IsLocalRing.closedPoint K).asIdeal,
      Ideal.comap_bot_of_injective _ (IsFractionRing.injective ↥R K)]

  refine ⟨ρ, hfr', ?_⟩
  have h1 := hsp.map
    (Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))).continuous
  have h2 : Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap ↥R K)))
      (x₁ (IsLocalRing.closedPoint K)) = ρ (genericPoint ↥(Spec (.of ↥R))) := by
    have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
        ∀ x, b (a x) = c x := by
      intro A B C a b c h x
      rw [← Scheme.Hom.comp_apply, h]
    rw [← hgen, pt hfl' (IsLocalRing.closedPoint K)]
    exact pt rfl _
  rw [h2] at h1
  exact specializes_iff_mem_closure.mp h1

theorem wcpa_dj_p1g_cf_ker_minimal : ∀ (V Z : Scheme.{u}) [AlgebraicGeometry.IsIntegral Z] (z : Z ⟶ V), IsClosedImmersion z → (∀ y : V, y ⤳ z (genericPoint ↥Z) → y = z (genericPoint ↥Z)) → ∀ t : Z, RingHom.ker (z.stalkMap t).hom ∈ minimalPrimes (V.presheaf.stalk (z t)) :=
by
  intro V Z _ z _ hmax t
  have hP : (RingHom.ker (z.stalkMap t).hom).IsPrime := RingHom.ker_isPrime _
  let b0 : PrimeSpectrum (Z.presheaf.stalk t) := ⟨⊥, Ideal.isPrime_bot⟩
  have hgen : ∀ y : Z, genericPoint Z ⤳ y := fun y =>
    (genericPoint_spec Z).specializes (Set.mem_univ y)
  have hb0 : Z.fromSpecStalk t b0 = genericPoint Z := by
    have h1 : genericPoint Z ∈ Set.range (Z.fromSpecStalk t) := by
      rw [Scheme.range_fromSpecStalk]; exact hgen t
    obtain ⟨r, hr⟩ := h1
    have h2 : b0 ⤳ r := (PrimeSpectrum.le_iff_specializes b0 r).mp bot_le
    have h3 : Z.fromSpecStalk t b0 ⤳ genericPoint Z := by
      have h := h2.map (Z.fromSpecStalk t).continuous
      rwa [hr] at h
    exact (h3.antisymm (hgen _)).eq
  let p0 : PrimeSpectrum (V.presheaf.stalk (z t)) := Spec.map (z.stalkMap t) b0
  have hp0 : p0.asIdeal = RingHom.ker (z.stalkMap t).hom := by
    show Ideal.comap (z.stalkMap t).hom ⊥ = _
    exact (RingHom.ker_eq_comap_bot _).symm
  have hjp0 : V.fromSpecStalk (z t) p0 = z (genericPoint Z) := by
    have h := congrArg (fun f => f b0) (Scheme.SpecMap_stalkMap_fromSpecStalk z (x := t))
    simp only [Scheme.Hom.comp_apply] at h
    rw [← hb0]
    exact h
  refine ⟨⟨hP, bot_le⟩, fun Q hQ' hQP => ?_⟩
  obtain ⟨hQ, _⟩ := hQ'
  let q0 : PrimeSpectrum (V.presheaf.stalk (z t)) := ⟨Q, hQ⟩
  have h1 : q0 ⤳ p0 := (PrimeSpectrum.le_iff_specializes q0 p0).mp
    (show Q ≤ p0.asIdeal by rw [hp0]; exact hQP)
  have h2 : V.fromSpecStalk (z t) q0 ⤳ z (genericPoint Z) := by
    have h := h1.map (V.fromSpecStalk (z t)).continuous
    rwa [hjp0] at h
  have h3 := hmax _ h2
  have h4 : q0 = p0 := (V.fromSpecStalk (z t)).isEmbedding.injective (h3.trans hjp0.symm)
  have h5 : Q = p0.asIdeal := congrArg PrimeSpectrum.asIdeal h4
  rw [h5, hp0]

theorem wcpa_dj_p1g_cf_reduced_of_local : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (V Z : Scheme.{u}) (v : V ⟶ Spec (.of R)) (z : Z ⟶ V), IsClosedImmersion z → (∀ t : Z, v (z t) = IsLocalRing.closedPoint R → (RingHom.ker (z.stalkMap t).hom ⊔ Ideal.map ((Scheme.ΓSpecIso (.of R)).inv ≫ v.appTop ≫ V.presheaf.germ ⊤ (z t) trivial).hom (IsLocalRing.maximalIdeal R)).IsRadical) → AlgebraicGeometry.IsReduced (Limits.pullback (z ≫ v) (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))) :=
by
  intro R _ _ V Z v z hz H
  haveI := hz
  obtain ⟨_, hstalk⟩ := wcpa_dj_p1g_cf_fibre_stalk R Z (z ≫ v)
  have hred : ∀ w : ↥(Limits.pullback (z ≫ v)
      (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))),
      _root_.IsReduced ((Limits.pullback (z ≫ v)
        (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))).presheaf.stalk w) := by
    intro w
    obtain ⟨hcl, hsurj, hker⟩ := hstalk w
    generalize Limits.pullback.fst (z ≫ v)
      (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) = p at hcl hsurj hker
    have ht : v (z (p w)) = IsLocalRing.closedPoint R := by
      rw [← Scheme.Hom.comp_apply]; exact hcl
    have hH := H (p w) ht
    have hfac : ((Scheme.ΓSpecIso (.of R)).inv ≫ (z ≫ v).appTop ≫ Z.presheaf.germ ⊤ (p w) trivial).hom
        = (z.stalkMap (p w)).hom.comp
          ((Scheme.ΓSpecIso (.of R)).inv ≫ v.appTop ≫ V.presheaf.germ ⊤ (z (p w)) trivial).hom := by
      ext r
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, Scheme.Hom.comp_appTop]
      exact (Scheme.Hom.germ_stalkMap_apply z ⊤ (p w) trivial _).symm
    have hssurj : Function.Surjective (z.stalkMap (p w)).hom :=
      SurjectiveOnStalks.stalkMap_surjective z (p w)
    have hrad : (Ideal.map (z.stalkMap (p w)).hom (Ideal.map
        ((Scheme.ΓSpecIso (.of R)).inv ≫ v.appTop ≫ V.presheaf.germ ⊤ (z (p w)) trivial).hom
        (IsLocalRing.maximalIdeal R))).IsRadical := by
      intro b hb
      obtain ⟨n, hn⟩ := hb
      obtain ⟨a, rfl⟩ := hssurj b
      have h1 : a ^ n ∈ Ideal.comap (z.stalkMap (p w)).hom (Ideal.map (z.stalkMap (p w)).hom
          (Ideal.map ((Scheme.ΓSpecIso (.of R)).inv ≫ v.appTop ≫
            V.presheaf.germ ⊤ (z (p w)) trivial).hom (IsLocalRing.maximalIdeal R))) := by
        rw [Ideal.mem_comap, map_pow]; exact hn
      rw [Ideal.comap_map_of_surjective' _ hssurj, sup_comm] at h1
      have h2 := hH ⟨n, h1⟩
      rw [sup_comm, ← Ideal.comap_map_of_surjective' _ hssurj] at h2
      exact h2
    rw [hfac, ← Ideal.map_map] at hker
    rw [← hker] at hrad
    refine ⟨fun x hx => ?_⟩
    obtain ⟨n, hn⟩ := hx
    obtain ⟨y, rfl⟩ := hsurj x
    have hyn : y ^ n ∈ RingHom.ker (Scheme.Hom.stalkMap p w).hom := by
      rw [RingHom.mem_ker, map_pow]; exact hn
    have hy := hrad ⟨n, hyn⟩
    rw [RingHom.mem_ker] at hy
    exact hy
  haveI := hred
  exact isReduced_of_isReduced_stalk _

theorem wcpa_dj_p1g_cf_component_of_minprime : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (V Z : Scheme.{u}) (v : V ⟶ Spec (.of R)) (z : Z ⟶ V) (t : Z), IsClosedImmersion z → v (z t) = IsLocalRing.closedPoint R → ∀ P : Ideal (V.presheaf.stalk (z t)), P ∈ (Ideal.map ((Scheme.ΓSpecIso (.of R)).inv ≫ v.appTop ≫ V.presheaf.germ ⊤ (z t) trivial).hom (IsLocalRing.maximalIdeal R)).minimalPrimes → RingHom.ker (z.stalkMap t).hom ≤ P → ∃ x : ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))), closure {x} ∈ irreducibleComponents ↥(Limits.pullback v (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))))) ∧ Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) x ∈ Set.range z ∧ Limits.pullback.fst v (Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R)))) x ⤳ z t :=
by
  intro R _ _ V Z v z t hz _ht P hP hker
  haveI := hz
  have pt : ∀ {X Y W : Scheme.{u}} {a : X ⟶ Y} {b : Y ⟶ W} {c : X ⟶ W}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro X Y W a b c h x
    rw [← Scheme.Hom.comp_apply, h]
  set κ := IsLocalRing.ResidueField R with hκ
  set c : Spec (.of κ) ⟶ Spec (.of R) := Spec.map (CommRingCat.ofHom (algebraMap R κ)) with hcdef
  have hsurj : Function.Surjective (CommRingCat.ofHom (algebraMap R κ)).hom := by
    rw [CommRingCat.hom_ofHom, IsLocalRing.ResidueField.algebraMap_eq]
    exact IsLocalRing.residue_surjective
  haveI : IsClosedImmersion c := IsClosedImmersion.spec_of_surjective _ hsurj
  have hfinj : Function.Injective (Limits.pullback.fst v c) :=
    (Limits.pullback.fst v c).isEmbedding.injective
  have hFemb : Topology.IsEmbedding (V.fromSpecStalk (z t)) :=
    IsPreimmersion.isEmbedding (V.fromSpecStalk (z t))
  have hFrange : Set.range (V.fromSpecStalk (z t)) = {ξ | ξ ⤳ z t} := Scheme.range_fromSpecStalk
  have hσsurj : Function.Surjective (z.stalkMap t).hom := z.stalkMap_surjective t
  have hFv : V.fromSpecStalk (z t) ≫ v = Spec.map ((Scheme.ΓSpecIso (.of R)).inv ≫ v.appTop ≫
      V.presheaf.germ ⊤ (z t) trivial) := by
    apply ext_of_isAffine
    rw [← cancel_mono (Scheme.ΓSpecIso _).hom, Scheme.ΓSpecIso_naturality, Scheme.Hom.comp_appTop,
      Scheme.fromSpecStalk_appTop]
    simp
  set J := Ideal.map ((Scheme.ΓSpecIso (.of R)).inv ≫ v.appTop ≫
      V.presheaf.germ ⊤ (z t) trivial).hom (IsLocalRing.maximalIdeal R) with hJ
  have hvF : ∀ p : PrimeSpectrum (V.presheaf.stalk (z t)), (v (V.fromSpecStalk (z t) p)).asIdeal =
      Ideal.comap ((Scheme.ΓSpecIso (.of R)).inv ≫ v.appTop ≫
        V.presheaf.germ ⊤ (z t) trivial).hom p.asIdeal := by
    intro p
    rw [pt hFv p]
    rfl
  have hfibF : ∀ p : PrimeSpectrum (V.presheaf.stalk (z t)),
      v (V.fromSpecStalk (z t) p) = IsLocalRing.closedPoint R ↔ J ≤ p.asIdeal := by
    intro p
    constructor
    · intro h
      have h2 := congrArg PrimeSpectrum.asIdeal h
      rw [hvF] at h2
      rw [hJ, Ideal.map_le_iff_le_comap, h2]
      rfl
    · intro h
      rw [hJ, Ideal.map_le_iff_le_comap] at h
      apply PrimeSpectrum.ext
      rw [hvF]
      have hne : Ideal.comap ((Scheme.ΓSpecIso (.of R)).inv ≫ v.appTop ≫
          V.presheaf.germ ⊤ (z t) trivial).hom p.asIdeal ≠ ⊤ := Ideal.IsPrime.ne_top inferInstance
      exact ((IsLocalRing.maximalIdeal.isMaximal R).eq_of_le hne h).symm
  have hPprime : P.IsPrime := hP.1.1
  have hJP : J ≤ P := hP.1.2
  let pP : PrimeSpectrum (V.presheaf.stalk (z t)) := ⟨P, hPprime⟩
  have hy'y : V.fromSpecStalk (z t) pP ⤳ z t := by
    have : V.fromSpecStalk (z t) pP ∈ Set.range (V.fromSpecStalk (z t)) := ⟨pP, rfl⟩
    rw [hFrange] at this
    exact this
  have hvy' : v (V.fromSpecStalk (z t) pP) = IsLocalRing.closedPoint R := (hfibF pP).2 hJP
  have hrange : V.fromSpecStalk (z t) pP ∈ Set.range z := by
    have hPbar : (Ideal.map (z.stalkMap t).hom P).IsPrime :=
      Ideal.map_isPrime_of_surjective hσsurj hker
    have hcomap : Ideal.comap (z.stalkMap t).hom (Ideal.map (z.stalkMap t).hom P) = P := by
      rw [Ideal.comap_map_of_surjective' _ hσsurj P]
      exact sup_eq_left.mpr hker
    let qZ : PrimeSpectrum (Z.presheaf.stalk t) := ⟨_, hPbar⟩
    have hq : Spec.map (z.stalkMap t) qZ = pP := by
      apply PrimeSpectrum.ext
      exact hcomap
    have e := pt (Scheme.SpecMap_stalkMap_fromSpecStalk z) qZ
    rw [hq] at e
    exact ⟨Z.fromSpecStalk t qZ, (pt (a := Z.fromSpecStalk t) (b := z) rfl qZ).trans e.symm⟩
  have hc : c (IsLocalRing.closedPoint κ) = IsLocalRing.closedPoint R := by
    apply PrimeSpectrum.ext
    show Ideal.comap (algebraMap R κ) (IsLocalRing.maximalIdeal κ) = IsLocalRing.maximalIdeal R
    ext r
    rw [Ideal.mem_comap, IsLocalRing.ResidueField.algebraMap_eq, IsLocalRing.mem_maximalIdeal,
      mem_nonunits_iff, isUnit_iff_ne_zero, not_not, IsLocalRing.residue_eq_zero_iff]
  obtain ⟨x, hx1, _⟩ := Scheme.Pullback.exists_preimage_pullback (f := v) (g := c)
    (V.fromSpecStalk (z t) pP) (IsLocalRing.closedPoint κ) (hvy'.trans hc.symm)
  haveI : Subsingleton (Spec (.of κ)) := inferInstanceAs (Subsingleton (PrimeSpectrum κ))
  have hfib : ∀ w, v (Limits.pullback.fst v c w) = IsLocalRing.closedPoint R := by
    intro w
    rw [pt Limits.pullback.condition w, Scheme.Hom.comp_apply,
      Subsingleton.elim (Limits.pullback.snd v c w) (IsLocalRing.closedPoint κ), hc]
  have hxmax : ∀ x', x' ⤳ x → x' = x := by
    intro x' hx'
    have h1 : Limits.pullback.fst v c x' ⤳ V.fromSpecStalk (z t) pP := by
      rw [← hx1]; exact hx'.map (Limits.pullback.fst v c).continuous
    have h2 : Limits.pullback.fst v c x' ∈ Set.range (V.fromSpecStalk (z t)) := by
      rw [hFrange]; exact h1.trans hy'y
    obtain ⟨p', hp'⟩ := h2
    rw [← hp'] at h1
    have h3 : p' ⤳ pP := hFemb.isInducing.specializes_iff.mp h1
    have h4 : p'.asIdeal ≤ P := (PrimeSpectrum.le_iff_specializes p' pP).mpr h3
    have h5 : J ≤ p'.asIdeal := (hfibF p').1 (by rw [hp']; exact hfib x')
    have h6 : P ≤ p'.asIdeal := hP.2 ⟨p'.isPrime, h5⟩ h4
    have h7 : p' = pP := PrimeSpectrum.ext (le_antisymm h4 h6)
    apply hfinj
    rw [hx1, ← hp', h7]
  have hcomp : closure ({x} : Set ↥(Limits.pullback v c)) ∈
      irreducibleComponents ↥(Limits.pullback v c) := by
    refine ⟨isIrreducible_singleton.closure, fun T hT hxT => ?_⟩
    have hg := hT.isGenericPoint_genericPoint_closure
    have hxg : x ∈ closure {hT.genericPoint} := by
      rw [hg.def]
      exact subset_closure (hxT (subset_closure (Set.mem_singleton x)))
    have hgx := hxmax _ (specializes_iff_mem_closure.mpr hxg)
    calc T ⊆ closure T := subset_closure
      _ = closure {hT.genericPoint} := hg.def.symm
      _ = closure {x} := by rw [hgx]
  refine ⟨x, hcomp, ?_, ?_⟩
  · rw [hx1]; exact hrange
  · rw [hx1]; exact hy'y

theorem wcpa_dj_p1g_cf_branch_algebra : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B] (ψ : A →+* B) (J : Ideal A) (x₀ x₁ : B), ψ.Flat → IsLocalHom ψ → x₀ * x₁ = 0 → (Ideal.span {x₀}).IsPrime → (Ideal.span {x₁}).IsPrime → (Ideal.span {x₀} ⊔ Ideal.map ψ J).IsPrime → x₁ ∉ Ideal.span {x₀} ⊔ Ideal.map ψ J → (Ideal.span {x₁} ⊔ Ideal.map ψ J).IsPrime → x₀ ∉ Ideal.span {x₁} ⊔ Ideal.map ψ J → ∀ I ∈ minimalPrimes A, I = ⊥ ∨ ((I ⊔ J).IsPrime ∧ I ⊔ J ∈ J.minimalPrimes) :=
by
  intro A B _ _ _ _ ψ J x₀ x₁ hflat hloc h01 hp0 hp1 hq0 hn0 hq1 hn1 I hI
  letI : Algebra A B := ψ.toAlgebra
  haveI : Module.Flat A B := hflat
  haveI : IsLocalHom (algebraMap A B) := hloc
  haveI : Module.FaithfullyFlat A B := Module.FaithfullyFlat.of_flat_of_isLocalHom
  haveI : Algebra.HasGoingDown A B := Algebra.HasGoingDown.of_flat
  have hinj : Function.Injective ψ := FaithfulSMul.algebraMap_injective A B
  have hcm : ∀ 𝔞 : Ideal A, Ideal.comap ψ (Ideal.map ψ 𝔞) = 𝔞 := fun 𝔞 =>
    Ideal.comap_map_eq_self_of_faithfullyFlat 𝔞
  have hlift : ∀ P : Ideal A, P.IsPrime → ∃ Q : Ideal B, Q.IsPrime ∧ Ideal.comap ψ Q = P := by
    intro P hP
    obtain ⟨q, hq⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := A) (B := B) ⟨P, hP⟩
    exact ⟨q.asIdeal, q.isPrime, congrArg PrimeSpectrum.asIdeal hq⟩
  have hImin : Minimal (fun q : Ideal A => q.IsPrime ∧ ⊥ ≤ q) I := hI
  have hIp : I.IsPrime := hImin.prop.1
  by_cases hbot : I = ⊥
  · exact Or.inl hbot
  right

  have s3 : ∀ y₀ y₁ : B, y₀ * y₁ = 0 → (Ideal.span {y₀} ⊔ Ideal.map ψ J).IsPrime →
      y₁ ∉ Ideal.span {y₀} ⊔ Ideal.map ψ J →
      Ideal.comap ψ (Ideal.span {y₀} ⊔ Ideal.map ψ J) ∈ J.minimalPrimes := by
    intro y₀ y₁ hy hQ hn
    haveI := hQ
    show Minimal (fun q : Ideal A => q.IsPrime ∧ J ≤ q)
      (Ideal.comap ψ (Ideal.span {y₀} ⊔ Ideal.map ψ J))
    refine ⟨⟨Ideal.IsPrime.comap ψ, Ideal.le_comap_map.trans (Ideal.comap_mono le_sup_right)⟩, ?_⟩
    rintro P' ⟨hP', hJP'⟩ hle
    haveI := hP'
    haveI : (Ideal.comap ψ (Ideal.span {y₀} ⊔ Ideal.map ψ J)).IsPrime := Ideal.IsPrime.comap ψ
    haveI : (Ideal.span {y₀} ⊔ Ideal.map ψ J).LiesOver
        (Ideal.comap ψ (Ideal.span {y₀} ⊔ Ideal.map ψ J)) := ⟨rfl⟩
    obtain ⟨Q', hQ'Q, hQ'p, hQ'l⟩ :=
      Ideal.exists_ideal_le_liesOver_of_le (Ideal.span {y₀} ⊔ Ideal.map ψ J) hle
    have hP'eq : P' = Ideal.comap ψ Q' := Ideal.over_def Q' P'
    have hJQ' : Ideal.map ψ J ≤ Q' := by
      rw [Ideal.map_le_iff_le_comap, ← hP'eq]; exact hJP'
    have hy0 : y₀ ∈ Q' := by
      rcases hQ'p.mem_or_mem_of_mul_eq_zero hy with h | h
      · exact h
      · exact absurd (hQ'Q h) hn
    have hQQ' : Ideal.span {y₀} ⊔ Ideal.map ψ J ≤ Q' :=
      sup_le ((Ideal.span_singleton_le_iff_mem _).mpr hy0) hJQ'
    rw [hP'eq]
    exact Ideal.comap_mono hQQ'

  have key : ∀ y₀ y₁ : B, y₀ * y₁ = 0 → (Ideal.span {y₀}).IsPrime → (Ideal.span {y₁}).IsPrime →
      (Ideal.span {y₀} ⊔ Ideal.map ψ J).IsPrime → y₁ ∉ Ideal.span {y₀} ⊔ Ideal.map ψ J →
      Ideal.comap ψ (Ideal.span {y₀}) = I → (I ⊔ J).IsPrime ∧ I ⊔ J ∈ J.minimalPrimes := by
    intro y₀ y₁ hy hp hp' hQ hn hI0
    have hn' : y₁ ∉ Ideal.span {y₀} := fun h => hn (Ideal.mem_sup_left h)

    have hinter : ∀ b, b ∈ Ideal.span {y₀} → b ∈ Ideal.span {y₁} → b = 0 := by
      intro b hb0 hb1
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hb1
      rcases hp.mem_or_mem hb0 with h | h
      · obtain ⟨e, rfl⟩ := Ideal.mem_span_singleton'.mp h
        calc e * y₀ * y₁ = e * (y₀ * y₁) := by ring
          _ = 0 := by rw [hy, mul_zero]
      · exact absurd h hn'

    have hnotle : ¬ Ideal.comap ψ (Ideal.span {y₁}) ≤ I := by
      intro hle
      haveI := hp'
      have hge := hImin.2 ⟨Ideal.IsPrime.comap ψ, bot_le⟩ hle
      apply hbot
      rw [eq_bot_iff]
      intro r hr
      rw [Ideal.mem_bot]
      apply hinj
      rw [map_zero]
      apply hinter
      · rw [← hI0] at hr; exact Ideal.mem_comap.mp hr
      · exact Ideal.mem_comap.mp (hge hr)

    obtain ⟨a, ha1, haI⟩ := SetLike.not_le_iff_exists.mp hnotle
    have ha0 : ψ a * y₀ = 0 := by
      obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp (Ideal.mem_comap.mp ha1)
      rw [← hd, mul_assoc, mul_comm y₁ y₀, hy, mul_zero]
    have hann : ∀ c : A, a * c = 0 → c ∈ I := by
      intro c hc
      rcases hIp.mem_or_mem (show a * c ∈ I by rw [hc]; exact I.zero_mem) with h | h
      · exact absurd h haI
      · exact h

    have hy0I : y₀ ∈ Ideal.map ψ I := by
      let f : Fin 1 → A := fun _ => a
      let x : Fin 1 → B := fun _ => y₀
      have hsum : ∑ i : Fin 1, f i • x i = 0 := by
        rw [Fin.sum_univ_one]
        show ψ a * y₀ = 0
        exact ha0
      have htr : Module.IsTrivialRelation f x :=
        Module.Flat.isTrivialRelation_of_sum_smul_eq_zero (R := A) (M := B) hsum
      obtain ⟨k, a', z, hx, hrel⟩ := htr
      have e : y₀ = ∑ j, a' 0 j • z j := hx 0
      rw [e]
      refine Ideal.sum_mem _ (fun j _ => ?_)
      show ψ (a' 0 j) * z j ∈ Ideal.map ψ I
      refine Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem ψ (hann _ ?_))
      have h : ∑ i : Fin 1, f i * a' i j = 0 := hrel j
      rw [Fin.sum_univ_one] at h
      exact h
    have hmapI : Ideal.map ψ I = Ideal.span {y₀} := by
      apply le_antisymm
      · rw [← hI0]; exact Ideal.map_comap_le
      · exact (Ideal.span_singleton_le_iff_mem _).mpr hy0I
    have hIJ : I ⊔ J = Ideal.comap ψ (Ideal.span {y₀} ⊔ Ideal.map ψ J) := by
      have h := hcm (I ⊔ J)
      rw [Ideal.map_sup, hmapI] at h
      exact h.symm
    rw [hIJ]
    haveI := hQ
    exact ⟨Ideal.IsPrime.comap ψ, s3 y₀ y₁ hy hQ hn⟩

  obtain ⟨Q, hQp, hQI⟩ := hlift I hIp
  have hmem : x₀ * x₁ ∈ Q := by rw [h01]; exact Q.zero_mem
  rcases hQp.mem_or_mem hmem with h | h
  · have hle : Ideal.comap ψ (Ideal.span {x₀}) ≤ I := by
      rw [← hQI]; exact Ideal.comap_mono ((Ideal.span_singleton_le_iff_mem _).mpr h)
    haveI := hp0
    have heq : Ideal.comap ψ (Ideal.span {x₀}) = I :=
      le_antisymm hle (hImin.2 ⟨Ideal.IsPrime.comap ψ, bot_le⟩ hle)
    exact key x₀ x₁ h01 hp0 hp1 hq0 hn0 heq
  · have hle : Ideal.comap ψ (Ideal.span {x₁}) ≤ I := by
      rw [← hQI]; exact Ideal.comap_mono ((Ideal.span_singleton_le_iff_mem _).mpr h)
    haveI := hp1
    have heq : Ideal.comap ψ (Ideal.span {x₁}) = I :=
      le_antisymm hle (hImin.2 ⟨Ideal.IsPrime.comap ψ, bot_le⟩ hle)
    exact key x₁ x₀ (by rw [mul_comm]; exact h01) hp1 hp0 hq1 hn1 heq

theorem wcpa_dj_p1g_cfl_node_fibre_quot : ∀ (K : Type u) [Field K] (R : ValuationSubring K) (a : ↥R), a = 0 → (∃ π : wcNcRing R a →+* Polynomial (IsLocalRing.ResidueField ↥R), Function.Surjective π ∧ RingHom.ker π = Ideal.span {Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 0)} ⊔ Ideal.map (algebraMap ↥R (wcNcRing R a)) (IsLocalRing.maximalIdeal ↥R) ∧ π (Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 1)) = Polynomial.X) ∧ (∃ π : wcNcRing R a →+* Polynomial (IsLocalRing.ResidueField ↥R), Function.Surjective π ∧ RingHom.ker π = Ideal.span {Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 1)} ⊔ Ideal.map (algebraMap ↥R (wcNcRing R a)) (IsLocalRing.maximalIdeal ↥R) ∧ π (Ideal.Quotient.mk (wcNcIdeal R a) (MvPolynomial.X 0)) = Polynomial.X) :=
by
  intro K _ R a ha
  subst ha
  classical
  have hcov : ∀ n : Fin 2, n = 0 ∨ n = 1 := by decide

  have s1 : ∀ (π : wcNcRing R 0 →+* Polynomial ↥R), Function.Surjective π →
      π.comp (algebraMap ↥R (wcNcRing R 0)) = Polynomial.C →
      Function.Surjective ((Polynomial.mapRingHom (IsLocalRing.residue ↥R)).comp π) ∧
      RingHom.ker ((Polynomial.mapRingHom (IsLocalRing.residue ↥R)).comp π) =
        RingHom.ker π ⊔
          Ideal.map (algebraMap ↥R (wcNcRing R 0)) (IsLocalRing.maximalIdeal ↥R) := by
    intro π hπ hC
    refine ⟨?_, ?_⟩
    · exact (Polynomial.map_surjective _ IsLocalRing.residue_surjective).comp hπ
    · rw [← RingHom.comap_ker, Polynomial.ker_mapRingHom, IsLocalRing.ker_residue, ← hC,
        ← Ideal.map_map, Ideal.comap_map_of_surjective' π hπ, sup_comm]

  have hkill : ∀ (Φ : MvPolynomial (Fin 2) ↥R →+* Polynomial ↥R),
      Φ (MvPolynomial.X 0) * Φ (MvPolynomial.X 1) = 0 → ∀ x ∈ wcNcIdeal R 0, Φ x = 0 := by
    intro Φ hΦ x hx
    have hle : wcNcIdeal R 0 ≤ RingHom.ker Φ := by
      unfold wcNcIdeal
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker]
      simp [hΦ]
    exact hle hx

  have partAB : ∀ (i j : Fin 2), (∀ n : Fin 2, n = i ∨ n = j) →
      ∀ Φ : MvPolynomial (Fin 2) ↥R →+* Polynomial ↥R,
      (∀ r, Φ (MvPolynomial.C r) = Polynomial.C r) → Φ (MvPolynomial.X i) = 0 →
      Φ (MvPolynomial.X j) = Polynomial.X → ∀ hΦ : ∀ x ∈ wcNcIdeal R 0, Φ x = 0,
      Function.Surjective (Ideal.Quotient.lift (wcNcIdeal R 0) Φ hΦ) ∧
        RingHom.ker (Ideal.Quotient.lift (wcNcIdeal R 0) Φ hΦ) =
          Ideal.span {Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X i)} := by
    intro i j hij Φ hC hi hj hΦ
    obtain ⟨σ, hσC, hσX⟩ : ∃ σ : Polynomial ↥R →+* wcNcRing R 0,
        (∀ r, σ (Polynomial.C r) = Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.C r)) ∧
        σ Polynomial.X = Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X j) :=
      ⟨(Ideal.Quotient.mk (wcNcIdeal R 0)).comp
        (Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X j)), fun r => by simp, by simp⟩
    have h1 : ∀ s, Ideal.Quotient.lift (wcNcIdeal R 0) Φ hΦ (σ s) = s := by
      intro s
      have h : (Ideal.Quotient.lift (wcNcIdeal R 0) Φ hΦ).comp σ = RingHom.id _ := by
        apply Polynomial.ringHom_ext
        · intro r
          rw [RingHom.comp_apply, hσC, Ideal.Quotient.lift_mk, hC, RingHom.id_apply]
        · rw [RingHom.comp_apply, hσX, Ideal.Quotient.lift_mk, hj, RingHom.id_apply]
      exact RingHom.congr_fun h s
    have h2 : Ideal.span {Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X i)} ≤
        RingHom.ker (Ideal.Quotient.lift (wcNcIdeal R 0) Φ hΦ) := by
      rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
        Ideal.Quotient.lift_mk, hi]
    have h3 : ∀ p, Ideal.Quotient.mk (wcNcIdeal R 0) p - σ (Φ p) ∈
        Ideal.span {Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X i)} := by
      intro p
      induction p using MvPolynomial.induction_on
      next r =>
        rw [hC, hσC, sub_self]
        exact Ideal.zero_mem _
      next p q hp hq =>
        simp only [map_add]
        rw [add_sub_add_comm]
        exact Ideal.add_mem _ hp hq
      next p n hp =>
        simp only [map_mul]
        rcases hij n with h | h
        · rw [h, hi, map_zero, mul_zero, sub_zero]
          exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
        · rw [h, hj, hσX, ← sub_mul]
          first
            | simpa only [mul_comm] using
                Ideal.mul_mem_left _ (Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X j)) hp
            | exact (mul_comm (Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X j)) _) ▸
                Ideal.mul_mem_left _ _ hp
            | (obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hp
               exact Ideal.mem_span_singleton'.mpr
                 ⟨c * Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.X j), by rw [← hc]; ring⟩)
    refine ⟨fun s => ⟨σ s, h1 s⟩, le_antisymm ?_ h2⟩
    intro z hz
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
    rw [RingHom.mem_ker, Ideal.Quotient.lift_mk] at hz
    have h := h3 p
    rwa [hz, map_zero, sub_zero] at h
  have halg : ∀ r : ↥R, algebraMap ↥R (wcNcRing R 0) r =
      Ideal.Quotient.mk (wcNcIdeal R 0) (MvPolynomial.C r) := by
    intro r
    first
      | rfl
      | (rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap])
      | (show algebraMap ↥R (MvPolynomial (Fin 2) ↥R ⧸ wcNcIdeal R 0) r = _
         rw [Ideal.Quotient.algebraMap_eq, RingHom.comp_apply, MvPolynomial.algebraMap_eq])
  obtain ⟨Φ0, hΦ0C, hΦ0a, hΦ0b⟩ : ∃ Φ : MvPolynomial (Fin 2) ↥R →+* Polynomial ↥R,
      (∀ r, Φ (MvPolynomial.C r) = Polynomial.C r) ∧ Φ (MvPolynomial.X 0) = 0 ∧
        Φ (MvPolynomial.X 1) = Polynomial.X :=
    ⟨MvPolynomial.eval₂Hom Polynomial.C ![0, Polynomial.X], fun r => by simp, by simp, by simp⟩
  obtain ⟨Φ1, hΦ1C, hΦ1a, hΦ1b⟩ : ∃ Φ : MvPolynomial (Fin 2) ↥R →+* Polynomial ↥R,
      (∀ r, Φ (MvPolynomial.C r) = Polynomial.C r) ∧ Φ (MvPolynomial.X 0) = Polynomial.X ∧
        Φ (MvPolynomial.X 1) = 0 :=
    ⟨MvPolynomial.eval₂Hom Polynomial.C ![Polynomial.X, 0], fun r => by simp, by simp, by simp⟩
  have k0 := hkill Φ0 (by rw [hΦ0a, zero_mul])
  have k1 := hkill Φ1 (by rw [hΦ1b, mul_zero])
  obtain ⟨hs0, hk0⟩ := partAB 0 1 hcov Φ0 hΦ0C hΦ0a hΦ0b k0
  obtain ⟨hs1, hk1⟩ := partAB 1 0 (fun n => (hcov n).symm) Φ1 hΦ1C hΦ1b hΦ1a k1
  have hC0 : (Ideal.Quotient.lift (wcNcIdeal R 0) Φ0 k0).comp
      (algebraMap ↥R (wcNcRing R 0)) = Polynomial.C := by
    apply RingHom.ext
    intro r
    rw [RingHom.comp_apply, halg, Ideal.Quotient.lift_mk, hΦ0C]
  have hC1 : (Ideal.Quotient.lift (wcNcIdeal R 0) Φ1 k1).comp
      (algebraMap ↥R (wcNcRing R 0)) = Polynomial.C := by
    apply RingHom.ext
    intro r
    rw [RingHom.comp_apply, halg, Ideal.Quotient.lift_mk, hΦ1C]
  obtain ⟨hs0', hk0'⟩ := s1 _ hs0 hC0
  obtain ⟨hs1', hk1'⟩ := s1 _ hs1 hC1
  refine ⟨⟨_, hs0', by rw [hk0', hk0], ?_⟩, ⟨_, hs1', by rw [hk1', hk1], ?_⟩⟩
  · rw [RingHom.comp_apply, Polynomial.coe_mapRingHom, Ideal.Quotient.lift_mk, hΦ0b,
      Polynomial.map_X]
  · rw [RingHom.comp_apply, Polynomial.coe_mapRingHom, Ideal.Quotient.lift_mk, hΦ1a,
      Polynomial.map_X]

theorem wcpa_dj_p1g_cfl_etale_loc_quot_prime_ker : ∀ (N T : Type u) [CommRing N] [CommRing T] [Algebra N T] [Algebra.Etale N T] (q : Ideal T) [q.IsPrime] (D : Type u) [CommRing D] [IsDomain D] [IsIntegrallyClosed D] (π : N →+* D), Function.Surjective π → (∀ n : N, π n = 0 → algebraMap N T n ∈ q) → (Ideal.map ((algebraMap T (Localization.AtPrime q)).comp (algebraMap N T)) (RingHom.ker π)).IsPrime ∧ ∀ n : N, π n ≠ 0 → algebraMap T (Localization.AtPrime q) (algebraMap N T n) ∉ Ideal.map ((algebraMap T (Localization.AtPrime q)).comp (algebraMap N T)) (RingHom.ker π) :=
by
  have wc_ring_etale_localization_isDomain : ∀ (R T : Type u) [CommRing R] [IsDomain R]
      [IsIntegrallyClosed R] [CommRing T] [Algebra R T] [Algebra.Etale R T] (q : Ideal T)
      [q.IsPrime], IsDomain (Localization.AtPrime q) := by
    intro R T _ _ _ _ _ _ q _
    classical
    have s2 : ∀ (K A : Type u) [Field K] [CommRing A] [Algebra K A] [Algebra.Etale K A] (a b : A),
        a * b = 0 → ∃ ε : A, IsIdempotentElem ε ∧ ε * b = 0 ∧ (1 - ε) * a = 0 := by
      intro K A _ _ _ _ a b hab
      obtain ⟨I, _, Ai, hF, hA, e, -⟩ :=
        (Algebra.Etale.iff_exists_algEquiv_prod K A).mp inferInstance
      have hab' : ∀ i, e a i * e b i = 0 := by
        intro i
        have h := congrFun (congrArg e hab) i
        rw [map_mul, map_zero] at h
        exact h
      let ε' : (i : I) → Ai i := fun i => if e a i = 0 then 0 else 1
      have hε' : IsIdempotentElem ε' := by
        show ε' * ε' = ε'
        funext i
        simp only [Pi.mul_apply, ε']
        split_ifs <;> simp
      refine ⟨e.symm ε', hε'.map e.symm, ?_, ?_⟩
      · apply e.injective
        rw [map_mul, AlgEquiv.apply_symm_apply, map_zero]
        funext i
        simp only [Pi.mul_apply, Pi.zero_apply, ε']
        split_ifs with h
        · simp
        · rw [one_mul]
          exact (mul_eq_zero.mp (hab' i)).resolve_left h
      · apply e.injective
        rw [map_mul, map_sub, map_one, AlgEquiv.apply_symm_apply, map_zero]
        funext i
        simp only [Pi.mul_apply, Pi.sub_apply, Pi.one_apply, Pi.zero_apply, ε']
        split_ifs with h
        · rw [h, mul_zero]
        · simp
    let K := FractionRing R
    let S := TensorProduct R T K
    let j : T →ₐ[R] S := Algebra.TensorProduct.includeLeft
    have hj : ∀ t : T, j t = TensorProduct.tmul R t (1 : K) := fun t => rfl
    have hjinj : Function.Injective j :=
      Algebra.TensorProduct.includeLeft_injective (R := R) (S := R) (A := T) (B := K)
        (IsFractionRing.injective R K)
    have hsep : ∀ a b : S, a * b = 0 →
        ∃ ε : S, IsIdempotentElem ε ∧ ε * b = 0 ∧ (1 - ε) * a = 0 := by
      intro a b hab
      let c : S ≃ₐ[R] TensorProduct R K T := Algebra.TensorProduct.comm R T K
      obtain ⟨ε', hε', h1, h2⟩ := s2 K (TensorProduct R K T) (c a) (c b)
        (by rw [← map_mul, hab, map_zero])
      refine ⟨c.symm ε', hε'.map c.symm, ?_, ?_⟩
      · apply c.injective
        rw [map_mul, AlgEquiv.apply_symm_apply, map_zero]
        exact h1
      · apply c.injective
        rw [map_mul, map_sub, map_one, AlgEquiv.apply_symm_apply, map_zero]
        exact h2
    have hlift : ∀ ε : S, IsIdempotentElem ε → ∃ e : T, j e = ε := by
      intro ε hε
      have hint : IsIntegral T ε := by
        refine ⟨Polynomial.X ^ 2 - Polynomial.X,
          Polynomial.monic_X_pow_sub (Polynomial.degree_X_le.trans_lt (by norm_num)), ?_⟩
        rw [Polynomial.eval₂_sub, Polynomial.eval₂_X_pow, Polynomial.eval₂_X, pow_two, hε.eq,
          sub_self]
      obtain ⟨w, hw⟩ := (TensorProduct.toIntegralClosure_bijective_of_smooth (R := R) (S := T)
        (B := K)).2 ⟨ε, (mem_integralClosure_iff T S).mpr hint⟩
      have hw' := congrArg Subtype.val hw
      simp only at hw'
      have key : ∀ w' : TensorProduct R T (integralClosure R K),
          ∃ t : T, ((TensorProduct.toIntegralClosure R T K w' : integralClosure T S) : S) = j t := by
        intro w'
        induction w' using TensorProduct.induction_on with
        | zero => exact ⟨0, by rw [map_zero, map_zero]; rfl⟩
        | tmul t c =>
          have hc : (c : K) ∈ (⊥ : Subalgebra R K) := by
            rw [← IsIntegrallyClosed.integralClosure_eq_bot R K]; exact c.2
          obtain ⟨r, hr⟩ := Algebra.mem_bot.mp hc
          refine ⟨r • t, ?_⟩
          rw [hj]
          change TensorProduct.tmul R t (c : K) = _
          rw [TensorProduct.smul_tmul, ← hr, Algebra.algebraMap_eq_smul_one]
        | add x y hx hy =>
          obtain ⟨t₁, h₁⟩ := hx
          obtain ⟨t₂, h₂⟩ := hy
          exact ⟨t₁ + t₂, by rw [map_add, Subalgebra.coe_add, h₁, h₂, map_add]⟩
      obtain ⟨t, ht⟩ := key w
      exact ⟨t, ht.symm.trans hw'⟩
    have hnzd : NoZeroDivisors (Localization.AtPrime q) := by
      refine ⟨fun {x y} hxy => ?_⟩
      obtain ⟨⟨s, u⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl x
      obtain ⟨⟨s', u'⟩, rfl⟩ := IsLocalization.mk'_surjective q.primeCompl y
      dsimp only at hxy ⊢
      rw [← IsLocalization.mk'_mul] at hxy
      obtain ⟨m, hm⟩ := (IsLocalization.mk'_eq_zero_iff _ _).mp hxy
      obtain ⟨ε, hε, h1, h2⟩ := hsep (j ((m : T) * s)) (j s')
        (by rw [← map_mul, mul_assoc, hm, map_zero])
      obtain ⟨e, rfl⟩ := hlift ε hε
      have he1 : e * s' = 0 := hjinj (by rw [map_mul, h1, map_zero])
      have he2 : (1 - e) * ((m : T) * s) = 0 :=
        hjinj (by rw [map_mul, map_sub, map_one, h2, map_zero])
      have he3 : e * e = e := hjinj (by rw [map_mul]; exact hε.eq)
      set π := algebraMap T (Localization.AtPrime q) with hπ
      have hē : π e * π e = π e := by rw [← map_mul, he3]
      rcases IsLocalRing.isUnit_or_isUnit_one_sub_self (π e) with hu | hu
      · right
        have h1' : π e = 1 := hu.mul_left_cancel (by rw [hē, mul_one])
        have hs' : π s' = 0 := by
          have := congrArg π he1
          rwa [map_mul, h1', one_mul, map_zero] at this
        rw [IsLocalization.mk'_eq_mul_mk'_one, hs', zero_mul]
      · left
        have h0 : π e = 0 := (hu.mul_right_eq_zero).mp (by rw [sub_mul, one_mul, hē, sub_self])
        have hs : π s = 0 := by
          have := congrArg π he2
          rw [map_mul, map_sub, map_one, h0, sub_zero, one_mul, map_mul, map_zero] at this
          exact ((IsLocalization.map_units (Localization.AtPrime q) m).mul_right_eq_zero).mp this
        rw [IsLocalization.mk'_eq_mul_mk'_one, hs, zero_mul]
    exact NoZeroDivisors.to_isDomain _
  intro N T _ _ _ _ q _ D _ _ _ π hπ hker
  set I : Ideal N := RingHom.ker π with hI
  set J : Ideal T := I.map (algebraMap N T) with hJ
  have hJq : J ≤ q := by
    rw [hJ, Ideal.map_le_iff_le_comap]
    intro n hn
    exact hker n (RingHom.mem_ker.mp hn)
  let e : N ⧸ I ≃+* D := RingHom.quotientKerEquivOfSurjective hπ
  haveI : IsDomain (N ⧸ I) := MulEquiv.isDomain D e.toMulEquiv
  haveI : IsIntegrallyClosed (N ⧸ I) := IsIntegrallyClosed.of_equiv e.symm

  haveI hEt : Algebra.Etale (N ⧸ I) (T ⧸ J) := by
    haveI : Algebra.Etale (N ⧸ I) (TensorProduct N (N ⧸ I) T) := inferInstance
    let e₁ := Algebra.TensorProduct.comm N (N ⧸ I) T
    let e₂ := Algebra.TensorProduct.quotIdealMapEquivTensorQuot T I
    let eR : TensorProduct N (N ⧸ I) T ≃+* T ⧸ J := e₁.toRingEquiv.trans e₂.symm.toRingEquiv
    let eA : TensorProduct N (N ⧸ I) T ≃ₐ[N ⧸ I] T ⧸ J := AlgEquiv.ofRingEquiv (f := eR) (by
      intro x
      obtain ⟨n, rfl⟩ := Ideal.Quotient.mk_surjective x
      show e₂.symm (e₁ (algebraMap (N ⧸ I) (TensorProduct N (N ⧸ I) T) (Ideal.Quotient.mk I n))) = _
      rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply,
        Algebra.TensorProduct.comm_tmul, Algebra.TensorProduct.quotIdealMapEquivTensorQuot_symm_tmul,
        Ideal.Quotient.algebraMap_quotient_map_quotient, Algebra.smul_def, mul_one]
      rfl)
    exact Algebra.Etale.of_equiv eA
  set q' : Ideal (T ⧸ J) := q.map (Ideal.Quotient.mk J) with hq'
  haveI hq'p : q'.IsPrime := Ideal.map_isPrime_of_surjective Ideal.Quotient.mk_surjective
    (by rw [Ideal.mk_ker]; exact hJq)
  have hcomap : q'.comap (Ideal.Quotient.mk J) = q := by
    rw [hq', Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
    exact sup_eq_left.mpr hJq
  haveI hdom : IsDomain (Localization.AtPrime q') :=
    wc_ring_etale_localization_isDomain (N ⧸ I) (T ⧸ J) q'
  have hT : Submonoid.map (Ideal.Quotient.mk J) q.primeCompl = q'.primeCompl := by
    ext y
    simp only [Submonoid.mem_map, Ideal.mem_primeCompl_iff]
    constructor
    · rintro ⟨x, hx, rfl⟩ hy
      apply hx
      rw [← hcomap]; exact hy
    · intro hy
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      refine ⟨x, ?_, rfl⟩
