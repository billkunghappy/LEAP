          hV₀.fromSpec ≫ pY) := by
      have heq' : ((inv (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl)) ≫ hU.fromSpec) ⁻¹ᵁ W).ι ≫
          hV₀.fromSpec ≫ pY =
