      rw [← Scheme.Hom.comp_apply, hju]
      apply closed_eq
      have := ub.isClosedMap _ (hfz2 w)
      rwa [Set.image_singleton] at this)
  let Ub : Fin (N + 1) → Zb.Opens := fun a => j ⁻¹ᵁ (@Proj.basicOpen _ _ _ _ _
    (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥Wb) MvPolynomial.gradedAlgebra (g a))
  have hUbaff : ∀ a, IsAffineOpen (Ub a) := fun a =>
    (@Proj.isAffineOpen_basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥Wb)
