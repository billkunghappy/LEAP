    have hjt₀ : (inv (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl)) ≫ hU.fromSpec)
        (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl) t₁) = n 0 (IsLocalRing.closedPoint K) := by
      rw [Scheme.Hom.comp_apply, e1, ht₁]
    obtain ⟨W, hxW, hWsm⟩ := hsm 0
    have ht₀W : Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl) t₁ ∈
        (inv (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl)) ≫ hU.fromSpec) ⁻¹ᵁ W := by
      show (inv (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl)) ≫ hU.fromSpec)
        (Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl) t₁) ∈ W
      rw [hjt₀]
