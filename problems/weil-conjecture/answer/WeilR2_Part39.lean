    intro K _ _ V
    apply IsAlgClosed.of_exists_root
    intro p hpm hpirr
    obtain ⟨q, hqmap, hqdeg, hqmon⟩ := Polynomial.lifts_and_natDegree_eq_and_monic
      ((Polynomial.mem_lifts p).mpr
        (Polynomial.map_surjective _ IsLocalRing.residue_surjective p)) hpm
    have hpdeg : p.natDegree ≠ 0 := (Irreducible.natDegree_pos hpirr).ne'
    have hdeg : (q.map (algebraMap ↥V K)).degree ≠ 0 := by
      intro h0
      have h1 : (q.map (algebraMap ↥V K)).natDegree = 0 :=
        Polynomial.natDegree_eq_of_degree_eq_some h0
      rw [hqmon.natDegree_map] at h1
