theorem wcpa_dj_lfc_contract_stable : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (Z₁ Z : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (uu : Z ⟶ Spec (.of ↥W)) (φ : Z₁ ⟶ Z)
