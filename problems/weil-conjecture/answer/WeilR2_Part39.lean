      + ((A ^ (p + e) * B ^ e * xa) * (αa * βb - βa * αb) * βd) * h2bd
  have corr : ∀ {R : Type u} [CommRing R] {A s1a s2a s1b s2b αa βa αb βb xa xb γa γb : R},
      s1b = A ^ p * s1a → s2b = A ^ p * s2a → xb = A ^ (p + (p + e)) * xa →
