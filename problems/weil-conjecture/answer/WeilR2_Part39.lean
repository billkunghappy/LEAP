  have happ : ∀ {Y Z : Scheme.{u}} (q : Y ⟶ Z) (x : Γ(Z, ⊤)),
      (q.appTop).hom x = (q.appLE ⊤ ⊤ le_top).hom x := by
    intro Y Z q x
    rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
    rfl
  have heval : ∀ (Y : Scheme.{u}) (τ : Spec (.of K) ⟶ Y) (q : Y ⟶ Spec (.of K)),
      τ ≫ q = 𝟙 _ → ∀ (V : Y.Opens) (hV : ⊤ ≤ τ ⁻¹ᵁ V) (γ : Γ(Spec (.of K), ⊤)),
      (τ.appLE V ⊤ hV).hom ((q.appLE ⊤ V le_top).hom γ) = γ := by
    intro Y τ q hτ V hV γ
    rw [hcomp τ q ⊤ V ⊤ le_top hV le_top, hcongr _ _ hτ ⊤ ⊤ le_top le_top]
    exact hid _ _ γ

  have hG : ∀ {Y : Scheme.{u}} (j : Y ⟶ X) (y : Y) (x : X) (hx : x = j y) (V : X.Opens)
      (hV : x ∈ V) (hV' : j y ∈ V) (s : Γ(X, V)),
      (j.stalkMap y).hom ((X.presheaf.stalkCongr (Inseparable.of_eq hx)).hom.hom
        ((X.presheaf.germ V x hV).hom s)) =
        (Y.presheaf.germ (j ⁻¹ᵁ V) y hV').hom ((j.app V).hom s) := by
    intro Y j y x hx V hV hV' s
    subst hx
    have e : X.presheaf.germ V (j y) hV ≫ (X.presheaf.stalkCongr (Inseparable.of_eq rfl)).hom ≫
        j.stalkMap y = j.app V ≫ Y.presheaf.germ (j ⁻¹ᵁ V) y hV' := by
      rw [TopCat.Presheaf.stalkCongr_hom, TopCat.Presheaf.stalkSpecializes_refl, Category.id_comp,
        Scheme.Hom.germ_stalkMap]
    have e' := congrArg (fun φ => φ.hom s) e
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using e'

  have hge : ∀ {Z Y : Scheme.{u}} (σ : Z ⟶ Y) (z0 : Z) (V : Y.Opens)
      (hV : σ z0 ∈ V) (h : ⊤ ≤ σ ⁻¹ᵁ V) (s : Γ(Y, V)),
