          change ρ (algebraMap L (MvPolynomial (Fin m) L) a) = ρ (MvPolynomial.C a)
          rw [MvPolynomial.algebraMap_eq] }
    let Θ : MvPolynomial (Fin m) L →ₐ[L] R ⧸ IsLocalRing.maximalIdeal R ^ n :=
      (Ideal.Quotient.mkₐ L (IsLocalRing.maximalIdeal R ^ n)).comp ρₐ
    have hΘs : Function.Surjective Θ := by
      intro z
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨h, hh⟩ := hdens' n y
      refine ⟨h, ?_⟩
      show Ideal.Quotient.mk _ (ρ h) = Ideal.Quotient.mk _ y
      rw [Ideal.Quotient.eq, ← neg_sub]
      exact neg_mem hh
    have hΘk : RingHom.ker Θ = wcpaLquI F' c' n := by
      ext h
      rw [RingHom.mem_ker, ← hstrict' n h]
      show Ideal.Quotient.mk _ (ρ h) = 0 ↔ _
      exact Ideal.Quotient.eq_zero_iff_mem
    have e1 := (Ideal.quotientEquivAlgOfEq L hΘk.symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective hΘs)
    rw [e1.toLinearEquiv.finrank_eq, hq]
  refine ⟨χ, hG1, hG2, hG3, ?_⟩
  refine s7 (fun j => MvPolynomial.map ψ (F j)) (fun l => χ (p (MvPolynomial.X l))) _ (σ.comp P0)
    (eC.toRingHom.comp (algebraMap _ _)) ?_ hd hs hdens (fun n h => hstrict n h)
  rw [hρC, hσφ]
  exact heC

theorem wcpa_dj_sno_local_generators : ∀ (K : Type u) [Field K] (m r : ℕ) (F : Fin r → MvPolynomial (Fin m) K) (c : Fin m → K), (∀ j, MvPolynomial.eval c (F j) = 0) → wcpaLquPNT F c → (∀ n : ℕ, 1 ≤ n → Module.finrank K (MvPolynomial (Fin m) K ⧸ wcpaLquI F c n) = 2 * n - 1) → 2 ≤ m ∧ ∃ (ι : Fin (m - 1) → Fin r) (s : MvPolynomial (Fin m) K), MvPolynomial.eval c s ≠ 0 ∧ ∀ j, s * F j ∈ Ideal.span (Set.range fun i => F (ι i)) :=
by
  intro K _ m r F c hF hPNT hHilb
  classical
  obtain ⟨α, β, hPa, hPb, hPc⟩ := hPNT
  obtain ⟨M, hM⟩ : ∃ M : Ideal (MvPolynomial (Fin m) K),
      M = Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) := ⟨_, rfl⟩
  have hI : ∀ {k : ℕ} (G : Fin k → MvPolynomial (Fin m) K) (n : ℕ),
      wcpaLquI G c n = M ^ n ⊔ Ideal.span (Set.range G) := by
    intro k G n; rw [hM]; rfl
  have htM : ∀ l, MvPolynomial.X l - MvPolynomial.C (c l) ∈ M := fun l => by
    rw [hM]; exact Ideal.subset_span ⟨l, rfl⟩


  have hE2 : ∀ p ∈ M, MvPolynomial.eval c p = 0 := by
    have hle : M ≤ RingHom.ker (MvPolynomial.eval c) := by
      rw [hM, Ideal.span_le]
      rintro _ ⟨l, rfl⟩
      simp
    intro p hp
    exact hle hp

  have hE0 : ∀ h : MvPolynomial (Fin m) K, h - MvPolynomial.C (MvPolynomial.eval c h) ∈ M := by
    intro h
    induction h using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq =>
      have e : p + q - MvPolynomial.C (MvPolynomial.eval c (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.eval c p)) +
            (q - MvPolynomial.C (MvPolynomial.eval c q)) := by
        simp only [map_add]; ring
      rw [e]; exact add_mem hp hq
    | mul_X p n hp =>
      have e : p * MvPolynomial.X n - MvPolynomial.C (MvPolynomial.eval c (p * MvPolynomial.X n)) =
          (p - MvPolynomial.C (MvPolynomial.eval c p)) * MvPolynomial.X n +
            MvPolynomial.C (MvPolynomial.eval c p) * (MvPolynomial.X n - MvPolynomial.C (c n)) := by
        simp only [map_mul, MvPolynomial.eval_X]; ring
      rw [e]
      exact add_mem (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ (htM n))

  have hLinM : ∀ w, wcpaLquLin c w ∈ M := by
    intro w
    unfold wcpaLquLin
    exact Ideal.sum_mem _ fun l _ => Ideal.mul_mem_left _ _ (htM l)
  have hLinComb : ∀ (s t : K) (v w : Fin m → K),
      MvPolynomial.C s * wcpaLquLin c v + MvPolynomial.C t * wcpaLquLin c w =
        wcpaLquLin c (s • v + t • w) := by
    intro s t v w
    unfold wcpaLquLin
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun l _ => ?_
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, map_add, map_mul]
    ring
  have hLin0 : wcpaLquLin c (0 : Fin m → K) = 0 := by
    unfold wcpaLquLin; simp

  have hL1 : ∀ y ∈ M, ∃ v : Fin m → K, y - wcpaLquLin c v ∈ M ^ 2 := by
    intro y hy
    rw [hM] at hy
    obtain ⟨g, hg⟩ := Ideal.mem_span_range_iff_exists_fun.mp hy
    refine ⟨fun l => MvPolynomial.eval c (g l), ?_⟩
    rw [← hg]
    unfold wcpaLquLin
    rw [← Finset.sum_sub_distrib]
    refine Ideal.sum_mem _ fun l _ => ?_
    rw [← sub_mul, pow_two]
    exact Ideal.mul_mem_mul (hE0 (g l)) (htM l)

  have hMS : ∀ (J : Ideal (MvPolynomial (Fin m) K)) (i j n : ℕ), i + j = n →
      ∀ p q, p ∈ M ^ i → q ∈ M ^ j ⊔ J → p * q ∈ M ^ n ⊔ J := by
    intro J i j n hn p q hp hq
    obtain ⟨q1, hq1, q2, hq2, rfl⟩ := Submodule.mem_sup.mp hq
    rw [mul_add]
    refine add_mem (Ideal.mem_sup_left ?_) (Ideal.mem_sup_right (Ideal.mul_mem_left _ _ hq2))
    rw [← hn, pow_add]
    exact Ideal.mul_mem_mul hp hq1

  have hD : ∀ j : ℕ, ∀ h ∈ M ^ (j + 1), ∀ l, MvPolynomial.pderiv l h ∈ M ^ j := by
    intro j
    induction j with
    | zero => intro h _ l; simp
    | succ j ih =>
      intro h hh l
      rw [pow_succ] at hh
      refine Submodule.mul_induction_on (C := fun h => MvPolynomial.pderiv l h ∈ M ^ (j + 1)) hh ?_ ?_
      · intro x hx y hy
        rw [MvPolynomial.pderiv_mul]
        refine add_mem ?_ (Ideal.mul_mem_right _ _ hx)
        rw [pow_succ]
        exact Ideal.mul_mem_mul (ih x hx l) hy
      · intro x y hx hy
        rw [map_add]; exact add_mem hx hy
  have hdLin : ∀ (w : Fin m → K) (b : Fin m),
      MvPolynomial.pderiv b (wcpaLquLin c w) = MvPolynomial.C (w b) := by
    intro w b
    unfold wcpaLquLin
    simp [map_sum, MvPolynomial.pderiv_X, Pi.single_apply]

  have hLinProd : ∀ (v w : Fin m → K), (∀ s t : K, s • v + t • w = 0 → s = 0 ∧ t = 0) →
      wcpaLquLin c v * wcpaLquLin c w ∉ M ^ 3 := by
    intro v w hind hmem
    have hR : ∀ a b, v b * w a + v a * w b = 0 := by
      intro a b
      have h2 : MvPolynomial.pderiv a (MvPolynomial.pderiv b
          (wcpaLquLin c v * wcpaLquLin c w)) ∈ M := by
        have := hD 1 _ (hD 2 _ hmem b) a
        simpa using this
      have h3 := hE2 _ h2
      have e : MvPolynomial.pderiv a (MvPolynomial.pderiv b
          (wcpaLquLin c v * wcpaLquLin c w)) = MvPolynomial.C (v b * w a + v a * w b) := by
        simp only [MvPolynomial.pderiv_mul, hdLin, MvPolynomial.pderiv_C, map_add, map_mul]
        ring
      rw [e, MvPolynomial.eval_C] at h3
      exact h3
    by_cases hv : ∀ a, v a = 0
    · have := hind 1 0 (by funext l; simp [hv l])
      exact one_ne_zero this.1
    · push_neg at hv
      obtain ⟨a, ha⟩ := hv
      have h2 : w a + w a = 0 := by
        have h0 := hR a a
        have : v a * (w a + w a) = 0 := by linear_combination h0
        exact (mul_eq_zero.mp this).resolve_left ha
      have := hind (w a) (-(v a)) (by
        funext b
        simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
        linear_combination (-1 : K) * hR a b + v b * h2)
      exact ha (neg_eq_zero.mp this.2)

  have hCNT : ∀ (I : Ideal (MvPolynomial (Fin m) K)) (ι : Type) [Fintype ι]
      (b : ι → MvPolynomial (Fin m) K),
      (∀ h, ∃ μ : ι → K, h - ∑ i, MvPolynomial.C (μ i) * b i ∈ I) →
      Module.Finite K (MvPolynomial (Fin m) K ⧸ I) ∧
        Module.finrank K (MvPolynomial (Fin m) K ⧸ I) ≤ Fintype.card ι := by
    intro I ι _ b hb
    let Φ : (ι → K) →ₗ[K] MvPolynomial (Fin m) K ⧸ I :=
      { toFun := fun μ => Ideal.Quotient.mk I (∑ i, MvPolynomial.C (μ i) * b i)
        map_add' := fun μ ν => by
          simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
        map_smul' := fun s μ => by
          change Ideal.Quotient.mk I _ = s • Ideal.Quotient.mk I _
          rw [← Ideal.Quotient.mkₐ_eq_mk K, ← map_smul, MvPolynomial.smul_eq_C_mul, Finset.mul_sum]
          congr 1
          refine Finset.sum_congr rfl fun i _ => ?_
          simp only [Pi.smul_apply, smul_eq_mul, map_mul]; ring }
    have hΦ : Function.Surjective Φ := by
      intro q
      obtain ⟨h, rfl⟩ := Ideal.Quotient.mk_surjective q
      obtain ⟨μ, hμ⟩ := hb h
      refine ⟨μ, ?_⟩
      show Ideal.Quotient.mk I (∑ i, MvPolynomial.C (μ i) * b i) = Ideal.Quotient.mk I h
      rw [Ideal.Quotient.eq]
      have e : ∑ i, MvPolynomial.C (μ i) * b i - h = -(h - ∑ i, MvPolynomial.C (μ i) * b i) := by
        ring
      rw [e]; exact neg_mem hμ
    refine ⟨Module.Finite.of_surjective Φ hΦ, ?_⟩
    have h1 := LinearMap.finrank_range_le Φ
    rw [LinearMap.range_eq_top.mpr hΦ, finrank_top, Module.finrank_fintype_fun_eq_card] at h1
    exact h1

  have hS5 : ∀ {k : ℕ} (G : Fin k → MvPolynomial (Fin m) K),
      (∀ w : Fin m → K, ∃ a b : K, wcpaLquLin c w - (MvPolynomial.C a * wcpaLquLin c α +
        MvPolynomial.C b * wcpaLquLin c β) ∈ wcpaLquI G c 2) →
      (Module.Finite K (MvPolynomial (Fin m) K ⧸ wcpaLquI G c 3) ∧
        Module.finrank K (MvPolynomial (Fin m) K ⧸ wcpaLquI G c 3) ≤ 6) ∧
      (wcpaLquLin c α * wcpaLquLin c β ∈ wcpaLquI G c 3 → ∀ n : ℕ, 1 ≤ n →
        Module.Finite K (MvPolynomial (Fin m) K ⧸ wcpaLquI G c n) ∧
          Module.finrank K (MvPolynomial (Fin m) K ⧸ wcpaLquI G c n) ≤ 2 * n - 1) := by
    intro k G hP
    simp only [hI] at hP
    set J := Ideal.span (Set.range G) with hJ
    set U := wcpaLquLin c α with hU
    set V := wcpaLquLin c β with hV
    have hUM : U ∈ M := hLinM α
    have hVM : V ∈ M := hLinM β
    have hF1 : ∀ y ∈ M, ∃ a b : K,
        y - (MvPolynomial.C a * U + MvPolynomial.C b * V) ∈ M ^ 2 ⊔ J := by
      intro y hy
      obtain ⟨w, hw⟩ := hL1 y hy
      obtain ⟨a, b, hab⟩ := hP w
      refine ⟨a, b, ?_⟩
      have e1 : y - (MvPolynomial.C a * U + MvPolynomial.C b * V) = (y - wcpaLquLin c w) +
          (wcpaLquLin c w - (MvPolynomial.C a * U + MvPolynomial.C b * V)) := by ring
      rw [e1]
      exact add_mem (Ideal.mem_sup_left hw) hab
    have hF2 : ∀ x ∈ M ^ 2, ∃ a b d : K, x - (MvPolynomial.C a * U ^ 2 +
        MvPolynomial.C b * (U * V) + MvPolynomial.C d * V ^ 2) ∈ M ^ 3 ⊔ J := by
      intro x hx
      rw [pow_two] at hx
      refine Submodule.mul_induction_on (C := fun x => ∃ a b d : K, x - (MvPolynomial.C a * U ^ 2 +
        MvPolynomial.C b * (U * V) + MvPolynomial.C d * V ^ 2) ∈ M ^ 3 ⊔ J) hx ?_ ?_
      · intro x hx y hy
        obtain ⟨a, b, hab⟩ := hF1 x hx
        obtain ⟨a', b', hab'⟩ := hF1 y hy
        refine ⟨a * a', a * b' + b * a', b * b', ?_⟩
        have e1 : x * y - (MvPolynomial.C (a * a') * U ^ 2 +
            MvPolynomial.C (a * b' + b * a') * (U * V) + MvPolynomial.C (b * b') * V ^ 2) =
            (MvPolynomial.C a * U + MvPolynomial.C b * V) *
              (y - (MvPolynomial.C a' * U + MvPolynomial.C b' * V)) +
            y * (x - (MvPolynomial.C a * U + MvPolynomial.C b * V)) := by
          simp only [map_mul, map_add]; ring
        rw [e1]
        have hL : MvPolynomial.C a * U + MvPolynomial.C b * V ∈ M ^ 1 := by
          rw [pow_one]
          exact add_mem (Ideal.mul_mem_left _ _ hUM) (Ideal.mul_mem_left _ _ hVM)
        refine add_mem (hMS J 1 2 3 rfl _ _ hL hab') ?_
        exact hMS J 1 2 3 rfl _ _ (by rw [pow_one]; exact hy) hab
      · rintro x y ⟨a1, b1, d1, h1⟩ ⟨a2, b2, d2, h2⟩
        refine ⟨a1 + a2, b1 + b2, d1 + d2, ?_⟩
        have e1 : x + y - (MvPolynomial.C (a1 + a2) * U ^ 2 +
            MvPolynomial.C (b1 + b2) * (U * V) + MvPolynomial.C (d1 + d2) * V ^ 2) =
            (x - (MvPolynomial.C a1 * U ^ 2 + MvPolynomial.C b1 * (U * V) +
              MvPolynomial.C d1 * V ^ 2)) +
            (y - (MvPolynomial.C a2 * U ^ 2 + MvPolynomial.C b2 * (U * V) +
              MvPolynomial.C d2 * V ^ 2)) := by
          simp only [map_add]; ring
        rw [e1]; exact add_mem h1 h2
    have hFd : U * V ∈ M ^ 3 ⊔ J → ∀ e : ℕ, ∀ x ∈ M ^ (e + 1), ∃ a b : K,
        x - (MvPolynomial.C a * U ^ (e + 1) + MvPolynomial.C b * V ^ (e + 1)) ∈ M ^ (e + 2) ⊔ J := by
      intro hUV e
      induction e with
      | zero =>
        intro x hx
        obtain ⟨a, b, hab⟩ := hF1 x (by simpa using hx)
        exact ⟨a, b, by simpa using hab⟩
      | succ e ih =>
        intro x hx
        rw [pow_succ] at hx
        refine Submodule.mul_induction_on (C := fun x => ∃ a b : K,
          x - (MvPolynomial.C a * U ^ (e + 1 + 1) + MvPolynomial.C b * V ^ (e + 1 + 1)) ∈
            M ^ (e + 1 + 2) ⊔ J) hx ?_ ?_
        · intro x hx y hy
          obtain ⟨a, b, hab⟩ := ih x hx
          obtain ⟨a', b', hab'⟩ := hF1 y hy
          refine ⟨a * a', b * b', ?_⟩
          have e1 : x * y - (MvPolynomial.C (a * a') * U ^ (e + 1 + 1) +
              MvPolynomial.C (b * b') * V ^ (e + 1 + 1)) =
              MvPolynomial.C (a * b') * (U ^ e * (U * V)) +
              MvPolynomial.C (b * a') * (V ^ e * (U * V)) +
              (MvPolynomial.C a * U ^ (e + 1) + MvPolynomial.C b * V ^ (e + 1)) *
                (y - (MvPolynomial.C a' * U + MvPolynomial.C b' * V)) +
              y * (x - (MvPolynomial.C a * U ^ (e + 1) + MvPolynomial.C b * V ^ (e + 1))) := by
            simp only [map_mul]; ring
          rw [e1]
          have hUe : U ^ e ∈ M ^ e := Ideal.pow_mem_pow hUM e
          have hVe : V ^ e ∈ M ^ e := Ideal.pow_mem_pow hVM e
          have hA : MvPolynomial.C a * U ^ (e + 1) + MvPolynomial.C b * V ^ (e + 1) ∈ M ^ (e + 1) :=
            add_mem (Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hUM _))
              (Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow hVM _))
          refine add_mem (add_mem (add_mem ?_ ?_) ?_) ?_
          · exact Ideal.mul_mem_left _ _ (hMS J e 3 (e + 1 + 2) (by omega) _ _ hUe hUV)
          · exact Ideal.mul_mem_left _ _ (hMS J e 3 (e + 1 + 2) (by omega) _ _ hVe hUV)
          · exact hMS J (e + 1) 2 (e + 1 + 2) (by omega) _ _ hA hab'
          · exact hMS J 1 (e + 2) (e + 1 + 2) (by omega) _ _ (by rw [pow_one]; exact hy) hab
        · rintro x y ⟨a1, b1, h1⟩ ⟨a2, b2, h2⟩
          refine ⟨a1 + a2, b1 + b2, ?_⟩
          have e1 : x + y - (MvPolynomial.C (a1 + a2) * U ^ (e + 1 + 1) +
              MvPolynomial.C (b1 + b2) * V ^ (e + 1 + 1)) =
              (x - (MvPolynomial.C a1 * U ^ (e + 1 + 1) + MvPolynomial.C b1 * V ^ (e + 1 + 1))) +
              (y - (MvPolynomial.C a2 * U ^ (e + 1 + 1) + MvPolynomial.C b2 * V ^ (e + 1 + 1))) := by
            simp only [map_add]; ring
          rw [e1]; exact add_mem h1 h2
    refine ⟨?_, ?_⟩
    · rw [hI G 3]
      have := hCNT (M ^ 3 ⊔ J) (Fin 6) ![1, U, V, U ^ 2, U * V, V ^ 2] ?_
      · simpa using this
      intro h
      obtain ⟨a, b, hab⟩ := hF1 _ (hE0 h)
      obtain ⟨e1, he1, e2, he2, he⟩ := Submodule.mem_sup.mp hab
      obtain ⟨a2, b2, d2, h2⟩ := hF2 e1 he1
      refine ⟨![MvPolynomial.eval c h, a, b, a2, b2, d2], ?_⟩
      have hsum : ∑ i, MvPolynomial.C (![MvPolynomial.eval c h, a, b, a2, b2, d2] i) *
          (![1, U, V, U ^ 2, U * V, V ^ 2] : Fin 6 → MvPolynomial (Fin m) K) i =
          MvPolynomial.C (MvPolynomial.eval c h) + (MvPolynomial.C a * U + MvPolynomial.C b * V) +
          (MvPolynomial.C a2 * U ^ 2 + MvPolynomial.C b2 * (U * V) + MvPolynomial.C d2 * V ^ 2) := by
        simp [Fin.sum_univ_succ] <;> ring
      rw [hsum]
      convert add_mem h2 (Ideal.mem_sup_right he2) using 1
      linear_combination (-1 : MvPolynomial (Fin m) K) * he
    · intro hUV n hn
      rw [hI G 3] at hUV
      obtain ⟨e, rfl⟩ : ∃ e, n = e + 1 := ⟨n - 1, by omega⟩
      rw [hI G (e + 1), ← hJ]
      have hT : ∀ e : ℕ, ∀ h, ∃ (μ : Fin (e + 1) → K) (ν : Fin e → K),
          h - (∑ i, MvPolynomial.C (μ i) * U ^ (i : ℕ) +
            ∑ i, MvPolynomial.C (ν i) * V ^ ((i : ℕ) + 1)) ∈ M ^ (e + 1) ⊔ J := by
        intro e
        induction e with
        | zero =>
          intro h
          refine ⟨fun _ => MvPolynomial.eval c h, Fin.elim0, ?_⟩
          have h0 : h - MvPolynomial.C (MvPolynomial.eval c h) ∈ M ⊔ J := Ideal.mem_sup_left (hE0 h)
          simpa using h0
        | succ e ih =>
          intro h
          obtain ⟨μ, ν, hμν⟩ := ih h
          obtain ⟨ρ1, hρ1, ρ2, hρ2, hρ⟩ := Submodule.mem_sup.mp hμν
          obtain ⟨a, b, hab⟩ := hFd hUV e ρ1 hρ1
          refine ⟨(Fin.snoc μ a : Fin (e + 1 + 1) → K), (Fin.snoc ν b : Fin (e + 1) → K), ?_⟩
          rw [Fin.sum_univ_castSucc (n := e), Fin.sum_univ_castSucc (n := e + 1)]
          simp only [Fin.snoc_castSucc, Fin.snoc_last, Fin.coe_castSucc, Fin.val_last]
          convert add_mem hab (Ideal.mem_sup_right hρ2) using 1
          linear_combination (-1 : MvPolynomial (Fin m) K) * hρ
      have := hCNT (M ^ (e + 1) ⊔ J) (Fin (e + 1) ⊕ Fin e)
        (Sum.elim (fun i : Fin (e + 1) => U ^ (i : ℕ)) (fun i : Fin e => V ^ ((i : ℕ) + 1))) ?_
      · obtain ⟨h1, h2⟩ := this
        refine ⟨h1, ?_⟩
        simp only [Fintype.card_sum, Fintype.card_fin] at h2
        omega
      · intro h
        obtain ⟨μ, ν, hμν⟩ := hT e h
        refine ⟨Sum.elim μ ν, ?_⟩
        rw [Fintype.sum_sum_type]
        simpa using hμν

  have hEq : ∀ I J : Ideal (MvPolynomial (Fin m) K), I ≤ J →
      Module.Finite K (MvPolynomial (Fin m) K ⧸ I) →
      Module.finrank K (MvPolynomial (Fin m) K ⧸ I) ≤ Module.finrank K (MvPolynomial (Fin m) K ⧸ J) →
      J ≤ I := by
    intro I J hIJ hfin hdim
    haveI := hfin
    let φ := (Ideal.Quotient.factorₐ K hIJ).toLinearMap
    have hφs : Function.Surjective φ := by
      intro q
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective q
      exact ⟨Ideal.Quotient.mk _ x, Ideal.Quotient.factorₐ_apply_mk K hIJ x⟩
    have hrn := LinearMap.finrank_range_add_finrank_ker φ
    rw [LinearMap.range_eq_top.mpr hφs, finrank_top] at hrn
    have hk0 : Module.finrank K (LinearMap.ker φ) = 0 := by omega
    have hker : LinearMap.ker φ = ⊥ := Submodule.finrank_eq_zero.mp hk0
    intro x hx
    have hx' : Ideal.Quotient.mk I x ∈ LinearMap.ker φ := by
      rw [LinearMap.mem_ker]
      show Ideal.Quotient.factorₐ K hIJ (Ideal.Quotient.mk I x) = 0
      rw [Ideal.Quotient.factorₐ_apply_mk, Ideal.Quotient.eq_zero_iff_mem]; exact hx
    rw [hker, Submodule.mem_bot, Ideal.Quotient.eq_zero_iff_mem] at hx'
    exact hx'

  have hKrull : ∀ (J : Ideal (MvPolynomial (Fin m) K)), (∀ j (n : ℕ), F j ∈ M ^ n ⊔ J) →
      ∃ s, MvPolynomial.eval c s ≠ 0 ∧ ∀ j, s * F j ∈ J := by
    intro J hJ
    have hsm : ∀ x y : MvPolynomial (Fin m) K,
        x • Ideal.Quotient.mk J y = Ideal.Quotient.mk J (x * y) := by
      intro x y
      first
        | rfl
        | (rw [Algebra.smul_def, Ideal.Quotient.algebraMap_eq, map_mul])
        | simp [Algebra.smul_def]
    have hρ : ∀ j, ∃ ρ ∈ M, (1 - ρ) * F j ∈ J := by
      intro j
      have hx : (Ideal.Quotient.mk J (F j)) ∈ ⨅ n : ℕ,
          (M ^ n • ⊤ : Submodule (MvPolynomial (Fin m) K) (MvPolynomial (Fin m) K ⧸ J)) := by
        rw [Submodule.mem_iInf]
        intro n
        obtain ⟨e1, he1, e2, he2, he⟩ := Submodule.mem_sup.mp (hJ j n)
        have : Ideal.Quotient.mk J (F j) = e1 • Ideal.Quotient.mk J 1 := by
          rw [hsm, mul_one, ← he, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr he2, add_zero]
        rw [this]
        exact Submodule.smul_mem_smul he1 Submodule.mem_top
      obtain ⟨⟨ρ, hρM⟩, hρ⟩ := (Ideal.mem_iInf_smul_pow_eq_bot_iff M _).mp hx
      refine ⟨ρ, hρM, ?_⟩
      have h1 : Ideal.Quotient.mk J (ρ * F j) = Ideal.Quotient.mk J (F j) := by
        rw [← hsm]; exact hρ
      rw [Ideal.Quotient.eq] at h1
      have e1 : (1 - ρ) * F j = -(ρ * F j - F j) := by ring
      rw [e1]; exact neg_mem h1
    choose ρ hρM hρJ using hρ
    refine ⟨∏ j, (1 - ρ j), ?_, ?_⟩
    · rw [map_prod]
      apply Finset.prod_ne_zero_iff.mpr
      intro j _
      rw [map_sub, map_one, hE2 _ (hρM j), sub_zero]; exact one_ne_zero
    · intro j
      rw [← Finset.mul_prod_erase Finset.univ (fun j => 1 - ρ j) (Finset.mem_univ j)]
      rw [mul_comm (1 - ρ j), mul_assoc]
      exact Ideal.mul_mem_left _ _ (hρJ j)


  have hind : ∀ s t : K, s • α + t • β = 0 → s = 0 ∧ t = 0 := by
    intro s t hst
    apply hPb
    rw [hLinComb, hst, hLin0]
    exact Submodule.zero_mem _
  have hm2 : 2 ≤ m := by
    have hli : LinearIndependent K ![α, β] := LinearIndependent.pair_iff.mpr hind
    have := hli.fintype_card_le_finrank
    simpa using this
  have hr : 0 < r := by
    rcases Nat.eq_zero_or_pos r with h0 | h0
    · exfalso
      subst h0
      apply hLinProd α β hind
      have h3 := hPc
      rw [hI] at h3
      have hs : Ideal.span (Set.range F) = ⊥ := by
        rw [Set.range_eq_empty, Ideal.span_empty]
      rwa [hs, sup_bot_eq] at h3
    · exact h0
  have hFM : ∀ j, F j ∈ M := fun j => by simpa [hF j] using hE0 (F j)
  choose v hv using fun j => hL1 (F j) (hFM j)

  obtain ⟨κ, a, ha_inj, ha_span, ha_li⟩ := exists_linearIndependent' K v
  haveI : Finite κ := Finite.of_injective a ha_inj
  obtain ⟨k, ⟨e⟩⟩ : ∃ k, Nonempty (κ ≃ Fin k) := ⟨_, ⟨Finite.equivFin κ⟩⟩
  obtain ⟨ι', hι'⟩ : ∃ ι' : Fin k → Fin r, ι' = a ∘ e.symm := ⟨_, rfl⟩
  have hli' : LinearIndependent K (v ∘ ι') := by
    rw [hι']; exact ha_li.comp e.symm e.symm.injective
  have hspan : Submodule.span K (Set.range (v ∘ ι')) = Submodule.span K (Set.range v) := by
    rw [← ha_span, hι']; congr 1; exact e.symm.surjective.range_comp (v ∘ a)
  have hHFspan : Ideal.span (Set.range fun i => F (ι' i)) ≤ Ideal.span (Set.range F) := by
    apply Ideal.span_mono
    rintro _ ⟨i, rfl⟩; exact ⟨ι' i, rfl⟩
  have hkey : ∀ x ∈ Submodule.span K (Set.range (v ∘ ι')),
      wcpaLquLin c x ∈ M ^ 2 ⊔ Ideal.span (Set.range fun i => F (ι' i)) := by
    intro x hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨i, rfl⟩ := hy
      show wcpaLquLin c (v (ι' i)) ∈ _
      have e1 : wcpaLquLin c (v (ι' i)) = F (ι' i) - (F (ι' i) - wcpaLquLin c (v (ι' i))) := by ring
      rw [e1]
      exact sub_mem (Ideal.mem_sup_right (Ideal.subset_span ⟨i, rfl⟩))
        (Ideal.mem_sup_left (hv (ι' i)))
    | zero => rw [hLin0]; exact Submodule.zero_mem _
    | add x y _ _ hx hy =>
      have e1 : wcpaLquLin c (x + y) = wcpaLquLin c x + wcpaLquLin c y := by
        have := hLinComb 1 1 x y
        simp only [map_one, one_mul, one_smul] at this
        exact this.symm
      rw [e1]; exact add_mem hx hy
    | smul s x _ hx =>
      have e1 : wcpaLquLin c (s • x) = MvPolynomial.C s * wcpaLquLin c x := by
        have := hLinComb s 0 x x
        simp only [map_zero, zero_mul, add_zero, zero_smul] at this
        exact this.symm
      rw [e1]; exact Ideal.mul_mem_left _ _ hx
  have hFH : ∀ j, F j ∈ M ^ 2 ⊔ Ideal.span (Set.range fun i => F (ι' i)) := by
    intro j
    have hvj : v j ∈ Submodule.span K (Set.range (v ∘ ι')) := by
      rw [hspan]; exact Submodule.subset_span ⟨j, rfl⟩
    have e1 : F j = (F j - wcpaLquLin c (v j)) + wcpaLquLin c (v j) := by ring
    rw [e1]
    exact add_mem (Ideal.mem_sup_left (hv j)) (hkey _ hvj)
  have hk2 : k + 2 ≤ m := by
    have hli2 : LinearIndependent K ![α, β] := LinearIndependent.pair_iff.mpr hind
    have hdisj : Disjoint (Submodule.span K (Set.range (v ∘ ι')))
        (Submodule.span K (Set.range ![α, β])) := by
      rw [Submodule.disjoint_def]
      intro x hx1 hx2
      obtain ⟨μ, hμ⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hx2
      have hx : x = μ 0 • α + μ 1 • β := by
        rw [← hμ, Fin.sum_univ_two]; simp
      have h1 := hkey x hx1
      rw [hx, ← hLinComb] at h1
      have h2 := hPb (μ 0) (μ 1) (by rw [hI]; exact sup_le_sup_left hHFspan _ h1)
      rw [hx, h2.1, h2.2, zero_smul, zero_smul, add_zero]
    have := (hli'.sum_type hli2 hdisj).fintype_card_le_finrank
    simpa using this

  have hFH2 : wcpaLquI F c 2 ≤ wcpaLquI (fun i => F (ι' i)) c 2 := by
    rw [hI, hI]
    refine sup_le le_sup_left (Ideal.span_le.mpr ?_)
    rintro _ ⟨j, rfl⟩
    exact hFH j
  have hPH : ∀ w : Fin m → K, ∃ a b : K, wcpaLquLin c w - (MvPolynomial.C a * wcpaLquLin c α +
      MvPolynomial.C b * wcpaLquLin c β) ∈ wcpaLquI (fun i => F (ι' i)) c 2 := fun w => by
    obtain ⟨a, b, h⟩ := hPa w; exact ⟨a, b, hFH2 h⟩
  obtain ⟨⟨hfinH, hdimH⟩, -⟩ := hS5 (fun i => F (ι' i)) hPH

  have hAB : wcpaLquI (fun i => F (ι' i)) c 3 ≤ wcpaLquI F c 3 := by
    rw [hI, hI]; exact sup_le_sup_left hHFspan _
  have hB5 : Module.finrank K (MvPolynomial (Fin m) K ⧸ wcpaLquI F c 3) = 5 := hHilb 3 (by norm_num)
  obtain ⟨j₀, hj₀⟩ : ∃ j₀ : Fin r, ∀ j,
      F j ∈ wcpaLquI (fun i => F (ι' i)) c 3 ⊔ Ideal.span {F j₀} := by
    haveI := hfinH
    let φ := (Ideal.Quotient.factorₐ K hAB).toLinearMap
    have hφs : Function.Surjective φ := by
      intro q
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective q
      exact ⟨Ideal.Quotient.mk _ x, Ideal.Quotient.factorₐ_apply_mk K hAB x⟩
    have hrn := LinearMap.finrank_range_add_finrank_ker φ
    rw [LinearMap.range_eq_top.mpr hφs, finrank_top, hB5] at hrn
    have hker1 : Module.finrank K (LinearMap.ker φ) ≤ 1 := by omega
    obtain ⟨g, hg⟩ := finrank_le_one_iff.mp hker1
    have hmem : ∀ j, Ideal.Quotient.mk (wcpaLquI (fun i => F (ι' i)) c 3) (F j) ∈
        LinearMap.ker φ := by
      intro j
      rw [LinearMap.mem_ker]
      show Ideal.Quotient.factorₐ K hAB (Ideal.Quotient.mk _ (F j)) = 0
      rw [Ideal.Quotient.factorₐ_apply_mk, Ideal.Quotient.eq_zero_iff_mem, hI]
      exact Ideal.mem_sup_right (Ideal.subset_span ⟨j, rfl⟩)
    by_cases hall : ∀ j, Ideal.Quotient.mk (wcpaLquI (fun i => F (ι' i)) c 3) (F j) = 0
    · refine ⟨⟨0, hr⟩, fun j => Ideal.mem_sup_left ?_⟩
      exact Ideal.Quotient.eq_zero_iff_mem.mp (hall j)
    · push_neg at hall
      obtain ⟨j₁, hj₁⟩ := hall
      refine ⟨j₁, fun j => ?_⟩
      obtain ⟨c₀, hc₀⟩ := hg ⟨_, hmem j₁⟩
      obtain ⟨cj, hcj⟩ := hg ⟨_, hmem j⟩
      have h0 := congrArg Subtype.val hc₀
      have h1 := congrArg Subtype.val hcj
      simp only [Submodule.coe_smul] at h1 h0
      have hc₀ne : c₀ ≠ 0 := by
        rintro rfl
        apply hj₁
        rw [← h0, zero_smul]
      have key : Ideal.Quotient.mk (wcpaLquI (fun i => F (ι' i)) c 3) (F j) =
          Ideal.Quotient.mk _ ((cj / c₀) • F j₁) := by
        rw [← h1, ← Ideal.Quotient.mkₐ_eq_mk K, map_smul, Ideal.Quotient.mkₐ_eq_mk K, ← h0,
          smul_smul, div_mul_cancel₀ _ hc₀ne]
      rw [Ideal.Quotient.eq] at key
      have e1 : F j = (F j - (cj / c₀) • F j₁) + MvPolynomial.C (cj / c₀) * F j₁ := by
        rw [MvPolynomial.smul_eq_C_mul]; ring
      rw [e1]
      exact add_mem (Ideal.mem_sup_left key)
        (Ideal.mem_sup_right (Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)))

  have hk1 : k < m - 1 := by omega
  obtain ⟨ι, hι⟩ : ∃ ι : Fin (m - 1) → Fin r,
      ι = fun i : Fin (m - 1) => if h : (i : ℕ) < k then ι' ⟨i, h⟩ else j₀ := ⟨_, rfl⟩
  have hHG : ∀ i : Fin k, F (ι' i) ∈ Ideal.span (Set.range fun i => F (ι i)) := by
    intro i
    refine Ideal.subset_span ⟨⟨i, by omega⟩, ?_⟩
    simp [hι, i.isLt]
  have hj₀G : F j₀ ∈ Ideal.span (Set.range fun i => F (ι i)) := by
    refine Ideal.subset_span ⟨⟨k, hk1⟩, ?_⟩
    simp [hι]
  have hHGspan : Ideal.span (Set.range fun i => F (ι' i)) ≤
      Ideal.span (Set.range fun i => F (ι i)) := by
    rw [Ideal.span_le]; rintro _ ⟨i, rfl⟩; exact hHG i
  have hGFspan : Ideal.span (Set.range fun i => F (ι i)) ≤ Ideal.span (Set.range F) := by
    rw [Ideal.span_le]; rintro _ ⟨i, rfl⟩; exact Ideal.subset_span ⟨ι i, rfl⟩
  have hFG3 : wcpaLquI F c 3 ≤ wcpaLquI (fun i => F (ι i)) c 3 := by
    rw [hI, hI]
    refine sup_le le_sup_left (Ideal.span_le.mpr ?_)
    rintro _ ⟨j, rfl⟩
    have := hj₀ j
    rw [hI] at this
    exact (sup_le (sup_le_sup_left hHGspan _)
      (Ideal.span_le.mpr (by rintro _ rfl; exact Ideal.mem_sup_right hj₀G))) this
  have hUVG := hFG3 hPc
  have hPG : ∀ w : Fin m → K, ∃ a b : K, wcpaLquLin c w - (MvPolynomial.C a * wcpaLquLin c α +
      MvPolynomial.C b * wcpaLquLin c β) ∈ wcpaLquI (fun i => F (ι i)) c 2 := fun w => by
    obtain ⟨a, b, h⟩ := hPH w
    refine ⟨a, b, ?_⟩
    rw [hI] at h ⊢
    exact sup_le_sup_left hHGspan _ h
  have hGn := (hS5 (fun i => F (ι i)) hPG).2 hUVG
  have hall : ∀ j (n : ℕ), F j ∈ M ^ n ⊔ Ideal.span (Set.range fun i => F (ι i)) := by
    intro j n
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · simp
    · have hle : wcpaLquI (fun i => F (ι i)) c n ≤ wcpaLquI F c n := by
        rw [hI, hI]; exact sup_le_sup_left hGFspan _
      obtain ⟨hfin, hdim⟩ := hGn n hn
      have := hEq _ _ hle hfin (by rw [hHilb n hn]; exact hdim)
      rw [← hI]
      apply this
      rw [hI]; exact Ideal.mem_sup_right (Ideal.subset_span ⟨j, rfl⟩)
  obtain ⟨s, hs, hsF⟩ := hKrull _ hall
  exact ⟨hm2, ι, s, hs, hsF⟩

theorem wcpa_dj_sno_rci_spread : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [Module.Flat A B] (m r k : ℕ) (p : MvPolynomial (Fin m) A →+* B) (F : Fin r → MvPolynomial (Fin m) A) (ι : Fin k → Fin r), p.comp MvPolynomial.C = algebraMap A B → Function.Surjective p → RingHom.ker p = Ideal.span (Set.range F) → ∀ (L : Type u) [Field L] (ψ : A →+* L) (c : Fin m → L), (∀ j, MvPolynomial.eval c (MvPolynomial.map ψ (F j)) = 0) → (∃ s : MvPolynomial (Fin m) L, MvPolynomial.eval c s ≠ 0 ∧ ∀ j, s * MvPolynomial.map ψ (F j) ∈ Ideal.span (Set.range fun i => MvPolynomial.map ψ (F (ι i)))) → ∃ f : MvPolynomial (Fin m) A, MvPolynomial.eval c (MvPolynomial.map ψ f) ≠ 0 ∧ ∀ j, f * F j ∈ Ideal.span (Set.range fun i => F (ι i)) :=
by
  classical

  have t_nak : ∀ (P M L : Type u) [CommRing P] [AddCommGroup M] [Module P M] [Field L]
      [Algebra P L] (r : ℕ) (g : Fin r → M),
      (∀ j, TensorProduct.tmul P (1 : L)
        (⟨g j, Submodule.subset_span ⟨j, rfl⟩⟩ : Submodule.span P (Set.range g)) = 0) →
      ∃ f : P, algebraMap P L f ≠ 0 ∧ ∀ j, f • g j = 0 := by
    intro P M L _ _ _ _ _ r g h
    set N := Submodule.span P (Set.range g) with hN
    have hsub : Subsingleton (TensorProduct P L N) := by
      refine subsingleton_of_forall_eq 0 (fun t => ?_)
      induction t using TensorProduct.induction_on with
      | zero => rfl
      | tmul l x =>
        obtain ⟨x, hx⟩ := x
        obtain ⟨a, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun P).mp hx
        have hx' : (⟨∑ i, a i • g i, hx⟩ : N) =
            ∑ i, a i • (⟨g i, Submodule.subset_span ⟨i, rfl⟩⟩ : N) := by
          ext; simp
        rw [hx', TensorProduct.tmul_sum]
        refine Finset.sum_eq_zero (fun i _ => ?_)
        rw [TensorProduct.tmul_smul]
        have e : TensorProduct.tmul P l (⟨g i, Submodule.subset_span ⟨i, rfl⟩⟩ : N) =
            l • (TensorProduct.tmul P (1 : L) (⟨g i, Submodule.subset_span ⟨i, rfl⟩⟩ : N)) := by
          rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
        rw [e, h i, smul_zero, smul_zero]
      | add x y hx hy => rw [hx, hy, add_zero]
    set ε := algebraMap P L with hε
    haveI hq : (RingHom.ker ε).IsPrime := RingHom.ker_isPrime ε
    have hf₂ : (RingHom.ker ε).primeCompl ≤ Submonoid.comap ε (IsUnit.submonoid L) := by
      intro x hx
      simp only [Submonoid.mem_comap, IsUnit.mem_submonoid_iff]
      exact isUnit_iff_ne_zero.mpr (fun h0 => hx (RingHom.mem_ker.mpr h0))
    let j : (RingHom.ker ε).ResidueField →+* L :=
      Ideal.ResidueField.lift (RingHom.ker ε) ε le_rfl hf₂
    letI : Algebra (RingHom.ker ε).ResidueField L := j.toAlgebra
    haveI : IsScalarTower P (RingHom.ker ε).ResidueField L :=
      IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x =>
        (Ideal.ResidueField.lift_algebraMap (RingHom.ker ε) ε le_rfl hf₂ x).symm)
    have e1 :=
      TensorProduct.AlgebraTensorModule.cancelBaseChange P (RingHom.ker ε).ResidueField L L N
    haveI : Subsingleton (TensorProduct (RingHom.ker ε).ResidueField L
        (TensorProduct P (RingHom.ker ε).ResidueField N)) :=
      e1.toEquiv.subsingleton
    have hκ : Subsingleton (TensorProduct P (RingHom.ker ε).ResidueField N) :=
      Module.FaithfullyFlat.lTensor_reflects_triviality (RingHom.ker ε).ResidueField L _
    haveI : Module.Finite P N := Module.Finite.iff_fg.mpr (Submodule.fg_span (Set.finite_range g))
    have hnot : (⟨RingHom.ker ε, hq⟩ : PrimeSpectrum P) ∉ Module.support P N := by
      rw [Module.mem_support_iff_nontrivial_residueField_tensorProduct]
      exact not_nontrivial_iff_subsingleton.mpr hκ
    rw [Module.mem_support_iff_of_finite] at hnot
    obtain ⟨f, hf, hfq⟩ := SetLike.not_le_iff_exists.mp hnot
    refine ⟨f, fun h0 => hfq (RingHom.mem_ker.mpr h0), fun j => ?_⟩
    have := Module.mem_annihilator.mp hf ⟨g j, Submodule.subset_span ⟨j, rfl⟩⟩
    exact congrArg Subtype.val this

  have t_fk : ∀ (A L : Type u) [CommRing A] [CommRing L] [Algebra A L] (m k : ℕ)
      (G : Fin k → MvPolynomial (Fin m) A) (q : MvPolynomial (Fin m) L)
      (a : MvPolynomial (Fin m) A),
      q * MvPolynomial.map (algebraMap A L) a ∈
        Ideal.span (Set.range fun i => MvPolynomial.map (algebraMap A L) (G i)) →
      ∑ v ∈ q.support, TensorProduct.tmul A (q.coeff v)
        (Ideal.Quotient.mk (Ideal.span (Set.range G)) (MvPolynomial.monomial v 1 * a)) = 0 := by
    intro A L _ _ _ m k G q a h
    set I := Ideal.span (Set.range G) with hI
    let e := MvPolynomial.algebraTensorAlgEquiv (σ := Fin m) A L
    let Φ : MvPolynomial (Fin m) L →ₐ[L] TensorProduct A L (MvPolynomial (Fin m) A ⧸ I) :=
      (Algebra.TensorProduct.map (AlgHom.id L L) (Ideal.Quotient.mkₐ A I)).comp e.symm.toAlgHom
    have h1 : ∀ y, Φ (MvPolynomial.map (algebraMap A L) y) =
        TensorProduct.tmul A (1 : L) (Ideal.Quotient.mk I y) := by
      intro y
      have : e.symm (MvPolynomial.map (algebraMap A L) y) = TensorProduct.tmul A (1 : L) y := by
        rw [AlgEquiv.symm_apply_eq, MvPolynomial.algebraTensorAlgEquiv_tmul, one_smul]
      show Algebra.TensorProduct.map (AlgHom.id L L) (Ideal.Quotient.mkₐ A I) (e.symm _) = _
      rw [this, Algebra.TensorProduct.map_tmul]
      rfl
    have h2 : ∀ v (l : L), Φ (MvPolynomial.monomial v l) =
        TensorProduct.tmul A l (Ideal.Quotient.mk I (MvPolynomial.monomial v 1)) := by
      intro v l
      have : e.symm (MvPolynomial.monomial v l) =
          TensorProduct.tmul A l (MvPolynomial.monomial v 1) := by
        rw [AlgEquiv.symm_apply_eq, MvPolynomial.algebraTensorAlgEquiv_tmul,
          MvPolynomial.map_monomial, map_one, MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
      show Algebra.TensorProduct.map (AlgHom.id L L) (Ideal.Quotient.mkₐ A I) (e.symm _) = _
      rw [this, Algebra.TensorProduct.map_tmul]
      rfl
    have h3 : Ideal.span (Set.range fun i => MvPolynomial.map (algebraMap A L) (G i)) ≤
        RingHom.ker Φ := by
      rw [Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, h1,
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_range_self i)),
        TensorProduct.tmul_zero]
    have h4 : Φ q = ∑ v ∈ q.support,
        TensorProduct.tmul A (q.coeff v) (Ideal.Quotient.mk I (MvPolynomial.monomial v 1)) := by
      conv_lhs => rw [← MvPolynomial.support_sum_monomial_coeff q]
      rw [map_sum]
      exact Finset.sum_congr rfl (fun v _ => h2 v _)
    have h5 := h3 h
    rw [RingHom.mem_ker, map_mul, h1, h4] at h5
    calc _ = ∑ v ∈ q.support,
          (TensorProduct.tmul A (q.coeff v) (Ideal.Quotient.mk I (MvPolynomial.monomial v 1))) *
          (TensorProduct.tmul A (1 : L) (Ideal.Quotient.mk I a)) :=
          Finset.sum_congr rfl (fun v _ => by
            rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, map_mul])
      _ = (∑ v ∈ q.support,
          TensorProduct.tmul A (q.coeff v) (Ideal.Quotient.mk I (MvPolynomial.monomial v 1))) *
          (TensorProduct.tmul A (1 : L) (Ideal.Quotient.mk I a)) :=
          (Finset.sum_mul (R := TensorProduct A L (MvPolynomial (Fin m) A ⧸ I)) _ _ _).symm
      _ = 0 := h5

  have t_collapse : ∀ (A L : Type u) [CommRing A] [Field L] [Algebra A L] (m : ℕ) (N : Type u)
      [AddCommGroup N] [Module (MvPolynomial (Fin m) A) N] [Module A N]
      [IsScalarTower A (MvPolynomial (Fin m) A) N] (c : Fin m → L) (q : MvPolynomial (Fin m) L)
      (n : N), MvPolynomial.eval c q ≠ 0 →
      ∑ v ∈ q.support, TensorProduct.tmul A (q.coeff v) (MvPolynomial.monomial v (1 : A) • n) = 0 →
      letI : Algebra (MvPolynomial (Fin m) A) L := (MvPolynomial.aeval c).toRingHom.toAlgebra
      TensorProduct.tmul (MvPolynomial (Fin m) A) (1 : L) n = 0 := by
    intro A L _ _ _ m N _ _ _ _ c q n hq h
    letI : Algebra (MvPolynomial (Fin m) A) L := (MvPolynomial.aeval c).toRingHom.toAlgebra
    let θ0 : L →+ N →+ TensorProduct (MvPolynomial (Fin m) A) L N :=
      AddMonoidHom.mk' (fun l => (TensorProduct.mk (MvPolynomial (Fin m) A) L N l).toAddMonoidHom)
        (fun a b => by ext x; simp)
    let θ : TensorProduct A L N →+ TensorProduct (MvPolynomial (Fin m) A) L N :=
      TensorProduct.liftAddHom θ0 (fun a l x => by
        show TensorProduct.tmul (MvPolynomial (Fin m) A) (a • l) x =
          TensorProduct.tmul (MvPolynomial (Fin m) A) l (a • x)
        rw [← algebraMap_smul (MvPolynomial (Fin m) A) a x, ← TensorProduct.smul_tmul]
        congr 1
        rw [Algebra.smul_def, Algebra.smul_def, RingHom.algebraMap_toAlgebra]
        simp [MvPolynomial.algebraMap_eq])
    have key : θ (∑ v ∈ q.support,
        TensorProduct.tmul A (q.coeff v) (MvPolynomial.monomial v (1 : A) • n)) =
        TensorProduct.tmul (MvPolynomial (Fin m) A) (MvPolynomial.eval c q) n := by
      rw [map_sum]
      have e : MvPolynomial.eval c q =
          ∑ v ∈ q.support, q.coeff v * v.prod (fun i k => c i ^ k) := by
        conv_lhs => rw [← MvPolynomial.support_sum_monomial_coeff q]
        rw [map_sum]
        simp only [MvPolynomial.eval_monomial]
      rw [e, TensorProduct.sum_tmul]
      refine Finset.sum_congr rfl (fun v _ => ?_)
      rw [TensorProduct.liftAddHom_tmul]
      show TensorProduct.tmul (MvPolynomial (Fin m) A) (q.coeff v)
        (MvPolynomial.monomial v (1 : A) • n) = _
      rw [← TensorProduct.smul_tmul, Algebra.smul_def, RingHom.algebraMap_toAlgebra]
      simp [MvPolynomial.aeval_monomial, mul_comm]
    rw [h, map_zero] at key
    have e2 : TensorProduct.tmul (MvPolynomial (Fin m) A) (1 : L) n =
        (MvPolynomial.eval c q)⁻¹ •
          (TensorProduct.tmul (MvPolynomial (Fin m) A) (MvPolynomial.eval c q) n) := by
      rw [TensorProduct.smul_tmul', smul_eq_mul, inv_mul_cancel₀ hq]
    rw [e2, ← key, smul_zero]

  have t_tor : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] [Module.Flat A B]
      (m r : ℕ) (p : MvPolynomial (Fin m) A →+* B) (F : Fin r → MvPolynomial (Fin m) A),
      p.comp MvPolynomial.C = algebraMap A B → Function.Surjective p →
      RingHom.ker p = Ideal.span (Set.range F) →
      ∀ (J' : Ideal (MvPolynomial (Fin m) A)), J' ≤ Ideal.span (Set.range F) →
      ∀ (M : Type u) [AddCommGroup M] [Module A M],
      Function.Injective (LinearMap.lTensor M ((Submodule.span (MvPolynomial (Fin m) A)
        (Set.range fun j => Ideal.Quotient.mk J' (F j))).subtype.restrictScalars A)) := by
    intro A B _ _ _ _ m r p F hpC hps hker J' hJ' M _ _
    have hJp : ∀ a ∈ J', p a = 0 := fun a ha => RingHom.mem_ker.mp (hker ▸ hJ' ha)
    let gr : MvPolynomial (Fin m) A ⧸ J' →+* B := Ideal.Quotient.lift J' p hJp
    let g : (MvPolynomial (Fin m) A ⧸ J') →ₗ[A] B :=
      { toFun := gr
        map_add' := map_add gr
        map_smul' := fun a z => by
          obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
          have e1 : a • Ideal.Quotient.mk J' x = Ideal.Quotient.mk J' (a • x) := by
            rw [← Ideal.Quotient.mkₐ_eq_mk A, map_smul]
          rw [e1, RingHom.id_apply]
          simp only [gr, Ideal.Quotient.lift_mk]
          rw [MvPolynomial.smul_eq_C_mul, map_mul, Algebra.smul_def, ← hpC, RingHom.comp_apply] }
    have hex : Function.Exact ((Submodule.span (MvPolynomial (Fin m) A)
        (Set.range fun j => Ideal.Quotient.mk J' (F j))).subtype.restrictScalars A) g := by
      intro z
      constructor
      · intro hz
        obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
        have hx : p x = 0 := hz
        have hx' : x ∈ Ideal.span (Set.range F) := hker ▸ RingHom.mem_ker.mpr hx
        obtain ⟨a, rfl⟩ := Ideal.mem_span_range_iff_exists_fun.mp hx'
        refine ⟨⟨_, (Submodule.mem_span_range_iff_exists_fun (MvPolynomial (Fin m) A)).mpr
          ⟨a, rfl⟩⟩, ?_⟩
        show ∑ i, a i • Ideal.Quotient.mk J' (F i) = Ideal.Quotient.mk J' (∑ i, a i * F i)
        rw [map_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [map_mul]
        exact Algebra.smul_def (a i) (Ideal.Quotient.mk J' (F i))
      · rintro ⟨⟨y, hy⟩, rfl⟩
        change g y = 0
        induction hy using Submodule.span_induction with
        | mem x hx =>
          obtain ⟨j, rfl⟩ := hx
          show p (F j) = 0
          exact RingHom.mem_ker.mp (hker ▸ Ideal.subset_span ⟨j, rfl⟩)
        | zero => exact map_zero g
        | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
        | smul c x _ hx =>
          change gr (c • x) = 0
          rw [show c • x = Ideal.Quotient.mk J' c * x from Algebra.smul_def c x, map_mul]
          exact mul_eq_zero_of_right _ hx
    exact LinearMap.lTensor_injective_of_exact_of_flat g
      (fun b => by obtain ⟨x, rfl⟩ := hps b; exact ⟨Ideal.Quotient.mk J' x, rfl⟩) _
      (fun x y h => Subtype.ext h) hex M

  intro A B _ _ _ _ m r k p F ι hpC hps hker L _ ψ c _ hs
  obtain ⟨s, hs0, hsF⟩ := hs
  letI : Algebra A L := ψ.toAlgebra
  set J' : Ideal (MvPolynomial (Fin m) A) := Ideal.span (Set.range fun i => F (ι i)) with hJ'def
  have hJ' : J' ≤ Ideal.span (Set.range F) :=
    Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact Ideal.subset_span ⟨ι i, rfl⟩)
  have hinj := t_tor A B m r p F hpC hps hker J' hJ' L
  have hx : ∀ j, ∑ v ∈ s.support, TensorProduct.tmul A (s.coeff v)
      (MvPolynomial.monomial v (1 : A) •
      (⟨Ideal.Quotient.mk J' (F j), Submodule.subset_span ⟨j, rfl⟩⟩ :
        Submodule.span (MvPolynomial (Fin m) A) (Set.range fun j => Ideal.Quotient.mk J' (F j)))) =
      0 := by
    intro j
    apply hinj
    rw [map_zero, map_sum]
    refine (Finset.sum_congr rfl (fun v _ => ?_)).trans
      (t_fk A L m k (fun i => F (ι i)) s (F j) (hsF j))
    rw [LinearMap.lTensor_tmul]
    congr 1
  have h1 := fun j => t_collapse A L m _ c s _ hs0 (hx j)
  letI : Algebra (MvPolynomial (Fin m) A) L := (MvPolynomial.aeval c).toRingHom.toAlgebra
  obtain ⟨f, hf0, hfF⟩ := t_nak (MvPolynomial (Fin m) A) (MvPolynomial (Fin m) A ⧸ J') L r
    (fun j => Ideal.Quotient.mk J' (F j)) (fun j => h1 j)
  refine ⟨f, ?_, fun j => ?_⟩
  · have e : algebraMap (MvPolynomial (Fin m) A) L f =
        MvPolynomial.eval c (MvPolynomial.map ψ f) := by
      show MvPolynomial.aeval c f = _
      rw [MvPolynomial.aeval_def, MvPolynomial.eval_map]
      rfl
    rw [← e]
    exact hf0
  · have h2 : Ideal.Quotient.mk J' (f * F j) = 0 := by
      rw [map_mul]
      exact (Algebra.smul_def f (Ideal.Quotient.mk J' (F j))).symm.trans (hfF j)
    exact Ideal.Quotient.eq_zero_iff_mem.mp h2

theorem wcpa_dj_sno_saturate : ∀ (K : Type u) [Field K] (m r k : ℕ) (F : Fin r → MvPolynomial (Fin m) K) (G : Fin k → MvPolynomial (Fin m) K) (c : Fin m → K) (f : MvPolynomial (Fin m) K), MvPolynomial.eval c f ≠ 0 → (∀ j, f * F j ∈ Ideal.span (Set.range G)) → (∀ i, G i ∈ Ideal.span (Set.range F)) → ∀ n : ℕ, wcpaLquI F c n = wcpaLquI G c n :=
by
  intro K _ m r k F G c f hf hFG hGF n
  unfold wcpaLquI
  set Mc : Ideal (MvPolynomial (Fin m) K) :=
    Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) with hMc
  have Hsub : ∀ h : MvPolynomial (Fin m) K, h - MvPolynomial.C (MvPolynomial.eval c h) ∈ Mc := by
    intro h
    induction h using MvPolynomial.induction_on with
    | C a => rw [MvPolynomial.eval_C, sub_self]; exact Mc.zero_mem
    | add p q hp hq =>
      have e : p + q - MvPolynomial.C (MvPolynomial.eval c (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.eval c p)) +
            (q - MvPolynomial.C (MvPolynomial.eval c q)) := by
        rw [map_add, map_add]; ring
      rw [e]; exact Mc.add_mem hp hq
    | mul_X p l hp =>
      have e : p * MvPolynomial.X l - MvPolynomial.C (MvPolynomial.eval c (p * MvPolynomial.X l)) =
          (p - MvPolynomial.C (MvPolynomial.eval c p)) * MvPolynomial.X l +
            MvPolynomial.C (MvPolynomial.eval c p) * (MvPolynomial.X l - MvPolynomial.C (c l)) := by
        rw [map_mul, MvPolynomial.eval_X, map_mul]; ring
      rw [e]
      refine Mc.add_mem (Mc.mul_mem_right _ hp) (Mc.mul_mem_left _ ?_)
      exact Ideal.subset_span ⟨l, rfl⟩
  have Hzero : ∀ h : MvPolynomial (Fin m) K, MvPolynomial.eval c h = 0 → h ∈ Mc := by
    intro h h0
    have := Hsub h
    rwa [h0, map_zero, sub_zero] at this
  set a := MvPolynomial.eval c f with ha
  set z : MvPolynomial (Fin m) K := 1 - MvPolynomial.C a⁻¹ * f with hz
  have hz0 : z ∈ Mc := by
    apply Hzero
    rw [hz, map_sub, map_one, map_mul, MvPolynomial.eval_C, ← ha, inv_mul_cancel₀ hf, sub_self]
  set f' : MvPolynomial (Fin m) K :=
    MvPolynomial.C a⁻¹ * ∑ i ∈ Finset.range n, z ^ i with hf'
  have hff' : 1 - f * f' = z ^ n := by
    have e1 : f * f' = (1 - z) * ∑ i ∈ Finset.range n, z ^ i := by
      rw [hf', hz]; ring
    rw [e1, mul_neg_geom_sum]; ring
  have hzn : z ^ n ∈ Mc ^ n := Ideal.pow_mem_pow hz0 n
  apply le_antisymm
  · refine sup_le le_sup_left ?_
    rw [Ideal.span_le]
    rintro _ ⟨j, rfl⟩
    have e : F j = f' * (f * F j) + (1 - f * f') * F j := by ring
    rw [SetLike.mem_coe, e, hff']
    exact Ideal.add_mem _ (Ideal.mem_sup_right (Ideal.mul_mem_left _ f' (hFG j)))
      (Ideal.mem_sup_left (Ideal.mul_mem_right _ _ hzn))
  · refine sup_le_sup_left ?_ _
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact hGF i

theorem wcpa_dj_sno_jacobian_smooth : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (m r : ℕ) (p : MvPolynomial (Fin m) A →+* B) (F : Fin r → MvPolynomial (Fin m) A) (ι : Fin (m - 1) → Fin r) (f : MvPolynomial (Fin m) A) (q : (Fin (m - 1) → Fin (m - 1)) × (Fin (m - 1) → Fin m)), 2 ≤ m → p.comp MvPolynomial.C = algebraMap A B → Function.Surjective p → RingHom.ker p = Ideal.span (Set.range F) → (∀ j, f * F j ∈ Ideal.span (Set.range fun i => F (ι i))) → Function.Injective q.1 → Function.Injective q.2 → Algebra.IsStandardSmoothOfRelativeDimension 1 A (Localization.Away (p (f * wcpaLquGen (fun i => F (ι i)) (Sum.inr q)))) :=
by
  intro A B _ _ _ m r p F ι f q hm hpC hps hker hfF hq1 hq2
  classical
  set μ := wcpaLquGen (fun i => F (ι i)) (Sum.inr q) with hμ
  set g := f * μ with hg
  set b := p g with hb
  clear_value b g μ
  let G : Fin (m - 1) → MvPolynomial (Fin m) A := fun i => F (ι (q.1 i))
  let ren : MvPolynomial (Fin m) A →ₐ[A] MvPolynomial (Fin m ⊕ Unit) A := MvPolynomial.rename Sum.inl
  let val : Fin m ⊕ Unit → Localization.Away b :=
    Sum.elim (fun l => algebraMap B (Localization.Away b) (p (MvPolynomial.X l)))
      (fun _ => IsLocalization.Away.invSelf b)
  let φ : MvPolynomial (Fin m ⊕ Unit) A →ₐ[A] Localization.Away b := MvPolynomial.aeval val
  let rel : Fin (m - 1) ⊕ Unit → MvPolynomial (Fin m ⊕ Unit) A :=
    Sum.elim (fun i => ren (G i)) (fun _ => ren g * MvPolynomial.X (Sum.inr ()) - 1)
  have hinv : algebraMap B (Localization.Away b) b * IsLocalization.Away.invSelf b = 1 :=
    IsLocalization.Away.mul_invSelf b
  have hφY : φ (MvPolynomial.X (Sum.inr ())) = IsLocalization.Away.invSelf b :=
    MvPolynomial.aeval_X _ _
  have hrenX : ∀ l, ren (MvPolynomial.X l) = MvPolynomial.X (Sum.inl l) :=
    fun l => MvPolynomial.rename_X _ _
  have hrenC : ∀ a, ren (MvPolynomial.C a) = MvPolynomial.C a :=
    fun a => MvPolynomial.rename_C _ _

  have hev : ∀ h, φ (ren h) = algebraMap B (Localization.Away b) (p h) := by
    have hext : (MvPolynomial.aeval (val ∘ Sum.inl) :
        MvPolynomial (Fin m) A →ₐ[A] Localization.Away b).toRingHom =
        (algebraMap B (Localization.Away b)).comp p := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, MvPolynomial.aeval_C,
          RingHom.comp_apply]
        rw [← RingHom.comp_apply p MvPolynomial.C, hpC, ← IsScalarTower.algebraMap_apply]
      · intro l
        simp [val]
    intro h
    show MvPolynomial.aeval val (MvPolynomial.rename Sum.inl h) = _
    rw [MvPolynomial.aeval_rename]
    exact RingHom.congr_fun hext h

  have hsurj : Function.Surjective φ := by
    intro z
    obtain ⟨⟨a, s⟩, hz⟩ := IsLocalization.surj (Submonoid.powers b) z
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff _ _).mp s.2
    obtain ⟨h, rfl⟩ := hps a
    refine ⟨ren h * MvPolynomial.X (Sum.inr ()) ^ n, ?_⟩
    simp only at hz
    rw [map_mul, map_pow, hev, hφY, ← hz, ← hn, map_pow, mul_assoc, ← mul_pow, hinv, one_pow,
      mul_one]

  have hrel0 : ∀ j, φ (rel j) = 0 := by
    rintro (i | ⟨⟩)
    · show φ (ren (G i)) = 0
      rw [hev]
      have : G i ∈ RingHom.ker p := by rw [hker]; exact Ideal.subset_span ⟨_, rfl⟩
      rw [RingHom.mem_ker.mp this, map_zero]
    · show φ (ren g * MvPolynomial.X (Sum.inr ()) - 1) = 0
      rw [map_sub, map_mul, hev, map_one, hφY, ← hb]
      exact sub_eq_zero.mpr hinv
  set J := Ideal.span (Set.range rel) with hJ
  have hJker : J ≤ RingHom.ker φ :=
    Ideal.span_le.mpr (by rintro _ ⟨j, rfl⟩; exact RingHom.mem_ker.mpr (hrel0 j))
  let π := Ideal.Quotient.mk J
  have hγY : π (ren g) * π (MvPolynomial.X (Sum.inr ())) = 1 := by
    rw [← map_mul, ← map_one π]
    exact Ideal.Quotient.eq.mpr (Ideal.subset_span ⟨Sum.inr (), rfl⟩)
  have hclear : ∀ P : MvPolynomial (Fin m ⊕ Unit) A, ∃ (N : ℕ) (h : MvPolynomial (Fin m) A),
      π (ren g ^ N * P) = π (ren h) := by
    intro P
    refine MvPolynomial.induction_on (motive := fun P => ∃ (N : ℕ) (h : MvPolynomial (Fin m) A),
      π (ren g ^ N * P) = π (ren h)) P ?_ ?_ ?_
    · intro a
      exact ⟨0, MvPolynomial.C a, by rw [pow_zero, one_mul, hrenC]⟩
    · rintro P₁ P₂ ⟨N₁, h₁, e₁⟩ ⟨N₂, h₂, e₂⟩
      refine ⟨N₁ + N₂, g ^ N₂ * h₁ + g ^ N₁ * h₂, ?_⟩
      calc π (ren g ^ (N₁ + N₂) * (P₁ + P₂))
          = π (ren g) ^ N₂ * π (ren g ^ N₁ * P₁) + π (ren g) ^ N₁ * π (ren g ^ N₂ * P₂) := by
            simp only [map_add, map_mul, map_pow]; ring
        _ = _ := by rw [e₁, e₂]; simp only [map_add, map_mul, map_pow]
    · rintro P' n ⟨N, h, e⟩
      rcases n with l | ⟨⟩
      · refine ⟨N, h * MvPolynomial.X l, ?_⟩
        rw [← mul_assoc, map_mul, e, map_mul ren, hrenX, map_mul]
      · refine ⟨N + 1, h, ?_⟩
        calc π (ren g ^ (N + 1) * (P' * MvPolynomial.X (Sum.inr ())))
            = (π (ren g) * π (MvPolynomial.X (Sum.inr ()))) * π (ren g ^ N * P') := by
              simp only [map_mul, map_pow]; ring
          _ = _ := by rw [hγY, one_mul, e]
  have hGJ : ∀ i, ren (G i) ∈ J := fun i => Ideal.subset_span ⟨Sum.inl i, rfl⟩
  have hspanG : Ideal.span (Set.range fun i => F (ι i)) ≤ Ideal.span (Set.range G) := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    obtain ⟨i', rfl⟩ := (Finite.injective_iff_surjective.mp hq1) i
    exact Ideal.subset_span ⟨i', rfl⟩
  have hmapG : Ideal.map ren (Ideal.span (Set.range G)) ≤ J := by
    rw [Ideal.map_span]
    apply Ideal.span_le.mpr
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    exact hGJ i
  have hgF : ∀ j, g * F j ∈ Ideal.span (Set.range G) := by
    intro j
    have h1 := hspanG (hfF j)
    have h2 : g * F j = μ * (f * F j) := by rw [hg]; ring
    rw [h2]
    exact Ideal.mul_mem_left _ μ h1
  have hFJ : ∀ j, ren (F j) ∈ J := by
    intro j
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    have h1 : π (ren (g * F j)) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (hmapG (Ideal.mem_map_of_mem ren (hgF j)))
    calc π (ren (F j)) = π (ren g) * π (MvPolynomial.X (Sum.inr ())) * π (ren (F j)) := by
          rw [hγY, one_mul]
      _ = π (MvPolynomial.X (Sum.inr ())) * π (ren (g * F j)) := by
          rw [map_mul ren, map_mul π]; ring
      _ = 0 := by rw [h1, mul_zero]
  have hmapF : Ideal.map ren (Ideal.span (Set.range F)) ≤ J := by
    rw [Ideal.map_span]
    apply Ideal.span_le.mpr
    rintro _ ⟨_, ⟨j, rfl⟩, rfl⟩
    exact hFJ j
  have hkerJ : ∀ h, p h = 0 → ren h ∈ J := by
    intro h hh
    have hmem : h ∈ Ideal.span (Set.range F) := by rw [← hker]; exact RingHom.mem_ker.mpr hh
    exact hmapF (Ideal.mem_map_of_mem ren hmem)
  have hkerle : RingHom.ker φ ≤ J := by
    intro P hP
    obtain ⟨N, h, e⟩ := hclear P
    have h1 : ren g ^ N * P - ren h ∈ J := Ideal.Quotient.eq.mp e
    have h2 : φ (ren h) = 0 := by
      have h3 := hJker h1
      rw [RingHom.mem_ker, map_sub, map_mul, RingHom.mem_ker.mp hP, mul_zero, zero_sub,
        neg_eq_zero] at h3
      exact h3
    rw [hev] at h2
    obtain ⟨⟨_, M, rfl⟩, hM⟩ :=
      (IsLocalization.map_eq_zero_iff (Submonoid.powers b) (Localization.Away b) (p h)).mp h2
    have h3 : ren (g ^ M * h) ∈ J := hkerJ _ (by rw [map_mul, map_pow, ← hb]; exact hM)
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    calc π P = (π (ren g) * π (MvPolynomial.X (Sum.inr ()))) ^ (N + M) * π P := by
          rw [hγY, one_pow, one_mul]
      _ = π (MvPolynomial.X (Sum.inr ())) ^ (N + M) * π (ren (g ^ M * h)) := by
          rw [map_mul ren, map_pow ren, map_mul π, map_pow π, ← e]
          simp only [map_mul, map_pow]; ring
      _ = 0 := by rw [Ideal.Quotient.eq_zero_iff_mem.mpr h3, mul_zero]
  have hkerEq : Ideal.span (Set.range rel) = RingHom.ker φ := le_antisymm hJker hkerle

  let P₀ : Algebra.Generators A (Localization.Away b) (Fin m ⊕ Unit) :=
    Algebra.Generators.ofSurjective val hsurj
  let P₁ : Algebra.Presentation A (Localization.Away b) (Fin m ⊕ Unit) (Fin (m - 1) ⊕ Unit) :=
    Algebra.Presentation.mk P₀ rel (by rw [Algebra.Generators.ker_eq_ker_aeval_val]; exact hkerEq)
  let P₂ : Algebra.PreSubmersivePresentation A (Localization.Away b) (Fin m ⊕ Unit)
      (Fin (m - 1) ⊕ Unit) :=
    Algebra.PreSubmersivePresentation.mk P₁ (Sum.map q.2 id) (hq2.sumMap Function.injective_id)
  have hpY : ∀ x : MvPolynomial (Fin m) A,
      MvPolynomial.pderiv (Sum.inr () : Fin m ⊕ Unit) (ren x) = 0 := by
    intro x
    apply MvPolynomial.pderiv_eq_zero_of_notMem_vars
    intro hx
    obtain ⟨l, -, hl⟩ := Finset.mem_image.mp (MvPolynomial.vars_rename _ _ hx)
    exact Sum.inl_ne_inr hl
  have h21 : P₂.jacobiMatrix.toBlocks₂₁ = 0 := by
    refine Matrix.ext fun a j => ?_
    rw [Matrix.toBlocks₂₁, Matrix.of_apply, Matrix.zero_apply,
      Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
    exact hpY (G j)
  have h22 : P₂.jacobiMatrix.toBlocks₂₂.det = ren g := by
    rw [Matrix.det_unique, Matrix.toBlocks₂₂, Matrix.of_apply,
      Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
    show MvPolynomial.pderiv (Sum.inr ()) (ren g * MvPolynomial.X (Sum.inr ()) - 1) = ren g
    rw [map_sub, MvPolynomial.pderiv_mul, hpY, zero_mul, zero_add, MvPolynomial.pderiv_X_self,
      mul_one, Derivation.map_one_eq_zero, sub_zero]
  have h11 : P₂.jacobiMatrix.toBlocks₁₁.det = ren μ := by
    have h : P₂.jacobiMatrix.toBlocks₁₁ = ((ren : MvPolynomial (Fin m) A →ₐ[A]
        MvPolynomial (Fin m ⊕ Unit) A).toRingHom.mapMatrix
        (Matrix.of fun i j => MvPolynomial.pderiv (q.2 j) (F (ι (q.1 i))))).transpose := by
      refine Matrix.ext fun a j => ?_
      rw [Matrix.toBlocks₁₁, Matrix.of_apply, Matrix.transpose_apply, RingHom.mapMatrix_apply,
        Matrix.map_apply, Matrix.of_apply, Algebra.PreSubmersivePresentation.jacobiMatrix_apply]
      show MvPolynomial.pderiv (Sum.inl (q.2 a)) (MvPolynomial.rename Sum.inl (F (ι (q.1 j)))) = _
      rw [MvPolynomial.pderiv_rename Sum.inl_injective]
      rfl
    rw [h, Matrix.det_transpose, ← RingHom.map_det, hμ]
    rfl
  have hdet : P₂.jacobiMatrix.det = ren μ * ren g := by
    rw [← Matrix.fromBlocks_toBlocks P₂.jacobiMatrix, h21, Matrix.det_fromBlocks_zero₂₁, h11, h22]
  have hjac : IsUnit P₂.jacobian := by
    rw [Algebra.PreSubmersivePresentation.jacobian_eq_jacobiMatrix_det, hdet]
    show IsUnit (φ (ren μ * ren g))
    rw [map_mul, hev, hev, ← hb]
    have hub : IsUnit (algebraMap B (Localization.Away b) b) :=
      IsLocalization.Away.algebraMap_isUnit b
    have hpg : b = p f * p μ := by rw [hb, hg, map_mul]
    have hub' : IsUnit (algebraMap B (Localization.Away b) (p f * p μ)) := by
      rw [← hpg]; exact hub
    rw [map_mul] at hub'
    exact (isUnit_of_mul_isUnit_right hub').mul hub
  let P₃ : Algebra.SubmersivePresentation A (Localization.Away b) (Fin m ⊕ Unit)
      (Fin (m - 1) ⊕ Unit) := Algebra.SubmersivePresentation.mk P₂ hjac
  refine ⟨⟨Fin m ⊕ Unit, Fin (m - 1) ⊕ Unit, inferInstance, inferInstance, P₃, ?_⟩⟩
  show Nat.card (Fin m ⊕ Unit) - Nat.card (Fin (m - 1) ⊕ Unit) = 1
  rw [Nat.card_sum, Nat.card_sum]
  simp only [Nat.card_eq_fintype_card, Fintype.card_fin, Fintype.card_unit]
  omega

theorem wcpa_dj_sno_rational_point : ∀ (K : Type u) [Field K] [IsAlgClosed K] (m k : ℕ) (G : Fin k → MvPolynomial (Fin m) K) (σ : Fin m → Fin k ⊕ ((Fin (m - 1) → Fin k) × (Fin (m - 1) → Fin m))) (P : Ideal (MvPolynomial (Fin m) K)), P.IsPrime → (∀ i, wcpaLquGen G (σ i) ∈ P) → (Matrix.of fun i l => MvPolynomial.pderiv l (wcpaLquGen G (σ i))).det ∉ P → ∃ c : Fin m → K, P = RingHom.ker (MvPolynomial.eval c) :=
by
  intro K _ _ m k G σ P hP hGen0 hD0
  classical
  have main : ∀ (h : Fin m → MvPolynomial (Fin m) K), (∀ i, h i ∈ P) →
      (Matrix.of fun i l => MvPolynomial.pderiv l (h i)).det ∉ P →
      ∃ c : Fin m → K, P = RingHom.ker (MvPolynomial.eval c) := by
    intro h hGen hD

    have hrad : MvPolynomial.vanishingIdeal K (MvPolynomial.zeroLocus K P) = P := by
      rw [MvPolynomial.vanishingIdeal_zeroLocus_eq_radical, hP.radical]
    obtain ⟨c, hcZ, hcD⟩ : ∃ c ∈ MvPolynomial.zeroLocus K P,
        MvPolynomial.aeval c (Matrix.of fun i l => MvPolynomial.pderiv l (h i)).det ≠ 0 := by
      by_contra hcon
      simp only [not_exists, not_and, not_not] at hcon
      apply hD
      rw [← hrad, MvPolynomial.mem_vanishingIdeal_iff]
      exact hcon
    have hae : ∀ p : MvPolynomial (Fin m) K, MvPolynomial.aeval c p = MvPolynomial.eval c p :=
      fun p => rfl
    rw [hae] at hcD
    have hPc : P ≤ RingHom.ker (MvPolynomial.eval c) := by
      intro p hp
      rw [RingHom.mem_ker, ← hae]
      exact (MvPolynomial.mem_zeroLocus_iff.mp hcZ) p hp
    have hhc : ∀ i, MvPolynomial.eval c (h i) = 0 := fun i => RingHom.mem_ker.mp (hPc (hGen i))

    obtain ⟨M, hM⟩ : ∃ M : Ideal (MvPolynomial (Fin m) K),
        M = Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) := ⟨_, rfl⟩
    have hM2 : M ^ 2 ≤ M := Ideal.pow_le_self two_ne_zero
    have hMker : M ≤ RingHom.ker (MvPolynomial.eval c) := by
      rw [hM, Ideal.span_le]
      rintro _ ⟨l, rfl⟩
      simp
    obtain ⟨Lin, hLin⟩ : ∃ Lin : (Fin m → K) → MvPolynomial (Fin m) K, ∀ w,
        Lin w = ∑ l, MvPolynomial.C (w l) * (MvPolynomial.X l - MvPolynomial.C (c l)) :=
      ⟨_, fun _ => rfl⟩
    have hLadd : ∀ v w, Lin (v + w) = Lin v + Lin w := by
      intro v w
      simp only [hLin, Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
    have hLsmul : ∀ (a : K) (v : Fin m → K), Lin (a • v) = MvPolynomial.C a * Lin v := by
      intro a v
      simp only [hLin, Pi.smul_apply, smul_eq_mul, map_mul, Finset.mul_sum, mul_assoc]
    have hLmem : ∀ w, Lin w ∈ M := by
      intro w
      rw [hLin, hM]
      exact Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, rfl⟩))
    have taylor : ∀ p : MvPolynomial (Fin m) K,
        p - MvPolynomial.C (MvPolynomial.eval c p) -
          Lin (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p)) ∈ M ^ 2 := by
      have hgradmul : ∀ p q : MvPolynomial (Fin m) K,
          (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (p * q))) =
          MvPolynomial.eval c p • (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l q)) +
          MvPolynomial.eval c q • (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p)) := by
        intro p q
        funext l
        simp only [MvPolynomial.pderiv_mul, map_add, map_mul, Pi.add_apply, Pi.smul_apply,
          smul_eq_mul]
        ring
      have hmul : ∀ p q : MvPolynomial (Fin m) K,
          p - MvPolynomial.C (MvPolynomial.eval c p) -
            Lin (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p)) ∈ M ^ 2 →
          q - MvPolynomial.C (MvPolynomial.eval c q) -
            Lin (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l q)) ∈ M ^ 2 →
          p * q - MvPolynomial.C (MvPolynomial.eval c (p * q)) -
            Lin (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (p * q))) ∈ M ^ 2 := by
        intro p q hp hq
        have hp1 : p - MvPolynomial.C (MvPolynomial.eval c p) ∈ M := by
          have := Ideal.add_mem _ (hM2 hp)
            (hLmem (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p)))
          simpa using this
        have hq1 : q - MvPolynomial.C (MvPolynomial.eval c q) ∈ M := by
          have := Ideal.add_mem _ (hM2 hq)
            (hLmem (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l q)))
          simpa using this
        have e : p * q - MvPolynomial.C (MvPolynomial.eval c (p * q)) -
            Lin (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (p * q))) =
            MvPolynomial.C (MvPolynomial.eval c p) * (q - MvPolynomial.C (MvPolynomial.eval c q) -
              Lin (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l q))) +
            MvPolynomial.C (MvPolynomial.eval c q) * (p - MvPolynomial.C (MvPolynomial.eval c p) -
              Lin (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p))) +
            (p - MvPolynomial.C (MvPolynomial.eval c p)) *
              (q - MvPolynomial.C (MvPolynomial.eval c q)) := by
          rw [hgradmul, hLadd, hLsmul, hLsmul, map_mul, map_mul]
          ring
        rw [e]
        refine Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hq)
          (Ideal.mul_mem_left _ _ hp)) ?_
        rw [pow_two]
        exact Ideal.mul_mem_mul hp1 hq1
      intro p
      induction p using MvPolynomial.induction_on with
      | C a =>
        have : (fun l => MvPolynomial.eval c
            (MvPolynomial.pderiv l (MvPolynomial.C a : MvPolynomial (Fin m) K))) = 0 := by
          funext l; simp
        rw [this, hLin]
        simp
      | add p q hp hq =>
        have e : p + q - MvPolynomial.C (MvPolynomial.eval c (p + q)) -
            Lin (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (p + q))) =
            (p - MvPolynomial.C (MvPolynomial.eval c p) -
              Lin (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p))) +
            (q - MvPolynomial.C (MvPolynomial.eval c q) -
              Lin (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l q))) := by
          have : (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (p + q))) =
              (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p)) +
              (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l q)) := by
            funext l; simp
          rw [this, hLadd, map_add, map_add]
          ring
        rw [e]
        exact Ideal.add_mem _ hp hq
      | mul_X p n hp =>
        apply hmul p (MvPolynomial.X n) hp
        have : (fun l => MvPolynomial.eval c
            (MvPolynomial.pderiv l (MvPolynomial.X n : MvPolynomial (Fin m) K))) =
            Pi.single n 1 := by
          funext l
          rw [MvPolynomial.pderiv_X]
          by_cases h : l = n
          · subst h; simp
          · simp [h, Ne.symm h]
        rw [this]
        have e : Lin (Pi.single n (1 : K)) = MvPolynomial.X n - MvPolynomial.C (c n) := by
          rw [hLin]
          rw [Finset.sum_eq_single n]
          · simp
          · intro b _ hb; simp [hb]
          · simp
        rw [e]
        simp

    obtain ⟨Nm, hNm⟩ : ∃ Nm : Matrix (Fin m) (Fin m) K, ∀ i l,
        Nm i l = MvPolynomial.eval c (MvPolynomial.pderiv l (h i)) :=
      ⟨Matrix.of fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (h i)), fun _ _ => rfl⟩
    have hNdet : Nm.det =
        MvPolynomial.eval c (Matrix.of fun i l => MvPolynomial.pderiv l (h i)).det := by
      rw [RingHom.map_det]
      congr 1
      ext i l
      simp [hNm, RingHom.mapMatrix_apply, Matrix.map_apply]
    have hNdet0 : Nm.det ≠ 0 := by rw [hNdet]; exact hcD
    have hAN : Nm⁻¹ * Nm = 1 := Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hNdet0)
    have hT : ∀ i, h i - Lin (fun l => Nm i l) ∈ M ^ 2 := by
      intro i
      have := taylor (h i)
      rw [hhc i, MvPolynomial.C_0, sub_zero] at this
      simp only [hNm]
      exact this
    have hY : ∀ l0, MvPolynomial.X l0 - MvPolynomial.C (c l0) =
        ∑ i, MvPolynomial.C (Nm⁻¹ l0 i) * Lin (fun l => Nm i l) := by
      intro l0
      simp only [hLin, Finset.mul_sum]
      rw [Finset.sum_comm]
      have e : ∀ l, ∑ i, MvPolynomial.C (Nm⁻¹ l0 i) * (MvPolynomial.C (Nm i l) *
          (MvPolynomial.X l - MvPolynomial.C (c l))) =
          MvPolynomial.C ((Nm⁻¹ * Nm) l0 l) * (MvPolynomial.X l - MvPolynomial.C (c l)) := by
        intro l
        rw [Matrix.mul_apply, map_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_mul, mul_assoc]
      rw [Finset.sum_congr rfl (fun l _ => e l), hAN]
      rw [Finset.sum_eq_single l0]
      · simp
      · intro b _ hb
        rw [Matrix.one_apply_ne (Ne.symm hb), MvPolynomial.C_0, zero_mul]
      · simp
    have hMle : M ≤ P ⊔ M ^ 2 := by
      conv_lhs => rw [hM]
      rw [Ideal.span_le]
      rintro _ ⟨l0, rfl⟩
      show MvPolynomial.X l0 - MvPolynomial.C (c l0) ∈ P ⊔ M ^ 2
      rw [hY l0]
      have e : ∑ i, MvPolynomial.C (Nm⁻¹ l0 i) * Lin (fun l => Nm i l) =
          ∑ i, MvPolynomial.C (Nm⁻¹ l0 i) * h i -
            ∑ i, MvPolynomial.C (Nm⁻¹ l0 i) * (h i - Lin (fun l => Nm i l)) := by
        rw [← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl (fun i _ => by ring)
      rw [e]
      refine Ideal.sub_mem _ (Ideal.mem_sup_left ?_) (Ideal.mem_sup_right ?_)
      · exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (hGen i))
      · exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (hT i))

    have hMfg : M.FG := by
      rw [hM]
      exact Submodule.fg_span (Set.finite_range _)
    obtain ⟨r, hr1, hrM⟩ := Submodule.exists_sub_one_mem_and_smul_le_of_fg_of_le_sup hMfg le_rfl
      (by rw [Ideal.smul_eq_mul, ← pow_two]; exact hMle)
    have hrc : MvPolynomial.eval c r = 1 := by
      have h1 := RingHom.mem_ker.mp (hMker hr1)
      rw [map_sub, map_one, sub_eq_zero] at h1
      exact h1
    have hrP : r ∉ P := by
      intro hr
      have h1 := RingHom.mem_ker.mp (hPc hr)
      rw [hrc] at h1
      exact one_ne_zero h1
    have hMP : M ≤ P := by
      intro y hy
      have h1 : r • y ∈ P := hrM (Submodule.smul_mem_pointwise_smul y r M hy)
      rw [smul_eq_mul] at h1
      exact (hP.mem_or_mem h1).resolve_left hrP

    have hkerM : RingHom.ker (MvPolynomial.eval c) ≤ M := by
      intro p hp
      rw [RingHom.mem_ker] at hp
      have h1 := hM2 (taylor p)
      rw [hp, MvPolynomial.C_0, sub_zero] at h1
      have h2 := Ideal.add_mem _ h1
        (hLmem (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p)))
      rwa [sub_add_cancel] at h2
    exact ⟨c, le_antisymm hPc (hkerM.trans hMP)⟩
  exact main (fun i => wcpaLquGen G (σ i)) hGen0 hD0

theorem wcpa_dj_sno_jets_left_kernel : ∀ (K : Type u) [Field K] (m : ℕ) (J : Matrix (Fin (m - 1)) (Fin m) K), (∀ q : Fin (m - 1) → Fin m, (Matrix.of fun i j => J i (q j)).det = 0) → ∃ ν : Fin (m - 1) → K, ν ≠ 0 ∧ Matrix.vecMul ν J = 0 :=
by
  intro K _ m J hmin
  classical
  by_contra hcon
  have hinj : ∀ ν : Fin (m - 1) → K, Matrix.vecMul ν J = 0 → ν = 0 := by
    intro ν hν
    by_contra h0
    exact hcon ⟨ν, h0, hν⟩

  obtain ⟨N, hN⟩ : ∃ N : Matrix (Fin m) (Fin (m - 1)) K, J * N = 1 := by
    have hker : LinearMap.ker (Matrix.toLin' J.transpose) = ⊥ := by
      rw [LinearMap.ker_eq_bot']
      intro v hv
      apply hinj v
      rw [Matrix.toLin'_apply, Matrix.mulVec_transpose] at hv
      exact hv
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective _ hker
    have hQ : LinearMap.toMatrix' g * J.transpose = 1 := by
      have := congrArg LinearMap.toMatrix' hg
      rwa [LinearMap.toMatrix'_comp, LinearMap.toMatrix'_toLin', LinearMap.toMatrix'_id] at this
    refine ⟨(LinearMap.toMatrix' g).transpose, ?_⟩
    have := congrArg Matrix.transpose hQ
    rwa [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.transpose_one] at this

  have key : (J * N).det = ∑ q : Fin (m - 1) → Fin m,
      (∏ j, N (q j) j) * (Matrix.of fun i j => J i (q j)).det := by
    rw [← Matrix.det_transpose]
    have hrow : (J * N).transpose = fun j => ∑ k, N k j • (fun i => J i k) := by
      funext j i
      simp [Matrix.mul_apply, Finset.sum_apply, mul_comm]
    rw [hrow]
    change Matrix.detRowAlternating (fun j => ∑ k, N k j • fun i => J i k) = _
    rw [← AlternatingMap.coe_multilinearMap, MultilinearMap.map_sum]
    refine Finset.sum_congr rfl fun q _ => ?_
    rw [AlternatingMap.coe_multilinearMap, AlternatingMap.map_smul_univ, smul_eq_mul]
    congr 1
    rw [← Matrix.det_transpose]
    rfl
  have h1 : (1 : K) = 0 := by
    rw [← Matrix.det_one (n := Fin (m - 1)) (R := K), ← hN, key]
    exact Finset.sum_eq_zero fun q _ => by rw [hmin q, mul_zero]
  exact one_ne_zero h1

theorem wcpa_dj_sno_jets_corank_two : ∀ (K : Type u) [Field K] (m : ℕ) (J : Matrix (Fin (m - 1)) (Fin m) K) (ν : Fin (m - 1) → K), 2 ≤ m → ν ≠ 0 → Matrix.vecMul ν J = 0 → (∀ ν' : Fin (m - 1) → K, Matrix.vecMul ν' J = 0 → ∃ s : K, ν' = s • ν) → ∃ y1 y2 α β : Fin m → K, J.mulVec y1 = 0 ∧ J.mulVec y2 = 0 ∧ dotProduct α y1 = 1 ∧ dotProduct α y2 = 0 ∧ dotProduct β y1 = 0 ∧ dotProduct β y2 = 1 ∧ (∀ y : Fin m → K, J.mulVec y = 0 → ∃ s1 s2 : K, y = s1 • y1 + s2 • y2) ∧ (∀ v : Fin m → K, dotProduct v y1 = 0 → dotProduct v y2 = 0 → ∃ μ : Fin (m - 1) → K, v = Matrix.vecMul μ J) :=
by
  intro K _ m J ν hm hν hνJ hker
  classical
  have hkerLv : LinearMap.ker J.vecMulLinear = K ∙ ν := by
    ext x
    simp only [LinearMap.mem_ker, Matrix.vecMulLinear_apply, Submodule.mem_span_singleton]
    constructor
    · intro hx
      obtain ⟨s, hs⟩ := hker x hx
      exact ⟨s, hs.symm⟩
    · rintro ⟨a, rfl⟩
      rw [Matrix.smul_vecMul, hνJ, smul_zero]
  have h1 : Module.finrank K (LinearMap.ker J.vecMulLinear) = 1 := by
    rw [hkerLv]; exact finrank_span_singleton hν
  have h2 := LinearMap.finrank_range_add_finrank_ker J.vecMulLinear
  rw [h1, Module.finrank_fin_fun] at h2
  have hrank : Module.finrank K (LinearMap.range J.mulVecLin) =
      Module.finrank K (LinearMap.range J.vecMulLinear) := by
    have := Matrix.rank_transpose J
    rw [Matrix.rank, Matrix.rank, Matrix.mulVecLin_transpose] at this
    exact this.symm
  have h3 := LinearMap.finrank_range_add_finrank_ker J.mulVecLin
  rw [Module.finrank_fin_fun] at h3
  have hkerJ : Module.finrank K (LinearMap.ker J.mulVecLin) = 2 := by omega
  have hW : Module.finrank K (LinearMap.range J.vecMulLinear) + 2 = m := by omega
  let b := Module.finBasisOfFinrankEq K (LinearMap.ker J.mulVecLin) hkerJ
  set y1 : Fin m → K := ((b 0 : LinearMap.ker J.mulVecLin) : Fin m → K) with hy1def
  set y2 : Fin m → K := ((b 1 : LinearMap.ker J.mulVecLin) : Fin m → K) with hy2def
  have hy1 : J.mulVec y1 = 0 := (b 0).2
  have hy2 : J.mulVec y2 = 0 := (b 1).2
  have hind : ∀ s t : K, s • y1 + t • y2 = 0 → s = 0 ∧ t = 0 := by
    intro s t hst
    have hli := b.linearIndependent
    rw [Fintype.linearIndependent_iff] at hli
    have := hli ![s, t] (by
      rw [Fin.sum_univ_two]
      apply Subtype.ext
      simpa using hst)
    exact ⟨by simpa using this 0, by simpa using this 1⟩
  have hspan : ∀ y : Fin m → K, J.mulVec y = 0 → ∃ s1 s2 : K, y = s1 • y1 + s2 • y2 := by
    intro y hy
    have hz : y ∈ LinearMap.ker J.mulVecLin := hy
    refine ⟨b.repr ⟨y, hz⟩ 0, b.repr ⟨y, hz⟩ 1, ?_⟩
    have := b.sum_repr ⟨y, hz⟩
    rw [Fin.sum_univ_two] at this
    have := congrArg Subtype.val this
    simp only [Submodule.coe_add, Submodule.coe_smul] at this
    exact this.symm
  set Y : Matrix (Fin 2) (Fin m) K := Matrix.of ![y1, y2] with hYdef
  have hYmul : ∀ v, Y.mulVec v = ![y1 ⬝ᵥ v, y2 ⬝ᵥ v] := by
    intro v; ext i; fin_cases i <;> rfl
  have hYvec : ∀ x : Fin 2 → K, Matrix.vecMul x Y = x 0 • y1 + x 1 • y2 := by
    intro x; ext j
    simp [Matrix.vecMul, dotProduct, Fin.sum_univ_two, Y]
  have hinjY : LinearMap.ker Y.vecMulLinear = ⊥ := by
    rw [LinearMap.ker_eq_bot']
    intro x hx
    rw [Matrix.vecMulLinear_apply, hYvec] at hx
    obtain ⟨h0, h1⟩ := hind _ _ hx
    ext i; fin_cases i
    · simpa using h0
    · simpa using h1
  have h4 := LinearMap.finrank_range_add_finrank_ker Y.vecMulLinear
  rw [hinjY, finrank_bot, Module.finrank_fin_fun] at h4
  have hrankY : Module.finrank K (LinearMap.range Y.mulVecLin) = 2 := by
    have := Matrix.rank_transpose Y
    rw [Matrix.rank, Matrix.rank, Matrix.mulVecLin_transpose] at this
    omega
  have hsurj : LinearMap.range Y.mulVecLin = ⊤ := by
    apply Submodule.eq_top_of_finrank_eq
    rw [hrankY, Module.finrank_fin_fun]
  have hex : ∀ w : Fin 2 → K, ∃ a : Fin m → K, Y.mulVec a = w := by
    intro w
    have : w ∈ LinearMap.range Y.mulVecLin := by rw [hsurj]; exact Submodule.mem_top
    obtain ⟨a, ha⟩ := this
    exact ⟨a, ha⟩
  obtain ⟨α, hα⟩ := hex ![1, 0]
  obtain ⟨β, hβ⟩ := hex ![0, 1]
  rw [hYmul] at hα hβ
  have hα1 : α ⬝ᵥ y1 = 1 := by
    have := congrFun hα 0; rw [dotProduct_comm]; simpa using this
  have hα2 : α ⬝ᵥ y2 = 0 := by
    have := congrFun hα 1; rw [dotProduct_comm]; simpa using this
  have hβ1 : β ⬝ᵥ y1 = 0 := by
    have := congrFun hβ 0; rw [dotProduct_comm]; simpa using this
  have hβ2 : β ⬝ᵥ y2 = 1 := by
    have := congrFun hβ 1; rw [dotProduct_comm]; simpa using this
  have h5 := LinearMap.finrank_range_add_finrank_ker Y.mulVecLin
  rw [hrankY, Module.finrank_fin_fun] at h5
  have hle : LinearMap.range J.vecMulLinear ≤ LinearMap.ker Y.mulVecLin := by
    rintro v ⟨μ, rfl⟩
    rw [LinearMap.mem_ker, Matrix.mulVecLin_apply, hYmul, Matrix.vecMulLinear_apply,
      dotProduct_comm y1, dotProduct_comm y2, ← Matrix.dotProduct_mulVec,
      ← Matrix.dotProduct_mulVec, hy1, hy2]
    ext i; fin_cases i <;> simp
  have heq : LinearMap.range J.vecMulLinear = LinearMap.ker Y.mulVecLin :=
    Submodule.eq_of_le_of_finrank_eq hle (by omega)
  refine ⟨y1, y2, α, β, hy1, hy2, hα1, hα2, hβ1, hβ2, hspan, ?_⟩
  intro v hv1 hv2
  have hv : v ∈ LinearMap.ker Y.mulVecLin := by
    rw [LinearMap.mem_ker, Matrix.mulVecLin_apply, hYmul, dotProduct_comm y1,
      dotProduct_comm y2, hv1, hv2]
    ext i; fin_cases i <;> rfl
  rw [← heq] at hv
  obtain ⟨μ, hμ⟩ := hv
  exact ⟨μ, by rw [← hμ, Matrix.vecMulLinear_apply]⟩

theorem wcpa_dj_sno_jets_lin_I2 : ∀ (K : Type u) [Field K] (m r : ℕ) (F : Fin r → MvPolynomial (Fin m) K) (c : Fin m → K), (∀ j, MvPolynomial.eval c (F j) = 0) → ∀ w : Fin m → K, wcpaLquLin c w ∈ wcpaLquI F c 2 ↔ ∃ μ : Fin r → K, w = Matrix.vecMul μ (Matrix.of fun j l => MvPolynomial.eval c (MvPolynomial.pderiv l (F j))) :=
by
  intro K _ m r F c hF0
  classical
  obtain ⟨Mc, hMc⟩ : ∃ Mc : Ideal (MvPolynomial (Fin m) K),
      Mc = Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) := ⟨_, rfl⟩
  have hI : wcpaLquI F c 2 = Mc ^ 2 ⊔ Ideal.span (Set.range F) := by rw [hMc]; rfl
  have hgen : ∀ l, MvPolynomial.X l - MvPolynomial.C (c l) ∈ Mc := fun l => by
    rw [hMc]; exact Ideal.subset_span ⟨l, rfl⟩

  have hZ : ∀ a ∈ Mc, MvPolynomial.eval c a = 0 := by
    intro a ha
    have hle : Mc ≤ RingHom.ker (MvPolynomial.eval c) := by
      rw [hMc, Ideal.span_le]
      rintro _ ⟨l, rfl⟩
      simp
    exact hle ha

  have s1 : ∀ (v : Fin m → K) (l : Fin m),
      MvPolynomial.eval c (MvPolynomial.pderiv l (wcpaLquLin c v)) = v l := by
    intro v l
    unfold wcpaLquLin
    rw [map_sum, map_sum]
    simp only [MvPolynomial.pderiv_C_mul, map_sub, MvPolynomial.pderiv_X, MvPolynomial.pderiv_C,
      sub_zero, map_mul, MvPolynomial.eval_C]
    rw [Finset.sum_eq_single l]
    · simp
    · intro k _ hk
      simp [hk]
    · simp

  have s2 : ∀ h ∈ Mc ^ 2, ∀ l, MvPolynomial.eval c (MvPolynomial.pderiv l h) = 0 := by
    intro h hh l
    rw [sq] at hh
    refine Submodule.mul_induction_on hh ?_ ?_
    · intro a ha b hb
      rw [Derivation.leibniz, map_add, smul_eq_mul, smul_eq_mul, map_mul, map_mul, hZ a ha,
        hZ b hb]
      ring
    · intro x y hx hy
      rw [map_add, map_add, hx, hy, add_zero]

  have Hsub : ∀ h : MvPolynomial (Fin m) K, h - MvPolynomial.C (MvPolynomial.eval c h) ∈ Mc := by
    intro h
    induction h using MvPolynomial.induction_on with
    | C a =>
      rw [MvPolynomial.eval_C, sub_self]
      exact zero_mem _
    | add p q hp hq =>
      have e : p + q - MvPolynomial.C (MvPolynomial.eval c (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.eval c p)) +
            (q - MvPolynomial.C (MvPolynomial.eval c q)) := by
        rw [map_add, map_add]; ring
      rw [e]
      exact add_mem hp hq
    | mul_X p k hp =>
      have e : p * MvPolynomial.X k - MvPolynomial.C (MvPolynomial.eval c (p * MvPolynomial.X k)) =
          (p - MvPolynomial.C (MvPolynomial.eval c p)) * MvPolynomial.X k +
            MvPolynomial.C (MvPolynomial.eval c p) * (MvPolynomial.X k - MvPolynomial.C (c k)) := by
        rw [map_mul, MvPolynomial.eval_X, map_mul]; ring
      rw [e]
      exact add_mem (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ (hgen k))
  have Hzero : ∀ h : MvPolynomial (Fin m) K, MvPolynomial.eval c h = 0 → h ∈ Mc := by
    intro h hh
    have := Hsub h
    rwa [hh, map_zero, sub_zero] at this

  have s3 : ∀ h : MvPolynomial (Fin m) K, MvPolynomial.eval c h = 0 →
      ∃ v : Fin m → K, h - wcpaLquLin c v ∈ Mc ^ 2 := by
    intro h hh
    have hm : h ∈ Mc := Hzero h hh
    rw [hMc, Ideal.mem_span_range_iff_exists_fun] at hm
    obtain ⟨p, hp⟩ := hm
    refine ⟨fun l => MvPolynomial.eval c (p l), ?_⟩
    have e : h - wcpaLquLin c (fun l => MvPolynomial.eval c (p l)) =
        ∑ l, (p l - MvPolynomial.C (MvPolynomial.eval c (p l))) *
          (MvPolynomial.X l - MvPolynomial.C (c l)) := by
      rw [← hp]
      unfold wcpaLquLin
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      ring
    rw [e, sq]
    exact Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_mul (Hsub (p l)) (hgen l))

  have s4 : ∀ (p : MvPolynomial (Fin m) K) (j : Fin r) (l : Fin m),
      MvPolynomial.eval c (MvPolynomial.pderiv l (p * F j)) =
        MvPolynomial.eval c p * MvPolynomial.eval c (MvPolynomial.pderiv l (F j)) := by
    intro p j l
    rw [Derivation.leibniz, map_add, smul_eq_mul, smul_eq_mul, map_mul, map_mul, hF0 j, zero_mul,
      add_zero]
  intro w
  rw [hI]
  constructor
  · intro hw
    obtain ⟨e, he, z, hz, hez⟩ := Submodule.mem_sup.mp hw
    rw [Ideal.mem_span_range_iff_exists_fun] at hz
    obtain ⟨p, hp⟩ := hz
    refine ⟨fun j => MvPolynomial.eval c (p j), ?_⟩
    funext l
    rw [← s1 w l, ← hez, ← hp, map_add, map_add, s2 e he l, zero_add, map_sum, map_sum]
    simp only [s4, Matrix.vecMul, dotProduct, Matrix.of_apply]
  · rintro ⟨μ, rfl⟩
    choose v hv using fun j => s3 (F j) (hF0 j)
    have hvJ : ∀ j l, v j l = MvPolynomial.eval c (MvPolynomial.pderiv l (F j)) := by
      intro j l
      have h1 := s2 _ (hv j) l
      rw [map_sub, map_sub, s1, sub_eq_zero] at h1
      exact h1.symm
    have hlin : wcpaLquLin c (Matrix.vecMul μ (Matrix.of fun j l =>
        MvPolynomial.eval c (MvPolynomial.pderiv l (F j)))) =
        ∑ j, MvPolynomial.C (μ j) * wcpaLquLin c (v j) := by
      unfold wcpaLquLin
      simp only [Matrix.vecMul, dotProduct, Matrix.of_apply, map_sum, map_mul, Finset.sum_mul,
        Finset.mul_sum, hvJ]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun l _ => by ring))
    rw [hlin]
    have e : ∑ j, MvPolynomial.C (μ j) * wcpaLquLin c (v j) =
        -(∑ j, MvPolynomial.C (μ j) * (F j - wcpaLquLin c (v j))) +
          ∑ j, MvPolynomial.C (μ j) * F j := by
      simp only [mul_sub, Finset.sum_sub_distrib]
      ring
    rw [e]
    exact Submodule.add_mem_sup
      (neg_mem (Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hv j)))
      (Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩))

theorem wcpa_dj_sno_jets_minor_grad : ∀ (K : Type u) [Field K] (m : ℕ) (G : Fin (m - 1) → MvPolynomial (Fin m) K) (c : Fin m → K) (ν : Fin (m - 1) → K), ν ≠ 0 → Matrix.vecMul ν (Matrix.of fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (G i))) = 0 → ∀ q : (Fin (m - 1) → Fin (m - 1)) × (Fin (m - 1) → Fin m), ∃ y : Fin m → K, (Matrix.of fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (G i))).mulVec y = 0 ∧ ∀ l, MvPolynomial.eval c (MvPolynomial.pderiv l (wcpaLquGen G (Sum.inr q))) = ∑ k, MvPolynomial.eval c (MvPolynomial.pderiv l (MvPolynomial.pderiv k (∑ i, MvPolynomial.C (ν i) * G i))) * y k :=
by
  intro K _ m G c ν hν hνJ q
  classical

  have hcof : ∀ (k : ℕ) (N : Matrix (Fin k) (Fin k) K) (ν : Fin k → K), ν ≠ 0 →
      Matrix.vecMul ν N = 0 → ∃ ζ : Fin k → K, N.mulVec ζ = 0 ∧
        ∀ (i : Fin k) (r : Fin k → K), (N.updateRow i r).det = ν i * dotProduct ζ r := by
    intro k N ν hν hνN
    have hlin : ∀ (P : Matrix (Fin k) (Fin k) K) (i : Fin k) (r : Fin k → K),
        (P.updateRow i r).det = ∑ j, P.transpose.adjugate i j * r j := by
      intro P i r
      rw [← Matrix.cramer_transpose_apply, Matrix.cramer_eq_adjugate_mulVec]
      rfl
    obtain ⟨i₀, hi₀⟩ : ∃ i₀, ν i₀ ≠ 0 := by
      by_contra h
      push_neg at h
      exact hν (funext h)
    have hdet : N.det = 0 := Matrix.exists_vecMul_eq_zero_iff.mp ⟨ν, hν, hνN⟩
    have hkey : ∀ i r, ν i₀ * (N.updateRow i r).det = ν i * (N.updateRow i₀ r).det := by
      intro i r
      by_cases hi : i = i₀
      · rw [hi]
      have hi0 : i₀ ≠ i := Ne.symm hi
      obtain ⟨A, hA⟩ : ∃ A, A = N.updateRow i r := ⟨_, rfl⟩
      have hsum : ∑ x, ν x * (A.updateRow i₀ (N x)).det = 0 := by
        have e : ∀ x, ν x * (A.updateRow i₀ (N x)).det =
            ∑ j, A.transpose.adjugate i₀ j * (ν x * N x j) := by
          intro x
          rw [hlin, Finset.mul_sum]
          exact Finset.sum_congr rfl (fun j _ => by ring)
        rw [Finset.sum_congr rfl (fun x _ => e x), Finset.sum_comm]
        refine Finset.sum_eq_zero (fun j _ => ?_)
        rw [← Finset.mul_sum]
        have h := congrFun hνN j
        simp only [Matrix.vecMul, dotProduct, Pi.zero_apply] at h
        rw [h, mul_zero]
      rw [Fintype.sum_eq_add i₀ i hi0 (fun x hx => by
        rw [Matrix.det_zero_of_row_eq hx.1 (by
          rw [Matrix.updateRow_ne hx.1, Matrix.updateRow_self, hA, Matrix.updateRow_ne hx.2]),
          mul_zero])] at hsum
      have h1 : A.updateRow i₀ (N i₀) = A := by
        have : A i₀ = N i₀ := by rw [hA, Matrix.updateRow_ne hi0]
        rw [← this, Matrix.updateRow_eq_self]
      have h2 : A.updateRow i₀ (N i) = (N.updateRow i₀ r).submatrix (Equiv.swap i i₀) id := by
        ext x j
        rw [Matrix.submatrix_apply, id]
        by_cases hx0 : x = i₀
        · rw [hx0, Matrix.updateRow_self, Equiv.swap_apply_right, Matrix.updateRow_ne hi]
        · by_cases hx1 : x = i
          · rw [hx1, Matrix.updateRow_ne hi, Equiv.swap_apply_left, Matrix.updateRow_self, hA,
              Matrix.updateRow_self]
          · rw [Matrix.updateRow_ne hx0, Equiv.swap_apply_of_ne_of_ne hx1 hx0,
              Matrix.updateRow_ne hx0, hA, Matrix.updateRow_ne hx1]
      rw [h1, h2, Matrix.det_permute, Equiv.Perm.sign_swap hi] at hsum
      rw [← hA]
      simp only [Units.val_neg, Units.val_one, Int.cast_neg, Int.cast_one] at hsum
      linear_combination hsum
    refine ⟨fun j => (ν i₀)⁻¹ * N.transpose.adjugate i₀ j, ?_, ?_⟩
    · have hd : ∀ r, dotProduct (fun j => (ν i₀)⁻¹ * N.transpose.adjugate i₀ j) r =
          (ν i₀)⁻¹ * (N.updateRow i₀ r).det := by
        intro r
        rw [hlin, Finset.mul_sum]
        exact Finset.sum_congr rfl (fun j _ => by ring)
      funext x
      have hz : (N.updateRow i₀ (N x)).det = 0 := by
        by_cases hx : x = i₀
        · rw [hx, Matrix.updateRow_eq_self, hdet]
        · exact Matrix.det_zero_of_row_eq hx (by rw [Matrix.updateRow_ne hx, Matrix.updateRow_self])
      show dotProduct (N x) _ = 0
      rw [dotProduct_comm, hd, hz, mul_zero]
    · intro i r
      apply mul_left_cancel₀ hi₀
      rw [hkey, hlin N i₀ r]
      have : dotProduct (fun j => (ν i₀)⁻¹ * N.transpose.adjugate i₀ j) r =
          (ν i₀)⁻¹ * ∑ j, N.transpose.adjugate i₀ j * r j := by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun j _ => by ring)
      rw [this]
      field_simp

  have hprod : ∀ (l : Fin m) (s : Finset (Fin (m - 1))) (f : Fin (m - 1) → MvPolynomial (Fin m) K),
      MvPolynomial.pderiv l (∏ x ∈ s, f x) =
        ∑ i ∈ s, ∏ x ∈ s, (if x = i then MvPolynomial.pderiv l (f x) else f x) := by
    intro l s f
    induction s using Finset.induction_on with
    | empty => simp
    | insert a s ha ih =>
      rw [Finset.prod_insert ha, Derivation.leibniz, ih, Finset.sum_insert ha, Finset.prod_insert ha,
        if_pos rfl]
      have e1 : ∏ x ∈ s, (if x = a then MvPolynomial.pderiv l (f x) else f x) = ∏ x ∈ s, f x :=
        Finset.prod_congr rfl (fun x hx => if_neg (fun h => ha (by rw [← h]; exact hx)))
      have e2 : ∑ i ∈ s, ∏ x ∈ insert a s, (if x = i then MvPolynomial.pderiv l (f x) else f x)
          = ∑ i ∈ s, f a * ∏ x ∈ s, (if x = i then MvPolynomial.pderiv l (f x) else f x) := by
        refine Finset.sum_congr rfl (fun i hi => ?_)
        rw [Finset.prod_insert ha, if_neg (fun h => ha (by rw [h]; exact hi))]
      rw [e1, e2, smul_eq_mul, smul_eq_mul, Finset.mul_sum]
      ring

  have hjac : ∀ (l : Fin m) (N : Matrix (Fin (m - 1)) (Fin (m - 1)) (MvPolynomial (Fin m) K)),
      MvPolynomial.pderiv l N.det =
        ∑ k, (N.updateRow k (fun j => MvPolynomial.pderiv l (N k j))).det := by
    intro l N
    have hT : ∀ P : Matrix (Fin (m - 1)) (Fin (m - 1)) (MvPolynomial (Fin m) K),
        P.det = ∑ σ : Equiv.Perm (Fin (m - 1)), Equiv.Perm.sign σ • ∏ i, P i (σ i) := by
      intro P
      rw [← Matrix.det_transpose, Matrix.det_apply]
      rfl
    simp only [hT, map_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun σ _ => ?_)
    rw [Units.smul_def, map_zsmul, hprod, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [Units.smul_def]
    congr 1
    refine Finset.prod_congr rfl (fun i _ => ?_)
    by_cases h : i = k
    · subst h
      simp
    · simp [h]

  have hH : ∀ l k, MvPolynomial.eval c (MvPolynomial.pderiv l (MvPolynomial.pderiv k
      (∑ i, MvPolynomial.C (ν i) * G i))) =
      ∑ i, ν i * MvPolynomial.eval c (MvPolynomial.pderiv l (MvPolynomial.pderiv k (G i))) := by
    intro l k
    simp only [map_sum, MvPolynomial.pderiv_C_mul, map_mul, MvPolynomial.eval_C]
  obtain ⟨q1, q2⟩ := q
  obtain ⟨M, hM⟩ : ∃ M : Matrix (Fin (m - 1)) (Fin (m - 1)) (MvPolynomial (Fin m) K),
      M = Matrix.of fun i j => MvPolynomial.pderiv (q2 j) (G (q1 i)) := ⟨_, rfl⟩
  have hgen : wcpaLquGen G (Sum.inr (q1, q2)) = M.det := by rw [hM]; rfl
  simp only [hgen]
  by_cases hinj : Function.Injective q1
  swap
  · obtain ⟨i, i', heq, hne⟩ : ∃ i i', q1 i = q1 i' ∧ i ≠ i' := by
      simp only [Function.Injective, not_forall] at hinj
      obtain ⟨i, i', h1, h2⟩ := hinj
      exact ⟨i, i', h1, h2⟩
    have h0 : M.det = 0 := Matrix.det_zero_of_row_eq hne (by
      rw [hM]; funext j; simp only [Matrix.of_apply, heq])
    refine ⟨0, Matrix.mulVec_zero _, fun l => ?_⟩
    rw [h0, map_zero, map_zero]
    simp
  have hbij : Function.Bijective q1 := ⟨hinj, Finite.injective_iff_surjective.mp hinj⟩
  have hν' : (fun k => ν (q1 k)) ≠ 0 := by
    intro h
    apply hν
    funext x
    obtain ⟨k, rfl⟩ := hbij.2 x
    exact congrFun h k
  have hν'N : Matrix.vecMul (fun k => ν (q1 k))
      (Matrix.of fun k j => MvPolynomial.eval c (MvPolynomial.pderiv (q2 j) (G (q1 k)))) = 0 := by
    funext j
    show ∑ k, ν (q1 k) * MvPolynomial.eval c (MvPolynomial.pderiv (q2 j) (G (q1 k))) = 0
    rw [Fintype.sum_bijective q1 hbij _
      (fun x => ν x * MvPolynomial.eval c (MvPolynomial.pderiv (q2 j) (G x))) (fun _ => rfl)]
    exact congrFun hνJ (q2 j)
  obtain ⟨ζ, hζ1, hζ2⟩ := hcof (m - 1) _ _ hν' hν'N
  have hfib : ∀ φ : Fin m → K, ∑ l', φ l' * (∑ j, if q2 j = l' then ζ j else 0) =
      ∑ j, φ (q2 j) * ζ j := by
    intro φ
    simp only [Finset.mul_sum, mul_ite, mul_zero]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [Finset.sum_ite_eq]
    simp
  refine ⟨fun l' => ∑ j, if q2 j = l' then ζ j else 0, ?_, ?_⟩
  · funext i
    obtain ⟨k, rfl⟩ := hbij.2 i
    show ∑ l', MvPolynomial.eval c (MvPolynomial.pderiv l' (G (q1 k))) *
      (∑ j, if q2 j = l' then ζ j else 0) = 0
    rw [hfib (fun l' => MvPolynomial.eval c (MvPolynomial.pderiv l' (G (q1 k))))]
    exact congrFun hζ1 k
  · intro l
    rw [hjac l M, map_sum]
    have e1 : ∀ k, MvPolynomial.eval c
        ((M.updateRow k (fun j => MvPolynomial.pderiv l (M k j))).det) =
        ((Matrix.of fun k j => MvPolynomial.eval c (MvPolynomial.pderiv (q2 j) (G (q1 k)))).updateRow
          k (fun j => MvPolynomial.eval c (MvPolynomial.pderiv l
            (MvPolynomial.pderiv (q2 j) (G (q1 k)))))).det := by
      intro k
      rw [RingHom.map_det]
      congr 1
      ext x j
      rw [RingHom.mapMatrix_apply, Matrix.map_apply]
      by_cases hx : x = k
      · rw [hx, Matrix.updateRow_self, Matrix.updateRow_self, hM]
        rfl
      · rw [Matrix.updateRow_ne hx, Matrix.updateRow_ne hx, hM]
        rfl
    rw [Finset.sum_congr rfl (fun k _ => e1 k), Finset.sum_congr rfl (fun k _ => hζ2 k _)]
    simp only [hH]
    rw [hfib (fun l' => ∑ i, ν i * MvPolynomial.eval c (MvPolynomial.pderiv l
      (MvPolynomial.pderiv l' (G i))))]
    rw [Fintype.sum_bijective q1 hbij _ (fun i => ν i * dotProduct ζ (fun j =>
      MvPolynomial.eval c (MvPolynomial.pderiv l (MvPolynomial.pderiv (q2 j) (G i)))))
      (fun _ => rfl)]
    simp only [dotProduct, Finset.mul_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => by ring))

theorem wcpa_dj_sno_jets_minor_grad_zero : ∀ (K : Type u) [Field K] (m : ℕ) (G : Fin (m - 1) → MvPolynomial (Fin m) K) (c : Fin m → K) (ν ν' : Fin (m - 1) → K), Matrix.vecMul ν (Matrix.of fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (G i))) = 0 → Matrix.vecMul ν' (Matrix.of fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (G i))) = 0 → (∀ s t : K, s • ν + t • ν' = 0 → s = 0 ∧ t = 0) → ∀ (q : (Fin (m - 1) → Fin (m - 1)) × (Fin (m - 1) → Fin m)) (l : Fin m), MvPolynomial.eval c (MvPolynomial.pderiv l (wcpaLquGen G (Sum.inr q))) = 0 :=
by
  intro K _ m G c ν ν' hν hν' hind q l
  classical
  obtain ⟨q1, q2⟩ := q
  obtain ⟨M, hM⟩ : ∃ M : Matrix (Fin (m - 1)) (Fin (m - 1)) (MvPolynomial (Fin m) K),
      M = Matrix.of fun i j => MvPolynomial.pderiv (q2 j) (G (q1 i)) := ⟨_, rfl⟩
  have hgen : wcpaLquGen G (Sum.inr (q1, q2)) = M.det := by rw [hM]; rfl
  rw [hgen]
  by_cases hinj : Function.Injective q1
  swap
  · obtain ⟨i, i', heq, hne⟩ : ∃ i i', q1 i = q1 i' ∧ i ≠ i' := by
      simp only [Function.Injective, not_forall] at hinj
      obtain ⟨i, i', h1, h2⟩ := hinj
      exact ⟨i, i', h1, h2⟩
    have h0 : M.det = 0 := Matrix.det_zero_of_row_eq hne (by
      rw [hM]; funext j; simp only [Matrix.of_apply, heq])
    rw [h0, map_zero, map_zero]
  have hbij : Function.Bijective q1 := ⟨hinj, Finite.injective_iff_surjective.mp hinj⟩

  have hprod : ∀ (s : Finset (Fin (m - 1))) (f : Fin (m - 1) → MvPolynomial (Fin m) K),
      MvPolynomial.pderiv l (∏ x ∈ s, f x) =
        ∑ i ∈ s, ∏ x ∈ s, (if x = i then MvPolynomial.pderiv l (f x) else f x) := by
    intro s f
    induction s using Finset.induction_on with
    | empty => simp
    | insert a s ha ih =>
      rw [Finset.prod_insert ha, Derivation.leibniz, ih, Finset.sum_insert ha, Finset.prod_insert ha,
        if_pos rfl]
      have e1 : ∏ x ∈ s, (if x = a then MvPolynomial.pderiv l (f x) else f x) = ∏ x ∈ s, f x :=
        Finset.prod_congr rfl (fun x hx => if_neg (fun h => ha (by rw [← h]; exact hx)))
      have e2 : ∑ i ∈ s, ∏ x ∈ insert a s, (if x = i then MvPolynomial.pderiv l (f x) else f x)
          = ∑ i ∈ s, f a * ∏ x ∈ s, (if x = i then MvPolynomial.pderiv l (f x) else f x) := by
        refine Finset.sum_congr rfl (fun i hi => ?_)
        rw [Finset.prod_insert ha, if_neg (fun h => ha (by rw [h]; exact hi))]
      rw [e1, e2, smul_eq_mul, smul_eq_mul, Finset.mul_sum]
      ring

  have hjac : ∀ N : Matrix (Fin (m - 1)) (Fin (m - 1)) (MvPolynomial (Fin m) K),
      MvPolynomial.pderiv l N.det =
        ∑ k, (N.updateRow k (fun j => MvPolynomial.pderiv l (N k j))).det := by
    intro N
    have hT : ∀ P : Matrix (Fin (m - 1)) (Fin (m - 1)) (MvPolynomial (Fin m) K),
        P.det = ∑ σ : Equiv.Perm (Fin (m - 1)), Equiv.Perm.sign σ • ∏ i, P i (σ i) := by
      intro P
      rw [← Matrix.det_transpose, Matrix.det_apply]
      rfl
    simp only [hT, map_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun σ _ => ?_)
    rw [Units.smul_def, map_zsmul, hprod, Finset.smul_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [Units.smul_def]
    congr 1
    refine Finset.prod_congr rfl (fun i _ => ?_)
    by_cases h : i = k
    · subst h
      simp
    · simp [h]
  rw [hjac M, map_sum]
  refine Finset.sum_eq_zero (fun k _ => ?_)
  rw [RingHom.map_det]
  obtain ⟨w, hw0, hwk, hwJ⟩ : ∃ w : Fin (m - 1) → K, w ≠ 0 ∧ w (q1 k) = 0 ∧
      Matrix.vecMul w (Matrix.of fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (G i))) = 0 := by
    by_cases ha : ν (q1 k) = 0
    · refine ⟨ν, ?_, ha, hν⟩
      intro h0
      have := hind 1 0 (by rw [h0]; simp)
      exact one_ne_zero this.1
    · refine ⟨ν' (q1 k) • ν + (-(ν (q1 k))) • ν', ?_, ?_, ?_⟩
      · intro h0
        exact ha (neg_eq_zero.mp (hind _ _ h0).2)
      · simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
        ring
      · rw [Matrix.add_vecMul, Matrix.smul_vecMul, Matrix.smul_vecMul, hν, hν', smul_zero,
          smul_zero, add_zero]
  apply Matrix.exists_vecMul_eq_zero_iff.mp
  refine ⟨fun i => w (q1 i), ?_, ?_⟩
  · intro h0
    apply hw0
    funext x
    obtain ⟨i, rfl⟩ := hbij.2 x
    exact congrFun h0 i
  · funext j
    have e : ∀ i, w (q1 i) * ((MvPolynomial.eval c).mapMatrix
        (M.updateRow k (fun j => MvPolynomial.pderiv l (M k j)))) i j =
        w (q1 i) * MvPolynomial.eval c (MvPolynomial.pderiv (q2 j) (G (q1 i))) := by
      intro i
      by_cases hik : i = k
      · subst hik
        rw [hwk, zero_mul, zero_mul]
      · rw [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.updateRow_ne hik, hM]
        rfl
    show ∑ i, w (q1 i) * ((MvPolynomial.eval c).mapMatrix
        (M.updateRow k (fun j => MvPolynomial.pderiv l (M k j)))) i j = 0
    rw [Finset.sum_congr rfl (fun i _ => e i)]
    rw [Fintype.sum_bijective q1 hbij _
      (fun x => w x * MvPolynomial.eval c (MvPolynomial.pderiv (q2 j) (G x))) (fun _ => rfl)]
    exact congrFun hwJ (q2 j)

theorem wcpa_dj_sno_jets_quad_taylor : ∀ (K : Type u) [Field K] (m : ℕ) (c : Fin m → K) (g : MvPolynomial (Fin m) K), MvPolynomial.eval c g = 0 → (∀ l, MvPolynomial.eval c (MvPolynomial.pderiv l g) = 0) → ∃ B : Fin m → Fin m → K, g - ∑ l, ∑ k, MvPolynomial.C (B l k) * ((MvPolynomial.X l - MvPolynomial.C (c l)) * (MvPolynomial.X k - MvPolynomial.C (c k))) ∈ Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ 3 ∧ ∀ l k, MvPolynomial.eval c (MvPolynomial.pderiv l (MvPolynomial.pderiv k g)) = B l k + B k l :=
by
  intro K _ m c g hg0 hg1
  classical
  obtain ⟨y, hy⟩ : ∃ y : Fin m → MvPolynomial (Fin m) K,
      y = fun l => MvPolynomial.X l - MvPolynomial.C (c l) := ⟨_, rfl⟩
  have hXn : ∀ n, (MvPolynomial.X n : MvPolynomial (Fin m) K) = y n + MvPolynomial.C (c n) := by
    intro n; rw [hy]; ring
  have hyI : ∀ l, y l ∈ Ideal.span (Set.range y) := fun l => Ideal.subset_span ⟨l, rfl⟩
  have hcube : ∀ l k n, y l * y k * y n ∈ Ideal.span (Set.range y) ^ 3 := by
    intro l k n
    rw [pow_succ, pow_two]
    exact Ideal.mul_mem_mul (Ideal.mul_mem_mul (hyI l) (hyI k)) (hyI n)
  have hpX : ∀ (p : MvPolynomial (Fin m) K) (k n : Fin m),
      MvPolynomial.pderiv k (p * MvPolynomial.X n) =
        MvPolynomial.pderiv k p * MvPolynomial.X n + (if k = n then p else 0) := by
    intro p k n
    rw [MvPolynomial.pderiv_mul]
    by_cases h : k = n
    · subst h; simp
    · simp [MvPolynomial.pderiv_X, h, Ne.symm h]
  have key : ∀ p : MvPolynomial (Fin m) K, ∃ (a : K) (L : Fin m → K) (B : Fin m → Fin m → K),
      p - (MvPolynomial.C a + ∑ l, MvPolynomial.C (L l) * y l +
        ∑ l, ∑ k, MvPolynomial.C (B l k) * (y l * y k)) ∈ Ideal.span (Set.range y) ^ 3 ∧
      MvPolynomial.eval c p = a ∧
      (∀ l, MvPolynomial.eval c (MvPolynomial.pderiv l p) = L l) ∧
      (∀ l k, MvPolynomial.eval c (MvPolynomial.pderiv l (MvPolynomial.pderiv k p)) =
        B l k + B k l) := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a0 =>
      refine ⟨a0, 0, 0, ?_, ?_, ?_, ?_⟩
      · simp
      · simp
      · intro l; simp
      · intro l k; simp
    | add p q hp hq =>
      obtain ⟨a1, L1, B1, h1, h2, h3, h4⟩ := hp
      obtain ⟨a2, L2, B2, h1', h2', h3', h4'⟩ := hq
      refine ⟨a1 + a2, L1 + L2, B1 + B2, ?_, ?_, ?_, ?_⟩
      · have e : p + q - (MvPolynomial.C (a1 + a2) + ∑ l, MvPolynomial.C ((L1 + L2) l) * y l +
            ∑ l, ∑ k, MvPolynomial.C ((B1 + B2) l k) * (y l * y k)) =
            (p - (MvPolynomial.C a1 + ∑ l, MvPolynomial.C (L1 l) * y l +
              ∑ l, ∑ k, MvPolynomial.C (B1 l k) * (y l * y k))) +
            (q - (MvPolynomial.C a2 + ∑ l, MvPolynomial.C (L2 l) * y l +
              ∑ l, ∑ k, MvPolynomial.C (B2 l k) * (y l * y k))) := by
          simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
          ring
        rw [e]
        exact Ideal.add_mem _ h1 h1'
      · rw [map_add, h2, h2']
      · intro l; rw [map_add, map_add, h3, h3']; rfl
      · intro l k; rw [map_add, map_add, map_add, h4, h4']; simp only [Pi.add_apply]; ring
    | mul_X p n hp =>
      obtain ⟨a, L, B, h1, h2, h3, h4⟩ := hp
      refine ⟨c n * a, fun l => c n * L l + if l = n then a else 0,
        fun l k => c n * B l k + if k = n then L l else 0, ?_, ?_, ?_, ?_⟩
      · have E1 : ∑ l, MvPolynomial.C (c n * L l + if l = n then a else 0) * y l =
            MvPolynomial.C (c n) * ∑ l, MvPolynomial.C (L l) * y l +
              MvPolynomial.C a * y n := by
          have t : ∀ l, MvPolynomial.C (c n * L l + if l = n then a else 0) * y l =
              MvPolynomial.C (c n) * (MvPolynomial.C (L l) * y l) +
                (if l = n then MvPolynomial.C a * y n else 0) := by
            intro l
            by_cases h : l = n
            · subst h; simp only [ite_true, map_add, map_mul]; ring
            · simp only [h, ite_false, map_add, map_mul, map_zero]; ring
          rw [Finset.sum_congr rfl (fun l _ => t l), Finset.sum_add_distrib, ← Finset.mul_sum]
          simp
        have E2 : ∑ l, ∑ k, MvPolynomial.C (c n * B l k + if k = n then L l else 0) * (y l * y k) =
            MvPolynomial.C (c n) * ∑ l, ∑ k, MvPolynomial.C (B l k) * (y l * y k) +
              (∑ l, MvPolynomial.C (L l) * y l) * y n := by
          have t : ∀ l k, MvPolynomial.C (c n * B l k + if k = n then L l else 0) * (y l * y k) =
              MvPolynomial.C (c n) * (MvPolynomial.C (B l k) * (y l * y k)) +
                (if k = n then MvPolynomial.C (L l) * y l * y n else 0) := by
            intro l k
            by_cases h : k = n
            · subst h; simp only [ite_true, map_add, map_mul]; ring
            · simp only [h, ite_false, map_add, map_mul, map_zero]; ring
          rw [Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun k _ => t l k))]
          simp only [Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ, ite_true,
            Finset.mul_sum, Finset.sum_mul]
        have E3 : ∑ l, ∑ k, MvPolynomial.C (B l k) * (y l * y k * y n) =
            (∑ l, ∑ k, MvPolynomial.C (B l k) * (y l * y k)) * y n := by
          simp only [Finset.sum_mul]
          exact Finset.sum_congr rfl fun l _ => Finset.sum_congr rfl fun k _ => by ring
        have hmem : p * MvPolynomial.X n - (MvPolynomial.C (c n * a) +
            ∑ l, MvPolynomial.C (c n * L l + if l = n then a else 0) * y l +
            ∑ l, ∑ k, MvPolynomial.C (c n * B l k + if k = n then L l else 0) * (y l * y k)) =
            (p - (MvPolynomial.C a + ∑ l, MvPolynomial.C (L l) * y l +
              ∑ l, ∑ k, MvPolynomial.C (B l k) * (y l * y k))) * MvPolynomial.X n +
            ∑ l, ∑ k, MvPolynomial.C (B l k) * (y l * y k * y n) := by
          rw [E1, E2, E3, hXn n, map_mul]
          ring
        rw [hmem]
        exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ h1)
          (Ideal.sum_mem _ fun l _ => Ideal.sum_mem _ fun k _ =>
            Ideal.mul_mem_left _ _ (hcube l k n))
      · rw [map_mul, MvPolynomial.eval_X, h2, mul_comm]
      · intro k
        rw [hpX, map_add, map_mul, MvPolynomial.eval_X, h3]
        by_cases hk : k = n
        · simp only [hk, ite_true, h2]; ring
        · simp only [hk, ite_false, map_zero]; ring
      · intro l k
        rw [hpX, map_add, hpX]
        by_cases hk : k = n <;> by_cases hl : l = n <;>
          simp [hk, hl, h3, h4] <;> ring
  obtain ⟨a, L, B, h1, h2, h3, h4⟩ := key g
  have ha : a = 0 := h2 ▸ hg0
  have hL : ∀ l, L l = 0 := fun l => (h3 l) ▸ hg1 l
  refine ⟨B, ?_, h4⟩
  have hT : MvPolynomial.C a + ∑ l, MvPolynomial.C (L l) * y l +
      ∑ l, ∑ k, MvPolynomial.C (B l k) * (y l * y k) =
      ∑ l, ∑ k, MvPolynomial.C (B l k) * (y l * y k) := by
    simp [ha, hL]
  rw [hT] at h1
  subst hy
  exact h1

theorem wcpa_dj_sno_jets_rel_I3 : ∀ (K : Type u) [Field K] (m r : ℕ) (F : Fin r → MvPolynomial (Fin m) K) (c y1 y2 α β : Fin m → K) (B : Fin m → Fin m → K), dotProduct α y1 = 1 → dotProduct α y2 = 0 → dotProduct β y1 = 0 → dotProduct β y2 = 1 → (∀ v : Fin m → K, dotProduct v y1 = 0 → dotProduct v y2 = 0 → wcpaLquLin c v ∈ wcpaLquI F c 2) → MvPolynomial.C (∑ l, ∑ k, B l k * y1 l * y1 k) * wcpaLquLin c α ^ 2 + MvPolynomial.C (∑ l, ∑ k, B l k * (y1 l * y2 k + y2 l * y1 k)) * (wcpaLquLin c α * wcpaLquLin c β) + MvPolynomial.C (∑ l, ∑ k, B l k * y2 l * y2 k) * wcpaLquLin c β ^ 2 - ∑ l, ∑ k, MvPolynomial.C (B l k) * ((MvPolynomial.X l - MvPolynomial.C (c l)) * (MvPolynomial.X k - MvPolynomial.C (c k))) ∈ wcpaLquI F c 3 :=
by
  intro K _ m r F c y1 y2 α β B hαy1 hαy2 hβy1 hβy2 hH
  classical

  have hmul : ∀ x e : MvPolynomial (Fin m) K,
      x ∈ Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) →
      e ∈ wcpaLquI F c 2 → x * e ∈ wcpaLquI F c 3 := by
    intro x e hx he
    unfold wcpaLquI at he ⊢
    obtain ⟨u, hu, v, hv, rfl⟩ := Submodule.mem_sup.mp he
    rw [mul_add]
    refine Ideal.add_mem _ (Submodule.mem_sup_left ?_)
      (Submodule.mem_sup_right (Ideal.mul_mem_left _ _ hv))
    show x * u ∈ Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ (2 + 1)
    rw [pow_succ']
    exact Ideal.mul_mem_mul hx hu

  have ht : ∀ l, MvPolynomial.X l - MvPolynomial.C (c l) ∈
      Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) :=
    fun l => Ideal.subset_span ⟨l, rfl⟩
  have hLm : ∀ w : Fin m → K, wcpaLquLin c w ∈
      Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) := by
    intro w
    unfold wcpaLquLin
    exact Ideal.sum_mem _ (fun l _ => by
      first
        | exact Ideal.mul_mem_left _ _ (ht l)
        | exact Ideal.mul_mem_right _ _ (ht l))
  have hY : ∀ l, MvPolynomial.C (y1 l) * wcpaLquLin c α + MvPolynomial.C (y2 l) * wcpaLquLin c β ∈
      Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) := fun l =>
    Ideal.add_mem _ (Ideal.mul_mem_left _ _ (hLm α)) (Ideal.mul_mem_left _ _ (hLm β))

  have hE : ∀ l, (MvPolynomial.X l - MvPolynomial.C (c l)) -
      (MvPolynomial.C (y1 l) * wcpaLquLin c α + MvPolynomial.C (y2 l) * wcpaLquLin c β) ∈
      wcpaLquI F c 2 := by
    intro l
    have key : (MvPolynomial.X l - MvPolynomial.C (c l)) -
        (MvPolynomial.C (y1 l) * wcpaLquLin c α + MvPolynomial.C (y2 l) * wcpaLquLin c β) =
        wcpaLquLin c (Pi.single l 1 - y1 l • α - y2 l • β) := by
      have hsingle : MvPolynomial.X l - MvPolynomial.C (c l) = ∑ j,
          MvPolynomial.C ((Pi.single l (1 : K) : Fin m → K) j) *
            (MvPolynomial.X j - MvPolynomial.C (c j)) := by
        rw [Finset.sum_eq_single l]
        · simp
        · intro j _ hj
          simp [Pi.single_eq_of_ne hj]
        · intro h
          exact absurd (Finset.mem_univ l) h
      rw [hsingle]
      unfold wcpaLquLin
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, map_sub, map_mul]
      ring
    rw [key]
    apply hH
    · simp only [sub_dotProduct, smul_dotProduct, smul_eq_mul, single_dotProduct, hαy1, hβy1]
      ring
    · simp only [sub_dotProduct, smul_dotProduct, smul_eq_mul, single_dotProduct, hαy2, hβy2]
      ring

  have hmem : ∑ l, ∑ k, -(MvPolynomial.C (B l k) *
      ((MvPolynomial.X l - MvPolynomial.C (c l)) *
        ((MvPolynomial.X k - MvPolynomial.C (c k)) -
          (MvPolynomial.C (y1 k) * wcpaLquLin c α + MvPolynomial.C (y2 k) * wcpaLquLin c β)) +
       (MvPolynomial.C (y1 k) * wcpaLquLin c α + MvPolynomial.C (y2 k) * wcpaLquLin c β) *
        ((MvPolynomial.X l - MvPolynomial.C (c l)) -
          (MvPolynomial.C (y1 l) * wcpaLquLin c α + MvPolynomial.C (y2 l) * wcpaLquLin c β))))
      ∈ wcpaLquI F c 3 :=
    Ideal.sum_mem _ (fun l _ => Ideal.sum_mem _ (fun k _ => Submodule.neg_mem _
      (Ideal.mul_mem_left _ _ (Ideal.add_mem _ (hmul _ _ (ht l) (hE k))
        (hmul _ _ (hY k) (hE l))))))

  convert hmem using 1
  simp only [map_sum, map_mul, map_add, Finset.sum_mul, ← Finset.sum_sub_distrib,
    ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun k _ => ?_))
  ring

theorem wcpa_dj_sno_jets_disc : ∀ (K : Type u) [Field K] (m : ℕ) (H D : Matrix (Fin m) (Fin m) K) (B : Fin m → Fin m → K) (y1 y2 α β : Fin m → K), (∀ l k, H l k = B l k + B k l) → dotProduct α y1 = 1 → dotProduct α y2 = 0 → dotProduct β y1 = 0 → dotProduct β y2 = 1 → D.det ≠ 0 → (∀ i, ∃ s1 s2 : K, dotProduct (D i - s1 • H.mulVec y1 - s2 • H.mulVec y2) y1 = 0 ∧ dotProduct (D i - s1 • H.mulVec y1 - s2 • H.mulVec y2) y2 = 0) → (∑ l, ∑ k, B l k * (y1 l * y2 k + y2 l * y1 k)) ^ 2 - 4 * (∑ l, ∑ k, B l k * y1 l * y1 k) * (∑ l, ∑ k, B l k * y2 l * y2 k) ≠ 0 :=
by
  intro K _ m H D B y1 y2 α β hH hα1 hα2 hβ1 hβ2 hD hrow
  classical
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : (Fin m → K) → (Fin m → K) → K,
      ∀ u v, Φ u v = ∑ l, ∑ k, B l k * u l * v k := ⟨_, fun _ _ => rfl⟩
  have gram : ∀ u v : Fin m → K, dotProduct (H.mulVec u) v = Φ v u + Φ u v := by
    intro u v
    have e1 : dotProduct (H.mulVec u) v
        = ∑ l, ∑ k, (B l k * v l * u k + B k l * u k * v l) := by
      simp only [dotProduct, Matrix.mulVec, hH, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun k _ => ?_))
      ring
    have e2 : (∑ l, ∑ k, B k l * u k * v l) = Φ u v := by
      rw [hΦ u v]
      exact Finset.sum_comm
    rw [e1, ← e2, hΦ v u]
    simp only [Finset.sum_add_distrib]
  have ha' : (∑ l, ∑ k, B l k * y1 l * y1 k) = Φ y1 y1 := (hΦ y1 y1).symm
  have hc' : (∑ l, ∑ k, B l k * y2 l * y2 k) = Φ y2 y2 := (hΦ y2 y2).symm
  have hb' : (∑ l, ∑ k, B l k * (y1 l * y2 k + y2 l * y1 k)) = Φ y1 y2 + Φ y2 y1 := by
    rw [hΦ, hΦ, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun k _ => by ring)
  rw [ha', hb', hc']
  have g11 : dotProduct (H.mulVec y1) y1 = Φ y1 y1 + Φ y1 y1 := gram y1 y1
  have g12 : dotProduct (H.mulVec y1) y2 = Φ y2 y1 + Φ y1 y2 := gram y1 y2
  have g21 : dotProduct (H.mulVec y2) y1 = Φ y1 y2 + Φ y2 y1 := gram y2 y1
  have g22 : dotProduct (H.mulVec y2) y2 = Φ y2 y2 + Φ y2 y2 := gram y2 y2
  generalize Φ y1 y1 = a at g11 g12 g21 g22 ⊢
  generalize Φ y2 y2 = c at g11 g12 g21 g22 ⊢
  generalize Φ y1 y2 = p at g11 g12 g21 g22 ⊢
  generalize Φ y2 y1 = q at g11 g12 g21 g22 ⊢
  intro hdisc
  obtain ⟨t1, t2, ht, E1, E2⟩ : ∃ t1 t2 : K, ¬ (t1 = 0 ∧ t2 = 0) ∧
      t1 * (a + a) + t2 * (p + q) = 0 ∧ t1 * (p + q) + t2 * (c + c) = 0 := by
    by_cases hA : p + q ≠ 0 ∨ a + a ≠ 0
    · refine ⟨p + q, -(a + a), ?_, by ring, ?_⟩
      · rintro ⟨h1, h2⟩
        rcases hA with h | h
        · exact h h1
        · exact h (neg_eq_zero.mp h2)
      · linear_combination hdisc
    · push_neg at hA
      obtain ⟨hb0, ha0⟩ := hA
      by_cases hC : c + c ≠ 0
      · refine ⟨c + c, -(p + q), ?_, ?_, by ring⟩
        · rintro ⟨h1, _⟩
          exact hC h1
        · linear_combination -hdisc
      · push_neg at hC
        refine ⟨1, 0, ?_, ?_, ?_⟩
        · rintro ⟨h1, _⟩
          exact one_ne_zero h1
        · rw [ha0]; ring
        · rw [hb0]; ring
  obtain ⟨z, hz⟩ : ∃ z : Fin m → K, z = t1 • y1 + t2 • y2 := ⟨_, rfl⟩
  have hαz : dotProduct α z = t1 := by
    rw [hz, dotProduct_add, dotProduct_smul, dotProduct_smul, smul_eq_mul, smul_eq_mul, hα1, hα2]
    ring
  have hβz : dotProduct β z = t2 := by
    rw [hz, dotProduct_add, dotProduct_smul, dotProduct_smul, smul_eq_mul, smul_eq_mul, hβ1, hβ2]
    ring
  have hz0 : z ≠ 0 := by
    intro h
    rw [h, dotProduct_zero] at hαz hβz
    exact ht ⟨hαz.symm, hβz.symm⟩
  have key : ∀ i, dotProduct (D i) z = 0 := by
    intro i
    obtain ⟨s1, s2, h1, h2⟩ := hrow i
    simp only [sub_dotProduct, smul_dotProduct, smul_eq_mul] at h1 h2
    rw [g11, g21] at h1
    rw [g12, g22] at h2
    rw [hz, dotProduct_add, dotProduct_smul, dotProduct_smul, smul_eq_mul, smul_eq_mul]
    linear_combination t1 * h1 + t2 * h2 + s1 * E1 + s2 * E2
  have hDz : D.mulVec z = 0 := by
    funext i
    exact key i
  exact hD (Matrix.exists_mulVec_eq_zero_iff.mp ⟨z, hz0, hDz⟩)

theorem wcpa_dj_sno_lnc_jets : ∀ (K : Type u) [Field K] (m : ℕ) (G : Fin (m - 1) → MvPolynomial (Fin m) K) (c : Fin m → K) (σ : Fin m → Fin (m - 1) ⊕ ((Fin (m - 1) → Fin (m - 1)) × (Fin (m - 1) → Fin m))), (∀ i, MvPolynomial.eval c (G i) = 0) → (∀ q, MvPolynomial.eval c (wcpaLquGen G (Sum.inr q)) = 0) → (Matrix.of fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (wcpaLquGen G (σ i)))).det ≠ 0 → ∃ α β : Fin m → K, (∀ w : Fin m → K, ∃ a b : K, wcpaLquLin c w - (MvPolynomial.C a * wcpaLquLin c α + MvPolynomial.C b * wcpaLquLin c β) ∈ wcpaLquI G c 2) ∧ (∀ a b : K, MvPolynomial.C a * wcpaLquLin c α + MvPolynomial.C b * wcpaLquLin c β ∈ wcpaLquI G c 2 → a = 0 ∧ b = 0) ∧ ∃ a b c' : K, b ^ 2 - 4 * a * c' ≠ 0 ∧ MvPolynomial.C a * wcpaLquLin c α ^ 2 + MvPolynomial.C b * (wcpaLquLin c α * wcpaLquLin c β) + MvPolynomial.C c' * wcpaLquLin c β ^ 2 ∈ wcpaLquI G c 3 :=
by
  intro K _ m G c σ hG0 hmin hdet
  classical

  obtain ⟨J, hJ⟩ : ∃ J : Matrix (Fin (m - 1)) (Fin m) K,
      J = Matrix.of fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (G i)) := ⟨_, rfl⟩

  have hDinl : ∀ i j, σ i = Sum.inl j →
      (Matrix.of fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (wcpaLquGen G (σ i)))) i
        = J j := by
    intro i j hσ
    funext l
    rw [hJ, Matrix.of_apply, Matrix.of_apply, hσ]
    rfl

  have hminors : ∀ q : Fin (m - 1) → Fin m, (Matrix.of fun i j => J i (q j)).det = 0 := by
    intro q
    have e : (Matrix.of fun i j => J i (q j)) = (MvPolynomial.eval c).mapMatrix
        (Matrix.of fun i j => MvPolynomial.pderiv (q j) (G i)) := by
      ext i j
      rw [hJ]
      rfl
    rw [e, ← RingHom.map_det]
    exact hmin (id, q)
  obtain ⟨ν, hν0, hνJ⟩ := wcpa_dj_sno_jets_left_kernel K m J hminors
  have hm2 : 2 ≤ m := by
    obtain ⟨i, _⟩ := Function.ne_iff.mp hν0
    have := i.isLt
    omega
  have hνJ' : Matrix.vecMul ν
      (Matrix.of fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (G i))) = 0 := by
    rw [← hJ]; exact hνJ

  have hline : ∀ ν' : Fin (m - 1) → K, Matrix.vecMul ν' J = 0 → ∃ s : K, ν' = s • ν := by
    intro ν' hν'
    by_contra hne
    push_neg at hne
    have hind : ∀ s t : K, s • ν + t • ν' = 0 → s = 0 ∧ t = 0 := by
      intro s t hst
      by_cases ht : t = 0
      · subst ht
        rw [zero_smul, add_zero] at hst
        exact ⟨(smul_eq_zero.mp hst).resolve_right hν0, rfl⟩
      · exfalso
        apply hne (-(t⁻¹ * s))
        have h1 : t • ν' = -(s • ν) := eq_neg_of_add_eq_zero_right hst
        calc ν' = t⁻¹ • (t • ν') := by rw [smul_smul, inv_mul_cancel₀ ht, one_smul]
          _ = -(t⁻¹ * s) • ν := by rw [h1, smul_neg, smul_smul, neg_smul]
    have hz := wcpa_dj_sno_jets_minor_grad_zero K m G c ν ν' hνJ' (by rw [← hJ]; exact hν') hind
    have hker : LinearMap.ker (Matrix.mulVecLin J) ≠ ⊥ := by
      apply LinearMap.ker_ne_bot_of_finrank_lt
      simp only [Module.finrank_fin_fun]
      omega
    obtain ⟨y, hy, hy0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hker
    have hJy : J.mulVec y = 0 := hy
    apply hdet
    rw [← Matrix.exists_mulVec_eq_zero_iff]
    refine ⟨y, hy0, ?_⟩
    funext i
    change dotProduct ((Matrix.of fun i l =>
      MvPolynomial.eval c (MvPolynomial.pderiv l (wcpaLquGen G (σ i)))) i) y = 0
    rcases hσ : σ i with j | q
    · rw [hDinl i j hσ]
      exact congrFun hJy j
    · have h0 : (Matrix.of fun i l =>
          MvPolynomial.eval c (MvPolynomial.pderiv l (wcpaLquGen G (σ i)))) i = 0 := by
        funext l
        rw [Matrix.of_apply, hσ]
        exact hz q l
      rw [h0, zero_dotProduct]
  obtain ⟨y1, y2, α, β, hy1, hy2, hαy1, hαy2, hβy1, hβy2, hspan, hrow⟩ :=
    wcpa_dj_sno_jets_corank_two K m J ν hm2 hν0 hνJ hline

  have hI2 : ∀ w : Fin m → K, wcpaLquLin c w ∈ wcpaLquI G c 2 ↔
      ∃ μ : Fin (m - 1) → K, w = Matrix.vecMul μ J := by
    rw [hJ]; exact wcpa_dj_sno_jets_lin_I2 K m (m - 1) G c hG0
  have hLin : ∀ (s t : K) (v v' : Fin m → K), wcpaLquLin c (s • v + t • v') =
      MvPolynomial.C s * wcpaLquLin c v + MvPolynomial.C t * wcpaLquLin c v' := by
    intro s t v v'
    unfold wcpaLquLin
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, map_add, map_mul]
    ring
  have hLinsub : ∀ v v' : Fin m → K, wcpaLquLin c (v - v') = wcpaLquLin c v - wcpaLquLin c v' := by
    intro v v'
    unfold wcpaLquLin
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun l _ => ?_)
    simp only [Pi.sub_apply, map_sub]
    ring
  have hA : ∀ w : Fin m → K, ∃ a b : K, wcpaLquLin c w - (MvPolynomial.C a * wcpaLquLin c α +
      MvPolynomial.C b * wcpaLquLin c β) ∈ wcpaLquI G c 2 := by
    intro w
    refine ⟨dotProduct w y1, dotProduct w y2, ?_⟩
    rw [← hLin, ← hLinsub]
    apply (hI2 _).mpr
    apply hrow
    · simp only [sub_dotProduct, add_dotProduct, smul_dotProduct, smul_eq_mul, hαy1, hβy1]
      ring
    · simp only [sub_dotProduct, add_dotProduct, smul_dotProduct, smul_eq_mul, hαy2, hβy2]
      ring
  have hB : ∀ a b : K, MvPolynomial.C a * wcpaLquLin c α + MvPolynomial.C b * wcpaLquLin c β ∈
      wcpaLquI G c 2 → a = 0 ∧ b = 0 := by
    intro a b hab
    rw [← hLin] at hab
    obtain ⟨μ, hμ⟩ := (hI2 _).mp hab
    have k1 : dotProduct (a • α + b • β) y1 = 0 := by
      rw [hμ, ← Matrix.dotProduct_mulVec, hy1, dotProduct_zero]
    have k2 : dotProduct (a • α + b • β) y2 = 0 := by
      rw [hμ, ← Matrix.dotProduct_mulVec, hy2, dotProduct_zero]
    simp only [add_dotProduct, smul_dotProduct, smul_eq_mul, hαy1, hβy1, hαy2, hβy2] at k1 k2
    constructor
    · simpa using k1
    · simpa using k2

  obtain ⟨g, hg⟩ : ∃ g : MvPolynomial (Fin m) K, g = ∑ i, MvPolynomial.C (ν i) * G i :=
    ⟨_, rfl⟩
  have hgc : MvPolynomial.eval c g = 0 := by
    rw [hg, map_sum]
    refine Finset.sum_eq_zero (fun i _ => ?_)
    rw [map_mul, hG0 i, mul_zero]
  have hgd : ∀ l, MvPolynomial.eval c (MvPolynomial.pderiv l g) = 0 := by
    intro l
    have h := congrFun hνJ l
    rw [hJ] at h
    rw [hg, map_sum, map_sum]
    simp only [MvPolynomial.pderiv_C_mul, map_mul, MvPolynomial.eval_C]
    exact h
  obtain ⟨B, hBg, hBH⟩ := wcpa_dj_sno_jets_quad_taylor K m c g hgc hgd
  have hrel := wcpa_dj_sno_jets_rel_I3 K m (m - 1) G c y1 y2 α β B hαy1 hαy2 hβy1 hβy2
    (fun v h1 h2 => (hI2 v).mpr (hrow v h1 h2))
  have hgQ : g - ∑ l, ∑ k, MvPolynomial.C (B l k) * ((MvPolynomial.X l - MvPolynomial.C (c l)) *
      (MvPolynomial.X k - MvPolynomial.C (c k))) ∈ wcpaLquI G c 3 := by
    unfold wcpaLquI
    exact Submodule.mem_sup_left hBg
  have hgI : g ∈ wcpaLquI G c 3 := by
    unfold wcpaLquI
    apply Submodule.mem_sup_right
    rw [hg]
    refine Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))
  have hrelI := Ideal.add_mem _ (Ideal.sub_mem _ hrel hgQ) hgI

  obtain ⟨H, hH⟩ : ∃ H : Matrix (Fin m) (Fin m) K,
      H = Matrix.of fun l k => MvPolynomial.eval c (MvPolynomial.pderiv l (MvPolynomial.pderiv k g)) :=
    ⟨_, rfl⟩
  have hHB : ∀ l k, H l k = B l k + B k l := by
    intro l k
    rw [hH, Matrix.of_apply]
    exact hBH l k
  have hrows : ∀ i, ∃ s1 s2 : K,
      dotProduct ((Matrix.of fun i l => MvPolynomial.eval c
        (MvPolynomial.pderiv l (wcpaLquGen G (σ i)))) i - s1 • H.mulVec y1 - s2 • H.mulVec y2) y1 = 0 ∧
      dotProduct ((Matrix.of fun i l => MvPolynomial.eval c
        (MvPolynomial.pderiv l (wcpaLquGen G (σ i)))) i - s1 • H.mulVec y1 - s2 • H.mulVec y2) y2 = 0 := by
    intro i
    rcases hσ : σ i with j | q
    · refine ⟨0, 0, ?_, ?_⟩
      · rw [hDinl i j hσ, zero_smul, zero_smul, sub_zero, sub_zero]
        exact congrFun hy1 j
      · rw [hDinl i j hσ, zero_smul, zero_smul, sub_zero, sub_zero]
        exact congrFun hy2 j
    · obtain ⟨yt, hyt, hgr⟩ := wcpa_dj_sno_jets_minor_grad K m G c ν hν0 hνJ' q
      rw [← hJ] at hyt
      obtain ⟨s1, s2, hs⟩ := hspan yt hyt
      have hDi : (Matrix.of fun i l => MvPolynomial.eval c
          (MvPolynomial.pderiv l (wcpaLquGen G (σ i)))) i = H.mulVec yt := by
        funext l
        rw [Matrix.of_apply, hσ, hgr l, ← hg, hH]
        rfl
      have h0 : (Matrix.of fun i l => MvPolynomial.eval c
          (MvPolynomial.pderiv l (wcpaLquGen G (σ i)))) i - s1 • H.mulVec y1 - s2 • H.mulVec y2
          = 0 := by
        rw [hDi, hs, Matrix.mulVec_add, Matrix.mulVec_smul, Matrix.mulVec_smul]
        abel
      refine ⟨s1, s2, ?_, ?_⟩
      · rw [h0, zero_dotProduct]
      · rw [h0, zero_dotProduct]
  have hdisc := wcpa_dj_sno_jets_disc K m H
    (Matrix.of fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (wcpaLquGen G (σ i))))
    B y1 y2 α β hHB hαy1 hαy2 hβy1 hβy2 hdet hrows

  refine ⟨α, β, hA, hB, ∑ l, ∑ k, B l k * y1 l * y1 k,
    ∑ l, ∑ k, B l k * (y1 l * y2 k + y2 l * y1 k), ∑ l, ∑ k, B l k * y2 l * y2 k, hdisc, ?_⟩
  convert hrelI using 1
  ring

theorem wcpa_dj_sno_lnc_hilb_choose : ∀ (K : Type u) [Field K] (m : ℕ) (G : Fin (m - 1) → MvPolynomial (Fin m) K) (c α β : Fin m → K), (∀ i, MvPolynomial.eval c (G i) = 0) → (∀ w : Fin m → K, ∃ a b : K, wcpaLquLin c w - (MvPolynomial.C a * wcpaLquLin c α + MvPolynomial.C b * wcpaLquLin c β) ∈ wcpaLquI G c 2) → (∀ a b : K, MvPolynomial.C a * wcpaLquLin c α + MvPolynomial.C b * wcpaLquLin c β ∈ wcpaLquI G c 2 → a = 0 ∧ b = 0) → ∃ (k : ℕ) (e : Fin k → Fin (m - 1)) (j₀ : Fin (m - 1)) (μ : Fin k → K) (M : Matrix (Fin m) (Fin k ⊕ Fin 2) K), (∀ j, j = j₀ ∨ ∃ i, e i = j) ∧ G j₀ - ∑ i, MvPolynomial.C (μ i) * G (e i) ∈ Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ 2 ∧ ∀ j j' : Fin k ⊕ Fin 2, ∑ l, Sum.elim (fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (G (e i)))) ![α, β] j l * M l j' = if j = j' then 1 else 0 :=
by
  have hLinI2 : ∀ (K : Type u) [Field K] (m r : ℕ) (F : Fin r → MvPolynomial (Fin m) K) (c : Fin m → K), (∀ j, MvPolynomial.eval c (F j) = 0) → ∀ w : Fin m → K, wcpaLquLin c w ∈ wcpaLquI F c 2 ↔ ∃ μ : Fin r → K, w = Matrix.vecMul μ (Matrix.of fun j l => MvPolynomial.eval c (MvPolynomial.pderiv l (F j))) := by
    intro K _ m r F c hF0
    classical
    obtain ⟨Mc, hMc⟩ : ∃ Mc : Ideal (MvPolynomial (Fin m) K),
        Mc = Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) := ⟨_, rfl⟩
    have hI : wcpaLquI F c 2 = Mc ^ 2 ⊔ Ideal.span (Set.range F) := by rw [hMc]; rfl
    have hgen : ∀ l, MvPolynomial.X l - MvPolynomial.C (c l) ∈ Mc := fun l => by
      rw [hMc]; exact Ideal.subset_span ⟨l, rfl⟩

    have hZ : ∀ a ∈ Mc, MvPolynomial.eval c a = 0 := by
      intro a ha
      have hle : Mc ≤ RingHom.ker (MvPolynomial.eval c) := by
        rw [hMc, Ideal.span_le]
        rintro _ ⟨l, rfl⟩
        simp
      exact hle ha

    have s1 : ∀ (v : Fin m → K) (l : Fin m),
        MvPolynomial.eval c (MvPolynomial.pderiv l (wcpaLquLin c v)) = v l := by
      intro v l
      unfold wcpaLquLin
      rw [map_sum, map_sum]
      simp only [MvPolynomial.pderiv_C_mul, map_sub, MvPolynomial.pderiv_X, MvPolynomial.pderiv_C,
        sub_zero, map_mul, MvPolynomial.eval_C]
      rw [Finset.sum_eq_single l]
      · simp
      · intro k _ hk
        simp [hk]
      · simp

    have s2 : ∀ h ∈ Mc ^ 2, ∀ l, MvPolynomial.eval c (MvPolynomial.pderiv l h) = 0 := by
      intro h hh l
      rw [sq] at hh
      refine Submodule.mul_induction_on hh ?_ ?_
      · intro a ha b hb
        rw [Derivation.leibniz, map_add, smul_eq_mul, smul_eq_mul, map_mul, map_mul, hZ a ha,
          hZ b hb]
        ring
      · intro x y hx hy
        rw [map_add, map_add, hx, hy, add_zero]

    have Hsub : ∀ h : MvPolynomial (Fin m) K, h - MvPolynomial.C (MvPolynomial.eval c h) ∈ Mc := by
      intro h
      induction h using MvPolynomial.induction_on with
      | C a =>
        rw [MvPolynomial.eval_C, sub_self]
        exact zero_mem _
      | add p q hp hq =>
        have e : p + q - MvPolynomial.C (MvPolynomial.eval c (p + q)) =
            (p - MvPolynomial.C (MvPolynomial.eval c p)) +
              (q - MvPolynomial.C (MvPolynomial.eval c q)) := by
          rw [map_add, map_add]; ring
        rw [e]
        exact add_mem hp hq
      | mul_X p k hp =>
        have e : p * MvPolynomial.X k - MvPolynomial.C (MvPolynomial.eval c (p * MvPolynomial.X k)) =
            (p - MvPolynomial.C (MvPolynomial.eval c p)) * MvPolynomial.X k +
              MvPolynomial.C (MvPolynomial.eval c p) * (MvPolynomial.X k - MvPolynomial.C (c k)) := by
          rw [map_mul, MvPolynomial.eval_X, map_mul]; ring
        rw [e]
        exact add_mem (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ (hgen k))
    have Hzero : ∀ h : MvPolynomial (Fin m) K, MvPolynomial.eval c h = 0 → h ∈ Mc := by
      intro h hh
      have := Hsub h
      rwa [hh, map_zero, sub_zero] at this

    have s3 : ∀ h : MvPolynomial (Fin m) K, MvPolynomial.eval c h = 0 →
        ∃ v : Fin m → K, h - wcpaLquLin c v ∈ Mc ^ 2 := by
      intro h hh
      have hm : h ∈ Mc := Hzero h hh
      rw [hMc, Ideal.mem_span_range_iff_exists_fun] at hm
      obtain ⟨p, hp⟩ := hm
      refine ⟨fun l => MvPolynomial.eval c (p l), ?_⟩
      have e : h - wcpaLquLin c (fun l => MvPolynomial.eval c (p l)) =
          ∑ l, (p l - MvPolynomial.C (MvPolynomial.eval c (p l))) *
            (MvPolynomial.X l - MvPolynomial.C (c l)) := by
        rw [← hp]
        unfold wcpaLquLin
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun l _ => ?_)
        ring
      rw [e, sq]
      exact Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_mul (Hsub (p l)) (hgen l))

    have s4 : ∀ (p : MvPolynomial (Fin m) K) (j : Fin r) (l : Fin m),
        MvPolynomial.eval c (MvPolynomial.pderiv l (p * F j)) =
          MvPolynomial.eval c p * MvPolynomial.eval c (MvPolynomial.pderiv l (F j)) := by
      intro p j l
      rw [Derivation.leibniz, map_add, smul_eq_mul, smul_eq_mul, map_mul, map_mul, hF0 j, zero_mul,
        add_zero]
    intro w
    rw [hI]
    constructor
    · intro hw
      obtain ⟨e, he, z, hz, hez⟩ := Submodule.mem_sup.mp hw
      rw [Ideal.mem_span_range_iff_exists_fun] at hz
      obtain ⟨p, hp⟩ := hz
      refine ⟨fun j => MvPolynomial.eval c (p j), ?_⟩
      funext l
      rw [← s1 w l, ← hez, ← hp, map_add, map_add, s2 e he l, zero_add, map_sum, map_sum]
      simp only [s4, Matrix.vecMul, dotProduct, Matrix.of_apply]
    · rintro ⟨μ, rfl⟩
      choose v hv using fun j => s3 (F j) (hF0 j)
      have hvJ : ∀ j l, v j l = MvPolynomial.eval c (MvPolynomial.pderiv l (F j)) := by
        intro j l
        have h1 := s2 _ (hv j) l
        rw [map_sub, map_sub, s1, sub_eq_zero] at h1
        exact h1.symm
      have hlin : wcpaLquLin c (Matrix.vecMul μ (Matrix.of fun j l =>
          MvPolynomial.eval c (MvPolynomial.pderiv l (F j)))) =
          ∑ j, MvPolynomial.C (μ j) * wcpaLquLin c (v j) := by
        unfold wcpaLquLin
        simp only [Matrix.vecMul, dotProduct, Matrix.of_apply, map_sum, map_mul, Finset.sum_mul,
          Finset.mul_sum, hvJ]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun j _ => Finset.sum_congr rfl (fun l _ => by ring))
      rw [hlin]
      have e : ∑ j, MvPolynomial.C (μ j) * wcpaLquLin c (v j) =
          -(∑ j, MvPolynomial.C (μ j) * (F j - wcpaLquLin c (v j))) +
            ∑ j, MvPolynomial.C (μ j) * F j := by
        simp only [mul_sub, Finset.sum_sub_distrib]
        ring
      rw [e]
      exact Submodule.add_mem_sup
        (neg_mem (Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (hv j)))
        (Ideal.sum_mem _ fun j _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨j, rfl⟩))
  have hQuadT : ∀ (K : Type u) [Field K] (m : ℕ) (c : Fin m → K) (g : MvPolynomial (Fin m) K), MvPolynomial.eval c g = 0 → (∀ l, MvPolynomial.eval c (MvPolynomial.pderiv l g) = 0) → ∃ B : Fin m → Fin m → K, g - ∑ l, ∑ k, MvPolynomial.C (B l k) * ((MvPolynomial.X l - MvPolynomial.C (c l)) * (MvPolynomial.X k - MvPolynomial.C (c k))) ∈ Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ 3 ∧ ∀ l k, MvPolynomial.eval c (MvPolynomial.pderiv l (MvPolynomial.pderiv k g)) = B l k + B k l := by
    intro K _ m c g hg0 hg1
    classical
    obtain ⟨y, hy⟩ : ∃ y : Fin m → MvPolynomial (Fin m) K,
        y = fun l => MvPolynomial.X l - MvPolynomial.C (c l) := ⟨_, rfl⟩
    have hXn : ∀ n, (MvPolynomial.X n : MvPolynomial (Fin m) K) = y n + MvPolynomial.C (c n) := by
      intro n; rw [hy]; ring
    have hyI : ∀ l, y l ∈ Ideal.span (Set.range y) := fun l => Ideal.subset_span ⟨l, rfl⟩
    have hcube : ∀ l k n, y l * y k * y n ∈ Ideal.span (Set.range y) ^ 3 := by
      intro l k n
      rw [pow_succ, pow_two]
      exact Ideal.mul_mem_mul (Ideal.mul_mem_mul (hyI l) (hyI k)) (hyI n)
    have hpX : ∀ (p : MvPolynomial (Fin m) K) (k n : Fin m),
        MvPolynomial.pderiv k (p * MvPolynomial.X n) =
          MvPolynomial.pderiv k p * MvPolynomial.X n + (if k = n then p else 0) := by
      intro p k n
      rw [MvPolynomial.pderiv_mul]
      by_cases h : k = n
      · subst h; simp
      · simp [MvPolynomial.pderiv_X, h, Ne.symm h]
    have key : ∀ p : MvPolynomial (Fin m) K, ∃ (a : K) (L : Fin m → K) (B : Fin m → Fin m → K),
        p - (MvPolynomial.C a + ∑ l, MvPolynomial.C (L l) * y l +
          ∑ l, ∑ k, MvPolynomial.C (B l k) * (y l * y k)) ∈ Ideal.span (Set.range y) ^ 3 ∧
        MvPolynomial.eval c p = a ∧
        (∀ l, MvPolynomial.eval c (MvPolynomial.pderiv l p) = L l) ∧
        (∀ l k, MvPolynomial.eval c (MvPolynomial.pderiv l (MvPolynomial.pderiv k p)) =
          B l k + B k l) := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a0 =>
        refine ⟨a0, 0, 0, ?_, ?_, ?_, ?_⟩
        · simp
        · simp
        · intro l; simp
        · intro l k; simp
      | add p q hp hq =>
        obtain ⟨a1, L1, B1, h1, h2, h3, h4⟩ := hp
        obtain ⟨a2, L2, B2, h1', h2', h3', h4'⟩ := hq
        refine ⟨a1 + a2, L1 + L2, B1 + B2, ?_, ?_, ?_, ?_⟩
        · have e : p + q - (MvPolynomial.C (a1 + a2) + ∑ l, MvPolynomial.C ((L1 + L2) l) * y l +
              ∑ l, ∑ k, MvPolynomial.C ((B1 + B2) l k) * (y l * y k)) =
              (p - (MvPolynomial.C a1 + ∑ l, MvPolynomial.C (L1 l) * y l +
                ∑ l, ∑ k, MvPolynomial.C (B1 l k) * (y l * y k))) +
              (q - (MvPolynomial.C a2 + ∑ l, MvPolynomial.C (L2 l) * y l +
                ∑ l, ∑ k, MvPolynomial.C (B2 l k) * (y l * y k))) := by
            simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
            ring
          rw [e]
          exact Ideal.add_mem _ h1 h1'
        · rw [map_add, h2, h2']
        · intro l; rw [map_add, map_add, h3, h3']; rfl
        · intro l k; rw [map_add, map_add, map_add, h4, h4']; simp only [Pi.add_apply]; ring
      | mul_X p n hp =>
        obtain ⟨a, L, B, h1, h2, h3, h4⟩ := hp
        refine ⟨c n * a, fun l => c n * L l + if l = n then a else 0,
          fun l k => c n * B l k + if k = n then L l else 0, ?_, ?_, ?_, ?_⟩
        · have E1 : ∑ l, MvPolynomial.C (c n * L l + if l = n then a else 0) * y l =
              MvPolynomial.C (c n) * ∑ l, MvPolynomial.C (L l) * y l +
                MvPolynomial.C a * y n := by
            have t : ∀ l, MvPolynomial.C (c n * L l + if l = n then a else 0) * y l =
                MvPolynomial.C (c n) * (MvPolynomial.C (L l) * y l) +
                  (if l = n then MvPolynomial.C a * y n else 0) := by
              intro l
              by_cases h : l = n
              · subst h; simp only [ite_true, map_add, map_mul]; ring
              · simp only [h, ite_false, map_add, map_mul, map_zero]; ring
            rw [Finset.sum_congr rfl (fun l _ => t l), Finset.sum_add_distrib, ← Finset.mul_sum]
            simp
          have E2 : ∑ l, ∑ k, MvPolynomial.C (c n * B l k + if k = n then L l else 0) * (y l * y k) =
              MvPolynomial.C (c n) * ∑ l, ∑ k, MvPolynomial.C (B l k) * (y l * y k) +
                (∑ l, MvPolynomial.C (L l) * y l) * y n := by
            have t : ∀ l k, MvPolynomial.C (c n * B l k + if k = n then L l else 0) * (y l * y k) =
                MvPolynomial.C (c n) * (MvPolynomial.C (B l k) * (y l * y k)) +
                  (if k = n then MvPolynomial.C (L l) * y l * y n else 0) := by
              intro l k
              by_cases h : k = n
              · subst h; simp only [ite_true, map_add, map_mul]; ring
              · simp only [h, ite_false, map_add, map_mul, map_zero]; ring
            rw [Finset.sum_congr rfl (fun l _ => Finset.sum_congr rfl (fun k _ => t l k))]
            simp only [Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ, ite_true,
              Finset.mul_sum, Finset.sum_mul]
          have E3 : ∑ l, ∑ k, MvPolynomial.C (B l k) * (y l * y k * y n) =
              (∑ l, ∑ k, MvPolynomial.C (B l k) * (y l * y k)) * y n := by
            simp only [Finset.sum_mul]
            exact Finset.sum_congr rfl fun l _ => Finset.sum_congr rfl fun k _ => by ring
          have hmem : p * MvPolynomial.X n - (MvPolynomial.C (c n * a) +
              ∑ l, MvPolynomial.C (c n * L l + if l = n then a else 0) * y l +
              ∑ l, ∑ k, MvPolynomial.C (c n * B l k + if k = n then L l else 0) * (y l * y k)) =
              (p - (MvPolynomial.C a + ∑ l, MvPolynomial.C (L l) * y l +
                ∑ l, ∑ k, MvPolynomial.C (B l k) * (y l * y k))) * MvPolynomial.X n +
              ∑ l, ∑ k, MvPolynomial.C (B l k) * (y l * y k * y n) := by
            rw [E1, E2, E3, hXn n, map_mul]
            ring
          rw [hmem]
          exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ h1)
            (Ideal.sum_mem _ fun l _ => Ideal.sum_mem _ fun k _ =>
              Ideal.mul_mem_left _ _ (hcube l k n))
        · rw [map_mul, MvPolynomial.eval_X, h2, mul_comm]
        · intro k
          rw [hpX, map_add, map_mul, MvPolynomial.eval_X, h3]
          by_cases hk : k = n
          · simp only [hk, ite_true, h2]; ring
          · simp only [hk, ite_false, map_zero]; ring
        · intro l k
          rw [hpX, map_add, hpX]
          by_cases hk : k = n <;> by_cases hl : l = n <;>
            simp [hk, hl, h3, h4] <;> ring
    obtain ⟨a, L, B, h1, h2, h3, h4⟩ := key g
    have ha : a = 0 := h2 ▸ hg0
    have hL : ∀ l, L l = 0 := fun l => (h3 l) ▸ hg1 l
    refine ⟨B, ?_, h4⟩
    have hT : MvPolynomial.C a + ∑ l, MvPolynomial.C (L l) * y l +
        ∑ l, ∑ k, MvPolynomial.C (B l k) * (y l * y k) =
        ∑ l, ∑ k, MvPolynomial.C (B l k) * (y l * y k) := by
      simp [ha, hL]
    rw [hT] at h1
    subst hy
    exact h1
  intro K _ m G c α β hG0 hA hB
  classical

  obtain ⟨J, hJ⟩ : ∃ J : Matrix (Fin (m - 1)) (Fin m) K,
      J = Matrix.of fun j l => MvPolynomial.eval c (MvPolynomial.pderiv l (G j)) := ⟨_, rfl⟩

  have hLin_sub : ∀ v w : Fin m → K,
      wcpaLquLin c (v - w) = wcpaLquLin c v - wcpaLquLin c w := by
    intro v w
    unfold wcpaLquLin
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun l _ => ?_
    simp only [Pi.sub_apply, map_sub]
    ring
  have hLin_comb : ∀ a b : K, wcpaLquLin c (a • α + b • β) =
      MvPolynomial.C a * wcpaLquLin c α + MvPolynomial.C b * wcpaLquLin c β := by
    intro a b
    unfold wcpaLquLin
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun l _ => ?_
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, map_add, map_mul]
    ring

  have hA' : ∀ w : Fin m → K, ∃ (a b : K) (ν : Fin (m - 1) → K),
      w - (a • α + b • β) = Matrix.vecMul ν J := by
    intro w
    obtain ⟨a, b, h⟩ := hA w
    rw [← hLin_comb, ← hLin_sub] at h
    obtain ⟨ν, hν⟩ := (hLinI2 K m (m - 1) G c hG0 _).mp h
    exact ⟨a, b, ν, hJ ▸ hν⟩
  have hB' : ∀ (a b : K) (ν : Fin (m - 1) → K),
      a • α + b • β = Matrix.vecMul ν J → a = 0 ∧ b = 0 := by
    intro a b ν h
    apply hB
    rw [← hLin_comb]
    exact (hLinI2 K m (m - 1) G c hG0 _).mpr ⟨ν, hJ ▸ h⟩

  have hker : ∃ ν : Fin (m - 1) → K, ν ≠ 0 ∧ Matrix.vecMul ν J = 0 := by
    let Φ : ((Fin (m - 1) → K) × (K × K)) →ₗ[K] (Fin m → K) :=
      (Matrix.vecMulLinear J).coprod
        ((LinearMap.smulRight (LinearMap.id : K →ₗ[K] K) α).coprod
          (LinearMap.smulRight (LinearMap.id : K →ₗ[K] K) β))
    have hΦ : ∀ ν a b, Φ (ν, (a, b)) = Matrix.vecMul ν J + (a • α + b • β) := by
      intro ν a b
      simp [Φ]
    have hsurj : Function.Surjective Φ := by
      intro w
      obtain ⟨a, b, ν, h⟩ := hA' w
      refine ⟨(ν, (a, b)), ?_⟩
      rw [hΦ, ← h]
      abel
    have hrn := LinearMap.finrank_range_add_finrank_ker Φ
    rw [LinearMap.range_eq_top.mpr hsurj, finrank_top, Module.finrank_prod, Module.finrank_prod,
      Module.finrank_self] at hrn
    simp only [Module.finrank_fin_fun] at hrn
    have hpos : Module.finrank K (LinearMap.ker Φ) ≠ 0 := by omega
    have hne : LinearMap.ker Φ ≠ ⊥ := fun h => hpos (by rw [h, finrank_bot])
    obtain ⟨⟨ν, a, b⟩, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
    rw [LinearMap.mem_ker, hΦ] at hx
    have hab := hB' (-a) (-b) ν (by
      rw [neg_smul, neg_smul, ← neg_add, eq_comm, ← add_eq_zero_iff_eq_neg]
      exact hx)
    have ha : a = 0 := neg_eq_zero.mp hab.1
    have hb : b = 0 := neg_eq_zero.mp hab.2
    subst ha hb
    refine ⟨ν, fun hν => hx0 ?_, ?_⟩
    · subst hν; rfl
    · simpa using hx

  have pivot : ∀ (r : ℕ) (J' : Matrix (Fin r) (Fin m) K) (ν : Fin r → K), ν ≠ 0 →
      Matrix.vecMul ν J' = 0 → ∃ (k : ℕ) (e : Fin k → Fin r) (j₀ : Fin r) (μ : Fin k → K),
        k + 1 = r ∧ (∀ j, j = j₀ ∨ ∃ i, e i = j) ∧ ∀ l, J' j₀ l = ∑ i, μ i * J' (e i) l := by
    intro r
    cases r with
    | zero =>
      intro J' ν hν _
      exact absurd (funext fun i => Fin.elim0 i) hν
    | succ k =>
      intro J' ν hν hνJ
      obtain ⟨j₀, hj₀⟩ := Function.ne_iff.mp hν
      have hν0 : ν j₀ ≠ 0 := hj₀
      refine ⟨k, j₀.succAbove, j₀, fun i => -ν (j₀.succAbove i) / ν j₀, rfl, ?_, ?_⟩
      · intro j
        by_cases hj : j = j₀
        · exact Or.inl hj
        · exact Or.inr (Fin.exists_succAbove_eq hj)
      · intro l
        have h := congrFun hνJ l
        simp only [Matrix.vecMul, dotProduct, Pi.zero_apply] at h
        rw [Fin.sum_univ_succAbove _ j₀] at h
        have e1 : ∑ i, -ν (j₀.succAbove i) / ν j₀ * J' (j₀.succAbove i) l =
            -(ν j₀)⁻¹ * ∑ i, ν (j₀.succAbove i) * J' (j₀.succAbove i) l := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [div_eq_mul_inv]
          ring
        rw [e1]
        have hinv : ν j₀ * (ν j₀)⁻¹ = 1 := mul_inv_cancel₀ hν0
        linear_combination (ν j₀)⁻¹ * h - J' j₀ l * hinv
  obtain ⟨ν, hν, hνJ⟩ := hker
  obtain ⟨k, e, j₀, μ, hk, hcov, hrel⟩ := pivot (m - 1) J ν hν hνJ

  have hsq : ∀ g : MvPolynomial (Fin m) K, MvPolynomial.eval c g = 0 →
      (∀ l, MvPolynomial.eval c (MvPolynomial.pderiv l g) = 0) →
      g ∈ Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ 2 := by
    intro g h0 h1
    obtain ⟨Bq, hB3, -⟩ := hQuadT K m c g h0 h1
    have hQ : ∑ l, ∑ k, MvPolynomial.C (Bq l k) * ((MvPolynomial.X l - MvPolynomial.C (c l)) *
        (MvPolynomial.X k - MvPolynomial.C (c k))) ∈
        Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ 2 := by
      refine Ideal.sum_mem _ fun l _ => Ideal.sum_mem _ fun k _ => Ideal.mul_mem_left _ _ ?_
      rw [pow_two]
      exact Ideal.mul_mem_mul (Ideal.subset_span ⟨l, rfl⟩) (Ideal.subset_span ⟨k, rfl⟩)
    have h3 := Ideal.pow_le_pow_right (by norm_num : 2 ≤ 3) hB3
    have := Ideal.add_mem _ h3 hQ
    rwa [sub_add_cancel] at this
  have hg' : G j₀ - ∑ i, MvPolynomial.C (μ i) * G (e i) ∈
      Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ 2 := by
    apply hsq
    · simp [hG0]
    · intro l
      simp only [map_sub, map_sum, MvPolynomial.pderiv_C_mul, map_mul, MvPolynomial.eval_C]
      rw [sub_eq_zero]
      have := hrel l
      simpa [hJ] using this

  set R : Fin k ⊕ Fin 2 → Fin m → K := Sum.elim (fun i => J (e i)) ![α, β] with hR
  have hspan : ∀ w : Fin m → K, w ∈ Submodule.span K (Set.range R) := by
    have hei : ∀ i, J (e i) ∈ Submodule.span K (Set.range R) :=
      fun i => Submodule.subset_span ⟨Sum.inl i, rfl⟩
    have hrow : ∀ j, J j ∈ Submodule.span K (Set.range R) := by
      intro j
      rcases hcov j with rfl | ⟨i, rfl⟩
      · have hJj : J j = ∑ i, μ i • J (e i) := by
          funext l
          rw [hrel l, Finset.sum_apply]
          simp [Pi.smul_apply, smul_eq_mul]
        rw [hJj]
        exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (hei i)
      · exact hei i
    have hα : α ∈ Submodule.span K (Set.range R) := Submodule.subset_span ⟨Sum.inr 0, by simp [R]⟩
    have hβ : β ∈ Submodule.span K (Set.range R) := Submodule.subset_span ⟨Sum.inr 1, by simp [R]⟩
    intro w
    obtain ⟨a, b, ν', h⟩ := hA' w
    rw [sub_eq_iff_eq_add', Matrix.vecMul_eq_sum] at h
    rw [h]
    refine Submodule.add_mem _ (Submodule.add_mem _ (Submodule.smul_mem _ _ hα)
      (Submodule.smul_mem _ _ hβ)) (Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ (hrow j))

  let A : Matrix (Fin k ⊕ Fin 2) (Fin m) K := Matrix.of R
  have hinj : Function.Injective A.mulVecLin := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro v hv
    have hv' : ∀ j, R j ⬝ᵥ v = 0 := fun j => congrFun hv j
    have hall : ∀ w ∈ Submodule.span K (Set.range R), w ⬝ᵥ v = 0 := by
      intro w hw
      induction hw using Submodule.span_induction with
      | mem x hx => obtain ⟨j, rfl⟩ := hx; exact hv' j
      | zero => simp
      | add x y _ _ hx hy => rw [add_dotProduct, hx, hy, add_zero]
      | smul a x _ hx => rw [smul_dotProduct, hx, smul_zero]
    funext l
    have := hall (Pi.single l 1) (hspan _)
    simpa [dotProduct, Pi.single_apply] using this
  have hcard : Module.finrank K (Fin m → K) = Module.finrank K (Fin k ⊕ Fin 2 → K) := by
    rw [Module.finrank_fin_fun, Module.finrank_fintype_fun_eq_card, Fintype.card_sum,
      Fintype.card_fin, Fintype.card_fin]
    omega
  have hsurj : Function.Surjective A.mulVecLin :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hcard).mp hinj
  choose x hx using fun j' : Fin k ⊕ Fin 2 => hsurj (Pi.single j' 1)
  refine ⟨k, e, j₀, μ, Matrix.of fun l j' => x j' l, hcov, hg', ?_⟩
  intro j j'
  have h := congrFun (hx j') j
  rw [Matrix.mulVecLin_apply] at h
  have h2 : ∑ l, Sum.elim (fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (G (e i))))
      ![α, β] j l * (Matrix.of fun l j' => x j' l) l j' = (Matrix.mulVec A (x j')) j := by
    simp only [Matrix.mulVec, dotProduct, A, R, hJ, Matrix.of_apply]
    rfl
  rw [h2, h, Pi.single_apply]

theorem wcpa_dj_sno_lnc_hilb_newton : ∀ (K : Type u) [Field K] (m k : ℕ) (H : Fin k → MvPolynomial (Fin m) K) (c α β : Fin m → K) (M : Matrix (Fin m) (Fin k ⊕ Fin 2) K), (∀ i, MvPolynomial.eval c (H i) = 0) → (∀ j j' : Fin k ⊕ Fin 2, ∑ l, Sum.elim (fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (H i))) ![α, β] j l * M l j' = if j = j' then 1 else 0) → ∀ N : ℕ, ∃ ψ : Fin m → MvPolynomial (Fin 2) K, (∀ l, ψ l ∈ Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K))) ∧ ∑ l, MvPolynomial.C (α l) * ψ l = MvPolynomial.X 0 ∧ ∑ l, MvPolynomial.C (β l) * ψ l = MvPolynomial.X 1 ∧ ∀ i, MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l) (H i) ∈ Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ N :=
by
  intro K _ m k H c α β M hH0 hINV
  classical

  have taylor : ∀ (h : MvPolynomial (Fin m) K) (x δ : Fin m → MvPolynomial (Fin 2) K),
      MvPolynomial.aeval (x + δ) h - MvPolynomial.aeval x h -
        ∑ l, MvPolynomial.aeval x (MvPolynomial.pderiv l h) * δ l ∈
        Ideal.span (Set.range δ) ^ 2 := by
    intro h x δ
    have hδ : ∀ n, δ n ∈ Ideal.span (Set.range δ) := fun n => Ideal.subset_span ⟨n, rfl⟩
    induction h using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq =>
      have e : MvPolynomial.aeval (x + δ) (p + q) - MvPolynomial.aeval x (p + q) -
          ∑ l, MvPolynomial.aeval x (MvPolynomial.pderiv l (p + q)) * δ l =
          (MvPolynomial.aeval (x + δ) p - MvPolynomial.aeval x p -
            ∑ l, MvPolynomial.aeval x (MvPolynomial.pderiv l p) * δ l) +
          (MvPolynomial.aeval (x + δ) q - MvPolynomial.aeval x q -
            ∑ l, MvPolynomial.aeval x (MvPolynomial.pderiv l q) * δ l) := by
        simp only [map_add, add_mul, Finset.sum_add_distrib]
        ring
      rw [e]
      exact add_mem hp hq
    | mul_X p n hp =>
      have hterm : ∀ l, MvPolynomial.aeval x (MvPolynomial.pderiv l (p * MvPolynomial.X n)) * δ l =
          x n * (MvPolynomial.aeval x (MvPolynomial.pderiv l p) * δ l) +
            (if n = l then MvPolynomial.aeval x p * δ l else 0) := by
        intro l
        rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X]
        by_cases hl : n = l
        · subst hl
          simp only [Pi.single_eq_same, map_add, map_mul, map_one, MvPolynomial.aeval_X, if_true]
          ring
        · simp only [Pi.single_apply, hl, if_false, map_add, map_mul, map_zero,
            MvPolynomial.aeval_X]
          ring
      have hsum : ∑ l, MvPolynomial.aeval x (MvPolynomial.pderiv l (p * MvPolynomial.X n)) * δ l =
          x n * (∑ l, MvPolynomial.aeval x (MvPolynomial.pderiv l p) * δ l) +
            MvPolynomial.aeval x p * δ n := by
        rw [Finset.sum_congr rfl fun l _ => hterm l, Finset.sum_add_distrib, Finset.mul_sum,
          Finset.sum_ite_eq]
        simp
      have hA : MvPolynomial.aeval (x + δ) (p * MvPolynomial.X n) =
          MvPolynomial.aeval (x + δ) p * (x n + δ n) := by
        rw [map_mul, MvPolynomial.aeval_X, Pi.add_apply]
      have hP : MvPolynomial.aeval x (p * MvPolynomial.X n) = MvPolynomial.aeval x p * x n := by
        rw [map_mul, MvPolynomial.aeval_X]
      rw [hsum, hA, hP]
      have e : MvPolynomial.aeval (x + δ) p * (x n + δ n) - MvPolynomial.aeval x p * x n -
          (x n * (∑ l, MvPolynomial.aeval x (MvPolynomial.pderiv l p) * δ l) +
            MvPolynomial.aeval x p * δ n) =
          (MvPolynomial.aeval (x + δ) p - MvPolynomial.aeval x p -
            ∑ l, MvPolynomial.aeval x (MvPolynomial.pderiv l p) * δ l) * (x n + δ n) +
          (∑ l, MvPolynomial.aeval x (MvPolynomial.pderiv l p) * δ l) * δ n := by
        ring
      rw [e]
      refine add_mem (Ideal.mul_mem_right _ _ hp) ?_
      rw [pow_two]
      refine Ideal.mul_mem_mul ?_ (hδ n)
      exact Ideal.sum_mem _ fun l _ => Ideal.mul_mem_left _ _ (hδ l)

  have const : ∀ (ψ : Fin m → MvPolynomial (Fin 2) K),
      (∀ l, ψ l ∈ Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K))) →
      ∀ h : MvPolynomial (Fin m) K,
        MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l) h -
          MvPolynomial.C (MvPolynomial.eval c h) ∈
          Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) := by
    intro ψ hψ h
    induction h using MvPolynomial.induction_on with
    | C a => simp [MvPolynomial.algebraMap_eq]
    | add p q hp hq =>
      have e : MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l) (p + q) -
          MvPolynomial.C (MvPolynomial.eval c (p + q)) =
          (MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l) p -
            MvPolynomial.C (MvPolynomial.eval c p)) +
          (MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l) q -
            MvPolynomial.C (MvPolynomial.eval c q)) := by
        simp only [map_add]
        ring
      rw [e]
      exact add_mem hp hq
    | mul_X p n hp =>
      have e : MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l) (p * MvPolynomial.X n) -
          MvPolynomial.C (MvPolynomial.eval c (p * MvPolynomial.X n)) =
          (MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l) p -
            MvPolynomial.C (MvPolynomial.eval c p)) * (MvPolynomial.C (c n) + ψ n) +
          MvPolynomial.C (MvPolynomial.eval c p) * ψ n := by
        simp only [map_mul, MvPolynomial.aeval_X, MvPolynomial.eval_X]
        ring
      rw [e]
      exact add_mem (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ (hψ n))

  have hαα : ∑ l, α l * M l (Sum.inr 0) = 1 := by
    have := hINV (Sum.inr 0) (Sum.inr 0)
    simpa using this
  have hαβ : ∑ l, α l * M l (Sum.inr 1) = 0 := by
    have := hINV (Sum.inr 0) (Sum.inr 1)
    simpa using this
  have hβα : ∑ l, β l * M l (Sum.inr 0) = 0 := by
    have := hINV (Sum.inr 1) (Sum.inr 0)
    simpa using this
  have hββ : ∑ l, β l * M l (Sum.inr 1) = 1 := by
    have := hINV (Sum.inr 1) (Sum.inr 1)
    simpa using this
  have hαi : ∀ i, ∑ l, α l * M l (Sum.inl i) = 0 := by
    intro i
    have := hINV (Sum.inr 0) (Sum.inl i)
    simpa using this
  have hβi : ∀ i, ∑ l, β l * M l (Sum.inl i) = 0 := by
    intro i
    have := hINV (Sum.inr 1) (Sum.inl i)
    simpa using this
  have hgi : ∀ i i', ∑ l, MvPolynomial.eval c (MvPolynomial.pderiv l (H i)) * M l (Sum.inl i') =
      if i = i' then 1 else 0 := by
    intro i i'
    have := hINV (Sum.inl i) (Sum.inl i')
    simpa using this

  have swap : ∀ (v : Fin m → K) (E : Fin k → MvPolynomial (Fin 2) K),
      ∑ l, MvPolynomial.C (v l) * ∑ i, MvPolynomial.C (M l (Sum.inl i)) * E i =
        ∑ i, MvPolynomial.C (∑ l, v l * M l (Sum.inl i)) * E i := by
    intro v E
    simp only [Finset.mul_sum, map_sum, Finset.sum_mul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun l _ => ?_
    rw [map_mul]
    ring
  set I : Ideal (MvPolynomial (Fin 2) K) :=
    Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) with hI

  have base : ∃ ψ : Fin m → MvPolynomial (Fin 2) K, (∀ l, ψ l ∈ I) ∧
      ∑ l, MvPolynomial.C (α l) * ψ l = MvPolynomial.X 0 ∧
      ∑ l, MvPolynomial.C (β l) * ψ l = MvPolynomial.X 1 ∧
      ∀ i, MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l) (H i) ∈ I ^ (0 + 1) := by
    obtain ⟨ψ, hψ⟩ : ∃ ψ : Fin m → MvPolynomial (Fin 2) K, ∀ l, ψ l =
        MvPolynomial.C (M l (Sum.inr 0)) * MvPolynomial.X 0 +
          MvPolynomial.C (M l (Sum.inr 1)) * MvPolynomial.X 1 := ⟨_, fun l => rfl⟩
    have hψI : ∀ l, ψ l ∈ I := by
      intro l
      rw [hψ]
      exact add_mem (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨0, rfl⟩))
        (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨1, rfl⟩))
    have e : ∀ v : Fin m → K, ∑ l, MvPolynomial.C (v l) * ψ l =
        MvPolynomial.C (∑ l, v l * M l (Sum.inr 0)) * MvPolynomial.X 0 +
          MvPolynomial.C (∑ l, v l * M l (Sum.inr 1)) * MvPolynomial.X 1 := by
      intro v
      rw [map_sum, map_sum, Finset.sum_mul, Finset.sum_mul, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [hψ, map_mul, map_mul]
      ring
    refine ⟨ψ, hψI, ?_, ?_, ?_⟩
    · rw [e, hαα, hαβ]
      simp
    · rw [e, hβα, hββ]
      simp
    · intro i
      have h1 := const ψ hψI (H i)
      rw [hH0 i, map_zero, sub_zero] at h1
      rw [zero_add, pow_one]
      exact h1

  have step : ∀ (N : ℕ) (ψ : Fin m → MvPolynomial (Fin 2) K), (∀ l, ψ l ∈ I) →
      ∑ l, MvPolynomial.C (α l) * ψ l = MvPolynomial.X 0 →
      ∑ l, MvPolynomial.C (β l) * ψ l = MvPolynomial.X 1 →
      (∀ i, MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l) (H i) ∈ I ^ (N + 1)) →
      ∃ ψ' : Fin m → MvPolynomial (Fin 2) K, (∀ l, ψ' l ∈ I) ∧
        ∑ l, MvPolynomial.C (α l) * ψ' l = MvPolynomial.X 0 ∧
        ∑ l, MvPolynomial.C (β l) * ψ' l = MvPolynomial.X 1 ∧
        ∀ i, MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ' l) (H i) ∈ I ^ (N + 1 + 1) := by
    intro N ψ hψ hα hβ hE
    obtain ⟨δ, hδdef⟩ : ∃ δ : Fin m → MvPolynomial (Fin 2) K, ∀ l, δ l =
        ∑ i, MvPolynomial.C (M l (Sum.inl i)) *
          MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l) (H i) := ⟨_, fun l => rfl⟩
    have hδ : ∀ l, δ l ∈ I ^ (N + 1) := fun l => by
      rw [hδdef]
      exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (hE i)
    have hle1 : I ^ (N + 1) ≤ I := by
      calc I ^ (N + 1) ≤ I ^ 1 := Ideal.pow_le_pow_right (by omega)
        _ = I := pow_one I
    have hlinz : ∀ v : Fin m → K, (∀ i, ∑ l, v l * M l (Sum.inl i) = 0) →
        ∑ l, MvPolynomial.C (v l) * (ψ l - δ l) = ∑ l, MvPolynomial.C (v l) * ψ l := by
      intro v hv
      have h2 : ∑ l, MvPolynomial.C (v l) * δ l = 0 := by
        simp only [hδdef]
        rw [swap]
        exact Finset.sum_eq_zero fun i _ => by rw [hv i, map_zero, zero_mul]
      simp only [mul_sub, Finset.sum_sub_distrib, h2, sub_zero]
    refine ⟨fun l => ψ l - δ l, fun l => sub_mem (hψ l) (hle1 (hδ l)), ?_, ?_, ?_⟩
    · rw [hlinz α hαi, hα]
    · rw [hlinz β hβi, hβ]
    · intro i
      have hxd : (fun l => MvPolynomial.C (c l) + (ψ l - δ l)) =
          (fun l => MvPolynomial.C (c l) + ψ l) + (fun l => -δ l) := by
        funext l
        simp only [Pi.add_apply]
        ring
      show MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + (ψ l - δ l)) (H i) ∈ I ^ (N + 1 + 1)
      rw [hxd]
      have hT := taylor (H i) (fun l => MvPolynomial.C (c l) + ψ l) (fun l => -δ l)
      have hspan : Ideal.span (Set.range (fun l => -δ l)) ^ 2 ≤ I ^ (N + 1 + 1) := by
        have h1 : Ideal.span (Set.range (fun l => -δ l)) ≤ I ^ (N + 1) := by
          rw [Ideal.span_le]
          rintro _ ⟨l, rfl⟩
          exact neg_mem (hδ l)
        calc Ideal.span (Set.range (fun l => -δ l)) ^ 2 ≤ (I ^ (N + 1)) ^ 2 :=
              Ideal.pow_right_mono h1 2
          _ = I ^ ((N + 1) * 2) := (pow_mul I (N + 1) 2).symm
          _ ≤ I ^ (N + 1 + 1) := Ideal.pow_le_pow_right (by omega)
      have hq := hspan hT
      have hlin : ∑ l, MvPolynomial.C (MvPolynomial.eval c (MvPolynomial.pderiv l (H i))) * δ l =
          MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l) (H i) := by
        simp only [hδdef]
        rw [swap]
        rw [Finset.sum_eq_single i]
        · rw [hgi i i, if_pos rfl, map_one, one_mul]
        · intro i' _ hne
          rw [hgi i i', if_neg (Ne.symm hne), map_zero, zero_mul]
        · intro h
          exact absurd (Finset.mem_univ i) h
      have hε : ∀ l, (MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l)
          (MvPolynomial.pderiv l (H i)) -
          MvPolynomial.C (MvPolynomial.eval c (MvPolynomial.pderiv l (H i)))) * δ l ∈
          I ^ (N + 1 + 1) := by
        intro l
        have h1 := const ψ hψ (MvPolynomial.pderiv l (H i))
        have h2 : δ l * (MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l)
            (MvPolynomial.pderiv l (H i)) -
            MvPolynomial.C (MvPolynomial.eval c (MvPolynomial.pderiv l (H i)))) ∈
            I ^ (N + 1) * I := Ideal.mul_mem_mul (hδ l) h1
        rw [← pow_succ] at h2
        rw [mul_comm (δ l)] at h2
        exact h2
      have heq : MvPolynomial.aeval ((fun l => MvPolynomial.C (c l) + ψ l) + (fun l => -δ l)) (H i) =
          (MvPolynomial.aeval ((fun l => MvPolynomial.C (c l) + ψ l) + (fun l => -δ l)) (H i) -
            MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l) (H i) -
            ∑ l, MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l)
              (MvPolynomial.pderiv l (H i)) * (fun l => -δ l) l) -
          ∑ l, (MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l)
              (MvPolynomial.pderiv l (H i)) -
            MvPolynomial.C (MvPolynomial.eval c (MvPolynomial.pderiv l (H i)))) * δ l +
          (MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l) (H i) -
            ∑ l, MvPolynomial.C (MvPolynomial.eval c (MvPolynomial.pderiv l (H i))) * δ l) := by
        simp only [sub_mul, Finset.sum_sub_distrib, mul_neg, Finset.sum_neg_distrib]
        ring
      rw [heq, hlin, sub_self, add_zero]
      exact sub_mem hq (Ideal.sum_mem _ fun l _ => hε l)

  have key : ∀ N : ℕ, ∃ ψ : Fin m → MvPolynomial (Fin 2) K, (∀ l, ψ l ∈ I) ∧
      ∑ l, MvPolynomial.C (α l) * ψ l = MvPolynomial.X 0 ∧
      ∑ l, MvPolynomial.C (β l) * ψ l = MvPolynomial.X 1 ∧
      ∀ i, MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l) (H i) ∈ I ^ (N + 1) := by
    intro N
    induction N with
    | zero => exact base
    | succ N ih =>
      obtain ⟨ψ, h1, h2, h3, h4⟩ := ih
      exact step N ψ h1 h2 h3 h4
  intro N
  obtain ⟨ψ, h1, h2, h3, h4⟩ := key N
  exact ⟨ψ, h1, h2, h3, fun i => Ideal.pow_le_pow_right (Nat.le_succ N) (h4 i)⟩

theorem wcpa_dj_sno_lnc_hilb_span : ∀ (K : Type u) [Field K] (m : ℕ) (G : Fin (m - 1) → MvPolynomial (Fin m) K) (c α β : Fin m → K) (a b c' : K), (∀ i, MvPolynomial.eval c (G i) = 0) → (∀ w : Fin m → K, ∃ a b : K, wcpaLquLin c w - (MvPolynomial.C a * wcpaLquLin c α + MvPolynomial.C b * wcpaLquLin c β) ∈ wcpaLquI G c 2) → (a ≠ 0 ∨ b ≠ 0 ∨ c' ≠ 0) → MvPolynomial.C a * wcpaLquLin c α ^ 2 + MvPolynomial.C b * (wcpaLquLin c α * wcpaLquLin c β) + MvPolynomial.C c' * wcpaLquLin c β ^ 2 ∈ wcpaLquI G c 3 → (∀ x : MvPolynomial (Fin m) K, ∃ μ : K, x - MvPolynomial.C μ ∈ wcpaLquI G c 1) ∧ ∀ k : ℕ, 1 ≤ k → ∃ p p' : MvPolynomial (Fin m) K, ∀ x ∈ wcpaLquI G c k, ∃ μ μ' : K, x - (MvPolynomial.C μ * p + MvPolynomial.C μ' * p') ∈ wcpaLquI G c (k + 1) :=
by
  intro K _ m G c α β a b c' _hG0 hA hne hrel
  classical
  set 𝔪 : Ideal (MvPolynomial (Fin m) K) :=
    Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) with h𝔪
  have memeq : ∀ (n : ℕ) (x y : MvPolynomial (Fin m) K), x = y → y ∈ wcpaLquI G c n →
      x ∈ wcpaLquI G c n := fun n x y h hy => h ▸ hy
  have zmem : ∀ (n : ℕ) (x : MvPolynomial (Fin m) K), x = 0 → x ∈ wcpaLquI G c n :=
    fun n x h => h ▸ Ideal.zero_mem _

  have t0 : ∀ h : MvPolynomial (Fin m) K, h - MvPolynomial.C (MvPolynomial.eval c h) ∈ 𝔪 := by
    intro h
    refine MvPolynomial.induction_on
      (motive := fun h => h - MvPolynomial.C (MvPolynomial.eval c h) ∈ 𝔪) h ?_ ?_ ?_
    · intro r
      simp
    · intro p q hp hq
      have e : p + q - MvPolynomial.C (MvPolynomial.eval c (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.eval c p)) +
            (q - MvPolynomial.C (MvPolynomial.eval c q)) := by
        rw [map_add, MvPolynomial.C_add]; ring
      rw [e]; exact 𝔪.add_mem hp hq
    · intro p n hp
      have e : p * MvPolynomial.X n - MvPolynomial.C (MvPolynomial.eval c (p * MvPolynomial.X n)) =
          (p - MvPolynomial.C (MvPolynomial.eval c p)) * MvPolynomial.X n +
            MvPolynomial.C (MvPolynomial.eval c p) * (MvPolynomial.X n - MvPolynomial.C (c n)) := by
        rw [MvPolynomial.eval_mul, MvPolynomial.eval_X, MvPolynomial.C_mul]; ring
      rw [e]
      exact 𝔪.add_mem (𝔪.mul_mem_right _ hp) (𝔪.mul_mem_left _ (Ideal.subset_span ⟨n, rfl⟩))

  have imul : ∀ (j i : ℕ) (z w : MvPolynomial (Fin m) K), z ∈ wcpaLquI G c j → w ∈ 𝔪 ^ i →
      z * w ∈ wcpaLquI G c (j + i) := by
    intro j i z w hz hw
    have hz' : z ∈ 𝔪 ^ j ⊔ Ideal.span (Set.range G) := hz
    show z * w ∈ 𝔪 ^ (j + i) ⊔ Ideal.span (Set.range G)
    obtain ⟨y, hy, g, hg, rfl⟩ := Submodule.mem_sup.mp hz'
    rw [add_mul]
    refine Ideal.add_mem _ (Ideal.mem_sup_left ?_) (Ideal.mem_sup_right ?_)
    · rw [pow_add]; exact Ideal.mul_mem_mul hy hw
    · exact Ideal.mul_mem_right _ _ hg
  have linmem : ∀ w : Fin m → K, wcpaLquLin c w ∈ 𝔪 := by
    intro w
    unfold wcpaLquLin
    exact Ideal.sum_mem _ fun l _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, rfl⟩)

  have deg1 : ∀ y ∈ 𝔪, ∃ a b : K, y - (MvPolynomial.C a * wcpaLquLin c α +
      MvPolynomial.C b * wcpaLquLin c β) ∈ wcpaLquI G c 2 := by
    intro y hy
    obtain ⟨h, hh⟩ := Ideal.mem_span_range_iff_exists_fun.mp hy
    obtain ⟨a₀, b₀, hab⟩ := hA (fun l => MvPolynomial.eval c (h l))
    refine ⟨a₀, b₀, memeq _ _ _ ?_ (Ideal.add_mem _ (?_ : ∑ l, (h l - MvPolynomial.C
      (MvPolynomial.eval c (h l))) * (MvPolynomial.X l - MvPolynomial.C (c l)) ∈ wcpaLquI G c 2)
      hab)⟩
    · rw [← hh]
      unfold wcpaLquLin
      simp only [sub_mul, Finset.sum_sub_distrib]
      ring
    · show _ ∈ 𝔪 ^ 2 ⊔ Ideal.span (Set.range G)
      refine Ideal.mem_sup_left ?_
      rw [sq]
      exact Ideal.sum_mem _ fun l _ => Ideal.mul_mem_mul (t0 _) (Ideal.subset_span ⟨l, rfl⟩)

  have graded : ∀ (u v : MvPolynomial (Fin m) K) (p p' : ℕ → MvPolynomial (Fin m) K),
      (∀ y ∈ 𝔪, ∃ a b : K, y - (MvPolynomial.C a * u + MvPolynomial.C b * v) ∈ wcpaLquI G c 2) →
      (∀ a₀ b₀ : K, ∃ ν ν' : K, MvPolynomial.C a₀ * u + MvPolynomial.C b₀ * v =
        MvPolynomial.C ν * p 1 + MvPolynomial.C ν' * p' 1) →
      (∀ k : ℕ, 1 ≤ k → p k ∈ 𝔪 ^ k ∧ p' k ∈ 𝔪 ^ k) →
      (∀ k : ℕ, 1 ≤ k → ∃ ν ν' : K, p k * u - (MvPolynomial.C ν * p (k + 1) +
        MvPolynomial.C ν' * p' (k + 1)) ∈ wcpaLquI G c (k + 2)) →
      (∀ k : ℕ, 1 ≤ k → ∃ ν ν' : K, p k * v - (MvPolynomial.C ν * p (k + 1) +
        MvPolynomial.C ν' * p' (k + 1)) ∈ wcpaLquI G c (k + 2)) →
      (∀ k : ℕ, 1 ≤ k → ∃ ν ν' : K, p' k * u - (MvPolynomial.C ν * p (k + 1) +
        MvPolynomial.C ν' * p' (k + 1)) ∈ wcpaLquI G c (k + 2)) →
      (∀ k : ℕ, 1 ≤ k → ∃ ν ν' : K, p' k * v - (MvPolynomial.C ν * p (k + 1) +
        MvPolynomial.C ν' * p' (k + 1)) ∈ wcpaLquI G c (k + 2)) →
      ∀ k : ℕ, 1 ≤ k → ∀ x ∈ wcpaLquI G c k, ∃ μ μ' : K,
        x - (MvPolynomial.C μ * p k + MvPolynomial.C μ' * p' k) ∈ wcpaLquI G c (k + 1) := by
    intro u v p p' hdeg hbase hmem hpu hpv hp'u hp'v
    have Radd : ∀ (k : ℕ) (x x' : MvPolynomial (Fin m) K),
        (∃ μ μ' : K, x - (MvPolynomial.C μ * p k + MvPolynomial.C μ' * p' k) ∈ wcpaLquI G c (k + 1)) →
        (∃ μ μ' : K, x' - (MvPolynomial.C μ * p k + MvPolynomial.C μ' * p' k) ∈ wcpaLquI G c (k + 1)) →
        ∃ μ μ' : K, x + x' - (MvPolynomial.C μ * p k + MvPolynomial.C μ' * p' k) ∈
          wcpaLquI G c (k + 1) := by
      rintro k x x' ⟨μ₁, μ₁', h1⟩ ⟨μ₂, μ₂', h2⟩
      refine ⟨μ₁ + μ₂, μ₁' + μ₂', memeq _ _ _ ?_ (Ideal.add_mem _ h1 h2)⟩
      simp only [map_add]
      ring
    have R0 : ∀ (k : ℕ) (x : MvPolynomial (Fin m) K), x ∈ wcpaLquI G c (k + 1) →
        ∃ μ μ' : K, x - (MvPolynomial.C μ * p k + MvPolynomial.C μ' * p' k) ∈
          wcpaLquI G c (k + 1) := by
      intro k x hx
      exact ⟨0, 0, memeq _ _ _ (by simp) hx⟩
    have M : ∀ k : ℕ, 1 ≤ k → ∀ y ∈ 𝔪 ^ k, ∃ μ μ' : K,
        y - (MvPolynomial.C μ * p k + MvPolynomial.C μ' * p' k) ∈ wcpaLquI G c (k + 1) := by
      intro k hk
      induction k, hk using Nat.le_induction with
      | base =>
        intro y hy
        rw [pow_one] at hy
        obtain ⟨a₀, b₀, h⟩ := hdeg y hy
        obtain ⟨ν, ν', hν⟩ := hbase a₀ b₀
        exact ⟨ν, ν', by rw [← hν]; exact h⟩
      | succ k hk ih =>
        intro y hy
        rw [pow_succ] at hy
        refine Submodule.mul_induction_on hy ?_ ?_
        · intro z hz w hw
          obtain ⟨μ, μ', hz'⟩ := ih z hz
          obtain ⟨l, l', hw'⟩ := hdeg w hw
          have hsmem : MvPolynomial.C μ * p k + MvPolynomial.C μ' * p' k ∈ 𝔪 ^ k :=
            Ideal.add_mem _ (Ideal.mul_mem_left _ _ (hmem k hk).1)
              (Ideal.mul_mem_left _ _ (hmem k hk).2)
          have h1 := imul (k + 1) 1 _ _ hz' (by rw [pow_one]; exact hw)
          have h2 := imul 2 k _ _ hw' hsmem
          rw [show 2 + k = k + 1 + 1 by omega] at h2
          obtain ⟨ν1, ν1', e1⟩ := hpu k hk
          obtain ⟨ν2, ν2', e2⟩ := hpv k hk
          obtain ⟨ν3, ν3', e3⟩ := hp'u k hk
          obtain ⟨ν4, ν4', e4⟩ := hp'v k hk
          refine ⟨μ * l * ν1 + μ * l' * ν2 + μ' * l * ν3 + μ' * l' * ν4,
            μ * l * ν1' + μ * l' * ν2' + μ' * l * ν3' + μ' * l' * ν4', memeq _ _ _ ?_
            (Ideal.add_mem _ (Ideal.add_mem _ (Ideal.add_mem _ (Ideal.add_mem _
              (Ideal.add_mem _ h1 h2)
              (Ideal.mul_mem_left _ (MvPolynomial.C (μ * l)) e1))
              (Ideal.mul_mem_left _ (MvPolynomial.C (μ * l')) e2))
              (Ideal.mul_mem_left _ (MvPolynomial.C (μ' * l)) e3))
              (Ideal.mul_mem_left _ (MvPolynomial.C (μ' * l')) e4))⟩
          simp only [map_add, map_mul]
          ring
        · intro x x' hx hx'
          exact Radd _ x x' hx hx'
    intro k hk x hx
    have hx' : x ∈ 𝔪 ^ k ⊔ Ideal.span (Set.range G) := hx
    obtain ⟨y, hy, g, hg, rfl⟩ := Submodule.mem_sup.mp hx'
    exact Radd k y g (M k hk y hy)
      (R0 k g (show g ∈ 𝔪 ^ (k + 1) ⊔ Ideal.span (Set.range G) from Ideal.mem_sup_right hg))

  have caseA : ∀ (u v : MvPolynomial (Fin m) K) (a b c' : K), u ∈ 𝔪 → v ∈ 𝔪 → a ≠ 0 →
      MvPolynomial.C a * u ^ 2 + MvPolynomial.C b * (u * v) + MvPolynomial.C c' * v ^ 2 ∈
        wcpaLquI G c 3 →
      ∃ p p' : ℕ → MvPolynomial (Fin m) K,
        (∀ a₀ b₀ : K, ∃ ν ν' : K, MvPolynomial.C a₀ * u + MvPolynomial.C b₀ * v =
          MvPolynomial.C ν * p 1 + MvPolynomial.C ν' * p' 1) ∧
        (∀ k : ℕ, 1 ≤ k → p k ∈ 𝔪 ^ k ∧ p' k ∈ 𝔪 ^ k) ∧
        (∀ k : ℕ, 1 ≤ k → ∃ ν ν' : K, p k * u - (MvPolynomial.C ν * p (k + 1) +
          MvPolynomial.C ν' * p' (k + 1)) ∈ wcpaLquI G c (k + 2)) ∧
        (∀ k : ℕ, 1 ≤ k → ∃ ν ν' : K, p k * v - (MvPolynomial.C ν * p (k + 1) +
          MvPolynomial.C ν' * p' (k + 1)) ∈ wcpaLquI G c (k + 2)) ∧
        (∀ k : ℕ, 1 ≤ k → ∃ ν ν' : K, p' k * u - (MvPolynomial.C ν * p (k + 1) +
          MvPolynomial.C ν' * p' (k + 1)) ∈ wcpaLquI G c (k + 2)) ∧
        (∀ k : ℕ, 1 ≤ k → ∃ ν ν' : K, p' k * v - (MvPolynomial.C ν * p (k + 1) +
          MvPolynomial.C ν' * p' (k + 1)) ∈ wcpaLquI G c (k + 2)) := by
    intro u v a b c' hu hv ha hQ
    have hinv : MvPolynomial.C a⁻¹ * MvPolynomial.C a = (1 : MvPolynomial (Fin m) K) := by
      rw [← MvPolynomial.C_mul, inv_mul_cancel₀ ha, MvPolynomial.C_1]
    have hc1 : MvPolynomial.C (-c' / a) =
        -(MvPolynomial.C a⁻¹ * MvPolynomial.C c' : MvPolynomial (Fin m) K) := by
      rw [← MvPolynomial.C_mul, ← MvPolynomial.C_neg]; congr 1; ring
    have hb1 : MvPolynomial.C (-b / a) =
        -(MvPolynomial.C a⁻¹ * MvPolynomial.C b : MvPolynomial (Fin m) K) := by
      rw [← MvPolynomial.C_mul, ← MvPolynomial.C_neg]; congr 1; ring
    refine ⟨fun k => v ^ k, fun k => u * v ^ (k - 1), ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro a₀ b₀
      exact ⟨b₀, a₀, by simp only [pow_one, Nat.sub_self, pow_zero, mul_one]; ring⟩
    · intro k hk
      obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
      refine ⟨Ideal.pow_mem_pow hv _, ?_⟩
      show u * v ^ (j + 1 - 1) ∈ 𝔪 ^ (j + 1)
      rw [Nat.add_sub_cancel, pow_succ']
      exact Ideal.mul_mem_mul hu (Ideal.pow_mem_pow hv j)
    · intro k _
      exact ⟨0, 1, zmem _ _ (by
        simp only [map_zero, map_one, zero_mul, one_mul, zero_add, Nat.add_sub_cancel]; ring)⟩
    · intro k _
      exact ⟨1, 0, zmem _ _ (by
        simp only [map_zero, map_one, zero_mul, one_mul, add_zero, Nat.add_sub_cancel]; ring)⟩
    · intro k hk
      obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
      have hQ' := imul 3 j _ _ hQ (Ideal.pow_mem_pow hv j)
      rw [show 3 + j = j + 1 + 2 by omega] at hQ'
      refine ⟨-c' / a, -b / a, memeq _ _ _ ?_ (Ideal.mul_mem_left _ (MvPolynomial.C a⁻¹) hQ')⟩
      simp only [Nat.add_sub_cancel]
      linear_combination (-(u ^ 2 * v ^ j)) * hinv - v ^ (j + 2) * hc1 - u * v ^ (j + 1) * hb1
    · intro k hk
      obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
      exact ⟨0, 1, zmem _ _ (by
        simp only [map_zero, map_one, zero_mul, one_mul, zero_add, Nat.add_sub_cancel]; ring)⟩

  have caseB : ∀ (u v : MvPolynomial (Fin m) K) (b : K), u ∈ 𝔪 → v ∈ 𝔪 → b ≠ 0 →
      MvPolynomial.C b * (u * v) ∈ wcpaLquI G c 3 →
      ∃ p p' : ℕ → MvPolynomial (Fin m) K,
        (∀ a₀ b₀ : K, ∃ ν ν' : K, MvPolynomial.C a₀ * u + MvPolynomial.C b₀ * v =
          MvPolynomial.C ν * p 1 + MvPolynomial.C ν' * p' 1) ∧
        (∀ k : ℕ, 1 ≤ k → p k ∈ 𝔪 ^ k ∧ p' k ∈ 𝔪 ^ k) ∧
        (∀ k : ℕ, 1 ≤ k → ∃ ν ν' : K, p k * u - (MvPolynomial.C ν * p (k + 1) +
          MvPolynomial.C ν' * p' (k + 1)) ∈ wcpaLquI G c (k + 2)) ∧
        (∀ k : ℕ, 1 ≤ k → ∃ ν ν' : K, p k * v - (MvPolynomial.C ν * p (k + 1) +
          MvPolynomial.C ν' * p' (k + 1)) ∈ wcpaLquI G c (k + 2)) ∧
        (∀ k : ℕ, 1 ≤ k → ∃ ν ν' : K, p' k * u - (MvPolynomial.C ν * p (k + 1) +
          MvPolynomial.C ν' * p' (k + 1)) ∈ wcpaLquI G c (k + 2)) ∧
        (∀ k : ℕ, 1 ≤ k → ∃ ν ν' : K, p' k * v - (MvPolynomial.C ν * p (k + 1) +
          MvPolynomial.C ν' * p' (k + 1)) ∈ wcpaLquI G c (k + 2)) := by
    intro u v b hu hv hb hQ
    have hinv : MvPolynomial.C b⁻¹ * MvPolynomial.C b = (1 : MvPolynomial (Fin m) K) := by
      rw [← MvPolynomial.C_mul, inv_mul_cancel₀ hb, MvPolynomial.C_1]
    refine ⟨fun k => u ^ k, fun k => v ^ k, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro a₀ b₀
      exact ⟨a₀, b₀, by simp only [pow_one]⟩
    · intro k _
      exact ⟨Ideal.pow_mem_pow hu k, Ideal.pow_mem_pow hv k⟩
    · intro k _
      exact ⟨1, 0, zmem _ _ (by
        simp only [map_zero, map_one, zero_mul, one_mul, add_zero]; ring)⟩
    · intro k hk
      obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
      have hQ' := imul 3 j _ _ hQ (Ideal.pow_mem_pow hu j)
      rw [show 3 + j = j + 1 + 2 by omega] at hQ'
      refine ⟨0, 0, memeq _ _ _ ?_ (Ideal.mul_mem_left _ (MvPolynomial.C b⁻¹) hQ')⟩
      simp only [map_zero, zero_mul, add_zero, sub_zero]
      linear_combination (-(u ^ (j + 1) * v)) * hinv
    · intro k hk
      obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
      have hQ' := imul 3 j _ _ hQ (Ideal.pow_mem_pow hv j)
      rw [show 3 + j = j + 1 + 2 by omega] at hQ'
      refine ⟨0, 0, memeq _ _ _ ?_ (Ideal.mul_mem_left _ (MvPolynomial.C b⁻¹) hQ')⟩
      simp only [map_zero, zero_mul, add_zero, sub_zero]
      linear_combination (-(v ^ (j + 1) * u)) * hinv
    · intro k _
      exact ⟨0, 1, zmem _ _ (by
        simp only [map_zero, map_one, zero_mul, one_mul, zero_add]; ring)⟩

  refine ⟨fun x => ⟨MvPolynomial.eval c x, ?_⟩, ?_⟩
  · show _ ∈ 𝔪 ^ 1 ⊔ Ideal.span (Set.range G)
    rw [pow_one]
    exact Ideal.mem_sup_left (t0 x)
  · obtain ⟨u, v, p, p', hdeg, hbase, hmem, hpu, hpv, hp'u, hp'v⟩ :
        ∃ (u v : MvPolynomial (Fin m) K) (p p' : ℕ → MvPolynomial (Fin m) K),
        (∀ y ∈ 𝔪, ∃ a b : K, y - (MvPolynomial.C a * u + MvPolynomial.C b * v) ∈
          wcpaLquI G c 2) ∧
        (∀ a₀ b₀ : K, ∃ ν ν' : K, MvPolynomial.C a₀ * u + MvPolynomial.C b₀ * v =
          MvPolynomial.C ν * p 1 + MvPolynomial.C ν' * p' 1) ∧
        (∀ k : ℕ, 1 ≤ k → p k ∈ 𝔪 ^ k ∧ p' k ∈ 𝔪 ^ k) ∧
        (∀ k : ℕ, 1 ≤ k → ∃ ν ν' : K, p k * u - (MvPolynomial.C ν * p (k + 1) +
          MvPolynomial.C ν' * p' (k + 1)) ∈ wcpaLquI G c (k + 2)) ∧
        (∀ k : ℕ, 1 ≤ k → ∃ ν ν' : K, p k * v - (MvPolynomial.C ν * p (k + 1) +
          MvPolynomial.C ν' * p' (k + 1)) ∈ wcpaLquI G c (k + 2)) ∧
        (∀ k : ℕ, 1 ≤ k → ∃ ν ν' : K, p' k * u - (MvPolynomial.C ν * p (k + 1) +
          MvPolynomial.C ν' * p' (k + 1)) ∈ wcpaLquI G c (k + 2)) ∧
        (∀ k : ℕ, 1 ≤ k → ∃ ν ν' : K, p' k * v - (MvPolynomial.C ν * p (k + 1) +
          MvPolynomial.C ν' * p' (k + 1)) ∈ wcpaLquI G c (k + 2)) := by
      by_cases ha : a = 0
      · by_cases hc : c' = 0
        · have hb : b ≠ 0 := by
            rcases hne with h | h | h
            · exact absurd ha h
            · exact h
            · exact absurd hc h
          obtain ⟨p, p', h⟩ := caseB (wcpaLquLin c α) (wcpaLquLin c β) b (linmem α) (linmem β) hb
            (memeq _ _ _ (by rw [ha, hc]; simp) hrel)
          exact ⟨wcpaLquLin c α, wcpaLquLin c β, p, p', deg1, h⟩
        · obtain ⟨p, p', h⟩ := caseA (wcpaLquLin c β) (wcpaLquLin c α) c' b a (linmem β) (linmem α)
            hc (memeq _ _ _ (by ring) hrel)
          refine ⟨wcpaLquLin c β, wcpaLquLin c α, p, p', ?_, h⟩
          intro y hy
          obtain ⟨a₀, b₀, h0⟩ := deg1 y hy
          exact ⟨b₀, a₀, memeq _ _ _ (by ring) h0⟩
      · obtain ⟨p, p', h⟩ := caseA (wcpaLquLin c α) (wcpaLquLin c β) a b c' (linmem α) (linmem β)
          ha hrel
        exact ⟨wcpaLquLin c α, wcpaLquLin c β, p, p', deg1, h⟩
    intro k hk
    exact ⟨p k, p' k, graded u v p p' hdeg hbase hmem hpu hpv hp'u hp'v k hk⟩

theorem wcpa_dj_sno_lnc_hilb_lower : ∀ (K : Type u) [Field K] (g : MvPolynomial (Fin 2) K), g ∈ Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ 2 → ∀ n : ℕ, 1 ≤ n → 2 * n - 1 ≤ Module.finrank K (MvPolynomial (Fin 2) K ⧸ (Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ n ⊔ Ideal.span {g})) :=
by
  intro K _ g hg n hn
  classical

  have quot : ∀ (I J : Ideal (MvPolynomial (Fin 2) K)) (g : MvPolynomial (Fin 2) K),
      Module.Finite K (MvPolynomial (Fin 2) K ⧸ I) → Module.Finite K (MvPolynomial (Fin 2) K ⧸ J) →
      (∀ h ∈ J, g * h ∈ I) →
      Module.finrank K (MvPolynomial (Fin 2) K ⧸ I) ≤
        Module.finrank K (MvPolynomial (Fin 2) K ⧸ (I ⊔ Ideal.span {g})) +
        Module.finrank K (MvPolynomial (Fin 2) K ⧸ J) := by
    intro I J g hI hJ hgJ
    let π : (MvPolynomial (Fin 2) K ⧸ I) →ₗ[K] (MvPolynomial (Fin 2) K ⧸ (I ⊔ Ideal.span {g})) :=
      (Ideal.Quotient.factorₐ K (le_sup_left : I ≤ I ⊔ Ideal.span {g})).toLinearMap
    have hπ : ∀ x, π (Ideal.Quotient.mk I x) = Ideal.Quotient.mk _ x := fun x => rfl
    have hπs : Function.Surjective π := by
      intro y
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact ⟨Ideal.Quotient.mk I x, hπ x⟩
    let ν0 : (MvPolynomial (Fin 2) K ⧸ J) →ₗ[MvPolynomial (Fin 2) K] (MvPolynomial (Fin 2) K ⧸ I) :=
      Submodule.liftQ J (g • Submodule.mkQ I) (by
        intro h hh
        rw [LinearMap.mem_ker, LinearMap.smul_apply, Submodule.mkQ_apply,
          ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, smul_eq_mul]
        exact hgJ h hh)
    let ν : (MvPolynomial (Fin 2) K ⧸ J) →ₗ[K] (MvPolynomial (Fin 2) K ⧸ I) := ν0.restrictScalars K
    have hν : ∀ a, ν (Ideal.Quotient.mk J a) = Ideal.Quotient.mk I (g * a) := fun a => rfl
    have hker : LinearMap.ker π ≤ LinearMap.range ν := by
      intro x hx
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
      rw [LinearMap.mem_ker, hπ, Ideal.Quotient.eq_zero_iff_mem, Submodule.mem_sup] at hx
      obtain ⟨i, hi, z, hz, hiz⟩ := hx
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hz
      refine ⟨Ideal.Quotient.mk J a, ?_⟩
      rw [hν, ← hiz, map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hi, zero_add, mul_comm]
    have hrn := LinearMap.finrank_range_add_finrank_ker π
    rw [LinearMap.range_eq_top.mpr hπs, finrank_top] at hrn
    have hk1 : Module.finrank K (LinearMap.ker π) ≤ Module.finrank K (LinearMap.range ν) :=
      Submodule.finrank_mono hker
    have hk2 : Module.finrank K (LinearMap.range ν) ≤
        Module.finrank K (MvPolynomial (Fin 2) K ⧸ J) :=
      LinearMap.finrank_range_le ν
    omega

  have hsum : ∀ j : ℕ, 2 * ∑ s ∈ Finset.range j, (s + 1) = j * (j + 1) := by
    intro j
    induction j with
    | zero => simp
    | succ j ih => rw [Finset.sum_range_succ, mul_add, ih]; ring
  have dimn : ∀ k : ℕ, Module.Finite K (MvPolynomial (Fin 2) K ⧸
        Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ k) ∧
      2 * Module.finrank K (MvPolynomial (Fin 2) K ⧸
        Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ k) =
        k * (k + 1) := by
    intro k
    obtain ⟨e, hex, hedeg, heinj⟩ : ∃ e : ℕ × ℕ → (Fin 2 →₀ ℕ),
        (∀ x : Fin 2 →₀ ℕ, e (x 0, x 1) = x) ∧ (∀ p, (e p).degree = p.1 + p.2) ∧
        (∀ p q, e p = e q → p = q) := by
      refine ⟨fun p => Finsupp.single 0 p.1 + Finsupp.single 1 p.2, ?_, ?_, ?_⟩
      · intro x
        ext i
        fin_cases i <;> simp
      · intro p
        rw [Finsupp.degree_eq_sum, Fin.sum_univ_two]
        simp
      · intro p q h
        have h0 := congrArg (fun x => x 0) h
        have h1 := congrArg (fun x => x 1) h
        simp at h0 h1
        exact Prod.ext h0 h1
    obtain ⟨S, hS, hScard⟩ : ∃ S : Finset (ℕ × ℕ), (∀ p, p ∈ S ↔ p.1 + p.2 < k) ∧
        2 * S.card = k * (k + 1) := by
      refine ⟨(Finset.range k).biUnion (fun s => Finset.HasAntidiagonal.antidiagonal s), ?_, ?_⟩
      · intro p
        rw [Finset.mem_biUnion]
        constructor
        · rintro ⟨s, hs, hp⟩
          rw [Finset.mem_range] at hs
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
          omega
        · intro h
          exact ⟨p.1 + p.2, Finset.mem_range.mpr h, Finset.HasAntidiagonal.mem_antidiagonal.mpr rfl⟩
      · rw [Finset.card_biUnion]
        · rw [← hsum k]
          congr 1
          exact Finset.sum_congr rfl (fun s _ => Finset.Nat.card_antidiagonal s)
        · intro s _ t _ hst
          rw [Function.onFun, Finset.disjoint_left]
          intro p hp hq
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp hq
          exact hst (hp.symm.trans hq)
    let c : MvPolynomial (Fin 2) K →ₗ[K] (S → K) :=
      LinearMap.pi (fun p : S => MvPolynomial.lcoeff K (e p))
    have hc : ∀ f (p : S), c f p = f.coeff (e p) := fun f p => rfl
    have hker : ∀ f, f ∈ Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ k
        ↔ c f = 0 := by
      intro f
      rw [show Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) =
        MvPolynomial.idealOfVars (Fin 2) K from rfl, MvPolynomial.mem_pow_idealOfVars_iff]
      constructor
      · intro h
        funext p
        rw [hc, Pi.zero_apply]
        by_contra hne
        have h1 := h _ (MvPolynomial.mem_support_iff.mpr hne)
        rw [hedeg] at h1
        have h2 := (hS p.1).mp p.2
        omega
      · intro h x hx
        by_contra hlt
        rw [not_le] at hlt
        have hmem : (x 0, x 1) ∈ S := by
          rw [hS]
          rw [Finsupp.degree_eq_sum, Fin.sum_univ_two] at hlt
          exact hlt
        have h1 := congrFun h ⟨(x 0, x 1), hmem⟩
        rw [hc, Pi.zero_apply] at h1
        change f.coeff (e (x 0, x 1)) = 0 at h1
        rw [hex] at h1
        exact MvPolynomial.mem_support_iff.mp hx h1
    have hsurj : Function.Surjective c := by
      intro v
      refine ⟨∑ q : S, MvPolynomial.monomial (e q) (v q), ?_⟩
      funext p
      rw [hc, MvPolynomial.coeff_sum, Finset.sum_eq_single p]
      · rw [MvPolynomial.coeff_monomial, if_pos rfl]
      · intro q _ hqp
        rw [MvPolynomial.coeff_monomial, if_neg]
        intro h
        exact hqp (Subtype.ext (heinj _ _ h))
      · intro h
        exact absurd (Finset.mem_univ p) h
    have hkereq : (Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ k
        ).restrictScalars K = LinearMap.ker c := by
      ext f
      rw [Submodule.restrictScalars_mem, LinearMap.mem_ker]
      exact hker f
    let E : (MvPolynomial (Fin 2) K ⧸
        Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ k) ≃ₗ[K] (S → K) :=
      ((Submodule.Quotient.restrictScalarsEquiv K
        (Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ k)).symm.trans
        (Submodule.quotEquivOfEq _ _ hkereq)).trans (c.quotKerEquivOfSurjective hsurj)
    refine ⟨Module.Finite.equiv E.symm, ?_⟩
    rw [E.finrank_eq, Module.finrank_fintype_fun_eq_card, Fintype.card_coe, hScard]

  have hJ : ∀ h ∈ Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ (n - 2),
      g * h ∈ Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ n := by
    intro h hh
    have h1 := Ideal.mul_mem_mul hg hh
    rw [← pow_add] at h1
    exact Ideal.pow_le_pow_right (by omega) h1
  obtain ⟨hfn, hdn⟩ := dimn n
  obtain ⟨hfm, hdm⟩ := dimn (n - 2)
  have key := quot _ _ g hfn hfm hJ
  generalize Module.finrank K (MvPolynomial (Fin 2) K ⧸ (Ideal.span (Set.range
    (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ n ⊔ Ideal.span {g})) = d at key ⊢
  generalize Module.finrank K (MvPolynomial (Fin 2) K ⧸ Ideal.span (Set.range
    (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ n) = D at key hdn
  generalize Module.finrank K (MvPolynomial (Fin 2) K ⧸ Ideal.span (Set.range
    (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ (n - 2)) = Dm at key hdm
  rcases Nat.lt_or_ge n 2 with h2 | h2
  · have h1 : n = 1 := by omega
    subst h1
    norm_num at hdm hdn
    omega
  · obtain ⟨i, rfl⟩ : ∃ i, n = i + 2 := ⟨n - 2, by omega⟩
    rw [Nat.add_sub_cancel] at hdm
    have e : 2 * (i + 2) - 1 = 2 * i + 3 := by omega
    rw [e]
    nlinarith

theorem wcpa_dj_sno_lnc_hilb : ∀ (K : Type u) [Field K] (m : ℕ) (G : Fin (m - 1) → MvPolynomial (Fin m) K) (c α β : Fin m → K) (a b c' : K), (∀ i, MvPolynomial.eval c (G i) = 0) → (∀ w : Fin m → K, ∃ a b : K, wcpaLquLin c w - (MvPolynomial.C a * wcpaLquLin c α + MvPolynomial.C b * wcpaLquLin c β) ∈ wcpaLquI G c 2) → (∀ a b : K, MvPolynomial.C a * wcpaLquLin c α + MvPolynomial.C b * wcpaLquLin c β ∈ wcpaLquI G c 2 → a = 0 ∧ b = 0) → (a ≠ 0 ∨ b ≠ 0 ∨ c' ≠ 0) → MvPolynomial.C a * wcpaLquLin c α ^ 2 + MvPolynomial.C b * (wcpaLquLin c α * wcpaLquLin c β) + MvPolynomial.C c' * wcpaLquLin c β ^ 2 ∈ wcpaLquI G c 3 → ∀ n : ℕ, 1 ≤ n → Module.finrank K (MvPolynomial (Fin m) K ⧸ wcpaLquI G c n) = 2 * n - 1 :=
by
  intro K _ m G c α β a b c' hG0 hA hB hne hrel n hn
  classical

  have drec : ∀ (I J : Ideal (MvPolynomial (Fin m) K)) (s : ℕ)
      (S : Fin s → MvPolynomial (Fin m) K), J ≤ I →
      Module.Finite K (MvPolynomial (Fin m) K ⧸ I) →
      (∀ x ∈ I, ∃ f : Fin s → K, x - ∑ i, f i • S i ∈ J) →
      Module.Finite K (MvPolynomial (Fin m) K ⧸ J) ∧
        Module.finrank K (MvPolynomial (Fin m) K ⧸ J) ≤
          Module.finrank K (MvPolynomial (Fin m) K ⧸ I) + s := by
    intro I J s S hJI hfin hspan
    let π : (MvPolynomial (Fin m) K ⧸ J) →ₗ[K] (MvPolynomial (Fin m) K ⧸ I) :=
      (Ideal.Quotient.factorₐ K hJI).toLinearMap
    have hπ : ∀ x, π (Ideal.Quotient.mk J x) = Ideal.Quotient.mk I x := fun x => rfl
    have hπs : Function.Surjective π := by
      intro y
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      exact ⟨Ideal.Quotient.mk J x, hπ x⟩
    have hker : LinearMap.ker π ≤
        Submodule.span K (Set.range fun i => Ideal.Quotient.mk J (S i)) := by
      intro y hy
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      rw [LinearMap.mem_ker, hπ] at hy
      have hx : x ∈ I := Ideal.Quotient.eq_zero_iff_mem.mp hy
      obtain ⟨f, hf⟩ := hspan x hx
      have heq : Ideal.Quotient.mk J x = ∑ i, f i • Ideal.Quotient.mk J (S i) := by
        rw [← sub_eq_zero]
        have h1 : Ideal.Quotient.mk J x - ∑ i, f i • Ideal.Quotient.mk J (S i) =
            Ideal.Quotient.mkₐ K J (x - ∑ i, f i • S i) := by
          simp only [map_sub, map_sum, map_smul, Ideal.Quotient.mkₐ_eq_mk]
        rw [h1, Ideal.Quotient.mkₐ_eq_mk]
        exact Ideal.Quotient.eq_zero_iff_mem.mpr hf
      rw [heq]
      exact Submodule.sum_mem _ fun i _ =>
        Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
    have hkerfg : (LinearMap.ker π).FG := by
      have h1 : (Submodule.span K (Set.range fun i => Ideal.Quotient.mk J (S i))).FG :=
        Submodule.fg_span (Set.finite_range _)
      exact Submodule.FG.of_le h1 hker
    haveI hfinJ : Module.Finite K (MvPolynomial (Fin m) K ⧸ J) := by
      rw [Module.finite_def]
      refine Submodule.fg_of_fg_map_of_fg_inf_ker π ?_ ?_
      · rw [Submodule.map_top, LinearMap.range_eq_top.mpr hπs]
        exact Module.finite_def.mp hfin
      · rw [top_inf_eq]; exact hkerfg
    refine ⟨hfinJ, ?_⟩
    have hrn := LinearMap.finrank_range_add_finrank_ker π
    have hr : Module.finrank K (LinearMap.range π) ≤
        Module.finrank K (MvPolynomial (Fin m) K ⧸ I) := Submodule.finrank_le _
    have hk1 : Module.finrank K (LinearMap.ker π) ≤
        Module.finrank K (Submodule.span K (Set.range fun i => Ideal.Quotient.mk J (S i))) :=
      Submodule.finrank_mono hker
    have hk2 : Module.finrank K (Submodule.span K (Set.range fun i => Ideal.Quotient.mk J (S i)))
        ≤ Fintype.card (Fin s) := finrank_range_le_card _
    rw [Fintype.card_fin] at hk2
    omega

  obtain ⟨hspan1, hspan2⟩ := wcpa_dj_sno_lnc_hilb_span K m G c α β a b c' hG0 hA hne hrel
  have upper : ∀ n : ℕ, 1 ≤ n → Module.Finite K (MvPolynomial (Fin m) K ⧸ wcpaLquI G c n) ∧
      Module.finrank K (MvPolynomial (Fin m) K ⧸ wcpaLquI G c n) ≤ 2 * n - 1 := by
    intro n hn
    induction n, hn using Nat.le_induction with
    | base =>
      haveI hsub : Subsingleton (MvPolynomial (Fin m) K ⧸ (⊤ : Ideal (MvPolynomial (Fin m) K))) :=
        Ideal.Quotient.subsingleton_iff.mpr rfl
      have h := drec ⊤ (wcpaLquI G c 1) 1 ![1] le_top inferInstance (by
        intro x _
        obtain ⟨μ, hμ⟩ := hspan1 x
        refine ⟨![μ], ?_⟩
        simpa [Fin.sum_univ_one, MvPolynomial.smul_eq_C_mul] using hμ)
      refine ⟨h.1, ?_⟩
      have h0 : Module.finrank K
          (MvPolynomial (Fin m) K ⧸ (⊤ : Ideal (MvPolynomial (Fin m) K))) = 0 :=
        Module.finrank_zero_of_subsingleton
      have := h.2
      omega
    | succ k hk ih =>
      obtain ⟨p, p', hpp⟩ := hspan2 k hk
      have h := drec (wcpaLquI G c k) (wcpaLquI G c (k + 1)) 2 ![p, p']
        (sup_le_sup_right (Ideal.pow_le_pow_right (Nat.le_succ k)) _) ih.1 (by
          intro x hx
          obtain ⟨μ, μ', h⟩ := hpp x hx
          refine ⟨![μ, μ'], ?_⟩
          simpa [Fin.sum_univ_two, MvPolynomial.smul_eq_C_mul] using h)
      refine ⟨h.1, ?_⟩
      have h1 := ih.2
      have h2 := h.2
      omega

  obtain ⟨k, e, j₀, μ, M, hcov, hg', hM⟩ := wcpa_dj_sno_lnc_hilb_choose K m G c α β hG0 hA hB
  obtain ⟨ψ, hψ𝔫, hψα, hψβ, hψH⟩ := wcpa_dj_sno_lnc_hilb_newton K m k (fun i => G (e i)) c α β M
    (fun i => hG0 (e i)) hM n
  let Φ : MvPolynomial (Fin m) K →ₐ[K] MvPolynomial (Fin 2) K :=
    MvPolynomial.aeval (fun l => MvPolynomial.C (c l) + ψ l)
  have hΦC : ∀ r : K, Φ (MvPolynomial.C r) = MvPolynomial.C r := fun r => by
    simp [Φ, MvPolynomial.aeval_C, MvPolynomial.algebraMap_eq]
  have hΦt : ∀ l, Φ (MvPolynomial.X l - MvPolynomial.C (c l)) = ψ l := fun l => by
    rw [map_sub, hΦC]
    simp [Φ, MvPolynomial.aeval_X]
  have hmap1 : Ideal.map Φ (Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)))
      ≤ Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) := by
    rw [Ideal.map_span, Ideal.span_le]
    rintro _ ⟨_, ⟨l, rfl⟩, rfl⟩
    rw [hΦt]
    exact hψ𝔫 l
  have hmemj : ∀ (j : ℕ) (x : MvPolynomial (Fin m) K),
      x ∈ Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ j →
      Φ x ∈ Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ j := by
    intro j x hx
    have h1 : Ideal.map Φ (Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ j)
        ≤ Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ j := by
      rw [Ideal.map_pow]
      exact Ideal.pow_right_mono hmap1 j
    exact h1 (Ideal.mem_map_of_mem Φ hx)
  have hΦLin : ∀ w, Φ (wcpaLquLin c w) = ∑ l, MvPolynomial.C (w l) * ψ l := by
    intro w
    unfold wcpaLquLin
    rw [map_sum]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [map_mul, hΦC, hΦt]
  let θ : MvPolynomial (Fin 2) K →ₐ[K] MvPolynomial (Fin m) K :=
    MvPolynomial.aeval ![wcpaLquLin c α, wcpaLquLin c β]
  have hΦθ : Φ.comp θ = AlgHom.id K _ := by
    apply MvPolynomial.algHom_ext
    rw [Fin.forall_fin_two]
    constructor
    · rw [AlgHom.comp_apply, AlgHom.id_apply]
      show Φ (MvPolynomial.aeval ![wcpaLquLin c α, wcpaLquLin c β] (MvPolynomial.X 0)) = _
      rw [MvPolynomial.aeval_X]
      show Φ (wcpaLquLin c α) = _
      rw [hΦLin, hψα]
    · rw [AlgHom.comp_apply, AlgHom.id_apply]
      show Φ (MvPolynomial.aeval ![wcpaLquLin c α, wcpaLquLin c β] (MvPolynomial.X 1)) = _
      rw [MvPolynomial.aeval_X]
      show Φ (wcpaLquLin c β) = _
      rw [hΦLin, hψβ]
  have hΦs : Function.Surjective Φ := fun y =>
    ⟨θ y, by rw [← AlgHom.comp_apply, hΦθ, AlgHom.id_apply]⟩
  have hg2 : Φ (G j₀ - ∑ i, MvPolynomial.C (μ i) * G (e i)) ∈
      Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ 2 :=
    hmemj 2 _ hg'
  set g := Φ (G j₀ - ∑ i, MvPolynomial.C (μ i) * G (e i)) with hgdef
  set T : Ideal (MvPolynomial (Fin 2) K) :=
    Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ n ⊔
      Ideal.span {g} with hT
  have hHn : ∀ i, Φ (G (e i)) ∈
      Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) K)) ^ n :=
    fun i => hψH i
  have hle : ∀ x ∈ wcpaLquI G c n, Φ x ∈ T := by
    intro x hx
    have hx' : x ∈ Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ n ⊔
        Ideal.span (Set.range G) := hx
    have hsub : Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ n ⊔
        Ideal.span (Set.range G) ≤ Ideal.comap Φ T := by
      refine sup_le ?_ ?_
      · intro y hy
        exact Ideal.mem_sup_left (hmemj n y hy)
      · rw [Ideal.span_le]
        rintro _ ⟨j, rfl⟩
        rcases hcov j with hj | ⟨i, rfl⟩
        · have hsplit : G j₀ = (G j₀ - ∑ i, MvPolynomial.C (μ i) * G (e i)) +
              ∑ i, MvPolynomial.C (μ i) * G (e i) := by ring
          show Φ (G j) ∈ T
          rw [hj, hsplit, map_add]
          refine T.add_mem (Ideal.mem_sup_right (Ideal.subset_span rfl)) ?_
          refine Ideal.mem_sup_left ?_
          rw [map_sum]
          exact Ideal.sum_mem _ fun i _ => by
            rw [map_mul]; exact Ideal.mul_mem_left _ _ (hHn i)
        · show Φ (G (e i)) ∈ T
          exact Ideal.mem_sup_left (hHn i)
    exact hsub hx'
  let Lf : (MvPolynomial (Fin m) K ⧸ wcpaLquI G c n) →ₐ[K] (MvPolynomial (Fin 2) K ⧸ T) :=
    Ideal.Quotient.liftₐ (wcpaLquI G c n) ((Ideal.Quotient.mkₐ K T).comp Φ) (fun x hx => by
      rw [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (hle x hx))
  have hLs : Function.Surjective Lf := by
    intro y
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨x, rfl⟩ := hΦs z
    exact ⟨Ideal.Quotient.mk _ x, rfl⟩
  obtain ⟨hfin, hup⟩ := upper n hn
  have hcmp : Module.finrank K (MvPolynomial (Fin 2) K ⧸ T) ≤
      Module.finrank K (MvPolynomial (Fin m) K ⧸ wcpaLquI G c n) := by
    have h := LinearMap.finrank_range_le Lf.toLinearMap
    rw [LinearMap.range_eq_top.mpr hLs, finrank_top] at h
    exact h
  have hlow := wcpa_dj_sno_lnc_hilb_lower K g hg2 n hn
  exact le_antisymm hup (le_trans hlow hcmp)

theorem wcpa_dj_sno_lnc_transfer : ∀ (K : Type u) [Field K] (R : Type u) [CommRing R] [IsLocalRing R] (φ : K →+* R) (m r : ℕ) (F : Fin r → MvPolynomial (Fin m) K) (c : Fin m → K) (ρ : MvPolynomial (Fin m) K →+* R), ρ.comp MvPolynomial.C = φ → (∀ (n : ℕ) (y : R), ∃ h, y - ρ h ∈ IsLocalRing.maximalIdeal R ^ n) → (∀ (n : ℕ) (h : MvPolynomial (Fin m) K), ρ h ∈ IsLocalRing.maximalIdeal R ^ n ↔ h ∈ wcpaLquI F c n) → (∀ j, MvPolynomial.eval c (F j) = 0) → (∀ n : ℕ, 1 ≤ n → Module.finrank K (MvPolynomial (Fin m) K ⧸ wcpaLquI F c n) = 2 * n - 1) → ∀ α β : Fin m → K, (∀ w : Fin m → K, ∃ a b : K, wcpaLquLin c w - (MvPolynomial.C a * wcpaLquLin c α + MvPolynomial.C b * wcpaLquLin c β) ∈ wcpaLquI F c 2) → (∀ a b : K, MvPolynomial.C a * wcpaLquLin c α + MvPolynomial.C b * wcpaLquLin c β ∈ wcpaLquI F c 2 → a = 0 ∧ b = 0) → wcpaLqHilb K R φ ∧ wcpaLqBasis K R φ (ρ (wcpaLquLin c α)) (ρ (wcpaLquLin c β)) :=
by
  intro K _ R _ _ φ m r F c ρ hρC hdens hstr _hF0 hfin α β hA hB
  classical
  have hI : ∀ n, wcpaLquI F c n =
      Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ n ⊔
        Ideal.span (Set.range F) := fun n => rfl
  have hCφ : ∀ x, ρ (MvPolynomial.C x) = φ x := fun x => RingHom.congr_fun hρC x

  have Hsub : ∀ h : MvPolynomial (Fin m) K, h - MvPolynomial.C (MvPolynomial.eval c h) ∈
      Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) := by
    intro h
    induction h using MvPolynomial.induction_on with
    | C a => rw [MvPolynomial.eval_C, sub_self]; exact Ideal.zero_mem _
    | add p q hp hq =>
      have e : p + q - MvPolynomial.C (MvPolynomial.eval c (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.eval c p)) +
            (q - MvPolynomial.C (MvPolynomial.eval c q)) := by
        rw [map_add, map_add]; ring
      rw [e]; exact Ideal.add_mem _ hp hq
    | mul_X p k hp =>
      have e : p * MvPolynomial.X k - MvPolynomial.C (MvPolynomial.eval c (p * MvPolynomial.X k)) =
          (p - MvPolynomial.C (MvPolynomial.eval c p)) * MvPolynomial.X k +
            MvPolynomial.C (MvPolynomial.eval c p) * (MvPolynomial.X k - MvPolynomial.C (c k)) := by
        rw [map_mul, MvPolynomial.eval_X, map_mul]; ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp)
        (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨k, rfl⟩))

  have hlin : ∀ e ∈ Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)),
      ∃ w : Fin m → K, e - wcpaLquLin c w ∈
        Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ 2 := by
    intro e he
    obtain ⟨p, hp⟩ := Ideal.mem_span_range_iff_exists_fun.mp he
    refine ⟨fun l => MvPolynomial.eval c (p l), ?_⟩
    have e1 : e - wcpaLquLin c (fun l => MvPolynomial.eval c (p l)) =
        ∑ l, (p l - MvPolynomial.C (MvPolynomial.eval c (p l))) *
          (MvPolynomial.X l - MvPolynomial.C (c l)) := by
      rw [← hp]
      unfold wcpaLquLin
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun l _ => ?_)
      ring
    rw [e1, sq]
    exact Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_mul (Hsub _) (Ideal.subset_span ⟨l, rfl⟩))

  have hLinMc : ∀ w : Fin m → K, wcpaLquLin c w ∈
      Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) := by
    intro w
    unfold wcpaLquLin
    exact Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, rfl⟩))
  have hLin𝔪 : ∀ w : Fin m → K, ρ (wcpaLquLin c w) ∈ IsLocalRing.maximalIdeal R := by
    intro w
    have h1 : wcpaLquLin c w ∈ wcpaLquI F c 1 := by
      rw [hI, pow_one]; exact Ideal.mem_sup_left (hLinMc w)
    have := (hstr 1 _).mpr h1
    rwa [pow_one] at this
  unfold wcpaLqBasis
  refine ⟨?_, hLin𝔪 α, hLin𝔪 β, ?_, ?_⟩
  ·
    unfold wcpaLqHilb
    intro n hn
    letI : Algebra K R := φ.toAlgebra
    let θ : MvPolynomial (Fin m) K →+* R ⧸ IsLocalRing.maximalIdeal R ^ n :=
      (Ideal.Quotient.mk _).comp ρ
    have hθ : Function.Surjective θ := by
      intro z
      obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
      obtain ⟨h, hh⟩ := hdens n y
      refine ⟨h, ?_⟩
      show Ideal.Quotient.mk _ (ρ h) = Ideal.Quotient.mk _ y
      rw [Ideal.Quotient.eq]
      have := (IsLocalRing.maximalIdeal R ^ n).neg_mem hh
      rwa [neg_sub] at this
    have hker : RingHom.ker θ = wcpaLquI F c n := by
      ext h
      rw [RingHom.mem_ker]
      show Ideal.Quotient.mk _ (ρ h) = 0 ↔ _
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact hstr n h
    let ψ : (MvPolynomial (Fin m) K ⧸ wcpaLquI F c n) ≃+* R ⧸ IsLocalRing.maximalIdeal R ^ n :=
      (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hθ)
    have hψ : ∀ x, ψ (Ideal.Quotient.mk _ x) = θ x := fun x => rfl
    have compat : ∀ a : K, ψ (algebraMap K _ a) = algebraMap K _ a := by
      intro a
      rw [← Ideal.Quotient.mk_algebraMap, hψ, ← Ideal.Quotient.mk_algebraMap]
      show Ideal.Quotient.mk _ (ρ (algebraMap K (MvPolynomial (Fin m) K) a)) = _
      rw [MvPolynomial.algebraMap_eq, hCφ]
      rfl
    let e := AlgEquiv.ofRingEquiv (f := ψ) compat
    exact (e.toLinearEquiv.finrank_eq).symm.trans (hfin n hn)
  ·
    intro y hy
    obtain ⟨h, hh⟩ := hdens 2 y
    have hρh : ρ h ∈ IsLocalRing.maximalIdeal R := by
      have h2 : y - ρ h ∈ IsLocalRing.maximalIdeal R := Ideal.pow_le_self two_ne_zero hh
      have := Ideal.sub_mem _ hy h2
      rwa [sub_sub_cancel] at this
    have hI1 : h ∈ wcpaLquI F c 1 := (hstr 1 h).mp (by rw [pow_one]; exact hρh)
    rw [hI, pow_one, Submodule.mem_sup] at hI1
    obtain ⟨e, he, f, hf, hef⟩ := hI1
    obtain ⟨w, hw⟩ := hlin e he
    obtain ⟨a, b, hab⟩ := hA w
    refine ⟨a, b, ?_⟩
    have hI2 : h - (MvPolynomial.C a * wcpaLquLin c α + MvPolynomial.C b * wcpaLquLin c β) ∈
        wcpaLquI F c 2 := by
      have eq : h - (MvPolynomial.C a * wcpaLquLin c α + MvPolynomial.C b * wcpaLquLin c β) =
          (e - wcpaLquLin c w) + f + (wcpaLquLin c w -
            (MvPolynomial.C a * wcpaLquLin c α + MvPolynomial.C b * wcpaLquLin c β)) := by
        rw [← hef]; ring
      rw [eq]
      refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) hab
      · rw [hI]; exact Ideal.mem_sup_left hw
      · rw [hI]; exact Ideal.mem_sup_right hf
    have h3 := (hstr 2 _).mpr hI2
    simp only [map_sub, map_add, map_mul, hCφ] at h3
    have eq2 : y - (φ a * ρ (wcpaLquLin c α) + φ b * ρ (wcpaLquLin c β)) =
        (y - ρ h) + (ρ h - (φ a * ρ (wcpaLquLin c α) + φ b * ρ (wcpaLquLin c β))) := by ring
    rw [eq2]
    exact Ideal.add_mem _ hh h3
  ·
    intro c₁ c₂ hc
    apply hB
    rw [← hstr 2]
    simpa only [map_add, map_mul, hCφ] using hc

theorem wcpa_dj_bsc_linear_normalize : ∀ (K : Type u) [Field K] (f : MvPowerSeries (Fin 2) K) (a b c α β γ δ l : K), l ≠ 0 → α * δ - β * γ ≠ 0 → l * (α * γ) = a → l * (α * δ + β * γ) = b → l * (β * δ) = c → 3 ≤ MvPowerSeries.order (f - wcpaBscQuad K a b c) → ∃ f' : MvPowerSeries (Fin 2) K, 3 ≤ MvPowerSeries.order (f' - MvPowerSeries.X 0 * MvPowerSeries.X 1) ∧ ∃ e : (MvPowerSeries (Fin 2) K ⧸ Ideal.span {f}) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {f'}), e.toRingHom.comp ((Ideal.Quotient.mk _).comp MvPowerSeries.C) = (Ideal.Quotient.mk _).comp MvPowerSeries.C :=
by
  intro K _ f a b c α β γ δ l hl hdet ha hb hc hf
  classical
  subst ha hb hc
  obtain ⟨Dinv, hDinv⟩ : ∃ x : K, x * (α * δ - β * γ) = 1 := ⟨_, inv_mul_cancel₀ hdet⟩
  obtain ⟨linv, hlinv⟩ : ∃ x : K, x * l = 1 := ⟨_, inv_mul_cancel₀ hl⟩
  let A : Fin 2 → MvPowerSeries (Fin 2) K :=
    ![MvPowerSeries.C Dinv * (MvPowerSeries.C δ * MvPowerSeries.X 0
        - MvPowerSeries.C β * MvPowerSeries.X 1),
      MvPowerSeries.C Dinv * (-(MvPowerSeries.C γ * MvPowerSeries.X 0)
        + MvPowerSeries.C α * MvPowerSeries.X 1)]
  let B : Fin 2 → MvPowerSeries (Fin 2) K :=
    ![MvPowerSeries.C α * MvPowerSeries.X 0 + MvPowerSeries.C β * MvPowerSeries.X 1,
      MvPowerSeries.C γ * MvPowerSeries.X 0 + MvPowerSeries.C δ * MvPowerSeries.X 1]
  have hA0 : ∀ s, MvPowerSeries.constantCoeff (A s) = 0 := by
    intro s; fin_cases s <;> simp [A]
  have hB0 : ∀ s, MvPowerSeries.constantCoeff (B s) = 0 := by
    intro s; fin_cases s <;> simp [B]
  have hA : MvPowerSeries.HasSubst A := MvPowerSeries.hasSubst_of_constantCoeff_zero hA0
  have hB : MvPowerSeries.HasSubst B := MvPowerSeries.hasSubst_of_constantCoeff_zero hB0
  let ρ := MvPowerSeries.substAlgHom (R := K) hA
  let ρ' := MvPowerSeries.substAlgHom (R := K) hB
  have hρ : ∀ h, ρ h = MvPowerSeries.subst A h :=
    fun h => congrFun (MvPowerSeries.coe_substAlgHom (R := K) hA) h
  have hρ' : ∀ h, ρ' h = MvPowerSeries.subst B h :=
    fun h => congrFun (MvPowerSeries.coe_substAlgHom (R := K) hB) h
  have hρX0 : ρ (MvPowerSeries.X 0) = MvPowerSeries.C Dinv * (MvPowerSeries.C δ * MvPowerSeries.X 0
        - MvPowerSeries.C β * MvPowerSeries.X 1) := by
    rw [hρ, MvPowerSeries.subst_X hA]; rfl
  have hρX1 : ρ (MvPowerSeries.X 1) = MvPowerSeries.C Dinv * (-(MvPowerSeries.C γ * MvPowerSeries.X 0)
        + MvPowerSeries.C α * MvPowerSeries.X 1) := by
    rw [hρ, MvPowerSeries.subst_X hA]; rfl
  have hρ'X0 : ρ' (MvPowerSeries.X 0) =
      MvPowerSeries.C α * MvPowerSeries.X 0 + MvPowerSeries.C β * MvPowerSeries.X 1 := by
    rw [hρ', MvPowerSeries.subst_X hB]; rfl
  have hρ'X1 : ρ' (MvPowerSeries.X 1) =
      MvPowerSeries.C γ * MvPowerSeries.X 0 + MvPowerSeries.C δ * MvPowerSeries.X 1 := by
    rw [hρ', MvPowerSeries.subst_X hB]; rfl
  have hρC : ∀ c : K, ρ (MvPowerSeries.C c) = MvPowerSeries.C c := by
    intro c
    have h1 := ρ.commutes c
    rw [MvPowerSeries.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply] at h1
    exact h1
  have hρ'C : ∀ c : K, ρ' (MvPowerSeries.C c) = MvPowerSeries.C c := by
    intro c
    have h1 := ρ'.commutes c
    rw [MvPowerSeries.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply] at h1
    exact h1
  have hD : MvPowerSeries.C Dinv * (MvPowerSeries.C α * MvPowerSeries.C δ
      - MvPowerSeries.C β * MvPowerSeries.C γ) = (1 : MvPowerSeries (Fin 2) K) := by
    have := congrArg (MvPowerSeries.C (σ := Fin 2) (R := K)) hDinv
    simpa only [map_mul, map_sub, map_one] using this
  have hAB0 : ρ (MvPowerSeries.C α * MvPowerSeries.X 0 + MvPowerSeries.C β * MvPowerSeries.X 1)
      = MvPowerSeries.X 0 := by
    rw [map_add, map_mul, map_mul, hρC, hρC, hρX0, hρX1]
    linear_combination (MvPowerSeries.X 0) * hD
  have hAB1 : ρ (MvPowerSeries.C γ * MvPowerSeries.X 0 + MvPowerSeries.C δ * MvPowerSeries.X 1)
      = MvPowerSeries.X 1 := by
    rw [map_add, map_mul, map_mul, hρC, hρC, hρX0, hρX1]
    linear_combination (MvPowerSeries.X 1) * hD
  have hBA0 : ρ' (MvPowerSeries.C Dinv * (MvPowerSeries.C δ * MvPowerSeries.X 0
        - MvPowerSeries.C β * MvPowerSeries.X 1)) = MvPowerSeries.X 0 := by
    rw [map_mul, map_sub, map_mul, map_mul, hρ'C, hρ'C, hρ'C, hρ'X0, hρ'X1]
    linear_combination (MvPowerSeries.X 0) * hD
  have hBA1 : ρ' (MvPowerSeries.C Dinv * (-(MvPowerSeries.C γ * MvPowerSeries.X 0)
        + MvPowerSeries.C α * MvPowerSeries.X 1)) = MvPowerSeries.X 1 := by
    rw [map_mul, map_add, map_neg, map_mul, map_mul, hρ'C, hρ'C, hρ'C, hρ'X0, hρ'X1]
    linear_combination (MvPowerSeries.X 1) * hD
  have hρρ' : ∀ h, ρ (ρ' h) = h := by
    intro h
    rw [hρ', hρ, MvPowerSeries.subst_comp_subst_apply hB hA]
    have e : (fun s => MvPowerSeries.subst A (B s)) = MvPowerSeries.X := by
      funext s
      fin_cases s
      · rw [← hρ]; exact hAB0
      · rw [← hρ]; exact hAB1
    rw [e, MvPowerSeries.subst_self]
    rfl
  have hρ'ρ : ∀ h, ρ' (ρ h) = h := by
    intro h
    rw [hρ', hρ, MvPowerSeries.subst_comp_subst_apply hA hB]
    have e : (fun s => MvPowerSeries.subst B (A s)) = MvPowerSeries.X := by
      funext s
      fin_cases s
      · rw [← hρ']; exact hBA0
      · rw [← hρ']; exact hBA1
    rw [e, MvPowerSeries.subst_self]
    rfl
  let e₀ : MvPowerSeries (Fin 2) K ≃+* MvPowerSeries (Fin 2) K :=
    RingEquiv.ofBijective ρ ⟨Function.LeftInverse.injective hρ'ρ,
      Function.RightInverse.surjective hρρ'⟩
  have hq : wcpaBscQuad K (l * (α * γ)) (l * (α * δ + β * γ)) (l * (β * δ)) =
      MvPowerSeries.C l * ((MvPowerSeries.C α * MvPowerSeries.X 0 + MvPowerSeries.C β * MvPowerSeries.X 1)
        * (MvPowerSeries.C γ * MvPowerSeries.X 0 + MvPowerSeries.C δ * MvPowerSeries.X 1)) := by
    simp only [wcpaBscQuad, map_mul, map_add]
    ring
  have hρq : ρ (wcpaBscQuad K (l * (α * γ)) (l * (α * δ + β * γ)) (l * (β * δ))) =
      MvPowerSeries.C l * (MvPowerSeries.X 0 * MvPowerSeries.X 1) := by
    rw [hq, map_mul, map_mul, hρC, hAB0, hAB1]
  have hord : ∀ h : MvPowerSeries (Fin 2) K, h.order ≤ (ρ h).order := by
    intro h
    rw [hρ]
    refine le_trans ?_ (MvPowerSeries.le_order_subst hA h)
    have h1 : (1 : ℕ∞) ≤ ⨅ i, (A i).order :=
      le_iInf (fun i => MvPowerSeries.one_le_order_iff_constCoeff_eq_zero.mpr (hA0 i))
    calc h.order = 1 * h.order := (one_mul _).symm
      _ ≤ _ := by
        first
          | exact mul_le_mul_of_nonneg_right h1 (zero_le _)
          | gcongr
          | exact mul_le_mul_right' h1 _
  have hCl : MvPowerSeries.C linv * MvPowerSeries.C l = (1 : MvPowerSeries (Fin 2) K) := by
    rw [← map_mul, hlinv, map_one]
  have hunit : IsUnit (MvPowerSeries.C linv : MvPowerSeries (Fin 2) K) :=
    ⟨⟨MvPowerSeries.C linv, MvPowerSeries.C l, hCl, by rw [mul_comm]; exact hCl⟩, rfl⟩
  refine ⟨MvPowerSeries.C linv * ρ f, ?_, ?_⟩
  · have e : MvPowerSeries.C linv * ρ f - MvPowerSeries.X 0 * MvPowerSeries.X 1 =
        MvPowerSeries.C linv * ρ (f - wcpaBscQuad K (l * (α * γ)) (l * (α * δ + β * γ)) (l * (β * δ))) := by
      rw [map_sub, hρq]
      linear_combination (MvPowerSeries.X 0 * MvPowerSeries.X 1) * hCl
    rw [e]
    exact le_trans hf (le_trans (hord _) (le_trans le_add_self MvPowerSeries.le_order_mul))
  · have hJ : Ideal.span {MvPowerSeries.C linv * ρ f} =
        Ideal.map (e₀ : MvPowerSeries (Fin 2) K →+* MvPowerSeries (Fin 2) K) (Ideal.span {f}) := by
      rw [Ideal.map_span, Set.image_singleton, Ideal.span_singleton_mul_left_unit hunit]
      rfl
    refine ⟨Ideal.quotientEquiv _ _ e₀ hJ, ?_⟩
    apply RingHom.ext
    intro c
    show Ideal.quotientEquiv _ _ e₀ hJ (Ideal.Quotient.mk _ (MvPowerSeries.C c))
      = Ideal.Quotient.mk _ (MvPowerSeries.C c)
    have hc : e₀ (MvPowerSeries.C c) = MvPowerSeries.C c := hρC c
    first
      | (rw [Ideal.quotientEquiv_mk, hc])
      | (rw [Ideal.quotientEquiv_apply, Ideal.quotientMap_mk]; exact congrArg _ hc)
      | (exact congrArg (Ideal.Quotient.mk _) hc)

theorem wcpa_dj_sno_node_of_lnc : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (φ : K →+* R) (m : ℕ) (G : Fin (m - 1) → MvPolynomial (Fin m) K) (c : Fin m → K) (ρ : MvPolynomial (Fin m) K →+* R), ρ.comp MvPolynomial.C = φ → (∀ (n : ℕ) (y : R), ∃ h, y - ρ h ∈ IsLocalRing.maximalIdeal R ^ n) → (∀ (n : ℕ) (h : MvPolynomial (Fin m) K), ρ h ∈ IsLocalRing.maximalIdeal R ^ n ↔ h ∈ wcpaLquI G c n) → (∀ i, MvPolynomial.eval c (G i) = 0) → (∀ q, MvPolynomial.eval c (wcpaLquGen G (Sum.inr q)) = 0) → ∀ σ : Fin m → Fin (m - 1) ⊕ ((Fin (m - 1) → Fin (m - 1)) × (Fin (m - 1) → Fin m)), (Matrix.of fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (wcpaLquGen G (σ i)))).det ≠ 0 → ∃ e : AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)).comp φ) = (Ideal.Quotient.mk _).comp MvPowerSeries.C :=
by
  intro K _ _ R _ _ _ φ m G c ρ hρC hdens hstr hG0 hmin σ hdet

  obtain ⟨α, β, hA, hB, a, b, c', hdisc, hrel⟩ :=
    wcpa_dj_sno_lnc_jets K m G c σ hG0 hmin hdet

  have hne : a ≠ 0 ∨ b ≠ 0 ∨ c' ≠ 0 := by
    by_contra h
    push_neg at h
    obtain ⟨rfl, rfl, rfl⟩ := h
    apply hdisc
    ring

  have hH := wcpa_dj_sno_lnc_hilb K m G c α β a b c' hG0 hA hB hne hrel

  obtain ⟨hHilb, hBasis⟩ :=
    wcpa_dj_sno_lnc_transfer K R φ m (m - 1) G c ρ hρC hdens hstr hG0 hH α β hA hB

  have hCφ : ∀ x, ρ (MvPolynomial.C x) = φ x := fun x => by rw [← hρC]; rfl
  have hR3 : φ a * (ρ (wcpaLquLin c α)) ^ 2 + φ b * (ρ (wcpaLquLin c α) * ρ (wcpaLquLin c β)) +
      φ c' * (ρ (wcpaLquLin c β)) ^ 2 ∈ IsLocalRing.maximalIdeal R ^ 3 := by
    have h3 := (hstr 3 _).mpr hrel
    simpa only [map_add, map_mul, map_pow, hCφ] using h3

  obtain ⟨f, hf, e1, he1⟩ :=
    wcpa_dj_lq_completion_presentation K R φ hHilb _ _ hBasis a b c' hne hR3

  obtain ⟨α', β', γ, δ, l, hl, hdet', h1, h2, h3⟩ : ∃ α β γ δ l : K, l ≠ 0 ∧
      α * δ - β * γ ≠ 0 ∧ l * (α * γ) = a ∧ l * (α * δ + β * γ) = b ∧ l * (β * δ) = c' := by
    by_cases ha : a = 0
    · subst ha
      have hb : b ≠ 0 := by
        intro hb
        apply hdisc
        rw [hb]
        ring
      exact ⟨b, c', 0, 1, 1, one_ne_zero, by simpa using hb, by ring, by ring, by ring⟩
    · obtain ⟨r1, hr1⟩ := IsAlgClosed.exists_root
        (Polynomial.C a * Polynomial.X ^ 2 + Polynomial.C b * Polynomial.X + Polynomial.C c')
        (by rw [Polynomial.degree_quadratic ha]; norm_num)
      have e : a * r1 ^ 2 + b * r1 + c' = 0 := by
        have hh := hr1
        simp only [Polynomial.IsRoot.def, Polynomial.eval_add, Polynomial.eval_mul,
          Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X] at hh
        exact hh
      obtain ⟨r2, har2⟩ : ∃ r2 : K, a * r2 = -b - a * r1 :=
        ⟨-b / a - r1, by field_simp; try ring⟩
      have key : b ^ 2 - 4 * a * c' = (a * r1 - a * r2) ^ 2 := by
        linear_combination (-4 * a) * e + (3 * a * r1 - a * r2 + b) * har2
      refine ⟨1, -r1, 1, -r2, a, ha, ?_, by ring, ?_, ?_⟩
      · intro h
        apply hdisc
        rw [key]
        have hh : a * r1 - a * r2 = a * (1 * -r2 - -r1 * 1) := by ring
        rw [hh, h]
        ring
      · linear_combination (-1 : K) * har2
      · linear_combination r1 * har2 - e
  obtain ⟨f', hf', e2, he2⟩ :=
    wcpa_dj_bsc_linear_normalize K f a b c' α' β' γ δ l hl hdet' h1 h2 h3 hf
  obtain ⟨e3, he3⟩ := wcpa_dj_ssp_bw_hensel_node K f' hf'
  refine ⟨e1.trans (e2.trans e3), ?_⟩
  apply RingHom.ext
  intro x
  have k1 := RingHom.congr_fun he1 x
  have k2 := RingHom.congr_fun he2 x
  have k3 := RingHom.congr_fun he3 x
  simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at k1 k2 k3 ⊢
  rw [RingEquiv.trans_apply, RingEquiv.trans_apply, k1, k2, k3]

theorem wcpa_dj_sno_case_ii : ∀ (T Z : Scheme.{u}) (u : Z ⟶ T) (U : T.Opens) (hU : IsAffineOpen U) (V : Z.Opens) (hV : IsAffineOpen V) (e : V ≤ u ⁻¹ᵁ U) (m r : ℕ) (p : MvPolynomial (Fin m) Γ(T, U) →+* Γ(Z, V)) (F : Fin r → MvPolynomial (Fin m) Γ(T, U)) (ι : Fin (m - 1) → Fin r) (f : MvPolynomial (Fin m) Γ(T, U)) (σ : Fin m → Fin (m - 1) ⊕ ((Fin (m - 1) → Fin (m - 1)) × (Fin (m - 1) → Fin m))), p.comp MvPolynomial.C = (u.appLE U V e).hom → Function.Surjective p → RingHom.ker p = Ideal.span (Set.range F) → LocallyOfFinitePresentation u → (∀ j, f * F j ∈ Ideal.span (Set.range fun i => F (ι i))) → ∀ (x : Z) (hx : x ∈ V), p f ∉ (hV.primeIdealOf ⟨x, hx⟩).asIdeal → p (Matrix.of fun i l => MvPolynomial.pderiv l (wcpaLquGen (fun k => F (ι k)) (σ i))).det ∉ (hV.primeIdealOf ⟨x, hx⟩).asIdeal → (∀ q, p (wcpaLquGen (fun k => F (ι k)) (Sum.inr q)) ∈ (hV.primeIdealOf ⟨x, hx⟩).asIdeal) → ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T) (w : ↥(Limits.pullback u s)), Limits.pullback.fst u s w = x → ∃ e' : AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback u s).presheaf.stalk w)) ((Limits.pullback u s).presheaf.stalk w) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), (e'.toRingHom.comp ((algebraMap ((Limits.pullback u s).presheaf.stalk w) (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback u s).presheaf.stalk w)) ((Limits.pullback u s).presheaf.stalk w))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd u s).appTop ≫ (Limits.pullback u s).presheaf.germ ⊤ w trivial).hom)) = (Ideal.Quotient.mk _).comp MvPowerSeries.C :=
by
  intro T Z u U hU V hV e m r p F ι f σ hpC hps hker hfp hfF x hx hf𝔭 hD𝔭 hmin K _ _ s w hw
  classical
  letI alg1 : Algebra Γ(T, U) Γ(Z, V) := (u.appLE U V e).hom.toAlgebra
  have hpC' : p.comp MvPolynomial.C = algebraMap Γ(T, U) Γ(Z, V) := hpC

  have hsU : Set.range ⇑s ⊆ (U : Set T) := by
    rintro _ ⟨q, rfl⟩
    rw [Subsingleton.elim q (Limits.pullback.snd u s w), ← Scheme.Hom.comp_apply,
      ← Limits.pullback.condition, Scheme.Hom.comp_apply, hw]
    exact (Scheme.Hom.mem_preimage u).mp (e hx)
  obtain ⟨ψ, hψ⟩ : ∃ ψ : Γ(T, U) →+* K, s = Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec := by
    have hr : Set.range ⇑s ⊆ Set.range ⇑U.ι := by rw [Scheme.Opens.range_ι]; exact hsU
    have hs' : IsOpenImmersion.lift U.ι s hr ≫ U.ι = s := IsOpenImmersion.lift_fac _ _ _
    refine ⟨(Spec.preimage (IsOpenImmersion.lift U.ι s hr ≫ hU.isoSpec.hom)).hom, ?_⟩
    rw [CommRingCat.ofHom_hom, Spec.map_preimage, Category.assoc, ← hU.isoSpec_inv_ι,
      Iso.hom_inv_id_assoc, hs']
  subst hψ
  letI alg2 : Algebra Γ(T, U) K := ψ.toAlgebra

  have sq : ∀ {W X Y Z S : Scheme.{u}} {fst : W ⟶ X} {snd : W ⟶ Y} {f : X ⟶ Z} {g : Y ⟶ Z}
      (i : Z ⟶ S) [Mono i] {f' : X ⟶ S} {g' : Y ⟶ S},
      IsPullback fst snd f g → f ≫ i = f' → g ≫ i = g' → IsPullback fst snd f' g' := by
    intro W X Y Z S fst snd f g i _ f' g' H hf hg
    subst hf hg
    refine IsPullback.mk' ?_ ?_ ?_
    · rw [← Category.assoc, H.w, Category.assoc]
    · intro T φ φ' h1 h2
      exact H.hom_ext h1 h2
    · intro T a b hab
      have w : a ≫ f = b ≫ g := by
        rw [← cancel_mono i]
        simpa only [Category.assoc] using hab
      exact ⟨H.lift a b w, H.lift_fst a b w, H.lift_snd a b w⟩
  have H1 := isPullback_SpecMap_of_isPushout _ _ _ _
    (CommRingCat.isPushout_tensorProduct Γ(T, U) K Γ(Z, V))
  haveI : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
  haveI : IsOpenImmersion hV.fromSpec := hV.isOpenImmersion_fromSpec
  have e1 : Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) K))
      ≫ hU.fromSpec = Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec := rfl
  have e2 : Spec.map (CommRingCat.ofHom (algebraMap Γ(T, U) Γ(Z, V))) ≫ hU.fromSpec
      = hV.fromSpec ≫ u := IsAffineOpen.SpecMap_appLE_fromSpec u hU hV e
  have H2 := sq hU.fromSpec H1 e1 e2
  have H : IsPullback
      (Spec.map (CommRingCat.ofHom (algebraMap K (TensorProduct Γ(T, U) K Γ(Z, V)))))
      (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight : Γ(Z, V) →ₐ[Γ(T, U)]
        TensorProduct Γ(T, U) K Γ(Z, V)).toRingHom))
      (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) (hV.fromSpec ≫ u) := H2
  have wq : ((Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        Γ(Z, V) →ₐ[Γ(T, U)] TensorProduct Γ(T, U) K Γ(Z, V)).toRingHom))
        ≫ hV.fromSpec) ≫ u =
      Spec.map (CommRingCat.ofHom (algebraMap K (TensorProduct Γ(T, U) K Γ(Z, V)))) ≫
        (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) := by
    rw [Category.assoc]; exact H.w.symm
  let jc := Limits.pullback.lift _ _ wq
  have hjsnd : jc ≫ Limits.pullback.snd u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) = _ :=
    Limits.pullback.lift_snd _ _ wq
  have hjfst : jc ≫ Limits.pullback.fst u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) = _ :=
    Limits.pullback.lift_fst _ _ wq
  have H' : IsPullback (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
        Γ(Z, V) →ₐ[Γ(T, U)] TensorProduct Γ(T, U) K Γ(Z, V)).toRingHom))
      jc hV.fromSpec (Limits.pullback.fst u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec)) := by
    refine IsPullback.of_bot ?_ hjfst.symm (IsPullback.of_hasPullback u _)
    rw [hjsnd]
    exact H.flip
  have hjo : IsOpenImmersion jc :=
    MorphismProperty.of_isPullback (P := @IsOpenImmersion) H' inferInstance

  obtain ⟨x', hx'1, hx'2⟩ := Scheme.exists_preimage_of_isPullback H'
    (hV.primeIdealOf ⟨x, hx⟩) w (by rw [hV.fromSpec_primeIdealOf]; exact hw.symm)
  subst hx'2
  have hMem : ∀ b : Γ(Z, V), b ∈ (hV.primeIdealOf ⟨x, hx⟩).asIdeal ↔
      (1 : K) ⊗ₜ[Γ(T, U)] b ∈ x'.asIdeal := by
    intro b
    rw [← hx'1]
    exact Iff.rfl

  have hpF : ∀ j, p (F j) = 0 := fun j => by
    have h : F j ∈ RingHom.ker p := by rw [hker]; exact Ideal.subset_span ⟨j, rfl⟩
    exact RingHom.mem_ker.mp h
  let P0 : MvPolynomial (Fin m) K →+* TensorProduct Γ(T, U) K Γ(Z, V) :=
    (MvPolynomial.aeval (fun l => (1 : K) ⊗ₜ[Γ(T, U)] p (MvPolynomial.X l)) :
      MvPolynomial (Fin m) K →ₐ[K] TensorProduct Γ(T, U) K Γ(Z, V)).toRingHom
  have hP0C : ∀ a : K, P0 (MvPolynomial.C a) = a ⊗ₜ[Γ(T, U)] (1 : Γ(Z, V)) := by
    intro a
    show MvPolynomial.aeval (fun l => (1 : K) ⊗ₜ[Γ(T, U)] p (MvPolynomial.X l))
      (MvPolynomial.C a) = _
    rw [MvPolynomial.aeval_C, Algebra.TensorProduct.algebraMap_apply]
    rfl
  have hP0X : ∀ l, P0 (MvPolynomial.X l) = (1 : K) ⊗ₜ[Γ(T, U)] p (MvPolynomial.X l) := by
    intro l
    show MvPolynomial.aeval (fun l => (1 : K) ⊗ₜ[Γ(T, U)] p (MvPolynomial.X l))
      (MvPolynomial.X l) = _
    rw [MvPolynomial.aeval_X]
  have s1 : ∀ q : MvPolynomial (Fin m) Γ(T, U),
      P0 (MvPolynomial.map (algebraMap Γ(T, U) K) q) = (1 : K) ⊗ₜ[Γ(T, U)] p q := by
    have hext : P0.comp (MvPolynomial.map (algebraMap Γ(T, U) K)) =
        (Algebra.TensorProduct.includeRight :
          Γ(Z, V) →ₐ[Γ(T, U)] TensorProduct Γ(T, U) K Γ(Z, V)).toRingHom.comp p := by
      apply MvPolynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply, MvPolynomial.map_C, hP0C,
          Algebra.TensorProduct.tmul_one_eq_one_tmul, ← RingHom.congr_fun hpC' a]
        rfl
      · intro l
        rw [RingHom.comp_apply, MvPolynomial.map_X, hP0X]
        rfl
    intro q
    exact RingHom.congr_fun hext q
  have hP0s : Function.Surjective P0 := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, map_zero _⟩
    | tmul a b =>
      obtain ⟨q, rfl⟩ := hps b
      refine ⟨MvPolynomial.C a * MvPolynomial.map (algebraMap Γ(T, U) K) q, ?_⟩
      rw [map_mul, hP0C, s1, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    | add a b ha hb =>
      obtain ⟨a, rfl⟩ := ha
      obtain ⟨b, rfl⟩ := hb
      exact ⟨a + b, map_add _ _ _⟩
  have hle : ∀ h, P0 h = 0 →
      h ∈ Ideal.span (Set.range fun j => MvPolynomial.map (algebraMap Γ(T, U) K) (F j)) := by
    intro h hh
    set J := Ideal.span (Set.range fun j => MvPolynomial.map (algebraMap Γ(T, U) K) (F j))
      with hJ
    let π := Ideal.Quotient.mk J
    let θ : MvPolynomial (Fin m) Γ(T, U) →+* MvPolynomial (Fin m) K ⧸ J :=
      π.comp (MvPolynomial.map (algebraMap Γ(T, U) K))
    have hθ : RingHom.ker p ≤ RingHom.ker θ := by
      rw [hker, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
    let β := p.liftOfSurjective hps ⟨θ, hθ⟩
    have hβ : ∀ q, β (p q) = θ q := fun q => p.liftOfSurjective_comp_apply hps ⟨θ, hθ⟩ q
    have hQalg : ∀ a : Γ(T, U), algebraMap Γ(T, U) (MvPolynomial (Fin m) K ⧸ J) a =
        π (MvPolynomial.C (algebraMap Γ(T, U) K a)) := by
      intro a
      show _ = Ideal.Quotient.mk J (MvPolynomial.C (algebraMap Γ(T, U) K a))
      rw [← MvPolynomial.algebraMap_apply, Ideal.Quotient.mk_algebraMap]
    let gA : Γ(Z, V) →ₐ[Γ(T, U)] MvPolynomial (Fin m) K ⧸ J :=
      { β with
        commutes' := fun a => by
          show β (algebraMap Γ(T, U) Γ(Z, V) a) = _
          rw [← RingHom.congr_fun hpC' a, RingHom.comp_apply, hβ, hQalg]
          show π (MvPolynomial.map (algebraMap Γ(T, U) K) (MvPolynomial.C a)) = _
          rw [MvPolynomial.map_C] }
    let fA : K →ₐ[Γ(T, U)] MvPolynomial (Fin m) K ⧸ J :=
      { π.comp MvPolynomial.C with
        commutes' := fun a => by
          rw [hQalg]
          rfl }
    let Rl := Algebra.TensorProduct.lift fA gA (fun _ _ => Commute.all _ _)
    have hR : Rl.toRingHom.comp P0 = π := by
      apply MvPolynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply, hP0C]
        show Rl (a ⊗ₜ[Γ(T, U)] (1 : Γ(Z, V))) = _
        rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
        rfl
      · intro l
        rw [RingHom.comp_apply, hP0X]
        show Rl ((1 : K) ⊗ₜ[Γ(T, U)] p (MvPolynomial.X l)) = _
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        show β (p (MvPolynomial.X l)) = _
        rw [hβ]
        show π (MvPolynomial.map (algebraMap Γ(T, U) K) (MvPolynomial.X l)) = _
        rw [MvPolynomial.map_X]
    have h1 : π h = 0 := by
      rw [← hR, RingHom.comp_apply, hh, map_zero]
    exact Ideal.Quotient.eq_zero_iff_mem.mp h1
  have hP0Cr : P0.comp MvPolynomial.C = algebraMap K (TensorProduct Γ(T, U) K Γ(Z, V)) :=
    RingHom.ext fun a => by
      rw [RingHom.comp_apply, hP0C, Algebra.TensorProduct.algebraMap_apply]
      rfl
  have hP0F : ∀ j, P0 (MvPolynomial.map (algebraMap Γ(T, U) K) (F j)) = 0 := by
    intro j
    rw [s1, hpF, TensorProduct.tmul_zero]

  have hGen : ∀ t, MvPolynomial.map (algebraMap Γ(T, U) K) (wcpaLquGen (fun k => F (ι k)) t) =
      wcpaLquGen (fun k => MvPolynomial.map (algebraMap Γ(T, U) K) (F (ι k))) t := by
    intro t
    rcases t with i | q
    · rfl
    · simp only [wcpaLquGen, Sum.elim_inr]
      rw [RingHom.map_det]
      congr 1
      ext i j
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply]
      rw [MvPolynomial.pderiv_map]
  have hDmap : MvPolynomial.map (algebraMap Γ(T, U) K)
      (Matrix.of fun i l => MvPolynomial.pderiv l (wcpaLquGen (fun k => F (ι k)) (σ i))).det =
      (Matrix.of fun i l => MvPolynomial.pderiv l (wcpaLquGen
        (fun k => MvPolynomial.map (algebraMap Γ(T, U) K) (F (ι k))) (σ i))).det := by
    rw [RingHom.map_det]
    congr 1
    ext i l
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply]
    rw [← hGen, MvPolynomial.pderiv_map]

  have hGenP : ∀ i, wcpaLquGen (fun k => MvPolynomial.map (algebraMap Γ(T, U) K) (F (ι k))) (σ i)
      ∈ Ideal.comap P0 x'.asIdeal := by
    intro i
    rw [Ideal.mem_comap, ← hGen, s1, ← hMem]
    rcases σ i with j | q
    · show p (F (ι j)) ∈ _
      rw [hpF]
      exact Ideal.zero_mem _
    · exact hmin q
  have hDP : (Matrix.of fun i l => MvPolynomial.pderiv l (wcpaLquGen
      (fun k => MvPolynomial.map (algebraMap Γ(T, U) K) (F (ι k))) (σ i))).det ∉
      Ideal.comap P0 x'.asIdeal := by
    rw [Ideal.mem_comap, ← hDmap, s1, ← hMem]
    exact hD𝔭

  obtain ⟨c, hPc⟩ := wcpa_dj_sno_rational_point K m (m - 1)
    (fun k => MvPolynomial.map (algebraMap Γ(T, U) K) (F (ι k))) σ (Ideal.comap P0 x'.asIdeal)
    (by haveI : x'.asIdeal.IsPrime := x'.isPrime; exact Ideal.IsPrime.comap P0) hGenP hDP
  have hE : ∀ h, P0 h ∈ x'.asIdeal ↔ MvPolynomial.eval c h = 0 := by
    intro h
    show h ∈ Ideal.comap P0 x'.asIdeal ↔ _
    rw [hPc, RingHom.mem_ker]

  have hFc : ∀ j, MvPolynomial.eval c (MvPolynomial.map (algebraMap Γ(T, U) K) (F j)) = 0 :=
    fun j => (hE _).mp (by rw [hP0F]; exact Ideal.zero_mem _)
  have hminc : ∀ q, MvPolynomial.eval c (wcpaLquGen
      (fun k => MvPolynomial.map (algebraMap Γ(T, U) K) (F (ι k))) (Sum.inr q)) = 0 :=
    fun q => (hE _).mp (by rw [← hGen, s1, ← hMem]; exact hmin q)
  have hdetc : (Matrix.of fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (wcpaLquGen
      (fun k => MvPolynomial.map (algebraMap Γ(T, U) K) (F (ι k))) (σ i)))).det ≠ 0 := by
    have hev : (Matrix.of fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (wcpaLquGen
        (fun k => MvPolynomial.map (algebraMap Γ(T, U) K) (F (ι k))) (σ i)))).det =
        MvPolynomial.eval c (Matrix.of fun i l => MvPolynomial.pderiv l (wcpaLquGen
          (fun k => MvPolynomial.map (algebraMap Γ(T, U) K) (F (ι k))) (σ i))).det := by
      rw [RingHom.map_det]
      rfl
    intro h0
    apply hDP
    show P0 _ ∈ x'.asIdeal
    rw [hE, ← hev]
    exact h0
  have hfc : MvPolynomial.eval c (MvPolynomial.map (algebraMap Γ(T, U) K) f) ≠ 0 := fun h0 =>
    hf𝔭 ((hMem _).mpr (by rw [← s1]; exact (hE _).mpr h0))

  haveI := hfp
  haveI : IsLocallyNoetherian (Limits.pullback u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec)) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd u _)

  obtain ⟨σw, hσφ, hunit, hfrac, hkerw⟩ :=
    wcpa_dj_lqu_sp_stalk_loc K (TensorProduct Γ(T, U) K Γ(Z, V)) _ _ jc hjo hjsnd x'

  have hρC : (σw.comp P0).comp MvPolynomial.C =
      ((Scheme.ΓSpecIso (.of K)).inv ≫
        (Limits.pullback.snd u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec)).appTop ≫
        (Limits.pullback u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec)).presheaf.germ ⊤
          (jc x') trivial).hom := by
    rw [← hσφ, RingHom.comp_assoc, hP0Cr]

  obtain ⟨hdens, hstrict⟩ := wcpa_dj_lqu_sp_trunc_transfer K m r
    (fun j => MvPolynomial.map (algebraMap Γ(T, U) K) (F j)) c hFc _ (σw.comp P0)
    (fun h hh => hunit (P0 h) (fun hmem => hh ((hE h).mp hmem)))
    (fun j => by rw [RingHom.comp_apply, hP0F j, map_zero])
    (by
      intro y
      obtain ⟨t, s', hs', hy⟩ := hfrac y
      obtain ⟨h, rfl⟩ := hP0s t
      obtain ⟨s0, rfl⟩ := hP0s s'
      exact ⟨h, s0, fun h0 => hs' ((hE s0).mpr h0), hy⟩)
    (by
      intro h hρh
      obtain ⟨s', hs', hs'0⟩ := hkerw (P0 h) hρh
      obtain ⟨s0, rfl⟩ := hP0s s'
      refine ⟨s0, fun h0 => hs' ((hE s0).mpr h0), ?_⟩
      exact hle (s0 * h) (by rw [map_mul]; exact hs'0))

  have hsat := wcpa_dj_sno_saturate K m r (m - 1)
    (fun j => MvPolynomial.map (algebraMap Γ(T, U) K) (F j))
    (fun i => MvPolynomial.map (algebraMap Γ(T, U) K) (F (ι i))) c
    (MvPolynomial.map (algebraMap Γ(T, U) K) f) hfc
    (fun j => by
      have h1 := Ideal.mem_map_of_mem (MvPolynomial.map (algebraMap Γ(T, U) K)) (hfF j)
      rw [Ideal.map_span, map_mul, ← Set.range_comp] at h1
      exact h1)
    (fun i => Ideal.subset_span ⟨ι i, rfl⟩)

  exact wcpa_dj_sno_node_of_lnc K _ _ m
    (fun i => MvPolynomial.map (algebraMap Γ(T, U) K) (F (ι i))) c (σw.comp P0) hρC hdens
    (fun n h => by rw [← hsat n]; exact hstrict n h)
    (fun i => hFc (ι i)) hminc σ hdetc

theorem wcpa_dj_sno_node_open : ∀ (T Z : Scheme.{u}) [IsLocallyNoetherian T] (u : Z ⟶ T), Flat u → LocallyOfFinitePresentation u → ∀ z : Z, (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T) (w : ↥(Limits.pullback u s)), Limits.pullback.fst u s w = z → ((∃ W : (Limits.pullback u s).Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd u s)) ∨ (∃ e : AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback u s).presheaf.stalk w)) ((Limits.pullback u s).presheaf.stalk w) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), (e.toRingHom.comp ((algebraMap ((Limits.pullback u s).presheaf.stalk w) (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback u s).presheaf.stalk w)) ((Limits.pullback u s).presheaf.stalk w))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd u s).appTop ≫ (Limits.pullback u s).presheaf.germ ⊤ w trivial).hom)) = (Ideal.Quotient.mk _).comp MvPowerSeries.C))) → ∃ O : Z.Opens, z ∈ O ∧ ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T) (w : ↥(Limits.pullback u s)), Limits.pullback.fst u s w ∈ O → ((∃ W : (Limits.pullback u s).Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd u s)) ∨ (∃ e : AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback u s).presheaf.stalk w)) ((Limits.pullback u s).presheaf.stalk w) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), (e.toRingHom.comp ((algebraMap ((Limits.pullback u s).presheaf.stalk w) (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback u s).presheaf.stalk w)) ((Limits.pullback u s).presheaf.stalk w))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd u s).appTop ≫ (Limits.pullback u s).presheaf.germ ⊤ w trivial).hom)) = (Ideal.Quotient.mk _).comp MvPowerSeries.C)) :=
by
  intro T Z _ u hfl hfp z hz
  classical

  have s1 : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ T) (w : ↥(Limits.pullback u s))
      (W : Z.Opens), Limits.pullback.fst u s w ∈ W → SmoothOfRelativeDimension 1 (W.ι ≫ u) →
      ∃ W' : (Limits.pullback u s).Opens, w ∈ W' ∧
        SmoothOfRelativeDimension 1 (W'.ι ≫ Limits.pullback.snd u s) := by
    intro K _ s w W hw hW
    refine ⟨Limits.pullback.fst u s ⁻¹ᵁ W, (Scheme.Hom.mem_preimage _).mpr hw, ?_⟩
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
      ((isPullback_morphismRestrict (Limits.pullback.fst u s) W).paste_vert
        (IsPullback.of_hasPullback u s)) hW

  by_cases hsm : ∃ W : Z.Opens, z ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ u)
  · obtain ⟨W, hzW, hW⟩ := hsm
    exact ⟨W, hzW, fun K _ _ s w hw => Or.inl (s1 K s w W hw hW)⟩

  obtain ⟨U, hU, V, hV, e, hzV, m, r, p, F, hpC, hps, hker, hflat⟩ :=
    wcpa_dj_sno_chart_presentation T Z u hfl hfp z
  letI alg : Algebra Γ(T, U) Γ(Z, V) := (u.appLE U V e).hom.toAlgebra
  haveI hflat' : Module.Flat Γ(T, U) Γ(Z, V) := hflat

  have s3 : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ T), Set.range ⇑s ⊆ (U : Set T) →
      ∃ ψ : Γ(T, U) →+* K, s = Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec := by
    intro K _ s hs
    have hr : Set.range ⇑s ⊆ Set.range ⇑U.ι := by rw [Scheme.Opens.range_ι]; exact hs
    have hs' : IsOpenImmersion.lift U.ι s hr ≫ U.ι = s := IsOpenImmersion.lift_fac _ _ _
    refine ⟨(Spec.preimage (IsOpenImmersion.lift U.ι s hr ≫ hU.isoSpec.hom)).hom, ?_⟩
    rw [CommRingCat.ofHom_hom, Spec.map_preimage, Category.assoc, ← hU.isoSpec_inv_ι,
      Iso.hom_inv_id_assoc, hs']
  have hpF : ∀ j, p (F j) = 0 := fun j => by
    have h : F j ∈ RingHom.ker p := by rw [hker]; exact Ideal.subset_span ⟨j, rfl⟩
    exact RingHom.mem_ker.mp h

  have huzU : u z ∈ U := (Scheme.Hom.mem_preimage u).mp (e hzV)
  obtain ⟨ψ₀, hψ₀⟩ := s3 (AlgebraicClosure (T.residueField (u z)))
    (Spec.map (CommRingCat.ofHom (algebraMap (T.residueField (u z))
      (AlgebraicClosure (T.residueField (u z))))) ≫ T.fromSpecResidueField (u z)) (by
      rintro _ ⟨q, rfl⟩
      rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
      exact huzU)
  obtain ⟨w₀, hw₀1, -⟩ := Scheme.exists_preimage_of_isPullback
    (IsPullback.of_hasPullback u (Spec.map (CommRingCat.ofHom ψ₀) ≫ hU.fromSpec)) z
    (show ↥(Spec (.of (AlgebraicClosure (T.residueField (u z))))) from
      IsLocalRing.closedPoint (AlgebraicClosure (T.residueField (u z))))
    (by rw [← hψ₀, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply])
  have hnode₀ := (hz _ _ w₀ hw₀1).resolve_left (fun hW => by
    obtain ⟨W', hW'1, hW'2⟩ := wcpa_dj_bsc_smooth_descend T Z u _ _ w₀ hfl hfp hW
    exact hsm ⟨W', hw₀1 ▸ hW'1, hW'2⟩)

  obtain ⟨χ₀, hχ₀ψ, hχ₀z, hPNT, hHilb⟩ := wcpa_dj_sno_point_jets T Z u U hU V hV e m r p F
    hpC hps hker hfp _ ψ₀ w₀ (by rw [hw₀1]; exact hzV) hnode₀
  subst hχ₀ψ
  have key : ∀ h : MvPolynomial (Fin m) Γ(T, U), χ₀ (p h) =
      MvPolynomial.eval (fun l => χ₀ (p (MvPolynomial.X l)))
        (MvPolynomial.map (χ₀.comp (u.appLE U V e).hom) h) := by
    have hext : χ₀.comp p = (MvPolynomial.eval (fun l => χ₀ (p (MvPolynomial.X l)))).comp
        (MvPolynomial.map (χ₀.comp (u.appLE U V e).hom)) := by
      apply MvPolynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.map_C, MvPolynomial.eval_C,
          ← RingHom.comp_apply p MvPolynomial.C, hpC]
        rfl
      · intro l
        rw [RingHom.comp_apply, RingHom.comp_apply, MvPolynomial.map_X, MvPolynomial.eval_X]
    intro h
    exact RingHom.congr_fun hext h
  have hF0 : ∀ j, MvPolynomial.eval (fun l => χ₀ (p (MvPolynomial.X l)))
      (MvPolynomial.map (χ₀.comp (u.appLE U V e).hom) (F j)) = 0 := fun j => by
    rw [← key, hpF, map_zero]

  obtain ⟨hm2, ι, s₁, hs₁, hs₁F⟩ := wcpa_dj_sno_local_generators _ m r
    (fun j => MvPolynomial.map (χ₀.comp (u.appLE U V e).hom) (F j))
    (fun l => χ₀ (p (MvPolynomial.X l))) hF0 hPNT hHilb
  obtain ⟨f, hf0, hfF⟩ := wcpa_dj_sno_rci_spread Γ(T, U) Γ(Z, V) m r (m - 1) p F ι hpC hps hker
    _ (χ₀.comp (u.appLE U V e).hom) (fun l => χ₀ (p (MvPolynomial.X l))) hF0 ⟨s₁, hs₁, hs₁F⟩
  have hsat := wcpa_dj_sno_saturate _ m r (m - 1)
    (fun j => MvPolynomial.map (χ₀.comp (u.appLE U V e).hom) (F j))
    (fun i => MvPolynomial.map (χ₀.comp (u.appLE U V e).hom) (F (ι i)))
    (fun l => χ₀ (p (MvPolynomial.X l))) s₁ hs₁ hs₁F (fun i => Ideal.subset_span ⟨ι i, rfl⟩)
  have hPNT' : wcpaLquPNT (fun i => MvPolynomial.map (χ₀.comp (u.appLE U V e).hom) (F (ι i)))
      (fun l => χ₀ (p (MvPolynomial.X l))) := by
    obtain ⟨α, β, h1, h2, h3⟩ := hPNT
    unfold wcpaLquPNT
    refine ⟨α, β, ?_, ?_, ?_⟩
    · rw [← hsat 2]; exact h1
    · rw [← hsat 2]; exact h2
    · rw [← hsat 3]; exact h3

  obtain ⟨σ, hσ⟩ := wcpa_dj_lqu_pnt_span _ m (m - 1)
    (fun i => MvPolynomial.map (χ₀.comp (u.appLE U V e).hom) (F (ι i)))
    (fun l => χ₀ (p (MvPolynomial.X l))) (fun i => hF0 (ι i)) hPNT'
  have hGen : ∀ s, MvPolynomial.map (χ₀.comp (u.appLE U V e).hom)
      (wcpaLquGen (fun k => F (ι k)) s) =
      wcpaLquGen (fun k => MvPolynomial.map (χ₀.comp (u.appLE U V e).hom) (F (ι k))) s := by
    intro s
    rcases s with i | q
    · rfl
    · simp only [wcpaLquGen, Sum.elim_inr]
      rw [RingHom.map_det]
      congr 1
      ext i j
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply]
      rw [MvPolynomial.pderiv_map]
  obtain ⟨D, hDdef⟩ : ∃ D : MvPolynomial (Fin m) Γ(T, U), D =
      (Matrix.of fun i l => MvPolynomial.pderiv l (wcpaLquGen (fun k => F (ι k)) (σ i))).det :=
    ⟨_, rfl⟩
  have hD : χ₀ (p D) ≠ 0 := by
    have hM : (MvPolynomial.eval (fun l => χ₀ (p (MvPolynomial.X l)))).mapMatrix
        ((MvPolynomial.map (χ₀.comp (u.appLE U V e).hom)).mapMatrix
          (Matrix.of fun i l => MvPolynomial.pderiv l (wcpaLquGen (fun k => F (ι k)) (σ i)))) =
        Matrix.of fun i l => MvPolynomial.eval (fun l => χ₀ (p (MvPolynomial.X l)))
          (MvPolynomial.pderiv l (wcpaLquGen
            (fun k => MvPolynomial.map (χ₀.comp (u.appLE U V e).hom) (F (ι k))) (σ i))) := by
      ext i l
      simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.of_apply]
      rw [← MvPolynomial.pderiv_map, hGen]
    rw [key, hDdef, RingHom.map_det, RingHom.map_det, hM]
    exact hσ
  have hb0 : χ₀ (p (f * D)) ≠ 0 := by
    rw [map_mul, map_mul]
    exact mul_ne_zero (by rw [key]; exact hf0) hD

  have hbo : ∀ (P : PrimeSpectrum Γ(Z, V)) (b : Γ(Z, V)),
      hV.fromSpec P ∈ Z.basicOpen b ↔ b ∉ P.asIdeal := by
    intro P b
    refine (Scheme.Hom.mem_preimage hV.fromSpec).symm.trans ?_
    rw [hV.fromSpec_preimage_basicOpen]
    exact PrimeSpectrum.mem_basicOpen _ _
  refine ⟨Z.basicOpen (p (f * D)), ?_, ?_⟩
  · rw [← hw₀1, hχ₀z, hbo]
    exact fun h => hb0 (RingHom.mem_ker.mp h)
  · intro K _ _ s w hwO
    have hxV : Limits.pullback.fst u s w ∈ V := Z.basicOpen_le _ hwO
    have hb𝔭 : p (f * D) ∉ (hV.primeIdealOf ⟨_, hxV⟩).asIdeal := by
      rw [← hbo, hV.fromSpec_primeIdealOf]
      exact hwO
    have hf𝔭 : p f ∉ (hV.primeIdealOf ⟨_, hxV⟩).asIdeal := fun h =>
      hb𝔭 (by rw [map_mul]; exact Ideal.mul_mem_right _ _ h)
    have hD𝔭 : p D ∉ (hV.primeIdealOf ⟨_, hxV⟩).asIdeal := fun h =>
      hb𝔭 (by rw [map_mul]; exact Ideal.mul_mem_left _ _ h)
    by_cases hcase : ∃ q, p (wcpaLquGen (fun k => F (ι k)) (Sum.inr q)) ∉
        (hV.primeIdealOf ⟨_, hxV⟩).asIdeal
    ·
      obtain ⟨q, hq⟩ := hcase
      have hq1 : Function.Injective q.1 := by
        intro a b hab
        by_contra hne
        apply hq
        have h0 : wcpaLquGen (fun k => F (ι k)) (Sum.inr q) = 0 := by
          simp only [wcpaLquGen, Sum.elim_inr]
          exact Matrix.det_zero_of_row_eq hne (by funext j; simp only [Matrix.of_apply, hab])
        rw [h0, map_zero]
        exact Ideal.zero_mem _
      have hq2 : Function.Injective q.2 := by
        intro a b hab
        by_contra hne
        apply hq
        have h0 : wcpaLquGen (fun k => F (ι k)) (Sum.inr q) = 0 := by
          simp only [wcpaLquGen, Sum.elim_inr]
          exact Matrix.det_zero_of_column_eq hne (fun i => by simp only [Matrix.of_apply, hab])
        rw [h0, map_zero]
        exact Ideal.zero_mem _
      have hb : p (f * wcpaLquGen (fun k => F (ι k)) (Sum.inr q)) ∉
          (hV.primeIdealOf ⟨_, hxV⟩).asIdeal := by
        rw [map_mul]
        intro h
        rcases (hV.primeIdealOf ⟨_, hxV⟩).isPrime.mem_or_mem h with h' | h'
        · exact hf𝔭 h'
        · exact hq h'
      obtain ⟨U', hU', V', hV', hxV', e', hstd'⟩ := wcpa_dj_cf_ss_chart_of_away Z T u 1 U hU V hV e
        _ hxV _ hb
        (wcpa_dj_sno_jacobian_smooth Γ(T, U) Γ(Z, V) m r p F ι f q hm2 hpC hps hker hfF hq1 hq2)
      exact Or.inl (s1 K s w V' hxV' (wcpa_dj_mn_fs_chart_smooth u 1 U' hU' V' hV' e' hstd'))
    ·
      push_neg at hcase
      exact Or.inr (wcpa_dj_sno_case_ii T Z u U hU V hV e m r p F ι f σ hpC hps hker hfp hfF _ hxV
        hf𝔭 (by rw [← hDdef]; exact hD𝔭) hcase K s w rfl)

theorem wcpa_dj_lqr_basechange_stalk : ∀ (K L : Type u) [Field K] [Field L] [Algebra K L] (X : Scheme.{u}) (a : X ⟶ Spec (.of K)) (τ : Spec (.of K) ⟶ X), τ ≫ a = 𝟙 _ → ∀ (τ' : Spec (.of L) ⟶ Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))), τ' ≫ Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap K L))) = 𝟙 _ → τ' ≫ Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L))) = Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ τ → ∃ h : X.presheaf.stalk (τ (IsLocalRing.closedPoint K)) →+* (Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).presheaf.stalk (τ' (IsLocalRing.closedPoint L)), h.comp ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ (τ (IsLocalRing.closedPoint K)) trivial).hom = ((Scheme.ΓSpecIso (.of L)).inv ≫ (Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).appTop ≫ (Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).presheaf.germ ⊤ (τ' (IsLocalRing.closedPoint L)) trivial).hom.comp (algebraMap K L) ∧ h.Flat ∧ Ideal.map h (IsLocalRing.maximalIdeal (X.presheaf.stalk (τ (IsLocalRing.closedPoint K)))) = IsLocalRing.maximalIdeal ((Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).presheaf.stalk (τ' (IsLocalRing.closedPoint L))) :=
by
  intro K L _ _ _ X a τ hτ τ' _hτ's hτ'f
  have hLFI : ∀ (K L : Type u) [Field K] [Field L] (τ : K →+* L) (Z Y : Scheme.{u}) (q : Z ⟶ Spec (.of K)) (p : Y ⟶ Spec (.of L)) (s : Y ⟶ Z), IsPullback s p q (Spec.map (CommRingCat.ofHom τ)) → ∀ (σ : Spec (.of K) ⟶ Z), σ ≫ q = 𝟙 _ → ∀ (y : Y), s y ∈ Set.range σ → Ideal.map (s.stalkMap y).hom (IsLocalRing.maximalIdeal (Z.presheaf.stalk (s y))) = IsLocalRing.maximalIdeal (Y.presheaf.stalk y) := by
    intro K L _ _ τ Z Y q p s pb σ hσ y hsy

    have s1 : ∀ (z : Z), z ∈ Set.range σ → ∃ e : Z.presheaf.stalk z ⟶ Z.presheaf.stalk z,
        Z.fromSpecStalk z ≫ q ≫ σ = Spec.map e ≫ Z.fromSpecStalk z ∧
        ∀ a : Z.presheaf.stalk z, a - e.hom a ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk z) := by
      rintro _ ⟨w, rfl⟩
      obtain rfl : w = IsLocalRing.closedPoint K := Subsingleton.elim _ _
      have hχ : Spec.map (Scheme.stalkClosedPointTo σ) ≫ Z.fromSpecStalk _ = σ :=
        Scheme.Spec_stalkClosedPointTo_fromSpecStalk σ
      have hκ : Spec.map (Spec.preimage (Z.fromSpecStalk (σ (IsLocalRing.closedPoint K)) ≫ q)) =
          Z.fromSpecStalk _ ≫ q := Spec.map_preimage _
      have hret : Spec.preimage (Z.fromSpecStalk (σ (IsLocalRing.closedPoint K)) ≫ q) ≫
          Scheme.stalkClosedPointTo σ = 𝟙 _ := by
        apply Spec.map_injective
        rw [Spec.map_comp, hκ, ← Category.assoc, hχ, hσ, Spec.map_id]
      have hret' : ∀ k, (Scheme.stalkClosedPointTo σ).hom
          ((Spec.preimage (Z.fromSpecStalk (σ (IsLocalRing.closedPoint K)) ≫ q)).hom k) = k := by
        intro k
        rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, hret]
        rfl
      refine ⟨Scheme.stalkClosedPointTo σ ≫
        Spec.preimage (Z.fromSpecStalk (σ (IsLocalRing.closedPoint K)) ≫ q), ?_, ?_⟩
      · rw [Spec.map_comp, Category.assoc, hχ, hκ, Category.assoc]
      · intro a
        have h0 : (Scheme.stalkClosedPointTo σ).hom (a - (Scheme.stalkClosedPointTo σ ≫
            Spec.preimage (Z.fromSpecStalk (σ (IsLocalRing.closedPoint K)) ≫ q)).hom a) = 0 := by
          rw [map_sub, CommRingCat.hom_comp, RingHom.comp_apply, hret', sub_self]
        by_contra hn
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not] at hn
        have hu := hn.map (Scheme.stalkClosedPointTo σ).hom
        rw [h0] at hu
        exact not_isUnit_zero hu

    have s2 : ∀ (σ' : Spec (.of L) ⟶ Y) (y : Y), y ∈ Set.range σ' → ∀ (C : CommRingCat.{u})
        (π : Y.presheaf.stalk y ⟶ C) (k : Spec C ⟶ Spec (.of L)),
        Spec.map π ≫ Y.fromSpecStalk y = k ≫ σ' →
        ∀ b ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk y), π.hom b = 0 := by
      rintro σ' _ ⟨w, rfl⟩ C π k hk b hb
      obtain rfl : w = IsLocalRing.closedPoint L := Subsingleton.elim _ _
      have hχ : Spec.map (Scheme.stalkClosedPointTo σ') ≫ Y.fromSpecStalk _ = σ' :=
        Scheme.Spec_stalkClosedPointTo_fromSpecStalk σ'
      have hπ : π = Scheme.stalkClosedPointTo σ' ≫ Spec.preimage k := by
        apply Spec.map_injective
        rw [← cancel_mono (Y.fromSpecStalk _), hk, Spec.map_comp, Spec.map_preimage,
          Category.assoc, hχ]
      have h0 : (Scheme.stalkClosedPointTo σ').hom b = 0 := by
        by_contra hne
        have hu : IsUnit ((Scheme.stalkClosedPointTo σ').hom b) := isUnit_iff_ne_zero.mpr hne
        exact (IsLocalRing.mem_maximalIdeal _).mp hb (isUnit_of_map_unit _ b hu)
      rw [hπ, CommRingCat.hom_comp, RingHom.comp_apply, h0, map_zero]

    set I := Ideal.map (s.stalkMap y).hom (IsLocalRing.maximalIdeal (Z.presheaf.stalk (s y)))
      with hIdef
    have hle : I ≤ IsLocalRing.maximalIdeal (Y.presheaf.stalk y) :=
      IsLocalRing.map_maximalIdeal_le (s.stalkMap y).hom
    refine le_antisymm hle ?_
    have hI : I ≠ ⊤ := fun h =>
      (IsLocalRing.maximalIdeal.isMaximal _).ne_top (top_le_iff.mp (h ▸ hle))
    haveI : Nontrivial (Y.presheaf.stalk y ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
    haveI : IsLocalRing (Y.presheaf.stalk y ⧸ I) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
    let C : CommRingCat.{u} := CommRingCat.of (Y.presheaf.stalk y ⧸ I)
    let πc : Y.presheaf.stalk y ⟶ C := CommRingCat.ofHom (Ideal.Quotient.mk I)
    haveI : IsLocalHom πc.hom := IsLocalHom.of_surjective _ Ideal.Quotient.mk_surjective
    obtain ⟨h, hh⟩ : ∃ h : Spec C ⟶ Y, h = Spec.map πc ≫ Y.fromSpecStalk y := ⟨_, rfl⟩

    obtain ⟨e, he1, he2⟩ := s1 (s y) hsy
    have hhs : h ≫ s = Spec.map (s.stalkMap y ≫ πc) ≫ Z.fromSpecStalk (s y) := by
      rw [hh, Spec.map_comp, Category.assoc, Category.assoc,
        Scheme.SpecMap_stalkMap_fromSpecStalk]
    have hkill : e ≫ s.stalkMap y ≫ πc = s.stalkMap y ≫ πc := by
      ext a
      simp only [CommRingCat.hom_comp, RingHom.comp_apply]
      rw [← sub_eq_zero, ← map_sub, ← map_sub]
      have hm : e.hom a - a ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk (s y)) := by
        rw [← neg_sub]; exact neg_mem (he2 a)
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hm)
    have H4 : h ≫ s ≫ q ≫ σ = h ≫ s := by
      rw [← Category.assoc h s, hhs, Category.assoc, he1, ← Category.assoc, ← Spec.map_comp, hkill]

    have hw : (Spec.map (CommRingCat.ofHom τ) ≫ σ) ≫ q = 𝟙 _ ≫ Spec.map (CommRingCat.ofHom τ) := by
      rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]
    obtain ⟨σ', hσ's, hσ'p⟩ : ∃ σ' : Spec (.of L) ⟶ Y,
        σ' ≫ s = Spec.map (CommRingCat.ofHom τ) ≫ σ ∧ σ' ≫ p = 𝟙 _ :=
      ⟨pb.lift _ _ hw, pb.lift_fst _ _ hw, pb.lift_snd _ _ hw⟩

    have H6 : h = (h ≫ p) ≫ σ' := by
      apply pb.hom_ext
      · symm
        simp only [Category.assoc, hσ's]
        rw [← Category.assoc p, ← pb.w, Category.assoc, H4]
      · rw [Category.assoc, hσ'p, Category.comp_id]

    obtain ⟨c, hc⟩ : ∃ c : Spec C, Spec.map πc c = IsLocalRing.closedPoint (Y.presheaf.stalk y) :=
      ⟨IsLocalRing.closedPoint C, IsLocalRing.comap_closedPoint πc.hom⟩
    have hhcp : h c = y := by
      rw [hh, Scheme.Hom.comp_apply, hc, Scheme.fromSpecStalk_closedPoint]
    have hyr : y ∈ Set.range σ' :=
      ⟨(h ≫ p) c, by rw [← Scheme.Hom.comp_apply, ← H6, hhcp]⟩

    intro b hb
    have hb0 := s2 σ' y hyr C πc (h ≫ p) (by rw [← H6, hh]) b hb
    exact Ideal.Quotient.eq_zero_iff_mem.mp hb0
  have e : Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L))) (τ' (IsLocalRing.closedPoint L)) =
      τ (IsLocalRing.closedPoint K) := by
    have key : ∀ x : ↥(Spec (.of L)), Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L))) (τ' x) = τ ((Spec.map (CommRingCat.ofHom (algebraMap K L))) x) := by
      intro x
      rw [← Scheme.Hom.comp_apply, hτ'f, Scheme.Hom.comp_apply]
    refine (key _).trans ?_
    have hx : (Spec.map (CommRingCat.ofHom (algebraMap K L))) (IsLocalRing.closedPoint L) = IsLocalRing.closedPoint K :=
      Subsingleton.elim (α := PrimeSpectrum K) _ _
    first
      | exact congrArg (fun y : ↥(Spec (.of K)) => τ y) hx
      | rw [hx]
  have hC : ∀ y : ↥(Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))),
      ((Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).stalkMap y).hom.comp ((Scheme.ΓSpecIso (.of K)).inv ≫
        a.appTop ≫ X.presheaf.germ ⊤ (Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L))) y) trivial).hom =
      ((Scheme.ΓSpecIso (.of L)).inv ≫ (Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).appTop ≫
        (Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).presheaf.germ ⊤ y trivial).hom.comp (algebraMap K L) := by
    intro y
    have key : ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫
        X.presheaf.germ ⊤ (Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L))) y) trivial) ≫
          (Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).stalkMap y =
        CommRingCat.ofHom (algebraMap K L) ≫ (Scheme.ΓSpecIso (.of L)).inv ≫
          (Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).appTop ≫
          (Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).presheaf.germ ⊤ y trivial := by
      have h1 : X.presheaf.germ ⊤ (Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L))) y) trivial ≫
          (Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).stalkMap y =
          (Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).appTop ≫ (Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).presheaf.germ ⊤ y trivial :=
        Scheme.Hom.germ_stalkMap (Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L)))) ⊤ y trivial
      have h2 : a.appTop ≫ (Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).appTop =
          (Spec.map (CommRingCat.ofHom (algebraMap K L))).appTop ≫ (Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).appTop := by
        rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, Limits.pullback.condition]
      have h3 := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap K L))
      rw [Category.assoc, Category.assoc, h1, ← Category.assoc a.appTop, h2,
        ← Category.assoc, ← Category.assoc, ← h3]
      simp only [Category.assoc]
    have := congrArg (fun f => f.hom) key
    simpa only [CommRingCat.hom_comp, CommRingCat.hom_ofHom] using this
  have hF : ((Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).stalkMap (τ' (IsLocalRing.closedPoint L))).hom.Flat :=
    Flat.stalkMap (Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L)))) _
  have hM := hLFI K L (algebraMap K L) X (Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))) a (Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap K L))))
    (Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L)))) (IsPullback.of_hasPullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))) τ hτ
    (τ' (IsLocalRing.closedPoint L)) ⟨IsLocalRing.closedPoint K, e.symm⟩
  have hC0 := hC (τ' (IsLocalRing.closedPoint L))
  have gen : ∀ (x : ↥X), Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L))) (τ' (IsLocalRing.closedPoint L)) = x →
      ∃ h : X.presheaf.stalk x →+* (Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).presheaf.stalk (τ' (IsLocalRing.closedPoint L)),
        h.comp ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ x trivial).hom =
          ((Scheme.ΓSpecIso (.of L)).inv ≫ (Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).appTop ≫
            (Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).presheaf.germ ⊤ (τ' (IsLocalRing.closedPoint L)) trivial).hom.comp
            (algebraMap K L) ∧
        h.Flat ∧ Ideal.map h (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) =
          IsLocalRing.maximalIdeal ((Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).presheaf.stalk (τ' (IsLocalRing.closedPoint L))) := by
    rintro x rfl
    exact ⟨((Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).stalkMap (τ' (IsLocalRing.closedPoint L))).hom, hC0, hF, hM⟩
  exact gen _ e

theorem wcpa_dj_lqr_flat_hilb_eq : ∀ (K L : Type u) [Field K] [Field L] (ι : K →+* L) (R R' : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [CommRing R'] [IsLocalRing R'] [IsNoetherianRing R'] (φ : K →+* R) (φ' : L →+* R') (h : R →+* R'), h.comp φ = φ'.comp ι → h.Flat → Ideal.map h (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal R' → (∀ y : R, ∃ c : K, y - φ c ∈ IsLocalRing.maximalIdeal R) → (∀ y : R', ∃ c : L, y - φ' c ∈ IsLocalRing.maximalIdeal R') → ∀ n : ℕ, (letI : Algebra L R' := φ'.toAlgebra; Module.finrank L (R' ⧸ IsLocalRing.maximalIdeal R' ^ n)) = (letI : Algebra K R := φ.toAlgebra; Module.finrank K (R ⧸ IsLocalRing.maximalIdeal R ^ n)) :=
by
  classical

  have s1 : ∀ (F S : Type u) [Field F] [CommRing S] (ψ : F →+* S) (𝔫 : Ideal S) (n : ℕ)
      (d : ℕ → ℕ) (v : ∀ j : ℕ, Fin (d j) → S),
      (∀ j < n, ∀ i, v j i ∈ 𝔫 ^ j) →
      (∀ j < n, ∀ x ∈ 𝔫 ^ j, ∃ c : Fin (d j) → F, x - ∑ i, ψ (c i) * v j i ∈ 𝔫 ^ (j + 1)) →
      (∀ j < n, ∀ c : Fin (d j) → F, ∑ i, ψ (c i) * v j i ∈ 𝔫 ^ (j + 1) → ∀ i, c i = 0) →
      (letI : Algebra F S := ψ.toAlgebra; Module.finrank F (S ⧸ 𝔫 ^ n)) =
        ∑ j ∈ Finset.range n, d j := by
    intro F S _ _ ψ 𝔫 n d v h0 hs hi
    letI : Algebra F S := ψ.toAlgebra
    let u : (Σ j : Fin n, Fin (d j)) → S ⧸ 𝔫 ^ n := fun p => Ideal.Quotient.mk _ (v p.1 p.2)
    have hsmul : ∀ (c : F) (x : S), c • (Ideal.Quotient.mk (𝔫 ^ n) x) =
        Ideal.Quotient.mk (𝔫 ^ n) (ψ c * x) := by
      intro c x
      rw [Algebra.smul_def, ← Ideal.Quotient.mk_algebraMap, RingHom.algebraMap_toAlgebra, ← map_mul]
    have hcomb : ∀ g : (Σ j : Fin n, Fin (d j)) → F,
        ∑ p, g p • u p = Ideal.Quotient.mk (𝔫 ^ n) (∑ p, ψ (g p) * v p.1 p.2) := by
      intro g
      rw [map_sum]
      exact Finset.sum_congr rfl (fun p _ => hsmul _ _)
    have hspan : ∀ m ≤ n, ∀ x : S, ∃ g : (Σ j : Fin n, Fin (d j)) → F,
        x - ∑ p, ψ (g p) * v p.1 p.2 ∈ 𝔫 ^ m := by
      intro m
      induction m with
      | zero => intro _ x; exact ⟨0, by simp⟩
      | succ m ih =>
        intro hm x
        obtain ⟨g, hg⟩ := ih (by omega) x
        obtain ⟨c, hc⟩ := hs m (by omega) _ hg
        let e : (Σ j : Fin n, Fin (d j)) → F := fun p =>
          if hp : (p.1 : ℕ) = m then c (Fin.cast (by rw [hp]) p.2) else 0
        refine ⟨g + e, ?_⟩
        have key : ∑ p, ψ ((g + e) p) * v p.1 p.2 =
            ∑ p, ψ (g p) * v p.1 p.2 + ∑ i, ψ (c i) * v m i := by
          simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
          congr 1
          rw [Fintype.sum_sigma, Finset.sum_eq_single (⟨m, by omega⟩ : Fin n)]
          · simp [e]
          · intro j _ hj
            apply Finset.sum_eq_zero
            intro i _
            have hj' : (j : ℕ) ≠ m := fun hjm => hj (Fin.ext hjm)
            simp [e, hj']
          · intro hnot; exact absurd (Finset.mem_univ _) hnot
        rw [key, ← sub_sub]
        exact hc
    have hli : LinearIndependent F u := by
      rw [Fintype.linearIndependent_iff]
      intro g hg
      rw [hcomb, Ideal.Quotient.eq_zero_iff_mem] at hg
      have hall : ∀ j0 : ℕ, ∀ hj : j0 < n, ∀ i, g ⟨⟨j0, hj⟩, i⟩ = 0 := by
        intro j0
        induction j0 using Nat.strong_induction_on with
        | _ j0 ih =>
        intro hj
        apply hi j0 hj (fun i => g ⟨⟨j0, hj⟩, i⟩)
        have hsplit : ∑ p, ψ (g p) * v p.1 p.2 = ∑ i, ψ (g ⟨⟨j0, hj⟩, i⟩) * v j0 i +
            ∑ j ∈ Finset.univ.erase (⟨j0, hj⟩ : Fin n), ∑ i, ψ (g ⟨j, i⟩) * v j i := by
          rw [Fintype.sum_sigma, ← Finset.add_sum_erase _ _ (Finset.mem_univ (⟨j0, hj⟩ : Fin n))]
        have hrest : ∑ j ∈ Finset.univ.erase (⟨j0, hj⟩ : Fin n), ∑ i, ψ (g ⟨j, i⟩) * v j i ∈
            𝔫 ^ (j0 + 1) := by
          apply Ideal.sum_mem
          intro j hj'
          apply Ideal.sum_mem
          intro i _
          have hne : (j : ℕ) ≠ j0 := fun hjj => (Finset.ne_of_mem_erase hj') (Fin.ext hjj)
          rcases lt_or_gt_of_ne hne with hlt | hgt
          · have h1 := ih j hlt j.2 i
            simp only [Fin.eta] at h1
            rw [h1, map_zero, zero_mul]
            exact Ideal.zero_mem _
          · exact Ideal.mul_mem_left _ _ (Ideal.pow_le_pow_right hgt (h0 j j.2 i))
        have hT : ∑ p, ψ (g p) * v p.1 p.2 ∈ 𝔫 ^ (j0 + 1) := Ideal.pow_le_pow_right hj hg
        rw [hsplit] at hT
        have h2 := Ideal.sub_mem _ hT hrest
        simpa using h2
      intro p
      exact hall p.1 p.1.2 p.2
    have hsp : ⊤ ≤ Submodule.span F (Set.range u) := by
      rintro y -
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
      obtain ⟨g, hg⟩ := hspan n le_rfl x
      have hx : Ideal.Quotient.mk (𝔫 ^ n) x = ∑ p, g p • u p := by
        rw [hcomb]; exact Ideal.Quotient.eq.mpr hg
      rw [hx]
      exact Submodule.sum_mem _ (fun p _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨p, rfl⟩))
    let b := Module.Basis.mk hli hsp
    rw [Module.finrank_eq_card_basis b, Fintype.card_sigma]
    simp only [Fintype.card_fin]
    exact Fin.sum_univ_eq_sum_range d n

  have s2 : ∀ (K R : Type u) [Field K] [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
      (φ : K →+* R), (∀ y : R, ∃ c : K, y - φ c ∈ IsLocalRing.maximalIdeal R) → ∀ j : ℕ,
      ∃ (d : ℕ) (v : Fin d → R), (∀ i, v i ∈ IsLocalRing.maximalIdeal R ^ j) ∧
        (∀ x ∈ IsLocalRing.maximalIdeal R ^ j, ∃ c : Fin d → K,
          x - ∑ i, φ (c i) * v i ∈ IsLocalRing.maximalIdeal R ^ (j + 1)) ∧
        (∀ c : Fin d → K, ∑ i, φ (c i) * v i ∈ IsLocalRing.maximalIdeal R ^ (j + 1) →
          ∀ i, c i = 0) := by
    intro K R _ _ _ _ φ hres j
    letI : Algebra K R := φ.toAlgebra
    obtain ⟨t, g, hg⟩ := (Submodule.fg_iff_exists_fin_generating_family).mp
      (Ideal.fg_of_isNoetherianRing (IsLocalRing.maximalIdeal R ^ j))
    have hgmem : ∀ i, g i ∈ IsLocalRing.maximalIdeal R ^ j :=
      fun i => hg ▸ Submodule.subset_span ⟨i, rfl⟩
    have hsmul : ∀ (c : K) (x : R),
        c • (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ (j + 1)) x) =
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ (j + 1)) (φ c * x) := by
      intro c x
      rw [Algebra.smul_def, ← Ideal.Quotient.mk_algebraMap, RingHom.algebraMap_toAlgebra, ← map_mul]
    have key : ∀ x ∈ IsLocalRing.maximalIdeal R ^ j, ∃ e : Fin t → K,
        x - ∑ i, φ (e i) * g i ∈ IsLocalRing.maximalIdeal R ^ (j + 1) := by
      intro x hx
      rw [← hg] at hx
      obtain ⟨r, hr⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hx
      choose e he using fun i => hres (r i)
      refine ⟨e, ?_⟩
      rw [← hr, ← Finset.sum_sub_distrib]
      apply Ideal.sum_mem
      intro i _
      rw [← sub_mul, pow_succ']
      exact Ideal.mul_mem_mul (he i) (hgmem i)
    let W := Submodule.span K
      (Set.range fun i => Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ (j + 1)) (g i))
    haveI : FiniteDimensional K W := FiniteDimensional.span_of_finite K (Set.finite_range _)
    let b := Module.finBasis K W
    have hbW : ∀ l, ∃ a : Fin t → K,
        ∑ i, a i • Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ (j + 1)) (g i)
        = (b l : R ⧸ IsLocalRing.maximalIdeal R ^ (j + 1)) :=
      fun l => (Submodule.mem_span_range_iff_exists_fun K).mp (b l).2
    choose a ha using hbW
    have hmkv : ∀ l, Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ (j + 1)) (∑ i, φ (a l i) * g i)
        = (b l : R ⧸ IsLocalRing.maximalIdeal R ^ (j + 1)) := by
      intro l
      rw [← ha l, map_sum]
      exact Finset.sum_congr rfl (fun i _ => (hsmul _ _).symm)
    refine ⟨Module.finrank K W, fun l => ∑ i, φ (a l i) * g i, ?_, ?_, ?_⟩
    · intro l
      exact Ideal.sum_mem _ (fun i _ => Ideal.mul_mem_left _ _ (hgmem i))
    · intro x hx
      obtain ⟨e, he⟩ := key x hx
      have hxW : Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ (j + 1)) x ∈ W := by
        have hx' : Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ (j + 1)) x =
            ∑ i, e i • Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ (j + 1)) (g i) := by
          rw [Ideal.Quotient.eq.mpr he, map_sum]
          exact Finset.sum_congr rfl (fun i _ => (hsmul _ _).symm)
        rw [hx']
        exact Submodule.sum_mem _
          (fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))
      obtain ⟨cc, hcc⟩ : ∃ cc : Fin (Module.finrank K W) → K,
          ∑ l, cc l • (b l : R ⧸ IsLocalRing.maximalIdeal R ^ (j + 1)) =
            Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ (j + 1)) x := by
        refine ⟨fun l => b.repr ⟨_, hxW⟩ l, ?_⟩
        have h2 : ((∑ l, b.repr ⟨_, hxW⟩ l • b l : W) :
            R ⧸ IsLocalRing.maximalIdeal R ^ (j + 1)) =
            Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ (j + 1)) x := by
          rw [b.sum_repr]
        rw [Submodule.coe_sum] at h2
        simpa only [Submodule.coe_smul] using h2
      refine ⟨cc, ?_⟩
      rw [← Ideal.Quotient.eq, ← hcc, map_sum]
      exact Finset.sum_congr rfl (fun l _ => by rw [← hmkv l, hsmul])
    · intro c hc
      have h0 : ∑ l, c l • b l = 0 := by
        apply Subtype.ext
        rw [Submodule.coe_sum]
        simp only [Submodule.coe_smul, Submodule.coe_zero]
        refine Eq.trans ?_ (Ideal.Quotient.eq_zero_iff_mem.mpr hc)
        rw [map_sum]
        exact Finset.sum_congr rfl (fun l _ => by rw [← hmkv l, hsmul])
      exact (Fintype.linearIndependent_iff.mp b.linearIndependent) c h0

  have s3 : ∀ (K L : Type u) [Field K] [Field L] (ι : K →+* L) (R R' : Type u) [CommRing R]
      [IsLocalRing R] [CommRing R'] [IsLocalRing R'] (φ : K →+* R) (φ' : L →+* R')
      (h : R →+* R'), h.comp φ = φ'.comp ι →
      Ideal.map h (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal R' →
      (∀ y : R', ∃ c : L, y - φ' c ∈ IsLocalRing.maximalIdeal R') →
      ∀ (j d : ℕ) (v : Fin d → R), (∀ i, v i ∈ IsLocalRing.maximalIdeal R ^ j) →
      (∀ x ∈ IsLocalRing.maximalIdeal R ^ j, ∃ c : Fin d → K,
        x - ∑ i, φ (c i) * v i ∈ IsLocalRing.maximalIdeal R ^ (j + 1)) →
      (∀ i, h (v i) ∈ IsLocalRing.maximalIdeal R' ^ j) ∧
      (∀ x ∈ IsLocalRing.maximalIdeal R' ^ j, ∃ c : Fin d → L,
        x - ∑ i, φ' (c i) * h (v i) ∈ IsLocalRing.maximalIdeal R' ^ (j + 1)) := by
    intro K L _ _ ι R R' _ _ _ _ φ φ' h hcomp hmax hres' j d v h0 hs
    have hpow : ∀ k, Ideal.map h (IsLocalRing.maximalIdeal R ^ k) =
        IsLocalRing.maximalIdeal R' ^ k := fun k => by rw [Ideal.map_pow, hmax]
    have hφ : ∀ c, h (φ c) = φ' (ι c) := fun c => RingHom.congr_fun hcomp c
    refine ⟨fun i => hpow j ▸ Ideal.mem_map_of_mem h (h0 i), ?_⟩
    intro x hx
    rw [← hpow j] at hx
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hx
    · rintro y ⟨m, hm, rfl⟩
      obtain ⟨a, ha⟩ := hs m hm
      refine ⟨fun i => ι (a i), ?_⟩
      have hh := Ideal.mem_map_of_mem h ha
      rw [hpow, map_sub, map_sum] at hh
      simp only [map_mul, hφ] at hh
      exact hh
    · exact ⟨0, by simp⟩
    · rintro x y _ _ ⟨c, hc⟩ ⟨e, he⟩
      refine ⟨c + e, ?_⟩
      convert Ideal.add_mem _ hc he using 1
      simp only [Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
      ring
    · rintro r x hx ⟨c, hc⟩
      obtain ⟨e₀, he₀⟩ := hres' r
      refine ⟨fun i => e₀ * c i, ?_⟩
      have hx' : x ∈ IsLocalRing.maximalIdeal R' ^ j := by rw [← hpow]; exact hx
      have h1 := Ideal.mul_mem_left (IsLocalRing.maximalIdeal R' ^ (j + 1)) (φ' e₀) hc
      have h2 : (r - φ' e₀) * x ∈ IsLocalRing.maximalIdeal R' ^ (j + 1) := by
        rw [pow_succ']; exact Ideal.mul_mem_mul he₀ hx'
      convert Ideal.add_mem _ h1 h2 using 1
      simp only [smul_eq_mul, map_mul, mul_sub, Finset.mul_sum, mul_assoc]
      ring

  have s4flat : ∀ (R R' : Type u) [CommRing R] [CommRing R'] (h : R →+* R'), h.Flat →
      ∀ (d s : ℕ) (v : Fin d → R) (z : Fin s → R) (y : Fin d → R') (r' : Fin s → R'),
      ∑ i, h (v i) * y i = ∑ k, h (z k) * r' k →
      ∃ (k : ℕ) (a : Fin d ⊕ Fin s → Fin k → R) (w : Fin k → R'),
        (∀ i, y i = ∑ l, h (a (Sum.inl i) l) * w l) ∧
        ∀ l, ∑ i, v i * a (Sum.inl i) l + ∑ k, z k * a (Sum.inr k) l = 0 := by
    intro R R' _ _ h hflat d s v z y r' e1
    letI : Algebra R R' := h.toAlgebra
    haveI : Module.Flat R R' := hflat
    obtain ⟨f, hf⟩ : ∃ f : Fin d ⊕ Fin s → R, f = Sum.elim v z := ⟨_, rfl⟩
    obtain ⟨x, hx⟩ : ∃ x : Fin d ⊕ Fin s → R', x = Sum.elim y (fun k => - r' k) := ⟨_, rfl⟩
    have hrel : ∑ p, f p • x p = 0 := by
      rw [Fintype.sum_sum_type, hf, hx]
      have ea : ∀ i, (Sum.elim v z (Sum.inl i) : R) • (Sum.elim y (fun k => - r' k) (Sum.inl i) : R')
          = h (v i) * y i := fun i => rfl
      have eb : ∀ k, (Sum.elim v z (Sum.inr k) : R) • (Sum.elim y (fun k => - r' k) (Sum.inr k) : R')
          = -(h (z k) * r' k) := fun k => by
        show h (z k) * (- r' k) = _
        ring
      simp only [ea, eb, Finset.sum_neg_distrib, e1, add_neg_cancel]
    have H : Module.IsTrivialRelation f x := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero hrel
    obtain ⟨k, a, w, hxa, hfa⟩ := H
    refine ⟨k, a, w, fun i => ?_, fun l => ?_⟩
    · have := hxa (Sum.inl i)
      rw [hx] at this
      exact this
    · have e2 := hfa l
      rw [Fintype.sum_sum_type, hf] at e2
      exact e2
  have s4 : ∀ (K L : Type u) [Field K] [Field L] (R R' : Type u) [CommRing R] [IsLocalRing R]
      [IsNoetherianRing R] [CommRing R'] [IsLocalRing R'] (φ : K →+* R) (φ' : L →+* R')
      (h : R →+* R'), h.Flat →
      Ideal.map h (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal R' →
      (∀ y : R, ∃ c : K, y - φ c ∈ IsLocalRing.maximalIdeal R) →
      ∀ (j d : ℕ) (v : Fin d → R), (∀ i, v i ∈ IsLocalRing.maximalIdeal R ^ j) →
      (∀ c : Fin d → K, ∑ i, φ (c i) * v i ∈ IsLocalRing.maximalIdeal R ^ (j + 1) →
        ∀ i, c i = 0) →
      ∀ c : Fin d → L, ∑ i, φ' (c i) * h (v i) ∈ IsLocalRing.maximalIdeal R' ^ (j + 1) →
        ∀ i, c i = 0 := by
    intro K L _ _ R R' _ _ _ _ _ φ φ' h hflat hmax hres j d v h0 hi c hc
    obtain ⟨s, z, hz⟩ := (Submodule.fg_iff_exists_fin_generating_family).mp
      (Ideal.fg_of_isNoetherianRing (IsLocalRing.maximalIdeal R ^ (j + 1)))
    have hz' : Ideal.span (Set.range z) = IsLocalRing.maximalIdeal R ^ (j + 1) := hz
    have hzmem : ∀ k, z k ∈ IsLocalRing.maximalIdeal R ^ (j + 1) := by
      intro k; rw [← hz']; exact Ideal.subset_span ⟨k, rfl⟩
    have hspan' : IsLocalRing.maximalIdeal R' ^ (j + 1) =
        Ideal.span (Set.range (fun k => h (z k))) := by
      rw [← hmax, ← Ideal.map_pow, ← hz', Ideal.map_span, ← Set.range_comp]
      rfl
    rw [hspan', Ideal.mem_span_range_iff_exists_fun] at hc
    obtain ⟨r', hr'⟩ := hc
    have e1 : ∑ i, h (v i) * φ' (c i) = ∑ k, h (z k) * r' k := by
      rw [← Finset.sum_congr rfl (fun k _ => mul_comm (r' k) (h (z k))), hr']
      exact Finset.sum_congr rfl (fun i _ => mul_comm _ _)
    obtain ⟨k, a, w, hxa, hfa⟩ := s4flat R R' h hflat d s v z (fun i => φ' (c i)) r' e1
    have ha_m : ∀ i l, a (Sum.inl i) l ∈ IsLocalRing.maximalIdeal R := by
      intro i l
      choose b hb using fun i => hres (a (Sum.inl i) l)
      have hb0 := hi b ?_
      · have h3 := hb i
        rw [hb0 i, map_zero, sub_zero] at h3
        exact h3
      · have e2' := hfa l
        have e3 : ∑ i, v i * a (Sum.inl i) l ∈ IsLocalRing.maximalIdeal R ^ (j + 1) := by
          rw [eq_neg_of_add_eq_zero_left e2']
          exact (Ideal.neg_mem_iff _).mpr
            (Ideal.sum_mem _ fun k _ => Ideal.mul_mem_right _ _ (hzmem k))
        have e4 : ∑ i, v i * a (Sum.inl i) l - ∑ i, φ (b i) * v i ∈
            IsLocalRing.maximalIdeal R ^ (j + 1) := by
          rw [← Finset.sum_sub_distrib]
          apply Ideal.sum_mem
          intro i _
          rw [show v i * a (Sum.inl i) l - φ (b i) * v i = (a (Sum.inl i) l - φ (b i)) * v i by ring,
            pow_succ']
          exact Ideal.mul_mem_mul (hb i) (h0 i)
        have h5 := Ideal.sub_mem _ e3 e4
        rwa [sub_sub_cancel] at h5
    intro i
    by_contra hne
    have hxi : φ' (c i) = ∑ l, h (a (Sum.inl i) l) * w l := hxa i
    have hmem : φ' (c i) ∈ IsLocalRing.maximalIdeal R' := by
      rw [hxi]
      apply Ideal.sum_mem
      intro l _
      apply Ideal.mul_mem_right
      rw [← hmax]
      exact Ideal.mem_map_of_mem h (ha_m i l)
    have hu : IsUnit (φ' (c i)) := (Ne.isUnit hne).map φ'
    exact (IsLocalRing.notMem_maximalIdeal.mpr hu) hmem

  intro K L _ _ ι R R' _ _ _ _ _ _ φ φ' h hcomp hflat hmax hres hres' n
  choose d v hv using fun j => s2 K R φ hres j
  have eR := s1 K R φ (IsLocalRing.maximalIdeal R) n d v (fun j _ => (hv j).1)
    (fun j _ => (hv j).2.1) (fun j _ => (hv j).2.2)
  have eR' := s1 L R' φ' (IsLocalRing.maximalIdeal R') n d (fun j i => h (v j i))
    (fun j _ => (s3 K L ι R R' φ φ' h hcomp hmax hres' j (d j) (v j) (hv j).1 (hv j).2.1).1)
    (fun j _ => (s3 K L ι R R' φ φ' h hcomp hmax hres' j (d j) (v j) (hv j).1 (hv j).2.1).2)
    (fun j _ c hc => s4 K L R R' φ φ' h hflat hmax hres j (d j) (v j) (hv j).1 (hv j).2.2 c hc)
  exact eR'.trans eR.symm

theorem wcpa_dj_gnc_rational_node_bc : ∀ (κ K : Type u) [Field κ] [Field K] [Algebra κ K] (X : Scheme.{u}) (a : X ⟶ Spec (.of κ)) [LocallyOfFiniteType a] (τ : Spec (.of κ) ⟶ X), τ ≫ a = 𝟙 _ → (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk (τ (IsLocalRing.closedPoint κ)))) (X.presheaf.stalk (τ (IsLocalRing.closedPoint κ))) ≃+* (MvPowerSeries (Fin 2) κ ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap (X.presheaf.stalk (τ (IsLocalRing.closedPoint κ))) (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk (τ (IsLocalRing.closedPoint κ)))) (X.presheaf.stalk (τ (IsLocalRing.closedPoint κ))))).comp (wcpaLqPhi κ X a (τ (IsLocalRing.closedPoint κ)))) = (Ideal.Quotient.mk _).comp MvPowerSeries.C) → ∀ (τ' : Spec (.of K) ⟶ Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap κ K)))), τ' ≫ Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap κ K))) = 𝟙 _ → τ' ≫ Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap κ K))) = Spec.map (CommRingCat.ofHom (algebraMap κ K)) ≫ τ → ∃ e' : AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap κ K)))).presheaf.stalk (τ' (IsLocalRing.closedPoint K)))) ((Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap κ K)))).presheaf.stalk (τ' (IsLocalRing.closedPoint K))) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e'.toRingHom.comp ((algebraMap ((Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap κ K)))).presheaf.stalk (τ' (IsLocalRing.closedPoint K))) (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap κ K)))).presheaf.stalk (τ' (IsLocalRing.closedPoint K)))) ((Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap κ K)))).presheaf.stalk (τ' (IsLocalRing.closedPoint K))))).comp (wcpaLqPhi K (Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap κ K)))) (Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap κ K)))) (τ' (IsLocalRing.closedPoint K)))) = (Ideal.Quotient.mk _).comp MvPowerSeries.C :=
by
  intro κ K _ _ _ X a _ τ hτ hE τ' hτ'1 hτ'2
  classical


  have core : ∀ (R R' : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
      [CommRing R'] [IsLocalRing R'] [IsNoetherianRing R']
      (φ : κ →+* R) (φ' : K →+* R') (h : R →+* R'),
      h.comp φ = φ'.comp (algebraMap κ K) → h.Flat →
      Ideal.map h (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal R' →
      (∀ y : R, ∃ c : κ, y - φ c ∈ IsLocalRing.maximalIdeal R) →
      (∀ y : R', ∃ c : K, y - φ' c ∈ IsLocalRing.maximalIdeal R') →
      (∃ e : AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+*
          (MvPowerSeries (Fin 2) κ ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        e.toRingHom.comp ((algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)).comp φ) =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C) →
      ∃ e' : AdicCompletion (IsLocalRing.maximalIdeal R') R' ≃+*
          (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
        e'.toRingHom.comp ((algebraMap R' (AdicCompletion (IsLocalRing.maximalIdeal R') R')).comp φ') =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C := by
    intro R R' _ _ _ _ _ _ φ φ' h hc hflat hm hres hres' hE0
    obtain ⟨e, he⟩ := hE0

    have compat : (e.toRingHom.comp (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))).comp φ =
        (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})).comp MvPowerSeries.C := by
      rw [RingHom.comp_assoc]; exact he
    obtain ⟨hD, hS⟩ := wcpa_dj_lqr_completion_bridge κ R e
    have hQ := wcpa_dj_lqr_quot_hilb κ R φ
      (e.toRingHom.comp (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))) compat hD hS
    have hH : wcpaLqHilb κ R φ := by
      intro n hn
      exact (hQ n).trans (wcpa_dj_lqr_node_trunc_dim κ n hn)
    obtain ⟨u, v, ⟨hu, hv, hspan, hind⟩, huv⟩ := wcpa_dj_lqu_sp_node_basis κ R φ
      (e.toRingHom.comp (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))) compat hD hS

    have hH' : wcpaLqHilb K R' φ' := by
      intro n hn
      exact (wcpa_dj_lqr_flat_hilb_eq κ K (algebraMap κ K) R R' φ φ' h hc hflat hm hres hres' n).trans
        (hH n hn)

    have hcφ : ∀ c : κ, h (φ c) = φ' (algebraMap κ K c) := fun c => RingHom.congr_fun hc c
    have hmap : ∀ y ∈ IsLocalRing.maximalIdeal R, h y ∈ IsLocalRing.maximalIdeal R' := by
      intro y hy
      rw [← hm]; exact Ideal.mem_map_of_mem h hy
    have hmap2 : ∀ y ∈ IsLocalRing.maximalIdeal R ^ 2, h y ∈ IsLocalRing.maximalIdeal R' ^ 2 := by
      intro y hy
      rw [← hm, ← Ideal.map_pow]; exact Ideal.mem_map_of_mem h hy
    have hu' : h u ∈ IsLocalRing.maximalIdeal R' := hmap u hu
    have hv' : h v ∈ IsLocalRing.maximalIdeal R' := hmap v hv

    have hspan' : ∀ y ∈ IsLocalRing.maximalIdeal R', ∃ c₁ c₂ : K,
        y - (φ' c₁ * h u + φ' c₂ * h v) ∈ IsLocalRing.maximalIdeal R' ^ 2 := by
      let J : Ideal R' :=
        { carrier := {y | y ∈ IsLocalRing.maximalIdeal R' ∧ ∃ c₁ c₂ : K,
              y - (φ' c₁ * h u + φ' c₂ * h v) ∈ IsLocalRing.maximalIdeal R' ^ 2}
          add_mem' := by
            intro y₁ y₂ h₁ h₂
            simp only [Set.mem_setOf_eq] at h₁ h₂ ⊢
            obtain ⟨hy₁, a₁, b₁, k₁⟩ := h₁
            obtain ⟨hy₂, a₂, b₂, k₂⟩ := h₂
            refine ⟨Ideal.add_mem _ hy₁ hy₂, a₁ + a₂, b₁ + b₂, ?_⟩
            have hx : y₁ + y₂ - (φ' (a₁ + a₂) * h u + φ' (b₁ + b₂) * h v) =
                (y₁ - (φ' a₁ * h u + φ' b₁ * h v)) + (y₂ - (φ' a₂ * h u + φ' b₂ * h v)) := by
              rw [map_add, map_add]; ring
            rw [hx]; exact Ideal.add_mem _ k₁ k₂
          zero_mem' := by
            simp only [Set.mem_setOf_eq]
            exact ⟨Ideal.zero_mem _, 0, 0, by simp⟩
          smul_mem' := by
            intro r y hy0
            simp only [Set.mem_setOf_eq] at hy0 ⊢
            obtain ⟨hy, a₁, b₁, k₁⟩ := hy0
            obtain ⟨d, hd⟩ := hres' r
            refine ⟨Ideal.mul_mem_left _ r hy, d * a₁, d * b₁, ?_⟩
            have hx : r • y - (φ' (d * a₁) * h u + φ' (d * b₁) * h v) =
                (r - φ' d) * y + φ' d * (y - (φ' a₁ * h u + φ' b₁ * h v)) := by
              rw [smul_eq_mul, map_mul, map_mul]; ring
            rw [hx]
            refine Ideal.add_mem _ ?_ (Ideal.mul_mem_left _ _ k₁)
            rw [pow_two]; exact Ideal.mul_mem_mul hd hy }
      have hle : IsLocalRing.maximalIdeal R' ≤ J := by
        rw [← hm, Ideal.map_le_iff_le_comap]
        intro x hx
        rw [Ideal.mem_comap]
        show h x ∈ IsLocalRing.maximalIdeal R' ∧ ∃ c₁ c₂ : K,
          h x - (φ' c₁ * h u + φ' c₂ * h v) ∈ IsLocalRing.maximalIdeal R' ^ 2
        obtain ⟨c₁, c₂, hc12⟩ := hspan x hx
        refine ⟨hmap x hx, algebraMap κ K c₁, algebraMap κ K c₂, ?_⟩
        have k := hmap2 _ hc12
        rw [map_sub, map_add, map_mul, map_mul, hcφ, hcφ] at k
        exact k
      intro y hy
      exact (show y ∈ IsLocalRing.maximalIdeal R' ∧ ∃ c₁ c₂ : K,
        y - (φ' c₁ * h u + φ' c₂ * h v) ∈ IsLocalRing.maximalIdeal R' ^ 2 from hle hy).2

    have hind' : ∀ c₁ c₂ : K, φ' c₁ * h u + φ' c₂ * h v ∈ IsLocalRing.maximalIdeal R' ^ 2 →
        c₁ = 0 ∧ c₂ = 0 := by
      intro c₁ c₂ hrel
      by_contra hne
      have key : ∃ w : R', ∀ y : R', ∃ s t : K,
          y - (φ' s * 1 + φ' t * w) ∈ IsLocalRing.maximalIdeal R' ^ 2 := by
        by_cases h1 : c₁ = 0
        · have h2 : c₂ ≠ 0 := fun h2 => hne ⟨h1, h2⟩
          refine ⟨h u, fun y => ?_⟩
          obtain ⟨c, hc0⟩ := hres' y
          obtain ⟨a', b', hab⟩ := hspan' _ hc0
          refine ⟨c, a', ?_⟩
          have hinv : φ' c₂⁻¹ * φ' c₂ = 1 := by rw [← map_mul, inv_mul_cancel₀ h2, map_one]
          have hv2 : h v ∈ IsLocalRing.maximalIdeal R' ^ 2 := by
            have hx : h v = φ' c₂⁻¹ * (φ' c₁ * h u + φ' c₂ * h v) := by
              rw [h1, map_zero]; linear_combination (-(h v)) * hinv
            rw [hx]; exact Ideal.mul_mem_left _ _ hrel
          have hx : y - (φ' c * 1 + φ' a' * h u) =
              (y - φ' c - (φ' a' * h u + φ' b' * h v)) + φ' b' * h v := by ring
          rw [hx]; exact Ideal.add_mem _ hab (Ideal.mul_mem_left _ _ hv2)
        · refine ⟨h v, fun y => ?_⟩
          obtain ⟨c, hc0⟩ := hres' y
          obtain ⟨a', b', hab⟩ := hspan' _ hc0
          refine ⟨c, b' - a' * (c₂ * c₁⁻¹), ?_⟩
          have hinv : φ' c₁⁻¹ * φ' c₁ = 1 := by rw [← map_mul, inv_mul_cancel₀ h1, map_one]
          have hu2 : h u + φ' (c₂ * c₁⁻¹) * h v ∈ IsLocalRing.maximalIdeal R' ^ 2 := by
            have hx : h u + φ' (c₂ * c₁⁻¹) * h v = φ' c₁⁻¹ * (φ' c₁ * h u + φ' c₂ * h v) := by
              rw [map_mul]; linear_combination (-(h u)) * hinv
            rw [hx]; exact Ideal.mul_mem_left _ _ hrel
          have hx : y - (φ' c * 1 + φ' (b' - a' * (c₂ * c₁⁻¹)) * h v) =
              (y - φ' c - (φ' a' * h u + φ' b' * h v)) + φ' a' * (h u + φ' (c₂ * c₁⁻¹) * h v) := by
            rw [map_sub, map_mul]; ring
          rw [hx]; exact Ideal.add_mem _ hab (Ideal.mul_mem_left _ _ hu2)
      obtain ⟨w, hw⟩ := key
      letI : Algebra K R' := φ'.toAlgebra
      have hdim : Module.finrank K (R' ⧸ IsLocalRing.maximalIdeal R' ^ 2) = 3 :=
        (hH' 2 (by norm_num)).trans (by norm_num)
      have hsm : ∀ (c : K) (x : R'), c • (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R' ^ 2) x) =
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal R' ^ 2) (φ' c * x) := by
        intro c x
        rw [Algebra.smul_def, ← Ideal.Quotient.mk_algebraMap, ← map_mul]
        rfl
      have htop : Submodule.span K (Set.range ![Ideal.Quotient.mk (IsLocalRing.maximalIdeal R' ^ 2) 1,
          Ideal.Quotient.mk (IsLocalRing.maximalIdeal R' ^ 2) w]) = ⊤ := by
        rw [eq_top_iff]
        rintro z -
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
        obtain ⟨s, t, hst⟩ := hw y
        have e1 : Ideal.Quotient.mk (IsLocalRing.maximalIdeal R' ^ 2) y =
            s • Ideal.Quotient.mk (IsLocalRing.maximalIdeal R' ^ 2) 1 +
              t • Ideal.Quotient.mk (IsLocalRing.maximalIdeal R' ^ 2) w := by
          rw [hsm, hsm, ← map_add, Ideal.Quotient.eq]; exact hst
        rw [e1]
        exact Submodule.add_mem _ (Submodule.smul_mem _ _ (Submodule.subset_span ⟨0, rfl⟩))
          (Submodule.smul_mem _ _ (Submodule.subset_span ⟨1, rfl⟩))
      have hle := finrank_le_of_span_eq_top htop
      rw [hdim, Fintype.card_fin] at hle
      omega

    have huv' : h u * h v ∈ IsLocalRing.maximalIdeal R' ^ 3 := by
      rw [← map_mul, ← hm, ← Ideal.map_pow]; exact Ideal.mem_map_of_mem h huv
    obtain ⟨f, hf, e₁, he₁⟩ := wcpa_dj_lq_completion_presentation K R' φ' hH' (h u) (h v)
      ⟨hu', hv', hspan', hind'⟩ 0 1 0 (Or.inr (Or.inl one_ne_zero))
      (by simp only [map_zero, map_one, zero_mul, one_mul, add_zero, zero_add]; exact huv')
    have hq : wcpaBscQuad K 0 1 0 = MvPowerSeries.X 0 * MvPowerSeries.X 1 := by
      simp [wcpaBscQuad]
    rw [hq] at hf
    obtain ⟨e₂, he₂⟩ := wcpa_dj_ssp_bw_hensel_node K f hf
    refine ⟨e₁.trans e₂, ?_⟩
    rw [RingEquiv.toRingHom_trans, RingHom.comp_assoc, he₁, he₂]

  haveI : IsLocallyNoetherian X := AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian a
  haveI : LocallyOfFiniteType (Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap κ K)))) :=
    inferInstance
  haveI : IsLocallyNoetherian (Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap κ K)))) :=
    AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian
      (Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap κ K))))
  obtain ⟨h, hc, hflat, hm⟩ := wcpa_dj_lqr_basechange_stalk κ K X a τ hτ τ' hτ'1 hτ'2
  have hres := wcpa_dj_lqr_section_residue κ X a τ hτ
  have hres' := wcpa_dj_lqr_section_residue K _ _ τ' hτ'1
  exact core _ _ (wcpaLqPhi κ X a (τ (IsLocalRing.closedPoint κ)))
    (wcpaLqPhi K (Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap κ K))))
      (Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap κ K))))
      (τ' (IsLocalRing.closedPoint K))) h hc hflat hm hres hres' hE

theorem wcpa_dj_sfi_ascend : ∀ (K Ω : Type u) [Field K] [IsAlgClosed K] [Field Ω] [Algebra K Ω] (X : Scheme.{u}) (a : X ⟶ Spec (.of K)), Flat a → LocallyOfFinitePresentation a → (∀ x : X, (∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ a)) ∨ (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap (X.presheaf.stalk x) (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ x trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C)) → wcpaDjSolSS a Ω (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) :=
by
  intro K Ω _ _ _ _ X a hfl hfp hALT
  haveI := hfl
  haveI := hfp
  intro w
  rcases hALT (Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) w) with
    ⟨W, hxW, hsm⟩ | hnode
  ·
    left
    refine ⟨Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) ⁻¹ᵁ W, ?_, ?_⟩
    · rw [Scheme.Hom.mem_preimage]
      exact hxW
    · exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
        ((isPullback_morphismRestrict
          (Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K Ω)))) W).paste_vert
          (IsPullback.of_hasPullback a (Spec.map (CommRingCat.ofHom (algebraMap K Ω))))) hsm
  ·
    right
    generalize hxdef : Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) w = x
      at hnode
    have hres := wcpa_dj_nf_node_residue K (X.presheaf.stalk x)
      ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ x trivial).hom hnode
    obtain ⟨τ, hτ, hspec⟩ := wc_rational_closed_specialization K X a x

    have hel : ∀ c : K, (X.presheaf.stalkSpecializes hspec).hom
        (((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫
          X.presheaf.germ ⊤ (τ (IsLocalRing.closedPoint K)) trivial).hom c) =
        ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ x trivial).hom c := by
      intro c
      rw [← X.presheaf.germ_stalkSpecializes (U := ⊤) trivial hspec]
      rfl

    have hlocal : ∀ f, f ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (τ (IsLocalRing.closedPoint K))) →
        (X.presheaf.stalkSpecializes hspec).hom f ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
      intro f hf
      obtain ⟨c, hc⟩ := hres ((X.presheaf.stalkSpecializes hspec).hom f)
      by_cases hc0 : c = 0
      · rw [hc0, map_zero, sub_zero] at hc
        exact hc
      · exfalso
        have hu : IsUnit (((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫
            X.presheaf.germ ⊤ (τ (IsLocalRing.closedPoint K)) trivial).hom c) :=
          (isUnit_iff_ne_zero.mpr hc0).map _
        have hu2 : IsUnit (f - ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫
            X.presheaf.germ ⊤ (τ (IsLocalRing.closedPoint K)) trivial).hom c) := by
          by_contra hnu
          have h1 := (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu)
          have h2 := Ideal.sub_mem _ hf h1
          rw [sub_sub_cancel] at h2
          exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h2) hu
        have hu3 := hu2.map (X.presheaf.stalkSpecializes hspec).hom
        rw [map_sub, hel] at hu3
        exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp hc) hu3
    haveI : IsLocalHom (X.presheaf.stalkSpecializes hspec).hom := by
      refine ⟨fun f hf => ?_⟩
      by_contra hnu
      have h1 := hlocal f ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hnu))
      exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h1) hf

    have hxy : x = τ (IsLocalRing.closedPoint K) := by
      have h1 := Scheme.SpecMap_stalkSpecializes_fromSpecStalk hspec
      have h2 : (Spec.map (X.presheaf.stalkSpecializes hspec))
          (IsLocalRing.closedPoint (X.presheaf.stalk x)) =
          IsLocalRing.closedPoint (X.presheaf.stalk (τ (IsLocalRing.closedPoint K))) :=
        Spec_closedPoint
      calc x = X.fromSpecStalk x (IsLocalRing.closedPoint (X.presheaf.stalk x)) :=
            Scheme.fromSpecStalk_closedPoint.symm
        _ = X.fromSpecStalk (τ (IsLocalRing.closedPoint K))
            ((Spec.map (X.presheaf.stalkSpecializes hspec))
              (IsLocalRing.closedPoint (X.presheaf.stalk x))) := by
            rw [← h1]
            first
              | rfl
              | exact Scheme.Hom.comp_apply _ _ _
              | simp
        _ = τ (IsLocalRing.closedPoint K) := by
            rw [h2]
            exact Scheme.fromSpecStalk_closedPoint
    subst hxy

    obtain ⟨τ', hτ'1, hτ'2⟩ : ∃ τ' : Spec (.of Ω) ⟶
        Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K Ω))),
        τ' ≫ Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) = 𝟙 _ ∧
        τ' ≫ Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) =
          Spec.map (CommRingCat.ofHom (algebraMap K Ω)) ≫ τ :=
      ⟨Limits.pullback.lift (Spec.map (CommRingCat.ofHom (algebraMap K Ω)) ≫ τ) (𝟙 _)
        (by rw [Category.assoc, hτ, Category.comp_id, Category.id_comp]),
        Limits.pullback.lift_snd _ _ _, Limits.pullback.lift_fst _ _ _⟩
    have huniq := (wcpa_dj_mm_section_point_unique X (Spec (.of K)) (Spec (.of Ω))
      (Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K Ω)))) a
      (Spec.map (CommRingCat.ofHom (algebraMap K Ω)))
      (Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K Ω))))
      (Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap K Ω)))) τ τ'
      (IsPullback.of_hasPullback a (Spec.map (CommRingCat.ofHom (algebraMap K Ω))))
      hτ hτ'1 hτ'2 w).mp (by
        rw [hxdef]
        congr 1
        exact Subsingleton.elim _ _)
    have hw : w = τ' (IsLocalRing.closedPoint Ω) := by
      rw [huniq]
      congr 1
      exact Subsingleton.elim _ _
    subst hw
    exact wcpa_dj_gnc_rational_node_bc K Ω X a τ hτ hnode τ' hτ'1 hτ'2

theorem wcpa_dj_sfi_node_invariants : ∀ (L : Type u) [Field L] (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (φ : L →+* R) (e : AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+* (MvPowerSeries (Fin 2) L ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})), e.toRingHom.comp ((algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)).comp φ) = (Ideal.Quotient.mk _).comp MvPowerSeries.C → wcpaLqHilb L R φ ∧ (∀ y : R, ∃ c : L, y - φ c ∈ IsLocalRing.maximalIdeal R) ∧ ∃ u v : R, wcpaLqBasis L R φ u v ∧ u * v ∈ IsLocalRing.maximalIdeal R ^ 3 :=
by
  intro L _ R _ _ _ φ e he
  obtain ⟨hD, hS⟩ := wcpa_dj_lqr_completion_bridge L R e
  set ψ : R →+* (MvPowerSeries (Fin 2) L ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) :=
    e.toRingHom.comp (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)) with hψdef
  have hψφ : ψ.comp φ = (Ideal.Quotient.mk
      (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})).comp MvPowerSeries.C := by
    rw [hψdef, RingHom.comp_assoc]; exact he
  have hD' : ∀ (n : ℕ) (t : MvPowerSeries (Fin 2) L), ∃ r : R,
      ψ r - Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) t ∈
        Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
          (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n) := fun n t => hD n t
  have hS' : ∀ (n : ℕ) (r : R),
      ψ r ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
          (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n) ↔
        r ∈ IsLocalRing.maximalIdeal R ^ n := fun n r => hS n r
  refine ⟨?_, ?_, ?_⟩
  ·
    unfold wcpaLqHilb
    intro n hn
    have e2 := wcpa_dj_lqr_quot_hilb L R φ ψ hψφ hD' hS' n
    have e3 := wcpa_dj_lqr_node_trunc_dim L n hn
    exact e2.trans e3
  ·
    intro y
    obtain ⟨F, hF⟩ := Ideal.Quotient.mk_surjective (ψ y)
    refine ⟨MvPowerSeries.constantCoeff F, ?_⟩
    set c := MvPowerSeries.constantCoeff F with hc
    have hφc : ψ (φ c) = Ideal.Quotient.mk
        (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) (MvPowerSeries.C c) := by
      have := RingHom.congr_fun hψφ c
      simpa only [RingHom.coe_comp, Function.comp_apply] using this
    have hval : ψ (y - φ c) = Ideal.Quotient.mk
        (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) (F - MvPowerSeries.C c) := by
      rw [map_sub, map_sub, hφc, hF]
    have hmem : F - MvPowerSeries.C c ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff]
      rw [map_sub, MvPowerSeries.constantCoeff_C, ← hc, sub_self]
      exact not_isUnit_zero
    have h1 : ψ (y - φ c) ∈ Ideal.map
        (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
        (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ 1) := by
      rw [hval, pow_one]
      exact Ideal.mem_map_of_mem _ hmem
    have h2 := (hS' 1 (y - φ c)).mp h1
    rwa [pow_one] at h2
  ·
    obtain ⟨u, v, hb, huv⟩ := wcpa_dj_lqu_sp_node_basis L R φ ψ hψφ hD' hS'
    exact ⟨u, v, hb, huv⟩

theorem wcpa_dj_lqr_isotropic : ∀ (L : Type u) [Field L] (R : Type u) [CommRing R] [IsLocalRing R] (φ : L →+* R) (ψ : R →+* (MvPowerSeries (Fin 2) L ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})), ψ.comp φ = (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})).comp MvPowerSeries.C → (∀ (n : ℕ) (t : MvPowerSeries (Fin 2) L), ∃ r : R, ψ r - Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) t ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})) (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n)) → (∀ (n : ℕ) (r : R), ψ r ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})) (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n) ↔ r ∈ IsLocalRing.maximalIdeal R ^ n) → ∀ u v : R, u ∈ IsLocalRing.maximalIdeal R → v ∈ IsLocalRing.maximalIdeal R → (∀ y ∈ IsLocalRing.maximalIdeal R, ∃ c₁ c₂ : L, y - (φ c₁ * u + φ c₂ * v) ∈ IsLocalRing.maximalIdeal R ^ 2) → ∀ a b c : L, φ a * u ^ 2 + φ b * (u * v) + φ c * v ^ 2 ∈ IsLocalRing.maximalIdeal R ^ 3 → ∃ α β γ δ : L, α * δ - β * γ ≠ 0 ∧ a * α ^ 2 + b * α * β + c * β ^ 2 = 0 ∧ a * γ ^ 2 + b * γ * δ + c * δ ^ 2 = 0 :=
by
  intro L _ R _ _ φ ψ hc hdens hstr u v hu hv hspan a b c hrel
  classical

  have hunit : ∀ G : MvPowerSeries (Fin 2) L,
      G ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ↔ MvPowerSeries.constantCoeff G = 0 := by
    intro G
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
      isUnit_iff_ne_zero, not_not]

  have hord : ∀ (n : ℕ) (G : MvPowerSeries (Fin 2) L),
      G ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n → (n : ℕ∞) ≤ MvPowerSeries.order G := by
    intro n
    induction n with
    | zero => intro G _; simp
    | succ n ih =>
      intro G hG
      rw [pow_succ] at hG
      refine Submodule.mul_induction_on (C := fun x => ((n + 1 : ℕ) : ℕ∞) ≤ MvPowerSeries.order x)
        hG ?_ ?_
      · intro m hm k hk
        have h1 := ih m hm
        have h2 : 1 ≤ MvPowerSeries.order k :=
          MvPowerSeries.one_le_order_iff_constCoeff_eq_zero.mpr ((hunit k).mp hk)
        calc ((n + 1 : ℕ) : ℕ∞) = (n : ℕ∞) + 1 := by push_cast; rfl
          _ ≤ MvPowerSeries.order m + MvPowerSeries.order k := add_le_add h1 h2
          _ ≤ MvPowerSeries.order (m * k) := MvPowerSeries.le_order_mul
      · intro x y hx hy
        exact le_trans (le_min hx hy) MvPowerSeries.min_order_le_add

  have hXX : ∀ (H : MvPowerSeries (Fin 2) L) (i : Fin 2) (m : ℕ),
      MvPowerSeries.coeff (Finsupp.single i m) (MvPowerSeries.X 0 * MvPowerSeries.X 1 * H) = 0 := by
    intro H i m
    rw [MvPowerSeries.X_def, MvPowerSeries.X_def, MvPowerSeries.monomial_mul_monomial,
      MvPowerSeries.coeff_monomial_mul, if_neg]
    rw [Finsupp.le_def]
    push_neg
    fin_cases i
    · exact ⟨1, by simp⟩
    · exact ⟨0, by simp⟩

  have hQC : ∀ (n : ℕ) (F : MvPowerSeries (Fin 2) L),
      Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) F ∈
        Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
          (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n) →
      ∀ (i : Fin 2) (m : ℕ), m < n → MvPowerSeries.coeff (Finsupp.single i m) F = 0 := by
    intro n F hF i m hm
    obtain ⟨G, hG, hGF⟩ :=
      (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp hF
    rw [Ideal.Quotient.eq] at hGF
    obtain ⟨H, hH⟩ := Ideal.mem_span_singleton'.mp hGF
    have hFeq : F = G + MvPowerSeries.X 0 * MvPowerSeries.X 1 * (-H) := by
      linear_combination hH
    rw [hFeq, map_add, hXX, add_zero]
    apply MvPowerSeries.coeff_of_lt_order
    rw [Finsupp.degree_single]
    exact lt_of_lt_of_le (by exact_mod_cast hm) (hord n G hG)

  have hsq : ∀ (U V : MvPowerSeries (Fin 2) L), MvPowerSeries.constantCoeff U = 0 →
      MvPowerSeries.constantCoeff V = 0 → ∀ i : Fin 2,
      MvPowerSeries.coeff (Finsupp.single i 2) (U * V) =
        MvPowerSeries.coeff (Finsupp.single i 1) U * MvPowerSeries.coeff (Finsupp.single i 1) V := by
    intro U V hU hV i
    rw [MvPowerSeries.coeff_mul, Finsupp.antidiagonal_single, Finset.sum_map,
      Finset.Nat.sum_antidiagonal_succ, Finset.Nat.sum_antidiagonal_succ,
      Finset.Nat.antidiagonal_zero, Finset.sum_singleton]
    simp [MvPowerSeries.coeff_zero_eq_constantCoeff_apply, hU, hV]

  have hC : ∀ e : L, ψ (φ e) =
      Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) (MvPowerSeries.C e) :=
    fun e => RingHom.congr_fun hc e

  have hlift : ∀ w : R, w ∈ IsLocalRing.maximalIdeal R → ∃ W : MvPowerSeries (Fin 2) L,
      MvPowerSeries.constantCoeff W = 0 ∧
        Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) W = ψ w := by
    intro w hw
    have h1 := (hstr 1 w).mpr (by rw [pow_one]; exact hw)
    obtain ⟨W, hW, hWe⟩ :=
      (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).mp h1
    rw [pow_one] at hW
    exact ⟨W, (hunit W).mp hW, hWe⟩
  obtain ⟨U, hU0, hUe⟩ := hlift u hu
  obtain ⟨V, hV0, hVe⟩ := hlift v hv

  have hF : Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})
      (MvPowerSeries.C a * U ^ 2 + MvPowerSeries.C b * (U * V) + MvPowerSeries.C c * V ^ 2) ∈
        Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
          (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ 3) := by
    convert (hstr 3 _).mpr hrel using 1
    simp only [map_add, map_mul, map_pow, hC, hUe, hVe]
  have hiso : ∀ i : Fin 2, a * MvPowerSeries.coeff (Finsupp.single i 1) U ^ 2 +
      b * MvPowerSeries.coeff (Finsupp.single i 1) U * MvPowerSeries.coeff (Finsupp.single i 1) V +
      c * MvPowerSeries.coeff (Finsupp.single i 1) V ^ 2 = 0 := by
    intro i
    have h := hQC 3 _ hF i 2 (by norm_num)
    rw [map_add, map_add, MvPowerSeries.coeff_C_mul, MvPowerSeries.coeff_C_mul,
      MvPowerSeries.coeff_C_mul, pow_two, pow_two, hsq U U hU0 hU0, hsq U V hU0 hV0,
      hsq V V hV0 hV0] at h
    linear_combination h

  have hlin : ∀ j : Fin 2, ∃ e₁ e₂ : L, ∀ i : Fin 2,
      MvPowerSeries.coeff (Finsupp.single i 1)
        (MvPowerSeries.X j - (MvPowerSeries.C e₁ * U + MvPowerSeries.C e₂ * V)) = 0 := by
    intro j
    obtain ⟨r, hr⟩ := hdens 2 (MvPowerSeries.X j)
    have hXj : Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})
        (MvPowerSeries.X j) ∈
        Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
          (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ 1) := by
      rw [pow_one]
      exact Ideal.mem_map_of_mem _ ((hunit _).mpr (MvPowerSeries.constantCoeff_X j))
    have hr1 : r ∈ IsLocalRing.maximalIdeal R := by
      have h2 : ψ r ∈
          Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
            (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ 1) := by
        have := Ideal.add_mem _
          (Ideal.map_mono (Ideal.pow_le_pow_right (by norm_num : 1 ≤ 2)) hr) hXj
        simpa using this
      have := (hstr 1 r).mp h2
      rwa [pow_one] at this
    obtain ⟨e₁, e₂, he⟩ := hspan r hr1
    have h3 := (hstr 2 _).mpr he
    have h4 : Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})
        (MvPowerSeries.X j - (MvPowerSeries.C e₁ * U + MvPowerSeries.C e₂ * V)) ∈
        Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}))
          (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ 2) := by
      have := Ideal.sub_mem _ h3 hr
      convert this using 1
      simp only [map_sub, map_add, map_mul, hC, hUe, hVe]
      ring
    exact ⟨e₁, e₂, fun i => hQC 2 _ h4 i 1 (by norm_num)⟩
  obtain ⟨c₁, c₂, hc0⟩ := hlin 0
  obtain ⟨d₁, d₂, hd1⟩ := hlin 1
  have k1 := hc0 0
  have k2 := hc0 1
  have k3 := hd1 0
  have k4 := hd1 1
  simp only [map_sub, map_add, MvPowerSeries.coeff_C_mul, MvPowerSeries.coeff_X,
    Finsupp.single_eq_single_iff] at k1 k2 k3 k4
  norm_num at k1 k2 k3 k4
  refine ⟨MvPowerSeries.coeff (Finsupp.single 0 1) U, MvPowerSeries.coeff (Finsupp.single 0 1) V,
    MvPowerSeries.coeff (Finsupp.single 1 1) U, MvPowerSeries.coeff (Finsupp.single 1 1) V,
    ?_, hiso 0, hiso 1⟩
  intro h0
  set α := MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1) U with hα
  set β := MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) 1) V with hβ
  set γ := MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) 1) U with hγ
  set δ := MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) 1) V with hδ
  have key : (c₁ * d₂ - c₂ * d₁) * (α * δ - β * γ) = 1 := by
    linear_combination ((1 - (d₁ * γ + d₂ * δ)) - 1) * k1 - k4 -
      (-(d₂ * β) + -(d₁ * α)) * k2
  rw [h0, mul_zero] at key
  exact zero_ne_one key

theorem wcpa_dj_sfi_node_descend : ∀ (K L : Type u) [Field K] [IsAlgClosed K] [Field L] [Algebra K L] (X : Scheme.{u}) [IsLocallyNoetherian X] (a : X ⟶ Spec (.of K)) [IsLocallyNoetherian (Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L))))] (τ : Spec (.of K) ⟶ X), τ ≫ a = 𝟙 _ → ∀ (τ' : Spec (.of L) ⟶ Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))), τ' ≫ Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap K L))) = 𝟙 _ → τ' ≫ Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K L))) = Spec.map (CommRingCat.ofHom (algebraMap K L)) ≫ τ → (∃ e : AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).presheaf.stalk (τ' (IsLocalRing.closedPoint L)))) ((Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).presheaf.stalk (τ' (IsLocalRing.closedPoint L))) ≃+* (MvPowerSeries (Fin 2) L ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap ((Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).presheaf.stalk (τ' (IsLocalRing.closedPoint L))) (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).presheaf.stalk (τ' (IsLocalRing.closedPoint L)))) ((Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).presheaf.stalk (τ' (IsLocalRing.closedPoint L))))).comp ((Scheme.ΓSpecIso (.of L)).inv ≫ (Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).appTop ≫ (Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K L)))).presheaf.germ ⊤ (τ' (IsLocalRing.closedPoint L)) trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C) → ∃ e : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk (τ (IsLocalRing.closedPoint K)))) (X.presheaf.stalk (τ (IsLocalRing.closedPoint K))) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap (X.presheaf.stalk (τ (IsLocalRing.closedPoint K))) (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk (τ (IsLocalRing.closedPoint K)))) (X.presheaf.stalk (τ (IsLocalRing.closedPoint K))))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ (τ (IsLocalRing.closedPoint K)) trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C :=
by
  intro K L _ _ _ _ X _ a _ τ hτ τ' hτ's hτ'f ⟨e', he'⟩
  classical

  have c12 : ∀ (a b c α β γ δ : L), (a ≠ 0 ∨ b ≠ 0 ∨ c ≠ 0) → α * δ - β * γ ≠ 0 →
      a * α ^ 2 + b * α * β + c * β ^ 2 = 0 → a * γ ^ 2 + b * γ * δ + c * δ ^ 2 = 0 →
      b ^ 2 - 4 * a * c ≠ 0 := by
    intro a b c α β γ δ hnz hD ha' hc' hd
    have hb2 : (2 * a * α * γ + b * (α * δ + β * γ) + 2 * c * β * δ) ^ 2 = 0 := by
      linear_combination (4 * (a * γ ^ 2 + b * γ * δ + c * δ ^ 2)) * ha' + (α * δ - β * γ) ^ 2 * hd
    have hb' : 2 * a * α * γ + b * (α * δ + β * γ) + 2 * c * β * δ = 0 :=
      pow_eq_zero_iff (by norm_num) |>.mp hb2
    have hD2 : (α * δ - β * γ) ^ 2 ≠ 0 := pow_ne_zero 2 hD
    have e1 : (α * δ - β * γ) ^ 2 * a = 0 := by
      linear_combination δ ^ 2 * ha' - β * δ * hb' + β ^ 2 * hc'
    have e2 : (α * δ - β * γ) ^ 2 * c = 0 := by
      linear_combination γ ^ 2 * ha' - α * γ * hb' + α ^ 2 * hc'
    have e3 : (α * δ - β * γ) ^ 2 * b = 0 := by
      linear_combination (-2 * γ * δ) * ha' + (α * δ + β * γ) * hb' - 2 * α * β * hc'
    have h1 := (mul_eq_zero.mp e1).resolve_left hD2
    have h2 := (mul_eq_zero.mp e2).resolve_left hD2
    have h3 := (mul_eq_zero.mp e3).resolve_left hD2
    rcases hnz with h | h | h
    · exact h h1
    · exact h h3
    · exact h h2

  have c13 : ∀ (a b c : K), (a ≠ 0 ∨ b ≠ 0 ∨ c ≠ 0) → b ^ 2 - 4 * a * c ≠ 0 →
      ∃ l α β γ δ : K, l ≠ 0 ∧ α * δ - β * γ ≠ 0 ∧ l * (α * γ) = a ∧
        l * (α * δ + β * γ) = b ∧ l * (β * δ) = c := by
    intro a b c _ hd
    by_cases ha : a = 0
    · subst ha
      refine ⟨1, 0, 1, b, c, one_ne_zero, ?_, by ring, by ring, by ring⟩
      intro h0
      apply hd
      have hb0 : b = 0 := by linear_combination -h0
      rw [hb0]; ring
    · have hdeg : (Polynomial.C a * Polynomial.X ^ 2 + Polynomial.C b * Polynomial.X +
          Polynomial.C c).degree ≠ 0 := by
        rw [Polynomial.degree_quadratic ha]; decide
      obtain ⟨r, hr⟩ := IsAlgClosed.exists_root _ hdeg
      have hr' : a * r ^ 2 + b * r + c = 0 := by
        simpa [Polynomial.IsRoot] using hr
      have hab : a * (b / a) = b := mul_div_cancel₀ b ha
      refine ⟨a, 1, -r, 1, -(-(b / a) - r), ha, ?_, by ring, ?_, ?_⟩
      · intro h0
        apply hd
        have h1 : 2 * a * r + b = 0 := by linear_combination a * h0 - hab
        linear_combination (2 * a * r + b) * h1 - 4 * a * hr'
      · linear_combination hab
      · linear_combination -r * hab - hr'

  have key : ∀ (R R' : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [CommRing R']
      [IsLocalRing R'] [IsNoetherianRing R'] (φ : K →+* R) (φ' : L →+* R') (h : R →+* R'),
      h.comp φ = φ'.comp (algebraMap K L) → h.Flat →
      Ideal.map h (IsLocalRing.maximalIdeal R) = IsLocalRing.maximalIdeal R' →
      (∀ y : R, ∃ c : K, y - φ c ∈ IsLocalRing.maximalIdeal R) →
      (∀ y : R', ∃ c : L, y - φ' c ∈ IsLocalRing.maximalIdeal R') →
      ∀ e' : AdicCompletion (IsLocalRing.maximalIdeal R') R' ≃+*
        (MvPowerSeries (Fin 2) L ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
      e'.toRingHom.comp ((algebraMap R' (AdicCompletion (IsLocalRing.maximalIdeal R') R')).comp φ') =
        (Ideal.Quotient.mk _).comp MvPowerSeries.C →
      ∃ e : AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+*
        (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
      e.toRingHom.comp ((algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R)).comp φ) =
        (Ideal.Quotient.mk _).comp MvPowerSeries.C := by
    intro R R' _ _ _ _ _ _ φ φ' h hφ hflat hm resR resR' e' he'
    have HilbR' := (wcpa_dj_sfi_node_invariants L R' φ' e' he').1
    have HilbR : wcpaLqHilb K R φ := by
      unfold wcpaLqHilb at HilbR' ⊢
      intro n hn
      exact (wcpa_dj_lqr_flat_hilb_eq K L (algebraMap K L) R R' φ φ' h hφ hflat hm resR resR'
        n).symm.trans (HilbR' n hn)

    letI : Algebra K R := φ.toAlgebra
    have hsmul : ∀ (I : Ideal R) (c : K) (r : R),
        c • (Ideal.Quotient.mk I r) = Ideal.Quotient.mk I (φ c * r) := by
      intro I c r
      have h1 := map_smul (Ideal.Quotient.mkₐ K I) c r
      rw [Ideal.Quotient.mkₐ_eq_mk] at h1
      rw [← h1, Algebra.smul_def, RingHom.algebraMap_toAlgebra]
    have kerdim : ∀ n k : ℕ, 1 ≤ n → k = n + 1 →
        ∃ π : (R ⧸ IsLocalRing.maximalIdeal R ^ k) →ₗ[K] (R ⧸ IsLocalRing.maximalIdeal R ^ n),
          (∀ r, π (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk _ r) ∧
          FiniteDimensional K (R ⧸ IsLocalRing.maximalIdeal R ^ k) ∧
          Module.finrank K (LinearMap.ker π) = 2 := by
      intro n k hn hk
      have hle : IsLocalRing.maximalIdeal R ^ k ≤ IsLocalRing.maximalIdeal R ^ n :=
        Ideal.pow_le_pow_right (by omega)
      let π := (Ideal.Quotient.factorₐ K hle).toLinearMap
      have hπ : ∀ r, π (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk _ r := fun r => rfl
      have hsurj : Function.Surjective π := by
        intro y
        obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
        exact ⟨_, hπ r⟩
      have hk' : Module.finrank K (R ⧸ IsLocalRing.maximalIdeal R ^ k) = 2 * k - 1 :=
        HilbR k (by omega)
      have hn' : Module.finrank K (R ⧸ IsLocalRing.maximalIdeal R ^ n) = 2 * n - 1 := HilbR n hn
      haveI hfd : FiniteDimensional K (R ⧸ IsLocalRing.maximalIdeal R ^ k) :=
        Module.finite_of_finrank_pos (by rw [hk']; omega)
      have hrn := LinearMap.finrank_range_add_finrank_ker π
      rw [LinearMap.range_eq_top.mpr hsurj, finrank_top, hk', hn'] at hrn
      exact ⟨π, hπ, hfd, by omega⟩
    obtain ⟨π1, hπ1, hfd1, hk1⟩ := kerdim 1 2 le_rfl rfl
    haveI := hfd1
    let B := Module.finBasisOfFinrankEq K (LinearMap.ker π1) hk1
    obtain ⟨u, hu⟩ := Ideal.Quotient.mk_surjective
      ((B 0 : LinearMap.ker π1) : R ⧸ IsLocalRing.maximalIdeal R ^ 2)
    obtain ⟨v, hv⟩ := Ideal.Quotient.mk_surjective
      ((B 1 : LinearMap.ker π1) : R ⧸ IsLocalRing.maximalIdeal R ^ 2)
    have hmem1 : ∀ y : R, y ∈ IsLocalRing.maximalIdeal R ↔
        Ideal.Quotient.mk (IsLocalRing.maximalIdeal R ^ 2) y ∈ LinearMap.ker π1 := by
      intro y
      rw [LinearMap.mem_ker, hπ1, Ideal.Quotient.eq_zero_iff_mem, pow_one]
    have hu0 : u ∈ IsLocalRing.maximalIdeal R := (hmem1 u).mpr (by rw [hu]; exact (B 0).2)
    have hv0 : v ∈ IsLocalRing.maximalIdeal R := (hmem1 v).mpr (by rw [hv]; exact (B 1).2)
    have hspan : ∀ y ∈ IsLocalRing.maximalIdeal R, ∃ c₁ c₂ : K,
        y - (φ c₁ * u + φ c₂ * v) ∈ IsLocalRing.maximalIdeal R ^ 2 := by
      intro y hy
      have hz := (hmem1 y).mp hy
      have hrep := B.sum_repr ⟨_, hz⟩
      rw [Fin.sum_univ_two] at hrep
      have hrep' := congrArg Subtype.val hrep
      rw [Submodule.coe_add, Submodule.coe_smul, Submodule.coe_smul, ← hu, ← hv, hsmul, hsmul,
        ← map_add] at hrep'
      exact ⟨_, _, Ideal.Quotient.eq.mp hrep'.symm⟩
    have hli : LinearIndependent K ![B 0, B 1] := by
      convert B.linearIndependent
      funext i
      fin_cases i <;> rfl
    have hind : ∀ c₁ c₂ : K, φ c₁ * u + φ c₂ * v ∈ IsLocalRing.maximalIdeal R ^ 2 →
        c₁ = 0 ∧ c₂ = 0 := by
      intro c₁ c₂ hc
      apply LinearIndependent.pair_iff.mp hli
      apply Subtype.ext
      rw [Submodule.coe_add, Submodule.coe_smul, Submodule.coe_smul, ← hu, ← hv, hsmul, hsmul,
        ← map_add, Submodule.coe_zero, Ideal.Quotient.eq_zero_iff_mem]
      exact hc
    obtain ⟨π2, hπ2, hfd2, hk2⟩ := kerdim 2 3 (by norm_num) rfl
    haveI := hfd2
    have hq : ∀ i : Fin 3, ![u ^ 2, u * v, v ^ 2] i ∈ IsLocalRing.maximalIdeal R ^ 2 := by
      intro i
      fin_cases i
      · exact Ideal.pow_mem_pow hu0 2
      · show u * v ∈ IsLocalRing.maximalIdeal R ^ 2
        rw [pow_two]; exact Ideal.mul_mem_mul hu0 hv0
      · exact Ideal.pow_mem_pow hv0 2
    let w : Fin 3 → LinearMap.ker π2 := fun i =>
      ⟨Ideal.Quotient.mk _ (![u ^ 2, u * v, v ^ 2] i),
        LinearMap.mem_ker.mpr (by rw [hπ2, Ideal.Quotient.eq_zero_iff_mem]; exact hq i)⟩
    have hnot : ¬ LinearIndependent K w := by
      intro hl
      have := hl.fintype_card_le_finrank
      rw [Fintype.card_fin, hk2] at this
      omega
    obtain ⟨g, hg, i₀, hi₀⟩ := Fintype.not_linearIndependent_iff.mp hnot
    have hnz : g 0 ≠ 0 ∨ g 1 ≠ 0 ∨ g 2 ≠ 0 := by
      fin_cases i₀
      · exact Or.inl hi₀
      · exact Or.inr (Or.inl hi₀)
      · exact Or.inr (Or.inr hi₀)
    have hrel : φ (g 0) * u ^ 2 + φ (g 1) * (u * v) + φ (g 2) * v ^ 2 ∈
        IsLocalRing.maximalIdeal R ^ 3 := by
      have hsum := congrArg Subtype.val hg
      rw [Submodule.coe_sum, Fin.sum_univ_three, Submodule.coe_smul, Submodule.coe_smul,
        Submodule.coe_smul, Submodule.coe_zero] at hsum
      change g 0 • Ideal.Quotient.mk _ (u ^ 2) + g 1 • Ideal.Quotient.mk _ (u * v) +
        g 2 • Ideal.Quotient.mk _ (v ^ 2) = 0 at hsum
      rw [hsmul, hsmul, hsmul, ← map_add, ← map_add, Ideal.Quotient.eq_zero_iff_mem] at hsum
      exact hsum

    have hm2 : ∀ k : ℕ, Ideal.map h (IsLocalRing.maximalIdeal R ^ k) =
        IsLocalRing.maximalIdeal R' ^ k := fun k => by rw [Ideal.map_pow, hm]
    have hu' : h u ∈ IsLocalRing.maximalIdeal R' := hm ▸ Ideal.mem_map_of_mem h hu0
    have hv' : h v ∈ IsLocalRing.maximalIdeal R' := hm ▸ Ideal.mem_map_of_mem h hv0
    have hφc : ∀ c : K, h (φ c) = φ' (algebraMap K L c) := fun c => by
      have h1 := RingHom.congr_fun hφ c
      simpa only [RingHom.comp_apply] using h1
    have hmJ : IsLocalRing.maximalIdeal R' ≤
        Ideal.span {h u, h v} ⊔ IsLocalRing.maximalIdeal R' ^ 2 := by
      refine hm.symm.le.trans ?_
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      obtain ⟨c₁, c₂, hc⟩ := hspan x hx
      rw [Ideal.mem_comap]
      have e1 : h x = (φ' (algebraMap K L c₁) * h u + φ' (algebraMap K L c₂) * h v) +
          h (x - (φ c₁ * u + φ c₂ * v)) := by
        rw [map_sub, map_add, map_mul, map_mul, hφc, hφc]; ring
      rw [e1]
      refine Submodule.add_mem_sup ?_ ?_
      · exact Ideal.mem_span_pair.mpr ⟨_, _, rfl⟩
      · rw [← hm2 2]; exact Ideal.mem_map_of_mem h hc
    have hspan' : ∀ y ∈ IsLocalRing.maximalIdeal R', ∃ c₁ c₂ : L,
        y - (φ' c₁ * h u + φ' c₂ * h v) ∈ IsLocalRing.maximalIdeal R' ^ 2 := by
      intro y hy
      obtain ⟨p, hp, z, hz, rfl⟩ := Submodule.mem_sup.mp (hmJ hy)
      obtain ⟨r₁, r₂, rfl⟩ := Ideal.mem_span_pair.mp hp
      obtain ⟨d₁, hd₁⟩ := resR' r₁
      obtain ⟨d₂, hd₂⟩ := resR' r₂
      refine ⟨d₁, d₂, ?_⟩
      have e : r₁ * h u + r₂ * h v + z - (φ' d₁ * h u + φ' d₂ * h v) =
          (r₁ - φ' d₁) * h u + (r₂ - φ' d₂) * h v + z := by ring
      rw [e]
      refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) hz
      · rw [pow_two]; exact Ideal.mul_mem_mul hd₁ hu'
      · rw [pow_two]; exact Ideal.mul_mem_mul hd₂ hv'
    have hrel' : φ' (algebraMap K L (g 0)) * h u ^ 2 + φ' (algebraMap K L (g 1)) * (h u * h v) +
        φ' (algebraMap K L (g 2)) * h v ^ 2 ∈ IsLocalRing.maximalIdeal R' ^ 3 := by
      rw [← hm2 3]
      convert Ideal.mem_map_of_mem h hrel using 1
      simp only [map_add, map_mul, map_pow, hφc]

    obtain ⟨hD, hS⟩ := wcpa_dj_lqr_completion_bridge L R' e'
    have hψ : (e'.toRingHom.comp (algebraMap R' (AdicCompletion (IsLocalRing.maximalIdeal R') R'))).comp
        φ' = (Ideal.Quotient.mk _).comp MvPowerSeries.C := by
      rw [RingHom.comp_assoc]; exact he'
    obtain ⟨α', β', γ', δ', hdet', hi1, hi2⟩ := wcpa_dj_lqr_isotropic L R' φ'
      (e'.toRingHom.comp (algebraMap R' (AdicCompletion (IsLocalRing.maximalIdeal R') R'))) hψ
      (fun n t => hD n t) (fun n r => hS n r) (h u) (h v) hu' hv' hspan' _ _ _ hrel'

    have hnz' : algebraMap K L (g 0) ≠ 0 ∨ algebraMap K L (g 1) ≠ 0 ∨ algebraMap K L (g 2) ≠ 0 := by
      rcases hnz with h0 | h0 | h0
      · exact Or.inl ((map_ne_zero _).mpr h0)
      · exact Or.inr (Or.inl ((map_ne_zero _).mpr h0))
      · exact Or.inr (Or.inr ((map_ne_zero _).mpr h0))
    have hdL := c12 _ _ _ α' β' γ' δ' hnz' hdet' hi1 hi2
    have hdisc : g 1 ^ 2 - 4 * g 0 * g 2 ≠ 0 := by
      intro h0
      apply hdL
      have h1 := congrArg (algebraMap K L) h0
      rw [map_zero, map_sub, map_mul, map_mul, map_pow, map_ofNat] at h1
      exact h1

    obtain ⟨l, α, β, γ, δ, hl, hdet, h1, h2, h3⟩ := c13 _ _ _ hnz hdisc
    obtain ⟨f, hf, e₁, he₁⟩ := wcpa_dj_lq_completion_presentation K R φ HilbR u v
      ⟨hu0, hv0, hspan, hind⟩ _ _ _ hnz hrel
    obtain ⟨f', hf', e₂, he₂⟩ :=
      wcpa_dj_bsc_linear_normalize K f _ _ _ α β γ δ l hl hdet h1 h2 h3 hf
    obtain ⟨e₃, he₃⟩ := wcpa_dj_ssp_bw_hensel_node K f' hf'
    refine ⟨e₁.trans (e₂.trans e₃), ?_⟩
    rw [RingEquiv.toRingHom_trans, RingEquiv.toRingHom_trans, RingHom.comp_assoc, he₁,
      RingHom.comp_assoc, he₂, he₃]
  obtain ⟨h, hφ, hflat, hm⟩ := wcpa_dj_lqr_basechange_stalk K L X a τ hτ τ' hτ's hτ'f
  exact key _ _ _ _ h hφ hflat hm (wcpa_dj_lqr_section_residue K X a τ hτ)
    (wcpa_dj_lqr_section_residue L _ _ τ' hτ's) e' he'

theorem wcpa_dj_sfi_descend : ∀ (K Ω : Type u) [Field K] [IsAlgClosed K] [Field Ω] [Algebra K Ω] (X : Scheme.{u}) (a : X ⟶ Spec (.of K)), Flat a → LocallyOfFinitePresentation a → wcpaDjSolSS a Ω (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) → ∀ x : X, (∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ a)) ∨ (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap (X.presheaf.stalk x) (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ x trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C) :=
by
  intro K Ω _ _ _ _ X a hfl hfp hSS x
  haveI := hfl
  haveI := hfp
  haveI : LocallyOfFiniteType a := inferInstance
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian a
  haveI : IsLocallyNoetherian
      (Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K Ω)))) :=
    LocallyOfFiniteType.isLocallyNoetherian
      (Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap K Ω))))
  haveI : Flat (Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K Ω)))) :=
    inferInstance

  obtain ⟨τ, hτ, hspec⟩ := wc_rational_closed_specialization K X a x

  have hw : (Spec.map (CommRingCat.ofHom (algebraMap K Ω)) ≫ τ) ≫ a =
      𝟙 _ ≫ Spec.map (CommRingCat.ofHom (algebraMap K Ω)) := by
    rw [Category.assoc, hτ, Category.comp_id, Category.id_comp]
  obtain ⟨τ', hτ's, hτ'f⟩ : ∃ τ' : Spec (.of Ω) ⟶
      Limits.pullback a (Spec.map (CommRingCat.ofHom (algebraMap K Ω))),
      τ' ≫ Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) = 𝟙 _ ∧
      τ' ≫ Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) =
        Spec.map (CommRingCat.ofHom (algebraMap K Ω)) ≫ τ :=
    ⟨Limits.pullback.lift _ _ hw, Limits.pullback.lift_snd _ _ _, Limits.pullback.lift_fst _ _ _⟩
  have hp₁ : Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K Ω)))
      (τ' (IsLocalRing.closedPoint Ω)) = τ (IsLocalRing.closedPoint K) := by
    have h1 : ∀ p : ↥(Spec (.of Ω)),
        Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) (τ' p) =
          τ (Spec.map (CommRingCat.ofHom (algebraMap K Ω)) p) := fun p => by
      rw [← Scheme.Hom.comp_apply, hτ'f, Scheme.Hom.comp_apply]
    exact (h1 _).trans (congrArg τ (Subsingleton.elim _ _))

  have hspec' : x ⤳ Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K Ω)))
      (τ' (IsLocalRing.closedPoint Ω)) := by
    rw [hp₁]; exact hspec
  obtain ⟨w, hww₁, hpw⟩ :=
    Flat.generalizingMap (Limits.pullback.fst a (Spec.map (CommRingCat.ofHom (algebraMap K Ω))))
      hspec'

  rcases hSS w with ⟨W, hwW, hsm⟩ | ⟨e, he⟩
  · left
    obtain ⟨W', hW', hsm'⟩ := wcpa_dj_bsc_smooth_descend (Spec (.of K)) X a Ω
      (Spec.map (CommRingCat.ofHom (algebraMap K Ω))) w hfl hfp ⟨W, hwW, hsm⟩
    rw [hpw] at hW'
    exact ⟨W', hW', hsm'⟩
  · right
    obtain ⟨-, hres, -⟩ := wcpa_dj_sfi_node_invariants Ω _ _ e he
    have hw1 : w = τ' (IsLocalRing.closedPoint Ω) :=
      wcpa_dj_sfi_rational_generization Ω _
        (Limits.pullback.snd a (Spec.map (CommRingCat.ofHom (algebraMap K Ω)))) w
        (τ' (IsLocalRing.closedPoint Ω)) hww₁ hres
    subst hw1
    have hx : x = τ (IsLocalRing.closedPoint K) := hpw.symm.trans hp₁
    rw [hx]
    exact wcpa_dj_sfi_node_descend K Ω X a τ hτ τ' hτ's hτ'f ⟨e, he⟩

theorem wcpa_dj_sno_field_invariance : ∀ (T Z : Scheme.{u}) [IsLocallyNoetherian T] (u : Z ⟶ T), Flat u → LocallyOfFinitePresentation u → ∀ (K₀ : Type u) [Field K₀] [IsAlgClosed K₀] (s₀ : Spec (.of K₀) ⟶ T), wcpaDjSolSS u K₀ s₀ → ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T), (∀ p, s p ∈ Set.range ⇑s₀) → wcpaDjSolSS u K s :=
by
  intro T Z _ u hfl hfp K₀ _ _ s₀ hSS₀ K _ _ s hs
  classical
  haveI := hfl
  haveI := hfp

  have fac : ∀ (F : Type u) [Field F] (g : Spec (.of F) ⟶ T), ∃ (x : T)
      (ι : T.residueField x ⟶ CommRingCat.of F), g = Spec.map ι ≫ T.fromSpecResidueField x := by
    intro F _ g
    refine ⟨(Scheme.SpecToEquivOfField F T g).1, (Scheme.SpecToEquivOfField F T g).2, ?_⟩
    rw [← Scheme.SpecToEquivOfField_symm_apply, Equiv.symm_apply_apply]

  have c1 : ∃ (Ω : Type u) (_ : Field Ω) (j : K →+* Ω) (j₀ : K₀ →+* Ω),
      Spec.map (CommRingCat.ofHom j) ≫ s = Spec.map (CommRingCat.ofHom j₀) ≫ s₀ := by
    obtain ⟨x, ι, hsx⟩ := fac K s
    obtain ⟨x₀, ι₀, hsx₀⟩ := fac K₀ s₀
    obtain ⟨q⟩ : Nonempty ↥(Spec (.of K)) :=
      ⟨show ↥(Spec (.of K)) from IsLocalRing.closedPoint K⟩
    obtain ⟨p₀, hp₀⟩ := hs q
    have hxx : x₀ = x := by
      have e1 : s q = x := by
        rw [hsx, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
      have e0 : s₀ p₀ = x₀ := by
        rw [hsx₀, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
      rw [← e1, ← e0, hp₀]
    subst hxx
    rw [hsx, hsx₀]
    letI : Algebra (T.residueField x₀) K := ι.hom.toAlgebra
    letI : Algebra (T.residueField x₀) K₀ := ι₀.hom.toAlgebra
    haveI : Nontrivial (TensorProduct (T.residueField x₀) K K₀) :=
      TensorProduct.nontrivial_of_linearMap_injective_of_flat_left (T.residueField x₀) K K₀
        (Algebra.linearMap (T.residueField x₀) K₀) (algebraMap (T.residueField x₀) K₀).injective
    obtain ⟨M, hM⟩ := Ideal.exists_maximal (TensorProduct (T.residueField x₀) K K₀)
    letI : Field (TensorProduct (T.residueField x₀) K K₀ ⧸ M) := Ideal.Quotient.field M
    refine ⟨TensorProduct (T.residueField x₀) K K₀ ⧸ M, inferInstance,
      (Ideal.Quotient.mk M).comp Algebra.TensorProduct.includeLeftRingHom,
      (Ideal.Quotient.mk M).comp
        (Algebra.TensorProduct.includeRight : K₀ →ₐ[T.residueField x₀] _).toRingHom, ?_⟩
    rw [← Category.assoc, ← Category.assoc, ← Spec.map_comp, ← Spec.map_comp]
    congr 2
    ext c
    change (Ideal.Quotient.mk M) (Algebra.TensorProduct.includeLeftRingHom
        (algebraMap (T.residueField x₀) K c)) = (Ideal.Quotient.mk M)
        (Algebra.TensorProduct.includeRight (algebraMap (T.residueField x₀) K₀ c))
    rw [Algebra.TensorProduct.includeLeftRingHom_apply, Algebra.TensorProduct.includeRight_apply,
      Algebra.TensorProduct.tmul_one_eq_one_tmul]

  have c2 : ∀ (K' Ω : Type u) [Field K'] [Field Ω] (j : K' →+* Ω) (s' : Spec (.of K') ⟶ T),
      wcpaDjSolSS u Ω (Spec.map (CommRingCat.ofHom j) ≫ s') ↔
        wcpaDjSolSS (Limits.pullback.snd u s') Ω (Spec.map (CommRingCat.ofHom j)) := by
    intro K' Ω _ _ j s'
    have hΦ := Limits.pullbackLeftPullbackSndIso_hom_snd u s' (Spec.map (CommRingCat.ofHom j))
    have hΦ' : (Limits.pullbackLeftPullbackSndIso u s' (Spec.map (CommRingCat.ofHom j))).symm.hom ≫
        Limits.pullback.snd (Limits.pullback.snd u s') (Spec.map (CommRingCat.ofHom j)) =
        Limits.pullback.snd u (Spec.map (CommRingCat.ofHom j) ≫ s') := by
      rw [Iso.symm_hom, Iso.inv_comp_eq, hΦ]
    constructor
    · intro h x
      exact wcpa_dj_ssp_bw_ns_transport Ω
        (Limits.pullbackLeftPullbackSndIso u s' (Spec.map (CommRingCat.ofHom j))) _ _ hΦ x
        (h _)
    · intro h y
      exact wcpa_dj_ssp_bw_ns_transport Ω
        (Limits.pullbackLeftPullbackSndIso u s' (Spec.map (CommRingCat.ofHom j))).symm _ _ hΦ' y
        (h _)

  obtain ⟨Ω₁, _, j, j₀, hj⟩ := c1
  let J : K →+* AlgebraicClosure Ω₁ := (algebraMap Ω₁ (AlgebraicClosure Ω₁)).comp j
  let J₀ : K₀ →+* AlgebraicClosure Ω₁ := (algebraMap Ω₁ (AlgebraicClosure Ω₁)).comp j₀
  have hJ : Spec.map (CommRingCat.ofHom J) ≫ s = Spec.map (CommRingCat.ofHom J₀) ≫ s₀ := by
    simp only [J, J₀, CommRingCat.ofHom_comp, Spec.map_comp, Category.assoc, hj]
  have hasc : wcpaDjSolSS (Limits.pullback.snd u s₀) (AlgebraicClosure Ω₁)
      (Spec.map (CommRingCat.ofHom J₀)) := by
    letI : Algebra K₀ (AlgebraicClosure Ω₁) := J₀.toAlgebra
    exact wcpa_dj_sfi_ascend K₀ (AlgebraicClosure Ω₁) (Limits.pullback u s₀)
      (Limits.pullback.snd u s₀) inferInstance inferInstance hSS₀
  have h1 : wcpaDjSolSS u (AlgebraicClosure Ω₁) (Spec.map (CommRingCat.ofHom J) ≫ s) := by
    rw [hJ]
    exact (c2 K₀ (AlgebraicClosure Ω₁) J₀ s₀).mpr hasc
  have h2 := (c2 K (AlgebraicClosure Ω₁) J s).mp h1
  letI : Algebra K (AlgebraicClosure Ω₁) := J.toAlgebra
  exact wcpa_dj_sfi_descend K (AlgebraicClosure Ω₁) (Limits.pullback u s)
    (Limits.pullback.snd u s) inferInstance inferInstance h2

theorem wcpa_dj_sol_nodal_open : ∀ (T Z : Scheme.{u}) [IsLocallyNoetherian T] (u : Z ⟶ T), Flat u → IsProper u → LocallyOfFinitePresentation u → ∀ (K₀ : Type u) [Field K₀] [IsAlgClosed K₀] (s₀ : Spec (.of K₀) ⟶ T), wcpaDjSolSS u K₀ s₀ → ∃ W : T.Opens, Set.range ⇑s₀ ⊆ (W : Set T) ∧ ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T), Set.range ⇑s ⊆ (W : Set T) → wcpaDjSolSS u K s :=
by
  intro T Z _ u hfl hpr hfp K₀ _ _ s₀ hSS₀
  classical
  have pt : ∀ {K : Type u} [Field K] (s : Spec (.of K) ⟶ T) (w : ↥(Limits.pullback u s)),
      u (Limits.pullback.fst u s w) = s (Limits.pullback.snd u s w) := by
    intro K _ s w
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
  let 𝒪 : Set Z.Opens := {O | ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T) (w : ↥(Limits.pullback u s)), Limits.pullback.fst u s w ∈ O → ((∃ W : (Limits.pullback u s).Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd u s)) ∨ (∃ e : AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback u s).presheaf.stalk w)) ((Limits.pullback u s).presheaf.stalk w) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), (e.toRingHom.comp ((algebraMap ((Limits.pullback u s).presheaf.stalk w) (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback u s).presheaf.stalk w)) ((Limits.pullback u s).presheaf.stalk w))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd u s).appTop ≫ (Limits.pullback u s).presheaf.germ ⊤ w trivial).hom)) = (Ideal.Quotient.mk _).comp MvPowerSeries.C))}
  let N : Z.Opens := sSup 𝒪
  have hN : ∀ z, z ∈ N ↔ ∃ O ∈ 𝒪, z ∈ O := fun z => TopologicalSpace.Opens.mem_sSup
  haveI := hpr
  have hBc : IsClosed (⇑u '' (N : Set Z)ᶜ) := u.isClosedMap _ N.isOpen.isClosed_compl
  let W : T.Opens := ⟨(⇑u '' (N : Set Z)ᶜ)ᶜ, hBc.isOpen_compl⟩
  have hgood : ∀ z : Z, u z ∈ W → z ∈ N := by
    intro z hz
    by_contra hzN
    exact hz ⟨z, hzN, rfl⟩
  refine ⟨W, ?_, ?_⟩
  · rintro _ ⟨p, rfl⟩
    rintro ⟨z, hzN, hz⟩
    apply hzN
    obtain ⟨O, hzO, hO⟩ := wcpa_dj_sno_node_open T Z u hfl hfp z (by
      intro K _ _ s w hw
      have hs : ∀ q, s q ∈ Set.range ⇑s₀ := by
        intro q
        refine ⟨p, ?_⟩
        rw [Subsingleton.elim q (Limits.pullback.snd u s w), ← pt, hw, hz]
      exact wcpa_dj_sno_field_invariance T Z u hfl hfp K₀ s₀ hSS₀ K s hs w)
    exact (hN z).mpr ⟨O, hO, hzO⟩
  · intro K _ _ s hs w
    have h1 : u (Limits.pullback.fst u s w) ∈ W := by
      rw [pt]; exact hs ⟨_, rfl⟩
    obtain ⟨O, hO, hwO⟩ := (hN _).mp (hgood _ h1)
    exact hO K s w hwO

theorem wcpa_dj_sso_generalize : ∀ (T Z : Scheme.{u}) [IsLocallyNoetherian T] (u : Z ⟶ T) (n : ℕ) (τ : Fin n → (T ⟶ Z)), Flat u → IsProper u → LocallyOfFinitePresentation u → (∀ i, τ i ≫ u = 𝟙 T) → ∀ W₀ : T.Opens, (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T), Set.range ⇑s ⊆ (W₀ : Set T) → wcpaDjSolSS u K s) → (∀ (i j : Fin n) (t : T), t ∈ W₀ → i ≠ j → τ i t ≠ τ j t) → (∀ (j : Fin n) (t : T), t ∈ W₀ → ∃ W : Z.Opens, τ j t ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ u)) → ∀ t t' : T, t' ⤳ t → t ∈ W₀ → (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T), s (IsLocalRing.closedPoint K) = t → wcpaDjSolStab u n τ K s) → ∀ (K' : Type u) [Field K'] [IsAlgClosed K'] (s' : Spec (.of K') ⟶ T), s' (IsLocalRing.closedPoint K') = t' → wcpaDjSolStab u n τ K' s' :=
by
  intro T Z _ u n τ hfl hpr _hfp hτ W₀ hSS hdis hsm t t' hspec htW₀ hstab K' _ _ s' hs'
  classical

  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]
  have spu : ∀ (X P V C : Scheme.{u}) (f : X ⟶ P) (b : V ⟶ P)
      (ψ : C ⟶ X) (g : C ⟶ V) (σ : P ⟶ X) (τ : V ⟶ C), IsPullback ψ g f b → σ ≫ f = 𝟙 P →
      τ ≫ g = 𝟙 V → τ ≫ ψ = b ≫ σ → ∀ c : C, ψ c = σ (b (g c)) → c = τ (g c) := by
    intro X P V C f b ψ g σ τ H1 H2 H3 H4 c h
    have hgτ : ∀ x : V, g (τ x) = x := by
      intro x
      rw [← Scheme.Hom.comp_apply, H3]
      rfl
    have hout : IsPullback (τ ≫ g) b b (σ ≫ f) := by
      rw [H3, H2]
      exact IsPullback.id_horiz b
    have hsq : IsPullback τ b ψ σ := IsPullback.of_right hout H4 H1.flip
    obtain ⟨p, hp, _⟩ := Scheme.exists_preimage_of_isPullback hsq c (b (g c)) h
    have hg : g c = p := by rw [← hp, hgτ]
    rw [hg, hp]
  have s3h : ∀ {X Y S : Scheme.{u}} (i : X ⟶ Y) [IsIso i] (p : X ⟶ S) (q : Y ⟶ S), i ≫ q = p →
      ∀ (W' : Y.Opens), SmoothOfRelativeDimension 1 (W'.ι ≫ q) →
        SmoothOfRelativeDimension 1 ((i ⁻¹ᵁ W').ι ≫ p) := by
    intro X Y S i _ p q hi W' hW'
    have hfac' : (i ⁻¹ᵁ W').ι ≫ p = (i ∣_ W') ≫ (W'.ι ≫ q) := by
      rw [← hi, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    have hpb : IsPullback (i ∣_ W') ((i ∣_ W') ≫ (W'.ι ≫ q)) (W'.ι ≫ q) (𝟙 S) :=
      IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]⟩
    rw [hfac']
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hW'
  have hcomap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B) (n : ℕ), IsLocalRing.maximalIdeal A ^ n ≤
        Ideal.comap (σ : A →+* B) (IsLocalRing.maximalIdeal B ^ n) := by
    intro A B _ _ _ _ σ n
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
    apply Ideal.pow_right_mono
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
    intro h
    exact hx ((MulEquiv.isUnit_map (σ : A ≃* B)).mp h)
  have hfac : ∀ (A : Type u) [CommRing A] (I : Ideal A) (m n : ℕ) (h : m ≤ n)
      (x : AdicCompletion I A),
      Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) = AdicCompletion.evalₐ I m x := by
    intro A _ I m n h x
    obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I A x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, Ideal.Quotient.factorPow,
      Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
    have := (Submodule.Quotient.eq _).mp (AdicCompletion.AdicCauchySequence.mk_eq_mk h c)
    simpa [smul_eq_mul, Ideal.mul_top] using this
  have hmap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ (n : ℕ) x (a : A),
        AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
        AdicCompletion.evalₐ _ n (Φ x) = Ideal.Quotient.mk _ (σ a) := by
    intro A B _ _ _ _ σ
    let f : ∀ n : ℕ, AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
        B ⧸ IsLocalRing.maximalIdeal B ^ n := fun n =>
      (Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)).comp
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom
    have hf : ∀ (n : ℕ) x (a : A), AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
        f n x = Ideal.Quotient.mk _ (σ a) := by
      intro n x a ha
      show Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)
        (AdicCompletion.evalₐ _ n x) = _
      rw [ha, Ideal.quotientMap_mk]
      rfl
    have hcompat : ∀ {m n : ℕ} (hle : m ≤ n),
        (Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal B) hle).comp (f n) = f m := by
      intro m n hle
      ext x
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n x)
      have ha' : AdicCompletion.evalₐ _ m x = Ideal.Quotient.mk _ a := by
        rw [← hfac A _ m n hle x, ← ha, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
      rw [RingHom.comp_apply, hf n x a ha.symm, hf m x a ha', Ideal.Quotient.factorPow,
        Ideal.Quotient.factor_mk]
    refine ⟨AdicCompletion.liftRingHom _ f hcompat, ?_⟩
    intro n x a ha
    rw [AdicCompletion.evalₐ_liftRingHom]
    exact hf n x a ha
  have s1a : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ a : A,
        Φ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) =
          algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (σ a) := by
    intro A B _ _ _ _ σ
    obtain ⟨Φ, hΦ⟩ := hmap A B σ
    obtain ⟨Ψ, hΨ⟩ := hmap B A σ.symm
    have h1 : Φ.comp Ψ = RingHom.id _ := by
      ext1 y
      apply AdicCompletion.ext_evalₐ
      intro n
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
      rw [RingHom.comp_apply, hΦ n _ _ (hΨ n y b hb.symm), RingEquiv.apply_symm_apply,
        RingHom.id_apply, hb]
    have h2 : Ψ.comp Φ = RingHom.id _ := by
      ext1 y
      apply AdicCompletion.ext_evalₐ
      intro n
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
      rw [RingHom.comp_apply, hΨ n _ _ (hΦ n y b hb.symm), RingEquiv.symm_apply_apply,
        RingHom.id_apply, hb]
    refine ⟨RingEquiv.ofRingHom Φ Ψ h1 h2, ?_⟩
    intro a
    apply AdicCompletion.ext_evalₐ
    intro n
    have hof : ∀ (R : Type u) [CommRing R] (I : Ideal R) (r : R),
        AdicCompletion.evalₐ I n (algebraMap R (AdicCompletion I R) r) =
          Ideal.Quotient.mk _ r := by
      intro R _ I r
      rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of, Algebra.algebraMap_self,
        RingHom.id_apply]
    show AdicCompletion.evalₐ _ n (Φ _) = _
    rw [hΦ n _ a (hof A _ a), hof B _ (σ a)]
  have s2a : ∀ (K : Type u) [Field K] {X Y : Scheme.{u}} (i : X ⟶ Y) (p : X ⟶ Spec (.of K))
      (q : Y ⟶ Spec (.of K)), i ≫ q = p → ∀ x : X,
      ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ Y.presheaf.germ ⊤ (i x) trivial) ≫
        i.stalkMap x =
      (Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial := by
    intro K _ X Y i p q hi x
    have key : Y.presheaf.germ ⊤ (i x) trivial ≫ i.stalkMap x =
        i.appTop ≫ X.presheaf.germ ⊤ x trivial := Scheme.Hom.germ_stalkMap i ⊤ x trivial
    rw [← hi, Scheme.Hom.comp_appTop]
    simp only [Category.assoc]
    exact congrArg (fun t => (Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ t) key
  have SSiso : ∀ (K : Type u) [Field K] {X Y : Scheme.{u}} (i : X ⟶ Y) [IsIso i]
      (p : X ⟶ Spec (.of K)) (q : Y ⟶ Spec (.of K)), i ≫ q = p → ∀ x : X,
      ((∃ W : Y.Opens, i x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) ∨
        (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk (i x)))
            (Y.presheaf.stalk (i x)) ≃+*
            (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
          (e.toRingHom.comp ((algebraMap (Y.presheaf.stalk (i x))
            (AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk (i x)))
              (Y.presheaf.stalk (i x)))).comp
            ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫
              Y.presheaf.germ ⊤ (i x) trivial).hom)) =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C)) →
      ((∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p)) ∨
        (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x))
            (X.presheaf.stalk x) ≃+*
            (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}),
          (e.toRingHom.comp ((algebraMap (X.presheaf.stalk x)
            (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x))
              (X.presheaf.stalk x))).comp
            ((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫
              X.presheaf.germ ⊤ x trivial).hom)) =
          (Ideal.Quotient.mk _).comp MvPowerSeries.C)) := by
    intro K _ X Y i _ p q hi w hY
    rcases hY with ⟨W', hw', hsm⟩ | ⟨e₀, he₀⟩
    · left
      exact ⟨i ⁻¹ᵁ W', hw', s3h i _ _ hi W' hsm⟩
    · right
      let τ := Iso.commRingCatIsoToRingEquiv (asIso (i.stalkMap w))
      obtain ⟨Φ, hΦ⟩ := s1a _ _ τ.symm
      refine ⟨Φ.trans e₀, ?_⟩
      have h2 := s2a K i _ _ hi w
      ext1 k
      have hk : τ.symm (((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫
          X.presheaf.germ ⊤ w trivial).hom k) =
          ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫
            Y.presheaf.germ ⊤ (i w) trivial).hom k := by
        rw [← h2, RingEquiv.symm_apply_eq]
        rfl
      have := RingHom.congr_fun he₀ k
      simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at this ⊢
      rw [RingEquiv.trans_apply, hΦ, hk]
      exact this
  have Stabiso : ∀ (K : Type u) [Field K] {X Y : Scheme.{u}} (e : X ≅ Y)
      (p : X ⟶ Spec (.of K)) (q : Y ⟶ Spec (.of K)), e.hom ≫ q = p →
      ∀ (RX : Fin n → ↥X → Prop) (RY : Fin n → ↥Y → Prop), (∀ i x, RX i x ↔ RY i (e.hom x)) →
      (∀ (E : Set Y), E ∈ irreducibleComponents Y →
        (∃ (Er : Scheme.{u}) (ι : Er ⟶ Y)
            (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra ≫
            Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ q) →
        3 ≤ (E ∩ closure Eᶜ).ncard + Nat.card {i : Fin n // ∃ x ∈ E, RY i x}) →
      (∀ (E : Set X), E ∈ irreducibleComponents X →
        (∃ (Er : Scheme.{u}) (ι : Er ⟶ X)
            (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra ≫
            Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ p) →
        3 ≤ (E ∩ closure Eᶜ).ncard + Nat.card {i : Fin n // ∃ x ∈ E, RX i x}) := by
    intro K _ X Y e p q he RX RY hR hY E hE hdat
    obtain ⟨Er, ι, θ, hci, hred, hrange, hθ⟩ := hdat
    obtain ⟨h, hh⟩ : ∃ h : ↥X ≃ₜ ↥Y, ∀ x, h x = e.hom x :=
      ⟨Scheme.homeoOfIso e, Scheme.homeoOfIso_apply e⟩
    have hE0 : h '' E ∈ irreducibleComponents ↥Y := by
      refine image_mem_irreducibleComponents_of_isPreirreducible_fiber h h.continuous h.isOpenMap
        ?_ h.surjective hE
      intro y
      apply Set.Subsingleton.isPreirreducible
      intro a ha a' ha'
      exact h.injective (ha.trans ha'.symm)
    have hcnt : (h '' E ∩ closure (h '' E)ᶜ).ncard = (E ∩ closure Eᶜ).ncard := by
      rw [← h.image_compl, ← h.image_closure, ← Set.image_inter h.injective]
      exact Set.ncard_image_of_injective _ h.injective
    have hdat0 : ∃ (Er : Scheme.{u}) (ι : Er ⟶ Y)
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
        IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = h '' E ∧
        θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra ≫
          Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ q := by
      refine ⟨Er, ι ≫ e.hom, θ, inferInstance, hred, ?_, ?_⟩
      · ext y
        constructor
        · rintro ⟨x, rfl⟩
          refine ⟨ι x, ?_, ?_⟩
          · rw [← hrange]; exact ⟨x, rfl⟩
          · rw [hh, Scheme.Hom.comp_apply]
        · rintro ⟨z, hz, rfl⟩
          rw [← hrange] at hz
          obtain ⟨x, rfl⟩ := hz
          exact ⟨x, by rw [hh, Scheme.Hom.comp_apply]⟩
      · rw [hθ, Category.assoc, he]
    have key := hY (h '' E) hE0 hdat0
    have hcard : Nat.card {i : Fin n // ∃ x ∈ E, RX i x} =
        Nat.card {i : Fin n // ∃ y ∈ h '' E, RY i y} := by
      refine Nat.card_congr (Equiv.subtypeEquivRight fun i => ⟨?_, ?_⟩)
      · rintro ⟨x, hx, hr⟩
        exact ⟨h x, ⟨x, hx, rfl⟩, by rw [hh]; exact (hR i x).mp hr⟩
      · rintro ⟨y, ⟨x, hx, rfl⟩, hr⟩
        exact ⟨x, hx, (hR i x).mpr (by rw [← hh]; exact hr)⟩
    rw [hcard, ← hcnt]
    exact key
  have wcpa_dj_sol_fibre_transfer : ∀ (T T' Z Z' : Scheme.{u}) (u : Z ⟶ T) (τ : Fin n → (T ⟶ Z))
      (b : T' ⟶ T) (u' : Z' ⟶ T') (φ : Z' ⟶ Z) (τ' : Fin n → (T' ⟶ Z')), IsPullback φ u' u b →
      (∀ i, τ i ≫ u = 𝟙 T) → (∀ i, τ' i ≫ u' = 𝟙 T') → (∀ i, τ' i ≫ φ = b ≫ τ i) →
      ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ T'),
        (wcpaDjSolSS u' K s ↔ wcpaDjSolSS u K (s ≫ b)) ∧
        (wcpaDjSolStab u' n τ' K s ↔ wcpaDjSolStab u n τ K (s ≫ b)) := by
    intro T T' Z Z' u τ b u' φ τ' hpb hτ hτ' hττ K _ s
    have hQ : IsPullback (Limits.pullback.fst u' s ≫ φ) (Limits.pullback.snd u' s) u (s ≫ b) :=
      (IsPullback.of_hasPullback u' s).paste_horiz hpb
    obtain ⟨e, I1, I2⟩ : ∃ e : Limits.pullback u' s ≅ Limits.pullback u (s ≫ b),
        e.hom ≫ Limits.pullback.fst u (s ≫ b) = Limits.pullback.fst u' s ≫ φ ∧
        e.hom ≫ Limits.pullback.snd u (s ≫ b) = Limits.pullback.snd u' s :=
      ⟨hQ.isoPullback, hQ.isoPullback_hom_fst, hQ.isoPullback_hom_snd⟩
    have I2' : e.inv ≫ Limits.pullback.snd u' s = Limits.pullback.snd u (s ≫ b) := by
      rw [← I2, Iso.inv_hom_id_assoc]
    have hiff : ∀ (i : Fin n) (x : ↥(Limits.pullback u' s)),
        (∃ p : ↥(Spec (.of K)), Limits.pullback.fst u' s x = τ' i (s p)) ↔
        (∃ p : ↥(Spec (.of K)), Limits.pullback.fst u (s ≫ b) (e.hom x) = τ i ((s ≫ b) p)) := by
      intro i x
      constructor
      · rintro ⟨p, hp⟩
        refine ⟨p, ?_⟩
        rw [pt I1 x, Scheme.Hom.comp_apply, hp, pt (hττ i) (s p), Scheme.Hom.comp_apply,
          Scheme.Hom.comp_apply]
      · rintro ⟨p, hp⟩
        refine ⟨p, ?_⟩
        set c := Limits.pullback.fst u' s x with hc
        have e1 : φ c = τ i (b (s p)) := by
          have h1 := pt I1 x
          rw [Scheme.Hom.comp_apply, hp, Scheme.Hom.comp_apply] at h1
          exact h1.symm
        have e2 : u' c = s p := by
          rw [hc, pt (Limits.pullback.condition (f := u') (g := s)) x, Scheme.Hom.comp_apply,
            Subsingleton.elim (Limits.pullback.snd u' s x) p]
        have key2 := spu Z T T' Z' u b φ u' (τ i) (τ' i) hpb (hτ i) (hτ' i) (hττ i) c
          (by rw [e2]; exact e1)
        rw [key2, e2]
    refine ⟨⟨fun h w => SSiso K e.inv _ _ I2' w (h (e.inv w)),
      fun h w => SSiso K e.hom _ _ I2 w (h (e.hom w))⟩, ⟨fun h => ?_, fun h => ?_⟩⟩
    · exact Stabiso K e.symm (Limits.pullback.snd u (s ≫ b)) (Limits.pullback.snd u' s) I2'
        (fun i y => ∃ p : ↥(Spec (.of K)), Limits.pullback.fst u (s ≫ b) y = τ i ((s ≫ b) p))
        (fun i x => ∃ p : ↥(Spec (.of K)), Limits.pullback.fst u' s x = τ' i (s p))
        (fun i y => by
          rw [hiff i (e.symm.hom y)]
          have hy : e.hom (e.inv y) = y := by
            rw [← Scheme.Hom.comp_apply e.inv e.hom, e.inv_hom_id]
            rfl
          show _ ↔ ∃ p, Limits.pullback.fst u (s ≫ b) (e.hom (e.inv y)) = _
          rw [hy]) h
    · exact Stabiso K e (Limits.pullback.snd u' s) (Limits.pullback.snd u (s ≫ b)) I2
        (fun i x => ∃ p : ↥(Spec (.of K)), Limits.pullback.fst u' s x = τ' i (s p))
        (fun i y => ∃ p : ↥(Spec (.of K)), Limits.pullback.fst u (s ≫ b) y = τ i ((s ≫ b) p))
        hiff h

  have hresAC : ∀ (K : Type u) [Field K] [IsAlgClosed K] (R : ValuationSubring K),
      IsAlgClosed (IsLocalRing.ResidueField ↥R) := by
    intro K _ _ R
    refine IsAlgClosed.of_exists_root _ ?_
    intro p hmon hirr
    obtain ⟨q, hqmap, hqdeg, hqmon⟩ := Polynomial.lifts_and_degree_eq_and_monic
      ((Polynomial.mem_lifts p).mpr
        (Polynomial.map_surjective (IsLocalRing.residue R) IsLocalRing.residue_surjective p)) hmon
    have hpdeg : 0 < p.degree := Polynomial.degree_pos_of_irreducible hirr
    have hQdeg : (q.map (algebraMap R K)).degree ≠ 0 := by
      rw [hqmon.degree_map, hqdeg]; exact ne_of_gt hpdeg
    obtain ⟨θ, hθ⟩ := IsAlgClosed.exists_root (q.map (algebraMap R K)) hQdeg
    have hθ' : Polynomial.eval₂ (algebraMap R K) θ q = 0 := by
      rwa [Polynomial.IsRoot, Polynomial.eval_map] at hθ
    have hint : IsIntegral R θ := ⟨q, hqmon, hθ'⟩
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hint
    have hy0 : q.eval y = 0 := by
      apply IsFractionRing.injective R K
      rw [map_zero, ← Polynomial.eval₂_at_apply, hy]
      exact hθ'
    exact ⟨IsLocalRing.residue R y, by
      rw [← hqmap, Polynomial.eval_map, Polynomial.eval₂_at_apply, hy0, map_zero]⟩

  subst hs'
  obtain ⟨R, g, hg1, hg2, hrange⟩ : ∃ (R : ValuationSubring K') (g : Spec (.of ↥R) ⟶ T),
      Spec.map (CommRingCat.ofHom (algebraMap ↥R K')) ≫ g = s' ∧
      g (IsLocalRing.closedPoint ↥R) = t ∧ Set.range ⇑g ⊆ (W₀ : Set T) := by
    have h0 : Spec.map (Scheme.stalkClosedPointTo s') ≫
        T.fromSpecStalk (s' (IsLocalRing.closedPoint K')) = s' :=
      Scheme.Spec_stalkClosedPointTo_fromSpecStalk s'
    set F := T.presheaf.stalkSpecializes hspec ≫ Scheme.stalkClosedPointTo s' with hFdef
    have hF : Spec.map F ≫ T.fromSpecStalk t = s' := by
      rw [hFdef, Spec.map_comp, Category.assoc, Scheme.SpecMap_stalkSpecializes_fromSpecStalk, h0]
    obtain ⟨R, hR, hloc⟩ := IsLocalRing.exists_factor_valuationRing F.hom
    let fR : T.presheaf.stalk t →+* ↥R := F.hom.codRestrict R.toSubring hR
    have : IsLocalHom (CommRingCat.ofHom fR).hom := hloc
    let g : Spec (.of ↥R) ⟶ T := Spec.map (CommRingCat.ofHom fR) ≫ T.fromSpecStalk t
    refine ⟨R, g, ?_, ?_, ?_⟩
    · rw [← hF, ← Category.assoc, ← Spec.map_comp]
      congr 2
    · show T.fromSpecStalk t (Spec.map (CommRingCat.ofHom fR) (IsLocalRing.closedPoint ↥R)) = t
      rw [Spec_closedPoint, Scheme.fromSpecStalk_closedPoint]
    · rintro _ ⟨q, rfl⟩
      have h1 : g q ∈ Set.range ⇑(T.fromSpecStalk t) := ⟨_, (Scheme.Hom.comp_apply _ _ q).symm⟩
      rw [Scheme.range_fromSpecStalk] at h1
      exact Specializes.mem_open h1 W₀.isOpen htW₀
  haveI : IsAlgClosed (IsLocalRing.ResidueField ↥R) := hresAC K' R

  have hpb : IsPullback (Limits.pullback.fst u g) (Limits.pullback.snd u g) u g :=
    IsPullback.of_hasPullback u g
  let σ : Fin n → (Spec (.of ↥R) ⟶ Limits.pullback u g) := fun i =>
    Limits.pullback.lift (g ≫ τ i) (𝟙 _)
      (by rw [Category.assoc, hτ i, Category.comp_id, Category.id_comp])
  have hσv : ∀ i, σ i ≫ Limits.pullback.snd u g = 𝟙 _ := fun i => Limits.pullback.lift_snd _ _ _
  have hσφ : ∀ i, σ i ≫ Limits.pullback.fst u g = g ≫ τ i := fun i =>
    Limits.pullback.lift_fst _ _ _
  have hFT : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥R)),
      (wcpaDjSolSS (Limits.pullback.snd u g) K s ↔ wcpaDjSolSS u K (s ≫ g)) ∧
      (wcpaDjSolStab (Limits.pullback.snd u g) n σ K s ↔ wcpaDjSolStab u n τ K (s ≫ g)) :=
    fun K _ s => wcpa_dj_sol_fibre_transfer T (Spec (.of ↥R)) Z (Limits.pullback u g) u τ g
      (Limits.pullback.snd u g) (Limits.pullback.fst u g) σ hpb hτ hσv hσφ K s
  have hrs : ∀ {K : Type u} [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥R)),
      Set.range ⇑(s ≫ g) ⊆ (W₀ : Set T) := by
    intro K _ s
    rintro _ ⟨p, rfl⟩
    rw [Scheme.Hom.comp_apply]
    exact hrange ⟨_, rfl⟩
  have huτ : ∀ i x, u (τ i x) = x := fun i x => by
    rw [← Scheme.Hom.comp_apply, hτ i]; rfl
  have hss : wcpaDjSemistable (Limits.pullback.snd u g) :=
    ⟨MorphismProperty.of_isPullback (P := @Flat) hpb hfl,
      MorphismProperty.of_isPullback (P := @IsProper) hpb hpr,
      fun K _ _ s => (hFT K s).1.mpr (hSS K (s ≫ g) (hrs s))⟩
  have hsec : wcpaDjSections (Limits.pullback.snd u g) n σ := by
    refine ⟨hσv, ?_, ?_⟩
    · intro i j p q hij heq
      have h1 := congrArg (⇑(Limits.pullback.fst u g)) heq
      rw [pt (hσφ i) p, pt (hσφ j) q, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
      have h2 : g p = g q := by
        have h3 := congrArg (⇑u) h1
        rwa [huτ, huτ] at h3
      rw [← h2] at h1
      exact hdis i j (g p) (hrange ⟨p, rfl⟩) hij h1
    · intro j p
      obtain ⟨W, hW, hWsm⟩ := hsm j (g p) (hrange ⟨p, rfl⟩)
      refine ⟨Limits.pullback.fst u g ⁻¹ᵁ W, ?_, ?_⟩
      · rw [Scheme.Hom.mem_preimage, pt (hσφ j) p, Scheme.Hom.comp_apply]
        exact hW
      · exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1)
          ((isPullback_morphismRestrict (Limits.pullback.fst u g) W).paste_vert hpb) hWsm

  haveI hlocal : IsLocalHom
      (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))).hom := by
    rw [CommRingCat.hom_ofHom, IsLocalRing.ResidueField.algebraMap_eq]; infer_instance
  have hc : (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))) ≫ g)
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥R)) = t := by
    show g (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R)))
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥R))) = t
    rw [Spec_closedPoint, hg2]
  have hstabκ := hstab (IsLocalRing.ResidueField ↥R) _ hc
  have hstabv := (hFT _ _).2.mpr hstabκ

  have hgen := wcpa_dj_lus_cfs_valuation_specialize K' R inferInstance (Limits.pullback u g)
    (Limits.pullback.snd u g) n σ hss hsec hstabv
  have hfin := (hFT K' _).2.mp hgen
  rwa [hg1] at hfin

theorem wcpa_dj_ssc_field_split : ∀ (k : Type u) [Field k] (T : Scheme.{u}) (h : T ⟶ Spec (.of k)) [IsProper h], (∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ Spec (.of k)), wcpaDjSolSS h Ω t) → ∃ (L : Type u) (_ : Field L) (_ : Algebra k L) (_ : FiniteDimensional k L) (r m : ℕ) (Z : Fin r → Set ↥(Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k L))))) (σ : Fin m → (Spec (.of L) ⟶ Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap k L))))), (∀ j, IsClosed (Z j)) ∧ (∀ a, σ a ≫ Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k L))) = 𝟙 _) ∧ (∀ j, ∃ a, σ a (IsLocalRing.closedPoint L) ∈ Z j ∧ ∀ j', j' ≠ j → σ a (IsLocalRing.closedPoint L) ∉ Z j') ∧ ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (t : Spec (.of Ω) ⟶ Spec (.of L)), (∀ j, (Limits.pullback.fst (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k L)))) t) ⁻¹' (Z j) ∈ irreducibleComponents ↥(Limits.pullback (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k L)))) t)) ∧ (∀ E ∈ irreducibleComponents ↥(Limits.pullback (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k L)))) t), ∃ j, E = (Limits.pullback.fst (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k L)))) t) ⁻¹' (Z j)) ∧ (∀ w : ↥(Limits.pullback (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k L)))) t), (∃ j j', j ≠ j' ∧ Limits.pullback.fst (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k L)))) t w ∈ Z j ∧ Limits.pullback.fst (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k L)))) t w ∈ Z j') → ∃ a, Limits.pullback.fst (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap k L)))) t w = σ a (IsLocalRing.closedPoint L)) :=
by
  have wcpa_dj_sfs_components_of_cover : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y] (π : Y → X) (r : ℕ) (W : Fin r → Set X), Continuous π → Function.Surjective π → (∀ j, IsClosed (W j)) → (⋃ j, W j) = Set.univ → (∀ j j', j ≠ j' → ¬ W j ⊆ W j') → (∀ j, IsIrreducible (π ⁻¹' W j)) → (∀ j, π ⁻¹' W j ∈ irreducibleComponents Y) ∧ (∀ E ∈ irreducibleComponents Y, ∃ j, E = π ⁻¹' W j) ∧ (∀ j j', π ⁻¹' W j = π ⁻¹' W j' → j = j') ∧ (∀ j, ∃ x ∈ W j, ∀ j', j' ≠ j → x ∉ W j') := by
    intro X Y _ _ π r W hc hs hcl hcov hinc hirr
    classical
    have star : ∀ j j', π ⁻¹' W j ⊆ π ⁻¹' W j' → j = j' := by
      intro j j' hsub
      by_contra hne
      apply hinc j j' hne
      intro x hx
      obtain ⟨y, rfl⟩ := hs x
      exact hsub hx
    have K : ∀ C : Set Y, IsIrreducible C → ∃ j, C ⊆ π ⁻¹' W j := by
      intro C hC
      obtain ⟨z, hz, hCz⟩ := (isIrreducible_iff_sUnion_isClosed.mp hC)
        (Finset.univ.image (fun j => π ⁻¹' W j))
        (by
          intro z hz
          obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp hz
          exact (hcl j).preimage hc)
        (by
          intro y _
          have : π y ∈ ⋃ j, W j := hcov ▸ Set.mem_univ _
          obtain ⟨j, hj⟩ := Set.mem_iUnion.mp this
          exact Set.mem_sUnion.mpr ⟨π ⁻¹' W j, by simp, hj⟩)
      obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp hz
      exact ⟨j, hCz⟩
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro j
      show Maximal IsIrreducible (π ⁻¹' W j)
      refine ⟨hirr j, fun C hC hsub => ?_⟩
      obtain ⟨j', hj'⟩ := K C hC
      have := star j j' (hsub.trans hj')
      subst this
      exact hj'
    · intro E hE
      obtain ⟨j, hj⟩ := K E hE.1
      exact ⟨j, le_antisymm hj (hE.2 (hirr j) hj)⟩
    · intro j j' heq
      exact star j j' heq.le
    · intro j
      by_contra hcon
      push_neg at hcon
      obtain ⟨z, hz, hCz⟩ := (isIrreducible_iff_sUnion_isClosed.mp (hirr j))
        ((Finset.univ.filter (· ≠ j)).image (fun j' => π ⁻¹' W j'))
        (by
          intro z hz
          obtain ⟨j', -, rfl⟩ := Finset.mem_image.mp hz
          exact (hcl j').preimage hc)
        (by
          intro y hy
          obtain ⟨j', hj', hy'⟩ := hcon (π y) hy
          exact Set.mem_sUnion.mpr ⟨π ⁻¹' W j', Finset.mem_image.mpr ⟨j', by simp [hj'], rfl⟩, hy'⟩)
      obtain ⟨j', hj', rfl⟩ := Finset.mem_image.mp hz
      have := star j j' hCz
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hj'
      exact hj' this.symm
