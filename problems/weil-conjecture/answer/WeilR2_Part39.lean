        x' = x) := by
    intro X Y _ _ _ _ _ f P hcont hfc Hch HA HB HC
    have T1 : ∀ x z : X, x ⤳ z → x ≠ z → closure ({x} : Set X) ∈ irreducibleComponents X := by
