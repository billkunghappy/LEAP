  have hpre : ∀ J, φ ⁻¹ᵁ wcpaLspD R M J = ⨆ a, Z.basicOpen (t J a) := by
    intro J
    calc φ ⁻¹ᵁ wcpaLspD R M J = φ ⁻¹ᵁ wcpaLspD R M J ⊓ ⨆ a, (Lc.V a ⊓ uu ⁻¹ᵁ ⊤) := by
