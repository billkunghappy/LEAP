        rw [← iSup_congr hpre_l, ← Scheme.Hom.preimage_iSup, hcovP, Scheme.Hom.preimage_top]
      have hq : (X.homOfLE (inf_le_left : U i ⊓ U j ≤ U i) ≫ φl i) ≫ wcpaLspStr R M =
