    obtain ⟨v, hv⟩ := hC ((htw _ _ _ _).mp hTw) w (by rw [hM]; exact hw)
    exact ⟨v, by rw [hv, hM]⟩

theorem wcpa_dj_lge_coh_base_change : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (Y : Scheme.{u}) (q : Y ⟶ Spec (.of ↥W)) (L : wcpaDjCoc Y) (e : ℕ),
    wcpaDjSemistable q → wcpaDjCocOK L →
    wcpaDjTwH1 (wcpaDjCocPull (Limits.pullback.fst q
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L) ⊤
      (wcStructMod (Limits.pullback q
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) e →
    wcpaLccBC q L e :=
by
  intro Ω _ W Y q L e hss hOK hTw
  obtain ⟨n0, n1, n2, D0, D1, β, h10, hG1, hG2, hF, hC⟩ :=
    wcpa_dj_lge_cbc_model Ω W Y q L e hss hOK
  obtain ⟨N, P, hP0, hPu⟩ := wcpa_dj_lge_cbc_kernel_basis (↥W) n0 n1 n2 D0 D1 h10 (hC hTw)

  have s3 : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥W)) (U : Y.Opens)
      (V : (Limits.pullback q s).Opens) (hU : U ≤ q ⁻¹ᵁ ⊤)
      (hV : V ≤ Limits.pullback.fst q s ⁻¹ᵁ U) (x : ↥W),
      ((Limits.pullback.fst q s).appLE U V hV).hom
          ((q.appLE ⊤ U hU).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom x)) =
        wcpaLccScal (Limits.pullback.snd q s) V ((Spec.preimage s).hom x) := by
    intro K _ s U V hU hV x
    have e1 : Spec.preimage s ≫ (Scheme.ΓSpecIso (.of K)).inv =
        (Scheme.ΓSpecIso (.of ↥W)).inv ≫ s.appTop := by
      have := Scheme.ΓSpecIso_inv_naturality (Spec.preimage s)
      rw [Spec.map_preimage] at this
      exact this
    have hc : Limits.pullback.fst q s ≫ q = Limits.pullback.snd q s ≫ s :=
      Limits.pullback.condition
    have h2 : ∀ (g : Limits.pullback q s ⟶ Spec (.of ↥W)) (h : V ≤ g ⁻¹ᵁ ⊤),
        g.appLE ⊤ V h = g.appTop ≫
          (Limits.pullback q s).presheaf.map (homOfLE (le_top : V ≤ ⊤)).op := fun g h => rfl
    have key3 : (Scheme.ΓSpecIso (.of ↥W)).inv ≫ q.appLE ⊤ U hU ≫
        (Limits.pullback.fst q s).appLE U V hV =
        Spec.preimage s ≫ (Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd q s).appTop ≫
          (Limits.pullback q s).presheaf.map (homOfLE (le_top : V ≤ ⊤)).op := by
      rw [Scheme.Hom.appLE_comp_appLE, ← Category.assoc (Spec.preimage s), e1, h2, hc,
        Scheme.Hom.comp_appTop]
      simp only [Category.assoc]
    exact congrArg (fun f => f.hom x) key3

  have key : ∀ {S R : Type u} [CommRing S] [CommRing R] (f : S →+* R)
      (P' : Matrix (Fin n0) (Fin N) S) (c : Fin N → S) (β' : Fin n0 → R),
      ∑ j, f (P'.mulVec c j) * β' j = ∑ k, f (c k) * ∑ j, f (P' j k) * β' j := by
    intro S R _ _ f P' c β'
    simp only [Matrix.mulVec, dotProduct, map_sum, map_mul, Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun k _ => Finset.sum_congr rfl (fun j _ => by ring))
  have hmapid : P.map (RingHom.id ↥W) = P := by ext; rfl
  have hmapid0 : D0.map (RingHom.id ↥W) = D0 := by ext; rfl
  obtain ⟨b, hb⟩ : ∃ b : Fin N → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤), ∀ k a,
      b k a = ∑ j, (q.appLE ⊤ (L.V a ⊓ q ⁻¹ᵁ ⊤) inf_le_right).hom
        ((Scheme.ΓSpecIso (.of ↥W)).inv.hom (P j k)) * β j a := ⟨_, fun _ _ => rfl⟩
  have hιinv : ∀ y : Γ(Spec (.of ↥W), ⊤),
      (Scheme.ΓSpecIso (.of ↥W)).inv.hom ((Scheme.ΓSpecIso (.of ↥W)).hom.hom y) = y := by
    intro y
    change ((Scheme.ΓSpecIso (.of ↥W)).hom ≫ (Scheme.ΓSpecIso (.of ↥W)).inv).hom y = y
    rw [Iso.hom_inv_id]
    rfl
  refine ⟨N, b, ?_, ?_, ?_⟩
  ·
    intro k
    have hcol : D0.mulVec (fun j => P j k) = 0 := by
      funext i
      change (∑ j, D0 i j * P j k) = 0
      rw [← Matrix.mul_apply, hP0]
      rfl
    have hbk : b k = fun a => ∑ j, (q.appLE ⊤ (L.V a ⊓ q ⁻¹ᵁ ⊤) inf_le_right).hom
        ((Scheme.ΓSpecIso (.of ↥W)).inv.hom (P j k)) * β j a := funext (hb k)
    rw [hbk]
    exact hG1 _ hcol
  ·
    intro t ht
    obtain ⟨v, ⟨hv0, hvt⟩, hvu⟩ := hG2 t ht
    obtain ⟨c0, hc0, hc0u⟩ := hPu (↥W) (RingHom.id _) v (by rw [hmapid0]; exact hv0)
    rw [hmapid] at hc0
    refine ⟨fun k => (Scheme.ΓSpecIso (.of ↥W)).inv.hom (c0 k), ?_, ?_⟩
    · intro a
      have hk := key (((q.appLE ⊤ (L.V a ⊓ q ⁻¹ᵁ ⊤) inf_le_right).hom).comp
        (Scheme.ΓSpecIso (.of ↥W)).inv.hom) P c0 (fun j => β j a)
      simp only [RingHom.comp_apply] at hk
      rw [hvt a, hc0, hk]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [hb k a]
    · intro c' hc'
      set c0' : Fin N → ↥W := fun k => (Scheme.ΓSpecIso (.of ↥W)).hom.hom (c' k) with hc0'
      have hιc : ∀ k, (Scheme.ΓSpecIso (.of ↥W)).inv.hom (c0' k) = c' k := fun k => hιinv _
      have hv' : P.mulVec c0' = v := by
        apply hvu
        refine ⟨by rw [Matrix.mulVec_mulVec, hP0, Matrix.zero_mulVec], fun a => ?_⟩
        have hk := key (((q.appLE ⊤ (L.V a ⊓ q ⁻¹ᵁ ⊤) inf_le_right).hom).comp
          (Scheme.ΓSpecIso (.of ↥W)).inv.hom) P c0' (fun j => β j a)
        simp only [RingHom.comp_apply] at hk
        rw [hc' a, hk]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        rw [hb k a, hιc k]
      have hcc : c0' = c0 := hc0u c0'
        (show v = (P.map (RingHom.id ↥W)).mulVec c0' by rw [hmapid]; exact hv'.symm)
      funext k
      rw [← hιc k, hcc]
  ·
    intro K _ s t' ht'
    obtain ⟨_, hF2⟩ := hF K s
    obtain ⟨v, ⟨hv0, hvt⟩, hvu⟩ := hF2 t' ht'
    obtain ⟨c0, hc0, hc0u⟩ := hPu K (Spec.preimage s).hom v hv0
    have hPF : ∀ k a, wcpaLccPullFam q L s (b k) a =
        ∑ j, wcpaLccScal (Limits.pullback.snd q s)
          ((wcpaDjCocPull (Limits.pullback.fst q s) L).V a ⊓ (Limits.pullback.snd q s) ⁻¹ᵁ ⊤)
          ((Spec.preimage s).hom (P j k)) * wcpaLccPullFam q L s (β j) a := by
      intro k a
      simp only [wcpaLccPullFam]
      rw [hb k a, map_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [map_mul]
      congr 1
      exact s3 K s _ _ _ _ _
    refine ⟨c0, ?_, ?_⟩
    · intro a
      rw [hvt a, hc0, key (wcpaLccScal (Limits.pullback.snd q s)
          ((wcpaDjCocPull (Limits.pullback.fst q s) L).V a ⊓ (Limits.pullback.snd q s) ⁻¹ᵁ ⊤))
          (P.map (Spec.preimage s).hom) c0 (fun j => wcpaLccPullFam q L s (β j) a)]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [hPF k a]
      rfl
    · intro c' hc'
      have hv' : (P.map (Spec.preimage s).hom).mulVec c' = v := by
        apply hvu
        refine ⟨by rw [Matrix.mulVec_mulVec, ← Matrix.map_mul, hP0,
          Matrix.map_zero _ (map_zero _), Matrix.zero_mulVec], fun a => ?_⟩
        rw [hc' a, key (wcpaLccScal (Limits.pullback.snd q s)
          ((wcpaDjCocPull (Limits.pullback.fst q s) L).V a ⊓ (Limits.pullback.snd q s) ⁻¹ᵁ ⊤))
          (P.map (Spec.preimage s).hom) c' (fun j => wcpaLccPullFam q L s (β j) a)]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        rw [hPF k a]
        rfl
      exact hc0u c' hv'.symm

theorem wcpa_dj_lge_gg_spread : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (Y : Scheme.{u}) (q : Y ⟶ Spec (.of ↥W)) (L : wcpaDjCoc Y) (e : ℕ),
    IsProper q → wcpaLccBC q L e →
    wcpaLccGG (Limits.pullback.snd q
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
      (wcpaDjCocPull (Limits.pullback.fst q
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L) e →
    wcpaLccGG q L e :=
by
  intro Ω _ W Y q L e hprop hBC hGG
  classical

  have s1 : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Y : Scheme.{u}) (q : Y ⟶ Spec (.of A))
      (U : Y.Opens), UniversallyClosed q →
      (∀ x : ↥(Limits.pullback q
          (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))),
        Limits.pullback.fst q
          (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) x ∈ U) →
      U = ⊤ := by
    intro A _ _ Y q U hq hU
    haveI := hq
    rw [eq_top_iff]
    intro z _
    by_contra hz
    have hcl : IsClosed (q '' (U : Set Y)ᶜ) := q.isClosedMap _ U.isOpen.isClosed_compl
    have hmem : IsLocalRing.closedPoint A ∈ q '' (U : Set Y)ᶜ :=
      (IsLocalRing.specializes_closedPoint (q z)).mem_closed hcl ⟨z, hz, rfl⟩
    obtain ⟨z', hz', hqz'⟩ := hmem
    have hρ : (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))
        (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) = IsLocalRing.closedPoint A := by
      have e1 : (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))
          (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) =
          PrimeSpectrum.comap (algebraMap A (IsLocalRing.ResidueField A))
            (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) := rfl
      rw [e1]
      apply PrimeSpectrum.ext
      show Ideal.comap (algebraMap A (IsLocalRing.ResidueField A))
        (IsLocalRing.maximalIdeal (IsLocalRing.ResidueField A)) = IsLocalRing.maximalIdeal A
      rw [IsLocalRing.maximalIdeal_eq_bot, ← RingHom.ker_eq_comap_bot,
        IsLocalRing.ResidueField.algebraMap_eq, IsLocalRing.ker_residue]
    obtain ⟨x, hx, -⟩ := Scheme.Pullback.exists_preimage_pullback
      (f := q) (g := Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))
      z' (IsLocalRing.closedPoint (IsLocalRing.ResidueField A)) (hqz'.trans hρ.symm)
    exact hz' (hx ▸ hU x)

  have hscal : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Y : Scheme.{u})
      (q : Y ⟶ Spec (.of A)) (V : Y.Opens) (hV : V ≤ q ⁻¹ᵁ ⊤)
      (O : (Limits.pullback q
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).Opens)
      (hO : O ≤ Limits.pullback.fst q
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ V)
      (x : A),
      ((Limits.pullback.fst q
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).appLE
          V O hO).hom ((q.appLE ⊤ V hV).hom ((Scheme.ΓSpecIso (.of A)).inv.hom x)) =
        wcpaLccScal (Limits.pullback.snd q
          (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) O
          (IsLocalRing.residue A x) := by
    intro A _ _ Y q V hV O hO x
    have e1 : ((Limits.pullback.fst q
        (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).appLE
          V O hO).hom ((q.appLE ⊤ V hV).hom ((Scheme.ΓSpecIso (.of A)).inv.hom x)) =
        ((Limits.pullback.fst q
          (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) ≫ q).appLE
            ⊤ O (by simp only [Scheme.Hom.preimage_top]; exact le_top)).hom
              ((Scheme.ΓSpecIso (.of A)).inv.hom x) :=
      congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (.of A)).inv.hom x))
        (Scheme.Hom.appLE_comp_appLE _ q ⊤ V O hV hO)
    have e2 : ∀ (g g' : Limits.pullback q
          (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) ⟶
          Spec (.of A)) (_ : g = g') (h : O ≤ g ⁻¹ᵁ ⊤) (h' : O ≤ g' ⁻¹ᵁ ⊤)
        (y : Γ(Spec (.of A), ⊤)), (g.appLE ⊤ O h).hom y = (g'.appLE ⊤ O h').hom y := by
      rintro g _ rfl h h' y
      rfl
    refine e1.trans ((e2 _ _ Limits.pullback.condition _
      (by simp only [Scheme.Hom.preimage_top]; exact le_top) _).trans ?_)
    have e4 : (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))).appTop.hom
        ((Scheme.ΓSpecIso (.of A)).inv.hom x) =
        (Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField A))).inv.hom (IsLocalRing.residue A x) := by
      have := congrArg (fun φ => φ.hom x)
        (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at this
      rw [← this, IsLocalRing.ResidueField.algebraMap_eq]
    unfold wcpaLccScal
    rw [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_comp, RingHom.comp_apply,
      ← e4]
    rfl

  have hres : ∀ (V V' : Y.Opens) (hV : V ≤ q ⁻¹ᵁ ⊤) (h : V' ≤ V) (x : Γ(Spec (.of ↥W), ⊤)),
      (Y.presheaf.map (homOfLE h).op).hom ((q.appLE ⊤ V hV).hom x) =
        (q.appLE ⊤ V' (h.trans hV)).hom x := by
    intro V V' hV h x
    exact congrArg (fun φ => φ.hom x) (Scheme.Hom.appLE_map q hV (homOfLE h).op)
  obtain ⟨N, b, hb, -, hfib⟩ := hBC
  obtain ⟨M, s, hs, hcov⟩ := hGG
  choose c hc using fun J => (hfib _
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) (s J) (hs J)).exists
  choose w hw using fun J j => IsLocalRing.residue_surjective (R := ↥W) (c J j)
  let S : Fin M → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤) := fun J a =>
    ∑ j, (q.appLE ⊤ (L.V a ⊓ q ⁻¹ᵁ ⊤) inf_le_right).hom
      ((Scheme.ΓSpecIso (.of ↥W)).inv.hom (w J j)) * b j a

  have compat : ∀ J, wcpaDjCompat L (q ⁻¹ᵁ ⊤) e (S J) := by
    intro J a a'
    simp only [S, map_sum, map_mul, hres]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [hb j a a', mul_left_comm]

  have hpull : ∀ J a, wcpaLccPullFam q L
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) (S J) a =
      s J a := by
    intro J a
    rw [hc J a]
    unfold wcpaLccPullFam
    simp only [S, map_sum, map_mul]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    congr 1
    rw [← hw J j]
    exact hscal _ _ _ _ _ _ _ _
  refine ⟨M, S, compat, ?_⟩
  have key : ∀ (x : ↥(Limits.pullback q
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))))
      (J : Fin M) (a : Fin L.m),
      x ∈ (Limits.pullback q
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).basicOpen
          (s J a) →
      Limits.pullback.fst q
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x ∈
        Y.basicOpen (S J a) := by
    intro x J a hx
    rw [← hpull J a] at hx
    have h2 := Scheme.basicOpen_appLE (Limits.pullback.fst q
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
      ((wcpaDjCocPull (Limits.pullback.fst q
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L).V a ⊓
        (Limits.pullback.snd q
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ⁻¹ᵁ ⊤)
      (L.V a ⊓ q ⁻¹ᵁ ⊤) (fun _ hx => ⟨hx.1, trivial⟩) (S J a)
    have h3 := Eq.mp (congrArg (fun U => x ∈ U) h2) hx
    exact h3.2
  haveI := hprop
  apply s1 (↥W) Y q _ inferInstance
  intro x
  have hx : x ∈ (⊤ : (Limits.pullback q
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).Opens) := trivial
  rw [← hcov, TopologicalSpace.Opens.mem_iSup] at hx
  obtain ⟨J, hx⟩ := hx
  rw [TopologicalSpace.Opens.mem_iSup] at hx
  obtain ⟨a, hx⟩ := hx
  rw [TopologicalSpace.Opens.mem_iSup]
  refine ⟨J, ?_⟩
  rw [TopologicalSpace.Opens.mem_iSup]
  exact ⟨a, key x J a hx⟩

theorem wcpa_dj_lcc_good_exponent : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (r : ℕ)
    (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)) (L : wcpaDjCoc Z₁)
    (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)),
    wcpaDjSemistable u₁ → wcpaDjSections u₁ r ε → wcpaDjCocOK L →
    wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) 1 t →
    (∀ a, (Z₁.basicOpen (t a) : Set Z₁) =
      ((L.V a ⊓ u₁ ⁻¹ᵁ ⊤ : Z₁.Opens) : Set Z₁) \ ⋃ i, Set.range ⇑(ε i)) →
    wcpaLccHAF u₁ ε →
    ∃ m : ℕ, 0 < m ∧ (∀ k : ℕ, 1 ≤ k → wcpaLccBC u₁ L (m * k)) ∧ wcpaLccGG u₁ L m :=
by
  intro Ω _ _ W Z₁ u₁ r ε L t hss hsec hOK hcompat hbo hAF
  classical

  have hκ : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    apply IsAlgClosed.of_exists_root
    intro p hmon hirr
    have hlift : p ∈ Polynomial.lifts (IsLocalRing.residue ↥W) := by
      obtain ⟨q, hq⟩ := Polynomial.map_surjective (IsLocalRing.residue ↥W)
        IsLocalRing.residue_surjective p
      exact Polynomial.mem_lifts _ |>.mpr ⟨q, hq⟩
    obtain ⟨P, hPmap, hPdeg, hPmon⟩ := Polynomial.lifts_and_natDegree_eq_and_monic hlift hmon
    have hdeg : 0 < p.natDegree :=
      Polynomial.natDegree_pos_iff_degree_pos.mpr (Polynomial.degree_pos_of_irreducible hirr)
    have hmapdeg : (P.map (algebraMap ↥W Ω)).natDegree = p.natDegree := by
      rw [hPmon.natDegree_map, hPdeg]
    have hd0 : (P.map (algebraMap ↥W Ω)).degree ≠ 0 := by
      intro h
      rw [Polynomial.degree_eq_natDegree (hPmon.map _).ne_zero] at h
      norm_cast at h
      omega
    obtain ⟨α, hα⟩ := IsAlgClosed.exists_root _ hd0
    have hint : IsIntegral ↥W α := by
      refine ⟨P, hPmon, ?_⟩
      rw [Polynomial.IsRoot, Polynomial.eval_map] at hα
      exact hα
    obtain ⟨y, hy⟩ := IsIntegrallyClosed.algebraMap_eq_of_integral hint
    have hPy : P.eval y = 0 := by
      apply IsFractionRing.injective ↥W Ω
      rw [map_zero, ← Polynomial.eval₂_at_apply, hy]
      rw [Polynomial.IsRoot, Polynomial.eval_map] at hα
      exact hα
    refine ⟨IsLocalRing.residue ↥W y, ?_⟩
    have key : (P.map (IsLocalRing.residue ↥W)).eval (IsLocalRing.residue ↥W y) = 0 := by
      rw [Polynomial.eval_map, Polynomial.eval₂_at_apply, hPy, map_zero]
    rw [← hPmap]
    exact key

  obtain ⟨m₀, hm₀, hgood⟩ :=
    wcpa_dj_lge_closed_fibre_good Ω W Z₁ u₁ r ε L t hκ hss hsec hOK hcompat hbo hAF
  refine ⟨m₀, hm₀, fun k hk => ?_, ?_⟩
  ·
    have hle : m₀ ≤ m₀ * k := Nat.le_mul_of_pos_right m₀ hk
    exact wcpa_dj_lge_coh_base_change Ω W Z₁ u₁ L (m₀ * k) hss hOK (hgood (m₀ * k) hle).1
  ·
    have hBC := wcpa_dj_lge_coh_base_change Ω W Z₁ u₁ L m₀ hss hOK (hgood m₀ le_rfl).1
    exact wcpa_dj_lge_gg_spread Ω W Z₁ u₁ L m₀ hss.2.1 hBC (hgood m₀ le_rfl).2

theorem wcpa_dj_lcc_sr_cocok_pull : ∀ {Y' Y : Scheme.{u}} (h : Y' ⟶ Y) [IsAffineHom h] (L : wcpaDjCoc Y), wcpaDjCocOK L → wcpaDjCocOK (wcpaDjCocPull h L) :=
by
  have hpull : ∀ {Y' Y : Scheme.{u}} (h : Y' ⟶ Y) (U : Y.Opens) (V V' : Y'.Opens)
      (h1 : V' ≤ h ⁻¹ᵁ U) (h2 : V ≤ V') (x : Γ(Y, U)),
      (Y'.presheaf.map (homOfLE h2).op).hom ((Y'.presheaf.map (homOfLE h1).op).hom
        ((h.app U).hom x)) = (h.appLE U V (h2.trans h1)).hom x := by
    intro Y' Y h U V V' h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp, Scheme.Hom.appLE,
      ← CommRingCat.comp_apply]
    rfl
  intro Y' Y h _ L hL
  obtain ⟨hA, hcov, h1, hcoc⟩ := hL
  refine ⟨fun a => (hA a).preimage h, ?_, ?_, ?_⟩
  · show ⨆ a, h ⁻¹ᵁ L.V a = ⊤
    rw [← Scheme.Hom.preimage_iSup, hcov, Scheme.Hom.preimage_top]
  · intro a
    show Units.map _ (L.g a a) = 1
    rw [h1 a, map_one]
  · intro a b c
    have hg : ∀ (a b : Fin L.m) (V : Y'.Opens)
        (hV : V ≤ (wcpaDjCocPull h L).V a ⊓ (wcpaDjCocPull h L).V b),
        (Y'.presheaf.map (homOfLE hV).op).hom ((wcpaDjCocPull h L).g a b :
          Γ(Y', (wcpaDjCocPull h L).V a ⊓ (wcpaDjCocPull h L).V b)) =
        (h.appLE (L.V a ⊓ L.V b) V (fun x hx => hV hx)).hom (L.g a b) := by
      intro a b V hV
      exact hpull h (L.V a ⊓ L.V b) V _ _ hV _
    have hT : (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c) ≤ h ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ L.V c) :=
      fun x hx => ⟨⟨hx.1.1, hx.1.2⟩, hx.2⟩
    have e := congrArg (h.appLE (L.V a ⊓ L.V b ⊓ L.V c) _ hT).hom (hcoc a b c)
    rw [map_mul] at e
    simp only [← CommRingCat.comp_apply, Scheme.Hom.map_appLE] at e
    have e1 := hg a b (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c)
      (fun x hx => ⟨hx.1.1, hx.1.2⟩)
    have e2 := hg b c (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c)
      (fun x hx => ⟨hx.1.2, hx.2⟩)
    have e3 := hg a c (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c)
      (fun x hx => ⟨hx.1.1, hx.2⟩)
    exact (congrArg₂ (· * ·) e1 e2).trans (e.trans e3.symm)

theorem wcpa_dj_lcc_sr_pencil_exists : ∀ (κ : Type u) [Field κ] [Infinite κ] (Y : Scheme.{u}) (q : Y ⟶ Spec (.of κ)) (L : wcpaDjCoc Y) (p : ℕ), wcpaDjCocOK L → TopologicalSpace.NoetherianSpace ↥Y → topologicalKrullDim ↥Y ≤ ((1 : ℕ) : WithBot ℕ∞) → wcpaLccGG q L p → ∃ s₁ s₂ : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤), wcpaDjCompat L (q ⁻¹ᵁ ⊤) p s₁ ∧ wcpaDjCompat L (q ⁻¹ᵁ ⊤) p s₂ ∧ ∀ a, ∃ α β : Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤), α * s₁ a + β * s₂ a = 1 :=
by
  classical

  have unitTransfer : ∀ (Y : Scheme.{u}) {U V V' W : Y.Opens} (i : Opposite.op U ⟶ Opposite.op W)
      (j : Opposite.op V ⟶ Opposite.op W) (k : Opposite.op V' ⟶ Opposite.op W)
      (x : Γ(Y, U)) (z : Γ(Y, V)) (w : Γ(Y, V')), IsUnit w →
      (Y.presheaf.map i).hom x = (Y.presheaf.map k).hom w * (Y.presheaf.map j).hom z →
      ∀ y ∈ W, y ∈ Y.basicOpen z → y ∈ Y.basicOpen x := by
    intro Y U V V' W i j k x z w hw h y hyW hyz
    have h2 := congrArg Y.basicOpen h
    rw [Scheme.basicOpen_mul, Scheme.basicOpen_res, Scheme.basicOpen_res, Scheme.basicOpen_res,
      Y.basicOpen_of_isUnit hw] at h2
    have hV' : y ∈ V' := (leOfHom k.unop) hyW
    have : y ∈ W ⊓ Y.basicOpen x := by
      rw [h2]
      exact ⟨⟨hyW, hV'⟩, hyW, hyz⟩
    exact this.2
  have transfer : ∀ (Y : Scheme.{u}) (L : wcpaDjCoc Y) (O : Y.Opens) (e : ℕ)
      (f : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ O)), wcpaDjCompat L O e f →
      ∀ (a b : Fin L.m) (y : Y), y ∈ L.V b → y ∈ Y.basicOpen (f a) → y ∈ Y.basicOpen (f b) := by
    intro Y L O e f hf a b y hyb hya
    have hyaO : y ∈ L.V a ⊓ O := Y.basicOpen_le (f a) hya
    have hW : y ∈ L.V a ⊓ L.V b ⊓ O := ⟨⟨hyaO.1, hyb⟩, hyaO.2⟩
    exact unitTransfer Y _ _ _ (f b) (f a) _ ((L.g a b).isUnit.pow e) (hf a b) y hW hya

  have closedFinite : ∀ (X : Type u) [TopologicalSpace X] [TopologicalSpace.NoetherianSpace X]
      [T0Space X], topologicalKrullDim X ≤ ((1 : ℕ) : WithBot ℕ∞) → ∀ Z : Set X, IsClosed Z →
      (∀ E ∈ irreducibleComponents X, ¬ E ⊆ Z) → Z.Finite := by
    intro X _ _ _ hdim Z hZ hcomp
    obtain ⟨S, hSirr, hSeq⟩ := TopologicalSpace.NoetherianSpace.exists_finset_irreducible ⟨Z, hZ⟩
    have hZeq : Z = ⋃ C ∈ S, (C : Set X) := by
      have := congrArg (fun c : TopologicalSpace.Closeds X => (c : Set X)) hSeq
      simpa [TopologicalSpace.Closeds.coe_finset_sup, Finset.sup_set_eq_biUnion] using this
    rw [hZeq]
    refine Set.Finite.biUnion S.finite_toSet fun C hC => ?_
    have hCirr : IsIrreducible (C : Set X) := hSirr ⟨C, hC⟩
    have hCZ : (C : Set X) ⊆ Z := fun x hx => by rw [hZeq]; exact Set.mem_biUnion hC hx
    obtain ⟨z, hzC, hzcl⟩ := C.isClosed.exists_closed_singleton hCirr.nonempty
    by_cases hCz : (C : Set X) = {z}
    · rw [hCz]; exact Set.finite_singleton z
    exfalso
    obtain ⟨E, hEcomp, hCE⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _ hCirr
    have hEirr : IsIrreducible E := hEcomp.prop
    have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hEcomp
    have hCE' : (C : Set X) ≠ E := fun h => hcomp E hEcomp (h ▸ hCZ)
    let P0 : TopologicalSpace.IrreducibleCloseds X := ⟨{z}, isIrreducible_singleton, hzcl⟩
    let P1 : TopologicalSpace.IrreducibleCloseds X := ⟨C, hCirr, C.isClosed⟩
    let P2 : TopologicalSpace.IrreducibleCloseds X := ⟨E, hEirr, hEcl⟩
    have h01 : P0 < P1 := by
      refine lt_of_le_of_ne ?_ ?_
      · show ({z} : Set X) ⊆ (C : Set X)
        exact Set.singleton_subset_iff.mpr hzC
      · intro h
        apply hCz
        have := congrArg (fun P : TopologicalSpace.IrreducibleCloseds X => (P : Set X)) h
        exact this.symm
    have h12 : P1 < P2 := by
      refine lt_of_le_of_ne ?_ ?_
      · show (C : Set X) ⊆ E
        exact hCE
      · intro h
        apply hCE'
        exact congrArg (fun P : TopologicalSpace.IrreducibleCloseds X => (P : Set X)) h
    let l : LTSeries (TopologicalSpace.IrreducibleCloseds X) :=
      RelSeries.mk 2 ![P0, P1, P2] (fun i => by fin_cases i; exacts [h01, h12])
    have hl : ((2 : ℕ) : WithBot ℕ∞) ≤ Order.krullDim (TopologicalSpace.IrreducibleCloseds X) :=
      Order.LTSeries.length_le_krullDim l
    have h2 : ((2 : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) := hl.trans hdim
    have h3 : (2 : ℕ) ≤ 1 := by exact_mod_cast h2
    omega

  intro κ _ _ Y q L p hOK hN hdim hGG
  haveI := hN
  obtain ⟨M, s, hs, hcov⟩ := hGG
  let Sc : ∀ V : Y.Opens, κ →+* Γ(Y, V) := fun V =>
    ((Scheme.ΓSpecIso (.of κ)).inv ≫ q.appTop ≫ Y.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom
  have hSc : ∀ (V V' : Y.Opens) (i : Opposite.op V ⟶ Opposite.op V') (x : κ),
      (Y.presheaf.map i).hom (Sc V x) = Sc V' x := by
    intro V V' i x
    simp only [Sc]
    rw [← CommRingCat.comp_apply, Category.assoc, Category.assoc, ← Functor.map_comp]
    rfl
  let comb : (Fin M → κ) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤) := fun c a =>
    ∑ J, Sc _ (c J) * s J a
  have hcomb : ∀ c, wcpaDjCompat L (q ⁻¹ᵁ ⊤) p (comb c) := by
    intro c a b
    simp only [comb, map_sum, map_mul, hSc, Finset.mul_sum]
    refine Finset.sum_congr rfl fun J _ => ?_
    rw [hs J a b]
    ring
  have hsingle : ∀ J a, comb (Pi.single J 1) a = s J a := by
    intro J a
    simp only [comb]
    rw [Finset.sum_eq_single J]
    · rw [Pi.single_eq_same, map_one, one_mul]
    · intro J' _ hJ'
      rw [Pi.single_eq_of_ne hJ', map_zero, zero_mul]
    · intro h
      exact absurd (Finset.mem_univ J) h
  let H : ∀ (a : Fin L.m) (y : Y) (_ : y ∈ L.V a ⊓ q ⁻¹ᵁ ⊤), Subspace κ (Fin M → κ) :=
    fun a y hy =>
    { carrier := {c | (Y.presheaf.germ _ y hy).hom (comb c a) ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk y)}
      add_mem' := by
        intro c d hc hd
        simp only [Set.mem_setOf_eq] at hc hd ⊢
        have : comb (c + d) a = comb c a + comb d a := by
          simp only [comb, Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
        rw [this, map_add]
        exact Ideal.add_mem _ hc hd
      zero_mem' := by
        simp only [Set.mem_setOf_eq]
        have : comb 0 a = 0 := by
          simp only [comb, Pi.zero_apply, map_zero, zero_mul, Finset.sum_const_zero]
        rw [this, map_zero]
        exact Ideal.zero_mem _
      smul_mem' := by
        intro r c hc
        simp only [Set.mem_setOf_eq] at hc ⊢
        have : comb (r • c) a = Sc _ r * comb c a := by
          simp only [comb, Pi.smul_apply, smul_eq_mul, map_mul, Finset.mul_sum, mul_assoc]
        rw [this, map_mul]
        exact Ideal.mul_mem_left _ _ hc }
  have hchart : ∀ y : Y, ∃ a, y ∈ L.V a ⊓ q ⁻¹ᵁ ⊤ := by
    intro y
    have : y ∈ (⨆ a, L.V a) := by rw [hOK.2.1]; trivial
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp this
    exact ⟨a, ha, by rw [Scheme.Hom.preimage_top]; trivial⟩
  choose ach hach using hchart
  have hcovpt : ∀ y : Y, ∃ J a, y ∈ Y.basicOpen (s J a) := by
    intro y
    have : y ∈ (⨆ J, ⨆ a, Y.basicOpen (s J a)) := by rw [hcov]; trivial
    obtain ⟨J, hJ⟩ := TopologicalSpace.Opens.mem_iSup.mp this
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hJ
    exact ⟨J, a, ha⟩

  have avoid : ∀ S : Set Y, S.Finite → ∃ t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤),
      wcpaDjCompat L (q ⁻¹ᵁ ⊤) p t ∧ ∀ y ∈ S, ∀ a, y ∈ L.V a → y ∈ Y.basicOpen (t a) := by
    intro S hS
    haveI := hS.to_subtype
    obtain ⟨c, hc⟩ : ∃ c : Fin M → κ, ∀ y : S, c ∉ H (ach y) y (hach y) := by
      by_contra hne
      push_neg at hne
      have hU : ⋃ y : S, ((H (ach y) y (hach y) : Subspace κ (Fin M → κ)) : Set (Fin M → κ))
          = Set.univ := by
        apply Set.eq_univ_of_forall
        intro c
        obtain ⟨y, hy⟩ := hne c
        exact Set.mem_iUnion.mpr ⟨y, hy⟩
      obtain ⟨y, hy⟩ := Subspace.exists_eq_top_of_iUnion_eq_univ hU
      obtain ⟨J, a₀, hJ⟩ := hcovpt y
      have hb : (y : Y) ∈ Y.basicOpen (s J (ach y)) :=
        transfer Y L _ p (s J) (hs J) a₀ (ach y) y (hach y).1 hJ
      have hunit := (Scheme.mem_basicOpen Y (s J (ach y)) y (hach y)).mp hb
      have hmem : (Pi.single J (1 : κ)) ∈ H (ach y) y (hach y) := by
        rw [hy]; exact Submodule.mem_top
      have h2 : (Y.presheaf.germ _ (y : Y) (hach y)).hom (comb (Pi.single J 1) (ach y)) ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk (y : Y)) := hmem
      rw [hsingle] at h2
      exact IsLocalRing.notMem_maximalIdeal.mpr hunit h2
    refine ⟨comb c, hcomb c, fun y hy a hya => ?_⟩
    have h1 : (Y.presheaf.germ _ y (hach y)).hom (comb c (ach y)) ∉
        IsLocalRing.maximalIdeal (Y.presheaf.stalk y) := hc ⟨y, hy⟩
    have h2 : y ∈ Y.basicOpen (comb c (ach y)) :=
      (Scheme.mem_basicOpen Y _ y (hach y)).mpr (IsLocalRing.notMem_maximalIdeal.mp h1)
    exact transfer Y L _ p (comb c) (hcomb c) (ach y) a y hya h2

  let S₀ : Set Y := {y | ∃ E ∈ irreducibleComponents Y, IsGenericPoint y E}
  have hS₀ : S₀.Finite := by
    have hsub : S₀ ⊆ ⋃ E ∈ irreducibleComponents Y, {y | IsGenericPoint y E} := by
      rintro y ⟨E, hE, hy⟩
      exact Set.mem_biUnion hE hy
    refine Set.Finite.subset
      ((TopologicalSpace.NoetherianSpace.finite_irreducibleComponents (α := Y)).biUnion
        fun E _ => ?_) hsub
    exact Set.Subsingleton.finite fun x hx y hy => hx.eq hy
  obtain ⟨s₁, hs₁, hs₁S⟩ := avoid S₀ hS₀
  let Z : Set Y := {y | y ∉ (⨆ b, Y.basicOpen (s₁ b) : Y.Opens)}
  have hZcl : IsClosed Z := (⨆ b, Y.basicOpen (s₁ b) : Y.Opens).isOpen.isClosed_compl
  have hZcomp : ∀ E ∈ irreducibleComponents Y, ¬ E ⊆ Z := by
    intro E hE hEZ
    have hEirr : IsIrreducible E := hE.prop
    have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
    have hgen := hEirr.isGenericPoint_genericPoint hEcl
    have hηS : hEirr.genericPoint ∈ S₀ := ⟨E, hE, hgen⟩
    have hη := hs₁S _ hηS (ach hEirr.genericPoint) (hach hEirr.genericPoint).1
    apply hEZ hgen.mem
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨_, hη⟩
  have hZfin : Z.Finite := closedFinite Y hdim Z hZcl hZcomp
  obtain ⟨s₂, hs₂, hs₂Z⟩ := avoid Z hZfin
  refine ⟨s₁, s₂, hs₁, hs₂, fun a => ?_⟩
  have haff : IsAffineOpen (L.V a ⊓ q ⁻¹ᵁ ⊤) := by
    rw [Scheme.Hom.preimage_top, inf_top_eq]; exact hOK.1 a
  have hcover : (L.V a ⊓ q ⁻¹ᵁ ⊤) ≤
      ⨆ f : ({s₁ a, s₂ a} : Set Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)), Y.basicOpen (f : Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)) := by
    intro y hy
    rw [TopologicalSpace.Opens.mem_iSup]
    by_cases hyZ : y ∈ Z
    · exact ⟨⟨s₂ a, Set.mem_insert_of_mem _ rfl⟩, hs₂Z y hyZ a hy.1⟩
    · have hy' : y ∈ (⨆ b, Y.basicOpen (s₁ b) : Y.Opens) := not_not.mp hyZ
      obtain ⟨b, hb⟩ := TopologicalSpace.Opens.mem_iSup.mp hy'
      exact ⟨⟨s₁ a, Set.mem_insert _ _⟩, transfer Y L _ p s₁ hs₁ b a y hy.1 hb⟩
  have hspan := haff.self_le_iSup_basicOpen_iff.mp hcover
  have h1 : (1 : Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)) ∈ Ideal.span {s₁ a, s₂ a} := by
    rw [hspan]; exact Submodule.mem_top
  obtain ⟨α, β, h⟩ := Ideal.mem_span_pair.mp h1
  exact ⟨α, β, h⟩

theorem wcpa_dj_lcc_sr_pencil_mul_surj : ∀ (Y : Scheme.{u}) (L : wcpaDjCoc Y) (O : Y.Opens) (p e : ℕ) (s₁ s₂ : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ O)), wcpaDjCocOK L → wcpaDjCompat L O p s₁ → wcpaDjCompat L O p s₂ → (∀ a, ∃ α β : Γ(Y, L.V a ⊓ O), α * s₁ a + β * s₂ a = 1) → (∀ c : ∀ a b : Fin L.m, Γ(Y, L.V a ⊓ L.V b ⊓ O), (∀ a b d, (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ O ≤ L.V a ⊓ L.V d ⊓ O from inf_le_inf_right O (inf_le_inf_right (L.V d) inf_le_left))).op).hom (c a d) = (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ O ≤ L.V b ⊓ L.V d ⊓ O from inf_le_inf_right O (inf_le_inf_right (L.V d) inf_le_right))).op).hom (c b d) + ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ O ≤ L.V b ⊓ L.V d from (inf_le_left : L.V a ⊓ L.V b ⊓ L.V d ⊓ O ≤ L.V a ⊓ L.V b ⊓ L.V d).trans (inf_le_inf_right (L.V d) inf_le_right))).op).hom (L.g b d : Γ(Y, L.V b ⊓ L.V d))) ^ e * (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ O ≤ L.V a ⊓ L.V b ⊓ O from le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (c a b)) → ∃ β : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ O), ∀ a b, c a b = (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ O ≤ L.V b ⊓ O from le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β b) - ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ O ≤ L.V a ⊓ L.V b from inf_le_left)).op).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b))) ^ e * (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ O ≤ L.V a ⊓ O from le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β a)) → ∀ x : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ O), wcpaDjCompat L O (p + (p + e)) x → ∃ y₁ y₂ : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ O), wcpaDjCompat L O (p + e) y₁ ∧ wcpaDjCompat L O (p + e) y₂ ∧ ∀ a, x a = s₁ a * y₁ a + s₂ a * y₂ a :=
by
  intro Y L O p e s₁ s₂ hOK hs₁ hs₂ hbez hH1 x hx
  have rr : ∀ {U V W : Y.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (z : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom z) =
        (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom z := by
    intro U V W h1 h2 z
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have resEq : ∀ {U T : Y.Opens} (h : T ≤ U) {u v : Γ(Y, U)}, u = v →
      (Y.presheaf.map (homOfLE h).op).hom u = (Y.presheaf.map (homOfLE h).op).hom v :=
    fun _ _ _ e => congrArg _ e
  have cocyc : ∀ {R : Type u} [CommRing R]
      {A B G s1a s2a s1b s2b s1d s2d αa βa αb βb αd βd xa xb : R},
      A * B = G → s1b = A ^ p * s1a → s2b = A ^ p * s2a → s1d = B ^ p * s1b →
      s2d = B ^ p * s2b → xb = A ^ (p + (p + e)) * xa → αa * s1a + βa * s2a = 1 →
      αb * s1b + βb * s2b = 1 → αd * s1d + βd * s2d = 1 →
      G ^ (p + e) * (αd * βa - αa * βd) * xa =
        B ^ (p + e) * (αd * βb - αb * βd) * xb +
          B ^ e * (A ^ (p + e) * (αb * βa - αa * βb) * xa) := by
    intro R _ A B G s1a s2a s1b s2b s1d s2d αa βa αb βb αd βd xa xb hG h1ab h2ab h1bd h2bd
      hxab ha hb hd
    subst hG
    linear_combination (-(B ^ (p + e) * (αd * βb - αb * βd))) * hxab
      + (-(A ^ (p + e) * B ^ e * xa) * A ^ p * B ^ p * (αb * βd - βb * αd)) * ha
      + (-(A ^ (p + e) * B ^ e * xa) * B ^ p * (αd * βa - βd * αa)) * hb
      + ((A ^ (p + e) * B ^ e * xa) * B ^ p * (αd * βa - βd * αa) * αb
