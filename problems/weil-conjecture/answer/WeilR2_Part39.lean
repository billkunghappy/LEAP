theorem wcpa_dj_lmga_proper : ∀ (Ω : Type u) [Field Ω] (W W' : ValuationSubring Ω)
    (Wb : ValuationSubring (IsLocalRing.ResidueField ↥W')) (hle : W ≤ W') (πb : ↥W →+* ↥Wb),
    Function.Surjective πb →
    IsPullback (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)) (CommRingCat.ofHom πb)
      (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))
      (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W'))) →
    ∀ (Z Z' Zb : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (u' : Z' ⟶ Spec (.of ↥W'))
      (ub : Zb ⟶ Spec (.of ↥Wb)) (i' : Z' ⟶ Z) (ib : Zb ⟶ Z),
      IsPullback i' u' uu (Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle))) →
      IsPullback ib ub uu (Spec.map (CommRingCat.ofHom πb)) →
      IsProper u' → IsProper ub → LocallyOfFiniteType uu → QuasiCompact uu → IsSeparated uu →
      (∀ (R R1 R2 B : CommRingCat.{u}) (p1 : R ⟶ R1) (p2 : R ⟶ R2) (q1 : R1 ⟶ B) (q2 : R2 ⟶ B),
        IsPullback p1 p2 q1 q2 → Function.Surjective ⇑(ConcreteCategory.hom q1) →
        IsLocalRing R1 → IsLocalRing R2 → Nontrivial B →
        ∀ (a1 : Spec R1 ⟶ Z') (a2 : Spec R2 ⟶ Zb),
          Spec.map q1 ≫ a1 ≫ i' = Spec.map q2 ≫ a2 ≫ ib →
          ∃ t : Spec R ⟶ Z, Spec.map p1 ≫ t = a1 ≫ i' ∧ Spec.map p2 ≫ t = a2 ≫ ib) →
      IsProper uu :=
by
  intro Ω _ W W' Wb hle πb hsurj hpbR Z Z' Zb uu u' ub i' ib hpi' hpib hp' hpb hlft hqc hsep hlift

  have hS : ∀ {X Y T : Type u} [CommRing X] [CommRing Y] [CommRing T] (f : X →+* Y) (g : Y →+* T),
      Spec.map (CommRingCat.ofHom g) ≫ Spec.map (CommRingCat.ofHom f) =
        Spec.map (CommRingCat.ofHom (g.comp f)) := by
    intro X Y T _ _ _ f g
    rw [← Spec.map_comp]; rfl

  have s1 : ∀ {Z Z₁ S S₁ : Scheme.{u}} (uu : Z ⟶ S) (u₁ : Z₁ ⟶ S₁) (i : Z₁ ⟶ Z) (j : S₁ ⟶ S),
      IsPullback i u₁ uu j → IsProper u₁ → ∀ (R K : Type u) [CommRing R] [IsDomain R]
      [ValuationRing R] [Field K] [Algebra R K] [IsFractionRing R K] (i₁ : Spec (.of K) ⟶ Z)
      (i₂ : Spec (.of R) ⟶ S₁),
      i₁ ≫ uu = Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ i₂ ≫ j →
      ∃ l : Spec (.of R) ⟶ Z₁, Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ l ≫ i = i₁ ∧
        l ≫ u₁ = i₂ := by
    intro Z Z₁ S S₁ uu u₁ i j hpb hp R K _ _ _ _ _ _ i₁ i₂ h
    have hE : ValuativeCriterion.Existence u₁ := by
      have : UniversallyClosed u₁ := inferInstance
      rw [UniversallyClosed.eq_valuativeCriterion] at this
      exact this.1
    let m := hpb.lift i₁ (Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ i₂)
      (by rw [h, Category.assoc])
    have hm1 : m ≫ i = i₁ := hpb.lift_fst _ _ _
    have hm2 : m ≫ u₁ = Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ i₂ := hpb.lift_snd _ _ _
    obtain ⟨⟨l, hl1, hl2⟩⟩ := hE ⟨R, K, m, i₂, ⟨hm2⟩⟩
    exact ⟨l, by rw [← Category.assoc, hl1, hm1], hl2⟩

  have hw0 : ∀ w : ↥W, algebraMap ↥W' (IsLocalRing.ResidueField ↥W')
      (ValuationSubring.inclusion W W' hle w) =
        algebraMap ↥Wb (IsLocalRing.ResidueField ↥W') (πb w) :=
    fun w => congrArg (fun f => f.hom w) hpbR.w
  have ha : ∀ w : ↥W, πb w = 0 ↔
      ValuationSubring.inclusion W W' hle w ∈ IsLocalRing.maximalIdeal ↥W' := by
    intro w
    rw [← map_eq_zero_iff _ (IsFractionRing.injective ↥Wb (IsLocalRing.ResidueField ↥W')), ← hw0,
      IsLocalRing.ResidueField.algebraMap_eq, IsLocalRing.residue_eq_zero_iff]
  have hb : ∀ z : ↥W', ∃ a s : ↥W, πb s ≠ 0 ∧
      ValuationSubring.inclusion W W' hle s * z = ValuationSubring.inclusion W W' hle a := by
    intro z
    by_cases hz : (z : Ω) ∈ W
    · refine ⟨⟨z, hz⟩, 1, by simp, ?_⟩
      rw [map_one, one_mul]
      rfl
    · have hz0 : (z : Ω) ≠ 0 := fun h => hz (h ▸ W.zero_mem)
      have hzi : (z : Ω)⁻¹ ∈ W := (W.mem_or_inv_mem z).resolve_left hz
      have e : ValuationSubring.inclusion W W' hle ⟨(z : Ω)⁻¹, hzi⟩ * z =
          ValuationSubring.inclusion W W' hle 1 := by
        apply Subtype.ext
        show (z : Ω)⁻¹ * (z : Ω) = 1
        exact inv_mul_cancel₀ hz0
      refine ⟨1, ⟨(z : Ω)⁻¹, hzi⟩, ?_, e⟩
      rw [Ne, ha, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, not_not]
      rw [map_one] at e
      exact IsUnit.of_mul_eq_one _ e
  have hc : ∀ p s : ↥W, πb p = 0 → πb s ≠ 0 → ∃ p₁ : ↥W, πb p₁ = 0 ∧ p = s * p₁ := by
    intro p s hp hs
    by_cases hp0 : p = 0
    · exact ⟨0, map_zero _, by rw [hp0, mul_zero]⟩
    have hs0 : s ≠ 0 := fun h => hs (by rw [h, map_zero])
    have hp0' : (p : Ω) ≠ 0 := fun h => hp0 (Subtype.ext h)
    have hs0' : (s : Ω) ≠ 0 := fun h => hs0 (Subtype.ext h)
    rcases W.mem_or_inv_mem ((p : Ω) / (s : Ω)) with h | h
    · refine ⟨⟨(p : Ω) / (s : Ω), h⟩, ?_, ?_⟩
      · have e : p = s * ⟨(p : Ω) / (s : Ω), h⟩ := by
          apply Subtype.ext
          show (p : Ω) = (s : Ω) * ((p : Ω) / (s : Ω))
          field_simp
        have e2 := congrArg πb e
        rw [map_mul, hp] at e2
        exact (mul_eq_zero.mp e2.symm).resolve_left hs
      · apply Subtype.ext
        show (p : Ω) = (s : Ω) * ((p : Ω) / (s : Ω))
        field_simp
    · exfalso
      have e : s = p * ⟨((p : Ω) / (s : Ω))⁻¹, h⟩ := by
        apply Subtype.ext
        show (s : Ω) = (p : Ω) * ((p : Ω) / (s : Ω))⁻¹
        field_simp
      apply hs
      rw [e, map_mul, hp, zero_mul]

  have s3 : ∀ (R K : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [Field K] [Algebra R K]
      [IsFractionRing R K] (φ : ↥W →+* R),
      (∃ φb : ↥Wb →+* R, φb.comp πb = φ) ∨
      (∃ φ' : ↥W' →+* R, φ'.comp (ValuationSubring.inclusion W W' hle) = φ) ∨
      (∃ (A A' : ValuationSubring K) (_ : A ≤ A') (eA : R ≃+* ↥A) (φ' : ↥W' →+* ↥A'),
        (∀ r : R, ((eA r : ↥A) : K) = algebraMap R K r) ∧
        (∀ w : ↥W, ((φ' (ValuationSubring.inclusion W W' hle w) : ↥A') : K) =
          algebraMap R K (φ w)) ∧
        ∀ w : ↥W, πb w = 0 →
          φ' (ValuationSubring.inclusion W W' hle w) ∈ IsLocalRing.maximalIdeal ↥A') := by
    intro R K _ _ _ _ _ _ φ
    classical
    set ι := ValuationSubring.inclusion W W' hle with hι
    have hιinj : Function.Injective ι := fun x y h =>
      Subtype.ext (congrArg (fun z : ↥W' => (z : Ω)) h)
    let M : Submonoid ↥W :=
      { carrier := {s | πb s ≠ 0}
        one_mem' := by simp
        mul_mem' := fun {a b} ha hb => by
          simp only [Set.mem_setOf_eq, map_mul] at ha hb ⊢
          exact mul_ne_zero ha hb }
    letI : Algebra ↥W ↥W' := ι.toAlgebra
    haveI hloc : IsLocalization M ↥W' :=
      { map_units := by
          rintro ⟨s, hs⟩
          have hs' : ι s ∉ IsLocalRing.maximalIdeal ↥W' := fun h => hs ((ha s).mpr h)
          exact (IsLocalRing.notMem_maximalIdeal.mp hs')
        surj := by
          intro z
          obtain ⟨a, s, hs, e⟩ := hb z
          exact ⟨(a, ⟨s, hs⟩), by rw [mul_comm]; exact e⟩
        exists_of_eq := by
          intro x y h
          exact ⟨1, by rw [hιinj h]⟩ }
    by_cases hA : ∀ p, πb p = 0 → φ p = 0
    · left
      refine ⟨RingHom.liftOfSurjective πb hsurj ⟨φ, fun x hx => hA x hx⟩, ?_⟩
      exact RingHom.liftOfSurjective_comp πb hsurj _
    push_neg at hA
    obtain ⟨p₀, hp₀, hφp₀⟩ := hA
    have hN : ∀ s : ↥W, πb s ≠ 0 → φ s ≠ 0 := by
      intro s hs h0
      obtain ⟨p₁, _, e⟩ := hc p₀ s hp₀ hs
      apply hφp₀
      rw [e, map_mul, h0, zero_mul]
    by_cases hB : ∀ s : ↥W, πb s ≠ 0 → IsUnit (φ s)
    · right; left
      refine ⟨IsLocalization.lift (M := M) (S := ↥W') (g := φ) (fun y => hB y.1 y.2), ?_⟩
      exact IsLocalization.lift_comp _
    right; right
    push_neg at hB
    obtain ⟨s₀, hs₀, hs₀u⟩ := hB
    set alg := algebraMap R K with halg
    have hinj : Function.Injective alg := IsFractionRing.injective R K
    let A : ValuationSubring K :=
      { toSubring := alg.range
        mem_or_inv_mem' := by
          intro x
          rcases ValuationRing.isInteger_or_isInteger R x with ⟨r, hr⟩ | ⟨r, hr⟩
          · left; exact ⟨r, hr⟩
          · right; exact ⟨r, hr⟩ }
    have hmemA : ∀ x : K, x ∈ A ↔ ∃ r : R, alg r = x := fun x => Iff.rfl
    let A' : ValuationSubring K :=
      { carrier := {x | ∃ s : ↥W, πb s ≠ 0 ∧ ∃ r : R, alg r = alg (φ s) * x}
        zero_mem' := ⟨1, by simp, 0, by simp⟩
        one_mem' := ⟨1, by simp, 1, by simp⟩
        add_mem' := by
          rintro x y ⟨s₁, hs₁, r₁, hr₁⟩ ⟨s₂, hs₂, r₂, hr₂⟩
          refine ⟨s₁ * s₂, by rw [map_mul]; exact mul_ne_zero hs₁ hs₂, φ s₂ * r₁ + φ s₁ * r₂, ?_⟩
          simp only [map_mul, map_add, hr₁, hr₂]
          ring
        mul_mem' := by
          rintro x y ⟨s₁, hs₁, r₁, hr₁⟩ ⟨s₂, hs₂, r₂, hr₂⟩
          refine ⟨s₁ * s₂, by rw [map_mul]; exact mul_ne_zero hs₁ hs₂, r₁ * r₂, ?_⟩
          simp only [map_mul, hr₁, hr₂]
          ring
        neg_mem' := by
          rintro x ⟨s, hs, r, hr⟩
          exact ⟨s, hs, -r, by rw [map_neg, hr, mul_neg]⟩
        mem_or_inv_mem' := by
          intro x
          rcases ValuationRing.isInteger_or_isInteger R x with ⟨r, hr⟩ | ⟨r, hr⟩
          · left; exact ⟨1, by simp, r, by rw [map_one, map_one, one_mul]; exact hr⟩
          · right; exact ⟨1, by simp, r, by rw [map_one, map_one, one_mul]; exact hr⟩ }
    have hmemA' : ∀ x : K, x ∈ A' ↔ ∃ s : ↥W, πb s ≠ 0 ∧ ∃ r : R, alg r = alg (φ s) * x :=
      fun x => Iff.rfl
    have hAA : A ≤ A' := by
      intro x hx
      obtain ⟨r, hr⟩ := (hmemA x).mp hx
      exact (hmemA' x).mpr ⟨1, by simp, r, by simp [hr]⟩
    let eAh : R →+* ↥A := alg.codRestrict A (fun r => (hmemA _).mpr ⟨r, rfl⟩)
    have heAh : ∀ r, ((eAh r : ↥A) : K) = alg r := fun r => rfl
    have heAbij : Function.Bijective eAh := by
      refine ⟨fun x y h => hinj (by rw [← heAh, ← heAh, h]), ?_⟩
      rintro ⟨x, hx⟩
      obtain ⟨r, hr⟩ := (hmemA x).mp hx
      exact ⟨r, Subtype.ext hr⟩
    let eA : R ≃+* ↥A := RingEquiv.ofBijective eAh heAbij
    let g : ↥W →+* ↥A' := (alg.comp φ).codRestrict A'
      (fun w => (hmemA' _).mpr ⟨1, by simp, φ w, by simp⟩)
    have hg : ∀ w, ((g w : ↥A') : K) = alg (φ w) := fun w => rfl
    have hgu : ∀ y : M, IsUnit (g y) := by
      rintro ⟨s, hs⟩
      have hy0 : alg (φ s) ≠ 0 := by
        rw [map_ne_zero_iff _ hinj]; exact hN s hs
      have hmem : (alg (φ s))⁻¹ ∈ A' :=
        (hmemA' _).mpr ⟨s, hs, 1, by rw [map_one, mul_inv_cancel₀ hy0]⟩
      refine IsUnit.of_mul_eq_one (⟨(alg (φ s))⁻¹, hmem⟩ : ↥A') ?_
      apply Subtype.ext
      show alg (φ s) * (alg (φ s))⁻¹ = 1
      exact mul_inv_cancel₀ hy0
    let φ' : ↥W' →+* ↥A' := IsLocalization.lift (M := M) (S := ↥W') (g := g) hgu
    have hφ' : ∀ w, φ' (ι w) = g w := fun w => IsLocalization.lift_eq hgu w
    refine ⟨A, A', hAA, eA, φ', fun r => rfl, fun w => by rw [hφ', hg], ?_⟩
    intro p hp
    rw [hφ', IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    obtain ⟨v, hv⟩ := hu.exists_right_inv
    have hv' : alg (φ p) * (v : K) = 1 := by
      have := congrArg Subtype.val hv
      exact this
    obtain ⟨s, hs, r, hr⟩ := (hmemA' _).mp v.2
    have e1 : φ p * r = φ s := by
      apply hinj
      rw [map_mul, hr, ← mul_assoc, mul_comm (alg (φ p)), mul_assoc, hv', mul_one]
    have hss₀ : πb (s * s₀) ≠ 0 := by rw [map_mul]; exact mul_ne_zero hs hs₀
    obtain ⟨p₁, _, hp₁⟩ := hc p (s * s₀) hp hss₀
    rw [hp₁, map_mul, map_mul] at e1
    have hφs := hN s hs
    have e2 : φ s * (φ s₀ * (φ p₁ * r)) = φ s * 1 := by
      linear_combination e1
    have e3 := mul_left_cancel₀ hφs e2
    exact hs₀u (IsUnit.of_mul_eq_one _ e3)

  have s4 : ∀ (K : Type u) [Field K] (A A' : ValuationSubring K) (hAA : A ≤ A'),
      ∃ Ab : ValuationSubring (IsLocalRing.ResidueField ↥A'), ∀ x : K, x ∈ A ↔
        ∃ h : x ∈ A', algebraMap ↥A' (IsLocalRing.ResidueField ↥A') ⟨x, h⟩ ∈ Ab := by
    intro K _ A A' hAA
    set f : ↥A →+* IsLocalRing.ResidueField ↥A' :=
      (algebraMap ↥A' (IsLocalRing.ResidueField ↥A')).comp
        (ValuationSubring.inclusion A A' hAA) with hf
    have hm : ∀ m : ↥A', m ∈ IsLocalRing.maximalIdeal ↥A' → (m : K) ∈ A := by
      intro m hm
      by_contra hmA
      have hm0 : (m : K) ≠ 0 := fun h => hmA (h ▸ A.zero_mem)
      have hinv : (m : K)⁻¹ ∈ A := (A.mem_or_inv_mem m).resolve_left hmA
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hm
      apply hm
      refine IsUnit.of_mul_eq_one (⟨(m : K)⁻¹, hAA hinv⟩ : ↥A') ?_
      apply Subtype.ext
      show (m : K) * (m : K)⁻¹ = 1
      exact mul_inv_cancel₀ hm0
    let Ab : ValuationSubring (IsLocalRing.ResidueField ↥A') :=
      { toSubring := f.range
        mem_or_inv_mem' := by
          intro y
          by_cases hy : y = 0
          · left; rw [hy]; exact f.range.zero_mem
          obtain ⟨x', rfl⟩ := IsLocalRing.residue_surjective y
          have hx' : IsUnit x' := by
            by_contra hn
            apply hy
            rw [IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
            exact hn
          have hx0 : (x' : K) ≠ 0 := by
            intro h
            have : x' = 0 := Subtype.ext h
            rw [this] at hx'
            exact not_isUnit_zero hx'
          rcases A.mem_or_inv_mem x' with h | h
          · left
            refine ⟨⟨x', h⟩, ?_⟩
            rw [hf, RingHom.comp_apply, IsLocalRing.ResidueField.algebraMap_eq]
            rfl
          · right
            refine ⟨⟨(x' : K)⁻¹, h⟩, ?_⟩
            rw [hf, RingHom.comp_apply, IsLocalRing.ResidueField.algebraMap_eq]
            apply eq_inv_of_mul_eq_one_left
            rw [← map_mul]
            have : ValuationSubring.inclusion A A' hAA ⟨(x' : K)⁻¹, h⟩ * x' = 1 := by
              apply Subtype.ext
              show (x' : K)⁻¹ * (x' : K) = 1
              exact inv_mul_cancel₀ hx0
            rw [this, map_one] }
    refine ⟨Ab, fun x => ⟨fun hx => ⟨hAA hx, ⟨⟨x, hx⟩, rfl⟩⟩, ?_⟩⟩
    rintro ⟨h, ⟨a, ha⟩⟩
    have hd : (⟨x, h⟩ : ↥A') - ValuationSubring.inclusion A A' hAA a ∈
        IsLocalRing.maximalIdeal ↥A' := by
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, ← IsLocalRing.ResidueField.algebraMap_eq]
      have ha' : f a = algebraMap ↥A' (IsLocalRing.ResidueField ↥A') ⟨x, h⟩ := ha
      rw [hf, RingHom.comp_apply] at ha'
      rw [ha', sub_self]
    have h2 := hm _ hd
    have e : x = (a : K) +
        (((⟨x, h⟩ : ↥A') - ValuationSubring.inclusion A A' hAA a : ↥A') : K) := by
      show x = (a : K) + (x - (a : K))
      ring
    rw [e]
    exact A.add_mem _ _ a.2 h2

  have s6 : ∀ (R K : Type u) [CommRing R] [IsDomain R] [ValuationRing R] [Field K] [Algebra R K]
      [IsFractionRing R K] (φ : ↥W →+* R) (i₁ : Spec (.of K) ⟶ Z),
      i₁ ≫ uu = Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ Spec.map (CommRingCat.ofHom φ) →
      ∀ (A A' : ValuationSubring K) (hAA : A ≤ A')
        (Ab : ValuationSubring (IsLocalRing.ResidueField ↥A')) (πA : ↥A →+* ↥Ab),
      IsPullback (CommRingCat.ofHom (ValuationSubring.inclusion A A' hAA)) (CommRingCat.ofHom πA)
        (CommRingCat.ofHom (algebraMap ↥A' (IsLocalRing.ResidueField ↥A')))
        (CommRingCat.ofHom (algebraMap ↥Ab (IsLocalRing.ResidueField ↥A'))) →
      ∀ (eA : R ≃+* ↥A) (φ' : ↥W' →+* ↥A'),
      (∀ r : R, ((eA r : ↥A) : K) = algebraMap R K r) →
      (∀ w : ↥W, ((φ' (ValuationSubring.inclusion W W' hle w) : ↥A') : K) =
        algebraMap R K (φ w)) →
      (∀ w : ↥W, πb w = 0 →
        φ' (ValuationSubring.inclusion W W' hle w) ∈ IsLocalRing.maximalIdeal ↥A') →
      ∃ l : Spec (.of R) ⟶ Z, Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ l = i₁ ∧
        l ≫ uu = Spec.map (CommRingCat.ofHom φ) := by
    intro R K _ _ _ _ _ _ φ i₁ hw A A' hAA Ab πA hpbA eA φ' heA hφ' hmax
    have hsqA : ∀ a : ↥A, algebraMap ↥A' (IsLocalRing.ResidueField ↥A')
        (ValuationSubring.inclusion A A' hAA a) =
          algebraMap ↥Ab (IsLocalRing.ResidueField ↥A') (πA a) :=
      fun a => congrArg (fun f => f.hom a) hpbA.w
    have halgB : ∀ x : ↥Ab, algebraMap ↥Ab (IsLocalRing.ResidueField ↥A') x =
        (x : IsLocalRing.ResidueField ↥A') := fun x => rfl
    have hkey : ∀ w : ↥W, φ' (ValuationSubring.inclusion W W' hle w) =
        ValuationSubring.inclusion A A' hAA (eA (φ w)) :=
      fun w => Subtype.ext ((hφ' w).trans (heA (φ w)).symm)

    have e1 : (algebraMap ↥A' K).comp (φ'.comp (ValuationSubring.inclusion W W' hle)) =
        (algebraMap R K).comp φ := RingHom.ext fun w => hφ' w
    have h1 : i₁ ≫ uu = Spec.map (CommRingCat.ofHom (algebraMap ↥A' K)) ≫
        Spec.map (CommRingCat.ofHom φ') ≫
          Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)) := by
      rw [hw, hS, hS, hS, e1]

    obtain ⟨a1, ha1, ha1'⟩ :=
      s1 uu u' i' _ hpi' hp' ↥A' K i₁ (Spec.map (CommRingCat.ofHom φ')) h1

    let χ₀ : ↥W →+* IsLocalRing.ResidueField ↥A' :=
      (algebraMap ↥A' (IsLocalRing.ResidueField ↥A')).comp
        (φ'.comp (ValuationSubring.inclusion W W' hle))
    have hker : RingHom.ker πb ≤ RingHom.ker χ₀ := by
      intro w hw0
      rw [RingHom.mem_ker] at hw0 ⊢
      show algebraMap ↥A' (IsLocalRing.ResidueField ↥A')
        (φ' (ValuationSubring.inclusion W W' hle w)) = 0
      rw [IsLocalRing.ResidueField.algebraMap_eq, IsLocalRing.residue_eq_zero_iff]
      exact hmax w hw0
    let χ := RingHom.liftOfSurjective πb hsurj ⟨χ₀, hker⟩
    have hχ : ∀ w, χ (πb w) = χ₀ w := fun w => by
      have := RingHom.liftOfSurjective_comp πb hsurj ⟨χ₀, hker⟩
      exact RingHom.congr_fun this w
    have hχmem : ∀ y, χ y ∈ Ab := by
      intro y
      obtain ⟨w, rfl⟩ := hsurj y
      rw [hχ]
      show algebraMap ↥A' (IsLocalRing.ResidueField ↥A')
        (φ' (ValuationSubring.inclusion W W' hle w)) ∈ Ab
      rw [hkey, hsqA, halgB]
      exact (πA _).2
    let φb : ↥Wb →+* ↥Ab := χ.codRestrict Ab hχmem
    have hφb : ∀ w, algebraMap ↥Ab (IsLocalRing.ResidueField ↥A') (φb (πb w)) = χ₀ w :=
      fun w => (halgB _).trans (hχ w)

    have e4 : (algebraMap ↥Ab (IsLocalRing.ResidueField ↥A')).comp (φb.comp πb) = χ₀ :=
      RingHom.ext hφb
    have h4 : (Spec.map (CommRingCat.ofHom (algebraMap ↥A' (IsLocalRing.ResidueField ↥A'))) ≫
        a1 ≫ i') ≫ uu =
        Spec.map (CommRingCat.ofHom (algebraMap ↥Ab (IsLocalRing.ResidueField ↥A'))) ≫
          Spec.map (CommRingCat.ofHom φb) ≫ Spec.map (CommRingCat.ofHom πb) := by
      rw [Category.assoc, Category.assoc, hpi'.w, ← Category.assoc a1, ha1', hS, hS, hS, hS, e4]
    obtain ⟨a2, ha2, ha2'⟩ := s1 uu ub ib _ hpib hpb ↥Ab (IsLocalRing.ResidueField ↥A') _
      (Spec.map (CommRingCat.ofHom φb)) h4

    obtain ⟨t, ht1, ht2⟩ := hlift (.of ↥A) (.of ↥A') (.of ↥Ab)
      (.of (IsLocalRing.ResidueField ↥A'))
      (CommRingCat.ofHom (ValuationSubring.inclusion A A' hAA)) (CommRingCat.ofHom πA)
      (CommRingCat.ofHom (algebraMap ↥A' (IsLocalRing.ResidueField ↥A')))
      (CommRingCat.ofHom (algebraMap ↥Ab (IsLocalRing.ResidueField ↥A'))) hpbA
      (IsLocalRing.residue_surjective (R := ↥A')) (inferInstanceAs (IsLocalRing ↥A'))
      (inferInstanceAs (IsLocalRing ↥Ab))
      (inferInstanceAs (Nontrivial (IsLocalRing.ResidueField ↥A'))) a1 a2 ha2.symm

    refine ⟨Spec.map (CommRingCat.ofHom eA.symm.toRingHom) ≫ t, ?_, ?_⟩
    · have e6 : (algebraMap R K).comp eA.symm.toRingHom =
          (algebraMap ↥A' K).comp (ValuationSubring.inclusion A A' hAA) := RingHom.ext fun a => by
        show algebraMap R K (eA.symm a) = ((ValuationSubring.inclusion A A' hAA a : ↥A') : K)
        rw [← heA, RingEquiv.apply_symm_apply]
        rfl
      rw [← Category.assoc, hS, e6, ← hS, Category.assoc, ht1, ha1]
    · let φA : ↥W →+* ↥A := eA.toRingHom.comp φ
      have hcomp1 : CommRingCat.ofHom φA ≫ CommRingCat.ofHom (ValuationSubring.inclusion A A' hAA) =
          CommRingCat.ofHom (ValuationSubring.inclusion W W' hle) ≫ CommRingCat.ofHom φ' := by
        ext w
        exact congrArg (fun z : ↥A' => (z : K)) (hkey w).symm
      have hcomp2 : CommRingCat.ofHom φA ≫ CommRingCat.ofHom πA =
          CommRingCat.ofHom πb ≫ CommRingCat.ofHom φb := by
        have hh : ∀ w, ((πA (eA (φ w)) : ↥Ab) : IsLocalRing.ResidueField ↥A') =
            ((φb (πb w) : ↥Ab) : IsLocalRing.ResidueField ↥A') := by
          intro w
          rw [← halgB, ← halgB, hφb, ← hsqA, ← hkey]
          rfl
        ext w
        exact hh w
      obtain ⟨ψ, hψ⟩ : ∃ ψ, Spec.map ψ = t ≫ uu := ⟨_, Spec.map_preimage _⟩
      have ht : t ≫ uu = Spec.map (CommRingCat.ofHom φA) := by
        rw [← hψ]
        congr 1
        apply hpbA.hom_ext
        · rw [hcomp1]
          apply Spec.map_injective
          rw [Spec.map_comp, Spec.map_comp, hψ, ← Category.assoc, ht1, Category.assoc, hpi'.w,
            ← Category.assoc, ha1']
        · rw [hcomp2]
          apply Spec.map_injective
          rw [Spec.map_comp, Spec.map_comp, hψ, ← Category.assoc, ht2, Category.assoc, hpib.w,
            ← Category.assoc, ha2']
      have e7 : eA.symm.toRingHom.comp φA = φ :=
        RingHom.ext fun w => eA.symm_apply_apply (φ w)
      rw [Category.assoc, ht, hS, e7]

  have s5 : ∀ (K : Type u) [Field K] (A A' : ValuationSubring K)
      (Ab : ValuationSubring (IsLocalRing.ResidueField ↥A')) (hAA : A ≤ A'),
      (∀ x : K, x ∈ A ↔ ∃ h : x ∈ A',
        algebraMap ↥A' (IsLocalRing.ResidueField ↥A') ⟨x, h⟩ ∈ Ab) →
      ∃ πA : ↥A →+* ↥Ab,
        IsPullback (CommRingCat.ofHom (ValuationSubring.inclusion A A' hAA)) (CommRingCat.ofHom πA)
          (CommRingCat.ofHom (algebraMap ↥A' (IsLocalRing.ResidueField ↥A')))
          (CommRingCat.ofHom (algebraMap ↥Ab (IsLocalRing.ResidueField ↥A'))) := by
    intro K _ A A' Ab hAA hiff
    set ι := ValuationSubring.inclusion A A' hAA with hι
    set res := algebraMap ↥A' (IsLocalRing.ResidueField ↥A') with hres
    set eb := algebraMap ↥Ab (IsLocalRing.ResidueField ↥A') with heb
    have hebv : ∀ y : Ab, eb y = (y : IsLocalRing.ResidueField ↥A') := fun y => by
      rw [heb, ValuationSubring.algebraMap_apply]
    have hmem : ∀ w : A, res (ι w) ∈ Ab := by
      intro w
      obtain ⟨h, hr⟩ := (hiff w).mp w.2
      exact hr
    let πA : A →+* Ab := RingHom.codRestrict (res.comp ι) Ab hmem
    have hπv : ∀ w, ((πA w : Ab) : IsLocalRing.ResidueField ↥A') = res (ι w) := fun w => rfl
    have hG2 : ∀ w, eb (πA w) = res (ι w) := fun w => by rw [hebv, hπv]
    have hwq : CommRingCat.ofHom ι ≫ CommRingCat.ofHom res =
        CommRingCat.ofHom πA ≫ CommRingCat.ofHom eb := by
      ext w
      exact (hG2 w).symm
    have hcond : ∀ (s : Limits.PullbackCone (CommRingCat.ofHom res) (CommRingCat.ofHom eb))
        (x : s.pt), res (s.fst.hom x) = eb (s.snd.hom x) := fun s x =>
      congrArg (fun f => f.hom x) s.condition
    have hlf : ∀ (s : Limits.PullbackCone (CommRingCat.ofHom res) (CommRingCat.ofHom eb))
        (x : s.pt), ((s.fst.hom x : A') : K) ∈ A := by
      intro s x
      refine (hiff _).mpr ⟨(s.fst.hom x).2, ?_⟩
      show res (s.fst.hom x) ∈ Ab
      rw [hcond, hebv]
      exact (s.snd.hom x).2
    refine ⟨πA, ?_⟩
    refine IsPullback.of_isLimit' ⟨hwq⟩ ?_
    refine Limits.PullbackCone.IsLimit.mk hwq
      (fun s => CommRingCat.ofHom (RingHom.codRestrict (A'.subtype.comp s.fst.hom) A (hlf s)))
      ?_ ?_ ?_
    · intro s
      ext x
      rfl
    · intro s
      ext x
      show res (s.fst.hom x) = ((s.snd.hom x : Ab) : IsLocalRing.ResidueField ↥A')
      rw [← hebv]
      exact hcond s x
    · intro s m h1 _
      ext x
      exact congrArg (fun f => ((f.hom x : A') : K)) h1

  have hE : ValuativeCriterion.Existence uu := by
    intro S
    obtain ⟨R, K, i₁, i₂, hsq⟩ := S
    obtain ⟨φ, rfl⟩ : ∃ φ : ↥W →+* R, Spec.map (CommRingCat.ofHom φ) = i₂ :=
      ⟨(Spec.preimage i₂).hom, by rw [CommRingCat.ofHom_hom, Spec.map_preimage]⟩
    have hw := hsq.w
    suffices hex : ∃ l : Spec (.of R) ⟶ Z,
        Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫ l = i₁ ∧
        l ≫ uu = Spec.map (CommRingCat.ofHom φ) by
      obtain ⟨l, hl1, hl2⟩ := hex
      exact ⟨⟨⟨l, hl1, hl2⟩⟩⟩
    rcases s3 R K φ with ⟨φb, hφb⟩ | ⟨φ', hφ'⟩ | ⟨A, A', hAA, eA, φ', heA, hφ', hmax⟩
    · have h : i₁ ≫ uu = Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫
          Spec.map (CommRingCat.ofHom φb) ≫ Spec.map (CommRingCat.ofHom πb) := by
        rw [hw, ← hφb, ← hS]
      obtain ⟨l, hl1, hl2⟩ := s1 uu ub ib _ hpib hpb R K i₁ _ h
      refine ⟨l ≫ ib, hl1, ?_⟩
      rw [Category.assoc, hpib.w, ← Category.assoc, hl2, hS, hφb]
    · have h : i₁ ≫ uu = Spec.map (CommRingCat.ofHom (algebraMap R K)) ≫
          Spec.map (CommRingCat.ofHom φ') ≫
            Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)) := by
        rw [hw, ← hφ', ← hS]
      obtain ⟨l, hl1, hl2⟩ := s1 uu u' i' _ hpi' hp' R K i₁ _ h
      refine ⟨l ≫ i', hl1, ?_⟩
      rw [Category.assoc, hpi'.w, ← Category.assoc, hl2, hS, hφ']
    · obtain ⟨Ab, hiffA⟩ := s4 K A A' hAA
      obtain ⟨πA, hpbA⟩ := s5 K A A' Ab hAA hiffA
      exact s6 R K φ i₁ hw A A' hAA Ab πA hpbA eA φ' heA hφ' hmax
  haveI : UniversallyClosed uu := UniversallyClosed.of_valuativeCriterion uu hE
  exact IsProper.mk

theorem wcpa_dj_lmga_semistable_of_cover : ∀ {Z S : Scheme.{u}} (uu : Z ⟶ S), Flat uu → IsProper uu →
    (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ S),
      ∃ (Z₁ S₁ : Scheme.{u}) (u₁ : Z₁ ⟶ S₁) (i : Z₁ ⟶ Z) (j : S₁ ⟶ S)
        (s₁ : Spec (.of K) ⟶ S₁),
        IsPullback i u₁ uu j ∧ wcpaDjSemistable u₁ ∧ s₁ ≫ j = s) →
    wcpaDjSemistable uu :=
by

  have hcomap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B) (n : ℕ), IsLocalRing.maximalIdeal A ^ n ≤
        Ideal.comap (σ : A →+* B) (IsLocalRing.maximalIdeal B ^ n) := by
    intro A B _ _ _ _ σ n
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
    apply Ideal.pow_right_mono
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
    intro h
    exact hx ((MulEquiv.isUnit_map (σ : A ≃* B)).mp h)

  have hfac : ∀ (A : Type u) [CommRing A] (I : Ideal A) (m n : ℕ) (h : m ≤ n)
      (x : AdicCompletion I A),
      Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) = AdicCompletion.evalₐ I m x := by
    intro A _ I m n h x
    obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I A x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, Ideal.Quotient.factorPow,
      Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
    have := (Submodule.Quotient.eq _).mp (AdicCompletion.AdicCauchySequence.mk_eq_mk h c)
    simpa [smul_eq_mul, Ideal.mul_top] using this

  have hmap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ (n : ℕ) x (a : A),
        AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
        AdicCompletion.evalₐ _ n (Φ x) = Ideal.Quotient.mk _ (σ a) := by
    intro A B _ _ _ _ σ
    let f : ∀ n : ℕ, AdicCompletion (IsLocalRing.maximalIdeal A) A →+*
        B ⧸ IsLocalRing.maximalIdeal B ^ n := fun n =>
      (Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)).comp
        (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal A) n).toRingHom
    have hf : ∀ (n : ℕ) x (a : A), AdicCompletion.evalₐ _ n x = Ideal.Quotient.mk _ a →
        f n x = Ideal.Quotient.mk _ (σ a) := by
      intro n x a ha
      show Ideal.quotientMap (IsLocalRing.maximalIdeal B ^ n) (σ : A →+* B) (hcomap A B σ n)
        (AdicCompletion.evalₐ _ n x) = _
      rw [ha, Ideal.quotientMap_mk]
      rfl
    have hcompat : ∀ {m n : ℕ} (hle : m ≤ n),
        (Ideal.Quotient.factorPow (IsLocalRing.maximalIdeal B) hle).comp (f n) = f m := by
      intro m n hle
      ext x
      obtain ⟨a, ha⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n x)
      have ha' : AdicCompletion.evalₐ _ m x = Ideal.Quotient.mk _ a := by
        rw [← hfac A _ m n hle x, ← ha, Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk]
      rw [RingHom.comp_apply, hf n x a ha.symm, hf m x a ha', Ideal.Quotient.factorPow,
        Ideal.Quotient.factor_mk]
    refine ⟨AdicCompletion.liftRingHom _ f hcompat, ?_⟩
    intro n x a ha
    rw [AdicCompletion.evalₐ_liftRingHom]
    exact hf n x a ha

  have s1 : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B), ∃ Φ : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+*
        AdicCompletion (IsLocalRing.maximalIdeal B) B, ∀ a : A,
        Φ (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) a) =
          algebraMap B (AdicCompletion (IsLocalRing.maximalIdeal B) B) (σ a) := by
    intro A B _ _ _ _ σ
    obtain ⟨Φ, hΦ⟩ := hmap A B σ
    obtain ⟨Ψ, hΨ⟩ := hmap B A σ.symm
    have h1 : Φ.comp Ψ = RingHom.id _ := by
      ext1 y
      apply AdicCompletion.ext_evalₐ
      intro n
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
      rw [RingHom.comp_apply, hΦ n _ _ (hΨ n y b hb.symm), RingEquiv.apply_symm_apply,
        RingHom.id_apply, hb]
    have h2 : Ψ.comp Φ = RingHom.id _ := by
      ext1 y
      apply AdicCompletion.ext_evalₐ
      intro n
      obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ _ n y)
      rw [RingHom.comp_apply, hΨ n _ _ (hΦ n y b hb.symm), RingEquiv.symm_apply_apply,
        RingHom.id_apply, hb]
    refine ⟨RingEquiv.ofRingHom Φ Ψ h1 h2, ?_⟩
    intro a
    apply AdicCompletion.ext_evalₐ
    intro n
    have hof : ∀ (R : Type u) [CommRing R] (I : Ideal R) (r : R),
        AdicCompletion.evalₐ I n (algebraMap R (AdicCompletion I R) r) =
          Ideal.Quotient.mk _ r := by
      intro R _ I r
      rw [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of, Algebra.algebraMap_self,
        RingHom.id_apply]
    show AdicCompletion.evalₐ _ n (Φ _) = _
    rw [hΦ n _ a (hof A _ a), hof B _ (σ a)]

  have s2 : ∀ (K : Type u) [Field K] {X Y : Scheme.{u}} (i : X ⟶ Y) (p : X ⟶ Spec (.of K))
      (q : Y ⟶ Spec (.of K)), i ≫ q = p → ∀ x : X,
      ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ Y.presheaf.germ ⊤ (i x) trivial) ≫
        i.stalkMap x =
      (Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial := by
    intro K _ X Y i p q hi x
    have key : Y.presheaf.germ ⊤ (i x) trivial ≫ i.stalkMap x =
        i.appTop ≫ X.presheaf.germ ⊤ x trivial := Scheme.Hom.germ_stalkMap i ⊤ x trivial
    rw [← hi, Scheme.Hom.comp_appTop]
    simp only [Category.assoc]
    exact congrArg (fun t => (Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫ t) key

  have s3 : ∀ {X Y S : Scheme.{u}} (i : X ⟶ Y) [IsIso i] (p : X ⟶ S) (q : Y ⟶ S), i ≫ q = p →
      ∀ (W' : Y.Opens), SmoothOfRelativeDimension 1 (W'.ι ≫ q) →
        SmoothOfRelativeDimension 1 ((i ⁻¹ᵁ W').ι ≫ p) := by
    intro X Y S i _ p q hi W' hW'
    have hfac' : (i ⁻¹ᵁ W').ι ≫ p = (i ∣_ W') ≫ (W'.ι ≫ q) := by
      rw [← hi, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    have hpb : IsPullback (i ∣_ W') ((i ∣_ W') ≫ (W'.ι ≫ q)) (W'.ι ≫ q) (𝟙 S) :=
      IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]⟩
    rw [hfac']
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hW'

  intro Z S uu hflat hprop H
  refine ⟨hflat, hprop, ?_⟩
  intro K _ _ s w
  obtain ⟨Z₁, S₁, u₁, i, j, s₁, hsq, hss₁, hs⟩ := H K s
  have hP0 : IsPullback (Limits.pullback.fst u₁ s₁ ≫ i) (Limits.pullback.snd u₁ s₁) uu (s₁ ≫ j) :=
    (IsPullback.of_hasPullback u₁ s₁).paste_horiz hsq
  rw [hs] at hP0
  obtain ⟨φ, hφiso, hi⟩ : ∃ φ : Limits.pullback uu s ⟶ Limits.pullback u₁ s₁, IsIso φ ∧
      φ ≫ Limits.pullback.snd u₁ s₁ = Limits.pullback.snd uu s :=
    ⟨hP0.isoPullback.inv, inferInstance, hP0.isoPullback_inv_snd⟩
  haveI := hφiso
  rcases hss₁.2.2 K s₁ (φ w) with ⟨W', hw', hsm⟩ | ⟨e₀, he₀⟩
  · left
    refine ⟨φ ⁻¹ᵁ W', hw', ?_⟩
    exact s3 φ _ _ hi W' hsm
  · right
    let τ := Iso.commRingCatIsoToRingEquiv (asIso (φ.stalkMap w))
    obtain ⟨Φ, hΦ⟩ := s1 _ _ τ.symm
    refine ⟨Φ.trans e₀, ?_⟩
    have h2 := s2 K φ _ _ hi w
    ext1 k
    have hk : τ.symm (((Scheme.ΓSpecIso (.of K)).inv ≫
        (Limits.pullback.snd uu s).appTop ≫
        (Limits.pullback uu s).presheaf.germ ⊤ w trivial).hom k) =
        ((Scheme.ΓSpecIso (.of K)).inv ≫ (Limits.pullback.snd u₁ s₁).appTop ≫
        (Limits.pullback u₁ s₁).presheaf.germ ⊤ (φ w) trivial).hom k := by
      rw [← h2, RingEquiv.symm_apply_eq]
      rfl
    have := RingHom.congr_fun he₀ k
    simp only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom] at this ⊢
    rw [RingEquiv.trans_apply, hΦ, hk]
    exact this

theorem wcpa_dj_lmga_smooth_nbhd_transfer : ∀ {Z Z₁ S S₁ : Scheme.{u}} (uu : Z ⟶ S) (u₁ : Z₁ ⟶ S₁)
    (i : Z₁ ⟶ Z) (j : S₁ ⟶ S), IsPullback i u₁ uu j → IsPreimmersion j → Flat uu →
    LocallyOfFinitePresentation uu → ∀ z₁ : ↥Z₁,
    (∃ O₁ : Z₁.Opens, z₁ ∈ O₁ ∧ SmoothOfRelativeDimension 1 (O₁.ι ≫ u₁)) →
    ∃ O : Z.Opens, i z₁ ∈ O ∧ SmoothOfRelativeDimension 1 (O.ι ≫ uu) :=
by
  intro Z Z₁ S S₁ uu u₁ i j hpb hj hflat hlfp z₁ hO
  obtain ⟨O₁, hz₁O₁, hO₁sm⟩ := hO
  have s1 : uu (i z₁) = j (u₁ z₁) := by
    rw [← Scheme.Hom.comp_apply, hpb.w, Scheme.Hom.comp_apply]
  have H : ∀ t : S, j (u₁ z₁) = t → ∃ w : ↥(Limits.pullback uu (S.fromSpecResidueField t)),
      Limits.pullback.fst uu (S.fromSpecResidueField t) w = i z₁ ∧
      ∃ W : (Limits.pullback uu (S.fromSpecResidueField t)).Opens, w ∈ W ∧
        SmoothOfRelativeDimension 1 (W.ι ≫ Limits.pullback.snd uu (S.fromSpecResidueField t)) := by
    intro t ht
    subst ht
    have := hj
    have h2 : ∀ x, (j.residueFieldMap (u₁ z₁)).hom ((S.residue (j (u₁ z₁))).hom x) =
        (S₁.residue (u₁ z₁)).hom ((j.stalkMap (u₁ z₁)).hom x) := by
      intro x
      have := Scheme.residue_residueFieldMap j (u₁ z₁)
      exact congrArg (fun f => f.hom x) this
    have hsurj : Function.Surjective (j.residueFieldMap (u₁ z₁)).hom := by
      intro y
      obtain ⟨x, hx⟩ := Scheme.residue_surjective S₁ (u₁ z₁) y
      obtain ⟨x', hx'⟩ := j.stalkMap_surjective (u₁ z₁) x
      exact ⟨(S.residue (j (u₁ z₁))).hom x', by rw [h2, hx', hx]⟩
    have hbij : Function.Bijective (j.residueFieldMap (u₁ z₁)).hom :=
      ⟨(j.residueFieldMap (u₁ z₁)).hom.injective, hsurj⟩
    have : IsIso (Spec.map (j.residueFieldMap (u₁ z₁))) := isIso_SpecMap_iff.mpr hbij
    let b := inv (Spec.map (j.residueFieldMap (u₁ z₁))) ≫ S₁.fromSpecResidueField (u₁ z₁)
    have hb : b ≫ j = S.fromSpecResidueField (j (u₁ z₁)) := by
      simp only [b, Category.assoc, ← Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField,
        IsIso.inv_hom_id_assoc]
    have w₀ : Limits.pullback.fst uu (S.fromSpecResidueField (j (u₁ z₁))) ≫ uu =
        (Limits.pullback.snd uu (S.fromSpecResidueField (j (u₁ z₁))) ≫ b) ≫ j := by
      rw [Category.assoc, hb, Limits.pullback.condition]
    let g₁ := hpb.lift _ _ w₀
    have hg₁i : g₁ ≫ i = Limits.pullback.fst uu (S.fromSpecResidueField (j (u₁ z₁))) :=
      hpb.lift_fst _ _ _
    have hg₁u : g₁ ≫ u₁ = Limits.pullback.snd uu (S.fromSpecResidueField (j (u₁ z₁))) ≫ b :=
      hpb.lift_snd _ _ _
    have hG : IsPullback g₁ (Limits.pullback.snd uu (S.fromSpecResidueField (j (u₁ z₁)))) u₁ b := by
      refine IsPullback.of_right ?_ hg₁u hpb
      rw [hg₁i, hb]
      exact IsPullback.of_hasPullback _ _
    have hP := (isPullback_morphismRestrict g₁ O₁).paste_vert hG
    have hWsm : SmoothOfRelativeDimension 1
        ((g₁ ⁻¹ᵁ O₁).ι ≫ Limits.pullback.snd uu (S.fromSpecResidueField (j (u₁ z₁)))) :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hP hO₁sm
    obtain ⟨p⟩ : Nonempty ↥(Spec (S.residueField (j (u₁ z₁)))) := inferInstance
    have hbp : u₁ z₁ = b p := by
      simp only [b, Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]
    obtain ⟨w0, hw0, -⟩ := Scheme.Pullback.exists_preimage_pullback z₁ p hbp
    have hgw : g₁ (hG.isoPullback.inv w0) = z₁ := by
      rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_fst, hw0]
    refine ⟨hG.isoPullback.inv w0, ?_, g₁ ⁻¹ᵁ O₁, ?_, hWsm⟩
    · rw [← hg₁i, Scheme.Hom.comp_apply, hgw]
    · show g₁ (hG.isoPullback.inv w0) ∈ O₁
      rw [hgw]
      exact hz₁O₁
  obtain ⟨w, hw, hW⟩ := H (uu (i z₁)) s1.symm
  exact wcpa_dj_mn_fibre_smooth S Z uu (i z₁) w hflat hlfp hw hW

theorem wcpa_dj_lus_milnor_glue_ac : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W W' : ValuationSubring Ω)
    (Wb : ValuationSubring (IsLocalRing.ResidueField ↥W')), W ≤ W' →
    (∀ x : Ω, x ∈ W ↔ ∃ h : x ∈ W',
      algebraMap ↥W' (IsLocalRing.ResidueField ↥W') ⟨x, h⟩ ∈ Wb) →
    IsAlgClosed (IsLocalRing.ResidueField ↥W') →
    ringKrullDim ↥Wb ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (C : Scheme.{u}) (c : C ⟶ Spec (.of Ω)) (n : ℕ) (x : Fin n → (Spec (.of Ω) ⟶ C))
      (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of ↥W')) (τ' : Fin n → (Spec (.of ↥W') ⟶ Z'))
      (ψ' : C ⟶ Z'), wcpaDjStablePtd u' n τ' →
      (∃ (N : ℕ) (j : Z' ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W')
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion j ∧
        j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W')
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap ↥W' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W' 0))) = u') →
      IsPullback ψ' c u' (Spec.map (CommRingCat.ofHom (algebraMap ↥W' Ω))) →
      (∀ i, x i ≫ ψ' = Spec.map (CommRingCat.ofHom (algebraMap ↥W' Ω)) ≫ τ' i) →
    ∀ (τ'' : Fin n → (Spec (.of (IsLocalRing.ResidueField ↥W')) ⟶ Limits.pullback u'
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))))),
      (∀ i, τ'' i ≫ Limits.pullback.snd u'
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) = 𝟙 _) →
      (∀ i, τ'' i ≫ Limits.pullback.fst u'
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) =
        Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))) ≫ τ' i) →
    ∀ (Zb : Scheme.{u}) (ub : Zb ⟶ Spec (.of ↥Wb)) (τb : Fin n → (Spec (.of ↥Wb) ⟶ Zb))
      (ψb : Limits.pullback u'
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⟶ Zb),
      wcpaDjStablePtd ub n τb →
      (∃ (N : ℕ) (j : Zb ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥Wb)
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion j ∧
        j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥Wb)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap ↥Wb ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥Wb 0))) = ub) →
      IsPullback ψb (Limits.pullback.snd u'
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))))) ub
        (Spec.map (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W')))) →
      (∀ i, τ'' i ≫ ψb =
        Spec.map (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W'))) ≫ τb i) →
    ∃ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (τ : Fin n → (Spec (.of ↥W) ⟶ Z)) (ψ : C ⟶ Z),
      wcpaDjSemistable uu ∧ wcpaDjSections uu n τ ∧
      IsPullback ψ c uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ∧
      ∀ i, x i ≫ ψ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τ i :=
by
  intro Ω _ _ W W' Wb hle hiff hκ hWb C c n x Z' u' τ' ψ' hst' hproj' hpb' hcomp' τ'' hτ''s
    hτ''f Zb ub τb ψb hstb hprojb hpbb hcompb

  obtain ⟨πb, hπsurj, hπb, hpbR, hpre, hpts⟩ := wcpa_dj_lmga_milnor_rings Ω W W' Wb hle hiff

  have hhen : HenselianLocalRing ↥W' := wcpa_dj_lmga_valuation_henselian Ω W'

  obtain ⟨m, U', Ub, hU'aff, hUbaff, htr, hU'cov, hUbcov⟩ :=
    wcpa_dj_lmga_matched_cover Ω W' Wb hhen hκ hWb Z' u' Zb ub ψb hst'.1 hstb.1 hprojb hpbb

  obtain ⟨Z, uu, i', ib, hpi', hpib, hY, hflat, hlft, hqc, hsep, hinj', hinjb, hcov, hlift⟩ :=
    wcpa_dj_lmga_ferrand_glue Ω W W' Wb hle πb hπsurj hπb hpbR hpre Z' u' Zb ub ψb hst'.1 hstb.1
      hpbb m U' Ub hU'aff hUbaff htr hU'cov hUbcov
  have hlfp : LocallyOfFinitePresentation uu := wcpa_dj_mn_flat_fp _ Z uu hflat hlft

  have hprop : IsProper uu :=
    wcpa_dj_lmga_proper Ω W W' Wb hle πb hπsurj hpbR Z Z' Zb uu u' ub i' ib hpi' hpib
      hst'.1.2.1 hstb.1.2.1 hlft hqc hsep hlift

  have hss : wcpaDjSemistable uu := by
    apply wcpa_dj_lmga_semistable_of_cover uu hflat hprop
    intro K _ _ s
    rcases wcpa_dj_lmga_geom_point_factor _ _ _ _ _ _ _ _ hpbR
        (IsLocalRing.residue_surjective (R := ↥W')) K s with ⟨s', hs'⟩ | ⟨sb, hsb⟩
    · exact ⟨Z', _, u', i', _, s', hpi', hst'.1, hs'.symm⟩
    · exact ⟨Zb, _, ub, ib, _, sb, hpib, hstb.1, hsb.symm⟩

  have hcompat : ∀ i,
      Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))) ≫ τ' i ≫ i' =
      Spec.map (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W'))) ≫ τb i ≫ ib := by
    intro i
    rw [← Category.assoc, ← hτ''f i, Category.assoc, hY, ← Category.assoc, hcompb i,
      Category.assoc]
  choose τ hτ1 hτ2 using fun i => hlift (.of ↥W) (.of ↥W') (.of ↥Wb)
    (.of (IsLocalRing.ResidueField ↥W')) _ _ _ _ hpbR (IsLocalRing.residue_surjective (R := ↥W'))
    (inferInstanceAs (IsLocalRing ↥W')) (inferInstanceAs (IsLocalRing ↥Wb))
    (inferInstanceAs (Nontrivial (IsLocalRing.ResidueField ↥W'))) (τ' i) (τb i) (hcompat i)
  have hsec1 : ∀ i, τ i ≫ uu = 𝟙 _ := by
    intro i
    have hpre1 : Spec.preimage (τ i ≫ uu) = 𝟙 _ := by
      apply hpbR.hom_ext
      · rw [Category.id_comp]
        apply Spec.map_injective
        rw [Spec.map_comp, Spec.map_preimage, ← Category.assoc, hτ1 i, Category.assoc, hpi'.w,
          ← Category.assoc, hst'.2.1.1 i, Category.id_comp]
      · rw [Category.id_comp]
        apply Spec.map_injective
        rw [Spec.map_comp, Spec.map_preimage, ← Category.assoc, hτ2 i, Category.assoc, hpib.w,
          ← Category.assoc, hstb.2.1.1 i, Category.id_comp]
    have h := congrArg Spec.map hpre1
    rwa [Spec.map_preimage, Spec.map_id] at h
  have hback : ∀ i (p : ↥(Spec (.of ↥W))), uu (τ i p) = p := by
    intro i p
    rw [← Scheme.Hom.comp_apply, hsec1 i]
    rfl
  have hτ1p : ∀ i p', τ i (Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)) p') =
      i' (τ' i p') := by
    intro i p'
    rw [← Scheme.Hom.comp_apply, hτ1 i, Scheme.Hom.comp_apply]
  have hτ2p : ∀ i pb, τ i (Spec.map (CommRingCat.ofHom πb) pb) = ib (τb i pb) := by
    intro i pb
    rw [← Scheme.Hom.comp_apply, hτ2 i, Scheme.Hom.comp_apply]
  haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom πb)) :=
    IsClosedImmersion.spec_of_surjective _ hπsurj
  have hpreb : IsPreimmersion (Spec.map (CommRingCat.ofHom πb)) := inferInstance
  have hsec : wcpaDjSections uu n τ := by
    refine ⟨hsec1, ?_, ?_⟩
    · intro i k p q hik heq
      have hpq : p = q := by rw [← hback i p, heq, hback k q]
      subst hpq
      rcases hpts p with ⟨p', rfl⟩ | ⟨pb, rfl⟩
      · rw [hτ1p, hτ1p] at heq
        exact hst'.2.1.2.1 i k p' p' hik (hinj' heq)
      · rw [hτ2p, hτ2p] at heq
        exact hstb.2.1.2.1 i k pb pb hik (hinjb heq)
    · intro i p
      rcases hpts p with ⟨p', rfl⟩ | ⟨pb, rfl⟩
      · rw [hτ1p]
        exact wcpa_dj_lmga_smooth_nbhd_transfer uu u' i' _ hpi' hpre hflat hlfp (τ' i p')
          (hst'.2.1.2.2 i p')
      · rw [hτ2p]
        exact wcpa_dj_lmga_smooth_nbhd_transfer uu ub ib _ hpib hpreb hflat hlfp (τb i pb)
          (hstb.2.1.2.2 i pb)

  have he : Spec.map (CommRingCat.ofHom (algebraMap ↥W' Ω)) ≫
      Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)) =
      Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) := by
    rw [← Spec.map_comp]; rfl
  refine ⟨Z, uu, τ, ψ' ≫ i', hss, hsec, ?_, ?_⟩
  · have h := hpb'.paste_horiz hpi'
    rwa [he] at h
  · intro i
    rw [← Category.assoc, hcomp' i, Category.assoc, ← hτ1 i, ← Category.assoc, he]

theorem wcpa_dj_lus_algclosed_stable_reduction : ∀ (k : Type u) [Field k] [Finite k]
    (X P : Scheme.{u}) [AlgebraicGeometry.IsIntegral X] [AlgebraicGeometry.IsIntegral P]
    (sP : P ⟶ Spec (.of k)) (f : X ⟶ P) (U : P.Opens) (n : ℕ) (σ : Fin n → (P ⟶ X)),
    wcpaDjSmIn k sP f U σ →
    ∀ W : ValuationSubring (AlgebraicClosure P.functionField),
      wcpaDjLocStable f σ (AlgebraicClosure P.functionField) W :=
by
  have G : ∀ r : ℕ, ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω),
      ringKrullDim ↥W ≤ ((r + 1 : ℕ) : WithBot ℕ∞) →
      ∀ (C : Scheme.{u}) (c : C ⟶ Spec (.of Ω)) (n : ℕ) (x : Fin n → (Spec (.of Ω) ⟶ C)),
      wcpaDjIsProjOver Ω c → wcpaDjStablePtd c n x →
      ∃ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (τ : Fin n → (Spec (.of ↥W) ⟶ Z))
        (ψ : C ⟶ Z),
        wcpaDjStablePtd uu n τ ∧
        (∃ (N : ℕ) (j : Z ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W)
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion j ∧
          j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W)
            MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
              (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = uu) ∧
        IsPullback ψ c uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ∧
        ∀ i, x i ≫ ψ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τ i := by
    intro r
    induction r with
    | zero =>
      intro Ω _ _ W hW C c n x hc hx
      obtain ⟨Z₀, u₀, τ₀, ψ₀, hss, hsec, hpb, hcomp⟩ :=
        wcpa_dj_lus_rank_one_semistable Ω W hW C c n x hc hx
      exact wcpa_dj_lus_stabilize_model_ac Ω W C c n x hc hx Z₀ u₀ τ₀ ψ₀ hss hsec hpb hcomp
    | succ r ih =>
      intro Ω _ _ W hW C c n x hc hx
      obtain ⟨W', Wb, hle, hW', hWb, hκ, hiff⟩ := wcpa_dj_lus_coarsening Ω W (r + 1) hW
      obtain ⟨Z', u', τ', ψ', hst', hproj', hpb', hcomp'⟩ := ih Ω W' hW' C c n x hc hx
      obtain ⟨τ'', hst'', hτ''s, hτ''f⟩ := wcpa_dj_lcp_stableptd_basechange u' n τ'
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) hst'
      have hprojb : wcpaDjIsProjOver (IsLocalRing.ResidueField ↥W') (Limits.pullback.snd u'
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))))) :=
        wcpa_dj_lus_proj_ring_basechange ↥W' (IsLocalRing.ResidueField ↥W')
          (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')) Z' u' hproj'
      haveI := hκ
      obtain ⟨Z₀, u₀, τ₀, ψ₀, hss, hsec, hpb, hcomp⟩ :=
        wcpa_dj_lus_rank_one_semistable (IsLocalRing.ResidueField ↥W') Wb hWb _ _ n τ''
          hprojb hst''
      obtain ⟨Zb, ub, τb, ψb, hstb, hprojb', hpbb, hcompb⟩ :=
        wcpa_dj_lus_stabilize_model_ac (IsLocalRing.ResidueField ↥W') Wb _ _ n τ'' hprojb hst''
          Z₀ u₀ τ₀ ψ₀ hss hsec hpb hcomp
      obtain ⟨Z₁, u₁, τ₁, ψ₁, hss1, hsec1, hpb1, hcomp1⟩ :=
        wcpa_dj_lus_milnor_glue_ac Ω W W' Wb hle hiff hκ hWb C c n x Z' u' τ' ψ' hst' hproj'
          hpb' hcomp' τ'' hτ''s hτ''f Zb ub τb ψb hstb hprojb' hpbb hcompb
      exact wcpa_dj_lus_stabilize_model_ac Ω W C c n x hc hx Z₁ u₁ τ₁ ψ₁ hss1 hsec1 hpb1 hcomp1
  intro k _ _ X P _ _ sP f U n σ hin W
  obtain ⟨r, hr⟩ := wcpa_dj_lus_valuation_finite_rank k P sP hin.2.1 W
  have hr' : ringKrullDim ↥W ≤ ((r + 1 : ℕ) : WithBot ℕ∞) :=
    hr.trans (by exact_mod_cast Nat.le_succ r)
  obtain ⟨hcproj, x, hxs, hxf, hxst⟩ := wcpa_dj_lus_generic_fibre_stable k X P sP f U n σ hin
  obtain ⟨Z, uu, τ, ψ, hst, hproj, hpb, hcomp⟩ :=
    G r (AlgebraicClosure P.functionField) W hr' _ _ n x hcproj hxst
  exact ⟨Z, uu, τ, _, Limits.pullback.fst _ _, ψ, Limits.pullback.snd _ _, x, hst, hproj,
    IsPullback.of_hasPullback _ _, hpb, hxs, hxf, hcomp⟩

theorem wcpa_dj_lsl_section_descend : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (S₀ : Finset A) (Y₀ : Scheme.{u}) (h₀ : Y₀ ⟶ Spec (.of ↥(Subring.closure (S₀ : Set A)))) [LocallyOfFiniteType h₀] (n : ℕ) (t : Fin n → (Spec (.of A) ⟶ Y₀)), (∀ i, t i ≫ h₀ = Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype)) → ∃ (S : Finset A) (hS : Subring.closure (S₀ : Set A) ≤ Subring.closure (S : Set A)) (t₀ : Fin n → (Spec (.of ↥(Subring.closure (S : Set A))) ⟶ Y₀)), (∀ i, t₀ i ≫ h₀ = Spec.map (CommRingCat.ofHom (Subring.inclusion hS))) ∧ (∀ i, Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype) ≫ t₀ i = t i) :=
by
  intro A _ _ S₀ Y₀ h₀ _ n t ht
  classical

  have s1 : ∀ i, ∃ (R : CommRingCat.{u}) (f : Spec R ⟶ Y₀) (φ : R ⟶ CommRingCat.of A),
      IsOpenImmersion f ∧ Spec.map φ ≫ f = t i := by
    intro i
    obtain ⟨R, f, hf, hy, -⟩ := Y₀.exists_affine_mem_range_and_range_subset
      (x := t i (IsLocalRing.closedPoint A)) (U := ⊤) trivial
    haveI := hf
    have hsub : Set.range (t i) ⊆ Set.range f := by
      rintro _ ⟨x, rfl⟩
      have hsp : t i x ⤳ t i (IsLocalRing.closedPoint A) :=
        (IsLocalRing.specializes_closedPoint x).map (t i).continuous
      exact hsp.mem_open f.isOpenEmbedding.isOpen_range hy
    refine ⟨R, f, Spec.preimage (IsOpenImmersion.lift f (t i) hsub), hf, ?_⟩
    rw [Spec.map_preimage, IsOpenImmersion.lift_fac]
  choose R f φ hf hφ using s1

  let ψ : ∀ i, CommRingCat.of ↥(Subring.closure (S₀ : Set A)) ⟶ R i :=
    fun i => Spec.preimage (f i ≫ h₀)
  have hψ : ∀ i, Spec.map (ψ i) = f i ≫ h₀ := fun i => Spec.map_preimage _
  have hψft : ∀ i, (ψ i).hom.FiniteType := by
    intro i
    haveI := hf i
    have h1 : LocallyOfFiniteType (Spec.map (ψ i)) := by
      rw [hψ i]; infer_instance
    exact (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mp h1
  have hcomp' : ∀ i, ψ i ≫ φ i = CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype := by
    intro i
    apply Spec.map_injective
    rw [Spec.map_comp, hψ i, ← Category.assoc, hφ i, ht i]
  have hcomp : ∀ i (r : ↥(Subring.closure (S₀ : Set A))), (φ i).hom ((ψ i).hom r) = (r : A) := by
    intro i r
    have := congrArg (fun g => g.hom r) (hcomp' i)
    simpa using this

  have s3 : ∀ i, ∃ G : Finset A, ∀ (S' : Subring A), Subring.closure (S₀ : Set A) ≤ S' →
      (G : Set A) ⊆ S' → ∀ b, (φ i).hom b ∈ S' := by
    intro i
    letI := (ψ i).hom.toAlgebra
    have hft : Algebra.FiniteType ↥(Subring.closure (S₀ : Set A)) (R i) := hψft i
    obtain ⟨T, hT⟩ := hft.out
    refine ⟨T.image (φ i).hom, fun S' hS' hG b => ?_⟩
    have hb : b ∈ Algebra.adjoin ↥(Subring.closure (S₀ : Set A)) (T : Set (R i)) := by
      rw [hT]; trivial
    induction hb using Algebra.adjoin_induction with
    | mem x hx => exact hG (Finset.mem_coe.2 (Finset.mem_image_of_mem _ (Finset.mem_coe.1 hx)))
    | algebraMap r =>
        rw [RingHom.algebraMap_toAlgebra, hcomp i r]; exact hS' r.2
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy
  choose G hG using s3

  let S : Finset A := S₀ ∪ Finset.univ.biUnion G
  have hS : Subring.closure (S₀ : Set A) ≤ Subring.closure (S : Set A) :=
    Subring.closure_mono (Finset.coe_subset.mpr Finset.subset_union_left)
  have hGS : ∀ i, (G i : Set A) ⊆ Subring.closure (S : Set A) := by
    intro i x hx
    apply Subring.subset_closure
    exact Finset.mem_coe.2 (Finset.mem_union_right _
      (Finset.mem_biUnion.2 ⟨i, Finset.mem_univ i, Finset.mem_coe.1 hx⟩))
  have hφS : ∀ i b, (φ i).hom b ∈ Subring.closure (S : Set A) :=
    fun i => hG i _ hS (hGS i)
  let φ' : ∀ i, R i ⟶ CommRingCat.of ↥(Subring.closure (S : Set A)) :=
    fun i => CommRingCat.ofHom ((φ i).hom.codRestrict (Subring.closure (S : Set A)) (hφS i))
  refine ⟨S, hS, fun i => Spec.map (φ' i) ≫ f i, ?_, ?_⟩
  · intro i
    rw [Category.assoc, ← hψ i, ← Spec.map_comp]
    congr 1
    ext r
    simpa [φ'] using hcomp i r
  · intro i
    rw [← Category.assoc, ← Spec.map_comp, ← hφ i]
    congr 2

theorem wcpa_dj_lsl_descend_flat_model : ∀ (L : Type u) [Field L] (V : ValuationSubring L) (Zv : Scheme.{u}) (uv : Zv ⟶ Spec (.of V)) (n : ℕ) (τv : Fin n → (Spec (.of V) ⟶ Zv)), Flat uv → (∃ (N : ℕ) (j : Zv ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥V) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥V) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥V ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥V 0))) = uv) → (∀ i, τv i ≫ uv = 𝟙 _) → ∃ (F : Finset V) (Z₀ : Scheme.{u}) (u₀ : Z₀ ⟶ Spec (.of ↥(Subring.closure (F : Set V)))) (τ₀ : Fin n → (Spec (.of ↥(Subring.closure (F : Set V))) ⟶ Z₀)) (φ : Zv ⟶ Z₀), Flat u₀ ∧ IsProper u₀ ∧ LocallyOfFinitePresentation u₀ ∧ (∀ i, τ₀ i ≫ u₀ = 𝟙 _) ∧ IsPullback φ uv u₀ (Spec.map (CommRingCat.ofHom (Subring.closure (F : Set V)).subtype)) ∧ (∀ i, τv i ≫ φ = Spec.map (CommRingCat.ofHom (Subring.closure (F : Set V)).subtype) ≫ τ₀ i) :=
by
  intro L _ V Zv uv n τv hflat hproj hτ
  classical

  have hpp : ∀ (R : Type u) [CommRing R] (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of R)),
      (∃ (N : ℕ) (j : Z ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
        MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra ≫
        Spec.map (CommRingCat.ofHom (algebraMap R
