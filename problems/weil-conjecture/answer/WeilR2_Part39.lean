      exact V.isOpen.isClosed_compl
    haveI : IsClosedImmersion U.ι :=
      IsClosedImmersion.of_isPreimmersion U.ι (by rw [Scheme.Opens.range_ι]; exact hcl)
    haveI := hj
    refine ⟨N, U.ι ≫ j, inferInstance, ?_⟩
    rw [Category.assoc, hjeq]

  have wcpa_dj_lr1s_spec_points : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥W)),
      (∃ s' : Spec (.of K) ⟶ Spec (.of Ω), s = s' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ∨
      (∃ s'' : Spec (.of K) ⟶ Spec (.of (IsLocalRing.ResidueField ↥W)),
        s = s'' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) := by
    intro K _ s
    set χ : ↥W →+* K := (Spec.preimage s).hom with hχ
    have hs : s = Spec.map (CommRingCat.ofHom χ) := by
      rw [hχ, CommRingCat.ofHom_hom, Spec.map_preimage]
    by_cases hinj : Function.Injective χ
    · left
      refine ⟨Spec.map (CommRingCat.ofHom (IsFractionRing.lift hinj : Ω →+* K)), ?_⟩
      rw [hs, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2
      ext x
      exact (IsFractionRing.lift_algebraMap hinj x).symm
    · right
      haveI : Ring.KrullDimLE 1 ↥W := Ring.krullDimLE_iff.mpr hW
      have hker : RingHom.ker χ ≠ ⊥ := by
        intro h
        exact hinj ((RingHom.injective_iff_ker_eq_bot χ).mpr h)
      have hprime : (RingHom.ker χ).IsPrime := RingHom.ker_isPrime χ
      have hmax : (RingHom.ker χ).IsMaximal := by
        rcases Ring.krullDimLE_one_iff.mp inferInstance _ hprime with h | h
        · exact absurd (le_bot_iff.mp (h.2 ⟨inferInstance, le_refl _⟩ bot_le)) hker
        · exact h
      have hkm : RingHom.ker χ = IsLocalRing.maximalIdeal ↥W := IsLocalRing.eq_maximalIdeal hmax
      haveI : IsLocalHom χ := by
        constructor
        intro x hx
        by_contra hxu
        have hxm : x ∈ IsLocalRing.maximalIdeal ↥W := hxu
        rw [← hkm, RingHom.mem_ker] at hxm
        rw [hxm] at hx
        exact not_isUnit_zero hx
      refine ⟨Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.lift χ)), ?_⟩
      rw [hs, ← Spec.map_comp, ← CommRingCat.ofHom_comp]
      congr 2

  have wcpa_dj_lr1s_generic_geometric_fibre : ∀ (Y Ct : Scheme.{u}) (g : Y ⟶ Spec (.of ↥W))
      (ct : Ct ⟶ Spec (.of Ω)) (ψ : Ct ⟶ Y),
      IsPullback ψ ct g (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) →
      SmoothOfRelativeDimension 1 ct → ∀ (K : Type u) [Field K] (s' : Spec (.of K) ⟶ Spec (.of Ω))
      (w : ↥(Limits.pullback g (s' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))))),
      ∃ U : (Limits.pullback g (s' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))).Opens,
        w ∈ U ∧ SmoothOfRelativeDimension 1
          (U.ι ≫ Limits.pullback.snd g (s' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) := by
    intro Y Ct g ct ψ hψ hsm K _ s' w
    let h₁₁ := hψ.lift (Limits.pullback.fst g (s' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))))
      (Limits.pullback.snd g (s' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ≫ s')
      (by rw [Category.assoc]; exact Limits.pullback.condition)
    have e1 : h₁₁ ≫ ψ = Limits.pullback.fst g (s' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) :=
      hψ.lift_fst _ _ _
    have e2 : h₁₁ ≫ ct =
        Limits.pullback.snd g (s' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ≫ s' :=
      hψ.lift_snd _ _ _
    have hbig : IsPullback (h₁₁ ≫ ψ)
        (Limits.pullback.snd g (s' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) g
        (s' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) := by
      rw [e1]; exact IsPullback.of_hasPullback _ _
    have hsq : IsPullback h₁₁
        (Limits.pullback.snd g (s' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) ct s' :=
      IsPullback.of_right hbig e2 hψ
    haveI : SmoothOfRelativeDimension 1
        (Limits.pullback.snd g (s' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) :=
      MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hsq hsm
    exact ⟨⊤, trivial, (inferInstance : SmoothOfRelativeDimension (0 + 1) (_ ≫ _))⟩
  by_cases hWt : W = ⊤
  · exact wcpa_dj_lr1s_trivial_valuation Ω W hWt Ct ct hproj hsm
  have key : ∀ (n : ℕ) (Ct : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)),
      (irreducibleComponents Ct).ncard = n → wcpaDjIsProjOver Ω ct →
      SmoothOfRelativeDimension 1 ct →
      ∃ (Z₀ : Scheme.{u}) (u₀ : Z₀ ⟶ Spec (.of ↥W)) (ψ₀ : Ct ⟶ Z₀), wcpaDjSemistable u₀ ∧
        (∃ (N : ℕ) (j : Z₀ ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W)
            MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧
          j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W)
            MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
              (algebraMap ↥W ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥W 0))) = u₀) ∧
        IsPullback ψ₀ ct u₀ (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro Ct ct hn hproj hsm
      by_cases he : IsEmpty Ct
      · exact wcpa_dj_lr1s_empty_model Ω W Ct ct he
      by_cases hirr : IrreducibleSpace Ct
      · obtain ⟨φ, hφf, hφ, hgen⟩ := wcpa_dj_lr1s_finite_projection Ω Ct ct hproj hsm hirr
        obtain ⟨m, b, h3, hbs, hbd, hkey⟩ :=
          wcpa_dj_lr1s_key_nodal_special_fibre Ω W hW hWt Ct ct φ hproj hsm hirr hφf hφ hgen
        obtain ⟨X, uX, ι, β, hst, hXp, hpb, hβ⟩ :=
          wcpa_dj_lr1s_tree_model Ω W hW hWt m b h3 hbs hbd
        haveI := hφf
        haveI : QuasiCompact ι :=
          MorphismProperty.of_isPullback (P := @QuasiCompact) hpb.flip inferInstance
        haveI : QuasiSeparated ι :=
          MorphismProperty.of_isPullback (P := @QuasiSeparated) hpb.flip inferInstance
        have hfin := wcpa_dj_lr1s_normalization_finite Ω W hW hWt Ct ct φ hproj hsm hirr hφf hφ
          hgen X uX ι hst.1 hXp hpb
        have hgf := wcpa_dj_lr1s_normalization_generic_fibre Ω W Ct ct φ X uX ι hφf hφ hpb
        have hfl := wcpa_dj_lr1s_normalization_flat Ω W Ct ct φ X uX ι hφf hφ hpb
        have hsp := hkey X uX ι β hst hXp hpb hβ hfin hfl hgf
        haveI := hfin
        haveI : IsProper uX := hst.1.2.1
        refine ⟨(φ ≫ ι).normalization, (φ ≫ ι).fromNormalization ≫ uX, (φ ≫ ι).toNormalization,
          ⟨hfl, inferInstance, ?_⟩,
          wcpa_dj_lr1s_finite_proj_ring ↥W (φ ≫ ι).fromNormalization uX hfin hXp, hgf⟩
        intro K _ _ s w
        rcases wcpa_dj_lr1s_spec_points K s with ⟨s', rfl⟩ | ⟨s'', rfl⟩
        · exact Or.inl (wcpa_dj_lr1s_generic_geometric_fibre _ Ct _ ct _ hgf hsm K s' w)
        · exact wcpa_dj_lr1s_special_geometric_fibre Ω W _ _ inferInstance hsp K s'' w
      · haveI : IsProper ct := wcpa_dj_proj_proper Ω ct hproj
        haveI := hsm
        obtain ⟨U, V, hUV, hcov, -, hUsm, -, hVsm, hUn, hVn⟩ :=
          wc_proper_smooth_clopen_split Ω Ct ct 1 (not_isEmpty_iff.mp he) hirr
        have mU := ih _ (hn ▸ hUn) U.toScheme (U.ι ≫ ct) rfl
          (wcpa_dj_lr1s_clopen_proj Ct ct U V hUV hcov hproj) hUsm
        have mV := ih _ (hn ▸ hVn) V.toScheme (V.ι ≫ ct) rfl
          (wcpa_dj_lr1s_clopen_proj Ct ct V U hUV.symm (by rw [sup_comm]; exact hcov) hproj) hVsm
        exact wcpa_dj_lr1s_disjoint_union_model Ω W Ct ct U V hUV hcov mU mV
  exact key _ Ct ct rfl hproj hsm

theorem wcpa_dj_lus_rank_one_semistable : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω), ringKrullDim ↥W ≤ ((1 : ℕ) : WithBot ℕ∞) →
    ∀ (C : Scheme.{u}) (c : C ⟶ Spec (.of Ω)) (n : ℕ) (x : Fin n → (Spec (.of Ω) ⟶ C)),
    wcpaDjIsProjOver Ω c → wcpaDjStablePtd c n x →
    ∃ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (τ : Fin n → (Spec (.of ↥W) ⟶ Z)) (ψ : C ⟶ Z),
      wcpaDjSemistable uu ∧ wcpaDjSections uu n τ ∧
      IsPullback ψ c uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ∧
      ∀ i, x i ≫ ψ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τ i :=
by
  intro Ω _ _ W hW C c n x hc hx
  obtain ⟨Ct, ct, ν, m, r, hprojt, hsmt, hνc, hrs, hrd, hrx, hpo⟩ :=
    wcpa_dj_lr1_normalize_nodal Ω C c n x hc hx.1 hx.2.1
  obtain ⟨Z₀, u₀, ψ₀, hss₀, hproj₀, hpb₀⟩ :=
    wcpa_dj_lr1_smooth_semistable_model Ω W hW Ct ct hprojt hsmt
  obtain ⟨Zt, ut, τt, ψt, hsst, hprojt', hτs, hτd, hτsm, hpbt, hct⟩ :=
    wcpa_dj_lr1_mark_separation Ω W hW Ct ct ((Fin m × Fin 2) ⊕ Fin n) r hsmt hrs hrd
      Z₀ u₀ ψ₀ hss₀ hproj₀ hpb₀
  exact wcpa_dj_lr1_clutch_model Ω W C Ct c ct ν m n x r hνc hrs hrx hpo Zt ut τt ψt hsst
    hprojt' hτs hτd hτsm hpbt hct

theorem wcpa_dj_lmga_milnor_rings : ∀ (Ω : Type u) [Field Ω] (W W' : ValuationSubring Ω)
    (Wb : ValuationSubring (IsLocalRing.ResidueField ↥W')) (hle : W ≤ W'),
    (∀ x : Ω, x ∈ W ↔ ∃ h : x ∈ W',
      algebraMap ↥W' (IsLocalRing.ResidueField ↥W') ⟨x, h⟩ ∈ Wb) →
    ∃ (πb : ↥W →+* ↥Wb), Function.Surjective πb ∧
      (∀ w : ↥W, algebraMap ↥Wb (IsLocalRing.ResidueField ↥W') (πb w) =
        algebraMap ↥W' (IsLocalRing.ResidueField ↥W') (ValuationSubring.inclusion W W' hle w)) ∧
      IsPullback (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle)) (CommRingCat.ofHom πb)
        (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))
        (CommRingCat.ofHom (algebraMap ↥Wb (IsLocalRing.ResidueField ↥W'))) ∧
      IsPreimmersion (Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle))) ∧
      ∀ p : ↥(Spec (.of ↥W)),
        p ∈ Set.range ⇑(Spec.map (CommRingCat.ofHom (ValuationSubring.inclusion W W' hle))) ∨
        p ∈ Set.range ⇑(Spec.map (CommRingCat.ofHom πb)) :=
by
  intro Ω _ W W' Wb hle hiff
  set ι := ValuationSubring.inclusion W W' hle with hι
  set res := algebraMap ↥W' (IsLocalRing.ResidueField ↥W') with hres
  set eb := algebraMap ↥Wb (IsLocalRing.ResidueField ↥W') with heb
  have hebv : ∀ y : Wb, eb y = (y : IsLocalRing.ResidueField ↥W') := fun y => by
    rw [heb, ValuationSubring.algebraMap_apply]
  have hιinj : Function.Injective ι := fun a b h =>
    Subtype.ext (congrArg (fun z : W' => (z : Ω)) h)
  have hmem : ∀ w : W, res (ι w) ∈ Wb := by
    intro w
    obtain ⟨h, hr⟩ := (hiff w).mp w.2
    exact hr
  let πb : W →+* Wb := RingHom.codRestrict (res.comp ι) Wb hmem
  have hπv : ∀ w, ((πb w : Wb) : IsLocalRing.ResidueField ↥W') = res (ι w) := fun w => rfl
  have hG2 : ∀ w, eb (πb w) = res (ι w) := fun w => by rw [hebv, hπv]

  have hG1 : Function.Surjective πb := by
    intro b
    obtain ⟨a, ha⟩ := IsLocalRing.residue_surjective (b : IsLocalRing.ResidueField ↥W')
    have hra : res a = b := by rw [hres, IsLocalRing.ResidueField.algebraMap_eq, ha]
    have haW : (a : Ω) ∈ W := (hiff a).mpr ⟨a.2, by
      show res a ∈ Wb
      rw [hra]; exact b.2⟩
    refine ⟨⟨a, haW⟩, Subtype.ext ?_⟩
    rw [hπv]
    exact hra

  letI : Algebra W W' := ι.toAlgebra
  have hP : ∀ w : W, w ∈ W.idealOfLE W' hle ↔ ι w ∈ IsLocalRing.maximalIdeal W' :=
    fun w => Iff.rfl
  have hloc : IsLocalization (W.idealOfLE W' hle).primeCompl W' := by
    refine ⟨?_, ?_, ?_⟩
    · rintro ⟨y, hy⟩
      have h1 : ι y ∉ IsLocalRing.maximalIdeal W' := fun h => hy ((hP y).mpr h)
      exact IsLocalRing.notMem_maximalIdeal.mp h1
    · intro z
      by_cases hz : (z : Ω) ∈ W
      · refine ⟨(⟨z, hz⟩, 1), Subtype.ext ?_⟩
        show (z : Ω) * 1 = z
        exact mul_one _
      · have hz0 : (z : Ω) ≠ 0 := fun h => hz (h ▸ W.zero_mem)
        have hzi : (z : Ω)⁻¹ ∈ W := (W.mem_or_inv_mem z).resolve_left hz
        set t : W := ⟨(z : Ω)⁻¹, hzi⟩ with ht
        have hunit : IsUnit (ι t) :=
          IsUnit.of_mul_eq_one z (Subtype.ext (by
            show (z : Ω)⁻¹ * z = 1
            exact inv_mul_cancel₀ hz0))
        have htP : t ∉ W.idealOfLE W' hle := fun h =>
          (IsLocalRing.mem_maximalIdeal _).mp ((hP t).mp h) hunit
        refine ⟨(1, ⟨t, htP⟩), Subtype.ext ?_⟩
        show (z : Ω) * (z : Ω)⁻¹ = 1
        exact mul_inv_cancel₀ hz0
    · intro x y h
      refine ⟨1, ?_⟩
      rw [hιinj h]
  have hG4 : IsPreimmersion (Spec.map (CommRingCat.ofHom ι)) :=
    IsPreimmersion.of_isLocalization (W.idealOfLE W' hle).primeCompl

  have hker : ∀ w : W, πb w = 0 ↔ w ∈ W.idealOfLE W' hle := by
    intro w
    rw [hP]
    constructor
    · intro h
      have h2 : res (ι w) = 0 := by rw [← hπv, h]; rfl
      rw [hres, IsLocalRing.ResidueField.algebraMap_eq, IsLocalRing.residue_eq_zero_iff] at h2
      exact h2
    · intro h
      apply Subtype.ext
      rw [hπv, hres, IsLocalRing.ResidueField.algebraMap_eq,
        (IsLocalRing.residue_eq_zero_iff _).mpr h]
      rfl

  have hG5 : ∀ p : ↥(Spec (.of ↥W)),
      p ∈ Set.range ⇑(Spec.map (CommRingCat.ofHom ι)) ∨
      p ∈ Set.range ⇑(Spec.map (CommRingCat.ofHom πb)) := by
    intro p
    rcases (ValuationRing.iff_ideal_total.mp inferInstance).total p.asIdeal
      (W.idealOfLE W' hle) with h | h
    · left
      have h1 : p ∈ Set.range (PrimeSpectrum.comap (algebraMap W W')) := by
        rw [PrimeSpectrum.localization_comap_range W' (W.idealOfLE W' hle).primeCompl]
        show Disjoint _ _
        rw [Set.disjoint_left]
        intro x hx hxp
        exact hx (h hxp)
      obtain ⟨q, hq⟩ := h1
      exact ⟨q, hq⟩
    · right
      have h0 : ∀ q : PrimeSpectrum W, W.idealOfLE W' hle ≤ q.asIdeal →
          q ∈ Set.range (PrimeSpectrum.comap πb) := by
        intro q hq
        rw [range_comap_of_surjective _ _ hG1, PrimeSpectrum.mem_zeroLocus]
        intro w hw
        exact hq ((hker w).mp hw)
      have h1 : p ∈ Set.range (PrimeSpectrum.comap πb) := h0 p h
      obtain ⟨q, hq⟩ := h1
      exact ⟨q, hq⟩

  have hw : CommRingCat.ofHom ι ≫ CommRingCat.ofHom res =
      CommRingCat.ofHom πb ≫ CommRingCat.ofHom eb := by
    ext w
    exact (hG2 w).symm
  have hcond : ∀ (s : Limits.PullbackCone (CommRingCat.ofHom res) (CommRingCat.ofHom eb))
      (x : s.pt), res (s.fst.hom x) = eb (s.snd.hom x) := fun s x =>
    congrArg (fun f => f.hom x) s.condition
  have hlift : ∀ (s : Limits.PullbackCone (CommRingCat.ofHom res) (CommRingCat.ofHom eb))
      (x : s.pt), ((s.fst.hom x : W') : Ω) ∈ W := by
    intro s x
    refine (hiff _).mpr ⟨(s.fst.hom x).2, ?_⟩
    show res (s.fst.hom x) ∈ Wb
    rw [hcond, hebv]
    exact (s.snd.hom x).2
  have hG3 : IsPullback (CommRingCat.ofHom ι) (CommRingCat.ofHom πb)
      (CommRingCat.ofHom res) (CommRingCat.ofHom eb) := by
    refine IsPullback.of_isLimit' ⟨hw⟩ ?_
    refine Limits.PullbackCone.IsLimit.mk hw
      (fun s => CommRingCat.ofHom (RingHom.codRestrict (W'.subtype.comp s.fst.hom) W (hlift s)))
      ?_ ?_ ?_
    · intro s
      ext x
      rfl
    · intro s
      ext x
      show res (s.fst.hom x) = ((s.snd.hom x : Wb) : IsLocalRing.ResidueField ↥W')
      rw [← hebv]
      exact hcond s x
    · intro s m h1 _
      ext x
      exact congrArg (fun f => ((f.hom x : W') : Ω)) h1
  exact ⟨πb, hG1, hG2, hG3, hG4, hG5⟩

theorem wcpa_dj_lmga_geom_point_factor : ∀ (A A' Ab B : CommRingCat.{u}) (ι : A ⟶ A') (πb : A ⟶ Ab)
    (r : A' ⟶ B) (e : Ab ⟶ B), IsPullback ι πb r e → Function.Surjective ⇑(ConcreteCategory.hom r) →
    ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec A),
      (∃ s' : Spec (.of K) ⟶ Spec A', s = s' ≫ Spec.map ι) ∨
      (∃ sb : Spec (.of K) ⟶ Spec Ab, s = sb ≫ Spec.map πb) :=
by
  intro A A' Ab B ι πb r e hpb hr K _ s
  classical
  have hpbT := hpb.map (forget CommRingCat)
  rw [CategoryTheory.Limits.Types.isPullback_iff] at hpbT
  obtain ⟨_, hP1, hP2⟩ := hpbT
  have C : ∀ a : A, r (ι a) = e (πb a) := fun a => by
    have := ConcreteCategory.congr_hom hpb.w a
    simpa using this
  have P1 : ∀ a b : A, ι a = ι b → πb a = πb b → a = b := fun a b h1 h2 => hP1 a b ⟨h1, h2⟩
  have P2 : ∀ (a' : A') (ab : Ab), r a' = e ab → ∃ a : A, ι a = a' ∧ πb a = ab :=
    fun a' ab h => hP2 a' ab h
  set φ : A ⟶ CommRingCat.of K := Spec.preimage s with hφdef
  have hφ : Spec.map φ = s := Spec.map_preimage s
  by_cases h : ∀ a : A, πb a = 0 → φ a = 0
  · right
    have hsurj : Function.Surjective πb.hom := by
      intro ab
      obtain ⟨a', ha'⟩ := hr (e ab)
      obtain ⟨a, -, ha⟩ := P2 a' ab ha'
      exact ⟨a, ha⟩
    let ψ₀ : Ab →+* K := πb.hom.liftOfSurjective hsurj
      ⟨φ.hom, fun a ha => RingHom.mem_ker.mpr (h a (RingHom.mem_ker.mp ha))⟩
    refine ⟨Spec.map (CommRingCat.ofHom ψ₀), ?_⟩
    rw [← Spec.map_comp, ← hφ]
    congr 1
    ext a
    show φ a = ψ₀ (πb a)
    exact (RingHom.liftOfSurjective_comp_apply (f := πb.hom) hsurj
      ⟨φ.hom, fun a ha => RingHom.mem_ker.mpr (h a (RingHom.mem_ker.mp ha))⟩ a).symm
  · left
    push_neg at h
    obtain ⟨j, hj0, hφj⟩ := h
    have hx : ∀ a' : A', ∃ x : A, ι x = a' * ι j ∧ πb x = 0 := by
      intro a'
      apply P2
      rw [map_mul, C, hj0, map_zero, mul_zero]
    choose x hx1 hx2 using hx
    have uniq : ∀ (a' : A') (y : A), ι y = a' * ι j → πb y = 0 → y = x a' :=
      fun a' y h1 h2 => P1 _ _ (h1.trans (hx1 a').symm) (h2.trans (hx2 a').symm)
    have xι : ∀ a : A, x (ι a) = a * j := fun a =>
      (uniq _ _ (by rw [map_mul]) (by rw [map_mul, hj0, mul_zero])).symm
    have x1 : x 1 = j := by
      have := uniq 1 j (by rw [one_mul]) hj0
      exact this.symm
    have x0 : x 0 = 0 := (uniq _ _ (by rw [map_zero, zero_mul]) (map_zero _)).symm
    have xadd : ∀ a' b', x (a' + b') = x a' + x b' := fun a' b' =>
      (uniq _ _ (by rw [map_add, hx1, hx1, add_mul]) (by rw [map_add, hx2, hx2, add_zero])).symm
    have xmul : ∀ a' b', x (a' * b') * j = x a' * x b' := fun a' b' =>
      P1 _ _ (by rw [map_mul, map_mul, hx1, hx1, hx1]; ring)
        (by rw [map_mul, map_mul, hx2, hx2, hx2, zero_mul, zero_mul])
    let ψ₀ : A' →+* K :=
      { toFun := fun a' => φ (x a') * (φ j)⁻¹
        map_one' := by
          show φ (x 1) * (φ j)⁻¹ = 1
          rw [x1, mul_inv_cancel₀ hφj]
        map_mul' := fun a' b' => by
          show φ (x (a' * b')) * (φ j)⁻¹ = φ (x a') * (φ j)⁻¹ * (φ (x b') * (φ j)⁻¹)
          have hm := congrArg φ (xmul a' b')
          rw [map_mul, map_mul] at hm
          rw [mul_mul_mul_comm, ← hm, mul_assoc, mul_inv_cancel_left₀ hφj]
        map_zero' := by
          show φ (x 0) * (φ j)⁻¹ = 0
          rw [x0, map_zero, zero_mul]
        map_add' := fun a' b' => by
          show φ (x (a' + b')) * (φ j)⁻¹ = φ (x a') * (φ j)⁻¹ + φ (x b') * (φ j)⁻¹
          rw [xadd, map_add, add_mul] }
    refine ⟨Spec.map (CommRingCat.ofHom ψ₀), ?_⟩
    rw [← Spec.map_comp, ← hφ]
    congr 1
    ext a
    show φ a = φ (x (ι a)) * (φ j)⁻¹
    rw [xι, map_mul, mul_inv_cancel_right₀ hφj]

theorem wcpa_dj_lmga_mc_vandermonde_forms : ∀ (A : Type u) [CommRing A] [IsLocalRing A]
    [Infinite (IsLocalRing.ResidueField A)] (N : ℕ)
    (F : Finset ↥(@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A)
      MvPolynomial.gradedAlgebra)),
    (∀ x ∈ F, (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A)
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap A ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A 0)))) x =
      IsLocalRing.closedPoint A) →
    ∃ g : Fin (N + 1) → MvPolynomial (Fin (N + 1)) A,
      (∀ a, g a ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A 1) ∧
      (∀ a, ∀ x ∈ F, x ∈ @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A) MvPolynomial.gradedAlgebra (g a)) ∧
      (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A)).toIdeal ≤
        Ideal.span (Set.range g) :=
by
  intro A _ _ _ N F _hF
  classical

  have s2 : ∀ (I : Ideal (MvPolynomial (Fin (N + 1)) A)), (∀ i, MvPolynomial.X i ∈ I) →
      (HomogeneousIdeal.irrelevant
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A)).toIdeal ≤ I := by
    intro I hI a ha
    have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
    have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
      rw [← MvPolynomial.decomposition.decompose'_apply]
      exact ha'
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    have hmem : a ∈ Ideal.span (MvPolynomial.X '' Set.univ) := by
      rw [MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) h0
      obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨l, Set.mem_univ _, hl⟩
    refine (Ideal.span_le.mpr ?_) hmem
    rintro _ ⟨l, _, rfl⟩
    exact hI l

  let G : A → MvPolynomial (Fin (N + 1)) A := fun t =>
    ∑ j : Fin (N + 1), MvPolynomial.C (t ^ (j : ℕ)) * MvPolynomial.X j
  have hG1 : ∀ t, G t ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) A 1 := by
    intro t
    rw [MvPolynomial.mem_homogeneousSubmodule]
    exact MvPolynomial.IsHomogeneous.sum _ _ _
      (fun j _ => MvPolynomial.isHomogeneous_C_mul_X _ j)

  have s1 : ∀ t : Fin (N + 1) → A, Function.Injective (fun a => IsLocalRing.residue A (t a)) →
      ∀ i, MvPolynomial.X i ∈ Ideal.span (Set.range (fun a => G (t a))) := by
    intro t ht i
    set V := Matrix.vandermonde t with hV
    have hdet : IsUnit V.det := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hV, Matrix.det_vandermonde, map_prod,
        Finset.prod_ne_zero_iff]
      intro a _
      rw [map_prod, Finset.prod_ne_zero_iff]
      intro b hb
      rw [map_sub, sub_ne_zero]
      intro h
      exact (Finset.mem_Ioi.mp hb).ne' (ht h)
    have hWV : V⁻¹ * V = 1 := Matrix.nonsing_inv_mul V hdet
    have key : MvPolynomial.X i = ∑ a, MvPolynomial.C (V⁻¹ i a) * G (t a) := by
      have e1 : MvPolynomial.X i = ∑ j, MvPolynomial.C ((V⁻¹ * V) i j) *
          (MvPolynomial.X j : MvPolynomial (Fin (N + 1)) A) := by
        rw [hWV]
        simp [Matrix.one_apply]
      rw [e1]
      simp only [G, Matrix.mul_apply, map_sum, Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun j _ => ?_))
      rw [hV, Matrix.vandermonde_apply, map_mul, mul_assoc]
    rw [key]
    exact Ideal.sum_mem _ (fun a _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨a, rfl⟩))

  let L : IsLocalRing.ResidueField A → A := Function.surjInv IsLocalRing.residue_surjective
  have hL : ∀ s, IsLocalRing.residue A (L s) = s :=
    Function.surjInv_eq IsLocalRing.residue_surjective
  have enum : ∀ S : Finset (IsLocalRing.ResidueField A), S.card = N + 1 →
      ∃ e : Fin (N + 1) → IsLocalRing.ResidueField A, Function.Injective e ∧ ∀ a, e a ∈ S := by
    intro S hS
    let eq : Fin (N + 1) ≃ S := (S.equivFin.trans (finCongr hS)).symm
    exact ⟨fun a => (eq a : _), Subtype.val_injective.comp eq.injective, fun a => (eq a).2⟩
  have hinjL : ∀ e : Fin (N + 1) → IsLocalRing.ResidueField A, Function.Injective e →
      Function.Injective (fun a => IsLocalRing.residue A (L (e a))) := by
    intro e he a b h
    simp only [hL] at h
    exact he h

  have hfin : ∀ x ∈ F, {s : IsLocalRing.ResidueField A |
      G (L s) ∈ ProjectiveSpectrum.asHomogeneousIdeal x}.Finite := by
    intro x _
    by_contra hinf
    obtain ⟨S, hSsub, hScard⟩ := Set.Infinite.exists_subset_card_eq hinf (N + 1)
    obtain ⟨e, he, heS⟩ := enum S hScard
    have hX : ∀ i, MvPolynomial.X i ∈ (ProjectiveSpectrum.asHomogeneousIdeal x).toIdeal := by
      intro i
      refine (Ideal.span_le.mpr ?_) (s1 (fun a => L (e a)) (hinjL e he) i)
      rintro _ ⟨a, rfl⟩
      exact hSsub (heS a)
    exact ProjectiveSpectrum.not_irrelevant_le x (fun y hy => s2 _ hX hy)

  have hBfin : (⋃ x ∈ F, {s : IsLocalRing.ResidueField A |
      G (L s) ∈ ProjectiveSpectrum.asHomogeneousIdeal x}).Finite :=
    Set.Finite.biUnion F.finite_toSet (fun x hx => hfin x (Finset.mem_coe.mp hx))
  obtain ⟨S, hSsub, hScard⟩ := Set.Infinite.exists_subset_card_eq hBfin.infinite_compl (N + 1)
  obtain ⟨e, he, heS⟩ := enum S hScard
  refine ⟨fun a => G (L (e a)), fun a => hG1 _, ?_, ?_⟩
  · intro a x hx
    rw [Proj.mem_basicOpen]
    intro hmem
    exact hSsub (heS a) (Set.mem_iUnion₂.mpr ⟨x, hx, hmem⟩)
  · exact s2 _ (s1 _ (hinjL e he))

theorem wcpa_dj_lmga_mc_fibre_finite : ∀ (K : Type u) [Field K] [IsAlgClosed K] {Z S : Scheme.{u}}
    (g : Z ⟶ S) (s : Spec (.of K) ⟶ S), wcpaDjSemistable g →
    ∃ T : Finset ↥(Limits.pullback g s), ∀ E : Set ↥(Limits.pullback g s), IsClosed E →
      (∀ w ∈ T, w ∉ E) → E.Finite ∧ ∀ w ∈ E, IsClosed ({w} : Set ↥(Limits.pullback g s)) ∧
        ∃ O : (Limits.pullback g s).Opens, w ∈ O ∧
          SmoothOfRelativeDimension 1 (O.ι ≫ Limits.pullback.snd g s) :=
by
  intro K _ _ Z S g s hss
  classical

  have L1 : ∀ (X : Type u) [TopologicalSpace X] [TopologicalSpace.NoetherianSpace X] [QuasiSober X]
      (F : Set X), IsClosed F → (∀ x ∈ F, IsClosed ({x} : Set X)) → F.Finite := by
    intro X _ _ _ F hF hpt
    obtain ⟨S, hSfin, hScl, hSirr, rfl⟩ :=
      TopologicalSpace.NoetherianSpace.exists_finite_set_isClosed_irreducible hF
    refine hSfin.sUnion ?_
    intro t ht
    have hg := (hSirr t ht).isGenericPoint_genericPoint (hScl t ht)
    have hmem : (hSirr t ht).genericPoint ∈ ⋃₀ S := ⟨t, ht, hg.mem⟩
    have ht' : t = {(hSirr t ht).genericPoint} :=
      (show closure {(hSirr t ht).genericPoint} = t from hg).symm.trans (hpt _ hmem).closure_eq
    rw [ht']
    exact Set.finite_singleton _

  have L2 : ∀ (X : Type u) [TopologicalSpace X] [JacobsonSpace X] [T0Space X] (O : Set X),
      IsOpen O → topologicalKrullDim ↥O ≤ ((1 : ℕ) : WithBot ℕ∞) →
      ∀ η e : X, η ⤳ e → η ≠ e → e ∈ O → IsClosed ({e} : Set X) := by
    intro X _ _ _ O hO hdim η e hηe hne heO
    by_contra hcl
    obtain ⟨e', ⟨he'cl, he'O⟩, he'pt⟩ := nonempty_inter_closedPoints (Z := closure {e} ∩ O)
      ⟨e, subset_closure rfl, heO⟩ (isClosed_closure.isLocallyClosed.inter hO.isLocallyClosed)
    have hee' : e ⤳ e' := specializes_iff_mem_closure.mpr he'cl
    have he'closed : IsClosed ({e'} : Set X) := he'pt
    have hne' : e ≠ e' := by rintro rfl; exact hcl he'closed
    have hηO : η ∈ O := hηe.mem_open hO heO
    let A : O → TopologicalSpace.IrreducibleCloseds O := fun x =>
      ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
    have key : ∀ x y : O, (x : X) ⤳ y → (x : X) ≠ y → A y < A x := by
      intro x y hxy hxyne
      have hxy' : x ⤳ y := Topology.IsInducing.subtypeVal.specializes_iff.mp hxy
      refine lt_of_le_of_ne ?_ ?_
      · show closure {y} ⊆ closure {x}
        exact hxy'.closure_subset
      · intro h
        have hx : x ∈ (A x : Set O) := subset_closure rfl
        rw [← h] at hx
        have hyx : y ⤳ x := specializes_iff_mem_closure.mpr hx
        exact hxyne (congrArg Subtype.val (hxy'.antisymm hyx).eq)
    have h1 : A ⟨e', he'O⟩ < A ⟨e, heO⟩ := key ⟨e, heO⟩ ⟨e', he'O⟩ hee' hne'
    have h2 : A ⟨e, heO⟩ < A ⟨η, hηO⟩ := key ⟨η, hηO⟩ ⟨e, heO⟩ hηe hne
    let p : LTSeries (TopologicalSpace.IrreducibleCloseds O) :=
      ⟨2, ![A ⟨e', he'O⟩, A ⟨e, heO⟩, A ⟨η, hηO⟩], by
        intro i
        fin_cases i
        · exact h1
        · exact h2⟩
    have hp : ((p.length : ℕ) : WithBot ℕ∞) ≤
        Order.krullDim (TopologicalSpace.IrreducibleCloseds O) :=
      Order.LTSeries.length_le_krullDim p
    have h21 : ((2 : ℕ) : WithBot ℕ∞) ≤ ((1 : ℕ) : WithBot ℕ∞) := hp.trans hdim
    have h21' : (2 : ℕ) ≤ 1 := by exact_mod_cast h21
    omega
  obtain ⟨hflat, hprop, hfib⟩ := hss
  haveI := hprop
  haveI : IsProper (Limits.pullback.snd g s) := inferInstance
  haveI : CompactSpace ↥(Limits.pullback g s) :=
    QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd g s)
  haveI : IsLocallyNoetherian (Limits.pullback g s) :=
    LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd g s)
  haveI : IsNoetherian (Limits.pullback g s) := {}
  haveI : TopologicalSpace.NoetherianSpace ↥(Limits.pullback g s) := inferInstance
  haveI : JacobsonSpace ↥(Limits.pullback g s) :=
    LocallyOfFiniteType.jacobsonSpace (Limits.pullback.snd g s)

  have hnode : ∀ w : ↥(Limits.pullback g s), (¬ ∃ O : (Limits.pullback g s).Opens, w ∈ O ∧
      SmoothOfRelativeDimension 1 (O.ι ≫ Limits.pullback.snd g s)) →
      IsClosed ({w} : Set ↥(Limits.pullback g s)) := by
    intro w hw
    obtain ⟨e, he⟩ := (hfib K s w).resolve_left hw
    have hres := wcpa_dj_nf_node_residue K _ _ ⟨e, he⟩
    rw [← closure_subset_iff_isClosed]
    intro w₁ hw₁
    have := wcpa_dj_sfi_rational_generization K _ (Limits.pullback.snd g s) w w₁
      (specializes_iff_mem_closure.mpr hw₁) hres
    exact this.symm
  let Sm : Set ↥(Limits.pullback g s) := {w | ∃ O : (Limits.pullback g s).Opens, w ∈ O ∧
      SmoothOfRelativeDimension 1 (O.ι ≫ Limits.pullback.snd g s)}
  have hSmOpen : IsOpen Sm := by
    rw [isOpen_iff_forall_mem_open]
    rintro w ⟨O, hwO, hO⟩
    exact ⟨O, fun w' hw' => ⟨O, hw', hO⟩, O.isOpen, hwO⟩
  have hSingFin : Smᶜ.Finite := L1 _ Smᶜ hSmOpen.isClosed_compl (fun w hw => hnode w hw)
  let G : Set ↥(Limits.pullback g s) :=
    {x | closure {x} ∈ irreducibleComponents ↥(Limits.pullback g s)}
  have hG : G.Finite := by
    apply Set.Finite.of_finite_image (f := fun x => closure ({x} : Set ↥(Limits.pullback g s)))
    · exact TopologicalSpace.NoetherianSpace.finite_irreducibleComponents.subset
        (by rintro _ ⟨x, hx, rfl⟩; exact hx)
    · intro x _ y _ hxy
      exact (inseparable_iff_closure_eq.mpr hxy).eq
  refine ⟨(hG.union hSingFin).toFinset, ?_⟩
  intro E hE hET
  have hEpt : ∀ w ∈ E, IsClosed ({w} : Set ↥(Limits.pullback g s)) ∧
      ∃ O : (Limits.pullback g s).Opens, w ∈ O ∧
        SmoothOfRelativeDimension 1 (O.ι ≫ Limits.pullback.snd g s) := by
    intro e he
    have heSm : e ∈ Sm := by
      by_contra h
      exact hET e ((Set.Finite.mem_toFinset _).mpr (Or.inr h)) he
    obtain ⟨O, heO, hO⟩ := heSm
    refine ⟨?_, O, heO, hO⟩
    haveI := hO
    have hdim : topologicalKrullDim ↥(O : Set ↥(Limits.pullback g s)) ≤ ((1 : ℕ) : WithBot ℕ∞) :=
      wc_smooth_alg_closed_dim_le K O.toScheme (O.ι ≫ Limits.pullback.snd g s) 1
    have hirr := isIrreducible_irreducibleComponent (x := e)
    have hgen := hirr.isGenericPoint_genericPoint isClosed_irreducibleComponent
    have hηG' : closure {hirr.genericPoint} ∈ irreducibleComponents ↥(Limits.pullback g s) := by
      rw [hgen.def]
      exact irreducibleComponent_mem_irreducibleComponents e
    have hηG : hirr.genericPoint ∈ G := hηG'
    have hηne : hirr.genericPoint ≠ e := by
      intro h
      have hm : hirr.genericPoint ∈ E := by rw [h]; exact he
      exact hET _ ((Set.Finite.mem_toFinset _).mpr (Or.inl hηG)) hm
    have hηe : hirr.genericPoint ⤳ e := hgen.specializes mem_irreducibleComponent
    exact L2 _ (O : Set ↥(Limits.pullback g s)) O.isOpen hdim _ e hηe hηne heO
  exact ⟨L1 _ E hE (fun w hw => (hEpt w hw).1), hEpt⟩

theorem wcpa_dj_lmga_mc_section_facts : ∀ (R : Type u) [CommRing R] [IsLocalRing R]
    (Z : Scheme.{u}) (u : Z ⟶ Spec (.of R)), IsSeparated u →
    ∀ (σ σ' : Spec (.of R) ⟶ Z), σ ≫ u = 𝟙 _ → σ' ≫ u = 𝟙 _ →
      IsClosed (Set.range σ) ∧
        ∀ p, σ p = σ' p → σ (IsLocalRing.closedPoint R) = σ' (IsLocalRing.closedPoint R) :=
by
  intro R _ _ Z u hu σ σ' hσ hσ'
  haveI : IsSeparated u := hu
  have sec_pt : ∀ (τ : Spec (.of R) ⟶ Z), τ ≫ u = 𝟙 _ → ∀ x, u (τ x) = x := by
    intro τ h x
    rw [← Scheme.Hom.comp_apply, h]
    rfl
  haveI : IsClosedImmersion (σ ≫ u) := by rw [hσ]; infer_instance
  haveI : IsClosedImmersion σ := IsClosedImmersion.of_comp σ u
  have hA : IsClosed (Set.range σ) := σ.isClosedEmbedding.isClosed_range
  refine ⟨hA, fun p hp => ?_⟩
  have h1 : σ' p ⤳ σ' (IsLocalRing.closedPoint R) :=
    (IsLocalRing.specializes_closedPoint p).map σ'.continuous
  have h2 : σ' p ∈ Set.range σ := ⟨p, hp⟩
  obtain ⟨q, hq⟩ := h1.mem_closed hA h2
  have hqm : q = IsLocalRing.closedPoint R :=
    (sec_pt σ hσ q).symm.trans ((congrArg u hq).trans (sec_pt σ' hσ' _))
  subst hqm
  exact hq

theorem wcpa_dj_lmga_ca_ff_extension : ∀ (Ω : Type u) [Field Ω] (W' : ValuationSubring Ω),
    ∃ (W₂ : ValuationSubring (AlgebraicClosure Ω)) (ι : ↥W' →+* ↥W₂),
      (∀ x : ↥W', ((ι x : ↥W₂) : AlgebraicClosure Ω) = algebraMap Ω (AlgebraicClosure Ω) (x : Ω)) ∧
      IsLocalHom ι ∧ ι.FaithfullyFlat :=
by
  intro Ω _ W'
  classical
  set φ : Ω →+* AlgebraicClosure Ω := algebraMap Ω (AlgebraicClosure Ω) with hφ
  obtain ⟨W₂, hW⟩ :=
    LocalSubring.exists_le_valuationSubring (LocalSubring.map φ W'.toLocalSubring)
  obtain ⟨hsub, hloc⟩ := LocalSubring.le_def.mp hW
  have hmap : ∀ y : Ω, y ∈ W' → φ y ∈ (LocalSubring.map φ W'.toLocalSubring).toSubring := by
    intro y hy
    exact ⟨y, hy, rfl⟩
  have hmap' : ∀ z ∈ (LocalSubring.map φ W'.toLocalSubring).toSubring, ∃ y ∈ W', φ y = z := by
    intro z hz
    obtain ⟨y, hy, rfl⟩ := hz
    exact ⟨y, hy, rfl⟩
  have hcomap : W₂.comap φ = W' := by
    ext x
    rw [ValuationSubring.mem_comap]
    constructor
    · intro hx
      by_contra hxV
      have hx0 : x ≠ 0 := fun h => hxV (h ▸ W'.zero_mem)
      have hinv : x⁻¹ ∈ W' := (W'.mem_or_inv_mem x).resolve_left hxV
      let a : (LocalSubring.map φ W'.toLocalSubring).toSubring := ⟨φ x⁻¹, hmap _ hinv⟩
      have hu : IsUnit (Subring.inclusion hsub a) := by
        refine isUnit_of_dvd_one ⟨(⟨φ x, hx⟩ : W₂.toLocalSubring.toSubring), ?_⟩
        apply Subtype.ext
        show (1 : AlgebraicClosure Ω) = φ x⁻¹ * φ x
        rw [← map_mul, inv_mul_cancel₀ hx0, map_one]
      have hua : IsUnit a := hloc.map_nonunit a hu
      obtain ⟨b, hb⟩ := hua.exists_right_inv
      have hb' : (b : AlgebraicClosure Ω) = φ x := by
        have h1 : φ x⁻¹ * (b : AlgebraicClosure Ω) = 1 := congrArg Subtype.val hb
        have h2 : φ x⁻¹ * φ x = 1 := by rw [← map_mul, inv_mul_cancel₀ hx0, map_one]
        have h3 : φ x⁻¹ ≠ 0 := by
          intro h; rw [h, zero_mul] at h2; exact zero_ne_one h2
        exact mul_left_cancel₀ h3 (h1.trans h2.symm)
      obtain ⟨y, hy, hyx⟩ := hmap' b b.2
      rw [hb'] at hyx
      exact hxV (φ.injective hyx ▸ hy)
    · intro hx
      exact hsub (hmap x hx)
  have hmem : ∀ x : W', φ (x : Ω) ∈ W₂ := fun x => hsub (hmap x x.2)
  let ι : ↥W' →+* ↥W₂ :=
    { toFun := fun x => ⟨φ x, hmem x⟩
      map_one' := Subtype.ext (by simp)
      map_mul' := fun x y => Subtype.ext (by simp)
      map_zero' := Subtype.ext (by simp)
      map_add' := fun x y => Subtype.ext (by simp) }
  have hinj : Function.Injective ι := by
    intro x y h
    apply Subtype.ext
    apply φ.injective
    exact congrArg Subtype.val h
  have hlocι : IsLocalHom ι := by
    refine ⟨fun x hx => ?_⟩
    obtain ⟨v, hv⟩ := hx.exists_right_inv
    have hv' : φ (x : Ω) * (v : AlgebraicClosure Ω) = 1 := congrArg Subtype.val hv
    have hx0 : (x : Ω) ≠ 0 := by
      intro h
      rw [h, map_zero, zero_mul] at hv'
      exact zero_ne_one hv'
    have hvinv : (v : AlgebraicClosure Ω) = φ ((x : Ω)⁻¹) := by
      rw [map_inv₀]
      exact eq_inv_of_mul_eq_one_right hv'
    have hxinv' : (x : Ω)⁻¹ ∈ W₂.comap φ := by
      rw [ValuationSubring.mem_comap, ← hvinv]
      exact v.2
    have hxinv : (x : Ω)⁻¹ ∈ W' := (SetLike.ext_iff.mp hcomap _).mp hxinv'
    exact isUnit_iff_exists_inv.mpr ⟨⟨(x : Ω)⁻¹, hxinv⟩, Subtype.ext (mul_inv_cancel₀ hx0)⟩
  letI : Algebra W' W₂ := ι.toAlgebra
  have hflat : Module.Flat W' W₂ := by
    rw [Module.Flat.flat_iff_torsion_eq_bot_of_isBezout, Submodule.eq_bot_iff]
    intro m hm
    obtain ⟨a, ha⟩ := (Submodule.mem_torsion_iff m).mp hm
    have ha' : ι (a : W') * m = 0 := by
      rw [← ha]
      rfl
    have ha0 : (a : W') ≠ 0 := nonZeroDivisors.coe_ne_zero a
    have hιa : ι (a : W') ≠ 0 := fun h => ha0 (hinj (h.trans (map_zero ι).symm))
    exact (mul_eq_zero.mp ha').resolve_left hιa
  haveI : IsLocalHom (algebraMap W' W₂) := hlocι
  have hff : Module.FaithfullyFlat W' W₂ := Module.FaithfullyFlat.of_flat_of_isLocalHom
  exact ⟨W₂, ι, fun x => rfl, hlocι, hff⟩

theorem wcpa_dj_lmga_ca_affine_descent : ∀ (R R' : Type u) [CommRing R] [CommRing R']
    (φ : R →+* R'), φ.FaithfullyFlat → ∀ (X : Scheme.{u}) (f : X ⟶ Spec (.of R)),
    CompactSpace X → QuasiSeparated f →
    IsAffine (Limits.pullback f (Spec.map (CommRingCat.ofHom φ))) → IsAffine X :=
by

  have gen : ∀ {P X Y Z : Scheme.{u}} (fst : P ⟶ X) (snd : P ⟶ Y) (f : X ⟶ Z) (g : Y ⟶ Z),
      IsPullback fst snd f g → IsAffine X → IsAffine Y → IsAffine Z →
      IsPushout f.appTop g.appTop fst.appTop snd.appTop := by
    intro P X Y Z fst snd f g h hX hY hZ
    have : ∀ i, IsAffine ((Limits.cospan f g).obj i) := by
      rintro (_ | (_ | _)) <;> dsimp <;> infer_instance
    exact (h.map Scheme.Γ.rightOp).unop.flip
  have H1 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : X.Opens),
      (U.ι ≫ f).appTop ≫ U.topIso.hom = f.appLE ⊤ U le_top := by
    intro X Y f U
    simp [Scheme.Hom.appTop, Scheme.Opens.topIso_hom, Scheme.Hom.appLE]
    exact (Category.assoc _ _ _).trans (congrArg _ ((X.presheaf.map_comp _ _).symm.trans
      (congrArg _ (Subsingleton.elim _ _))))
  have H3 : ∀ {X Y : Scheme.{u}} (p : X ⟶ Y) (U : Y.Opens),
      (p ∣_ U).appTop ≫ (p ⁻¹ᵁ U).topIso.hom = U.topIso.hom ≫ p.app U := by
    intro X Y p U
    rw [Scheme.Opens.topIso_hom, Scheme.Opens.topIso_hom]
    rw [Scheme.Hom.appTop, morphismRestrict_app]
    refine (Category.assoc _ _ _).trans ?_
    refine Eq.trans ?_ (Scheme.Hom.naturality p _).symm
    exact congrArg _ ((X.presheaf.map_comp _ _).symm.trans (congrArg _ (Subsingleton.elim _ _)))

  have hmv : ∀ {R₀ R₁ As Au Av Ai Bs Bu Bv Bi : CommRingCat.{u}} (g : R₀ ⟶ R₁), g.hom.Flat →
      ∀ (as : R₀ ⟶ As) (au : R₀ ⟶ Au) (av : R₀ ⟶ Av) (ai : R₀ ⟶ Ai)
        (rsu : As ⟶ Au) (rsv : As ⟶ Av) (rui : Au ⟶ Ai) (rvi : Av ⟶ Ai),
        as ≫ rsu = au → as ≫ rsv = av → au ≫ rui = ai → av ≫ rvi = ai →
        IsPullback rsu rsv rui rvi →
      ∀ (bs : R₁ ⟶ Bs) (bu : R₁ ⟶ Bu) (bv : R₁ ⟶ Bv) (bi : R₁ ⟶ Bi)
        (rsu' : Bs ⟶ Bu) (rsv' : Bs ⟶ Bv) (rui' : Bu ⟶ Bi) (rvi' : Bv ⟶ Bi),
        bs ≫ rsu' = bu → bs ≫ rsv' = bv → bu ≫ rui' = bi → bv ≫ rvi' = bi →
        IsPullback rsu' rsv' rui' rvi' →
      ∀ (ts : As ⟶ Bs) (tu : Au ⟶ Bu) (tv : Av ⟶ Bv) (ti : Ai ⟶ Bi),
        ts ≫ rsu' = rsu ≫ tu → ts ≫ rsv' = rsv ≫ tv → tu ≫ rui' = rui ≫ ti →
        tv ≫ rvi' = rvi ≫ ti → as ≫ ts = g ≫ bs →
        IsPushout au g tu bu → IsPushout av g tv bv → IsPushout ai g ti bi →
        IsPushout as g ts bs := by
    intro R₀ R₁ As Au Av Ai Bs Bu Bv Bi g hg as au av ai rsu rsv rui rvi h1 h2 h3 h4 hA
      bs bu bv bi rsu' rsv' rui' rvi' h1' h2' h3' h4' hB ts tu tv ti k1 k2 k3 k4 ks hu hv hi
    have hA' : IsPullback (Under.homMk rsu h1 : Under.mk as ⟶ Under.mk au)
        (Under.homMk rsv h2 : Under.mk as ⟶ Under.mk av)
        (Under.homMk rui h3 : Under.mk au ⟶ Under.mk ai)
        (Under.homMk rvi h4 : Under.mk av ⟶ Under.mk ai) :=
      IsPullback.of_map (Under.forget R₀) (by ext1; exact hA.w) hA
    have := CommRingCat.Under.preservesFiniteLimits_of_flat g hg
    have hP := (hA'.map (Under.pushout g)).map (Under.forget R₁)
    let fu : Limits.pushout as g ⟶ Limits.pushout au g :=
      Limits.pushout.desc (rsu ≫ Limits.pushout.inl au g) (Limits.pushout.inr au g)
        (by rw [← Category.assoc, h1, Limits.pushout.condition])
    let fv : Limits.pushout as g ⟶ Limits.pushout av g :=
      Limits.pushout.desc (rsv ≫ Limits.pushout.inl av g) (Limits.pushout.inr av g)
        (by rw [← Category.assoc, h2, Limits.pushout.condition])
    let fui : Limits.pushout au g ⟶ Limits.pushout ai g :=
      Limits.pushout.desc (rui ≫ Limits.pushout.inl ai g) (Limits.pushout.inr ai g)
        (by rw [← Category.assoc, h3, Limits.pushout.condition])
    let fvi : Limits.pushout av g ⟶ Limits.pushout ai g :=
      Limits.pushout.desc (rvi ≫ Limits.pushout.inl ai g) (Limits.pushout.inr ai g)
        (by rw [← Category.assoc, h4, Limits.pushout.condition])
    have hP' : IsPullback fu fv fui fvi := hP
    have hP2 : IsPullback (fu ≫ hu.isoPushout.inv) (fv ≫ hv.isoPushout.inv) rui' rvi' := by
      refine IsPullback.of_iso hP' (Iso.refl _) hu.isoPushout.symm hv.isoPushout.symm
        hi.isoPushout.symm (by simp) (by simp) ?_ ?_
      · show fui ≫ hi.isoPushout.inv = hu.isoPushout.inv ≫ rui'
        refine Limits.pushout.hom_ext ?_ ?_
        · rw [Limits.pushout.inl_desc_assoc, Category.assoc, IsPushout.inl_isoPushout_inv,
            IsPushout.inl_isoPushout_inv_assoc, k3]
        · rw [Limits.pushout.inr_desc_assoc, IsPushout.inr_isoPushout_inv,
            IsPushout.inr_isoPushout_inv_assoc, h3']
      · show fvi ≫ hi.isoPushout.inv = hv.isoPushout.inv ≫ rvi'
        refine Limits.pushout.hom_ext ?_ ?_
        · rw [Limits.pushout.inl_desc_assoc, Category.assoc, IsPushout.inl_isoPushout_inv,
            IsPushout.inl_isoPushout_inv_assoc, k4]
        · rw [Limits.pushout.inr_desc_assoc, IsPushout.inr_isoPushout_inv,
            IsPushout.inr_isoPushout_inv_assoc, h4']
    let θ : Limits.pushout as g ⟶ Bs := Limits.pushout.desc ts bs ks
    have hθ : θ = (IsPullback.isoIsPullback _ _ hP2 hB).hom := by
      refine hB.hom_ext ?_ ?_
      · rw [IsPullback.isoIsPullback_hom_fst]
        refine Limits.pushout.hom_ext ?_ ?_
        · rw [Limits.pushout.inl_desc_assoc, Limits.pushout.inl_desc_assoc, Category.assoc,
            IsPushout.inl_isoPushout_inv, k1]
        · rw [Limits.pushout.inr_desc_assoc, Limits.pushout.inr_desc_assoc,
            IsPushout.inr_isoPushout_inv, h1']
      · rw [IsPullback.isoIsPullback_hom_snd]
        refine Limits.pushout.hom_ext ?_ ?_
        · rw [Limits.pushout.inl_desc_assoc, Limits.pushout.inl_desc_assoc, Category.assoc,
            IsPushout.inl_isoPushout_inv, k2]
        · rw [Limits.pushout.inr_desc_assoc, Limits.pushout.inr_desc_assoc,
            IsPushout.inr_isoPushout_inv, h2']
    have : IsIso θ := by rw [hθ]; infer_instance
    refine (IsPushout.of_hasPushout as g).of_iso (Iso.refl _) (Iso.refl _) (Iso.refl _) (asIso θ)
      (by simp) (by simp) ?_ ?_
    · simp only [Iso.refl_hom, Category.id_comp, asIso_hom, θ, Limits.pushout.inl_desc]
    · simp only [Iso.refl_hom, Category.id_comp, asIso_hom, θ, Limits.pushout.inr_desc]

  have s3 : ∀ (X : Scheme.{u}) [QuasiSeparatedSpace X] (P : X.Opens → Prop),
      (∀ U : X.Opens, IsAffineOpen U → P U) →
      (∀ U V : X.Opens, P U → P V → P (U ⊓ V) → P (U ⊔ V)) →
      ∀ U : X.Opens, IsCompact (U : Set X) → P U := by
    intro X _ P haff hsup
    classical
    have st1 : ∀ (W : X.Opens), IsAffineOpen W → ∀ (s : Finset Γ(X, W)) (c : Γ(X, W)),
        P (⨆ h ∈ s, X.basicOpen (c * h)) := by
      intro W hW s
      induction s using Finset.induction_on with
      | empty =>
        intro c
        simp only [Finset.notMem_empty, iSup_false, iSup_bot]
        exact haff ⊥ (isAffineOpen_bot X)
      | insert a s ha ih =>
        intro c
        rw [Finset.iSup_insert]
        apply hsup
        · exact haff _ (hW.basicOpen _)
        · exact ih c
        · have e : X.basicOpen (c * a) ⊓ ⨆ h ∈ s, X.basicOpen (c * h) =
              ⨆ h ∈ s, X.basicOpen ((c * a * c) * h) := by
            rw [inf_iSup₂_eq]
            refine iSup_congr fun h => iSup_congr fun _ => ?_
            rw [← Scheme.basicOpen_mul]
            congr 1
            ring
          rw [e]
          exact ih _
    have st1' : ∀ (W : X.Opens), IsAffineOpen W → ∀ U : X.Opens, U ≤ W →
        IsCompact (U : Set X) → P U := by
      intro W hW U hUW hU
      have hcov : ∀ x : U, ∃ g : Γ(X, W), X.basicOpen g ≤ U ∧ (x : X) ∈ X.basicOpen g :=
        fun x => hW.exists_basicOpen_le x (hUW x.2)
      choose g hg1 hg2 using hcov
      obtain ⟨t, ht⟩ := hU.elim_finite_subcover (fun x : U => (X.basicOpen (g x) : Set X))
        (fun x => (X.basicOpen (g x)).isOpen)
        (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, hg2 ⟨x, hx⟩⟩)
      have heq : U = ⨆ h ∈ t.image g, X.basicOpen (1 * h) := by
        apply le_antisymm
        · intro x hx
          obtain ⟨i, hi, hxi⟩ := Set.mem_iUnion₂.mp (ht hx)
          simp only [one_mul]
          exact (le_iSup₂ (f := fun h (_ : h ∈ t.image g) => X.basicOpen h) (g i)
            (Finset.mem_image_of_mem g hi)) hxi
        · simp only [one_mul]
          exact iSup₂_le fun h hh => by
            obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hh
            exact hg1 i
      rw [heq]
      exact st1 W hW _ 1
    intro U hU
    refine compact_open_induction_on (P := P) U hU (haff ⊥ (isAffineOpen_bot X)) ?_
    intro S hS A hPS
    refine hsup S A hPS (haff _ A.2) ?_
    refine st1' A A.2 (S ⊓ A) inf_le_right ?_
    exact QuasiSeparatedSpace.inter_isCompact _ _ S.isOpen hS A.1.isOpen A.2.isCompact
  intro R R' _ _ φ hff X f hX hqs hX'
  set β := Spec.map (CommRingCat.ofHom φ) with hβ
  set p := Limits.pullback.fst f β with hp
  set q := Limits.pullback.snd f β with hq

  have key : ∀ (h1 h2 : Limits.pullback f β ⟶ Spec (.of R)), h1 = h2 →
      ∀ (W : (Limits.pullback f β).Opens) e1 e2, h1.appLE ⊤ W e1 = h2.appLE ⊤ W e2 := by
    intro h1 h2 e; subst e; intros; rfl
  have hsq : ∀ W : X.Opens, ((Scheme.ΓSpecIso (.of R)).inv ≫ f.appLE ⊤ W le_top) ≫ p.app W =
      CommRingCat.ofHom φ ≫ ((Scheme.ΓSpecIso (.of R')).inv ≫ q.appLE ⊤ (p ⁻¹ᵁ W) le_top) := by
    intro W
    calc ((Scheme.ΓSpecIso (.of R)).inv ≫ f.appLE ⊤ W le_top) ≫ p.app W
        = (Scheme.ΓSpecIso (.of R)).inv ≫ (f.appLE ⊤ W le_top ≫ p.appLE W (p ⁻¹ᵁ W) le_rfl) := by
          rw [Scheme.Hom.app_eq_appLE, Category.assoc]
      _ = (Scheme.ΓSpecIso (.of R)).inv ≫ (p ≫ f).appLE ⊤ (p ⁻¹ᵁ W) le_top :=
          congrArg _ (Scheme.Hom.appLE_comp_appLE p f ⊤ W (p ⁻¹ᵁ W) le_top le_rfl)
      _ = (Scheme.ΓSpecIso (.of R)).inv ≫ (q ≫ β).appLE ⊤ (p ⁻¹ᵁ W) le_top :=
          congrArg _ (key _ _ Limits.pullback.condition _ _ _)
      _ = (Scheme.ΓSpecIso (.of R)).inv ≫ (β.appTop ≫ q.appLE ⊤ (p ⁻¹ᵁ W) le_top) :=
          congrArg _ (Scheme.Hom.comp_appLE q β ⊤ (p ⁻¹ᵁ W) le_top)
      _ = ((Scheme.ΓSpecIso (.of R)).inv ≫ β.appTop) ≫ q.appLE ⊤ (p ⁻¹ᵁ W) le_top :=
          (Category.assoc _ _ _).symm
      _ = (CommRingCat.ofHom φ ≫ (Scheme.ΓSpecIso (.of R')).inv) ≫
            q.appLE ⊤ (p ⁻¹ᵁ W) le_top := by
          rw [Scheme.ΓSpecIso_inv_naturality]
      _ = _ := Category.assoc _ _ _
  have hres : ∀ {Z : Scheme.{u}} {S : CommRingCat.{u}} (g : Z ⟶ Spec S) (W W' : Z.Opens)
      (h : W' ≤ W),
      ((Scheme.ΓSpecIso S).inv ≫ g.appLE ⊤ W le_top) ≫ Z.presheaf.map (homOfLE h).op =
      (Scheme.ΓSpecIso S).inv ≫ g.appLE ⊤ W' le_top := by
    intro Z S g W W' h
    exact (Category.assoc _ _ _).trans (congrArg _ (Scheme.Hom.appLE_map g _ _))
  have hnat : ∀ (W W' : X.Opens) (h : W' ≤ W) (h' : p ⁻¹ᵁ W' ≤ p ⁻¹ᵁ W),
      p.app W ≫ (Limits.pullback f β).presheaf.map (homOfLE h').op =
      X.presheaf.map (homOfLE h).op ≫ p.app W' :=
    fun W W' h h' => (Scheme.Hom.naturality p (homOfLE h).op).symm

  have s1 : ∀ U : X.Opens, IsAffineOpen U →
      IsPushout ((Scheme.ΓSpecIso (.of R)).inv ≫ f.appLE ⊤ U le_top) (CommRingCat.ofHom φ)
        (p.app U) ((Scheme.ΓSpecIso (.of R')).inv ≫ q.appLE ⊤ (p ⁻¹ᵁ U) le_top) := by
    intro U hU
    have hpb : IsPullback (p ∣_ U) ((p ⁻¹ᵁ U).ι ≫ q) (U.ι ≫ f) β :=
      (isPullback_morphismRestrict p U).paste_vert (IsPullback.of_hasPullback f β)
    have : IsAffine U.toScheme := hU
    have h0 := gen _ _ _ _ hpb inferInstance inferInstance inferInstance
    refine IsPushout.of_iso h0 (Scheme.ΓSpecIso (.of R)) U.topIso (Scheme.ΓSpecIso (.of R'))
      (p ⁻¹ᵁ U).topIso ?_ ?_ ?_ ?_
    · rw [Iso.hom_inv_id_assoc]
      exact H1 f U
    · exact Scheme.ΓSpecIso_naturality _
    · exact H3 p U
    · rw [Iso.hom_inv_id_assoc]
      exact H1 q (p ⁻¹ᵁ U)

  have s2 : ∀ U V : X.Opens,
      IsPushout ((Scheme.ΓSpecIso (.of R)).inv ≫ f.appLE ⊤ U le_top) (CommRingCat.ofHom φ)
        (p.app U) ((Scheme.ΓSpecIso (.of R')).inv ≫ q.appLE ⊤ (p ⁻¹ᵁ U) le_top) →
      IsPushout ((Scheme.ΓSpecIso (.of R)).inv ≫ f.appLE ⊤ V le_top) (CommRingCat.ofHom φ)
        (p.app V) ((Scheme.ΓSpecIso (.of R')).inv ≫ q.appLE ⊤ (p ⁻¹ᵁ V) le_top) →
      IsPushout ((Scheme.ΓSpecIso (.of R)).inv ≫ f.appLE ⊤ (U ⊓ V) le_top) (CommRingCat.ofHom φ)
        (p.app (U ⊓ V)) ((Scheme.ΓSpecIso (.of R')).inv ≫ q.appLE ⊤ (p ⁻¹ᵁ (U ⊓ V)) le_top) →
      IsPushout ((Scheme.ΓSpecIso (.of R)).inv ≫ f.appLE ⊤ (U ⊔ V) le_top) (CommRingCat.ofHom φ)
        (p.app (U ⊔ V)) ((Scheme.ΓSpecIso (.of R')).inv ≫ q.appLE ⊤ (p ⁻¹ᵁ (U ⊔ V)) le_top) := by
    intro U V hU hV hI
    have shpb : ∀ (Z : Scheme.{u}) (A B C D : Z.Opens) (hC : C = A ⊔ B) (hD : D = A ⊓ B)
        (h1 : A ≤ C) (h2 : B ≤ C) (h3 : D ≤ A) (h4 : D ≤ B),
        IsPullback (Z.presheaf.map (homOfLE h1).op) (Z.presheaf.map (homOfLE h2).op)
          (Z.presheaf.map (homOfLE h3).op) (Z.presheaf.map (homOfLE h4).op) := by
      intro Z A B C D hC hD h1 h2 h3 h4
      subst hC hD
      exact IsPullback.of_isLimit (Z.sheaf.isLimitPullbackCone A B)
    have hA := shpb X U V (U ⊔ V) (U ⊓ V) rfl rfl le_sup_left le_sup_right inf_le_left inf_le_right
    have hB := shpb (Limits.pullback f β) (p ⁻¹ᵁ U) (p ⁻¹ᵁ V) (p ⁻¹ᵁ (U ⊔ V)) (p ⁻¹ᵁ (U ⊓ V))
      (Scheme.Hom.preimage_sup p) (Scheme.Hom.preimage_inf p)
      (Scheme.Hom.preimage_mono p le_sup_left) (Scheme.Hom.preimage_mono p le_sup_right)
      (Scheme.Hom.preimage_mono p inf_le_left) (Scheme.Hom.preimage_mono p inf_le_right)
    exact hmv (CommRingCat.ofHom φ) hff.flat _ _ _ _ _ _ _ _
      (hres f _ _ _) (hres f _ _ _) (hres f _ _ _) (hres f _ _ _) hA _ _ _ _ _ _ _ _
      (hres q _ _ _) (hres q _ _ _) (hres q _ _ _) (hres q _ _ _) hB
      (p.app (U ⊔ V)) (p.app U) (p.app V) (p.app (U ⊓ V))
      (hnat _ _ _ _) (hnat _ _ _ _) (hnat _ _ _ _) (hnat _ _ _ _) (hsq _) hU hV hI

  have : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated f
  have hBC := s3 X (fun U => IsPushout ((Scheme.ΓSpecIso (.of R)).inv ≫ f.appLE ⊤ U le_top)
      (CommRingCat.ofHom φ) (p.app U)
      ((Scheme.ΓSpecIso (.of R')).inv ≫ q.appLE ⊤ (p ⁻¹ᵁ U) le_top))
    s1 s2 ⊤ (by rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ)

  have hi := isPullback_SpecMap_of_isPushout _ _ _ _ hBC
  have hfac : X.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso (.of R)).inv ≫ f.appLE ⊤ ⊤ le_top) = f := by
    have e1 : f.appLE ⊤ ⊤ le_top = f.appTop := (Scheme.Hom.app_eq_appLE f).symm
    rw [e1, Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality, Category.assoc,
      toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
  have hfac' : (Limits.pullback f β).toSpecΓ ≫
      Spec.map ((Scheme.ΓSpecIso (.of R')).inv ≫ q.appLE ⊤ (p ⁻¹ᵁ ⊤) le_top) = q := by
    have e1 : q.appLE ⊤ (p ⁻¹ᵁ ⊤) le_top = q.appTop := (Scheme.Hom.app_eq_appLE q).symm
    rw [e1, Spec.map_comp, ← Category.assoc, ← Scheme.toSpecΓ_naturality, Category.assoc,
      toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
  have htop : p ≫ X.toSpecΓ = (Limits.pullback f β).toSpecΓ ≫ Spec.map (p.app ⊤) :=
    Scheme.toSpecΓ_naturality p
  have hs : IsPullback p ((Limits.pullback f β).toSpecΓ ≫
      Spec.map ((Scheme.ΓSpecIso (.of R')).inv ≫ q.appLE ⊤ (p ⁻¹ᵁ ⊤) le_top))
      (X.toSpecΓ ≫ Spec.map ((Scheme.ΓSpecIso (.of R)).inv ≫ f.appLE ⊤ ⊤ le_top)) β := by
    rw [hfac, hfac']
    exact IsPullback.of_hasPullback f β
  have hsq4 := IsPullback.of_bot hs htop hi
  have : IsIso (Limits.pullback f β).toSpecΓ := hX'.affine
  have hβfs := (flat_and_surjective_SpecMap_iff (CommRingCat.ofHom φ)).mpr hff
  have hQ : ((@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme.{u}))
      (Spec.map (p.app ⊤)) := by
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · exact MorphismProperty.of_isPullback (P := @Surjective) hi.flip hβfs.2
    · exact MorphismProperty.of_isPullback (P := @Flat) hi.flip hβfs.1
    · show QuasiCompact (Spec.map (p.app ⊤))
      infer_instance
  have hiso := MorphismProperty.of_isPullback_of_descendsAlong
    (P := MorphismProperty.isomorphisms Scheme.{u})
    (Q := (@Surjective ⊓ @Flat ⊓ @QuasiCompact : MorphismProperty Scheme.{u}))
    hsq4.flip hQ (MorphismProperty.isomorphisms.infer_property _)
  have : IsIso X.toSpecΓ := hiso
  exact ⟨inferInstance⟩

theorem wcpa_dj_lmga_ca_basechange : ∀ (Ω Ω₂ : Type u) [Field Ω] [Field Ω₂] (W' : ValuationSubring Ω)
    (W₂ : ValuationSubring Ω₂) (ι : ↥W' →+* ↥W₂), IsLocalHom ι →
    ∀ (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of ↥W')) (r : ℕ) (σ : Fin r → (Spec (.of ↥W') ⟶ Z')),
    (∀ i, σ i ≫ u' = 𝟙 _) →
    (∀ i p, ∃ O : Z'.Opens, σ i p ∈ O ∧ SmoothOfRelativeDimension 1 (O.ι ≫ u')) →
    ∀ U' : Z'.Opens, (U' : Set Z') = (⋃ i, Set.range (σ i))ᶜ →
    IsAffineOpen (Limits.pullback.fst u'
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⁻¹ᵁ U') →
    ∃ σ₂ : Fin r → (Spec (.of ↥W₂) ⟶ Limits.pullback u' (Spec.map (CommRingCat.ofHom ι))),
      (∀ i, σ₂ i ≫ Limits.pullback.snd u' (Spec.map (CommRingCat.ofHom ι)) = 𝟙 _) ∧
      (∀ i p, ∃ O : (Limits.pullback u' (Spec.map (CommRingCat.ofHom ι))).Opens, σ₂ i p ∈ O ∧
        SmoothOfRelativeDimension 1 (O.ι ≫ Limits.pullback.snd u' (Spec.map (CommRingCat.ofHom ι)))) ∧
      (((Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι)) ⁻¹ᵁ U' :
          (Limits.pullback u' (Spec.map (CommRingCat.ofHom ι))).Opens) :
          Set ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom ι)))) =
        (⋃ i, Set.range (σ₂ i))ᶜ) ∧
      IsAffineOpen (Limits.pullback.fst (Limits.pullback.snd u' (Spec.map (CommRingCat.ofHom ι)))
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂)))) ⁻¹ᵁ
        (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι)) ⁻¹ᵁ U')) :=
by
  intro Ω Ω₂ _ _ W' W₂ ι hloc Z' u' r σ hσ hsm U' hU' hTR
  classical
  haveI := hloc
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]
  have hpb : IsPullback (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι)))
      (Limits.pullback.snd u' (Spec.map (CommRingCat.ofHom ι))) u' (Spec.map (CommRingCat.ofHom ι)) :=
    IsPullback.of_hasPullback _ _
  let σ₂ : Fin r → (Spec (.of ↥W₂) ⟶ Limits.pullback u' (Spec.map (CommRingCat.ofHom ι))) :=
    fun i => Limits.pullback.lift (Spec.map (CommRingCat.ofHom ι) ≫ σ i) (𝟙 _)
      (by rw [Category.assoc, hσ i, Category.comp_id, Category.id_comp])
  have hs : ∀ i, σ₂ i ≫ Limits.pullback.snd u' (Spec.map (CommRingCat.ofHom ι)) = 𝟙 _ :=
    fun i => Limits.pullback.lift_snd _ _ _
  have hf : ∀ i, σ₂ i ≫ Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι)) =
      Spec.map (CommRingCat.ofHom ι) ≫ σ i := fun i => Limits.pullback.lift_fst _ _ _

  have hG2 : ∀ i p, ∃ O : (Limits.pullback u' (Spec.map (CommRingCat.ofHom ι))).Opens,
      σ₂ i p ∈ O ∧
        SmoothOfRelativeDimension 1 (O.ι ≫ Limits.pullback.snd u' (Spec.map (CommRingCat.ofHom ι))) := by
    intro i p
    obtain ⟨W, hW, hWsm⟩ := hsm i (Spec.map (CommRingCat.ofHom ι) p)
    refine ⟨Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι)) ⁻¹ᵁ W, ?_, ?_⟩
    · show Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι)) (σ₂ i p) ∈ W
      rw [pt (hf i) p, Scheme.Hom.comp_apply]
      exact hW
    · have h1 := isPullback_morphismRestrict (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι))) W
      have h2 := h1.paste_vert hpb
      exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hWsm

  have hrange : ∀ i, Set.range (σ₂ i) =
      (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι))) ⁻¹' Set.range (σ i) := by
    intro i
    have hsq : IsPullback (Spec.map (CommRingCat.ofHom ι)) (σ₂ i) (σ i)
        (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι))) := by
      refine IsPullback.of_bot ?_ (hf i).symm hpb
      rw [hs i, hσ i]
      exact IsPullback.id_vert _
    have h := hsq.flip
    ext z
    constructor
    · rintro ⟨x, rfl⟩
      refine ⟨Spec.map (CommRingCat.ofHom ι) x, ?_⟩
      rw [← Scheme.Hom.comp_apply, ← hf i, Scheme.Hom.comp_apply]
    · intro hz
      rw [← Scheme.Pullback.range_fst] at hz
      obtain ⟨w, rfl⟩ := hz
      refine ⟨h.isoPullback.inv w, ?_⟩
      exact pt ((Iso.inv_comp_eq _).mpr h.isoPullback_hom_fst.symm) w

  have hG3 : ((Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι)) ⁻¹ᵁ U' :
          (Limits.pullback u' (Spec.map (CommRingCat.ofHom ι))).Opens) :
          Set ↥(Limits.pullback u' (Spec.map (CommRingCat.ofHom ι)))) =
        (⋃ i, Set.range (σ₂ i))ᶜ := by
    ext z
    change Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι)) z ∈ (U' : Set Z') ↔
      z ∈ (⋃ i, Set.range (σ₂ i))ᶜ
    rw [hU']
    simp only [Set.mem_compl_iff, Set.mem_iUnion, hrange, Set.mem_preimage]

  have hcomm : Spec.map (CommRingCat.ofHom (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂))) ≫
      Spec.map (CommRingCat.ofHom ι) =
      Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.map ι)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))) := by
    rw [← Spec.map_comp, ← Spec.map_comp, ← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    congr 2
  have hY₂ := IsPullback.of_hasPullback (Limits.pullback.snd u' (Spec.map (CommRingCat.ofHom ι)))
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂))))
  have hY := IsPullback.of_hasPullback u'
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))))
  have outer := hY₂.paste_horiz hpb
  rw [hcomm] at outer
  let g := Limits.pullback.lift (Limits.pullback.fst (Limits.pullback.snd u' (Spec.map (CommRingCat.ofHom ι)))
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂)))) ≫
      Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι)))
    (Limits.pullback.snd (Limits.pullback.snd u' (Spec.map (CommRingCat.ofHom ι)))
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂)))) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.map ι)))
    (by rw [outer.w, Category.assoc])
  have hg1 : g ≫ Limits.pullback.fst u'
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) =
      Limits.pullback.fst (Limits.pullback.snd u' (Spec.map (CommRingCat.ofHom ι)))
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂)))) ≫
      Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι)) := Limits.pullback.lift_fst _ _ _
  have hg2 : g ≫ Limits.pullback.snd u'
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) =
      Limits.pullback.snd (Limits.pullback.snd u' (Spec.map (CommRingCat.ofHom ι)))
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂)))) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.map ι)) := Limits.pullback.lift_snd _ _ _
  have hg : IsPullback g _ _ _ := IsPullback.of_right (by rw [hg1]; exact outer) hg2 hY
  haveI : IsAffineHom g :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) hg.flip inferInstance
  have hpre : Limits.pullback.fst (Limits.pullback.snd u' (Spec.map (CommRingCat.ofHom ι)))
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂)))) ⁻¹ᵁ
        (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι)) ⁻¹ᵁ U') =
      g ⁻¹ᵁ (Limits.pullback.fst u'
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⁻¹ᵁ U') := by
    rw [← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage, hg1]
  refine ⟨σ₂, hs, hG2, hG3, ?_⟩
  rw [hpre]
  exact hTR.preimage g

theorem wcpa_dj_lmga_ca_families : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Z : Scheme.{u})
    (u : Z ⟶ Spec (.of R)), IsSeparated u →
    ∀ (r : ℕ) (σ : Fin r → (Spec (.of R) ⟶ Z)), (∀ i, σ i ≫ u = 𝟙 _) →
    ∃ (n : ℕ) (S : Fin n → Finset (Fin r)), 0 < n ∧
      (∀ k, ∀ i ∈ S k, ∀ j ∈ S k, i ≠ j → ∀ p q, σ i p ≠ σ j q) ∧
      (∀ k j, ∃ i ∈ S k, σ i (IsLocalRing.closedPoint R) = σ j (IsLocalRing.closedPoint R)) ∧
      (∀ j, ∃ k, j ∈ S k) :=
by
  classical
  intro R _ _ Z u hsep r σ hσ
  rcases Nat.eq_zero_or_pos r with rfl | hr
  · exact ⟨1, fun _ => ∅, one_pos, by simp, fun _ j => j.elim0, fun j => j.elim0⟩
  haveI : Nonempty (Fin r) := ⟨⟨0, hr⟩⟩
  let cls : Fin r → Z := fun j => σ j (IsLocalRing.closedPoint R)
  let g : Z → Fin r := fun z => Classical.epsilon (fun i => cls i = z)
  have hg : ∀ j, cls (g (cls j)) = cls j := fun j =>
    Classical.epsilon_spec (p := fun i => cls i = cls j) ⟨j, rfl⟩
  let h : Fin r → Z → Fin r := fun c z => if cls c = z then c else g z
  have hh : ∀ c j, cls (h c (cls j)) = cls j := by
    intro c j
    by_cases hc : cls c = cls j
    · show cls (if cls c = cls j then c else g (cls j)) = cls j
      rw [if_pos hc]
      exact hc
    · show cls (if cls c = cls j then c else g (cls j)) = cls j
      rw [if_neg hc]
      exact hg j
  let S : Fin r → Finset (Fin r) := fun c => Finset.univ.image (fun j => h c (cls j))
  have hinj : ∀ c, ∀ a ∈ S c, ∀ b ∈ S c, cls a = cls b → a = b := by
    intro c a ha b hb hab
    obtain ⟨j₁, -, hj₁⟩ := Finset.mem_image.mp ha
    obtain ⟨j₂, -, hj₂⟩ := Finset.mem_image.mp hb
    have e1 : a = h c (cls j₁) := hj₁.symm
    have e2 : b = h c (cls j₂) := hj₂.symm
    have hcl : cls j₁ = cls j₂ := by
      rw [← hh c j₁, ← hh c j₂, ← e1, ← e2]
      exact hab
    rw [e1, e2, hcl]
  have sec_pt : ∀ i p, u (σ i p) = p := by
    intro i p
    rw [← Scheme.Hom.comp_apply, hσ i]
    rfl
  have sfacts : ∀ i j p, σ i p = σ j p →
      σ i (IsLocalRing.closedPoint R) = σ j (IsLocalRing.closedPoint R) := by
    intro i j p hp
    haveI : IsSeparated u := hsep
    haveI : IsClosedImmersion (σ i ≫ u) := by rw [hσ i]; infer_instance
    haveI : IsClosedImmersion (σ i) := IsClosedImmersion.of_comp (σ i) u
    have hA : IsClosed (Set.range (σ i)) := (σ i).isClosedEmbedding.isClosed_range
    have h1 : σ j p ⤳ σ j (IsLocalRing.closedPoint R) :=
      (IsLocalRing.specializes_closedPoint p).map (σ j).continuous
    have h2 : σ j p ∈ Set.range (σ i) := ⟨p, hp⟩
    obtain ⟨q, hq⟩ := h1.mem_closed hA h2
    have hqm : q = IsLocalRing.closedPoint R :=
      (sec_pt i q).symm.trans ((congrArg u hq).trans (sec_pt j _))
    subst hqm
    exact hq
  refine ⟨r, S, hr, ?_, ?_, ?_⟩
  · intro k i hi j hj hij p q hpq
    have hpq' : p = q := by rw [← sec_pt i p, hpq, sec_pt j q]
    subst hpq'
    have hc := sfacts i j p hpq
    exact hij (hinj k i hi j hj hc)
  · intro k j
    exact ⟨h k (cls j), Finset.mem_image_of_mem _ (Finset.mem_univ j), hh k j⟩
  · intro j
    refine ⟨j, Finset.mem_image.mpr ⟨j, Finset.mem_univ j, ?_⟩⟩
    show (if cls j = cls j then j else g (cls j)) = j
    exact if_pos rfl

theorem wcpa_dj_lmga_ca_trace_cov : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)), IsProper uu →
    ∀ (m : ℕ) (ε : Fin m → (Spec (.of ↥W) ⟶ Z)), (∀ i, ε i ≫ uu = 𝟙 _) →
    ∀ U : Z.Opens, (U : Set Z) = (⋃ i, Set.range (ε i))ᶜ →
    IsAffineOpen (Limits.pullback.fst uu
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ⁻¹ᵁ U) →
    ∀ z : Z, uu z = IsLocalRing.closedPoint ↥W → ¬ IsClosed ({z} : Set Z) →
      ∃ a, ε a (IsLocalRing.closedPoint ↥W) ∈ closure ({z} : Set Z) :=
by
  intro Ω _ W Z uu huu m ε hε U hU hV z hz hzc
  classical
  by_contra hcon
  push_neg at hcon
  set ρ := Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) with hρ

  have hsec : ∀ i p, uu (ε i p) = p := by
    intro i p
    rw [← Scheme.Hom.comp_apply, hε i]
    rfl
  have hcz : IsClosed ({uu z} : Set ↥(Spec (.of ↥W))) := by
    rw [hz]; exact IsLocalRing.isClosed_singleton_closedPoint ↥W
  have hCs : ∀ y ∈ closure ({z} : Set Z), uu y = IsLocalRing.closedPoint ↥W := by
    intro y hy
    have h1 := image_closure_subset_closure_image uu.continuous ⟨y, hy, rfl⟩
    rw [Set.image_singleton, hcz.closure_eq, Set.mem_singleton_iff] at h1
    exact h1.trans hz
  have hCU : closure ({z} : Set Z) ⊆ (U : Set Z) := by
    intro y hy
    rw [hU]
    intro hy'
    obtain ⟨i, p, hp⟩ := Set.mem_iUnion.mp hy'
    have hps : p = IsLocalRing.closedPoint ↥W := by rw [← hsec i p, hp, hCs y hy]
    apply hcon i
    rw [← hps, hp]
    exact hy

  have closed_eq : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (q : PrimeSpectrum R),
      IsClosed ({q} : Set (PrimeSpectrum R)) → q = IsLocalRing.closedPoint R := by
    intro R _ _ q hq
    have hm := (PrimeSpectrum.isClosed_singleton_iff_isMaximal q).mp hq
    ext1
    exact IsLocalRing.eq_maximalIdeal hm
  haveI hρci : IsClosedImmersion ρ :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  let y₀ : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))) :=
    IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)
  have hρy : ρ y₀ = IsLocalRing.closedPoint ↥W := by
    apply closed_eq
    have hc : IsClosed ({y₀} : Set ↥(Spec (.of (IsLocalRing.ResidueField ↥W)))) :=
      IsLocalRing.isClosed_singleton_closedPoint (IsLocalRing.ResidueField ↥W)
    have := (Scheme.Hom.isClosedEmbedding ρ).isClosedMap _ hc
    rw [Set.image_singleton] at this
    exact this
  obtain ⟨z', hz', -⟩ :=
    Scheme.Pullback.exists_preimage_pullback (f := uu) (g := ρ) z y₀ (hz.trans hρy.symm)

  have hC' : closure ({z'} : Set ↥(Limits.pullback uu ρ)) ⊆
      ((Limits.pullback.fst uu ρ ⁻¹ᵁ U : (Limits.pullback uu ρ).Opens) : Set _) := by
    intro w hw
    have h1 := image_closure_subset_closure_image (Limits.pullback.fst uu ρ).continuous ⟨w, hw, rfl⟩
    rw [Set.image_singleton, hz'] at h1
    exact hCU h1

  have hVa : IsAffineOpen (Limits.pullback.fst uu ρ ⁻¹ᵁ U) := hV
  have hfr : Set.range hVa.fromSpec = ((Limits.pullback.fst uu ρ ⁻¹ᵁ U : (Limits.pullback uu ρ).Opens) : Set _) :=
    hVa.range_fromSpec
  obtain ⟨x₀, hx₀⟩ : z' ∈ Set.range hVa.fromSpec := by
    rw [hfr]; exact hC' (subset_closure rfl)
  haveI hprime : x₀.asIdeal.IsPrime := x₀.isPrime
  let q : Spec (CommRingCat.of (Γ(Limits.pullback uu ρ, Limits.pullback.fst uu ρ ⁻¹ᵁ U) ⧸ x₀.asIdeal)) ⟶
      Spec Γ(Limits.pullback uu ρ, Limits.pullback.fst uu ρ ⁻¹ᵁ U) :=
    Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk x₀.asIdeal))
  haveI hqci : IsClosedImmersion q :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  have hqr : Set.range q = closure ({x₀} : Set ↥(Spec Γ(Limits.pullback uu ρ, Limits.pullback.fst uu ρ ⁻¹ᵁ U))) := by
    show Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk x₀.asIdeal)) =
      closure ({(x₀ : PrimeSpectrum ↑Γ(Limits.pullback uu ρ, Limits.pullback.fst uu ρ ⁻¹ᵁ U))} :
        Set (PrimeSpectrum ↑Γ(Limits.pullback uu ρ, Limits.pullback.fst uu ρ ⁻¹ᵁ U)))
    rw [range_comap_of_surjective _ _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
    exact (PrimeSpectrum.closure_singleton _).symm
  have hir : Set.range (q ≫ hVa.fromSpec) = closure ({z'} : Set ↥(Limits.pullback uu ρ)) := by
    have e1 : Set.range ⇑(q ≫ hVa.fromSpec) = ⇑hVa.fromSpec '' Set.range ⇑q := by
      ext w
      constructor
      · rintro ⟨x, rfl⟩
        exact ⟨q x, ⟨x, rfl⟩, (Scheme.Hom.comp_apply q hVa.fromSpec x).symm⟩
      · rintro ⟨_, ⟨x, rfl⟩, rfl⟩
        exact ⟨x, Scheme.Hom.comp_apply q hVa.fromSpec x⟩
    rw [e1, hqr,
      (Scheme.Hom.isOpenEmbedding hVa.fromSpec).toIsEmbedding.toIsInducing.closure_eq_preimage_closure_image,
      Set.image_singleton, hx₀, Set.image_preimage_eq_inter_range, hfr]
    exact Set.inter_eq_left.mpr hC'
  haveI : IsPreimmersion (q ≫ hVa.fromSpec) := inferInstance
  haveI hici : IsClosedImmersion (q ≫ hVa.fromSpec) :=
    IsClosedImmersion.of_isPreimmersion _ (by rw [hir]; exact isClosed_closure)

  haveI := huu
  haveI : IsProper ((q ≫ hVa.fromSpec) ≫ Limits.pullback.snd uu ρ) := inferInstance
  have hint : IsIntegralHom ((q ≫ hVa.fromSpec) ≫ Limits.pullback.snd uu ρ) := by
    rw [IsIntegralHom.iff_universallyClosed_and_isAffineHom]
    exact ⟨inferInstance, inferInstance⟩
  have hint2 : IsIntegralHom (Spec.map (Spec.preimage ((q ≫ hVa.fromSpec) ≫ Limits.pullback.snd uu ρ))) := by
    rw [Spec.map_preimage]; exact hint
  have hint3 := IsIntegralHom.SpecMap_iff.mp hint2
  letI := (Spec.preimage ((q ≫ hVa.fromSpec) ≫ Limits.pullback.snd uu ρ)).hom.toAlgebra
  haveI : Algebra.IsIntegral (IsLocalRing.ResidueField ↥W)
      (Γ(Limits.pullback uu ρ, Limits.pullback.fst uu ρ ⁻¹ᵁ U) ⧸ x₀.asIdeal) := ⟨hint3⟩
  have hF : IsField (Γ(Limits.pullback uu ρ, Limits.pullback.fst uu ρ ⁻¹ᵁ U) ⧸ x₀.asIdeal) :=
    isField_of_isIntegral_of_isField' (R := IsLocalRing.ResidueField ↥W) (Field.toIsField _)
  have key : ∀ P : Ideal (Γ(Limits.pullback uu ρ, Limits.pullback.fst uu ρ ⁻¹ᵁ U) ⧸ x₀.asIdeal),
      P.IsPrime → P = ⊥ := by
    intro P hP
    rw [eq_bot_iff]
    intro x hx
    rw [Ideal.mem_bot]
    by_contra hx0
    obtain ⟨y, hy⟩ := hF.mul_inv_cancel hx0
    exact hP.ne_top ((Ideal.eq_top_iff_one P).mpr (hy ▸ P.mul_mem_right y hx))
  have hpt : ∀ a b : PrimeSpectrum (Γ(Limits.pullback uu ρ, Limits.pullback.fst uu ρ ⁻¹ᵁ U) ⧸ x₀.asIdeal),
      a = b := by
    intro a b
    exact PrimeSpectrum.ext (by rw [key a.asIdeal a.isPrime, key b.asIdeal b.isPrime])

  have hsing : closure ({z'} : Set ↥(Limits.pullback uu ρ)) ⊆ {z'} := by
    intro w hw
    rw [← hir] at hw
    obtain ⟨a, rfl⟩ := hw
    have hz'r : z' ∈ Set.range (q ≫ hVa.fromSpec) := by rw [hir]; exact subset_closure rfl
    obtain ⟨b, hb⟩ := hz'r
    show (q ≫ hVa.fromSpec) a = z'
    rw [hpt a b]
    exact hb
  have hz'c : IsClosed ({z'} : Set ↥(Limits.pullback uu ρ)) := closure_subset_iff_isClosed.mp hsing
  haveI : IsClosedImmersion (Limits.pullback.fst uu ρ) := inferInstance
  apply hzc
  have := (Scheme.Hom.isClosedEmbedding (Limits.pullback.fst uu ρ)).isClosedMap _ hz'c
  rw [Set.image_singleton, hz'] at this
  exact this

theorem wcpa_dj_lmga_ca_amp_chart_affine : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T), IsProper q →
    ∀ L : wcpaDjCoc Y, wcpaDjCocOK L → ∀ W : T.Opens, IsAffineOpen W →
    (∀ a, IsAffineOpen (L.V a ⊓ q ⁻¹ᵁ W)) → ∀ e : ℕ, 0 < e → wcpaDjAmp q L W e →
    ∀ k : ℕ, 0 < k → ∀ t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W),
    wcpaDjCompat L (q ⁻¹ᵁ W) k t → IsAffineOpen (⨆ a, Y.basicOpen (t a)) :=
by
  intro Y T q hq L hL W hW hA e he hamp k hk t ht
  haveI := hq
  obtain ⟨e', he', hva⟩ := wcpa_dj_lcp_ra_amp_to_va q hq L hL W hW hA e he hamp
  obtain ⟨M, s, hC1, hC2, hC3, hC4⟩ := wcpa_dj_lcp_ra_veronese q L W e' k (by omega) hva
  have gr : ∀ (ξ : Y) (O1 O2 : Y.Opens) (hle : O1 ≤ O2) (h1 : ξ ∈ O1) (x : Γ(Y, O2)),
      (Y.presheaf.germ O1 ξ h1 ≫ Y.residue ξ).hom ((Y.presheaf.map (homOfLE hle).op).hom x) =
        (Y.presheaf.germ O2 ξ (hle h1) ≫ Y.residue ξ).hom x := by
    intro ξ O1 O2 hle h1 x
    rw [← CommRingCat.comp_apply, ← Category.assoc, TopCat.Presheaf.germ_res]
  have gg : ∀ (ξ : Y) (O1 O2 : Y.Opens) (hle : O1 ≤ O2) (h1 : ξ ∈ O1) (x : Γ(Y, O2)),
      (Y.presheaf.germ O1 ξ h1).hom ((Y.presheaf.map (homOfLE hle).op).hom x) =
        (Y.presheaf.germ O2 ξ (hle h1)).hom x := by
    intro ξ O1 O2 hle h1 x
    rw [← CommRingCat.comp_apply, TopCat.Presheaf.germ_res]
  have ext : ∀ (U : Y.Opens) (s1 s2 : Γ(Y, U)),
      (∀ (z : Y) (hz : z ∈ U), (Y.presheaf.germ U z hz).hom s1 = (Y.presheaf.germ U z hz).hom s2) →
      s1 = s2 := fun U s1 s2 h => TopCat.Presheaf.section_ext Y.sheaf U s1 s2 h

  have hx0 : wcpaDjCompat L (q ⁻¹ᵁ W) (e' * k) (fun a => t a ^ e') := by
    intro a b
    have h1 := congrArg (fun z => z ^ e') (ht a b)
    simp only [map_pow, mul_pow] at h1 ⊢
    rw [h1, ← pow_mul, mul_comm k e']
  let s' : Fin (M + 1 + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W) :=
    Fin.cons (fun a => t a ^ e') s
  have hcomp : ∀ i, wcpaDjCompat L (q ⁻¹ᵁ W) (e' * k) (s' i) := by
    intro i
    induction i using Fin.cases with
    | zero => exact hx0
    | succ J => exact hC1 J
  let G : Finset (Fin (M + 1 + 1)) := Finset.univ.image Fin.succ

  have hcov : (⨆ i ∈ G, ⨆ a, Y.basicOpen (s' i a)) = q ⁻¹ᵁ W := by
    apply le_antisymm
    · exact iSup₂_le fun i _ => iSup_le fun a => (Y.basicOpen_le (s' i a)).trans inf_le_right
    · intro y hy
      have hyV : y ∈ ⨆ a, L.V a := by rw [hL.2.1]; trivial
      obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hyV
      have hyU : y ∈ L.V a ⊓ q ⁻¹ᵁ W := ⟨ha, hy⟩
      have hsup := ((hA a).iSup_basicOpen_eq_self_iff
        (s := Set.range (fun J => s J a))).mpr (hC2 a)
      rw [← hsup] at hyU
      obtain ⟨⟨f, J, rfl⟩, hyf⟩ := TopologicalSpace.Opens.mem_iSup.mp hyU
      refine TopologicalSpace.Opens.mem_iSup.mpr ⟨J.succ, ?_⟩
      refine TopologicalSpace.Opens.mem_iSup.mpr ⟨Finset.mem_image_of_mem _ (Finset.mem_univ J), ?_⟩
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hyf⟩
  choose ρ hρ using fun i => wcpa_dj_lcp_ra_ratio_section q L hL W (e' * k) s' hcomp i

  have hgood : ∀ i ∈ G, IsAffineOpen (⨆ a, Y.basicOpen (s' i a)) ∧
      Function.Surjective (wcpaDjAvChart q L W s' i (ρ i)) := by
    intro i hi
    obtain ⟨J, -, rfl⟩ := Finset.mem_image.mp hi
    refine ⟨hC3 J, ?_⟩
    intro f
    obtain ⟨P, hP⟩ := hC4 J f
    refine ⟨MvPolynomial.rename Fin.succ P, ?_⟩
    apply ext
    intro z hz
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hz
    obtain ⟨inv, hinv, hfa⟩ := hP a
    have hle : Y.basicOpen (s' J.succ a) ≤ ⨆ a', Y.basicOpen (s' J.succ a') :=
      le_iSup (fun a' => Y.basicOpen (s' J.succ a')) a
    rw [← gg z _ _ hle ha, ← gg z _ _ hle ha]
    refine congrArg (Y.presheaf.germ _ z ha).hom ?_
    refine Eq.trans ?_ hfa.symm
    simp only [wcpaDjAvChart, MvPolynomial.coe_eval₂Hom]
    rw [MvPolynomial.eval₂_rename, MvPolynomial.eval₂_comp_left]
    congr 1
    · refine RingHom.ext fun r => ?_
      simp only [RingHom.comp_apply]
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]
      rfl
    · funext l
      have hle' : Y.basicOpen (s J a) ≤ ⨆ a', Y.basicOpen (s' J.succ a') := hle
      have hinv' : inv * (Y.presheaf.map (homOfLE (Y.basicOpen_le (s J a))).op).hom
          (s J a) = 1 := hinv
      have hr : (Y.presheaf.map (homOfLE hle').op).hom (ρ J.succ l.succ) *
          (Y.presheaf.map (homOfLE (Y.basicOpen_le (s J a))).op).hom (s J a) =
          (Y.presheaf.map (homOfLE (Y.basicOpen_le (s J a))).op).hom (s l a) :=
        hρ J.succ a l.succ
      show (Y.presheaf.map (homOfLE hle').op).hom (ρ J.succ l.succ) =
        (Y.presheaf.map (homOfLE (Y.basicOpen_le (s J a))).op).hom (s l a) * inv
      rw [← hr, mul_assoc, mul_comm _ inv, hinv', mul_one]

  have hbad : Ideal.span (MvPolynomial.X '' (G : Set (Fin (M + 1 + 1))) :
        Set (MvPolynomial (Fin (M + 1 + 1)) Γ(T, W))) ⊔
      RingHom.ker (wcpaDjAvChart q L W s' 0 (ρ 0)) = ⊤ := by
    by_contra hne
    obtain ⟨p, hpmax, hIp⟩ := Ideal.exists_le_maximal _ hne
    obtain ⟨ξ, hξ, V, hV⟩ := wcpa_dj_lcp_ra_center_prime (⨆ a, Y.basicOpen (s' 0 a)) L.m
      (fun a => Y.basicOpen (s' 0 a)) (fun a => (hA a).basicOpen (s' 0 a))
      (fun a => le_iSup (fun a' => Y.basicOpen (s' 0 a')) a) rfl
      (wcpaDjAvChart q L W s' 0 (ρ 0)) p hpmax.isPrime (le_sup_right.trans hIp)
    have hDU : (⨆ a, Y.basicOpen (s' 0 a)) ≤ q ⁻¹ᵁ W :=
      iSup_le fun a => (Y.basicOpen_le (s' 0 a)).trans inf_le_right
    have hξU : ξ ∈ q ⁻¹ᵁ W := hDU hξ
    have hR : ∀ r : Γ(T, W),
        (q.app W ≫ Y.presheaf.germ (q ⁻¹ᵁ W) ξ hξU ≫ Y.residue ξ).hom r ∈ V := by
      intro r
      obtain ⟨v, hv, -⟩ := hV (MvPolynomial.C r)
      have e1 : (wcpaDjAvChart q L W s' 0 (ρ 0)) (MvPolynomial.C r) =
          (Y.presheaf.map (homOfLE hDU).op).hom ((q.app W).hom r) := by
        simp only [wcpaDjAvChart, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      rw [e1, gr] at hv
      rw [CommRingCat.comp_apply, ← hv]
      exact v.2
    obtain ⟨y, hyU, hy⟩ := wcpa_dj_lcp_ra_valuative_center q inferInstance W hW ξ hξU V hR
    rw [← hcov] at hyU
    obtain ⟨i, hyi⟩ := TopologicalSpace.Opens.mem_iSup.mp hyU
    obtain ⟨hiG, hyi⟩ := TopologicalSpace.Opens.mem_iSup.mp hyi
    obtain ⟨a, hya⟩ := TopologicalSpace.Opens.mem_iSup.mp hyi
    obtain ⟨hξa, w, hw, hwu⟩ := hy (L.V a ⊓ q ⁻¹ᵁ W) (Y.basicOpen_le _ hya) (s' i a)
    obtain ⟨hξa', v, hv, -⟩ := hy (L.V a ⊓ q ⁻¹ᵁ W) (Y.basicOpen_le _ hya) (s' 0 a)
    have hwunit : IsUnit w := hwu hya
    have hξha : ξ ∈ Y.basicOpen (s' 0 a) := by
      obtain ⟨b, hb⟩ := TopologicalSpace.Opens.mem_iSup.mp hξ
      have hξb : ξ ∈ L.V b ⊓ q ⁻¹ᵁ W := Y.basicOpen_le _ hb
      have hξab : ξ ∈ L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W := ⟨⟨hξa.1, hξb.1⟩, hξU⟩
      rw [Scheme.mem_basicOpen _ _ _ hξb] at hb
      rw [Scheme.mem_basicOpen _ _ _ hξa]
      have hc := congrArg (fun z => (Y.presheaf.germ _ ξ hξab).hom z) (hcomp 0 a b)
      simp only [map_mul, gg] at hc
      rw [hc] at hb
      exact isUnit_of_mul_isUnit_right hb
    obtain ⟨vi, hvi, hvinu⟩ := hV (MvPolynomial.X i)
    have hXi : (MvPolynomial.X i : MvPolynomial (Fin (M + 1 + 1)) Γ(T, W)) ∈ p :=
      hIp (Ideal.mem_sup_left (Ideal.subset_span ⟨i, hiG, rfl⟩))
    have hrel : vi * v = w := by
      apply Subtype.ext
      have e2 : (wcpaDjAvChart q L W s' 0 (ρ 0)) (MvPolynomial.X i) = ρ 0 i := by
        simp only [wcpaDjAvChart, MvPolynomial.eval₂Hom_X']
      have hr := congrArg (fun z => (Y.presheaf.germ _ ξ hξha ≫ Y.residue ξ).hom z) (hρ 0 a i)
      simp only [map_mul, gr] at hr
      have e3 : ((vi * v : V) : Y.residueField ξ) = (vi : Y.residueField ξ) * v := rfl
      rw [e3, hvi, hv, hw, e2]
      exact hr
    exact hvinu hXi (isUnit_of_mul_isUnit_left (by rw [hrel]; exact hwunit))
  have hfin := (wcpa_dj_lcp_ra_bad_chart q L hL W (e' * k) s' hcomp ρ hρ G hgood 0 hbad).1
  have heq : (⨆ a, Y.basicOpen (s' 0 a)) = ⨆ a, Y.basicOpen (t a) :=
    iSup_congr fun a => Scheme.basicOpen_pow Y (t a) he'
  rw [heq] at hfin
  exact hfin

theorem wcpa_dj_lmga_mc_complement_affine : ∀ (Ω : Type u) [Field Ω] (W' : ValuationSubring Ω)
    (Z' : Scheme.{u}) (u' : Z' ⟶ Spec (.of ↥W')), wcpaDjSemistable u' →
    ∀ (r : ℕ) (σ : Fin r → (Spec (.of ↥W') ⟶ Z')), (∀ i, σ i ≫ u' = 𝟙 _) →
    (∀ i p, ∃ O : Z'.Opens, σ i p ∈ O ∧ SmoothOfRelativeDimension 1 (O.ι ≫ u')) →
    ∀ U' : Z'.Opens, (U' : Set Z') = (⋃ i, Set.range (σ i))ᶜ →
    IsAffineOpen (Limits.pullback.fst u'
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⁻¹ᵁ U') →
    IsAffineOpen U' :=
by
  intro Ω _ W' Z' u' hss r σ hσ hsm U' hU' hTR

  have core : ∀ (K : Type u) [Field K] [IsAlgClosed K] (W₂ : ValuationSubring K)
      (Z₂ : Scheme.{u}) (u₂ : Z₂ ⟶ Spec (.of ↥W₂)), wcpaDjSemistable u₂ →
      ∀ (σ₂ : Fin r → (Spec (.of ↥W₂) ⟶ Z₂)), (∀ i, σ₂ i ≫ u₂ = 𝟙 _) →
      (∀ i p, ∃ O : Z₂.Opens, σ₂ i p ∈ O ∧ SmoothOfRelativeDimension 1 (O.ι ≫ u₂)) →
      ∀ U₂ : Z₂.Opens, (U₂ : Set Z₂) = (⋃ i, Set.range (σ₂ i))ᶜ →
      IsAffineOpen (Limits.pullback.fst u₂
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂)))) ⁻¹ᵁ U₂) →
      IsAffineOpen U₂ := by
    intro K _ _ W₂ Z₂ u₂ hss₂ σ₂ hσ₂ hsm₂ U₂ hU₂ hTR₂
    classical
    haveI : IsProper u₂ := hss₂.2.1
    have hsep : IsSeparated u₂ := inferInstance
    have hlfp : LocallyOfFinitePresentation u₂ :=
      wcpa_dj_mn_flat_fp (Spec (.of ↥W₂)) Z₂ u₂ hss₂.1 inferInstance
    haveI : Z₂.IsSeparated := by
      refine ⟨?_⟩
      rw [show Limits.terminal.from Z₂ = u₂ ≫ Limits.terminal.from _ from
        Limits.terminal.hom_ext _ _]
      infer_instance
    have sec_pt : ∀ (τ : Spec (.of ↥W₂) ⟶ Z₂), τ ≫ u₂ = 𝟙 _ → ∀ p, u₂ (τ p) = p := by
      intro τ h p
      rw [← Scheme.Hom.comp_apply, h]
      rfl
    have closed_eq : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (q : PrimeSpectrum R),
        IsClosed ({q} : Set (PrimeSpectrum R)) → q = IsLocalRing.closedPoint R := by
      intro R _ _ q hq
      have hm := (PrimeSpectrum.isClosed_singleton_iff_isMaximal q).mp hq
      ext1
      exact IsLocalRing.eq_maximalIdeal hm
    haveI hρci : IsClosedImmersion (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂)))) :=
      IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
    have hcp : ∀ y, u₂ (Limits.pullback.fst u₂
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂)))) y) =
        IsLocalRing.closedPoint ↥W₂ := by
      intro y
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
      apply closed_eq
      have hc : IsClosed ({Limits.pullback.snd u₂
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂)))) y} :
            Set ↥(Spec (.of (IsLocalRing.ResidueField ↥W₂)))) := by
        refine (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mpr ?_
        have hq := @Ideal.eq_bot_of_prime _ _ _ (Limits.pullback.snd u₂
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂))))
            y).isPrime
        rw [hq]
        exact Ideal.bot_isMaximal
      have := (Scheme.Hom.isClosedEmbedding (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂))))).isClosedMap _ hc
      rw [Set.image_singleton] at this
      exact this

    obtain ⟨n, S, hn, hdisj, hrep, hcov⟩ := wcpa_dj_lmga_ca_families ↥W₂ Z₂ u₂ hsep r σ₂ hσ₂
    let D : Fin n → Set Z₂ := fun k => ⋃ i ∈ S k, Set.range (σ₂ i)
    have hDcl : ∀ k, IsClosed (D k) := fun k => isClosed_biUnion_finset (fun i _ =>
      (wcpa_dj_lmga_mc_section_facts ↥W₂ Z₂ u₂ hsep (σ₂ i) (σ₂ i) (hσ₂ i) (hσ₂ i)).1)
    let Uk : Fin n → Z₂.Opens := fun k => ⟨(D k)ᶜ, (hDcl k).isOpen_compl⟩

    have hUk : ∀ k, IsAffineOpen (Uk k) := by
      intro k
      let m := (S k).card
      let ε : Fin m → (Spec (.of ↥W₂) ⟶ Z₂) := fun l => σ₂ ((S k).equivFin.symm l)
      have hε : (⋃ l, Set.range (ε l)) = D k := by
        ext z
        simp only [Set.mem_iUnion, D, ε]
        constructor
        · rintro ⟨l, hl⟩
          exact ⟨_, ((S k).equivFin.symm l).2, hl⟩
        · rintro ⟨i, hi, hz⟩
          refine ⟨(S k).equivFin ⟨i, hi⟩, ?_⟩
          rw [Equiv.symm_apply_apply]
          exact hz
      have hsecs : wcpaDjSections u₂ m ε := by
        refine ⟨fun l => hσ₂ _, ?_, fun l p => hsm₂ _ p⟩
        intro l l' p q hll'
        apply hdisj k _ ((S k).equivFin.symm l).2 _ ((S k).equivFin.symm l').2
        intro h
        apply hll'
        exact (S k).equivFin.symm.injective (Subtype.ext h)
      obtain ⟨L, t, hOK, hcomp, hbo⟩ :=
        wcpa_dj_lsp_divisor_cocycle u₂ m ε hsep inferInstance inferInstance hsecs
      have hchart : (⨆ a, Z₂.basicOpen (t a)) = Uk k := by
        apply le_antisymm
        · refine iSup_le fun a => ?_
          intro x hx
          have hx' : x ∈ (Z₂.basicOpen (t a) : Set Z₂) := hx
          rw [hbo a, hε] at hx'
          exact hx'.2
        · intro x hx
          have hxV : x ∈ ⨆ a, L.V a := by rw [hOK.2.1]; trivial
          obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hxV
          refine TopologicalSpace.Opens.mem_iSup.mpr ⟨a, ?_⟩
          show x ∈ (Z₂.basicOpen (t a) : Set Z₂)
          rw [hbo a, hε, Scheme.Hom.preimage_top, inf_top_eq]
          exact ⟨ha, hx⟩
      have hkey : ∀ z : Z₂, u₂ z = IsLocalRing.closedPoint ↥W₂ →
          (z ∈ D k ↔ z ∈ ⋃ i, Set.range (σ₂ i)) := by
        intro z hz
        constructor
        · intro h
          simp only [D, Set.mem_iUnion] at h ⊢
          obtain ⟨i, _, hi⟩ := h
          exact ⟨i, hi⟩
        · intro h
          simp only [D, Set.mem_iUnion] at h ⊢
          obtain ⟨j, p, hp⟩ := h
          have hp' : p = IsLocalRing.closedPoint ↥W₂ := by
            rw [← sec_pt (σ₂ j) (hσ₂ j) p, hp, hz]
          obtain ⟨i, hi, hij⟩ := hrep k j
          exact ⟨i, hi, IsLocalRing.closedPoint ↥W₂, by rw [hij, ← hp', hp]⟩
      have heq : Limits.pullback.fst u₂
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂)))) ⁻¹ᵁ Uk k =
          Limits.pullback.fst u₂
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂)))) ⁻¹ᵁ U₂ := by
        apply le_antisymm
        · intro y hy
          have h1 : Limits.pullback.fst u₂ (Spec.map (CommRingCat.ofHom
              (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂)))) y ∉ D k := hy
          show Limits.pullback.fst u₂ (Spec.map (CommRingCat.ofHom
              (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂)))) y ∈ (U₂ : Set Z₂)
          rw [hU₂]
          exact fun h => h1 ((hkey _ (hcp y)).mpr h)
        · intro y hy
          have h1 : Limits.pullback.fst u₂ (Spec.map (CommRingCat.ofHom
              (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂)))) y ∈ (U₂ : Set Z₂) := hy
          rw [hU₂] at h1
          show Limits.pullback.fst u₂ (Spec.map (CommRingCat.ofHom
              (algebraMap ↥W₂ (IsLocalRing.ResidueField ↥W₂)))) y ∉ D k
          exact fun h => h1 ((hkey _ (hcp y)).mp h)
      have hCOV := wcpa_dj_lmga_ca_trace_cov K W₂ Z₂ u₂ inferInstance m ε (fun l => hσ₂ _)
        (Uk k) (by rw [hε]; rfl) (by rw [heq]; exact hTR₂)
      obtain ⟨e, he, hamp⟩ :=
        wcpa_dj_lsp_fibre_amp K W₂ Z₂ u₂ m ε L t hss₂ hsecs hCOV hOK hcomp hbo
      obtain ⟨e', he', hamp'⟩ :=
        wcpa_dj_lsp_spread_amp ↥W₂ Z₂ u₂ inferInstance hlfp L hOK e he hamp
      have hfin := wcpa_dj_lmga_ca_amp_chart_affine u₂ inferInstance L hOK ⊤ (isAffineOpen_top _)
        (fun a => by rw [Scheme.Hom.preimage_top, inf_top_eq]; exact hOK.1 a)
        e' he' hamp' 1 one_pos t hcomp
      rw [hchart] at hfin
      exact hfin

    have hne : (Finset.univ : Finset (Fin n)).Nonempty := ⟨⟨0, hn⟩, Finset.mem_univ _⟩
    have hinf : IsAffineOpen (Finset.univ.inf' hne Uk) := by
      apply Finset.inf'_induction
      · intro a ha b hb
        exact ha.inf hb
      · intro k _
        exact hUk k
    have hEq : U₂ = Finset.univ.inf' hne Uk := by
      apply le_antisymm
      · refine Finset.le_inf' hne Uk (fun k _ => ?_)
        intro x hx
        have h1 : x ∉ ⋃ i, Set.range (σ₂ i) := by
          rw [← Set.mem_compl_iff, ← hU₂]
          exact hx
        show x ∉ D k
        intro h
        apply h1
        simp only [D, Set.mem_iUnion] at h ⊢
        obtain ⟨i, _, hi⟩ := h
        exact ⟨i, hi⟩
      · intro x hx
        show x ∈ (U₂ : Set Z₂)
        rw [hU₂]
        intro h
        simp only [Set.mem_iUnion] at h
        obtain ⟨j, hj⟩ := h
        obtain ⟨k, hk⟩ := hcov j
        have h2 : x ∉ D k := Finset.inf'_le Uk (Finset.mem_univ k) hx
        apply h2
        simp only [D, Set.mem_iUnion]
        exact ⟨j, hk, hj⟩
    rw [hEq]
    exact hinf

  obtain ⟨W₂, ι, _hιval, hloc, hff⟩ := wcpa_dj_lmga_ca_ff_extension Ω W'
  obtain ⟨σ₂, hσ₂, hsm₂, hU₂set, hTR₂⟩ := wcpa_dj_lmga_ca_basechange Ω (AlgebraicClosure Ω) W' W₂
    ι hloc Z' u' r σ hσ hsm U' hU' hTR
  have hss₂ := wcpa_dj_mm_semistable_basechange _ _ _ (Spec.map (CommRingCat.ofHom ι)) u' hss
  have hU₂aff : IsAffineOpen (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι)) ⁻¹ᵁ U') :=
    core (AlgebraicClosure Ω) W₂ _ _ hss₂ σ₂ hσ₂ hsm₂ _ hU₂set hTR₂

  have hP : IsPullback (Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι)) ∣_ U')
      ((Limits.pullback.fst u' (Spec.map (CommRingCat.ofHom ι)) ⁻¹ᵁ U').ι ≫
