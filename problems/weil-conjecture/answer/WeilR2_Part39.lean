        (X.presheaf.map (homOfLE h1).op).hom ((L.g a b : Γ(X, L.V a ⊓ L.V b)) ^ d) *
          (X.presheaf.map (homOfLE h2).op).hom ((L.g b e : Γ(X, L.V b ⊓ L.V e)) ^ d) =
        (X.presheaf.map (homOfLE h3).op).hom ((L.g a e : Γ(X, L.V a ⊓ L.V e)) ^ d) := by
      intro a b e W h1 h2 h3
      have hW : W ≤ L.V a ⊓ L.V b ⊓ L.V e := le_inf h1 (h2.trans inf_le_right)
      have e0 := congrArg (X.presheaf.map (homOfLE hW).op).hom (hL.2.2.2 a b e)
      rw [map_mul, resX, resX, resX] at e0
      rw [map_pow, map_pow, map_pow, ← mul_pow, e0]
    have hgaa : ∀ a, (L.g a a : Γ(X, L.V a ⊓ L.V a)) ^ d = 1 := by
      intro a
      rw [hL.2.2.1 a, Units.val_one, one_pow]
    have ymem : ∀ a, ∃ e : Γ(G, L.V a),
        π (L.V a) e = fun j => (L.g a j : Γ(X, L.V a ⊓ L.V j)) ^ d := by
      intro a
      refine (P2 (L.V a) _).mpr ?_
      intro j l
      beta_reduce
      rw [mul_comm]
      exact (H2' a l j _ _ _).symm
    choose ε hε using ymem
    have hrel : ∀ a b, (G.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ L.V b ≤ L.V a)).op).hom (ε a) =
        (L.g a b : Γ(X, L.V a ⊓ L.V b)) ^ d •
          (G.presheaf.map (homOfLE (inf_le_right : L.V a ⊓ L.V b ≤ L.V b)).op).hom (ε b) := by
      intro a b
      apply P1
      funext j
      rw [P4, P5, P5, hε, hε]
      beta_reduce
      exact (H2' a b j _ _ _).symm
    have hbij : ∀ a (V : X.Opens) (hV : V ≤ L.V a),
        Function.Bijective (fun r : Γ(X, V) => r • (G.presheaf.map (homOfLE hV).op).hom (ε a)) := by
      intro a V hV
      have dag : ∀ (r : Γ(X, V)) (j : Fin L.m),
          π V (r • (G.presheaf.map (homOfLE hV).op).hom (ε a)) j =
          (X.presheaf.map (homOfLE (inf_le_left : V ⊓ L.V j ≤ V)).op).hom r *
          (X.presheaf.map (homOfLE (inf_le_inf_right (L.V j) hV)).op).hom
            ((L.g a j : Γ(X, L.V a ⊓ L.V j)) ^ d) := by
        intro r j
        rw [P4, P5, hε]
      constructor
      · intro r1 r2 h12
        beta_reduce at h12
        have h1 := dag r1 a
        have h2 := dag r2 a
        rw [h12, h2, hgaa, map_one, mul_one, mul_one] at h1
        have h3 := congrArg (X.presheaf.map (homOfLE (le_inf le_rfl hV : V ≤ V ⊓ L.V a)).op).hom h1
        rw [resX, resX, resId, resId] at h3
        exact h3.symm
      · intro z
        refine ⟨(X.presheaf.map (homOfLE (le_inf le_rfl hV : V ≤ V ⊓ L.V a)).op).hom (π V z a), ?_⟩
        apply P1
        funext j
        beta_reduce
        rw [dag, resX]
        have hz := (P2 V (π V z)).mp ⟨z, rfl⟩ j a
        beta_reduce at hz
        have hle : V ⊓ L.V j ≤ (V ⊓ L.V j) ⊓ (V ⊓ L.V a) :=
          le_inf le_rfl (le_inf inf_le_left (inf_le_left.trans hV))
        have h3 := congrArg (X.presheaf.map (homOfLE hle).op).hom hz
        rw [map_mul, resX, resX, resX, resId] at h3
        rw [h3, mul_comm]
    have hcover : ∀ z : X, ∃ a, z ∈ L.V a := by
      intro z
      have hz : z ∈ (⨆ a, L.V a) := by rw [hL.2.1]; trivial
      exact TopologicalSpace.Opens.mem_iSup.mp hz
    have hcoh : wcCoherentMod G := by
      apply wc_cn_locfree_coherent X G
      intro z
      obtain ⟨a, ha⟩ := hcover z
      refine ⟨L.V a, 1, fun _ => ε a, ha, hL.1 a, fun V hV => ?_⟩
      have hb := (hbij a V hV).comp (Equiv.funUnique (Fin 1) Γ(X, V)).bijective
      convert hb using 1
      funext a'
      simp [Fin.sum_univ_one, Equiv.funUnique_apply]
    obtain ⟨Gs, ψ, φ, -, halg⟩ := wc_cn_quotient_system_of_coherent B I X h G hcoh
    obtain ⟨c, hc⟩ := wc_cn_rml_level_lift_single B I X h Gs ψ G φ halg L.m L.V hL.1 hcover hpair
    refine ⟨c, fun x hx => ?_⟩
    have hnat : ∀ (N N' : X.Modules) (g : N ⟶ N') (W W' : X.Opens) (hle : W' ≤ W) (z : Γ(N, W)),
        Scheme.Modules.Hom.app g W' ((N.presheaf.map (homOfLE hle).op).hom z) =
          (N'.presheaf.map (homOfLE hle).op).hom (Scheme.Modules.Hom.app g W z) :=
      fun N N' g W W' hle z => PresheafOfModules.naturality_apply g.val (homOfLE hle).op z
    have resG : ∀ (N : X.Modules) {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (z : Γ(N, A)),
        (N.presheaf.map (homOfLE h2).op).hom ((N.presheaf.map (homOfLE h1).op).hom z) =
        (N.presheaf.map (homOfLE (h2.trans h1)).op).hom z := by
      intro N A B C h1 h2 z
      change (N.presheaf.map (homOfLE h1).op ≫ N.presheaf.map (homOfLE h2).op).hom z = _
      rw [← Functor.map_comp]
      rfl
    have resIdG : ∀ {A : X.Opens} (hA : A ≤ A) (z : Γ(G, A)),
        (G.presheaf.map (homOfLE hA).op).hom z = z := by
      intro A hA z
      change (G.presheaf.map (𝟙 (Opposite.op A))).hom z = z
      rw [CategoryTheory.Functor.map_id]
      rfl
    have hms : ∀ {A B : X.Opens} (hle : B ≤ A) (r : Γ(X, A)) (z : Γ(G, A)),
        (G.presheaf.map (homOfLE hle).op).hom (r • z) =
          (X.presheaf.map (homOfLE hle).op).hom r • (G.presheaf.map (homOfLE hle).op).hom z :=
      fun hle r z => Scheme.Modules.map_smul G (homOfLE hle) r z
    have compA : ∀ {M N K : X.Modules} (g : M ⟶ N) (g' : N ⟶ K) (W : X.Opens)
        (z : Γ(M, W)), Scheme.Modules.Hom.app (g ≫ g') W z =
          Scheme.Modules.Hom.app g' W (Scheme.Modules.Hom.app g W z) := by
      intro M N K g g' W z
      rw [Scheme.Modules.Hom.comp_app]
      rfl
    have idA : ∀ (M : X.Modules) (W : X.Opens) (z : Γ(M, W)),
        Scheme.Modules.Hom.app (𝟙 M) W z = z := by
      intro M W z
      rw [Scheme.Modules.Hom.id_app]
      rfl
    have hstep : ∀ (k : ℕ) (W : X.Opens) (z : Γ(G, W)),
        Scheme.Modules.Hom.app (ψ k) W (Scheme.Modules.Hom.app (φ (k + 1)) W z) =
          Scheme.Modules.Hom.app (φ k) W z := by
      intro k W z
      rw [← compA, halg.2.1 k]
    have hTφ : ∀ (W : X.Opens) (k : ℕ) (z : Γ(G, W)),
        Scheme.Modules.Hom.app (wcCnTrans ψ 0 k) W (Scheme.Modules.Hom.app (φ (0 + k)) W z) =
          Scheme.Modules.Hom.app (φ 0) W z := by
      intro W k
      induction k with
      | zero =>
        intro z
        show Scheme.Modules.Hom.app (𝟙 (Gs 0)) W (Scheme.Modules.Hom.app (φ 0) W z) = _
        rw [idA]
      | succ k ih =>
        intro z
        show Scheme.Modules.Hom.app (ψ (0 + k) ≫ wcCnTrans ψ 0 k) W
            (Scheme.Modules.Hom.app (φ (0 + k + 1)) W z) = _
        rw [compA, hstep, ih]
    let yv : ∀ a, Γ(Gs (0 + c), L.V a) := fun a =>
      Scheme.Modules.Hom.app (φ (0 + c)) (L.V a) (x a • ε a)
    have hD : ∀ a b,
        (G.presheaf.map (homOfLE (inf_le_right : L.V a ⊓ L.V b ≤ L.V b)).op).hom (x b • ε b) -
        (G.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ L.V b ≤ L.V a)).op).hom (x a • ε a) =
        ((X.presheaf.map (homOfLE (inf_le_right : L.V a ⊓ L.V b ≤ L.V b)).op).hom (x b) -
          (L.g a b : Γ(X, L.V a ⊓ L.V b)) ^ d *
          (X.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ L.V b ≤ L.V a)).op).hom (x a)) •
        (G.presheaf.map (homOfLE (inf_le_right : L.V a ⊓ L.V b ≤ L.V b)).op).hom (ε b) := by
      intro a b
      rw [hms, hms, hrel, smul_smul, sub_smul, mul_comm]
    have hcompat : ∀ a b,
        ((Gs (0 + c)).presheaf.map (homOfLE (inf_le_left : L.V a ⊓ L.V b ≤ L.V a)).op).hom (yv a) =
        ((Gs (0 + c)).presheaf.map (homOfLE (inf_le_right : L.V a ⊓ L.V b ≤ L.V b)).op).hom (yv b) := by
      intro a b
      have hmem :
          (G.presheaf.map (homOfLE (inf_le_right : L.V a ⊓ L.V b ≤ L.V b)).op).hom (x b • ε b) -
          (G.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ L.V b ≤ L.V a)).op).hom (x a • ε a) ∈
          Ideal.map (wcCnSigma h (L.V a ⊓ L.V b)) (I ^ (0 + c + 1)) •
            (⊤ : Submodule Γ(X, L.V a ⊓ L.V b) Γ(G, L.V a ⊓ L.V b)) := by
        rw [hD]
        refine Submodule.smul_mem_smul ?_ Submodule.mem_top
        rw [zero_add]
        exact hx a b
      have hk := ((halg.2.2 (0 + c) _ (hpair a b)).2 _).mpr hmem
      rw [map_sub, sub_eq_zero, hnat, hnat] at hk
      exact hk.symm
    have hcov' : (⊤ : X.Opens) ≤ iSup L.V := by
      intro z _
      rw [TopologicalSpace.Opens.mem_iSup]
      exact hcover z
    obtain ⟨Y, hY, -⟩ := TopCat.Sheaf.existsUnique_gluing'
      (⟨(Gs (0 + c)).presheaf, (Gs (0 + c)).isSheaf⟩ : TopCat.Sheaf Ab X) L.V ⊤
      (fun a => homOfLE le_top) hcov' yv (fun a b => hcompat a b)
    have hY' : ∀ a, ((Gs (0 + c)).presheaf.map (homOfLE (le_top : L.V a ≤ ⊤)).op).hom Y = yv a := hY
    obtain ⟨s₀, hs₀⟩ := hc c le_rfl 0 Y
    have hφs : ∀ a, Scheme.Modules.Hom.app (φ 0) (L.V a)
        ((G.presheaf.map (homOfLE (le_top : L.V a ≤ ⊤)).op).hom s₀) =
        Scheme.Modules.Hom.app (φ 0) (L.V a) (x a • ε a) := by
      intro a
      rw [hnat, hs₀, ← hnat, hY', ← hTφ (L.V a) c (x a • ε a)]
    have hb0 : ∀ a, Function.Bijective (fun r : Γ(X, L.V a) => r • ε a) := by
      intro a
      have e : (fun r : Γ(X, L.V a) => r • ε a) =
          (fun r : Γ(X, L.V a) => r • (G.presheaf.map (homOfLE (le_refl (L.V a))).op).hom (ε a)) := by
        funext r
        rw [resIdG]
      rw [e]
      exact hbij a (L.V a) le_rfl
    choose s hs using fun a => (hb0 a).2 ((G.presheaf.map (homOfLE (le_top : L.V a ≤ ⊤)).op).hom s₀)
    have hs' : ∀ a, s a • ε a = (G.presheaf.map (homOfLE (le_top : L.V a ≤ ⊤)).op).hom s₀ := hs
    refine ⟨s, fun a b => ?_, fun a => ?_⟩
    · have heq : (X.presheaf.map (homOfLE (inf_le_right : L.V a ⊓ L.V b ≤ L.V b)).op).hom (s b) =
          (L.g a b : Γ(X, L.V a ⊓ L.V b)) ^ d *
          (X.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ L.V b ≤ L.V a)).op).hom (s a) := by
        apply (hbij b (L.V a ⊓ L.V b) inf_le_right).1
        show _ • _ = _ • _
        rw [← hms, hs', resG, mul_comm, ← smul_smul, ← hrel, ← hms, hs', resG]
      rw [heq, sub_self]
      exact Ideal.zero_mem _
    · have hw : (G.presheaf.map (homOfLE (le_top : L.V a ≤ ⊤)).op).hom s₀ - x a • ε a =
          (s a - x a) • ε a := by
        rw [← hs', sub_smul]
      have hk0 : Scheme.Modules.Hom.app (φ 0) (L.V a) ((s a - x a) • ε a) = 0 := by
        rw [← hw, map_sub, hφs a, sub_self]
      have hker := ((halg.2.2 0 (L.V a) (hL.1 a)).2 _).mp hk0
      have hI : I ^ (0 + 1) = I := by rw [zero_add, pow_one]
      rw [hI] at hker
      obtain ⟨j, hj, hjeq⟩ : ∃ j ∈ Ideal.map (wcCnSigma h (L.V a)) I,
          (s a - x a) • ε a = j • ε a := by
        refine Submodule.smul_induction_on
          (p := fun w => ∃ j ∈ Ideal.map (wcCnSigma h (L.V a)) I, w = j • ε a) hker ?_ ?_
        · intro r hr n _
          obtain ⟨r', hr'⟩ := (hb0 a).2 n
          refine ⟨r * r', Ideal.mul_mem_right r' _ hr, ?_⟩
          rw [← smul_smul]
          exact congrArg (r • ·) hr'.symm
        · rintro x1 x2 ⟨j1, hj1, rfl⟩ ⟨j2, hj2, rfl⟩
          exact ⟨j1 + j2, Ideal.add_mem _ hj1 hj2, (add_smul _ _ _).symm⟩
      have hsj := (hb0 a).1 hjeq
      rw [hsj]
      exact hj

theorem wcpa_dj_lsa_ll_fibre_transport : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (X X₀ : Scheme.{u}) (h : X ⟶ Spec (.of B)) (i : X₀ ⟶ X) (h₀ : X₀ ⟶ Spec (.of (IsLocalRing.ResidueField B))), IsPullback i h₀ h (Spec.map (CommRingCat.ofHom (algebraMap B (IsLocalRing.ResidueField B)))) → ∀ L : wcpaDjCoc X, (∀ a, IsAffineOpen (L.V a)) → (∀ a b, IsAffineOpen (L.V a ⊓ L.V b)) → (∀ (d : ℕ) (τ : ∀ a : Fin L.m, Γ(X₀, (wcpaDjCocPull i L).V a ⊓ h₀ ⁻¹ᵁ ⊤)), wcpaDjCompat (wcpaDjCocPull i L) (h₀ ⁻¹ᵁ ⊤) d τ → ∃ x : ∀ a : Fin L.m, Γ(X, L.V a), wcpaDjCompatMod h L (IsLocalRing.maximalIdeal B) d x ∧ ∀ a (hle : (wcpaDjCocPull i L).V a ⊓ h₀ ⁻¹ᵁ ⊤ ≤ i ⁻¹ᵁ L.V a), (i.appLE (L.V a) ((wcpaDjCocPull i L).V a ⊓ h₀ ⁻¹ᵁ ⊤) hle).hom (x a) = τ a) ∧ (∀ (a : Fin L.m) (x x' : Γ(X, L.V a)), x' - x ∈ Ideal.map (wcCnSigma h (L.V a)) (IsLocalRing.maximalIdeal B) → ∀ hle : (wcpaDjCocPull i L).V a ⊓ h₀ ⁻¹ᵁ ⊤ ≤ i ⁻¹ᵁ L.V a, (i.appLE (L.V a) ((wcpaDjCocPull i L).V a ⊓ h₀ ⁻¹ᵁ ⊤) hle).hom x' = (i.appLE (L.V a) ((wcpaDjCocPull i L).V a ⊓ h₀ ⁻¹ᵁ ⊤) hle).hom x) :=
by
  intro B _ _ X X₀ h i h₀ hpb L hWa hWab
  classical

  have s1 : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (X X₀ : Scheme.{u})
      (h : X ⟶ Spec (.of B)) (i : X₀ ⟶ X) (h₀ : X₀ ⟶ Spec (.of (IsLocalRing.ResidueField B))),
      IsPullback i h₀ h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) →
      ∀ W : X.Opens, IsAffineOpen W → Function.Surjective (i.app W).hom ∧
        RingHom.ker (i.app W).hom = Ideal.map (wcCnSigma h W) (IsLocalRing.maximalIdeal B) := by
    intro B _ _ X X₀ h i h₀ hpb W hW
    haveI : IsClosedImmersion (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) :=
      IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
    haveI : IsClosedImmersion i :=
      MorphismProperty.of_isPullback (P := @IsClosedImmersion) hpb.flip ‹_›
    refine ⟨Scheme.Hom.app_surjective i W hW, le_antisymm ?_ ?_⟩
    · intro r hr
      set I := Ideal.map (wcCnSigma h W) (IsLocalRing.maximalIdeal B) with hI
      let q : Γ(X, W) →+* Γ(X, W) ⧸ I := Ideal.Quotient.mk I
      let qκ : IsLocalRing.ResidueField B →+* Γ(X, W) ⧸ I :=
        Ideal.quotientMap I (wcCnSigma h W) Ideal.le_comap_map
      set t : Spec (.of (Γ(X, W) ⧸ I)) ⟶ X := Spec.map (CommRingCat.ofHom q) ≫ hW.fromSpec
        with ht_def
      have ht : t ≫ h = Spec.map (CommRingCat.ofHom qκ) ≫
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)) := by
        rw [ht_def, Category.assoc, ← IsAffineOpen.SpecMap_appLE_fromSpec h (isAffineOpen_top _) hW
          le_top, IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv, ← Spec.map_comp,
          ← Spec.map_comp, ← Spec.map_comp]
        congr 1
      let t' := hpb.lift t (Spec.map (CommRingCat.ofHom qκ)) ht
      have ht' : t' ≫ i = t := hpb.lift_fst _ _ _
      have e : ⊤ ≤ t ⁻¹ᵁ W := by
        intro x _
        have : Spec.map (CommRingCat.ofHom q) x ∈ hW.fromSpec ⁻¹ᵁ W := by
          rw [hW.fromSpec_preimage_self]; trivial
        exact this
      have hzero : ∀ (φ : Spec (.of (Γ(X, W) ⧸ I)) ⟶ X) (_ : t' ≫ i = φ) (e' : ⊤ ≤ φ ⁻¹ᵁ W),
          (φ.appLE W ⊤ e').hom r = 0 := by
        rintro φ rfl e'
        rw [← Scheme.Hom.appLE_comp_appLE t' i W (i ⁻¹ᵁ W) ⊤ le_rfl e', CommRingCat.comp_apply,
          ← Scheme.Hom.app_eq_appLE]
        rw [RingHom.mem_ker.mp hr, map_zero]
      have hcomp : t.appLE W ⊤ e =
          CommRingCat.ofHom q ≫ (Scheme.ΓSpecIso (.of (Γ(X, W) ⧸ I))).inv := by
        rw [Scheme.ΓSpecIso_inv_naturality, Scheme.Hom.comp_appLE, hW.fromSpec_app_self,
          Category.assoc]
        congr 1
      have h1 := hzero t ht' e
      rw [hcomp, CommRingCat.comp_apply] at h1
      have h2 : q r = 0 := by
        have := congrArg (Scheme.ΓSpecIso (.of (Γ(X, W) ⧸ I))).hom.hom h1
        rwa [Iso.inv_hom_id_apply, map_zero] at this
      exact Ideal.Quotient.eq_zero_iff_mem.mp h2
    · rw [Ideal.map_le_iff_le_comap]
      intro b hb
      rw [Ideal.mem_comap, RingHom.mem_ker]
      have e1 : X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op ≫ i.app W =
          i.appTop ≫ X₀.presheaf.map (homOfLE (le_top : i ⁻¹ᵁ W ≤ ⊤)).op :=
        Scheme.Hom.naturality _ _
      have e2 : h.appTop ≫ i.appTop =
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))).appTop ≫ h₀.appTop := by
        rw [← Scheme.Hom.comp_appTop, hpb.w, Scheme.Hom.comp_appTop]
      have e3 : (Scheme.ΓSpecIso (.of B)).inv ≫
          (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))).appTop =
          CommRingCat.ofHom (IsLocalRing.residue B) ≫ (Scheme.ΓSpecIso _).inv :=
        (Scheme.ΓSpecIso_inv_naturality _).symm
      have e4 : (Scheme.ΓSpecIso (.of B)).inv ≫ h.appTop ≫
          X.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op ≫ i.app W =
          CommRingCat.ofHom (IsLocalRing.residue B) ≫ (Scheme.ΓSpecIso _).inv ≫ h₀.appTop ≫
            X₀.presheaf.map (homOfLE (le_top : i ⁻¹ᵁ W ≤ ⊤)).op := by
        rw [e1, ← Category.assoc h.appTop, e2, ← Category.assoc, ← Category.assoc, e3]
        simp only [Category.assoc]
      have key := congrArg (fun φ => φ.hom b) e4
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at key
      show (i.app W).hom ((X.presheaf.map (homOfLE le_top).op).hom
        (h.appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom b))) = 0
      rw [key]
      have hres : IsLocalRing.residue B b = 0 := (IsLocalRing.residue_eq_zero_iff b).mpr hb
      rw [CommRingCat.hom_ofHom, hres, map_zero, map_zero, map_zero]

  have hU : ∀ a, (wcpaDjCocPull i L).V a ⊓ h₀ ⁻¹ᵁ ⊤ = i ⁻¹ᵁ (L.V a) := by
    intro a
    show i ⁻¹ᵁ L.V a ⊓ h₀ ⁻¹ᵁ ⊤ = i ⁻¹ᵁ L.V a
    rw [Scheme.Hom.preimage_top, inf_top_eq]
  have hUab : ∀ a b, (wcpaDjCocPull i L).V a ⊓ (wcpaDjCocPull i L).V b ⊓
      h₀ ⁻¹ᵁ ⊤ = i ⁻¹ᵁ (L.V a ⊓ L.V b) := by
    intro a b
    show i ⁻¹ᵁ L.V a ⊓ i ⁻¹ᵁ L.V b ⊓ h₀ ⁻¹ᵁ ⊤ = i ⁻¹ᵁ L.V a ⊓ i ⁻¹ᵁ L.V b
    rw [Scheme.Hom.preimage_top, inf_top_eq]

  have hρ : ∀ (W : X.Opens), IsAffineOpen W → ∀ (U : X₀.Opens) (_ : U = i ⁻¹ᵁ W)
      (e : U ≤ i ⁻¹ᵁ W), Function.Surjective (i.appLE W U e).hom ∧
        RingHom.ker (i.appLE W U e).hom =
          Ideal.map (wcCnSigma h W) (IsLocalRing.maximalIdeal B) := by
    intro W hW U hUe e
    subst hUe
    have := s1 B X X₀ h i h₀ hpb W hW
    rwa [Scheme.Hom.app_eq_appLE] at this
  have hres : ∀ (W W' : X.Opens) (iW : W' ≤ W) (U U' : X₀.Opens) (iU : U' ≤ U)
      (e : U ≤ i ⁻¹ᵁ W) (e' : U' ≤ i ⁻¹ᵁ W') (z : Γ(X, W)),
      (i.appLE W' U' e').hom ((X.presheaf.map (homOfLE iW).op).hom z) =
        (X₀.presheaf.map (homOfLE iU).op).hom ((i.appLE W U e).hom z) := by
    intro W W' iW U U' iU e e' z
    have : X.presheaf.map (homOfLE iW).op ≫ i.appLE W' U' e' =
        i.appLE W U e ≫ X₀.presheaf.map (homOfLE iU).op := by
      rw [Scheme.Hom.map_appLE, Scheme.Hom.appLE_map]
    simpa only [CommRingCat.hom_comp, RingHom.comp_apply] using congrArg (fun φ => φ.hom z) this
  refine ⟨fun d τ hτ => ?_, fun a x x' hxx hle => ?_⟩
  ·
    have hsurj : ∀ a, ∃ x, (i.appLE _ _ (hU a).le).hom x = τ a :=
      fun a => (hρ _ (hWa a) _ (hU a) (hU a).le).1 (τ a)
    choose x hx using hsurj
    refine ⟨x, ?_, fun a _ => hx a⟩
    intro a b
    obtain ⟨_, hker⟩ := hρ _ (hWab a b) _ (hUab a b) (hUab a b).le
    rw [← hker, RingHom.mem_ker, map_sub, map_mul, map_pow]
    have e_b := hres (L.V b) (L.V a ⊓ L.V b) inf_le_right
      ((wcpaDjCocPull i L).V b ⊓ h₀ ⁻¹ᵁ ⊤)
      ((wcpaDjCocPull i L).V a ⊓ (wcpaDjCocPull i L).V b ⊓ h₀ ⁻¹ᵁ ⊤)
      (le_inf (inf_le_left.trans inf_le_right) inf_le_right) (hU b).le (hUab a b).le (x b)
    have e_a := hres (L.V a) (L.V a ⊓ L.V b) inf_le_left
      ((wcpaDjCocPull i L).V a ⊓ h₀ ⁻¹ᵁ ⊤)
      ((wcpaDjCocPull i L).V a ⊓ (wcpaDjCocPull i L).V b ⊓ h₀ ⁻¹ᵁ ⊤)
      (le_inf (inf_le_left.trans inf_le_left) inf_le_right) (hU a).le (hUab a b).le (x a)
    have egY : (wcpaDjCocPull i L).V a ⊓ (wcpaDjCocPull i L).V b ≤
        i ⁻¹ᵁ (L.V a ⊓ L.V b) := fun _ hx => hx
    have hgY : (X₀.presheaf.map (homOfLE (inf_le_left :
          (wcpaDjCocPull i L).V a ⊓ (wcpaDjCocPull i L).V b ⊓ h₀ ⁻¹ᵁ ⊤ ≤
            (wcpaDjCocPull i L).V a ⊓ (wcpaDjCocPull i L).V b)).op).hom
          ((wcpaDjCocPull i L).g a b :
            Γ(X₀, (wcpaDjCocPull i L).V a ⊓ (wcpaDjCocPull i L).V b)) =
        (i.appLE (L.V a ⊓ L.V b)
          ((wcpaDjCocPull i L).V a ⊓ (wcpaDjCocPull i L).V b ⊓ h₀ ⁻¹ᵁ ⊤)
          (hUab a b).le).hom (L.g a b : Γ(X, L.V a ⊓ L.V b)) :=
      congrArg (fun φ => φ.hom (L.g a b : Γ(X, L.V a ⊓ L.V b)))
        (Scheme.Hom.appLE_map i egY (homOfLE (inf_le_left :
          (wcpaDjCocPull i L).V a ⊓ (wcpaDjCocPull i L).V b ⊓ h₀ ⁻¹ᵁ ⊤ ≤
            (wcpaDjCocPull i L).V a ⊓ (wcpaDjCocPull i L).V b)).op)
    rw [e_b, hx b, e_a, hx a, hτ a b, map_pow, hgY]
    exact sub_self _
  ·
    obtain ⟨_, hker⟩ := hρ _ (hWa a) _ (hU a) hle
    rw [← hker, RingHom.mem_ker, map_sub, sub_eq_zero] at hxx
    exact hxx

theorem wcpa_dj_lsa_lift_local : ∀ (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of A)), IsProper u₁ → ∀ L₁ : wcpaDjCoc Z₁, wcpaDjCocOK L₁ → ∀ e : ℕ, 0 < e → wcpaDjVA (Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) (wcpaDjCocPull (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) L₁) ⊤ e → ∃ m : ℕ, 1 ≤ m ∧ ∀ (M : ℕ) (τ : Fin (M + 1) → ∀ a : Fin L₁.m, Γ(Limits.pullback u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))), (wcpaDjCocPull (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) L₁).V a ⊓ Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ ⊤)), (∀ J, wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) L₁) (Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ ⊤) (e * m) (τ J)) → ∃ σ : Fin (M + 1) → ∀ a : Fin L₁.m, Γ(Z₁, L₁.V a ⊓ u₁ ⁻¹ᵁ ⊤), (∀ J, wcpaDjCompat L₁ (u₁ ⁻¹ᵁ ⊤) (e * m) (σ J)) ∧ ∀ J a, ∃ h, ((Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).appLE (L₁.V a ⊓ u₁ ⁻¹ᵁ ⊤) ((wcpaDjCocPull (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) L₁).V a ⊓ Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ ⊤) h).hom (σ J a) = τ J a :=
by
  intro A _ _ _ Z₁ u₁ hu₁ L₁ hOK e he hVA
  classical
  haveI : IsProper u₁ := hu₁
  haveI : IsLocallyNoetherian Z₁ := LocallyOfFiniteType.isLocallyNoetherian u₁
  haveI : CompactSpace Z₁ := QuasiCompact.compactSpace_of_compactSpace u₁
  have hNoeth : AlgebraicGeometry.IsNoetherian Z₁ := by
    first
      | infer_instance
      | exact @AlgebraicGeometry.IsNoetherian.mk _ inferInstance inferInstance
  have hpair : ∀ a b, IsAffineOpen (L₁.V a ⊓ L₁.V b) := by
    intro a b
    haveI : IsAffine (L₁.V a).toScheme := hOK.1 a
    haveI : IsAffineHom ((L₁.V a).ι ≫ u₁) := isAffineHom_of_isAffine _
    haveI : IsAffineHom (L₁.V a).ι := IsAffineHom.of_comp _ u₁
    have h1 := ((hOK.1 b).preimage (L₁.V a).ι).image_of_isOpenImmersion (L₁.V a).ι
    rwa [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι] at h1
  have red0 : ∀ {U₁ U₂ U₃ : Z₁.Opens} (i : U₂ ≤ U₁) (j : U₃ ≤ U₂) (z : Γ(Z₁, U₁)),
      (Z₁.presheaf.map (homOfLE j).op).hom ((Z₁.presheaf.map (homOfLE i).op).hom z) =
        (Z₁.presheaf.map (homOfLE (j.trans i)).op).hom z := by
    intro U₁ U₂ U₃ i j z
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  obtain ⟨m, hm, hstep⟩ := wcpa_dj_lsa_ll_uniform_step A Z₁ u₁ hu₁ L₁ hOK e he hVA
  obtain ⟨c, hAR⟩ := wcpa_dj_lsa_ll_artin_rees A inferInstance (IsLocalRing.maximalIdeal A) Z₁
    hNoeth u₁ hu₁ L₁ hOK hpair (e * m)
  obtain ⟨hFA, hFB⟩ := wcpa_dj_lsa_ll_fibre_transport A Z₁ _ u₁ _ _
    (IsPullback.of_hasPullback u₁
      (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) L₁ hOK.1 hpair
  refine ⟨m, hm, ?_⟩
  intro M τ hτ
  have key : ∀ J, ∃ s : ∀ a : Fin L₁.m, Γ(Z₁, L₁.V a),
      wcpaDjCompatMod u₁ L₁ ⊥ (e * m) s ∧
      ∀ a (hle : (wcpaDjCocPull (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
          (algebraMap A (IsLocalRing.ResidueField A))))) L₁).V a ⊓
          Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom
            (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ ⊤ ≤
          Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
            (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ L₁.V a),
        ((Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
          (algebraMap A (IsLocalRing.ResidueField A))))).appLE (L₁.V a)
          ((wcpaDjCocPull (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
            (algebraMap A (IsLocalRing.ResidueField A))))) L₁).V a ⊓
            Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom
              (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ ⊤) hle).hom (s a) = τ J a := by
    intro J
    obtain ⟨x0, hx0c, hx0τ⟩ := hFA (e * m) (τ J) (hτ J)
    have P : ∀ n : ℕ, ∃ x : ∀ a : Fin L₁.m, Γ(Z₁, L₁.V a),
        wcpaDjCompatMod u₁ L₁ (IsLocalRing.maximalIdeal A ^ (n + 1)) (e * m) x ∧
        ∀ a, x a - x0 a ∈ Ideal.map (wcCnSigma u₁ (L₁.V a)) (IsLocalRing.maximalIdeal A) := by
      intro n
      induction n with
      | zero =>
        refine ⟨x0, ?_, fun a => ?_⟩
        · rw [zero_add, pow_one]; exact hx0c
        · rw [sub_self]; exact Ideal.zero_mem _
      | succ n ih =>
        obtain ⟨x, hxc, hxd⟩ := ih
        obtain ⟨x', hx'd, hx'c⟩ := hstep n x hxc
        refine ⟨x', hx'c, fun a => ?_⟩
        have h1 : x' a - x a ∈ Ideal.map (wcCnSigma u₁ (L₁.V a)) (IsLocalRing.maximalIdeal A) :=
          Ideal.map_mono (Ideal.pow_le_self (Nat.succ_ne_zero n)) (hx'd a)
        rw [← sub_add_sub_cancel (x' a) (x a) (x0 a)]
        exact Ideal.add_mem _ h1 (hxd a)
    obtain ⟨x, hxc, hxd⟩ := P c
    obtain ⟨s, hsc, hsd⟩ := hAR x hxc
    refine ⟨s, hsc, fun a hle => ?_⟩
    have hdiff : s a - x0 a ∈ Ideal.map (wcCnSigma u₁ (L₁.V a)) (IsLocalRing.maximalIdeal A) := by
      rw [← sub_add_sub_cancel (s a) (x a) (x0 a)]
      exact Ideal.add_mem _ (hsd a) (hxd a)
    rw [hFB a (x0 a) (s a) hdiff hle]
    exact hx0τ a hle
  choose s hsc hsτ using key
  refine ⟨fun J a => (Z₁.presheaf.map (homOfLE (inf_le_left :
    L₁.V a ⊓ u₁ ⁻¹ᵁ ⊤ ≤ L₁.V a)).op).hom (s J a), ?_, ?_⟩
  · intro J a b
    have hsab := hsc J a b
    rw [Ideal.map_bot, Ideal.mem_bot, sub_eq_zero] at hsab
    have hT : ∀ (T : Z₁.Opens) (pb : T ≤ L₁.V b) (pa : T ≤ L₁.V a)
        (pg : T ≤ L₁.V a ⊓ L₁.V b),
        (Z₁.presheaf.map (homOfLE pb).op).hom (s J b) =
          (Z₁.presheaf.map (homOfLE pg).op).hom
            ((L₁.g a b : Γ(Z₁, L₁.V a ⊓ L₁.V b)) ^ (e * m)) *
          (Z₁.presheaf.map (homOfLE pa).op).hom (s J a) := by
      intro T pb pa pg
      rw [← red0 (inf_le_right : L₁.V a ⊓ L₁.V b ≤ L₁.V b) pg, hsab, map_mul, red0]
    dsimp only
    rw [red0, red0]
    exact hT _ _ _ _
  · intro J a
    have hle0 : (wcpaDjCocPull (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
          (algebraMap A (IsLocalRing.ResidueField A))))) L₁).V a ⊓
        Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom
          (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ ⊤ ≤
        Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
          (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ (L₁.V a ⊓ u₁ ⁻¹ᵁ ⊤) :=
      fun x hx => ⟨hx.1, trivial⟩
    refine ⟨hle0, ?_⟩
    have e1 := congrArg (fun φ => φ.hom (s J a))
      (Scheme.Hom.map_appLE (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
          (algebraMap A (IsLocalRing.ResidueField A))))) hle0
        (homOfLE (inf_le_left : L₁.V a ⊓ u₁ ⁻¹ᵁ ⊤ ≤ L₁.V a)).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e1
    exact e1.trans (hsτ J a _)

theorem wcpa_dj_lsa_fl_proj_up : ∀ (R : Type u) [CommRing R] (M : ℕ), ∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of R)) {I : Type} (U : I → X.Opens), (⨆ i, U i) = ⊤ → ∀ (s : ∀ i, Fin (M + 1) → Γ(X, U i)), (∀ i, Ideal.span (Set.range (s i)) = ⊤) → ∀ (w : ∀ i j, Γ(X, U i ⊓ U j)), (∀ i j, IsUnit (w i j)) → (∀ i j J, X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (s j J) = w i j * X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (s i J)) → ∃ φ : X ⟶ wcpaLspP R M, φ ≫ wcpaLspStr R M = fX ∧ (∀ i J, φ ⁻¹ᵁ wcpaLspD R M J ⊓ U i = X.basicOpen (s i J)) ∧ ∀ i J L (O : X.Opens) (hO : O ≤ φ ⁻¹ᵁ wcpaLspD R M J) (hOi : O ≤ U i), φ.appLE (wcpaLspD R M J) O hO (wcpaLspE R M J L) * X.presheaf.map (homOfLE hOi).op (s i J) = X.presheaf.map (homOfLE hOi).op (s i L) :=
by
  intro R _ M
  have hres : ∀ (X : Scheme.{u}) (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A)
      (x : Γ(X, A)),
      X.presheaf.map (homOfLE h2).op (X.presheaf.map (homOfLE h1).op x) =
        X.presheaf.map (homOfLE h3).op x := by
    intro X A B C h1 h2 h3 x
    rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl
  have hcovP : (⨆ a : Fin (M + 1), wcpaLspD R M a) = ⊤ := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R) :=
      MvPolynomial.gradedAlgebra
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R)
        p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩
  have haffD : ∀ k, IsAffineOpen (wcpaLspD R M k) := by
    intro k
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R) :=
      MvPolynomial.gradedAlgebra
    exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X k)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)) Nat.one_pos
  have S2 : ∀ (V : Scheme.{u}) (fV : V ⟶ Spec (.of R)) (s : Fin (M + 1) → Γ(V, ⊤)),
      Ideal.span (Set.range s) = ⊤ →
      ∃ φ : V ⟶ wcpaLspP R M, φ ≫ wcpaLspStr R M = fV ∧
        (∀ J, φ ⁻¹ᵁ wcpaLspD R M J = V.basicOpen (s J)) ∧
        ∀ J L (O : V.Opens) (hO : O ≤ φ ⁻¹ᵁ wcpaLspD R M J),
          φ.appLE (wcpaLspD R M J) O hO (wcpaLspE R M J L) *
            V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (s J) =
          V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (s L) := by
    have s3a : ∀ (X : Scheme.{u}) (r a : Γ(X, ⊤)), ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen r)).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen r ≫ (basicOpenIsoSpecAway r).hom).appTop ((Scheme.ΓSpecIso (.of (Localization.Away r))).inv (algebraMap Γ(X, ⊤) (Localization.Away r) a)) = (X.basicOpen r).ι.appTop a := by
      intro X r a
      have h1 : ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen r)).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen r ≫ (basicOpenIsoSpecAway r).hom) ≫ Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away r))) = (X.basicOpen r).ι ≫ X.toSpecΓ := by
        have hm := morphismRestrict_ι X.toSpecΓ (PrimeSpectrum.basicOpen r)
        rw [Category.assoc, Category.assoc, basicOpenIsoSpecAway_hom_SpecMap, hm, ← Category.assoc,
          Scheme.isoOfEq_inv_ι]
      have h2 := congrArg Scheme.Hom.appTop h1
      rw [Scheme.Hom.comp_appTop _ (Spec.map _), Scheme.Hom.comp_appTop (X.basicOpen r).ι,
        Scheme.toSpecΓ_appTop] at h2
      have h3 := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away r)))
      calc _ = (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away r)) ≫ (Scheme.ΓSpecIso (.of (Localization.Away r))).inv ≫ ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen r)).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen r ≫ (basicOpenIsoSpecAway r).hom).appTop) a := rfl
        _ = ((Scheme.ΓSpecIso Γ(X, ⊤)).inv ≫ (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, ⊤) (Localization.Away r)))).appTop ≫ ((X.isoOfEq (X.toSpecΓ_preimage_basicOpen r)).inv ≫ X.toSpecΓ ∣_ PrimeSpectrum.basicOpen r ≫ (basicOpenIsoSpecAway r).hom).appTop) a := by
          rw [← Category.assoc, h3, Category.assoc]; rfl
        _ = ((Scheme.ΓSpecIso Γ(X, ⊤)).inv ≫ (Scheme.ΓSpecIso Γ(X, ⊤)).hom ≫ (X.basicOpen r).ι.appTop) a := by
          rw [h2]
        _ = _ := by rw [Iso.inv_hom_id_assoc]
    have s3 : ∀ {σ A : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (X : Scheme.{u}) (f : A →+* Γ(X, ⊤)) (hf : (HomogeneousIdeal.irrelevant 𝒜).toIdeal.map f = ⊤) {t : A} {d : ℕ} (hd : 0 < d) (ht : t ∈ 𝒜 d) (n : ℕ) (y : A) (hy : y ∈ 𝒜 (n • d)), (Proj.fromOfGlobalSections 𝒜 f hf).app (Proj.basicOpen 𝒜 t) ((Proj.awayToSection 𝒜 t).hom (HomogeneousLocalization.Away.mk 𝒜 ht n y hy)) * X.presheaf.map (homOfLE (le_top : Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 t ≤ ⊤)).op (f t) ^ n = X.presheaf.map (homOfLE (le_top : Proj.fromOfGlobalSections 𝒜 f hf ⁻¹ᵁ Proj.basicOpen 𝒜 t ≤ ⊤)).op (f y) := by
      intro σ A _ _ _ 𝒜 _ X f hf t d hd ht n y hy
      have key : ∀ {U V : Scheme.{u}} {R L : CommRingCat.{u}} (W : V ⟶ Spec L) (φ₀ : R ⟶ L) (i : U ≅ Spec R) (T : V ⟶ U), T = (W ≫ Spec.map φ₀) ≫ i.inv → ∀ x : R, T.appTop (i.hom.appTop ((Scheme.ΓSpecIso R).inv x)) = W.appTop ((Scheme.ΓSpecIso L).inv (φ₀ x)) := by
        intro U V R L W φ₀ i T hT x
        subst hT
        have e1 : ((W ≫ Spec.map φ₀) ≫ i.inv).appTop = i.inv.appTop ≫ (Spec.map φ₀).appTop ≫ W.appTop := by
          rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop]
        have e2 : i.hom.appTop ≫ i.inv.appTop = 𝟙 _ := by
