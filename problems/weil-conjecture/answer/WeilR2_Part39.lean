theorem wcpa_dj_lsa_fl_chart : ∀ (A : Type u) [CommRing A] (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of A)) (L₁ : wcpaDjCoc Z₁), wcpaDjCocOK L₁ → ∀ (e M : ℕ) (σ : Fin (M + 1) → ∀ a : Fin L₁.m, Γ(Z₁, L₁.V a ⊓ u₁ ⁻¹ᵁ ⊤)), (∀ J, wcpaDjCompat L₁ (u₁ ⁻¹ᵁ ⊤) e (σ J)) → (⨆ J, ⨆ a, Z₁.basicOpen (σ J a)) = ⊤ → (∀ (X : Scheme.{u}) (fX : X ⟶ Spec (.of A)) {I : Type} (U : I → X.Opens), (⨆ i, U i) = ⊤ → ∀ (s : ∀ i, Fin (M + 1) → Γ(X, U i)), (∀ i, Ideal.span (Set.range (s i)) = ⊤) → ∀ (w : ∀ i j, Γ(X, U i ⊓ U j)), (∀ i j, IsUnit (w i j)) → (∀ i j J, X.presheaf.map (homOfLE (inf_le_right : U i ⊓ U j ≤ U j)).op (s j J) = w i j * X.presheaf.map (homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).op (s i J)) → ∃ φ : X ⟶ wcpaLspP A M, φ ≫ wcpaLspStr A M = fX ∧ (∀ i J, φ ⁻¹ᵁ wcpaLspD A M J ⊓ U i = X.basicOpen (s i J)) ∧ ∀ i J L (O : X.Opens) (hO : O ≤ φ ⁻¹ᵁ wcpaLspD A M J) (hOi : O ≤ U i), φ.appLE (wcpaLspD A M J) O hO (wcpaLspE A M J L) * X.presheaf.map (homOfLE hOi).op (s i J) = X.presheaf.map (homOfLE hOi).op (s i L)) → ∃ φ : Z₁ ⟶ wcpaLspP A M, φ ≫ wcpaLspStr A M = u₁ ∧ (∀ J, φ ⁻¹ᵁ wcpaLspD A M J = ⨆ a, Z₁.basicOpen (σ J a)) ∧ (∀ (J l : Fin (M + 1)) (a : Fin L₁.m) (O : Z₁.Opens) (hO : O ≤ φ ⁻¹ᵁ wcpaLspD A M J) (hOa : O ≤ L₁.V a ⊓ u₁ ⁻¹ᵁ ⊤), O ≤ Z₁.basicOpen (σ J a) → (φ.appLE (wcpaLspD A M J) O hO).hom (wcpaLspE A M J l) * (Z₁.presheaf.map (homOfLE hOa).op).hom (σ J a) = (Z₁.presheaf.map (homOfLE hOa).op).hom (σ l a)) :=
