    fun E hE hAF E' hE' hAF' => (hHAF K s E hE hAF).2.2.2 E' hE' hAF'
  have hnotA : ∀ x, ¬ (∀ E ∈ irreducibleComponents ↥(Limits.pullback u₁ s),
      wcpaLccAFc u₁ ε s E → x ∉ E) →
      ∃ E ∈ irreducibleComponents ↥(Limits.pullback u₁ s), wcpaLccAFc u₁ ε s E ∧ x ∈ E := by
    intro x h
    by_contra h'
    apply h
    intro E hE hAF hxE
    exact h' ⟨E, hE, hAF, hxE⟩
  set Aset : Set ↥(Limits.pullback u₁ s) :=
    {x | ∃ E ∈ irreducibleComponents ↥(Limits.pullback u₁ s), wcpaLccAFc u₁ ε s E ∧ x ∈ E}
    with hAset
  have hAcl : IsClosed Aset := by
    by_cases h : ∃ E ∈ irreducibleComponents ↥(Limits.pullback u₁ s), wcpaLccAFc u₁ ε s E
    · obtain ⟨E₀, hE₀, hAF₀⟩ := h
      have hA : Aset = E₀ := by
        ext x
        constructor
        · rintro ⟨E, hE, hAF, hx⟩
          rwa [HAFu E₀ hE₀ hAF₀ E hE hAF] at hx
        · intro hx
          exact ⟨E₀, hE₀, hAF₀, hx⟩
      rw [hA]
      exact isClosed_of_mem_irreducibleComponents E₀ hE₀
    · have hA : Aset = ∅ := by
        ext x
        simp only [Set.mem_empty_iff_false, iff_false]
        rintro ⟨E, hE, hAF, -⟩
        exact h ⟨E, hE, hAF⟩
      rw [hA]
      exact isClosed_empty
  have hBcl : IsClosed (⇑φs '' Aset) := φs.isClosedMap _ hAcl
  set Y' : (Limits.pullback uu s).Opens := ⟨(⇑φs '' Aset)ᶜ, hBcl.isOpen_compl⟩ with hY'
  have hmemV : ∀ x, x ∈ φs ⁻¹ᵁ Y' ↔ ∀ E ∈ irreducibleComponents ↥(Limits.pullback u₁ s),
      wcpaLccAFc u₁ ε s E → x ∉ E := by
    intro x
    change φs x ∉ ⇑φs '' Aset ↔ _
    constructor
    · intro h E hE hAF hxE
      exact h ⟨x, ⟨E, hE, hAF, hxE⟩, rfl⟩
    · rintro h ⟨e, ⟨E, hE, hAF, heE⟩, hfe⟩
      exact hi x h E hE hAF e heE hfe.symm
  have hrange : ∀ x, x ∈ φs ⁻¹ᵁ Y' → x ∈ Set.range (φs ⁻¹ᵁ Y').ι := by
    intro x hx
    rw [Scheme.Opens.range_ι]
    exact hx
  have e1 : ∀ c, φs ((φs ⁻¹ᵁ Y').ι c) = Y'.ι ((φs ∣_ Y') c) := by
    intro c
    rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, morphismRestrict_ι]
  have hlqf : LocallyQuasiFinite (φs ∣_ Y') := by
    apply wcpa_dj_ldx_lqf_of_no_fibre_specialization _ inferInstance
    intro a a' hsp hfa
    have hsp' := hsp.map (φs ⁻¹ᵁ Y').ι.continuous
    have hfa' : φs ((φs ⁻¹ᵁ Y').ι a') = φs ((φs ⁻¹ᵁ Y').ι a) := by rw [e1, e1, hfa]
    have hmem : (φs ⁻¹ᵁ Y').ι a' ∈ φs ⁻¹ᵁ Y' := by
      have : (φs ⁻¹ᵁ Y').ι a' ∈ Set.range (φs ⁻¹ᵁ Y').ι := ⟨a', rfl⟩
      rw [Scheme.Opens.range_ι] at this
      exact this
    exact (φs ⁻¹ᵁ Y').ι.isOpenEmbedding.injective (hii _ _ ((hmemV _).mp hmem) hsp' hfa')
  haveI := hlqf
  haveI : IsFinite (φs ∣_ Y') := IsFinite.of_isProper_of_locallyQuasiFinite _
  have hiso : IsIso (φs ∣_ Y') := by
    apply s2 _ inferInstance
    intro V₀
    have e := congrArg (fun g => Function.Bijective ⇑(CommRingCat.Hom.hom g))
      (morphismRestrict_app φs Y' V₀)
    exact e.mpr (hcompb _ _ (hpre _) (hP1' _))
  have hoi : IsOpenImmersion ((φs ⁻¹ᵁ Y').ι ≫ φs) := by
    rw [← morphismRestrict_ι]
    infer_instance
  unfold wcpaLccOffExc
  refine ⟨?_, ?_, ⟨φs ⁻¹ᵁ Y', hmemV, hoi⟩⟩
  ·
    intro y
    by_contra hy
    have hy' : y ∉ Set.range ⇑φs := fun ⟨x, hx⟩ => hy ⟨x, hx⟩
    set O : (Limits.pullback uu s).Opens :=
      ⟨(Set.range ⇑φs)ᶜ, (φs.isClosedMap.isClosed_range).isOpen_compl⟩ with hOdef
    have hO : φs ⁻¹ᵁ O = ⊥ := by
      apply le_antisymm _ bot_le
      intro x hx
      have hx' : φs x ∉ Set.range ⇑φs := hx
      exact (hx' ⟨x, rfl⟩).elim
    have hsubX : Subsingleton
        ↑((Limits.pullback u₁ s).presheaf.obj (Opposite.op (φs ⁻¹ᵁ O))) :=
      CommRingCat.subsingleton_of_isTerminal
        (TopCat.Sheaf.isTerminalOfEqEmpty (Limits.pullback u₁ s).sheaf hO)
    have hsubY : Subsingleton Γ(Limits.pullback uu s, O) :=
      ⟨fun a b => (hP1' O).1 (Subsingleton.elim _ _)⟩
    have hyO : y ∈ O := hy'
    have h10 : (1 : Γ(Limits.pullback uu s, O)) = 0 := Subsingleton.elim _ _
    have h3 := congrArg ((Limits.pullback uu s).presheaf.germ O y hyO).hom h10
    rw [map_one, map_zero] at h3
    exact one_ne_zero h3
  ·
    intro x y hxy
    by_cases hx : ∀ E ∈ irreducibleComponents ↥(Limits.pullback u₁ s),
        wcpaLccAFc u₁ ε s E → x ∉ E
    · by_cases hy : ∀ E ∈ irreducibleComponents ↥(Limits.pullback u₁ s),
          wcpaLccAFc u₁ ε s E → y ∉ E
      · left
        obtain ⟨a, rfl⟩ := hrange x ((hmemV x).mpr hx)
        obtain ⟨b, rfl⟩ := hrange y ((hmemV y).mpr hy)
        have hab : a = b := ((φs ⁻¹ᵁ Y').ι ≫ φs).isOpenEmbedding.injective (by
          rw [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply]
          exact hxy)
        rw [hab]
      · obtain ⟨E, hE, hAF, hyE⟩ := hnotA y hy
        exact (hi x hx E hE hAF y hyE hxy).elim
    · obtain ⟨E, hE, hAF, hxE⟩ := hnotA x hx
      by_cases hy : ∀ E ∈ irreducibleComponents ↥(Limits.pullback u₁ s),
          wcpaLccAFc u₁ ε s E → y ∉ E
      · exact (hi y hy E hE hAF x hxE hxy.symm).elim
      · obtain ⟨E', hE', hAF', hyE'⟩ := hnotA y hy
        right
        refine ⟨E, hE, hAF, hxE, ?_⟩
        rwa [HAFu E hE hAF E' hE' hAF'] at hyE'

theorem wcpa_dj_lcc_cm_fibre_components (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (r : ℕ)
    (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)) (L : wcpaDjCoc Z₁)
    (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) (m : ℕ)
    (hSH : wcpaLccSH W u₁ ε L t m)
    (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (φ : Z₁ ⟶ Z) (hφ : φ ≫ uu = u₁)
    (hprop : IsProper uu)
    (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Spec (.of ↥W))
    (φs : Limits.pullback u₁ s ⟶ Limits.pullback uu s)
    (h1 : φs ≫ Limits.pullback.fst uu s = Limits.pullback.fst u₁ s ≫ φ)
    (h2 : φs ≫ Limits.pullback.snd uu s = Limits.pullback.snd u₁ s)
    (hP1 : wcpaLccP1 φs) (hABC : wcpaLccContr u₁ uu ε s φs)
    (hoff : wcpaLccOffExc u₁ uu ε s φs) :
    (∀ E' : Set ↥(Limits.pullback u₁ s), E' ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
      ¬ (∀ b, ¬ ∃ x ∈ E', ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
      ⇑φs '' E' ∈ irreducibleComponents ↥(Limits.pullback uu s) ∧
      ((∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback uu s)
        (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = ⇑φs '' E' ∧
        θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
        ι ≫ Limits.pullback.snd uu s) →
      (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u₁ s)
        (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E' ∧
        θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
        ι ≫ Limits.pullback.snd u₁ s) ∧ Set.InjOn ⇑φs E')) ∧
    ∀ C : Set ↥(Limits.pullback uu s), C ∈ irreducibleComponents ↥(Limits.pullback uu s) →
      ∃ E' : Set ↥(Limits.pullback u₁ s), E' ∈ irreducibleComponents ↥(Limits.pullback u₁ s) ∧
        ¬ (∀ b, ¬ ∃ x ∈ E', ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) ∧
        C = ⇑φs '' E' :=
by
  classical
  have topo : ∀ {X Y : Type u} [TopologicalSpace X] [TopologicalSpace Y]
      (f : X → Y) (hf : Continuous f) (hcl : IsClosedMap f) (hsurj : Function.Surjective f)
      (hfin : (irreducibleComponents X).Finite) (P : Set X → Prop) (V : Set X)
      (hVo : IsOpen V) (hV : ∀ x, x ∈ V ↔ ∀ E ∈ irreducibleComponents X, P E → x ∉ E)
      (hemb : Topology.IsOpenEmbedding (fun v : V => f v))
      (hconst : ∀ E ∈ irreducibleComponents X, P E → ∀ x ∈ E, ∀ y ∈ E, f x = f y)
      (hnode : ∀ E ∈ irreducibleComponents X, P E → (E ∩ closure Eᶜ).Nonempty)
      (huniq : ∀ E ∈ irreducibleComponents X, P E → ∀ E' ∈ irreducibleComponents X, P E' →
        E' = E),
      (∀ E ∈ irreducibleComponents X, ¬ P E →
        (E ∩ V).Nonempty ∧ f '' E ∈ irreducibleComponents Y) ∧
      ∀ C ∈ irreducibleComponents Y, ∃ E ∈ irreducibleComponents X, ¬ P E ∧ C = f '' E := by
    intro X Y _ _ f hf hcl hsurj hfin P V hVo hV hemb hconst hnode huniq
    have ha : ∀ E ∈ irreducibleComponents X, ¬ P E → (E ∩ V).Nonempty := by
      intro E hE hPE
      have hEm : Maximal IsIrreducible E := hE
      by_contra hne
      have hnV : ∀ y ∈ E, y ∉ V := fun y hy hyV => hne ⟨y, hy, hyV⟩
      obtain ⟨x, hx⟩ := hEm.1.nonempty
      have hxV := hnV x hx
      rw [hV] at hxV
      push_neg at hxV
      obtain ⟨E₀, hE₀, hP₀, hxE₀⟩ := hxV
      have hE₀m : Maximal IsIrreducible E₀ := hE₀
      have hsub : E ⊆ E₀ := by
        intro y hy
        have hyV := hnV y hy
        rw [hV] at hyV
        push_neg at hyV
        obtain ⟨E₁, hE₁, hP₁, hyE₁⟩ := hyV
        rw [huniq E₀ hE₀ hP₀ E₁ hE₁ hP₁] at hyE₁
        exact hyE₁
      have : E = E₀ := hEm.eq_of_le hE₀m.1 hsub
      exact hPE (this ▸ hP₀)
    have hc : ∀ E ∈ irreducibleComponents X, ¬ P E → f '' E ∈ irreducibleComponents Y := by
      intro E hE hPE
      have hEm : Maximal IsIrreducible E := hE
      have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
      obtain ⟨x₀, hx₀E, hx₀V⟩ := ha E hE hPE
      have hirr : IsIrreducible (f '' E) := hEm.1.image f hf.continuousOn
      have hfcl : IsClosed (f '' E) := hcl E hEcl
      show Maximal IsIrreducible (f '' E)
      refine ⟨hirr, fun T hT hsub => ?_⟩
      have hT'irr : IsIrreducible (closure T) := hT.closure
      have hsub' : f '' E ⊆ closure T := hsub.trans subset_closure
      let g : V → Y := fun v => f v
      have hS₀ : IsPreirreducible (g ⁻¹' closure T) := hT'irr.isPreirreducible.preimage hemb
      have hSirr : IsIrreducible (Subtype.val '' (g ⁻¹' closure T)) :=
        ⟨⟨x₀, ⟨⟨x₀, hx₀V⟩, hsub' ⟨x₀, hx₀E, rfl⟩, rfl⟩⟩,
          hS₀.image _ continuous_subtype_val.continuousOn⟩
      have hEV : E ∩ V ⊆ Subtype.val '' (g ⁻¹' closure T) :=
        fun x hx => ⟨⟨x, hx.2⟩, hsub' ⟨x, hx.1, rfl⟩, rfl⟩
      have hEclS : E ⊆ closure (Subtype.val '' (g ⁻¹' closure T)) :=
        (subset_closure_inter_of_isPreirreducible_of_isOpen hEm.1.isPreirreducible hVo
          ⟨x₀, hx₀E, hx₀V⟩).trans (closure_mono hEV)
      have hclS : E = closure (Subtype.val '' (g ⁻¹' closure T)) :=
        hEm.eq_of_le hSirr.closure hEclS
      have hSE : Subtype.val '' (g ⁻¹' closure T) ⊆ E := subset_closure.trans hclS.symm.le
      have hO : IsOpen (Set.range g) := hemb.isOpen_range
      have hT'O : closure T ∩ Set.range g ⊆ f '' E := by
        rintro y ⟨hyT, v, rfl⟩
        exact ⟨v.1, hSE ⟨v, hyT, rfl⟩, rfl⟩
      have hne : (closure T ∩ Set.range g).Nonempty :=
        ⟨f x₀, hsub' ⟨x₀, hx₀E, rfl⟩, ⟨x₀, hx₀V⟩, rfl⟩
      have h2 : closure T ⊆ closure (closure T ∩ Set.range g) :=
        subset_closure_inter_of_isPreirreducible_of_isOpen hT'irr.isPreirreducible hO hne
      calc T ⊆ closure T := subset_closure
        _ ⊆ closure (closure T ∩ Set.range g) := h2
        _ ⊆ closure (f '' E) := closure_mono hT'O
        _ = f '' E := hfcl.closure_eq
    have hd : ∀ C ∈ irreducibleComponents Y, ∃ E ∈ irreducibleComponents X, ¬ P E ∧ C = f '' E := by
      intro C hC
      have hCm : Maximal IsIrreducible C := hC
      have hcover : C ⊆ ⋃₀ ↑(hfin.toFinset.image (fun E => f '' E)) := by
        intro y _
        obtain ⟨x, rfl⟩ := hsurj y
        have hx : x ∈ ⋃₀ irreducibleComponents X := by rw [sUnion_irreducibleComponents]; trivial
        obtain ⟨E, hE, hxE⟩ := hx
        refine ⟨f '' E, ?_, ⟨x, hxE, rfl⟩⟩
        rw [Finset.coe_image, Set.Finite.coe_toFinset]
        exact ⟨E, hE, rfl⟩
      obtain ⟨Z', hZ', hCZ⟩ := (isIrreducible_iff_sUnion_isClosed.mp hCm.1) _ (by
        intro z hz
        rw [Finset.mem_image] at hz
        obtain ⟨E, hE, rfl⟩ := hz
        exact hcl E (isClosed_of_mem_irreducibleComponents E ((Set.Finite.mem_toFinset hfin).mp hE)))
        hcover
      rw [Finset.mem_image] at hZ'
      obtain ⟨E, hE, rfl⟩ := hZ'
      have hE' : E ∈ irreducibleComponents X := (Set.Finite.mem_toFinset hfin).mp hE
      have hEm : Maximal IsIrreducible E := hE'
      have hCeq : C = f '' E := hCm.eq_of_le (hEm.1.image f hf.continuousOn) hCZ
      by_cases hPE : P E
      · obtain ⟨x, hxE, hxcl⟩ := hnode E hE' hPE
        have hFcl : IsClosed (⋃ E' ∈ {E' | E' ∈ irreducibleComponents X ∧ E' ≠ E}, E') :=
          Set.Finite.isClosed_biUnion (hfin.subset (fun _ h => h.1))
            (fun E' h => isClosed_of_mem_irreducibleComponents E' h.1)
        have hEcF : Eᶜ ⊆ ⋃ E' ∈ {E' | E' ∈ irreducibleComponents X ∧ E' ≠ E}, E' := by
          intro y hy
          have : y ∈ ⋃₀ irreducibleComponents X := by rw [sUnion_irreducibleComponents]; trivial
          obtain ⟨E', hE'', hyE'⟩ := this
          refine Set.mem_iUnion₂.mpr ⟨E', ⟨hE'', ?_⟩, hyE'⟩
          rintro rfl
          exact hy hyE'
        have hxF := closure_minimal hEcF hFcl hxcl
        obtain ⟨E', ⟨hE'c, hE'ne⟩, hxE'⟩ := Set.mem_iUnion₂.mp hxF
        have hPE' : ¬ P E' := fun h => hE'ne (huniq E hE' hPE E' hE'c h)
        refine ⟨E', hE'c, hPE', ?_⟩
        have hE'm : Maximal IsIrreducible E' := hE'c
        apply hCm.eq_of_le (hE'm.1.image f hf.continuousOn)
        intro y hy
        rw [hCeq] at hy
        obtain ⟨z, hz, rfl⟩ := hy
        rw [hconst E hE' hPE z hz x hxE]
        exact ⟨x, hxE', rfl⟩
      · exact ⟨E, hE', hPE, hCeq⟩
    exact ⟨fun E hE hPE => ⟨ha E hE hPE, hc E hE hPE⟩, hd⟩
  have p1 : ∀ (X Y : Scheme.{u})
      (pX : X ⟶ Spec (.of K)) (pY : Y ⟶ Spec (.of K)) (hpX : IsProper pX) (hpY : IsSeparated pY)
      (ψ : X ⟶ Y) (hψ : ψ ≫ pY = pX) (V : X.Opens) (hVψ : IsOpenImmersion (V.ι ≫ ψ))
      (hinj : ∀ x v : X, v ∈ V → ψ x = ψ v → x = v)
      (E' : Set X) (hE'cl : IsClosed E') (hE'irr : IsIrreducible E')
      (hE'V : (E' ∩ (V : Set X)).Nonempty)
      (Er : Scheme.{u}) (ι : Er ⟶ Y)
      (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra)
      (hι : IsClosedImmersion ι) (hred : IsReduced Er) (hrange : Set.range ι = ⇑ψ '' E')
      (hθ : θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ pY),
      (∃ (Er' : Scheme.{u}) (ι' : Er' ⟶ X)
        (θ' : Er' ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion ι' ∧ IsReduced Er' ∧ Set.range ι' = E' ∧
        θ'.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι' ≫ pX) ∧
      Set.InjOn ⇑ψ E' := by
    intro X Y pX pY hpX hpY ψ hψ V hVψ hinj E' hE'cl hE'irr hE'V Er ι θ hι hred hrange hθ
    classical
    have pt : ∀ {A B D : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ D} {d : A ⟶ D}, a ≫ b = d →
        ∀ z, b (a z) = d z := by
      intro A B D a b d h z
      rw [← Scheme.Hom.comp_apply, h]

    set I := Scheme.IdealSheafData.vanishingIdeal (⟨E', hE'cl⟩ : TopologicalSpace.Closeds X)
    obtain ⟨R, r, hr, hrr, hRred⟩ := wc_reduced_subscheme_exists I.subscheme
    set j : R ⟶ X := r ≫ I.subschemeι with hjdef
    haveI : IsClosedImmersion j := inferInstance
    have hjr : Set.range j = E' := by
      have h1 : Set.range I.subschemeι = E' := by
        rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
        rfl
      rw [← h1]
      ext x
      constructor
      · rintro ⟨a, rfl⟩
        exact ⟨r a, (Scheme.Hom.comp_apply r I.subschemeι a).symm⟩
      · rintro ⟨b, rfl⟩
        have hb : b ∈ Set.range r := by rw [hrr]; trivial
        obtain ⟨a, rfl⟩ := hb
        exact ⟨a, Scheme.Hom.comp_apply r I.subschemeι a⟩
    haveI : IrreducibleSpace R := by
      have e := j.isClosedEmbedding.isEmbedding.toHomeomorph
      haveI : IrreducibleSpace (Set.range j) := by
        rw [hjr]
        exact Subtype.irreducibleSpace hE'irr
      exact (Homeomorph.irreducibleSpace_iff e).mpr inferInstance
    haveI : AlgebraicGeometry.IsIntegral R := isIntegral_of_irreducibleSpace_of_isReduced R

    haveI : IrreducibleSpace Er := by
      haveI : IrreducibleSpace (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra) := wc_proj_space_irreducible K 1
      exact (Homeomorph.irreducibleSpace_iff θ.hom.homeomorph).mpr inferInstance
    haveI : AlgebraicGeometry.IsIntegral Er := isIntegral_of_irreducibleSpace_of_isReduced Er
    haveI : SmoothOfRelativeDimension 1 (wcProjKStr K 1) := wc_proj_space_smooth K 1
    haveI hsm : SmoothOfRelativeDimension 1 (θ.hom ≫ wcProjKStr K 1) := by
      have := smoothOfRelativeDimension_comp 0 1 θ.hom (wcProjKStr K 1)
      simpa using this
    have hval : ∀ y : Er, ValuationRing (Er.presheaf.stalk y) := by
      intro y
      haveI := wcpa_smooth_stalk_isDomain K Er (θ.hom ≫ wcProjKStr K 1) 1 y
      exact wcpa_dj_sgt_smooth_curve_stalk_valuation K Er (θ.hom ≫ wcProjKStr K 1) y

    have hrg : Set.range (j ≫ ψ) ⊆ Set.range ι := by
      rintro _ ⟨a, rfl⟩
      rw [hrange]
      refine ⟨j a, ?_, (Scheme.Hom.comp_apply j ψ a).symm⟩
      rw [← hjr]; exact ⟨a, rfl⟩
    obtain ⟨g, hg⟩ := wc_ap_reduced_factor_closed_immersion R Er Y (j ≫ ψ) ι hrg

    haveI : IsProper pX := hpX
    haveI : IsSeparated pY := hpY
    haveI : IsProper (g ≫ ι ≫ pY) := by
      rw [← Category.assoc, hg, Category.assoc, hψ]; infer_instance
    haveI : IsProper g := IsProper.of_comp g (ι ≫ pY)

    set θV : V.toScheme ⟶ Y := V.ι ≫ ψ with hθV
    haveI : IsOpenImmersion θV := hVψ
    set Wc : Er.Opens := ι ⁻¹ᵁ θV.opensRange with hWc
    have hθVapp : ∀ v : V.toScheme, θV v = ψ v.1 := fun v => by
      rw [hθV, Scheme.Hom.comp_apply]; rfl
    have hmemO : ∀ y : Y, y ∈ θV.opensRange ↔ ∃ v ∈ V, ψ v = y := by
      intro y
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange]
      constructor
      · rintro ⟨v, rfl⟩; exact ⟨v.1, v.2, (hθVapp v).symm⟩
      · rintro ⟨v, hv, rfl⟩; exact ⟨⟨v, hv⟩, hθVapp _⟩
    have hWne : Wc ≠ ⊥ := by
      rw [TopologicalSpace.Opens.ne_bot_iff_nonempty]
      obtain ⟨x, hxE, hxV⟩ := hE'V
      have : ψ x ∈ Set.range ι := by rw [hrange]; exact ⟨x, hxE, rfl⟩
      obtain ⟨e, he⟩ := this
      refine ⟨e, ?_⟩
      show ι e ∈ θV.opensRange
      rw [hmemO]; exact ⟨x, hxV, he.symm⟩

    have H1 : Set.range (Wc.ι ≫ ι) ⊆ Set.range θV := by
      rintro _ ⟨w, rfl⟩
      have hw : ι w.1 ∈ θV.opensRange := w.2
      rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hw
      rw [Scheme.Hom.comp_apply]
      exact hw
    set k : Wc.toScheme ⟶ V.toScheme := IsOpenImmersion.lift θV (Wc.ι ≫ ι) H1 with hkdef
    have hk : k ≫ θV = Wc.ι ≫ ι := IsOpenImmersion.lift_fac _ _ _
    have H2 : Set.range (k ≫ V.ι) ⊆ Set.range j := by
      rintro _ ⟨w, rfl⟩
      rw [hjr, Scheme.Hom.comp_apply]
      show (k w).1 ∈ E'
      have e1 : ψ (k w).1 = ι w.1 := by
        rw [← hθVapp, pt hk w, Scheme.Hom.comp_apply]; rfl
      have : ι w.1 ∈ Set.range ι := ⟨_, rfl⟩
      rw [hrange] at this
      obtain ⟨x, hxE, hx⟩ := this
      have := hinj x (k w).1 (k w).2 (hx.trans e1.symm)
      rw [← this]; exact hxE
    obtain ⟨k', hk'⟩ := wc_ap_reduced_factor_closed_immersion Wc.toScheme R X (k ≫ V.ι) j H2
    have hk'g : k' ≫ g = Wc.ι := by
      rw [← cancel_mono ι, Category.assoc, hg, ← Category.assoc, hk', Category.assoc, ← hk]
    have H3 : Set.range k' ⊆ Set.range (g ⁻¹ᵁ Wc).ι := by
      rintro _ ⟨w, rfl⟩
      rw [Scheme.Opens.range_ι]
      show g (k' w) ∈ Wc
      rw [pt hk'g w]
      exact w.2
    set inv' : Wc.toScheme ⟶ (g ⁻¹ᵁ Wc).toScheme := IsOpenImmersion.lift (g ⁻¹ᵁ Wc).ι k' H3
    have hinv : inv' ≫ (g ⁻¹ᵁ Wc).ι = k' := IsOpenImmersion.lift_fac _ _ _
    have H4 : Set.range ((g ⁻¹ᵁ Wc).ι ≫ j) ⊆ Set.range V.ι := by
      rintro _ ⟨x, rfl⟩
      rw [Scheme.Opens.range_ι, Scheme.Hom.comp_apply]
      show j x.1 ∈ V
      have hx : g x.1 ∈ Wc := x.2
      have hx' : ι (g x.1) ∈ θV.opensRange := hx
      rw [hmemO] at hx'
      obtain ⟨v, hv, hve⟩ := hx'
      have e2 : ι (g x.1) = ψ (j x.1) := pt hg x.1
      have := hinj (j x.1) v hv (e2.symm.trans hve.symm)
      rw [this]; exact hv
    set a : (g ⁻¹ᵁ Wc).toScheme ⟶ V.toScheme := IsOpenImmersion.lift V.ι ((g ⁻¹ᵁ Wc).ι ≫ j) H4
    have ha : a ≫ V.ι = (g ⁻¹ᵁ Wc).ι ≫ j := IsOpenImmersion.lift_fac _ _ _
    have hgk : (g ∣_ Wc) ≫ k = a := by
      rw [← cancel_mono θV, Category.assoc, hk, ← Category.assoc, morphismRestrict_ι,
        Category.assoc, hg, hθV, ← Category.assoc a, ha, Category.assoc]
      simp only [hjdef, Category.assoc]
    have hiso : IsIso (g ∣_ Wc) := by
      refine ⟨⟨inv', ?_, ?_⟩⟩
      · rw [← cancel_mono (g ⁻¹ᵁ Wc).ι, ← cancel_mono j]
        simp only [Category.assoc, Category.id_comp]
        rw [← Category.assoc inv', hinv, hk', ← Category.assoc, hgk, ha]
      · rw [← cancel_mono Wc.ι, Category.assoc, morphismRestrict_ι, ← Category.assoc, hinv, hk'g,
          Category.id_comp]

    haveI : IsIso g := wcpa_dj_sgt_birational_iso_valuative R Er g Wc hWne hiso hval

    refine ⟨⟨R, j, asIso g ≪≫ θ, inferInstance, hRred, hjr, ?_⟩, ?_⟩
    · rw [Iso.trans_hom, asIso_hom, Category.assoc, hθ, ← Category.assoc, hg, Category.assoc, hψ]
    · rintro x hx y hy hxy
      rw [← hjr] at hx hy
      obtain ⟨a', rfl⟩ := hx
      obtain ⟨b', rfl⟩ := hy
      have e1 : ι (g a') = ι (g b') := by rw [pt hg, pt hg]; exact hxy
      have e2 : g a' = g b' := ι.isClosedEmbedding.injective e1
      have e3 : a' = b' := g.homeomorph.injective e2
      rw [e3]
  obtain ⟨hsurj, hinjoff, V, hV, hVimm⟩ := hoff
  have hss := hSH.1
  haveI : IsProper u₁ := hss.2.1
  have hHAF := hSH.2.2.2.2.2.1
  haveI := hprop
  haveI : IsProper (φs ≫ Limits.pullback.snd uu s) := by rw [h2]; infer_instance
  haveI : IsProper φs := IsProper.of_comp φs (Limits.pullback.snd uu s)
  have hemb : Topology.IsOpenEmbedding
      (fun v : ((V : Set ↥(Limits.pullback u₁ s)) : Type u) => φs v) :=
    (V.ι ≫ φs).isOpenEmbedding
  obtain ⟨hi, hii⟩ := topo (⇑φs) φs.continuous φs.isClosedMap hsurj
    (wcpa_dj_lfc_afc_fibre_nodes_finite _ _ u₁ hss K s).1
    (fun E => ∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q))
    (V : Set ↥(Limits.pullback u₁ s)) V.isOpen hV hemb hABC.1
    (fun E hE hAF => by
      obtain ⟨-, hn1, -, -⟩ := hHAF K s E hE hAF
      exact Set.nonempty_of_ncard_ne_zero (by omega))
    (fun E hE hP E' hE' hP' => (hHAF K s E hE hP).2.2.2 E' hE' hP')
  refine ⟨fun E' hE' hnot => ⟨(hi E' hE' hnot).2, ?_⟩, hii⟩
  rintro ⟨Er, ι, θ, hι, hred, hrange, hθ⟩
  exact p1 _ _ (Limits.pullback.snd u₁ s) (Limits.pullback.snd uu s) inferInstance inferInstance
    φs h2 V hVimm
    (fun x v hv hxv => by
      rcases hinjoff x v hxv with h | ⟨E, hE, hAF, -, hvE⟩
      · exact h
      · exact absurd hvE ((hV v).1 hv E hE hAF))
    E' (isClosed_of_mem_irreducibleComponents E' hE') hE'.1 (hi E' hE' hnot).1
    Er ι θ hι hred hrange hθ

theorem wcpa_dj_lfcs_domain_unibranch : ∀ (X : Scheme.{u}) (O : X.Opens) (x : ↥X) (hx : x ∈ O), IsDomain ((O : Scheme.{u}).presheaf.stalk (⟨x, hx⟩ : ↥O)) → ∀ E₁ ∈ irreducibleComponents ↥X, ∀ E₂ ∈ irreducibleComponents ↥X, x ∈ E₁ → x ∈ E₂ → E₁ = E₂ :=
by
  intro X O x hx hR
  haveI := hR
  let f : Spec ((O : Scheme.{u}).presheaf.stalk (⟨x, hx⟩ : ↥O)) ⟶ X :=
    (O : Scheme.{u}).fromSpecStalk ⟨x, hx⟩ ≫ O.ι
  have hS : IsIrreducible (closure (Set.range f)) := by
    have h1 : IsIrreducible (f '' Set.univ) :=
      (IrreducibleSpace.isIrreducible_univ _).image f f.continuous.continuousOn
    rw [Set.image_univ] at h1
    exact h1.closure
  have key : ∀ E ∈ irreducibleComponents X, x ∈ E → E = closure (Set.range f) := by
    intro E hE hxE
    have hE' : Maximal IsIrreducible E := hE
    have hirr : IsIrreducible E := hE'.prop
    have hcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
    have hη := hirr.isGenericPoint_genericPoint hcl
    have hηx : hirr.genericPoint ⤳ x := hη.specializes hxE
    have hηO : hirr.genericPoint ∈ (O : Set X) := hηx.mem_open O.isOpen hx
    let η' : ↥(O : Scheme.{u}) := ⟨hirr.genericPoint, hηO⟩
    let y' : ↥(O : Scheme.{u}) := ⟨x, hx⟩
    have hspec : η' ⤳ y' := O.ι.isOpenEmbedding.isInducing.specializes_iff.mp hηx
    have hmem : η' ∈ Set.range ((O : Scheme.{u}).fromSpecStalk y') := by
      rw [Scheme.range_fromSpecStalk]; exact hspec
    obtain ⟨p, hp⟩ := hmem
    have hηS : hirr.genericPoint ∈ Set.range f := by
      refine ⟨p, ?_⟩
      show ((O : Scheme.{u}).fromSpecStalk ⟨x, hx⟩ ≫ O.ι) p = hirr.genericPoint
      rw [Scheme.Hom.comp_apply, hp]
      rfl
    apply hE'.eq_of_le hS
    rw [← hη.def]
    exact closure_mono (Set.singleton_subset_iff.mpr hηS)
  intro E₁ hE₁ E₂ hE₂ h1 h2
  rw [key E₁ hE₁ h1, key E₂ hE₂ h2]

theorem wcpa_dj_lcc_fsbc_fibre_topology : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (p : X ⟶ Spec (.of K)) (E : Set X), IsProper p → (∀ x : X, (∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p)) ∨ (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap (X.presheaf.stalk x) (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C)) → E ∈ irreducibleComponents X → IsReduced X ∧ (irreducibleComponents X).Finite ∧ {x : X | ¬ ∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p)}.Finite ∧ (∀ x : X, (¬ ∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p)) → IsClosed ({x} : Set X)) ∧ ∀ x ∈ E ∩ closure Eᶜ, (¬ ∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p)) ∧ ∃ C ∈ irreducibleComponents X, C ≠ E ∧ x ∈ C :=
by
  intro K _ X p E hp hfib hE
  classical
  haveI := hp
  haveI : LocallyOfFiniteType p := inferInstance
  haveI : QuasiCompact p := inferInstance
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian p

  haveI hnoeth : TopologicalSpace.NoetherianSpace X := by
    haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace p
    haveI : AlgebraicGeometry.IsNoetherian X := {}
    exact IsNoetherian.noetherianSpace

  have hfin : (irreducibleComponents X).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents

  have hred : IsReduced X := by
    haveI : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := by
      intro x
      rcases hfib x with ⟨W, hW, hWsm⟩ | ⟨e, he⟩
      · haveI := hWsm
        haveI hdomW := wcpa_smooth_stalk_isDomain K W.toScheme (W.ι ≫ p) 1 (⟨x, hW⟩ : W)
        haveI hdom : IsDomain (X.presheaf.stalk x) :=
          MulEquiv.isDomain _ (W.stalkIso (⟨x, hW⟩ : W)).symm.commRingCatIsoToRingEquiv.toMulEquiv
        infer_instance
      · exact wcpa_dj_nf_node_reduced K (X.presheaf.stalk x)
          ((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial).hom ⟨e, he⟩
    exact isReduced_of_isReduced_stalk X

  let U : X.Opens := sSup {W : X.Opens | SmoothOfRelativeDimension 1 (W.ι ≫ p)}
  have hU : ∀ x : X, x ∈ U ↔ ∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p) := by
    intro x
    rw [TopologicalSpace.Opens.mem_sSup]
    exact ⟨fun ⟨W, hW, hx⟩ => ⟨W, hx, hW⟩, fun ⟨W, hx, hW⟩ => ⟨W, hW, hx⟩⟩

  have hres : ∀ w : X, w ∉ U → ∀ a : X.presheaf.stalk w, ∃ z : K,
      a - ((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ w trivial).hom z ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk w) := by
    intro w hw
    rcases hfib w with hsm | ⟨e, he⟩
    · exact absurd ((hU w).mpr hsm) hw
    · exact wcpa_dj_nf_node_residue K (X.presheaf.stalk w)
        ((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ w trivial).hom ⟨e, he⟩

  obtain ⟨hcl, hfinU⟩ := wcpa_dj_nf_nodes_closed_finite K X p U hp hres
  have hNSeq : {x : X | ¬ ∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p)} =
      ((U : Set X)ᶜ) := by
    ext x
    simp only [Set.mem_setOf_eq, Set.mem_compl_iff, SetLike.mem_coe]
    exact not_congr (hU x).symm
  have conj3 : {x : X | ¬ ∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p)}.Finite := by
    rw [hNSeq]; exact hfinU
  have conj4 : ∀ x : X, (¬ ∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p)) →
      IsClosed ({x} : Set X) := by
    intro x hx
    exact hcl x (fun hxU => hx ((hU x).mp hxU))

  have hother : ∀ x ∈ closure Eᶜ, ∃ C ∈ irreducibleComponents X, C ≠ E ∧ x ∈ C := by
    intro x hx
    have hVcl : IsClosed (⋃ D' ∈ {D' | D' ∈ irreducibleComponents X ∧ D' ≠ E}, D') :=
      (hfin.subset (fun D' hD' => hD'.1)).isClosed_biUnion
        (fun D' hD' => isClosed_of_mem_irreducibleComponents D' hD'.1)
    have hsub : Eᶜ ⊆ ⋃ D' ∈ {D' | D' ∈ irreducibleComponents X ∧ D' ≠ E}, D' := by
      intro y hy
      obtain ⟨D'', hD'', hyD''⟩ :=
        exists_mem_irreducibleComponents_subset_of_isIrreducible {y} isIrreducible_singleton
      refine Set.mem_biUnion (x := D'') ⟨hD'', ?_⟩ (hyD'' (Set.mem_singleton y))
      intro h
      apply hy
      rw [← h]
      exact hyD'' (Set.mem_singleton y)
    have hxV := closure_minimal hsub hVcl hx
    obtain ⟨C, ⟨hC, hCne⟩, hxC⟩ := Set.mem_iUnion₂.mp hxV
    exact ⟨C, hC, hCne, hxC⟩

  have conj5 : ∀ x ∈ E ∩ closure Eᶜ,
      (¬ ∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p)) ∧
      ∃ C ∈ irreducibleComponents X, C ≠ E ∧ x ∈ C := by
    rintro x ⟨hxE, hxcl⟩
    obtain ⟨C, hC, hCne, hxC⟩ := hother x hxcl
    refine ⟨?_, C, hC, hCne, hxC⟩
    rintro ⟨W, hW, hWsm⟩
    haveI := hWsm
    have hdom := wcpa_smooth_stalk_isDomain K W.toScheme (W.ι ≫ p) 1 (⟨x, hW⟩ : W)
    exact hCne (wcpa_dj_lfcs_domain_unibranch X W x hW hdom E hE C hC hxE hxC).symm
  exact ⟨hred, hfin, conj3, conj4, conj5⟩

theorem wcpa_dj_lcc_fsbc_smooth_off_E : ∀ (K : Type u) [Field K] (X X' : Scheme.{u}) (p : X ⟶ Spec (.of K)) (i : X' ⟶ X) (E : Set X) (z : X'), IsReduced X → IsClosedImmersion i → IsClosed E → Set.range i = closure Eᶜ → i z ∉ E → (∃ W : X.Opens, i z ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p)) → ∃ W' : X'.Opens, z ∈ W' ∧ SmoothOfRelativeDimension 1 (W'.ι ≫ i ≫ p) :=
by
  intro K _ X X' p i E z hX hi hE hrange hzE hWex
  obtain ⟨W, hzW, hW⟩ := hWex
  haveI := hX
  haveI := hi
  let U : X.Opens := W ⊓ ⟨Eᶜ, hE.isOpen_compl⟩
  have hUW : U ≤ W := inf_le_left
  have hUi : (U : Set X) ⊆ Set.range i := by
    intro u hu
    rw [hrange]
    exact subset_closure hu.2
  haveI : Surjective (i ∣_ U) := by
    constructor
    rintro ⟨u, hu⟩
    obtain ⟨x, hx⟩ := hUi hu
    have hxU : x ∈ i ⁻¹ᵁ U := by
      show i x ∈ U
      rw [hx]
      exact hu
    refine ⟨⟨x, hxU⟩, ?_⟩
    apply Subtype.ext
    exact (morphismRestrict_base_coe i U ⟨x, hxU⟩).trans hx
  haveI : IsIso (i ∣_ U) := isIso_of_isClosedImmersion_of_surjective _
  have hzW' : z ∈ i ⁻¹ᵁ U := by
    show i z ∈ U
    exact ⟨hzW, hzE⟩
  refine ⟨i ⁻¹ᵁ U, hzW', ?_⟩
  have heq : (i ⁻¹ᵁ U).ι ≫ i ≫ p = (i ∣_ U) ≫ X.homOfLE hUW ≫ (W.ι ≫ p) := by
    rw [← Category.assoc, ← morphismRestrict_ι, Category.assoc, ← Category.assoc (X.homOfLE hUW),
      Scheme.homOfLE_ι]
  rw [heq]
  apply HasRingHomProperty.comp_of_isOpenImmersion (@SmoothOfRelativeDimension 1)
  exact HasRingHomProperty.comp_of_isOpenImmersion (@SmoothOfRelativeDimension 1) _ _ hW

theorem wcpa_dj_lcc_fsbc_stalk_ideal : ∀ (X X' : Scheme.{u}) (i : X' ⟶ X) (E C : Set X) (x' : X'), IsClosedImmersion i → IsReduced X' → Set.range i = closure Eᶜ → (irreducibleComponents X).Finite → E ∈ irreducibleComponents X → C ∈ irreducibleComponents X → C ≠ E → i x' ∈ E → i x' ∈ C → (RingHom.ker (i.stalkMap x').hom).IsRadical ∧ (∃ P : Ideal (X.presheaf.stalk (i x')), P.IsPrime ∧ ¬ RingHom.ker (i.stalkMap x').hom ≤ P) ∧ (∃ Q : Ideal (X.presheaf.stalk (i x')), Q.IsPrime ∧ RingHom.ker (i.stalkMap x').hom ≤ Q ∧ Q ≠ IsLocalRing.maximalIdeal (X.presheaf.stalk (i x'))) :=
by
  intro X X' i E C x' hi hred hrange hfin hE hC hCE hxE hxC
  classical
  haveI := hi
  haveI := hred
  have hsurj : Function.Surjective (i.stalkMap x').hom :=
    SurjectiveOnStalks.stalkMap_surjective i x'

  have hsq : ∀ q : PrimeSpectrum (X'.presheaf.stalk x'),
      X.fromSpecStalk (i x') (PrimeSpectrum.comap (i.stalkMap x').hom q) =
        i (X'.fromSpecStalk x' q) := by
    intro q
    have h := Scheme.SpecMap_stalkMap_fromSpecStalk i (x := x')
    have h2 : ∀ p : ↥(Spec (X'.presheaf.stalk x')),
        (Spec.map (i.stalkMap x') ≫ X.fromSpecStalk (i x')) p =
        (X'.fromSpecStalk x' ≫ i) p := by intro p; rw [h]
    have h3 := h2 q
    exact h3

  have hEmax : Maximal IsIrreducible E := hE
  have hCmax : Maximal IsIrreducible C := hC
  have hEirr : IsIrreducible E := hEmax.prop
  have hCirr : IsIrreducible C := hCmax.prop
  have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE
  have hCcl : IsClosed C := isClosed_of_mem_irreducibleComponents C hC

  have hrad : (RingHom.ker (i.stalkMap x').hom).IsRadical := by
    let e := RingHom.quotientKerEquivOfSurjective hsurj
    haveI : _root_.IsReduced (X.presheaf.stalk (i x') ⧸ RingHom.ker (i.stalkMap x').hom) :=
      isReduced_of_injective e e.injective
    exact (Ideal.isRadical_iff_quotient_reduced _).mpr this
  refine ⟨hrad, ?_, ?_⟩
  ·
    have hη : IsGenericPoint hEirr.genericPoint E := hEirr.isGenericPoint_genericPoint hEcl

    have hs1 : hEirr.genericPoint ∉ closure Eᶜ := by
      intro hηc
      have hD : IsClosed (⋃ C' ∈ {C' ∈ irreducibleComponents X | C' ≠ E}, C') :=
        (hfin.subset (fun _ h => h.1)).isClosed_biUnion
          (fun C' h => isClosed_of_mem_irreducibleComponents C' h.1)
      have hsub : Eᶜ ⊆ ⋃ C' ∈ {C' ∈ irreducibleComponents X | C' ≠ E}, C' := by
        intro y hy
        obtain ⟨C', hC', hyC'⟩ :=
          exists_mem_irreducibleComponents_subset_of_isIrreducible {y} isIrreducible_singleton
        refine Set.mem_biUnion (x := C') ⟨hC', ?_⟩ (hyC' (Set.mem_singleton y))
        rintro rfl
        exact hy (hyC' (Set.mem_singleton y))
      have hmem := closure_minimal hsub hD hηc
      obtain ⟨C', ⟨hC', hC'E⟩, hηC'⟩ := Set.mem_iUnion₂.mp hmem
      have hC'cl : IsClosed C' := isClosed_of_mem_irreducibleComponents C' hC'
      have hC'max : Maximal IsIrreducible C' := hC'
      have hEC' : E ⊆ C' := fun y hy => (hη.specializes hy).mem_closed hC'cl hηC'
      exact hC'E (hEmax.eq_of_subset hC'max.prop hEC').symm
    obtain ⟨P₀, hP₀⟩ : hEirr.genericPoint ∈ Set.range (X.fromSpecStalk (i x')) := by
      rw [Scheme.range_fromSpecStalk]
      exact hη.specializes hxE
    refine ⟨P₀.asIdeal, P₀.isPrime, ?_⟩
    intro hle
    haveI := P₀.isPrime
    have hQ' : (Ideal.map (i.stalkMap x').hom P₀.asIdeal).IsPrime :=
      Ideal.map_isPrime_of_surjective hsurj hle
    have hcm : Ideal.comap (i.stalkMap x').hom (Ideal.map (i.stalkMap x').hom P₀.asIdeal) =
        P₀.asIdeal := by
      rw [Ideal.comap_map_of_surjective' _ hsurj]
      exact sup_eq_left.mpr hle
    have hpt : PrimeSpectrum.comap (i.stalkMap x').hom ⟨_, hQ'⟩ = P₀ :=
      PrimeSpectrum.ext hcm
    have h1 := hsq ⟨_, hQ'⟩
    rw [hpt, hP₀] at h1
    apply hs1
    rw [← hrange, h1]
    exact ⟨_, rfl⟩
  ·
    have hζ : IsGenericPoint hCirr.genericPoint C := hCirr.isGenericPoint_genericPoint hCcl
    have hζE : hCirr.genericPoint ∉ E := by
      intro h
      apply hCE
      exact hCmax.eq_of_subset hEirr (fun y hy => (hζ.specializes hy).mem_closed hEcl h)
    have hζr : hCirr.genericPoint ∈ Set.range i := by
      rw [hrange]; exact subset_closure hζE
    obtain ⟨z, hz⟩ := hζr
    have hzx : z ⤳ x' := by
      apply (i.isClosedEmbedding.isInducing.specializes_iff).mp
      rw [hz]
      exact hζ.specializes hxC
    obtain ⟨Q', hQ'⟩ : z ∈ Set.range (X'.fromSpecStalk x') := by
      rw [Scheme.range_fromSpecStalk]
      exact hzx
    refine ⟨Ideal.comap (i.stalkMap x').hom Q'.asIdeal,
      (by haveI := Q'.isPrime; exact Ideal.comap_isPrime _ _), ?_, ?_⟩
    · intro k hk
      rw [RingHom.mem_ker] at hk
      rw [Ideal.mem_comap, hk]
      exact Q'.asIdeal.zero_mem
    · intro hQm
      have h2 : PrimeSpectrum.comap (i.stalkMap x').hom Q' =
          IsLocalRing.closedPoint (X.presheaf.stalk (i x')) := PrimeSpectrum.ext hQm
      have h1 := hsq Q'
      rw [h2, Scheme.fromSpecStalk_closedPoint, hQ', hz] at h1
      apply hζE
      rw [← h1]
      exact hxE

theorem wcpa_dj_lcc_fsbc_branch_regular : ∀ (K A : Type u) [Field K] [CommRing A] [IsLocalRing A] [IsNoetherianRing A], Nonempty (AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)})) → ∀ J : Ideal A, J.IsRadical → (∃ P : Ideal A, P.IsPrime ∧ ¬ J ≤ P) → (∃ Q : Ideal A, Q.IsPrime ∧ J ≤ Q ∧ Q ≠ IsLocalRing.maximalIdeal A) → IsRegularLocalRing (A ⧸ J) ∧ ringKrullDim (A ⧸ J) = 1 :=
by
  intro K A _ _ _ _ he J hrad hP hQex
  have T1 : ∀ (i j : Fin 2), i ≠ j → ∃ (ψ : (MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) →+* PowerSeries K) (σ : PowerSeries K →+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)})), ψ (Ideal.Quotient.mk _ (MvPowerSeries.X i)) = PowerSeries.X ∧ σ PowerSeries.X = Ideal.Quotient.mk _ (MvPowerSeries.X i) ∧ (∀ g, ψ (σ g) = g) ∧ RingHom.ker ψ = Ideal.span {Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) (MvPowerSeries.X j)} := by
    intro i j hij
    classical
    let ι : Unit ↪ Fin 2 := ⟨fun _ => i, fun _ _ _ => rfl⟩
    let ψt : MvPowerSeries (Fin 2) K →+* PowerSeries K := (MvPowerSeries.killCompl (R := K) ι).toRingHom
    have hcoeff : ∀ (f : MvPowerSeries (Fin 2) K) (x : Unit →₀ ℕ),
        MvPowerSeries.coeff x (ψt f) = MvPowerSeries.coeff (Finsupp.embDomain ι x) f :=
      fun f x => MvPowerSeries.coeff_killCompl f x
    have hXj : ψt (MvPowerSeries.X j) = 0 := by
      apply MvPowerSeries.ext
      intro x
      rw [hcoeff, MvPowerSeries.coeff_X, if_neg, map_zero]
      intro h
      have h1 : (Finsupp.embDomain ι x) j = 0 :=
        Finsupp.embDomain_notin_range ι x j (by rintro ⟨_, h'⟩; exact hij h')
      have h2 := DFunLike.congr_fun h j
      rw [h1, Finsupp.single_eq_same] at h2
      exact zero_ne_one h2
    have hXi : ψt (MvPowerSeries.X i) = PowerSeries.X :=
      MvPowerSeries.killCompl_X (R := K) (e := ι) ()
    have hprod : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K) =
        MvPowerSeries.X j * MvPowerSeries.X i := by
      fin_cases i <;> fin_cases j <;> simp_all [mul_comm]
    have hker0 : ∀ y ∈ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)},
        ψt y = 0 := by
      intro y hy
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hy
      rw [map_mul, hprod, map_mul, hXj, zero_mul, mul_zero]
    refine ⟨Ideal.Quotient.lift _ ψt hker0,
      (Ideal.Quotient.mk _).comp (PowerSeries.toMvPowerSeries (R := K) i).toRingHom, ?_, ?_, ?_, ?_⟩
    · rw [Ideal.Quotient.lift_mk]; exact hXi
    · show Ideal.Quotient.mk _ (PowerSeries.toMvPowerSeries i PowerSeries.X) = _
      rw [PowerSeries.toMvPowerSeries_X]
    · intro g
      show ψt (PowerSeries.toMvPowerSeries i g) = g
      apply MvPowerSeries.ext
      intro x
      rw [hcoeff, PowerSeries.toMvPowerSeries_apply]
      exact MvPowerSeries.coeff_embDomain_rename ι g x
    · apply le_antisymm
      · intro x hx
        obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
        rw [RingHom.mem_ker, Ideal.Quotient.lift_mk] at hx
        have hdvd : (MvPowerSeries.X j : MvPowerSeries (Fin 2) K) ∣ f := by
          rw [MvPowerSeries.X_dvd_iff]
          intro m hm
          have hm' : m = Finsupp.embDomain ι (Finsupp.single () (m i)) := by
            rw [Finsupp.embDomain_single]
            ext k
            by_cases hk : k = i
            · subst hk
              show m k = (Finsupp.single k (m k)) k
              simp
            · have hkj : k = j := by
                fin_cases i <;> fin_cases j <;> fin_cases k <;> simp_all
              subst hkj
              show m k = (Finsupp.single i (m i)) k
              rw [hm]
              simp [Finsupp.single_apply, hij]
          rw [hm', ← hcoeff, hx, map_zero]
        obtain ⟨g, rfl⟩ := hdvd
        rw [map_mul]
        exact Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self _)
      · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
          Ideal.Quotient.lift_mk]
        exact hXj
  have T2 : ∀ (R : Type u) [CommRing R] (a b : R) (ψ : R →+* PowerSeries K) (σ : PowerSeries K →+* R), ψ b = PowerSeries.X → (∀ g, ψ (σ g) = g) → RingHom.ker ψ = Ideal.span {a} → (Ideal.span {a}).IsPrime ∧ ∀ P : Ideal R, P.IsPrime → a ∈ P → P = Ideal.span {a} ∨ P = Ideal.span {a, b} := by
    intro R _ a b ψ σ hb hψσ hker
    have hsurj : Function.Surjective ψ := fun g => ⟨σ g, hψσ g⟩
    refine ⟨hker ▸ RingHom.ker_isPrime ψ, fun P hP haP => ?_⟩
    have hkP : RingHom.ker ψ ≤ P := by
      rw [hker, Ideal.span_le, Set.singleton_subset_iff]; exact haP
    haveI := hP
    have hP' : (Ideal.map ψ P).IsPrime := Ideal.map_isPrime_of_surjective hsurj hkP
    have hPc : Ideal.comap ψ (Ideal.map ψ P) = P := by
      rw [Ideal.comap_map_of_surjective ψ hsurj]
      exact sup_eq_left.mpr hkP
    by_cases h0 : Ideal.map ψ P = ⊥
    · left
      rw [← hPc, h0, ← hker]
      rfl
    · right
      have hmax : (Ideal.map ψ P).IsMaximal := hP'.isMaximal h0
      have hX : Ideal.map ψ P = Ideal.span {PowerSeries.X} := by
        rw [IsLocalRing.eq_maximalIdeal hmax, PowerSeries.maximalIdeal_eq_span_X]
      rw [← hPc, hX]
      apply le_antisymm
      · intro x hx
        rw [Ideal.mem_comap, Ideal.mem_span_singleton'] at hx
        obtain ⟨g, hg⟩ := hx
        have hk : x - σ g * b ∈ RingHom.ker ψ := by
          rw [RingHom.mem_ker, map_sub, map_mul, hψσ, hb, hg, sub_self]
        rw [hker, Ideal.mem_span_singleton'] at hk
        obtain ⟨c, hc⟩ := hk
        rw [Ideal.mem_span_pair]
        exact ⟨c, σ g, by rw [hc]; ring⟩
      · rw [Ideal.span_le]
        rintro z (rfl | rfl)
        · show ψ z ∈ Ideal.span {PowerSeries.X}
          have : ψ z = 0 := by
            rw [← RingHom.mem_ker, hker]; exact Ideal.mem_span_singleton_self z
          rw [this]; exact Ideal.zero_mem _
        · show ψ z ∈ Ideal.span {PowerSeries.X}
          rw [hb]; exact Ideal.mem_span_singleton_self _
  have T3 : ∀ (R : Type u) [CommRing R] (a b : R) (ψ : R →+* PowerSeries K) (σ : PowerSeries K →+* R), a * b = 0 → σ PowerSeries.X = a → (∀ g, ψ (σ g) = g) → RingHom.ker ψ = Ideal.span {b} → ∀ (I : Ideal R), I ≤ Ideal.span {a} → I ≠ ⊥ → (∀ w, a * w ∈ I → b * w ∈ I → w ∈ I) → a ∈ I := by
    intro R _ a b ψ σ hab hσX hψσ hker I hIa hI0 hcol
    have key : ∀ f, a * f = a * σ (ψ f) := by
      intro f
      have hk : f - σ (ψ f) ∈ RingHom.ker ψ := by rw [RingHom.mem_ker, map_sub, hψσ, sub_self]
      rw [hker, Ideal.mem_span_singleton'] at hk
      obtain ⟨c, hc⟩ := hk
      have h1 : a * f - a * σ (ψ f) = c * (a * b) := by rw [← mul_sub, ← hc]; ring
      rw [hab, mul_zero] at h1
      exact sub_eq_zero.mp h1
    let J' : Ideal (PowerSeries K) :=
      { carrier := {g | a * σ g ∈ I}
        add_mem' := by
          intro x y hx hy
          simp only [Set.mem_setOf_eq, map_add, mul_add] at *
          exact I.add_mem hx hy
        zero_mem' := by simp
        smul_mem' := by
          intro c x hx
          simp only [Set.mem_setOf_eq, smul_eq_mul, map_mul] at *
          rw [mul_left_comm]
          exact I.mul_mem_left _ hx }
    have hmem : ∀ g, g ∈ J' ↔ a * σ g ∈ I := fun g => Iff.rfl
    have hJ'0 : J' ≠ ⊥ := by
      obtain ⟨y, hyI, hy0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hI0
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp (hIa hyI)
      intro hbot
      have hg : ψ c ∈ J' := by rw [hmem, ← key, mul_comm]; exact hyI
      rw [hbot, Ideal.mem_bot] at hg
      apply hy0
      rw [mul_comm, key, hg, map_zero, mul_zero]
    obtain ⟨n, hn⟩ :=
      IsDiscreteValuationRing.ideal_eq_span_pow_irreducible hJ'0 PowerSeries.X_irreducible
    have hXn : PowerSeries.X ^ n ∈ J' := by rw [hn]; exact Ideal.mem_span_singleton_self _
    cases n with
    | zero =>
      rw [hmem, pow_zero, map_one, mul_one] at hXn
      exact hXn
    | succ m =>
      exfalso
      have hw : a * σ (PowerSeries.X ^ m) ∈ I := by
        apply hcol
        · have h2 : a * (a * σ (PowerSeries.X ^ m)) = a * σ (PowerSeries.X ^ (m + 1)) := by
            rw [pow_succ', map_mul, hσX]
          rw [h2]; exact hXn
        · rw [← mul_assoc, mul_comm b a, hab, zero_mul]; exact I.zero_mem
      have h1 : PowerSeries.X ^ m ∈ J' := hw
      rw [hn, Ideal.mem_span_singleton] at h1
      have := (pow_dvd_pow_iff PowerSeries.X_ne_zero PowerSeries.X_irreducible.not_isUnit).mp h1
      omega
  have T4 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (p q x : R), Ideal.span {p, q} = IsLocalRing.maximalIdeal R → x - q ∈ Ideal.span {p, q} ^ 2 → q ∈ Ideal.span {p, x} := by
    intro R _ _ p q x hN hx
    have hle : Ideal.span {p, q} ^ 2 ≤ Ideal.span {p} ⊔ Ideal.span {q} * Ideal.span {p, q} := by
      rw [pow_two]
      conv_lhs => rw [show Ideal.span {p, q} = Ideal.span {p} ⊔ Ideal.span {q} from
        Ideal.span_insert p {q}]
      rw [Ideal.sup_mul, ← Ideal.span_insert]
      exact sup_le_sup (Ideal.mul_le_inf.trans inf_le_left) le_rfl
    obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp (hle hx)
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hy
    obtain ⟨n, hn, hqn⟩ := Ideal.mem_span_singleton_mul.mp hz
    have hu : IsUnit (1 + n) := by
      by_contra hnu
      have h1 : 1 + n ∈ IsLocalRing.maximalIdeal R := (IsLocalRing.mem_maximalIdeal _).mpr hnu
      rw [← hN] at h1
      have h2 : (1 : R) ∈ Ideal.span {p, q} := by
        have := Ideal.sub_mem _ h1 hn
        simpa using this
      rw [hN] at h2
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top ((Ideal.eq_top_iff_one _).mpr h2)
    obtain ⟨v, hv⟩ := hu.exists_right_inv
    have hqu : q * (1 + n) = x - c * p := by linear_combination hqn + hyz + hc
    rw [Ideal.mem_span_pair]
    exact ⟨-(c * v), v, by linear_combination (-v) * hqu + q * hv⟩
  have T5 : ∀ (S : Type u) [CommRing S] (e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* S), (∀ (I : Ideal A), Ideal.comap (e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) (Ideal.map (e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) I) = I) ∧ (∀ p : Ideal A, p.IsPrime → ∃ P : Ideal S, P.IsPrime ∧ Ideal.comap (e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) P = p) ∧ (∀ (I : Ideal A) (t : A), (∀ y : A, t * y ∈ I → y ∈ I) → ∀ w : S, (e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) t * w ∈ Ideal.map (e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) I → w ∈ Ideal.map (e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) I) ∧ (∀ x : A, IsUnit ((e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) x) → IsUnit x) := by
    intro S _ e
    set Ah := AdicCompletion (IsLocalRing.maximalIdeal A) A
    set α := algebraMap A Ah with hα
    haveI : Module.FaithfullyFlat A Ah := Module.FaithfullyFlat.of_flat_of_isLocalHom
    have hmap : ∀ I : Ideal A, Ideal.map (e.toRingHom.comp α) I = Ideal.map e.toRingHom (Ideal.map α I) :=
      fun I => (Ideal.map_map α e.toRingHom).symm
    have hcomap : ∀ P : Ideal S, Ideal.comap (e.toRingHom.comp α) P = Ideal.comap α (Ideal.comap e.toRingHom P) :=
      fun P => (Ideal.comap_comap α e.toRingHom).symm
    have hbij : Function.Bijective e.toRingHom := e.bijective
    refine ⟨fun I => ?_, fun p hp => ?_, fun I t ht w hw => ?_, fun x hx => ?_⟩
    · rw [hmap, hcomap, Ideal.comap_map_of_bijective _ hbij]
      exact Ideal.comap_map_eq_self_of_faithfullyFlat I
    · obtain ⟨q, hq⟩ := PrimeSpectrum.comap_surjective_of_faithfullyFlat (A := A) (B := Ah) ⟨p, hp⟩
      refine ⟨Ideal.comap e.symm.toRingHom q.asIdeal, Ideal.comap_isPrime _ _, ?_⟩
      have hq' : Ideal.comap (algebraMap A Ah) q.asIdeal = p := congrArg PrimeSpectrum.asIdeal hq
      rw [← hq']
      ext x
      simp [Ideal.mem_comap, α]
    ·
      have hreg : IsSMulRegular (A ⧸ I) t := by
        intro y z hyz
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
        obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z
        change t • Ideal.Quotient.mk I y = t • Ideal.Quotient.mk I z at hyz
        rw [Algebra.smul_def, Algebra.smul_def, Ideal.Quotient.algebraMap_eq, ← map_mul, ← map_mul,
          Ideal.Quotient.eq] at hyz
        rw [Ideal.Quotient.eq]
        apply ht
        rw [mul_sub]
        exact hyz
      have hreg2 : IsSMulRegular (TensorProduct A Ah (A ⧸ I)) t := hreg.lTensor Ah
      have hiff : ∀ v : S, v ∈ Ideal.map (e.toRingHom.comp α) I ↔ e.symm v ∈ Ideal.map α I := by
        intro v
        rw [hmap]
        constructor
        · intro hv
          have h := Ideal.mem_map_of_mem e.symm.toRingHom hv
          rw [Ideal.map_map] at h
          have he : e.symm.toRingHom.comp e.toRingHom = RingHom.id Ah := e.symm_toRingHom_comp_toRingHom
          rw [he, Ideal.map_id] at h
          exact h
        · intro hv
          have h := Ideal.mem_map_of_mem e.toRingHom hv
          simpa using h
      rw [hiff] at hw ⊢
      have hw2 : α t * e.symm w ∈ Ideal.map α I := by
        simpa only [RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingHom.coe_coe, map_mul,
          RingEquiv.symm_apply_apply] using hw
      have h0 : (α t * e.symm w) ⊗ₜ[A] (1 : A ⧸ I) = 0 := by
        rw [← Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk Ah I,
          Ideal.Quotient.eq_zero_iff_mem.mpr hw2, map_zero]
      have h1 : t • (e.symm w ⊗ₜ[A] (1 : A ⧸ I)) = t • (0 : TensorProduct A Ah (A ⧸ I)) := by
        rw [smul_zero, TensorProduct.smul_tmul', Algebra.smul_def]
        exact h0
      have h2 := hreg2 h1
      rw [← Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk Ah I] at h2
      have h3 := (Algebra.TensorProduct.quotIdealMapEquivTensorQuot Ah I).injective
        (h2.trans (map_zero _).symm)
      exact Ideal.Quotient.eq_zero_iff_mem.mp h3
    · have h1 : IsUnit (α x) := by
        have := hx.map e.symm.toRingHom
        simpa using this
      exact isUnit_of_map_unit α x h1
  have s7 : ∀ (J : Ideal A) (r : A), J.IsPrime → r ∈ IsLocalRing.maximalIdeal A → r ∉ J → IsLocalRing.maximalIdeal A = Ideal.span {r} ⊔ J → IsRegularLocalRing (A ⧸ J) ∧ ringKrullDim (A ⧸ J) = 1 := by
    intro J r hJ hr hrJ hm
    haveI : Nontrivial (A ⧸ J) := Ideal.Quotient.nontrivial_iff.mpr hJ.ne_top
    haveI : IsLocalRing (A ⧸ J) :=
      IsLocalRing.of_surjective' (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
    haveI : IsDomain (A ⧸ J) := Ideal.Quotient.isDomain J
    have hJm : J ≤ IsLocalRing.maximalIdeal A := IsLocalRing.le_maximalIdeal hJ.ne_top
    have hmax : IsLocalRing.maximalIdeal (A ⧸ J) = Ideal.span {Ideal.Quotient.mk J r} := by
      apply le_antisymm
      · intro x hx
        obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective x
        have hy : y ∈ IsLocalRing.maximalIdeal A := by
          by_contra h
          have hu : IsUnit y := IsLocalRing.notMem_maximalIdeal.mp h
          exact (IsLocalRing.mem_maximalIdeal _).mp hx (hu.map _)
        rw [hm, Ideal.mem_span_singleton_sup] at hy
        obtain ⟨c, j, hj, rfl⟩ := hy
        rw [Ideal.mem_span_singleton']
        exact ⟨Ideal.Quotient.mk J c, by
          rw [map_add, map_mul, Ideal.Quotient.eq_zero_iff_mem.mpr hj, add_zero]⟩
      · rw [Ideal.span_le, Set.singleton_subset_iff]
        show Ideal.Quotient.mk J r ∈ IsLocalRing.maximalIdeal (A ⧸ J)
        rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
        rintro ⟨v, hv⟩
        obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (v⁻¹ : (A ⧸ J)ˣ).1
        have h1 : Ideal.Quotient.mk J (r * y - 1) = 0 := by
          rw [map_sub, map_mul, hy, map_one, ← hv]
          simp
        have h2 : r * y - 1 ∈ IsLocalRing.maximalIdeal A :=
          hJm (Ideal.Quotient.eq_zero_iff_mem.mp h1)
        have h3 : r * y ∈ IsLocalRing.maximalIdeal A := Ideal.mul_mem_right _ _ hr
        have h4 : (1 : A) ∈ IsLocalRing.maximalIdeal A := by
          have := Ideal.sub_mem _ h3 h2
          simpa using this
        exact (IsLocalRing.maximalIdeal.isMaximal A).ne_top ((Ideal.eq_top_iff_one _).mpr h4)
    have hne : Ideal.Quotient.mk J r ≠ 0 := fun h => hrJ (Ideal.Quotient.eq_zero_iff_mem.mp h)
    have hnf : ¬ IsField (A ⧸ J) := by
      rw [IsLocalRing.isField_iff_maximalIdeal_eq, hmax]
      intro h
      exact hne (Ideal.span_singleton_eq_bot.mp h)
    have hdvr : IsDiscreteValuationRing (A ⧸ J) :=
      ((IsDiscreteValuationRing.TFAE (A ⧸ J) hnf).out 1 5).mpr
        (⟨⟨Ideal.Quotient.mk J r, hmax⟩⟩ : Submodule.IsPrincipal (IsLocalRing.maximalIdeal (A ⧸ J)))
    exact ⟨inferInstance, IsDiscreteValuationRing.ringKrullDim_eq_one _⟩
  have s6 : ∀ (S : Type u) [CommRing S] (θ : A →+* S) (a b : S) (J : Ideal A), (∀ I : Ideal A, Ideal.comap θ (Ideal.map θ I) = I) → (∀ p : Ideal A, p.IsPrime → ∃ P : Ideal S, P.IsPrime ∧ Ideal.comap θ P = p) → (∀ (I : Ideal A) (t : A), (∀ y : A, t * y ∈ I → y ∈ I) → ∀ w : S, θ t * w ∈ Ideal.map θ I → w ∈ Ideal.map θ I) → (∀ P : Ideal S, P.IsPrime → P = Ideal.span {a} ∨ P = Ideal.span {b} ∨ P = Ideal.span {a, b}) → Ideal.comap θ (Ideal.span {a, b}) = IsLocalRing.maximalIdeal A → (∀ I : Ideal S, I ≤ Ideal.span {a} → I ≠ ⊥ → (∀ w : S, a * w ∈ I → b * w ∈ I → w ∈ I) → a ∈ I) → (∃ r : A, r ∈ IsLocalRing.maximalIdeal A ∧ b ∈ Ideal.span {a, θ r}) → (Ideal.span {a}).IsPrime → Ideal.comap θ (Ideal.span {a}) ≠ IsLocalRing.maximalIdeal A → J.IsRadical → (∃ P : Ideal A, P.IsPrime ∧ ¬ J ≤ P) → J ≤ Ideal.comap θ (Ideal.span {a}) → J.IsPrime ∧ ∃ r : A, r ∈ IsLocalRing.maximalIdeal A ∧ r ∉ J ∧ IsLocalRing.maximalIdeal A = Ideal.span {r} ⊔ J := by
    intro S _ θ a b J hF1 hF2 hF4 hcl hM hN3 hD ha hqa hrad hP hJ
    have step1 : ∀ p : Ideal A, p.IsPrime → p = Ideal.comap θ (Ideal.span {a}) ∨
        p = Ideal.comap θ (Ideal.span {b}) ∨ p = IsLocalRing.maximalIdeal A := by
      intro p hp
      obtain ⟨P, hPp, rfl⟩ := hF2 p hp
      rcases hcl P hPp with h | h | h
      · left; rw [h]
      · right; left; rw [h]
      · right; right; rw [h, hM]
    have hqam : Ideal.comap θ (Ideal.span {a}) ≤ IsLocalRing.maximalIdeal A := by
      rw [← hM]
      exact Ideal.comap_mono (Ideal.span_mono (by simp))
    have hJm : J ≤ IsLocalRing.maximalIdeal A := hJ.trans hqam
    have hJeq : J = Ideal.comap θ (Ideal.span {a}) := by
      apply le_antisymm hJ
      rw [← hrad.radical, Ideal.radical_eq_sInf]
      apply le_sInf
      rintro p ⟨hJp, hp⟩
      rcases step1 p hp with h | h | h
      · rw [h]
      · exfalso
        obtain ⟨P, hPp, hJP⟩ := hP
        apply hJP
        rcases step1 P hPp with h' | h' | h'
        · rw [h']; exact hJ
        · rw [h', ← h]; exact hJp
        · rw [h']; exact hJm
      · rw [h]; exact hqam
    have hJprime : J.IsPrime := by
      rw [hJeq]
      exact Ideal.comap_isPrime θ _
    have hJbot : J ≠ ⊥ := by
      intro h
      obtain ⟨P, _, hJP⟩ := hP
      exact hJP (h ▸ bot_le)
    have hJne : J ≠ IsLocalRing.maximalIdeal A := by
      rw [hJeq]; exact hqa
    obtain ⟨t, htm, htJ⟩ := SetLike.exists_of_lt (lt_of_le_of_ne hJm hJne)
    have haI : a ∈ Ideal.map θ J := by
      apply hN3
      · exact Ideal.map_le_iff_le_comap.mpr hJ
      · intro h
        apply hJbot
        have h1 := hF1 J
        have h2 := hF1 ⊥
        rw [h] at h1
        rw [Ideal.map_bot] at h2
        rw [← h1, h2]
      · intro w haw hbw
        have ht : θ t ∈ Ideal.span {a, b} := by
          rw [← hM] at htm
          exact htm
        obtain ⟨x, y, hxy⟩ := Ideal.mem_span_pair.mp ht
        apply hF4 J t (fun y hy => (hJprime.mem_or_mem hy).resolve_left htJ) w
        rw [← hxy]
        have : (x * a + y * b) * w = x * (a * w) + y * (b * w) := by ring
        rw [this]
        exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ haw) (Ideal.mul_mem_left _ _ hbw)
    obtain ⟨r, hrm, hbr⟩ := hD
    have hmeq : IsLocalRing.maximalIdeal A = Ideal.span {r} ⊔ J := by
      apply le_antisymm
      · have hsub : Ideal.span {a, b} ≤ Ideal.map θ (Ideal.span {r} ⊔ J) := by
          have haM : a ∈ Ideal.map θ (Ideal.span {r} ⊔ J) := Ideal.map_mono le_sup_right haI
          have hrM : θ r ∈ Ideal.map θ (Ideal.span {r} ⊔ J) :=
            Ideal.mem_map_of_mem θ (Ideal.mem_sup_left (Ideal.mem_span_singleton_self r))
          have hbM : b ∈ Ideal.map θ (Ideal.span {r} ⊔ J) := by
            have : Ideal.span {a, θ r} ≤ Ideal.map θ (Ideal.span {r} ⊔ J) := by
              rw [Ideal.span_le]
              intro z hz
              rcases hz with rfl | rfl
              · exact haM
              · exact hrM
            exact this hbr
          rw [Ideal.span_le]
          intro z hz
          rcases hz with rfl | rfl
          · exact haM
          · exact hbM
        calc IsLocalRing.maximalIdeal A = Ideal.comap θ (Ideal.span {a, b}) := hM.symm
          _ ≤ Ideal.comap θ (Ideal.map θ (Ideal.span {r} ⊔ J)) := Ideal.comap_mono hsub
          _ = Ideal.span {r} ⊔ J := hF1 _
      · refine sup_le ?_ hJm
        rw [Ideal.span_le, Set.singleton_subset_iff]
        exact hrm
    refine ⟨hJprime, r, hrm, ?_, hmeq⟩
    intro hrJ
    apply hJne
    rw [hmeq]
    refine le_antisymm le_sup_right (sup_le ?_ le_rfl)
    rw [Ideal.span_le, Set.singleton_subset_iff]
    exact hrJ
  obtain ⟨e⟩ := he
  obtain ⟨Q, hQ, hJQ, hQm⟩ := hQex
  classical

  obtain ⟨ψ1, σ1, hψ1b, hσ1, hψσ1, hker1⟩ := T1 1 0 (by decide)
  obtain ⟨ψ0, σ0, hψ0a, hσ0, hψσ0, hker0⟩ := T1 0 1 (by decide)
  set a : MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)} :=
    Ideal.Quotient.mk _ (MvPowerSeries.X 0) with ha
  set b : MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)} :=
    Ideal.Quotient.mk _ (MvPowerSeries.X 1) with hb
  have hab : a * b = 0 := by
    rw [ha, hb, ← map_mul]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
  have hba : b * a = 0 := (mul_comm b a).trans hab
  have hpair : Ideal.span {b, a} = Ideal.span {a, b} := by rw [Set.pair_comm]
  obtain ⟨hpa, hPa⟩ := T2 _ a b ψ1 σ1 hψ1b hψσ1 hker1
  obtain ⟨hpb, hPb⟩ := T2 _ b a ψ0 σ0 hψ0a hψσ0 hker0
  have hcl : ∀ P : Ideal (MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}),
      P.IsPrime → P = Ideal.span {a} ∨ P = Ideal.span {b} ∨ P = Ideal.span {a, b} := by
    intro P hP'
    have h0 : a * b ∈ P := by rw [hab]; exact P.zero_mem
    rcases hP'.mem_or_mem h0 with h | h
    · rcases hPa P hP' h with h' | h'
      · exact Or.inl h'
      · exact Or.inr (Or.inr h')
    · rcases hPb P hP' h with h' | h'
      · exact Or.inr (Or.inl h')
      · exact Or.inr (Or.inr (h'.trans hpair))
  have hcl' : ∀ P : Ideal (MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}),
      P.IsPrime → P = Ideal.span {b} ∨ P = Ideal.span {a} ∨ P = Ideal.span {b, a} := by
    intro P hP'
    rcases hcl P hP' with h | h | h
    · exact Or.inr (Or.inl h)
    · exact Or.inl h
    · exact Or.inr (Or.inr (h.trans hpair.symm))

  have hmaxM : ∀ f : MvPowerSeries (Fin 2) K, MvPowerSeries.constantCoeff f = 0 →
      f ∈ Ideal.span {(MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K), MvPowerSeries.X 1} := by
    intro g hg
    let g₁ : MvPowerSeries (Fin 2) K := fun m => if m 0 = 0 then MvPowerSeries.coeff m g else 0
    have hg₁ : ∀ m, MvPowerSeries.coeff m g₁ = if m 0 = 0 then MvPowerSeries.coeff m g else 0 :=
      fun m => rfl
    obtain ⟨h₀, e₀⟩ : (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K) ∣ g - g₁ := by
      rw [MvPowerSeries.X_dvd_iff]
      intro m hm
      rw [map_sub, hg₁, if_pos hm, sub_self]
    obtain ⟨h₁, e₁⟩ : (MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K) ∣ g₁ := by
      rw [MvPowerSeries.X_dvd_iff]
      intro m hm
      rw [hg₁]
      split_ifs with h0
      · have hm0 : m = 0 := by
          ext i
          fin_cases i
          · simpa using h0
          · simpa using hm
        rw [hm0, MvPowerSeries.coeff_zero_eq_constantCoeff_apply, hg]
      · rfl
    rw [Ideal.mem_span_pair]
    refine ⟨h₀, h₁, ?_⟩
    rw [mul_comm h₀, mul_comm h₁, ← e₀, ← e₁, sub_add_cancel]
  have hNne : Ideal.span {a, b} ≠ ⊤ := by
    intro htop
    have h1 : (1 : MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) ∈ Ideal.span {a, b} := by
      rw [htop]; exact Submodule.mem_top
    obtain ⟨x, y, hxy⟩ := Ideal.mem_span_pair.mp h1
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [ha, hb, ← map_mul, ← map_mul, ← map_add, ← map_one (Ideal.Quotient.mk _),
      Ideal.Quotient.eq, Ideal.mem_span_singleton'] at hxy
    obtain ⟨G, hG⟩ := hxy
    have hc := congrArg MvPowerSeries.constantCoeff hG
    simp only [map_mul, map_sub, map_add, map_one, MvPowerSeries.constantCoeff_X, mul_zero,
      zero_add, zero_sub] at hc
    have : (0 : K) = -1 := hc
    simp at this
  have hunitR : ∀ x : MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)},
      x ∉ Ideal.span {a, b} → IsUnit x := by
    intro x hx
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
    have hf : MvPowerSeries.constantCoeff f ≠ 0 := by
      intro h0
      apply hx
      have h1 := Ideal.mem_map_of_mem (Ideal.Quotient.mk (Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)})) (hmaxM f h0)
      rwa [Ideal.map_span, Set.image_pair] at h1
    have hfu : IsUnit f := MvPowerSeries.isUnit_iff_constantCoeff.mpr (isUnit_iff_ne_zero.mpr hf)
    exact hfu.map _
  haveI : Nontrivial (MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) := by
    by_contra hnt
    rw [not_nontrivial_iff_subsingleton] at hnt
    exact hNne (Subsingleton.elim _ _)
  haveI : IsLocalRing (MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  have Tden : ∀ c : MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}, ∃ r : A, (e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) r - c ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) ^ 2 := by
    intro c
    have hfg : (IsLocalRing.maximalIdeal A).FG := IsNoetherian.noetherian _
    have hmem : ∀ (k : ℕ) (b : AdicCompletion (IsLocalRing.maximalIdeal A) A),
        b ∈ Ideal.map (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
          (IsLocalRing.maximalIdeal A ^ k) ↔
        AdicCompletion.eval (IsLocalRing.maximalIdeal A) A k b = 0 := by
      intro k b
      have h1 := AdicCompletion.pow_smul_top_eq_ker_eval (M := A) (n := k) hfg
      have h2 := Ideal.smul_top_eq_map (S := AdicCompletion (IsLocalRing.maximalIdeal A) A)
        (IsLocalRing.maximalIdeal A ^ k)
      have h3 := SetLike.ext_iff.mp (h2.symm.trans h1) b
      rw [Submodule.restrictScalars_mem, LinearMap.mem_ker] at h3
      exact h3
    have hof : ∀ (k : ℕ) (p : A), AdicCompletion.eval (IsLocalRing.maximalIdeal A) A k
        (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) p) =
        Submodule.Quotient.mk p := by
      intro k p
      change AdicCompletion.eval (IsLocalRing.maximalIdeal A) A k
        (AdicCompletion.of (IsLocalRing.maximalIdeal A) A p) = _
      rw [AdicCompletion.eval_of]
      rfl
    obtain ⟨p, hp⟩ := Submodule.Quotient.mk_surjective _
      (AdicCompletion.eval (IsLocalRing.maximalIdeal A) A 2 (e.symm c))
    have h1 : e.symm c - algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A) p ∈
        Ideal.map (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
          (IsLocalRing.maximalIdeal A ^ 2) := by
      rw [hmem, map_sub, hof, hp, sub_self]
    have h2 : Ideal.map (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))
        (IsLocalRing.maximalIdeal A ^ 2) ≤
        IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal A) A) ^ 2 := by
      rw [Ideal.map_pow]
      apply Ideal.pow_right_mono
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      exact (IsLocalRing.mem_maximalIdeal _).mp hx
        (isUnit_of_map_unit (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) x hu)
    have h3 : Ideal.map e.toRingHom
        (IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal A) A) ^ 2) ≤
        IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) ^ 2 := by
      rw [Ideal.map_pow]
      apply Ideal.pow_right_mono
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      rw [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      apply (IsLocalRing.mem_maximalIdeal _).mp hx
      have := hu.map e.symm.toRingHom
      simpa using this
    refine ⟨p, ?_⟩
    have h4 := h3 (Ideal.mem_map_of_mem e.toRingHom (h2 h1))
    rw [map_sub] at h4
    have h5 : e.toRingHom (e.symm c) = c := by simp
    rw [h5] at h4
    rw [← neg_sub]
    exact (Ideal.neg_mem_iff _).mpr h4
  have hN : Ideal.span {a, b} = IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) K ⧸ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) := by
    apply le_antisymm (IsLocalRing.le_maximalIdeal hNne)
    intro x hx
    by_contra hxN
    exact (IsLocalRing.mem_maximalIdeal _).mp hx (hunitR x hxN)

  obtain ⟨hF1, hF2, hF4, hunit⟩ := T5 _ e
  set θ := e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)) with hθ
  have hM : Ideal.comap θ (Ideal.span {a, b}) = IsLocalRing.maximalIdeal A := by
    apply le_antisymm
    · apply IsLocalRing.le_maximalIdeal
      intro htop
      apply hNne
      rw [Ideal.eq_top_iff_one]
      have h1 : (1 : A) ∈ Ideal.comap θ (Ideal.span {a, b}) := by rw [htop]; exact Submodule.mem_top
      rw [Ideal.mem_comap, map_one] at h1
      exact h1
    · intro x hx
      rw [Ideal.mem_comap]
      by_contra hxN
      exact (IsLocalRing.mem_maximalIdeal _).mp hx (hunit x (hunitR _ hxN))
  have hM' : Ideal.comap θ (Ideal.span {b, a}) = IsLocalRing.maximalIdeal A := by rw [hpair]; exact hM
  have hden : ∀ c, ∃ r : A, r ∈ IsLocalRing.maximalIdeal A ∧ θ r - c ∈ Ideal.span {a, b} ^ 2 →
      True := fun _ => ⟨0, fun _ => trivial⟩
  clear hden
  have hden : ∀ c, c ∈ Ideal.span {a, b} → ∃ r : A, r ∈ IsLocalRing.maximalIdeal A ∧
      θ r - c ∈ Ideal.span {a, b} ^ 2 := by
    intro c hc
    obtain ⟨r, hr⟩ := Tden c
    rw [← hN] at hr
    refine ⟨r, ?_, hr⟩
    rw [← hM, Ideal.mem_comap]
    have : θ r = (θ r - c) + c := by ring
    rw [this]
    exact Ideal.add_mem _ (Ideal.pow_le_self two_ne_zero hr) hc
  obtain ⟨P', hP', hP'Q⟩ := hF2 Q hQ
  rcases hcl P' hP' with h | h | h
  ·
    rw [h] at hP'Q
    obtain ⟨r, hr, hrb⟩ := hden b (Ideal.subset_span (by simp))
    have hbr : b ∈ Ideal.span {a, θ r} := T4 _ a b (θ r) hN hrb
    obtain ⟨hJp, r', hr', hr'J, hm⟩ := s6 _ θ a b J hF1 hF2 hF4 hcl hM
      (fun I h1 h2 h3 => T3 _ a b ψ0 σ0 hab hσ0 hψσ0 hker0 I h1 h2 h3) ⟨r, hr, hbr⟩ hpa
      (by rw [hP'Q]; exact hQm) hrad hP (by rw [hP'Q]; exact hJQ)
    exact s7 J r' hJp hr' hr'J hm
  ·
    rw [h] at hP'Q
    obtain ⟨r, hr, hra⟩ := hden a (Ideal.subset_span (by simp))
    have har : a ∈ Ideal.span {b, θ r} := T4 _ b a (θ r) (hpair.trans hN) (by rw [hpair]; exact hra)
    obtain ⟨hJp, r', hr', hr'J, hm⟩ := s6 _ θ b a J hF1 hF2 hF4 hcl' hM'
      (fun I h1 h2 h3 => T3 _ b a ψ1 σ1 hba hσ1 hψσ1 hker1 I h1 h2 h3) ⟨r, hr, har⟩ hpb
      (by rw [hP'Q]; exact hQm) hrad hP (by rw [hP'Q]; exact hJQ)
    exact s7 J r' hJp hr' hr'J hm
  · exfalso
    apply hQm
    rw [← hP'Q, h, hM]

theorem wcpa_dj_lcc_fsbc_regular_smooth : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Y : Scheme.{u}) (q : Y ⟶ Spec (.of K)) [LocallyOfFiniteType q] (y : Y) (O : Y.Opens), y ∈ O → IsRegularLocalRing (Y.presheaf.stalk y) → ringKrullDim (Y.presheaf.stalk y) = 1 → (∀ z ∈ O, z ≠ y → ∃ W : Y.Opens, z ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q)) → ∃ W : Y.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q) :=
by
  intro K _ _ Y q _ y O hyO hreg hdim hsm
  haveI : PerfectField K := IsAlgClosed.perfectField K
  refine ⟨O, hyO, ?_⟩
  apply wc_odp_smooth_of_closed_regular K (O : Scheme.{u}) (O.ι ≫ q) 1
  intro z _
  by_cases h : z.1 = y
  · right
    let e : Y.presheaf.stalk z.1 ≃+* (O : Scheme.{u}).presheaf.stalk z :=
      ((O.stalkIso z).commRingCatIsoToRingEquiv).symm
    have hreg' : IsRegularLocalRing (Y.presheaf.stalk z.1) := h ▸ hreg
    have hdim' : ringKrullDim (Y.presheaf.stalk z.1) = 1 := h ▸ hdim
    haveI := hreg'
    refine ⟨IsRegularLocalRing.of_ringEquiv e, ?_⟩
    rw [← ringKrullDim_eq_of_ringEquiv e, hdim']
    simp
  · left
    obtain ⟨W, hzW, hW⟩ := hsm z.1 z.2 h
    let W' : (O : Scheme.{u}).Opens := O.ι ⁻¹ᵁ W
    have hr : Set.range (W'.ι ≫ O.ι) ⊆ Set.range W.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨a, rfl⟩
      have ha : W'.ι a ∈ W' := by
        rw [← SetLike.mem_coe, ← Scheme.Opens.range_ι]
        exact ⟨a, rfl⟩
      exact ha
    let g := IsOpenImmersion.lift W.ι (W'.ι ≫ O.ι) hr
    have hg : g ≫ W.ι = W'.ι ≫ O.ι := IsOpenImmersion.lift_fac _ _ _
    haveI : IsOpenImmersion (g ≫ W.ι) := by rw [hg]; infer_instance
    haveI : IsOpenImmersion g := IsOpenImmersion.of_comp g W.ι
    have hsm' := smoothOfRelativeDimension_comp 0 1 g (W.ι ≫ q)
    rw [← Category.assoc, hg, zero_add] at hsm'
    refine ⟨W', (W' : Scheme.{u}), W'.ι ≫ O.ι ≫ q, Iso.refl _, ?_, ?_, ?_⟩
    · show O.ι z ∈ W
      exact hzW
    · rw [← Category.assoc]; exact hsm'
    · simp

theorem wcpa_dj_lcc_fs_branch_curve : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X : Scheme.{u}) (p : X ⟶ Spec (.of K)) (E : Set X) (k : ℕ), IsProper p → (∀ x : X, (∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p)) ∨ (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap (X.presheaf.stalk x) (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C)) → E ∈ irreducibleComponents X → (∃ (Er : Scheme.{u}) (ι : Er ⟶ X) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧ θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ p) → (E ∩ closure Eᶜ).ncard = k → 1 ≤ k → ∃ (X' : Scheme.{u}) (i : X' ⟶ X) (n : Fin k → (Spec (.of K) ⟶ X')), IsClosedImmersion i ∧ IsReduced X' ∧ Set.range i = closure Eᶜ ∧ (∀ j, n j ≫ i ≫ p = 𝟙 _) ∧ (∀ j j', j ≠ j' → n j (IsLocalRing.closedPoint K) ≠ n j' (IsLocalRing.closedPoint K)) ∧ (∀ x : X, x ∈ E ∩ closure Eᶜ ↔ ∃ j, x = i (n j (IsLocalRing.closedPoint K))) ∧ ∀ j, ∃ W : X'.Opens, n j (IsLocalRing.closedPoint K) ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ i ≫ p) :=
by
  intro K _ _ X p E k hp hfib hE _hdat hk hk1
  classical
  haveI := hp

  obtain ⟨hXred, hcompfin, hSfin, hSclosed, hN⟩ :=
    wcpa_dj_lcc_fsbc_fibre_topology K X p E hp hfib hE
  have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE

  obtain ⟨X', i, hiCI, hX'red, hrange⟩ : ∃ (X' : Scheme.{u}) (i : X' ⟶ X),
      IsClosedImmersion i ∧ IsReduced X' ∧ Set.range i = closure Eᶜ := by
    refine ⟨_, (Scheme.IdealSheafData.vanishingIdeal
      (⟨closure Eᶜ, isClosed_closure⟩ : TopologicalSpace.Closeds X)).subschemeι, inferInstance,
      wcpa_dj_lq_vanishing_reduced X ⟨closure Eᶜ, isClosed_closure⟩, ?_⟩
    rw [Scheme.IdealSheafData.range_subschemeι, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  haveI := hiCI
  have hiinj : Function.Injective i := i.isClosedEmbedding.injective

  have hNfin : (E ∩ closure Eᶜ).Finite := Set.finite_of_ncard_ne_zero (by omega)
  have hlift : ∀ x ∈ E ∩ closure Eᶜ, ∃ m : Spec (.of K) ⟶ X',
      m ≫ i ≫ p = 𝟙 _ ∧ i (m (IsLocalRing.closedPoint K)) = x := by
    intro x hx
    have hcl : IsClosed ({x} : Set X) := hSclosed x (hN x hx).1
    obtain ⟨y₀, hy₀p, hy₀x⟩ := wc_glc_closed_point_section K X p x hcl
    have hsub : Set.range y₀ ⊆ Set.range i := by
      rintro _ ⟨q, rfl⟩
      obtain rfl : q = IsLocalRing.closedPoint K := Subsingleton.elim _ _
      rw [hy₀x, hrange]
      exact hx.2
    obtain ⟨m, hm⟩ := wc_ap_reduced_factor_closed_immersion (Spec (.of K)) X' X y₀ i hsub
    refine ⟨m, by rw [← Category.assoc, hm, hy₀p], ?_⟩
    rw [← hy₀x, ← hm]
    rfl
  choose mx hmxp hmxi using hlift
  have hF : hNfin.toFinset.card = k := by
    rw [← Set.ncard_eq_toFinset_card _ hNfin]
    exact hk
  let σ : Fin k ≃ hNfin.toFinset := (hNfin.toFinset.equivFin.trans (finCongr hF)).symm
  have hσmem : ∀ j, (σ j : X) ∈ E ∩ closure Eᶜ := fun j => (Set.Finite.mem_toFinset hNfin).mp (σ j).2
  let n : Fin k → (Spec (.of K) ⟶ X') := fun j => mx (σ j) (hσmem j)
  have hni : ∀ j, i (n j (IsLocalRing.closedPoint K)) = (σ j : X) := fun j => hmxi _ _
  have hdist : ∀ j j', j ≠ j' →
      n j (IsLocalRing.closedPoint K) ≠ n j' (IsLocalRing.closedPoint K) := by
    intro j j' hjj' heq
    apply hjj'
    apply σ.injective
    apply Subtype.ext
    rw [← hni j, ← hni j', heq]
  have hchar : ∀ x : X, x ∈ E ∩ closure Eᶜ ↔ ∃ j, x = i (n j (IsLocalRing.closedPoint K)) := by
    intro x
    constructor
    · intro hx
      refine ⟨σ.symm ⟨x, (Set.Finite.mem_toFinset hNfin).mpr hx⟩, ?_⟩
      rw [hni, Equiv.apply_symm_apply]
    · rintro ⟨j, rfl⟩
      rw [hni]
      exact hσmem j

  have hsm : ∀ j, ∃ W : X'.Opens, n j (IsLocalRing.closedPoint K) ∈ W ∧
      SmoothOfRelativeDimension 1 (W.ι ≫ i ≫ p) := by
    intro j
    have hxN : i (n j (IsLocalRing.closedPoint K)) ∈ E ∩ closure Eᶜ := by
      rw [hni]; exact hσmem j
    generalize n j (IsLocalRing.closedPoint K) = y at hxN ⊢
    obtain ⟨hNS, C, hC, hCE, hxC⟩ := hN (i y) hxN
    obtain ⟨e, -⟩ := (hfib (i y)).resolve_left hNS
    obtain ⟨hrad, hP, hQ⟩ := wcpa_dj_lcc_fsbc_stalk_ideal X X' i E C y hiCI hX'red hrange
      hcompfin hE hC hCE hxN.1 hxC
    haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian p
    obtain ⟨hreg, hdim⟩ := wcpa_dj_lcc_fsbc_branch_regular K (X.presheaf.stalk (i y)) ⟨e⟩ _
      hrad hP hQ
    have hsurj := wc_pfam_mc_closed_immersion_stalk_surj i hiCI y
    haveI := hreg
    have hreg' : IsRegularLocalRing (X'.presheaf.stalk y) :=
      IsRegularLocalRing.of_ringEquiv (RingHom.quotientKerEquivOfSurjective hsurj)
    have hdim' : ringKrullDim (X'.presheaf.stalk y) = 1 := by
      rw [← ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective hsurj)]
      exact hdim
    let T : Set X := {w | ¬ ∃ W : X.Opens, w ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p)} \ {i y}
    have hTfin : T.Finite := hSfin.subset Set.diff_subset
    have hTcl : IsClosed T := by
      have h := hTfin.isClosed_biUnion (f := fun t => ({t} : Set X)) (fun t ht => hSclosed t ht.1)
      rwa [Set.biUnion_of_singleton] at h
    let O : X'.Opens := i ⁻¹ᵁ ⟨Tᶜ, hTcl.isOpen_compl⟩
    have hyO : y ∈ O := fun h => h.2 rfl
    exact wcpa_dj_lcc_fsbc_regular_smooth K X' (i ≫ p) y O hyO hreg' hdim' (by
      intro z hz hzy
      have hzT : i z ∉ T := hz
      have hiz : i z ≠ i y := fun h => hzy (hiinj h)
      have hzS : ∃ W : X.Opens, i z ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p) := by
        by_contra hns
        exact hzT ⟨hns, hiz⟩
      have hzE : i z ∉ E := by
        intro hzE
        have hzN : i z ∈ E ∩ closure Eᶜ := ⟨hzE, by rw [← hrange]; exact ⟨z, rfl⟩⟩
        exact hzT ⟨(hN _ hzN).1, hiz⟩
      exact wcpa_dj_lcc_fsbc_smooth_off_E K X X' p i E z hXred hiCI hEcl hrange hzE hzS)
  exact ⟨X', i, n, hiCI, hX'red, hrange, fun j => hmxp _ _, hdist, hchar, hsm⟩

theorem wcpa_dj_lcc_gs_p1_smooth : ∀ (K : Type u) [Field K] (Er : Scheme.{u}) (q : Er ⟶ Spec (.of K)) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = q → ∀ e : Er, ∃ W : Er.Opens, e ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ q) :=
by
  intro K _ Er q θ hθ e
  haveI : IsZariskiLocalAtSource (@SmoothOfRelativeDimension 1) :=
    HasRingHomProperty.instIsZariskiLocalAtSource
  have h0 : SmoothOfRelativeDimension 1 (@Proj.toSpecZero _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫
      Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0)))) :=
    wc_p1_smooth_reldim_one K
  have hq : SmoothOfRelativeDimension 1 q := by
    rw [← hθ]
    exact IsZariskiLocalAtSource.comp h0 θ.hom
  exact ⟨⊤, trivial, IsZariskiLocalAtSource.comp hq _⟩

theorem wcpa_dj_lcc_gs_smooth_uniformizer : ∀ (K : Type u) [Field K] (Z : Scheme.{u}) (q : Z ⟶ Spec (.of K)) (σ : Spec (.of K) ⟶ Z) (W : Z.Opens), σ ≫ q = 𝟙 _ → σ (IsLocalRing.closedPoint K) ∈ W → SmoothOfRelativeDimension 1 (W.ι ≫ q) → ∃ t : Z.presheaf.stalk (σ (IsLocalRing.closedPoint K)), IsLocalRing.maximalIdeal (Z.presheaf.stalk (σ (IsLocalRing.closedPoint K))) = Ideal.span {t} ∧ t ∉ IsLocalRing.maximalIdeal (Z.presheaf.stalk (σ (IsLocalRing.closedPoint K))) ^ 2 :=
by
  intro K _ Z q σ W hσ hz hsm
  classical

  have A1 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsDomain R] [ValuationRing R]
      [IsNoetherianRing R], ringKrullDim R = ((1 : ℕ) : WithBot ℕ∞) →
      ∃ t : R, IsLocalRing.maximalIdeal R = Ideal.span {t} ∧
        t ∉ IsLocalRing.maximalIdeal R ^ 2 := by
    intro R _ _ _ _ _ hdim
    have hFG : (IsLocalRing.maximalIdeal R).FG := IsNoetherian.noetherian _
    haveI hP : (IsLocalRing.maximalIdeal R).IsPrincipal := IsBezout.isPrincipal_of_FG _ hFG
    set t := Submodule.IsPrincipal.generator (IsLocalRing.maximalIdeal R) with htdef
    have ht : IsLocalRing.maximalIdeal R = Ideal.span {t} :=
      (Submodule.IsPrincipal.span_singleton_generator (IsLocalRing.maximalIdeal R)).symm
    have ht0 : t ≠ 0 := by
      intro h0
      have hbot : IsLocalRing.maximalIdeal R = ⊥ := by
        rw [ht, h0, Ideal.span_singleton_eq_bot]
      have hF : IsField R := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hbot
      rw [ringKrullDim_eq_zero_of_isField hF] at hdim
      norm_num at hdim
    refine ⟨t, ht, ?_⟩
    intro hmem
    rw [ht, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hmem
    obtain ⟨r, hr⟩ := hmem
    have htm : t ∈ IsLocalRing.maximalIdeal R := by
      rw [ht]; exact Ideal.mem_span_singleton_self t
    have htr : t * r ∈ IsLocalRing.maximalIdeal R := Ideal.mul_mem_right r _ htm
    have hu : IsUnit (1 - t * r) :=
      IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ ((IsLocalRing.mem_maximalIdeal _).mp htr)
    have h0 : t * (1 - t * r) = 0 := by
      have e1 : t * (1 - t * r) = t - t ^ 2 * r := by ring
      rw [e1, ← hr, sub_self]
    exact ht0 ((IsUnit.mul_left_eq_zero hu).mp h0)

  have A2 : ∀ (A B : Type u) [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
      (e : A ≃+* B) (t : A), IsLocalRing.maximalIdeal A = Ideal.span {t} →
      t ∉ IsLocalRing.maximalIdeal A ^ 2 →
      IsLocalRing.maximalIdeal B = Ideal.span {e t} ∧ e t ∉ IsLocalRing.maximalIdeal B ^ 2 := by
    intro A B _ _ _ _ e t ht ht2
    have hmap : Ideal.map e (IsLocalRing.maximalIdeal A) = IsLocalRing.maximalIdeal B := by
      haveI := Ideal.map_isMaximal_of_equiv e (p := IsLocalRing.maximalIdeal A)
      exact IsLocalRing.eq_maximalIdeal this
    refine ⟨?_, ?_⟩
    · rw [← hmap, ht, Ideal.map_span, Set.image_singleton]
    · intro hmem
      rw [← hmap, ← Ideal.map_pow] at hmem
      obtain ⟨x, hx, hxe⟩ := (Ideal.mem_map_of_equiv e (e t)).mp hmem
      apply ht2
      rw [← e.injective hxe]
      exact hx

  let w : W.toScheme := ⟨σ (IsLocalRing.closedPoint K), hz⟩
  let s : W.toScheme ⟶ Spec (.of K) := W.ι ≫ q
  haveI : SmoothOfRelativeDimension 1 s := hsm
  haveI hdom : IsDomain (W.toScheme.presheaf.stalk w) :=
    wcpa_smooth_stalk_isDomain K W.toScheme s 1 w
  haveI hval : ValuationRing (W.toScheme.presheaf.stalk w) :=
    wcpa_dj_sgt_smooth_curve_stalk_valuation K W.toScheme s w
  haveI : Smooth s := SmoothOfRelativeDimension.smooth 1 s
  haveI : LocallyOfFiniteType s := inferInstance
  haveI : IsLocallyNoetherian W.toScheme := LocallyOfFiniteType.isLocallyNoetherian s
  have hzc : IsClosed ({σ (IsLocalRing.closedPoint K)} : Set Z) :=
    wc_pfam_mc_rational_point_closed K Z q σ hσ
  have hwc : IsClosed ({w} : Set W.toScheme) := by
    have e1 : ({w} : Set W.toScheme) = W.ι ⁻¹' {σ (IsLocalRing.closedPoint K)} := by
      ext x
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      constructor
      · rintro rfl; rfl
      · intro hx
        exact W.ι.isOpenEmbedding.injective (show W.ι x = W.ι w from hx)
    rw [e1]
    exact hzc.preimage W.ι.continuous
  have hdim : ringKrullDim (W.toScheme.presheaf.stalk w) = ((1 : ℕ) : WithBot ℕ∞) :=
    wc_lfi_smooth_stalk_dim K W.toScheme s 1 w hwc
  obtain ⟨t, ht, ht2⟩ := A1 (W.toScheme.presheaf.stalk w) hdim
  obtain ⟨h1, h2⟩ := A2 (W.toScheme.presheaf.stalk w)
    (Z.presheaf.stalk (σ (IsLocalRing.closedPoint K)))
    (W.stalkIso w).commRingCatIsoToRingEquiv t ht ht2
  exact ⟨_, h1, h2⟩

theorem wcpa_dj_lqr_quot_hilb : ∀ (L : Type u) [Field L] (R : Type u) [CommRing R] [IsLocalRing R] (φ : L →+* R) (ψ : R →+* (MvPowerSeries (Fin 2) L ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})), ψ.comp φ = (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})).comp MvPowerSeries.C → (∀ (n : ℕ) (t : MvPowerSeries (Fin 2) L), ∃ r : R, ψ r - Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}) t ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})) (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n)) → (∀ (n : ℕ) (r : R), ψ r ∈ Ideal.map (Ideal.Quotient.mk (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1})) (IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n) ↔ r ∈ IsLocalRing.maximalIdeal R ^ n) → letI : Algebra L R := φ.toAlgebra; ∀ n : ℕ, Module.finrank L (R ⧸ IsLocalRing.maximalIdeal R ^ n) = Module.finrank L (MvPowerSeries (Fin 2) L ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} ⊔ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n)) :=
by
  intro L _ R _ _ φ ψ H0 Hdens Hstr
  letI : Algebra L R := φ.toAlgebra
  intro n
  let I : Ideal (MvPowerSeries (Fin 2) L) := Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}
  let J : Ideal (MvPowerSeries (Fin 2) L) := IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n
  let E := DoubleQuot.quotQuotEquivQuotSup I J
  let Θ : R →+* MvPowerSeries (Fin 2) L ⧸ (I ⊔ J) :=
    E.toRingHom.comp ((Ideal.Quotient.mk (Ideal.map (Ideal.Quotient.mk I) J)).comp ψ)
  have star : ∀ t, E (Ideal.Quotient.mk (Ideal.map (Ideal.Quotient.mk I) J) (Ideal.Quotient.mk I t))
      = Ideal.Quotient.mk (I ⊔ J) t := fun t => DoubleQuot.quotQuotEquivQuotSup_quotQuotMk I J t
  have hsurj : Function.Surjective Θ := by
    intro y
    obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨r, hr⟩ := Hdens n t
    refine ⟨r, ?_⟩
    show E (Ideal.Quotient.mk _ (ψ r)) = _
    rw [← star t]
    congr 1
    exact Ideal.Quotient.eq.mpr hr
  have hker : ∀ r, Θ r = 0 ↔ r ∈ IsLocalRing.maximalIdeal R ^ n := by
    intro r
    rw [← Hstr n r]
    show E (Ideal.Quotient.mk _ (ψ r)) = 0 ↔ _
    rw [map_eq_zero_iff E E.injective, Ideal.Quotient.eq_zero_iff_mem]
  have hcomm : ∀ c : L, Θ (algebraMap L R c) = algebraMap L _ c := by
    intro c
    rw [RingHom.algebraMap_toAlgebra]
    have h1 : ψ (φ c) = Ideal.Quotient.mk I (MvPowerSeries.C c) := RingHom.congr_fun H0 c
    show E (Ideal.Quotient.mk _ (ψ (φ c))) = _
    rw [h1, star, ← Ideal.Quotient.mk_algebraMap, MvPowerSeries.algebraMap_apply,
      Algebra.algebraMap_self, RingHom.id_apply]
  let Θa : R →ₐ[L] MvPowerSeries (Fin 2) L ⧸ (I ⊔ J) := { Θ with commutes' := hcomm }
  have hkerEq : IsLocalRing.maximalIdeal R ^ n = RingHom.ker Θa := by
    ext r
    rw [RingHom.mem_ker]
    exact (hker r).symm
  have e := (Ideal.quotientEquivAlgOfEq L hkerEq).trans
    (Ideal.quotientKerAlgEquivOfSurjective (f := Θa) hsurj)
  exact e.toLinearEquiv.finrank_eq

theorem wcpa_dj_lqr_node_trunc_dim : ∀ (L : Type u) [Field L] (n : ℕ), 1 ≤ n → Module.finrank L (MvPowerSeries (Fin 2) L ⧸ (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} ⊔ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n)) = 2 * n - 1 :=
by
  intro L _ n hn
  classical

  have s1 : ∀ (k : ℕ) (N : MvPowerSeries (Fin 2) L),
      N ∈ IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ k →
      ∀ d : Fin 2 →₀ ℕ, d.degree < k → MvPowerSeries.coeff d N = 0 := by
    intro k
    induction k with
    | zero => intro N _ d hd; omega
    | succ k ih =>
      intro N hN
      rw [pow_succ] at hN
      refine Submodule.mul_induction_on
        (C := fun x => ∀ d : Fin 2 →₀ ℕ, d.degree < k + 1 → MvPowerSeries.coeff d x = 0)
        hN ?_ ?_
      · intro r hr t ht d hd
        have ht0 : MvPowerSeries.constantCoeff t = 0 := by
          have hnu : ¬ IsUnit t := mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal t).mp ht)
          rw [MvPowerSeries.isUnit_iff_constantCoeff] at hnu
          by_contra h
          exact hnu (isUnit_iff_ne_zero.mpr h)
        rw [MvPowerSeries.coeff_mul]
        apply Finset.sum_eq_zero
        intro pq hpq
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hpq
        by_cases hp : pq.1.degree < k
        · rw [ih r hr pq.1 hp, zero_mul]
        · have h1 : pq.1.degree + pq.2.degree = d.degree := by
            rw [← hpq]
            first
              | exact (map_add Finsupp.degree pq.1 pq.2).symm
              | exact (Finsupp.degree_add pq.1 pq.2).symm
          have h2 : pq.2.degree = 0 := by omega
          rw [Finsupp.degree_eq_zero_iff] at h2
          rw [h2, MvPowerSeries.coeff_zero_eq_constantCoeff_apply, ht0, mul_zero]
      · intro x y hx hy d hd
        rw [map_add, hx d hd, hy d hd, add_zero]

  set s : Fin 2 →₀ ℕ := Finsupp.single 0 1 + Finsupp.single 1 1 with hs
  have hXX : (MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) L) =
      MvPowerSeries.monomial s 1 := by
    rw [MvPowerSeries.X_def, MvPowerSeries.X_def, MvPowerSeries.monomial_mul_monomial, one_mul]

  have s2 : ∀ (F : MvPowerSeries (Fin 2) L),
      F ∈ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} →
      ∀ (i : Fin 2) (m : ℕ), MvPowerSeries.coeff (Finsupp.single i m) F = 0 := by
    intro F hF i m
    obtain ⟨G, rfl⟩ := Ideal.mem_span_singleton'.mp hF
    rw [hXX, MvPowerSeries.coeff_mul_monomial, if_neg]
    intro hle
    have h0 := Finsupp.le_def.mp hle 0
    have h1 := Finsupp.le_def.mp hle 1
    revert h0 h1
    rw [hs]
    fin_cases i <;> simp

  have s3 : ∀ F : MvPowerSeries (Fin 2) L,
      (∀ (i : Fin 2) (m : ℕ), m < n → MvPowerSeries.coeff (Finsupp.single i m) F = 0) →
      F ∈ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} ⊔
        IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n := by
    intro F hF
    let G : MvPowerSeries (Fin 2) L := fun e => MvPowerSeries.coeff (e + s) F
    let H0 : MvPowerSeries (Fin 2) L := fun e =>
      if e 1 = 0 then MvPowerSeries.coeff (e + Finsupp.single 0 n) F else 0
    let H1 : MvPowerSeries (Fin 2) L := fun e =>
      if e 0 = 0 then MvPowerSeries.coeff (e + Finsupp.single 1 n) F else 0
    have eG : ∀ e, MvPowerSeries.coeff e G = MvPowerSeries.coeff (e + s) F := fun e => rfl
    have eH0 : ∀ e, MvPowerSeries.coeff e H0 =
        if e 1 = 0 then MvPowerSeries.coeff (e + Finsupp.single 0 n) F else 0 := fun e => rfl
    have eH1 : ∀ e, MvPowerSeries.coeff e H1 =
        if e 0 = 0 then MvPowerSeries.coeff (e + Finsupp.single 1 n) F else 0 := fun e => rfl
    have hdec : F = G * (MvPowerSeries.X 0 * MvPowerSeries.X 1) +
        (H0 * MvPowerSeries.X 0 ^ n + H1 * MvPowerSeries.X 1 ^ n) := by
      ext d
      rw [hXX, MvPowerSeries.X_pow_eq, MvPowerSeries.X_pow_eq, map_add, map_add,
        MvPowerSeries.coeff_mul_monomial, MvPowerSeries.coeff_mul_monomial,
        MvPowerSeries.coeff_mul_monomial]
      simp only [mul_one]
      have key : ∀ x : Fin 2 →₀ ℕ, x ≤ d → d - x + x = d := fun x hx => tsub_add_cancel_of_le hx
      have hsle : s ≤ d ↔ 1 ≤ d 0 ∧ 1 ≤ d 1 := by
        rw [Finsupp.le_def, Fin.forall_fin_two, hs]
        simp
      have h0le : Finsupp.single 0 n ≤ d ↔ n ≤ d 0 := Finsupp.single_le_iff
      have h1le : Finsupp.single 1 n ≤ d ↔ n ≤ d 1 := Finsupp.single_le_iff
      have hsub0 : (d - Finsupp.single (0 : Fin 2) n : Fin 2 →₀ ℕ) 1 = d 1 := by
        rw [Finsupp.tsub_apply, Finsupp.single_eq_of_ne (by decide), Nat.sub_zero]
      have hsub1 : (d - Finsupp.single (1 : Fin 2) n : Fin 2 →₀ ℕ) 0 = d 0 := by
        rw [Finsupp.tsub_apply, Finsupp.single_eq_of_ne (by decide), Nat.sub_zero]
      have T1 : (if s ≤ d then MvPowerSeries.coeff (d - s) G else 0) =
          if 1 ≤ d 0 ∧ 1 ≤ d 1 then MvPowerSeries.coeff d F else 0 := by
        by_cases h : s ≤ d
        · rw [if_pos h, if_pos (hsle.mp h), eG, key s h]
        · rw [if_neg h, if_neg (fun h' => h (hsle.mpr h'))]
      have T2 : (if Finsupp.single 0 n ≤ d then
            MvPowerSeries.coeff (d - Finsupp.single 0 n) H0 else 0) =
          if n ≤ d 0 ∧ d 1 = 0 then MvPowerSeries.coeff d F else 0 := by
        by_cases h : Finsupp.single 0 n ≤ d
        · rw [if_pos h, eH0, hsub0, key _ h]
          by_cases hb : d 1 = 0
          · rw [if_pos hb, if_pos ⟨h0le.mp h, hb⟩]
          · rw [if_neg hb, if_neg (fun h' => hb h'.2)]
        · rw [if_neg h, if_neg (fun h' => h (h0le.mpr h'.1))]
      have T3 : (if Finsupp.single 1 n ≤ d then
            MvPowerSeries.coeff (d - Finsupp.single 1 n) H1 else 0) =
          if n ≤ d 1 ∧ d 0 = 0 then MvPowerSeries.coeff d F else 0 := by
        by_cases h : Finsupp.single 1 n ≤ d
        · rw [if_pos h, eH1, hsub1, key _ h]
          by_cases ha : d 0 = 0
          · rw [if_pos ha, if_pos ⟨h1le.mp h, ha⟩]
          · rw [if_neg ha, if_neg (fun h' => ha h'.2)]
        · rw [if_neg h, if_neg (fun h' => h (h1le.mpr h'.1))]
      rw [T1, T2, T3]
      by_cases ha : d 0 = 0 <;> by_cases hb : d 1 = 0
      · have hd : d = Finsupp.single 0 (d 0) := by
          ext j; fin_cases j <;> simp [ha, hb]
        have hz : MvPowerSeries.coeff d F = 0 := by
          rw [hd]; exact hF 0 (d 0) (by omega)
        rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), hz]
        simp
      · by_cases hbn : n ≤ d 1
        · rw [if_neg (by omega), if_neg (by omega), if_pos (by omega)]
          simp
        · have hd : d = Finsupp.single 1 (d 1) := by
            ext j; fin_cases j <;> simp [ha]
          have hz : MvPowerSeries.coeff d F = 0 := by
            rw [hd]; exact hF 1 (d 1) (by omega)
          rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), hz]
          simp
      · by_cases han : n ≤ d 0
        · rw [if_neg (by omega), if_pos (by omega), if_neg (by omega)]
          simp
        · have hd : d = Finsupp.single 0 (d 0) := by
            ext j; fin_cases j <;> simp [hb]
          have hz : MvPowerSeries.coeff d F = 0 := by
            rw [hd]; exact hF 0 (d 0) (by omega)
          rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), hz]
          simp
      · rw [if_pos (by omega), if_neg (by omega), if_neg (by omega)]
        simp
    have hXmem : ∀ i : Fin 2, (MvPowerSeries.X i : MvPowerSeries (Fin 2) L) ∈
        IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) := by
      intro i
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff, MvPowerSeries.isUnit_iff_constantCoeff,
        MvPowerSeries.constantCoeff_X]
      exact not_isUnit_zero
    rw [hdec]
    refine Submodule.add_mem_sup (Ideal.mem_span_singleton'.mpr ⟨G, rfl⟩) ?_
    exact add_mem (Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow (hXmem 0) n))
      (Ideal.mul_mem_left _ _ (Ideal.pow_mem_pow (hXmem 1) n))

  have s4 : ∀ (p : Fin n → L) (q : Fin (n - 1) → L), ∃ F : MvPowerSeries (Fin 2) L,
      (∀ m : Fin n, MvPowerSeries.coeff (Finsupp.single (0 : Fin 2) (m : ℕ)) F = p m) ∧
      (∀ m : Fin (n - 1), MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) ((m : ℕ) + 1)) F
        = q m) := by
    intro p q
    refine ⟨∑ m : Fin n, MvPowerSeries.monomial (Finsupp.single (0 : Fin 2) (m : ℕ)) (p m) +
      ∑ m : Fin (n - 1), MvPowerSeries.monomial (Finsupp.single (1 : Fin 2) ((m : ℕ) + 1)) (q m),
      ?_, ?_⟩
    · intro m'
      rw [map_add, map_sum, map_sum]
      simp only [MvPowerSeries.coeff_monomial]
      rw [Finset.sum_eq_single m', if_pos rfl, Finset.sum_eq_zero, add_zero]
      · intro m _
        rw [if_neg]
        intro h
        have := congrArg (fun f => f 1) h
        simp at this
      · intro m _ hm
        rw [if_neg]
        intro h
        exact hm (Fin.ext (Finsupp.single_injective 0 h).symm)
      · intro h
        exact absurd (Finset.mem_univ _) h
    · intro m'
      rw [map_add, map_sum, map_sum]
      simp only [MvPowerSeries.coeff_monomial]
      rw [Finset.sum_eq_single m', if_pos rfl, Finset.sum_eq_zero, zero_add]
      · intro m _
        rw [if_neg]
        intro h
        have := congrArg (fun f => f 1) h
        simp at this
      · intro m _ hm
        rw [if_neg]
        intro h
        have h' := Finsupp.single_injective 1 h
        exact hm (Fin.ext (by omega))
      · intro h
        exact absurd (Finset.mem_univ _) h

  let Λ : MvPowerSeries (Fin 2) L →ₗ[L] (Fin n → L) × (Fin (n - 1) → L) :=
    LinearMap.prod
      (LinearMap.pi fun m : Fin n => MvPowerSeries.coeff (R := L) (Finsupp.single 0 (m : ℕ)))
      (LinearMap.pi fun m : Fin (n - 1) =>
        MvPowerSeries.coeff (R := L) (Finsupp.single 1 ((m : ℕ) + 1)))
  have hsurj : Function.Surjective Λ := by
    rintro ⟨p, q⟩
    obtain ⟨F, hp, hq⟩ := s4 p q
    exact ⟨F, Prod.ext (funext hp) (funext hq)⟩
  have hker : LinearMap.ker Λ = (Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1} ⊔
      IsLocalRing.maximalIdeal (MvPowerSeries (Fin 2) L) ^ n).restrictScalars L := by
    ext F
    rw [LinearMap.mem_ker, Submodule.restrictScalars_mem]
    constructor
    · intro h
      have hA : ∀ m : Fin n, MvPowerSeries.coeff (Finsupp.single 0 (m : ℕ)) F = 0 :=
        fun m => congrFun (congrArg Prod.fst h) m
      have hB : ∀ m : Fin (n - 1), MvPowerSeries.coeff (Finsupp.single 1 ((m : ℕ) + 1)) F = 0 :=
        fun m => congrFun (congrArg Prod.snd h) m
      refine s3 F ?_
      rw [Fin.forall_fin_two]
      refine ⟨fun m hm => hA ⟨m, hm⟩, fun m hm => ?_⟩
      cases m with
      | zero =>
        have h0 := hA ⟨0, hn⟩
        simp only [Finsupp.single_zero] at h0 ⊢
        exact h0
      | succ m' => exact hB ⟨m', by omega⟩
    · intro hF
      obtain ⟨P, hP, N, hN, rfl⟩ := Submodule.mem_sup.mp hF
      refine Prod.ext (funext fun m => ?_) (funext fun m => ?_)
      · show MvPowerSeries.coeff _ (P + N) = 0
        rw [map_add, s2 P hP, s1 n N hN _ (by rw [Finsupp.degree_single]; exact m.2), add_zero]
      · show MvPowerSeries.coeff _ (P + N) = 0
        rw [map_add, s2 P hP, s1 n N hN _ (by rw [Finsupp.degree_single]; omega), add_zero]
  rw [← LinearEquiv.finrank_eq (Submodule.Quotient.restrictScalarsEquiv L _),
    ← LinearEquiv.finrank_eq (Submodule.quotEquivOfEq _ _ hker),
    LinearEquiv.finrank_eq (Λ.quotKerEquivOfSurjective hsurj),
    Module.finrank_prod, Module.finrank_fin_fun, Module.finrank_fin_fun]
  omega

theorem wcpa_dj_lcc_gs_node_branch_sum : ∀ (K A B₁ B₂ : Type u) [Field K] [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [CommRing B₁] [IsLocalRing B₁] [CommRing B₂] [IsLocalRing B₂] (φ : K →+* A) (π₁ : A →+* B₁) (π₂ : A →+* B₂) (t₁ : B₁) (t₂ : B₂), (∃ e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)).comp φ) = (Ideal.Quotient.mk _).comp MvPowerSeries.C) → Function.Surjective π₁ → Function.Surjective π₂ → IsLocalRing.maximalIdeal B₁ = Ideal.span {t₁} → t₁ ∉ IsLocalRing.maximalIdeal B₁ ^ 2 → IsLocalRing.maximalIdeal B₂ = Ideal.span {t₂} → t₂ ∉ IsLocalRing.maximalIdeal B₂ ^ 2 → (∀ a : A, π₁ a = 0 → π₂ a = 0 → a = 0) → RingHom.ker π₁ ⊔ RingHom.ker π₂ = IsLocalRing.maximalIdeal A :=
by
  intro K A B₁ B₂ _ _ _ _ _ _ _ _ φ π₁ π₂ t₁ t₂ hcompl hπ₁ hπ₂ hm₁ ht₁ hm₂ ht₂ hjoint
  classical

  have hres : ∀ a : A, ∃ z : K, a - φ z ∈ IsLocalRing.maximalIdeal A :=
    wcpa_dj_nf_node_residue K A φ hcompl
  obtain ⟨e, he⟩ := hcompl

  obtain ⟨H1, H2⟩ := wcpa_dj_lqr_completion_bridge K A e

  obtain ⟨u, v, ⟨hu, hv, hspan, -⟩, huv⟩ := wcpa_dj_lqu_sp_node_basis K A φ
    (e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) he H1 H2
  have hdim' := wcpa_dj_lqr_quot_hilb K A φ
    (e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A))) he H1 H2 3

  have hm3 : IsLocalRing.maximalIdeal A ^ 3 =
      IsLocalRing.maximalIdeal A * IsLocalRing.maximalIdeal A ^ 2 := by ring
  have hmul12 : ∀ a b : A, a ∈ IsLocalRing.maximalIdeal A → b ∈ IsLocalRing.maximalIdeal A ^ 2 →
      a * b ∈ IsLocalRing.maximalIdeal A ^ 3 := fun a b ha hb => by
    rw [hm3]; exact Ideal.mul_mem_mul ha hb
  have hmul21 : ∀ a b : A, a ∈ IsLocalRing.maximalIdeal A ^ 2 → b ∈ IsLocalRing.maximalIdeal A →
      a * b ∈ IsLocalRing.maximalIdeal A ^ 3 := fun a b ha hb => by
    rw [mul_comm]; exact hmul12 b a hb ha
  have hmul22 : ∀ a b : A, a ∈ IsLocalRing.maximalIdeal A ^ 2 →
      b ∈ IsLocalRing.maximalIdeal A ^ 2 → a * b ∈ IsLocalRing.maximalIdeal A ^ 3 :=
    fun a b ha hb => by
    have h4 : IsLocalRing.maximalIdeal A ^ 4 =
        IsLocalRing.maximalIdeal A ^ 2 * IsLocalRing.maximalIdeal A ^ 2 := by ring
    exact Ideal.pow_le_pow_right (by norm_num : 3 ≤ 4) (by rw [h4]; exact Ideal.mul_mem_mul ha hb)

  have hsq : ∀ y ∈ IsLocalRing.maximalIdeal A ^ 2, ∃ α β : K,
      y - (φ α * u ^ 2 + φ β * v ^ 2) ∈ IsLocalRing.maximalIdeal A ^ 3 := by
    intro y hy
    rw [sq] at hy
    refine Submodule.mul_induction_on hy ?_ ?_
    · intro x hx z hz
      obtain ⟨c₁, c₂, hc⟩ := hspan x hx
      obtain ⟨d₁, d₂, hd⟩ := hspan z hz
      refine ⟨c₁ * d₁, c₂ * d₂, ?_⟩
      have hs : φ c₁ * u + φ c₂ * v ∈ IsLocalRing.maximalIdeal A :=
        Ideal.add_mem _ (Ideal.mul_mem_left _ _ hu) (Ideal.mul_mem_left _ _ hv)
      have hs' : φ d₁ * u + φ d₂ * v ∈ IsLocalRing.maximalIdeal A :=
        Ideal.add_mem _ (Ideal.mul_mem_left _ _ hu) (Ideal.mul_mem_left _ _ hv)
      have e1 : x * z - (φ (c₁ * d₁) * u ^ 2 + φ (c₂ * d₂) * v ^ 2) =
          φ (c₁ * d₂ + c₂ * d₁) * (u * v) +
          (φ c₁ * u + φ c₂ * v) * (z - (φ d₁ * u + φ d₂ * v)) +
          (x - (φ c₁ * u + φ c₂ * v)) * (φ d₁ * u + φ d₂ * v) +
          (x - (φ c₁ * u + φ c₂ * v)) * (z - (φ d₁ * u + φ d₂ * v)) := by
        simp only [map_mul, map_add]; ring
      rw [e1]
      exact Ideal.add_mem _ (Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ huv)
        (hmul12 _ _ hs hd)) (hmul21 _ _ hc hs')) (hmul22 _ _ hc hd)
    · rintro x z ⟨α, β, h⟩ ⟨α', β', h'⟩
      refine ⟨α + α', β + β', ?_⟩
      have e1 : x + z - (φ (α + α') * u ^ 2 + φ (β + β') * v ^ 2) =
          (x - (φ α * u ^ 2 + φ β * v ^ 2)) + (z - (φ α' * u ^ 2 + φ β' * v ^ 2)) := by
        simp only [map_add]; ring
      rw [e1]
      exact Ideal.add_mem _ h h'

  letI : Algebra K A := φ.toAlgebra
  have hdim : Module.finrank K (A ⧸ IsLocalRing.maximalIdeal A ^ 3) = 5 := by
    exact hdim'.trans (wcpa_dj_lqr_node_trunc_dim K 3 (by norm_num))
  let q := Ideal.Quotient.mk (IsLocalRing.maximalIdeal A ^ 3)
  let b : Fin 5 → A ⧸ IsLocalRing.maximalIdeal A ^ 3 := ![q 1, q u, q v, q (u ^ 2), q (v ^ 2)]
  have hbmem : ∀ (c : K) (i : Fin 5), c • b i ∈ Submodule.span K (Set.range b) :=
    fun c i => Submodule.smul_mem _ c (Submodule.subset_span ⟨i, rfl⟩)
  have hspanb : ⊤ ≤ Submodule.span K (Set.range b) := by
    rintro x -
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨z, hz⟩ := hres a
    obtain ⟨c₁, c₂, hc⟩ := hspan _ hz
    obtain ⟨α, β, hαβ⟩ := hsq _ hc
    have e1 : q a = q (φ z * 1 + φ c₁ * u + φ c₂ * v + φ α * u ^ 2 + φ β * v ^ 2) := by
      rw [Ideal.Quotient.eq]
      have e2 : a - (φ z * 1 + φ c₁ * u + φ c₂ * v + φ α * u ^ 2 + φ β * v ^ 2) =
          a - φ z - (φ c₁ * u + φ c₂ * v) - (φ α * u ^ 2 + φ β * v ^ 2) := by ring
      rw [e2]; exact hαβ
    show q a ∈ _
    rw [e1, map_add, map_add, map_add, map_add]
    exact Submodule.add_mem _ (Submodule.add_mem _ (Submodule.add_mem _
      (Submodule.add_mem _ (hbmem z 0) (hbmem c₁ 1)) (hbmem c₂ 2)) (hbmem α 3)) (hbmem β 4)
  have hli : LinearIndependent K b :=
    linearIndependent_of_top_le_span_of_card_eq_finrank hspanb (by rw [Fintype.card_fin, hdim])
  have hind : ∀ α β : K, φ α * u ^ 2 + φ β * v ^ 2 ∈ IsLocalRing.maximalIdeal A ^ 3 →
      α = 0 ∧ β = 0 := by
    intro α β h
    have h0 := Fintype.linearIndependent_iff.mp hli ![0, 0, 0, α, β] (by
      rw [Fin.sum_univ_five]
      show (0 : K) • b 0 + (0 : K) • b 1 + (0 : K) • b 2 + α • b 3 + β • b 4 = 0
      rw [zero_smul, zero_smul, zero_smul, zero_add, zero_add, zero_add]
      show q (φ α * u ^ 2) + q (φ β * v ^ 2) = 0
      rw [← map_add]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr h)
    exact ⟨h0 3, h0 4⟩

  have branch : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (π : A →+* B) (t : B),
      Function.Surjective π → IsLocalRing.maximalIdeal B = Ideal.span {t} →
      t ∉ IsLocalRing.maximalIdeal B ^ 2 →
      ∃ a b : K, (a ≠ 0 ∨ b ≠ 0) ∧ ∃ f : A, π f = 0 ∧
        f - (φ b * u - φ a * v) ∈ IsLocalRing.maximalIdeal A ^ 2 := by
    intro B _ _ π t hπ hmB ht
    have hmap : Ideal.map π (IsLocalRing.maximalIdeal A) = IsLocalRing.maximalIdeal B :=
      IsLocalRing.map_maximalIdeal_of_surjective π hπ
    have hmap2 : Ideal.map π (IsLocalRing.maximalIdeal A ^ 2) = IsLocalRing.maximalIdeal B ^ 2 := by
      rw [Ideal.map_pow, hmap]
    have himg : ∀ y ∈ IsLocalRing.maximalIdeal A, π y ∈ IsLocalRing.maximalIdeal B := by
      intro y hy; rw [← hmap]; exact Ideal.mem_map_of_mem π hy
    have himg2 : ∀ y ∈ IsLocalRing.maximalIdeal A ^ 2, π y ∈ IsLocalRing.maximalIdeal B ^ 2 := by
      intro y hy; rw [← hmap2]; exact Ideal.mem_map_of_mem π hy
    have hpre2 : ∀ w ∈ IsLocalRing.maximalIdeal B ^ 2, ∃ y ∈ IsLocalRing.maximalIdeal A ^ 2,
        π y = w := by
      intro w hw
      rw [← hmap2] at hw
      exact (Ideal.mem_map_iff_of_surjective π hπ).mp hw
    have htm : t ∈ IsLocalRing.maximalIdeal B := by
      rw [hmB]; exact Ideal.mem_span_singleton_self t
    have hcoord : ∀ y ∈ IsLocalRing.maximalIdeal A, ∃ c : K,
        π y - π (φ c) * t ∈ IsLocalRing.maximalIdeal B ^ 2 := by
      intro y hy
      have h1 := himg y hy
      rw [hmB, Ideal.mem_span_singleton'] at h1
      obtain ⟨r, hr⟩ := h1
      obtain ⟨a', rfl⟩ := hπ r
      obtain ⟨z, hz⟩ := hres a'
      refine ⟨z, ?_⟩
      have e1 : π y - π (φ z) * t = π (a' - φ z) * t := by rw [← hr, map_sub]; ring
      rw [e1, sq]
      exact Ideal.mul_mem_mul (himg _ hz) htm
    obtain ⟨a, ha⟩ := hcoord u hu
    obtain ⟨b, hb⟩ := hcoord v hv
    refine ⟨a, b, ?_, ?_⟩
    · by_contra hcon
      push_neg at hcon
      obtain ⟨rfl, rfl⟩ := hcon
      rw [map_zero, map_zero, zero_mul, sub_zero] at ha hb
      have htm' : t ∈ Ideal.map π (IsLocalRing.maximalIdeal A) := by rw [hmap]; exact htm
      obtain ⟨y, hy, hyt⟩ := (Ideal.mem_map_iff_of_surjective π hπ).mp htm'
      obtain ⟨c₁, c₂, hc⟩ := hspan y hy
      apply ht
      have e1 : t = π (φ c₁) * π u + π (φ c₂) * π v + π (y - (φ c₁ * u + φ c₂ * v)) := by
        rw [← hyt]; simp only [map_sub, map_add, map_mul]; ring
      rw [e1]
      exact Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ ha)
        (Ideal.mul_mem_left _ _ hb)) (himg2 _ hc)
    · have hpw : π (φ b * u - φ a * v) ∈ IsLocalRing.maximalIdeal B ^ 2 := by
        have e1 : π (φ b * u - φ a * v) =
            π (φ b) * (π u - π (φ a) * t) - π (φ a) * (π v - π (φ b) * t) := by
          simp only [map_sub, map_mul]; ring
        rw [e1]
        exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ ha) (Ideal.mul_mem_left _ _ hb)
      obtain ⟨y, hy, hyw⟩ := hpre2 _ hpw
      refine ⟨(φ b * u - φ a * v) - y, by rw [map_sub, hyw, sub_self], ?_⟩
      have e1 : (φ b * u - φ a * v) - y - (φ b * u - φ a * v) = -y := by ring
      rw [e1]
      exact (Ideal.neg_mem_iff _).mpr hy

  obtain ⟨a₁, b₁, hne₁, f, hf, hfm⟩ := branch B₁ π₁ t₁ hπ₁ hm₁ ht₁
  obtain ⟨a₂, b₂, hne₂, g, hg, hgm⟩ := branch B₂ π₂ t₂ hπ₂ hm₂ ht₂
  have hfg : f * g = 0 :=
    hjoint _ (by rw [map_mul, hf, zero_mul]) (by rw [map_mul, hg, mul_zero])
  have hw₁ : φ b₁ * u - φ a₁ * v ∈ IsLocalRing.maximalIdeal A :=
    Ideal.sub_mem _ (Ideal.mul_mem_left _ _ hu) (Ideal.mul_mem_left _ _ hv)
  have hw₂ : φ b₂ * u - φ a₂ * v ∈ IsLocalRing.maximalIdeal A :=
    Ideal.sub_mem _ (Ideal.mul_mem_left _ _ hu) (Ideal.mul_mem_left _ _ hv)

  have hq3 : φ (b₁ * b₂) * u ^ 2 + φ (a₁ * a₂) * v ^ 2 ∈ IsLocalRing.maximalIdeal A ^ 3 := by
    have e1 : φ (b₁ * b₂) * u ^ 2 + φ (a₁ * a₂) * v ^ 2 =
        f * g - (φ b₁ * u - φ a₁ * v) * (g - (φ b₂ * u - φ a₂ * v)) -
        (f - (φ b₁ * u - φ a₁ * v)) * (φ b₂ * u - φ a₂ * v) -
        (f - (φ b₁ * u - φ a₁ * v)) * (g - (φ b₂ * u - φ a₂ * v)) +
        φ (b₁ * a₂ + a₁ * b₂) * (u * v) := by
      simp only [map_mul, map_add]; ring
    rw [e1, hfg]
    exact Ideal.add_mem _ (Ideal.sub_mem _ (Ideal.sub_mem _ (Ideal.sub_mem _ (Ideal.zero_mem _)
      (hmul12 _ _ hw₁ hgm)) (hmul21 _ _ hfm hw₂)) (hmul22 _ _ hfm hgm))
      (Ideal.mul_mem_left _ _ huv)

  obtain ⟨hbb, haa⟩ := hind _ _ hq3
  have hδ : a₁ * b₂ - a₂ * b₁ ≠ 0 := by
    rcases mul_eq_zero.mp hbb with h | h
    · have ha1 : a₁ ≠ 0 := hne₁.resolve_right (not_not.mpr h)
      have ha2 : a₂ = 0 := (mul_eq_zero.mp haa).resolve_left ha1
      have hb2 : b₂ ≠ 0 := hne₂.resolve_left (not_not.mpr ha2)
      rw [h, ha2, zero_mul, sub_zero]
      exact mul_ne_zero ha1 hb2
    · have ha2 : a₂ ≠ 0 := hne₂.resolve_right (not_not.mpr h)
      have ha1 : a₁ = 0 := (mul_eq_zero.mp haa).resolve_right ha2
      have hb1 : b₁ ≠ 0 := hne₁.resolve_left (not_not.mpr ha1)
      rw [h, ha1, zero_mul, zero_sub]
      exact neg_ne_zero.mpr (mul_ne_zero ha2 hb1)

  have hfN : f ∈ RingHom.ker π₁ ⊔ RingHom.ker π₂ := Ideal.mem_sup_left (RingHom.mem_ker.mpr hf)
  have hgN : g ∈ RingHom.ker π₁ ⊔ RingHom.ker π₂ := Ideal.mem_sup_right (RingHom.mem_ker.mpr hg)
  have hd : φ (a₁ * b₂ - a₂ * b₁)⁻¹ * φ (a₁ * b₂ - a₂ * b₁) = 1 := by
    rw [← map_mul, inv_mul_cancel₀ hδ, map_one]
  have hu' : u ∈ (RingHom.ker π₁ ⊔ RingHom.ker π₂) ⊔ IsLocalRing.maximalIdeal A ^ 2 := by
    have e1 : u = φ (a₁ * b₂ - a₂ * b₁)⁻¹ * (-(φ a₂) * f + φ a₁ * g) +
        φ (a₁ * b₂ - a₂ * b₁)⁻¹ * (φ a₂ * (f - (φ b₁ * u - φ a₁ * v)) -
          φ a₁ * (g - (φ b₂ * u - φ a₂ * v))) := by
      calc u = (φ (a₁ * b₂ - a₂ * b₁)⁻¹ * φ (a₁ * b₂ - a₂ * b₁)) * u := by rw [hd, one_mul]
        _ = _ := by simp only [map_sub, map_mul]; ring
    rw [e1]
    exact Submodule.add_mem_sup (Ideal.mul_mem_left _ _ (Ideal.add_mem _
      (Ideal.mul_mem_left _ _ hfN) (Ideal.mul_mem_left _ _ hgN)))
      (Ideal.mul_mem_left _ _ (Ideal.sub_mem _ (Ideal.mul_mem_left _ _ hfm)
        (Ideal.mul_mem_left _ _ hgm)))
  have hv' : v ∈ (RingHom.ker π₁ ⊔ RingHom.ker π₂) ⊔ IsLocalRing.maximalIdeal A ^ 2 := by
    have e1 : v = φ (a₁ * b₂ - a₂ * b₁)⁻¹ * (-(φ b₂) * f + φ b₁ * g) +
        φ (a₁ * b₂ - a₂ * b₁)⁻¹ * (φ b₂ * (f - (φ b₁ * u - φ a₁ * v)) -
          φ b₁ * (g - (φ b₂ * u - φ a₂ * v))) := by
      calc v = (φ (a₁ * b₂ - a₂ * b₁)⁻¹ * φ (a₁ * b₂ - a₂ * b₁)) * v := by rw [hd, one_mul]
        _ = _ := by simp only [map_sub, map_mul]; ring
    rw [e1]
    exact Submodule.add_mem_sup (Ideal.mul_mem_left _ _ (Ideal.add_mem _
      (Ideal.mul_mem_left _ _ hfN) (Ideal.mul_mem_left _ _ hgN)))
      (Ideal.mul_mem_left _ _ (Ideal.sub_mem _ (Ideal.mul_mem_left _ _ hfm)
        (Ideal.mul_mem_left _ _ hgm)))

  have hmle : IsLocalRing.maximalIdeal A ≤
      (RingHom.ker π₁ ⊔ RingHom.ker π₂) ⊔ IsLocalRing.maximalIdeal A ^ 2 := by
    intro y hy
    obtain ⟨c₁, c₂, hc⟩ := hspan y hy
    have e1 : y = φ c₁ * u + φ c₂ * v + (y - (φ c₁ * u + φ c₂ * v)) := by ring
    rw [e1]
    exact Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hu') (Ideal.mul_mem_left _ _ hv'))
      (Ideal.mem_sup_right hc)

  have hle : IsLocalRing.maximalIdeal A ≤ RingHom.ker π₁ ⊔ RingHom.ker π₂ := by
    refine Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian _)
      (IsLocalRing.maximalIdeal_le_jacobson ⊥) ?_
    rw [Ideal.smul_eq_mul, ← sq]
    exact hmle

  have hker : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (π : A →+* B),
      RingHom.ker π ≤ IsLocalRing.maximalIdeal A :=
    fun B _ _ π => IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top π)
  exact le_antisymm (sup_le (hker B₁ π₁) (hker B₂ π₂)) hle

theorem wcpa_dj_lcc_gs_p1_global_const : ∀ (K : Type u) [Field K] [IsAlgClosed K] (Er : Scheme.{u}) (q : Er ⟶ Spec (.of K)) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = q → ∀ s : Γ(Er, ⊤), ∃ c : K, s = (q.appTop).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c) :=
by
  intro K _ _ Er q θ hθ s

  have ht : Ideal.span (Set.range (![1, 0] : Fin (1 + 1) → Γ(Spec (.of K), ⊤))) = ⊤ := by
    apply Ideal.eq_top_of_isUnit_mem _ _ isUnit_one
    exact Ideal.subset_span ⟨0, rfl⟩
  obtain ⟨φ, hφ, -⟩ := wc_ldpi_oai_proj_lift K 1 (Spec (.of K)) (𝟙 _) ![1, 0] ht
  set x₀ : Spec (.of K) ⟶ Er := φ ≫ θ.inv with hx₀def
  have hx₀ : x₀ ≫ q = 𝟙 _ := by
    rw [← hθ, hx₀def, Category.assoc, Iso.inv_hom_id_assoc]
    exact hφ
  have hsec : ∀ y : Γ(Spec (.of K), ⊤), x₀.appTop.hom (q.appTop.hom y) = y := by
    intro y
    have h1 : (x₀ ≫ q).appTop.hom y = y := by rw [hx₀]; simp
    rw [Scheme.Hom.comp_appTop] at h1
    simpa using h1

  set e := Scheme.ΓSpecIso (.of K) with he
  set c : K := e.hom.hom (x₀.appTop.hom s) with hc
  set s' : Γ(Er, ⊤) := s - q.appTop.hom (e.inv.hom c) with hs'
  have h0 : x₀.appTop.hom s' = 0 := by
    rw [hs', map_sub, hsec, hc]
    have : e.inv.hom (e.hom.hom (x₀.appTop.hom s)) = x₀.appTop.hom s := by
      simp
    rw [this, sub_self]

  have hbot : Er.basicOpen s' = ⊥ := by
    rcases wcpa_dj_lcc_cmfc_p1_basicOpen_dichotomy K Er θ s' with h | h
    · exfalso
      have hmem : IsLocalRing.closedPoint K ∈ x₀ ⁻¹ᵁ Er.basicOpen s' := by
        rw [h]; trivial
      rw [Scheme.preimage_basicOpen] at hmem
      have hz : (Spec (.of K)).basicOpen ((x₀.app ⊤).hom s') = ⊥ := by
        rw [show (x₀.app ⊤).hom s' = 0 from h0, Scheme.basicOpen_zero]
      rw [hz] at hmem
      exact hmem
    · exact h

  haveI hint : AlgebraicGeometry.IsIntegral (wcProjK K 1) := (wc_projK_integral_normal K 1).1
  haveI : IsReduced (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
      MvPolynomial.gradedAlgebra) := (inferInstance : IsReduced (wcProjK K 1))
  haveI : IsReduced Er := isReduced_of_isOpenImmersion θ.hom

  have hs0 : s' = 0 := (basicOpen_eq_bot_iff s').mp hbot
  exact ⟨c, sub_eq_zero.mp hs0⟩

theorem wcpa_dj_lcc_gs_nodal_reduced : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (p : X ⟶ Spec (.of K)), IsProper p → (∀ x : X, (∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p)) ∨ (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap (X.presheaf.stalk x) (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C)) → IsReduced X :=
by
  intro K _ X p hp hNS
  haveI := hp
  haveI : LocallyOfFiniteType p := IsProper.toLocallyOfFiniteType
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian p
  haveI hst : ∀ x : X, _root_.IsReduced (X.presheaf.stalk x) := by
    intro x
    rcases hNS x with ⟨W, hxW, hWsm⟩ | hnode
    · haveI := hWsm
      haveI hD : IsDomain ((W : Scheme).presheaf.stalk ⟨x, hxW⟩) :=
        wcpa_smooth_stalk_isDomain K W (W.ι ≫ p) 1 ⟨x, hxW⟩
      let e : (W : Scheme).presheaf.stalk ⟨x, hxW⟩ ≃+* X.presheaf.stalk x :=
        (W.stalkIso ⟨x, hxW⟩).commRingCatIsoToRingEquiv
      exact isReduced_of_injective e.symm.toRingHom e.symm.injective
    · exact wcpa_dj_nf_node_reduced K (X.presheaf.stalk x)
        ((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial).hom hnode
  exact isReduced_of_isReduced_stalk X

theorem wcpa_dj_lcc_gs_node_local_glue : ∀ (K : Type u) [Field K] (X X' Er : Scheme.{u}) (p : X ⟶ Spec (.of K)) (i : X' ⟶ X) (ι : Er ⟶ X) (σ' : Spec (.of K) ⟶ X') (σE : Spec (.of K) ⟶ Er) (U : X.Opens) (a : Γ(X', i ⁻¹ᵁ U)) (b : Γ(Er, ι ⁻¹ᵁ U)), (∀ (K A B₁ B₂ : Type u) [Field K] [CommRing A] [IsLocalRing A] [IsNoetherianRing A] [CommRing B₁] [IsLocalRing B₁] [CommRing B₂] [IsLocalRing B₂] (φ : K →+* A) (π₁ : A →+* B₁) (π₂ : A →+* B₂) (t₁ : B₁) (t₂ : B₂), (∃ e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)).comp φ) = (Ideal.Quotient.mk _).comp MvPowerSeries.C) → Function.Surjective π₁ → Function.Surjective π₂ → IsLocalRing.maximalIdeal B₁ = Ideal.span {t₁} → t₁ ∉ IsLocalRing.maximalIdeal B₁ ^ 2 → IsLocalRing.maximalIdeal B₂ = Ideal.span {t₂} → t₂ ∉ IsLocalRing.maximalIdeal B₂ ^ 2 → (∀ a : A, π₁ a = 0 → π₂ a = 0 → a = 0) → RingHom.ker π₁ ⊔ RingHom.ker π₂ = IsLocalRing.maximalIdeal A) → IsProper p → IsClosedImmersion i → IsClosedImmersion ι → σ' ≫ i ≫ p = 𝟙 _ → σE ≫ ι ≫ p = 𝟙 _ → i (σ' (IsLocalRing.closedPoint K)) = ι (σE (IsLocalRing.closedPoint K)) → (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk (i (σ' (IsLocalRing.closedPoint K))))) (X.presheaf.stalk (i (σ' (IsLocalRing.closedPoint K)))) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap (X.presheaf.stalk (i (σ' (IsLocalRing.closedPoint K)))) (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk (i (σ' (IsLocalRing.closedPoint K))))) (X.presheaf.stalk (i (σ' (IsLocalRing.closedPoint K)))))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ (i (σ' (IsLocalRing.closedPoint K))) trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C) → (∃ t : X'.presheaf.stalk (σ' (IsLocalRing.closedPoint K)), IsLocalRing.maximalIdeal (X'.presheaf.stalk (σ' (IsLocalRing.closedPoint K))) = Ideal.span {t} ∧ t ∉ IsLocalRing.maximalIdeal (X'.presheaf.stalk (σ' (IsLocalRing.closedPoint K))) ^ 2) → (∃ t : Er.presheaf.stalk (σE (IsLocalRing.closedPoint K)), IsLocalRing.maximalIdeal (Er.presheaf.stalk (σE (IsLocalRing.closedPoint K))) = Ideal.span {t} ∧ t ∉ IsLocalRing.maximalIdeal (Er.presheaf.stalk (σE (IsLocalRing.closedPoint K))) ^ 2) → (∀ (V : X.Opens) (s : Γ(X, V)), (i.app V).hom s = 0 → (ι.app V).hom s = 0 → s = 0) → i (σ' (IsLocalRing.closedPoint K)) ∈ U → (∀ (h : ⊤ ≤ σ' ⁻¹ᵁ (i ⁻¹ᵁ U)) (h' : ⊤ ≤ σE ⁻¹ᵁ (ι ⁻¹ᵁ U)), (σ'.appLE (i ⁻¹ᵁ U) ⊤ h).hom a = (σE.appLE (ι ⁻¹ᵁ U) ⊤ h').hom b) → ∃ (U₁ : X.Opens) (hU₁ : U₁ ≤ U), i (σ' (IsLocalRing.closedPoint K)) ∈ U₁ ∧ ∃ s : Γ(X, U₁), (i.app U₁).hom s = (X'.presheaf.map (homOfLE (show i ⁻¹ᵁ U₁ ≤ i ⁻¹ᵁ U from fun x hx => hU₁ hx)).op).hom a ∧ (ι.app U₁).hom s = (Er.presheaf.map (homOfLE (show ι ⁻¹ᵁ U₁ ≤ ι ⁻¹ᵁ U from fun x hx => hU₁ hx)).op).hom b :=
by
  intro K _ X X' Er p i ι σ' σE U a b hc2 hp hi hι hσ' hσE hxe hnode ht₁ ht₂ hSep hxU hval
  classical
  haveI := hp
  haveI := hi
  haveI := hι
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian p

  have nat : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z) {V V' : Z.Opens} (e : V' ⟶ V)
      (e' : f ⁻¹ᵁ V' ⟶ f ⁻¹ᵁ V) (s : Γ(Z, V)),
      (f.app V').hom ((Z.presheaf.map e.op).hom s) =
        (Y.presheaf.map e'.op).hom ((f.app V).hom s) := by
    intro Y Z f V V' e e' s
    have h := congrArg (fun φ => φ.hom s) (f.naturality e.op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
    rw [h]
    exact congrArg (fun φ : f ⁻¹ᵁ V' ⟶ f ⁻¹ᵁ V => (Y.presheaf.map φ.op).hom ((f.app V).hom s))
      (Subsingleton.elim _ e')
  have pm : ∀ (Y : Scheme.{u}) {A B C : Y.Opens} (e1 : B ⟶ A) (e2 : C ⟶ B) (e3 : C ⟶ A)
      (x : Γ(Y, A)), (Y.presheaf.map e2.op).hom ((Y.presheaf.map e1.op).hom x) =
        (Y.presheaf.map e3.op).hom x := by
    intro Y A B C e1 e2 e3 x
    have : e1.op ≫ e2.op = e3.op := Quiver.Hom.unop_inj (Subsingleton.elim _ _)
    rw [← this, Functor.map_comp, CommRingCat.hom_comp, RingHom.comp_apply]
  have hcomp : ∀ {Y Z W : Scheme.{u}} (f : Y ⟶ Z) (g : Z ⟶ W) (U : W.Opens) (V : Z.Opens)
      (T : Y.Opens) (e₁ : V ≤ g ⁻¹ᵁ U) (e₂ : T ≤ f ⁻¹ᵁ V) (h : T ≤ (f ≫ g) ⁻¹ᵁ U)
      (x : Γ(W, U)), (f.appLE V T e₂).hom ((g.appLE U V e₁).hom x) =
        ((f ≫ g).appLE U T h).hom x := by
    intro Y Z W f g U V T e₁ e₂ h x
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Scheme.Hom.appLE_comp_appLE]
  have hcongr : ∀ {Y Z : Scheme.{u}} (f g : Y ⟶ Z), f = g → ∀ (U : Z.Opens) (V : Y.Opens)
      (h : V ≤ f ⁻¹ᵁ U) (h' : V ≤ g ⁻¹ᵁ U) (x : Γ(Z, U)),
      (f.appLE U V h).hom x = (g.appLE U V h').hom x := by
    intro Y Z f g hfg U V h h' x
    subst hfg
    rfl
  have hid : ∀ (Y : Scheme.{u}) (h : (⊤ : Y.Opens) ≤ (𝟙 Y : Y ⟶ Y) ⁻¹ᵁ ⊤) (x : Γ(Y, ⊤)),
