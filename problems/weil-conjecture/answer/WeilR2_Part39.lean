    rw [Scheme.Hom.comp_apply]
    exact hAW (hirange ⟨_, rfl⟩)

  obtain ⟨U₀, Y, iYint, iYnoeth, q₀, r, m, Ebar, ρ, hηU₀, hq₀fin, hq₀surj, hq₀gen, hEcl, hρ,
    hanch, hsplit⟩ := wcpa_dj_sso_split_cover S (Limits.pullback u i) (Limits.pullback.snd u i)
      hflS hprS hfpS hSSS
  haveI := iYint
  haveI := iYnoeth
  haveI := hq₀fin
  haveI := hq₀surj
  have hpbY : IsPullback
      (Limits.pullback.fst (Limits.pullback.snd u i) (q₀ ≫ U₀.ι) ≫ Limits.pullback.fst u i)
      (Limits.pullback.snd (Limits.pullback.snd u i) (q₀ ≫ U₀.ι)) u ((q₀ ≫ U₀.ι) ≫ i) :=
    (IsPullback.of_hasPullback (Limits.pullback.snd u i) (q₀ ≫ U₀.ι)).paste_horiz hpbS
  have hflY : Flat (Limits.pullback.snd (Limits.pullback.snd u i) (q₀ ≫ U₀.ι)) :=
    MorphismProperty.of_isPullback (P := @Flat) hpbY hfl
  have hprY : IsProper (Limits.pullback.snd (Limits.pullback.snd u i) (q₀ ≫ U₀.ι)) :=
    MorphismProperty.of_isPullback (P := @IsProper) hpbY hpr
  have hfpY : LocallyOfFinitePresentation
      (Limits.pullback.snd (Limits.pullback.snd u i) (q₀ ≫ U₀.ι)) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFinitePresentation) hpbY hfp
  let σY : Fin n → (Y ⟶ Limits.pullback (Limits.pullback.snd u i) (q₀ ≫ U₀.ι)) := fun j =>
    hpbY.lift (((q₀ ≫ U₀.ι) ≫ i) ≫ τ j) (𝟙 Y)
      (by rw [Category.assoc, hτ j, Category.comp_id, Category.id_comp])
  have hσY : ∀ j, σY j ≫ Limits.pullback.snd (Limits.pullback.snd u i) (q₀ ≫ U₀.ι) = 𝟙 Y :=
    fun j => hpbY.lift_snd _ _ _
  have FTY := fun (K : Type u) [Field K] (s : Spec (.of K) ⟶ Y) =>
    wcpa_dj_sol_fibre_transfer T Y Z (Limits.pullback (Limits.pullback.snd u i) (q₀ ≫ U₀.ι)) u τ
      ((q₀ ≫ U₀.ι) ≫ i) (Limits.pullback.snd (Limits.pullback.snd u i) (q₀ ≫ U₀.ι))
      (Limits.pullback.fst (Limits.pullback.snd u i) (q₀ ≫ U₀.ι) ≫ Limits.pullback.fst u i) σY
      hpbY hτ hσY (fun j => hpbY.lift_fst _ _ _) K s
  have hbrange : ∀ y : Y, ((q₀ ≫ U₀.ι) ≫ i) y ∈ A := by
    intro y
    rw [Scheme.Hom.comp_apply]
    exact hirange ⟨_, rfl⟩
  have hSSY : ∀ (K' : Type u) [Field K'] [IsAlgClosed K'] (s : Spec (.of K') ⟶ Y),
      wcpaDjSolSS (Limits.pullback.snd (Limits.pullback.snd u i) (q₀ ≫ U₀.ι)) K' s := by
    intro K' _ _ s
    refine (FTY K' s).1.mpr (hSS K' (s ≫ (q₀ ≫ U₀.ι) ≫ i) ?_)
    rintro _ ⟨p, rfl⟩
    rw [Scheme.Hom.comp_apply]
    exact hAW (hbrange _)

  have hbη : (q₀ ≫ U₀.ι) (genericPoint Y) = genericPoint S := by
    obtain ⟨z, hz⟩ := q₀.surjective ⟨genericPoint S, hηU₀⟩
    have hz' : U₀.ι (q₀ z) = genericPoint S := by rw [hz]; rfl
    rw [← hq₀gen z hz', Scheme.Hom.comp_apply, hz']
  have hbt : ((q₀ ≫ U₀.ι) ≫ i) (genericPoint Y) = t := by
    rw [Scheme.Hom.comp_apply, hbη, hit]

  obtain ⟨V, hηV, hV1, hV2, hV3, hV4, hV5⟩ := wcpa_dj_sso_data_spread Y
    (Limits.pullback (Limits.pullback.snd u i) (q₀ ≫ U₀.ι))
    (Limits.pullback.snd (Limits.pullback.snd u i) (q₀ ≫ U₀.ι)) r m n Ebar ρ σY hflY hprY hfpY
    hEcl hρ hσY hsplit

  have hG4 : ∀ z ∈ V, ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T),
      s (IsLocalRing.closedPoint K) = ((q₀ ≫ U₀.ι) ≫ i) z → wcpaDjSolStab u n τ K s := by
    intro z hz K _ _ s hs
    have hηz : genericPoint Y ⤳ z := (genericPoint_spec Y).specializes (Set.mem_univ z)
    obtain ⟨K', iK', iK'a, R, hRalg, g, hg0, hg1⟩ := wcpa_dj_sso_trait Y z (genericPoint Y) hηz
    haveI := iK'a
    haveI := hRalg
    have hb1 : ((Spec.map (CommRingCat.ofHom (algebraMap ↥R K')) ≫ g) ≫ (q₀ ≫ U₀.ι) ≫ i)
        (IsLocalRing.closedPoint K') = t := by
      refine (Scheme.Hom.comp_apply _ _ _).trans ?_
      rw [hg1, hbt]
    have hb0 : ((Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))) ≫ g) ≫
        (q₀ ≫ U₀.ι) ≫ i) (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥R)) =
        ((q₀ ≫ U₀.ι) ≫ i) z := by
      refine (Scheme.Hom.comp_apply _ _ _).trans ?_
      rw [hg0]
    have hst1T : wcpaDjSolStab u n τ K'
        ((Spec.map (CommRingCat.ofHom (algebraMap ↥R K')) ≫ g) ≫ (q₀ ≫ U₀.ι) ≫ i) :=
      hstab K' _ hb1
    have hst1 := (FTY K' (Spec.map (CommRingCat.ofHom (algebraMap ↥R K')) ≫ g)).2.mpr hst1T
    obtain ⟨c1, c2, c3⟩ := hsplit K' (Spec.map (CommRingCat.ofHom (algebraMap ↥R K')) ≫ g) hg1
    have hst0 := wcpa_dj_sso_equisingular_stab Y
      (Limits.pullback (Limits.pullback.snd u i) (q₀ ≫ U₀.ι))
      (Limits.pullback.snd (Limits.pullback.snd u i) (q₀ ≫ U₀.ι)) n r m σY ρ Ebar z
      (genericPoint Y) (IsLocalRing.ResidueField ↥R) K'
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))) ≫ g)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R K')) ≫ g) hflY hg0 hg1 hηz hσY hρ hEcl
      c1 c2 c3
      (fun j => hV1 (IsLocalRing.ResidueField ↥R)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))) ≫ g)
        (by rw [hg0]; exact hz) j)
      (fun z' hz' htwo => by
        obtain ⟨a, ha⟩ := hV2 z' (by rw [hz']; exact hz) htwo
        exact ⟨a, by rw [← hz']; exact ha⟩)
      (hV3 z hz) (hV4 z hz) (hV5 z hz) hanch
      (fun j h => wcpa_dj_sso_p1_generalizes K' R hRalg Y
        (Limits.pullback (Limits.pullback.snd u i) (q₀ ≫ U₀.ι))
        (Limits.pullback.snd (Limits.pullback.snd u i) (q₀ ≫ U₀.ι)) g (Ebar j) hflY hprY hfpY
        hSSY (hEcl j) (c1 j) h)
      hst1
    have hst0T := (FTY (IsLocalRing.ResidueField ↥R)
      (Spec.map (CommRingCat.ofHom (algebraMap ↥R (IsLocalRing.ResidueField ↥R))) ≫ g)).2.mp hst0
    refine wcpa_dj_sso_field_invariance T Z u n τ hfl hpr hfp hτ W₀ hSS hdis hsm
      (IsLocalRing.ResidueField ↥R) _ K s ?_ ?_ hst0T
    · rw [hb0]
      exact hAW (hbrange z)
    · rw [hs, hb0]

  have hCcl : IsClosed (⇑q₀ '' ((V : Set Y)ᶜ)) := q₀.isClosedMap _ V.isOpen.isClosed_compl
  set U₁ : Set S := ⇑U₀.ι '' ((⇑q₀ '' ((V : Set Y)ᶜ))ᶜ) with hU₁
  have hU₁open : IsOpen U₁ := U₀.ι.isOpenEmbedding.isOpenMap _ hCcl.isOpen_compl
  have hηU₁ : genericPoint S ∈ U₁ := by
    refine ⟨⟨genericPoint S, hηU₀⟩, ?_, rfl⟩
    rintro ⟨z, hzV, hz⟩
    apply hzV
    have hz' : U₀.ι (q₀ z) = genericPoint S := by rw [hz]; rfl
    rw [hq₀gen z hz']
    exact hηV
  have hU₁pt : ∀ x ∈ U₁, ∃ z ∈ V, (q₀ ≫ U₀.ι) z = x := by
    rintro _ ⟨w, hwC, rfl⟩
    obtain ⟨z, hz⟩ := q₀.surjective w
    refine ⟨z, ?_, by rw [Scheme.Hom.comp_apply, hz]⟩
    by_contra h
    exact hwC ⟨z, h, hz⟩
  obtain ⟨O', hO'open, hO'⟩ := hiind.isOpen_iff.mp hU₁open
  refine ⟨⟨O' ∩ (A : Set T), hO'open.inter A.isOpen⟩, ⟨?_, htA⟩, ?_⟩
  · have h1 : genericPoint S ∈ ⇑i ⁻¹' O' := by rw [hO']; exact hηU₁
    rw [Set.mem_preimage, hit] at h1
    exact h1
  · intro y hy hty K _ _ s hs
    obtain ⟨x, rfl⟩ := hispec y hy.2 hty
    have hx : x ∈ U₁ := by rw [← hO']; exact hy.1
    obtain ⟨z, hzV, hzx⟩ := hU₁pt x hx
    refine hG4 z hzV K s ?_
    rw [hs, Scheme.Hom.comp_apply, hzx]

theorem wcpa_dj_sol_stable_open : ∀ (T Z : Scheme.{u}) [IsLocallyNoetherian T] (u : Z ⟶ T) (n : ℕ) (τ : Fin n → (T ⟶ Z)), Flat u → IsProper u → LocallyOfFinitePresentation u → (∀ i, τ i ≫ u = 𝟙 T) → ∀ W₀ : T.Opens, (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T), Set.range ⇑s ⊆ (W₀ : Set T) → wcpaDjSolSS u K s) → (∀ (i j : Fin n) (t : T), t ∈ W₀ → i ≠ j → τ i t ≠ τ j t) → (∀ (j : Fin n) (t : T), t ∈ W₀ → ∃ W : Z.Opens, τ j t ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ u)) → ∀ (K₀ : Type u) [Field K₀] [IsAlgClosed K₀] (s₀ : Spec (.of K₀) ⟶ T), Set.range ⇑s₀ ⊆ (W₀ : Set T) → wcpaDjSolStab u n τ K₀ s₀ → ∃ W : T.Opens, W ≤ W₀ ∧ Set.range ⇑s₀ ⊆ (W : Set T) ∧ ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T), Set.range ⇑s ⊆ (W : Set T) → wcpaDjSolStab u n τ K s :=
by
  intro T Z _ u n τ hfl hpr hfp hτ W₀ hSS hdis hsm K₀ _ _ s₀ hs₀ hstab₀
  classical


  have crit : ∀ (X : Type u) [TopologicalSpace X] [TopologicalSpace.NoetherianSpace X]
      [QuasiSober X] (E : Set X), (∀ a b : X, a ⤳ b → b ∈ E → a ∈ E) →
      (∀ a ∈ E, ∃ O : Set X, IsOpen O ∧ a ∈ O ∧ ∀ y ∈ O, a ⤳ y → y ∈ E) → IsOpen E := by
    intro X _ _ _ E hG hL
    rw [← isClosed_compl_iff, ← closure_subset_iff_isClosed]
    intro x₀ hx₀ hx₀E
    let S : Set (TopologicalSpace.Closeds X) :=
      {C | ∃ x ∈ E, x ∈ closure ((C : Set X) \ E)}
    have hS : (⊤ : TopologicalSpace.Closeds X) ∈ S :=
      ⟨x₀, hx₀E, by rw [TopologicalSpace.Closeds.coe_top, ← Set.compl_eq_univ_diff]; exact hx₀⟩
    obtain ⟨C, ⟨x, hxE, hxC⟩, hmin⟩ := wellFounded_lt.has_min S ⟨⊤, hS⟩
    have hCcl : IsClosed (C : Set X) := C.isClosed
    have key : ∀ D : Set X, IsClosed D → D ⊆ (C : Set X) → x ∈ closure (D \ E) →
        (C : Set X) ⊆ D := by
      intro D hD hDC hxD
      by_contra hne
      refine hmin ⟨D, hD⟩ ⟨x, hxE, hxD⟩ (lt_of_le_of_ne hDC ?_)
      intro h
      apply hne
      rw [← h]
      exact subset_rfl
    have hxCm : x ∈ (C : Set X) := closure_minimal Set.diff_subset hCcl hxC
    have hdense : (C : Set X) ⊆ closure ((C : Set X) \ E) := by
      refine key _ isClosed_closure (closure_minimal Set.diff_subset hCcl) ?_
      refine closure_mono ?_ hxC
      intro y hy
      exact ⟨subset_closure hy, hy.2⟩
    have hirr : IsIrreducible (C : Set X) := by
      refine ⟨⟨x, hxCm⟩, ?_⟩
      intro U V hU hV ⟨a, haC, haU⟩ ⟨b, hbC, hbV⟩
      by_contra hne
      rw [Set.not_nonempty_iff_eq_empty] at hne
      have hsplit : (C : Set X) \ E ⊆ (((C : Set X) ∩ Uᶜ) \ E) ∪ (((C : Set X) ∩ Vᶜ) \ E) := by
        intro y hy
        by_cases hyU : y ∈ U
        · right
          refine ⟨⟨hy.1, fun hyV => ?_⟩, hy.2⟩
          have hmem : y ∈ (C : Set X) ∩ (U ∩ V) := ⟨hy.1, hyU, hyV⟩
          rw [hne] at hmem
          exact hmem
        · left
          exact ⟨⟨hy.1, hyU⟩, hy.2⟩
      have hx' : x ∈ closure (((C : Set X) ∩ Uᶜ) \ E) ∪ closure (((C : Set X) ∩ Vᶜ) \ E) := by
        rw [← closure_union]
        exact closure_mono hsplit hxC
      rcases hx' with h | h
      · exact (key _ (hCcl.inter hU.isClosed_compl) Set.inter_subset_left h haC).2 haU
      · exact (key _ (hCcl.inter hV.isClosed_compl) Set.inter_subset_left h hbC).2 hbV
    obtain ⟨ξ, hξ⟩ := QuasiSober.sober hirr hCcl
    have hξE : ξ ∈ E := hG ξ x (hξ.specializes hxCm) hxE
    obtain ⟨O, hO, hξO, hOE⟩ := hL ξ hξE
    obtain ⟨y, hyO, hyC, hyE⟩ := mem_closure_iff.mp (hdense hξ.mem) O hO hξO
    exact hyE (hOE y hyO (hξ.specializes hyC))

  set E : Set T := {t | t ∈ W₀ ∧ ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (s : Spec (.of K) ⟶ T), s (IsLocalRing.closedPoint K) = t → wcpaDjSolStab u n τ K s}
    with hE_def

  have hG : ∀ a b : T, a ⤳ b → b ∈ E → a ∈ E := by
    intro a b hab hb
    exact ⟨hab.mem_open W₀.isOpen hb.1, fun K _ _ s hs =>
      wcpa_dj_sso_generalize T Z u n τ hfl hpr hfp hτ W₀ hSS hdis hsm b a hab hb.1 hb.2 K s hs⟩

  have hL : ∀ a ∈ E, ∃ O : Set T, IsOpen O ∧ a ∈ O ∧ ∀ y ∈ O, a ⤳ y → y ∈ E := by
    intro a ha
    obtain ⟨O, haO, hO⟩ :=
      wcpa_dj_sso_generic_spread T Z u n τ hfl hpr hfp hτ W₀ hSS hdis hsm a ha.1 ha.2
    exact ⟨(O : Set T) ∩ (W₀ : Set T), O.isOpen.inter W₀.isOpen, ⟨haO, ha.1⟩,
      fun y hy hay => ⟨hy.2, hO y hy.1 hay⟩⟩

  have hEopen : IsOpen E := by
    rw [isOpen_iff_forall_mem_open]
    intro x hx
    obtain ⟨A, hAaff, hxA, -⟩ := (TopologicalSpace.Opens.isBasis_iff_nbhd.mp
      T.isBasis_affineOpens) (show x ∈ (⊤ : T.Opens) from trivial)
    haveI : IsNoetherianRing Γ(T, A) := IsLocallyNoetherian.component_noetherian ⟨A, hAaff⟩
    haveI : TopologicalSpace.NoetherianSpace (A : Set T) := noetherianSpace_of_isAffineOpen A hAaff
    haveI : QuasiSober (A : Set T) := A.isOpen.isOpenEmbedding_subtypeVal.quasiSober
    have hE' : IsOpen (Subtype.val ⁻¹' E : Set (A : Set T)) := by
      refine crit (A : Set T) _ ?_ ?_
      · intro a b hab hb
        exact hG a.1 b.1 ((subtype_specializes_iff a b).mp hab) hb
      · intro a ha
        obtain ⟨O, hO, haO, hOE⟩ := hL a.1 ha
        exact ⟨Subtype.val ⁻¹' O, hO.preimage continuous_subtype_val, haO,
          fun y hy hay => hOE y.1 hy ((subtype_specializes_iff a y).mp hay)⟩
    refine ⟨Subtype.val '' (Subtype.val ⁻¹' E : Set (A : Set T)), ?_,
      A.isOpen.isOpenMap_subtype_val _ hE', ⟨⟨x, hxA⟩, hx, rfl⟩⟩
    rintro _ ⟨y, hy, rfl⟩
    exact hy
  refine ⟨⟨E, hEopen⟩, fun x hx => hx.1, ?_, ?_⟩
  ·
    rintro _ ⟨p, rfl⟩
    have hp : p = IsLocalRing.closedPoint K₀ := Subsingleton.elim _ _
    subst hp
    have hmem : s₀ (IsLocalRing.closedPoint K₀) ∈ W₀ := hs₀ ⟨_, rfl⟩
    exact ⟨hmem, fun K _ _ s hs =>
      wcpa_dj_sso_field_invariance T Z u n τ hfl hpr hfp hτ W₀ hSS hdis hsm K₀ s₀ K s hmem hs
        hstab₀⟩
  · intro K _ _ s hs
    exact (hs ⟨IsLocalRing.closedPoint K, rfl⟩).2 K s rfl

theorem wcpa_dj_lsl_stable_locus_open : ∀ (T T' Z Z' : Scheme.{u}) [IsLocallyNoetherian T] (u₀ : Z ⟶ T) (n : ℕ) (τ₀ : Fin n → (T ⟶ Z)) (b : T' ⟶ T) (u' : Z' ⟶ T') (φ : Z' ⟶ Z) (τ' : Fin n → (T' ⟶ Z')), Flat u₀ → IsProper u₀ → LocallyOfFinitePresentation u₀ → (∀ i, τ₀ i ≫ u₀ = 𝟙 T) → IsPullback φ u' u₀ b → (∀ i, τ' i ≫ u' = 𝟙 T') → (∀ i, τ' i ≫ φ = b ≫ τ₀ i) → wcpaDjStablePtd u' n τ' → GeometricallyConnected u' → ∃ (G : T.Opens) (τG : Fin n → (G.toScheme ⟶ (u₀ ⁻¹ᵁ G).toScheme)), Set.range ⇑b ⊆ (G : Set T) ∧ wcpaDjStablePtd (u₀ ∣_ G) n τG ∧ GeometricallyConnected (u₀ ∣_ G) ∧ (∀ i, τG i ≫ (u₀ ⁻¹ᵁ G).ι = G.ι ≫ τ₀ i) :=
by
  intro T T' Z Z' _ u₀ n τ₀ b u' φ τ' hfl hpr hfp hτ₀ hφ hτ' hτφ hst hgc
  classical
  obtain ⟨⟨_, _, hSS'⟩, ⟨_, hS2, hS3⟩, hStab'⟩ := hst
  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]

  have spu : ∀ (X P V C : Scheme.{u}) (f : X ⟶ P) (b : V ⟶ P)
      (ψ : C ⟶ X) (g : C ⟶ V) (σ : P ⟶ X) (τ : V ⟶ C), IsPullback ψ g f b → σ ≫ f = 𝟙 P →
      τ ≫ g = 𝟙 V → τ ≫ ψ = b ≫ σ → ∀ c : C, ψ c = σ (b (g c)) → c = τ (g c) := by
    intro X P V C f b ψ g σ τ H1 H2 H3 H4 c h
    have hgτ : ∀ x : V, g (τ x) = x := by
      intro x
      rw [← Scheme.Hom.comp_apply, H3]
      rfl
    have hout : IsPullback (τ ≫ g) b b (σ ≫ f) := by
      rw [H3, H2]
      exact IsPullback.id_horiz b
    have hsq : IsPullback τ b ψ σ := IsPullback.of_right hout H4 H1.flip
    obtain ⟨p, hp, _⟩ := Scheme.exists_preimage_of_isPullback hsq c (b (g c)) h
    have hg : g c = p := by rw [← hp, hgτ]
    rw [hg, hp]

  have s3h : ∀ {X Y S : Scheme.{u}} (i : X ⟶ Y) [IsIso i] (p : X ⟶ S) (q : Y ⟶ S), i ≫ q = p →
      ∀ (W' : Y.Opens), SmoothOfRelativeDimension 1 (W'.ι ≫ q) →
        SmoothOfRelativeDimension 1 ((i ⁻¹ᵁ W').ι ≫ p) := by
    intro X Y S i _ p q hi W' hW'
    have hfac' : (i ⁻¹ᵁ W').ι ≫ p = (i ∣_ W') ≫ (W'.ι ≫ q) := by
      rw [← hi, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    have hpb : IsPullback (i ∣_ W') ((i ∣_ W') ≫ (W'.ι ≫ q)) (W'.ι ≫ q) (𝟙 S) :=
      IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]⟩
    rw [hfac']
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hW'

  have hcomap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B) (n : ℕ), IsLocalRing.maximalIdeal A ^ n ≤
        Ideal.comap (σ : A →+* B) (IsLocalRing.maximalIdeal B ^ n) := by
    intro A B _ _ _ _ σ n
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
    apply Ideal.pow_right_mono
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
    intro h
    exact hx ((MulEquiv.isUnit_map (σ : A ≃* B)).mp h)
  have hfac : ∀ (A : Type u) [CommRing A] (I : Ideal A) (m n : ℕ) (h : m ≤ n)
      (x : AdicCompletion I A),
      Ideal.Quotient.factorPow I h (AdicCompletion.evalₐ I n x) = AdicCompletion.evalₐ I m x := by
    intro A _ I m n h x
    obtain ⟨c, rfl⟩ := AdicCompletion.mk_surjective I A x
    rw [AdicCompletion.evalₐ_mk, AdicCompletion.evalₐ_mk, Ideal.Quotient.factorPow,
      Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
