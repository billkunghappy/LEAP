  have cmul : ∀ {X : Scheme.{u}} (L' : wcpaDjCoc X) (O : X.Opens) (d₁ d₂ : ℕ)
      (s t : ∀ a : Fin L'.m, Γ(X, L'.V a ⊓ O)), wcpaDjCompat L' O d₁ s →
      wcpaDjCompat L' O d₂ t → wcpaDjCompat L' O (d₁ + d₂) (fun a => s a * t a) := by
    intro X L' O d₁ d₂ s t hs ht a b
    have h1 := hs a b
    have h2 := ht a b
    simp only [map_mul, map_pow, pow_add] at h1 h2 ⊢
    rw [h1, h2]
    ring

  have reorder : ∀ {R : Type u} [AddCommMonoid R] {n N₁ N₂ N : ℕ}
      (F : Fin n → Fin N₁ → Fin N₂ → Fin N → R),
      ∑ r, ∑ i, ∑ j, ∑ l, F r i j l = ∑ l, ∑ i, ∑ j, ∑ r, F r i j l := by
    intro R _ n N₁ N₂ N F
    calc ∑ r, ∑ i, ∑ j, ∑ l, F r i j l = ∑ i, ∑ r, ∑ j, ∑ l, F r i j l := Finset.sum_comm
      _ = ∑ i, ∑ j, ∑ r, ∑ l, F r i j l :=
          Finset.sum_congr rfl (fun i _ => Finset.sum_comm)
      _ = ∑ i, ∑ j, ∑ l, ∑ r, F r i j l :=
          Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => Finset.sum_comm))
      _ = ∑ i, ∑ l, ∑ j, ∑ r, F r i j l :=
          Finset.sum_congr rfl (fun i _ => Finset.sum_comm)
      _ = ∑ l, ∑ i, ∑ j, ∑ r, F r i j l := Finset.sum_comm

  have nak : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (R N : ℕ)
      (M : Matrix (Fin R) (Fin N) A),
      (∀ v : Fin R → IsLocalRing.ResidueField A, ∃ w : Fin N → IsLocalRing.ResidueField A,
        (M.map (IsLocalRing.residue A)).mulVec w = v) →
      ∀ v : Fin R → A, ∃ w : Fin N → A, M.mulVec w = v := by
    intro A _ _ R N M hM
    have htop : (⊤ : Submodule A (Fin R → A)) ≤ LinearMap.range M.mulVecLin := by
      apply Submodule.le_of_le_smul_of_le_jacobson_bot (I := IsLocalRing.maximalIdeal A)
        Module.Finite.fg_top (IsLocalRing.maximalIdeal_le_jacobson _)
      intro v _
      obtain ⟨wb, hwb⟩ := hM (fun l => IsLocalRing.residue A (v l))
      choose w₀ hw₀ using fun k => IsLocalRing.residue_surjective (wb k)
      have hu : ∀ l, (v - M.mulVec w₀) l ∈ IsLocalRing.maximalIdeal A := by
        intro l
        rw [← IsLocalRing.residue_eq_zero_iff, Pi.sub_apply, map_sub, sub_eq_zero]
        have h1 := congrFun hwb l
        simp only [Matrix.mulVec, dotProduct, Matrix.map_apply] at h1
        rw [← h1]
        simp only [Matrix.mulVec, dotProduct, map_sum, map_mul, hw₀]
      have hmem : v - M.mulVec w₀ ∈
          IsLocalRing.maximalIdeal A • (⊤ : Submodule A (Fin R → A)) := by
        rw [pi_eq_sum_univ (v - M.mulVec w₀)]
        exact Submodule.sum_mem _ (fun l _ => Submodule.smul_mem_smul (hu l) trivial)
      have hv : v = M.mulVec w₀ + (v - M.mulVec w₀) := by abel
      rw [hv]
      exact Submodule.add_mem_sup ⟨w₀, rfl⟩ hmem
    intro v
    obtain ⟨w, hw⟩ := LinearMap.mem_range.mp (htop (Submodule.mem_top (x := v)))
    exact ⟨w, hw⟩

  have fibre_span : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (g : X ⟶ Spec (.of K))
      (L' : wcpaDjCoc X) (d₁ d₂ N₁ N₂ N : ℕ)
      (β₁ : Fin N₁ → ∀ a : Fin L'.m, Γ(X, L'.V a ⊓ g ⁻¹ᵁ ⊤))
      (β₂ : Fin N₂ → ∀ a : Fin L'.m, Γ(X, L'.V a ⊓ g ⁻¹ᵁ ⊤))
      (β : Fin N → ∀ a : Fin L'.m, Γ(X, L'.V a ⊓ g ⁻¹ᵁ ⊤)) (M : Fin N₁ → Fin N₂ → Fin N → K),
      (∀ l, wcpaDjCompat L' (g ⁻¹ᵁ ⊤) (d₁ + d₂) (β l)) →
      (∀ t : ∀ a : Fin L'.m, Γ(X, L'.V a ⊓ g ⁻¹ᵁ ⊤), wcpaDjCompat L' (g ⁻¹ᵁ ⊤) d₁ t →
        ∃ c : Fin N₁ → K, ∀ a, t a = ∑ i, wcpaLccScal g (L'.V a ⊓ g ⁻¹ᵁ ⊤) (c i) * β₁ i a) →
