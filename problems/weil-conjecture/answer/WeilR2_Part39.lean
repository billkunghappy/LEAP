    intro Y Z f _ W' hW' O hO hOf
    refine ⟨?_, fun x => Scheme.Hom.app_surjective f.imageι W' hW' x, fun y => ?_⟩
    · have hO' : O = f.toImage ⁻¹ᵁ (f.imageι ⁻¹ᵁ W') := by
        rw [hOf, ← Scheme.Hom.comp_preimage, Scheme.Hom.toImage_imageι]
      subst hO'
      rw [Scheme.Hom.appLE_eq_app]
