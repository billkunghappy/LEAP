            rw [hσ r a, hυ r a, Finset.sum_mul_sum]
            refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
            rw [← Finset.mul_sum, ← hM i j a]
            ring
        _ = ∑ l, ∑ i, ∑ j, ∑ r, wcpaLccScal g (L'.V a ⊓ g ⁻¹ᵁ ⊤) (σ r i) *
              wcpaLccScal g (L'.V a ⊓ g ⁻¹ᵁ ⊤) (υ r j) *
              (wcpaLccScal g (L'.V a ⊓ g ⁻¹ᵁ ⊤) (M i j l) * β l a) := reorder _
