  ·
    subst hk
    have hy0 : (n 0 ≫ π) (IsLocalRing.closedPoint K) = y := hpts 0
    subst hy0
    have hyU : (⊤ : (Spec (.of K)).Opens) ≤ (n 0 ≫ π) ⁻¹ᵁ V₀ := by
      intro q _
      have hq : q = IsLocalRing.closedPoint K := Subsingleton.elim _ _
      rw [hq]
      exact hyV₀
    obtain ⟨sK, hsK⟩ : ∃ sK : Fin 1 × Fin 2 → (Γ(X', π ⁻¹ᵁ V₀) →+* K),
        ∀ a, sK a = (Scheme.ΓSpecIso (.of K)).hom.hom.comp
          ((n a.2).appLE (π ⁻¹ᵁ V₀) ⊤ (hσU a.2)).hom :=
      ⟨_, fun a => rfl⟩
    have hker : ∀ a, RingHom.ker (sK a) =
        RingHom.ker ((n a.2).appLE (π ⁻¹ᵁ V₀) ⊤ (hσU a.2)).hom := by
      intro a
      rw [hsK]
      exact RingHom.ker_comp_of_injective _ hΓinj
    have hEq : ∀ g, (∃ b, (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl).hom b = g) ↔
