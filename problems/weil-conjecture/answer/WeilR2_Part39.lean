      (wcpa_dj_lmga_mc_section_facts ↥W' Z' u' hsep (σ a i) (σ a i) (hσ1 a i) (hσ1 a i)).1)
  let U' : Fin (N + 1) → Z'.Opens := fun a => ⟨(⋃ i, Set.range (σ a i))ᶜ, (hCcl a).isOpen_compl⟩

  have htrace : ∀ a y, Limits.pullback.fst u'
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) y ∈
      (⋃ i, Set.range (σ a i)) ↔ y ∈ D a := by
    intro a y
    constructor
    · intro hy
      obtain ⟨i, p, hp⟩ := Set.mem_iUnion.mp hy
      have hp' : p = IsLocalRing.closedPoint ↥W' := by
        rw [← sec_pt (σ a i) (hσ1 a i) p, hp, hu'y]
      rw [hp', hσ2] at hp
      rw [← hyinj hp]
      exact hmem a i
    · intro hy
      rw [← he a] at hy
      obtain ⟨i, rfl⟩ := hy
      exact Set.mem_iUnion.mpr ⟨i, IsLocalRing.closedPoint ↥W', hσ2 a i⟩
