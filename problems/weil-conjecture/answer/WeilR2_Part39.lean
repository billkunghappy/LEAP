      · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, RingEquiv.symm_toRingHom_comp_toRingHom,
          CommRingCat.ofHom_id, Spec.map_id]
    obtain ⟨e0, he0C, he0X⟩ := chart 0 1 (by decide)
    obtain ⟨e1, he1C, he1X⟩ := chart 1 0 (by decide)
    have hx' : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
        MvPolynomial.X 1 * MvPolynomial.X 0 := mul_comm _ _
    letI alg : Algebra (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1))
        (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1)) :=
      (HomogeneousLocalization.awayMap 𝒜 (hX 0) hx').toAlgebra
    haveI hloc : IsLocalization.Away (HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0))
        (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1)) :=
      HomogeneousLocalization.Away.isLocalization_mul (hX 1) (hX 0) hx' one_ne_zero
    have helem : e1 Polynomial.X = HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0) := by
      rw [he1X]
      apply HomogeneousLocalization.val_injective
      simp only [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk,
        pow_one]
    have H : Submonoid.map e1.toMonoidHom (Submonoid.powers (Polynomial.X : Polynomial A)) =
        Submonoid.powers (HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0)) := by
      rw [Submonoid.map_powers]
      exact congrArg Submonoid.powers helem
    obtain ⟨e01, he01⟩ : ∃ e01 : LaurentPolynomial A ≃+*
        HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1),
        e01 = IsLocalization.ringEquivOfRingEquiv (LaurentPolynomial A)
          (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1)) e1 H := ⟨_, rfl⟩
    have Sq2 : e01.toRingHom.comp (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A) =
        (HomogeneousLocalization.awayMap 𝒜 (hX 0) hx').comp e1.toRingHom := by
      refine RingHom.ext fun p => ?_
      show e01 (Polynomial.toLaurent p) = HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 p)
      rw [← LaurentPolynomial.algebraMap_eq_toLaurent, he01, IsLocalization.ringEquivOfRingEquiv_eq]
      rfl
    have hS2' : ∀ p : Polynomial A, e01 (Polynomial.toLaurent p) =
        HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 p) := fun p => by
      have := congrArg (fun φ => φ p) Sq2
      exact this
    have hCL : ∀ r : A, Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
        (LaurentPolynomial.T (-1)) (Polynomial.C r) = Polynomial.toLaurent (Polynomial.C r) := by
      intro r
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
      first
        | rfl
        | simp [Polynomial.toLaurent_C, LaurentPolynomial.algebraMap_apply]
    have Sq1 : e01.toRingHom.comp (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
          (LaurentPolynomial.T (-1))) =
        (HomogeneousLocalization.awayMap 𝒜 (hX 1)
          (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
            MvPolynomial.X 0 * MvPolynomial.X 1)).comp e0.toRingHom := by
      apply Polynomial.ringHom_ext
      · intro r
        show e01 (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
          (LaurentPolynomial.T (-1)) (Polynomial.C r)) = HomogeneousLocalization.awayMap 𝒜 (hX 1)
          (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
            MvPolynomial.X 0 * MvPolynomial.X 1) (e0 (Polynomial.C r))
        rw [hCL, hS2', he0C, he1C, HomogeneousLocalization.awayMap_fromZeroRingHom,
          HomogeneousLocalization.awayMap_fromZeroRingHom]
      · show e01 (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
          (LaurentPolynomial.T (-1)) Polynomial.X) = HomogeneousLocalization.awayMap 𝒜 (hX 1)
          (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
            MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X)
        have hT1 : e01 (LaurentPolynomial.T 1) =
            HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X) := by
          rw [← Polynomial.toLaurent_X]; exact hS2' _
        have hK : HomogeneousLocalization.awayMap 𝒜 (hX 1)
              (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
                MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X) *
            HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X) = 1 := by
          rw [he0X, he1X, HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk]
          apply HomogeneousLocalization.val_injective
          rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_one,
            HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, Localization.mk_mul,
            ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
          refine ⟨1, ?_⟩
          simp only [Submonoid.coe_mul, OneMemClass.coe_one, one_mul, mul_one, pow_one]
          ring
        have hb : e01 (LaurentPolynomial.T (-1)) * e01 (LaurentPolynomial.T 1) = 1 := by
          rw [← map_mul, ← LaurentPolynomial.T_add, show (-1 : ℤ) + 1 = 0 by norm_num,
            LaurentPolynomial.T_zero, map_one]
        rw [hT1] at hb
        rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
        calc e01 (LaurentPolynomial.T (-1))
            = e01 (LaurentPolynomial.T (-1)) * (HomogeneousLocalization.awayMap 𝒜 (hX 1)
              (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
                MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X) *
              HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X)) := by rw [hK, mul_one]
          _ = HomogeneousLocalization.awayMap 𝒜 (hX 1)
              (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
                MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X) *
              (e01 (LaurentPolynomial.T (-1)) *
                HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X)) := by ring
          _ = _ := by rw [hb, mul_one]
    obtain ⟨E0, hE0⟩ := specIso e0
    obtain ⟨E1, hE1⟩ := specIso e1
    obtain ⟨E01, hE01⟩ := specIso e01
    obtain ⟨j, hj⟩ : ∃ j : Spec (CommRingCat.of (Polynomial A)) ⟶ Proj 𝒜,
        j = E0.inv ≫ Proj.awayι 𝒜 (MvPolynomial.X 0) (hX 0) one_pos := ⟨_, rfl⟩
    obtain ⟨c, hc⟩ : ∃ c : Spec (CommRingCat.of (Polynomial A)) ⟶ Proj 𝒜,
        c = E1.inv ≫ Proj.awayι 𝒜 (MvPolynomial.X 1) (hX 1) one_pos := ⟨_, rfl⟩
    have hj0 : E0.hom ≫ j = Proj.awayι 𝒜 (MvPolynomial.X 0) (hX 0) one_pos := by
      rw [hj, Iso.hom_inv_id_assoc]
    have hc0 : E1.hom ≫ c = Proj.awayι 𝒜 (MvPolynomial.X 1) (hX 1) one_pos := by
      rw [hc, Iso.hom_inv_id_assoc]
    have hirr : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
        Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) A)) := by
      intro a ha
      have h0 : GradedRing.proj 𝒜 0 a = 0 := (HomogeneousIdeal.mem_irrelevant_iff 𝒜 a).1 ha
      have hc : a.coeff 0 = 0 := by
        have h1 : GradedRing.proj 𝒜 0 a = MvPolynomial.homogeneousComponent 0 a :=
          MvPolynomial.decomposition.decompose'_apply a 0
        rw [h1, MvPolynomial.homogeneousComponent_zero] at h0
        exact MvPolynomial.C_injective (Fin 2) A (h0.trans (map_zero _).symm)
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.1 hm) hc
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.1 hm0
      exact ⟨i, Set.mem_univ _, hi⟩
    have htop := Proj.iSup_basicOpen_eq_top 𝒜 (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) A) hirr
    refine ⟨j, c, ?_, ?_, ?_, ?_, ?_⟩
    · rw [hj]; infer_instance
    · rw [hc]; infer_instance
    · have : IsAffineHom (j ≫ Proj.toSpecZero 𝒜) := isAffineHom_of_isAffine _
      have := Proj.isSeparated 𝒜
      exact IsAffineHom.of_comp j (Proj.toSpecZero 𝒜)
    · intro p
      have hp : p ∈ (⊤ : (Proj 𝒜).Opens) := trivial
      rw [← htop, TopologicalSpace.Opens.mem_iSup] at hp
      obtain ⟨i, hi⟩ := hp
      have hi' : p ∈ Set.range (Proj.awayι 𝒜 (MvPolynomial.X i) (hX i) one_pos) := by
        rw [← Scheme.Hom.coe_opensRange, Proj.opensRange_awayι]; exact hi
      obtain ⟨y, hy⟩ := hi'
      have hi2 : i = 0 ∨ i = 1 := by fin_cases i <;> simp
      rcases hi2 with rfl | rfl
      · refine Or.inl ⟨E0.hom y, ?_⟩
        rw [← hy, ← hj0]
        rfl
      · refine Or.inr ⟨E1.hom y, ?_⟩
        rw [← hy, ← hc0]
        rfl
    · refine IsPullback.of_iso (IsPullback.of_hasPullback
        (Proj.awayι 𝒜 (MvPolynomial.X 0) (hX 0) one_pos) (Proj.awayι 𝒜 (MvPolynomial.X 1) (hX 1) one_pos))
        (Proj.pullbackAwayιIso 𝒜 (hX 0) one_pos (hX 1) one_pos rfl ≪≫ E01) E0 E1 (Iso.refl _)
        ?_ ?_ ?_ ?_
      · rw [Iso.trans_hom, hE0, hE01, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, Sq1,
          CommRingCat.ofHom_comp, Spec.map_comp, ← Category.assoc,
          Proj.pullbackAwayιIso_hom_SpecMap_awayMap_left]
      · rw [Iso.trans_hom, hE1, hE01, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, Sq2,
          CommRingCat.ofHom_comp, Spec.map_comp, ← Category.assoc,
          Proj.pullbackAwayιIso_hom_SpecMap_awayMap_right]
      · rw [Iso.refl_hom, Category.comp_id, hj0]
      · rw [Iso.refl_hom, Category.comp_id, hc0]
  have hdich : ∀ f : Γ(Er, ⊤), Er.basicOpen f = ⊤ ∨ Er.basicOpen f = ⊥ := by
    intro f

    have laurent_cmp : ∀ (p q : Polynomial K),
        Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K)) (LaurentPolynomial.T (-1)) p
          = Polynomial.toLaurent q →
        p = Polynomial.C (p.coeff 0) ∧ q = Polynomial.C (p.coeff 0) := by
      intro p q h
      have hev : (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
            (LaurentPolynomial.T (-1)))
          = ((LaurentPolynomial.invert : LaurentPolynomial K ≃ₐ[K] LaurentPolynomial K) :
              LaurentPolynomial K →+* LaurentPolynomial K).comp Polynomial.toLaurent := by
        apply Polynomial.ringHom_ext
        · intro a
          simp [LaurentPolynomial.invert_C]
        · simp [LaurentPolynomial.invert_T]
      have hc1 : ∀ (r : Polynomial K) (n : ℕ),
          (Polynomial.toLaurent r).coeff (n : ℤ) = r.coeff n := by
        intro r n
        rw [LaurentPolynomial.coeff_toLaurent]
        exact Finsupp.mapDomain_apply_of_injective Nat.castEmbedding.injective _ n
      have hc2 : ∀ (r : Polynomial K) (n : ℕ), 0 < n →
          (Polynomial.toLaurent r).coeff (-(n : ℤ)) = 0 := by
        intro r n hn
        rw [LaurentPolynomial.coeff_toLaurent]
        apply Finsupp.mapDomain_notin_range
        rintro ⟨k, hk⟩
        simp at hk
        omega
      have h' : LaurentPolynomial.invert (Polynomial.toLaurent p) = Polynomial.toLaurent q := by
        rw [← h, hev]
        rfl
      have hp : ∀ n : ℕ, 0 < n → p.coeff n = 0 := by
        intro n hn
        have := congrArg (fun F : LaurentPolynomial K => F.coeff (-(n:ℤ))) h'
        simp only [LaurentPolynomial.invert_apply, neg_neg] at this
        rw [hc1, hc2 q n hn] at this
        exact this
      have hq : ∀ n : ℕ, 0 < n → q.coeff n = 0 := by
        intro n hn
        have := congrArg (fun F : LaurentPolynomial K => F.coeff (n:ℤ)) h'
        simp only [LaurentPolynomial.invert_apply] at this
        rw [hc1, hc2 p n hn] at this
        exact this.symm
      have h0 : p.coeff 0 = q.coeff 0 := by
        have := congrArg (fun F : LaurentPolynomial K => F.coeff (0:ℤ)) h'
        simp only [LaurentPolynomial.invert_apply, neg_zero] at this
        have e := hc1 p 0
        have e' := hc1 q 0
        simp only [Nat.cast_zero] at e e'
        rw [e, e'] at this
        exact this
      refine ⟨?_, ?_⟩
      · ext n
        rcases Nat.eq_zero_or_pos n with rfl | hn
        · simp
        · rw [hp n hn, Polynomial.coeff_C, if_neg (by omega)]
      · ext n
        rcases Nat.eq_zero_or_pos n with rfl | hn
        · simp [h0]
        · rw [hq n hn, Polynomial.coeff_C, if_neg (by omega)]

    obtain ⟨j, c, -, -, -, hcov, hpb⟩ := charts K
    set f₀ : Γ(@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
      MvPolynomial.gradedAlgebra, ⊤) := θ.inv.appTop.hom f with hf₀
    have hw := hpb.toCommSq.w
    have hsq : j.appTop ≫ (Scheme.ΓSpecIso (.of (Polynomial K))).hom ≫
          CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
            (LaurentPolynomial.T (-1))) =
        c.appTop ≫ (Scheme.ΓSpecIso (.of (Polynomial K))).hom ≫
          CommRingCat.ofHom (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K) := by
      have := congrArg (fun g => Scheme.Hom.appTop g ≫
        (Scheme.ΓSpecIso (.of (LaurentPolynomial K))).hom) hw
      simpa only [Scheme.Hom.comp_appTop, Category.assoc, Scheme.ΓSpecIso_naturality] using this
    have hpq := congrArg (fun g => g.hom f₀) hsq
    simp only [CommRingCat.comp_apply, CommRingCat.hom_ofHom] at hpq
    obtain ⟨hpC, hqC⟩ := laurent_cmp _ _ hpq
    set α := ((Scheme.ΓSpecIso (.of (Polynomial K))).hom.hom (j.appTop.hom f₀)).coeff 0 with hα

    have hgen : ∀ (s : Γ(Spec (.of (Polynomial K)), ⊤)) (z : Spec (.of (Polynomial K))),
        (Scheme.ΓSpecIso (.of (Polynomial K))).hom.hom s = Polynomial.C α →
        (z ∈ (Spec (.of (Polynomial K))).basicOpen s ↔ α ≠ 0) := by
      intro s z hs
      have hs' : s = (Scheme.ΓSpecIso (.of (Polynomial K))).inv.hom (Polynomial.C α) := by
        rw [← hs, Iso.hom_inv_id_apply]
      by_cases h0 : α = 0
      · have : s = 0 := by rw [hs', h0, map_zero, map_zero]
        rw [this, Scheme.basicOpen_zero]
        simp [h0]
      · have hu : IsUnit s := by
          rw [hs']
          exact (Polynomial.isUnit_C.mpr (isUnit_iff_ne_zero.mpr h0)).map _
        rw [Scheme.basicOpen_of_isUnit _ hu]
        simp [h0]
    have hxmem : ∀ x, x ∈ (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
        MvPolynomial.gradedAlgebra).basicOpen f₀ ↔ α ≠ 0 := by
      intro x
      rcases hcov x with ⟨z, rfl⟩ | ⟨z, rfl⟩
      · have e : j z ∈ (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra).basicOpen f₀ ↔ z ∈ j ⁻¹ᵁ
            (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra).basicOpen f₀ := Iff.rfl
        rw [e, Scheme.preimage_basicOpen]
        exact hgen _ z hpC
      · have e : c z ∈ (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra).basicOpen f₀ ↔ z ∈ c ⁻¹ᵁ
            (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
              MvPolynomial.gradedAlgebra).basicOpen f₀ := Iff.rfl
        rw [e, Scheme.preimage_basicOpen]
        exact hgen _ z hqC
    have hEr : ∀ w : Er, w ∈ Er.basicOpen f ↔ α ≠ 0 := by
      intro w
      have e1 : w ∈ Er.basicOpen f ↔ θ.hom w ∈ θ.inv ⁻¹ᵁ Er.basicOpen f := by
        rw [Scheme.Hom.mem_preimage, Scheme.hom_inv_apply]
      rw [e1, Scheme.preimage_basicOpen]
      exact hxmem _
    by_cases h0 : α = 0
    · exact Or.inr (eq_bot_iff.mpr fun w hw => absurd h0 ((hEr w).mp hw))
    · exact Or.inl (eq_top_iff.mpr fun w _ => (hEr w).mpr h0)
  have hcomp : ∀ z : Er, (ι ≫ ψ) z = ψ (ι z) := fun z => by
    rw [Scheme.Hom.comp_apply]
  have hle : (⊤ : Er.Opens) ≤ (ι ≫ ψ) ⁻¹ᵁ D := by
    intro z _
    show (ι ≫ ψ) z ∈ D
    rw [hcomp]
    exact hall z
  have key : ∀ a b : Er, ∀ U : Set Y, IsOpen U → ψ (ι a) ∈ U → ψ (ι b) ∉ U → False := by
    intro a b U hU ha hb
    obtain ⟨h, hhV, hha⟩ := hD.exists_basicOpen_le (V := ⟨U, hU⟩) ⟨ψ (ι a), ha⟩ (hall a)
    have hF : Er.basicOpen (((ι ≫ ψ).appLE D ⊤ hle).hom h) = ⊤ ⊓ (ι ≫ ψ) ⁻¹ᵁ Y.basicOpen h :=
      Scheme.basicOpen_appLE _ _ _ _ _
    have hmem : ∀ z : Er, z ∈ Er.basicOpen (((ι ≫ ψ).appLE D ⊤ hle).hom h) ↔
        ψ (ι z) ∈ Y.basicOpen h := by
      intro z
      rw [hF, TopologicalSpace.Opens.mem_inf, Scheme.Hom.mem_preimage, hcomp]
      simp
    rcases hdich (((ι ≫ ψ).appLE D ⊤ hle).hom h) with htop | hbot
    · have hbmem : b ∈ Er.basicOpen (((ι ≫ ψ).appLE D ⊤ hle).hom h) := by
        rw [htop]; trivial
      exact hb (hhV ((hmem b).mp hbmem))
    · have hamem := (hmem a).mpr hha
      rw [hbot] at hamem
      exact hamem
  by_contra hne
  obtain ⟨U, hU, hx⟩ := exists_isOpen_xor_mem hne
  rcases hx with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · exact key w w' U hU h1 h2
  · exact key w' w U hU h1 h2

theorem wcpa_dj_lcc_cmfc_ratio_glue : ∀ {X : Scheme.{u}} (L' : wcpaDjCoc X) (O : X.Opens) (n : ℕ) (num den : ∀ a : Fin L'.m, Γ(X, L'.V a ⊓ O)), wcpaDjCompat L' O n num → wcpaDjCompat L' O n den → ∃ ρ : Γ(X, ⨆ a, X.basicOpen (den a)), (∀ a, (X.presheaf.map (homOfLE (le_iSup (fun a' => X.basicOpen (den a')) a)).op).hom ρ * (X.presheaf.map (homOfLE (X.basicOpen_le (den a))).op).hom (den a) = (X.presheaf.map (homOfLE (X.basicOpen_le (den a))).op).hom (num a)) ∧ ∀ (a : Fin L'.m) (x : X), x ∈ X.basicOpen (den a) → (x ∈ X.basicOpen ρ ↔ x ∈ X.basicOpen (num a)) :=
by
  intro X L' O n num den hnum hden
  classical
  have res : ∀ {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(X, A)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom x) =
        (X.presheaf.map (homOfLE h3).op).hom x := by
    intro A B C h1 h2 h3 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have hu : ∀ a, IsUnit ((X.presheaf.map (homOfLE (X.basicOpen_le (den a))).op).hom (den a)) :=
    fun a => X.toRingedSpace.isUnit_res_basicOpen (den a)
  obtain ⟨r, hr⟩ : ∃ r : ∀ a : Fin L'.m, Γ(X, X.basicOpen (den a)),
      ∀ a, r a * (X.presheaf.map (homOfLE (X.basicOpen_le (den a))).op).hom (den a) =
        (X.presheaf.map (homOfLE (X.basicOpen_le (den a))).op).hom (num a) := by
    refine ⟨fun a => (X.presheaf.map (homOfLE (X.basicOpen_le (den a))).op).hom (num a) *
      ((hu a).unit⁻¹ : (Γ(X, X.basicOpen (den a)))ˣ), ?_⟩
    intro a
    rw [mul_assoc, IsUnit.val_inv_mul, mul_one]
  have compat : TopCat.Presheaf.IsCompatible X.sheaf.obj
      (fun a => X.basicOpen (den a)) r := by
    intro a b
    have ra : X.basicOpen (den a) ≤ L'.V a ⊓ O := X.basicOpen_le (den a)
    have rb : X.basicOpen (den b) ≤ L'.V b ⊓ O := X.basicOpen_le (den b)
    have hPb : L'.V a ⊓ L'.V b ⊓ O ≤ L'.V b ⊓ O :=
      le_inf (inf_le_left.trans inf_le_right) inf_le_right
    have hPa : L'.V a ⊓ L'.V b ⊓ O ≤ L'.V a ⊓ O :=
      le_inf (inf_le_left.trans inf_le_left) inf_le_right
    have hPab : L'.V a ⊓ L'.V b ⊓ O ≤ L'.V a ⊓ L'.V b := inf_le_left
    have hQP : X.basicOpen (den a) ⊓ X.basicOpen (den b) ≤ L'.V a ⊓ L'.V b ⊓ O :=
      fun x hx => ⟨⟨(ra hx.1).1, (rb hx.2).1⟩, (ra hx.1).2⟩
    have hQa : X.basicOpen (den a) ⊓ X.basicOpen (den b) ≤ X.basicOpen (den a) := inf_le_left
    have hQb : X.basicOpen (den a) ⊓ X.basicOpen (den b) ≤ X.basicOpen (den b) := inf_le_right
    have hC : ∀ f : ∀ a : Fin L'.m, Γ(X, L'.V a ⊓ O), wcpaDjCompat L' O n f →
        (X.presheaf.map (homOfLE hPb).op).hom (f b) =
        (X.presheaf.map (homOfLE hPab).op).hom ((L'.g a b : Γ(X, L'.V a ⊓ L'.V b)) ^ n) *
        (X.presheaf.map (homOfLE hPa).op).hom (f a) := fun f hf => hf a b
    have key : ∀ f : ∀ a : Fin L'.m, Γ(X, L'.V a ⊓ O), wcpaDjCompat L' O n f →
        (X.presheaf.map (homOfLE (hQb.trans rb)).op).hom (f b) =
        (X.presheaf.map (homOfLE hQP).op).hom ((X.presheaf.map (homOfLE hPab).op).hom
          ((L'.g a b : Γ(X, L'.V a ⊓ L'.V b)) ^ n)) *
        (X.presheaf.map (homOfLE hQa).op).hom ((X.presheaf.map (homOfLE ra).op).hom (f a)) := by
      intro f hf
      rw [← res hPb hQP (hQb.trans rb), hC f hf, map_mul, res hPa hQP (hQa.trans ra),
        res ra hQa (hQa.trans ra)]
    have hσ : IsUnit ((X.presheaf.map (homOfLE (hQb.trans rb)).op).hom (den b)) := by
      rw [← res rb hQb (hQb.trans rb)]
      exact (hu b).map _
    show (X.presheaf.map (homOfLE hQa).op).hom (r a) =
      (X.presheaf.map (homOfLE hQb).op).hom (r b)
    rw [← hσ.mul_left_inj]
    calc _ = (X.presheaf.map (homOfLE hQP).op).hom ((X.presheaf.map (homOfLE hPab).op).hom
          ((L'.g a b : Γ(X, L'.V a ⊓ L'.V b)) ^ n)) *
        (X.presheaf.map (homOfLE hQa).op).hom
          (r a * (X.presheaf.map (homOfLE ra).op).hom (den a)) := by
          rw [key den hden, map_mul (X.presheaf.map (homOfLE hQa).op).hom]
          ring
      _ = (X.presheaf.map (homOfLE (hQb.trans rb)).op).hom (num b) := by
          rw [hr a, key num hnum]
      _ = _ := by
          rw [← res rb hQb (hQb.trans rb) (num b), ← res rb hQb (hQb.trans rb) (den b),
            ← map_mul (X.presheaf.map (homOfLE hQb).op).hom, hr b]
  have glue : ∃ ρ : Γ(X, ⨆ a, X.basicOpen (den a)), ∀ a,
      (X.presheaf.map (homOfLE (le_iSup (fun a' => X.basicOpen (den a')) a)).op).hom ρ =
        r a := by
    obtain ⟨ρ, hρ, -⟩ := TopCat.Sheaf.existsUnique_gluing' X.sheaf
      (fun a => X.basicOpen (den a)) (⨆ a, X.basicOpen (den a))
      (fun a => homOfLE (le_iSup (fun a' => X.basicOpen (den a')) a)) le_rfl r compat
    exact ⟨ρ, hρ⟩
  obtain ⟨ρ, hρ⟩ := glue
  have C1 : ∀ a, (X.presheaf.map (homOfLE (le_iSup (fun a' => X.basicOpen (den a')) a)).op).hom ρ *
      (X.presheaf.map (homOfLE (X.basicOpen_le (den a))).op).hom (den a) =
      (X.presheaf.map (homOfLE (X.basicOpen_le (den a))).op).hom (num a) := by
    intro a
    rw [hρ a, hr a]
  refine ⟨ρ, C1, ?_⟩
  intro a x hx
  have h := congrArg (fun z => x ∈ X.basicOpen z) (C1 a)
  simp only [Scheme.basicOpen_mul, Scheme.basicOpen_res, TopologicalSpace.Opens.mem_inf, hx,
    true_and, and_true] at h
  exact Iff.of_eq h

theorem wcpa_dj_lcc_cmfc_p1_basicOpen_dichotomy : ∀ (K : Type u) [Field K] (Er : Scheme.{u}) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra) (f : Γ(Er, ⊤)), Er.basicOpen f = ⊤ ∨ Er.basicOpen f = ⊥ :=
by
  have wcP1 : ∀ (A : Type u) [CommRing A], ∃ (j c : Spec (.of (Polynomial A)) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), IsOpenImmersion j ∧ IsOpenImmersion c ∧ IsAffineHom j ∧ (∀ x, x ∈ Set.range j ∨ x ∈ Set.range c) ∧ IsPullback (Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A)) (LaurentPolynomial.T (-1))))) (Spec.map (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A))) j c := ?_
  intro K _ Er θ f
  obtain ⟨j, c, -, -, -, hcov, hpb⟩ := wcP1 K
  have hsq := hpb.toCommSq.w

  have s1 : ∀ p q : Polynomial K,
      Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K)) (LaurentPolynomial.T (-1)) p =
        (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K) q →
      p = Polynomial.C (q.coeff 0) ∧ q = Polynomial.C (q.coeff 0) := by
    intro p q h
    have hev : Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K))
        (LaurentPolynomial.T (-1)) =
        (LaurentPolynomial.invert : LaurentPolynomial K ≃ₐ[K] LaurentPolynomial K).toRingEquiv.toRingHom.comp
          (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K) := by
      apply Polynomial.ringHom_ext
      · intro a
        simp [LaurentPolynomial.algebraMap_apply]
      · simp
    rw [hev] at h
    have hk : ∀ k : ℤ, (Polynomial.toLaurent p : LaurentPolynomial K).coeff (-k) =
        (Polynomial.toLaurent q : LaurentPolynomial K).coeff k := by
      intro k
      have h1 := congrArg (fun F : LaurentPolynomial K => F.coeff k) h
      change (LaurentPolynomial.invert (Polynomial.toLaurent p)).coeff k = _ at h1
      rw [LaurentPolynomial.invert_apply] at h1
      exact h1
    have hnat : ∀ (r : Polynomial K) (n : ℕ),
        (Polynomial.toLaurent r : LaurentPolynomial K).coeff (n : ℤ) = r.coeff n := by
      intro r n
      rw [LaurentPolynomial.coeff_toLaurent]
      exact Finsupp.mapDomain_apply_of_injective Nat.castEmbedding.injective _ n
    have hneg : ∀ (r : Polynomial K) (m : ℤ), m < 0 →
        (Polynomial.toLaurent r : LaurentPolynomial K).coeff m = 0 := by
      intro r m hm
      rw [LaurentPolynomial.coeff_toLaurent]
      apply Finsupp.mapDomain_of_notMem_range
      rintro ⟨n, rfl⟩
      have : (0 : ℤ) ≤ Nat.castEmbedding n := by simp
      omega
    have h0 : p.coeff 0 = q.coeff 0 := by
      have e1 := hnat p 0
      have e2 := hnat q 0
      simp only [Nat.cast_zero] at e1 e2
      have := hk 0
      rw [neg_zero, e1, e2] at this
      exact this
    have hp : ∀ i : ℕ, p.coeff (i + 1) = 0 := by
      intro i
      have := hk (-((i + 1 : ℕ) : ℤ))
      rw [neg_neg, hnat, hneg q _ (by omega)] at this
      exact this
    have hq : ∀ i : ℕ, q.coeff (i + 1) = 0 := by
      intro i
      have := hk ((i + 1 : ℕ) : ℤ)
      rw [hneg p _ (by omega), hnat] at this
      exact this.symm
    constructor
    · ext n
      rcases n with _ | i
      · simp [Polynomial.coeff_C, h0]
      · simp [Polynomial.coeff_C, hp i]
    · ext n
      rcases n with _ | i
      · simp [Polynomial.coeff_C]
      · simp [Polynomial.coeff_C, hq i]

  have s2 : ∀ (g : Γ(Spec (.of (Polynomial K)), ⊤)) (α : K),
      (Scheme.ΓSpecIso (.of (Polynomial K))).hom g = Polynomial.C α →
      (α ≠ 0 → (Spec (.of (Polynomial K))).basicOpen g = ⊤) ∧
        (α = 0 → (Spec (.of (Polynomial K))).basicOpen g = ⊥) := by
    intro g α hg
    have hg' : g = (Scheme.ΓSpecIso (.of (Polynomial K))).inv (Polynomial.C α) := by
      rw [← hg]; simp
    constructor
    · intro hα
      apply Scheme.basicOpen_of_isUnit
      rw [hg']
      exact (Polynomial.isUnit_C.mpr (isUnit_iff_ne_zero.mpr hα)).map _
    · intro hα
      rw [hg', hα, Polynomial.C_0, map_zero]
      exact Scheme.basicOpen_zero _ _

  set f₀ := θ.inv.appTop f with hf₀
  have hsq' : Polynomial.eval₂RingHom (algebraMap K (LaurentPolynomial K)) (LaurentPolynomial.T (-1))
      ((Scheme.ΓSpecIso (.of (Polynomial K))).hom (j.appTop f₀)) =
      (Polynomial.toLaurent : Polynomial K →+* LaurentPolynomial K)
      ((Scheme.ΓSpecIso (.of (Polynomial K))).hom (c.appTop f₀)) := by
    have h1 := congrArg Scheme.Hom.appTop hsq
    rw [Scheme.Hom.comp_appTop, Scheme.Hom.comp_appTop] at h1
    have h2 := congrArg (· ≫ (Scheme.ΓSpecIso (.of (LaurentPolynomial K))).hom) h1
    simp only [Category.assoc, Scheme.ΓSpecIso_naturality] at h2
    have h3 := congrArg (fun φ => φ.hom f₀) h2
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h3
    exact h3
  obtain ⟨hpC, hqC⟩ := s1 _ _ hsq'
  set α := ((Scheme.ΓSpecIso (.of (Polynomial K))).hom (c.appTop f₀)).coeff 0 with hα_def
  have hJ := s2 (j.appTop f₀) α hpC
  have hC := s2 (c.appTop f₀) α hqC
  have hθ : θ.inv ⁻¹ᵁ Er.basicOpen f = (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
      MvPolynomial.gradedAlgebra).basicOpen f₀ := Scheme.preimage_basicOpen θ.inv f
  have hj : j ⁻¹ᵁ (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
      MvPolynomial.gradedAlgebra).basicOpen f₀ =
      (Spec (.of (Polynomial K))).basicOpen (j.appTop f₀) := Scheme.preimage_basicOpen j f₀
  have hc : c ⁻¹ᵁ (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
      MvPolynomial.gradedAlgebra).basicOpen f₀ =
      (Spec (.of (Polynomial K))).basicOpen (c.appTop f₀) := Scheme.preimage_basicOpen c f₀
  by_cases hα : α = 0
  · right
    apply le_antisymm _ bot_le
    intro w hw
    have h1 : θ.hom w ∈ θ.inv ⁻¹ᵁ Er.basicOpen f := by
      rw [Scheme.Hom.mem_preimage, Scheme.hom_inv_apply]; exact hw
    rw [hθ] at h1
    rcases hcov (θ.hom w) with ⟨z, hz⟩ | ⟨z, hz⟩
    · have h2 : z ∈ j ⁻¹ᵁ (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra).basicOpen f₀ := by
        rw [Scheme.Hom.mem_preimage, hz]; exact h1
      rw [hj, hJ.2 hα] at h2
      exact absurd h2 (by simp)
    · have h2 : z ∈ c ⁻¹ᵁ (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra).basicOpen f₀ := by
        rw [Scheme.Hom.mem_preimage, hz]; exact h1
      rw [hc, hC.2 hα] at h2
      exact absurd h2 (by simp)
  · left
    apply le_antisymm le_top
    intro w _
    rcases hcov (θ.hom w) with ⟨z, hz⟩ | ⟨z, hz⟩
    · have h2 : z ∈ j ⁻¹ᵁ (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra).basicOpen f₀ := by
        rw [hj, hJ.1 hα]; trivial
      rw [Scheme.Hom.mem_preimage, hz, ← hθ, Scheme.Hom.mem_preimage,
        Scheme.hom_inv_apply] at h2
      exact h2
    · have h2 : z ∈ c ⁻¹ᵁ (@Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra).basicOpen f₀ := by
        rw [hc, hC.1 hα]; trivial
      rw [Scheme.Hom.mem_preimage, hz, ← hθ, Scheme.Hom.mem_preimage,
        Scheme.hom_inv_apply] at h2
      exact h2

  intro A _
  let 𝒜 : ℕ → Submodule A (MvPolynomial (Fin 2) A) := MvPolynomial.homogeneousSubmodule (Fin 2) A
  let _inst𝒜 : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra

  have fin2 : ∀ a b c : Fin 2, a ≠ b → c ≠ a → c = b := by decide
  have hX : ∀ i : Fin 2, (MvPolynomial.X i : MvPolynomial (Fin 2) A) ∈ 𝒜 1 := fun i =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X A i)
  have h11 : ∀ k : Fin 2, (MvPolynomial.X k : MvPolynomial (Fin 2) A) ∈ 𝒜 (1 • 1) := fun k => by
    rw [smul_eq_mul, mul_one]; exact hX k

  have s1 : ∀ {T : Type u} [CommRing T] (f : A →+* T) (g : Fin 2 → T) (c : T)
      (φ : MvPolynomial (Fin 2) A) (n : ℕ), φ.IsHomogeneous n →
      MvPolynomial.eval₂ f (fun i => c * g i) φ = c ^ n * MvPolynomial.eval₂ f g φ := by
    intro T _ f g c φ n hφ
    conv_lhs => rw [φ.as_sum]
    conv_rhs => rw [φ.as_sum]
    rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
    have hdeg : ∑ i ∈ d.support, d i = n := by
      have := hφ (MvPolynomial.mem_support_iff.mp hd)
      simpa [Finsupp.weight_apply, Finsupp.sum] using this
    simp only [Finsupp.prod, mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
    ring

  have hval0 : ∀ (f : MvPolynomial (Fin 2) A) (a : ↥(𝒜 0)),
      (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f) a).val =
        algebraMap (MvPolynomial (Fin 2) A) (Localization.Away f) (a : MvPolynomial (Fin 2) A) := by
    intro f a
    rfl
  have hcoe0 : ∀ r : A, ((algebraMap A (𝒜 0) r : ↥(𝒜 0)) : MvPolynomial (Fin 2) A) = MvPolynomial.C r := by
    intro r
    rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]

  have chart : ∀ i k : Fin 2, i ≠ k → ∃ e : Polynomial A ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i),
      (∀ r : A, e (Polynomial.C r) = HomogeneousLocalization.fromZeroRingHom 𝒜
        (Submonoid.powers (MvPolynomial.X i)) (algebraMap A (𝒜 0) r)) ∧
      e Polynomial.X = HomogeneousLocalization.Away.mk 𝒜 (hX i) 1 (MvPolynomial.X k) (h11 k) := by
    intro i k hik
    obtain ⟨κ, hκ⟩ : ∃ κ : A →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i),
        κ = (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X i))).comp
          (algebraMap A (𝒜 0)) := ⟨_, rfl⟩
    obtain ⟨α, hα⟩ : ∃ α : Polynomial A →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i),
        α = Polynomial.eval₂RingHom κ
          (HomogeneousLocalization.Away.mk 𝒜 (hX i) 1 (MvPolynomial.X k) (h11 k)) := ⟨_, rfl⟩
    obtain ⟨ψ, hψ⟩ : ∃ ψ : MvPolynomial (Fin 2) A →+* Polynomial A,
        ψ = MvPolynomial.eval₂Hom Polynomial.C (fun j => if j = i then 1 else Polynomial.X) := ⟨_, rfl⟩
    have hψi : ψ (MvPolynomial.X i) = 1 := by rw [hψ, MvPolynomial.eval₂Hom_X', if_pos rfl]
    have hψk : ψ (MvPolynomial.X k) = Polynomial.X := by
      rw [hψ, MvPolynomial.eval₂Hom_X', if_neg (Ne.symm hik)]
    have hψC : ∀ r, ψ (MvPolynomial.C r) = Polynomial.C r := by
      intro r; rw [hψ, MvPolynomial.eval₂Hom_C]
    have hψv : ψ (MvPolynomial.X i) * 1 = 1 := by rw [hψi, mul_one]
    have hu : IsUnit (ψ (MvPolynomial.X i)) := by rw [hψi]; exact isUnit_one
    obtain ⟨χ, hχ⟩ : ∃ χ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i) →+* Polynomial A,
        χ = (Localization.awayLift ψ (MvPolynomial.X i) hu).comp
          (algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i))
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))) := ⟨_, rfl⟩
    have hχmk : ∀ (n : ℕ) (a : MvPolynomial (Fin 2) A) (ha : a ∈ 𝒜 (n • 1)),
        χ (HomogeneousLocalization.Away.mk 𝒜 (hX i) n a ha) = ψ a := by
      intro n a ha
      rw [hχ, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk, Localization.awayLift_mk ψ (MvPolynomial.X i) a 1 hψv n,
        one_pow, mul_one]
    have hκv : ∀ r, (κ r).val = algebraMap (MvPolynomial (Fin 2) A)
        (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.C r) := by
      intro r
      rw [hκ, RingHom.comp_apply, hval0, hcoe0]
    have h1 : χ.comp α = RingHom.id _ := by
      apply Polynomial.ringHom_ext
      · intro r
        rw [RingHom.comp_apply, hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hχ,
          RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply, hκv]
        first
          | rw [IsLocalization.lift_eq]
          | erw [IsLocalization.lift_eq]
        rw [hψC, RingHom.id_apply]
      · rw [RingHom.comp_apply, hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X, hχmk, hψk,
          RingHom.id_apply]
    have h2 : α.comp χ = RingHom.id _ := by
      refine RingHom.ext fun w => ?_
      obtain ⟨n, a, ha, rfl⟩ := HomogeneousLocalization.Away.mk_surjective 𝒜 (hX i) w
      rw [RingHom.comp_apply, hχmk, RingHom.id_apply]
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.Away.val_mk]
      have ha' : a.IsHomogeneous n := by
        have := (MvPolynomial.mem_homogeneousSubmodule _ a).1 ha
        simpa using this
      obtain ⟨μ, hμdef⟩ : ∃ μ : Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A),
          μ = IsLocalization.mk' (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))
            (1 : MvPolynomial (Fin 2) A) ⟨MvPolynomial.X i, Submonoid.mem_powers _⟩ := ⟨_, rfl⟩
      have hμ : μ * algebraMap (MvPolynomial (Fin 2) A)
          (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X i) = 1 := by
        have := IsLocalization.mk'_spec (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))
          (1 : MvPolynomial (Fin 2) A) ⟨MvPolynomial.X i, Submonoid.mem_powers _⟩
        rw [map_one] at this
        rw [hμdef]; exact this
      have hρ : (algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i))
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp (α.comp ψ) =
          MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin 2) A)
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp MvPolynomial.C)
            (fun j => μ * algebraMap (MvPolynomial (Fin 2) A)
              (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X j)) := by
        apply MvPolynomial.ringHom_ext
        · intro r
          simp only [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
          rw [hψC, hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C,
            HomogeneousLocalization.algebraMap_apply, hκv]
        · intro j
          simp only [MvPolynomial.eval₂Hom_X', RingHom.comp_apply]
          by_cases hj : j = i
          · subst hj
            rw [hψi, map_one, map_one, hμ]
          · have hjk : j = k := fin2 i k j hik hj
            subst hjk
            rw [hψk, hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X,
              HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk,
              Localization.mk_eq_mk'_apply, IsLocalization.mk'_eq_iff_eq_mul]
            show _ = μ * _ * algebraMap (MvPolynomial (Fin 2) A)
              (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X i ^ 1)
            rw [pow_one, mul_comm μ, mul_assoc, hμ, mul_one]
      have hσ : MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin 2) A)
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp MvPolynomial.C)
            (fun j => algebraMap (MvPolynomial (Fin 2) A)
              (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X j)) =
          algebraMap (MvPolynomial (Fin 2) A)
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) := by
        apply MvPolynomial.ringHom_ext
        · intro r; simp only [MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
        · intro j; simp only [MvPolynomial.eval₂Hom_X']
      have hval : (α (ψ a)).val = ((algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i))
            (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))).comp (α.comp ψ)) a := by
        rw [RingHom.comp_apply, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply]
      rw [hval, hρ, MvPolynomial.coe_eval₂Hom, s1 _ (fun j => algebraMap (MvPolynomial (Fin 2) A)
          (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X j)) μ a n ha',
        ← MvPolynomial.coe_eval₂Hom, hσ, Localization.mk_eq_mk'_apply, eq_comm,
        IsLocalization.mk'_eq_iff_eq_mul]
      show _ = μ ^ n * _ * algebraMap (MvPolynomial (Fin 2) A)
        (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A)) (MvPolynomial.X i ^ n)
      rw [map_pow, mul_comm (μ ^ n), mul_assoc, ← mul_pow, hμ, one_pow, mul_one]
    refine ⟨RingEquiv.ofRingHom α χ h2 h1, ?_, ?_⟩
    · intro r
      show α (Polynomial.C r) = _
      rw [hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C, hκ, RingHom.comp_apply]
    · show α Polynomial.X = _
      rw [hα, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]

  have specIso : ∀ {R R' : Type u} [CommRing R] [CommRing R'] (e : R ≃+* R'),
      ∃ E : Spec (CommRingCat.of R') ≅ Spec (CommRingCat.of R),
        E.hom = Spec.map (CommRingCat.ofHom e.toRingHom) := by
    intro R R' _ _ e
    refine ⟨⟨Spec.map (CommRingCat.ofHom e.toRingHom), Spec.map (CommRingCat.ofHom e.symm.toRingHom),
      ?_, ?_⟩, rfl⟩
    · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, RingEquiv.toRingHom_comp_symm_toRingHom,
        CommRingCat.ofHom_id, Spec.map_id]
    · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, RingEquiv.symm_toRingHom_comp_toRingHom,
        CommRingCat.ofHom_id, Spec.map_id]
  obtain ⟨e0, he0C, he0X⟩ := chart 0 1 (by decide)
  obtain ⟨e1, he1C, he1X⟩ := chart 1 0 (by decide)

  have hx' : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
      MvPolynomial.X 1 * MvPolynomial.X 0 := mul_comm _ _
  letI alg : Algebra (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 1))
      (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1)) :=
    (HomogeneousLocalization.awayMap 𝒜 (hX 0) hx').toAlgebra
  haveI hloc : IsLocalization.Away (HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0))
      (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1)) :=
    HomogeneousLocalization.Away.isLocalization_mul (hX 1) (hX 0) hx' one_ne_zero
  have helem : e1 Polynomial.X = HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0) := by
    rw [he1X]
    apply HomogeneousLocalization.val_injective
    simp only [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk,
      pow_one]
  have H : Submonoid.map e1.toMonoidHom (Submonoid.powers (Polynomial.X : Polynomial A)) =
      Submonoid.powers (HomogeneousLocalization.Away.isLocalizationElem (hX 1) (hX 0)) := by
    rw [Submonoid.map_powers]
    exact congrArg Submonoid.powers helem
  obtain ⟨e01, he01⟩ : ∃ e01 : LaurentPolynomial A ≃+*
      HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1),
      e01 = IsLocalization.ringEquivOfRingEquiv (LaurentPolynomial A)
        (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X 0 * MvPolynomial.X 1)) e1 H := ⟨_, rfl⟩
  have Sq2 : e01.toRingHom.comp (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A) =
      (HomogeneousLocalization.awayMap 𝒜 (hX 0) hx').comp e1.toRingHom := by
    refine RingHom.ext fun p => ?_
    show e01 (Polynomial.toLaurent p) = HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 p)
    rw [← LaurentPolynomial.algebraMap_eq_toLaurent, he01, IsLocalization.ringEquivOfRingEquiv_eq]
    rfl
  have hS2' : ∀ p : Polynomial A, e01 (Polynomial.toLaurent p) =
      HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 p) := fun p => by
    have := congrArg (fun φ => φ p) Sq2
    exact this
  have hCL : ∀ r : A, Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
      (LaurentPolynomial.T (-1)) (Polynomial.C r) = Polynomial.toLaurent (Polynomial.C r) := by
    intro r
    rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_C]
    first
      | rfl
      | simp [Polynomial.toLaurent_C, LaurentPolynomial.algebraMap_apply]
  have Sq1 : e01.toRingHom.comp (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
        (LaurentPolynomial.T (-1))) =
      (HomogeneousLocalization.awayMap 𝒜 (hX 1)
        (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
          MvPolynomial.X 0 * MvPolynomial.X 1)).comp e0.toRingHom := by
    apply Polynomial.ringHom_ext
    · intro r
      show e01 (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
        (LaurentPolynomial.T (-1)) (Polynomial.C r)) = HomogeneousLocalization.awayMap 𝒜 (hX 1)
        (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
          MvPolynomial.X 0 * MvPolynomial.X 1) (e0 (Polynomial.C r))
      rw [hCL, hS2', he0C, he1C, HomogeneousLocalization.awayMap_fromZeroRingHom,
        HomogeneousLocalization.awayMap_fromZeroRingHom]
    · show e01 (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A))
        (LaurentPolynomial.T (-1)) Polynomial.X) = HomogeneousLocalization.awayMap 𝒜 (hX 1)
        (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
          MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X)
      have hT1 : e01 (LaurentPolynomial.T 1) =
          HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X) := by
        rw [← Polynomial.toLaurent_X]; exact hS2' _
      have hK : HomogeneousLocalization.awayMap 𝒜 (hX 1)
            (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
              MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X) *
          HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X) = 1 := by
        rw [he0X, he1X, HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk]
        apply HomogeneousLocalization.val_injective
        rw [HomogeneousLocalization.val_mul, HomogeneousLocalization.val_one,
          HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk, Localization.mk_mul,
          ← Localization.mk_one, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
        refine ⟨1, ?_⟩
        simp only [Submonoid.coe_mul, OneMemClass.coe_one, one_mul, mul_one, pow_one]
        ring
      have hb : e01 (LaurentPolynomial.T (-1)) * e01 (LaurentPolynomial.T 1) = 1 := by
        rw [← map_mul, ← LaurentPolynomial.T_add, show (-1 : ℤ) + 1 = 0 by norm_num,
          LaurentPolynomial.T_zero, map_one]
      rw [hT1] at hb
      rw [Polynomial.coe_eval₂RingHom, Polynomial.eval₂_X]
      calc e01 (LaurentPolynomial.T (-1))
          = e01 (LaurentPolynomial.T (-1)) * (HomogeneousLocalization.awayMap 𝒜 (hX 1)
            (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
              MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X) *
            HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X)) := by rw [hK, mul_one]
        _ = HomogeneousLocalization.awayMap 𝒜 (hX 1)
            (rfl : (MvPolynomial.X 0 * MvPolynomial.X 1 : MvPolynomial (Fin 2) A) =
              MvPolynomial.X 0 * MvPolynomial.X 1) (e0 Polynomial.X) *
            (e01 (LaurentPolynomial.T (-1)) *
              HomogeneousLocalization.awayMap 𝒜 (hX 0) hx' (e1 Polynomial.X)) := by ring
        _ = _ := by rw [hb, mul_one]

  obtain ⟨E0, hE0⟩ := specIso e0
  obtain ⟨E1, hE1⟩ := specIso e1
  obtain ⟨E01, hE01⟩ := specIso e01
  obtain ⟨j, hj⟩ : ∃ j : Spec (CommRingCat.of (Polynomial A)) ⟶ Proj 𝒜,
      j = E0.inv ≫ Proj.awayι 𝒜 (MvPolynomial.X 0) (hX 0) one_pos := ⟨_, rfl⟩
  obtain ⟨c, hc⟩ : ∃ c : Spec (CommRingCat.of (Polynomial A)) ⟶ Proj 𝒜,
      c = E1.inv ≫ Proj.awayι 𝒜 (MvPolynomial.X 1) (hX 1) one_pos := ⟨_, rfl⟩
  have hj0 : E0.hom ≫ j = Proj.awayι 𝒜 (MvPolynomial.X 0) (hX 0) one_pos := by
    rw [hj, Iso.hom_inv_id_assoc]
  have hc0 : E1.hom ≫ c = Proj.awayι 𝒜 (MvPolynomial.X 1) (hX 1) one_pos := by
    rw [hc, Iso.hom_inv_id_assoc]

  have hirr : (HomogeneousIdeal.irrelevant 𝒜).toIdeal ≤
      Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) A)) := by
    intro a ha
    have h0 : GradedRing.proj 𝒜 0 a = 0 := (HomogeneousIdeal.mem_irrelevant_iff 𝒜 a).1 ha
    have hc : a.coeff 0 = 0 := by
      have h1 : GradedRing.proj 𝒜 0 a = MvPolynomial.homogeneousComponent 0 a :=
        MvPolynomial.decomposition.decompose'_apply a 0
      rw [h1, MvPolynomial.homogeneousComponent_zero] at h0
      exact MvPolynomial.C_injective (Fin 2) A (h0.trans (map_zero _).symm)
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.1 hm) hc
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.1 hm0
    exact ⟨i, Set.mem_univ _, hi⟩
  have htop := Proj.iSup_basicOpen_eq_top 𝒜 (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) A) hirr
  refine ⟨j, c, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hj]; infer_instance
  · rw [hc]; infer_instance
  · have : IsAffineHom (j ≫ Proj.toSpecZero 𝒜) := isAffineHom_of_isAffine _
    have := Proj.isSeparated 𝒜
    exact IsAffineHom.of_comp j (Proj.toSpecZero 𝒜)
  · intro p
    have hp : p ∈ (⊤ : (Proj 𝒜).Opens) := trivial
    rw [← htop, TopologicalSpace.Opens.mem_iSup] at hp
    obtain ⟨i, hi⟩ := hp
    have hi' : p ∈ Set.range (Proj.awayι 𝒜 (MvPolynomial.X i) (hX i) one_pos) := by
      rw [← Scheme.Hom.coe_opensRange, Proj.opensRange_awayι]; exact hi
    obtain ⟨y, hy⟩ := hi'
    have hi2 : i = 0 ∨ i = 1 := by fin_cases i <;> simp
    rcases hi2 with rfl | rfl
    · refine Or.inl ⟨E0.hom y, ?_⟩
      rw [← hy, ← hj0]
      rfl
    · refine Or.inr ⟨E1.hom y, ?_⟩
      rw [← hy, ← hc0]
      rfl
  · refine IsPullback.of_iso (IsPullback.of_hasPullback
      (Proj.awayι 𝒜 (MvPolynomial.X 0) (hX 0) one_pos) (Proj.awayι 𝒜 (MvPolynomial.X 1) (hX 1) one_pos))
      (Proj.pullbackAwayιIso 𝒜 (hX 0) one_pos (hX 1) one_pos rfl ≪≫ E01) E0 E1 (Iso.refl _)
      ?_ ?_ ?_ ?_
    · rw [Iso.trans_hom, hE0, hE01, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, Sq1,
        CommRingCat.ofHom_comp, Spec.map_comp, ← Category.assoc,
        Proj.pullbackAwayιIso_hom_SpecMap_awayMap_left]
    · rw [Iso.trans_hom, hE1, hE01, Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, Sq2,
        CommRingCat.ofHom_comp, Spec.map_comp, ← Category.assoc,
        Proj.pullbackAwayιIso_hom_SpecMap_awayMap_right]
    · rw [Iso.refl_hom, Category.comp_id, hj0]
    · rw [Iso.refl_hom, Category.comp_id, hc0]

theorem wcpa_dj_lcc_cmfc_trivial_component_in_chart : ∀ {X Y : Scheme.{u}} (ψ : X ⟶ Y) (D : Y.Opens) (L' : wcpaDjCoc X) (O : X.Opens) (n : ℕ) (g τ : ∀ a : Fin L'.m, Γ(X, L'.V a ⊓ O)), wcpaDjCompat L' O n g → wcpaDjCompat L' O n τ → ψ ⁻¹ᵁ D = ⨆ a, X.basicOpen (g a) → ∀ (K : Type u) [Field K] (Er : Scheme.{u}) (ι : Er ⟶ X) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), (∀ (w : Er) (a : Fin L'.m), ι w ∈ L'.V a ⊓ O → ι w ∈ X.basicOpen (τ a)) → (∀ w : Er, ∃ a : Fin L'.m, ι w ∈ L'.V a ⊓ O) → (∃ w₀ : Er, ψ (ι w₀) ∈ D) → ∀ w : Er, ψ (ι w) ∈ D :=
by
  intro X Y ψ D L' O n g τ hg hτ hpre K _ Er ι θ H1 H2 H3 w
  obtain ⟨ρ, -, KP⟩ := wcpa_dj_lcc_cmfc_ratio_glue L' O n g τ hg hτ

  have hle : (⊤ : Er.Opens) ≤ ι ⁻¹ᵁ (⨆ a, X.basicOpen (τ a)) := by
    intro v _
    obtain ⟨a, ha⟩ := H2 v
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, H1 v a ha⟩

  have key : ∀ v : Er, v ∈ Er.basicOpen ((ι.appLE (⨆ a, X.basicOpen (τ a)) ⊤ hle).hom ρ) ↔
      ι v ∈ X.basicOpen ρ := by
    intro v
    rw [Scheme.basicOpen_appLE, TopologicalSpace.Opens.mem_inf]
    exact ⟨fun h => h.2, fun h => ⟨trivial, h⟩⟩

  have bridge : ∀ v : Er, ι v ∈ X.basicOpen ρ ↔ ψ (ι v) ∈ D := by
    intro v
    constructor
    · intro h
      obtain ⟨a, ha⟩ := H2 v
      have h1 := (KP a (ι v) (H1 v a ha)).mp h
      have h2 : ι v ∈ ψ ⁻¹ᵁ D := by
        rw [hpre]
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, h1⟩
      exact h2
    · intro h
      have h2 : ι v ∈ ψ ⁻¹ᵁ D := h
      rw [hpre] at h2
      obtain ⟨a₀, ha₀⟩ := TopologicalSpace.Opens.mem_iSup.mp h2
      exact (KP a₀ (ι v) (H1 v a₀ (X.basicOpen_le _ ha₀))).mpr ha₀

  rcases wcpa_dj_lcc_cmfc_p1_basicOpen_dichotomy K Er θ
      ((ι.appLE (⨆ a, X.basicOpen (τ a)) ⊤ hle).hom ρ) with hT | hB
  · have hw : w ∈ Er.basicOpen ((ι.appLE (⨆ a, X.basicOpen (τ a)) ⊤ hle).hom ρ) := by
      rw [hT]; trivial
    exact (bridge w).mp ((key w).mp hw)
  · exfalso
    obtain ⟨w₀, hw₀⟩ := H3
    have h0 := (key w₀).mpr ((bridge w₀).mpr hw₀)
    rw [hB] at h0
    exact absurd h0 (by simp)

theorem wcpa_dj_lcc_cm_fibre_contracts (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (r : ℕ)
    (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)) (L : wcpaDjCoc Z₁)
    (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) (m : ℕ)
    (hSH : wcpaLccSH W u₁ ε L t m)
    (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (φ : Z₁ ⟶ Z) (hφ : φ ≫ uu = u₁)
    (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Spec (.of ↥W))
    (φs : Limits.pullback u₁ s ⟶ Limits.pullback uu s)
    (h1 : φs ≫ Limits.pullback.fst uu s = Limits.pullback.fst u₁ s ≫ φ)
    (h2 : φs ≫ Limits.pullback.snd uu s = Limits.pullback.snd u₁ s)
    (hP1 : wcpaLccP1 φs) (hP2 : wcpaLccP2 u₁ L m s φs) (hsep : wcpaLccSep u₁ ε L m s) :
    wcpaLccContr u₁ uu ε s φs :=
by
  classical

  have s6 : ∀ {X : Scheme.{u}} (L' : wcpaDjCoc X) (O : X.Opens) (n : ℕ)
      (f : ∀ a : Fin L'.m, Γ(X, L'.V a ⊓ O)), wcpaDjCompat L' O n f →
      (∀ j : ℕ, wcpaDjCompat L' O (n * j) (fun a => f a ^ j)) ∧
      ∀ (a b : Fin L'.m) (x : X), x ∈ L'.V a → x ∈ L'.V b →
        (x ∈ X.basicOpen (f a) ↔ x ∈ X.basicOpen (f b)) := by
    intro X L' O n f hf
    unfold wcpaDjCompat at hf
    refine ⟨?_, ?_⟩
    · intro j
      unfold wcpaDjCompat
      intro a b
      have h := hf a b
      simp only [map_pow] at h ⊢
      rw [h, mul_pow, ← pow_mul]
    · intro a b x hxa hxb
      by_cases hxO : x ∈ O
      · have hu0 : X.basicOpen ((L'.g a b : Γ(X, L'.V a ⊓ L'.V b)) ^ n) = L'.V a ⊓ L'.V b :=
          X.basicOpen_of_isUnit ((L'.g a b).isUnit.pow n)
        have h := congrArg (fun z => x ∈ X.basicOpen z) (hf a b)
        simp only [Scheme.basicOpen_mul, Scheme.basicOpen_res, hu0,
          TopologicalSpace.Opens.mem_inf, hxa, hxb, hxO, true_and, and_true] at h
        exact Iff.of_eq h.symm
      · constructor
        · intro h
          exact absurd (TopologicalSpace.Opens.mem_inf.mp (X.basicOpen_le _ h)).2 hxO
        · intro h
          exact absurd (TopologicalSpace.Opens.mem_inf.mp (X.basicOpen_le _ h)).2 hxO
  obtain ⟨hss, hsecs, hOK, hcompat, hbo, hHAF, hm, -, -⟩ := hSH
  obtain ⟨M, d, g, D, hd, hgc, haff, hcov, hpre⟩ := hP2
  unfold wcpaLccP1 at hP1
  have hts : wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst u₁ s) L)
      ((Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤) 1 (wcpaLccPullFam u₁ L s t) := by
    have hA : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) {U : Y.Opens} {V V' : X.Opens} (e : V ≤ f ⁻¹ᵁ U)
        (h : V' ≤ V) (x : Γ(Y, U)),
        (X.presheaf.map (homOfLE h).op).hom ((f.appLE U V e).hom x) =
          (f.appLE U V' (h.trans e)).hom x := by
      intro X Y f U V V' e h x
      rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map]
    have hB : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) {U U' : Y.Opens} {V : X.Opens} (e : V ≤ f ⁻¹ᵁ U)
        (h : U ≤ U') (x : Γ(Y, U')),
        (f.appLE U V e).hom ((Y.presheaf.map (homOfLE h).op).hom x) =
          (f.appLE U' V (e.trans (Scheme.Hom.preimage_mono f h))).hom x := by
      intro X Y f U U' V e h x
      rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
    have hC : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (x : Γ(Y, U)),
        (f.app U).hom x = (f.appLE U (f ⁻¹ᵁ U) le_rfl).hom x := by
      intro X Y f U x
      rw [Scheme.Hom.app_eq_appLE]
    intro a b
    have hQ : (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓
        (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V b ⊓ (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤ ≤
        Limits.pullback.fst u₁ s ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ u₁ ⁻¹ᵁ ⊤) := by
      intro z hz
      simp only [TopologicalSpace.Opens.mem_inf, Scheme.Hom.mem_preimage] at hz ⊢
      exact ⟨⟨hz.1.1, hz.1.2⟩, trivial⟩
    have h := congrArg ((Limits.pullback.fst u₁ s).appLE (L.V a ⊓ L.V b ⊓ u₁ ⁻¹ᵁ ⊤) _ hQ).hom
      (hcompat a b)
    simp only [map_mul, map_pow, hB] at h
    unfold wcpaLccPullFam wcpaDjCocPull
    dsimp only
    simp only [Units.coe_map, MonoidHom.coe_coe, map_pow,
      Scheme.Hom.app_eq_appLE, RingHom.coe_comp, Function.comp_apply, pow_one] at h ⊢
    have hA2 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) {U : Y.Opens} {V V' V'' : X.Opens}
        (e : V ≤ f ⁻¹ᵁ U) (h : V' ≤ V) (h' : V'' ≤ V') (x : Γ(Y, U)),
        (X.presheaf.map (homOfLE h').op).hom ((X.presheaf.map (homOfLE h).op).hom
          ((f.appLE U V e).hom x)) = (f.appLE U V'' (h'.trans (h.trans e))).hom x := by
      intro X Y f U V V' V'' e h h' x
      rw [hA, hA]
    refine (hA _ _ _ _).trans (h.trans ?_)
    congr 1
    · first
        | exact (hA2 _ _ _ _ _).symm
        | (simp only [RingHom.comp_apply]; exact (hA2 _ _ _ _ _).symm)
        | (erw [RingHom.comp_apply]; exact (hA2 _ _ _ _ _).symm)
        | (show _ = (Limits.pullback u₁ s).presheaf.map _ ≫ _ ; exact (hA2 _ _ _ _ _).symm)
    · exact (hA _ _ _ _).symm
  have hO : ∀ x : ↥(Limits.pullback u₁ s), x ∈ (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤ := by
    intro x
    simp
  have hbts : ∀ (a : Fin L.m) (x : ↥(Limits.pullback u₁ s)),
      x ∈ (Limits.pullback u₁ s).basicOpen (wcpaLccPullFam u₁ L s t a) ↔
        (x ∈ (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ∧
          Limits.pullback.fst u₁ s x ∉ ⋃ i, Set.range ⇑(ε i)) := by
    intro a x
    have key : (Limits.pullback u₁ s).basicOpen (wcpaLccPullFam u₁ L s t a) =
        ((wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓ (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤) ⊓
          Limits.pullback.fst u₁ s ⁻¹ᵁ Z₁.basicOpen (t a) :=
      Scheme.basicOpen_appLE _ _ _ _ _
    have hb : Limits.pullback.fst u₁ s x ∈ Z₁.basicOpen (t a) ↔
        Limits.pullback.fst u₁ s x ∈ L.V a ∧
          Limits.pullback.fst u₁ s x ∉ ⋃ i, Set.range ⇑(ε i) := by
      have h0 := (Set.ext_iff.mp (hbo a)) (Limits.pullback.fst u₁ s x)
      rw [SetLike.mem_coe, Set.mem_diff, SetLike.mem_coe, TopologicalSpace.Opens.mem_inf] at h0
      rw [h0]
      constructor
      · intro h
        exact ⟨h.1.1, h.2⟩
      · intro h
        exact ⟨⟨h.1, trivial⟩, h.2⟩
    rw [key]
    constructor
    · intro h
      have h' := TopologicalSpace.Opens.mem_inf.mp h
      exact ⟨(TopologicalSpace.Opens.mem_inf.mp h'.1).1, (hb.mp h'.2).2⟩
    · intro h
      exact TopologicalSpace.Opens.mem_inf.mpr ⟨TopologicalSpace.Opens.mem_inf.mpr ⟨h.1, hO x⟩,
        hb.mpr ⟨h.1, h.2⟩⟩
  have hVcov : ∀ x : ↥(Limits.pullback u₁ s), ∃ a : Fin L.m,
      x ∈ (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓
        (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤ := by
    intro x
    have hx : Limits.pullback.fst u₁ s x ∈ (⨆ a, L.V a) := by
      rw [hOK.2.1]; trivial
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    exact ⟨a, TopologicalSpace.Opens.mem_inf.mpr ⟨ha, hO x⟩⟩
  have hchart : ∀ x : ↥(Limits.pullback u₁ s), ∃ J, φs x ∈ D J := by
