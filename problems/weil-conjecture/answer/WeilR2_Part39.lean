  classical
  haveI := hfp
  letI alg1 : Algebra Γ(T, U) Γ(Z, V) := (u.appLE U V e).hom.toAlgebra
  letI alg2 : Algebra Γ(T, U) L := ψ.toAlgebra



  have hchart : ∃ ι : Spec (.of (TensorProduct Γ(T, U) L Γ(Z, V))) ⟶
        Limits.pullback u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec),
      IsOpenImmersion ι ∧
      ι ≫ Limits.pullback.snd u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) =
        Spec.map (CommRingCat.ofHom (algebraMap L (TensorProduct Γ(T, U) L Γ(Z, V)))) ∧
      ι ≫ Limits.pullback.fst u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) =
        Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.includeRight :
          Γ(Z, V) →ₐ[Γ(T, U)] TensorProduct Γ(T, U) L Γ(Z, V)).toRingHom) ≫ hV.fromSpec ∧
