      have hrel_r : ∀ J L (O : (↑(U i ⊓ U j) : Scheme.{u}).Opens)
          (hO : O ≤ (X.homOfLE (inf_le_right : U i ⊓ U j ≤ U j) ≫ φl j) ⁻¹ᵁ wcpaLspD R M J),
          (X.homOfLE (inf_le_right : U i ⊓ U j ≤ U j) ≫ φl j).appLE (wcpaLspD R M J) O hO
              (wcpaLspE R M J L) *
            (↑(U i ⊓ U j) : Scheme.{u}).presheaf.map (homOfLE (le_top : O ≤ ⊤)).op
              ((X.homOfLE (inf_le_left : U i ⊓ U j ≤ U i)).appTop ((U i).topIso.inv (s i J))) =
          (↑(U i ⊓ U j) : Scheme.{u}).presheaf.map (homOfLE (le_top : O ≤ ⊤)).op
