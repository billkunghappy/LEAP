    have sq₂ : IsPullback j₂ (Limits.pullback.fst u₂ g)
        (Limits.pullback.fst (Limits.coprod.desc u₁ u₂) g) Limits.coprod.inr := by
      have outer : IsPullback (j₂ ≫ Limits.pullback.snd _ _) (Limits.pullback.fst u₂ g) g
