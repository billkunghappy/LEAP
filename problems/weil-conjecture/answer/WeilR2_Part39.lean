    rw [e, Scheme.Hom.appLE, CommRingCat.hom_comp, RingHom.comp_apply]
    exact (Z.presheaf.germ_res_apply (homOfLE h) z0 trivial ((σ.app V).hom s)).symm
  have hthree : ∀ {Y : Scheme.{u}} (j : Y ⟶ X) (σ : Spec (.of K) ⟶ Y), σ ≫ j ≫ p = 𝟙 _ →
      ∀ (h : ⊤ ≤ σ ⁻¹ᵁ (j ⁻¹ᵁ ⊤)) (γ : Γ(Spec (.of K), ⊤)),
      (σ.appLE (j ⁻¹ᵁ ⊤) ⊤ h).hom ((j.app ⊤).hom ((p.appTop).hom γ)) = γ := by
    intro Y j σ hσ h γ
    rw [happ p, Scheme.Hom.app_eq_appLE j, hcomp j p ⊤ ⊤ (j ⁻¹ᵁ ⊤) le_top le_rfl le_top]
    exact heval Y σ (j ≫ p) hσ (j ⁻¹ᵁ ⊤) h γ

  have side : ∀ {Y : Scheme.{u}} (j : Y ⟶ X) [IsClosedImmersion j] (y : Y) (V₀ : X.Opens)
      (hy : j y ∈ V₀) (s₀ : Γ(X, V₀)) (W : X.Opens) (hyW : j y ∈ W) (c : Γ(Y, j ⁻¹ᵁ W)),
      (Y.presheaf.germ (j ⁻¹ᵁ V₀) y hy).hom ((j.app V₀).hom s₀) =
        (Y.presheaf.germ (j ⁻¹ᵁ W) y hyW).hom c →
      ∃ T : X.Opens, j y ∈ T ∧ ∀ (U₁ : X.Opens) (h₁ : U₁ ≤ V₀) (h₂ : U₁ ≤ W), U₁ ≤ T →
        (j.app U₁).hom ((X.presheaf.map (homOfLE h₁).op).hom s₀) =
          (Y.presheaf.map (homOfLE (show j ⁻¹ᵁ U₁ ≤ j ⁻¹ᵁ W from fun _ hz => h₂ hz)).op).hom c := by
    intro Y j _ y V₀ hy s₀ W hyW c hg
    obtain ⟨W', hyW', iU, iV, hres⟩ := TopCat.Presheaf.germ_eq Y.presheaf y hy hyW _ _ hg
    obtain ⟨t, ht, hteq⟩ := (j.isClosedEmbedding.isInducing.isOpen_iff).mp W'.isOpen
    refine ⟨⟨t, ht⟩, ?_, ?_⟩
    · have : y ∈ (⇑j ⁻¹' t) := by rw [hteq]; exact hyW'
      exact this
    · intro U₁ h₁ h₂ hT
      have hle : j ⁻¹ᵁ U₁ ≤ W' := by
        intro z hz
        have hz' : z ∈ (⇑j ⁻¹' t) := hT hz
        rw [hteq] at hz'
        exact hz'
      rw [nat j (homOfLE h₁) (homOfLE (fun _ hz => h₁ hz)),
        ← pm Y iU (homOfLE hle) (homOfLE (fun _ hz => h₁ hz)), hres,
        pm Y iV (homOfLE hle) (homOfLE (fun _ hz => h₂ hz))]

  have hspread : ∀ (x : X) (x' : X') (e : Er) (h₁ : x = i x') (h₂ : x = ι e) (W : X.Opens)
      (hxW : x ∈ W) (hxW₁ : i x' ∈ W) (hxW₂ : ι e ∈ W)
      (a₀ : Γ(X', i ⁻¹ᵁ W)) (b₀ : Γ(Er, ι ⁻¹ᵁ W)) (α : X.presheaf.stalk x),
      ((X.presheaf.stalkCongr (Inseparable.of_eq h₁)).hom ≫ i.stalkMap x').hom α =
        (X'.presheaf.germ (i ⁻¹ᵁ W) x' hxW₁).hom a₀ →
      ((X.presheaf.stalkCongr (Inseparable.of_eq h₂)).hom ≫ ι.stalkMap e).hom α =
        (Er.presheaf.germ (ι ⁻¹ᵁ W) e hxW₂).hom b₀ →
      ∃ (U₁ : X.Opens) (hU₁ : U₁ ≤ W) (hx₁ : x ∈ U₁) (s : Γ(X, U₁)),
        (X.presheaf.germ U₁ x hx₁).hom s = α ∧
        (i.app U₁).hom s = (X'.presheaf.map (homOfLE (show i ⁻¹ᵁ U₁ ≤ i ⁻¹ᵁ W from
          fun _ hz => hU₁ hz)).op).hom a₀ ∧
        (ι.app U₁).hom s = (Er.presheaf.map (homOfLE (show ι ⁻¹ᵁ U₁ ≤ ι ⁻¹ᵁ W from
          fun _ hz => hU₁ hz)).op).hom b₀ := by
    intro x x' e h₁ h₂ W hxW hxW₁ hxW₂ a₀ b₀ α hα₁ hα₂
    obtain ⟨V₀, hxV₀, s₀, hs₀⟩ := TopCat.Presheaf.exists_germ_eq X.presheaf α
    have hxV : x ∈ V₀ ⊓ W := ⟨hxV₀, hxW⟩
    obtain ⟨s₁, hs₁⟩ : ∃ s₁ : Γ(X, V₀ ⊓ W), (X.presheaf.germ (V₀ ⊓ W) x hxV).hom s₁ = α :=
      ⟨(X.presheaf.map (homOfLE (inf_le_left : V₀ ⊓ W ≤ V₀)).op).hom s₀, by
        rw [TopCat.Presheaf.germ_res_apply]; exact hs₀⟩
    have hx1 : i x' ∈ V₀ ⊓ W := by rw [← h₁]; exact hxV
    have hx2 : ι e ∈ V₀ ⊓ W := by rw [← h₂]; exact hxV
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hα₁ hα₂
    rw [← hs₁, hG i x' x h₁ _ hxV hx1] at hα₁
    rw [← hs₁, hG ι e x h₂ _ hxV hx2] at hα₂
    obtain ⟨T₁, hT₁, hT₁eq⟩ := side i x' (V₀ ⊓ W) hx1 s₁ W hxW₁ a₀ hα₁
    obtain ⟨T₂, hT₂, hT₂eq⟩ := side ι e (V₀ ⊓ W) hx2 s₁ W hxW₂ b₀ hα₂
    have hxT₁ : x ∈ T₁ := by rw [h₁]; exact hT₁
    have hxT₂ : x ∈ T₂ := by rw [h₂]; exact hT₂
    refine ⟨V₀ ⊓ W ⊓ T₁ ⊓ T₂, fun z hz => hz.1.1.2, ⟨⟨hxV, hxT₁⟩, hxT₂⟩,
      (X.presheaf.map (homOfLE (show V₀ ⊓ W ⊓ T₁ ⊓ T₂ ≤ V₀ ⊓ W from
        fun z hz => hz.1.1)).op).hom s₁, ?_, ?_, ?_⟩
    · exact (X.presheaf.germ_res_apply _ x _ s₁).trans hs₁
    · exact hT₁eq _ (show V₀ ⊓ W ⊓ T₁ ⊓ T₂ ≤ V₀ ⊓ W from fun z hz => hz.1.1)
        (show V₀ ⊓ W ⊓ T₁ ⊓ T₂ ≤ W from fun z hz => hz.1.1.2)
        (show V₀ ⊓ W ⊓ T₁ ⊓ T₂ ≤ T₁ from fun z hz => hz.1.2)
    · exact hT₂eq _ (show V₀ ⊓ W ⊓ T₁ ⊓ T₂ ≤ V₀ ⊓ W from fun z hz => hz.1.1)
        (show V₀ ⊓ W ⊓ T₁ ⊓ T₂ ≤ W from fun z hz => hz.1.1.2)
        (show V₀ ⊓ W ⊓ T₁ ⊓ T₂ ≤ T₂ from fun z hz => hz.2)

  have hsurj : ∀ {Y : Scheme.{u}} (j : Y ⟶ X) [IsClosedImmersion j] (y : Y) (x : X)
      (hx : x = j y),
      Function.Surjective ((X.presheaf.stalkCongr (Inseparable.of_eq hx)).hom ≫ j.stalkMap y).hom := by
    intro Y j _ y x hx
    rw [CommRingCat.hom_comp, RingHom.coe_comp]
    exact (j.stalkMap_surjective y).comp (ConcreteCategory.bijective_of_isIso _).surjective

  have hkill : ∀ {Y : Scheme.{u}} (j : Y ⟶ X) (σ : Spec (.of K) ⟶ Y) (z0 : Spec (.of K)) (x : X)
      (hx : x = j (σ z0)) (ε : (Spec (.of K)).presheaf.stalk z0 ⟶ CommRingCat.of K) [IsIso ε],
      ∀ m ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x),
      (σ.stalkMap z0 ≫ ε).hom
        (((X.presheaf.stalkCongr (Inseparable.of_eq hx)).hom ≫ j.stalkMap (σ z0)).hom m) = 0 := by
    intro Y j σ z0 x hx ε _ m hm
    by_contra hne
    have hu := Ne.isUnit hne
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply] at hu
    haveI := isLocalHom_of_isIso ε
    haveI := isLocalHom_of_isIso (X.presheaf.stalkCongr (Inseparable.of_eq hx)).hom
    haveI : IsLocalHom (σ.stalkMap z0).hom := inferInstance
    haveI : IsLocalHom (j.stalkMap (σ z0)).hom := inferInstance
    have h1 := isUnit_of_map_unit ε.hom _ hu
    have h2 := isUnit_of_map_unit (σ.stalkMap z0).hom _ h1
    have h3 := isUnit_of_map_unit (j.stalkMap (σ z0)).hom _ h2
    have h4 := isUnit_of_map_unit (X.presheaf.stalkCongr (Inseparable.of_eq hx)).hom.hom _ h3
    exact ((IsLocalRing.mem_maximalIdeal m).mp hm) h4

  have hphi : ∀ {Y : Scheme.{u}} (j : Y ⟶ X) (σ : Spec (.of K) ⟶ Y) (z0 : Spec (.of K)) (x : X)
      (hx : x = j (σ z0)), σ ≫ j ≫ p = 𝟙 _ → ∀ {R : CommRingCat.{u}}
      (ε : (Spec (.of K)).presheaf.stalk z0 ⟶ R) (z : K),
      (σ.stalkMap z0 ≫ ε).hom
        (((X.presheaf.stalkCongr (Inseparable.of_eq hx)).hom ≫ j.stalkMap (σ z0)).hom
          (((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial).hom z)) =
      ε.hom (((Spec (.of K)).presheaf.germ ⊤ z0 trivial).hom
          ((Scheme.ΓSpecIso (.of K)).inv.hom z)) := by
    intro Y j σ z0 x hx hσ R ε z
    have h3 := hthree j σ hσ (fun _ _ => trivial) ((Scheme.ΓSpecIso (.of K)).inv.hom z)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    rw [hG j (σ z0) x hx ⊤ trivial trivial, hge σ z0 (j ⁻¹ᵁ ⊤) trivial (fun _ _ => trivial)]
    exact congrArg (fun t => ε.hom (((Spec (.of K)).presheaf.germ ⊤ z0 trivial).hom t)) h3

  have hresid : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (φ : K →+* A),
      (∃ e : AdicCompletion (IsLocalRing.maximalIdeal A) A ≃+* (MvPowerSeries (Fin 2) K ⧸
        Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap A
          (AdicCompletion (IsLocalRing.maximalIdeal A) A)).comp φ) =
            (Ideal.Quotient.mk _).comp MvPowerSeries.C) →
      ∀ a : A, ∃ z : K, a - φ z ∈ IsLocalRing.maximalIdeal A := by
    intro A _ _ φ ⟨e, he⟩ a
    have hκ : ∀ F ∈ Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)},
        MvPowerSeries.constantCoeff F = 0 := by
      intro F hF
      obtain ⟨G, rfl⟩ := Ideal.mem_span_singleton'.mp hF
      simp [MvPowerSeries.constantCoeff_X]
    let κ : (MvPowerSeries (Fin 2) K ⧸
        Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) →+* K :=
      Ideal.Quotient.lift _ MvPowerSeries.constantCoeff hκ
    let ψ : A →+* K :=
      κ.comp (e.toRingHom.comp (algebraMap A (AdicCompletion (IsLocalRing.maximalIdeal A) A)))
    have hψφ : ∀ z, ψ (φ z) = z := by
      intro z
      have h1 := RingHom.congr_fun he z
      have h2 : ψ (φ z) = κ (Ideal.Quotient.mk _ (MvPowerSeries.C z)) := by
        show κ (e.toRingHom (algebraMap A _ (φ z))) = _
        exact congrArg κ h1
      rw [h2]
      simp [κ, Ideal.Quotient.lift_mk]
    refine ⟨ψ a, IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top ψ) ?_⟩
    rw [RingHom.mem_ker, map_sub, hψφ, sub_self]

  have crt : ∀ (A B₁ B₂ S : Type u) [CommRing A] [IsLocalRing A] [CommRing B₁] [CommRing B₂]
      [CommRing S] [Nontrivial S] (φ : K →+* A) (π₁ : A →+* B₁) (π₂ : A →+* B₂)
      (ε₁ : B₁ →+* S) (ε₂ : B₂ →+* S),
      Function.Surjective π₁ → Function.Surjective π₂ →
      RingHom.ker π₁ ⊔ RingHom.ker π₂ = IsLocalRing.maximalIdeal A →
      (∀ a : A, ∃ z : K, a - φ z ∈ IsLocalRing.maximalIdeal A) →
      (∀ z : K, ε₁ (π₁ (φ z)) = ε₂ (π₂ (φ z))) →
      (∀ a ∈ IsLocalRing.maximalIdeal A, ε₁ (π₁ a) = 0) →
      (∀ a ∈ IsLocalRing.maximalIdeal A, ε₂ (π₂ a) = 0) →
      ∀ (b₁ : B₁) (b₂ : B₂), ε₁ b₁ = ε₂ b₂ → ∃ a : A, π₁ a = b₁ ∧ π₂ a = b₂ := by
    intro A B₁ B₂ S _ _ _ _ _ _ φ π₁ π₂ ε₁ ε₂ hs1 hs2 hsup hres hφ hk1 hk2 b₁ b₂ hb
    have hρ : ∀ a, ε₁ (π₁ a) = ε₂ (π₂ a) := by
      intro a
      obtain ⟨z, hz⟩ := hres a
      have e1 := hk1 _ hz
      have e2 := hk2 _ hz
      rw [map_sub, map_sub] at e1 e2
      rw [sub_eq_zero.mp e1, sub_eq_zero.mp e2]
      exact hφ z
    obtain ⟨α₁, rfl⟩ := hs1 b₁
    obtain ⟨α₂, rfl⟩ := hs2 b₂
    have hδ : α₁ - α₂ ∈ IsLocalRing.maximalIdeal A := by
      apply IsLocalRing.le_maximalIdeal (RingHom.ker_ne_top (ε₁.comp π₁))
      rw [RingHom.mem_ker, RingHom.comp_apply, map_sub, map_sub, hb, hρ α₂, sub_self]
    rw [← hsup] at hδ
    obtain ⟨k₁, hk₁, k₂, hk₂, hkk⟩ := Submodule.mem_sup.mp hδ
    refine ⟨α₁ - k₁, ?_, ?_⟩
    · rw [map_sub, RingHom.mem_ker.mp hk₁, sub_zero]
    · have h' : α₁ - k₁ = α₂ + k₂ := by linear_combination -hkk
      rw [h', map_add, RingHom.mem_ker.mp hk₂, add_zero]

  have heU : ι (σE (IsLocalRing.closedPoint K)) ∈ U := hxe ▸ hxU
  obtain ⟨t₁, ht₁a, ht₁b⟩ := ht₁
  obtain ⟨t₂, ht₂a, ht₂b⟩ := ht₂
  have hjoint : ∀ α : X.presheaf.stalk (i (σ' (IsLocalRing.closedPoint K))),
      ((X.presheaf.stalkCongr (Inseparable.of_eq
        (rfl : i (σ' (IsLocalRing.closedPoint K)) = i (σ' (IsLocalRing.closedPoint K))))).hom ≫
          i.stalkMap (σ' (IsLocalRing.closedPoint K))).hom α = 0 →
      ((X.presheaf.stalkCongr (Inseparable.of_eq hxe)).hom ≫
          ι.stalkMap (σE (IsLocalRing.closedPoint K))).hom α = 0 → α = 0 := by
    intro α h1 h2
    obtain ⟨U₁, _hU₁, hx₁, s, hsα, hs1, hs2⟩ := hspread (i (σ' (IsLocalRing.closedPoint K)))
      (σ' (IsLocalRing.closedPoint K)) (σE (IsLocalRing.closedPoint K)) rfl hxe ⊤ trivial
      trivial trivial 0 0 α (by rw [h1, map_zero]) (by rw [h2, map_zero])
    rw [map_zero] at hs1 hs2
    rw [← hsα, hSep U₁ s hs1 hs2, map_zero]
  have hsup := hc2 K _ _ _ _
    ((X.presheaf.stalkCongr (Inseparable.of_eq
        (rfl : i (σ' (IsLocalRing.closedPoint K)) = i (σ' (IsLocalRing.closedPoint K))))).hom ≫
          i.stalkMap (σ' (IsLocalRing.closedPoint K))).hom
    ((X.presheaf.stalkCongr (Inseparable.of_eq hxe)).hom ≫
          ι.stalkMap (σE (IsLocalRing.closedPoint K))).hom t₁ t₂ hnode
    (hsurj i _ _ rfl) (hsurj ι _ _ hxe) ht₁a ht₁b ht₂a ht₂b hjoint
  have hφ12 : ∀ z : K,
      (σ'.stalkMap (IsLocalRing.closedPoint K) ≫ (stalkClosedPointIso (.of K)).hom).hom
        (((X.presheaf.stalkCongr (Inseparable.of_eq
          (rfl : i (σ' (IsLocalRing.closedPoint K)) = i (σ' (IsLocalRing.closedPoint K))))).hom ≫
            i.stalkMap (σ' (IsLocalRing.closedPoint K))).hom
          (((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫
            X.presheaf.germ ⊤ (i (σ' (IsLocalRing.closedPoint K))) trivial).hom z)) =
      (σE.stalkMap (IsLocalRing.closedPoint K) ≫ (stalkClosedPointIso (.of K)).hom).hom
        (((X.presheaf.stalkCongr (Inseparable.of_eq hxe)).hom ≫
            ι.stalkMap (σE (IsLocalRing.closedPoint K))).hom
          (((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫
            X.presheaf.germ ⊤ (i (σ' (IsLocalRing.closedPoint K))) trivial).hom z)) := fun z =>
    (hphi i σ' (IsLocalRing.closedPoint K) _ rfl hσ' (stalkClosedPointIso (.of K)).hom z).trans
      (hphi ι σE (IsLocalRing.closedPoint K) _ hxe hσE (stalkClosedPointIso (.of K)).hom z).symm
  have hh : ⊤ ≤ σ' ⁻¹ᵁ (i ⁻¹ᵁ U) := by
    intro z _
    show i (σ' z) ∈ U
    rw [Subsingleton.elim z (IsLocalRing.closedPoint K)]
    exact hxU
  have hh' : ⊤ ≤ σE ⁻¹ᵁ (ι ⁻¹ᵁ U) := by
    intro z _
    show ι (σE z) ∈ U
    rw [Subsingleton.elim z (IsLocalRing.closedPoint K)]
    exact heU
  have hb : (σ'.stalkMap (IsLocalRing.closedPoint K) ≫ (stalkClosedPointIso (.of K)).hom).hom
        ((X'.presheaf.germ (i ⁻¹ᵁ U) (σ' (IsLocalRing.closedPoint K)) hxU).hom a) =
      (σE.stalkMap (IsLocalRing.closedPoint K) ≫ (stalkClosedPointIso (.of K)).hom).hom
        ((Er.presheaf.germ (ι ⁻¹ᵁ U) (σE (IsLocalRing.closedPoint K)) heU).hom b) := by
    rw [CommRingCat.hom_comp, CommRingCat.hom_comp, RingHom.comp_apply, RingHom.comp_apply]
    exact congrArg (stalkClosedPointIso (.of K)).hom.hom
      ((hge σ' _ _ hxU hh a).trans ((congrArg _ (hval hh hh')).trans (hge σE _ _ heU hh' b).symm))
  obtain ⟨α, hα1, hα2⟩ := crt _ _ _ _ _ _ _ _ _ (hsurj i _ _ rfl) (hsurj ι _ _ hxe) hsup
    (hresid _ _ hnode) hφ12
    (hkill i σ' (IsLocalRing.closedPoint K) _ rfl (stalkClosedPointIso (.of K)).hom)
    (hkill ι σE (IsLocalRing.closedPoint K) _ hxe (stalkClosedPointIso (.of K)).hom) _ _ hb
  obtain ⟨U₁, hU₁, hx₁, s, -, hs1, hs2⟩ := hspread (i (σ' (IsLocalRing.closedPoint K)))
    (σ' (IsLocalRing.closedPoint K)) (σE (IsLocalRing.closedPoint K)) rfl hxe U hxU hxU heU
    a b α hα1 hα2
  exact ⟨U₁, hU₁, hx₁, s, hs1, hs2⟩

theorem wcpa_dj_lcc_gs_attach_not_smooth : ∀ (K : Type u) [Field K] (X : Scheme.{u}) (p : X ⟶ Spec (.of K)) (E : Set X) (x : X) (W : X.Opens), IsProper p → E ∈ irreducibleComponents X → x ∈ E ∩ closure Eᶜ → x ∈ W → SmoothOfRelativeDimension 1 (W.ι ≫ p) → False :=
by
  intro K _ X p E x W hp hE hx hxW hWsm
  classical
  haveI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian p
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace p
  haveI : AlgebraicGeometry.IsNoetherian X := AlgebraicGeometry.IsNoetherian.mk
  haveI : TopologicalSpace.NoetherianSpace X := inferInstance
  haveI : SmoothOfRelativeDimension 1 (W.ι ≫ p) := hWsm
  haveI hdomW : IsDomain ((W : Scheme).presheaf.stalk ⟨x, hxW⟩) :=
    wcpa_smooth_stalk_isDomain K W.toScheme (W.ι ≫ p) 1 ⟨x, hxW⟩
  haveI hdom : IsDomain (X.presheaf.stalk x) :=
    MulEquiv.isDomain _ (W.stalkIso ⟨x, hxW⟩).symm.commRingCatIsoToRingEquiv.toMulEquiv
  have hG : IsIrreducible {y : X | y ⤳ x} := by
    rw [← Scheme.range_fromSpecStalk, ← Set.image_univ]
    exact (IrreducibleSpace.isIrreducible_univ _).image _
      (X.fromSpecStalk x).continuous.continuousOn
  obtain ⟨hxE, hxcl⟩ := hx
  have hfin : (irreducibleComponents X).Finite :=
    TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
  have hUcl : IsClosed (⋃₀ (irreducibleComponents X \ {E})) :=
    (hfin.diff).isClosed_sUnion (fun t ht => isClosed_of_mem_irreducibleComponents t ht.1)
  have hsub : Eᶜ ⊆ ⋃₀ (irreducibleComponents X \ {E}) := by
    intro y hy
    have hy' : y ∈ ⋃₀ irreducibleComponents X := by
      rw [sUnion_irreducibleComponents]; trivial
    obtain ⟨t, ht, hyt⟩ := hy'
    refine ⟨t, ⟨ht, fun h => hy ?_⟩, hyt⟩
    rw [Set.mem_singleton_iff] at h
    rw [← h]; exact hyt
  have hxU := closure_minimal hsub hUcl hxcl
  obtain ⟨F, ⟨hF, hFE⟩, hxF⟩ := hxU
  have key : ∀ C ∈ irreducibleComponents X, x ∈ C → C = closure {y : X | y ⤳ x} := by
    intro C hC hxC
    have hCmax : Maximal IsIrreducible C := hC
    have hCirr : IsIrreducible C := hCmax.prop
    have hCcl : IsClosed C := isClosed_of_mem_irreducibleComponents C hC
    have hgen := hCirr.isGenericPoint_genericPoint_closure
    rw [hCcl.closure_eq] at hgen
    have hsp : hCirr.genericPoint ⤳ x := hgen.specializes hxC
    have hsubC : C ⊆ closure {y : X | y ⤳ x} :=
      calc C = closure {hCirr.genericPoint} := (isGenericPoint_def.mp hgen).symm
        _ ⊆ closure {y : X | y ⤳ x} := closure_mono (Set.singleton_subset_iff.mpr hsp)
    exact hCmax.eq_of_subset hG.closure hsubC
  exact hFE (Set.mem_singleton_iff.mpr ((key F hF hxF).trans (key E hE hxE).symm))

theorem wcpa_dj_lcc_fs_glue_sections : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X X' : Scheme.{u}) (p : X ⟶ Spec (.of K)) (i : X' ⟶ X) (E : Set X) (k : ℕ) (n : Fin k → (Spec (.of K) ⟶ X')) (O : X.Opens), IsProper p → (∀ x : X, (∃ W : X.Opens, x ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ p)) ∨ (∃ e : AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap (X.presheaf.stalk x) (AdicCompletion (IsLocalRing.maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ p.appTop ≫ X.presheaf.germ ⊤ x trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C)) → E ∈ irreducibleComponents X → (∃ (Er : Scheme.{u}) (ι : Er ⟶ X) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧ θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ p) → IsClosedImmersion i → IsReduced X' → Set.range i = closure Eᶜ → 1 ≤ k → (∀ j, n j ≫ i ≫ p = 𝟙 _) → (∀ j j', j ≠ j' → n j (IsLocalRing.closedPoint K) ≠ n j' (IsLocalRing.closedPoint K)) → (∀ x : X, x ∈ E ∩ closure Eᶜ ↔ ∃ j, x = i (n j (IsLocalRing.closedPoint K))) → (∀ j, ∃ W : X'.Opens, n j (IsLocalRing.closedPoint K) ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ i ≫ p)) → E ⊆ (O : Set X) → Function.Injective (i.appLE O (i ⁻¹ᵁ O) le_rfl).hom ∧ ∀ g : Γ(X', i ⁻¹ᵁ O), (∃ f : Γ(X, O), (i.appLE O (i ⁻¹ᵁ O) le_rfl).hom f = g) ↔ ∀ (j j' : Fin k) (h : ⊤ ≤ n j ⁻¹ᵁ (i ⁻¹ᵁ O)) (h' : ⊤ ≤ n j' ⁻¹ᵁ (i ⁻¹ᵁ O)), ((n j).appLE (i ⁻¹ᵁ O) ⊤ h).hom g = ((n j').appLE (i ⁻¹ᵁ O) ⊤ h').hom g :=
by
  intro K _ _ X X' p i E k n O hp hNS hE hdat hi hX'red hirange hk1 hn hndist hnchar hnsm hEO
  obtain ⟨Er, ι, θ, hι, hErred, hιrange, hθ⟩ := hdat
  classical

  have hcomp : ∀ {Y Z W : Scheme.{u}} (f : Y ⟶ Z) (g : Z ⟶ W) (U : W.Opens) (V : Z.Opens)
      (T : Y.Opens) (e₁ : V ≤ g ⁻¹ᵁ U) (e₂ : T ≤ f ⁻¹ᵁ V) (h : T ≤ (f ≫ g) ⁻¹ᵁ U)
      (x : Γ(W, U)), (f.appLE V T e₂).hom ((g.appLE U V e₁).hom x) =
        ((f ≫ g).appLE U T h).hom x := by
    intro Y Z W f g U V T e₁ e₂ h x
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Scheme.Hom.appLE_comp_appLE]
  have hcongr : ∀ {Y Z : Scheme.{u}} (f g : Y ⟶ Z), f = g → ∀ (U : Z.Opens) (V : Y.Opens)
      (h : V ≤ f ⁻¹ᵁ U) (h' : V ≤ g ⁻¹ᵁ U) (x : Γ(Z, U)),
      (f.appLE U V h).hom x = (g.appLE U V h').hom x := by
    intro Y Z f g hfg U V h h' x
    subst hfg
    rfl
  have hid : ∀ (Y : Scheme.{u}) (h : (⊤ : Y.Opens) ≤ (𝟙 Y : Y ⟶ Y) ⁻¹ᵁ ⊤) (x : Γ(Y, ⊤)),
      (Scheme.Hom.appLE (𝟙 Y) ⊤ ⊤ h).hom x = x := by
    intro Y h x
    rw [Scheme.Hom.appLE, Scheme.Hom.id_app]
    show (Y.presheaf.map (𝟙 (Opposite.op ⊤))).hom x = x
    simp
  have hmap : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z) (U : Z.Opens) (V V' : Y.Opens)
      (e : V ≤ f ⁻¹ᵁ U) (e' : V' ≤ f ⁻¹ᵁ U) (hVV : V' ≤ V) (x : Γ(Z, U)),
      (Y.presheaf.map (homOfLE hVV).op).hom ((f.appLE U V e).hom x) =
        (f.appLE U V' e').hom x := by
    intro Y Z f U V V' e e' hVV x
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, Scheme.Hom.appLE_map]
  have hsub : ∀ (Y : Scheme.{u}) (V : Y.Opens), V = ⊥ → ∀ a b : Γ(Y, V), a = b := by
    intro Y V hV a b
    have := CommRingCat.subsingleton_of_isTerminal (Y.sheaf.isTerminalOfEqEmpty hV)
    exact @Subsingleton.elim _ this a b
  have htopinj : ∀ (Y : Scheme.{u}) (V : Y.Opens), V = ⊤ → ∀ (h : (⊤ : Y.Opens) ≤ V)
      (x : Γ(Y, V)), (Y.presheaf.map (homOfLE h).op).hom x = 0 → x = 0 := by
    intro Y V hV h x hx
    subst hV
    have : (homOfLE h).op = 𝟙 (Opposite.op (⊤ : Y.Opens)) := Subsingleton.elim _ _
    rw [this, CategoryTheory.Functor.map_id] at hx
    exact hx
  have happ : ∀ {Y Z : Scheme.{u}} (q : Y ⟶ Z) (x : Γ(Z, ⊤)),
      (q.appTop).hom x = (q.appLE ⊤ ⊤ le_top).hom x := by
    intro Y Z q x
    rw [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE]
    rfl
  have heval : ∀ (Y : Scheme.{u}) (τ : Spec (.of K) ⟶ Y) (q : Y ⟶ Spec (.of K)),
      τ ≫ q = 𝟙 _ → ∀ (V : Y.Opens) (hV : ⊤ ≤ τ ⁻¹ᵁ V) (γ : Γ(Spec (.of K), ⊤)),
      (τ.appLE V ⊤ hV).hom ((q.appLE ⊤ V le_top).hom γ) = γ := by
    intro Y τ q hτ V hV γ
    rw [hcomp τ q ⊤ V ⊤ le_top hV le_top, hcongr _ _ hτ ⊤ ⊤ le_top le_top]
    exact hid _ _ γ

  have hpt : ∀ z : Spec (.of K), z = IsLocalRing.closedPoint K := fun z => Subsingleton.elim _ _
  have hnN : ∀ j, i (n j (IsLocalRing.closedPoint K)) ∈ E ∩ closure Eᶜ :=
    fun j => (hnchar _).mpr ⟨j, rfl⟩
  have hnpt : ∀ j, ⊤ ≤ n j ⁻¹ᵁ (i ⁻¹ᵁ O) := by
    intro j z _
    show i (n j z) ∈ O
    rw [hpt z]
    exact hEO (hnN j).1
  have hcover : ∀ y : X, y ∈ Set.range i ∨ y ∈ Set.range ι := by
    intro y
    by_cases hy : y ∈ E
    · right; rw [hιrange]; exact hy
    · left; rw [hirange]; exact subset_closure hy
  have hXred : IsReduced X := wcpa_dj_lcc_gs_nodal_reduced K X p hp hNS

  have hSep : ∀ (U : X.Opens) (s : Γ(X, U)), (i.app U).hom s = 0 → (ι.app U).hom s = 0 →
      s = 0 := by
    intro U s hi0 hι0
    have key : ∀ {Y : Scheme.{u}} (f : Y ⟶ X) (y : Y) (hy : f y ∈ U), (f.app U).hom s = 0 →
        ¬ IsUnit ((X.presheaf.germ U (f y) hy).hom s) := by
      intro Y f y hy hf hu
      have h1 := (hu.map (f.stalkMap y).hom)
      rw [Scheme.Hom.germ_stalkMap_apply, hf, map_zero] at h1
      exact not_isUnit_zero h1
    apply eq_zero_of_basicOpen_eq_bot
    rw [eq_bot_iff]
    intro y hy
    have hyU : y ∈ U := X.basicOpen_le s hy
    have hu := (Scheme.mem_basicOpen' X s ⟨y, hyU⟩).mp hy
    exfalso
    rcases hcover y with ⟨x, rfl⟩ | ⟨x, rfl⟩
    · exact key i x hyU hi0 hu
    · exact key ι x hyU hι0 hu

  have hbij : ∀ (U : X.Opens), (U : Set X) ⊆ Set.range i → Function.Bijective (i.app U).hom := by
    intro U hU
    haveI : IsClosedImmersion (i ∣_ U) := IsZariskiLocalAtTarget.restrict hi U
    haveI : Surjective (i ∣_ U) := by
      constructor
      rintro ⟨y, hy⟩
      obtain ⟨x, rfl⟩ := hU hy
      refine ⟨⟨x, hy⟩, ?_⟩
      apply Subtype.ext
      exact morphismRestrict_base_coe i U ⟨x, hy⟩
    haveI : IsReduced (U : Scheme.{u}) := isReduced_of_isOpenImmersion U.ι
    haveI : IsIso (i ∣_ U) := isIso_of_isClosedImmersion_of_surjective _
    have h1 : IsIso ((i ∣_ U).app ⊤) := inferInstance
    have h2 := morphismRestrict_app i U ⊤
    have h3 : IsIso (i.app (U.ι ''ᵁ ⊤)) := by
      rw [h2] at h1
      exact @IsIso.of_isIso_comp_right _ _ _ _ _ _ _ (Functor.map_isIso _ _) h1
    have h4 : U.ι ''ᵁ ⊤ = U := by simp
    revert h3
    rw [h4]
    intro h3
    exact ConcreteCategory.bijective_of_isIso (i.app U)

  have hglue : ∀ (a : Γ(X', i ⁻¹ᵁ O)) (b : Γ(Er, ι ⁻¹ᵁ O)), (∀ y : X, y ∈ O →
      ∃ (U : X.Opens) (hU : U ≤ O), y ∈ U ∧ ∃ s : Γ(X, U),
        (i.app U).hom s = (X'.presheaf.map (homOfLE (show i ⁻¹ᵁ U ≤ i ⁻¹ᵁ O from
          fun x hx => hU hx)).op).hom a ∧
        (ι.app U).hom s = (Er.presheaf.map (homOfLE (show ι ⁻¹ᵁ U ≤ ι ⁻¹ᵁ O from
          fun x hx => hU hx)).op).hom b) →
      ∃ f : Γ(X, O), (i.app O).hom f = a ∧ (ι.app O).hom f = b := by
    intro a b hloc
    have nat : ∀ {Y Z : Scheme.{u}} (f : Y ⟶ Z) {V V' : Z.Opens} (e : V' ⟶ V)
        (e' : f ⁻¹ᵁ V' ⟶ f ⁻¹ᵁ V) (s : Γ(Z, V)),
        (f.app V').hom ((Z.presheaf.map e.op).hom s) =
          (Y.presheaf.map e'.op).hom ((f.app V).hom s) := by
      intro Y Z f V V' e e' s
      have h := congrArg (fun φ => φ.hom s) (f.naturality e.op)
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
      rw [h]
      exact congrArg (fun φ : f ⁻¹ᵁ V' ⟶ f ⁻¹ᵁ V => (Y.presheaf.map φ.op).hom ((f.app V).hom s))
        (Subsingleton.elim _ e')
    have pm : ∀ (Y : Scheme.{u}) {A B C : Y.Opens} (e1 : B ⟶ A) (e2 : C ⟶ B) (e3 : C ⟶ A)
        (x : Γ(Y, A)), (Y.presheaf.map e2.op).hom ((Y.presheaf.map e1.op).hom x) =
          (Y.presheaf.map e3.op).hom x := by
      intro Y A B C e1 e2 e3 x
      have : e1.op ≫ e2.op = e3.op := Quiver.Hom.unop_inj (Subsingleton.elim _ _)
      rw [← this, Functor.map_comp, CommRingCat.hom_comp, RingHom.comp_apply]
    choose U hU hyU s hs1 hs2 using hloc
    let Uf : (↥O) → X.Opens := fun y => U y.1 y.2
    let sf : ∀ y : ↥O, Γ(X, Uf y) := fun y => s y.1 y.2
    have hs1' : ∀ y : ↥O, (i.app (Uf y)).hom (sf y) =
        (X'.presheaf.map (homOfLE (show i ⁻¹ᵁ Uf y ≤ i ⁻¹ᵁ O from
          fun x hx => hU y.1 y.2 hx)).op).hom a := fun y => hs1 y.1 y.2
    have hs2' : ∀ y : ↥O, (ι.app (Uf y)).hom (sf y) =
        (Er.presheaf.map (homOfLE (show ι ⁻¹ᵁ Uf y ≤ ι ⁻¹ᵁ O from
          fun x hx => hU y.1 y.2 hx)).op).hom b := fun y => hs2 y.1 y.2
    have hcov : O ≤ iSup Uf := fun y hy =>
      TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨y, hy⟩, hyU y hy⟩
    have hcompat : TopCat.Presheaf.IsCompatible X.sheaf.obj Uf sf := by
      intro y z
      show (X.presheaf.map (TopologicalSpace.Opens.infLELeft (Uf y) (Uf z)).op).hom (sf y) =
        (X.presheaf.map (TopologicalSpace.Opens.infLERight (Uf y) (Uf z)).op).hom (sf z)
      apply sub_eq_zero.mp
      apply hSep (Uf y ⊓ Uf z)
      · rw [map_sub, nat i (TopologicalSpace.Opens.infLELeft _ _)
          (homOfLE (fun x hx => hx.1)), nat i (TopologicalSpace.Opens.infLERight _ _)
          (homOfLE (fun x hx => hx.2)), hs1' y, hs1' z,
          pm X' _ _ (homOfLE (show i ⁻¹ᵁ (Uf y ⊓ Uf z) ≤ i ⁻¹ᵁ O from
            fun x hx => hU y.1 y.2 hx.1)),
          pm X' _ _ (homOfLE (show i ⁻¹ᵁ (Uf y ⊓ Uf z) ≤ i ⁻¹ᵁ O from
            fun x hx => hU y.1 y.2 hx.1))]
        exact sub_self _
      · rw [map_sub, nat ι (TopologicalSpace.Opens.infLELeft _ _)
          (homOfLE (fun x hx => hx.1)), nat ι (TopologicalSpace.Opens.infLERight _ _)
          (homOfLE (fun x hx => hx.2)), hs2' y, hs2' z,
          pm Er _ _ (homOfLE (show ι ⁻¹ᵁ (Uf y ⊓ Uf z) ≤ ι ⁻¹ᵁ O from
            fun x hx => hU y.1 y.2 hx.1)),
          pm Er _ _ (homOfLE (show ι ⁻¹ᵁ (Uf y ⊓ Uf z) ≤ ι ⁻¹ᵁ O from
            fun x hx => hU y.1 y.2 hx.1))]
        exact sub_self _
    obtain ⟨f, hf, -⟩ := TopCat.Sheaf.existsUnique_gluing' X.sheaf Uf O
      (fun y => homOfLE (hU y.1 y.2)) hcov sf hcompat
    refine ⟨f, ?_, ?_⟩
    · apply TopCat.Sheaf.eq_of_locally_eq' X'.sheaf (fun y : ↥O => i ⁻¹ᵁ Uf y) (i ⁻¹ᵁ O)
        (fun y => homOfLE (fun x hx => hU y.1 y.2 hx))
      · intro x hx
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨i x, hx⟩, hyU (i x) hx⟩
      · intro y
        exact (nat i (homOfLE (hU y.1 y.2)) (homOfLE (fun x hx => hU y.1 y.2 hx)) f).symm.trans
          ((congrArg (i.app (Uf y)).hom (hf y)).trans (hs1' y))
    · apply TopCat.Sheaf.eq_of_locally_eq' Er.sheaf (fun y : ↥O => ι ⁻¹ᵁ Uf y) (ι ⁻¹ᵁ O)
        (fun y => homOfLE (fun x hx => hU y.1 y.2 hx))
      · intro x hx
        exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨ι x, hx⟩, hyU (ι x) hx⟩
      · intro y
        exact (nat ι (homOfLE (hU y.1 y.2)) (homOfLE (fun x hx => hU y.1 y.2 hx)) f).symm.trans
          ((congrArg (ι.app (Uf y)).hom (hf y)).trans (hs2' y))
  have hιO : (⊤ : Er.Opens) ≤ ι ⁻¹ᵁ O := by
    intro z _
    show ι z ∈ O
    apply hEO
    rw [← hιrange]
    exact Set.mem_range_self z
  have hEcl : IsClosed E := isClosed_of_mem_irreducibleComponents E hE

  haveI := hι
  have hσex : ∀ j, ∃ σ : Spec (.of K) ⟶ Er, σ ≫ ι = n j ≫ i := by
    intro j
    apply wc_ap_reduced_factor_closed_immersion _ _ _ (n j ≫ i) ι
    rintro _ ⟨z, rfl⟩
    rw [hιrange, Scheme.Hom.comp_apply, hpt z]
    exact (hnN j).1
  choose σ hσ using hσex
  have hσp : ∀ j, σ j ≫ ι ≫ p = 𝟙 _ := by
    intro j
    rw [← Category.assoc, hσ j, Category.assoc]
    exact hn j
  have hσpt : ∀ j, ι (σ j (IsLocalRing.closedPoint K)) = i (n j (IsLocalRing.closedPoint K)) := by
    intro j
    exact congrArg (fun f : Spec (.of K) ⟶ X => f (IsLocalRing.closedPoint K)) (hσ j)

  have hs3 : ∀ f : Γ(X, O), ∃ γ : Γ(Spec (.of K), ⊤),
      (ι.appLE O ⊤ hιO).hom f = ((ι ≫ p).appLE ⊤ ⊤ le_top).hom γ ∧
      ∀ j (h : ⊤ ≤ n j ⁻¹ᵁ (i ⁻¹ᵁ O)),
        ((n j).appLE (i ⁻¹ᵁ O) ⊤ h).hom ((i.appLE O (i ⁻¹ᵁ O) le_rfl).hom f) = γ := by
    intro f
    obtain ⟨c, hc⟩ := wcpa_dj_lcc_gs_p1_global_const K Er (ι ≫ p) θ hθ
      ((ι.appLE O ⊤ hιO).hom f)
    have hF : (ι.appLE O ⊤ hιO).hom f =
        ((ι ≫ p).appLE ⊤ ⊤ le_top).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c) := by
      rw [hc, happ]
    refine ⟨(Scheme.ΓSpecIso (.of K)).inv.hom c, hF, fun j h => ?_⟩
    have hσO : ⊤ ≤ (σ j ≫ ι) ⁻¹ᵁ O := fun z _ => hιO (show σ j z ∈ (⊤ : Er.Opens) from trivial)
    rw [hcomp (n j) i O (i ⁻¹ᵁ O) ⊤ le_rfl h h, hcongr _ _ (hσ j).symm O ⊤ h hσO,
      ← hcomp (σ j) ι O ⊤ ⊤ hιO le_top hσO, hF]
    exact heval Er (σ j) (ι ≫ p) (hσp j) ⊤ le_top _

  have hinj0 : ∀ f : Γ(X, O), (i.appLE O (i ⁻¹ᵁ O) le_rfl).hom f = 0 → f = 0 := by
    intro f hf
    obtain ⟨γ, hF, hj⟩ := hs3 f
    have h0 := hj ⟨0, hk1⟩ (hnpt ⟨0, hk1⟩)
    rw [hf, map_zero] at h0
    rw [← h0, map_zero] at hF
    apply hSep O f
    · rw [← Scheme.Hom.appLE_eq_app]; exact hf
    · rw [Scheme.Hom.appLE, CommRingCat.hom_comp, RingHom.comp_apply] at hF
      exact htopinj Er (ι ⁻¹ᵁ O) (top_le_iff.mp hιO) hιO _ hF
  refine ⟨fun f f' hff' => ?_, fun g => ⟨?_, ?_⟩⟩
  · have := hinj0 (f - f') (by rw [map_sub, hff', sub_self])
    exact sub_eq_zero.mp this

  · rintro ⟨f, rfl⟩ j j' h h'
    obtain ⟨γ, -, hj⟩ := hs3 f
    rw [hj j h, hj j' h']

  · intro hg
    set j0 : Fin k := ⟨0, hk1⟩ with hj0
    set γ : Γ(Spec (.of K), ⊤) := ((n j0).appLE (i ⁻¹ᵁ O) ⊤ (hnpt j0)).hom g with hγ
    set b : Γ(Er, ι ⁻¹ᵁ O) := ((ι ≫ p).appLE ⊤ (ι ⁻¹ᵁ O) le_top).hom γ with hb
    refine Exists.elim (hglue g b (fun y hy => ?_))
      (fun f hf => ⟨f, ?_⟩)
    rotate_left
    · rw [Scheme.Hom.appLE_eq_app]; exact hf.1
    by_cases hyE : y ∈ E
    · by_cases hycl : y ∈ closure Eᶜ
      ·
        obtain ⟨j, rfl⟩ := (hnchar y).mp ⟨hyE, hycl⟩
        rcases hNS (i (n j (IsLocalRing.closedPoint K))) with ⟨W, hW, hWsm⟩ | hnode
        · exact (wcpa_dj_lcc_gs_attach_not_smooth K X p E _ W hp hE ⟨hyE, hycl⟩ hW hWsm).elim
        obtain ⟨W', hW', hW'sm⟩ := hnsm j
        have ht1 := wcpa_dj_lcc_gs_smooth_uniformizer K X' (i ≫ p) (n j) W' (hn j) hW' hW'sm
        obtain ⟨W'', hW'', hW''sm⟩ :=
          wcpa_dj_lcc_gs_p1_smooth K Er (ι ≫ p) θ hθ (σ j (IsLocalRing.closedPoint K))
        have ht2 := wcpa_dj_lcc_gs_smooth_uniformizer K Er (ι ≫ p) (σ j) W'' (hσp j) hW'' hW''sm
        refine wcpa_dj_lcc_gs_node_local_glue K X X' Er p i ι (n j) (σ j) O g b
          wcpa_dj_lcc_gs_node_branch_sum hp hi hι (hn j) (hσp j) (hσpt j).symm hnode ht1 ht2
          hSep hy (fun h h' => ?_)
        rw [hg j j0 h (hnpt j0), hb]
        exact (heval Er (σ j) (ι ≫ p) (hσp j) (ι ⁻¹ᵁ O) h' γ).symm
      ·
        refine ⟨O ⊓ ⟨(closure Eᶜ)ᶜ, isClosed_closure.isOpen_compl⟩, inf_le_left, ⟨hy, hycl⟩,
          (p.appLE ⊤ (O ⊓ ⟨(closure Eᶜ)ᶜ, isClosed_closure.isOpen_compl⟩) le_top).hom γ, ?_, ?_⟩
        · apply hsub X'
          apply le_bot_iff.mp
          intro z hz
          exfalso
          apply hz.2
          rw [← hirange]
          exact Set.mem_range_self z
        · rw [← Scheme.Hom.appLE_eq_app, hcomp ι p ⊤ _ _ le_top le_rfl le_top, hb,
            hmap (ι ≫ p) ⊤ (ι ⁻¹ᵁ O) _ le_top le_top]
    ·
      have hUi : ((O ⊓ ⟨Eᶜ, hEcl.isOpen_compl⟩ : X.Opens) : Set X) ⊆ Set.range i := by
        intro z hz
        rw [hirange]
        exact subset_closure hz.2
      obtain ⟨s, hs⟩ := (hbij _ hUi).2
        ((X'.presheaf.map (homOfLE (show i ⁻¹ᵁ (O ⊓ ⟨Eᶜ, hEcl.isOpen_compl⟩) ≤ i ⁻¹ᵁ O from
          fun x hx => (inf_le_left : O ⊓ ⟨Eᶜ, hEcl.isOpen_compl⟩ ≤ O) hx)).op).hom g)
      refine ⟨O ⊓ ⟨Eᶜ, hEcl.isOpen_compl⟩, inf_le_left, ⟨hy, hyE⟩, s, hs, ?_⟩
      apply hsub Er
      apply le_bot_iff.mp
      intro z hz
      exfalso
      apply hz.2
      rw [← hιrange]
      exact Set.mem_range_self z

theorem wcpa_dj_lcc_fs_finite_of_fibres : ∀ (K : Type u) [Field K] (X Y : Scheme.{u}) (pX : X ⟶ Spec (.of K)) (pY : Y ⟶ Spec (.of K)) (π : X ⟶ Y), IsProper pX → IsProper pY → π ≫ pY = pX → (∀ y : Y, (⇑π ⁻¹' {y}).Finite) → (∀ x x' : X, π x = π x' → x ≠ x' → IsClosed ({x} : Set X)) → IsFinite π :=
by
  intro K _ X Y pX pY π hpX hpY hcomp hfib _hclosed
  haveI := hpY
  haveI : IsProper (π ≫ pY) := by rw [hcomp]; exact hpX
  haveI : IsProper π := IsProper.of_comp π pY
  haveI : LocallyQuasiFinite π := LocallyQuasiFinite.of_finite_preimage_singleton π hfib
  exact IsFinite.of_isProper_of_locallyQuasiFinite π

theorem wcpa_dj_lcc_fs_pinch_point : ∀ (K : Type u) [Field K] [IsAlgClosed K] (X' Y : Scheme.{u}) (pX' : X' ⟶ Spec (.of K)) (pY : Y ⟶ Spec (.of K)) (π : X' ⟶ Y) (k : ℕ) (n : Fin k → (Spec (.of K) ⟶ X')) (V₀ : Y.Opens) (y : Y), π ≫ pY = pX' → IsProper pY → 1 ≤ k → k ≤ 2 → (∀ j, n j ≫ pX' = 𝟙 _) → (∀ j j', j ≠ j' → n j (IsLocalRing.closedPoint K) ≠ n j' (IsLocalRing.closedPoint K)) → (∀ j, ∃ W : X'.Opens, n j (IsLocalRing.closedPoint K) ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ pX')) → (∀ j, π (n j (IsLocalRing.closedPoint K)) = y) → y ∈ V₀ → IsAffineOpen V₀ → IsAffineOpen (π ⁻¹ᵁ V₀) → Function.Injective (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl).hom → (∀ g : Γ(X', π ⁻¹ᵁ V₀), (∃ b : Γ(Y, V₀), (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl).hom b = g) ↔ ∀ (j j' : Fin k) (h : ⊤ ≤ n j ⁻¹ᵁ (π ⁻¹ᵁ V₀)) (h' : ⊤ ≤ n j' ⁻¹ᵁ (π ⁻¹ᵁ V₀)), ((n j).appLE (π ⁻¹ᵁ V₀) ⊤ h).hom g = ((n j').appLE (π ⁻¹ᵁ V₀) ⊤ h').hom g) → (k = 1 → ∃ W : Y.Opens, y ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ pY)) ∧ (k = 2 → ∃ e : AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y) ≃+* (MvPowerSeries (Fin 2) K ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), e.toRingHom.comp ((algebraMap (Y.presheaf.stalk y) (AdicCompletion (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y))).comp ((Scheme.ΓSpecIso (.of K)).inv ≫ pY.appTop ≫ Y.presheaf.germ ⊤ y trivial).hom) = (Ideal.Quotient.mk _).comp MvPowerSeries.C) :=
by
  intro K _ _ X' Y pX' pY π k n V₀ y hπ hpY hk1 hk2 hn hndist hsm hpts hyV₀ hV₀ hU hinj heq
  have cong : ∀ {X Y : Scheme.{u}} {f g : X ⟶ Y}, f = g → ∀ (U : Y.Opens) (V : X.Opens)
      (e : V ≤ f ⁻¹ᵁ U) (e' : V ≤ g ⁻¹ᵁ U), f.appLE U V e = g.appLE U V e' := by
    rintro X Y f g rfl U V e e'
    rfl
  have idtop : ∀ (X : Scheme.{u}) (e : (⊤ : X.Opens) ≤ (𝟙 X : X ⟶ X) ⁻¹ᵁ ⊤),
      Scheme.Hom.appLE (𝟙 X) ⊤ ⊤ e = 𝟙 _ := by
    intro X e
    simp only [Scheme.Hom.appLE, Scheme.Hom.id_app, Category.id_comp]
    rw [show (homOfLE e).op = 𝟙 (Opposite.op (⊤ : X.Opens)) from Subsingleton.elim _ _]
    exact (Category.id_comp _).trans (X.presheaf.map_id _)
  have hΓinj : Function.Injective (Scheme.ΓSpecIso (.of K)).hom.hom :=
    (Scheme.ΓSpecIso (.of K)).commRingCatIsoToRingEquiv.injective
  have hσU : ∀ j, (⊤ : (Spec (.of K)).Opens) ≤ n j ⁻¹ᵁ (π ⁻¹ᵁ V₀) := by
    intro j q _
    have hq : q = IsLocalRing.closedPoint K := Subsingleton.elim _ _
    rw [hq]
    show π (n j (IsLocalRing.closedPoint K)) ∈ V₀
    rw [hpts j]
    exact hyV₀
  refine ⟨fun hk => ?_, fun hk => ?_⟩
  ·
    subst hk
    have hbij : Function.Bijective (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl).hom := by
      refine ⟨hinj, fun g => (heq g).mpr ?_⟩
      intro j j' h h'
      obtain rfl : j = j' := Subsingleton.elim _ _
      rfl
    haveI : IsIso (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr hbij
    have hsq : Spec.map (π.appLE V₀ (π ⁻¹ᵁ V₀) le_rfl) ≫ hV₀.fromSpec = hU.fromSpec ≫ π :=
      IsAffineOpen.SpecMap_appLE_fromSpec π hV₀ hU le_rfl
