  intro A C _ _ _ ψ R g
  let α := Spec.map (CommRingCat.ofHom (algebraMap A C))
  let β := Spec.map (CommRingCat.ofHom ψ.toRingHom)
  let γ := Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))
