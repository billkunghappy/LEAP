        (∀ a, Limits.pullback.fst u'
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) ⁻¹ᵁ U' a =
          ψb ⁻¹ᵁ Ub a) ∧
        (⨆ a, U' a) = ⊤ ∧ (⨆ a, Ub a) = ⊤ :=
by
  intro Ω _ W' Wb hhen hκ _hWb Z' u' Zb ub ψb hss' hssb hprojb hpbb
  classical
  obtain ⟨N, j, hj, hju⟩ := hprojb
  haveI := hj
  haveI : IsProper u' := hss'.2.1
  haveI : IsProper ub := hssb.2.1
