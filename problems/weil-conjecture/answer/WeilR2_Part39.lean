    let j₁ : Limits.pullback u₁ g ⟶ Limits.pullback (Limits.coprod.desc u₁ u₂) g :=
      Limits.pullback.map u₁ g (Limits.coprod.desc u₁ u₂) g Limits.coprod.inl (𝟙 T) (𝟙 S)
        (by simp) (by simp)
    let j₂ : Limits.pullback u₂ g ⟶ Limits.pullback (Limits.coprod.desc u₁ u₂) g :=
      Limits.pullback.map u₂ g (Limits.coprod.desc u₁ u₂) g Limits.coprod.inr (𝟙 T) (𝟙 S)
        (by simp) (by simp)
    have hj₁f : j₁ ≫ Limits.pullback.fst _ _ = Limits.pullback.fst u₁ g ≫ Limits.coprod.inl :=
      Limits.pullback.lift_fst _ _ _
    have hj₂f : j₂ ≫ Limits.pullback.fst _ _ = Limits.pullback.fst u₂ g ≫ Limits.coprod.inr :=
