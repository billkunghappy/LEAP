            (φ'.appLE (L₀.V a) ((wcpaDjCocPull φ' L₀).V a ⊓ q' ⁻¹ᵁ ⊤) inf_le_left).hom
              (wcCbcmToFamTop L₀ (β0' j) a)) := by
        rw [← hF v, ← hvx, e1, hT0]
      have h3 := congrArg (wcCbcmToFam (wcpaDjCocPull φ' L₀) (q' ⁻¹ᵁ ⊤)) hOf
