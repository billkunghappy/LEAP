    exact (Scheme.evaluation_ne_zero_iff_mem_basicOpen C ξ _ (t b)).mpr (hnv b hb)
  have hratio : ∀ (b : Fin L.m) (hab : ξ ∈ L.V a ⊓ L.V b),
      (C.presheaf.germ (L.V a ⊓ L.V b) ξ hab ≫ C.residue ξ).hom
        (L.g a b : Γ(C, L.V a ⊓ L.V b)) = τ b * (τ a)⁻¹ := by
    intro b hab
    have h := wcpa_dj_lsp_scd_compat_residue C (q ⁻¹ᵁ ⊤) L t hcomp ξ a b hab (htopmem ξ)
    have e : τ b = (C.presheaf.germ (L.V a ⊓ L.V b) ξ hab ≫ C.residue ξ).hom
        (L.g a b : Γ(C, L.V a ⊓ L.V b)) * τ a := by
      rw [hτ b hab.2, hτ a ha]
      exact h
    rw [e, mul_inv_cancel_right₀ (hτ0 a ha)]
  have hτV : ∀ (V : ValuationSubring (C.residueField ξ)) (b : Fin L.m),
      wcpaDjChartGood L ξ V b → τ b ∈ V := by
    intro V b hg
    obtain ⟨hb, hgood⟩ := hg
    have hle : L.V b ≤ L.V b ⊓ q ⁻¹ᵁ ⊤ := by
      intro y hy
      exact TopologicalSpace.Opens.mem_inf.mpr ⟨hy, htopmem y⟩
    have key := hgood ((C.presheaf.map (homOfLE hle).op).hom (t b))
    have e : τ b = (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom
        ((C.presheaf.map (homOfLE hle).op).hom (t b)) := by
      rw [hτ b hb, ← TopCat.Presheaf.germ_res C.presheaf (homOfLE hle) ξ hb]
      rfl
    rw [e]
    exact key

  suffices main : ∀ T : ValuationSubring (C.residueField ξ) → ℤ,
      (∀ V, ¬ wcpaDjNtV' K V → T V = 0) →
      (∀ V, wcpaDjNtV' K V → ∃ b, ∃ _ : ξ ∈ L.V b, wcpaDjChartGood L ξ V b ∧
          T V = wcpaDjValOrd V (τ b) - wcpaDjValOrd V (τ a)) →
      1 ≤ ∑ᶠ V, T V by
    unfold wcpaDjCompDeg
    apply main
    · intro V hV
      beta_reduce
      split_ifs with hP
      · obtain ⟨b, hgood⟩ := hP.2
        have hall := hconst V b hgood
        have hVtop : V = ⊤ := by
          by_contra hne
          exact hV ⟨hall, hne⟩
        subst hVtop
        exact htop _
      · rfl
    · intro V hV
      obtain ⟨b0, hb0⟩ := hNt_chart V hV
      have hP : ξ ∈ L.V a ∧ ∃ b, wcpaDjChartGood L ξ V b := ⟨ha, b0, hb0⟩
      refine ⟨hP.2.choose, hgb V _ hP.2.choose_spec, hP.2.choose_spec, ?_⟩
      beta_reduce
      rw [dif_pos hP]
      have hbm := hgb V _ hP.2.choose_spec
      rw [hratio _ (TopologicalSpace.Opens.mem_inf.mpr ⟨ha, hbm⟩)]
      rw [hmul V hV _ _ (hτ0 _ hbm) (inv_ne_zero (hτ0 a ha)), hvinv V hV _ (hτ0 a ha)]
      ring
  intro T hT0 hT1
  haveI : Nonempty (Fin L.m) := ⟨a⟩
  choose! bs hbsξ hbsg hbsT using hT1
  obtain ⟨B, hBd⟩ : ∃ B : ValuationSubring (C.residueField ξ) → ℤ,
      B = Set.indicator {V : ValuationSubring (C.residueField ξ) | wcpaDjNtV' K V}
        (fun V => wcpaDjValOrd V (τ a)) := ⟨_, rfl⟩
  have hB_in : ∀ V, wcpaDjNtV' K V → B V = wcpaDjValOrd V (τ a) := by
    intro V hV; rw [hBd]; exact Set.indicator_of_mem (show V ∈ {V | wcpaDjNtV' K V} from hV) _
  have hB_out : ∀ V, ¬ wcpaDjNtV' K V → B V = 0 := by
    intro V hV; rw [hBd]; exact Set.indicator_of_notMem (show V ∉ {V | wcpaDjNtV' K V} from hV) _
  obtain ⟨A, hAd⟩ : ∃ A : ValuationSubring (C.residueField ξ) → ℤ, ∀ V, A V = T V + B V :=
    ⟨fun V => T V + B V, fun V => rfl⟩
  have hA_nonneg : ∀ V, 0 ≤ A V := by
    intro V
    by_cases hN : wcpaDjNtV' K V
    · rw [hAd V, hbsT V hN, hB_in V hN]
      have := (wcpa_dj_lsp_scd_valord_bounds _ V).1 _ (hτV V _ (hbsg V hN))
      linarith
    · rw [hAd V, hT0 V hN, hB_out V hN, add_zero]
  have hfinB : (Function.support B).Finite := by
    refine (hfin (τ a) (hτ0 a ha)).subset ?_
    intro V hV
    have hV' := Function.mem_support.mp hV
    by_cases hN : wcpaDjNtV' K V
    · exact ⟨hN, by rwa [hB_in V hN] at hV'⟩
    · exact absurd (hB_out V hN) hV'
  have hfinA : (Function.support A).Finite := by
    have hU : (⋃ b : Fin L.m, {V : ValuationSubring (C.residueField ξ) |
        wcpaDjNtV' K V ∧ τ b ≠ 0 ∧ wcpaDjValOrd V (τ b) ≠ 0}).Finite := by
      apply Set.finite_iUnion
      intro b
      by_cases hb0 : τ b = 0
      · exact Set.finite_empty.subset (fun V hV => (hV.2.1 hb0).elim)
      · exact (hfin (τ b) hb0).subset (fun V hV => ⟨hV.1, hV.2.2⟩)
    refine hU.subset ?_
    intro V hV
    have hV' := Function.mem_support.mp hV
    by_cases hN : wcpaDjNtV' K V
    · refine Set.mem_iUnion.mpr ⟨bs V, hN, hτ0 _ (hbsξ V hN), ?_⟩
      intro h0
      apply hV'
      rw [hAd V, hbsT V hN, hB_in V hN, h0]
      ring
    · exact absurd (by rw [hAd V, hT0 V hN, hB_out V hN, add_zero]) hV'
  have hTsum : ∑ᶠ V, T V = ∑ᶠ V, A V - ∑ᶠ V, B V := by
    rw [← finsum_sub_distrib (show Function.HasFiniteSupport A from hfinA)
      (show Function.HasFiniteSupport B from hfinB)]
    apply finsum_congr
    intro V
    rw [hAd V]
    ring
  have hsumB : ∑ᶠ V, B V = 0 := by
    rw [hBd]
    exact hsum (τ a) (hτ0 a ha)

  obtain ⟨x, hxcl, hx0⟩ := hz
  have hsp : ξ ⤳ x := specializes_iff_mem_closure.mpr hxcl
  obtain ⟨V₀, hdom⟩ := wcpa_dj_lsp_scd_dominating_valuation C ξ x hsp
  have hψ : ∀ (U : C.Opens) (hxU : x ∈ U) (s : Γ(C, U)),
      (C.presheaf.stalkSpecializes hsp ≫ C.residue ξ).hom ((C.presheaf.germ U x hxU).hom s) =
        (C.presheaf.germ U ξ (hsp.mem_open U.isOpen hxU) ≫ C.residue ξ).hom s := by
    intro U hxU s
    rw [← TopCat.Presheaf.germ_stalkSpecializes C.presheaf hxU hsp]
    rfl
  have hxtop : x ∈ (⨆ b, L.V b) := by
    rw [hOK.2.1]
    trivial
  obtain ⟨b₀, hb₀⟩ := TopologicalSpace.Opens.mem_iSup.mp hxtop
  have hξb₀ : ξ ∈ L.V b₀ := hsp.mem_open (L.V b₀).isOpen hb₀
  have hgood₀ : wcpaDjChartGood L ξ V₀ b₀ := by
    refine ⟨hξb₀, fun s => ?_⟩
    rw [← hψ (L.V b₀) hb₀ s]
    exact (hdom _).fst
  have hstar : ∀ (b : Fin L.m), x ∈ L.V b → τ b ∈ V₀.nonunits := by
    intro b hxb
    have hxO : x ∈ L.V b ⊓ q ⁻¹ᵁ ⊤ := TopologicalSpace.Opens.mem_inf.mpr ⟨hxb, htopmem x⟩
    have hnu : (C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) x hxO).hom (t b) ∈
        IsLocalRing.maximalIdeal (C.presheaf.stalk x) := by
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact fun hu => hx0 b hxb ((Scheme.mem_basicOpen C (t b) x hxO).mpr hu)
    have e : τ b = (C.presheaf.stalkSpecializes hsp ≫ C.residue ξ).hom
        ((C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) x hxO).hom (t b)) := by
      rw [hψ _ hxO, hτ b (hsp.mem_open (L.V b).isOpen hxb)]
    rw [e, ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal]
    exact ⟨(hdom _).fst, (hdom _).snd hnu⟩
  have hV₀top : V₀ ≠ ⊤ := by
    intro hVt
    have h1 := hstar b₀ hb₀
    rw [hVt] at h1
    obtain ⟨h2, h3⟩ := ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal.mp h1
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h3)
      (IsUnit.of_mul_eq_one
        (⟨(τ b₀)⁻¹, ValuationSubring.mem_top _⟩ : (⊤ : ValuationSubring (C.residueField ξ)))
        (Subtype.ext (by simp [hτ0 b₀ hξb₀])))
  have hN₀ : wcpaDjNtV' K V₀ := ⟨hconst V₀ b₀ hgood₀, hV₀top⟩
  obtain ⟨hbξ, hbgood⟩ := hbsg V₀ hN₀
  have hxb : x ∈ L.V (bs V₀) :=
    wcpa_dj_lsp_scd_centre_in_chart K C q hsep (L.V (bs V₀)) (hOK.1 _) ξ x hsp hbξ V₀ hbgood hdom
  obtain ⟨hm1, hm2⟩ :=
    ValuationSubring.mem_nonunits_iff_exists_mem_maximalIdeal.mp (hstar _ hxb)
  have hge1 : 1 ≤ wcpaDjValOrd V₀ (τ (bs V₀)) :=
    (wcpa_dj_lsp_scd_valord_bounds _ V₀).2 ⟨u V₀, hu V₀ hN₀⟩ (hmul V₀ hN₀) _ hm1
      (hτ0 _ hbξ) hm2
  have hAV₀ : 1 ≤ A V₀ := by
    rw [hAd V₀, hbsT V₀ hN₀, hB_in V₀ hN₀]
    linarith
  have hle := single_le_finsum V₀ (show Function.HasFiniteSupport A from hfinA) hA_nonneg
  rw [hTsum, hsumB]
  linarith

theorem wcpa_dj_lcc_sep_curve_separation : ∀ (S Z : Scheme.{u}) (u : Z ⟶ S), wcpaDjSemistable u → ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ S) (L : wcpaDjCoc (Limits.pullback u s)) (B : Set ↥(Limits.pullback u s) → Prop), wcpaDjCocOK L → (∀ ξ : ↥(Limits.pullback u s), closure {ξ} ∈ irreducibleComponents ↥(Limits.pullback u s) → ¬ B (closure {ξ}) → ∀ a : Fin L.m, ξ ∈ L.V a → 1 ≤ wcpaDjCompDeg L ξ a) → ∃ k₀ : ℕ, 1 ≤ k₀ ∧ ∀ e : ℕ, k₀ ≤ e → ∀ x : ↥(Limits.pullback u s), IsClosed ({x} : Set ↥(Limits.pullback u s)) → (∀ E ∈ irreducibleComponents ↥(Limits.pullback u s), B E → x ∉ E) → ∃ g : ∀ a : Fin L.m, Γ(Limits.pullback u s, L.V a ⊓ (Limits.pullback.snd u s) ⁻¹ᵁ ⊤), wcpaDjCocSec (Limits.pullback.snd u s) L e g ∧ (∀ (a : Fin L.m) (hx : x ∈ L.V a ⊓ (Limits.pullback.snd u s) ⁻¹ᵁ ⊤), ((Limits.pullback u s).presheaf.germ (L.V a ⊓ (Limits.pullback.snd u s) ⁻¹ᵁ ⊤) x hx).hom (g a) ∉ IsLocalRing.maximalIdeal ((Limits.pullback u s).presheaf.stalk x)) ∧ ∀ E ∈ irreducibleComponents ↥(Limits.pullback u s), B E → ∀ y ∈ E, ∀ (a : Fin L.m) (hy : y ∈ L.V a ⊓ (Limits.pullback.snd u s) ⁻¹ᵁ ⊤), ((Limits.pullback u s).presheaf.germ (L.V a ⊓ (Limits.pullback.snd u s) ⁻¹ᵁ ⊤) y hy).hom (g a) ∈ IsLocalRing.maximalIdeal ((Limits.pullback u s).presheaf.stalk y) :=
by
  intro S Z u hss K _ _ s L B hOK hdeg
  classical
  have hssC : wcpaDjSemistable (Limits.pullback.snd u s) :=
    wcpa_dj_mm_semistable_basechange S (Spec (.of K)) Z s u hss
  haveI : IsProper u := hss.2.1
  haveI hJac : JacobsonSpace ↥(Limits.pullback u s) :=
    LocallyOfFiniteType.jacobsonSpace (Limits.pullback.snd u s)
  obtain ⟨hcompfin, hnodes⟩ := wcpa_dj_lfc_afc_fibre_nodes_finite S Z u hss K s

  have ip_zero : ∀ {F : Type u} [Field F] (V : ValuationSubring F) (n : ℕ),
      wcpaDjPsInPow V 0 n := by
    intro F _ V n
    unfold wcpaDjPsInPow
    exact ⟨V.zero_mem, Submodule.zero_mem _⟩
  have ip_sub : ∀ {F : Type u} [Field F] (V : ValuationSubring F) (f g : F) (n : ℕ),
      wcpaDjPsInPow V f n → wcpaDjPsInPow V g n → wcpaDjPsInPow V (f - g) n := by
    intro F _ V f g n hf hg
    unfold wcpaDjPsInPow at hf hg ⊢
    obtain ⟨hf, hf'⟩ := hf
    obtain ⟨hg, hg'⟩ := hg
    exact ⟨sub_mem hf hg, Submodule.sub_mem _ hf' hg'⟩
  have ip_one : ∀ {F : Type u} [Field F] (V : ValuationSubring F), ¬ wcpaDjPsInPow V 1 1 := by
    intro F _ V h
    unfold wcpaDjPsInPow at h
    obtain ⟨h, h'⟩ := h
    rw [pow_one] at h'
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h') isUnit_one

  have key : ∀ (C : Scheme.{u}) (q : C ⟶ Spec (.of K)) (L : wcpaDjCoc C) (B : Set C → Prop),
      wcpaDjSemistable q → JacobsonSpace C → (irreducibleComponents C).Finite →
      (∀ E ∈ irreducibleComponents C, (E ∩ closure Eᶜ).Finite ∧
        ∀ x ∈ E ∩ closure Eᶜ, IsClosed {x}) →
      wcpaDjCocOK L →
      (∀ ξ : C, closure {ξ} ∈ irreducibleComponents C → ¬ B (closure {ξ}) →
        ∀ a : Fin L.m, ξ ∈ L.V a → 1 ≤ wcpaDjCompDeg L ξ a) →
      ∃ k₀ : ℕ, 1 ≤ k₀ ∧ ∀ e : ℕ, k₀ ≤ e → ∀ x : C, IsClosed ({x} : Set C) →
        (∀ E ∈ irreducibleComponents C, B E → x ∉ E) →
        ∃ g : ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤), wcpaDjCocSec q L e g ∧
          (∀ (a : Fin L.m) (hx : x ∈ L.V a ⊓ q ⁻¹ᵁ ⊤),
            (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) x hx).hom (g a) ∉
              IsLocalRing.maximalIdeal (C.presheaf.stalk x)) ∧
          ∀ E ∈ irreducibleComponents C, B E → ∀ y ∈ E, ∀ (a : Fin L.m)
            (hy : y ∈ L.V a ⊓ q ⁻¹ᵁ ⊤),
            (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) y hy).hom (g a) ∈
              IsLocalRing.maximalIdeal (C.presheaf.stalk y) := by
    intro C q L B hss hJ hcompfin hnodes hOK hdeg
    haveI := hJ
    have br_gen : ∀ (x : C) (β : Σ ξ : C, ValuationSubring (C.residueField ξ)),
        wcpaDjPsBr q x β → closure {β.1} ∈ irreducibleComponents C := by
      intro x β h
      unfold wcpaDjPsBr at h
      exact h.1
    have br_sp : ∀ (x : C) (β : Σ ξ : C, ValuationSubring (C.residueField ξ)),
        wcpaDjPsBr q x β → β.1 ⤳ x := by
      intro x β h
      unfold wcpaDjPsBr at h
      exact h.2.2.2.1

    have hbd : ∀ (E : Set C) (ξ y : C), E ∈ irreducibleComponents C →
        closure {ξ} ∈ irreducibleComponents C → closure {ξ} ≠ E → ξ ⤳ y → y ∈ E →
        y ∈ E ∩ closure Eᶜ := by
      intro E ξ y hE hξ hne hsp hyE
      refine ⟨hyE, ?_⟩
      have hξE : ξ ∉ E := by
        intro hξE
        have hsub : closure {ξ} ⊆ E :=
          closure_minimal (Set.singleton_subset_iff.mpr hξE)
            (isClosed_of_mem_irreducibleComponents E hE)
        have hE' : Maximal (fun x : Set C => IsClosed x ∧ IsIrreducible x) E := by
          rw [irreducibleComponents_eq_maximals_closed] at hE; exact hE
        have hξ' : Maximal (fun x : Set C => IsClosed x ∧ IsIrreducible x) (closure {ξ}) := by
          rw [irreducibleComponents_eq_maximals_closed] at hξ; exact hξ
        exact hne (hξ'.eq_of_ge hE'.prop hsub).symm
      exact closure_mono (Set.singleton_subset_iff.mpr hξE) (specializes_iff_mem_closure.mp hsp)

    have hjac : ∀ (U : C.Opens) (f : Γ(C, U)) (E : Set C), IsClosed E →
        (∀ y ∈ E, ∀ hy : y ∈ U, IsClosed ({y} : Set C) →
          (C.presheaf.germ U y hy).hom f ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk y)) →
        ∀ y ∈ E, ∀ hy : y ∈ U,
          (C.presheaf.germ U y hy).hom f ∈ IsLocalRing.maximalIdeal (C.presheaf.stalk y) := by
      intro U f E hE H y hyE hy
      by_contra hne
      have hunit : IsUnit ((C.presheaf.germ U y hy).hom f) :=
        IsLocalRing.notMem_maximalIdeal.mp hne
      have hyb : y ∈ C.basicOpen f := (C.mem_basicOpen f y hy).mpr hunit
      obtain ⟨y', ⟨hy'b, hy'E⟩, hy'cl⟩ :=
        nonempty_inter_closedPoints (Z := (C.basicOpen f : Set C) ∩ E) ⟨y, hyb, hyE⟩
          ((C.basicOpen f).isOpen.isLocallyClosed.inter hE.isLocallyClosed)
      have hy'U : y' ∈ U := C.basicOpen_le f hy'b
      have h1 := H y' hy'E hy'U (mem_closedPoints_iff.mp hy'cl)
      have h2 : IsUnit ((C.presheaf.germ U y' hy'U).hom f) := (C.mem_basicOpen f y' hy'U).mp hy'b
      exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp h1) h2

    have hcov : ∀ x : C, ∃ a, x ∈ L.V a := by
      intro x
      have hx : x ∈ (⨆ a, L.V a) := by rw [hOK.2.1]; trivial
      exact TopologicalSpace.Opens.mem_iSup.mp hx
    choose ch hch using hcov
    obtain ⟨hGfin, ⟨Z₀, hZ₀fin, hZ₀⟩, hBrEx, -⟩ := wcpa_dj_fva_ss_branch_basics K C q hss
    have hU := wcpa_dj_fva_ss_center_unique K C q hss
    choose c hc using fun ξ => wcpa_dj_fva_ss_component_jets K C q L hss hOK ch hch ξ
    obtain ⟨Zc, hZc⟩ : ∃ Zc : Finset C,
        Zc = hZ₀fin.toFinset.filter (fun z => IsClosed ({z} : Set C)) := ⟨_, rfl⟩
    have hZcl : ∀ z ∈ Zc, IsClosed ({z} : Set C) := by
      intro z hz
      rw [hZc] at hz
      exact (Finset.mem_filter.mp hz).2
    have hZmem : ∀ z : C, IsClosed ({z} : Set C) → z ∈ Z₀ → z ∈ Zc := by
      intro z hz hzZ
      rw [hZc]
      exact Finset.mem_filter.mpr ⟨hZ₀fin.mem_toFinset.mpr hzZ, hz⟩
    have hNfin : (⋃ E ∈ {E : Set C | E ∈ irreducibleComponents C ∧ B E}, E ∩ closure Eᶜ).Finite :=
      Set.Finite.biUnion (hcompfin.subset (fun E h => h.1)) (fun E h => (hnodes E h.1).1)
    obtain ⟨Nc, hNc⟩ : ∃ Nc : Finset C, Nc = hNfin.toFinset := ⟨_, rfl⟩
    have hNmem : ∀ y : C, ∀ E ∈ irreducibleComponents C, B E → y ∈ E ∩ closure Eᶜ → y ∈ Nc := by
      intro y E hE hBE hy
      rw [hNc, Set.Finite.mem_toFinset]
      exact Set.mem_biUnion (x := E) ⟨hE, hBE⟩ hy
    have hNcl : ∀ p ∈ Nc, IsClosed ({p} : Set C) := by
      intro p hp
      rw [hNc, Set.Finite.mem_toFinset] at hp
      obtain ⟨E, hEm, hpE⟩ := Set.mem_iUnion₂.mp hp
      exact (hnodes E hEm.1).2 p hpE
    refine ⟨1 + ∑ ξ ∈ hGfin.toFinset, c ξ + 2 * (Zc.card + Nc.card + 1), by omega, ?_⟩

    intro e he x hx hxB
    obtain ⟨P, hP⟩ : ∃ P : Finset C, P = insert x (Zc ∪ Nc) := ⟨_, rfl⟩
    have hPcard : P.card ≤ Zc.card + Nc.card + 1 := by
      have h1 := Finset.card_insert_le x (Zc ∪ Nc)
      have h2 := Finset.card_union_le Zc Nc
      rw [hP]
      omega
    have hPcl : ∀ p ∈ P, IsClosed ({p} : Set C) := by
      intro p hp
      rw [hP] at hp
      rcases Finset.mem_insert.mp hp with h | h
      · rw [h]; exact hx
      · rcases Finset.mem_union.mp h with h | h
        · exact hZcl p h
        · exact hNcl p h
    have hxP : x ∈ P := by rw [hP]; exact Finset.mem_insert_self _ _
    obtain ⟨J, hJ⟩ : ∃ J : ∀ β : (Σ ξ : C, ValuationSubring (C.residueField ξ)),
        C.residueField β.1, ∀ β, J β = if wcpaDjPsBr q x β then 1 else 0 :=
      ⟨fun β => if wcpaDjPsBr q x β then 1 else 0, fun _ => rfl⟩
    obtain ⟨cv, hcv⟩ : ∃ cv : C → K, ∀ p, cv p = if p = x then 1 else 0 :=
      ⟨fun p => if p = x then 1 else 0, fun _ => rfl⟩
    have hJmem : ∀ β : (Σ ξ : C, ValuationSubring (C.residueField ξ)), J β ∈ β.2 := by
      intro β
      rw [hJ β]
      split_ifs
      · exact β.2.one_mem
      · exact β.2.zero_mem
    have hu : ∀ ξ : C, ∃ uξ : C.residueField ξ,
        ((closure {ξ} ∈ irreducibleComponents C ∧ ¬ B (closure {ξ})) →
          (∀ y : C, IsClosed ({y} : Set C) → ∀ V : ValuationSubring (C.residueField ξ),
            wcpaDjPsBr q y ⟨ξ, V⟩ → wcpaDjPsInPow V (wcpaDjPsTw L (ch ξ) (ch y) ξ ^ e * uξ) 0) ∧
          (∀ p ∈ P, ∀ V : ValuationSubring (C.residueField ξ), wcpaDjPsBr q p ⟨ξ, V⟩ →
            J ⟨ξ, V⟩ ∈ V →
            wcpaDjPsInPow V (wcpaDjPsTw L (ch ξ) (ch p) ξ ^ e * uξ - J ⟨ξ, V⟩) 1)) ∧
        (¬ (closure {ξ} ∈ irreducibleComponents C ∧ ¬ B (closure {ξ})) → uξ = 0) := by
      intro ξ
      by_cases hcond : closure {ξ} ∈ irreducibleComponents C ∧ ¬ B (closure {ξ})
      · have hξG : ξ ∈ hGfin.toFinset := hGfin.mem_toFinset.mpr hcond.1
        have h1 : c ξ ≤ ∑ ξ' ∈ hGfin.toFinset, c ξ' :=
          Finset.single_le_sum (fun _ _ => Nat.zero_le _) hξG
        have h3 : ∑ p ∈ P, 2 * ((fun _ : C => (1 : ℕ)) p) ≤ 2 * (Zc.card + Nc.card + 1) := by
          simp only [mul_one, Finset.sum_const, smul_eq_mul]
          omega
        have hle : c ξ + ∑ p ∈ P, 2 * ((fun _ : C => (1 : ℕ)) p) ≤ e := by omega
        obtain ⟨uξ, hu1, hu2⟩ := hc ξ hcond.1 (hdeg ξ hcond.1 hcond.2 (ch ξ) (hch ξ)) e P
          (fun _ => 1) (fun V => J ⟨ξ, V⟩) hle hPcl
        exact ⟨uξ, fun _ => ⟨hu1, hu2⟩, fun h => absurd hcond h⟩
      · exact ⟨0, fun h => absurd h hcond, fun _ => rfl⟩
    choose w huJ hu0 using hu

    have hxnot : ∀ (y : C) (β : Σ ξ : C, ValuationSubring (C.residueField ξ)),
        wcpaDjPsBr q y β → B (closure {β.1}) → y ≠ x := by
      intro y β hβ hB hyx
      have hmem : y ∈ closure {β.1} := specializes_iff_mem_closure.mp (br_sp y β hβ)
      rw [hyx] at hmem
      exact hxB _ (br_gen y β hβ) hB hmem
    have hJ0 : ∀ y : C, IsClosed ({y} : Set C) →
        ∀ β : (Σ ξ : C, ValuationSubring (C.residueField ξ)), wcpaDjPsBr q y β → y ≠ x →
        J β = 0 := by
      intro y hy β hβ hyx
      rw [hJ β, if_neg (fun h => hyx (hU y x hy hx β hβ h))]

    have hreg : ∀ y : C, IsClosed ({y} : Set C) → ∀ β, wcpaDjPsBr q y β →
        wcpaDjPsInPow β.2 (wcpaDjPsTw L (ch β.1) (ch y) β.1 ^ e * w β.1) 0 := by
      intro y hy β hβ
      by_cases hB : B (closure {β.1})
      · rw [hu0 β.1 (fun h => h.2 hB), mul_zero]; exact ip_zero _ _
      · exact (huJ β.1 ⟨br_gen y β hβ, hB⟩).1 y hy β.2 hβ
    have hmatch : ∀ y : C, IsClosed ({y} : Set C) →
        (∃ c : K, ∀ β, wcpaDjPsBr q y β →
          wcpaDjPsInPow β.2
            (wcpaDjPsTw L (ch β.1) (ch y) β.1 ^ e * w β.1 - wcpaDjPsK q β.1 c) 1) ∨
        (∀ β β', wcpaDjPsBr q y β → wcpaDjPsBr q y β' → β = β') := by
      intro y hy
      by_cases hyP : y ∈ P
      · left
        refine ⟨cv y, fun β hβ => ?_⟩
        by_cases hB : B (closure {β.1})
        · have hyx := hxnot y β hβ hB
          rw [hu0 β.1 (fun h => h.2 hB), mul_zero, hcv y, if_neg hyx, map_zero, sub_zero]
          exact ip_zero _ _
        · have hjet := (huJ β.1 ⟨br_gen y β hβ, hB⟩).2 y hyP β.2 hβ (hJmem β)
          have hJc : J ⟨β.1, β.2⟩ - wcpaDjPsK q β.1 (cv y) = 0 := by
            by_cases hyx : y = x
            · have hβx : wcpaDjPsBr q x β := hyx ▸ hβ
              rw [hJ, if_pos hβx, hcv y, if_pos hyx, map_one, sub_self]
            · rw [hJ0 y hy β hβ hyx, hcv y, if_neg hyx, map_zero, sub_self]
          have e1 : wcpaDjPsTw L (ch β.1) (ch y) β.1 ^ e * w β.1 - wcpaDjPsK q β.1 (cv y) =
              (wcpaDjPsTw L (ch β.1) (ch y) β.1 ^ e * w β.1 - J ⟨β.1, β.2⟩) +
                (J ⟨β.1, β.2⟩ - wcpaDjPsK q β.1 (cv y)) := by ring
          rw [e1, hJc, add_zero]
          exact hjet
      · right
        refine hZ₀ y hy (fun hyZ => hyP ?_)
        rw [hP]
        exact Finset.mem_insert_of_mem (Finset.mem_union_left _ (hZmem y hy hyZ))
    obtain ⟨g, hg, hgerm⟩ := wcpa_dj_fva_ss_glue_germs K C q L hss hOK ch hch e w hreg hmatch

    have hcl : ∀ E ∈ irreducibleComponents C, B E → ∀ y ∈ E, ∀ (a : Fin L.m)
        (hy : y ∈ L.V a ⊓ q ⁻¹ᵁ ⊤), IsClosed ({y} : Set C) →
        (C.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ ⊤) y hy).hom (g a) ∈
          IsLocalRing.maximalIdeal (C.presheaf.stalk y) := by
      intro E hE hBE y hyE a hy hycl
      refine (hgerm y hycl a hy).1.mpr (fun β hβ => ?_)
      by_cases hB : B (closure {β.1})
      · rw [hu0 β.1 (fun h => h.2 hB), mul_zero]; exact ip_zero _ _
      · have hne : closure {β.1} ≠ E := fun h => hB (by rw [h]; exact hBE)
        have hyN := hNmem y E hE hBE (hbd E β.1 y hE (br_gen y β hβ) hne (br_sp y β hβ) hyE)
        have hyP : y ∈ P := by
          rw [hP]; exact Finset.mem_insert_of_mem (Finset.mem_union_right _ hyN)
        have hyx : y ≠ x := fun h => hxB E hE hBE (by rw [← h]; exact hyE)
        have hjet := (huJ β.1 ⟨br_gen y β hβ, hB⟩).2 y hyP β.2 hβ (hJmem β)
        have hJ0' : J ⟨β.1, β.2⟩ = 0 := hJ0 y hycl β hβ hyx
        rw [hJ0', sub_zero] at hjet
        exact hjet
    refine ⟨g, hg, fun a hxa hmem => ?_, fun E hE hBE y hyE a hy => ?_⟩
    ·
      obtain ⟨β, hβ⟩ := hBrEx x hx
      have hB : ¬ B (closure {β.1}) := fun hB => hxnot x β hβ hB rfl
      have h1 := ((hgerm x hx a hxa).1.mp hmem) β hβ
      have h2 := (huJ β.1 ⟨br_gen x β hβ, hB⟩).2 x hxP β.2 hβ (hJmem β)
      have hJ1 : J ⟨β.1, β.2⟩ = 1 := by rw [hJ]; exact if_pos hβ
      rw [hJ1] at h2
      have h4 := ip_sub β.2 _ _ 1 h1 h2
      rw [sub_sub_cancel] at h4
      exact ip_one β.2 h4
    ·
      exact hjac (L.V a ⊓ q ⁻¹ᵁ ⊤) (g a) E (isClosed_of_mem_irreducibleComponents E hE)
        (fun y' hy'E hy' hy'cl => hcl E hE hBE y' hy'E a hy' hy'cl) y hyE hy
  exact key _ (Limits.pullback.snd u s) L B hssC hJac hcompfin hnodes hOK hdeg

theorem wcpa_dj_lcc_cm_fibre_separation (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (r : ℕ)
    (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)) (L : wcpaDjCoc Z₁)
    (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) (m : ℕ)
    (hSH : wcpaLccSH W u₁ ε L t m)
    (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Spec (.of ↥W)) :
    wcpaLccSep u₁ ε L m s :=
by
  classical
  obtain ⟨hss, hsec, hOK, hcompat, hbo, -, hm, -, -⟩ := hSH

  have hssX : wcpaDjSemistable (Limits.pullback.snd u₁ s) :=
    wcpa_dj_mm_semistable_basechange (Spec (.of ↥W)) (Spec (.of K)) Z₁ s u₁ hss
  haveI hAff : IsAffineHom (Limits.pullback.fst u₁ s) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback u₁ s).flip
      (isAffineHom_of_isAffine s)

  have hres : ∀ (U : Z₁.Opens) (V V' : (Limits.pullback u₁ s).Opens)
      (hV : V ≤ Limits.pullback.fst u₁ s ⁻¹ᵁ U) (hVV : V' ≤ V) (x : Γ(Z₁, U)),
      ((Limits.pullback u₁ s).presheaf.map (homOfLE hVV).op).hom
          (((Limits.pullback.fst u₁ s).appLE U V hV).hom x) =
        ((Limits.pullback.fst u₁ s).appLE U V' (hVV.trans hV)).hom x := by
    intro U V V' hV hVV x
    change (CommRingCat.Hom.hom ((Limits.pullback.fst u₁ s).appLE U V hV ≫
      (Limits.pullback u₁ s).presheaf.map (homOfLE hVV).op)) x = _
    rw [Scheme.Hom.appLE_map]
  have hpt : ∀ (U U₀ : Z₁.Opens) (V : (Limits.pullback u₁ s).Opens) (h0 : U₀ ≤ U)
      (hV0 : V ≤ Limits.pullback.fst u₁ s ⁻¹ᵁ U₀) (x : Γ(Z₁, U)),
      ((Limits.pullback.fst u₁ s).appLE U₀ V hV0).hom ((Z₁.presheaf.map (homOfLE h0).op).hom x) =
        ((Limits.pullback.fst u₁ s).appLE U V
          (hV0.trans (Scheme.Hom.preimage_mono (Limits.pullback.fst u₁ s) h0))).hom x := by
    intro U U₀ V h0 hV0 x
    change (CommRingCat.Hom.hom (Z₁.presheaf.map (homOfLE h0).op ≫
      (Limits.pullback.fst u₁ s).appLE U₀ V hV0)) x = _
    rw [Scheme.Hom.map_appLE]
  have hmemV : ∀ (a : Fin L.m) (x : ↥(Limits.pullback u₁ s)),
      x ∈ (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ↔
        Limits.pullback.fst u₁ s x ∈ L.V a := fun a x => Scheme.Hom.mem_preimage _
  have hinf : ∀ a b : Fin (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).m,
      (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓
      (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V b ≤
        Limits.pullback.fst u₁ s ⁻¹ᵁ (L.V a ⊓ L.V b) := by
    intro a b x hx
    exact ⟨hx.1, hx.2⟩
  have hg : ∀ a b : Fin (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).m,
      ((wcpaDjCocPull (Limits.pullback.fst u₁ s) L).g a b :
      Γ(Limits.pullback u₁ s, (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓
        (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V b)) =
      ((Limits.pullback.fst u₁ s).appLE (L.V a ⊓ L.V b) _ (hinf a b)).hom
        (L.g a b : Γ(Z₁, L.V a ⊓ L.V b)) := by
    intro a b
    change (CommRingCat.Hom.hom ((Limits.pullback.fst u₁ s).app (L.V a ⊓ L.V b) ≫
      (Limits.pullback u₁ s).presheaf.map (homOfLE _).op)) (L.g a b : Γ(Z₁, L.V a ⊓ L.V b)) = _
    rw [Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]
    rfl

  have hOKX : wcpaDjCocOK (wcpaDjCocPull (Limits.pullback.fst u₁ s) L) := by
    refine ⟨fun a => (hOK.1 a).preimage _, ?_, fun a => ?_, fun a b c => ?_⟩
    · show (⨆ a, Limits.pullback.fst u₁ s ⁻¹ᵁ L.V a) = ⊤
      rw [← Scheme.Hom.preimage_iSup, hOK.2.1, Scheme.Hom.preimage_top]
    · apply Units.ext
      rw [hg, hOK.2.2.1 a]
      simp
    · have hle : (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓
          (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V b ⊓
          (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V c ≤
            Limits.pullback.fst u₁ s ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ L.V c) := by
        intro x hx
        exact ⟨⟨hx.1.1, hx.1.2⟩, hx.2⟩
      have h := congrArg (CommRingCat.Hom.hom ((Limits.pullback.fst u₁ s).appLE
        (L.V a ⊓ L.V b ⊓ L.V c) _ hle)) (hOK.2.2.2 a b c)
      simp only [map_mul, hpt] at h
      rw [hg, hg, hg]
      simp only [hres]
      exact h

  have hcompX : wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst u₁ s) L)
      ((Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤) 1 (wcpaLccPullFam u₁ L s t) := by
    intro a b
    have hle : (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓
        (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V b ⊓ (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤ ≤
          Limits.pullback.fst u₁ s ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ u₁ ⁻¹ᵁ ⊤) := by
      intro x hx
      exact ⟨⟨hx.1.1, hx.1.2⟩, trivial⟩
    have h := congrArg (CommRingCat.Hom.hom ((Limits.pullback.fst u₁ s).appLE
      (L.V a ⊓ L.V b ⊓ u₁ ⁻¹ᵁ ⊤) _ hle)) (hcompat a b)
    simp only [map_mul, map_pow, hpt] at h
    unfold wcpaLccPullFam
    rw [hg]
    simp only [map_pow, hres]
    convert h using 1
    · exact hres _ _ _ _ _ _
    · congr 1
      exact hres _ _ _ _ _ _

  have hanchor : ∀ (i : Fin r) (x : ↥(Limits.pullback u₁ s)) (p : ↥(Spec (.of ↥W))),
      Limits.pullback.fst u₁ s x = ε i p → IsClosed ({x} : Set ↥(Limits.pullback u₁ s)) := by
    intro i x p hx
    have hσ : ε i ≫ u₁ = 𝟙 _ := hsec.1 i
    obtain ⟨y, -, hyu, -⟩ := wcpa_dj_lfcs_section_point (Spec (.of ↥W)) Z₁ u₁ (ε i) K s hσ
    have hp : p = s (Limits.pullback.snd u₁ s x) := by
      have e1 : u₁ (ε i p) = p := by
        rw [← Scheme.Hom.comp_apply, hσ]; rfl
      have e2 : u₁ (Limits.pullback.fst u₁ s x) = s (Limits.pullback.snd u₁ s x) := by
        rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
      rw [← e1, ← hx, e2]
    have hxy : x = y := hyu x (Limits.pullback.snd u₁ s x) (by rw [hx, hp])
    have hw : (s ≫ ε i) ≫ u₁ = 𝟙 _ ≫ s := by
      rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]
    have hσ' : Limits.pullback.lift (s ≫ ε i) (𝟙 _) hw ≫ Limits.pullback.snd u₁ s = 𝟙 _ :=
      Limits.pullback.lift_snd _ _ _
    have hcl := wc_pfam_mc_rational_point_closed K (Limits.pullback u₁ s)
      (Limits.pullback.snd u₁ s) (Limits.pullback.lift (s ≫ ε i) (𝟙 _) hw) hσ'
    have hfl : ∀ c : ↥(Spec (.of K)), Limits.pullback.fst u₁ s
        ((Limits.pullback.lift (s ≫ ε i) (𝟙 _) hw) c) = ε i (s c) := by
      intro c
      rw [← Scheme.Hom.comp_apply, Limits.pullback.lift_fst, Scheme.Hom.comp_apply]
    have hσy : (Limits.pullback.lift (s ≫ ε i) (𝟙 _) hw) (IsLocalRing.closedPoint K) = y :=
      hyu _ (IsLocalRing.closedPoint K) (hfl _)
    rw [hxy, ← hσy]
    exact hcl

  have hbo' : ∀ (a : Fin L.m) (x : ↥(Limits.pullback u₁ s))
      (hx : x ∈ (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓
        (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤),
      x ∈ (Limits.pullback u₁ s).basicOpen (wcpaLccPullFam u₁ L s t a) ↔
        Limits.pullback.fst u₁ s x ∉ ⋃ i, Set.range ⇑(ε i) := by
    intro a x hx
    have e : (Limits.pullback u₁ s).basicOpen (wcpaLccPullFam u₁ L s t a) =
        ((wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓ (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤) ⊓
          Limits.pullback.fst u₁ s ⁻¹ᵁ Z₁.basicOpen (t a) :=
      Scheme.basicOpen_appLE _ _ _ _ _
    have hb := hbo a
    rw [e, TopologicalSpace.Opens.mem_inf, Scheme.Hom.mem_preimage]
    constructor
    · rintro ⟨-, h⟩
      have h' : Limits.pullback.fst u₁ s x ∈ (Z₁.basicOpen (t a) : Set Z₁) := h
      rw [hb] at h'
      exact h'.2
    · intro h
      refine ⟨hx, ?_⟩
      show Limits.pullback.fst u₁ s x ∈ (Z₁.basicOpen (t a) : Set Z₁)
      rw [hb]
      refine ⟨?_, h⟩
      have hxa := ((hmemV a x).mp (TopologicalSpace.Opens.mem_inf.mp hx).1)
      rw [SetLike.mem_coe, TopologicalSpace.Opens.mem_inf, Scheme.Hom.preimage_top]
      exact ⟨hxa, trivial⟩

  have hdeg : ∀ ξ : ↥(Limits.pullback u₁ s),
      closure {ξ} ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
      ¬ wcpaLccAFc u₁ ε s (closure {ξ}) →
      ∀ a : Fin (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).m,
        ξ ∈ (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a →
        1 ≤ wcpaDjCompDeg (wcpaDjCocPull (Limits.pullback.fst u₁ s) L) ξ a := by
    intro ξ hξ hnAF a ha
    have hnc := (wcpa_dj_lsp_generic_smooth K _ (Limits.pullback.snd u₁ s) hssX ξ hξ).1
    refine wcpa_dj_lcc_sep_comp_deg_local K (Limits.pullback u₁ s) (Limits.pullback.snd u₁ s)
      (wcpaDjCocPull (Limits.pullback.fst u₁ s) L) (wcpaLccPullFam u₁ L s t) hssX hOKX hcompX
      ξ hξ ?_ ?_ a ha
    · intro b hb
      have hbx : ξ ∈ (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V b ⊓
          (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤ := by
        rw [TopologicalSpace.Opens.mem_inf, Scheme.Hom.preimage_top]
        exact ⟨hb, trivial⟩
      rw [hbo' b ξ hbx]
      intro hmem
      obtain ⟨i, p, hp⟩ := Set.mem_iUnion.mp hmem
      exact hnc (hanchor i ξ p hp.symm)
    · simp only [wcpaLccAFc, not_forall, not_not] at hnAF
      obtain ⟨b, x₀, hx₀, q₀, hq₀⟩ := hnAF
      refine ⟨x₀, hx₀, fun a' ha' hbas => ?_⟩
      have hx' : x₀ ∈ (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a' ⊓
          (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤ := by
        rw [TopologicalSpace.Opens.mem_inf, Scheme.Hom.preimage_top]
        exact ⟨ha', trivial⟩
      exact (hbo' a' x₀ hx').mp hbas (Set.mem_iUnion.mpr ⟨b, s q₀, hq₀.symm⟩)

  obtain ⟨k₀, hk₀, hsep⟩ := wcpa_dj_lcc_sep_curve_separation (Spec (.of ↥W)) Z₁ u₁ hss K s
    (wcpaDjCocPull (Limits.pullback.fst u₁ s) L) (wcpaLccAFc u₁ ε s) hOKX hdeg

  intro x hx hxAF
  have hle : k₀ ≤ m * k₀ := Nat.le_mul_of_pos_left k₀ hm
  obtain ⟨g, hg', hunit, hvan⟩ := hsep (m * k₀) hle x hx hxAF
  refine ⟨k₀, g, hk₀, hg', ?_, ?_⟩
  · have hx' : x ∈ ⨆ a, (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a := by
      rw [hOKX.2.1]; trivial
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hx'
    have hxa : x ∈ (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓
        (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤ := by
      rw [TopologicalSpace.Opens.mem_inf, Scheme.Hom.preimage_top]
      exact ⟨ha, trivial⟩
    exact ⟨a, hxa, IsLocalRing.notMem_maximalIdeal.mp (hunit a hxa)⟩
  · intro E hE hAF y hy a hya hu
    exact (IsLocalRing.notMem_maximalIdeal.mpr hu) (hvan E hE hAF y hy a hya)

theorem wcpa_dj_lcc_cmfc_ratio_fibre_saturated : ∀ {X Y : Scheme.{u}} (ψ : X ⟶ Y) (D : Y.Opens), Function.Surjective (ψ.app D).hom → ∀ (L' : wcpaDjCoc X) (O : X.Opens) (n : ℕ) (f g : ∀ a : Fin L'.m, Γ(X, L'.V a ⊓ O)), wcpaDjCompat L' O n f → wcpaDjCompat L' O n g → ψ ⁻¹ᵁ D = ⨆ a, X.basicOpen (g a) → ∀ (x x' : X) (a a' : Fin L'.m), ψ x = ψ x' → x ∈ X.basicOpen (g a) → x' ∈ X.basicOpen (g a') → (x ∈ X.basicOpen (f a) ↔ x' ∈ X.basicOpen (f a')) :=
by
  intro X Y ψ D hsurj L' O n f g hf hg hD x x' a a' hψ hx hx'
  classical
  have res : ∀ {A B C : X.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (z : Γ(X, A)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom z) =
        (X.presheaf.map (homOfLE h3).op).hom z := by
    intro A B C h1 h2 h3 z
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have hu : ∀ b, IsUnit ((X.presheaf.map (homOfLE (X.basicOpen_le (g b))).op).hom (g b)) :=
    fun b => X.toRingedSpace.isUnit_res_basicOpen (g b)
  obtain ⟨r, hr⟩ : ∃ r : ∀ b : Fin L'.m, Γ(X, X.basicOpen (g b)),
      ∀ b, r b * (X.presheaf.map (homOfLE (X.basicOpen_le (g b))).op).hom (g b) =
        (X.presheaf.map (homOfLE (X.basicOpen_le (g b))).op).hom (f b) := by
    refine ⟨fun b => (X.presheaf.map (homOfLE (X.basicOpen_le (g b))).op).hom (f b) *
      ((hu b).unit⁻¹ : (Γ(X, X.basicOpen (g b)))ˣ), ?_⟩
    intro b
    rw [mul_assoc, IsUnit.val_inv_mul, mul_one]
  have compat : TopCat.Presheaf.IsCompatible X.sheaf.obj
      (fun b => X.basicOpen (g b)) r := by
    intro a b
    have ra : X.basicOpen (g a) ≤ L'.V a ⊓ O := X.basicOpen_le (g a)
    have rb : X.basicOpen (g b) ≤ L'.V b ⊓ O := X.basicOpen_le (g b)
    have hPb : L'.V a ⊓ L'.V b ⊓ O ≤ L'.V b ⊓ O :=
      le_inf (inf_le_left.trans inf_le_right) inf_le_right
    have hPa : L'.V a ⊓ L'.V b ⊓ O ≤ L'.V a ⊓ O :=
      le_inf (inf_le_left.trans inf_le_left) inf_le_right
    have hPab : L'.V a ⊓ L'.V b ⊓ O ≤ L'.V a ⊓ L'.V b := inf_le_left
    have hQP : X.basicOpen (g a) ⊓ X.basicOpen (g b) ≤ L'.V a ⊓ L'.V b ⊓ O :=
      fun z hz => ⟨⟨(ra hz.1).1, (rb hz.2).1⟩, (ra hz.1).2⟩
    have hQa : X.basicOpen (g a) ⊓ X.basicOpen (g b) ≤ X.basicOpen (g a) := inf_le_left
    have hQb : X.basicOpen (g a) ⊓ X.basicOpen (g b) ≤ X.basicOpen (g b) := inf_le_right
    have key : ∀ s : ∀ c : Fin L'.m, Γ(X, L'.V c ⊓ O), wcpaDjCompat L' O n s →
        (X.presheaf.map (homOfLE (hQb.trans rb)).op).hom (s b) =
        (X.presheaf.map (homOfLE hQP).op).hom ((X.presheaf.map (homOfLE hPab).op).hom
          ((L'.g a b : Γ(X, L'.V a ⊓ L'.V b)) ^ n)) *
        (X.presheaf.map (homOfLE hQa).op).hom ((X.presheaf.map (homOfLE ra).op).hom (s a)) := by
      intro s hs
      have hC : (X.presheaf.map (homOfLE hPb).op).hom (s b) =
          (X.presheaf.map (homOfLE hPab).op).hom ((L'.g a b : Γ(X, L'.V a ⊓ L'.V b)) ^ n) *
          (X.presheaf.map (homOfLE hPa).op).hom (s a) := hs a b
      rw [← res hPb hQP (hQb.trans rb), hC, map_mul, res hPa hQP (hQa.trans ra),
        res ra hQa (hQa.trans ra)]
    have hσ : IsUnit ((X.presheaf.map (homOfLE (hQb.trans rb)).op).hom (g b)) := by
      rw [← res rb hQb (hQb.trans rb)]
      exact (hu b).map _
    show (X.presheaf.map (homOfLE hQa).op).hom (r a) =
      (X.presheaf.map (homOfLE hQb).op).hom (r b)
    rw [← hσ.mul_left_inj]
    calc _ = (X.presheaf.map (homOfLE hQP).op).hom ((X.presheaf.map (homOfLE hPab).op).hom
          ((L'.g a b : Γ(X, L'.V a ⊓ L'.V b)) ^ n)) *
        (X.presheaf.map (homOfLE hQa).op).hom
          (r a * (X.presheaf.map (homOfLE ra).op).hom (g a)) := by
          rw [key g hg, map_mul (X.presheaf.map (homOfLE hQa).op).hom]
          ring
      _ = (X.presheaf.map (homOfLE (hQb.trans rb)).op).hom (f b) := by
          rw [hr a, key f hf]
      _ = _ := by
          rw [← res rb hQb (hQb.trans rb) (f b), ← res rb hQb (hQb.trans rb) (g b),
            ← map_mul (X.presheaf.map (homOfLE hQb).op).hom, hr b]
  obtain ⟨ρ, hρ⟩ : ∃ ρ : Γ(X, ⨆ b, X.basicOpen (g b)), ∀ b,
      (X.presheaf.map (homOfLE (le_iSup (fun b' => X.basicOpen (g b')) b)).op).hom ρ = r b := by
    obtain ⟨ρ, hρ, -⟩ := TopCat.Sheaf.existsUnique_gluing' X.sheaf
      (fun b => X.basicOpen (g b)) (⨆ b, X.basicOpen (g b))
      (fun b => homOfLE (le_iSup (fun b' => X.basicOpen (g b')) b)) le_rfl r compat
    exact ⟨ρ, hρ⟩
  have KP : ∀ (b : Fin L'.m) (z : X), z ∈ X.basicOpen (g b) →
      (z ∈ X.basicOpen ρ ↔ z ∈ X.basicOpen (f b)) := by
    intro b z hz
    have e := congrArg X.basicOpen (hr b)
    rw [← hρ b, Scheme.basicOpen_mul, Scheme.basicOpen_res, Scheme.basicOpen_res,
      Scheme.basicOpen_res] at e
    have e' := congrArg (fun U : X.Opens => z ∈ U) e
    simp only [TopologicalSpace.Opens.mem_inf, eq_iff_iff] at e'
    constructor
    · intro h
      exact (e'.mp ⟨⟨hz, h⟩, hz, hz⟩).2
    · intro h
      exact (e'.mpr ⟨hz, h⟩).1.2
  obtain ⟨h, hh⟩ := hsurj ((X.presheaf.map (homOfLE hD.le).op).hom ρ)
  have hpre := Scheme.preimage_basicOpen ψ h
  rw [hh, Scheme.basicOpen_res] at hpre
  have E : ∀ z : X, z ∈ ψ ⁻¹ᵁ D → (z ∈ X.basicOpen ρ ↔ ψ z ∈ Y.basicOpen h) := by
    intro z hz
    rw [← Scheme.Hom.mem_preimage, hpre, TopologicalSpace.Opens.mem_inf]
    exact ⟨fun h1 => ⟨hz, h1⟩, fun h1 => h1.2⟩
  have hxD : x ∈ ψ ⁻¹ᵁ D := by
    rw [hD]; exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hx⟩
  have hx'D : x' ∈ ψ ⁻¹ᵁ D := by
    rw [hD]; exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a', hx'⟩
  rw [← KP a x hx, ← KP a' x' hx', E x hxD, E x' hx'D, hψ]

theorem wcpa_dj_lcc_cmfc_p1_into_affine_const : ∀ {X Y : Scheme.{u}} (ψ : X ⟶ Y) (D : Y.Opens), IsAffineOpen D → ∀ (K : Type u) [Field K] (Er : Scheme.{u}) (ι : Er ⟶ X) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), (∀ w : Er, ψ (ι w) ∈ D) → ∀ w w' : Er, ψ (ι w) = ψ (ι w') :=
by
  intro X Y ψ D hD K _ Er ι θ hall w w'

  have charts : ∀ (A : Type u) [CommRing A], ∃ (j c : Spec (.of (Polynomial A)) ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) A) MvPolynomial.gradedAlgebra), IsOpenImmersion j ∧ IsOpenImmersion c ∧ IsAffineHom j ∧ (∀ x, x ∈ Set.range j ∨ x ∈ Set.range c) ∧ IsPullback (Spec.map (CommRingCat.ofHom (Polynomial.eval₂RingHom (algebraMap A (LaurentPolynomial A)) (LaurentPolynomial.T (-1))))) (Spec.map (CommRingCat.ofHom (Polynomial.toLaurent : Polynomial A →+* LaurentPolynomial A))) j c := by
    intro A _
    let 𝒜 : ℕ → Submodule A (MvPolynomial (Fin 2) A) := MvPolynomial.homogeneousSubmodule (Fin 2) A
    let _inst𝒜 : GradedAlgebra 𝒜 := MvPolynomial.gradedAlgebra
    have fin2 : ∀ a b c : Fin 2, a ≠ b → c ≠ a → c = b := by decide
    have hX : ∀ i : Fin 2, (MvPolynomial.X i : MvPolynomial (Fin 2) A) ∈ 𝒜 1 := fun i =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X A i)
    have h11 : ∀ k : Fin 2, (MvPolynomial.X k : MvPolynomial (Fin 2) A) ∈ 𝒜 (1 • 1) := fun k => by
      rw [smul_eq_mul, mul_one]; exact hX k
    have s1 : ∀ {T : Type u} [CommRing T] (f : A →+* T) (g : Fin 2 → T) (c : T)
        (φ : MvPolynomial (Fin 2) A) (n : ℕ), φ.IsHomogeneous n →
        MvPolynomial.eval₂ f (fun i => c * g i) φ = c ^ n * MvPolynomial.eval₂ f g φ := by
      intro T _ f g c φ n hφ
      conv_lhs => rw [φ.as_sum]
      conv_rhs => rw [φ.as_sum]
      rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun d hd => ?_)
      rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
      have hdeg : ∑ i ∈ d.support, d i = n := by
        have := hφ (MvPolynomial.mem_support_iff.mp hd)
        simpa [Finsupp.weight_apply, Finsupp.sum] using this
      simp only [Finsupp.prod, mul_pow, Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
      ring
    have hval0 : ∀ (f : MvPolynomial (Fin 2) A) (a : ↥(𝒜 0)),
        (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers f) a).val =
          algebraMap (MvPolynomial (Fin 2) A) (Localization.Away f) (a : MvPolynomial (Fin 2) A) := by
      intro f a
      rfl
    have hcoe0 : ∀ r : A, ((algebraMap A (𝒜 0) r : ↥(𝒜 0)) : MvPolynomial (Fin 2) A) = MvPolynomial.C r := by
      intro r
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    have chart : ∀ i k : Fin 2, i ≠ k → ∃ e : Polynomial A ≃+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i),
        (∀ r : A, e (Polynomial.C r) = HomogeneousLocalization.fromZeroRingHom 𝒜
          (Submonoid.powers (MvPolynomial.X i)) (algebraMap A (𝒜 0) r)) ∧
        e Polynomial.X = HomogeneousLocalization.Away.mk 𝒜 (hX i) 1 (MvPolynomial.X k) (h11 k) := by
      intro i k hik
      obtain ⟨κ, hκ⟩ : ∃ κ : A →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i),
          κ = (HomogeneousLocalization.fromZeroRingHom 𝒜 (Submonoid.powers (MvPolynomial.X i))).comp
            (algebraMap A (𝒜 0)) := ⟨_, rfl⟩
      obtain ⟨α, hα⟩ : ∃ α : Polynomial A →+* HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i),
          α = Polynomial.eval₂RingHom κ
            (HomogeneousLocalization.Away.mk 𝒜 (hX i) 1 (MvPolynomial.X k) (h11 k)) := ⟨_, rfl⟩
      obtain ⟨ψ, hψ⟩ : ∃ ψ : MvPolynomial (Fin 2) A →+* Polynomial A,
          ψ = MvPolynomial.eval₂Hom Polynomial.C (fun j => if j = i then 1 else Polynomial.X) := ⟨_, rfl⟩
      have hψi : ψ (MvPolynomial.X i) = 1 := by rw [hψ, MvPolynomial.eval₂Hom_X', if_pos rfl]
      have hψk : ψ (MvPolynomial.X k) = Polynomial.X := by
        rw [hψ, MvPolynomial.eval₂Hom_X', if_neg (Ne.symm hik)]
      have hψC : ∀ r, ψ (MvPolynomial.C r) = Polynomial.C r := by
        intro r; rw [hψ, MvPolynomial.eval₂Hom_C]
      have hψv : ψ (MvPolynomial.X i) * 1 = 1 := by rw [hψi, mul_one]
      have hu : IsUnit (ψ (MvPolynomial.X i)) := by rw [hψi]; exact isUnit_one
      obtain ⟨χ, hχ⟩ : ∃ χ : HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i) →+* Polynomial A,
          χ = (Localization.awayLift ψ (MvPolynomial.X i) hu).comp
            (algebraMap (HomogeneousLocalization.Away 𝒜 (MvPolynomial.X i))
              (Localization.Away (MvPolynomial.X i : MvPolynomial (Fin 2) A))) := ⟨_, rfl⟩
      have hχmk : ∀ (n : ℕ) (a : MvPolynomial (Fin 2) A) (ha : a ∈ 𝒜 (n • 1)),
          χ (HomogeneousLocalization.Away.mk 𝒜 (hX i) n a ha) = ψ a := by
        intro n a ha
        rw [hχ, RingHom.comp_apply, HomogeneousLocalization.algebraMap_apply,
          HomogeneousLocalization.Away.val_mk, Localization.awayLift_mk ψ (MvPolynomial.X i) a 1 hψv n,
