        (wcCbcmOfFam (wcpaDjCocPull φ' L₀) (q' ⁻¹ᵁ ⊤) t) = 0 := (h7.1 t).mp ht
    obtain ⟨T0, hT0⟩ : ∃ T0 : wcCbcmC (wcpaDjCocPull φ' L₀) ⊤ 0,
        T0 = wcCbcmOfFam (wcpaDjCocPull φ' L₀) (q' ⁻¹ᵁ ⊤) t := ⟨_, rfl⟩
    have h0' : wcCbcmD (wcpaDjCocPull φ' L₀) ⊤ e 0 T0 = 0 := by rw [hT0]; exact h0
    have e1 : Θ0 (Θ0.symm T0) = T0 := Θ0.apply_symm_apply T0
    have hx : (d 0).rTensor R (Θ0.symm T0) = 0 := by
