    obtain ⟨n, y, z, hyz, hsum⟩ := hCF' x₀ hx₀
    choose σ hσ using fun r => h1 (y r) (hyz r).1
    choose υ hυ using fun r => h2 (z r) (hyz r).2
    refine ⟨fun i j => ∑ r, σ r i * υ r j, ?_⟩
    have key : ∀ a, x₀ a = ∑ l, wcpaLccScal g (L'.V a ⊓ g ⁻¹ᵁ ⊤)
