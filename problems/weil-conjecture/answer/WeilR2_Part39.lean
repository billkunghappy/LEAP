  have F1 : f ≫ Limits.pullback.fst g α = Limits.pullback.fst g γ := Limits.pullback.lift_fst _ _ _
  have F2 : f ≫ Limits.pullback.snd g α = Limits.pullback.snd g γ ≫ β :=
    Limits.pullback.lift_snd _ _ _
  haveI hAY : IsAffineHom (Limits.pullback.fst g α) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback g α).flip
      inferInstance
  haveI hAZ : IsAffineHom (Limits.pullback.fst g γ) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback g γ).flip
      inferInstance
  haveI : QuasiCompact (f ≫ Limits.pullback.fst g α) := by rw [F1]; infer_instance
  haveI : QuasiCompact f := QuasiCompact.of_comp f (Limits.pullback.fst g α)
  refine ⟨f.image, f.imageι, inferInstance, inferInstance, ?_⟩
  intro W hW
  letI : Algebra A Γ(R, W) := ((R.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op).hom.comp
    (g.appTop.hom.comp (Scheme.ΓSpecIso (.of A)).inv.hom)).toAlgebra
  obtain ⟨eY, heY1, heY2⟩ := s2 A Γ(R, W) C _ _ _ (s1 A C R g W hW)
  obtain ⟨eZ, heZ1, heZ2⟩ := s2 A Γ(R, W) (Polynomial A) _ _ _ (s1 A (Polynomial A) R g W hW)
  have hOf : Limits.pullback.fst g γ ⁻¹ᵁ W = f ⁻¹ᵁ (Limits.pullback.fst g α ⁻¹ᵁ W) := by
    rw [← F1]; rfl
  have hO : Limits.pullback.fst g γ ⁻¹ᵁ W ≤
      f.toImage ⁻¹ᵁ (f.imageι ⁻¹ᵁ (Limits.pullback.fst g α ⁻¹ᵁ W)) := by
    have key : ∀ k : Limits.pullback g γ ⟶ Limits.pullback g α, k = f →
        f ⁻¹ᵁ (Limits.pullback.fst g α ⁻¹ᵁ W) ≤ k ⁻¹ᵁ (Limits.pullback.fst g α ⁻¹ᵁ W) := by
      rintro k rfl; exact le_rfl
    exact hOf.le.trans (key (f.toImage ≫ f.imageι) (Scheme.Hom.toImage_imageι f))
  obtain ⟨hinj, hsurj, hcomp⟩ := s3 _ _ f (Limits.pullback.fst g α ⁻¹ᵁ W)
    (hW.preimage (Limits.pullback.fst g α)) _ hO hOf
  obtain ⟨hs5a, hs5b⟩ := s5 _ _ _ _ _ f (Limits.pullback.fst g α) (Limits.pullback.fst g γ)
    (Limits.pullback.snd g α) (Limits.pullback.snd g γ) β F1 F2 W hOf.le
  have hβ : ∀ c : C, β.appTop ((Scheme.ΓSpecIso (.of C)).inv c) =
      (Scheme.ΓSpecIso (.of (Polynomial A))).inv (ψ c) := by
    intro c
    have := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ψ.toRingHom)
    exact (ConcreteCategory.congr_hom this c).symm
  have hρ : ∀ s : Γ(R, W), ((f.imageι ≫ Limits.pullback.fst g α).app W).hom s =
      (f.imageι.app (Limits.pullback.fst g α ⁻¹ᵁ W)).hom (eY (s ⊗ₜ[A] (1 : C))) := by
    intro s
    rw [heY1]; rfl
  have hχ : ∀ c : C, wcCnSigma (f.imageι ≫ Limits.pullback.snd g α) ((f.imageι ≫ Limits.pullback.fst g α) ⁻¹ᵁ W) c =
      (f.imageι.app (Limits.pullback.fst g α ⁻¹ᵁ W)).hom (eY ((1 : Γ(R, W)) ⊗ₜ[A] c)) := by
    intro c
    rw [heY2]
    exact s6 _ _ _ f.imageι (Limits.pullback.snd g α) (Limits.pullback.fst g α ⁻¹ᵁ W) _
  refine s4 A C ψ Γ(R, W) _ _ _ eY eZ (f.imageι.app (Limits.pullback.fst g α ⁻¹ᵁ W)).hom
    (f.toImage.appLE _ _ hO).hom _ _ hsurj hinj hρ hχ ?_ ?_
  · intro s
    calc _ = (f.toImage.appLE _ _ hO).hom ((f.imageι.app (Limits.pullback.fst g α ⁻¹ᵁ W)).hom
          (eY (s ⊗ₜ[A] (1 : C)))) := congrArg _ (hρ s)
      _ = _ := by rw [heY1, hcomp, hs5a, heZ1]
  · intro c
    calc _ = (f.toImage.appLE _ _ hO).hom ((f.imageι.app (Limits.pullback.fst g α ⁻¹ᵁ W)).hom
          (eY ((1 : Γ(R, W)) ⊗ₜ[A] c))) := congrArg _ (hχ c)
      _ = (f.appLE _ _ hOf.le).hom (((Limits.pullback g α).presheaf.map (homOfLE (le_top : Limits.pullback.fst g α ⁻¹ᵁ W ≤ ⊤)).op).hom ((Limits.pullback.snd g α).appTop.hom ((Scheme.ΓSpecIso (.of C)).inv.hom c))) := by
          rw [heY2, hcomp]; rfl
      _ = ((Limits.pullback g γ).presheaf.map (homOfLE (le_top : Limits.pullback.fst g γ ⁻¹ᵁ W ≤ ⊤)).op).hom ((Limits.pullback.snd g γ).appTop.hom (β.appTop.hom ((Scheme.ΓSpecIso (.of C)).inv.hom c))) := hs5b _
      _ = _ := by rw [hβ, heZ2]; rfl

theorem wcpa_dj_lcp_us_gm_rees_gen : ∀ (A R : Type u) [CommRing A] [CommRing R] (σ : A →+* R) (I : Ideal A) (r : ℕ) (b : Fin r → A), Ideal.span (Set.range b) = I → ∀ f : Polynomial R, f ∈ reesAlgebra (Ideal.map σ I) ↔ f ∈ Subring.closure (Set.range (Polynomial.C : R →+* Polynomial R) ∪ Set.range (fun c : MvPolynomial (Fin r) A => Polynomial.map σ (MvPolynomial.aeval (fun j => Polynomial.C (b j) * Polynomial.X) c))) :=
by
  intro A R _ _ σ I r b hb f
  have hbJ : ∀ j, σ (b j) ∈ Ideal.map σ I := fun j =>
    Ideal.mem_map_of_mem σ (hb ▸ Ideal.subset_span ⟨j, rfl⟩)
  have hX : ∀ j, Polynomial.map σ (MvPolynomial.aeval (fun j => Polynomial.C (b j) * Polynomial.X)
      (MvPolynomial.X j : MvPolynomial (Fin r) A)) = Polynomial.monomial 1 (σ (b j)) := by
    intro j
    rw [MvPolynomial.aeval_X, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X,
      Polynomial.C_mul_X_eq_monomial]
  have hCa : ∀ a : A, Polynomial.map σ (MvPolynomial.aeval (fun j => Polynomial.C (b j) * Polynomial.X)
      (MvPolynomial.C a : MvPolynomial (Fin r) A)) = Polynomial.C (σ a) := by
    intro a
    rw [MvPolynomial.aeval_C, Polynomial.algebraMap_apply, Algebra.algebraMap_self,
      RingHom.id_apply, Polynomial.map_C]
  have hCrees : ∀ y : R, Polynomial.C y ∈ reesAlgebra (Ideal.map σ I) := by
    intro y
    rw [← Polynomial.monomial_zero_left]
    apply reesAlgebra.monomial_mem.mpr
    simp
  have hM1 : ∀ x ∈ Ideal.map σ I, Polynomial.monomial 1 x ∈ Subring.closure
      (Set.range (Polynomial.C : R →+* Polynomial R) ∪ Set.range (fun c : MvPolynomial (Fin r) A =>
        Polynomial.map σ (MvPolynomial.aeval (fun j => Polynomial.C (b j) * Polynomial.X) c))) := by
    intro x hx
    rw [← hb, Ideal.map_span] at hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨z, ⟨j, rfl⟩, rfl⟩ := hy
      rw [← hX j]
      exact Subring.subset_closure (Set.mem_union_right _ ⟨_, rfl⟩)
    | zero => rw [map_zero]; exact zero_mem _
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | smul a x _ hx =>
      rw [smul_eq_mul, ← Polynomial.C_mul_monomial]
      exact mul_mem (Subring.subset_closure (Set.mem_union_left _ ⟨a, rfl⟩)) hx
  constructor
  · intro hf
    rw [← adjoin_monomial_eq_reesAlgebra, ← Subalgebra.mem_toSubring,
      Algebra.adjoin_eq_ring_closure] at hf
    refine (Subring.closure_le.mpr ?_) hf
    rintro g (⟨y, rfl⟩ | ⟨x, hx, rfl⟩)
    · exact Subring.subset_closure (Set.mem_union_left _ ⟨y, rfl⟩)
    · exact hM1 x hx
  · intro hf
    have hle : Subring.closure (Set.range (Polynomial.C : R →+* Polynomial R) ∪
        Set.range (fun c : MvPolynomial (Fin r) A =>
          Polynomial.map σ (MvPolynomial.aeval (fun j => Polynomial.C (b j) * Polynomial.X) c)))
        ≤ (reesAlgebra (Ideal.map σ I)).toSubring := by
      rw [Subring.closure_le]
      rintro g (⟨y, rfl⟩ | ⟨c, rfl⟩)
      · exact hCrees y
      · induction c using MvPolynomial.induction_on with
        | C a => simp only [SetLike.mem_coe, Subalgebra.mem_toSubring]; rw [hCa]; exact hCrees _
        | add p q hp hq =>
          simp only [SetLike.mem_coe, Subalgebra.mem_toSubring] at hp hq ⊢
          rw [map_add, Polynomial.map_add]; exact add_mem hp hq
        | mul_X p j hp =>
          simp only [SetLike.mem_coe, Subalgebra.mem_toSubring] at hp ⊢
          rw [map_mul, Polynomial.map_mul, hX]
          exact mul_mem hp (reesAlgebra.monomial_mem.mpr (by rw [pow_one]; exact hbJ j))
    exact hle hf

theorem wcpa_dj_lcp_us_gm_rees_ker : ∀ (A R : Type u) [CommRing A] [CommRing R] (σ : A →+* R) (I : Ideal A) (z : reesAlgebra (Ideal.map σ I)), z ∈ Ideal.map ((algebraMap R (reesAlgebra (Ideal.map σ I))).comp σ) I ↔ ∀ k, (z : Polynomial R).coeff k ∈ Ideal.map σ (I ^ (k + 1)) :=
by
  intro A R _ _ σ I z
  have hι : ∀ x : R, ((algebraMap R (reesAlgebra (Ideal.map σ I)) x : reesAlgebra (Ideal.map σ I)) :
      Polynomial R) = Polynomial.C x := fun x => rfl
  simp only [Ideal.map_pow]
  rw [← Ideal.map_map]
  constructor
  · intro hz
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hz
    · rintro _ ⟨x, hx, rfl⟩ k
      rw [hι, Polynomial.coeff_C]
      split_ifs with h
      · subst h; simpa using hx
      · exact Submodule.zero_mem _
    · intro k; simp
    · intro x y _ _ hx hy k
      rw [Subalgebra.coe_add, Polynomial.coeff_add]
      exact add_mem (hx k) (hy k)
    · intro w x _ hx k
      rw [smul_eq_mul, Subalgebra.coe_mul, Polynomial.coeff_mul]
      apply Ideal.sum_mem
      rintro ⟨i, j⟩ hij
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hij
      have hw : (w : Polynomial R).coeff i ∈ Ideal.map σ I ^ i :=
        (mem_reesAlgebra_iff _ _).mp w.2 i
      have e : Ideal.map σ I ^ (k + 1) = Ideal.map σ I ^ i * Ideal.map σ I ^ (j + 1) := by
        rw [← pow_add]; congr 1; simp only at hij; omega
      rw [e]
      exact Ideal.mul_mem_mul hw (hx j)
  · intro hz
    have hmono : ∀ k, ∀ x ∈ Ideal.map σ I ^ (k + 1),
        ∃ w ∈ Ideal.map (algebraMap R (reesAlgebra (Ideal.map σ I))) (Ideal.map σ I),
        (w : Polynomial R) = Polynomial.monomial k x := by
      intro k x hx
      rw [pow_succ'] at hx
      refine Submodule.mul_induction_on hx ?_ ?_
      · intro r hr s hs
        refine ⟨algebraMap R (reesAlgebra (Ideal.map σ I)) r *
          ⟨Polynomial.monomial k s, reesAlgebra.monomial_mem.mpr hs⟩,
          Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hr), ?_⟩
        rw [Subalgebra.coe_mul, hι]
        exact Polynomial.C_mul_monomial
      · rintro x y ⟨w, hw, hwx⟩ ⟨w', hw', hwy⟩
        exact ⟨w + w', add_mem hw hw', by rw [Subalgebra.coe_add, hwx, hwy, map_add]⟩
    choose w hw hwz using fun k => hmono k _ (hz k)
    have hzs : z = ∑ k ∈ (z : Polynomial R).support, w k := by
      apply Subtype.ext
      rw [AddSubmonoidClass.coe_finsetSum]
      conv_lhs => rw [(z : Polynomial R).as_sum_support]
      exact Finset.sum_congr rfl (fun k _ => (hwz k).symm)
    rw [hzs]
    exact Ideal.sum_mem _ (fun k _ => hw k)

theorem wcpa_dj_lcp_us_gm_spec_square : ∀ (A K : Type u) [CommRing A] [CommRing K] (f : A →+* K) (r : ℕ), IsPullback (Spec.map (CommRingCat.ofHom (MvPolynomial.map f : MvPolynomial (Fin r) A →+* MvPolynomial (Fin r) K))) (Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin r) K)))) (Spec.map (CommRingCat.ofHom (algebraMap A (MvPolynomial (Fin r) A)))) (Spec.map (CommRingCat.ofHom f)) :=
by
  intro A K _ _ f r
  letI : Algebra A K := f.toAlgebra
  letI : Algebra (MvPolynomial (Fin r) A) (MvPolynomial (Fin r) K) :=
    MvPolynomial.algebraMvPolynomial
  exact AlgebraicGeometry.isPullback_SpecMap_of_isPushout _ _ _ _
    (CommRingCat.isPushout_of_isPushout A (MvPolynomial (Fin r) A) K (MvPolynomial (Fin r) K))

theorem wcpa_dj_lcp_us_gm_closed_imm : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (X Y₀ 𝓡 : Scheme.{u}) (h : X ⟶ Spec (.of B)) (i : Y₀ ⟶ X) (h₀ : Y₀ ⟶ Spec (.of (IsLocalRing.ResidueField B))) (r : ℕ) (j : 𝓡 ⟶ Limits.pullback h (Spec.map (CommRingCat.ofHom (algebraMap B (MvPolynomial (Fin r) B))))), IsPullback i h₀ h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) → IsPullback (Spec.map (CommRingCat.ofHom (MvPolynomial.map (IsLocalRing.residue B) : MvPolynomial (Fin r) B →+* MvPolynomial (Fin r) (IsLocalRing.ResidueField B)))) (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B) (MvPolynomial (Fin r) (IsLocalRing.ResidueField B))))) (Spec.map (CommRingCat.ofHom (algebraMap B (MvPolynomial (Fin r) B)))) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) → IsClosedImmersion j → ∃ ι : Limits.pullback ((j ≫ Limits.pullback.fst _ _) ≫ h) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) ⟶ Limits.pullback h₀ (Spec.map (CommRingCat.ofHom (algebraMap (IsLocalRing.ResidueField B) (MvPolynomial (Fin r) (IsLocalRing.ResidueField B))))), IsClosedImmersion ι ∧ ι ≫ Limits.pullback.fst _ _ ≫ i = Limits.pullback.fst _ _ ≫ j ≫ Limits.pullback.fst _ _ :=
by
  have gen : ∀ {Sk SB SA SAk X Y₀ R : Scheme.{u}} (h : X ⟶ SB) (i : Y₀ ⟶ X) (h₀ : Y₀ ⟶ Sk)
      (ρ : Sk ⟶ SB) (α : SA ⟶ SB) (αk : SAk ⟶ Sk) (μ : SAk ⟶ SA)
      (j : R ⟶ Limits.pullback h α), IsPullback i h₀ h ρ → IsPullback μ αk α ρ →
      IsClosedImmersion j →
      ∃ ι : Limits.pullback ((j ≫ Limits.pullback.fst _ _) ≫ h) ρ ⟶ Limits.pullback h₀ αk,
        IsClosedImmersion ι ∧
        ι ≫ Limits.pullback.fst _ _ ≫ i = Limits.pullback.fst _ _ ≫ j ≫ Limits.pullback.fst _ _ := by
    intro Sk SB SA SAk X Y₀ R h i h₀ ρ α αk μ j hpb hsq hj
    have hQ := Limits.pullback.condition (f := (j ≫ Limits.pullback.fst h α) ≫ h) (g := ρ)
    have hP := Limits.pullback.condition (f := h) (g := α)
    have hT := Limits.pullback.condition (f := h₀) (g := αk)
    have w₁ : (Limits.pullback.fst ((j ≫ Limits.pullback.fst h α) ≫ h) ρ ≫ j ≫
        Limits.pullback.fst h α) ≫ h =
          Limits.pullback.snd ((j ≫ Limits.pullback.fst h α) ≫ h) ρ ≫ ρ := by
      rw [← hQ]; simp only [Category.assoc]
    set a := hpb.lift _ _ w₁ with ha
    have ha₁ := hpb.lift_fst _ _ w₁
    have ha₂ := hpb.lift_snd _ _ w₁
    have w₂ : (Limits.pullback.fst ((j ≫ Limits.pullback.fst h α) ≫ h) ρ ≫ j ≫
        Limits.pullback.snd h α) ≫ α =
          Limits.pullback.snd ((j ≫ Limits.pullback.fst h α) ≫ h) ρ ≫ ρ := by
      rw [← hQ]; simp only [Category.assoc, hP]
    set b := hsq.lift _ _ w₂ with hb
    have hb₁ := hsq.lift_fst _ _ w₂
    have hb₂ := hsq.lift_snd _ _ w₂
    have w₃ : a ≫ h₀ = b ≫ αk := ha₂.trans hb₂.symm
    set ι := Limits.pullback.lift a b w₃ with hιdef
    have hι₁ : ι ≫ Limits.pullback.fst h₀ αk = a := Limits.pullback.lift_fst _ _ _
    have hι₂ : ι ≫ Limits.pullback.snd h₀ αk = b := Limits.pullback.lift_snd _ _ _
    have w₅ : (Limits.pullback.fst h₀ αk ≫ i) ≫ h = (Limits.pullback.snd h₀ αk ≫ μ) ≫ α := by
      rw [Category.assoc, hpb.w, ← Category.assoc, hT, Category.assoc, ← hsq.w, Category.assoc]
    set c := Limits.pullback.lift _ _ w₅ with hcdef
    have hc₁ : c ≫ Limits.pullback.fst h α = Limits.pullback.fst h₀ αk ≫ i :=
      Limits.pullback.lift_fst _ _ _
    have hc₂ : c ≫ Limits.pullback.snd h α = Limits.pullback.snd h₀ αk ≫ μ :=
      Limits.pullback.lift_snd _ _ _
    have H1 := (IsPullback.of_hasPullback h₀ αk).paste_horiz hpb
    have key1 : ∀ (f' : Limits.pullback h₀ αk ⟶ X) (g' : SAk ⟶ SB),
        f' = Limits.pullback.fst h₀ αk ≫ i → g' = αk ≫ ρ →
        IsPullback f' (Limits.pullback.snd h₀ αk) h g' := by
      rintro _ _ rfl rfl; exact H1
    have H2 : IsPullback c (Limits.pullback.snd h₀ αk) (Limits.pullback.snd h α) μ :=
      IsPullback.of_right (key1 _ _ hc₁ hsq.w) hc₂ (IsPullback.of_hasPullback h α)
    have H3 := H2.paste_vert hsq
    have hp : Limits.pullback.fst ((j ≫ Limits.pullback.fst h α) ≫ h) ρ ≫ j = ι ≫ c := by
      have e1 : ι ≫ Limits.pullback.fst h₀ αk ≫ i = Limits.pullback.fst
          ((j ≫ Limits.pullback.fst h α) ≫ h) ρ ≫ j ≫ Limits.pullback.fst h α := by
        rw [← Category.assoc, hι₁, ha₁]
      have e2 : ι ≫ Limits.pullback.snd h₀ αk ≫ μ = Limits.pullback.fst
          ((j ≫ Limits.pullback.fst h α) ≫ h) ρ ≫ j ≫ Limits.pullback.snd h α := by
        rw [← Category.assoc, hι₂, hb₁]
      apply Limits.pullback.hom_ext
      · exact (Category.assoc _ _ _).trans (e1.symm.trans
          ((congrArg (ι ≫ ·) hc₁.symm).trans (Category.assoc _ _ _).symm))
      · exact (Category.assoc _ _ _).trans (e2.symm.trans
          ((congrArg (ι ≫ ·) hc₂.symm).trans (Category.assoc _ _ _).symm))
    have key2 : ∀ (g' : Limits.pullback ((j ≫ Limits.pullback.fst h α) ≫ h) ρ ⟶ Sk)
        (f' : R ⟶ SB), g' = Limits.pullback.snd ((j ≫ Limits.pullback.fst h α) ≫ h) ρ →
        f' = (j ≫ Limits.pullback.fst h α) ≫ h →
        IsPullback (Limits.pullback.fst ((j ≫ Limits.pullback.fst h α) ≫ h) ρ) g' f' ρ := by
      rintro _ _ rfl rfl; exact IsPullback.of_hasPullback _ _
    have S0 : IsPullback (Limits.pullback.fst ((j ≫ Limits.pullback.fst h α) ≫ h) ρ)
        (ι ≫ (Limits.pullback.snd h₀ αk ≫ αk)) (j ≫ (Limits.pullback.snd h α ≫ α)) ρ := by
      apply key2
      · rw [← Category.assoc, hι₂, hb₂]
      · rw [Category.assoc, hP]
    have H4 := IsPullback.of_bot S0 hp H3
    refine ⟨ι, MorphismProperty.of_isPullback (P := @IsClosedImmersion) H4 hj, ?_⟩
    rw [← Category.assoc, hι₁, ha₁]
  intro B _ _ X Y₀ 𝓡 h i h₀ r j hpb hsq hj
  exact gen h i h₀ _ _ _ _ j hpb hsq hj

theorem wcpa_dj_lcp_us_gm_theta : ∀ (B : Type u) [CommRing B] (I : Ideal B) (C : Type u) [CommRing C] [Algebra B C] (ψ : C →ₐ[B] Polynomial B) (X 𝓡 : Scheme.{u}) (h : X ⟶ Spec (.of B)) (pr : 𝓡 ⟶ X) (w : 𝓡 ⟶ Spec (.of C)), (∀ W : X.Opens, IsAffineOpen W → ∃ θ : Γ(𝓡, pr ⁻¹ᵁ W) →+* Polynomial Γ(X, W), Function.Injective θ ∧ (∀ s : Γ(X, W), θ ((pr.app W).hom s) = Polynomial.C s) ∧ (∀ c : C, θ (wcCnSigma w (pr ⁻¹ᵁ W) c) = Polynomial.map (wcCnSigma h W) (ψ c)) ∧ ∀ z : Γ(𝓡, pr ⁻¹ᵁ W), z ∈ Subring.closure (Set.range (pr.app W).hom ∪ Set.range (wcCnSigma w (pr ⁻¹ᵁ W)))) → (∀ W : X.Opens, IsAffineOpen W → ∀ f : Polynomial Γ(X, W), f ∈ reesAlgebra (Ideal.map (wcCnSigma h W) I) ↔ f ∈ Subring.closure (Set.range (Polynomial.C : Γ(X, W) →+* Polynomial Γ(X, W)) ∪ Set.range (fun c : C => Polynomial.map (wcCnSigma h W) (ψ c)))) → ∃ Θ : ∀ O : X.Opens, IsAffineOpen O → (Γ(𝓡, pr ⁻¹ᵁ O) ≃+* reesAlgebra (Ideal.map (wcCnSigma h O) I)), (∀ (O : X.Opens) (hO : IsAffineOpen O) (s : Γ(X, O)), (Θ O hO ((pr.app O).hom s) : Polynomial Γ(X, O)) = Polynomial.C s) ∧ (∀ (O : X.Opens) (hO : IsAffineOpen O) (c : B), (Θ O hO (wcCnSigma (pr ≫ h) (pr ⁻¹ᵁ O) c) : Polynomial Γ(X, O)) = Polynomial.C (wcCnSigma h O c)) ∧ ∀ (O O' : X.Opens) (hO : IsAffineOpen O) (hO' : IsAffineOpen O') (hle : O' ≤ O) (u : Γ(𝓡, pr ⁻¹ᵁ O)), (Θ O' hO' ((𝓡.presheaf.map (homOfLE (Scheme.Hom.preimage_mono pr hle)).op).hom u) : Polynomial Γ(X, O')) = Polynomial.map (X.presheaf.map (homOfLE hle).op).hom (Θ O hO u : Polynomial Γ(X, O)) :=
by
  intro B _ I C _ _ ψ X 𝓡 h pr w hθ hrees
  classical

  have sigma_res : ∀ {R : Type u} [CommRing R] {Z : Scheme.{u}} (g : Z ⟶ Spec (.of R))
      (U U' : Z.Opens) (hle : U' ≤ U) (c : R),
      (Z.presheaf.map (homOfLE hle).op).hom (wcCnSigma g U c) = wcCnSigma g U' c := by
    intro R _ Z g U U' hle c
    simp only [wcCnSigma, RingHom.comp_apply]
    rw [← RingHom.comp_apply (Z.presheaf.map (homOfLE hle).op).hom, ← CommRingCat.hom_comp,
      ← Functor.map_comp]
    rfl

  have app_res : ∀ {X Y : Scheme.{u}} (f : Y ⟶ X) (O O' : X.Opens) (hle : O' ≤ O) (s : Γ(X, O)),
      (Y.presheaf.map (homOfLE (Scheme.Hom.preimage_mono f hle)).op).hom ((f.app O).hom s) =
        (f.app O').hom ((X.presheaf.map (homOfLE hle).op).hom s) := by
    intro X Y f O O' hle s
    have e := Scheme.Hom.naturality f (homOfLE hle).op
    have e2 := congrArg (fun φ => φ.hom s) e
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e2
    exact e2.symm

  have sigma_comp : ∀ (O : X.Opens) (c : B),
      wcCnSigma (pr ≫ h) (pr ⁻¹ᵁ O) c = (pr.app O).hom (wcCnSigma h O c) := by
    intro O c
    simp only [wcCnSigma, RingHom.comp_apply, Scheme.Hom.comp_appTop, CommRingCat.hom_comp]
    exact app_res pr ⊤ O le_top _
  choose θ hinj hC hσ hgen using hθ

  have key : ∀ (O : X.Opens) (hO : IsAffineOpen O),
      ∃ e : Γ(𝓡, pr ⁻¹ᵁ O) ≃+* reesAlgebra (Ideal.map (wcCnSigma h O) I),
        ∀ x, (e x : Polynomial Γ(X, O)) = θ O hO x := by
    intro O hO
    have hmem : ∀ x, θ O hO x ∈ reesAlgebra (Ideal.map (wcCnSigma h O) I) := by
      intro x
      rw [hrees O hO]
      have hle : Subring.closure (Set.range (pr.app O).hom ∪ Set.range (wcCnSigma w (pr ⁻¹ᵁ O)))
          ≤ (Subring.closure (Set.range (Polynomial.C : Γ(X, O) →+* Polynomial Γ(X, O)) ∪
            Set.range (fun c : C => Polynomial.map (wcCnSigma h O) (ψ c)))).comap (θ O hO) := by
        rw [Subring.closure_le]
        rintro _ (⟨s, rfl⟩ | ⟨c, rfl⟩)
        · rw [SetLike.mem_coe, Subring.mem_comap, hC O hO s]
          exact Subring.subset_closure (Or.inl ⟨s, rfl⟩)
        · rw [SetLike.mem_coe, Subring.mem_comap, hσ O hO c]
          exact Subring.subset_closure (Or.inr ⟨c, rfl⟩)
      exact hle (hgen O hO x)
    have hsurj : ∀ f ∈ reesAlgebra (Ideal.map (wcCnSigma h O) I), ∃ x, θ O hO x = f := by
      intro f hf
      rw [hrees O hO] at hf
      have hle : Subring.closure (Set.range (Polynomial.C : Γ(X, O) →+* Polynomial Γ(X, O)) ∪
            Set.range (fun c : C => Polynomial.map (wcCnSigma h O) (ψ c))) ≤ (θ O hO).range := by
        rw [Subring.closure_le]
        rintro _ (⟨s, rfl⟩ | ⟨c, rfl⟩)
        · exact ⟨_, hC O hO s⟩
        · exact ⟨_, hσ O hO c⟩
      exact hle hf
    let φ : Γ(𝓡, pr ⁻¹ᵁ O) →+* reesAlgebra (Ideal.map (wcCnSigma h O) I) :=
      (θ O hO).codRestrict _ hmem
    have hbij : Function.Bijective φ := by
      constructor
      · intro x y hxy
        apply hinj O hO
        exact congrArg Subtype.val hxy
      · rintro ⟨f, hf⟩
        obtain ⟨x, hx⟩ := hsurj f hf
        exact ⟨x, Subtype.ext hx⟩
    exact ⟨RingEquiv.ofBijective φ hbij, fun x => rfl⟩
  choose Θ hΘ using key
  refine ⟨Θ, ?_, ?_, ?_⟩
  · intro O hO s
    rw [hΘ]
    exact hC O hO s
  · intro O hO c
    rw [hΘ, sigma_comp O c]
    exact hC O hO _
  · intro O O' hO hO' hle u
    rw [hΘ, hΘ]
    let F := (θ O' hO').comp (𝓡.presheaf.map (homOfLE (Scheme.Hom.preimage_mono pr hle)).op).hom
    let G := (Polynomial.mapRingHom (X.presheaf.map (homOfLE hle).op).hom).comp (θ O hO)
    have hEq : Set.EqOn F G (Set.range (pr.app O).hom ∪ Set.range (wcCnSigma w (pr ⁻¹ᵁ O))) := by
      rintro _ (⟨s, rfl⟩ | ⟨c, rfl⟩)
      · simp only [F, G, RingHom.comp_apply, Polynomial.coe_mapRingHom]
        rw [app_res pr O O' hle s, hC O' hO', hC O hO, Polynomial.map_C]
      · simp only [F, G, RingHom.comp_apply, Polynomial.coe_mapRingHom]
        rw [sigma_res w (pr ⁻¹ᵁ O) (pr ⁻¹ᵁ O') (Scheme.Hom.preimage_mono pr hle) c, hσ O' hO',
          hσ O hO, Polynomial.map_map]
        congr 1
        ext b
        simp only [RingHom.comp_apply]
        exact (sigma_res h O O' hle b).symm
    exact RingHom.eqOn_set_closure hEq (hgen O hO u)

theorem wcpa_dj_lcp_us_gm_mu : ∀ (B : Type u) [CommRing B] [IsLocalRing B] (X 𝓡 T : Scheme.{u}) (h : X ⟶ Spec (.of B)) (pr : 𝓡 ⟶ X), IsAffineHom pr → ∀ Θ : ∀ O : X.Opens, IsAffineOpen O → (Γ(𝓡, pr ⁻¹ᵁ O) ≃+* reesAlgebra (Ideal.map (wcCnSigma h O) (IsLocalRing.maximalIdeal B))), (∀ (O : X.Opens) (hO : IsAffineOpen O) (s : Γ(X, O)), (Θ O hO ((pr.app O).hom s) : Polynomial Γ(X, O)) = Polynomial.C s) → (∀ (O : X.Opens) (hO : IsAffineOpen O) (c : B), (Θ O hO (wcCnSigma (pr ≫ h) (pr ⁻¹ᵁ O) c) : Polynomial Γ(X, O)) = Polynomial.C (wcCnSigma h O c)) → (∀ (O O' : X.Opens) (hO : IsAffineOpen O) (hO' : IsAffineOpen O') (hle : O' ≤ O) (u : Γ(𝓡, pr ⁻¹ᵁ O)), (Θ O' hO' ((𝓡.presheaf.map (homOfLE (Scheme.Hom.preimage_mono pr hle)).op).hom u) : Polynomial Γ(X, O')) = Polynomial.map (X.presheaf.map (homOfLE hle).op).hom (Θ O hO u : Polynomial Γ(X, O))) → (∀ (O : X.Opens), IsAffineOpen O → ∀ z : reesAlgebra (Ideal.map (wcCnSigma h O) (IsLocalRing.maximalIdeal B)), z ∈ Ideal.map ((algebraMap Γ(X, O) (reesAlgebra (Ideal.map (wcCnSigma h O) (IsLocalRing.maximalIdeal B)))).comp (wcCnSigma h O)) (IsLocalRing.maximalIdeal B) ↔ ∀ k, (z : Polynomial Γ(X, O)).coeff k ∈ Ideal.map (wcCnSigma h O) (IsLocalRing.maximalIdeal B ^ (k + 1))) → (∀ V : 𝓡.Opens, IsAffineOpen V → Function.Surjective ((Limits.pullback.fst (pr ≫ h) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))).app V).hom ∧ ∀ x : Γ(𝓡, V), ((Limits.pullback.fst (pr ≫ h) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B)))).app V).hom x = 0 ↔ x ∈ Ideal.map (wcCnSigma (pr ≫ h) V) (IsLocalRing.maximalIdeal B)) → ∀ q : Limits.pullback (pr ≫ h) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) ⟶ T, wcpaDjGmMu h (IsLocalRing.maximalIdeal B) q (Limits.pullback.fst (pr ≫ h) (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) ≫ pr) :=
by
  intro B _ _ X 𝓡 T h pr hpr Θ hΘ1 hΘ2 hΘ3 hKer hQuot q
  haveI := hpr

  have resEq : ∀ {Y : Scheme.{u}} {U W : Y.Opens}
      (f g : (Opposite.op U : Y.Opensᵒᵖ) ⟶ Opposite.op W) (x : Γ(Y, U)),
      (Y.presheaf.map f).hom x = (Y.presheaf.map g).hom x := by
    intro Y U W f g x
    have hfg : f = g := Quiver.Hom.unop_inj (Subsingleton.elim _ _)
    rw [hfg]
  have resId : ∀ {Y : Scheme.{u}} {U : Y.Opens}
      (f : (Opposite.op U : Y.Opensᵒᵖ) ⟶ Opposite.op U) (x : Γ(Y, U)),
      (Y.presheaf.map f).hom x = x := by
    intro Y U f x
    rw [resEq f (𝟙 _), CategoryTheory.Functor.map_id]
    rfl
  have resComp : ∀ {Y : Scheme.{u}} {U V W : Y.Opens}
      (f : (Opposite.op U : Y.Opensᵒᵖ) ⟶ Opposite.op V)
      (g : (Opposite.op V : Y.Opensᵒᵖ) ⟶ Opposite.op W) (x : Γ(Y, U)),
      (Y.presheaf.map g).hom ((Y.presheaf.map f).hom x) = (Y.presheaf.map (f ≫ g)).hom x := by
    intro Y U V W f g x
    rw [Functor.map_comp, CommRingCat.hom_comp, RingHom.comp_apply]
  have resLeft : ∀ {Y : Scheme.{u}} {U W : Y.Opens}
      (f : (Opposite.op U : Y.Opensᵒᵖ) ⟶ Opposite.op W)
      (g : (Opposite.op W : Y.Opensᵒᵖ) ⟶ Opposite.op U) (x : Γ(Y, U)),
      (Y.presheaf.map g).hom ((Y.presheaf.map f).hom x) = x := by
    intro Y U W f g x
    rw [resComp, resId]

  have transport : ∀ {R S : Type u} [CommRing R] [CommRing S] (e : R ≃+* S) (σ' : B →+* R)
      (σ : B →+* S) (I : Ideal B), (∀ c, e (σ' c) = σ c) →
      ∀ x : R, x ∈ Ideal.map σ' I ↔ e x ∈ Ideal.map σ I := by
    intro R S _ _ e σ' σ I he x
    have h1 : (e : R →+* S).comp σ' = σ := RingHom.ext fun c => he c
    have h2 : (e.symm : S →+* R).comp σ = σ' := RingHom.ext fun c => by
      rw [RingHom.comp_apply, ← he c]
      exact e.symm_apply_apply _
    constructor
    · intro hx
      have := Ideal.mem_map_of_mem (e : R →+* S) hx
      rw [Ideal.map_map, h1] at this
      exact this
    · intro hx
      have := Ideal.mem_map_of_mem (e.symm : S →+* R) hx
      rw [Ideal.map_map, h2] at this
      simpa using this

  have key : ∀ {Y : Scheme.{u}} (π : Y ⟶ 𝓡) (q : Y ⟶ T),
      (∀ V : 𝓡.Opens, IsAffineOpen V → Function.Surjective (π.app V).hom ∧
        ∀ x : Γ(𝓡, V), (π.app V).hom x = 0 ↔
          x ∈ Ideal.map (wcCnSigma (pr ≫ h) V) (IsLocalRing.maximalIdeal B)) →
      wcpaDjGmMu h (IsLocalRing.maximalIdeal B) q (π ≫ pr) := by
    intro Y π q hQ
    have hle1 : ∀ O : X.Opens, (π ≫ pr) ⁻¹ᵁ O ≤ (π ≫ pr) ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤ := fun O =>
      le_inf le_rfl (by rw [Scheme.Hom.preimage_top]; exact le_top)
    refine ⟨fun O hO => (Y.presheaf.map (homOfLE (inf_le_left :
        (π ≫ pr) ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤ ≤ (π ≫ pr) ⁻¹ᵁ O)).op).hom.comp
          ((π.app (pr ⁻¹ᵁ O)).hom.comp (Θ O hO).symm.toRingHom), ?_, ?_, ?_, ?_⟩
    ·
      intro O hO y
      obtain ⟨u, hu⟩ := (hQ (pr ⁻¹ᵁ O) (hO.preimage pr)).1
        ((Y.presheaf.map (homOfLE (hle1 O)).op).hom y)
      refine ⟨Θ O hO u, ?_⟩
      change (Y.presheaf.map _).hom ((π.app (pr ⁻¹ᵁ O)).hom ((Θ O hO).symm (Θ O hO u))) = y
      rw [RingEquiv.symm_apply_apply, hu]
      exact resLeft _ _ y
    ·
      intro O hO z
      have hσ : ∀ c, Θ O hO (wcCnSigma (pr ≫ h) (pr ⁻¹ᵁ O) c) =
          ((algebraMap Γ(X, O) (reesAlgebra (Ideal.map (wcCnSigma h O)
            (IsLocalRing.maximalIdeal B)))).comp (wcCnSigma h O)) c := by
        intro c
        apply Subtype.ext
        rw [hΘ2]
        rfl
      rw [← hKer O hO z]
      have htr := transport (Θ O hO) _ _ (IsLocalRing.maximalIdeal B) hσ ((Θ O hO).symm z)
      rw [RingEquiv.apply_symm_apply] at htr
      change (Y.presheaf.map _).hom ((π.app (pr ⁻¹ᵁ O)).hom ((Θ O hO).symm z)) = 0 ↔ _
      rw [← htr, ← (hQ (pr ⁻¹ᵁ O) (hO.preimage pr)).2]
      constructor
      · intro h0
        have := congrArg (Y.presheaf.map (homOfLE (hle1 O)).op).hom h0
        exact (resLeft _ _ _).symm.trans (this.trans (map_zero _))
      · intro h0
        rw [h0, map_zero]
    ·
      intro O hO s
      have h1 : (Θ O hO).symm (algebraMap Γ(X, O) _ s) = (pr.app O).hom s := by
        rw [RingEquiv.symm_apply_eq]
        apply Subtype.ext
        rw [hΘ1]
        rfl
      change (Y.presheaf.map _).hom ((π.app (pr ⁻¹ᵁ O)).hom
        ((Θ O hO).symm (algebraMap Γ(X, O) _ s))) = _
      rw [h1]
      rfl
    ·
      intro O O' hO hO' hle z z' hz
      have h1 : (Θ O' hO').symm z' = (𝓡.presheaf.map
          (homOfLE (Scheme.Hom.preimage_mono pr hle)).op).hom ((Θ O hO).symm z) := by
        rw [RingEquiv.symm_apply_eq]
        apply Subtype.ext
        rw [hΘ3 O O' hO hO' hle, RingEquiv.apply_symm_apply, hz]
      change (Y.presheaf.map _).hom ((π.app (pr ⁻¹ᵁ O')).hom ((Θ O' hO').symm z')) =
        (Y.presheaf.map _).hom ((Y.presheaf.map _).hom
          ((π.app (pr ⁻¹ᵁ O)).hom ((Θ O hO).symm z)))
      rw [h1]
      have hnat := Scheme.Hom.naturality π (homOfLE (Scheme.Hom.preimage_mono pr hle)).op
      have hnat' := congrArg (fun φ => φ.hom ((Θ O hO).symm z)) hnat
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hnat'
      rw [hnat']
      exact (resComp _ _ _).trans ((resEq _ _ _).trans (resComp _ _ _).symm)
  exact key _ q hQuot

theorem wcpa_dj_lcp_us_gm_lam : ∀ {B : Type u} [CommRing B] {X Y T : Scheme.{u}} (h : X ⟶ Spec (.of B)) (I : Ideal B) (q : Y ⟶ T) (p : Y ⟶ X), wcpaDjGmMu h I q p → wcpaDjGmLam h I q p :=
by
  intro B _ X Y T h I q p hMu
  classical
  obtain ⟨μ, hsurj, hker, hconst, hres⟩ := hMu

  have hsig : ∀ (O O' : X.Opens) (hle : O' ≤ O),
      (X.presheaf.map (homOfLE hle).op).hom.comp (wcCnSigma h O) = wcCnSigma h O' := by
    intro O O' hle
    ext b
    simp only [wcCnSigma, RingHom.comp_apply]
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have hR : ∀ (O O' : X.Opens) (hle : O' ≤ O) (𝔞 : Ideal B) (y : Γ(X, O)),
      y ∈ Ideal.map (wcCnSigma h O) 𝔞 →
      (X.presheaf.map (homOfLE hle).op).hom y ∈ Ideal.map (wcCnSigma h O') 𝔞 := by
    intro O O' hle 𝔞 y hy
    have := Ideal.mem_map_of_mem (X.presheaf.map (homOfLE hle).op).hom hy
    rwa [Ideal.map_map, hsig] at this
  have hmem : ∀ (O : X.Opens) (k : ℕ) (x : Γ(X, O)), x ∈ Ideal.map (wcCnSigma h O) (I ^ k) →
      Polynomial.monomial k x ∈ reesAlgebra (Ideal.map (wcCnSigma h O) I) := by
    intro O k x hx
    rw [reesAlgebra.monomial_mem, ← Ideal.map_pow]
    exact hx
  have hcoef : ∀ (O : X.Opens) (z : reesAlgebra (Ideal.map (wcCnSigma h O) I)) (k : ℕ),
      (z : Polynomial Γ(X, O)).coeff k ∈ Ideal.map (wcCnSigma h O) (I ^ k) := by
    intro O z k
    rw [Ideal.map_pow]
    have hz := z.2
    rw [mem_reesAlgebra_iff] at hz
    exact hz k

  obtain ⟨lam, hlamEq⟩ : ∃ lam : ∀ O : X.Opens, IsAffineOpen O → ℕ → Γ(X, O) →
      Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤), ∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (x : Γ(X, O))
      (hx : x ∈ Ideal.map (wcCnSigma h O) (I ^ k)),
      lam O hO k x = μ O hO ⟨Polynomial.monomial k x, hmem O k x hx⟩ :=
    ⟨fun O hO k x => if hx : x ∈ Ideal.map (wcCnSigma h O) (I ^ k) then
      μ O hO ⟨Polynomial.monomial k x, hmem O k x hx⟩ else 0,
      fun O hO k x hx => dif_pos hx⟩
  choose lift hlift using hsurj
  obtain ⟨Pj, hPjdef⟩ : ∃ Pj : ∀ O : X.Opens, IsAffineOpen O → ℕ → Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤) →
      Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤), ∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ)
      (u : Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤)),
      Pj O hO k u = lam O hO k ((lift O hO u : Polynomial Γ(X, O)).coeff k) :=
    ⟨fun O hO k u => lam O hO k ((lift O hO u : Polynomial Γ(X, O)).coeff k),
      fun _ _ _ _ => rfl⟩

  have hmono : ∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (x : Γ(X, O))
      (hx : x ∈ Ideal.map (wcCnSigma h O) (I ^ k)),
      μ O hO ⟨Polynomial.monomial k x, hmem O k x hx⟩ = 0 ↔
        x ∈ Ideal.map (wcCnSigma h O) (I ^ (k + 1)) := by
    intro O hO k x hx
    rw [hker]
    constructor
    · intro H
      have H' := H k
      change (Polynomial.monomial k x).coeff k ∈ _ at H'
      rwa [Polynomial.coeff_monomial, if_pos rfl] at H'
    · intro H i
      change (Polynomial.monomial k x).coeff i ∈ _
      rw [Polynomial.coeff_monomial]
      split_ifs with hki
      · subst hki; exact H
      · exact Ideal.zero_mem _

  have hPjspec : ∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (u : Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤))
      (z : reesAlgebra (Ideal.map (wcCnSigma h O) I)), μ O hO z = u →
      Pj O hO k u = lam O hO k ((z : Polynomial Γ(X, O)).coeff k) := by
    intro O hO k u z hz
    rw [hPjdef, hlamEq O hO k _ (hcoef O _ k), hlamEq O hO k _ (hcoef O z k), ← sub_eq_zero,
      ← map_sub]
    have hd : ((lift O hO u : Polynomial Γ(X, O)).coeff k - (z : Polynomial Γ(X, O)).coeff k) ∈
        Ideal.map (wcCnSigma h O) (I ^ (k + 1)) := by
      have H := (hker O hO (lift O hO u - z)).mp (by rw [map_sub, hlift, hz, sub_self]) k
      change ((lift O hO u : Polynomial Γ(X, O)) - (z : Polynomial Γ(X, O))).coeff k ∈ _ at H
      rwa [Polynomial.coeff_sub] at H
    have e : (⟨Polynomial.monomial k ((lift O hO u : Polynomial Γ(X, O)).coeff k),
        hmem O k _ (hcoef O _ k)⟩ : reesAlgebra (Ideal.map (wcCnSigma h O) I)) -
        ⟨Polynomial.monomial k ((z : Polynomial Γ(X, O)).coeff k), hmem O k _ (hcoef O z k)⟩ =
        ⟨Polynomial.monomial k ((lift O hO u : Polynomial Γ(X, O)).coeff k -
          (z : Polynomial Γ(X, O)).coeff k),
          hmem O k _ (Ideal.sub_mem _ (hcoef O _ k) (hcoef O z k))⟩ := by
      apply Subtype.ext
      change Polynomial.monomial k _ - Polynomial.monomial k _ = Polynomial.monomial k _
      rw [map_sub]
    rw [e]
    exact (hmono O hO k _ (Ideal.sub_mem _ (hcoef O _ k) (hcoef O z k))).mpr hd

  have hL1 : ∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (x x' : Γ(X, O)),
      x ∈ Ideal.map (wcCnSigma h O) (I ^ k) → x' ∈ Ideal.map (wcCnSigma h O) (I ^ k) →
      lam O hO k (x + x') = lam O hO k x + lam O hO k x' := by
    intro O hO k x x' hx hx'
    rw [hlamEq O hO k _ (Ideal.add_mem _ hx hx'), hlamEq O hO k _ hx, hlamEq O hO k _ hx',
      ← map_add]
    congr 1
    apply Subtype.ext
    change Polynomial.monomial k (x + x') = Polynomial.monomial k x + Polynomial.monomial k x'
    rw [map_add]
  have hL2 : ∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (s x : Γ(X, O)),
      x ∈ Ideal.map (wcCnSigma h O) (I ^ k) →
      lam O hO k (s * x) = (Y.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤ ≤ p ⁻¹ᵁ O)).op).hom
        ((p.app O).hom s) * lam O hO k x := by
    intro O hO k s x hx
    rw [hlamEq O hO k _ (Ideal.mul_mem_left _ s hx), hlamEq O hO k _ hx, ← hconst O hO s, ← map_mul]
    congr 1
    apply Subtype.ext
    change Polynomial.monomial k (s * x) =
      ((algebraMap Γ(X, O) (reesAlgebra (Ideal.map (wcCnSigma h O) I)) s :
        reesAlgebra (Ideal.map (wcCnSigma h O) I)) : Polynomial Γ(X, O)) * Polynomial.monomial k x
    rw [Subalgebra.coe_algebraMap, Polynomial.algebraMap_eq, Polynomial.C_mul_monomial]
  have hL3 : ∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (x : Γ(X, O)),
      x ∈ Ideal.map (wcCnSigma h O) (I ^ k) →
      (lam O hO k x = 0 ↔ x ∈ Ideal.map (wcCnSigma h O) (I ^ (k + 1))) := by
    intro O hO k x hx
    rw [hlamEq O hO k x hx]
    exact hmono O hO k x hx
  have hL4 : ∀ (O O' : X.Opens) (hO : IsAffineOpen O) (hO' : IsAffineOpen O') (hle : O' ≤ O) (k : ℕ)
      (x : Γ(X, O)), x ∈ Ideal.map (wcCnSigma h O) (I ^ k) →
      (Y.presheaf.map (homOfLE (inf_le_inf_right (q ⁻¹ᵁ ⊤) (Scheme.Hom.preimage_mono p hle))).op).hom
        (lam O hO k x) = lam O' hO' k ((X.presheaf.map (homOfLE hle).op).hom x) := by
    intro O O' hO hO' hle k x hx
    rw [hlamEq O hO k x hx, hlamEq O' hO' k _ (hR O O' hle _ x hx)]
    symm
    apply hres
    change Polynomial.monomial k _ = Polynomial.map _ (Polynomial.monomial k x)
    rw [Polynomial.map_monomial]

  have hP1 : ∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (z z' : Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤)),
      Pj O hO k (z + z') = Pj O hO k z + Pj O hO k z' := by
    intro O hO k z z'
    rw [hPjspec O hO k (z + z') (lift O hO z + lift O hO z') (by rw [map_add, hlift, hlift]),
      hPjdef, hPjdef]
    have e : ((lift O hO z + lift O hO z' : reesAlgebra (Ideal.map (wcCnSigma h O) I)) :
        Polynomial Γ(X, O)).coeff k = (lift O hO z : Polynomial Γ(X, O)).coeff k +
          (lift O hO z' : Polynomial Γ(X, O)).coeff k :=
      Polynomial.coeff_add _ _ _
    rw [e]
    exact hL1 O hO k _ _ (hcoef O _ k) (hcoef O _ k)
  have hP2 : ∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (s : Γ(X, O)) (z : Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤)),
      Pj O hO k ((Y.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤ ≤ p ⁻¹ᵁ O)).op).hom
        ((p.app O).hom s) * z) =
      (Y.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤ ≤ p ⁻¹ᵁ O)).op).hom
        ((p.app O).hom s) * Pj O hO k z := by
    intro O hO k s z
    rw [hPjspec O hO k _ (algebraMap Γ(X, O) _ s * lift O hO z)
      (by rw [map_mul, hconst O hO s, hlift]), hPjdef]
    have e : ((algebraMap Γ(X, O) (reesAlgebra (Ideal.map (wcCnSigma h O) I)) s * lift O hO z :
        reesAlgebra (Ideal.map (wcCnSigma h O) I)) : Polynomial Γ(X, O)).coeff k =
        s * (lift O hO z : Polynomial Γ(X, O)).coeff k := by
      change (((algebraMap Γ(X, O) (reesAlgebra (Ideal.map (wcCnSigma h O) I)) s :
        reesAlgebra (Ideal.map (wcCnSigma h O) I)) : Polynomial Γ(X, O)) *
          (lift O hO z : Polynomial Γ(X, O))).coeff k = _
      rw [Subalgebra.coe_algebraMap, Polynomial.algebraMap_eq, Polynomial.coeff_C_mul]
    rw [e]
    exact hL2 O hO k s _ (hcoef O _ k)
  have hP3 : ∀ (O O' : X.Opens) (hO : IsAffineOpen O) (hO' : IsAffineOpen O') (hle : O' ≤ O) (k : ℕ)
      (z : Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤)),
      (Y.presheaf.map (homOfLE (inf_le_inf_right (q ⁻¹ᵁ ⊤) (Scheme.Hom.preimage_mono p hle))).op).hom
        (Pj O hO k z) =
      Pj O' hO' k ((Y.presheaf.map (homOfLE (inf_le_inf_right (q ⁻¹ᵁ ⊤)
        (Scheme.Hom.preimage_mono p hle))).op).hom z) := by
    intro O O' hO hO' hle k z
    obtain ⟨a', ha'⟩ : ∃ a' : reesAlgebra (Ideal.map (wcCnSigma h O') I),
        (a' : Polynomial Γ(X, O')) = Polynomial.map (X.presheaf.map (homOfLE hle).op).hom
          (lift O hO z : Polynomial Γ(X, O)) := by
      refine ⟨⟨Polynomial.map (X.presheaf.map (homOfLE hle).op).hom
          (lift O hO z : Polynomial Γ(X, O)), ?_⟩, rfl⟩
      rw [mem_reesAlgebra_iff]
      intro i
      rw [Polynomial.coeff_map, ← Ideal.map_pow]
      exact hR O O' hle _ _ (hcoef O _ i)
    rw [hPjspec O' hO' k _ a' (by rw [hres O O' hO hO' hle (lift O hO z) a' ha', hlift]), hPjdef,
      ha', Polynomial.coeff_map]
    exact hL4 O O' hO hO' hle k _ (hcoef O _ k)
  have hP4 : ∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (x : Γ(X, O)),
      x ∈ Ideal.map (wcCnSigma h O) (I ^ k) → Pj O hO k (lam O hO k x) = lam O hO k x := by
    intro O hO k x hx
    rw [hPjspec O hO k _ ⟨Polynomial.monomial k x, hmem O k x hx⟩ (hlamEq O hO k x hx).symm]
    congr 1
    change (Polynomial.monomial k x).coeff k = x
    rw [Polynomial.coeff_monomial, if_pos rfl]
  have hP5 : ∀ (O : X.Opens) (hO : IsAffineOpen O) (k : ℕ) (z : Γ(Y, p ⁻¹ᵁ O ⊓ q ⁻¹ᵁ ⊤)),
      ∃ x, x ∈ Ideal.map (wcCnSigma h O) (I ^ k) ∧ Pj O hO k z = lam O hO k x :=
    fun O hO k z => ⟨_, hcoef O (lift O hO z) k, hPjdef O hO k z⟩
  exact ⟨lam, Pj, hL1, hL2, hL3, hL4, hP1, hP2, hP3, hP4, hP5⟩

theorem wcpa_dj_lcp_us_gm_iface : ∀ {B : Type u} [CommRing B] {X Y Z T : Scheme.{u}} (h : X ⟶ Spec (.of B)) (I : Ideal B) (n : ℕ) (q : Y ⟶ T) (φ : X ⟶ Z) (p : Y ⟶ X) (L : wcpaDjCoc Z), (∀ a, IsAffineOpen (φ ⁻¹ᵁ L.V a)) → (∀ a b, IsAffineOpen (φ ⁻¹ᵁ L.V a ⊓ φ ⁻¹ᵁ L.V b)) → (∀ a b c, IsAffineOpen (φ ⁻¹ᵁ L.V a ⊓ φ ⁻¹ᵁ L.V b ⊓ φ ⁻¹ᵁ L.V c)) → wcpaDjGmLam h I q p → wcpaDjGrIface h I n q φ p L :=
by
  intro B _ X Y Z T h I n q φ p L hA1 hA2 hA3 hLam
  obtain ⟨lam, Pj, L1, L2, L3, L4, P1, P2, P3, P4, P5⟩ := hLam

  have nat : ∀ (O O' : X.Opens) (hle : O' ≤ O) (W : Y.Opens) (hW : W ≤ p ⁻¹ᵁ O')
      (s : Γ(X, O)),
      (Y.presheaf.map (homOfLE hW).op).hom ((p.app O').hom
          ((X.presheaf.map (homOfLE hle).op).hom s)) =
        (Y.presheaf.map (homOfLE (hW.trans (Scheme.Hom.preimage_mono p hle))).op).hom
          ((p.app O).hom s) := by
    intro O O' hle W hW s
    have e : X.presheaf.map (homOfLE hle).op ≫ p.app O' ≫ Y.presheaf.map (homOfLE hW).op =
        p.app O ≫ Y.presheaf.map (homOfLE (hW.trans (Scheme.Hom.preimage_mono p hle))).op := by
      rw [← Category.assoc, Scheme.Hom.naturality, Category.assoc, ← Functor.map_comp]
      rfl
    have e2 := congrArg (fun f => f.hom s) e
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e2
    exact e2

  have unit : ∀ a b : Fin L.m,
      ((wcpaDjCocPull (p ≫ φ) L).g a b :
          Γ(Y, (wcpaDjCocPull (p ≫ φ) L).V a ⊓ (wcpaDjCocPull (p ≫ φ) L).V b)) =
        (p.app ((wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V b)).hom
          ((wcpaDjCocPull φ L).g a b :
            Γ(X, (wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V b)) := by
    intro a b
    have e := Scheme.Hom.naturality p
      (homOfLE (fun _ hx => hx : φ ⁻¹ᵁ L.V a ⊓ φ ⁻¹ᵁ L.V b ≤ φ ⁻¹ᵁ (L.V a ⊓ L.V b))).op
    have e2 := congrArg
      (fun f => f.hom ((φ.app (L.V a ⊓ L.V b)).hom (L.g a b : Γ(Z, L.V a ⊓ L.V b)))) e
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e2
    exact e2.symm

  have pw : ∀ {R S T : Type u} [CommRing R] [CommRing S] [CommRing T] (f : R →+* S)
      (g : S →+* T) (x : R) (z : T) (d : ℕ), g (f x) = z → g (f (x ^ d)) = z ^ d := by
    intro R S T _ _ _ f g x z d hz
    rw [map_pow, map_pow, hz]

  have key : ∀ (a b : Fin L.m) (d : ℕ),
      (Y.presheaf.map (homOfLE (inf_le_left : p ⁻¹ᵁ (φ ⁻¹ᵁ L.V a ⊓ φ ⁻¹ᵁ L.V b) ⊓ q ⁻¹ᵁ ⊤ ≤
          p ⁻¹ᵁ (φ ⁻¹ᵁ L.V a ⊓ φ ⁻¹ᵁ L.V b))).op).hom
        ((p.app (φ ⁻¹ᵁ L.V a ⊓ φ ⁻¹ᵁ L.V b)).hom (((wcpaDjCocPull φ L).g a b :
          Γ(X, (wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V b)) ^ d)) =
      ((Y.presheaf.map (homOfLE (show (wcpaDjCocPull (p ≫ φ) L).V a ⊓
          (wcpaDjCocPull (p ≫ φ) L).V b ⊓ q ⁻¹ᵁ ⊤ ≤
          (wcpaDjCocPull (p ≫ φ) L).V a ⊓ (wcpaDjCocPull (p ≫ φ) L).V b from
          inf_le_left)).op).hom
        ((wcpaDjCocPull (p ≫ φ) L).g a b :
          Γ(Y, (wcpaDjCocPull (p ≫ φ) L).V a ⊓ (wcpaDjCocPull (p ≫ φ) L).V b))) ^ d := by
    intro a b d
    exact pw _ _ _ _ d (congrArg (Y.presheaf.map (homOfLE _).op).hom (unit a b)).symm

  have s3 : ∀ {R Ra Rb : Type u} [CommRing R] [CommRing Ra] [CommRing Rb] (P : R →+ R)
      (Pa : Ra → Ra) (Pb : Rb → Rb) (ra : Ra →+* R) (rb : Rb →+* R) (G t : R) (ua : Ra)
      (ub : Rb), (∀ w, P (G * w) = G * P w) → (∀ z, P (ra z) = ra (Pa z)) →
      (∀ z, P (rb z) = rb (Pb z)) → P t = t → t = rb ub - G * ra ua →
      t = rb (Pb ub) - G * ra (Pa ua) := by
    intro R Ra Rb _ _ _ P Pa Pb ra rb G t ua ub h1 h2 h3 h4 h5
    calc t = P t := h4.symm
      _ = rb (Pb ub) - G * ra (Pa ua) := by rw [h5, map_sub, h1, h2, h3]
  refine ⟨fun a => lam _ (hA1 a) (n + 1), fun a b => lam _ (hA2 a b) (n + 1),
    fun a b c => lam _ (hA3 a b c) (n + 1), ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  ·
    intro a b x x' hx hx'
    exact L1 _ (hA2 a b) (n + 1) x x' hx hx'
  ·
    intro a b c x x' hx hx'
    exact L1 _ (hA3 a b c) (n + 1) x x' hx hx'
  ·
    intro d a b x hx
    refine (L2 _ (hA2 a b) (n + 1) _ x hx).trans ?_
    exact congrArg (fun z => z * lam _ (hA2 a b) (n + 1) x) (key a b d)
  ·
    intro d a b c x hx
    refine (L2 _ (hA3 a b c) (n + 1) _ x hx).trans ?_
    refine congrArg (fun z => z * lam _ (hA3 a b c) (n + 1) x) ?_
    exact pw _ _ _ _ d ((nat (φ ⁻¹ᵁ L.V b ⊓ φ ⁻¹ᵁ L.V c) _
      (le_inf (inf_le_left.trans inf_le_right) inf_le_right) _ inf_le_left _).trans
      (congrArg (Y.presheaf.map (homOfLE _).op).hom (unit b c)).symm)
  ·
    intro a b x hx
    exact (L4 _ _ (hA1 a) (hA2 a b) inf_le_left (n + 1) x hx).symm
  ·
    intro a b x hx
    exact (L4 _ _ (hA1 b) (hA2 a b) inf_le_right (n + 1) x hx).symm
  ·
    intro a b c x hx
    exact (L4 _ _ (hA2 a b) (hA3 a b c) inf_le_left (n + 1) x hx).symm
  ·
    intro a b c x hx
    exact (L4 _ _ (hA2 b c) (hA3 a b c) (le_inf (inf_le_left.trans inf_le_right) inf_le_right)
      (n + 1) x hx).symm
  ·
    intro a b c x hx
    exact (L4 _ _ (hA2 a c) (hA3 a b c) (le_inf (inf_le_left.trans inf_le_left) inf_le_right)
      (n + 1) x hx).symm
  ·
    intro a b x hx h0
    exact (L3 _ (hA2 a b) (n + 1) x hx).mp h0
  ·
    intro d β c hc hβ
    choose β' hβ'mem hβ'eq using fun a => P5 _ (hA1 a) (n + 1) (β a)
    refine ⟨β', hβ'mem, fun a b => ?_⟩
    refine (s3 (AddMonoidHom.mk' (Pj _ (hA2 a b) (n + 1)) (P1 _ (hA2 a b) (n + 1)))
      (Pj _ (hA1 a) (n + 1)) (Pj _ (hA1 b) (n + 1)) _ _ _ _ (β a) (β b) ?_ ?_ ?_ ?_
      (hβ a b)).trans ?_
    · intro w
      have hG := P2 _ (hA2 a b) (n + 1) (((wcpaDjCocPull φ L).g a b :
        Γ(X, (wcpaDjCocPull φ L).V a ⊓ (wcpaDjCocPull φ L).V b)) ^ d) w
      rw [key a b d] at hG
      exact hG
    · intro z
      exact (P3 _ _ (hA1 a) (hA2 a b) inf_le_left (n + 1) z).symm
    · intro z
      exact (P3 _ _ (hA1 b) (hA2 a b) inf_le_right (n + 1) z).symm
    · exact P4 _ (hA2 a b) (n + 1) (c a b) (hc a b)
    · rw [hβ'eq a, hβ'eq b]
      rfl

theorem wcpa_dj_lcp_us_graded_model : ∀ (B : Type u) [CommRing B] [IsLocalRing B]
    [IsNoetherianRing B] (X Z Y₀ : Scheme.{u}) (h : X ⟶ Spec (.of B)) (φ : X ⟶ Z)
    (L : wcpaDjCoc Z) (i : Y₀ ⟶ X) (h₀ : Y₀ ⟶ Spec (.of (IsLocalRing.ResidueField B))),
    IsPullback i h₀ h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue B))) →
    (∀ a, IsAffineOpen (φ ⁻¹ᵁ L.V a)) →
    (∀ a b, IsAffineOpen (φ ⁻¹ᵁ L.V a ⊓ φ ⁻¹ᵁ L.V b)) →
    (∀ a b c, IsAffineOpen (φ ⁻¹ᵁ L.V a ⊓ φ ⁻¹ᵁ L.V b ⊓ φ ⁻¹ᵁ L.V c)) →
    ∃ (r : ℕ) (Y : Scheme.{u}) (ι : Y ⟶ Limits.pullback h₀ (Spec.map (CommRingCat.ofHom
        (algebraMap (IsLocalRing.ResidueField B)
          (MvPolynomial (Fin r) (IsLocalRing.ResidueField B)))))),
      IsClosedImmersion ι ∧ ∀ n : ℕ,
        wcpaDjGrIface h (IsLocalRing.maximalIdeal B) n (ι ≫ Limits.pullback.snd _ _) φ
          (ι ≫ Limits.pullback.fst _ _ ≫ i) L :=
by
  intro B _ _ _ X Z Y₀ h φ L i h₀ hpb hA1 hA2 hA3

  obtain ⟨r, b, hb⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (IsNoetherian.noetherian (IsLocalRing.maximalIdeal B))
  have hb' : Ideal.span (Set.range b) = IsLocalRing.maximalIdeal B := hb

  obtain ⟨𝓡, j, hj, hprA, hchart⟩ := wcpa_dj_lcp_us_gm_chart B (MvPolynomial (Fin r) B)
    (MvPolynomial.aeval (fun j => Polynomial.C (b j) * Polynomial.X)) X h

  obtain ⟨Θ, hΘ1, hΘ2, hΘ3⟩ := wcpa_dj_lcp_us_gm_theta B (IsLocalRing.maximalIdeal B)
    (MvPolynomial (Fin r) B) (MvPolynomial.aeval (fun j => Polynomial.C (b j) * Polynomial.X))
    X 𝓡 h (j ≫ Limits.pullback.fst _ _) (j ≫ Limits.pullback.snd _ _) hchart
    (fun W _ f => wcpa_dj_lcp_us_gm_rees_gen B Γ(X, W) (wcCnSigma h W)
      (IsLocalRing.maximalIdeal B) r b hb' f)

  obtain ⟨ι, hι, hιeq⟩ := wcpa_dj_lcp_us_gm_closed_imm B X Y₀ 𝓡 h i h₀ r j hpb
    (wcpa_dj_lcp_us_gm_spec_square B (IsLocalRing.ResidueField B) (IsLocalRing.residue B) r) hj
  refine ⟨r, _, ι, hι, fun n => ?_⟩
  rw [hιeq]

  apply wcpa_dj_lcp_us_gm_iface h _ n _ φ _ L hA1 hA2 hA3
  apply wcpa_dj_lcp_us_gm_lam
  exact wcpa_dj_lcp_us_gm_mu B X 𝓡 _ h (j ≫ Limits.pullback.fst _ _) hprA Θ hΘ1 hΘ2 hΘ3
    (fun O _ z => wcpa_dj_lcp_us_gm_rees_ker B Γ(X, O) (wcCnSigma h O) _ z)
    (fun V hV => wc_pullback_quot_affine_sections B 𝓡 ((j ≫ Limits.pullback.fst _ _) ≫ h)
      (IsLocalRing.maximalIdeal B) V hV)
    (ι ≫ Limits.pullback.snd _ _)

theorem wcpa_dj_lcp_us_va_basechange : ∀ (κ A' : Type u) [CommRing κ] [CommRing A']
    [Algebra κ A'] (Y₀ Z : Scheme.{u}) (h₀ : Y₀ ⟶ Spec (.of κ)) (ψ : Y₀ ⟶ Z) (L : wcpaDjCoc Z)
    (e : ℕ), wcpaDjVA h₀ (wcpaDjCocPull ψ L) ⊤ e →
    wcpaDjVA (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (algebraMap κ A'))))
      (wcpaDjCocPull (Limits.pullback.fst h₀ (Spec.map (CommRingCat.ofHom (algebraMap κ A'))) ≫
        ψ) L) ⊤ e :=
by
  intro κ A' _ _ _ Y₀ Z h₀ ψ L e hva

  have E_res : ∀ {X : Scheme.{u}} {U V W : X.Opens} (i : V ≤ U) (j : W ≤ V) (x : Γ(X, U)),
      (X.presheaf.map (homOfLE j).op).hom ((X.presheaf.map (homOfLE i).op).hom x) =
        (X.presheaf.map (homOfLE (j.trans i)).op).hom x := by
    intro X U V W i j x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]; rfl
  have E_N1 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) {U : Y.Opens} {V V' : X.Opens}
      (e : V ≤ f ⁻¹ᵁ U) (i : V' ≤ V) (s : Γ(Y, U)),
      (X.presheaf.map (homOfLE i).op).hom ((f.appLE U V e).hom s) =
        (f.appLE U V' (i.trans e)).hom s := by
    intro X Y f U V V' e i s
    rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map]
  have E_N2 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) {U U' : Y.Opens} {V : X.Opens}
      (e : V ≤ f ⁻¹ᵁ U') (i : U' ≤ U) (s : Γ(Y, U)),
      (f.appLE U' V e).hom ((Y.presheaf.map (homOfLE i).op).hom s) =
        (f.appLE U V (e.trans (f.preimage_mono i))).hom s := by
    intro X Y f U U' V e i s
    rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
  have E_app : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) {U : Y.Opens} {V : X.Opens}
      (i : V ≤ f ⁻¹ᵁ U) (s : Γ(Y, U)),
      (X.presheaf.map (homOfLE i).op).hom ((f.app U).hom s) = (f.appLE U V i).hom s := by
    intro X Y f U V i s
    rw [← CommRingCat.comp_apply, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]
  have E_comp : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) {U : Z.Opens} {V : Y.Opens}
      {W : X.Opens} (e₁ : V ≤ g ⁻¹ᵁ U) (e₂ : W ≤ f ⁻¹ᵁ V) (s : Γ(Z, U)),
      (f.appLE V W e₂).hom ((g.appLE U V e₁).hom s) =
        ((f ≫ g).appLE U W (e₂.trans (f.preimage_mono e₁))).hom s := by
    intro X Y Z f g U V W e₁ e₂ s
    rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_comp_appLE]
  have E_congr : ∀ {X Y : Scheme.{u}} (f g : X ⟶ Y) (h : f = g) {U : Y.Opens} {V : X.Opens}
      (e : V ≤ f ⁻¹ᵁ U) (e' : V ≤ g ⁻¹ᵁ U) (s : Γ(Y, U)),
      (f.appLE U V e).hom s = (g.appLE U V e').hom s := by
    intro X Y f g h U V e e' s
    subst h; rfl
  have E_comp_app : ∀ {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) {U : Z.Opens} {W : X.Opens}
      (e : W ≤ f ⁻¹ᵁ (g ⁻¹ᵁ U)) (s : Γ(Z, U)),
      (f.appLE (g ⁻¹ᵁ U) W e).hom ((g.app U).hom s) = ((f ≫ g).appLE U W e).hom s := by
    intro X Y Z f g U W e s
    rw [← CommRingCat.comp_apply, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_comp_appLE]
  have uniq : ∀ {R : CommRingCat.{u}} (x y r : R), x * r = 1 → y * r = 1 → x = y := by
    intro R x y r hx hy
    calc x = x * (y * r) := by rw [hy, mul_one]
      _ = y * (x * r) := by ring
      _ = y := by rw [hx, mul_one]

  have transport : ∀ {P T' : Scheme.{u}} (q : P ⟶ T') (c : T' ⟶ Spec (.of κ)) (π : P ⟶ Y₀),
      IsAffineHom π → π ≫ h₀ = q ≫ c →
      (∀ D : Y₀.Opens, IsAffineOpen D → ∀ f : Γ(P, π ⁻¹ᵁ D), f ∈ AddSubmonoid.closure
        {y : Γ(P, π ⁻¹ᵁ D) | ∃ (x : Γ(Y₀, D)) (α : Γ(T', ⊤)),
          y = (π.app D).hom x *
            (P.presheaf.map (homOfLE (le_top : π ⁻¹ᵁ D ≤ ⊤)).op).hom (q.appTop.hom α)}) →
      wcpaDjVA q (wcpaDjCocPull (π ≫ ψ) L) ⊤ e := by
    intro P T' q c π hπ hcomm hgen
    have hva' : wcpaDjVA h₀ (wcpaDjCoc.mk L.m (fun a => ψ ⁻¹ᵁ L.V a)
        (fun a b => Units.map (((Y₀.presheaf.map (homOfLE
          (show ψ ⁻¹ᵁ L.V a ⊓ ψ ⁻¹ᵁ L.V b ≤ ψ ⁻¹ᵁ (L.V a ⊓ L.V b) from fun _ hx => hx)).op).hom.comp
          (ψ.app (L.V a ⊓ L.V b)).hom).toMonoidHom) (L.g a b)) : wcpaDjCoc Y₀) ⊤ e := hva
    unfold wcpaDjVA at hva'
    dsimp only at hva'
    obtain ⟨M, t, hVA1, hVA2, hVA3, hVA4⟩ := hva'
    show wcpaDjVA q (wcpaDjCoc.mk L.m (fun a => (π ≫ ψ) ⁻¹ᵁ L.V a)
        (fun a b => Units.map (((P.presheaf.map (homOfLE
          (show (π ≫ ψ) ⁻¹ᵁ L.V a ⊓ (π ≫ ψ) ⁻¹ᵁ L.V b ≤ (π ≫ ψ) ⁻¹ᵁ (L.V a ⊓ L.V b) from
            fun _ hx => hx)).op).hom.comp
          ((π ≫ ψ).app (L.V a ⊓ L.V b)).hom).toMonoidHom) (L.g a b)) : wcpaDjCoc P) ⊤ e
    unfold wcpaDjVA
    dsimp only
    have hle : ∀ a, (π ≫ ψ) ⁻¹ᵁ L.V a ⊓ q ⁻¹ᵁ ⊤ ≤ π ⁻¹ᵁ (ψ ⁻¹ᵁ L.V a ⊓ h₀ ⁻¹ᵁ ⊤) := by
      intro a
      simp only [Scheme.Hom.preimage_top, inf_top_eq]
      exact le_rfl
    have hle2 : ∀ a, π ⁻¹ᵁ (ψ ⁻¹ᵁ L.V a ⊓ h₀ ⁻¹ᵁ ⊤) ≤ (π ≫ ψ) ⁻¹ᵁ L.V a ⊓ q ⁻¹ᵁ ⊤ := by
      intro a
      simp only [Scheme.Hom.preimage_top, inf_top_eq]
      exact le_rfl
    have hle3 : ∀ a b, (π ≫ ψ) ⁻¹ᵁ L.V a ⊓ (π ≫ ψ) ⁻¹ᵁ L.V b ⊓ q ⁻¹ᵁ ⊤ ≤
        π ⁻¹ᵁ (ψ ⁻¹ᵁ L.V a ⊓ ψ ⁻¹ᵁ L.V b ⊓ h₀ ⁻¹ᵁ ⊤) := by
      intro a b
      simp only [Scheme.Hom.preimage_top, inf_top_eq]
      exact le_rfl
    obtain ⟨t', ht'⟩ : ∃ t' : Fin (M + 1) → ∀ a : Fin L.m,
        Γ(P, (π ≫ ψ) ⁻¹ᵁ L.V a ⊓ q ⁻¹ᵁ ⊤),
        ∀ J a, t' J a = (π.appLE _ _ (hle a)).hom (t J a) := ⟨_, fun _ _ => rfl⟩

    have hBO : ∀ J a, P.basicOpen (t' J a) = π ⁻¹ᵁ Y₀.basicOpen (t J a) := by
      intro J a
      rw [ht' J a, Scheme.basicOpen_appLE]
      exact inf_eq_right.mpr ((π.preimage_mono (Y₀.basicOpen_le (t J a))).trans (hle2 a))
    have hDJ : ∀ J, (⨆ a, P.basicOpen (t' J a)) = π ⁻¹ᵁ ⨆ a, Y₀.basicOpen (t J a) := by
      intro J
      rw [Scheme.Hom.preimage_iSup]
      exact iSup_congr (hBO J)
    refine ⟨M, t', ?_, ?_, ?_, ?_⟩
    ·
      intro J a b
      have old := congrArg (π.appLE _ _ (hle3 a b)).hom (hVA1 J a b)
      simp only [Units.coe_map, RingHom.toMonoidHom_eq_coe,
        MonoidHom.coe_coe, RingHom.comp_apply, map_mul, map_pow, E_N1, E_N2, E_app, E_comp_app,
        E_comp, E_res, ht'] at old ⊢
      exact old
    ·
      intro a
      have hr : Set.range (fun J => t' J a) =
          (π.appLE _ _ (hle a)).hom '' Set.range (fun J => t J a) := by
        rw [← Set.range_comp]
        exact congrArg Set.range (funext fun J => ht' J a)
      rw [hr, ← Ideal.map_span, hVA2 a, Ideal.map_top]
    ·
      intro J
      rw [hDJ J]
      exact (hVA3 J).preimage π
    ·
      intro J f
      obtain ⟨P0, hP0⟩ := hVA4 J 0
      choose inv0 hinv0 _ using hP0
      have hDa : ∀ a, P.basicOpen (t' J a) ≤ π ⁻¹ᵁ ⨆ a', Y₀.basicOpen (t J a') := fun a =>
        (hBO J a).le.trans (π.preimage_mono (le_iSup (fun a' => Y₀.basicOpen (t J a')) a))
      have hres_t : ∀ l a, (P.presheaf.map (homOfLE (P.basicOpen_le (t' J a))).op).hom (t' l a) =
          (π.appLE (Y₀.basicOpen (t J a)) (P.basicOpen (t' J a)) (hBO J a).le).hom
            ((Y₀.presheaf.map (homOfLE (Y₀.basicOpen_le (t J a))).op).hom (t l a)) := by
        intro l a
        rw [ht' l a, E_N1, E_N2]
      have hinv' : ∀ a, (π.appLE (Y₀.basicOpen (t J a)) (P.basicOpen (t' J a)) (hBO J a).le).hom
          (inv0 a) * (P.presheaf.map (homOfLE (P.basicOpen_le (t' J a))).op).hom (t' J a) = 1 := by
        intro a
        rw [hres_t J a, ← map_mul, hinv0 a, map_one]
      have K1 : ∀ a (α : Γ(Spec (.of κ), ⊤)),
          (π.appLE (Y₀.basicOpen (t J a)) (P.basicOpen (t' J a)) (hBO J a).le).hom
            (((Y₀.presheaf.map (homOfLE ((Y₀.basicOpen_le (t J a)).trans inf_le_right)).op).hom.comp
              (h₀.app ⊤).hom) α) =
          ((P.presheaf.map (homOfLE ((P.basicOpen_le (t' J a)).trans inf_le_right)).op).hom.comp
              (q.app ⊤).hom) (c.appTop.hom α) := by
        intro a α
        rw [RingHom.comp_apply, RingHom.comp_apply, E_app, E_app, E_comp,
          E_congr (π ≫ h₀) (q ≫ c) hcomm _ (le_top.trans (Scheme.Hom.preimage_top _).ge),
          Scheme.Hom.comp_appLE, CommRingCat.comp_apply]
        rfl
      have hgood : ∀ f : Γ(P, π ⁻¹ᵁ ⨆ a, Y₀.basicOpen (t J a)),
          ∃ P' : MvPolynomial (Fin (M + 1)) Γ(T', ⊤), ∀ a,
            (P.presheaf.map (homOfLE (hDa a)).op).hom f =
              MvPolynomial.eval₂
                ((P.presheaf.map (homOfLE ((P.basicOpen_le (t' J a)).trans inf_le_right)).op).hom.comp
                  (q.app ⊤).hom)
                (fun l => (P.presheaf.map (homOfLE (P.basicOpen_le (t' J a))).op).hom (t' l a) *
                  (π.appLE (Y₀.basicOpen (t J a)) (P.basicOpen (t' J a)) (hBO J a).le).hom
                    (inv0 a)) P' := by
        intro f
        refine AddSubmonoid.closure_induction (motive := fun y _ =>
          ∃ P' : MvPolynomial (Fin (M + 1)) Γ(T', ⊤), ∀ a,
            (P.presheaf.map (homOfLE (hDa a)).op).hom y =
              MvPolynomial.eval₂
                ((P.presheaf.map (homOfLE ((P.basicOpen_le (t' J a)).trans inf_le_right)).op).hom.comp
                  (q.app ⊤).hom)
                (fun l => (P.presheaf.map (homOfLE (P.basicOpen_le (t' J a))).op).hom (t' l a) *
                  (π.appLE (Y₀.basicOpen (t J a)) (P.basicOpen (t' J a)) (hBO J a).le).hom
                    (inv0 a)) P') ?_ ?_ ?_ (hgen _ (hVA3 J) f)
        · intro y hy
          obtain ⟨x, α, rfl⟩ := hy
          obtain ⟨Px, hPx⟩ := hVA4 J x
          choose invx hinvx hevx using hPx
          refine ⟨MvPolynomial.map c.appTop.hom Px * MvPolynomial.C α, fun a => ?_⟩
          have hi : invx a = inv0 a := uniq _ _ _ (hinvx a) (hinv0 a)
          have hx1 : (P.presheaf.map (homOfLE (hDa a)).op).hom ((π.app _).hom x) =
              (π.appLE (Y₀.basicOpen (t J a)) (P.basicOpen (t' J a)) (hBO J a).le).hom
                ((Y₀.presheaf.map (homOfLE (le_iSup (fun a' => Y₀.basicOpen (t J a')) a)).op).hom
                  x) := by
            rw [E_app, E_N2]
          rw [map_mul, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_C, MvPolynomial.eval₂_map]
          congr 1
          · rw [hx1, hevx a, hi, MvPolynomial.hom_eval₂]
            congr 1
            · exact RingHom.ext (K1 a)
            · funext l
              rw [map_mul, hres_t l a]
          · rw [E_res]
            rfl
        · exact ⟨0, fun a => by rw [map_zero, MvPolynomial.eval₂_zero]⟩
        · intro y z _ _ hy hz
          obtain ⟨P1, h1⟩ := hy
          obtain ⟨P2, h2⟩ := hz
          exact ⟨P1 + P2, fun a => by rw [map_add, h1 a, h2 a, MvPolynomial.eval₂_add]⟩
      have hsub : π ⁻¹ᵁ (⨆ a, Y₀.basicOpen (t J a)) ≤ ⨆ a, P.basicOpen (t' J a) := (hDJ J).ge
      obtain ⟨P', hP'⟩ := hgood ((P.presheaf.map (homOfLE hsub).op).hom f)
      refine ⟨P', fun a => ⟨_, hinv' a, ?_⟩⟩
      rw [← hP' a, E_res]

  have affbc : ∀ (κ₁ K₁ : Type u) [CommRing κ₁] [CommRing K₁] [Algebra κ₁ K₁] (X X' : Scheme.{u})
      (q : X ⟶ Spec (.of κ₁)) (π : X' ⟶ X) (q' : X' ⟶ Spec (.of K₁)),
      IsPullback π q' q (Spec.map (CommRingCat.ofHom (algebraMap κ₁ K₁))) →
      ∀ (O : X.Opens), IsAffineOpen O → letI := (wcCnSigma q O).toAlgebra;
      ∃ Θ : TensorProduct κ₁ Γ(X, O) K₁ ≃+* Γ(X', π ⁻¹ᵁ O), ∀ (a : Γ(X, O)) (t : K₁),
        Θ (a ⊗ₜ[κ₁] t) = (π.app O).hom a * wcCnSigma q' (π ⁻¹ᵁ O) t := by
    intro κ K _ _ _ X X' q π q' hpb O hO
    letI := (wcCnSigma q O).toAlgebra
    have hOle : O ≤ q ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have hW : (⊤ : (Spec (.of K)).Opens) ≤
        Spec.map (CommRingCat.ofHom (algebraMap κ K)) ⁻¹ᵁ ⊤ := by
      rw [Scheme.Hom.preimage_top]
    have heq : π ⁻¹ᵁ O = π ⁻¹ᵁ O ⊓ q' ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top, inf_top_eq]
    have hPB := Scheme.Hom.isPullback_resLE hpb hW hOle heq
    haveI : IsAffine (⊤ : (Spec (.of κ)).Opens) := isAffineOpen_top _
    haveI : IsAffine (⊤ : (Spec (.of K)).Opens) := isAffineOpen_top _
    haveI : IsAffine O := hO
    have hPO := isPushout_appTop_of_isPullback hPB
    have s1 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U),
        (f.resLE U V e).appTop ≫ V.topIso.hom = U.topIso.hom ≫ f.appLE U V e := by
      intro X Y f U V e
      simp only [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, Scheme.Opens.topIso_hom]
      erw [Scheme.Hom.resLE_appLE, Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
    have hPO2 := IsPushout.of_iso hPO (⊤ : (Spec (.of κ)).Opens).topIso O.topIso
      (⊤ : (Spec (.of K)).Opens).topIso (π ⁻¹ᵁ O).topIso (s1 _ _ _ _) (s1 _ _ _ _)
      (s1 _ _ _ _) (s1 _ _ _ _)
    have eσ : CommRingCat.ofHom (wcCnSigma q O) =
        (Scheme.ΓSpecIso (.of κ)).inv ≫ q.appLE ⊤ O hOle := by
      apply CommRingCat.hom_ext
      rfl
    have h2 : π ⁻¹ᵁ O ≤ q' ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have eσ' : CommRingCat.ofHom (wcCnSigma q' (π ⁻¹ᵁ O)) =
        (Scheme.ΓSpecIso (.of K)).inv ≫ q'.appLE ⊤ (π ⁻¹ᵁ O) h2 := by
      apply CommRingCat.hom_ext
      rfl
    have hσ : IsPushout (CommRingCat.ofHom (algebraMap κ Γ(X, O)))
        (CommRingCat.ofHom (algebraMap κ K)) (CommRingCat.ofHom (π.app O).hom)
        (CommRingCat.ofHom (wcCnSigma q' (π ⁻¹ᵁ O))) := by
      refine IsPushout.of_iso hPO2 (Scheme.ΓSpecIso (.of κ)) (Iso.refl _)
        (Scheme.ΓSpecIso (.of K)) (Iso.refl _) ?_ ?_ ?_ ?_
      · show _ = _ ≫ CommRingCat.ofHom (wcCnSigma q O)
        rw [eσ, Iso.hom_inv_id_assoc, Iso.refl_hom, Category.comp_id]
      · show Scheme.Hom.appLE _ ⊤ (Spec.map (CommRingCat.ofHom (algebraMap κ K)) ⁻¹ᵁ ⊤) le_rfl ≫ _
          = _
        rw [Scheme.Hom.appLE_eq_app]
        exact Scheme.ΓSpecIso_naturality _
      · rw [CommRingCat.ofHom_hom, Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
        exact Scheme.Hom.appLE_eq_app _
      · rw [eσ', Iso.hom_inv_id_assoc, Iso.refl_hom, Category.comp_id]
    have hT := CommRingCat.isPushout_tensorProduct κ Γ(X, O) K
    let e := IsPushout.isoIsPushout _ _ hT hσ
    have hl := IsPushout.inl_isoIsPushout_hom _ _ hT hσ
    have hr := IsPushout.inr_isoIsPushout_hom _ _ hT hσ
    refine ⟨e.commRingCatIsoToRingEquiv, fun a t => ?_⟩
    have ha : e.hom.hom (a ⊗ₜ[κ] (1 : K)) = (π.app O).hom a := by
      have := congrArg (fun φ => φ.hom a) hl
      exact this
    have ht : e.hom.hom ((1 : Γ(X, O)) ⊗ₜ[κ] t) = wcCnSigma q' (π ⁻¹ᵁ O) t := by
      have := congrArg (fun φ => φ.hom t) hr
      exact this
    have hsplit : a ⊗ₜ[κ] t = (a ⊗ₜ[κ] (1 : K)) * ((1 : Γ(X, O)) ⊗ₜ[κ] t) := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    rw [hsplit, map_mul]
    show e.hom.hom _ * e.hom.hom _ = _
    rw [ha, ht]

  have hpb := IsPullback.of_hasPullback h₀ (Spec.map (CommRingCat.ofHom (algebraMap κ A')))
  refine transport _ (Spec.map (CommRingCat.ofHom (algebraMap κ A'))) _
    (MorphismProperty.of_isPullback (P := @IsAffineHom) hpb.flip (isAffineHom_of_isAffine _))
    Limits.pullback.condition ?_
  intro D hD f
  obtain ⟨Θ, hΘ⟩ := affbc κ A' Y₀ _ h₀ _ _ hpb D hD
  rw [← Θ.apply_symm_apply f]
  generalize Θ.symm f = z
  induction z using TensorProduct.induction_on with
  | zero => rw [map_zero]; exact zero_mem _
  | tmul x α =>
    rw [hΘ]
    exact AddSubmonoid.subset_closure ⟨x, (Scheme.ΓSpecIso (.of A')).inv.hom α, rfl⟩
  | add z₁ z₂ h1 h2 => rw [map_add]; exact add_mem h1 h2

theorem wcpa_dj_lcp_us_va_closed : ∀ {Y P T Z : Scheme.{u}} (ι : Y ⟶ P) (q : P ⟶ T)
    (ψ : P ⟶ Z) (L : wcpaDjCoc Z) (W : T.Opens) (e : ℕ), IsClosedImmersion ι →
    wcpaDjVA q (wcpaDjCocPull ψ L) W e → wcpaDjVA (ι ≫ q) (wcpaDjCocPull (ι ≫ ψ) L) W e :=
by
  intro Y P T Z ι q ψ L W e hι hva
  obtain ⟨M, t, h1, h2, h3, h4⟩ := hva

  have hnat : ∀ (U U' : P.Opens) (h : U' ≤ U) (x : Γ(P, U)),
      (ι.app U').hom ((P.presheaf.map (homOfLE h).op).hom x) =
        (Y.presheaf.map (homOfLE (ι.preimage_mono h)).op).hom ((ι.app U).hom x) := by
    intro U U' h x
    have := congrArg (fun φ => φ.hom x) (ι.naturality (homOfLE h).op)
    exact this

  have hres : ∀ {X : Scheme.{u}} (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (y : Γ(X, A)),
      (X.presheaf.map (homOfLE h2).op).hom ((X.presheaf.map (homOfLE h1).op).hom y) =
        (X.presheaf.map (homOfLE (h2.trans h1)).op).hom y := by
    intro X A B C h1 h2 y
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Functor.map_comp]
    rfl
  have hcoe : ∀ {Y' : Scheme.{u}} (h : Y' ⟶ Z) (a b : Fin L.m),
      (((wcpaDjCocPull h L).g a b) :
        Γ(Y', (wcpaDjCocPull h L).V a ⊓ (wcpaDjCocPull h L).V b)) =
      (Y'.presheaf.map (homOfLE (show h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ≤ h ⁻¹ᵁ (L.V a ⊓ L.V b) from
        fun _ hx => hx)).op).hom ((h.app (L.V a ⊓ L.V b)).hom (L.g a b)) := fun _ _ _ => rfl

  obtain ⟨t', ht'⟩ : ∃ t' : Fin (M + 1) → ∀ a : Fin (wcpaDjCocPull ψ L).m,
      Γ(Y, ι ⁻¹ᵁ ((wcpaDjCocPull ψ L).V a ⊓ q ⁻¹ᵁ W)),
      ∀ J a, t' J a = (ι.app ((wcpaDjCocPull ψ L).V a ⊓ q ⁻¹ᵁ W)).hom (t J a) :=
    ⟨fun J a => (ι.app ((wcpaDjCocPull ψ L).V a ⊓ q ⁻¹ᵁ W)).hom (t J a), fun _ _ => rfl⟩

  have hD : ∀ J, (⨆ a : Fin (wcpaDjCocPull ψ L).m, Y.basicOpen (t' J a)) =
      ι ⁻¹ᵁ (⨆ a : Fin (wcpaDjCocPull ψ L).m, P.basicOpen (t J a)) := by
    intro J
    rw [Scheme.Hom.preimage_iSup]
    refine iSup_congr fun a => ?_
    rw [ht']
    exact (Scheme.Hom.preimage_basicOpen ι (t J a)).symm
  have := hι

  have hVA2 : ∀ a : Fin (wcpaDjCocPull ψ L).m, Ideal.span (Set.range (fun J => t' J a)) = ⊤ := by
    intro a
    have hr : Set.range (fun J => t' J a) =
        (ι.app ((wcpaDjCocPull ψ L).V a ⊓ q ⁻¹ᵁ W)).hom '' Set.range (fun J => t J a) := by
      rw [← Set.range_comp]
      exact congrArg Set.range (funext fun J => ht' J a)
    rw [hr, ← Ideal.map_span, h2 a, Ideal.map_top]

  have hVA4 : ∀ J (f : Γ(Y, ⨆ a : Fin (wcpaDjCocPull ψ L).m, Y.basicOpen (t' J a))),
      ∃ Q : MvPolynomial (Fin (M + 1)) Γ(T, W),
      ∀ a : Fin (wcpaDjCocPull ψ L).m, ∃ inv : Γ(Y, Y.basicOpen (t' J a)),
        inv * (Y.presheaf.map (homOfLE (Y.basicOpen_le (t' J a))).op).hom (t' J a) = 1 ∧
        (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (t' J a')) a)).op).hom f =
          MvPolynomial.eval₂
            ((Y.presheaf.map (homOfLE (show Y.basicOpen (t' J a) ≤ (ι ≫ q) ⁻¹ᵁ W from
                (Y.basicOpen_le (t' J a)).trans (ι.preimage_mono inf_le_right))).op).hom.comp
              ((ι ≫ q).app W).hom)
            (fun l => (Y.presheaf.map (homOfLE (Y.basicOpen_le (t' J a))).op).hom (t' l a) * inv)
            Q := by
    intro J f'
    have hDle : ι ⁻¹ᵁ (⨆ a : Fin (wcpaDjCocPull ψ L).m, P.basicOpen (t J a)) ≤
        ⨆ a : Fin (wcpaDjCocPull ψ L).m, Y.basicOpen (t' J a) := (hD J).ge
    obtain ⟨ft, hft⟩ := Scheme.Hom.app_surjective ι _ (h3 J)
      ((Y.presheaf.map (homOfLE hDle).op).hom f')
    obtain ⟨Q, hQ⟩ := h4 J ft
    refine ⟨Q, fun a => ?_⟩
    obtain ⟨inv, hinv, hev⟩ := hQ a
    have hB : Y.basicOpen (t' J a) ≤ ι ⁻¹ᵁ P.basicOpen (t J a) := by
      rw [ht', Scheme.Hom.preimage_basicOpen]
    obtain ⟨ρ, hρ⟩ : ∃ ρ : Γ(P, P.basicOpen (t J a)) →+* Γ(Y, Y.basicOpen (t' J a)),
        ∀ x, ρ x = (Y.presheaf.map (homOfLE hB).op).hom
          ((ι.app (P.basicOpen (t J a))).hom x) :=
      ⟨(Y.presheaf.map (homOfLE hB).op).hom.comp (ι.app (P.basicOpen (t J a))).hom,
        fun _ => rfl⟩
    have hvar : ∀ l, ρ ((P.presheaf.map (homOfLE (P.basicOpen_le (t J a))).op).hom (t l a)) =
        (Y.presheaf.map (homOfLE (Y.basicOpen_le (t' J a))).op).hom (t' l a) := by
      intro l
      rw [hρ, hnat, hres, ht' l a]
