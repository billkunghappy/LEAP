        rw [this]; exact hC
      · exact absurd h hne
    refine ⟨?_, ?_⟩
    · intro x hx E hE hPE e he hfe
      by_cases hxc : IsClosed ({x} : Set X)
      · exact HC x hxc hx E hE hPE e he hfe
      · have hz : ∃ z ∈ closure ({x} : Set X), z ≠ x := by
          by_contra hcon
          apply hxc
          have hcl : closure ({x} : Set X) = {x} := by
            apply Set.Subset.antisymm _ subset_closure
            intro z hz
            by_contra hzx
            exact hcon ⟨z, hz, hzx⟩
          rw [← hcl]; exact isClosed_closure
        obtain ⟨z, hz, hzx⟩ := hz
        have hxz : x ⤳ z := specializes_iff_mem_closure.mpr hz
        have hC := T1 x z hxz (Ne.symm hzx)
        have hnP : ¬ P (closure ({x} : Set X)) := fun hP => hx _ hC hP (subset_closure rfl)
        obtain ⟨e', he', he'c⟩ :=
          (isClosed_of_mem_irreducibleComponents E hE).exists_closed_singleton ⟨e, he⟩
        have hfe' : f e' = f e := HA E hE hPE e' he' e he
        have hcl : IsClosed ({f e'} : Set Y) := by
          have := hfc _ he'c
          rwa [Set.image_singleton] at this
        have hconst : ∀ y ∈ closure ({x} : Set X), f y = f e' := by
          intro y hy
          have h1 : f y ∈ closure (f '' {x}) :=
            image_closure_subset_closure_image hcont ⟨y, hy, rfl⟩
          rw [Set.image_singleton, hfe, ← hfe', hcl.closure_eq] at h1
          exact h1
        obtain ⟨a, ha, b, hb, hab⟩ := HB _ hC hnP
        exact hab ((hconst a ha).trans (hconst b hb).symm)
    · intro x x' hx' hsp hfx
      by_contra hne
      have hC := T1 x' x hsp hne
      have hnP : ¬ P (closure ({x'} : Set X)) := fun hP => hx' _ hC hP (subset_closure rfl)
      have hxc : IsClosed ({x} : Set X) := by
        rw [← closure_subset_iff_isClosed]
        intro w hw
        have hxw : x ⤳ w := specializes_iff_mem_closure.mpr hw
        rcases Hch x' x w hsp hxw with h | h
        · exact absurd h hne
        · exact h.symm
      have hcl : IsClosed ({f x} : Set Y) := by
        have := hfc _ hxc
        rwa [Set.image_singleton] at this
      have hconst : ∀ y ∈ closure ({x'} : Set X), f y = f x := by
        intro y hy
        have h1 : f y ∈ closure (f '' {x'}) :=
          image_closure_subset_closure_image hcont ⟨y, hy, rfl⟩
        rw [Set.image_singleton, hfx, hcl.closure_eq] at h1
        exact h1
      obtain ⟨a, ha, b, hb, hab⟩ := HB _ hC hnP
      exact hab ((hconst a ha).trans (hconst b hb).symm)

  obtain ⟨hss, -, -, -, -, hHAF, -, -, -⟩ := hSH
  obtain ⟨HA, HB, HC⟩ := hABC
  have hP1' : ∀ V : (Limits.pullback uu s).Opens, Function.Bijective (φs.app V).hom := hP1
  haveI hpu₁ : IsProper u₁ := hss.2.1
  haveI := hprop
  haveI : IsProper (φs ≫ Limits.pullback.snd uu s) := by rw [h2]; infer_instance
