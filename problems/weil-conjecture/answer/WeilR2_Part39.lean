        ⟨hPY.lift _ _ wY, hPY.lift_fst _ _ _, hPY.lift_snd _ _ _⟩
      obtain ⟨ψX, hψX1, hψX2⟩ : ∃ ψX : QX ⟶ PX, ψX ≫ aX = a'X ∧ ψX ≫ sX = s'X ≫ b :=
        ⟨hPX.lift _ _ wX, hPX.lift_fst _ _ _, hPX.lift_snd _ _ _⟩
      have SY : IsPullback ψY s'Y sY b := by
        refine IsPullback.of_right ?_ hψY2 hPY
        rw [hψY1, hb]; exact hQY
      have SX : IsPullback ψX s'X sX b := by
        refine IsPullback.of_right ?_ hψX2 hPX
        rw [hψX1, hb]; exact hQX
      have hcomm : ψX ≫ c = c' ≫ ψY := by
        apply hPY.hom_ext
        · rw [Category.assoc, hca, reassoc_of% hψX1, Category.assoc, hψY1, hca']
        · rw [Category.assoc, hcs, hψX2, Category.assoc, hψY2, reassoc_of% hcs']
      have top : IsPullback ψX c' c ψY := by
        refine IsPullback.of_bot ?_ hcomm SY
        rw [hcs', hcs]; exact SX
      exact MorphismProperty.of_isPullback (P := @IsClosedImmersion) top hc
  have t_restrict : ∀ {X Y T T' PX PY : Scheme.{u}} (h : X ⟶ T) (k : Y ⟶ T) (p : X ⟶ Y)
        (g : T' ⟶ T) (aX : PX ⟶ X) (sX : PX ⟶ T') (aY : PY ⟶ Y) (sY : PY ⟶ T'),
        IsPullback aX sX h g → IsPullback aY sY k g →
        ∀ (c : PX ⟶ PY), c ≫ sY = sX → c ≫ aY = aX ≫ p → ∀ (V : Y.Opens),
        ∃ (a'X : (c ⁻¹ᵁ (aY ⁻¹ᵁ V)).toScheme ⟶ (p ⁻¹ᵁ V).toScheme),
          IsPullback a'X ((c ⁻¹ᵁ (aY ⁻¹ᵁ V)).ι ≫ sX) ((p ⁻¹ᵁ V).ι ≫ h) g ∧
          IsPullback (aY ∣_ V) ((aY ⁻¹ᵁ V).ι ≫ sY) (V.ι ≫ k) g ∧
          (c ∣_ (aY ⁻¹ᵁ V)) ≫ ((aY ⁻¹ᵁ V).ι ≫ sY) = (c ⁻¹ᵁ (aY ⁻¹ᵁ V)).ι ≫ sX ∧
          (c ∣_ (aY ⁻¹ᵁ V)) ≫ (aY ∣_ V) = a'X ≫ (p ∣_ V) := by
      intro X Y T T' PX PY h k p g aX sX aY sY hPX hPY c hcs hca V
      have hO : c ⁻¹ᵁ (aY ⁻¹ᵁ V) = aX ⁻¹ᵁ (p ⁻¹ᵁ V) := by
        rw [← Scheme.Hom.comp_preimage, hca, Scheme.Hom.comp_preimage]
      have HX := (isPullback_morphismRestrict aX (p ⁻¹ᵁ V)).paste_vert hPX
      refine ⟨(PX.isoOfEq hO).hom ≫ (aX ∣_ (p ⁻¹ᵁ V)), ?_,
        (isPullback_morphismRestrict aY V).paste_vert hPY, ?_, ?_⟩
      · refine IsPullback.of_iso HX (PX.isoOfEq hO).symm (Iso.refl _) (Iso.refl _) (Iso.refl _)
