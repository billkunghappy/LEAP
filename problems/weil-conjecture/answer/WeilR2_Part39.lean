theorem wcpa_dj_sso_equisingular_stab : ∀ (Y X : Scheme.{u}) (u : X ⟶ Y) (n r m : ℕ) (σ : Fin n → (Y ⟶ X)) (ρ : Fin m → (Y ⟶ X)) (F : Fin r → Set X) (y η : Y) (K₀ K₁ : Type u) [Field K₀] [Field K₁] (s₀ : Spec (.of K₀) ⟶ Y) (s₁ : Spec (.of K₁) ⟶ Y), Flat u → s₀ (IsLocalRing.closedPoint K₀) = y → s₁ (IsLocalRing.closedPoint K₁) = η → η ⤳ y → (∀ i, σ i ≫ u = 𝟙 Y) → (∀ a, ρ a ≫ u = 𝟙 Y) → (∀ j, IsClosed (F j)) → (∀ j, (Limits.pullback.fst u s₁) ⁻¹' (F j) ∈ irreducibleComponents ↥(Limits.pullback u s₁)) → (∀ E ∈ irreducibleComponents ↥(Limits.pullback u s₁), ∃ j, E = (Limits.pullback.fst u s₁) ⁻¹' (F j)) → (∀ w : ↥(Limits.pullback u s₁), (∃ j j', j ≠ j' ∧ Limits.pullback.fst u s₁ w ∈ F j ∧ Limits.pullback.fst u s₁ w ∈ F j') → ∃ a, Limits.pullback.fst u s₁ w = ρ a η) → (∀ j, IsIrreducible ((Limits.pullback.fst u s₀) ⁻¹' (F j))) → (∀ z : X, u z = y → (∃ j j', j ≠ j' ∧ z ∈ F j ∧ z ∈ F j') → ∃ a, z = ρ a y) → (∀ a j, ρ a y ∈ F j ↔ ρ a η ∈ F j) → (∀ i j, σ i y ∈ F j ↔ σ i η ∈ F j) → (∀ a b, ρ a y = ρ b y ↔ ρ a η = ρ b η) → (∀ j, ∃ a, ρ a η ∈ F j ∧ ∀ j', j' ≠ j → ρ a η ∉ F j') → (∀ j, (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u s₀) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K₀) MvPolynomial.gradedAlgebra), IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = (Limits.pullback.fst u s₀) ⁻¹' (F j) ∧ θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K₀) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K₀ ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K₀ 0))) = ι ≫ Limits.pullback.snd u s₀) → (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u s₁) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K₁) MvPolynomial.gradedAlgebra), IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = (Limits.pullback.fst u s₁) ⁻¹' (F j) ∧ θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K₁) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K₁ ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K₁ 0))) = ι ≫ Limits.pullback.snd u s₁)) → wcpaDjSolStab u n σ K₁ s₁ → wcpaDjSolStab u n σ K₀ s₀ :=
by
  intro Y X u n r m σ ρ F y η K₀ K₁ _ _ s₀ s₁ hfl hs₀ hs₁ hηy hσ hρ hFcl hEc hEall hTWO₁ hDirr
    hTWO₀ hρinc hσinc hρeq hANCH hP1 hStab₁
  classical

  have s1 : ∀ {W : Type u} [TopologicalSpace W] (r : ℕ) (G : Fin r → Set W),
      (∀ j, IsClosed (G j)) → (∀ j, IsIrreducible (G j)) → (∀ x : W, ∃ j, x ∈ G j) →
      (∀ j, ∃ x ∈ G j, ∀ j', j' ≠ j → x ∉ G j') →
      (∀ E ∈ irreducibleComponents W, ∃ j, E = G j) ∧ (∀ j, G j ∈ irreducibleComponents W) ∧
      (∀ j, G j ∩ closure (G j)ᶜ = {x | x ∈ G j ∧ ∃ j', j' ≠ j ∧ x ∈ G j'}) := by
    intro W _ r G hcl hirr hcov hanc
    choose xa hxa hxa' using hanc
    have P0 : ∀ S : Set W, IsIrreducible S → ∃ j, S ⊆ G j := by
      intro S hS
      obtain ⟨z, hz, hSz⟩ := (isIrreducible_iff_sUnion_isClosed.mp hS) (Finset.univ.image G)
        (by
          intro z hz
          obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hz
          exact hcl j)
        (by
          intro x _
          obtain ⟨j, hj⟩ := hcov x
          exact Set.mem_sUnion.mpr ⟨G j, by simp, hj⟩)
      obtain ⟨j, _, rfl⟩ := Finset.mem_image.mp hz
      exact ⟨j, hSz⟩
    have hb : ∀ j, G j ∈ irreducibleComponents W := by
      intro j
      refine ⟨hirr j, fun S hS hjS => ?_⟩
      obtain ⟨j', hj'⟩ := P0 S hS
      by_cases h : j' = j
      · subst h; exact hj'
      · exact absurd (hj' (hjS (hxa j))) (hxa' j j' h)
    refine ⟨?_, hb, ?_⟩
    · intro E hE
      obtain ⟨j, hj⟩ := P0 E hE.1
      exact ⟨j, Set.Subset.antisymm hj (hE.2 (hirr j) hj)⟩
    · intro j
      ext x
      constructor
      · rintro ⟨hx, hxc⟩
        have hU : IsClosed (⋃ j' ∈ {j' | j' ≠ j}, G j') :=
          (Set.toFinite _).isClosed_biUnion (fun j' _ => hcl j')
        have hsub : (G j)ᶜ ⊆ ⋃ j' ∈ {j' | j' ≠ j}, G j' := by
          intro z hz
          obtain ⟨j', hj'⟩ := hcov z
          refine Set.mem_biUnion (x := j') ?_ hj'
          intro h
          subst h
          exact hz hj'
        have h2 := closure_minimal hsub hU hxc
        obtain ⟨j', hj'ne, hxj'⟩ := Set.mem_iUnion₂.mp h2
        exact ⟨hx, j', hj'ne, hxj'⟩
      · rintro ⟨hx, j', hj'ne, hxj'⟩
        refine ⟨hx, ?_⟩
        rw [mem_closure_iff]
        intro o ho hxo
        obtain ⟨z, _, hz2⟩ := (hirr j').isPreirreducible o (G j)ᶜ ho (hcl j).isOpen_compl
          ⟨x, hxj', hxo⟩ ⟨xa j', hxa j', hxa' j' j (Ne.symm hj'ne)⟩
        exact ⟨z, hz2⟩

  have s2 : ∀ (ρ' : Y ⟶ X) (K : Type u) [Field K] (s : Spec (.of K) ⟶ Y), ρ' ≫ u = 𝟙 Y →
      ∃ x₀ : ↥(Limits.pullback u s),
        Limits.pullback.fst u s x₀ = ρ' (s (IsLocalRing.closedPoint K)) ∧
        ∀ x : ↥(Limits.pullback u s),
          Limits.pullback.fst u s x = ρ' (s (IsLocalRing.closedPoint K)) → x = x₀ := by
    intro ρ' K _ s hρ'
    let τ : Spec (.of K) ⟶ Limits.pullback u s :=
      Limits.pullback.lift (s ≫ ρ') (𝟙 _)
        (by rw [Category.assoc, hρ', Category.comp_id, Category.id_comp])
    have hτ1 : τ ≫ Limits.pullback.fst u s = s ≫ ρ' := Limits.pullback.lift_fst _ _ _
    have hτ2 : τ ≫ Limits.pullback.snd u s = 𝟙 _ := Limits.pullback.lift_snd _ _ _
    refine ⟨τ (IsLocalRing.closedPoint K), ?_, ?_⟩
    · have e : ∀ p, Limits.pullback.fst u s (τ p) = ρ' (s p) := fun p => by
        rw [← Scheme.Hom.comp_apply, hτ1, Scheme.Hom.comp_apply]
      exact e _
    · intro x hx
      have hpb : IsPullback τ s (Limits.pullback.fst u s) ρ' := by
        refine IsPullback.of_right ?_ hτ1 (IsPullback.of_hasPullback u s).flip
        rw [hτ2, hρ']
        exact IsPullback.id_horiz s
      obtain ⟨p, hp1, -⟩ := Scheme.exists_preimage_of_isPullback hpb x _ hx
      rw [← hp1, Subsingleton.elim p (IsLocalRing.closedPoint K)]

  have s3 : ∀ (A : Set (Fin m)) (g₀ : Fin m → ↥(Limits.pullback u s₀))
      (g₁ : Fin m → ↥(Limits.pullback u s₁)),
      (∀ a ∈ A, ∀ b ∈ A, g₀ a = g₀ b ↔ g₁ a = g₁ b) → (g₀ '' A).ncard = (g₁ '' A).ncard := by
    intro A g₀ g₁ h
    apply Set.ncard_congr (fun z hz => g₁ (Classical.choose ((Set.mem_image g₀ A z).mp hz)))
    · intro z hz
      exact ⟨_, (Classical.choose_spec ((Set.mem_image g₀ A z).mp hz)).1, rfl⟩
    · intro z₁ z₂ hz₁ hz₂ he
      have c1 := Classical.choose_spec ((Set.mem_image g₀ A z₁).mp hz₁)
      have c2 := Classical.choose_spec ((Set.mem_image g₀ A z₂).mp hz₂)
      rw [← c1.2, ← c2.2]
      exact (h _ c1.1 _ c2.1).mpr he
    · rintro _ ⟨a, ha, rfl⟩
      refine ⟨g₀ a, ⟨a, ha, rfl⟩, ?_⟩
      have hc := Classical.choose_spec ((Set.mem_image g₀ A (g₀ a)).mp ⟨a, ha, rfl⟩)
      exact (h _ hc.1 _ ha).mp hc.2

  have hpt0 : ∀ p : ↥(Spec (.of K₀)), s₀ p = y := fun p => by
    rw [Subsingleton.elim p (IsLocalRing.closedPoint K₀), hs₀]
  have hpt1 : ∀ p : ↥(Spec (.of K₁)), s₁ p = η := fun p => by
    rw [Subsingleton.elim p (IsLocalRing.closedPoint K₁), hs₁]
  have hu0 : ∀ x : ↥(Limits.pullback u s₀), u (Limits.pullback.fst u s₀ x) = y := by
    intro x
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply, hpt0]

  choose l0 hl0 hl0u using fun a => s2 (ρ a) K₀ s₀ (hρ a)
  choose l1 hl1 hl1u using fun a => s2 (ρ a) K₁ s₁ (hρ a)
  choose m0 hm0 _ using fun i => s2 (σ i) K₀ s₀ (hσ i)
  choose m1 hm1 _ using fun i => s2 (σ i) K₁ s₁ (hσ i)
  simp only [hs₀, hs₁] at hl0 hl0u hl1 hl1u hm0 hm1

  choose aj haj haj' using hANCH

  have cov1 : ∀ w : ↥(Limits.pullback u s₁), ∃ j, Limits.pullback.fst u s₁ w ∈ F j := by
    intro w
    obtain ⟨C, hC, hwC⟩ :=
      exists_mem_irreducibleComponents_subset_of_isIrreducible {w} isIrreducible_singleton
    obtain ⟨j, rfl⟩ := hEall C hC
    exact ⟨j, hwC (Set.mem_singleton w)⟩
  have cov0 : ∀ x : ↥(Limits.pullback u s₀), ∃ j, Limits.pullback.fst u s₀ x ∈ F j := by
    intro x
    have := hfl
    have h1 : η ⤳ u (Limits.pullback.fst u s₀ x) := by rw [hu0]; exact hηy
    obtain ⟨z', hz'z, hz'η⟩ := Flat.generalizingMap u h1
    have hr : z' ∈ Set.range (Limits.pullback.fst u s₁) := by
      rw [Scheme.Pullback.range_fst]
      exact ⟨IsLocalRing.closedPoint K₁, by rw [hs₁, hz'η]⟩
    obtain ⟨w, rfl⟩ := hr
    obtain ⟨j, hj⟩ := cov1 w
    exact ⟨j, hz'z.mem_closed (hFcl j) hj⟩

  have anc0 : ∀ j, ∃ x ∈ (Limits.pullback.fst u s₀) ⁻¹' (F j),
      ∀ j', j' ≠ j → x ∉ (Limits.pullback.fst u s₀) ⁻¹' (F j') := by
    intro j
    refine ⟨l0 (aj j), ?_, ?_⟩
    · rw [Set.mem_preimage, hl0, hρinc]
      exact haj j
    · intro j' hj' h
      rw [Set.mem_preimage, hl0, hρinc] at h
      exact haj' j j' hj' h
  have anc1 : ∀ j, ∃ x ∈ (Limits.pullback.fst u s₁) ⁻¹' (F j),
      ∀ j', j' ≠ j → x ∉ (Limits.pullback.fst u s₁) ⁻¹' (F j') := by
    intro j
    refine ⟨l1 (aj j), ?_, ?_⟩
    · rw [Set.mem_preimage, hl1]
      exact haj j
    · intro j' hj' h
      rw [Set.mem_preimage, hl1] at h
      exact haj' j j' hj' h

  have S0 := s1 r (fun j => (Limits.pullback.fst u s₀) ⁻¹' (F j))
    (fun j => (hFcl j).preimage (Limits.pullback.fst u s₀).continuous) hDirr cov0 anc0
  have S1 := s1 r (fun j => (Limits.pullback.fst u s₁) ⁻¹' (F j))
    (fun j => (hFcl j).preimage (Limits.pullback.fst u s₁).continuous) (fun j => (hEc j).1)
    cov1 anc1
  have a0 : ∀ E ∈ irreducibleComponents ↥(Limits.pullback u s₀),
      ∃ j, E = (Limits.pullback.fst u s₀) ⁻¹' (F j) := S0.1
  have c0 : ∀ j, (Limits.pullback.fst u s₀) ⁻¹' (F j) ∩
      closure ((Limits.pullback.fst u s₀) ⁻¹' (F j))ᶜ =
      {x | x ∈ (Limits.pullback.fst u s₀) ⁻¹' (F j) ∧
        ∃ j', j' ≠ j ∧ x ∈ (Limits.pullback.fst u s₀) ⁻¹' (F j')} := S0.2.2
  have c1 : ∀ j, (Limits.pullback.fst u s₁) ⁻¹' (F j) ∩
      closure ((Limits.pullback.fst u s₁) ⁻¹' (F j))ᶜ =
      {x | x ∈ (Limits.pullback.fst u s₁) ⁻¹' (F j) ∧
        ∃ j', j' ≠ j ∧ x ∈ (Limits.pullback.fst u s₁) ⁻¹' (F j')} := S1.2.2

  unfold wcpaDjSolStab at hStab₁ ⊢
  intro D hD hPD
  obtain ⟨j, rfl⟩ := a0 D hD
  have H1 := hStab₁ _ (hEc j) (hP1 j hPD)

  have pat0 : ∀ a b, l0 a = l0 b ↔ ρ a y = ρ b y := fun a b =>
    ⟨fun h => by rw [← hl0 a, ← hl0 b, h], fun h => hl0u b (l0 a) (by rw [hl0, h])⟩
  have pat1 : ∀ a b, l1 a = l1 b ↔ ρ a η = ρ b η := fun a b =>
    ⟨fun h => by rw [← hl1 a, ← hl1 b, h], fun h => hl1u b (l1 a) (by rw [hl1, h])⟩
  have hB0 : (Limits.pullback.fst u s₀) ⁻¹' (F j) ∩
      closure ((Limits.pullback.fst u s₀) ⁻¹' (F j))ᶜ =
      l0 '' {a | ρ a η ∈ F j ∧ ∃ j', j' ≠ j ∧ ρ a η ∈ F j'} := by
    rw [c0 j]
    ext x
    constructor
    · rintro ⟨hx, j', hj', hxj'⟩
      obtain ⟨a, ha⟩ := hTWO₀ (Limits.pullback.fst u s₀ x) (hu0 x) ⟨j, j', Ne.symm hj', hx, hxj'⟩
      refine ⟨a, ⟨?_, j', hj', ?_⟩, (hl0u a x ha).symm⟩
      · rw [← hρinc, ← ha]; exact hx
      · rw [← hρinc, ← ha]; exact hxj'
    · rintro ⟨a, ⟨ha1, j', hj', ha2⟩, rfl⟩
      refine ⟨?_, j', hj', ?_⟩
      · rw [Set.mem_preimage, hl0, hρinc]; exact ha1
      · rw [Set.mem_preimage, hl0, hρinc]; exact ha2
  have hB1 : (Limits.pullback.fst u s₁) ⁻¹' (F j) ∩
      closure ((Limits.pullback.fst u s₁) ⁻¹' (F j))ᶜ =
      l1 '' {a | ρ a η ∈ F j ∧ ∃ j', j' ≠ j ∧ ρ a η ∈ F j'} := by
    rw [c1 j]
    ext x
    constructor
    · rintro ⟨hx, j', hj', hxj'⟩
      obtain ⟨a, ha⟩ := hTWO₁ x ⟨j, j', Ne.symm hj', hx, hxj'⟩
      refine ⟨a, ⟨?_, j', hj', ?_⟩, (hl1u a x ha).symm⟩
      · rw [← ha]; exact hx
      · rw [← ha]; exact hxj'
    · rintro ⟨a, ⟨ha1, j', hj', ha2⟩, rfl⟩
      refine ⟨?_, j', hj', ?_⟩
      · rw [Set.mem_preimage, hl1]; exact ha1
      · rw [Set.mem_preimage, hl1]; exact ha2
  have hN : ((Limits.pullback.fst u s₀) ⁻¹' (F j) ∩
      closure ((Limits.pullback.fst u s₀) ⁻¹' (F j))ᶜ).ncard =
      ((Limits.pullback.fst u s₁) ⁻¹' (F j) ∩
      closure ((Limits.pullback.fst u s₁) ⁻¹' (F j))ᶜ).ncard := by
    rw [hB0, hB1]
    exact s3 _ l0 l1 (fun a _ b _ => by rw [pat0, pat1, hρeq])

  have hM : Nat.card {i : Fin n // ∃ x ∈ (Limits.pullback.fst u s₀) ⁻¹' (F j),
        ∃ p : ↥(Spec (.of K₀)), Limits.pullback.fst u s₀ x = σ i (s₀ p)} =
      Nat.card {i : Fin n // ∃ x ∈ (Limits.pullback.fst u s₁) ⁻¹' (F j),
        ∃ p : ↥(Spec (.of K₁)), Limits.pullback.fst u s₁ x = σ i (s₁ p)} := by
    apply Nat.card_congr
    apply Equiv.subtypeEquivRight
    intro i
    constructor
    · rintro ⟨x, hx, p, hp⟩
      refine ⟨m1 i, ?_, IsLocalRing.closedPoint K₁, by rw [hm1, hs₁]⟩
      rw [Set.mem_preimage, hm1, ← hσinc, ← hpt0 p, ← hp]
      exact hx
    · rintro ⟨x, hx, p, hp⟩
      refine ⟨m0 i, ?_, IsLocalRing.closedPoint K₀, by rw [hm0, hs₀]⟩
      rw [Set.mem_preimage, hm0, hσinc, ← hpt1 p, ← hp]
      exact hx
  rw [hN, hM]
  exact H1

theorem wcpa_dj_sso_generic_spread : ∀ (T Z : Scheme.{u}) [IsLocallyNoetherian T] (u : Z ⟶ T) (n : ℕ) (τ : Fin n → (T ⟶ Z)), Flat u → IsProper u → LocallyOfFinitePresentation u → (∀ i, τ i ≫ u = 𝟙 T) → ∀ W₀ : T.Opens, (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T), Set.range ⇑s ⊆ (W₀ : Set T) → wcpaDjSolSS u K s) → (∀ (i j : Fin n) (t : T), t ∈ W₀ → i ≠ j → τ i t ≠ τ j t) → (∀ (j : Fin n) (t : T), t ∈ W₀ → ∃ W : Z.Opens, τ j t ∈ W ∧ SmoothOfRelativeDimension 1 (W.ι ≫ u)) → ∀ t : T, t ∈ W₀ → (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T), s (IsLocalRing.closedPoint K) = t → wcpaDjSolStab u n τ K s) → ∃ O : T.Opens, t ∈ O ∧ ∀ y : T, y ∈ O → t ⤳ y → ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T), s (IsLocalRing.closedPoint K) = y → wcpaDjSolStab u n τ K s :=
by
  intro T Z _ u n τ hfl hpr hfp hτ W₀ hSS hdis hsm t ht hstab
  classical

  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]
  have spu : ∀ (X P V C : Scheme.{u}) (f : X ⟶ P) (b : V ⟶ P)
      (ψ : C ⟶ X) (g : C ⟶ V) (σ : P ⟶ X) (τ : V ⟶ C), IsPullback ψ g f b → σ ≫ f = 𝟙 P →
      τ ≫ g = 𝟙 V → τ ≫ ψ = b ≫ σ → ∀ c : C, ψ c = σ (b (g c)) → c = τ (g c) := by
    intro X P V C f b ψ g σ τ H1 H2 H3 H4 c h
    have hgτ : ∀ x : V, g (τ x) = x := by
      intro x
      rw [← Scheme.Hom.comp_apply, H3]
      rfl
    have hout : IsPullback (τ ≫ g) b b (σ ≫ f) := by
      rw [H3, H2]
      exact IsPullback.id_horiz b
    have hsq : IsPullback τ b ψ σ := IsPullback.of_right hout H4 H1.flip
    obtain ⟨p, hp, _⟩ := Scheme.exists_preimage_of_isPullback hsq c (b (g c)) h
    have hg : g c = p := by rw [← hp, hgτ]
    rw [hg, hp]
  have s3h : ∀ {X Y S : Scheme.{u}} (i : X ⟶ Y) [IsIso i] (p : X ⟶ S) (q : Y ⟶ S), i ≫ q = p →
      ∀ (W' : Y.Opens), SmoothOfRelativeDimension 1 (W'.ι ≫ q) →
        SmoothOfRelativeDimension 1 ((i ⁻¹ᵁ W').ι ≫ p) := by
    intro X Y S i _ p q hi W' hW'
    have hfac' : (i ⁻¹ᵁ W').ι ≫ p = (i ∣_ W') ≫ (W'.ι ≫ q) := by
      rw [← hi, ← Category.assoc, ← morphismRestrict_ι, Category.assoc]
    have hpb : IsPullback (i ∣_ W') ((i ∣_ W') ≫ (W'.ι ≫ q)) (W'.ι ≫ q) (𝟙 S) :=
      IsPullback.of_horiz_isIso ⟨by rw [Category.comp_id]⟩
    rw [hfac']
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) hpb hW'
  have hcomap : ∀ (A B : Type u) [CommRing A] [CommRing B] [IsLocalRing A] [IsLocalRing B]
      (σ : A ≃+* B) (n : ℕ), IsLocalRing.maximalIdeal A ^ n ≤
        Ideal.comap (σ : A →+* B) (IsLocalRing.maximalIdeal B ^ n) := by
    intro A B _ _ _ _ σ n
    rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
    apply Ideal.pow_right_mono
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    simp only [Ideal.mem_comap, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at hx ⊢
    intro h
    exact hx ((MulEquiv.isUnit_map (σ : A ≃* B)).mp h)
