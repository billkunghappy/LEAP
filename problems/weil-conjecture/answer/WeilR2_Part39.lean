  obtain ⟨T, hT⟩ := wcpa_dj_lmga_mc_fibre_finite (IsLocalRing.ResidueField ↥W') u'
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W')))) hss'
  have hfex : ∀ w : ↥(Limits.pullback u'
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))))),
