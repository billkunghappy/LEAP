  have hφpre' : ∀ a J, φ ⁻¹ᵁ wcpaLspD R M J ⊓ (Lc.V a ⊓ uu ⁻¹ᵁ ⊤) = Z.basicOpen (t J a) :=
    hφpre
  have hφrel' : ∀ a J L (O : Z.Opens) (hO : O ≤ φ ⁻¹ᵁ wcpaLspD R M J)
