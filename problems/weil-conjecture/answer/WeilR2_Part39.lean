    intro J f
    obtain ⟨P, hP⟩ := hVA4 J f
    choose inv hinv hf using hP
    refine ⟨MvPolynomial.eval₂ (((wcpaLspP R M).presheaf.map
      (homOfLE (le_top : wcpaLspD R M J ≤ ⊤)).op).hom.comp (wcpaLspStr R M).appTop.hom)
