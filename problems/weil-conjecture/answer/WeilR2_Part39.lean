import WeilR2_Part38
set_option maxHeartbeats 4000000

open CategoryTheory AlgebraicGeometry

theorem wcpa_dj_lge_cbcm_dd_zero : ∀ (Y : Scheme.{u}) (L : wcpaDjCoc Y) (O : Y.Opens) (e p : ℕ), wcpaDjCocOK L → ∀ z : wcCbcmC L O p, wcCbcmD L O e (p + 1) (wcCbcmD L O e p z) = 0 :=
by
  intro Y L O e p hOK z
  have hsA : ∀ {n : ℕ} (c : Fin (n + 1)) (i : Fin n),
      ((c.succAbove i : Fin (n + 1)) : ℕ) = if (i : ℕ) < (c : ℕ) then (i : ℕ) else (i : ℕ) + 1 := by
    intro n c i
    unfold Fin.succAbove
    by_cases h : (i : ℕ) < (c : ℕ)
    · have h' : Fin.castSucc i < c := by rw [Fin.lt_def]; simpa using h
      rw [if_pos h', if_pos h]; simp
    · have h' : ¬ Fin.castSucc i < c := by rw [Fin.lt_def]; simpa using h
      rw [if_neg h', if_neg h]; simp
  have hfaceq : ∀ {n : ℕ} (c1 d1 : Fin (n + 1 + 1)) (c2 d2 : Fin (n + 1)),
      (∀ x : Fin n, ((c1.succAbove (c2.succAbove x) : Fin (n + 1 + 1)) : ℕ) =
        ((d1.succAbove (d2.succAbove x) : Fin (n + 1 + 1)) : ℕ)) →
      (Fin.succAboveOrderEmb c2).trans (Fin.succAboveOrderEmb c1) =
        (Fin.succAboveOrderEmb d2).trans (Fin.succAboveOrderEmb d1) :=
    fun c1 d1 c2 d2 h => RelEmbedding.ext (fun x => Fin.ext (h x))
  have hres : ∀ (U V W : Y.Opens) (h1 : U ≤ V) (h2 : V ≤ W) (x : Γ(Y, W)),
      (Y.presheaf.map (homOfLE h1).op).hom ((Y.presheaf.map (homOfLE h2).op).hom x) =
        (Y.presheaf.map (homOfLE (h1.trans h2)).op).hom x := by
    intro U V W h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  have s1 : ∀ (R : Type u) [CommRing R] (w : (Fin (p + 1) ↪o Fin (p + 1 + 1 + 1)) → R),
      ∑ k : Fin (p + 1 + 1), (-1 : R) ^ (k : ℕ) * ∑ l : Fin (p + 1), (-1 : R) ^ (l : ℕ) *
        w ((Fin.succAboveOrderEmb (Fin.castSucc l)).trans (Fin.succAboveOrderEmb (Fin.castSucc k))) = 0 := by
    intro R _ w
    have pair : ∀ (k k' : Fin (p + 1 + 1)) (l l' : Fin (p + 1)),
        (∀ x : Fin (p + 1), (((Fin.castSucc k).succAbove ((Fin.castSucc l).succAbove x) : Fin (p + 1 + 1 + 1)) : ℕ) =
          (((Fin.castSucc k').succAbove ((Fin.castSucc l').succAbove x) : Fin (p + 1 + 1 + 1)) : ℕ)) →
        ((k : ℕ) + (l : ℕ) + 1 = (k' : ℕ) + (l' : ℕ) ∨ (k : ℕ) + (l : ℕ) + 1 = (k' : ℕ) + (l' : ℕ) + 2) →
        (-1 : R) ^ (k : ℕ) * ((-1 : R) ^ (l : ℕ) *
          w ((Fin.succAboveOrderEmb (Fin.castSucc l)).trans (Fin.succAboveOrderEmb (Fin.castSucc k)))) +
        (-1 : R) ^ (k' : ℕ) * ((-1 : R) ^ (l' : ℕ) *
          w ((Fin.succAboveOrderEmb (Fin.castSucc l')).trans (Fin.succAboveOrderEmb (Fin.castSucc k')))) = 0 := by
      intro k k' l l' hx hs
      rw [hfaceq (Fin.castSucc k') (Fin.castSucc k) (Fin.castSucc l') (Fin.castSucc l)
        (fun x => (hx x).symm)]
      have e : (-1 : R) ^ ((k : ℕ) + (l : ℕ)) * (-1) = (-1 : R) ^ ((k' : ℕ) + (l' : ℕ)) := by
        rcases hs with hs | hs
        · rw [← pow_succ, hs]
        · rw [← pow_succ, hs, pow_add]; norm_num
      rw [← mul_assoc, ← mul_assoc, ← pow_add, ← pow_add, ← e]
      ring
    simp only [Finset.mul_sum]
    rw [← Finset.sum_product']
    refine Finset.sum_involution (fun x _ => if h : (x.2 : ℕ) < (x.1 : ℕ) then
        ((⟨(x.2 : ℕ), by have := x.2.isLt; omega⟩ : Fin (p + 1 + 1)),
          (⟨(x.1 : ℕ) - 1, by have := x.1.isLt; omega⟩ : Fin (p + 1)))
      else ((⟨(x.2 : ℕ) + 1, by have := x.2.isLt; omega⟩ : Fin (p + 1 + 1)),
          (⟨(x.1 : ℕ), by have := x.2.isLt; omega⟩ : Fin (p + 1)))) ?_ ?_ ?_ ?_
    · rintro ⟨k, l⟩ _
      have hk := k.isLt
      have hl := l.isLt
      by_cases h : (l : ℕ) < (k : ℕ)
      · have := pair k ⟨(l : ℕ), by omega⟩ l ⟨(k : ℕ) - 1, by omega⟩ (by
          intro x
          simp only [hsA, Fin.val_castSucc]
          have := x.isLt
          split_ifs <;> omega)
          (Or.inr (show (k : ℕ) + (l : ℕ) + 1 = (l : ℕ) + ((k : ℕ) - 1) + 2 by omega))
        simp only [dif_pos h]
        exact this
      · have := pair k ⟨(l : ℕ) + 1, by omega⟩ l ⟨(k : ℕ), by omega⟩ (by
          intro x
          simp only [hsA, Fin.val_castSucc]
          have := x.isLt
          split_ifs <;> omega)
          (Or.inl (show (k : ℕ) + (l : ℕ) + 1 = ((l : ℕ) + 1) + (k : ℕ) by omega))
        simp only [dif_neg h]
        exact this
    · rintro ⟨k, l⟩ _ _
      by_cases h : (l : ℕ) < (k : ℕ)
      · simp only [dif_pos h]
        intro heq
        have := congrArg (fun x => (x.1 : ℕ)) heq
        simp only at this
        omega
      · simp only [dif_neg h]
        intro heq
        have := congrArg (fun x => (x.1 : ℕ)) heq
        simp only at this
        omega
    · intro x _
      exact Finset.mem_product.mpr ⟨Finset.mem_univ _, Finset.mem_univ _⟩
    · rintro ⟨k, l⟩ _
      by_cases h : (l : ℕ) < (k : ℕ)
      · simp only [dif_pos h]
        rw [dif_neg (show ¬ ((k : ℕ) - 1 < (l : ℕ)) by omega)]
        refine Prod.ext (Fin.ext ?_) (Fin.ext ?_) <;> simp only <;> omega
      · simp only [dif_neg h]
        rw [dif_pos (show (k : ℕ) < (l : ℕ) + 1 by omega)]
        refine Prod.ext (Fin.ext ?_) (Fin.ext ?_) <;> simp only <;> omega

  have s2 : ∀ (R : Type u) [CommRing R] (w : (Fin (p + 1) ↪o Fin (p + 1 + 1 + 1)) → R)
      (G : Fin (p + 1 + 1 + 1) → Fin (p + 1 + 1 + 1) → R),
      G (Fin.castSucc (Fin.castSucc (Fin.last p))) (Fin.castSucc (Fin.last (p + 1))) *
        G (Fin.castSucc (Fin.last (p + 1))) (Fin.last (p + 1 + 1)) =
        G (Fin.castSucc (Fin.castSucc (Fin.last p))) (Fin.last (p + 1 + 1)) →
      ∑ k : Fin (p + 1 + 1), (-1 : R) ^ (k : ℕ) *
        ((∑ l : Fin (p + 1), (-1 : R) ^ (l : ℕ) *
          w ((Fin.succAboveOrderEmb (Fin.castSucc l)).trans (Fin.succAboveOrderEmb (Fin.castSucc k)))) +
        (-1 : R) ^ (p + 1) *
          G (Fin.succAbove (Fin.castSucc k) (Fin.castSucc (Fin.last p)))
              (Fin.succAbove (Fin.castSucc k) (Fin.last (p + 1))) *
            w ((Fin.succAboveOrderEmb (Fin.last (p + 1))).trans (Fin.succAboveOrderEmb (Fin.castSucc k)))) +
      (-1 : R) ^ (p + 1 + 1) *
        G (Fin.castSucc (Fin.last (p + 1))) (Fin.last (p + 1 + 1)) *
          ((∑ l : Fin (p + 1), (-1 : R) ^ (l : ℕ) *
            w ((Fin.succAboveOrderEmb (Fin.castSucc l)).trans (Fin.succAboveOrderEmb (Fin.last (p + 1 + 1))))) +
          (-1 : R) ^ (p + 1) *
            G (Fin.succAbove (Fin.last (p + 1 + 1)) (Fin.castSucc (Fin.last p)))
                (Fin.succAbove (Fin.last (p + 1 + 1)) (Fin.last (p + 1))) *
              w ((Fin.succAboveOrderEmb (Fin.last (p + 1))).trans (Fin.succAboveOrderEmb (Fin.last (p + 1 + 1))))) = 0 := by
    intro R _ w G hcoc
    have hA : ∀ j : Fin (p + 1), (Fin.castSucc (Fin.castSucc j) : Fin (p + 1 + 1 + 1)).succAbove
        (Fin.castSucc (Fin.last p)) = Fin.castSucc (Fin.last (p + 1)) := by
      intro j; apply Fin.ext; simp only [hsA, Fin.val_castSucc, Fin.val_last]; have := j.isLt
      split_ifs <;> omega
    have hB : ∀ j : Fin (p + 1), (Fin.castSucc (Fin.castSucc j) : Fin (p + 1 + 1 + 1)).succAbove
        (Fin.last (p + 1)) = Fin.last (p + 1 + 1) := by
      intro j; apply Fin.ext; simp only [hsA, Fin.val_castSucc, Fin.val_last]; have := j.isLt
      split_ifs <;> omega
    have hC : (Fin.castSucc (Fin.last (p + 1)) : Fin (p + 1 + 1 + 1)).succAbove
        (Fin.castSucc (Fin.last p)) = Fin.castSucc (Fin.castSucc (Fin.last p)) := by
      apply Fin.ext; simp only [hsA, Fin.val_castSucc, Fin.val_last]
      split_ifs <;> omega
    have hD : (Fin.castSucc (Fin.last (p + 1)) : Fin (p + 1 + 1 + 1)).succAbove
        (Fin.last (p + 1)) = Fin.last (p + 1 + 1) := by
      apply Fin.ext; simp only [hsA, Fin.val_castSucc, Fin.val_last]
      split_ifs <;> omega
    have hE : (Fin.last (p + 1 + 1)).succAbove
        (Fin.castSucc (Fin.last p)) = Fin.castSucc (Fin.castSucc (Fin.last p)) := by
      apply Fin.ext; simp only [hsA, Fin.val_castSucc, Fin.val_last]
      split_ifs <;> omega
    have hF : (Fin.last (p + 1 + 1)).succAbove
        (Fin.last (p + 1)) = Fin.castSucc (Fin.last (p + 1)) := by
      apply Fin.ext; simp only [hsA, Fin.val_castSucc, Fin.val_last]
      split_ifs <;> omega
    have hface1 : ∀ j : Fin (p + 1),
        (Fin.succAboveOrderEmb (Fin.last (p + 1))).trans
          (Fin.succAboveOrderEmb (Fin.castSucc (Fin.castSucc j))) =
        (Fin.succAboveOrderEmb (Fin.castSucc j)).trans (Fin.succAboveOrderEmb (Fin.last (p + 1 + 1))) := by
      intro j
      apply hfaceq
      intro x
      simp only [hsA, Fin.val_castSucc, Fin.val_last]
      have := j.isLt; have := x.isLt
      split_ifs <;> omega
    have hface2 :
        (Fin.succAboveOrderEmb (Fin.last (p + 1))).trans
          (Fin.succAboveOrderEmb (Fin.castSucc (Fin.last (p + 1)))) =
        (Fin.succAboveOrderEmb (Fin.last (p + 1))).trans (Fin.succAboveOrderEmb (Fin.last (p + 1 + 1))) := by
      apply hfaceq
      intro x
      simp only [hsA, Fin.val_castSucc, Fin.val_last]
      have := x.isLt
      split_ifs <;> omega
    simp only [mul_add, Finset.sum_add_distrib, s1 R w, zero_add]
    rw [Fin.sum_univ_castSucc (n := p + 1)]
    simp only [Fin.val_castSucc, Fin.val_last, hA, hB, hC, hD, hE, hF, hface1, hface2]
    have hsum : ∑ j : Fin (p + 1), (-1 : R) ^ (j : ℕ) * ((-1 : R) ^ (p + 1) *
          G (Fin.castSucc (Fin.last (p + 1))) (Fin.last (p + 1 + 1)) *
          w ((Fin.succAboveOrderEmb (Fin.castSucc j)).trans (Fin.succAboveOrderEmb (Fin.last (p + 1 + 1))))) +
        (-1 : R) ^ (p + 1 + 1) * G (Fin.castSucc (Fin.last (p + 1))) (Fin.last (p + 1 + 1)) *
          ∑ l : Fin (p + 1), (-1 : R) ^ (l : ℕ) *
            w ((Fin.succAboveOrderEmb (Fin.castSucc l)).trans (Fin.succAboveOrderEmb (Fin.last (p + 1 + 1)))) = 0 := by
      rw [Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_eq_zero (fun j _ => by ring)
    linear_combination hsum + (-(((-1 : R) ^ (p + 1)) ^ 2) *
      w ((Fin.succAboveOrderEmb (Fin.last (p + 1))).trans (Fin.succAboveOrderEmb (Fin.last (p + 1 + 1))))) * hcoc

  funext a
  have hcoc : ((Y.presheaf.map (homOfLE (show wcCbcmV L O a ≤
        L.V (a (Fin.castSucc (Fin.castSucc (Fin.last p)))) ⊓ L.V (a (Fin.castSucc (Fin.last (p + 1)))) from
        le_inf (inf_le_left.trans (iInf_le _ _)) (inf_le_left.trans (iInf_le _ _)))).op).hom
        (L.g (a (Fin.castSucc (Fin.castSucc (Fin.last p)))) (a (Fin.castSucc (Fin.last (p + 1)))) :
          Γ(Y, L.V (a (Fin.castSucc (Fin.castSucc (Fin.last p)))) ⊓ L.V (a (Fin.castSucc (Fin.last (p + 1))))))) ^ e *
      ((Y.presheaf.map (homOfLE (show wcCbcmV L O a ≤
        L.V (a (Fin.castSucc (Fin.last (p + 1)))) ⊓ L.V (a (Fin.last (p + 1 + 1))) from
        le_inf (inf_le_left.trans (iInf_le _ _)) (inf_le_left.trans (iInf_le _ _)))).op).hom
        (L.g (a (Fin.castSucc (Fin.last (p + 1)))) (a (Fin.last (p + 1 + 1))) :
          Γ(Y, L.V (a (Fin.castSucc (Fin.last (p + 1)))) ⊓ L.V (a (Fin.last (p + 1 + 1)))))) ^ e =
      ((Y.presheaf.map (homOfLE (show wcCbcmV L O a ≤
        L.V (a (Fin.castSucc (Fin.castSucc (Fin.last p)))) ⊓ L.V (a (Fin.last (p + 1 + 1))) from
        le_inf (inf_le_left.trans (iInf_le _ _)) (inf_le_left.trans (iInf_le _ _)))).op).hom
        (L.g (a (Fin.castSucc (Fin.castSucc (Fin.last p)))) (a (Fin.last (p + 1 + 1))) :
          Γ(Y, L.V (a (Fin.castSucc (Fin.castSucc (Fin.last p)))) ⊓ L.V (a (Fin.last (p + 1 + 1)))))) ^ e := by
    have h := hOK.2.2.2 (a (Fin.castSucc (Fin.castSucc (Fin.last p))))
      (a (Fin.castSucc (Fin.last (p + 1)))) (a (Fin.last (p + 1 + 1)))
    have hle : wcCbcmV L O a ≤ L.V (a (Fin.castSucc (Fin.castSucc (Fin.last p)))) ⊓
        L.V (a (Fin.castSucc (Fin.last (p + 1)))) ⊓ L.V (a (Fin.last (p + 1 + 1))) :=
      le_inf (le_inf (inf_le_left.trans (iInf_le (fun k => L.V (a k)) _))
        (inf_le_left.trans (iInf_le (fun k => L.V (a k)) _)))
        (inf_le_left.trans (iInf_le (fun k => L.V (a k)) _))
    have h2 := congrArg (fun x => ((Y.presheaf.map (homOfLE hle).op).hom x) ^ e) h
    simp only [map_mul, mul_pow, hres] at h2
    exact h2
  have key := s2 Γ(Y, wcCbcmV L O a)
    (fun σ => (Y.presheaf.map (homOfLE (show wcCbcmV L O a ≤ wcCbcmV L O (σ.trans a) from
      inf_le_inf_right O (le_iInf fun i => iInf_le (fun j => L.V (a j)) _))).op).hom (z (σ.trans a)))
    (fun i j => ((Y.presheaf.map (homOfLE (show wcCbcmV L O a ≤ L.V (a i) ⊓ L.V (a j) from
      le_inf (inf_le_left.trans (iInf_le _ _)) (inf_le_left.trans (iInf_le _ _)))).op).hom
      (L.g (a i) (a j) : Γ(Y, L.V (a i) ⊓ L.V (a j)))) ^ e) hcoc
  simp only [wcCbcmD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, map_add, map_sum, map_mul, map_pow,
    map_neg, map_one, hres, Pi.zero_apply]
  simp only [mul_assoc] at key ⊢
  exact key

theorem wcpa_dj_lge_cbcm_d_smul : ∀ (B : Type u) [CommRing B] (Y : Scheme.{u}) (q : Y ⟶ Spec (.of B)) (L : wcpaDjCoc Y) (O : Y.Opens) (e p : ℕ) (r : B) (z : wcCbcmC L O p), wcCbcmD L O e p (wcCbcmSig q L O p r * z) = wcCbcmSig q L O (p + 1) r * wcCbcmD L O e p z :=
by
  intro B _ Y q L O e p r z
  have hres : ∀ (U V : Y.Opens) (h : U ≤ V),
      (Y.presheaf.map (homOfLE h).op).hom (wcCnSigma q V r) = wcCnSigma q U r := by
    intro U V h
    simp only [wcCnSigma, RingHom.comp_apply]
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have hsig : ∀ (p' : ℕ) (b : Fin (p' + 1) ↪o Fin L.m),
      (Pi.ringHom fun a : Fin (p' + 1) ↪o Fin L.m => wcCnSigma q (wcCbcmV L O a)) r b =
        wcCnSigma q (wcCbcmV L O b) r := fun _ _ => rfl
  funext a
  simp only [wcCbcmD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Pi.mul_apply, wcCbcmSig,
    hsig, map_mul, hres]
  rw [mul_add, Finset.mul_sum]
  congr 1
  · exact Finset.sum_congr rfl (fun k _ => by ring)
  · ring

theorem wcpa_dj_lge_cbcm_d_pull : ∀ (Y' Y : Scheme.{u}) (φ : Y' ⟶ Y) (L : wcpaDjCoc Y) (e p : ℕ) (z : wcCbcmC L ⊤ p), wcCbcmD (wcpaDjCocPull φ L) ⊤ e p (wcCbcmPull φ L p z) = wcCbcmPull φ L (p + 1) (wcCbcmD L ⊤ e p z) :=
by
  intro Y' Y φ L e p z
  have Nl : ∀ (U U' : Y.Opens) (V : Y'.Opens) (h : V ≤ φ ⁻¹ᵁ U) (hU : U ≤ U') (s : Γ(Y, U')),
      (φ.appLE U V h).hom ((Y.presheaf.map (homOfLE hU).op).hom s) =
        (φ.appLE U' V (h.trans (fun _ hx => hU hx))).hom s := by
    intro U U' V h hU s
    exact congrArg (fun F => F.hom s) (Scheme.Hom.map_appLE φ h (homOfLE hU).op)
  have Nr : ∀ (U : Y.Opens) (V V' : Y'.Opens) (h : V ≤ φ ⁻¹ᵁ U) (hV : V' ≤ V) (s : Γ(Y, U)),
      (Y'.presheaf.map (homOfLE hV).op).hom ((φ.appLE U V h).hom s) =
        (φ.appLE U V' (hV.trans h)).hom s := by
    intro U V V' h hV s
    exact congrArg (fun F => F.hom s) (Scheme.Hom.appLE_map φ h (homOfLE hV).op)
  have N2 : ∀ (b c : Fin L.m) (V : Y'.Opens)
      (hV : V ≤ (wcpaDjCocPull φ L).V b ⊓ (wcpaDjCocPull φ L).V c),
      (Y'.presheaf.map (homOfLE hV).op).hom
        ((wcpaDjCocPull φ L).g b c : Γ(Y', (wcpaDjCocPull φ L).V b ⊓ (wcpaDjCocPull φ L).V c)) =
      (φ.appLE (L.V b ⊓ L.V c) V (hV.trans (fun _ hx => hx))).hom
        (L.g b c : Γ(Y, L.V b ⊓ L.V c)) := by
    intro b c V hV
    have h1 : ((wcpaDjCocPull φ L).g b c :
        Γ(Y', (wcpaDjCocPull φ L).V b ⊓ (wcpaDjCocPull φ L).V c)) =
        (φ.appLE (L.V b ⊓ L.V c) ((wcpaDjCocPull φ L).V b ⊓ (wcpaDjCocPull φ L).V c)
          (fun _ hx => hx)).hom (L.g b c : Γ(Y, L.V b ⊓ L.V c)) := rfl
    exact (congrArg (fun x => (Y'.presheaf.map (homOfLE hV).op).hom x) h1).trans
      (Nr _ _ _ _ _ _)
  funext a
  simp only [wcCbcmPull, wcCbcmD, AddMonoidHom.coe_mk, ZeroHom.coe_mk]
  simp only [map_add, map_sum, map_mul, map_pow, map_neg, map_one]
  congr 1
  · refine Finset.sum_congr rfl (fun k _ => ?_)
    congr 1
    exact (Nr _ _ _ _ _ _).trans (Nl _ _ _ _ _ _).symm
  · congr 2
    · congr 1
      exact (N2 _ _ _ _).trans (Nl _ _ _ _ _ _).symm
    · exact (Nr _ _ _ _ _ _).trans (Nl _ _ _ _ _ _).symm

theorem wcpa_dj_lge_cbcm_sections_flat : ∀ (B : Type u) [CommRing B] (Y : Scheme.{u}) (q : Y ⟶ Spec (.of B)) (L : wcpaDjCoc Y) (p : ℕ), Flat q → IsSeparated q → (∀ a, IsAffineOpen (L.V a)) → letI := Module.compHom (wcCbcmC L ⊤ p) (wcCbcmSig q L ⊤ p); Module.Flat B (wcCbcmC L ⊤ p) :=
by
  intro B _ Y q L p hflat hsep haff
  classical
  haveI hT : IsSeparated (Limits.terminal.from Y) := by
    have e : Limits.terminal.from Y = q ≫ Limits.terminal.from (Spec (.of B)) :=
      Limits.terminal.hom_ext _ _
    rw [e]
    infer_instance
  have hA : ∀ a : Fin (p + 1) ↪o Fin L.m, IsAffineOpen (wcCbcmV L ⊤ a) := by
    intro a
    show IsAffineOpen ((⨅ k, L.V (a k)) ⊓ ⊤)
    rw [inf_top_eq]
    exact IsAffineOpen.iInf (fun k => haff (a k))
  have hS : ∀ U : Y.Opens, IsAffineOpen U → (wcCnSigma q U).Flat := by
    intro U hU
    have h1 : RingHom.Flat (q.appLE ⊤ U le_top).hom :=
      HasRingHomProperty.appLE (P := @Flat) q hflat ⟨⊤, isAffineOpen_top (Spec (.of B))⟩
        ⟨U, hU⟩ le_top
    have h2 : RingHom.Flat (Scheme.ΓSpecIso (.of B)).inv.hom :=
      RingHom.Flat.of_bijective (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of B)).inv)
    have h3 := RingHom.Flat.comp h2 h1
    exact h3
  letI inst : ∀ a : Fin (p + 1) ↪o Fin L.m, Module B Γ(Y, wcCbcmV L ⊤ a) :=
    fun a => (wcCnSigma q (wcCbcmV L ⊤ a)).toModule
  haveI hfl : ∀ a : Fin (p + 1) ↪o Fin L.m, Module.Flat B Γ(Y, wcCbcmV L ⊤ a) :=
    fun a => hS _ (hA a)
  haveI : Module.Flat B (DirectSum (Fin (p + 1) ↪o Fin L.m) fun a => Γ(Y, wcCbcmV L ⊤ a)) :=
    Module.Flat.directSum
  exact Module.Flat.of_linearEquiv
    (DirectSum.linearEquivFunOnFintype B (Fin (p + 1) ↪o Fin L.m)
      fun a => Γ(Y, wcCbcmV L ⊤ a)).symm

theorem wcpa_dj_lge_cbcm_cech_bc : ∀ (B R : Type u) [CommRing B] [CommRing R] (f : B →+* R) (Y₀ Y' : Scheme.{u}) (q₀ : Y₀ ⟶ Spec (.of B)) (φ' : Y' ⟶ Y₀) (q' : Y' ⟶ Spec (.of R)), IsSeparated q₀ → IsPullback φ' q' q₀ (Spec.map (CommRingCat.ofHom f)) → ∀ (L₀ : wcpaDjCoc Y₀), (∀ a, IsAffineOpen (L₀.V a)) → ∀ (p : ℕ), letI := f.toAlgebra; letI := Module.compHom (wcCbcmC L₀ ⊤ p) (wcCbcmSig q₀ L₀ ⊤ p); ∃ Θ : TensorProduct B (wcCbcmC L₀ ⊤ p) R ≃+ wcCbcmC (wcpaDjCocPull φ' L₀) ⊤ p, ∀ (z : wcCbcmC L₀ ⊤ p) (r : R), Θ (z ⊗ₜ[B] r) = wcCbcmPull φ' L₀ p z * wcCbcmSig q' (wcpaDjCocPull φ' L₀) ⊤ p r :=
by
  intro B R _ _ f Y₀ Y' q₀ φ' q' hsep hpb L₀ hV p
  letI := f.toAlgebra
  classical

  haveI hsepT : IsSeparated (Limits.terminal.from Y₀) := by
    have h : Limits.terminal.from Y₀ = q₀ ≫ Limits.terminal.from (Spec (.of B)) :=
      Limits.terminal.hom_ext _ _
    rw [h]
    infer_instance
  haveI : IsClosedImmersion (Limits.pullback.diagonal (Limits.terminal.from Y₀)) :=
    IsSeparated.isClosedImmersion_diagonal
  haveI : IsAffineHom (Limits.pullback.diagonal (Limits.terminal.from Y₀)) := inferInstance
  have hA : ∀ a : Fin (p + 1) ↪o Fin L₀.m, IsAffineOpen (wcCbcmV L₀ ⊤ a) := by
    intro a
    show IsAffineOpen ((⨅ k, L₀.V (a k)) ⊓ ⊤)
    rw [inf_top_eq]
    exact IsAffineOpen.iInf (fun k => hV (a k))

  have hE : ∀ a : Fin (p + 1) ↪o Fin L₀.m,
      φ' ⁻¹ᵁ (wcCbcmV L₀ ⊤ a) = wcCbcmV (wcpaDjCocPull φ' L₀) ⊤ a := by
    intro a
    apply le_antisymm
    · intro x hx
      refine ⟨?_, trivial⟩
      have h1 := hx.1
      simp only [wcCbcmV] at h1 ⊢
      rw [TopologicalSpace.Opens.coe_iInf, Set.mem_iInter] at h1 ⊢
      exact fun k => h1 k
    · intro x hx
      have h1 := hx.1
      show φ' x ∈ ((⨅ k, L₀.V (a k)) ⊓ ⊤ : Y₀.Opens)
      refine ⟨?_, trivial⟩
      simp only [wcCbcmV] at h1 ⊢
      rw [TopologicalSpace.Opens.coe_iInf, Set.mem_iInter] at h1 ⊢
      exact fun k => h1 k

  have c2 : ∀ (O : Y₀.Opens) (O' : Y'.Opens) (h : O' ≤ φ' ⁻¹ᵁ O), IsAffineOpen O →
      φ' ⁻¹ᵁ O = O' →
      letI := (wcCnSigma q₀ O).toAlgebra
      ∃ Θ : TensorProduct B Γ(Y₀, O) R ≃+* Γ(Y', O'), ∀ (x : Γ(Y₀, O)) (t : R),
        Θ (x ⊗ₜ[B] t) = (φ'.appLE O O' h).hom x * wcCnSigma q' O' t := by
    intro O O' h hO hOO'
    subst hOO'
    letI := (wcCnSigma q₀ O).toAlgebra
    have hOle : O ≤ q₀ ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have hW : (⊤ : (Spec (.of R)).Opens) ≤
        Spec.map (CommRingCat.ofHom f) ⁻¹ᵁ ⊤ := by
      rw [Scheme.Hom.preimage_top]
    have heq : φ' ⁻¹ᵁ O = φ' ⁻¹ᵁ O ⊓ q' ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top, inf_top_eq]
    have hPB := Scheme.Hom.isPullback_resLE hpb hW hOle heq
    haveI : IsAffine (⊤ : (Spec (.of B)).Opens) := isAffineOpen_top _
    haveI : IsAffine (⊤ : (Spec (.of R)).Opens) := isAffineOpen_top _
    haveI : IsAffine O := hO
    have hPO := isPushout_appTop_of_isPullback hPB
    have s1 : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ g ⁻¹ᵁ U),
        (g.resLE U V e).appTop ≫ V.topIso.hom = U.topIso.hom ≫ g.appLE U V e := by
      intro X Y g U V e
      simp only [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, Scheme.Opens.topIso_hom]
      erw [Scheme.Hom.resLE_appLE, Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
    have hPO2 := IsPushout.of_iso hPO (⊤ : (Spec (.of B)).Opens).topIso O.topIso
      (⊤ : (Spec (.of R)).Opens).topIso (φ' ⁻¹ᵁ O).topIso (s1 _ _ _ _) (s1 _ _ _ _)
      (s1 _ _ _ _) (s1 _ _ _ _)
    have eσ : CommRingCat.ofHom (wcCnSigma q₀ O) =
        (Scheme.ΓSpecIso (.of B)).inv ≫ q₀.appLE ⊤ O hOle := by
      apply CommRingCat.hom_ext
      rfl
    have h2 : φ' ⁻¹ᵁ O ≤ q' ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have eσ' : CommRingCat.ofHom (wcCnSigma q' (φ' ⁻¹ᵁ O)) =
        (Scheme.ΓSpecIso (.of R)).inv ≫ q'.appLE ⊤ (φ' ⁻¹ᵁ O) h2 := by
      apply CommRingCat.hom_ext
      rfl
    have hσ : IsPushout (CommRingCat.ofHom (algebraMap B Γ(Y₀, O)))
        (CommRingCat.ofHom (algebraMap B R)) (CommRingCat.ofHom (φ'.app O).hom)
        (CommRingCat.ofHom (wcCnSigma q' (φ' ⁻¹ᵁ O))) := by
      refine IsPushout.of_iso hPO2 (Scheme.ΓSpecIso (.of B)) (Iso.refl _)
        (Scheme.ΓSpecIso (.of R)) (Iso.refl _) ?_ ?_ ?_ ?_
      · show _ = _ ≫ CommRingCat.ofHom (wcCnSigma q₀ O)
        rw [eσ, Iso.hom_inv_id_assoc, Iso.refl_hom, Category.comp_id]
      · show Scheme.Hom.appLE _ ⊤ (Spec.map (CommRingCat.ofHom f) ⁻¹ᵁ ⊤) le_rfl ≫ _
          = _
        rw [Scheme.Hom.appLE_eq_app]
        exact Scheme.ΓSpecIso_naturality _
      · rw [CommRingCat.ofHom_hom, Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
        exact Scheme.Hom.appLE_eq_app _
      · rw [eσ', Iso.hom_inv_id_assoc, Iso.refl_hom, Category.comp_id]
    have hT := CommRingCat.isPushout_tensorProduct B Γ(Y₀, O) R
    let e := IsPushout.isoIsPushout _ _ hT hσ
    have hl := IsPushout.inl_isoIsPushout_hom _ _ hT hσ
    have hr := IsPushout.inr_isoIsPushout_hom _ _ hT hσ
    refine ⟨e.commRingCatIsoToRingEquiv, fun a t => ?_⟩
    have ha : e.hom.hom (a ⊗ₜ[B] (1 : R)) = (φ'.app O).hom a := by
      have := congrArg (fun φ => φ.hom a) hl
      exact this
    have ht : e.hom.hom ((1 : Γ(Y₀, O)) ⊗ₜ[B] t) = wcCnSigma q' (φ' ⁻¹ᵁ O) t := by
      have := congrArg (fun φ => φ.hom t) hr
      exact this
    have hsplit : a ⊗ₜ[B] t = (a ⊗ₜ[B] (1 : R)) * ((1 : Γ(Y₀, O)) ⊗ₜ[B] t) := by
      rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    rw [hsplit, map_mul]
    show e.hom.hom _ * e.hom.hom _ = _
    rw [ha, ht, Scheme.Hom.appLE_eq_app]

  letI instA : ∀ a : Fin (p + 1) ↪o Fin L₀.m, Algebra B Γ(Y₀, wcCbcmV L₀ ⊤ a) := fun a =>
    (wcCnSigma q₀ (wcCbcmV L₀ ⊤ a)).toAlgebra
  have c2' : ∀ a : Fin (p + 1) ↪o Fin L₀.m,
      ∃ Θ : TensorProduct B Γ(Y₀, wcCbcmV L₀ ⊤ a) R ≃+* Γ(Y', wcCbcmV (wcpaDjCocPull φ' L₀) ⊤ a),
        ∀ (x : Γ(Y₀, wcCbcmV L₀ ⊤ a)) (t : R),
        Θ (x ⊗ₜ[B] t) = (φ'.appLE (wcCbcmV L₀ ⊤ a) (wcCbcmV (wcpaDjCocPull φ' L₀) ⊤ a)
          (hE a).symm.le).hom x * wcCnSigma q' (wcCbcmV (wcpaDjCocPull φ' L₀) ⊤ a) t :=
    fun a => c2 _ _ (hE a).symm.le (hA a) (hE a)
  choose Θa hΘa using c2'
  let Ψ : TensorProduct B (wcCbcmC L₀ ⊤ p) R ≃+ wcCbcmC (wcpaDjCocPull φ' L₀) ⊤ p :=
    (TensorProduct.piLeft B R (fun a : Fin (p + 1) ↪o Fin L₀.m =>
      Γ(Y₀, wcCbcmV L₀ ⊤ a))).toAddEquiv.trans
      (AddEquiv.piCongrRight fun a => (Θa a).toAddEquiv)
  refine ⟨Ψ, fun z r => ?_⟩
  funext a
  exact hΘa a (z a) r

theorem wcpa_dj_lge_cbcm_deg0 : ∀ (Y : Scheme.{u}) (L : wcpaDjCoc Y) (O : Y.Opens) (e : ℕ), wcpaDjCocOK L → (∀ t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ O), wcpaDjCompat L O e t ↔ wcCbcmD L O e 0 (wcCbcmOfFam L O t) = 0) ∧ ∀ t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ O), wcCbcmToFam L O (wcCbcmOfFam L O t) = t :=
by
  intro Y L O e hOK

  have R : ∀ {U V W : Y.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (s : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom s) =
        (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom s := by
    intro U V W h1 h2 s
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have Rid : ∀ {U : Y.Opens} (h : U ≤ U) (s : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h).op).hom s = s := by
    intro U h s
    rw [show homOfLE h = 𝟙 U from Subsingleton.elim _ _, op_id, CategoryTheory.Functor.map_id]
    rfl
  refine ⟨fun t => ?_, fun t => ?_⟩
  ·
    have T : ∀ (a b : Fin L.m) (U U' : Y.Opens) (hb : U ≤ L.V b ⊓ O) (hg : U ≤ L.V a ⊓ L.V b)
        (ha : U ≤ L.V a ⊓ O) (hb' : U' ≤ L.V b ⊓ O) (hg' : U' ≤ L.V a ⊓ L.V b)
        (ha' : U' ≤ L.V a ⊓ O) (h : U' ≤ U),
        (Y.presheaf.map (homOfLE hb).op).hom (t b) =
          (Y.presheaf.map (homOfLE hg).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ e) *
          (Y.presheaf.map (homOfLE ha).op).hom (t a) →
        (Y.presheaf.map (homOfLE hb').op).hom (t b) =
          (Y.presheaf.map (homOfLE hg').op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ e) *
          (Y.presheaf.map (homOfLE ha').op).hom (t a) := by
      intro a b U U' hb hg ha hb' hg' ha' h H
      have H2 := congrArg (Y.presheaf.map (homOfLE h).op).hom H
      rw [map_mul, R, R, R] at H2
      exact H2

    have eval : ∀ a : Fin 2 ↪o Fin L.m, wcCbcmD L O e 0 (wcCbcmOfFam L O t) a =
        (Y.presheaf.map (homOfLE (show wcCbcmV L O a ≤ L.V (a 1) ⊓ O from
          inf_le_inf_right O (iInf_le (fun k => L.V (a k)) 1))).op).hom (t (a 1)) -
        (Y.presheaf.map (homOfLE (show wcCbcmV L O a ≤ L.V (a 0) ⊓ L.V (a 1) from
          le_inf (inf_le_left.trans (iInf_le (fun k => L.V (a k)) 0))
            (inf_le_left.trans (iInf_le (fun k => L.V (a k)) 1)))).op).hom
          ((L.g (a 0) (a 1) : Γ(Y, L.V (a 0) ⊓ L.V (a 1))) ^ e) *
        (Y.presheaf.map (homOfLE (show wcCbcmV L O a ≤ L.V (a 0) ⊓ O from
          inf_le_inf_right O (iInf_le (fun k => L.V (a k)) 0))).op).hom (t (a 0)) := by
      intro a
      simp only [wcCbcmD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Fin.sum_univ_succ,
        Fin.sum_univ_zero, wcCbcmOfFam, R]
      simp only [Fin.val_zero, pow_zero, one_mul, zero_add, pow_one, neg_mul,
        add_zero, ← sub_eq_add_neg]
      rfl
    have hWW' : ∀ a : Fin 2 ↪o Fin L.m, wcCbcmV L O a ≤ L.V (a 0) ⊓ L.V (a 1) ⊓ O :=
      fun a => le_inf (le_inf (inf_le_left.trans (iInf_le _ 0))
        (inf_le_left.trans (iInf_le _ 1))) inf_le_right
    have hW'W : ∀ a : Fin 2 ↪o Fin L.m, L.V (a 0) ⊓ L.V (a 1) ⊓ O ≤ wcCbcmV L O a := by
      intro a
      refine le_inf (le_iInf fun k => ?_) inf_le_right
      fin_cases k
      · exact inf_le_left.trans inf_le_left
      · exact inf_le_left.trans inf_le_right
    constructor
    · intro h
      funext a
      rw [eval, Pi.zero_apply, sub_eq_zero]
      exact T (a 0) (a 1) _ _ _ _ _ _ _ _ (hWW' a) (h (a 0) (a 1))
    · intro hD
      have stepA : ∀ x y : Fin L.m, x < y →
          (Y.presheaf.map (homOfLE (show L.V x ⊓ L.V y ⊓ O ≤ L.V y ⊓ O from
            le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (t y) =
          (Y.presheaf.map (homOfLE (show L.V x ⊓ L.V y ⊓ O ≤ L.V x ⊓ L.V y from
            inf_le_left)).op).hom ((L.g x y : Γ(Y, L.V x ⊓ L.V y)) ^ e) *
          (Y.presheaf.map (homOfLE (show L.V x ⊓ L.V y ⊓ O ≤ L.V x ⊓ O from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (t x) := by
        intro x y hxy
        have hmono : StrictMono ![x, y] :=
          Fin.strictMono_iff_lt_succ.2 (fun i => by fin_cases i; simpa using hxy)
        let a : Fin 2 ↪o Fin L.m := OrderEmbedding.ofStrictMono ![x, y] hmono
        have h1 := congrFun hD a
        rw [eval, Pi.zero_apply, sub_eq_zero] at h1
        exact T x y (wcCbcmV L O a) _ _ _ _ _ _ _ (hW'W a) h1
      intro x y
      rcases lt_trichotomy x y with hxy | rfl | hyx
      · exact stepA x y hxy
      · rw [hOK.2.2.1 x, Units.val_one, one_pow, map_one, one_mul]
      · have H := T y x (L.V y ⊓ L.V x ⊓ O) (L.V x ⊓ L.V y ⊓ O) _ _ _
          (le_inf (inf_le_left.trans inf_le_left) inf_le_right)
          (le_inf (inf_le_left.trans inf_le_right) (inf_le_left.trans inf_le_left))
          (le_inf (inf_le_left.trans inf_le_right) inf_le_right)
          (le_inf (le_inf (inf_le_left.trans inf_le_right) (inf_le_left.trans inf_le_left))
            inf_le_right)
          (stepA y x hyx)
        have h4 := hOK.2.2.2 x y x
        rw [hOK.2.2.1 x, Units.val_one, map_one] at h4
        have h5 := congrArg (Y.presheaf.map (homOfLE (show L.V x ⊓ L.V y ⊓ O ≤
          L.V x ⊓ L.V y ⊓ L.V x from le_inf inf_le_left (inf_le_left.trans inf_le_left))).op).hom h4
        rw [map_mul, map_one, R, R] at h5
        rw [H, map_pow, map_pow, ← mul_assoc, ← mul_pow, h5, one_pow, one_mul]
  · funext a
    simp only [wcCbcmToFam, wcCbcmOfFam]
    rw [R]
    exact Rid _ _

theorem wcpa_dj_lge_cbcm_h1 : ∀ (Y : Scheme.{u}) (L : wcpaDjCoc Y) (O : Y.Opens) (e : ℕ), wcpaDjCocOK L → wcpaDjTwH1 L O (wcStructMod Y) e → ∀ c : wcCbcmC L O 1, wcCbcmD L O e 1 c = 0 → ∃ x : wcCbcmC L O 0, c = wcCbcmD L O e 0 x :=
by
  intro Y L O e hOK hTw c hc
  classical

  have rr : ∀ {U V W : Y.Opens} (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
      (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V W h1 h2 x
    show (Y.presheaf.map (homOfLE h1).op ≫ Y.presheaf.map (homOfLE h2).op).hom x = _
    rw [← CategoryTheory.Functor.map_comp]
    rfl
  have rid : ∀ {U : Y.Opens} (h : U ≤ U) (x : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h).op).hom x = x := by
    intro U h x
    show (Y.presheaf.map (𝟙 _)).hom x = x
    rw [CategoryTheory.Functor.map_id]
    rfl
  have ctr : ∀ (q q' : Fin 2 ↪o Fin L.m), q = q' → ∀ (W : Y.Opens) (h : W ≤ wcCbcmV L O q)
      (h' : W ≤ wcCbcmV L O q'),
      (Y.presheaf.map (homOfLE h).op).hom (c q) = (Y.presheaf.map (homOfLE h').op).hom (c q') := by
    intro q q' hq W h h'
    subst hq
    rfl
  have hleV : ∀ {n : ℕ} (W : Y.Opens) (q : Fin (n + 1) ↪o Fin L.m), (∀ k, W ≤ L.V (q k)) →
      W ≤ O → W ≤ wcCbcmV L O q := fun W q h hO => le_inf (le_iInf h) hO
  have hpr : ∀ a b : Fin L.m, a < b → StrictMono (![a, b] : Fin 2 → Fin L.m) := fun a b h =>
    Fin.strictMono_iff_lt_succ.mpr (fun i => by fin_cases i; exact h)
  have htr : ∀ a b d : Fin L.m, a < b → b < d → StrictMono (![a, b, d] : Fin 3 → Fin L.m) :=
    fun a b d h1 h2 => Fin.strictMono_iff_lt_succ.mpr (fun i => by fin_cases i; exacts [h1, h2])
  have hprV : ∀ (a b : Fin L.m) (h : a < b) (W : Y.Opens), W ≤ L.V a → W ≤ L.V b → W ≤ O →
      W ≤ wcCbcmV L O (OrderEmbedding.ofStrictMono _ (hpr a b h)) := by
    intro a b h W ha hb hO
    exact hleV W _ (fun k => by fin_cases k; exacts [ha, hb]) hO

  obtain ⟨ct, hct⟩ : ∃ ct : ∀ a b : Fin L.m, Γ(Y, L.V a ⊓ L.V b ⊓ O), ∀ a b, ct a b =
      if h : a < b then
        (Y.presheaf.map (homOfLE (hprV a b h _ (inf_le_left.trans inf_le_left)
          (inf_le_left.trans inf_le_right) inf_le_right)).op).hom
          (c (OrderEmbedding.ofStrictMono _ (hpr a b h)))
      else if h' : b < a then
        -(((Y.presheaf.map (homOfLE (inf_le_left : L.V a ⊓ L.V b ⊓ O ≤ L.V a ⊓ L.V b)).op).hom
            (L.g a b : Γ(Y, L.V a ⊓ L.V b))) ^ e *
          (Y.presheaf.map (homOfLE (hprV b a h' _ (inf_le_left.trans inf_le_right)
          (inf_le_left.trans inf_le_left) inf_le_right)).op).hom
          (c (OrderEmbedding.ofStrictMono _ (hpr b a h'))))
      else 0 := ⟨_, fun _ _ => rfl⟩

  have main : ∀ (a b d : Fin L.m) (W : Y.Opens), W ≤ L.V a → W ≤ L.V b → W ≤ L.V d → W ≤ O →
      ∀ (h1 : W ≤ L.V a ⊓ L.V d ⊓ O) (h2 : W ≤ L.V b ⊓ L.V d ⊓ O) (h3 : W ≤ L.V b ⊓ L.V d)
        (h4 : W ≤ L.V a ⊓ L.V b ⊓ O),
      (Y.presheaf.map (homOfLE h1).op).hom (ct a d) =
        (Y.presheaf.map (homOfLE h2).op).hom (ct b d) +
        ((Y.presheaf.map (homOfLE h3).op).hom (L.g b d : Γ(Y, L.V b ⊓ L.V d))) ^ e *
        (Y.presheaf.map (homOfLE h4).op).hom (ct a b) := by
    intro a b d W hWa hWb hWd hWO h1 h2 h3 h4
    have hS : ∀ x, (x = a ∨ x = b ∨ x = d) → W ≤ L.V x := by
      rintro x (rfl | rfl | rfl) <;> assumption
    obtain ⟨R, hR⟩ : ∃ R : (Fin 2 ↪o Fin L.m) → Γ(Y, W), ∀ q (h : W ≤ wcCbcmV L O q),
        (Y.presheaf.map (homOfLE h).op).hom (c q) = R q :=
      ⟨fun q => if h : W ≤ wcCbcmV L O q then (Y.presheaf.map (homOfLE h).op).hom (c q) else 0,
        fun q h => by simp only [dif_pos h]⟩
    have hRe : ∀ q q' : Fin 2 ↪o Fin L.m, (∀ i, q i = q' i) → R q = R q' :=
      fun q q' h => congrArg R (DFunLike.ext _ _ h)
    obtain ⟨G, hG⟩ : ∃ G : Fin L.m → Fin L.m → Γ(Y, W), ∀ x y (h : W ≤ L.V x ⊓ L.V y),
        ((Y.presheaf.map (homOfLE h).op).hom (L.g x y : Γ(Y, L.V x ⊓ L.V y))) ^ e = G x y :=
      ⟨fun x y => if h : W ≤ L.V x ⊓ L.V y then
          ((Y.presheaf.map (homOfLE h).op).hom (L.g x y : Γ(Y, L.V x ⊓ L.V y))) ^ e else 0,
        fun x y h => by simp only [dif_pos h]⟩
    obtain ⟨X, hX⟩ : ∃ X : Fin L.m → Fin L.m → Γ(Y, W), ∀ x y (h : x < y),
        X x y = R (OrderEmbedding.ofStrictMono _ (hpr x y h)) :=
      ⟨fun x y => if h : x < y then R (OrderEmbedding.ofStrictMono _ (hpr x y h)) else 0,
        fun x y h => dif_pos h⟩
    have hRv : ∀ q : Fin 2 ↪o Fin L.m, R q = X (q 0) (q 1) := by
      intro q
      rw [hX _ _ (q.strictMono (show (0 : Fin 2) < 1 by decide))]
      exact hRe _ _ (fun i => by fin_cases i <;> rfl)
    obtain ⟨E, hElt, hEgt, hEeq⟩ : ∃ E : Fin L.m → Fin L.m → Γ(Y, W),
        (∀ x y, x < y → E x y = X x y) ∧ (∀ x y, y < x → E x y = -(G x y * X y x)) ∧
        (∀ x y, x = y → E x y = 0) :=
      ⟨fun x y => if x < y then X x y else if y < x then -(G x y * X y x) else 0,
        fun x y h => if_pos h,
        fun x y h => by simp only [if_neg (not_lt.mpr h.le), if_pos h],
        fun x y h => by subst h; simp only [lt_irrefl, if_false]⟩
    have hI : ∀ x, (x = a ∨ x = b ∨ x = d) → G x x = 1 := by
      intro x hx
      rw [← hG x x (le_inf (hS x hx) (hS x hx)), hOK.2.2.1 x, Units.val_one, map_one, one_pow]
    have hK : ∀ x y z, (x = a ∨ x = b ∨ x = d) → (y = a ∨ y = b ∨ y = d) →
        (z = a ∨ z = b ∨ z = d) → G x y * G y z = G x z := by
      intro x y z hx hy hz
      have hW3 : W ≤ L.V x ⊓ L.V y ⊓ L.V z := le_inf (le_inf (hS x hx) (hS y hy)) (hS z hz)
      have h := congrArg (Y.presheaf.map (homOfLE hW3).op).hom (hOK.2.2.2 x y z)
      rw [map_mul, rr, rr, rr] at h
      rw [← hG x y (le_inf (hS x hx) (hS y hy)), ← hG y z (le_inf (hS y hy) (hS z hz)),
        ← hG x z (le_inf (hS x hx) (hS z hz)), ← mul_pow, h]
    have hRel : ∀ x y z, (x = a ∨ x = b ∨ x = d) → (y = a ∨ y = b ∨ y = d) →
        (z = a ∨ z = b ∨ z = d) → ∀ (hxy : x < y) (hyz : y < z),
        X x z = X y z + G y z * X x y := by
      intro x y z hx hy hz hxy hyz
      obtain ⟨t, ht⟩ : ∃ t : Fin 3 ↪o Fin L.m, t = OrderEmbedding.ofStrictMono _ (htr x y z hxy hyz) :=
        ⟨_, rfl⟩
      have hWt : W ≤ wcCbcmV L O t := by
        subst ht
        exact hleV W _ (fun k => by fin_cases k; exacts [hS x hx, hS y hy, hS z hz]) hWO
      have h2 : wcCbcmD L O e 1 c t = 0 := congrFun hc t
      have T1 : t (Fin.castSucc (Fin.last 1)) = y := by rw [ht]; rfl
      have T2 : t (Fin.last (1 + 1)) = z := by rw [ht]; rfl
      have Fk : ∀ k : Fin (1 + 1), R ((Fin.succAboveOrderEmb (Fin.castSucc k)).trans t) =
          ![X y z, X x z] k := by
        intro k
        rw [hRv, ht]
        fin_cases k <;> rfl
      have Fl : R ((Fin.succAboveOrderEmb (Fin.last (1 + 1))).trans t) = X x y := by
        rw [hRv, ht]; rfl
      have h3 := congrArg (Y.presheaf.map (homOfLE hWt).op).hom h2
      simp only [wcCbcmD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, map_sum,
        map_add, map_mul, map_pow, map_neg, map_one, map_zero, rr, hR, hG, Fk, Fl, T1, T2] at h3
      simp [Fin.sum_univ_succ] at h3
      linear_combination -h3
    have hE : ∀ x y, (x = a ∨ x = b ∨ x = d) → (y = a ∨ y = b ∨ y = d) →
        ∀ (h : W ≤ L.V x ⊓ L.V y ⊓ O), (Y.presheaf.map (homOfLE h).op).hom (ct x y) = E x y := by
      intro x y hx hy h
      rw [hct x y]
      rcases lt_trichotomy x y with hxy | hxy | hxy
      · rw [dif_pos hxy, rr, hR, hElt x y hxy, hX x y hxy]
      · rw [dif_neg (not_lt.mpr hxy.ge), dif_neg (not_lt.mpr hxy.le), map_zero, hEeq x y hxy]
      · rw [dif_neg (not_lt.mpr hxy.le), dif_pos hxy, map_neg, map_mul, map_pow, rr, rr, hR,
          hG x y (le_inf (hS x hx) (hS y hy)), hEgt x y hxy, hX y x hxy]
    have ma : a = a ∨ a = b ∨ a = d := Or.inl rfl
    have mb : b = a ∨ b = b ∨ b = d := Or.inr (Or.inl rfl)
    have md : d = a ∨ d = b ∨ d = d := Or.inr (Or.inr rfl)
    rw [hE a d ma md h1, hE b d mb md h2, hE a b ma mb h4, hG b d h3]
    rcases lt_trichotomy a b with hab | hab | hab
    · rcases lt_trichotomy b d with hbd | hbd | hbd
      · rw [hElt a d (hab.trans hbd), hElt b d hbd, hElt a b hab]
        exact hRel a b d ma mb md hab hbd
      · rw [← hbd, hEeq b b rfl, hI b mb]
        ring
      · rcases lt_trichotomy a d with had | had | had
        · rw [hElt a d had, hEgt b d hbd, hElt a b hab]
          linear_combination (-G b d) * hRel a d b ma md mb had hbd - X a d * hK b d b mb md mb -
            X a d * hI b mb
        · rw [← had, hEeq a a rfl, hEgt b a hab, hElt a b hab]
          ring
        · rw [hEgt a d had, hEgt b d hbd, hElt a b hab]
          linear_combination G b d * hRel d a b md ma mb had hab + X d a * hK a b d ma mb md
    · rw [← hab, hEeq a a rfl]
      ring
    · rcases lt_trichotomy b d with hbd | hbd | hbd
      · rcases lt_trichotomy a d with had | had | had
        · rw [hElt a d had, hElt b d hbd, hEgt a b hab]
          linear_combination (-1 : Γ(Y, W)) * hRel b a d mb ma md hab had +
            X b a * hK a b d ma mb md
        · rw [← had, hEeq a a rfl, hElt b a hab, hEgt a b hab]
          linear_combination X b a * hK b a b mb ma mb + X b a * hI b mb
        · rw [hEgt a d had, hElt b d hbd, hEgt a b hab]
          linear_combination G a b * G b d * hRel b d a mb md ma hbd had +
            X d a * hK a b d ma mb md +
            X b d * (G d a * hK a b d ma mb md + hK a d a ma md ma + hI a ma)
      · rw [← hbd, hEeq b b rfl, hI b mb]
        ring
      · rw [hEgt a d (hbd.trans hab), hEgt b d hbd, hEgt a b hab]
        linear_combination (-G a d) * hRel d b a md mb ma hbd hab - X d b * hK b a d mb ma md +
          X b a * hK a b d ma mb md
  have hrel : ∀ a b d : Fin L.m, (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ O ≤ L.V a ⊓ L.V d ⊓ O from inf_le_inf_right O (inf_le_inf_right (L.V d) inf_le_left))).op).hom (ct a d) = (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ O ≤ L.V b ⊓ L.V d ⊓ O from inf_le_inf_right O (inf_le_inf_right (L.V d) inf_le_right))).op).hom (ct b d) + ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ O ≤ L.V b ⊓ L.V d from (inf_le_left : L.V a ⊓ L.V b ⊓ L.V d ⊓ O ≤ L.V a ⊓ L.V b ⊓ L.V d).trans (inf_le_inf_right (L.V d) inf_le_right))).op).hom (L.g b d : Γ(Y, L.V b ⊓ L.V d))) ^ e * (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ O ≤ L.V a ⊓ L.V b ⊓ O from le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (ct a b) :=
    fun a b d => main a b d _ (inf_le_left.trans (inf_le_left.trans inf_le_left))
      (inf_le_left.trans (inf_le_left.trans inf_le_right)) (inf_le_left.trans inf_le_right)
      inf_le_right _ _ _ _
  obtain ⟨β0, hβ0⟩ := hTw ct hrel
  obtain ⟨β, hβ'⟩ : ∃ β : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ O), ∀ a b, ct a b = (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ O ≤ L.V b ⊓ O from le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (β b) - ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ O ≤ L.V a ⊓ L.V b from inf_le_left)).op).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b))) ^ e * (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ O ≤ L.V a ⊓ O from le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (β a) := ⟨β0, hβ0⟩
  refine ⟨wcCbcmOfFam L O β, ?_⟩
  funext p
  have h01 : p 0 < p 1 := p.strictMono (show (0 : Fin 2) < 1 by decide)
  have hU : wcCbcmV L O p ≤ L.V (p 0) ⊓ L.V (p 1) ⊓ O :=
    le_inf (le_inf (inf_le_left.trans (iInf_le _ 0)) (inf_le_left.trans (iInf_le _ 1))) inf_le_right
  have e1 : c p = (Y.presheaf.map (homOfLE hU).op).hom (ct (p 0) (p 1)) := by
    rw [hct, dif_pos h01, rr, ctr (OrderEmbedding.ofStrictMono _ (hpr (p 0) (p 1) h01)) p
      (DFunLike.ext _ _ (fun i => by fin_cases i <;> rfl)) _ _ le_rfl, rid]
  rw [e1, hβ' (p 0) (p 1), map_sub, map_mul, map_pow, rr, rr, rr]
  simp only [wcCbcmD, AddMonoidHom.coe_mk, ZeroHom.coe_mk, Fin.sum_univ_succ, Fin.sum_univ_zero,
    wcCbcmOfFam, rr, map_pow, Fin.val_zero, pow_zero, one_mul, add_zero, zero_add, pow_one,
    neg_one_mul, Fin.isValue]
  rw [sub_eq_add_neg]
  rfl

theorem wcpa_dj_lge_cbcm_fam_bridge : ∀ (R : Type u) [CommRing R] (Y₀ Y' : Scheme.{u}) (φ' : Y' ⟶ Y₀) (q' : Y' ⟶ Spec (.of R)) (L₀ : wcpaDjCoc Y₀) (n0 : ℕ) (β : Fin n0 → wcCbcmC L₀ ⊤ 0) (v : Fin n0 → R), wcCbcmOfFam (wcpaDjCocPull φ' L₀) (q' ⁻¹ᵁ ⊤) (fun a => ∑ j, (q'.appLE ⊤ ((wcpaDjCocPull φ' L₀).V a ⊓ q' ⁻¹ᵁ ⊤) inf_le_right).hom ((Scheme.ΓSpecIso (.of R)).inv.hom (v j)) * (φ'.appLE (L₀.V a) ((wcpaDjCocPull φ' L₀).V a ⊓ q' ⁻¹ᵁ ⊤) inf_le_left).hom (wcCbcmToFamTop L₀ (β j) a)) = ∑ j, wcCbcmPull φ' L₀ 0 (β j) * wcCbcmSig q' (wcpaDjCocPull φ' L₀) ⊤ 0 (v j) :=
by
  intro R _ Y₀ Y' φ' q' L₀ n0 β v
  have hβ : ∀ (U U' : Y₀.Opens) (V V' : Y'.Opens) (i : U ≤ U') (k : V' ≤ V)
      (e : V ≤ φ' ⁻¹ᵁ U) (e' : V' ≤ φ' ⁻¹ᵁ U') (x : Γ(Y₀, U')),
      (Y'.presheaf.map (homOfLE k).op).hom ((φ'.appLE U V e).hom
        ((Y₀.presheaf.map (homOfLE i).op).hom x)) = (φ'.appLE U' V' e').hom x := by
    intro U U' V V' i k e e' x
    have key : Y₀.presheaf.map (homOfLE i).op ≫ φ'.appLE U V e ≫
        Y'.presheaf.map (homOfLE k).op = φ'.appLE U' V' e' := by
      rw [Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
    exact congrArg (fun h => h.hom x) key
  have hσ : ∀ (V V' : Y'.Opens) (k : V' ≤ V) (e : V ≤ q' ⁻¹ᵁ ⊤) (e' : V' ≤ q' ⁻¹ᵁ ⊤)
      (r : Γ(Spec (.of R), ⊤)),
      (Y'.presheaf.map (homOfLE k).op).hom ((q'.appLE ⊤ V e).hom r) =
        (q'.appLE ⊤ V' e').hom r := by
    intro V V' k e e' r
    have key : q'.appLE ⊤ V e ≫ Y'.presheaf.map (homOfLE k).op = q'.appLE ⊤ V' e' :=
      Scheme.Hom.appLE_map _ _ _
    exact congrArg (fun h => h.hom r) key
  funext b
  have hb : b = wcCbcmSingle (b 0) := by
    apply RelEmbedding.ext
    intro x
    rw [Fin.fin_one_eq_zero x]
    rfl
  obtain ⟨a, rfl⟩ : ∃ a, b = wcCbcmSingle a := ⟨b 0, hb⟩
  simp only [wcCbcmOfFam, map_sum, map_mul, Finset.sum_apply, Pi.mul_apply]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  refine (mul_comm _ _).trans ?_
  refine congrArg₂ (· * ·) ?_ ?_
  · exact hβ (L₀.V a) (wcCbcmV L₀ ⊤ (wcCbcmSingle a)) _
      (wcCbcmV (wcpaDjCocPull φ' L₀) (q' ⁻¹ᵁ ⊤) (wcCbcmSingle a)) _ _ _ _ _
  · exact hσ _ (wcCbcmV (wcpaDjCocPull φ' L₀) (q' ⁻¹ᵁ ⊤) (wcCbcmSingle a)) _ _ inf_le_right _

theorem wcpa_dj_lge_cbcm_pull_ok : ∀ (Y' Y : Scheme.{u}) (φ : Y' ⟶ Y) (L : wcpaDjCoc Y), IsAffineHom φ → wcpaDjCocOK L → wcpaDjCocOK (wcpaDjCocPull φ L) :=
by
  intro Y' Y φ L hφ hOK
  obtain ⟨hA, hcov, hid, hcoc⟩ := hOK
  have s6 : ∀ (U₁ U₂ : Y.Opens) (V₁ V₂ : Y'.Opens) (e₁ : V₁ ≤ φ ⁻¹ᵁ U₁) (e₂ : V₂ ≤ φ ⁻¹ᵁ U₂)
      (hU : U₂ ≤ U₁) (hV : V₂ ≤ V₁) (x : Γ(Y, U₁)),
      (Y'.presheaf.map (homOfLE hV).op).hom ((φ.appLE U₁ V₁ e₁).hom x) =
        (φ.appLE U₂ V₂ e₂).hom ((Y.presheaf.map (homOfLE hU).op).hom x) := by
    intro U₁ U₂ V₁ V₂ e₁ e₂ hU hV x
    have h1 := Scheme.Hom.appLE_map φ e₁ (homOfLE hV).op
    have h2 := Scheme.Hom.map_appLE φ e₂ (homOfLE hU).op
    change (φ.appLE U₁ V₁ e₁ ≫ Y'.presheaf.map (homOfLE hV).op).hom x =
      (Y.presheaf.map (homOfLE hU).op ≫ φ.appLE U₂ V₂ e₂).hom x
    rw [h1, h2]
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro a
    have := hφ
    exact (hA a).preimage φ
  · show (⨆ a, φ ⁻¹ᵁ L.V a) = ⊤
    rw [← Scheme.Hom.preimage_iSup, hcov, Scheme.Hom.preimage_top]
  · intro a
    show Units.map _ (L.g a a) = 1
    rw [hid a, map_one]
  · intro a b c
    have hle3 : φ ⁻¹ᵁ L.V a ⊓ φ ⁻¹ᵁ L.V b ⊓ φ ⁻¹ᵁ L.V c ≤ φ ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ L.V c) :=
      fun _ hx => hx
    have e1 := s6 (L.V a ⊓ L.V b) (L.V a ⊓ L.V b ⊓ L.V c) (φ ⁻¹ᵁ L.V a ⊓ φ ⁻¹ᵁ L.V b)
      (φ ⁻¹ᵁ L.V a ⊓ φ ⁻¹ᵁ L.V b ⊓ φ ⁻¹ᵁ L.V c) (fun _ hx => hx) hle3 inf_le_left inf_le_left
      (L.g a b : Γ(Y, L.V a ⊓ L.V b))
    have e2 := s6 (L.V b ⊓ L.V c) (L.V a ⊓ L.V b ⊓ L.V c) (φ ⁻¹ᵁ L.V b ⊓ φ ⁻¹ᵁ L.V c)
      (φ ⁻¹ᵁ L.V a ⊓ φ ⁻¹ᵁ L.V b ⊓ φ ⁻¹ᵁ L.V c) (fun _ hx => hx) hle3
      (le_inf (inf_le_left.trans inf_le_right) inf_le_right)
      (le_inf (inf_le_left.trans inf_le_right) inf_le_right)
      (L.g b c : Γ(Y, L.V b ⊓ L.V c))
    have e3 := s6 (L.V a ⊓ L.V c) (L.V a ⊓ L.V b ⊓ L.V c) (φ ⁻¹ᵁ L.V a ⊓ φ ⁻¹ᵁ L.V c)
      (φ ⁻¹ᵁ L.V a ⊓ φ ⁻¹ᵁ L.V b ⊓ φ ⁻¹ᵁ L.V c) (fun _ hx => hx) hle3
      (le_inf (inf_le_left.trans inf_le_left) inf_le_right)
      (le_inf (inf_le_left.trans inf_le_left) inf_le_right)
      (L.g a c : Γ(Y, L.V a ⊓ L.V c))
    have key := congrArg (φ.appLE (L.V a ⊓ L.V b ⊓ L.V c) _ hle3).hom (hcoc a b c)
    rw [map_mul, ← e1, ← e2, ← e3] at key
    exact key

theorem wcpa_dj_lge_cbcm_universal_model : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (Y₀ : Scheme.{u}) (q₀ : Y₀ ⟶ Spec (.of B)) (L₀ : wcpaDjCoc Y₀) (e : ℕ), IsProper q₀ → Flat q₀ → wcpaDjCocOK L₀ → wcCbcmFG q₀ L₀ e → ∃ (n0 n1 n2 : ℕ) (D0 : Matrix (Fin n1) (Fin n0) B) (D1 : Matrix (Fin n2) (Fin n1) B) (β0 : Fin n0 → ∀ a : Fin L₀.m, Γ(Y₀, L₀.V a)), D1 * D0 = 0 ∧ ∀ (R : Type u) [CommRing R] (f : B →+* R) (Y' : Scheme.{u}) (φ' : Y' ⟶ Y₀) (q' : Y' ⟶ Spec (.of R)), IsPullback φ' q' q₀ (Spec.map (CommRingCat.ofHom f)) → (∀ v : Fin n0 → R, (D0.map f).mulVec v = 0 → wcpaDjCompat (wcpaDjCocPull φ' L₀) (q' ⁻¹ᵁ ⊤) e (fun a => ∑ j, (q'.appLE ⊤ ((wcpaDjCocPull φ' L₀).V a ⊓ q' ⁻¹ᵁ ⊤) inf_le_right).hom ((Scheme.ΓSpecIso (.of R)).inv.hom (v j)) * (φ'.appLE (L₀.V a) ((wcpaDjCocPull φ' L₀).V a ⊓ q' ⁻¹ᵁ ⊤) inf_le_left).hom (β0 j a))) ∧ (∀ t : ∀ a : Fin (wcpaDjCocPull φ' L₀).m, Γ(Y', (wcpaDjCocPull φ' L₀).V a ⊓ q' ⁻¹ᵁ ⊤), wcpaDjCompat (wcpaDjCocPull φ' L₀) (q' ⁻¹ᵁ ⊤) e t → ∃! v : Fin n0 → R, (D0.map f).mulVec v = 0 ∧ ∀ a, t a = ∑ j, (q'.appLE ⊤ ((wcpaDjCocPull φ' L₀).V a ⊓ q' ⁻¹ᵁ ⊤) inf_le_right).hom ((Scheme.ΓSpecIso (.of R)).inv.hom (v j)) * (φ'.appLE (L₀.V a) ((wcpaDjCocPull φ' L₀).V a ⊓ q' ⁻¹ᵁ ⊤) inf_le_left).hom (β0 j a)) ∧ (wcpaDjTwH1 (wcpaDjCocPull φ' L₀) ⊤ (wcStructMod Y') e → ∀ w : Fin n1 → R, (D1.map f).mulVec w = 0 → ∃ v : Fin n0 → R, w = (D0.map f).mulVec v) :=
by
  intro B _ _ Y₀ q₀ L₀ e hprop hflat hOK hFG
  classical
  haveI := hprop
  have hsep : IsSeparated q₀ := inferInstance
  letI inst : ∀ p, Module B (wcCbcmC L₀ ⊤ p) := fun p =>
    Module.compHom (wcCbcmC L₀ ⊤ p) (wcCbcmSig q₀ L₀ ⊤ p)
  let d : ∀ p, wcCbcmC L₀ ⊤ p →ₗ[B] wcCbcmC L₀ ⊤ (p + 1) := fun p =>
    { toFun := fun z => wcCbcmD L₀ ⊤ e p z
      map_add' := fun x y => map_add _ x y
      map_smul' := fun b z => wcpa_dj_lge_cbcm_d_smul B Y₀ q₀ L₀ ⊤ e p b z }
  have hd : ∀ p z, d p z = wcCbcmD L₀ ⊤ e p z := fun _ _ => rfl

  have hdd : ∀ p, (d (p + 1)).comp (d p) = 0 := fun p =>
    LinearMap.ext fun z => wcpa_dj_lge_cbcm_dd_zero Y₀ L₀ ⊤ e p hOK z
  have hsub : ∀ p, L₀.m ≤ p → Subsingleton (wcCbcmC L₀ ⊤ p) := by
    intro p hp
    have hE : IsEmpty (Fin (p + 1) ↪o Fin L₀.m) := ⟨fun a => by
      have h := Fintype.card_le_of_embedding a.toEmbedding
      simp only [Fintype.card_fin] at h
      omega⟩
    exact ⟨fun x y => funext fun a => isEmptyElim a⟩
  have hfl : ∀ p, Module.Flat B (wcCbcmC L₀ ⊤ p) := fun p =>
    wcpa_dj_lge_cbcm_sections_flat B Y₀ q₀ L₀ p hflat hsep hOK.1
  have hker : (LinearMap.ker (d 0)).FG := by
    obtain ⟨k, c, hc, hspan⟩ := hFG.1
    have hEq : LinearMap.ker (d 0) = Submodule.span B (Set.range c) := by
      apply le_antisymm
      · intro z hz
        rw [LinearMap.mem_ker, hd] at hz
        obtain ⟨b, hb⟩ := hspan z hz
        rw [hb]
        refine Submodule.sum_mem _ (fun i _ => ?_)
        exact Submodule.smul_mem _ (b i) (Submodule.subset_span ⟨i, rfl⟩)
      · rw [Submodule.span_le]
        rintro _ ⟨i, rfl⟩
        exact hc i
    rw [Submodule.fg_def]
