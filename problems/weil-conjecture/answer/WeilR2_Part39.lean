theorem wcpa_dj_lge_cbc_model : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Y : Scheme.{u}) (q : Y ⟶ Spec (.of ↥W)) (L : wcpaDjCoc Y) (e : ℕ), wcpaDjSemistable q → wcpaDjCocOK L → ∃ (n0 n1 n2 : ℕ) (D0 : Matrix (Fin n1) (Fin n0) ↥W) (D1 : Matrix (Fin n2) (Fin n1) ↥W) (β : Fin n0 → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)), D1 * D0 = 0 ∧ (∀ v : Fin n0 → ↥W, D0.mulVec v = 0 → wcpaDjCompat L (q ⁻¹ᵁ ⊤) e (fun a => ∑ j, (q.appLE ⊤ (L.V a ⊓ q ⁻¹ᵁ ⊤) inf_le_right).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom (v j)) * β j a)) ∧ (∀ t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤), wcpaDjCompat L (q ⁻¹ᵁ ⊤) e t → ∃! v : Fin n0 → ↥W, D0.mulVec v = 0 ∧ ∀ a, t a = ∑ j, (q.appLE ⊤ (L.V a ⊓ q ⁻¹ᵁ ⊤) inf_le_right).hom ((Scheme.ΓSpecIso (.of ↥W)).inv.hom (v j)) * β j a) ∧ (∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥W)), (∀ v : Fin n0 → K, (D0.map (Spec.preimage s).hom).mulVec v = 0 → wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst q s) L) ((Limits.pullback.snd q s) ⁻¹ᵁ ⊤) e (fun a => ∑ j, wcpaLccScal (Limits.pullback.snd q s) _ (v j) * wcpaLccPullFam q L s (β j) a)) ∧ ∀ t' : ∀ a : Fin L.m, Γ(Limits.pullback q s, (wcpaDjCocPull (Limits.pullback.fst q s) L).V a ⊓ (Limits.pullback.snd q s) ⁻¹ᵁ ⊤), wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst q s) L) ((Limits.pullback.snd q s) ⁻¹ᵁ ⊤) e t' → ∃! v : Fin n0 → K, (D0.map (Spec.preimage s).hom).mulVec v = 0 ∧ ∀ a, t' a = ∑ j, wcpaLccScal (Limits.pullback.snd q s) _ (v j) * wcpaLccPullFam q L s (β j) a) ∧ (wcpaDjTwH1 (wcpaDjCocPull (Limits.pullback.fst q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L) ⊤ (wcStructMod (Limits.pullback q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))) e → ∀ w : Fin n1 → IsLocalRing.ResidueField ↥W, (D1.map (IsLocalRing.residue ↥W)).mulVec w = 0 → ∃ v : Fin n0 → IsLocalRing.ResidueField ↥W, w = (D0.map (IsLocalRing.residue ↥W)).mulVec v) :=
by
  intro Ω _ W Y q L e hss hOK
  obtain ⟨B, _, _, ψ, Y₀, q₀, φ, L₀, hprop, hflat, hpb, hOK₀, hL⟩ :=
    wcpa_dj_lge_cbcm_flat_model Ω W Y q L hss hOK
  subst hL
  have hFG := wcpa_dj_lge_cbcm_cech_fg B Y₀ q₀ L₀ hprop hOK₀ e
  obtain ⟨n0, n1, n2, D0, D1, β0, h10, hU⟩ :=
    wcpa_dj_lge_cbcm_universal_model B Y₀ q₀ L₀ e hprop hflat hOK₀ hFG

  have hcomp : ∀ {X1 X2 X3 : Scheme.{u}} (f : X1 ⟶ X2) (g : X2 ⟶ X3) (L : wcpaDjCoc X3)
      (a b : Fin (wcpaDjCocPull f (wcpaDjCocPull g L)).m),
      (((wcpaDjCocPull f (wcpaDjCocPull g L)).g a b :
          Γ(X1, (wcpaDjCocPull f (wcpaDjCocPull g L)).V a ⊓
            (wcpaDjCocPull f (wcpaDjCocPull g L)).V b))) =
      (((wcpaDjCocPull (f ≫ g) L).g a b :
          Γ(X1, (wcpaDjCocPull (f ≫ g) L).V a ⊓ (wcpaDjCocPull (f ≫ g) L).V b))) := by
    intro X1 X2 X3 f g L a b
    exact congrArg (fun h => h.hom (L.g a b : Γ(X3, L.V a ⊓ L.V b)))
      (Scheme.Hom.appLE_comp_appLE f g (L.V a ⊓ L.V b) (g ⁻¹ᵁ L.V a ⊓ g ⁻¹ᵁ L.V b)
        (f ⁻¹ᵁ (g ⁻¹ᵁ L.V a) ⊓ f ⁻¹ᵁ (g ⁻¹ᵁ L.V b)) le_rfl le_rfl)
  have hcompat : ∀ {X1 X2 X3 : Scheme.{u}} (f : X1 ⟶ X2) (g : X2 ⟶ X3) (L : wcpaDjCoc X3)
      (O : X1.Opens) (n : ℕ)
      (t : ∀ a : Fin (wcpaDjCocPull f (wcpaDjCocPull g L)).m,
        Γ(X1, (wcpaDjCocPull f (wcpaDjCocPull g L)).V a ⊓ O)),
      wcpaDjCompat (wcpaDjCocPull f (wcpaDjCocPull g L)) O n t ↔
        wcpaDjCompat (wcpaDjCocPull (f ≫ g) L) O n t := by
    intro X1 X2 X3 f g L O n t
    unfold wcpaDjCompat
    simp only [hcomp f g L]
    exact Iff.rfl
  have htw : ∀ {X1 X2 X3 : Scheme.{u}} (f : X1 ⟶ X2) (g : X2 ⟶ X3) (L : wcpaDjCoc X3) (n : ℕ),
      wcpaDjTwH1 (wcpaDjCocPull f (wcpaDjCocPull g L)) ⊤ (wcStructMod X1) n ↔
        wcpaDjTwH1 (wcpaDjCocPull (f ≫ g) L) ⊤ (wcStructMod X1) n := by
    intro X1 X2 X3 f g L n
    unfold wcpaDjTwH1
    simp only [hcomp f g L]
    exact Iff.rfl
  have hfield : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥W)),
      IsPullback (Limits.pullback.fst q s ≫ φ) (Limits.pullback.snd q s) q₀
        (Spec.map (CommRingCat.ofHom ((Spec.preimage s).hom.comp ψ))) := by
    intro K _ s
    have h2 : s ≫ Spec.map (CommRingCat.ofHom ψ) =
        Spec.map (CommRingCat.ofHom ((Spec.preimage s).hom.comp ψ)) := by
      conv_lhs => rw [← Spec.map_preimage s]
      rw [← Spec.map_comp]
      rfl
    rw [← h2]
    exact (IsPullback.of_hasPullback q s).paste_horiz hpb
  have hPF : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥W)) (j : Fin n0)
      (a : Fin L₀.m),
      wcpaLccPullFam q (wcpaDjCocPull φ L₀) s
        (fun a => (φ.appLE (L₀.V a) ((wcpaDjCocPull φ L₀).V a ⊓ q ⁻¹ᵁ ⊤) inf_le_left).hom
          (β0 j a)) a =
      ((Limits.pullback.fst q s ≫ φ).appLE (L₀.V a)
        ((wcpaDjCocPull (Limits.pullback.fst q s ≫ φ) L₀).V a ⊓ (Limits.pullback.snd q s) ⁻¹ᵁ ⊤)
        inf_le_left).hom (β0 j a) := by
    intro K _ s j a
    have key := Scheme.Hom.appLE_comp_appLE (Limits.pullback.fst q s) φ (L₀.V a)
      ((wcpaDjCocPull φ L₀).V a ⊓ q ⁻¹ᵁ ⊤)
      ((wcpaDjCocPull (Limits.pullback.fst q s ≫ φ) L₀).V a ⊓ (Limits.pullback.snd q s) ⁻¹ᵁ ⊤)
      inf_le_left (fun x hx => ⟨hx.1, trivial⟩)
    exact congrArg (fun h : Γ(Y₀, L₀.V a) ⟶ Γ(Limits.pullback q s,
      (wcpaDjCocPull (Limits.pullback.fst q s ≫ φ) L₀).V a ⊓ (Limits.pullback.snd q s) ⁻¹ᵁ ⊤) =>
        h.hom (β0 j a)) key
  have hfam : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥W)) (v : Fin n0 → K),
      (fun a => ∑ j, wcpaLccScal (Limits.pullback.snd q s) _ (v j) *
        wcpaLccPullFam q (wcpaDjCocPull φ L₀) s
          (fun a => (φ.appLE (L₀.V a) ((wcpaDjCocPull φ L₀).V a ⊓ q ⁻¹ᵁ ⊤) inf_le_left).hom
            (β0 j a)) a) =
      (fun a => ∑ j, ((Limits.pullback.snd q s).appLE ⊤
          ((wcpaDjCocPull (Limits.pullback.fst q s ≫ φ) L₀).V a ⊓ (Limits.pullback.snd q s) ⁻¹ᵁ ⊤)
          inf_le_right).hom ((Scheme.ΓSpecIso (.of K)).inv.hom (v j)) *
        ((Limits.pullback.fst q s ≫ φ).appLE (L₀.V a)
          ((wcpaDjCocPull (Limits.pullback.fst q s ≫ φ) L₀).V a ⊓ (Limits.pullback.snd q s) ⁻¹ᵁ ⊤)
          inf_le_left).hom (β0 j a)) := by
    intro K _ s v
    funext a
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [hPF K s j a]
    rfl
  refine ⟨n0, n1, n2, D0.map ψ, D1.map ψ, fun j a =>
    (φ.appLE (L₀.V a) ((wcpaDjCocPull φ L₀).V a ⊓ q ⁻¹ᵁ ⊤) inf_le_left).hom (β0 j a),
    ?_, ?_, ?_, ?_, ?_⟩
  · rw [← Matrix.map_mul, h10]
    simp
  · exact (hU (↥W) ψ Y φ q hpb).1
  · exact (hU (↥W) ψ Y φ q hpb).2.1
  · intro K _ s
    obtain ⟨hA, hB, -⟩ := hU K ((Spec.preimage s).hom.comp ψ) _ _ _ (hfield K s)
    refine ⟨fun v hv => ?_, fun t' ht' => ?_⟩
    · rw [Matrix.map_map] at hv
      refine (hcompat _ _ _ _ _ _).mpr ?_
      exact cast (congrArg (wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst q s ≫ φ) L₀)
        ((Limits.pullback.snd q s) ⁻¹ᵁ ⊤) e) (hfam K s v)).symm (hA v hv)
    · obtain ⟨v, ⟨hv0, hvt⟩, hvu⟩ := hB t' ((hcompat _ _ _ _ _ _).mp ht')
      refine ⟨v, ⟨?_, fun a => ?_⟩, fun v' hv' => hvu v' ⟨?_, fun a => ?_⟩⟩
      · rw [Matrix.map_map]
        exact hv0
      · exact (hvt a).trans (congrFun (hfam K s v) a).symm
      · have h1 := hv'.1
        rw [Matrix.map_map] at h1
        exact h1
      · exact (hv'.2 a).trans (congrFun (hfam K s v') a)
  · intro hTw w hw
    obtain ⟨-, -, hC⟩ := hU (IsLocalRing.ResidueField ↥W)
      ((Spec.preimage (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).hom.comp ψ) _ _ _
      (hfield (IsLocalRing.ResidueField ↥W)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
    have hres : (Spec.preimage (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).hom = IsLocalRing.residue ↥W := by
      rw [Spec.preimage_map]
      rfl
    have hM : ∀ {n m : ℕ} (M : Matrix (Fin n) (Fin m) B),
        M.map ((Spec.preimage (Spec.map (CommRingCat.ofHom
