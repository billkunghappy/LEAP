      · rintro ⟨y, ⟨x, hx, rfl⟩, hr⟩
        exact ⟨x, hx, (hR i x).mpr (by rw [← hh]; exact hr)⟩
    rw [hcard, ← hcnt]
    exact key
  have wcpa_dj_sol_fibre_transfer : ∀ (T T' Z Z' : Scheme.{u}) (u : Z ⟶ T) (τ : Fin n → (T ⟶ Z))
      (b : T' ⟶ T) (u' : Z' ⟶ T') (φ : Z' ⟶ Z) (τ' : Fin n → (T' ⟶ Z')), IsPullback φ u' u b →
