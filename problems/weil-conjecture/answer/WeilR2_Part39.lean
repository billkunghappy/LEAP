          Spec.map (CommRingCat.ofHom (Subring.inclusion h1)) =
        Spec.map (CommRingCat.ofHom (Subring.inclusion h3)) := by
      intro S S' S'' h1 h2 h3
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
      rfl
    intro T U U' h1 h2 h3
    exact G _ _ _ h1 h2 h3
  have hpqc : QuasiCompact p := by
    haveI : QuasiCompact (p ≫ k₀) := by rw [hp]; infer_instance
    exact QuasiCompact.of_comp p k₀

  have key : ∀ V : Y₀.Opens, IsAffineOpen V → ∃ T : Finset A, ∀ (S : Finset A)
      (hS : Subring.closure (S₀ : Set A) ≤ Subring.closure (S : Set A)),
      Subring.closure (T : Set A) ≤ Subring.closure (S : Set A) →
      ∀ {QX QY : Scheme.{u}} (a'X : QX ⟶ (p ⁻¹ᵁ V).toScheme)
        (s'X : QX ⟶ Spec (.of ↥(Subring.closure (S : Set A)))) (a'Y : QY ⟶ V.toScheme)
        (s'Y : QY ⟶ Spec (.of ↥(Subring.closure (S : Set A)))),
      IsPullback a'X s'X ((p ⁻¹ᵁ V).ι ≫ h₀) (Spec.map (CommRingCat.ofHom (Subring.inclusion hS))) →
      IsPullback a'Y s'Y (V.ι ≫ k₀) (Spec.map (CommRingCat.ofHom (Subring.inclusion hS))) →
      ∀ c' : QX ⟶ QY, c' ≫ s'Y = s'X → c' ≫ a'Y = a'X ≫ (p ∣_ V) → IsClosedImmersion c' := by
    intro V hVa
    haveI : IsAffine V.toScheme := hVa
    have hpV : (p ∣_ V) ≫ (V.ι ≫ k₀) = (p ⁻¹ᵁ V).ι ≫ h₀ := by
      rw [morphismRestrict_ι_assoc, hp]
    haveI : QuasiCompact ((p ⁻¹ᵁ V).ι ≫ h₀) := by rw [← hpV]; infer_instance
    obtain ⟨πX', hX', hY', hqw', hqπ'⟩ := t_restrict h₀ k₀ p _ πX f πY w hX hY q hqw hqπ V
    haveI : IsAffine (πY ⁻¹ᵁ V).toScheme := IsAffine.of_isIso hY'.isoPullback.hom
    haveI : IsAffine (q ⁻¹ᵁ (πY ⁻¹ᵁ V)).toScheme := isAffine_of_isAffineHom (q ∣_ (πY ⁻¹ᵁ V))
    obtain ⟨S₁, hS₁, hAff⟩ := H5 A S₀ _ ((p ⁻¹ᵁ V).ι ≫ h₀) _ _ πX' hX' inferInstance
    haveI := hAff
    obtain ⟨ψX, hψX, hψX1⟩ := t_raise ((p ⁻¹ᵁ V).ι ≫ h₀)
      (Spec.map (CommRingCat.ofHom (Subring.inclusion hS₁))) _ _ (R1 S₀ S₁ hS₁) _ _ hX'
    obtain ⟨ψY, hψY, hψY1⟩ := t_raise (V.ι ≫ k₀)
      (Spec.map (CommRingCat.ofHom (Subring.inclusion hS₁))) _ _ (R1 S₀ S₁ hS₁) _ _ hY'
    have wpg : (Limits.pullback.fst ((p ⁻¹ᵁ V).ι ≫ h₀)
          (Spec.map (CommRingCat.ofHom (Subring.inclusion hS₁))) ≫ (p ∣_ V)) ≫ (V.ι ≫ k₀) =
        Limits.pullback.snd ((p ⁻¹ᵁ V).ι ≫ h₀)
          (Spec.map (CommRingCat.ofHom (Subring.inclusion hS₁))) ≫
          Spec.map (CommRingCat.ofHom (Subring.inclusion hS₁)) := by
      rw [Category.assoc, hpV, Limits.pullback.condition]
    obtain ⟨pg, hpg1, hpg2⟩ : ∃ pg : Limits.pullback ((p ⁻¹ᵁ V).ι ≫ h₀)
          (Spec.map (CommRingCat.ofHom (Subring.inclusion hS₁))) ⟶
        Limits.pullback (V.ι ≫ k₀) (Spec.map (CommRingCat.ofHom (Subring.inclusion hS₁))),
        pg ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ ∧
        pg ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ≫ (p ∣_ V) :=
      ⟨Limits.pullback.lift _ _ wpg, Limits.pullback.lift_snd _ _ _,
        Limits.pullback.lift_fst _ _ _⟩
    have hqψ : (q ∣_ (πY ⁻¹ᵁ V)) ≫ ψY = ψX ≫ pg := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hψY1, Category.assoc, hpg2, reassoc_of% hψX1, hqπ']
      · simp only [Category.assoc, hψY.w, hpg1, hψX.w, reassoc_of% hqw']
    obtain ⟨T₁, hT₁, c₁, hc₁, hc₁s, hc₁f⟩ := HA A S₁ _ _ _ _ pg _ _ _ _ ψX ψY
      (q ∣_ (πY ⁻¹ᵁ V)) hpg1 hψX hψY hqψ hqw' inferInstance
    refine ⟨T₁, ?_⟩
    intro S hS hTS QX QY a'X s'X a'Y s'Y hQX hQY c' hc's hc'a
    have hb : Spec.map (CommRingCat.ofHom (Subring.inclusion hTS)) ≫
        (Spec.map (CommRingCat.ofHom (Subring.inclusion hT₁)) ≫
          Spec.map (CommRingCat.ofHom (Subring.inclusion hS₁))) =
        Spec.map (CommRingCat.ofHom (Subring.inclusion hS)) := by
      rw [← Category.assoc, R2 S₁ T₁ S hT₁ hTS (hT₁.trans hTS),
        R2 S₀ S₁ S hS₁ (hT₁.trans hTS) hS]
    refine t_transport _ _ (p ∣_ V) _ _ _ hb _ _ _ _ a'X s'X a'Y s'Y
      ((IsPullback.of_hasPullback _ _).paste_horiz (IsPullback.of_hasPullback _ _))
      ((IsPullback.of_hasPullback _ _).paste_horiz (IsPullback.of_hasPullback _ _))
      hQX hQY c₁ hc₁ hc₁s ?_ c' hc's hc'a
    rw [← Category.assoc, hc₁f, Category.assoc, hpg2, Category.assoc]

  haveI : CompactSpace Y₀ := QuasiCompact.compactSpace_of_compactSpace k₀
  have hcpt : IsCompact ((⊤ : Y₀.Opens) : Set Y₀) := by
    rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ
  obtain ⟨s, hs, hU⟩ := isCompact_iff_finite_and_eq_biUnion_affineOpens.mp hcpt
  haveI : Fintype s := hs.fintype
  choose T hT using fun i : s => key i.1.1 i.1.2
  let S : Finset A := S₀ ∪ Finset.univ.biUnion T
  have hS : Subring.closure (S₀ : Set A) ≤ Subring.closure (S : Set A) :=
    Subring.closure_mono (Finset.coe_subset.mpr Finset.subset_union_left)
  have hTS : ∀ i, Subring.closure (T i : Set A) ≤ Subring.closure (S : Set A) := fun i =>
    Subring.closure_mono (Finset.coe_subset.mpr
      ((Finset.subset_biUnion_of_mem T (Finset.mem_univ i)).trans Finset.subset_union_right))
  have wp : (Limits.pullback.fst h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS))) ≫ p) ≫
      k₀ = Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS))) ≫
        Spec.map (CommRingCat.ofHom (Subring.inclusion hS)) := by
    rw [Category.assoc, hp, Limits.pullback.condition]
  refine ⟨S, hS, Limits.pullback.lift _ _ wp, ?_, Limits.pullback.lift_snd _ _ _,
    Limits.pullback.lift_fst _ _ _⟩
  have hV : iSup (fun i : s => i.1.1) = ⊤ := by
    refine le_antisymm le_top ?_
    rw [hU]
    exact iSup₂_le (fun i hi => le_iSup (fun j : s => j.1.1) ⟨i, hi⟩)
  refine IsZariskiLocalAtTarget.of_iSup_eq_top (P := @IsClosedImmersion)
    (fun i : s => Limits.pullback.fst k₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS))) ⁻¹ᵁ
      i.1.1) ?_ ?_
  · rw [← Scheme.Hom.preimage_iSup, hV, Scheme.Hom.preimage_top]
  · intro i
    obtain ⟨a'X, hQX, hQY, hcs', hca'⟩ := t_restrict h₀ k₀ p _ _ _ _ _
      (IsPullback.of_hasPullback _ _) (IsPullback.of_hasPullback _ _)
      (Limits.pullback.lift _ _ wp) (Limits.pullback.lift_snd _ _ _)
      (Limits.pullback.lift_fst _ _ _) i.1.1
    exact hT i S hS (hTS i) a'X _ _ _ hQX hQY _ hcs' hca'

theorem wcpa_dj_lpm_tensor_surj_level : ∀ (A : Type u) [CommRing A] (S₀ : Finset A) (B C : Type u) [CommRing B] [CommRing C] [Algebra ↥(Subring.closure (S₀ : Set A)) B] [Algebra ↥(Subring.closure (S₀ : Set A)) C] [Algebra.FiniteType ↥(Subring.closure (S₀ : Set A)) C] (ψ : B →ₐ[↥(Subring.closure (S₀ : Set A))] C), Function.Surjective (Algebra.TensorProduct.map ψ (AlgHom.id ↥(Subring.closure (S₀ : Set A)) A)) → ∃ (S : Finset A) (hS : Subring.closure (S₀ : Set A) ≤ Subring.closure (S : Set A)), letI := (Subring.inclusion hS).toAlgebra; Function.Surjective (Algebra.TensorProduct.map ψ (AlgHom.id ↥(Subring.closure (S₀ : Set A)) ↥(Subring.closure (S : Set A)))) :=
by

  have s1 : ∀ (R : Type u) [CommRing R] (B C D : Type u) [CommRing B] [CommRing C] [CommRing D]
      [Algebra R B] [Algebra R C] [Algebra R D] (ψ : B →ₐ[R] C) (z : TensorProduct R B D),
      Algebra.TensorProduct.map ψ (AlgHom.id R D) z = LinearMap.rTensor D ψ.toLinearMap z := by
    intro R _ B C D _ _ _ _ _ _ ψ z
    induction z using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero]
    | tmul b d => rw [Algebra.TensorProduct.map_tmul, LinearMap.rTensor_tmul]; rfl
    | add x y hx hy => rw [map_add, map_add, hx, hy]

  have gen_surj : ∀ (R : Type u) [CommRing R] (B C D : Type u) [CommRing B] [CommRing C]
      [CommRing D] [Algebra R B] [Algebra R C] [Algebra R D] (ψ : B →ₐ[R] C) (t : Finset C),
      Algebra.adjoin R (t : Set C) = ⊤ →
      (∀ c ∈ t, c ⊗ₜ[R] (1 : D) ∈ (Algebra.TensorProduct.map ψ (AlgHom.id R D)).range) →
      Function.Surjective (Algebra.TensorProduct.map ψ (AlgHom.id R D)) := by
    intro R _ B C D _ _ _ _ _ _ ψ t ht hgen
    set K := (Algebra.TensorProduct.map ψ (AlgHom.id R D)).range with hK
    have h1 : ∀ c : C, c ⊗ₜ[R] (1 : D) ∈ K := by
      have hle : Algebra.adjoin R (t : Set C) ≤
          K.comap (Algebra.TensorProduct.includeLeft : C →ₐ[R] TensorProduct R C D) := by
        rw [Algebra.adjoin_le_iff]
        intro c hc
        rw [SetLike.mem_coe, Subalgebra.mem_comap, Algebra.TensorProduct.includeLeft_apply]
        exact hgen c hc
      intro c
      have hc : c ∈ K.comap (Algebra.TensorProduct.includeLeft : C →ₐ[R] TensorProduct R C D) := by
        apply hle
        rw [ht]
        trivial
      rw [Subalgebra.mem_comap, Algebra.TensorProduct.includeLeft_apply] at hc
      exact hc
    have h2 : ∀ d : D, (1 : C) ⊗ₜ[R] d ∈ K := by
      intro d
      refine (AlgHom.mem_range _).mpr ⟨(1 : B) ⊗ₜ[R] d, ?_⟩
      rw [Algebra.TensorProduct.map_tmul, map_one, AlgHom.id_apply]
    have h3 : ∀ (c : C) (d : D), c ⊗ₜ[R] d ∈ K := by
      intro c d
      have e : c ⊗ₜ[R] d = (c ⊗ₜ[R] (1 : D)) * ((1 : C) ⊗ₜ[R] d) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [e]
      exact K.mul_mem (h1 c) (h2 d)
    intro z
    have hz : z ∈ K := by
      induction z using TensorProduct.induction_on with
      | zero => exact K.zero_mem
      | tmul c d => exact h3 c d
      | add x y hx hy => exact K.add_mem hx hy
    exact (AlgHom.mem_range _).mp hz

  have s3 : ∀ (R : Type u) [CommRing R] (M P : Type u) [AddCommGroup M] [Module R M]
      [AddCommGroup P] [Module R P] (N : Submodule R P), N.FG → ∀ (ι : Type u) [Finite ι]
      (x y : ι → TensorProduct R M ↥N),
      (∀ j, LinearMap.lTensor M N.subtype (x j) = LinearMap.lTensor M N.subtype (y j)) →
      ∃ (N' : Submodule R P) (_ : N'.FG) (h : N ≤ N'), ∀ j,
        LinearMap.lTensor M (Submodule.inclusion h) (x j) =
          LinearMap.lTensor M (Submodule.inclusion h) (y j) := by
    intro R _ M P _ _ _ _ N hN ι _ x y hxy
    have key : ∀ j, ∃ (N'' : Submodule R P), N''.FG ∧ ∃ (h : N ≤ N''),
        LinearMap.lTensor M (Submodule.inclusion h) (x j) =
          LinearMap.lTensor M (Submodule.inclusion h) (y j) := by
      intro j
      have e1 : LinearMap.rTensor M N.subtype (TensorProduct.comm R M N (x j)) =
          LinearMap.rTensor M N.subtype (TensorProduct.comm R M N (y j)) := by
        rw [LinearMap.rTensor_comm, LinearMap.rTensor_comm, hxy j]
      obtain ⟨N'', hfg, h, he⟩ := Submodule.FG.exists_rTensor_fg_inclusion_eq hN e1
      refine ⟨N'', hfg, h, ?_⟩
      rw [LinearMap.rTensor_comm, LinearMap.rTensor_comm] at he
      exact (TensorProduct.comm R M N'').injective he
    choose N'' hfg h he using key
    refine ⟨N ⊔ ⨆ j, N'' j, hN.sup (Submodule.fg_iSup _ hfg), le_sup_left, ?_⟩
    intro j
    have hk : N'' j ≤ N ⊔ ⨆ j, N'' j := le_trans (le_iSup N'' j) le_sup_right
    have hcomp : Submodule.inclusion (le_sup_left : N ≤ N ⊔ ⨆ j, N'' j) =
        Submodule.inclusion hk ∘ₗ Submodule.inclusion (h j) := by
      apply LinearMap.ext
      intro p
      rfl
    rw [hcomp, LinearMap.lTensor_comp, LinearMap.comp_apply, LinearMap.comp_apply, he j]

  intro A _ S₀ B C _ _ _ _ _ ψ hsurj
  classical
  obtain ⟨t, ht⟩ :=
    (Algebra.FiniteType.out : (⊤ : Subalgebra (↥(Subring.closure (S₀ : Set A))) C).FG)
  have hX : ∀ c : ↥t, ∃ X : TensorProduct (↥(Subring.closure (S₀ : Set A))) B A,
      Algebra.TensorProduct.map ψ (AlgHom.id _ A) X = (c : C) ⊗ₜ (1 : A) := fun c => hsurj _
  choose X hXeq using hX
  obtain ⟨N₁, hN₁fin, hN₁⟩ :=
    TensorProduct.exists_finite_submodule_right_of_setFinite (Set.range X) (Set.finite_range X)
  set N : Submodule (↥(Subring.closure (S₀ : Set A))) A :=
    N₁ ⊔ Submodule.span (↥(Subring.closure (S₀ : Set A))) {1} with hNdef
  have hNfg : N.FG := (Module.Finite.iff_fg.mp hN₁fin).sup (Submodule.fg_span_singleton 1)
  let oneN : ↥N := ⟨1, Submodule.mem_sup_right (Submodule.mem_span_singleton_self 1)⟩
  have hy : ∀ c : ↥t, ∃ y : TensorProduct (↥(Subring.closure (S₀ : Set A))) B ↥N₁,
      LinearMap.lTensor B N₁.subtype y = X c :=
    fun c => LinearMap.mem_range.mp (hN₁ (Set.mem_range_self c))
  choose y hy' using hy
  let Xt : ↥t → TensorProduct (↥(Subring.closure (S₀ : Set A))) B ↥N := fun c =>
    LinearMap.lTensor B (Submodule.inclusion (le_sup_left : N₁ ≤ N)) (y c)
  have hXt : ∀ c, LinearMap.lTensor B N.subtype (Xt c) = X c := by
    intro c
    show LinearMap.lTensor B N.subtype
      (LinearMap.lTensor B (Submodule.inclusion (le_sup_left : N₁ ≤ N)) (y c)) = X c
    rw [← LinearMap.comp_apply, ← LinearMap.lTensor_comp, Submodule.subtype_comp_inclusion, hy']
  let u : ↥t → TensorProduct (↥(Subring.closure (S₀ : Set A))) C ↥N := fun c =>
    LinearMap.rTensor ↥N ψ.toLinearMap (Xt c)
  let v : ↥t → TensorProduct (↥(Subring.closure (S₀ : Set A))) C ↥N := fun c =>
    (c : C) ⊗ₜ oneN
  have huv : ∀ c, LinearMap.lTensor C N.subtype (u c) = LinearMap.lTensor C N.subtype (v c) := by
    intro c
    show LinearMap.lTensor C N.subtype (LinearMap.rTensor ↥N ψ.toLinearMap (Xt c)) =
      LinearMap.lTensor C N.subtype ((c : C) ⊗ₜ oneN)
    rw [← LinearMap.comp_apply, LinearMap.lTensor_comp_rTensor, ← LinearMap.rTensor_comp_lTensor,
      LinearMap.comp_apply, hXt, ← s1 _ B C A ψ (X c), hXeq, LinearMap.lTensor_tmul]
    rfl
  obtain ⟨N', hN'fg, h, heq⟩ := s3 _ C A N hNfg ↥t u v huv
  obtain ⟨G, hG⟩ := hN'fg
  have hS : Subring.closure (S₀ : Set A) ≤ Subring.closure ((S₀ ∪ G : Finset A) : Set A) :=
    Subring.closure_mono (by rw [Finset.coe_union]; exact Set.subset_union_left)
  refine ⟨S₀ ∪ G, hS, ?_⟩
  letI := (Subring.inclusion hS).toAlgebra
  have hmem : ∀ a ∈ N', a ∈ Subring.closure ((S₀ ∪ G : Finset A) : Set A) := by
    intro a ha
    rw [← hG] at ha
    induction ha using Submodule.span_induction with
    | mem x hx =>
      exact Subring.subset_closure (by rw [Finset.coe_union]; exact Set.mem_union_right _ hx)
    | zero => exact zero_mem _
    | add x y _ _ hx hy => exact add_mem hx hy
    | smul r x _ hx =>
      rw [Subring.smul_def, smul_eq_mul]
      exact mul_mem (hS r.2) hx
  let j : ↥N' →ₗ[↥(Subring.closure (S₀ : Set A))] ↥(Subring.closure ((S₀ ∪ G : Finset A) : Set A)) :=
    { toFun := fun x => ⟨(x : A), hmem x x.2⟩
      map_add' := fun x y => rfl
      map_smul' := fun r x => by
        apply Subtype.ext
        rfl }
  have hgen : ∀ c ∈ t, c ⊗ₜ[↥(Subring.closure (S₀ : Set A))]
      (1 : ↥(Subring.closure ((S₀ ∪ G : Finset A) : Set A))) ∈
      (Algebra.TensorProduct.map ψ
        (AlgHom.id _ ↥(Subring.closure ((S₀ ∪ G : Finset A) : Set A)))).range := by
    intro c hc
    refine (AlgHom.mem_range _).mpr
      ⟨LinearMap.lTensor B (j ∘ₗ Submodule.inclusion h) (Xt ⟨c, hc⟩), ?_⟩
    rw [s1 _ B C _ ψ, ← LinearMap.comp_apply (LinearMap.rTensor _ _),
      LinearMap.rTensor_comp_lTensor, ← LinearMap.lTensor_comp_rTensor, LinearMap.comp_apply]
    change LinearMap.lTensor C (j ∘ₗ Submodule.inclusion h) (u ⟨c, hc⟩) = _
    rw [LinearMap.lTensor_comp, LinearMap.comp_apply, heq ⟨c, hc⟩]
    show LinearMap.lTensor C j (LinearMap.lTensor C (Submodule.inclusion h) ((c : C) ⊗ₜ oneN)) = _
    rw [LinearMap.lTensor_tmul, LinearMap.lTensor_tmul]
    rfl
  exact gen_surj _ B C _ ψ t ht hgen

theorem wcpa_dj_lpm_affine_level : ∀ (A : Type u) [CommRing A] (S₀ : Finset A) (X₀ : Scheme.{u}) (h₀ : X₀ ⟶ Spec (.of ↥(Subring.closure (S₀ : Set A)))) [QuasiCompact h₀] [QuasiSeparated h₀] [LocallyOfFinitePresentation h₀] (Z : Scheme.{u}) (f : Z ⟶ Spec (.of A)) (π : Z ⟶ X₀), IsPullback π f h₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype)) → IsAffine Z → ∃ (S : Finset A) (hS : Subring.closure (S₀ : Set A) ≤ Subring.closure (S : Set A)), IsAffine (Limits.pullback h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS)))) :=
by
  intro A _ S₀ X₀ h₀ _ _ _ Z f π hpb hZ
  classical
  obtain ⟨E, ρ, hE, sE, ⟨hlim⟩, hA, hC, hQ, -, -, -, -, hsq, -, -, -⟩ :=
    wc_ap_fp_model_limit_presentation A Z f S₀ X₀ h₀ π inferInstance inferInstance
      inferInstance hpb
  haveI : ∀ {i j : (Finset A)ᵒᵖ} (g : i ⟶ j), IsAffineHom (E.map g) := hA
  haveI := hC
  haveI := hQ
  haveI : IsAffine (Limits.Cone.mk Z ρ).pt := hZ
  obtain ⟨i, hi⟩ := Scheme.exists_isAffine_of_isLimit E _ hlim
  refine ⟨S₀ ∪ i.unop, Subring.closure_mono (Finset.coe_subset.mpr Finset.subset_union_left), ?_⟩
  haveI : IsAffine (E.obj (Opposite.op i.unop)) := hi
  exact IsAffine.of_isIso (hsq i.unop).isoPullback.inv

theorem wcpa_dj_lpm_ci_level_affine : (∀ (A : Type u) [CommRing A] (S₀ : Finset A) (B C : Type u) [CommRing B] [CommRing C] [Algebra ↥(Subring.closure (S₀ : Set A)) B] [Algebra ↥(Subring.closure (S₀ : Set A)) C] [Algebra.FiniteType ↥(Subring.closure (S₀ : Set A)) C] (ψ : B →ₐ[↥(Subring.closure (S₀ : Set A))] C), Function.Surjective (Algebra.TensorProduct.map ψ (AlgHom.id ↥(Subring.closure (S₀ : Set A)) A)) → ∃ (S : Finset A) (hS : Subring.closure (S₀ : Set A) ≤ Subring.closure (S : Set A)), letI := (Subring.inclusion hS).toAlgebra; Function.Surjective (Algebra.TensorProduct.map ψ (AlgHom.id ↥(Subring.closure (S₀ : Set A)) ↥(Subring.closure (S : Set A))))) → ∀ (A : Type u) [CommRing A] (S₀ : Finset A) (X₀ Y₀ : Scheme.{u}) (h₀ : X₀ ⟶ Spec (.of ↥(Subring.closure (S₀ : Set A)))) (k₀ : Y₀ ⟶ Spec (.of ↥(Subring.closure (S₀ : Set A)))) [IsAffine X₀] [IsAffine Y₀] [LocallyOfFiniteType h₀] (p : X₀ ⟶ Y₀) (Z W : Scheme.{u}) (f : Z ⟶ Spec (.of A)) (w : W ⟶ Spec (.of A)) (πX : Z ⟶ X₀) (πY : W ⟶ Y₀) (q : Z ⟶ W), p ≫ k₀ = h₀ → IsPullback πX f h₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype)) → IsPullback πY w k₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype)) → q ≫ πY = πX ≫ p → q ≫ w = f → IsClosedImmersion q → ∃ (S : Finset A) (hS : Subring.closure (S₀ : Set A) ≤ Subring.closure (S : Set A)) (p' : Limits.pullback h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS))) ⟶ Limits.pullback k₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS)))), IsClosedImmersion p' ∧ p' ≫ Limits.pullback.snd k₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS))) = Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS))) ∧ p' ≫ Limits.pullback.fst k₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS))) = Limits.pullback.fst h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS))) ≫ p :=
by
  have L4 : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S),
      IsClosedImmersion (Spec.map (CommRingCat.ofHom f)) ↔ Function.Surjective f := by
    intro R S _ _ f
    constructor
    · intro h
      have h1 := (IsClosedImmersion.isAffine_surjective_of_isAffine
        (Spec.map (CommRingCat.ofHom f))).2
      have h2 := Scheme.ΓSpecIso_naturality (CommRingCat.ofHom f)
      intro y
      obtain ⟨x, hx⟩ := h1 ((Scheme.ΓSpecIso (.of S)).inv y)
      refine ⟨(Scheme.ΓSpecIso (.of R)).hom x, ?_⟩
      have h3 : (Scheme.ΓSpecIso (.of S)).hom ((Spec.map (CommRingCat.ofHom f)).appTop x) =
          f ((Scheme.ΓSpecIso (.of R)).hom x) := by
        have := ConcreteCategory.congr_hom h2 x
        exact this
      rw [← h3, hx]
      simp
    · intro h
      exact IsClosedImmersion.spec_of_surjective _ h
  have L1 : ∀ (R D E T : Type u) [CommRing R] [CommRing D] [CommRing E] [CommRing T] [Algebra R D] [Algebra R E] [Algebra R T] (ψ : D →ₐ[R] E) (m : Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap R E))) (Spec.map (CommRingCat.ofHom (algebraMap R T))) ⟶ Limits.pullback (Spec.map (CommRingCat.ofHom (algebraMap R D))) (Spec.map (CommRingCat.ofHom (algebraMap R T)))), m ≫ Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap R D))) (Spec.map (CommRingCat.ofHom (algebraMap R T))) = Limits.pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap R E))) (Spec.map (CommRingCat.ofHom (algebraMap R T))) ≫ Spec.map (CommRingCat.ofHom (ψ : D →+* E)) → m ≫ Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap R D))) (Spec.map (CommRingCat.ofHom (algebraMap R T))) = Limits.pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap R E))) (Spec.map (CommRingCat.ofHom (algebraMap R T))) →
      (IsClosedImmersion m ↔ IsClosedImmersion (Spec.map (CommRingCat.ofHom (Algebra.TensorProduct.map ψ (AlgHom.id R T) : TensorProduct R D T →+* TensorProduct R E T)))) := by
    intro R D E T _ _ _ _ _ _ _ ψ m h1 h2
    have e1 : (Algebra.TensorProduct.map ψ (AlgHom.id R T) : TensorProduct R D T →+* TensorProduct R E T).comp
        (Algebra.TensorProduct.includeLeftRingHom (R := R) (A := D) (B := T)) =
        (Algebra.TensorProduct.includeLeftRingHom (R := R) (A := E) (B := T)).comp (ψ : D →+* E) := by
      ext d
      simp
    have e2 : (Algebra.TensorProduct.map ψ (AlgHom.id R T) : TensorProduct R D T →+* TensorProduct R E T).comp
        ((Algebra.TensorProduct.includeRight (R := R) (A := D) (B := T)) : T →+* TensorProduct R D T) =
        ((Algebra.TensorProduct.includeRight (R := R) (A := E) (B := T)) : T →+* TensorProduct R E T) := by
      ext t
      simp
    have hm : m = (pullbackSpecIso R E T).hom ≫ Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.map ψ (AlgHom.id R T) : TensorProduct R D T →+* TensorProduct R E T)) ≫
        (pullbackSpecIso R D T).inv := by
      apply Limits.pullback.hom_ext
      · rw [h1]
        simp only [Category.assoc, pullbackSpecIso_inv_fst]
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, e1, CommRingCat.ofHom_comp, Spec.map_comp,
          ← Category.assoc, pullbackSpecIso_hom_fst]
      · rw [h2]
        simp only [Category.assoc, pullbackSpecIso_inv_snd]
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, e2, pullbackSpecIso_hom_snd]
    rw [hm]
    exact (MorphismProperty.cancel_left_of_respectsIso @IsClosedImmersion _ _).trans
      (MorphismProperty.cancel_right_of_respectsIso @IsClosedImmersion _ _)
  have L2 : ∀ (X₀ Y₀ X₁ Y₁ B T : Scheme.{u}) (h₀ : X₀ ⟶ B) (k₀ : Y₀ ⟶ B) (h₁ : X₁ ⟶ B) (k₁ : Y₁ ⟶ B) (g : T ⟶ B) (p : X₀ ⟶ Y₀) (p₁ : X₁ ⟶ Y₁) (eX : X₀ ⟶ X₁) (eY : Y₀ ⟶ Y₁), IsIso eX → IsIso eY → eX ≫ h₁ = h₀ → eY ≫ k₁ = k₀ → eX ≫ p₁ = p ≫ eY → ∀ (m : Limits.pullback h₀ g ⟶ Limits.pullback k₀ g) (m₁ : Limits.pullback h₁ g ⟶ Limits.pullback k₁ g), m ≫ Limits.pullback.fst k₀ g = Limits.pullback.fst h₀ g ≫ p → m ≫ Limits.pullback.snd k₀ g = Limits.pullback.snd h₀ g → m₁ ≫ Limits.pullback.fst k₁ g = Limits.pullback.fst h₁ g ≫ p₁ → m₁ ≫ Limits.pullback.snd k₁ g = Limits.pullback.snd h₁ g → (IsClosedImmersion m ↔ IsClosedImmersion m₁) := by
    intro X₀ Y₀ X₁ Y₁ B T h₀ k₀ h₁ k₁ g p p₁ eX eY hiX hiY hX hY hP m m₁ hmf hms hm₁f hm₁s
    have trans : ∀ (U U₁ : Scheme.{u}) (a : U ⟶ B) (a₁ : U₁ ⟶ B) (e : U ⟶ U₁), IsIso e → e ≫ a₁ = a →
        ∃ Φ : Limits.pullback a g ⟶ Limits.pullback a₁ g, IsIso Φ ∧
          Φ ≫ Limits.pullback.fst a₁ g = Limits.pullback.fst a g ≫ e ∧
          Φ ≫ Limits.pullback.snd a₁ g = Limits.pullback.snd a g := by
      intro U U₁ a a₁ e he hea
      haveI := he
      refine ⟨Limits.pullback.map a g a₁ g e (𝟙 T) (𝟙 B) (by rw [Category.comp_id, hea])
        (by rw [Category.comp_id, Category.id_comp]), inferInstance, ?_, ?_⟩
      · exact Limits.pullback.lift_fst _ _ _
      · exact (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
    obtain ⟨ΦX, hΦX, hΦXf, hΦXs⟩ := trans X₀ X₁ h₀ h₁ eX hiX hX
    obtain ⟨ΦY, hΦY, hΦYf, hΦYs⟩ := trans Y₀ Y₁ k₀ k₁ eY hiY hY
    have hc : ΦX ≫ m₁ = m ≫ ΦY := by
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc]
        rw [hm₁f, hΦYf, ← Category.assoc, hΦXf, ← Category.assoc, hmf, Category.assoc,
          Category.assoc, hP]
      · simp only [Category.assoc]
        rw [hm₁s, hΦYs, hΦXs, hms]
    have e1 := MorphismProperty.cancel_left_of_respectsIso @IsClosedImmersion ΦX m₁
    have e2 := MorphismProperty.cancel_right_of_respectsIso @IsClosedImmersion m ΦY
    rw [hc] at e1
    exact e2.symm.trans e1
  have L3 : ∀ (R : Type u) [CommRing R] (X : Scheme.{u}) [IsAffine X] (h : X ⟶ Spec (.of R)),
      X.isoSpec.hom ≫ Spec.map ((Scheme.ΓSpecIso (.of R)).inv ≫ h.appTop) = h := by
    intro R _ X _ h
    rw [Spec.map_comp, ← Category.assoc, Scheme.isoSpec_hom_naturality, Category.assoc,
      Scheme.isoSpec_Spec_hom, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id, Category.comp_id]
  have L5 : ∀ (Z W X₀ Y₀ B T : Scheme.{u}) (h₀ : X₀ ⟶ B) (k₀ : Y₀ ⟶ B) (g : T ⟶ B) (p : X₀ ⟶ Y₀) (f : Z ⟶ T) (w : W ⟶ T) (πX : Z ⟶ X₀) (πY : W ⟶ Y₀) (q : Z ⟶ W) (m : Limits.pullback h₀ g ⟶ Limits.pullback k₀ g), IsPullback πX f h₀ g → IsPullback πY w k₀ g → q ≫ πY = πX ≫ p → q ≫ w = f → m ≫ Limits.pullback.fst k₀ g = Limits.pullback.fst h₀ g ≫ p → m ≫ Limits.pullback.snd k₀ g = Limits.pullback.snd h₀ g → (IsClosedImmersion q ↔ IsClosedImmersion m) := by
    intro Z W X₀ Y₀ B T h₀ k₀ g p f w πX πY q m hX hY hq hqw hmf hms
    have hc : hX.isoPullback.hom ≫ m = q ≫ hY.isoPullback.hom := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hmf, ← Category.assoc, IsPullback.isoPullback_hom_fst, Category.assoc,
          IsPullback.isoPullback_hom_fst, hq]
      · rw [Category.assoc, hms, IsPullback.isoPullback_hom_snd, Category.assoc,
          IsPullback.isoPullback_hom_snd, hqw]
    have e1 := MorphismProperty.cancel_left_of_respectsIso @IsClosedImmersion hX.isoPullback.hom m
    have e2 := MorphismProperty.cancel_right_of_respectsIso @IsClosedImmersion q hY.isoPullback.hom
    rw [hc] at e1
    exact e2.symm.trans e1
  have L6 : ∀ (R : Type u) [CommRing R] (X : Scheme.{u}) [IsAffine X] (h : X ⟶ Spec (.of R)),
      LocallyOfFiniteType h → ((Scheme.ΓSpecIso (.of R)).inv ≫ h.appTop).hom.FiniteType := by
    intro R _ X _ h hl
    have h1 : h.appTop.hom.FiniteType :=
      (HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFiniteType)).mp hl
    have h2 : (Scheme.ΓSpecIso (.of R)).inv.hom.FiniteType :=
      RingHom.FiniteType.of_surjective _ (fun x => ⟨(Scheme.ΓSpecIso (.of R)).hom x, by simp⟩)
    rw [CommRingCat.hom_comp]
    exact h1.comp h2
  intro HS8 A _ S₀ X₀ Y₀ h₀ k₀ _ _ _ p Z W f w πX πY q hpk hX hY hq hqw hci
  letI iE : Algebra ↥(Subring.closure (S₀ : Set A)) ↑(X₀.presheaf.obj (Opposite.op ⊤)) :=
    ((Scheme.ΓSpecIso (.of ↥(Subring.closure (S₀ : Set A)))).inv ≫ h₀.appTop).hom.toAlgebra
  letI iD : Algebra ↥(Subring.closure (S₀ : Set A)) ↑(Y₀.presheaf.obj (Opposite.op ⊤)) :=
    ((Scheme.ΓSpecIso (.of ↥(Subring.closure (S₀ : Set A)))).inv ≫ k₀.appTop).hom.toAlgebra
  haveI hft : Algebra.FiniteType ↥(Subring.closure (S₀ : Set A)) ↑(X₀.presheaf.obj (Opposite.op ⊤)) :=
    L6 _ X₀ h₀ inferInstance
  have hcomp : ((Scheme.ΓSpecIso (.of ↥(Subring.closure (S₀ : Set A)))).inv ≫ k₀.appTop) ≫ p.appTop =
      (Scheme.ΓSpecIso (.of ↥(Subring.closure (S₀ : Set A)))).inv ≫ h₀.appTop := by
    rw [Category.assoc, ← Scheme.Hom.comp_appTop, hpk]
  let ψA : ↑(Y₀.presheaf.obj (Opposite.op ⊤)) →ₐ[↥(Subring.closure (S₀ : Set A))]
      ↑(X₀.presheaf.obj (Opposite.op ⊤)) :=
    { p.appTop.hom with commutes' := fun b => ConcreteCategory.congr_hom hcomp b }
  have eqX : X₀.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥(Subring.closure (S₀ : Set A))
      ↑(X₀.presheaf.obj (Opposite.op ⊤)))) = h₀ := L3 _ X₀ h₀
  have eqY : Y₀.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥(Subring.closure (S₀ : Set A))
      ↑(Y₀.presheaf.obj (Opposite.op ⊤)))) = k₀ := L3 _ Y₀ k₀
  have eqP : X₀.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom (ψA : ↑(Y₀.presheaf.obj (Opposite.op ⊤)) →+*
      ↑(X₀.presheaf.obj (Opposite.op ⊤)))) = p ≫ Y₀.isoSpec.hom := Scheme.isoSpec_hom_naturality p
  have hw₁ : Spec.map (CommRingCat.ofHom (ψA : ↑(Y₀.presheaf.obj (Opposite.op ⊤)) →+*
      ↑(X₀.presheaf.obj (Opposite.op ⊤)))) ≫ Spec.map (CommRingCat.ofHom
      (algebraMap ↥(Subring.closure (S₀ : Set A)) ↑(Y₀.presheaf.obj (Opposite.op ⊤)))) =
      Spec.map (CommRingCat.ofHom (algebraMap ↥(Subring.closure (S₀ : Set A))
      ↑(X₀.presheaf.obj (Opposite.op ⊤)))) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, AlgHom.comp_algebraMap]
  have key : ∀ (T : Type u) [CommRing T] [Algebra ↥(Subring.closure (S₀ : Set A)) T]
      (m : Limits.pullback h₀ (Spec.map (CommRingCat.ofHom (algebraMap ↥(Subring.closure (S₀ : Set A)) T))) ⟶
        Limits.pullback k₀ (Spec.map (CommRingCat.ofHom (algebraMap ↥(Subring.closure (S₀ : Set A)) T)))),
      m ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ≫ p →
      m ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ →
      (IsClosedImmersion m ↔ Function.Surjective (Algebra.TensorProduct.map ψA
        (AlgHom.id ↥(Subring.closure (S₀ : Set A)) T))) := by
    intro T _ _ m hmf hms
    let m₁ := Limits.pullback.map
      (Spec.map (CommRingCat.ofHom (algebraMap ↥(Subring.closure (S₀ : Set A))
        ↑(X₀.presheaf.obj (Opposite.op ⊤)))))
      (Spec.map (CommRingCat.ofHom (algebraMap ↥(Subring.closure (S₀ : Set A)) T)))
      (Spec.map (CommRingCat.ofHom (algebraMap ↥(Subring.closure (S₀ : Set A))
        ↑(Y₀.presheaf.obj (Opposite.op ⊤)))))
      (Spec.map (CommRingCat.ofHom (algebraMap ↥(Subring.closure (S₀ : Set A)) T)))
      (Spec.map (CommRingCat.ofHom (ψA : ↑(Y₀.presheaf.obj (Opposite.op ⊤)) →+*
        ↑(X₀.presheaf.obj (Opposite.op ⊤))))) (𝟙 _) (𝟙 _)
      (by rw [Category.comp_id, hw₁]) (by rw [Category.comp_id, Category.id_comp])
    have hm₁f : m₁ ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ≫
        Spec.map (CommRingCat.ofHom (ψA : ↑(Y₀.presheaf.obj (Opposite.op ⊤)) →+*
        ↑(X₀.presheaf.obj (Opposite.op ⊤)))) := Limits.pullback.lift_fst _ _ _
    have hm₁s : m₁ ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ :=
      (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
    exact (L2 X₀ Y₀ _ _ _ _ h₀ k₀ _ _ _ p _ X₀.isoSpec.hom Y₀.isoSpec.hom inferInstance inferInstance
      eqX eqY eqP m m₁ hmf hms hm₁f hm₁s).trans
      ((L1 _ _ _ T ψA m₁ hm₁f hm₁s).trans (L4 _ _ _))

  let mA := Limits.pullback.map h₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype))
    k₀ (Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype)) p (𝟙 _) (𝟙 _)
    (by rw [Category.comp_id, hpk]) (by rw [Category.comp_id, Category.id_comp])
  have hmAf : mA ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ≫ p :=
    Limits.pullback.lift_fst _ _ _
  have hmAs : mA ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ :=
    (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
  have hciA : IsClosedImmersion mA :=
    (L5 Z W X₀ Y₀ _ _ h₀ k₀ _ p f w πX πY q mA hX hY hq hqw hmAf hmAs).mp hci
  have hsurjA := (key A mA hmAf hmAs).mp hciA
  obtain ⟨S, hS, hsurjS⟩ := HS8 A S₀ _ _ ψA hsurjA
  letI := (Subring.inclusion hS).toAlgebra
  let p' := Limits.pullback.map h₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS)))
    k₀ (Spec.map (CommRingCat.ofHom (Subring.inclusion hS))) p (𝟙 _) (𝟙 _)
    (by rw [Category.comp_id, hpk]) (by rw [Category.comp_id, Category.id_comp])
  have hp'f : p' ≫ Limits.pullback.fst _ _ = Limits.pullback.fst _ _ ≫ p :=
    Limits.pullback.lift_fst _ _ _
  have hp's : p' ≫ Limits.pullback.snd _ _ = Limits.pullback.snd _ _ :=
    (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
  exact ⟨S, hS, p', (key _ p' hp'f hp's).mpr hsurjS, hp's, hp'f⟩

theorem wcpa_dj_lus_descend_proj_model : ∀ (L : Type u) [Field L] (V : ValuationSubring L) (Zv : Scheme.{u}) (uv : Zv ⟶ Spec (.of V)) (n : ℕ) (τv : Fin n → (Spec (.of V) ⟶ Zv)), Flat uv → (∃ (N : ℕ) (j : Zv ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥V) MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥V) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥V ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥V 0))) = uv) → (∀ i, τv i ≫ uv = 𝟙 _) → ∃ (F : Finset V) (Z₀ : Scheme.{u}) (u₀ : Z₀ ⟶ Spec (.of ↥(Subring.closure (F : Set V)))) (τ₀ : Fin n → (Spec (.of ↥(Subring.closure (F : Set V))) ⟶ Z₀)) (φ : Zv ⟶ Z₀), Flat u₀ ∧ IsProper u₀ ∧ LocallyOfFinitePresentation u₀ ∧ (∀ i, τ₀ i ≫ u₀ = 𝟙 _) ∧ IsPullback φ uv u₀ (Spec.map (CommRingCat.ofHom (Subring.closure (F : Set V)).subtype)) ∧ (∀ i, τv i ≫ φ = Spec.map (CommRingCat.ofHom (Subring.closure (F : Set V)).subtype) ≫ τ₀ i) ∧ (∃ (N : ℕ) (j₀ : Z₀ ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥(Subring.closure (F : Set V))) MvPolynomial.gradedAlgebra), IsClosedImmersion j₀ ∧ j₀ ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥(Subring.closure (F : Set V))) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥(Subring.closure (F : Set V)) ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥(Subring.closure (F : Set V)) 0))) = u₀) :=
by
  intro L _ V Zv uv n τv hflat hproj hτ
  classical

  obtain ⟨F₁, Z₁, u₁, τ₁, φ₁, hfl₁, hpr₁, hfp₁, hτ₁, hφ₁, hτφ₁⟩ :=
    wcpa_dj_lsl_descend_flat_model L V Zv uv n τv hflat hproj hτ
  obtain ⟨N, j, hj, hjeq⟩ := hproj

  have R1 : ∀ (S T : Subring V) (h : S ≤ T),
      Spec.map (CommRingCat.ofHom T.subtype) ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion h)) =
        Spec.map (CommRingCat.ofHom S.subtype) := by
    intro S T h
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    rfl

  have hpp : ∀ (R : Type u) [CommRing R] (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of R)),
      (∃ (N : ℕ) (j : Z ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
        MvPolynomial.gradedAlgebra), IsClosedImmersion j ∧ j ≫ @Proj.toSpecZero _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) MvPolynomial.gradedAlgebra ≫
        Spec.map (CommRingCat.ofHom (algebraMap R
          ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0))) = uu) → IsProper uu := by
    intro R _ Z uu hproj
    obtain ⟨N, j, hj, rfl⟩ := hproj
    haveI := hj
    haveI hst : IsScalarTower R (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0))
        (MvPolynomial (Fin (N + 1)) R) :=
      IsScalarTower.of_algebraMap_eq
        (S := ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0)) (fun c => by
          rw [SetLike.GradeZero.algebraMap_apply]
          exact (SetLike.GradeZero.coe_algebraMap
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R) c).symm)
    haveI : Algebra.FiniteType (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0))
        (MvPolynomial (Fin (N + 1)) R) :=
      Algebra.FiniteType.of_restrictScalars_finiteType R _ _
    haveI : IsProper (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
        MvPolynomial.gradedAlgebra) := inferInstance
    have hkey : ∀ c : R, ((algebraMap R (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0)) c :
        ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0)) : MvPolynomial (Fin (N + 1)) R) =
        MvPolynomial.C c := by
      intro c
      rw [SetLike.GradeZero.coe_algebraMap, MvPolynomial.algebraMap_eq]
    have hbij : Function.Bijective
        (algebraMap R (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0))) := by
      constructor
      · intro a b hab
        have h1 := congrArg (fun x : ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0) =>
          (x : MvPolynomial (Fin (N + 1)) R)) hab
        simp only [hkey] at h1
        exact MvPolynomial.C_injective _ _ h1
      · intro p
        have hp : (p : MvPolynomial (Fin (N + 1)) R).IsHomogeneous 0 :=
          (MvPolynomial.mem_homogeneousSubmodule _ _).mp p.2
        have htd : (p : MvPolynomial (Fin (N + 1)) R).totalDegree = 0 :=
          Nat.le_zero.mp hp.totalDegree_le
        refine ⟨(p : MvPolynomial (Fin (N + 1)) R).coeff 0, Subtype.ext ?_⟩
        rw [hkey]
        exact ((MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp htd).symm
    haveI : IsIso (CommRingCat.ofHom
        (algebraMap R (↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0)))) :=
      (ConcreteCategory.isIso_iff_bijective _).mpr hbij
    infer_instance

  have hnoeth : ∀ T : Finset V, IsNoetherianRing (Subring.closure (T : Set V)) := by
    intro T
    have h1 : (Algebra.adjoin ℤ (T : Set V)).FG := Subalgebra.fg_adjoin_finset _
    haveI : Algebra.FiniteType ℤ (Algebra.adjoin ℤ (T : Set V)) :=
      (Subalgebra.fg_iff_finiteType _).mp h1
    have h2 := Algebra.FiniteType.isNoetherianRing ℤ (Algebra.adjoin ℤ (T : Set V))
    rw [Algebra.adjoin_int] at h2
    exact h2

  have raise : ∀ (T U : Finset V) (hTU : Subring.closure (T : Set V) ≤ Subring.closure (U : Set V))
      (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥(Subring.closure (T : Set V))))
      (τ₁ : Fin n → (Spec (.of ↥(Subring.closure (T : Set V))) ⟶ Z₁)) (φ₁ : Zv ⟶ Z₁),
      Flat u₁ → IsProper u₁ → LocallyOfFinitePresentation u₁ → (∀ i, τ₁ i ≫ u₁ = 𝟙 _) →
      IsPullback φ₁ uv u₁ (Spec.map (CommRingCat.ofHom (Subring.closure (T : Set V)).subtype)) →
      (∀ i, τv i ≫ φ₁ = Spec.map (CommRingCat.ofHom (Subring.closure (T : Set V)).subtype) ≫ τ₁ i) →
      ∃ (τ₀ : Fin n → (Spec (.of ↥(Subring.closure (U : Set V))) ⟶
          Limits.pullback u₁ (Spec.map (CommRingCat.ofHom (Subring.inclusion hTU)))))
        (φ : Zv ⟶ Limits.pullback u₁ (Spec.map (CommRingCat.ofHom (Subring.inclusion hTU)))),
        Flat (Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom (Subring.inclusion hTU)))) ∧
        IsProper (Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom (Subring.inclusion hTU)))) ∧
        LocallyOfFinitePresentation
          (Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom (Subring.inclusion hTU)))) ∧
        (∀ i, τ₀ i ≫ Limits.pullback.snd u₁
          (Spec.map (CommRingCat.ofHom (Subring.inclusion hTU))) = 𝟙 _) ∧
        IsPullback φ uv
          (Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom (Subring.inclusion hTU))))
          (Spec.map (CommRingCat.ofHom (Subring.closure (U : Set V)).subtype)) ∧
        (∀ i, τv i ≫ φ = Spec.map (CommRingCat.ofHom (Subring.closure (U : Set V)).subtype) ≫
          τ₀ i) := by
    intro T U hTU Z₁ u₁ τ₁ φ₁ hfl hpr hfp hτ₁ hφ₁ hτφ₁
    have hw : ∀ i, (Spec.map (CommRingCat.ofHom (Subring.inclusion hTU)) ≫ τ₁ i) ≫ u₁ =
        𝟙 _ ≫ Spec.map (CommRingCat.ofHom (Subring.inclusion hTU)) := by
      intro i
      rw [Category.assoc, hτ₁ i, Category.comp_id, Category.id_comp]
    have hwφ : φ₁ ≫ u₁ = (uv ≫ Spec.map (CommRingCat.ofHom
        (Subring.closure (U : Set V)).subtype)) ≫
        Spec.map (CommRingCat.ofHom (Subring.inclusion hTU)) := by
      rw [hφ₁.w, Category.assoc, R1]
    have houter : IsPullback (Limits.pullback.lift _ _ hwφ ≫ Limits.pullback.fst u₁
        (Spec.map (CommRingCat.ofHom (Subring.inclusion hTU)))) uv u₁
        (Spec.map (CommRingCat.ofHom (Subring.closure (U : Set V)).subtype) ≫
          Spec.map (CommRingCat.ofHom (Subring.inclusion hTU))) := by
      rw [Limits.pullback.lift_fst, R1]
      exact hφ₁
    refine ⟨fun i => Limits.pullback.lift _ _ (hw i), Limits.pullback.lift _ _ hwφ,
      ?_, ?_, ?_, ?_, ?_, ?_⟩
    · exact MorphismProperty.of_isPullback (P := @Flat) (IsPullback.of_hasPullback _ _) hfl
    · exact MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback _ _) hpr
    · exact MorphismProperty.of_isPullback (P := @LocallyOfFinitePresentation)
        (IsPullback.of_hasPullback _ _) hfp
    · intro i
      exact Limits.pullback.lift_snd _ _ _
    · exact IsPullback.of_right houter (Limits.pullback.lift_snd _ _ _)
        (IsPullback.of_hasPullback _ _)
    · intro i
      apply Limits.pullback.hom_ext
      · simp only [Category.assoc, Limits.pullback.lift_fst]
        rw [hτφ₁ i, ← Category.assoc, R1]
      · simp only [Category.assoc, Limits.pullback.lift_snd]
        rw [← Category.assoc, hτ i, Category.id_comp, Category.comp_id]

  have hPrb : ∀ (R R' : Type u) [CommRing R] [CommRing R']
      (ρ : R →+* R') (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of R)),
      (∃ (N : ℕ) (j : Z ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion j ∧
        j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0))) = uu) →
      ∃ (N : ℕ) (j : Limits.pullback uu (Spec.map (CommRingCat.ofHom ρ)) ⟶
          @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R')
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion j ∧
        j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R')
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap R' ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R' 0))) =
          Limits.pullback.snd uu (Spec.map (CommRingCat.ofHom ρ)) := by
    have hAbs : ∀ {Z PR PR' S S' : Scheme.{u}} (uu : Z ⟶ S) (p : PR ⟶ S) (g : S' ⟶ S)
        (p' : PR' ⟶ S') (e : Limits.pullback p g ⟶ PR') (j : Z ⟶ PR),
        IsIso e → e ≫ p' = Limits.pullback.snd p g → IsClosedImmersion j → j ≫ p = uu →
        ∃ j' : Limits.pullback uu g ⟶ PR', IsClosedImmersion j' ∧
          j' ≫ p' = Limits.pullback.snd uu g := by
      intro Z PR PR' S S' uu p g p' e j he_iso he hj hjeq
      have w : (Limits.pullback.fst uu g ≫ j) ≫ p = Limits.pullback.snd uu g ≫ g := by
        rw [Category.assoc, hjeq, Limits.pullback.condition]
      obtain ⟨jb, hjb1, hjb2⟩ : ∃ jb : Limits.pullback uu g ⟶ Limits.pullback p g,
          jb ≫ Limits.pullback.fst p g = Limits.pullback.fst uu g ≫ j ∧
          jb ≫ Limits.pullback.snd p g = Limits.pullback.snd uu g :=
        ⟨Limits.pullback.lift _ _ w, Limits.pullback.lift_fst _ _ _,
          Limits.pullback.lift_snd _ _ _⟩
      have hsq : IsPullback jb (Limits.pullback.fst uu g) (Limits.pullback.fst p g) j := by
        have hout : IsPullback (jb ≫ Limits.pullback.snd p g) (Limits.pullback.fst uu g) g
            (j ≫ p) := by
          rw [hjb2, hjeq]
          exact (IsPullback.of_hasPullback uu g).flip
        exact IsPullback.of_right hout hjb1 (IsPullback.of_hasPullback p g).flip
      haveI hjb : IsClosedImmersion jb :=
        MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq.flip hj
      haveI := he_iso
      refine ⟨jb ≫ e, inferInstance, ?_⟩
      rw [Category.assoc, he, hjb2]
    rintro R R' _ _ ρ Z uu ⟨N, j, hj, hjeq⟩
    letI iρ : Algebra R R' := ρ.toAlgebra
    obtain ⟨e, he_iso, he⟩ := @wcpa_dj_lpm_proj_space_bc_iso R R' _ _ iρ N
    obtain ⟨j', hj', hj'eq⟩ :=
      hAbs uu _ (Spec.map (CommRingCat.ofHom ρ)) _ e j he_iso he hj hjeq
    exact ⟨N, j', hj', hj'eq⟩

  haveI hA₁ : IsNoetherianRing (Subring.closure (F₁ : Set V)) := hnoeth F₁
  haveI hp₁p : IsProper (@Proj.toSpecZero _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥(Subring.closure (F₁ : Set V)))
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap ↥(Subring.closure (F₁ : Set V))
          ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥(Subring.closure (F₁ : Set V)) 0)))) :=
    hpp _ _ _ ⟨N, 𝟙 _, inferInstance, Category.id_comp _⟩
  haveI hp₁f : LocallyOfFinitePresentation (@Proj.toSpecZero _ _ _ _ _
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥(Subring.closure (F₁ : Set V)))
      MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
        (algebraMap ↥(Subring.closure (F₁ : Set V))
          ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥(Subring.closure (F₁ : Set V)) 0)))) :=
    LocallyOfFinitePresentation.iff_locallyOfFiniteType.mpr inferInstance

  obtain ⟨e, he_iso, he⟩ :=
    wcpa_dj_lpm_proj_space_bc_iso (↥(Subring.closure (F₁ : Set V))) (↥V) N
  haveI := he_iso
  have hπY : IsPullback (inv e ≫ Limits.pullback.fst _ _)
      (@Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥V)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap ↥V ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥V 0))))
      (@Proj.toSpecZero _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥(Subring.closure (F₁ : Set V)))
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap ↥(Subring.closure (F₁ : Set V))
            ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥(Subring.closure (F₁ : Set V)) 0))))
      (Spec.map (CommRingCat.ofHom (Subring.closure (F₁ : Set V)).subtype)) :=
    IsPullback.of_iso (IsPullback.of_hasPullback _ _) (asIso e) (Iso.refl _) (Iso.refl _)
      (Iso.refl _) (by simp) (by rw [Iso.refl_hom, Category.comp_id, asIso_hom, he])
      (by simp) (by simp; rfl)

  obtain ⟨S, hS, p, ψX, ψY, hψX, hψY, _, _, hpsnd, hcomm⟩ :=
    wcpa_dj_lpm_hom_descend (↥V) F₁ Z₁ _ u₁ _ Zv _ uv _ φ₁ _ j hφ₁ hπY hjeq

  haveI : QuasiCompact (Limits.pullback.snd u₁
      (Spec.map (CommRingCat.ofHom (Subring.inclusion hS)))) :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) (IsPullback.of_hasPullback _ _)
      (inferInstance : QuasiCompact u₁)
  haveI : QuasiSeparated (Limits.pullback.snd u₁
      (Spec.map (CommRingCat.ofHom (Subring.inclusion hS)))) :=
    MorphismProperty.of_isPullback (P := @QuasiSeparated) (IsPullback.of_hasPullback _ _)
      (inferInstance : QuasiSeparated u₁)
  haveI : LocallyOfFinitePresentation (Limits.pullback.snd u₁
      (Spec.map (CommRingCat.ofHom (Subring.inclusion hS)))) :=
    MorphismProperty.of_isPullback (P := @LocallyOfFinitePresentation)
      (IsPullback.of_hasPullback _ _) hfp₁
  haveI : QuasiCompact (Limits.pullback.snd (@Proj.toSpecZero _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥(Subring.closure (F₁ : Set V)))
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap ↥(Subring.closure (F₁ : Set V))
            ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥(Subring.closure (F₁ : Set V)) 0))))
      (Spec.map (CommRingCat.ofHom (Subring.inclusion hS)))) :=
    MorphismProperty.of_isPullback (P := @QuasiCompact) (IsPullback.of_hasPullback _ _)
      inferInstance
  haveI : QuasiSeparated (Limits.pullback.snd (@Proj.toSpecZero _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥(Subring.closure (F₁ : Set V)))
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap ↥(Subring.closure (F₁ : Set V))
            ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥(Subring.closure (F₁ : Set V)) 0))))
      (Spec.map (CommRingCat.ofHom (Subring.inclusion hS)))) :=
    MorphismProperty.of_isPullback (P := @QuasiSeparated) (IsPullback.of_hasPullback _ _)
      inferInstance
  obtain ⟨S', hS', p', hp'ci, hp'snd, _⟩ :=
    wcpa_dj_lpm_ci_level wcpa_dj_lpm_affine_level
      (wcpa_dj_lpm_ci_level_affine wcpa_dj_lpm_tensor_surj_level)
      (↥V) S _ _ _ _ p Zv _ uv _ ψX ψY j hpsnd hψX hψY hcomm.symm hjeq hj

  obtain ⟨τS, φS, hflS, hprS, hfpS, hτS, hφS, hτφS⟩ :=
    raise F₁ S hS Z₁ u₁ τ₁ φ₁ hfl₁ hpr₁ hfp₁ hτ₁ hφ₁ hτφ₁
  obtain ⟨τ₀, φ, hfl, hpr, hfp, hτ₀, hφ, hτφ⟩ :=
    raise S S' hS' _ _ τS φS hflS hprS hfpS hτS hφS hτφS

  obtain ⟨N₁, jS, hjS, hjSeq⟩ := hPrb _ _ (Subring.inclusion hS) _ _
    ⟨N, 𝟙 _, inferInstance, Category.id_comp _⟩
  obtain ⟨N₂, j', hj', hj'eq⟩ := hPrb _ _ (Subring.inclusion hS') _ _ ⟨N₁, jS, hjS, hjSeq⟩
  haveI := hp'ci
  haveI := hj'
  refine ⟨S', _, _, τ₀, φ, hfl, hpr, hfp, hτ₀, hφ, hτφ, N₂, p' ≫ j', inferInstance, ?_⟩
  rw [Category.assoc, hj'eq, hp'snd]

theorem wcpa_dj_gcb_semistable_reduced_fibres : ∀ {C P : Scheme.{u}} (g : C ⟶ P), wcpaDjSemistable g → wcpaDjGeomReducedFibres g :=
by

  have hnode : ∀ (K : Type u) [Field K], _root_.IsReduced (MvPowerSeries (Fin 2) K ⧸
      Ideal.span {(MvPowerSeries.X 0 * MvPowerSeries.X 1 : MvPowerSeries (Fin 2) K)}) := by
    intro K _
    classical
    let E : Fin 2 → MvPowerSeries (Fin 2) K → MvPowerSeries (Fin 2) K := fun i f =>
      (show MvPowerSeries (Fin 2) K from fun m => if m i = 0 then MvPowerSeries.coeff m f else 0)
    have hE : ∀ i f m, MvPowerSeries.coeff m (E i f) =
        if m i = 0 then MvPowerSeries.coeff m f else 0 := fun i f m => rfl
    have hEmul : ∀ i f g, E i (f * g) = E i f * E i g := by
      intro i f g
      ext m
      rw [hE, MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul]
      split_ifs with hm
      · apply Finset.sum_congr rfl
        intro p hp
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        have hpi := DFunLike.congr_fun hp i
        rw [Finsupp.add_apply] at hpi
        rw [hE, hE, if_pos (by omega), if_pos (by omega)]
      · symm
        apply Finset.sum_eq_zero
        intro p hp
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        have hpi := DFunLike.congr_fun hp i
        rw [Finsupp.add_apply] at hpi
        rw [hE, hE]
        by_cases h1 : p.1 i = 0
        · rw [if_neg (show ¬ p.2 i = 0 by omega), mul_zero]
        · rw [if_neg h1, zero_mul]
    have hdvd : ∀ i f, MvPowerSeries.X i ∣ f ↔ E i f = 0 := by
      intro i f
      rw [MvPowerSeries.X_dvd_iff]
      constructor
      · intro h
        ext m
        rw [hE, map_zero]
        split_ifs with hm
        · exact h m hm
        · rfl
      · intro h m hm
        have := congrArg (MvPowerSeries.coeff m) h
        rw [hE, if_pos hm, map_zero] at this
        exact this
    have hEX : E 1 (MvPowerSeries.X 0) = MvPowerSeries.X 0 := by
      ext m
      rw [hE, MvPowerSeries.coeff_X]
      split_ifs with h1 h2 h2 <;> simp_all
    have hX0 : (MvPowerSeries.X 0 : MvPowerSeries (Fin 2) K) ≠ 0 := by
      intro h
      have := MvPowerSeries.coeff_index_single_self_X (R := K) (0 : Fin 2)
      rw [h, map_zero] at this
      exact zero_ne_one this
    rw [← Ideal.isRadical_iff_quotient_reduced, Ideal.isRadical_iff_pow_one_lt 2 (by norm_num)]
    intro r hr
    rw [Ideal.mem_span_singleton] at hr ⊢
    have hsq : ∀ i, MvPowerSeries.X i ∣ r ^ 2 → MvPowerSeries.X i ∣ r := by
      intro i h1
      rw [hdvd] at h1 ⊢
      rw [pow_two, hEmul, ← pow_two] at h1
      exact (pow_eq_zero_iff two_ne_zero).mp h1
    have h0 : MvPowerSeries.X 0 ∣ r := hsq 0 (dvd_trans (dvd_mul_right _ _) hr)
    have h1 : MvPowerSeries.X 1 ∣ r := hsq 1 (dvd_trans (dvd_mul_left _ _) hr)
    obtain ⟨a, ha⟩ := h0
    have h1' := (hdvd 1 r).mp h1
    rw [ha, hEmul, hEX] at h1'
    have ha1 := (mul_eq_zero.mp h1').resolve_left hX0
    obtain ⟨b, hb⟩ := (hdvd 1 a).mpr ha1
    exact ⟨b, by rw [ha, hb, mul_assoc]⟩

  have hcompl : ∀ (R : Type u) [CommRing R] [IsLocalRing R] [IsNoetherianRing R] (Q : Type u)
      [CommRing Q] [_root_.IsReduced Q],
      (AdicCompletion (IsLocalRing.maximalIdeal R) R ≃+* Q) → _root_.IsReduced R := by
    intro R _ _ _ Q _ _ e
    have hinj : Function.Injective
        (e.toRingHom.comp (algebraMap R (AdicCompletion (IsLocalRing.maximalIdeal R) R))) := by
      intro x y hxy
      simp only [RingHom.coe_comp, Function.comp_apply, RingEquiv.coe_toRingHom] at hxy
      have h := e.injective hxy
      rw [AdicCompletion.algebraMap_apply, AdicCompletion.algebraMap_apply] at h
      exact AdicCompletion.of_injective _ _ h
    exact isReduced_of_injective _ hinj

  intro C P g hss K _ _ s
  haveI : IsProper g := hss.2.1
  haveI hst : ∀ w : (Limits.pullback g s : Scheme.{u}),
      _root_.IsReduced ((Limits.pullback g s).presheaf.stalk w) := by
    intro w
    rcases hss.2.2 K s w with ⟨W', hw, hsm⟩ | ⟨e, -⟩
    · haveI := hsm
      haveI := wcpa_smooth_stalk_isDomain K W'.toScheme (W'.ι ≫ Limits.pullback.snd g s) 1 ⟨w, hw⟩
      have hinj : Function.Injective (W'.stalkIso ⟨w, hw⟩).inv.hom := by
        intro x y hxy
        have := congrArg (W'.stalkIso ⟨w, hw⟩).hom.hom hxy
        simpa using this
      exact isReduced_of_injective (W'.stalkIso ⟨w, hw⟩).inv.hom hinj
    · haveI : IsLocallyNoetherian (Limits.pullback g s) :=
        LocallyOfFiniteType.isLocallyNoetherian (Limits.pullback.snd g s)
      haveI := hnode K
      exact hcompl _ _ e
  exact isReduced_of_isReduced_stalk _

theorem wcpa_dj_gcb_geom_fibre_conn_transfer : ∀ (Z T : Scheme.{u}) (u : Z ⟶ T) (t : T) (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T), s (IsLocalRing.closedPoint K) = t → ConnectedSpace ↥(Limits.pullback u (Spec.map (CommRingCat.ofHom (algebraMap (T.residueField t) (AlgebraicClosure (T.residueField t)))) ≫ T.fromSpecResidueField t)) → ConnectedSpace ↥(Limits.pullback u s) :=
by

  have hdomain : ∀ (Ω L K : Type u) [Field Ω] [IsAlgClosed Ω] [Field L] [Field K] [Algebra Ω L]
      [Algebra Ω K], IsDomain (TensorProduct Ω L K) := by
    intro Ω L K _ _ _ _ _ _
    classical
    let j : ∀ A : Subalgebra Ω L, TensorProduct Ω A K →ₐ[Ω] TensorProduct Ω L K :=
      fun A => Algebra.TensorProduct.map A.val (AlgHom.id Ω K)
    have hjinj : ∀ A : Subalgebra Ω L, Function.Injective (j A) := by
      intro A
      have e : ((j A).toLinearMap : TensorProduct Ω A K →ₗ[Ω] TensorProduct Ω L K) =
          LinearMap.rTensor K A.val.toLinearMap := by
        apply TensorProduct.ext'
        intro a k
        simp [j]
      have h := Module.Flat.rTensor_preserves_injective_linearMap (M := K) A.val.toLinearMap
        Subtype.val_injective
      rw [← e] at h
      exact h
    have hmono : ∀ (A B : Subalgebra Ω L) (h : A ≤ B) (x : TensorProduct Ω A K),
        j B (Algebra.TensorProduct.map (Subalgebra.inclusion h) (AlgHom.id Ω K) x) = j A x := by
      intro A B h x
      induction x using TensorProduct.induction_on with
      | zero => simp
      | tmul a k => simp [j]
      | add x y hx hy => simp only [map_add, hx, hy]
    have hrange : ∀ z : TensorProduct Ω L K, ∃ A : Subalgebra Ω L, A.FG ∧ ∃ z', j A z' = z := by
      intro z
      induction z using TensorProduct.induction_on with
      | zero => exact ⟨⊥, Subalgebra.fg_bot, 0, map_zero _⟩
      | tmul l k =>
        refine ⟨Algebra.adjoin Ω {l}, by simpa using Subalgebra.fg_adjoin_finset ({l} : Finset L),
          ⟨l, Algebra.subset_adjoin rfl⟩ ⊗ₜ k, ?_⟩
        simp [j]
      | add x y hx hy =>
        obtain ⟨A, hA, x', rfl⟩ := hx
        obtain ⟨B, hB, y', rfl⟩ := hy
        refine ⟨A ⊔ B, hA.sup hB,
          Algebra.TensorProduct.map (Subalgebra.inclusion (le_sup_left : A ≤ A ⊔ B))
            (AlgHom.id Ω K) x' +
          Algebra.TensorProduct.map (Subalgebra.inclusion (le_sup_right : B ≤ A ⊔ B))
            (AlgHom.id Ω K) y', ?_⟩
        rw [map_add, hmono, hmono]

    have hchar : ∀ (A : Subalgebra Ω L) [Algebra.FiniteType Ω A] (m : Ideal A) [m.IsMaximal],
        ∃ χ : A →ₐ[Ω] Ω, ∀ a, χ a = 0 → a ∈ m := by
      intro A _ m _
      letI : Field (A ⧸ m) := Ideal.Quotient.field m
      haveI : Algebra.FiniteType Ω (A ⧸ m) :=
        Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ Ω m)
          (Ideal.Quotient.mkₐ_surjective Ω m)
      haveI : Module.Finite Ω (A ⧸ m) := finite_of_finite_type_of_isJacobsonRing Ω (A ⧸ m)
      haveI : Algebra.IsIntegral Ω (A ⧸ m) := Algebra.IsIntegral.of_finite Ω _
      have hb := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := Ω) (K := A ⧸ m)
      let e := AlgEquiv.ofBijective (Algebra.ofId Ω (A ⧸ m)) hb
      refine ⟨e.symm.toAlgHom.comp (Ideal.Quotient.mkₐ Ω m), fun a ha => ?_⟩
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      have h1 : e.symm (Ideal.Quotient.mkₐ Ω m a) = 0 := ha
      have h2 := congrArg e h1
      rw [AlgEquiv.apply_symm_apply, map_zero] at h2
      exact h2
    let b := Module.Basis.ofVectorSpace Ω K
    have key : ∀ (A : Subalgebra Ω L), A.FG → ∀ x' y' : TensorProduct Ω A K, x' * y' = 0 →
        x' = 0 ∨ y' = 0 := by
      intro A hA x' y' hxy
      haveI : Algebra.FiniteType Ω A := (Subalgebra.fg_iff_finiteType A).mp hA
      haveI : IsJacobsonRing A := isJacobsonRing_of_finiteType (A := Ω)
      let cA := TensorProduct.equivFinsuppOfBasisRight (M := A) b
      let cΩ := TensorProduct.equivFinsuppOfBasisRight (M := Ω) b
      have hnat : ∀ (χ : A →ₐ[Ω] Ω) (w : TensorProduct Ω A K) (i),
          cΩ (Algebra.TensorProduct.map χ (AlgHom.id Ω K) w) i = χ (cA w i) := by
        intro χ w i
        induction w using TensorProduct.induction_on with
        | zero => simp
        | tmul a k =>
          simp [cA, cΩ, TensorProduct.equivFinsuppOfBasisRight_apply_tmul]
        | add x y hx hy => simp only [map_add, Finsupp.add_apply, hx, hy]
      have hzero : ∀ (m : Ideal A) [m.IsMaximal] (χ : A →ₐ[Ω] Ω), (∀ a, χ a = 0 → a ∈ m) →
          ∀ w : TensorProduct Ω A K,
          Algebra.TensorProduct.lid Ω K (Algebra.TensorProduct.map χ (AlgHom.id Ω K) w) = 0 →
          ∀ i, cA w i ∈ m := by
        intro m _ χ hχ w hw i
        apply hχ
        rw [← hnat]
        have h1 : Algebra.TensorProduct.map χ (AlgHom.id Ω K) w = 0 :=
          (Algebra.TensorProduct.lid Ω K).injective (hw.trans (map_zero _).symm)
        rw [h1, map_zero, Finsupp.zero_apply]
      by_contra hne
      push_neg at hne
      obtain ⟨hx0, hy0⟩ := hne
      have hcx : cA x' ≠ 0 := fun h => hx0 (cA.injective (h.trans (map_zero cA).symm))
      have hcy : cA y' ≠ 0 := fun h => hy0 (cA.injective (h.trans (map_zero cA).symm))
      obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hcx
      obtain ⟨i', hi'⟩ := Finsupp.ne_iff.mp hcy
      rw [Finsupp.zero_apply] at hi hi'
      have hane : cA x' i * cA y' i' ≠ 0 := mul_ne_zero hi hi'
      apply hane
      have hjac : (⊥ : Ideal A).jacobson = ⊥ := IsJacobsonRing.out' ⊥ Ideal.isRadical_bot
      have hmem : cA x' i * cA y' i' ∈ (⊥ : Ideal A).jacobson := by
        rw [Ideal.jacobson, Ideal.mem_sInf]
        rintro m ⟨-, hm⟩
        haveI := hm
        obtain ⟨χ, hχ⟩ := hchar A m
        let θ : TensorProduct Ω A K →ₐ[Ω] K :=
          (Algebra.TensorProduct.lid Ω K).toAlgHom.comp
            (Algebra.TensorProduct.map χ (AlgHom.id Ω K))
        have hθ : θ x' * θ y' = 0 := by rw [← map_mul, hxy, map_zero]
        rcases mul_eq_zero.mp hθ with h | h
        · exact m.mul_mem_right _ (hzero m χ hχ x' h i)
        · exact m.mul_mem_left _ (hzero m χ hχ y' h i')
      rw [hjac] at hmem
      exact (Submodule.mem_bot A).mp hmem
    haveI : NoZeroDivisors (TensorProduct Ω L K) := by
      refine ⟨fun {x y} hxy => ?_⟩
      obtain ⟨A, hA, x', rfl⟩ := hrange x
      obtain ⟨B, hB, y', rfl⟩ := hrange y
      set x'' := Algebra.TensorProduct.map (Subalgebra.inclusion (le_sup_left : A ≤ A ⊔ B))
        (AlgHom.id Ω K) x'
      set y'' := Algebra.TensorProduct.map (Subalgebra.inclusion (le_sup_right : B ≤ A ⊔ B))
        (AlgHom.id Ω K) y'
      have ex : j (A ⊔ B) x'' = j A x' := hmono _ _ _ _
      have ey : j (A ⊔ B) y'' = j B y' := hmono _ _ _ _
      rw [← ex, ← ey] at hxy ⊢
      have h0 : x'' * y'' = 0 := hjinj (A ⊔ B) (by rw [map_mul, hxy, map_zero])
      rcases key (A ⊔ B) (hA.sup hB) x'' y'' h0 with h | h
      · left; rw [h, map_zero]
      · right; rw [h, map_zero]
    exact NoZeroDivisors.to_isDomain _

  have hfibre : ∀ (Ω K : Type u) [Field Ω] [Field K] [Algebra Ω K],
      (∀ (L : Type u) [Field L] [Algebra Ω L], IsDomain (TensorProduct Ω L K)) →
      ∀ (Y : Scheme.{u}) (q : Y ⟶ Spec (.of Ω)) (y : Y),
      _root_.IsConnected
        (⇑(Limits.pullback.fst q (Spec.map (CommRingCat.ofHom (algebraMap Ω K)))) ⁻¹' {y}) := by
    intro Ω K _ _ _ hdom Y q y
    set g := Spec.map (CommRingCat.ofHom (algebraMap Ω K)) with hg
    set p := Limits.pullback.fst q g with hp
    set h := Y.fromSpecResidueField y with hh
    let φ : Ω →+* Y.residueField y := (Spec.preimage (h ≫ q)).hom
    letI : Algebra Ω (Y.residueField y) := φ.toAlgebra
    have hφ : h ≫ q = Spec.map (CommRingCat.ofHom (algebraMap Ω (Y.residueField y))) := by
      rw [← Spec.map_preimage (h ≫ q)]
      rfl
    haveI : IsDomain (TensorProduct Ω (Y.residueField y) K) := hdom _
    let i : (p.fiber y) ≅ Spec (.of (TensorProduct Ω (Y.residueField y) K)) :=
      Limits.pullbackSymmetry p h ≪≫ Limits.pullbackRightPullbackFstIso q g h ≪≫
        Limits.pullback.congrHom hφ rfl ≪≫ pullbackSpecIso Ω (Y.residueField y) K
    haveI : ConnectedSpace (p.fiber y) := by
      haveI : ConnectedSpace (Spec (.of (TensorProduct Ω (Y.residueField y) K))) :=
        (inferInstance :
          IrreducibleSpace (PrimeSpectrum (TensorProduct Ω (Y.residueField y) K))).connectedSpace
      exact (Scheme.homeoOfIso i.symm).surjective.connectedSpace
        (Scheme.homeoOfIso i.symm).continuous
    rw [isConnected_iff_connectedSpace]
    exact (p.fiberHomeo y).surjective.connectedSpace (p.fiberHomeo y).continuous

  have hfactor : ∀ (T : Scheme.{u}) (t : T) (K : Type u) [Field K] [IsAlgClosed K]
      (s : Spec (.of K) ⟶ T), s (IsLocalRing.closedPoint K) = t →
      ∃ ι : AlgebraicClosure (T.residueField t) →+* K,
        Spec.map (CommRingCat.ofHom ι) ≫
          (Spec.map (CommRingCat.ofHom (algebraMap (T.residueField t)
            (AlgebraicClosure (T.residueField t)))) ≫ T.fromSpecResidueField t) = s := by
    intro T t K _ _ s hs
    subst hs
    let ρ : T.residueField (s (IsLocalRing.closedPoint K)) →+* K :=
      (Scheme.descResidueField (Scheme.stalkClosedPointTo s)).hom
    letI : Algebra (T.residueField (s (IsLocalRing.closedPoint K))) K := ρ.toAlgebra
    let L : AlgebraicClosure (T.residueField (s (IsLocalRing.closedPoint K))) →ₐ[T.residueField
        (s (IsLocalRing.closedPoint K))] K := IsAlgClosed.lift
    refine ⟨L.toRingHom, ?_⟩
    have e1 : L.toRingHom.comp (algebraMap _
        (AlgebraicClosure (T.residueField (s (IsLocalRing.closedPoint K))))) = ρ :=
      L.comp_algebraMap
    rw [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, e1]
    exact Scheme.descResidueField_stalkClosedPointTo_fromSpecResidueField K T s

  intro Z T u t K _ _ s hs hconn
  obtain ⟨ι, hfac⟩ := hfactor T t K s hs
  letI : Algebra (AlgebraicClosure (T.residueField t)) K := ι.toAlgebra
  set g0 := Spec.map (CommRingCat.ofHom (algebraMap (T.residueField t)
    (AlgebraicClosure (T.residueField t)))) ≫ T.fromSpecResidueField t with hg0
  haveI : ConnectedSpace ↥(Limits.pullback u g0) := hconn
  set q := Limits.pullback.snd u g0 with hq
  set p := Limits.pullback.fst q
    (Spec.map (CommRingCat.ofHom (algebraMap (AlgebraicClosure (T.residueField t)) K))) with hp
  have hquot : Topology.IsQuotientMap p := Flat.isQuotientMap_of_surjective p
  have hfib : ∀ y, _root_.IsConnected (⇑p ⁻¹' {y}) :=
    hfibre _ K (fun L _ _ => hdomain _ L K) _ q
  have hc := hquot.isCoinducing.isConnected_preimage_of_isClosed hfib isClosed_univ
    isConnected_univ
  rw [Set.preimage_univ] at hc
  haveI : ConnectedSpace ↥(Limits.pullback q (Spec.map (CommRingCat.ofHom ι))) :=
    connectedSpace_iff_univ.mpr hc
  let i : Limits.pullback q (Spec.map (CommRingCat.ofHom ι)) ≅ Limits.pullback u s :=
    Limits.pullbackLeftPullbackSndIso u g0 (Spec.map (CommRingCat.ofHom ι)) ≪≫
      Limits.pullback.congrHom rfl hfac
  exact (Scheme.homeoOfIso i).surjective.connectedSpace (Scheme.homeoOfIso i).continuous

theorem wcpa_dj_gcb_henselian_closed_fibre_split : ∀ (X : Scheme.{u}) (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (g : X ⟶ Spec (.of A)) [IsProper g] (Ω : Type u) [Field Ω] (e : IsLocalRing.ResidueField A →+* Ω), e.IsIntegral → Nonempty ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) → ¬ ConnectedSpace ↥(Limits.pullback g (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)))) → ∃ C : Set X, IsClopen C ∧ (∃ x ∈ C, g x = IsLocalRing.closedPoint A) ∧ (∃ x ∉ C, g x = IsLocalRing.closedPoint A) :=
by
  intro X A _ _ _ g _ Ω _ e he hne hnc
  classical
  set ι : A →+* Ω := e.comp (IsLocalRing.residue A) with hι
  have hk : Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) =
      Spec.map (CommRingCat.ofHom ι) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
  rw [hk] at hne hnc
  have hιint : ι.IsIntegral :=
    RingHom.IsIntegral.trans _ _ (RingHom.isIntegral_of_surjective _ IsLocalRing.residue_surjective) he
  haveI hιloc : IsLocalHom ι := by
    refine ⟨fun a ha => ?_⟩
    by_contra hna
    have h0 : IsLocalRing.residue A a = 0 := by
      by_contra h
      exact hna ((IsLocalRing.residue_ne_zero_iff_isUnit a).mp h)
    have h1 : ι a = 0 := by rw [hι, RingHom.comp_apply, h0, map_zero]
    rw [h1] at ha
    exact not_isUnit_zero ha
  haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom ι)) := by
    rw [CommRingCat.hom_ofHom]; exact hιloc
  set j := Spec.map (CommRingCat.ofHom ι) with hj
  set p := Limits.pullback.fst g j with hp
  have hjpt : ∀ w, j w = IsLocalRing.closedPoint A := by
    intro w
    rw [Subsingleton.elim w (IsLocalRing.closedPoint Ω)]
    exact AlgebraicGeometry.Spec_closedPoint
  have hfib : ∀ z, g (p z) = IsLocalRing.closedPoint A := by
    intro z
    rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    exact hjpt _
  have hinj : Function.Injective p := by
    intro z z' hzz
    obtain ⟨w, -, hw⟩ :=
      wc_sepclosed_integral_closed_fibre_unique_lift A Ω ι hιloc hιint X g (p z) (hfib z)
    exact (hw z ⟨rfl, Subsingleton.elim _ _⟩).trans (hw z' ⟨hzz.symm, Subsingleton.elim _ _⟩).symm
  have hsurj : ∀ x, g x = IsLocalRing.closedPoint A → ∃ z, p z = x := by
    intro x hx
    obtain ⟨w, ⟨hw1, -⟩, -⟩ :=
      wc_sepclosed_integral_closed_fibre_unique_lift A Ω ι hιloc hιint X g x hx
    exact ⟨w, hw1⟩
  haveI : IsIntegralHom j :=
    IsIntegralHom.SpecMap_iff.mpr (by rw [CommRingCat.hom_ofHom]; exact hιint)
  have hpc : IsClosedMap p := p.isClosedMap
  have hnp : ¬ PreconnectedSpace ↥(Limits.pullback g j) := fun h =>
    hnc { toPreconnectedSpace := h, toNonempty := hne }
  rw [preconnectedSpace_iff_clopen] at hnp
  push_neg at hnp
  obtain ⟨P₁, hP₁, hP₁e, hP₁u⟩ := hnp
  obtain ⟨a, ha⟩ := hP₁e
  obtain ⟨b, hb⟩ := (Set.ne_univ_iff_exists_notMem P₁).mp hP₁u
  have hT1 : IsClosed (p '' P₁) := hpc _ hP₁.isClosed
  have hT2 : IsClosed (p '' P₁ᶜ) := hpc _ hP₁.isOpen.isClosed_compl
  have hdisj : Disjoint (p '' P₁) (p '' P₁ᶜ) := by
    rw [Set.disjoint_left]
    rintro _ ⟨x, hx, rfl⟩ ⟨y, hy, hxy⟩
    apply hy
    rw [hinj hxy]
    exact hx
  have hunion : p '' P₁ ∪ p '' P₁ᶜ = g ⁻¹' {IsLocalRing.closedPoint A} := by
    rw [← Set.image_union, Set.union_compl_self, Set.image_univ]
    ext x
    constructor
    · rintro ⟨z, rfl⟩; exact hfib z
    · intro hx; exact hsurj x hx
  obtain ⟨C, hC, hCiff⟩ := wc_proper_henselian_closed_fibre_clopen_extend A X g (p '' P₁)
    (p '' P₁ᶜ) hT1 hT2 hdisj hunion
  refine ⟨C, hC, ⟨p a, (hCiff _ (hfib a)).mpr ⟨a, ha, rfl⟩, hfib a⟩, ⟨p b, ?_, hfib b⟩⟩
  intro hpb
  obtain ⟨a', ha', hpa'⟩ := (hCiff _ (hfib b)).mp hpb
  apply hb
  rw [← hinj hpa']
  exact ha'

theorem wcpa_dj_gcb_limit_clopen_descent : ∀ (Z T : Scheme.{u}) (u : Z ⟶ T) [IsProper u] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (V : Λ ⥤ Over T) (P : Scheme.{u}) (φ : ∀ l, P ⟶ (V.obj l).left) (a : P ⟶ T), (∀ l, IsAffine (V.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), φ l ≫ (V.map t).left = φ l') → (∀ l, φ l ≫ (V.obj l).hom = a) → (∀ (T₀ : Scheme.{u}) (z : ∀ l, T₀ ⟶ (V.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (V.map t).left = z l') → ∃! z₀ : T₀ ⟶ P, ∀ l, z₀ ≫ φ l = z l) → ∀ C : Set ↥(Limits.pullback u a), IsClopen C → ∃ (l : Λ) (C' : Set ↥(Limits.pullback u (V.obj l).hom)) (ψ : Limits.pullback u a ⟶ Limits.pullback u (V.obj l).hom), ψ ≫ Limits.pullback.fst u (V.obj l).hom = Limits.pullback.fst u a ∧ ψ ≫ Limits.pullback.snd u (V.obj l).hom = Limits.pullback.snd u a ≫ φ l ∧ IsClopen C' ∧ ψ ⁻¹' C' = C :=
by
  intro Z T u _ Λ _ _ V P φ a haff hφc hφa hlim C hC
  classical

  have s1 : ∀ (D : Λ ⥤ Scheme.{u}) (c : Limits.Cone D), Limits.IsLimit c →
      (∀ {i j : Λ} (f : i ⟶ j), IsAffineHom (D.map f)) → (∀ i, CompactSpace ↥(D.obj i)) →
      (∀ i, QuasiSeparatedSpace ↥(D.obj i)) → ∀ C : Set ↥c.pt, IsClopen C →
      ∃ (i : Λ) (C' : Set ↥(D.obj i)), IsClopen C' ∧ ⇑(c.π.app i) ⁻¹' C' = C := by
    intro D c hc hA hK hQ C hC
    haveI : ∀ {i j : Λ} (f : i ⟶ j), IsAffineHom (D.map f) := fun f => hA f
    haveI : ∀ i, CompactSpace ↥(D.obj i) := hK
    haveI : ∀ i, QuasiSeparatedSpace ↥(D.obj i) := hQ
    haveI : CompactSpace ↥c.pt := Scheme.compactSpace_of_isLimit D c hc
    have pull : ∀ {i j : Λ} (g : j ⟶ i) (W : (D.obj i).Opens) (U : c.pt.Opens),
        c.π.app i ⁻¹ᵁ W = U → c.π.app j ⁻¹ᵁ (D.map g ⁻¹ᵁ W) = U := by
      intro i j g W U h
      rw [← Scheme.Hom.comp_preimage, c.w]
      exact h
    obtain ⟨i₁, V₁, hV₁, e₁⟩ := exists_preimage_eq D c hc ⟨C, hC.isOpen⟩ hC.isClosed.isCompact
    obtain ⟨i₂, V₂, hV₂, e₂⟩ := exists_preimage_eq D c hc ⟨Cᶜ, hC.isClosed.isOpen_compl⟩
      hC.isOpen.isClosed_compl.isCompact
    have f₁ := pull (IsCofiltered.minToLeft i₁ i₂) V₁ _ e₁
    have f₂ := pull (IsCofiltered.minToRight i₁ i₂) V₂ _ e₂
    have hW₁ : IsCompact ((D.map (IsCofiltered.minToLeft i₁ i₂) ⁻¹ᵁ V₁ :
        (D.obj (IsCofiltered.min i₁ i₂)).Opens) : Set (D.obj (IsCofiltered.min i₁ i₂))) :=
      Scheme.Hom.isCompact_preimage (D.map (IsCofiltered.minToLeft i₁ i₂)) hV₁
    have hW₂ : IsCompact ((D.map (IsCofiltered.minToRight i₁ i₂) ⁻¹ᵁ V₂ :
        (D.obj (IsCofiltered.min i₁ i₂)).Opens) : Set (D.obj (IsCofiltered.min i₁ i₂))) :=
      Scheme.Hom.isCompact_preimage (D.map (IsCofiltered.minToRight i₁ i₂)) hV₂
    obtain ⟨i, W₁, W₂, hW₁, hW₂, f₁, f₂⟩ : ∃ (i : Λ) (W₁ W₂ : (D.obj i).Opens),
        IsCompact (W₁ : Set (D.obj i)) ∧ IsCompact (W₂ : Set (D.obj i)) ∧
        c.π.app i ⁻¹ᵁ W₁ = ⟨C, hC.isOpen⟩ ∧ c.π.app i ⁻¹ᵁ W₂ = ⟨Cᶜ, hC.isClosed.isOpen_compl⟩ :=
      ⟨_, _, _, hW₁, hW₂, f₁, f₂⟩
    have hW12 : IsCompact ((W₁ ⊓ W₂ : (D.obj i).Opens) : Set (D.obj i)) := by
      rw [TopologicalSpace.Opens.coe_inf]
      exact QuasiSeparatedSpace.inter_isCompact _ _ W₁.isOpen hW₁ W₂.isOpen hW₂
    have hdis : c.π.app i ⁻¹ᵁ (W₁ ⊓ W₂) ≤ c.π.app i ⁻¹ᵁ ⊥ := by
      rw [Scheme.Hom.preimage_inf, f₁, f₂, Scheme.Hom.preimage_bot]
      intro x hx
      exact absurd (show x ∈ C from hx.1) (show x ∉ C from hx.2)
    obtain ⟨j, g, hg⟩ := exists_map_preimage_le_map_preimage D c hc hW12 hdis
    rw [Scheme.Hom.preimage_bot, Scheme.Hom.preimage_inf] at hg
    have f₁' := pull g W₁ _ f₁
    have f₂' := pull g W₂ _ f₂
    generalize D.map g ⁻¹ᵁ W₁ = W₁' at hg f₁'
    generalize D.map g ⁻¹ᵁ W₂ = W₂' at hg f₂'
    have hcov : c.π.app j ⁻¹ᵁ ⊤ ≤ c.π.app j ⁻¹ᵁ (W₁' ⊔ W₂') := by
      intro x _
      rw [Scheme.Hom.mem_preimage, TopologicalSpace.Opens.mem_sup]
      by_cases hx : x ∈ C
      · left
        have : x ∈ c.π.app j ⁻¹ᵁ W₁' := by rw [f₁']; exact hx
        exact (Scheme.Hom.mem_preimage _).mp this
      · right
        have : x ∈ c.π.app j ⁻¹ᵁ W₂' := by rw [f₂']; exact hx
        exact (Scheme.Hom.mem_preimage _).mp this
    have htop : IsCompact ((⊤ : (D.obj j).Opens) : Set (D.obj j)) := by
      rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ
    obtain ⟨k, g', hg'⟩ := exists_map_preimage_le_map_preimage D c hc htop hcov
    have f₁'' := pull g' W₁' _ f₁'
    have hcompl : ((D.map g' ⁻¹ᵁ W₁' : (D.obj k).Opens) : Set (D.obj k))ᶜ =
        ((D.map g' ⁻¹ᵁ W₂' : (D.obj k).Opens) : Set (D.obj k)) := by
      ext y
      constructor
      · intro hy
        have hy' : y ∈ D.map g' ⁻¹ᵁ (W₁' ⊔ W₂') :=
          hg' (by rw [Scheme.Hom.preimage_top]; trivial)
        rw [Scheme.Hom.mem_preimage, TopologicalSpace.Opens.mem_sup] at hy'
        rcases hy' with h | h
        · exact absurd ((Scheme.Hom.mem_preimage _).mpr h) hy
        · exact (Scheme.Hom.mem_preimage _).mpr h
      · intro hy hy1
        have h1 : D.map g' y ∈ W₁' ⊓ W₂' :=
          ⟨(Scheme.Hom.mem_preimage _).mp hy1, (Scheme.Hom.mem_preimage _).mp hy⟩
        have h2 := hg h1
        simp at h2
    refine ⟨k, ((D.map g' ⁻¹ᵁ W₁' : (D.obj k).Opens) : Set (D.obj k)), ⟨?_, (D.map g' ⁻¹ᵁ W₁').isOpen⟩, ?_⟩
    · rw [← isOpen_compl_iff, hcompl]; exact (D.map g' ⁻¹ᵁ W₂').isOpen
    · rw [← Scheme.Hom.coe_preimage, f₁'']
      rfl

  let D : Λ ⥤ Scheme.{u} :=
    { obj := fun l => Limits.pullback u (V.obj l).hom
      map := fun {l l'} t => Limits.pullback.lift (Limits.pullback.fst u (V.obj l).hom)
          (Limits.pullback.snd u (V.obj l).hom ≫ (V.map t).left)
          (by rw [Category.assoc, Over.w, Limits.pullback.condition])
      map_id := fun l => by
        apply Limits.pullback.hom_ext <;> simp
      map_comp := fun t t' => by
        apply Limits.pullback.hom_ext
        · simp only [Category.assoc, Limits.pullback.lift_fst]
        · simp only [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc,
            Functor.map_comp, Over.comp_left] }
  have hD1 : ∀ {l l' : Λ} (t : l ⟶ l'), D.map t ≫ Limits.pullback.fst u (V.obj l').hom =
      Limits.pullback.fst u (V.obj l).hom := fun t => Limits.pullback.lift_fst _ _ _
  have hD2 : ∀ {l l' : Λ} (t : l ⟶ l'), D.map t ≫ Limits.pullback.snd u (V.obj l').hom =
      Limits.pullback.snd u (V.obj l).hom ≫ (V.map t).left := fun t => Limits.pullback.lift_snd _ _ _
  let c : Limits.Cone D :=
    { pt := Limits.pullback u a
      π := { app := fun l => Limits.pullback.lift (Limits.pullback.fst u a)
                (Limits.pullback.snd u a ≫ φ l)
                (by rw [Category.assoc, hφa l, Limits.pullback.condition])
             naturality := fun l l' t => by
               apply Limits.pullback.hom_ext
               · simp only [Functor.const_obj_map, Category.assoc, hD1]
                 rw [Limits.pullback.lift_fst, Limits.pullback.lift_fst]
                 exact Category.id_comp _
               · simp only [Functor.const_obj_map, Category.assoc, hD2]
                 rw [Limits.pullback.lift_snd, Limits.pullback.lift_snd_assoc, Category.assoc,
                   hφc t]
                 exact Category.id_comp _ } }
  have hc1 : ∀ l, c.π.app l ≫ Limits.pullback.fst u (V.obj l).hom = Limits.pullback.fst u a :=
    fun l => Limits.pullback.lift_fst _ _ _
  have hc2 : ∀ l, c.π.app l ≫ Limits.pullback.snd u (V.obj l).hom =
      Limits.pullback.snd u a ≫ φ l := fun l => Limits.pullback.lift_snd _ _ _

  have hAff : ∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t) := by
    intro l l' t
    haveI := haff l
    haveI := haff l'
    have hpb : IsPullback (D.map t) (Limits.pullback.snd u (V.obj l).hom)
        (Limits.pullback.snd u (V.obj l').hom) (V.map t).left := by
      refine IsPullback.of_right (h₁₂ := Limits.pullback.fst u (V.obj l').hom) (v₁₃ := u)
        (h₂₂ := (V.obj l').hom) ?_ (hD2 t) (IsPullback.of_hasPullback u (V.obj l').hom)
      rw [hD1 t, Over.w]
      exact IsPullback.of_hasPullback u (V.obj l).hom
    exact MorphismProperty.of_isPullback (P := @IsAffineHom) hpb.flip (isAffineHom_of_isAffine _)

  have hK : ∀ l, CompactSpace ↥(D.obj l) := by
    intro l
    haveI := haff l
    haveI : QuasiCompact (Limits.pullback.snd u (V.obj l).hom) :=
      MorphismProperty.of_isPullback (P := @QuasiCompact)
        (IsPullback.of_hasPullback u (V.obj l).hom) inferInstance
    exact QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.snd u (V.obj l).hom)
  have hQ : ∀ l, QuasiSeparatedSpace ↥(D.obj l) := by
    intro l
    haveI := haff l
    haveI : QuasiSeparated (Limits.pullback.snd u (V.obj l).hom) :=
      MorphismProperty.of_isPullback (P := @QuasiSeparated)
        (IsPullback.of_hasPullback u (V.obj l).hom) inferInstance
    exact quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.snd u (V.obj l).hom)

  have hc : Limits.IsLimit c := by
    refine Limits.IsLimit.ofExistsUnique (fun s => ?_)
    obtain ⟨l₀⟩ := IsCofiltered.nonempty (C := Λ)
    have hs1 : ∀ {l l' : Λ} (t : l ⟶ l'), s.π.app l ≫ Limits.pullback.fst u (V.obj l).hom =
        s.π.app l' ≫ Limits.pullback.fst u (V.obj l').hom := by
      intro l l' t
      rw [← s.w t, Category.assoc, hD1]
    have hs2 : ∀ {l l' : Λ} (t : l ⟶ l'), (s.π.app l ≫ Limits.pullback.snd u (V.obj l).hom) ≫
        (V.map t).left = s.π.app l' ≫ Limits.pullback.snd u (V.obj l').hom := by
      intro l l' t
      rw [← s.w t, Category.assoc, Category.assoc, hD2]
    have hconst : ∀ l, s.π.app l ≫ Limits.pullback.fst u (V.obj l).hom =
        s.π.app l₀ ≫ Limits.pullback.fst u (V.obj l₀).hom := fun l =>
      (hs1 (IsCofiltered.minToLeft l l₀)).symm.trans (hs1 (IsCofiltered.minToRight l l₀))
    obtain ⟨z₀, hz₀, hz₀u⟩ := hlim s.pt
      (fun l => s.π.app l ≫ Limits.pullback.snd u (V.obj l).hom) (fun t => hs2 t)
    have hw : (s.π.app l₀ ≫ Limits.pullback.fst u (V.obj l₀).hom) ≫ u = z₀ ≫ a := by
      rw [Category.assoc, Limits.pullback.condition, ← hφa l₀, ← Category.assoc z₀, hz₀ l₀,
        Category.assoc]
    refine ⟨Limits.pullback.lift _ _ hw, ?_, ?_⟩
    · intro l
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, hc1, Limits.pullback.lift_fst, hconst l]
      · rw [Category.assoc, hc2, Limits.pullback.lift_snd_assoc, hz₀ l]
    · intro w hw'
      apply Limits.pullback.hom_ext
      · rw [Limits.pullback.lift_fst, ← hc1 l₀, ← Category.assoc, hw' l₀]
      · rw [Limits.pullback.lift_snd]
        apply hz₀u
        intro l
        rw [Category.assoc, ← hc2 l, ← Category.assoc, hw' l]

  obtain ⟨l, C', hC', hpre⟩ := s1 D c hc hAff hK hQ C hC
  exact ⟨l, C', c.π.app l, hc1 l, hc2 l, hC', hpre⟩

theorem wcpa_dj_gcb_disconnected_locus_open : ∀ (Z T : Scheme.{u}) (u : Z ⟶ T), Flat u → IsProper u → LocallyOfFinitePresentation u → IsOpen {t : T | ∃ (K : Type u) (_ : Field K) (_ : IsAlgClosed K) (s : Spec (.of K) ⟶ T), s (IsLocalRing.closedPoint K) = t ∧ ¬ ConnectedSpace ↥(Limits.pullback u s)} :=
by
  intro Z T u hfl hpr hlfp
  classical
  haveI := hfl
  haveI := hpr
  haveI := hlfp

  have pt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]

  have F0 : ∀ (B : Scheme.{u}) (b : B) (x : ↥(Spec (.of (AlgebraicClosure (B.residueField b))))),
      (Spec.map (CommRingCat.ofHom (algebraMap (B.residueField b)
        (AlgebraicClosure (B.residueField b)))) ≫ B.fromSpecResidueField b) x = b := by
    intro B b x
    rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply]

  have hpt : ∀ (L : Type u) [Field L] (x : ↥(Spec (.of L))), x = IsLocalRing.closedPoint L := by
    intro L _ x
    exact Subsingleton.elim _ _

  have H1 : ∀ {Y X : Scheme.{u}} (π : Y ⟶ X) (C' : Set X), IsClopen C' →
      (∃ v, π v ∈ C') → (∃ v, π v ∉ C') → ¬ ConnectedSpace Y := by
    intro Y X π C' hC' ⟨v₁, hv₁⟩ ⟨v₂, hv₂⟩ hconn
    have hc : IsClopen (⇑π ⁻¹' C') := hC'.preimage π.continuous
    rcases isClopen_iff.mp hc with h | h
    · have : v₁ ∈ ⇑π ⁻¹' C' := hv₁
      rw [h] at this
      exact this
    · have : v₂ ∈ ⇑π ⁻¹' C' := by rw [h]; trivial
      exact hv₂ this

  have H2 : ∀ {X Y : Scheme.{u}} (i : X ≅ Y), ConnectedSpace X → ConnectedSpace Y := by
    intro X Y i h
    haveI := h
    exact (Scheme.homeoOfIso i).surjective.connectedSpace (Scheme.homeoOfIso i).continuous
  rw [isOpen_iff_forall_mem_open]
  rintro t₀ ⟨K, iK, hK, s, hs, hnc⟩
  by_cases hne : Nonempty ↥(Limits.pullback u s)
  swap
  ·
    refine ⟨(Set.range u)ᶜ, ?_, u.isClosedMap.isClosed_range.isOpen_compl, ?_⟩
    · intro t ht
      refine ⟨AlgebraicClosure (T.residueField t), inferInstance, inferInstance,
        Spec.map (CommRingCat.ofHom (algebraMap (T.residueField t)
          (AlgebraicClosure (T.residueField t)))) ≫ T.fromSpecResidueField t, F0 T t _, ?_⟩
      intro hc
      obtain ⟨w⟩ := hc.toNonempty
      apply ht
      refine ⟨Limits.pullback.fst u _ w, ?_⟩
      rw [pt Limits.pullback.condition w]
      exact F0 T t _
    · rintro ⟨z, hz⟩
      apply hne
      obtain ⟨w, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := u) (g := s) z
        (IsLocalRing.closedPoint K) (hz.trans hs.symm)
      exact ⟨w⟩

  obtain ⟨w⟩ := hne
  set g0 := Spec.map (CommRingCat.ofHom (algebraMap (T.residueField t₀)
    (AlgebraicClosure (T.residueField t₀)))) ≫ T.fromSpecResidueField t₀ with hg0
  have hne0 : Nonempty ↥(Limits.pullback u g0) := by
    have h1 : u (Limits.pullback.fst u s w) = g0 (IsLocalRing.closedPoint _) :=
      (pt Limits.pullback.condition w).trans ((pt rfl w).symm.trans
        ((congrArg s (hpt K (Limits.pullback.snd u s w))).trans (hs.trans (F0 T t₀ _).symm)))
    obtain ⟨z, -, -⟩ := Scheme.Pullback.exists_preimage_pullback _ _ h1
    exact ⟨z⟩
  have hnc0 : ¬ ConnectedSpace ↥(Limits.pullback u g0) := fun h =>
    hnc (wcpa_dj_gcb_geom_fibre_conn_transfer Z T u t₀ K s hs h)

  obtain ⟨A, iA, hA, hsep, Λ, iΛ, hΛ, W', φ, a, e, -, haff, hφc, hφa, hlim, he, hE⟩ :=
    wc_et_geom_strict_henselization t₀
  have hgeom : wcEtGeomPt T t₀ = g0 := rfl
  have hres : ∀ x : ↥(Spec (.of (IsLocalRing.ResidueField A))),
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) x = IsLocalRing.closedPoint A := by
    intro x
    haveI : IsLocalHom (CommRingCat.Hom.hom (CommRingCat.ofHom (IsLocalRing.residue A))) :=
      (inferInstance : IsLocalHom (IsLocalRing.residue A))
    exact (congrArg _ (hpt _ x)).trans AlgebraicGeometry.Spec_closedPoint
  have haA : a (IsLocalRing.closedPoint A) = t₀ := by
    have h1 := pt hE (IsLocalRing.closedPoint (AlgebraicClosure (T.residueField t₀)))
    have h2 := pt (rfl : Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ a =
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue A)) ≫ a)
      (Spec.map (CommRingCat.ofHom e) (IsLocalRing.closedPoint (AlgebraicClosure (T.residueField t₀))))
    exact (congrArg a (hres _)).symm.trans (h2.trans (h1.trans (F0 T t₀ _)))

  set g := Limits.pullback.snd u a with hgdef
  haveI hgp : IsProper g :=
    MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback u a) hpr
  set k := Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))
    with hk
  have hka : k ≫ a = g0 := by rw [hk, Category.assoc, hE, hgeom]
  let iso : Limits.pullback g k ≅ Limits.pullback u g0 :=
    Limits.pullbackLeftPullbackSndIso u a k ≪≫ Limits.pullback.congrHom rfl hka
  have hneA : Nonempty ↥(Limits.pullback g k) := by
    obtain ⟨z⟩ := hne0
    exact ⟨iso.inv z⟩
  have hncA : ¬ ConnectedSpace ↥(Limits.pullback g k) := fun h => hnc0 (H2 iso h)
  obtain ⟨C, hC, ⟨x₁, hx₁C, hx₁⟩, ⟨x₂, hx₂C, hx₂⟩⟩ :=
    wcpa_dj_gcb_henselian_closed_fibre_split (Limits.pullback u a) A g
      (AlgebraicClosure (T.residueField t₀)) e he hneA hncA

  set V : Λ ⥤ Over T := W' ⋙ StructuredArrow.proj _ _ ⋙ Scheme.Etale.forget T with hV
  obtain ⟨l, C', ψ, -, hψ2, hC', hpre⟩ :=
    wcpa_dj_gcb_limit_clopen_descent Z T u Λ V (Spec (.of A)) φ a
      haff hφc hφa hlim C hC
  have hetl : Etale (V.obj l).hom := (W'.obj l).right.prop
  haveI := hetl
  set q := Limits.pullback.snd u (V.obj l).hom with hq
  haveI hqfl : Flat q :=
    MorphismProperty.of_isPullback (P := @Flat) (IsPullback.of_hasPullback u (V.obj l).hom) hfl
  haveI hqlfp : LocallyOfFinitePresentation q :=
    MorphismProperty.of_isPullback (P := @LocallyOfFinitePresentation)
      (IsPullback.of_hasPullback u (V.obj l).hom) hlfp
  have hOopen : IsOpen (⇑q '' C' ∩ ⇑q '' C'ᶜ) :=
    (q.isOpenMap _ hC'.isOpen).inter (q.isOpenMap _ hC'.isClosed.isOpen_compl)
  refine ⟨⇑(V.obj l).hom '' (⇑q '' C' ∩ ⇑q '' C'ᶜ), ?_, (V.obj l).hom.isOpenMap _ hOopen, ?_⟩
  ·
    rintro t ⟨w', ⟨⟨y₁, hy₁, hq₁⟩, ⟨y₂, hy₂, hq₂⟩⟩, rfl⟩
    set gw := Spec.map (CommRingCat.ofHom (algebraMap ((V.obj l).left.residueField w')
      (AlgebraicClosure ((V.obj l).left.residueField w')))) ≫
        (V.obj l).left.fromSpecResidueField w' with hgw
    refine ⟨AlgebraicClosure ((V.obj l).left.residueField w'), inferInstance, inferInstance,
      gw ≫ (V.obj l).hom, ?_, ?_⟩
    · exact (pt rfl _).symm.trans (congrArg (V.obj l).hom (F0 (V.obj l).left w' _))
    · intro hconn
      have hY : ConnectedSpace ↥(Limits.pullback q gw) :=
        H2 (Limits.pullbackLeftPullbackSndIso u (V.obj l).hom gw).symm hconn
      obtain ⟨v₁, hv₁, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := q) (g := gw) y₁
        (IsLocalRing.closedPoint _) (hq₁.trans (F0 (V.obj l).left w' _).symm)
      obtain ⟨v₂, hv₂, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := q) (g := gw) y₂
        (IsLocalRing.closedPoint _) (hq₂.trans (F0 (V.obj l).left w' _).symm)
      exact H1 (Limits.pullback.fst q gw) C' hC' ⟨v₁, by rw [hv₁]; exact hy₁⟩
        ⟨v₂, by rw [hv₂]; exact hy₂⟩ hY
  ·
    have hm₁ : ψ x₁ ∈ C' := by
      have : x₁ ∈ ⇑ψ ⁻¹' C' := by rw [hpre]; exact hx₁C
      exact this
    have hm₂ : ψ x₂ ∉ C' := by
      intro h
      have : x₂ ∈ ⇑ψ ⁻¹' C' := h
      rw [hpre] at this
      exact hx₂C this
    have hφg : ∀ x, q (ψ x) = φ l (g x) := fun x =>
      (pt hψ2 x).trans (pt (rfl : g ≫ φ l = g ≫ φ l) x).symm
    have hqx₁ : q (ψ x₁) = φ l (IsLocalRing.closedPoint A) :=
      (hφg x₁).trans (congrArg (φ l) hx₁)
    have hqx₂ : q (ψ x₂) = φ l (IsLocalRing.closedPoint A) :=
      (hφg x₂).trans (congrArg (φ l) hx₂)
    refine ⟨φ l (IsLocalRing.closedPoint A), ⟨⟨ψ x₁, hm₁, hqx₁⟩, ⟨ψ x₂, hm₂, hqx₂⟩⟩, ?_⟩
    exact (pt (hφa l) _).trans haA

theorem wcpa_dj_gcl_dvr_trait_localize : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (p q : Ideal A) [p.IsPrime] [q.IsPrime], p < q → ∃ (D : Type u) (_ : CommRing D) (_ : IsDomain D) (_ : IsNoetherianRing D) (_ : IsLocalRing D) (φ : A →+* D), ¬ IsField D ∧ Ideal.comap φ (IsLocalRing.maximalIdeal D) = q ∧ RingHom.ker φ = p :=
by
  intro A _ _ p q _ _ hpq
  classical
  have hπs : Function.Surjective (Ideal.Quotient.mk p) := Ideal.Quotient.mk_surjective
  have hker : RingHom.ker (Ideal.Quotient.mk p) = p := Ideal.mk_ker
  haveI hQ : (Ideal.map (Ideal.Quotient.mk p) q).IsPrime :=
    Ideal.map_isPrime_of_surjective hπs (by rw [hker]; exact hpq.le)
  have hlam : Function.Injective
      (algebraMap (A ⧸ p) (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk p) q))) :=
    IsLocalization.injective (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk p) q))
      (Ideal.primeCompl_le_nonZeroDivisors (Ideal.map (Ideal.Quotient.mk p) q))
  have hcomap : Ideal.comap
      (algebraMap (A ⧸ p) (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk p) q)))
      (IsLocalRing.maximalIdeal (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk p) q))) =
      Ideal.map (Ideal.Quotient.mk p) q :=
    Localization.AtPrime.under_maximalIdeal
  have h4 : Ideal.comap ((algebraMap (A ⧸ p)
      (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk p) q))).comp (Ideal.Quotient.mk p))
      (IsLocalRing.maximalIdeal (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk p) q))) =
      q := by
    rw [← Ideal.comap_comap, hcomap, Ideal.comap_map_of_surjective' _ hπs, hker]
    exact sup_eq_left.mpr hpq.le
  have h5 : RingHom.ker ((algebraMap (A ⧸ p)
      (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk p) q))).comp (Ideal.Quotient.mk p)) =
      p := by
    ext x
    rw [RingHom.mem_ker, RingHom.comp_apply, map_eq_zero_iff _ hlam]
    exact Ideal.Quotient.eq_zero_iff_mem
  have h6 : ¬ IsField (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk p) q)) := by
    intro hF
    obtain ⟨x, hxq, hxp⟩ := SetLike.exists_of_lt hpq
    have hm := (IsLocalRing.isField_iff_maximalIdeal_eq).mp hF
    have hx : ((algebraMap (A ⧸ p)
        (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk p) q))).comp
          (Ideal.Quotient.mk p)) x ∈
        IsLocalRing.maximalIdeal (Localization.AtPrime (Ideal.map (Ideal.Quotient.mk p) q)) := by
      rw [← Ideal.mem_comap, h4]; exact hxq
    rw [hm, Ideal.mem_bot] at hx
    exact hxp (h5 ▸ (RingHom.mem_ker.mpr hx))
  exact ⟨Localization.AtPrime (Ideal.map (Ideal.Quotient.mk p) q), inferInstance, inferInstance,
    inferInstance, inferInstance, _, h6, h4, h5⟩

theorem wcpa_dj_gcl_dvr_trait_blowup_chart : ∀ (D : Type u) [CommRing D] [IsDomain D] [IsNoetherianRing D] [IsLocalRing D], ¬ IsField D → ∃ (B : Type u) (_ : CommRing B) (_ : IsDomain B) (_ : IsNoetherianRing B) (f : D →+* B) (y : B), Function.Injective f ∧ y ≠ 0 ∧ (∀ d ∈ IsLocalRing.maximalIdeal D, f d ∈ Ideal.span {y}) ∧ Ideal.span {y} ≠ ⊤ :=
by
  intro D _ _ _ _ hD
  classical
  have hιinj : Function.Injective (algebraMap D (FractionRing D)) :=
    IsFractionRing.injective D (FractionRing D)
  obtain ⟨V, hV, hloc⟩ := IsLocalRing.exists_factor_valuationRing (algebraMap D (FractionRing D))
  have hV' : ∀ d : D, algebraMap D (FractionRing D) d ∈ V := fun d => hV d
  obtain ⟨S, hS⟩ := (IsNoetherian.noetherian (IsLocalRing.maximalIdeal D) :
    (IsLocalRing.maximalIdeal D).FG)
  have hm0 : IsLocalRing.maximalIdeal D ≠ ⊥ := fun h =>
    hD (IsLocalRing.isField_iff_maximalIdeal_eq.mpr h)
  have hSne : S.Nonempty := by
    rw [Finset.nonempty_iff_ne_empty]
    intro hSe
    apply hm0
    rw [← hS, hSe, Finset.coe_empty, Submodule.span_empty]
  obtain ⟨x, hxS, hxmax⟩ := Finset.exists_max_image S
    (fun s => V.valuation (algebraMap D (FractionRing D) s)) hSne
  have hxm : x ∈ IsLocalRing.maximalIdeal D := hS ▸ Submodule.subset_span hxS
  have hx0 : x ≠ 0 := by
    intro hx
    apply hm0
    rw [← hS, Submodule.span_eq_bot]
    intro s hs
    have h1 := hxmax s hs
    rw [hx, map_zero, Valuation.map_zero] at h1
    have h2 : V.valuation (algebraMap D (FractionRing D) s) = 0 := le_antisymm h1 zero_le
    rw [Valuation.zero_iff] at h2
    exact hιinj (h2.trans (map_zero _).symm)
  have hιx : algebraMap D (FractionRing D) x ≠ 0 := fun h =>
    hx0 (hιinj (h.trans (map_zero _).symm))
  have hvx : 0 < V.valuation (algebraMap D (FractionRing D) x) :=
    (Valuation.pos_iff _).mpr hιx
  have hrat : ∀ s ∈ S, algebraMap D (FractionRing D) s / algebraMap D (FractionRing D) x ∈ V := by
    intro s hs
    rw [← ValuationSubring.valuation_le_one_iff, Valuation.map_div]
    exact (div_le_one₀ hvx).mpr (hxmax s hs)
  have hinv : (algebraMap D (FractionRing D) x)⁻¹ ∉ V := by
    intro hmem
    have hu : IsUnit ((algebraMap D (FractionRing D)).codRestrict V.toSubring hV x) := by
      refine IsUnit.of_mul_eq_one (⟨(algebraMap D (FractionRing D) x)⁻¹, hmem⟩ : V.toSubring) ?_
      apply Subtype.ext
      simp [mul_inv_cancel₀ hιx]
    have hxu : IsUnit x := (isUnit_map_iff _ x).mp hu
    exact (IsLocalRing.mem_maximalIdeal x).mp hxm hxu
  set T : Finset (FractionRing D) :=
    S.image (fun s => algebraMap D (FractionRing D) s / algebraMap D (FractionRing D) x) with hT
  haveI hFT : Algebra.FiniteType D ↥(Algebra.adjoin D (T : Set (FractionRing D))) :=
    (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset T)
  haveI hBN : IsNoetherianRing ↥(Algebra.adjoin D (T : Set (FractionRing D))) :=
    Algebra.FiniteType.isNoetherianRing D _
  have hBV : ∀ z ∈ Algebra.adjoin D (T : Set (FractionRing D)), z ∈ V := by
    intro z hz
    induction hz using Algebra.adjoin_induction with
    | mem z hz =>
      obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hz)
      exact hrat s hs
    | algebraMap r => exact hV' r
    | add a b _ _ ha hb => exact V.add_mem a b ha hb
    | mul a b _ _ ha hb => exact V.mul_mem a b ha hb
  refine ⟨↥(Algebra.adjoin D (T : Set (FractionRing D))), inferInstance, inferInstance, hBN,
    algebraMap D _, algebraMap D _ x, ?_, ?_, ?_, ?_⟩
  · intro a b hab
    apply hιinj
    have := congrArg Subtype.val hab
    simpa using this
  · intro h
    apply hιx
    have := congrArg Subtype.val h
    simpa using this
  · intro d hd
    rw [← hS] at hd
    induction hd using Submodule.span_induction with
    | mem s hs =>
      refine Ideal.mem_span_singleton'.mpr ⟨⟨algebraMap D (FractionRing D) s /
        algebraMap D (FractionRing D) x, Algebra.subset_adjoin
          (Finset.mem_coe.mpr (Finset.mem_image_of_mem _ hs))⟩, ?_⟩
      apply Subtype.ext
      simp [div_mul_cancel₀ _ hιx]
    | zero => rw [map_zero]; exact Submodule.zero_mem _
    | add a b _ _ ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb
    | smul c a _ ha => rw [smul_eq_mul, map_mul]; exact Ideal.mul_mem_left _ _ ha
  · intro htop
    rw [Ideal.span_singleton_eq_top] at htop
    obtain ⟨b, hb⟩ := htop.exists_right_inv
    have h1 : algebraMap D (FractionRing D) x * (b : FractionRing D) = 1 := by
      have := congrArg Subtype.val hb
      simpa using this
    have h2 : (b : FractionRing D) = (algebraMap D (FractionRing D) x)⁻¹ :=
      eq_inv_of_mul_eq_one_right h1
    exact hinv (h2 ▸ hBV b b.2)

theorem wcpa_dj_gcl_dvr_trait_one_dim_local : ∀ (D : Type u) [CommRing D] [IsDomain D] [IsLocalRing D] (B : Type u) [CommRing B] [IsDomain B] [IsNoetherianRing B] (f : D →+* B) (y : B), Function.Injective f → y ≠ 0 → (∀ d ∈ IsLocalRing.maximalIdeal D, f d ∈ Ideal.span {y}) → Ideal.span {y} ≠ ⊤ → ∃ (E : Type u) (_ : CommRing E) (_ : IsDomain E) (_ : IsNoetherianRing E) (_ : IsLocalRing E) (g : D →+* E), Function.Injective g ∧ IsLocalHom g ∧ Ring.KrullDimLE 1 E ∧ ¬ IsField E :=
by
  intro D _ _ _ B _ _ _ f y hf hy0 hmy hyt
  obtain ⟨M, hM, hyM⟩ := Ideal.exists_le_maximal _ hyt
  have : M.IsPrime := hM.isPrime
  obtain ⟨P, hPmin, -⟩ := Ideal.exists_minimalPrimes_le hyM
  have hPprime : P.IsPrime := hPmin.1.1
  have hyP : Ideal.span {y} ≤ P := hPmin.1.2
  have hyPmem : y ∈ P := hyP (Ideal.mem_span_singleton_self y)
  have hinj : Function.Injective (algebraMap B (Localization.AtPrime P)) :=
    IsLocalization.injective (Localization.AtPrime P) (Ideal.primeCompl_le_nonZeroDivisors P)
  have hmem : ∀ b ∈ P, algebraMap B (Localization.AtPrime P) b ∈
      IsLocalRing.maximalIdeal (Localization.AtPrime P) := fun b hb =>
    (IsLocalization.AtPrime.to_map_mem_maximal_iff (Localization.AtPrime P) P b).mpr hb
  refine ⟨Localization.AtPrime P, inferInstance, inferInstance, inferInstance, inferInstance,
    (algebraMap B (Localization.AtPrime P)).comp f, ?_, ?_, ?_, ?_⟩
  · exact hinj.comp hf
  · apply ((IsLocalRing.local_hom_TFAE ((algebraMap B (Localization.AtPrime P)).comp f)).out 4 1).mp
    intro d hd
    rw [Ideal.mem_comap]
    exact hmem _ (hyP (hmy d hd))
  · have hPh : P.height ≤ 1 :=
      Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes (Ideal.span {y}) P hPmin
    rw [Ring.krullDimLE_iff, IsLocalization.AtPrime.ringKrullDim_eq_height P (Localization.AtPrime P)]
    exact_mod_cast hPh
  · intro hF
    have h0 := (IsLocalRing.isField_iff_maximalIdeal_eq).mp hF
    have h1 := hmem y hyPmem
    rw [h0, Ideal.mem_bot] at h1
    exact hy0 (hinj (h1.trans (map_zero _).symm))

theorem wcpa_dj_gcl_dvr_trait_length_mul : ∀ (E : Type u) [CommRing E] [IsDomain E] (c : E), c ≠ 0 → ∀ (I : Ideal E), Module.length E (E ⧸ (Ideal.span {c} * I)) = Module.length E (E ⧸ Ideal.span {c}) + Module.length E (E ⧸ I) :=
by
  intro E _ _ c hc I
  set C : Ideal E := Ideal.span {c} with hCdef
  set J : Ideal E := C * I with hJdef
  have hJC : J ≤ C := Ideal.mul_le_left
  have hf : I ≤ Submodule.comap (c • LinearMap.id : E →ₗ[E] E) J := by
    intro i hi
    show c • i ∈ J
    rw [smul_eq_mul]
    exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self c) hi
  let f : (E ⧸ I) →ₗ[E] (E ⧸ J) := Submodule.mapQ I J (c • LinearMap.id) hf
  let g : (E ⧸ J) →ₗ[E] (E ⧸ C) := Submodule.factor hJC
  have hfmk : ∀ r : E, f (Submodule.Quotient.mk r) = Submodule.Quotient.mk (c * r) := by
    intro r
    rfl
  have hgmk : ∀ s : E, g (Submodule.Quotient.mk s) = Submodule.Quotient.mk s := by
    intro s
    rfl
  have hinj : Function.Injective f := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    intro y hy
    obtain ⟨r, rfl⟩ := Submodule.Quotient.mk_surjective I y
    rw [hfmk, Submodule.Quotient.mk_eq_zero] at hy
    obtain ⟨z, hz, hzr⟩ := (Ideal.mem_span_singleton_mul).mp hy
    have : z = r := mul_left_cancel₀ hc hzr
    rw [Submodule.Quotient.mk_eq_zero]
    rw [← this]; exact hz
  have hsurj : Function.Surjective g := Submodule.factor_surjective hJC
  have hex : Function.Exact f g := by
    intro y
    obtain ⟨s, rfl⟩ := Submodule.Quotient.mk_surjective J y
    rw [hgmk, Submodule.Quotient.mk_eq_zero]
    constructor
    · intro hs
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp hs
      refine ⟨Submodule.Quotient.mk a, ?_⟩
      rw [hfmk, mul_comm]
    · rintro ⟨y, hy⟩
      obtain ⟨r, rfl⟩ := Submodule.Quotient.mk_surjective I y
      rw [hfmk] at hy
      have h2 : c * r - s ∈ J := (Submodule.Quotient.eq J).mp hy
      have h3 : c * r - s ∈ C := hJC h2
      have h4 : c * r ∈ C := Ideal.mul_mem_right r C (Ideal.mem_span_singleton_self c)
      have h5 : s = c * r - (c * r - s) := by ring
      rw [h5]
      exact C.sub_mem h4 h3
  have key := Module.length_eq_add_of_exact f g hinj hsurj hex
  rw [key, add_comm]

theorem wcpa_dj_gcl_dvr_trait_length_chain : ∀ (E : Type u) [CommRing E] (n : ℕ) (N : ℕ → Ideal E), (∀ k < n, N (k + 1) < N k) → (n : ℕ∞) + Module.length E (E ⧸ N 0) ≤ Module.length E (E ⧸ N n) :=
by
  intro E _ n N
  induction n with
  | zero => intro _; simp
  | succ n ih =>
    intro h
    have IH := ih (fun k hk => h k (by omega))
    have hlt : N (n + 1) < N n := h n (Nat.lt_succ_self n)
    have hle : N (n + 1) ≤ N n := hlt.le
    have key : Module.length E (E ⧸ N n) + 1 ≤ Module.length E (E ⧸ N (n + 1)) := by
      let U : Submodule E (E ⧸ N (n + 1)) := Submodule.map (N (n + 1)).mkQ (N n)
      let g : (E ⧸ N (n + 1)) →ₗ[E] (E ⧸ N n) := Submodule.factor hle
      have hinj : Function.Injective U.subtype := Submodule.injective_subtype U
      have hsurj : Function.Surjective g := Submodule.factor_surjective hle
      have hker : LinearMap.ker g = U := by
        ext x
        obtain ⟨s, rfl⟩ := Submodule.Quotient.mk_surjective (N (n + 1)) x
        rw [LinearMap.mem_ker]
        change Submodule.factor hle ((N (n + 1)).mkQ s) = 0 ↔
          Submodule.Quotient.mk s ∈ Submodule.map (N (n + 1)).mkQ (N n)
        rw [Submodule.factor_mk, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        have e : Submodule.Quotient.mk s ∈ Submodule.map (N (n + 1)).mkQ (N n) ↔
            s ∈ Submodule.comap (N (n + 1)).mkQ (Submodule.map (N (n + 1)).mkQ (N n)) := Iff.rfl
        rw [e, Submodule.comap_map_mkQ, sup_eq_right.mpr hle]
      have hexact : Function.Exact U.subtype g := by
        rw [LinearMap.exact_iff, Submodule.range_subtype, hker]
      have hadd := Module.length_eq_add_of_exact U.subtype g hinj hsurj hexact
      obtain ⟨b, hbQ, hbP⟩ := SetLike.exists_of_lt hlt
      have hnt : Nontrivial U := by
        refine ⟨⟨⟨(N (n + 1)).mkQ b, Submodule.mem_map_of_mem hbQ⟩, 0, ?_⟩⟩
        intro heq
        have h0 : (N (n + 1)).mkQ b = 0 := congrArg Subtype.val heq
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h0
        exact hbP h0
      have hpos : 0 < Module.length E U := Module.length_pos
      have h1 : 1 ≤ Module.length E U := Order.one_le_iff_pos.mpr hpos
      rw [hadd, add_comm (Module.length E U)]
      exact add_le_add le_rfl h1
    calc ((n + 1 : ℕ) : ℕ∞) + Module.length E (E ⧸ N 0)
        = ((n : ℕ∞) + Module.length E (E ⧸ N 0)) + 1 := by push_cast; ring
      _ ≤ Module.length E (E ⧸ N n) + 1 := add_le_add IH le_rfl
      _ ≤ _ := key

theorem wcpa_dj_gcl_dvr_trait_valuation_chain_bound : (∀ (E : Type u) [CommRing E] [IsDomain E] (c : E), c ≠ 0 → ∀ (I : Ideal E), Module.length E (E ⧸ (Ideal.span {c} * I)) = Module.length E (E ⧸ Ideal.span {c}) + Module.length E (E ⧸ I)) → (∀ (E : Type u) [CommRing E] (n : ℕ) (N : ℕ → Ideal E), (∀ k < n, N (k + 1) < N k) → (n : ℕ∞) + Module.length E (E ⧸ N 0) ≤ Module.length E (E ⧸ N n)) → ∀ (E : Type u) [CommRing E] [IsDomain E] [IsNoetherianRing E] [Ring.KrullDimLE 1 E] (W : ValuationSubring (FractionRing E)), (∀ e : E, algebraMap E (FractionRing E) e ∈ W) → ∀ (a : E), a ≠ 0 → ∀ (n : ℕ) (w : ℕ → FractionRing E), (∀ j ≤ n, w j ∈ W) → (∀ j < n, W.valuation (w (j + 1)) < W.valuation (w j)) → W.valuation (algebraMap E (FractionRing E) a) ≤ W.valuation (w n) → (n : ℕ∞) ≤ Module.length E (E ⧸ Ideal.span {a}) :=
by
  intro H4 H5 E _ _ _ _ W hE a ha n w hwW hwlt hwa
  classical
  have hιne : ∀ x : E, x ≠ 0 → algebraMap E (FractionRing E) x ≠ 0 := fun x hx =>
    IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors (mem_nonZeroDivisors_of_ne_zero hx)
  have hle1 : ∀ x : E, W.valuation (algebraMap E (FractionRing E) x) ≤ 1 := fun x =>
    (W.valuation_le_one_iff _).mpr (hE x)

  obtain ⟨c₀, hc₀⟩ := IsLocalization.exist_integer_multiples (nonZeroDivisors E)
    (Finset.range (n + 1)) w
  have hb' : ∀ j : ℕ, ∃ r : E, j ≤ n →
      algebraMap E (FractionRing E) r = algebraMap E (FractionRing E) (c₀ : E) * w j := by
    intro j
    by_cases hj : j ≤ n
    · obtain ⟨r, hr⟩ := hc₀ j (Finset.mem_range.mpr (by omega))
      exact ⟨r, fun _ => by rw [hr, Algebra.smul_def]⟩
    · exact ⟨0, fun h => absurd h hj⟩
  choose b hb using hb'
  have hc0 : (c₀ : E) ≠ 0 := nonZeroDivisors.coe_ne_zero c₀
  have hγ : 0 < W.valuation (algebraMap E (FractionRing E) (c₀ : E)) :=
    W.valuation.pos_iff.mpr (hιne _ hc0)
  have hα : 0 < W.valuation (algebraMap E (FractionRing E) a) :=
    W.valuation.pos_iff.mpr (hιne a ha)
  have hβeq : ∀ j ≤ n, W.valuation (algebraMap E (FractionRing E) (b j)) =
      W.valuation (algebraMap E (FractionRing E) (c₀ : E)) * W.valuation (w j) := by
    intro j hj
    rw [hb j hj, map_mul]
  have hβlt : ∀ j < n, W.valuation (algebraMap E (FractionRing E) (b (j + 1))) <
      W.valuation (algebraMap E (FractionRing E) (b j)) := by
    intro j hj
    rw [hβeq _ hj, hβeq _ hj.le]
    exact mul_lt_mul_of_pos_left (hwlt j hj) hγ
  have hβmono : ∀ k j, k ≤ j → j ≤ n → W.valuation (algebraMap E (FractionRing E) (b j)) ≤
      W.valuation (algebraMap E (FractionRing E) (b k)) := by
    intro k j hkj
    induction j, hkj using Nat.le_induction with
    | base => intro _; exact le_rfl
    | succ m hkm ih => intro hm; exact (hβlt m (by omega)).le.trans (ih (by omega))
  have hαβ : ∀ j ≤ n, W.valuation (algebraMap E (FractionRing E) a) *
      W.valuation (algebraMap E (FractionRing E) (b j)) ≤
      W.valuation (algebraMap E (FractionRing E) (b n)) := by
    intro j hj
    rw [hβeq j hj, hβeq n le_rfl, mul_left_comm]
    apply mul_le_mul_of_nonneg_left _ zero_le'
    have h1 : W.valuation (w j) ≤ 1 := (W.valuation_le_one_iff _).mpr (hwW j hj)
    exact (mul_le_of_le_one_right' h1).trans hwa

  set I : Ideal E := Ideal.span (b '' Set.Iic n) with hI
  have hI' : ∀ s ∈ I, W.valuation (algebraMap E (FractionRing E) a) *
      W.valuation (algebraMap E (FractionRing E) s) ≤
      W.valuation (algebraMap E (FractionRing E) (b n)) := by
    intro s hs
    induction hs using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨j, hj, rfl⟩ := hx
      exact hαβ j hj
    | zero => simp
    | add x y _ _ hx hy =>
      rw [map_add]
      rcases le_total (W.valuation (algebraMap E (FractionRing E) x))
          (W.valuation (algebraMap E (FractionRing E) y)) with h | h
      · exact (mul_le_mul_of_nonneg_left (W.valuation.map_add_le h le_rfl) zero_le').trans hy
      · exact (mul_le_mul_of_nonneg_left (W.valuation.map_add_le le_rfl h) zero_le').trans hx
    | smul r x _ hx =>
      rw [smul_eq_mul, map_mul, map_mul, mul_left_comm]
      exact (mul_le_of_le_one_left' (hle1 r)).trans hx
  set N : ℕ → Ideal E := fun k => Ideal.span (b '' Set.Icc k n) ⊔ Ideal.span {a} * I with hN
  have hchain : ∀ k < n, N (k + 1) < N k := by
    intro k hk
    have hlt := hβlt k hk
    have hpos : 0 < W.valuation (algebraMap E (FractionRing E) (b k)) :=
      lt_of_le_of_lt zero_le' hlt
    let J : Ideal E :=
      { carrier := {r | W.valuation (algebraMap E (FractionRing E) r) <
          W.valuation (algebraMap E (FractionRing E) (b k))}
        add_mem' := fun {x y} hx hy => by
          simp only [Set.mem_setOf_eq, map_add] at hx hy ⊢
          exact W.valuation.map_add_lt hx hy
        zero_mem' := by
          simp only [Set.mem_setOf_eq, map_zero]
          exact hpos
        smul_mem' := fun r x hx => by
          simp only [Set.mem_setOf_eq, smul_eq_mul, map_mul] at hx ⊢
          exact lt_of_le_of_lt (mul_le_of_le_one_left' (hle1 r)) hx }
    have hNJ : N (k + 1) ≤ J := by
      show Ideal.span (b '' Set.Icc (k + 1) n) ⊔ Ideal.span {a} * I ≤ J
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        rintro _ ⟨j, ⟨hj1, hj2⟩, rfl⟩
        show W.valuation (algebraMap E (FractionRing E) (b j)) <
          W.valuation (algebraMap E (FractionRing E) (b k))
        exact lt_of_le_of_lt (hβmono (k + 1) j hj1 hj2) hlt
      · rw [Ideal.mul_le]
        intro r hr s hs
        obtain ⟨x, rfl⟩ := Ideal.mem_span_singleton'.mp hr
        show W.valuation (algebraMap E (FractionRing E) (x * a * s)) <
          W.valuation (algebraMap E (FractionRing E) (b k))
        simp only [map_mul]
        rw [mul_assoc]
        refine lt_of_le_of_lt (mul_le_of_le_one_left' (hle1 x)) ?_
        exact lt_of_le_of_lt (hI' s hs) (lt_of_le_of_lt (hβmono (k + 1) n (by omega) le_rfl) hlt)
    rw [SetLike.lt_iff_le_and_exists]
    refine ⟨?_, b k, ?_, ?_⟩
    · show Ideal.span (b '' Set.Icc (k + 1) n) ⊔ Ideal.span {a} * I ≤
        Ideal.span (b '' Set.Icc k n) ⊔ Ideal.span {a} * I
      exact sup_le_sup_right (Ideal.span_mono (Set.image_mono
        (Set.Icc_subset_Icc_left (by omega)))) _
    · show b k ∈ Ideal.span (b '' Set.Icc k n) ⊔ Ideal.span {a} * I
      exact Submodule.mem_sup_left (Ideal.subset_span ⟨k, ⟨le_rfl, hk.le⟩, rfl⟩)
    · intro h
      have h' : W.valuation (algebraMap E (FractionRing E) (b k)) <
          W.valuation (algebraMap E (FractionRing E) (b k)) := hNJ h
      exact lt_irrefl _ h'
  have hN0 : N 0 = I := by
    show Ideal.span (b '' Set.Icc 0 n) ⊔ Ideal.span {a} * I = I
    have e : Set.Icc 0 n = Set.Iic n := by ext j; simp
    rw [e]
    exact sup_eq_left.mpr (Ideal.mul_le.mpr (fun r _ s hs => I.mul_mem_left r hs))
  have h5 := H5 E n N hchain
  rw [hN0] at h5
  have hsub : Ideal.span {a} * I ≤ N n := by
    show Ideal.span {a} * I ≤ Ideal.span (b '' Set.Icc n n) ⊔ Ideal.span {a} * I
    exact le_sup_right
  have hsurj : Module.length E (E ⧸ N n) ≤ Module.length E (E ⧸ (Ideal.span {a} * I)) :=
    Module.length_le_of_surjective _ (Submodule.factor_surjective hsub)
  have h4 := H4 E a ha I
  have hbn0 : b n ≠ 0 := by
    intro h0
    have hpos : 0 < W.valuation (algebraMap E (FractionRing E) (b n)) := by
      rw [hβeq n le_rfl]
      exact mul_pos hγ (lt_of_lt_of_le hα hwa)
    rw [h0, map_zero, map_zero] at hpos
    exact lt_irrefl _ hpos
  have hfin : Module.length E (E ⧸ I) ≠ ⊤ := by
    have hx := isFiniteLength_quotient_span_singleton E (mem_nonZeroDivisors_of_ne_zero hbn0)
    have hle : Ideal.span {b n} ≤ I :=
      (Ideal.span_singleton_le_iff_mem _).mpr
        (Ideal.subset_span ⟨n, Set.mem_Iic.mpr le_rfl, rfl⟩)
    exact Module.length_ne_top_iff.mpr
      (hx.of_surjective (Submodule.factor_surjective hle))
  have hfinal := h5.trans (hsurj.trans h4.le)
  exact (ENat.add_le_add_iff_right hfin).mp hfinal

theorem wcpa_dj_gcl_dvr_trait_dvr_of_chain_bound : ∀ (E : Type u) [CommRing E] [IsDomain E] [IsNoetherianRing E] [IsLocalRing E] [Ring.KrullDimLE 1 E], ¬ IsField E → ∀ (W : ValuationSubring (FractionRing E)) (hW : ∀ e : E, algebraMap E (FractionRing E) e ∈ W.toSubring), IsLocalHom ((algebraMap E (FractionRing E)).codRestrict W.toSubring hW) → (∀ (a : E), a ≠ 0 → ∀ (n : ℕ) (w : ℕ → FractionRing E), (∀ j ≤ n, w j ∈ W) → (∀ j < n, W.valuation (w (j + 1)) < W.valuation (w j)) → W.valuation (algebraMap E (FractionRing E) a) ≤ W.valuation (w n) → (n : ℕ∞) ≤ Module.length E (E ⧸ Ideal.span {a})) → IsDiscreteValuationRing ↥W.toSubring :=
by
  intro E _ _ _ _ _ hEf W hW hloc Hc
  classical
  haveI hWloc : IsLocalRing ↥W.toSubring := inferInstanceAs (IsLocalRing ↥W)

  have hmax : ∀ J : Ideal ↥W.toSubring, J ≠ ⊥ → ∃ z ∈ J, ∀ z' ∈ J,
      W.valuation (z' : FractionRing E) ≤ W.valuation (z : FractionRing E) := by
    intro J hJ
    obtain ⟨w₀, hw₀J, hw₀ne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hJ
    have hw₀K : (w₀ : FractionRing E) ≠ 0 := fun h => hw₀ne (Subtype.ext h)
    obtain ⟨x, y, hy0, hxy⟩ := IsFractionRing.div_surjective (A := E) (w₀ : FractionRing E)
    have hy : algebraMap E (FractionRing E) y ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hy0
    have hxeq : algebraMap E (FractionRing E) x =
        (w₀ : FractionRing E) * algebraMap E (FractionRing E) y := by
      rw [← hxy, div_mul_cancel₀ _ hy]
    have hx : x ≠ 0 := by
      rintro rfl
      rw [map_zero] at hxeq
      exact (mul_ne_zero hw₀K hy) hxeq.symm
    have hvx : W.valuation (algebraMap E (FractionRing E) x) ≤ W.valuation (w₀ : FractionRing E) := by
      rw [hxeq, Valuation.map_mul]
      exact mul_le_of_le_one_right zero_le' ((W.valuation_le_one_iff _).mpr (hW y))
    have hfin : Module.length E (E ⧸ Ideal.span {x}) ≠ ⊤ :=
      Module.length_ne_top_iff.mpr
        (isFiniteLength_quotient_span_singleton E (mem_nonZeroDivisors_of_ne_zero hx))
    have hbound : ∀ (n : ℕ) (w : ℕ → FractionRing E), (∀ j ≤ n, w j ∈ W) →
        (∀ j < n, W.valuation (w (j + 1)) < W.valuation (w j)) →
        W.valuation (algebraMap E (FractionRing E) x) ≤ W.valuation (w n) →
        n ≤ (Module.length E (E ⧸ Ideal.span {x})).toNat := by
      intro n w h1 h2 h3
      have h4 := Hc x hx n w h1 h2 h3
      rw [← ENat.coe_toNat hfin] at h4
      exact_mod_cast h4
    by_contra hno
    push_neg at hno
    choose nxt hnxtJ hnxt using hno
    let seq : ℕ → {z : ↥W.toSubring // z ∈ J} := fun k =>
      Nat.rec ⟨w₀, hw₀J⟩ (fun _ s => ⟨nxt s.1 s.2, hnxtJ s.1 s.2⟩) k
    have hseq : ∀ k, W.valuation (((seq k).1 : ↥W.toSubring) : FractionRing E) <
        W.valuation (((seq (k + 1)).1 : ↥W.toSubring) : FractionRing E) := fun k =>
      hnxt (seq k).1 (seq k).2
    set L := (Module.length E (E ⧸ Ideal.span {x})).toNat
    have hcon := hbound (L + 1) (fun j => (((seq (L + 1 - j)).1 : ↥W.toSubring) : FractionRing E))
      (fun j _ => (seq (L + 1 - j)).1.2) ?_ ?_
    · omega
    · intro j hj
      have e : L + 1 - j = (L + 1 - (j + 1)) + 1 := by omega
      show W.valuation (((seq (L + 1 - (j + 1))).1 : ↥W.toSubring) : FractionRing E) <
        W.valuation (((seq (L + 1 - j)).1 : ↥W.toSubring) : FractionRing E)
      rw [e]
      exact hseq _
    · show W.valuation (algebraMap E (FractionRing E) x) ≤
        W.valuation (((seq (L + 1 - (L + 1))).1 : ↥W.toSubring) : FractionRing E)
      rw [Nat.sub_self]
      exact hvx

  have hPID : IsPrincipalIdealRing ↥W.toSubring := by
    refine ⟨fun J => ?_⟩
    by_cases hJ : J = ⊥
    · rw [hJ]; exact bot_isPrincipal
    obtain ⟨z, hzJ, hz⟩ := hmax J hJ
    obtain ⟨w, hwJ, hwne⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hJ
    have hzK : (z : FractionRing E) ≠ 0 := by
      intro h0
      have h1 := hz w hwJ
      rw [h0, Valuation.map_zero] at h1
      exact hwne (Subtype.ext ((Valuation.zero_iff _).mp (le_antisymm h1 zero_le')))
    refine ⟨⟨z, ?_⟩⟩
    apply le_antisymm
    · intro z' hz'
      rw [Ideal.submodule_span_eq, Ideal.mem_span_singleton']
      have hq : (z' : FractionRing E) / z ∈ W := by
        apply ValuationSubring.mem_of_valuation_le_one
        rw [Valuation.map_div, div_le_one₀ ((Valuation.pos_iff _).mpr hzK)]
        exact hz z' hz'
      refine ⟨⟨(z' : FractionRing E) / z, hq⟩, Subtype.ext ?_⟩
      show (z' : FractionRing E) / z * z = z'
      exact div_mul_cancel₀ _ hzK
    · rw [Ideal.submodule_span_eq, Ideal.span_singleton_le_iff_mem]
      exact hzJ

  have hmE : IsLocalRing.maximalIdeal E ≠ ⊥ := fun h =>
    hEf ((IsLocalRing.isField_iff_maximalIdeal_eq).mpr h)
  obtain ⟨e, he, hene⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hmE
  have hhe : (algebraMap E (FractionRing E)).codRestrict W.toSubring hW e ≠ 0 := by
    intro h0
    apply hene
    apply IsFractionRing.injective E (FractionRing E)
    rw [map_zero]
    exact congrArg Subtype.val h0
  have hhu : ¬ IsUnit ((algebraMap E (FractionRing E)).codRestrict W.toSubring hW e) := by
    intro hu
    exact mem_nonunits_iff.mp ((IsLocalRing.mem_maximalIdeal _).mp he)
      (IsUnit.of_map ((algebraMap E (FractionRing E)).codRestrict W.toSubring hW) e hu)
  have hmW : IsLocalRing.maximalIdeal ↥W.toSubring ≠ ⊥ := by
    intro h0
    apply hhe
    have h1 : (algebraMap E (FractionRing E)).codRestrict W.toSubring hW e ∈
        IsLocalRing.maximalIdeal ↥W.toSubring :=
      (IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hhu)
    rw [h0] at h1
    exact (Submodule.mem_bot _).mp h1
  exact { toIsPrincipalIdealRing := hPID, toIsLocalRing := hWloc, not_a_field' := hmW }

theorem wcpa_dj_gcl_dvr_trait : ∀ (A : Type u) [CommRing A] [IsNoetherianRing A] (t t' : ↥(Spec (.of A))), t' ⤳ t → t' ≠ t → ∃ (R : Type u) (_ : CommRing R) (_ : IsDomain R) (_ : IsDiscreteValuationRing R) (g : Spec (.of R) ⟶ Spec (.of A)), g (IsLocalRing.closedPoint R) = t ∧ (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ g) (IsLocalRing.closedPoint (FractionRing R)) = t' :=
by
  intro A _ _ t t' hsp hne
  classical
  let t₀ : PrimeSpectrum A := t
  let t₀' : PrimeSpectrum A := t'
  have hsp₀ : t₀' ⤳ t₀ := hsp
  have hle : t₀'.asIdeal ≤ t₀.asIdeal := (PrimeSpectrum.le_iff_specializes t₀' t₀).mpr hsp₀
  have hlt : t₀'.asIdeal < t₀.asIdeal :=
    lt_of_le_of_ne hle (fun h => hne (PrimeSpectrum.ext h))
  obtain ⟨D, _, _, _, _, φ, hDf, hq, hp⟩ :=
    wcpa_dj_gcl_dvr_trait_localize A t₀'.asIdeal t₀.asIdeal hlt
  obtain ⟨B, _, _, _, f, y, hf, hy0, hmy, hyt⟩ := wcpa_dj_gcl_dvr_trait_blowup_chart D hDf
  obtain ⟨E, _, _, _, _, g, hg, hgl, hdim, hEf⟩ :=
    wcpa_dj_gcl_dvr_trait_one_dim_local D B f y hf hy0 hmy hyt
  obtain ⟨W, hW, hloc⟩ := IsLocalRing.exists_factor_valuationRing (algebraMap E (FractionRing E))
  have hchain := wcpa_dj_gcl_dvr_trait_valuation_chain_bound wcpa_dj_gcl_dvr_trait_length_mul
    wcpa_dj_gcl_dvr_trait_length_chain E W (fun e => hW e)
  have hDVR : IsDiscreteValuationRing ↥W.toSubring :=
    wcpa_dj_gcl_dvr_trait_dvr_of_chain_bound E hEf W hW hloc hchain
  set h := (algebraMap E (FractionRing E)).codRestrict W.toSubring hW with hh
  have hhinj : Function.Injective h := fun a b hab =>
    IsFractionRing.injective E (FractionRing E) (congrArg Subtype.val hab)
  set Φ : A →+* ↥W.toSubring := h.comp (g.comp φ) with hΦ
  refine ⟨↥W.toSubring, inferInstance, inferInstance, hDVR, Spec.map (CommRingCat.ofHom Φ), ?_, ?_⟩
  · apply PrimeSpectrum.ext
    change Ideal.comap Φ (IsLocalRing.maximalIdeal ↥W.toSubring) = t₀.asIdeal
    have e1 : Ideal.comap h (IsLocalRing.maximalIdeal ↥W.toSubring) = IsLocalRing.maximalIdeal E :=
      ((IsLocalRing.local_hom_TFAE h).out 1 5).mp hloc
    have e2 : Ideal.comap g (IsLocalRing.maximalIdeal E) = IsLocalRing.maximalIdeal D :=
      ((IsLocalRing.local_hom_TFAE g).out 1 5).mp hgl
    rw [hΦ, ← Ideal.comap_comap, ← Ideal.comap_comap, e1, e2, hq]
  · rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
    apply PrimeSpectrum.ext
    change Ideal.comap ((algebraMap ↥W.toSubring (FractionRing ↥W.toSubring)).comp Φ)
      (IsLocalRing.maximalIdeal (FractionRing ↥W.toSubring)) = t₀'.asIdeal
    have hψ : Function.Injective
        ((algebraMap ↥W.toSubring (FractionRing ↥W.toSubring)).comp (h.comp g)) :=
      (IsFractionRing.injective ↥W.toSubring (FractionRing ↥W.toSubring)).comp (hhinj.comp hg)
    rw [IsLocalRing.maximalIdeal_eq_bot,
      show (algebraMap ↥W.toSubring (FractionRing ↥W.toSubring)).comp Φ =
        ((algebraMap ↥W.toSubring (FractionRing ↥W.toSubring)).comp (h.comp g)).comp φ from rfl,
      ← Ideal.comap_comap, Ideal.comap_bot_of_injective _ hψ, ← RingHom.ker_eq_comap_bot, hp]

theorem wcpa_dj_gcl_special_kernel : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (X : Scheme.{u}) (h : X ⟶ Spec (.of R)), Flat h → ∀ (ϖ : R), Irreducible ϖ → ∀ b : Γ(X, ⊤), (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).appTop.hom b = 0 → ∃ g : Γ(X, ⊤), b = h.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom ϖ) * g :=
by
  have k1 : ∀ (R : Type u) [CommRing R] (X : Scheme.{u}) (h : X ⟶ Spec (.of R)), Flat h → ∀ (c : R), c ∈ nonZeroDivisors R → ∀ (U : X.Opens), IsAffineOpen U → ∀ s : Γ(X, U), (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom (h.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom c)) * s = 0 → s = 0 := by
    intro R _ X h hflat c hc U hU s hs
    haveI := hflat
    have hφ : (h.appLE ⊤ U le_top).hom.Flat :=
      HasRingHomProperty.appLE (P := @Flat) h hflat ⟨⊤, isAffineOpen_top _⟩ ⟨U, hU⟩ le_top
    have e1 : (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
        (h.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom c)) =
        (h.appLE ⊤ U le_top).hom ((Scheme.ΓSpecIso (.of R)).inv.hom c) := rfl
    have hc' : (Scheme.ΓSpecIso (.of R)).inv.hom c ∈ nonZeroDivisors Γ(Spec (.of R), ⊤) := by
      rw [mem_nonZeroDivisors_iff_right]
      intro x hx
      have h1 := congrArg (Scheme.ΓSpecIso (.of R)).hom.hom hx
      rw [map_mul, map_zero] at h1
      have h2 : (Scheme.ΓSpecIso (.of R)).hom.hom ((Scheme.ΓSpecIso (.of R)).inv.hom c) = c := by
        simp
      rw [h2] at h1
      have h3 := (mem_nonZeroDivisors_iff_right.mp hc) _ h1
      have h4 : x = (Scheme.ΓSpecIso (.of R)).inv.hom ((Scheme.ΓSpecIso (.of R)).hom.hom x) := by
        simp
      rw [h4, h3, map_zero]
    letI := (h.appLE ⊤ U le_top).hom.toAlgebra
    haveI : Module.Flat Γ(Spec (.of R), ⊤) Γ(X, U) := hφ
    have hreg := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := Γ(X, U)) hc'
    apply hreg
    show (Scheme.ΓSpecIso (.of R)).inv.hom c • s = (Scheme.ΓSpecIso (.of R)).inv.hom c • (0 : Γ(X, U))
    rw [smul_zero, Algebra.smul_def]
    rw [e1] at hs
    exact hs
  have k3 : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (X : Scheme.{u}) (h : X ⟶ Spec (.of R)) (c : R), IsLocalRing.maximalIdeal R ≤ Ideal.span {c} → ∀ b : Γ(X, ⊤), (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).appTop.hom b = 0 → ∀ (U : X.Opens), IsAffineOpen U → ∃ g : Γ(X, U), (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom b = (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom (h.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom c)) * g := by
    intro R _ _ X h c hle b hb U hU
    have hN : ∀ {A A' : Type u} [CommRing A] [CommRing A'] (f : A →+* A') (a : A),
        (Spec.map (CommRingCat.ofHom f)).appTop.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a) =
          (Scheme.ΓSpecIso (.of A')).inv.hom (f a) := by
      intro A A' _ _ f a
      have e2 := congrArg (fun φ => φ.hom a) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom f))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at e2
      exact e2.symm
    have hF : ∀ x : Γ(X, ⊤), hU.fromSpec.appTop.hom x =
        (Scheme.ΓSpecIso (CommRingCat.of Γ(X, U))).inv.hom
          ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom x) := by
      intro x
      have e := IsAffineOpen.fromSpec_app_of_le hU ⊤ le_top
      have e2 := congrArg (fun φ => φ.hom x) e
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e2
      refine e2.trans ?_
      have hid : ∀ (Y : Scheme.{u}) (f : (⊤ : Y.Opens) ⟶ ⊤) (z : Γ(Y, ⊤)),
          (Y.presheaf.map f.op).hom z = z := by
        intro Y f z
        rw [Subsingleton.elim f (𝟙 _), op_id, Y.presheaf.map_id]
        rfl
      exact hid _ _ _
    have hinj : ∀ (A : Type u) [CommRing A], Function.Injective (Scheme.ΓSpecIso (.of A)).inv.hom := by
      intro A _ x y hxy
      simpa using congrArg (Scheme.ΓSpecIso (.of A)).hom.hom hxy
    set tU := (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom
      (h.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom c)) with htU
    set I : Ideal Γ(X, U) := Ideal.span {tU} with hI
    set q : Γ(X, U) →+* Γ(X, U) ⧸ I := Ideal.Quotient.mk I with hq
    set ψ : R →+* Γ(X, U) ⧸ I := q.comp ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom.comp
      (h.appTop.hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom)) with hψdef
    have hψ : ∀ r ∈ IsLocalRing.maximalIdeal R, ψ r = 0 := by
      intro r hr
      obtain ⟨a, rfl⟩ := Ideal.mem_span_singleton'.mp (hle hr)
      rw [map_mul]
      have : ψ c = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
      rw [this, mul_zero]
    set κ : IsLocalRing.ResidueField R →+* Γ(X, U) ⧸ I :=
      Ideal.Quotient.lift (IsLocalRing.maximalIdeal R) ψ hψ with hκdef
    have hκ : ∀ r, κ (IsLocalRing.residue R r) = ψ r := fun r => Ideal.Quotient.lift_mk _ _ _
    have hw : (Spec.map (CommRingCat.ofHom q) ≫ hU.fromSpec) ≫ h =
        Spec.map (CommRingCat.ofHom κ) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) := by
      apply ext_of_isAffine
      ext x
      obtain ⟨r, rfl⟩ : ∃ r, (Scheme.ΓSpecIso (.of R)).inv.hom r = x :=
        ⟨(Scheme.ΓSpecIso (.of R)).hom.hom x, by simp⟩
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
      rw [hF, hN, hN, hN, hκ]
      rfl
    have hl := Limits.pullback.lift_fst (Spec.map (CommRingCat.ofHom q) ≫ hU.fromSpec)
      (Spec.map (CommRingCat.ofHom κ)) hw
    have e3 := congrArg (fun φ => φ.appTop.hom b) hl
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e3
    rw [hb, map_zero, hF, hN] at e3
    have e4 : q ((X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom b) = 0 :=
      hinj _ (e3.symm.trans (map_zero _).symm)
    obtain ⟨g, hg⟩ := Ideal.mem_span_singleton'.mp (Ideal.Quotient.eq_zero_iff_mem.mp e4)
    exact ⟨g, by rw [← hg, mul_comm]⟩
  have k5 : ∀ (X : Scheme.{u}) (t b : Γ(X, ⊤)), (∀ (U : X.Opens), IsAffineOpen U → ∀ s : Γ(X, U), (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom t * s = 0 → s = 0) → (∀ (U : X.Opens), IsAffineOpen U → ∃ g : Γ(X, U), (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom b = (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op).hom t * g) → ∃ g : Γ(X, ⊤), b = t * g := by
    intro X t b H1 H2
    have rr : ∀ {U V W : X.Opens} (f1 : V ⟶ U) (f2 : W ⟶ V) (f3 : W ⟶ U) (x : Γ(X, U)),
        (X.presheaf.map f2.op).hom ((X.presheaf.map f1.op).hom x) = (X.presheaf.map f3.op).hom x := by
      intro U V W f1 f2 f3 x
      rw [show f3 = f2 ≫ f1 from Subsingleton.elim _ _, op_comp, Functor.map_comp,
        CommRingCat.hom_comp, RingHom.comp_apply]
    have uniq : ∀ (V : X.Opens) (s : Γ(X, V)),
        (X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom t * s = 0 → s = 0 := by
      intro V s hs
      have hcov : V ≤ iSup (fun W : {W : X.affineOpens // (W : X.Opens) ≤ V} => W.1.1) := by
        intro x hx
        show x ∈ iSup (fun W : {W : X.affineOpens // (W : X.Opens) ≤ V} => W.1.1)
        obtain ⟨W, hW, hxW, hWV⟩ :=
          (TopologicalSpace.Opens.isBasis_iff_nbhd.mp (Scheme.isBasis_affineOpens X)) hx
        rw [TopologicalSpace.Opens.mem_iSup]
        exact ⟨⟨⟨W, hW⟩, hWV⟩, hxW⟩
      apply X.sheaf.eq_of_locally_eq' (fun W : {W : X.affineOpens // (W : X.Opens) ≤ V} => W.1.1) V
        (fun W => homOfLE W.2) hcov s 0
      intro W
      change (X.presheaf.map (homOfLE W.2).op).hom s = (X.presheaf.map (homOfLE W.2).op).hom 0
      rw [map_zero]
      apply H1 W.1.1 W.1.2
      have := congrArg (X.presheaf.map (homOfLE W.2).op).hom hs
      rw [map_mul, map_zero, rr _ _ (homOfLE (le_top : W.1.1 ≤ ⊤))] at this
      exact this
    choose g hg using fun (W : X.affineOpens) => H2 W.1 W.2
    have hcov : (⊤ : X.Opens) ≤ iSup (fun W : X.affineOpens => W.1) :=
      (iSup_affineOpens_eq_top X).ge
    have hcomp : TopCat.Presheaf.IsCompatible X.sheaf.obj (fun W : X.affineOpens => W.1) g := by
      intro i j
      change (X.presheaf.map (TopologicalSpace.Opens.infLELeft i.1 j.1).op).hom (g i) =
        (X.presheaf.map (TopologicalSpace.Opens.infLERight i.1 j.1).op).hom (g j)
      have e1 := congrArg (X.presheaf.map (TopologicalSpace.Opens.infLELeft i.1 j.1).op).hom (hg i)
      have e2 := congrArg (X.presheaf.map (TopologicalSpace.Opens.infLERight i.1 j.1).op).hom (hg j)
      rw [map_mul, rr _ _ (homOfLE (le_top : i.1 ⊓ j.1 ≤ ⊤)),
        rr _ _ (homOfLE (le_top : i.1 ⊓ j.1 ≤ ⊤))] at e1 e2
      rw [← sub_eq_zero]
      apply uniq
      rw [mul_sub, ← e1, ← e2, sub_self]
    obtain ⟨G0, hG, -⟩ := X.sheaf.existsUnique_gluing' (fun W : X.affineOpens => W.1) ⊤
      (fun i => homOfLE le_top) hcov g hcomp
    let G : Γ(X, ⊤) := G0
    refine ⟨G, ?_⟩
    apply X.sheaf.eq_of_locally_eq' (fun W : X.affineOpens => W.1) ⊤ (fun i => homOfLE le_top) hcov
    intro i
    change (X.presheaf.map (homOfLE (le_top : i.1 ≤ ⊤)).op).hom b =
      (X.presheaf.map (homOfLE (le_top : i.1 ≤ ⊤)).op).hom (t * G)
    have := hG i
    change (X.presheaf.map (homOfLE (le_top : i.1 ≤ ⊤)).op).hom G = g i at this
    rw [map_mul, this]
    exact hg i
  intro R _ _ _ X h hflat ϖ hϖ b hb
  have hle : IsLocalRing.maximalIdeal R ≤ Ideal.span {ϖ} := (Irreducible.maximalIdeal_eq hϖ).le
  have hnz : ϖ ∈ nonZeroDivisors R := mem_nonZeroDivisors_of_ne_zero hϖ.ne_zero
  exact k5 X _ b (k1 R X h hflat ϖ hnz) (k3 R X h ϖ hle b hb)

theorem wcpa_dj_gcl_special_sections_residue : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (X : Scheme.{u}) (h : X ⟶ Spec (.of R)), IsProper h → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ι : IsLocalRing.ResidueField R →+* Ω), ConnectedSpace ↥(Limits.pullback h (Spec.map (CommRingCat.ofHom ι) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) → AlgebraicGeometry.IsReduced (Limits.pullback h (Spec.map (CommRingCat.ofHom ι) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) → ∀ c : Γ(Limits.pullback h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))), ⊤), ∃ r : R, c = (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).appTop.hom ((Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField R))).inv.hom (IsLocalRing.residue R r)) :=
by

  have L4 : ∀ (k M W : Type u) [Field k] [CommRing M] [CommRing W] [Algebra k M] [Algebra k W],
      Nontrivial W → (∀ m : M, ∃ ω : W, m ⊗ₜ[k] (1 : W) = (1 : M) ⊗ₜ[k] ω) →
      Function.Surjective (algebraMap k M) := by
    intro k M W _ _ _ _ _ _ H
    intro m
    by_contra hm
    push_neg at hm
    set S := LinearMap.range (Algebra.linearMap k M) with hS
    have hmS : m ∉ S := by
      rintro ⟨a, ha⟩; exact hm a ha
    have h1S : (1 : M) ∈ S := ⟨1, by simp⟩
    have hπm : S.mkQ m ≠ 0 := by
      rw [Submodule.mkQ_apply, Ne, Submodule.Quotient.mk_eq_zero]; exact hmS
    obtain ⟨φ, hφ⟩ : ∃ φ : Module.Dual k (M ⧸ S), φ (S.mkQ m) ≠ 0 := by
      by_contra hc; push_neg at hc
      exact hπm ((Module.forall_dual_apply_eq_zero_iff k _).mp hc)
    set lam := φ ∘ₗ S.mkQ with hlam
    have hl1 : lam 1 = 0 := by
      rw [hlam, LinearMap.comp_apply, Submodule.mkQ_apply,
        (Submodule.Quotient.mk_eq_zero S).mpr h1S, map_zero]
    obtain ⟨ω, hω⟩ := H m
    have h2 := congrArg ((TensorProduct.lid k W).toLinearMap ∘ₗ (LinearMap.rTensor W lam)) hω
    simp only [LinearMap.comp_apply, LinearMap.rTensor_tmul, TensorProduct.lid_tmul, hl1,
      zero_smul] at h2
    have hc : lam m ≠ 0 := hφ
    apply one_ne_zero (α := W)
    have h3 := congrArg (fun x => (lam m)⁻¹ • x) h2
    simpa [smul_smul, inv_mul_cancel₀ hc] using h3

  have L2 : ∀ (Ω C : Type u) [Field Ω] [IsAlgClosed Ω] [CommRing C], _root_.IsReduced C →
      Nontrivial C → ∀ (σ : Ω →+* C), σ.IsIntegral → (∀ e : C, e * e = e → e = 0 ∨ e = 1) →
      Function.Surjective σ := by
    intro Ω C _ _ _ _ _ σ hσ hid
    letI := σ.toAlgebra
    intro x
    have hx : IsIntegral Ω x := hσ x
    have hμm : (minpoly Ω x).Monic := minpoly.monic hx
    have hμ0 : minpoly Ω x ≠ 0 := minpoly.ne_zero hx
    have hdeg : 0 < (minpoly Ω x).natDegree := minpoly.natDegree_pos hx
    obtain ⟨a, ha⟩ := IsAlgClosed.exists_root (minpoly Ω x)
      (by rw [Polynomial.degree_eq_natDegree hμ0]; exact_mod_cast hdeg.ne')
    have hfac := Polynomial.pow_mul_divByMonic_rootMultiplicity_eq (minpoly Ω x) a
    have hqa := Polynomial.eval_divByMonic_pow_rootMultiplicity_ne_zero a hμ0
    have hm : 0 < (minpoly Ω x).rootMultiplicity a :=
      (Polynomial.rootMultiplicity_pos hμ0).mpr ha
    set m := (minpoly Ω x).rootMultiplicity a with hmdef
    set q := minpoly Ω x /ₘ (Polynomial.X - Polynomial.C a) ^ m with hqdef
    have hcop : IsCoprime (Polynomial.X - Polynomial.C a) q := by
      rw [Irreducible.coprime_iff_not_dvd (Polynomial.irreducible_X_sub_C a),
        Polynomial.dvd_iff_isRoot]
      exact hqa
    obtain ⟨u, v, huv⟩ := hcop.pow_left (m := m)
    have h1 : Polynomial.aeval x ((Polynomial.X - Polynomial.C a) ^ m) *
        Polynomial.aeval x q = 0 := by
      rw [← map_mul, hfac]; exact minpoly.aeval Ω x
    have h2 : Polynomial.aeval x u * Polynomial.aeval x ((Polynomial.X - Polynomial.C a) ^ m) +
        Polynomial.aeval x v * Polynomial.aeval x q = 1 := by
      rw [← map_mul, ← map_mul, ← map_add, huv, map_one]
    set A := Polynomial.aeval x ((Polynomial.X - Polynomial.C a) ^ m) with hA
    set Q := Polynomial.aeval x q with hQ
    set U := Polynomial.aeval x u
    set V := Polynomial.aeval x v
    have hidem : (V * Q) * (V * Q) = V * Q := by
      linear_combination (V * Q) * h2 - (U * V) * h1
    rcases hid _ hidem with h0 | h1'
    · exfalso
      have hQ0 : Q = 0 := by linear_combination U * h1 + Q * h0 - Q * h2
      have hpm : ((Polynomial.X - Polynomial.C a) ^ m).Monic := (Polynomial.monic_X_sub_C a).pow m
      have hqm : q.Monic := Polynomial.Monic.of_mul_monic_left hpm (by rw [hfac]; exact hμm)
      have hle := minpoly.min Ω x hqm hQ0
      have hnd : (minpoly Ω x).natDegree = m + q.natDegree := by
        rw [← hfac, hpm.natDegree_mul hqm, Polynomial.natDegree_pow, Polynomial.natDegree_X_sub_C,
          mul_one]
      have hle' : (minpoly Ω x).natDegree ≤ q.natDegree :=
        Polynomial.natDegree_le_natDegree hle
      omega
    · have hA0 : A = 0 := by linear_combination V * h1 - A * h1'
      have hA' : A = (x - σ a) ^ m := by
        rw [hA]; simp [RingHom.algebraMap_toAlgebra]
      rw [hA'] at hA0
      have hn : IsNilpotent (x - σ a) := ⟨m, hA0⟩
      exact ⟨a, (sub_eq_zero.mp hn.eq_zero).symm⟩

  have L1 : ∀ (Y : Scheme.{u}), AlgebraicGeometry.IsReduced Y → ConnectedSpace ↥Y →
      ∀ e : Γ(Y, ⊤), e * e = e → e = 0 ∨ e = 1 := by
    intro Y _ _ e he
    have hdisj : Y.basicOpen e ⊓ Y.basicOpen (1 - e) = ⊥ := by
      rw [← Scheme.basicOpen_mul, mul_sub, mul_one, he, sub_self, Scheme.basicOpen_zero]
    have hcov : ∀ y : Y, y ∈ Y.basicOpen e ∨ y ∈ Y.basicOpen (1 - e) := by
      intro y
      have hy : y ∈ (⊤ : Y.Opens) := trivial
      rw [Scheme.mem_basicOpen _ _ _ hy, Scheme.mem_basicOpen _ _ _ hy, map_sub, map_one]
      exact IsLocalRing.isUnit_or_isUnit_one_sub_self _
    have hcompl : (Y.basicOpen e : Set Y)ᶜ = Y.basicOpen (1 - e) := by
      ext y; constructor
      · intro hy; exact (hcov y).resolve_left hy
      · intro hy hy'
        have : y ∈ Y.basicOpen e ⊓ Y.basicOpen (1 - e) := ⟨hy', hy⟩
        rw [hdisj] at this; exact this
    have hclo : IsClopen (Y.basicOpen e : Set Y) :=
      ⟨by rw [← isOpen_compl_iff, hcompl]; exact (Y.basicOpen _).isOpen, (Y.basicOpen e).isOpen⟩
    rcases isClopen_iff.mp hclo with h | h
    · left
      rw [← basicOpen_eq_bot_iff]
      exact TopologicalSpace.Opens.coe_eq_empty.mp h
    · right
      have h2 : (Y.basicOpen (1 - e) : Set Y) = ∅ := by rw [← hcompl, h, Set.compl_univ]
      have h3 : 1 - e = 0 := by
        rw [← basicOpen_eq_bot_iff]
        exact TopologicalSpace.Opens.coe_eq_empty.mp h2
      exact (sub_eq_zero.mp h3).symm

  have L3 : ∀ (k Ω : Type u) [Field k] [Field Ω] (ι : k →+* Ω) (Z W : Scheme.{u})
      (p : Z ⟶ Spec (.of k)) (g : W ⟶ Z) (q : W ⟶ Spec (.of Ω)), QuasiCompact p →
      QuasiSeparated p → IsPullback g q p (Spec.map (CommRingCat.ofHom ι)) →
      Function.Surjective (q.appTop.hom.comp (Scheme.ΓSpecIso (.of Ω)).inv.hom) →
      letI := (p.appTop.hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom).toAlgebra; letI := ι.toAlgebra;
      ∀ m : Γ(Z, ⊤), ∃ ω : Ω, m ⊗ₜ[k] (1 : Ω) = (1 : Γ(Z, ⊤)) ⊗ₜ[k] ω := by
    intro k Ω _ _ ι Z W p g q _ _ H hs
    letI := (p.appTop.hom.comp (Scheme.ΓSpecIso (.of k)).inv.hom).toAlgebra
    letI := ι.toAlgebra
    intro m
    haveI : Flat (Spec.map (CommRingCat.ofHom ι)) := inferInstance
    have hUST : (⊤ : (Spec (.of Ω)).Opens) ≤ Spec.map (CommRingCat.ofHom ι) ⁻¹ᵁ ⊤ := le_top
    have hUSX : (⊤ : Z.Opens) ≤ p ⁻¹ᵁ ⊤ := le_top
    have hUY : (⊤ : W.Opens) = g ⁻¹ᵁ ⊤ ⊓ q ⁻¹ᵁ ⊤ := by simp
    haveI : CompactSpace Z := QuasiCompact.compactSpace_of_compactSpace p
    haveI : QuasiSeparatedSpace Z := quasiSeparatedSpace_of_quasiSeparated p
    haveI hiso : IsIso (pushoutSection H hUST hUSX hUY) :=
      isIso_pushoutSection_of_isQuasiSeparated_of_flat_right H hUST hUSX hUY
        (isAffineOpen_top _) (isAffineOpen_top _)
        (by rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ)
        (by rw [TopologicalSpace.Opens.coe_top]; exact isQuasiSeparated_univ)
    have hinl : Limits.pushout.inl _ _ ≫ pushoutSection H hUST hUSX hUY = g.appTop :=
      (Limits.pushout.inl_desc _ _ _).trans (Scheme.Hom.appLE_eq_app g)
    have hinr : Limits.pushout.inr _ _ ≫ pushoutSection H hUST hUSX hUY = q.appTop :=
      (Limits.pushout.inr_desc _ _ _).trans (Scheme.Hom.appLE_eq_app q)
    have e1 : p.appLE ⊤ ⊤ hUSX = p.appTop := Scheme.Hom.appLE_eq_app p
    have e2 : (Spec.map (CommRingCat.ofHom ι)).appLE ⊤ ⊤ hUST =
        (Spec.map (CommRingCat.ofHom ι)).appTop := Scheme.Hom.appLE_eq_app _
    have compat : p.appLE ⊤ ⊤ hUSX ≫
        CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := k) (A := Γ(Z, ⊤))
          (B := Ω)) =
        (Spec.map (CommRingCat.ofHom ι)).appLE ⊤ ⊤ hUST ≫ (Scheme.ΓSpecIso (.of Ω)).hom ≫
          CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := k) (A := Γ(Z, ⊤))
            (B := Ω)).toRingHom := by
      rw [e1, e2]
      ext x
      have n1 := congrArg (fun φ => φ.hom x) (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom ι))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at n1 ⊢
      rw [n1]
      have n2 : p.appTop.hom x = algebraMap k Γ(Z, ⊤) ((Scheme.ΓSpecIso (.of k)).hom.hom x) := by
        rw [RingHom.algebraMap_toAlgebra, RingHom.comp_apply]
        simp
      rw [n2]
      exact Algebra.TensorProduct.tmul_one_eq_one_tmul _
    set D := Limits.pushout.desc _ _ compat with hD
    have eL : g.appTop ≫ inv (pushoutSection H hUST hUSX hUY) ≫ D =
        CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := k) (A := Γ(Z, ⊤))
          (B := Ω)) := by
      rw [← hinl, Category.assoc, IsIso.hom_inv_id_assoc, hD, Limits.pushout.inl_desc]
    have eR : q.appTop ≫ inv (pushoutSection H hUST hUSX hUY) ≫ D =
        (Scheme.ΓSpecIso (.of Ω)).hom ≫
          CommRingCat.ofHom (Algebra.TensorProduct.includeRight (R := k) (A := Γ(Z, ⊤))
            (B := Ω)).toRingHom := by
      rw [← hinr, Category.assoc, IsIso.hom_inv_id_assoc, hD, Limits.pushout.inr_desc]
    obtain ⟨ω, hω⟩ := hs (g.appTop.hom m)
    refine ⟨ω, ?_⟩
    have f1 := congrArg (fun φ => φ.hom m) eL
    have f2 := congrArg (fun φ => φ.hom ((Scheme.ΓSpecIso (.of Ω)).inv.hom ω)) eR
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at f1 f2 hω
    rw [hω, f1] at f2
    simpa using f2

  intro R _ _ _ X h hprop Ω _ _ ι hconn hred
  classical
  haveI := hprop
  set sR := Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) with hsR
  set sΩ := Spec.map (CommRingCat.ofHom ι) with hsΩ
  set p := Limits.pullback.snd h sR with hp
  set fW := Limits.pullback.fst h (sΩ ≫ sR) with hfW
  set qW := Limits.pullback.snd h (sΩ ≫ sR) with hqW
  have w : fW ≫ h = (qW ≫ sΩ) ≫ sR := by
    rw [Category.assoc]; exact Limits.pullback.condition
  set g := Limits.pullback.lift fW (qW ≫ sΩ) w with hg
  have hsq : IsPullback g qW p sΩ := by
    refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _) (IsPullback.of_hasPullback h sR)
    rw [Limits.pullback.lift_fst]
    exact IsPullback.of_hasPullback h (sΩ ≫ sR)
  haveI hpP : IsProper p :=
    MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback h sR) hprop
  haveI hqP : IsProper qW :=
    MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback h (sΩ ≫ sR)) hprop
  have Γsurj : Function.Surjective (Scheme.ΓSpecIso (.of Ω)).inv.hom := by
    intro x
    exact ⟨(Scheme.ΓSpecIso (.of Ω)).hom.hom x, by simp⟩
  set σ := qW.appTop.hom.comp (Scheme.ΓSpecIso (.of Ω)).inv.hom with hσ
  have hσint : σ.IsIntegral :=
    RingHom.IsIntegral.trans _ _ (RingHom.isIntegral_of_surjective _ Γsurj)
      (isIntegral_appTop_of_universallyClosed qW)
  have hNred : _root_.IsReduced Γ(Limits.pullback h (sΩ ≫ sR), ⊤) :=
    IsReduced.component_reduced ⊤
  have hNnt : Nontrivial Γ(Limits.pullback h (sΩ ≫ sR), ⊤) := by
    obtain ⟨z⟩ := hconn.toNonempty
    exact @Scheme.component_nontrivial (Limits.pullback h (sΩ ≫ sR)) ⊤ ⟨⟨z, trivial⟩⟩
  have hσs : Function.Surjective σ := L2 Ω _ hNred hNnt σ hσint (L1 _ hred hconn)
  have hT := L3 (IsLocalRing.ResidueField R) Ω ι _ _ p g qW inferInstance inferInstance hsq hσs
  letI := (p.appTop.hom.comp (Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField R))).inv.hom).toAlgebra
  letI := ι.toAlgebra
  have hsurj := L4 (IsLocalRing.ResidueField R) Γ(Limits.pullback h sR, ⊤) Ω inferInstance hT
  intro c
  obtain ⟨κ, hκ⟩ := hsurj c
  obtain ⟨r, hr⟩ := IsLocalRing.residue_surjective κ
  refine ⟨r, ?_⟩
  rw [hr, ← hκ, RingHom.algebraMap_toAlgebra, RingHom.comp_apply]

theorem wcpa_dj_gcl_dvr_geom_connected : ∀ (R : Type u) [CommRing R] [IsDomain R] [IsDiscreteValuationRing R] (X : Scheme.{u}) (h : X ⟶ Spec (.of R)), Flat h → IsProper h → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (ι : IsLocalRing.ResidueField R →+* Ω), ConnectedSpace ↥(Limits.pullback h (Spec.map (CommRingCat.ofHom ι) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) → AlgebraicGeometry.IsReduced (Limits.pullback h (Spec.map (CommRingCat.ofHom ι) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) → GeometricallyConnected (Limits.pullback.snd h (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))))) :=
by
  intro R _ _ _ X h hflat hprop Ω _ _ ι hconn hred
  classical
  haveI := hflat
  haveI := hprop
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R

  have Γsurj : ∀ (T : Type u) [CommRing T], Function.Surjective (Scheme.ΓSpecIso (.of T)).inv.hom := by
    intro T _ x
    exact ⟨(Scheme.ΓSpecIso (.of T)).hom.hom x, by simp⟩

  have sq : ∀ {T : Type u} [CommRing T] (f : R →+* T) {Y : Scheme.{u}} (a : Y ⟶ X)
      (b : Y ⟶ Spec (.of T)), a ≫ h = b ≫ Spec.map (CommRingCat.ofHom f) → ∀ r : R,
      a.appTop.hom (h.appTop.hom ((Scheme.ΓSpecIso (.of R)).inv.hom r)) =
        b.appTop.hom ((Scheme.ΓSpecIso (.of T)).inv.hom (f r)) := by
    intro T _ f Y a b hab r
    have e1 := congrArg (fun φ => (Scheme.Hom.appTop φ).hom ((Scheme.ΓSpecIso (.of R)).inv.hom r)) hab
    have e2 := congrArg (fun φ => φ.hom r) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom f))
    simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply,
      CommRingCat.hom_ofHom] at e1 e2
    rw [e1, e2]

  let θ : R →+* Γ(X, ⊤) := h.appTop.hom.comp (Scheme.ΓSpecIso (.of R)).inv.hom
  have hθint : θ.IsIntegral :=
    RingHom.IsIntegral.trans _ _ (RingHom.isIntegral_of_surjective _ (Γsurj R))
      (isIntegral_appTop_of_universallyClosed h)

  have hRC : ∀ b : Γ(X, ⊤), ∃ (r : R) (g : Γ(X, ⊤)), b = θ r + θ ϖ * g := by
    intro b
    obtain ⟨r, hr⟩ := wcpa_dj_gcl_special_sections_residue R X h hprop Ω ι hconn hred
      ((Limits.pullback.fst h (Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))).appTop.hom b)
    have key := sq (IsLocalRing.residue R) (Limits.pullback.fst h _) (Limits.pullback.snd h _)
      Limits.pullback.condition r
    obtain ⟨g, hg⟩ := wcpa_dj_gcl_special_kernel R X h hflat ϖ hϖ (b - θ r) (by
      rw [map_sub, hr]
      exact sub_eq_zero.mpr key.symm)
    refine ⟨r, g, ?_⟩
    have hg' : θ ϖ * g = b - θ r := hg.symm
    rw [hg']
    ring

  have c4 : ∀ (L : Type u) [Field L] (j : R →+* L), Function.Injective j →
      Flat (Spec.map (CommRingCat.ofHom j)) := by
    intro L _ j hj
    rw [HasRingHomProperty.Spec_iff (P := @Flat)]
    letI := j.toAlgebra
    rw [CommRingCat.hom_ofHom, show j = algebraMap R L from rfl, RingHom.flat_algebraMap_iff,
      IsDedekindDomain.flat_iff_torsion_eq_bot, eq_bot_iff]
    intro x hx
    obtain ⟨a, ha⟩ := (Submodule.mem_torsion_iff x).mp hx
    rw [Submodule.mem_bot]
    rw [Submonoid.smul_def, Algebra.smul_def] at ha
    have ha0 : algebraMap R L (a : R) ≠ 0 := fun h0 =>
      (nonZeroDivisors.coe_ne_zero a) (hj (h0.trans (map_zero j).symm))
    exact (mul_eq_zero.mp ha).resolve_left ha0
  have c7 : ∀ (W' : Scheme.{u}), Nonempty W' → (∀ e : Γ(W', ⊤), e * e = e → e = 0 ∨ e = 1) →
      ConnectedSpace W' := by
    intro W' hne hidem
    have sub_of_bot : ∀ U : W'.Opens, U = ⊥ → Subsingleton Γ(W', U) := fun U hU =>
      CommRingCat.subsingleton_of_isTerminal (W'.sheaf.isTerminalOfEqEmpty hU)
    have empty_of_sub : ∀ U : W'.Opens, Subsingleton Γ(W', U) → (U : Set W') = ∅ := by
      intro U hU
      by_contra hc
      haveI : Nonempty U := (Set.nonempty_iff_ne_empty.mpr hc).to_subtype
      haveI := W'.component_nontrivial U
      exact false_of_nontrivial_of_subsingleton Γ(W', U)
    rw [connectedSpace_iff_clopen]
    refine ⟨hne, ?_⟩
    intro s hs
    let U : W'.Opens := ⟨s, hs.isOpen⟩
    let V : W'.Opens := ⟨sᶜ, hs.compl.isOpen⟩
    let 𝒰 : Bool → W'.Opens := fun b => bif b then U else V
    have hdisj : ∀ i k : Bool, i ≠ k → 𝒰 i ⊓ 𝒰 k = ⊥ := by
      intro i k hik
      cases i <;> cases k <;> simp at hik <;> ext x <;> simp [𝒰, U, V]
    have hcov : (⊤ : W'.Opens) ≤ iSup 𝒰 := by
      intro x _
      show x ∈ iSup 𝒰
      rw [TopologicalSpace.Opens.mem_iSup]
      by_cases hx : x ∈ s
      · exact ⟨true, hx⟩
      · exact ⟨false, hx⟩
    let sf : (i : Bool) → ToType (W'.sheaf.obj.obj (Opposite.op (𝒰 i))) := fun b =>
      match b with
      | true => (1 : Γ(W', U))
      | false => (0 : Γ(W', V))
    have hcomp : TopCat.Presheaf.IsCompatible W'.sheaf.obj 𝒰 sf := by
      intro i k
      by_cases hik : i = k
      · subst hik
        have : TopologicalSpace.Opens.infLELeft (𝒰 i) (𝒰 i) =
            TopologicalSpace.Opens.infLERight (𝒰 i) (𝒰 i) := Subsingleton.elim _ _
        rw [this]
      · exact @Subsingleton.elim _ (sub_of_bot _ (hdisj i k hik)) _ _
    obtain ⟨ε, hε, -⟩ := W'.sheaf.existsUnique_gluing' 𝒰 ⊤ (fun i => homOfLE le_top) hcov sf hcomp
    have hidε : ε * ε = ε := by
      apply W'.sheaf.eq_of_locally_eq' 𝒰 ⊤ (fun i => homOfLE le_top) hcov
      intro i
      rw [map_mul, hε i]
      cases i
      · show (0 : Γ(W', V)) * 0 = 0
        exact mul_zero _
      · show (1 : Γ(W', U)) * 1 = 1
        exact mul_one _
    have h01 : ε = 0 ∨ ε = 1 := hidem ε hidε
    rcases h01 with h0 | h1
    · left
      have h2 := hε true
      rw [h0, map_zero] at h2
      haveI : Subsingleton Γ(W', U) := subsingleton_of_zero_eq_one h2
      exact empty_of_sub U this
    · right
      have h2 := hε false
      rw [h1, map_one] at h2
      haveI : Subsingleton Γ(W', V) := subsingleton_of_zero_eq_one h2.symm
      have := empty_of_sub V this
      exact Set.compl_empty_iff.mp this


  refine ⟨?_⟩
  intro K' _ y W fst snd hpb
  let L := AlgebraicClosure K'
  let lam : K' →+* L := algebraMap K' L
  let γ := Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))
  let q := Limits.pullback.fst snd (Spec.map (CommRingCat.ofHom lam))
  let S' := Limits.pullback.snd snd (Spec.map (CommRingCat.ofHom lam))
  haveI hqs : Surjective q :=
    MorphismProperty.of_isPullback (P := @Surjective) (IsPullback.of_hasPullback _ _).flip
      inferInstance
  suffices hW' : ConnectedSpace ↥(Limits.pullback snd (Spec.map (CommRingCat.ofHom lam))) by
    exact Function.Surjective.connectedSpace q.surjective q.continuous
  let ψ : FractionRing R →+* K' := (Spec.preimage y).hom
  let j : R →+* L := (lam.comp ψ).comp (algebraMap R (FractionRing R))
  have hj : Function.Injective j :=
    (lam.comp ψ).injective.comp (IsFractionRing.injective R (FractionRing R))
  have hSj : Spec.map (CommRingCat.ofHom j) = Spec.map (CommRingCat.ofHom lam) ≫ y ≫ γ := by
    simp only [j, ψ, γ, CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom,
      Spec.map_preimage, Category.assoc]
  let F' := (q ≫ fst) ≫ Limits.pullback.fst h γ
  have hP : IsPullback F' S' h (Spec.map (CommRingCat.ofHom j)) := by
    rw [hSj, ← Category.assoc]
    exact ((IsPullback.of_hasPullback snd (Spec.map (CommRingCat.ofHom lam))).paste_horiz
      hpb).paste_horiz (IsPullback.of_hasPullback h γ)

  have c1 : ∀ χ χ' : Γ(X, ⊤) →+* L, χ.comp θ = j → χ'.comp θ = j → χ = χ' := by
    intro χ χ' hχ hχ'
    letI : Algebra R L := j.toAlgebra
    have hjalg : algebraMap R L = j := rfl
    have hint : ∀ (ψ : Γ(X, ⊤) →+* L), ψ.comp θ = j → ∀ y : Γ(X, ⊤), IsIntegral R (ψ y) := by
      intro ψ hψ y
      obtain ⟨p, hp, hpy⟩ := hθint y
      refine ⟨p, hp, ?_⟩
      rw [hjalg, ← hψ, ← Polynomial.hom_eval₂, hpy, map_zero]
    have hiter : ∀ (a : Γ(X, ⊤)) (n : ℕ), ∃ (s : R) (y : Γ(X, ⊤)), a = θ s + θ ϖ ^ n * y := by
      intro a n
      induction n with
      | zero => exact ⟨0, a, by simp⟩
      | succ n ih =>
        obtain ⟨s, y, hy⟩ := ih
        obtain ⟨r, g, hg⟩ := hRC y
        refine ⟨s + ϖ ^ n * r, g, ?_⟩
        rw [hy, hg, map_add, map_mul, map_pow]
        ring
    have hϖ0 : j ϖ ≠ 0 := by
      intro h0
      apply hϖ.ne_zero
      apply hj
      rw [h0, map_zero]
    have hnot : ¬ IsIntegral R (j ϖ)⁻¹ := by
      intro hz
      have hinjK : Function.Injective (algebraMap R L) := hj
      let g : FractionRing R →ₐ[R] L :=
        IsFractionRing.liftAlgHom (K := FractionRing R) (g := Algebra.ofId R L) hinjK
      have hg : g (algebraMap R (FractionRing R) ϖ)⁻¹ = (j ϖ)⁻¹ := by
        rw [map_inv₀, AlgHom.commutes]
        rfl
      rw [← hg, isIntegral_algHom_iff g g.toRingHom.injective] at hz
      obtain ⟨y, hy⟩ := IsIntegrallyClosed.isIntegral_iff.mp hz
      apply hϖ.not_isUnit
      have hϖK : algebraMap R (FractionRing R) ϖ ≠ 0 := by
        rw [ne_eq, ← map_zero (algebraMap R (FractionRing R))]
        exact fun h0 => hϖ.ne_zero (IsFractionRing.injective R (FractionRing R) h0)
      have h1 : algebraMap R (FractionRing R) (ϖ * y) = algebraMap R (FractionRing R) 1 := by
        rw [map_mul, hy, map_one, mul_inv_cancel₀ hϖK]
      exact IsUnit.of_mul_eq_one y (IsFractionRing.injective R (FractionRing R) h1)
    apply RingHom.ext
    intro a
    by_contra hne
    have hδ : χ a - χ' a ≠ 0 := sub_ne_zero.mpr hne
    have hdiv : ∀ n : ℕ, ∃ e : L, IsIntegral R e ∧ χ a - χ' a = j ϖ ^ n * e := by
      intro n
      obtain ⟨s, y, hy⟩ := hiter a n
      refine ⟨χ y - χ' y, (hint χ hχ y).sub (hint χ' hχ' y), ?_⟩
      have e1 : χ (θ s) = j s := by rw [← hχ]; rfl
      have e2 : χ' (θ s) = j s := by rw [← hχ']; rfl
      have e3 : χ (θ ϖ) = j ϖ := by rw [← hχ]; rfl
      have e4 : χ' (θ ϖ) = j ϖ := by rw [← hχ']; rfl
      rw [hy, map_add, map_add, map_mul, map_mul, map_pow, map_pow, e1, e2, e3, e4]
      ring
    obtain ⟨e0, he0, he0eq⟩ := hdiv 0
    have hδint : IsIntegral R (χ a - χ' a) := by rw [he0eq, pow_zero, one_mul]; exact he0
    obtain ⟨c, hc0, hcint⟩ := (hδint.isAlgebraic.inv).exists_integral_multiple
    obtain ⟨m, u, hcu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hc0 hϖ
    obtain ⟨e, he, heq⟩ := hdiv (m + 1)
    have he0' : e ≠ 0 := by
      intro h0; rw [h0, mul_zero] at heq; exact hδ heq
    have hne' : j ϖ ^ m * e ≠ 0 := mul_ne_zero (pow_ne_zero _ hϖ0) he0'
    have hu : j (↑u⁻¹ : R) * j (↑u : R) = 1 := by
      rw [← map_mul, Units.inv_mul, map_one]
    have hkey : (j ϖ)⁻¹ = j (↑u⁻¹ : R) * ((c • (χ a - χ' a)⁻¹) * e) := by
      rw [Algebra.smul_def, hjalg, hcu, heq, map_mul, map_pow]
      calc (j ϖ)⁻¹ = (j ϖ ^ m * e) * (j ϖ ^ m * e * j ϖ)⁻¹ := by
            rw [mul_inv (j ϖ ^ m * e), ← mul_assoc, mul_inv_cancel₀ hne', one_mul]
        _ = (j (↑u⁻¹ : R) * j (↑u : R)) * ((j ϖ ^ m * e) * (j ϖ ^ m * e * j ϖ)⁻¹) := by
            rw [hu, one_mul]
        _ = _ := by rw [pow_succ]; ring
    apply hnot
    rw [hkey]
    exact (isIntegral_algebraMap).mul (hcint.mul he)

  haveI : Flat (Spec.map (CommRingCat.ofHom j)) := c4 L j hj
  have hUST : (⊤ : (Spec (.of L)).Opens) ≤ Spec.map (CommRingCat.ofHom j) ⁻¹ᵁ ⊤ := le_top
  have hUSX : (⊤ : X.Opens) ≤ h ⁻¹ᵁ ⊤ := le_top
  have hUY : (⊤ : (Limits.pullback snd (Spec.map (CommRingCat.ofHom lam))).Opens) =
      F' ⁻¹ᵁ ⊤ ⊓ S' ⁻¹ᵁ ⊤ := by simp
  haveI : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace h
  haveI : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated h
  haveI hiso2 : IsIso (pushoutSection hP hUST hUSX hUY) :=
    isIso_pushoutSection_of_isQuasiSeparated_of_flat_right hP hUST hUSX hUY
      (isAffineOpen_top _) (isAffineOpen_top _)
      (by rw [TopologicalSpace.Opens.coe_top]; exact isCompact_univ)
      (by rw [TopologicalSpace.Opens.coe_top]; exact isQuasiSeparated_univ)
  have hinl : Limits.pushout.inl _ _ ≫ pushoutSection hP hUST hUSX hUY = F'.appTop :=
    (Limits.pushout.inl_desc _ _ _).trans (Scheme.Hom.appLE_eq_app F')
  have hinr : Limits.pushout.inr _ _ ≫ pushoutSection hP hUST hUSX hUY = S'.appTop :=
    (Limits.pushout.inr_desc _ _ _).trans (Scheme.Hom.appLE_eq_app S')
  have jointepi : ∀ φ φ' : Γ(Limits.pullback snd (Spec.map (CommRingCat.ofHom lam)), ⊤) →+* L,
      φ.comp F'.appTop.hom = φ'.comp F'.appTop.hom →
      φ.comp S'.appTop.hom = φ'.comp S'.appTop.hom → φ = φ' := by
    intro φ φ' h1 h2
    have e : pushoutSection hP hUST hUSX hUY ≫ CommRingCat.ofHom φ =
        pushoutSection hP hUST hUSX hUY ≫ CommRingCat.ofHom φ' := by
      apply Limits.pushout.hom_ext
      · rw [← Category.assoc, ← Category.assoc, hinl]
        ext x
        exact congrArg (fun f => f x) h1
      · rw [← Category.assoc, ← Category.assoc, hinr]
        ext x
        exact congrArg (fun f => f x) h2
    have e2 := (cancel_epi (pushoutSection hP hUST hUSX hUY)).mp e
    have e3 := congrArg CommRingCat.Hom.hom e2
    simpa only [CommRingCat.hom_ofHom] using e3

  let σ : L →+* Γ(Limits.pullback snd (Spec.map (CommRingCat.ofHom lam)), ⊤) :=
    S'.appTop.hom.comp (Scheme.ΓSpecIso (.of L)).inv.hom
  haveI hS'prop : IsProper S' := MorphismProperty.of_isPullback (P := @IsProper) hP hprop
  have hσint : σ.IsIntegral :=
    RingHom.IsIntegral.trans _ _ (RingHom.isIntegral_of_surjective _ (Γsurj L))
      (isIntegral_appTop_of_universallyClosed S')

  have huniq : ∀ φ φ' : Γ(Limits.pullback snd (Spec.map (CommRingCat.ofHom lam)), ⊤) →+* L,
      φ.comp σ = RingHom.id L → φ'.comp σ = RingHom.id L → φ = φ' := by
    intro φ φ' hφ hφ'
    have hFθ : ∀ r : R, F'.appTop.hom (θ r) = σ (j r) := fun r => sq j F' S' hP.w r
    have hS : ∀ ϕ : Γ(Limits.pullback snd (Spec.map (CommRingCat.ofHom lam)), ⊤) →+* L,
        ϕ.comp σ = RingHom.id L → ϕ.comp S'.appTop.hom = (Scheme.ΓSpecIso (.of L)).hom.hom := by
      intro ϕ hϕ
      ext x
      obtain ⟨z, rfl⟩ := Γsurj L x
      have : ϕ (σ z) = z := by rw [← RingHom.comp_apply, hϕ, RingHom.id_apply]
      simp only [RingHom.comp_apply]
      rw [show S'.appTop.hom ((Scheme.ΓSpecIso (.of L)).inv.hom z) = σ z from rfl, this]
      simp
    have hχ : ∀ ϕ : Γ(Limits.pullback snd (Spec.map (CommRingCat.ofHom lam)), ⊤) →+* L,
        ϕ.comp σ = RingHom.id L → (ϕ.comp F'.appTop.hom).comp θ = j := by
      intro ϕ hϕ
      ext r
      simp only [RingHom.comp_apply]
      rw [hFθ r, ← RingHom.comp_apply, hϕ, RingHom.id_apply]
    apply jointepi φ φ' (c1 _ _ (hχ φ hφ) (hχ φ' hφ'))
    rw [hS φ hφ, hS φ' hφ']

  have hidem : ∀ e : Γ(Limits.pullback snd (Spec.map (CommRingCat.ofHom lam)), ⊤),
      e * e = e → e = 0 ∨ e = 1 := by
    intro e he
    by_cases hC : Subsingleton Γ(Limits.pullback snd (Spec.map (CommRingCat.ofHom lam)), ⊤)
    · left; exact Subsingleton.elim _ _
    rw [not_subsingleton_iff_nontrivial] at hC
    have retr : ∀ m : Ideal Γ(Limits.pullback snd (Spec.map (CommRingCat.ofHom lam)), ⊤),
        m.IsMaximal → ∃ ϕ : Γ(Limits.pullback snd (Spec.map (CommRingCat.ofHom lam)), ⊤) →+* L,
          ϕ.comp σ = RingHom.id L ∧ RingHom.ker ϕ = m := by
      intro m hm
      letI := Ideal.Quotient.field m
      have hint : ((Ideal.Quotient.mk m).comp σ).IsIntegral :=
        RingHom.IsIntegral.trans σ (Ideal.Quotient.mk m) hσint
          (RingHom.isIntegral_of_surjective _ Ideal.Quotient.mk_surjective)
      have hbij := IsAlgClosed.ringHom_bijective_of_isIntegral _ hint
      let E := RingEquiv.ofBijective _ hbij
      refine ⟨(E.symm : _ →+* L).comp (Ideal.Quotient.mk m), ?_, ?_⟩
      · ext x
        simp only [RingHom.comp_apply, RingEquiv.coe_toRingHom, RingHom.id_apply]
        rw [RingEquiv.symm_apply_eq]
        rfl
      · ext x
        simp only [RingHom.mem_ker, RingHom.comp_apply, RingEquiv.coe_toRingHom,
          map_eq_zero_iff _ E.symm.injective, Ideal.Quotient.eq_zero_iff_mem]
    haveI : IsLocalRing Γ(Limits.pullback snd (Spec.map (CommRingCat.ofHom lam)), ⊤) := by
      apply IsLocalRing.of_unique_max_ideal
      obtain ⟨m, hm⟩ := Ideal.exists_maximal Γ(Limits.pullback snd (Spec.map (CommRingCat.ofHom lam)), ⊤)
      refine ⟨m, hm, fun m' hm' => ?_⟩
      obtain ⟨ϕ, hϕ1, hϕ2⟩ := retr m hm
      obtain ⟨ϕ', hϕ1', hϕ2'⟩ := retr m' hm'
      rw [← hϕ2, ← hϕ2', huniq ϕ' ϕ hϕ1' hϕ1]
    rcases IsLocalRing.isUnit_or_isUnit_one_sub_self e with hu | hu
    · right
      exact hu.mul_left_cancel (by rw [he, mul_one])
    · left
      have : (1 - e) * e = (1 - e) * 0 := by rw [sub_mul, one_mul, he, sub_self, mul_zero]
      exact hu.mul_left_cancel this

  have hne : Nonempty ↥(Limits.pullback snd (Spec.map (CommRingCat.ofHom lam))) := by
    obtain ⟨z⟩ := hconn.toNonempty
    set x := Limits.pullback.fst h (Spec.map (CommRingCat.ofHom ι) ≫
      Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) z with hx
    have hpt : ∀ p : ↥(Spec (.of Ω)), p = IsLocalRing.closedPoint Ω := fun p => Subsingleton.elim _ _
    have hhx : h x = IsLocalRing.closedPoint R := by
      have e1 := Scheme.Hom.comp_apply (Limits.pullback.fst h (Spec.map (CommRingCat.ofHom ι) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) h z
      rw [Limits.pullback.condition, Scheme.Hom.comp_apply] at e1
      rw [hx, ← e1, hpt ((Limits.pullback.snd h (Spec.map (CommRingCat.ofHom ι) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)))) z), ← Spec.map_comp,
        ← CommRingCat.ofHom_comp]
      exact IsLocalRing.comap_closedPoint (ι.comp (IsLocalRing.residue R))
    obtain ⟨p⟩ : Nonempty ↥(Spec (.of L)) := ⟨IsLocalRing.closedPoint L⟩
    have hsp : Spec.map (CommRingCat.ofHom j) p ⤳ h x := by
      rw [hhx]; exact IsLocalRing.specializes_closedPoint _
    obtain ⟨x', -, hx'⟩ := Flat.generalizingMap h hsp
    obtain ⟨w, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := h)
      (g := Spec.map (CommRingCat.ofHom j)) x' p hx'
    exact ⟨hP.isoPullback.inv w⟩
  exact c7 _ hne hidem

theorem wcpa_dj_gcb_gc_locus_open : ∀ (Z T : Scheme.{u}) (u : Z ⟶ T), Flat u → IsProper u → LocallyOfFinitePresentation u → wcpaDjGeomReducedFibres u → IsOpen {t : T | ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T), s (IsLocalRing.closedPoint K) = t → ConnectedSpace ↥(Limits.pullback u s)} :=
by
  classical

  have hconn : ∀ {X Y : Scheme.{u}} (e : X ≅ Y), ConnectedSpace X → ConnectedSpace Y := by
    intro X Y e hX
    haveI := hX
    exact Function.Surjective.connectedSpace (Scheme.homeoOfIso e).surjective
      (Scheme.homeoOfIso e).continuous
  have hredi : ∀ {X Y : Scheme.{u}} (e : X ≅ Y), AlgebraicGeometry.IsReduced Y →
      AlgebraicGeometry.IsReduced X := by
    intro X Y e hY
    haveI := hY
    exact isReduced_of_isOpenImmersion e.hom

  have transfer : ∀ {Z T : Scheme.{u}} (u : Z ⟶ T) (K K' : Type u) [Field K] [Field K'] (ι : K →+* K')
      (y : Spec (.of K) ⟶ T)
      (W : Scheme.{u}) (fst : W ⟶ Z) (snd : W ⟶ Spec (.of K)), IsPullback fst snd u y →
      ∀ (W' : Scheme.{u}) (fst' : W' ⟶ Z) (snd' : W' ⟶ Spec (.of K')),
      IsPullback fst' snd' u (Spec.map (CommRingCat.ofHom ι) ≫ y) → ConnectedSpace W' →
      ConnectedSpace W := by
    intro Z T u K K' _ _ ι y W fst snd h W' fst' snd' h' hW'
    haveI := hW'
    have hw : fst' ≫ u = (snd' ≫ Spec.map (CommRingCat.ofHom ι)) ≫ y := by
      rw [h'.w, Category.assoc]
    have hl1 : h.lift fst' (snd' ≫ Spec.map (CommRingCat.ofHom ι)) hw ≫ fst = fst' :=
      h.lift_fst _ _ _
    have hl2 : h.lift fst' (snd' ≫ Spec.map (CommRingCat.ofHom ι)) hw ≫ snd =
        snd' ≫ Spec.map (CommRingCat.ofHom ι) := h.lift_snd _ _ _
    have hsq : IsPullback (h.lift fst' (snd' ≫ Spec.map (CommRingCat.ofHom ι)) hw) snd' snd
        (Spec.map (CommRingCat.ofHom ι)) := by
      have h1 : IsPullback (h.lift fst' (snd' ≫ Spec.map (CommRingCat.ofHom ι)) hw ≫ fst) snd' u
          (Spec.map (CommRingCat.ofHom ι) ≫ y) := by
        rw [hl1]; exact h'
      exact IsPullback.of_right h1 hl2 h
    haveI hp : Surjective (h.lift fst' (snd' ≫ Spec.map (CommRingCat.ofHom ι)) hw) :=
      MorphismProperty.of_isPullback (P := @Surjective) hsq.flip inferInstance
    exact Function.Surjective.connectedSpace
      (h.lift fst' (snd' ≫ Spec.map (CommRingCat.ofHom ι)) hw).surjective
      (h.lift fst' (snd' ≫ Spec.map (CommRingCat.ofHom ι)) hw).continuous

  have common : ∀ {T T' : Scheme.{u}} (b : T' ⟶ T) (x : T') (K : Type u) [Field K]
      (s : Spec (.of K) ⟶ T), s (IsLocalRing.closedPoint K) = b x →
      ∃ (Ω : Type u) (_ : Field Ω) (_ : IsAlgClosed Ω) (ι : K →+* Ω) (s' : Spec (.of Ω) ⟶ T'),
        s' (IsLocalRing.closedPoint Ω) = x ∧ s' ≫ b = Spec.map (CommRingCat.ofHom ι) ≫ s := by
    intro T T' b x K _ s hs
    obtain ⟨z, -, hz2⟩ := Scheme.Pullback.exists_preimage_pullback (f := s) (g := b) _ x hs
    let ι₀ : K →+* (Limits.pullback s b).residueField z :=
      (Spec.preimage ((Limits.pullback s b).fromSpecResidueField z ≫
        Limits.pullback.fst s b)).hom
    refine ⟨AlgebraicClosure ((Limits.pullback s b).residueField z), inferInstance, inferInstance,
      (algebraMap ((Limits.pullback s b).residueField z)
        (AlgebraicClosure ((Limits.pullback s b).residueField z))).comp ι₀,
      Spec.map (CommRingCat.ofHom (algebraMap ((Limits.pullback s b).residueField z)
        (AlgebraicClosure ((Limits.pullback s b).residueField z)))) ≫
        (Limits.pullback s b).fromSpecResidueField z ≫ Limits.pullback.snd s b, ?_, ?_⟩
    · have e := Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom (algebraMap
          ((Limits.pullback s b).residueField z)
          (AlgebraicClosure ((Limits.pullback s b).residueField z)))))
        ((Limits.pullback s b).fromSpecResidueField z ≫ Limits.pullback.snd s b)
        (IsLocalRing.closedPoint (AlgebraicClosure ((Limits.pullback s b).residueField z)))
      rw [Scheme.Hom.comp_apply, Scheme.fromSpecResidueField_apply, hz2] at e
      exact e
    · rw [CommRingCat.ofHom_comp, Spec.map_comp, CommRingCat.ofHom_hom, Spec.map_preimage]
      simp only [Category.assoc]
      rw [← Limits.pullback.condition]

  have locus : ∀ {Z T Z' T' : Scheme.{u}} (u : Z ⟶ T) (j : T' ⟶ T) (u' : Z' ⟶ T') (φ : Z' ⟶ Z),
      IsPullback φ u' u j → ∀ x : T',
      ((∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T'),
          s (IsLocalRing.closedPoint K) = x → ConnectedSpace ↥(Limits.pullback u' s)) ↔
        (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T),
          s (IsLocalRing.closedPoint K) = j x → ConnectedSpace ↥(Limits.pullback u s))) := by
    intro Z T Z' T' u j u' φ hpb x
    constructor
    · intro h K _ _ s hs
      obtain ⟨Ω, _, _, ι, s', hs'1, hs'2⟩ := common j x K s hs
      have c1 := h Ω s' hs'1
      have sq : IsPullback (Limits.pullback.fst u' s' ≫ φ) (Limits.pullback.snd u' s') u
          (Spec.map (CommRingCat.ofHom ι) ≫ s) := by
        rw [← hs'2]
        exact (IsPullback.of_hasPullback u' s').paste_horiz hpb
      exact transfer u K Ω ι s _ _ _ (IsPullback.of_hasPullback u s) _ _ _ sq c1
    · intro h K _ _ s hs
      have e := Scheme.Hom.comp_apply s j (IsLocalRing.closedPoint K)
      rw [hs] at e
      have c1 := h K (s ≫ j) e
      exact hconn ((IsPullback.of_hasPullback u' s).paste_horiz hpb).isoPullback.symm c1

  have model : ∀ (A A₁ : Type u) [CommRing A] [CommRing A₁] [IsNoetherianRing A₁]
      (Y₁ X : Scheme.{u}) (u₀ : Y₁ ⟶ Spec (.of A₁)) (f : X ⟶ Spec (.of A)) (ψ : X ⟶ Y₁)
      (ρ : Spec (.of A) ⟶ Spec (.of A₁)), Flat u₀ → IsProper u₀ → IsPullback ψ f u₀ ρ →
      wcpaDjGeomReducedFibres f →
      IsOpen {t : Spec (.of A) | ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Spec (.of A)),
        s (IsLocalRing.closedPoint K) = t → ConnectedSpace ↥(Limits.pullback f s)} := by
    intro A A₁ _ _ _ Y₁ X u₀ f ψ ρ hfl hpr hsq hred
    haveI := hfl
    haveI := hpr
    set G₀ : Set (Spec (.of A₁)) := {t | ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (s : Spec (.of K) ⟶ Spec (.of A₁)), s (IsLocalRing.closedPoint K) = t →
        ConnectedSpace ↥(Limits.pullback u₀ s)} with hG₀
    set G : Set (Spec (.of A)) := {t | ∀ (K : Type u) [Field K] [IsAlgClosed K]
      (s : Spec (.of K) ⟶ Spec (.of A)), s (IsLocalRing.closedPoint K) = t →
        ConnectedSpace ↥(Limits.pullback f s)} with hG
    have hGpre : G = ρ ⁻¹' G₀ := by
      ext x
      exact locus u₀ ρ f ψ hsq x

    have hD := wcpa_dj_gcb_disconnected_locus_open Y₁ (Spec (.of A₁)) u₀ hfl hpr inferInstance
    have hDc : {t : Spec (.of A₁) | ∃ (K : Type u) (_ : Field K) (_ : IsAlgClosed K)
        (s : Spec (.of K) ⟶ Spec (.of A₁)), s (IsLocalRing.closedPoint K) = t ∧
          ¬ ConnectedSpace ↥(Limits.pullback u₀ s)} = G₀ᶜ := by
      ext t
      rw [Set.mem_setOf_eq, Set.mem_compl_iff, hG₀, Set.mem_setOf_eq]
      constructor
      · rintro ⟨K, _, _, s, hs, hn⟩ hG'
        exact hn (hG' K s hs)
      · intro ht
        by_contra hne
        apply ht
        intro K _ _ s hs
        by_contra hc
        exact hne ⟨K, inferInstance, inferInstance, s, hs, hc⟩
    rw [hDc] at hD
    have hG₀c : Topology.IsConstructible G₀ := by
      have h1 : Topology.IsConstructible G₀ᶜ :=
        (TopologicalSpace.NoetherianSpace.isCompact _).isConstructible hD
      simpa using h1.compl
    have hGc : Topology.IsConstructible G := by
      rw [hGpre]; exact Scheme.Hom.isConstructible_preimage ρ hG₀c

    have hGg : StableUnderGeneralization G := by
      intro x y hyx hx
      have hx₀ : ρ x ∈ G₀ := by rw [hGpre] at hx; exact hx
      rw [hGpre]
      show ρ y ∈ G₀
      have hsp : ρ y ⤳ ρ x := hyx.map ρ.continuous
      by_cases hEq : ρ y = ρ x
      · rw [hEq]; exact hx₀
      obtain ⟨R, _, _, _, g, hg1, hg2⟩ := wcpa_dj_gcl_dvr_trait A₁ (ρ x) (ρ y) hsp hEq
      set k := IsLocalRing.ResidueField R
      have hc : (Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))) ≫
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) (IsLocalRing.closedPoint
            (AlgebraicClosure k)) = IsLocalRing.closedPoint R := by
        rw [← Spec.map_comp, ← CommRingCat.ofHom_comp]
        exact IsLocalRing.comap_closedPoint ((algebraMap k (AlgebraicClosure k)).comp
          (IsLocalRing.residue R))
      have hcg : ((Spec.map (CommRingCat.ofHom (algebraMap k (AlgebraicClosure k))) ≫
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) ≫ g) (IsLocalRing.closedPoint
            (AlgebraicClosure k)) = ρ x := by
        have e := Scheme.Hom.comp_apply (Spec.map (CommRingCat.ofHom (algebraMap k
          (AlgebraicClosure k))) ≫ Spec.map (CommRingCat.ofHom (IsLocalRing.residue R))) g
          (IsLocalRing.closedPoint (AlgebraicClosure k))
        rw [hc, hg1] at e
        exact e
      obtain ⟨Ω, _, _, ι₂, s', hs'1, hs'2⟩ := common ρ x (AlgebraicClosure k) _ hcg
      have c1 : ConnectedSpace ↥(Limits.pullback f s') := hx Ω s' hs'1
      have r1 : AlgebraicGeometry.IsReduced (Limits.pullback f s') := hred Ω s'
      set hR := Limits.pullback.snd u₀ g with hhR
      set c' : Spec (.of Ω) ⟶ Spec (.of R) :=
        Spec.map (CommRingCat.ofHom (ι₂.comp (algebraMap k (AlgebraicClosure k)))) ≫
          Spec.map (CommRingCat.ofHom (IsLocalRing.residue R)) with hc'
      have E : s' ≫ ρ = c' ≫ g := by
        rw [hs'2, hc', CommRingCat.ofHom_comp, Spec.map_comp]
        simp only [Category.assoc]
      have sq1 : IsPullback (Limits.pullback.fst f s' ≫ ψ) (Limits.pullback.snd f s') u₀
          (c' ≫ g) := by
        rw [← E]; exact (IsPullback.of_hasPullback f s').paste_horiz hsq
      have sq2 : IsPullback (Limits.pullback.fst hR c' ≫ Limits.pullback.fst u₀ g)
          (Limits.pullback.snd hR c') u₀ (c' ≫ g) :=
        (IsPullback.of_hasPullback hR c').paste_horiz (IsPullback.of_hasPullback u₀ g)
      have eiso : Limits.pullback hR c' ≅ Limits.pullback f s' :=
        sq2.isoPullback ≪≫ sq1.isoPullback.symm
      have c2 : ConnectedSpace ↥(Limits.pullback hR c') := hconn eiso.symm c1
      have r2 : AlgebraicGeometry.IsReduced (Limits.pullback hR c') := hredi eiso r1
      have hRfl : Flat hR := inferInstance
      have hRpr : IsProper hR := inferInstance
      have hGC := wcpa_dj_gcl_dvr_geom_connected R (Limits.pullback u₀ g) hR hRfl hRpr Ω
        (ι₂.comp (algebraMap k (AlgebraicClosure k))) c2 r2
      haveI := hGC
      intro K _ _ s hs
      obtain ⟨Ω', _, _, ι', s'', -, hs''2⟩ := common
        (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))) ≫ g)
        (IsLocalRing.closedPoint (FractionRing R)) K s (hs.trans hg2.symm)
      have hc'' : ConnectedSpace ↥(Limits.pullback (Limits.pullback.snd hR
          (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))))) s'') :=
        GeometricallyConnected.geometrically_connectedSpace s'' _ _ (IsPullback.of_hasPullback _ _)
      have sq3 := ((IsPullback.of_hasPullback (Limits.pullback.snd hR
          (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R))))) s'').paste_horiz
        (IsPullback.of_hasPullback hR
          (Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))))).paste_horiz
        (IsPullback.of_hasPullback u₀ g)
      have e3 : (s'' ≫ Spec.map (CommRingCat.ofHom (algebraMap R (FractionRing R)))) ≫ g =
          Spec.map (CommRingCat.ofHom ι') ≫ s := by
        rw [Category.assoc]; exact hs''2
      rw [e3] at sq3
      exact transfer u₀ K Ω' ι' s _ _ _ (IsPullback.of_hasPullback u₀ s) _ _ _ sq3 hc''
    exact PrimeSpectrum.isOpen_of_stableUnderGeneralization_of_isConstructible hGg hGc

  have affine : ∀ (A : Type u) [CommRing A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A)),
      Flat f → IsProper f → LocallyOfFinitePresentation f → wcpaDjGeomReducedFibres f →
      IsOpen {t : Spec (.of A) | ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Spec (.of A)),
        s (IsLocalRing.closedPoint K) = t → ConnectedSpace ↥(Limits.pullback f s)} := by
    intro A _ X f hfl hpr hlfp hred
    haveI := hpr
    haveI := hlfp
    obtain ⟨S₀, Y₀, h₀, π, hY₀, hπ⟩ := wc_fet_lfp_model_over_subring A
      (fun S => Subring.closure (S : Set A)) (fun S a ha => Subring.subset_closure ha) X f
    haveI := hY₀
    obtain ⟨S, hS, hflat⟩ := wcpa_dj_lsl_flat_level_scheme wcpa_dj_lsl_flat_level_ring A S₀ Y₀ h₀
      X f π hπ hfl
    have hfl₀ := hflat S (le_refl _)
    haveI hAnoeth : IsNoetherianRing (Subring.closure (S : Set A)) := by
      have h1 : (Algebra.adjoin ℤ (S : Set A)).FG := Subalgebra.fg_adjoin_finset S
      haveI : Algebra.FiniteType ℤ (Algebra.adjoin ℤ (S : Set A)) :=
        (Subalgebra.fg_iff_finiteType _).mp h1
      have h2 := Algebra.FiniteType.isNoetherianRing ℤ (Algebra.adjoin ℤ (S : Set A))
      rw [Algebra.adjoin_int] at h2
      exact h2
    have t2 : (Subring.closure (S₀ : Set A)).subtype =
        (Subring.closure (S : Set A)).subtype.comp (Subring.inclusion (hS.trans (le_refl _))) := by
      ext a; simp
    have hρ : Spec.map (CommRingCat.ofHom (Subring.closure (S₀ : Set A)).subtype) =
        Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype) ≫
          Spec.map (CommRingCat.ofHom (Subring.inclusion (hS.trans (le_refl _)))) := by
      rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← t2]
    rw [hρ] at hπ
    have hw : π ≫ h₀ = (f ≫ Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype)) ≫
        Spec.map (CommRingCat.ofHom (Subring.inclusion (hS.trans (le_refl _)))) := by
      rw [hπ.w, Category.assoc]
    have hsq : IsPullback (Limits.pullback.lift π _ hw) f
        (Limits.pullback.snd h₀ (Spec.map (CommRingCat.ofHom
          (Subring.inclusion (hS.trans (le_refl _))))))
        (Spec.map (CommRingCat.ofHom (Subring.closure (S : Set A)).subtype)) := by
      refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _)
        (IsPullback.of_hasPullback _ _)
      rw [Limits.pullback.lift_fst]
      exact hπ
    exact model A (Subring.closure (S : Set A)) _ X _ f _ _ hfl₀ inferInstance hsq hred

  intro Z T u hfl hpr hlfp hred
  haveI := hfl
  haveI := hpr
  haveI := hlfp
  rw [isOpen_iff_forall_mem_open]
  intro t ht
  obtain ⟨W, hW, htW, -⟩ := exists_isAffineOpen_mem_and_subset (x := t) (U := ⊤) trivial
  haveI := hW.isOpenImmersion_fromSpec
  set j := hW.fromSpec with hj
  have hredW : wcpaDjGeomReducedFibres (Limits.pullback.snd u j) := by
    intro K _ _ s
    exact hredi ((IsPullback.of_hasPullback (Limits.pullback.snd u j) s).paste_horiz
      (IsPullback.of_hasPullback u j)).isoPullback (hred K (s ≫ j))
  have hGW := affine Γ(T, W) (Limits.pullback u j) (Limits.pullback.snd u j) inferInstance
    inferInstance inferInstance hredW
  refine ⟨j '' {x | ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Spec Γ(T, W)),
        s (IsLocalRing.closedPoint K) = x → ConnectedSpace ↥(Limits.pullback (Limits.pullback.snd u j) s)},
    ?_, j.isOpenEmbedding.isOpenMap _ hGW, ?_⟩
  · rintro _ ⟨x, hx, rfl⟩
    exact (locus u j (Limits.pullback.snd u j) (Limits.pullback.fst u j)
      (IsPullback.of_hasPullback u j) x).mp hx
  · have htr : t ∈ Set.range j := by rw [hj, hW.range_fromSpec]; exact htW
    obtain ⟨x, rfl⟩ := htr
    exact ⟨x, (locus u j (Limits.pullback.snd u j) (Limits.pullback.fst u j)
      (IsPullback.of_hasPullback u j) x).mpr ht, rfl⟩

theorem wcpa_dj_lsl_gc_connected_base : ∀ (T T' Z Z' : Scheme.{u}) (u : Z ⟶ T) (b : T' ⟶ T) (u' : Z' ⟶ T') (φ : Z' ⟶ Z), wcpaDjSemistable u → LocallyOfFinitePresentation u → ConnectedSpace T → Nonempty T' → IsPullback φ u' u b → GeometricallyConnected u' → GeometricallyConnected u :=
by
  intro T T' Z Z' u b u' φ hss hfp hT hT' hpb hgc'
  classical
  haveI := hT

  have transfer : ∀ (K K' : Type u) [Field K] [Field K'] (ι : K →+* K') (y : Spec (.of K) ⟶ T)
      (W : Scheme.{u}) (fst : W ⟶ Z) (snd : W ⟶ Spec (.of K)), IsPullback fst snd u y →
      ∀ (W' : Scheme.{u}) (fst' : W' ⟶ Z) (snd' : W' ⟶ Spec (.of K')),
      IsPullback fst' snd' u (Spec.map (CommRingCat.ofHom ι) ≫ y) → ConnectedSpace W' →
      ConnectedSpace W := by
    intro K K' _ _ ι y W fst snd h W' fst' snd' h' hW'
    haveI := hW'
    have hw : fst' ≫ u = (snd' ≫ Spec.map (CommRingCat.ofHom ι)) ≫ y := by
      rw [h'.w, Category.assoc]
    have hl1 : h.lift fst' (snd' ≫ Spec.map (CommRingCat.ofHom ι)) hw ≫ fst = fst' :=
      h.lift_fst _ _ _
    have hl2 : h.lift fst' (snd' ≫ Spec.map (CommRingCat.ofHom ι)) hw ≫ snd =
        snd' ≫ Spec.map (CommRingCat.ofHom ι) := h.lift_snd _ _ _
    have hsq : IsPullback (h.lift fst' (snd' ≫ Spec.map (CommRingCat.ofHom ι)) hw) snd' snd
        (Spec.map (CommRingCat.ofHom ι)) := by
      have h1 : IsPullback (h.lift fst' (snd' ≫ Spec.map (CommRingCat.ofHom ι)) hw ≫ fst) snd' u
          (Spec.map (CommRingCat.ofHom ι) ≫ y) := by
        rw [hl1]; exact h'
      exact IsPullback.of_right h1 hl2 h
    haveI hp : Surjective (h.lift fst' (snd' ≫ Spec.map (CommRingCat.ofHom ι)) hw) :=
      MorphismProperty.of_isPullback (P := @Surjective) hsq.flip inferInstance
    exact Function.Surjective.connectedSpace
      (h.lift fst' (snd' ≫ Spec.map (CommRingCat.ofHom ι)) hw).surjective
      (h.lift fst' (snd' ≫ Spec.map (CommRingCat.ofHom ι)) hw).continuous

  have common : ∀ (t' : T') (K : Type u) [Field K] (s : Spec (.of K) ⟶ T),
      s (IsLocalRing.closedPoint K) = b t' →
      ∃ (K' : Type u) (_ : Field K') (ι : K →+* K') (s' : Spec (.of K') ⟶ T'),
        s' ≫ b = Spec.map (CommRingCat.ofHom ι) ≫ s := by
    intro t' K _ s hs
    obtain ⟨z, -, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := s) (g := b) _ t' hs
    refine ⟨(Limits.pullback s b).residueField z, inferInstance,
      (Spec.preimage ((Limits.pullback s b).fromSpecResidueField z ≫
        Limits.pullback.fst s b)).hom,
      (Limits.pullback s b).fromSpecResidueField z ≫ Limits.pullback.snd s b, ?_⟩
    rw [CommRingCat.ofHom_hom, Spec.map_preimage, Category.assoc, Category.assoc,
      Limits.pullback.condition]

  let G : Set T := {t : T | ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T),
    s (IsLocalRing.closedPoint K) = t → ConnectedSpace ↥(Limits.pullback u s)}
  have hmemG : ∀ t, t ∈ G ↔ ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ T),
      s (IsLocalRing.closedPoint K) = t → ConnectedSpace ↥(Limits.pullback u s) :=
    fun t => Iff.rfl
  have hGo : IsOpen G := wcpa_dj_gcb_gc_locus_open Z T u hss.1 hss.2.1 hfp
    (wcpa_dj_gcb_semistable_reduced_fibres u hss)
  have hGc : IsClosed G := by
    have h := wcpa_dj_gcb_disconnected_locus_open Z T u hss.1 hss.2.1 hfp
    have e : {t : T | ∃ (K : Type u) (_ : Field K) (_ : IsAlgClosed K) (s : Spec (.of K) ⟶ T),
        s (IsLocalRing.closedPoint K) = t ∧ ¬ ConnectedSpace ↥(Limits.pullback u s)} = Gᶜ := by
      ext t
      rw [Set.mem_setOf_eq, Set.mem_compl_iff, hmemG]
      constructor
      · rintro ⟨K, _, _, s, hs, hn⟩ hG'
        exact hn (hG' K s hs)
      · intro ht
        by_contra hne
        apply ht
        intro K _ _ s hs
        by_contra hc
        exact hne ⟨K, inferInstance, inferInstance, s, hs, hc⟩
    rw [e] at h
    exact isOpen_compl_iff.mp h
  obtain ⟨t'⟩ := hT'
  have hbt : b t' ∈ G := by
    rw [hmemG]
    intro K _ _ s hs
    obtain ⟨K', _, ι, s', hs'⟩ := common t' K s hs
    haveI := hgc'
    have hc' : ConnectedSpace ↥(Limits.pullback u' s') :=
      GeometricallyConnected.geometrically_connectedSpace (f := u') s'
        (Limits.pullback.fst u' s') (Limits.pullback.snd u' s') (IsPullback.of_hasPullback u' s')
    have hpaste : IsPullback (Limits.pullback.fst u' s' ≫ φ) (Limits.pullback.snd u' s') u
        (Spec.map (CommRingCat.ofHom ι) ≫ s) := by
      rw [← hs']
      exact (IsPullback.of_hasPullback u' s').paste_horiz hpb
    exact transfer K K' ι s _ _ _ (IsPullback.of_hasPullback u s) _ _ _ hpaste hc'
  have hGu : G = Set.univ := by
    have hpre : PreconnectedSpace T := @ConnectedSpace.toPreconnectedSpace T _ hT
    rcases (@isClopen_iff T _ hpre G).mp ⟨hGc, hGo⟩ with h | h
    · rw [h] at hbt; simp at hbt
    · exact h
  refine ⟨?_⟩
  intro K _ y W fst snd h
  have hmem : (Spec.map (CommRingCat.ofHom (algebraMap K (AlgebraicClosure K))) ≫ y)
      (IsLocalRing.closedPoint (AlgebraicClosure K)) ∈ G := by
    rw [hGu]; trivial
  have hc := (hmemG _).mp hmem (AlgebraicClosure K) _ rfl
  exact transfer K (AlgebraicClosure K) (algebraMap K (AlgebraicClosure K)) y W fst snd h _ _ _
    (IsPullback.of_hasPullback u _) hc

theorem wcpa_dj_lqu_pnt_span : ∀ (K : Type u) [Field K] (m r : ℕ) (F : Fin r → MvPolynomial (Fin m) K) (c : Fin m → K), (∀ j, MvPolynomial.eval c (F j) = 0) → wcpaLquPNT F c → ∃ σ : Fin m → Fin r ⊕ ((Fin (m - 1) → Fin r) × (Fin (m - 1) → Fin m)), (Matrix.of fun i l => MvPolynomial.eval c (MvPolynomial.pderiv l (wcpaLquGen F (σ i)))).det ≠ 0 :=
by
  have h_P1 : ∀ (K : Type u) [Field K] (m : ℕ) (c : Fin m → K) (q : MvPolynomial (Fin m) K),
      q ∈ Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) →
      MvPolynomial.eval c q = 0 := by
    intro K _ m c q hq
    have h : Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ≤
        RingHom.ker (MvPolynomial.eval c) := by
      rw [Ideal.span_le]
      rintro _ ⟨l, rfl⟩
      simp
    exact RingHom.mem_ker.mp (h hq)

  have h_P2 : ∀ (K : Type u) [Field K] (m : ℕ) (c : Fin m → K) (a : Fin m) (k : ℕ)
      (q : MvPolynomial (Fin m) K),
      q ∈ Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ (k + 1) →
      MvPolynomial.pderiv a q ∈
        Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ k := by
    intro K _ m c a k
    induction k with
    | zero => intro q _; simp
    | succ k ih =>
      intro q hq
      rw [pow_succ'] at hq
      refine Submodule.mul_induction_on (C := fun q => MvPolynomial.pderiv a q ∈
        Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ (k + 1)) hq ?_ ?_
      · intro x hx y hy
        show MvPolynomial.pderiv a (x * y) ∈ _
        rw [MvPolynomial.pderiv_mul]
        refine Ideal.add_mem _ ?_ ?_
        · exact Ideal.mul_mem_left _ _ hy
        · rw [pow_succ']
          exact Ideal.mul_mem_mul hx (ih y hy)
      · intro x y hx hy
        show MvPolynomial.pderiv a (x + y) ∈ _
        rw [map_add]; exact Ideal.add_mem _ hx hy

  have h_lin : ∀ (K : Type u) [Field K] (m : ℕ) (c : Fin m → K),
      (∀ v w : Fin m → K, wcpaLquLin c (v + w) = wcpaLquLin c v + wcpaLquLin c w) ∧
      (∀ v w : Fin m → K, wcpaLquLin c (v - w) = wcpaLquLin c v - wcpaLquLin c w) ∧
      (∀ (a : K) (v : Fin m → K), wcpaLquLin c (a • v) = MvPolynomial.C a * wcpaLquLin c v) ∧
      (∀ w : Fin m → K, wcpaLquLin c w ∈
        Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l))) ∧
      (∀ (w : Fin m → K) (l : Fin m), MvPolynomial.pderiv l (wcpaLquLin c w) = MvPolynomial.C (w l)) ∧
      (∀ w : Fin m → K, MvPolynomial.eval c (wcpaLquLin c w) = 0) := by
    intro K _ m c
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro v w
      simp only [wcpaLquLin, Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
    · intro v w
      simp only [wcpaLquLin, Pi.sub_apply, map_sub, sub_mul, Finset.sum_sub_distrib]
    · intro a v
      simp only [wcpaLquLin, Pi.smul_apply, smul_eq_mul, map_mul, Finset.mul_sum, mul_assoc]
    · intro w
      refine Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, rfl⟩))
    · intro w l
      simp only [wcpaLquLin, map_sum, MvPolynomial.pderiv_C_mul, map_sub, MvPolynomial.pderiv_X,
        MvPolynomial.pderiv_C, sub_zero]
      rw [Finset.sum_eq_single l]
      · simp
      · intro b _ hb
        simp [hb]
      · simp
    · intro w
      simp [wcpaLquLin]

  have h_taylor : ∀ (K : Type u) [Field K] (m : ℕ) (c : Fin m → K) (p : MvPolynomial (Fin m) K),
      p - MvPolynomial.C (MvPolynomial.eval c p) -
        wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p)) ∈
        Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ 2 := by
    intro K _ m c p
    obtain ⟨hadd, hsub, hsmul, hmem, hpd, hev⟩ := h_lin K m c
    set M := Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) with hM
    have hM2 : M ^ 2 ≤ M := Ideal.pow_le_self two_ne_zero
    have hgradmul : ∀ p q : MvPolynomial (Fin m) K,
        (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (p * q))) =
        MvPolynomial.eval c p • (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l q)) +
        MvPolynomial.eval c q • (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p)) := by
      intro p q
      funext l
      simp only [MvPolynomial.pderiv_mul, map_add, map_mul, Pi.add_apply, Pi.smul_apply,
        smul_eq_mul]
      ring
    have hmul : ∀ p q : MvPolynomial (Fin m) K,
        p - MvPolynomial.C (MvPolynomial.eval c p) -
          wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p)) ∈ M ^ 2 →
        q - MvPolynomial.C (MvPolynomial.eval c q) -
          wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l q)) ∈ M ^ 2 →
        p * q - MvPolynomial.C (MvPolynomial.eval c (p * q)) -
          wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (p * q))) ∈ M ^ 2 := by
      intro p q hp hq
      have hp1 : p - MvPolynomial.C (MvPolynomial.eval c p) ∈ M := by
        have := Ideal.add_mem _ (hM2 hp) (hmem (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p)))
        simpa using this
      have hq1 : q - MvPolynomial.C (MvPolynomial.eval c q) ∈ M := by
        have := Ideal.add_mem _ (hM2 hq) (hmem (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l q)))
        simpa using this
      have e : p * q - MvPolynomial.C (MvPolynomial.eval c (p * q)) -
          wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (p * q))) =
          MvPolynomial.C (MvPolynomial.eval c p) * (q - MvPolynomial.C (MvPolynomial.eval c q) -
            wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l q))) +
          MvPolynomial.C (MvPolynomial.eval c q) * (p - MvPolynomial.C (MvPolynomial.eval c p) -
            wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p))) +
          (p - MvPolynomial.C (MvPolynomial.eval c p)) * (q - MvPolynomial.C (MvPolynomial.eval c q)) := by
        rw [hgradmul, hadd, hsmul, hsmul, map_mul, map_mul]
        ring
      rw [e]
      refine Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hq) (Ideal.mul_mem_left _ _ hp)) ?_
      rw [pow_two]
      exact Ideal.mul_mem_mul hp1 hq1
    induction p using MvPolynomial.induction_on with
    | C a =>
      have : (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (MvPolynomial.C a : MvPolynomial (Fin m) K))) = 0 := by
        funext l; simp
      rw [this]
      simp [wcpaLquLin]
    | add p q hp hq =>
      have e : p + q - MvPolynomial.C (MvPolynomial.eval c (p + q)) -
          wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (p + q))) =
          (p - MvPolynomial.C (MvPolynomial.eval c p) -
            wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p))) +
          (q - MvPolynomial.C (MvPolynomial.eval c q) -
            wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l q))) := by
        have : (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (p + q))) =
            (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p)) +
            (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l q)) := by
          funext l; simp
        rw [this, hadd, map_add, map_add]
        ring
      rw [e]
      exact Ideal.add_mem _ hp hq
    | mul_X p n hp =>
      apply hmul p (MvPolynomial.X n) hp
      have : (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (MvPolynomial.X n : MvPolynomial (Fin m) K))) =
          Pi.single n 1 := by
        funext l
        rw [MvPolynomial.pderiv_X]
        by_cases h : l = n
        · subst h; simp
        · simp [h, Ne.symm h]
      rw [this]
      have e : wcpaLquLin c (Pi.single n (1 : K)) = MvPolynomial.X n - MvPolynomial.C (c n) := by
        simp only [wcpaLquLin]
        rw [Finset.sum_eq_single n]
        · simp
        · intro b _ hb; simp [hb]
        · simp
      rw [e]
      simp

  have t_s4 : ∀ (K : Type u) [Field K] (m r : ℕ) (F : Fin r → MvPolynomial (Fin m) K) (c : Fin m → K), (∀ j, MvPolynomial.eval c (F j) = 0) → wcpaLquPNT F c → ∃ α β : Fin m → K, (∀ w : Fin m → K, ∃ a b : K, w - a • α - b • β ∈ Submodule.span K (Set.range fun j => fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (F j)))) ∧ (∀ a b : K, a • α + b • β ∈ Submodule.span K (Set.range fun j => fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (F j))) → a = 0 ∧ b = 0) ∧ wcpaLquLin c α * wcpaLquLin c β ∈ wcpaLquI F c 3 := by
    intro K _ m r F c hF hPNT
    obtain ⟨α, β, ha, hb, hc⟩ := hPNT
    obtain ⟨hadd, hsub, hsmul, hmem, hpd, hev⟩ := h_lin K m c
    have hLin0 : wcpaLquLin c (0 : Fin m → K) = 0 := by simp [wcpaLquLin]
    have claim : ∀ w, wcpaLquLin c w ∈ wcpaLquI F c 2 ↔
        w ∈ Submodule.span K (Set.range fun j => fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (F j))) := by
      intro w
      constructor
      · intro hw
        rw [wcpaLquI, Submodule.mem_sup] at hw
        obtain ⟨y, hy, z, hz, hyz⟩ := hw
        obtain ⟨h, rfl⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hz
        rw [Submodule.mem_span_range_iff_exists_fun]
        refine ⟨fun j => MvPolynomial.eval c (h j), ?_⟩
        funext l
        have e := congrArg (fun p => MvPolynomial.eval c (MvPolynomial.pderiv l p)) hyz
        have hy0 : MvPolynomial.eval c (MvPolynomial.pderiv l y) = 0 :=
          h_P1 K m c _ (by simpa using h_P2 K m c l 1 y hy)
        rw [map_add, map_add, hy0, zero_add, hpd, MvPolynomial.eval_C, map_sum, map_sum] at e
        rw [← e, Finset.sum_apply]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        simp [hF j]
      · intro hw
        induction hw using Submodule.span_induction with
        | mem x hx =>
          obtain ⟨j, rfl⟩ := hx
          have ht := h_taylor K m c (F j)
          rw [hF j, MvPolynomial.C_0, sub_zero] at ht
          show wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (F j))) ∈ wcpaLquI F c 2
          have e : wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (F j))) =
              F j - (F j - wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (F j)))) := by
            ring
          rw [e, wcpaLquI]
          exact Ideal.sub_mem _ (Ideal.mem_sup_right (Ideal.subset_span ⟨j, rfl⟩))
            (Ideal.mem_sup_left ht)
        | zero => rw [hLin0]; exact Ideal.zero_mem _
        | add x y _ _ hx hy => rw [hadd]; exact Ideal.add_mem _ hx hy
        | smul a x _ hx => rw [hsmul]; exact Ideal.mul_mem_left _ _ hx
    refine ⟨α, β, ?_, ?_, hc⟩
    · intro w
      obtain ⟨a, b, hab⟩ := ha w
      refine ⟨a, b, (claim _).mp ?_⟩
      rw [hsub, hsub, hsmul, hsmul, sub_sub]
      exact hab
    · intro a b hab
      apply hb a b
      rw [← hsmul, ← hsmul, ← hadd]
      exact (claim _).mpr hab

  have t_s5 : ∀ (K : Type u) [Field K] (m r : ℕ) (F : Fin r → MvPolynomial (Fin m) K) (c : Fin m → K), (∀ j, MvPolynomial.eval c (F j) = 0) → ∀ α β : Fin m → K, wcpaLquLin c α * wcpaLquLin c β ∈ wcpaLquI F c 3 → ∃ lam : Fin r → K, (∀ l, ∑ j, lam j * MvPolynomial.eval c (MvPolynomial.pderiv l (F j)) = 0) ∧ ∀ ξ η : Fin m → K, (∀ j, ∑ l, MvPolynomial.eval c (MvPolynomial.pderiv l (F j)) * ξ l = 0) → (∀ j, ∑ l, MvPolynomial.eval c (MvPolynomial.pderiv l (F j)) * η l = 0) → ∑ a, ∑ b, ξ a * η b * ∑ j, lam j * MvPolynomial.eval c (MvPolynomial.pderiv b (MvPolynomial.pderiv a (F j))) = (∑ l, α l * ξ l) * (∑ l, β l * η l) + (∑ l, α l * η l) * (∑ l, β l * ξ l) := by
    intro K _ m r F c hF α β hc
    obtain ⟨hadd, hsub, hsmul, hmem, hpd, hev⟩ := h_lin K m c
    rw [wcpaLquI, Submodule.mem_sup] at hc
    obtain ⟨y, hy, z, hz, hyz⟩ := hc
    obtain ⟨h, rfl⟩ := (Ideal.mem_span_range_iff_exists_fun).mp hz
    obtain ⟨g, hg⟩ : ∃ g : Fin r → Fin m → K, ∀ j a,
        g j a = MvPolynomial.eval c (MvPolynomial.pderiv a (h j)) := ⟨_, fun _ _ => rfl⟩
    obtain ⟨Lf, hLf⟩ : ∃ Lf : Fin r → Fin m → K, ∀ j a,
        Lf j a = MvPolynomial.eval c (MvPolynomial.pderiv a (F j)) := ⟨_, fun _ _ => rfl⟩
    obtain ⟨H, hH⟩ : ∃ H : Fin r → Fin m → Fin m → K, ∀ j a b,
        H j a b = MvPolynomial.eval c (MvPolynomial.pderiv b (MvPolynomial.pderiv a (F j))) :=
      ⟨_, fun _ _ _ => rfl⟩
    have hy1 : ∀ a, MvPolynomial.eval c (MvPolynomial.pderiv a y) = 0 := by
      intro a
      have h2 := h_P2 K m c a 2 y hy
      exact h_P1 K m c _ (Ideal.pow_le_self two_ne_zero h2)
    have hy2 : ∀ a b, MvPolynomial.eval c (MvPolynomial.pderiv b (MvPolynomial.pderiv a y)) = 0 := by
      intro a b
      have h2 := h_P2 K m c a 2 y hy
      exact h_P1 K m c _ (by simpa using h_P2 K m c b 1 _ h2)
    have hUV1 : ∀ l, MvPolynomial.eval c (MvPolynomial.pderiv l (wcpaLquLin c α * wcpaLquLin c β)) = 0 := by
      intro l
      simp only [MvPolynomial.pderiv_mul, hpd, map_add, map_mul, MvPolynomial.eval_C, hev]
      ring
    have hUV2 : ∀ a b, MvPolynomial.eval c (MvPolynomial.pderiv b (MvPolynomial.pderiv a
        (wcpaLquLin c α * wcpaLquLin c β))) = α a * β b + α b * β a := by
      intro a b
      simp only [MvPolynomial.pderiv_mul, hpd, MvPolynomial.pderiv_C, map_add, map_mul,
        MvPolynomial.eval_C, hev]
      ring
    have hhF1 : ∀ j l, MvPolynomial.eval c (MvPolynomial.pderiv l (h j * F j)) =
        MvPolynomial.eval c (h j) * Lf j l := by
      intro j l
      rw [hLf]
      simp only [MvPolynomial.pderiv_mul, map_add, map_mul, hF j]
      ring
    have hhF2 : ∀ j a b, MvPolynomial.eval c (MvPolynomial.pderiv b (MvPolynomial.pderiv a
        (h j * F j))) = g j a * Lf j b + g j b * Lf j a + MvPolynomial.eval c (h j) * H j a b := by
      intro j a b
      rw [hg, hg, hLf, hLf, hH]
      simp only [MvPolynomial.pderiv_mul, map_add, map_mul, hF j]
      ring
    refine ⟨fun j => MvPolynomial.eval c (h j), ?_, ?_⟩
    · intro l
      have e := congrArg (fun p => MvPolynomial.eval c (MvPolynomial.pderiv l p)) hyz
      rw [hUV1, map_add, map_add, hy1, zero_add, map_sum, map_sum] at e
      simp only [hhF1] at e
      rw [← e]
      exact Finset.sum_congr rfl (fun j _ => by rw [hLf])
    · intro ξ η hξ hη
      simp only [← hLf] at hξ hη
      simp only [← hH]
      have hE : ∀ a b, ∑ j, MvPolynomial.eval c (h j) * H j a b =
          (α a * β b + α b * β a) - ∑ j, (g j a * Lf j b + g j b * Lf j a) := by
        intro a b
        have e := congrArg (fun p => MvPolynomial.eval c (MvPolynomial.pderiv b
          (MvPolynomial.pderiv a p))) hyz
        rw [hUV2, map_add, map_add, map_add, hy2, zero_add, map_sum, map_sum, map_sum] at e
        simp only [hhF2] at e
        rw [← e, ← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl (fun j _ => by ring)
      have hj : ∀ j, ∑ a, ∑ b, ξ a * η b * (g j a * Lf j b + g j b * Lf j a) = 0 := by
        intro j
        have e : ∑ a, ∑ b, ξ a * η b * (g j a * Lf j b + g j b * Lf j a) =
            (∑ a, ξ a * g j a) * (∑ b, Lf j b * η b) + (∑ a, Lf j a * ξ a) * (∑ b, η b * g j b) := by
          rw [Finset.sum_mul_sum, Finset.sum_mul_sum, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun a _ => ?_)
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun b _ => ?_)
          ring
        rw [e, hη j, hξ j]
        ring
      calc ∑ a, ∑ b, ξ a * η b * ∑ j, MvPolynomial.eval c (h j) * H j a b
          = ∑ a, ∑ b, (ξ a * η b * (α a * β b + α b * β a) -
              ∑ j, ξ a * η b * (g j a * Lf j b + g j b * Lf j a)) := by
            refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => ?_))
            rw [hE a b, mul_sub, Finset.mul_sum]
        _ = ∑ a, ∑ b, ξ a * η b * (α a * β b + α b * β a) -
              ∑ j, ∑ a, ∑ b, ξ a * η b * (g j a * Lf j b + g j b * Lf j a) := by
            simp only [Finset.sum_sub_distrib]
            congr 1
            rw [Finset.sum_congr rfl (fun a _ => Finset.sum_comm)]
            exact Finset.sum_comm
        _ = ∑ a, ∑ b, ξ a * η b * (α a * β b + α b * β a) := by
            rw [Finset.sum_eq_zero (fun j _ => hj j), sub_zero]
        _ = (∑ l, α l * ξ l) * (∑ l, β l * η l) + (∑ l, α l * η l) * (∑ l, β l * ξ l) := by
            rw [mul_comm (∑ l, α l * η l), Finset.sum_mul_sum, Finset.sum_mul_sum,
              ← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl (fun a _ => ?_)
            rw [← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl (fun b _ => ?_)
            ring
  have t_s8 : ∀ (K : Type u) [Field K] (n r : ℕ) (L : Fin r → Fin (n + 2) → K) (ρ0 : Fin n → Fin r) (P : Fin n → Fin (n + 2)) (l : Fin (n + 2)), (∀ k, P k ≠ l) → (Matrix.of fun i k : Fin (n + 1) => Fin.snoc (α := fun _ => Fin (n + 1) → K) (fun i0 k0 => L (ρ0 i0) (Fin.snoc (α := fun _ => Fin (n + 2)) P l k0)) (fun k0 => if Fin.snoc (α := fun _ => Fin (n + 2)) P l k0 = l then (1 : K) else 0) i k).det = (Matrix.of fun i k : Fin n => L (ρ0 i) (P k)).det ∧ ∀ a, (∀ k, P k ≠ a) → a ≠ l → (Matrix.of fun i k : Fin (n + 1) => Fin.snoc (α := fun _ => Fin (n + 1) → K) (fun i0 k0 => L (ρ0 i0) (Fin.snoc (α := fun _ => Fin (n + 2)) P l k0)) (fun k0 => if Fin.snoc (α := fun _ => Fin (n + 2)) P l k0 = a then (1 : K) else 0) i k).det = 0 := by
    intro K _ n r L ρ0 P l hP
    constructor
    · rw [Matrix.det_succ_row _ (Fin.last n), Fin.sum_univ_castSucc]
      have h1 : ∀ k0 : Fin n, (Matrix.of fun i k : Fin (n + 1) => Fin.snoc (α := fun _ => Fin (n + 1) → K) (fun i0 k0 => L (ρ0 i0) (Fin.snoc (α := fun _ => Fin (n + 2)) P l k0)) (fun k0 => if Fin.snoc (α := fun _ => Fin (n + 2)) P l k0 = l then (1 : K) else 0) i k) (Fin.last n) (Fin.castSucc k0) = 0 := by
        intro k0
        simp [Fin.snoc_last, Fin.snoc_castSucc, hP k0]
      simp only [h1, mul_zero, zero_mul, Finset.sum_const_zero, zero_add]
      simp only [Matrix.of_apply, Fin.snoc_last, ite_true, Fin.succAbove_last, mul_one]
      have hs : ((-1 : K) ^ ((Fin.last n : ℕ) + (Fin.last n : ℕ))) = 1 := by
        rw [Fin.val_last]
        exact Even.neg_one_pow ⟨n, rfl⟩
      rw [hs, one_mul]
      congr 1
      ext i k
      simp [Matrix.submatrix, Fin.snoc_castSucc]
    · intro a hPa hal
      apply Matrix.det_eq_zero_of_row_eq_zero (Fin.last n)
      intro k
      refine Fin.lastCases ?_ (fun k0 => ?_) k
      · simp [Fin.snoc_last, Ne.symm hal]
      · simp [Fin.snoc_castSucc, Fin.snoc_last, hPa k0]

  have t_s9 : ∀ (K : Type u) [Field K] (m r : ℕ) (L : Fin r → Fin m → K) (α β : Fin m → K), (∀ w : Fin m → K, ∃ a b : K, w - a • α - b • β ∈ Submodule.span K (Set.range L)) → ∀ (xa xb z : Fin m → K) (a b : Fin m) (d : K), a ≠ b → d ≠ 0 → (∀ j, ∑ l, L j l * xa l = 0) → (∀ j, ∑ l, L j l * xb l = 0) → (∀ j, ∑ l, L j l * z l = 0) → xa a = d → xa b = 0 → xb b = d → xb a = 0 → (∑ l, α l * xa l) * (∑ l, β l * z l) + (∑ l, α l * z l) * (∑ l, β l * xa l) = 0 → (∑ l, α l * xb l) * (∑ l, β l * z l) + (∑ l, α l * z l) * (∑ l, β l * xb l) = 0 → z = 0 := by
    intro K _ m r L α β hB xa xb z a b d hab hd hxa hxb hz hxaa hxab hxbb hxba E1 E2
    have inj : ∀ ζ : Fin m → K, (∀ j, ∑ l, L j l * ζ l = 0) → ∑ l, α l * ζ l = 0 →
        ∑ l, β l * ζ l = 0 → ζ = 0 := by
      intro ζ hL hα hβ
      let φ : (Fin m → K) →ₗ[K] K :=
        { toFun := fun w => ∑ x, w x * ζ x
          map_add' := fun v w => by
            simp only [Pi.add_apply, add_mul, Finset.sum_add_distrib]
          map_smul' := fun s v => by
            simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.mul_sum, mul_assoc] }
      have hspan : Submodule.span K (Set.range L) ≤ LinearMap.ker φ := by
        rw [Submodule.span_le]
        rintro _ ⟨j, rfl⟩
        exact hL j
      funext l
      obtain ⟨a', b', hmem⟩ := hB (Pi.single l 1)
      have h0 : φ (Pi.single l 1 - a' • α - b' • β) = 0 := hspan hmem
      rw [map_sub, map_sub, map_smul, map_smul] at h0
      have e1 : φ (Pi.single l 1) = ζ l := by
        show ∑ x, (Pi.single l (1 : K) : Fin m → K) x * ζ x = ζ l
        simp [Pi.single_apply]
      have e2 : φ α = 0 := hα
      have e3 : φ β = 0 := hβ
      rw [e1, e2, e3] at h0
      simpa using h0
    have hlin : ∀ (f : Fin m → K) (u v : K) (x y : Fin m → K),
        ∑ l, f l * (u • x + v • y) l = u * ∑ l, f l * x l + v * ∑ l, f l * y l := by
      intro f u v x y
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, mul_add, Finset.sum_add_distrib,
        Finset.mul_sum]
      congr 1 <;> exact Finset.sum_congr rfl (fun _ _ => by ring)
    set p := ∑ l, α l * xa l with hp
    set q := ∑ l, β l * xa l with hq
    set p' := ∑ l, α l * xb l with hp'
    set q' := ∑ l, β l * xb l with hq'
    set X := ∑ l, α l * z l with hX
    set Y := ∑ l, β l * z l with hY
    have hD : p * q' - p' * q ≠ 0 := by
      intro hD
      have hz1 : q' • xa + (-q) • xb = 0 := by
        apply inj
        · intro j; rw [hlin, hxa, hxb]; ring
        · rw [hlin]; linear_combination hD
        · rw [hlin]; ring
      have hq'0 : q' = 0 := by
        have := congrFun hz1 a
        simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, hxaa, hxba, Pi.zero_apply] at this
        have h2 : q' * d = 0 := by linear_combination this
        exact (mul_eq_zero.mp h2).resolve_right hd
      have hq0 : q = 0 := by
        have := congrFun hz1 b
        simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, hxab, hxbb, Pi.zero_apply] at this
        have h2 : q * d = 0 := by linear_combination -this
        exact (mul_eq_zero.mp h2).resolve_right hd
      have hz2 : p' • xa + (-p) • xb = 0 := by
        apply inj
        · intro j; rw [hlin, hxa, hxb]; ring
        · rw [hlin]; ring
        · rw [hlin]; linear_combination -hD
      have hp0 : p = 0 := by
        have := congrFun hz2 b
        simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, hxab, hxbb, Pi.zero_apply] at this
        have h2 : p * d = 0 := by linear_combination -this
        exact (mul_eq_zero.mp h2).resolve_right hd
      have hxa0 : xa = 0 := inj xa hxa hp0 hq0
      apply hd
      rw [← hxaa, hxa0, Pi.zero_apply]
    have hY0 : Y = 0 := by
      have h : Y * (p * q' - p' * q) = 0 := by linear_combination q' * E1 - q * E2
      exact (mul_eq_zero.mp h).resolve_right hD
    have hX0 : X = 0 := by
      have h : X * (p * q' - p' * q) = 0 := by linear_combination p * E2 - p' * E1
      exact (mul_eq_zero.mp h).resolve_right hD
    exact inj z hz hX0 hY0

  have t_s2 : ∀ (K : Type u) [Field K] (m : ℕ) (Λ : Submodule K (Fin m → K)) (α β : Fin m → K), (∀ w : Fin m → K, ∃ a b : K, w - a • α - b • β ∈ Λ) → (∀ a b : K, a • α + b • β ∈ Λ → a = 0 ∧ b = 0) → Module.finrank K Λ + 2 = m := by
    intro K _ m Λ α β h1 h2
    set PP := Submodule.span K (Set.range ![α, β]) with hPP
    have hli : LinearIndependent K ![α, β] := by
      rw [LinearIndependent.pair_iff]
      intro s t hst
      exact h2 s t (by rw [hst]; exact Λ.zero_mem)
    have hrank : Module.finrank K PP = 2 := by
      rw [hPP, finrank_span_eq_card hli, Fintype.card_fin]
    have hmemPP : ∀ x, x ∈ PP ↔ ∃ s t : K, s • α + t • β = x := by
      intro x
      rw [hPP, Submodule.mem_span_range_iff_exists_fun]
      constructor
      · rintro ⟨f, hf⟩
        refine ⟨f 0, f 1, ?_⟩
        rw [← hf, Fin.sum_univ_two]
        simp
      · rintro ⟨s, t, hst⟩
        refine ⟨![s, t], ?_⟩
        rw [← hst, Fin.sum_univ_two]
        simp
    have hinf : Λ ⊓ PP = ⊥ := by
      rw [Submodule.eq_bot_iff]
      intro x hx
      obtain ⟨hxΛ, hxPP⟩ := Submodule.mem_inf.mp hx
      obtain ⟨s, t, rfl⟩ := (hmemPP x).mp hxPP
      obtain ⟨hs, ht⟩ := h2 s t hxΛ
      rw [hs, ht, zero_smul, zero_smul, add_zero]
    have hsup : Λ ⊔ PP = ⊤ := by
      rw [eq_top_iff]
      intro w _
      obtain ⟨a, b, hab⟩ := h1 w
      rw [Submodule.mem_sup]
      exact ⟨_, hab, a • α + b • β, (hmemPP _).mpr ⟨a, b, rfl⟩, by abel⟩
    have h := Submodule.finrank_sup_add_finrank_inf_eq Λ PP
    rw [hsup, hinf, finrank_top, finrank_bot, Module.finrank_fin_fun, hrank] at h
    omega

  have t_s1 : ∀ (K : Type u) [Field K] (m : ℕ) (ι : Type) [Fintype ι] (v : ι → Fin m → K), (∀ z : Fin m → K, (∀ i, ∑ l, z l * v i l = 0) → z = 0) → ∃ σ : Fin m → ι, (Matrix.of fun i l => v (σ i) l).det ≠ 0 := by
    intro K _ m ι _ v hv
    have htop : Submodule.span K (Set.range v) = ⊤ := by
      by_contra hne
      obtain ⟨f, hf0, hfk⟩ := Submodule.exists_le_ker_of_lt_top _ (lt_top_iff_ne_top.mpr hne)
      set z : Fin m → K := fun l => f (fun j => if l = j then 1 else 0) with hzdef
      have hfx : ∀ x, f x = ∑ l, x l * z l := by
        intro x
        rw [LinearMap.pi_apply_eq_sum_univ f x]
        simp [hzdef, smul_eq_mul]
      have hz : z = 0 := by
        apply hv
        intro i
        have : f (v i) = 0 := hfk (Submodule.subset_span ⟨i, rfl⟩)
        rw [hfx] at this
        rw [← this]
        exact Finset.sum_congr rfl (fun _ _ => mul_comm _ _)
      apply hf0
      refine LinearMap.ext (fun x => ?_)
      rw [hfx, hz]
      simp
    obtain ⟨κ, a, ha, hspan, hli⟩ := exists_linearIndependent' K v
    have : Fintype κ := Fintype.ofInjective a ha
    have hcard : Fintype.card κ = m := by
      have h := finrank_span_eq_card hli
      rw [hspan, htop, finrank_top, Module.finrank_fin_fun] at h
      exact h.symm
    let e : κ ≃ Fin m := Fintype.equivFinOfCardEq hcard
    refine ⟨a ∘ e.symm, ?_⟩
    have hli' : LinearIndependent K (fun i => (Matrix.of fun i l => v ((a ∘ e.symm) i) l) i) :=
      hli.comp e.symm e.symm.injective
    have hU := Matrix.linearIndependent_rows_iff_isUnit.mp hli'
    rw [Matrix.isUnit_iff_isUnit_det, isUnit_iff_ne_zero] at hU
    exact hU
  have t_s7 : ∀ (K : Type u) [Field K] (n r : ℕ) (L : Fin r → Fin (n + 2) → K) (ρ0 : Fin n → Fin r) (P : Fin n → Fin (n + 2)) (l : Fin (n + 2)) (s : Fin r), L s ∈ Submodule.span K (Set.range fun i => L (ρ0 i)) → ∑ a, L s a * (Matrix.of fun i k : Fin (n + 1) => Fin.snoc (α := fun _ => Fin (n + 1) → K) (fun i0 k0 => L (ρ0 i0) (Fin.snoc (α := fun _ => Fin (n + 2)) P l k0)) (fun k0 => if Fin.snoc (α := fun _ => Fin (n + 2)) P l k0 = a then (1 : K) else 0) i k).det = 0 := by
    intro K _ n r L ρ0 P l s hs
    set κ : Fin (n + 1) → Fin (n + 2) := Fin.snoc (α := fun _ => Fin (n + 2)) P l with hκ
    have hlap : ∀ v : Fin (n + 1) → K,
        (Matrix.of fun i k : Fin (n + 1) => Fin.snoc (α := fun _ => Fin (n + 1) → K)
          (fun i0 k0 => L (ρ0 i0) (κ k0)) v i k).det =
        ∑ k : Fin (n + 1), (-1 : K) ^ ((k : ℕ) + n) * v k *
          (Matrix.of fun i k' : Fin n => L (ρ0 i) (κ (k.succAbove k'))).det := by
      intro v
      rw [Matrix.det_succ_row _ (Fin.last n)]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      simp only [Matrix.of_apply, Fin.snoc_last, Fin.val_last, Fin.succAbove_last]
      rw [add_comm n (k : ℕ)]
      congr 1
      congr 1
      ext i k'
      simp [Matrix.submatrix, Fin.snoc_castSucc]
    rw [Finset.sum_congr rfl (fun a _ => by rw [hlap])]
    have h2 : ∑ a, L s a * ∑ k : Fin (n + 1), (-1 : K) ^ ((k : ℕ) + n) * (if κ k = a then (1 : K) else 0) *
          (Matrix.of fun i k' : Fin n => L (ρ0 i) (κ (k.succAbove k'))).det =
        ∑ k : Fin (n + 1), (-1 : K) ^ ((k : ℕ) + n) * L s (κ k) *
          (Matrix.of fun i k' : Fin n => L (ρ0 i) (κ (k.succAbove k'))).det := by
      simp only [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      have : ∀ a, L s a * ((-1 : K) ^ ((k : ℕ) + n) * (if κ k = a then (1 : K) else 0) *
          (Matrix.of fun i k' : Fin n => L (ρ0 i) (κ (k.succAbove k'))).det) =
          if κ k = a then (-1 : K) ^ ((k : ℕ) + n) * L s (κ k) *
            (Matrix.of fun i k' : Fin n => L (ρ0 i) (κ (k.succAbove k'))).det else 0 := by
        intro a
        split_ifs with h
        · rw [← h]; ring
        · ring
      rw [Finset.sum_congr rfl (fun a _ => this a), Finset.sum_ite_eq]
      simp
    rw [h2, ← hlap (fun k => L s (κ k))]
    rw [← Matrix.exists_vecMul_eq_zero_iff]
    obtain ⟨cf, hcf⟩ := (Submodule.mem_span_range_iff_exists_fun K).mp hs
    refine ⟨Fin.snoc (α := fun _ => K) (fun i => -cf i) 1, ?_, ?_⟩
    · intro h0
      have := congrFun h0 (Fin.last n)
      simp at this
    · funext k
      rw [Matrix.vecMul, dotProduct, Fin.sum_univ_castSucc]
      simp only [Matrix.of_apply, Fin.snoc_castSucc, Fin.snoc_last, one_mul, Pi.zero_apply]
      have hk := congrFun hcf (κ k)
      rw [Finset.sum_apply] at hk
      simp only [Pi.smul_apply, smul_eq_mul] at hk
      rw [← hk]
      simp [neg_mul, Finset.sum_neg_distrib]

  have t_s3 : ∀ (K : Type u) [Field K] (n r : ℕ) (L : Fin r → Fin (n + 2) → K), Module.finrank K (Submodule.span K (Set.range L)) = n → ∃ (ρ0 : Fin n → Fin r) (P : Fin n → Fin (n + 2)), (∀ s, L s ∈ Submodule.span K (Set.range fun i => L (ρ0 i))) ∧ (Matrix.of fun i k : Fin n => L (ρ0 i) (P k)).det ≠ 0 ∧ ∃ a b : Fin (n + 2), a ≠ b ∧ (∀ k, P k ≠ a) ∧ (∀ k, P k ≠ b) := by
    intro K _ n r L hrank
    obtain ⟨κ, a₁, ha₁, hspan₁, hli₁⟩ := exists_linearIndependent' K L
    have : Fintype κ := Fintype.ofInjective a₁ ha₁
    have hcard : Fintype.card κ = n := by
      have h := finrank_span_eq_card hli₁
      rw [hspan₁, hrank] at h
      exact h.symm
    let e : κ ≃ Fin n := Fintype.equivFinOfCardEq hcard
    set ρ0 : Fin n → Fin r := a₁ ∘ e.symm with hρ0
    have hrange : Set.range (fun i => L (ρ0 i)) = Set.range (L ∘ a₁) := by
      rw [hρ0]
      exact (e.symm.surjective.range_comp (L ∘ a₁))
    have hli0 : LinearIndependent K (fun i => L (ρ0 i)) := hli₁.comp e.symm e.symm.injective
    let R : Matrix (Fin n) (Fin (n + 2)) K := Matrix.of fun i l => L (ρ0 i) l
    have hRrank : R.rank = n := by
      rw [Matrix.rank_eq_finrank_span_row]
      have h := finrank_span_eq_card (R := K) (b := fun i => R i) hli0
      rw [Fintype.card_fin] at h
      exact h
    rw [Matrix.rank_eq_finrank_span_cols] at hRrank
    obtain ⟨κ', a₂, ha₂, hspan₂, hli₂⟩ := exists_linearIndependent' K R.col
    have : Fintype κ' := Fintype.ofInjective a₂ ha₂
    have hcard' : Fintype.card κ' = n := by
      have h := finrank_span_eq_card hli₂
      rw [hspan₂, hRrank] at h
      exact h.symm
    let e' : κ' ≃ Fin n := Fintype.equivFinOfCardEq hcard'
    set P : Fin n → Fin (n + 2) := a₂ ∘ e'.symm with hP
    have hPinj : Function.Injective P := ha₂.comp e'.symm.injective
    refine ⟨ρ0, P, ?_, ?_, ?_⟩
    · intro s
      rw [hrange, hspan₁]
      exact Submodule.subset_span ⟨s, rfl⟩
    · have hliN : LinearIndependent K (fun k => Matrix.transpose (Matrix.of fun i k : Fin n => L (ρ0 i) (P k)) k) :=
        hli₂.comp e'.symm e'.symm.injective
      have hU := Matrix.linearIndependent_cols_iff_isUnit.mp hliN
      rw [Matrix.isUnit_iff_isUnit_det, isUnit_iff_ne_zero] at hU
      exact hU
    · have hc : (Finset.univ.image P)ᶜ.card = 2 := by
        rw [Finset.card_compl, Finset.card_image_of_injective _ hPinj, Finset.card_univ,
          Fintype.card_fin, Fintype.card_fin]
        omega
      obtain ⟨a, ha, b, hb, hab⟩ := Finset.one_lt_card.mp (by rw [hc]; norm_num)
      refine ⟨a, b, hab, ?_, ?_⟩
      · intro k hk
        apply Finset.mem_compl.mp ha
        exact Finset.mem_image.mpr ⟨k, Finset.mem_univ _, hk⟩
      · intro k hk
        apply Finset.mem_compl.mp hb
        exact Finset.mem_image.mpr ⟨k, Finset.mem_univ _, hk⟩
  have t_s6 : ∀ (K : Type u) [Field K] (n r : ℕ) (F : Fin r → MvPolynomial (Fin (n + 2)) K) (c : Fin (n + 2) → K) (ρ0 : Fin n → Fin r) (P : Fin n → Fin (n + 2)) (l : Fin (n + 2)) (lam : Fin r → K), (∀ l', ∑ j, lam j * MvPolynomial.eval c (MvPolynomial.pderiv l' (F j)) = 0) → ∀ η : Fin (n + 2) → K, ∑ l', η l' * ∑ j, lam j * MvPolynomial.eval c (MvPolynomial.pderiv l' (Matrix.of fun i k : Fin (n + 1) => MvPolynomial.pderiv (Fin.snoc (α := fun _ => Fin (n + 2)) P l k) (F (Fin.snoc (α := fun _ => Fin r) ρ0 j i))).det) = ∑ a, ∑ b, (Matrix.of fun i k : Fin (n + 1) => Fin.snoc (α := fun _ => Fin (n + 1) → K) (fun i0 k0 => MvPolynomial.eval c (MvPolynomial.pderiv (Fin.snoc (α := fun _ => Fin (n + 2)) P l k0) (F (ρ0 i0)))) (fun k0 => if Fin.snoc (α := fun _ => Fin (n + 2)) P l k0 = a then (1 : K) else 0) i k).det * η b * ∑ j, lam j * MvPolynomial.eval c (MvPolynomial.pderiv b (MvPolynomial.pderiv a (F j))) := by
    intro K _ n r F c ρ0 P l lam hlam η
    set κ : Fin (n + 1) → Fin (n + 2) := Fin.snoc (α := fun _ => Fin (n + 2)) P l with hκ
    obtain ⟨H2, hH2⟩ : ∃ H2 : Fin r → Fin (n + 2) → Fin (n + 2) → K, ∀ j a b,
        H2 j a b = MvPolynomial.eval c (MvPolynomial.pderiv b (MvPolynomial.pderiv a (F j))) :=
      ⟨_, fun _ _ _ => rfl⟩
    obtain ⟨Lf, hLf⟩ : ∃ Lf : Fin r → Fin (n + 2) → K, ∀ j a,
        Lf j a = MvPolynomial.eval c (MvPolynomial.pderiv a (F j)) := ⟨_, fun _ _ => rfl⟩
    obtain ⟨G, hG⟩ : ∃ G : Fin (n + 2) → Fin (n + 2) → K, ∀ a b,
        G a b = ∑ j, lam j * H2 j a b := ⟨_, fun _ _ => rfl⟩
    have hlam' : ∀ a, ∑ j, lam j * Lf j a = 0 := by
      intro a
      simp only [hLf]
      exact hlam a
    simp only [← hH2, ← hLf]
    simp only [← hG]
    obtain ⟨Q, hQ⟩ : ∃ Q : Fin (n + 1) → MvPolynomial (Fin (n + 2)) K, ∀ k, Q k =
        (Matrix.of fun i k' : Fin n => MvPolynomial.pderiv (κ (k.succAbove k')) (F (ρ0 i))).det :=
      ⟨_, fun _ => rfl⟩
    obtain ⟨q, hq⟩ : ∃ q : Fin (n + 1) → K, ∀ k, q k = MvPolynomial.eval c (Q k) :=
      ⟨_, fun _ => rfl⟩
    have hq' : ∀ k, q k = (Matrix.of fun i k' : Fin n => Lf (ρ0 i) (κ (k.succAbove k'))).det := by
      intro k
      rw [hq, hQ, RingHom.map_det]
      congr 1
      ext i k'
      simp [RingHom.mapMatrix_apply, Matrix.map_apply, hLf]
    have hA : ∀ j, (Matrix.of fun i k : Fin (n + 1) => MvPolynomial.pderiv (κ k)
        (F (Fin.snoc (α := fun _ => Fin r) ρ0 j i))).det =
        ∑ k : Fin (n + 1), (-1 : MvPolynomial (Fin (n + 2)) K) ^ (n + (k : ℕ)) *
          MvPolynomial.pderiv (κ k) (F j) * Q k := by
      intro j
      rw [Matrix.det_succ_row _ (Fin.last n)]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      simp only [Matrix.of_apply, Fin.snoc_last, Fin.val_last, Fin.succAbove_last]
      rw [hQ]
      congr 1
      congr 1
      ext i k'
      simp [Matrix.submatrix, Fin.snoc_castSucc]
    have hsign : ∀ k : Fin (n + 1), (-1 : MvPolynomial (Fin (n + 2)) K) ^ (n + (k : ℕ)) =
        MvPolynomial.C ((-1 : K) ^ (n + (k : ℕ))) := by
      intro k
      rw [map_pow, map_neg, map_one]
    have hB : ∀ j l', MvPolynomial.eval c (MvPolynomial.pderiv l'
        (Matrix.of fun i k : Fin (n + 1) => MvPolynomial.pderiv (κ k)
          (F (Fin.snoc (α := fun _ => Fin r) ρ0 j i))).det) =
        ∑ k : Fin (n + 1), (-1 : K) ^ (n + (k : ℕ)) * (H2 j (κ k) l' * q k +
          Lf j (κ k) * MvPolynomial.eval c (MvPolynomial.pderiv l' (Q k))) := by
      intro j l'
      rw [hA j, map_sum, map_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [hsign k, mul_assoc, MvPolynomial.pderiv_C_mul, MvPolynomial.pderiv_mul, hH2, hLf, hq]
      simp only [map_mul, map_add, MvPolynomial.eval_C]
    have hC : ∀ l', ∑ j, lam j * MvPolynomial.eval c (MvPolynomial.pderiv l'
        (Matrix.of fun i k : Fin (n + 1) => MvPolynomial.pderiv (κ k)
          (F (Fin.snoc (α := fun _ => Fin r) ρ0 j i))).det) =
        ∑ k : Fin (n + 1), (-1 : K) ^ (n + (k : ℕ)) * q k * G (κ k) l' := by
      intro l'
      simp only [hB, Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      calc ∑ j, lam j * ((-1 : K) ^ (n + (k : ℕ)) * (H2 j (κ k) l' * q k +
            Lf j (κ k) * MvPolynomial.eval c (MvPolynomial.pderiv l' (Q k))))
          = ∑ j, ((-1 : K) ^ (n + (k : ℕ)) * q k * (lam j * H2 j (κ k) l') +
            (-1 : K) ^ (n + (k : ℕ)) * MvPolynomial.eval c (MvPolynomial.pderiv l' (Q k)) *
              (lam j * Lf j (κ k))) :=
            Finset.sum_congr rfl (fun j _ => by ring)
        _ = (-1 : K) ^ (n + (k : ℕ)) * q k * ∑ j, lam j * H2 j (κ k) l' +
            (-1 : K) ^ (n + (k : ℕ)) * MvPolynomial.eval c (MvPolynomial.pderiv l' (Q k)) *
              ∑ j, lam j * Lf j (κ k) := by
            rw [Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]
        _ = (-1 : K) ^ (n + (k : ℕ)) * q k * G (κ k) l' := by
            rw [hlam' (κ k), mul_zero, add_zero, hG]
    have hD : ∀ a, (Matrix.of fun i k : Fin (n + 1) => Fin.snoc (α := fun _ => Fin (n + 1) → K)
        (fun i0 k0 => Lf (ρ0 i0) (κ k0)) (fun k0 => if κ k0 = a then (1 : K) else 0) i k).det =
        ∑ k : Fin (n + 1), (-1 : K) ^ (n + (k : ℕ)) * (if κ k = a then (1 : K) else 0) * q k := by
      intro a
      rw [Matrix.det_succ_row _ (Fin.last n)]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      simp only [Matrix.of_apply, Fin.snoc_last, Fin.val_last, Fin.succAbove_last]
      rw [hq' k]
      congr 1
      congr 1
      ext i k'
      simp [Matrix.submatrix, Fin.snoc_castSucc]
    rw [Finset.sum_congr rfl (fun l' _ => by rw [hC l'])]
    simp only [hD]
    conv_rhs => rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun b _ => ?_)
    simp only [Finset.sum_mul]
    conv_rhs => rw [Finset.sum_comm]
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    have e : ∀ a, (-1 : K) ^ (n + (k : ℕ)) * (if κ k = a then (1 : K) else 0) * q k * η b * G a b =
        if κ k = a then (-1 : K) ^ (n + (k : ℕ)) * q k * η b * G a b else 0 := by
      intro a
      split_ifs with h
      · ring
      · ring
    rw [Finset.sum_congr rfl (fun a _ => e a), Finset.sum_ite_eq]
    simp only [Finset.mem_univ, ite_true]
    ring
  intro K _ m r F c hF hPNT
  obtain ⟨α, β, hB1, hB2, hB3⟩ := t_s4 K m r F c hF hPNT
  have hdim := t_s2 K m _ α β hB1 hB2
  obtain ⟨n, rfl⟩ : ∃ n, m = n + 2 := ⟨m - 2, by omega⟩
  set L : Fin r → Fin (n + 2) → K := fun j l => MvPolynomial.eval c (MvPolynomial.pderiv l (F j))
    with hLdef
  obtain ⟨ρ0, P, hspan, hN, a, b, hab, hPa, hPb⟩ :=
    t_s3 K n r L (by omega)
  obtain ⟨lam, hlam, hquad⟩ := t_s5 K (n + 2) r F c hF α β hB3
  refine t_s1 K (n + 2) _
    (fun s l => MvPolynomial.eval c (MvPolynomial.pderiv l (wcpaLquGen F s))) ?_
  intro z hz
  have hzT : ∀ j, ∑ l, L j l * z l = 0 := by
    intro j
    have h : ∑ l, z l * MvPolynomial.eval c (MvPolynomial.pderiv l (F j)) = 0 := hz (Sum.inl j)
    rw [← h]
    exact Finset.sum_congr rfl (fun l _ => mul_comm _ _)
  let xt : Fin (n + 2) → Fin (n + 2) → K := fun l0 a' =>
    (Matrix.of fun i k : Fin (n + 1) => Fin.snoc (α := fun _ => Fin (n + 1) → K)
      (fun i0 k0 => L (ρ0 i0) (Fin.snoc (α := fun _ => Fin (n + 2)) P l0 k0))
      (fun k0 => if Fin.snoc (α := fun _ => Fin (n + 2)) P l0 k0 = a' then (1 : K) else 0) i k).det
  have hxT : ∀ l0, ∀ j, ∑ l, L j l * xt l0 l = 0 := fun l0 j =>
    t_s7 K n r L ρ0 P l0 j (hspan j)
  have key : ∀ l0, (∑ l, α l * xt l0 l) * (∑ l, β l * z l) +
      (∑ l, α l * z l) * (∑ l, β l * xt l0 l) = 0 := by
    intro l0
    have h6 := t_s6 K n r F c ρ0 P l0 lam hlam z
    have hq := hquad (xt l0) z (hxT l0) hzT
    have hLHS0 : ∑ l', z l' * ∑ j, lam j * MvPolynomial.eval c (MvPolynomial.pderiv l'
        (Matrix.of fun i k : Fin (n + 1) => MvPolynomial.pderiv
          (Fin.snoc (α := fun _ => Fin (n + 2)) P l0 k)
          (F (Fin.snoc (α := fun _ => Fin r) ρ0 j i))).det) = 0 := by
      simp only [Finset.mul_sum]
      rw [Finset.sum_comm]
      apply Finset.sum_eq_zero
      intro j _
      have h : ∑ l', z l' * MvPolynomial.eval c (MvPolynomial.pderiv l'
          (Matrix.of fun i k : Fin (n + 1) => MvPolynomial.pderiv
            (Fin.snoc (α := fun _ => Fin (n + 2)) P l0 k)
            (F (Fin.snoc (α := fun _ => Fin r) ρ0 j i))).det) = 0 :=
        hz (Sum.inr (Fin.snoc (α := fun _ => Fin r) ρ0 j, Fin.snoc (α := fun _ => Fin (n + 2)) P l0))
      calc ∑ l', z l' * (lam j * MvPolynomial.eval c (MvPolynomial.pderiv l'
            (Matrix.of fun i k : Fin (n + 1) => MvPolynomial.pderiv
              (Fin.snoc (α := fun _ => Fin (n + 2)) P l0 k)
              (F (Fin.snoc (α := fun _ => Fin r) ρ0 j i))).det))
          = lam j * ∑ l', z l' * MvPolynomial.eval c (MvPolynomial.pderiv l'
            (Matrix.of fun i k : Fin (n + 1) => MvPolynomial.pderiv
              (Fin.snoc (α := fun _ => Fin (n + 2)) P l0 k)
              (F (Fin.snoc (α := fun _ => Fin r) ρ0 j i))).det) := by
            rw [Finset.mul_sum]
            exact Finset.sum_congr rfl (fun l _ => by ring)
        _ = 0 := by rw [h, mul_zero]
    rw [← hq]
    exact h6.symm.trans hLHS0
  have hda := t_s8 K n r L ρ0 P a hPa
  have hdb := t_s8 K n r L ρ0 P b hPb
  exact t_s9 K (n + 2) r L α β hB1 (xt a) (xt b) z a b _ hab hN (hxT a) (hxT b)
    hzT hda.1 (hda.2 b hPb hab.symm) hdb.1 (hdb.2 a hPa hab) (key a) (key b)

theorem wcpa_dj_sno_chart_presentation : ∀ (T Z : Scheme.{u}) (u : Z ⟶ T), Flat u → LocallyOfFinitePresentation u → ∀ z : Z, ∃ (U : T.Opens) (hU : IsAffineOpen U) (V : Z.Opens) (hV : IsAffineOpen V) (e : V ≤ u ⁻¹ᵁ U) (_ : z ∈ V) (m r : ℕ) (p : MvPolynomial (Fin m) Γ(T, U) →+* Γ(Z, V)) (F : Fin r → MvPolynomial (Fin m) Γ(T, U)), p.comp MvPolynomial.C = (u.appLE U V e).hom ∧ Function.Surjective p ∧ RingHom.ker p = Ideal.span (Set.range F) ∧ (u.appLE U V e).hom.Flat :=
by
  intro T Z u hfl hfp z
  haveI := hfl
  haveI := hfp
  obtain ⟨U, hU, huz, -⟩ :=
    exists_isAffineOpen_mem_and_subset (x := u z) (U := (⊤ : T.Opens)) trivial
  have hz : z ∈ u ⁻¹ᵁ U := (Scheme.Hom.mem_preimage u).mpr huz
  obtain ⟨V, hV, hzV, hVsub⟩ := exists_isAffineOpen_mem_and_subset hz
  have e : V ≤ u ⁻¹ᵁ U := fun x hx => hVsub hx
  have hflat := Flat.flat_appLE u hU hV e
  have hfpφ := Scheme.Hom.finitePresentation_appLE u hU hV e
  letI : Algebra Γ(T, U) Γ(Z, V) := (u.appLE U V e).hom.toAlgebra
  haveI hFP : Algebra.FinitePresentation Γ(T, U) Γ(Z, V) := hfpφ
  obtain ⟨n, f, hsurj, hfg⟩ := hFP.out
  obtain ⟨r, F, hF⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hfg
  refine ⟨U, hU, V, hV, e, hzV, n, r, f.toRingHom, F, ?_, hsurj, ?_, hflat⟩
  · exact RingHom.ext fun a => f.commutes a
  · exact hF.symm

theorem wcpa_dj_lqu_sp_stalk_loc : ∀ (L : Type u) [Field L] (T : Type u) [CommRing T] [Algebra L T] (X : Scheme.{u}) (a : X ⟶ Spec (.of L)) (ι : Spec (.of T) ⟶ X), IsOpenImmersion ι → ι ≫ a = Spec.map (CommRingCat.ofHom (algebraMap L T)) → ∀ x : Spec (.of T), ∃ σ : T →+* X.presheaf.stalk (ι x), σ.comp (algebraMap L T) = ((Scheme.ΓSpecIso (.of L)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ (ι x) trivial).hom ∧ (∀ t, t ∉ x.asIdeal → IsUnit (σ t)) ∧ (∀ y, ∃ t s, s ∉ x.asIdeal ∧ y * σ s = σ t) ∧ (∀ t, σ t = 0 → ∃ s, s ∉ x.asIdeal ∧ s * t = 0) :=
by
  intro L _ T _ _ X a ι hι hιa x
  classical
  let x' : PrimeSpectrum T := x
  have : x'.asIdeal.IsPrime := x'.isPrime
  have : IsIso (ι.stalkMap x) := inferInstance
  let Θ : X.presheaf.stalk (ι x) ≃+* (Spec (.of T)).presheaf.stalk x :=
    (asIso (ι.stalkMap x)).commRingCatIsoToRingEquiv
  let τ : T →+* (Spec (.of T)).presheaf.stalk x :=
    ((Scheme.ΓSpecIso (.of T)).inv ≫ (Spec (.of T)).presheaf.germ ⊤ x trivial).hom
  let Φ : Localization.AtPrime x'.asIdeal ≃+* (Spec (.of T)).presheaf.stalk x :=
    (Spec.stalkIso (CommRingCat.of T) x').symm.commRingCatIsoToRingEquiv
  have hK : ∀ t, τ t = Φ (algebraMap T _ t) := by
    intro t
    have h := Spec.algebraMap_stalkIso_inv (R := CommRingCat.of T) x'
    have h2 := congrArg (fun f => f.hom t) h
    simp only [CommRingCat.hom_comp, RingHom.comp_apply, CommRingCat.hom_ofHom] at h2
    exact h2.symm
  have hstar : (Scheme.ΓSpecIso (.of L)).inv ≫ a.appTop ≫ X.presheaf.germ ⊤ (ι x) trivial ≫
      ι.stalkMap x = CommRingCat.ofHom (algebraMap L T) ≫ (Scheme.ΓSpecIso (.of T)).inv ≫
      (Spec (.of T)).presheaf.germ ⊤ x trivial := by
    have hg : X.presheaf.germ ⊤ (ι x) trivial ≫ ι.stalkMap x =
        ι.appTop ≫ (Spec (.of T)).presheaf.germ ⊤ x trivial :=
      Scheme.Hom.germ_stalkMap ι ⊤ x trivial
    rw [hg, ← Category.assoc a.appTop, ← Scheme.Hom.comp_appTop, hιa, ← Category.assoc,
      ← Scheme.ΓSpecIso_inv_naturality, Category.assoc]
  have hC : ∀ l, Θ (((Scheme.ΓSpecIso (.of L)).inv ≫ a.appTop ≫
      X.presheaf.germ ⊤ (ι x) trivial).hom l) = τ (algebraMap L T l) := by
    intro l
    have h2 := congrArg (fun f => f.hom l) hstar
    exact h2
  refine ⟨(Θ.symm : _ →+* _).comp τ, ?_, ?_, ?_, ?_⟩
  · apply RingHom.ext
    intro l
    rw [RingHom.comp_apply, RingHom.comp_apply, ← hC]
    exact Θ.symm_apply_apply _
  · intro t ht
    have h1 : IsUnit (algebraMap T (Localization.AtPrime x'.asIdeal) t) :=
      IsLocalization.map_units (Localization.AtPrime x'.asIdeal)
        (⟨t, ht⟩ : x'.asIdeal.primeCompl)
    have h2 : IsUnit (τ t) := by rw [hK]; exact h1.map Φ
    exact h2.map Θ.symm
  · intro y
    obtain ⟨⟨t, s⟩, hts⟩ := IsLocalization.surj x'.asIdeal.primeCompl (Φ.symm (Θ y))
    refine ⟨t, s, s.2, ?_⟩
    show y * Θ.symm (τ s) = Θ.symm (τ t)
    apply Θ.injective
    rw [map_mul, RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply, hK, hK]
    have h3 := congrArg Φ hts
    rw [map_mul, RingEquiv.apply_symm_apply] at h3
    exact h3
  · intro t ht
    have h1 : τ t = 0 := by
      have h0 : Θ.symm (τ t) = 0 := ht
      have := congrArg Θ h0
      rwa [RingEquiv.apply_symm_apply, map_zero] at this
    rw [hK] at h1
    have h2 : algebraMap T (Localization.AtPrime x'.asIdeal) t = 0 := by
      have := congrArg Φ.symm h1
      rwa [RingEquiv.symm_apply_apply, map_zero] at this
    obtain ⟨m, hm⟩ := (IsLocalization.map_eq_zero_iff x'.asIdeal.primeCompl _ t).mp h2
    exact ⟨m, m.2, hm⟩

theorem wcpa_dj_lqu_sp_pres_basechange : ∀ (A B : Type u) [CommRing A] [CommRing B] [Algebra A B] (m r : ℕ) (p : MvPolynomial (Fin m) A →+* B) (F : Fin r → MvPolynomial (Fin m) A), p.comp MvPolynomial.C = algebraMap A B → Function.Surjective p → RingHom.ker p = Ideal.span (Set.range F) → ∀ (L : Type u) [CommRing L] [Algebra A L] (χ : B →+* L), χ.comp (algebraMap A B) = algebraMap A L → ∃ (P0 : MvPolynomial (Fin m) L →+* TensorProduct A L B) (μ : TensorProduct A L B →+* L), P0.comp MvPolynomial.C = algebraMap L (TensorProduct A L B) ∧ Function.Surjective P0 ∧ RingHom.ker P0 = Ideal.span (Set.range fun j => MvPolynomial.map (algebraMap A L) (F j)) ∧ μ.comp P0 = MvPolynomial.eval (fun l => χ (p (MvPolynomial.X l))) ∧ ∀ b : B, μ ((1 : L) ⊗ₜ[A] b) = χ b :=
by
  intro A B _ _ _ m r p F hpC hpsurj hF L _ _ χ hχ
  classical
  let P0 : MvPolynomial (Fin m) L →+* TensorProduct A L B :=
    (MvPolynomial.aeval (fun l => (1 : L) ⊗ₜ[A] p (MvPolynomial.X l)) :
      MvPolynomial (Fin m) L →ₐ[L] TensorProduct A L B).toRingHom
  have hP0C : ∀ x : L, P0 (MvPolynomial.C x) = x ⊗ₜ[A] (1 : B) := by
    intro x
    show MvPolynomial.aeval (fun l => (1 : L) ⊗ₜ[A] p (MvPolynomial.X l)) (MvPolynomial.C x) = _
    rw [MvPolynomial.aeval_C, Algebra.TensorProduct.algebraMap_apply]
    rfl
  have hP0X : ∀ l, P0 (MvPolynomial.X l) = (1 : L) ⊗ₜ[A] p (MvPolynomial.X l) := by
    intro l
    show MvPolynomial.aeval (fun l => (1 : L) ⊗ₜ[A] p (MvPolynomial.X l)) (MvPolynomial.X l) = _
    rw [MvPolynomial.aeval_X]

  have s1 : ∀ q : MvPolynomial (Fin m) A,
      P0 (MvPolynomial.map (algebraMap A L) q) = (1 : L) ⊗ₜ[A] p q := by
    have hext : P0.comp (MvPolynomial.map (algebraMap A L)) =
        (Algebra.TensorProduct.includeRight : B →ₐ[A] TensorProduct A L B).toRingHom.comp p := by
      apply MvPolynomial.ringHom_ext
      · intro a
        rw [RingHom.comp_apply, MvPolynomial.map_C, hP0C, Algebra.TensorProduct.tmul_one_eq_one_tmul,
          ← RingHom.congr_fun hpC a]
        rfl
      · intro l
        rw [RingHom.comp_apply, MvPolynomial.map_X, hP0X]
        rfl
    intro q
    exact RingHom.congr_fun hext q

  have hsurj : Function.Surjective P0 := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact ⟨0, map_zero _⟩
    | tmul x b =>
      obtain ⟨q, rfl⟩ := hpsurj b
      refine ⟨MvPolynomial.C x * MvPolynomial.map (algebraMap A L) q, ?_⟩
      rw [map_mul, hP0C, s1, Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
    | add x y hx hy =>
      obtain ⟨a, rfl⟩ := hx
      obtain ⟨b, rfl⟩ := hy
      exact ⟨a + b, map_add _ _ _⟩

  have hle : ∀ h, P0 h = 0 →
      h ∈ Ideal.span (Set.range fun j => MvPolynomial.map (algebraMap A L) (F j)) := by
    intro h hh
    set J := Ideal.span (Set.range fun j => MvPolynomial.map (algebraMap A L) (F j)) with hJ
    let π := Ideal.Quotient.mk J
    let θ : MvPolynomial (Fin m) A →+* MvPolynomial (Fin m) L ⧸ J :=
      π.comp (MvPolynomial.map (algebraMap A L))
    have hθ : RingHom.ker p ≤ RingHom.ker θ := by
      rw [hF, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
    let β := p.liftOfSurjective hpsurj ⟨θ, hθ⟩
    have hβ : ∀ q, β (p q) = θ q := fun q => p.liftOfSurjective_comp_apply hpsurj ⟨θ, hθ⟩ q
    have hQalg : ∀ a : A, algebraMap A (MvPolynomial (Fin m) L ⧸ J) a =
        π (MvPolynomial.C (algebraMap A L a)) := by
      intro a
      show _ = Ideal.Quotient.mk J (MvPolynomial.C (algebraMap A L a))
      rw [← MvPolynomial.algebraMap_apply, Ideal.Quotient.mk_algebraMap]
    let gA : B →ₐ[A] MvPolynomial (Fin m) L ⧸ J :=
      { β with
        commutes' := fun a => by
          show β (algebraMap A B a) = _
          rw [← RingHom.congr_fun hpC a, RingHom.comp_apply, hβ, hQalg]
          show π (MvPolynomial.map (algebraMap A L) (MvPolynomial.C a)) = _
          rw [MvPolynomial.map_C] }
    let fA : L →ₐ[A] MvPolynomial (Fin m) L ⧸ J :=
      { π.comp MvPolynomial.C with
        commutes' := fun a => by
          rw [hQalg]
          rfl }
    let R := Algebra.TensorProduct.lift fA gA (fun _ _ => Commute.all _ _)
    have hR : R.toRingHom.comp P0 = π := by
      apply MvPolynomial.ringHom_ext
      · intro x
        rw [RingHom.comp_apply, hP0C]
        show R (x ⊗ₜ[A] (1 : B)) = _
        rw [Algebra.TensorProduct.lift_tmul, map_one, mul_one]
        rfl
      · intro l
        rw [RingHom.comp_apply, hP0X]
        show R ((1 : L) ⊗ₜ[A] p (MvPolynomial.X l)) = _
        rw [Algebra.TensorProduct.lift_tmul, map_one, one_mul]
        show β (p (MvPolynomial.X l)) = _
        rw [hβ]
        show π (MvPolynomial.map (algebraMap A L) (MvPolynomial.X l)) = _
        rw [MvPolynomial.map_X]
    have h1 : π h = 0 := by
      rw [← hR, RingHom.comp_apply, hh, map_zero]
    exact Ideal.Quotient.eq_zero_iff_mem.mp h1

  let χA : B →ₐ[A] L := { χ with commutes' := fun a => RingHom.congr_fun hχ a }
  let μ : TensorProduct A L B →+* L :=
    (Algebra.TensorProduct.lift (AlgHom.id A L) χA (fun _ _ => Commute.all _ _)).toRingHom
  have hμ : ∀ (x : L) (b : B), μ (x ⊗ₜ[A] b) = x * χ b := by
    intro x b
    show Algebra.TensorProduct.lift (AlgHom.id A L) χA (fun _ _ => Commute.all _ _) (x ⊗ₜ[A] b) = _
    rw [Algebra.TensorProduct.lift_tmul]
    rfl
  refine ⟨P0, μ, ?_, hsurj, ?_, ?_, ?_⟩
  · exact RingHom.ext fun x => by
      rw [RingHom.comp_apply, hP0C, Algebra.TensorProduct.algebraMap_apply]
      rfl
  · apply le_antisymm
    · intro h hh
      exact hle h (RingHom.mem_ker.mp hh)
    · rw [Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      rw [SetLike.mem_coe, RingHom.mem_ker, s1]
      have hFj : p (F j) = 0 := by
        have hmem : F j ∈ RingHom.ker p := by
          rw [hF]
          exact Ideal.subset_span ⟨j, rfl⟩
        exact RingHom.mem_ker.mp hmem
      rw [hFj, TensorProduct.tmul_zero]
  · apply MvPolynomial.ringHom_ext
    · intro x
      rw [RingHom.comp_apply, hP0C, hμ, map_one, mul_one, MvPolynomial.eval_C]
    · intro l
      rw [RingHom.comp_apply, hP0X, hμ, one_mul, MvPolynomial.eval_X]
  · intro b
    rw [hμ, one_mul]

theorem wcpa_dj_lqu_sp_trunc_transfer : ∀ (K : Type u) [Field K] (m r : ℕ) (F : Fin r → MvPolynomial (Fin m) K) (c : Fin m → K), (∀ j, MvPolynomial.eval c (F j) = 0) → ∀ (R : Type u) [CommRing R] [IsLocalRing R] (ρ : MvPolynomial (Fin m) K →+* R), (∀ h, MvPolynomial.eval c h ≠ 0 → IsUnit (ρ h)) → (∀ j, ρ (F j) = 0) → (∀ y : R, ∃ h s : MvPolynomial (Fin m) K, MvPolynomial.eval c s ≠ 0 ∧ y * ρ s = ρ h) → (∀ h, ρ h = 0 → ∃ s, MvPolynomial.eval c s ≠ 0 ∧ s * h ∈ Ideal.span (Set.range F)) → (∀ (n : ℕ) (y : R), ∃ h, y - ρ h ∈ IsLocalRing.maximalIdeal R ^ n) ∧ (∀ (n : ℕ) (h : MvPolynomial (Fin m) K), ρ h ∈ IsLocalRing.maximalIdeal R ^ n ↔ h ∈ Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) ^ n ⊔ Ideal.span (Set.range F)) :=
by
  intro K _ m r F c H0 R _ _ ρ H1 H2 H3 H4
  classical
  obtain ⟨Mc, hMc⟩ : ∃ Mc : Ideal (MvPolynomial (Fin m) K),
      Mc = Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) := ⟨_, rfl⟩
  obtain ⟨J, hJ⟩ : ∃ J : Ideal (MvPolynomial (Fin m) K), J = Ideal.span (Set.range F) := ⟨_, rfl⟩
  rw [← hMc, ← hJ]
  rw [← hJ] at H4

  have Hsub : ∀ h : MvPolynomial (Fin m) K, h - MvPolynomial.C (MvPolynomial.eval c h) ∈ Mc := by
    intro h
    induction h using MvPolynomial.induction_on with
    | C a =>
      rw [MvPolynomial.eval_C, sub_self]
      exact zero_mem _
    | add p q hp hq =>
      have e : p + q - MvPolynomial.C (MvPolynomial.eval c (p + q)) =
          (p - MvPolynomial.C (MvPolynomial.eval c p)) +
            (q - MvPolynomial.C (MvPolynomial.eval c q)) := by
        rw [map_add, map_add]; ring
      rw [e]
      exact add_mem hp hq
    | mul_X p k hp =>
      have e : p * MvPolynomial.X k - MvPolynomial.C (MvPolynomial.eval c (p * MvPolynomial.X k)) =
          (p - MvPolynomial.C (MvPolynomial.eval c p)) * MvPolynomial.X k +
            MvPolynomial.C (MvPolynomial.eval c p) * (MvPolynomial.X k - MvPolynomial.C (c k)) := by
        rw [map_mul, MvPolynomial.eval_X, map_mul]; ring
      rw [e]
      refine add_mem (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ ?_)
      rw [hMc]
      exact Ideal.subset_span ⟨k, rfl⟩
  have Hzero : ∀ h : MvPolynomial (Fin m) K, MvPolynomial.eval c h = 0 → h ∈ Mc := by
    intro h hh
    have := Hsub h
    rwa [hh, map_zero, sub_zero] at this

  have Ginv : ∀ (t : MvPolynomial (Fin m) K) (n : ℕ), MvPolynomial.eval c t ≠ 0 →
      ∃ t' : MvPolynomial (Fin m) K, 1 - t * t' ∈ Mc ^ n := by
    intro t n ht
    obtain ⟨z, hz⟩ : ∃ z : MvPolynomial (Fin m) K,
        z = 1 - MvPolynomial.C (MvPolynomial.eval c t)⁻¹ * t := ⟨_, rfl⟩
    have hz0 : z ∈ Mc := by
      apply Hzero
      rw [hz, map_sub, map_one, map_mul, MvPolynomial.eval_C, inv_mul_cancel₀ ht, sub_self]
    refine ⟨MvPolynomial.C (MvPolynomial.eval c t)⁻¹ * ∑ i ∈ Finset.range n, z ^ i, ?_⟩
    have e : 1 - t * (MvPolynomial.C (MvPolynomial.eval c t)⁻¹ * ∑ i ∈ Finset.range n, z ^ i)
        = z ^ n := by
      have h2 := mul_neg_geom_sum z n
      have h3 : t * (MvPolynomial.C (MvPolynomial.eval c t)⁻¹ * ∑ i ∈ Finset.range n, z ^ i) =
          (1 - z) * ∑ i ∈ Finset.range n, z ^ i := by
        rw [hz]; ring
      rw [h3, h2]; ring
    rw [e]
    exact Ideal.pow_mem_pow hz0 n

  have hJev : ∀ g ∈ J, MvPolynomial.eval c g = 0 := by
    intro g hg
    have hle : J ≤ RingHom.ker (MvPolynomial.eval c) := by
      rw [hJ, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact H0 j
    exact hle hg
  have hJρ : ∀ g ∈ J, ρ g = 0 := by
    intro g hg
    have hle : J ≤ RingHom.ker ρ := by
      rw [hJ, Ideal.span_le]
      rintro _ ⟨j, rfl⟩
      exact H2 j
    exact hle hg

  have T1 : ∀ h, ρ h ∈ IsLocalRing.maximalIdeal R ↔ MvPolynomial.eval c h = 0 := by
    intro h
    constructor
    · intro hm
      by_contra hne
      exact (IsLocalRing.notMem_maximalIdeal.mpr (H1 h hne)) hm
    · intro hev
      by_contra hm
      obtain ⟨y, hy⟩ := (IsLocalRing.notMem_maximalIdeal.mp hm).exists_right_inv
      obtain ⟨h', s0, hs0, hys⟩ := H3 y
      have h0 : ρ (h * h' - s0) = 0 := by
        rw [map_sub, map_mul, ← hys, ← mul_assoc, hy, one_mul, sub_self]
      obtain ⟨s2, hs2, hmem⟩ := H4 _ h0
      have h5 := hJev _ hmem
      rw [map_mul, map_sub, map_mul, hev, zero_mul, zero_sub, mul_neg, neg_eq_zero] at h5
      exact mul_ne_zero hs2 hs0 h5
  have T3 : IsLocalRing.maximalIdeal R = Ideal.map ρ Mc := by
    apply le_antisymm
    · intro y hy
      obtain ⟨h, s, hs, hys⟩ := H3 y
      have hρh : ρ h ∈ IsLocalRing.maximalIdeal R := hys ▸ Ideal.mul_mem_right _ _ hy
      have hhM : h ∈ Mc := Hzero h ((T1 h).mp hρh)
      obtain ⟨b, hb⟩ := (H1 s hs).exists_right_inv
      have e : y = ρ h * b := by rw [← hys, mul_assoc, hb, mul_one]
      rw [e]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hhM)
    · rw [Ideal.map_le_iff_le_comap, hMc, Ideal.span_le]
      rintro _ ⟨l, rfl⟩
      rw [SetLike.mem_coe, Ideal.mem_comap, T1]
      simp
  have T2a : ∀ n : ℕ, Ideal.map ρ (Mc ^ n) = IsLocalRing.maximalIdeal R ^ n := fun n => by
    rw [Ideal.map_pow, ← T3]

  have CD : ∀ (n : ℕ) (h : MvPolynomial (Fin m) K), ρ h ∈ Ideal.map ρ (Mc ^ n) →
      ∃ s, MvPolynomial.eval c s ≠ 0 ∧ s * h ∈ Mc ^ n ⊔ J := by
    intro n h hh
    have key : ∀ y ∈ Ideal.map ρ (Mc ^ n), ∃ g ∈ Mc ^ n, ∃ s : MvPolynomial (Fin m) K,
        MvPolynomial.eval c s ≠ 0 ∧ y * ρ s = ρ g := by
      intro y hy
      have hy' : y ∈ Submodule.span R (⇑ρ '' ((Mc ^ n : Ideal _) : Set _)) := hy
      clear hy
      induction hy' using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨g, hg, rfl⟩ := hx
        exact ⟨g, hg, 1, by simp, by simp⟩
      | zero => exact ⟨0, zero_mem _, 1, by simp, by simp⟩
      | add x₁ x₂ _ _ hx₁ hx₂ =>
        obtain ⟨g1, hg1, s1, hs1, e1⟩ := hx₁
        obtain ⟨g2, hg2, s2, hs2, e2⟩ := hx₂
        refine ⟨g1 * s2 + g2 * s1, add_mem (Ideal.mul_mem_right _ _ hg1)
          (Ideal.mul_mem_right _ _ hg2), s1 * s2, by rw [map_mul]; exact mul_ne_zero hs1 hs2, ?_⟩
        rw [map_add, map_mul, map_mul, map_mul, ← e1, ← e2]; ring
      | smul a x _ hx =>
        obtain ⟨g, hg, s, hs, e⟩ := hx
        obtain ⟨ha, sa, hsa, ea⟩ := H3 a
        refine ⟨ha * g, Ideal.mul_mem_left _ _ hg, sa * s,
          by rw [map_mul]; exact mul_ne_zero hsa hs, ?_⟩
        rw [smul_eq_mul, map_mul, map_mul, ← ea, ← e]; ring
    obtain ⟨g, hg, s, hs, e⟩ := key _ hh
    have h0 : ρ (s * h - g) = 0 := by rw [map_sub, map_mul, mul_comm (ρ s), e, sub_self]
    obtain ⟨s2, hs2, hmem⟩ := H4 _ h0
    refine ⟨s2 * s, by rw [map_mul]; exact mul_ne_zero hs2 hs, ?_⟩
    have e' : s2 * s * h = s2 * (s * h - g) + s2 * g := by ring
    rw [e']
    exact add_mem (Ideal.mem_sup_right hmem) (Ideal.mem_sup_left (Ideal.mul_mem_left _ _ hg))

  refine ⟨?_, ?_⟩
  · intro n y
    obtain ⟨h, s, hs, e⟩ := H3 y
    obtain ⟨t', ht'⟩ := Ginv s n hs
    refine ⟨h * t', ?_⟩
    have e' : y - ρ (h * t') = y * ρ (1 - s * t') := by
      rw [map_sub, map_one, map_mul, map_mul, ← e]; ring
    rw [e', ← T2a]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ ht')
  · intro n h
    constructor
    · intro hh
      rw [← T2a] at hh
      obtain ⟨s, hs, hsh⟩ := CD n h hh
      obtain ⟨t', ht'⟩ := Ginv s n hs
      have e : h = t' * (s * h) + (1 - s * t') * h := by ring
      rw [e]
      exact add_mem (Ideal.mul_mem_left _ _ hsh) (Ideal.mul_mem_right _ _ (Ideal.mem_sup_left ht'))
    · intro hh
      obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hh
      rw [map_add, hJρ b hb, add_zero, ← T2a]
      exact Ideal.mem_map_of_mem _ ha

theorem wcpa_dj_lqu_sp_pnt_of_nt : ∀ (K : Type u) [Field K] (m r : ℕ) (F : Fin r → MvPolynomial (Fin m) K) (c : Fin m → K) (R : Type u) [CommRing R] [IsLocalRing R] (ρ : MvPolynomial (Fin m) K →+* R), (∀ (n : ℕ) (y : R), ∃ h, y - ρ h ∈ IsLocalRing.maximalIdeal R ^ n) → (∀ (n : ℕ) (h : MvPolynomial (Fin m) K), ρ h ∈ IsLocalRing.maximalIdeal R ^ n ↔ h ∈ wcpaLquI F c n) → ∀ u v : R, u ∈ IsLocalRing.maximalIdeal R → v ∈ IsLocalRing.maximalIdeal R → (∀ y ∈ IsLocalRing.maximalIdeal R, ∃ c₁ c₂ : K, y - (ρ (MvPolynomial.C c₁) * u + ρ (MvPolynomial.C c₂) * v) ∈ IsLocalRing.maximalIdeal R ^ 2) → (∀ c₁ c₂ : K, ρ (MvPolynomial.C c₁) * u + ρ (MvPolynomial.C c₂) * v ∈ IsLocalRing.maximalIdeal R ^ 2 → c₁ = 0 ∧ c₂ = 0) → u * v ∈ IsLocalRing.maximalIdeal R ^ 3 → wcpaLquPNT F c :=
by
  intro K _ m r F c R _ _ ρ hD hS u v hu hv hSp hIn huv
  classical
  set M := IsLocalRing.maximalIdeal R with hM
  set mc : Ideal (MvPolynomial (Fin m) K) :=
    Ideal.span (Set.range fun l => MvPolynomial.X l - MvPolynomial.C (c l)) with hmc
  have hI : ∀ n, wcpaLquI F c n = mc ^ n ⊔ Ideal.span (Set.range F) := fun n => rfl

  have hlin : ∀ w, wcpaLquLin c w ∈ mc := by
    intro w
    unfold wcpaLquLin
    exact Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨l, rfl⟩))
  have hS1 : ∀ h, h ∈ mc → ρ h ∈ M := by
    intro h hh
    have h1 := (hS 1 h).mpr (by rw [hI, pow_one]; exact Ideal.mem_sup_left hh)
    rwa [pow_one] at h1
  have hS2 : ∀ h, h ∈ mc ^ 2 → ρ h ∈ M ^ 2 := by
    intro h hh
    exact (hS 2 h).mpr (by rw [hI]; exact Ideal.mem_sup_left hh)

  have taylor : ∀ h : MvPolynomial (Fin m) K, h - MvPolynomial.C (MvPolynomial.eval c h) -
      wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l h)) ∈ mc ^ 2 := by
    intro h
    induction h using MvPolynomial.induction_on with
    | C a => simp [wcpaLquLin]
    | add p q hp hq =>
      have e : p + q - MvPolynomial.C (MvPolynomial.eval c (p + q)) -
          wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (p + q))) =
          (p - MvPolynomial.C (MvPolynomial.eval c p) -
            wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p))) +
          (q - MvPolynomial.C (MvPolynomial.eval c q) -
            wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l q))) := by
        simp only [wcpaLquLin, map_add, add_mul, Finset.sum_add_distrib]
        ring
      rw [e]
      exact Ideal.add_mem _ hp hq
    | mul_X p k hp =>
      obtain ⟨a, ha⟩ : ∃ a, a = MvPolynomial.eval c p := ⟨_, rfl⟩
      obtain ⟨lam, hlam⟩ : ∃ lam, lam =
          wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l p)) := ⟨_, rfl⟩
      have hterm : ∀ l, MvPolynomial.C (MvPolynomial.eval c
            (MvPolynomial.pderiv l (p * MvPolynomial.X k))) * (MvPolynomial.X l - MvPolynomial.C (c l)) =
          MvPolynomial.C (c k) * (MvPolynomial.C (MvPolynomial.eval c (MvPolynomial.pderiv l p)) *
            (MvPolynomial.X l - MvPolynomial.C (c l))) +
          (if l = k then MvPolynomial.C a * (MvPolynomial.X k - MvPolynomial.C (c k)) else 0) := by
        intro l
        rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X]
        by_cases hlk : l = k
        · subst hlk
          simp [Pi.single_apply, ha]
          ring
        · simp [Pi.single_apply, hlk, Ne.symm hlk]
          ring
      have hsum : wcpaLquLin c (fun l => MvPolynomial.eval c
            (MvPolynomial.pderiv l (p * MvPolynomial.X k))) =
          MvPolynomial.C (c k) * lam + MvPolynomial.C a * (MvPolynomial.X k - MvPolynomial.C (c k)) := by
        rw [hlam]
        unfold wcpaLquLin
        rw [Finset.sum_congr rfl (fun l _ => hterm l), Finset.sum_add_distrib, ← Finset.mul_sum]
        simp
      have e : p * MvPolynomial.X k - MvPolynomial.C (MvPolynomial.eval c (p * MvPolynomial.X k)) -
          wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l (p * MvPolynomial.X k))) =
          lam * (MvPolynomial.X k - MvPolynomial.C (c k)) +
            (p - MvPolynomial.C a - lam) * MvPolynomial.X k := by
        rw [hsum, MvPolynomial.eval_mul, MvPolynomial.eval_X, ← ha, map_mul]
        ring
      rw [e]
      refine Ideal.add_mem _ ?_ ?_
      · rw [pow_two]
        exact Ideal.mul_mem_mul (hlam ▸ hlin _) (Ideal.subset_span ⟨k, rfl⟩)
      · apply Ideal.mul_mem_right
        rw [ha, hlam]
        exact hp

  have linapprox : ∀ P, ρ P ∈ M → ρ P -
      ρ (wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l P))) ∈ M ^ 2 := by
    intro P hP
    have hT := taylor P
    have ha : MvPolynomial.eval c P = 0 := by
      by_contra ha
      have h1 : P - MvPolynomial.C (MvPolynomial.eval c P) ∈ mc := by
        have e : P - MvPolynomial.C (MvPolynomial.eval c P) =
            (P - MvPolynomial.C (MvPolynomial.eval c P) -
              wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l P))) +
            wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l P)) := by ring
        rw [e]
        exact Ideal.add_mem _ (Ideal.pow_le_self two_ne_zero hT) (hlin _)
      have h2 : ρ (MvPolynomial.C (MvPolynomial.eval c P)) ∈ M := by
        have h3 := hS1 _ h1
        rw [map_sub] at h3
        have e : ρ (MvPolynomial.C (MvPolynomial.eval c P)) =
            ρ P - (ρ P - ρ (MvPolynomial.C (MvPolynomial.eval c P))) := by ring
        rw [e]
        exact Ideal.sub_mem _ hP h3
      have hmul : ρ (MvPolynomial.C (MvPolynomial.eval c P)) *
          ρ (MvPolynomial.C (MvPolynomial.eval c P)⁻¹) = 1 := by
        rw [← map_mul, ← map_mul, mul_inv_cancel₀ ha, map_one, map_one]
      have hunit : IsUnit (ρ (MvPolynomial.C (MvPolynomial.eval c P))) :=
        ⟨⟨_, _, hmul, by rw [mul_comm]; exact hmul⟩, rfl⟩
      exact (IsLocalRing.maximalIdeal.isMaximal R).ne_top (Ideal.eq_top_of_isUnit_mem _ h2 hunit)
    rw [ha, map_zero, sub_zero] at hT
    have h4 := hS2 _ hT
    rwa [map_sub] at h4

  obtain ⟨Pu, hPu⟩ := hD 3 u
  obtain ⟨Pv, hPv⟩ := hD 3 v
  have h32 : M ^ 3 ≤ M ^ 2 := Ideal.pow_le_pow_right (by norm_num)
  have h21 : M ^ 2 ≤ M := Ideal.pow_le_self two_ne_zero
  have h31 : M ^ 3 ≤ M := le_trans h32 h21
  have hρPu : ρ Pu ∈ M := by
    have e : ρ Pu = u - (u - ρ Pu) := by ring
    rw [e]
    exact Ideal.sub_mem _ hu (h31 hPu)
  have hρPv : ρ Pv ∈ M := by
    have e : ρ Pv = v - (v - ρ Pv) := by ring
    rw [e]
    exact Ideal.sub_mem _ hv (h31 hPv)
  obtain ⟨U, hUdef⟩ : ∃ U, U =
      wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l Pu)) := ⟨_, rfl⟩
  obtain ⟨V, hVdef⟩ : ∃ V, V =
      wcpaLquLin c (fun l => MvPolynomial.eval c (MvPolynomial.pderiv l Pv)) := ⟨_, rfl⟩
  have L1 : u - ρ U ∈ M ^ 2 := by
    have h := linapprox Pu hρPu
    rw [← hUdef] at h
    have e : u - ρ U = (u - ρ Pu) + (ρ Pu - ρ U) := by ring
    rw [e]
    exact Ideal.add_mem _ (h32 hPu) h
  have L1' : v - ρ V ∈ M ^ 2 := by
    have h := linapprox Pv hρPv
    rw [← hVdef] at h
    have e : v - ρ V = (v - ρ Pv) + (ρ Pv - ρ V) := by ring
    rw [e]
    exact Ideal.add_mem _ (h32 hPv) h
  have L2 : ρ U ∈ M := by rw [hUdef]; exact hS1 _ (hlin _)
  have L2' : ρ V ∈ M := by rw [hVdef]; exact hS1 _ (hlin _)
  refine ⟨fun l => MvPolynomial.eval c (MvPolynomial.pderiv l Pu),
    fun l => MvPolynomial.eval c (MvPolynomial.pderiv l Pv), ?_, ?_, ?_⟩
  ·
    intro w
    rw [← hUdef, ← hVdef]
    obtain ⟨c₁, c₂, hc⟩ := hSp _ (hS1 _ (hlin w))
    refine ⟨c₁, c₂, ?_⟩
    apply (hS 2 _).mp
    rw [map_sub, map_add, map_mul, map_mul]
    have e : ρ (wcpaLquLin c w) - (ρ (MvPolynomial.C c₁) * ρ U + ρ (MvPolynomial.C c₂) * ρ V) =
        (ρ (wcpaLquLin c w) - (ρ (MvPolynomial.C c₁) * u + ρ (MvPolynomial.C c₂) * v)) +
          ρ (MvPolynomial.C c₁) * (u - ρ U) + ρ (MvPolynomial.C c₂) * (v - ρ V) := by ring
    rw [e]
    exact Ideal.add_mem _ (Ideal.add_mem _ hc (Ideal.mul_mem_left _ _ L1))
      (Ideal.mul_mem_left _ _ L1')
  ·
    intro a b hab
    rw [← hUdef, ← hVdef] at hab
    have h := (hS 2 _).mpr hab
    rw [map_add, map_mul, map_mul] at h
    apply hIn a b
    have e : ρ (MvPolynomial.C a) * u + ρ (MvPolynomial.C b) * v =
        (ρ (MvPolynomial.C a) * ρ U + ρ (MvPolynomial.C b) * ρ V) +
          ρ (MvPolynomial.C a) * (u - ρ U) + ρ (MvPolynomial.C b) * (v - ρ V) := by ring
    rw [e]
    exact Ideal.add_mem _ (Ideal.add_mem _ h (Ideal.mul_mem_left _ _ L1))
      (Ideal.mul_mem_left _ _ L1')
  ·
    rw [← hUdef, ← hVdef]
    apply (hS 3 _).mp
    rw [map_mul]
    have e : ρ U * ρ V = (ρ U - u) * ρ V + u * (ρ V - v) + u * v := by ring
    rw [e]
    have hA : ρ U - u ∈ M ^ 2 := by
      have e' : ρ U - u = -(u - ρ U) := by ring
      rw [e']
      exact Submodule.neg_mem _ L1
    have hB : ρ V - v ∈ M ^ 2 := by
      have e' : ρ V - v = -(v - ρ V) := by ring
      rw [e']
      exact Submodule.neg_mem _ L1'
    have hM3 : M ^ 3 = M ^ 2 * M := pow_succ M 2
    have hM3' : M ^ 3 = M * M ^ 2 := pow_succ' M 2
    refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) huv
    · rw [hM3]; exact Ideal.mul_mem_mul hA L2'
    · rw [hM3']; exact Ideal.mul_mem_mul hu hB

theorem wcpa_dj_sno_point_jets : ∀ (T Z : Scheme.{u}) (u : Z ⟶ T) (U : T.Opens) (hU : IsAffineOpen U) (V : Z.Opens) (hV : IsAffineOpen V) (e : V ≤ u ⁻¹ᵁ U) (m r : ℕ) (p : MvPolynomial (Fin m) Γ(T, U) →+* Γ(Z, V)) (F : Fin r → MvPolynomial (Fin m) Γ(T, U)), p.comp MvPolynomial.C = (u.appLE U V e).hom → Function.Surjective p → RingHom.ker p = Ideal.span (Set.range F) → LocallyOfFinitePresentation u → ∀ (L : Type u) [Field L] (ψ : Γ(T, U) →+* L) (w : ↥(Limits.pullback u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec))), Limits.pullback.fst u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) w ∈ V → (∃ e' : AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec)).presheaf.stalk w)) ((Limits.pullback u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec)).presheaf.stalk w) ≃+* (MvPowerSeries (Fin 2) L ⧸ Ideal.span {MvPowerSeries.X 0 * MvPowerSeries.X 1}), (e'.toRingHom.comp ((algebraMap ((Limits.pullback u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec)).presheaf.stalk w) (AdicCompletion (IsLocalRing.maximalIdeal ((Limits.pullback u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec)).presheaf.stalk w)) ((Limits.pullback u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec)).presheaf.stalk w))).comp ((Scheme.ΓSpecIso (.of L)).inv ≫ (Limits.pullback.snd u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec)).appTop ≫ (Limits.pullback u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec)).presheaf.germ ⊤ w trivial).hom)) = (Ideal.Quotient.mk _).comp MvPowerSeries.C) → ∃ χ : Γ(Z, V) →+* L, χ.comp (u.appLE U V e).hom = ψ ∧ Limits.pullback.fst u (Spec.map (CommRingCat.ofHom ψ) ≫ hU.fromSpec) w = hV.fromSpec ⟨RingHom.ker χ, RingHom.ker_isPrime χ⟩ ∧ wcpaLquPNT (fun j => MvPolynomial.map ψ (F j)) (fun l => χ (p (MvPolynomial.X l))) ∧ ∀ n : ℕ, 1 ≤ n → Module.finrank L (MvPolynomial (Fin m) L ⧸ wcpaLquI (fun j => MvPolynomial.map ψ (F j)) (fun l => χ (p (MvPolynomial.X l))) n) = 2 * n - 1 :=
by
