theorem wcpa_dj_lcc_cm_family_proj (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (r : ℕ)
    (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)) (L : wcpaDjCoc Z₁)
    (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)) (m d₀ : ℕ)
    (hSH : wcpaLccSH W u₁ ε L t m) (hd₀ : 1 ≤ d₀) (hgen : wcpaLccGenBy u₁ L m d₀) :
    ∃ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (φ : Z₁ ⟶ Z),
      φ ≫ uu = u₁ ∧ Flat uu ∧ IsProper uu ∧ LocallyOfFinitePresentation uu ∧
      ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Spec (.of ↥W))
        (φs : Limits.pullback u₁ s ⟶ Limits.pullback uu s),
        φs ≫ Limits.pullback.fst uu s = Limits.pullback.fst u₁ s ≫ φ →
        φs ≫ Limits.pullback.snd uu s = Limits.pullback.snd u₁ s →
        wcpaLccP1 φs ∧ wcpaLccP2 u₁ L m s φs :=
by
  obtain ⟨D, hD⟩ := wcpa_dj_lcc_fp_section_ring_data Ω W Z₁ u₁ r ε L t m d₀ hSH hd₀ hgen
  letI : CommRing D.S := D.cr
  letI : GradedRing D.𝒜 := D.gr
  obtain ⟨φ, hφ⟩ := wcpa_dj_lcc_fp_chart_morphism Ω W Z₁ u₁ r ε L t m hSH D hD
  have hD' := hD
  obtain ⟨hO1, _hO2, hO3, _hO4, hO5, ⟨M, d, x, hx, hirr⟩, hO7, _hO8⟩ := hD'
  obtain ⟨hprop, hflat, hlft⟩ :=
    wcpa_dj_lcc_fp_proj_flat_proper Ω W D.S D.𝒜 D.ρ₀ hO1 hO5 hO7
  have hprop' : IsProper (wcpaLccUU D) := hprop
  have hflat' : Flat (wcpaLccUU D) := hflat
  have hlft' : LocallyOfFiniteType (wcpaLccUU D) := hlft
  have hlfp : LocallyOfFinitePresentation (wcpaLccUU D) :=
    wcpa_dj_mn_flat_fp (Spec (.of ↥W)) (Proj D.𝒜) (wcpaLccUU D) hflat' hlft'
  refine ⟨Proj D.𝒜, wcpaLccUU D, φ, hφ.1, hflat', hprop', hlfp, ?_⟩
  intro K _ _ s φs h1 h2
  haveI hpu : IsProper u₁ := hSH.1.2.1
  obtain ⟨hOKs, _hcpt, hqs, hcompat, hbo⟩ :=
    wcpa_dj_lcc_fp_pull_basics u₁ L s hpu hSH.2.2.1
  haveI := hqs
  let g : Fin M → ∀ a : Fin L.m, Γ(Limits.pullback u₁ s,
      (wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓ (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤) :=
    fun J => wcpaLccPullFam u₁ L s (fun a => D.ev a (x J))
  let DJ : Fin M → (Limits.pullback (wcpaLccUU D) s).Opens :=
    fun J => (Limits.pullback.fst (wcpaLccUU D) s) ⁻¹ᵁ Proj.basicOpen D.𝒜 (x J)
  have haff : ∀ J, IsAffineOpen (DJ J) := fun J =>
    (wcpa_dj_lcc_fp_affine_bc_gen (.of ↥W) (Proj D.𝒜) (wcpaLccUU D) K s
      (Proj.basicOpen D.𝒜 (x J))
      (Proj.isAffineOpen_basicOpen D.𝒜 (x J) (hx J).2 (by have := (hx J).1; omega))).1
  have hcov : (⨆ J, DJ J) = ⊤ := by
    show (⨆ J, (Limits.pullback.fst (wcpaLccUU D) s) ⁻¹ᵁ Proj.basicOpen D.𝒜 (x J)) = ⊤
    rw [← Scheme.Hom.preimage_iSup, Proj.iSup_basicOpen_eq_top D.𝒜 x hirr,
      Scheme.Hom.preimage_top]
  have hpre : ∀ J, φs ⁻¹ᵁ DJ J = ⨆ a, (Limits.pullback u₁ s).basicOpen (g J a) := by
    intro J
    show φs ⁻¹ᵁ (Limits.pullback.fst (wcpaLccUU D) s) ⁻¹ᵁ Proj.basicOpen D.𝒜 (x J) = _
    rw [← Scheme.Hom.comp_preimage, h1, Scheme.Hom.comp_preimage,
      hφ.2.1 (d J) (hx J).1 (x J) (hx J).2, Scheme.Hom.preimage_iSup]
    exact iSup_congr fun a => (hbo (fun a => D.ev a (x J)) a).symm
  have hP2 : wcpaLccP2 u₁ L m s φs :=
    ⟨M, d, g, DJ, fun J => (hx J).1,
      fun J => hcompat (m * d J) _ (hO3 (d J) (hx J).1 (x J) (hx J).2), haff, hcov, hpre⟩
  have hcomp : ∀ J, IsCompact ((φs ⁻¹ᵁ DJ J : (Limits.pullback u₁ s).Opens) :
      Set ↥(Limits.pullback u₁ s)) := by
    intro J
    rw [hpre J, TopologicalSpace.Opens.coe_iSup]
    refine isCompact_iUnion fun a => ?_
    have hA : IsAffineOpen ((wcpaDjCocPull (Limits.pullback.fst u₁ s) L).V a ⊓
        (Limits.pullback.snd u₁ s) ⁻¹ᵁ ⊤) := by
      rw [Scheme.Hom.preimage_top, inf_top_eq]
      exact hOKs.1 a
    exact (hA.basicOpen (g J a)).isCompact
  have hP1 : wcpaLccP1 φs :=
    wcpa_dj_lcc_fp_app_bij_of_cover φs M DJ haff hcov hcomp
      (fun J => IsQuasiSeparated.of_quasiSeparatedSpace _)
      (fun J => wcpa_dj_lcc_fp_fibre_chart_bij Ω W Z₁ u₁ r ε L t m hSH D hD φ hφ K s φs h1 h2
        (d J) (hx J).1 (x J) (hx J).2)
  exact ⟨hP1, hP2⟩

theorem wcpa_dj_lfcs_section_point : ∀ (S X : Scheme.{u}) (g : X ⟶ S) (σ : S ⟶ X) (K : Type u) [Field K] (s : Spec (.of K) ⟶ S), σ ≫ g = 𝟙 S → ∃ y : ↥(Limits.pullback g s), Limits.pullback.fst g s y = σ (s (IsLocalRing.closedPoint K)) ∧ (∀ (x : ↥(Limits.pullback g s)) (q : ↥(Spec (.of K))), Limits.pullback.fst g s x = σ (s q) → x = y) ∧ ∀ W₁ : X.Opens, SmoothOfRelativeDimension 1 (W₁.ι ≫ g) → SmoothOfRelativeDimension 1 ((Limits.pullback.fst g s ⁻¹ᵁ W₁).ι ≫ Limits.pullback.snd g s) :=
by
  intro S X g σ K _ s hσ
  have H1 : IsPullback (Limits.pullback.fst g s) (Limits.pullback.snd g s) g s :=
    IsPullback.of_hasPullback g s
  have w : (s ≫ σ) ≫ g = 𝟙 (Spec (.of K)) ≫ s := by
    rw [Category.assoc, hσ, Category.comp_id, Category.id_comp]
  set ys : Spec (.of K) ⟶ Limits.pullback g s := Limits.pullback.lift (s ≫ σ) (𝟙 _) w with hys
  have H4 : ys ≫ Limits.pullback.fst g s = s ≫ σ := Limits.pullback.lift_fst _ _ _
  have H3 : ys ≫ Limits.pullback.snd g s = 𝟙 _ := Limits.pullback.lift_snd _ _ _
  have hout : IsPullback (ys ≫ Limits.pullback.snd g s) s s (σ ≫ g) := by
    rw [H3, hσ]
    exact IsPullback.id_horiz s
  have hsq : IsPullback ys s (Limits.pullback.fst g s) σ := IsPullback.of_right hout H4 H1.flip
  refine ⟨ys (IsLocalRing.closedPoint K), ?_, ?_, ?_⟩
  · have e := Scheme.Hom.comp_apply ys (Limits.pullback.fst g s) (IsLocalRing.closedPoint K)
    have e2 := Scheme.Hom.comp_apply s σ (IsLocalRing.closedPoint K)
    rw [H4] at e
    exact e.symm.trans e2
  · intro x q hx
    obtain ⟨p, hp, -⟩ := Scheme.exists_preimage_of_isPullback hsq x (s q) hx
    rw [← hp]
    exact congrArg ys (Subsingleton.elim p _)
  · intro W₁ hW₁
    have h1 := isPullback_morphismRestrict (Limits.pullback.fst g s) W₁
    have h2 := h1.paste_vert H1
    exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hW₁

theorem wcpa_dj_lcc_sep_comp_deg_local : ∀ (K : Type u) [Field K] [IsAlgClosed K] (C : Scheme.{u}) (q : C ⟶ Spec (.of K)) (L : wcpaDjCoc C) (t : ∀ a : Fin L.m, Γ(C, L.V a ⊓ q ⁻¹ᵁ ⊤)), wcpaDjSemistable q → wcpaDjCocOK L → wcpaDjCompat L (q ⁻¹ᵁ ⊤) 1 t → ∀ ξ : C, closure {ξ} ∈ irreducibleComponents C → (∀ a : Fin L.m, ξ ∈ L.V a → ξ ∈ C.basicOpen (t a)) → (∃ x ∈ closure {ξ}, ∀ a : Fin L.m, x ∈ L.V a → x ∉ C.basicOpen (t a)) → ∀ a : Fin L.m, ξ ∈ L.V a → 1 ≤ wcpaDjCompDeg L ξ a :=
by
  intro K _ _ C q L t hss hOK hcomp ξ hξ hnv hz a ha
  classical
  letI : Algebra K (C.residueField ξ) := (wcpaDjFK K q ξ).toAlgebra
  have hA : algebraMap K (C.residueField ξ) = wcpaDjFK K q ξ := rfl
  have hq : IsProper q := hss.2.1
  haveI := hq
  have hsep : IsSeparated q := inferInstance
  have htopmem : ∀ y : C, y ∈ q ⁻¹ᵁ (⊤ : (Spec (.of K)).Opens) := by
    intro y
    rw [Scheme.Hom.preimage_top]
    exact TopologicalSpace.Opens.mem_top y
  have hFF := wcpa_dj_cdp_residue_ff1 K C q hss ξ hξ hA
  obtain ⟨⟨u, hu⟩, hmul, hfin, hsum, htop⟩ := wcpa_dj_cdp_ff_valuations K (C.residueField ξ) hFF

  have hv1 : ∀ V : ValuationSubring (C.residueField ξ), wcpaDjNtV' K V →
      wcpaDjValOrd V (1 : C.residueField ξ) = 0 := by
    intro V hV
    have := hmul V hV 1 1 one_ne_zero one_ne_zero
    rw [one_mul] at this
    linarith
  have hvinv : ∀ V : ValuationSubring (C.residueField ξ), wcpaDjNtV' K V →
      ∀ x : C.residueField ξ, x ≠ 0 → wcpaDjValOrd V x⁻¹ = - wcpaDjValOrd V x := by
    intro V hV x hx
    have := hmul V hV x x⁻¹ hx (inv_ne_zero hx)
    rw [mul_inv_cancel₀ hx, hv1 V hV] at this
    linarith
  have hgb : ∀ (V : ValuationSubring (C.residueField ξ)) (b : Fin L.m),
      wcpaDjChartGood L ξ V b → ξ ∈ L.V b := by
    intro V b hg
    obtain ⟨hb, _⟩ := hg
    exact hb

  have hconst : ∀ (V : ValuationSubring (C.residueField ξ)) (b : Fin L.m),
      wcpaDjChartGood L ξ V b → ∀ c : K, algebraMap K (C.residueField ξ) c ∈ V := by
    intro V b hg c
    obtain ⟨hb, hgood⟩ := hg
    have key := hgood ((C.presheaf.map (homOfLE (le_top : L.V b ≤ ⊤)).op).hom
      (q.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)))
    have e : algebraMap K (C.residueField ξ) c = (C.presheaf.germ (L.V b) ξ hb ≫ C.residue ξ).hom
        ((C.presheaf.map (homOfLE (le_top : L.V b ≤ ⊤)).op).hom
          (q.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))) := by
      rw [hA]
      unfold wcpaDjFK
      rw [← TopCat.Presheaf.germ_res C.presheaf (homOfLE (le_top : L.V b ≤ ⊤)) ξ hb]
      rfl
    rw [e]
    exact key
  have hNt_chart : ∀ V : ValuationSubring (C.residueField ξ), wcpaDjNtV' K V →
      ∃ b, wcpaDjChartGood L ξ V b :=
    fun V hV => wcpa_dj_cdp_chart_exists K C q hq L hOK ξ hA V hV

  obtain ⟨τ, hτ⟩ : ∃ τ : Fin L.m → C.residueField ξ, ∀ (b : Fin L.m) (hb : ξ ∈ L.V b),
      τ b = (C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) ξ (TopologicalSpace.Opens.mem_inf.mpr ⟨hb, htopmem ξ⟩) ≫ C.residue ξ).hom (t b) :=
    ⟨fun b => if hb : ξ ∈ L.V b then
        (C.presheaf.germ (L.V b ⊓ q ⁻¹ᵁ ⊤) ξ (TopologicalSpace.Opens.mem_inf.mpr ⟨hb, htopmem ξ⟩) ≫ C.residue ξ).hom (t b) else 0,
      fun b hb => dif_pos hb⟩
  have hτ0 : ∀ b, ξ ∈ L.V b → τ b ≠ 0 := by
    intro b hb
