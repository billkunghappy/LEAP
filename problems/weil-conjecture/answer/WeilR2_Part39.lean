      linear_combination (-(x a)) * hαβ a

theorem wcpa_dj_lcc_sr_nakayama_lift : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Y : Scheme.{u}) (q : Y ⟶ Spec (.of ↥W)) (L : wcpaDjCoc Y) (e₁ e₂ : ℕ), wcpaLccBC q L e₁ → wcpaLccBC q L e₂ → wcpaLccBC q L (e₁ + e₂) → (∀ x₀ : ∀ a : Fin L.m, Γ(Limits.pullback q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))), (wcpaDjCocPull (Limits.pullback.fst q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L).V a ⊓ (Limits.pullback.snd q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ⁻¹ᵁ ⊤), wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L) ((Limits.pullback.snd q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ⁻¹ᵁ ⊤) (e₁ + e₂) x₀ → ∃ (n : ℕ) (y z : Fin n → ∀ a : Fin L.m, Γ(Limits.pullback q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))), (wcpaDjCocPull (Limits.pullback.fst q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L).V a ⊓ (Limits.pullback.snd q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ⁻¹ᵁ ⊤)), (∀ l, wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L) ((Limits.pullback.snd q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ⁻¹ᵁ ⊤) e₁ (y l) ∧ wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L) ((Limits.pullback.snd q (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) ⁻¹ᵁ ⊤) e₂ (z l)) ∧ ∀ a, x₀ a = ∑ l, y l a * z l a) → ∀ x : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤), wcpaDjCompat L (q ⁻¹ᵁ ⊤) (e₁ + e₂) x → ∃ (n : ℕ) (y z : Fin n → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)), (∀ l, wcpaDjCompat L (q ⁻¹ᵁ ⊤) e₁ (y l) ∧ wcpaDjCompat L (q ⁻¹ᵁ ⊤) e₂ (z l)) ∧ ∀ a, x a = ∑ l, y l a * z l a :=
by
  intro Ω _ W Y q L e₁ e₂ hBC₁ hBC₂ hBC hCF x hx
  classical

  have nA : ∀ {X Z : Scheme.{u}} (f : X ⟶ Z) {U U' : Z.Opens} {V : X.Opens} (e : V ≤ f ⁻¹ᵁ U)
      (h : U ≤ U') (x : Γ(Z, U')),
      (f.appLE U V e).hom ((Z.presheaf.map (homOfLE h).op).hom x) =
        (f.appLE U' V (e.trans (Scheme.Hom.preimage_mono f h))).hom x := by
    intro X Z f U U' V e h x
    exact congrArg (fun φ => φ.hom x) (Scheme.Hom.map_appLE f e (homOfLE h).op)
  have nB : ∀ {X Z : Scheme.{u}} (f : X ⟶ Z) {U : Z.Opens} {V V' : X.Opens} (e : V ≤ f ⁻¹ᵁ U)
      (h : V' ≤ V) (x : Γ(Z, U)),
      (X.presheaf.map (homOfLE h).op).hom ((f.appLE U V e).hom x) =
        (f.appLE U V' (h.trans e)).hom x := by
    intro X Z f U V V' e h x
    exact congrArg (fun φ => φ.hom x) (Scheme.Hom.appLE_map f e (homOfLE h).op)
  have nC : ∀ {X Z : Scheme.{u}} (f : X ⟶ Z) (U : Z.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U)
      (x : Γ(Z, U)),
      (X.presheaf.map (homOfLE e).op).hom ((f.app U).hom x) = (f.appLE U V e).hom x :=
    fun _ _ _ _ _ => rfl

  have scres : ∀ {X : Scheme.{u}} {K : Type u} [Field K] (g : X ⟶ Spec (.of K)) (V V' : X.Opens)
      (h : V' ≤ V) (k : K),
      (X.presheaf.map (homOfLE h).op).hom (wcpaLccScal g V k) = wcpaLccScal g V' k := by
    intro X K _ g V V' h k
    unfold wcpaLccScal
    show (((Scheme.ΓSpecIso (.of K)).inv ≫ g.appTop ≫ X.presheaf.map (homOfLE le_top).op) ≫
      X.presheaf.map (homOfLE h).op).hom k = _
    rw [Category.assoc, Category.assoc, ← Functor.map_comp]
    rfl

  have hιj : ∀ y : Γ(Spec (.of ↥W), ⊤),
      (Scheme.ΓSpecIso (.of ↥W)).inv.hom ((Scheme.ΓSpecIso (.of ↥W)).hom.hom y) = y := by
    intro y
    show ((Scheme.ΓSpecIso (.of ↥W)).hom ≫ (Scheme.ΓSpecIso (.of ↥W)).inv).hom y = y
