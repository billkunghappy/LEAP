    have key : (Limits.pullback u₁ (Spec.map (CommRingCat.ofHom
        (algebraMap A (IsLocalRing.ResidueField A))))).basicOpen
        (((Limits.pullback u₁ (Spec.map (CommRingCat.ofHom
          (algebraMap A (IsLocalRing.ResidueField A))))).presheaf.map
          (homOfLE (le_iSup (fun a' => (Limits.pullback u₁ (Spec.map (CommRingCat.ofHom
            (algebraMap A (IsLocalRing.ResidueField A))))).basicOpen (τ J a')) b)).op).hom h) =
        (Limits.pullback u₁ (Spec.map (CommRingCat.ofHom
          (algebraMap A (IsLocalRing.ResidueField A))))).basicOpen (τ J b) ⊓
          (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
            (algebraMap A (IsLocalRing.ResidueField A)))) ≫ φ) ⁻¹ᵁ
            (wcpaLspP A M).basicOpen G := by
      rw [hhb, heval, Scheme.basicOpen_appLE]
    rw [Scheme.basicOpen_res] at key
    constructor
    · intro hh
      have h3 : w₀ ∈ (Limits.pullback u₁ (Spec.map (CommRingCat.ofHom
          (algebraMap A (IsLocalRing.ResidueField A))))).basicOpen (τ J b) ⊓
          (Limits.pullback u₁ (Spec.map (CommRingCat.ofHom
            (algebraMap A (IsLocalRing.ResidueField A))))).basicOpen h := ⟨hw₀, hh⟩
      rw [key] at h3
      exact h3.2
    · intro hh
      have h3 : w₀ ∈ (Limits.pullback u₁ (Spec.map (CommRingCat.ofHom
          (algebraMap A (IsLocalRing.ResidueField A))))).basicOpen (τ J b) ⊓
          (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
            (algebraMap A (IsLocalRing.ResidueField A)))) ≫ φ) ⁻¹ᵁ
            (wcpaLspP A M).basicOpen G := ⟨hw₀, hh⟩
      rw [← key] at h3
      exact h3.2
  apply hsep
  rw [hdet a w ((hchart a w).mpr (by rw [hw1]; exact hxa)),
    hdet a' w' ((hchart a' w').mpr (by rw [hw'1]; exact hxa')), hψw, hψw']

theorem wcpa_dj_lsa_fl_amp_of_finite : ∀ (A : Type u) [CommRing A] (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of A)), LocallyOfFiniteType u₁ → ∀ (L₁ : wcpaDjCoc Z₁) (e M : ℕ) (σ : Fin (M + 1) → ∀ a : Fin L₁.m, Γ(Z₁, L₁.V a ⊓ u₁ ⁻¹ᵁ ⊤)), (∀ J, wcpaDjCompat L₁ (u₁ ⁻¹ᵁ ⊤) e (σ J)) → (⨆ J, ⨆ a, Z₁.basicOpen (σ J a)) = ⊤ → ∀ φ : Z₁ ⟶ wcpaLspP A M, IsFinite φ → (∀ J, φ ⁻¹ᵁ wcpaLspD A M J = ⨆ a, Z₁.basicOpen (σ J a)) → wcpaDjAmp u₁ L₁ ⊤ e :=
by
  intro A _ Z₁ u₁ hft L₁ e M σ hσ hcov φ hfin hpre
  haveI := hft
  haveI := hfin
  have hA3 : ∀ J, IsAffineOpen (⨆ a, Z₁.basicOpen (σ J a)) := by
    intro J
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) A) :=
      MvPolynomial.gradedAlgebra
    have hD : IsAffineOpen (wcpaLspD A M J) :=
      Proj.isAffineOpen_basicOpen _ (MvPolynomial.X J)
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ J))
        Nat.one_pos
    have h := hD.preimage φ
    rwa [hpre J] at h
  refine ⟨M, σ, hσ, hcov.trans (Scheme.Hom.preimage_top u₁).symm, hA3, fun J => ?_⟩
  have hh : (⨆ a, Z₁.basicOpen (σ J a)) ≤ u₁ ⁻¹ᵁ ⊤ :=
    iSup_le (fun a => (Z₁.basicOpen_le (σ J a)).trans inf_le_right)
  have key : (Z₁.presheaf.map (homOfLE hh).op).hom.comp (u₁.app ⊤).hom =
      (u₁.appLE ⊤ (⨆ a, Z₁.basicOpen (σ J a)) hh).hom := by
    rw [← CommRingCat.hom_comp, Scheme.Hom.app_eq_appLE, Scheme.Hom.appLE_map]
  have hft' := LocallyOfFiniteType.finiteType_appLE u₁ (isAffineOpen_top (Spec (.of A))) (hA3 J) hh
  rw [← key] at hft'
  exact hft'

theorem wcpa_dj_lsa_finite_local : ∀ (A : Type u) [CommRing A] [IsLocalRing A] (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of A)), IsProper u₁ → ∀ L₁ : wcpaDjCoc Z₁, wcpaDjCocOK L₁ → ∀ (e M : ℕ), 0 < e → ∀ σ : Fin (M + 1) → ∀ a : Fin L₁.m, Γ(Z₁, L₁.V a ⊓ u₁ ⁻¹ᵁ ⊤), (∀ J, wcpaDjCompat L₁ (u₁ ⁻¹ᵁ ⊤) e (σ J)) → ∀ τ : Fin (M + 1) → ∀ a : Fin L₁.m, Γ(Limits.pullback u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))), (wcpaDjCocPull (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) L₁).V a ⊓ Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ ⊤), (∀ J a, ∃ h, ((Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))).appLE (L₁.V a ⊓ u₁ ⁻¹ᵁ ⊤) ((wcpaDjCocPull (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) L₁).V a ⊓ Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ ⊤) h).hom (σ J a) = τ J a) → wcpaDjVAData (Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) (wcpaDjCocPull (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) L₁) ⊤ e M τ → wcpaDjAmp u₁ L₁ ⊤ e :=
by
  intro A _ _ Z₁ u₁ hu₁ L₁ hOK e M _he σ hσ τ hστ hVA
  haveI := hu₁
  have hcov := wcpa_dj_lsa_fl_cover A Z₁ u₁ inferInstance L₁ hOK.2.1 M σ τ hστ hVA.2.1
  obtain ⟨φ, hφs, hφpre, hφrel⟩ :=
    wcpa_dj_lsa_fl_chart A Z₁ u₁ L₁ hOK e M σ hσ hcov (wcpa_dj_lsa_fl_proj_up A M)
  have hT : ⊤ ≤ (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
      (algebraMap A (IsLocalRing.ResidueField A)))) ≫ u₁) ⁻¹ᵁ ⊤ := fun _ _ => trivial
  have hSep := wcpa_dj_lsa_fl_fibre_separate A Z₁ u₁ L₁ e M τ hT hVA
  have hinj := wcpa_dj_lsa_fl_fibre_injective A Z₁ u₁ L₁ M σ τ hστ hcov hT hSep φ hφs hφpre hφrel
  haveI : IsProper (φ ≫ wcpaLspStr A M) := by rw [hφs]; infer_instance
  have hφp : IsProper φ := IsProper.of_comp φ (wcpaLspStr A M)
  have hfin : IsFinite φ := wcpa_dj_lsa_fl_zmt A Z₁ (wcpaLspP A M) φ (wcpaLspStr A M) hφp
    (by rw [hφs]; infer_instance)
    (fun x x' hx h => hinj x x' (by rw [← hφs]; exact hx) h)
  exact wcpa_dj_lsa_fl_amp_of_finite A Z₁ u₁ inferInstance L₁ e M σ hσ hcov φ hfin hφpre

theorem wcpa_dj_lsa_amp_basechange : ∀ (A R : Type u) [CommRing A] [CommRing R] (ψ : A →+* R) (Z₁ Z : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of A)) (uu : Z ⟶ Spec (.of R)) (φ : Z ⟶ Z₁), IsPullback φ uu u₁ (Spec.map (CommRingCat.ofHom ψ)) → ∀ (L₁ : wcpaDjCoc Z₁) (e : ℕ), wcpaDjAmp u₁ L₁ ⊤ e → wcpaDjAmp uu (wcpaDjCocPull φ L₁) ⊤ e :=
by
  intro A R _ _ ψ Z₁ Z u₁ uu φ hsq L₁ e hamp
  obtain ⟨M, σ, hc, hcov, haff, hft⟩ := hamp

  have bridge : ∀ {X Y : Scheme.{u}} [IsAffine Y] (f : X ⟶ Y) (D : X.Opens), IsAffineOpen D →
      (LocallyOfFiniteType (D.ι ≫ f) ↔ RingHom.FiniteType (f.appLE ⊤ D le_top).hom) := by
    intro X Y _ f D hD
    haveI : IsAffine D.toScheme := hD
    rw [HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFiniteType)]
    have key : (D.ι ≫ f).appTop = f.appLE ⊤ D le_top ≫ D.topIso.inv := by
      rw [← cancel_mono D.topIso.hom, Category.assoc, Iso.inv_hom_id, Category.comp_id]
      simp [Scheme.Hom.appLE, Scheme.Opens.topIso_hom]
      erw [Category.assoc, ← Functor.map_comp]
      rfl
    rw [key]
    exact RingHom.RespectsIso.cancel_right_isIso RingHom.finiteType_respectsIso _ _

  haveI hφaff : IsAffineHom φ :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) hsq.flip inferInstance

  have s4 : ∀ D : Z₁.Opens, IsAffineOpen D → RingHom.FiniteType (u₁.appLE ⊤ D le_top).hom →
      RingHom.FiniteType (uu.appLE ⊤ (φ ⁻¹ᵁ D) le_top).hom := by
    intro D hD hFT
    have h1 : LocallyOfFiniteType (D.ι ≫ u₁) := (bridge u₁ D hD).2 hFT
    have h2 := (isPullback_morphismRestrict φ D).paste_vert hsq
    have h3 : LocallyOfFiniteType ((φ ⁻¹ᵁ D).ι ≫ uu) :=
      MorphismProperty.of_isPullback (P := @LocallyOfFiniteType) h2 h1
    exact (bridge uu (φ ⁻¹ᵁ D) (hD.preimage φ)).1 h3

  have ml : ∀ {U U' : Z₁.Opens} {V : Z.Opens} (e : V ≤ φ ⁻¹ᵁ U) (i : Opposite.op U' ⟶ Opposite.op U)
      (s : Γ(Z₁, U')), (φ.appLE U V e).hom ((Z₁.presheaf.map i).hom s) =
        (φ.appLE U' V (e.trans (φ.preimage_mono (leOfHom i.unop)))).hom s := by
    intro U U' V e i s
    rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
  have am : ∀ {U : Z₁.Opens} {V V' : Z.Opens} (e : V ≤ φ ⁻¹ᵁ U) (i : Opposite.op V ⟶ Opposite.op V')
      (s : Γ(Z₁, U)), (Z.presheaf.map i).hom ((φ.appLE U V e).hom s) =
        (φ.appLE U V' ((leOfHom i.unop).trans e)).hom s := by
    intro U V V' e i s
    rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map]
  have hle : ∀ a, φ ⁻¹ᵁ L₁.V a ⊓ uu ⁻¹ᵁ ⊤ ≤ φ ⁻¹ᵁ (L₁.V a ⊓ u₁ ⁻¹ᵁ ⊤) := by
    intro a x hx
    exact ⟨hx.1, trivial⟩
  let t : Fin (M + 1) → ∀ a : Fin L₁.m, Γ(Z, φ ⁻¹ᵁ L₁.V a ⊓ uu ⁻¹ᵁ ⊤) := fun J a =>
    (φ.appLE (L₁.V a ⊓ u₁ ⁻¹ᵁ ⊤) (φ ⁻¹ᵁ L₁.V a ⊓ uu ⁻¹ᵁ ⊤) (hle a)).hom (σ J a)
  have hB : ∀ J a, Z.basicOpen (t J a) = φ ⁻¹ᵁ Z₁.basicOpen (σ J a) := by
    intro J a
    show Z.basicOpen ((φ.appLE (L₁.V a ⊓ u₁ ⁻¹ᵁ ⊤) (φ ⁻¹ᵁ L₁.V a ⊓ uu ⁻¹ᵁ ⊤) (hle a)) (σ J a)) = _
    rw [Scheme.basicOpen_appLE]
    apply le_antisymm inf_le_right
    intro x hx
    exact ⟨⟨(Z₁.basicOpen_le (σ J a) hx).1, trivial⟩, hx⟩
  have hD : ∀ J, ⨆ a, Z.basicOpen (t J a) = φ ⁻¹ᵁ (⨆ a, Z₁.basicOpen (σ J a)) := by
    intro J
    rw [Scheme.Hom.preimage_iSup]
    exact iSup_congr (hB J)
  unfold wcpaDjAmp wcpaDjCompat wcpaDjCocPull
  dsimp only
  refine ⟨M, t, ?_, ?_, ?_, ?_⟩
  · intro J a b
    have hW : φ ⁻¹ᵁ L₁.V a ⊓ φ ⁻¹ᵁ L₁.V b ⊓ uu ⁻¹ᵁ ⊤ ≤
        φ ⁻¹ᵁ (L₁.V a ⊓ L₁.V b ⊓ u₁ ⁻¹ᵁ ⊤) := by
      intro x hx
      obtain ⟨⟨h1, h2⟩, -⟩ := hx
      exact ⟨⟨h1, h2⟩, trivial⟩
    have H := congrArg (φ.appLE (L₁.V a ⊓ L₁.V b ⊓ u₁ ⁻¹ᵁ ⊤)
      (φ ⁻¹ᵁ L₁.V a ⊓ φ ⁻¹ᵁ L₁.V b ⊓ uu ⁻¹ᵁ ⊤) hW).hom (hc J a b)
    rw [map_mul] at H
    rw [ml, ml, ml] at H
    rw [Units.coe_map]
    change _ = (Z.presheaf.map _).hom ((Z.presheaf.map _).hom
      ((φ.app (L₁.V a ⊓ L₁.V b)).hom (L₁.g a b : Γ(Z₁, L₁.V a ⊓ L₁.V b))) ^ e) * _
    rw [← map_pow, ← map_pow, Scheme.Hom.app_eq_appLE]
    simp only [t, am]
    exact H
  · simp only [hD]
    rw [← Scheme.Hom.preimage_iSup, hcov, Scheme.Hom.preimage_top, Scheme.Hom.preimage_top,
      Scheme.Hom.preimage_top]
  · intro J
    rw [hD J]
    exact (haff J).preimage φ
  · intro J
    have hft' : RingHom.FiniteType
        (u₁.appLE ⊤ (⨆ a, Z₁.basicOpen (σ J a)) le_top).hom := hft J
    have helper : ∀ (O : Z.Opens), O = φ ⁻¹ᵁ (⨆ a, Z₁.basicOpen (σ J a)) →
        ∀ h : O ≤ uu ⁻¹ᵁ ⊤, RingHom.FiniteType (uu.appLE ⊤ O h).hom := by
      rintro O rfl h
      exact s4 _ (haff J) hft'
    exact helper _ (hD J) le_top

theorem wcpa_dj_lcp_ra_veronese : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T) (L : wcpaDjCoc Y)
    (W : T.Opens) (e m : ℕ), 1 ≤ m → wcpaDjVA q L W e → wcpaDjVA q L W (e * m) :=
by
  intro Y T q L W e m hm hVA
  obtain ⟨M, t, hC1, hC2, hC3, hC4⟩ := hVA
  rcases Nat.lt_or_ge m 2 with hm2 | hm2
  · obtain rfl : m = 1 := by omega
    rw [Nat.mul_one]
    exact ⟨M, t, hC1, hC2, hC3, hC4⟩
  obtain ⟨n, rfl⟩ : ∃ n, m = n + 2 := ⟨m - 2, by omega⟩

  have rc : ∀ {A B C : Y.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(Y, A)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
        (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro A B C h1 h2 x
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Functor.map_comp]
    rfl
  have rcc : ∀ {A B C : Y.Opens} (h1 : B ≤ A) (h2 : C ≤ B),
      (Y.presheaf.map (homOfLE h2).op).hom.comp (Y.presheaf.map (homOfLE h1).op).hom =
        (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom :=
    fun h1 h2 => RingHom.ext (fun x => rc h1 h2 x)
  have unitres : ∀ {A : Y.Opens} (x : Γ(Y, A)),
      IsUnit ((Y.presheaf.map (homOfLE (Y.basicOpen_le x)).op).hom x) :=
    fun x => RingedSpace.isUnit_res_basicOpen Y.toLocallyRingedSpace.toRingedSpace x

  have alg1 : ∀ {A : Type u} [CommRing A] (xa xb ya yb ia ib G : A), xb = G * xa →
      yb = G * ya → ia * xa = 1 → ib * xb = 1 → ya * ia = yb * ib := by
    intro A _ xa xb ya yb ia ib G hx hy ha hb
    linear_combination (-(ya * ia)) * hb + (G * ya * ib) * ha + (ya * ia * ib) * hx - ib * hy
  have ringid : ∀ {A : Type u} [CommRing A] (xJ xK xl u ι : A), u * xJ = 1 →
      ι * (xJ ^ (n + 1) * xK) = 1 →
      (xJ ^ (n + 1) * xl * ι) * (xK ^ (n + 1) * xK * ι) * (xJ ^ (n + 1) * xJ * ι) ^ n =
        xl * u := by
    intro A _ xJ xK xl u ι hu hι
    have hι' : ι = u ^ (n + 1) * (ι * xJ ^ (n + 1)) := by
      calc ι = ι * (u * xJ) ^ (n + 1) := by rw [hu, one_pow, mul_one]
        _ = _ := by ring
    have hv : (ι * xJ ^ (n + 1)) * xK = 1 := by rw [mul_assoc]; exact hι
    generalize ι * xJ ^ (n + 1) = v at hι' hv
    subst hι'
    have e1 : (xJ ^ (n + 1) * xl * (u ^ (n + 1) * v)) * (xK ^ (n + 1) * xK * (u ^ (n + 1) * v)) *
        (xJ ^ (n + 1) * xJ * (u ^ (n + 1) * v)) ^ n =
        xl * u * (u * xJ) ^ (n ^ 2 + 3 * n + 1) * (v * xK) ^ (n + 2) := by ring
    rw [e1, hu, hv, one_pow, one_pow, mul_one, mul_one]
  have finalg : ∀ {A : Type u} [CommRing A] (F Yv H xJ xK ι : A) (k : ℕ), Yv = H ^ k * F →
      H * xJ = xK → ι * (xJ ^ (n + 1) * xK) = 1 → F = Yv * (xJ ^ (n + 1) * xJ * ι) ^ k := by
    intro A _ F Yv H xJ xK ι k hYv hHx hι
    have hHV : H * (xJ ^ (n + 1) * xJ * ι) = 1 := by
      linear_combination (xJ ^ (n + 1) * ι) * hHx + hι
    have hHV' : (H * (xJ ^ (n + 1) * xJ * ι)) ^ k = 1 := by rw [hHV, one_pow]
    rw [hYv]
    linear_combination (-F) * hHV'
  have bres : ∀ {A B : Y.Opens} (hle : B ≤ A) (x : Γ(Y, A)),
      Y.basicOpen ((Y.presheaf.map (homOfLE hle).op).hom x) = B ⊓ Y.basicOpen x :=
    fun hle x => Scheme.basicOpen_res Y x (homOfLE hle).op

  have hM : M * (M + 2) + 1 = (M + 1) * (M + 1) := by ring
  obtain ⟨ε⟩ : Nonempty (Fin (M * (M + 2) + 1) ≃ Fin (M + 1) × Fin (M + 1)) :=
    ⟨(finCongr hM).trans finProdFinEquiv.symm⟩
  obtain ⟨s, hsdef⟩ : ∃ s : Fin (M * (M + 2) + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W),
      ∀ p a, s p a = t (ε p).1 a ^ (n + 1) * t (ε p).2 a := ⟨_, fun _ _ => rfl⟩
  have hs : ∀ J' K' a, s (ε.symm (J', K')) a = t J' a ^ (n + 1) * t K' a := by
    intro J' K' a; rw [hsdef, Equiv.apply_symm_apply]

  have glue : ∀ J K : Fin (M + 1), ∃ h : Γ(Y, ⨆ a, Y.basicOpen (t J a)),
      (∀ a, (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (t J a')) a)).op).hom h *
          (Y.presheaf.map (homOfLE (Y.basicOpen_le (t J a))).op).hom (t J a) =
        (Y.presheaf.map (homOfLE (Y.basicOpen_le (t J a))).op).hom (t K a)) ∧
      Y.basicOpen h = ⨆ a, (Y.basicOpen (t J a) ⊓ Y.basicOpen (t K a)) := by
    intro J K
    obtain ⟨iv, hiv⟩ : ∃ iv : ∀ a, Γ(Y, Y.basicOpen (t J a)),
        ∀ a, iv a * (Y.presheaf.map (homOfLE (Y.basicOpen_le (t J a))).op).hom (t J a) = 1 :=
      ⟨fun a => ↑(unitres (t J a)).unit⁻¹, fun a => (unitres (t J a)).val_inv_mul⟩
    obtain ⟨r, hr⟩ : ∃ r : ∀ a, Γ(Y, Y.basicOpen (t J a)),
        ∀ a, r a = (Y.presheaf.map (homOfLE (Y.basicOpen_le (t J a))).op).hom (t K a) * iv a :=
      ⟨_, fun _ => rfl⟩
    have hcomp : ∀ a b,
        (Y.presheaf.map (homOfLE (inf_le_left : Y.basicOpen (t J a) ⊓ Y.basicOpen (t J b) ≤
          Y.basicOpen (t J a))).op).hom (r a) =
        (Y.presheaf.map (homOfLE (inf_le_right : Y.basicOpen (t J a) ⊓ Y.basicOpen (t J b) ≤
          Y.basicOpen (t J b))).op).hom (r b) := by
      intro a b
      have hO : Y.basicOpen (t J a) ⊓ Y.basicOpen (t J b) ≤ L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W :=
        le_inf (le_inf (inf_le_left.trans ((Y.basicOpen_le _).trans inf_le_left))
          (inf_le_right.trans ((Y.basicOpen_le _).trans inf_le_left)))
          (inf_le_left.trans ((Y.basicOpen_le _).trans inf_le_right))
      have hx := congrArg (Y.presheaf.map (homOfLE hO).op).hom (hC1 J a b)
      have hy := congrArg (Y.presheaf.map (homOfLE hO).op).hom (hC1 K a b)
      have ha := congrArg (Y.presheaf.map (homOfLE (inf_le_left : Y.basicOpen (t J a) ⊓
        Y.basicOpen (t J b) ≤ Y.basicOpen (t J a))).op).hom (hiv a)
      have hb := congrArg (Y.presheaf.map (homOfLE (inf_le_right : Y.basicOpen (t J a) ⊓
        Y.basicOpen (t J b) ≤ Y.basicOpen (t J b))).op).hom (hiv b)
      simp only [map_mul, map_one, rc] at hx hy ha hb
      rw [hr, hr]
      simp only [map_mul, rc]
      exact alg1 _ _ _ _ _ _ _ hx hy ha hb
    obtain ⟨h, hh, -⟩ := TopCat.Sheaf.existsUnique_gluing Y.sheaf
      (fun a => Y.basicOpen (t J a)) r (fun a b => hcomp a b)
    have hh' : ∀ a, (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (t J a')) a)).op).hom h
        = r a := fun a => hh a
    refine ⟨h, fun a => ?_, ?_⟩
    · rw [hh' a, hr a, mul_assoc, hiv a, mul_one]
    · have hDh : ∀ a, Y.basicOpen (t J a) ⊓ Y.basicOpen h =
          Y.basicOpen (t J a) ⊓ Y.basicOpen (t K a) := by
        intro a
        have hivu : IsUnit (iv a) :=
          ⟨⟨iv a, _, hiv a, (mul_comm _ _).trans (hiv a)⟩, rfl⟩
        rw [← bres (le_iSup (fun a' => Y.basicOpen (t J a')) a) h, hh' a, hr a,
          Scheme.basicOpen_mul, bres, Scheme.basicOpen_of_isUnit Y hivu, inf_right_comm, inf_idem]
      calc Y.basicOpen h = (⨆ a, Y.basicOpen (t J a)) ⊓ Y.basicOpen h :=
            (inf_eq_right.mpr (Y.basicOpen_le h)).symm
        _ = ⨆ a, (Y.basicOpen (t J a) ⊓ Y.basicOpen h) := iSup_inf_eq _ _
        _ = _ := iSup_congr hDh

  have key : ∀ (J K : Fin (M + 1)) (σ : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W)),
      (∀ a, σ a = t J a ^ (n + 1) * t K a) →
      IsAffineOpen (⨆ a, Y.basicOpen (σ a)) ∧
      ∀ f : Γ(Y, ⨆ a, Y.basicOpen (σ a)), ∃ P : MvPolynomial (Fin (M * (M + 2) + 1)) Γ(T, W),
        ∀ a, ∃ inv : Γ(Y, Y.basicOpen (σ a)),
          inv * (Y.presheaf.map (homOfLE (Y.basicOpen_le (σ a))).op).hom (σ a) = 1 ∧
          (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (σ a')) a)).op).hom f =
            MvPolynomial.eval₂
              ((Y.presheaf.map (homOfLE ((Y.basicOpen_le (σ a)).trans inf_le_right)).op).hom.comp
                (q.app W).hom)
              (fun l => (Y.presheaf.map (homOfLE (Y.basicOpen_le (σ a))).op).hom (s l a) * inv)
              P := by
    intro J K σ hσ
    obtain ⟨h, hh1, hh2⟩ := glue J K
    have hEa : ∀ a, Y.basicOpen (σ a) = Y.basicOpen (t J a) ⊓ Y.basicOpen (t K a) := by
      intro a
      rw [hσ a, Scheme.basicOpen_mul, Scheme.basicOpen_pow _ _ (Nat.succ_pos n)]
    have hbo : Y.basicOpen h = ⨆ a, Y.basicOpen (σ a) := by
      rw [hh2]; exact iSup_congr (fun a => (hEa a).symm)
    refine ⟨by rw [← hbo]; exact (hC3 J).basicOpen h, fun f => ?_⟩
    obtain ⟨n0, y, hy⟩ := exists_eq_pow_mul_of_isAffineOpen Y _ (hC3 J) h
      ((Y.presheaf.map (homOfLE hbo.le).op).hom f)
    have hy' : (Y.presheaf.map (homOfLE (Y.basicOpen_le h)).op).hom y =
        ((Y.presheaf.map (homOfLE (Y.basicOpen_le h)).op).hom h) ^ n0 *
          (Y.presheaf.map (homOfLE hbo.le).op).hom f := hy
    obtain ⟨P, hP⟩ := hC4 J y
    refine ⟨MvPolynomial.bind₁ (fun l => MvPolynomial.X (ε.symm (J, l)) *
        MvPolynomial.X (ε.symm (K, K)) * MvPolynomial.X (ε.symm (J, J)) ^ n) P *
        MvPolynomial.X (ε.symm (J, J)) ^ n0, fun a => ?_⟩
    obtain ⟨inva, hinva1, hinva2⟩ := hP a
    obtain ⟨ι, hι⟩ : ∃ ι : Γ(Y, Y.basicOpen (σ a)),
        ι * (Y.presheaf.map (homOfLE (Y.basicOpen_le (σ a))).op).hom (σ a) = 1 :=
      ⟨_, (unitres (σ a)).val_inv_mul⟩
    refine ⟨ι, hι, ?_⟩
    have hEaD : Y.basicOpen (σ a) ≤ Y.basicOpen (t J a) := (hEa a).le.trans inf_le_left
    have hEaB : Y.basicOpen (σ a) ≤ Y.basicOpen h :=
      (le_iSup (fun a' => Y.basicOpen (σ a')) a).trans hbo.ge
    have hu := congrArg (Y.presheaf.map (homOfLE hEaD).op).hom hinva1
    simp only [map_mul, map_one, rc] at hu
    have hιx := hι
    rw [congrArg (Y.presheaf.map (homOfLE (Y.basicOpen_le (σ a))).op).hom (hσ a), map_mul,
      map_pow] at hιx
    have hvals : ∀ J' K',
        (Y.presheaf.map (homOfLE (Y.basicOpen_le (σ a))).op).hom (s (ε.symm (J', K')) a) * ι =
        (Y.presheaf.map (homOfLE (Y.basicOpen_le (σ a))).op).hom (t J' a) ^ (n + 1) *
          (Y.presheaf.map (homOfLE (Y.basicOpen_le (σ a))).op).hom (t K' a) * ι := by
      intro J' K'; rw [hs, map_mul, map_pow]
    have hring : ∀ xl : Γ(Y, Y.basicOpen (σ a)),
        ((Y.presheaf.map (homOfLE (Y.basicOpen_le (σ a))).op).hom (t J a) ^ (n + 1) * xl * ι) *
          ((Y.presheaf.map (homOfLE (Y.basicOpen_le (σ a))).op).hom (t K a) ^ (n + 1) *
            (Y.presheaf.map (homOfLE (Y.basicOpen_le (σ a))).op).hom (t K a) * ι) *
          ((Y.presheaf.map (homOfLE (Y.basicOpen_le (σ a))).op).hom (t J a) ^ (n + 1) *
            (Y.presheaf.map (homOfLE (Y.basicOpen_le (σ a))).op).hom (t J a) * ι) ^ n =
        xl * (Y.presheaf.map (homOfLE hEaD).op).hom inva :=
      fun xl => ringid _ _ xl _ _ hu hιx
    have hHx := congrArg (Y.presheaf.map (homOfLE hEaD).op).hom (hh1 a)
    simp only [map_mul, rc] at hHx
    have hYv := congrArg (Y.presheaf.map (homOfLE hEaB).op).hom hy'
    simp only [map_mul, map_pow, rc] at hYv
    have hYP := congrArg (Y.presheaf.map (homOfLE hEaD).op).hom hinva2
    rw [MvPolynomial.eval₂_comp_left, ← RingHom.comp_assoc, rcc, rc] at hYP
    have hfun : (⇑(Y.presheaf.map (homOfLE hEaD).op).hom ∘ fun l =>
        (Y.presheaf.map (homOfLE (Y.basicOpen_le (t J a))).op).hom (t l a) * inva) =
        fun l => (Y.presheaf.map (homOfLE (Y.basicOpen_le (σ a))).op).hom (t l a) *
          (Y.presheaf.map (homOfLE hEaD).op).hom inva := by
      funext l; simp only [Function.comp_apply, map_mul, rc]
    rw [hfun] at hYP
    simp only [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_pow, MvPolynomial.eval₂_X]
    rw [← MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂Hom_bind₁]
    simp only [MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_pow,
      MvPolynomial.eval₂_X, hvals, hring]
    rw [← hYP]
    exact finalg _ _ _ _ _ _ n0 hYv hHx hιx
  refine ⟨M * (M + 2), s, ?_, ?_, ?_, ?_⟩
  · intro p a b
    rw [hsdef p b, hsdef p a]
    have h1 := hC1 (ε p).1 a b
    have h2 := hC1 (ε p).2 a b
    simp only [map_mul, map_pow] at h1 h2 ⊢
    rw [h1, h2]
    ring
  · intro a
    rw [eq_top_iff, ← Ideal.span_pow_eq_top _ (hC2 a) (n + 2)]
    apply Ideal.span_mono
    rintro _ ⟨_, ⟨J, rfl⟩, rfl⟩
    refine ⟨ε.symm (J, J), ?_⟩
    show s (ε.symm (J, J)) a = t J a ^ (n + 2)
    rw [hs]; ring
  · intro p
    exact (key (ε p).1 (ε p).2 (s p) (hsdef p)).1
  · intro p f
    exact (key (ε p).1 (ε p).2 (s p) (hsdef p)).2 f

theorem wcpa_dj_lsp_spread_amp : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Z : Scheme.{u})
    (uu : Z ⟶ Spec (.of R)), IsProper uu → LocallyOfFinitePresentation uu →
    ∀ L : wcpaDjCoc Z, wcpaDjCocOK L → ∀ e : ℕ, 0 < e →
    wcpaDjAmp (Limits.pullback.snd uu (Spec.map (CommRingCat.ofHom
        (algebraMap R (IsLocalRing.ResidueField R)))))
      (wcpaDjCocPull (Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom
        (algebraMap R (IsLocalRing.ResidueField R))))) L) ⊤ e →
    ∃ e' : ℕ, 0 < e' ∧ wcpaDjAmp uu L ⊤ e' :=
by
  intro R _ _ Z uu hprop hfp L hOK e he hamp₀

  have red0 : ∀ {Y : Scheme.{u}} {U₁ U₂ U₃ : Y.Opens} (i : U₂ ≤ U₁) (j : U₃ ≤ U₂) (z : Γ(Y, U₁)),
      (Y.presheaf.map (homOfLE j).op).hom ((Y.presheaf.map (homOfLE i).op).hom z) =
        (Y.presheaf.map (homOfLE (j.trans i)).op).hom z := by
    intro Y U₁ U₂ U₃ i j z
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have red3 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) {U U' : Y.Opens} {V : X.Opens} (hU : U' ≤ U)
      (e : V ≤ f ⁻¹ᵁ U') (y : Γ(Y, U)),
      (X.presheaf.map (homOfLE e).op).hom ((f.app U').hom
          ((Y.presheaf.map (homOfLE hU).op).hom y)) =
        (X.presheaf.map (homOfLE (e.trans (fun x hx => hU hx))).op).hom ((f.app U).hom y) := by
    intro X Y f U U' V hU e y
    change (Y.presheaf.map (homOfLE hU).op ≫ f.app U' ≫ X.presheaf.map (homOfLE e).op).hom y =
      (f.app U ≫ X.presheaf.map (homOfLE (e.trans (fun x hx => hU hx))).op).hom y
    rw [Scheme.Hom.naturality_assoc, ← Functor.map_comp]
    rfl

  have pull_comp : ∀ {X Y W : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ W) (L : wcpaDjCoc W),
      wcpaDjCocPull f (wcpaDjCocPull g L) = wcpaDjCocPull (f ≫ g) L := by
    intro X Y W f g L
    simp only [wcpaDjCocPull]
    congr 1
    funext a b
    apply Units.ext
    exact red3 f _ _ _

  have pull_ok : ∀ {Y' Y : Scheme.{u}} (h : Y' ⟶ Y) (L : wcpaDjCoc Y),
      (∀ a, IsAffineOpen (h ⁻¹ᵁ L.V a)) → wcpaDjCocOK L → wcpaDjCocOK (wcpaDjCocPull h L) := by
    intro Y' Y h L haff hL
    obtain ⟨_, hcov, hid, hcoc⟩ := hL
    refine ⟨haff, ?_, ?_, ?_⟩
    · show ⨆ a, h ⁻¹ᵁ L.V a = ⊤
      rw [← Scheme.Hom.preimage_iSup, hcov, Scheme.Hom.preimage_top]
    · intro a
      show Units.map _ (L.g a a) = 1
      rw [hid a, map_one]
    · show ∀ a b c : Fin L.m, _
      intro a b c
      have H := congrArg (h.app (L.V a ⊓ L.V b ⊓ L.V c) ≫ Y'.presheaf.map (homOfLE
        (show h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c ≤ h ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ L.V c) from
          fun x hx => hx)).op).hom (hcoc a b c)
      rw [map_mul] at H
      simp only [CommRingCat.comp_apply, red3] at H
      show (Y'.presheaf.map (homOfLE _).op).hom ((Y'.presheaf.map (homOfLE _).op).hom
            ((h.app (L.V a ⊓ L.V b)).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b)))) *
          (Y'.presheaf.map (homOfLE _).op).hom ((Y'.presheaf.map (homOfLE _).op).hom
            ((h.app (L.V b ⊓ L.V c)).hom (L.g b c : Γ(Y, L.V b ⊓ L.V c)))) =
        (Y'.presheaf.map (homOfLE _).op).hom ((Y'.presheaf.map (homOfLE _).op).hom
            ((h.app (L.V a ⊓ L.V c)).hom (L.g a c : Γ(Y, L.V a ⊓ L.V c))))
      exact (congrArg₂ (· * ·) (red0 _ _ _) (red0 _ _ _)).trans (H.trans (red0 _ _ _).symm)
  obtain ⟨A, iA, iAl, iAn, ψ, hψ, Z₁, u₁, φ, L₁, hu₁, hsq, hOK₁, hpullL⟩ :=
    wcpa_dj_lsa_noeth_model R Z uu hprop hfp L hOK
  subst hpullL

  have hρ : Spec.map (CommRingCat.ofHom (algebraMap R (IsLocalRing.ResidueField R))) ≫
      Spec.map (CommRingCat.ofHom ψ) =
      Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.map ψ)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))) := by
    rw [← Spec.map_comp, ← Spec.map_comp]
    congr 1
  have hw : (Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom
        (algebraMap R (IsLocalRing.ResidueField R)))) ≫ φ) ≫ u₁ =
      (Limits.pullback.snd uu (Spec.map (CommRingCat.ofHom
        (algebraMap R (IsLocalRing.ResidueField R)))) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.map ψ))) ≫
        Spec.map (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))) := by
    rw [Category.assoc, hsq.w, ← Category.assoc, Limits.pullback.condition, Category.assoc, hρ,
      Category.assoc]
  let π := Limits.pullback.lift _ _ hw
  have hπf : π ≫ Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
        (algebraMap A (IsLocalRing.ResidueField A)))) =
      Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom
        (algebraMap R (IsLocalRing.ResidueField R)))) ≫ φ :=
    Limits.pullback.lift_fst _ _ _
  have hπs : π ≫ Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom
        (algebraMap A (IsLocalRing.ResidueField A)))) =
      Limits.pullback.snd uu (Spec.map (CommRingCat.ofHom
        (algebraMap R (IsLocalRing.ResidueField R)))) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.map ψ)) :=
    Limits.pullback.lift_snd _ _ _
  have hpbπ : IsPullback π (Limits.pullback.snd uu (Spec.map (CommRingCat.ofHom
        (algebraMap R (IsLocalRing.ResidueField R)))))
      (Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom
        (algebraMap A (IsLocalRing.ResidueField A)))))
      (Spec.map (CommRingCat.ofHom (IsLocalRing.ResidueField.map ψ))) := by
    have hout := (IsPullback.of_hasPullback uu (Spec.map (CommRingCat.ofHom
        (algebraMap R (IsLocalRing.ResidueField R))))).paste_horiz hsq
    rw [hρ, ← hπf] at hout
    exact IsPullback.of_right hout hπs (IsPullback.of_hasPullback _ _)
  have hq₀ : IsProper (Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom
        (algebraMap A (IsLocalRing.ResidueField A))))) :=
    MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback _ _) hu₁
  haveI hf₀ : IsAffineHom (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
        (algebraMap A (IsLocalRing.ResidueField A))))) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback _ _).flip
      inferInstance
  have hOK₀ := pull_ok (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
        (algebraMap A (IsLocalRing.ResidueField A))))) L₁
    (fun a => (hOK₁.1 a).preimage _) hOK₁

  have hL : wcpaDjCocPull (Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom
        (algebraMap R (IsLocalRing.ResidueField R))))) (wcpaDjCocPull φ L₁) =
      wcpaDjCocPull π (wcpaDjCocPull (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
        (algebraMap A (IsLocalRing.ResidueField A))))) L₁) := by
    rw [pull_comp, pull_comp, hπf]
  rw [hL] at hamp₀

  letI : Algebra (IsLocalRing.ResidueField A) (IsLocalRing.ResidueField R) :=
    (IsLocalRing.ResidueField.map ψ).toAlgebra
  obtain ⟨e₁, he₁, hamp₁⟩ := wcpa_dj_lsa_fibre_amp_descent _ _ _ _ _ _ π hq₀ hpbπ _ hOK₀ e he
    hamp₀

  have haff : ∀ a, IsAffineOpen ((wcpaDjCocPull (Limits.pullback.fst u₁ (Spec.map
      (CommRingCat.ofHom (algebraMap A (IsLocalRing.ResidueField A))))) L₁).V a ⊓
      Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom
        (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ ⊤) := by
    intro a
    rw [Scheme.Hom.preimage_top, inf_top_eq]
    exact hOK₀.1 a
  obtain ⟨e₂, he₂, hva⟩ := wcpa_dj_lcp_ra_amp_to_va _ hq₀ _ hOK₀ ⊤ (isAffineOpen_top _) haff
    e₁ he₁ hamp₁

  obtain ⟨m, hm, hlift⟩ := wcpa_dj_lsa_lift_local A Z₁ u₁ hu₁ L₁ hOK₁ e₂ he₂ hva
  obtain ⟨M, τ, hdata⟩ := wcpa_dj_lcp_ra_veronese _ _ ⊤ e₂ m hm hva
  obtain ⟨σ, hσ, hστ⟩ := hlift M τ (fun J => hdata.1 J)
  have hpos : 0 < e₂ * m := Nat.mul_pos he₂ (by omega)

  have hampA := wcpa_dj_lsa_finite_local A Z₁ u₁ hu₁ L₁ hOK₁ (e₂ * m) M hpos σ hσ τ hστ hdata

  exact ⟨e₂ * m, hpos, wcpa_dj_lsa_amp_basechange A R ψ Z₁ Z u₁ uu φ hsq L₁ (e₂ * m) hampA⟩

theorem wcpa_dj_lsp_va_to_proj : ∀ (R : Type u) [CommRing R] (Z : Scheme.{u})
    (uu : Z ⟶ Spec (.of R)) (L : wcpaDjCoc Z) (e : ℕ), wcpaDjCocOK L → wcpaDjVA uu L ⊤ e →
    ∃ (N : ℕ) (j : Z ⟶ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
        MvPolynomial.gradedAlgebra),
      IsClosedImmersion j ∧
      j ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R)
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap R ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) R 0))) = uu :=
by
  intro R _ Z uu Lc ee hOK hva
  obtain ⟨M, t, hVA1, hVA2, hVA3, hVA4⟩ := hva
  obtain ⟨_hVaff, hVcov, _, _⟩ := hOK
  have hres : ∀ (X : Scheme.{u}) (A B C : X.Opens) (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A)
      (x : Γ(X, A)),
      X.presheaf.map (homOfLE h2).op (X.presheaf.map (homOfLE h1).op x) =
        X.presheaf.map (homOfLE h3).op x := by
    intro X A B C h1 h2 h3 x
    rw [← CategoryTheory.comp_apply, ← Functor.map_comp]
    rfl



  have hcovP : (⨆ a : Fin (M + 1), wcpaLspD R M a) = ⊤ := by
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R) :=
      MvPolynomial.gradedAlgebra
    refine Proj.iSup_basicOpen_eq_top _ _ ?_
    intro p hp
    have h0 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R) 0 p = 0 :=
      (HomogeneousIdeal.mem_irrelevant_iff (𝒜 := MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R)
        p).mp hp
    have h1 : GradedRing.proj (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R) 0 p =
        MvPolynomial.homogeneousComponent 0 p :=
      (GradedRing.proj_apply _ 0 p).trans (MvPolynomial.decomposition.decompose'_apply p 0)
    rw [h1, MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ]
    rw [MvPolynomial.mem_ideal_span_X_image]
    intro e he
    rw [MvPolynomial.mem_support_iff] at he
    have hne : e ≠ 0 := by
      rintro rfl
      exact he h0
    obtain ⟨i, hi⟩ := Finsupp.ne_iff.mp hne
    exact ⟨i, Set.mem_univ i, by simpa using hi⟩
  have haffD : ∀ k, IsAffineOpen (wcpaLspD R M k) := by
    intro k
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) R) :=
      MvPolynomial.gradedAlgebra
    exact Proj.isAffineOpen_basicOpen _ (MvPolynomial.X k)
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)) Nat.one_pos



  have S2 : ∀ (V : Scheme.{u}) (fV : V ⟶ Spec (.of R)) (s : Fin (M + 1) → Γ(V, ⊤)),
      Ideal.span (Set.range s) = ⊤ →
      ∃ φ : V ⟶ wcpaLspP R M, φ ≫ wcpaLspStr R M = fV ∧
        (∀ J, φ ⁻¹ᵁ wcpaLspD R M J = V.basicOpen (s J)) ∧
        ∀ J L (O : V.Opens) (hO : O ≤ φ ⁻¹ᵁ wcpaLspD R M J),
          φ.appLE (wcpaLspD R M J) O hO (wcpaLspE R M J L) *
            V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (s J) =
          V.presheaf.map (homOfLE (le_top : O ≤ ⊤)).op (s L) := by
