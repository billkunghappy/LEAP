theorem wcpa_dj_lsa_ll_artin_rees : ∀ (B : Type u) [CommRing B], IsNoetherianRing B → ∀ (I : Ideal B) (X : Scheme.{u}), IsNoetherian X → ∀ (h : X ⟶ Spec (.of B)), IsProper h → ∀ (L : wcpaDjCoc X), wcpaDjCocOK L → (∀ a b, IsAffineOpen (L.V a ⊓ L.V b)) → ∀ d : ℕ, ∃ c : ℕ, ∀ x : ∀ a : Fin L.m, Γ(X, L.V a), wcpaDjCompatMod h L (I ^ (c + 1)) d x → ∃ s : ∀ a : Fin L.m, Γ(X, L.V a), wcpaDjCompatMod h L ⊥ d s ∧ ∀ a, s a - x a ∈ Ideal.map (wcCnSigma h (L.V a)) I :=
by
    classical
    intro B _ hBn I X hXn h hh L hL hpair d
