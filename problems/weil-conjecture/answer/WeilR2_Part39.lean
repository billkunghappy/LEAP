  have hcovU : (⨆ a, (Lc.V a ⊓ uu ⁻¹ᵁ ⊤)) = ⊤ := by
    simp only [Scheme.Hom.preimage_top, inf_top_eq]
    exact hVcov
  have kk : ∀ a b, (Lc.V a ⊓ uu ⁻¹ᵁ ⊤) ⊓ (Lc.V b ⊓ uu ⁻¹ᵁ ⊤) ≤ Lc.V a ⊓ Lc.V b :=
    fun a b => inf_le_inf inf_le_left inf_le_left
  have htr : ∀ a b J, Z.presheaf.map (homOfLE (inf_le_right :
