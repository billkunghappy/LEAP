    obtain ⟨x', hx'⟩ := wcpa_dj_lge_cbcm_h1 Y' (wcpaDjCocPull φ' L₀) ⊤ e hOK' hTw _ h2
    refine (hU R f).2 w hw ⟨Θ0.symm x', ?_⟩
