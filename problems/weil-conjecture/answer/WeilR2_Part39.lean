    rw [eq_top_iff]
    intro z _
    have hz : j z ∈ ⨆ a, @Proj.basicOpen _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) ↥Wb) MvPolynomial.gradedAlgebra (g a) := by
      rw [htop]; trivial
    obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hz
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, ha⟩

  let D : Fin (N + 1) → Set ↥(Limits.pullback u'
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W' (IsLocalRing.ResidueField ↥W'))))) :=
    fun a => ((ψb ⁻¹ᵁ Ub a : Set _))ᶜ
  have hDcl : ∀ a, IsClosed (D a) := fun a => (ψb ⁻¹ᵁ Ub a).isOpen.isClosed_compl
