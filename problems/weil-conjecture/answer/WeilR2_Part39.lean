          (algebraMap A (IsLocalRing.ResidueField A)))) ⁻¹ᵁ ⊤ :=
      ⟨show Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom
          (algebraMap A (IsLocalRing.ResidueField A)))) w ∈ L₁.V a by rw [hw1]; exact ha,
