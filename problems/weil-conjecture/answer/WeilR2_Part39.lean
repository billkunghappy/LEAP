  intro Ω _ _ W hW Ct ct hproj hsm

  have wcpa_dj_lr1s_clopen_proj : ∀ (Ct : Scheme.{u}) (ct : Ct ⟶ Spec (.of Ω)) (U V : Ct.Opens),
      Disjoint U V → U ⊔ V = ⊤ → wcpaDjIsProjOver Ω ct → wcpaDjIsProjOver Ω (U.ι ≫ ct) := by
