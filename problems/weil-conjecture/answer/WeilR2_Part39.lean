    obtain ⟨θ, hθ⟩ := IsAlgClosed.exists_root _ hdeg
    have hint : _root_.IsIntegral ↥V θ := ⟨q, hqmon, by
      rw [← Polynomial.eval_map]; exact hθ⟩
    obtain ⟨v, hv⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ↥V) (K := K)).mp hint
    have hqv : q.eval v = 0 := by
