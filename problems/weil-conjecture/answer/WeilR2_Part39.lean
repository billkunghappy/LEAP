        hV₀.fromSpec := by
      rw [Category.assoc, ← hsq, IsIso.inv_hom_id_assoc]
    have hxU : n 0 (IsLocalRing.closedPoint K) ∈ π ⁻¹ᵁ V₀ := by
      show π (n 0 (IsLocalRing.closedPoint K)) ∈ V₀
