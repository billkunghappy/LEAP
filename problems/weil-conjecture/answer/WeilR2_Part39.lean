      have hH9 : ∀ (i : Fin k), ∀ x ∈ E', x ∈ Es →
          ¬ ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = σ (Fin.castSucc i) (s q) := by
        rintro i x hxE' hxEs ⟨q, hq⟩
        obtain ⟨W₁, hW₁, hW₁sm⟩ := hst.2.1.2.2 (Fin.castSucc i) (s q)
        obtain ⟨-, -, -, hsm⟩ :=
          wcpa_dj_lfcs_section_point _ _ u₁ (σ (Fin.castSucc i)) K s (hst.2.1.1 _)
        have hxO : x ∈ Limits.pullback.fst u₁ s ⁻¹ᵁ W₁ := by
          rw [Scheme.Hom.mem_preimage, hq]
          exact hW₁
        haveI := hsm W₁ hW₁sm
        have hdom := wcpa_smooth_stalk_isDomain K _
          ((Limits.pullback.fst u₁ s ⁻¹ᵁ W₁).ι ≫ Limits.pullback.snd u₁ s) 1 ⟨x, hxO⟩
        have hEq := wcpa_dj_lfcs_domain_unibranch _ _ x hxO hdom E' hE' Es hEs hxE' hxEs
        exact hnAF (by rw [hEq]; exact hAFs)
      exact le_trans hcnt (wcpa_dj_lfcs_top_contract_count (⇑φs) k
        (fun i x => ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = σ (Fin.castSucc i) (s q))
        (fun i y => ∃ q : ↥(Spec (.of K)),
          Limits.pullback.fst uu s y = (σ (Fin.castSucc i) ≫ φ) (s q))
        E' Es φs.continuous (isClosed_of_mem_irreducibleComponents E' hE')
        hE'.prop.isPreirreducible (isClosed_of_mem_irreducibleComponents Es hEs) hns hinj
        (F4 Es hEs hAFs) hH3 hHab hH11 hH9 (fun _ => ⟨hsum, hnd⟩) (F2 _ hCc))
    · have hns : ¬ E' ⊆ (∅ : Set ↥(Limits.pullback u₁ s)) := fun hsub =>
        hE'.prop.nonempty.ne_empty (Set.subset_empty_iff.mp hsub)
      have hH2 : ∀ x ∈ (∅ : Set ↥(Limits.pullback u₁ s)), ∀ y ∈ (∅ : Set ↥(Limits.pullback u₁ s)),
          φs x = φs y := fun x hx => ((Set.mem_empty_iff_false x).mp hx).elim
      have hH3 : ∀ x y, φs x = φs y → x = y ∨
          (x ∈ (∅ : Set ↥(Limits.pullback u₁ s)) ∧ y ∈ (∅ : Set ↥(Limits.pullback u₁ s))) := by
        intro x y hxy
        rcases F3 x y hxy with h | ⟨E, hE, hAF, -, -⟩
        · exact Or.inl h
        · exact (hex ⟨E, hE, hAF⟩).elim
      have hH9 : ∀ (i : Fin k), ∀ x ∈ E', x ∈ (∅ : Set ↥(Limits.pullback u₁ s)) →
          ¬ ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = σ (Fin.castSucc i) (s q) :=
        fun i x _ hx => ((Set.mem_empty_iff_false x).mp hx).elim
      exact le_trans hcnt (wcpa_dj_lfcs_top_contract_count (⇑φs) k
        (fun i x => ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = σ (Fin.castSucc i) (s q))
        (fun i y => ∃ q : ↥(Spec (.of K)),
          Limits.pullback.fst uu s y = (σ (Fin.castSucc i) ≫ φ) (s q))
        E' ∅ φs.continuous (isClosed_of_mem_irreducibleComponents E' hE')
        hE'.prop.isPreirreducible isClosed_empty hns hinj hH2 hH3 hHab hH11 hH9
        (fun h => absurd h Set.not_nonempty_empty) (F2 _ hCc))

theorem wcpa_dj_lfc_generic_iso : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (Z₁ Z : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (uu : Z ⟶ Spec (.of ↥W)) (φ : Z₁ ⟶ Z)
    (r : ℕ) (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁)),
    φ ≫ uu = u₁ → Surjective φ →
    (∃ V₁ : Z₁.Opens, IsOpenImmersion (V₁.ι ≫ φ) ∧ ⇑φ ⁻¹' (⇑φ '' (V₁ : Set Z₁)) = V₁ ∧
        ∀ z : Z₁, z ∉ V₁ → ∃ (K : Type u) (_ : Field K) (_ : IsAlgClosed K)
          (s : Spec (.of K) ⟶ Spec (.of ↥W)) (y : ↥(Limits.pullback u₁ s))
          (E : Set ↥(Limits.pullback u₁ s)),
          Limits.pullback.fst u₁ s y = z ∧ y ∈ E ∧
          E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) ∧
          (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q))) →
    (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Spec (.of ↥W))
      (E : Set ↥(Limits.pullback u₁ s)), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
      (∀ b, ¬ ∃ x ∈ E, ∃ q : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = ε b (s q)) →
      ∀ t' : Spec (.of K) ⟶ Spec (.of Ω),
        s ≠ t' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) →
    IsPullback (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ≫ φ)
      (Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) uu
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) :=
by
  intro Ω _ W Z₁ Z u₁ uu φ r ε hφ hsurj hV₁ hgen
  obtain ⟨V₁, hoi, _hsat, hexc⟩ := hV₁

  have s1 : ∀ (K : Type u) [Field K] (s : Spec (.of K) ⟶ Spec (.of ↥W)) (q : ↥(Spec (.of K)))
      (w : ↥(Spec (.of Ω))), s q = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) w →
      ∃ t' : Spec (.of K) ⟶ Spec (.of Ω),
        s = t' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) := by
    intro K _ s q w h
    have hs : Spec.map (Spec.preimage s) = s := Spec.map_preimage s
    have h1 : Spec.map (Spec.preimage s) q =
        Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) w := by
      rw [hs]; exact h
    have h2 : Ideal.comap (Spec.preimage s).hom q.asIdeal =
        Ideal.comap (algebraMap ↥W Ω) w.asIdeal := congrArg PrimeSpectrum.asIdeal h1
    rw [@Ideal.eq_bot_of_prime _ _ q.asIdeal q.isPrime,
      @Ideal.eq_bot_of_prime _ _ w.asIdeal w.isPrime] at h2
    have hinj : Function.Injective (Spec.preimage s).hom := by
      rw [RingHom.injective_iff_ker_eq_bot, RingHom.ker_eq_comap_bot, h2,
        ← RingHom.ker_eq_comap_bot]
      exact (RingHom.injective_iff_ker_eq_bot _).mp (IsFractionRing.injective ↥W Ω)
    refine ⟨Spec.map (CommRingCat.ofHom (IsFractionRing.lift (A := ↥W) (K := Ω) hinj)), ?_⟩
    rw [← Spec.map_comp]
    conv_lhs => rw [← hs]
    congr 1
    ext x
    exact (IsFractionRing.lift_algebraMap (K := Ω) hinj x).symm

  have s2 : ∀ {X Z S T : Scheme.{u}} (u₁ : X ⟶ S) (uu : Z ⟶ S) (φ : X ⟶ Z) (e : T ⟶ S)
      (V₁ : X.Opens), φ ≫ uu = u₁ → Surjective φ → IsOpenImmersion (V₁.ι ≫ φ) →
      (∀ x : X, (∃ t : T, u₁ x = e t) → x ∈ V₁) →
      IsPullback (Limits.pullback.fst u₁ e ≫ φ) (Limits.pullback.snd u₁ e) uu e := by
    intro X Z S T u₁ uu φ e V₁ hφ hsurj hoi hV
    have hb : Set.range (Limits.pullback.fst u₁ e) ⊆ Set.range V₁.ι := by
      rintro _ ⟨y, rfl⟩
      rw [Scheme.Opens.range_ι]
      apply hV
      refine ⟨Limits.pullback.snd u₁ e y, ?_⟩
      rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
    have ha : Set.range (Limits.pullback.fst uu e) ⊆ Set.range (V₁.ι ≫ φ) := by
      rintro _ ⟨y, rfl⟩
      obtain ⟨x, hx⟩ := φ.surjective (Limits.pullback.fst uu e y)
      have hxV : x ∈ V₁ := by
        apply hV
        refine ⟨Limits.pullback.snd uu e y, ?_⟩
        rw [← hφ, Scheme.Hom.comp_apply, hx, ← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply,
          Limits.pullback.condition]
      have hxr : x ∈ Set.range V₁.ι := by rw [Scheme.Opens.range_ι]; exact hxV
      obtain ⟨v, hv⟩ := hxr
      exact ⟨v, by rw [Scheme.Hom.comp_apply, hv, hx]⟩
    let b := IsOpenImmersion.lift V₁.ι (Limits.pullback.fst u₁ e) hb
    have hbf : b ≫ V₁.ι = Limits.pullback.fst u₁ e := IsOpenImmersion.lift_fac _ _ _
    let a := IsOpenImmersion.lift (V₁.ι ≫ φ) (Limits.pullback.fst uu e) ha
    have haf : a ≫ V₁.ι ≫ φ = Limits.pullback.fst uu e := IsOpenImmersion.lift_fac _ _ _
    have w₁ : (Limits.pullback.fst u₁ e ≫ φ) ≫ uu = Limits.pullback.snd u₁ e ≫ e := by
      rw [Category.assoc, hφ, Limits.pullback.condition]
    have w₂ : (a ≫ V₁.ι) ≫ u₁ = Limits.pullback.snd uu e ≫ e := by
      have e1 : (a ≫ V₁.ι) ≫ φ ≫ uu = (a ≫ V₁.ι ≫ φ) ≫ uu := by
        simp only [Category.assoc]
      rw [← hφ, e1, haf, Limits.pullback.condition]
    let Φ := Limits.pullback.lift _ _ w₁
    let Ψ := Limits.pullback.lift _ _ w₂
    have hΨΦ : Ψ ≫ Φ = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
          Category.assoc, haf, Category.id_comp]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd, Category.id_comp]
    have hΦa : Φ ≫ a = b := by
      rw [← cancel_mono (V₁.ι ≫ φ), Category.assoc, haf, Limits.pullback.lift_fst,
        ← Category.assoc, hbf]
    have hΦΨ : Φ ≫ Ψ = 𝟙 _ := by
      apply Limits.pullback.hom_ext
      · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, hΦa, hbf,
          Category.id_comp]
      · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd, Category.id_comp]
    exact IsPullback.of_iso_pullback (CommSq.mk w₁) ⟨Φ, Ψ, hΦΨ, hΨΦ⟩
      (Limits.pullback.lift_fst _ _ _) (Limits.pullback.lift_snd _ _ _)

  apply s2 u₁ uu φ _ V₁ hφ hsurj hoi
  rintro x ⟨t, ht⟩
  by_contra hx
  obtain ⟨K, hK, hKac, s, y, E, hy, _hyE, hE, hAF⟩ := hexc x hx
  have hux : u₁ x = s (Limits.pullback.snd u₁ s y) := by
    rw [← hy, ← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, Limits.pullback.condition]
  obtain ⟨t', ht'⟩ := s1 K s (Limits.pullback.snd u₁ s y) t (hux.symm.trans ht)
  exact @hgen K hK hKac s E hE hAF t' ht'

theorem wcpa_dj_lfc_contract_family : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (k : ℕ)
    (σ : Fin (k + 1) → (Spec (.of ↥W) ⟶ Z₁)) (r : ℕ) (ε : Fin r → (Spec (.of ↥W) ⟶ Z₁))
    (E₀ : Set ↥(Limits.pullback u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))))
    (L : wcpaDjCoc Z₁) (t : ∀ a : Fin L.m, Γ(Z₁, L.V a ⊓ u₁ ⁻¹ᵁ ⊤)),
    wcpaDjStablePtd u₁ (k + 1) σ →
    wcpaDjSections u₁ (k + 1 + r) (Fin.append σ ε) →
    E₀ ∈ irreducibleComponents ↥(Limits.pullback u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) →
    (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
      (θ : Er ≅ @Proj _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W))
        MvPolynomial.gradedAlgebra),
      IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E₀ ∧
      θ.hom ≫ @Proj.toSpecZero _ _ _ _ _
        (MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W))
        MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
          (algebraMap (IsLocalRing.ResidueField ↥W)
            ↥(MvPolynomial.homogeneousSubmodule (Fin 2) (IsLocalRing.ResidueField ↥W) 0))) =
      ι ≫ Limits.pullback.snd u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) →
    (∃ x ∈ E₀, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
      Limits.pullback.fst u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x =
      σ (Fin.last k)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q)) →
    (E₀ ∩ closure E₀ᶜ).ncard + Nat.card {i : Fin k // ∃ x ∈ E₀,
      ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
      Limits.pullback.fst u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x =
      σ (Fin.castSucc i)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q)} ≤ 2 →
    (E₀ ∩ closure E₀ᶜ).Nonempty →
    (∀ b, ¬ ∃ x ∈ E₀, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
      Limits.pullback.fst u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x =
      ε b (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q)) →
    (∀ E ∈ irreducibleComponents ↥(Limits.pullback u₁
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))),
      E ≠ E₀ → ∃ b, ∃ x ∈ E, ∃ q : ↥(Spec (.of (IsLocalRing.ResidueField ↥W))),
        Limits.pullback.fst u₁
          (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) x =
        ε b (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) q)) →
    wcpaDjCocOK L → wcpaDjCompat L (u₁ ⁻¹ᵁ ⊤) 1 t →
    (∀ a, (Z₁.basicOpen (t a) : Set Z₁) =
      ((L.V a ⊓ u₁ ⁻¹ᵁ ⊤ : Z₁.Opens) : Set Z₁) \ ⋃ i, Set.range ⇑(ε i)) →
    (∀ (K : Type u) [Field K] [IsAlgClosed K] (t' : Spec (.of K) ⟶ Spec (.of Ω))
      (E : Set ↥(Limits.pullback u₁ (t' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))))),
      E ∈ irreducibleComponents
        ↥(Limits.pullback u₁ (t' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) →
      (∃ (Er : Scheme.{u})
        (ι : Er ⟶ Limits.pullback u₁ (t' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))))
        (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra),
        IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
        θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
          MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
        ι ≫ Limits.pullback.snd u₁ (t' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) →
      3 ≤ (E ∩ closure Eᶜ).ncard + Nat.card {i : Fin k // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
        Limits.pullback.fst u₁ (t' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) x =
          σ (Fin.castSucc i) ((t' ≫ Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) p)}) →
    ∃ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (τ : Fin k → (Spec (.of ↥W) ⟶ Z))
      (φ : Z₁ ⟶ Z),
      φ ≫ uu = u₁ ∧ (∀ i, σ (Fin.castSucc i) ≫ φ = τ i) ∧ wcpaDjStablePtd uu k τ ∧
      IsPullback (Limits.pullback.fst u₁ (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ≫ φ)
        (Limits.pullback.snd u₁ (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)))) uu
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) :=
by
  intro Ω _ _ W Z₁ u₁ k σ r ε E₀ L t hst hsec hE₀ hP1₀ hp₀ hcnt₀ hnode havoid hcov hOK hcompat
    hbo gen
  have hsecε : wcpaDjSections u₁ r ε := by
    refine ⟨fun j => ?_, fun i j p q hij => ?_, fun j p => ?_⟩
    · have h1 := hsec.1 (Fin.natAdd (k + 1) j)
      rwa [Fin.append_right] at h1
    · have h1 := hsec.2.1 (Fin.natAdd (k + 1) i) (Fin.natAdd (k + 1) j) p q
        (fun h => hij (Fin.natAdd_injective _ _ h))
      rwa [Fin.append_right, Fin.append_right] at h1
    · have h1 := hsec.2.2 (Fin.natAdd (k + 1) j) p
      rwa [Fin.append_right] at h1
  have cls := wcpa_dj_lfc_af_classify Ω W Z₁ u₁ k σ r ε E₀ hst hsec hE₀ hP1₀ hp₀ hcnt₀ hnode
    havoid hcov gen
  obtain ⟨Z, uu, φ, hφ, hssZ, hfpZ, hsurj, hV₁, hfib⟩ :=
    wcpa_dj_lfc_contract_construct Ω W Z₁ u₁ r ε L t hst.1 hsecε hOK hcompat hbo (by
      intro K _ _ s E hE hAF
      obtain ⟨hP1, _, hsum, hnd, huniq, _⟩ := (cls K s).2 E hE hAF
      exact ⟨hP1, hnd, by omega, huniq⟩)
  have hstab := wcpa_dj_lfc_contract_stable Ω W Z₁ Z u₁ uu φ k σ r ε hφ hst hssZ hfpZ cls hfib
  have hgen := wcpa_dj_lfc_generic_iso Ω W Z₁ Z u₁ uu φ r ε hφ hsurj hV₁
    (fun K _ _ s E hE hAF => ((cls K s).2 E hE hAF).2.2.2.2.2)
  exact ⟨Z, uu, fun i => σ (Fin.castSucc i) ≫ φ, φ, hφ, fun i => rfl, hstab, hgen⟩

theorem wcpa_dj_lus_fc_contract_one : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (W : ValuationSubring Ω) (C : Scheme.{u}) (c : C ⟶ Spec (.of Ω)) (k : ℕ) (y : Fin k → (Spec (.of Ω) ⟶ C)), wcpaDjStablePtd c k y → ∀ (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (σ : Fin (k + 1) → (Spec (.of ↥W) ⟶ Z₁)) (ψ₁ : C ⟶ Z₁), wcpaDjStablePtd u₁ (k + 1) σ → IsPullback ψ₁ c u₁ (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) → (∀ i : Fin k, y i ≫ ψ₁ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ σ (Fin.castSucc i)) → ¬ (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Spec (.of ↥W)) (E : Set ↥(Limits.pullback u₁ s)), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) → (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u₁ s) (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra), IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧ θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K) MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) = ι ≫ Limits.pullback.snd u₁ s) → (∃ x ∈ E, ∃ p : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = σ (Fin.last k) (s p)) → 3 ≤ (E ∩ closure Eᶜ).ncard + Nat.card {i : Fin k // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = σ (Fin.castSucc i) (s p)}) → ∃ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (τ : Fin k → (Spec (.of ↥W) ⟶ Z)) (ψ : C ⟶ Z), wcpaDjStablePtd uu k τ ∧ IsPullback ψ c uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ∧ ∀ i, y i ≫ ψ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τ i :=
by
  intro Ω _ _ W C c k y hy Z₁ u₁ σ ψ₁ hst hpb hcomp hne

  have gen := wcpa_dj_lfc_generic_noexc Ω W C c k y hy Z₁ u₁ σ ψ₁ hpb hcomp

  obtain ⟨τκ, hstκ, hτs, hτf⟩ := wcpa_dj_lcp_stableptd_basechange u₁ (k + 1) σ
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) hst
  have hsec' : wcpaDjSections u₁ k (fun i => σ (Fin.castSucc i)) :=
    ⟨fun j => hst.2.1.1 _, fun i j p q hij => hst.2.1.2.1 _ _ p q
      (fun h => hij (Fin.castSucc_injective _ h)), fun j p => hst.2.1.2.2 _ p⟩
  have hnot : ¬ wcpaDjStablePtd u₁ k (fun i => σ (Fin.castSucc i)) := by
    intro h
    apply hne
    intro K _ _ s E hE hP1 _
    exact h.2.2 K s E hE hP1
  have hcl : ¬ wcpaDjStablePtd (Limits.pullback.snd u₁
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) k
      (fun i => τκ (Fin.castSucc i)) := by
    intro h
    exact hnot (wcpa_dj_lus_sm_closed_fibre_spreads Ω W Z₁ u₁ k (fun i => σ (Fin.castSucc i))
      (fun i => τκ (Fin.castSucc i)) hst.1 hsec' (fun i => hτs _) (fun i => hτf _) h)

  obtain ⟨E₀, hE₀, hP1₀, hp₀, hcnt₀⟩ :=
    wcpa_dj_lfc_closed_exc_datum Ω W Z₁ u₁ k σ τκ hst hτs hτf hstκ hcl

  have hnode := wcpa_dj_lfc_not_isolated Ω W Z₁ u₁ k σ E₀ hst hE₀ hP1₀ hp₀ hcnt₀ gen

  obtain ⟨r, ε, hsec, havoid, hcov⟩ :=
    wcpa_dj_lfc_anchor_sections Ω W Z₁ u₁ k σ E₀ hst.1 hst.2.1 hE₀
  have hsecε : wcpaDjSections u₁ r ε := by
    refine ⟨fun j => ?_, fun i j p q hij => ?_, fun j p => ?_⟩
    · have h1 := hsec.1 (Fin.natAdd (k + 1) j)
      rwa [Fin.append_right] at h1
    · have h1 := hsec.2.1 (Fin.natAdd (k + 1) i) (Fin.natAdd (k + 1) j) p q
        (fun h => hij (Fin.natAdd_injective _ _ h))
      rwa [Fin.append_right, Fin.append_right] at h1
    · have h1 := hsec.2.2 (Fin.natAdd (k + 1) j) p
      rwa [Fin.append_right] at h1

  haveI : IsProper u₁ := hst.1.2.1
  obtain ⟨L, t, hOK, hcompat, hbo⟩ :=
    wcpa_dj_lsp_divisor_cocycle u₁ r ε inferInstance inferInstance inferInstance hsecε

  obtain ⟨Z, uu, τ, φ, _hφ, hτ, hstab, hgen⟩ :=
    wcpa_dj_lfc_contract_family Ω W Z₁ u₁ k σ r ε E₀ L t hst hsec hE₀ hP1₀ hp₀ hcnt₀ hnode
      havoid hcov hOK hcompat hbo gen

  refine ⟨Z, uu, τ, ψ₁ ≫ φ, hstab, ?_, ?_⟩
  · refine IsPullback.of_iso hgen hpb.isoPullback.symm (Iso.refl _) (Iso.refl _) (Iso.refl _)
      ?_ ?_ ?_ ?_
    · rw [Iso.symm_hom, ← Category.assoc, hpb.isoPullback_inv_fst, Iso.refl_hom,
        Category.comp_id]
    · rw [Iso.symm_hom, hpb.isoPullback_inv_snd, Iso.refl_hom, Category.comp_id]
    · simp
    · simp
  · intro i
    rw [← Category.assoc, hcomp i, Category.assoc, hτ i]

theorem wcpa_dj_lus_sm_forget_contract : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (C : Scheme.{u}) (c : C ⟶ Spec (.of Ω)) (n m : ℕ)
    (x : Fin n → (Spec (.of Ω) ⟶ C)), wcpaDjStablePtd c n x →
    ∀ (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (σ : Fin (n + m) → (Spec (.of ↥W) ⟶ Z₁))
      (ψ₁ : C ⟶ Z₁), wcpaDjStablePtd u₁ (n + m) σ →
      IsPullback ψ₁ c u₁ (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) →
      (∀ i : Fin n, x i ≫ ψ₁ =
        Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ σ (Fin.castAdd m i)) →
    ∃ (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (τ : Fin n → (Spec (.of ↥W) ⟶ Z)) (ψ : C ⟶ Z),
      wcpaDjStablePtd uu n τ ∧
      IsPullback ψ c uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) ∧
      ∀ i, x i ≫ ψ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ τ i :=
by

  have s1 : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (C : Scheme.{u})
      (c : C ⟶ Spec (.of Ω)) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of ↥W)) (k : ℕ)
      (σ : Fin k → (Spec (.of ↥W) ⟶ Z₁)) (ψ₁ : C ⟶ Z₁), wcpaDjSections u₁ k σ →
      IsPullback ψ₁ c u₁ (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) →
      ∃ y : Fin k → (Spec (.of Ω) ⟶ C), wcpaDjSections c k y ∧
        ∀ j, y j ≫ ψ₁ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ σ j := by
    intro Ω _ W C c Z₁ u₁ k σ ψ₁ hσ hpb
    have pt : ∀ {A B D : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ D} {d : A ⟶ D}, a ≫ b = d →
        ∀ z, b (a z) = d z := by
      intro A B D a b d h z
      rw [← Scheme.Hom.comp_apply, h]
    let y : Fin k → (Spec (.of Ω) ⟶ C) := fun j =>
      hpb.lift (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ σ j) (𝟙 _)
        (by rw [Category.assoc, hσ.1 j, Category.comp_id, Category.id_comp])
    have hy1 : ∀ j, y j ≫ ψ₁ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫ σ j :=
      fun j => hpb.lift_fst _ _ _
    have hy2 : ∀ j, y j ≫ c = 𝟙 _ := fun j => hpb.lift_snd _ _ _
    refine ⟨y, ⟨hy2, ?_, ?_⟩, hy1⟩
    · intro i j p q hij heq
      apply hσ.2.1 i j (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) p)
        (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) q) hij
      have h1 := congrArg ψ₁ heq
      rw [pt (hy1 i) p, pt (hy1 j) q, Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h1
      exact h1
    · intro j p
      obtain ⟨W', hW', hW'sm⟩ := hσ.2.2 j (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) p)
      refine ⟨ψ₁ ⁻¹ᵁ W', ?_, ?_⟩
      · show ψ₁ (y j p) ∈ W'
        rw [pt (hy1 j) p, Scheme.Hom.comp_apply]
        exact hW'
      · have h1 : IsPullback (ψ₁ ∣_ W') (ψ₁ ⁻¹ᵁ W').ι W'.ι ψ₁ := isPullback_morphismRestrict ψ₁ W'
        have h2 : IsPullback (ψ₁ ∣_ W') ((ψ₁ ⁻¹ᵁ W').ι ≫ c) (W'.ι ≫ u₁)
            (Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω))) := h1.paste_vert hpb
        exact MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension 1) h2 hW'sm

  have s2 : ∀ {C S : Scheme.{u}} (c : C ⟶ S) (n k : ℕ) (x : Fin n → (S ⟶ C))
      (y : Fin k → (S ⟶ C)) (e : Fin n → Fin k), Function.Injective e → (∀ i, y (e i) = x i) →
      wcpaDjStablePtd c n x → wcpaDjSections c k y → wcpaDjStablePtd c k y := by
    intro C S c n k x y e he hye hx hy
    refine ⟨hx.1, hy, ?_⟩
    intro K _ _ s E hE hP1
    have h1 := hx.2.2 K s E hE hP1
    let f : {i : Fin n // ∃ z ∈ E, ∃ p : ↥(Spec (.of K)), Limits.pullback.fst c s z = x i (s p)} →
        {j : Fin k // ∃ z ∈ E, ∃ p : ↥(Spec (.of K)), Limits.pullback.fst c s z = y j (s p)} :=
      fun i => ⟨e i.1, by rw [hye i.1]; exact i.2⟩
    have hf : Function.Injective f := by
      intro a b hab
      apply Subtype.ext
      apply he
      exact congrArg Subtype.val hab
    exact h1.trans (Nat.add_le_add_left (Nat.card_le_card_of_injective f hf) _)

  have s3 : ∀ {Z S : Scheme.{u}} (g : Z ⟶ S) (k : ℕ) (σ : Fin (k + 1) → (S ⟶ Z)),
      wcpaDjStablePtd g (k + 1) σ →
      (∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ S)
        (E : Set ↥(Limits.pullback g s)), E ∈ irreducibleComponents ↥(Limits.pullback g s) →
        (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback g s)
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
          ι ≫ Limits.pullback.snd g s) →
        (∃ x ∈ E, ∃ p : ↥(Spec (.of K)), Limits.pullback.fst g s x = σ (Fin.last k) (s p)) →
        3 ≤ (E ∩ closure Eᶜ).ncard + Nat.card {i : Fin k // ∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
          Limits.pullback.fst g s x = σ (Fin.castSucc i) (s p)}) →
      wcpaDjStablePtd g k (fun i => σ (Fin.castSucc i)) := by
    intro Z S g k σ hσ hne
    refine ⟨hσ.1, ⟨fun j => hσ.2.1.1 _, fun i j p q hij => hσ.2.1.2.1 _ _ p q
      (fun h => hij (Fin.castSucc_injective _ h)), fun j p => hσ.2.1.2.2 _ p⟩, ?_⟩
    intro K _ _ s E hE hP1
    by_cases hlast : ∃ z ∈ E, ∃ p : ↥(Spec (.of K)),
        Limits.pullback.fst g s z = σ (Fin.last k) (s p)
    · exact hne K s E hE hP1 hlast
    · have h1 := hσ.2.2 K s E hE hP1
      let f : {j : Fin (k + 1) // ∃ z ∈ E, ∃ p : ↥(Spec (.of K)),
            Limits.pullback.fst g s z = σ j (s p)} →
          {i : Fin k // ∃ z ∈ E, ∃ p : ↥(Spec (.of K)),
            Limits.pullback.fst g s z = σ (Fin.castSucc i) (s p)} :=
        fun j => ⟨j.1.castPred (fun h => hlast (by rw [← h]; exact j.2)),
          by rw [Fin.castSucc_castPred]; exact j.2⟩
      have hf : Function.Injective f := by
        intro a b hab
        apply Subtype.ext
        have h := congrArg (fun t => Fin.castSucc t.1) hab
        simpa [f, Fin.castSucc_castPred] using h
      exact h1.trans (Nat.add_le_add_left (Nat.card_le_card_of_injective f hf) _)

  intro Ω _ _ W C c n m x hx
  induction m with
  | zero =>
    intro Z₁ u₁ σ ψ₁ hst hpb hcomp
    exact ⟨Z₁, u₁, σ, ψ₁, hst, hpb, hcomp⟩
  | succ m ih =>
    intro Z₁ u₁ σ ψ₁ hst hpb hcomp
    obtain ⟨y, hysec, hyc⟩ := s1 Ω W C c Z₁ u₁ (n + (m + 1)) σ ψ₁ hst.2.1 hpb
    have hyx : ∀ i : Fin n, y (Fin.castAdd (m + 1) i) = x i := by
      intro i
      apply hpb.hom_ext
      · rw [hyc, hcomp]
      · rw [hysec.1, hx.2.1.1 i]
    let y' : Fin (n + m) → (Spec (.of Ω) ⟶ C) := fun j => y (Fin.castSucc j)
    have hy'sec : wcpaDjSections c (n + m) y' :=
      ⟨fun j => hysec.1 _, fun i j p q h => hysec.2.1 _ _ p q
        (fun e => h (Fin.castSucc_injective _ e)), fun j p => hysec.2.2 _ p⟩
    have hy'x : ∀ i : Fin n, y' (Fin.castAdd m i) = x i := by
      intro i
      show y (Fin.castSucc (Fin.castAdd m i)) = x i
      rw [Fin.castSucc_castAdd]
      exact hyx i
    have hy' : wcpaDjStablePtd c (n + m) y' :=
      s2 c n (n + m) x y' (Fin.castAdd m) (Fin.castAdd_injective n m) hy'x hx hy'sec
    by_cases hne : ∀ (K : Type u) [Field K] [IsAlgClosed K] (s : Spec (.of K) ⟶ Spec (.of ↥W))
        (E : Set ↥(Limits.pullback u₁ s)), E ∈ irreducibleComponents ↥(Limits.pullback u₁ s) →
        (∃ (Er : Scheme.{u}) (ι : Er ⟶ Limits.pullback u₁ s)
          (θ : Er ≅ @Proj _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra),
          IsClosedImmersion ι ∧ IsReduced Er ∧ Set.range ι = E ∧
          θ.hom ≫ @Proj.toSpecZero _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin 2) K)
            MvPolynomial.gradedAlgebra ≫ Spec.map (CommRingCat.ofHom
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin 2) K 0))) =
          ι ≫ Limits.pullback.snd u₁ s) →
        (∃ x ∈ E, ∃ p : ↥(Spec (.of K)),
          Limits.pullback.fst u₁ s x = σ (Fin.last (n + m)) (s p)) →
        3 ≤ (E ∩ closure Eᶜ).ncard + Nat.card {i : Fin (n + m) // ∃ x ∈ E,
          ∃ p : ↥(Spec (.of K)), Limits.pullback.fst u₁ s x = σ (Fin.castSucc i) (s p)}
    · refine ih Z₁ u₁ (fun i => σ (Fin.castSucc i)) ψ₁ (s3 u₁ (n + m) σ hst hne) hpb ?_
      intro i
      show x i ≫ ψ₁ = Spec.map (CommRingCat.ofHom (algebraMap ↥W Ω)) ≫
        σ (Fin.castSucc (Fin.castAdd m i))
      rw [Fin.castSucc_castAdd]
      exact hcomp i
    · obtain ⟨Z', u', τ', ψ', hst', hpb', hc'⟩ :=
        wcpa_dj_lus_fc_contract_one Ω W C c (n + m) y' hy' Z₁ u₁ σ ψ₁ hst hpb
          (fun i => hyc (Fin.castSucc i)) hne
      refine ih Z' u' τ' ψ' hst' hpb' ?_
      intro i
      have h := hc' (Fin.castAdd m i)
      rwa [hy'x i] at h

theorem wcpa_dj_lsp_component_sections : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω)
    (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)), HenselianLocalRing ↥W →
    IsAlgClosed (IsLocalRing.ResidueField ↥W) → wcpaDjSemistable uu →
    LocallyOfFinitePresentation uu →
    ∃ (m : ℕ) (ε : Fin m → (Spec (.of ↥W) ⟶ Z)), wcpaDjSections uu m ε ∧
      ∀ z : Z, uu z = IsLocalRing.closedPoint ↥W → ¬ IsClosed ({z} : Set Z) →
        ∃ a, ε a (IsLocalRing.closedPoint ↥W) ∈ closure ({z} : Set Z) :=
by
  intro Ω _ W Z uu hH hκ hss hfp
  classical
  haveI := hH
  haveI := hκ

  have key : ∀ (κ : Type u) [Field κ] [IsAlgClosed κ] (C : Scheme.{u}) (c : C ⟶ Spec (.of κ)),
      wcpaDjSemistable c → ∃ (m₀ : ℕ) (t : Fin m₀ → (Spec (.of κ) ⟶ C)),
        (∀ j, t j ≫ c = 𝟙 _) ∧
        (∀ j k, j ≠ k → t j (IsLocalRing.closedPoint κ) ≠ t k (IsLocalRing.closedPoint κ)) ∧
        (∀ j, ∃ V : C.Opens, t j (IsLocalRing.closedPoint κ) ∈ V ∧
          SmoothOfRelativeDimension 1 (V.ι ≫ c)) ∧
        ∀ w : C, ¬ IsClosed ({w} : Set C) →
          ∃ j, t j (IsLocalRing.closedPoint κ) ∈ closure ({w} : Set C) := by
    intro κ _ _ C c hssC
    haveI hprop : IsProper c := hssC.2.1
    haveI : LocallyOfFiniteType c := inferInstance
    haveI : IsLocallyNoetherian C := LocallyOfFiniteType.isLocallyNoetherian c
    haveI : CompactSpace C := QuasiCompact.compactSpace_of_compactSpace c
    haveI : IsNoetherian C := {}
    have hfin : (irreducibleComponents C).Finite :=
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents
    haveI : JacobsonSpace C := LocallyOfFiniteType.jacobsonSpace c

    have hΦ : (asIso (Limits.pullback.fst c (𝟙 (Spec (.of κ))))).symm.hom ≫
        Limits.pullback.snd c (𝟙 (Spec (.of κ))) = c := by
      simp only [Iso.symm_hom, asIso_inv]
      rw [IsIso.inv_comp_eq, Limits.pullback.condition, Category.comp_id]
    have hdich := fun x : C => wcpa_dj_ssp_bw_ns_transport κ
      (asIso (Limits.pullback.fst c (𝟙 (Spec (.of κ))))).symm
      c (Limits.pullback.snd c (𝟙 (Spec (.of κ)))) hΦ x (hssC.2.2 κ (𝟙 _) _)
    let U : C.Opens := sSup {V : C.Opens | SmoothOfRelativeDimension 1 (V.ι ≫ c)}
    have hnodes : ∀ x : C, x ∉ U → ∀ a : C.presheaf.stalk x, ∃ z : κ,
        a - ((Scheme.ΓSpecIso (.of κ)).inv ≫ c.appTop ≫ C.presheaf.germ ⊤ x trivial).hom z ∈
          IsLocalRing.maximalIdeal (C.presheaf.stalk x) := by
      intro x hx
      rcases hdich x with ⟨V, hxV, hV⟩ | hnd
      · exact absurd (TopologicalSpace.Opens.mem_sSup.mpr ⟨V, hV, hxV⟩) hx
      · exact wcpa_dj_nf_node_residue κ (C.presheaf.stalk x) _ hnd
    have hclosed := (wcpa_dj_nf_nodes_closed_finite κ C c U hprop hnodes).1
    have hsm : ∀ w : C, ¬ IsClosed ({w} : Set C) →
        ∃ V : C.Opens, w ∈ V ∧ SmoothOfRelativeDimension 1 (V.ι ≫ c) := by
      intro w hw
      by_cases hwU : w ∈ U
      · obtain ⟨V, hV, hwV⟩ := TopologicalSpace.Opens.mem_sSup.mp hwU
        exact ⟨V, hwV, hV⟩
      · exact absurd (hclosed w hwU) hw

    have hcomp : ∀ w : C, ¬ IsClosed ({w} : Set C) →
        closure ({w} : Set C) ∈ irreducibleComponents C := by
      intro w hw
      obtain ⟨V, hwV, hV⟩ := hsm w hw
      obtain ⟨D, hD, hwD⟩ := exists_mem_irreducibleComponents_subset_of_isIrreducible _
        (isIrreducible_singleton (x := w)).closure
      have hDm : Maximal (fun s : Set C => IsClosed s ∧ IsIrreducible s) D := by
        have h := hD
        rw [irreducibleComponents_eq_maximals_closed] at h
        exact h
      obtain ⟨η, hη⟩ : ∃ η : C, closure ({η} : Set C) = D :=
        ⟨hDm.prop.2.genericPoint,
          isGenericPoint_def.mp (hDm.prop.2.isGenericPoint_genericPoint hDm.prop.1)⟩
      by_contra hne
      have hDne : closure ({w} : Set C) ≠ D := fun h => hne (h ▸ hD)
      have h1 : w ∈ closure (closure ({w} : Set C) ∩ closedPoints C) := by
        rw [closure_inter_closedPoints isClosed_closure]
        exact subset_closure (Set.mem_singleton w)
      obtain ⟨c₀, hc₀V, hc₀w, hc₀cl⟩ := mem_closure_iff.mp h1 V V.isOpen hwV
      have hc₀closed : IsClosed ({c₀} : Set C) := mem_closedPoints_iff.mp hc₀cl
      have hηw : η ⤳ w := by
        rw [specializes_iff_mem_closure, hη]
        exact hwD (subset_closure (Set.mem_singleton w))
      have hwc₀ : w ⤳ c₀ := specializes_iff_mem_closure.mpr hc₀w
      have hηV : η ∈ V := hηw.mem_open V.isOpen hwV
      have hηne : η ≠ w := fun h => hDne (by rw [← hη, h])
      have hwne : w ≠ c₀ := fun h => hw (h ▸ hc₀closed)
      have hrange : ∀ x ∈ V, ∃ x' : V.toScheme, V.ι x' = x := by
        intro x hx
        have : x ∈ Set.range V.ι := by rw [Scheme.Opens.range_ι]; exact hx
        exact this
      obtain ⟨η', hη'⟩ := hrange η hηV
      obtain ⟨w', hw'⟩ := hrange w hwV
      obtain ⟨c₀', hc₀'⟩ := hrange c₀ hc₀V
      have hind : Topology.IsInducing (V.ι : V.toScheme → C) := V.ι.isOpenEmbedding.isInducing
      have s1 : η' ⤳ w' := hind.specializes_iff.mp (by rw [hη', hw']; exact hηw)
      have s2 : w' ⤳ c₀' := hind.specializes_iff.mp (by rw [hw', hc₀']; exact hwc₀)
      haveI : SmoothOfRelativeDimension 1 (V.ι ≫ c) := hV
      have hdim := wc_smooth_alg_closed_dim_le κ V.toScheme (V.ι ≫ c) 1
      have hdim' : Order.krullDim (TopologicalSpace.IrreducibleCloseds V.toScheme) ≤ 1 := by
        have e : topologicalKrullDim V.toScheme =
            Order.krullDim (TopologicalSpace.IrreducibleCloseds V.toScheme) := rfl
        rw [← e]
        exact_mod_cast hdim
      let cl : V.toScheme → TopologicalSpace.IrreducibleCloseds V.toScheme := fun x =>
        ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
      have hle : ∀ x y : V.toScheme, x ⤳ y → cl y ≤ cl x := fun x y h =>
        SetLike.coe_subset_coe.mp (specializes_iff_closure_subset.mp h)
      have hle' : ∀ x y : V.toScheme, cl y ≤ cl x → x ⤳ y := fun x y h =>
        specializes_iff_closure_subset.mpr (SetLike.coe_subset_coe.mpr h)
      rcases Order.krullDim_le_one_iff.mp hdim' (cl w') with hmin | hmax
      · have h2 : c₀' ⤳ w' := hle' c₀' w' (hmin (hle w' c₀' s2))
        have heq : w' = c₀' := (s2.antisymm h2 : Inseparable w' c₀').eq
        apply hwne
        rw [← hw', ← hc₀', heq]
      · have h2 : w' ⤳ η' := hle' w' η' (hmax (hle η' w' s1))
        have heq : η' = w' := (s1.antisymm h2 : Inseparable η' w').eq
        apply hηne
        rw [← hη', ← hw', heq]

    set G : Set C := {w : C | ¬ IsClosed ({w} : Set C)} with hGdef
    have hG : G.Finite :=
      Set.Finite.of_injOn (f := fun w => closure ({w} : Set C)) (t := irreducibleComponents C)
        (fun w hw => hcomp w hw) (fun a _ b _ h => (inseparable_iff_closure_eq.mpr h).eq) hfin
    haveI : Finite G := hG.to_subtype

    have hpoint : ∀ w : G, ∃ t : Spec (.of κ) ⟶ C, t ≫ c = 𝟙 _ ∧
        t (IsLocalRing.closedPoint κ) ∈ closure ({w.1} : Set C) ∧
        (∀ w' : C, ¬ IsClosed ({w'} : Set C) → w' ≠ w.1 →
          t (IsLocalRing.closedPoint κ) ∉ closure ({w'} : Set C)) ∧
        ∃ V : C.Opens, t (IsLocalRing.closedPoint κ) ∈ V ∧
          SmoothOfRelativeDimension 1 (V.ι ≫ c) := by
      rintro ⟨w, hw⟩
      obtain ⟨V, hwV, hV⟩ := hsm w hw
      have hwm : Maximal (fun s : Set C => IsClosed s ∧ IsIrreducible s) (closure {w}) := by
        have h := hcomp w hw
        rw [irreducibleComponents_eq_maximals_closed] at h
        exact h
      set B : Set (Set C) := {D' | D' ∈ irreducibleComponents C ∧ D' ≠ closure {w}} with hB
      have hBcl : IsClosed (⋃₀ B) :=
        (hfin.subset (fun D' h => h.1)).isClosed_sUnion
          (fun D' h => isClosed_of_mem_irreducibleComponents D' h.1)
      have hwB : w ∉ ⋃₀ B := by
        rintro ⟨D', ⟨hD', hne⟩, hwD'⟩
        apply hne
        have hD'm : Maximal (fun s : Set C => IsClosed s ∧ IsIrreducible s) D' := by
          rw [irreducibleComponents_eq_maximals_closed] at hD'
          exact hD'
        have hsub : closure {w} ⊆ D' :=
          closure_minimal (Set.singleton_subset_iff.mpr hwD') hD'm.prop.1
        exact (hwm.eq_of_le hD'm.prop hsub).symm
      have hOo : IsOpen ((V : Set C) ∩ (⋃₀ B)ᶜ) := V.isOpen.inter hBcl.isOpen_compl
      have h1 : w ∈ closure (closure ({w} : Set C) ∩ closedPoints C) := by
        rw [closure_inter_closedPoints isClosed_closure]
        exact subset_closure (Set.mem_singleton w)
      obtain ⟨y, hyO, hyw, hycl⟩ := mem_closure_iff.mp h1 _ hOo ⟨hwV, hwB⟩
      obtain ⟨t, ht1, ht2⟩ := wc_glc_closed_point_section κ C c y (mem_closedPoints_iff.mp hycl)
      refine ⟨t, ht1, by rw [ht2]; exact hyw, ?_, V, by rw [ht2]; exact hyO.1, hV⟩
      intro w' hw' hne hmem
      rw [ht2] at hmem
      apply hyO.2
      refine ⟨closure {w'}, ⟨hcomp w' hw', ?_⟩, hmem⟩
      intro heq
      exact hne (inseparable_iff_closure_eq.mpr heq).eq
    choose t ht1 ht2 ht3 ht4 using hpoint
    obtain ⟨m₀, ⟨e⟩⟩ : ∃ m : ℕ, Nonempty (G ≃ Fin m) := ⟨_, ⟨Finite.equivFin _⟩⟩
    refine ⟨m₀, fun j => t (e.symm j), fun j => ht1 _, ?_, fun j => ht4 _, ?_⟩
    · intro j k hjk heq
      have hne : (e.symm j).1 ≠ (e.symm k).1 := fun h => hjk (e.symm.injective (Subtype.ext h))
      have heq' : t (e.symm j) (IsLocalRing.closedPoint κ) =
          t (e.symm k) (IsLocalRing.closedPoint κ) := heq
      exact ht3 (e.symm j) _ (e.symm k).2 (Ne.symm hne) (by rw [heq']; exact ht2 _)
    · intro w hw
      refine ⟨e ⟨w, hw⟩, ?_⟩
      show t (e.symm (e ⟨w, hw⟩)) (IsLocalRing.closedPoint κ) ∈ closure ({w} : Set C)
      rw [Equiv.symm_apply_apply]
      exact ht2 ⟨w, hw⟩

  have hpt : ∀ {A B C : Scheme.{u}} {a : A ⟶ B} {b : B ⟶ C} {c : A ⟶ C}, a ≫ b = c →
      ∀ x, b (a x) = c x := by
    intro A B C a b c h x
    rw [← Scheme.Hom.comp_apply, h]
  have hres_surj : Function.Surjective (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) := by
    rw [IsLocalRing.ResidueField.algebraMap_eq]; exact IsLocalRing.residue_surjective
  have hρci : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) :=
    IsClosedImmersion.spec_of_surjective _ hres_surj
  have hρpt : Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))
      (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) = IsLocalRing.closedPoint ↥W := by
    have : IsLocalHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) := by
      rw [IsLocalRing.ResidueField.algebraMap_eq]; infer_instance
    exact AlgebraicGeometry.Spec_closedPoint

  have hhens : ∀ (V : Z.Opens), SmoothOfRelativeDimension 1 (V.ι ≫ uu) →
      ∀ (t : Spec (.of (IsLocalRing.ResidueField ↥W)) ⟶ Z),
      t (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W)) ∈ V →
      t ≫ uu = Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) →
      ∃ σ : Spec (.of ↥W) ⟶ Z, σ ≫ uu = 𝟙 _ ∧
        Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) ≫ σ = t := by
    intro V hsm t htV htg
    obtain ⟨U, hU, htU, hUV⟩ := exists_isAffineOpen_mem_and_subset htV
    have hUle : U ≤ V := hUV
    haveI : Smooth (V.ι ≫ uu) := SmoothOfRelativeDimension.smooth 1 _
    have hfs : hU.fromSpec = (hU.isoSpec.inv ≫ Z.homOfLE hUle) ≫ V.ι := by
      rw [Category.assoc, Scheme.homOfLE_ι, IsAffineOpen.isoSpec_inv_ι]
    haveI hsm2 : Smooth (hU.fromSpec ≫ uu) := by
      rw [hfs, Category.assoc]
      infer_instance
    set φ : CommRingCat.of ↥W ⟶ Γ(Z, U) := Spec.preimage (hU.fromSpec ≫ uu) with hφdef
    have hφ : Spec.map φ = hU.fromSpec ≫ uu := Spec.map_preimage _
    have hφsm : φ.hom.Smooth := by
      rw [← HasRingHomProperty.Spec_iff (P := @Smooth), hφ]
      exact hsm2
    have hrange : Set.range t ⊆ Set.range hU.fromSpec := by
      rw [IsAffineOpen.range_fromSpec]
      rintro _ ⟨p, rfl⟩
      rw [Subsingleton.elim p (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))]
      exact htU
    set t' := IsOpenImmersion.lift hU.fromSpec t hrange with ht'def
    have ht' : t' ≫ hU.fromSpec = t := IsOpenImmersion.lift_fac _ _ _
    set ψ : Γ(Z, U) ⟶ CommRingCat.of (IsLocalRing.ResidueField ↥W) := Spec.preimage t' with hψdef
    have hψ : Spec.map ψ ≫ hU.fromSpec = t := by rw [Spec.map_preimage]; exact ht'
    have K1 : φ ≫ ψ = CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) := by
      apply Spec.map_inj.mp
      rw [Spec.map_comp, hφ, ← Category.assoc, hψ, htg]
    letI : Algebra ↥W Γ(Z, U) := φ.hom.toAlgebra
    haveI : Algebra.Smooth ↥W Γ(Z, U) := RingHom.Smooth.toAlgebra hφsm
    let σb : Γ(Z, U) →ₐ[↥W] IsLocalRing.ResidueField ↥W :=
      { ψ.hom with
        commutes' := fun r => by
          show ψ.hom (φ.hom r) = algebraMap ↥W (IsLocalRing.ResidueField ↥W) r
          rw [← CommRingCat.comp_apply, K1]
          rfl }
    obtain ⟨τ, hτ⟩ := wc_hnas_smooth_section_henselian ↥W Γ(Z, U) σb
    let τ' : Γ(Z, U) ⟶ CommRingCat.of ↥W := CommRingCat.ofHom (τ : Γ(Z, U) →+* ↥W)
    refine ⟨Spec.map τ' ≫ hU.fromSpec, ?_, ?_⟩
    · have e1 : φ ≫ τ' = 𝟙 _ := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro r
        show τ (algebraMap ↥W Γ(Z, U) r) = r
        rw [AlgHom.commutes, Algebra.algebraMap_self, RingHom.id_apply]
      rw [Category.assoc, ← hφ, ← Spec.map_comp, e1, Spec.map_id]
    · have e2 : τ' ≫ CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) = ψ := by
        apply CommRingCat.hom_ext
        apply RingHom.ext
        intro x
        show algebraMap ↥W (IsLocalRing.ResidueField ↥W) (τ x) = ψ.hom x
        rw [IsLocalRing.ResidueField.algebraMap_eq, hτ x]
        rfl
      rw [← Category.assoc, ← Spec.map_comp, e2, hψ]

  have hbc := wcpa_dj_mm_semistable_basechange _ _ _
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) uu hss
  have hdesc := fun w => wcpa_dj_bsc_smooth_descend (Spec (.of ↥W)) Z uu
    (IsLocalRing.ResidueField ↥W)
    (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) w hss.1 hfp
  generalize Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) = ρ
    at hρci hρpt hbc hdesc hhens ⊢
  haveI := hρci
  haveI hprop : IsProper uu := hss.2.1
  have hfst_ce : Topology.IsClosedEmbedding (Limits.pullback.fst uu ρ) :=
    (Limits.pullback.fst uu ρ).isClosedEmbedding
  have hfst_inj : Function.Injective (Limits.pullback.fst uu ρ) := hfst_ce.injective
  obtain ⟨m₀, t, ht1, htne, htsm, htcov⟩ :=
    key (IsLocalRing.ResidueField ↥W) _ (Limits.pullback.snd uu ρ) hbc

  have hεex : ∀ j : Fin m₀, ∃ σ : Spec (.of ↥W) ⟶ Z, σ ≫ uu = 𝟙 _ ∧
      ρ ≫ σ = t j ≫ Limits.pullback.fst uu ρ ∧
      ∃ V' : Z.Opens, σ (IsLocalRing.closedPoint ↥W) ∈ V' ∧
        SmoothOfRelativeDimension 1 (V'.ι ≫ uu) := by
    intro j
    obtain ⟨V, hV, hVsm⟩ := htsm j
    obtain ⟨V', hV'1, hV'2⟩ := hdesc _ ⟨V, hV, hVsm⟩
    obtain ⟨σ, hσ1, hσ2⟩ := hhens V' hV'2 (t j ≫ Limits.pullback.fst uu ρ)
      (by exact hV'1)
      (by rw [Category.assoc, Limits.pullback.condition, ← Category.assoc, ht1,
        Category.id_comp])
    refine ⟨σ, hσ1, hσ2, V', ?_, hV'2⟩
    have h := hpt hσ2 (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))
    rw [hρpt] at h
    rw [h]
    exact hV'1
  choose ε hε1 hε2 hε3 using hεex
  have hεpt : ∀ j, ε j (IsLocalRing.closedPoint ↥W) =
      Limits.pullback.fst uu ρ (t j (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))) := by
    intro j
    have h := hpt (hε2 j) (IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W))
    rw [hρpt] at h
    rw [h]
    exact (hpt rfl _).symm
  have hεne : ∀ j k, j ≠ k →
      ε j (IsLocalRing.closedPoint ↥W) ≠ ε k (IsLocalRing.closedPoint ↥W) := by
    intro j k hjk h
    rw [hεpt, hεpt] at h
    exact htne j k hjk (hfst_inj h)

  let τ₀ : Fin 0 → (Spec (.of ↥W) ⟶ Z) := fun i => Fin.elim0 i
  have hsec₀ : wcpaDjSections uu 0 τ₀ :=
    ⟨fun j => Fin.elim0 j, fun i => Fin.elim0 i, fun j => Fin.elim0 j⟩
  have hA : wcpaDjSections uu (0 + m₀) (Fin.append τ₀ ε) :=
    wcpa_dj_lus_am_append_sections ↥W Z uu inferInstance 0 m₀ τ₀ ε hsec₀ hε1 hε3 hεne
      (fun i => Fin.elim0 i)
  refine ⟨0 + m₀, Fin.append τ₀ ε, hA, ?_⟩

  intro z hz hzc
  have hzr : z ∈ Set.range (Limits.pullback.fst uu ρ) := by
    rw [Scheme.Pullback.range_fst]
    show uu z ∈ Set.range ρ
    rw [hz]
    exact ⟨_, hρpt⟩
  obtain ⟨w, rfl⟩ := hzr
  have hw : ¬ IsClosed ({w} : Set ↥(Limits.pullback uu ρ)) := by
    intro hcl
    apply hzc
    have h := hfst_ce.isClosedMap _ hcl
    rwa [Set.image_singleton] at h
  obtain ⟨j, hj⟩ := htcov w hw
  refine ⟨Fin.natAdd 0 j, ?_⟩
  rw [Fin.append_right, hεpt]
  rw [show ({Limits.pullback.fst uu ρ w} : Set Z) = (Limits.pullback.fst uu ρ) '' {w} from
    Set.image_singleton.symm, hfst_ce.closure_image_eq]
  exact Set.mem_image_of_mem _ hj

theorem wcpa_dj_lsp_va_to_amp : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T) (L : wcpaDjCoc Y) (W : T.Opens) (e : ℕ), wcpaDjCocOK L → wcpaDjVA q L W e → wcpaDjAmp q L W e :=
by
  intro Y T q L W e hOK hVA
  classical
  obtain ⟨M, t, h1, h2, h3, h4⟩ := hVA
  have res : ∀ {A B C : Y.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(Y, A)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
        (Y.presheaf.map (homOfLE h3).op).hom x := by
    intro A B C h1 h2 h3 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have hA1 : ∀ J, wcpaDjCompat L (q ⁻¹ᵁ W) e (t J) := fun J => h1 J
  refine ⟨M, t, hA1, ?_, h3, ?_⟩
  ·
    apply le_antisymm
    · exact iSup_le fun J => iSup_le fun a => (Y.basicOpen_le (t J a)).trans inf_le_right
    · intro x hx
      have hxV : x ∈ (⨆ a, L.V a) := by rw [hOK.2.1]; trivial
      obtain ⟨a, ha⟩ := TopologicalSpace.Opens.mem_iSup.mp hxV
      have hx' : x ∈ L.V a ⊓ q ⁻¹ᵁ W := ⟨ha, hx⟩
      have h1mem : (1 : Γ(Y, L.V a ⊓ q ⁻¹ᵁ W)) ∈ Ideal.span (Set.range fun J => t J a) := by
        rw [h2 a]; trivial
      obtain ⟨c, hc⟩ := (Ideal.mem_span_range_iff_exists_fun).mp h1mem
      have hsum : ∑ J, (Y.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ W) x hx').hom (c J) *
          (Y.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ W) x hx').hom (t J a) = 1 := by
        rw [← map_one (Y.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ W) x hx').hom, ← hc, map_sum]
        simp only [map_mul]
      have hunit : ∃ J, IsUnit ((Y.presheaf.germ (L.V a ⊓ q ⁻¹ᵁ W) x hx').hom (t J a)) := by
        by_contra hne
        push_neg at hne
        have hmem : (1 : Y.presheaf.stalk x) ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x) := by
          rw [← hsum]
          exact Ideal.sum_mem _ fun J _ =>
            Ideal.mul_mem_left _ _ ((IsLocalRing.mem_maximalIdeal _).mpr (hne J))
        exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top ((Ideal.eq_top_iff_one _).mpr hmem)
      obtain ⟨J, hJ⟩ := hunit
      have hxB : x ∈ Y.basicOpen (t J a) := (Y.mem_basicOpen (t J a) x hx').mpr hJ
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨J, TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hxB⟩⟩
  ·
    intro J
    have hu : ∀ a, IsUnit ((Y.presheaf.map (homOfLE (Y.basicOpen_le (t J a))).op).hom (t J a)) :=
      fun a => Y.toRingedSpace.isUnit_res_basicOpen (t J a)
    obtain ⟨r, hr⟩ : ∃ r : Fin (M + 1) → ∀ a : Fin L.m, Γ(Y, Y.basicOpen (t J a)),
        ∀ l a, r l a * (Y.presheaf.map (homOfLE (Y.basicOpen_le (t J a))).op).hom (t J a) =
          (Y.presheaf.map (homOfLE (Y.basicOpen_le (t J a))).op).hom (t l a) := by
      refine ⟨fun l a => (Y.presheaf.map (homOfLE (Y.basicOpen_le (t J a))).op).hom (t l a) *
        ((hu a).unit⁻¹ : (Γ(Y, Y.basicOpen (t J a)))ˣ), ?_⟩
      intro l a
      rw [mul_assoc, IsUnit.val_inv_mul, mul_one]
    have compat : ∀ l, TopCat.Presheaf.IsCompatible Y.sheaf.obj
        (fun a => Y.basicOpen (t J a)) (r l) := by
      intro l a b
      have ra : Y.basicOpen (t J a) ≤ L.V a ⊓ q ⁻¹ᵁ W := Y.basicOpen_le (t J a)
      have rb : Y.basicOpen (t J b) ≤ L.V b ⊓ q ⁻¹ᵁ W := Y.basicOpen_le (t J b)
      have hPb : L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V b ⊓ q ⁻¹ᵁ W :=
        le_inf (inf_le_left.trans inf_le_right) inf_le_right
      have hPa : L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V a ⊓ q ⁻¹ᵁ W :=
        le_inf (inf_le_left.trans inf_le_left) inf_le_right
      have hPab : L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V a ⊓ L.V b := inf_le_left
      have hQP : Y.basicOpen (t J a) ⊓ Y.basicOpen (t J b) ≤ L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W :=
        fun x hx => ⟨⟨(ra hx.1).1, (rb hx.2).1⟩, (ra hx.1).2⟩
      have hQa : Y.basicOpen (t J a) ⊓ Y.basicOpen (t J b) ≤ Y.basicOpen (t J a) := inf_le_left
      have hQb : Y.basicOpen (t J a) ⊓ Y.basicOpen (t J b) ≤ Y.basicOpen (t J b) := inf_le_right
      have hC : ∀ l', (Y.presheaf.map (homOfLE hPb).op).hom (t l' b) =
          (Y.presheaf.map (homOfLE hPab).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ e) *
          (Y.presheaf.map (homOfLE hPa).op).hom (t l' a) := fun l' => hA1 l' a b
      have key : ∀ l', (Y.presheaf.map (homOfLE (hQb.trans rb)).op).hom (t l' b) =
          (Y.presheaf.map (homOfLE hQP).op).hom ((Y.presheaf.map (homOfLE hPab).op).hom
            ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ e)) *
          (Y.presheaf.map (homOfLE hQa).op).hom ((Y.presheaf.map (homOfLE ra).op).hom (t l' a)) := by
        intro l'
        rw [← res hPb hQP (hQb.trans rb), hC l', map_mul, res hPa hQP (hQa.trans ra),
          res ra hQa (hQa.trans ra)]
      have hσ : IsUnit ((Y.presheaf.map (homOfLE (hQb.trans rb)).op).hom (t J b)) := by
        rw [← res rb hQb (hQb.trans rb)]
        exact (hu b).map _
      show (Y.presheaf.map (homOfLE hQa).op).hom (r l a) =
        (Y.presheaf.map (homOfLE hQb).op).hom (r l b)
      rw [← hσ.mul_left_inj]
      calc _ = (Y.presheaf.map (homOfLE hQP).op).hom ((Y.presheaf.map (homOfLE hPab).op).hom
            ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ e)) *
          (Y.presheaf.map (homOfLE hQa).op).hom
            (r l a * (Y.presheaf.map (homOfLE ra).op).hom (t J a)) := by
            rw [key J, map_mul (Y.presheaf.map (homOfLE hQa).op).hom]
            ring
        _ = (Y.presheaf.map (homOfLE (hQb.trans rb)).op).hom (t l b) := by
            rw [hr l a, key l]
        _ = _ := by
            rw [← res rb hQb (hQb.trans rb) (t l b), ← res rb hQb (hQb.trans rb) (t J b),
              ← map_mul (Y.presheaf.map (homOfLE hQb).op).hom, hr l b]
    have glue : ∀ l, ∃ ρl : Γ(Y, ⨆ a, Y.basicOpen (t J a)), ∀ a,
        (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (t J a')) a)).op).hom ρl =
          r l a := by
      intro l
      obtain ⟨ρl, hρl, -⟩ := TopCat.Sheaf.existsUnique_gluing' Y.sheaf
        (fun a => Y.basicOpen (t J a)) (⨆ a, Y.basicOpen (t J a))
        (fun a => homOfLE (le_iSup (fun a' => Y.basicOpen (t J a')) a)) le_rfl (r l) (compat l)
      exact ⟨ρl, hρl⟩
    choose ρ hρ using glue
    have hDO : (⨆ a, Y.basicOpen (t J a)) ≤ q ⁻¹ᵁ W :=
      iSup_le fun a => (Y.basicOpen_le (t J a)).trans inf_le_right
    letI : Algebra Γ(T, W) Γ(Y, ⨆ a, Y.basicOpen (t J a)) :=
      ((Y.presheaf.map (homOfLE hDO).op).hom.comp (q.app W).hom).toAlgebra
    have hsurj : Function.Surjective (MvPolynomial.aeval (R := Γ(T, W)) ρ) := by
      intro f
      obtain ⟨P, hP⟩ := h4 J f
      refine ⟨P, ?_⟩
      rw [MvPolynomial.aeval_def]
      refine TopCat.Sheaf.eq_of_locally_eq' Y.sheaf (fun a => Y.basicOpen (t J a)) _
        (fun a => homOfLE (le_iSup (fun a' => Y.basicOpen (t J a')) a)) le_rfl _ _ (fun a => ?_)
      obtain ⟨inv, hinv, hf⟩ := hP a
      change (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (t J a')) a)).op).hom
          (MvPolynomial.eval₂ (algebraMap Γ(T, W) Γ(Y, ⨆ a, Y.basicOpen (t J a))) ρ P) =
        (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (t J a')) a)).op).hom f
      rw [hf, MvPolynomial.eval₂_comp_left]
      congr 1
      · apply RingHom.ext
        intro x
        exact res _ _ _ _
      · funext l
        rw [Function.comp_apply, hρ l a]
        calc r l a = r l a * (inv * (Y.presheaf.map
              (homOfLE (Y.basicOpen_le (t J a))).op).hom (t J a)) := by rw [hinv, mul_one]
          _ = (r l a * (Y.presheaf.map
              (homOfLE (Y.basicOpen_le (t J a))).op).hom (t J a)) * inv := by ring
          _ = _ := by rw [hr l a]
    exact Algebra.FiniteType.iff_quotient_mvPolynomial''.mpr ⟨M + 1, MvPolynomial.aeval ρ, hsurj⟩

theorem wcpa_dj_lsp_closed_fibre_section : ∀ (Ω : Type u) [Field Ω] (W : ValuationSubring Ω) (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (m : ℕ) (ε : Fin m → (Spec (.of ↥W) ⟶ Z)) (L : wcpaDjCoc Z) (t : ∀ a : Fin L.m, Γ(Z, L.V a ⊓ uu ⁻¹ᵁ ⊤)), wcpaDjSemistable uu → wcpaDjSections uu m ε → (∀ z : Z, uu z = IsLocalRing.closedPoint ↥W → ¬ IsClosed ({z} : Set Z) → ∃ a, ε a (IsLocalRing.closedPoint ↥W) ∈ closure ({z} : Set Z)) → wcpaDjCompat L (uu ⁻¹ᵁ ⊤) 1 t → (∀ a, (Z.basicOpen (t a) : Set Z) = ((L.V a ⊓ uu ⁻¹ᵁ ⊤ : Z.Opens) : Set Z) \ ⋃ i, Set.range ⇑(ε i)) → (∀ ξ : ↥(Limits.pullback uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))), closure {ξ} ∈ irreducibleComponents ↥(Limits.pullback uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) → ¬ IsClosed ({ξ} : Set ↥(Limits.pullback uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))))) → ∃ t' : ∀ a : Fin (wcpaDjCocPull (Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L).m, Γ(Limits.pullback uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))), (wcpaDjCocPull (Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L).V a ⊓ Limits.pullback.snd uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ⁻¹ᵁ ⊤), wcpaDjCompat (wcpaDjCocPull (Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L) (Limits.pullback.snd uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) ⁻¹ᵁ ⊤) 1 t' ∧ (∀ ξ, closure {ξ} ∈ irreducibleComponents ↥(Limits.pullback uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) → ∀ a, ξ ∈ (wcpaDjCocPull (Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L).V a → ξ ∈ (Limits.pullback uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).basicOpen (t' a)) ∧ (∀ ξ, closure {ξ} ∈ irreducibleComponents ↥(Limits.pullback uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) → ∃ x ∈ closure {ξ}, ∀ a, x ∈ (wcpaDjCocPull (Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L).V a → x ∉ (Limits.pullback uu (Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))).basicOpen (t' a)) :=
by
  intro Ω _ W Z uu m ε L t hss₀ hsec hcov hcomp hbo hgen
  classical

  have compat_pull : ∀ {Y' Y : Scheme.{u}} (h : Y' ⟶ Y) (L : wcpaDjCoc Y) (O : Y.Opens)
      (O' : Y'.Opens) (hO : O' ≤ h ⁻¹ᵁ O) (t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ O)),
      wcpaDjCompat L O 1 t → wcpaDjCompat (wcpaDjCocPull h L) O' 1
        (fun a => (h.appLE (L.V a ⊓ O) (h ⁻¹ᵁ L.V a ⊓ O') (fun x hx => ⟨hx.1, hO hx.2⟩)).hom
          (t a)) := by
    intro Y' Y h L O O' hO t ht
    rintro (a : Fin L.m) (b : Fin L.m)
    have hpull : ∀ (U : Y.Opens) (V V' : Y'.Opens) (h1 : V' ≤ h ⁻¹ᵁ U) (h2 : V ≤ V')
        (x : Γ(Y, U)),
        (Y'.presheaf.map (homOfLE h2).op).hom ((Y'.presheaf.map (homOfLE h1).op).hom
          ((h.app U).hom x)) = (h.appLE U V (h2.trans h1)).hom x := by
      intro U V V' h1 h2 x
      rw [← CommRingCat.comp_apply, ← Functor.map_comp, Scheme.Hom.appLE,
        ← CommRingCat.comp_apply]
      rfl
    have hg : ∀ (V : Y'.Opens)
        (hV : V ≤ (wcpaDjCocPull h L).V a ⊓ (wcpaDjCocPull h L).V b),
        (Y'.presheaf.map (homOfLE hV).op).hom ((wcpaDjCocPull h L).g a b :
          Γ(Y', (wcpaDjCocPull h L).V a ⊓ (wcpaDjCocPull h L).V b)) =
        (h.appLE (L.V a ⊓ L.V b) V (fun x hx => hV hx)).hom (L.g a b) := by
      intro V hV
      exact hpull (L.V a ⊓ L.V b) V _ _ hV _
    have hT : (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ O') ≤ h ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ O) :=
      fun x hx => ⟨⟨hx.1.1, hx.1.2⟩, hO hx.2⟩
    have hres : ∀ (U : Y.Opens) (V V' : Y'.Opens) (e1 : V' ≤ h ⁻¹ᵁ U) (h2 : V ≤ V')
        (x : Γ(Y, U)),
        (Y'.presheaf.map (homOfLE h2).op).hom ((h.appLE U V' e1).hom x) =
          (h.appLE U V (h2.trans e1)).hom x := by
      intro U V V' e1 h2 x
      rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map]
    have e := congrArg (h.appLE (L.V a ⊓ L.V b ⊓ O) _ hT).hom (ht a b)
    simp only [pow_one, map_mul] at e ⊢
    rw [hg]
    simp only [← CommRingCat.comp_apply, Scheme.Hom.map_appLE] at e
    have r1 := hres (L.V b ⊓ O) (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ O') (h ⁻¹ᵁ L.V b ⊓ O')
      (fun x hx => ⟨hx.1, hO hx.2⟩) (fun x hx => ⟨hx.1.2, hx.2⟩) (t b)
    have r2 := hres (L.V a ⊓ O) (h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ O') (h ⁻¹ᵁ L.V a ⊓ O')
      (fun x hx => ⟨hx.1, hO hx.2⟩) (fun x hx => ⟨hx.1.1, hx.2⟩) (t a)
    exact r1.trans (e.trans (congrArg (HMul.hMul _) r2.symm))

  haveI hρ : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  haveI hfci : IsClosedImmersion (Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) := inferInstance
  haveI := hss₀.2.1
  set ρ := Spec.map (CommRingCat.ofHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W))) with hρdef
  set f := Limits.pullback.fst uu ρ with hfdef
  set q := Limits.pullback.snd uu ρ with hqdef
  have hfce : Topology.IsClosedEmbedding f := f.isClosedEmbedding
  have hfinj : Function.Injective f := hfce.isEmbedding.injective
  have hfib : ∀ x, uu (f x) = IsLocalRing.closedPoint ↥W := by
    intro x
    have h1 : uu (f x) = ρ (q x) := by
      rw [← Scheme.Hom.comp_apply, Limits.pullback.condition, Scheme.Hom.comp_apply]
    rw [h1]
    have h2 : q x = IsLocalRing.closedPoint (IsLocalRing.ResidueField ↥W) :=
      Subsingleton.elim (α := PrimeSpectrum (IsLocalRing.ResidueField ↥W)) _ _
    rw [h2]
    haveI : IsLocalHom (algebraMap ↥W (IsLocalRing.ResidueField ↥W)) := by
      rw [IsLocalRing.ResidueField.algebraMap_eq]; infer_instance
    exact IsLocalRing.comap_closedPoint (algebraMap ↥W (IsLocalRing.ResidueField ↥W))
  have hεcl : ∀ i, IsClosed ({ε i (IsLocalRing.closedPoint ↥W)} : Set Z) := by
    intro i
    haveI : IsClosedImmersion (ε i ≫ uu) := by rw [hsec.1 i]; infer_instance
    haveI : IsClosedImmersion (ε i) := IsClosedImmersion.of_comp (ε i) uu
    have := (ε i).isClosedEmbedding.isClosedMap _
      (IsLocalRing.isClosed_singleton_closedPoint ↥W)
    have e2 : ((ε i) '' {IsLocalRing.closedPoint ↥W}) =
        ({ε i (IsLocalRing.closedPoint ↥W)} : Set Z) := Set.image_singleton
    exact cast (congrArg IsClosed e2) this
  have hpre : ∀ ξ, IsClosed ({f ξ} : Set Z) → IsClosed ({ξ} : Set ↥(Limits.pullback uu ρ)) := by
    intro ξ h
    have : (f ⁻¹' {f ξ}) = {ξ} := by
      ext y
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      exact ⟨fun h => hfinj h, fun h => h ▸ rfl⟩
    rw [← this]
    exact h.preimage f.continuous
  have hsecpt : ∀ i p ξ, ε i p = f ξ → p = IsLocalRing.closedPoint ↥W := by
    intro i p ξ hp
    have h1 : uu (ε i p) = p := by
      rw [← Scheme.Hom.comp_apply, hsec.1 i]
      rfl
    rw [← h1, hp, hfib]
  have hgnr : ∀ ξ, closure {ξ} ∈ irreducibleComponents ↥(Limits.pullback uu ρ) →
      f ξ ∉ ⋃ i, Set.range (ε i) := by
    intro ξ hξ hU
    rw [Set.mem_iUnion] at hU
    obtain ⟨i, p, hp⟩ := hU
    have hp0 := hsecpt i p ξ hp
    rw [hp0] at hp
    apply hgen ξ hξ
    apply hpre
    rw [← hp]
    exact hεcl i

  have hO : q ⁻¹ᵁ ⊤ ≤ f ⁻¹ᵁ (uu ⁻¹ᵁ ⊤) := fun x _ => trivial
  have hmem : ∀ a (x : ↥(Limits.pullback uu ρ)),
      x ∈ (Limits.pullback uu ρ).basicOpen ((f.appLE (L.V a ⊓ uu ⁻¹ᵁ ⊤) (f ⁻¹ᵁ L.V a ⊓ q ⁻¹ᵁ ⊤)
        (fun x hx => ⟨hx.1, hO hx.2⟩)).hom (t a)) ↔
      (x ∈ f ⁻¹ᵁ L.V a ∧ f x ∉ ⋃ i, Set.range (ε i)) := by
    intro a x
    have hb := Scheme.basicOpen_appLE f (f ⁻¹ᵁ L.V a ⊓ q ⁻¹ᵁ ⊤) (L.V a ⊓ uu ⁻¹ᵁ ⊤)
      (fun x hx => ⟨hx.1, hO hx.2⟩) (t a)
    have h1 : x ∈ (Limits.pullback uu ρ).basicOpen ((f.appLE (L.V a ⊓ uu ⁻¹ᵁ ⊤)
        (f ⁻¹ᵁ L.V a ⊓ q ⁻¹ᵁ ⊤) (fun x hx => ⟨hx.1, hO hx.2⟩)).hom (t a)) ↔
        x ∈ (f ⁻¹ᵁ L.V a ⊓ q ⁻¹ᵁ ⊤) ⊓ f ⁻¹ᵁ Z.basicOpen (t a) := by
      rw [← hb]
    rw [h1]
    have h2 : f x ∈ Z.basicOpen (t a) ↔ f x ∈ (Z.basicOpen (t a) : Set Z) := Iff.rfl
    rw [hbo a] at h2
    constructor
    · rintro ⟨⟨hx1, _⟩, hx2⟩
      exact ⟨hx1, (h2.mp hx2).2⟩
    · rintro ⟨hx1, hx2⟩
      exact ⟨⟨hx1, trivial⟩, h2.mpr ⟨⟨hx1, trivial⟩, hx2⟩⟩
  refine ⟨fun a => (f.appLE (L.V a ⊓ uu ⁻¹ᵁ ⊤) (f ⁻¹ᵁ L.V a ⊓ q ⁻¹ᵁ ⊤)
      (fun x hx => ⟨hx.1, hO hx.2⟩)).hom (t a), compat_pull f L _ _ hO t hcomp, ?_, ?_⟩
  · intro ξ hξ a ha
    exact (hmem a ξ).mpr ⟨ha, hgnr ξ hξ⟩
  · intro ξ hξ
    have hnc : ¬ IsClosed ({f ξ} : Set Z) := fun h => hgen ξ hξ (hpre ξ h)
    obtain ⟨i, hi⟩ := hcov (f ξ) (hfib ξ) hnc
    rw [← Set.image_singleton, hfce.closure_image_eq] at hi
    obtain ⟨x, hx, hxe⟩ := hi
    refine ⟨x, hx, fun a _ hb => ?_⟩
    exact ((hmem a x).mp hb).2 (Set.mem_iUnion.mpr ⟨i, _, hxe.symm⟩)

theorem wcpa_dj_lsp_fibre_amp : ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω]
    (W : ValuationSubring Ω) (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of ↥W)) (m : ℕ)
    (ε : Fin m → (Spec (.of ↥W) ⟶ Z)) (L : wcpaDjCoc Z)
    (t : ∀ a : Fin L.m, Γ(Z, L.V a ⊓ uu ⁻¹ᵁ ⊤)),
    wcpaDjSemistable uu → wcpaDjSections uu m ε →
    (∀ z : Z, uu z = IsLocalRing.closedPoint ↥W → ¬ IsClosed ({z} : Set Z) →
      ∃ a, ε a (IsLocalRing.closedPoint ↥W) ∈ closure ({z} : Set Z)) →
    wcpaDjCocOK L → wcpaDjCompat L (uu ⁻¹ᵁ ⊤) 1 t →
    (∀ a, (Z.basicOpen (t a) : Set Z) =
      ((L.V a ⊓ uu ⁻¹ᵁ ⊤ : Z.Opens) : Set Z) \ ⋃ i, Set.range ⇑(ε i)) →
    ∃ e : ℕ, 0 < e ∧ wcpaDjAmp (Limits.pullback.snd uu (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))))
      (wcpaDjCocPull (Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom
        (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) L) ⊤ e :=
by
  intro Ω _ _ W Z uu m ε L t hss₀ hsec hcov hOK hcomp hbo
  classical

  have hsplit : ∀ f : Polynomial ↥W, f.Monic → ∃ s : Multiset ↥W,
      f = (s.map (fun y => Polynomial.X - Polynomial.C y)).prod := by
    intro f hf
    set g := f.map (algebraMap ↥W Ω) with hgdef
    have hg : g.Monic := hf.map _
    have hroots : ∀ θ ∈ g.roots, ∃ y : ↥W, algebraMap ↥W Ω y = θ := by
      intro θ hθ
      have hθ' : Polynomial.aeval θ f = 0 := by
        rw [← Polynomial.eval_map_algebraMap]
        exact (Polynomial.mem_roots hg.ne_zero).mp hθ
      have hint : IsIntegral ↥W θ := ⟨f, hf, by rwa [Polynomial.aeval_def] at hθ'⟩
      exact IsIntegrallyClosed.isIntegral_iff.mp hint
    choose! y hy using hroots
    refine ⟨g.roots.map y, ?_⟩
    apply Polynomial.map_injective (algebraMap ↥W Ω) (IsFractionRing.injective ↥W Ω)
    rw [Polynomial.map_multiset_prod, Multiset.map_map, Multiset.map_map]
    rw [← hgdef]
    conv_lhs => rw [← Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hg
      IsAlgClosed.card_roots_eq_natDegree]
    congr 1
    apply Multiset.map_congr rfl
    intro θ hθ
    simp only [Function.comp_apply, Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C,
      hy θ hθ]
  have hκ : IsAlgClosed (IsLocalRing.ResidueField ↥W) := by
    apply IsAlgClosed.of_exists_root
    intro p hp hirr
    have hlift : p ∈ Polynomial.lifts (IsLocalRing.residue ↥W) :=
      (Polynomial.lifts_iff_coeff_lifts p).2 (fun n => IsLocalRing.residue_surjective _)
    obtain ⟨P, hPmap, _, hPmon⟩ := Polynomial.lifts_and_degree_eq_and_monic hlift hp
    obtain ⟨s, hs⟩ := hsplit P hPmon
    by_cases hs0 : s = 0
    · exfalso
      rw [hs0, Multiset.map_zero, Multiset.prod_zero] at hs
      rw [hs, Polynomial.map_one] at hPmap
      rw [← hPmap] at hirr
      exact not_irreducible_one hirr
    · obtain ⟨y, hy⟩ := Multiset.exists_mem_of_ne_zero hs0
      refine ⟨IsLocalRing.residue ↥W y, ?_⟩
      have hPy : Polynomial.eval y P = 0 := by
        rw [hs, Polynomial.eval_multiset_prod]
        apply Multiset.prod_eq_zero
        rw [Multiset.map_map]
        exact Multiset.mem_map.mpr ⟨y, hy, by simp⟩
      rw [← hPmap, Polynomial.eval_map, Polynomial.eval₂_hom, hPy, map_zero]
  haveI := hκ

  have cocpull_ok : ∀ {Y' Y : Scheme.{u}} (h : Y' ⟶ Y) (L : wcpaDjCoc Y), IsAffineHom h →
      wcpaDjCocOK L → wcpaDjCocOK (wcpaDjCocPull h L) := by
    intro Y' Y h L hA hL
    obtain ⟨hL1, hL2, hL3, hL4⟩ := hL
    have hpull : ∀ (U : Y.Opens) (V V' : Y'.Opens) (h1 : V' ≤ h ⁻¹ᵁ U) (h2 : V ≤ V')
        (x : Γ(Y, U)),
        (Y'.presheaf.map (homOfLE h2).op).hom ((Y'.presheaf.map (homOfLE h1).op).hom
          ((h.app U).hom x)) = (h.appLE U V (h2.trans h1)).hom x := by
      intro U V V' h1 h2 x
      rw [← CommRingCat.comp_apply, ← Functor.map_comp, Scheme.Hom.appLE,
        ← CommRingCat.comp_apply]
      rfl
    have key : ∀ (U U' : Y.Opens) (V : Y'.Opens) (hUU' : U' ≤ U) (hV : V ≤ h ⁻¹ᵁ U')
        (hV' : V ≤ h ⁻¹ᵁ U) (x : Γ(Y, U)),
        (h.appLE U V hV').hom x = (h.appLE U' V hV).hom ((Y.presheaf.map (homOfLE hUU').op).hom x) := by
      intro U U' V hUU' hV hV' x
      rw [← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
    have hg : ∀ (a b : Fin L.m) (V : Y'.Opens)
        (hV : V ≤ (wcpaDjCocPull h L).V a ⊓ (wcpaDjCocPull h L).V b),
        (Y'.presheaf.map (homOfLE hV).op).hom ((wcpaDjCocPull h L).g a b :
          Γ(Y', (wcpaDjCocPull h L).V a ⊓ (wcpaDjCocPull h L).V b)) =
        (h.appLE (L.V a ⊓ L.V b) V (fun x hx => hV hx)).hom (L.g a b) := by
      intro a b V hV
      exact hpull (L.V a ⊓ L.V b) V _ _ hV _
    refine ⟨fun a => (hL1 a).preimage h, ?_, ?_, ?_⟩
    · show (⨆ a, h ⁻¹ᵁ L.V a) = ⊤
      rw [← Scheme.Hom.preimage_iSup, hL2]
      rfl
    · intro a
      show Units.map _ (L.g a a) = 1
      rw [hL3 a, map_one]
    · rintro (a : Fin L.m) (b : Fin L.m) (c : Fin L.m)
      have hT : (wcpaDjCocPull h L).V a ⊓ (wcpaDjCocPull h L).V b ⊓ (wcpaDjCocPull h L).V c ≤
          h ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ L.V c) := fun x hx => ⟨⟨hx.1.1, hx.1.2⟩, hx.2⟩
      rw [hg, hg, hg]
      have e := congrArg (h.appLE (L.V a ⊓ L.V b ⊓ L.V c) _ hT).hom (hL4 a b c)
      rw [map_mul] at e
      simp only [← CommRingCat.comp_apply, Scheme.Hom.map_appLE] at e
      exact e

  haveI hρ : IsClosedImmersion (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) :=
    IsClosedImmersion.spec_of_surjective _ IsLocalRing.residue_surjective
  have hss := wcpa_dj_mm_semistable_basechange _ _ _ (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W)))) uu hss₀
  have hfaff : IsAffineHom (Limits.pullback.fst uu (Spec.map (CommRingCat.ofHom
      (algebraMap ↥W (IsLocalRing.ResidueField ↥W))))) :=
    (isClosedImmersion_iff_isAffineHom.mp inferInstance).1
  have hOK' := cocpull_ok _ L hfaff hOK
  have hgen := fun ξ hξ => (wcpa_dj_lsp_generic_smooth _ _ _ hss ξ hξ).1
  obtain ⟨t', hc', hnv, hz⟩ :=
    wcpa_dj_lsp_closed_fibre_section Ω W Z uu m ε L t hss₀ hsec hcov hcomp hbo hgen

  have hpos := wcpa_dj_lsp_section_comp_deg_pos _ _ _ _ t' hss hOK' hc' hnv hz
  obtain ⟨e, M, t'', he, hsep⟩ := wcpa_dj_fva_separating_sections _ _ _ _ hss hOK' hpos
  exact ⟨e, he, wcpa_dj_lsp_va_to_amp _ _ ⊤ e hOK'
    (wcpa_dj_fva_chart_criterion _ _ _ _ hss hOK' e M t'' hsep)⟩

theorem wcpa_dj_lsa_noeth_model : ∀ (R : Type u) [CommRing R] [IsLocalRing R] (Z : Scheme.{u}) (uu : Z ⟶ Spec (.of R)), IsProper uu → LocallyOfFinitePresentation uu → ∀ L : wcpaDjCoc Z, wcpaDjCocOK L → ∃ (A : Type u) (_ : CommRing A) (_ : IsLocalRing A) (_ : IsNoetherianRing A) (ψ : A →+* R) (_ : IsLocalHom ψ) (Z₁ : Scheme.{u}) (u₁ : Z₁ ⟶ Spec (.of A)) (φ : Z ⟶ Z₁) (L₁ : wcpaDjCoc Z₁), IsProper u₁ ∧ IsPullback φ uu u₁ (Spec.map (CommRingCat.ofHom ψ)) ∧ wcpaDjCocOK L₁ ∧ wcpaDjCocPull φ L₁ = L :=
by
  classical
  intro R _ _ Z uu hprop hfp L hOK
  haveI := hprop
  haveI := hfp

  have red0 : ∀ {Y : Scheme.{u}} {U₁ U₂ U₃ : Y.Opens} (i : U₂ ≤ U₁) (j : U₃ ≤ U₂) (z : Γ(Y, U₁)),
      (Y.presheaf.map (homOfLE j).op).hom ((Y.presheaf.map (homOfLE i).op).hom z) =
        (Y.presheaf.map (homOfLE (j.trans i)).op).hom z := by
    intro Y U₁ U₂ U₃ i j z
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have red3 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) {U U' : Y.Opens} {V : X.Opens} (hU : U' ≤ U)
      (e : V ≤ f ⁻¹ᵁ U') (y : Γ(Y, U)),
      (X.presheaf.map (homOfLE e).op).hom ((f.app U').hom
          ((Y.presheaf.map (homOfLE hU).op).hom y)) =
        (X.presheaf.map (homOfLE (e.trans (fun x hx => hU hx))).op).hom ((f.app U).hom y) := by
    intro X Y f U U' V hU e y
    change (Y.presheaf.map (homOfLE hU).op ≫ f.app U' ≫ X.presheaf.map (homOfLE e).op).hom y =
      (f.app U ≫ X.presheaf.map (homOfLE (e.trans (fun x hx => hU hx))).op).hom y
    rw [Scheme.Hom.naturality_assoc, ← Functor.map_comp]
    rfl
  have pull_comp : ∀ {X Y W : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ W) (L : wcpaDjCoc W),
      wcpaDjCocPull f (wcpaDjCocPull g L) = wcpaDjCocPull (f ≫ g) L := by
    intro X Y W f g L
    simp only [wcpaDjCocPull]
    congr 1
    funext a b
    apply Units.ext
    exact red3 f _ _ _
  have pull_ok : ∀ {Y' Y : Scheme.{u}} (h : Y' ⟶ Y) (L : wcpaDjCoc Y),
      (∀ a, IsAffineOpen (h ⁻¹ᵁ L.V a)) → wcpaDjCocOK L → wcpaDjCocOK (wcpaDjCocPull h L) := by
    intro Y' Y h L haff hL
    obtain ⟨_, hcov, hid, hcoc⟩ := hL
    refine ⟨haff, ?_, ?_, ?_⟩
    · show ⨆ a, h ⁻¹ᵁ L.V a = ⊤
      rw [← Scheme.Hom.preimage_iSup, hcov, Scheme.Hom.preimage_top]
    · intro a
      show Units.map _ (L.g a a) = 1
      rw [hid a, map_one]
    · show ∀ a b c : Fin L.m, _
      intro a b c
      have H := congrArg (h.app (L.V a ⊓ L.V b ⊓ L.V c) ≫ Y'.presheaf.map (homOfLE
        (show h ⁻¹ᵁ L.V a ⊓ h ⁻¹ᵁ L.V b ⊓ h ⁻¹ᵁ L.V c ≤ h ⁻¹ᵁ (L.V a ⊓ L.V b ⊓ L.V c) from
          fun x hx => hx)).op).hom (hcoc a b c)
      rw [map_mul] at H
      simp only [CommRingCat.comp_apply, red3] at H
      show (Y'.presheaf.map (homOfLE _).op).hom ((Y'.presheaf.map (homOfLE _).op).hom
            ((h.app (L.V a ⊓ L.V b)).hom (L.g a b : Γ(Y, L.V a ⊓ L.V b)))) *
          (Y'.presheaf.map (homOfLE _).op).hom ((Y'.presheaf.map (homOfLE _).op).hom
            ((h.app (L.V b ⊓ L.V c)).hom (L.g b c : Γ(Y, L.V b ⊓ L.V c)))) =
        (Y'.presheaf.map (homOfLE _).op).hom ((Y'.presheaf.map (homOfLE _).op).hom
            ((h.app (L.V a ⊓ L.V c)).hom (L.g a c : Γ(Y, L.V a ⊓ L.V c))))
      exact (congrArg₂ (· * ·) (red0 _ _ _) (red0 _ _ _)).trans (H.trans (red0 _ _ _).symm)

  obtain ⟨S₀, Y, hY, π, hYprop, hπ⟩ := wc_fet_lfp_model_over_subring R
    (fun S => Subring.closure (S : Set R))
    (fun S a ha => Subring.subset_closure (Finset.mem_coe.mpr ha)) Z uu
  haveI := hYprop
  haveI hN0 : IsNoetherianRing ↥(Subring.closure ((S₀ : Finset R) : Set R)) :=
    is_noetherian_subring_closure _ (Finset.finite_toSet S₀)

  have hYlfp : LocallyOfFinitePresentation hY := by
    refine LocallyOfFinitePresentation.mk ?_
    intro U hU V hV e
    have hft := HasRingHomProperty.appLE @LocallyOfFiniteType hY inferInstance ⟨U, hU⟩ ⟨V, hV⟩ e
    haveI : IsNoetherianRing Γ(Spec (.of ↥(Subring.closure ((S₀ : Finset R) : Set R))), U) :=
      IsLocallyNoetherian.component_noetherian ⟨U, hU⟩
    exact RingHom.FinitePresentation.of_finiteType.mp hft

  obtain ⟨E, ρ, hE, sE, ⟨hlim⟩, hAff, hCpt, hQS, -, -, -, hpbT, hpbS, -, -, -⟩ :=
    wc_ap_fp_model_limit_presentation R Z uu S₀ Y hY π inferInstance inferInstance hYlfp hπ

  obtain ⟨i, L', hL'aff, hpull⟩ := wcpa_dj_lnm_coc_data (Finset R)ᵒᵖ E (Limits.Cone.mk Z ρ) hlim
    hAff hCpt hQS L hOK.1

  obtain ⟨j, f, hOK''⟩ := wcpa_dj_lnm_coc_refine (Finset R)ᵒᵖ E (Limits.Cone.mk Z ρ) hlim
    hAff hCpt hQS i L' hL'aff (by rw [hpull]; exact hOK)
  have hw0 : ρ.app j ≫ E.map f = ρ.app i := (Limits.Cone.mk Z ρ).w f
  have hL : wcpaDjCocPull (ρ.app j) (wcpaDjCocPull (E.map f) L') = L := by
    rw [pull_comp, hw0]
    exact hpull

  have hEprop : IsProper (hE j.unop) :=
    MorphismProperty.of_isPullback (P := @IsProper) (hpbS j.unop) hYprop

  haveI hNB : IsNoetherianRing ↥(Subring.closure (((S₀ ∪ j.unop : Finset R)) : Set R)) :=
    is_noetherian_subring_closure _ (Finset.finite_toSet _)
  obtain ⟨Λ, -, hχΛ, -, hN, hLoc, hLH⟩ := wc_ap_local_noetherian_subrings _ R
    (Subring.closure (((S₀ ∪ j.unop : Finset R)) : Set R)).subtype
  set χ := (Subring.closure (((S₀ ∪ j.unop : Finset R)) : Set R)).subtype with hχ
  set ψ := (Λ ∅).subtype with hψ
  set α := χ.codRestrict (Λ ∅) (hχΛ ∅) with hα
  have hψα : ψ.comp α = χ := RingHom.ext fun b => rfl
  have hsplit : Spec.map (CommRingCat.ofHom χ) =
      Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (CommRingCat.ofHom α) := by
    rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, hψα]

  have hw : ρ.app j ≫ hE j.unop =
      (uu ≫ Spec.map (CommRingCat.ofHom ψ)) ≫ Spec.map (CommRingCat.ofHom α) := by
    rw [(hpbT j.unop).w, hsplit, Category.assoc]
  have hout : IsPullback (Limits.pullback.lift _ _ hw ≫ Limits.pullback.fst (hE j.unop)
      (Spec.map (CommRingCat.ofHom α))) uu (hE j.unop)
      (Spec.map (CommRingCat.ofHom ψ) ≫ Spec.map (CommRingCat.ofHom α)) := by
    rw [Limits.pullback.lift_fst, ← hsplit]
    exact hpbT j.unop
  have hsq : IsPullback (Limits.pullback.lift _ _ hw) uu
      (Limits.pullback.snd (hE j.unop) (Spec.map (CommRingCat.ofHom α)))
      (Spec.map (CommRingCat.ofHom ψ)) :=
    IsPullback.of_right hout (Limits.pullback.lift_snd _ _ _) (IsPullback.of_hasPullback _ _)
  have hu₁ : IsProper (Limits.pullback.snd (hE j.unop) (Spec.map (CommRingCat.ofHom α))) :=
    MorphismProperty.of_isPullback (P := @IsProper) (IsPullback.of_hasPullback _ _) hEprop
  haveI hpaff : IsAffineHom (Limits.pullback.fst (hE j.unop) (Spec.map (CommRingCat.ofHom α))) :=
    MorphismProperty.of_isPullback (P := @IsAffineHom) (IsPullback.of_hasPullback _ _).flip
      inferInstance
  have hOK₁ := pull_ok (Limits.pullback.fst (hE j.unop) (Spec.map (CommRingCat.ofHom α)))
    (wcpaDjCocPull (E.map f) L') (fun a => (hOK''.1 a).preimage _) hOK''
  refine ⟨↥(Λ ∅), inferInstance, hLoc ∅, hN ∅, ψ, hLH ∅, _, _, Limits.pullback.lift _ _ hw, _,
    hu₁, hsq, hOK₁, ?_⟩
  rw [pull_comp, Limits.pullback.lift_fst]
  exact hL

theorem wcpa_dj_lcp_cta_local_lift : ∀ (Y : Scheme.{u}) (L : wcpaDjCoc Y), wcpaDjCocOK L →
    ∀ (x : Y), IsClosed ({x} : Set Y) → ∀ (a₀ : Fin L.m) (hx₀ : x ∈ L.V a₀) (n : ℕ),
    ∃ w : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ ⊤),
      (∀ (a : Fin L.m) (z : Y) (hz : z ∈ L.V a ⊓ ⊤), z ∉ L.V a₀ →
        (Y.presheaf.germ (L.V a ⊓ ⊤) z hz).hom (w a) ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk z)) ∧
      ∀ (a : Fin L.m) (hx : x ∈ L.V a ⊓ ⊤),
        (Y.presheaf.germ (L.V a ⊓ ⊤) x hx).hom (w a) -
          (Y.presheaf.germ (L.V a₀ ⊓ L.V a) x ⟨hx₀, hx.1⟩).hom
            ((L.g a₀ a : Γ(Y, L.V a₀ ⊓ L.V a)) ^ n) ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk x) :=
by
  intro Y L hL x hxc a₀ hx₀ n

  have core : ∀ (U O : Y.Opens), IsAffineOpen U → x ∈ O → ∀ G : x ∈ U → Y.presheaf.stalk x,
      ∃ w : Γ(Y, U), (∀ (z : Y) (hz : z ∈ U), z ∉ O →
        (Y.presheaf.germ U z hz).hom w ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z)) ∧
        ∀ hx : x ∈ U, (Y.presheaf.germ U x hx).hom w - G hx ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk x) := by
    intro U O hU hxO G
    by_cases hx : x ∈ U
    swap
    · refine ⟨0, fun z hz _ => ?_, fun hx' => absurd hx' hx⟩
      rw [map_zero]
      exact Ideal.zero_mem _

    have hmax : (hU.primeIdealOf ⟨x, hx⟩).asIdeal.IsMaximal := by
      have ha : hU.fromSpec (hU.primeIdealOf ⟨x, hx⟩) = x := hU.fromSpec_primeIdealOf ⟨x, hx⟩
      have hinj : Function.Injective hU.fromSpec := hU.fromSpec.isOpenEmbedding.injective
      have hpre : (⇑hU.fromSpec) ⁻¹' {x} = {hU.primeIdealOf ⟨x, hx⟩} := by
        ext q
        simp only [Set.mem_preimage, Set.mem_singleton_iff]
        constructor
        · intro h; exact hinj (h.trans ha.symm)
        · intro h; rw [h]; exact ha
      have hcl : IsClosed ((⇑hU.fromSpec) ⁻¹' {x}) := hxc.preimage hU.fromSpec.continuous
      rw [hpre] at hcl
      exact (PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hcl

    obtain ⟨f, hfle, hxf⟩ := hU.exists_basicOpen_le (V := O ⊓ U) ⟨x, ⟨hxO, hx⟩⟩ hx
    have hfu : IsUnit ((Y.presheaf.germ U x hx).hom f) := (Scheme.mem_basicOpen Y f x hx).mp hxf
    have hfv : ∀ (z : Y) (hz : z ∈ U), z ∉ O →
        (Y.presheaf.germ U z hz).hom f ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z) := by
      intro z hz hzO
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      intro hu
      have hzD : z ∈ Y.basicOpen f := (Scheme.mem_basicOpen Y f z hz).mpr hu
      exact hzO (hfle hzD).1

    have hlift : ∀ τ : Y.presheaf.stalk x, ∃ r : Γ(Y, U),
        (Y.presheaf.germ U x hx).hom r - τ ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x) := by
      intro τ
      letI : Algebra Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) :=
        TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨x, hx⟩
      have := hU.isLocalization_stalk ⟨x, hx⟩
      let τ' : Y.presheaf.stalk (⟨x, hx⟩ : U).1 := τ
      obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.mk'_surjective
        (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl τ'
      have hs : (s : Γ(Y, U)) ∉ (hU.primeIdealOf ⟨x, hx⟩).asIdeal := s.2
      obtain ⟨y, i, hi, hyi⟩ := hmax.exists_inv hs
      have h1 : τ' * algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) s =
          algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) b := by
        rw [← hbs]; exact IsLocalization.mk'_spec _ b s
      have h2 : algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) y *
          algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) s +
          algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) i = 1 := by
        rw [← map_mul, ← map_add, hyi, map_one]
      have hu : IsUnit (algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) s) :=
        (IsLocalization.AtPrime.isUnit_to_map_iff _ (hU.primeIdealOf ⟨x, hx⟩).asIdeal s).mpr s.2
      have him : algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) i ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk (⟨x, hx⟩ : U).1) :=
        (IsLocalization.AtPrime.to_map_mem_maximal_iff _ (hU.primeIdealOf ⟨x, hx⟩).asIdeal
          i).mpr hi
      refine ⟨b * y, ?_⟩
      show algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) (b * y) - τ' ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk (⟨x, hx⟩ : U).1)
      have key : algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) s *
          (algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) (b * y) - τ') =
          -(algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) b *
            algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) i) := by
        rw [map_mul]
        linear_combination (algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) b) * h2 - h1
      have e : algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) (b * y) - τ' =
          ↑(hu.unit⁻¹) * (algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) s *
            (algebraMap Γ(Y, U) (Y.presheaf.stalk (⟨x, hx⟩ : U).1) (b * y) - τ')) := by
        rw [← mul_assoc, IsUnit.val_inv_mul, one_mul]
      rw [e, key]
      exact Ideal.mul_mem_left _ _ (neg_mem (Ideal.mul_mem_left _ _ him))

    obtain ⟨r, hr⟩ := hlift (G hx * ↑(hfu.unit⁻¹))
    refine ⟨f * r, fun z hz hzO => ?_, fun hx' => ?_⟩
    · rw [map_mul]
      exact Ideal.mul_mem_right _ _ (hfv z hz hzO)
    · have e : (Y.presheaf.germ U x hx').hom (f * r) - G hx' =
          (Y.presheaf.germ U x hx).hom f *
            ((Y.presheaf.germ U x hx).hom r - G hx * ↑(hfu.unit⁻¹)) := by
        rw [map_mul, mul_sub]
        congr 1
        rw [mul_comm (G hx), ← mul_assoc, IsUnit.mul_val_inv, one_mul]
      rw [e]
      exact Ideal.mul_mem_left _ _ hr
  have hA : ∀ a, IsAffineOpen (L.V a ⊓ ⊤) := fun a => by rw [inf_top_eq]; exact hL.1 a
  choose w hw1 hw2 using fun a => core (L.V a ⊓ ⊤) (L.V a₀) (hA a) hx₀
    (fun hx => (Y.presheaf.germ (L.V a₀ ⊓ L.V a) x ⟨hx₀, hx.1⟩).hom
      ((L.g a₀ a : Γ(Y, L.V a₀ ⊓ L.V a)) ^ n))
  exact ⟨w, hw1, hw2⟩

theorem wcpa_dj_lcp_cta_cech_correct : ∀ (Y : Scheme.{u}) (L : wcpaDjCoc Y), wcpaDjCocOK L →
    ∀ (T : Set Y) (K : Y.Modules) (ι : K ⟶ wcStructMod Y),
    (∀ V : Y.Opens, Function.Injective (Scheme.Modules.Hom.app ι V)) →
    (∀ (V : Y.Opens) (f : Γ(Y, V)), (∃ k : Γ(K, V), Scheme.Modules.Hom.app ι V k = f) ↔
        ∀ (z : Y) (hz : z ∈ V), z ∈ T →
          (Y.presheaf.germ V z hz).hom f ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z)) →
    ∀ (n : ℕ), wcpaDjTwH1 L ⊤ K n →
    ∀ w : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ ⊤),
    (∀ (a b : Fin L.m) (z : Y) (hz : z ∈ L.V a ⊓ L.V b ⊓ ⊤), z ∈ T →
      (Y.presheaf.germ (L.V a ⊓ L.V b ⊓ ⊤) z hz).hom
        ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (w b) -
          (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b from
            inf_le_left)).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ n) *
          (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (w a)) ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk z)) →
    ∃ β : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ ⊤),
      (∀ (a : Fin L.m) (z : Y) (hz : z ∈ L.V a ⊓ ⊤), z ∈ T →
        (Y.presheaf.germ (L.V a ⊓ ⊤) z hz).hom (β a) ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk z)) ∧
      wcpaDjCompat L ⊤ n (fun a => w a - β a) :=
by
  intro Y L hL T K ι hinj hchar n hTw w hw

  have hres : ∀ (U V W : Y.Opens) (h1 : V ≤ U) (h2 : W ≤ V) (x : Γ(Y, U)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
        (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro U V W h1 h2 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl

  obtain ⟨ιf, hιf⟩ : ∃ f : ∀ V : Y.Opens, Γ(K, V) → Γ(Y, V),
      ∀ V k, f V k = Scheme.Modules.Hom.app ι V k :=
    ⟨fun V k => Scheme.Modules.Hom.app ι V k, fun _ _ => rfl⟩
  have hinj' : ∀ V, Function.Injective (ιf V) := by
    intro V x y hxy
    rw [hιf, hιf] at hxy
    exact hinj V hxy
  have hchar' : ∀ (V : Y.Opens) (f : Γ(Y, V)), (∃ k : Γ(K, V), ιf V k = f) ↔
      ∀ (z : Y) (hz : z ∈ V), z ∈ T →
        (Y.presheaf.germ V z hz).hom f ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk z) := by
    intro V f
    simp only [hιf]
    exact hchar V f
  have hadd : ∀ (V : Y.Opens) (x y : Γ(K, V)), ιf V (x + y) = ιf V x + ιf V y := by
    intro V x y
    rw [hιf, hιf, hιf]
    exact map_add _ x y
  have hsub : ∀ (V : Y.Opens) (x y : Γ(K, V)), ιf V (x - y) = ιf V x - ιf V y := by
    intro V x y
    rw [hιf, hιf, hιf]
    exact map_sub _ x y
  have hsmul : ∀ (V : Y.Opens) (r : Γ(Y, V)) (k : Γ(K, V)), ιf V (r • k) = r * ιf V k := by
    intro V r k
    rw [hιf, hιf]
    exact Scheme.Modules.Hom.app_smul ι r k
  have hnat : ∀ (U V : Y.Opens) (h : V ≤ U) (k : Γ(K, U)),
      ιf V ((K.presheaf.map (homOfLE h).op).hom k) =
        (Y.presheaf.map (homOfLE h).op).hom (ιf U k) := by
    intro U V h k
    rw [hιf, hιf]
    exact NatTrans.naturality_apply (Scheme.Modules.Hom.mapPresheaf ι) (homOfLE h).op k

  obtain ⟨c, hc⟩ : ∃ c : ∀ a b : Fin L.m, Γ(Y, L.V a ⊓ L.V b ⊓ ⊤), ∀ a b, c a b =
      (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (w b) -
        (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b from
          inf_le_left)).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ n) *
        (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (w a) :=
    ⟨fun a b => (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (w b) -
        (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b from
          inf_le_left)).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ n) *
        (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
          le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (w a),
      fun _ _ => rfl⟩
  have hvan : ∀ (a b : Fin L.m) (z : Y) (hz : z ∈ L.V a ⊓ L.V b ⊓ ⊤), z ∈ T →
      (Y.presheaf.germ (L.V a ⊓ L.V b ⊓ ⊤) z hz).hom (c a b) ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk z) := by
    intro a b z hz hzT
    rw [hc]
    exact hw a b z hz hzT

  have hlift : ∀ a b : Fin L.m, ∃ k : Γ(K, L.V a ⊓ L.V b ⊓ ⊤), ιf _ k = c a b :=
    fun a b => (hchar' _ _).mpr (hvan a b)
  choose c' hc' using hlift

  obtain ⟨β', hβ'⟩ := hTw c' (by
    intro a b d
    apply hinj'
    rw [hadd, hsmul, hnat, hnat, hnat, hc', hc', hc', hc, hc, hc]
    have hg := congrArg (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ L.V d ⊓ ⊤ ≤
      L.V a ⊓ L.V b ⊓ L.V d from inf_le_left)).op).hom (hL.2.2.2 a b d)
    simp only [map_mul, hres] at hg
    simp only [map_sub, map_mul, map_pow, hres]
    rw [← hg, mul_pow]
    ring)
  refine ⟨fun a => ιf _ (β' a), ?_, ?_⟩
  · intro a z hz hzT
    exact (hchar' _ _).mp ⟨β' a, rfl⟩ z hz hzT
  · intro a b
    have e := congrArg (ιf _) (hβ' a b)
    rw [hc', hsub, hsmul, hnat, hnat, hc] at e
    simp only [map_sub, map_pow] at e ⊢
    linear_combination e

theorem wcpa_dj_lcp_cta_assemble : ∀ (κ : Type u) [Field κ] (Y : Scheme.{u})
    (q : Y ⟶ Spec (.of κ)), IsProper q →
    ∀ L : wcpaDjCoc Y, wcpaDjCocOK L →
    (∀ x : Y, IsClosed ({x} : Set Y) → ∃ (n : ℕ) (a₀ : Fin L.m)
        (s : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)),
        0 < n ∧ wcpaDjCompat L (q ⁻¹ᵁ ⊤) n s ∧ x ∈ Y.basicOpen (s a₀) ∧
        (⨆ a, Y.basicOpen (s a)) = Y.basicOpen (s a₀)) →
    ∃ e : ℕ, 0 < e ∧ wcpaDjAmp q L ⊤ e :=
by
  intro κ _ Y q hq L hL H
  haveI := hq

  have s2 : ∀ (V : Y.Opens), IsAffineOpen V → ∀ (f : Γ(Y, V)) (O : Y.Opens),
      O = Y.basicOpen f → ∀ (hle : O ≤ q ⁻¹ᵁ ⊤), IsAffineOpen O ∧
        letI := ((Y.presheaf.map (homOfLE hle).op).hom.comp (q.app ⊤).hom).toAlgebra
        Algebra.FiniteType Γ(Spec (.of κ), ⊤) Γ(Y, O) := by
    intro V hV f O hO hle
    subst hO
    refine ⟨hV.basicOpen f, ?_⟩
    show RingHom.FiniteType _
    have hVle : V ≤ q ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
    have e : (Y.presheaf.map (homOfLE hle).op).hom.comp (q.app ⊤).hom =
        (Y.presheaf.map (homOfLE (Y.basicOpen_le f)).op).hom.comp
          (q.appLE ⊤ V hVle).hom := by
      rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp, Scheme.Hom.appLE_map]
      rfl
    rw [e]
    refine RingHom.FiniteType.comp ?_ ?_
    · have := hV.isLocalization_basicOpen f
      have : Algebra.FinitePresentation Γ(Y, V) Γ(Y, Y.basicOpen f) :=
        IsLocalization.Away.finitePresentation f
      exact Algebra.FiniteType.of_finitePresentation
    · exact HasRingHomProperty.appLE @LocallyOfFiniteType q inferInstance
        ⟨⊤, isAffineOpen_top _⟩ ⟨V, hV⟩ hVle

  have s3 : ∀ (n' k' : ℕ) (s' : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤)),
      wcpaDjCompat L (q ⁻¹ᵁ ⊤) n' s' →
      wcpaDjCompat L (q ⁻¹ᵁ ⊤) (n' * k') (fun a => s' a ^ k') := by
    intro n' k' s' hs a b
    have h := hs a b
    simp only [map_pow] at h ⊢
    rw [h, mul_pow, pow_mul]

  haveI : CompactSpace Y := QuasiCompact.compactSpace_of_compactSpace q
  choose n a₀ s hn hc hx hsup using H
  let O : {x : Y // IsClosed ({x} : Set Y)} → Set Y :=
    fun x => (Y.basicOpen (s x.1 x.2 (a₀ x.1 x.2)) : Set Y)
  have hOo : ∀ x, IsOpen (O x) := fun x => (Y.basicOpen _).isOpen
  have hcov0 : Set.univ ⊆ ⋃ x, O x := by
    by_contra hne
    have hC : IsClosed (⋃ x, O x)ᶜ := (isOpen_iUnion hOo).isClosed_compl
    have hCne : ((⋃ x, O x)ᶜ).Nonempty := by
      rw [Set.not_subset] at hne
      obtain ⟨z, -, hz⟩ := hne
      exact ⟨z, hz⟩
    obtain ⟨z, hzC, hzc⟩ := hC.exists_closed_singleton hCne
    exact hzC (Set.mem_iUnion.mpr ⟨⟨z, hzc⟩, hx z hzc⟩)
  obtain ⟨tf, htf⟩ := isCompact_univ.elim_finite_subcover O hOo hcov0
  let c : Fin tf.card → {x : Y // IsClosed ({x} : Set Y)} := fun i => (tf.equivFin.symm i).1
  have hcov : ∀ y : Y, ∃ i, y ∈ O (c i) := by
    intro y
    have h1 := htf (Set.mem_univ y)
    rw [Set.mem_iUnion₂] at h1
    obtain ⟨x, hxt, hy⟩ := h1
    refine ⟨tf.equivFin ⟨x, hxt⟩, ?_⟩
    simp only [c, Equiv.symm_apply_apply]
    exact hy

  let N : Fin tf.card → ℕ := fun i => n (c i).1 (c i).2
  let A : Fin tf.card → Fin L.m := fun i => a₀ (c i).1 (c i).2
  let S : Fin tf.card → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤) := fun i => s (c i).1 (c i).2
  have hNpos : ∀ i, 0 < N i := fun i => hn _ _
  let E := ∏ i, N i
  have hEpos : 0 < E := Finset.prod_pos fun i _ => hNpos i
  have hdvd : ∀ i, N i ∣ E := fun i => Finset.dvd_prod_of_mem N (Finset.mem_univ i)
  let k : Fin tf.card → ℕ := fun i => E / N i
  have hNk : ∀ i, N i * k i = E := fun i => Nat.mul_div_cancel' (hdvd i)
  have hk : ∀ i, 0 < k i := fun i => Nat.div_pos (Nat.le_of_dvd hEpos (hdvd i)) (hNpos i)

  let t : Fin (tf.card + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤) := fun J =>
    Fin.cases (motive := fun _ => ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ ⊤))
      (fun _ => 0) (fun i a => S i a ^ k i) J
  have ht0 : t 0 = fun _ => 0 := rfl
  have htS : ∀ i, t i.succ = fun a => S i a ^ k i := fun i => rfl
  have hcompat : ∀ J, wcpaDjCompat L (q ⁻¹ᵁ ⊤) E (t J) := by
    intro J
    refine Fin.cases ?_ (fun i => ?_) J
    · rw [ht0]
      intro a b
      simp only [map_zero, mul_zero]
    · rw [htS, ← hNk i]
      exact s3 _ _ _ (hc _ _)
  have hDS : ∀ i, (⨆ a, Y.basicOpen (t i.succ a)) = Y.basicOpen (S i (A i)) := by
    intro i
    rw [htS]
    simp only [Scheme.basicOpen_pow Y _ (hk i)]
    exact hsup _ _
  have hD : ∀ J, ∃ (V : Y.Opens) (_ : IsAffineOpen V) (f : Γ(Y, V)),
      (⨆ a, Y.basicOpen (t J a)) = Y.basicOpen f := by
    intro J
    refine Fin.cases ?_ (fun i => ?_) J
    · refine ⟨⊥, isAffineOpen_bot Y, 0, ?_⟩
      rw [ht0]
      simp only [Scheme.basicOpen_zero, iSup_bot]
    · refine ⟨L.V (A i) ⊓ q ⁻¹ᵁ ⊤, ?_, S i (A i), hDS i⟩
      show IsAffineOpen (L.V (A i) ⊓ ⊤)
      rw [inf_top_eq]
      exact hL.1 (A i)
  have hcov' : (⨆ J, ⨆ a, Y.basicOpen (t J a)) = q ⁻¹ᵁ ⊤ := by
    apply le_antisymm
    · exact iSup_le fun J => iSup_le fun a => (Y.basicOpen_le _).trans inf_le_right
    · intro y _
      obtain ⟨i, hi⟩ := hcov y
      rw [TopologicalSpace.Opens.mem_iSup]
      refine ⟨i.succ, ?_⟩
      rw [hDS i]
      exact hi
  refine ⟨E, hEpos, tf.card, t, hcompat, hcov', fun J => ?_, fun J => ?_⟩
  · obtain ⟨V, hV, f, heq⟩ := hD J
    exact (s2 V hV f _ heq
      (iSup_le (fun a => (Y.basicOpen_le (t J a)).trans inf_le_right))).1
  · obtain ⟨V, hV, f, heq⟩ := hD J
    exact (s2 V hV f _ heq
      (iSup_le (fun a => (Y.basicOpen_le (t J a)).trans inf_le_right))).2

theorem wcpa_dj_lcp_ra_coh_to_amp : ∀ (κ : Type u) [Field κ] (Y : Scheme.{u})
    (q : Y ⟶ Spec (.of κ)), IsProper q → ∀ L : wcpaDjCoc Y, wcpaDjCocOK L →
    (∀ F : Y.Modules, wcCoherentMod F → ∃ n₀ : ℕ, ∀ n ≥ n₀, wcpaDjTwH1 L ⊤ F n) →
    ∃ e : ℕ, 0 < e ∧ wcpaDjAmp q L ⊤ e :=
by
  intro κ _ Y q hq L hL H
  haveI := hq
  haveI : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian q

  have s6 : ∀ (a₀ : Fin L.m) (n : ℕ) (s : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ ⊤)),
      wcpaDjCompat L ⊤ n s →
      (∀ (a : Fin L.m) (z : Y) (hz : z ∈ L.V a ⊓ ⊤), z ∉ L.V a₀ →
        (Y.presheaf.germ (L.V a ⊓ ⊤) z hz).hom (s a) ∈
          IsLocalRing.maximalIdeal (Y.presheaf.stalk z)) →
      (⨆ a, Y.basicOpen (s a)) = Y.basicOpen (s a₀) := by
    intro a₀ n s hs hv
    apply le_antisymm
    · refine iSup_le fun a => ?_
      intro z hz
      have hzV : z ∈ L.V a ⊓ ⊤ := Y.basicOpen_le (s a) hz
      have hu : IsUnit ((Y.presheaf.germ (L.V a ⊓ ⊤) z hzV).hom (s a)) :=
        (Scheme.mem_basicOpen Y (s a) z hzV).mp hz
      by_cases hza : z ∈ L.V a₀
      · have hz3 : z ∈ L.V a₀ ⊓ L.V a ⊓ ⊤ := ⟨⟨hza, hzV.1⟩, trivial⟩
        have e := congrArg (Y.presheaf.germ (L.V a₀ ⊓ L.V a ⊓ ⊤) z hz3).hom (hs a₀ a)
        rw [map_mul, TopCat.Presheaf.germ_res_apply, TopCat.Presheaf.germ_res_apply,
          TopCat.Presheaf.germ_res_apply] at e
        rw [e] at hu
        have hu2 := isUnit_of_mul_isUnit_right hu
        exact (Scheme.mem_basicOpen Y (s a₀) z ⟨hza, trivial⟩).mpr hu2
      · exact absurd hu ((IsLocalRing.mem_maximalIdeal _).mp (hv a z hzV hza))
    · exact le_iSup (fun a => Y.basicOpen (s a)) a₀
  apply wcpa_dj_lcp_cta_assemble κ Y q hq L hL
  intro x hxc
  have hxmem : x ∈ (⨆ a, L.V a) := by rw [hL.2.1]; trivial
  obtain ⟨a₀, hx₀⟩ := TopologicalSpace.Opens.mem_iSup.mp hxmem
  obtain ⟨K, ι, hinj, hchar⟩ := wcpa_dj_lcp_cta_ideal_sheaf Y {z | z ∉ L.V a₀ ∨ z = x}
  have hcoh := wcpa_dj_lcp_cta_ideal_coherent Y {z | z ∉ L.V a₀ ∨ z = x} K ι hinj hchar
  obtain ⟨n₀, hn₀⟩ := H K hcoh
  have hnpos : 0 < max n₀ 1 := lt_of_lt_of_le Nat.one_pos (le_max_right _ _)
  have hTw := hn₀ (max n₀ 1) (le_max_left _ _)
  obtain ⟨w, hW1, hW2⟩ := wcpa_dj_lcp_cta_local_lift Y L hL x hxc a₀ hx₀ (max n₀ 1)
  have alg : ∀ {R : Type u} [CommRing R] (I : Ideal R) (A B Ga Gb gab : R),
      Ga * gab = Gb → B - Gb ^ (max n₀ 1) ∈ I → A - Ga ^ (max n₀ 1) ∈ I →
      B - gab ^ (max n₀ 1) * A ∈ I := by
    intro R _ I A B Ga Gb gab h hB hA
    have e : B - gab ^ (max n₀ 1) * A =
        (B - Gb ^ (max n₀ 1)) - gab ^ (max n₀ 1) * (A - Ga ^ (max n₀ 1)) := by
      rw [← h]; ring
    rw [e]
    exact I.sub_mem hB (I.mul_mem_left _ hA)

  have hcv : ∀ (a b : Fin L.m) (z : Y) (hz : z ∈ L.V a ⊓ L.V b ⊓ ⊤), (z ∉ L.V a₀ ∨ z = x) →
      (Y.presheaf.germ (L.V a ⊓ L.V b ⊓ ⊤) z hz).hom
        ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V b ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (w b) -
          (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ L.V b from
            inf_le_left)).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ (max n₀ 1)) *
          (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ ⊤ ≤ L.V a ⊓ ⊤ from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (w a)) ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk z) := by
    intro a b z hz hzT
    simp only [map_sub, map_mul, TopCat.Presheaf.germ_res_apply]
    rcases hzT with hza | hzx
    · exact Ideal.sub_mem _ (hW1 b z ⟨hz.1.2, trivial⟩ hza)
        (Ideal.mul_mem_left _ _ (hW1 a z ⟨hz.1.1, trivial⟩ hza))
    · subst hzx
      have hza : z ∈ L.V a := hz.1.1
      have hzb : z ∈ L.V b := hz.1.2
      have hz3 : z ∈ L.V a₀ ⊓ L.V a ⊓ L.V b := ⟨⟨hx₀, hza⟩, hzb⟩
      have h1 := hW2 a ⟨hza, trivial⟩
      have h2 := hW2 b ⟨hzb, trivial⟩
      have gr : ∀ (U V : Y.Opens) (i : V ⟶ U) (z : Y) (hz : z ∈ V) (f : Γ(Y, U)),
          (Y.presheaf.germ V z hz).hom ((Y.presheaf.map i.op).hom f) =
            (Y.presheaf.germ U z (i.le hz)).hom f :=
        fun U V i z hz f => TopCat.Presheaf.germ_res_apply Y.presheaf i z hz f
      have e := congrArg (Y.presheaf.germ (L.V a₀ ⊓ L.V a ⊓ L.V b) z hz3).hom
        (hL.2.2.2 a₀ a b)
      rw [map_mul, gr, gr, gr] at e
      simp only [map_pow] at h1 h2 ⊢
      exact alg _ _ _ _ _ _ e h2 h1
  obtain ⟨β, hβT, hcompat⟩ := wcpa_dj_lcp_cta_cech_correct Y L hL {z | z ∉ L.V a₀ ∨ z = x}
    K ι hinj hchar (max n₀ 1) hTw w (fun a b z hz hzT => hcv a b z hz hzT)
  have hvan : ∀ (a : Fin L.m) (z : Y) (hz : z ∈ L.V a ⊓ ⊤), z ∉ L.V a₀ →
      (Y.presheaf.germ (L.V a ⊓ ⊤) z hz).hom (w a - β a) ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk z) := by
    intro a z hz hza
    rw [map_sub]
    exact Ideal.sub_mem _ (hW1 a z hz hza) (hβT a z hz (Or.inl hza))
  have hbo := s6 a₀ (max n₀ 1) (fun a => w a - β a) hcompat hvan
  have hx' : x ∈ L.V a₀ ⊓ ⊤ := ⟨hx₀, trivial⟩
  have hxD : x ∈ Y.basicOpen (w a₀ - β a₀) := by
    rw [Scheme.mem_basicOpen Y _ x hx']
    by_contra hnu
    have h1 := hW2 a₀ hx'
    rw [hL.2.2.1 a₀, Units.val_one, one_pow, map_one] at h1
    have h2 := hβT a₀ x hx' (Or.inr rfl)
    have h3 : (Y.presheaf.germ (L.V a₀ ⊓ ⊤) x hx').hom (w a₀ - β a₀) ∈
        IsLocalRing.maximalIdeal (Y.presheaf.stalk x) :=
      (IsLocalRing.mem_maximalIdeal _).mpr hnu
    rw [map_sub] at h3
    have e : (1 : Y.presheaf.stalk x) =
        ((Y.presheaf.germ (L.V a₀ ⊓ ⊤) x hx').hom (w a₀) -
          (Y.presheaf.germ (L.V a₀ ⊓ ⊤) x hx').hom (β a₀)) -
        ((Y.presheaf.germ (L.V a₀ ⊓ ⊤) x hx').hom (w a₀) - 1) +
        (Y.presheaf.germ (L.V a₀ ⊓ ⊤) x hx').hom (β a₀) := by ring
    have h4 : (1 : Y.presheaf.stalk x) ∈ IsLocalRing.maximalIdeal (Y.presheaf.stalk x) := by
      rw [e]
      exact Ideal.add_mem _ (Ideal.sub_mem _ h3 h1) h2
    exact (IsLocalRing.mem_maximalIdeal _).mp h4 isUnit_one
  exact ⟨max n₀ 1, a₀, fun a => w a - β a, hnpos, hcompat, hxD, hbo⟩

theorem wcpa_dj_lcp_ra_good_family : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T), QuasiSeparated q →
    ∀ L : wcpaDjCoc Y, wcpaDjCocOK L → ∀ W : T.Opens, IsAffineOpen W →
    (∀ a, IsAffineOpen (L.V a ⊓ q ⁻¹ᵁ W)) → ∀ e : ℕ, 0 < e → wcpaDjAmp q L W e →
    ∃ (e' N : ℕ) (s : Fin (N + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W))
      (G : Finset (Fin (N + 1))), 0 < e' ∧ (∀ J, wcpaDjCompat L (q ⁻¹ᵁ W) e' (s J)) ∧
      (∀ a, Ideal.span (Set.range (fun J => s J a)) = ⊤) ∧
      (⨆ i ∈ G, ⨆ a, Y.basicOpen (s i a)) = q ⁻¹ᵁ W ∧
      ∀ i ∈ G, IsAffineOpen (⨆ a, Y.basicOpen (s i a)) ∧
        ∀ ρ : Fin (N + 1) → Γ(Y, ⨆ a, Y.basicOpen (s i a)), wcpaDjAvRatio q L W s i ρ →
          Function.Surjective (wcpaDjAvChart q L W s i ρ) :=
by
  intro Y T q hqs L hL W hW hA e he hamp
  classical
  haveI := hqs
  have resres : ∀ {A B C : Y.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(Y, A)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
        (Y.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro A B C h1 h2 x
    rw [← RingHom.comp_apply, ← CommRingCat.hom_comp, ← Functor.map_comp]
    rfl
  have bores : ∀ {A B : Y.Opens} (h : B ≤ A) (x : Γ(Y, A)),
      Y.basicOpen ((Y.presheaf.map (homOfLE h).op).hom x) = B ⊓ Y.basicOpen x :=
    fun h x => Y.basicOpen_res x _
  have alg : ∀ {R : Type u} [CommRing R] (G τ za zb : R) (n₀ k' r : ℕ),
      τ ^ k' * (zb - G ^ n₀ * za) = 0 →
      (G * τ) ^ (k' + r) * zb = G ^ (n₀ + (k' + r)) * (τ ^ (k' + r) * za) := by
    intro R _ G τ za zb n₀ k' r h
    linear_combination (G ^ (k' + r) * τ ^ r) * h

  have hqsW : IsQuasiSeparated ((q ⁻¹ᵁ W : Y.Opens) : Set Y) :=
    q.isQuasiSeparated_preimage hW.isQuasiSeparated
  have hcomp : ∀ a b, IsCompact ((L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W : Y.Opens) : Set Y) := by
    intro a b
    have := hqsW _ _ (fun x hx => hx.2) (L.V a ⊓ q ⁻¹ᵁ W).isOpen (hA a).isCompact
      (fun x hx => hx.2) (L.V b ⊓ q ⁻¹ᵁ W).isOpen (hA b).isCompact
    convert this using 1
    ext x
    simp only [TopologicalSpace.Opens.coe_inf, Set.mem_inter_iff]
    tauto

  have s2 : ∀ (E : ℕ) (t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W)), wcpaDjCompat L (q ⁻¹ᵁ W) E t →
      ∀ a b, Y.basicOpen (t b) ⊓ (L.V a ⊓ q ⁻¹ᵁ W) ≤ Y.basicOpen (t a) := by
    intro E t ht a b x hx
    have hxb' : x ∈ L.V b ⊓ q ⁻¹ᵁ W := Y.basicOpen_le _ hx.1
    have hP : x ∈ L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W := ⟨⟨hx.2.1, hxb'.1⟩, hx.2.2⟩
    have h1 : x ∈ Y.basicOpen ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤
        L.V b ⊓ q ⁻¹ᵁ W from le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (t b)) := by
      rw [bores]; exact ⟨hP, hx.1⟩
    rw [ht a b, Scheme.basicOpen_mul] at h1
    simp only [bores] at h1
    exact h1.2.2

  have s3 : ∀ (E : ℕ) (t : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W)), wcpaDjCompat L (q ⁻¹ᵁ W) E t →
      ∀ γ : Γ(Y, ⨆ a, Y.basicOpen (t a)), ∃ k₀ : ℕ, ∀ k, k₀ ≤ k →
      ∃ H : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W), wcpaDjCompat L (q ⁻¹ᵁ W) (E * k) H ∧
        ∀ a, (Y.presheaf.map (homOfLE (Y.basicOpen_le (t a))).op).hom (H a) =
          ((Y.presheaf.map (homOfLE (Y.basicOpen_le (t a))).op).hom (t a)) ^ k *
            (Y.presheaf.map (homOfLE (le_iSup (fun b => Y.basicOpen (t b)) a)).op).hom γ := by
    intro E t ht γ
    have hstep1 : ∀ a, ∃ (n : ℕ) (y : Γ(Y, L.V a ⊓ q ⁻¹ᵁ W)),
        (Y.presheaf.map (homOfLE (Y.basicOpen_le (t a))).op).hom y =
          ((Y.presheaf.map (homOfLE (Y.basicOpen_le (t a))).op).hom (t a)) ^ n *
            (Y.presheaf.map (homOfLE (le_iSup (fun b => Y.basicOpen (t b)) a)).op).hom γ :=
      fun a => exists_eq_pow_mul_of_isAffineOpen Y _ (hA a) _ _
    choose n y hy using hstep1
    obtain ⟨n₀, hn₀⟩ : ∃ n₀, n₀ = ∑ a, n a := ⟨_, rfl⟩
    have hn : ∀ a, n a ≤ n₀ := fun a => by
      rw [hn₀]; exact Finset.single_le_sum (fun i _ => Nat.zero_le (n i)) (Finset.mem_univ a)
    obtain ⟨z, hz⟩ : ∃ z : ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W),
        ∀ a, z a = t a ^ (n₀ - n a) * y a := ⟨_, fun _ => rfl⟩
    have h1 : ∀ a, (Y.presheaf.map (homOfLE (Y.basicOpen_le (t a))).op).hom (z a) =
        ((Y.presheaf.map (homOfLE (Y.basicOpen_le (t a))).op).hom (t a)) ^ n₀ *
          (Y.presheaf.map (homOfLE (le_iSup (fun b => Y.basicOpen (t b)) a)).op).hom γ := by
      intro a
      rw [hz, map_mul, map_pow, hy, ← mul_assoc, ← pow_add, Nat.sub_add_cancel (hn a)]
    have hz' : ∀ a (P : Y.Opens) (hP : P ≤ Y.basicOpen (t a)),
        (Y.presheaf.map (homOfLE (hP.trans (Y.basicOpen_le (t a)))).op).hom (z a) =
          ((Y.presheaf.map (homOfLE (hP.trans (Y.basicOpen_le (t a)))).op).hom (t a)) ^ n₀ *
            (Y.presheaf.map (homOfLE (hP.trans (le_iSup (fun b => Y.basicOpen (t b)) a))).op).hom γ := by
      intro a P hP
      have h := congrArg (Y.presheaf.map (homOfLE hP).op).hom (h1 a)
      rw [map_mul, map_pow] at h
      simp only [resres] at h
      exact h
    have hstep2 : ∀ a b, ∃ k : ℕ,
        ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V a ⊓ q ⁻¹ᵁ W from
            le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (t a)) ^ k *
          ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V b ⊓ q ⁻¹ᵁ W from
              le_inf (inf_le_left.trans inf_le_right) inf_le_right)).op).hom (z b) -
            ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V a ⊓ L.V b from
              inf_le_left)).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ E)) ^ n₀ *
            (Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V a ⊓ q ⁻¹ᵁ W from
              le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (z a)) = 0 := by
      intro a b
      apply exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isCompact Y (hcomp a b)
      have hQ := bores (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V a ⊓ q ⁻¹ᵁ W from
              le_inf (inf_le_left.trans inf_le_left) inf_le_right) (t a)
      have hQa : Y.basicOpen ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤
          L.V a ⊓ q ⁻¹ᵁ W from le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (t a))
          ≤ Y.basicOpen (t a) := by
        rw [hQ]; exact inf_le_right
      have hQP : Y.basicOpen ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤
          L.V a ⊓ q ⁻¹ᵁ W from le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (t a))
          ≤ L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W := Y.basicOpen_le _
      have hQb : Y.basicOpen ((Y.presheaf.map (homOfLE (show L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤
          L.V a ⊓ q ⁻¹ᵁ W from le_inf (inf_le_left.trans inf_le_left) inf_le_right)).op).hom (t a))
          ≤ Y.basicOpen (t b) := by
        intro x hx
        apply s2 E t ht b a
        exact ⟨hQa hx, (hQP hx).1.2, (hQP hx).2⟩
      show (Y.presheaf.map (homOfLE (Y.basicOpen_le _)).op).hom _ = 0
      simp only [map_sub, map_mul, map_pow, resres]
      rw [hz' b _ hQb, hz' a _ hQa]
      have hc' := congrArg (Y.presheaf.map (homOfLE hQP).op).hom (ht a b)
      simp only [map_mul, map_pow, resres] at hc'
      rw [hc']
      ring
    choose k' hk' using hstep2
    obtain ⟨S, hS⟩ : ∃ S, S = ∑ p : Fin L.m × Fin L.m, k' p.1 p.2 := ⟨_, rfl⟩
    have hkle : ∀ a b, k' a b ≤ S := fun a b => by
      rw [hS]
      exact Finset.single_le_sum (f := fun p : Fin L.m × Fin L.m => k' p.1 p.2)
        (fun i _ => Nat.zero_le _) (Finset.mem_univ (a, b))
    refine ⟨n₀ + S, fun k hk => ?_⟩
    obtain ⟨m, rfl⟩ := Nat.exists_eq_add_of_le (le_trans (Nat.le_add_right n₀ S) hk)
    have hmS : S ≤ m := by omega
    refine ⟨fun a => t a ^ m * z a, ?_, ?_⟩
    · intro a b
      have hk2 := hk' a b
      have hc := ht a b
      simp only [map_mul, map_pow] at hk2 hc ⊢
      obtain ⟨r, hr⟩ := Nat.exists_eq_add_of_le ((hkle a b).trans hmS)
      rw [hc, pow_mul, hr]
      exact alg _ _ _ _ n₀ (k' a b) r hk2
    · intro a
      simp only [map_mul, map_pow]
      rw [h1 a]
      ring

  have s4 : ∀ (E N : ℕ) (s : Fin (N + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W)),
      (∀ J, wcpaDjCompat L (q ⁻¹ᵁ W) E (s J)) → q ⁻¹ᵁ W ≤ (⨆ J, ⨆ a, Y.basicOpen (s J a)) →
      ∀ a, Ideal.span (Set.range (fun J => s J a)) = ⊤ := by
    intro E N s hs hcov a
    rw [← (hA a).iSup_basicOpen_eq_self_iff]
    apply le_antisymm
    · exact iSup_le fun f => Y.basicOpen_le _
    · intro x hx
      have hx' := hcov hx.2
      rw [TopologicalSpace.Opens.mem_iSup] at hx'
      obtain ⟨J, hJ⟩ := hx'
      rw [TopologicalSpace.Opens.mem_iSup] at hJ
      obtain ⟨b, hb⟩ := hJ
      have hxa : x ∈ Y.basicOpen (s J a) := s2 E (s J) (hs J) a b ⟨hb, hx⟩
      rw [TopologicalSpace.Opens.mem_iSup]
      exact ⟨⟨s J a, J, rfl⟩, hxa⟩

  have s5 : ∀ {N : ℕ} (s : Fin (N + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W)) (i : Fin (N + 1))
      (D : Y.Opens) (hDW : D ≤ q ⁻¹ᵁ W) (h1 : D ≤ ⨆ a, Y.basicOpen (s i a))
      (h2 : (⨆ a, Y.basicOpen (s i a)) ≤ D) (n : ℕ) (κ : Fin n → Fin (N + 1))
      (γ : Fin n → Γ(Y, D)),
      (∀ x : Γ(Y, D), ∃ P : MvPolynomial (Fin n) Γ(T, W),
        x = MvPolynomial.eval₂ (q.appLE W D hDW).hom γ P) →
      (∀ a j, (Y.presheaf.map (homOfLE ((le_iSup (fun a' => Y.basicOpen (s i a')) a).trans
          h2)).op).hom (γ j) *
          (Y.presheaf.map (homOfLE (Y.basicOpen_le (s i a))).op).hom (s i a) =
          (Y.presheaf.map (homOfLE (Y.basicOpen_le (s i a))).op).hom (s (κ j) a)) →
      ∀ ρ : Fin (N + 1) → Γ(Y, ⨆ a, Y.basicOpen (s i a)), wcpaDjAvRatio q L W s i ρ →
        Function.Surjective (wcpaDjAvChart q L W s i ρ) := by
    intro N s i D hDW h1 h2 n κ γ hgen hrat ρ hρ y
    have ha : ∀ j, ρ (κ j) = (Y.presheaf.map (homOfLE h2).op).hom (γ j) := by
      intro j
      apply TopCat.Sheaf.eq_of_locally_eq' Y.sheaf (fun a => Y.basicOpen (s i a)) _
        (fun a => homOfLE (le_iSup (fun a' => Y.basicOpen (s i a')) a)) le_rfl
      intro a
      show (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (s i a')) a)).op).hom (ρ (κ j)) =
        (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (s i a')) a)).op).hom
          ((Y.presheaf.map (homOfLE h2).op).hom (γ j))
      rw [resres]
      have hunit : IsUnit ((Y.presheaf.map (homOfLE (Y.basicOpen_le (s i a))).op).hom (s i a)) :=
        Y.toRingedSpace.isUnit_res_basicOpen (s i a)
      exact hunit.mul_right_cancel ((hρ a (κ j)).trans (hrat a j).symm)
    have hcoef : ∀ r, (Y.presheaf.map (homOfLE h2).op).hom ((q.appLE W D hDW).hom r) =
        (Y.presheaf.map (homOfLE (iSup_le fun a => (Y.basicOpen_le (s i a)).trans inf_le_right :
          (⨆ a, Y.basicOpen (s i a)) ≤ q ⁻¹ᵁ W)).op).hom ((q.app W).hom r) := by
      intro r
      simp only [Scheme.Hom.appLE, CommRingCat.hom_comp, RingHom.comp_apply, resres]
    obtain ⟨P, hP⟩ := hgen ((Y.presheaf.map (homOfLE h1).op).hom y)
    have hy : y = (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom y) := by
      rw [resres]
      simp only [homOfLE_refl, op_id, CategoryTheory.Functor.map_id, CommRingCat.hom_id,
        RingHom.id_apply]
    refine ⟨MvPolynomial.rename κ P, ?_⟩
    rw [hy, hP, MvPolynomial.eval₂_comp_left]
    simp only [wcpaDjAvChart, MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_rename]
    congr 1
    · ext r
      simp only [RingHom.comp_apply]
      exact (hcoef r).symm
    · funext j
      simp only [Function.comp_apply]
      exact ha j

  obtain ⟨M, t, ht, hcv, haff, hft⟩ := hamp
  have hDle : ∀ J, (⨆ a, Y.basicOpen (t J a)) ≤ q ⁻¹ᵁ W :=
    fun J => iSup_le fun a => (Y.basicOpen_le _).trans inf_le_right

  have hgen : ∀ J, ∃ (n : ℕ) (γ : Fin n → Γ(Y, ⨆ a, Y.basicOpen (t J a))), ∀ x,
      ∃ P : MvPolynomial (Fin n) Γ(T, W), x = MvPolynomial.eval₂ (q.appLE W _ (hDle J)).hom γ P := by
    intro J
    letI := (q.appLE W _ (hDle J)).hom.toAlgebra
    have h0 : Algebra.FiniteType Γ(T, W) Γ(Y, ⨆ a, Y.basicOpen (t J a)) := hft J
    obtain ⟨n, F, hF⟩ := Algebra.FiniteType.iff_quotient_mvPolynomial''.mp h0
    refine ⟨n, fun j => F (MvPolynomial.X j), fun x => ?_⟩
    obtain ⟨P, rfl⟩ := hF x
    refine ⟨P, ?_⟩
    conv_lhs => rw [MvPolynomial.aeval_unique F]
    rw [MvPolynomial.aeval_def]
    rfl
  choose n γ hγ using hgen

  choose k₀ hk₀ using fun Jj : (Σ J : Fin (M + 1), Fin (n J)) =>
    s3 e (t Jj.1) (ht Jj.1) (γ Jj.1 Jj.2)
  obtain ⟨k, hk⟩ : ∃ k, k = ∑ Jj : (Σ J : Fin (M + 1), Fin (n J)), k₀ Jj + 1 := ⟨_, rfl⟩
  have hkpos : 0 < k := by rw [hk]; exact Nat.succ_pos _
  have hkle : ∀ Jj, k₀ Jj ≤ k := fun Jj => by
    rw [hk]
    exact (Finset.single_le_sum (fun i _ => Nat.zero_le (k₀ i)) (Finset.mem_univ Jj)).trans
      (Nat.le_succ _)
  choose H hHc hHr using fun Jj : (Σ J : Fin (M + 1), Fin (n J)) => hk₀ Jj k (hkle Jj)
  have hcN : ∀ J, wcpaDjCompat L (q ⁻¹ᵁ W) (e * k) (fun a => t J a ^ k) := by
    intro J a b
    have h := congrArg (· ^ k) (ht J a b)
    simp only [map_pow, mul_pow] at h ⊢
    rw [h, ← pow_mul]

  obtain ⟨σ, hσN, hσS⟩ : ∃ σ : (Σ J : Fin (M + 1), Option (Fin (n J))) →
      ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W),
      (∀ J, σ ⟨J, none⟩ = fun a => t J a ^ k) ∧ (∀ J j, σ ⟨J, some j⟩ = H ⟨J, j⟩) :=
    ⟨fun x => x.2.elim (fun a => t x.1 a ^ k) (fun j => H ⟨x.1, j⟩), fun J => rfl,
      fun J j => rfl⟩
  have hIpos : 0 < Fintype.card (Σ J : Fin (M + 1), Option (Fin (n J))) :=
    Fintype.card_pos_iff.mpr ⟨⟨0, none⟩⟩
  obtain ⟨N, ⟨ε⟩⟩ : ∃ N : ℕ, Nonempty ((Σ J : Fin (M + 1), Option (Fin (n J))) ≃ Fin (N + 1)) :=
    ⟨Fintype.card (Σ J : Fin (M + 1), Option (Fin (n J))) - 1,
      ⟨(Fintype.equivFin _).trans (finCongr (by omega))⟩⟩
  obtain ⟨s, hs⟩ : ∃ s : Fin (N + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W),
      ∀ l, s l = σ (ε.symm l) := ⟨_, fun _ => rfl⟩
  have hsN : ∀ J a, s (ε ⟨J, none⟩) a = t J a ^ k := by
    intro J a
    rw [hs, Equiv.symm_apply_apply, hσN]
  have hsS : ∀ J j a, s (ε ⟨J, some j⟩) a = H ⟨J, j⟩ a := by
    intro J j a
    rw [hs, Equiv.symm_apply_apply, hσS]
  have hcompat : ∀ l, wcpaDjCompat L (q ⁻¹ᵁ W) (e * k) (s l) := by
    intro l
    rw [hs l]
    generalize ε.symm l = x
    obtain ⟨J, _ | j⟩ := x
    · rw [hσN]; exact hcN J
    · rw [hσS]; exact hHc ⟨J, j⟩
  have hDN : ∀ J, (⨆ a, Y.basicOpen (s (ε ⟨J, none⟩) a)) = ⨆ a, Y.basicOpen (t J a) := by
    intro J
    refine iSup_congr fun a => ?_
    rw [hsN]
    exact Y.basicOpen_pow _ hkpos
  let G : Finset (Fin (N + 1)) := Finset.univ.image (fun J => ε ⟨J, none⟩)
  have hG3 : (⨆ i ∈ G, ⨆ a, Y.basicOpen (s i a)) = q ⁻¹ᵁ W := by
    apply le_antisymm
    · exact iSup₂_le fun i _ => iSup_le fun a => (Y.basicOpen_le _).trans inf_le_right
    · refine hcv.ge.trans (iSup_le fun J => ?_)
      refine (hDN J).ge.trans ?_
      exact le_iSup₂ (f := fun i (_ : i ∈ G) => ⨆ a, Y.basicOpen (s i a)) (ε ⟨J, none⟩)
        (Finset.mem_image_of_mem _ (Finset.mem_univ J))
  have hspan : ∀ a, Ideal.span (Set.range (fun J => s J a)) = ⊤ :=
    s4 (e * k) N s hcompat
      (hG3.ge.trans (iSup₂_le fun i _ => le_iSup (fun l => ⨆ a, Y.basicOpen (s l a)) i))
  refine ⟨e * k, N, s, G, Nat.mul_pos he hkpos, hcompat, hspan, hG3, ?_⟩
  intro i hi
  obtain ⟨J, -, rfl⟩ := Finset.mem_image.mp hi
  refine ⟨by rw [hDN J]; exact haff J, ?_⟩
  intro ρ hρ
  refine s5 s (ε ⟨J, none⟩) (⨆ a, Y.basicOpen (t J a)) (hDle J) (hDN J).ge (hDN J).le (n J)
    (fun j => ε ⟨J, some j⟩) (γ J) (hγ J) ?_ ρ hρ
  intro a j
  have hle : Y.basicOpen (s (ε ⟨J, none⟩) a) ≤ Y.basicOpen (t J a) := by
    rw [hsN]
    exact (Y.basicOpen_pow _ hkpos).le
  have e1 := congrArg (Y.presheaf.map (homOfLE hle).op).hom (hHr ⟨J, j⟩ a)
  rw [map_mul, map_pow] at e1
  simp only [resres] at e1
  rw [congrArg (Y.presheaf.map (homOfLE (Y.basicOpen_le (s (ε ⟨J, none⟩) a))).op).hom (hsN J a),
    congrArg (Y.presheaf.map (homOfLE (Y.basicOpen_le (s (ε ⟨J, none⟩) a))).op).hom (hsS J j a),
    map_pow, e1]
  exact mul_comm _ _

theorem wcpa_dj_lcp_ra_ratio_section : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T) (L : wcpaDjCoc Y),
    wcpaDjCocOK L → ∀ (W : T.Opens) {N : ℕ} (E : ℕ)
    (s : Fin (N + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W)),
    (∀ J, wcpaDjCompat L (q ⁻¹ᵁ W) E (s J)) → ∀ J,
    ∃ ρ : Fin (N + 1) → Γ(Y, ⨆ a, Y.basicOpen (s J a)), wcpaDjAvRatio q L W s J ρ :=
by
  intro Y T q L _ W N E s hs J
  classical
  have res : ∀ {A B C : Y.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (h3 : C ≤ A) (x : Γ(Y, A)),
      (Y.presheaf.map (homOfLE h2).op).hom ((Y.presheaf.map (homOfLE h1).op).hom x) =
        (Y.presheaf.map (homOfLE h3).op).hom x := by
    intro A B C h1 h2 h3 x
    rw [← CommRingCat.comp_apply, ← Functor.map_comp]
    rfl
  have hu : ∀ a, IsUnit ((Y.presheaf.map (homOfLE (Y.basicOpen_le (s J a))).op).hom (s J a)) :=
    fun a => Y.toRingedSpace.isUnit_res_basicOpen (s J a)
  obtain ⟨r, hr⟩ : ∃ r : Fin (N + 1) → ∀ a : Fin L.m, Γ(Y, Y.basicOpen (s J a)),
      ∀ l a, r l a * (Y.presheaf.map (homOfLE (Y.basicOpen_le (s J a))).op).hom (s J a) =
        (Y.presheaf.map (homOfLE (Y.basicOpen_le (s J a))).op).hom (s l a) := by
    refine ⟨fun l a => (Y.presheaf.map (homOfLE (Y.basicOpen_le (s J a))).op).hom (s l a) *
      ((hu a).unit⁻¹ : (Γ(Y, Y.basicOpen (s J a)))ˣ), ?_⟩
    intro l a
    rw [mul_assoc, IsUnit.val_inv_mul, mul_one]
  have compat : ∀ l, TopCat.Presheaf.IsCompatible Y.sheaf.obj
      (fun a => Y.basicOpen (s J a)) (r l) := by
    intro l a b
    have ra : Y.basicOpen (s J a) ≤ L.V a ⊓ q ⁻¹ᵁ W := Y.basicOpen_le (s J a)
    have rb : Y.basicOpen (s J b) ≤ L.V b ⊓ q ⁻¹ᵁ W := Y.basicOpen_le (s J b)
    have hPb : L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V b ⊓ q ⁻¹ᵁ W :=
      le_inf (inf_le_left.trans inf_le_right) inf_le_right
    have hPa : L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V a ⊓ q ⁻¹ᵁ W :=
      le_inf (inf_le_left.trans inf_le_left) inf_le_right
    have hPab : L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W ≤ L.V a ⊓ L.V b := inf_le_left
    have hQP : Y.basicOpen (s J a) ⊓ Y.basicOpen (s J b) ≤ L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W :=
      fun x hx => ⟨⟨(ra hx.1).1, (rb hx.2).1⟩, (ra hx.1).2⟩
    have hQa : Y.basicOpen (s J a) ⊓ Y.basicOpen (s J b) ≤ Y.basicOpen (s J a) := inf_le_left
    have hQb : Y.basicOpen (s J a) ⊓ Y.basicOpen (s J b) ≤ Y.basicOpen (s J b) := inf_le_right
    have hC : ∀ l', (Y.presheaf.map (homOfLE hPb).op).hom (s l' b) =
        (Y.presheaf.map (homOfLE hPab).op).hom ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ E) *
        (Y.presheaf.map (homOfLE hPa).op).hom (s l' a) := fun l' => hs l' a b
    have key : ∀ l', (Y.presheaf.map (homOfLE (hQb.trans rb)).op).hom (s l' b) =
        (Y.presheaf.map (homOfLE hQP).op).hom ((Y.presheaf.map (homOfLE hPab).op).hom
          ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ E)) *
        (Y.presheaf.map (homOfLE hQa).op).hom ((Y.presheaf.map (homOfLE ra).op).hom (s l' a)) := by
      intro l'
      rw [← res hPb hQP (hQb.trans rb), hC l', map_mul, res hPa hQP (hQa.trans ra),
        res ra hQa (hQa.trans ra)]
    have hσ : IsUnit ((Y.presheaf.map (homOfLE (hQb.trans rb)).op).hom (s J b)) := by
      rw [← res rb hQb (hQb.trans rb)]
      exact (hu b).map _
    show (Y.presheaf.map (homOfLE hQa).op).hom (r l a) =
      (Y.presheaf.map (homOfLE hQb).op).hom (r l b)
    rw [← hσ.mul_left_inj]
    calc _ = (Y.presheaf.map (homOfLE hQP).op).hom ((Y.presheaf.map (homOfLE hPab).op).hom
          ((L.g a b : Γ(Y, L.V a ⊓ L.V b)) ^ E)) *
        (Y.presheaf.map (homOfLE hQa).op).hom
          (r l a * (Y.presheaf.map (homOfLE ra).op).hom (s J a)) := by
          rw [key J, map_mul (Y.presheaf.map (homOfLE hQa).op).hom]
          ring
      _ = (Y.presheaf.map (homOfLE (hQb.trans rb)).op).hom (s l b) := by
          rw [hr l a, key l]
      _ = _ := by
          rw [← res rb hQb (hQb.trans rb) (s l b), ← res rb hQb (hQb.trans rb) (s J b),
            ← map_mul (Y.presheaf.map (homOfLE hQb).op).hom, hr l b]
  have glue : ∀ l, ∃ ρl : Γ(Y, ⨆ a, Y.basicOpen (s J a)), ∀ a,
      (Y.presheaf.map (homOfLE (le_iSup (fun a' => Y.basicOpen (s J a')) a)).op).hom ρl =
        r l a := by
    intro l
    obtain ⟨ρl, hρl, -⟩ := TopCat.Sheaf.existsUnique_gluing' Y.sheaf
      (fun a => Y.basicOpen (s J a)) (⨆ a, Y.basicOpen (s J a))
      (fun a => homOfLE (le_iSup (fun a' => Y.basicOpen (s J a')) a)) le_rfl (r l) (compat l)
    exact ⟨ρl, hρl⟩
  choose ρ hρ using glue
  refine ⟨ρ, fun a l => ?_⟩
  rw [hρ l a, hr l a]

theorem wcpa_dj_lcp_ra_bad_chart : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T) (L : wcpaDjCoc Y),
    wcpaDjCocOK L → ∀ (W : T.Opens) {N : ℕ} (E : ℕ)
    (s : Fin (N + 1) → ∀ a : Fin L.m, Γ(Y, L.V a ⊓ q ⁻¹ᵁ W)),
    (∀ J, wcpaDjCompat L (q ⁻¹ᵁ W) E (s J)) →
    ∀ ρ : ∀ J, Fin (N + 1) → Γ(Y, ⨆ a, Y.basicOpen (s J a)),
    (∀ J, wcpaDjAvRatio q L W s J (ρ J)) → ∀ G : Finset (Fin (N + 1)),
    (∀ i ∈ G, IsAffineOpen (⨆ a, Y.basicOpen (s i a)) ∧
      Function.Surjective (wcpaDjAvChart q L W s i (ρ i))) →
    ∀ h, Ideal.span (MvPolynomial.X '' (G : Set (Fin (N + 1))) :
        Set (MvPolynomial (Fin (N + 1)) Γ(T, W))) ⊔
      RingHom.ker (wcpaDjAvChart q L W s h (ρ h)) = ⊤ →
    IsAffineOpen (⨆ a, Y.basicOpen (s h a)) ∧
      Function.Surjective (wcpaDjAvChart q L W s h (ρ h)) :=
by
  intro Y T q L _ W N E s _ ρ hρ G hG h hspan
  classical

  have hA : ∀ (J : Fin (N + 1)) (a : Fin L.m) (l : Fin (N + 1)) (x : Y)
      (hx : x ∈ Y.basicOpen (s J a)) (hxD : x ∈ ⨆ a', Y.basicOpen (s J a'))
      (hxV : x ∈ L.V a ⊓ q ⁻¹ᵁ W),
      (Y.presheaf.germ _ x hxD).hom (ρ J l) * (Y.presheaf.germ _ x hxV).hom (s J a) =
        (Y.presheaf.germ _ x hxV).hom (s l a) := by
    intro J a l x hx hxD hxV
    have e := congrArg (Y.presheaf.germ (Y.basicOpen (s J a)) x hx).hom (hρ J a l)
    simpa only [map_mul, TopCat.Presheaf.germ_res_apply] using e

  have hB : ∀ (J K : Fin (N + 1)) (x : Y), x ∈ Y.basicOpen (ρ J K) ↔
      ∃ a, x ∈ Y.basicOpen (s J a) ∧ x ∈ Y.basicOpen (s K a) := by
    intro J K x
    constructor
    · intro hx
      have hxD : x ∈ ⨆ a', Y.basicOpen (s J a') := Y.basicOpen_le _ hx
      obtain ⟨a, hxa⟩ := TopologicalSpace.Opens.mem_iSup.mp hxD
      have hxV : x ∈ L.V a ⊓ q ⁻¹ᵁ W := Y.basicOpen_le _ hxa
      refine ⟨a, hxa, ?_⟩
      rw [Y.mem_basicOpen _ x hxV, ← hA J a K x hxa hxD hxV]
      exact ((Y.mem_basicOpen _ x hxD).mp hx).mul ((Y.mem_basicOpen _ x hxV).mp hxa)
    · rintro ⟨a, hJa, hKa⟩
      have hxD : x ∈ ⨆ a', Y.basicOpen (s J a') :=
        TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hJa⟩
      have hxV : x ∈ L.V a ⊓ q ⁻¹ᵁ W := Y.basicOpen_le _ hJa
      rw [Y.mem_basicOpen _ x hxD]
      have hu := (Y.mem_basicOpen _ x hxV).mp hKa
      rw [← hA J a K x hJa hxD hxV] at hu
      exact isUnit_of_mul_isUnit_left hu

  have hC : ∀ (J K : Fin (N + 1)) (x : Y) (a : Fin L.m), x ∈ Y.basicOpen (s J a) →
      x ∈ Y.basicOpen (s K a) →
      ∀ (hxJ : x ∈ ⨆ a', Y.basicOpen (s J a')) (hxK : x ∈ ⨆ a', Y.basicOpen (s K a')),
      (∀ l, (Y.presheaf.germ _ x hxJ).hom (ρ J K) * (Y.presheaf.germ _ x hxK).hom (ρ K l) =
        (Y.presheaf.germ _ x hxJ).hom (ρ J l)) ∧
      (Y.presheaf.germ _ x hxJ).hom (ρ J K) * (Y.presheaf.germ _ x hxK).hom (ρ K J) = 1 := by
    intro J K x a hJa hKa hxJ hxK
    have hxV : x ∈ L.V a ⊓ q ⁻¹ᵁ W := Y.basicOpen_le _ hJa
    have hu := (Y.mem_basicOpen _ x hxV).mp hJa
    have eJ := fun l => hA J a l x hJa hxJ hxV
    have eK := fun l => hA K a l x hKa hxK hxV
    constructor
    · intro l
      apply hu.mul_left_inj.mp
      linear_combination (Y.presheaf.germ _ x hxK).hom (ρ K l) * eJ K + eK l - eJ l
    · apply hu.mul_left_inj.mp
      linear_combination (Y.presheaf.germ _ x hxK).hom (ρ K J) * eJ K + eK J

  have hGψ : ∀ (J : Fin (N + 1)) (x : Y) (hxD : x ∈ ⨆ a', Y.basicOpen (s J a'))
      (hxO : x ∈ q ⁻¹ᵁ W) (P : MvPolynomial (Fin (N + 1)) Γ(T, W)),
      (Y.presheaf.germ _ x hxD).hom (wcpaDjAvChart q L W s J (ρ J) P) =
        MvPolynomial.eval₂ ((Y.presheaf.germ _ x hxO).hom.comp (q.app W).hom)
          (fun l => (Y.presheaf.germ _ x hxD).hom (ρ J l)) P := by
    intro J x hxD hxO P
    simp only [wcpaDjAvChart, MvPolynomial.coe_eval₂Hom]
    rw [MvPolynomial.eval₂_comp_left]
    congr 1
    refine RingHom.ext fun r => ?_
    simp only [RingHom.comp_apply, TopCat.Presheaf.germ_res_apply]

  have hH : ∀ (i : Fin (N + 1)) (P : MvPolynomial (Fin (N + 1)) Γ(T, W)), ∃ d₀ : ℕ, ∀ d, d₀ ≤ d →
      ∃ Q : MvPolynomial (Fin (N + 1)) Γ(T, W), ∀ (z : Y) (φ : Γ(T, W) →+* Y.presheaf.stalk z)
        (x y : Fin (N + 1) → Y.presheaf.stalk z), (∀ l, x l = x i * y l) →
        MvPolynomial.eval₂ φ x Q = x i ^ d * MvPolynomial.eval₂ φ y P := by
    intro i P
    induction P using MvPolynomial.induction_on with
    | C c =>
      refine ⟨0, fun d _ => ⟨MvPolynomial.C c * MvPolynomial.X i ^ d, fun z φ x y _ => ?_⟩⟩
      simp only [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_C, MvPolynomial.eval₂_pow,
        MvPolynomial.eval₂_X]
      ring
    | add p r hp hr =>
      obtain ⟨dp, hp⟩ := hp
      obtain ⟨dr, hr⟩ := hr
      refine ⟨max dp dr, fun d hd => ?_⟩
      obtain ⟨Qp, hQp⟩ := hp d (le_trans (le_max_left _ _) hd)
      obtain ⟨Qr, hQr⟩ := hr d (le_trans (le_max_right _ _) hd)
      refine ⟨Qp + Qr, fun z φ x y hxy => ?_⟩
      rw [MvPolynomial.eval₂_add, MvPolynomial.eval₂_add, hQp z φ x y hxy, hQr z φ x y hxy,
        mul_add]
    | mul_X p n hp =>
      obtain ⟨dp, hp⟩ := hp
      refine ⟨dp + 1, fun d hd => ?_⟩
      obtain ⟨d', rfl⟩ : ∃ d', d = d' + 1 := ⟨d - 1, by omega⟩
      obtain ⟨Q, hQ⟩ := hp d' (by omega)
      refine ⟨Q * MvPolynomial.X n, fun z φ x y hxy => ?_⟩
      simp only [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X]
      rw [hQ z φ x y hxy, hxy n]
      ring
  have hX : ∀ J l, wcpaDjAvChart q L W s J (ρ J) (MvPolynomial.X l) = ρ J l := by
    intro J l
    simp only [wcpaDjAvChart, MvPolynomial.eval₂Hom_X']
  have hsym : ∀ J K, Y.basicOpen (ρ J K) = Y.basicOpen (ρ K J) := by
    intro J K
    apply le_antisymm <;> intro x hx
    · obtain ⟨a, h1, h2⟩ := (hB J K x).mp hx
      exact (hB K J x).mpr ⟨a, h2, h1⟩
    · obtain ⟨a, h1, h2⟩ := (hB K J x).mp hx
      exact (hB J K x).mpr ⟨a, h2, h1⟩
  have hext : ∀ (U : Y.Opens) (a b : Γ(Y, U)),
      (∀ x (hx : x ∈ U), (Y.presheaf.germ U x hx).hom a = (Y.presheaf.germ U x hx).hom b) →
        a = b :=
    fun U a b hab => TopCat.Presheaf.section_ext Y.sheaf U a b hab

  have hJ0 : Ideal.span (ρ h '' (G : Set (Fin (N + 1)))) = ⊤ := by
    have hle : Ideal.span (MvPolynomial.X '' (G : Set (Fin (N + 1))) :
        Set (MvPolynomial (Fin (N + 1)) Γ(T, W))) ⊔
        RingHom.ker (wcpaDjAvChart q L W s h (ρ h)) ≤
        Ideal.comap (wcpaDjAvChart q L W s h (ρ h)) (Ideal.span (ρ h '' (G : Set (Fin (N + 1))))) := by
      refine sup_le ?_ ?_
      · rw [Ideal.span_le]
        rintro _ ⟨i, hi, rfl⟩
        rw [SetLike.mem_coe, Ideal.mem_comap, hX]
        exact Ideal.subset_span ⟨i, hi, rfl⟩
      · intro b hb
        rw [Ideal.mem_comap, RingHom.mem_ker.mp hb]
        exact zero_mem _
    have h1 : (1 : MvPolynomial (Fin (N + 1)) Γ(T, W)) ∈
        Ideal.comap (wcpaDjAvChart q L W s h (ρ h)) (Ideal.span (ρ h '' (G : Set (Fin (N + 1))))) :=
      hle (hspan ▸ Submodule.mem_top)
    rw [Ideal.mem_comap, map_one] at h1
    exact (Ideal.eq_top_iff_one _).mpr h1

  have hDh_aff : IsAffineOpen (⨆ a, Y.basicOpen (s h a)) := by
    refine isAffineOpen_of_isAffineOpen_basicOpen _ _ hJ0 ?_
    rintro _ ⟨i, hi, rfl⟩
    rw [hsym]
    exact (hG i hi).1.basicOpen _

  have hs4 : ∀ i ∈ G, ∀ f : Γ(Y, ⨆ a, Y.basicOpen (s h a)), ∃ (m : ℕ)
      (Q : MvPolynomial (Fin (N + 1)) Γ(T, W)),
      wcpaDjAvChart q L W s h (ρ h) Q = ρ h i ^ m * f := by
    intro i hi f
    have hle' : Y.basicOpen (ρ i h) ≤ ⨆ a, Y.basicOpen (s h a) := by
      intro x hx
      obtain ⟨a, _, h2⟩ := (hB i h x).mp hx
      exact TopologicalSpace.Opens.mem_iSup.mpr ⟨a, h2⟩
    obtain ⟨n, y, hy⟩ := exists_eq_pow_mul_of_isAffineOpen Y _ (hG i hi).1 (ρ i h)
      ((Y.presheaf.map (homOfLE hle').op).hom f)
    obtain ⟨P, hP⟩ := (hG i hi).2 y
    obtain ⟨d₀, hd₀⟩ := hH i P
    obtain ⟨Q, hQ⟩ := hd₀ (d₀ + n) (by omega)
    obtain ⟨δ, hδ⟩ : ∃ δ, δ = wcpaDjAvChart q L W s h (ρ h) Q - ρ h i ^ d₀ * f := ⟨_, rfl⟩
    have hres : (Y.presheaf.map (homOfLE (Y.basicOpen_le (ρ h i))).op).hom δ = 0 := by
      apply hext
      intro x hx
      simp only [TopCat.Presheaf.germ_res_apply, map_zero, hδ, map_sub, map_mul, map_pow]
      obtain ⟨a, hha, hia⟩ := (hB h i x).mp hx
      have hxh : x ∈ ⨆ a', Y.basicOpen (s h a') := TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hha⟩
      have hxi : x ∈ ⨆ a', Y.basicOpen (s i a') := TopologicalSpace.Opens.mem_iSup.mpr ⟨a, hia⟩
      have hxO : x ∈ q ⁻¹ᵁ W := (Y.basicOpen_le _ hha).2
      have hx' : x ∈ Y.basicOpen (ρ i h) := (hB i h x).mpr ⟨a, hia, hha⟩
      obtain ⟨c1, c2⟩ := hC h i x a hha hia hxh hxi
      have e1 := hGψ h x hxh hxO Q
      have e2 := hGψ i x hxi hxO P
      rw [hP] at e2
      have e3 := hQ x ((Y.presheaf.germ _ x hxO).hom.comp (q.app W).hom)
        (fun l => (Y.presheaf.germ _ x hxh).hom (ρ h l))
        (fun l => (Y.presheaf.germ _ x hxi).hom (ρ i l)) (fun l => (c1 l).symm)
      have e4 := congrArg (Y.presheaf.germ _ x hx').hom hy
      simp only [map_mul, map_pow, TopCat.Presheaf.restrictOpen, TopCat.Presheaf.restrict,
        TopCat.Presheaf.germ_res_apply] at e4
      rw [e1, e3, ← e2, e4]
      have key : ∀ (α β F : Y.presheaf.stalk x), α * β = 1 →
          α ^ (d₀ + n) * (β ^ n * F) - α ^ d₀ * F = 0 := by
        intro α β F hαβ
        rw [show α ^ (d₀ + n) * (β ^ n * F) = α ^ d₀ * (α * β) ^ n * F by ring, hαβ, one_pow]
        ring
      exact key _ _ _ c2
    obtain ⟨n', hn'⟩ := exists_pow_mul_eq_zero_of_res_basicOpen_eq_zero_of_isCompact Y
      hDh_aff.isCompact δ (ρ h i) hres
    refine ⟨n' + d₀, MvPolynomial.X i ^ n' * Q, ?_⟩
    rw [map_mul, map_pow, hX]
    rw [hδ] at hn'
    linear_combination hn'

  refine ⟨hDh_aff, fun f => ?_⟩
  let 𝔞 : Ideal (MvPolynomial (Fin (N + 1)) Γ(T, W)) :=
    { carrier := {b | ∃ P, wcpaDjAvChart q L W s h (ρ h) P = wcpaDjAvChart q L W s h (ρ h) b * f}
      add_mem' := by
        intro b c hb hc
        obtain ⟨P, hP⟩ := hb
        obtain ⟨P', hP'⟩ := hc
        exact ⟨P + P', by rw [map_add, map_add, hP, hP', add_mul]⟩
      zero_mem' := ⟨0, by simp⟩
      smul_mem' := by
        intro c b hb
        obtain ⟨P, hP⟩ := hb
        exact ⟨c * P, by rw [smul_eq_mul, map_mul, map_mul, hP, mul_assoc]⟩ }
  have hmem : ∀ b, (∃ P, wcpaDjAvChart q L W s h (ρ h) P =
      wcpaDjAvChart q L W s h (ρ h) b * f) → b ∈ 𝔞 := fun b hb => hb
  have hmem' : ∀ b, b ∈ 𝔞 → (∃ P, wcpaDjAvChart q L W s h (ρ h) P =
      wcpaDjAvChart q L W s h (ρ h) b * f) := fun b hb => hb
  have hker : RingHom.ker (wcpaDjAvChart q L W s h (ρ h)) ≤ 𝔞 := fun b hb =>
    hmem b ⟨0, by rw [map_zero, RingHom.mem_ker.mp hb, zero_mul]⟩
  have hrad : 𝔞.radical = ⊤ := by
    rw [eq_top_iff, ← hspan]
    refine sup_le ?_ (hker.trans Ideal.le_radical)
    rw [Ideal.span_le]
    rintro _ ⟨i, hi, rfl⟩
    obtain ⟨m, Q, hQ⟩ := hs4 i hi f
    exact ⟨m, hmem _ ⟨Q, by rw [map_pow, hX, hQ]⟩⟩
  obtain ⟨P, hP⟩ := hmem' 1 (by rw [Ideal.radical_eq_top.mp hrad]; exact Submodule.mem_top)
  exact ⟨P, by rw [hP, map_one, one_mul]⟩

theorem wcpa_dj_lcp_ra_center_prime : ∀ {Y : Scheme.{u}} (D : Y.Opens) (n : ℕ)
    (Da : Fin n → Y.Opens), (∀ a, IsAffineOpen (Da a)) → (∀ a, Da a ≤ D) → (⨆ a, Da a) = D →
    ∀ {B : Type u} [CommRing B] (ψ : B →+* Γ(Y, D)) (p : Ideal B), p.IsPrime →
    RingHom.ker ψ ≤ p →
    ∃ (ξ : Y) (hξ : ξ ∈ D) (V : ValuationSubring (Y.residueField ξ)), ∀ b : B,
      ∃ v : V, (v : Y.residueField ξ) = (Y.presheaf.germ D ξ hξ ≫ Y.residue ξ).hom (ψ b) ∧
        (b ∈ p → ¬ IsUnit v) :=
by
  intro Y D n Da hA hle hcov B _ ψ p hp hker

  have s1 : ∀ {K : Type u} [Field K] (φ : B →+* K), RingHom.ker φ ≤ p →
      ∃ V : ValuationSubring K, ∀ b : B, ∃ v : V, (v : K) = φ b ∧ (b ∈ p → ¬ IsUnit v) := by
    intro K _ φ hkerφ
    have hsurj : Function.Surjective φ.rangeRestrict := RingHom.rangeRestrict_surjective φ
    haveI hP' : (Ideal.map φ.rangeRestrict p).IsPrime :=
      Ideal.map_isPrime_of_surjective hsurj (by rw [RingHom.ker_rangeRestrict]; exact hkerφ)
    obtain ⟨V, hV⟩ := LocalSubring.exists_le_valuationSubring
      (LocalSubring.ofPrime φ.range (Ideal.map φ.rangeRestrict p))
    obtain ⟨h, hloc⟩ := (LocalSubring.le_def).mp hV
    refine ⟨V, fun b => ⟨⟨φ b, h (LocalSubring.le_ofPrime φ.range _ (φ.mem_range_self b))⟩,
      rfl, ?_⟩⟩
    intro hb hu
    set a₀ := algebraMap φ.range
      (LocalSubring.ofPrime φ.range (Ideal.map φ.rangeRestrict p)).toSubring
      (φ.rangeRestrict b) with ha₀
    have e : Subring.inclusion h a₀ =
        ⟨φ b, h (LocalSubring.le_ofPrime φ.range _ (φ.mem_range_self b))⟩ := by
      apply Subtype.ext
      rfl
    have hu' : IsUnit a₀ := by
      apply isUnit_of_map_unit (Subring.inclusion h)
      rw [e]
      exact hu
    rw [ha₀, IsLocalization.AtPrime.isUnit_to_map_iff _ (Ideal.map φ.rangeRestrict p)] at hu'
    exact hu' (Ideal.mem_map_of_mem _ hb)

  set ψa : ∀ a : Fin n, (B →+* Γ(Y, Da a)) :=
    fun a => (Y.presheaf.map (homOfLE (hle a)).op).hom.comp ψ with hψa
  have hinf : (⨅ a, RingHom.ker (ψa a)) ≤ RingHom.ker ψ := by
    intro b hb
    rw [Submodule.mem_iInf] at hb
    rw [RingHom.mem_ker]
    apply TopCat.Sheaf.eq_of_locally_eq' Y.sheaf Da D (fun a => homOfLE (hle a)) hcov.ge
    intro a
    have h1 := hb a
    rw [RingHom.mem_ker] at h1
    exact h1.trans (map_zero _).symm
  have hprod : (∏ a ∈ (Finset.univ : Finset (Fin n)), RingHom.ker (ψa a)) ≤ p := by
    refine le_trans Ideal.prod_le_inf (le_trans ?_ (hinf.trans hker))
    rw [Finset.inf_univ_eq_iInf]
  obtain ⟨a, -, ha⟩ := (Ideal.IsPrime.prod_le hp).mp hprod

  obtain ⟨p₀, hp₀min, hp₀le⟩ := Ideal.exists_minimalPrimes_le ha
  rw [RingHom.ker_eq_comap_bot] at hp₀min
  obtain ⟨P, hP, -, hPp₀⟩ := Ideal.exists_comap_eq_of_mem_minimalPrimes (ψa a) p₀ hp₀min
  obtain ⟨y, hy⟩ : ∃ y : PrimeSpectrum Γ(Y, Da a), y.asIdeal = P := ⟨⟨P, hP⟩, rfl⟩
  have hξa : (hA a).fromSpec y ∈ Da a := by
    have h1 := Set.mem_range_self (f := (hA a).fromSpec) y
    rw [(hA a).range_fromSpec] at h1
    exact h1
  have hloc := (hA a).isLocalization_stalk' y hξa
  have hkerA : ∀ c : Γ(Y, Da a),
      (Y.presheaf.germ (Da a) ((hA a).fromSpec y) hξa ≫ Y.residue ((hA a).fromSpec y)).hom c = 0
        → c ∈ P := by
    intro c hc
    have hc' : IsLocalRing.residue (Y.presheaf.stalk ((hA a).fromSpec y))
        ((Y.presheaf.germ (Da a) ((hA a).fromSpec y) hξa).hom c) = 0 := hc
    rw [IsLocalRing.residue_eq_zero_iff] at hc'
    rw [← hy]
    exact (@IsLocalization.AtPrime.to_map_mem_maximal_iff Γ(Y, Da a) _
      (Y.presheaf.stalk ((hA a).fromSpec y)) _
      (TopCat.Presheaf.algebra_section_stalk Y.presheaf ⟨(hA a).fromSpec y, hξa⟩) y.asIdeal _
      hloc c).mp hc'
  have hξD : (hA a).fromSpec y ∈ D := hle a hξa
  have hcompat : ∀ b, (Y.presheaf.germ (Da a) ((hA a).fromSpec y) hξa ≫
      Y.residue ((hA a).fromSpec y)).hom ((Y.presheaf.map (homOfLE (hle a)).op).hom (ψ b)) =
      (Y.presheaf.germ D ((hA a).fromSpec y) hξD ≫ Y.residue ((hA a).fromSpec y)).hom (ψ b) := by
    intro b
    rw [← CommRingCat.comp_apply, ← Category.assoc, TopCat.Presheaf.germ_res]
  obtain ⟨V, hV⟩ := s1 ((Y.presheaf.germ D ((hA a).fromSpec y) hξD ≫
      Y.residue ((hA a).fromSpec y)).hom.comp ψ) (by
    intro b hb
    rw [RingHom.mem_ker, RingHom.comp_apply, ← hcompat] at hb
    have h2 : b ∈ Ideal.comap (ψa a) P := Ideal.mem_comap.mpr (hkerA _ hb)
    rw [hPp₀] at h2
    exact hp₀le h2)
  exact ⟨(hA a).fromSpec y, hξD, V, hV⟩

theorem wcpa_dj_lcp_ra_amp_to_va : ∀ {Y T : Scheme.{u}} (q : Y ⟶ T), IsProper q →
    ∀ L : wcpaDjCoc Y, wcpaDjCocOK L → ∀ W : T.Opens, IsAffineOpen W →
    (∀ a, IsAffineOpen (L.V a ⊓ q ⁻¹ᵁ W)) → ∀ e : ℕ, 0 < e → wcpaDjAmp q L W e →
    ∃ e' : ℕ, 0 < e' ∧ wcpaDjVA q L W e' :=
by
  intro Y T q hq L hL W hW hA e he hamp
  haveI := hq
  obtain ⟨e', N, s, G, he', hcomp, hspan, hcov, hgood⟩ :=
    wcpa_dj_lcp_ra_good_family q inferInstance L hL W hW hA e he hamp
  choose ρ hρ using fun J => wcpa_dj_lcp_ra_ratio_section q L hL W e' s hcomp J
  have gr : ∀ (ξ : Y) (O1 O2 : Y.Opens) (hle : O1 ≤ O2) (h1 : ξ ∈ O1) (x : Γ(Y, O2)),
      (Y.presheaf.germ O1 ξ h1 ≫ Y.residue ξ).hom ((Y.presheaf.map (homOfLE hle).op).hom x) =
        (Y.presheaf.germ O2 ξ (hle h1) ≫ Y.residue ξ).hom x := by
    intro ξ O1 O2 hle h1 x
    rw [← CommRingCat.comp_apply, ← Category.assoc, TopCat.Presheaf.germ_res]
  have gg : ∀ (ξ : Y) (O1 O2 : Y.Opens) (hle : O1 ≤ O2) (h1 : ξ ∈ O1) (x : Γ(Y, O2)),
      (Y.presheaf.germ O1 ξ h1).hom ((Y.presheaf.map (homOfLE hle).op).hom x) =
        (Y.presheaf.germ O2 ξ (hle h1)).hom x := by
    intro ξ O1 O2 hle h1 x
    rw [← CommRingCat.comp_apply, TopCat.Presheaf.germ_res]

  have hall : ∀ h, IsAffineOpen (⨆ a, Y.basicOpen (s h a)) ∧
      Function.Surjective (wcpaDjAvChart q L W s h (ρ h)) := by
    intro h
    refine wcpa_dj_lcp_ra_bad_chart q L hL W e' s hcomp ρ hρ G
      (fun i hi => ⟨(hgood i hi).1, (hgood i hi).2 (ρ i) (hρ i)⟩) h ?_
    by_contra hne
    obtain ⟨p, hpmax, hIp⟩ := Ideal.exists_le_maximal _ hne
    obtain ⟨ξ, hξ, V, hV⟩ := wcpa_dj_lcp_ra_center_prime (⨆ a, Y.basicOpen (s h a)) L.m
      (fun a => Y.basicOpen (s h a)) (fun a => (hA a).basicOpen (s h a))
      (fun a => le_iSup (fun a' => Y.basicOpen (s h a')) a) rfl
      (wcpaDjAvChart q L W s h (ρ h)) p hpmax.isPrime (le_sup_right.trans hIp)
    have hDU : (⨆ a, Y.basicOpen (s h a)) ≤ q ⁻¹ᵁ W :=
      iSup_le fun a => (Y.basicOpen_le (s h a)).trans inf_le_right
    have hξU : ξ ∈ q ⁻¹ᵁ W := hDU hξ
    have hR : ∀ r : Γ(T, W),
        (q.app W ≫ Y.presheaf.germ (q ⁻¹ᵁ W) ξ hξU ≫ Y.residue ξ).hom r ∈ V := by
      intro r
      obtain ⟨v, hv, -⟩ := hV (MvPolynomial.C r)
      have e1 : (wcpaDjAvChart q L W s h (ρ h)) (MvPolynomial.C r) =
          (Y.presheaf.map (homOfLE hDU).op).hom ((q.app W).hom r) := by
        simp only [wcpaDjAvChart, MvPolynomial.eval₂Hom_C, RingHom.comp_apply]
      rw [e1, gr] at hv
      rw [CommRingCat.comp_apply, ← hv]
      exact v.2
    obtain ⟨y, hyU, hy⟩ := wcpa_dj_lcp_ra_valuative_center q inferInstance W hW ξ hξU V hR
    rw [← hcov] at hyU
    obtain ⟨i, hyi⟩ := TopologicalSpace.Opens.mem_iSup.mp hyU
    obtain ⟨hiG, hyi⟩ := TopologicalSpace.Opens.mem_iSup.mp hyi
    obtain ⟨a, hya⟩ := TopologicalSpace.Opens.mem_iSup.mp hyi
    obtain ⟨hξa, w, hw, hwu⟩ := hy (L.V a ⊓ q ⁻¹ᵁ W) (Y.basicOpen_le _ hya) (s i a)
    obtain ⟨hξa', v, hv, -⟩ := hy (L.V a ⊓ q ⁻¹ᵁ W) (Y.basicOpen_le _ hya) (s h a)
    have hwunit : IsUnit w := hwu hya
    have hξha : ξ ∈ Y.basicOpen (s h a) := by
      obtain ⟨b, hb⟩ := TopologicalSpace.Opens.mem_iSup.mp hξ
      have hξb : ξ ∈ L.V b ⊓ q ⁻¹ᵁ W := Y.basicOpen_le _ hb
      have hξab : ξ ∈ L.V a ⊓ L.V b ⊓ q ⁻¹ᵁ W := ⟨⟨hξa.1, hξb.1⟩, hξU⟩
      rw [Scheme.mem_basicOpen _ _ _ hξb] at hb
      rw [Scheme.mem_basicOpen _ _ _ hξa]
      have hc := congrArg (fun z => (Y.presheaf.germ _ ξ hξab).hom z) (hcomp h a b)
      simp only [map_mul, gg] at hc
      rw [hc] at hb
      exact isUnit_of_mul_isUnit_right hb
    obtain ⟨vi, hvi, hvinu⟩ := hV (MvPolynomial.X i)
    have hXi : (MvPolynomial.X i : MvPolynomial (Fin (N + 1)) Γ(T, W)) ∈ p :=
      hIp (Ideal.mem_sup_left (Ideal.subset_span ⟨i, hiG, rfl⟩))
    have hrel : vi * v = w := by
      apply Subtype.ext
      have e2 : (wcpaDjAvChart q L W s h (ρ h)) (MvPolynomial.X i) = ρ h i := by
        simp only [wcpaDjAvChart, MvPolynomial.eval₂Hom_X']
      have hr := congrArg (fun z => (Y.presheaf.germ _ ξ hξha ≫ Y.residue ξ).hom z) (hρ h a i)
      simp only [map_mul, gr] at hr
      have e3 : ((vi * v : V) : Y.residueField ξ) = (vi : Y.residueField ξ) * v := rfl
      rw [e3, hvi, hv, hw, e2]
      exact hr
    exact hvinu hXi (isUnit_of_mul_isUnit_left (by rw [hrel]; exact hwunit))
  refine ⟨e', he', N, s, fun J a b => hcomp J a b, hspan, fun J => (hall J).1, ?_⟩
  intro J f
  obtain ⟨P, hP⟩ := (hall J).2 f
  refine ⟨P, fun a => ?_⟩
  have hunit : IsUnit ((Y.presheaf.map (homOfLE (Y.basicOpen_le (s J a))).op).hom (s J a)) :=
    Y.toRingedSpace.isUnit_res_basicOpen (s J a)
  obtain ⟨u, hu⟩ := hunit
  refine ⟨↑u⁻¹, ?_, ?_⟩
  · rw [← hu]; exact u.inv_mul
  · rw [← hP]
    simp only [wcpaDjAvChart, MvPolynomial.coe_eval₂Hom]
    rw [MvPolynomial.eval₂_comp_left]
    congr 1
    · refine RingHom.ext fun r => ?_
      simp only [RingHom.comp_apply]
      rw [← CommRingCat.comp_apply, ← Functor.map_comp]
      rfl
    · funext l
      simp only [Function.comp_apply]
      rw [← hρ J a l, ← hu, mul_assoc, u.mul_inv, mul_one]

theorem wcpa_dj_lcp_ra_fc_affine_bc_sections : ∀ (κ K : Type u) [Field κ] [Field K] [Algebra κ K] (X X' : Scheme.{u}) (q : X ⟶ Spec (.of κ)) (π : X' ⟶ X) (q' : X' ⟶ Spec (.of K)), IsPullback π q' q (Spec.map (CommRingCat.ofHom (algebraMap κ K))) → ∀ (O : X.Opens), IsAffineOpen O → letI := (wcCnSigma q O).toAlgebra; ∃ Θ : TensorProduct κ Γ(X, O) K ≃+* Γ(X', π ⁻¹ᵁ O), ∀ (a : Γ(X, O)) (t : K), Θ (a ⊗ₜ[κ] t) = (π.app O).hom a * wcCnSigma q' (π ⁻¹ᵁ O) t :=
by
  intro κ K _ _ _ X X' q π q' hpb O hO
  letI := (wcCnSigma q O).toAlgebra
  have hOle : O ≤ q ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
  have hW : (⊤ : (Spec (.of K)).Opens) ≤
      Spec.map (CommRingCat.ofHom (algebraMap κ K)) ⁻¹ᵁ ⊤ := by
    rw [Scheme.Hom.preimage_top]
  have heq : π ⁻¹ᵁ O = π ⁻¹ᵁ O ⊓ q' ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top, inf_top_eq]

  have hPB := Scheme.Hom.isPullback_resLE hpb hW hOle heq
  haveI : IsAffine (⊤ : (Spec (.of κ)).Opens) := isAffineOpen_top _
  haveI : IsAffine (⊤ : (Spec (.of K)).Opens) := isAffineOpen_top _
  haveI : IsAffine O := hO
  have hPO := isPushout_appTop_of_isPullback hPB
  have s1 : ∀ {X Y : Scheme.{u}} (f : X ⟶ Y) (U : Y.Opens) (V : X.Opens) (e : V ≤ f ⁻¹ᵁ U),
      (f.resLE U V e).appTop ≫ V.topIso.hom = U.topIso.hom ≫ f.appLE U V e := by
    intro X Y f U V e
    simp only [Scheme.Hom.appTop, Scheme.Hom.app_eq_appLE, Scheme.Opens.topIso_hom]
    erw [Scheme.Hom.resLE_appLE, Scheme.Hom.appLE_map, Scheme.Hom.map_appLE]
  have hPO2 := IsPushout.of_iso hPO (⊤ : (Spec (.of κ)).Opens).topIso O.topIso
    (⊤ : (Spec (.of K)).Opens).topIso (π ⁻¹ᵁ O).topIso (s1 _ _ _ _) (s1 _ _ _ _)
    (s1 _ _ _ _) (s1 _ _ _ _)

  have eσ : CommRingCat.ofHom (wcCnSigma q O) =
      (Scheme.ΓSpecIso (.of κ)).inv ≫ q.appLE ⊤ O hOle := by
    apply CommRingCat.hom_ext
    rfl
  have h2 : π ⁻¹ᵁ O ≤ q' ⁻¹ᵁ ⊤ := by rw [Scheme.Hom.preimage_top]; exact le_top
  have eσ' : CommRingCat.ofHom (wcCnSigma q' (π ⁻¹ᵁ O)) =
      (Scheme.ΓSpecIso (.of K)).inv ≫ q'.appLE ⊤ (π ⁻¹ᵁ O) h2 := by
    apply CommRingCat.hom_ext
    rfl
  have hσ : IsPushout (CommRingCat.ofHom (algebraMap κ Γ(X, O)))
      (CommRingCat.ofHom (algebraMap κ K)) (CommRingCat.ofHom (π.app O).hom)
      (CommRingCat.ofHom (wcCnSigma q' (π ⁻¹ᵁ O))) := by
    refine IsPushout.of_iso hPO2 (Scheme.ΓSpecIso (.of κ)) (Iso.refl _)
      (Scheme.ΓSpecIso (.of K)) (Iso.refl _) ?_ ?_ ?_ ?_
    · show _ = _ ≫ CommRingCat.ofHom (wcCnSigma q O)
      rw [eσ, Iso.hom_inv_id_assoc, Iso.refl_hom, Category.comp_id]
    · show Scheme.Hom.appLE _ ⊤ (Spec.map (CommRingCat.ofHom (algebraMap κ K)) ⁻¹ᵁ ⊤) le_rfl ≫ _
        = _
      rw [Scheme.Hom.appLE_eq_app]
      exact Scheme.ΓSpecIso_naturality _
    · rw [CommRingCat.ofHom_hom, Iso.refl_hom, Iso.refl_hom, Category.comp_id, Category.id_comp]
      exact Scheme.Hom.appLE_eq_app _
    · rw [eσ', Iso.hom_inv_id_assoc, Iso.refl_hom, Category.comp_id]

  have hT := CommRingCat.isPushout_tensorProduct κ Γ(X, O) K
  let e := IsPushout.isoIsPushout _ _ hT hσ
  have hl := IsPushout.inl_isoIsPushout_hom _ _ hT hσ
  have hr := IsPushout.inr_isoIsPushout_hom _ _ hT hσ
  refine ⟨e.commRingCatIsoToRingEquiv, fun a t => ?_⟩
  have ha : e.hom.hom (a ⊗ₜ[κ] (1 : K)) = (π.app O).hom a := by
    have := congrArg (fun φ => φ.hom a) hl
    exact this
  have ht : e.hom.hom ((1 : Γ(X, O)) ⊗ₜ[κ] t) = wcCnSigma q' (π ⁻¹ᵁ O) t := by
    have := congrArg (fun φ => φ.hom t) hr
    exact this
  have hsplit : a ⊗ₜ[κ] t = (a ⊗ₜ[κ] (1 : K)) * ((1 : Γ(X, O)) ⊗ₜ[κ] t) := by
    rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
  rw [hsplit, map_mul]
  show e.hom.hom _ * e.hom.hom _ = _
  rw [ha, ht]

theorem wcpa_dj_lcp_ra_fc_struct_retraction : ∀ (κ K : Type u) [Field κ] [Field K] [Algebra κ K] (X X' : Scheme.{u}) (q : X ⟶ Spec (.of κ)) (π : X' ⟶ X) (q' : X' ⟶ Spec (.of K)), (∀ (O : X.Opens), IsAffineOpen O → letI := (wcCnSigma q O).toAlgebra; ∃ Θ : TensorProduct κ Γ(X, O) K ≃+* Γ(X', π ⁻¹ᵁ O), ∀ (a : Γ(X, O)) (t : K), Θ (a ⊗ₜ[κ] t) = (π.app O).hom a * wcCnSigma q' (π ⁻¹ᵁ O) t) → ∃ Λ₀ : ∀ O : X.Opens, IsAffineOpen O → (Γ(X', π ⁻¹ᵁ O) →+ Γ(X, O)), (∀ (O : X.Opens) (hO : IsAffineOpen O) (r : Γ(X, O)) (a : Γ(X', π ⁻¹ᵁ O)), Λ₀ O hO ((π.app O).hom r * a) = r * Λ₀ O hO a) ∧ (∀ (O : X.Opens) (hO : IsAffineOpen O), Λ₀ O hO 1 = 1) ∧ (∀ (O O' : X.Opens) (hO : IsAffineOpen O) (hO' : IsAffineOpen O') (h : O' ≤ O) (a : Γ(X', π ⁻¹ᵁ O)), Λ₀ O' hO' ((X'.presheaf.map (homOfLE (π.preimage_mono h)).op).hom a) = (X.presheaf.map (homOfLE h).op).hom (Λ₀ O hO a)) :=
by
  intro κ K _ _ _ X X' q π q' hΘ
  classical

  obtain ⟨ℓ, hℓ⟩ : ∃ ℓ : K →ₗ[κ] κ, ℓ 1 = 1 := by
    have hker : LinearMap.ker (Algebra.linearMap κ K) = ⊥ :=
      LinearMap.ker_eq_bot.mpr (algebraMap κ K).injective
    obtain ⟨g, hg⟩ := LinearMap.exists_leftInverse_of_injective _ hker
    refine ⟨g, ?_⟩
    have h1 := LinearMap.congr_fun hg 1
    simpa using h1

  have s2 : ∀ (A B : Type u) [CommRing A] [iA : Algebra κ A] [CommRing B] (β : A →+* B)
      (σ : K →+* B) (Θ : TensorProduct κ A K ≃+* B),
      (∀ (a : A) (t : K), Θ (a ⊗ₜ[κ] t) = β a * σ t) →
      (∀ (r : A) (z : B), TensorProduct.rid κ A (LinearMap.lTensor A ℓ (Θ.symm (β r * z))) =
        r * TensorProduct.rid κ A (LinearMap.lTensor A ℓ (Θ.symm z))) ∧
      TensorProduct.rid κ A (LinearMap.lTensor A ℓ (Θ.symm 1)) = 1 := by
    intro A B _ _ _ β σ Θ hΘ
    have ha : ∀ r : A, Θ.symm (β r) = r ⊗ₜ[κ] (1 : K) := by
      intro r
      apply Θ.injective
      rw [RingEquiv.apply_symm_apply, hΘ, map_one, mul_one]
    refine ⟨fun r z => ?_, ?_⟩
    · rw [map_mul, ha]
      generalize Θ.symm z = w
      induction w using TensorProduct.induction_on with
      | zero => simp
      | tmul a t =>
        rw [Algebra.TensorProduct.tmul_mul_tmul, one_mul, LinearMap.lTensor_tmul,
          LinearMap.lTensor_tmul, TensorProduct.rid_tmul, TensorProduct.rid_tmul]
        exact (mul_smul_comm (ℓ t) r a).symm
      | add x y hx hy => simp only [mul_add, map_add, hx, hy]
    · rw [map_one, Algebra.TensorProduct.one_def, LinearMap.lTensor_tmul, TensorProduct.rid_tmul,
        hℓ, one_smul]

  have s3 : ∀ (A B A' B' : Type u) [CommRing A] [iA : Algebra κ A] [CommRing B] [CommRing A']
      [iA' : Algebra κ A'] [CommRing B'] (β : A →+* B) (σ : K →+* B)
      (Θ : TensorProduct κ A K ≃+* B) (β' : A' →+* B') (σ' : K →+* B')
      (Θ' : TensorProduct κ A' K ≃+* B') (ρ : A →+* A') (ρ' : B →+* B'),
      (∀ (a : A) (t : K), Θ (a ⊗ₜ[κ] t) = β a * σ t) →
      (∀ (a : A') (t : K), Θ' (a ⊗ₜ[κ] t) = β' a * σ' t) →
      (∀ c : κ, ρ (algebraMap κ A c) = algebraMap κ A' c) →
      (∀ a : A, ρ' (β a) = β' (ρ a)) → (∀ t : K, ρ' (σ t) = σ' t) →
      ∀ z : B, TensorProduct.rid κ A' (LinearMap.lTensor A' ℓ (Θ'.symm (ρ' z))) =
        ρ (TensorProduct.rid κ A (LinearMap.lTensor A ℓ (Θ.symm z))) := by
    intro A B A' B' _ _ _ _ _ _ β σ Θ β' σ' Θ' ρ ρ' hΘ hΘ' hc hβ hσ z
    obtain ⟨w, rfl⟩ := Θ.surjective z
    rw [Θ.symm_apply_apply]
    induction w using TensorProduct.induction_on with
    | zero => simp
    | tmul a t =>
      have e : ρ' (Θ (a ⊗ₜ[κ] t)) = Θ' (ρ a ⊗ₜ[κ] t) := by
        rw [hΘ, hΘ', map_mul, hβ, hσ]
      rw [e, Θ'.symm_apply_apply, LinearMap.lTensor_tmul, LinearMap.lTensor_tmul,
        TensorProduct.rid_tmul, TensorProduct.rid_tmul, Algebra.smul_def, Algebra.smul_def,
        map_mul, hc]
    | add x y hx hy => simp only [map_add, hx, hy]

  have s4 : ∀ {B : Type u} [CommRing B] {Z : Scheme.{u}} (h : Z ⟶ Spec (.of B))
      (U U' : Z.Opens) (hle : U' ≤ U) (b : B),
      (Z.presheaf.map (homOfLE hle).op).hom (wcCnSigma h U b) = wcCnSigma h U' b := by
    intro B _ Z h U U' hle b
    have e : Z.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op ≫ Z.presheaf.map (homOfLE hle).op =
        Z.presheaf.map (homOfLE (le_top : U' ≤ ⊤)).op := by
      rw [← Functor.map_comp]; rfl
    have e2 := congrArg (fun φ => φ.hom (h.appTop.hom ((Scheme.ΓSpecIso (.of B)).inv.hom b))) e
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e2
    simp only [wcCnSigma, RingHom.comp_apply]
    exact e2

  have s5 : ∀ (O O' : X.Opens) (h : O' ≤ O) (a : Γ(X, O)),
      (X'.presheaf.map (homOfLE (π.preimage_mono h)).op).hom ((π.app O).hom a) =
        (π.app O').hom ((X.presheaf.map (homOfLE h).op).hom a) := by
    intro O O' h a
    have e := π.naturality (homOfLE h).op
    have e2 := congrArg (fun φ => φ.hom a) e
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e2
    exact e2.symm

  choose Θ hΘ' using hΘ
  refine ⟨fun O hO => letI := (wcCnSigma q O).toAlgebra;
    ((TensorProduct.rid κ Γ(X, O)).toLinearMap ∘ₗ
      LinearMap.lTensor Γ(X, O) ℓ).toAddMonoidHom.comp (Θ O hO).symm.toAddMonoidHom,
    ?_, ?_, ?_⟩
  · intro O hO r a
    exact (s2 Γ(X, O) Γ(X', π ⁻¹ᵁ O) (iA := (wcCnSigma q O).toAlgebra) (π.app O).hom
      (wcCnSigma q' (π ⁻¹ᵁ O)) (Θ O hO) (hΘ' O hO)).1 r a
  · intro O hO
    exact (s2 Γ(X, O) Γ(X', π ⁻¹ᵁ O) (iA := (wcCnSigma q O).toAlgebra) (π.app O).hom
      (wcCnSigma q' (π ⁻¹ᵁ O)) (Θ O hO) (hΘ' O hO)).2
  · intro O O' hO hO' h a
    exact s3 Γ(X, O) Γ(X', π ⁻¹ᵁ O) Γ(X, O') Γ(X', π ⁻¹ᵁ O')
      (iA := (wcCnSigma q O).toAlgebra) (iA' := (wcCnSigma q O').toAlgebra)
      (π.app O).hom (wcCnSigma q' (π ⁻¹ᵁ O)) (Θ O hO)
      (π.app O').hom (wcCnSigma q' (π ⁻¹ᵁ O')) (Θ O' hO')
      (X.presheaf.map (homOfLE h).op).hom
      (X'.presheaf.map (homOfLE (π.preimage_mono h)).op).hom
      (hΘ' O hO) (hΘ' O' hO') (fun c => s4 q O O' h c) (fun b => s5 O O' h b)
