theorem wcpa_dj_lmga_matched_cover : ∀ (Ω : Type u) [Field Ω] (W' : ValuationSubring Ω)
    (Wb : ValuationSubring (IsLocalRing.ResidueField ↥W')), HenselianLocalRing ↥W' →
    IsAlgClosed (IsLocalRing.ResidueField ↥W') →
