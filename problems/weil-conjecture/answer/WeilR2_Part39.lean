        ∃ c : Fin N₂ → K, ∀ a, t a = ∑ j, wcpaLccScal g (L'.V a ⊓ g ⁻¹ᵁ ⊤) (c j) * β₂ j a) →
      (∀ t : ∀ a : Fin L'.m, Γ(X, L'.V a ⊓ g ⁻¹ᵁ ⊤), wcpaDjCompat L' (g ⁻¹ᵁ ⊤) (d₁ + d₂) t →
        ∃! c : Fin N → K, ∀ a, t a = ∑ l, wcpaLccScal g (L'.V a ⊓ g ⁻¹ᵁ ⊤) (c l) * β l a) →
      (∀ i j a, β₁ i a * β₂ j a =
        ∑ l, wcpaLccScal g (L'.V a ⊓ g ⁻¹ᵁ ⊤) (M i j l) * β l a) →
      (∀ x₀ : ∀ a : Fin L'.m, Γ(X, L'.V a ⊓ g ⁻¹ᵁ ⊤),
        wcpaDjCompat L' (g ⁻¹ᵁ ⊤) (d₁ + d₂) x₀ →
        ∃ (n : ℕ) (y z : Fin n → ∀ a : Fin L'.m, Γ(X, L'.V a ⊓ g ⁻¹ᵁ ⊤)),
          (∀ l, wcpaDjCompat L' (g ⁻¹ᵁ ⊤) d₁ (y l) ∧ wcpaDjCompat L' (g ⁻¹ᵁ ⊤) d₂ (z l)) ∧
          ∀ a, x₀ a = ∑ l, y l a * z l a) →
      ∀ v : Fin N → K, ∃ E : Fin N₁ → Fin N₂ → K, ∀ l, v l = ∑ i, ∑ j, M i j l * E i j := by
    intro K _ X g L' d₁ d₂ N₁ N₂ N β₁ β₂ β M hβ h1 h2 hu hM hCF' v
    let x₀ : ∀ a : Fin L'.m, Γ(X, L'.V a ⊓ g ⁻¹ᵁ ⊤) := fun a =>
      ∑ l, wcpaLccScal g (L'.V a ⊓ g ⁻¹ᵁ ⊤) (v l) * β l a
    have hx₀ : wcpaDjCompat L' (g ⁻¹ᵁ ⊤) (d₁ + d₂) x₀ := by
      intro a b
