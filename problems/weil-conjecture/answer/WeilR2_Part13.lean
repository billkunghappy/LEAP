  have hw2 : (D.obj m').hom = (D.map t₂).left ≫ (D.obj l).hom :=
    (MorphismProperty.Over.w (D.map t₂)).symm
  obtain ⟨k, t, ht⟩ := Scheme.exists_hom_comp_eq_comp_of_locallyOfFiniteType D0 tt (D.obj l).hom
