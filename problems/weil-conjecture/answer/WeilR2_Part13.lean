  have hs4 : ∀ (T : B.ProEt) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ B.Etale) (a : ∀ l, T ⟶ (wcEtToProEt B).obj (D.obj l)), (∀ {l l' : Λ} (t : l ⟶ l'), a l ≫ (wcEtToProEt B).map (D.map t) = a l') → IsAffine T.left → (∀ l, IsAffine (D.obj l).left) → (∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! h : Z ⟶ T.left, ∀ l, h ≫ (a l).left = z l) → CompactSpace ((wcProEtBaseChange g).obj T).left ∧ QuasiSeparatedSpace ((wcProEtBaseChange g).obj T).left ∧ (∀ l, CompactSpace ((wcEtBaseChange g).obj (D.obj l)).left) ∧ (∀ l, QuasiSeparatedSpace ((wcEtBaseChange g).obj (D.obj l)).left) ∧ (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom ((wcEtBaseChange g).map (D.map t)).left) ∧ (∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ ((wcEtBaseChange g).obj (D.obj l)).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ ((wcEtBaseChange g).map (D.map t)).left = z l') → ∃! h : Z ⟶ ((wcProEtBaseChange g).obj T).left, ∀ l, h ≫ ((wcProEtBaseChange g).map (a l)).left = z l) := by
    intro T Λ _ _ D a ha hT hD hlim
    have gen : ∀ (T0 : Scheme.{u}) (fT : T0 ⟶ B) (_ : IsAffine T0) (Y : Λ → Scheme.{u})
        (fY : ∀ l, Y l ⟶ B) (_ : ∀ l, IsAffine (Y l))
        (tr : ∀ {l l' : Λ}, (l ⟶ l') → (Y l ⟶ Y l'))
        (htr : ∀ {l l' : Λ} (t : l ⟶ l'), tr t ≫ fY l' = fY l)
        (al : ∀ l, T0 ⟶ Y l) (hal : ∀ l, al l ≫ fY l = fT)
        (_ : ∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ Y l), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ tr t = z l') →
          ∃! h : Z ⟶ T0, ∀ l, h ≫ al l = z l),
        CompactSpace ↥(Limits.pullback fT g) ∧ QuasiSeparatedSpace ↥(Limits.pullback fT g) ∧
        (∀ l, CompactSpace ↥(Limits.pullback (fY l) g)) ∧
        (∀ l, QuasiSeparatedSpace ↥(Limits.pullback (fY l) g)) ∧
        (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (Limits.pullback.lift
          (Limits.pullback.fst (fY l) g ≫ tr t) (Limits.pullback.snd (fY l) g)
          (by rw [Category.assoc, htr t]; exact Limits.pullback.condition))) ∧
        (∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ Limits.pullback (fY l) g),
          (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ Limits.pullback.lift
            (Limits.pullback.fst (fY l) g ≫ tr t) (Limits.pullback.snd (fY l) g)
            (by rw [Category.assoc, htr t]; exact Limits.pullback.condition) = z l') →
          ∃! h : Z ⟶ Limits.pullback fT g, ∀ l, h ≫ Limits.pullback.lift
            (Limits.pullback.fst fT g ≫ al l) (Limits.pullback.snd fT g)
            (by rw [Category.assoc, hal l]; exact Limits.pullback.condition) = z l) := by
      intro T0 fT hT0 Y fY hY tr htr al hal hlim0
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
      · exact QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst fT g)
      · exact quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst fT g)
      · intro l
        haveI := hY l
        exact QuasiCompact.compactSpace_of_compactSpace (Limits.pullback.fst (fY l) g)
      · intro l
        haveI := hY l
        exact quasiSeparatedSpace_of_quasiSeparated (Limits.pullback.fst (fY l) g)
      · intro l l' t
        haveI := hY l
        haveI := hY l'
        have hDt : IsAffineHom (tr t) := isAffineHom_of_isAffine _
        have hsq : IsPullback (Limits.pullback.fst (fY l) g) (Limits.pullback.lift
            (Limits.pullback.fst (fY l) g ≫ tr t) (Limits.pullback.snd (fY l) g)
            (by rw [Category.assoc, htr t]; exact Limits.pullback.condition))
            (tr t) (Limits.pullback.fst (fY l') g) := by
          refine IsPullback.of_bot ?_ (Limits.pullback.lift_fst _ _ _).symm
            (IsPullback.of_hasPullback (fY l') g)
          rw [Limits.pullback.lift_snd, htr t]
          exact IsPullback.of_hasPullback (fY l) g
        exact MorphismProperty.of_isPullback (P := @IsAffineHom) hsq hDt
      · intro Z z hz
        obtain ⟨l0⟩ := IsCofiltered.nonempty (C := Λ)
        have hz' : ∀ {l l' : Λ} (t : l ⟶ l'),
            (z l ≫ Limits.pullback.fst (fY l) g) ≫ tr t = z l' ≫ Limits.pullback.fst (fY l') g := by
          intro l l' t
          rw [← hz t, Category.assoc, Category.assoc, Limits.pullback.lift_fst]
        have hsnd1 : ∀ {l l' : Λ} (t : l ⟶ l'),
            z l ≫ Limits.pullback.snd (fY l) g = z l' ≫ Limits.pullback.snd (fY l') g := by
          intro l l' t
          rw [← hz t, Category.assoc, Limits.pullback.lift_snd]
        have hsnd : ∀ l, z l ≫ Limits.pullback.snd (fY l) g =
            z l0 ≫ Limits.pullback.snd (fY l0) g := by
          intro l
          rw [← hsnd1 (IsCofiltered.minToLeft l l0), hsnd1 (IsCofiltered.minToRight l l0)]
        obtain ⟨h0, hh0, hu0⟩ := hlim0 Z (fun l => z l ≫ Limits.pullback.fst (fY l) g) hz'
        have hcond : h0 ≫ fT = (z l0 ≫ Limits.pullback.snd (fY l0) g) ≫ g := by
          rw [← hal l0, ← Category.assoc, hh0 l0, Category.assoc, Limits.pullback.condition,
            Category.assoc]
        refine ⟨Limits.pullback.lift h0 (z l0 ≫ Limits.pullback.snd (fY l0) g) hcond, ?_, ?_⟩
        · intro l
          apply Limits.pullback.hom_ext
          · rw [Category.assoc, Limits.pullback.lift_fst, ← Category.assoc, Limits.pullback.lift_fst,
              hh0 l]
          · rw [Category.assoc, Limits.pullback.lift_snd, Limits.pullback.lift_snd, hsnd l]
        · intro h' hh'
          apply Limits.pullback.hom_ext
          · rw [Limits.pullback.lift_fst]
            apply hu0
            intro l
            rw [← hh' l, Category.assoc, Category.assoc, Limits.pullback.lift_fst]
          · rw [Limits.pullback.lift_snd, ← hh' l0, Category.assoc, Limits.pullback.lift_snd]

    exact gen T.left T.hom hT (fun l => (D.obj l).left) (fun l => (D.obj l).hom) hD
      (fun t => (D.map t).left) (fun t => MorphismProperty.Over.w (D.map t))
      (fun l => (a l).left) (fun l => MorphismProperty.Over.w (a l)) hlim

  obtain ⟨β, hβ⟩ := wc_epsInv_push_bc_map g
  have hiso : ∀ F, IsIso (β.app F) := fun F =>
    (Sheaf.isLocallyBijective_iff_isIso (β.app F)).1
      ⟨wc_epsInv_bc_locally_injective g β hβ (wc_proet_affIndEt_covering B) (wc_etPres_of_affIndEt B)
          hs4 (wc_epsInv_limit_inj X) hs7 hs8 F,
        wc_epsInv_bc_locally_surjective g β hβ (wc_proet_affIndEt_covering B) (wc_etPres_of_affIndEt B)
          hs4 (wc_epsInv_limit_surj X) F⟩
  haveI : IsIso β := NatIso.isIso_of_isIso_app β
  exact ⟨asIso β⟩

theorem wc_proet_push_rightDerived_zero_of_local : ∀ {X B : Scheme.{u}} (g : X ⟶ B) (G : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (n : ℕ), (∀ U : B.ProEt, Sieve.generate (fun (T : B.ProEt) (_ : T ⟶ U) => ∀ e : Abelian.Ext (wcFreeSheaf X ((wcProEtBaseChange g).obj T)) G (n + 1), e = 0) ∈ Scheme.ProEt.topology B U) → Limits.IsZero (((wcProEtPush g).rightDerived (n + 1)).obj G) :=
by
  intro X B g G n hloc

  have yon : ∀ (V : X.ProEt), ∃ e : ∀ F : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1},
      (wcFreeSheaf X V ⟶ F) ≃ F.obj.obj (Opposite.op V),
      (∀ (F F' : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (φ : F ⟶ F')
        (g : wcFreeSheaf X V ⟶ F), e F' (g ≫ φ) = φ.hom.app (Opposite.op V) (e F g)) ∧
      (∀ F : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}, e F 0 = 0) := by
    intro U
    let e2 : ∀ G : X.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1},
        (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G) ≃ G.obj (Opposite.op U) :=
      fun G =>
        ((Adjunction.whiskerRight X.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u}) G).trans
          (uliftYonedaEquiv.{u+1} (X := U) (F := G ⋙ forget AddCommGrpCat.{u+1}))
    have hnat2 : ∀ (G G' : X.ProEtᵒᵖ ⥤ AddCommGrpCat.{u+1}) (ψ : G ⟶ G')
        (h : yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free ⟶ G),
        e2 G' (h ≫ ψ) = ψ.app (Opposite.op U) (e2 G h) := by
      intro G G' ψ h
      have hW := (Adjunction.whiskerRight X.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv_naturality_right
        (X := yoneda.obj U ⋙ uliftFunctor.{u+1, u}) h ψ
      have hY := uliftYonedaEquiv_comp.{u+1}
        ((Adjunction.whiskerRight X.ProEtᵒᵖ AddCommGrpCat.adj.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u}) G h)
        (((Functor.whiskeringRight X.ProEtᵒᵖ AddCommGrpCat.{u+1} (Type (u+1))).obj
            (forget AddCommGrpCat.{u+1})).map ψ)
      exact (congrArg (uliftYonedaEquiv.{u+1} (X := U) (F := G' ⋙ forget AddCommGrpCat.{u+1})) hW).trans hY
    let e : ∀ F : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1},
        (wcFreeSheaf X U ⟶ F) ≃ F.obj.obj (Opposite.op U) := fun F =>
      ((sheafificationAdjunction (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).homEquiv
          (yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) F).trans (e2 F.obj)
    have hnat : ∀ (F F' : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}) (φ : F ⟶ F')
        (g : wcFreeSheaf X U ⟶ F), e F' (g ≫ φ) = φ.hom.app (Opposite.op U) (e F g) := by
      intro F F' φ g
      have hA := (sheafificationAdjunction (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).homEquiv_naturality_right
        (X := yoneda.obj U ⋙ uliftFunctor.{u+1, u} ⋙ AddCommGrpCat.free) g φ
      exact (congrArg (e2 F'.obj) hA).trans (hnat2 F.obj F'.obj φ.hom _)
    refine ⟨e, hnat, fun F => ?_⟩
    have h1 := hnat F F 0 0
    rw [Limits.zero_comp] at h1
    rw [h1]
    have h0 : (0 : F ⟶ F).hom = 0 :=
      (sheafToPresheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1}).map_zero F F
    rw [h0, NatTrans.app_zero]
    rfl
  let J := injectiveResolution G
  let K := J.cocomplex

  have s1 : ∀ (V : X.ProEt), (∀ e : Abelian.Ext (wcFreeSheaf X V) G (n + 1), e = 0) →
      ∀ c : (K.X (n + 1)).obj.obj (Opposite.op V),
        ((K.d (n + 1) (n + 2)).hom.app (Opposite.op V)).hom c = 0 →
        ∃ e : (K.X n).obj.obj (Opposite.op V), ((K.d n (n + 1)).hom.app (Opposite.op V)).hom e = c := by
    intro V hV c hc
    obtain ⟨e, hnat, h0⟩ := yon V
    obtain ⟨x, rfl⟩ := (e (K.X (n + 1))).surjective c
    have hxd : x ≫ K.d (n + 1) (n + 2) = 0 := by
      apply (e (K.X (n + 2))).injective
      rw [hnat, h0]
      exact hc
    obtain ⟨y, hy⟩ := (J.extMk_eq_zero_iff x (n + 2) rfl hxd n rfl).1 (hV _)
    refine ⟨e (K.X n) y, ?_⟩
    have h2 := hnat _ _ (K.d n (n + 1)) y
    rw [hy] at h2
    exact h2.symm

  have s1' : ∀ (H : (B.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}),
      (∀ (V : B.ProEt) (z : H.obj (Opposite.op V)),
        Presheaf.equalizerSieve (F := H) (X := Opposite.op V) z 0 ∈ Scheme.ProEt.topology B V) →
      Limits.IsZero ((presheafToSheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}).obj H) := by
    intro H hH
    obtain ⟨Z, hZ⟩ := (Limits.HasZeroObject.zero : ∃ Z : (B.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1},
      Limits.IsZero Z)
    let f : H ⟶ Z := 0
    have hinj : Presheaf.IsLocallyInjective (Scheme.ProEt.topology B) f := by
      apply Presheaf.IsLocallyInjective.mk
      intro X x y _
      refine GrothendieckTopology.superset_covering _ ?_ (hH X.unop (x - y))
      intro W g hg
      rw [Presheaf.equalizerSieve_apply] at hg ⊢
      rw [map_sub, map_zero, sub_eq_zero] at hg
      exact hg
    have hsurj : Presheaf.IsLocallySurjective (Scheme.ProEt.topology B) f := by
      apply Presheaf.IsLocallySurjective.mk
      intro U s
      have htop : Presheaf.imageSieve f s = ⊤ := by
        ext W g
        simp only [Sieve.top_apply, iff_true]
        rw [Presheaf.imageSieve_apply]
        refine ⟨0, ?_⟩
        have : Subsingleton (ToType (Z.obj (Opposite.op W))) :=
          AddCommGrpCat.isZero_iff_subsingleton.mp (hZ.obj _)
        exact Subsingleton.elim _ _
      rw [htop]
      exact (Scheme.ProEt.topology B).top_mem U
    have hW : (Scheme.ProEt.topology B).W f :=
      (GrothendieckTopology.W_iff_isLocallyBijective _ f).2 ⟨hinj, hsurj⟩
    haveI := (GrothendieckTopology.W_iff _ f).1 hW
    exact Limits.IsZero.of_iso (Functor.map_isZero _ hZ)
      (asIso ((presheafToSheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}).map f))

  have s2 : ∀ (S : ShortComplex ((B.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1})),
      (∀ (V : B.ProEt) (c : S.X₂.obj (Opposite.op V)), (S.g.app (Opposite.op V)).hom c = 0 →
        ∃ R : Sieve V, R ∈ Scheme.ProEt.topology B V ∧ ∀ (T : B.ProEt) (f : T ⟶ V), R.arrows f →
          ∃ e : S.X₁.obj (Opposite.op T), (S.f.app (Opposite.op T)).hom e = (S.X₂.map f.op).hom c) →
      ∀ (V : B.ProEt) (z : S.homology.obj (Opposite.op V)),
        Presheaf.equalizerSieve (F := S.homology) (X := Opposite.op V) z 0 ∈
          Scheme.ProEt.topology B V := by
    intro S hS V z
    have hπ : Epi (S.homologyπ.app (Opposite.op V)) :=
      (NatTrans.epi_iff_epi_app _).1 inferInstance _
    obtain ⟨k, rfl⟩ := (AddCommGrpCat.epi_iff_surjective _).1 hπ z
    have hι : ∀ X, Function.Injective (ConcreteCategory.hom (S.iCycles.app X)) := fun X =>
      (AddCommGrpCat.mono_iff_injective _).1 ((NatTrans.mono_iff_mono_app _).1 inferInstance X)
    have hc : (S.g.app (Opposite.op V)).hom ((S.iCycles.app (Opposite.op V)).hom k) = 0 := by
      have := congrArg (fun φ => (φ.app (Opposite.op V)).hom k) S.iCycles_g
      simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
        Function.comp_apply, NatTrans.app_zero, AddCommGrpCat.hom_zero,
        AddMonoidHom.zero_apply] at this
      exact this
    obtain ⟨R, hR, hRf⟩ := hS V _ hc
    refine GrothendieckTopology.superset_covering _ ?_ hR
    intro W g hg
    obtain ⟨e, he⟩ := hRf W g hg
    rw [Presheaf.equalizerSieve_apply, map_zero]
    have h1 : ConcreteCategory.hom (S.cycles.map g.op) k =
        ConcreteCategory.hom (S.toCycles.app (Opposite.op W)) e := by
      apply hι
      rw [NatTrans.naturality_apply]
      have n2 := congrArg (fun φ => (φ.app (Opposite.op W)).hom e) S.toCycles_i
      simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
        Function.comp_apply] at n2
      exact (he.symm.trans n2.symm)
    rw [← NatTrans.naturality_apply, h1]
    have n3 := congrArg (fun φ => (φ.app (Opposite.op W)).hom e) S.toCycles_comp_homologyπ
    simp only [NatTrans.comp_app, AddCommGrpCat.hom_comp, AddMonoidHom.coe_comp,
      Function.comp_apply] at n3
    simpa using n3

  let BC := wcProEtBaseChange g
  let Φ : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⥤
      ((B.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) :=
    sheafToPresheaf (Scheme.ProEt.topology X) AddCommGrpCat.{u+1} ⋙
      (Functor.whiskeringLeft (B.ProEt)ᵒᵖ (X.ProEt)ᵒᵖ AddCommGrpCat.{u+1}).obj
        (wcProEtBaseChange g).op
  let Sp : ShortComplex ((B.ProEt)ᵒᵖ ⥤ AddCommGrpCat.{u+1}) :=
    ShortComplex.mk (Φ.map (K.d n (n+1))) (Φ.map (K.d (n+1) (n+2)))
      (by rw [← Functor.map_comp, K.d_comp_d, Functor.map_zero])
  have hlocS : ∀ (V : B.ProEt) (c : Sp.X₂.obj (Opposite.op V)), (Sp.g.app (Opposite.op V)).hom c = 0 →
      ∃ R : Sieve V, R ∈ Scheme.ProEt.topology B V ∧ ∀ (T : B.ProEt) (f : T ⟶ V), R.arrows f →
        ∃ e : Sp.X₁.obj (Opposite.op T), (Sp.f.app (Opposite.op T)).hom e = (Sp.X₂.map f.op).hom c := by
    intro V c hc
    refine ⟨_, hloc V, ?_⟩
    intro T f hf
    obtain ⟨Y, h, k, hk, rfl⟩ := hf
    have hc2 : ((K.d (n + 1) (n + 2)).hom.app (Opposite.op (BC.obj V))).hom c = 0 := hc
    have hc' : ((K.d (n + 1) (n + 2)).hom.app (Opposite.op (BC.obj Y))).hom
        (((K.X (n + 1)).obj.map (BC.map k).op).hom c) = 0 := by
      refine (NatTrans.naturality_apply (K.d (n + 1) (n + 2)).hom (BC.map k).op c).trans ?_
      refine (congrArg (fun t => ((K.X (n + 2)).obj.map (BC.map k).op).hom t) hc2).trans ?_
      exact map_zero _
    obtain ⟨e', he'⟩ := s1 (BC.obj Y) hk _ hc'
    refine ⟨((K.X n).obj.map (BC.map h).op).hom e', ?_⟩
    refine (NatTrans.naturality_apply (K.d n (n + 1)).hom (BC.map h).op e').trans ?_
    refine (congrArg (fun t => ((K.X (n + 1)).obj.map (BC.map h).op).hom t) he').trans ?_
    show _ = ((K.X (n + 1)).obj.map (BC.map (h ≫ k)).op).hom c
    rw [BC.map_comp, op_comp, Functor.map_comp]
    rfl
  have hZ := s1' Sp.homology (s2 Sp hlocS)
  have hH : Limits.IsZero ((((wcProEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj K).homology
      (n + 1)) :=
    Limits.IsZero.of_iso hZ
      ((HomologicalComplex.homologyIsoSc' (((wcProEtPush g).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj K) n (n+1) (n+2) (CochainComplex.prev_nat_succ n)
          (CochainComplex.next ℕ (n+1)) :
        _ ≅ (Sp.map (presheafToSheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1})).homology) ≪≫
        Sp.mapHomologyIso (presheafToSheaf (Scheme.ProEt.topology B) AddCommGrpCat.{u+1}))
  exact Limits.IsZero.of_iso hH (J.isoRightDerivedObj (wcProEtPush g) (n + 1))

theorem wc_proet_rightDerived_push_epsInv : ∀ (K : Type u) [Field K] (X B : Scheme.{u}) (fB : B ⟶ Spec (.of K)) [IsProper fB] (g : X ⟶ B) [IsProper g] (m : ℕ) (I : InjectiveResolution ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) (q : ℕ), Nonempty (((wcProEtPush g).rightDerived q).obj (wcContSheaf X (ZMod m)) ≅ (wcEpsInv B).obj ((((wcEtPush g).mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q)) :=
by
  intro K _ X B fB _ g _ m I q
  haveI := wc_et_enough_injectives X
  haveI := wc_et_enough_injectives B
  have hexact : ∀ S : Scheme.{u},
      (wcEtToProEt S).IsContinuous (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S) ∧
      (wcEpsInv S).Additive ∧ Limits.PreservesFiniteLimits (wcEpsInv S) ∧
      Limits.PreservesFiniteColimits (wcEpsInv S) := by
    intro S
    obtain ⟨hlim, hcont⟩ := wc_etToProEt_flat_cont S
    haveI := hlim
    haveI := hcont
    haveI hlan := wc_lan_preservesFiniteLimits (wcEtToProEt S)
    let adj := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (wcEtToProEt S)
      AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)
    haveI hpl : Limits.PreservesFiniteLimits (wcEpsInv S) := by
      haveI := Functor.sheafPullbackConstruction.preservesFiniteLimits (wcEtToProEt S)
        AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)
      exact Limits.preservesFiniteLimits_of_natIso
        (Adjunction.leftAdjointUniq (Functor.sheafAdjunctionContinuous (wcEtToProEt S)
          AddCommGrpCat.{u+1} (Scheme.smallEtaleTopology S) (Scheme.ProEt.topology S)) adj)
    haveI hladj : (wcEpsInv S).IsLeftAdjoint := adj.isLeftAdjoint
    haveI hpc : Limits.PreservesFiniteColimits (wcEpsInv S) := by
      haveI := adj.leftAdjoint_preservesColimits.{0, 0}
      exact Limits.PreservesColimitsOfSize.preservesFiniteColimits.{0, 0} _
    haveI : (wcEpsInv S).PreservesZeroMorphisms :=
      Functor.preservesZeroMorphisms_of_isLeftAdjoint _
    exact ⟨hcont, Functor.additive_of_preserves_binary_products _, hpl, hpc⟩
  obtain ⟨hcX, haX, hlX, hcolX⟩ := hexact X
  obtain ⟨hcB, haB, hlB, hcolB⟩ := hexact B
  obtain ⟨β⟩ := wc_epsInv_push_base_change g
  have hacyc : ∀ (J : Sheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}) [Injective J]
      (n : ℕ), Limits.IsZero (((wcProEtPush g).rightDerived (n + 1)).obj ((wcEpsInv X).obj J)) := by
    intro J _ n
    apply wc_proet_push_rightDerived_zero_of_local
    intro U
    refine GrothendieckTopology.superset_covering _ ?_ (wc_proet_affIndEt_covering B U)
    apply Sieve.generate_mono
    rintro T f ⟨A, hA, hT⟩
    exact fun e => wc_proet_push_epsInv_injective_affine_vanishing g A hA T hT J n e
  obtain ⟨Φ⟩ := wc_rightDerived_exact_conj_iso (wcEtPush g) (wcProEtPush g) (wcEpsInv X)
    (wcEpsInv B) ⟨β⟩ hacyc
    ((constantSheaf (Scheme.smallEtaleTopology X) AddCommGrpCat.{u+1}).obj
      (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) q
  obtain ⟨c₁⟩ := wc_contSheaf_discrete_const X (ZMod m)
  obtain ⟨c₂⟩ := wc_epsInv_const X (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))
  exact ⟨((wcProEtPush g).rightDerived q).mapIso (c₁ ≪≫ c₂.symm) ≪≫ Φ ≪≫
    (wcEpsInv B).mapIso (I.isoRightDerivedObj (wcEtPush g) q)⟩

theorem wc_smooth_restrict_of_local_smooth : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y) (W : Y.Opens), (∀ x : X, g x ∈ W → ∃ U' : X.Opens, x ∈ U' ∧ Smooth (U'.ι ≫ g)) → Smooth (g ∣_ W) :=
by
  intro X Y g W hloc
  haveI : IsZariskiLocalAtSource @Smooth :=
    HasRingHomProperty.instIsZariskiLocalAtSource (P := @Smooth)
  haveI : IsZariskiLocalAtTarget @Smooth :=
    HasRingHomProperty.instIsZariskiLocalAtTarget @Smooth
  choose O hyO hO using fun y : (g ⁻¹ᵁ W).toScheme => hloc ((g ⁻¹ᵁ W).ι y) y.2
  have hcov : ⨆ y, (g ⁻¹ᵁ W).ι ⁻¹ᵁ O y = ⊤ := by
    rw [eq_top_iff]
    intro z _
    rw [TopologicalSpace.Opens.mem_iSup]
    exact ⟨z, hyO z⟩
  refine IsZariskiLocalAtSource.of_iSup_eq_top (P := @Smooth) _ hcov (fun y => ?_)
  have hrange : Set.range ((((g ⁻¹ᵁ W).ι ⁻¹ᵁ O y).ι ≫ (g ⁻¹ᵁ W).ι)) ⊆
      Set.range (O y).ι := by
    rw [Scheme.Opens.range_ι]
    rintro _ ⟨z, rfl⟩
    exact z.2
  have hfac := IsOpenImmersion.lift_fac (O y).ι _ hrange
  haveI : IsOpenImmersion (IsOpenImmersion.lift (O y).ι _ hrange ≫ (O y).ι) := by
    rw [hfac]; infer_instance
  haveI : IsOpenImmersion (IsOpenImmersion.lift (O y).ι _ hrange) :=
    IsOpenImmersion.of_comp _ (O y).ι
  have hcomp : Smooth ((((g ⁻¹ᵁ W).ι ⁻¹ᵁ O y).ι ≫ g ∣_ W) ≫ W.ι) := by
    have e : (((g ⁻¹ᵁ W).ι ⁻¹ᵁ O y).ι ≫ g ∣_ W) ≫ W.ι =
        IsOpenImmersion.lift (O y).ι _ hrange ≫ ((O y).ι ≫ g) := by
      rw [Category.assoc, morphismRestrict_ι, ← Category.assoc, ← Category.assoc, hfac]
    rw [e]
    exact IsZariskiLocalAtSource.comp (hO y) _
  have hpb : IsPullback (𝟙 _) (((g ⁻¹ᵁ W).ι ⁻¹ᵁ O y).ι ≫ g ∣_ W)
      ((((g ⁻¹ᵁ W).ι ⁻¹ᵁ O y).ι ≫ g ∣_ W) ≫ W.ι) W.ι :=
    IsPullback.of_horiz_isIso_mono ⟨by rw [Category.id_comp]⟩
  exact IsZariskiLocalAtTarget.of_isPullback hpb hcomp

theorem wc_et_cospec_stalk_nat : ∀ (B : Scheme.{u}) (b η : B) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)), W'.Initial → ∀ (lift : ∀ l, Spec (.of (AlgebraicClosure (B.residueField η))) ⟶ (W'.obj l).right.left) (hlift : ∀ l, lift l ≫ (W'.obj l).right.hom = wcEtGeomPt B η), (∀ {l l' : Λ} (t : l ⟶ l'), lift l ≫ (W'.map t).right.left = lift l') → ∃ sp : wcEtStalk B b ⟶ wcEtStalk B η, ∀ (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (l : Λ) (s : F.obj.obj (Opposite.op (W'.obj l).right)), (sp.app F).hom ((Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (W'.obj l))).hom s) = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk (lift l) (hlift l) : Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj (W'.obj l).right)))).hom s :=
by
  intro B b η Λ _ _ W' hinit lift hlift hc
  haveI : W'.Initial := hinit
  haveI : W'.op.Final := Functor.final_op_of_initial W'
  let Pb := StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)
  let Pη := StructuredArrow.proj (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)
  let N : Λ → StructuredArrow (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B) := fun l =>
    StructuredArrow.mk (Over.homMk (lift l) (hlift l) :
      Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj (W'.obj l).right)
  let n : ∀ {l l' : Λ} (t : l ⟶ l'), N l ⟶ N l' := fun {l l'} t =>
    StructuredArrow.homMk (W'.map t).right (Over.OverMorphism.ext (hc t))
  let c : ∀ F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1},
      Limits.Cocone (W'.op ⋙ Pb.op ⋙ F.obj) := fun F =>
    { pt := Limits.colimit (Pη.op ⋙ F.obj)
      ι := { app := fun l => Limits.colimit.ι (Pη.op ⋙ F.obj) (Opposite.op (N l.unop))
             naturality := fun l l' f => by
               have hw := Limits.colimit.w (Pη.op ⋙ F.obj) (n f.unop).op
               show _ = _ ≫ 𝟙 _
               rw [Category.comp_id]
               exact hw } }
  let sp_app : ∀ F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1},
      (wcEtStalk B b).obj F ⟶ (wcEtStalk B η).obj F := fun F =>
    inv (Limits.colimit.pre (Pb.op ⋙ F.obj) W'.op) ≫ Limits.colimit.desc _ (c F)
  have germ : ∀ (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (l : Λ),
      Limits.colimit.ι (Pb.op ⋙ F.obj) (Opposite.op (W'.obj l)) ≫ sp_app F =
        Limits.colimit.ι (Pη.op ⋙ F.obj) (Opposite.op (N l)) := by
    intro F l
    have h1 : Limits.colimit.ι (W'.op ⋙ Pb.op ⋙ F.obj) (Opposite.op l) ≫
        Limits.colimit.pre (Pb.op ⋙ F.obj) W'.op =
        Limits.colimit.ι (Pb.op ⋙ F.obj) (Opposite.op (W'.obj l)) :=
      Limits.colimit.ι_pre _ _ _
    show Limits.colimit.ι (Pb.op ⋙ F.obj) (Opposite.op (W'.obj l)) ≫
        (inv (Limits.colimit.pre (Pb.op ⋙ F.obj) W'.op) ≫ Limits.colimit.desc _ (c F)) = _
    rw [← h1, Category.assoc, IsIso.hom_inv_id_assoc, Limits.colimit.ι_desc]
  let sp : wcEtStalk B b ⟶ wcEtStalk B η :=
    { app := sp_app
      naturality := fun F F' ψ => by
        apply (cancel_epi (Limits.colimit.pre (Pb.op ⋙ F.obj) W'.op)).1
        apply Limits.colimit.hom_ext
        intro j
        obtain ⟨l⟩ := j
        have e1 : Limits.colimit.ι (W'.op ⋙ Pb.op ⋙ F.obj) (Opposite.op l) ≫
            Limits.colimit.pre (Pb.op ⋙ F.obj) W'.op =
            Limits.colimit.ι (Pb.op ⋙ F.obj) (Opposite.op (W'.obj l)) :=
          Limits.colimit.ι_pre _ _ _
        have e2 : Limits.colimit.ι (Pb.op ⋙ F.obj) (Opposite.op (W'.obj l)) ≫
            (wcEtStalk B b).map ψ =
            ((sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).map ψ).app
              (Opposite.op (W'.obj l).right) ≫
            Limits.colimit.ι (Pb.op ⋙ F'.obj) (Opposite.op (W'.obj l)) :=
          Limits.colimit.ι_map (Functor.whiskerLeft Pb.op
            ((sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).map ψ))
            (Opposite.op (W'.obj l))
        have e3 : Limits.colimit.ι (Pη.op ⋙ F.obj) (Opposite.op (N l)) ≫
            (wcEtStalk B η).map ψ =
            ((sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).map ψ).app
              (Opposite.op (W'.obj l).right) ≫
            Limits.colimit.ι (Pη.op ⋙ F'.obj) (Opposite.op (N l)) :=
          Limits.colimit.ι_map (Functor.whiskerLeft Pη.op
            ((sheafToPresheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}).map ψ))
            (Opposite.op (N l))
        simp only [← Category.assoc]
        rw [e1, e2, Category.assoc, germ F' l, germ F l, e3] }
  refine ⟨sp, fun F l s => ?_⟩
  rw [← germ F l]
  try rfl

theorem wc_et_cospec_isIso_of_germ : ∀ (B : Scheme.{u}) (b η : B) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)), W'.Initial → ∀ (lift : ∀ l, Spec (.of (AlgebraicClosure (B.residueField η))) ⟶ (W'.obj l).right.left) (hlift : ∀ l, lift l ≫ (W'.obj l).right.hom = wcEtGeomPt B η) (F : Sheaf (Scheme.smallEtaleTopology B) AddCommGrpCat.{u+1}) (spF : (wcEtStalk B b).obj F ⟶ (wcEtStalk B η).obj F), (∀ (l : Λ) (s : F.obj.obj (Opposite.op (W'.obj l).right)), spF.hom ((Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (W'.obj l))).hom s) = (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk (lift l) (hlift l) : Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj (W'.obj l).right)))).hom s) → (∀ y : (wcEtStalk B η).obj F, ∃ (l : Λ) (s : F.obj.obj (Opposite.op (W'.obj l).right)), (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk (lift l) (hlift l) : Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj (W'.obj l).right)))).hom s = y) → (∀ (l : Λ) (s : F.obj.obj (Opposite.op (W'.obj l).right)), (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B η)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (StructuredArrow.mk (Over.homMk (lift l) (hlift l) : Over.mk (wcEtGeomPt B η) ⟶ (Scheme.Etale.forget B).obj (W'.obj l).right)))).hom s = 0 → (Limits.colimit.ι ((StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj) (Opposite.op (W'.obj l))).hom s = 0) → IsIso spF :=
by
  intro B b η Λ _ _ W' hW' lift hlift F spF hG hS hK
  haveI : W'.Initial := hW'
  haveI : W'.op.Final := Functor.final_op_of_initial W'
  haveI : IsFiltered Λᵒᵖ := isFiltered_op_of_isCofiltered Λ
  haveI : Limits.PreservesFilteredColimitsOfSize.{u, u} (forget AddCommGrpCat.{u+1}) := by
    first
      | exact Limits.preservesFilteredColimitsOfSize_shrink.{u, u+1, u, u+1} (forget AddCommGrpCat.{u+1})
      | exact Limits.preservesFilteredColimitsOfSize_shrink.{u, u, u+1, u+1} (forget AddCommGrpCat.{u+1})
      | exact Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u+1, u, u} (forget AddCommGrpCat.{u+1})
      | exact Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u, u+1, u} (forget AddCommGrpCat.{u+1})
      | exact Limits.preservesFilteredColimitsOfSize_shrink.{u, u+1, u+1, u} (forget AddCommGrpCat.{u+1})
      | exact Limits.preservesFilteredColimitsOfSize_shrink.{u+1, u, u, u+1} (forget AddCommGrpCat.{u+1})
      | exact Limits.preservesFilteredColimitsOfSize_shrink (forget AddCommGrpCat.{u+1})
      | infer_instance
  let Φ := (StructuredArrow.proj (Over.mk (wcEtGeomPt B b)) (Scheme.Etale.forget B)).op ⋙ F.obj
  haveI : IsIso (Limits.colimit.pre Φ W'.op) := Functor.Final.colimit_pre_isIso W'.op
  have hrep : ∀ x : (wcEtStalk B b).obj F, ∃ (l : Λ) (s : F.obj.obj (Opposite.op (W'.obj l).right)),
      (Limits.colimit.ι Φ (Opposite.op (W'.obj l))).hom s = x := by
    intro x
    obtain ⟨l', s, hs⟩ := Limits.Concrete.colimit_exists_rep (W'.op ⋙ Φ)
      ((inv (Limits.colimit.pre Φ W'.op)).hom x)
    refine ⟨l'.unop, s, ?_⟩
    have e := ConcreteCategory.congr_hom (Limits.colimit.ι_pre Φ W'.op l') s
    refine e.symm.trans ?_
    have e2 : (Limits.colimit.pre Φ W'.op).hom ((Limits.colimit.ι (W'.op ⋙ Φ) l').hom s) = x := by
      rw [hs]
      exact IsIso.inv_hom_id_apply _ x
    exact e2
  have hsurj : Function.Surjective spF.hom := by
    intro y
    obtain ⟨l, s, hs⟩ := hS y
    exact ⟨_, (hG l s).trans hs⟩
  have hinj : Function.Injective spF.hom := by
    refine (injective_iff_map_eq_zero spF.hom).2 ?_
    intro x hx
    obtain ⟨l, s, rfl⟩ := hrep x
    exact hK l s ((hG l s).symm.trans hx)
  exact (ConcreteCategory.isIso_iff_bijective spF).2 ⟨hinj, hsurj⟩

theorem wc_ext_postcomp_bij_of_ker_coker_acyclic : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] (P G F : C) (φ : G ⟶ F), (∀ n : ℕ, Subsingleton (Abelian.Ext P (Limits.kernel φ) n)) → (∀ n : ℕ, Subsingleton (Abelian.Ext P (Limits.cokernel φ) n)) → ∀ n : ℕ, Function.Bijective (fun x : Abelian.Ext P G n => x.comp (Abelian.Ext.mk₀ φ) (add_zero n)) :=
by
  intro C _ _ _ P G F φ hker hcoker n

  have inj_of : ∀ {Y Z : C} (β : Abelian.Ext Y Z 0) (m : ℕ),
      (∀ x : Abelian.Ext P Y m, x.comp β (add_zero m) = 0 → x = 0) →
      Function.Injective (fun x : Abelian.Ext P Y m => x.comp β (add_zero m)) := by
    intro Y Z β m h x y hxy
    have hxy' : x.comp β (add_zero m) = y.comp β (add_zero m) := hxy
    have h1 : (x - y).comp β (add_zero m) = 0 := by
      rw [sub_eq_add_neg, Abelian.Ext.add_comp, Abelian.Ext.neg_comp, hxy', add_neg_cancel]
    exact sub_eq_zero.mp (h _ h1)

  let S₁ : ShortComplex C := ShortComplex.mk (Limits.kernel.ι φ)
    (Limits.cokernel.π (Limits.kernel.ι φ)) (Limits.cokernel.condition _)
  have hS₁ : S₁.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel (Limits.kernel.ι φ))
      (inferInstanceAs (Mono (Limits.kernel.ι φ)))
      (inferInstanceAs (Epi (Limits.cokernel.π (Limits.kernel.ι φ))))
  let S₂ : ShortComplex C := ShortComplex.mk (Limits.kernel.ι (Limits.cokernel.π φ))
    (Limits.cokernel.π φ) (Limits.kernel.condition _)
  have hS₂ : S₂.ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_kernel (Limits.cokernel.π φ))
      (inferInstanceAs (Mono (Limits.kernel.ι (Limits.cokernel.π φ))))
      (inferInstanceAs (Epi (Limits.cokernel.π φ)))

  have hπ : ∀ m : ℕ, Function.Bijective
      (fun x : Abelian.Ext P S₁.X₂ m => x.comp (Abelian.Ext.mk₀ S₁.g) (add_zero m)) := by
    intro m
    refine ⟨inj_of _ m (fun x hx => ?_), fun y => ?_⟩
    · obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS₁ x hx
      rw [← hx₁, @Subsingleton.elim _ (hker m) x₁ 0, Abelian.Ext.zero_comp]
    · have h0 : y.comp hS₁.extClass (rfl : m + 1 = m + 1) = 0 :=
        @Subsingleton.elim _ (hker (m + 1)) _ _
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS₁ y rfl h0
      exact ⟨x₂, hx₂⟩

  have hι : ∀ m : ℕ, Function.Bijective
      (fun x : Abelian.Ext P S₂.X₁ m => x.comp (Abelian.Ext.mk₀ S₂.f) (add_zero m)) := by
    intro m
    refine ⟨inj_of _ m (fun x hx => ?_), fun y => ?_⟩
    · rcases m with _ | k
      · haveI := hS₂.mono_f
        have hx' := hx
        rw [← Abelian.Ext.mk₀_homEquiv₀_apply x, Abelian.Ext.mk₀_comp_mk₀,
          Abelian.Ext.mk₀_eq_zero_iff] at hx'
        have ha : Abelian.Ext.homEquiv₀ x = 0 :=
          (cancel_mono S₂.f).1 (by rw [hx', Limits.zero_comp])
        rw [← Abelian.Ext.mk₀_homEquiv₀_apply x, ha, Abelian.Ext.mk₀_zero]
      · obtain ⟨x₃, hx₃⟩ :=
          Abelian.Ext.covariant_sequence_exact₁ P hS₂ x hx (rfl : k + 1 = k + 1)
        rw [← hx₃, @Subsingleton.elim _ (hcoker k) x₃ 0, Abelian.Ext.zero_comp]
    · have h0 : y.comp (Abelian.Ext.mk₀ S₂.g) (add_zero m) = 0 :=
        @Subsingleton.elim _ (hcoker m) _ _
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS₂ y h0
      exact ⟨x₁, hx₁⟩

  have hc : ∀ m : ℕ, Function.Bijective
      (fun x : Abelian.Ext P (Abelian.coimage φ) m =>
        x.comp (Abelian.Ext.mk₀ (Abelian.coimageImageComparison φ)) (add_zero m)) := by
    intro m
    refine Function.bijective_iff_has_inverse.mpr
      ⟨fun y => y.comp (Abelian.Ext.mk₀ (inv (Abelian.coimageImageComparison φ))) (add_zero m),
        fun x => ?_, fun y => ?_⟩
    · show (x.comp (Abelian.Ext.mk₀ (Abelian.coimageImageComparison φ)) (add_zero m)).comp
          (Abelian.Ext.mk₀ (inv (Abelian.coimageImageComparison φ))) (add_zero m) = x
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero m) (add_zero 0) (by omega : m + 0 + 0 = m),
        Abelian.Ext.mk₀_comp_mk₀, IsIso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · show (y.comp (Abelian.Ext.mk₀ (inv (Abelian.coimageImageComparison φ))) (add_zero m)).comp
          (Abelian.Ext.mk₀ (Abelian.coimageImageComparison φ)) (add_zero m) = y
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero m) (add_zero 0) (by omega : m + 0 + 0 = m),
        Abelian.Ext.mk₀_comp_mk₀, IsIso.inv_hom_id, Abelian.Ext.comp_mk₀_id]

  have hf : S₁.g ≫ Abelian.coimageImageComparison φ ≫ S₂.f = φ :=
    Abelian.coimage_image_factorisation φ
  have heq : (fun x : Abelian.Ext P G n => x.comp (Abelian.Ext.mk₀ φ) (add_zero n)) =
      (fun x : Abelian.Ext P S₂.X₁ n => x.comp (Abelian.Ext.mk₀ S₂.f) (add_zero n)) ∘
      (fun x : Abelian.Ext P (Abelian.coimage φ) n =>
        x.comp (Abelian.Ext.mk₀ (Abelian.coimageImageComparison φ)) (add_zero n)) ∘
      (fun x : Abelian.Ext P S₁.X₂ n => x.comp (Abelian.Ext.mk₀ S₁.g) (add_zero n)) := by
    funext x
    show x.comp (Abelian.Ext.mk₀ φ) (add_zero n) =
      ((x.comp (Abelian.Ext.mk₀ S₁.g) (add_zero n)).comp
        (Abelian.Ext.mk₀ (Abelian.coimageImageComparison φ)) (add_zero n)).comp
        (Abelian.Ext.mk₀ S₂.f) (add_zero n)
    rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega : n + 0 + 0 = n),
      Abelian.Ext.comp_assoc _ _ _ (add_zero n) (add_zero 0) (by omega : n + 0 + 0 = n),
      Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_comp_mk₀, hf]
  rw [heq]
  exact (hι n).comp ((hc n).comp (hπ n))

theorem wc_ext_pull_bij_of_post_bij_ext_acyclic : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] (L : D ⥤ C) (R : C ⥤ D) [L.Additive] [Limits.PreservesFiniteLimits L] [Limits.PreservesFiniteColimits L] [R.Additive] (adj : L ⊣ R) (A : D) (B : C) (μ : L.obj A ≅ B), letI := HasExt.standard C; letI := HasExt.standard D; (∀ k : ℕ, Function.Bijective (fun x : Abelian.Ext A A k => x.comp (Abelian.Ext.mk₀ (adj.unit.app A ≫ R.map μ.hom)) (add_zero k))) → ∀ (I : InjectiveResolution B), (∀ q : ℕ, 1 ≤ q → ∀ p : ℕ, Subsingleton (Abelian.Ext A (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) p)) → ∀ k : ℕ, Function.Bijective (((Abelian.Ext.mk₀ μ.inv).precomp _ (zero_add k)).comp (((Abelian.Ext.mk₀ μ.hom).postcomp _ (add_zero k)).comp (L.mapExtAddHom A A k))) :=
by
  intro C D _ _ _ _ L R _ _ _ _ adj A B μ H1 I H2 k
  letI instC : HasExt C := HasExt.standard C
  letI instD : HasExt D := HasExt.standard D
  haveI := adj.rightAdjoint_preservesLimits
  haveI : L.PreservesMonomorphisms := inferInstance

  have c1 : ∀ (X : D) (S : ShortComplex D), S.ShortExact →
      (∀ p : ℕ, Subsingleton (Abelian.Ext X S.X₃ p)) → ∀ p : ℕ,
      Function.Bijective (fun x : Abelian.Ext X S.X₁ p => x.comp (Abelian.Ext.mk₀ S.f) (add_zero p)) := by
    intro X S hS h3 p
    haveI := hS.mono_f
    have hb : Function.Bijective ((Abelian.Ext.mk₀ S.f).postcomp X (add_zero p)) := by
      constructor
      · rw [injective_iff_map_eq_zero]
        intro x hx
        cases p with
        | zero =>
          obtain ⟨a, rfl⟩ := (Abelian.Ext.mk₀_bijective X S.X₁).2 x
          have h0 : a ≫ S.f = 0 := by
            apply (Abelian.Ext.mk₀_bijective X S.X₂).1
            rw [Abelian.Ext.mk₀_zero, ← Abelian.Ext.mk₀_comp_mk₀]
            exact hx
          have ha : a = 0 := by
            rw [← cancel_mono S.f, h0, Limits.zero_comp]
          rw [ha, Abelian.Ext.mk₀_zero]
        | succ k =>
          obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS x hx rfl
          rw [← hx₃, Subsingleton.elim x₃ 0, Abelian.Ext.zero_comp]
      · intro x₂
        obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ X hS x₂ (Subsingleton.elim _ _)
        exact ⟨x₁, hx₁⟩
    exact hb

  have c2 : ∀ n : ℕ, Nonempty (Limits.cokernel (R.map (Limits.kernel.lift
      (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
      (I.cocomplex.d_comp_d n (n + 1) (n + 2)))) ≅
      ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology (n + 1)) := by
    intro n
    let ψ₁ : R.obj (Limits.kernel (I.cocomplex.d (n + 1) (n + 2))) ≅
        Limits.kernel (R.map (I.cocomplex.d (n + 1) (n + 2))) :=
      Limits.PreservesKernel.iso R _
    have hψ₁ : ψ₁.hom ≫ Limits.kernel.ι (R.map (I.cocomplex.d (n + 1) (n + 2))) =
        R.map (Limits.kernel.ι (I.cocomplex.d (n + 1) (n + 2))) := by
      simp only [ψ₁, Limits.PreservesKernel.iso_hom, Limits.kernelComparison_comp_ι]
    let ψ₂ :=
      Limits.IsLimit.conePointUniqueUpToIso
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).cyclesIsKernel
          (n + 1) (n + 2) (by simp))
        (Limits.kernelIsKernel (R.map (I.cocomplex.d (n + 1) (n + 2))))
    have hψ₂ : ψ₂.inv ≫ ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles
        (n + 1) = Limits.kernel.ι (R.map (I.cocomplex.d (n + 1) (n + 2))) :=
      Limits.IsLimit.conePointUniqueUpToIso_inv_comp
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).cyclesIsKernel
          (n + 1) (n + 2) (by simp))
        (Limits.kernelIsKernel (R.map (I.cocomplex.d (n + 1) (n + 2))))
        Limits.WalkingParallelPair.zero
    have hφ : (ψ₁ ≪≫ ψ₂.symm).hom ≫
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles (n + 1) =
        R.map (Limits.kernel.ι (I.cocomplex.d (n + 1) (n + 2))) := by
      rw [Iso.trans_hom, Iso.symm_hom, Category.assoc, hψ₂, hψ₁]
    have claim : R.map (Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
        (I.cocomplex.d_comp_d n (n + 1) (n + 2))) ≫ (ψ₁ ≪≫ ψ₂.symm).hom =
        ((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).toCycles n (n + 1) := by
      rw [← cancel_mono (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).iCycles
        (n + 1)), Category.assoc, hφ, ← R.map_comp, Limits.kernel.lift_ι,
        HomologicalComplex.toCycles_i]
      all_goals rfl
    exact ⟨(Limits.cokernelCompIsIso _ (ψ₁ ≪≫ ψ₂.symm).hom).symm ≪≫ Limits.cokernelIsoOfEq claim ≪≫
      Limits.IsColimit.coconePointUniqueUpToIso (Limits.cokernelIsCokernel _)
        (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homologyIsCokernel
          n (n + 1) (by simp))⟩

  have c3 : ∀ {T : ShortComplex D} (hT : T.ShortExact) {S : ShortComplex C} (hS : S.ShortExact)
      (φ : T.map L ⟶ S) {X : D} (m : ℕ) (z : Abelian.Ext X T.X₃ m),
      (Abelian.Ext.mapExactFunctor L (z.comp hT.extClass rfl)).comp (Abelian.Ext.mk₀ φ.τ₁)
        (add_zero (m + 1)) =
      ((Abelian.Ext.mapExactFunctor L z).comp (Abelian.Ext.mk₀ φ.τ₃) (add_zero m)).comp
        hS.extClass rfl := by
    intro T hT S hS φ X m z
    have h₁ : (T.map L).ShortExact := hT.map_of_exact L
    have hnat : h₁.extClass.comp (Abelian.Ext.mk₀ φ.τ₁) (add_zero 1) =
        (Abelian.Ext.mk₀ φ.τ₃).comp hS.extClass (zero_add 1) :=
      h₁.extClass_naturality hS φ
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_extClass,
      Abelian.Ext.comp_assoc _ _ _ rfl (add_zero 1) (by omega),
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 1) (by omega), hnat]

  let τ : ∀ (Y : C) (m : ℕ), Abelian.Ext A (R.obj Y) m →+ Abelian.Ext (L.obj A) Y m :=
    fun Y m => AddMonoidHom.mk'
      (fun α => (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y))
        (add_zero m))
      (fun a b => by rw [Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp])
  have hτ : ∀ (Y : C) (m : ℕ) (α : Abelian.Ext A (R.obj Y) m),
      τ Y m α = (Abelian.Ext.mapExactFunctor L α).comp (Abelian.Ext.mk₀ (adj.counit.app Y))
        (add_zero m) := fun _ _ _ => rfl

  have s1a : ∀ {Y Y' : C} (g : Y ⟶ Y') (m : ℕ) (v : Abelian.Ext A (R.obj Y) m),
      τ Y' m (v.comp (Abelian.Ext.mk₀ (R.map g)) (add_zero m)) =
        (τ Y m v).comp (Abelian.Ext.mk₀ g) (add_zero m) := by
    intro Y Y' g m v
    have e1 : L.map (R.map g) ≫ adj.counit.app Y' = adj.counit.app Y ≫ g :=
      adj.counit_naturality g
    rw [hτ, hτ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀, e1,
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega),
      Abelian.Ext.mk₀_comp_mk₀]

  have base : ∀ Y : C, Function.Bijective (τ Y 0) := by
    intro Y
    have e : ⇑(τ Y 0) = fun x =>
        Abelian.Ext.mk₀ ((adj.homEquiv A Y).symm (Abelian.Ext.homEquiv₀ x)) := by
      funext x
      conv_lhs => rw [← Abelian.Ext.mk₀_homEquiv₀_apply x]
      rw [hτ, Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀,
        Adjunction.homEquiv_counit]
    rw [e]
    exact (Abelian.Ext.mk₀_bijective _ _).comp
      ((adj.homEquiv A Y).symm.bijective.comp Abelian.Ext.homEquiv₀.bijective)

  have postC : ∀ {X Y Y' : C} (ψ : Y ≅ Y') (n : ℕ),
      Function.Bijective (fun x : Abelian.Ext X Y n => x.comp (Abelian.Ext.mk₀ ψ.hom) (add_zero n)) := by
    intro X Y Y' ψ n
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun x => x.comp (Abelian.Ext.mk₀ ψ.inv) (add_zero n), fun x => ?_, fun x => ?_⟩
    · dsimp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · dsimp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  have postD : ∀ {X Y Y' : D} (ψ : Y ≅ Y') (n : ℕ),
      Function.Bijective (fun x : Abelian.Ext X Y n => x.comp (Abelian.Ext.mk₀ ψ.hom) (add_zero n)) := by
    intro X Y Y' ψ n
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun x => x.comp (Abelian.Ext.mk₀ ψ.inv) (add_zero n), fun x => ?_, fun x => ?_⟩
    · dsimp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
    · dsimp only
      rw [Abelian.Ext.comp_assoc _ _ _ (add_zero n) (zero_add 0) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id]
  have preC : ∀ {X X' Y : C} (φ : X' ≅ X) (n : ℕ),
      Function.Bijective (fun x : Abelian.Ext X Y n => (Abelian.Ext.mk₀ φ.hom).comp x (zero_add n)) := by
    intro X X' Y φ n
    rw [Function.bijective_iff_has_inverse]
    refine ⟨fun x => (Abelian.Ext.mk₀ φ.inv).comp x (zero_add n), fun x => ?_, fun x => ?_⟩
    · dsimp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add n) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.mk₀_id_comp]
    · dsimp only
      rw [← Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add n) (by omega),
        Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.mk₀_id_comp]

  obtain ⟨Y, f, g, w, hS, hRSex, hRf, hQ, ⟨e⟩⟩ : ∃ (Y : ℕ → C) (f : ∀ n, Y n ⟶ I.cocomplex.X n)
      (g : ∀ n, I.cocomplex.X n ⟶ Y (n + 1)) (w : ∀ n, f n ≫ g n = 0),
      (∀ n, (ShortComplex.mk (f n) (g n) (w n)).ShortExact) ∧
      (∀ n, ((ShortComplex.mk (f n) (g n) (w n)).map R).Exact) ∧
      (∀ n, Mono (R.map (f n))) ∧
      (∀ n p, Subsingleton (Abelian.Ext A (Limits.cokernel (R.map (g n))) p)) ∧
      Nonempty (B ≅ Y 0) := by
    have hw : ∀ n, Limits.kernel.ι (I.cocomplex.d n (n + 1)) ≫
        Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
          (I.cocomplex.d_comp_d n (n + 1) (n + 2)) = 0 := by
      intro n
      rw [← cancel_mono (Limits.kernel.ι (I.cocomplex.d (n + 1) (n + 2))), Category.assoc,
        Limits.kernel.lift_ι, Limits.zero_comp]
      exact Limits.kernel.condition _
    have hSE : ∀ n, (ShortComplex.mk (Limits.kernel.ι (I.cocomplex.d n (n + 1)))
        (Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
          (I.cocomplex.d_comp_d n (n + 1) (n + 2))) (hw n)).ShortExact := by
      intro n
      have hex : (I.cocomplex.sc' n (n + 1) (n + 2)).Exact :=
        (I.cocomplex.exactAt_iff' n (n + 1) (n + 2) (by simp) (by simp)).1
          (I.cocomplex_exactAt_succ n)
      rw [ShortComplex.exact_iff_epi_kernel_lift] at hex
      have hlim : Limits.IsLimit (Limits.KernelFork.ofι
          (Limits.kernel.ι (I.cocomplex.d n (n + 1))) (hw n)) :=
        Limits.KernelFork.IsLimit.ofι _ _
          (fun g' hg' => Limits.kernel.lift _ g' (by
            rw [← Limits.kernel.lift_ι (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
              (I.cocomplex.d_comp_d n (n + 1) (n + 2)), ← Category.assoc, hg', Limits.zero_comp]))
          (fun g' hg' => Limits.kernel.lift_ι _ _ _)
          (fun g' hg' m hm => by
            rw [← cancel_mono (Limits.kernel.ι (I.cocomplex.d n (n + 1))), hm,
              Limits.kernel.lift_ι])
      refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
      · exact ShortComplex.exact_of_f_is_kernel _ hlim
      · exact (inferInstance : Mono (Limits.kernel.ι (I.cocomplex.d n (n + 1))))
      · exact hex
    refine ⟨fun n => Limits.kernel (I.cocomplex.d n (n + 1)),
      fun n => Limits.kernel.ι (I.cocomplex.d n (n + 1)),
      fun n => Limits.kernel.lift (I.cocomplex.d (n + 1) (n + 2)) (I.cocomplex.d n (n + 1))
        (I.cocomplex.d_comp_d n (n + 1) (n + 2)), hw, hSE, ?_, ?_, ?_, ?_⟩
    · intro n
      exact (hSE n).exact.map_of_mono_of_preservesKernel R (hSE n).mono_f inferInstance
    · intro n
      exact (inferInstance : Mono (R.map (Limits.kernel.ι (I.cocomplex.d n (n + 1)))))
    · intro n p
      obtain ⟨ψ⟩ := c2 n
      haveI := H2 (n + 1) (by omega) p
      exact ⟨fun a b => (postD (X := A) ψ p).1 (Subsingleton.elim _ _)⟩
    · have h0 := I.exact₀.fIsKernel
      exact ⟨(HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 B).symm ≪≫
        Limits.IsLimit.conePointUniqueUpToIso h0 (Limits.limit.isLimit _)⟩


  have hfac : ∀ n, Limits.factorThruImage (R.map (g n)) ≫ Limits.image.ι (R.map (g n)) =
      R.map (g n) := fun n => Limits.image.fac _
  have wT : ∀ n, R.map (f n) ≫ Limits.factorThruImage (R.map (g n)) = 0 := by
    intro n
    rw [← cancel_mono (Limits.image.ι (R.map (g n))), Category.assoc, hfac, ← R.map_comp, w n,
      R.map_zero, Limits.zero_comp]
  have hT : ∀ n, (ShortComplex.mk _ _ (wT n)).ShortExact := by
    intro n
    let m : ShortComplex.mk _ _ (wT n) ⟶ (ShortComplex.mk (f n) (g n) (w n)).map R :=
      { τ₁ := 𝟙 _, τ₂ := 𝟙 _, τ₃ := Limits.image.ι (R.map (g n))
        comm₁₂ := by simp
        comm₂₃ := by simp [hfac] }
    haveI : Epi m.τ₁ := by change Epi (𝟙 _); infer_instance
    haveI : IsIso m.τ₂ := by change IsIso (𝟙 _); infer_instance
    haveI : Mono m.τ₃ := by change Mono (Limits.image.ι (R.map (g n))); infer_instance
    haveI := hRf n
    exact ShortComplex.ShortExact.mk' ((ShortComplex.exact_iff_of_epi_of_isIso_of_mono m).mpr
      (hRSex n)) (by dsimp; infer_instance) (by dsimp; infer_instance)
  have wU : ∀ n, Limits.image.ι (R.map (g n)) ≫ Limits.cokernel.π (R.map (g n)) = 0 := by
    intro n
    rw [← cancel_epi (Limits.factorThruImage (R.map (g n))), ← Category.assoc, hfac,
      Limits.cokernel.condition, Limits.comp_zero]
  have hU : ∀ n, (ShortComplex.mk _ _ (wU n)).ShortExact := by
    intro n
    have hT0 : (ShortComplex.mk _ _ (Limits.cokernel.condition (R.map (g n)))).Exact :=
      ShortComplex.exact_cokernel (R.map (g n))
    let m : ShortComplex.mk _ _ (Limits.cokernel.condition (R.map (g n))) ⟶
        ShortComplex.mk _ _ (wU n) :=
      { τ₁ := Limits.factorThruImage (R.map (g n)), τ₂ := 𝟙 _, τ₃ := 𝟙 _
        comm₁₂ := by simp [hfac]
        comm₂₃ := by simp }
    haveI : Epi m.τ₁ := by change Epi (Limits.factorThruImage (R.map (g n))); infer_instance
    haveI : IsIso m.τ₂ := by change IsIso (𝟙 _); infer_instance
    haveI : Mono m.τ₃ := by change Mono (𝟙 _); infer_instance
    exact ShortComplex.ShortExact.mk' ((ShortComplex.exact_iff_of_epi_of_isIso_of_mono m).mp hT0)
      (by dsimp; infer_instance) (by dsimp; infer_instance)
  have hjbij : ∀ n p, Function.Bijective (fun x : Abelian.Ext A (Limits.image (R.map (g n))) p =>
      x.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n)))) (add_zero p)) :=
    fun n p => c1 A _ (hU n) (hQ n) p

  have hJ : ∀ n, Injective (I.cocomplex.X n) := I.injective
  have hRJ : ∀ n, Injective (R.obj (I.cocomplex.X n)) := fun n => by
    haveI := hJ n
    exact Injective.injective_of_adjoint adj _
  have hJsurj : ∀ (n m : ℕ) (u : Abelian.Ext (L.obj A) (I.cocomplex.X n) m),
      ∃ v, τ (I.cocomplex.X n) m v = u := by
    intro n m u
    cases m with
    | zero => exact (base _).2 u
    | succ m' =>
      haveI := hJ n
      exact ⟨0, by rw [map_zero]; exact (Abelian.Ext.eq_zero_of_injective u).symm⟩
  have s1b' : ∀ (n m : ℕ) (x : Abelian.Ext A (Limits.image (R.map (g n))) m),
      τ (Y n) (m + 1) (x.comp (hT n).extClass rfl) =
        (τ (Y (n + 1)) m (x.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n)))) (add_zero m))).comp
          (hS n).extClass rfl := by
    intro n m x
    let φ : (ShortComplex.mk _ _ (wT n)).map L ⟶ ShortComplex.mk (f n) (g n) (w n) :=
      { τ₁ := adj.counit.app (Y n)
        τ₂ := adj.counit.app (I.cocomplex.X n)
        τ₃ := L.map (Limits.image.ι (R.map (g n))) ≫ adj.counit.app (Y (n + 1))
        comm₁₂ := (adj.counit_naturality (f n)).symm
        comm₂₃ := by
          show adj.counit.app (I.cocomplex.X n) ≫ g n =
            L.map (Limits.factorThruImage (R.map (g n))) ≫
              L.map (Limits.image.ι (R.map (g n))) ≫ adj.counit.app (Y (n + 1))
          rw [← Category.assoc, ← L.map_comp, hfac]
          exact (adj.counit_naturality (g n)).symm }
    have h3 := c3 (hT n) (hS n) φ m x
    rw [hτ, hτ]
    refine h3.trans ?_
    rw [Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
      Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega), Abelian.Ext.mk₀_comp_mk₀]
  have tower : ∀ m n, Function.Bijective (τ (Y n) m) := by
    intro m
    induction m with
    | zero => intro n; exact base (Y n)
    | succ m ih =>
      intro n
      constructor
      · rw [injective_iff_map_eq_zero]
        intro w' hw'
        haveI := hRJ n
        have h0 : w'.comp (Abelian.Ext.mk₀ (R.map (f n))) (add_zero _) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨x, hx⟩ : ∃ x : Abelian.Ext A (Limits.image (R.map (g n))) m,
            x.comp (hT n).extClass rfl = w' :=
          Abelian.Ext.covariant_sequence_exact₁ A (hT n) w' h0 rfl
        have h1 : (τ (Y (n + 1)) m (x.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n))))
            (add_zero m))).comp (hS n).extClass rfl = 0 := by
          rw [← s1b' n m x, hx]
          exact hw'
        obtain ⟨u, hu⟩ : ∃ u : Abelian.Ext (L.obj A) (I.cocomplex.X n) m,
            u.comp (Abelian.Ext.mk₀ (g n)) (add_zero m) = τ (Y (n + 1)) m
              (x.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n)))) (add_zero m)) :=
          Abelian.Ext.covariant_sequence_exact₃ (L.obj A) (hS n) _ rfl h1
        obtain ⟨v, hv⟩ := hJsurj n m u
        have hz : v.comp (Abelian.Ext.mk₀ (R.map (g n))) (add_zero m) =
            x.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n)))) (add_zero m) := by
          apply (ih (n + 1)).1
          rw [s1a, hv]
          exact hu
        have hz' : (v.comp (Abelian.Ext.mk₀ (Limits.factorThruImage (R.map (g n)))) (add_zero m)).comp
            (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n)))) (add_zero m) =
            x.comp (Abelian.Ext.mk₀ (Limits.image.ι (R.map (g n)))) (add_zero m) := by
          rw [Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 0) (by omega),
            Abelian.Ext.mk₀_comp_mk₀, hfac]
          exact hz
        have hx' : v.comp (Abelian.Ext.mk₀ (Limits.factorThruImage (R.map (g n)))) (add_zero m) = x :=
          (hjbij n m).1 hz'
        have hc : (Abelian.Ext.mk₀ (Limits.factorThruImage (R.map (g n)))).comp (hT n).extClass
            (zero_add 1) = 0 := (hT n).comp_extClass
        rw [← hx, ← hx', Abelian.Ext.comp_assoc _ _ _ (add_zero m) (zero_add 1) (by omega), hc,
          Abelian.Ext.comp_zero]
      · intro y
        haveI := hJ n
        have h0 : y.comp (Abelian.Ext.mk₀ (f n)) (add_zero _) = 0 :=
          Abelian.Ext.eq_zero_of_injective _
        obtain ⟨y', hy'⟩ : ∃ y' : Abelian.Ext (L.obj A) (Y (n + 1)) m,
            y'.comp (hS n).extClass rfl = y :=
          Abelian.Ext.covariant_sequence_exact₁ (L.obj A) (hS n) y h0 rfl
        obtain ⟨z', hz'⟩ := (ih (n + 1)).2 y'
        obtain ⟨x, hxz⟩ := (hjbij n m).2 z'
        dsimp only at hxz
        exact ⟨x.comp (hT n).extClass rfl, by rw [s1b' n m x, hxz, hz', hy']⟩

  have hτB : Function.Bijective (τ B k) := by
    have hc : (fun x : Abelian.Ext (L.obj A) B k => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero k)) ∘
        (τ B k) = (τ (Y 0) k) ∘
          (fun v : Abelian.Ext A (R.obj B) k => v.comp (Abelian.Ext.mk₀ (R.map e.hom)) (add_zero k)) := by
      funext v
      exact (s1a e.hom k v).symm
    have h2 : Function.Bijective ((fun x : Abelian.Ext (L.obj A) B k =>
        x.comp (Abelian.Ext.mk₀ e.hom) (add_zero k)) ∘ (τ B k)) := by
      rw [hc]
      exact (tower k 0).comp (postD (R.mapIso e) k)
    exact (Function.Bijective.of_comp_iff' (postC e k) (τ B k)).1 h2

  have key : L.map (adj.unit.app A ≫ R.map μ.hom) ≫ adj.counit.app B = μ.hom := by
    have e2 : L.map (R.map μ.hom) ≫ adj.counit.app B = adj.counit.app (L.obj A) ≫ μ.hom :=
      adj.counit_naturality μ.hom
    have e3 : L.map (adj.unit.app A) ≫ adj.counit.app (L.obj A) = 𝟙 _ :=
      adj.left_triangle_components A
    rw [L.map_comp, Category.assoc, e2, ← Category.assoc]
    erw [e3]
    exact Category.id_comp _
  have hb : Function.Bijective (fun β : Abelian.Ext A A k => (Abelian.Ext.mk₀ μ.inv).comp
      (τ B k (β.comp (Abelian.Ext.mk₀ (adj.unit.app A ≫ R.map μ.hom)) (add_zero k))) (zero_add k)) :=
    (preC μ.symm k).comp (hτB.comp (H1 k))
  convert hb using 1
  funext β
  show (Abelian.Ext.mk₀ μ.inv).comp ((Abelian.Ext.mapExactFunctor L β).comp
      (Abelian.Ext.mk₀ μ.hom) (add_zero k)) (zero_add k) =
    (Abelian.Ext.mk₀ μ.inv).comp
      (τ B k (β.comp (Abelian.Ext.mk₀ (adj.unit.app A ≫ R.map μ.hom)) (add_zero k))) (zero_add k)
  rw [hτ, Abelian.Ext.mapExactFunctor_comp, Abelian.Ext.mapExactFunctor_mk₀,
    Abelian.Ext.comp_assoc _ _ _ (add_zero k) (zero_add 0) (by omega), Abelian.Ext.mk₀_comp_mk₀,
    key]

theorem wc_et_suppIn_of_closed_stalks : ∀ (Y : Scheme.{u}) (Z : Set Y), IsClosed Z → ∀ (F : Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}), (∀ x ∈ Z, Subsingleton ((wcEtStalk Y x).obj F)) → wcSuppIn Y Zᶜ F :=
by
  intro Y Z hZ F hF V s
  apply wc_etale_jointly_surjective_covers
  intro v
  by_cases h : V.hom v ∈ Z
  · obtain ⟨V₁, c, hv, hc⟩ := wc_et_vanish_off_of_stalks F V s v (hF _ h)
    exact ⟨V₁, c, ⟨V₁, 𝟙 V₁, c, Or.inl hc, Category.id_comp c⟩, hv⟩
  · let O : V.left.Opens := V.hom ⁻¹ᵁ ⟨Zᶜ, hZ.isOpen_compl⟩
    refine ⟨wcEtOpen Y V O, wcEtOpenι Y V O,
      ⟨wcEtOpen Y V O, 𝟙 _, wcEtOpenι Y V O, Or.inr ?_, Category.id_comp _⟩, ?_⟩
    · intro x
      have hx : O.ι x ∈ (O : Set V.left) := by
        rw [← Scheme.Opens.range_ι O]
        exact ⟨x, rfl⟩
      first
        | exact hx
        | (show V.hom (O.ι x) ∈ Zᶜ; exact hx)
        | (change (O.ι ≫ V.hom).base x ∈ Zᶜ; rw [Scheme.Hom.comp_base_apply]; exact hx)
    · change v ∈ Set.range O.ι
      rw [Scheme.Opens.range_ι]
      exact h

theorem wc_et_module_ext_vanish_of_closed_fibre_stalks : ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of A)) [IsProper f] (m : ℕ), 0 < m → ∀ (N : SheafOfModules.{u+1} (wcEtZModRing Y m)), (∀ x : Y, f x = IsLocalRing.closedPoint A → Subsingleton ((wcEtStalk Y x).obj ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj N))) → ∀ p : ℕ, Subsingleton (@Abelian.Ext (SheafOfModules.{u+1} (wcEtZModRing Y m)) _ _ (HasExt.standard _) (SheafOfModules.unit (wcEtZModRing Y m)) N p) :=
by
  intro A _ _ _ Y f _ m hm N hN p
  have hm0 : m ≠ 0 := hm.ne'

  have hloc : ∀ {X Y : Scheme.{u}} (g : X ⟶ Y),
      (∀ y : Y, ∃ U : Y.Opens, y ∈ U ∧ wcPBCV (g ∣_ U)) → wcPBCV g := by
    intro X Y g H A' _ _ _ a X' f' a' hsq m' hm' F hF htor' q'
    obtain ⟨U, hyU, hU⟩ := H (a (IsLocalRing.closedPoint A'))
    have htop : a ⁻¹ᵁ U = ⊤ := (IsLocalRing.closedPoint_mem_iff (U := a ⁻¹ᵁ U)).mp hyU
    have hrange : Set.range a ⊆ Set.range U.ι := by
      rw [Scheme.Opens.range_ι]
      rintro _ ⟨z, rfl⟩
      have hz : z ∈ a ⁻¹ᵁ U := by rw [htop]; trivial
      exact hz
    let b := IsOpenImmersion.lift U.ι a hrange
    have hb : b ≫ U.ι = a := IsOpenImmersion.lift_fac _ _ _
    have hsq2 : IsPullback (g ⁻¹ᵁ U).ι (g ∣_ U) g U.ι := (isPullback_morphismRestrict g U).flip
    let a'' : X' ⟶ (g ⁻¹ᵁ U : Scheme.{u}) :=
      hsq2.lift a' (f' ≫ b) (by rw [Category.assoc, hb, hsq.w])
    have h1 : a'' ≫ (g ⁻¹ᵁ U).ι = a' := hsq2.lift_fst _ _ _
    have h2 : a'' ≫ (g ∣_ U) = f' ≫ b := hsq2.lift_snd _ _ _
    have hbig : IsPullback (a'' ≫ (g ⁻¹ᵁ U).ι) f' g (b ≫ U.ι) := by rw [h1, hb]; exact hsq
    have hpb : IsPullback a'' f' (g ∣_ U) b := IsPullback.of_right hbig h2 hsq2
    exact hU A' b X' f' a'' hpb m' hm' F hF htor' q'
  have hP : wcPBCV f :=
    wc_proper_devissage (fun g => wcPBCV g) wc_pbc_finite wc_pbc_P1 wc_pbc_comp wc_pbc_cancel
      hloc f inferInstance

  have hZc : IsClosed (f ⁻¹' {IsLocalRing.closedPoint A}) :=
    (IsLocalRing.isClosed_singleton_closedPoint A).preimage f.continuous
  have hsupp : wcSuppIn Y (f ⁻¹' {IsLocalRing.closedPoint A})ᶜ
      ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj N) :=
    wc_et_suppIn_of_closed_stalks Y _ hZc _ (fun x hx => hN x hx)

  obtain ⟨α, _, _, hR⟩ := wc_et_zmod_ring_locbij Y m
  have T : m • 𝟙 N = 0 := by
    apply SheafOfModules.hom_ext
    apply PresheafOfModules.hom_ext
    intro V
    ext s
    have h0 : ((0 : N ⟶ N).val.app V).hom s = 0 := by
      first | rfl | simp | (rw [SheafOfModules.zero_val]; rfl)
    have hz : ∀ k : ℕ, ((k • 𝟙 N).val.app V).hom s = k • s := by
      intro k
      induction k with
      | zero => rw [zero_nsmul, zero_nsmul]; exact h0
      | succ k ih =>
        rw [succ_nsmul, SheafOfModules.add_val, PresheafOfModules.add_app, ModuleCat.hom_add,
          LinearMap.add_apply, ih, succ_nsmul]
        rfl
    rw [hz, ← Nat.cast_smul_eq_nsmul (R := ↑((wcEtZModRing Y m).obj.obj V)), hR V,
      zero_smul, h0]
  have htor : m • 𝟙 ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj N) = 0 := by
    rw [← (SheafOfModules.toSheaf (wcEtZModRing Y m)).map_id, ← Functor.map_nsmul, T,
      Functor.map_zero]
  have hv : Subsingleton (wcEtExt Y ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj N) p) :=
    hP A (𝟙 _) Y f (𝟙 Y) (IsPullback.id_horiz f) m hm0 _ hsupp htor p
  obtain ⟨E⟩ := wc_et_zmod_modext_toSheaf_equiv Y m hm N p
  letI : HasExt (Sheaf (Scheme.smallEtaleTopology Y) AddCommGrpCat.{u+1}) := HasExt.standard _
  haveI : Subsingleton (Abelian.Ext ((constantSheaf (Scheme.smallEtaleTopology Y)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} ℤ)))
      ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj N) p) := hv
  exact E.subsingleton

theorem wc_et_supp_unit_ker_coker_stalks_of_milnor_h0 : ∀ (A : Type u) [CommRing A] (Y : Scheme.{u}) (f : Y ⟶ Spec (.of A)) (m : ℕ), 0 < m → ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of A)) (D : wcEtPullData (Limits.pullback.fst f z) m) (x : Y), (∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt Y x)) (Scheme.Etale.forget Y)) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Y), wcHalShData x B Λ W' φ a → Nat.card (wcEtCoh (Limits.pullback (a ≫ f) z) m 0) = m) → Subsingleton ((wcEtStalk Y x).obj ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj (Limits.kernel (wcEtSuppUnitMap D)))) ∧ Subsingleton ((wcEtStalk Y x).obj ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj (Limits.cokernel (wcEtSuppUnitMap D)))) :=
by
  classical
  intro A _ Y f m hm Ω _ _ z D x H
  obtain ⟨B, _, _, _, Λ, _, _, W', φ, a, e', hinit, haff, hφ, hφa, hlim, he, hcomp⟩ :=
    wc_et_geom_strict_henselization x
  have hd : wcHalShData x B Λ W' φ a := ⟨hinit, haff, hφ, hφa, hlim, e', he, hcomp⟩
  have hF : Nat.card (wcEtCoh (Limits.pullback (a ≫ f) z) m 0) = m := H B Λ W' φ a hd

  have hTc : Nat.card ((wcEtStalk Y x).obj ((wcEtPush (Limits.pullback.fst f z)).obj
      ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback f z)) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))))) = m := by
    haveI hhaff : IsAffineHom (Limits.pullback.fst f z) :=
      MorphismProperty.of_isPullback (P := @IsAffineHom)
        (IsPullback.of_hasPullback f z).flip inferInstance
    haveI := wc_et_enough_injectives (Limits.pullback f z)
    let I := InjectiveResolution.of
      ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback f z)) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))
    obtain ⟨E₁⟩ := wc_et_stalk_push_homology (Limits.pullback.fst f z) x Λ W' hinit I.cocomplex 0
    obtain ⟨E₂⟩ := wc_et_limit_push_homology_affine (Limits.pullback.fst f z) B Λ
      (W' ⋙ StructuredArrow.proj (Over.mk (wcEtGeomPt Y x)) (Scheme.Etale.forget Y))
      φ a haff hφ hφa hlim m I 0
    obtain ⟨E₃⟩ := wc_et_coh_iso_invariance
      ((Limits.pullbackSymmetry (Limits.pullback.fst f z) a).hom ≫
        (Limits.pullbackRightPullbackFstIso f z a).hom) m 0
    obtain ⟨L, ⟨adj⟩, -, -⟩ := wc_et_push_left_adjoint (Limits.pullback.fst f z)
    haveI : Limits.PreservesFiniteLimits (wcEtPush (Limits.pullback.fst f z)) := by
      haveI := adj.rightAdjoint_preservesLimits
      infer_instance
    let ι := ((wcEtPush (Limits.pullback.fst f z)).rightDerivedZeroIsoSelf.app
      ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback f z)) AddCommGrpCat.{u+1}).obj
        (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).symm ≪≫
      I.isoRightDerivedObj (wcEtPush (Limits.pullback.fst f z)) 0
    let E0 : (wcEtStalk Y x).obj ((wcEtPush (Limits.pullback.fst f z)).obj
        ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback f z)) AddCommGrpCat.{u+1}).obj
          (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) ≃
        (wcEtStalk Y x).obj ((((wcEtPush (Limits.pullback.fst f z)).mapHomologicalComplex
          (ComplexShape.up ℕ)).obj I.cocomplex).homology 0) :=
      ((wcEtStalk Y x).mapIso ι).addCommGroupIsoToAddEquiv.toEquiv
    rw [Nat.card_congr (E0.trans (E₁.trans (E₂.trans E₃.symm))), hF]

  obtain ⟨-, hS0, -⟩ := wc_et_const_zmod_stalk_cyclic Y m hm x
  obtain ⟨e₁⟩ := wc_et_zmod_unit_toSheaf_iso Y m
  have hS : Nat.card ((wcEtStalk Y x).obj ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj
      (SheafOfModules.unit (wcEtZModRing Y m)))) = m :=
    (Nat.card_congr ((wcEtStalk Y x).mapIso e₁).addCommGroupIsoToAddEquiv.toEquiv).trans hS0

  obtain ⟨e₃⟩ := wc_et_toSheaf_pushforward_iso (Limits.pullback.fst f z) m D
  obtain ⟨e₄⟩ := wc_et_zmod_unit_toSheaf_iso (Limits.pullback f z) m
  have hT : Nat.card ((wcEtStalk Y x).obj ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj
      (wcEtSuppObj D))) = m := by
    refine (Nat.card_congr ((wcEtStalk Y x).mapIso
      (e₃.app (SheafOfModules.unit (wcEtZModRing (Limits.pullback f z) m)) ≪≫
        (wcEtPush (Limits.pullback.fst f z)).mapIso e₄)).addCommGroupIsoToAddEquiv.toEquiv).trans hTc
  haveI hTfin : Finite ((wcEtStalk Y x).obj ((SheafOfModules.toSheaf (wcEtZModRing Y m)).obj
      (wcEtSuppObj D))) :=
    Nat.finite_of_card_ne_zero (by rw [hT]; omega)

  have s3 : Nonempty ↥(Limits.pullback (a ≫ f) z) →
      ∀ (V : StructuredArrow (Over.mk (wcEtGeomPt Y x)) (Scheme.Etale.forget Y)),
      Nonempty ↥(Limits.pullback V.right.hom (Limits.pullback.fst f z)) := by
    rintro ⟨p⟩ V
    haveI := hinit.out V
    obtain ⟨c⟩ : Nonempty (CostructuredArrow W' V) := inferInstance
    have hψa : (φ c.left ≫ c.hom.right.left) ≫ V.right.hom = a := by
      rw [Category.assoc, MorphismProperty.Over.w c.hom.right]
      exact hφa c.left
    have hfz : f (a (Limits.pullback.fst (a ≫ f) z p)) = z (Limits.pullback.snd (a ≫ f) z p) := by
      have h0 := congrArg (fun g => g p) (Limits.pullback.condition (f := a ≫ f) (g := z))
      simp only [Scheme.Hom.comp_apply] at h0
      exact h0
    obtain ⟨y, hy1, -⟩ := Scheme.Pullback.exists_preimage_pullback (f := f) (g := z)
      (a (Limits.pullback.fst (a ≫ f) z p)) (Limits.pullback.snd (a ≫ f) z p) hfz
    have hψ : V.right.hom ((φ c.left ≫ c.hom.right.left) (Limits.pullback.fst (a ≫ f) z p)) =
        Limits.pullback.fst f z y := by
      rw [hy1, ← Scheme.Hom.comp_apply, hψa]
    obtain ⟨o, -, -⟩ := Scheme.Pullback.exists_preimage_pullback
      ((φ c.left ≫ c.hom.right.left) (Limits.pullback.fst (a ≫ f) z p)) y hψ
    exact ⟨o⟩

  have locbij : ∀ (S : Scheme.{u}) (n : ℕ),
      ∃ α : (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing S n).obj,
        Presheaf.IsLocallyInjective (Scheme.smallEtaleTopology S) α ∧
        Presheaf.IsLocallySurjective (Scheme.smallEtaleTopology S) α := by
    intro S n
    let P : (S.Etale)ᵒᵖ ⥤ RingCat.{u+1} :=
      (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n)))
    exact ⟨toSheafify (Scheme.smallEtaleTopology S) P,
      Presheaf.isLocallyInjective_toSheafify' (Scheme.smallEtaleTopology S) P,
      Presheaf.isLocallySurjective_toSheafify' (Scheme.smallEtaleTopology S) P⟩
  have covsurjE : ∀ (S : Scheme.{u}) (V : S.Etale) (R : Sieve V),
      R ∈ Scheme.smallEtaleTopology S V → ∀ v : V.left,
      ∃ (Y' : S.Etale) (f' : Y' ⟶ V) (y' : Y'.left), R.arrows f' ∧ Etale f'.left ∧ f'.left y' = v := by
    intro S V R h v
    haveI : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
      MorphismProperty.IsMultiplicative.toIsStableUnderComposition
    have e := Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
      (P := (@Etale : MorphismProperty Scheme.{u})) (Q := (@Etale : MorphismProperty Scheme.{u})) S le_rfl
    have h' := (Scheme.mem_toGrothendieck_smallPretopology (P := @Etale) (Q := @Etale) V R).mp (e ▸ h)
    exact h' v
  have twist : ∀ {S T : Scheme.{u}} {j : T ⟶ S} {n : ℕ} (E : wcEtPullData j n),
      ∃ e : SheafOfModules.unit (wcEtZModRing T n) ⟶ SheafOfModules.unit (wcEtZModRing T n),
        wcEtSuppUnitMap E ≫ (@SheafOfModules.pushforward _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ).map e
          = @SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ := by
    intro S T j n E
    refine ⟨E.μ.inv ≫ (E.adj.homEquiv _ _).symm
      (@SheafOfModules.unitToPushforwardObjUnit _ _ _ _ _ _ (wcEtBaseChange j) _ _ E.cont E.φ), ?_⟩
    dsimp only [wcEtSuppUnitMap, wcEtSuppObj]
    rw [Category.assoc, ← Functor.map_comp, Iso.hom_inv_id_assoc,
      ← Adjunction.homEquiv_unit, Equiv.apply_symm_apply]
  have intcast_eq : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale)
      (α : (Functor.const (S.Etale)ᵒᵖ).obj (RingCat.of (ULift.{u+1} (ZMod n))) ⟶ (wcEtZModRing S n).obj)
      (c : ULift.{u+1} (ZMod n)),
      (α.app (Opposite.op V)).hom c = (((c.down.cast : ℤ)) : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) := by
    intro S n V α c
    have hc : c = (((c.down.cast : ℤ)) : ULift.{u+1} (ZMod n)) := by
      apply ULift.ext
      rw [ULift.down_intCast, ZMod.intCast_zmod_cast]
    conv_lhs => rw [hc]
    exact map_intCast (α.app (Opposite.op V)).hom _
  have intzero : ∀ (S : Scheme.{u}) (n : ℕ) (V : S.Etale) (k : ℤ),
      (k : ↑((wcEtZModRing S n).obj.obj (Opposite.op V))) = 0 → (k : ZMod n) = 0 ∨ IsEmpty V.left := by
    intro S n V k hk
    by_cases hV : IsEmpty V.left
    · exact Or.inr hV
    · left
      obtain ⟨v⟩ := not_isEmpty_iff.mp hV
      obtain ⟨α, hinj, hsurj⟩ := locbij S n
      have h1 : (α.app (Opposite.op V)).hom ((k : ULift.{u+1} (ZMod n))) =
          (α.app (Opposite.op V)).hom (0 : ULift.{u+1} (ZMod n)) := by
        rw [map_intCast, map_zero]; exact hk
      have hmem := Presheaf.equalizerSieve_mem (Scheme.smallEtaleTopology S) α _ _ h1
      obtain ⟨Q, g, _, hg, _, _⟩ := covsurjE S V _ hmem v
      have h2 : ((k : ULift.{u+1} (ZMod n))) = 0 := hg
      have h3 := congrArg ULift.down h2
      rw [ULift.down_intCast] at h3
      exact h3

  have hcof : IsCofiltered (StructuredArrow (Over.mk (wcEtGeomPt Y x)) (Scheme.Etale.forget Y)) :=
    wc_et_geomstalk_cofiltered Y x (@fun P E S e _ a₁ b₁ h Ω₁ _ π hπ =>
      @wc_etale_maps_agree_near_geom_point P E S e _ a₁ b₁ h Ω₁ _ π hπ)
