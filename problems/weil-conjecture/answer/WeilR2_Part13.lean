  have key : θ₁.hom ≫ θ₂.hom ≫ θ₃.hom ≫ a3 ≫ wcHalA1Proj (c ≫ sA) =
      at' ≫ Limits.pullback.snd (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c := by
