              Limits.pullback.snd (E.obj l').hom k) := Category.assoc _ _ _
        _ = π'' l ≫ Limits.pullback.snd (E.obj l).hom k := whisker_eq _ (M2 t)
        _ = Limits.pullback.snd U.hom hP ≫ kP := P2 l
