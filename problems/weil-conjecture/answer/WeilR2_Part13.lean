theorem wc_epsInv_limit_inj : ∀ (S : Scheme.{u}), ∀ (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (W : S.ProEt) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (a : ∀ l, W ⟶ (wcEtToProEt S).obj (D.obj l)), (∀ {l l' : Λ} (t : l ⟶ l'), a l ≫ (wcEtToProEt S).map (D.map t) = a l') → (∀ l, CompactSpace (D.obj l).left) → (∀ l, QuasiSeparatedSpace (D.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → (∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! h : Z ⟶ W.left, ∀ l, h ≫ (a l).left = z l) → ∀ (l : Λ) (x : G.obj.obj (Opposite.op (D.obj l))), (((wcEpsInv S).obj G).obj.map (a l).op).hom (((toSheafify (Scheme.ProEt.topology S) ((wcEtToProEt S).op.lan.obj G.obj)).app (Opposite.op ((wcEtToProEt S).obj (D.obj l)))).hom ((((wcEtToProEt S).op.lanUnit.app G.obj).app (Opposite.op (D.obj l))).hom x)) = 0 → ∃ (l' : Λ) (t : l' ⟶ l), (G.obj.map (D.map t).op).hom x = 0 :=
