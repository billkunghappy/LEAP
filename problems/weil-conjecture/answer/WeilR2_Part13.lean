  have hx0 : (((wcEtPush k).obj ((constantSheaf (Scheme.smallEtaleTopology P)
      AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))).obj.map
        (E.map t).op).hom x = 0 := by
