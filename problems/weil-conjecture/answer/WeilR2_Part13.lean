theorem wc_tvs_ns_subscheme {Z Y : Scheme.{u}} (h : Z ⟶ Y) [IsProper h] (NS : Set Z)
    (hNS : IsClosed NS) (z : Z) (hz : z ∈ NS) (y : Y) (e : h z = y)
    (hfib : ∀ x ∈ NS, h x = y → x = z)
    (W : Z.Opens) (hW : IsAffineOpen W) (hzW : z ∈ W) (r : ℕ) (ψ : Fin r → Γ(Z, W))
    (hψ : ∀ (x : Z) (hx : x ∈ W), x ∈ NS ↔
      ∀ j, (Z.presheaf.germ W x hx).hom (ψ j) ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk x)) :
    ∃ (U₀ : Y.Opens) (S : Scheme.{u}) (jS : S ⟶ Z) (s₀ : S) (ej : jS s₀ = z),
      y ∈ U₀ ∧ LocallyOfFiniteType (jS ≫ h) ∧ IsProper ((jS ≫ h) ∣_ U₀) ∧
      Set.range (jS ≫ h) = h '' NS ∩ (U₀ : Set Y) ∧ (∀ s, (jS ≫ h) s = y → s = s₀) ∧
      Function.Surjective (wcLdnmTvRho jS s₀ z ej) ∧
