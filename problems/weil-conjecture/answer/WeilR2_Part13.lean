      have hxb : x ∈ ι ⁻¹ᵁ wcSgD K N b := hb
      obtain ⟨f, g, hxf, hgE, -⟩ := qs10 K n X.left X.hom (ι ⁻¹ᵁ wcSgD K N b) (hVaff b) x hxb
