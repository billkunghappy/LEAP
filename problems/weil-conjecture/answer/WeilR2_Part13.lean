  haveI : IrreducibleSpace X.left :=
    GeometricallyIrreducible.geometrically_irreducibleSpace (f := X.hom) (𝟙 _) (𝟙 X.left) X.hom
      IsPullback.of_id_fst
  haveI : AlgebraicGeometry.IsIntegral X.left := isIntegral_of_irreducibleSpace_of_isReduced X.left

  have atlas : ∃ (m : ℕ) (b' : Fin m → Fin (N + 1)) (f' : ∀ j, Γ(X.left, ι ⁻¹ᵁ wcSgD K N (b' j))),
      (∀ j, (X.left.basicOpen (f' j) : Set X.left).Nonempty) ∧
      (∀ j, ∃ g : MvPolynomial (Fin n) K →+* Γ(X.left, X.left.basicOpen (f' j)), g.Etale ∧
        g.comp MvPolynomial.C =
          (X.left.presheaf.map (homOfLE (le_top : X.left.basicOpen (f' j) ≤ ⊤)).op).hom.comp
            (X.hom.appTop.hom.comp (Scheme.ΓSpecIso (.of K)).inv.hom)) ∧
      ∀ (b : Fin (N + 1)) (x : X.left), x ∈ ι ⁻¹ᵁ wcSgD K N b →
        ∃ j, b' j = b ∧ x ∈ X.left.basicOpen (f' j) := by
    have loc := fun (b : Fin (N + 1)) (x : ↥(ι ⁻¹ᵁ wcSgD K N b)) =>
      qs10 K n X.left X.hom (ι ⁻¹ᵁ wcSgD K N b) (hVaff b) x.1 x.2
    choose F G hxF hG hGC using loc
    have fin : ∀ b, ∃ T : Finset ↥(ι ⁻¹ᵁ wcSgD K N b),
        ((ι ⁻¹ᵁ wcSgD K N b : X.left.Opens) : Set X.left) ⊆
          ⋃ i ∈ T, (X.left.basicOpen (F b i) : Set X.left) := by
      intro b
      exact (hVaff b).isCompact.elim_finite_subcover (fun i => (X.left.basicOpen (F b i) : Set X.left))
        (fun i => (X.left.basicOpen (F b i)).isOpen)
        (fun y hy => Set.mem_iUnion.mpr ⟨⟨y, hy⟩, hxF b ⟨y, hy⟩⟩)
    choose T hT using fin
    let e := Fintype.equivFin (Σ b : Fin (N + 1), ↥(T b))
    refine ⟨Fintype.card (Σ b : Fin (N + 1), ↥(T b)), fun j => (e.symm j).1,
      fun j => F (e.symm j).1 (e.symm j).2.1, fun j => ⟨_, hxF _ _⟩,
      fun j => ⟨G _ _, hG _ _, hGC _ _⟩, ?_⟩
    intro b x hx
