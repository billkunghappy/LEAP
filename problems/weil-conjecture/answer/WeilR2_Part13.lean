  first
    | simpa using hnat.symm
    | (rw [op_id, CategoryTheory.Functor.map_id] at hnat; exact hnat.symm)

theorem wc_et_proetale_push_const_base_change : ∀ {Z S P P' : Scheme.{u}} [IsAffine Z] (p : Z ⟶ S) (k : P ⟶ S) [IsAffineHom k] (hP : P' ⟶ Z) (kP : P' ⟶ P), IsPullback hP kP p k → ∀ (Λ₀ : Type u) [SmallCategory Λ₀] [IsCofiltered Λ₀] (D : Λ₀ ⥤ S.Etale) (π : ∀ l, Z ⟶ (D.obj l).left), (∀ l, π l ≫ (D.obj l).hom = p) → (∀ {l l' : Λ₀} (t : l ⟶ l'), π l ≫ (D.map t).left = π l') → (∀ (T : Scheme.{u}) (w : ∀ l, T ⟶ (D.obj l).left), (∀ {l l' : Λ₀} (t : l ⟶ l'), w l ≫ (D.map t).left = w l') → ∃! w₀ : T ⟶ Z, ∀ l, w₀ ≫ π l = w l) → (∀ l, IsAffine (D.obj l).left) → (∀ {l l' : Λ₀} (t : l ⟶ l'), IsAffineHom (D.map t).left) → ∀ (m : ℕ) (L : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology Z) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush p) → Nonempty (L.obj ((wcEtPush k).obj ((constantSheaf (Scheme.smallEtaleTopology P) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) ≅ (wcEtPush hP).obj ((constantSheaf (Scheme.smallEtaleTopology P') AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m))))) :=
by
  classical
  intro Z S P P' _ p k _ hP kP hpb Λ₀ _ _ D π hπ hcomp hlim haff htr m L hadj
  set G := (wcEtPush k).obj ((constantSheaf (Scheme.smallEtaleTopology P)
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) with hGdef
  set H := (wcEtPush hP).obj ((constantSheaf (Scheme.smallEtaleTopology P')
    AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod m)))) with hHdef
  haveI hcont := wc_et_basechange_isContinuous p
  obtain ⟨ρ, hρU, -⟩ := wc_et_adjoint_univ_transport p L hadj
  obtain ⟨eG0, heG0⟩ := wc_fnp_push_const_sections_lc S P k m
  obtain ⟨eH0, heH0⟩ := wc_fnp_push_const_sections_lc Z P' hP m
  obtain ⟨eG, heG⟩ : ∃ e : ∀ V : S.Etale,
      G.obj.obj (Opposite.op V) ≃+ LocallyConstant ↥(Limits.pullback V.hom k) (ZMod m),
      ∀ (V V' : S.Etale) (g : V' ⟶ V) (s : G.obj.obj (Opposite.op V))
        (x : ↥(Limits.pullback V'.hom k)),
        e V' ((G.obj.map g.op).hom s) x = e V s (((wcEtBaseChange k).map g).left x) :=
    ⟨eG0, fun V V' g s x => heG0 V V' g s x⟩
  obtain ⟨eH, heH⟩ : ∃ e : ∀ O : Z.Etale,
      H.obj.obj (Opposite.op O) ≃+ LocallyConstant ↥(Limits.pullback O.hom hP) (ZMod m),
      ∀ (O O' : Z.Etale) (g : O' ⟶ O) (s : H.obj.obj (Opposite.op O))
        (x : ↥(Limits.pullback O'.hom hP)),
        e O' ((H.obj.map g.op).hom s) x = e O s (((wcEtBaseChange hP).map g).left x) :=
    ⟨eH0, fun O O' g s x => heH0 O O' g s x⟩

  have hbcf : ∀ {Y W : Scheme.{u}} (f : W ⟶ Y) {V V' : Y.Etale} (c : V' ⟶ V),
      ((wcEtBaseChange f).map c).left ≫ Limits.pullback.fst V.hom f =
        Limits.pullback.fst V'.hom f ≫ c.left := by
    intro Y W f V V' c
    first
      | exact Limits.pullback.lift_fst _ _ _
      | simp [wcEtBaseChange]
  have hbcs : ∀ {Y W : Scheme.{u}} (f : W ⟶ Y) {V V' : Y.Etale} (c : V' ⟶ V),
      ((wcEtBaseChange f).map c).left ≫ Limits.pullback.snd V.hom f =
        Limits.pullback.snd V'.hom f := by
    intro Y W f V V' c
    first
      | exact Limits.pullback.lift_snd _ _ _
      | exact (Limits.pullback.lift_snd _ _ _).trans (Category.comp_id _)
      | simp [wcEtBaseChange]

  obtain ⟨mz, hmz1, hmz2, hmzG⟩ : ∃ (mz : ∀ (V V' : S.Etale), (V' ⟶ V) →
        (Limits.pullback V'.hom k ⟶ Limits.pullback V.hom k)),
      (∀ (V V' : S.Etale) (c : V' ⟶ V),
        mz V V' c ≫ Limits.pullback.fst V.hom k = Limits.pullback.fst V'.hom k ≫ c.left) ∧
      (∀ (V V' : S.Etale) (c : V' ⟶ V),
        mz V V' c ≫ Limits.pullback.snd V.hom k = Limits.pullback.snd V'.hom k) ∧
      ∀ (V V' : S.Etale) (c : V' ⟶ V) (x : G.obj.obj (Opposite.op V))
        (q : ↥(Limits.pullback V'.hom k)),
        eG V' ((G.obj.map c.op).hom x) q = eG V x (mz V V' c q) :=
    ⟨fun V V' c => ((wcEtBaseChange k).map c).left, fun V V' c => hbcf k c,
      fun V V' c => hbcs k c, fun V V' c x q => heG V V' c x q⟩
  obtain ⟨mf, hmf1, hmf2, hmfH⟩ : ∃ (mf : ∀ (O O' : Z.Etale), (O' ⟶ O) →
        (Limits.pullback O'.hom hP ⟶ Limits.pullback O.hom hP)),
      (∀ (O O' : Z.Etale) (d : O' ⟶ O),
        mf O O' d ≫ Limits.pullback.fst O.hom hP = Limits.pullback.fst O'.hom hP ≫ d.left) ∧
      (∀ (O O' : Z.Etale) (d : O' ⟶ O),
        mf O O' d ≫ Limits.pullback.snd O.hom hP = Limits.pullback.snd O'.hom hP) ∧
      ∀ (O O' : Z.Etale) (d : O' ⟶ O) (y : H.obj.obj (Opposite.op O))
        (q : ↥(Limits.pullback O'.hom hP)),
        eH O' ((H.obj.map d.op).hom y) q = eH O y (mf O O' d q) :=
    ⟨fun O O' d => ((wcEtBaseChange hP).map d).left, fun O O' d => hbcf hP d,
      fun O O' d => hbcs hP d, fun O O' d y q => heH O O' d y q⟩

  obtain ⟨κ, hκ1, hκ2⟩ : ∃ κ : ∀ (V : S.Etale) (O : Z.Etale)
      (h : O.left ⟶ V.left), h ≫ V.hom = O.hom ≫ p →
        (Limits.pullback O.hom hP ⟶ Limits.pullback V.hom k),
      (∀ (V : S.Etale) (O : Z.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ p),
        κ V O h hh ≫ Limits.pullback.fst V.hom k = Limits.pullback.fst O.hom hP ≫ h) ∧
      (∀ (V : S.Etale) (O : Z.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ p),
        κ V O h hh ≫ Limits.pullback.snd V.hom k = Limits.pullback.snd O.hom hP ≫ kP) :=
    ⟨fun V O h hh => Limits.pullback.lift
        (Limits.pullback.fst O.hom hP ≫ h) (Limits.pullback.snd O.hom hP ≫ kP)
        (by
          first
            | (simp only [Category.assoc, hh, Limits.pullback.condition_assoc, hpb.w])
            | (rw [Category.assoc, hh, Limits.pullback.condition_assoc, hpb.w, Category.assoc])),
      fun _ _ _ _ => Limits.pullback.lift_fst _ _ _,
      fun _ _ _ _ => Limits.pullback.lift_snd _ _ _⟩
  obtain ⟨κc, hκc⟩ : ∃ κc : ∀ (V : S.Etale) (O : Z.Etale)
      (h : O.left ⟶ V.left), h ≫ V.hom = O.hom ≫ p →
        C(↥(Limits.pullback O.hom hP), ↥(Limits.pullback V.hom k)),
      ∀ (V : S.Etale) (O : Z.Etale) (h : O.left ⟶ V.left)
        (hh : h ≫ V.hom = O.hom ≫ p) (q : ↥(Limits.pullback O.hom hP)),
        κc V O h hh q = κ V O h hh q :=
    ⟨fun V O h hh => ⟨fun q => κ V O h hh q, (κ V O h hh).continuous⟩,
      fun _ _ _ _ _ => rfl⟩

  have hκnat : ∀ (V V' : S.Etale) (c : V' ⟶ V) (O O' : Z.Etale)
      (d : O' ⟶ O) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ p)
      (h' : O'.left ⟶ V'.left) (hh' : h' ≫ V'.hom = O'.hom ≫ p),
      h' ≫ c.left = d.left ≫ h →
        mf O O' d ≫ κ V O h hh = κ V' O' h' hh' ≫ mz V V' c := by
    intro V V' c O O' d h hh h' hh' hc
    apply Limits.pullback.hom_ext
    · first
        | (simp only [Category.assoc, hκ1, hmz1, reassoc_of% (hmf1 O O' d),
            reassoc_of% (hκ1 V' O' h' hh'), hc]; done)
        | (simp only [Category.assoc, hκ1, hmz1, reassoc_of% (hmf1 O O' d),
            reassoc_of% (hκ1 V' O' h' hh')]; rw [hc])
        | (rw [Category.assoc, Category.assoc, hκ1, hmz1, ← Category.assoc, hmf1,
            ← Category.assoc, hκ1, Category.assoc, Category.assoc, hc])
    · first
        | (simp only [Category.assoc, hκ2, hmz2, reassoc_of% (hmf2 O O' d)])
        | (rw [Category.assoc, Category.assoc, hκ2, hmz2, hκ2, ← Category.assoc, hmf2])
  have hpt : ∀ (V V' : S.Etale) (c : V' ⟶ V) (O O' : Z.Etale)
      (d : O' ⟶ O) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ p)
      (h' : O'.left ⟶ V'.left) (hh' : h' ≫ V'.hom = O'.hom ≫ p),
      h' ≫ c.left = d.left ≫ h →
        ∀ q, mz V V' c (κ V' O' h' hh' q) = κ V O h hh (mf O O' d q) := by
    intro V V' c O O' d h hh h' hh' hc q
    have e := hκnat V V' c O O' d h hh h' hh' hc
    first
      | (rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply, e])
      | exact (congrArg (fun φ : Limits.pullback O'.hom hP ⟶ Limits.pullback V.hom k =>
          φ q) e).symm

  obtain ⟨ρ', hρ'⟩ : ∃ ρ' : ∀ (V : S.Etale) (O : Z.Etale)
      (h : O.left ⟶ V.left), h ≫ V.hom = O.hom ≫ p →
        (G.obj.obj (Opposite.op V) →+ H.obj.obj (Opposite.op O)),
      ∀ (V : S.Etale) (O : Z.Etale) (h : O.left ⟶ V.left)
        (hh : h ≫ V.hom = O.hom ≫ p) (x : G.obj.obj (Opposite.op V)),
        ρ' V O h hh x = (eH O).symm (LocallyConstant.comap (κc V O h hh) (eG V x)) :=
    ⟨fun V O h hh => (eH O).symm.toAddMonoidHom.comp
        ((LocallyConstant.comapAddMonoidHom (κc V O h hh)).comp (eG V).toAddMonoidHom),
      fun _ _ _ _ _ => rfl⟩
  obtain ⟨σ, hσ⟩ : ∃ σ : wcEtTransport p G H, σ.ρ = ρ' :=
    ⟨{ ρ := ρ'
       nat := by
        intro V V' c O O' d h hh h' hh' hc x
        rw [hρ', hρ']
        apply (eH O').injective
        rw [AddEquiv.apply_symm_apply]
        ext q
        rw [LocallyConstant.coe_comap_apply, hκc]
        refine Eq.trans ?_ (hmfH O O' d _ q).symm
        rw [AddEquiv.apply_symm_apply, LocallyConstant.coe_comap_apply, hκc]
        refine (hmzG V V' c x _).trans ?_
        exact congrArg (eG V x) (hpt V V' c O O' d h hh h' hh' hc q) }, rfl⟩

  obtain ⟨β, hβ, -⟩ := hρU G H σ

  have hβ' : ∀ (V : S.Etale) (O : Z.Etale) (h : O.left ⟶ V.left) (hh : h ≫ V.hom = O.hom ≫ p)
      (x : G.obj.obj (Opposite.op V)) (κ' : Limits.pullback O.hom hP ⟶ Limits.pullback V.hom k),
      κ' ≫ Limits.pullback.fst V.hom k = Limits.pullback.fst O.hom hP ≫ h →
      κ' ≫ Limits.pullback.snd V.hom k = Limits.pullback.snd O.hom hP ≫ kP →
      ∀ q : ↥(Limits.pullback O.hom hP),
        eH O ((β.hom.app (Opposite.op O)).hom ((ρ G).ρ V O h hh x)) q = eG V x (κ' q) := by
    intro V O h hh x κ' h1 h2 q
    have hk : κ' = κ V O h hh :=
      Limits.pullback.hom_ext (h1.trans (hκ1 V O h hh).symm) (h2.trans (hκ2 V O h hh).symm)
    subst hk
    rw [hβ, hσ, hρ', AddEquiv.apply_symm_apply, LocallyConstant.coe_comap_apply, hκc]
  haveI : IsIso β := wc_et_isIso_of_local_bijective β (fun O o => by
    obtain ⟨O₁, c, o₁, I, iI, hI, E, πE, hc, hO₁, hπE, hcompE, hlimE, haffE, htrE⟩ :=
      wc_et_proetale_nbhd_presentation p Λ₀ D π hπ hcomp hlim haff htr O o
    exact ⟨O₁, c, o₁, hc,
      wc_et_proetale_push_lc_inj_std p k hP kP hpb m (L.obj G) (ρ G) (hρU G) eG heG eH β hβ'
        O₁ hO₁ I E πE hπE hcompE hlimE haffE htrE,
      wc_et_proetale_push_lc_surj_std p k hP kP hpb m (L.obj G) (ρ G) (hρU G) eG heG eH β hβ'
        O₁ hO₁ I E πE hπE hcompE hlimE haffE htrE⟩)
  exact ⟨asIso β⟩

theorem wc_affine_line_shens_tube_push_base_change : ∀ (K : Type u) [Field K] [IsAlgClosed K] (ℓ : ℕ), ℓ.Prime → (ℓ : K) ≠ 0 → ∀ (A : Type u) [CommRing A] [HenselianLocalRing A] [IsSepClosed (IsLocalRing.ResidueField A)] (sA : Spec (.of A) ⟶ Spec (.of K)) (x : Spec (.of (Polynomial A))), Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A))) x = IsLocalRing.closedPoint A → ∀ (B : Type u) [CommRing B] [HenselianLocalRing B] [IsSepClosed (IsLocalRing.ResidueField B)] (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (W' : Λ ⥤ StructuredArrow (Over.mk (wcEtGeomPt (Spec (.of (Polynomial A))) x)) (Scheme.Etale.forget (Spec (.of (Polynomial A))))) (φ : ∀ l, Spec (.of B) ⟶ (W'.obj l).right.left) (a : Spec (.of B) ⟶ Spec (.of (Polynomial A))), wcHalShData x B Λ W' φ a → ∀ (C : Type u) [CommRing C] [HenselianLocalRing C] [IsSepClosed (IsLocalRing.ResidueField C)] (c : Spec (.of C) ⟶ Spec (.of A)) (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (z : Spec (.of Ω) ⟶ Spec (.of C)) (L : Sheaf (Scheme.smallEtaleTopology (Spec (.of C))) AddCommGrpCat.{u+1} ⥤ Sheaf (Scheme.smallEtaleTopology (Limits.pullback (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c)) AddCommGrpCat.{u+1}), Nonempty (L ⊣ wcEtPush (Limits.pullback.snd (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c)) → Nonempty (L.obj ((wcEtPush z).obj ((constantSheaf (Scheme.smallEtaleTopology (Spec (.of Ω))) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) ≅ (wcEtPush (Limits.pullback.fst (Limits.pullback.snd (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c) z)).obj ((constantSheaf (Scheme.smallEtaleTopology (Limits.pullback (Limits.pullback.snd (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c) z)) AddCommGrpCat.{u+1}).obj (AddCommGrpCat.of (ULift.{u+1} (ZMod ℓ))))) :=
by
  intro K _ _ ℓ hℓ hℓK A _ _ _ sA x hx B _ _ _ Λ _ _ W' φ a hd C _ _ _ c Ω _ _ z L hL
  obtain ⟨adj⟩ := hL

  obtain ⟨ρ, Λ₀, _, _, D, π, hρ, hπ, hcomp, hlim, haff, htr⟩ :=
    wc_tube_A1C_proetale_presentation K A sA x B Λ W' φ a hd C c

  obtain ⟨Lρ, ⟨aρ⟩, -, -⟩ := wc_et_push_left_adjoint ρ
  obtain ⟨Lpr, ⟨apr⟩, -, -⟩ := wc_et_push_left_adjoint (wcHalA1Proj (c ≫ sA))
  obtain ⟨-, ⟨e⟩⟩ := wc_et_push_id_comp_iso ρ (wcHalA1Proj (c ≫ sA))
  have adj2 : Lpr ⋙ Lρ ⊣ wcEtPush (Limits.pullback.snd
      (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c) :=
    (apr.comp aρ).ofNatIsoRight (e ≪≫ eqToIso (congrArg (fun f => wcEtPush f) hρ))

  obtain ⟨i₁⟩ := wc_hal_geom_push_base_change K ℓ hℓ hℓK (by
      intro A' _ _ _ s x' hcl hx' B' _ _ _ Λ' _ _ W'' φ' a' hd' Ω' _ _ z'
      refine ⟨wc_et_milnor_fibre_connected K ℓ hℓ hℓK A' s x' hcl hx' B' Λ' W'' φ' a' hd' Ω' z',
        fun q hq => ?_⟩
      rcases Nat.lt_or_ge q 2 with h | h
      · obtain rfl : q = 1 := by omega
        exact wc_et_milnor_fibre_h1_vanishing K ℓ hℓ hℓK A' s x' hcl hx' B' Λ' W'' φ' a' hd' Ω' z'
      · exact wc_et_milnor_fibre_cd_one K ℓ hℓ hℓK A' s x' hcl hx' B' Λ' W'' φ' a' hd' Ω' z' q h)
    C (c ≫ sA) Lpr ⟨apr⟩ Ω z

  have w : (Limits.pullback.fst (Limits.pullback.snd
      (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c) z ≫ ρ) ≫
      wcHalA1Proj (c ≫ sA) = Limits.pullback.snd (Limits.pullback.snd
      (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c) z ≫ z := by
    rw [Category.assoc, hρ, Limits.pullback.condition]
  have outer : IsPullback
      (Limits.pullback.fst (Limits.pullback.snd
        (a ≫ Spec.map (CommRingCat.ofHom (algebraMap A (Polynomial A)))) c) z)
      (Limits.pullback.lift _ _ w ≫ Limits.pullback.snd (wcHalA1Proj (c ≫ sA)) z)
      (ρ ≫ wcHalA1Proj (c ≫ sA)) z := by
    rw [Limits.pullback.lift_snd, hρ]
