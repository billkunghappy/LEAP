      map_comp := fun t t' => by
        first
          | (rw [CategoryTheory.Functor.map_comp]; exact MorphismProperty.Comma.comp_left _ _)
          | (rw [CategoryTheory.Functor.map_comp]; rfl)
          | (erw [CategoryTheory.Functor.map_comp]; rfl)
