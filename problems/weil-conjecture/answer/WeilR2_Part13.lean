    IsPullback.paste_horiz (IsPullback.of_hasPullback U.hom hP).flip hpb.flip
  have hw : (Limits.pullback.snd U.hom hP ≫ kP) ≫ k = Limits.pullback.fst U.hom hP ≫ (U.hom ≫ p) :=
    sq.w
  have M1 : ∀ {l l' : I} (t : l ⟶ l'),
      ((E ⋙ wcEtBaseChange k).map t).left ≫ Limits.pullback.fst (E.obj l').hom k =
