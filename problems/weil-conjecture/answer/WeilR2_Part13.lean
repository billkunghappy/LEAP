    exact (congrArg a (hqBpt _)).symm.trans h2
  obtain ⟨ιy, hιy⟩ := wc_geomPt_down_comparison (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin d) A →ₐ[A] MvPolynomial (Fin (d + 1)) A).toRingHom)) x
  obtain ⟨β, hβa, hβq⟩ := wc_cmp (Spec.map (CommRingCat.ofHom (MvPolynomial.rename Fin.succ : MvPolynomial (Fin d) A →ₐ[A] MvPolynomial (Fin (d + 1)) A).toRingHom)) _ x ιy hιy
    B' Λ' W'' φ' a' hd' e₁ he₁ B Λ W' φ a hd eB heB
  have hβpt : β (IsLocalRing.closedPoint B) = IsLocalRing.closedPoint B' := by
    have e1 : qB ≫ β = ιy ≫ Spec.map (CommRingCat.ofHom e₁) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B')) := by
      rw [hqB, Category.assoc, hβq]
    have h1 := happ _ _ e1 (IsLocalRing.closedPoint
      (AlgebraicClosure ((Spec (.of (MvPolynomial (Fin (d + 1)) A))).residueField x)))
    have h2 := (Scheme.Hom.comp_apply qB β _).symm.trans (h1.trans
      ((Scheme.Hom.comp_apply _ _ _).trans (Scheme.Hom.comp_apply _ _ _)))
    exact ((congrArg β (hqBpt _)).symm.trans h2).trans (hres_pt B' _)
  obtain ⟨ã, hãρ, hãpr⟩ := hex B β a hβa
  have hprx : pr (ã (IsLocalRing.closedPoint B)) = x := by
    have h1 := happ _ _ hãpr (IsLocalRing.closedPoint B)
    exact ((Scheme.Hom.comp_apply ã pr _).symm.trans h1).trans haB
  have hρx : Spec.map (CommRingCat.ofHom (algebraMap B' (Polynomial B')))
      (ã (IsLocalRing.closedPoint B)) = IsLocalRing.closedPoint B' := by
    have h1 := happ _ _ hãρ (IsLocalRing.closedPoint B)
    exact ((Scheme.Hom.comp_apply ã _ _).symm.trans h1).trans hβpt
  have htpt : (qB ≫ ã) (IsLocalRing.closedPoint
      (AlgebraicClosure ((Spec (.of (MvPolynomial (Fin (d + 1)) A))).residueField x))) =
      ã (IsLocalRing.closedPoint B) :=
    (Scheme.Hom.comp_apply qB ã _).trans (congrArg ã (hqBpt _))
  have htpr : (qB ≫ ã) ≫ pr = wcEtGeomPt (Spec (.of (MvPolynomial (Fin (d + 1)) A))) x := by
    rw [Category.assoc, hãpr, hqBa]
  obtain ⟨j, hj⟩ := wc_geomPt_rebase_lift pr x (ã (IsLocalRing.closedPoint B)) hprx (qB ≫ ã) htpt htpr
  have hjgeom : j ≫ wcEtGeomPt (Spec (.of (MvPolynomial (Fin (d + 1)) A))) x =
      wcEtGeomPt (Spec (.of (Polynomial B'))) (ã (IsLocalRing.closedPoint B)) ≫ pr := by
    rw [← hj, ← hqBa, ← hãpr]
    simp only [Category.assoc]
  have hqpt : (j ≫ qB) (IsLocalRing.closedPoint
      (AlgebraicClosure ((Spec (.of (Polynomial B'))).residueField (ã (IsLocalRing.closedPoint B))))) =
      IsLocalRing.closedPoint B :=
    (Scheme.Hom.comp_apply j qB _).trans (hqBpt _)
  have hqã : (j ≫ qB) ≫ ã = wcEtGeomPt (Spec (.of (Polynomial B'))) (ã (IsLocalRing.closedPoint B)) := by
    rw [Category.assoc]
    exact hj
  refine ⟨ã, ?_, hρx, ?_⟩
  · rw [← Category.assoc, hãρ, ← Category.assoc, hβa, Category.assoc, hρ]
  intro B₂ _ _ _ Λ₂ _ _ W₂ φ₂ a₂ hd₂
  obtain ⟨e₂, he₂⟩ := wc_norm (ã (IsLocalRing.closedPoint B)) B₂ Λ₂ W₂ φ₂ a₂ hd₂
  obtain ⟨q₂, hq₂⟩ : ∃ q₂ : Spec (.of (AlgebraicClosure
      ((Spec (.of (Polynomial B'))).residueField (ã (IsLocalRing.closedPoint B))))) ⟶ Spec (.of B₂),
      q₂ = Spec.map (CommRingCat.ofHom e₂) ≫
        Spec.map (CommRingCat.ofHom (IsLocalRing.residue B₂)) := ⟨_, rfl⟩
  have hq₂φ : ∀ l, q₂ ≫ φ₂ l = (W₂.obj l).hom.left := by
    intro l
    rw [hq₂, Category.assoc]
    exact he₂ l
  have hq₂pt : q₂ (IsLocalRing.closedPoint
      (AlgebraicClosure ((Spec (.of (Polynomial B'))).residueField (ã (IsLocalRing.closedPoint B))))) =
      IsLocalRing.closedPoint B₂ := by
    rw [hq₂]
    exact hpt_gen B₂ _ e₂ _
  have hq₂a : q₂ ≫ a₂ = wcEtGeomPt (Spec (.of (Polynomial B'))) (ã (IsLocalRing.closedPoint B)) :=
    hnorm_a (ã (IsLocalRing.closedPoint B)) B₂ Λ₂ W₂ φ₂ a₂ hd₂ q₂ hq₂φ
  obtain ⟨δ, hδa, hδφ⟩ := wc_lift (ã (IsLocalRing.closedPoint B))
    B₂ Λ₂ W₂ φ₂ a₂ hd₂ B ã (j ≫ qB) hqpt hqã
  obtain ⟨ε, hεa, hεq⟩ := wc_cmp pr x (ã (IsLocalRing.closedPoint B)) j hjgeom
    B Λ W' φ a hd eB (by rw [← Category.assoc, ← hqB]; exact hqBa) B₂ Λ₂ W₂ φ₂ a₂ hd₂ e₂ he₂
  have hq₂ε : q₂ ≫ ε = j ≫ qB := by
    rw [hq₂, Category.assoc, hεq, hqB]
  have hqδ : (j ≫ qB) ≫ δ = q₂ := by
    obtain ⟨-, -, -, -, hlim₂, -⟩ := id hd₂
    have hcompat₂ : ∀ {l l' : Λ₂} (t : l ⟶ l'),
        (W₂.obj l).hom.left ≫ (W₂.map t).right.left = (W₂.obj l').hom.left := fun t =>
      congrArg (fun f => f.left) (StructuredArrow.w (W₂.map t))
    exact (hlim₂ _ (fun l => (W₂.obj l).hom.left) hcompat₂).unique
      (fun l => by simpa only [Category.assoc] using hδφ l) hq₂φ
  have hδε : δ ≫ ε = 𝟙 _ := by
    apply wc_hom_ext x B Λ W' φ a hd B (δ ≫ ε) (𝟙 _) _ (j ≫ qB) hqpt
    · rw [Category.assoc, hεa, ← Category.assoc, hδa, hãpr, Category.id_comp]
    · rw [← Category.assoc, hqδ, hq₂ε, Category.comp_id]
  have hεβ : ε ≫ β = a₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap B' (Polynomial B'))) := by
    apply wc_hom_ext _ B' Λ' W'' φ' a' hd' B₂ (ε ≫ β)
      (a₂ ≫ Spec.map (CommRingCat.ofHom (algebraMap B' (Polynomial B')))) _ q₂ hq₂pt
    · simp only [Category.assoc]
      rw [hβa, ← Category.assoc ε, hεa, Category.assoc, hpr]
    · have h1 : (q₂ ≫ ε) ≫ β = (q₂ ≫ a₂) ≫
          Spec.map (CommRingCat.ofHom (algebraMap B' (Polynomial B'))) := by
        rw [hq₂ε, hq₂a, ← hãρ, ← hqã]
        simp only [Category.assoc]
      simpa only [Category.assoc] using h1
  have hεã : ε ≫ ã = a₂ :=
    huniq B₂ (ε ≫ ã) a₂ (by rw [Category.assoc, hãρ, hεβ]) (by rw [Category.assoc, hãpr, hεa])
  have hεδ : ε ≫ δ = 𝟙 _ := by
    apply wc_hom_ext (ã (IsLocalRing.closedPoint B)) B₂ Λ₂ W₂ φ₂ a₂ hd₂ B₂ (ε ≫ δ)
      (𝟙 _) _ q₂ hq₂pt
    · rw [Category.assoc, hδa, hεã, Category.id_comp]
    · rw [← Category.assoc, hq₂ε, hqδ, Category.comp_id]
  refine ⟨⟨δ, ε, hδε, hεδ⟩, ?_⟩
  show δ ≫ a₂ = ã
  exact hδa

theorem wc_ext_bij_of_ker_coker_acyclic : ∀ {C : Type*} [Category C] [Abelian C] [HasExt C] (P G F : C) (φ : G ⟶ F), (∀ n : ℕ, Subsingleton (Abelian.Ext P (Limits.kernel φ) n)) → (∀ n : ℕ, Subsingleton (Abelian.Ext P (Limits.cokernel φ) n)) → ∀ n : ℕ, Nonempty (Abelian.Ext P G n ≃ Abelian.Ext P F n) :=
by
  intro C _ _ _ P G F φ hK hQ n
  have s1 : ∀ (S : ShortComplex C), S.ShortExact → (∀ n : ℕ, Subsingleton (Abelian.Ext P S.X₁ n)) →
      ∀ n : ℕ, Nonempty (Abelian.Ext P S.X₂ n ≃ Abelian.Ext P S.X₃ n) := by
    intro S hS h1 n
    refine ⟨Equiv.ofBijective ((Abelian.Ext.mk₀ S.g).postcomp P (add_zero n)) ⟨?_, ?_⟩⟩
    · rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS x hx
      rw [← hx₁, Subsingleton.elim x₁ 0, Abelian.Ext.zero_comp]
    · intro x₃
      obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ P hS x₃ rfl (Subsingleton.elim _ _)
      exact ⟨x₂, hx₂⟩
  have s2 : ∀ (S : ShortComplex C), S.ShortExact → (∀ n : ℕ, Subsingleton (Abelian.Ext P S.X₃ n)) →
      ∀ n : ℕ, Nonempty (Abelian.Ext P S.X₁ n ≃ Abelian.Ext P S.X₂ n) := by
    intro S hS h3 n
    haveI := hS.mono_f
    refine ⟨Equiv.ofBijective ((Abelian.Ext.mk₀ S.f).postcomp P (add_zero n)) ⟨?_, ?_⟩⟩
    · rw [injective_iff_map_eq_zero]
      intro x hx
      cases n with
      | zero =>
        obtain ⟨a, rfl⟩ := (Abelian.Ext.mk₀_bijective P S.X₁).2 x
        have h0 : a ≫ S.f = 0 := by
          apply (Abelian.Ext.mk₀_bijective P S.X₂).1
          rw [Abelian.Ext.mk₀_zero, ← Abelian.Ext.mk₀_comp_mk₀]
          exact hx
        have ha : a = 0 := by
          rw [← cancel_mono S.f, h0, Limits.zero_comp]
        rw [ha, Abelian.Ext.mk₀_zero]
      | succ k =>
        obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ P hS x hx rfl
        rw [← hx₃, Subsingleton.elim x₃ 0, Abelian.Ext.zero_comp]
    · intro x₂
      obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ P hS x₂ (Subsingleton.elim _ _)
      exact ⟨x₁, hx₁⟩
  have hfac : Limits.factorThruImage φ ≫ Limits.image.ι φ = φ := Limits.image.fac φ
  have w₁ : Limits.kernel.ι φ ≫ Limits.factorThruImage φ = 0 := by
    rw [← cancel_mono (Limits.image.ι φ), Category.assoc, hfac, Limits.kernel.condition,
      Limits.zero_comp]
  have w₂ : Limits.image.ι φ ≫ Limits.cokernel.π φ = 0 := by
    rw [← cancel_epi (Limits.factorThruImage φ), ← Category.assoc, hfac, Limits.cokernel.condition,
      Limits.comp_zero]
  have h₁ : (ShortComplex.mk _ _ w₁).ShortExact := by
    have hT : (ShortComplex.mk _ _ (Limits.kernel.condition φ)).Exact := ShortComplex.exact_kernel φ
    let m : ShortComplex.mk _ _ w₁ ⟶ ShortComplex.mk _ _ (Limits.kernel.condition φ) :=
      { τ₁ := 𝟙 _, τ₂ := 𝟙 _, τ₃ := Limits.image.ι φ
        comm₁₂ := by simp
        comm₂₃ := by simp [hfac] }
    haveI : Epi m.τ₁ := by change Epi (𝟙 _); infer_instance
    haveI : IsIso m.τ₂ := by change IsIso (𝟙 _); infer_instance
    haveI : Mono m.τ₃ := by change Mono (Limits.image.ι φ); infer_instance
    exact ShortComplex.ShortExact.mk' ((ShortComplex.exact_iff_of_epi_of_isIso_of_mono m).mpr hT)
      (by dsimp; infer_instance) (by dsimp; infer_instance)
  have h₂ : (ShortComplex.mk _ _ w₂).ShortExact := by
    have hT : (ShortComplex.mk _ _ (Limits.cokernel.condition φ)).Exact :=
      ShortComplex.exact_cokernel φ
    let m : ShortComplex.mk _ _ (Limits.cokernel.condition φ) ⟶ ShortComplex.mk _ _ w₂ :=
      { τ₁ := Limits.factorThruImage φ, τ₂ := 𝟙 _, τ₃ := 𝟙 _
        comm₁₂ := by simp [hfac]
        comm₂₃ := by simp }
    haveI : Epi m.τ₁ := by change Epi (Limits.factorThruImage φ); infer_instance
    haveI : IsIso m.τ₂ := by change IsIso (𝟙 _); infer_instance
    haveI : Mono m.τ₃ := by change Mono (𝟙 _); infer_instance
    exact ShortComplex.ShortExact.mk' ((ShortComplex.exact_iff_of_epi_of_isIso_of_mono m).mp hT)
      (by dsimp; infer_instance) (by dsimp; infer_instance)
  obtain ⟨e₁⟩ := s1 _ h₁ hK n
  obtain ⟨e₂⟩ := s2 _ h₂ hQ n
  exact ⟨e₁.trans e₂⟩

theorem wc_ext_leray_equiv_of_higher_ext_vanish : ∀ {C : Type*} {D : Type*} [Category C] [Category D] [Abelian C] [Abelian D] (L : D ⥤ C) (R : C ⥤ D) [R.Additive] (adj : L ⊣ R) [Limits.PreservesFiniteLimits L] (P : D) (A : C) (I : InjectiveResolution A), letI := HasExt.standard C; letI := HasExt.standard D; (∀ q : ℕ, 1 ≤ q → ∀ p : ℕ, Subsingleton (Abelian.Ext P (((R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex).homology q) p)) → ∀ p : ℕ, Nonempty (Abelian.Ext P (R.obj A) p ≃ Abelian.Ext (L.obj P) A p) :=
by
  intro C D _ _ _ _ L R _ adj _ P A I
  try dsimp only
  intro H p
  letI instC : HasExt C := HasExt.standard C
  letI instD : HasExt D := HasExt.standard D

  haveI : L.PreservesMonomorphisms := inferInstance
  haveI : Limits.PreservesFiniteLimits R := by
    haveI : Limits.PreservesLimitsOfSize.{0, 0} R := adj.rightAdjoint_preservesLimits
    infer_instance

  have keyC : ∀ (M : CochainComplex C ℕ) (n : ℕ) (X : C), Injective (M.X n) →
      (∀ p : ℕ, Subsingleton (Abelian.Ext X (M.homology (n+1)) p)) →
      (∀ m : ℕ, Nonempty (Abelian.Ext X (M.cycles n) (m+2) ≃ Abelian.Ext X (M.cycles (n+1)) (m+1))) ∧
      Nonempty (Abelian.Ext X (M.cycles n) 1 ≃
        (X ⟶ M.cycles (n+1)) ⧸ (Preadditive.rightComp X (M.toCycles n (n+1))).range) := by
    intro M n X hJ hH
    have hn : (ComplexShape.up ℕ).next n = n + 1 := by simp
    have hp : (ComplexShape.up ℕ).prev (n + 1) = n := by simp
    have hdπ : M.toCycles n (n+1) ≫ M.homologyπ (n+1) = 0 := M.toCycles_comp_homologyπ n (n+1)
    have heι : Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ ≫
        Limits.kernel.ι (M.homologyπ (n+1)) = M.toCycles n (n+1) := Limits.kernel.lift_ι _ _ _
    have hie : M.iCycles n ≫ Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ = 0 := by
      rw [← cancel_mono (Limits.kernel.ι (M.homologyπ (n+1)) ≫ M.iCycles (n+1)), Limits.zero_comp,
        Category.assoc, reassoc_of% heι, HomologicalComplex.toCycles_i, HomologicalComplex.iCycles_d]
    have hex' : (ShortComplex.mk _ _ hdπ).Exact :=
      ShortComplex.exact_of_g_is_cokernel _ (M.homologyIsCokernel n (n+1) hp)
    haveI hepi : Epi (Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ) :=
      hex'.epi_kernelLift
    have hlim1 : Limits.IsLimit (Limits.KernelFork.ofι (M.iCycles n) hie) :=
      Limits.isKernelOfComp (f := Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ)
        (Limits.kernel.ι (M.homologyπ (n+1)) ≫ M.iCycles (n+1)) (M.d n (n+1))
        (M.cyclesIsKernel n (n+1) hn) hie
        (by rw [reassoc_of% heι, HomologicalComplex.toCycles_i])
    have hS₁ : (ShortComplex.mk _ _ hie).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ hlim1)
        (by infer_instance) (by infer_instance)
    have hS₂ : (ShortComplex.mk _ _ (Limits.kernel.condition (M.homologyπ (n+1)))).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ (Limits.kernelIsKernel _))
        (by infer_instance) (by infer_instance)
    refine ⟨fun m => ?_, ?_⟩
    · let gA : Abelian.Ext X (Limits.kernel (M.homologyπ (n+1))) (m+1) →+
          Abelian.Ext X (M.cycles n) (m+2) :=
        { toFun := fun x => x.comp hS₁.extClass (show m + 1 + 1 = m + 2 by omega)
          map_zero' := Abelian.Ext.zero_comp _ _ _ _ _
          map_add' := fun a b => Abelian.Ext.add_comp a b _ _ }
      have gA_inj : Function.Injective gA := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        have hx' : x.comp hS₁.extClass (show m + 1 + 1 = m + 2 by omega) = 0 := hx
        obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ X hS₁ x
          (show m + 1 + 1 = m + 2 by omega) hx'
        rw [← hx₂, @Abelian.Ext.eq_zero_of_injective _ _ _ _ _ _ _ hJ x₂, Abelian.Ext.zero_comp]
      have gA_surj : Function.Surjective gA := by
        intro y
        have h0 : y.comp (Abelian.Ext.mk₀ (M.iCycles n)) (add_zero (m+2)) = 0 :=
          @Abelian.Ext.eq_zero_of_injective _ _ _ _ _ _ _ hJ _
        obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS₁ y h0
          (show m + 1 + 1 = m + 2 by omega)
        exact ⟨x₃, hx₃⟩
      let gB : Abelian.Ext X (Limits.kernel (M.homologyπ (n+1))) (m+1) →+
          Abelian.Ext X (M.cycles (n+1)) (m+1) :=
        { toFun := fun x => x.comp (Abelian.Ext.mk₀ (Limits.kernel.ι (M.homologyπ (n+1))))
            (add_zero (m+1))
          map_zero' := Abelian.Ext.zero_comp _ _ _ _ _
          map_add' := fun a b => Abelian.Ext.add_comp a b _ _ }
      have gB_inj : Function.Injective gB := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        have hx' : x.comp (Abelian.Ext.mk₀ (Limits.kernel.ι (M.homologyπ (n+1))))
            (add_zero (m+1)) = 0 := hx
        obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS₂ x hx'
          (show m + 1 = m + 1 from rfl)
        rw [← hx₃, @Subsingleton.elim _ (hH m) x₃ 0, Abelian.Ext.zero_comp]
      have gB_surj : Function.Surjective gB := by
        intro y
        obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ X hS₂ y
          (@Subsingleton.elim _ (hH (m+1)) _ _)
        exact ⟨x₁, hx₁⟩
      exact ⟨(Equiv.ofBijective gA ⟨gA_inj, gA_surj⟩).symm.trans
        (Equiv.ofBijective gB ⟨gB_inj, gB_surj⟩)⟩
    · let ψ : (X ⟶ Limits.kernel (M.homologyπ (n+1))) →+ Abelian.Ext X (M.cycles n) 1 :=
        { toFun := fun φ => (Abelian.Ext.mk₀ φ).comp hS₁.extClass (zero_add 1)
          map_zero' := by simp only [Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
          map_add' := fun a b => by simp only [Abelian.Ext.mk₀_add, Abelian.Ext.add_comp] }
      have hψsurj : Function.Surjective ψ := by
        intro y
        have h0 : y.comp (Abelian.Ext.mk₀ (M.iCycles n)) (add_zero 1) = 0 :=
          @Abelian.Ext.eq_zero_of_injective _ _ _ _ _ _ _ hJ _
        obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS₁ y h0
          (show 0 + 1 = 1 from rfl)
        refine ⟨Abelian.Ext.homEquiv₀ x₃, ?_⟩
        show (Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ x₃)).comp hS₁.extClass (zero_add 1) = y
        rw [Abelian.Ext.mk₀_homEquiv₀_apply]
        exact hx₃
      have hker : ψ.ker = (Preadditive.rightComp X
          (Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ)).range := by
        ext φ
        rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
        constructor
        · intro hφ
          have hφ' : (Abelian.Ext.mk₀ φ).comp hS₁.extClass (zero_add 1) = 0 := hφ
          obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ X hS₁ (Abelian.Ext.mk₀ φ)
            (zero_add 1) hφ'
          refine ⟨Abelian.Ext.homEquiv₀ x₂, ?_⟩
          show Abelian.Ext.homEquiv₀ x₂ ≫
            Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ = φ
          apply Abelian.Ext.homEquiv₀.symm.injective
          rw [Abelian.Ext.homEquiv₀_symm_apply, Abelian.Ext.homEquiv₀_symm_apply,
            ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
          exact hx₂
        · rintro ⟨g, rfl⟩
          show (Abelian.Ext.mk₀ (g ≫ Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1))
            hdπ)).comp hS₁.extClass (zero_add 1) = 0
          rw [← Abelian.Ext.mk₀_comp_mk₀,
            Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 1) (by omega)]
          rw [show (Abelian.Ext.mk₀ (Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1))
            hdπ)).comp hS₁.extClass (zero_add 1) = 0 from hS₁.comp_extClass,
            Abelian.Ext.comp_zero]
      have QA : (X ⟶ Limits.kernel (M.homologyπ (n+1))) ⧸ (Preadditive.rightComp X
          (Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ)).range ≃+
          Abelian.Ext X (M.cycles n) 1 :=
        (QuotientAddGroup.quotientAddEquivOfEq hker.symm).trans
          (QuotientAddGroup.quotientKerEquivOfSurjective ψ hψsurj)
      haveI hsub : Subsingleton (X ⟶ M.homology (n+1)) :=
        @Equiv.subsingleton _ _ Abelian.Ext.homEquiv₀.symm (hH 0)
      let E0 : (X ⟶ Limits.kernel (M.homologyπ (n+1))) ≃+ (X ⟶ M.cycles (n+1)) :=
        AddEquiv.ofBijective (Preadditive.rightComp X (Limits.kernel.ι (M.homologyπ (n+1))))
          ⟨fun a b (h : a ≫ Limits.kernel.ι (M.homologyπ (n+1)) =
              b ≫ Limits.kernel.ι (M.homologyπ (n+1))) => (cancel_mono _).1 h,
            fun f => ⟨Limits.kernel.lift (M.homologyπ (n+1)) f (Subsingleton.elim _ _),
              Limits.kernel.lift_ι _ _ _⟩⟩
      have hmap0 : AddSubgroup.map
          (E0 : (X ⟶ Limits.kernel (M.homologyπ (n+1))) →+ (X ⟶ M.cycles (n+1)))
          (Preadditive.rightComp X
            (Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ)).range =
          (Preadditive.rightComp X (M.toCycles n (n+1))).range := by
        ext f
        rw [AddSubgroup.mem_map, AddMonoidHom.mem_range]
        constructor
        · rintro ⟨x, hx, rfl⟩
          rw [AddMonoidHom.mem_range] at hx
          obtain ⟨g, rfl⟩ := hx
          refine ⟨g, ?_⟩
          show g ≫ M.toCycles n (n+1) = (g ≫ Limits.kernel.lift (M.homologyπ (n+1))
            (M.toCycles n (n+1)) hdπ) ≫ Limits.kernel.ι (M.homologyπ (n+1))
          rw [Category.assoc, heι]
        · rintro ⟨g, rfl⟩
          refine ⟨g ≫ Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ,
            ⟨g, rfl⟩, ?_⟩
          show (g ≫ Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ) ≫
            Limits.kernel.ι (M.homologyπ (n+1)) = g ≫ M.toCycles n (n+1)
          rw [Category.assoc, heι]
      exact ⟨QA.symm.toEquiv.trans (QuotientAddGroup.congr _ _ E0 hmap0).toEquiv⟩

  have keyD : ∀ (M : CochainComplex D ℕ) (n : ℕ) (X : D), Injective (M.X n) →
      (∀ p : ℕ, Subsingleton (Abelian.Ext X (M.homology (n+1)) p)) →
      (∀ m : ℕ, Nonempty (Abelian.Ext X (M.cycles n) (m+2) ≃ Abelian.Ext X (M.cycles (n+1)) (m+1))) ∧
      Nonempty (Abelian.Ext X (M.cycles n) 1 ≃
        (X ⟶ M.cycles (n+1)) ⧸ (Preadditive.rightComp X (M.toCycles n (n+1))).range) := by
    intro M n X hJ hH
    have hn : (ComplexShape.up ℕ).next n = n + 1 := by simp
    have hp : (ComplexShape.up ℕ).prev (n + 1) = n := by simp
    have hdπ : M.toCycles n (n+1) ≫ M.homologyπ (n+1) = 0 := M.toCycles_comp_homologyπ n (n+1)
    have heι : Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ ≫
        Limits.kernel.ι (M.homologyπ (n+1)) = M.toCycles n (n+1) := Limits.kernel.lift_ι _ _ _
    have hie : M.iCycles n ≫ Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ = 0 := by
      rw [← cancel_mono (Limits.kernel.ι (M.homologyπ (n+1)) ≫ M.iCycles (n+1)), Limits.zero_comp,
        Category.assoc, reassoc_of% heι, HomologicalComplex.toCycles_i, HomologicalComplex.iCycles_d]
    have hex' : (ShortComplex.mk _ _ hdπ).Exact :=
      ShortComplex.exact_of_g_is_cokernel _ (M.homologyIsCokernel n (n+1) hp)
    haveI hepi : Epi (Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ) :=
      hex'.epi_kernelLift
    have hlim1 : Limits.IsLimit (Limits.KernelFork.ofι (M.iCycles n) hie) :=
      Limits.isKernelOfComp (f := Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ)
        (Limits.kernel.ι (M.homologyπ (n+1)) ≫ M.iCycles (n+1)) (M.d n (n+1))
        (M.cyclesIsKernel n (n+1) hn) hie
        (by rw [reassoc_of% heι, HomologicalComplex.toCycles_i])
    have hS₁ : (ShortComplex.mk _ _ hie).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ hlim1)
        (by infer_instance) (by infer_instance)
    have hS₂ : (ShortComplex.mk _ _ (Limits.kernel.condition (M.homologyπ (n+1)))).ShortExact :=
      ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ (Limits.kernelIsKernel _))
        (by infer_instance) (by infer_instance)
    refine ⟨fun m => ?_, ?_⟩
    · let gA : Abelian.Ext X (Limits.kernel (M.homologyπ (n+1))) (m+1) →+
          Abelian.Ext X (M.cycles n) (m+2) :=
        { toFun := fun x => x.comp hS₁.extClass (show m + 1 + 1 = m + 2 by omega)
          map_zero' := Abelian.Ext.zero_comp _ _ _ _ _
          map_add' := fun a b => Abelian.Ext.add_comp a b _ _ }
      have gA_inj : Function.Injective gA := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        have hx' : x.comp hS₁.extClass (show m + 1 + 1 = m + 2 by omega) = 0 := hx
        obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ X hS₁ x
          (show m + 1 + 1 = m + 2 by omega) hx'
        rw [← hx₂, @Abelian.Ext.eq_zero_of_injective _ _ _ _ _ _ _ hJ x₂, Abelian.Ext.zero_comp]
      have gA_surj : Function.Surjective gA := by
        intro y
        have h0 : y.comp (Abelian.Ext.mk₀ (M.iCycles n)) (add_zero (m+2)) = 0 :=
          @Abelian.Ext.eq_zero_of_injective _ _ _ _ _ _ _ hJ _
        obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS₁ y h0
          (show m + 1 + 1 = m + 2 by omega)
        exact ⟨x₃, hx₃⟩
      let gB : Abelian.Ext X (Limits.kernel (M.homologyπ (n+1))) (m+1) →+
          Abelian.Ext X (M.cycles (n+1)) (m+1) :=
        { toFun := fun x => x.comp (Abelian.Ext.mk₀ (Limits.kernel.ι (M.homologyπ (n+1))))
            (add_zero (m+1))
          map_zero' := Abelian.Ext.zero_comp _ _ _ _ _
          map_add' := fun a b => Abelian.Ext.add_comp a b _ _ }
      have gB_inj : Function.Injective gB := by
        rw [injective_iff_map_eq_zero]
        intro x hx
        have hx' : x.comp (Abelian.Ext.mk₀ (Limits.kernel.ι (M.homologyπ (n+1))))
            (add_zero (m+1)) = 0 := hx
        obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS₂ x hx'
          (show m + 1 = m + 1 from rfl)
        rw [← hx₃, @Subsingleton.elim _ (hH m) x₃ 0, Abelian.Ext.zero_comp]
      have gB_surj : Function.Surjective gB := by
        intro y
        obtain ⟨x₁, hx₁⟩ := Abelian.Ext.covariant_sequence_exact₂ X hS₂ y
          (@Subsingleton.elim _ (hH (m+1)) _ _)
        exact ⟨x₁, hx₁⟩
      exact ⟨(Equiv.ofBijective gA ⟨gA_inj, gA_surj⟩).symm.trans
        (Equiv.ofBijective gB ⟨gB_inj, gB_surj⟩)⟩
    · let ψ : (X ⟶ Limits.kernel (M.homologyπ (n+1))) →+ Abelian.Ext X (M.cycles n) 1 :=
        { toFun := fun φ => (Abelian.Ext.mk₀ φ).comp hS₁.extClass (zero_add 1)
          map_zero' := by simp only [Abelian.Ext.mk₀_zero, Abelian.Ext.zero_comp]
          map_add' := fun a b => by simp only [Abelian.Ext.mk₀_add, Abelian.Ext.add_comp] }
      have hψsurj : Function.Surjective ψ := by
        intro y
        have h0 : y.comp (Abelian.Ext.mk₀ (M.iCycles n)) (add_zero 1) = 0 :=
          @Abelian.Ext.eq_zero_of_injective _ _ _ _ _ _ _ hJ _
        obtain ⟨x₃, hx₃⟩ := Abelian.Ext.covariant_sequence_exact₁ X hS₁ y h0
          (show 0 + 1 = 1 from rfl)
        refine ⟨Abelian.Ext.homEquiv₀ x₃, ?_⟩
        show (Abelian.Ext.mk₀ (Abelian.Ext.homEquiv₀ x₃)).comp hS₁.extClass (zero_add 1) = y
        rw [Abelian.Ext.mk₀_homEquiv₀_apply]
        exact hx₃
      have hker : ψ.ker = (Preadditive.rightComp X
          (Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ)).range := by
        ext φ
        rw [AddMonoidHom.mem_ker, AddMonoidHom.mem_range]
        constructor
        · intro hφ
          have hφ' : (Abelian.Ext.mk₀ φ).comp hS₁.extClass (zero_add 1) = 0 := hφ
          obtain ⟨x₂, hx₂⟩ := Abelian.Ext.covariant_sequence_exact₃ X hS₁ (Abelian.Ext.mk₀ φ)
            (zero_add 1) hφ'
          refine ⟨Abelian.Ext.homEquiv₀ x₂, ?_⟩
          show Abelian.Ext.homEquiv₀ x₂ ≫
            Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ = φ
          apply Abelian.Ext.homEquiv₀.symm.injective
          rw [Abelian.Ext.homEquiv₀_symm_apply, Abelian.Ext.homEquiv₀_symm_apply,
            ← Abelian.Ext.mk₀_comp_mk₀, Abelian.Ext.mk₀_homEquiv₀_apply]
          exact hx₂
        · rintro ⟨g, rfl⟩
          show (Abelian.Ext.mk₀ (g ≫ Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1))
            hdπ)).comp hS₁.extClass (zero_add 1) = 0
          rw [← Abelian.Ext.mk₀_comp_mk₀,
            Abelian.Ext.comp_assoc _ _ _ (zero_add 0) (zero_add 1) (by omega)]
          rw [show (Abelian.Ext.mk₀ (Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1))
            hdπ)).comp hS₁.extClass (zero_add 1) = 0 from hS₁.comp_extClass,
            Abelian.Ext.comp_zero]
      have QA : (X ⟶ Limits.kernel (M.homologyπ (n+1))) ⧸ (Preadditive.rightComp X
          (Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ)).range ≃+
          Abelian.Ext X (M.cycles n) 1 :=
        (QuotientAddGroup.quotientAddEquivOfEq hker.symm).trans
          (QuotientAddGroup.quotientKerEquivOfSurjective ψ hψsurj)
      haveI hsub : Subsingleton (X ⟶ M.homology (n+1)) :=
        @Equiv.subsingleton _ _ Abelian.Ext.homEquiv₀.symm (hH 0)
      let E0 : (X ⟶ Limits.kernel (M.homologyπ (n+1))) ≃+ (X ⟶ M.cycles (n+1)) :=
        AddEquiv.ofBijective (Preadditive.rightComp X (Limits.kernel.ι (M.homologyπ (n+1))))
          ⟨fun a b (h : a ≫ Limits.kernel.ι (M.homologyπ (n+1)) =
              b ≫ Limits.kernel.ι (M.homologyπ (n+1))) => (cancel_mono _).1 h,
            fun f => ⟨Limits.kernel.lift (M.homologyπ (n+1)) f (Subsingleton.elim _ _),
              Limits.kernel.lift_ι _ _ _⟩⟩
      have hmap0 : AddSubgroup.map
          (E0 : (X ⟶ Limits.kernel (M.homologyπ (n+1))) →+ (X ⟶ M.cycles (n+1)))
          (Preadditive.rightComp X
            (Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ)).range =
          (Preadditive.rightComp X (M.toCycles n (n+1))).range := by
        ext f
        rw [AddSubgroup.mem_map, AddMonoidHom.mem_range]
        constructor
        · rintro ⟨x, hx, rfl⟩
          rw [AddMonoidHom.mem_range] at hx
          obtain ⟨g, rfl⟩ := hx
          refine ⟨g, ?_⟩
          show g ≫ M.toCycles n (n+1) = (g ≫ Limits.kernel.lift (M.homologyπ (n+1))
            (M.toCycles n (n+1)) hdπ) ≫ Limits.kernel.ι (M.homologyπ (n+1))
          rw [Category.assoc, heι]
        · rintro ⟨g, rfl⟩
          refine ⟨g ≫ Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ,
            ⟨g, rfl⟩, ?_⟩
          show (g ≫ Limits.kernel.lift (M.homologyπ (n+1)) (M.toCycles n (n+1)) hdπ) ≫
            Limits.kernel.ι (M.homologyπ (n+1)) = g ≫ M.toCycles n (n+1)
          rw [Category.assoc, heι]
      exact ⟨QA.symm.toEquiv.trans (QuotientAddGroup.congr _ _ E0 hmap0).toEquiv⟩

  have extZeroC : ∀ (X Y : C), Limits.IsZero Y → ∀ p : ℕ, Subsingleton (Abelian.Ext X Y p) := by
    intro X Y hY p
    refine ⟨fun a b => ?_⟩
    have h0 : ∀ e : Abelian.Ext X Y p, e = 0 := by
      intro e
      rw [← Abelian.Ext.comp_mk₀_id e, hY.eq_of_src (𝟙 Y) 0, Abelian.Ext.mk₀_zero,
        Abelian.Ext.comp_zero]
    rw [h0 a, h0 b]

  have transC : ∀ (X : C) {Y Y' : C} (_ : Y ≅ Y') (p : ℕ),
      Nonempty (Abelian.Ext X Y p ≃ Abelian.Ext X Y' p) := by
    intro X Y Y' e p
    exact ⟨{ toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero p)
             invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero p)
             left_inv := fun x => by
               simp only
               rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
                 Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
             right_inv := fun y => by
               simp only
               rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
                 Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }⟩
  have transD : ∀ (X : D) {Y Y' : D} (_ : Y ≅ Y') (p : ℕ),
      Nonempty (Abelian.Ext X Y p ≃ Abelian.Ext X Y' p) := by
    intro X Y Y' e p
    exact ⟨{ toFun := fun x => x.comp (Abelian.Ext.mk₀ e.hom) (add_zero p)
             invFun := fun y => y.comp (Abelian.Ext.mk₀ e.inv) (add_zero p)
             left_inv := fun x => by
               simp only
               rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
                 Abelian.Ext.mk₀_comp_mk₀, Iso.hom_inv_id, Abelian.Ext.comp_mk₀_id]
             right_inv := fun y => by
               simp only
               rw [Abelian.Ext.comp_assoc _ _ _ (add_zero p) (add_zero 0) (by omega),
                 Abelian.Ext.mk₀_comp_mk₀, Iso.inv_hom_id, Abelian.Ext.comp_mk₀_id] }⟩

  set K := (R.mapHomologicalComplex (ComplexShape.up ℕ)).obj I.cocomplex with hK
  have hKinj : ∀ n, Injective (K.X n) := fun n => adj.map_injective (I.cocomplex.X n) (I.injective n)
  have hIcH : ∀ n, ∀ p : ℕ, Subsingleton (Abelian.Ext (L.obj P) (I.cocomplex.homology (n+1)) p) :=
    fun n => extZeroC _ _ (I.cocomplex_exactAt_succ n).isZero_homology

  have hφex : ∀ n, ∃ φ : R.obj (I.cocomplex.cycles n) ≅ K.cycles n,
      φ.hom ≫ K.iCycles n = R.map (I.cocomplex.iCycles n) := by
    intro n
    have hn : (ComplexShape.up ℕ).next n = n + 1 := by simp
    have h1 := Limits.KernelFork.mapIsLimit _ (I.cocomplex.cyclesIsKernel n (n+1) hn) R
    have h2 := K.cyclesIsKernel n (n+1) hn
    exact ⟨Limits.IsLimit.conePointUniqueUpToIso h1 h2,
      Limits.IsLimit.conePointUniqueUpToIso_hom_comp h1 h2 Limits.WalkingParallelPair.zero⟩
  choose φ hφ using hφex
  have hd' : ∀ n, R.map (I.cocomplex.toCycles n (n+1)) ≫ (φ (n+1)).hom = K.toCycles n (n+1) := by
    intro n
    rw [← cancel_mono (K.iCycles (n+1)), Category.assoc, hφ (n+1), ← R.map_comp,
      HomologicalComplex.toCycles_i, HomologicalComplex.toCycles_i]
    all_goals exact (Functor.mapHomologicalComplex_obj_d _ _ _ _ _).symm

  have Q0 : ∀ n : ℕ, Nonempty (Abelian.Ext P (K.cycles n) 0 ≃
      Abelian.Ext (L.obj P) (I.cocomplex.cycles n) 0) := fun n =>
    ⟨Abelian.Ext.homEquiv₀.trans (((Iso.refl P).homCongr (φ n).symm).trans
      ((adj.homEquiv P _).symm.trans Abelian.Ext.homEquiv₀.symm))⟩

  have Q1 : ∀ n : ℕ, Nonempty (Abelian.Ext P (K.cycles n) 1 ≃
      Abelian.Ext (L.obj P) (I.cocomplex.cycles n) 1) := by
    intro n
    obtain ⟨eD⟩ := (keyD K n P (hKinj n) (H (n+1) (by omega))).2
    obtain ⟨eC⟩ := (keyC I.cocomplex n (L.obj P) (I.injective n) (hIcH n)).2
    let E1 : (L.obj P ⟶ I.cocomplex.cycles (n+1)) ≃+ (P ⟶ K.cycles (n+1)) :=
      AddEquiv.mk'
        { toFun := fun f => adj.homEquiv _ _ f ≫ (φ (n+1)).hom
          invFun := fun g => (adj.homEquiv _ _).symm (g ≫ (φ (n+1)).inv)
          left_inv := fun f => by simp
          right_inv := fun g => by simp }
        (fun f g => by
          show adj.homEquiv _ _ (f + g) ≫ (φ (n+1)).hom =
            adj.homEquiv _ _ f ≫ (φ (n+1)).hom + adj.homEquiv _ _ g ≫ (φ (n+1)).hom
          simp only [Adjunction.homEquiv_unit, Functor.map_add, Preadditive.comp_add,
            Preadditive.add_comp])
    have hmapE1 : AddSubgroup.map
        (E1 : (L.obj P ⟶ I.cocomplex.cycles (n+1)) →+ (P ⟶ K.cycles (n+1)))
        (Preadditive.rightComp (L.obj P) (I.cocomplex.toCycles n (n+1))).range =
        (Preadditive.rightComp P (K.toCycles n (n+1))).range := by
      ext f
      rw [AddSubgroup.mem_map, AddMonoidHom.mem_range]
      constructor
      · rintro ⟨x, hx, rfl⟩
        rw [AddMonoidHom.mem_range] at hx
        obtain ⟨g, rfl⟩ := hx
        refine ⟨adj.homEquiv _ _ g, ?_⟩
        show adj.homEquiv _ _ g ≫ K.toCycles n (n+1) =
          adj.homEquiv _ _ (g ≫ I.cocomplex.toCycles n (n+1)) ≫ (φ (n+1)).hom
        rw [← hd' n, Adjunction.homEquiv_naturality_right, Category.assoc]
      · rintro ⟨g, rfl⟩
        refine ⟨(adj.homEquiv _ _).symm g ≫ I.cocomplex.toCycles n (n+1),
          ⟨(adj.homEquiv _ _).symm g, rfl⟩, ?_⟩
        show adj.homEquiv _ _ ((adj.homEquiv _ _).symm g ≫ I.cocomplex.toCycles n (n+1)) ≫
          (φ (n+1)).hom = g ≫ K.toCycles n (n+1)
        rw [← hd' n, Adjunction.homEquiv_naturality_right, Equiv.apply_symm_apply, Category.assoc]
    exact ⟨eD.trans ((QuotientAddGroup.congr _ _ E1 hmapE1).toEquiv.symm.trans eC.symm)⟩

  have main1 : ∀ m n : ℕ, Nonempty (Abelian.Ext P (K.cycles n) (m+1) ≃
      Abelian.Ext (L.obj P) (I.cocomplex.cycles n) (m+1)) := by
    intro m
    induction m with
    | zero => exact Q1
    | succ m ih =>
      intro n
      obtain ⟨e1⟩ := (keyD K n P (hKinj n) (H (n+1) (by omega))).1 m
      obtain ⟨e2⟩ := ih (n+1)
      obtain ⟨e3⟩ := (keyC I.cocomplex n (L.obj P) (I.injective n) (hIcH n)).1 m
      exact ⟨e1.trans (e2.trans e3.symm)⟩
  have main : ∀ p n : ℕ, Nonempty (Abelian.Ext P (K.cycles n) p ≃
      Abelian.Ext (L.obj P) (I.cocomplex.cycles n) p) := by
    intro p n
    cases p with
    | zero => exact Q0 n
    | succ m => exact main1 m n

  have hα : Nonempty (A ≅ I.cocomplex.cycles 0) :=
    ⟨(HomologicalComplex.singleObjXSelf (ComplexShape.up ℕ) 0 A).symm ≪≫
      Limits.IsLimit.conePointUniqueUpToIso I.isLimitKernelFork
        (I.cocomplex.cyclesIsKernel 0 1 (by simp))⟩
  obtain ⟨α⟩ := hα
  obtain ⟨e1⟩ := transD P (R.mapIso α ≪≫ φ 0) p
  obtain ⟨e2⟩ := main p 0
  obtain ⟨e3⟩ := transC (L.obj P) α.symm p
  exact ⟨e1.trans (e2.trans e3)⟩

