    refine ⟨φ.toAddMonoidHom.comp δ, ?_, ?_, ?_⟩
    · intro a c
      have hsm : ∀ (s : IsLocalRing.ResidueField R) (t : L), j s * t = s • t := fun _ _ => rfl
      show φ (δ (a * c)) = _ * φ (δ c) + _ * φ (δ a)
