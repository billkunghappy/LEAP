    exact hL.trans hR.symm
  · intro F T V a x
    have hgen := congrArg (fun h => (h.app (Opposite.op V)).hom x) (hμ F)
    have h5 := congrArg (fun h => h.hom (((gL ((wcEtBaseChange g).op ⋙ F.obj)).app (Opposite.op V)).hom x))
      ((μ F).naturality a.op)
    have h6 := congrArg (fun h => h.hom (((θ F.obj).app (Opposite.op V)).hom x))
      ((toSheafify (Scheme.ProEt.topology B)
        ((wcProEtBaseChange g).op ⋙ ((wcEpsInv X).obj F).obj)).naturality a.op)
    exact h5.trans ((congrArg (((wcEpsInv X ⋙ wcProEtPush g).obj F).obj.map a.op).hom hgen).trans h6.symm)

theorem wc_cof_surj_of_local : ∀ (S : Scheme.{u}) (P : Sheaf (Scheme.ProEt.topology S) AddCommGrpCat.{u+1}), (∀ (T : S.ProEt) (y : P.obj.obj (Opposite.op T)), ∃ O : Set T.left, IsOpen O ∧ ∀ (W : S.ProEt) (k : W ⟶ T), (P.obj.map k.op y = 0 ↔ Set.range k.left ⊆ O)) → ∀ (W : S.ProEt) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (a : ∀ l, W ⟶ (wcEtToProEt S).obj (D.obj l)), (∀ {l l' : Λ} (t : l ⟶ l'), a l ≫ (wcEtToProEt S).map (D.map t) = a l') → (∀ l, CompactSpace (D.obj l).left) → (∀ l, QuasiSeparatedSpace (D.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → CompactSpace W.left → (∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! h : Z ⟶ W.left, ∀ l, h ≫ (a l).left = z l) → ∀ (x : P.obj.obj (Opposite.op W)), (∀ τ : W.left, ∃ (l : Λ) (N : S.ProEt) (n : N ⟶ (wcEtToProEt S).obj (D.obj l)) (s : P.obj.obj (Opposite.op N)) (N' : S.ProEt) (q₁ : N' ⟶ N) (q₂ : N' ⟶ W), IsAffine N.left ∧ Etale n.left ∧ IsPullback q₁.left q₂.left n.left (a l).left ∧ τ ∈ Set.range q₂.left ∧ P.obj.map q₁.op s = P.obj.map q₂.op x) → ∃ (l : Λ) (y : P.obj.obj (Opposite.op ((wcEtToProEt S).obj (D.obj l)))), P.obj.map (a l).op y = x :=
by
  intro S P hZL W Λ _ _ D a ha hcpt hqs haff hcW hlim x hloc
  classical

  have hPc : ∀ {A B C : S.ProEt} (f : A ⟶ B) (g : B ⟶ C) (v : P.obj.obj (Opposite.op C)),
      P.obj.map f.op (P.obj.map g.op v) = P.obj.map (f ≫ g).op v := by
    intro A B C f g v
    first
      | (rw [op_comp, Functor.map_comp]; rfl)
      | simp [op_comp, Functor.map_comp]

  have hDV : ∀ {L l' K' : Λ} (g : L ⟶ l') (t : l' ⟶ K') (z : (D.obj L).left),
      (D.map (g ≫ t)).left z = (D.map t).left ((D.map g).left z) := by
    intro L l' K' g t z
    first
      | (simp only [Functor.map_comp, MorphismProperty.Comma.comp_left, Scheme.Hom.comp_apply]; done)
      | (rw [Functor.map_comp]; rfl)

  have hbc : ∀ {U U' : S.ProEt} (aU : W ⟶ U) (aU' : W ⟶ U') (t : U' ⟶ U), aU' ≫ t = aU →
      IsAffineHom t.left → ∀ (N : S.ProEt) (n : N ⟶ U) (N' : S.ProEt) (q₁ : N' ⟶ N)
      (q₂ : N' ⟶ W), IsAffine N.left → Etale n.left → IsPullback q₁.left q₂.left n.left aU.left →
      ∃ (N₂ : S.ProEt) (n₂ : N₂ ⟶ U') (r : N₂ ⟶ N) (q₃ : N' ⟶ N₂),
        IsAffine N₂.left ∧ Etale n₂.left ∧ IsPullback q₃.left q₂.left n₂.left aU'.left ∧
        r ≫ n = n₂ ≫ t ∧ q₃ ≫ r = q₁ ∧
        ∀ z : U'.left, t.left z ∈ Set.range n.left → z ∈ Set.range n₂.left := by
    intro U U' aU aU' t HA HAFF N n N' q₁ q₂ hN hn hpb
    have HAl : aU'.left ≫ t.left = aU.left := by rw [← HA]; rfl
    haveI : Etale n.left := hn
    haveI : IsAffineHom t.left := HAFF
    haveI : IsAffine N.left := hN
    haveI : WeaklyEtale U'.hom := U'.prop
    have hE : q₁.left ≫ n.left = (q₂.left ≫ aU'.left) ≫ t.left := by
      rw [Category.assoc, HAl]; exact hpb.toCommSq.w
    refine ⟨Scheme.ProEt.mk (Limits.pullback.snd n.left t.left ≫ U'.hom),
      MorphismProperty.Over.homMk (Limits.pullback.snd n.left t.left) rfl trivial,
      MorphismProperty.Over.homMk (Limits.pullback.fst n.left t.left) ?_ trivial,
      MorphismProperty.Over.homMk (Limits.pullback.lift q₁.left (q₂.left ≫ aU'.left) hE) ?_ trivial,
      ?_, ?_, ?_, ?_, ?_, ?_⟩
    · show Limits.pullback.fst n.left t.left ≫ N.hom =
        Limits.pullback.snd n.left t.left ≫ U'.hom
      rw [← MorphismProperty.Over.w n, ← Category.assoc, Limits.pullback.condition, Category.assoc,
        MorphismProperty.Over.w t]
    · show Limits.pullback.lift q₁.left (q₂.left ≫ aU'.left) hE ≫
        Limits.pullback.snd n.left t.left ≫ U'.hom = N'.hom
      rw [← Category.assoc, Limits.pullback.lift_snd, Category.assoc, MorphismProperty.Over.w aU',
        MorphismProperty.Over.w q₂]
    · show IsAffine (Limits.pullback n.left t.left)
      haveI : IsAffineHom (Limits.pullback.fst n.left t.left) :=
        MorphismProperty.of_isPullback (P := @IsAffineHom)
          (IsPullback.of_hasPullback n.left t.left).flip HAFF
      exact isAffine_of_isAffineHom (Limits.pullback.fst n.left t.left)
    · show Etale (Limits.pullback.snd n.left t.left)
      infer_instance
    · show IsPullback (Limits.pullback.lift q₁.left (q₂.left ≫ aU'.left) hE) q₂.left
        (Limits.pullback.snd n.left t.left) aU'.left
      refine IsPullback.of_right ?_ (Limits.pullback.lift_snd _ _ _)
        (IsPullback.of_hasPullback n.left t.left)
      rw [Limits.pullback.lift_fst, HAl]
      exact hpb
    · apply MorphismProperty.Over.Hom.ext
      show Limits.pullback.fst n.left t.left ≫ n.left = Limits.pullback.snd n.left t.left ≫ t.left
      exact Limits.pullback.condition
    · apply MorphismProperty.Over.Hom.ext
      show Limits.pullback.lift q₁.left (q₂.left ≫ aU'.left) hE ≫
        Limits.pullback.fst n.left t.left = q₁.left
      exact Limits.pullback.lift_fst _ _ _
    · rintro z ⟨p, hp⟩
      obtain ⟨w, _, hw2⟩ := Scheme.Pullback.exists_preimage_pullback p z hp
      exact ⟨w, hw2⟩

  let D₀ : Λ ⥤ Scheme.{u} := D ⋙ Scheme.Etale.forget S ⋙ Over.forget S
  have hnat : ∀ {l l' : Λ} (t : l ⟶ l'), (a l).left ≫ (D.map t).left = (a l').left :=
    fun t => congrArg (fun φ => φ.left) (ha t)

  choose lev N n s N' q₁ q₂ hNa hne hpb hτ hag using hloc
  have hopen : ∀ τ, IsOpen (Set.range (q₂ τ).left) := by
    intro τ
    haveI : Etale (q₂ τ).left := MorphismProperty.of_isPullback (P := @Etale) (hpb τ) (hne τ)
    exact (q₂ τ).left.isOpenMap.isOpen_range
  obtain ⟨m, τi, hCOV⟩ : ∃ (m : ℕ) (τi : Fin m → W.left),
      ∀ τ' : W.left, ∃ i, τ' ∈ Set.range (q₂ (τi i)).left := by
    haveI := hcW
    obtain ⟨T, hT⟩ := (isCompact_univ : IsCompact (Set.univ : Set W.left)).elim_finite_subcover
      (fun τ => Set.range (q₂ τ).left) hopen (fun τ _ => Set.mem_iUnion.2 ⟨τ, hτ τ⟩)
    refine ⟨T.card, fun i => (T.equivFin.symm i).1, fun τ' => ?_⟩
    have h1 := hT (Set.mem_univ τ')
    simp only [Set.mem_iUnion] at h1
    obtain ⟨τ, hτT, hmem⟩ := h1
    refine ⟨T.equivFin ⟨τ, hτT⟩, ?_⟩
    have hse : T.equivFin.symm (T.equivFin ⟨τ, hτT⟩) = ⟨τ, hτT⟩ := Equiv.symm_apply_apply _ _
    show τ' ∈ Set.range (q₂ (T.equivFin.symm (T.equivFin ⟨τ, hτT⟩)).1).left
    rw [hse]
    exact hmem

  obtain ⟨K, hK⟩ := IsCofiltered.inf_objs_exists
    (Finset.univ.image (fun i : Fin m => lev (τi i)))
  have u : ∀ i, K ⟶ lev (τi i) := fun i =>
    (hK (Finset.mem_image_of_mem (fun i : Fin m => lev (τi i)) (Finset.mem_univ i))).some

  have hbc1 := fun i => hbc (a (lev (τi i))) (a K) ((wcEtToProEt S).map (D.map (u i)))
    (ha (u i)) (haff (u i)) (N (τi i)) (n (τi i)) (N' (τi i)) (q₁ (τi i)) (q₂ (τi i))
    (hNa _) (hne _) (hpb _)
  choose NK nK rK q₃ hNKa hnKe hpbK hrK hq₃ hptK using hbc1
  obtain ⟨sK, hsK⟩ : ∃ sK : ∀ i, P.obj.obj (Opposite.op (NK i)),
      ∀ i, sK i = P.obj.map (rK i).op (s (τi i)) := ⟨_, fun _ => rfl⟩
  have hAGK : ∀ i, P.obj.map (q₃ i).op (sK i) = P.obj.map (q₂ (τi i)).op x := by
    intro i
    rw [hsK, hPc, hq₃ i]
    exact hag _

  have hΩo : IsOpen (⋃ i, Set.range (nK i).left) := isOpen_iUnion (fun i => by
    haveI := hnKe i
    exact (nK i).left.isOpenMap.isOpen_range)
  obtain ⟨l₁, t₁, hj₁⟩ := wc_et_limit_eventually_in_open Λ D₀ W.left (fun l => (a l).left)
    hnat hlim (fun t => haff t) K ((wcEtToProEt S).obj (D.obj K)).left (𝟙 _) (hcpt K) _ hΩo (by
      intro μ z hμz
      obtain ⟨i, w, hw⟩ := hCOV z
      refine Set.mem_iUnion.2 ⟨i, (q₃ i).left w, ?_⟩
      have e : ((q₃ i).left ≫ (nK i).left) w = ((q₂ (τi i)).left ≫ (a K).left) w := by
        rw [(hpbK i).toCommSq.w]
      simp only [Scheme.Hom.comp_apply] at e
      rw [e, hw]
      refine hμz.symm.trans ?_
      first | rfl | simp)
  have hJS : ∀ (L : Λ) (v : L ⟶ K) (g : L ⟶ l₁), g ≫ t₁ = v → ∀ z : (D.obj L).left,
      ∃ i, (D.map v).left z ∈ Set.range (nK i).left := by
    intro L v g hg z
    have e := hDV g t₁ z
    rw [hg] at e
    have hm := hj₁ ((D.map v).left z) ((D.map g).left z) (by
      first
        | exact e
        | (rw [Scheme.Hom.id_apply]; exact e)
        | simpa using e)
    exact Set.mem_iUnion.1 hm

  have hpair : ∀ i j : Fin m, ∃ (l₂ : Λ) (t₂ : l₂ ⟶ K), ∀ (L : Λ) (v : L ⟶ K) (g : L ⟶ l₂),
      g ≫ t₂ = v → ∀ (Z : S.ProEt) (g₁ : Z ⟶ NK i) (g₂ : Z ⟶ NK j)
      (w : Z ⟶ (wcEtToProEt S).obj (D.obj L)),
      g₁ ≫ nK i = w ≫ (wcEtToProEt S).map (D.map v) →
      g₂ ≫ nK j = w ≫ (wcEtToProEt S).map (D.map v) →
      P.obj.map g₁.op (sK i) = P.obj.map g₂.op (sK j) := by
    intro i j
    obtain ⟨M, hMc, g, O, hO, hinf, hAGR⟩ := wc_tsl_pair_agree S P hZL (a K) (hqs K) x
      (NK i) (NK j) (nK i) (nK j) (sK i) (sK j) (N' (τi i)) (N' (τi j)) (q₃ i) (q₂ (τi i))
      (q₃ j) (q₂ (τi j)) (hNKa i) (hNKa j) (hnKe i) (hnKe j) (hpbK i) (hpbK j) (hAGK i) (hAGK j)
    obtain ⟨l₂, t₂, ht₂⟩ := wc_et_limit_eventually_in_open Λ D₀ W.left (fun l => (a l).left)
      hnat hlim (fun t => haff t) K M g hMc O hO hinf
    refine ⟨l₂, t₂, fun L v g' hg' Z g₁ g₂ w h₁ h₂ => ?_⟩
    subst hg'
    apply hAGR Z g₁ g₂ (h₁.trans h₂.symm)
    intro μ ζ hμ
    apply ht₂ μ ((D.map g').left (w.left ζ))
    have e : (g₁ ≫ nK i).left ζ = (w ≫ (wcEtToProEt S).map (D.map (g' ≫ t₂))).left ζ := by
      rw [h₁]
    simp only [MorphismProperty.Comma.comp_left, Scheme.Hom.comp_apply] at e
    refine hμ.trans (e.trans ?_)
    exact hDV g' t₂ (w.left ζ)
  choose l₂ t₂ hPA using hpair

  obtain ⟨L, v, g₁, G, hg₁, hG⟩ : ∃ (L : Λ) (v : L ⟶ K) (g₁ : L ⟶ l₁)
      (G : ∀ p : Fin m × Fin m, L ⟶ l₂ p.1 p.2), g₁ ≫ t₁ = v ∧ ∀ p, G p ≫ t₂ p.1 p.2 = v := by
    let O : Finset Λ := insert K (insert l₁ (Finset.univ.image (fun p : Fin m × Fin m => l₂ p.1 p.2)))
    have mK : K ∈ O := Finset.mem_insert_self _ _
    have m1 : l₁ ∈ O := Finset.mem_insert_of_mem (Finset.mem_insert_self _ _)
    have ml : ∀ p : Fin m × Fin m, l₂ p.1 p.2 ∈ O := fun p =>
      Finset.mem_insert_of_mem (Finset.mem_insert_of_mem
        (Finset.mem_image_of_mem (fun p : Fin m × Fin m => l₂ p.1 p.2) (Finset.mem_univ p)))
    let H : Finset ((X : Λ) ×' (Y : Λ) ×' (_ : X ∈ O) ×' (_ : Y ∈ O) ×' (X ⟶ Y)) :=
      insert ⟨l₁, K, m1, mK, t₁⟩ (Finset.univ.image (fun p : Fin m × Fin m =>
        (⟨l₂ p.1 p.2, K, ml p, mK, t₂ p.1 p.2⟩ :
          (X : Λ) ×' (Y : Λ) ×' (_ : X ∈ O) ×' (_ : Y ∈ O) ×' (X ⟶ Y))))
    obtain ⟨L, T, hT⟩ := IsCofiltered.inf_exists O H
    exact ⟨L, T mK, T m1, fun p => T (ml p), hT m1 mK (Finset.mem_insert_self _ _),
      fun p => hT (ml p) mK (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ (Finset.mem_univ p)))⟩

  have hbc2 := fun i => hbc (a K) (a L) ((wcEtToProEt S).map (D.map v)) (ha v) (haff v)
    (NK i) (nK i) (N' (τi i)) (q₃ i) (q₂ (τi i)) (hNKa i) (hnKe i) (hpbK i)
  choose NL nL rL q₄ hNLa hnLe hpbL hrL hq₄ hptL using hbc2
  obtain ⟨sL, hsL⟩ : ∃ sL : ∀ i, P.obj.obj (Opposite.op (NL i)),
      ∀ i, sL i = P.obj.map (rL i).op (sK i) := ⟨_, fun _ => rfl⟩

  haveI : QuasiSeparatedSpace ((wcEtToProEt S).obj (D.obj L)).left := hqs L
  have hcovU := proet_finite_affine_jointly_surjective_covers S ((wcEtToProEt S).obj (D.obj L)) m
    NL nL hNLa (by
      intro z
      obtain ⟨i, hi⟩ := hJS L v g₁ hg₁ z
      exact ⟨i, hptL i z hi⟩)
  obtain ⟨y, hy⟩ := wc_tsl_glue_check S P hZL (a L) m NL nL sL (fun i => N' (τi i)) q₄
    (fun i => q₂ (τi i)) x hcovU hCOV
    (fun i => MorphismProperty.Over.Hom.ext (by
      first
        | exact (hpbL i).toCommSq.w
        | simpa using (hpbL i).toCommSq.w))
    (by
      intro i j Z gi gj hij
      rw [hsL, hsL, hPc, hPc]
      apply hPA i j L v (G (i, j)) (hG (i, j)) Z (gi ≫ rL i) (gj ≫ rL j) (gi ≫ nL i)
      · simp only [Category.assoc, hrL i]
      · rw [hij]
        simp only [Category.assoc, hrL j])
    (by
      intro i
      rw [hsL, hPc, hq₄ i]
      exact hAGK i)
  exact ⟨L, y, hy⟩

theorem wc_epsInv_limit_surj : ∀ (S : Scheme.{u}), ∀ (G : Sheaf (Scheme.smallEtaleTopology S) AddCommGrpCat.{u+1}) (W : S.ProEt) (Λ : Type u) [SmallCategory Λ] [IsCofiltered Λ] (D : Λ ⥤ S.Etale) (a : ∀ l, W ⟶ (wcEtToProEt S).obj (D.obj l)), (∀ {l l' : Λ} (t : l ⟶ l'), a l ≫ (wcEtToProEt S).map (D.map t) = a l') → (∀ l, CompactSpace (D.obj l).left) → (∀ l, QuasiSeparatedSpace (D.obj l).left) → (∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (D.map t).left) → CompactSpace W.left → QuasiSeparatedSpace W.left → (∀ (Z : Scheme.{u}) (z : ∀ l, Z ⟶ (D.obj l).left), (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (D.map t).left = z l') → ∃! h : Z ⟶ W.left, ∀ l, h ≫ (a l).left = z l) → ∀ s : ((wcEpsInv S).obj G).obj.obj (Opposite.op W), ∃ (l : Λ) (x : G.obj.obj (Opposite.op (D.obj l))), (((wcEpsInv S).obj G).obj.map (a l).op).hom (((toSheafify (Scheme.ProEt.topology S) ((wcEtToProEt S).op.lan.obj G.obj)).app (Opposite.op ((wcEtToProEt S).obj (D.obj l)))).hom ((((wcEtToProEt S).op.lanUnit.app G.obj).app (Opposite.op (D.obj l))).hom x)) = s :=
by
  intro S G W Λ _ _ D a ha hcpt hqs haff hcW hqW hlim s

  have hZL : ∀ (T : S.ProEt) (y : ((wcEpsInv S).obj G).obj.obj (Opposite.op T)),
      ∃ O : Set T.left, IsOpen O ∧ ∀ (W' : S.ProEt) (k : W' ⟶ T),
        (((wcEpsInv S).obj G).obj.map k.op y = 0 ↔ Set.range k.left ⊆ O) :=
    fun T y => wc_epsInv_zero_locus S G T y

  have hC1 : ∀ (V : Scheme.{u}) (h : V ⟶ S) (O : Set ↥(Limits.pullback W.hom h)), IsOpen O →
      ∀ (ε : ↥(Limits.pullback W.hom h)), ε ∈ O →
      ∃ (l : Λ) (A : (Limits.pullback ((wcEtToProEt S).obj (D.obj l)).hom h).Opens)
        (π : Limits.pullback W.hom h ⟶ Limits.pullback ((wcEtToProEt S).obj (D.obj l)).hom h),
        π ≫ Limits.pullback.fst ((wcEtToProEt S).obj (D.obj l)).hom h =
            Limits.pullback.fst W.hom h ≫ (a l).left ∧
          π ≫ Limits.pullback.snd ((wcEtToProEt S).obj (D.obj l)).hom h =
            Limits.pullback.snd W.hom h ∧
          IsAffineOpen A ∧ π ε ∈ A ∧ ∀ e, π e ∈ A → e ∈ O := by
    intro V h O hO ε hε
    have key : ∀ (E : Λ ⥤ Over S) (Einf : Over S) (b : ∀ l, Einf ⟶ E.obj l)
        (hb : ∀ {l l' : Λ} (t : l ⟶ l'), (b l).left ≫ (E.map t).left = (b l').left)
        (hlimE : ∀ (T : Scheme.{u}) (z : ∀ l, T ⟶ (E.obj l).left),
          (∀ {l l' : Λ} (t : l ⟶ l'), z l ≫ (E.map t).left = z l') →
          ∃! z₀ : T ⟶ Einf.left, ∀ l, z₀ ≫ (b l).left = z l)
        (haffE : ∀ {l l' : Λ} (t : l ⟶ l'), IsAffineHom (E.map t).left)
        (O : Set ↥(Limits.pullback Einf.hom h)) (hO : IsOpen O)
        (ε : ↥(Limits.pullback Einf.hom h)) (hε : ε ∈ O),
        ∃ (l : Λ) (A : (Limits.pullback (E.obj l).hom h).Opens)
          (π : Limits.pullback Einf.hom h ⟶ Limits.pullback (E.obj l).hom h),
          π ≫ Limits.pullback.fst (E.obj l).hom h = Limits.pullback.fst Einf.hom h ≫ (b l).left ∧
          π ≫ Limits.pullback.snd (E.obj l).hom h = Limits.pullback.snd Einf.hom h ∧
          IsAffineOpen A ∧ π ε ∈ A ∧ ∀ e, π e ∈ A → e ∈ O := by
      intro E Einf b hb hlimE haffE O hO ε hε
      let F : Over S ⥤ Scheme.{u} := Over.pullback h ⋙ Over.forget V
      have hF1 : ∀ {U U' : Over S} (t : U' ⟶ U),
          (F.map t : Limits.pullback U'.hom h ⟶ Limits.pullback U.hom h) ≫
              Limits.pullback.fst U.hom h = Limits.pullback.fst U'.hom h ≫ t.left := by
        intro U U' t
        exact Limits.pullback.lift_fst _ _ _
      have hF2 : ∀ {U U' : Over S} (t : U' ⟶ U),
          (F.map t : Limits.pullback U'.hom h ⟶ Limits.pullback U.hom h) ≫
              Limits.pullback.snd U.hom h = Limits.pullback.snd U'.hom h := by
        intro U U' t
        exact Limits.pullback.lift_snd _ _ _
      have hFaff : ∀ {U U' : Over S} (t : U' ⟶ U), IsAffineHom t.left →
          IsAffineHom (F.map t : Limits.pullback U'.hom h ⟶ Limits.pullback U.hom h) := by
        intro U U' t ht
        have hout : IsPullback ((F.map t : Limits.pullback U'.hom h ⟶ Limits.pullback U.hom h) ≫
            Limits.pullback.snd U.hom h) (Limits.pullback.fst U'.hom h) h (t.left ≫ U.hom) := by
