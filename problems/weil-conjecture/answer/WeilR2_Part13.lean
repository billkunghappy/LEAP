  obtain ⟨i', t, hall⟩ := wc_et_limit_eventually_in_open I DS (Limits.pullback U.hom hP) π''
    (fun t => C2 t) (fun T z hz => C3 T z hz) (fun t => htrDS t) i (DS.obj i) (𝟙 _)
