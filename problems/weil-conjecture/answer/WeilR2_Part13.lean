      haveI := P.smooth
      obtain ⟨V, hxV, hV⟩ := wc_ldnm_smooth_transfer E N n (by omega) X ι hι hιX G₀ G₁ v₀ v₁
        hv₀ hv₁ P.Yt g hY hg Z k hZ lam hlamS hrule Λ hΛ1 hΛ2 y' x hwΛ.symm U hyU hU
      exact (hxNS ⟨V, hxV, hV⟩).elim
  refine ⟨hA, ?_⟩
  intro x hx hxt
  have e1 := key x hx hxt
  have e2 := key _ hA hhz
  haveI := hZ.1
  exact k.isClosedEmbedding.injective (e1.trans e2.symm)

theorem wc_ldnm_tv_smooth_chart_basis {X Y : Scheme.{u}} (φ : X ⟶ Y) (n : ℕ)
    [SmoothOfRelativeDimension n φ] (x : X) (U' : X.Opens) (hxU' : x ∈ U') :
    ∃ (V : Y.Opens) (_ : IsAffineOpen V) (O : X.Opens) (_ : IsAffineOpen O) (_ : x ∈ O)
      (_ : O ≤ U') (hOV : O ≤ φ ⁻¹ᵁ V),
      Nonempty (letI := (φ.appLE V O hOV).hom.toAlgebra;
        Module.Basis (Fin n) Γ(X, O) Ω[Γ(X, O)⁄Γ(Y, V)]) :=
by
  have basis : ∀ {R A : Type u} [CommRing R] [CommRing A] [Nontrivial A]
      (f : R →+* A) (hf : RingHom.IsStandardSmoothOfRelativeDimension n f),
      Nonempty (letI := f.toAlgebra; Module.Basis (Fin n) A Ω[A⁄R]) := by
    intro R A _ _ _ f hf
    letI : Algebra R A := f.toAlgebra
    haveI : Algebra.IsStandardSmoothOfRelativeDimension n R A :=
      RingHom.IsStandardSmoothOfRelativeDimension.toAlgebra n hf
    haveI : Algebra.IsStandardSmooth R A :=
      Algebra.IsStandardSmoothOfRelativeDimension.isStandardSmooth n
    haveI : Module.Free A Ω[A⁄R] := Algebra.IsStandardSmooth.free_kaehlerDifferential
    haveI := Algebra.IsStandardSmooth.finitePresentation (R := R) (S := A)
    haveI := Algebra.FiniteType.of_finitePresentation (R := R) (A := A)
    haveI := Algebra.EssFiniteType.of_finiteType R A
    haveI : Module.Finite A Ω[A⁄R] := KaehlerDifferential.finite R A
    have hr := Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential
      (R := R) (S := A) n
    have hfr : Module.finrank A Ω[A⁄R] = n := Module.finrank_eq_of_rank_eq hr
    exact ⟨Module.finBasisOfFinrankEq A Ω[A⁄R] hfr⟩
  obtain ⟨V, hV, O₀, hO₀, hxO₀, e₀, hstd⟩ :=
    SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := n) (f := φ) x
  obtain ⟨g, hgle, hxg⟩ := hO₀.exists_basicOpen_le (V := O₀ ⊓ U') ⟨x, hxO₀, hxU'⟩ hxO₀
  have hO : IsAffineOpen (X.basicOpen g) := hO₀.basicOpen g
  have hOU' : X.basicOpen g ≤ U' := hgle.trans inf_le_right
  have hOO₀ : X.basicOpen g ≤ O₀ := X.basicOpen_le g
  have hOV : X.basicOpen g ≤ φ ⁻¹ᵁ V := hOO₀.trans e₀
  have hfac : (φ.appLE V (X.basicOpen g) hOV).hom =
      (algebraMap Γ(X, O₀) Γ(X, X.basicOpen g)).comp (φ.appLE V O₀ e₀).hom := by
    rw [← Scheme.Hom.appLE_map φ e₀ (homOfLE hOO₀).op, CommRingCat.hom_comp]
    rfl
  haveI := hO₀.isLocalization_basicOpen g
  have h0 := RingHom.IsStandardSmoothOfRelativeDimension.algebraMap_isLocalizationAway
    (Rᵣ := Γ(X, X.basicOpen g)) g
  have h1 := h0.comp hstd
  rw [zero_add, ← hfac] at h1
  haveI : Nonempty (X.basicOpen g) := ⟨⟨x, hxg⟩⟩
  haveI : Nontrivial Γ(X, X.basicOpen g) := Scheme.component_nontrivial X _
  exact ⟨V, hV, X.basicOpen g, hO, hxg, hOU', hOV, basis _ h1⟩

theorem wc_ldnm_tv_stalk_basis {X Y : Scheme.{u}} (φ : X ⟶ Y) (V : Y.Opens) (hV : IsAffineOpen V)
    (O : X.Opens) (hO : IsAffineOpen O) (hOV : O ≤ φ ⁻¹ᵁ V) (n : ℕ)
    (ε : letI := (φ.appLE V O hOV).hom.toAlgebra;
      Module.Basis (Fin n) Γ(X, O) Ω[Γ(X, O)⁄Γ(Y, V)]) (w : X) (hw : w ∈ O) :
    letI := (φ.appLE V O hOV).hom.toAlgebra
    letI := (φ.stalkMap w).hom.toAlgebra
    ∃ e : Module.Basis (Fin n) (X.presheaf.stalk w) Ω[X.presheaf.stalk w⁄Y.presheaf.stalk (φ w)],
      ∀ (s : Γ(X, O)) (j : Fin n),
        e.coord j (KaehlerDifferential.D (Y.presheaf.stalk (φ w)) (X.presheaf.stalk w)
          ((X.presheaf.germ O w hw).hom s)) =
        (X.presheaf.germ O w hw).hom (ε.coord j (KaehlerDifferential.D Γ(Y, V) Γ(X, O) s)) :=
by
  have key : ∀ {A B R S : Type u} [CommRing A] [CommRing B] [CommRing R] [CommRing S]
      [Algebra A B] [Algebra A S] [Algebra B S] [IsScalarTower A B S]
      [Algebra A R] [Algebra R S] [IsScalarTower A R S] [Subsingleton Ω[R⁄A]]
      (M : Submonoid B) [IsLocalization M S] (ε : Module.Basis (Fin n) B Ω[B⁄A]),
      ∃ e : Module.Basis (Fin n) S Ω[S⁄R], ∀ (b : B) (j : Fin n),
        e.coord j (KaehlerDifferential.D R S (algebraMap B S b)) =
          algebraMap B S (ε.coord j (KaehlerDifferential.D A B b)) := by
    intro A B R S _ _ _ _ _ _ _ _ _ _ _ _ M _ ε
    have hinj : Function.Injective (KaehlerDifferential.map A R S S) := by
      rw [injective_iff_map_eq_zero]
      intro x hx
      obtain ⟨t, rfl⟩ := (KaehlerDifferential.exact_mapBaseChange_map A R S x).mp hx
      rw [Subsingleton.elim t 0, map_zero]
    let L : Ω[S⁄A] ≃ₗ[S] Ω[S⁄R] :=
      LinearEquiv.ofBijective _ ⟨hinj, KaehlerDifferential.map_surjective A R S⟩
    let ε' := Module.Basis.ofIsLocalizedModule S M (KaehlerDifferential.map A A B S) ε
    refine ⟨ε'.map L, fun b j => ?_⟩
    have hL : L.symm (KaehlerDifferential.D R S (algebraMap B S b)) =
        KaehlerDifferential.D A S (algebraMap B S b) := by
      rw [LinearEquiv.symm_apply_eq]
      show _ = KaehlerDifferential.map A R S S _
      rw [KaehlerDifferential.map_D]
      rfl
    rw [Module.Basis.coord_apply, Module.Basis.map_repr, LinearEquiv.trans_apply, hL,
      ← KaehlerDifferential.map_D A A B S, Module.Basis.ofIsLocalizedModule_repr_apply,
      Module.Basis.coord_apply]
  letI instAB : Algebra Γ(Y, V) Γ(X, O) := (φ.appLE V O hOV).hom.toAlgebra
  letI instRS : Algebra (Y.presheaf.stalk (φ w)) (X.presheaf.stalk w) :=
    (φ.stalkMap w).hom.toAlgebra
  have hφw : φ w ∈ V := hOV hw
  letI instBS : Algebra Γ(X, O) (X.presheaf.stalk w) := (X.presheaf.germ O w hw).hom.toAlgebra
  letI instAR : Algebra Γ(Y, V) (Y.presheaf.stalk (φ w)) :=
    (Y.presheaf.germ V (φ w) hφw).hom.toAlgebra
  letI instAS : Algebra Γ(Y, V) (X.presheaf.stalk w) :=
    (φ.appLE V O hOV ≫ X.presheaf.germ O w hw).hom.toAlgebra
  haveI : IsScalarTower Γ(Y, V) Γ(X, O) (X.presheaf.stalk w) :=
    IsScalarTower.of_algebraMap_eq' rfl
  have hcomm : Y.presheaf.germ V (φ w) hφw ≫ φ.stalkMap w =
      φ.appLE V O hOV ≫ X.presheaf.germ O w hw := by
    rw [Scheme.Hom.germ_stalkMap, ← TopCat.Presheaf.germ_res X.presheaf (homOfLE hOV) w hw,
      ← Category.assoc]
    rfl
  haveI : IsScalarTower Γ(Y, V) (Y.presheaf.stalk (φ w)) (X.presheaf.stalk w) :=
    IsScalarTower.of_algebraMap_eq' (by
      show (φ.appLE V O hOV ≫ X.presheaf.germ O w hw).hom =
        (φ.stalkMap w).hom.comp (Y.presheaf.germ V (φ w) hφw).hom
      rw [← hcomm]
      rfl)
  haveI : IsLocalization (hO.primeIdealOf ⟨w, hw⟩).asIdeal.primeCompl (X.presheaf.stalk w) :=
    hO.isLocalization_stalk ⟨w, hw⟩
  haveI : IsLocalization (hV.primeIdealOf ⟨φ w, hφw⟩).asIdeal.primeCompl
      (Y.presheaf.stalk (φ w)) :=
    hV.isLocalization_stalk ⟨φ w, hφw⟩
  haveI : Algebra.FormallyUnramified Γ(Y, V) (Y.presheaf.stalk (φ w)) :=
    Algebra.FormallyUnramified.of_isLocalization (hV.primeIdealOf ⟨φ w, hφw⟩).asIdeal.primeCompl
  haveI : Subsingleton Ω[Y.presheaf.stalk (φ w)⁄Γ(Y, V)] :=
    Algebra.FormallyUnramified.subsingleton_kaehlerDifferential
  obtain ⟨e, he⟩ := key (A := Γ(Y, V)) (B := Γ(X, O)) (R := Y.presheaf.stalk (φ w))
    (S := X.presheaf.stalk w) (hO.primeIdealOf ⟨w, hw⟩).asIdeal.primeCompl ε
  exact ⟨e, fun s j => he s j⟩

theorem wc_ldnm_tv_germ_ne_zero (E : Type u) [Field E] {Z P : Scheme.{u}} (s : P ⟶ Spec (.of E))
    (k : Z ⟶ P) (m₁ m₂ : ℕ) [SmoothOfRelativeDimension m₁ s]
    [SmoothOfRelativeDimension m₂ (k ≫ s)] (hm : m₁ ≠ m₂) (x : Z) (F : P.presheaf.stalk (k x))
    (hsurj : Function.Surjective (k.stalkMap x).hom)
    (hker : RingHom.ker (k.stalkMap x).hom = Ideal.span {F}) : F ≠ 0 :=
by
  intro hF
  subst hF
  have hinj : Function.Injective (k.stalkMap x).hom := by
    rw [RingHom.injective_iff_ker_eq_bot, hker, Ideal.span_singleton_eq_bot.mpr rfl]
  have hbij : Function.Bijective (k.stalkMap x).hom := ⟨hinj, hsurj⟩
  have key : ∀ (A B C : Type u) [CommRing A] [CommRing B] [CommRing C]
      [Nontrivial B] [Nontrivial C] [Algebra A B] [Algebra B C] [Algebra A C]
      [IsScalarTower A B C] [Module.Free B Ω[B⁄A]],
      Function.Bijective (algebraMap B C) →
      Module.finrank C Ω[C⁄A] = Module.finrank B Ω[B⁄A] := by
    intro A B C _ _ _ _ _ _ _ _ _ _ h
    let e : B ≃ₐ[B] C := AlgEquiv.ofBijective (Algebra.ofId B C) h
    have : Algebra.FormallyEtale B C := Algebra.FormallyEtale.of_equiv e
    rw [← LinearEquiv.finrank_eq (KaehlerDifferential.tensorKaehlerEquivOfFormallyEtale A B C)]
    exact Module.finrank_baseChange
  obtain ⟨_, hfree1, _, hrank1⟩ := wc_ldp_il_stalk_of_smooth s m₁ (k x)
  obtain ⟨_, _, _, hrank2⟩ := wc_ldp_il_stalk_of_smooth (k ≫ s) m₂ x
  letI iAB : Algebra ((Spec (.of E)).presheaf.stalk ((k ≫ s) x)) (P.presheaf.stalk (k x)) :=
    (s.stalkMap (k x)).hom.toAlgebra
  letI iBC : Algebra (P.presheaf.stalk (k x)) (Z.presheaf.stalk x) :=
    (k.stalkMap x).hom.toAlgebra
  letI iAC : Algebra ((Spec (.of E)).presheaf.stalk ((k ≫ s) x)) (Z.presheaf.stalk x) :=
    ((k ≫ s).stalkMap x).hom.toAlgebra
  haveI : IsScalarTower ((Spec (.of E)).presheaf.stalk ((k ≫ s) x)) (P.presheaf.stalk (k x))
      (Z.presheaf.stalk x) := IsScalarTower.of_algebraMap_eq' (by
    show ((k ≫ s).stalkMap x).hom = (k.stalkMap x).hom.comp (s.stalkMap (k x)).hom
    exact congrArg CommRingCat.Hom.hom (Scheme.Hom.stalkMap_comp k s x))
  haveI : Module.Free (P.presheaf.stalk (k x))
      Ω[P.presheaf.stalk (k x)⁄(Spec (.of E)).presheaf.stalk ((k ≫ s) x)] := hfree1
  have h := key ((Spec (.of E)).presheaf.stalk ((k ≫ s) x)) (P.presheaf.stalk (k x))
    (Z.presheaf.stalk x) hbij
  exact hm (hrank1.symm.trans (h.symm.trans hrank2))

theorem wc_ldnm_tv_stalk_fs_of_smooth {A B : Scheme.{u}} (φ : A ⟶ B) (x : A) (U : A.Opens)
    (hx : x ∈ U) (hU : Smooth (U.ι ≫ φ)) : (φ.stalkMap x).hom.FormallySmooth :=
by
  classical
  let y : (U : Scheme.{u}) := ⟨x, hx⟩
  haveI : Smooth (U.ι ≫ φ) := hU
  obtain ⟨U', hU', V', hV', hy, e, hstd⟩ := Smooth.exists_isStandardSmooth (U.ι ≫ φ) y
  have hfy : (U.ι ≫ φ) y ∈ U' := e hy
  have h1 : ((U.ι ≫ φ).appLE U' V' e).hom.FormallySmooth := hstd.smooth.formallySmooth
  letI : Algebra Γ(B, U') (B.presheaf.stalk ((U.ι ≫ φ) y)) :=
    TopCat.Presheaf.algebra_section_stalk B.presheaf ⟨(U.ι ≫ φ) y, hfy⟩
  haveI : IsLocalization.AtPrime (B.presheaf.stalk ((U.ι ≫ φ) y))
      (hU'.primeIdealOf ⟨(U.ι ≫ φ) y, hfy⟩).asIdeal :=
    hU'.isLocalization_stalk ⟨(U.ι ≫ φ) y, hfy⟩
  letI : Algebra Γ(U, V') ((U : Scheme.{u}).presheaf.stalk y) :=
    TopCat.Presheaf.algebra_section_stalk (U : Scheme.{u}).presheaf ⟨y, hy⟩
  haveI : IsLocalization.AtPrime ((U : Scheme.{u}).presheaf.stalk y)
      (hV'.primeIdealOf ⟨y, hy⟩).asIdeal :=
    hV'.isLocalization_stalk ⟨y, hy⟩
  have h2 : (algebraMap Γ(U, V') ((U : Scheme.{u}).presheaf.stalk y)).FormallySmooth :=
    RingHom.formallySmooth_algebraMap.mpr
      (Algebra.FormallySmooth.of_isLocalization (hV'.primeIdealOf ⟨y, hy⟩).asIdeal.primeCompl)
  have h3 := RingHom.FormallySmooth.comp h1 h2
  have key : (U.ι ≫ φ).appLE U' V' e ≫ (U : Scheme.{u}).presheaf.germ V' y hy =
      B.presheaf.germ U' ((U.ι ≫ φ) y) hfy ≫ (U.ι ≫ φ).stalkMap y := by
    rw [Scheme.Hom.germ_stalkMap, Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
  have hg : ((U.ι ≫ φ).stalkMap y).hom.comp
        (algebraMap Γ(B, U') (B.presheaf.stalk ((U.ι ≫ φ) y))) =
      (algebraMap Γ(U, V') ((U : Scheme.{u}).presheaf.stalk y)).comp
        ((U.ι ≫ φ).appLE U' V' e).hom := by
    ext c
    exact congrArg (fun ψ => ψ.hom c) key.symm
  rw [← hg] at h3
  letI : Algebra (B.presheaf.stalk ((U.ι ≫ φ) y)) ((U : Scheme.{u}).presheaf.stalk y) :=
    ((U.ι ≫ φ).stalkMap y).hom.toAlgebra
  letI : Algebra Γ(B, U') ((U : Scheme.{u}).presheaf.stalk y) :=
    (((U.ι ≫ φ).stalkMap y).hom.comp
      (algebraMap Γ(B, U') (B.presheaf.stalk ((U.ι ≫ φ) y)))).toAlgebra
  haveI : IsScalarTower Γ(B, U') (B.presheaf.stalk ((U.ι ≫ φ) y))
      ((U : Scheme.{u}).presheaf.stalk y) :=
    IsScalarTower.of_algebraMap_eq' rfl
  haveI : Algebra.FormallySmooth Γ(B, U') ((U : Scheme.{u}).presheaf.stalk y) := h3
  have h5 : ((U.ι ≫ φ).stalkMap y).hom.FormallySmooth :=
    Algebra.FormallySmooth.localization_base
      (hU'.primeIdealOf ⟨(U.ι ≫ φ) y, hfy⟩).asIdeal.primeCompl
  have hcomp := Scheme.Hom.stalkMap_comp U.ι φ y
  have h5' : (φ.stalkMap (U.ι y) ≫ U.ι.stalkMap y).hom.FormallySmooth :=
    Eq.mp (congrArg (fun g => (CommRingCat.Hom.hom g).FormallySmooth) hcomp) h5
  have hφ : φ.stalkMap (U.ι y) =
      (φ.stalkMap (U.ι y) ≫ U.ι.stalkMap y) ≫ inv (U.ι.stalkMap y) := by
    rw [Category.assoc, IsIso.hom_inv_id, Category.comp_id]
  change (φ.stalkMap (U.ι y)).hom.FormallySmooth
  rw [hφ, CommRingCat.hom_comp]
  exact RingHom.FormallySmooth.comp h5'
    (RingHom.FormallySmooth.of_bijective
      (ConcreteCategory.bijective_of_isIso (inv (U.ι.stalkMap y))))

theorem wc_ldnm_tv_hyp_fs_iff (C B S : Type u) [CommRing C] [CommRing B] [IsLocalRing B]
    [CommRing S] [IsLocalRing S] [Algebra C B] [Algebra B S] [Algebra C S] [IsScalarTower C B S]
    [Algebra.FormallySmooth C B] (n : ℕ) (e : Module.Basis (Fin n) B Ω[B⁄C])
    (hsurj : Function.Surjective (algebraMap B S)) (F : B)
    (hker : RingHom.ker (algebraMap B S) = Ideal.span {F}) (hF : F ≠ 0) :
    Algebra.FormallySmooth C S ↔ ∃ j, IsUnit (e.coord j (KaehlerDifferential.D C B F)) :=
by


  have crit : ∀ (B R S : Type u) [CommRing B] [CommRing R] [CommRing S]
      [IsLocalRing S] [Algebra B R] [Algebra B S] [Algebra.FormallySmooth B R]
      [Module.Free R Ω[R⁄B]] [Module.Finite R Ω[R⁄B]]
      (ψ : R →ₐ[B] S) (hψ : Function.Surjective ψ) (h : R)
      (hker : RingHom.ker ψ = Ideal.span {h})
      (δ : R →+ IsLocalRing.ResidueField S)
      (hδ : ∀ a b : R, δ (a * b) =
        IsLocalRing.residue S (ψ a) * δ b + IsLocalRing.residue S (ψ b) * δ a)
      (hδB : ∀ c : B, δ (algebraMap B R c) = 0) (hδh : δ h ≠ 0),
      Algebra.FormallySmooth B S ∧ True := by
    intro B R S _ _ _ _ _ _ _ _ _ ψ hψ h hker δ hδ hδB hδh
    refine ⟨?_, trivial⟩
    classical
    letI : Algebra R S := (ψ : R →+* S).toAlgebra
    haveI : IsScalarTower B R S := IsScalarTower.of_algebraMap_eq (fun c => (ψ.commutes c).symm)
    have hsurj : Function.Surjective (algebraMap R S) := hψ
    have hkerS : RingHom.ker (algebraMap R S) = Ideal.span {h} := by
      rw [← hker]; ext r; rw [RingHom.mem_ker, RingHom.mem_ker]; rfl
    have hδ' : ∀ a b : R, δ (a * b) =
        IsLocalRing.residue S (algebraMap R S a) * δ b +
          IsLocalRing.residue S (algebraMap R S b) * δ a := fun a b => hδ a b
    obtain ⟨φ, hφ⟩ : ∃ φ : TensorProduct R S Ω[R⁄B] →ₗ[S] S,
        φ (TensorProduct.tmul R (1 : S) (KaehlerDifferential.D B R h)) = 1 := by
      have hsm : ∀ (r : R) (k : IsLocalRing.ResidueField S),
          r • k = IsLocalRing.residue S (algebraMap R S r) * k := by
        intro r k
        rw [Algebra.smul_def, IsScalarTower.algebraMap_apply R S (IsLocalRing.ResidueField S),
          IsLocalRing.ResidueField.algebraMap_eq]
      have hsmB : ∀ (c : B) (k : IsLocalRing.ResidueField S),
          c • k = IsLocalRing.residue S (algebraMap R S (algebraMap B R c)) * k := by
        intro c k
        rw [← hsm, algebraMap_smul]
      let δL : R →ₗ[B] IsLocalRing.ResidueField S :=
        { toFun := δ
          map_add' := δ.map_add
          map_smul' := fun c r => by
            simp only [RingHom.id_apply]
            rw [Algebra.smul_def, hδ', hδB, mul_zero, add_zero, hsmB] }
      let d : Derivation B R (IsLocalRing.ResidueField S) :=
        Derivation.mk' δL (fun a b => by
          show δ (a * b) = a • δ b + b • δ a
          rw [hδ', hsm, hsm])
      let φb : Ω[R⁄B] →ₗ[R] IsLocalRing.ResidueField S := d.liftKaehlerDifferential
      have hφb : ∀ r : R, φb (KaehlerDifferential.D B R r) = δ r := fun r => by
        show d.liftKaehlerDifferential (KaehlerDifferential.D B R r) = δ r
        rw [Derivation.liftKaehlerDifferential_comp_D]
        rfl
      let b := Module.Free.chooseBasis R Ω[R⁄B]
      have hc : ∀ i, ∃ s : S, IsLocalRing.residue S s = φb (b i) :=
        fun i => IsLocalRing.residue_surjective _
      choose c hc using hc
      let bS := Algebra.TensorProduct.basis S b
      let φ₁ : TensorProduct R S Ω[R⁄B] →ₗ[S] S := bS.constr S c
      have hcompat : ∀ ω : Ω[R⁄B],
          IsLocalRing.residue S (φ₁ (TensorProduct.tmul R (1 : S) ω)) = φb ω := by
        have key : ((IsScalarTower.toAlgHom R S (IsLocalRing.ResidueField S)).toLinearMap ∘ₗ
            (φ₁.restrictScalars R) ∘ₗ (TensorProduct.mk R S Ω[R⁄B] 1)) = φb := by
          apply b.ext
          intro i
          simp only [LinearMap.coe_comp, Function.comp_apply, TensorProduct.mk_apply,
            LinearMap.coe_restrictScalars, AlgHom.toLinearMap_apply, IsScalarTower.coe_toAlgHom']
          have : TensorProduct.tmul R (1 : S) (b i) = bS i := by
            rw [Algebra.TensorProduct.basis_apply]
          rw [this, Module.Basis.constr_basis, ← hc i, IsLocalRing.ResidueField.algebraMap_eq]
        intro ω
        have := LinearMap.congr_fun key ω
        simpa [IsLocalRing.ResidueField.algebraMap_eq] using this
      have hu : IsUnit (φ₁ (TensorProduct.tmul R (1 : S) (KaehlerDifferential.D B R h))) := by
        rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hcompat, hφb]
        exact hδh
      refine ⟨((hu.unit⁻¹ : Sˣ) : S) • φ₁, ?_⟩
      rw [LinearMap.smul_apply, smul_eq_mul]
      exact hu.val_inv_mul
    set I := RingHom.ker (algebraMap R S) with hI
    have hhI : h ∈ I := by rw [hkerS]; exact Ideal.subset_span rfl
    have hh0 : algebraMap R S h = 0 := hhI
    have hDrh : ∀ r : R, TensorProduct.tmul R (1 : S) (KaehlerDifferential.D B R (r * h)) =
        r • (TensorProduct.tmul R (1 : S) (KaehlerDifferential.D B R h)) := by
      intro r
      rw [Derivation.leibniz, TensorProduct.tmul_add, TensorProduct.tmul_smul,
        TensorProduct.tmul_smul, ← algebraMap_smul S h, hh0, zero_smul, add_zero]
    set c₀ : I.Cotangent := I.toCotangent ⟨h, hhI⟩ with hc₀
    let f₀ : R →ₗ[R] I.Cotangent := LinearMap.toSpanSingleton R I.Cotangent c₀
    have hf₀ : ∀ r : R, f₀ r = I.toCotangent ⟨r * h, I.mul_mem_left r hhI⟩ := by
      intro r
      show r • c₀ = _
      rw [hc₀, ← map_smul]
      rfl
    have hle : I ≤ LinearMap.ker f₀ := by
      intro i hi
      rw [LinearMap.mem_ker, hf₀, Ideal.toCotangent_eq_zero, pow_two]
      exact Ideal.mul_mem_mul hi hhI
    let L : (R ⧸ I) →ₗ[R] I.Cotangent := Submodule.liftQ I f₀ hle
    let eq : (R ⧸ RingHom.ker (Algebra.ofId R S)) ≃ₐ[R] S :=
      Ideal.quotientKerAlgEquivOfSurjective (f := Algebra.ofId R S) hsurj
    let l : TensorProduct R S Ω[R⁄B] →ₗ[R] I.Cotangent :=
      L ∘ₗ eq.symm.toLinearEquiv.toLinearMap ∘ₗ φ.restrictScalars R
    have hl : ∀ r : R, l (r • (TensorProduct.tmul R (1 : S) (KaehlerDifferential.D B R h))) =
        I.toCotangent ⟨r * h, I.mul_mem_left r hhI⟩ := by
      intro r
      have hl1 : l (TensorProduct.tmul R (1 : S) (KaehlerDifferential.D B R h)) = c₀ := by
        show L (eq.symm (φ (TensorProduct.tmul R (1 : S) (KaehlerDifferential.D B R h)))) = c₀
        rw [hφ, map_one]
        show L (Submodule.Quotient.mk 1) = c₀
        rw [Submodule.liftQ_apply]
        show (1 : R) • c₀ = c₀
        rw [one_smul]
      rw [map_smul, hl1, ← hf₀]
      rfl
    refine (Algebra.FormallySmooth.iff_split_injection (P := R) hsurj).mpr ⟨l, ?_⟩
    apply LinearMap.ext
    intro ξ
    obtain ⟨⟨x, hx⟩, rfl⟩ := I.toCotangent_surjective ξ
    have hx' : x ∈ Ideal.span {h} := hkerS ▸ hx
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.mp hx'
    rw [LinearMap.comp_apply, KaehlerDifferential.kerCotangentToTensor_toCotangent]
    show l (TensorProduct.tmul R (1 : S) (KaehlerDifferential.D B R (r * h))) = _
    rw [hDrh, hl]
    rfl
  have hFI : F ∈ RingHom.ker (algebraMap B S) := by
    rw [hker]; exact Ideal.mem_span_singleton_self F
  constructor
  · intro hS
    obtain ⟨l, hl⟩ :=
      (Algebra.FormallySmooth.iff_split_injection (R := C) (P := B) (A := S) hsurj).mp hS
    by_contra hne
    push_neg at hne
    let Fh : RingHom.ker (algebraMap B S) := ⟨F, hFI⟩
    have hcyc : ∀ z : (RingHom.ker (algebraMap B S)).Cotangent, ∃ b : B,
        z = b • (RingHom.ker (algebraMap B S)).toCotangent Fh := by
      intro z
      obtain ⟨x, rfl⟩ := Ideal.toCotangent_surjective _ z
      have hx : (x : B) ∈ Ideal.span {F} := hker ▸ x.2
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hx
      refine ⟨b, ?_⟩
      rw [← map_smul]
      congr 1
      ext
      simp [Fh, hb]
    choose b hb using fun j => hcyc (l (TensorProduct.tmul B (1 : S) (e j)))
    have key : (RingHom.ker (algebraMap B S)).toCotangent Fh =
        (∑ j, e.coord j (KaehlerDifferential.D C B F) * b j) •
          (RingHom.ker (algebraMap B S)).toCotangent Fh := by
      calc (RingHom.ker (algebraMap B S)).toCotangent Fh
          = l (KaehlerDifferential.kerCotangentToTensor C B S
              ((RingHom.ker (algebraMap B S)).toCotangent Fh)) := by
            rw [← LinearMap.comp_apply, hl, LinearMap.id_apply]
        _ = l (TensorProduct.tmul B (1 : S) (KaehlerDifferential.D C B F)) := by
            rw [KaehlerDifferential.kerCotangentToTensor_toCotangent]
        _ = l (∑ j, e.coord j (KaehlerDifferential.D C B F) •
              (TensorProduct.tmul B (1 : S) (e j))) := by
            conv_lhs => rw [← e.sum_repr (KaehlerDifferential.D C B F)]
            rw [TensorProduct.tmul_sum]
            simp only [TensorProduct.tmul_smul, Module.Basis.coord_apply]
        _ = ∑ j, e.coord j (KaehlerDifferential.D C B F) •
              (b j • (RingHom.ker (algebraMap B S)).toCotangent Fh) := by
            rw [map_sum]
            refine Finset.sum_congr rfl (fun j _ => ?_)
            rw [map_smul, ← hb j]
        _ = _ := by
            rw [Finset.sum_smul]
            simp only [smul_smul]
    have ht : (∑ j, e.coord j (KaehlerDifferential.D C B F) * b j) ∈
        IsLocalRing.maximalIdeal B :=
      Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_right _ _
        ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr (hne j))))
    have hunit := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _
      ((IsLocalRing.mem_maximalIdeal _).mp ht)
    have h1 : (1 - ∑ j, e.coord j (KaehlerDifferential.D C B F) * b j) •
        (RingHom.ker (algebraMap B S)).toCotangent Fh = 0 := by
      rw [sub_smul, one_smul, ← key, sub_self]
    have h0 : (RingHom.ker (algebraMap B S)).toCotangent Fh = 0 := by
      rw [← smul_zero (1 - ∑ j, e.coord j (KaehlerDifferential.D C B F) * b j)] at h1
      exact (hunit.smul_left_cancel).mp h1
    have hmem : F ∈ (RingHom.ker (algebraMap B S)) ^ 2 :=
      (Ideal.toCotangent_eq_zero _ Fh).mp h0
    rw [hker, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hmem
    obtain ⟨r, hr⟩ := hmem
    have hFker : algebraMap B S F = 0 := (RingHom.mem_ker).mp hFI
    have hFnu : ¬ IsUnit F := fun hu => by
      have := hu.map (algebraMap B S)
      rw [hFker] at this
      exact not_isUnit_zero this
    have hrF : r * F ∈ IsLocalRing.maximalIdeal B :=
      Ideal.mul_mem_left _ r ((IsLocalRing.mem_maximalIdeal _).mpr (mem_nonunits_iff.mpr hFnu))
    have hunit2 := IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _
      ((IsLocalRing.mem_maximalIdeal _).mp hrF)
    have hz : F * (1 - r * F) = 0 := by linear_combination -hr
    exact hF ((hunit2.mul_left_eq_zero).mp hz)
  · rintro ⟨j, hj⟩
    have : Module.Free B Ω[B⁄C] := Module.Free.of_basis e
    have : Module.Finite B Ω[B⁄C] := Module.Finite.of_basis e
    let ψ : B →ₐ[C] S := IsScalarTower.toAlgHom C B S
    have hψa : ∀ a, ψ a = algebraMap B S a := fun a => rfl
    have hψ : Function.Surjective ψ := hsurj
    have hkerψ : RingHom.ker ψ = Ideal.span {F} := by
      rw [← hker]
      ext x
      simp only [RingHom.mem_ker, hψa]
    let δ : B →+ IsLocalRing.ResidueField S :=
      AddMonoidHom.mk' (fun a => IsLocalRing.residue S
        (algebraMap B S (e.coord j (KaehlerDifferential.D C B a)))) (by intro a b; simp)
    have hδ : ∀ a b : B, δ (a * b) =
        IsLocalRing.residue S (ψ a) * δ b + IsLocalRing.residue S (ψ b) * δ a := by
      intro a b
      simp only [δ, AddMonoidHom.mk'_apply, Derivation.leibniz, map_add, map_smul, smul_eq_mul,
        map_mul, hψa]
    have hδB : ∀ c : C, δ (algebraMap C B c) = 0 := by
      intro c
      simp only [δ, AddMonoidHom.mk'_apply, Derivation.map_algebraMap, map_zero]
    have hδh : δ F ≠ 0 := by
      simp only [δ, AddMonoidHom.mk'_apply]
      exact (IsLocalRing.residue_ne_zero_iff_isUnit _).mpr (hj.map _)
    exact (crit C B S ψ hψ F hkerψ δ hδ hδB hδh).1

theorem wc_ldnm_tv_ns_local_eqns (F' : Type u) [Field F'] (E : Type u) [Field E] [Finite E]
    [Algebra F' E] (Y : Over (Spec (.of F'))) (n N : ℕ) (hn2 : 2 ≤ n)
    (P : wcPreDatum F' E Y n) (X : Over (Spec (.of E))) [IsProper X.hom]
    [GeometricallyIrreducible X.hom] [SmoothOfRelativeDimension n X.hom]
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr E N = X.hom)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (y : Fin P.m → (Spec (.of E) ⟶ X.left)) (c : Fin P.m → Fin 2 → E)
    (hP : wcLdpGoodPencil E N n X ι G₀ G₁ P.m y c)
    (g : P.Yt.left ⟶ Limits.pullback X.hom (wcProjKStr E 1))
    (hY : wcLdnmLocEq (Limits.pullback X.hom (wcProjKStr E 1)) (Fin (N + 1) × Fin 2)
      (wcLdpW E N X ι) (wcLdpH E N X ι G₀ G₁) P.Yt.left g)
    (hg : g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom = P.Yt.hom)
    (hPf : P.f = g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1))
    (hxs : ∀ i, P.xs i ≫ g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) = y i)
    (v₀ v₁ : Fin (N + 1) × Fin (N + 1) → E)
    (hv₀ : G₀ = wcLdpQuad E N (fun p q => v₀ (p, q)))
    (hv₁ : G₁ = wcLdpQuad E N (fun p q => v₁ (p, q)))
    (Z : Scheme.{u}) (k : Z ⟶ Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
    (hZ : wcLdnmLocEq (Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
      (Fin (N + 1) × Fin (wcLdnmM N + 1)) (wcLdnmU E N X ι) (wcLdnmPhi E N X ι) Z k)
    (lam : (wcP1Over E).left ⟶ wcProjK E (wcLdnmM N)) (hlam : IsClosedImmersion lam)
    (hlamS : lam ≫ wcProjKStr E (wcLdnmM N) = (wcP1Over E).hom)
    (hrule : wcLdnmPencilRule E N v₀ v₁ lam)
    (p : P.Yt.left ⟶ Z)
    (hp : IsPullback p P.f (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) lam) :
    ∀ i : Fin P.m, ∃ (a : Fin (N + 1) × Fin (wcLdnmM N + 1))
      (ha : k (p (P.xs i (IsLocalRing.closedPoint E))) ∈ wcLdnmU E N X ι a)
      (W : Z.Opens) (_ : IsAffineOpen W) (hzW : p (P.xs i (IsLocalRing.closedPoint E)) ∈ W)
      (ψ : Fin n → Γ(Z, W)),
      (∀ (x : Z) (hx : x ∈ W),
        x ∈ wcLdnmNS (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) ↔
          ∀ j, (Z.presheaf.germ W x hx).hom (ψ j) ∈
            IsLocalRing.maximalIdeal (Z.presheaf.stalk x)) ∧
      letI := ((Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))).stalkMap
        (k (p (P.xs i (IsLocalRing.closedPoint E))))).hom.toAlgebra
      ∃ e : Module.Basis (Fin n)
          ((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.stalk
            (k (p (P.xs i (IsLocalRing.closedPoint E)))))
          (KaehlerDifferential ((wcProjK E (wcLdnmM N)).presheaf.stalk
            ((Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)))
              (k (p (P.xs i (IsLocalRing.closedPoint E))))))
            ((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.stalk
              (k (p (P.xs i (IsLocalRing.closedPoint E)))))),
        ∀ j, (Z.presheaf.germ W _ hzW).hom (ψ j) =
          (k.stalkMap (p (P.xs i (IsLocalRing.closedPoint E)))).hom
            (e.coord j (KaehlerDifferential.D ((wcProjK E (wcLdnmM N)).presheaf.stalk
              ((Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)))
                (k (p (P.xs i (IsLocalRing.closedPoint E))))))
              ((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.stalk
                (k (p (P.xs i (IsLocalRing.closedPoint E)))))
              (((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ
                (wcLdnmU E N X ι a) _ ha).hom (wcLdnmPhi E N X ι a)))) :=
by
  classical



  have L1 : ∀ {A B : Scheme.{u}} (f : A ⟶ B) [LocallyOfFiniteType f] [IsLocallyNoetherian B],
      LocallyOfFinitePresentation f := by
    intro A B f _ _
    rw [HasRingHomProperty.iff_appLE (P := @LocallyOfFinitePresentation)]
    intro U V e
    haveI := IsLocallyNoetherian.component_noetherian U
    exact RingHom.FinitePresentation.of_finiteType.mp
      (HasRingHomProperty.appLE (P := @LocallyOfFiniteType) f ‹_› U V e)



  have L7 : ∀ {Z₁ P₁ Q₁ : Scheme.{u}} (k₁ : Z₁ ⟶ P₁) (q₁ : P₁ ⟶ Q₁) (n₁ : ℕ)
      [SmoothOfRelativeDimension n₁ q₁] [LocallyOfFinitePresentation (k₁ ≫ q₁)] (x : Z₁)
      (F : P₁.presheaf.stalk (k₁ x)) (hsurj : Function.Surjective (k₁.stalkMap x).hom)
      (hker : RingHom.ker (k₁.stalkMap x).hom = Ideal.span {F}) (hF : F ≠ 0),
      letI := (q₁.stalkMap (k₁ x)).hom.toAlgebra
      ∀ e : Module.Basis (Fin n₁) (P₁.presheaf.stalk (k₁ x))
          Ω[P₁.presheaf.stalk (k₁ x)⁄Q₁.presheaf.stalk (q₁ (k₁ x))],
        (x ∈ wcLdnmNS (k₁ ≫ q₁) ↔ ∀ j, e.coord j (KaehlerDifferential.D
          (Q₁.presheaf.stalk (q₁ (k₁ x))) (P₁.presheaf.stalk (k₁ x)) F) ∈
            IsLocalRing.maximalIdeal (P₁.presheaf.stalk (k₁ x))) := by
    intro Z₁ P₁ Q₁ k₁ q₁ n₁ _ _ x F hsurj hker hF
    letI algCB : Algebra (Q₁.presheaf.stalk (q₁ (k₁ x))) (P₁.presheaf.stalk (k₁ x)) :=
      (q₁.stalkMap (k₁ x)).hom.toAlgebra
    intro e
    letI algBS : Algebra (P₁.presheaf.stalk (k₁ x)) (Z₁.presheaf.stalk x) :=
      (k₁.stalkMap x).hom.toAlgebra
    letI algCS : Algebra (Q₁.presheaf.stalk (q₁ (k₁ x))) (Z₁.presheaf.stalk x) :=
      ((k₁.stalkMap x).hom.comp (q₁.stalkMap (k₁ x)).hom).toAlgebra
    haveI : IsScalarTower (Q₁.presheaf.stalk (q₁ (k₁ x))) (P₁.presheaf.stalk (k₁ x))
        (Z₁.presheaf.stalk x) := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
    haveI : Algebra.FormallySmooth (Q₁.presheaf.stalk (q₁ (k₁ x))) (P₁.presheaf.stalk (k₁ x)) :=
      (wc_ldp_il_stalk_of_smooth q₁ n₁ (k₁ x)).1
    have hcompeq : (k₁ ≫ q₁).stalkMap x = q₁.stalkMap (k₁ x) ≫ k₁.stalkMap x :=
      Scheme.Hom.stalkMap_comp k₁ q₁ x
    have h2 : ((k₁ ≫ q₁).stalkMap x).hom =
        (k₁.stalkMap x).hom.comp (q₁.stalkMap (k₁ x)).hom :=
      congrArg CommRingCat.Hom.hom hcompeq
    have hfs : ((k₁ ≫ q₁).stalkMap x).hom.FormallySmooth ↔
        Algebra.FormallySmooth (Q₁.presheaf.stalk (q₁ (k₁ x))) (Z₁.presheaf.stalk x) := by
      first
        | (rw [h2]; rfl)
        | (erw [h2]; rfl)
        | (simp only [h2]; rfl)
        | exact Iff.of_eq (by rw [h2]; rfl)
        | exact h2 ▸ Iff.rfl
    have L3 := wc_ldnm_tv_hyp_fs_iff (Q₁.presheaf.stalk (q₁ (k₁ x))) (P₁.presheaf.stalk (k₁ x))
      (Z₁.presheaf.stalk x) n₁ e hsurj F hker hF
    have hmem : ∀ u : P₁.presheaf.stalk (k₁ x),
        u ∈ IsLocalRing.maximalIdeal (P₁.presheaf.stalk (k₁ x)) ↔ ¬ IsUnit u := by
      intro u
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    constructor
    · intro hx j
      have hx' : ¬ ∃ U : Z₁.Opens, x ∈ U ∧ Smooth (U.ι ≫ (k₁ ≫ q₁)) := hx
      rw [hmem]
      intro hu
      exact hx' (wc_ldp_il_spread_rel (k₁ ≫ q₁) x (hfs.mpr (L3.mpr ⟨j, hu⟩)))
    · intro hall
