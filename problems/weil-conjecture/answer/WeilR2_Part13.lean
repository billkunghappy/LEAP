    intro K _ n Y s _ V hV x hxV
    obtain ⟨U, hU, V', hV', hxV', e, hss⟩ :=
      SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := n) (f := s) x
    obtain ⟨g₀, hg₀C, hg₀⟩ := hss.exists_etale_mvPolynomial
    have hUtop : U = ⊤ := by
      have h1 : s x ∈ U := e hxV'
      refine eq_top_iff.mpr (fun w _ => ?_)
      rwa [Subsingleton.elim w (s x)]
    subst hUtop
    let e₀ : K ≃+* Γ(Spec (.of K), ⊤) :=
      (Scheme.ΓSpecIso (CommRingCat.of K)).symm.commRingCatIsoToRingEquiv
    let g₁ := g₀.comp (MvPolynomial.mapEquiv (Fin n) e₀).toRingHom
    have hg₁ : g₁.Etale := RingHom.Etale.respectsIso.2 g₀ (MvPolynomial.mapEquiv (Fin n) e₀) hg₀
    obtain ⟨f, f', hff', hxf⟩ := exists_basicOpen_le_affine_inter hV hV' x ⟨hxV, hxV'⟩
    let r : Γ(Y, V') →+* Γ(Y, Y.basicOpen f') :=
      (Y.presheaf.map (homOfLE (Y.basicOpen_le f')).op).hom
    have hr : r.Etale := by
      haveI := hV'.isLocalization_basicOpen f'
      haveI : Algebra.Etale Γ(Y, V') Γ(Y, Y.basicOpen f') := Algebra.Etale.of_isLocalizationAway f'
      exact RingHom.etale_algebraMap.mpr inferInstance
    have h : Opposite.op (Y.basicOpen f') = Opposite.op (Y.basicOpen f) := congrArg Opposite.op hff'.symm
    let ι₁ : Γ(Y, Y.basicOpen f') ≃+* Γ(Y, Y.basicOpen f) :=
      (Y.presheaf.mapIso (eqToIso h)).commRingCatIsoToRingEquiv
    have hle : Y.basicOpen f ≤ s ⁻¹ᵁ ⊤ := fun _ _ => trivial
    have key : ∀ y, ι₁ (r ((s.appLE ⊤ V' e).hom y)) = (s.appLE ⊤ (Y.basicOpen f) hle).hom y := by
      intro y
      change ((s.appLE ⊤ V' e ≫ Y.presheaf.map (homOfLE (Y.basicOpen_le f')).op) ≫
        Y.presheaf.map (eqToHom h)).hom y = _
      rw [Scheme.Hom.appLE_map, Scheme.Hom.appLE_map]
    refine ⟨f, ι₁.toRingHom.comp (r.comp g₁), hxf, ?_, ?_⟩
    · exact RingHom.Etale.respectsIso.1 _ ι₁ (RingHom.Etale.stableUnderComposition _ _ hg₁ hr)
    · refine RingHom.ext fun c => ?_
      have h1 : g₁ (MvPolynomial.C c) = (s.appLE ⊤ V' e).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c) := by
        show g₀ ((MvPolynomial.mapEquiv (Fin n) e₀) (MvPolynomial.C c)) = _
        rw [MvPolynomial.mapEquiv_apply, MvPolynomial.map_C]
        exact RingHom.congr_fun hg₀C _
      show ι₁ (r (g₁ (MvPolynomial.C c))) = _
      rw [h1, key]
      rfl

  haveI := hι
  have hXb : ∀ b : Fin (N + 1), (MvPolynomial.X b : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun b =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K b)
  have hDaff : ∀ b : Fin (N + 1), IsAffineOpen (wcSgD K N b) := fun b =>
    Proj.isAffineOpen_basicOpen _ (MvPolynomial.X b) (hXb b) Nat.one_pos
  have hVaff : ∀ b : Fin (N + 1), IsAffineOpen (ι ⁻¹ᵁ wcSgD K N b) := fun b =>
    (hDaff b).preimage ι
  have hY : (⨆ j : Fin (N + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X j)) = ⊤ := by
    apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
    intro a ha
    have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
    have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
      rw [← MvPolynomial.decomposition.decompose'_apply]
      exact ha'
    rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
    rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
    intro m hm
    have hm0 : m ≠ 0 := by
      rintro rfl
      exact (MvPolynomial.mem_support_iff.mp hm) h0
    obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
    exact ⟨l, Set.mem_univ _, hl⟩
  have hx : ι x₀ ∈ (⨆ j : Fin (N + 1), Proj.basicOpen
      (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) (MvPolynomial.X j)) := by
    rw [hY]; trivial
  obtain ⟨b, hb⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
  have hxb : x₀ ∈ ι ⁻¹ᵁ wcSgD K N b := hb
  obtain ⟨f, g₀, hx₀f, hg₀E, hg₀C⟩ := qs10 K n X.left X.hom _ (hVaff b) x₀ hxb
  refine ⟨b, f, hx₀f, (hVaff b).basicOpen f, ?_⟩
  letI : Algebra K Γ(X.left, X.left.basicOpen f) :=
    (wcCnSigma X.hom (X.left.basicOpen f)).toAlgebra
  let g : MvPolynomial (Fin n) K →ₐ[K] Γ(X.left, X.left.basicOpen f) :=
    { toRingHom := g₀
      commutes' := fun c => by
        show g₀ (MvPolynomial.C c) = wcCnSigma X.hom (X.left.basicOpen f) c
        unfold wcCnSigma
        exact RingHom.congr_fun hg₀C c }
  have hgE : (g : MvPolynomial (Fin n) K →+* Γ(X.left, X.left.basicOpen f)).Etale := hg₀E
  obtain ⟨D, hD⟩ := qs4 K n Γ(X.left, X.left.basicOpen f) g hgE
  exact ⟨g, D, hgE, hD⟩

theorem wc_ldnm_djc_ker_gen (K : Type u) [Field K] (N : ℕ) (X : Over (Spec (.of K)))
    (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr K N = X.hom)
    (b : Fin (N + 1)) (f : Γ(X.left, ι ⁻¹ᵁ wcSgD K N b)) :
    letI := (wcCnSigma X.hom (X.left.basicOpen f)).toAlgebra
    ∀ χ : Γ(X.left, X.left.basicOpen f) →ₐ[K] K, RingHom.ker χ =
      Ideal.span (Set.range fun p =>
        (X.left.presheaf.map (homOfLE (X.left.basicOpen_le f)).op).hom
            ((ι.app (wcSgD K N b)).hom (wcSgE K N b p)) -
          algebraMap K Γ(X.left, X.left.basicOpen f)
            (χ ((X.left.presheaf.map (homOfLE (X.left.basicOpen_le f)).op).hom
              ((ι.app (wcSgD K N b)).hom (wcSgE K N b p))))) :=
by
  classical
  haveI : IsClosedImmersion ι := hι

  have qs7 : ∀ (K : Type u) [Field K] (A R : Type u) [CommRing A] [CommRing R]
      [Algebra K A] [Algebra K R] [Algebra A R] [IsScalarTower K A R] (ι' : Type) (u : ι' → A),
      Algebra.adjoin K (Set.range u) = ⊤ →
      ∀ (f : A) [IsLocalization.Away f R] (χ : R →ₐ[K] K),
      RingHom.ker χ = Ideal.span (Set.range fun p =>
        algebraMap A R (u p) - algebraMap K R (χ (algebraMap A R (u p)))) := by
    intro K _ A R _ _ _ _ _ _ ι' u hgen f _ χ
    set I := Ideal.span (Set.range fun p =>
        algebraMap A R (u p) - algebraMap K R (χ (algebraMap A R (u p)))) with hI
    have key : ∀ a : A, algebraMap A R a - algebraMap K R (χ (algebraMap A R a)) ∈ I := by
      intro a
      have ha : a ∈ Algebra.adjoin K (Set.range u) := by rw [hgen]; exact Algebra.mem_top
      refine Algebra.adjoin_induction (fun x hx => ?_) (fun c => ?_)
        (fun x y _ _ hx hy => ?_) (fun x y _ _ hx hy => ?_) ha
      · obtain ⟨p, rfl⟩ := hx
        exact Ideal.subset_span ⟨p, rfl⟩
      · rw [← IsScalarTower.algebraMap_apply, AlgHom.commutes, Algebra.algebraMap_self,
          RingHom.id_apply, sub_self]
        exact I.zero_mem
      · have e : algebraMap A R (x + y) - algebraMap K R (χ (algebraMap A R (x + y))) =
            (algebraMap A R x - algebraMap K R (χ (algebraMap A R x))) +
              (algebraMap A R y - algebraMap K R (χ (algebraMap A R y))) := by
          simp only [map_add]; ring
        rw [e]; exact I.add_mem hx hy
      · have e : algebraMap A R (x * y) - algebraMap K R (χ (algebraMap A R (x * y))) =
            (algebraMap A R x - algebraMap K R (χ (algebraMap A R x))) * algebraMap A R y +
              algebraMap K R (χ (algebraMap A R x)) *
                (algebraMap A R y - algebraMap K R (χ (algebraMap A R y))) := by
          simp only [map_mul]; ring
        rw [e]; exact I.add_mem (I.mul_mem_right _ hx) (I.mul_mem_left _ hy)
    apply le_antisymm
    · intro r hr
      rw [RingHom.mem_ker] at hr
      obtain ⟨k, a, h⟩ := IsLocalization.Away.surj f r
      have hu : IsUnit (algebraMap A R f ^ k) := (IsLocalization.Away.algebraMap_isUnit f).pow k
      have h1 : χ (algebraMap A R a) = 0 := by rw [← h, map_mul, hr, zero_mul]
      have h2 := key a
      rw [h1, map_zero, sub_zero] at h2
      obtain ⟨v, hv⟩ := hu
      have e : r = algebraMap A R a * ↑v⁻¹ := by rw [← h, ← hv, mul_assoc, Units.mul_inv, mul_one]
      rw [e]; exact I.mul_mem_right _ h2
    · rw [Ideal.span_le]
      rintro _ ⟨p, rfl⟩
      simp [RingHom.mem_ker]
  have hD : IsAffineOpen (wcSgD K N b) :=
    @Proj.isAffineOpen_basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
      MvPolynomial.gradedAlgebra (MvPolynomial.X b) 1
      ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K b)) one_pos
  have hVaff : IsAffineOpen (ι ⁻¹ᵁ wcSgD K N b) := hD.preimage ι
  letI algA : Algebra K Γ(X.left, ι ⁻¹ᵁ wcSgD K N b) :=
    (wcCnSigma X.hom (ι ⁻¹ᵁ wcSgD K N b)).toAlgebra

  have PG : ∀ (n : ℕ) (J : Fin (n + 1)) (x : Γ(wcProjK K n, wcSgD K n J)),
      x ∈ Subring.closure (Set.range (wcSgE K n J) ∪ Set.range (fun c : K => (wcProjK K n).presheaf.map
        (homOfLE (le_top : wcSgD K n J ≤ ⊤)).op ((wcProjKStr K n).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))) := by
    intro n J x
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) := MvPolynomial.gradedAlgebra
    have hX : ∀ k : Fin (n + 1), (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 1 := fun k =>
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X _ k)
    have GEN : ∀ (k : Fin (n + 1)) (d : ℕ) (F : MvPolynomial (Fin (n + 1)) K)
        (hF : F ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K (d • 1)),
        MvPolynomial.eval₂ ((HomogeneousLocalization.fromZeroRingHom
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X k))).comp
            (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))
          (fun l => HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) 1
            (MvPolynomial.X l) (hX l)) F =
        HomogeneousLocalization.Away.mk
          (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX k) d F hF := by
      intro k d F hF
      have hFh : F.IsHomogeneous d := by
        have := (MvPolynomial.mem_homogeneousSubmodule (d • 1) F).mp hF
        simpa using this
      have scale : ∀ {L : Type u} [CommRing L] (χ : K →+* L) (g : Fin (n + 1) → L) (t : L),
          MvPolynomial.eval₂ χ (fun l => g l * t) F = t ^ d * MvPolynomial.eval₂ χ g F := by
        intro L _ χ g t
        rw [MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun e he => ?_)
        have hdeg : ∑ i ∈ e.support, e i = d := by
          by_contra hne
          exact (MvPolynomial.mem_support_iff.mp he) (hFh.coeff_eq_zero hne)
        simp_rw [mul_pow]
        rw [Finset.prod_mul_distrib, Finset.prod_pow_eq_pow_sum, hdeg]
        ring
      apply HomogeneousLocalization.val_injective
      rw [← HomogeneousLocalization.algebraMap_apply, ← HomogeneousLocalization.algebraMap_apply,
        MvPolynomial.eval₂_comp_left, HomogeneousLocalization.algebraMap_apply,
        HomogeneousLocalization.Away.val_mk]
      calc _ = MvPolynomial.eval₂
            ((algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))).comp
              MvPolynomial.C)
            (fun l => algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))
              (MvPolynomial.X l) * Localization.mk 1 (⟨MvPolynomial.X k ^ 1, ⟨1, rfl⟩⟩ :
                Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))) F := by
            congr 1
            funext l
            simp only [Function.comp_apply, HomogeneousLocalization.algebraMap_apply,
              HomogeneousLocalization.Away.val_mk, ← Localization.mk_one_eq_algebraMap,
              Localization.mk_mul, mul_one, one_mul]
        _ = _ := by
            rw [scale]
            have h2 := MvPolynomial.eval₂_comp_left (algebraMap (MvPolynomial (Fin (n + 1)) K)
              (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K))))
              MvPolynomial.C MvPolynomial.X F
            rw [MvPolynomial.eval₂_eta] at h2
            rw [show (fun l => algebraMap (MvPolynomial (Fin (n + 1)) K)
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))
                (MvPolynomial.X l)) = ⇑(algebraMap (MvPolynomial (Fin (n + 1)) K)
                (Localization (Submonoid.powers (MvPolynomial.X k : MvPolynomial (Fin (n + 1)) K)))) ∘
                MvPolynomial.X from rfl, ← h2, Localization.mk_pow,
              ← Localization.mk_one_eq_algebraMap, Localization.mk_mul, Localization.mk_eq_mk_iff,
              Localization.r_iff_exists]
            refine ⟨1, ?_⟩
            simp only [one_pow, one_mul, mul_one, OneMemClass.coe_one, SubmonoidClass.coe_pow, ← pow_mul]
    have hι : ∀ (U : (Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).Opens) a,
        U.ι.appTop a = U.topIso.inv ((Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).presheaf.map (homOfLE (le_top : U ≤ ⊤)).op a) := by
      intro U a
      rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
      erw [← CategoryTheory.comp_apply, ← Functor.map_comp]
      rfl
    have hconst : ∀ c : K, (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom
        (HomogeneousLocalization.fromZeroRingHom (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
          (Submonoid.powers (MvPolynomial.X J)) (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0) c)) =
        ((Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)).presheaf.map (homOfLE (le_top : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)) ≤ ⊤)).op).hom ((Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) 0)))).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) := by
      intro c
      have e0 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).ι =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Proj.awayι _ (MvPolynomial.X J) (hX J) Nat.one_pos := by
        rw [← Proj.basicOpenIsoSpec_inv_ι, Iso.hom_inv_id_assoc]
      have e1 : (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).ι ≫
          (Proj.toSpecZero (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) ≫ Spec.map (CommRingCat.ofHom (algebraMap K ↥((MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) 0)))) =
          (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom ≫
            Spec.map (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))) := by
        rw [e0, Category.assoc, Proj.awayι_toSpecZero_assoc, ← Spec.map_comp]
        rfl
      have e2 := congrArg (fun g => (Scheme.Hom.appTop g).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) e1
      simp only [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply] at e2
      have e3 := congrArg (fun g => g.hom c) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (Submonoid.powers (MvPolynomial.X J))).comp
              (algebraMap K ↥(MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K 0)))))
      simp only [CommRingCat.hom_comp, RingHom.comp_apply] at e3
      rw [← e3] at e2
      have hi : ∀ y, (Proj.basicOpenIsoSpec _ (MvPolynomial.X J) (hX J) Nat.one_pos).hom.appTop
          ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).inv y) =
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv
            ((Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom y) := by
        intro y
        rw [Proj.basicOpenIsoSpec_hom]
        have hh := Proj.basicOpenToSpec_app_top (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)
        calc _ = ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).hom ≫ Proj.awayToSection _ (MvPolynomial.X J) ≫ (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv) ((Scheme.ΓSpecIso (CommRingCat.of (HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)))).inv y) := by rw [← hh]
          _ = _ := by
            change (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv
              ((Proj.awayToSection _ (MvPolynomial.X J)) ((Scheme.ΓSpecIso _).hom ((Scheme.ΓSpecIso _).inv y))) = _
            rw [Iso.inv_hom_id_apply]
      have e4 := e2.trans (hi _)
      rw [hι] at e4
      have hinj : ∀ a b : Γ(Proj (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K), Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)),
          (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv a =
            (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.inv b → a = b := by
        intro a b h
        have h' := congrArg (fun w => (Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).topIso.hom w) h
        simp only [Iso.inv_hom_id_apply] at h'
        exact h'
      exact (hinj _ _ e4).symm
    have hs : Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K)
        (MvPolynomial.X J) ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x) = x := by
      have := Iso.inv_hom_id_apply (Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos) x
      rwa [Proj.basicOpenIsoAway_hom] at this
    obtain ⟨d, F, hF, hmk⟩ := HomogeneousLocalization.Away.mk_surjective
      (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (hX J)
      ((Proj.basicOpenIsoAway _ (MvPolynomial.X J) (hX J) Nat.one_pos).inv x)
    rw [← hs, ← hmk, ← GEN J d F hF]
    change (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) K) (MvPolynomial.X J)).hom _ ∈ _
    rw [MvPolynomial.eval₂_comp_left]
    apply MvPolynomial.eval₂_mem
    · intro i _
      apply Subring.subset_closure
      right
      exact ⟨F.coeff i, (hconst (F.coeff i)).symm⟩
    · intro l
      apply Subring.subset_closure
      left
      exact ⟨l, rfl⟩
  have hconstA : ∀ c : K, (ι.app (wcSgD K N b)).hom ((wcProjK K N).presheaf.map
      (homOfLE (le_top : wcSgD K N b ≤ ⊤)).op ((wcProjKStr K N).appTop
        ((Scheme.ΓSpecIso (.of K)).inv c))) =
      algebraMap K Γ(X.left, ι ⁻¹ᵁ wcSgD K N b) c := by
    intro c
    rw [RingHom.algebraMap_toAlgebra, ← hιX]
    have h := congrArg (fun φ => φ.hom ((wcProjKStr K N).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))
      (ι.naturality (homOfLE (le_top : wcSgD K N b ≤ ⊤)).op)
    simp only [CommRingCat.hom_comp, RingHom.comp_apply] at h
    rw [h]
    simp only [wcCnSigma, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    rfl
  have hgen : Algebra.adjoin K (Set.range fun p => (ι.app (wcSgD K N b)).hom (wcSgE K N b p)) = ⊤ := by
    rw [Algebra.eq_top_iff]
    intro y
    obtain ⟨z, rfl⟩ := Scheme.Hom.app_surjective ι (wcSgD K N b) hD y
    have hz := PG N b z
    have hmem : z ∈ (Algebra.adjoin K (Set.range fun p =>
        (ι.app (wcSgD K N b)).hom (wcSgE K N b p))).toSubring.comap (ι.app (wcSgD K N b)).hom := by
      refine (Subring.closure_le.mpr ?_) hz
      rintro _ (⟨p, rfl⟩ | ⟨c, rfl⟩)
      · exact Algebra.subset_adjoin ⟨p, rfl⟩
      · show _ ∈ Algebra.adjoin K _
        rw [hconstA c]
        exact Subalgebra.algebraMap_mem _ c
    exact hmem
  intro χ
  letI algR : Algebra K Γ(X.left, X.left.basicOpen f) :=
    (wcCnSigma X.hom (X.left.basicOpen f)).toAlgebra
  haveI : IsScalarTower K Γ(X.left, ι ⁻¹ᵁ wcSgD K N b) Γ(X.left, X.left.basicOpen f) :=
    IsScalarTower.of_algebraMap_eq (fun c =>
      congrArg (fun φ => φ.hom (X.hom.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)))
        (X.left.presheaf.map_comp (homOfLE (le_top : ι ⁻¹ᵁ wcSgD K N b ≤ ⊤)).op
          (homOfLE (X.left.basicOpen_le f)).op))
  haveI := hVaff.isLocalization_basicOpen f
  exact qs7 K _ _ (Fin (N + 1)) (fun p => (ι.app (wcSgD K N b)).hom (wcSgE K N b p)) hgen f χ

theorem wc_ldnm_djc_stalk_data (K : Type u) [Field K] (n : ℕ) (X : Over (Spec (.of K)))
    (V₁ : X.left.Opens) (hV₁ : IsAffineOpen V₁) :
    letI := (wcCnSigma X.hom V₁).toAlgebra
    ∀ (g : MvPolynomial (Fin n) K →ₐ[K] Γ(X.left, V₁)),
      (g : MvPolynomial (Fin n) K →+* Γ(X.left, V₁)).Etale →
      ∀ (D : Fin n → Derivation K Γ(X.left, V₁) Γ(X.left, V₁)) (x : X.left) (hx : x ∈ V₁),
        (∃ δ : Fin n → (X.left.presheaf.stalk x →+ X.left.presheaf.stalk x),
          (∀ i a c, δ i (a * c) = a * δ i c + c * δ i a) ∧
          (∀ i c, δ i (wcLdpConst K X.hom x c) = 0) ∧
          ∀ i a, δ i ((X.left.presheaf.germ V₁ x hx).hom a) =
            (X.left.presheaf.germ V₁ x hx).hom (D i a)) ∧
        ∀ χ : Γ(X.left, V₁) →ₐ[K] K,
          (∀ r, (X.left.presheaf.germ V₁ x hx).hom r - wcLdpConst K X.hom x (χ r) ∈
            IsLocalRing.maximalIdeal (X.left.presheaf.stalk x)) →
          IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) =
            Ideal.span (Set.range fun k =>
              (X.left.presheaf.germ V₁ x hx).hom (g (MvPolynomial.X k)) -
                wcLdpConst K X.hom x (χ (g (MvPolynomial.X k)))) :=
by

  have qs5 : ∀ (K : Type u) [Field K] (n : ℕ) (R : Type u) [CommRing R]
      [Algebra K R] (g : MvPolynomial (Fin n) K →ₐ[K] R),
      (g : MvPolynomial (Fin n) K →+* R).Etale → ∀ (P : Ideal R) [P.IsMaximal]
      (χ : R →ₐ[K] K), RingHom.ker χ = P → ∀ (O : Type u) [CommRing O] [IsLocalRing O]
      [Algebra R O] [IsLocalization.AtPrime O P],
      IsLocalRing.maximalIdeal O = Ideal.span (Set.range fun k =>
        algebraMap R O (g (MvPolynomial.X k) - algebraMap K R (χ (g (MvPolynomial.X k))))) := by
    intro K _ n R _ _ g hg P _ χ hχ O _ _ _ _
    set ξ : Fin n → K := fun k => χ (g (MvPolynomial.X k)) with hξ
    set J : Ideal (MvPolynomial (Fin n) K) :=
      Ideal.span (Set.range fun k => MvPolynomial.X k - MvPolynomial.C (ξ k)) with hJ
    have hcomp : χ.comp g = MvPolynomial.aeval ξ :=
      MvPolynomial.algHom_ext (fun k => by simp [ξ])
    have hsub : ∀ p : MvPolynomial (Fin n) K, p - MvPolynomial.C (MvPolynomial.aeval ξ p) ∈ J := by
      intro p
      induction p using MvPolynomial.induction_on with
      | C a => simp
      | add p q hp hq =>
        have e : p + q - MvPolynomial.C (MvPolynomial.aeval ξ (p + q)) =
            (p - MvPolynomial.C (MvPolynomial.aeval ξ p)) +
              (q - MvPolynomial.C (MvPolynomial.aeval ξ q)) := by
          simp only [map_add]; ring
        rw [e]; exact J.add_mem hp hq
      | mul_X p k hp =>
        have e : p * MvPolynomial.X k - MvPolynomial.C (MvPolynomial.aeval ξ (p * MvPolynomial.X k)) =
            (p - MvPolynomial.C (MvPolynomial.aeval ξ p)) * MvPolynomial.X k +
              MvPolynomial.C (MvPolynomial.aeval ξ p) * (MvPolynomial.X k - MvPolynomial.C (ξ k)) := by
          simp only [map_mul, MvPolynomial.aeval_X]; ring
        rw [e]
        exact J.add_mem (J.mul_mem_right _ hp) (J.mul_mem_left _ (Ideal.subset_span ⟨k, rfl⟩))
    have hJle : J ≤ RingHom.ker (MvPolynomial.aeval ξ : MvPolynomial (Fin n) K →ₐ[K] K) := by
      rw [hJ, Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      simp [ξ]
    set gr : MvPolynomial (Fin n) K →+* R := (g : MvPolynomial (Fin n) K →+* R) with hgr
    have hQ : Ideal.comap gr P = J := by
      ext p
      rw [Ideal.mem_comap, ← hχ, RingHom.mem_ker]
      constructor
      · intro h
        have h1 : MvPolynomial.aeval ξ p = 0 := by rw [← hcomp]; exact h
        have := hsub p
        rwa [h1, map_zero, sub_zero] at this
      · intro h
        have h2 := hJle h
        rw [RingHom.mem_ker, ← hcomp] at h2
        exact h2
    letI := gr.toAlgebra
    haveI : Algebra.Etale (MvPolynomial (Fin n) K) R := hg
    let Q := Ideal.comap gr P
    let φ := Localization.localRingHom Q P gr rfl
    letI : Algebra (Localization.AtPrime Q) (Localization.AtPrime P) := φ.toAlgebra
    haveI : IsLocalHom (algebraMap (Localization.AtPrime Q) (Localization.AtPrime P)) :=
      Localization.isLocalHom_localRingHom Q P gr rfl
    haveI : IsScalarTower (MvPolynomial (Fin n) K) (Localization.AtPrime Q)
        (Localization.AtPrime P) :=
      IsScalarTower.of_algebraMap_eq (fun x => by
        rw [IsScalarTower.algebraMap_apply (MvPolynomial (Fin n) K) R (Localization.AtPrime P) x,
          RingHom.algebraMap_toAlgebra φ, Localization.localRingHom_to_map]
        rfl)
    haveI : Algebra.FormallyUnramified R (Localization.AtPrime P) :=
      Algebra.FormallyUnramified.of_isLocalization P.primeCompl
    haveI : Algebra.FormallyUnramified (MvPolynomial (Fin n) K) (Localization.AtPrime P) :=
      Algebra.FormallyUnramified.comp (MvPolynomial (Fin n) K) R (Localization.AtPrime P)
    haveI : Algebra.FormallyUnramified (Localization.AtPrime Q) (Localization.AtPrime P) :=
      Algebra.FormallyUnramified.localization_base Q.primeCompl
    haveI : Algebra.EssFiniteType (MvPolynomial (Fin n) K) R :=
      Algebra.EssFiniteType.of_finiteType _ _
    haveI : Algebra.EssFiniteType R (Localization.AtPrime P) :=
      Algebra.EssFiniteType.of_isLocalization _ P.primeCompl
    haveI : Algebra.EssFiniteType (MvPolynomial (Fin n) K) (Localization.AtPrime P) :=
      Algebra.EssFiniteType.comp (MvPolynomial (Fin n) K) R (Localization.AtPrime P)
    haveI : Algebra.EssFiniteType (Localization.AtPrime Q) (Localization.AtPrime P) :=
      Algebra.EssFiniteType.of_comp (MvPolynomial (Fin n) K) _ _
    have hmap := Algebra.FormallyUnramified.map_maximalIdeal
      (R := Localization.AtPrime Q) (S := Localization.AtPrime P)
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal Q (Localization.AtPrime Q), Ideal.map_map]
      at hmap
    have hce : (algebraMap (Localization.AtPrime Q) (Localization.AtPrime P)).comp
        (algebraMap (MvPolynomial (Fin n) K) (Localization.AtPrime Q)) =
          (algebraMap R (Localization.AtPrime P)).comp gr :=
      RingHom.ext fun x => Localization.localRingHom_to_map Q P gr rfl x
    have hQJ : Q = J := hQ
    rw [hce, ← Ideal.map_map, hQJ, hJ, Ideal.map_span,
      Ideal.map_span, ← Set.range_comp, ← Set.range_comp] at hmap
    let e := IsLocalization.algEquiv P.primeCompl (Localization.AtPrime P) O
    haveI := IsLocalRing.maximalIdeal.isMaximal (Localization.AtPrime P)
    have hmO : IsLocalRing.maximalIdeal O =
        Ideal.map e (IsLocalRing.maximalIdeal (Localization.AtPrime P)) :=
      (IsLocalRing.eq_maximalIdeal (Ideal.map_isMaximal_of_equiv e)).symm
    rw [hmO, ← hmap, Ideal.map_span, ← Set.range_comp]
    refine congrArg Ideal.span (congrArg Set.range (funext fun k => ?_))
    have hC : gr (MvPolynomial.C (ξ k)) = algebraMap K R (ξ k) := by
      show g (MvPolynomial.C (ξ k)) = _
      rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
    show e ((algebraMap R (Localization.AtPrime P)) (gr (MvPolynomial.X k - MvPolynomial.C (ξ k)))) = _
    rw [AlgEquiv.commutes, map_sub, hC]
    rfl

  have qs6 : ∀ (R O : Type u) [CommRing R] [CommRing O] [Algebra R O]
      (M : Submonoid R) [IsLocalization M O] (D : R →+ R),
      (∀ a b, D (a * b) = a * D b + b * D a) →
      ∃ δ : O →+ O, (∀ f g, δ (f * g) = f * δ g + g * δ f) ∧
        ∀ r, δ (algebraMap R O r) = algebraMap R O (D r) := by
    intro R O _ _ _ M _ D hD
    have hD1 : D 1 = 0 := by
      have h := hD 1 1
      simp only [mul_one, one_mul] at h
      have : D 1 + D 1 = D 1 + 0 := by rw [add_zero]; exact h.symm
      exact add_left_cancel this
    let ψ : R →+* TrivSqZeroExt O O :=
      { toFun := fun r => TrivSqZeroExt.inl (algebraMap R O r) +
          TrivSqZeroExt.inr (algebraMap R O (D r))
        map_one' := by
          ext <;> simp [hD1]
        map_mul' := fun a b => by
          ext
          · simp
          · simp [hD, TrivSqZeroExt.snd_mul, Algebra.smul_def]
            ring
        map_zero' := by
          ext <;> simp
        map_add' := fun a b => by
          ext
          · simp
          · simp [Algebra.smul_def] }
    have hψf : ∀ r, (ψ r).fst = algebraMap R O r := fun r => by simp [ψ]
    have hψs : ∀ r, (ψ r).snd = algebraMap R O (D r) := fun r => by simp [ψ, Algebra.smul_def]
    have hunit : ∀ y : M, IsUnit (ψ y) := fun y =>
      TrivSqZeroExt.isUnit_iff_isUnit_fst.mpr (by rw [hψf]; exact IsLocalization.map_units O y)
    let L : O →+* TrivSqZeroExt O O := IsLocalization.lift hunit
    have hL : ∀ r, L (algebraMap R O r) = ψ r := fun r => IsLocalization.lift_eq hunit r
    let fstR : TrivSqZeroExt O O →+* O :=
      { toFun := TrivSqZeroExt.fst
        map_one' := TrivSqZeroExt.fst_one
        map_mul' := TrivSqZeroExt.fst_mul
        map_zero' := TrivSqZeroExt.fst_zero
        map_add' := TrivSqZeroExt.fst_add }
    have hfst : fstR.comp L = RingHom.id O := IsLocalization.ringHom_ext M (RingHom.ext fun r => by
      show (L (algebraMap R O r)).fst = algebraMap R O r
      rw [hL, hψf])
    have hfst' : ∀ y, (L y).fst = y := fun y => RingHom.congr_fun hfst y
    let δ : O →+ O :=
      { toFun := fun y => (L y).snd
        map_zero' := by simp
        map_add' := fun a b => by simp }
    refine ⟨δ, fun f g => ?_, fun r => ?_⟩
    · show (L (f * g)).snd = f * (L g).snd + g * (L f).snd
      rw [map_mul, TrivSqZeroExt.snd_mul, op_smul_eq_smul, hfst', hfst', smul_eq_mul, smul_eq_mul]
    · show (L (algebraMap R O r)).snd = _
      rw [hL, hψs]

  intro g hgE D x hx
  letI algK : Algebra K Γ(X.left, V₁) := (wcCnSigma X.hom V₁).toAlgebra
  obtain ⟨x', rfl⟩ : ∃ x' : ↥V₁, (x' : X.left) = x := ⟨⟨x, hx⟩, rfl⟩
  letI : Algebra Γ(X.left, V₁) (X.left.presheaf.stalk (x' : X.left)) :=
    TopCat.Presheaf.algebra_section_stalk X.left.presheaf x'
  haveI hloc := hV₁.isLocalization_stalk x'
  have hlam : ∀ r, algebraMap Γ(X.left, V₁) (X.left.presheaf.stalk (x' : X.left)) r =
      (X.left.presheaf.germ V₁ (x' : X.left) hx).hom r := fun r => by
    rw [TopCat.Presheaf.stalk_open_algebraMap]
  have Kc : ∀ c : K, algebraMap Γ(X.left, V₁) (X.left.presheaf.stalk (x' : X.left))
      (algebraMap K Γ(X.left, V₁) c) = wcLdpConst K X.hom x' c := fun c => by
    rw [hlam]
    exact X.left.presheaf.germ_res_apply (homOfLE le_top) (x' : X.left) hx _
  have U0 : ∀ c : K, wcLdpConst K X.hom x' c ∈
      IsLocalRing.maximalIdeal (X.left.presheaf.stalk (x' : X.left)) → c = 0 := by
    intro c hc
    by_contra hne
    exact (IsLocalRing.notMem_maximalIdeal.mpr
      ((isUnit_iff_ne_zero.mpr hne).map (wcLdpConst K X.hom x'))) hc
  refine ⟨?_, ?_⟩
  · choose δ hδ1 hδ2 using fun i => qs6 Γ(X.left, V₁)
      (X.left.presheaf.stalk (x' : X.left)) (hV₁.primeIdealOf x').asIdeal.primeCompl
      (D i).toLinearMap.toAddMonoidHom (fun a b => (D i).leibniz a b)
    refine ⟨δ, hδ1, fun i c => ?_, fun i a => ?_⟩
    · rw [← Kc c, hδ2 i]
      exact (congrArg (algebraMap _ _) ((D i).map_algebraMap c)).trans (map_zero _)
    · rw [← hlam, ← hlam]
      exact hδ2 i a
  · intro χ hres
    have hker : RingHom.ker χ = (hV₁.primeIdealOf x').asIdeal := by
      ext r
      rw [RingHom.mem_ker, ← IsLocalization.AtPrime.to_map_mem_maximal_iff
        (X.left.presheaf.stalk (x' : X.left)) (hV₁.primeIdealOf x').asIdeal r, hlam]
      constructor
      · intro h
        have h1 := hres r
        rwa [h, map_zero, sub_zero] at h1
      · intro h
        apply U0
        have h2 := Ideal.sub_mem _ h (hres r)
        rwa [sub_sub_cancel] at h2
    have hsurj : Function.Surjective χ := fun c => ⟨algebraMap K _ c, AlgHom.commutes χ c⟩
    haveI hPmax : (hV₁.primeIdealOf x').asIdeal.IsMaximal := by
      rw [← hker]; exact RingHom.ker_isMaximal_of_surjective χ hsurj
    have h5 := qs5 K n _ g hgE (hV₁.primeIdealOf x').asIdeal χ hker
      (X.left.presheaf.stalk (x' : X.left))
    rw [h5]
    congr 2
    funext k
    rw [map_sub, Kc, hlam]

theorem wc_ldnm_djc_point_criterion (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ)
    (X : Over (Spec (.of K))) [LocallyOfFiniteType X.hom]
    (ι : X.left ⟶ wcProjK K N) (hιX : ι ≫ wcProjKStr K N = X.hom)
    (b : Fin (N + 1)) (V₁ : X.left.Opens) (hV₁ : V₁ ≤ ι ⁻¹ᵁ wcSgD K N b) :
    letI := (wcCnSigma X.hom V₁).toAlgebra
    ∀ (t : Fin n → Γ(X.left, V₁)) (D : Fin n → Derivation K Γ(X.left, V₁) Γ(X.left, V₁)),
      (∀ i k, D i (t k) = if i = k then 1 else 0) →
      ∀ (x : X.left) (hxc : IsClosed ({x} : Set X.left)) (hx : x ∈ V₁)
        (δ : Fin n → (X.left.presheaf.stalk x →+ X.left.presheaf.stalk x)),
        (∀ i a c, δ i (a * c) = a * δ i c + c * δ i a) →
        (∀ i c, δ i (wcLdpConst K X.hom x c) = 0) →
        (∀ i a, δ i ((X.left.presheaf.germ V₁ x hx).hom a) =
          (X.left.presheaf.germ V₁ x hx).hom (D i a)) →
        (∀ χ : Γ(X.left, V₁) →ₐ[K] K,
          (∀ r, (X.left.presheaf.germ V₁ x hx).hom r - wcLdpConst K X.hom x (χ r) ∈
            IsLocalRing.maximalIdeal (X.left.presheaf.stalk x)) →
          IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) =
            Ideal.span (Set.range fun k => (X.left.presheaf.germ V₁ x hx).hom (t k) -
              wcLdpConst K X.hom x (χ (t k)))) →
        ∀ β : Fin (n + 1) → Fin (N + 1) × Fin (N + 1) → K,
          (∀ i q, (X.left.presheaf.germ V₁ x hx).hom
              (Matrix.vecCons
                (fun q : Fin (N + 1) × Fin (N + 1) =>
                  (X.left.presheaf.map (homOfLE hV₁).op).hom
                      ((ι.app (wcSgD K N b)).hom (wcSgE K N b q.1)) *
                    (X.left.presheaf.map (homOfLE hV₁).op).hom
                      ((ι.app (wcSgD K N b)).hom (wcSgE K N b q.2)))
                (fun k (q : Fin (N + 1) × Fin (N + 1)) => D k
                  ((X.left.presheaf.map (homOfLE hV₁).op).hom
                      ((ι.app (wcSgD K N b)).hom (wcSgE K N b q.1)) *
                    (X.left.presheaf.map (homOfLE hV₁).op).hom
                      ((ι.app (wcSgD K N b)).hom (wcSgE K N b q.2))))
                i q) -
            wcLdpConst K X.hom x (β i q) ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x)) →
          ∀ α : Fin (N + 1) × Fin (N + 1) → K,
            (wcLdnmDiaSing K N ι α x ↔ ∀ i, ∑ q, β i q * α q = 0) :=
by
  letI : Algebra K Γ(X.left, V₁) := (wcCnSigma X.hom V₁).toAlgebra
  intro t D hDt x hxc hx δ hδ1 hδ2 hδ3 hm β hβ α
  have hxb : x ∈ ι ⁻¹ᵁ wcSgD K N b := hV₁ hx

  have hU : ∀ c : K, wcLdpConst K X.hom x c ∈
      IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) → c = 0 := by
    intro c hc
    by_contra hne
    exact (IsLocalRing.notMem_maximalIdeal.mpr
      ((isUnit_iff_ne_zero.mpr hne).map (wcLdpConst K X.hom x))) hc
  have hU2 : ∀ (a : X.left.presheaf.stalk x) (c c' : K),
      a - wcLdpConst K X.hom x c ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) →
      a - wcLdpConst K X.hom x c' ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) →
      c = c' := by
    intro a c c' h1 h2
    have h3 := Ideal.sub_mem _ h2 h1
    have h4 : (a - wcLdpConst K X.hom x c') - (a - wcLdpConst K X.hom x c) =
        wcLdpConst K X.hom x (c - c') := by
      rw [map_sub]; ring
    rw [h4] at h3
    exact sub_eq_zero.mp (hU _ h3)
  have hU3 : ∀ (a : X.left.presheaf.stalk x) (c : K),
      a - wcLdpConst K X.hom x c ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) →
      (a ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ↔ c = 0) := by
    intro a c h
    constructor
    · intro ha
      apply hU
      have h' := Ideal.sub_mem _ ha h
      rwa [sub_sub_cancel] at h'
    · rintro rfl
      simpa using h

  obtain ⟨χ, hχ⟩ := wc_ldp_dtc_rational_eval K X.hom V₁ x hx hxc
  let u : Fin (N + 1) → Γ(X.left, V₁) := fun p =>
    (X.left.presheaf.map (homOfLE hV₁).op).hom ((ι.app (wcSgD K N b)).hom (wcSgE K N b p))

  have hβ0 : ∀ q, β 0 q = χ (u q.1 * u q.2) := by
    intro q
    have h := hβ 0 q
    rw [Matrix.cons_val_zero] at h
    exact hU2 _ _ _ h (hχ _)
  have hβs : ∀ (k : Fin n) q, β k.succ q = χ (D k (u q.1 * u q.2)) := by
    intro k q
    have h := hβ k.succ q
    rw [Matrix.cons_val_succ] at h
    exact hU2 _ _ _ h (hχ _)

  have hs6 : wcLdnmDiaSing K N ι α x ↔
      wcLdpGerm K N ι (wcLdpQuad K N fun p p' => α (p, p')) b x hxb ∈
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ^ 2 := by
    unfold wcLdnmDiaSing
    constructor
    · intro h
      exact h b hxb
    · intro h b' hb'
      obtain ⟨-, -, v, -, hv⟩ := wc_ldp_germ_linear K N X.hom ι hιX x b b' hxb hb'
      rw [hv]
      exact Ideal.mul_mem_left _ v h

  have hKc : ∀ c : K, (X.left.presheaf.germ V₁ x hx).hom (algebraMap K Γ(X.left, V₁) c) =
      wcLdpConst K X.hom x c := fun c => by
    exact X.left.presheaf.germ_res_apply (homOfLE le_top) x hx _
  have hu : ∀ y, (X.left.presheaf.germ V₁ x hx).hom
      ((X.left.presheaf.map (homOfLE hV₁).op).hom y) =
      (X.left.presheaf.germ (ι ⁻¹ᵁ wcSgD K N b) x hxb).hom y := fun y =>
    X.left.presheaf.germ_res_apply _ _ _ y
  have hs3 : wcLdpGerm K N ι (wcLdpQuad K N fun p p' => α (p, p')) b x hxb =
      (X.left.presheaf.germ V₁ x hx).hom (∑ q, α q • (u q.1 * u q.2)) := by
    rw [(wc_ldp_lnf_chart_germ K N X ι hιX (wc_ldp_il_proj_const K N) (wc_ldp_lnf_sec_quad K N)
      b x hxb).2.2.1 (fun p p' => α (p, p')), map_sum, Fintype.sum_prod_type]
    refine Finset.sum_congr rfl (fun p _ => Finset.sum_congr rfl (fun q _ => ?_))
    simp only [u]
    rw [Algebra.smul_def, map_mul, map_mul, hKc, hu, hu]
    ring

  obtain ⟨τ, hτdef⟩ : ∃ τ : Fin n → X.left.presheaf.stalk x,
      τ = fun k => (X.left.presheaf.germ V₁ x hx).hom (t k) - wcLdpConst K X.hom x (χ (t k)) :=
    ⟨_, rfl⟩
  have hτ : IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) = Ideal.span (Set.range τ) := by
    rw [hτdef]; exact hm χ hχ
  have hτm : ∀ k, τ k ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) := fun k => by
    rw [hτ]; exact Ideal.subset_span ⟨k, rfl⟩
  have hδτ : ∀ i k, δ i (τ k) = if i = k then 1 else 0 := by
    intro i k
    rw [hτdef]
    show δ i ((X.left.presheaf.germ V₁ x hx).hom (t k) - wcLdpConst K X.hom x (χ (t k))) = _
    rw [map_sub, hδ3, hδ2, hDt, sub_zero]
    split_ifs <;> simp
  have jet_fwd : ∀ g, g ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ^ 2 →
      ∀ i, δ i g ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) := by
    intro g hg i
    rw [pow_two] at hg
    refine Submodule.mul_induction_on hg ?_ ?_
    · intro a ha c hc
      rw [hδ1]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ ha) (Ideal.mul_mem_right _ _ hc)
    · intro a c ha hc
      rw [map_add]
      exact Ideal.add_mem _ ha hc
  have jet_bwd : ∀ g, g ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) →
      (∀ i, δ i g ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x)) →
      g ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ^ 2 := by
    intro g hg hdg
    rw [hτ] at hg
    obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hg
    have hci : ∀ i, c i ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) := by
      intro i
      have e1 : δ i g = ∑ l, (c l * δ i (τ l) + τ l * δ i (c l)) := by
        rw [← hc, map_sum]
        refine Finset.sum_congr rfl (fun l _ => ?_)
        rw [hδ1]
      have e2 : c i = δ i g - ∑ l, τ l * δ i (c l) := by
        rw [e1, Finset.sum_add_distrib]
        simp only [hδτ, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ,
          ↓reduceIte]
        ring
      rw [e2]
      exact Ideal.sub_mem _ (hdg i)
        (Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_right _ _ (hτm l)))
    rw [← hc, pow_two]
    exact Ideal.sum_mem _ (fun l _ => Ideal.mul_mem_mul (hci l) (hτm l))

  have hval : (X.left.presheaf.germ V₁ x hx).hom (∑ q, α q • (u q.1 * u q.2)) ∈
      IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ↔ ∑ q, β 0 q * α q = 0 := by
    rw [hU3 _ _ (hχ _), map_sum]
    have e : ∀ q, χ (α q • (u q.1 * u q.2)) = β 0 q * α q := by
      intro q
      first
        | rw [map_smul, smul_eq_mul]
        | rw [AlgHom.map_smul_of_tower, smul_eq_mul]
      rw [hβ0]
      ring
    simp only [e]

  have hder : ∀ k : Fin n, δ k ((X.left.presheaf.germ V₁ x hx).hom (∑ q, α q • (u q.1 * u q.2))) ∈
      IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) ↔ ∑ q, β k.succ q * α q = 0 := by
    intro k
    rw [hδ3, hU3 _ _ (hχ _), map_sum, map_sum]
    have e : ∀ q, χ (D k (α q • (u q.1 * u q.2))) = β k.succ q * α q := by
      intro q
      rw [Derivation.map_smul]
      first
        | rw [map_smul, smul_eq_mul]
        | rw [AlgHom.map_smul_of_tower, smul_eq_mul]
      rw [hβs]
      ring
    simp only [e]

  rw [hs6, hs3]
  constructor
  · intro h i
    have h0 := Ideal.pow_le_self two_ne_zero h
    rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨k, rfl⟩
    · exact hval.mp h0
    · exact (hder k).mp (jet_fwd _ h k)
  · intro h
    exact jet_bwd _ (hval.mpr (h 0)) (fun k => (hder k).mpr (h k.succ))

theorem wc_ldnm_djc_minor_select (K : Type u) [Field K] (N n : ℕ) (hn : 1 ≤ n)
    (B : Fin (n + 1) → Fin (N + 1) × Fin (N + 1) → K)
    (hsym : ∀ i p p', B i (p, p') = B i (p', p))
    (hsurj : ∀ y : Fin (n + 1) → K, ∃ α : Fin (N + 1) × Fin (N + 1) → K,
      ∀ i, ∑ q, B i q * α q = y i) :
    ∃ S0 : Fin (n + 1) → Fin (N + 1) × Fin (N + 1), Function.Injective S0 ∧
      (Matrix.of fun i l => B i (S0 l)).det ≠ 0 ∧ ∃ q, q ∉ Set.range S0 :=
by
  classical
  let c : (Fin (N + 1) × Fin (N + 1)) → Fin (n + 1) → K := fun q i => B i q
  have hA : Submodule.span K (Set.range c) = ⊤ := by
    rw [Submodule.eq_top_iff']
    intro y
    obtain ⟨α, hα⟩ := hsurj y
    rw [Submodule.mem_span_range_iff_exists_fun]
    refine ⟨α, ?_⟩
    funext i
    rw [Finset.sum_apply]
    simp only [Pi.smul_apply, smul_eq_mul, c]
    rw [← hα i]
    exact Finset.sum_congr rfl (fun q _ => mul_comm _ _)
  obtain ⟨κ, a, ha, hsp, hli⟩ := exists_linearIndependent' K c
  have : Finite κ := Finite.of_injective a ha
  letI : Fintype κ := Fintype.ofFinite κ
  let b := Module.Basis.mk hli (by rw [hsp, hA])
  have hcard : Fintype.card κ = n + 1 := by
    rw [← Module.finrank_eq_card_basis b, Module.finrank_fin_fun]
  let e : Fin (n + 1) ≃ κ := (Fintype.equivFinOfCardEq hcard).symm
  let S0 : Fin (n + 1) → Fin (N + 1) × Fin (N + 1) := a ∘ e
  have hS0 : Function.Injective S0 := ha.comp e.injective
  have hdet : (Matrix.of fun i l => B i (S0 l)).det ≠ 0 := by
    have hcol : (Matrix.of fun i l => B i (S0 l)).col = (c ∘ a) ∘ e := by
      funext l i; rfl
    have hli' : LinearIndependent K (Matrix.of fun i l => B i (S0 l)).col := by
      rw [hcol]; exact hli.comp e e.injective
    exact ((Matrix.isUnit_iff_isUnit_det _).mp
      (Matrix.linearIndependent_cols_iff_isUnit.mp hli')).ne_zero
  refine ⟨S0, hS0, hdet, ?_⟩
  by_contra hcon
  push_neg at hcon
  rcases Nat.eq_zero_or_pos N with hN | hN
  · subst hN
    have := Fintype.card_le_of_injective S0 hS0
    simp only [Fintype.card_prod, Fintype.card_fin] at this
    omega
  · let z : Fin (N + 1) := ⟨0, by omega⟩
    let o : Fin (N + 1) := ⟨1, by omega⟩
    obtain ⟨l1, hl1⟩ := hcon (z, o)
    obtain ⟨l2, hl2⟩ := hcon (o, z)
    have hl12 : l1 ≠ l2 := by
      intro h
      rw [h, hl2] at hl1
      have := congrArg (fun p => p.1.val) hl1
      simp [z, o] at this
    apply hdet
    apply Matrix.det_zero_of_column_eq hl12
    intro k
    simp only [Matrix.of_apply, hl1, hl2]
    exact hsym k z o

theorem wc_ldnm_dia_jet_chart (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ) (hn : 1 ≤ n)
    (X : Over (Spec (.of K))) [GeometricallyIrreducible X.hom] [SmoothOfRelativeDimension n X.hom]
    (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr K N = X.hom)
    (x₀ : X.left) (hx₀ : IsClosed ({x₀} : Set X.left)) :
    ∃ (V : X.left.Opens) (J : Fin (n + 1) → Fin (N + 1) × Fin (N + 1) → Γ(X.left, V))
      (S0 : Fin (n + 1) → Fin (N + 1) × Fin (N + 1)),
      IsAffineOpen V ∧ x₀ ∈ V ∧ IsDomain Γ(X.left, V) ∧ Function.Injective S0 ∧
      IsUnit (Matrix.of fun i l => J i (S0 l)).det ∧ (∃ q, q ∉ Set.range S0) ∧
      ∀ (x : X.left), IsClosed ({x} : Set X.left) → ∀ (hxV : x ∈ V)
        (β : Fin (n + 1) → Fin (N + 1) × Fin (N + 1) → K),
        (∀ i q, (X.left.presheaf.germ V x hxV).hom (J i q) - wcLdpConst K X.hom x (β i q) ∈
          IsLocalRing.maximalIdeal (X.left.presheaf.stalk x)) →
        ∀ α : Fin (N + 1) × Fin (N + 1) → K,
          (wcLdnmDiaSing K N ι α x ↔ ∀ i, ∑ q, β i q * α q = 0) :=
by
  haveI : Smooth X.hom := SmoothOfRelativeDimension.smooth n X.hom

  obtain ⟨b, f, hx₀f, hV₁aff, hgD⟩ := wc_ldnm_djc_etale_chart K N n X ι hι x₀
  letI : Algebra K Γ(X.left, X.left.basicOpen f) :=
    (wcCnSigma X.hom (X.left.basicOpen f)).toAlgebra
  obtain ⟨g, D, hgE, hDg⟩ := hgD
  have hV₁ : X.left.basicOpen f ≤ ι ⁻¹ᵁ wcSgD K N b := X.left.basicOpen_le f
  let u : Fin (N + 1) → Γ(X.left, X.left.basicOpen f) := fun p =>
    (X.left.presheaf.map (homOfLE hV₁).op).hom ((ι.app (wcSgD K N b)).hom (wcSgE K N b p))
  let J₁ : Fin (n + 1) → Fin (N + 1) × Fin (N + 1) → Γ(X.left, X.left.basicOpen f) :=
    Matrix.vecCons (fun q => u q.1 * u q.2) (fun k q => D k (u q.1 * u q.2))

  have hker := wc_ldnm_djc_ker_gen K N X ι hι hιX b f
  have hub : u b = 1 := by
    show (X.left.presheaf.map (homOfLE hV₁).op).hom
      ((ι.app (wcSgD K N b)).hom (wcSgE K N b b)) = 1
    rw [(wc_ldpi_oai_sgE_facts K N b b).1, map_one, map_one]

  obtain ⟨χ₀, hχ₀⟩ := wc_ldp_dtc_rational_eval K X.hom (X.left.basicOpen f) x₀ hx₀f hx₀
  let B : Fin (n + 1) → Fin (N + 1) × Fin (N + 1) → K := fun i q => χ₀ (J₁ i q)
  have hsym : ∀ i p p', B i (p, p') = B i (p', p) := by
    intro i p p'
    rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨k, rfl⟩
    · simp only [B, J₁, Matrix.cons_val_zero]
      rw [mul_comm (u p)]
    · simp only [B, J₁, Matrix.cons_val_succ]
      rw [mul_comm (u p)]
  have hsurj : ∀ y : Fin (n + 1) → K, ∃ α : Fin (N + 1) × Fin (N + 1) → K,
      ∀ i, ∑ q, B i q * α q = y i := by
    intro y
    obtain ⟨w, hw0, hwk⟩ := wc_ldp_quadric_jets_one K Γ(X.left, X.left.basicOpen f) N n b u hub
      (fun k => g (MvPolynomial.X k)) D hDg χ₀ (hker χ₀) (y 0) (fun k => y k.succ)
    refine ⟨w, fun i => ?_⟩
    rcases Fin.eq_zero_or_eq_succ i with rfl | ⟨k, rfl⟩
    · refine Eq.trans ?_ hw0
      rw [map_sum]
      refine Finset.sum_congr rfl (fun q _ => ?_)
      have e : J₁ 0 q = u q.1 * u q.2 := by simp only [J₁, Matrix.cons_val_zero]
      show χ₀ (J₁ 0 q) * w q = χ₀ (w q • (u q.1 * u q.2))
      rw [e]
      first
        | rw [map_smul, smul_eq_mul]
        | rw [AlgHom.map_smul_of_tower, smul_eq_mul]
      ring
    · refine Eq.trans ?_ (hwk k)
      rw [map_sum, map_sum]
      refine Finset.sum_congr rfl (fun q _ => ?_)
      have e : J₁ k.succ q = D k (u q.1 * u q.2) := by simp only [J₁, Matrix.cons_val_succ]
      show χ₀ (J₁ k.succ q) * w q = χ₀ (D k (w q • (u q.1 * u q.2)))
      rw [e, Derivation.map_smul]
      first
        | rw [map_smul, smul_eq_mul]
        | rw [AlgHom.map_smul_of_tower, smul_eq_mul]
      ring

  obtain ⟨S0, hS0, hBdet, hq₀⟩ := wc_ldnm_djc_minor_select K N n hn B hsym hsurj
  let d : Γ(X.left, X.left.basicOpen f) := (Matrix.of fun i l => J₁ i (S0 l)).det
  have hχd : χ₀ d = (Matrix.of fun i l => B i (S0 l)).det := by
    show χ₀ (Matrix.det _) = _
    rw [AlgHom.map_det]
    rfl
  have hd0 : χ₀ d ≠ 0 := by rw [hχd]; exact hBdet
  have hx₀V : x₀ ∈ X.left.basicOpen d := by
    rw [Scheme.mem_basicOpen X.left d x₀ hx₀f]
    by_contra hnu
    have hm : (X.left.presheaf.germ (X.left.basicOpen f) x₀ hx₀f).hom d ∈
        IsLocalRing.maximalIdeal (X.left.presheaf.stalk x₀) :=
      (IsLocalRing.mem_maximalIdeal _).mpr hnu
    have h2 := Ideal.sub_mem _ hm (hχ₀ d)
    rw [sub_sub_cancel] at h2
    exact (IsLocalRing.notMem_maximalIdeal.mpr
      ((isUnit_iff_ne_zero.mpr hd0).map (wcLdpConst K X.hom x₀))) h2
  let res : Γ(X.left, X.left.basicOpen f) →+* Γ(X.left, X.left.basicOpen d) :=
    (X.left.presheaf.map (homOfLE (X.left.basicOpen_le d)).op).hom
  refine ⟨X.left.basicOpen d, fun i q => res (J₁ i q), S0, hV₁aff.basicOpen d, hx₀V, ?_, hS0,
    ?_, hq₀, ?_⟩
  ·
    rcases wc_ldp_dtc_chart_domain K n X (X.left.basicOpen d) with h | h
    · exact h
    · exfalso
      have h1 : (X.left.presheaf.germ (X.left.basicOpen d) x₀ hx₀V).hom 1 =
          (X.left.presheaf.germ (X.left.basicOpen d) x₀ hx₀V).hom 0 := by
        rw [Subsingleton.elim (1 : Γ(X.left, X.left.basicOpen d)) 0]
      rw [map_one, map_zero] at h1
      exact one_ne_zero h1
  ·
    show IsUnit (res.mapMatrix (Matrix.of fun i l => J₁ i (S0 l))).det
    rw [← RingHom.map_det]
    exact RingedSpace.isUnit_res_basicOpen X.left.toRingedSpace d
  ·
    intro x hxc hxV β hβ α
    have hx₁ : x ∈ X.left.basicOpen f := X.left.basicOpen_le d hxV
    have hβ' : ∀ i q, (X.left.presheaf.germ (X.left.basicOpen f) x hx₁).hom (J₁ i q) -
        wcLdpConst K X.hom x (β i q) ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) := by
      intro i q
      have e : (X.left.presheaf.germ (X.left.basicOpen d) x hxV).hom (res (J₁ i q)) =
          (X.left.presheaf.germ (X.left.basicOpen f) x hx₁).hom (J₁ i q) :=
        X.left.presheaf.germ_res_apply _ _ _ _
      rw [← e]
      exact hβ i q
    obtain ⟨⟨δ, hδ1, hδ2, hδ3⟩, hm⟩ :=
      wc_ldnm_djc_stalk_data K n X (X.left.basicOpen f) hV₁aff g hgE D x hx₁
    exact wc_ldnm_djc_point_criterion K N n X ι hιX b (X.left.basicOpen f) hV₁
      (fun k => g (MvPolynomial.X k)) D hDg x hxc hx₁ δ hδ1 hδ2 hδ3 hm β hβ' α

theorem wc_ldnm_dia_kernel_param (A : Type u) [CommRing A] {ι' : Type} [Fintype ι'] [DecidableEq ι']
    (m : ℕ) (J : Fin m → ι' → A) (S0 : Fin m → ι') (hS0 : Function.Injective S0)
    (hdet : IsUnit (Matrix.of fun i l => J i (S0 l)).det) (r : ι') (hr : r ∉ Set.range S0) :
    ∃ Y : ι' → MvPolynomial {q : ι' // q ∉ Set.range S0 ∧ q ≠ r} A,
      Y r = 1 ∧ (∀ q (hq : q ∉ Set.range S0 ∧ q ≠ r), Y q = MvPolynomial.X ⟨q, hq⟩) ∧
      (∀ i, ∑ q, MvPolynomial.C (J i q) * Y q = 0) ∧
      ∀ (L : Type u) [CommRing L] (χ : A →+* L) (v : ι' → L), v r = 1 →
        (∀ i, ∑ q, χ (J i q) * v q = 0) →
        ∀ q, MvPolynomial.eval₂ χ (fun f => v f.1) (Y q) = v q :=
by
  classical
  obtain ⟨P, hBP, hPB⟩ : ∃ P : Matrix (Fin m) (Fin m) A,
      (Matrix.of fun i l => J i (S0 l)) * P = 1 ∧ P * (Matrix.of fun i l => J i (S0 l)) = 1 :=
    ⟨_, Matrix.mul_nonsing_inv _ hdet, Matrix.nonsing_inv_mul _ hdet⟩

  have hswap : ∀ (R : Type u) [CommRing R] (a : Fin m → R) (b : Fin m → Fin m → R)
      (s : Fin m → R), ∑ l, a l * ∑ k, b l k * s k = ∑ k, (∑ l, a l * b l k) * s k := by
    intro R _ a b s
    calc ∑ l, a l * ∑ k, b l k * s k = ∑ l, ∑ k, a l * (b l k * s k) :=
          Finset.sum_congr rfl fun l _ => Finset.mul_sum _ _ _
      _ = ∑ k, ∑ l, a l * (b l k * s k) := Finset.sum_comm
      _ = ∑ k, (∑ l, a l * b l k) * s k := Finset.sum_congr rfl fun k _ => by
          rw [Finset.sum_mul]; exact Finset.sum_congr rfl fun l _ => by ring

  have hdelta : ∀ (R : Type u) [CommRing R] (s : Fin m → R) (i : Fin m),
      ∑ k, (if i = k then (1 : R) else 0) * s k = s i := by
    intro R _ s i
    simp only [ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]

  have hcol : ∀ (R : Type u) [CommRing R] (f : ι' → R) (c : Fin m → R),
      ∑ q, f q * ∑ l, (if S0 l = q then c l else 0) = ∑ l, f (S0 l) * c l := by
    intro R _ f c
    calc ∑ q, f q * ∑ l, (if S0 l = q then c l else 0)
        = ∑ q, ∑ l, (if S0 l = q then f q * c l else 0) :=
          Finset.sum_congr rfl fun q _ => by
            rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun l _ => by
              split_ifs <;> simp
      _ = ∑ l, ∑ q, (if S0 l = q then f q * c l else 0) := Finset.sum_comm
      _ = ∑ l, f (S0 l) * c l := Finset.sum_congr rfl fun l _ => by
          rw [Finset.sum_ite_eq]; simp

  have hE : ∀ (R : Type u) [CommRing R] (φ : A →+* R) (w : ι' → R) (i : Fin m),
      ∑ q, φ (J i q) * (w q - ∑ l, if S0 l = q then
          ∑ k, φ (P l k) * ∑ p, φ (J k p) * w p else 0) = 0 := by
    intro R _ φ w i
    have h1 : ∀ k, ∑ l, φ (J i (S0 l)) * φ (P l k) = if i = k then 1 else 0 := by
      intro k
      have := congrArg (fun M => φ (M i k)) hBP
      simp only [Matrix.mul_apply, Matrix.of_apply, map_sum, map_mul, Matrix.one_apply] at this
      rw [this]
      split_ifs <;> simp
    simp only [mul_sub, Finset.sum_sub_distrib]
    rw [hcol R, hswap R]
    simp only [h1]
    rw [hdelta R, sub_self]

  have hU : ∀ (R : Type u) [CommRing R] (φ : A →+* R) (v w : ι' → R),
      (∀ i, ∑ q, φ (J i q) * v q = 0) → (∀ q, q ∉ Set.range S0 → w q = v q) → ∀ q,
      w q - ∑ l, (if S0 l = q then ∑ k, φ (P l k) * ∑ p, φ (J k p) * w p else 0) = v q := by
    intro R _ φ v w hv hwv q
    have hd : ∀ p, p ∉ Set.range S0 → w p - v p = 0 := fun p hp => by rw [hwv p hp, sub_self]
    have hs : ∀ k, ∑ p, φ (J k p) * w p = ∑ l, φ (J k (S0 l)) * (w (S0 l) - v (S0 l)) := by
      intro k
      have e1 : ∑ p, φ (J k p) * w p = ∑ p, φ (J k p) * (w p - v p) := by
        simp only [mul_sub, Finset.sum_sub_distrib, hv k, sub_zero]
      rw [e1]
      exact (Fintype.sum_of_injective S0 hS0 (fun l => φ (J k (S0 l)) * (w (S0 l) - v (S0 l)))
        (fun p => φ (J k p) * (w p - v p)) (fun p hp => by rw [hd p hp, mul_zero])
        (fun l => rfl)).symm
    have h2 : ∀ l l', ∑ k, φ (P l k) * φ (J k (S0 l')) = if l = l' then 1 else 0 := by
      intro l l'
      have := congrArg (fun M => φ (M l l')) hPB
      simp only [Matrix.mul_apply, Matrix.of_apply, map_sum, map_mul, Matrix.one_apply] at this
      rw [this]
      split_ifs <;> simp
    have hc : ∀ l, ∑ k, φ (P l k) * ∑ p, φ (J k p) * w p = w (S0 l) - v (S0 l) := by
      intro l
      simp only [hs]
      rw [hswap R (fun k => φ (P l k)) (fun k l' => φ (J k (S0 l')))
        (fun l' => w (S0 l') - v (S0 l'))]
      simp only [h2]
      exact hdelta R (fun l' => w (S0 l') - v (S0 l')) l
    simp only [hc]
    by_cases hq : q ∈ Set.range S0
    · obtain ⟨l0, rfl⟩ := hq
      rw [Finset.sum_eq_single l0 (fun l _ hl => if_neg (hS0.ne hl))
        (fun h => absurd (Finset.mem_univ l0) h), if_pos rfl, sub_sub_cancel]
    · rw [Finset.sum_eq_zero (fun l _ => if_neg (fun h => hq ⟨l, h⟩)), sub_zero, hwv q hq]

  obtain ⟨w, hw⟩ : ∃ w : ι' → MvPolynomial {q : ι' // q ∉ Set.range S0 ∧ q ≠ r} A,
      ∀ q, w q = if h : q = r then 1 else if h' : q ∈ Set.range S0 then 0
        else MvPolynomial.X ⟨q, h', h⟩ := ⟨_, fun _ => rfl⟩
  obtain ⟨Y, hY⟩ : ∃ Y : ι' → MvPolynomial {q : ι' // q ∉ Set.range S0 ∧ q ≠ r} A,
      ∀ q, Y q = w q - ∑ l, (if S0 l = q then
        ∑ k, MvPolynomial.C (P l k) * ∑ p, MvPolynomial.C (J k p) * w p else 0) :=
    ⟨_, fun _ => rfl⟩
  have hoff : ∀ q, q ∉ Set.range S0 → Y q = w q := by
    intro q hq
    rw [hY, Finset.sum_eq_zero (fun l _ => if_neg (fun h => hq ⟨l, h⟩)), sub_zero]
  refine ⟨Y, ?_, ?_, ?_, ?_⟩
  · rw [hoff r hr, hw, dif_pos rfl]
  · intro q hq
    rw [hoff q hq.1, hw, dif_neg hq.2, dif_neg hq.1]
  · intro i
    simp only [hY]
    exact hE _ MvPolynomial.C w i
  · intro L _ χ v hv1 hv q
    rw [← MvPolynomial.coe_eval₂Hom, hY]
    have hωv : ∀ p, p ∉ Set.range S0 →
        MvPolynomial.eval₂Hom χ (fun f : {q : ι' // q ∉ Set.range S0 ∧ q ≠ r} => v f.1) (w p)
          = v p := by
      intro p hp
      by_cases hpr : p = r
      · subst hpr
        rw [hw, dif_pos rfl, map_one, hv1]
      · rw [hw, dif_neg hpr, dif_neg hp, MvPolynomial.eval₂Hom_X']
    have := hU L χ v (fun p => MvPolynomial.eval₂Hom χ
      (fun f : {q : ι' // q ∉ Set.range S0 ∧ q ≠ r} => v f.1) (w p)) hv hωv q
    rw [← this]
    simp only [map_sub, map_sum, map_mul, MvPolynomial.eval₂Hom_C,
      apply_ite (MvPolynomial.eval₂Hom χ
        (fun f : {q : ι' // q ∉ Set.range S0 ∧ q ≠ r} => v f.1)), map_zero]

theorem wc_ldnm_dia_graph_param (K : Type u) [Field K] [IsAlgClosed K] (M : ℕ)
    (X : Over (Spec (.of K))) [LocallyOfFiniteType X.hom] (V : X.left.Opens) (hV : IsAffineOpen V)
    {F : Type} [Finite F] (Y : Fin (M + 1) → MvPolynomial F Γ(X.left, V)) (r : Fin (M + 1))
    (hYr : Y r = 1) :
    ∃ (W : Scheme.{u}) (ψ : W ⟶ Limits.pullback X.hom (wcProjKStr K M)),
      (IsDomain Γ(X.left, V) → IrreducibleSpace W) ∧ JacobsonSpace W ∧
      (∀ ω, Limits.pullback.fst X.hom (wcProjKStr K M) (ψ ω) ∈ V ∧
        Limits.pullback.snd X.hom (wcProjKStr K M) (ψ ω) ∈ wcSgD K M r) ∧
      (∀ ω, IsClosed ({ω} : Set W) →
        IsClosed ({ψ ω} : Set ↥(Limits.pullback X.hom (wcProjKStr K M))) ∧
        ∃ (hxV : Limits.pullback.fst X.hom (wcProjKStr K M) (ψ ω) ∈ V)
          (e : MvPolynomial F Γ(X.left, V) →+* K),
          (∀ a, (X.left.presheaf.germ V _ hxV).hom a -
              wcLdpConst K X.hom (Limits.pullback.fst X.hom (wcProjKStr K M) (ψ ω))
                (e (MvPolynomial.C a)) ∈
            IsLocalRing.maximalIdeal (X.left.presheaf.stalk
              (Limits.pullback.fst X.hom (wcProjKStr K M) (ψ ω)))) ∧
          wcLdnmDiaCoord K M (Limits.pullback.snd X.hom (wcProjKStr K M) (ψ ω)) r
            (fun j => e (Y j))) ∧
      ∀ w : ↥(Limits.pullback X.hom (wcProjKStr K M)),
        IsClosed ({w} : Set ↥(Limits.pullback X.hom (wcProjKStr K M))) →
        ∀ (hxV : Limits.pullback.fst X.hom (wcProjKStr K M) w ∈ V)
          (e : MvPolynomial F Γ(X.left, V) →+* K),
        (∀ a, (X.left.presheaf.germ V _ hxV).hom a -
            wcLdpConst K X.hom (Limits.pullback.fst X.hom (wcProjKStr K M) w)
              (e (MvPolynomial.C a)) ∈
          IsLocalRing.maximalIdeal (X.left.presheaf.stalk
            (Limits.pullback.fst X.hom (wcProjKStr K M) w))) →
        wcLdnmDiaCoord K M (Limits.pullback.snd X.hom (wcProjKStr K M) w) r (fun j => e (Y j)) →
        ∃ ω, ψ ω = w :=
by
  classical

  have s1 : ∀ {W Z : Scheme.{u}} (s : Z ⟶ Spec (.of K)) (f : W ⟶ Z) (U : Z.Opens)
      (h : ⊤ ≤ f ⁻¹ᵁ U) (ω : W) (hω : f ω ∈ U) (g : Γ(Z, U)) (c : K),
      ((Z.presheaf.germ U (f ω) hω).hom g - wcLdpConst K s (f ω) c ∈
          IsLocalRing.maximalIdeal (Z.presheaf.stalk (f ω))) ↔
        ((W.presheaf.germ ⊤ ω trivial).hom ((f.appLE U ⊤ h).hom g) - wcLdpConst K (f ≫ s) ω c ∈
          IsLocalRing.maximalIdeal (W.presheaf.stalk ω)) := by
    intro W Z s f U h ω hω g c
    have hA : (f.stalkMap ω).hom ((Z.presheaf.germ U (f ω) hω).hom g) =
        (W.presheaf.germ ⊤ ω trivial).hom ((f.appLE U ⊤ h).hom g) := by
      have k1 := Scheme.Hom.germ_stalkMap_apply f U ω hω g
      have k2 := TopCat.Presheaf.germ_res_apply W.presheaf (homOfLE h) ω trivial ((f.app U).hom g)
      exact k1.trans k2.symm
    have hB : (f.stalkMap ω).hom (wcLdpConst K s (f ω) c) = wcLdpConst K (f ≫ s) ω c := by
      have k1 := Scheme.Hom.germ_stalkMap_apply f ⊤ ω trivial
        (s.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))
      have e : (f ≫ s).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c) =
          (f.app ⊤).hom (s.appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) := by
        rw [Scheme.Hom.comp_appTop]; rfl
      show _ = (W.presheaf.germ ⊤ ω trivial).hom
        ((f ≫ s).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))
      rw [e]
      exact k1
    rw [IsLocalRing.mem_maximalIdeal, IsLocalRing.mem_maximalIdeal,
      ← map_mem_nonunits_iff (f.stalkMap ω).hom, map_sub, hA, hB]

  have s2 : ∀ {T Z : Scheme.{u}} {U : Z.Opens} (hU : IsAffineOpen U) (c : T ⟶ Spec Γ(Z, U))
      (m : T ⟶ Z) (hm : m = c ≫ hU.fromSpec) (h : ⊤ ≤ m ⁻¹ᵁ U) (a : Γ(Z, U)),
      (m.appLE U ⊤ h).hom a = c.appTop.hom ((Scheme.ΓSpecIso Γ(Z, U)).inv.hom a) := by
    intro T Z U hU c m hm h a
    subst hm
    have key : ∀ (W' : (Spec Γ(Z, U)).Opens) (hW : W' = ⊤) (h' : ⊤ ≤ c ⁻¹ᵁ W')
        (y : Γ(Spec Γ(Z, U), ⊤)),
        (c.appLE W' ⊤ h').hom (((Spec Γ(Z, U)).presheaf.map (eqToHom hW).op).hom y) =
          c.appTop.hom y := by
      intro W' hW h' y
      subst hW
      simp only [eqToHom_refl, op_id, CategoryTheory.Functor.map_id, CommRingCat.id_apply]
      exact congrArg (fun φ => φ.hom y) (Scheme.Hom.appLE_eq_app c (U := ⊤))
    rw [Scheme.Hom.comp_appLE, hU.fromSpec_app_self]
    simp only [CommRingCat.hom_comp, RingHom.comp_apply]
    exact key _ _ _ _

  have s3 : ∀ {T Z : Scheme.{u}} {U : Z.Opens} (hU : IsAffineOpen U)
      (a b : T ⟶ Z) (ha : ⊤ ≤ a ⁻¹ᵁ U) (hb : ⊤ ≤ b ⁻¹ᵁ U),
      (∀ g : Γ(Z, U), (a.appLE U ⊤ ha).hom g = (b.appLE U ⊤ hb).hom g) → a = b := by
    intro T Z U hU a b ha hb hab
    haveI := hU.isOpenImmersion_fromSpec
    have hra : Set.range a ⊆ Set.range hU.fromSpec := by
      rw [hU.range_fromSpec]; rintro _ ⟨t, rfl⟩; exact ha (Set.mem_univ t)
    have hrb : Set.range b ⊆ Set.range hU.fromSpec := by
      rw [hU.range_fromSpec]; rintro _ ⟨t, rfl⟩; exact hb (Set.mem_univ t)
    obtain ⟨a', rfl⟩ : ∃ a', a' ≫ hU.fromSpec = a := ⟨_, IsOpenImmersion.lift_fac _ _ hra⟩
    obtain ⟨b', rfl⟩ : ∃ b', b' ≫ hU.fromSpec = b := ⟨_, IsOpenImmersion.lift_fac _ _ hrb⟩
    have key : ∀ g, a'.appTop.hom ((Scheme.ΓSpecIso Γ(Z, U)).inv.hom g) =
        b'.appTop.hom ((Scheme.ΓSpecIso Γ(Z, U)).inv.hom g) := by
      intro g
      have := hab g
      rwa [s2 hU a' _ rfl ha g, s2 hU b' _ rfl hb g] at this
    have hinv : ∀ y, (Scheme.ΓSpecIso Γ(Z, U)).inv.hom
        ((Scheme.ΓSpecIso Γ(Z, U)).hom.hom y) = y := by
      intro y
      show ((Scheme.ΓSpecIso Γ(Z, U)).hom ≫ (Scheme.ΓSpecIso Γ(Z, U)).inv).hom y = y
      rw [Iso.hom_inv_id]; rfl
    have : a' = b' := by
      apply ext_of_isAffine
      apply CommRingCat.hom_ext
      apply RingHom.ext
      intro y
      rw [← hinv y]
      exact key _
    rw [this]

  have s4 : ∀ {Z : Scheme.{u}} (s : Z ⟶ Spec (.of K)) (σ : Spec (.of K) ⟶ Z) (hσ : σ ≫ s = 𝟙 _)
      (U : Z.Opens) (hU : ⊤ ≤ σ ⁻¹ᵁ U) (hxU : σ (IsLocalRing.closedPoint K) ∈ U)
      (g : Γ(Z, U)) (c : K),
      (Z.presheaf.germ U (σ (IsLocalRing.closedPoint K)) hxU).hom g -
          wcLdpConst K s (σ (IsLocalRing.closedPoint K)) c ∈
        IsLocalRing.maximalIdeal (Z.presheaf.stalk (σ (IsLocalRing.closedPoint K))) →
      (σ.appLE U ⊤ hU).hom g = (Scheme.ΓSpecIso (.of K)).inv.hom c := by
    intro Z s σ hσ U hU hxU g c hg
    have h1 := (s1 s σ U hU _ hxU g c).mp hg
    rw [hσ] at h1
    have h2 : wcLdpConst K (𝟙 (Spec (.of K))) (IsLocalRing.closedPoint K) c =
        ((Spec (.of K)).presheaf.germ ⊤ _ trivial).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c) := by
      show ((Spec (.of K)).presheaf.germ ⊤ _ trivial).hom
        ((Scheme.Hom.appTop (𝟙 (Spec (.of K)))).hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)) = _
      rw [Scheme.Hom.id_appTop]; rfl
    rw [h2, ← map_sub] at h1
    have hinv : ∀ y, (Scheme.ΓSpecIso (.of K)).inv.hom
        ((Scheme.ΓSpecIso (.of K)).hom.hom y) = y := by
      intro y
      show ((Scheme.ΓSpecIso (.of K)).hom ≫ (Scheme.ΓSpecIso (.of K)).inv).hom y = y
      rw [Iso.hom_inv_id]; rfl
    by_contra hne
    have hz : (σ.appLE U ⊤ hU).hom g - (Scheme.ΓSpecIso (.of K)).inv.hom c ≠ 0 :=
      fun h0 => hne (sub_eq_zero.mp h0)
    have hz' : (Scheme.ΓSpecIso (.of K)).hom.hom
        ((σ.appLE U ⊤ hU).hom g - (Scheme.ΓSpecIso (.of K)).inv.hom c) ≠ 0 := by
      intro h0
      apply hz
      have := congrArg (Scheme.ΓSpecIso (.of K)).inv.hom h0
      rwa [hinv, map_zero] at this
    have hu := (isUnit_iff_ne_zero.mpr hz').map (Scheme.ΓSpecIso (.of K)).inv.hom
    rw [hinv] at hu
    have aux : ∀ {W : Scheme.{u}} (ω : W) (y : W.presheaf.stalk ω), IsUnit y →
        y ∉ IsLocalRing.maximalIdeal (W.presheaf.stalk ω) :=
      fun ω y hy => IsLocalRing.notMem_maximalIdeal.mpr hy
    exact aux _ _ (hu.map _) h1

  have s5 : ∀ {T : Scheme.{u}} (u v : T ⟶ wcProjK K M)
      (hs : u ≫ wcProjKStr K M = v ≫ wcProjKStr K M)
      (hu : ⊤ ≤ u ⁻¹ᵁ wcSgD K M r) (hv : ⊤ ≤ v ⁻¹ᵁ wcSgD K M r),
      (∀ q, (u.appLE (wcSgD K M r) ⊤ hu).hom (wcSgE K M r q) =
        (v.appLE (wcSgD K M r) ⊤ hv).hom (wcSgE K M r q)) → u = v := by
    intro T u v hs hu hv hq
    have hD : IsAffineOpen (wcSgD K M r) :=
      @Proj.isAffineOpen_basicOpen _ _ _ _ _ (MvPolynomial.homogeneousSubmodule (Fin (M + 1)) K)
        MvPolynomial.gradedAlgebra (MvPolynomial.X r) 1
        ((MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K r)) one_pos
    have hconst : ∀ (w : T ⟶ wcProjK K M) (hw : ⊤ ≤ w ⁻¹ᵁ wcSgD K M r)
        (y : Γ(wcProjK K M, ⊤)),
        (w.appLE (wcSgD K M r) ⊤ hw).hom
          ((wcProjK K M).presheaf.map (homOfLE (le_top : wcSgD K M r ≤ ⊤)).op y) =
        w.appTop.hom y := by
      intro w hw y
      show ((wcProjK K M).presheaf.map (homOfLE (le_top : wcSgD K M r ≤ ⊤)).op ≫
        w.appLE (wcSgD K M r) ⊤ hw).hom y = _
      rw [Scheme.Hom.map_appLE]
      exact congrArg (fun φ => φ.hom y) (Scheme.Hom.appLE_eq_app w (U := ⊤))
    refine s3 hD u v hu hv (fun g => ?_)
    have hg := wc_ldpi_oai_proj_gen K M r g
    have hle : Subring.closure (Set.range (wcSgE K M r) ∪ Set.range (fun c : K =>
        (wcProjK K M).presheaf.map (homOfLE (le_top : wcSgD K M r ≤ ⊤)).op
          ((wcProjKStr K M).appTop ((Scheme.ΓSpecIso (.of K)).inv c)))) ≤
        RingHom.eqLocus (u.appLE (wcSgD K M r) ⊤ hu).hom (v.appLE (wcSgD K M r) ⊤ hv).hom := by
      rw [Subring.closure_le]
      rintro _ (⟨q, rfl⟩ | ⟨c, rfl⟩)
      · exact hq q
      · show (u.appLE (wcSgD K M r) ⊤ hu).hom ((wcProjK K M).presheaf.map
            (homOfLE (le_top : wcSgD K M r ≤ ⊤)).op
            ((wcProjKStr K M).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c))) =
          (v.appLE (wcSgD K M r) ⊤ hv).hom ((wcProjK K M).presheaf.map
            (homOfLE (le_top : wcSgD K M r ≤ ⊤)).op
            ((wcProjKStr K M).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom c)))
        rw [hconst u hu, hconst v hv]
        show ((wcProjKStr K M).appTop ≫ u.appTop).hom _ =
          ((wcProjKStr K M).appTop ≫ v.appTop).hom _
        rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, hs]
    exact hle hg
  have transport : ∀ {Z : Scheme.{u}} (s : Z ⟶ Spec (.of K)) (U : Z.Opens) (x x' : Z)
      (hxx : x = x') (hx : x ∈ U) (hx' : x' ∈ U) (c : K) (g : Γ(Z, U)),
      (Z.presheaf.germ U x hx).hom g - wcLdpConst K s x c ∈
          IsLocalRing.maximalIdeal (Z.presheaf.stalk x) →
      (Z.presheaf.germ U x' hx').hom g - wcLdpConst K s x' c ∈
          IsLocalRing.maximalIdeal (Z.presheaf.stalk x') := by
    intro Z s U x x' hxx hx hx' c g h
    subst hxx
    exact h
  have appTopEq : ∀ {T T' : Scheme.{u}} (f : T ⟶ T') (h : ⊤ ≤ f ⁻¹ᵁ ⊤) (y : Γ(T', ⊤)),
      (f.appLE ⊤ ⊤ h).hom y = f.appTop.hom y :=
    fun f h y => congrArg (fun φ => φ.hom y) (Scheme.Hom.appLE_eq_app f (U := ⊤))

  obtain ⟨ψX, hψX⟩ : ∃ g : Spec (.of (MvPolynomial F Γ(X.left, V))) ⟶ X.left,
      g = Spec.map (CommRingCat.ofHom
        (MvPolynomial.C : Γ(X.left, V) →+* MvPolynomial F Γ(X.left, V))) ≫ hV.fromSpec :=
    ⟨_, rfl⟩
  have hXV : ∀ ω, ψX ω ∈ V := by
    intro ω
    rw [hψX, Scheme.Hom.comp_apply]
    show _ ∈ (V : Set X.left)
    rw [← hV.range_fromSpec]
    exact Set.mem_range_self _
  have hXV' : ⊤ ≤ ψX ⁻¹ᵁ V := fun ω _ => hXV ω
  haveI : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom
      (MvPolynomial.C : Γ(X.left, V) →+* MvPolynomial F Γ(X.left, V)))) := by
    rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
    show (MvPolynomial.C : Γ(X.left, V) →+* MvPolynomial F Γ(X.left, V)).FiniteType
    rw [← MvPolynomial.algebraMap_eq]
    exact RingHom.finiteType_algebraMap.mpr inferInstance
  haveI := hV.isOpenImmersion_fromSpec
  haveI : LocallyOfFiniteType (ψX ≫ X.hom) := by rw [hψX]; infer_instance
  haveI hWJ : JacobsonSpace (Spec (.of (MvPolynomial F Γ(X.left, V)))) :=
    LocallyOfFiniteType.jacobsonSpace (ψX ≫ X.hom)
  have hXpull : ∀ a, (ψX.appLE V ⊤ hXV').hom a =
      (Scheme.ΓSpecIso (.of (MvPolynomial F Γ(X.left, V)))).inv.hom (MvPolynomial.C a) := by
    intro a
    rw [s2 hV _ ψX hψX hXV' a]
    exact (congrArg (fun φ => φ.hom a) (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom
      (MvPolynomial.C : Γ(X.left, V) →+* MvPolynomial F Γ(X.left, V))))).symm
  obtain ⟨t, ht_def⟩ : ∃ t : Fin (M + 1) → Γ(Spec (.of (MvPolynomial F Γ(X.left, V))), ⊤),
      ∀ j, t j = (Scheme.ΓSpecIso (.of (MvPolynomial F Γ(X.left, V)))).inv.hom (Y j) :=
    ⟨fun j => _, fun j => rfl⟩
  have htr : t r = 1 := by rw [ht_def, hYr, map_one]
  have hspan : Ideal.span (Set.range t) = ⊤ :=
    Ideal.eq_top_of_isUnit_mem _ (Ideal.subset_span ⟨r, htr⟩) isUnit_one
  obtain ⟨ψP, hψS, hpre, hsec⟩ := wc_ldpi_oai_proj_lift K M _ (ψX ≫ X.hom) t hspan
  have hPr : ψP ⁻¹ᵁ wcSgD K M r = ⊤ := by
    rw [hpre r, htr]; exact Scheme.basicOpen_of_isUnit _ isUnit_one
  have hPr' : ⊤ ≤ ψP ⁻¹ᵁ wcSgD K M r := hPr.ge
  have hPrω : ∀ ω, ψP ω ∈ wcSgD K M r := fun ω => by
    show ω ∈ ψP ⁻¹ᵁ wcSgD K M r
    rw [hPr]; trivial
  have hYsec : ∀ q, (ψP.appLE (wcSgD K M r) ⊤ hPr').hom (wcSgE K M r q) = t q := by
    intro q
    have h := hsec r q ⊤ hPr'
    rw [htr, map_one, mul_one] at h
    refine h.trans ?_
    have e : (homOfLE (le_top : (⊤ : (Spec (.of (MvPolynomial F Γ(X.left, V)))).Opens) ≤ ⊤)) =
        𝟙 _ := Subsingleton.elim _ _
    rw [e, op_id, CategoryTheory.Functor.map_id]
    rfl
  have hcomm : ψX ≫ X.hom = ψP ≫ wcProjKStr K M := hψS.symm
  obtain ⟨ψ, h1, h2⟩ : ∃ ψ : Spec (.of (MvPolynomial F Γ(X.left, V))) ⟶
      Limits.pullback X.hom (wcProjKStr K M),
      ψ ≫ Limits.pullback.fst X.hom (wcProjKStr K M) = ψX ∧
        ψ ≫ Limits.pullback.snd X.hom (wcProjKStr K M) = ψP :=
    ⟨Limits.pullback.lift ψX ψP hcomm, Limits.pullback.lift_fst _ _ _,
      Limits.pullback.lift_snd _ _ _⟩
  have h1' : ∀ ω, Limits.pullback.fst X.hom (wcProjKStr K M) (ψ ω) = ψX ω := fun ω => by
    rw [← Scheme.Hom.comp_apply, h1]
  have h2' : ∀ ω, Limits.pullback.snd X.hom (wcProjKStr K M) (ψ ω) = ψP ω := fun ω => by
    rw [← Scheme.Hom.comp_apply, h2]
  haveI : Smooth (wcProjKStr K M) := by
    haveI := wc_proj_space_smooth K M
    exact SmoothOfRelativeDimension.smooth M (wcProjKStr K M)
  haveI hPJ : JacobsonSpace ↥(Limits.pullback X.hom (wcProjKStr K M)) :=
    LocallyOfFiniteType.jacobsonSpace (Limits.pullback.fst X.hom (wcProjKStr K M) ≫ X.hom)
  haveI : LocallyOfFiniteType (ψ ≫ Limits.pullback.fst X.hom (wcProjKStr K M) ≫ X.hom) := by
    rw [← Category.assoc, h1]; infer_instance
  haveI : LocallyOfFiniteType ψ :=
    locallyOfFiniteType_of_comp _ (Limits.pullback.fst X.hom (wcProjKStr K M) ≫ X.hom)
  refine ⟨Spec (.of (MvPolynomial F Γ(X.left, V))), ψ, fun _ => inferInstance, hWJ,
    fun ω => ⟨by rw [h1']; exact hXV ω, by rw [h2']; exact hPrω ω⟩, ?_, ?_⟩

  · intro ω hω
    have hcl : IsClosed ({ψ ω} : Set ↥(Limits.pullback X.hom (wcProjKStr K M))) :=
      mem_closedPoints_iff.mp (Scheme.Hom.closePoints_subset_preimage_closedPoints ψ
        (mem_closedPoints_iff.mpr hω))
    obtain ⟨χ, hχ⟩ : ∃ χ : Γ(Spec (.of (MvPolynomial F Γ(X.left, V))), ⊤) →+* K, ∀ g,
        ((Spec (.of (MvPolynomial F Γ(X.left, V)))).presheaf.germ ⊤ ω trivial).hom g -
          wcLdpConst K (ψX ≫ X.hom) ω (χ g) ∈
        IsLocalRing.maximalIdeal ((Spec (.of (MvPolynomial F Γ(X.left, V)))).presheaf.stalk ω) := by
      letI := (wcCnSigma (ψX ≫ X.hom) ⊤).toAlgebra
      obtain ⟨χ, hχ⟩ := wc_ldp_dtc_rational_eval K (ψX ≫ X.hom) ⊤ ω trivial hω
      exact ⟨χ.toRingHom, hχ⟩
    obtain ⟨e, he⟩ : ∃ e : MvPolynomial F Γ(X.left, V) →+* K, ∀ p,
        e p = χ ((Scheme.ΓSpecIso (.of (MvPolynomial F Γ(X.left, V)))).inv.hom p) :=
      ⟨χ.comp (Scheme.ΓSpecIso (.of (MvPolynomial F Γ(X.left, V)))).inv.hom,
        fun p => rfl⟩
    have germ_aux : ∀ (x : X.left) (hx : x = ψX ω) (hxV : x ∈ V) (a : Γ(X.left, V)),
        (X.left.presheaf.germ V x hxV).hom a - wcLdpConst K X.hom x (e (MvPolynomial.C a)) ∈
          IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) := by
      intro x hx hxV a
      subst hx
      refine (s1 X.hom ψX V hXV' ω hxV a (e (MvPolynomial.C a))).mpr ?_
      rw [hXpull a, he]
      exact hχ _
    have coord_aux : ∀ (s : wcProjK K M) (hs : s = ψP ω),
        wcLdnmDiaCoord K M s r (fun j => e (Y j)) := by
      intro s hs
      subst hs
      refine ⟨hPrω ω, fun q => ?_⟩
      refine (s1 (wcProjKStr K M) ψP (wcSgD K M r) hPr' ω (hPrω ω) (wcSgE K M r q)
        (e (Y q))).mpr ?_
      rw [hYsec q, hψS, he, ← ht_def]
      exact hχ (t q)
    exact ⟨hcl, by rw [h1']; exact hXV ω, e, fun a => germ_aux _ (h1' ω) _ a,
      coord_aux _ (h2' ω)⟩

  · intro w hw hxV e hg hc
    obtain ⟨hr, hcq⟩ := hc
    obtain ⟨⟨σ, hσ, hσw⟩, -⟩ := wc_ldp_cf_rational_point K
      (Limits.pullback.fst X.hom (wcProjKStr K M) ≫ X.hom) w hw
    have hsub : ∀ (p : Spec (.of K)), p = IsLocalRing.closedPoint K := fun p => Subsingleton.elim _ _
    have hfst : Spec.map (CommRingCat.ofHom e) ≫ ψX =
        σ ≫ Limits.pullback.fst X.hom (wcProjKStr K M) := by
      have hpt : (σ ≫ Limits.pullback.fst X.hom (wcProjKStr K M)) (IsLocalRing.closedPoint K) =
          Limits.pullback.fst X.hom (wcProjKStr K M) w := by
        exact (Scheme.Hom.comp_apply _ _ _).trans (congrArg _ hσw)
      have hb : ⊤ ≤ (σ ≫ Limits.pullback.fst X.hom (wcProjKStr K M)) ⁻¹ᵁ V := by
        intro p _
        show (σ ≫ Limits.pullback.fst X.hom (wcProjKStr K M)) p ∈ V
        rw [hsub p, hpt]; exact hxV
      have ha : ⊤ ≤ (Spec.map (CommRingCat.ofHom e) ≫ ψX) ⁻¹ᵁ V := fun p _ => hXV _
      have hxU : (σ ≫ Limits.pullback.fst X.hom (wcProjKStr K M)) (IsLocalRing.closedPoint K) ∈ V :=
        hb (Set.mem_univ (IsLocalRing.closedPoint K))
      refine s3 hV _ _ ha hb (fun g => ?_)
      have hA : ((Spec.map (CommRingCat.ofHom e) ≫ ψX).appLE V ⊤ ha).hom g =
          (Scheme.ΓSpecIso (.of K)).inv.hom (e (MvPolynomial.C g)) := by
        rw [s2 hV (Spec.map (CommRingCat.ofHom e) ≫ Spec.map (CommRingCat.ofHom
          (MvPolynomial.C : Γ(X.left, V) →+* MvPolynomial F Γ(X.left, V)))) _
          (by rw [hψX, Category.assoc]) ha g]
        rw [← Spec.map_comp]
        exact (congrArg (fun φ => φ.hom g) (Scheme.ΓSpecIso_inv_naturality
          (CommRingCat.ofHom (MvPolynomial.C : Γ(X.left, V) →+* MvPolynomial F Γ(X.left, V)) ≫
            CommRingCat.ofHom e))).symm
      have hB : ((σ ≫ Limits.pullback.fst X.hom (wcProjKStr K M)).appLE V ⊤ hb).hom g =
          (Scheme.ΓSpecIso (.of K)).inv.hom (e (MvPolynomial.C g)) :=
        s4 X.hom (σ ≫ Limits.pullback.fst X.hom (wcProjKStr K M))
          (by rw [Category.assoc]; exact hσ) V hb hxU g (e (MvPolynomial.C g))
          (transport X.hom V _ _ hpt.symm hxV hxU _ g (hg g))
      rw [hA, hB]
    have hsnd : Spec.map (CommRingCat.ofHom e) ≫ ψP =
        σ ≫ Limits.pullback.snd X.hom (wcProjKStr K M) := by
      have hσs : (σ ≫ Limits.pullback.snd X.hom (wcProjKStr K M)) ≫ wcProjKStr K M = 𝟙 _ := by
        rw [Category.assoc, ← Limits.pullback.condition]; exact hσ
      have hus : (Spec.map (CommRingCat.ofHom e) ≫ ψP) ≫ wcProjKStr K M = 𝟙 _ := by
        rw [Category.assoc, hψS, ← Category.assoc, hfst, Category.assoc]; exact hσ
      have hpt : (σ ≫ Limits.pullback.snd X.hom (wcProjKStr K M)) (IsLocalRing.closedPoint K) =
          Limits.pullback.snd X.hom (wcProjKStr K M) w := by
        exact (Scheme.Hom.comp_apply _ _ _).trans (congrArg _ hσw)
      have hu : ⊤ ≤ (Spec.map (CommRingCat.ofHom e) ≫ ψP) ⁻¹ᵁ wcSgD K M r :=
        fun p _ => hPrω _
      have hv : ⊤ ≤ (σ ≫ Limits.pullback.snd X.hom (wcProjKStr K M)) ⁻¹ᵁ wcSgD K M r := by
        intro p _
        show (σ ≫ Limits.pullback.snd X.hom (wcProjKStr K M)) p ∈ wcSgD K M r
        rw [hsub p, hpt]; exact hr
      have hxU : (σ ≫ Limits.pullback.snd X.hom (wcProjKStr K M)) (IsLocalRing.closedPoint K) ∈
          wcSgD K M r :=
        hv (Set.mem_univ (IsLocalRing.closedPoint K))
      refine s5 _ _ (hus.trans hσs.symm) hu hv (fun q => ?_)
      have hU : ((Spec.map (CommRingCat.ofHom e) ≫ ψP).appLE (wcSgD K M r) ⊤ hu).hom
          (wcSgE K M r q) = (Scheme.ΓSpecIso (.of K)).inv.hom (e (Y q)) := by
        have hc := Scheme.Hom.appLE_comp_appLE (Spec.map (CommRingCat.ofHom e)) ψP
          (wcSgD K M r) ⊤ ⊤ hPr' (fun _ _ => trivial)
        rw [← hc]
        show ((Spec.map (CommRingCat.ofHom e)).appLE ⊤ ⊤ _).hom
          ((ψP.appLE (wcSgD K M r) ⊤ hPr').hom (wcSgE K M r q)) = _
        rw [hYsec q]
        refine (appTopEq _ _ _).trans ?_
        rw [ht_def]
        exact (congrArg (fun φ => φ.hom (Y q))
          (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom e))).symm
      have hV' : ((σ ≫ Limits.pullback.snd X.hom (wcProjKStr K M)).appLE (wcSgD K M r) ⊤ hv).hom
          (wcSgE K M r q) = (Scheme.ΓSpecIso (.of K)).inv.hom (e (Y q)) :=
        s4 (wcProjKStr K M) (σ ≫ Limits.pullback.snd X.hom (wcProjKStr K M)) hσs
          (wcSgD K M r) hv hxU (wcSgE K M r q) (e (Y q))
          (transport (wcProjKStr K M) (wcSgD K M r) _ _ hpt.symm hr hxU _ _ (hcq q))
      rw [hU, hV']
    have hmain : Spec.map (CommRingCat.ofHom e) ≫ ψ = σ :=
      Limits.pullback.hom_ext (by rw [Category.assoc, h1, hfst])
        (by rw [Category.assoc, h2, hsnd])
    have hpt' : ∀ (f g : Spec (.of K) ⟶ Limits.pullback X.hom (wcProjKStr K M)), f = g →
        ∀ p, f p = g p := fun f g h p => by rw [h]
    exact ⟨Spec.map (CommRingCat.ofHom e) (IsLocalRing.closedPoint K),
      ((Scheme.Hom.comp_apply _ _ _).symm.trans (hpt' _ _ hmain _)).trans hσw⟩

theorem wc_ldnm_dia_pieces (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ) (hn : 1 ≤ n)
    (X : Over (Spec (.of K))) [GeometricallyIrreducible X.hom] [SmoothOfRelativeDimension n X.hom]
    (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr K N = X.hom)
    (x₀ : X.left) (hx₀ : IsClosed ({x₀} : Set X.left)) :
    ∃ (V : X.left.Opens) (R : Set (Fin (wcLdnmM N + 1))), x₀ ∈ V ∧ R.Nonempty ∧
      (∀ x : X.left, IsClosed ({x} : Set X.left) → x ∈ V → ∀ r ∈ R,
        ∃ α : Fin (wcLdnmM N + 1) → K, α r = 1 ∧
          wcLdnmDiaSing K N ι (fun q => α (wcLdnmIdx N q)) x) ∧
      (∀ x : X.left, IsClosed ({x} : Set X.left) → x ∈ V → ∀ α : Fin (wcLdnmM N + 1) → K,
        α ≠ 0 → wcLdnmDiaSing K N ι (fun q => α (wcLdnmIdx N q)) x → ∃ r ∈ R, α r ≠ 0) ∧
      ∀ r ∈ R, ∃ (W : Scheme.{u}) (ψ : W ⟶ Limits.pullback X.hom (wcProjKStr K (wcLdnmM N))),
        IrreducibleSpace W ∧ JacobsonSpace W ∧
        (∀ ω, Limits.pullback.fst X.hom (wcProjKStr K (wcLdnmM N)) (ψ ω) ∈ V ∧
          Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N)) (ψ ω) ∈ wcSgD K (wcLdnmM N) r) ∧
        (∀ ω, IsClosed ({ω} : Set W) →
          IsClosed ({ψ ω} : Set ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N)))) ∧
          ∀ α : Fin (wcLdnmM N + 1) → K, wcLdnmDiaCoord K (wcLdnmM N)
              (Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N)) (ψ ω)) r α →
            wcLdnmDiaSing K N ι (fun q => α (wcLdnmIdx N q))
              (Limits.pullback.fst X.hom (wcProjKStr K (wcLdnmM N)) (ψ ω))) ∧
        ∀ w : ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N))),
          IsClosed ({w} : Set ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N)))) →
          Limits.pullback.fst X.hom (wcProjKStr K (wcLdnmM N)) w ∈ V →
          ∀ α : Fin (wcLdnmM N + 1) → K, wcLdnmDiaCoord K (wcLdnmM N)
              (Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N)) w) r α →
            wcLdnmDiaSing K N ι (fun q => α (wcLdnmIdx N q))
              (Limits.pullback.fst X.hom (wcProjKStr K (wcLdnmM N)) w) →
            ∃ ω, ψ ω = w :=
by
  classical
  haveI hXsm : Smooth X.hom := SmoothOfRelativeDimension.smooth n X.hom
  haveI : SmoothOfRelativeDimension (wcLdnmM N) (wcProjKStr K (wcLdnmM N)) :=
    wc_proj_space_smooth K (wcLdnmM N)
  haveI : Smooth (wcProjKStr K (wcLdnmM N)) := SmoothOfRelativeDimension.smooth (wcLdnmM N) _
  haveI : JacobsonSpace X.left := LocallyOfFiniteType.jacobsonSpace X.hom
  haveI : JacobsonSpace (wcProjK K (wcLdnmM N)) :=
    LocallyOfFiniteType.jacobsonSpace (wcProjKStr K (wcLdnmM N))
  haveI hPJ : JacobsonSpace ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N))) :=
    LocallyOfFiniteType.jacobsonSpace
      (Limits.pullback.fst X.hom (wcProjKStr K (wcLdnmM N)) ≫ X.hom)
  have hfstc : ∀ w : ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N))),
      IsClosed ({w} : Set ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N)))) →
      IsClosed ({Limits.pullback.fst X.hom (wcProjKStr K (wcLdnmM N)) w} : Set X.left) :=
    fun w hw => mem_closedPoints_iff.mp (Scheme.Hom.closePoints_subset_preimage_closedPoints
      (Limits.pullback.fst X.hom (wcProjKStr K (wcLdnmM N))) (mem_closedPoints_iff.mpr hw))
  have hsndc : ∀ w : ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N))),
      IsClosed ({w} : Set ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N)))) →
      IsClosed ({Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N)) w} :
        Set (wcProjK K (wcLdnmM N))) :=
    fun w hw => mem_closedPoints_iff.mp (Scheme.Hom.closePoints_subset_preimage_closedPoints
      (Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N))) (mem_closedPoints_iff.mpr hw))

  have hU : ∀ {Z : Scheme.{u}} (s : Z ⟶ Spec (.of K)) (z : Z) (c : K),
      wcLdpConst K s z c ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk z) → c = 0 := by
    intro Z s z c hc
    by_contra hne
    exact (IsLocalRing.notMem_maximalIdeal.mpr
      ((isUnit_iff_ne_zero.mpr hne).map (wcLdpConst K s z))) hc
  have hU2 : ∀ {Z : Scheme.{u}} (s : Z ⟶ Spec (.of K)) (z : Z) (a : Z.presheaf.stalk z)
      (c c' : K),
      a - wcLdpConst K s z c ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk z) →
      a - wcLdpConst K s z c' ∈ IsLocalRing.maximalIdeal (Z.presheaf.stalk z) → c = c' := by
    intro Z s z a c c' h1 h2
    have h3 := Ideal.sub_mem _ h2 h1
    have h4 : (a - wcLdpConst K s z c') - (a - wcLdpConst K s z c) =
        wcLdpConst K s z (c - c') := by
      rw [map_sub]; ring
    rw [h4] at h3
    exact sub_eq_zero.mp (hU s z _ h3)

  obtain ⟨V, J, S0, hVaff, hx₀V, hdom, hS0, hdet, ⟨q₀, hq₀⟩, hcrit⟩ :=
    wc_ldnm_dia_jet_chart K N n hn X ι hι hιX x₀ hx₀

  have hres : ∀ (x : X.left), IsClosed ({x} : Set X.left) → ∀ (hxV : x ∈ V),
      ∃ χ : Γ(X.left, V) →+* K, ∀ a, (X.left.presheaf.germ V x hxV).hom a -
        wcLdpConst K X.hom x (χ a) ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) := by
    intro x hx hxV
    obtain ⟨-, hc⟩ := wc_ldp_cf_rational_point K X.hom x hx
    choose c hc using hc
    have key : ∀ (y : X.left.presheaf.stalk x) (d : K),
        y - wcLdpConst K X.hom x d ∈ IsLocalRing.maximalIdeal (X.left.presheaf.stalk x) →
        c y = d :=
      fun y d h => hU2 X.hom x y _ _ (hc y) h
    refine ⟨{ toFun := fun a => c ((X.left.presheaf.germ V x hxV).hom a),
              map_one' := key _ _ (by simp),
              map_mul' := fun a b => key _ _ ?_,
              map_zero' := key _ _ (by simp),
              map_add' := fun a b => key _ _ ?_ }, fun a => hc _⟩
    · have e : (X.left.presheaf.germ V x hxV).hom (a * b) -
          wcLdpConst K X.hom x (c ((X.left.presheaf.germ V x hxV).hom a) *
            c ((X.left.presheaf.germ V x hxV).hom b)) =
          ((X.left.presheaf.germ V x hxV).hom a -
            wcLdpConst K X.hom x (c ((X.left.presheaf.germ V x hxV).hom a))) *
            (X.left.presheaf.germ V x hxV).hom b +
          wcLdpConst K X.hom x (c ((X.left.presheaf.germ V x hxV).hom a)) *
            ((X.left.presheaf.germ V x hxV).hom b -
              wcLdpConst K X.hom x (c ((X.left.presheaf.germ V x hxV).hom b))) := by
        rw [map_mul, map_mul]; ring
      rw [e]
      exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (hc _)) (Ideal.mul_mem_left _ _ (hc _))
    · have e : (X.left.presheaf.germ V x hxV).hom (a + b) -
          wcLdpConst K X.hom x (c ((X.left.presheaf.germ V x hxV).hom a) +
            c ((X.left.presheaf.germ V x hxV).hom b)) =
          ((X.left.presheaf.germ V x hxV).hom a -
            wcLdpConst K X.hom x (c ((X.left.presheaf.germ V x hxV).hom a))) +
          ((X.left.presheaf.germ V x hxV).hom b -
            wcLdpConst K X.hom x (c ((X.left.presheaf.germ V x hxV).hom b))) := by
        rw [map_add, map_add]; ring
      rw [e]
      exact Ideal.add_mem _ (hc _) (hc _)

  have hdetχ : ∀ χ : Γ(X.left, V) →+* K, (Matrix.of fun i l => χ (J i (S0 l))).det ≠ 0 := by
    intro χ
    have h1 : (Matrix.of fun i l => χ (J i (S0 l))) =
        χ.mapMatrix (Matrix.of fun i l => J i (S0 l)) := by
      ext i l; simp [RingHom.mapMatrix_apply]
    rw [h1, ← RingHom.map_det]
    exact (hdet.map χ).ne_zero

  have ha2 : ∀ (β : Fin (n + 1) → Fin (N + 1) × Fin (N + 1) → K),
      (Matrix.of fun i l => β i (S0 l)).det ≠ 0 →
      ∀ v : Fin (N + 1) × Fin (N + 1) → K, (∀ i, ∑ q, β i q * v q = 0) →
        (∀ q, q ∉ Set.range S0 → v q = 0) → v = 0 := by
    intro β hB v hv hoff
    have h1 : (Matrix.of fun i l => β i (S0 l)).mulVec (fun l => v (S0 l)) = 0 := by
      funext i
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply]
      exact (Fintype.sum_of_injective S0 hS0 (fun l => β i (S0 l) * v (S0 l))
        (fun q => β i q * v q) (fun q hq => by rw [hoff q hq, mul_zero]) (fun l => rfl)).trans
        (hv i)
    have h2 := Matrix.eq_zero_of_mulVec_eq_zero hB h1
    funext q
    by_cases hq : q ∈ Set.range S0
    · obtain ⟨l, rfl⟩ := hq
      exact congrFun h2 l
    · exact hoff q hq
  refine ⟨V, {r | (wcLdnmIdx N).symm r ∉ Set.range S0}, hx₀V, ⟨wcLdnmIdx N q₀, ?_⟩, ?_, ?_, ?_⟩
  · show (wcLdnmIdx N).symm (wcLdnmIdx N q₀) ∉ Set.range S0
    rw [Equiv.symm_apply_apply]; exact hq₀
  ·
    intro x hx hxV r hr
    obtain ⟨χ, hχ⟩ := hres x hx hxV
    obtain ⟨Y, hYr, -, hJY, -⟩ := wc_ldnm_dia_kernel_param Γ(X.left, V) (n + 1) J S0 hS0 hdet
      ((wcLdnmIdx N).symm r) hr
    obtain ⟨e, he⟩ : ∃ e : MvPolynomial {q : Fin (N + 1) × Fin (N + 1) //
        q ∉ Set.range S0 ∧ q ≠ (wcLdnmIdx N).symm r} Γ(X.left, V) →+* K,
        ∀ a, e (MvPolynomial.C a) = χ a :=
      ⟨MvPolynomial.eval₂Hom χ (fun _ => 0), fun a => MvPolynomial.eval₂Hom_C _ _ _⟩
    refine ⟨fun j => e (Y ((wcLdnmIdx N).symm j)), by simp only [hYr, map_one], ?_⟩
    simp only [Equiv.symm_apply_apply]
    refine (hcrit x hx hxV (fun i q => χ (J i q)) (fun i q => hχ _) _).mpr ?_
    intro i
    have h1 := congrArg e (hJY i)
    rw [map_sum, map_zero] at h1
    simpa only [map_mul, he] using h1
  ·
    intro x hx hxV α hα0 hsing
    obtain ⟨χ, hχ⟩ := hres x hx hxV
    have hk := (hcrit x hx hxV (fun i q => χ (J i q)) (fun i q => hχ _) _).mp hsing
    by_contra hcon
    push_neg at hcon
    apply hα0
    have hz := ha2 (fun i q => χ (J i q)) (hdetχ χ) (fun q => α (wcLdnmIdx N q)) hk
      (fun q hq => hcon _ (show (wcLdnmIdx N).symm (wcLdnmIdx N q) ∉ Set.range S0 by
        rw [Equiv.symm_apply_apply]; exact hq))
    funext j
    have h1 := congrFun hz ((wcLdnmIdx N).symm j)
    simpa only [Equiv.apply_symm_apply, Pi.zero_apply] using h1
  ·
    intro r hr
    obtain ⟨Y, hYr, -, hJY, huniq⟩ := wc_ldnm_dia_kernel_param Γ(X.left, V) (n + 1) J S0 hS0
      hdet ((wcLdnmIdx N).symm r) hr
    obtain ⟨W, ψ, hirr, hjac, hrange, hcp, hsurj⟩ := wc_ldnm_dia_graph_param K (wcLdnmM N) X V
      hVaff (fun j => Y ((wcLdnmIdx N).symm j)) r hYr
    refine ⟨W, ψ, hirr hdom, hjac, hrange, ?_, ?_⟩
    ·
      intro ω hω
      obtain ⟨hcl, hxV, e, hgerm, hcoord⟩ := hcp ω hω
      refine ⟨hcl, fun α hα => ?_⟩
      have hαe : α = fun j => e (Y ((wcLdnmIdx N).symm j)) := by
        funext j
        obtain ⟨h1, h1'⟩ := hα
        obtain ⟨h2, h2'⟩ := hcoord
        exact hU2 _ _ _ _ _ (h1' j) (h2' j)
      subst hαe
      have hx := hfstc _ hcl
      refine (hcrit _ hx hxV (fun i q => e (MvPolynomial.C (J i q))) (fun i q => hgerm _) _).mpr ?_
      intro i
      have h1 := congrArg e (hJY i)
      rw [map_sum, map_zero] at h1
      simpa only [map_mul, Equiv.symm_apply_apply] using h1
    ·
      intro w hw hwV α hα hsing
      have hx := hfstc w hw
      obtain ⟨χ, hχ⟩ := hres _ hx hwV
      have hk := (hcrit _ hx hwV (fun i q => χ (J i q)) (fun i q => hχ _) _).mp hsing
      have hαr : α r = 1 :=
        (wc_ldnm_dia_proj_coords K (wcLdnmM N) _ (hsndc w hw)).2.2.1 r α hα
      have hu := huniq K χ (fun q => α (wcLdnmIdx N q))
        (by simp only [Equiv.apply_symm_apply]; exact hαr) hk
      have hfun : (fun j => MvPolynomial.eval₂Hom χ (fun f => α (wcLdnmIdx N f.1))
          (Y ((wcLdnmIdx N).symm j))) = α := by
        funext j
        have h1 := hu ((wcLdnmIdx N).symm j)
        simp only [Equiv.apply_symm_apply] at h1
        first
          | exact h1
          | (rw [MvPolynomial.coe_eval₂Hom]; exact h1)
      have hα' : wcLdnmDiaCoord K (wcLdnmM N)
          (Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N)) w) r
          (fun j => MvPolynomial.eval₂Hom χ (fun f => α (wcLdnmIdx N f.1))
            (Y ((wcLdnmIdx N).symm j))) := by
        rw [hfun]; exact hα
      refine hsurj w hw hwV (MvPolynomial.eval₂Hom χ (fun f => α (wcLdnmIdx N f.1)))
        (fun a => ?_) hα'
      rw [MvPolynomial.eval₂Hom_C]; exact hχ a

theorem wc_ldnm_dia_prod_points (K : Type u) [Field K] [IsAlgClosed K] (M : ℕ) (X : Scheme.{u})
    (f : X ⟶ Spec (.of K)) [LocallyOfFiniteType f] (x : X) (hx : IsClosed ({x} : Set X))
    (r : Fin (M + 1)) (α : Fin (M + 1) → K) (hα : α r = 1) :
    ∃ w : ↥(Limits.pullback f (wcProjKStr K M)),
      IsClosed ({w} : Set ↥(Limits.pullback f (wcProjKStr K M))) ∧
      Limits.pullback.fst f (wcProjKStr K M) w = x ∧
      wcLdnmDiaCoord K M (Limits.pullback.snd f (wcProjKStr K M) w) r α :=
by
  classical
  obtain ⟨⟨y, hy, hyx⟩, -⟩ := wc_ldp_cf_rational_point K f x hx
  set t : Fin (M + 1) → Γ(Spec (.of K), ⊤) :=
    fun J => (Scheme.ΓSpecIso (.of K)).inv.hom (α J) with ht_def
  have htr : t r = 1 := by simp only [ht_def, hα, map_one]
  have hspan : Ideal.span (Set.range t) = ⊤ := by
    have hmem : (1 : Γ(Spec (.of K), ⊤)) ∈ Ideal.span (Set.range t) := Ideal.subset_span ⟨r, htr⟩
    exact Ideal.eq_top_of_isUnit_mem _ hmem isUnit_one
  obtain ⟨φ, hφS, hpre, hsec⟩ := wc_ldpi_oai_proj_lift K M (Spec (.of K)) (𝟙 _) t hspan
  set cp : Spec (.of K) := IsLocalRing.closedPoint K with hcp
  have hDr : φ ⁻¹ᵁ wcSgD K M r = ⊤ := by
    rw [hpre r, htr]
    exact Scheme.basicOpen_of_isUnit _ isUnit_one
  have hr : φ cp ∈ wcSgD K M r := by
    show cp ∈ φ ⁻¹ᵁ wcSgD K M r
    rw [hDr]
    trivial
  have hcoord : wcLdnmDiaCoord K M (φ cp) r α := by
    refine ⟨hr, fun q => ?_⟩
    have hs := hsec r q (φ ⁻¹ᵁ wcSgD K M r) le_rfl
    rw [htr, map_one, mul_one, ← Scheme.Hom.app_eq_appLE] at hs
    have hA : (φ.stalkMap cp).hom
        (((wcProjK K M).presheaf.germ (wcSgD K M r) (φ cp) hr).hom (wcSgE K M r q)) =
        ((Spec (.of K)).presheaf.germ ⊤ cp trivial).hom (t q) := by
      have k1 := Scheme.Hom.germ_stalkMap_apply φ (wcSgD K M r) cp hr (wcSgE K M r q)
      rw [hs] at k1
      exact k1.trans (TopCat.Presheaf.germ_res_apply _ _ _ _ _)
    have e2 : ∀ z, (φ.app ⊤).hom ((wcProjKStr K M).appTop.hom z) = z := by
      intro z
      change ((wcProjKStr K M).appTop ≫ φ.appTop).hom z = z
      rw [← Scheme.Hom.comp_appTop, hφS, Scheme.Hom.id_appTop]
      rfl
    have hB : (φ.stalkMap cp).hom (wcLdpConst K (wcProjKStr K M) (φ cp) (α q)) =
        ((Spec (.of K)).presheaf.germ ⊤ cp trivial).hom (t q) := by
      have k1 := Scheme.Hom.germ_stalkMap_apply φ ⊤ cp (by trivial)
        ((wcProjKStr K M).appTop.hom ((Scheme.ΓSpecIso (.of K)).inv.hom (α q)))
      rw [e2] at k1
      exact k1
    rw [IsLocalRing.mem_maximalIdeal, ← map_mem_nonunits_iff (φ.stalkMap cp).hom, map_sub, hA, hB,
      sub_self]
    exact zero_mem_nonunits.mpr zero_ne_one
  haveI : Smooth (wcProjKStr K M) := by
    haveI := wc_proj_space_smooth K M
    exact SmoothOfRelativeDimension.smooth M (wcProjKStr K M)
  have h1 : Limits.pullback.lift y φ (hy.trans hφS.symm) ≫ Limits.pullback.fst f (wcProjKStr K M) = y :=
    Limits.pullback.lift_fst _ _ _
  have h2 : Limits.pullback.lift y φ (hy.trans hφS.symm) ≫ Limits.pullback.snd f (wcProjKStr K M) = φ :=
    Limits.pullback.lift_snd _ _ _
  haveI : JacobsonSpace ↥(Limits.pullback f (wcProjKStr K M)) :=
    LocallyOfFiniteType.jacobsonSpace (Limits.pullback.fst f (wcProjKStr K M) ≫ f)
  have hcomp : Limits.pullback.lift y φ (hy.trans hφS.symm) ≫
      Limits.pullback.fst f (wcProjKStr K M) ≫ f = 𝟙 _ := by
    rw [← Category.assoc, h1, hy]
  haveI : LocallyOfFiniteType (Limits.pullback.lift y φ (hy.trans hφS.symm) ≫
      Limits.pullback.fst f (wcProjKStr K M) ≫ f) := by
    rw [hcomp]; infer_instance
  haveI : LocallyOfFiniteType (Limits.pullback.lift y φ (hy.trans hφS.symm)) :=
    locallyOfFiniteType_of_comp _ (Limits.pullback.fst f (wcProjKStr K M) ≫ f)
  have hcl : Limits.pullback.lift y φ (hy.trans hφS.symm) cp ∈ closedPoints _ :=
    Scheme.Hom.closePoints_subset_preimage_closedPoints _
      (mem_closedPoints_iff.mpr (IsLocalRing.isClosed_singleton_closedPoint K))
  refine ⟨Limits.pullback.lift y φ (hy.trans hφS.symm) cp, mem_closedPoints_iff.mp hcl, ?_, ?_⟩
  · rw [← Scheme.Hom.comp_apply, h1, hyx]
  · rw [← Scheme.Hom.comp_apply, h2]
    exact hcoord

theorem wc_ldnm_di_algclosed (K : Type u) [Field K] [IsAlgClosed K] (N n : ℕ) (hn2 : 2 ≤ n)
    (X : Over (Spec (.of K))) [IsProper X.hom] [GeometricallyIrreducible X.hom]
    [SmoothOfRelativeDimension n X.hom] (ι : X.left ⟶ wcProjK K N) (hι : IsClosedImmersion ι)
    (hιX : ι ≫ wcProjKStr K N = X.hom) (Z : Scheme.{u})
    (k : Z ⟶ Limits.pullback X.hom (wcProjKStr K (wcLdnmM N)))
    (hZ : wcLdnmLocEq (Limits.pullback X.hom (wcProjKStr K (wcLdnmM N)))
      (Fin (N + 1) × Fin (wcLdnmM N + 1)) (wcLdnmU K N X ι) (wcLdnmPhi K N X ι) Z k) :
    IsIrreducible ((k ≫ Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N))) ''
      wcLdnmNS (k ≫ Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N)))) :=
by
  classical
  have hn : 1 ≤ n := by omega

  have s1 : ∀ (D : Set ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N)))), IsClosed D →
      D.Nonempty → JacobsonSpace ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N))) →
      ∀ (ι' : Type u) (O I : ι' → Set ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N)))),
      (∀ j, IsOpen (O j)) → (∀ j, IsPreirreducible (I j)) →
      (∀ j, I j ⊆ D ∩ O j) →
      (∀ j y, y ∈ D → y ∈ O j → y ∈ closedPoints _ → y ∈ I j) →
      (∀ y ∈ D, y ∈ closedPoints _ → ∃ j, y ∈ O j) → (∀ i j, (D ∩ O i ∩ O j).Nonempty) →
      IsIrreducible D := by
    intro D hD hne _ ι' O I hO hI hIsub hIsurj hcov hpair
    have hcl : ∀ j, D ∩ O j ⊆ closure (I j) := by
      intro j y hy
      rw [mem_closure_iff]
      intro U hU hyU
      have hy' : y ∈ closure (D ∩ closedPoints _) := by
        rw [closure_inter_closedPoints hD]; exact hy.1
      obtain ⟨y', ⟨hy'U, hy'O⟩, hy'D, hy'c⟩ :=
        mem_closure_iff.mp hy' (U ∩ O j) (hU.inter (hO j)) ⟨hyU, hy.2⟩
      exact ⟨y', hy'U, hIsurj j y' hy'D hy'O hy'c⟩
    have hPj : ∀ j, IsPreirreducible (D ∩ O j) := by
      intro j u v hu hv ⟨a, haP, hau⟩ ⟨b, hbP, hbv⟩
      have h1 : (I j ∩ u).Nonempty := by
        obtain ⟨c, hcu, hcI⟩ := mem_closure_iff.mp (hcl j haP) u hu hau
        exact ⟨c, hcI, hcu⟩
      have h2 : (I j ∩ v).Nonempty := by
        obtain ⟨c, hcv, hcI⟩ := mem_closure_iff.mp (hcl j hbP) v hv hbv
        exact ⟨c, hcI, hcv⟩
      obtain ⟨c, hcI, hcuv⟩ := hI j u v hu hv h1 h2
      exact ⟨c, hIsub j hcI, hcuv⟩
    have hDcov : ∀ y ∈ D, ∃ j, y ∈ O j := by
      intro y hy
      by_contra hne'
      push_neg at hne'
      have hD' : IsClosed (D ∩ (⋃ j, O j)ᶜ) := hD.inter (isOpen_iUnion hO).isClosed_compl
      have hy' : y ∈ closure ((D ∩ (⋃ j, O j)ᶜ) ∩ closedPoints _) := by
        rw [closure_inter_closedPoints hD']
        exact ⟨hy, by simpa using hne'⟩
      obtain ⟨z, ⟨hzD, hzO⟩, hzc⟩ := closure_nonempty_iff.mp ⟨y, hy'⟩
      obtain ⟨j, hj⟩ := hcov z hzD hzc
      exact hzO (Set.mem_iUnion.mpr ⟨j, hj⟩)
    refine ⟨hne, ?_⟩
    intro u v hu hv ⟨y, hyD, hyu⟩ ⟨y', hy'D, hy'v⟩
    obtain ⟨i, hi⟩ := hDcov y hyD
    obtain ⟨j, hj⟩ := hDcov y' hy'D
    obtain ⟨z, ⟨⟨hzD, hzi⟩, hzj⟩⟩ := hpair i j
    obtain ⟨t, ⟨htD, hti⟩, htu, htj⟩ :=
      hPj i u (O j) hu (hO j) ⟨y, ⟨hyD, hi⟩, hyu⟩ ⟨z, ⟨hzD, hzi⟩, hzj⟩
    obtain ⟨s, ⟨hsD, hsj⟩, hsu, hsv⟩ :=
      hPj j u v hu hv ⟨t, ⟨htD, htj⟩, htu⟩ ⟨y', ⟨hy'D, hj⟩, hy'v⟩
    exact ⟨s, hsD, hsu, hsv⟩

  haveI hXsm : Smooth X.hom := SmoothOfRelativeDimension.smooth n X.hom
  haveI : SmoothOfRelativeDimension (wcLdnmM N) (wcProjKStr K (wcLdnmM N)) :=
    wc_proj_space_smooth K (wcLdnmM N)
  haveI : Smooth (wcProjKStr K (wcLdnmM N)) := SmoothOfRelativeDimension.smooth (wcLdnmM N) _
  haveI : JacobsonSpace X.left := LocallyOfFiniteType.jacobsonSpace X.hom
  haveI : JacobsonSpace (wcProjK K (wcLdnmM N)) :=
    LocallyOfFiniteType.jacobsonSpace (wcProjKStr K (wcLdnmM N))
  haveI hPJ : JacobsonSpace ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N))) :=
    LocallyOfFiniteType.jacobsonSpace
      (Limits.pullback.fst X.hom (wcProjKStr K (wcLdnmM N)) ≫ X.hom)
  haveI : UniversallyOpen X.hom := UniversallyOpen.of_flat X.hom
  haveI : IrreducibleSpace X.left :=
    GeometricallyIrreducible.irreducibleSpace X.hom X.hom.isOpenMap
  have hZ' := hZ
  obtain ⟨hk1, -, -, -⟩ := hZ'
  haveI := hk1

  have hfstc : ∀ w : ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N))),
      IsClosed ({w} : Set ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N)))) →
      IsClosed ({Limits.pullback.fst X.hom (wcProjKStr K (wcLdnmM N)) w} : Set X.left) :=
    fun w hw => mem_closedPoints_iff.mp (Scheme.Hom.closePoints_subset_preimage_closedPoints
      (Limits.pullback.fst X.hom (wcProjKStr K (wcLdnmM N))) (mem_closedPoints_iff.mpr hw))
  have hsndc : ∀ w : ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N))),
      IsClosed ({w} : Set ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N)))) →
      IsClosed ({Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N)) w} :
        Set (wcProjK K (wcLdnmM N))) :=
    fun w hw => mem_closedPoints_iff.mp (Scheme.Hom.closePoints_subset_preimage_closedPoints
      (Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N))) (mem_closedPoints_iff.mpr hw))

  have hL : ∀ (x : X.left) (a c : K) (α β : Fin (N + 1) × Fin (N + 1) → K),
      wcLdnmDiaSing K N ι α x → wcLdnmDiaSing K N ι β x →
      wcLdnmDiaSing K N ι (fun q => a * α q + c * β q) x := by
    intro x a c α β hα hβ
    unfold wcLdnmDiaSing at hα hβ ⊢
    intro b hb
    obtain ⟨h1, h2, -⟩ := wc_ldp_germ_linear K N X.hom ι hιX x b b hb hb
    have hq : wcLdpQuad K N (fun p p' => a * α (p, p') + c * β (p, p')) =
        a • wcLdpQuad K N (fun p p' => α (p, p')) + c • wcLdpQuad K N (fun p p' => β (p, p')) := by
      apply Subtype.ext
      simp only [wcLdpQuad, Submodule.coe_add, Submodule.coe_smul, MvPolynomial.smul_eq_C_mul,
        Finset.mul_sum, ← Finset.sum_add_distrib, map_add, map_mul, add_mul, mul_assoc]
    rw [hq, h1, h2, h2]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ (hα b hb)) (Ideal.mul_mem_left _ _ (hβ b hb))

  have hNSc : IsClosed (wcLdnmNS (k ≫ Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N)))) := by
    have : (wcLdnmNS (k ≫ Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N))))ᶜ =
        ⋃ (U : Z.Opens) (_ : Smooth (U.ι ≫ k ≫ Limits.pullback.snd X.hom
          (wcProjKStr K (wcLdnmM N)))), (U : Set Z) := by
      ext x
      simp only [wcLdnmNS, Set.mem_compl_iff, Set.mem_setOf_eq, not_not, Set.mem_iUnion,
        SetLike.mem_coe, exists_prop]
      constructor
      · rintro ⟨U, hx, hU⟩; exact ⟨U, hU, hx⟩
      · rintro ⟨U, hU, hx⟩; exact ⟨U, hx, hU⟩
    rw [← isOpen_compl_iff, this]
    exact isOpen_iUnion fun U => isOpen_iUnion fun _ => U.isOpen
  set D := k '' wcLdnmNS (k ≫ Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N))) with hDdef
  have hDc : IsClosed D := (Scheme.Hom.isClosedEmbedding k).isClosedMap _ hNSc
  suffices hD : IsIrreducible D by
    have e : (k ≫ Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N))) ''
        wcLdnmNS (k ≫ Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N))) =
        (Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N))) '' D := by
      rw [hDdef, Set.image_image]; rfl
    rw [e]
    exact hD.image _ (Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N))).continuous.continuousOn

  have hcrux := fun w hw r α hα =>
    wc_ldnm_dia_closed_crit K N n hn X ι hι hιX Z k hZ w hw r α hα
  have hC := fun s hs => wc_ldnm_dia_proj_coords K (wcLdnmM N) s hs
  have hP := fun (x₀ : X.left) (hx₀ : IsClosed ({x₀} : Set X.left)) =>
    wc_ldnm_dia_pieces K N n hn X ι hι hιX x₀ hx₀
  choose V R hxV hRne hA hB hPc using hP
  choose W ψ hWirr hWjac hψr hψcp hψs using hPc

  have hrangeD : ∀ (x₀ : X.left) (hx₀ : IsClosed ({x₀} : Set X.left)) (r : Fin (wcLdnmM N + 1))
      (hr : r ∈ R x₀ hx₀) (ω : W x₀ hx₀ r hr), ψ x₀ hx₀ r hr ω ∈ D := by
    intro x₀ hx₀ r hr ω
    haveI := hWjac x₀ hx₀ r hr
    have hcl : IsClosed (ψ x₀ hx₀ r hr ⁻¹' D) := hDc.preimage (ψ x₀ hx₀ r hr).continuous
    have hsub : closedPoints (W x₀ hx₀ r hr) ⊆ ψ x₀ hx₀ r hr ⁻¹' D := by
      intro ω' hω'
      have hω'c : IsClosed ({ω'} : Set (W x₀ hx₀ r hr)) := mem_closedPoints_iff.mp hω'
      obtain ⟨hwc, hsing⟩ := hψcp x₀ hx₀ r hr ω' hω'c
      have hrr := (hψr x₀ hx₀ r hr ω').2
      obtain ⟨α, hα⟩ := (hC _ (hsndc _ hwc)).2.1 r hrr
      exact (hcrux _ hwc r α hα).mpr (hsing α hα)
    have h2 := closure_minimal hsub hcl
    rw [closure_closedPoints] at h2
    exact h2 (Set.mem_univ ω)

  let ι' : Type u := {j : X.left × Fin (wcLdnmM N + 1) //
    ∃ h : IsClosed ({j.1} : Set X.left), j.2 ∈ R j.1 h}
  let O : ι' → Set ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N))) := fun j =>
    Limits.pullback.fst X.hom (wcProjKStr K (wcLdnmM N)) ⁻¹' (V j.1.1 j.2.choose : Set X.left) ∩
      Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N)) ⁻¹'
        (wcSgD K (wcLdnmM N) j.1.2 : Set (wcProjK K (wcLdnmM N)))
  let I : ι' → Set ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N))) := fun j =>
    Set.range (ψ j.1.1 j.2.choose j.1.2 j.2.choose_spec)
  have hO : ∀ j, IsOpen (O j) := fun j =>
    ((V j.1.1 j.2.choose).isOpen.preimage
      (Limits.pullback.fst X.hom (wcProjKStr K (wcLdnmM N))).continuous).inter
    ((wcSgD K (wcLdnmM N) j.1.2).isOpen.preimage
      (Limits.pullback.snd X.hom (wcProjKStr K (wcLdnmM N))).continuous)
  have hI : ∀ j, IsPreirreducible (I j) := by
    intro j
    haveI := hWirr j.1.1 j.2.choose j.1.2 j.2.choose_spec
    show IsPreirreducible (Set.range (ψ j.1.1 j.2.choose j.1.2 j.2.choose_spec))
    rw [← Set.image_univ]
    exact (IrreducibleSpace.isIrreducible_univ _).isPreirreducible.image _
      (Scheme.Hom.continuous _).continuousOn
  have hIsub : ∀ j, I j ⊆ D ∩ O j := by
    rintro j _ ⟨ω, rfl⟩
    exact ⟨hrangeD _ _ _ _ ω, (hψr _ _ _ _ ω).1, (hψr _ _ _ _ ω).2⟩
  have hIsurj : ∀ j y, y ∈ D → y ∈ O j → y ∈ closedPoints _ → y ∈ I j := by
    intro j y hyD hyO hyc
    obtain ⟨hyV, hyr⟩ := hyO
    have hyc' : IsClosed ({y} : Set ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N)))) :=
      mem_closedPoints_iff.mp hyc
    obtain ⟨α, hα⟩ := (hC _ (hsndc _ hyc')).2.1 j.1.2 hyr
    have hs := (hcrux y hyc' j.1.2 α hα).mp hyD
    obtain ⟨ω, hω⟩ := hψs j.1.1 j.2.choose j.1.2 j.2.choose_spec y hyc' hyV α hα hs
    exact ⟨ω, hω⟩
  have hcov : ∀ y ∈ D, y ∈ closedPoints _ → ∃ j, y ∈ O j := by
    intro y hyD hyc
    have hyc' : IsClosed ({y} : Set ↥(Limits.pullback X.hom (wcProjKStr K (wcLdnmM N)))) :=
      mem_closedPoints_iff.mp hyc
    have hxc := hfstc y hyc'
    obtain ⟨hc0, hc1, hc2, hc3⟩ := hC _ (hsndc _ hyc')
    obtain ⟨r₀, hr₀⟩ := hc0
    obtain ⟨α, hα⟩ := hc1 r₀ hr₀
    have hsing := (hcrux y hyc' r₀ α hα).mp hyD
    have hα0 : α ≠ 0 := by
      intro h0
      have h3 := hc2 r₀ α hα
      rw [h0] at h3
      simp at h3
    obtain ⟨r, hrR, hαr⟩ := hB _ hxc _ hxc (hxV _ hxc) α hα0 hsing
    have hsw := hc3 r₀ r α hα hαr
    obtain ⟨hr, -⟩ := hsw
    exact ⟨⟨(Limits.pullback.fst X.hom (wcProjKStr K (wcLdnmM N)) y, r), ⟨hxc, hrR⟩⟩,
      hxV _ hxc, hr⟩
  have hpair : ∀ i j, (D ∩ O i ∩ O j).Nonempty := by
    intro i j
    have hV : ((V i.1.1 i.2.choose : Set X.left) ∩ (V j.1.1 j.2.choose : Set X.left)).Nonempty :=
      nonempty_preirreducible_inter (V i.1.1 i.2.choose).isOpen (V j.1.1 j.2.choose).isOpen
        ⟨i.1.1, hxV _ _⟩ ⟨j.1.1, hxV _ _⟩
    obtain ⟨x, ⟨hxV₁, hxV₂⟩, hxc⟩ :=
      (dense_iff_closure_eq.mpr (closure_closedPoints (X := X.left))).inter_open_nonempty _
        ((V i.1.1 i.2.choose).isOpen.inter (V j.1.1 j.2.choose).isOpen) hV
    have hxc' : IsClosed ({x} : Set X.left) := mem_closedPoints_iff.mp hxc
    obtain ⟨v₁, hv₁r, hv₁s⟩ := hA i.1.1 i.2.choose x hxc' hxV₁ i.1.2 i.2.choose_spec
    obtain ⟨v₂, hv₂r, hv₂s⟩ := hA j.1.1 j.2.choose x hxc' hxV₂ j.1.2 j.2.choose_spec
    obtain ⟨c, hc⟩ := Infinite.exists_notMem_finset ({-(v₂ i.1.2)⁻¹, -(v₁ j.1.2)} : Finset K)
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hc
    obtain ⟨hc1, hc2⟩ := hc
    have hvs := hL x 1 c _ _ hv₁s hv₂s
    have hv1 : 1 * v₁ i.1.2 + c * v₂ i.1.2 ≠ 0 := by
      rw [hv₁r]
      intro h
      apply hc1
      have hb : v₂ i.1.2 ≠ 0 := by
        intro hb
        rw [hb] at h
        simp at h
      have h' : c * v₂ i.1.2 = -1 := by linear_combination h
      calc c = c * v₂ i.1.2 * (v₂ i.1.2)⁻¹ := by rw [mul_assoc, mul_inv_cancel₀ hb, mul_one]
        _ = -(v₂ i.1.2)⁻¹ := by rw [h', neg_one_mul]
    have hv2 : 1 * v₁ j.1.2 + c * v₂ j.1.2 ≠ 0 := by
      rw [hv₂r]
      intro h
      apply hc2
      linear_combination h
    have hv's := hL x (1 * v₁ i.1.2 + c * v₂ i.1.2)⁻¹ 0 _ _ hvs hvs
    obtain ⟨w, hwc, hwx, hwα⟩ := wc_ldnm_dia_prod_points K (wcLdnmM N) X.left X.hom x hxc' i.1.2
      (fun q => (1 * v₁ i.1.2 + c * v₂ i.1.2)⁻¹ * (1 * v₁ q + c * v₂ q) +
        0 * (1 * v₁ q + c * v₂ q))
      (by
        show (1 * v₁ i.1.2 + c * v₂ i.1.2)⁻¹ * (1 * v₁ i.1.2 + c * v₂ i.1.2) +
          0 * (1 * v₁ i.1.2 + c * v₂ i.1.2) = 1
        rw [inv_mul_cancel₀ hv1, zero_mul, add_zero])
    have hwD : w ∈ D := (hcrux w hwc i.1.2 _ hwα).mpr (by rw [hwx]; exact hv's)
    have hwα' := hwα
    obtain ⟨hr1, -⟩ := hwα'
    have hsw := (hC _ (hsndc w hwc)).2.2.2 i.1.2 j.1.2 _ hwα (by
      show (1 * v₁ i.1.2 + c * v₂ i.1.2)⁻¹ * (1 * v₁ j.1.2 + c * v₂ j.1.2) +
          0 * (1 * v₁ j.1.2 + c * v₂ j.1.2) ≠ 0
      rw [zero_mul, add_zero]
      exact mul_ne_zero (inv_ne_zero hv1) hv2)
    obtain ⟨hr2, -⟩ := hsw
    refine ⟨w, ⟨hwD, ?_, hr1⟩, ?_, hr2⟩
    · rw [Set.mem_preimage, hwx]; exact hxV₁
    · rw [Set.mem_preimage, hwx]; exact hxV₂
  have hne : D.Nonempty := by
    obtain ⟨x₀, -, hx₀⟩ :=
      (dense_iff_closure_eq.mpr (closure_closedPoints (X := X.left))).inter_open_nonempty
        Set.univ isOpen_univ Set.univ_nonempty
    have hx₀' : IsClosed ({x₀} : Set X.left) := mem_closedPoints_iff.mp hx₀
    obtain ⟨r, hr⟩ := hRne x₀ hx₀'
    obtain ⟨α, hαr, hαs⟩ := hA x₀ hx₀' x₀ hx₀' (hxV x₀ hx₀') r hr
    obtain ⟨w, hwc, hwx, hwα⟩ :=
      wc_ldnm_dia_prod_points K (wcLdnmM N) X.left X.hom x₀ hx₀' r α hαr
    exact ⟨w, (hcrux w hwc r α hwα).mpr (by rw [hwx]; exact hαs)⟩
  exact s1 D hDc hne hPJ ι' O I hO hI hIsub hIsurj hcov hpair

theorem wc_ldnm_disc_irreducible (E : Type u) [Field E] [Finite E] (N n : ℕ) (hn2 : 2 ≤ n)
    (X : Over (Spec (.of E))) [IsProper X.hom] [GeometricallyIrreducible X.hom]
    [SmoothOfRelativeDimension n X.hom] (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι)
    (hιX : ι ≫ wcProjKStr E N = X.hom) (Z : Scheme.{u})
    (k : Z ⟶ Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
    (hZ : wcLdnmLocEq (Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
      (Fin (N + 1) × Fin (wcLdnmM N + 1)) (wcLdnmU E N X ι) (wcLdnmPhi E N X ι) Z k) :
    ∀ (Ω : Type u) [Field Ω] [IsAlgClosed Ω] [Algebra E Ω],
      IsIrreducible (⇑(wcLdpProjMap E Ω (wcLdnmM N)) ⁻¹'
        ((k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) ''
          wcLdnmNS (k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))))) :=
by
  intro Ω _ _ _

  have hPB := wc_ldnm_di_projmap_pb E Ω N

  let XΩ : Over (Spec (.of Ω)) :=
    Over.mk (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap E Ω))))
  let q : XΩ.left ⟶ X.left :=
    Limits.pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap E Ω)))
  have hq : IsPullback q XΩ.hom X.hom (Spec.map (CommRingCat.ofHom (algebraMap E Ω))) :=
    IsPullback.of_hasPullback _ _
  haveI : IsProper XΩ.hom := MorphismProperty.of_isPullback (P := @IsProper) hq ‹_›
  haveI := smoothOfRelativeDimension_isStableUnderBaseChange n
  haveI : SmoothOfRelativeDimension n XΩ.hom :=
    MorphismProperty.of_isPullback (P := @SmoothOfRelativeDimension n) hq ‹_›
  haveI : GeometricallyIrreducible XΩ.hom := by
    show GeometricallyIrreducible
      (Limits.pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap E Ω))))
    infer_instance
  let ιΩ : XΩ.left ⟶ wcProjK Ω N := hPB.lift (q ≫ ι) XΩ.hom (by
    rw [Category.assoc, hιX]; exact hq.toCommSq.w)
  have hιq : ιΩ ≫ wcLdpProjMap E Ω N = q ≫ ι := hPB.lift_fst _ _ _
  have hιΩX : ιΩ ≫ wcProjKStr Ω N = XΩ.hom := hPB.lift_snd _ _ _
  have hsq : IsPullback q ιΩ ι (wcLdpProjMap E Ω N) := by
    refine IsPullback.of_bot ?_ hιq.symm hPB
    rw [hιΩX, hιX]
    exact hq
  have hιΩ : IsClosedImmersion ιΩ :=
    MorphismProperty.of_isPullback (P := @IsClosedImmersion) hsq hι

  obtain ⟨hUaff, hUcov, hUu⟩ := wc_ldnm_univ_chart_data Ω N XΩ ιΩ hιΩ
  obtain ⟨ZΩ, kΩ, hk1, hk2, hk3, hk4⟩ :=
    wc_ldpi_principal_subscheme (Limits.pullback XΩ.hom (wcProjKStr Ω (wcLdnmM N)))
      (Fin (N + 1) × Fin (wcLdnmM N + 1)) (wcLdnmU Ω N XΩ ιΩ) hUaff hUcov
      (wcLdnmPhi Ω N XΩ ιΩ) hUu
  have hZΩ : wcLdnmLocEq (Limits.pullback XΩ.hom (wcProjKStr Ω (wcLdnmM N)))
      (Fin (N + 1) × Fin (wcLdnmM N + 1)) (wcLdnmU Ω N XΩ ιΩ) (wcLdnmPhi Ω N XΩ ιΩ) ZΩ kΩ :=
    ⟨hk1, hk2, hk3, hk4⟩

  rw [wc_ldnm_di_bc_disc E Ω N n (by omega) X ι hι hιX XΩ q hq ιΩ hιΩ hιΩX hιq Z k hZ ZΩ kΩ hZΩ]
  exact wc_ldnm_di_algclosed Ω N n hn2 XΩ ιΩ hιΩ hιΩX ZΩ kΩ hZΩ

theorem wc_ldnm_odp_not_smooth (F' E : Type u) [Field F'] [Field E] [Finite E] [Algebra F' E]
    (Y : Over (Spec (.of F'))) (n : ℕ) (P : wcPreDatum F' E Y n) (i : Fin P.m) :
    ¬ ∃ U : P.Yt.left.Opens, P.xs i (IsLocalRing.closedPoint E) ∈ U ∧ Smooth (U.ι ≫ P.f) :=
by
  rintro ⟨U, hyU, hU⟩
  haveI : Smooth (U.ι ≫ P.f) := hU

  have fsStalk : ∀ {Z T : Scheme.{u}} (φ : Z ⟶ T) [Smooth φ] (z : Z),
      letI := (φ.stalkMap z).hom.toAlgebra
      Algebra.FormallySmooth (T.presheaf.stalk (φ z)) (Z.presheaf.stalk z) := by
    intro Z T φ _ z
    obtain ⟨U₀, hU₀, V, hV, hz, e, hstd⟩ := Smooth.exists_isStandardSmooth φ z
    have hφz : φ z ∈ U₀ := e hz
    letI : Algebra Γ(T, U₀) (T.presheaf.stalk (φ z)) :=
      TopCat.Presheaf.algebra_section_stalk T.presheaf ⟨φ z, hφz⟩
    haveI : IsLocalization.AtPrime (T.presheaf.stalk (φ z))
        (hU₀.primeIdealOf ⟨φ z, hφz⟩).asIdeal :=
      hU₀.isLocalization_stalk ⟨φ z, hφz⟩
    letI : Algebra Γ(Z, V) (Z.presheaf.stalk z) :=
      TopCat.Presheaf.algebra_section_stalk Z.presheaf ⟨z, hz⟩
    haveI : IsLocalization.AtPrime (Z.presheaf.stalk z) (hV.primeIdealOf ⟨z, hz⟩).asIdeal :=
      hV.isLocalization_stalk ⟨z, hz⟩
    have key : φ.appLE U₀ V e ≫ Z.presheaf.germ V z hz =
        T.presheaf.germ U₀ (φ z) hφz ≫ φ.stalkMap z := by
      rw [Scheme.Hom.germ_stalkMap, Scheme.Hom.appLE, Category.assoc, TopCat.Presheaf.germ_res]
    letI : Algebra Γ(T, U₀) Γ(Z, V) := (φ.appLE U₀ V e).hom.toAlgebra
    haveI : Algebra.IsStandardSmooth Γ(T, U₀) Γ(Z, V) := hstd
    haveI : Algebra.FormallySmooth Γ(T, U₀) Γ(Z, V) := inferInstance
    haveI : Algebra.FormallySmooth Γ(Z, V) (Z.presheaf.stalk z) :=
      Algebra.FormallySmooth.of_isLocalization (hV.primeIdealOf ⟨z, hz⟩).asIdeal.primeCompl
    letI : Algebra Γ(T, U₀) (Z.presheaf.stalk z) :=
      ((algebraMap Γ(Z, V) (Z.presheaf.stalk z)).comp (φ.appLE U₀ V e).hom).toAlgebra
    haveI : IsScalarTower Γ(T, U₀) Γ(Z, V) (Z.presheaf.stalk z) :=
      IsScalarTower.of_algebraMap_eq' rfl
    haveI : Algebra.FormallySmooth Γ(T, U₀) (Z.presheaf.stalk z) :=
      Algebra.FormallySmooth.comp Γ(T, U₀) Γ(Z, V) (Z.presheaf.stalk z)
    letI : Algebra (T.presheaf.stalk (φ z)) (Z.presheaf.stalk z) := (φ.stalkMap z).hom.toAlgebra
    haveI : IsScalarTower Γ(T, U₀) (T.presheaf.stalk (φ z)) (Z.presheaf.stalk z) :=
      IsScalarTower.of_algebraMap_eq (fun c => congrArg (fun ψ => ψ.hom c) key)
    exact Algebra.FormallySmooth.localization_base (hU₀.primeIdealOf ⟨φ z, hφz⟩).asIdeal.primeCompl

  have keyring : ∀ (A C : Type u) [CommRing A] [IsLocalRing A] [CommRing C] [IsLocalRing C]
      (φ : A →+* C) [IsLocalHom φ],
      (letI := φ.toAlgebra; Algebra.FormallySmooth A C) →
      ∀ (Der : Derivation ℤ A (IsLocalRing.ResidueField A)) (τ : A), Der τ = 1 →
      φ τ ∈ IsLocalRing.maximalIdeal C ^ 2 → False := by
    intro A C _ _ _ _ φ _ hfs Der τ hτ hφτ
    letI : Algebra A C := φ.toAlgebra
    haveI : Algebra.FormallySmooth A C := hfs
    let D' : A → IsLocalRing.ResidueField C := fun a => IsLocalRing.ResidueField.map φ (Der a)
    have hD'add : ∀ a b, D' (a + b) = D' a + D' b := fun a b => by
      simp only [D', map_add]
    have hD'mul : ∀ a b, D' (a * b) =
        IsLocalRing.residue C (φ a) * D' b + IsLocalRing.residue C (φ b) * D' a := by
      intro a b
      simp only [D']
      rw [Der.leibniz, Algebra.smul_def, Algebra.smul_def, IsLocalRing.ResidueField.algebraMap_eq,
        map_add, map_mul, map_mul, IsLocalRing.ResidueField.map_residue,
        IsLocalRing.ResidueField.map_residue]
    have hD'0 : D' 0 = 0 := by simp only [D', map_zero]
    have hD'1 : D' 1 = 0 := by
      have h := hD'mul 1 1
      simp only [map_one, one_mul] at h
      linear_combination -h
    let θ : A →+* TrivSqZeroExt (IsLocalRing.ResidueField C) (IsLocalRing.ResidueField C) :=
      { toFun := fun a => TrivSqZeroExt.inl (IsLocalRing.residue C (φ a)) +
          TrivSqZeroExt.inr (D' a)
        map_one' := by
          ext
          · simp
          · simp [hD'1]
        map_mul' := by
          intro a b
          ext
          · simp
          · simp only [TrivSqZeroExt.snd_mul, TrivSqZeroExt.snd_add, TrivSqZeroExt.snd_inl,
              TrivSqZeroExt.snd_inr, TrivSqZeroExt.fst_add, TrivSqZeroExt.fst_inl,
              TrivSqZeroExt.fst_inr, zero_add, add_zero, smul_eq_mul, op_smul_eq_mul]
            rw [hD'mul]
            ring
        map_zero' := by
          ext
          · simp
          · simp [hD'0]
        map_add' := by
          intro a b
          ext
          · simp
          · simp [hD'add] }
    letI : Algebra A (TrivSqZeroExt (IsLocalRing.ResidueField C) (IsLocalRing.ResidueField C)) :=
      θ.toAlgebra
    let g : TrivSqZeroExt (IsLocalRing.ResidueField C) (IsLocalRing.ResidueField C) →ₐ[A]
        IsLocalRing.ResidueField C :=
      { toFun := fun x => x.fst
        map_one' := TrivSqZeroExt.fst_one
        map_mul' := fun x y => TrivSqZeroExt.fst_mul x y
        map_zero' := TrivSqZeroExt.fst_zero
        map_add' := fun x y => TrivSqZeroExt.fst_add x y
        commutes' := fun a => by
          show (θ a).fst = algebraMap A (IsLocalRing.ResidueField C) a
          rw [IsScalarTower.algebraMap_apply A C (IsLocalRing.ResidueField C),
            IsLocalRing.ResidueField.algebraMap_eq, RingHom.algebraMap_toAlgebra]
          simp [θ] }
    have hg : Function.Surjective g := fun x => ⟨TrivSqZeroExt.inl x, rfl⟩
    have hnil : IsNilpotent (RingHom.ker (g : TrivSqZeroExt (IsLocalRing.ResidueField C)
        (IsLocalRing.ResidueField C) →+* IsLocalRing.ResidueField C)) := by
      have key : RingHom.ker (g : TrivSqZeroExt (IsLocalRing.ResidueField C)
          (IsLocalRing.ResidueField C) →+* IsLocalRing.ResidueField C) *
          RingHom.ker (g : TrivSqZeroExt (IsLocalRing.ResidueField C)
          (IsLocalRing.ResidueField C) →+* IsLocalRing.ResidueField C) = ⊥ := by
        rw [eq_bot_iff, Ideal.mul_le]
        intro r hr s hs
        have hr' : r.fst = 0 := RingHom.mem_ker.mp hr
        have hs' : s.fst = 0 := RingHom.mem_ker.mp hs
        rw [Ideal.mem_bot]
        ext
        · rw [TrivSqZeroExt.fst_mul, hr', zero_mul, TrivSqZeroExt.fst_zero]
        · rw [TrivSqZeroExt.snd_mul, hr', hs', zero_smul, MulOpposite.op_zero, zero_smul,
            add_zero, TrivSqZeroExt.snd_zero]
      have nilp : ∀ (R S : Type u) [CommRing R] [CommRing S] (f : R →+* S),
          RingHom.ker f * RingHom.ker f = ⊥ → IsNilpotent (RingHom.ker f) :=
        fun R S _ _ f h => ⟨2, by rw [pow_two, h, Submodule.zero_eq_bot]⟩
      exact nilp _ _ _ key
    let fC : C →ₐ[A] IsLocalRing.ResidueField C := IsScalarTower.toAlgHom A C _
    let Ψ := Algebra.FormallySmooth.liftOfSurjective fC g hg hnil
    have hfst : ∀ c, (Ψ c).fst = IsLocalRing.residue C c := fun c =>
      Algebra.FormallySmooth.liftOfSurjective_apply fC g hg hnil c
    have hkill : ∀ x ∈ IsLocalRing.maximalIdeal C ^ 2, (Ψ x).snd = 0 := by
      intro x hx
      rw [pow_two] at hx
      refine Submodule.mul_induction_on hx ?_ ?_
      · intro u hu v hv
        rw [map_mul, TrivSqZeroExt.snd_mul, hfst u, hfst v,
          (IsLocalRing.residue_eq_zero_iff u).mpr hu, (IsLocalRing.residue_eq_zero_iff v).mpr hv,
          zero_smul, MulOpposite.op_zero, zero_smul, add_zero]
      · intro x y hx hy
        rw [map_add, TrivSqZeroExt.snd_add, hx, hy, add_zero]
    have hδφ : ∀ a, (Ψ (φ a)).snd = D' a := by
      intro a
      have h : Ψ (φ a) = θ a := Ψ.commutes a
      rw [h]
      show (TrivSqZeroExt.inl (IsLocalRing.residue C (φ a)) + TrivSqZeroExt.inr (D' a)).snd = D' a
      simp
    have h1 : (Ψ (φ τ)).snd = 1 := by
      rw [hδφ]
      simp only [D', hτ, map_one]
    rw [hkill _ hφτ] at h1
    exact zero_ne_one h1

  obtain ⟨t, τ, Amat, hmC, hmA, hcub, -⟩ := P.odp i
  let y' : ↥(U : Scheme.{u}) := ⟨P.xs i (IsLocalRing.closedPoint E), hyU⟩

  have hfy : P.f (P.xs i (IsLocalRing.closedPoint E)) = P.S i (IsLocalRing.closedPoint E) := by
    rw [← P.hxs i]
    rfl
  have hcl : IsClosed ({P.f (P.xs i (IsLocalRing.closedPoint E))} : Set (wcP1Over E).left) := by
    haveI : IsClosedImmersion (P.S i) :=
      isClosedImmersion_of_comp_eq_id (wcP1Over E).hom (P.S i) (P.hS i)
    have hr : Set.range (P.S i) = {P.f (P.xs i (IsLocalRing.closedPoint E))} := by
      ext x
      constructor
      · rintro ⟨s, rfl⟩
        rw [Set.mem_singleton_iff, hfy, Subsingleton.elim s (IsLocalRing.closedPoint E)]
      · intro hx
        rw [Set.mem_singleton_iff] at hx
        exact ⟨IsLocalRing.closedPoint E, by rw [hx, hfy]⟩
    rw [← hr]
    exact (P.S i).isClosedEmbedding.isClosed_range
  haveI := wc_p1_smooth_reldim_one E
  have hdim := wc_lfi_smooth_stalk_dim E (wcP1Over E).left (wcP1Over E).hom 1
    (P.f (P.xs i (IsLocalRing.closedPoint E))) hcl

  have hτm : τ ∈ IsLocalRing.maximalIdeal
      ((wcP1Over E).left.presheaf.stalk (P.f (P.xs i (IsLocalRing.closedPoint E)))) := by
    rw [hmA]
    exact Ideal.subset_span (Set.mem_singleton τ)
  have hτ0 : τ ≠ 0 := by
    intro h0
    rw [h0, Ideal.span_singleton_eq_bot.mpr rfl] at hmA
    have hf := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hmA
    rw [ringKrullDim_eq_zero_of_isField hf] at hdim
    exact absurd hdim (by norm_num)
  have hτ2 : τ ∉ IsLocalRing.maximalIdeal
      ((wcP1Over E).left.presheaf.stalk (P.f (P.xs i (IsLocalRing.closedPoint E)))) ^ 2 := by
    intro h2
    rw [hmA, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at h2
    obtain ⟨r, hr⟩ := h2
    have hu : IsUnit (1 - r * τ) := by
      apply IsLocalRing.notMem_maximalIdeal.mp
      intro hm
      have h1 := Ideal.add_mem _ hm (Ideal.mul_mem_left _ r hτm)
      rw [sub_add_cancel] at h1
      exact (IsLocalRing.notMem_maximalIdeal.mpr isUnit_one) h1
    have h3 : τ * (1 - r * τ) = 0 := by linear_combination -hr
    exact hτ0 ((hu.mul_left_eq_zero).mp h3)

  haveI : CharP E (ringChar E) := ringChar.charP E
  haveI : Fact (ringChar E).Prime := ⟨CharP.char_is_prime E (ringChar E)⟩
  haveI : CharP ((wcP1Over E).left.presheaf.stalk (P.f (P.xs i (IsLocalRing.closedPoint E))))
      (ringChar E) :=
    charP_of_injective_ringHom
      (wcLdpConst E (wcP1Over E).hom (P.f (P.xs i (IsLocalRing.closedPoint E)))).injective
      (ringChar E)
  obtain ⟨Der, hDer⟩ := wc_pfc_p_gdi_conormal_derivation (ringChar E) _ τ hτm hτ2

  have htm : ∀ a, t a ∈ IsLocalRing.maximalIdeal
      (P.Yt.left.presheaf.stalk (P.xs i (IsLocalRing.closedPoint E))) := by
    intro a
    rw [hmC]
    exact Ideal.subset_span ⟨a, rfl⟩
  have hsum : ∑ a, ∑ c, Amat a c * t a * t c ∈ IsLocalRing.maximalIdeal
      (P.Yt.left.presheaf.stalk (P.xs i (IsLocalRing.closedPoint E))) ^ 2 := by
    refine Ideal.sum_mem _ (fun a _ => Ideal.sum_mem _ (fun c _ => ?_))
    rw [mul_assoc]
    refine Ideal.mul_mem_left _ _ ?_
    rw [pow_two]
    exact Ideal.mul_mem_mul (htm a) (htm c)
  have hfτ : (P.f.stalkMap (P.xs i (IsLocalRing.closedPoint E))).hom τ ∈ IsLocalRing.maximalIdeal
      (P.Yt.left.presheaf.stalk (P.xs i (IsLocalRing.closedPoint E))) ^ 2 := by
    have h3 := Ideal.pow_le_pow_right (I := IsLocalRing.maximalIdeal
      (P.Yt.left.presheaf.stalk (P.xs i (IsLocalRing.closedPoint E)))) (by norm_num : 2 ≤ 3) hcub
    have h4 := Ideal.add_mem _ h3 hsum
    rwa [sub_add_cancel] at h4

  have hψ : ∀ (R S : Type u) [CommRing R] [IsLocalRing R] [CommRing S] [IsLocalRing S]
      (ψ : R →+* S) [IsLocalHom ψ] (x : R),
      x ∈ IsLocalRing.maximalIdeal R ^ 2 → ψ x ∈ IsLocalRing.maximalIdeal S ^ 2 := by
    intro R S _ _ _ _ ψ _ x hx
    rw [pow_two] at hx ⊢
    refine Submodule.mul_induction_on hx ?_ ?_
    · intro u hu v hv
      rw [map_mul]
      exact Ideal.mul_mem_mul (map_nonunit ψ u hu) (map_nonunit ψ v hv)
    · intro x z hx hz
      rw [map_add]
      exact Ideal.add_mem _ hx hz
  have e : ((U.ι ≫ P.f).stalkMap y').hom τ =
      (U.ι.stalkMap y').hom ((P.f.stalkMap (P.xs i (IsLocalRing.closedPoint E))).hom τ) := by
    first
      | exact congrArg (fun h => h.hom τ) (Scheme.Hom.stalkMap_comp U.ι P.f y')
      | (erw [Scheme.Hom.stalkMap_comp]; rfl)
      | (simp only [Scheme.Hom.stalkMap_comp, CommRingCat.hom_comp, RingHom.comp_apply]; rfl)
  have hφτ := hψ _ _ (U.ι.stalkMap y').hom _ hfτ
  rw [← e] at hφτ
  exact keyring _ _ ((U.ι ≫ P.f).stalkMap y').hom (fsStalk (U.ι ≫ P.f) y') Der τ hDer hφτ

theorem wc_ldnm_chart_identity (E : Type u) [Field E] (N : ℕ) (X : Over (Spec (.of E)))
    (ι : X.left ⟶ wcProjK E N) (hιX : ι ≫ wcProjKStr E N = X.hom)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (v₀ v₁ : Fin (N + 1) × Fin (N + 1) → E)
    (hv₀ : G₀ = wcLdpQuad E N (fun p q => v₀ (p, q)))
    (hv₁ : G₁ = wcLdpQuad E N (fun p q => v₁ (p, q)))
    (lam : (wcP1Over E).left ⟶ wcProjK E (wcLdnmM N))
    (hlamS : lam ≫ wcProjKStr E (wcLdnmM N) = (wcP1Over E).hom)
    (hrule : wcLdnmPencilRule E N v₀ v₁ lam)
    (Λ : Limits.pullback X.hom (wcProjKStr E 1) ⟶ Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
    (hΛ1 : Λ ≫ Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) =
      Limits.pullback.fst X.hom (wcProjKStr E 1))
    (hΛ2 : Λ ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)) =
      Limits.pullback.snd X.hom (wcProjKStr E 1) ≫ lam)
    (w : ↥(Limits.pullback X.hom (wcProjKStr E 1) : Scheme.{u})) (b : Fin (N + 1)) (e : Fin 2)
    (r : Fin (wcLdnmM N + 1)) (hw : w ∈ wcLdpW E N X ι (b, e))
    (hr : Λ w ∈ wcLdnmU E N X ι (b, r)) :
    ∃ ℓ : (wcProjK E 1).presheaf.stalk (Limits.pullback.snd X.hom (wcProjKStr E 1) w),
      ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom ℓ *
          (Λ.stalkMap w).hom
            (((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ
              (wcLdnmU E N X ι (b, r)) (Λ w) hr).hom (wcLdnmPhi E N X ι (b, r))) =
        (if e = 0 then 1 else -1) *
          ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.germ (wcLdpW E N X ι (b, e)) w hw).hom
            (wcLdpH E N X ι G₀ G₁ (b, e)) :=
by
  classical

  have F0 : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (U : B.Opens) (V : A.Opens) (h : V ≤ f ⁻¹ᵁ U)
      (a : A) (ha : a ∈ V) (s : Γ(B, U)),
      (A.presheaf.germ V a ha).hom ((f.appLE U V h).hom s) =
        (f.stalkMap a).hom ((B.presheaf.germ U (f a) ((Scheme.Hom.mem_preimage f).mp (h ha))).hom s) := by
    intro A B f U V h a ha s
    rw [Scheme.Hom.germ_stalkMap_apply]
    show (A.presheaf.germ V a ha).hom ((A.presheaf.map (homOfLE h).op).hom ((f.app U).hom s)) = _
    rw [TopCat.Presheaf.germ_res_apply]

  have F2 : ∀ {A B C : Scheme.{u}} (f : A ⟶ B) (g : B ⟶ C) (a : A) (y : C.presheaf.stalk (g (f a))),
      ((f ≫ g).stalkMap a).hom y = (f.stalkMap a).hom ((g.stalkMap (f a)).hom y) := by
    intro A B C f g a y
    rw [Scheme.Hom.stalkMap_comp]
    rfl

  have G : ∀ {A B C : Scheme.{u}} (Λ' : A ⟶ B) (f : B ⟶ C) (g : A ⟶ C) (hg : Λ' ≫ f = g)
      (U : C.Opens) (V : B.Opens) (hV : V ≤ f ⁻¹ᵁ U) (a : A) (ha : Λ' a ∈ V) (s : Γ(C, U))
      (hga : g a ∈ U),
      (Λ'.stalkMap a).hom ((B.presheaf.germ V (Λ' a) ha).hom ((f.appLE U V hV).hom s)) =
        (g.stalkMap a).hom ((C.presheaf.germ U (g a) hga).hom s) := by
    intro A B C Λ' f g hg U V hV a ha s hga
    subst hg
    rw [F0]
    exact (F2 Λ' f a _).symm

  have Cst : ∀ {A B : Scheme.{u}} (f : A ⟶ B) (s : B ⟶ Spec (.of E)) (a : A) (c : E),
      (f.stalkMap a).hom (wcLdpConst E s (f a) c) = wcLdpConst E (f ≫ s) a c := by
    intro A B f s a c
    have h1 := Scheme.Hom.germ_stalkMap_apply f ⊤ a trivial
      ((s.appTop).hom ((Scheme.ΓSpecIso (.of E)).inv.hom c))
    simp only [wcLdpConst, RingHom.comp_apply]
    rw [Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply]
    exact h1

  have hx : Limits.pullback.fst X.hom (wcProjKStr E 1) w ∈ ι ⁻¹ᵁ wcSgD E N b :=
    (Scheme.Hom.mem_preimage _).mp (TopologicalSpace.Opens.mem_inf.mp hw).1
  have he : Limits.pullback.snd X.hom (wcProjKStr E 1) w ∈ wcSgD E 1 e :=
    (Scheme.Hom.mem_preimage _).mp (TopologicalSpace.Opens.mem_inf.mp hw).2
  have hsl : Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)) (Λ w) =
      lam (Limits.pullback.snd X.hom (wcProjKStr E 1) w) := by
    show (Λ ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) w =
      (Limits.pullback.snd X.hom (wcProjKStr E 1) ≫ lam) w
    rw [hΛ2]
  have ht : lam (Limits.pullback.snd X.hom (wcProjKStr E 1) w) ∈ wcSgD E (wcLdnmM N) r := by
    rw [← hsl]
    exact (Scheme.Hom.mem_preimage _).mp (TopologicalSpace.Opens.mem_inf.mp hr).2

  set σ : Fin 2 → (wcP1Over E).left.presheaf.stalk (Limits.pullback.snd X.hom (wcProjKStr E 1) w) :=
    fun k => ((wcP1Over E).left.presheaf.germ (wcSgD E 1 e)
      (Limits.pullback.snd X.hom (wcProjKStr E 1) w) he).hom (wcSgE E 1 e k) with hσ
  set β : Fin (N + 1) × Fin (N + 1) →
      (wcP1Over E).left.presheaf.stalk (Limits.pullback.snd X.hom (wcProjKStr E 1) w) :=
    fun q => (lam.stalkMap (Limits.pullback.snd X.hom (wcProjKStr E 1) w)).hom
      (((wcProjK E (wcLdnmM N)).presheaf.germ (wcSgD E (wcLdnmM N) r)
        (lam (Limits.pullback.snd X.hom (wcProjKStr E 1) w)) ht).hom
        (wcSgE E (wcLdnmM N) r (wcLdnmIdx N q))) with hβ
  set m : Fin (N + 1) × Fin (N + 1) →
      X.left.presheaf.stalk (Limits.pullback.fst X.hom (wcProjKStr E 1) w) :=
    fun q => wcLdpGerm E N ι (wcLdnmMono E N q) b (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx
    with hm
  set ℓ : (wcP1Over E).left.presheaf.stalk (Limits.pullback.snd X.hom (wcProjKStr E 1) w) :=
    wcLdpConst E (wcP1Over E).hom (Limits.pullback.snd X.hom (wcProjKStr E 1) w)
        (v₁ ((wcLdnmIdx N).symm r)) * σ 0 -
      wcLdpConst E (wcP1Over E).hom (Limits.pullback.snd X.hom (wcProjKStr E 1) w)
        (v₀ ((wcLdnmIdx N).symm r)) * σ 1 with hℓ

  have hPhi : (Λ.stalkMap w).hom
        (((Limits.pullback X.hom (wcProjKStr E (wcLdnmM N))).presheaf.germ
          (wcLdnmU E N X ι (b, r)) (Λ w) hr).hom (wcLdnmPhi E N X ι (b, r))) =
      ∑ q : Fin (N + 1) × Fin (N + 1),
        ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom (β q) *
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom (m q) := by
    unfold wcLdnmPhi
    rw [map_sum, map_sum]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    rw [map_mul, map_mul]
    congr 1
    · exact (G Λ (Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)))
        (Limits.pullback.snd X.hom (wcProjKStr E 1) ≫ lam) hΛ2 _ _ _ w hr _ ht).trans (F2 _ _ _ _)
    · exact G Λ (Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)))
        (Limits.pullback.fst X.hom (wcProjKStr E 1)) hΛ1 _ _ _ w hr _ hx

  have hH : ((Limits.pullback X.hom (wcProjKStr E 1)).presheaf.germ (wcLdpW E N X ι (b, e)) w hw).hom
        (wcLdpH E N X ι G₀ G₁ (b, e)) =
      ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom
          (wcLdpGerm E N ι (![G₀, G₁] (e + 1)) b (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx) -
        ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom (σ (e + 1)) *
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom
          (wcLdpGerm E N ι (![G₀, G₁] e) b (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx) := by
    unfold wcLdpH
    rw [map_sub, map_mul, F0, F0, F0]
    try rfl

  have hc : ∀ c : E, ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom
        (wcLdpConst E (wcP1Over E).hom (Limits.pullback.snd X.hom (wcProjKStr E 1) w) c) =
      ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom
        (wcLdpConst E X.hom (Limits.pullback.fst X.hom (wcProjKStr E 1) w) c) := by
    intro c
    rw [Cst, Cst]
    exact congrArg (fun φ => wcLdpConst E φ w c)
      (Limits.pullback.condition (f := X.hom) (g := wcProjKStr E 1)).symm

  obtain ⟨hadd, hsmul, -⟩ := wc_ldp_germ_linear E N X.hom ι hιX
    (Limits.pullback.fst X.hom (wcProjKStr E 1) w) b b hx hx
  have hq : ∀ v : Fin (N + 1) × Fin (N + 1) → E,
      wcLdpGerm E N ι (wcLdpQuad E N (fun p q => v (p, q))) b
          (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx =
        ∑ q, wcLdpConst E X.hom (Limits.pullback.fst X.hom (wcProjKStr E 1) w) (v q) * m q := by
    intro v
    have hdec : wcLdpQuad E N (fun p q => v (p, q)) = ∑ q, v q • wcLdnmMono E N q := by
      apply Subtype.ext
      rw [Submodule.coe_sum]
      simp only [wcLdnmMono, wcLdpQuad, Submodule.coe_smul, MvPolynomial.smul_eq_C_mul,
        Finset.mul_sum]
      conv_rhs => rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      conv_rhs => rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun p' _ => ?_)
      simp [apply_ite MvPolynomial.C]
    rw [hdec]
    have hsum := map_sum (AddMonoidHom.mk'
      (fun G => wcLdpGerm E N ι G b (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx) hadd)
      (fun q => v q • wcLdnmMono E N q) Finset.univ
    simp only [AddMonoidHom.mk'_apply] at hsum
    rw [hsum]
    exact Finset.sum_congr rfl (fun q _ => hsmul _ _)

  have hr' : ∀ q, ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom (β q) *
        ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom ℓ =
      ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom
          (wcLdpConst E (wcP1Over E).hom (Limits.pullback.snd X.hom (wcProjKStr E 1) w) (v₁ q)) *
        ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom (σ 0) -
      ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom
          (wcLdpConst E (wcP1Over E).hom (Limits.pullback.snd X.hom (wcProjKStr E 1) w) (v₀ q)) *
        ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom (σ 1) := by
    intro q
    have h : β q * ℓ =
        wcLdpConst E (wcP1Over E).hom (Limits.pullback.snd X.hom (wcProjKStr E 1) w) (v₁ q) * σ 0 -
        wcLdpConst E (wcP1Over E).hom (Limits.pullback.snd X.hom (wcProjKStr E 1) w) (v₀ q) * σ 1 :=
      hrule (Limits.pullback.snd X.hom (wcProjKStr E 1) w) r ht e he q
    rw [← map_mul, h, map_sub, map_mul, map_mul]

  have hkey : ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom ℓ *
        ∑ q : Fin (N + 1) × Fin (N + 1),
          ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom (β q) *
          ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom (m q) =
      ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom (σ 0) *
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom
          (wcLdpGerm E N ι G₁ b (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx) -
      ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom (σ 1) *
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom
          (wcLdpGerm E N ι G₀ b (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx) := by
    have hqk : ∀ (G : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
        (v : Fin (N + 1) × Fin (N + 1) → E), G = wcLdpQuad E N (fun p q => v (p, q)) →
        ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom
          (wcLdpGerm E N ι G b (Limits.pullback.fst X.hom (wcProjKStr E 1) w) hx) =
        ∑ q, ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom
            (wcLdpConst E X.hom (Limits.pullback.fst X.hom (wcProjKStr E 1) w) (v q)) *
          ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom (m q) := by
      intro G v hG
      subst hG
      rw [hq v, map_sum]
      exact Finset.sum_congr rfl (fun q _ => map_mul _ _ _)
    rw [hqk G₁ v₁ hv₁, hqk G₀ v₀ hv₀, Finset.mul_sum, Finset.mul_sum, Finset.mul_sum,
      ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    have e1 : ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom ℓ *
        (((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom (β q) *
          ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom (m q)) =
        (((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom (β q) *
          ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom ℓ) *
          ((Limits.pullback.fst X.hom (wcProjKStr E 1)).stalkMap w).hom (m q) := by ring
    rw [e1, hr' q, hc, hc]
    ring
  have hσe : ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom (σ e) = 1 := by
    show ((Limits.pullback.snd X.hom (wcProjKStr E 1)).stalkMap w).hom
      (((wcP1Over E).left.presheaf.germ (wcSgD E 1 e)
        (Limits.pullback.snd X.hom (wcProjKStr E 1) w) he).hom (wcSgE E 1 e e)) = 1
    rw [(wc_ldpi_oai_sgE_facts E 1 e e).1, map_one, map_one]
  refine ⟨ℓ, ?_⟩
  rw [hPhi, hkey, hH]
  clear_value ℓ σ β m
  have h01 : e = 0 ∨ e = 1 := by fin_cases e <;> simp
  rcases h01 with rfl | rfl
  · rw [if_pos rfl, show (0 : Fin 2) + 1 = 1 from rfl, hσe]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
    ring
  · rw [if_neg (by decide), show (1 : Fin 2) + 1 = 0 by decide, hσe]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
    ring

theorem wc_ldnm_smooth_transfer (E : Type u) [Field E] [Finite E] (N n : ℕ) (hn : 1 ≤ n)
    (X : Over (Spec (.of E))) [SmoothOfRelativeDimension n X.hom]
    (ι : X.left ⟶ wcProjK E N) (hι : IsClosedImmersion ι) (hιX : ι ≫ wcProjKStr E N = X.hom)
    (G₀ G₁ : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) E 2)
    (v₀ v₁ : Fin (N + 1) × Fin (N + 1) → E)
    (hv₀ : G₀ = wcLdpQuad E N (fun p q => v₀ (p, q)))
    (hv₁ : G₁ = wcLdpQuad E N (fun p q => v₁ (p, q)))
    (Yt : Over (Spec (.of E))) [SmoothOfRelativeDimension n Yt.hom]
    (g : Yt.left ⟶ Limits.pullback X.hom (wcProjKStr E 1))
    (hY : wcLdnmLocEq (Limits.pullback X.hom (wcProjKStr E 1)) (Fin (N + 1) × Fin 2)
      (wcLdpW E N X ι) (wcLdpH E N X ι G₀ G₁) Yt.left g)
    (hg : g ≫ Limits.pullback.fst X.hom (wcProjKStr E 1) ≫ X.hom = Yt.hom)
    (Z : Scheme.{u}) (k : Z ⟶ Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
    (hZ : wcLdnmLocEq (Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
      (Fin (N + 1) × Fin (wcLdnmM N + 1)) (wcLdnmU E N X ι) (wcLdnmPhi E N X ι) Z k)
    (lam : (wcP1Over E).left ⟶ wcProjK E (wcLdnmM N))
    (hlamS : lam ≫ wcProjKStr E (wcLdnmM N) = (wcP1Over E).hom)
    (hrule : wcLdnmPencilRule E N v₀ v₁ lam)
    (Λ : Limits.pullback X.hom (wcProjKStr E 1) ⟶ Limits.pullback X.hom (wcProjKStr E (wcLdnmM N)))
    (hΛ1 : Λ ≫ Limits.pullback.fst X.hom (wcProjKStr E (wcLdnmM N)) =
      Limits.pullback.fst X.hom (wcProjKStr E 1))
    (hΛ2 : Λ ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N)) =
      Limits.pullback.snd X.hom (wcProjKStr E 1) ≫ lam)
    (y : Yt.left) (x : Z) (hx : k x = Λ (g y)) (U : Yt.left.Opens) (hyU : y ∈ U)
    (hU : Smooth (U.ι ≫ g ≫ Limits.pullback.snd X.hom (wcProjKStr E 1))) :
    ∃ V : Z.Opens, x ∈ V ∧
      Smooth (V.ι ≫ k ≫ Limits.pullback.snd X.hom (wcProjKStr E (wcLdnmM N))) :=
by
  classical

  have conormal : ∀ (R P A : Type u) [CommRing R] [CommRing P] [CommRing A]
      [IsLocalRing P] [IsLocalRing A] [Algebra R P] [Algebra R A] [Algebra.FormallySmooth R P]
      [Algebra.FormallySmooth R A] [Module.Free P Ω[P⁄R]] [Module.Finite P Ω[P⁄R]]
      [Module.Free A Ω[A⁄R]] [Module.Finite A Ω[A⁄R]]
      (_ : Module.finrank A Ω[A⁄R] + 1 = Module.finrank P Ω[P⁄R])
      (ψ : P →ₐ[R] A) (_ : Function.Surjective ψ) (h : P)
      (_ : RingHom.ker ψ = Ideal.span {h}),
      ∃ δ : P →+ IsLocalRing.ResidueField A,
        (∀ a b, δ (a * b) = IsLocalRing.residue A (ψ a) * δ b + IsLocalRing.residue A (ψ b) * δ a) ∧
        (∀ c : R, δ (algebraMap R P c) = 0) ∧ δ h ≠ 0 := by
    intro R P A _ _ _ _ _ _ _ _ _ _ _ _ _ hrk ψ hψ h hker
    letI iPA : Algebra P A := ψ.toRingHom.toAlgebra
    haveI : IsScalarTower R P A := IsScalarTower.of_algebraMap_eq (fun c => (ψ.commutes c).symm)
    have hsurjA : Function.Surjective (algebraMap P A) := hψ
    have hIker : RingHom.ker (algebraMap P A) = Ideal.span {h} := hker
    have hhI : h ∈ RingHom.ker (algebraMap P A) := by
      rw [hIker]; exact Ideal.subset_span rfl
    obtain ⟨l, hl⟩ := (Algebra.FormallySmooth.iff_split_injection (R := R) (P := P) (A := A)
      hsurjA).mp inferInstance
