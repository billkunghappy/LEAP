      intro h
      apply hj
      rw [← hcoeff j, h]
      simp
    have hev : P0.eval₂ ψ' (π (T k)) = 0 := by
      rw [hP0, Polynomial.eval₂_finsetSum]
      simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
      exact hc
    have hfac := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C
      (IsAlgClosed.card_roots_eq_natDegree (p := P0))
    rw [← hfac, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_multiset_prod,
      Multiset.map_map] at hev
    rcases mul_eq_zero.mp hev with h | h
    · exact Polynomial.leadingCoeff_ne_zero.mpr hp0 (ψ'.injective (by rw [h, map_zero]))
    · obtain ⟨z, _, hz0⟩ := Multiset.mem_map.mp (Multiset.prod_eq_zero_iff.mp h)
      simp only [Function.comp_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X,
        Polynomial.eval₂_C] at hz0
      exact hk z (sub_eq_zero.mp hz0)

  have hmem : ∀ j : Fin (m + 1), MvPolynomial.X a ^ (m - (j : ℕ)) * MvPolynomial.X k ^ (j : ℕ)
      ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω m := by
    intro j
    have hj : (j : ℕ) ≤ m := Nat.lt_succ_iff.mp j.2
    apply (MvPolynomial.mem_homogeneousSubmodule m _).mpr
    have := (MvPolynomial.isHomogeneous_X_pow (R := Ω) a (m - (j : ℕ))).mul
      (MvPolynomial.isHomogeneous_X_pow (R := Ω) k (j : ℕ))
    rwa [Nat.sub_add_cancel hj] at this
  have hHa : ∀ j : Fin (m + 1), wcEszDh κ m ⟨_, hmem j⟩ a = T k ^ (j : ℕ) := by
    intro j
    rw [k1]
    simp only [MvPolynomial.eval₂_mul, MvPolynomial.eval₂_pow, MvPolynomial.eval₂_X, k3,
      one_pow, one_mul]

  have hadm : ∀ j : Fin (m + 1), ∃ t : Fin q → Ω, ∀ c : Fin (N + 1),
      wcEszDh κ m ⟨_, hmem j⟩ c * b c -
        ∑ i, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N c) (t i) * v i c ∈
          Ideal.span {wcEszDh κ e F c} := by
    intro j
    apply hv (fun c => wcEszDh κ m ⟨_, hmem j⟩ c * b c)
    intro c l
    have h1 := htw m ⟨_, hmem j⟩ c l
    rw [map_mul, map_mul, h1]
    convert Ideal.mul_mem_left _
      ((W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N c ⊓ κ ⁻¹ᵁ wcSgD Ω N l ≤
          κ ⁻¹ᵁ wcSgD Ω N c)).op).hom (wcEszDh κ m ⟨_, hmem j⟩ c)) (hb c l) using 1
    ring
  choose lam hlam using hadm

  have hdep : ¬ LinearIndependent Ω lam := by
    intro hli
    have := hli.fintype_card_le_finrank
    rw [Fintype.card_fin, Module.finrank_fin_fun] at this
    omega
  obtain ⟨μ, hμsum, j₀, hj₀⟩ := Fintype.not_linearIndependent_iff.mp hdep
  have hμi : ∀ i, ∑ j, μ j * lam j i = 0 := by
    intro i
    have := congrFun hμsum i
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] using this

  have hmemF : ∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (μ j) *
      (wcEszDh κ m ⟨_, hmem j⟩ a * b a) ∈ Ideal.span {wcEszDh κ e F a} := by
    have hzero : ∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (μ j) *
        ∑ i, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (lam j i) * v i a = 0 := by
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_eq_zero (fun i _ => ?_)
      have e3 : ∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (μ j) *
          (wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (lam j i) * v i a) =
          wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (∑ j, μ j * lam j i) * v i a := by
        rw [map_sum, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [map_mul]
        ring
      rw [e3, hμi i, map_zero, zero_mul]
    have e1 : ∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (μ j) *
        (wcEszDh κ m ⟨_, hmem j⟩ a * b a) =
        ∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (μ j) *
          (wcEszDh κ m ⟨_, hmem j⟩ a * b a -
            ∑ i, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (lam j i) * v i a) := by
      simp only [mul_sub, Finset.sum_sub_distrib, hzero, sub_zero]
    rw [e1]
    exact Ideal.sum_mem _ (fun j _ => Ideal.mul_mem_left _ _ (hlam j a))

  have hfinal : (∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (μ j) * T k ^ (j : ℕ)) * b a ∈
      Ideal.span {wcEszDh κ e F a} := by
    have e2 : (∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (μ j) * T k ^ (j : ℕ)) * b a =
        ∑ j, wcEszScal κ (κ ⁻¹ᵁ wcSgD Ω N a) (μ j) * (wcEszDh κ m ⟨_, hmem j⟩ a * b a) := by
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [hHa j]
      ring
    rw [e2]
    exact hmemF
  exact hj₀ (congrFun (htr μ (hpb _ hfinal)) j₀)

theorem wc_esz_twisted_mul_injective (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (N n : ℕ)
    (hn2 : 2 ≤ n) (W : Scheme.{u}) (r : W ⟶ Spec (.of Ω)) [IrreducibleSpace W]
    [SmoothOfRelativeDimension n r] (κ : W ⟶ wcProjK Ω N) (hκ : IsClosedImmersion κ)
    (hκr : κ ≫ wcProjKStr Ω N = r) (e : ℕ) (he : 1 ≤ e)
    (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω e) (hF : ¬ wcEszVanish κ e F) :
    ∃ m₁ : ℕ, ∀ m ≥ m₁,
      ∀ c : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b),
        wcEszCoc κ (m + e) c → wcEszCob κ m (wcEszMul κ e F c) → wcEszCob κ (m + e) c :=
by
  classical

  have hdom : ∀ w : W, IsDomain (W.presheaf.stalk w) := fun w =>
    wcpa_smooth_stalk_isDomain Ω W r n w
  haveI : ∀ w : W, _root_.IsReduced (W.presheaf.stalk w) := fun w => by
    haveI := hdom w
    infer_instance
  haveI : IsReduced W := isReduced_of_isReduced_stalk W
  haveI : IsIntegral W := isIntegral_of_irreducibleSpace_of_isReduced W
  haveI : Smooth r := SmoothOfRelativeDimension.smooth n r
  haveI : IsLocallyNoetherian W := LocallyOfFiniteType.isLocallyNoetherian r
  haveI := hκ

  have c4 : ∀ (B : Type u) [CommRing B] [IsNoetherianRing B] (f b : B),
      (∀ p : Ideal B, p.IsPrime → (∀ s, s * b ∈ Ideal.span {f} → s ∈ p) → p.IsMaximal) →
      (∀ M : Ideal B, M.IsMaximal → ∀ y, (∀ t ∈ M, t * y ∈ Ideal.span {f}) →
        y ∈ Ideal.span {f}) →
      b ∈ Ideal.span {f} := by
    intro B _ _ f b H1 H2
    by_contra hb
    have hx : (Ideal.Quotient.mk (Ideal.span {f}) b) ≠ 0 := fun h =>
      hb (Ideal.Quotient.eq_zero_iff_mem.mp h)
    obtain ⟨P, hass, hle⟩ := exists_le_isAssociatedPrime_of_isNoetherianRing B _ hx
    obtain ⟨hP, g, hg⟩ := (isAssociatedPrime_iff_exists_injective_linearMap P _).mp hass
    have hPmax : P.IsMaximal := by
      refine H1 P hP (fun s hs => hle ?_)
      rw [Submodule.mem_colon_singleton, Submodule.mem_bot]
      show Ideal.Quotient.mk _ (s * b) = 0
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hs
    obtain ⟨y', hy'⟩ := Ideal.Quotient.mk_surjective (g (Submodule.Quotient.mk 1))
    have e : ∀ t : B, g (Submodule.Quotient.mk t) =
        Ideal.Quotient.mk (Ideal.span {f}) (t * y') := by
      intro t
      have h1 : (Submodule.Quotient.mk t : B ⧸ P) = t • Submodule.Quotient.mk 1 := by
        rw [← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one]
      rw [h1, map_smul, ← hy', map_mul]
      rfl
    have key : ∀ t : B, t ∈ P ↔ t * y' ∈ Ideal.span {f} := by
      intro t
      constructor
      · intro ht
        have h0 : (Submodule.Quotient.mk t : B ⧸ P) = 0 :=
          (Submodule.Quotient.mk_eq_zero P).mpr ht
        have := e t
        rw [h0, map_zero] at this
        exact Ideal.Quotient.eq_zero_iff_mem.mp this.symm
      · intro h
        have h0 : g (Submodule.Quotient.mk t) = g 0 := by
          rw [e t, map_zero]; exact Ideal.Quotient.eq_zero_iff_mem.mpr h
        exact (Submodule.Quotient.mk_eq_zero P).mp (hg h0)
    have hy : y' ∈ Ideal.span {f} := H2 P hPmax y' (fun t ht => (key t).mp ht)
    have h1 : (1 : B) ∈ P := (key 1).mpr (by rw [one_mul]; exact hy)
    exact hP.ne_top ((Ideal.eq_top_iff_one P).mpr h1)

  have htw : ∀ a b : Fin (N + 1),
      (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
          κ ⁻¹ᵁ wcSgD Ω N b)).op).hom (wcEszDh κ e F b) =
        wcEszG κ a b ^ e *
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
          κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (wcEszDh κ e F a) := by
    intro a b
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) :=
      MvPolynomial.gradedAlgebra
    have hXa : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω a)
    have hXb : (MvPolynomial.X b : MvPolynomial (Fin (N + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω b)
    have hXa' : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω (1 • 1) := by
      rw [smul_eq_mul, mul_one]; exact hXa
    have hFe : (F : MvPolynomial (Fin (N + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω (e • 1) := by
      simpa only [smul_eq_mul, mul_one] using F.2
    have hle_a : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        (MvPolynomial.X a * MvPolynomial.X b) ≤ wcSgD Ω N a := fun y hy =>
      ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) _ _).le hy).1
    have hle_b : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        (MvPolynomial.X a * MvPolynomial.X b) ≤ wcSgD Ω N b := fun y hy =>
      ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) _ _).le hy).2
    have hA : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
            hXb (rfl : MvPolynomial.X a * MvPolynomial.X b = MvPolynomial.X a * MvPolynomial.X b)
            (HomogeneousLocalization.Away.mk _ hXa e (F : MvPolynomial (Fin (N + 1)) Ω) hFe)) =
        ((wcProjK Ω N).presheaf.map (homOfLE hle_a).op).hom (wcEszSec Ω N e F a) :=
      congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hXa e
        (F : MvPolynomial (Fin (N + 1)) Ω) hFe))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        (f := MvPolynomial.X a) hXb (x := MvPolynomial.X a * MvPolynomial.X b) rfl)
    have hB : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
            hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
            (HomogeneousLocalization.Away.mk _ hXb e (F : MvPolynomial (Fin (N + 1)) Ω) hFe)) =
        ((wcProjK Ω N).presheaf.map (homOfLE hle_b).op).hom (wcEszSec Ω N e F b) :=
      congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hXb e
        (F : MvPolynomial (Fin (N + 1)) Ω) hFe))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        (f := MvPolynomial.X b) hXa (x := MvPolynomial.X a * MvPolynomial.X b)
        (mul_comm (MvPolynomial.X a) (MvPolynomial.X b)))
    have hEa : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
            hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
            (HomogeneousLocalization.Away.mk _ hXb 1 (MvPolynomial.X a) hXa')) =
        ((wcProjK Ω N).presheaf.map (homOfLE hle_b).op).hom (wcSgE Ω N b a) :=
      congrArg (fun φ => φ.hom (HomogeneousLocalization.Away.mk
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hXb 1 (MvPolynomial.X a) hXa'))
      (Proj.awayMap_awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        (f := MvPolynomial.X b) hXa (x := MvPolynomial.X a * MvPolynomial.X b)
        (mul_comm (MvPolynomial.X a) (MvPolynomial.X b)))
    have c1 : HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
          (HomogeneousLocalization.Away.mk _ hXb e (F : MvPolynomial (Fin (N + 1)) Ω) hFe) =
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hXa (mul_comm (MvPolynomial.X a) (MvPolynomial.X b))
          (HomogeneousLocalization.Away.mk _ hXb 1 (MvPolynomial.X a) hXa') ^ e *
        HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hXb (rfl : MvPolynomial.X a * MvPolynomial.X b = MvPolynomial.X a * MvPolynomial.X b)
          (HomogeneousLocalization.Away.mk _ hXa e (F : MvPolynomial (Fin (N + 1)) Ω) hFe) := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.awayMap_mk,
        HomogeneousLocalization.awayMap_mk, HomogeneousLocalization.val_mul,
        HomogeneousLocalization.val_pow, HomogeneousLocalization.Away.val_mk,
        HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.Away.val_mk,
        Localization.mk_pow, Localization.mk_mul, Localization.mk_eq_mk_iff]
      apply Localization.r_of_eq
      simp only [Submonoid.coe_mul, SubmonoidClass.coe_pow]
      ring
    have e0 : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
        Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (MvPolynomial.X a * MvPolynomial.X b) :=
      (Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) _ _).ge
    have kl : ∀ s : Γ(wcProjK Ω N, wcSgD Ω N a),
        ((wcProjK Ω N).presheaf.map (homOfLE (inf_le_left : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N a)).op).hom s =
          ((wcProjK Ω N).presheaf.map (homOfLE e0).op).hom
            (((wcProjK Ω N).presheaf.map (homOfLE hle_a).op).hom s) := fun s =>
      congrArg (fun φ => φ.hom s)
        ((wcProjK Ω N).presheaf.map_comp (homOfLE hle_a).op (homOfLE e0).op)
    have kr : ∀ s : Γ(wcProjK Ω N, wcSgD Ω N b),
        ((wcProjK Ω N).presheaf.map (homOfLE (inf_le_right : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N b)).op).hom s =
          ((wcProjK Ω N).presheaf.map (homOfLE e0).op).hom
            (((wcProjK Ω N).presheaf.map (homOfLE hle_b).op).hom s) := fun s =>
      congrArg (fun φ => φ.hom s)
        ((wcProjK Ω N).presheaf.map_comp (homOfLE hle_b).op (homOfLE e0).op)
    have hP : ((wcProjK Ω N).presheaf.map (homOfLE (inf_le_right : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N b)).op).hom (wcEszSec Ω N e F b) =
        ((wcProjK Ω N).presheaf.map (homOfLE (inf_le_right : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N b)).op).hom (wcSgE Ω N b a) ^ e *
        ((wcProjK Ω N).presheaf.map (homOfLE (inf_le_left : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N a)).op).hom (wcEszSec Ω N e F a) := by
      rw [kr, kr, kl, ← hA, ← hB, ← hEa, c1]
      simp only [map_mul, map_pow]
    have el : (κ.app (wcSgD Ω N a ⊓ wcSgD Ω N b)).hom
        (((wcProjK Ω N).presheaf.map (homOfLE (inf_le_left : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N a)).op).hom (wcEszSec Ω N e F a)) =
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N a)).op).hom ((κ.app (wcSgD Ω N a)).hom (wcEszSec Ω N e F a)) :=
      congrArg (fun φ => φ.hom (wcEszSec Ω N e F a))
        (Scheme.Hom.naturality κ (homOfLE (inf_le_left : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N a)).op)
    have er : (κ.app (wcSgD Ω N a ⊓ wcSgD Ω N b)).hom
        (((wcProjK Ω N).presheaf.map (homOfLE (inf_le_right : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N b)).op).hom (wcEszSec Ω N e F b)) =
        (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N b)).op).hom ((κ.app (wcSgD Ω N b)).hom (wcEszSec Ω N e F b)) :=
      congrArg (fun φ => φ.hom (wcEszSec Ω N e F b))
        (Scheme.Hom.naturality κ (homOfLE (inf_le_right : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N b)).op)
    have eg : (κ.app (wcSgD Ω N a ⊓ wcSgD Ω N b)).hom
        (((wcProjK Ω N).presheaf.map (homOfLE (inf_le_right : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N b)).op).hom (wcSgE Ω N b a)) =
        (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N b)).op).hom ((κ.app (wcSgD Ω N b)).hom (wcSgE Ω N b a)) :=
      congrArg (fun φ => φ.hom (wcSgE Ω N b a))
        (Scheme.Hom.naturality κ (homOfLE (inf_le_right : wcSgD Ω N a ⊓ wcSgD Ω N b ≤
            wcSgD Ω N b)).op)
    unfold wcEszG wcEszDh
    rw [← el, ← er, ← eg, hP, map_mul, map_pow] <;> rfl

  have hE : ∀ (V : W.Opens), genericPoint W ∉ V → ∀ s t : Γ(W, V), s = t := by
    intro V hV s t
    apply TopCat.Presheaf.section_ext W.sheaf V s t
    intro x hx
    exact absurd (((genericPoint_spec W).mem_open_set_iff V.isOpen).mpr ⟨x, trivial, hx⟩) hV
  have gr : ∀ {U V : W.Opens} (i : U ⟶ V) (hx : genericPoint W ∈ U) (s : Γ(W, V)),
      (W.presheaf.germ U (genericPoint W) hx).hom ((W.presheaf.map i.op).hom s) =
      (W.presheaf.germ V (genericPoint W) (leOfHom i hx)).hom s :=
    fun i hx s => TopCat.Presheaf.germ_res_apply W.presheaf i _ hx s
  obtain ⟨a₀, ha₀⟩ : ∃ a₀, wcEszDh κ e F a₀ ≠ 0 := by
    by_contra h
    push_neg at h
    exact hF h
  have hη0 : genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N a₀ := by
    by_contra hn
    exact ha₀ (hE _ hn _ _)
  have hg0 : (W.presheaf.germ _ (genericPoint W) hη0).hom (wcEszDh κ e F a₀) ≠ 0 := by
    intro h
    apply ha₀
    exact germ_injective_of_isIntegral W _ hη0
      (h.trans (map_zero (W.presheaf.germ _ (genericPoint W) hη0).hom).symm)
  have hga : ∀ (a : Fin (N + 1)) (ha : genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N a),
      (W.presheaf.germ _ (genericPoint W) ha).hom (wcEszDh κ e F a) ≠ 0 := by
    intro a ha h
    have hm : genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N a₀ :=
      TopologicalSpace.Opens.mem_inf.mpr ⟨ha, hη0⟩
    have e' := congrArg (W.presheaf.germ _ (genericPoint W) hm).hom (htw a a₀)
    rw [map_mul, map_pow, gr, gr, h, mul_zero] at e'
    exact hg0 e'
  have hFne : ∀ (a : Fin (N + 1)), genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N a →
      wcEszDh κ e F a ≠ 0 := fun a ha h => hga a ha (by rw [h, map_zero])

  have alg : ∀ (m : ℕ) {R : Type u} [CommRing R] [IsDomain R] (A Fb G C Da Db Da' Db' : R),
      A ≠ 0 → A * C = Da - G ^ m * Db → Fb = G ^ e * A → Da' * A = Da → Db' * Fb = Db →
      C = Da' - G ^ (m + e) * Db' := by
    intro m R _ _ A Fb G C Da Db Da' Db' hA h1 h2 h3 h4
    have key : A * (C - (Da' - G ^ (m + e) * Db')) = 0 := by
      linear_combination h1 - h3 + G ^ m * h4 - G ^ m * Db' * h2
    exact sub_eq_zero.mp ((mul_eq_zero.mp key).resolve_left hA)

  obtain ⟨q, v, hv⟩ := wc_esz_mi_h0D_finite Ω N n hn2 W r κ hκ hκr e he F hF
  refine ⟨q, fun m hm c _ hcob => ?_⟩
  obtain ⟨d, hd⟩ := hcob
  have hb : ∀ a b : Fin (N + 1),
      (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
          κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (d a) -
        wcEszG κ a b ^ m *
          (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b ≤
            κ ⁻¹ᵁ wcSgD Ω N b)).op).hom (d b) ∈
        Ideal.span {(W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD Ω N a ⊓
            κ ⁻¹ᵁ wcSgD Ω N b ≤ κ ⁻¹ᵁ wcSgD Ω N a)).op).hom (wcEszDh κ e F a)} := by
    intro a b
    rw [← hd a b]
    exact Ideal.mem_span_singleton'.mpr ⟨c a b, mul_comm _ _⟩

  have hdF : ∀ a : Fin (N + 1), d a ∈ Ideal.span {wcEszDh κ e F a} := by
    intro a
    by_cases ha : genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N a
    swap
    · rw [hE _ ha (d a) 0]
      exact Ideal.zero_mem _
    letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) :=
      MvPolynomial.gradedAlgebra
    have hXa : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) Ω) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 1 :=
      (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω a)
    have hU : IsAffineOpen (κ ⁻¹ᵁ wcSgD Ω N a) :=
      (Proj.isAffineOpen_basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
        _ hXa one_pos).preimage κ
    haveI : IsNoetherianRing Γ(W, κ ⁻¹ᵁ wcSgD Ω N a) :=
      IsLocallyNoetherian.component_noetherian ⟨_, hU⟩
    exact c4 _ (wcEszDh κ e F a) (d a)
      (fun p hp hpb => wc_esz_mi_colon_primes_maximal Ω N n hn2 W r κ hκ hκr e he F hF
        q v hv m hm d hb a p hp hpb)
      (fun M hM y hy => wc_esz_mi_chart_depth Ω n hn2 W r _ hU _ (hFne a ha) M hM y hy)

  choose d' hd' using fun a => Ideal.mem_span_singleton'.mp (hdF a)
  refine ⟨d', fun a b => ?_⟩
  by_cases hV : genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N a ⊓ κ ⁻¹ᵁ wcSgD Ω N b
  swap
  · exact hE _ hV _ _
  have ha : genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N a := (TopologicalSpace.Opens.mem_inf.mp hV).1
  have hb' : genericPoint W ∈ κ ⁻¹ᵁ wcSgD Ω N b := (TopologicalSpace.Opens.mem_inf.mp hV).2
  refine germ_injective_of_isIntegral W _ hV ?_
  have e1 := congrArg (W.presheaf.germ _ (genericPoint W) hV).hom (hd a b)
  have e2 := congrArg (W.presheaf.germ _ (genericPoint W) hV).hom (htw a b)
  have e3 := congrArg (W.presheaf.germ _ (genericPoint W) ha).hom (hd' a)
  have e4 := congrArg (W.presheaf.germ _ (genericPoint W) hb').hom (hd' b)
  unfold wcEszMul at e1
  simp only [map_sub, map_mul, map_pow, gr] at e1 e2 e3 e4 ⊢
  exact alg m _ _ _ _ _ _ _ _ (hga a ha) e1 e2 e3 e4

theorem wc_esz_forms_independent (Ω : Type u) [Field Ω] [IsAlgClosed Ω] (N n : ℕ)
    (hn2 : 2 ≤ n) (W : Scheme.{u}) (r : W ⟶ Spec (.of Ω)) [IrreducibleSpace W]
    [SmoothOfRelativeDimension n r] (κ : W ⟶ wcProjK Ω N) (hκ : IsClosedImmersion κ)
    (hκr : κ ≫ wcProjKStr Ω N = r) (M₀ : ℕ) :
    ∃ d : ℕ, 1 ≤ d ∧ ∃ G : Fin (M₀ + 1) → MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω d,
      ∀ t : Fin (M₀ + 1) → Ω, t ≠ 0 → ¬ wcEszVanish κ d (∑ i, t i • G i) :=
by
  classical

  have s3 : ∀ (B : Type u) [CommRing B] [IsDomain B] (ψ : Ω →+* B) (t : B),
      (∀ c : Fin (M₀ + 1) → Ω, ∑ i, ψ (c i) * t ^ (i : ℕ) = 0 → c = 0) ∨ ∃ z : Ω, t = ψ z := by
    intro B _ _ ψ t
    by_contra hcon
    push_neg at hcon
    obtain ⟨⟨c, hc, hc0⟩, hz⟩ := hcon
    set p : Polynomial Ω := ∑ i : Fin (M₀ + 1), Polynomial.C (c i) * Polynomial.X ^ (i : ℕ)
      with hp
    have hcoeff : ∀ j : Fin (M₀ + 1), p.coeff j = c j := by
      intro j
      rw [hp, Polynomial.finsetSum_coeff]
      simp only [Polynomial.coeff_C_mul_X_pow]
      rw [Finset.sum_eq_single j]
      · simp
      · intro b _ hb
        rw [if_neg]
        exact fun h => hb (Fin.ext h.symm)
      · simp
    have hp0 : p ≠ 0 := by
      obtain ⟨j, hj⟩ := Function.ne_iff.mp hc0
      intro h
      apply hj
      rw [← hcoeff j, h]
      simp
    have hev : p.eval₂ ψ t = 0 := by
      rw [hp, Polynomial.eval₂_finsetSum]
      simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_X_pow]
      exact hc
    have hfac := Polynomial.C_leadingCoeff_mul_prod_multiset_X_sub_C
      (IsAlgClosed.card_roots_eq_natDegree (p := p))
    rw [← hfac, Polynomial.eval₂_mul, Polynomial.eval₂_C, Polynomial.eval₂_multiset_prod,
      Multiset.map_map] at hev
    rcases mul_eq_zero.mp hev with h | h
    · exact Polynomial.leadingCoeff_ne_zero.mpr hp0 (ψ.injective (by rw [h, map_zero]))
    · obtain ⟨z, _, hz0⟩ := Multiset.mem_map.mp (Multiset.prod_eq_zero_iff.mp h)
      simp only [Function.comp_apply, Polynomial.eval₂_sub, Polynomial.eval₂_X,
        Polynomial.eval₂_C] at hz0
      exact hz z (sub_eq_zero.mp hz0)

  have s2 : ∀ (X : Scheme.{u}) (s : X ⟶ Spec (.of Ω)) [SmoothOfRelativeDimension n s]
      [IsAffine X] [Nonempty X], IsField Γ(X, ⊤) → False := by
    intro X s _ _ _ hX
    haveI : Subsingleton X := by
      letI := hX.toField
      haveI : Subsingleton (PrimeSpectrum Γ(X, ⊤)) := ⟨fun x y => by
        ext1
        rw [Ideal.eq_bot_of_prime x.asIdeal, Ideal.eq_bot_of_prime y.asIdeal]⟩
      haveI : Subsingleton (Spec Γ(X, ⊤)) := this
      exact (Scheme.homeoOfIso X.isoSpec).toEquiv.subsingleton
    obtain ⟨w⟩ := (inferInstance : Nonempty X)
    obtain ⟨U, hU, V, hV, hwV, e, hsm⟩ :=
      SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := n) (f := s) w
    have hVtop : V = ⊤ := by
      ext x
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      rw [Subsingleton.elim x w]
      exact hwV
    subst hVtop
    have hUtop : U = ⊤ := by
      ext x
      simp only [TopologicalSpace.Opens.coe_top, Set.mem_univ, iff_true]
      rw [Subsingleton.elim x (s w)]
      exact e hwV
    subst hUtop
    have happ : s.appLE ⊤ ⊤ e = s.appTop := s.appLE_eq_app (U := ⊤)
    rw [happ] at hsm
    have hft : s.appTop.hom.FiniteType := by
      letI := s.appTop.hom.toAlgebra
      haveI : Algebra.IsStandardSmooth Γ(Spec (.of Ω), ⊤) Γ(X, ⊤) :=
        (RingHom.IsStandardSmoothOfRelativeDimension.isStandardSmooth n _ hsm).toAlgebra
      haveI := Algebra.IsStandardSmooth.finitePresentation (R := Γ(Spec (.of Ω), ⊤)) (S := Γ(X, ⊤))
      show Algebra.FiniteType _ _
      infer_instance
    set φ0 : Ω →+* Γ(X, ⊤) := s.appTop.hom.comp (Scheme.ΓSpecIso (.of Ω)).inv.hom with hφ0
    have hinvs : Function.Surjective (Scheme.ΓSpecIso (.of Ω)).inv.hom := fun x =>
      ⟨(Scheme.ΓSpecIso (.of Ω)).hom.hom x, by simp⟩
    have hφft : φ0.FiniteType := hft.comp (RingHom.FiniteType.of_surjective _ hinvs)
    have hφfin : φ0.Finite := by
      letI := hX.toField
      exact RingHom.finite_iff_finiteType_of_isJacobsonRing.mpr hφft
    have hs : Function.Surjective s.appTop.hom := by
      letI := φ0.toAlgebra
      haveI : Module.Finite Ω Γ(X, ⊤) := hφfin
      letI := hX.toField
      haveI : Algebra.IsIntegral Ω Γ(X, ⊤) := Algebra.IsIntegral.of_finite Ω _
      have hbij := IsAlgClosed.algebraMap_bijective_of_isIntegral (k := Ω) (K := Γ(X, ⊤))
      intro y
      obtain ⟨x, hx⟩ := hbij.2 y
      exact ⟨(Scheme.ΓSpecIso (.of Ω)).inv.hom x, hx⟩
    letI := s.appTop.hom.toAlgebra
    haveI := hsm.toAlgebra
    haveI : Nontrivial Γ(X, ⊤) := RingHom.domain_nontrivial (X.presheaf.germ ⊤ w trivial).hom
    have h1 := Algebra.IsStandardSmoothOfRelativeDimension.rank_kaehlerDifferential
      (R := Γ(Spec (.of Ω), ⊤)) (S := Γ(X, ⊤)) n
    haveI := KaehlerDifferential.subsingleton_of_surjective Γ(Spec (.of Ω), ⊤) Γ(X, ⊤) hs
    rw [rank_subsingleton'] at h1
    have hn0 : n = 0 := by exact_mod_cast h1.symm
    omega

  haveI : ∀ w : W, _root_.IsReduced (W.presheaf.stalk w) := fun w => by
    haveI := wcpa_smooth_stalk_isDomain Ω W r n w
    infer_instance
  haveI : IsReduced W := isReduced_of_isReduced_stalk W
  haveI : IsIntegral W := isIntegral_of_irreducibleSpace_of_isReduced W
  haveI := hκ
  have hcov : ∀ w : W, ∃ a : Fin (N + 1), w ∈ κ ⁻¹ᵁ wcSgD Ω N a := by
    intro w
    have hY : (⨆ j : Fin (N + 1), Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (MvPolynomial.X j)) = ⊤ := by
      apply Proj.iSup_basicOpen_eq_top _ (fun i => MvPolynomial.X i)
      intro a ha
      have ha' := (HomogeneousIdeal.mem_irrelevant_iff _ a).mp ha
      have h0 : MvPolynomial.homogeneousComponent 0 a = 0 := by
        rw [← MvPolynomial.decomposition.decompose'_apply]
        exact ha'
      rw [MvPolynomial.homogeneousComponent_zero, MvPolynomial.C_eq_zero] at h0
      rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
      intro m hm
      have hm0 : m ≠ 0 := by
        rintro rfl
        exact (MvPolynomial.mem_support_iff.mp hm) h0
      obtain ⟨l, hl⟩ := Finsupp.ne_iff.mp hm0
      exact ⟨l, Set.mem_univ _, hl⟩
    have hx : κ w ∈ (⨆ j : Fin (N + 1), Proj.basicOpen
        (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (MvPolynomial.X j)) := by
      rw [hY]; trivial
    obtain ⟨j, hj⟩ := TopologicalSpace.Opens.mem_iSup.mp hx
    exact ⟨j, hj⟩
  obtain ⟨w₀⟩ : Nonempty W := inferInstance
  obtain ⟨a, ha⟩ := hcov w₀
  haveI : Nonempty (κ ⁻¹ᵁ wcSgD Ω N a) := ⟨⟨w₀, ha⟩⟩
  haveI : IsDomain Γ(W, κ ⁻¹ᵁ wcSgD Ω N a) := IsIntegral.component_integral _
  have hXa : MvPolynomial.X a ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 1 :=
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω a)

  have s1 : ∀ (m : ℕ) (P : MvPolynomial (Fin (N + 1)) Ω)
      (hP : P ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω (m • 1)),
      HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hXa m P hP =
        MvPolynomial.eval₂
          ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
              (Submonoid.powers (MvPolynomial.X a))).comp
            (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 0)))
          (fun b => HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hXa 1
            (MvPolynomial.X b)
            (by simpa only [smul_eq_mul, mul_one] using
              (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω b))) P := by
    intro m P hP
    apply HomogeneousLocalization.val_injective
    set L := Localization (Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) Ω))
      with hL
    set ι := algebraMap (MvPolynomial (Fin (N + 1)) Ω) L with hι
    set u : L := Localization.mk 1 ⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ with hu
    have hκ0 : (algebraMap (HomogeneousLocalization (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (Submonoid.powers (MvPolynomial.X a))) L).comp
        ((HomogeneousLocalization.fromZeroRingHom
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
                (Submonoid.powers (MvPolynomial.X a))).comp
              (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 0))) =
        ι.comp MvPolynomial.C := by
      ext c
      simp only [RingHom.comp_apply]
      show HomogeneousLocalization.val (HomogeneousLocalization.mk _) = _
      rw [HomogeneousLocalization.val_mk]
      refine (Localization.mk_one_eq_algebraMap _).trans ?_
      rw [hι, ← MvPolynomial.algebraMap_eq]
      congr 1
      first
        | done
        | exact SetLike.GradeZero.coe_algebraMap _ _
    have hg : ∀ b, (algebraMap (HomogeneousLocalization (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (Submonoid.powers (MvPolynomial.X a))) L) (HomogeneousLocalization.Away.mk
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hXa 1
              (MvPolynomial.X b)
              (by simpa only [smul_eq_mul, mul_one] using
                (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω b))) =
          ι (MvPolynomial.X b) * u := by
      intro b
      rw [HomogeneousLocalization.algebraMap_apply, HomogeneousLocalization.Away.val_mk, hu, hι,
        ← Localization.mk_one_eq_algebraMap, Localization.mk_mul]
      congr 1 <;> first | (apply Subtype.ext; simp) | ring
    have e1 := MvPolynomial.eval₂_comp_left
      (algebraMap (HomogeneousLocalization (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (Submonoid.powers (MvPolynomial.X a))) L)
      ((HomogeneousLocalization.fromZeroRingHom
                (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
                (Submonoid.powers (MvPolynomial.X a))).comp
              (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 0)))
      (fun b => HomogeneousLocalization.Away.mk
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hXa 1
              (MvPolynomial.X b)
              (by simpa only [smul_eq_mul, mul_one] using
                (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω b))) P
    rw [HomogeneousLocalization.algebraMap_apply] at e1
    rw [e1, hκ0, HomogeneousLocalization.Away.val_mk]
    have hfun : (⇑(algebraMap (HomogeneousLocalization (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (Submonoid.powers (MvPolynomial.X a))) L) ∘ fun b => HomogeneousLocalization.Away.mk
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hXa 1
              (MvPolynomial.X b)
              (by simpa only [smul_eq_mul, mul_one] using
                (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω b))) =
        fun b => ι (MvPolynomial.X b) * u := funext hg
    rw [hfun]
    have hdeg : ∀ d ∈ P.support, ∑ i, d i = m := by
      intro d hd
      have h1 := ((MvPolynomial.mem_homogeneousSubmodule _ _).mp hP)
        (MvPolynomial.mem_support_iff.mp hd)
      rw [smul_eq_mul, mul_one] at h1
      rw [← h1, Finsupp.weight_apply, Finsupp.sum_fintype]
      · simp
      · intro i; simp
    have hR : ∀ h : MvPolynomial.X a ^ m ∈ Submonoid.powers (MvPolynomial.X a),
        Localization.mk P ⟨MvPolynomial.X a ^ m, h⟩ = ι P * u ^ m := by
      intro h
      rw [hu, hι, ← Localization.mk_one_eq_algebraMap, Localization.mk_pow, Localization.mk_mul]
      congr 1 <;> first | (apply Subtype.ext; simp) | ring
    rw [hR]
    conv_rhs => rw [MvPolynomial.eval₂_eq']
    conv_lhs => rw [← MvPolynomial.eval₂_eta P, MvPolynomial.eval₂_comp_left,
      MvPolynomial.eval₂_eq']
    rw [Finset.sum_mul]
    refine Finset.sum_congr rfl (fun d hd => ?_)
    simp only [RingHom.comp_apply, Function.comp_apply, mul_pow, Finset.prod_mul_distrib,
      Finset.prod_pow_eq_pow_sum, hdeg d hd]
    ring
  have s1a : HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
      hXa 1 (MvPolynomial.X a)
      (by simpa only [smul_eq_mul, mul_one] using
        (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω a)) = 1 := by
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.val_mk, HomogeneousLocalization.val_one]
    convert Localization.mk_self (⟨MvPolynomial.X a, Submonoid.mem_powers _⟩ :
      Submonoid.powers (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) Ω)) using 2
    all_goals first | (apply Subtype.ext; simp) | simp

  set φ : HomogeneousLocalization.Away (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
      (MvPolynomial.X a) →+* Γ(W, κ ⁻¹ᵁ wcSgD Ω N a) :=
    (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) (MvPolynomial.X a) ≫
      κ.app (wcSgD Ω N a)).hom with hφdef
  set ψ : Ω →+* Γ(W, κ ⁻¹ᵁ wcSgD Ω N a) :=
    φ.comp ((HomogeneousLocalization.fromZeroRingHom
              (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
              (Submonoid.powers (MvPolynomial.X a))).comp
            (algebraMap Ω ↥(MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω 0))) with hψdef
  set T : Fin (N + 1) → Γ(W, κ ⁻¹ᵁ wcSgD Ω N a) := fun b =>
    φ (HomogeneousLocalization.Away.mk
            (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω) hXa 1
            (MvPolynomial.X b)
            (by simpa only [smul_eq_mul, mul_one] using
              (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X Ω b)))
    with hTdef
  have k2 : ∀ (m : ℕ) (P : MvPolynomial (Fin (N + 1)) Ω)
      (hP : P ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω (m • 1)),
      φ (HomogeneousLocalization.Away.mk (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          hXa m P hP) = MvPolynomial.eval₂ ψ T P := by
    intro m P hP
    rw [s1 m P hP, MvPolynomial.eval₂_comp_left]
    rfl
  have k3 : T a = 1 := by
    simp only [hTdef]
    rw [s1a, map_one]
  have k1 : ∀ (e : ℕ) (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω e),
      wcEszDh κ e F a = MvPolynomial.eval₂ ψ T (F : MvPolynomial (Fin (N + 1)) Ω) :=
    fun e F => k2 e F (by simpa only [smul_eq_mul, mul_one] using F.2)
  have k4 : Function.Surjective φ := by
    have hiso : Function.Surjective
        (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω)
          (MvPolynomial.X a)).hom := by
      rw [← Proj.basicOpenIsoAway_hom _ (MvPolynomial.X a) hXa one_pos]
      intro y
      exact ⟨(Proj.basicOpenIsoAway _ (MvPolynomial.X a) hXa one_pos).inv.hom y, by simp⟩
    have happ := Scheme.Hom.app_surjective κ (wcSgD Ω N a)
      (Proj.isAffineOpen_basicOpen _ (MvPolynomial.X a) hXa one_pos)
    intro y
    obtain ⟨x, rfl⟩ := happ y
    obtain ⟨z, rfl⟩ := hiso x
    exact ⟨z, rfl⟩

  have s5 : ∃ b, ∀ c : Fin (M₀ + 1) → Ω, ∑ i, ψ (c i) * T b ^ (i : ℕ) = 0 → c = 0 := by
    by_contra hno
    push_neg at hno
    have hz : ∀ b, ∃ z, T b = ψ z := fun b =>
      (s3 Γ(W, κ ⁻¹ᵁ wcSgD Ω N a) ψ (T b)).resolve_left (fun h => by
        obtain ⟨c, hc, hc0⟩ := hno b
        exact hc0 (h c hc))
    choose z hz using hz
    have hTz : T = ψ ∘ z := funext hz
    have hall : ∀ y : Γ(W, κ ⁻¹ᵁ wcSgD Ω N a), ∃ c, y = ψ c := by
      intro y
      obtain ⟨h, rfl⟩ := k4 y
      obtain ⟨m, P, hP, rfl⟩ :=
        HomogeneousLocalization.Away.mk_surjective _ hXa h
      refine ⟨MvPolynomial.eval₂ (RingHom.id Ω) z P, ?_⟩
      rw [k2, hTz, MvPolynomial.eval₂_comp_left, RingHom.comp_id]
    have hfield : IsField Γ(W, κ ⁻¹ᵁ wcSgD Ω N a) := by
      refine ⟨⟨0, 1, zero_ne_one⟩, mul_comm, fun {y} hy => ?_⟩
      obtain ⟨c, rfl⟩ := hall y
      have hc : c ≠ 0 := by
        rintro rfl
        exact hy (map_zero ψ)
      exact ⟨ψ c⁻¹, by rw [← map_mul, mul_inv_cancel₀ hc, map_one]⟩
    have hfield' : IsField Γ(↑(κ ⁻¹ᵁ wcSgD Ω N a), ⊤) :=
      MulEquiv.isField hfield (κ ⁻¹ᵁ wcSgD Ω N a).topIso.commRingCatIsoToRingEquiv.toMulEquiv
    haveI : IsAffine ↑(κ ⁻¹ᵁ wcSgD Ω N a) :=
      (Proj.isAffineOpen_basicOpen _ (MvPolynomial.X a) hXa one_pos).preimage κ
    haveI : SmoothOfRelativeDimension n ((κ ⁻¹ᵁ wcSgD Ω N a).ι ≫ r) := by
      simpa using smoothOfRelativeDimension_comp 0 n (κ ⁻¹ᵁ wcSgD Ω N a).ι r
    exact s2 ↑(κ ⁻¹ᵁ wcSgD Ω N a) ((κ ⁻¹ᵁ wcSgD Ω N a).ι ≫ r) hfield'

  obtain ⟨b, hb⟩ := s5
  have hd1 : 1 ≤ max M₀ 1 := le_max_right _ _
  have hmem : ∀ i : Fin (M₀ + 1), MvPolynomial.X a ^ (max M₀ 1 - (i : ℕ)) * MvPolynomial.X b ^ (i : ℕ)
      ∈ MvPolynomial.homogeneousSubmodule (Fin (N + 1)) Ω (max M₀ 1) := by
    intro i
    have hi : (i : ℕ) ≤ max M₀ 1 := le_trans (Nat.lt_succ_iff.mp i.2) (le_max_left _ _)
    apply (MvPolynomial.mem_homogeneousSubmodule (max M₀ 1) _).mpr
    have := (MvPolynomial.isHomogeneous_X_pow (R := Ω) a (max M₀ 1 - (i : ℕ))).mul
      (MvPolynomial.isHomogeneous_X_pow (R := Ω) b (i : ℕ))
    rwa [Nat.sub_add_cancel hi] at this
  refine ⟨max M₀ 1, hd1, fun i => ⟨_, hmem i⟩, fun t ht hvan => ht ?_⟩
  apply hb t
  have h0 := hvan a
  rw [k1] at h0
  simp only [Submodule.coe_sum, Submodule.coe_smul, MvPolynomial.smul_eq_C_mul,
    MvPolynomial.eval₂_sum, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_C,
    MvPolynomial.eval₂_X_pow, k3, one_pow, one_mul] at h0
  exact h0

theorem wc_esz_eventual_vanishing (K : Type u) [Field K] (N : ℕ) (W : Scheme.{u}) (w₀ : W)
    (κ : W ⟶ wcProjK K N)
    (H1 : ∀ m : ℕ, ∃ (p : ℕ)
      (v : Fin p → ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)),
      (∀ i, wcEszCoc κ m (v i)) ∧
      ∀ c : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b),
        wcEszCoc κ m c → ∃ t : Fin p → K, wcEszCob κ m (fun a b => c a b -
          ∑ i, wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) (t i) * v i a b))
    (H2 : ∀ (e : ℕ), 1 ≤ e → ∀ F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e,
      ¬ wcEszVanish κ e F → ∃ m₁ : ℕ, ∀ m ≥ m₁,
        ∀ c : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b),
          wcEszCoc κ (m + e) c → wcEszCob κ m (wcEszMul κ e F c) → wcEszCob κ (m + e) c)
    (H4 : ∀ M₀ : ℕ, ∃ d : ℕ, 1 ≤ d ∧
      ∃ G : Fin (M₀ + 1) → MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K d,
        ∀ t : Fin (M₀ + 1) → K, t ≠ 0 → ¬ wcEszVanish κ d (∑ i, t i • G i)) :
    ∃ m₀ : ℕ, ∀ m ≥ m₀,
      ∀ c : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b),
        wcEszCoc κ m c → wcEszCob κ m c :=
by
  letI : GradedAlgebra (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) :=
    MvPolynomial.gradedAlgebra

  have L1 : ∀ (C : Type u) [AddCommGroup C] [Module K C] (Z B : ℕ → Submodule K C)
      (H1 : ∀ m : ℕ, ∃ (p : ℕ) (v : Fin p → C), (∀ i, v i ∈ Z m) ∧
        ∀ z ∈ Z m, ∃ t : Fin p → K, z - ∑ i, t i • v i ∈ B m)
      (ℓ : C →ₗ[K] C)
      (hℓZ : ∀ m : ℕ, ∀ z ∈ Z (m + 1), ℓ z ∈ Z m)
      (hℓB : ∀ m : ℕ, ∀ z ∈ B (m + 1), ℓ z ∈ B m)
      (hℓinj : ∃ m₁ : ℕ, ∀ m ≥ m₁, ∀ z ∈ Z (m + 1), ℓ z ∈ B m → z ∈ B (m + 1))
      (H4 : ∀ M₀ : ℕ, ∃ (d : ℕ) (g : Fin (M₀ + 1) → (C →ₗ[K] C)),
        (∀ i m, ∀ z ∈ Z (m + d), g i z ∈ Z m) ∧
        (∀ i m, ∀ z ∈ B (m + d), g i z ∈ B m) ∧
        (∀ i z, ℓ (g i z) = g i (ℓ z)) ∧
        ∀ t : Fin (M₀ + 1) → K, t ≠ 0 → ∃ m₂ : ℕ, ∀ m ≥ m₂, ∀ z ∈ Z (m + d),
          (∑ i, t i • g i) z ∈ B m → z ∈ B (m + d)),
      ∃ m₀ : ℕ, ∀ m ≥ m₀, ∀ z ∈ Z m, z ∈ B m := by
    intro C _ _ Z B H1 ℓ hℓZ hℓB hℓinj H4
    classical

    have hfin : ∀ m, Module.Finite K (↥(Z m) ⧸ (B m).comap (Z m).subtype) := by
      intro m
      obtain ⟨p, v, hv, hsp⟩ := H1 m
      refine Module.Finite.of_surjective
        (((B m).comap (Z m).subtype).mkQ ∘ₗ
          Fintype.linearCombination K (fun i => (⟨v i, hv i⟩ : Z m))) ?_
      intro x
      obtain ⟨⟨z, hz⟩, rfl⟩ := Submodule.Quotient.mk_surjective _ x
      obtain ⟨t, ht⟩ := hsp z hz
      refine ⟨t, ?_⟩
      rw [LinearMap.comp_apply, Fintype.linearCombination_apply, Submodule.mkQ_apply,
        Submodule.Quotient.eq, Submodule.mem_comap]
      convert neg_mem ht using 1
      simp

    have ind : ∀ (φ : C →ₗ[K] C) (e k : ℕ) (hZ : ∀ z ∈ Z (k + e), φ z ∈ Z k),
        (∀ z ∈ B (k + e), φ z ∈ B k) →
        ∃ f : (↥(Z (k + e)) ⧸ (B (k + e)).comap (Z (k + e)).subtype) →ₗ[K]
            (↥(Z k) ⧸ (B k).comap (Z k).subtype),
          ∀ z (hz : z ∈ Z (k + e)), f (Submodule.Quotient.mk ⟨z, hz⟩) =
            Submodule.Quotient.mk ⟨φ z, hZ z hz⟩ := by
      intro φ e k hZ hB
      refine ⟨Submodule.mapQ _ _ (φ.restrict hZ) ?_, ?_⟩
      · intro x hx
        rw [Submodule.mem_comap] at hx
        rw [Submodule.mem_comap, Submodule.mem_comap]
        exact hB _ hx
      · intro z hz
        rw [Submodule.mapQ_apply]
        rfl

    obtain ⟨m₁, hm₁⟩ := hℓinj
    have hdim : ∀ q, Module.finrank K (↥(Z (m₁ + q)) ⧸ (B (m₁ + q)).comap (Z (m₁ + q)).subtype) ≤
        Module.finrank K (↥(Z m₁) ⧸ (B m₁).comap (Z m₁).subtype) := by
      intro q
      induction q with
      | zero => exact le_rfl
      | succ q ih =>
        show Module.finrank K
          (↥(Z (m₁ + q + 1)) ⧸ (B (m₁ + q + 1)).comap (Z (m₁ + q + 1)).subtype) ≤ _
        obtain ⟨f, hf⟩ := ind ℓ 1 (m₁ + q) (hℓZ _) (hℓB _)
        have hinj : Function.Injective f := by
          rw [injective_iff_map_eq_zero]
          intro x hx
          obtain ⟨⟨z, hz⟩, rfl⟩ := Submodule.Quotient.mk_surjective _ x
          rw [hf z hz] at hx
          rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_comap] at hx ⊢
          exact hm₁ (m₁ + q) (by omega) z hz hx
        haveI := hfin (m₁ + q)
        exact (LinearMap.finrank_le_finrank_of_injective hinj).trans ih

    have hiter : ∀ q k x, x ∈ Z (k + q) →
        (⇑ℓ)^[q] x ∈ Z k ∧ (m₁ ≤ k → (⇑ℓ)^[q] x ∈ B k → x ∈ B (k + q)) := by
      intro q
      induction q with
      | zero => intro k x hx; exact ⟨hx, fun _ h => h⟩
      | succ q ih =>
        intro k x hx
        have hx' : x ∈ Z (k + q + 1) := hx
        have h1 := hℓZ (k + q) x hx'
        obtain ⟨ih1, ih2⟩ := ih k (ℓ x) h1
        rw [Function.iterate_succ_apply]
        refine ⟨ih1, fun hk hB => ?_⟩
        exact hm₁ (k + q) (by omega) x hx' (ih2 hk hB)

    set D := Module.finrank K (↥(Z m₁) ⧸ (B m₁).comap (Z m₁).subtype) with hD
    obtain ⟨d, g, hgZ, hgB, hgℓ, hginj⟩ := H4 (D * D)
    have hind := fun i => ind (g i) d m₁ (hgZ i m₁) (hgB i m₁)
    choose f hf using hind
    haveI := hfin m₁
    haveI := hfin (m₁ + d)
    have hlt : Module.finrank K ((↥(Z (m₁ + d)) ⧸ (B (m₁ + d)).comap (Z (m₁ + d)).subtype) →ₗ[K]
          (↥(Z m₁) ⧸ (B m₁).comap (Z m₁).subtype)) <
        Module.finrank K (Fin (D * D + 1) → K) := by
      rw [Module.finrank_linearMap, Module.finrank_fin_fun]
      have h2 : Module.finrank K (↥(Z (m₁ + d)) ⧸ (B (m₁ + d)).comap (Z (m₁ + d)).subtype) * D ≤
          D * D :=
        Nat.mul_le_mul_right D (hdim d)
      exact Nat.lt_succ_of_le h2
    have hker := LinearMap.ker_ne_bot_of_finrank_lt (f := Fintype.linearCombination K f) hlt
    obtain ⟨t, ht, ht0⟩ := (Submodule.ne_bot_iff _).mp hker
    rw [LinearMap.mem_ker, Fintype.linearCombination_apply] at ht
    set s := ∑ i, t i • g i with hs
    have hsZ : ∀ k, ∀ z ∈ Z (k + d), s z ∈ Z k := by
      intro k z hz
      rw [hs, LinearMap.sum_apply]
      exact Submodule.sum_mem _ (fun i _ => by
        rw [LinearMap.smul_apply]; exact Submodule.smul_mem _ _ (hgZ i k z hz))
    have hstar : ∀ z ∈ Z (m₁ + d), s z ∈ B m₁ := by
      intro z hz
      have e : (Submodule.Quotient.mk ⟨s z, hsZ m₁ z hz⟩ :
            ↥(Z m₁) ⧸ (B m₁).comap (Z m₁).subtype) =
          ∑ i, t i • Submodule.Quotient.mk ⟨g i z, hgZ i m₁ z hz⟩ := by
        have h0 : (⟨s z, hsZ m₁ z hz⟩ : Z m₁) = ∑ i, t i • ⟨g i z, hgZ i m₁ z hz⟩ := by
          apply Subtype.ext
          simp [hs]
        rw [h0, ← Submodule.mkQ_apply, map_sum]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [map_smul]
        rfl
      have h := LinearMap.congr_fun ht (Submodule.Quotient.mk ⟨z, hz⟩)
      rw [LinearMap.sum_apply, LinearMap.zero_apply] at h
      simp only [LinearMap.smul_apply, hf] at h
      rw [← e, Submodule.Quotient.mk_eq_zero, Submodule.mem_comap] at h
      exact h

    have hcomm : Function.Commute ⇑ℓ ⇑s := fun x => by
      rw [hs]
      simp [LinearMap.sum_apply, map_sum, map_smul, hgℓ]
    obtain ⟨m₂, hm₂⟩ := hginj t ht0

    refine ⟨max m₁ m₂ + d, fun m hm z hz => ?_⟩
    have hmax1 := le_max_left m₁ m₂
    have hmax2 := le_max_right m₁ m₂
    obtain ⟨q, rfl⟩ : ∃ q, m = m₁ + d + q := ⟨m - (m₁ + d), by omega⟩
    have hz1 := (hiter q (m₁ + d) z hz).1
    have h2 : s ((⇑ℓ)^[q] z) ∈ B m₁ := hstar _ hz1
    rw [← (hcomm.iterate_left q) z] at h2
    have hz' : z ∈ Z (m₁ + q + d) := by
      rw [show m₁ + q + d = m₁ + d + q by omega]; exact hz
    have hsz : s z ∈ Z (m₁ + q) := hsZ _ z hz'
    have h3 : s z ∈ B (m₁ + q) := (hiter q m₁ (s z) hsz).2 le_rfl h2
    have h4 := hm₂ (m₁ + q) (by omega) z hz' h3
    rw [show m₁ + d + q = m₁ + q + d by omega]
    exact h4

  have resW : ∀ {A B C : W.Opens} (h1 : B ≤ A) (h2 : C ≤ B) (x : Γ(W, A)),
      (W.presheaf.map (homOfLE h2).op).hom ((W.presheaf.map (homOfLE h1).op).hom x) =
      (W.presheaf.map (homOfLE (h2.trans h1)).op).hom x := by
    intro A B C h1 h2 x
    change (W.presheaf.map (homOfLE h1).op ≫ W.presheaf.map (homOfLE h2).op).hom x = _
    rw [← Functor.map_comp]
    rfl
  have hR4 : ∀ (V V' : W.Opens) (h : V' ≤ V) (t : K),
      (W.presheaf.map (homOfLE h).op).hom (wcEszScal κ V t) = wcEszScal κ V' t := by
    intro V V' h t
    show (W.presheaf.map (homOfLE h).op).hom
        ((W.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op).hom _) =
      (W.presheaf.map (homOfLE (le_top : V' ≤ ⊤)).op).hom _
    rw [resW]
  have hX : ∀ a : Fin (N + 1), (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
      MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K 1 := fun a =>
    (MvPolynomial.mem_homogeneousSubmodule 1 _).mpr (MvPolynomial.isHomogeneous_X K a)

  have hZ0 : ∀ m, wcEszCoc κ m 0 := by
    intro m a b l
    simp only [Pi.zero_apply, map_zero, mul_zero, add_zero]
  have hZadd : ∀ m (c c' : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)),
      wcEszCoc κ m c → wcEszCoc κ m c' → wcEszCoc κ m (c + c') := by
    intro m c c' hc hc' a b l
    simp only [Pi.add_apply, map_add]
    rw [← hc a b l, ← hc' a b l]
    ring
  have hZsmul : ∀ m (t : K)
      (c : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)),
      wcEszCoc κ m c →
      wcEszCoc κ m (fun a b => wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) t * c a b) := by
    intro m t c hc a b l
    simp only [map_mul, hR4]
    linear_combination (wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ⊓
      κ ⁻¹ᵁ wcSgD K N l) t) * hc a b l
  have hB0 : ∀ m, wcEszCob κ m 0 := by
    intro m
    refine ⟨0, fun a b => ?_⟩
    simp only [Pi.zero_apply, map_zero, mul_zero, sub_zero]
  have hBadd : ∀ m (c c' : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)),
      wcEszCob κ m c → wcEszCob κ m c' → wcEszCob κ m (c + c') := by
    rintro m c c' ⟨d, hd⟩ ⟨d', hd'⟩
    refine ⟨d + d', fun a b => ?_⟩
    simp only [Pi.add_apply, map_add]
    rw [hd a b, hd' a b]
    ring
  have hBsmul : ∀ m (t : K)
      (c : ∀ a b : Fin (N + 1), Γ(W, κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b)),
      wcEszCob κ m c →
      wcEszCob κ m (fun a b => wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b) t * c a b) := by
    rintro m t c ⟨d, hd⟩
    refine ⟨fun a => wcEszScal κ (κ ⁻¹ᵁ wcSgD K N a) t * d a, fun a b => ?_⟩
    simp only [map_mul, hR4]
    rw [hd a b]
    ring

  have htw : ∀ (e : ℕ) (F : MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K e)
      (a b : Fin (N + 1)),
      (W.presheaf.map (homOfLE (inf_le_right : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
          κ ⁻¹ᵁ wcSgD K N b)).op).hom ((κ.app (wcSgD K N b)).hom (wcEszSec K N e F b)) =
        wcEszG κ a b ^ e *
        (W.presheaf.map (homOfLE (inf_le_left : κ ⁻¹ᵁ wcSgD K N a ⊓ κ ⁻¹ᵁ wcSgD K N b ≤
          κ ⁻¹ᵁ wcSgD K N a)).op).hom ((κ.app (wcSgD K N a)).hom (wcEszSec K N e F a)) := by
    intro e F a b
    have hF : (F : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (e • 1) := by
      simpa only [smul_eq_mul, mul_one] using F.2
    have hXa := hX a
    have hXb := hX b
    have hXa' : (MvPolynomial.X a : MvPolynomial (Fin (N + 1)) K) ∈
        MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K (1 • 1) := by
      rw [smul_eq_mul, mul_one]; exact hXa
    have hle_a : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a * MvPolynomial.X b) ≤ wcSgD K N a := fun y hy =>
      ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) _ _).le hy).1
    have hle_b : Proj.basicOpen (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
        (MvPolynomial.X a * MvPolynomial.X b) ≤ wcSgD K N b := fun y hy =>
      ((Proj.basicOpen_mul (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K) _ _).le hy).2
    have hA : (Proj.awayToSection (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
          (MvPolynomial.X a * MvPolynomial.X b)).hom
          (HomogeneousLocalization.awayMap (MvPolynomial.homogeneousSubmodule (Fin (N + 1)) K)
            hXb (rfl : MvPolynomial.X a * MvPolynomial.X b = MvPolynomial.X a * MvPolynomial.X b)
